  have hΩo : IsOpen (Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) := isOpen_Ioo.prod isOpen_Ioo
  have slice : ∀ f : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿f) (Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) →
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => deriv (fun Y => f Y p.2) p.1)
        (Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) ∧
      ∀ X η : ℝ, (X, η) ∈ Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1) →
        HasDerivAt (fun Y => f Y η) (deriv (fun Y => f Y η) X) X := by
    intro f hf
    have hcomp : ∀ X η : ℝ, (X, η) ∈ Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1) →
        HasDerivAt (fun Y => f Y η) (fderiv ℝ (↿f) (X, η) ((1 : ℝ), (0 : ℝ))) X := by
      intro X η hp
      have hd : DifferentiableAt ℝ (↿f) (X, η) :=
        (hf.contDiffAt (hΩo.mem_nhds hp)).differentiableAt (by norm_num)
      have hl : HasDerivAt (fun Y : ℝ => (Y, η)) ((1 : ℝ), (0 : ℝ)) X :=
        (hasDerivAt_id' X).prodMk (hasDerivAt_const X η)
      exact hd.hasFDerivAt.comp_hasDerivAt X hl
    refine ⟨?_, fun X η hp => (hcomp X η hp).differentiableAt.hasDerivAt⟩
    have h1 := ((contDiffOn_infty_iff_fderiv_of_isOpen hΩo).mp hf).2
    refine (h1.clm_apply (contDiffOn_const (c := ((1 : ℝ), (0 : ℝ))))).congr ?_
    intro p hp
    exact (hcomp p.1 p.2 hp).deriv
  obtain ⟨hDFs, hDF⟩ := slice Fn hFs
  obtain ⟨hDUs, hDU⟩ := slice Un hUs

  have hcut : ContDiff ℝ ∞ (fun p : ℝ × ℝ => 1 - sigA ((p.1 - t1) / t1)) :=
    contDiff_const.sub (hsigA.comp ((contDiff_fst.sub contDiff_const).div_const t1))
  have hZs : ContDiff ℝ ∞ (fun p : ℝ × ℝ => 4 / Λ * Real.exp p.1) :=
    contDiff_const.mul (Real.contDiff_exp.comp contDiff_fst)
  have hψ : ContDiff ℝ ∞ (fun p : ℝ × ℝ => (4 / Λ * Real.exp p.1, p.2)) := hZs.prodMk contDiff_snd
  have hmapΩ : ∀ y η : ℝ, Real.exp y < 41 / 40 → η ∈ Ioo (-1 - ρ1) (1 + ρ1) →
      (4 / Λ * Real.exp y, η) ∈ Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1) := by
    intro y η hy hη
    have h1 : 4 / Λ * Real.exp y < 41 / (10 * Λ) := by
      rw [h41]; exact mul_lt_mul_of_pos_left hy h4pos
    have h2 : 0 < 4 / Λ * Real.exp y := by positivity
    exact ⟨⟨by linarith, by linarith⟩, hη⟩
  have hposZ : ∀ y η : ℝ, Real.exp y < 41 / 40 → η ∈ Ioo (-1 - ρ1) (1 + ρ1) →
      0 < Fn (4 / Λ * Real.exp y) η := by
    intro y η hy hη
    have h1 : 4 / Λ * Real.exp y < 41 / (10 * Λ) := by
      rw [h41]; exact mul_lt_mul_of_pos_left hy h4pos
    exact hFpos _ _ (by positivity) h1.le hη.1 hη.2
  have hzero : ∀ y : ℝ, 2 * t1 < y → 1 - sigA ((y - t1) / t1) = 0 := by
    intro y hy
    rw [hsig1 _ (by rw [le_div_iff₀ ht1]; linarith)]; ring
  have hgsm : ContDiffOn ℝ ∞ (↿gF) (univ ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) ∧
      ContDiffOn ℝ ∞ (↿gU) (univ ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) := by
    have hV1o : IsOpen {p : ℝ × ℝ | Real.exp p.1 < 41 / 40} :=
      isOpen_lt (Real.continuous_exp.comp continuous_fst) continuous_const
    have hV2o : IsOpen {p : ℝ × ℝ | 2 * t1 < p.1} := isOpen_lt continuous_const continuous_fst
    have hcov : ∀ p : ℝ × ℝ, Real.exp p.1 < 41 / 40 ∨ 2 * t1 < p.1 := by
      intro p
      by_cases h : p.1 ≤ 2 * t1
      · left; exact lt_of_le_of_lt (Real.exp_le_exp.mpr h) hexp2
      · right; linarith
    have hmaps : MapsTo (fun p : ℝ × ℝ => (4 / Λ * Real.exp p.1, p.2))
        ((univ ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) ∩ {p : ℝ × ℝ | Real.exp p.1 < 41 / 40})
        (Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) :=
      fun p hp => hmapΩ p.1 p.2 hp.2 hp.1.2
    constructor
    · apply contDiffOn_of_locally_contDiffOn
      intro p _
      rcases hcov p with h | h
      · refine ⟨_, hV1o, h, ?_⟩
        have hA := hDFs.comp hψ.contDiffOn hmaps
        have hB := hFs.comp hψ.contDiffOn hmaps
        have hC := (hcut.contDiffOn.mul hZs.contDiffOn).mul
          (hA.div hB (fun q hq => (hposZ q.1 q.2 hq.2 hq.1.2).ne'))
        refine hC.congr ?_
        intro q _
        show gF q.1 q.2 = _
        rw [hgF]; rfl
      · refine ⟨_, hV2o, h, ?_⟩
        refine (contDiffOn_const (c := (0:ℝ))).congr ?_
        intro q hq
        show gF q.1 q.2 = 0
        rw [hgF, hzero q.1 hq.2]; ring
    · apply contDiffOn_of_locally_contDiffOn
      intro p _
      rcases hcov p with h | h
      · refine ⟨_, hV1o, h, ?_⟩
        have hA := hDUs.comp hψ.contDiffOn hmaps
        have hC := (hcut.contDiffOn.mul hZs.contDiffOn).mul hA
        refine hC.congr ?_
        intro q _
        show gU q.1 q.2 = _
        rw [hgU]; rfl
      · refine ⟨_, hV2o, h, ?_⟩
        refine (contDiffOn_const (c := (0:ℝ))).congr ?_
        intro q hq
        show gU q.1 q.2 = 0
        rw [hgU, hzero q.1 hq.2]; ring
  have hgc : ∀ η ∈ Ioo (-1 - ρ1) (1 + ρ1), Continuous (fun y => gF y η) ∧ Continuous (fun y => gU y η) :=
    fun η hη => ⟨hgsm.1.continuousOn.comp_continuous (continuous_id.prodMk continuous_const)
        (fun y => ⟨mem_univ _, hη⟩),
      hgsm.2.continuousOn.comp_continuous (continuous_id.prodMk continuous_const)
        (fun y => ⟨mem_univ _, hη⟩)⟩

  have prim : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) (univ ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) →
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => ∫ y in t1..p.1, g y p.2) (univ ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) := by
    intro g hg
    have hr : 0 < 1 + ρ1 := by linarith
    have hgt : ∀ ε : ℝ, 0 < ε → ContDiffOn ℝ ∞ (↿(fun x e => g (t1 + x) ((1 + ρ1) * e)))
        (Ioi (-ε) ×ˢ Ioo (-1) 1) := by
      intro ε _
      have hm : ContDiff ℝ ∞ (fun q : ℝ × ℝ => (t1 + q.1, (1 + ρ1) * q.2)) :=
        (contDiff_const.add contDiff_fst).prodMk (contDiff_const.mul contDiff_snd)
      refine hg.comp hm.contDiffOn ?_
      intro q hq
      have hq1 : -1 < q.2 := hq.2.1
      have hq2 : q.2 < 1 := hq.2.2
      refine ⟨mem_univ _, ?_, ?_⟩
      · nlinarith [mul_pos hr (by linarith : (0:ℝ) < q.2 + 1)]
      · nlinarith [mul_pos hr (by linarith : (0:ℝ) < 1 - q.2)]
    apply ContDiffOn.congr (f := fun p : ℝ × ℝ => (p.1 - t1) *
        profRadAvg (fun x e => g (t1 + x) ((1 + ρ1) * e)) (p.1 - t1) (p.2 / (1 + ρ1)))
    · apply contDiffOn_of_locally_contDiffOn
      intro p _
      refine ⟨{q : ℝ × ℝ | -(|p.1 - t1| + 1) < q.1 - t1},
        isOpen_lt continuous_const (continuous_fst.sub continuous_const), ?_, ?_⟩
      · show -(|p.1 - t1| + 1) < p.1 - t1
        have := neg_abs_le (p.1 - t1); linarith
      · have hε : 0 < |p.1 - t1| + 1 := by positivity
        have hA := (profRadAvg_props _ _ hε (hgt _ hε)).1
        have hm : ContDiff ℝ ∞ (fun q : ℝ × ℝ => (q.1 - t1, q.2 / (1 + ρ1))) :=
          (contDiff_fst.sub contDiff_const).prodMk (contDiff_snd.div_const _)
        have hmaps : MapsTo (fun q : ℝ × ℝ => (q.1 - t1, q.2 / (1 + ρ1)))
            ((univ ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) ∩ {q : ℝ × ℝ | -(|p.1 - t1| + 1) < q.1 - t1})
            (Ioi (-(|p.1 - t1| + 1)) ×ˢ Ioo (-1) 1) := by
          intro q hq
          have h1 : -1 - ρ1 < q.2 := hq.1.2.1
          have h2 : q.2 < 1 + ρ1 := hq.1.2.2
          refine ⟨hq.2, ?_, ?_⟩
          · show -1 < q.2 / (1 + ρ1)
            rw [lt_div_iff₀ hr]; linarith
          · show q.2 / (1 + ρ1) < 1
            rw [div_lt_iff₀ hr]; linarith
        have hc := hA.comp hm.contDiffOn hmaps
        exact (contDiff_fst.sub contDiff_const).contDiffOn.mul hc
    · intro p hp
      have h1 : -1 - ρ1 < p.2 := hp.2.1
      have h2 : p.2 < 1 + ρ1 := hp.2.2
      have hε : 0 < |p.1 - t1| + 1 := by positivity
      have hid := ((profRadAvg_props _ _ hε (hgt _ hε)).2.2 (p.1 - t1) (p.2 / (1 + ρ1))
        (by have := neg_abs_le (p.1 - t1); linarith)
        (by rw [lt_div_iff₀ hr]; linarith) (by rw [div_lt_iff₀ hr]; linarith)).1
      show ∫ y in t1..p.1, g y p.2 =
        (p.1 - t1) * profRadAvg (fun x e => g (t1 + x) ((1 + ρ1) * e)) (p.1 - t1) (p.2 / (1 + ρ1))
      rw [hid]
      simp only [profRadInt]
      have e : ∀ x : ℝ, g (t1 + x) ((1 + ρ1) * (p.2 / (1 + ρ1))) = g (t1 + x) p.2 := by
        intro x; congr 1; field_simp
      simp only [e]
      have h3 : ∫ x in (0:ℝ)..(p.1 - t1), g (t1 + x) p.2 = ∫ y in t1..p.1, g y p.2 := by
        have := intervalIntegral.integral_comp_add_left (fun y => g y p.2) t1 (a := 0) (b := p.1 - t1)
        simpa using this
      rw [h3]
  have hIF := prim gF hgsm.1
  have hIU := prim gU hgsm.2

  have hlogm : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => (axLogY Λ p.1, p.2)) (Ioi 0 ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) := by
    refine ContDiffOn.prodMk ?_ contDiffOn_snd
    have : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Real.log (p.1 * Λ / 4)) (Ioi 0 ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) :=
      ((contDiffOn_fst.mul contDiffOn_const).div_const 4).log
        (fun p hp => (div_pos (mul_pos (show (0:ℝ) < p.1 from hp.1) hΛpos) (by norm_num)).ne')
    exact this
  have hmlog : MapsTo (fun p : ℝ × ℝ => (axLogY Λ p.1, p.2)) (Ioi 0 ×ˢ Ioo (-1 - ρ1) (1 + ρ1))
      (univ ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) := fun p hp => ⟨mem_univ _, hp.2⟩
  have hX1mem : ∀ η ∈ Ioo (-1 - ρ1) (1 + ρ1),
      (4 / Λ * Real.exp t1, η) ∈ Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1) :=
    fun η hη => ⟨⟨by linarith, by linarith⟩, hη⟩
  have hcF : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Fn (4 / Λ * Real.exp t1) p.2) (Ioi 0 ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) :=
    hFs.comp ((contDiffOn_const (c := 4 / Λ * Real.exp t1)).prodMk contDiffOn_snd)
      (fun p hp => hX1mem p.2 hp.2)
  have hcU : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Un (4 / Λ * Real.exp t1) p.2) (Ioi 0 ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) :=
    hUs.comp ((contDiffOn_const (c := 4 / Λ * Real.exp t1)).prodMk contDiffOn_snd)
      (fun p hp => hX1mem p.2 hp.2)
  have hGs : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Fn (4 / Λ * Real.exp t1) p.2 *
      Real.exp (∫ y in t1..axLogY Λ p.1, gF y p.2)) (Ioi 0 ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) :=
    hcF.mul (Real.contDiff_exp.comp_contDiffOn (hIF.comp hlogm hmlog))
  have hHs : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Un (4 / Λ * Real.exp t1) p.2 +
      ∫ y in t1..axLogY Λ p.1, gU y p.2) (Ioi 0 ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) :=
    hcU.add (hIU.comp hlogm hmlog)

  have hderZ : ∀ y, HasDerivAt (fun y => 4 / Λ * Real.exp y) (4 / Λ * Real.exp y) y :=
    fun y => (Real.hasDerivAt_exp y).const_mul (4 / Λ)
  have hbelow : ∀ X η : ℝ, 0 < X → X ≤ 4 / Λ * Real.exp t1 → η ∈ Ioo (-1 - ρ1) (1 + ρ1) →
      Fn (4 / Λ * Real.exp t1) η * Real.exp (∫ y in t1..axLogY Λ X, gF y η) = Fn X η ∧
      Un (4 / Λ * Real.exp t1) η + ∫ y in t1..axLogY Λ X, gU y η = Un X η := by
    intro X η hX hXle hη
    have hy0 : axLogY Λ X ≤ t1 := (hlogle X t1 hX).mpr hXle
    have hZ : ∀ y ∈ uIcc (axLogY Λ X) t1,
        X ≤ 4 / Λ * Real.exp y ∧ 4 / Λ * Real.exp y ≤ 4 / Λ * Real.exp t1 := by
      intro y hy
      rw [uIcc_of_le hy0] at hy
      constructor
      · have := mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hy.1) h4pos.le
        rwa [hexpY X hX] at this
      · exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hy.2) h4pos.le
    have hmemZ : ∀ y ∈ uIcc (axLogY Λ X) t1,
        (4 / Λ * Real.exp y, η) ∈ Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1) := by
      intro y hy
      obtain ⟨h1, h2⟩ := hZ y hy
      exact ⟨⟨by linarith, by linarith⟩, hη⟩
    have hposZ' : ∀ y ∈ uIcc (axLogY Λ X) t1, 0 < Fn (4 / Λ * Real.exp y) η := by
      intro y hy
      obtain ⟨h1, h2⟩ := hZ y hy
      exact hFpos _ _ (by linarith) (by linarith) hη.1 hη.2
    have hcut1 : ∀ y ∈ uIcc (axLogY Λ X) t1, sigA ((y - t1) / t1) = 0 := by
      intro y hy
      rw [uIcc_of_le hy0] at hy
      exact hsig0 _ (div_nonpos_of_nonpos_of_nonneg (by linarith [hy.2]) ht1.le)
    obtain ⟨hgFc, hgUc⟩ := hgc η hη
    have hdF : ∀ y ∈ uIcc (axLogY Λ X) t1,
        HasDerivAt (fun y => Real.log (Fn (4 / Λ * Real.exp y) η)) (gF y η) y := by
      intro y hy
      have hc : HasDerivAt (fun y => Fn (4 / Λ * Real.exp y) η)
          (deriv (fun Y => Fn Y η) (4 / Λ * Real.exp y) * (4 / Λ * Real.exp y)) y :=
        by have h0 := (hDF (4 / Λ * Real.exp y) η (hmemZ y hy)).comp y (hderZ y); exact h0
      have h1 := hc.log (hposZ' y hy).ne'
      refine h1.congr_deriv ?_
      rw [hgF, hcut1 y hy]
      simp only [Function.comp_apply, sub_zero, one_mul]
      ring
    have hdU : ∀ y ∈ uIcc (axLogY Λ X) t1,
        HasDerivAt (fun y => Un (4 / Λ * Real.exp y) η) (gU y η) y := by
      intro y hy
      have h1 := (hDU _ _ (hmemZ y hy)).comp y (hderZ y)
      refine h1.congr_deriv ?_
      rw [hgU, hcut1 y hy]
      ring
    have keyF := intervalIntegral.integral_eq_sub_of_hasDerivAt hdF
      (hgFc.intervalIntegrable (axLogY Λ X) t1)
    have keyU := intervalIntegral.integral_eq_sub_of_hasDerivAt hdU
      (hgUc.intervalIntegrable (axLogY Λ X) t1)
    rw [hexpY X hX] at keyF keyU
    have hA : 0 < Fn X η := hFpos X η hX.le (by linarith) hη.1 hη.2
    have hB : 0 < Fn (4 / Λ * Real.exp t1) η := hFpos _ η hX1pos.le hX1lt.le hη.1 hη.2
    constructor
    · rw [intervalIntegral.integral_symm (axLogY Λ X) t1, keyF, neg_sub, Real.exp_sub,
        Real.exp_log hA, Real.exp_log hB]
      rw [mul_comm]; exact div_mul_cancel₀ _ hB.ne'
    · rw [intervalIntegral.integral_symm (axLogY Λ X) t1, keyU]
      ring
  have eqG : ∀ X η : ℝ, 0 < X → η ∈ Ioo (-1 - ρ1) (1 + ρ1) →
      axRefF Λ t1 Fn X η = Fn (4 / Λ * Real.exp t1) η * Real.exp (∫ y in t1..axLogY Λ X, gF y η) ∧
      axRefU Λ t1 Un X η = Un (4 / Λ * Real.exp t1) η + ∫ y in t1..axLogY Λ X, gU y η := by
    intro X η hX hη
    rw [hFdef, hUdef]
    by_cases h : X ≤ 0 ∨ axLogY Λ X ≤ t1
    · rw [if_pos h, if_pos h]
      have hy : axLogY Λ X ≤ t1 := h.resolve_left (not_le.mpr hX)
      have := hbelow X η hX ((hlogle X t1 hX).mp hy) hη
      exact ⟨this.1.symm, this.2.symm⟩
    · rw [if_neg h, if_neg h]; exact ⟨rfl, rfl⟩

  have hC4 : ∀ X η : ℝ, X < 4 / Λ * Real.exp t1 →
      axRefF Λ t1 Fn X η = Fn X η ∧ axRefU Λ t1 Un X η = Un X η := by
    intro X η hX
    have h : X ≤ 0 ∨ axLogY Λ X ≤ t1 := by
      by_cases h0 : X ≤ 0
      · exact Or.inl h0
      · exact Or.inr ((hlogle X t1 (not_le.mp h0)).mpr hX.le)
    rw [hFdef, hUdef, if_pos h, if_pos h]; exact ⟨rfl, rfl⟩

  have hC1 : ContDiffOn ℝ ∞ (↿(axRefF Λ t1 Fn)) (Ioi (-1 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) := by
    apply contDiffOn_of_locally_contDiffOn
    intro p _
    by_cases hp1 : p.1 < 4 / Λ * Real.exp t1
    · refine ⟨Iio (4 / Λ * Real.exp t1) ×ˢ univ, isOpen_Iio.prod isOpen_univ, ⟨hp1, mem_univ _⟩, ?_⟩
      refine (hFs.mono ?_).congr ?_
      · intro q hq
        have h1 : -1 / Λ < q.1 := hq.1.1
        have h2 : q.1 < 4 / Λ * Real.exp t1 := hq.2.1
        exact ⟨⟨h1, by linarith⟩, hq.1.2⟩
      · intro q hq
        exact (hC4 q.1 q.2 hq.2.1).1
    · have hp0 : 0 < p.1 := by linarith [not_lt.mp hp1]
      refine ⟨Ioi 0 ×ˢ univ, isOpen_Ioi.prod isOpen_univ, ⟨hp0, mem_univ _⟩, ?_⟩
      refine (hGs.mono ?_).congr ?_
      · intro q hq
        exact ⟨hq.2.1, hq.1.2⟩
      · intro q hq
        exact (eqG q.1 q.2 hq.2.1 hq.1.2).1
  have hC2 : ContDiffOn ℝ ∞ (↿(axRefU Λ t1 Un)) (Ioi (-1 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) := by
    apply contDiffOn_of_locally_contDiffOn
    intro p _
    by_cases hp1 : p.1 < 4 / Λ * Real.exp t1
    · refine ⟨Iio (4 / Λ * Real.exp t1) ×ˢ univ, isOpen_Iio.prod isOpen_univ, ⟨hp1, mem_univ _⟩, ?_⟩
      refine (hUs.mono ?_).congr ?_
      · intro q hq
        have h1 : -1 / Λ < q.1 := hq.1.1
        have h2 : q.1 < 4 / Λ * Real.exp t1 := hq.2.1
        exact ⟨⟨h1, by linarith⟩, hq.1.2⟩
      · intro q hq
        exact (hC4 q.1 q.2 hq.2.1).2
    · have hp0 : 0 < p.1 := by linarith [not_lt.mp hp1]
      refine ⟨Ioi 0 ×ˢ univ, isOpen_Ioi.prod isOpen_univ, ⟨hp0, mem_univ _⟩, ?_⟩
      refine (hHs.mono ?_).congr ?_
      · intro q hq
        exact ⟨hq.2.1, hq.1.2⟩
      · intro q hq
        exact (eqG q.1 q.2 hq.2.1 hq.1.2).2

  have hC3 : ∀ X η : ℝ, 0 ≤ X → -1 - ρ1 < η → η < 1 + ρ1 → 0 < axRefF Λ t1 Fn X η := by
    intro X η hX h1 h2
    rw [hFdef]
    split_ifs with h
    · have hXle : X ≤ 4 / Λ * Real.exp t1 := by
        rcases h with h | h
        · linarith
        · rcases eq_or_lt_of_le hX with h0 | h0
          · rw [← h0]; exact hX1pos.le
          · exact (hlogle X t1 h0).mp h
      exact hFpos X η hX (by linarith) h1 h2
    · exact mul_pos (hFpos _ η hX1pos.le hX1lt.le h1 h2) (Real.exp_pos _)

  have hconst : ∀ (φ : ℝ → ℝ) (L : ℝ), 2 * t1 ≤ L → (∀ y, 2 * t1 < y → φ y = 0) →
      ∫ y in t1..L, φ y = ∫ y in t1..(2 * t1), φ y := by
    intro φ L hL hφ
    rw [intervalIntegral.integral_of_le (by linarith), intervalIntegral.integral_of_le (by linarith)]
    refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioc
      (Ioc_subset_Ioc_right hL) ?_
    intro x hx
    apply hφ
    by_contra hc
    push_neg at hc
    exact hx.2 ⟨hx.1.1, hc⟩
  have hgF0 : ∀ η y : ℝ, 2 * t1 < y → gF y η = 0 := by
    intro η y hy; rw [hgF, hzero y hy]; ring
  have hgU0 : ∀ η y : ℝ, 2 * t1 < y → gU y η = 0 := by
    intro η y hy; rw [hgU, hzero y hy]; ring
  have hC5 : ∀ X η : ℝ, 4 / Λ * Real.exp (2 * t1) ≤ X →
      axRefF Λ t1 Fn X η = axRefF Λ t1 Fn (4 / Λ * Real.exp (2 * t1)) η ∧
      axRefU Λ t1 Un X η = axRefU Λ t1 Un (4 / Λ * Real.exp (2 * t1)) η := by
    intro X η hX
    have hXpos : 0 < X := by linarith
    have hn : ∀ Z : ℝ, 4 / Λ * Real.exp (2 * t1) ≤ Z → ¬ (Z ≤ 0 ∨ axLogY Λ Z ≤ t1) := by
      intro Z hZ hc
      rcases hc with hc | hc
      · linarith
      · have := (hlogle Z t1 (by linarith)).mp hc; linarith
    have hL : 2 * t1 ≤ axLogY Λ X := (hlogge X (2 * t1) hXpos).mpr hX
    rw [hFdef X, hFdef (4 / Λ * Real.exp (2 * t1)), hUdef X, hUdef (4 / Λ * Real.exp (2 * t1)),
      if_neg (hn X hX), if_neg (hn _ le_rfl), if_neg (hn X hX), if_neg (hn _ le_rfl), hlogexp,
      hconst (fun y => gF y η) _ hL (fun y hy => hgF0 η y hy),
      hconst (fun y => gU y η) _ hL (fun y hy => hgU0 η y hy)]
    exact ⟨rfl, rfl⟩

  have hC6 : ∀ X η : ℝ, 0 < X → -1 - ρ1 < η → η < 1 + ρ1 →
      X * deriv (fun Y => axRefF Λ t1 Fn Y η) X = (1 - sigA ((axLogY Λ X - t1) / t1)) *
        (X * deriv (fun Y => Fn Y η) X / Fn X η) * axRefF Λ t1 Fn X η ∧
      X * deriv (fun Y => axRefU Λ t1 Un Y η) X = (1 - sigA ((axLogY Λ X - t1) / t1)) *
        (X * deriv (fun Y => Un Y η) X) := by
    intro X η hX h1 h2
    have hη : η ∈ Ioo (-1 - ρ1) (1 + ρ1) := ⟨h1, h2⟩
    obtain ⟨hgFc, hgUc⟩ := hgc η hη
    have hlogd : HasDerivAt (fun Y => axLogY Λ Y) (1 / X) X := by
      have hp : X * Λ / 4 ≠ 0 := by have := mul_pos hX hΛpos; positivity
      have h := (((hasDerivAt_id' X).mul_const Λ).div_const 4).log hp
      unfold axLogY
      refine h.congr_deriv ?_
      first | (field_simp; ring) | field_simp
    have hIF' : HasDerivAt (fun Y => ∫ y in t1..axLogY Λ Y, gF y η) (gF (axLogY Λ X) η * (1 / X)) X :=
      (hgFc.integral_hasStrictDerivAt t1 (axLogY Λ X)).hasDerivAt.comp X hlogd
    have hIU' : HasDerivAt (fun Y => ∫ y in t1..axLogY Λ Y, gU y η) (gU (axLogY Λ X) η * (1 / X)) X :=
      (hgUc.integral_hasStrictDerivAt t1 (axLogY Λ X)).hasDerivAt.comp X hlogd
    have hevF : (fun Y => axRefF Λ t1 Fn Y η) =ᶠ[nhds X]
        (fun Y => Fn (4 / Λ * Real.exp t1) η * Real.exp (∫ y in t1..axLogY Λ Y, gF y η)) :=
      Filter.eventuallyEq_of_mem (Ioi_mem_nhds hX) (fun Y hY => (eqG Y η hY hη).1)
    have hevU : (fun Y => axRefU Λ t1 Un Y η) =ᶠ[nhds X]
        (fun Y => Un (4 / Λ * Real.exp t1) η + ∫ y in t1..axLogY Λ Y, gU y η) :=
      Filter.eventuallyEq_of_mem (Ioi_mem_nhds hX) (fun Y hY => (eqG Y η hY hη).2)
    have hdF : deriv (fun Y => axRefF Λ t1 Fn Y η) X = Fn (4 / Λ * Real.exp t1) η *
        (Real.exp (∫ y in t1..axLogY Λ X, gF y η) * (gF (axLogY Λ X) η * (1 / X))) :=
      ((hIF'.exp.const_mul (Fn (4 / Λ * Real.exp t1) η)).congr_of_eventuallyEq hevF).deriv
    have hdU : deriv (fun Y => axRefU Λ t1 Un Y η) X = gU (axLogY Λ X) η * (1 / X) :=
      ((hIU'.const_add (Un (4 / Λ * Real.exp t1) η)).congr_of_eventuallyEq hevU).deriv
    have hgX : gF (axLogY Λ X) η = (1 - sigA ((axLogY Λ X - t1) / t1)) * X *
        (deriv (fun Y => Fn Y η) X / Fn X η) := by
      rw [hgF, hexpY X hX]
    have hgXU : gU (axLogY Λ X) η = (1 - sigA ((axLogY Λ X - t1) / t1)) * X *
        deriv (fun Y => Un Y η) X := by
      rw [hgU, hexpY X hX]
    have hXi : X * (1 / X) = 1 := mul_one_div_cancel hX.ne'
    rw [hdF, hdU, (eqG X η hX hη).1, hgX, hgXU]
    constructor
    · linear_combination (Fn (4 / Λ * Real.exp t1) η * Real.exp (∫ y in t1..axLogY Λ X, gF y η) *
        (1 - sigA ((axLogY Λ X - t1) / t1)) * X * (deriv (fun Y => Fn Y η) X / Fn X η)) * hXi
    · linear_combination ((1 - sigA ((axLogY Λ X - t1) / t1)) * X * deriv (fun Y => Un Y η) X) * hXi

  have hC7 : ∀ X η : ℝ, 4 / Λ * Real.exp (2 * t1) ≤ X → -1 - ρ1 < η → η < 1 + ρ1 →
      deriv (fun Y => axRefU Λ t1 Un Y η) X = 0 := by
    intro X η hX h1 h2
    have hXpos : 0 < X := by linarith
    have hL : 2 * t1 ≤ axLogY Λ X := (hlogge X (2 * t1) hXpos).mpr hX
    have h := (hC6 X η hXpos h1 h2).2
    rw [hsig1 _ (by rw [le_div_iff₀ ht1]; linarith), sub_self, zero_mul] at h
    exact (mul_eq_zero.mp h).resolve_left hXpos.ne'
  exact ⟨hC1, hC2, hC3, hC4, hC5, hC6, hC7⟩

theorem slice_deriv_facts : ∀ (f : ℝ → ℝ → ℝ) (S : Set (ℝ × ℝ)) (x y : ℝ), IsOpen S → ContDiffOn ℝ ∞ (↿f) S → (x, y) ∈ S → HasDerivAt (fun X => f X y) (deriv (fun X => f X y) x) x ∧ HasDerivAt (fun e => f x e) (deriv (fun e => f x e) y) y ∧ |deriv (fun X => f X y) x| ≤ ‖iteratedFDeriv ℝ 1 (↿f) (x, y)‖ ∧ |deriv (fun e => f x e) y| ≤ ‖iteratedFDeriv ℝ 1 (↿f) (x, y)‖ ∧ ContinuousAt (fun e => deriv (fun X => f X e) x) y ∧ ContinuousAt (fun X => deriv (fun e => f X e) y) x :=
by
  intro f S x y hS hf hxy
  have hD : ∀ p ∈ S, HasFDerivAt (↿f) (fderiv ℝ (↿f) p) p := fun p hp =>
    ((hf.contDiffAt (hS.mem_nhds hp)).differentiableAt (by simp)).hasFDerivAt
  have h1 : ∀ a b : ℝ, (a, b) ∈ S →
      HasDerivAt (fun X => f X b) (fderiv ℝ (↿f) (a, b) ((1:ℝ), (0:ℝ))) a := by
    intro a b hab
    have hc : HasDerivAt (fun X : ℝ => (X, b)) ((1:ℝ), (0:ℝ)) a :=
      (hasDerivAt_id a).prodMk (hasDerivAt_const a b)
    exact (hD (a, b) hab).comp_hasDerivAt a hc
  have h2 : ∀ a b : ℝ, (a, b) ∈ S →
      HasDerivAt (fun e => f a e) (fderiv ℝ (↿f) (a, b) ((0:ℝ), (1:ℝ))) b := by
    intro a b hab
    have hc : HasDerivAt (fun e : ℝ => (a, e)) ((0:ℝ), (1:ℝ)) b :=
      (hasDerivAt_const b a).prodMk (hasDerivAt_id b)
    exact (hD (a, b) hab).comp_hasDerivAt b hc
  have hn : ‖fderiv ℝ (↿f) (x, y)‖ = ‖iteratedFDeriv ℝ 1 (↿f) (x, y)‖ :=
    (norm_iteratedFDeriv_one ..).symm
  have hcont : ContinuousAt (fderiv ℝ (↿f)) (x, y) :=
    (hf.continuousOn_fderiv_of_isOpen hS (by simp)).continuousAt (hS.mem_nhds hxy)
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [(h1 x y hxy).deriv]; exact h1 x y hxy
  · rw [(h2 x y hxy).deriv]; exact h2 x y hxy
  · rw [(h1 x y hxy).deriv, ← Real.norm_eq_abs, ← hn]
    calc ‖fderiv ℝ (↿f) (x, y) ((1:ℝ), (0:ℝ))‖
        ≤ ‖fderiv ℝ (↿f) (x, y)‖ * ‖((1:ℝ), (0:ℝ))‖ := ContinuousLinearMap.le_opNorm _ _
      _ = ‖fderiv ℝ (↿f) (x, y)‖ := by simp
  · rw [(h2 x y hxy).deriv, ← Real.norm_eq_abs, ← hn]
    calc ‖fderiv ℝ (↿f) (x, y) ((0:ℝ), (1:ℝ))‖
        ≤ ‖fderiv ℝ (↿f) (x, y)‖ * ‖((0:ℝ), (1:ℝ))‖ := ContinuousLinearMap.le_opNorm _ _
      _ = ‖fderiv ℝ (↿f) (x, y)‖ := by simp
  · have hU : {e : ℝ | (x, e) ∈ S} ∈ nhds y :=
      (hS.preimage (continuous_const.prodMk continuous_id)).mem_nhds hxy
    have hc0 : ContinuousAt (fun e : ℝ => fderiv ℝ (↿f) (x, e)) y :=
      ContinuousAt.comp (g := fderiv ℝ (↿f)) (f := fun e : ℝ => (x, e)) hcont
        (continuous_const.prodMk continuous_id).continuousAt
    have hc : ContinuousAt (fun e : ℝ => fderiv ℝ (↿f) (x, e) ((1:ℝ), (0:ℝ))) y :=
      hc0.clm_apply continuousAt_const
    exact hc.congr_of_eventuallyEq
      (Filter.eventuallyEq_of_mem hU (fun e he => (h1 x e he).deriv))
  · have hU : {X : ℝ | (X, y) ∈ S} ∈ nhds x :=
      (hS.preimage (continuous_id.prodMk continuous_const)).mem_nhds hxy
    have hc0 : ContinuousAt (fun X : ℝ => fderiv ℝ (↿f) (X, y)) x :=
      ContinuousAt.comp (g := fderiv ℝ (↿f)) (f := fun X : ℝ => (X, y)) hcont
        (continuous_id.prodMk continuous_const).continuousAt
    have hc : ContinuousAt (fun X : ℝ => fderiv ℝ (↿f) (X, y) ((0:ℝ), (1:ℝ))) x :=
      hc0.clm_apply continuousAt_const
    exact hc.congr_of_eventuallyEq
      (Filter.eventuallyEq_of_mem hU (fun X hX => (h2 X y hX).deriv))

theorem ax_axis_dX_nonpos : ∀ (h j0 σ δ : ℝ) (Pax : ℝ → ℝ) (Λ C K ρ1 : ℝ) (Kder : ℕ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 1 ≤ Λ → 0 < ρ1 → AxAxisOut h j0 σ δ Pax Λ C K ρ1 Kder Fn Un → ∀ X η : ℝ, 0 < X → X ≤ 41 / (10 * Λ) → -1 ≤ η → η ≤ 1 → deriv (fun Y => Fn Y η) X ≤ 0 :=
by
  intro h j0 σ δ Pax Λ C K ρ1 Kder Fn Un hΛ hρ1 hAx X η hX hXb hη1 hη2
  obtain ⟨A1, _A2, A3, A4, _A5, A6, _A7, _A8⟩ := hAx
  have hΛpos : (0 : ℝ) < Λ := by linarith
  have hlt5 : 41 / (10 * Λ) < 5 / Λ := by
    rw [div_lt_div_iff₀ (by positivity) hΛpos]
    nlinarith
  have hneg : -1 / Λ < 0 := div_neg_of_neg_of_pos (by norm_num) hΛpos

  have hint : ∀ e : ℝ, e ∈ Set.Ioo (-1 : ℝ) 1 → deriv (fun Y => Fn Y e) X ≤ 0 := by
    intro e he
    obtain ⟨he1, he2⟩ := he
    have hF0 : 0 < Fn X e := A3 X e hX.le hXb (by linarith) (by linarith)
    have hS : leadStressTh h Fn Un X e = 0 := (A4 X e hX hXb he1 he2).1
    have hid : leadStressTh h Fn Un X e = Fn X e * (psLead1 h Fn Un X e - shearA Fn X e) := rfl
    rw [hid] at hS
    rcases mul_eq_zero.mp hS with h0 | h0
    · exact absurd h0 hF0.ne'
    have hP : 0 < psLead1 h Fn Un X e :=
      (A6 X e hX hXb (by linarith) (by linarith)).2.2.2.2.2.2.2
    have hA : 0 < shearA Fn X e := by linarith
    unfold shearA at hA
    by_contra hd
    push_neg at hd
    have hnum : -2 * X * deriv (fun Y => Fn Y e) X < 0 := by nlinarith
    have : -2 * X * deriv (fun Y => Fn Y e) X / Fn X e < 0 := div_neg_of_neg_of_pos hnum hF0
    linarith
  have hmem : ((X, η) : ℝ × ℝ) ∈ Set.Ioo (-1 / Λ) (5 / Λ) ×ˢ Set.Ioo (-1 - ρ1) (1 + ρ1) :=
    Set.mk_mem_prod ⟨by linarith, by linarith⟩ ⟨by linarith, by linarith⟩
  have hSo : IsOpen (Set.Ioo (-1 / Λ) (5 / Λ) ×ˢ Set.Ioo (-1 - ρ1) (1 + ρ1)) :=
    isOpen_Ioo.prod isOpen_Ioo
  have hcf : ContinuousOn (fderiv ℝ (↿Fn)) (Set.Ioo (-1 / Λ) (5 / Λ) ×ˢ Set.Ioo (-1 - ρ1) (1 + ρ1)) :=
    A1.continuousOn_fderiv_of_isOpen hSo (by simp)
  have hder : ∀ e : ℝ, ((X, e) : ℝ × ℝ) ∈ Set.Ioo (-1 / Λ) (5 / Λ) ×ˢ Set.Ioo (-1 - ρ1) (1 + ρ1) →
      fderiv ℝ (↿Fn) (X, e) ((1 : ℝ), (0 : ℝ)) = deriv (fun Y => Fn Y e) X := by
    intro e he
    have hd : DifferentiableAt ℝ (↿Fn) (X, e) :=
      (A1.differentiableOn (by simp) _ he).differentiableAt (hSo.mem_nhds he)
    have hp : HasDerivAt (fun Y : ℝ => ((Y, e) : ℝ × ℝ)) ((1 : ℝ), (0 : ℝ)) X :=
      (hasDerivAt_id X).prodMk (hasDerivAt_const X e)
    have hc2 := hd.hasFDerivAt.comp_hasDerivAt X hp
    exact hc2.deriv.symm
  have hc0 : ContinuousAt (fun e => fderiv ℝ (↿Fn) (X, e) ((1 : ℝ), (0 : ℝ))) η := by
    have h1 : ContinuousAt (fun e : ℝ => fderiv ℝ (↿Fn) (X, e)) η :=
      (hcf.continuousAt (hSo.mem_nhds hmem)).comp
        (f := fun e : ℝ => ((X, e) : ℝ × ℝ)) (by fun_prop)
    exact h1.clm_apply continuousAt_const
  have hnb : {e : ℝ | ((X, e) : ℝ × ℝ) ∈ Set.Ioo (-1 / Λ) (5 / Λ) ×ˢ Set.Ioo (-1 - ρ1) (1 + ρ1)} ∈
      nhds η :=
    (hSo.preimage (Continuous.prodMk continuous_const continuous_id)).mem_nhds hmem
  have hc : ContinuousAt (fun e => deriv (fun Y => Fn Y e) X) η :=
    hc0.congr (Filter.eventuallyEq_of_mem hnb (fun e he => hder e he))
  have hcl : η ∈ closure (Set.Ioo (-1 : ℝ) 1) := by
    rw [closure_Ioo (by norm_num : (-1 : ℝ) ≠ 1)]
    exact ⟨hη1, hη2⟩
  exact ContinuousWithinAt.closure_le (f := fun e => deriv (fun Y => Fn Y e) X)
    (g := fun _ => (0 : ℝ)) hcl hc.continuousWithinAt continuousWithinAt_const hint

theorem ref_profile_monotone : ∀ (fr fn s : ℝ → ℝ) (a b k : ℝ), 0 < a → a ≤ b → 0 ≤ k → (∀ Y : ℝ, 0 < Y → DifferentiableAt ℝ fr Y) → (∀ Y : ℝ, 0 < Y → Y ≤ b → DifferentiableAt ℝ fn Y) → (∀ Y : ℝ, 0 < Y → 0 < fr Y) → (∀ Y : ℝ, 0 < Y → Y ≤ b → 0 < fn Y) → (∀ Y : ℝ, 0 ≤ s Y ∧ s Y ≤ 1) → (∀ Y : ℝ, b ≤ Y → s Y = 0) → (∀ Y : ℝ, 0 < Y → Y * deriv fr Y = s Y * (Y * deriv fn Y / fn Y) * fr Y) → (∀ Y : ℝ, 0 < Y → Y ≤ b → deriv fn Y ≤ 0) → (∀ Y : ℝ, 0 < Y → Y ≤ b → |Y * deriv fn Y / fn Y| ≤ k) → fr a = fn a → (∀ Y : ℝ, 0 < Y → deriv fr Y ≤ 0 ∧ |Y * deriv fr Y / fr Y| ≤ k) ∧ (∀ X : ℝ, a ≤ X → fn (min X b) ≤ fr X ∧ fr X ≤ fn a) :=
by
  intro fr fn s a b k ha hab hk Dfr Dfn Pfr Pfn S01 S0 ID Nfn Kfn E
  have hder0 : ∀ Y : ℝ, 0 < Y → b ≤ Y → deriv fr Y = 0 := by
    intro Y hY hbY
    have h := ID Y hY
    rw [S0 Y hbY] at h
    have h' : Y * deriv fr Y = 0 := by rw [h]; ring
    rcases mul_eq_zero.mp h' with h1 | h1
    · exact absurd h1 hY.ne'
    · exact h1
  have C1 : ∀ Y : ℝ, 0 < Y → deriv fr Y ≤ 0 ∧ |Y * deriv fr Y / fr Y| ≤ k := by
    intro Y hY
    rcases le_or_gt Y b with hYb | hYb
    · have hq : Y * deriv fn Y / fn Y ≤ 0 :=
        div_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonneg_of_nonpos hY.le (Nfn Y hY hYb))
          (Pfn Y hY hYb).le
      have hfr := Pfr Y hY
      have hs := S01 Y
      have h1 : Y * deriv fr Y ≤ 0 := by
        rw [ID Y hY]
        exact mul_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonneg_of_nonpos hs.1 hq) hfr.le
      have h2 : Y * deriv fr Y / fr Y = s Y * (Y * deriv fn Y / fn Y) := by
        rw [ID Y hY, mul_div_assoc, div_self hfr.ne', mul_one]
      refine ⟨?_, ?_⟩
      · by_contra hc
        push_neg at hc
        have := mul_pos hY hc
        linarith
      · rw [h2, abs_mul, abs_of_nonneg hs.1]
        have hK := Kfn Y hY hYb
        have h0 := abs_nonneg (Y * deriv fn Y / fn Y)
        nlinarith
    · have h0 := hder0 Y hY hYb.le
      refine ⟨h0.le, ?_⟩
      rw [h0]
      simpa using hk
  have hanti : AntitoneOn fr (Set.Ici a) := by
    apply antitoneOn_of_deriv_nonpos (convex_Ici a)
    · intro x hx
      exact (Dfr x (lt_of_lt_of_le ha hx)).continuousAt.continuousWithinAt
    · rw [interior_Ici]
      intro x hx
      exact (Dfr x (lt_trans ha hx)).differentiableWithinAt
    · rw [interior_Ici]
      intro x hx
      exact (C1 x (lt_trans ha hx)).1
  have hmonob : MonotoneOn fr (Set.Ici b) := by
    have hb0 : 0 < b := lt_of_lt_of_le ha hab
    apply monotoneOn_of_deriv_nonneg (convex_Ici b)
    · intro x hx
      exact (Dfr x (lt_of_lt_of_le hb0 hx)).continuousAt.continuousWithinAt
    · rw [interior_Ici]
      intro x hx
      exact (Dfr x (lt_trans hb0 hx)).differentiableWithinAt
    · rw [interior_Ici]
      intro x hx
      rw [hder0 x (lt_trans hb0 hx) (le_of_lt hx)]
  have hmonoR : MonotoneOn (fun Y => fr Y / fn Y) (Set.Icc a b) := by
    have hdiffAt : ∀ x ∈ Set.Icc a b, DifferentiableAt ℝ (fun Y => fr Y / fn Y) x := by
      intro x hx
      have hx0 : 0 < x := lt_of_lt_of_le ha hx.1
      exact (Dfr x hx0).div (Dfn x hx0 hx.2) (Pfn x hx0 hx.2).ne'
    apply monotoneOn_of_deriv_nonneg (convex_Icc a b)
    · intro x hx
      exact (hdiffAt x hx).continuousAt.continuousWithinAt
    · rw [interior_Icc]
      intro x hx
      exact (hdiffAt x (Set.Ioo_subset_Icc_self hx)).differentiableWithinAt
    · rw [interior_Icc]
      intro x hx
      have hx0 : 0 < x := lt_trans ha hx.1
      have hxb : x ≤ b := hx.2.le
      have hfn := Pfn x hx0 hxb
      have hfr := Pfr x hx0
      have hD : HasDerivAt (fun Y => fr Y / fn Y)
          ((deriv fr x * fn x - fr x * deriv fn x) / fn x ^ 2) x :=
        (Dfr x hx0).hasDerivAt.div (Dfn x hx0 hxb).hasDerivAt hfn.ne'
      rw [hD.deriv]
      apply div_nonneg _ (sq_nonneg _)
      have key : x * (deriv fr x * fn x - fr x * deriv fn x) =
          (s x - 1) * (x * deriv fn x) * fr x := by
        have h1 := ID x hx0
        have h3 : x * deriv fn x / fn x * fn x = x * deriv fn x := div_mul_cancel₀ _ hfn.ne'
        linear_combination (fn x) * h1 + s x * fr x * h3
      have hs := S01 x
      have hneg : x * deriv fn x ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hx0.le (Nfn x hx0 hxb)
      have hprod : 0 ≤ (s x - 1) * (x * deriv fn x) * fr x :=
        mul_nonneg (mul_nonneg_of_nonpos_of_nonpos (by linarith [hs.2]) hneg) hfr.le
      by_contra hc
      push_neg at hc
      have := mul_neg_of_pos_of_neg hx0 hc
      linarith
  refine ⟨C1, fun X hX => ⟨?_, ?_⟩⟩
  · have hfa : 0 < fn a := Pfn a ha hab
    have lowerIcc : ∀ x ∈ Set.Icc a b, fn x ≤ fr x := by
      intro x hx
      have hx0 : 0 < x := lt_of_lt_of_le ha hx.1
      have hm : fr a / fn a ≤ fr x / fn x := hmonoR ⟨le_rfl, hab⟩ hx hx.1
      rw [E, div_self hfa.ne', le_div_iff₀ (Pfn x hx0 hx.2)] at hm
      linarith
    rcases le_total X b with hXb | hXb
    · rw [min_eq_left hXb]
      exact lowerIcc X ⟨hX, hXb⟩
    · rw [min_eq_right hXb]
      exact le_trans (lowerIcc b ⟨hab, le_rfl⟩) (hmonob (Set.mem_Ici.mpr le_rfl) hXb hXb)
  · rw [← E]
    exact hanti (Set.mem_Ici.mpr le_rfl) hX hX

theorem eta_deriv_transfer : ∀ (f g : ℝ → ℝ → ℝ) (S : Set (ℝ × ℝ)) (s : ℝ → ℝ) (a b η L : ℝ), IsOpen S → ContDiffOn ℝ ∞ (↿f) S → a ≤ b → (∀ Y : ℝ, a ≤ Y → Y ≤ b → (Y, η) ∈ S) → (∀ Y e : ℝ, a ≤ Y → Y ≤ b → (Y, e) ∈ S → deriv (fun X => f X e) Y = s Y * g Y e) → (∀ Y : ℝ, a ≤ Y → Y ≤ b → |s Y| ≤ 1) → (∀ Y : ℝ, a ≤ Y → Y ≤ b → |deriv (fun e => g Y e) η| ≤ L) → ∀ X : ℝ, a ≤ X → X ≤ b → |deriv (fun e => f X e) η - deriv (fun e => f a e) η| ≤ L * (X - a) :=
by
  intro f g S s a b η L hS hf hab hmem hd hs hg X haX hXb
  have hmix : ∀ x y : ℝ, (x, y) ∈ S →
      HasDerivAt (fun X => deriv (fun e => f X e) y)
        (deriv (fun e => deriv (fun X => f X e) x) y) x := by
    intro x y hxy
    have hCD : ∀ q ∈ S, ContDiffAt ℝ ∞ (↿f) q := fun q hq => hf.contDiffAt (hS.mem_nhds hq)
    have hpe : ∀ X e : ℝ, (X, e) ∈ S →
        deriv (fun e' => f X e') e = fderiv ℝ (↿f) (X, e) ((0 : ℝ), (1 : ℝ)) := by
      intro X e hq
      have hD : HasFDerivAt (↿f) (fderiv ℝ (↿f) (X, e)) (X, e) :=
        ((hCD _ hq).differentiableAt (by simp)).hasFDerivAt
      have hc : HasDerivAt (fun e' : ℝ => ((X, e') : ℝ × ℝ)) ((0 : ℝ), (1 : ℝ)) e :=
        (hasDerivAt_const e X).prodMk (hasDerivAt_id e)
      exact (hD.comp_hasDerivAt e hc).deriv
    have hpX : ∀ X e : ℝ, (X, e) ∈ S →
        deriv (fun X' => f X' e) X = fderiv ℝ (↿f) (X, e) ((1 : ℝ), (0 : ℝ)) := by
      intro X e hq
      have hD : HasFDerivAt (↿f) (fderiv ℝ (↿f) (X, e)) (X, e) :=
        ((hCD _ hq).differentiableAt (by simp)).hasFDerivAt
      have hc : HasDerivAt (fun X' : ℝ => ((X', e) : ℝ × ℝ)) ((1 : ℝ), (0 : ℝ)) X :=
        (hasDerivAt_id X).prodMk (hasDerivAt_const X e)
      exact (hD.comp_hasDerivAt X hc).deriv
    have hN1 : {X' : ℝ | (X', y) ∈ S} ∈ nhds x :=
      (hS.preimage (continuous_id.prodMk continuous_const)).mem_nhds hxy
    have hN2 : {e : ℝ | (x, e) ∈ S} ∈ nhds y :=
      (hS.preimage (continuous_const.prodMk continuous_id)).mem_nhds hxy
    have hE1 : (fun X' => deriv (fun e => f X' e) y) =ᶠ[nhds x]
        (fun X' => fderiv ℝ (↿f) (X', y) ((0 : ℝ), (1 : ℝ))) :=
      Filter.eventuallyEq_of_mem hN1 (fun X' hX' => hpe X' y hX')
    have hE2 : (fun e => deriv (fun X => f X e) x) =ᶠ[nhds y]
        (fun e => fderiv ℝ (↿f) (x, e) ((1 : ℝ), (0 : ℝ))) :=
      Filter.eventuallyEq_of_mem hN2 (fun e he => hpX x e he)
    have hG : ContDiffAt ℝ 1 (fderiv ℝ (↿f)) (x, y) :=
      (hCD _ hxy).fderiv_right (by norm_num)
    have hGD : HasFDerivAt (fderiv ℝ (↿f)) (fderiv ℝ (fderiv ℝ (↿f)) (x, y)) (x, y) :=
      (hG.differentiableAt (by norm_num)).hasFDerivAt
    have h1 : HasDerivAt (fun X' => fderiv ℝ (↿f) (X', y) ((0 : ℝ), (1 : ℝ)))
        (fderiv ℝ (fderiv ℝ (↿f)) (x, y) ((1 : ℝ), (0 : ℝ)) ((0 : ℝ), (1 : ℝ))) x := by
      have hc : HasDerivAt (fun X' : ℝ => ((X', y) : ℝ × ℝ)) ((1 : ℝ), (0 : ℝ)) x :=
        (hasDerivAt_id x).prodMk (hasDerivAt_const x y)
      have hGc : HasDerivAt (fun X' : ℝ => fderiv ℝ (↿f) (X', y))
          (fderiv ℝ (fderiv ℝ (↿f)) (x, y) ((1 : ℝ), (0 : ℝ))) x :=
        hGD.comp_hasDerivAt x hc
      have hA : HasFDerivAt (fun T : ℝ × ℝ →L[ℝ] ℝ => T ((0 : ℝ), (1 : ℝ)))
          (ContinuousLinearMap.apply ℝ ℝ ((0 : ℝ), (1 : ℝ)))
          (fderiv ℝ (↿f) (x, y)) :=
        (ContinuousLinearMap.apply ℝ ℝ ((0 : ℝ), (1 : ℝ))).hasFDerivAt
      exact hA.comp_hasDerivAt x hGc
    have h2 : HasDerivAt (fun e => fderiv ℝ (↿f) (x, e) ((1 : ℝ), (0 : ℝ)))
        (fderiv ℝ (fderiv ℝ (↿f)) (x, y) ((0 : ℝ), (1 : ℝ)) ((1 : ℝ), (0 : ℝ))) y := by
      have hc : HasDerivAt (fun e : ℝ => ((x, e) : ℝ × ℝ)) ((0 : ℝ), (1 : ℝ)) y :=
        (hasDerivAt_const y x).prodMk (hasDerivAt_id y)
      have hGc : HasDerivAt (fun e : ℝ => fderiv ℝ (↿f) (x, e))
          (fderiv ℝ (fderiv ℝ (↿f)) (x, y) ((0 : ℝ), (1 : ℝ))) y :=
        hGD.comp_hasDerivAt y hc
      have hA : HasFDerivAt (fun T : ℝ × ℝ →L[ℝ] ℝ => T ((1 : ℝ), (0 : ℝ)))
          (ContinuousLinearMap.apply ℝ ℝ ((1 : ℝ), (0 : ℝ)))
          (fderiv ℝ (↿f) (x, y)) :=
        (ContinuousLinearMap.apply ℝ ℝ ((1 : ℝ), (0 : ℝ))).hasFDerivAt
      exact hA.comp_hasDerivAt y hGc
    have hsym : IsSymmSndFDerivAt ℝ (↿f) (x, y) :=
      (hCD _ hxy).isSymmSndFDerivAt (by rw [minSmoothness_of_isRCLikeNormedField]; norm_num)
    have hval : deriv (fun e => deriv (fun X => f X e) x) y =
        fderiv ℝ (fderiv ℝ (↿f)) (x, y) ((1 : ℝ), (0 : ℝ)) ((0 : ℝ), (1 : ℝ)) := by
      rw [hE2.deriv_eq, h2.deriv, hsym.eq]
    rw [hval]
    exact h1.congr_of_eventuallyEq hE1
  have hderiv : ∀ Y ∈ Set.Icc a b, HasDerivWithinAt (fun Y => deriv (fun e => f Y e) η)
      (deriv (fun e => deriv (fun X => f X e) Y) η) (Set.Icc a b) Y :=
    fun Y hY => (hmix Y η (hmem Y hY.1 hY.2)).hasDerivWithinAt
  have hbound : ∀ Y ∈ Set.Ico a b, ‖deriv (fun e => deriv (fun X => f X e) Y) η‖ ≤ L := by
    intro Y hY
    have hY1 := hY.1
    have hY2 := hY.2.le
    have hN : {e : ℝ | (Y, e) ∈ S} ∈ nhds η :=
      (hS.preimage (continuous_const.prodMk continuous_id)).mem_nhds (hmem Y hY1 hY2)
    have hE : (fun e => deriv (fun X => f X e) Y) =ᶠ[nhds η] (fun e => s Y * g Y e) :=
      Filter.eventuallyEq_of_mem hN (fun e he => hd Y e hY1 hY2 he)
    rw [hE.deriv_eq, deriv_const_mul_field, Real.norm_eq_abs, abs_mul]
    calc |s Y| * |deriv (fun e => g Y e) η| ≤ 1 * L :=
          mul_le_mul (hs Y hY1 hY2) (hg Y hY1 hY2) (abs_nonneg _) zero_le_one
      _ = L := one_mul L
  have hfin := norm_image_sub_le_of_norm_deriv_le_segment' hderiv hbound X ⟨haX, hXb⟩
  rwa [Real.norm_eq_abs] at hfin

theorem ax_kder_slice_bounds : ∀ (Λ C ρ1 : ℝ) (Kder : ℕ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 1 ≤ Λ → 0 < C → 0 < ρ1 → ContDiffOn ℝ ∞ (↿Fn) (Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) → ContDiffOn ℝ ∞ (↿Un) (Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) → (∀ X η : ℝ, 0 ≤ X → X ≤ 41 / (10 * Λ) → -1 - ρ1 < η → η < 1 + ρ1 → 0 < Fn X η) → (∀ m : ℕ, ∀ X η : ℝ, 0 ≤ X → X ≤ 41 / (10 * Λ) → -1 - ρ1 < η → η < 1 + ρ1 → ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ => C * Fn z.1 z.2) (X, η)‖ ≤ Kder m ∧ ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ => (C * Fn z.1 z.2)⁻¹) (X, η)‖ ≤ Kder m ∧ ‖iteratedFDeriv ℝ m (↿Un) (X, η)‖ ≤ Kder m) → ∀ X η : ℝ, 0 ≤ X → X ≤ 41 / (10 * Λ) → -1 - ρ1 < η → η < 1 + ρ1 → 1 ≤ Kder 0 * (C * Fn X η) ∧ C * Fn X η ≤ Kder 0 ∧ |deriv (fun Y => Un Y η) X| ≤ Kder 1 ∧ |deriv (fun e => deriv (fun Y => Un Y e) X) η| ≤ Kder 2 ∧ |deriv (fun e => deriv (fun Y => Fn Y e) X / Fn X e) η| ≤ Kder 2 * Kder 0 + Kder 1 ^ 2 * Kder 0 ^ 2 :=
by
  intro Λ C ρ1 Kder Fn Un hΛ hC hρ1 hFs hUs hpos hB X η hX0 hX1 hη1 hη2
  obtain ⟨S, hSdef⟩ : ∃ S : Set (ℝ × ℝ), S = Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1) :=
    ⟨_, rfl⟩
  rw [← hSdef] at hFs hUs
  have hSo : IsOpen S := by rw [hSdef]; exact isOpen_Ioo.prod isOpen_Ioo
  have hΛpos : 0 < Λ := by linarith
  have hmem : (X, η) ∈ S := by
    rw [hSdef]
    refine Set.mk_mem_prod ⟨?_, ?_⟩ ⟨hη1, hη2⟩
    · have : -1 / Λ < 0 := div_neg_of_neg_of_pos (by norm_num) hΛpos
      linarith
    · have h41 : 41 / (10 * Λ) < 5 / Λ := by
        rw [div_lt_div_iff₀ (by positivity) hΛpos]; nlinarith
      linarith

  have mixed : ∀ f : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿f) S → ∃ d : ℝ,
      HasDerivAt (fun e => deriv (fun Y => f Y e) X) d η ∧
        |d| ≤ ‖iteratedFDeriv ℝ 2 (↿f) (X, η)‖ := by
    intro f hf
    have hslice : ∀ e, (X, e) ∈ S →
        deriv (fun Y => f Y e) X = fderiv ℝ (↿f) (X, e) ((1:ℝ), (0:ℝ)) := by
      intro e he
      have hd : DifferentiableAt ℝ (↿f) (X, e) :=
        (hf.contDiffAt (hSo.mem_nhds he)).differentiableAt (by simp)
      have h1 : HasDerivAt (fun Y : ℝ => (Y, e)) ((1:ℝ), (0:ℝ)) X :=
        (hasDerivAt_id X).prodMk (hasDerivAt_const X e)
      exact (hd.hasFDerivAt.comp_hasDerivAt X h1).deriv
    have hT : {e : ℝ | (X, e) ∈ S} ∈ nhds η :=
      (hSo.preimage (continuous_const.prodMk continuous_id)).mem_nhds hmem
    have hev : (fun e => deriv (fun Y => f Y e) X) =ᶠ[nhds η]
        (fun e => fderiv ℝ (↿f) (X, e) ((1:ℝ), (0:ℝ))) :=
      Filter.eventuallyEq_of_mem hT (fun e he => hslice e he)
    have hca : ContDiffAt ℝ ∞ (↿f) (X, η) := hf.contDiffAt (hSo.mem_nhds hmem)
    have hfd : ContDiffAt ℝ 1 (fderiv ℝ (↿f)) (X, η) :=
      hca.fderiv_right (m := 1) (by exact WithTop.coe_le_coe.mpr le_top)
    have hD : HasFDerivAt (fderiv ℝ (↿f)) (fderiv ℝ (fderiv ℝ (↿f)) (X, η)) (X, η) :=
      (hfd.differentiableAt (by norm_num)).hasFDerivAt
    have h2 : HasDerivAt (fun e : ℝ => (X, e)) ((0:ℝ), (1:ℝ)) η :=
      (hasDerivAt_const η X).prodMk (hasDerivAt_id η)
    have h3 : HasDerivAt (fun e => fderiv ℝ (↿f) (X, e))
        (fderiv ℝ (fderiv ℝ (↿f)) (X, η) ((0:ℝ), (1:ℝ))) η := hD.comp_hasDerivAt η h2
    have h4 := h3.clm_apply (hasDerivAt_const η ((1:ℝ), (0:ℝ)))
    simp only [map_zero, add_zero] at h4
    refine ⟨_, h4.congr_of_eventuallyEq hev, ?_⟩
    have hn01 : ‖((0:ℝ), (1:ℝ))‖ = 1 := by simp [Prod.norm_def]
    have hn10 : ‖((1:ℝ), (0:ℝ))‖ = 1 := by simp [Prod.norm_def]
    have hle := ContinuousLinearMap.le_opNorm₂ (fderiv ℝ (fderiv ℝ (↿f)) (X, η))
      ((0:ℝ), (1:ℝ)) ((1:ℝ), (0:ℝ))
    rw [hn01, hn10, mul_one, mul_one, Real.norm_eq_abs] at hle
    have hnn : ‖fderiv ℝ (fderiv ℝ (↿f)) (X, η)‖ = ‖iteratedFDeriv ℝ 2 (↿f) (X, η)‖ := by
      rw [← norm_iteratedFDeriv_one, norm_iteratedFDeriv_fderiv]
    rw [← hnn]
    exact hle

  have first : ∀ f : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿f) S →
      HasDerivAt (fun e => f X e) (deriv (fun e => f X e) η) η ∧
      |deriv (fun Y => f Y η) X| ≤ ‖iteratedFDeriv ℝ 1 (↿f) (X, η)‖ ∧
      |deriv (fun e => f X e) η| ≤ ‖iteratedFDeriv ℝ 1 (↿f) (X, η)‖ := by
    intro f hf
    have hd : DifferentiableAt ℝ (↿f) (X, η) :=
      (hf.contDiffAt (hSo.mem_nhds hmem)).differentiableAt (by simp)
    have h1 : HasDerivAt (fun Y : ℝ => (Y, η)) ((1:ℝ), (0:ℝ)) X :=
      (hasDerivAt_id X).prodMk (hasDerivAt_const X η)
    have h2 : HasDerivAt (fun e : ℝ => (X, e)) ((0:ℝ), (1:ℝ)) η :=
      (hasDerivAt_const η X).prodMk (hasDerivAt_id η)
    have hX : HasDerivAt (fun Y => f Y η) (fderiv ℝ (↿f) (X, η) ((1:ℝ), (0:ℝ))) X := by
      have := hd.hasFDerivAt.comp_hasDerivAt X h1
      exact this
    have hE : HasDerivAt (fun e => f X e) (fderiv ℝ (↿f) (X, η) ((0:ℝ), (1:ℝ))) η := by
      have := hd.hasFDerivAt.comp_hasDerivAt η h2
      exact this
    have hn01 : ‖((0:ℝ), (1:ℝ))‖ = 1 := by simp [Prod.norm_def]
    have hn10 : ‖((1:ℝ), (0:ℝ))‖ = 1 := by simp [Prod.norm_def]
    have b1 := (fderiv ℝ (↿f) (X, η)).le_opNorm ((1:ℝ), (0:ℝ))
    have b2 := (fderiv ℝ (↿f) (X, η)).le_opNorm ((0:ℝ), (1:ℝ))
    rw [hn10, mul_one, Real.norm_eq_abs] at b1
    rw [hn01, mul_one, Real.norm_eq_abs] at b2
    rw [norm_iteratedFDeriv_one, hX.deriv, hE.deriv]
    exact ⟨hE, b1, b2⟩

  obtain ⟨hG0, hI0, -⟩ := hB 0 X η hX0 hX1 hη1 hη2
  obtain ⟨hG1, -, hU1⟩ := hB 1 X η hX0 hX1 hη1 hη2
  obtain ⟨hG2, -, hU2⟩ := hB 2 X η hX0 hX1 hη1 hη2
  simp only [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at hG0 hI0
  have hFp : 0 < Fn X η := hpos X η hX0 hX1 hη1 hη2
  have hb0 : 0 < C * Fn X η := mul_pos hC hFp
  have hinvK : (C * Fn X η)⁻¹ ≤ Kder 0 := le_trans (le_abs_self _) hI0
  have hP1 : 1 ≤ Kder 0 * (C * Fn X η) := by
    have := mul_le_mul_of_nonneg_right hinvK hb0.le
    rwa [inv_mul_cancel₀ hb0.ne'] at this
  have hP2 : C * Fn X η ≤ Kder 0 := le_trans (le_abs_self _) hG0

  have hP3 : |deriv (fun Y => Un Y η) X| ≤ Kder 1 :=
    le_trans (first Un hUs).2.1 hU1
  have hP4 : |deriv (fun e => deriv (fun Y => Un Y e) X) η| ≤ Kder 2 := by
    obtain ⟨d, hd, hdb⟩ := mixed Un hUs
    rw [hd.deriv]
    exact le_trans hdb hU2

  refine ⟨hP1, hP2, hP3, hP4, ?_⟩
  obtain ⟨G, hGdef⟩ : ∃ G : ℝ → ℝ → ℝ, G = fun Y e => C * Fn Y e := ⟨_, rfl⟩
  have hGs : ContDiffOn ℝ ∞ (↿G) S := by
    rw [hGdef]; exact contDiffOn_const.mul hFs
  have hGu : (↿G) = fun z : ℝ × ℝ => C * Fn z.1 z.2 := by rw [hGdef]; rfl
  have hrat : (fun e => deriv (fun Y => Fn Y e) X / Fn X e) =
      (fun e => deriv (fun Y => G Y e) X / G X e) := by
    funext e
    rw [hGdef]
    simp only
    rw [deriv_const_mul_field, mul_div_mul_left _ _ hC.ne']
  obtain ⟨a', ha', ha'b⟩ := mixed G hGs
  have sdf := first G hGs
  have hGX : G X η = C * Fn X η := by rw [hGdef]
  have hq0 := ha'.div sdf.1 (by rw [hGX]; exact hb0.ne')
  have hq : HasDerivAt (fun e => deriv (fun Y => G Y e) X / G X e) _ η := hq0
  rw [hrat, hq.deriv, hGX]
  have hK2 : |a'| ≤ Kder 2 := le_trans ha'b (by rw [hGu]; exact hG2)
  have hKa : |deriv (fun Y => G Y η) X| ≤ Kder 1 :=
    le_trans sdf.2.1 (by rw [hGu]; exact hG1)
  have hKb : |deriv (fun e => G X e) η| ≤ Kder 1 :=
    le_trans sdf.2.2 (by rw [hGu]; exact hG1)

  set a := deriv (fun Y => G Y η) X
  set b' := deriv (fun e => G X e) η
  set b := C * Fn X η
  set u := b⁻¹ with hu
  have hu0 : 0 < u := inv_pos.mpr hb0
  have hid : (a' * b - a * b') / b ^ 2 = a' * u - a * b' * u ^ 2 := by
    rw [hu]; field_simp
  rw [hid]
  have hK1n : 0 ≤ Kder 1 := le_trans (abs_nonneg _) hKa
  have hK2n : 0 ≤ Kder 2 := le_trans (abs_nonneg _) hK2
  have t1 : |a' * u| ≤ Kder 2 * Kder 0 := by
    rw [abs_mul, abs_of_pos hu0]
    exact mul_le_mul hK2 hinvK hu0.le hK2n
  have t2 : |a * b' * u ^ 2| ≤ Kder 1 ^ 2 * Kder 0 ^ 2 := by
    rw [abs_mul, abs_mul, abs_of_pos (pow_pos hu0 2)]
    have hab : |a| * |b'| ≤ Kder 1 ^ 2 := by
      rw [sq]; exact mul_le_mul hKa hKb (abs_nonneg _) hK1n
    have hu2 : u ^ 2 ≤ Kder 0 ^ 2 := pow_le_pow_left₀ hu0.le hinvK 2
    exact mul_le_mul hab hu2 (pow_pos hu0 2).le (sq_nonneg _)
  calc |a' * u - a * b' * u ^ 2| ≤ |a' * u| + |a * b' * u ^ 2| := abs_sub _ _
    _ ≤ _ := add_le_add t1 t2

theorem ax_ref_transfer : ∀ (h Pst : ℝ) (Pax : ℝ → ℝ), AxDatum h Pst Pax → ∀ (j0 σ δ ρ : ℝ) (Pc : ℂ → ℂ), 0 < j0 → j0 ≤ 1 / 20 → AxData h j0 σ δ ρ Pc Pax → ∀ (Λ C K ρ1 : ℝ) (Kder : ℕ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 0 < K → 0 < ρ1 → 1 ≤ Λ → 0 < C → AxAxisOut h j0 σ δ Pax Λ C K ρ1 Kder Fn Un → ∃ ts : ℝ, 0 < ts ∧ ts ≤ 1 / 100 ∧ ∀ t1 : ℝ, 0 < t1 → t1 ≤ ts → ∀ X η : ℝ, 0 ≤ X → X ≤ 110 → -1 ≤ η → η ≤ 1 → |axRefU Λ t1 Un X η - (4 * η + j0)| ≤ 2 * K / Λ ∧ |deriv (fun e => axRefU Λ t1 Un X e) η - 4| ≤ 2 * K / Λ ∧ 1 ≤ Kder 0 * (C * axRefF Λ t1 Fn X η) ∧ C * axRefF Λ t1 Fn X η ≤ Kder 0 ∧ (0 < X → deriv (fun Y => axRefF Λ t1 Fn Y η) X ≤ 0 ∧ |X * deriv (fun Y => axRefF Λ t1 Fn Y η) X / axRefF Λ t1 Fn X η| ≤ K * (axChi h j0 σ η + 1 / Λ) ∧ |axHs h j0 η * (deriv (fun e => axRefF Λ t1 Fn X e) η / axRefF Λ t1 Fn X η - Λ * axZeta h j0 σ η)| ≤ 2 * K * (axChi h j0 σ η + 1 / Λ) ∧ |deriv (fun e => axRefF Λ t1 Fn X e) η / axRefF Λ t1 Fn X η - Λ * axZeta h j0 σ η| ≤ 2 * K) :=
by
  intro h Pst Pax hD j0 σ δ ρ Pc hj0 hj0' hAD Λ C K ρ1 Kder Fn Un hK hρ1 hΛ hC hAx
  have hh0 : 0 < h := hD.1
  have hh1 : h < 1 / 100 := hD.2.1
  have hσ : 0 < σ := hAD.1
  obtain ⟨hA1, hA2, hA3, -, -, hA6, -, hA8⟩ := id hAx
  have hΛpos : 0 < Λ := by linarith
  have h4pos : 0 < 4 / Λ := div_pos (by norm_num) hΛpos
  have h1L : -1 / Λ < 0 := div_neg_of_neg_of_pos (by norm_num) hΛpos
  have hKB := ax_kder_slice_bounds Λ C ρ1 Kder Fn Un hΛ hC hρ1 hA1 hA2 hA3 hA8
