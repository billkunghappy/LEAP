    have hanti : Antitone ρ := antitone_nat_of_succ_le (fun k => (h1 k).2)
    have hmapT : ∀ t ∈ Ioc (0:ℝ) 1, ∀ Y, 0 < Y → Y < Xi → 0 < t * Y ∧ t * Y < Xi := by
      intro t ht Y hY hYi
      refine ⟨mul_pos ht.1 hY, ?_⟩
      calc t * Y ≤ 1 * Y := mul_le_mul_of_nonneg_right ht.2 hY.le
        _ = Y := one_mul _
        _ < Xi := hYi
    have hbC : ∀ j X w, 0 < X → X < Xi → w ∈ cStrip (ρ j) → ‖rc j X w‖ ≤ |C j| :=
