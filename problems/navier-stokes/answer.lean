theorem stress5_change_identities : ∀ (B : BG) (G : CorrGeom), B.ok → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (S S' : CState), (∀ (a : Fin 3), ∀ ξ ∈ DomC B.h (qsOf l0), mcor5 B G l0 S' a ξ = mcor5 B G l0 S a ξ) →
    (∀ a : Fin 3, ∃ α : ℝ, InM B (qsOf l0) α (nrm B (Aex B.h) (mcor5 B G l0 S a))) →
    (∀ a b : Fin 3, ∃ α : ℝ, InM B (qsOf l0) α (nrm B (2 * Aex B.h) (Wcov5 B G l0 S a b))) →
    (∀ a b : Fin 3, ∃ α : ℝ, InM B (qsOf l0) α (nrm B (2 * Aex B.h) (Wcov5 B G l0 S' a b))) →
    (∃ α : ℝ, InM B (qsOf l0) α (nrm B (2 * Aex B.h) (pmP5 B G l0 S))) →
    ∀ ξ ∈ DomC B.h (qsOf l0),
      EthP5 B G l0 S' ξ = EthP5 B G l0 S ξ + (dR B.h (dWc5 B G l0 S S' 0 1) ξ +
        2 * dWc5 B G l0 S S' 0 1 ξ / ξ.1 + dZ (dWc5 B G l0 S S' 2 1) ξ) ∧
      dgr5 B G l0 S S' ξ = -(dR B.h (dWc5 B G l0 S S' 0 0) ξ + dWc5 B G l0 S S' 0 0 ξ / ξ.1) -
        dZ (dWc5 B G l0 S S' 2 0) ξ + dWc5 B G l0 S S' 1 1 ξ / ξ.1 ∧
      ((∃ α : ℝ, InM B (qsOf l0) α (nrm B (2 * Aex B.h) (pmP5 B G l0 S'))) →
        EzP5 B G l0 S' ξ = EzP5 B G l0 S ξ + (dR B.h (dWc5 B G l0 S S' 0 2) ξ +
          dWc5 B G l0 S S' 0 2 ξ / ξ.1 +
          dZ (fun η => dWc5 B G l0 S S' 2 2 η + (pmP5 B G l0 S' η - pmP5 B G l0 S η)) ξ)) ∧
      calP5 B G l0 S' ξ.2.1 ξ.2.2.1 = calP5 B G l0 S ξ.2.1 ξ.2.2.1 + radMom (dgr5 B G l0 S S') 0 ξ.2.1 ξ.2.2.1 ∧
      calJth5 B G l0 S' ξ.2.1 ξ.2.2.1 =
        calJth5 B G l0 S ξ.2.1 ξ.2.2.1 + radMom (dWc5 B G l0 S S' 2 1) 2 ξ.2.1 ξ.2.2.1 ∧
      calJz5 B G l0 S' ξ.2.1 ξ.2.2.1 = calJz5 B G l0 S ξ.2.1 ξ.2.2.1 +
        radMom (dWc5 B G l0 S S' 2 2) 1 ξ.2.1 ξ.2.2.1 - (1/2) * radMom (dgr5 B G l0 S S') 2 ξ.2.1 ξ.2.2.1 ∧
      pmP5 B G l0 S' ξ = pmP5 B G l0 S ξ + Icut B (momDgt B (dgr5 B G l0 S S')) ξ :=
by
  intro B G hB
  obtain ⟨l1, h⟩ := wmo_change_identities_v5 B G hB
  refine ⟨l1, ?_⟩
  intro l0 hl0 S S' hmc hM hW hW' hP ξ hξ
  obtain ⟨C1, C2, C3, C4, C5, C6, C7⟩ :=
    h l0 hl0 S S' hmc hM (fun a b => ⟨hW a b, hW' a b⟩) ξ hξ
  simp only [dWc5, dgr5]
  exact ⟨C1, C2, fun hP' => C3 hP hP', C4, C5, C6, C7⟩

theorem stress5_state_grP_class : ∀ (B : BG) (G : CorrGeom), B.ok → SimNorm B.h → ∃ l1 : ℕ, ∀ l0 : ℕ,
    l1 ≤ l0 → ∀ (S : CState), InM B (qsOf l0) 0.9 (nrm B (Aex B.h) (mcor5 B G l0 S 1)) →
