  have iAR : Integrable (fun y => (η * (1 + η ^ 2)⁻¹) *
      (Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * rfpK P.Md y) +
      (((1 + η ^ 2)⁻¹) ^ 2 * P.Amp η) *
      (Real.sqrt 2 * Real.exp (3 / 2 * y + 2 * rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))))
