    have hwn : ‖w‖ ≤ L * (K * ‖d‖) := hwb.trans (mul_le_mul_of_nonneg_left (hzb d η h1 h2) hL)
    obtain ⟨e0, e1, e2, e3, e4⟩ := hexp (Φ d η) η
    rw [← hk] at e2 e3 e4
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · have hΦw : Φ d η = k • w := by
        funext i; simp only [Pi.smul_apply, smul_eq_mul, hc]
