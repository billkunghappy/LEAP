    have habs : |(-(β * κ) / 2)| = β * κ / 2 := by
      rw [abs_div, abs_neg, abs_of_nonneg hbk0, abs_of_pos (by norm_num : (0:ℝ) < 2)]
    have hM0 := abs_nonneg (M 0)
    have hM1 := abs_nonneg (M 1)
