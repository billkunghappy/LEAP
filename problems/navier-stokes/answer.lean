    intro w a; simp [vtv]
  have hvtv2 : ∀ (w : ℝ × ℝ) (a : ℝ), (w + a • vtv).2 = w.2 + a := by
    intro w a; simp [vtv]

  have s1 : ∀ (w : ℝ × ℝ) (a : ℝ), lamR (w + a • vtv) = lamR w ∧ lamT (w + a • vtv) = lamT w + a := by
    intro w a
    unfold lamR lamT
    rw [hvtv1, hvtv2]
    constructor
    · congr 1; ring
    · field_simp; ring

  have s2 : ∀ (n : ℤ) (Z : ℝ × ℝ) (a : ℝ), Jpow n (Z + a • vtv) = Jpow n Z + (Tgc ^ n * a) • vtv := by
    intro n Z a
    have hc1 : (Z.1 + a * bgc - bgc * (Z.2 + a)) / (1 + bgc ^ 2) = (Z.1 - bgc * Z.2) / (1 + bgc ^ 2) := by
      congr 1; ring
    have hc2 : (bgc * (Z.1 + a * bgc) + (Z.2 + a)) / (1 + bgc ^ 2) =
        (bgc * Z.1 + Z.2) / (1 + bgc ^ 2) + a := by
      field_simp; ring
    unfold Jpow
    rw [hvtv1, hvtv2, hc1, hc2, mul_add, add_smul]
    abel

