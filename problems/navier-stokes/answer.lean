      (hI.const_mul (Real.sqrt (2 * X))) (hKθI.const_mul M) hF4
    rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul] at hmono
    rw [eTz, eTth]
    have hr0 : 0 < Real.sqrt (2 * X) := Real.sqrt_pos.mpr (by linarith)
    have hr2 : Real.sqrt (2 * X) ^ 2 = 2 * X := Real.sq_sqrt (by linarith)
    have hLr : 0 < (1 - 2 * h * η ^ 2) * Real.sqrt (2 * X) := mul_pos hL hr0
    have hXL : 0 < X * (1 - 2 * h * η ^ 2) := mul_pos hX0 hL
    have hη : |η| ≤ 1 := abs_le.mpr ⟨by linarith, by linarith⟩
    have s1 : |2 * η * (∫ s in X..Xb, Kz s) / ((1 - 2 * h * η ^ 2) * Real.sqrt (2 * X))| ≤
