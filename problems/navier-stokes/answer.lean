          rw [hfun]; exact d2 Ψ hZ x₀ hx₀ y hy a ha haK
        have hcast : ((n + 1 : ℕ) : WithTop ℕ∞) = (n : WithTop ℕ∞) + 1 := by push_cast; rfl
