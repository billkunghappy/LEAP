  have hgb : ∀ s : ℝ, 0 ≤ s → s ≤ x → 0 ≤ rinC P.Md P.Pst P.lam (Real.log s) ∧
      rinC P.Md P.Pst P.lam (Real.log s) ≤ P1 := fun s _ _ => hgP s
  have S6 := pqc_scalar_base P.lam x0 x Cs P1 (fun s => rinC P.Md P.Pst P.lam (Real.log s))
    (fun s => rfpK P.Md (Real.log s)) hl0 hl100 hx00 hx0x hCs hgm hκm hgb hgpow
