  obtain ⟨m0, hm0⟩ : ∃ m0 : ℝ, m0 = |MF 0| := ⟨_, rfl⟩
  obtain ⟨m1, hm1⟩ : ∃ m1 : ℝ, m1 = |MF 1| := ⟨_, rfl⟩
  obtain ⟨K1, hK1⟩ : ∃ K1 : ℝ, K1 = |Kd1| := ⟨_, rfl⟩
  have hP0n : 0 ≤ P0 := by rw [hP0]; exact le_max_right _ _
