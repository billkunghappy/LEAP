    simp only [Pi.zero_apply, norm_zero]
    exact mul_nonneg hC0 hP0

theorem ipb5_wave_scal_conversion : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ e : ℝ, ∃ L : ℕ → ℝ, (∀ m, 0 ≤ L m) ∧ ∀ (α : ℝ) (s : WS), InWg5 B G (qsOf l0) α s → ContDiffOn ℝ ∞ (ipb5WS B G l0 e s) (simDomain B.h (qsOf l0)) ∧ ∀ m : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) → ‖iteratedFDeriv ℝ m (ipb5WS B G l0 e s) (x, t)‖ ≤ C * simScale B.h (x 2) (1 - t) ^ (B.h * α - L m) :=
by
  intro B G hok hG
  obtain ⟨l1, H⟩ := ipb5_wave_vec_conversion B G hok hG
  refine ⟨l1, fun l0 hl0 e => ?_⟩
  obtain ⟨L, hL0, HL⟩ := H l0 hl0 e
  refine ⟨L, hL0, fun α s hs => ?_⟩
  have hSim : SimScaleProps B.h := hok.1
  obtain ⟨a, ha_def⟩ : ∃ a : WC, a = fun (γ : Lab) (m : ℤ) (ξ : Cyl) =>
      (Pi.single (2 : Fin 3) (s γ m ξ) : Fin 3 → ℂ) := ⟨_, rfl⟩

  let ι : ℂ →L[ℝ] (Fin 3 → ℂ) := ContinuousLinearMap.single ℝ (fun _ : Fin 3 => ℂ) 2
  have hι : ∀ y : ℂ, ι y = Pi.single (2 : Fin 3) y := fun y => by
    first
    | rfl
    | simp [ι, ContinuousLinearMap.single_apply]
  have hιn : ‖ι‖ ≤ 1 :=
    ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun y => by rw [hι, Pi.norm_single, one_mul])
  have haι : ∀ γ m, a γ m = ι ∘ s γ m := fun γ m => by
    funext ξ
    rw [ha_def, Function.comp_apply, hι]

  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hmap : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hqcont : ContinuousOn (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1))
        {ξ : Cyl | ξ.2.2.1 < 1} := by
      refine hSim.2.2.2.1.continuousOn.comp hmap.continuousOn ?_
      intro ξ hξ
      exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hξ)⟩
    have e : DomC B.h (qsOf l0) = {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩
        (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) ⁻¹' Iio (qsOf l0)) := rfl
    rw [e]
    exact (isOpen_lt continuous_const continuous_fst).inter
      (hqcont.isOpen_inter_preimage (isOpen_lt (by fun_prop) continuous_const) isOpen_Iio)

  have ha : InWg5 B G (qsOf l0) α a := by
    obtain ⟨⟨Hs, h0H, hHs⟩, c2, c3, c4, c5⟩ := hs
    refine ⟨⟨Hs, h0H, fun γ m hm => ?_⟩, fun γ m => ?_, fun γ m ξ hξ c hc => ?_,
      fun γ m ξ hξ hne => ?_, fun k => ?_⟩
    · funext ξ
      rw [ha_def]
      simp [hHs γ m hm]
    · rw [haι]
      exact ι.contDiff.comp_contDiffOn (c2 γ m)
    · rw [ha_def]
      simp only
      rw [c3 γ m ξ hξ c hc]
    · apply c4 γ m ξ hξ
      intro h0
      apply hne
      rw [ha_def]
      simp [h0]
    · obtain ⟨C, b, d, hC⟩ := c5 k
      refine ⟨C, b, d, fun γ m ξ hξ hX1 hX2 => le_trans ?_ (hC γ m ξ hξ hX1 hX2)⟩
      have hcd : ContDiffAt ℝ ∞ (s γ m) ξ := (c2 γ m).contDiffAt (hDopen.mem_nhds hξ)
      have hkle : ((k : ℕ) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
      unfold NB
      rw [haι, ι.iteratedFDeriv_comp_left hcd hkle]
      have hcomm : (ι.compContinuousMultilinearMap (iteratedFDeriv ℝ k (s γ m) ξ)).compContinuousLinearMap
            (fun _ => Lnorm B.h ξ) =
          ι.compContinuousMultilinearMap ((iteratedFDeriv ℝ k (s γ m) ξ).compContinuousLinearMap
            (fun _ => Lnorm B.h ξ)) := by
        ext v
        rfl
      rw [hcomm]
      exact le_trans (ι.norm_compContinuousMultilinearMap_le _)
        (mul_le_of_le_one_left (norm_nonneg _) hιn)

  have hw : ∀ θ ξ, waveV5 B G a θ ξ = fun i => if i = 2 then waveS5 B G s θ ξ else 0 := by
    intro θ ξ
    funext i
    unfold waveV5 waveS5
    by_cases hi : i = 2
    · subst hi
      simp [ha_def]
    · simp [ha_def, Pi.single_apply, hi]
  have hc : ∀ (x : ℝ³) θ ξ, (cyl2cart x (waveV5 B G a θ ξ)) 2 = waveS5 B G s θ ξ := by
    intro x θ ξ
    rw [hw]
    simp [cyl2cart, eZ]
  have hpt : ∀ z, ipb5WS B G l0 e s z = (ipb5WV B G l0 e a z) 2 := by
    intro z
    unfold ipb5WS ipb5WV
    split_ifs with hz
    · rw [PiLp.smul_apply, smul_eq_mul, hc]
    · simp
  let π₂ : ℝ³ →L[ℝ] ℝ := EuclideanSpace.proj (2 : Fin 3)
  have hπ : ∀ v : ℝ³, π₂ v = v 2 := fun v => rfl
  have hfun : ipb5WS B G l0 e s = π₂ ∘ ipb5WV B G l0 e a :=
    funext fun z => by rw [Function.comp_apply, hπ, hpt]
  have hπn : ‖π₂‖ ≤ 1 :=
    ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun v => by
      rw [hπ, one_mul]
      exact PiLp.norm_apply_le v 2)

  have hqcont : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    have hmap : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
      (((EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst).prodMk
        (continuous_const.sub continuous_snd))
    refine hSim.2.2.2.1.continuousOn.comp hmap.continuousOn ?_
    intro w hw
    exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
  have hΩ : IsOpen (simDomain B.h (qsOf l0)) := by
    have e : simDomain B.h (qsOf l0) = {w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0) := rfl
    rw [e]
    exact hqcont.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  obtain ⟨hsm, hbd⟩ := HL α a ha
  refine ⟨?_, fun m => ?_⟩
  · rw [hfun]
    exact π₂.contDiff.comp_contDiffOn hsm
  · obtain ⟨C, hC⟩ := hbd m
    refine ⟨C, fun x t hxt => ?_⟩
    have hcd : ContDiffAt ℝ ∞ (ipb5WV B G l0 e a) (x, t) := hsm.contDiffAt (hΩ.mem_nhds hxt)
    have hmle : ((m : ℕ) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
    rw [hfun]
    calc ‖iteratedFDeriv ℝ m (π₂ ∘ ipb5WV B G l0 e a) (x, t)‖
        ≤ ‖π₂‖ * ‖iteratedFDeriv ℝ m (ipb5WV B G l0 e a) (x, t)‖ :=
          π₂.norm_iteratedFDeriv_comp_left hcd hmle
      _ ≤ ‖iteratedFDeriv ℝ m (ipb5WV B G l0 e a) (x, t)‖ :=
          mul_le_of_le_one_left (norm_nonneg _) hπn
      _ ≤ _ := hC x t hxt

theorem ipb5_lnorm_inv_bound : ∀ (h : ℝ) (ξ : Cyl), 0 ≤ h → h ≤ 1/2 → 0 < qC h ξ → qC h ξ ≤ 1 → 0 ≤ coarseIdx h (qC h ξ) → Tgc ^ (coarseIdx h (qC h ξ)) ≤ qC h ξ ^ (-(2:ℝ)) → ∀ (g : Cyl → ℝ) (k : ℕ), ‖iteratedFDeriv ℝ k g ξ‖ ≤ (4 * qC h ξ ^ (-(2:ℝ))) ^ k * NB h g k ξ :=
by
  intro h ξ hh0 hh1 hq hhi hn hTn g k
  have hs2lt : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
  have hs2gt : 1 < Real.sqrt 2 := Real.one_lt_sqrt_two
  have hL : Lgc ≠ 0 := by unfold Lgc; intro h0; linarith
  have hTg : Tgc ≠ 0 := by unfold Tgc; intro h0; linarith [Real.sqrt_nonneg 2]
  have hN : (1 + bgc ^ 2) ≠ 0 := by positivity
  have c1 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).1 = Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) * bgc := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have c2 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).2 = -(Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) * bgc) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have hcomp : ∀ (m n : ℤ) (Y : ℝ × ℝ), Jpow m (Jpow n Y) = Jpow (m + n) Y := by
    intro m n Y
    refine Prod.ext ?_ ?_
    · rw [c1 m, c1 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hTg]
      field_simp
      ring
    · rw [c2 m, c2 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hTg]
      field_simp
      ring
  have hid : ∀ Y : ℝ × ℝ, Jpow 0 Y = Y := by
    intro Y
    refine Prod.ext ?_ ?_
    · rw [c1, zpow_zero, zpow_zero]
      field_simp
      ring
    · rw [c2, zpow_zero, zpow_zero]
      field_simp
      ring
  have hJ : ∀ (m : ℤ) (Y : ℝ × ℝ), JpowL m Y = Jpow m Y := by
    intro m Y
    refine Prod.ext ?_ ?_
    · simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
        ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Prod.fst_add, Prod.smul_fst,
        smul_eq_mul]
      rw [c1, c1, c1]
      ring
    · simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
        ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Prod.snd_add, Prod.smul_snd,
        smul_eq_mul]
      rw [c2, c2, c2]
      ring
  have hJinv : ∀ (n : ℤ) (Y : ℝ × ℝ), JpowL (-n) (JpowL n Y) = Y := by
    intro n Y
    rw [hJ, hJ, hcomp, neg_add_cancel, hid]

  have hb0 : 0 ≤ bgc := by unfold bgc; linarith
  have hb1 : bgc ≤ 1 := by unfold bgc; linarith
  have hc1 : 1 ≤ 1 + bgc ^ 2 := le_add_of_nonneg_right (sq_nonneg _)
  have hcpos : (0:ℝ) < 1 + bgc ^ 2 := by linarith
  have hLpos : 0 < Lgc := by unfold Lgc; linarith
  have hLT : Lgc ≤ Tgc := by unfold Lgc Tgc; linarith [Real.sqrt_nonneg 2]

  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = 4 * qC h ξ ^ (-(2:ℝ)) := ⟨_, rfl⟩
  have hQ1 : 1 ≤ qC h ξ ^ (-(2:ℝ)) :=
    Real.one_le_rpow_of_pos_of_le_one_of_nonpos hq hhi (by norm_num)
  have hqinvQ : (qC h ξ)⁻¹ ≤ qC h ξ ^ (-(2:ℝ)) := by
    rw [← Real.rpow_neg_one]
    exact Real.rpow_le_rpow_of_exponent_ge hq hhi (by norm_num)
  have hK0 : 0 ≤ K := by rw [hK]; linarith
  have hQK : qC h ξ ^ (-(2:ℝ)) ≤ K := by rw [hK]; linarith
  have hqK : (qC h ξ)⁻¹ ≤ K := le_trans hqinvQ hQK

  have hsq0 : 0 < Real.sqrt (qC h ξ) := Real.sqrt_pos.mpr hq
  have hsq1 : Real.sqrt (qC h ξ) ≤ 1 := by
    rw [← Real.sqrt_one]; exact Real.sqrt_le_sqrt hhi
  have hqsq : qC h ξ ≤ Real.sqrt (qC h ξ) := by
    have e := Real.mul_self_sqrt hq.le
    have := mul_le_mul_of_nonneg_left hsq1 hsq0.le
    nlinarith
  have hqe0 : 0 < qC h ξ ^ (1/2 - h) := Real.rpow_pos_of_pos hq _
  have hqqe : qC h ξ ≤ qC h ξ ^ (1/2 - h) := by
    have := Real.rpow_le_rpow_of_exponent_ge hq hhi (show 1/2 - h ≤ 1 by linarith)
    rwa [Real.rpow_one] at this
  have hi1 : (Real.sqrt (qC h ξ))⁻¹ ≤ K := le_trans (inv_anti₀ hq hqsq) hqK
  have hi2 : (qC h ξ ^ (1/2 - h))⁻¹ ≤ K := le_trans (inv_anti₀ hq hqqe) hqK

  have hslot : ∀ (m : ℤ), 0 ≤ m → Tgc ^ m ≤ qC h ξ ^ (-(2:ℝ)) → ∀ Y : ℝ × ℝ,
      ‖JpowL m Y‖ ≤ K * ‖Y‖ := by
    intro m hm hTm Y
    have hY1 : |Y.1| ≤ ‖Y‖ := by rw [← Real.norm_eq_abs]; exact norm_fst_le Y
    have hY2 : |Y.2| ≤ ‖Y‖ := by rw [← Real.norm_eq_abs]; exact norm_snd_le Y
    have hr : 0 ≤ ‖Y‖ := norm_nonneg _
    have hdiv : ∀ x : ℝ, |x / (1 + bgc ^ 2)| ≤ |x| := by
      intro x
      rw [abs_div, abs_of_pos hcpos]
      exact div_le_self (abs_nonneg _) hc1
    have hbY2 : |bgc * Y.2| ≤ ‖Y‖ := by
      rw [abs_mul, abs_of_nonneg hb0]
      calc bgc * |Y.2| ≤ 1 * ‖Y‖ := mul_le_mul hb1 hY2 (abs_nonneg _) zero_le_one
        _ = ‖Y‖ := one_mul _
    have hbY1 : |bgc * Y.1| ≤ ‖Y‖ := by
      rw [abs_mul, abs_of_nonneg hb0]
      calc bgc * |Y.1| ≤ 1 * ‖Y‖ := mul_le_mul hb1 hY1 (abs_nonneg _) zero_le_one
        _ = ‖Y‖ := one_mul _
    obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = (Y.1 - bgc * Y.2) / (1 + bgc ^ 2) := ⟨_, rfl⟩
    obtain ⟨b, hb_def⟩ : ∃ b : ℝ, b = (bgc * Y.1 + Y.2) / (1 + bgc ^ 2) := ⟨_, rfl⟩
    have ha : |a| ≤ 2 * ‖Y‖ := by
      rw [ha_def]
      refine le_trans (hdiv _) ?_
      linarith [abs_sub (Y.1) (bgc * Y.2)]
    have hb : |b| ≤ 2 * ‖Y‖ := by
      rw [hb_def]
      refine le_trans (hdiv _) ?_
      linarith [abs_add_le (bgc * Y.1) (Y.2)]
    have hLn0 : 0 < Lgc ^ m := zpow_pos hLpos m
    have hTn0 : 0 < Tgc ^ m := zpow_pos (lt_of_lt_of_le hLpos hLT) m
    have hLTn : Lgc ^ m ≤ Tgc ^ m := zpow_le_zpow_left₀ hm hLpos.le hLT
    have hTnK : 4 * Tgc ^ m ≤ K := by rw [hK]; linarith
    have e1 := c1 m Y
    have e2 := c2 m Y
    rw [← ha_def, ← hb_def] at e1 e2
    have tL : |Lgc ^ m * a| ≤ Tgc ^ m * (2 * ‖Y‖) := by
      rw [abs_mul, abs_of_pos hLn0]
      exact mul_le_mul hLTn ha (abs_nonneg _) hTn0.le
    have tT : |Tgc ^ m * b| ≤ Tgc ^ m * (2 * ‖Y‖) := by
      rw [abs_mul, abs_of_pos hTn0]
      exact mul_le_mul_of_nonneg_left hb hTn0.le
    have tTb : |Tgc ^ m * b * bgc| ≤ Tgc ^ m * (2 * ‖Y‖) := by
      rw [abs_mul (Tgc ^ m * b), abs_of_nonneg hb0]
      calc |Tgc ^ m * b| * bgc ≤ |Tgc ^ m * b| * 1 :=
            mul_le_mul_of_nonneg_left hb1 (abs_nonneg _)
        _ = |Tgc ^ m * b| := mul_one _
        _ ≤ _ := tT
    have tLb : |-(Lgc ^ m * a * bgc)| ≤ Tgc ^ m * (2 * ‖Y‖) := by
      rw [abs_neg, abs_mul (Lgc ^ m * a), abs_of_nonneg hb0]
      calc |Lgc ^ m * a| * bgc ≤ |Lgc ^ m * a| * 1 :=
            mul_le_mul_of_nonneg_left hb1 (abs_nonneg _)
        _ = |Lgc ^ m * a| := mul_one _
        _ ≤ _ := tL
    rw [hJ]
    refine norm_prod_le_iff.mpr ⟨?_, ?_⟩
    · rw [Real.norm_eq_abs, e1]
      calc _ ≤ |Lgc ^ m * a| + |Tgc ^ m * b * bgc| := abs_add_le _ _
        _ ≤ 4 * Tgc ^ m * ‖Y‖ := by linarith
        _ ≤ K * ‖Y‖ := mul_le_mul_of_nonneg_right hTnK hr
    · rw [Real.norm_eq_abs, e2]
      calc _ ≤ |-(Lgc ^ m * a * bgc)| + |Tgc ^ m * b| := abs_add_le _ _
        _ ≤ 4 * Tgc ^ m * ‖Y‖ := by linarith
        _ ≤ K * ‖Y‖ := mul_le_mul_of_nonneg_right hTnK hr

  have hnorm4 : ∀ (a b c : ℝ) (d : ℝ × ℝ) (r : ℝ), ‖a‖ ≤ r → ‖b‖ ≤ r → ‖c‖ ≤ r → ‖d‖ ≤ r →
      ‖((a, b, c, d) : Cyl)‖ ≤ r := by
    intro a b c d r ha hb hc hd
    exact norm_prod_le_iff.mpr ⟨ha, norm_prod_le_iff.mpr ⟨hb, norm_prod_le_iff.mpr ⟨hc, hd⟩⟩⟩
  have hsc : ∀ (c x r : ℝ), 0 ≤ c → c ≤ K → ‖x‖ ≤ r → ‖c * x‖ ≤ K * r := by
    intro c x r hc hcM hx
    rw [norm_mul, Real.norm_of_nonneg hc]
    exact mul_le_mul hcM hx (norm_nonneg _) hK0
  have hu1 : ∀ u : Cyl, ‖u.1‖ ≤ ‖u‖ := fun u => norm_fst_le u
  have hu2 : ∀ u : Cyl, ‖u.2.1‖ ≤ ‖u‖ := fun u => (norm_fst_le u.2).trans (norm_snd_le u)
  have hu3 : ∀ u : Cyl, ‖u.2.2.1‖ ≤ ‖u‖ := fun u =>
    ((norm_fst_le u.2.2).trans (norm_snd_le u.2)).trans (norm_snd_le u)
  have hu4 : ∀ u : Cyl, ‖u.2.2.2‖ ≤ ‖u‖ := fun u =>
    ((norm_snd_le u.2.2).trans (norm_snd_le u.2)).trans (norm_snd_le u)

  have hLap : ∀ u : Cyl, Lnorm h ξ u = (Real.sqrt (qC h ξ) * u.1, qC h ξ ^ (1/2 - h) * u.2.1,
      qC h ξ * u.2.2.1, JpowL (-(coarseIdx h (qC h ξ))) u.2.2.2) := fun u => rfl
  obtain ⟨R, hRdef⟩ : ∃ R : Cyl →L[ℝ] Cyl,
      R = ((Real.sqrt (qC h ξ))⁻¹ • ContinuousLinearMap.id ℝ ℝ).prodMap
        (((qC h ξ ^ (1/2 - h))⁻¹ • ContinuousLinearMap.id ℝ ℝ).prodMap
          (((qC h ξ)⁻¹ • ContinuousLinearMap.id ℝ ℝ).prodMap (JpowL (coarseIdx h (qC h ξ))))) :=
    ⟨_, rfl⟩
  have hRap : ∀ u : Cyl, R u = ((Real.sqrt (qC h ξ))⁻¹ * u.1, (qC h ξ ^ (1/2 - h))⁻¹ * u.2.1,
      (qC h ξ)⁻¹ * u.2.2.1, JpowL (coarseIdx h (qC h ξ)) u.2.2.2) := by
    intro u; rw [hRdef]; rfl
  have hR : ∀ u : Cyl, ‖R u‖ ≤ K * ‖u‖ := by
    intro u
    rw [hRap]
    exact hnorm4 _ _ _ _ _ (hsc _ _ _ (inv_nonneg.mpr hsq0.le) hi1 (hu1 u))
      (hsc _ _ _ (inv_nonneg.mpr hqe0.le) hi2 (hu2 u))
      (hsc _ _ _ (inv_nonneg.mpr hq.le) hqK (hu3 u))
      (le_trans (hslot _ hn hTn u.2.2.2) (mul_le_mul_of_nonneg_left (hu4 u) hK0))
  have hPR : ∀ u : Cyl, Lnorm h ξ (R u) = u := by
    intro u
    obtain ⟨a, b, c, d⟩ := u
    rw [hRap, hLap]
    simp only [Prod.mk.injEq]
    refine ⟨mul_inv_cancel_left₀ hsq0.ne' a, mul_inv_cancel_left₀ hqe0.ne' b,
      mul_inv_cancel_left₀ hq.ne' c, hJinv _ d⟩
  have hRn : ‖R‖ ≤ K := ContinuousLinearMap.opNorm_le_bound _ hK0 hR

  unfold NB
  obtain ⟨A, hAdef⟩ : ∃ A, A = iteratedFDeriv ℝ k g ξ := ⟨_, rfl⟩
  rw [← hAdef, ← hK]
  have hA : A = (A.compContinuousLinearMap (fun _ => Lnorm h ξ)).compContinuousLinearMap
      (fun _ => R) := by
    ext m
    simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply, hPR]
  have h1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
    (A.compContinuousLinearMap (fun _ => Lnorm h ξ)) (fun _ : Fin k => R)
  rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin] at h1
  calc ‖A‖ = ‖(A.compContinuousLinearMap (fun _ => Lnorm h ξ)).compContinuousLinearMap
          (fun _ => R)‖ := congrArg _ hA
    _ ≤ ‖A.compContinuousLinearMap (fun _ => Lnorm h ξ)‖ * ‖R‖ ^ k := h1
    _ ≤ ‖A.compContinuousLinearMap (fun _ => Lnorm h ξ)‖ * K ^ k :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) hRn k) (norm_nonneg _)
    _ = K ^ k * ‖A.compContinuousLinearMap (fun _ => Lnorm h ξ)‖ := mul_comm _ _

theorem ipb5_inm_raw_bound : ∀ (B : BG) (l0 : ℕ), B.ok → 60 ≤ l0 → ∀ (α : ℝ) (f : Cyl → ℝ), InM B (qsOf l0) α f → ∀ n : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0), ∀ j : ℕ, j ≤ n → ‖iteratedFDeriv ℝ j f ξ‖ ≤ C * qC B.h ξ ^ (B.h * α - 2 * (n : ℝ) - 1) :=
by
  intro B l0 hok hl0 α f hf n
  have hh0 : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1

  have hlog : ∀ b : ℝ, ∃ E : ℝ, 0 ≤ E ∧ ∀ q : ℝ, 0 < q → q ≤ 1 →
      (1 + |Real.log q|) ^ (2 * b) ≤ E * q ^ (-(1:ℝ)) := by
    intro b
    obtain ⟨N, hN⟩ : ∃ N : ℕ, N = ⌈2 * b⌉₊ + 1 := ⟨_, rfl⟩
    have hN0 : N ≠ 0 := by omega
    have hceil : (0:ℝ) ≤ (⌈2 * b⌉₊ : ℝ) := Nat.cast_nonneg _
    have hNR : (N:ℝ) = (⌈2 * b⌉₊ : ℝ) + 1 := by rw [hN]; push_cast; ring
    have hN1 : (1:ℝ) ≤ N := by linarith
    have h2b : 2 * b ≤ (N:ℝ) := by linarith [Nat.le_ceil (2 * b)]
    refine ⟨(1 + (N:ℝ)) ^ N, by positivity, fun q hq0 hq1 => ?_⟩
    have hlq : Real.log q ≤ 0 := Real.log_nonpos hq0.le hq1
    have habs : |Real.log q| = Real.log q⁻¹ := by rw [abs_of_nonpos hlq, Real.log_inv]
    have hqi : 1 ≤ q⁻¹ := (one_le_inv₀ hq0).mpr hq1
    have hNinv : (0:ℝ) < (N:ℝ)⁻¹ := inv_pos.mpr (by linarith)
    have hle := Real.log_le_rpow_div (x := q⁻¹) (by positivity) hNinv
    obtain ⟨u, hu⟩ : ∃ u : ℝ, u = q⁻¹ ^ ((N:ℝ)⁻¹) := ⟨_, rfl⟩
    have hu1 : 1 ≤ u := by rw [hu]; exact Real.one_le_rpow hqi hNinv.le
    have hdiv : q⁻¹ ^ ((N:ℝ)⁻¹) / (N:ℝ)⁻¹ = N * u := by rw [div_inv_eq_mul, hu]; ring
    rw [hdiv] at hle
    have hy1 : 1 ≤ 1 + |Real.log q| := by linarith [abs_nonneg (Real.log q)]
    have hy : 1 + |Real.log q| ≤ (1 + (N:ℝ)) * u := by
      have e : (1 + (N:ℝ)) * u = u + N * u := by ring
      rw [habs, e]; linarith
    calc (1 + |Real.log q|) ^ (2 * b) ≤ (1 + |Real.log q|) ^ ((N:ℕ):ℝ) :=
          Real.rpow_le_rpow_of_exponent_le hy1 h2b
      _ = (1 + |Real.log q|) ^ N := Real.rpow_natCast _ _
      _ ≤ ((1 + (N:ℝ)) * u) ^ N := pow_le_pow_left₀ (by linarith) hy N
      _ = (1 + (N:ℝ)) ^ N * u ^ N := mul_pow _ _ _
      _ = (1 + (N:ℝ)) ^ N * q ^ (-(1:ℝ)) := by
          rw [hu, Real.rpow_inv_natCast_pow (by positivity) hN0, Real.rpow_neg_one]
  obtain ⟨A, b, hNB⟩ := inm_nb_uniform B (qsOf l0) α f hok hf n
  obtain ⟨E, hE0, hE⟩ := hlog b
  have hqs10 : qsOf l0 ≤ (2:ℝ) ^ (-(10:ℝ)) := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ (2:ℝ) ^ (-(10:ℝ))
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
    have : (60:ℝ) ≤ l0 := by exact_mod_cast hl0
    linarith
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hC0 : 0 ≤ (4:ℝ) ^ n * |A| * E := by positivity
  refine ⟨(4:ℝ) ^ n * |A| * E, fun ξ hξ j hj => ?_⟩
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  have q0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have q1 : qC B.h ξ ≤ 1 := le_trans hξ'.2.2.le hqs1
  have q10 : qC B.h ξ < (2:ℝ) ^ (-(10:ℝ)) := lt_of_lt_of_le hξ'.2.2 hqs10
  have hP : 0 ≤ qC B.h ξ ^ (B.h * α - 2 * (n : ℝ) - 1) := Real.rpow_nonneg q0.le _
  by_cases hsh : B.Xa < XC B.h ξ ∧ XC B.h ξ < B.Xb
  swap
  · have hoff : XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ := by
      rcases not_and_or.mp hsh with h | h
      · exact Or.inl (not_lt.mp h)
      · exact Or.inr (not_lt.mp h)
    rw [shell_deriv_vanish_v5 B (qsOf l0) f hok hf.1 hf.2.2.1 j ξ hξ hoff, norm_zero]
    exact mul_nonneg hC0 hP
  · obtain ⟨hn0, hT, -⟩ := (coarseIdx_arith_v5 B.h hh0 hh1).2 _ q0 q10
    have hinv := ipb5_lnorm_inv_bound B.h ξ hh0.le (by linarith) q0 q1 hn0 hT f j
    have hnb := hNB ξ hξ hsh.1 hsh.2 j hj
    have hy := hE (qC B.h ξ) q0 q1
    have hNBnn : 0 ≤ NB B.h f j ξ := by unfold NB; exact norm_nonneg _
    set q := qC B.h ξ with hq
    have hq2 : 1 ≤ q ^ (-(2:ℝ)) := Real.one_le_rpow_of_pos_of_le_one_of_nonpos q0 q1 (by norm_num)
    have hQ1 : 1 ≤ 4 * q ^ (-(2:ℝ)) := by linarith
    have hQj : (4 * q ^ (-(2:ℝ))) ^ j ≤ (4 * q ^ (-(2:ℝ))) ^ n := pow_le_pow_right₀ hQ1 hj
    have hha : 0 ≤ q ^ (B.h * α) := Real.rpow_nonneg q0.le _
    have hyp : 0 ≤ (1 + |Real.log q|) ^ (2 * b) :=
      Real.rpow_nonneg (by linarith [abs_nonneg (Real.log q)]) _
    have hNB2 : NB B.h f j ξ ≤ |A| * q ^ (B.h * α) * (E * q ^ (-(1:ℝ))) := by
      calc NB B.h f j ξ ≤ A * q ^ (B.h * α) * (1 + |Real.log q|) ^ (2 * b) := hnb
        _ ≤ |A| * q ^ (B.h * α) * (1 + |Real.log q|) ^ (2 * b) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_abs_self A) hha) hyp
        _ ≤ |A| * q ^ (B.h * α) * (E * q ^ (-(1:ℝ))) :=
          mul_le_mul_of_nonneg_left hy (mul_nonneg (abs_nonneg A) hha)
    have hQn0 : 0 ≤ (4 * q ^ (-(2:ℝ))) ^ n := pow_nonneg (by linarith) n
    have hexp : (4 * q ^ (-(2:ℝ))) ^ n * (|A| * q ^ (B.h * α) * (E * q ^ (-(1:ℝ)))) =
        (4:ℝ) ^ n * |A| * E * q ^ (B.h * α - 2 * (n : ℝ) - 1) := by
      have e1 : (q ^ (-(2:ℝ))) ^ n = q ^ (-(2:ℝ) * (n:ℝ)) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul q0.le]
      have e2 : q ^ (B.h * α - 2 * (n : ℝ) - 1) =
          q ^ (-(2:ℝ) * (n:ℝ)) * q ^ (B.h * α) * q ^ (-(1:ℝ)) := by
        rw [← Real.rpow_add q0, ← Real.rpow_add q0]
        congr 1
        ring
      rw [mul_pow, e1, e2]
      ring
    calc ‖iteratedFDeriv ℝ j f ξ‖ ≤ (4 * q ^ (-(2:ℝ))) ^ j * NB B.h f j ξ := hinv
      _ ≤ (4 * q ^ (-(2:ℝ))) ^ n * (|A| * q ^ (B.h * α) * (E * q ^ (-(1:ℝ)))) :=
        mul_le_mul hQj hNB2 hNBnn hQn0
      _ = _ := hexp

theorem ipb5_mean_window_reduction : ∀ (B : BG) (l0 : ℕ) (e : ℝ) (f : Cyl → ℝ), B.ok → (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → f ξ = 0) → (∀ z ∈ {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)}, ipb5MV B l0 e f z = (simScale B.h (z.1 2) (1 - z.2) ^ e * f (ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0))) • eTh z.1 ∧ ipb5MS B l0 e f z = simScale B.h (z.1 2) (1 - z.2) ^ e * f (ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0))) ∧ ∀ z ∈ simDomain B.h (qsOf l0), z ∈ {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} ∨ (ipb5MV B l0 e f =ᶠ[nhds z] (fun _ => (0 : ℝ³)) ∧ ipb5MS B l0 e f =ᶠ[nhds z] (fun _ => (0 : ℝ))) :=
by
  intro B l0 e f hok hvan
  obtain ⟨-, -, hXa, hXa1, h12, h2Xb, -⟩ := hok.2.1
  have hXb : 0 < B.Xb := by linarith
  have hqpos : ∀ w : ℝ³ × ℝ, w.2 < 1 → 0 < simScale B.h (w.1 2) (1 - w.2) := fun w hw =>
    (hok.1.1 (w.1 2) (1 - w.2) (by linarith)).1
  have hqcont : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    have hmap : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
      (((EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst).prodMk
        (continuous_const.sub continuous_snd))
    refine hok.1.2.2.2.1.continuousOn.comp hmap.continuousOn ?_
    intro w hw
    exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
  have hΩ : IsOpen (simDomain B.h (qsOf l0)) := by
    have e : simDomain B.h (qsOf l0) = {w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0) := rfl
    rw [e]
    exact hqcont.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  have hqcΩ : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      (simDomain B.h (qsOf l0)) := hqcont.mono (fun w hw => hw.1)
  have hrad : Continuous (fun w : ℝ³ × ℝ => rad w.1 ^ 2) := by
    have p0 : Continuous (fun w : ℝ³ × ℝ => w.1 0) :=
      (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst
    have p1 : Continuous (fun w : ℝ³ × ℝ => w.1 1) :=
      (EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst
    unfold rad
    exact (Real.continuous_sqrt.comp ((p0.pow 2).add (p1.pow 2))).pow 2

  have hzero : ∀ w : ℝ³ × ℝ, (corrOn B l0 w.1 w.2 →
      XC B.h (ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0)) ≤ B.Xa ∨
        B.Xb ≤ XC B.h (ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0))) →
      ipb5MV B l0 e f w = 0 ∧ ipb5MS B l0 e f w = 0 := by
    intro w H
    by_cases hc : corrOn B l0 w.1 w.2
    · have hmem : ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0) ∈ DomC B.h (qsOf l0) :=
        ⟨hc.1, hc.2.1, hc.2.2⟩
      have hf0 := hvan _ hmem (H hc)
      simp only [ipb5MV, ipb5MS, if_pos hc, hf0, mul_zero, zero_smul, and_self]
    · simp only [ipb5MV, ipb5MS, if_neg hc, and_self]
  refine ⟨?_, ?_⟩
  · intro z hz
    obtain ⟨hzΩ, hr, -, -⟩ := hz
    have hc : corrOn B l0 z.1 z.2 := ⟨hr, hzΩ.1, hzΩ.2⟩
    simp only [ipb5MV, ipb5MS, if_pos hc]
    exact ⟨rfl, rfl⟩
  · intro z hz
    have hQ : 0 < simScale B.h (z.1 2) (1 - z.2) := hqpos z hz.1

    have hO₁ : IsOpen (simDomain B.h (qsOf l0) ∩
        (fun w : ℝ³ × ℝ => B.Xa * simScale B.h (w.1 2) (1 - w.2) - rad w.1 ^ 2) ⁻¹' Ioi 0) :=
      ((continuousOn_const.mul hqcΩ).sub hrad.continuousOn).isOpen_inter_preimage hΩ isOpen_Ioi
    have hO₂ : IsOpen (simDomain B.h (qsOf l0) ∩
        (fun w : ℝ³ × ℝ => rad w.1 ^ 2 - 4 * B.Xb * simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Ioi 0) :=
      (hrad.continuousOn.sub (continuousOn_const.mul hqcΩ)).isOpen_inter_preimage hΩ isOpen_Ioi
    have hXCeq : ∀ w : ℝ³ × ℝ, XC B.h (ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0)) =
        rad w.1 ^ 2 / (2 * simScale B.h (w.1 2) (1 - w.2)) := fun w => rfl
    by_cases h1 : rad z.1 ^ 2 < B.Xa * simScale B.h (z.1 2) (1 - z.2)
    · right
      have hzO : z ∈ simDomain B.h (qsOf l0) ∩
          (fun w : ℝ³ × ℝ => B.Xa * simScale B.h (w.1 2) (1 - w.2) - rad w.1 ^ 2) ⁻¹' Ioi 0 :=
        ⟨hz, sub_pos.mpr h1⟩
      have hZ : ∀ w ∈ simDomain B.h (qsOf l0) ∩
          (fun w : ℝ³ × ℝ => B.Xa * simScale B.h (w.1 2) (1 - w.2) - rad w.1 ^ 2) ⁻¹' Ioi 0,
          ipb5MV B l0 e f w = 0 ∧ ipb5MS B l0 e f w = 0 := by
        intro w hw
        apply hzero w
        intro _
        left
        have hqw := hqpos w hw.1.1
        have hw2 : 0 < B.Xa * simScale B.h (w.1 2) (1 - w.2) - rad w.1 ^ 2 := hw.2
        have hpos : 0 < B.Xa * simScale B.h (w.1 2) (1 - w.2) := mul_pos hXa hqw
        rw [hXCeq w, div_le_iff₀ (by linarith)]
        linarith
      exact ⟨Filter.eventuallyEq_of_mem (hO₁.mem_nhds hzO) (fun w hw => (hZ w hw).1),
        Filter.eventuallyEq_of_mem (hO₁.mem_nhds hzO) (fun w hw => (hZ w hw).2)⟩
    by_cases h2 : 4 * B.Xb * simScale B.h (z.1 2) (1 - z.2) < rad z.1 ^ 2
    · right
      have hzO : z ∈ simDomain B.h (qsOf l0) ∩
          (fun w : ℝ³ × ℝ => rad w.1 ^ 2 - 4 * B.Xb * simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Ioi 0 :=
        ⟨hz, sub_pos.mpr h2⟩
      have hZ : ∀ w ∈ simDomain B.h (qsOf l0) ∩
          (fun w : ℝ³ × ℝ => rad w.1 ^ 2 - 4 * B.Xb * simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Ioi 0,
          ipb5MV B l0 e f w = 0 ∧ ipb5MS B l0 e f w = 0 := by
        intro w hw
        apply hzero w
        intro _
        right
        have hqw := hqpos w hw.1.1
        have hw2 : 0 < rad w.1 ^ 2 - 4 * B.Xb * simScale B.h (w.1 2) (1 - w.2) := hw.2
        have hpos : 0 < B.Xb * simScale B.h (w.1 2) (1 - w.2) := mul_pos hXb hqw
        rw [hXCeq w, le_div_iff₀ (by linarith)]
        linarith
      exact ⟨Filter.eventuallyEq_of_mem (hO₂.mem_nhds hzO) (fun w hw => (hZ w hw).1),
        Filter.eventuallyEq_of_mem (hO₂.mem_nhds hzO) (fun w hw => (hZ w hw).2)⟩
    left
    push_neg at h1 h2
    have hpa : 0 < B.Xa * simScale B.h (z.1 2) (1 - z.2) := mul_pos hXa hQ
    have hpb : 0 < B.Xb * simScale B.h (z.1 2) (1 - z.2) := mul_pos hXb hQ
    have hr : 0 < rad z.1 := by
      rcases (Real.sqrt_nonneg (z.1 0 ^ 2 + z.1 1 ^ 2)).lt_or_eq with h | h
      · exact h
      · exfalso
        have h0 : rad z.1 = 0 := h.symm
        rw [h0] at h1
        linarith
    refine ⟨hz, hr, by linarith, by linarith⟩

theorem ipb5_mean_conversion : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ e : ℝ, ∃ L : ℕ → ℝ, (∀ m, 0 ≤ L m) ∧ ∀ (α : ℝ) (f : Cyl → ℝ), InM B (qsOf l0) α f → ContDiffOn ℝ ∞ (ipb5MV B l0 e f) (simDomain B.h (qsOf l0)) ∧ ContDiffOn ℝ ∞ (ipb5MS B l0 e f) (simDomain B.h (qsOf l0)) ∧ ∀ m : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) → ‖iteratedFDeriv ℝ m (ipb5MV B l0 e f) (x, t)‖ ≤ C * simScale B.h (x 2) (1 - t) ^ (B.h * α - L m) ∧ ‖iteratedFDeriv ℝ m (ipb5MS B l0 e f) (x, t)‖ ≤ C * simScale B.h (x 2) (1 - t) ^ (B.h * α - L m) :=
by
  intro B G hok hG
  refine ⟨60, fun l0 hl0 e => ?_⟩
  obtain ⟨hDo, hWo, hmap, sXi, sE, sP, hcb⟩ := ipb5_mean_coord_bounds B l0 e hok
  set W : Set (ℝ³ × ℝ) := {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧
    B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧
    rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} with hWdef
  choose Cc Kc hcK using hcb
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hq : ∀ z ∈ W, 0 < simScale B.h (z.1 2) (1 - z.2) ∧ simScale B.h (z.1 2) (1 - z.2) ≤ 1 := by
    intro z hz
    have h1 : z.2 < 1 ∧ simScale B.h (z.1 2) (1 - z.2) < qsOf l0 := hz.1
    exact ⟨(hok.1.1 (z.1 2) (1 - z.2) (by linarith [h1.1])).1, le_trans h1.2.le hqs1⟩
  have key2 : ∀ (C a b q : ℝ), 0 < q → q ≤ 1 → b ≤ a → C * q ^ a ≤ |C| * q ^ b := by
    intro C a b q hq0 hq1 hba
    calc C * q ^ a ≤ |C| * q ^ a :=
          mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0.le _)
      _ ≤ |C| * q ^ b :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0 hq1 hba) (abs_nonneg C)
  obtain ⟨Kb, hKb⟩ : ∃ Kb : ℕ → ℝ, Kb = fun m => ∑ k ∈ Finset.range (m + 1), |Kc k| := ⟨_, rfl⟩
  obtain ⟨Cb, hCb⟩ : ∃ Cb : ℕ → ℝ, Cb = fun m => ∑ k ∈ Finset.range (m + 1), |Cc k| := ⟨_, rfl⟩
  have hKb0 : ∀ m, 0 ≤ Kb m := fun m => by
    rw [hKb]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have hCb0 : ∀ m, 0 ≤ Cb m := fun m => by
    rw [hCb]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have hKle : ∀ m k, k ≤ m → |Kc k| ≤ Kb m := fun m k hk => by
    rw [hKb]
    exact Finset.single_le_sum (f := fun k => |Kc k|) (fun i _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  have hCle : ∀ m k, k ≤ m → |Cc k| ≤ Cb m := fun m k hk => by
    rw [hCb]
    exact Finset.single_le_sum (f := fun k => |Cc k|) (fun i _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))

  have hco : ∀ m k, k ≤ m → ∀ z ∈ W,
      ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) z‖ ≤
          Cb m * simScale B.h (z.1 2) (1 - z.2) ^ (-Kb m) ∧
      ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => eTh z.1) z‖ ≤
          Cb m * simScale B.h (z.1 2) (1 - z.2) ^ (-Kb m) ∧
      ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => simScale B.h (z.1 2) (1 - z.2) ^ e) z‖ ≤
          Cb m * simScale B.h (z.1 2) (1 - z.2) ^ (-Kb m) := by
    intro m k hk z hz
    obtain ⟨q0, q1⟩ := hq z hz
    have hK : -Kb m ≤ -Kc k := by linarith [le_abs_self (Kc k), hKle m k hk]
    have hpn : 0 ≤ simScale B.h (z.1 2) (1 - z.2) ^ (-Kb m) := Real.rpow_nonneg q0.le _
    have hCc : ∀ x : ℝ, x ≤ Cc k * simScale B.h (z.1 2) (1 - z.2) ^ (-Kc k) →
        x ≤ Cb m * simScale B.h (z.1 2) (1 - z.2) ^ (-Kb m) := by
      intro x hx
      refine le_trans hx ?_
      calc Cc k * simScale B.h (z.1 2) (1 - z.2) ^ (-Kc k)
          ≤ |Cc k| * simScale B.h (z.1 2) (1 - z.2) ^ (-Kb m) := key2 _ _ _ _ q0 q1 hK
        _ ≤ Cb m * simScale B.h (z.1 2) (1 - z.2) ^ (-Kb m) :=
          mul_le_mul_of_nonneg_right (hCle m k hk) hpn
    obtain ⟨b1, b2, b3⟩ := hcK k z hz
    exact ⟨hCc _ b1, hCc _ b2, hCc _ b3⟩
  obtain ⟨L, hL⟩ : ∃ L : ℕ → ℝ, L = fun m : ℕ => 2 * (m : ℝ) + 1 + ((m : ℝ) + 2) * Kb m := ⟨_, rfl⟩
  have hLm : ∀ m, L m = 2 * (m : ℝ) + 1 + ((m : ℝ) + 2) * Kb m := fun m => by rw [hL]
  refine ⟨L, fun m => by
    rw [hLm m]; exact add_nonneg (by positivity) (mul_nonneg (by positivity) (hKb0 m)), ?_⟩
  intro α f hf
  obtain ⟨hloc, hdich⟩ := ipb5_mean_window_reduction B l0 e f hok hf.2.2.1
  have hfX : ContDiffOn ℝ ∞ (f ∘ fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) W :=
    hf.1.comp sXi hmap
  have sMS : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => (ContinuousLinearMap.mul ℝ ℝ)
      (simScale B.h (z.1 2) (1 - z.2) ^ e)
      ((f ∘ fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) z)) W :=
    ((ContinuousLinearMap.mul ℝ ℝ).contDiff.comp_contDiffOn sP).clm_apply hfX
  have sMV : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ =>
      (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
      ((ContinuousLinearMap.mul ℝ ℝ) (simScale B.h (z.1 2) (1 - z.2) ^ e)
        ((f ∘ fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) z)) (eTh z.1)) W :=
    ((ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³).contDiff.comp_contDiffOn sMS).clm_apply sE

  have htrans : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (Fn Gn : ℝ³ × ℝ → V),
      ContDiffOn ℝ ∞ Gn W → (∀ z ∈ W, Fn z = Gn z) →
      (∀ z ∈ simDomain B.h (qsOf l0), z ∈ W ∨ Fn =ᶠ[nhds z] (fun _ => (0 : V))) →
      ContDiffOn ℝ ∞ Fn (simDomain B.h (qsOf l0)) ∧
      ∀ (k : ℕ) (z : ℝ³ × ℝ), z ∈ simDomain B.h (qsOf l0) →
        (z ∈ W ∧ iteratedFDeriv ℝ k Fn z = iteratedFDeriv ℝ k Gn z) ∨
          iteratedFDeriv ℝ k Fn z = 0 := by
    intro V _ _ Fn Gn hG hEq hd
    refine ⟨?_, ?_⟩
    · apply contDiffOn_of_locally_contDiffOn
      intro z hz
      rcases hd z hz with h | h
      · exact ⟨W, hWo, h, (hG.congr hEq).mono inter_subset_right⟩
      · obtain ⟨u, hus, huo, hzu⟩ := mem_nhds_iff.mp h
        exact ⟨u, huo, hzu, (contDiffOn_const (c := (0 : V))).congr (fun y hy => hus hy.2)⟩
    · intro k z hz
      rcases hd z hz with h | h
      · exact Or.inl ⟨h,
          ((Filter.eventuallyEq_of_mem (hWo.mem_nhds h) hEq).iteratedFDeriv ℝ k).eq_of_nhds⟩
      · right
        rw [(h.iteratedFDeriv ℝ k).eq_of_nhds]
        simp [iteratedFDeriv_fun_zero]
  have eMV : ∀ z ∈ W, ipb5MV B l0 e f z =
      (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
      ((ContinuousLinearMap.mul ℝ ℝ) (simScale B.h (z.1 2) (1 - z.2) ^ e)
        ((f ∘ fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) z)) (eTh z.1) := by
    intro z hz
    rw [(hloc z hz).1]
    simp only [ContinuousLinearMap.lsmul_apply, ContinuousLinearMap.mul_apply', Function.comp_apply]
  have eMS : ∀ z ∈ W, ipb5MS B l0 e f z = (ContinuousLinearMap.mul ℝ ℝ)
      (simScale B.h (z.1 2) (1 - z.2) ^ e)
      ((f ∘ fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) z) := by
    intro z hz
    rw [(hloc z hz).2]
    simp only [ContinuousLinearMap.mul_apply', Function.comp_apply]
  obtain ⟨tMV1, tMV2⟩ := htrans (ipb5MV B l0 e f) _ sMV eMV
    (fun z hz => (hdich z hz).imp id (fun h => h.1))
  obtain ⟨tMS1, tMS2⟩ := htrans (ipb5MS B l0 e f) _ sMS eMS
    (fun z hz => (hdich z hz).imp id (fun h => h.2))
  refine ⟨tMV1, tMS1, fun m => ?_⟩

  obtain ⟨Cf, hCf⟩ := ipb5_inm_raw_bound B l0 hok hl0 α f hf m
  have hM1 : (1:ℝ) ≤ max 1 (Cb m) := le_max_left _ _
  have hM0 : (0:ℝ) ≤ max 1 (Cb m) := le_trans zero_le_one hM1
  obtain ⟨Cg, hCg⟩ : ∃ Cg : ℝ, Cg = (m.factorial : ℝ) * |Cf| * (max 1 (Cb m)) ^ m := ⟨_, rfl⟩
  have hCg0 : 0 ≤ Cg := by
    rw [hCg]; exact mul_nonneg (mul_nonneg (by positivity) (abs_nonneg _)) (pow_nonneg hM0 _)
  obtain ⟨C2, hC2⟩ : ∃ C2 : ℝ,
      C2 = ‖(ContinuousLinearMap.mul ℝ ℝ : ℝ →L[ℝ] ℝ →L[ℝ] ℝ)‖ * 2 ^ m * Cb m * Cg := ⟨_, rfl⟩
  have hC20 : 0 ≤ C2 := by
    rw [hC2]
    exact mul_nonneg (mul_nonneg (mul_nonneg (ContinuousLinearMap.opNorm_nonneg _) (by positivity))
      (hCb0 m)) hCg0
  obtain ⟨C1, hC1⟩ : ∃ C1 : ℝ,
      C1 = ‖(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)‖ * 2 ^ m * C2 * Cb m := ⟨_, rfl⟩
  have hC10 : 0 ≤ C1 := by
    rw [hC1]
    exact mul_nonneg (mul_nonneg (mul_nonneg (ContinuousLinearMap.opNorm_nonneg _) (by positivity))
      hC20) (hCb0 m)

  have hfXb : ∀ z ∈ W, ∀ i, i ≤ m →
      ‖iteratedFDeriv ℝ i (f ∘ fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) z‖ ≤
        Cg * simScale B.h (z.1 2) (1 - z.2) ^ (B.h * α - 2 * (m:ℝ) - 1 - (m:ℝ) * Kb m) := by
    intro z hz i hi
    obtain ⟨q0, q1⟩ := hq z hz
    refine le_trans (ipb5_wexp_comp f _ W (DomC B.h (qsOf l0)) hWo hDo hmap hf.1 sXi i z
      (simScale B.h (z.1 2) (1 - z.2)) (B.h * α - 2 * (m:ℝ) - 1) |Cf| (Cb m) (Kb m) hz q0 q1
      (hKb0 m)
      (fun j hj => le_trans (hCf _ (hmap hz) j (le_trans hj hi))
        (mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg q0.le _)))
      (fun j _ hj => (hco m j (le_trans hj hi) z hz).1)) ?_
    have f1 : (i.factorial : ℝ) ≤ m.factorial := by exact_mod_cast Nat.factorial_le hi
    have f2 : (max 1 (Cb m)) ^ i ≤ (max 1 (Cb m)) ^ m := pow_le_pow_right₀ hM1 hi
    have hi' : (i:ℝ) * Kb m ≤ (m:ℝ) * Kb m :=
      mul_le_mul_of_nonneg_right (by exact_mod_cast hi) (hKb0 m)
    have f3 : simScale B.h (z.1 2) (1 - z.2) ^ (B.h * α - 2 * (m:ℝ) - 1 - (i:ℝ) * Kb m) ≤
        simScale B.h (z.1 2) (1 - z.2) ^ (B.h * α - 2 * (m:ℝ) - 1 - (m:ℝ) * Kb m) :=
      Real.rpow_le_rpow_of_exponent_ge q0 q1 (by linarith)
    have A1 : (i.factorial : ℝ) * |Cf| ≤ m.factorial * |Cf| :=
      mul_le_mul_of_nonneg_right f1 (abs_nonneg _)
    have A2 : (i.factorial : ℝ) * |Cf| * (max 1 (Cb m)) ^ i ≤
        m.factorial * |Cf| * (max 1 (Cb m)) ^ m :=
      mul_le_mul A1 f2 (pow_nonneg hM0 _) (mul_nonneg (by positivity) (abs_nonneg _))
    rw [hCg]
    exact mul_le_mul A2 f3 (Real.rpow_nonneg q0.le _)
      (mul_nonneg (mul_nonneg (by positivity) (abs_nonneg _)) (pow_nonneg hM0 _))

  have hMSb : ∀ z ∈ W, ∀ i, i ≤ m →
      ‖iteratedFDeriv ℝ i (fun z : ℝ³ × ℝ => (ContinuousLinearMap.mul ℝ ℝ)
        (simScale B.h (z.1 2) (1 - z.2) ^ e)
        ((f ∘ fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) z)) z‖ ≤
        C2 * simScale B.h (z.1 2) (1 - z.2) ^
          (-Kb m + (B.h * α - 2 * (m:ℝ) - 1 - (m:ℝ) * Kb m)) := by
    intro z hz i hi
    obtain ⟨q0, q1⟩ := hq z hz
    refine le_trans (ipb5_wexp_bilin (ContinuousLinearMap.mul ℝ ℝ)
      (fun z : ℝ³ × ℝ => simScale B.h (z.1 2) (1 - z.2) ^ e)
      (f ∘ fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) W hWo sP hfX i z
      (simScale B.h (z.1 2) (1 - z.2)) (-Kb m) (B.h * α - 2 * (m:ℝ) - 1 - (m:ℝ) * Kb m) (Cb m) Cg
      hz q0 (fun j hj => (hco m j (le_trans hj hi) z hz).2.2)
      (fun j hj => hfXb z hz j (le_trans hj hi))) ?_
    apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg q0.le _)
    have h2 : (2:ℝ) ^ i ≤ 2 ^ m := pow_le_pow_right₀ (by norm_num) hi
    have h3 := mul_le_mul_of_nonneg_left h2
      (ContinuousLinearMap.opNorm_nonneg (ContinuousLinearMap.mul ℝ ℝ : ℝ →L[ℝ] ℝ →L[ℝ] ℝ))
    rw [hC2]
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right h3 (hCb0 m)) hCg0

  have hMVb : ∀ z ∈ W,
      ‖iteratedFDeriv ℝ m (fun z : ℝ³ × ℝ =>
        (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
        ((ContinuousLinearMap.mul ℝ ℝ) (simScale B.h (z.1 2) (1 - z.2) ^ e)
          ((f ∘ fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) z)) (eTh z.1)) z‖ ≤
        C1 * simScale B.h (z.1 2) (1 - z.2) ^
          ((-Kb m + (B.h * α - 2 * (m:ℝ) - 1 - (m:ℝ) * Kb m)) + -Kb m) := by
    intro z hz
    obtain ⟨q0, q1⟩ := hq z hz
    have r := ipb5_wexp_bilin (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
      (fun z : ℝ³ × ℝ => (ContinuousLinearMap.mul ℝ ℝ) (simScale B.h (z.1 2) (1 - z.2) ^ e)
        ((f ∘ fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) z))
      (fun z : ℝ³ × ℝ => eTh z.1) W hWo sMS sE m z (simScale B.h (z.1 2) (1 - z.2))
      (-Kb m + (B.h * α - 2 * (m:ℝ) - 1 - (m:ℝ) * Kb m)) (-Kb m) C2 (Cb m) hz q0
      (fun j hj => hMSb z hz j hj) (fun j hj => (hco m j hj z hz).2.1)
    rw [hC1]
    exact r

  refine ⟨C1 + C2, fun x t hxt => ?_⟩
  have h1 : t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
  have q0 : 0 < simScale B.h (x 2) (1 - t) := (hok.1.1 (x 2) (1 - t) (by linarith [h1.1])).1
  have q1 : simScale B.h (x 2) (1 - t) ≤ 1 := le_trans h1.2.le hqs1
  have hP : 0 ≤ simScale B.h (x 2) (1 - t) ^ (B.h * α - L m) := Real.rpow_nonneg q0.le _
  have hC0 : 0 ≤ C1 + C2 := add_nonneg hC10 hC20
  have hKm := hKb0 m
  have hLm' := hLm m
  refine ⟨?_, ?_⟩
  · rcases tMV2 m (x, t) hxt with ⟨hz, heq⟩ | h0
    · rw [heq]
      refine le_trans (hMVb (x, t) hz) ?_
      have hle : simScale B.h (x 2) (1 - t) ^
            ((-Kb m + (B.h * α - 2 * (m:ℝ) - 1 - (m:ℝ) * Kb m)) + -Kb m) ≤
          simScale B.h (x 2) (1 - t) ^ (B.h * α - L m) :=
        Real.rpow_le_rpow_of_exponent_ge q0 q1 (by rw [hLm']; linarith)
      calc C1 * simScale B.h (x 2) (1 - t) ^
            ((-Kb m + (B.h * α - 2 * (m:ℝ) - 1 - (m:ℝ) * Kb m)) + -Kb m)
          ≤ C1 * simScale B.h (x 2) (1 - t) ^ (B.h * α - L m) :=
            mul_le_mul_of_nonneg_left hle hC10
        _ ≤ (C1 + C2) * simScale B.h (x 2) (1 - t) ^ (B.h * α - L m) :=
            mul_le_mul_of_nonneg_right (le_add_of_nonneg_right hC20) hP
    · rw [h0, norm_zero]; exact mul_nonneg hC0 hP
  · rcases tMS2 m (x, t) hxt with ⟨hz, heq⟩ | h0
    · rw [heq]
      refine le_trans (hMSb (x, t) hz m le_rfl) ?_
      have hle : simScale B.h (x 2) (1 - t) ^
            (-Kb m + (B.h * α - 2 * (m:ℝ) - 1 - (m:ℝ) * Kb m)) ≤
          simScale B.h (x 2) (1 - t) ^ (B.h * α - L m) :=
        Real.rpow_le_rpow_of_exponent_ge q0 q1 (by rw [hLm']; linarith)
      calc C2 * simScale B.h (x 2) (1 - t) ^
            (-Kb m + (B.h * α - 2 * (m:ℝ) - 1 - (m:ℝ) * Kb m))
          ≤ C2 * simScale B.h (x 2) (1 - t) ^ (B.h * α - L m) :=
            mul_le_mul_of_nonneg_left hle hC20
        _ ≤ (C1 + C2) * simScale B.h (x 2) (1 - t) ^ (B.h * α - L m) :=
            mul_le_mul_of_nonneg_right (le_add_of_nonneg_left hC10) hP
    · rw [h0, norm_zero]; exact mul_nonneg hC0 hP

theorem spb5_offshell_residual_flat : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState), B.ok → qsOf l0 ≤ B.qB → (∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) → (x 0 ^ 2 + x 1 ^ 2 < 2 * B.Xa * simScale B.h (x 2) (1 - t) ∨ 2 * B.Xb * simScale B.h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2) → fA5 B G l0 S x t = B.AB x t ∧ fB B G l0 S x t = B.BvB x t ∧ fP5 B G l0 S x t = B.PB x t) → ∀ m N : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) → (x 0 ^ 2 + x 1 ^ 2 < 2 * B.Xa * simScale B.h (x 2) (1 - t) ∨ 2 * B.Xb * simScale B.h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2) → ‖iteratedFDeriv ℝ m (↿(fRes5 B G l0 S)) (x, t)‖ ≤ C * simScale B.h (x 2) (1 - t) ^ (N : ℝ) :=
by
  intro B G l0 S hok hqB hP5 m N
  have hSim : SimScaleProps B.h := hok.1
  have hBP := hok.2
  unfold BackgroundProps at hBP
  obtain ⟨-, -, -, -, -, -, -, -, hB8, hB9, -, -⟩ := hBP
  have hT0 := hB8.2.2.1
  obtain ⟨C, hC⟩ := hB9 m N
  refine ⟨C, fun x t hxt hoff => ?_⟩

  have hqcont : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    have hmap : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
      (((EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst).prodMk
        (continuous_const.sub continuous_snd))
    refine hSim.2.2.2.1.continuousOn.comp hmap.continuousOn ?_
    intro w hw
    exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
  have hΩ : IsOpen (simDomain B.h (qsOf l0)) := by
    have e : simDomain B.h (qsOf l0) = {w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0) := rfl
    rw [e]
    exact hqcont.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  have hc01 : Continuous (fun w : ℝ³ × ℝ => w.1 0 ^ 2 + w.1 1 ^ 2) :=
    (((EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst).pow 2).add
      (((EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst).pow 2)
  have hr1 : ContinuousOn (fun w : ℝ³ × ℝ =>
      w.1 0 ^ 2 + w.1 1 ^ 2 - 2 * B.Xa * simScale B.h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} :=
    hc01.continuousOn.sub (continuousOn_const.mul hqcont)
  have hr2 : ContinuousOn (fun w : ℝ³ × ℝ =>
      w.1 0 ^ 2 + w.1 1 ^ 2 - 2 * B.Xb * simScale B.h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} :=
    hc01.continuousOn.sub (continuousOn_const.mul hqcont)
  have hU1 := hr1.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const)
    (isOpen_Iio : IsOpen (Iio (0:ℝ)))
  have hU2 := hr2.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const)
    (isOpen_Ioi : IsOpen (Ioi (0:ℝ)))
  obtain ⟨O, hOdef⟩ : ∃ O : Set (ℝ³ × ℝ), O = simDomain B.h (qsOf l0) ∩
      (({w : ℝ³ × ℝ | w.2 < 1} ∩ (fun w : ℝ³ × ℝ =>
        w.1 0 ^ 2 + w.1 1 ^ 2 - 2 * B.Xa * simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio 0) ∪
       ({w : ℝ³ × ℝ | w.2 < 1} ∩ (fun w : ℝ³ × ℝ =>
        w.1 0 ^ 2 + w.1 1 ^ 2 - 2 * B.Xb * simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Ioi 0)) :=
    ⟨_, rfl⟩
  have hO : IsOpen O := by rw [hOdef]; exact hΩ.inter (hU1.union hU2)
  have hOa : ∀ w ∈ O, w ∈ simDomain B.h (qsOf l0) ∧
      (w.1 0 ^ 2 + w.1 1 ^ 2 < 2 * B.Xa * simScale B.h (w.1 2) (1 - w.2) ∨
        2 * B.Xb * simScale B.h (w.1 2) (1 - w.2) < w.1 0 ^ 2 + w.1 1 ^ 2) := by
    intro w hw
    rw [hOdef] at hw
    obtain ⟨hwΩ, hw'⟩ := hw
    refine ⟨hwΩ, ?_⟩
    rcases hw' with h | h
    · left
      have : w.1 0 ^ 2 + w.1 1 ^ 2 - 2 * B.Xa * simScale B.h (w.1 2) (1 - w.2) < 0 := h.2
      linarith
    · right
      have : 0 < w.1 0 ^ 2 + w.1 1 ^ 2 - 2 * B.Xb * simScale B.h (w.1 2) (1 - w.2) := h.2
      linarith
  have hxt' : t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
  have hz0 : ((x, t) : ℝ³ × ℝ) ∈ O := by
    rw [hOdef]
    refine ⟨hxt, ?_⟩
    rcases hoff with h | h
    · left
      refine ⟨hxt'.1, ?_⟩
      show x 0 ^ 2 + x 1 ^ 2 - 2 * B.Xa * simScale B.h (x 2) (1 - t) < 0
      linarith
    · right
      refine ⟨hxt'.1, ?_⟩
      show 0 < x 0 ^ 2 + x 1 ^ 2 - 2 * B.Xb * simScale B.h (x 2) (1 - t)
      linarith

  have hU : ∀ z ∈ O, (↿(fU5 B G l0 S)) z =
      (↿(fun y' s' => curl3 (fun w => B.AB w s') y' + B.BvB y' s')) z := by
    rintro ⟨y, s⟩ hz
    have hV : {w : ℝ³ | ((w, s) : ℝ³ × ℝ) ∈ O} ∈ nhds y :=
      (hO.preimage (continuous_id.prodMk continuous_const)).mem_nhds hz
    have hev : (fun w => fA5 B G l0 S w s) =ᶠ[nhds y] fun w => B.AB w s :=
      Filter.eventuallyEq_of_mem hV (fun w hw => by
        obtain ⟨h1, h2⟩ := hOa _ hw
        exact (hP5 w s h1 h2).1)
    obtain ⟨h1, h2⟩ := hOa _ hz
    show curl3 (fun w => fA5 B G l0 S w s) y + fB B G l0 S y s =
      curl3 (fun w => B.AB w s) y + B.BvB y s
    rw [(hP5 y s h1 h2).2.1]
    simp only [curl3, hev.fderiv_eq]
  have hPeq : ∀ z ∈ O, (↿(fP5 B G l0 S)) z = (↿B.PB) z := by
    rintro ⟨y, s⟩ hz
    obtain ⟨h1, h2⟩ := hOa _ hz
    exact (hP5 y s h1 h2).2.2

  have hloc : ∀ (u₁ u₂ : ℝ³ → ℝ → ℝ³) (p₁ p₂ : ℝ³ → ℝ → ℝ),
      (∀ z ∈ O, (↿u₁) z = (↿u₂) z) → (∀ z ∈ O, (↿p₁) z = (↿p₂) z) →
      ∀ z ∈ O, (↿(nsResidual 1 u₁ p₁)) z = (↿(nsResidual 1 u₂ p₂)) z := by
    rintro u₁ u₂ p₁ p₂ hu hp ⟨y, s⟩ hz
    have hNt : {r : ℝ | ((y, r) : ℝ³ × ℝ) ∈ O} ∈ nhds s :=
      (hO.preimage (continuous_const.prodMk continuous_id)).mem_nhds hz
    have hNx : {w : ℝ³ | ((w, s) : ℝ³ × ℝ) ∈ O} ∈ nhds y :=
      (hO.preimage (continuous_id.prodMk continuous_const)).mem_nhds hz
    have E1 : (fun r => u₁ y r) =ᶠ[nhds s] (fun r => u₂ y r) :=
      Filter.eventuallyEq_of_mem hNt (fun r hr => hu (y, r) hr)
    have E2 : (fun w => u₁ w s) =ᶠ[nhds y] (fun w => u₂ w s) :=
      Filter.eventuallyEq_of_mem hNx (fun w hw => hu (w, s) hw)
    have E3 : (fun w => p₁ w s) =ᶠ[nhds y] (fun w => p₂ w s) :=
      Filter.eventuallyEq_of_mem hNx (fun w hw => hp (w, s) hw)
    have E0 : u₁ y s = u₂ y s := hu (y, s) hz
    have h4 : deriv (fun r => u₁ y r) s = deriv (fun r => u₂ y r) s := E1.deriv_eq
    have h5 : fderiv ℝ (fun w => u₁ w s) y = fderiv ℝ (fun w => u₂ w s) y := E2.fderiv_eq
    have h6 : Δ (fun w => u₁ w s) y = Δ (fun w => u₂ w s) y :=
      (InnerProductSpace.laplacian_congr_nhds E2).eq_of_nhds
    have h7 : gradient (fun w => p₁ w s) y = gradient (fun w => p₂ w s) y := E3.gradient_eq
    show nsResidual 1 u₁ p₁ y s = nsResidual 1 u₂ p₂ y s
    unfold nsResidual
    rw [h4, h5, h6, h7, E0]

  have hstress : ∀ z ∈ O, stressDivField B.h B.Tth B.Tz z.1 z.2 = 0 := by
    rintro ⟨y, s⟩ hz
    obtain ⟨h1, h2⟩ := hOa _ hz
    have h1' : s < 1 ∧ simScale B.h (y 2) (1 - s) < qsOf l0 := h1
    have hq0 : 0 < simScale B.h (y 2) (1 - s) := (hSim.1 (y 2) (1 - s) (by linarith [h1'.1])).1
    have hX : simX B.h y s < B.Xa ∨ B.Xb < simX B.h y s := by
      unfold simX
      rcases h2 with h | h
      · left
        rw [div_lt_iff₀ (by linarith)]
        linarith
      · right
        rw [lt_div_iff₀ (by linarith)]
        linarith
    have hnb : ∀ᶠ Y in nhds (simX B.h y s), Y ≤ B.Xa ∨ B.Xb ≤ Y := by
      rcases hX with h | h
      · filter_upwards [isOpen_Iio.mem_nhds h] with Y hY using Or.inl (le_of_lt hY)
      · filter_upwards [isOpen_Ioi.mem_nhds h] with Y hY using Or.inr (le_of_lt hY)
    have hX' : simX B.h y s ≤ B.Xa ∨ B.Xb ≤ simX B.h y s := hX.imp le_of_lt le_of_lt
    have hd1 : deriv (fun Y => B.Tth (simScale B.h (y 2) (1 - s)) Y (simEta B.h y s))
        (simX B.h y s) = 0 := by
      have hev : (fun Y => B.Tth (simScale B.h (y 2) (1 - s)) Y (simEta B.h y s))
          =ᶠ[nhds (simX B.h y s)] fun _ => (0:ℝ) :=
        hnb.mono (fun Y hY => (hT0 _ Y _ hY).1)
      rw [hev.deriv_eq]
      exact deriv_const _ _
    have hd2 : deriv (fun Y => B.Tz (simScale B.h (y 2) (1 - s)) Y (simEta B.h y s))
        (simX B.h y s) = 0 := by
      have hev : (fun Y => B.Tz (simScale B.h (y 2) (1 - s)) Y (simEta B.h y s))
          =ᶠ[nhds (simX B.h y s)] fun _ => (0:ℝ) :=
        hnb.mono (fun Y hY => (hT0 _ Y _ hY).2)
      rw [hev.deriv_eq]
      exact deriv_const _ _
    have hv1 := (hT0 (simScale B.h (y 2) (1 - s)) (simX B.h y s) (simEta B.h y s) hX').1
    have hv2 := (hT0 (simScale B.h (y 2) (1 - s)) (simX B.h y s) (simEta B.h y s) hX').2
    show stressDivField B.h B.Tth B.Tz y s = 0
    unfold stressDivField
    rw [hd1, hd2, hv1, hv2]
    simp

  have heq : ∀ z ∈ O, (↿(fRes5 B G l0 S)) z = (↿(fun (y : ℝ³) (s : ℝ) =>
        nsResidual 1 (fun y' s' => curl3 (fun w => B.AB w s') y' + B.BvB y' s') B.PB y s -
          stressDivField B.h B.Tth B.Tz y s)) z := by
    intro z hz
    have h1 := hloc _ _ _ _ hU hPeq z hz
    have h2 := hstress z hz
    have e : (↿(fun (y : ℝ³) (s : ℝ) =>
        nsResidual 1 (fun y' s' => curl3 (fun w => B.AB w s') y' + B.BvB y' s') B.PB y s -
          stressDivField B.h B.Tth B.Tz y s)) z =
        (↿(nsResidual 1 (fun y' s' => curl3 (fun w => B.AB w s') y' + B.BvB y' s') B.PB)) z -
          stressDivField B.h B.Tth B.Tz z.1 z.2 := rfl
    rw [e, h2, sub_zero]
    exact h1
  have hev : (↿(fRes5 B G l0 S)) =ᶠ[nhds (x, t)] (↿(fun (y : ℝ³) (s : ℝ) =>
        nsResidual 1 (fun y' s' => curl3 (fun w => B.AB w s') y' + B.BvB y' s') B.PB y s -
          stressDivField B.h B.Tth B.Tz y s)) :=
    Filter.eventuallyEq_of_mem (hO.mem_nhds hz0) heq
  rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
  exact hC x t ⟨hxt'.1, lt_of_lt_of_le hxt'.2 hqB⟩

theorem spb5_radrem_comp_smooth : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (bw ca cm cd : ℝ), B.ok → GeomPrim5 B G → qsOf l0 ≤ B.qB → StOrd5 B G l0 S bw ca cm cd → ContDiffOn ℝ ∞ (↿(fun y s => radRem5 B G l0 S (ptOf y s (Yph B.h (rad y) s + 0)))) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} :=
by
  intro B G l0 S bw ca cm cd hok hG hqB hSt
  have hpm : ContDiffOn ℝ ∞ (pmP5 B G l0 S) (DomC B.h (qsOf l0)) :=
    (state_cyl_smooth_v5 B G l0 S bw ca cm cd hok hG hqB hSt).2.2.2.2
  have hgr : ContDiffOn ℝ ∞ (grP5 B G l0 S) (DomC B.h (qsOf l0)) :=
    (grP5_state_regular_v5 B G l0 S bw ca cm cd hok hG hqB hSt).1
  have hdc := domc_open_calculus B (qsOf l0) hok
  have hq : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h (qsOf l0)) := hdc.2.1
  have hqpos : ∀ η ∈ DomC B.h (qsOf l0), 0 < qC B.h η := hdc.2.2.1
  have hdR : ContDiffOn ℝ ∞ (dR B.h (pmP5 B G l0 S)) (DomC B.h (qsOf l0)) :=
    (hdc.2.2.2.2.1 _ hpm).1
  have hrho : ContDiffOn ℝ ∞ (rhoP B) (DomC B.h (qsOf l0)) := (rhoP_regular_v5 B (qsOf l0) hok).1
  have hSt' := hSt
  unfold StOrd5 at hSt'
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, hcalP, -⟩ := hSt'
  have hcalS : ContDiffOn ℝ ∞ (nrmS B (2 * Aex B.h) (calP5 B G l0 S))
      {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qsOf l0} := hcalP.1
  have hP : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, η.2.2.1) : ℝ × ℝ)) :=
    (contDiff_fst.comp contDiff_snd).prodMk (contDiff_fst.comp (contDiff_snd.comp contDiff_snd))
  have hPm : Set.MapsTo (fun η : Cyl => ((η.2.1, η.2.2.1) : ℝ × ℝ)) (DomC B.h (qsOf l0))
      {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qsOf l0} :=
    fun η hη => ⟨hη.2.1, hη.2.2⟩
  have hN : ContDiffOn ℝ ∞
      (fun η : Cyl => nrmS B (2 * Aex B.h) (calP5 B G l0 S) (η.2.1, η.2.2.1))
      (DomC B.h (qsOf l0)) := hcalS.comp hP.contDiffOn hPm
  have hqe : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-(2 * Aex B.h))) (DomC B.h (qsOf l0)) :=
    hq.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
  have hH : ContDiffOn ℝ ∞ (fun η => dR B.h (pmP5 B G l0 S) η - grP5 B G l0 S η +
      rhoP B η * (qC B.h η ^ (-(2 * Aex B.h)) *
        nrmS B (2 * Aex B.h) (calP5 B G l0 S) (η.2.1, η.2.2.1)))
      (DomC B.h (qsOf l0)) := (hdR.sub hgr).add (hrho.mul (hqe.mul hN))
  have hRad : ContDiffOn ℝ ∞ (radRem5 B G l0 S) (DomC B.h (qsOf l0)) := by
    refine hH.congr (fun η hη => ?_)
    have hq0 := hqpos η hη
    have e : nrmS B (2 * Aex B.h) (calP5 B G l0 S) (η.2.1, η.2.2.1) =
        qC B.h η ^ (2 * Aex B.h) * calP5 B G l0 S η.2.1 η.2.2.1 := rfl
    have key : qC B.h η ^ (-(2 * Aex B.h)) *
        (qC B.h η ^ (2 * Aex B.h) * calP5 B G l0 S η.2.1 η.2.2.1) =
        calP5 B G l0 S η.2.1 η.2.2.1 := by
      rw [← mul_assoc, ← Real.rpow_add hq0, neg_add_cancel, Real.rpow_zero, one_mul]
    unfold radRem5
    rw [e, key]
  have hξ := (corr_domain_v5 B l0 0 hok).2.1
  have hmaps : Set.MapsTo (fun w : ℝ³ × ℝ => ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0))
      {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} (DomC B.h (qsOf l0)) :=
    fun w hw => ⟨hw.1, hw.2.1, hw.2.2⟩
  exact hRad.comp hξ hmaps

theorem spb5_eR_smul_bound : ∀ (B : BG) (l0 : ℕ), B.ok → ∀ m : ℕ, ∃ K : ℝ, 0 ≤ K ∧ ∀ (g : ℝ³ × ℝ → ℝ) (x : ℝ³) (t a Cg : ℝ), ContDiffOn ℝ ∞ g {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} → (x, t) ∈ simDomain B.h (qsOf l0) → B.Xa * simScale B.h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2 → x 0 ^ 2 + x 1 ^ 2 < 3 * B.Xb * simScale B.h (x 2) (1 - t) → (∀ i : ℕ, i ≤ m → ‖iteratedFDeriv ℝ i g (x, t)‖ ≤ Cg * simScale B.h (x 2) (1 - t) ^ a) → ‖iteratedFDeriv ℝ m (fun z : ℝ³ × ℝ => g z • eR z.1) (x, t)‖ ≤ K * Cg * simScale B.h (x 2) (1 - t) ^ (a - (m : ℝ)) :=
by
  intro B l0 hok m
  have hXa : 0 < B.Xa := hok.2.1.2.2.1

  have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun x : ℝ³ => x i) := fun i => contDiff_piLp_apply 2
  have hf2 : ContDiff ℝ ∞ (fun x : ℝ³ => x 0 ^ 2 + x 1 ^ 2) := ((hc 0).pow 2).add ((hc 1).pow 2)
  have hradc : Continuous rad := Real.continuous_sqrt.comp hf2.continuous
  have hU0 : IsOpen {x : ℝ³ | 0 < rad x} := isOpen_lt continuous_const hradc
  have hrsq : ∀ x : ℝ³, rad x ^ 2 = x 0 ^ 2 + x 1 ^ 2 := fun x => Real.sq_sqrt (by positivity)
  have hsm : ∀ (c : ℝ) (x : ℝ³) (i : Fin 3), (c • x) i = c * x i := fun c x i => by simp
  have hT0 : ∀ (c : ℝ) (x : ℝ³), (x + c • eZ) 0 = x 0 := fun c x => by simp [eZ]
  have hT1 : ∀ (c : ℝ) (x : ℝ³), (x + c • eZ) 1 = x 1 := fun c x => by simp [eZ]
  have hRh : ∀ (c : ℝ) (x : ℝ³), 0 < c → rad (c • x) = c * rad x := by
    intro c x hc0
    unfold rad
    rw [hsm, hsm, show (c * x 0) ^ 2 + (c * x 1) ^ 2 = c ^ 2 * (x 0 ^ 2 + x 1 ^ 2) by ring,
      Real.sqrt_mul (sq_nonneg c), Real.sqrt_sq hc0.le]
  have hVh : ∀ (c : ℝ) (x : ℝ³), radVec (c • x) = c • radVec x := by
    intro c x; unfold radVec; rw [hsm, hsm, smul_add, mul_smul, mul_smul]
  have hRt : ∀ (c : ℝ) (x : ℝ³), rad (x + c • eZ) = rad x := by
    intro c x; unfold rad; rw [hT0, hT1]
  have hVt : ∀ (c : ℝ) (x : ℝ³), radVec (x + c • eZ) = radVec x := by
    intro c x; unfold radVec; rw [hT0, hT1]
  have hinvh : ∀ (c r : ℝ), 0 < c → (c * r)⁻¹ * c = r⁻¹ := by
    intro c r hc0
    calc (c * r)⁻¹ * c = r⁻¹ * (c⁻¹ * c) := by rw [mul_inv]; ring
      _ = r⁻¹ := by rw [inv_mul_cancel₀ hc0.ne', mul_one]

  have homog : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : ℝ³ → V) (s : ℝ),
      ContDiffOn ℝ ∞ f {x : ℝ³ | 0 < rad x} →
      (∀ (c : ℝ) (x : ℝ³), 0 < c → f (c • x) = c ^ s • f x) →
      (∀ (c : ℝ) (x : ℝ³), f (x + c • eZ) = f x) →
      ∀ j : ℕ, ∃ Cj : ℝ, 0 ≤ Cj ∧ ∀ x : ℝ³, 0 < rad x →
        ‖iteratedFDeriv ℝ j f x‖ ≤ Cj * rad x ^ (s - j) := by
    intro V _ _ f s hf hH hT j
    have hN : ((j : ℕ) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
    have hKcU : ({y : ℝ³ | rad y = 1} ∩ {y : ℝ³ | y 2 = 0}) ⊆ {x : ℝ³ | 0 < rad x} :=
      fun y hy => by
        show 0 < rad y
        rw [hy.1]; exact one_pos
    have hKcc : IsCompact ({y : ℝ³ | rad y = 1} ∩ {y : ℝ³ | y 2 = 0}) := by
      apply Metric.isCompact_of_isClosed_isBounded
      · exact (isClosed_eq hradc continuous_const).inter
          (isClosed_eq (hc 2).continuous continuous_const)
      · apply (Metric.isBounded_closedBall (x := (0:ℝ³)) (r := 1)).subset
        intro y hy
        rw [mem_closedBall_zero_iff]
        have h1 : rad y = 1 := hy.1
        have h2 : y 2 = 0 := hy.2
        have hsq : y 0 ^ 2 + y 1 ^ 2 = 1 := by rw [← hrsq, h1]; norm_num
        rw [EuclideanSpace.norm_eq, Fin.sum_univ_three]
        simp only [Real.norm_eq_abs, sq_abs, h2]
        rw [show y 0 ^ 2 + y 1 ^ 2 + (0:ℝ) ^ 2 = 1 by rw [hsq]; ring, Real.sqrt_one]
    have hcont : ContinuousOn (iteratedFDeriv ℝ j f) ({y : ℝ³ | rad y = 1} ∩ {y : ℝ³ | y 2 = 0}) := by
      have h1 := hf.continuousOn_iteratedFDerivWithin hN hU0.uniqueDiffOn
      exact (h1.congr (fun x hx => (iteratedFDerivWithin_of_isOpen j hU0 hx).symm)).mono hKcU
    obtain ⟨C0, hC0⟩ := hKcc.exists_bound_of_continuousOn hcont
    refine ⟨max C0 0, le_max_right _ _, fun x hx => ?_⟩
    set r := rad x with hr
    have hr0 : 0 < r := hx
    set v : ℝ³ := (-(r⁻¹ * x 2)) • eZ with hv
    set y : ℝ³ := r⁻¹ • x + v with hy
    have hy0 : y 0 = x 0 / r := by simp [hy, hv, eZ, div_eq_inv_mul]
    have hy1 : y 1 = x 1 / r := by simp [hy, hv, eZ, div_eq_inv_mul]
    have hy2 : y 2 = 0 := by simp [hy, hv, eZ]
    have hradY : rad y = 1 := by
      unfold rad
      rw [hy0, hy1, div_pow, div_pow, ← add_div, ← hrsq x, div_self (pow_pos hr0 2).ne',
        Real.sqrt_one]
    have hyU : 0 < rad y := by rw [hradY]; exact one_pos
    have hid : ∀ z : ℝ³, f z = r ^ s • f (r⁻¹ • z + v) := by
      intro z
      rw [hv, hT, hH r⁻¹ z (inv_pos.2 hr0), smul_smul, Real.inv_rpow hr0.le,
        mul_inv_cancel₀ (Real.rpow_pos_of_pos hr0 s).ne', one_smul]
    set S : ℝ³ ≃L[ℝ] ℝ³ :=
      (LinearEquiv.smulOfNeZero ℝ ℝ³ r⁻¹ (inv_ne_zero hr0.ne')).toContinuousLinearEquiv with hS
    have hSapp : ∀ z, S z = r⁻¹ • z := fun z => rfl
    have hfun : f = (fun u => r ^ s • f (u + v)) ∘ ⇑S := by
      funext z
      rw [Function.comp_apply, hSapp]
      exact hid z
    have e1 := ContinuousLinearEquiv.iteratedFDerivWithin_comp_right S (fun u => r ^ s • f (u + v))
      uniqueDiffOn_univ (mem_univ (S x)) j
    rw [preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at e1
    have e2 : iteratedFDeriv ℝ j (fun u => r ^ s • f (u + v)) (S x) =
        iteratedFDeriv ℝ j (fun q => r ^ s • f q) y := by
      rw [hSapp]
      exact iteratedFDeriv_comp_add_right (f := fun q => r ^ s • f q) j v (r⁻¹ • x)
    have hfy : ContDiffAt ℝ ∞ f y := hf.contDiffAt (hU0.mem_nhds hyU)
    have e3 : iteratedFDeriv ℝ j (fun q => r ^ s • f q) y = r ^ s • iteratedFDeriv ℝ j f y :=
      iteratedFDeriv_const_smul_apply' (hfy.of_le hN)
    have key : iteratedFDeriv ℝ j f x =
        (r ^ s • iteratedFDeriv ℝ j f y).compContinuousLinearMap (fun _ => (S : ℝ³ →L[ℝ] ℝ³)) := by
      calc iteratedFDeriv ℝ j f x
          = iteratedFDeriv ℝ j ((fun u => r ^ s • f (u + v)) ∘ ⇑S) x :=
            congrArg (fun g => iteratedFDeriv ℝ j g x) hfun
        _ = _ := e1
        _ = _ := by rw [e2, e3]
    have hSn : ‖(S : ℝ³ →L[ℝ] ℝ³)‖ ≤ r⁻¹ :=
      ContinuousLinearMap.opNorm_le_bound _ (inv_nonneg.2 hr0.le) (fun z => le_of_eq (by
        show ‖r⁻¹ • z‖ = r⁻¹ * ‖z‖
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.2 hr0)]))
    have hrs : 0 < r ^ s := Real.rpow_pos_of_pos hr0 s
    rw [key]
    calc ‖(r ^ s • iteratedFDeriv ℝ j f y).compContinuousLinearMap (fun _ => (S : ℝ³ →L[ℝ] ℝ³))‖
        ≤ ‖r ^ s • iteratedFDeriv ℝ j f y‖ * ∏ _i : Fin j, ‖(S : ℝ³ →L[ℝ] ℝ³)‖ :=
          ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
      _ ≤ (r ^ s * max C0 0) * r⁻¹ ^ j := by
          apply mul_le_mul _ _ (Finset.prod_nonneg fun _ _ => norm_nonneg _)
            (mul_nonneg hrs.le (le_max_right _ _))
          · rw [norm_smul, Real.norm_eq_abs, abs_of_pos hrs]
            exact mul_le_mul_of_nonneg_left ((hC0 y ⟨hradY, hy2⟩).trans (le_max_left _ _)) hrs.le
          · rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
            exact pow_le_pow_left₀ (norm_nonneg _) hSn j
      _ = max C0 0 * r ^ (s - j) := by
          rw [Real.rpow_sub hr0, Real.rpow_natCast, inv_pow, div_eq_mul_inv]; ring

  have hlift : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (φ : ℝ³ → W),
      ContDiffOn ℝ ∞ φ {x : ℝ³ | 0 < rad x} → ∀ (j : ℕ) (p : ℝ³ × ℝ), 0 < rad p.1 →
      ‖iteratedFDeriv ℝ j (fun w : ℝ³ × ℝ => φ w.1) p‖ ≤ ‖iteratedFDeriv ℝ j φ p.1‖ := by
    intro W _ _ φ hφ j p hp
    have hU' : IsOpen ((ContinuousLinearMap.fst ℝ ℝ³ ℝ) ⁻¹' {x : ℝ³ | 0 < rad x}) :=
      hU0.preimage (ContinuousLinearMap.fst ℝ ℝ³ ℝ).continuous
    have hp' : (ContinuousLinearMap.fst ℝ ℝ³ ℝ) p ∈ {x : ℝ³ | 0 < rad x} := hp
    have e := ContinuousLinearMap.iteratedFDerivWithin_comp_right (ContinuousLinearMap.fst ℝ ℝ³ ℝ)
      hφ hU0.uniqueDiffOn hU'.uniqueDiffOn hp' (i := j) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen j hU' hp, iteratedFDerivWithin_of_isOpen j hU0 hp'] at e
    have e2 : (fun w : ℝ³ × ℝ => φ w.1) = φ ∘ (ContinuousLinearMap.fst ℝ ℝ³ ℝ) := rfl
    rw [e2, e]
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    have hp1 : ∏ _i : Fin j, ‖ContinuousLinearMap.fst ℝ ℝ³ ℝ‖ ≤ 1 := by
      rw [Finset.prod_const]
      exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_fst_le ℝ ℝ³ ℝ)
    exact mul_le_of_le_one_right (norm_nonneg _) hp1

  have hSr : ContDiffOn ℝ ∞ rad {x : ℝ³ | 0 < rad x} :=
    hf2.contDiffOn.sqrt (fun x hx => by
      have hx' : 0 < Real.sqrt (x 0 ^ 2 + x 1 ^ 2) := hx
      exact (Real.sqrt_pos.mp hx').ne')
  have hinv : ContDiffOn ℝ ∞ (fun x => (rad x)⁻¹) {x : ℝ³ | 0 < rad x} :=
    hSr.inv (fun x hx => ne_of_gt hx)
  have hrv : ContDiff ℝ ∞ radVec := by
    have h' : ContDiff ℝ ∞ (fun x : ℝ³ => x 0 • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        x 1 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) :=
      ((hc 0).smul contDiff_const).add ((hc 1).smul contDiff_const)
    exact h'
  have hSe : ContDiffOn ℝ ∞ eR {x : ℝ³ | 0 < rad x} := hinv.smul hrv.contDiffOn
  have hm : ∀ j : ℕ, ∃ Cj : ℝ, 0 ≤ Cj ∧ ∀ x : ℝ³, 0 < rad x →
      ‖iteratedFDeriv ℝ j eR x‖ ≤ Cj * rad x ^ ((0:ℝ) - j) :=
    homog eR 0 hSe
      (fun c x hc0 => by
        unfold eR
        rw [hRh c x hc0, hVh, smul_smul, hinvh _ _ hc0, Real.rpow_zero, one_smul])
      (fun c x => by unfold eR; rw [hRt, hVt])
  choose CC hCC0 hCC using hm
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = ∑ j ∈ Finset.range (m + 1), CC j := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by rw [hAdef]; exact Finset.sum_nonneg (fun j _ => hCC0 j)
  have hCA : ∀ j ≤ m, CC j ≤ A := by
    intro j hj
    rw [hAdef]
    exact Finset.single_le_sum (f := CC) (fun i _ => hCC0 i) (Finset.mem_range.2 (by omega))
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = 1 + B.Xa⁻¹ := ⟨_, rfl⟩
  have hXai : 0 < B.Xa⁻¹ := inv_pos.2 hXa
  have hM1 : 1 ≤ M := by rw [hMdef]; linarith
  have hM0 : 0 ≤ M := by linarith
  have hK0 : 0 ≤ 2 ^ m * (A * M ^ m) :=
    mul_nonneg (pow_nonneg (by norm_num) m) (mul_nonneg hA0 (pow_nonneg hM0 m))
  refine ⟨2 ^ m * (A * M ^ m), hK0, ?_⟩
  intro g x t a Cg hg hxt hlo hhi hgb
  set q := simScale B.h (x 2) (1 - t) with hqdef
  have hxt' : t < 1 ∧ q < qsOf l0 := hxt
  have hq0 : 0 < q := (hok.1.1 (x 2) (1 - t) (by linarith [hxt'.1])).1
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hq1 : q ≤ 1 := le_trans hxt'.2.le hqs1
  have hr2 : rad x ^ 2 = x 0 ^ 2 + x 1 ^ 2 := hrsq x
  have hrad : 0 < rad x := Real.sqrt_pos.mpr (lt_trans (mul_pos hXa hq0) hlo)

  have hqM : q ≤ M * rad x := by
    rcases le_or_gt q (rad x) with h | h
    · calc q ≤ rad x := h
        _ = 1 * rad x := (one_mul _).symm
        _ ≤ M * rad x := mul_le_mul_of_nonneg_right hM1 hrad.le
    · have hr1 : rad x < 1 := lt_of_lt_of_le h hq1
      have hrr : rad x ^ 2 ≤ rad x := by
        rw [sq]; exact mul_le_of_le_one_left hrad.le hr1.le
      have h1 : B.Xa * q < rad x := by linarith
      have h2 : q < B.Xa⁻¹ * rad x := by
        rw [← div_eq_inv_mul, lt_div_iff₀ hXa]; linarith
      have h3 : B.Xa⁻¹ * rad x ≤ M * rad x :=
        mul_le_mul_of_nonneg_right (by rw [hMdef]; linarith) hrad.le
      linarith
  have hrinv : (rad x)⁻¹ ≤ M * q⁻¹ := by
    have e1 : (rad x)⁻¹ = q * (q⁻¹ * (rad x)⁻¹) := by
      rw [← mul_assoc, mul_inv_cancel₀ hq0.ne', one_mul]
    have hrr : rad x * (rad x)⁻¹ = 1 := mul_inv_cancel₀ hrad.ne'
    have e2 : M * q⁻¹ = (M * rad x) * (q⁻¹ * (rad x)⁻¹) := by
      calc M * q⁻¹ = M * q⁻¹ * (rad x * (rad x)⁻¹) := by rw [hrr, mul_one]
        _ = (M * rad x) * (q⁻¹ * (rad x)⁻¹) := by ring
    rw [e1, e2]
    exact mul_le_mul_of_nonneg_right hqM
      (mul_nonneg (inv_nonneg.2 hq0.le) (inv_nonneg.2 hrad.le))
  have hqi : 1 ≤ q⁻¹ := (one_le_inv₀ hq0).mpr hq1
  have hβ1 : 1 ≤ M * q⁻¹ := one_le_mul_of_one_le_of_one_le hM1 hqi

  have hE : ∀ i : ℕ, i ≤ m → ‖iteratedFDeriv ℝ i (fun z : ℝ³ × ℝ => eR z.1) (x, t)‖ ≤
      (A * M ^ m) * q ^ (-(m:ℝ)) := by
    intro i hi
    have h1 := hlift eR hSe i (x, t) hrad
    have h2 := hCC i x hrad
    have e : rad x ^ ((0:ℝ) - i) = (rad x)⁻¹ ^ i := by
      rw [Real.rpow_sub hrad, Real.rpow_zero, Real.rpow_natCast, inv_pow, one_div]
    have h3 : (rad x)⁻¹ ^ i ≤ (M * q⁻¹) ^ m :=
      (pow_le_pow_left₀ (inv_nonneg.2 hrad.le) hrinv i).trans (pow_le_pow_right₀ hβ1 hi)
    have e2 : (M * q⁻¹) ^ m = M ^ m * q ^ (-(m:ℝ)) := by
      rw [mul_pow, Real.rpow_neg hq0.le, Real.rpow_natCast, inv_pow]
    calc ‖iteratedFDeriv ℝ i (fun z : ℝ³ × ℝ => eR z.1) (x, t)‖
        ≤ ‖iteratedFDeriv ℝ i eR x‖ := h1
      _ ≤ CC i * rad x ^ ((0:ℝ) - i) := h2
      _ ≤ A * (M * q⁻¹) ^ m := by
          rw [e]
          exact mul_le_mul (hCA i hi) h3 (pow_nonneg (inv_nonneg.2 hrad.le) i) hA0
      _ = (A * M ^ m) * q ^ (-(m:ℝ)) := by rw [e2]; ring

  have hqcont : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    have hmap : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
      (((EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst).prodMk
        (continuous_const.sub continuous_snd))
    refine hok.1.2.2.2.1.continuousOn.comp hmap.continuousOn ?_
    intro w hw
    exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
  have hΩ : IsOpen (simDomain B.h (qsOf l0)) := by
    have e : simDomain B.h (qsOf l0) = {w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0) := rfl
    rw [e]
    exact hqcont.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  have hUo : IsOpen {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} := by
    have e : {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} =
        (Prod.fst ⁻¹' {x : ℝ³ | 0 < rad x}) ∩ simDomain B.h (qsOf l0) := by
      ext z; exact ⟨fun h => ⟨h.1, h.2.1, h.2.2⟩, fun h => ⟨h.1, h.2.1, h.2.2⟩⟩
    rw [e]
    exact (hU0.preimage continuous_fst).inter hΩ
  have hEs : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => eR z.1) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} :=
    hSe.comp contDiffOn_fst (fun w hw => hw.1)
  have hzU : (x, t) ∈ {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} := ⟨hrad, hxt'.1, hxt'.2⟩
  have hCg : 0 ≤ Cg := by
    have h0 := hgb 0 (Nat.zero_le m)
    have hqa : 0 < q ^ a := Real.rpow_pos_of_pos hq0 a
    have h00 : 0 * q ^ a ≤ Cg * q ^ a := by rw [zero_mul]; exact (norm_nonneg _).trans h0
    exact le_of_mul_le_mul_right h00 hqa
  have bilin : ∀ (Bl : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³) (f : ℝ³ × ℝ → ℝ) (g : ℝ³ × ℝ → ℝ³)
      (Ω : Set (ℝ³ × ℝ)), IsOpen Ω → ContDiffOn ℝ ∞ f Ω → ContDiffOn ℝ ∞ g Ω →
      ∀ (n : ℕ) (w : ℝ³ × ℝ) (ρ a b Cf Cg : ℝ), w ∈ Ω → 0 < ρ →
      (∀ i : ℕ, i ≤ n → ‖iteratedFDeriv ℝ i f w‖ ≤ Cf * ρ ^ a) →
      (∀ i : ℕ, i ≤ n → ‖iteratedFDeriv ℝ i g w‖ ≤ Cg * ρ ^ b) →
      ‖iteratedFDeriv ℝ n (fun z => Bl (f z) (g z)) w‖ ≤ ‖Bl‖ * 2 ^ n * Cf * Cg * ρ ^ (a + b) := by
    intro Bl f g Ω hΩ' hf hg' n w ρ a b Cf Cg hw hρ hbf hbg
    have hU : UniqueDiffOn ℝ Ω := hΩ'.uniqueDiffOn
    have key := ContinuousLinearMap.norm_iteratedFDerivWithin_le_of_bilinear Bl hf hg' hU hw
      (n := n) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen n hΩ' hw] at key
    refine key.trans ?_
    have hsum : (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ)) = 2 ^ n := by
      exact_mod_cast Nat.sum_range_choose n
    have hP0 : 0 ≤ Cf * ρ ^ a := (norm_nonneg _).trans (hbf 0 (Nat.zero_le _))
    have hfin : ‖Bl‖ * 2 ^ n * Cf * Cg * ρ ^ (a + b) =
        ‖Bl‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * ((Cf * ρ ^ a) * (Cg * ρ ^ b)) := by
      rw [← Finset.sum_mul, hsum, Real.rpow_add hρ]; ring
    rw [hfin]
    refine mul_le_mul_of_nonneg_left ?_ (ContinuousLinearMap.opNorm_nonneg Bl)
    refine Finset.sum_le_sum fun i hi => ?_
    have hin : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    rw [iteratedFDerivWithin_of_isOpen i hΩ' hw, iteratedFDerivWithin_of_isOpen (n - i) hΩ' hw]
    have h0 : (0 : ℝ) ≤ n.choose i := Nat.cast_nonneg _
    calc (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i f w‖ * ‖iteratedFDeriv ℝ (n - i) g w‖
        ≤ (n.choose i : ℝ) * (Cf * ρ ^ a) * (Cg * ρ ^ b) :=
          mul_le_mul (mul_le_mul_of_nonneg_left (hbf i hin) h0) (hbg (n - i) (Nat.sub_le n i))
            (norm_nonneg _) (mul_nonneg h0 hP0)
      _ = (n.choose i : ℝ) * ((Cf * ρ ^ a) * (Cg * ρ ^ b)) := by ring
  have hL := bilin (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³) g
    (fun z : ℝ³ × ℝ => eR z.1) _ hUo hg hEs m (x, t) q a (-(m:ℝ)) Cg (A * M ^ m) hzU hq0 hgb hE
  have hfun : (fun z : ℝ³ × ℝ => (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³) (g z)
      (eR z.1)) = fun z : ℝ³ × ℝ => g z • eR z.1 := by
    funext z; simp only [ContinuousLinearMap.lsmul_apply]
  rw [hfun] at hL
  have hnl : ‖(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)‖ ≤ 1 :=
    ContinuousLinearMap.opNorm_lsmul_le
  have e3 : a + -(m:ℝ) = a - (m:ℝ) := by ring
  rw [e3] at hL
  have hX : 0 ≤ 2 ^ m * Cg * (A * M ^ m) * q ^ (a - (m:ℝ)) :=
    mul_nonneg (mul_nonneg (mul_nonneg (pow_nonneg (by norm_num) m) hCg)
      (mul_nonneg hA0 (pow_nonneg hM0 m))) (Real.rpow_nonneg hq0.le _)
  calc ‖iteratedFDeriv ℝ m (fun z : ℝ³ × ℝ => g z • eR z.1) (x, t)‖
      ≤ ‖(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)‖ * 2 ^ m * Cg * (A * M ^ m) *
          q ^ (a - (m:ℝ)) := hL
    _ = ‖(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)‖ *
          (2 ^ m * Cg * (A * M ^ m) * q ^ (a - (m:ℝ))) := by ring
    _ ≤ 1 * (2 ^ m * Cg * (A * M ^ m) * q ^ (a - (m:ℝ))) := mul_le_mul_of_nonneg_right hnl hX
    _ = 2 ^ m * (A * M ^ m) * Cg * q ^ (a - (m:ℝ)) := by ring

theorem spb5_residual_bound : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∃ L : ℕ → ℝ, (∀ m, 0 ≤ L m) ∧ ∀ (S : CState) (bw ca cm cd : ℝ), StOrd5 B G l0 S bw ca cm cd → MeanId5 B G l0 S → ∀ m N : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) → ‖iteratedFDeriv ℝ m (↿(fRes5 B G l0 S)) (x, t)‖ ≤ C * simScale B.h (x 2) (1 - t) ^ (B.h * min bw (min cm cd) - L m) + C * simScale B.h (x 2) (1 - t) ^ (N : ℝ) :=
by
  intro B G hok hG
  have hSim : SimScaleProps B.h := hok.1
  have hBP := hok.2
  unfold BackgroundProps at hBP
  obtain ⟨hB0, -⟩ := hBP
  obtain ⟨hh0, hh1, hXa, hXam1, hm12, hm2Xb, -, hqB0, -, -, -, -, -⟩ := hB0
  have hXb : 0 < B.Xb := by linarith
  obtain ⟨lw, hw⟩ := ipb5_wave_vec_conversion B G hok hG
  obtain ⟨lm, hmc⟩ := ipb5_mean_conversion B G hok hG
  obtain ⟨lo, ho⟩ := sw5_O1_flat_smooth B G hok hG
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0 + lw + lm + lo, fun l0 hl0 => ?_⟩

  have hqcont : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    have hmap : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
      (((EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst).prodMk
        (continuous_const.sub continuous_snd))
    refine hSim.2.2.2.1.continuousOn.comp hmap.continuousOn ?_
    intro w hw
    exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
  have hΩ : IsOpen (simDomain B.h (qsOf l0)) := by
    have e : simDomain B.h (qsOf l0) = {w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0) := rfl
    rw [e]
    exact hqcont.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs0 : 0 < qsOf l0 := by rw [hQb]; positivity
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hq : ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) →
      0 < simScale B.h (x 2) (1 - t) ∧ simScale B.h (x 2) (1 - t) ≤ 1 := by
    intro x t hxt
    have hxt' : t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
    exact ⟨(hSim.1 (x 2) (1 - t) (by linarith [hxt'.1])).1, le_trans hxt'.2.le hqs1⟩
  have key2 : ∀ (C a b q : ℝ), 0 < q → q ≤ 1 → b ≤ a → C * q ^ a ≤ |C| * q ^ b := by
    intro C a b q hq0 hq1 hba
    calc C * q ^ a ≤ |C| * q ^ a :=
          mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0.le _)
      _ ≤ |C| * q ^ b :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0 hq1 hba) (abs_nonneg C)
  have hmle : ∀ m : ℕ, ((m : ℕ) : WithTop ℕ∞) ≤ ∞ := fun m => by exact_mod_cast le_top
  have hcd := corr_domain_v5 B l0 0 hok
  have hUo : IsOpen {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} := hcd.1
  have hERU : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => eR w.1) {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} :=
    hcd.2.2.2.2.1.comp contDiffOn_fst (fun w hw => hw.1)
  have hUΩ : {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} ⊆ simDomain B.h (qsOf l0) :=
    fun w hw => ⟨hw.2.1, hw.2.2⟩

  have assemble : ∀ (m : ℕ) (Res A1 A2 A3 A4 A5 A6 A7 : ℝ³ × ℝ → ℝ³) (z : ℝ³ × ℝ),
      ContDiffAt ℝ ∞ Res z → ContDiffAt ℝ ∞ A1 z → ContDiffAt ℝ ∞ A2 z → ContDiffAt ℝ ∞ A4 z →
      ContDiffAt ℝ ∞ A5 z → ContDiffAt ℝ ∞ A6 z → ContDiffAt ℝ ∞ A7 z →
      (Res =ᶠ[nhds z] fun w => A1 w + A2 w + A3 w + A4 w + A5 w + A6 w - A7 w) →
      ‖iteratedFDeriv ℝ m Res z‖ ≤ ‖iteratedFDeriv ℝ m A1 z‖ + ‖iteratedFDeriv ℝ m A2 z‖ +
        ‖iteratedFDeriv ℝ m A3 z‖ + ‖iteratedFDeriv ℝ m A4 z‖ + ‖iteratedFDeriv ℝ m A5 z‖ +
        ‖iteratedFDeriv ℝ m A6 z‖ + ‖iteratedFDeriv ℝ m A7 z‖ := by
    intro m Res A1 A2 A3 A4 A5 A6 A7 z hR h1 h2 h4 h5 h6 h7 hEq
    have c : ∀ {f : ℝ³ × ℝ → ℝ³}, ContDiffAt ℝ ∞ f z → ContDiffAt ℝ (m : ℕ) f z :=
      fun hf => hf.of_le (hmle m)
    have hG : ContDiffAt ℝ ∞ (A1 + A2 + A4 + A5 + A6 - A7) z :=
      ((((h1.add h2).add h4).add h5).add h6).sub h7
    have hEv : (Res - (A1 + A2 + A4 + A5 + A6 - A7)) =ᶠ[nhds z] A3 := by
      refine hEq.mono (fun w hw => ?_)
      simp only [Pi.sub_apply, Pi.add_apply, hw]
      abel
    have e1 : iteratedFDeriv ℝ m (Res - (A1 + A2 + A4 + A5 + A6 - A7)) z =
        iteratedFDeriv ℝ m Res z - iteratedFDeriv ℝ m (A1 + A2 + A4 + A5 + A6 - A7) z :=
      iteratedFDeriv_sub_apply (c hR) (c hG)
    have e2 : iteratedFDeriv ℝ m (Res - (A1 + A2 + A4 + A5 + A6 - A7)) z = iteratedFDeriv ℝ m A3 z :=
      (hEv.iteratedFDeriv ℝ m).eq_of_nhds
    have e3 : iteratedFDeriv ℝ m (A1 + A2 + A4 + A5 + A6 - A7) z =
        iteratedFDeriv ℝ m A1 z + iteratedFDeriv ℝ m A2 z + iteratedFDeriv ℝ m A4 z +
