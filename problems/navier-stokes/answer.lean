    have e1 : (2 ^ ((1:ℝ)/3) * (W ^ ((5:ℝ)/6) * S ^ ((1:ℝ)/6) + (2 * M) ^ ((4:ℝ)/3) * (V + W)))
          ^ ((3:ℝ)/4)
        = 2 ^ ((1:ℝ)/4) * (W ^ ((5:ℝ)/6) * S ^ ((1:ℝ)/6) + (2 * M) ^ ((4:ℝ)/3) * (V + W))
          ^ ((3:ℝ)/4) := by
      rw [Real.mul_rpow (by positivity) (add_nonneg ha hd)]
      congr 1
      rw [← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2)]
      norm_num
    have e2 : (W ^ ((5:ℝ)/6) * S ^ ((1:ℝ)/6)) ^ ((3:ℝ)/4) = W ^ ((5:ℝ)/8) * S ^ ((1:ℝ)/8) := by
      rw [Real.mul_rpow (Real.rpow_nonneg hW _) (Real.rpow_nonneg hS _), ← Real.rpow_mul hW,
        ← Real.rpow_mul hS]
      norm_num
    have e3 : ((2 * M) ^ ((4:ℝ)/3) * (V + W)) ^ ((3:ℝ)/4) = 2 * M * (V + W) ^ ((3:ℝ)/4) := by
      rw [Real.mul_rpow (Real.rpow_nonneg h2M _) hVW0, ← Real.rpow_mul h2M]
      norm_num
    have hsub := Real.rpow_add_le_add_rpow ha hd (by norm_num : (0:ℝ) ≤ 3/4)
