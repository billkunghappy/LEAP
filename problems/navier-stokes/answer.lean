  have hFTC : ∀ b : ℝ, 0 ≤ b → b ≤ 2 * t1 →
      Real.log (Fn (4 / Λ * Real.exp b) e) - Real.log (Fn (4 / Λ) e) =
        (∫ z in (0:ℝ)..b, 4 / Λ * Real.exp z *
          (deriv (fun Y => Fn Y e) (4 / Λ * Real.exp z) / Fn (4 / Λ * Real.exp z) e)) ∧
      Un (4 / Λ * Real.exp b) e - Un (4 / Λ) e =
        ∫ z in (0:ℝ)..b, 4 / Λ * Real.exp z * deriv (fun Y => Un Y e) (4 / Λ * Real.exp z) := by
    intro b hb0 hb1
    have hsub : uIcc 0 b ⊆ Icc 0 (2 * t1) := by
      rw [uIcc_of_le hb0]; exact Icc_subset_Icc le_rfl hb1
    have hX' : ∀ z : ℝ, HasDerivAt (fun z => 4 / Λ * Real.exp z) (4 / Λ * Real.exp z) z :=
      fun z => (Real.hasDerivAt_exp z).const_mul (4 / Λ)
