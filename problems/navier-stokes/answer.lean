  choose C hC using hqη
  obtain ⟨S, hS⟩ : ∃ S : ℕ → ℝ, S = fun m =>
      ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * |C i| * |C (m - i)| := ⟨_, rfl⟩
  have hS0 : ∀ m, 0 ≤ S m := by
    intro m
