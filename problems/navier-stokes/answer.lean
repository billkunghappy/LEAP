  have hPb : ∀ i : ℕ, i ≤ k → NB B.h (fun η : Cyl => (hDetC B G γ η)⁻¹ • (Hcol B G (γ.1, γ.2.1, true) (η.1, η.2.1, η.2.2.1),
      Hcol B G (γ.1, γ.2.1, false) (η.1, η.2.1, η.2.2.1))) i ξ ≤ aP := by
    intro i hi
    rw [haP]
    exact le_trans (hNi i).2.2.2 (hm0 _ _ _ _ (by rw [hCP]; exact hsum CN i hi) (by rw [hbP]; exact hsum bN i hi))
  have hS1b : ∀ i : ℕ, i ≤ k → NB B.h (nrm B (2 * Aex B.h) (sigE5 B G l0 S 1)) i ξ ≤ aS := by
    intro i hi
    rw [haS]
    exact le_trans (h1 i ξ hξ hX1 hX2) (hm (C1 i) (b1 i) (d1 i) CS bS dS _ _
      (by rw [hCS]; exact hsumL C1 C2 i hi) (by rw [hbS]; exact hsumL b1 b2 i hi)
      (by rw [hdS]; exact hsumL d1 d2 i hi) (Real.rpow_nonneg hq0.le _) hζ0)
  have hS2b : ∀ i : ℕ, i ≤ k → NB B.h (nrm B (2 * Aex B.h) (sigE5 B G l0 S 2)) i ξ ≤ aS := by
    intro i hi
    rw [haS]
    exact le_trans (h2 i ξ hξ hX1 hX2) (hm (C2 i) (b2 i) (d2 i) CS bS dS _ _
      (by rw [hCS]; exact hsumR C1 C2 i hi) (by rw [hbS]; exact hsumR b1 b2 i hi)
      (by rw [hdS]; exact hsumR d1 d2 i hi) (Real.rpow_nonneg hq0.le _) hζ0)
  have hQb' : ∀ j : ℕ, j ≤ k → NB B.h (fun η : Cyl => qC B.h η ^ (-1:ℝ)) j ξ ≤ aQ := by
    intro j hj
    have hA0 : 0 ≤ Cq * qC B.h ξ := mul_nonneg hCq0 hq0.le
    have := hK1 B.h (DomC B.h (qsOf l0)) (qC B.h) ξ (Cq * qC B.h ξ) hDo hqC
      (fun η hη => hqpos η hη.2.1) hξ hA0 (fun i _ hi => hCq i hi ξ hξ.2.1 hq1.le) j hj
    have e : Cq * qC B.h ξ / qC B.h ξ = Cq := by field_simp
    rw [e] at this
    rw [haQ]; exact this
  have hRb : ∀ j : ℕ, j ≤ k → NB B.h (fun η : Cyl => yAmp4 B G γ η ^ (-(1/2:ℝ))) j ξ ≤ aR := by
    intro j hj
    obtain ⟨A, hAdef⟩ : ∃ x : ℝ, x = CP * SC B.h ξ ^ bP * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dP) := ⟨_, rfl⟩
    have hA0 : 0 ≤ A := by
