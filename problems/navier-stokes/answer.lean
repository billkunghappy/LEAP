      refine ⟨|c| * |C₁| + |d| * |C₂|, max b₁ b₂, max d₁ d₂, fun ξ hξ hX1 hX2 => ?_⟩
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      have hqa : 0 < qC B.h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
      have hqb : qC B.h ξ ≤ 1 := hξ'.2.2.le.trans hq1
      have hSC : 1 ≤ SC B.h ξ := by
        unfold SC
        exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h ξ))])
      have hEW : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
        unfold edgeWeight
        split_ifs
        · positivity
        · exact le_rfl
      have hX0 : 0 < XC B.h ξ := hXa.trans hX1
      have hE0 : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) := by
        unfold edgeDist
        exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
          (Real.log_pos ((one_lt_div hX0).mpr hX2)))
      have hE1 : edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := by
        unfold edgeDist
        exact min_le_left _ _
      have k1 := (H₁ ξ hξ hX1 hX2).trans (key γ _ _ _ _ hqa hqb hSC hEW hE0 hE1 C₁ α b₁ d₁
        (max b₁ b₂) (max d₁ d₂) hγα (le_max_left _ _) (le_max_left _ _))
      have k2 := (H₂ ξ hξ hX1 hX2).trans (key γ _ _ _ _ hqa hqb hSC hEW hE0 hE1 C₂ β b₂ d₂
        (max b₁ b₂) (max d₁ d₂) hγβ (le_max_right _ _) (le_max_right _ _))
      have hk0 : NB B.h k n ξ ≤ |c| * NB B.h f n ξ + |d| * NB B.h g n ξ :=
        hkb n ξ (Lnorm B.h ξ) hξ
      exact hk0.trans ((add_le_add (mul_le_mul_of_nonneg_left k1 (abs_nonneg c))
        (mul_le_mul_of_nonneg_left k2 (abs_nonneg d))).trans (le_of_eq (by ring)))
  have hk : kapS = 1 / 100000 := rfl
  have hk0 : (0:ℝ) < kapS := by rw [hk]; norm_num
  have lin2 : ∀ (α β γ c d e : ℝ) (f g k : Cyl → ℝ), InM B (qsOf l0) α (nrm B e f) →
      InM B (qsOf l0) β (nrm B e g) → γ ≤ α → γ ≤ β →
      (∀ ξ ∈ DomC B.h (qsOf l0), k ξ = c * f ξ + d * g ξ) → InM B (qsOf l0) γ (nrm B e k) :=
    fun α β γ c d e f g k hf hg h1 h2 hkk => algM α β γ c d _ _ _ hf hg h1 h2
      (fun ξ hξ => by simp only [nrm]; rw [hkk ξ hξ]; ring)

  have hslice : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ Y : ℝ × ℝ,
      ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) ∈ DomC B.h (qsOf l0) := fun ξ hξ _ => hξ
  have yAvg_congr : ∀ (f g : Cyl → ℝ) (ξ : Cyl),
      (∀ Y : ℝ × ℝ, f (ξ.1, ξ.2.1, ξ.2.2.1, Y) = g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) →
      yAvg f ξ = yAvg g ξ := by
    intro f g ξ h
    unfold yAvg
    congr 1
    funext Y
    exact h Y

  have hpos : ∀ η ∈ DomC B.h (qsOf l0), 0 < qC B.h η := by
    intro η hη
    obtain ⟨-, h2, -⟩ := hη
    exact (hB.1.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hS : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
    hB.1.2.2.2.1
  have hφ : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by fun_prop
  have hmapsD : Set.MapsTo (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ))
      (DomC B.h (qsOf l0)) (univ ×ˢ Ioi 0) := by
    intro η hη
    obtain ⟨-, h2, -⟩ := hη
    exact ⟨mem_univ _, show (0:ℝ) < 1 - η.2.2.1 by linarith⟩
  have hqC : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h (qsOf l0)) :=
    (hS.comp hφ.contDiffOn hmapsD).congr (fun η _ => rfl)
  have hΩ : IsOpen (DomC B.h (qsOf l0)) := by
    have hs : IsOpen {η : Cyl | 0 < η.1 ∧ η.2.2.1 < 1} :=
      (isOpen_lt continuous_const continuous_fst).inter
        (isOpen_lt (continuous_fst.comp (continuous_snd.comp continuous_snd)) continuous_const)
    have hmaps : Set.MapsTo (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ))
        {η : Cyl | 0 < η.1 ∧ η.2.2.1 < 1} (univ ×ˢ Ioi 0) := by
      intro η hη
      obtain ⟨-, h2⟩ := hη
      exact ⟨mem_univ _, show (0:ℝ) < 1 - η.2.2.1 by linarith⟩
    have hc := hS.continuousOn.comp hφ.continuous.continuousOn hmaps
    have h2 := hc.isOpen_inter_preimage hs (isOpen_Iio (a := qsOf l0))
    convert h2 using 1
    ext η
    simp [DomC, qC, Function.comp, and_assoc]

  have creg : ∀ (g : Cyl → ℝ) (α e : ℝ), InM B (qsOf l0) α (nrm B e g) →
      ContDiffOn ℝ ∞ g (DomC B.h (qsOf l0)) ∧
      ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → g ξ = 0 := by
    intro g α e hg
    obtain ⟨hs, -, hz, -⟩ := hg
    have hw : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-e)) (DomC B.h (qsOf l0)) :=
      hqC.rpow_const_of_ne (fun η hη => (hpos η hη).ne')
    have hid : ∀ η ∈ DomC B.h (qsOf l0), g η = qC B.h η ^ (-e) * nrm B e g η := by
      intro η hη
      have h0 := hpos η hη
      show g η = qC B.h η ^ (-e) * (qC B.h η ^ e * g η)
      rw [← mul_assoc, ← Real.rpow_add h0, neg_add_cancel, Real.rpow_zero, one_mul]
    refine ⟨(hw.mul hs).congr hid, ?_⟩
    intro ξ hξ hX
    have h1 : qC B.h ξ ^ e * g ξ = 0 := hz ξ hξ hX
    exact (mul_eq_zero.mp h1).resolve_left (Real.rpow_pos_of_pos (hpos ξ hξ) e).ne'

  have row : ∀ (n : ℕ), (n = 1 ∨ n = 2) → ∀ (Eo En D Z P : Cyl → ℝ) (αZ : ℝ),
      InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h + 1/2) Eo) →
      InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h) D) →
      InM B (qsOf l0) αZ (nrm B (2 * Aex B.h) Z) → Bo + 1/2 - 2 * kapS ≤ αZ →
      InM B (qsOf l0) (Bo + 17/25 - kapS) (nrm B (2 * Aex B.h) (fun ξ => D ξ - P ξ)) →
      (∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        yAvg P ξ = sigE5 B G l0 S n ξ) →
      (∀ ξ, FE5 B G l0 S n ξ = yAvg Eo ξ) →
      (∀ ξ ∈ DomC B.h (qsOf l0), En ξ = Eo ξ + (dR B.h D ξ + (n:ℝ) * (D ξ / ξ.1) + dZ Z ξ)) →
      InM B (qsOf l0) (Bo + 1/2 + 17/100) (nrm B (2 * Aex B.h + 1/2) (yAvg En)) := by
    intro n hn Eo En D Z P αZ hEo hD hZ hαZ hR hsh hFE hEn
    obtain ⟨R, hRd⟩ : ∃ R : Cyl → ℝ, R = fun ξ => D ξ - P ξ := ⟨_, rfl⟩
    have hRp : ∀ η, R η = D η - P η := fun η => by rw [hRd]
    have hR2 : InM B (qsOf l0) (Bo + 17/25 - kapS) (nrm B (2 * Aex B.h) R) := by
      rw [hRd]; exact hR
    have hD' := hRC D _ _ hD
    have hZ' := hRC Z _ _ hZ
    have hR' := hRC R _ _ hR2
    have hρ' := hRC (yAvg R) _ _ hR'.2.2.2.1
    have hYZ' := hRC (yAvg Z) _ _ hZ'.2.2.2.1
    have hσ := hT.2.2.1 n hn
    have hbM := hT.2.2.2 n hn

    obtain ⟨T1, hT1d⟩ : ∃ T1 : Cyl → ℝ, T1 = fun η => 1 * dR B.h D η + (n:ℝ) * (D η / η.1) :=
      ⟨_, rfl⟩
    have hT1p : ∀ η, T1 η = 1 * dR B.h D η + (n:ℝ) * (D η / η.1) := fun η => by rw [hT1d]
    obtain ⟨T, hTd⟩ : ∃ T : Cyl → ℝ, T = fun η => 1 * T1 η + 1 * dZ Z η := ⟨_, rfl⟩
    have hTp : ∀ η, T η = 1 * T1 η + 1 * dZ Z η := fun η => by rw [hTd]
    have hT1c : InM B (qsOf l0) (Bo + 1/2 - 2 * kapS) (nrm B (2 * Aex B.h + 1/2) T1) :=
      lin2 _ _ _ 1 (n:ℝ) _ (dR B.h D) (fun η => D η / η.1) T1 hD'.1 hD'.2.2.1 (by linarith)
        (by linarith) (fun ξ _ => hT1p ξ)
    have hTc : InM B (qsOf l0) (Bo + 1/2 - 2 * kapS) (nrm B (2 * Aex B.h + 1/2) T) :=
      lin2 _ _ _ 1 1 _ T1 (dZ Z) T hT1c hZ'.2.1 le_rfl (by linarith [hk]) (fun ξ _ => hTp ξ)
    have hch : ∀ ξ ∈ DomC B.h (qsOf l0), yAvg En ξ =
        yAvg Eo ξ + dR B.h (yAvg D) ξ + (n:ℝ) * (yAvg D ξ / ξ.1) + dZ (yAvg Z) ξ := by
      intro ξ hξ
      have a1 : yAvg En ξ = yAvg (fun η => 1 * Eo η + 1 * T η) ξ :=
        yAvg_congr _ _ ξ (fun Y => by
          (try dsimp only)
          rw [hEn _ (hslice ξ hξ Y), hTp, hT1p]; ring)
      have a2 : yAvg (fun η => 1 * Eo η + 1 * T η) ξ = 1 * yAvg Eo ξ + 1 * yAvg T ξ :=
        hLin Eo T _ _ _ 1 1 hEo hTc ξ hξ
      have a3 : yAvg T ξ = yAvg (fun η => 1 * T1 η + 1 * dZ Z η) ξ :=
        yAvg_congr _ _ ξ (fun Y => hTp _)
      have a4 : yAvg (fun η => 1 * T1 η + 1 * dZ Z η) ξ = 1 * yAvg T1 ξ + 1 * yAvg (dZ Z) ξ :=
        hLin T1 (dZ Z) _ _ _ 1 1 hT1c hZ'.2.1 ξ hξ
      have a5 : yAvg T1 ξ = yAvg (fun η => 1 * dR B.h D η + (n:ℝ) * (D η / η.1)) ξ :=
        yAvg_congr _ _ ξ (fun Y => hT1p _)
      have a6 : yAvg (fun η => 1 * dR B.h D η + (n:ℝ) * (D η / η.1)) ξ =
          1 * yAvg (dR B.h D) ξ + (n:ℝ) * yAvg (fun η => D η / η.1) ξ :=
        hLin (dR B.h D) (fun η => D η / η.1) _ _ _ 1 (n:ℝ) hD'.1 hD'.2.2.1 ξ hξ
      obtain ⟨c1, -, c2⟩ := hD'.2.2.2.2 ξ hξ
      have c3 := (hZ'.2.2.2.2 ξ hξ).2.1
      linear_combination a1 + a2 + a3 + a4 + a5 + a6 + c1 + (n:ℝ) * c2 + c3

    have hPc : InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h) P) :=
      lin2 _ _ _ 1 (-1) _ D R P hD hR2 le_rfl (by linarith) (fun ξ _ => by rw [hRp]; ring)
    have hs1 : ∀ ξ ∈ DomC B.h (qsOf l0), yAvg D ξ = sigE5 B G l0 S n ξ + yAvg R ξ := by
      intro ξ hξ
      have b1 : yAvg D ξ = yAvg (fun η => 1 * P η + 1 * R η) ξ :=
        yAvg_congr _ _ ξ (fun Y => by (try dsimp only); rw [hRp]; ring)
      have b2 : yAvg (fun η => 1 * P η + 1 * R η) ξ = 1 * yAvg P ξ + 1 * yAvg R ξ :=
        hLin P R _ _ _ 1 1 hPc hR2 ξ hξ
      have b3 : yAvg P ξ = sigE5 B G l0 S n ξ := by
        by_cases hsh2 : B.Xa < XC B.h ξ ∧ XC B.h ξ < B.Xb
        · exact hsh ξ hξ hsh2.1 hsh2.2
        · have hoff : XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ := by
            rcases not_and_or.mp hsh2 with h | h
            · exact Or.inl (not_lt.mp h)
            · exact Or.inr (not_lt.mp h)
          have b4 : yAvg P ξ = yAvg (fun _ => (0:ℝ)) ξ := yAvg_congr _ _ ξ (fun Y => by
            have h1 := (creg D _ _ hD).2 _ (hslice ξ hξ Y) hoff
            have h2 := (creg R _ _ hR2).2 _ (hslice ξ hξ Y) hoff
            rw [hRp] at h2
            (try dsimp only)
            linarith)
          rw [b4, hT.1 n hn ξ hξ hoff]
          simp [yAvg]
      linear_combination b1 + b2 + b3
    have hs2 : ∀ ξ ∈ DomC B.h (qsOf l0), dR B.h (yAvg D) ξ =
        dR B.h (sigE5 B G l0 S n) ξ + dR B.h (yAvg R) ξ := by
      intro ξ hξ
      have hev : yAvg D =ᶠ[nhds ξ] fun η => sigE5 B G l0 S n η + yAvg R η :=
        Filter.eventuallyEq_of_mem (hΩ.mem_nhds hξ) (fun η hη => hs1 η hη)
      have hσd : DifferentiableAt ℝ (sigE5 B G l0 S n) ξ :=
        ((creg _ _ _ hσ).1.differentiableOn (by simp)).differentiableAt (hΩ.mem_nhds hξ)
      have hρd : DifferentiableAt ℝ (yAvg R) ξ :=
        ((creg _ _ _ hR'.2.2.2.1).1.differentiableOn (by simp)).differentiableAt
          (hΩ.mem_nhds hξ)
      have hadd : fderiv ℝ (fun η => sigE5 B G l0 S n η + yAvg R η) ξ =
          fderiv ℝ (sigE5 B G l0 S n) ξ + fderiv ℝ (yAvg R) ξ :=
        (hσd.hasFDerivAt.add hρd.hasFDerivAt).fderiv
      unfold dR
      rw [hev.fderiv_eq, hadd, ContinuousLinearMap.add_apply]

    have hcan : ∀ ξ ∈ DomC B.h (qsOf l0), yAvg En ξ =
        bE B n ξ * ME5 B G l0 S n ξ.2.1 ξ.2.2.1 + dR B.h (yAvg R) ξ +
          (n:ℝ) * (yAvg R ξ / ξ.1) + dZ (yAvg Z) ξ := by
      intro ξ hξ
      have hODE := hT.2.1 n hn ξ hξ
      rw [hFE ξ] at hODE
      linear_combination hch ξ hξ + hs2 ξ hξ + ((n:ℝ) / ξ.1) * hs1 ξ hξ + hODE

    have k1 : InM B (qsOf l0) (Bo + 1/2 + 17/100) (nrm B (2 * Aex B.h + 1/2)
        (fun ξ => bE B n ξ * ME5 B G l0 S n ξ.2.1 ξ.2.2.1 + dR B.h (yAvg R) ξ)) :=
      lin2 _ _ _ 1 1 _ _ _ _ hbM hρ'.1 (by linarith [hk]) (by linarith [hk])
        (fun ξ _ => by (try dsimp only); ring)
    have k2 : InM B (qsOf l0) (Bo + 1/2 + 17/100) (nrm B (2 * Aex B.h + 1/2)
        (fun ξ => (bE B n ξ * ME5 B G l0 S n ξ.2.1 ξ.2.2.1 + dR B.h (yAvg R) ξ) +
          (n:ℝ) * (yAvg R ξ / ξ.1))) :=
      lin2 _ _ _ 1 (n:ℝ) _ _ _ _ k1 hρ'.2.2.1 le_rfl (by linarith [hk])
        (fun ξ _ => by (try dsimp only); ring)
    exact lin2 _ _ _ 1 1 _ _ _ _ k2 hYZ'.2.1 le_rfl (by linarith [hk])
      (fun ξ hξ => by rw [hcan ξ hξ]; (try dsimp only); ring)
  refine ⟨row 2 (Or.inr rfl) (EthP5 B G l0 S) (EthP5 B G l0 S2) (dWc5 B G l0 S S2 0 1)
      (dWc5 B G l0 S S2 2 1) (covPr5 B G (LSc5 B G l0 S) 1) (Bo + 1/2 - kapS) c8 (hCov 0 1)
      (hCov 2 1) (by linarith [hk]) (hRem 1) (fun ξ hξ h1 h2 => (hCV ξ hξ h1 h2).1)
      (fun ξ => by unfold FE5; simp) (fun ξ hξ => by rw [hId1 ξ hξ]; push_cast; ring),
    row 1 (Or.inl rfl) (EzP5 B G l0 S) (EzP5 B G l0 S2) (dWc5 B G l0 S S2 0 2)
      (fun η => dWc5 B G l0 S S2 2 2 η + (pmP5 B G l0 S2 η - pmP5 B G l0 S η))
      (covPr5 B G (LSc5 B G l0 S) 2) (Bo + 1/2 - 2 * kapS) c9 (hCov 0 2) hQ le_rfl (hRem 2)
      (fun ξ hξ h1 h2 => (hCV ξ hξ h1 h2).2)
      (fun ξ => by unfold FE5; simp) (fun ξ hξ => by rw [hId2 ξ hξ]; push_cast; ring)⟩

theorem stress5_mean_residual : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
    l1 ≤ l0 → ∀ (S : CState) (Bo : ℝ), 7/10 ≤ Bo → StressIn5 B G l0 S Bo → StressTargetOK5 B G l0 S Bo →
    SignedClass5 B G l0 S Bo → StressMeansSame5 B G l0 S → SignedCov5 B G l0 S →
    InM B (qsOf l0) (Bo + 1/2 - 2 * kapS) (nrm B (2 * Aex B.h + 1/2) (EthP5 B G l0 (stressStep5 B G l0 S))) ∧
    InM B (qsOf l0) (Bo + 1/2 - 2 * kapS) (nrm B (2 * Aex B.h + 1/2) (EzP5 B G l0 (stressStep5 B G l0 S))) ∧
    InM B (qsOf l0) (Bo + 1/2 + 17/100)
      (nrm B (2 * Aex B.h + 1/2) (yAvg (EthP5 B G l0 (stressStep5 B G l0 S)))) ∧
    InM B (qsOf l0) (Bo + 1/2 + 17/100)
      (nrm B (2 * Aex B.h + 1/2) (yAvg (EzP5 B G l0 (stressStep5 B G l0 S)))) ∧
    InS B (qsOf l0) (Bo + 1/2 - 2 * kapS) (nrmS B (2 * Aex B.h) (calP5 B G l0 (stressStep5 B G l0 S))) ∧
    InS B (qsOf l0) (Bo + 1/2 - 2 * kapS) (nrmS B (2 * Aex B.h - 3/2) (calJth5 B G l0 (stressStep5 B G l0 S))) ∧
    InS B (qsOf l0) (Bo + 1/2 - 2 * kapS) (nrmS B (2 * Aex B.h - 1) (calJz5 B G l0 (stressStep5 B G l0 S))) ∧
    InM B (qsOf l0) 0.9 (nrm B (2 * Aex B.h) (pmP5 B G l0 (stressStep5 B G l0 S))) ∧
    InM B (qsOf l0) (Bo - kapS)
      (nrm B (2 * Aex B.h) (fun ξ => pmP5 B G l0 (stressStep5 B G l0 S) ξ - pmP5 B G l0 S ξ)) ∧
    ∃ α : ℝ, InM B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) (grP5 B G l0 (stressStep5 B G l0 S))) :=
by
  intro B G hB hG
  have hSN : SimNorm B.h := simscale_normalized_v4 B.h hB.2.1.1 hB.2.1.2.1 hB.1
  obtain ⟨l2, h2⟩ := wmo_velocity_split_v5 B G hB hG
  obtain ⟨l3, h3⟩ := wave_theta_pair_v5 B G hB hG
  obtain ⟨l4, h4⟩ := wmo_pair_class_v5 B G hB hG
  obtain ⟨l14, h14⟩ := wmo_amp_class_v5 B G hB hG
  obtain ⟨l15, h15⟩ := stress5_amp_split_v5 B G hB hG
  obtain ⟨l5, h5⟩ := stress5_radial_calculus B hB hSN
  obtain ⟨l6, h6⟩ := stress5_change_identities B G hB
  obtain ⟨l7, h7⟩ := stress5_state_grP_class B G hB hSN
  obtain ⟨l8, h8⟩ := mom_radial_moment_class_v4 B hB hSN
  obtain ⟨l9, h9⟩ := mom_icut_class_v4 B hB hSN
  refine ⟨l2 + l3 + l4 + l14 + l15 + l5 + l6 + l7 + l8 + l9, ?_⟩
  intro l0 hl0 S Bo hBo hIn hT hSC hMS hCV
  have hq1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hq0 : 0 < qsOf l0 := by
    show (0:ℝ) < (2:ℝ) ^ (-(l0:ℝ))
    positivity
  obtain ⟨algM, algS⟩ := mom_class_algebra_v4 B (qsOf l0) hB hq0 hq1
  have hk : kapS = 1 / 100000 := rfl
  have hk0 : 0 < kapS := by rw [hk]; norm_num
  have h09 : (0.9:ℝ) = 9/10 := by norm_num
  have mono : ∀ (f : Cyl → ℝ) (α α' : ℝ), InM B (qsOf l0) α f → α' ≤ α → InM B (qsOf l0) α' f :=
    fun f α α' hf h => algM α α α' 1 0 f f f hf hf h h (fun ξ _ => by ring)
  have lin2 : ∀ (α β γ c d e : ℝ) (f g k : Cyl → ℝ), InM B (qsOf l0) α (nrm B e f) →
