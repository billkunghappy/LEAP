    have k1 : M ^ 3 * Q ≤ M ^ 4 * Q := mul_le_mul_of_nonneg_right hM34 hQ0
    have k2 : M ^ 2 * Q ≤ M ^ 4 * Q := mul_le_mul_of_nonneg_right hM24 hQ0
    have k3 : M ^ 2 * g ^ 2 ≤ M ^ 4 * g ^ 2 := mul_le_mul_of_nonneg_right hM24 (sq_nonneg g)
    have k4 : 0 ≤ M ^ 4 * Q := mul_nonneg (by positivity) hQ0
    have k5 : 0 ≤ M ^ 4 * g ^ 2 := mul_nonneg (by positivity) (sq_nonneg g)
    have e : 150 * M ^ 4 * (Q + g ^ 2) = 150 * (M ^ 4 * Q) + 150 * (M ^ 4 * g ^ 2) := by ring
    linarith
  ·
    have hxi : ∀ i, x i ^ 2 ≤ ‖x‖ ^ 2 := fun i => by
      have h := norm_le_pi_norm x i
      rw [Real.norm_eq_abs] at h
      exact sq_le_sq' (abs_le.mp h).1 (abs_le.mp h).2
    have hR0 : 0 ≤ ‖x‖ ^ 2 := sq_nonneg _
    have hMR : ‖x‖ ^ 2 ≤ M ^ 2 * ‖x‖ ^ 2 := le_mul_of_one_le_left hR0 hM2

    have ha2 : a ^ 2 ≤ 27 * M ^ 2 * ‖x‖ ^ 2 := by
      have h := three (x 0) (σ * N2 * x 1) (-(σ * N1 * x 2))
      have hae : x 0 + σ * N2 * x 1 + -(σ * N1 * x 2) = a := by rw [ha]; ring
      rw [hae] at h
      have s1 : σ ^ 2 * N2 ^ 2 ≤ 4 * M ^ 2 * 1 := mul_le_mul hσ2 hN2sq (sq_nonneg _) (by positivity)
      have s2 : σ ^ 2 * N1 ^ 2 ≤ 4 * M ^ 2 * 1 := mul_le_mul hσ2 hN1sq (sq_nonneg _) (by positivity)
      have t1 : σ ^ 2 * N2 ^ 2 * x 1 ^ 2 ≤ 4 * M ^ 2 * 1 * ‖x‖ ^ 2 :=
        mul_le_mul s1 (hxi 1) (sq_nonneg _) (by positivity)
      have t2 : σ ^ 2 * N1 ^ 2 * x 2 ^ 2 ≤ 4 * M ^ 2 * 1 * ‖x‖ ^ 2 :=
        mul_le_mul s2 (hxi 2) (sq_nonneg _) (by positivity)
      have u1 : (σ * N2 * x 1) ^ 2 = σ ^ 2 * N2 ^ 2 * x 1 ^ 2 := by ring
      have u2 : (-(σ * N1 * x 2)) ^ 2 = σ ^ 2 * N1 ^ 2 * x 2 ^ 2 := by ring
      have t0 := hxi 0
      linarith
    have hSa : S * a ^ 2 ≤ M * (27 * M ^ 2 * ‖x‖ ^ 2) :=
      mul_le_mul hSle ha2 (sq_nonneg a) hM0.le

    have hb2 : b ^ 2 ≤ 4 * ‖x‖ ^ 2 := by
      have h := two (N1 * x 1) (N2 * x 2)
      rw [← hb, mul_pow, mul_pow] at h
      have t1 : N1 ^ 2 * x 1 ^ 2 ≤ 1 * ‖x‖ ^ 2 := mul_le_mul hN1sq (hxi 1) (sq_nonneg _) zero_le_one
      have t2 : N2 ^ 2 * x 2 ^ 2 ≤ 1 * ‖x‖ ^ 2 := mul_le_mul hN2sq (hxi 2) (sq_nonneg _) zero_le_one
