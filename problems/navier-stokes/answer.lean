  have hmul : ∀ (c1 c2 : ℝ) (f g : Cyl → ℝ), InM B (qsOf l0) c1 (nrm B (Aex B.h) f) →
      InM B (qsOf l0) c2 (nrm B (Aex B.h) g) →
      InM B (qsOf l0) (c1 + c2) (nrm B (Aex B.h + Aex B.h) (fun ξ => f ξ * g ξ)) :=
    fun c1 c2 f g hf1 hf2 =>
      inm_mul_nrm_v5 B (qsOf l0) c1 c2 (Aex B.h) (Aex B.h) f g hok hqs0 hqs1 hf1 hf2
  have hsh : ∀ (c e : ℝ) (f : Cyl → ℝ), InM B (qsOf l0) c (nrm B e f) →
