      rfl
    have hsξ : -(ξ.1 ^ e)⁻¹ * (∫ s in (0:ℝ)..ξ.1, s ^ e *
        (FE5 B G l0 S e (s, ξ.2.1, ξ.2.2.1, 0) - bE B e (s, ξ.2.1, ξ.2.2.1, 0) *
          ∫ s' in Ioi (0:ℝ), s' ^ e * FE5 B G l0 S e (s', ξ.2.1, ξ.2.2.1, 0))) =
        sigE5 B G l0 S e ξ := by
      rw [hsigEq]
    have hdR : dR B.h (sigE5 B G l0 S e) ξ = -((e : ℝ) / ξ.1) * sigE5 B G l0 S e ξ -
        FE5 B G l0 S e ξ + bE B e ξ * ME5 B G l0 S e ξ.2.1 ξ.2.2.1 := by
      rw [← hsξ, ← hFξ, ← hbξ, hME, hsigEq]
      exact hd
    rw [hdR]
    ring

theorem stp5_edge_mono : ∀ (Xa Xb aa ab d : ℝ), 0 < Xa → Xa < Xb → 0 < aa → 0 < ab → 0 ≤ d → ∃ C : ℝ, 0 < C ∧ (∀ X X' : ℝ, ((Xa < X' ∧ X' ≤ X ∧ X ≤ Real.sqrt (Xa * Xb)) ∨ (Real.sqrt (Xa * Xb) ≤ X ∧ X ≤ X' ∧ X' < Xb)) → edgeWeight Xa Xb aa ab X' * edgeDist Xa Xb X' ^ (-d) ≤ C * (edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-d))) ∧ (∀ X : ℝ, Xa < X → X < Xb → edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-d) ≤ C) :=
by
  intro Xa Xb aa ab d hXa hXab haa hab hd

  have kap0 : ∀ a : ℝ, 0 < a → 0 ≤ d / 2 * Real.log (1 + d / (2 * a)) := by
    intro a ha
    have : 0 ≤ d / (2 * a) := by positivity
    exact mul_nonneg (by linarith) (Real.log_nonneg (by linarith))

  have core : ∀ a u' u : ℝ, 0 < a → 0 < u' → u' ≤ u → u ≤ 1 →
      -(a / u' ^ 2) - d * Real.log u' ≤
        d / 2 * Real.log (1 + d / (2 * a)) - a / u ^ 2 - d * Real.log u := by
    intro a u' u ha hu' huu hu1
    have hu : 0 < u := lt_of_lt_of_le hu' huu
    obtain ⟨l, hl⟩ : ∃ l : ℝ, l = 1 + d / (2 * a) := ⟨_, rfl⟩
    rw [← hl]
    have hl1 : 1 ≤ l := by
      have : 0 ≤ d / (2 * a) := by positivity
      linarith
    have hlpos : 0 < l := by linarith
    have hdl : d / 2 = a * (l - 1) := by rw [hl]; field_simp; ring
    obtain ⟨k, hk⟩ : ∃ k : ℝ, k = u ^ 2 / (u' ^ 2 * l) := ⟨_, rfl⟩
    have hkpos : 0 < k := by rw [hk]; positivity
    have hlogk : Real.log k = 2 * Real.log u - 2 * Real.log u' - Real.log l := by
      rw [hk, Real.log_div (by positivity) (by positivity),
        Real.log_mul (by positivity) (by positivity), Real.log_pow, Real.log_pow]
      push_cast; ring
    have hlk := Real.log_le_sub_one_of_pos hkpos
    have hkl : k * l = u ^ 2 / u' ^ 2 := by rw [hk]; field_simp
    have hkl1 : 1 ≤ k * l := by
      rw [hkl, one_le_div (by positivity)]
      exact pow_le_pow_left₀ hu'.le huu 2
    have hsum : 2 ≤ l + k := by
      by_contra hc
      push_neg at hc
      nlinarith [sq_nonneg (l - 1), mul_lt_mul_of_pos_left hc hlpos]
    have hprod : (l - 1) * (k - 1) ≤ k * l - 1 := by nlinarith
    have hQ : 1 ≤ 1 / u ^ 2 := by
      rw [one_le_div (by positivity)]
      nlinarith
    have hdiff : a / u' ^ 2 - a / u ^ 2 = a * (1 / u ^ 2) * (k * l - 1) := by
      rw [hkl]; field_simp
    have h1 : a * (k * l - 1) ≤ a / u' ^ 2 - a / u ^ 2 := by
      rw [hdiff]
      have h0 : 0 ≤ a * (k * l - 1) := mul_nonneg ha.le (by linarith)
      nlinarith [mul_le_mul_of_nonneg_left hQ h0]
    have h2 : d / 2 * Real.log k ≤ d / 2 * (k - 1) :=
      mul_le_mul_of_nonneg_left hlk (by linarith)
    have h3 : d / 2 * (k - 1) ≤ a * (k * l - 1) := by
      rw [hdl]
      nlinarith [mul_le_mul_of_nonneg_left hprod ha.le]
    rw [hlogk] at h2
    nlinarith

  have T1 : ∀ a u' u : ℝ, 0 < a → 0 < u' → u' ≤ u →
      -(a / u' ^ 2) - d * Real.log (min 1 u') ≤
        d / 2 * Real.log (1 + d / (2 * a)) + (-(a / u ^ 2) - d * Real.log (min 1 u)) := by
    intro a u' u ha hu' huu
    have hk0 := kap0 a ha
    rcases le_or_gt u 1 with hu1 | hu1
    · rw [min_eq_right hu1, min_eq_right (huu.trans hu1)]
      have := core a u' u ha hu' huu hu1
      linarith
    · rw [min_eq_left hu1.le, Real.log_one, mul_zero, sub_zero]
      rcases le_or_gt u' 1 with hu'1 | hu'1
      · rw [min_eq_right hu'1]
        have := core a u' 1 ha hu' hu'1 le_rfl
        rw [Real.log_one, mul_zero, sub_zero, one_pow, div_one] at this
        have h2 : a / u ^ 2 ≤ a := div_le_self ha.le (by nlinarith)
        linarith
      · rw [min_eq_left hu'1.le, Real.log_one, mul_zero, sub_zero]
        have h2 : a / u ^ 2 ≤ a / u' ^ 2 :=
          div_le_div_of_nonneg_left ha.le (by positivity) (pow_le_pow_left₀ hu'.le huu 2)
        linarith
  have T2 : ∀ a u : ℝ, 0 < a → 0 < u →
      -(a / u ^ 2) - d * Real.log (min 1 u) ≤ d / 2 * Real.log (1 + d / (2 * a)) := by
    intro a u ha hu
    have hk0 := kap0 a ha
    rcases le_or_gt u 1 with hu1 | hu1
    · rw [min_eq_right hu1]
      have := core a u 1 ha hu hu1 le_rfl
      rw [Real.log_one, mul_zero, sub_zero, one_pow, div_one] at this
      linarith
    · rw [min_eq_left hu1.le, Real.log_one, mul_zero, sub_zero]
      have : 0 ≤ a / u ^ 2 := by positivity
      linarith

  have half : ∀ a b u' v' u v L : ℝ, 0 < a → 0 < b → 0 < u' → u' ≤ u → u ≤ v → u' ≤ v' →
      0 < L → L / 2 ≤ v →
      -(a / u' ^ 2) - b / v' ^ 2 - d * Real.log (min 1 (min u' v')) ≤
        d / 2 * Real.log (1 + d / (2 * a)) + 4 * b / L ^ 2 +
          (-(a / u ^ 2) - b / v ^ 2 - d * Real.log (min 1 (min u v))) := by
    intro a b u' v' u v L ha hb hu' huu huv hu'v' hL hLv
    rw [min_eq_left huv, min_eq_left hu'v']
    have h1 := T1 a u' u ha hu' huu
    have h2 : 0 ≤ b / v' ^ 2 := by positivity
    have hv : 0 < v := by linarith
    have h3 : b / v ^ 2 ≤ 4 * b / L ^ 2 := by
      rw [div_le_div_iff₀ (by positivity) (by positivity)]
      have hsq : L ^ 2 ≤ (2 * v) ^ 2 := pow_le_pow_left₀ hL.le (by linarith) 2
      nlinarith [mul_le_mul_of_nonneg_left hsq hb.le]
    linarith
  have bnd : ∀ a b u v : ℝ, 0 < a → 0 ≤ b → 0 < u → u ≤ v →
      -(a / u ^ 2) - b / v ^ 2 - d * Real.log (min 1 (min u v)) ≤
        d / 2 * Real.log (1 + d / (2 * a)) := by
    intro a b u v ha hb hu huv
    rw [min_eq_left huv]
    have := T2 a u ha hu
    have h2 : 0 ≤ b / v ^ 2 := div_nonneg hb (sq_nonneg v)
    linarith

  have repr : ∀ X : ℝ, Xa < X → X < Xb →
      edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-d) =
        Real.exp (-(aa / Real.log (X / Xa) ^ 2) - ab / Real.log (Xb / X) ^ 2 -
          d * Real.log (min 1 (min (Real.log (X / Xa)) (Real.log (Xb / X))))) := by
    intro X h1 h2
    have hX : 0 < X := hXa.trans h1
    have hu : 0 < Real.log (X / Xa) := Real.log_pos ((one_lt_div hXa).mpr h1)
    have hv : 0 < Real.log (Xb / X) := Real.log_pos ((one_lt_div hX).mpr h2)
    have hδ : 0 < edgeDist Xa Xb X := lt_min one_pos (lt_min hu hv)
    unfold edgeWeight
    rw [if_pos ⟨h1, h2⟩, Real.rpow_def_of_pos hδ, ← Real.exp_add]
    unfold edgeDist
    congr 1
    ring

  have hXb : 0 < Xb := hXa.trans hXab
  have hab_log : Real.log Xa < Real.log Xb := Real.log_lt_log hXa hXab
  have hu_eq : ∀ X : ℝ, 0 < X → Real.log (X / Xa) = Real.log X - Real.log Xa :=
    fun X hX => Real.log_div hX.ne' hXa.ne'
  have hv_eq : ∀ X : ℝ, 0 < X → Real.log (Xb / X) = Real.log Xb - Real.log X :=
    fun X hX => Real.log_div hXb.ne' hX.ne'
  obtain ⟨L, hLdef⟩ : ∃ L : ℝ, L = Real.log (Xb / Xa) := ⟨_, rfl⟩
  have hL_eq : L = Real.log Xb - Real.log Xa := by rw [hLdef]; exact Real.log_div hXb.ne' hXa.ne'
  have hL : 0 < L := by rw [hL_eq]; linarith
  have hm : Real.log (Real.sqrt (Xa * Xb)) = (Real.log Xa + Real.log Xb) / 2 := by
    rw [Real.log_sqrt (by positivity), Real.log_mul hXa.ne' hXb.ne']
  have hsq_pos : 0 < Real.sqrt (Xa * Xb) := Real.sqrt_pos.mpr (by positivity)
  have kA := kap0 aa haa
  have kB := kap0 ab hab
  have h4a : 0 ≤ 4 * aa / L ^ 2 := by positivity
  have h4b : 0 ≤ 4 * ab / L ^ 2 := by positivity

  refine ⟨Real.exp (d / 2 * Real.log (1 + d / (2 * aa)) + d / 2 * Real.log (1 + d / (2 * ab)) +
    4 * aa / L ^ 2 + 4 * ab / L ^ 2), Real.exp_pos _, ?_, ?_⟩
  · rintro X X' (⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩)
    · have hX' : 0 < X' := hXa.trans h1
      have hX : 0 < X := lt_of_lt_of_le hX' h2
      have l1 : Real.log X' ≤ Real.log X := Real.log_le_log hX' h2
      have l2 : Real.log X ≤ Real.log (Real.sqrt (Xa * Xb)) := Real.log_le_log hX h3
      have hXXb : X < Xb := by
        by_contra hc
        push_neg at hc
        have := Real.log_le_log hXb hc
        linarith
      rw [repr X' h1 (lt_of_le_of_lt h2 hXXb), repr X (lt_of_lt_of_le h1 h2) hXXb,
        ← Real.exp_add, Real.exp_le_exp]
      have key := half aa ab (Real.log (X' / Xa)) (Real.log (Xb / X')) (Real.log (X / Xa))
        (Real.log (Xb / X)) L haa hab (by rw [hu_eq X' hX']; linarith [Real.log_lt_log hXa h1])
        (by rw [hu_eq X' hX', hu_eq X hX]; linarith)
        (by rw [hu_eq X hX, hv_eq X hX]; linarith)
        (by rw [hu_eq X' hX', hv_eq X' hX']; linarith)
        hL (by rw [hv_eq X hX, hL_eq]; linarith)
      linarith
    · have hX : 0 < X := lt_of_lt_of_le hsq_pos h1
      have hX' : 0 < X' := lt_of_lt_of_le hX h2
      have l1 : Real.log X ≤ Real.log X' := Real.log_le_log hX h2
      have l2 : Real.log (Real.sqrt (Xa * Xb)) ≤ Real.log X := Real.log_le_log hsq_pos h1
      have hXaX : Xa < X := by
        by_contra hc
        push_neg at hc
        have := Real.log_le_log hX hc
        linarith
      rw [repr X' (lt_of_lt_of_le hXaX h2) h3, repr X hXaX (lt_of_le_of_lt h2 h3),
        ← Real.exp_add, Real.exp_le_exp]
      have key := half ab aa (Real.log (Xb / X')) (Real.log (X' / Xa)) (Real.log (Xb / X))
        (Real.log (X / Xa)) L hab haa (by rw [hv_eq X' hX']; linarith [Real.log_lt_log hX' h3])
        (by rw [hv_eq X' hX', hv_eq X hX]; linarith)
        (by rw [hu_eq X hX, hv_eq X hX]; linarith)
        (by rw [hu_eq X' hX', hv_eq X' hX']; linarith)
        hL (by rw [hu_eq X hX, hL_eq]; linarith)
      rw [min_comm (Real.log (Xb / X')), min_comm (Real.log (Xb / X))] at key
      linarith
  · intro X h1 h2
    have hX : 0 < X := hXa.trans h1
    rw [repr X h1 h2, Real.exp_le_exp]
    have hu : 0 < Real.log (X / Xa) := Real.log_pos ((one_lt_div hXa).mpr h1)
    have hv : 0 < Real.log (Xb / X) := Real.log_pos ((one_lt_div hX).mpr h2)
    rcases le_total (Real.log (X / Xa)) (Real.log (Xb / X)) with huv | huv
    · have := bnd aa ab _ _ haa hab.le hu huv
      linarith
    · have := bnd ab aa _ _ hab haa.le hv huv
      rw [min_comm (Real.log (Xb / X))] at this
      linarith

theorem stp5sc_sig_rep : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (α : ℝ) (e : ℕ), B.ok → (e = 1 ∨ e = 2) →
    InM B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) →
    (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → sigE5 B G l0 S e ξ = 0) →
    ∀ ξ ∈ DomC B.h (qsOf l0), Real.sqrt B.Xa < sgc5rho B.h ξ → sgc5rho B.h ξ < 2 * Real.sqrt (2 * B.Xb) →
    nrm B (2 * Aex B.h) (sigE5 B G l0 S e) ξ = sgc5rho B.h ξ *
        (sgc5beta B e (sgc5rho B.h ξ) * sgc5I (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) e (sgc5c0 B) (sgc5U0 B) ξ
          - sgc5I (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) e (sgc5c0 B) 1 ξ) ∧
    nrm B (2 * Aex B.h) (sigE5 B G l0 S e) ξ = sgc5rho B.h ξ *
        (sgc5I (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) e 1 (sgc5U0 B) ξ
          - sgc5betaR B e (sgc5U0 B) (sgc5rho B.h ξ) *
            sgc5I (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) e (sgc5c0 B) (sgc5U0 B) ξ) :=
by
  have core : ∀ (e : ℕ) (q r Xa Xb A a M c0 U0 rho : ℝ) (F Ft bEf bH : ℝ → ℝ),
      0 < q → 0 < r → 0 < Xa → Xa < Xb →
      rho = r / Real.sqrt q → Real.sqrt Xa < rho → rho < 2 * Real.sqrt (2 * Xb) →
      c0 = Real.sqrt (Xa / Xb) / 4 → U0 = 2 * Real.sqrt (Xb / Xa) →
      a = A + 1/2 →
      (∀ s, Ft s = q ^ a * F s) →
      ContinuousOn Ft (Ioi 0) →
      (∀ s, 0 < s → (s ^ 2 / (2 * q) ≤ Xa ∨ Xb ≤ s ^ 2 / (2 * q)) → Ft s = 0) →
      Continuous bH →
      (∀ s, bEf s = q ^ (-(((e:ℝ) + 1) / 2)) * bH (s / Real.sqrt q)) →
      M = (∫ s in Ioi (0:ℝ), s ^ e * F s) →
      (Xb ≤ (U0 * r) ^ 2 / (2 * q) →
        -((U0 * r) ^ e)⁻¹ * (∫ s in (0:ℝ)..(U0 * r), s ^ e * (F s - bEf s * M)) = 0) →
      q ^ A * (-(r ^ e)⁻¹ * ∫ s in (0:ℝ)..r, s ^ e * (F s - bEf s * M)) =
        rho * ((∫ s in (0:ℝ)..rho, s ^ e * bH s) * (∫ u in c0..U0, u ^ e * Ft (u * r)) -
          ∫ u in c0..1, u ^ e * Ft (u * r)) ∧
      q ^ A * (-(r ^ e)⁻¹ * ∫ s in (0:ℝ)..r, s ^ e * (F s - bEf s * M)) =
        rho * ((∫ u in (1:ℝ)..U0, u ^ e * Ft (u * r)) -
          (∫ s in rho..(U0 * rho), s ^ e * bH s) * ∫ u in c0..U0, u ^ e * Ft (u * r)) := by
    intro e q r Xa Xb A a M c0 U0 rho F Ft bEf bH hq hr hXa hXab hrho hlo hhi hc0 hU0 ha hFt hFtc
      hsupp hbH hbE hM hsh
    have hsq : 0 < Real.sqrt q := Real.sqrt_pos.mpr hq
    have hsqne : Real.sqrt q ≠ 0 := hsq.ne'
    have hsq2 : Real.sqrt q ^ 2 = q := Real.sq_sqrt hq.le
    have hrho0 : 0 < rho := by rw [hrho]; exact div_pos hr hsq
    have hrq : r = rho * Real.sqrt q := by rw [hrho]; field_simp
    have hr2 : r ^ 2 = rho ^ 2 * q := by rw [hrq, mul_pow, hsq2]
    have hXb : 0 < Xb := by linarith
    have hρlo : Xa < rho ^ 2 := Real.lt_sq_of_sqrt_lt hlo
    have hρhi : rho ^ 2 < 8 * Xb := by
      have h1 := pow_lt_pow_left₀ hhi hrho0.le (two_ne_zero)
      have h2 : (2 * Real.sqrt (2 * Xb)) ^ 2 = 8 * Xb := by
        rw [mul_pow, Real.sq_sqrt (by linarith)]; ring
      linarith
    have hratio : 0 < Xa / Xb := div_pos hXa hXb
    have hratio' : 0 < Xb / Xa := div_pos hXb hXa
    have hc0pos : 0 < c0 := by rw [hc0]; exact div_pos (Real.sqrt_pos.mpr hratio) (by norm_num)
    have hc0sq : c0 ^ 2 * Xb = Xa / 16 := by
      rw [hc0, div_pow, Real.sq_sqrt hratio.le]; field_simp; ring
    have hc01 : c0 ≤ 1 := by
      have h1 : Xa / Xb ≤ 1 := (div_le_one hXb).mpr hXab.le
      have h2 := Real.sqrt_le_sqrt h1
      rw [Real.sqrt_one] at h2
      rw [hc0]; linarith
    have hU0pos : 0 < U0 := by rw [hU0]; exact mul_pos two_pos (Real.sqrt_pos.mpr hratio')
    have hU0sq : U0 ^ 2 * Xa = 4 * Xb := by
      rw [hU0, mul_pow, Real.sq_sqrt hratio'.le]; field_simp; ring
    have h1U0 : 1 ≤ U0 := by
      have h1 : 1 ≤ Xb / Xa := (one_le_div hXa).mpr hXab.le
      have h2 := Real.sqrt_le_sqrt h1
      rw [Real.sqrt_one] at h2
      rw [hU0]; linarith
    have hc0U0 : c0 ≤ U0 := le_trans hc01 h1U0
    have hc0r : 0 < c0 * r := mul_pos hc0pos hr
    have hU0r : 0 < U0 * r := mul_pos hU0pos hr
    have hsuppL : ∀ s, 0 < s → s ≤ c0 * r → Ft s = 0 := by
      intro s hs hsr
      have h1 : s ^ 2 ≤ (c0 * r) ^ 2 := pow_le_pow_left₀ hs.le hsr 2
      have h2 : (c0 * r) ^ 2 = c0 ^ 2 * rho ^ 2 * q := by rw [mul_pow, hr2]; ring
      have h3 : c0 ^ 2 * rho ^ 2 * q ≤ c0 ^ 2 * (8 * Xb) * q :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hρhi.le (sq_nonneg c0)) hq.le
      have h4 : c0 ^ 2 * (8 * Xb) * q = Xa / 2 * q := by
        rw [show c0 ^ 2 * (8 * Xb) * q = 8 * (c0 ^ 2 * Xb) * q by ring, hc0sq]; ring
      have h5 : 0 < Xa * q := mul_pos hXa hq
      exact hsupp s hs (Or.inl ((div_le_iff₀ (by positivity)).mpr (by linarith)))
    have hsuppR : ∀ s, U0 * r ≤ s → Ft s = 0 := by
      intro s hs
      have hs0 : 0 < s := lt_of_lt_of_le hU0r hs
      have h1 : (U0 * r) ^ 2 ≤ s ^ 2 := pow_le_pow_left₀ hU0r.le hs 2
      have h2 : (U0 * r) ^ 2 = U0 ^ 2 * rho ^ 2 * q := by rw [mul_pow, hr2]; ring
      have h3 : U0 ^ 2 * Xa * q ≤ U0 ^ 2 * rho ^ 2 * q :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hρlo.le (sq_nonneg U0)) hq.le
      have h4 : U0 ^ 2 * Xa * q = 4 * Xb * q := by rw [hU0sq]
      have h5 : 0 < Xb * q := mul_pos hXb hq
      exact hsupp s hs0 (Or.inr ((le_div_iff₀ (by positivity)).mpr (by linarith)))
    have hFE : ∀ s, F s = q ^ (-a) * Ft s := by
      intro s
      rw [hFt s, ← mul_assoc, ← Real.rpow_add hq, neg_add_cancel, Real.rpow_zero, one_mul]
    have hmr : ContinuousOn (fun u : ℝ => u * r) (Ioi 0) := by fun_prop
    have hφc : ContinuousOn (fun u : ℝ => u ^ e * Ft (u * r)) (Ioi 0) :=
      (continuousOn_pow e).mul (hFtc.comp hmr (fun u hu => mul_pos hu hr))
    have hψc : Continuous (fun s : ℝ => s ^ e * bH s) := (continuous_pow e).mul hbH
    have hbEc : Continuous (fun s : ℝ => s ^ e * bEf s) := by
      have hfun : (fun s : ℝ => s ^ e * bEf s) =
          fun s => s ^ e * (q ^ (-(((e:ℝ) + 1) / 2)) * bH (s / Real.sqrt q)) := by
        funext s; rw [hbE s]
      rw [hfun]
      exact (continuous_pow e).mul (continuous_const.mul (hbH.comp (continuous_id.div_const _)))
    have hSub : ∀ v, (∫ s in (c0 * r)..(v * r), s ^ e * Ft s) =
        r ^ (e + 1) * ∫ u in c0..v, u ^ e * Ft (u * r) := by
      intro v
      have h1 : (∫ x in c0..v, (x * r) ^ e * Ft (x * r)) =
          r⁻¹ * ∫ s in (c0 * r)..(v * r), s ^ e * Ft s :=
        intervalIntegral.integral_comp_mul_right (fun s => s ^ e * Ft s) hr.ne'
      have h2 : (∫ x in c0..v, (x * r) ^ e * Ft (x * r)) =
          r ^ e * ∫ u in c0..v, u ^ e * Ft (u * r) := by
        rw [← intervalIntegral.integral_const_mul]
        congr 1
        funext u
        rw [mul_pow]; ring
      rw [h2] at h1
      calc (∫ s in (c0 * r)..(v * r), s ^ e * Ft s)
          = r * (r⁻¹ * ∫ s in (c0 * r)..(v * r), s ^ e * Ft s) := by field_simp
        _ = r * (r ^ e * ∫ u in c0..v, u ^ e * Ft (u * r)) := by rw [← h1]
        _ = r ^ (e + 1) * ∫ u in c0..v, u ^ e * Ft (u * r) := by ring
    have h0L : (∫ s in (0:ℝ)..(c0 * r), s ^ e * Ft s) = 0 := by
      rw [intervalIntegral.integral_of_le hc0r.le]
      rw [setIntegral_congr_fun measurableSet_Ioc (g := fun _ => (0:ℝ)) ?_]
      · simp
      · intro s hs
        simp [hsuppL s hs.1 hs.2]
    have int1 : IntervalIntegrable (fun s => s ^ e * Ft s) volume 0 (c0 * r) := by
      rw [intervalIntegrable_iff, uIoc_of_le hc0r.le]
      refine (integrableOn_zero).congr_fun (fun s hs => ?_) measurableSet_Ioc
      simp [hsuppL s hs.1 hs.2]
    have hA : ∀ v, c0 ≤ v → IntervalIntegrable (fun s => s ^ e * Ft s) volume 0 (v * r) ∧
        (∫ s in (0:ℝ)..(v * r), s ^ e * Ft s) = r ^ (e + 1) * ∫ u in c0..v, u ^ e * Ft (u * r) := by
      intro v hv
      have hle : c0 * r ≤ v * r := mul_le_mul_of_nonneg_right hv hr.le
      have int2 : IntervalIntegrable (fun s => s ^ e * Ft s) volume (c0 * r) (v * r) := by
        apply ContinuousOn.intervalIntegrable
        apply ((continuousOn_pow e).mul hFtc).mono
        rw [uIcc_of_le hle]
        exact fun x hx => lt_of_lt_of_le hc0r hx.1
      refine ⟨int1.trans int2, ?_⟩
      rw [← intervalIntegral.integral_add_adjacent_intervals int1 int2, h0L, zero_add, hSub v]
    have hMeq : M = q ^ (-a) * (r ^ (e + 1) * ∫ u in c0..U0, u ^ e * Ft (u * r)) := by
      rw [hM]
      have hfun : (fun s : ℝ => s ^ e * F s) = fun s => q ^ (-a) * (s ^ e * Ft s) := by
        funext s; rw [hFE s]; ring
      rw [hfun, integral_const_mul]
      congr 1
      rw [← hSub U0, intervalIntegral.integral_of_le (mul_le_mul_of_nonneg_right hc0U0 hr.le)]
      apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi
      · exact fun x hx => lt_trans hc0r hx.1
      · intro x hx
        have hx0 : 0 < x := hx.1
        rcases le_or_gt x (c0 * r) with h | h
        · simp [hsuppL x hx0 h]
        · have h' : U0 * r ≤ x := by
            by_contra h'
            exact hx.2 ⟨h, (not_le.mp h').le⟩
          simp [hsuppR x h']
    have hκ : q ^ (-(((e:ℝ) + 1) / 2)) * Real.sqrt q ^ e * Real.sqrt q = 1 := by
      have h1 : Real.sqrt q ^ e * Real.sqrt q = q ^ (((e:ℝ) + 1) / 2) := by
        rw [← pow_succ, Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hq.le]
        congr 1
        push_cast
        ring
      rw [mul_assoc, h1, ← Real.rpow_add hq, neg_add_cancel, Real.rpow_zero]
    have hbeta : ∀ v, (∫ s in (0:ℝ)..(v * r), s ^ e * bEf s) =
        ∫ s in (0:ℝ)..(v * rho), s ^ e * bH s := by
      intro v
      have hpt : (fun s : ℝ => s ^ e * bEf s) =
          fun s => (q ^ (-(((e:ℝ) + 1) / 2)) * Real.sqrt q ^ e) *
            ((s / Real.sqrt q) ^ e * bH (s / Real.sqrt q)) := by
        funext s
        have hs : s ^ e = (s / Real.sqrt q) ^ e * Real.sqrt q ^ e := by
          rw [← mul_pow, div_mul_cancel₀ _ hsqne]
        rw [hbE s, hs]
        ring
      rw [hpt, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_comp_div (fun x => x ^ e * bH x) hsqne, zero_div, smul_eq_mul,
        ← mul_assoc, hκ, one_mul]
      congr 1
      rw [hrho]; ring
    have hT : ∀ v, c0 ≤ v → (∫ s in (0:ℝ)..(v * r), s ^ e * (F s - bEf s * M)) =
        q ^ (-a) * r ^ (e + 1) * ((∫ u in c0..v, u ^ e * Ft (u * r)) -
          (∫ u in c0..U0, u ^ e * Ft (u * r)) * ∫ s in (0:ℝ)..(v * rho), s ^ e * bH s) := by
      intro v hv
      have hfun : (fun s : ℝ => s ^ e * (F s - bEf s * M)) =
          fun s => q ^ (-a) * (s ^ e * Ft s) - M * (s ^ e * bEf s) := by
        funext s; rw [hFE s]; ring
      have i1 : IntervalIntegrable (fun s : ℝ => q ^ (-a) * (s ^ e * Ft s)) volume 0 (v * r) :=
        (hA v hv).1.const_mul _
      have i2 : IntervalIntegrable (fun s : ℝ => M * (s ^ e * bEf s)) volume 0 (v * r) :=
        (hbEc.intervalIntegrable _ _).const_mul _
      rw [hfun, intervalIntegral.integral_sub i1 i2, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul, (hA v hv).2, hbeta v, hMeq]
      ring
    have hL : q ^ A * (-(r ^ e)⁻¹ * ∫ s in (0:ℝ)..r, s ^ e * (F s - bEf s * M)) =
        rho * ((∫ s in (0:ℝ)..rho, s ^ e * bH s) * (∫ u in c0..U0, u ^ e * Ft (u * r)) -
          ∫ u in c0..1, u ^ e * Ft (u * r)) := by
      have h1 := hT 1 hc01
      simp only [one_mul] at h1
      rw [h1]
      have hP : q ^ A * q ^ (-a) = (Real.sqrt q)⁻¹ := by
        rw [← Real.rpow_add hq, show A + -a = -(1/2 : ℝ) by rw [ha]; ring, Real.rpow_neg hq.le,
          ← Real.sqrt_eq_rpow]
      have hr' : (r ^ e)⁻¹ * r ^ (e + 1) = r := by
        rw [pow_succ]; field_simp
      have hρ' : (Real.sqrt q)⁻¹ * r = rho := by rw [hrho]; ring
      set X := (∫ u in c0..1, u ^ e * Ft (u * r)) -
          (∫ u in c0..U0, u ^ e * Ft (u * r)) * ∫ s in (0:ℝ)..rho, s ^ e * bH s with hX
      calc q ^ A * (-(r ^ e)⁻¹ * (q ^ (-a) * r ^ (e + 1) * X))
          = -(q ^ A * q ^ (-a)) * ((r ^ e)⁻¹ * r ^ (e + 1)) * X := by ring
        _ = -(Real.sqrt q)⁻¹ * r * X := by rw [hP, hr']
        _ = _ := by rw [hX]; linear_combination (-X) * hρ'
    refine ⟨hL, ?_⟩
    have hXC : Xb ≤ (U0 * r) ^ 2 / (2 * q) := by
      have h2 : (U0 * r) ^ 2 = U0 ^ 2 * rho ^ 2 * q := by rw [mul_pow, hr2]; ring
      have h3 : U0 ^ 2 * Xa * q ≤ U0 ^ 2 * rho ^ 2 * q :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hρlo.le (sq_nonneg U0)) hq.le
      have h4 : U0 ^ 2 * Xa * q = 4 * Xb * q := by rw [hU0sq]
      have h5 : 0 < Xb * q := mul_pos hXb hq
      exact (le_div_iff₀ (by positivity)).mpr (by linarith)
    have hne : -((U0 * r) ^ e)⁻¹ ≠ 0 := neg_ne_zero.mpr (inv_ne_zero (pow_ne_zero _ hU0r.ne'))
    have hint := (mul_eq_zero.mp (hsh hXC)).resolve_left hne
    rw [hT U0 hc0U0] at hint
    have hz := (mul_eq_zero.mp hint).resolve_left
      (mul_pos (Real.rpow_pos_of_pos hq _) (pow_pos hr _)).ne'
    have hi1 : IntervalIntegrable (fun u : ℝ => u ^ e * Ft (u * r)) volume c0 1 := by
      apply ContinuousOn.intervalIntegrable
      apply hφc.mono
      rw [uIcc_of_le hc01]
      exact fun x hx => lt_of_lt_of_le hc0pos hx.1
    have hi2 : IntervalIntegrable (fun u : ℝ => u ^ e * Ft (u * r)) volume 1 U0 := by
      apply ContinuousOn.intervalIntegrable
      apply hφc.mono
      rw [uIcc_of_le h1U0]
      exact fun x hx => lt_of_lt_of_le one_pos hx.1
    have hadd1 : (∫ u in c0..1, u ^ e * Ft (u * r)) + (∫ u in (1:ℝ)..U0, u ^ e * Ft (u * r)) =
        ∫ u in c0..U0, u ^ e * Ft (u * r) :=
      intervalIntegral.integral_add_adjacent_intervals hi1 hi2
    have hadd2 : (∫ s in (0:ℝ)..rho, s ^ e * bH s) + (∫ s in rho..(U0 * rho), s ^ e * bH s) =
        ∫ s in (0:ℝ)..(U0 * rho), s ^ e * bH s :=
      intervalIntegral.integral_add_adjacent_intervals
        (hψc.intervalIntegrable 0 rho) (hψc.intervalIntegrable rho (U0 * rho))
    linear_combination hL - rho * hadd1 + rho * (∫ u in c0..U0, u ^ e * Ft (u * r)) * hadd2 -
      rho * hz
  intro B G l0 S α e hB he hFt hsh ξ hξ hlo hhi
  obtain ⟨r, z, t, Y⟩ := ξ
  obtain ⟨hh0, hh1, hXa, hXam1, hm12, hm2Xb, -, hqB0, -, -, -, haa, hab⟩ := hB.2.1
  have hXab : B.Xa < B.Xb := by linarith
  have hr : 0 < r := hξ.1
  have ht : t < 1 := hξ.2.1
  have hqlt : qC B.h ((r, z, t, Y) : Cyl) < qsOf l0 := hξ.2.2
  have hq : 0 < qC B.h ((r, z, t, Y) : Cyl) := (hB.1.1 z (1 - t) (by linarith)).1
  have hdom : ∀ s : ℝ, 0 < s → ((s, z, t, (0 : ℝ × ℝ)) : Cyl) ∈ DomC B.h (qsOf l0) :=
    fun s hs => (show 0 < s ∧ t < 1 ∧ qC B.h ((s, z, t, (0 : ℝ × ℝ)) : Cyl) < qsOf l0 from
      ⟨hs, ht, hqlt⟩)
  have hbH : Continuous (bHatE B e) := by
    have hst : Continuous Real.smoothTransition := Real.smoothTransition.continuous
    have h1 : Continuous (fun s => rhoHat B s) := by
      unfold rhoHat bumpR
      exact (hst.comp' (by fun_prop)).div_const _
    exact h1.div_const _
  have hU0pos : 0 < sgc5U0 B :=
    (show 0 < 2 * Real.sqrt (B.Xb / B.Xa) from
      mul_pos two_pos (Real.sqrt_pos.mpr (div_pos (by linarith) hXa)))
  have hsigEq : sigE5 B G l0 S e = fun ξ : Cyl => -(ξ.1 ^ e)⁻¹ * ∫ r' in (0:ℝ)..ξ.1, r' ^ e *
      (FE5 B G l0 S e (r', ξ.2.1, ξ.2.2.1, (0 : ℝ × ℝ)) -
        bE B e (r', ξ.2.1, ξ.2.2.1, (0 : ℝ × ℝ)) * ME5 B G l0 S e ξ.2.1 ξ.2.2.1) := by
    funext ξ
    rfl
  have hME : ∀ z' t' : ℝ, ME5 B G l0 S e z' t' =
      ∫ s in Set.Ioi (0:ℝ), s ^ e * FE5 B G l0 S e (s, z', t', (0 : ℝ × ℝ)) := fun _ _ => rfl
  rw [hsigEq] at hsh ⊢
  simp only [hME] at hsh ⊢
  generalize FE5 B G l0 S e = FE at hFt hsh ⊢
  have hFtc : ContinuousOn (fun s : ℝ => nrm B (2 * Aex B.h + 1/2) FE ((s, z, t, (0 : ℝ × ℝ)) : Cyl))
      (Ioi 0) := by
    have := hFt.1.continuousOn.comp
      (by fun_prop : Continuous fun s : ℝ => ((s, z, t, (0 : ℝ × ℝ)) : Cyl)).continuousOn
      (fun s hs => hdom s hs)
    exact this
  exact core e (qC B.h ((r, z, t, Y) : Cyl)) r B.Xa B.Xb (2 * Aex B.h) (2 * Aex B.h + 1/2)
    (∫ s in Ioi (0:ℝ), s ^ e * FE ((s, z, t, (0 : ℝ × ℝ)) : Cyl)) (sgc5c0 B) (sgc5U0 B)
    (sgc5rho B.h ((r, z, t, Y) : Cyl))
    (fun s => FE ((s, z, t, (0 : ℝ × ℝ)) : Cyl))
    (fun s => nrm B (2 * Aex B.h + 1/2) FE ((s, z, t, (0 : ℝ × ℝ)) : Cyl))
    (fun s => bE B e ((s, z, t, (0 : ℝ × ℝ)) : Cyl)) (bHatE B e)
    hq hr hXa hXab rfl hlo hhi rfl rfl rfl (fun s => rfl) hFtc
    (fun s hs hX => hFt.2.2.1 _ (hdom s hs) hX) hbH (fun s => rfl) rfl
    (fun hX => hsh _ (hdom (sgc5U0 B * r) (mul_pos hU0pos hr)) (Or.inr hX))

theorem stp5sc_cyl_reduce : ∀ (h : ℝ) (f : Cyl → ℝ) (U : Set Cyl) (ξ0 : Cyl) (k : ℕ), IsOpen U → ξ0 ∈ U →
    ContDiffOn ℝ ∞ f U → (∀ (ξ : Cyl) (Y : ℝ × ℝ), f (ξ.1, ξ.2.1, ξ.2.2.1, Y) = f ξ) →
    (∀ ξ ∈ U, ∀ Y : ℝ × ℝ, ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) ∈ U) →
    NB h f k ξ0 ≤ ‖iteratedFDeriv ℝ k (fun a : ℝ × ℝ × ℝ => f (sgc5ch h ξ0 a)) 0‖ :=
by
  intro h f U ξ0 k hU hξ0 hf hY hUY

  have key : ∀ {E F W : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F]
      [NormedSpace ℝ F] [NormedAddCommGroup W] [NormedSpace ℝ W] (G : F → W) (T : E →L[ℝ] F) (a : F)
      (V' : Set F) (i : ℕ), IsOpen V' → ContDiffOn ℝ ∞ G V' → a + T 0 ∈ V' →
      iteratedFDeriv ℝ i (fun z => G (a + T z)) 0 =
        (iteratedFDeriv ℝ i G (a + T 0)).compContinuousLinearMap (fun _ => T) := by
    intro E F W _ _ _ _ _ _ G T a V' i hV' hF ha
    obtain ⟨s, hs_def⟩ : ∃ s : Set F, s = (fun z => a + z) ⁻¹' V' := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV'.preimage (continuous_const.add continuous_id)
    have hOT : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have hAs : T 0 ∈ s := by rw [hs_def]; exact ha
    have hxO : (0:E) ∈ ⇑T ⁻¹' s := hAs
    have hsm' : ContDiffOn ℝ ∞ (fun z => G (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => G (a + T z)) i hOT hxO
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm' hs.uniqueDiffOn
      hOT.uniqueDiffOn hAs (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => G (a + z)) i hs hAs
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := G) i a (T 0)
    calc iteratedFDeriv ℝ i (fun z => G (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => G (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => G (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDeriv ℝ i (fun z => G (a + z)) (T 0)).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i G (a + T 0)).compContinuousLinearMap (fun _ => T) := by rw [e4]

  obtain ⟨L, hL⟩ : ∃ L : Cyl →L[ℝ] Cyl, L = Lnorm h ξ0 := ⟨_, rfl⟩
  have hL1 : ∀ u : Cyl, (ξ0 + L u).1 = ξ0.1 + Real.sqrt (qC h ξ0) * u.1 := by
    intro u; rw [hL]; rfl
  have hL2 : ∀ u : Cyl, (ξ0 + L u).2.1 = ξ0.2.1 + qC h ξ0 ^ (1/2 - h) * u.2.1 := by
    intro u; rw [hL]; rfl
  have hL3 : ∀ u : Cyl, (ξ0 + L u).2.2.1 = ξ0.2.2.1 + qC h ξ0 * u.2.2.1 := by
    intro u; rw [hL]; rfl

  obtain ⟨Pj, hPj⟩ : ∃ Pj : Cyl →L[ℝ] ℝ × ℝ × ℝ,
      Pj = (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))).prod
        (((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
            (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))).prod
          ((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp
            ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
              (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))))) := ⟨_, rfl⟩
  have hPjapp : ∀ v : Cyl, Pj v = (v.1, v.2.1, v.2.2.1) := by intro v; rw [hPj]; rfl
  have hPjn : ‖Pj‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound Pj zero_le_one (fun v => ?_)
    have e : ‖((v.1, v.2.1, v.2.2.1) : ℝ × ℝ × ℝ)‖ = max ‖v.1‖ (max ‖v.2.1‖ ‖v.2.2.1‖) := by
      rw [Prod.norm_def, Prod.norm_def]
    rw [hPjapp, one_mul, e]
    exact max_le (norm_fst_le v) (max_le ((norm_fst_le v.2).trans (norm_snd_le v))
      (((norm_fst_le v.2.2).trans (norm_snd_le v.2)).trans (norm_snd_le v)))

  have hfac : ∀ v : Cyl, f (ξ0 + L v) = f (sgc5ch h ξ0 (0 + Pj v)) := by
    intro v
    rw [zero_add, hPjapp, ← hY (ξ0 + L v) 0, hL1, hL2, hL3]
    rfl
  have hfun : (fun v : Cyl => f (ξ0 + L v)) = (fun v : Cyl => f (sgc5ch h ξ0 (0 + Pj v))) :=
    funext hfac

  have hchd : ContDiff ℝ ∞ (fun a : ℝ × ℝ × ℝ => sgc5ch h ξ0 a) := by
    show ContDiff ℝ ∞ (fun a : ℝ × ℝ × ℝ => (ξ0.1 + Real.sqrt (qC h ξ0) * a.1,
      ξ0.2.1 + qC h ξ0 ^ (1/2 - h) * a.2.1, ξ0.2.2.1 + qC h ξ0 * a.2.2, (0 : ℝ × ℝ)))
    exact (contDiff_const.add (contDiff_const.mul contDiff_fst)).prodMk
      ((contDiff_const.add (contDiff_const.mul (contDiff_fst.comp contDiff_snd))).prodMk
        ((contDiff_const.add (contDiff_const.mul (contDiff_snd.comp contDiff_snd))).prodMk
          contDiff_const))
  obtain ⟨V, hV⟩ : ∃ V : Set (ℝ × ℝ × ℝ), V = {a | sgc5ch h ξ0 a ∈ U} := ⟨_, rfl⟩
  have hVo : IsOpen V := by rw [hV]; exact hU.preimage hchd.continuous
  have hFV : ContDiffOn ℝ ∞ (fun a : ℝ × ℝ × ℝ => f (sgc5ch h ξ0 a)) V :=
    hf.comp hchd.contDiffOn (fun a ha => by rw [hV] at ha; exact ha)
  have hch0 : sgc5ch h ξ0 0 = (ξ0.1, ξ0.2.1, ξ0.2.2.1, (0 : ℝ × ℝ)) := by simp [sgc5ch]
  have h0V : (0 : ℝ × ℝ × ℝ) + Pj 0 ∈ V := by
    rw [map_zero, add_zero, hV]
    show sgc5ch h ξ0 0 ∈ U
    rw [hch0]
    exact hUY ξ0 hξ0 0

  have e1 := key f L ξ0 U k hU hf (by rw [map_zero, add_zero]; exact hξ0)
  rw [map_zero, add_zero] at e1
  have e2 := key (fun a : ℝ × ℝ × ℝ => f (sgc5ch h ξ0 a)) Pj 0 V k hVo hFV h0V
  rw [map_zero, add_zero] at e2
  have hEq : (iteratedFDeriv ℝ k f ξ0).compContinuousLinearMap (fun _ => Lnorm h ξ0) =
      (iteratedFDeriv ℝ k (fun a : ℝ × ℝ × ℝ => f (sgc5ch h ξ0 a)) 0).compContinuousLinearMap
        (fun _ => Pj) := by
    rw [← hL, ← e1, ← e2, hfun]
  unfold NB
  rw [hEq]
  calc ‖(iteratedFDeriv ℝ k (fun a : ℝ × ℝ × ℝ => f (sgc5ch h ξ0 a)) 0).compContinuousLinearMap
          (fun _ => Pj)‖
      ≤ ‖iteratedFDeriv ℝ k (fun a : ℝ × ℝ × ℝ => f (sgc5ch h ξ0 a)) 0‖ * ∏ _j : Fin k, ‖Pj‖ :=
        ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ = ‖iteratedFDeriv ℝ k (fun a : ℝ × ℝ × ℝ => f (sgc5ch h ξ0 a)) 0‖ * ‖Pj‖ ^ k := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    _ ≤ ‖iteratedFDeriv ℝ k (fun a : ℝ × ℝ × ℝ => f (sgc5ch h ξ0 a)) 0‖ * 1 :=
        mul_le_mul_of_nonneg_left (pow_le_one₀ (norm_nonneg _) hPjn) (norm_nonneg _)
    _ = ‖iteratedFDeriv ℝ k (fun a : ℝ × ℝ × ℝ => f (sgc5ch h ξ0 a)) 0‖ := mul_one _

theorem stp5sc_ray_int : ∀ (B : BG) (qs α : ℝ) (F : Cyl → ℝ) (e : ℕ), B.ok → InM B qs α F → ∀ k : ℕ,
