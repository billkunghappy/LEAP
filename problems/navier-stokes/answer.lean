  have hTFs : ContDiffOn ℝ ∞ TF U := by rw [hTF]; exact (hdir _ hFa _ _).mono hUsubB
  have hTBs : ContDiffOn ℝ ∞ TB U := by rw [hTB]; exact (hdir _ hB2 _ _).mono hUsubB
  have hRFs : ContDiffOn ℝ ∞ RF U := by rw [hRF]; exact (hdir _ hFa _ _).mono hUsubB
  have hRBs : ContDiffOn ℝ ∞ RB U := by rw [hRB]; exact (hdir _ hB2 _ _).mono hUsubB
  have hZFs : ContDiffOn ℝ ∞ ZF U := by rw [hZF]; exact (hdir _ hFa _ _).mono hUsubB
  have hZBs : ContDiffOn ℝ ∞ ZB U := by rw [hZB]; exact (hdir _ hB2 _ _).mono hUsubB
