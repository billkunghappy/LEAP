theorem stp5sc_beta_weighted : ∀ (B : BG) (qs : ℝ) (e : ℕ), B.ok → qs ≤ 1 → (∀ (p : ℝ) (k : ℕ), ∃ C : ℝ, ∀ z τ : ℝ, 0 < τ → simScale B.h z τ ≤ 1 → ‖(iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale B.h w.1 w.2 ^ p) (z, τ)).compContinuousLinearMap (fun _ => (simScale B.h z τ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap (simScale B.h z τ • ContinuousLinearMap.id ℝ ℝ))‖ ≤ C * simScale B.h z τ ^ p) →
    ∀ d : ℝ, 0 ≤ d → ∀ k : ℕ, ∃ C : ℝ, ∀ ξ0 ∈ DomC B.h qs, B.Xa < XC B.h ξ0 → XC B.h ξ0 < B.Xb →
      ContDiffOn ℝ ∞ (fun a : ℝ × ℝ × ℝ => sgc5beta B e (sgc5rho B.h (sgc5ch B.h ξ0 a)))
        {a | (sgc5ch B.h ξ0 a).2.2.1 < 1} ∧
      ContDiffOn ℝ ∞ (fun a : ℝ × ℝ × ℝ => sgc5betaR B e (sgc5U0 B) (sgc5rho B.h (sgc5ch B.h ξ0 a)))
        {a | (sgc5ch B.h ξ0 a).2.2.1 < 1} ∧
      (XC B.h ξ0 ≤ Real.sqrt (B.Xa * B.Xb) → ∀ i : ℕ, i ≤ k →
        ‖iteratedFDeriv ℝ i (fun a : ℝ × ℝ × ℝ => sgc5beta B e (sgc5rho B.h (sgc5ch B.h ξ0 a))) 0‖ ≤
          C * sgc5w B d (XC B.h ξ0)) ∧
      (Real.sqrt (B.Xa * B.Xb) ≤ XC B.h ξ0 → ∀ i : ℕ, i ≤ k →
        ‖iteratedFDeriv ℝ i (fun a : ℝ × ℝ × ℝ => sgc5betaR B e (sgc5U0 B) (sgc5rho B.h (sgc5ch B.h ξ0 a))) 0‖ ≤
          C * sgc5w B d (XC B.h ξ0)) :=
by
  intro B qs e hB hqs hS8 d hd k
  obtain ⟨hh0, hh1, hXa, hXam1, hm12, hm2Xb, -, hqB0, -, -, -, haa, hab⟩ := hB.2.1
  have hXaXb : B.Xa < B.Xb := by linarith
  have h1U0 : 1 ≤ sgc5U0 B := by
    have h : 1 ≤ B.Xb / B.Xa := (one_le_div hXa).mpr hXaXb.le
    have := Real.sqrt_le_sqrt h
    rw [Real.sqrt_one] at this
    show 1 ≤ 2 * Real.sqrt (B.Xb / B.Xa)
    linarith

  have hm1 : 0 ≤ B.m1 := hXa.le.trans hXam1.le
  have hs12 : Real.sqrt (2 * B.m1) < Real.sqrt (2 * B.m2) :=
    Real.sqrt_lt_sqrt (by linarith) (by linarith)
  have hbmp : ContDiff ℝ ∞ bumpR := by
    unfold bumpR
    exact Real.smoothTransition.contDiff.comp (by fun_prop)
  have hrh : ContDiff ℝ ∞ (rhoHat B) := by
    unfold rhoHat
    exact (hbmp.comp (by fun_prop)).div_const _
  have hbh : ContDiff ℝ ∞ (bHatE B e) := by
    unfold bHatE
    exact hrh.div_const _
  have hφ : ContDiff ℝ ∞ (fun s : ℝ => s ^ e * bHatE B e s) := (contDiff_id.pow e).mul hbh
  have hφc : Continuous (fun s : ℝ => s ^ e * bHatE B e s) := hφ.continuous
  have key1 : ∀ x : ℝ, (x ≤ -1 ∨ 1 ≤ x) → 1 ≤ x ^ 2 := by
    intro x hx
    rcases hx with hx | hx <;> nlinarith
  have hbz : ∀ x : ℝ, 1 ≤ x ^ 2 → bumpR x = 0 := by
    intro x hx
    unfold bumpR
    exact Real.smoothTransition.zero_of_nonpos (by linarith)
  have hvan : ∀ s : ℝ, (s ≤ Real.sqrt (2 * B.m1) ∨ Real.sqrt (2 * B.m2) ≤ s) →
      s ^ e * bHatE B e s = 0 := by
    intro s hs
    have hw : 0 < (Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2 := by linarith
    have hx : 1 ≤ ((s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) ^ 2 := by
      apply key1
      rcases hs with hs | hs
      · left
        rw [div_le_iff₀ hw]
        linarith
      · right
        rw [le_div_iff₀ hw]
        linarith
    have hr0 : rhoHat B s = 0 := by
      simp only [rhoHat, hbz _ hx, zero_div]
    simp only [bHatE, hr0, zero_div, mul_zero]
  have hβd : ∀ x : ℝ, HasDerivAt (sgc5beta B e) (x ^ e * bHatE B e x) x := by
    intro x
    exact (hφc.integral_hasStrictDerivAt 0 x).hasDerivAt
  have hβs : ContDiff ℝ ∞ (sgc5beta B e) := by
    rw [contDiff_infty_iff_deriv]
    refine ⟨fun x => (hβd x).differentiableAt, ?_⟩
    have : deriv (sgc5beta B e) = fun s : ℝ => s ^ e * bHatE B e s :=
      funext fun x => (hβd x).deriv
    rw [this]
    exact hφ
  have hβR : ∀ U ρ : ℝ, sgc5betaR B e U ρ = sgc5beta B e (U * ρ) - sgc5beta B e ρ := by
    intro U ρ
    exact (intervalIntegral.integral_interval_sub_left (hφc.intervalIntegrable _ _)
      (hφc.intervalIntegrable _ _)).symm
  have hβRs : ∀ U : ℝ, ContDiff ℝ ∞ (sgc5betaR B e U) := by
    intro U
    have : sgc5betaR B e U = fun ρ => sgc5beta B e (U * ρ) - sgc5beta B e ρ := funext (hβR U)
    rw [this]
    exact (hβs.comp (contDiff_const.mul contDiff_id)).sub hβs
  have hβ0 : ∀ ρ : ℝ, ρ ≤ Real.sqrt (2 * B.m1) → sgc5beta B e ρ = 0 := by
    intro ρ hρ
    have h : Set.EqOn (fun s : ℝ => s ^ e * bHatE B e s) (fun _ => (0:ℝ)) (Set.uIcc 0 ρ) := by
      intro s hs
      apply hvan
      left
      rcases Set.mem_uIcc.mp hs with h | h
      · exact h.2.trans hρ
      · exact h.2.trans (Real.sqrt_nonneg _)
    show (∫ s in (0:ℝ)..ρ, s ^ e * bHatE B e s) = 0
    rw [intervalIntegral.integral_congr h]
    simp
  have hβR0 : ∀ U ρ : ℝ, 1 ≤ U → Real.sqrt (2 * B.m2) ≤ ρ → sgc5betaR B e U ρ = 0 := by
    intro U ρ hU hρ
    have hρ0 : 0 ≤ ρ := (Real.sqrt_nonneg _).trans hρ
    have hUρ : ρ ≤ U * ρ := le_mul_of_one_le_left hρ0 hU
    have h : Set.EqOn (fun s : ℝ => s ^ e * bHatE B e s) (fun _ => (0:ℝ)) (Set.uIcc ρ (U * ρ)) := by
      intro s hs
      apply hvan
      right
      rcases Set.mem_uIcc.mp hs with h | h
      · exact hρ.trans h.1
      · exact hρ.trans (hUρ.trans h.1)
    show (∫ s in ρ..(U * ρ), s ^ e * bHatE B e s) = 0
    rw [intervalIntegral.integral_congr h]
    simp

  obtain ⟨Cid, hCid⟩ := stp5sc_scale_bounds B qs id hB hqs hS8 contDiff_id k
  obtain ⟨C1, hC1⟩ := stp5sc_scale_bounds B qs (sgc5beta B e) hB hqs hS8 hβs k
  obtain ⟨C2, hC2⟩ := stp5sc_scale_bounds B qs (sgc5betaR B e (sgc5U0 B)) hB hqs hS8 (hβRs _) k
  have hXaXm : B.Xa < Real.sqrt (B.Xa * B.Xb) := by
    have : Real.sqrt (B.Xa * B.Xa) < Real.sqrt (B.Xa * B.Xb) :=
      Real.sqrt_lt_sqrt (by positivity) (mul_lt_mul_of_pos_left hXaXb hXa)
    rwa [Real.sqrt_mul_self hXa.le] at this
  have hXmXb : Real.sqrt (B.Xa * B.Xb) < B.Xb := by
    have : Real.sqrt (B.Xa * B.Xb) < Real.sqrt (B.Xb * B.Xb) :=
      Real.sqrt_lt_sqrt (mul_pos hXa (by linarith)).le (mul_lt_mul_of_pos_right hXaXb (by linarith))
    rwa [Real.sqrt_mul_self (by linarith)] at this
  obtain ⟨W, hW0, hW⟩ := edge_weight_window B.Xa B.Xb B.aa B.ab (min B.m1 (Real.sqrt (B.Xa * B.Xb)))
    (max B.m2 (Real.sqrt (B.Xa * B.Xb))) hXa (lt_min hXam1 hXaXm)
    ((min_le_left _ _).trans (hm12.le.trans (le_max_left _ _))) (max_lt hm2Xb hXmXb) haa hab
  refine ⟨(|C1| + |C2|) / W, ?_⟩
  intro ξ0 hξ0 hX1 hX2
  have hCnn : 0 ≤ (|C1| + |C2|) / W := by positivity
  have hCW : (|C1| + |C2|) / W * W = |C1| + |C2| := div_mul_cancel₀ _ hW0.ne'
  have hX0 : 0 < XC B.h ξ0 := by linarith
  have hq0 : 0 < qC B.h ξ0 := (hB.1.1 ξ0.2.1 (1 - ξ0.2.2.1) (by linarith [hξ0.2.1])).1
  have hrho0 : 0 < sgc5rho B.h ξ0 := div_pos hξ0.1 (Real.sqrt_pos.mpr hq0)
  have hrho2 : sgc5rho B.h ξ0 ^ 2 = 2 * XC B.h ξ0 := by
    show (ξ0.1 / Real.sqrt (qC B.h ξ0)) ^ 2 = 2 * (ξ0.1 ^ 2 / (2 * qC B.h ξ0))
    rw [div_pow, Real.sq_sqrt hq0.le, mul_div_assoc',
      mul_div_mul_left _ _ (two_ne_zero : (2:ℝ) ≠ 0)]
  have hhi : sgc5rho B.h ξ0 ≤ 2 * Real.sqrt (2 * B.Xb) := by
    have h1 := (Real.lt_sqrt hrho0.le).mpr
      (by rw [hrho2]; linarith : sgc5rho B.h ξ0 ^ 2 < 2 * B.Xb)
    have h2 := Real.sqrt_nonneg (2 * B.Xb)
    linarith
  obtain ⟨hSid, -⟩ := hCid ξ0 hξ0 hhi
  obtain ⟨hSβ, hBβ⟩ := hC1 ξ0 hξ0 hhi
  obtain ⟨hSβR, hBβR⟩ := hC2 ξ0 hξ0 hhi
  have hSo : IsOpen {a : ℝ × ℝ × ℝ | (sgc5ch B.h ξ0 a).2.2.1 < 1} := by
    apply isOpen_lt _ continuous_const
    simp only [sgc5ch]
    fun_prop
  have h0S : (0 : ℝ × ℝ × ℝ) ∈ {a : ℝ × ℝ × ℝ | (sgc5ch B.h ξ0 a).2.2.1 < 1} := by
    show (sgc5ch B.h ξ0 0).2.2.1 < 1
    simpa [sgc5ch] using hξ0.2.1
  have hgc : ContinuousAt (fun a : ℝ × ℝ × ℝ => sgc5rho B.h (sgc5ch B.h ξ0 a)) 0 :=
    hSid.continuousOn.continuousAt (hSo.mem_nhds h0S)
  have hg0 : sgc5rho B.h (sgc5ch B.h ξ0 0) = sgc5rho B.h ξ0 := by
    simp [sgc5ch, sgc5rho, qC]

  have hδpos : 0 < edgeDist B.Xa B.Xb (XC B.h ξ0) := by
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
      (Real.log_pos ((one_lt_div hX0).mpr hX2)))
  have hδ1 : edgeDist B.Xa B.Xb (XC B.h ξ0) ≤ 1 := by
    unfold edgeDist
    exact min_le_left _ _
  have hδd : 1 ≤ edgeDist B.Xa B.Xb (XC B.h ξ0) ^ (-d) :=
    Real.one_le_rpow_of_pos_of_le_one_of_nonpos hδpos hδ1 (by linarith)
  have hζ0 : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ0) := by
    unfold edgeWeight
    split_ifs
    · positivity
    · exact le_rfl
  have hw0 : 0 ≤ sgc5w B d (XC B.h ξ0) := by
    unfold sgc5w
    exact mul_nonneg hζ0 (zero_le_one.trans hδd)
  have hwin : min B.m1 (Real.sqrt (B.Xa * B.Xb)) ≤ XC B.h ξ0 →
      XC B.h ξ0 ≤ max B.m2 (Real.sqrt (B.Xa * B.Xb)) →
      |C1| + |C2| ≤ (|C1| + |C2|) / W * sgc5w B d (XC B.h ξ0) := by
    intro h1 h2
    have hWz := (hW _ h1 h2).1
    have hWw : W ≤ sgc5w B d (XC B.h ξ0) := by
      unfold sgc5w
      calc W ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ0) * 1 := by rw [mul_one]; exact hWz
        _ ≤ _ := mul_le_mul_of_nonneg_left hδd hζ0
    calc |C1| + |C2| = (|C1| + |C2|) / W * W := hCW.symm
      _ ≤ _ := mul_le_mul_of_nonneg_left hWw hCnn
  have hzero : ∀ (F : ℝ × ℝ × ℝ → ℝ) (i : ℕ), F =ᶠ[nhds 0] (fun _ => (0:ℝ)) →
      ‖iteratedFDeriv ℝ i F 0‖ ≤ (|C1| + |C2|) / W * sgc5w B d (XC B.h ξ0) := by
    intro F i hF
    rw [(hF.iteratedFDeriv ℝ i).eq_of_nhds, iteratedFDeriv_fun_zero]
    simp only [Pi.zero_apply, norm_zero]
    exact mul_nonneg hCnn hw0
  refine ⟨hSβ, hSβR, ?_, ?_⟩
  · intro hL i hi
    rcases lt_or_ge (XC B.h ξ0) B.m1 with hlt | hge
    · apply hzero
      have hr : sgc5rho B.h ξ0 < Real.sqrt (2 * B.m1) :=
        (Real.lt_sqrt hrho0.le).mpr (by rw [hrho2]; linarith)
      have hev : ∀ᶠ a in nhds (0 : ℝ × ℝ × ℝ),
          sgc5rho B.h (sgc5ch B.h ξ0 a) < Real.sqrt (2 * B.m1) := by
        refine hgc.eventually_lt continuousAt_const ?_
        show sgc5rho B.h (sgc5ch B.h ξ0 0) < Real.sqrt (2 * B.m1)
        rw [hg0]
        exact hr
      filter_upwards [hev] with a ha
      exact hβ0 _ ha.le
    · exact (hBβ i hi).trans ((le_abs_self C1).trans ((le_add_of_nonneg_right (abs_nonneg C2)).trans
        (hwin ((min_le_left _ _).trans hge) (hL.trans (le_max_right _ _)))))
  · intro hL i hi
    rcases lt_or_ge B.m2 (XC B.h ξ0) with hlt | hge
    · apply hzero
      have hr : Real.sqrt (2 * B.m2) < sgc5rho B.h ξ0 :=
        (Real.sqrt_lt' hrho0).mpr (by rw [hrho2]; linarith)
      have hev : ∀ᶠ a in nhds (0 : ℝ × ℝ × ℝ),
          Real.sqrt (2 * B.m2) < sgc5rho B.h (sgc5ch B.h ξ0 a) := by
        refine continuousAt_const.eventually_lt hgc ?_
        show Real.sqrt (2 * B.m2) < sgc5rho B.h (sgc5ch B.h ξ0 0)
        rw [hg0]
        exact hr
      filter_upwards [hev] with a ha
      exact hβR0 _ _ h1U0 ha.le
    · exact (hBβR i hi).trans ((le_abs_self C2).trans ((le_add_of_nonneg_left (abs_nonneg C1)).trans
        (hwin ((min_le_right _ _).trans hL) (hge.trans (le_max_left _ _)))))

theorem stp5sc_leibniz_comb : ∀ (V : Set (ℝ × ℝ × ℝ)) (P Bt Jt It : ℝ × ℝ × ℝ → ℝ) (k : ℕ) (Cp Cb CJ CI : ℝ), IsOpen V → (0 : ℝ × ℝ × ℝ) ∈ V → ContDiffOn ℝ ∞ P V → ContDiffOn ℝ ∞ Bt V → ContDiffOn ℝ ∞ Jt V → ContDiffOn ℝ ∞ It V → (∀ i : ℕ, i ≤ k → ‖iteratedFDeriv ℝ i P 0‖ ≤ Cp) → (∀ i : ℕ, i ≤ k → ‖iteratedFDeriv ℝ i Bt 0‖ ≤ Cb) → (∀ i : ℕ, i ≤ k → ‖iteratedFDeriv ℝ i Jt 0‖ ≤ CJ) → (∀ i : ℕ, i ≤ k → ‖iteratedFDeriv ℝ i It 0‖ ≤ CI) → ‖iteratedFDeriv ℝ k (fun a => P a * (Bt a * Jt a - It a)) 0‖ ≤ 4 ^ k * Cp * (Cb * CJ + CI) ∧ ‖iteratedFDeriv ℝ k (fun a => P a * (It a - Bt a * Jt a)) 0‖ ≤ 4 ^ k * Cp * (Cb * CJ + CI) :=
by
  intro V P Bt Jt It k Cp Cb CJ CI hV h0 hP hB hJ hI bP bB bJ bI
  have hCp : 0 ≤ Cp := (norm_nonneg _).trans (bP 0 (Nat.zero_le _))
  have hCb : 0 ≤ Cb := (norm_nonneg _).trans (bB 0 (Nat.zero_le _))
  have hCJ : 0 ≤ CJ := (norm_nonneg _).trans (bJ 0 (Nat.zero_le _))
  have hCI : 0 ≤ CI := (norm_nonneg _).trans (bI 0 (Nat.zero_le _))

  have leibV : ∀ (f g : ℝ × ℝ × ℝ → ℝ), ContDiffOn ℝ ∞ f V → ContDiffOn ℝ ∞ g V → ∀ n : ℕ,
      ‖iteratedFDeriv ℝ n (fun y => f y * g y) 0‖ ≤ ∑ i ∈ Finset.range (n + 1),
        (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i f 0‖ * ‖iteratedFDeriv ℝ (n - i) g 0‖ := by
    intro f g hf hg n
    have hl := norm_iteratedFDerivWithin_mul_le hf hg hV.uniqueDiffOn h0 (n := n)
      (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => f y * g y) n hV h0] at hl
    refine hl.trans (le_of_eq ?_)
    apply Finset.sum_congr rfl
    intro i _
    rw [iteratedFDerivWithin_of_isOpen (f := f) i hV h0,
      iteratedFDerivWithin_of_isOpen (f := g) (n - i) hV h0]
  have hsum : ∀ n : ℕ, ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) = 2 ^ n := by
    intro n
    exact_mod_cast Nat.sum_range_choose n

  have hBJ : ∀ j : ℕ, j ≤ k →
      ‖iteratedFDeriv ℝ j (fun a => Bt a * Jt a) 0‖ ≤ 2 ^ j * (Cb * CJ) := by
    intro j hj
    refine (leibV Bt Jt hB hJ j).trans ?_
    calc ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * ‖iteratedFDeriv ℝ i Bt 0‖ *
          ‖iteratedFDeriv ℝ (j - i) Jt 0‖
        ≤ ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * (Cb * CJ) := by
          apply Finset.sum_le_sum
          intro i hi
          have hij : i ≤ j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [mul_assoc]
          apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
          exact mul_le_mul (bB i (hij.trans hj)) (bJ (j - i) ((Nat.sub_le j i).trans hj))
            (norm_nonneg _) hCb
      _ = 2 ^ j * (Cb * CJ) := by rw [← Finset.sum_mul, hsum]
  have hBJs : ContDiffOn ℝ ∞ (fun a => Bt a * Jt a) V := hB.mul hJ
  have hGs : ContDiffOn ℝ ∞ (fun a => Bt a * Jt a - It a) V := hBJs.sub hI
  have h2k : (1 : ℝ) ≤ 2 ^ k := one_le_pow₀ (by norm_num)

  have hG : ∀ j : ℕ, j ≤ k →
      ‖iteratedFDeriv ℝ j (fun a => Bt a * Jt a - It a) 0‖ ≤ 2 ^ k * (Cb * CJ + CI) := by
    intro j hj
    have ha : ContDiffAt ℝ j (fun a => Bt a * Jt a) 0 :=
      (hBJs.of_le (by exact_mod_cast le_top)).contDiffAt (hV.mem_nhds h0)
    have hb : ContDiffAt ℝ j It 0 :=
      (hI.of_le (by exact_mod_cast le_top)).contDiffAt (hV.mem_nhds h0)
    have e : iteratedFDeriv ℝ j (fun a => Bt a * Jt a - It a) 0 =
        iteratedFDeriv ℝ j (fun a => Bt a * Jt a) 0 - iteratedFDeriv ℝ j It 0 :=
      iteratedFDeriv_sub_apply ha hb
    rw [e]
    have h2j : (2 : ℝ) ^ j ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hj
    have hCbJ : 0 ≤ Cb * CJ := mul_nonneg hCb hCJ
    calc ‖iteratedFDeriv ℝ j (fun a => Bt a * Jt a) 0 - iteratedFDeriv ℝ j It 0‖
        ≤ ‖iteratedFDeriv ℝ j (fun a => Bt a * Jt a) 0‖ + ‖iteratedFDeriv ℝ j It 0‖ :=
          norm_sub_le _ _
      _ ≤ 2 ^ j * (Cb * CJ) + CI := add_le_add (hBJ j hj) (bI j hj)
      _ ≤ 2 ^ k * (Cb * CJ) + 2 ^ k * CI :=
          add_le_add (mul_le_mul_of_nonneg_right h2j hCbJ) (le_mul_of_one_le_left hCI h2k)
      _ = 2 ^ k * (Cb * CJ + CI) := by ring

  have F1 : ‖iteratedFDeriv ℝ k (fun a => P a * (Bt a * Jt a - It a)) 0‖ ≤
      4 ^ k * Cp * (Cb * CJ + CI) := by
    refine (leibV P (fun a => Bt a * Jt a - It a) hP hGs k).trans ?_
    calc ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i P 0‖ *
          ‖iteratedFDeriv ℝ (k - i) (fun a => Bt a * Jt a - It a) 0‖
        ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (Cp * (2 ^ k * (Cb * CJ + CI))) := by
          apply Finset.sum_le_sum
          intro i hi
          have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [mul_assoc]
          apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
          exact mul_le_mul (bP i hik) (hG (k - i) (Nat.sub_le k i)) (norm_nonneg _) hCp
      _ = 4 ^ k * Cp * (Cb * CJ + CI) := by
          rw [← Finset.sum_mul, hsum]
          have h4 : (4 : ℝ) ^ k = 2 ^ k * 2 ^ k := by rw [← mul_pow]; norm_num
          rw [h4]; ring
  refine ⟨F1, ?_⟩
  have e : (fun a => P a * (It a - Bt a * Jt a)) = -(fun a => P a * (Bt a * Jt a - It a)) := by
    funext a; simp only [Pi.neg_apply]; ring
  rw [e, iteratedFDeriv_neg_apply, norm_neg]
  exact F1

theorem stp5_sig_class : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (α : ℝ) (e : ℕ), B.ok → SimNorm B.h → (e = 1 ∨ e = 2) → (∀ (p : ℝ) (k : ℕ), ∃ C : ℝ, ∀ z τ : ℝ, 0 < τ → simScale B.h z τ ≤ 1 → ‖(iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale B.h w.1 w.2 ^ p) (z, τ)).compContinuousLinearMap (fun _ => (simScale B.h z τ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap (simScale B.h z τ • ContinuousLinearMap.id ℝ ℝ))‖ ≤ C * simScale B.h z τ ^ p) → (∀ d : ℝ, 0 ≤ d → ∃ C : ℝ, 0 < C ∧ (∀ X X' : ℝ, ((B.Xa < X' ∧ X' ≤ X ∧ X ≤ Real.sqrt (B.Xa * B.Xb)) ∨ (Real.sqrt (B.Xa * B.Xb) ≤ X ∧ X ≤ X' ∧ X' < B.Xb)) → edgeWeight B.Xa B.Xb B.aa B.ab X' * edgeDist B.Xa B.Xb X' ^ (-d) ≤ C * (edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-d))) ∧ (∀ X : ℝ, B.Xa < X → X < B.Xb → edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-d) ≤ C)) → InM B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) → ContDiffOn ℝ ∞ (sigE5 B G l0 S e) (DomC B.h (qsOf l0)) → (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → sigE5 B G l0 S e ξ = 0) → InM B (qsOf l0) α (nrm B (2 * Aex B.h) (sigE5 B G l0 S e)) :=
by
  intro B G l0 S α e hB hSN he hS8 hEM hFt hsm hsh
  obtain ⟨hh0, hh1, hXa, hXam1, hm12, hm2Xb, -, hqB0, -, -, -, haa, hab⟩ := hB.2.1
  have hXaXb : B.Xa < B.Xb := by linarith
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hqpos : ∀ ξ : Cyl, ξ.2.2.1 < 1 → 0 < qC B.h ξ := fun ξ hξ =>
    (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hqC : ContDiffOn ℝ ∞ (fun ξ : Cyl => qC B.h ξ) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have h1 : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) := by fun_prop
    have h2 := hB.1.2.2.2.1.comp h1.contDiffOn (s := {ξ : Cyl | ξ.2.2.1 < 1})
      (fun ξ hξ => Set.mk_mem_prod (Set.mem_univ _)
        (Set.mem_Ioi.mpr (by have : ξ.2.2.1 < 1 := hξ; linarith)))
    exact h2
  have hfC : ContDiffOn ℝ ∞ (nrm B (2 * Aex B.h) (sigE5 B G l0 S e)) (DomC B.h (qsOf l0)) := by
    have hsub : DomC B.h (qsOf l0) ⊆ {ξ : Cyl | ξ.2.2.1 < 1} := fun ξ hξ => hξ.2.1
    exact ((hqC.mono hsub).rpow_const_of_ne (fun ξ hξ => (hqpos ξ hξ.2.1).ne')).mul hsm
  have hS0o : IsOpen {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} :=
    (isOpen_lt continuous_const continuous_fst).and (isOpen_lt (by fun_prop) continuous_const)
  have hqCc : ContinuousOn (fun ξ : Cyl => qC B.h ξ) {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} :=
    (hqC.continuousOn).mono (fun ξ hξ => hξ.2)
  have hrhoc : ContinuousOn (fun ξ : Cyl => sgc5rho B.h ξ) {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} := by
    show ContinuousOn (fun ξ : Cyl => ξ.1 / Real.sqrt (qC B.h ξ)) _
    exact continuous_fst.continuousOn.div hqCc.sqrt
      (fun ξ hξ => (Real.sqrt_pos.mpr (hqpos ξ hξ.2)).ne')
  let U : Set Cyl := {ξ : Cyl | ξ ∈ DomC B.h (qsOf l0) ∧ Real.sqrt B.Xa < sgc5rho B.h ξ ∧
    sgc5rho B.h ξ < 2 * Real.sqrt (2 * B.Xb)}
  have hUo : IsOpen U := by
    have := (hqCc.prodMk hrhoc).isOpen_inter_preimage hS0o
      (isOpen_Iio.prod isOpen_Ioo :
        IsOpen (Set.Iio (qsOf l0) ×ˢ Set.Ioo (Real.sqrt B.Xa) (2 * Real.sqrt (2 * B.Xb))))
    convert this using 1
    ext ξ
    simp only [U, DomC, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_prod,
      Set.mem_Iio, Set.mem_Ioo]
    tauto
  have hUY : ∀ ξ ∈ U, ∀ Y : ℝ × ℝ, ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) ∈ U := fun ξ hξ Y => hξ
  have hratio : 0 < B.Xa / B.Xb := div_pos hXa (by linarith)
  have hratio1 : B.Xa / B.Xb ≤ 1 := ((div_le_one (by linarith)).mpr hXaXb.le)
  have hc0pos : 0 < sgc5c0 B := div_pos (Real.sqrt_pos.mpr hratio) (by norm_num)
  have hc01 : sgc5c0 B ≤ 1 := by
    have := Real.sqrt_le_sqrt hratio1
    rw [Real.sqrt_one] at this
    show Real.sqrt (B.Xa / B.Xb) / 4 ≤ 1
    linarith
  have h1U0 : 1 ≤ sgc5U0 B := by
    have h : 1 ≤ B.Xb / B.Xa := (one_le_div hXa).mpr hXaXb.le
    have := Real.sqrt_le_sqrt h
    rw [Real.sqrt_one] at this
    show 1 ≤ 2 * Real.sqrt (B.Xb / B.Xa)
    linarith
  refine ⟨hfC, fun ξ _ a _ => rfl, fun ξ hξ hX => ?_, fun k => ?_⟩
  · show qC B.h ξ ^ (2 * Aex B.h) * sigE5 B G l0 S e ξ = 0
    rw [hsh ξ hξ hX, mul_zero]
  obtain ⟨C3, b, d, hd, hR⟩ :=
    stp5sc_ray_int B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) e hB hFt k
  obtain ⟨CE, hCE, hmono, hbdd⟩ := hEM d hd
  obtain ⟨Cp, hCp⟩ := stp5sc_scale_bounds B (qsOf l0) id hB hqs1 hS8 contDiff_id k
  obtain ⟨Cβ, hβ⟩ := stp5sc_beta_weighted B (qsOf l0) e hB hqs1 hS8 d hd k
  refine ⟨4 ^ k * Cp * (sgc5U0 B * max 1 (sgc5U0 B) ^ (k + e) * C3) * CE * (Cβ + 1), b, d, ?_⟩
  intro ξ0 hξ0 hX1 hX2
  have hX0 : 0 < XC B.h ξ0 := by linarith
  have hq0 : 0 < qC B.h ξ0 := hqpos ξ0 hξ0.2.1
  have hr0 : 0 < ξ0.1 := hξ0.1
  have hrho0 : 0 < sgc5rho B.h ξ0 := div_pos hr0 (Real.sqrt_pos.mpr hq0)
  have hrho2 : sgc5rho B.h ξ0 ^ 2 = 2 * XC B.h ξ0 := by
    show (ξ0.1 / Real.sqrt (qC B.h ξ0)) ^ 2 = 2 * (ξ0.1 ^ 2 / (2 * qC B.h ξ0))
    rw [div_pow, Real.sq_sqrt hq0.le, mul_div_assoc',
      mul_div_mul_left _ _ (two_ne_zero : (2:ℝ) ≠ 0)]
  have hlo : Real.sqrt B.Xa < sgc5rho B.h ξ0 :=
    (Real.sqrt_lt' hrho0).mpr (by rw [hrho2]; linarith)
  have hhi : sgc5rho B.h ξ0 < 2 * Real.sqrt (2 * B.Xb) := by
    have h1 := (Real.lt_sqrt hrho0.le).mpr
      (by rw [hrho2]; linarith : sgc5rho B.h ξ0 ^ 2 < 2 * B.Xb)
    have h2 := Real.sqrt_nonneg (2 * B.Xb)
    linarith
  have hw0 : 0 ≤ sgc5w B d (XC B.h ξ0) := by
    unfold sgc5w
    apply mul_nonneg
    · unfold edgeWeight
      split_ifs
      · positivity
      · exact le_rfl
    · apply Real.rpow_nonneg
      unfold edgeDist
      exact (lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
        (Real.log_pos ((one_lt_div hX0).mpr hX2)))).le
  have hξ0U : ξ0 ∈ U := ⟨hξ0, hlo, hhi⟩
  have hchc : Continuous (fun a : ℝ × ℝ × ℝ => sgc5ch B.h ξ0 a) := by
    simp only [sgc5ch]
    fun_prop
  have hVo : IsOpen {a : ℝ × ℝ × ℝ | sgc5ch B.h ξ0 a ∈ U} := hUo.preimage hchc
  have hch0 : sgc5ch B.h ξ0 0 = (ξ0.1, ξ0.2.1, ξ0.2.2.1, (0 : ℝ × ℝ)) := by simp [sgc5ch]
  have h0V : (0 : ℝ × ℝ × ℝ) ∈ {a : ℝ × ℝ × ℝ | sgc5ch B.h ξ0 a ∈ U} := by
    show sgc5ch B.h ξ0 0 ∈ U
    rw [hch0]
    exact hUY ξ0 hξ0U 0
  have hNB := stp5sc_cyl_reduce B.h (nrm B (2 * Aex B.h) (sigE5 B G l0 S e)) U ξ0 k hUo hξ0U
    (hfC.mono (fun ξ hξ => hξ.1)) (fun ξ Y => rfl) hUY
  have hsubV1 : {a : ℝ × ℝ × ℝ | sgc5ch B.h ξ0 a ∈ U} ⊆ {a | (sgc5ch B.h ξ0 a).2.2.1 < 1} :=
    fun a ha => ha.1.2.1
  have hsubV2 : {a : ℝ × ℝ × ℝ | sgc5ch B.h ξ0 a ∈ U} ⊆
      {a | sgc5ch B.h ξ0 a ∈ DomC B.h (qsOf l0)} := fun a ha => ha.1
  obtain ⟨hPs, hPb⟩ := hCp ξ0 hξ0 hhi.le
  obtain ⟨hBs, hBRs, hBl, hBr⟩ := hβ ξ0 hξ0 hX1 hX2
  obtain ⟨hJs, hJb⟩ := hR ξ0 hξ0 (sgc5c0 B) (sgc5U0 B) (sgc5U0 B) hc0pos (hc01.trans h1U0) le_rfl
  obtain ⟨hIs, hIb⟩ := hR ξ0 hξ0 (sgc5c0 B) 1 (sgc5U0 B) hc0pos hc01 h1U0
  obtain ⟨hIRs, hIRb⟩ := hR ξ0 hξ0 1 (sgc5U0 B) (sgc5U0 B) one_pos h1U0 le_rfl
  have hJ := hJb CE hCE.le (fun u _ _ h1 h2 => hbdd _ h1 h2)
  rcases le_total (XC B.h ξ0) (Real.sqrt (B.Xa * B.Xb)) with hL | hL
  · have hI := hIb (CE * sgc5w B d (XC B.h ξ0)) (mul_nonneg hCE.le hw0)
      (fun u hu1 hu2 h1 h2 => hmono (XC B.h ξ0) (u ^ 2 * XC B.h ξ0)
        (Or.inl ⟨h1, mul_le_of_le_one_left hX0.le (pow_le_one₀ (by linarith) hu2), hL⟩))
    have h7 := (stp5sc_leibniz_comb _ (fun a => sgc5rho B.h (sgc5ch B.h ξ0 a))
      (fun a => sgc5beta B e (sgc5rho B.h (sgc5ch B.h ξ0 a)))
      (fun a => sgc5I (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) e (sgc5c0 B) (sgc5U0 B) (sgc5ch B.h ξ0 a))
      (fun a => sgc5I (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) e (sgc5c0 B) 1 (sgc5ch B.h ξ0 a))
      k Cp (Cβ * sgc5w B d (XC B.h ξ0)) _ _ hVo h0V (hPs.mono hsubV1) (hBs.mono hsubV1)
      (hJs.mono hsubV2) (hIs.mono hsubV2) hPb (hBl hL) hJ hI).1
    have hEq : (fun a : ℝ × ℝ × ℝ => nrm B (2 * Aex B.h) (sigE5 B G l0 S e) (sgc5ch B.h ξ0 a)) =ᶠ[nhds 0]
        (fun a => sgc5rho B.h (sgc5ch B.h ξ0 a) *
          (sgc5beta B e (sgc5rho B.h (sgc5ch B.h ξ0 a)) *
            sgc5I (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) e (sgc5c0 B) (sgc5U0 B) (sgc5ch B.h ξ0 a) -
            sgc5I (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) e (sgc5c0 B) 1 (sgc5ch B.h ξ0 a))) :=
      Filter.eventually_of_mem (hVo.mem_nhds h0V)
        (fun a ha => (stp5sc_sig_rep B G l0 S α e hB he hFt hsh _ ha.1 ha.2.1 ha.2.2).1)
    rw [(hEq.iteratedFDeriv ℝ k).eq_of_nhds] at hNB
    refine hNB.trans (h7.trans (le_of_eq ?_))
    unfold sgc5w
    ring
  · have hI := hIRb (CE * sgc5w B d (XC B.h ξ0)) (mul_nonneg hCE.le hw0)
      (fun u hu1 hu2 h1 h2 => hmono (XC B.h ξ0) (u ^ 2 * XC B.h ξ0)
        (Or.inr ⟨hL, le_mul_of_one_le_left hX0.le (one_le_pow₀ hu1), h2⟩))
    have h7 := (stp5sc_leibniz_comb _ (fun a => sgc5rho B.h (sgc5ch B.h ξ0 a))
      (fun a => sgc5betaR B e (sgc5U0 B) (sgc5rho B.h (sgc5ch B.h ξ0 a)))
      (fun a => sgc5I (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) e (sgc5c0 B) (sgc5U0 B) (sgc5ch B.h ξ0 a))
      (fun a => sgc5I (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) e 1 (sgc5U0 B) (sgc5ch B.h ξ0 a))
      k Cp (Cβ * sgc5w B d (XC B.h ξ0)) _ _ hVo h0V (hPs.mono hsubV1) (hBRs.mono hsubV1)
      (hJs.mono hsubV2) (hIRs.mono hsubV2) hPb (hBr hL) hJ hI).2
    have hEq : (fun a : ℝ × ℝ × ℝ => nrm B (2 * Aex B.h) (sigE5 B G l0 S e) (sgc5ch B.h ξ0 a)) =ᶠ[nhds 0]
        (fun a => sgc5rho B.h (sgc5ch B.h ξ0 a) *
          (sgc5I (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) e 1 (sgc5U0 B) (sgc5ch B.h ξ0 a) -
            sgc5betaR B e (sgc5U0 B) (sgc5rho B.h (sgc5ch B.h ξ0 a)) *
            sgc5I (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) e (sgc5c0 B) (sgc5U0 B) (sgc5ch B.h ξ0 a))) :=
      Filter.eventually_of_mem (hVo.mem_nhds h0V)
        (fun a ha => (stp5sc_sig_rep B G l0 S α e hB he hFt hsh _ ha.1 ha.2.1 ha.2.2).2)
    rw [(hEq.iteratedFDeriv ℝ k).eq_of_nhds] at hNB
    refine hNB.trans (h7.trans (le_of_eq ?_))
    unfold sgc5w
    ring

theorem stp5_sbase_moments : ∀ (B : BG), B.ok → (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < B.qB → (∫ r in Set.Ioi (0:ℝ), r ^ 2 * sBase B 1 (r, z, t, 0)) = 0 ∧ (∫ r in Set.Ioi (0:ℝ), r * sBase B 2 (r, z, t, 0)) = 0 ∧ ContinuousOn (fun r => sBase B 1 (r, z, t, 0)) (Set.Ioi 0) ∧ ContinuousOn (fun r => sBase B 2 (r, z, t, 0)) (Set.Ioi 0)) ∧ ∀ ξ : Cyl, 0 < ξ.1 → ξ.2.2.1 < 1 → simScale B.h ξ.2.1 (1 - ξ.2.2.1) < B.qB → (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → sBase B 1 ξ = 0 ∧ sBase B 2 ξ = 0 :=
by
  intro B hB
  obtain ⟨⟨_hh0, _hh1, hXa, hXam1, hm12, hm2Xb, -⟩, -, -, -, -, -, -, -, ⟨c9a, c9b, hvan, -⟩, -, -, -⟩ := hB.2
  have hab : B.Xa < B.Xb := by linarith

  have dz : ∀ (T : ℝ → ℝ) (a b Y : ℝ), (∀ Y' : ℝ, (Y' ≤ a ∨ b ≤ Y') → T Y' = 0) →
      (Y ≤ a ∨ b ≤ Y) → deriv T Y = 0 := by
    intro T a b Y hT hY
    by_cases hd : DifferentiableAt ℝ T Y
    · rcases hY with hY | hY
      · have h1 : HasDerivWithinAt T 0 (Set.Iic Y) Y :=
          (hasDerivWithinAt_const Y (Set.Iic Y) (0:ℝ)).congr
            (fun x hx => hT x (Or.inl (le_trans hx hY))) (hT Y (Or.inl hY))
        exact (uniqueDiffWithinAt_Iic Y).eq_deriv _ hd.hasDerivAt.hasDerivWithinAt h1
      · have h1 : HasDerivWithinAt T 0 (Set.Ici Y) Y :=
          (hasDerivWithinAt_const Y (Set.Ici Y) (0:ℝ)).congr
            (fun x hx => hT x (Or.inr (le_trans hY hx))) (hT Y (Or.inr hY))
        exact (uniqueDiffWithinAt_Ici Y).eq_deriv _ hd.hasDerivAt.hasDerivWithinAt h1
    · exact deriv_zero_of_not_differentiableAt hd

  have ftc : ∀ (g G : ℝ → ℝ) (u v : ℝ), 0 < u → u ≤ v → ContinuousOn g (Set.Ioi 0) →
      (∀ r : ℝ, 0 < r → (r ≤ u ∨ v ≤ r) → g r = 0) → (∀ r : ℝ, 0 < r → HasDerivAt G (g r) r) →
      G u = 0 → G v = 0 → ∫ r in Set.Ioi (0:ℝ), g r = 0 := by
    intro g G u v hu huv hg hvan hG hGu hGv
    have hsub : Set.Ioc u v ⊆ Set.Ioi (0:ℝ) := fun x hx => lt_trans hu hx.1
    have hdiff : ∀ x ∈ Set.Ioi (0:ℝ) \ Set.Ioc u v, g x = 0 := by
      intro x hx
      rcases hx with ⟨hx0, hx1⟩
      simp only [Set.mem_Ioc, not_and_or, not_lt, not_le] at hx1
      exact hvan x hx0 (hx1.imp id le_of_lt)
    have hIcc : Set.uIcc u v ⊆ Set.Ioi 0 := by
      rw [Set.uIcc_of_le huv]
      exact fun x hx => lt_of_lt_of_le hu hx.1
    rw [MeasureTheory.setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi hsub hdiff,
      ← intervalIntegral.integral_of_le huv,
      intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x hx => hG x (hIcc hx))
        ((hg.mono hIcc).intervalIntegrable), hGu, hGv, sub_zero]

  have reg : ∀ (T : ℝ → ℝ) (q : ℝ), 0 < q → ContDiffOn ℝ ∞ T (Set.Ioi 0) →
      ContinuousOn (fun r : ℝ => T (r ^ 2 / (2 * q))) (Set.Ioi 0) ∧
      ContinuousOn (fun r : ℝ => deriv T (r ^ 2 / (2 * q))) (Set.Ioi 0) ∧
      ∀ r : ℝ, 0 < r → HasDerivAt (fun r : ℝ => T (r ^ 2 / (2 * q)))
        (deriv T (r ^ 2 / (2 * q)) * (2 * r / (2 * q))) r := by
    intro T q hq hT
    have hXc : Continuous (fun r : ℝ => r ^ 2 / (2 * q)) := (continuous_pow 2).div_const _
    have hmaps : Set.MapsTo (fun r : ℝ => r ^ 2 / (2 * q)) (Set.Ioi 0) (Set.Ioi 0) := fun r hr => by
      have hr' : (0:ℝ) < r := hr
      show (0:ℝ) < r ^ 2 / (2 * q)
      positivity
    refine ⟨hT.continuousOn.comp hXc.continuousOn hmaps,
      (hT.continuousOn_deriv_of_isOpen isOpen_Ioi (by simp)).comp hXc.continuousOn hmaps,
      fun r hr => ?_⟩
    have hX' : HasDerivAt (fun r : ℝ => r ^ 2 / (2 * q)) (2 * r / (2 * q)) r :=
      ((hasDerivAt_pow 2 r).div_const (2 * q)).congr_deriv (by norm_num)
    have hTd : HasDerivAt T (deriv T (r ^ 2 / (2 * q))) (r ^ 2 / (2 * q)) :=
      ((hT.differentiableOn (by simp)).differentiableAt (isOpen_Ioi.mem_nhds (hmaps hr))).hasDerivAt
    exact hTd.comp r hX'

  have sh : ∀ (a b q : ℝ), 0 < a → a < b → 0 < q →
      0 < Real.sqrt (2 * a * q) ∧ Real.sqrt (2 * a * q) ≤ Real.sqrt (2 * b * q) ∧
      (∀ r : ℝ, 0 < r → (r ≤ Real.sqrt (2 * a * q) ∨ Real.sqrt (2 * b * q) ≤ r) →
        (r ^ 2 / (2 * q) ≤ a ∨ b ≤ r ^ 2 / (2 * q))) ∧
      Real.sqrt (2 * a * q) ^ 2 / (2 * q) = a ∧ Real.sqrt (2 * b * q) ^ 2 / (2 * q) = b := by
    intro a b q ha hab hq
    have hsa : Real.sqrt (2 * a * q) ^ 2 = 2 * a * q := Real.sq_sqrt (by positivity)
    have hsb : Real.sqrt (2 * b * q) ^ 2 = 2 * b * q := Real.sq_sqrt (by nlinarith)
    refine ⟨Real.sqrt_pos.mpr (by positivity), Real.sqrt_le_sqrt (by nlinarith), fun r hr h => ?_,
      by rw [hsa]; field_simp, by rw [hsb]; field_simp⟩
    rcases h with h | h
    · left
      rw [div_le_iff₀ (by positivity)]
      nlinarith [Real.sqrt_nonneg (2 * a * q)]
    · right
      rw [le_div_iff₀ (by positivity)]
      nlinarith [Real.sqrt_nonneg (2 * b * q)]

  have mom2 : ∀ (T : ℝ → ℝ) (a b q c : ℝ), 0 < a → a < b → 0 < q → ContDiffOn ℝ ∞ T (Set.Ioi 0) →
      (∀ Y : ℝ, (Y ≤ a ∨ b ≤ Y) → T Y = 0) →
      (∫ r in Set.Ioi (0:ℝ), r ^ 2 * (-(c * (deriv T (r ^ 2 / (2 * q)) +
        T (r ^ 2 / (2 * q)) / (r ^ 2 / (2 * q)))) * r)) = 0 ∧
      ContinuousOn (fun r : ℝ => -(c * (deriv T (r ^ 2 / (2 * q)) +
        T (r ^ 2 / (2 * q)) / (r ^ 2 / (2 * q)))) * r) (Set.Ioi 0) := by
    intro T a b q c ha hab hq hT hvT
    obtain ⟨hc1, hc2, hd⟩ := reg T q hq hT
    have hXc : ContinuousOn (fun r : ℝ => r ^ 2 / (2 * q)) (Set.Ioi 0) :=
      ((continuous_pow 2).div_const _).continuousOn
    have hcont : ContinuousOn (fun r : ℝ => -(c * (deriv T (r ^ 2 / (2 * q)) +
        T (r ^ 2 / (2 * q)) / (r ^ 2 / (2 * q)))) * r) (Set.Ioi 0) :=
      ((continuousOn_const.mul (hc2.add (hc1.div hXc (fun r hr => by
        have hr' : (0:ℝ) < r := hr
        positivity)))).neg).mul continuousOn_id
    refine ⟨?_, hcont⟩
    obtain ⟨hu, huv, hoff, hXu, hXv⟩ := sh a b q ha hab hq
    refine ftc (fun r : ℝ => r ^ 2 * (-(c * (deriv T (r ^ 2 / (2 * q)) +
        T (r ^ 2 / (2 * q)) / (r ^ 2 / (2 * q)))) * r))
      (fun r : ℝ => -(c * q) * (r ^ 2 * T (r ^ 2 / (2 * q)))) _ _ hu huv
      ((continuous_pow 2).continuousOn.mul hcont) ?_ ?_ ?_ ?_
    · intro r hr hr'
      have hX := hoff r hr hr'
      show r ^ 2 * (-(c * (deriv T (r ^ 2 / (2 * q)) +
        T (r ^ 2 / (2 * q)) / (r ^ 2 / (2 * q)))) * r) = 0
      rw [hvT _ hX, dz T a b _ hvT hX]
      simp
    · intro r hr
      have hr0 : r ≠ 0 := hr.ne'
      have hq0 : q ≠ 0 := hq.ne'
      have h3 := ((hasDerivAt_pow 2 r).mul (hd r hr)).const_mul (-(c * q))
      refine h3.congr_deriv ?_
      rw [show (2:ℕ) - 1 = 1 from rfl, pow_one]
      push_cast
      field_simp
      ring
    · show -(c * q) * (Real.sqrt (2 * a * q) ^ 2 * T (Real.sqrt (2 * a * q) ^ 2 / (2 * q))) = 0
      rw [hXu, hvT a (Or.inl le_rfl)]
      ring
    · show -(c * q) * (Real.sqrt (2 * b * q) ^ 2 * T (Real.sqrt (2 * b * q) ^ 2 / (2 * q))) = 0
      rw [hXv, hvT b (Or.inr le_rfl)]
      ring

  have mom1 : ∀ (T : ℝ → ℝ) (a b q c : ℝ), 0 < a → a < b → 0 < q → ContDiffOn ℝ ∞ T (Set.Ioi 0) →
      (∀ Y : ℝ, (Y ≤ a ∨ b ≤ Y) → T Y = 0) →
      (∫ r in Set.Ioi (0:ℝ), r * (-(Real.sqrt (2 * (r ^ 2 / (2 * q))) * c *
        (deriv T (r ^ 2 / (2 * q)) + T (r ^ 2 / (2 * q)) / (2 * (r ^ 2 / (2 * q))))))) = 0 ∧
      ContinuousOn (fun r : ℝ => -(Real.sqrt (2 * (r ^ 2 / (2 * q))) * c *
        (deriv T (r ^ 2 / (2 * q)) + T (r ^ 2 / (2 * q)) / (2 * (r ^ 2 / (2 * q)))))) (Set.Ioi 0) := by
    intro T a b q c ha hab hq hT hvT
    obtain ⟨hc1, hc2, hd⟩ := reg T q hq hT
    have hXc : Continuous (fun r : ℝ => r ^ 2 / (2 * q)) := (continuous_pow 2).div_const _
    have hcont : ContinuousOn (fun r : ℝ => -(Real.sqrt (2 * (r ^ 2 / (2 * q))) * c *
        (deriv T (r ^ 2 / (2 * q)) + T (r ^ 2 / (2 * q)) / (2 * (r ^ 2 / (2 * q)))))) (Set.Ioi 0) :=
      ((((Real.continuous_sqrt.comp (continuous_const.mul hXc)).continuousOn.mul continuousOn_const).mul
        (hc2.add (hc1.div (continuous_const.mul hXc).continuousOn (fun r hr => by
          have hr' : (0:ℝ) < r := hr
          show (2:ℝ) * (r ^ 2 / (2 * q)) ≠ 0
          positivity))))).neg
    refine ⟨?_, hcont⟩
    obtain ⟨hu, huv, hoff, hXu, hXv⟩ := sh a b q ha hab hq
    obtain ⟨s, hs, rfl⟩ : ∃ s : ℝ, 0 < s ∧ q = s ^ 2 :=
      ⟨Real.sqrt q, Real.sqrt_pos.mpr hq, (Real.sq_sqrt hq.le).symm⟩
    refine ftc (fun r : ℝ => r * (-(Real.sqrt (2 * (r ^ 2 / (2 * s ^ 2))) * c *
        (deriv T (r ^ 2 / (2 * s ^ 2)) + T (r ^ 2 / (2 * s ^ 2)) / (2 * (r ^ 2 / (2 * s ^ 2)))))))
      (fun r : ℝ => -(c * s) * (r * T (r ^ 2 / (2 * s ^ 2)))) _ _ hu huv
      (continuousOn_id.mul hcont) ?_ ?_ ?_ ?_
    · intro r hr hr'
      have hX := hoff r hr hr'
      show r * (-(Real.sqrt (2 * (r ^ 2 / (2 * s ^ 2))) * c *
        (deriv T (r ^ 2 / (2 * s ^ 2)) + T (r ^ 2 / (2 * s ^ 2)) / (2 * (r ^ 2 / (2 * s ^ 2)))))) = 0
      rw [hvT _ hX, dz T a b _ hvT hX]
      simp
    · intro r hr
      have hr0 : r ≠ 0 := hr.ne'
      have hs0 : s ≠ 0 := hs.ne'
      have hsq : Real.sqrt (2 * (r ^ 2 / (2 * s ^ 2))) = r / s := by
        rw [show 2 * (r ^ 2 / (2 * s ^ 2)) = (r / s) ^ 2 by field_simp]
        exact Real.sqrt_sq (div_pos hr hs).le
      have h3 := ((hasDerivAt_id' r).mul (hd r hr)).const_mul (-(c * s))
      refine h3.congr_deriv ?_
      rw [hsq]
      field_simp
      ring
    · show -(c * s) * (Real.sqrt (2 * a * s ^ 2) * T (Real.sqrt (2 * a * s ^ 2) ^ 2 / (2 * s ^ 2))) = 0
      rw [hXu, hvT a (Or.inl le_rfl)]
      ring
    · show -(c * s) * (Real.sqrt (2 * b * s ^ 2) * T (Real.sqrt (2 * b * s ^ 2) ^ 2 / (2 * s ^ 2))) = 0
      rw [hXv, hvT b (Or.inr le_rfl)]
      ring

  have K1 : ∀ (y : ℝ³) (α β : ℝ),
      inner ℝ (α • azVec y + β • EuclideanSpace.single (2 : Fin 3) (1:ℝ)) (eTh y) =
        α * ((rad y)⁻¹ * (y 0 ^ 2 + y 1 ^ 2)) := by
    intro y α β
    simp [eTh, azVec, inner_add_left, inner_add_right, real_inner_smul_left,
      real_inner_smul_right, EuclideanSpace.inner_single_left, EuclideanSpace.inner_single_right] <;>
      ring
  have K2 : ∀ (y : ℝ³) (α β : ℝ),
      inner ℝ (α • azVec y + β • EuclideanSpace.single (2 : Fin 3) (1:ℝ)) eZ = β := by
    intro y α β
    simp [eZ, azVec, inner_add_left, inner_add_right, real_inner_smul_left,
      real_inner_smul_right, EuclideanSpace.inner_single_left, EuclideanSpace.inner_single_right]
  have frame : ∀ (r z t : ℝ) (Y : ℝ × ℝ) (q η X : ℝ), 0 < r → q = simScale B.h z (1 - t) →
      η = z * q ^ (-(1 / 2 - B.h)) → X = r ^ 2 / (2 * q) →
      sBase B 1 (r, z, t, Y) = -(q ^ (-(2 + B.h)) * (deriv (fun Y' => B.Tth q Y' η) X +
        B.Tth q X η / X)) * r ∧
      sBase B 2 (r, z, t, Y) = -(Real.sqrt (2 * X) * q ^ (-(3 / 2 + B.h)) *
        (deriv (fun Y' => B.Tz q Y' η) X + B.Tz q X η / (2 * X))) := by
    intro r z t Y q η X hr hq hη hX
    subst hX hη hq
    have hc0 : (rotPt r 0 z) 0 = r := by simp [rotPt]
    have hc1 : (rotPt r 0 z) 1 = 0 := by simp [rotPt]
    have hc2 : (rotPt r 0 z) 2 = z := by simp [rotPt]
    have hrad : rad (rotPt r 0 z) = r := by
      unfold rad
      rw [hc0, hc1, show r ^ 2 + (0:ℝ) ^ 2 = r ^ 2 by ring, Real.sqrt_sq hr.le]
    have hsX : simX B.h (rotPt r 0 z) t = r ^ 2 / (2 * simScale B.h z (1 - t)) := by
      unfold simX
      rw [hc0, hc1, hc2]
      ring
    have hsE : simEta B.h (rotPt r 0 z) t = z * simScale B.h z (1 - t) ^ (-(1 / 2 - B.h)) := by
      unfold simEta
      rw [hc2]
    have hfac : r⁻¹ * (r ^ 2 + (0:ℝ) ^ 2) = r := by
      rw [show r ^ 2 + (0:ℝ) ^ 2 = r * r by ring, ← mul_assoc, inv_mul_cancel₀ hr.ne', one_mul]
    constructor
    · show inner ℝ (stressDivField B.h B.Tth B.Tz (rotPt r 0 z) t) (eTh (rotPt r 0 z)) = _
      unfold stressDivField
      rw [K1, hsX, hsE, hc2, hrad, hc0, hc1, hfac]
    · show inner ℝ (stressDivField B.h B.Tth B.Tz (rotPt r 0 z) t) eZ = _
      unfold stressDivField
      rw [K2, hsX, hsE, hc2]

  have prof : ∀ (z t q η : ℝ), t < 1 → q = simScale B.h z (1 - t) → η = z * q ^ (-(1 / 2 - B.h)) →
      q < B.qB → ContDiffOn ℝ ∞ (fun Y => B.Tth q Y η) (Set.Ioi 0) ∧
        ContDiffOn ℝ ∞ (fun Y => B.Tz q Y η) (Set.Ioi 0) := by
    intro z t q η ht hqd hηd hqB
    have hτ : 0 < 1 - t := by linarith
    have hq : 0 < q := by rw [hqd]; exact (hB.1.1 z (1 - t) hτ).1
    have hz2 : z ^ 2 < q ^ (1 - 2 * B.h) := by rw [hqd]; exact (hB.1.2.1 z (1 - t) hτ).2
    have hη2 : η ^ 2 < 1 := by
      rw [hηd, mul_pow, ← Real.rpow_natCast (q ^ (-(1 / 2 - B.h))) 2, ← Real.rpow_mul hq.le]
      have he : q ^ (-(1 / 2 - B.h) * ((2:ℕ):ℝ)) = (q ^ (1 - 2 * B.h))⁻¹ := by
        rw [← Real.rpow_neg hq.le]
        congr 1
        push_cast
        ring
      have hp : 0 < q ^ (1 - 2 * B.h) := Real.rpow_pos_of_pos hq _
      rw [he, ← div_eq_mul_inv, div_lt_one hp]
      exact hz2
    have hη := abs_lt.mp ((sq_lt_one_iff_abs_lt_one η).mp hη2)
    have hlog : Real.log q < Real.log B.qB := Real.log_lt_log hq hqB
    have hφ : ContDiff ℝ ∞ (fun Y : ℝ => ((Real.log q, Y, η) : ℝ × ℝ × ℝ)) :=
      contDiff_const.prodMk (contDiff_id.prodMk contDiff_const)
    have hmaps : Set.MapsTo (fun Y : ℝ => ((Real.log q, Y, η) : ℝ × ℝ × ℝ)) (Set.Ioi 0)
        (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1)) := fun Y hY =>
      Set.mk_mem_prod hlog (Set.mk_mem_prod hY ⟨hη.1, hη.2⟩)
    refine ⟨(c9a.comp hφ.contDiffOn hmaps).congr (fun Y _ => ?_),
      (c9b.comp hφ.contDiffOn hmaps).congr (fun Y _ => ?_)⟩
    · show B.Tth q Y η = B.Tth (Real.exp (Real.log q)) Y η
      rw [Real.exp_log hq]
    · show B.Tz q Y η = B.Tz (Real.exp (Real.log q)) Y η
      rw [Real.exp_log hq]

  refine ⟨fun z t ht hqB => ?_, fun ξ h1 _ _ hX => ?_⟩
  · obtain ⟨q, hqd⟩ : ∃ q, q = simScale B.h z (1 - t) := ⟨_, rfl⟩
    obtain ⟨η, hηd⟩ : ∃ η, η = z * q ^ (-(1 / 2 - B.h)) := ⟨_, rfl⟩
    have hq : 0 < q := by rw [hqd]; exact (hB.1.1 z (1 - t) (by linarith)).1
    obtain ⟨hθ, hzz⟩ := prof z t q η ht hqd hηd (by rw [hqd]; exact hqB)
    have M2 := mom2 (fun Y => B.Tth q Y η) B.Xa B.Xb q (q ^ (-(2 + B.h))) hXa hab hq hθ
      (fun Y hY => (hvan q Y η hY).1)
    have M1 := mom1 (fun Y => B.Tz q Y η) B.Xa B.Xb q (q ^ (-(3 / 2 + B.h))) hXa hab hq hzz
      (fun Y hY => (hvan q Y η hY).2)
    have hI1 : (∫ r in Set.Ioi (0:ℝ), r ^ 2 * sBase B 1 (r, z, t, 0)) =
        ∫ r in Set.Ioi (0:ℝ), r ^ 2 * (-(q ^ (-(2 + B.h)) * (deriv (fun Y' => B.Tth q Y' η) (r ^ 2 / (2 * q)) +
          B.Tth q (r ^ 2 / (2 * q)) η / (r ^ 2 / (2 * q)))) * r) := by
      refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun r hr => ?_)
      show r ^ 2 * sBase B 1 (r, z, t, 0) = _
      rw [(frame r z t 0 q η (r ^ 2 / (2 * q)) hr hqd hηd rfl).1]
    have hI2 : (∫ r in Set.Ioi (0:ℝ), r * sBase B 2 (r, z, t, 0)) =
        ∫ r in Set.Ioi (0:ℝ), r * (-(Real.sqrt (2 * (r ^ 2 / (2 * q))) * q ^ (-(3 / 2 + B.h)) *
          (deriv (fun Y' => B.Tz q Y' η) (r ^ 2 / (2 * q)) +
            B.Tz q (r ^ 2 / (2 * q)) η / (2 * (r ^ 2 / (2 * q)))))) := by
      refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun r hr => ?_)
      show r * sBase B 2 (r, z, t, 0) = _
      rw [(frame r z t 0 q η (r ^ 2 / (2 * q)) hr hqd hηd rfl).2]
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hI1]; exact M2.1
    · rw [hI2]; exact M1.1
    · exact M2.2.congr (fun r hr => (frame r z t 0 q η (r ^ 2 / (2 * q)) hr hqd hηd rfl).1)
    · exact M1.2.congr (fun r hr => (frame r z t 0 q η (r ^ 2 / (2 * q)) hr hqd hηd rfl).2)
  · obtain ⟨r, z, t, Y⟩ := ξ
    change 0 < r at h1
    obtain ⟨q, hqd⟩ : ∃ q, q = simScale B.h z (1 - t) := ⟨_, rfl⟩
    obtain ⟨η, hηd⟩ : ∃ η, η = z * q ^ (-(1 / 2 - B.h)) := ⟨_, rfl⟩
    obtain ⟨X, hXd⟩ : ∃ X, X = r ^ 2 / (2 * q) := ⟨_, rfl⟩
    have hX' : X ≤ B.Xa ∨ B.Xb ≤ X := by
      rw [hXd, hqd]
      exact hX
    obtain ⟨e1, e2⟩ := frame r z t Y q η X h1 hqd hηd hXd
    rw [e1, e2, dz (fun Y' => B.Tth q Y' η) B.Xa B.Xb X (fun Y' hY' => (hvan q Y' η hY').1) hX',
      dz (fun Y' => B.Tz q Y' η) B.Xa B.Xb X (fun Y' hY' => (hvan q Y' η hY').2) hX',
      (hvan q X η hX').1, (hvan q X η hX').2]
    simp

theorem stp5_wcov_periodic_shell : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (bw ca cm cd : ℝ), B.ok → GeomPrim5 B G → qsOf l0 ≤ B.qB → StOrd5 B G l0 S bw ca cm cd → (∀ l : ℕ, 4 ≤ l → 0 ≤ bandIdx B.h l) → (∀ k : ℤ, 0 ≤ k → ∀ n m : ℤ, ∃ n' m' : ℤ, Jpow k ((n : ℝ), (m : ℝ)) = ((n' : ℝ), (m' : ℝ))) → (∀ q : ℝ, 0 < q → q < qsOf l0 → ∀ n m : ℤ, IsDeck B.h q ((n : ℝ), (m : ℝ))) → ∀ ξ ∈ DomC B.h (qsOf l0), (∀ (n m : ℤ) (a b : Fin 3), Wcov5 B G l0 S a b (shY ξ ((n : ℝ), (m : ℝ))) = Wcov5 B G l0 S a b ξ) ∧ ((XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → ∀ a b : Fin 3, Wcov5 B G l0 S a b ξ = 0) :=
by
  intro B G l0 S bw ca cm cd hB hG hqsB hSt hband hJ hdeck ξ hξ
  refine ⟨?_, fun hX a b => wcov5_shell_vanish B G l0 S bw ca cm cd hB hqsB hSt a b ξ hξ hX⟩
  obtain ⟨hAw, -, hPsi, hbd, -⟩ := hSt
  have hadd : ∀ (n : ℤ) (Y b : ℝ × ℝ), Jpow n (Y + b) = Jpow n Y + Jpow n b := by
    rintro n ⟨y1, y2⟩ ⟨b1, b2⟩
    simp only [Jpow, vrv, vtv, Prod.mk_add_mk, Prod.smul_mk, smul_eq_mul, Prod.mk.injEq]
    constructor <;> ring
  have hfrac : ∀ (w : ℝ × ℝ) (k1 k2 : ℤ), frac0 (w + ((k1:ℝ), (k2:ℝ))) = frac0 w := by
    rintro ⟨w1, w2⟩ k1 k2
    simp only [frac0, Prod.mk_add_mk, round_add_intCast, Int.cast_add, Prod.mk.injEq]
    constructor <;> ring

  have hphi : ∀ (γ : Lab) (ζ : Cyl) (n m : ℤ), 0 ≤ bandIdx B.h γ.1 →
      phiL5 B G γ (shY ζ ((n : ℝ), (m : ℝ))) = phiL5 B G γ ζ := by
    intro γ ζ n m hk
    obtain ⟨k1, k2, hk12⟩ := hJ _ hk n m
    have hrect : rectW B.h γ (G.ctr γ) (ζ.2.2.2 + ((n : ℝ), (m : ℝ))) =
        rectW B.h γ (G.ctr γ) ζ.2.2.2 := by
      unfold rectW
      rw [hadd, hk12]
      have e : Jpow (bandIdx B.h γ.1) ζ.2.2.2 + ((k1:ℝ), (k2:ℝ)) - G.ctr γ =
          (Jpow (bandIdx B.h γ.1) ζ.2.2.2 - G.ctr γ) + ((k1:ℝ), (k2:ℝ)) := by abel
      rw [e, hfrac]
    have hvco : vco B.h G.r0 γ (G.ctr γ) (ζ.2.2.2 + ((n : ℝ), (m : ℝ))) =
        vco B.h G.r0 γ (G.ctr γ) ζ.2.2.2 := by
      unfold vco etG; rw [hrect]
    show pzr5 B G γ * chartZ B.h γ.1 ζ / epsb B.h γ.1 + sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 * RC γ.1 ζ
      - vco B.h G.r0 γ (G.ctr γ) (ζ.2.2.2 + ((n : ℝ), (m : ℝ))) *
        (pang5 B G γ * Fang B γ.1 ζ + pzr5 B G γ * baseC B γ.1 ζ 2) = _
    rw [hvco]
    rfl

  have hfld : ∀ (y : ℝ³) (t : ℝ) (W : ℝ × ℝ) (n m : ℤ),
      AX5 B G l0 S y t (W + ((n : ℝ), (m : ℝ))) = AX5 B G l0 S y t W ∧
      BX B G l0 S y t (W + ((n : ℝ), (m : ℝ))) = BX B G l0 S y t W := by
    intro y t W n m
    by_cases hc : corrOn B l0 y t
    swap
    · constructor <;> simp only [AX5, BX, if_neg hc]
    have hζ' : ptOf y t (W + ((n : ℝ), (m : ℝ))) = shY (ptOf y t W) ((n : ℝ), (m : ℝ)) := rfl
    have hζD : ptOf y t W ∈ DomC B.h (qsOf l0) := ⟨hc.1, hc.2.1, hc.2.2⟩
    have hq0 : 0 < qC B.h (ptOf y t W) :=
      (hB.1.1 (ptOf y t W).2.1 (1 - (ptOf y t W).2.2.1) (by linarith [hζD.2.1])).1
    have hD : IsDeck B.h (qC B.h (ptOf y t W)) ((n : ℝ), (m : ℝ)) := hdeck _ hq0 hζD.2.2 n m
    have hqq : qC B.h (shY (ptOf y t W) ((n : ℝ), (m : ℝ))) = qC B.h (ptOf y t W) := rfl
    have hP : S.Psi (shY (ptOf y t W) ((n : ℝ), (m : ℝ))) = S.Psi (ptOf y t W) :=
      hPsi.2.1 _ hζD _ hD
    have hb : S.bdir (shY (ptOf y t W) ((n : ℝ), (m : ℝ))) = S.bdir (ptOf y t W) :=
      hbd.2.1 _ hζD _ hD
    have h40l : 40 ≤ G.lmin := hG.1.2.2.2.2
    have hw : waveV5 B G S.Aw (thetaOf y) (shY (ptOf y t W) ((n : ℝ), (m : ℝ))) =
        waveV5 B G S.Aw (thetaOf y) (ptOf y t W) := by
      funext i
      unfold waveV5
      congr 1
      apply finsum_congr
      intro γ
      apply finsum_congr
      intro k
      have hA : S.Aw γ k (shY (ptOf y t W) ((n : ℝ), (m : ℝ))) = S.Aw γ k (ptOf y t W) :=
        hAw.2.2.1 γ k _ hζD _ hD
      rw [hA]
      by_cases h0 : S.Aw γ k (ptOf y t W) = 0
      · rw [h0]; simp
      · have hS := hAw.2.2.2.1 γ k _ hζD h0
        have h40 : 4 ≤ γ.1 := le_trans (by omega) hS.1.1
        have hph := hphi γ (ptOf y t W) n m (hband _ h40)
        unfold ephase5
        rw [hph]
    constructor <;> simp only [AX5, BX, if_pos hc, hζ', hqq, hP, hb, hw]

  have hu : ∀ (x : ℝ³) (t : ℝ) (Y : ℝ × ℝ) (n m : ℤ),
      uX5 B G l0 S x t (Y + ((n : ℝ), (m : ℝ))) = uX5 B G l0 S x t Y := by
    intro x t Y n m
    have hf : (fun y => evOff B.h (AX5 B G l0 S) (Y + ((n : ℝ), (m : ℝ)) - Yph B.h (rad x) t) y t) =
        (fun y => evOff B.h (AX5 B G l0 S) (Y - Yph B.h (rad x) t) y t) := by
      funext y
      simp only [evOff]
      have e : Yph B.h (rad y) t + (Y + ((n : ℝ), (m : ℝ)) - Yph B.h (rad x) t) =
          (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t)) + ((n : ℝ), (m : ℝ)) := by abel
      rw [e]
      exact (hfld y t _ n m).1
    show curl3 (fun y => evOff B.h (AX5 B G l0 S) (Y + ((n : ℝ), (m : ℝ)) - Yph B.h (rad x) t) y t) x
        + BX B G l0 S x t (Y + ((n : ℝ), (m : ℝ))) =
      curl3 (fun y => evOff B.h (AX5 B G l0 S) (Y - Yph B.h (rad x) t) y t) x + BX B G l0 S x t Y
    rw [hf, (hfld x t Y n m).2]
  intro n m a b
  have hc : ∀ (θ : ℝ) (e : Fin 3),
      ucyl5 B G l0 S θ (shY ξ ((n : ℝ), (m : ℝ))) e = ucyl5 B G l0 S θ ξ e := by
    intro θ e
    show inner ℝ (uX5 B G l0 S (rotPt ξ.1 θ ξ.2.1) ξ.2.2.1 (ξ.2.2.2 + ((n : ℝ), (m : ℝ))))
      (frameAt θ ξ e) = _
    rw [hu]
    rfl
  unfold Wcov5
  simp only [hc]

theorem pm5_torus_shift_mean : ∀ (φ : ℝ × ℝ → ℝ) (c : ℝ × ℝ), Continuous φ → (∀ (Y : ℝ × ℝ) (n m : ℤ), φ (Y + ((n : ℝ), (m : ℝ))) = φ Y) → ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, φ (Y + c) = ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, φ Y :=
by
  intro φ c hφ hper
  have h1d : ∀ (ψ : ℝ → ℝ) (a : ℝ), (∀ s : ℝ, ψ (s + 1) = ψ s) →
      ∫ s in Set.Icc (0:ℝ) 1, ψ (s + a) = ∫ s in Set.Icc (0:ℝ) 1, ψ s := by
    intro ψ a hψ
    have hP : Function.Periodic ψ 1 := hψ
    rw [MeasureTheory.integral_Icc_eq_integral_Ioc, MeasureTheory.integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le zero_le_one, ← intervalIntegral.integral_of_le zero_le_one,
      intervalIntegral.integral_comp_add_right ψ a, zero_add, add_comm 1 a,
      hP.intervalIntegral_add_eq a 0, zero_add]
  have hK : IsCompact (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
  have hI1 : MeasureTheory.IntegrableOn (fun Y => φ (Y + c)) (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)
      ((MeasureTheory.volume : MeasureTheory.Measure ℝ).prod MeasureTheory.volume) := by
    rw [← MeasureTheory.Measure.volume_eq_prod]
    exact (hφ.comp (continuous_id.add continuous_const)).continuousOn.integrableOn_compact hK
  have hI2 : MeasureTheory.IntegrableOn φ (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)
      ((MeasureTheory.volume : MeasureTheory.Measure ℝ).prod MeasureTheory.volume) := by
    rw [← MeasureTheory.Measure.volume_eq_prod]
    exact hφ.continuousOn.integrableOn_compact hK
  rw [MeasureTheory.Measure.volume_eq_prod ℝ ℝ, MeasureTheory.setIntegral_prod _ hI1,
    MeasureTheory.setIntegral_prod _ hI2]
  have hinner : ∀ x : ℝ, ∫ y in Set.Icc (0:ℝ) 1, φ ((x, y) + c) =
      ∫ y in Set.Icc (0:ℝ) 1, φ (x + c.1, y) := by
    intro x
    have key := h1d (fun s => φ (x + c.1, s)) c.2 (fun s => by
      have h := hper (x + c.1, s) 0 1
      simp only [Int.cast_zero, Int.cast_one, Prod.mk_add_mk, add_zero] at h
      exact h)
    exact key
  have hΦ : ∀ a : ℝ, (∫ y in Set.Icc (0:ℝ) 1, φ (a + 1, y)) = ∫ y in Set.Icc (0:ℝ) 1, φ (a, y) := by
    intro a
    congr 1
    funext y
    have h := hper (a, y) 1 0
    simp only [Int.cast_zero, Int.cast_one, Prod.mk_add_mk, add_zero] at h
    exact h
  simp_rw [hinner]
  exact h1d (fun a => ∫ y in Set.Icc (0:ℝ) 1, φ (a, y)) c.1 hΦ

theorem pm5_grP5_regular : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState), B.ok → IsOpen (DomC B.h (qsOf l0)) → (∀ f : Cyl → ℝ, ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) → ContDiffOn ℝ ∞ (dR B.h f) (DomC B.h (qsOf l0)) ∧ ContDiffOn ℝ ∞ (dZ f) (DomC B.h (qsOf l0)) ∧ ContDiffOn ℝ ∞ (dT f) (DomC B.h (qsOf l0))) → (∀ f : Cyl → ℝ, (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → f ξ = 0) → ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → dR B.h f ξ = 0 ∧ dZ f ξ = 0 ∧ dT f ξ = 0) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (fun ξ => ubase B ξ a) (DomC B.h (qsOf l0))) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 S a) (DomC B.h (qsOf l0))) → (∀ a b : Fin 3, ContDiffOn ℝ ∞ (Wcov5 B G l0 S a b) (DomC B.h (qsOf l0))) → (∀ ξ ∈ DomC B.h (qsOf l0), ∀ n m : ℤ, (∀ a : Fin 3, mcor5 B G l0 S a (shY ξ ((n : ℝ), (m : ℝ))) = mcor5 B G l0 S a ξ) ∧ (∀ a b : Fin 3, Wcov5 B G l0 S a b (shY ξ ((n : ℝ), (m : ℝ))) = Wcov5 B G l0 S a b ξ)) → (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → (∀ a : Fin 3, mcor5 B G l0 S a ξ = 0) ∧ (∀ a b : Fin 3, Wcov5 B G l0 S a b ξ = 0)) → ContDiffOn ℝ ∞ (grP5 B G l0 S) (DomC B.h (qsOf l0)) ∧ (∀ ξ ∈ DomC B.h (qsOf l0), ∀ n m : ℤ, grP5 B G l0 S (shY ξ ((n : ℝ), (m : ℝ))) = grP5 B G l0 S ξ) ∧ (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → grP5 B G l0 S ξ = 0) :=
by
  intro B G l0 S hB hO hdiff hshellD hub hmc hWc hPer hShell
  obtain ⟨F1, hF1⟩ : ∃ F1 : Cyl → ℝ, F1 = fun η => 2 * ubase B η 0 * mcor5 B G l0 S 0 η +
      mcor5 B G l0 S 0 η ^ 2 + Wcov5 B G l0 S 0 0 η := ⟨_, rfl⟩
  obtain ⟨F2, hF2⟩ : ∃ F2 : Cyl → ℝ, F2 = fun η => ubase B η 0 * mcor5 B G l0 S 2 η +
      ubase B η 2 * mcor5 B G l0 S 0 η + mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η +
      Wcov5 B G l0 S 2 0 η := ⟨_, rfl⟩
  obtain ⟨F3, hF3⟩ : ∃ F3 : Cyl → ℝ, F3 = fun η => 2 * ubase B η 1 * mcor5 B G l0 S 1 η +
      mcor5 B G l0 S 1 η ^ 2 + Wcov5 B G l0 S 1 1 η := ⟨_, rfl⟩
  have key : ∀ ξ : Cyl, grP5 B G l0 S ξ = (0:ℝ) - dT (mcor5 B G l0 S 0) ξ
      - (dR B.h F1 ξ + F1 ξ / ξ.1) - dZ F2 ξ + F3 ξ / ξ.1
      + (lap0 B.h (mcor5 B G l0 S 0) ξ - mcor5 B G l0 S 0 ξ / ξ.1 ^ 2) := by
    intro ξ
    rw [hF1, hF2, hF3]
    rfl

  have hβs : ContDiffOn ℝ ∞ (mcor5 B G l0 S 0) (DomC B.h (qsOf l0)) := hmc 0
  have hF1s : ContDiffOn ℝ ∞ F1 (DomC B.h (qsOf l0)) := by
    rw [hF1]
    exact (((contDiffOn_const.mul (hub 0)).mul (hmc 0)).add ((hmc 0).pow 2)).add (hWc 0 0)
  have hF2s : ContDiffOn ℝ ∞ F2 (DomC B.h (qsOf l0)) := by
    rw [hF2]
    exact ((((hub 0).mul (hmc 2)).add ((hub 2).mul (hmc 0))).add ((hmc 0).mul (hmc 2))).add
      (hWc 2 0)
  have hF3s : ContDiffOn ℝ ∞ F3 (DomC B.h (qsOf l0)) := by
    rw [hF3]
    exact (((contDiffOn_const.mul (hub 1)).mul (hmc 1)).add ((hmc 1).pow 2)).add (hWc 1 1)
  have hdiv : ∀ f : Cyl → ℝ, ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ (fun ξ : Cyl => f ξ / ξ.1) (DomC B.h (qsOf l0)) := by
    intro f hf
    exact hf.div contDiff_fst.contDiffOn (fun x hx => ne_of_gt hx.1)
  have hdiv2 : ContDiffOn ℝ ∞ (fun ξ : Cyl => mcor5 B G l0 S 0 ξ / ξ.1 ^ 2)
      (DomC B.h (qsOf l0)) :=
    hβs.div (contDiff_fst.pow 2).contDiffOn (fun x hx => pow_ne_zero 2 (ne_of_gt hx.1))
  have hlap : ContDiffOn ℝ ∞ (lap0 B.h (mcor5 B G l0 S 0)) (DomC B.h (qsOf l0)) := by
    have h := ((hdiff _ (hdiff _ hβs).1).1.add (hdiv _ (hdiff _ hβs).1)).add
      (hdiff _ (hdiff _ hβs).2.1).2.1
    exact h
  have hRHS : ContDiffOn ℝ ∞ (fun ξ : Cyl => (0:ℝ) - dT (mcor5 B G l0 S 0) ξ
      - (dR B.h F1 ξ + F1 ξ / ξ.1) - dZ F2 ξ + F3 ξ / ξ.1
      + (lap0 B.h (mcor5 B G l0 S 0) ξ - mcor5 B G l0 S 0 ξ / ξ.1 ^ 2)) (DomC B.h (qsOf l0)) :=
    ((((contDiffOn_const.sub (hdiff _ hβs).2.2).sub ((hdiff _ hF1s).1.add (hdiv F1 hF1s))).sub
      (hdiff _ hF2s).2.1).add (hdiv F3 hF3s)).add (hlap.sub hdiv2)
  have hA : ContDiffOn ℝ ∞ (grP5 B G l0 S) (DomC B.h (qsOf l0)) :=
    hRHS.congr (fun ξ _ => key ξ)

  have hshift : ∀ (f : Cyl → ℝ) (c : ℝ × ℝ), (∀ η ∈ DomC B.h (qsOf l0), f (shY η c) = f η) →
      ∀ ξ ∈ DomC B.h (qsOf l0), fderiv ℝ f (shY ξ c) = fderiv ℝ f ξ := by
    intro f c hf ξ hξ
    have hadd : ∀ η : Cyl, shY η c = η + ((0:ℝ), (0:ℝ), (0:ℝ), c) := by
      intro η
      obtain ⟨a1, a2, a3, a4⟩ := η
      simp [shY]
    have hev : (fun η => f (η + ((0:ℝ), (0:ℝ), (0:ℝ), c))) =ᶠ[nhds ξ] f :=
      Filter.eventuallyEq_of_mem (hO.mem_nhds hξ) (fun η hη => by
        show f (η + ((0:ℝ), (0:ℝ), (0:ℝ), c)) = f η
        rw [← hadd η]
        exact hf η hη)
    rw [hadd ξ, ← fderiv_comp_add_right, hev.fderiv_eq]
  have hD : ∀ (f : Cyl → ℝ) (c : ℝ × ℝ), (∀ η ∈ DomC B.h (qsOf l0), f (shY η c) = f η) →
      ∀ ξ ∈ DomC B.h (qsOf l0), dR B.h f (shY ξ c) = dR B.h f ξ ∧ dZ f (shY ξ c) = dZ f ξ ∧
        dT f (shY ξ c) = dT f ξ := by
    intro f c hf ξ hξ
    have h := hshift f c hf ξ hξ
    refine ⟨?_, ?_, ?_⟩
    · show fderiv ℝ f (shY ξ c) (1, 0, 0, (drx B.h * (shY ξ c).1 ^ (drx B.h - 1)) • vrv) =
        fderiv ℝ f ξ (1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)
      rw [h]
      all_goals rfl
    · show fderiv ℝ f (shY ξ c) (0, 1, 0, 0) = fderiv ℝ f ξ (0, 1, 0, 0)
      rw [h]
    · show fderiv ℝ f (shY ξ c) (0, 0, 1, vtv) = fderiv ℝ f ξ (0, 0, 1, vtv)
      rw [h]
  have hB' : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ n m : ℤ,
      grP5 B G l0 S (shY ξ ((n : ℝ), (m : ℝ))) = grP5 B G l0 S ξ := by
    intro ξ hξ n m
    have hub_inv : ∀ (η : Cyl) (a : Fin 3), ubase B (shY η ((n : ℝ), (m : ℝ))) a = ubase B η a :=
      fun _ _ => rfl
    have hβP : ∀ η ∈ DomC B.h (qsOf l0),
        mcor5 B G l0 S 0 (shY η ((n : ℝ), (m : ℝ))) = mcor5 B G l0 S 0 η :=
      fun η hη => (hPer η hη n m).1 0
    have hF1P : ∀ η ∈ DomC B.h (qsOf l0), F1 (shY η ((n : ℝ), (m : ℝ))) = F1 η := by
      intro η hη
      rw [hF1]
      simp only [hub_inv, (hPer η hη n m).1, (hPer η hη n m).2]
    have hF2P : ∀ η ∈ DomC B.h (qsOf l0), F2 (shY η ((n : ℝ), (m : ℝ))) = F2 η := by
      intro η hη
      rw [hF2]
      simp only [hub_inv, (hPer η hη n m).1, (hPer η hη n m).2]
    have hF3P : ∀ η ∈ DomC B.h (qsOf l0), F3 (shY η ((n : ℝ), (m : ℝ))) = F3 η := by
      intro η hη
      rw [hF3]
      simp only [hub_inv, (hPer η hη n m).1, (hPer η hη n m).2]
    have hRβP : ∀ η ∈ DomC B.h (qsOf l0),
        dR B.h (mcor5 B G l0 S 0) (shY η ((n : ℝ), (m : ℝ))) = dR B.h (mcor5 B G l0 S 0) η :=
      fun η hη => (hD _ _ hβP η hη).1
    have hZβP : ∀ η ∈ DomC B.h (qsOf l0),
        dZ (mcor5 B G l0 S 0) (shY η ((n : ℝ), (m : ℝ))) = dZ (mcor5 B G l0 S 0) η :=
      fun η hη => (hD _ _ hβP η hη).2.1
    have e1 := (hD _ _ hβP ξ hξ).2.2
    have e2 := (hD _ _ hF1P ξ hξ).1
    have e3 := hF1P ξ hξ
    have e4 := (hD _ _ hF2P ξ hξ).2.1
    have e5 := hF3P ξ hξ
    have e6 := (hD _ _ hRβP ξ hξ).1
    have e7 := hRβP ξ hξ
    have e8 := (hD _ _ hZβP ξ hξ).2.1
    have e9 := hβP ξ hξ
    have e10 : (shY ξ ((n : ℝ), (m : ℝ))).1 = ξ.1 := rfl
    rw [key (shY ξ ((n : ℝ), (m : ℝ))), key ξ]
    unfold lap0
    rw [e1, e2, e3, e4, e5, e6, e7, e8, e9, e10]

  have hC : ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) →
      grP5 B G l0 S ξ = 0 := by
    have hβZ : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) →
        mcor5 B G l0 S 0 η = 0 := fun η hη hX => (hShell η hη hX).1 0
    have hF1Z : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) → F1 η = 0 := by
      intro η hη hX
      rw [hF1]
      simp [(hShell η hη hX).1, (hShell η hη hX).2]
    have hF2Z : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) → F2 η = 0 := by
      intro η hη hX
      rw [hF2]
      simp [(hShell η hη hX).1, (hShell η hη hX).2]
    have hF3Z : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) → F3 η = 0 := by
      intro η hη hX
      rw [hF3]
      simp [(hShell η hη hX).1, (hShell η hη hX).2]
    have hRβZ : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) →
        dR B.h (mcor5 B G l0 S 0) η = 0 := fun η hη hX => (hshellD _ hβZ η hη hX).1
    have hZβZ : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) →
        dZ (mcor5 B G l0 S 0) η = 0 := fun η hη hX => (hshellD _ hβZ η hη hX).2.1
    intro ξ hξ hX
    have e1 := (hshellD _ hβZ ξ hξ hX).2.2
    have e2 := (hshellD _ hF1Z ξ hξ hX).1
    have e3 := hF1Z ξ hξ hX
    have e4 := (hshellD _ hF2Z ξ hξ hX).2.1
    have e5 := hF3Z ξ hξ hX
    have e6 := (hshellD _ hRβZ ξ hξ hX).1
    have e7 := hRβZ ξ hξ hX
    have e8 := (hshellD _ hZβZ ξ hξ hX).2.1
    have e9 := hβZ ξ hξ hX
    rw [key ξ]
    unfold lap0
    rw [e1, e2, e3, e4, e5, e6, e7, e8, e9]
    simp
  exact ⟨hA, hB', hC⟩

theorem pm5_icut_yavg : ∀ (B : BG) (g : Cyl → ℝ) (z t : ℝ), B.ok → t < 1 → ContinuousOn (fun p : ℝ × (ℝ × ℝ) => g (p.1, z, t, p.2)) (Set.Ioi (0:ℝ) ×ˢ Set.univ) → (∀ (r : ℝ) (Y : ℝ × ℝ) (n m : ℤ), 0 < r → g (r, z, t, Y + ((n : ℝ), (m : ℝ))) = g (r, z, t, Y)) → (∀ (r : ℝ) (Y : ℝ × ℝ), 0 < r → (XC B.h (r, z, t, Y) < B.Xa ∨ B.Xb < XC B.h (r, z, t, Y)) → g (r, z, t, Y) = 0) → (∀ (φ : ℝ × ℝ → ℝ) (c : ℝ × ℝ), Continuous φ → (∀ (Y : ℝ × ℝ) (n m : ℤ), φ (Y + ((n : ℝ), (m : ℝ))) = φ Y) → ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, φ (Y + c) = ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, φ Y) → ∀ r : ℝ, 0 < r → yAvg (Icut B g) (r, z, t, 0) = (∫ r' in (0:ℝ)..r, yAvg g (r', z, t, 0)) - chiM B (XC B.h (r, z, t, 0)) * ∫ r' in Set.Ioi (0:ℝ), yAvg g (r', z, t, 0) :=
by
  intro B g z t hB ht hc hp hs hT r hr
  have hq0 : 0 < simScale B.h z (1 - t) := (hB.1.1 z (1 - t) (by linarith)).1
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -⟩ := hB.2.1
  set q := simScale B.h z (1 - t) with hqdef
  set ρa := Real.sqrt (2 * B.Xa * q) with hρa
  set ρb := Real.sqrt (2 * B.Xb * q) with hρb
  have hρa0 : 0 < ρa := Real.sqrt_pos.mpr (mul_pos (mul_pos two_pos hXa) hq0)
  have h2q : (0:ℝ) < 2 * q := by linarith
  set d := drx B.h with hd
  set χ := chiM B (XC B.h (r, z, t, 0)) with hχ
  set H : ℝ × ℝ → ℝ → ℝ := fun Y r' => g (r', z, t, Y + (r' ^ d - r ^ d) • vrv) with hH
  have hXC : ∀ (r' : ℝ) (Y : ℝ × ℝ), XC B.h (r', z, t, Y) = r' ^ 2 / (2 * q) := fun r' Y => rfl

  have hsupp : ∀ (Y : ℝ × ℝ) (r' : ℝ), 0 < r' → (r' < ρa ∨ ρb < r') → H Y r' = 0 := by
    intro Y r' hr' h
    apply hs r' _ hr'
    rw [hXC]
    rcases h with h | h
    · left
      have h' := (Real.lt_sqrt hr'.le).mp h
      rw [div_lt_iff₀ h2q]; linarith
    · right
      have h' := (Real.sqrt_lt' hr').mp h
      rw [lt_div_iff₀ h2q]; linarith

  have hHc : ContinuousOn (Function.uncurry H) (Set.univ ×ˢ Set.Ioi (0:ℝ)) := by
    have h1 : ContinuousOn (fun p : (ℝ × ℝ) × ℝ => p.2 ^ d) (Set.univ ×ˢ Set.Ioi (0:ℝ)) :=
      ContinuousOn.rpow_const continuous_snd.continuousOn (fun x hx => Or.inl (ne_of_gt hx.2))
    have hσ : ContinuousOn (fun p : (ℝ × ℝ) × ℝ => (p.2, p.1 + (p.2 ^ d - r ^ d) • vrv))
        (Set.univ ×ˢ Set.Ioi (0:ℝ)) :=
      continuous_snd.continuousOn.prodMk
        (continuous_fst.continuousOn.add ((h1.sub continuousOn_const).smul continuousOn_const))
    exact hc.comp hσ (fun p hp => ⟨hp.2, Set.mem_univ _⟩)

  have hswap : ∀ I : Set ℝ, MeasurableSet I → I ⊆ Set.Ioi 0 →
      MeasureTheory.IntegrableOn (fun Y => ∫ r' in I, H Y r') (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ∧
      (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, ∫ r' in I, H Y r') =
        ∫ r' in I, ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, H Y r' := by
    intro I hI hIpos
    have hK : IsCompact ((Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ×ˢ Set.Icc ρa ρb) :=
      (isCompact_Icc.prod isCompact_Icc).prod isCompact_Icc
    have hKc : ContinuousOn (Function.uncurry H)
        ((Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ×ˢ Set.Icc ρa ρb) :=
      hHc.mono (fun p hp => ⟨Set.mem_univ _, lt_of_lt_of_le hρa0 hp.2.1⟩)
    have hKi : MeasureTheory.IntegrableOn (Function.uncurry H)
        ((Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ×ˢ Set.Icc ρa ρb) :=
      hKc.integrableOn_compact hK
    have hSi : MeasureTheory.IntegrableOn (Function.uncurry H)
        ((Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ×ˢ I) := by
      refine hKi.of_forall_sdiff_eq_zero ((measurableSet_Icc.prod measurableSet_Icc).prod hI) ?_
      intro p hp
      obtain ⟨⟨hp1, hp2⟩, hpK⟩ := hp
      apply hsupp p.1 p.2 (hIpos hp2)
      by_contra hcon
      push_neg at hcon
      exact hpK ⟨hp1, hcon.1, hcon.2⟩
    have hprod : MeasureTheory.Integrable (Function.uncurry H)
        ((MeasureTheory.volume.restrict (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)).prod
          (MeasureTheory.volume.restrict I)) := by
      rw [MeasureTheory.Measure.prod_restrict, ← MeasureTheory.Measure.volume_eq_prod]
      exact hSi
    exact ⟨hprod.integral_prod_left, MeasureTheory.integral_integral_swap hprod⟩

  have hinner : ∀ r' : ℝ, 0 < r' →
      (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, H Y r') = yAvg g (r', z, t, 0) := by
    intro r' hr'
    have hφ : Continuous (fun Y : ℝ × ℝ => g (r', z, t, Y)) :=
      hc.comp_continuous (Continuous.prodMk continuous_const continuous_id)
        (fun Y => ⟨hr', Set.mem_univ _⟩)
    exact hT (fun Y : ℝ × ℝ => g (r', z, t, Y)) ((r' ^ d - r ^ d) • vrv) hφ
      (fun Y n m => hp r' Y n m hr')

  have hL : yAvg (Icut B g) (r, z, t, 0) = ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
      ((∫ r' in Set.Ioc 0 r, H Y r') - χ * ∫ r' in Set.Ioi 0, H Y r') := by
    show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, Icut B g (r, z, t, Y)) = _
    refine MeasureTheory.setIntegral_congr_fun (measurableSet_Icc.prod measurableSet_Icc)
      (fun Y _ => ?_)
    show (∫ r' in (0:ℝ)..r, H Y r') - χ * ∫ r' in Set.Ioi (0:ℝ), H Y r' = _
    rw [intervalIntegral.integral_of_le hr.le]
  obtain ⟨hPi, hPs⟩ := hswap (Set.Ioc 0 r) measurableSet_Ioc (fun x hx => hx.1)
  obtain ⟨hQi, hQs⟩ := hswap (Set.Ioi 0) measurableSet_Ioi (fun x hx => hx)
  rw [hL, MeasureTheory.integral_sub hPi (MeasureTheory.Integrable.const_mul hQi χ),
    MeasureTheory.integral_const_mul, hPs, hQs,
    MeasureTheory.setIntegral_congr_fun measurableSet_Ioc (fun r' hr' => hinner r' hr'.1),
    MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun r' hr' => hinner r' hr'),
    intervalIntegral.integral_of_le hr.le]

theorem pm5_moment_ibp : ∀ (F : ℝ → ℝ) (a b : ℝ), 0 < a → a ≤ b → ContinuousOn F (Set.Ioi (0:ℝ)) → (∀ r : ℝ, 0 < r → (r < a ∨ b < r) → F r = 0) → (∫ r in Set.Ioi (0:ℝ), F r) = 0 → (∫ r in Set.Ioi (0:ℝ), r ^ 1 * ∫ s in (0:ℝ)..r, F s) = -(1/2) * ∫ r in Set.Ioi (0:ℝ), r ^ 2 * F r :=
by
  intro F a b ha hab hF hZ hM
  set Ψ : ℝ → ℝ := fun r => ∫ s in (0:ℝ)..r, F s with hΨ
  have hsub : Set.Icc a b ⊆ Set.Ioi (0:ℝ) := fun x hx => lt_of_lt_of_le ha hx.1
  have hIab : IntegrableOn F (Set.Icc a b) := (hF.mono hsub).integrableOn_Icc
  have hzero : ∀ y, 0 < y → y ∉ Set.Icc a b → F y = 0 := by
    intro y hy hny
    apply hZ y hy
    by_contra h
    push_neg at h
    exact hny ⟨h.1, h.2⟩
  have hII : ∀ x, 0 < x → IntervalIntegrable F volume 0 x := by
    intro x hx
    rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hx.le]
    exact hIab.of_forall_sdiff_eq_zero measurableSet_Ioc (fun y hy => hzero y hy.1.1 hy.2)
  have hΨa : ∀ r, 0 ≤ r → r ≤ a → Ψ r = 0 := by
    intro r hr0 hra
    show (∫ s in (0:ℝ)..r, F s) = 0
    rw [intervalIntegral.integral_of_le hr0, MeasureTheory.integral_Ioc_eq_integral_Ioo]
    rw [setIntegral_congr_fun measurableSet_Ioo (g := fun _ => (0:ℝ))
      (fun x hx => hZ x hx.1 (Or.inl (lt_of_lt_of_le hx.2 hra)))]
    simp
  have hΨb : ∀ r, b ≤ r → Ψ r = 0 := by
    intro r hbr
    have hr0 : 0 ≤ r := by linarith
    show (∫ s in (0:ℝ)..r, F s) = 0
    rw [intervalIntegral.integral_of_le hr0]
    have h1 : (∫ x in Set.Ioi (0:ℝ), F x) = ∫ x in Set.Ioc (0:ℝ) r, F x := by
      apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi
        Set.Ioc_subset_Ioi_self
      intro x hx
      apply hZ x hx.1
      right
      have : ¬ x ≤ r := fun h => hx.2 ⟨hx.1, h⟩
      linarith [not_le.mp this]
    rw [← h1, hM]
  have hL : (∫ r in Set.Ioi (0:ℝ), r ^ 1 * Ψ r) = ∫ r in a..b, r ^ 1 * Ψ r := by
    rw [intervalIntegral.integral_of_le hab, ← MeasureTheory.integral_Icc_eq_integral_Ioc]
    apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi hsub
    intro x hx
    have hx0 : 0 < x := hx.1
    rcases le_or_gt x a with h | h
    · rw [hΨa x hx0.le h, mul_zero]
    · have hbx : b < x := by
        by_contra h'
        push_neg at h'
        exact hx.2 ⟨h.le, h'⟩
      rw [hΨb x hbx.le, mul_zero]
  have hR : (∫ r in Set.Ioi (0:ℝ), r ^ 2 * F r) = ∫ r in a..b, r ^ 2 * F r := by
    rw [intervalIntegral.integral_of_le hab, ← MeasureTheory.integral_Icc_eq_integral_Ioc]
    apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi hsub
    intro x hx
    rw [hzero x hx.1 hx.2, mul_zero]
  have hderiv : ∀ x ∈ Set.uIcc a b, HasDerivAt Ψ (F x) x := by
    intro x hx
    rw [Set.uIcc_of_le hab] at hx
    have hx0 : 0 < x := hsub hx
    exact intervalIntegral.integral_hasDerivAt_right (hII x hx0)
      (hF.stronglyMeasurableAtFilter isOpen_Ioi x hx0)
      (hF.continuousAt (isOpen_Ioi.mem_nhds hx0))
  have hv : ∀ x ∈ Set.uIcc a b, HasDerivAt (fun x : ℝ => x ^ 2 / 2) x x := by
    intro x _
    have := (hasDerivAt_pow 2 x).div_const 2
    convert this using 1
    push_cast
    ring
  have hFab : IntervalIntegrable F volume a b := by
    apply ContinuousOn.intervalIntegrable
    rw [Set.uIcc_of_le hab]
    exact hF.mono hsub
  have hibp := intervalIntegral.integral_mul_deriv_eq_deriv_mul (u := Ψ)
    (v := fun x : ℝ => x ^ 2 / 2) (u' := F) (v' := fun x : ℝ => x) hderiv hv hFab
    (continuous_id.intervalIntegrable a b)
  beta_reduce at hibp
  rw [hΨa a ha.le le_rfl, hΨb b le_rfl] at hibp
  show (∫ r in Set.Ioi (0:ℝ), r ^ 1 * Ψ r) = _
  rw [hL, hR]
  have e1 : (∫ r in a..b, r ^ 1 * Ψ r) = ∫ x in a..b, Ψ x * x := by
    apply intervalIntegral.integral_congr
    intro x _
    show x ^ 1 * Ψ x = Ψ x * x
    ring
  have e2 : (∫ x in a..b, F x * (x ^ 2 / 2)) = (1/2) * ∫ x in a..b, x ^ 2 * F x := by
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr
    intro x _
    show F x * (x ^ 2 / 2) = 1 / 2 * (x ^ 2 * F x)
    ring
  rw [e1, hibp, e2]
  ring

theorem stp5_pressure_moment : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState), B.ok → IsOpen (DomC B.h (qsOf l0)) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (fun ξ => ubase B ξ a) (DomC B.h (qsOf l0))) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 S a) (DomC B.h (qsOf l0))) → (∀ a b : Fin 3, ContDiffOn ℝ ∞ (Wcov5 B G l0 S a b) (DomC B.h (qsOf l0))) → ContDiffOn ℝ ∞ (pmP5 B G l0 S) (DomC B.h (qsOf l0)) → (∀ ξ ∈ DomC B.h (qsOf l0), ∀ n m : ℤ, (∀ a : Fin 3, mcor5 B G l0 S a (shY ξ ((n : ℝ), (m : ℝ))) = mcor5 B G l0 S a ξ) ∧ (∀ a b : Fin 3, Wcov5 B G l0 S a b (shY ξ ((n : ℝ), (m : ℝ))) = Wcov5 B G l0 S a b ξ) ∧ pmP5 B G l0 S (shY ξ ((n : ℝ), (m : ℝ))) = pmP5 B G l0 S ξ) → (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → (∀ a : Fin 3, mcor5 B G l0 S a ξ = 0) ∧ (∀ a b : Fin 3, Wcov5 B G l0 S a b ξ = 0) ∧ pmP5 B G l0 S ξ = 0) → ∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → radMom (pmP5 B G l0 S) 1 z t = -(1/2) * radMom (grP5 B G l0 S) 2 z t + (1/2) * (∫ r in Set.Ioi (0:ℝ), r ^ 2 * rhoP B (r, z, t, 0)) * calP5 B G l0 S z t :=
by
  intro B G l0 S hB hDo hub hmc hWc hpm hPer hShell z t ht hq
  obtain ⟨-, -, -, -, hdiff, hshell⟩ := domc_open_calculus B (qsOf l0) hB
  have hgr := pm5_grP5_regular B G l0 S hB hDo hdiff hshell hub hmc hWc
    (fun ξ hξ n m => ⟨(hPer ξ hξ n m).1, (hPer ξ hξ n m).2.1⟩)
    (fun ξ hξ hX => ⟨(hShell ξ hξ hX).1, (hShell ξ hξ hX).2.1⟩)
  have hq0 : 0 < simScale B.h z (1 - t) := (hB.1.1 z (1 - t) (by linarith)).1
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -⟩ := hB.2.1

  have hρc : Continuous (fun r : ℝ => rhoP B (r, z, t, 0)) := by
    show Continuous (fun r : ℝ => simScale B.h z (1 - t) ^ (-(1/2:ℝ)) *
      rhoHat B (r / Real.sqrt (simScale B.h z (1 - t))))
    have hs : Continuous Real.smoothTransition := Real.smoothTransition.continuous
    unfold rhoHat bumpR
    fun_prop
  have hρY : ∀ (r : ℝ) (Y : ℝ × ℝ), rhoP B (r, z, t, Y) = rhoP B (r, z, t, 0) := fun r Y => rfl
  have hb : ∀ u : ℝ, 1 < u ^ 2 → bumpR u = 0 := by
    intro u hu
    unfold bumpR
    exact Real.smoothTransition.zero_of_nonpos (by linarith)
  have hρ0 : ∀ r : ℝ, 0 < r → (XC B.h (r, z, t, 0) < B.Xa ∨ B.Xb < XC B.h (r, z, t, 0)) →
      rhoP B (r, z, t, 0) = 0 := by
    intro r hr hX
    have hXv : XC B.h (r, z, t, 0) = r ^ 2 / (2 * simScale B.h z (1 - t)) := rfl
    rw [hXv] at hX
    show simScale B.h z (1 - t) ^ (-(1/2:ℝ)) * rhoHat B (r / Real.sqrt (simScale B.h z (1 - t))) = 0
    unfold rhoHat
    set q := simScale B.h z (1 - t) with hqd
    have hsq : 0 < Real.sqrt q := Real.sqrt_pos.mpr hq0
    set s := r / Real.sqrt q with hs
    set s1 := Real.sqrt (2 * B.m1) with hs1d
    set s2 := Real.sqrt (2 * B.m2) with hs2d
    have hs0 : 0 < s := div_pos hr hsq
    have hs2 : s ^ 2 = 2 * (r ^ 2 / (2 * q)) := by
      rw [hs, div_pow, Real.sq_sqrt hq0.le]; ring
    have h12 : s1 < s2 := Real.sqrt_lt_sqrt (by linarith) (by linarith)
    have hw : 0 < (s2 - s1) / 2 := by linarith
    have hu : 1 < ((s - (s1 + s2) / 2) / ((s2 - s1) / 2)) ^ 2 := by
      rcases hX with hX | hX
      · have h1 : s < s1 := (Real.lt_sqrt hs0.le).mpr (by rw [hs2]; linarith)
        have h2 : (s - (s1 + s2) / 2) / ((s2 - s1) / 2) < -1 := by
          rw [div_lt_iff₀ hw]; linarith
        nlinarith
      · have h1 : s2 < s := (Real.sqrt_lt' hs0).mpr (by rw [hs2]; linarith)
        have h2 : 1 < (s - (s1 + s2) / 2) / ((s2 - s1) / 2) := by
          rw [lt_div_iff₀ hw]; linarith
        nlinarith
    rw [hb _ hu, zero_div, mul_zero]
  have hmem : ∀ (r : ℝ) (Y : ℝ × ℝ), 0 < r → ((r, z, t, Y) : Cyl) ∈ DomC B.h (qsOf l0) :=
    fun r Y hr => ⟨hr, ht, hq⟩

  have fibre : ∀ f : Cyl → ℝ, ContinuousOn (fun p : ℝ × (ℝ × ℝ) => f (p.1, z, t, p.2))
      (Set.Ioi (0:ℝ) ×ˢ Set.univ) → ContinuousOn (fun r : ℝ => yAvg f (r, z, t, 0)) (Set.Ioi (0:ℝ)) := by
    intro f hf
    rw [continuousOn_iff_continuous_restrict]
    haveI : LocallyCompactSpace (Set.Ioi (0:ℝ)) := isOpen_Ioi.locallyCompactSpace
    have hc : Continuous (Function.uncurry fun (x : Set.Ioi (0:ℝ)) (Y : ℝ × ℝ) => f (x.1, z, t, Y)) := by
      have hm : Continuous (fun p : Set.Ioi (0:ℝ) × (ℝ × ℝ) => ((p.1 : ℝ), p.2)) := by fun_prop
      refine hf.comp_continuous hm ?_
      intro p; exact ⟨p.1.2, Set.mem_univ _⟩
    exact continuous_parametric_integral_of_continuous hc (isCompact_Icc.prod isCompact_Icc)
  set c := calP5 B G l0 S z t with hc
  set g : Cyl → ℝ := fun η => grP5 B G l0 S η - rhoP B η * calP5 B G l0 S η.2.1 η.2.2.1 with hg

  have hgrc : ContinuousOn (fun p : ℝ × (ℝ × ℝ) => grP5 B G l0 S (p.1, z, t, p.2))
      (Set.Ioi (0:ℝ) ×ˢ Set.univ) := by
    refine hgr.1.continuousOn.comp (by fun_prop) ?_
    intro p hp
    exact hmem p.1 p.2 hp.1
  have hgc : ContinuousOn (fun p : ℝ × (ℝ × ℝ) => g (p.1, z, t, p.2)) (Set.Ioi (0:ℝ) ×ˢ Set.univ) := by
    have h2 : Continuous (fun p : ℝ × (ℝ × ℝ) => rhoP B (p.1, z, t, 0) * c) :=
      (hρc.comp continuous_fst).mul continuous_const
    have h3 := hgrc.sub h2.continuousOn
    refine h3.congr ?_
    intro p _
    show grP5 B G l0 S (p.1, z, t, p.2) - rhoP B (p.1, z, t, p.2) * c =
      grP5 B G l0 S (p.1, z, t, p.2) - rhoP B (p.1, z, t, 0) * c
    rw [hρY]
  have hgP : ∀ (r : ℝ) (Y : ℝ × ℝ) (n m : ℤ), 0 < r →
      g (r, z, t, Y + ((n : ℝ), (m : ℝ))) = g (r, z, t, Y) := by
    intro r Y n m hr
    have h1 : grP5 B G l0 S (r, z, t, Y + ((n : ℝ), (m : ℝ))) = grP5 B G l0 S (r, z, t, Y) :=
      hgr.2.1 (r, z, t, Y) (hmem r Y hr) n m
    show grP5 B G l0 S (r, z, t, Y + ((n : ℝ), (m : ℝ))) - rhoP B (r, z, t, Y + ((n : ℝ), (m : ℝ))) * c =
      grP5 B G l0 S (r, z, t, Y) - rhoP B (r, z, t, Y) * c
    rw [h1, hρY r (Y + _), hρY r Y]
  have hgS : ∀ (r : ℝ) (Y : ℝ × ℝ), 0 < r →
      (XC B.h (r, z, t, Y) < B.Xa ∨ B.Xb < XC B.h (r, z, t, Y)) → g (r, z, t, Y) = 0 := by
    intro r Y hr hX
    have h1 : grP5 B G l0 S (r, z, t, Y) = 0 := hgr.2.2 _ (hmem r Y hr) hX
    have h2 : rhoP B (r, z, t, Y) = 0 := by rw [hρY]; exact hρ0 r hr hX
    show grP5 B G l0 S (r, z, t, Y) - rhoP B (r, z, t, Y) * c = 0
    rw [h1, h2]; ring

  have hIc := pm5_icut_yavg B g z t hB ht hgc hgP hgS pm5_torus_shift_mean
  have hFc := fibre g hgc
  have hAc := fibre (grP5 B G l0 S) hgrc

  set q := simScale B.h z (1 - t) with hqdef
  have hXC : ∀ (r : ℝ) (Y : ℝ × ℝ), XC B.h (r, z, t, Y) = r ^ 2 / (2 * q) := fun r Y => rfl
  have hXaXb : B.Xa ≤ B.Xb := by linarith
  set ρa := Real.sqrt (2 * B.Xa * q) with hρa
  set ρb := Real.sqrt (2 * B.Xb * q) with hρb
  have hρa0 : 0 < ρa := Real.sqrt_pos.mpr (mul_pos (mul_pos two_pos hXa) hq0)
  have hab : ρa ≤ ρb := Real.sqrt_le_sqrt (by nlinarith)
  have h2q : (0:ℝ) < 2 * q := by linarith
  have hsupp : ∀ (r : ℝ) (Y : ℝ × ℝ), 0 < r → (r < ρa ∨ ρb < r) →
      (XC B.h (r, z, t, Y) < B.Xa ∨ B.Xb < XC B.h (r, z, t, Y)) := by
    intro r Y hr h
    rw [hXC]
    rcases h with h | h
    · left
      have h' := (Real.lt_sqrt hr.le).mp h
      rw [div_lt_iff₀ h2q]; linarith
    · right
      have h' := (Real.sqrt_lt' hr).mp h
      rw [lt_div_iff₀ h2q]; linarith
  have hA0 : ∀ r : ℝ, 0 < r → (r < ρa ∨ ρb < r) → yAvg (grP5 B G l0 S) (r, z, t, 0) = 0 := by
    intro r hr h
    have e : (fun Y : ℝ × ℝ => grP5 B G l0 S (r, z, t, Y)) = fun _ => 0 := by
      funext Y; exact hgr.2.2 _ (hmem r Y hr) (hsupp r Y hr h)
    show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, grP5 B G l0 S (r, z, t, Y)) = 0
    rw [e]; simp
  have hF0 : ∀ r : ℝ, 0 < r → (r < ρa ∨ ρb < r) → yAvg g (r, z, t, 0) = 0 := by
    intro r hr h
    have e : (fun Y : ℝ × ℝ => g (r, z, t, Y)) = fun _ => 0 := by
      funext Y; exact hgS r Y hr (hsupp r Y hr h)
    show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (r, z, t, Y)) = 0
    rw [e]; simp
  have hρ0' : ∀ r : ℝ, 0 < r → (r < ρa ∨ ρb < r) → rhoP B (r, z, t, 0) = 0 :=
    fun r hr h => hρ0 r hr (hsupp r 0 hr h)

  have hsqI : ∀ (k : ℝ), (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, k) = k := by
    intro k
    have hsq : (volume (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) = 1 := by
      rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc]; simp
    rw [setIntegral_const, Measure.real, hsq]
    simp
  have hFA : ∀ r : ℝ, 0 < r →
      yAvg g (r, z, t, 0) = yAvg (grP5 B G l0 S) (r, z, t, 0) - rhoP B (r, z, t, 0) * c := by
    intro r hr
    have hint : IntegrableOn (fun Y : ℝ × ℝ => grP5 B G l0 S (r, z, t, Y))
        (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := by
      apply ContinuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
      refine hgr.1.continuousOn.comp (by fun_prop) ?_
      intro Y _; exact hmem r Y hr
    have hint2 : IntegrableOn (fun _ : ℝ × ℝ => rhoP B (r, z, t, 0) * c)
        (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) :=
      continuousOn_const.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
    show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, (grP5 B G l0 S (r, z, t, Y) - rhoP B (r, z, t, Y) * c)) =
      (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, grP5 B G l0 S (r, z, t, Y)) - rhoP B (r, z, t, 0) * c
    have e : (fun Y : ℝ × ℝ => grP5 B G l0 S (r, z, t, Y) - rhoP B (r, z, t, Y) * c) =
        fun Y => grP5 B G l0 S (r, z, t, Y) - rhoP B (r, z, t, 0) * c := by
      funext Y; rw [hρY r Y]
    rw [e, integral_sub hint hint2, hsqI]

  have hInt : ∀ f : ℝ → ℝ, ContinuousOn f (Set.Ioi 0) → (∀ r, 0 < r → (r < ρa ∨ ρb < r) → f r = 0) →
      IntegrableOn f (Set.Ioi 0) := by
    intro f hf h0
    have hI : IntegrableOn f (Set.Icc ρa ρb) :=
      (hf.mono (fun x hx => lt_of_lt_of_le hρa0 hx.1)).integrableOn_Icc
    refine hI.of_forall_sdiff_eq_zero measurableSet_Ioi ?_
    intro x hx
    apply h0 x hx.1
    by_contra hcon
    push_neg at hcon
    exact hx.2 ⟨hcon.1, hcon.2⟩
  have hAint := hInt _ hAc hA0
  have hρint := hInt _ hρc.continuousOn hρ0'
  have h2A := hInt (fun r => r ^ 2 * yAvg (grP5 B G l0 S) (r, z, t, 0))
    ((continuous_pow 2).continuousOn.mul hAc) (fun r hr h => by simp only [hA0 r hr h, mul_zero])
  have h2ρ := hInt (fun r => r ^ 2 * rhoP B (r, z, t, 0))
    ((continuous_pow 2).continuousOn.mul hρc.continuousOn)
    (fun r hr h => by simp only [hρ0' r hr h, mul_zero])

  have hAc1 : (∫ r in Set.Ioi (0:ℝ), yAvg (grP5 B G l0 S) (r, z, t, 0)) = c := by
    show _ = radMom (grP5 B G l0 S) 0 z t
    unfold radMom
    simp
  have hmass : (∫ r in Set.Ioi (0:ℝ), yAvg g (r, z, t, 0)) = 0 := by
    rw [setIntegral_congr_fun measurableSet_Ioi (fun r hr => hFA r hr),
      integral_sub hAint (Integrable.mul_const hρint c), integral_mul_const,
      rhoP_integral_one_v5 B z t 0 hB ht, hAc1]
    ring

  have hP : ∀ r : ℝ, 0 < r → yAvg (pmP5 B G l0 S) (r, z, t, 0) = ∫ s in (0:ℝ)..r, yAvg g (s, z, t, 0) := by
    intro r hr
    have h := hIc r hr
    rw [hmass, mul_zero, sub_zero] at h
    exact h
  have hL : radMom (pmP5 B G l0 S) 1 z t =
      ∫ r in Set.Ioi (0:ℝ), r ^ 1 * ∫ s in (0:ℝ)..r, yAvg g (s, z, t, 0) := by
    unfold radMom
    exact setIntegral_congr_fun measurableSet_Ioi (fun r hr => by simp only [hP r hr])
  have hibp := pm5_moment_ibp (fun r => yAvg g (r, z, t, 0)) ρa ρb hρa0 hab hFc hF0 hmass
  have hR : (∫ r in Set.Ioi (0:ℝ), r ^ 2 * yAvg g (r, z, t, 0)) =
      radMom (grP5 B G l0 S) 2 z t - (∫ r in Set.Ioi (0:ℝ), r ^ 2 * rhoP B (r, z, t, 0)) * c := by
    unfold radMom
    rw [setIntegral_congr_fun measurableSet_Ioi
      (g := fun r => r ^ 2 * yAvg (grP5 B G l0 S) (r, z, t, 0) - (r ^ 2 * rhoP B (r, z, t, 0)) * c)
      (fun r hr => by dsimp only; rw [hFA r hr]; ring)]
    rw [integral_sub h2A (Integrable.mul_const h2ρ c), integral_mul_const]
  rw [hL, hibp, hR]
  ring

theorem stp5_avg_field_pack : ∀ (B : BG) (qs z0 t0 ε a b : ℝ) (g : Cyl → ℝ), B.ok → IsOpen (DomC B.h qs) → ContDiffOn ℝ ∞ g (DomC B.h qs) → (∀ ξ ∈ DomC B.h qs, ∀ n m : ℤ, g (shY ξ ((n : ℝ), (m : ℝ))) = g ξ) → (∀ ξ ∈ DomC B.h qs, (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → g ξ = 0) → 0 < ε → (∀ z t : ℝ, |z - z0| < ε → |t - t0| < ε → t < 1 ∧ simScale B.h z (1 - t) < qs ∧ ∀ r : ℝ, 0 < r → (r ≤ a ∨ b ≤ r) → ∀ Y : ℝ × ℝ, (XC B.h (r, z, t, Y) < B.Xa ∨ B.Xb < XC B.h (r, z, t, Y))) → ContDiffOn ℝ ∞ (fun p : ℝ × ℝ × ℝ => yAvg g (p.1, p.2.1, p.2.2, 0)) (Set.Ioi 0 ×ˢ (Metric.ball z0 ε ×ˢ Metric.ball t0 ε)) ∧ ∀ r z t : ℝ, 0 < r → (r ≤ a ∨ b ≤ r) → |z - z0| < ε → |t - t0| < ε → yAvg g (r, z, t, 0) = 0 :=
by
  intro B qs z0 t0 ε a b g _hB _hDo hg _hper hsh hε hbox

  have PIC : ∀ {P E' F : Type} [NormedAddCommGroup P] [NormedSpace ℝ P]
      [FiniteDimensional ℝ P] [NormedAddCommGroup E'] [NormedSpace ℝ E'] [FiniteDimensional ℝ E']
      [MeasurableSpace E'] [BorelSpace E'] [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (μ : MeasureTheory.Measure E') [MeasureTheory.IsFiniteMeasureOnCompacts μ]
      (U : Set P) (V K : Set E') (G : P → E' → F) (hU : IsOpen U) (hV : IsOpen V) (hK : IsCompact K)
      (hKV : K ⊆ V) (hG : ContDiffOn ℝ ∞ (fun z : P × E' => G z.1 z.2) (U ×ˢ V)),
      ContDiffOn ℝ ∞ (fun x => ∫ y in K, G x y ∂μ) U := by
    intro P E' F _ _ _ _ _ _ _ _ _ _ _ μ _ U V K G hU hV hK hKV hG
    have hO : IsOpen (U ×ˢ V) := hU.prod hV
    have hKm : MeasurableSet K := hK.isClosed.measurableSet
    have slice : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F'] (H : P → E' → F'),
        ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) →
        ∀ x ∈ U, ContinuousOn (fun y => H x y) K := by
      intro F' _ _ H hH x hx
      have hc : Continuous (fun y : E' => ((x, y) : P × E')) := by fun_prop
      have h := ContinuousOn.comp (g := fun z : P × E' => H z.1 z.2) (f := fun y : E' => ((x, y) : P × E'))
        hH.continuousOn hc.continuousOn (fun y hy => ⟨hx, hKV hy⟩)
      exact h
    have param_fderiv : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F'] (H : P → E' → F'),
        ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) →
        ContDiffOn ℝ ∞ (fun z : P × E' => fderiv ℝ (fun x' => H x' z.2) z.1) (U ×ˢ V) := by
      intro F' _ _ H hH p hp
      have hHa : ContDiffAt ℝ ∞ (fun z : P × E' => H z.1 z.2) p := hH.contDiffAt (hO.mem_nhds hp)
      apply ContDiffAt.contDiffWithinAt
      have h1 : ContDiffAt ℝ ∞ (Function.uncurry (fun (q : P × E') (x' : P) => H x' q.2)) (p, p.1) := by
        have e : Function.uncurry (fun (q : P × E') (x' : P) => H x' q.2) =
            (fun z : P × E' => H z.1 z.2) ∘ (fun w : (P × E') × P => (w.2, w.1.2)) := rfl
        rw [e]
        apply ContDiffAt.comp (g := fun z : P × E' => H z.1 z.2) (p, p.1)
        · simpa using hHa
        · fun_prop
      exact ContDiffAt.fderiv (f := fun (q : P × E') (x' : P) => H x' q.2)
        (g := Prod.fst) h1 contDiffAt_fst (le_of_eq ENat.coe_top_add_one)
    have param_hasFDeriv : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F']
        (H : P → E' → F'), ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) → ∀ x ∈ U,
        HasFDerivAt (fun x' => ∫ y in K, H x' y ∂μ) (∫ y in K, fderiv ℝ (fun x' => H x' y) x ∂μ) x := by
      intro F' _ _ H hH x hx
      have hHs := param_fderiv H hH
      obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hU x hx
      have hsU : Metric.closedBall x (δ / 2) ⊆ U :=
        (Metric.closedBall_subset_ball (by linarith)).trans hball
      have hsn : Metric.closedBall x (δ / 2) ∈ nhds x := Metric.closedBall_mem_nhds x (by linarith)
      have hC : IsCompact (Metric.closedBall x (δ / 2) ×ˢ K) := (isCompact_closedBall _ _).prod hK
      have hCsub : Metric.closedBall x (δ / 2) ×ˢ K ⊆ U ×ˢ V := fun z hz => ⟨hsU hz.1, hKV hz.2⟩
      obtain ⟨Cb, hCb⟩ := hC.exists_bound_of_continuousOn (hHs.continuousOn.mono hCsub)
      refine hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := μ.restrict K)
        (F := fun x' y => H x' y) (F' := fun x' y => fderiv ℝ (fun x'' => H x'' y) x')
        (bound := fun _ => Cb) hsn ?_ ?_ ?_ ?_ ?_ ?_
      · filter_upwards [hU.mem_nhds hx] with x' hx'
        exact (slice H hH x' hx').aestronglyMeasurable_of_isCompact hK hKm
      · exact (slice H hH x hx).integrableOn_compact hK
      · exact (slice (fun x' y => fderiv ℝ (fun x'' => H x'' y) x') hHs x hx).aestronglyMeasurable_of_isCompact
          hK hKm
      · exact ae_restrict_of_forall_mem hKm (fun y hy x' hx' => hCb (x', y) ⟨hx', hy⟩)
      · exact continuousOn_const.integrableOn_compact hK
      · refine ae_restrict_of_forall_mem hKm (fun y hy x' hx' => ?_)
        have hHa : ContDiffAt ℝ ∞ (fun z : P × E' => H z.1 z.2) (x', y) :=
          hH.contDiffAt (hO.mem_nhds ⟨hsU hx', hKV hy⟩)
        have hc : ContDiffAt ℝ ∞ (fun x'' : P => ((x'', y) : P × E')) x' := by fun_prop
        have h2 := ContDiffAt.comp (g := fun z : P × E' => H z.1 z.2) x' hHa hc
        have : ContDiffAt ℝ ∞ (fun x'' => H x'' y) x' := h2
        exact (this.differentiableAt (by simp)).hasFDerivAt
    have hD0 : ∀ x y, iteratedFDeriv ℝ 0 (fun x' => G x' y) x =
        (continuousMultilinearCurryFin0 ℝ P F).symm (G x y) := by
      intro x y; rw [iteratedFDeriv_zero_eq_comp]; rfl
    have hDs : ∀ (k : ℕ) x y, iteratedFDeriv ℝ (k + 1) (fun x' => G x' y) x =
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm
          (fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') x) := by
      intro k x y; rw [iteratedFDeriv_succ_eq_comp_left]; rfl
    have D_smooth : ∀ k : ℕ, ContDiffOn ℝ ∞
        (fun z : P × E' => iteratedFDeriv ℝ k (fun x' => G x' z.2) z.1) (U ×ˢ V) := by
      intro k
      induction k with
      | zero =>
        have e : (fun z : P × E' => iteratedFDeriv ℝ 0 (fun x' => G x' z.2) z.1) =
            (continuousMultilinearCurryFin0 ℝ P F).symm ∘ (fun z : P × E' => G z.1 z.2) := by
          funext z; exact hD0 z.1 z.2
        rw [e]
        exact (continuousMultilinearCurryFin0 ℝ P F).symm.contDiff.comp_contDiffOn hG
      | succ k ih =>
        have e : (fun z : P × E' => iteratedFDeriv ℝ (k + 1) (fun x' => G x' z.2) z.1) =
            (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm ∘
              (fun z : P × E' => fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' z.2) x') z.1) := by
          funext z; exact hDs k z.1 z.2
        rw [e]
        have h2 := param_fderiv (fun x' y => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') ih
        exact (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm.contDiff.comp_contDiffOn h2
    have formula : ∀ k : ℕ, ∀ x ∈ U, iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) x =
        ∫ y in K, iteratedFDeriv ℝ k (fun x' => G x' y) x ∂μ := by
      intro k
      induction k with
      | zero =>
        intro x _
        rw [iteratedFDeriv_zero_eq_comp (f := fun x' => ∫ y in K, G x' y ∂μ)]
        simp only [hD0]
        exact (ContinuousLinearEquiv.integral_comp_comm
          (continuousMultilinearCurryFin0 ℝ P F).symm.toContinuousLinearEquiv (fun y => G x y)).symm
      | succ k ih =>
        intro x hx
        have hα : iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) =ᶠ[nhds x]
            (fun x' => ∫ y in K, iteratedFDeriv ℝ k (fun x'' => G x'' y) x' ∂μ) :=
          Filter.eventuallyEq_of_mem (hU.mem_nhds hx) ih
        have hβ := (param_hasFDeriv (fun x' y => iteratedFDeriv ℝ k (fun x'' => G x'' y) x')
          (D_smooth k) x hx).fderiv
        rw [iteratedFDeriv_succ_eq_comp_left (f := fun x' => ∫ y in K, G x' y ∂μ), Function.comp_apply,
          hα.fderiv_eq, hβ]
        simp only [hDs]
        have hL := ContinuousLinearEquiv.integral_comp_comm (μ := μ.restrict K) (𝕜 := ℝ)
          (E := P →L[ℝ] ContinuousMultilinearMap ℝ (fun _ : Fin k => P) F)
          (F := ContinuousMultilinearMap ℝ (fun _ : Fin (k + 1) => P) F)
          (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm.toContinuousLinearEquiv
          (fun y => fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') x)
        exact hL.symm
    have key : ∀ m : ℕ, EqOn (iteratedFDerivWithin ℝ m (fun x => ∫ y in K, G x y ∂μ) U)
        (fun x => ∫ y in K, iteratedFDeriv ℝ m (fun x' => G x' y) x ∂μ) U := by
      intro m x hx
      rw [iteratedFDerivWithin_of_isOpen m hU hx]
      exact formula m x hx
    have hdiff : ∀ m : ℕ, DifferentiableOn ℝ
        (fun x => ∫ y in K, iteratedFDeriv ℝ m (fun x' => G x' y) x ∂μ) U :=
      fun m x hx => (param_hasFDeriv (fun x' y => iteratedFDeriv ℝ m (fun x'' => G x'' y) x')
        (D_smooth m) x hx).differentiableAt.differentiableWithinAt
    exact contDiffOn_of_continuousOn_differentiableOn (n := ⊤)
      (fun m _ => ((hdiff m).continuousOn).congr (key m))
      (fun m _ => (hdiff m).congr (key m))

  have hU : IsOpen (Set.Ioi (0:ℝ) ×ˢ (Metric.ball z0 ε ×ˢ Metric.ball t0 ε)) :=
    isOpen_Ioi.prod (Metric.isOpen_ball.prod Metric.isOpen_ball)
  have hK : IsCompact (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := isCompact_Icc.prod isCompact_Icc

  have hmem : ∀ r z t : ℝ, 0 < r → |z - z0| < ε → |t - t0| < ε → ∀ Y : ℝ × ℝ,
      ((r, z, t, Y) : Cyl) ∈ DomC B.h qs := by
    intro r z t hr hz ht Y
    obtain ⟨h1, h2, -⟩ := hbox z t hz ht
    exact ⟨hr, h1, h2⟩

  have hG : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × (ℝ × ℝ) => g ((w.1.1, w.1.2.1, w.1.2.2, w.2) : Cyl))
      ((Set.Ioi (0:ℝ) ×ˢ (Metric.ball z0 ε ×ˢ Metric.ball t0 ε)) ×ˢ Set.univ) := by
    have he : ContDiff ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × (ℝ × ℝ) => ((w.1.1, w.1.2.1, w.1.2.2, w.2) : Cyl)) := by
      fun_prop
    refine hg.comp he.contDiffOn ?_
    intro w hw
    obtain ⟨⟨h1, h2, h3⟩, -⟩ := hw
    refine hmem _ _ _ h1 ?_ ?_ _
    · rw [Metric.mem_ball, Real.dist_eq] at h2; exact h2
    · rw [Metric.mem_ball, Real.dist_eq] at h3; exact h3
  refine ⟨?_, ?_⟩
  ·
    have h := PIC (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ))
      (Set.Ioi (0:ℝ) ×ˢ (Metric.ball z0 ε ×ˢ Metric.ball t0 ε)) Set.univ
      (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)
      (fun (p : ℝ × ℝ × ℝ) (Y : ℝ × ℝ) => g ((p.1, p.2.1, p.2.2, Y) : Cyl)) hU isOpen_univ hK
      (Set.subset_univ _) hG
    exact h.congr (fun p _ => rfl)
  ·
    intro r z t hr hrab hz ht
    have h0 : ∀ Y : ℝ × ℝ, g ((r, z, t, Y) : Cyl) = 0 := fun Y =>
      hsh _ (hmem r z t hr hz ht Y) ((hbox z t hz ht).2.2 r hr hrab Y)
    show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g ((r, z, t, Y) : Cyl)) = 0
    simp only [h0, MeasureTheory.integral_zero]

theorem stp5_yavg_ops : ∀ (h : ℝ) (U : Set (ℝ × ℝ × ℝ)) (g : Cyl → ℝ), IsOpen U → (∀ p ∈ U, 0 < p.1) → ContDiffOn ℝ ∞ g {ξ : Cyl | (ξ.1, ξ.2.1, ξ.2.2.1) ∈ U} → (∀ ξ : Cyl, (ξ.1, ξ.2.1, ξ.2.2.1) ∈ U → ∀ n m : ℤ, g (shY ξ ((n : ℝ), (m : ℝ))) = g ξ) → ∀ ξ : Cyl, (ξ.1, ξ.2.1, ξ.2.2.1) ∈ U → yAvg (dR h g) ξ = deriv (fun r => yAvg g (r, ξ.2.1, ξ.2.2.1, 0)) ξ.1 ∧ yAvg (dZ g) ξ = deriv (fun z => yAvg g (ξ.1, z, ξ.2.2.1, 0)) ξ.2.1 ∧ yAvg (dT g) ξ = deriv (fun t => yAvg g (ξ.1, ξ.2.1, t, 0)) ξ.2.2.1 ∧ yAvg (dR h (dR h g)) ξ = deriv (fun r => deriv (fun r' => yAvg g (r', ξ.2.1, ξ.2.2.1, 0)) r) ξ.1 ∧ yAvg (dZ (dZ g)) ξ = deriv (fun z => deriv (fun z' => yAvg g (ξ.1, z', ξ.2.2.1, 0)) z) ξ.2.1 :=
by
  intro h U g hU hU0 hg hper ξ hξ
  set S : Set Cyl := {ξ : Cyl | (ξ.1, ξ.2.1, ξ.2.2.1) ∈ U} with hSdef
  have hSo : IsOpen S :=
    hU.preimage (by fun_prop : Continuous fun η : Cyl => (η.1, η.2.1, η.2.2.1))
  have hsl : ∀ ζ ∈ S, ∀ Y : ℝ × ℝ, ((ζ.1, ζ.2.1, ζ.2.2.1, Y) : Cyl) ∈ S := fun ζ hζ Y => hζ
  have hK : IsCompact (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
  have hKm : MeasurableSet (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) :=
    measurableSet_Icc.prod measurableSet_Icc
  have hslc : Continuous (fun p : Cyl × (ℝ × ℝ) => ((p.1.1, p.1.2.1, p.1.2.2.1, p.2) : Cyl)) := by
    fun_prop
  have sliceC : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F'] (g : Cyl → F'),
      ContinuousOn g S → ∀ ξ ∈ S, Continuous (fun Y : ℝ × ℝ => g ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl)) := by
    intro F' _ _ g hg ξ hξ
    have h := ContinuousOn.comp_continuous (g := g)
      (f := fun Y : ℝ × ℝ => ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl)) hg (by fun_prop) (fun Y => hsl ξ hξ Y)
    exact h
  have intK : ∀ (g : Cyl → ℝ), ContinuousOn g S → ∀ ξ ∈ S,
      IntegrableOn (fun Y : ℝ × ℝ => g ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl))
        (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) :=
    fun g hg ξ hξ => (sliceC g hg ξ hξ).continuousOn.integrableOn_compact hK
  have regD : ∀ g : Cyl → ℝ, ContDiffOn ℝ ∞ g S →
      ContinuousOn (fderiv ℝ g) S ∧ ∀ p ∈ S, HasFDerivAt g (fderiv ℝ g p) p := fun g hg =>
    ⟨hg.continuousOn_fderiv_of_isOpen hSo (by simp), fun p hp =>
      ((hg.differentiableOn (by simp)).differentiableAt (hSo.mem_nhds hp)).hasFDerivAt⟩
  have LIN : ∀ (f g : Cyl → ℝ) (c d : ℝ), ContinuousOn f S → ContinuousOn g S → ∀ ξ ∈ S,
      yAvg (fun η => c * f η + d * g η) ξ = c * yAvg f ξ + d * yAvg g ξ := by
    intro f g c d hf hg ξ hξ
    simp only [yAvg]
    rw [integral_add (Integrable.const_mul (intK f hf ξ hξ) c) (Integrable.const_mul (intK g hg ξ hξ) d),
      integral_const_mul, integral_const_mul]
  obtain ⟨L, hL⟩ : ∃ L : Cyl →L[ℝ] Cyl, ∀ x : Cyl, L x = (x.1, x.2.1, x.2.2.1, 0) :=
    ⟨(ContinuousLinearMap.id ℝ ℝ).prodMap ((ContinuousLinearMap.id ℝ ℝ).prodMap
      ((ContinuousLinearMap.id ℝ ℝ).prodMap (0 : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)))), fun _ => rfl⟩
  have hslD : ∀ (x : Cyl) (Y : ℝ × ℝ),
      HasFDerivAt (fun x' : Cyl => ((x'.1, x'.2.1, x'.2.2.1, Y) : Cyl)) L x := by
    intro x Y
    have e : (fun x' : Cyl => ((x'.1, x'.2.1, x'.2.2.1, Y) : Cyl)) =
        fun x' => L x' + ((0:ℝ), (0:ℝ), (0:ℝ), Y) := by
      funext x'
      rw [hL]
      simp
    rw [e]
    exact L.hasFDerivAt.add_const _

  have DER : ∀ g : Cyl → ℝ, ContDiffOn ℝ ∞ g S → ∀ ξ ∈ S,
      HasFDerivAt (yAvg g) (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
        (fderiv ℝ g ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl)).comp L) ξ := by
    intro g hg ξ hξ
    obtain ⟨hgf, hgd⟩ := regD g hg
    obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hSo ξ hξ
    have hsU : Metric.closedBall ξ (δ / 2) ⊆ S :=
      (Metric.closedBall_subset_ball (by linarith)).trans hball
    have hsn : Metric.closedBall ξ (δ / 2) ∈ nhds ξ := Metric.closedBall_mem_nhds ξ (by linarith)
    have hC : IsCompact (Metric.closedBall ξ (δ / 2) ×ˢ (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) :=
      (isCompact_closedBall _ _).prod hK
    have hcont : ContinuousOn
        (fun p : Cyl × (ℝ × ℝ) => (fderiv ℝ g ((p.1.1, p.1.2.1, p.1.2.2.1, p.2) : Cyl)).comp L)
        (Metric.closedBall ξ (δ / 2) ×ˢ (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) := by
      have h1 : ContinuousOn
          (fun p : Cyl × (ℝ × ℝ) => fderiv ℝ g ((p.1.1, p.1.2.1, p.1.2.2.1, p.2) : Cyl))
          (Metric.closedBall ξ (δ / 2) ×ˢ (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) :=
        hgf.comp hslc.continuousOn (fun p hp => hsl p.1 (hsU hp.1) p.2)
      exact h1.clm_comp continuousOn_const
    obtain ⟨Cb, hCb⟩ := hC.exists_bound_of_continuousOn hcont
    show HasFDerivAt (fun x : Cyl => ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
      g ((x.1, x.2.1, x.2.2.1, Y) : Cyl)) _ ξ
    refine hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ)
      (μ := volume.restrict (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1))
      (F := fun x Y => g ((x.1, x.2.1, x.2.2.1, Y) : Cyl))
      (F' := fun x Y => (fderiv ℝ g ((x.1, x.2.1, x.2.2.1, Y) : Cyl)).comp L)
      (bound := fun _ => Cb) hsn ?_ ?_ ?_ ?_ ?_ ?_
    · filter_upwards [hSo.mem_nhds hξ] with x hx
      exact (sliceC g hg.continuousOn x hx).aestronglyMeasurable
    · exact intK g hg.continuousOn ξ hξ
    · exact ((sliceC _ hgf ξ hξ).clm_comp continuous_const).aestronglyMeasurable
    · exact ae_restrict_of_forall_mem hKm (fun Y hY x hx => hCb (x, Y) ⟨hx, hY⟩)
    · exact continuousOn_const.integrableOn_compact hK
    · exact ae_restrict_of_forall_mem hKm (fun Y _ x hx =>
        (hgd _ (hsl x (hsU hx) Y)).comp x (hslD x Y))
  have DERv : ∀ g : Cyl → ℝ, ContDiffOn ℝ ∞ g S → ∀ ξ ∈ S, ∀ v : Cyl,
      fderiv ℝ (yAvg g) ξ v = yAvg (fun η => fderiv ℝ g η (L v)) ξ := by
    intro g hg ξ hξ v
    rw [(DER g hg ξ hξ).fderiv, ContinuousLinearMap.integral_apply]
    · rfl
    · exact ((sliceC _ (regD g hg).1 ξ hξ).clm_comp continuous_const).continuousOn.integrableOn_compact hK

  have FTC : ∀ (φ φ' : ℝ → ℝ), Continuous φ' → (∀ s, HasDerivAt φ (φ' s) s) → φ 1 = φ 0 →
      ∫ s in Set.Icc (0:ℝ) 1, φ' s = 0 := by
    intro φ φ' hc hd hp
    rw [integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le zero_le_one,
      intervalIntegral.integral_eq_sub_of_hasDerivAt (fun s _ => hd s) (hc.intervalIntegrable 0 1), hp,
      sub_self]

  have YZ : ∀ g : Cyl → ℝ, ContDiffOn ℝ ∞ g S → ∀ ξ ∈ S,
      (∀ Y : ℝ × ℝ, g ((ξ.1, ξ.2.1, ξ.2.2.1, Y + ((1:ℝ), (0:ℝ))) : Cyl) = g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) →
      (∀ Y : ℝ × ℝ, g ((ξ.1, ξ.2.1, ξ.2.2.1, Y + ((0:ℝ), (1:ℝ))) : Cyl) = g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) →
      ∀ w : ℝ × ℝ, yAvg (fun η => fderiv ℝ g η ((0:ℝ), (0:ℝ), (0:ℝ), w)) ξ = 0 := by
    intro g hg ξ hξ hp1 hp2 w
    obtain ⟨hgf, hgd⟩ := regD g hg
    obtain ⟨D1, hD1⟩ : ∃ D1 : Cyl → ℝ,
        D1 = fun η => fderiv ℝ g η ((0:ℝ), (0:ℝ), (0:ℝ), ((1:ℝ), (0:ℝ))) := ⟨_, rfl⟩
    obtain ⟨D2, hD2⟩ : ∃ D2 : Cyl → ℝ,
        D2 = fun η => fderiv ℝ g η ((0:ℝ), (0:ℝ), (0:ℝ), ((0:ℝ), (1:ℝ))) := ⟨_, rfl⟩
    have hD1c : ContinuousOn D1 S := by rw [hD1]; exact hgf.clm_apply continuousOn_const
    have hD2c : ContinuousOn D2 S := by rw [hD2]; exact hgf.clm_apply continuousOn_const
    have hsplit : (fun η => fderiv ℝ g η ((0:ℝ), (0:ℝ), (0:ℝ), w)) = fun η => w.1 * D1 η + w.2 * D2 η := by
      funext η
      have e : ((0:ℝ), (0:ℝ), (0:ℝ), w) = w.1 • ((0:ℝ), (0:ℝ), (0:ℝ), ((1:ℝ), (0:ℝ))) +
          w.2 • ((0:ℝ), (0:ℝ), (0:ℝ), ((0:ℝ), (1:ℝ))) := by
        obtain ⟨w1, w2⟩ := w
        simp
      rw [hD1, hD2, e, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
    have hI2 : yAvg D2 ξ = 0 := by
      show ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, D2 ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) = 0
      have hint : IntegrableOn (fun Y : ℝ × ℝ => D2 ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl))
          (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ((volume : Measure ℝ).prod volume) := by
        rw [← Measure.volume_eq_prod]; exact intK D2 hD2c ξ hξ
      rw [Measure.volume_eq_prod ℝ ℝ, setIntegral_prod _ hint]
      have hin : ∀ a : ℝ, ∫ b in Set.Icc (0:ℝ) 1, D2 ((ξ.1, ξ.2.1, ξ.2.2.1, (a, b)) : Cyl) = 0 := by
        intro a
        refine FTC (fun s => g ((ξ.1, ξ.2.1, ξ.2.2.1, (a, s)) : Cyl))
          (fun s => D2 ((ξ.1, ξ.2.1, ξ.2.2.1, (a, s)) : Cyl)) ?_ ?_ ?_
        · exact (sliceC D2 hD2c ξ hξ).comp (by fun_prop : Continuous fun s : ℝ => ((a, s) : ℝ × ℝ))
        · intro s
          have hc : HasDerivAt (fun s : ℝ => ((ξ.1, ξ.2.1, ξ.2.2.1, (a, s)) : Cyl))
              ((0:ℝ), (0:ℝ), (0:ℝ), ((0:ℝ), (1:ℝ))) s :=
            (hasDerivAt_const s ξ.1).prodMk ((hasDerivAt_const s ξ.2.1).prodMk
              ((hasDerivAt_const s ξ.2.2.1).prodMk ((hasDerivAt_const s a).prodMk (hasDerivAt_id' s))))
          have := (hgd ((ξ.1, ξ.2.1, ξ.2.2.1, (a, s)) : Cyl) (hsl ξ hξ (a, s))).comp_hasDerivAt s hc
          rw [hD2]
          exact this
        · have h := hp2 (a, 0)
          simp only [Prod.mk_add_mk, add_zero, zero_add] at h
          exact h
      simp only [hin, integral_zero]
    have hI1 : yAvg D1 ξ = 0 := by
      show ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, D1 ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) = 0
      rw [Measure.volume_eq_prod ℝ ℝ, ← setIntegral_prod_swap (Set.Icc (0:ℝ) 1) (Set.Icc (0:ℝ) 1)
        (fun Y : ℝ × ℝ => D1 ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl))]
      have hint : IntegrableOn (fun z : ℝ × ℝ => D1 ((ξ.1, ξ.2.1, ξ.2.2.1, z.swap) : Cyl))
          (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ((volume : Measure ℝ).prod volume) := by
        rw [← Measure.volume_eq_prod]
        exact ((sliceC D1 hD1c ξ hξ).comp continuous_swap).continuousOn.integrableOn_compact hK
      rw [setIntegral_prod _ hint]
      have hin : ∀ a : ℝ, ∫ b in Set.Icc (0:ℝ) 1, D1 ((ξ.1, ξ.2.1, ξ.2.2.1, (b, a)) : Cyl) = 0 := by
        intro a
        refine FTC (fun s => g ((ξ.1, ξ.2.1, ξ.2.2.1, (s, a)) : Cyl))
          (fun s => D1 ((ξ.1, ξ.2.1, ξ.2.2.1, (s, a)) : Cyl)) ?_ ?_ ?_
        · exact (sliceC D1 hD1c ξ hξ).comp (by fun_prop : Continuous fun s : ℝ => ((s, a) : ℝ × ℝ))
        · intro s
          have hc : HasDerivAt (fun s : ℝ => ((ξ.1, ξ.2.1, ξ.2.2.1, (s, a)) : Cyl))
              ((0:ℝ), (0:ℝ), (0:ℝ), ((1:ℝ), (0:ℝ))) s :=
            (hasDerivAt_const s ξ.1).prodMk ((hasDerivAt_const s ξ.2.1).prodMk
              ((hasDerivAt_const s ξ.2.2.1).prodMk ((hasDerivAt_id' s).prodMk (hasDerivAt_const s a))))
          have := (hgd ((ξ.1, ξ.2.1, ξ.2.2.1, (s, a)) : Cyl) (hsl ξ hξ (s, a))).comp_hasDerivAt s hc
          rw [hD1]
          exact this
        · have h := hp1 (0, a)
          simp only [Prod.mk_add_mk, add_zero, zero_add] at h
          exact h
      simp only [Prod.swap_prod_mk, hin, integral_zero]
    rw [hsplit, LIN D1 D2 w.1 w.2 hD1c hD2c ξ hξ, hI1, hI2]
    ring

  have PERs : ∀ g₀ : Cyl → ℝ, (∀ ζ ∈ S, ∀ n m : ℤ, g₀ (shY ζ ((n:ℝ), (m:ℝ))) = g₀ ζ) → ∀ ζ ∈ S,
      (∀ Y : ℝ × ℝ, g₀ ((ζ.1, ζ.2.1, ζ.2.2.1, Y + ((1:ℝ), (0:ℝ))) : Cyl) = g₀ (ζ.1, ζ.2.1, ζ.2.2.1, Y)) ∧
      (∀ Y : ℝ × ℝ, g₀ ((ζ.1, ζ.2.1, ζ.2.2.1, Y + ((0:ℝ), (1:ℝ))) : Cyl) = g₀ (ζ.1, ζ.2.1, ζ.2.2.1, Y)) := by
    intro g₀ hp ζ hζ
    refine ⟨fun Y => ?_, fun Y => ?_⟩
    · have h1 := hp _ (hsl ζ hζ Y) 1 0
      simp only [Int.cast_one, Int.cast_zero] at h1
      exact h1
    · have h1 := hp _ (hsl ζ hζ Y) 0 1
      simp only [Int.cast_one, Int.cast_zero] at h1
      exact h1

  have FO : ∀ g₀ : Cyl → ℝ, ContDiffOn ℝ ∞ g₀ S →
      (∀ ζ ∈ S, ∀ n m : ℤ, g₀ (shY ζ ((n:ℝ), (m:ℝ))) = g₀ ζ) → ∀ ζ ∈ S,
      yAvg (dR h g₀) ζ = deriv (fun r => yAvg g₀ (r, ζ.2.1, ζ.2.2.1, 0)) ζ.1 ∧
      yAvg (dZ g₀) ζ = deriv (fun z => yAvg g₀ (ζ.1, z, ζ.2.2.1, 0)) ζ.2.1 ∧
      yAvg (dT g₀) ζ = deriv (fun t => yAvg g₀ (ζ.1, ζ.2.1, t, 0)) ζ.2.2.1 := by
    intro g₀ hg₀ hp ζ hζ
    obtain ⟨hp1, hp2⟩ := PERs g₀ hp ζ hζ
    have hgf := (regD g₀ hg₀).1
    have hζ0 : ((ζ.1, ζ.2.1, ζ.2.2.1, (0 : ℝ × ℝ)) : Cyl) ∈ S := hsl ζ hζ 0
    have hD := DER g₀ hg₀ _ hζ0
    have LD : ∀ (ℓ : ℝ → Cyl) (v : Cyl) (s0 : ℝ), HasDerivAt ℓ v s0 →
        ℓ s0 = ((ζ.1, ζ.2.1, ζ.2.2.1, (0 : ℝ × ℝ)) : Cyl) →
        deriv (fun s => yAvg g₀ (ℓ s)) s0 =
          yAvg (fun η => fderiv ℝ g₀ η ((v.1, v.2.1, v.2.2.1, (0 : ℝ × ℝ)) : Cyl)) ζ := by
      intro ℓ v s0 hℓ hs0
      have h1 : HasFDerivAt (yAvg g₀) (fderiv ℝ (yAvg g₀) (ℓ s0)) (ℓ s0) := by
        rw [hs0]; exact hD.differentiableAt.hasFDerivAt
      have h2 := (h1.comp_hasDerivAt s0 hℓ).deriv
      rw [hs0, DERv g₀ hg₀ _ hζ0 v, hL] at h2
      exact h2
    have hlr : HasDerivAt (fun r : ℝ => ((r, ζ.2.1, ζ.2.2.1, (0 : ℝ × ℝ)) : Cyl))
        ((1:ℝ), (0:ℝ), (0:ℝ), (0 : ℝ × ℝ)) ζ.1 :=
      (hasDerivAt_id' ζ.1).prodMk ((hasDerivAt_const ζ.1 ζ.2.1).prodMk
        ((hasDerivAt_const ζ.1 ζ.2.2.1).prodMk (hasDerivAt_const ζ.1 (0 : ℝ × ℝ))))
    have hlz : HasDerivAt (fun z : ℝ => ((ζ.1, z, ζ.2.2.1, (0 : ℝ × ℝ)) : Cyl))
        ((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ)) ζ.2.1 :=
      (hasDerivAt_const ζ.2.1 ζ.1).prodMk ((hasDerivAt_id' ζ.2.1).prodMk
        ((hasDerivAt_const ζ.2.1 ζ.2.2.1).prodMk (hasDerivAt_const ζ.2.1 (0 : ℝ × ℝ))))
    have hlt : HasDerivAt (fun t : ℝ => ((ζ.1, ζ.2.1, t, (0 : ℝ × ℝ)) : Cyl))
        ((0:ℝ), (0:ℝ), (1:ℝ), (0 : ℝ × ℝ)) ζ.2.2.1 :=
      (hasDerivAt_const ζ.2.2.1 ζ.1).prodMk ((hasDerivAt_const ζ.2.2.1 ζ.2.1).prodMk
        ((hasDerivAt_id' ζ.2.2.1).prodMk (hasDerivAt_const ζ.2.2.1 (0 : ℝ × ℝ))))
    have c1 : yAvg (dR h g₀) ζ = yAvg (fun η => fderiv ℝ g₀ η ((1:ℝ), (0:ℝ), (0:ℝ), (0 : ℝ × ℝ))) ζ := by
      have hsplit : (fun η => fderiv ℝ g₀ η ((1:ℝ), (0:ℝ), (0:ℝ), (drx h * ζ.1 ^ (drx h - 1)) • vrv)) =
          fun η => 1 * fderiv ℝ g₀ η ((1:ℝ), (0:ℝ), (0:ℝ), (0 : ℝ × ℝ)) +
            (drx h * ζ.1 ^ (drx h - 1)) * fderiv ℝ g₀ η ((0:ℝ), (0:ℝ), (0:ℝ), vrv) := by
        funext η
        have e : ((1:ℝ), (0:ℝ), (0:ℝ), (drx h * ζ.1 ^ (drx h - 1)) • vrv) =
            ((1:ℝ), (0:ℝ), (0:ℝ), (0 : ℝ × ℝ)) + (drx h * ζ.1 ^ (drx h - 1)) • ((0:ℝ), (0:ℝ), (0:ℝ), vrv) := by
          simp
        rw [e, map_add, map_smul, smul_eq_mul, one_mul]
      have lhs : yAvg (dR h g₀) ζ =
          yAvg (fun η => fderiv ℝ g₀ η ((1:ℝ), (0:ℝ), (0:ℝ), (drx h * ζ.1 ^ (drx h - 1)) • vrv)) ζ := rfl
      rw [lhs, hsplit, LIN _ _ 1 _ (hgf.clm_apply continuousOn_const) (hgf.clm_apply continuousOn_const)
        ζ hζ, YZ g₀ hg₀ ζ hζ hp1 hp2 vrv]
      simp
    have c3 : yAvg (dT g₀) ζ = yAvg (fun η => fderiv ℝ g₀ η ((0:ℝ), (0:ℝ), (1:ℝ), (0 : ℝ × ℝ))) ζ := by
      have hsplit : (fun η => fderiv ℝ g₀ η ((0:ℝ), (0:ℝ), (1:ℝ), vtv)) =
          fun η => 1 * fderiv ℝ g₀ η ((0:ℝ), (0:ℝ), (1:ℝ), (0 : ℝ × ℝ)) +
            1 * fderiv ℝ g₀ η ((0:ℝ), (0:ℝ), (0:ℝ), vtv) := by
        funext η
        have e : ((0:ℝ), (0:ℝ), (1:ℝ), vtv) =
            ((0:ℝ), (0:ℝ), (1:ℝ), (0 : ℝ × ℝ)) + ((0:ℝ), (0:ℝ), (0:ℝ), vtv) := by
          simp
        rw [e, map_add, one_mul, one_mul]
      have lhs : yAvg (dT g₀) ζ = yAvg (fun η => fderiv ℝ g₀ η ((0:ℝ), (0:ℝ), (1:ℝ), vtv)) ζ := rfl
      rw [lhs, hsplit, LIN _ _ 1 1 (hgf.clm_apply continuousOn_const) (hgf.clm_apply continuousOn_const)
        ζ hζ, YZ g₀ hg₀ ζ hζ hp1 hp2 vtv]
      simp
    refine ⟨?_, ?_, ?_⟩
    · rw [c1]
      exact (LD _ _ ζ.1 hlr rfl).symm
    · exact (LD _ _ ζ.2.1 hlz rfl).symm
    · rw [c3]
      exact (LD _ _ ζ.2.2.1 hlt rfl).symm

  have hpos : ∀ η ∈ S, 0 < η.1 := fun η hη => hU0 _ hη
  have hDf : ContDiffOn ℝ ∞ (fderiv ℝ g) S := ((contDiffOn_infty_iff_fderiv_of_isOpen hSo).1 hg).2
  have hpow : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ (drx h - 1)) S :=
    contDiff_fst.contDiffOn.rpow_const_of_ne (fun η hη => (hpos η hη).ne')
  have hYv : ContDiffOn ℝ ∞ (fun η : Cyl => (drx h * η.1 ^ (drx h - 1)) • vrv) S :=
    (contDiffOn_const.mul hpow).smul_const _
  have hvR : ContDiffOn ℝ ∞ (fun η : Cyl =>
      ((1:ℝ), (0:ℝ), (0:ℝ), (drx h * η.1 ^ (drx h - 1)) • vrv)) S :=
    contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk hYv))
  have hgR : ContDiffOn ℝ ∞ (dR h g) S := (hDf.clm_apply hvR).congr (fun η _ => rfl)
  have hgZ : ContDiffOn ℝ ∞ (dZ g) S := (hDf.clm_apply contDiffOn_const).congr (fun η _ => rfl)
  have hDper : ∀ ζ ∈ S, ∀ n m : ℤ, fderiv ℝ g (shY ζ ((n:ℝ), (m:ℝ))) = fderiv ℝ g ζ := by
    intro ζ hζ n m
    have ha : ∀ η : Cyl, η + ((0:ℝ), (0:ℝ), (0:ℝ), ((n:ℝ), (m:ℝ))) = shY η ((n:ℝ), (m:ℝ)) := by
      intro η
      obtain ⟨a, b, c, d⟩ := η
      simp [shY]
    have hev : (fun η : Cyl => g (η + ((0:ℝ), (0:ℝ), (0:ℝ), ((n:ℝ), (m:ℝ))))) =ᶠ[nhds ζ] g :=
      Filter.eventuallyEq_of_mem (hSo.mem_nhds hζ) (fun η hη => by
        show g (η + ((0:ℝ), (0:ℝ), (0:ℝ), ((n:ℝ), (m:ℝ)))) = g η
        rw [ha η]
        exact hper η hη n m)
    rw [← ha ζ, ← fderiv_comp_add_right, hev.fderiv_eq]
  have hRper : ∀ ζ ∈ S, ∀ n m : ℤ, dR h g (shY ζ ((n:ℝ), (m:ℝ))) = dR h g ζ := by
    intro ζ hζ n m
    have := congrArg (fun A : Cyl →L[ℝ] ℝ => A ((1:ℝ), (0:ℝ), (0:ℝ), (drx h * ζ.1 ^ (drx h - 1)) • vrv))
      (hDper ζ hζ n m)
    exact this
  have hZper : ∀ ζ ∈ S, ∀ n m : ℤ, dZ g (shY ζ ((n:ℝ), (m:ℝ))) = dZ g ζ := by
    intro ζ hζ n m
    have := congrArg (fun A : Cyl →L[ℝ] ℝ => A ((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ)))
      (hDper ζ hζ n m)
    exact this
  have FOg := FO g hg hper
  refine ⟨(FOg ξ hξ).1, (FOg ξ hξ).2.1, (FOg ξ hξ).2.2, ?_, ?_⟩
  · rw [(FO (dR h g) hgR hRper ξ hξ).1]
    apply Filter.EventuallyEq.deriv_eq
    have hW : IsOpen {r : ℝ | (r, ξ.2.1, ξ.2.2.1) ∈ U} := hU.preimage (by fun_prop)
    filter_upwards [hW.mem_nhds (show ξ.1 ∈ {r : ℝ | (r, ξ.2.1, ξ.2.2.1) ∈ U} from hξ)] with r hr
    exact (FOg ((r, ξ.2.1, ξ.2.2.1, (0 : ℝ × ℝ)) : Cyl) hr).1
  · rw [(FO (dZ g) hgZ hZper ξ hξ).2.1]
    apply Filter.EventuallyEq.deriv_eq
    have hW : IsOpen {z : ℝ | (ξ.1, z, ξ.2.2.1) ∈ U} := hU.preimage (by fun_prop)
    filter_upwards [hW.mem_nhds (show ξ.2.1 ∈ {z : ℝ | (ξ.1, z, ξ.2.2.1) ∈ U} from hξ)] with z hz
    exact (FOg ((ξ.1, z, ξ.2.2.1, (0 : ℝ × ℝ)) : Cyl) hz).2.1

theorem stp5_yavg_Eth_expand : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState), IsOpen (DomC B.h (qsOf l0)) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (fun ξ => ubase B ξ a) (DomC B.h (qsOf l0))) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 S a) (DomC B.h (qsOf l0))) → (∀ a b : Fin 3, ContDiffOn ℝ ∞ (Wcov5 B G l0 S a b) (DomC B.h (qsOf l0))) → (∀ ξ ∈ DomC B.h (qsOf l0), ∀ n m : ℤ, (∀ a : Fin 3, mcor5 B G l0 S a (shY ξ ((n : ℝ), (m : ℝ))) = mcor5 B G l0 S a ξ) ∧ (∀ a b : Fin 3, Wcov5 B G l0 S a b (shY ξ ((n : ℝ), (m : ℝ))) = Wcov5 B G l0 S a b ξ)) → ∀ ξ ∈ DomC B.h (qsOf l0), yAvg (EthP5 B G l0 S) ξ = deriv (fun t => yAvg (mcor5 B G l0 S 1) (ξ.1, ξ.2.1, t, 0)) ξ.2.2.1 + (deriv (fun r => yAvg (fun η => ubase B η 0 * mcor5 B G l0 S 1 η + mcor5 B G l0 S 0 η * ubase B η 1 + mcor5 B G l0 S 0 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 0 1 η) (r, ξ.2.1, ξ.2.2.1, 0)) ξ.1 + 2 * yAvg (fun η => ubase B η 0 * mcor5 B G l0 S 1 η + mcor5 B G l0 S 0 η * ubase B η 1 + mcor5 B G l0 S 0 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 0 1 η) (ξ.1, ξ.2.1, ξ.2.2.1, 0) / ξ.1) + deriv (fun z => yAvg (fun η => ubase B η 2 * mcor5 B G l0 S 1 η + ubase B η 1 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 2 1 η) (ξ.1, z, ξ.2.2.1, 0)) ξ.2.1 - ((deriv (fun r => deriv (fun r' => yAvg (mcor5 B G l0 S 1) (r', ξ.2.1, ξ.2.2.1, 0)) r) ξ.1 + deriv (fun r => yAvg (mcor5 B G l0 S 1) (r, ξ.2.1, ξ.2.2.1, 0)) ξ.1 / ξ.1 + deriv (fun z => deriv (fun z' => yAvg (mcor5 B G l0 S 1) (ξ.1, z', ξ.2.2.1, 0)) z) ξ.2.1) - yAvg (mcor5 B G l0 S 1) (ξ.1, ξ.2.1, ξ.2.2.1, 0) / ξ.1 ^ 2) + sBase B 1 ξ :=
by
  intro B G l0 S hDo hub hmc hWc hPer ξ hξ

  have hv : ContDiffOn ℝ ∞ (mcor5 B G l0 S 1) (DomC B.h (qsOf l0)) := hmc 1
  have hF1 : ContDiffOn ℝ ∞ (fun η => ubase B η 0 * mcor5 B G l0 S 1 η + mcor5 B G l0 S 0 η * ubase B η 1 +
      mcor5 B G l0 S 0 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 0 1 η) (DomC B.h (qsOf l0)) :=
    ((((hub 0).mul (hmc 1)).add ((hmc 0).mul (hub 1))).add ((hmc 0).mul (hmc 1))).add (hWc 0 1)
  have hF2 : ContDiffOn ℝ ∞ (fun η => ubase B η 2 * mcor5 B G l0 S 1 η + ubase B η 1 * mcor5 B G l0 S 2 η +
      mcor5 B G l0 S 2 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 2 1 η) (DomC B.h (qsOf l0)) :=
