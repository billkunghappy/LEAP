    apply div_le_div_of_nonneg_right _ hX.le
    nlinarith [mul_nonneg (mul_nonneg hP0 hlx) hae]
  have hQ0 : 0 ≤ P * |η| / X := by positivity
  have hT1 : |η * ((a * Mk2 - b * Mc) / X)| ≤ 72 * (P * (1 + lx) * |η| / X) := by
