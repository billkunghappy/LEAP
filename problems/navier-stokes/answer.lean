  have hopen : IsOpen (Ioi (-1 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) := isOpen_Ioi.prod isOpen_Ioo
  have hdiffR : ∀ (G : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿G) (Ioi (-1 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) →
