      have t1 : ‖w‖ ≤ (L + 1) * (K * δ) := by
        calc ‖w‖ ≤ L * (K * ‖d‖) := hwn
          _ ≤ (L + 1) * (K * ‖d‖) := by nlinarith [mul_nonneg hK0.le (norm_nonneg d)]
