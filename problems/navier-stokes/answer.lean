      have h2 := hV i hi
      fun_prop)
    have hS3 := hsum (fun i w => (pv i).2 w * deriv (pv (n - i)).2 w) (by
      intro i hi
      have h1 := hdV (n - i) (Nat.sub_le n i)
      have h2 := hV i hi
      fun_prop)
    have h5 := hV n le_rfl
    have h6 := hdV n le_rfl
    fun_prop

theorem ax_step_real : ∀ (h j0 Λ r : ℝ) (χ ζ ℓ z g : ℂ → ℂ) (pv : ℕ → (ℂ → ℂ) × (ℂ → ℂ)) (n : ℕ), 0 < r → DifferentiableOn ℂ g (axRect r) → (∀ m ≤ n, DifferentiableOn ℂ (pv m).1 (axRect r) ∧ DifferentiableOn ℂ (pv m).2 (axRect r)) → (∀ η : ℝ, -1 - r < η → η < 1 + r → (χ (η : ℂ)).im = 0 ∧ (ζ (η : ℂ)).im = 0 ∧ (ℓ (η : ℂ)).im = 0 ∧ (z (η : ℂ)).im = 0 ∧ (g (η : ℂ)).im = 0) → (∀ m ≤ n, ∀ η : ℝ, -1 - r < η → η < 1 + r → ((pv m).1 (η : ℂ)).im = 0 ∧ ((pv m).2 (η : ℂ)).im = 0) → ∀ η : ℝ, -1 - r < η → η < 1 + r → ((axRecStep h j0 Λ χ ζ ℓ z g pv n).1 (η : ℂ)).im = 0 ∧ ((axRecStep h j0 Λ χ ζ ℓ z g pv n).2 (η : ℂ)).im = 0 :=
