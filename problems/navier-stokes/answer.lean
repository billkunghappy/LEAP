    obtain ⟨u, hu⟩ : ∃ u : Cyl, u = ((0:ℝ), (0:ℝ), (0:ℝ), v) := ⟨_, rfl⟩
    obtain ⟨lam, hlam⟩ : ∃ lam : ℂ,
