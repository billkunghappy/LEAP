  have hB2' := inWg5_cross_mult B G l0 hok β1 0 c (fun _ _ _ => (![0, 0, -1] : Fin 3 → ℂ)) H1
    (fun γ m ξ _ _ => contDiffAt_const) (fun γ m ξ _ _ c' _ => rfl) bdN
  have hB2 : InWg5 B G (qsOf l0) β1 (fun γ m ξ => crossC (![0, 0, -1] : Fin 3 → ℂ) (c γ m ξ)) := by
    simpa only [add_zero] using hB2'
  obtain ⟨hm2s, hm2d, hm2b⟩ := pmr_mu2_nb_v5 B l0 hok
