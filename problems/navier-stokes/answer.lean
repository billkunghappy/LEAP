        simp only [mem_Icc, not_and_or, not_le] at hx; exact hx
      have hfx : f x = 0 := hf0 x (hx'.imp le_of_lt le_of_lt)
      have hdx : deriv f x = 0 := by
        have hev : f =ᶠ[nhds x] fun _ => (0:ℝ) := by
          rcases hx' with h' | h'
          · exact Filter.eventuallyEq_of_mem (Iio_mem_nhds h') (fun y hy => hf0 y (Or.inl (le_of_lt hy)))
          · exact Filter.eventuallyEq_of_mem (Ioi_mem_nhds h') (fun y hy => hf0 y (Or.inr (le_of_lt hy)))
        rw [hev.deriv_eq]; simp
      rw [hfx, hdx]; simp
  obtain ⟨Kb0, hKb0p, hKb0⟩ := hbump (β 0) (hβs 0) (hβ0 0)
  obtain ⟨Kb1, hKb1p, hKb1⟩ := hbump (β 1) (hβs 1) (hβ0 1)
  obtain ⟨Kg0, hKg0p, hKg0⟩ := hbump (γ 0) (hγs 0) (hγ0 0)
  obtain ⟨Kg1, hKg1p, hKg1⟩ := hbump (γ 1) (hγs 1) (hγ0 1)
  obtain ⟨Kg2, hKg2p, hKg2⟩ := hbump (γ 2) (hγs 2) (hγ0 2)
  obtain ⟨Kb, hKbd⟩ : ∃ Kb : ℝ, Kb = Kb0 + Kb1 + Kg0 + Kg1 + Kg2 := ⟨_, rfl⟩
  have hKbn : 0 ≤ Kb := by rw [hKbd]; positivity
  have hKbβ : ∀ i x, |β i x| ≤ Kb ∧ |x * deriv (β i) x| ≤ Kb := by
    intro i x
    fin_cases i
    · exact ⟨(hKb0 x).1.trans (by rw [hKbd]; linarith), (hKb0 x).2.trans (by rw [hKbd]; linarith)⟩
    · exact ⟨(hKb1 x).1.trans (by rw [hKbd]; linarith), (hKb1 x).2.trans (by rw [hKbd]; linarith)⟩
  have hKbγ : ∀ j x, |γ j x| ≤ Kb ∧ |x * deriv (γ j) x| ≤ Kb := by
    intro j x
    fin_cases j
    · exact ⟨(hKg0 x).1.trans (by rw [hKbd]; linarith), (hKg0 x).2.trans (by rw [hKbd]; linarith)⟩
    · exact ⟨(hKg1 x).1.trans (by rw [hKbd]; linarith), (hKg1 x).2.trans (by rw [hKbd]; linarith)⟩
    · exact ⟨(hKg2 x).1.trans (by rw [hKbd]; linarith), (hKg2 x).2.trans (by rw [hKbd]; linarith)⟩
  have hBump : AxBumps s1 s2 β γ := by
    unfold AxBumps; exact ⟨hs1, hs12, hs2, hβs, hγs, hβ0, hγ0⟩

  obtain ⟨K2, hK2, hK2c⟩ := ax_repair_coef δ Φ hδ hΦs hΦ0
  obtain ⟨K1, hK1, hK1s⟩ := ax_disc_small h Pst Pax hD

  obtain ⟨A, hAd⟩ : ∃ A : ℝ, A = 1 + Ks + K2 * K1 * Kb := ⟨_, rfl⟩
  obtain ⟨N, hNd⟩ : ∃ N : ℝ, N = 200 + 4 * MP + 30 * Pst ^ 2 := ⟨_, rfl⟩
  have hA : 1 ≤ A := by
    rw [hAd]; have : 0 ≤ K2 * K1 * Kb := by positivity
    linarith
  have hA0 : 0 < A := by linarith
  have hN : 0 < N := by rw [hNd]; positivity
  obtain ⟨ε, hεd⟩ : ∃ ε : ℝ, ε = min (min (1 / 100) (δ / (2 * K1)))
      (min (1 / (100 * A)) (min (Pst / (3000 * A)) (Pst ^ 2 / (2000000 * A * N)))) := ⟨_, rfl⟩
  have hεpos : 0 < ε := by rw [hεd]; positivity
  have hε1 : ε ≤ 1 / 100 := by rw [hεd]; exact (min_le_left _ _).trans (min_le_left _ _)
  have hε2 : ε ≤ δ / (2 * K1) := by rw [hεd]; exact (min_le_left _ _).trans (min_le_right _ _)
  have hε3 : ε ≤ 1 / (100 * A) := by rw [hεd]; exact (min_le_right _ _).trans (min_le_left _ _)
  have hε4 : ε ≤ Pst / (3000 * A) := by
