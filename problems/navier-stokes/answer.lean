        M * (∫ x in X..Xb, Kθ x) / (X * (1 - 2 * h * η ^ 2)) :=
      div_le_div_of_nonneg_right hmono hXL.le
    have s4 : M * (∫ x in X..Xb, Kθ x) / (X * (1 - 2 * h * η ^ 2)) =
