theorem outer_axis_datum : ∃ (h lam Pst ab Rst : ℝ) (Pax : ℝ → ℝ), AxDatum h Pst Pax ∧ 0 < lam ∧ 0 < ab ∧ 0 < Rst ∧ ∀ XR : ℝ, Rst ≤ XR → ∃ (cpatch cinf Xg Xg2 r1 r2 p1 p2 m1 m2 Xv Xc Xb : ℝ) (Fo Uo : ℝ → ℝ → ℝ), OutProf h lam Pst XR cpatch cinf ab Xg Xg2 r1 r2 p1 p2 m1 m2 Xv Xc Xb Pax Fo Uo :=
by
  choose ρ0 ε0 X0 hρ0 hε0 hX0 hcol using tail_collar_admblk
  obtain ⟨h, lam, Pst, Rst, c, ϑ, hh0, hh1, hlam, hPst, hRst, hSD, hO⟩ :=
    outer_core_construction ρ0 ε0 X0 (fun h => ⟨hρ0 h, hε0 h, hX0 h⟩)
  have hPst0 : 0 < Pst := lt_trans (Real.exp_pos 10) hPst
  obtain ⟨hAn, hEv, hSz, hDr⟩ := shape_datum_axdatum Pst c ϑ hPst0 hSD
  refine ⟨h, lam, Pst, 4, Rst, shapeDatum c ϑ, ⟨hh0, hh1, hPst0, hPst, hAn, hEv, hSz, hDr⟩, hlam,
    by norm_num, hRst, ?_⟩
  intro XR hXR
  obtain ⟨cpatch, cinf, ρ, Xg, Xg2, r1, r2, p1, p2, m1, m2, Xv, Xc, Xb, Fo, Uo, hρ, hρle, hX0b,
    hXcb, hord, hbd, hin, hpatch, hXv, hPi, hTF, hsmall, hηb, hAdm1, hRel⟩ := hO XR hXR
  obtain ⟨hcp, hci, hXR0, hXRg, hgg2, hg2r1, hr12, hr2p1, hp12, hp2m1, hm12, hm2v, hvc, hcb⟩ := hord
  have hTF' := hTF
  obtain ⟨-, -, -, hXb0, -, -, hFs, hUs, hFpos, htail, hint⟩ := hTF'
  obtain ⟨hAdm2, hO8⟩ := hcol h cinf ρ Xb Fo Uo hρ hρle hX0b hTF hsmall
  have hsm := outer_stress_smooth h Fo Uo hh0 hh1 hFs hUs hFpos hηb

  have hunion : ∀ (w δ : ℝ → ℝ) (S S1 S2 : Set ℝ), S ⊆ S1 ∪ S2 →
      (∀ X ∈ S, 0 ≤ w X ∧ 0 < δ X ∧ δ X ≤ 1) →
      AdmBlk h w δ S1 Fo Uo → AdmBlk h w δ S2 Fo Uo → AdmBlk h w δ S Fo Uo := by
    intro w δ S S1 S2 hS hwd hA1 hA2
    obtain ⟨⟨c1, hc1, hl1⟩, hu1, ⟨k1, hk1, hk1', hcone1⟩⟩ := hA1
    obtain ⟨⟨c2, hc2, hl2⟩, hu2, ⟨k2, hk2, hk2', hcone2⟩⟩ := hA2
    refine ⟨⟨min c1 c2, lt_min hc1 hc2, ?_⟩, ?_,
      ⟨min k1 k2, lt_min hk1 hk2, lt_of_le_of_lt (min_le_left _ _) hk1', ?_⟩⟩
    · intro X hX η h1 h2
      have hw := (hwd X hX).1
      rcases hS hX with hX' | hX'
      · exact le_trans (mul_le_mul_of_nonneg_right (min_le_left _ _) hw) (hl1 X hX' η h1 h2)
      · exact le_trans (mul_le_mul_of_nonneg_right (min_le_right _ _) hw) (hl2 X hX' η h1 h2)
    · intro m
      obtain ⟨C1, N1, hb1⟩ := hu1 m
      obtain ⟨C2, N2, hb2⟩ := hu2 m
      refine ⟨max (max C1 C2) 0, max (max N1 N2) 0, ?_⟩
      intro X hX η h1 h2
      obtain ⟨hw, hd0, hd1⟩ := hwd X hX
      have hM0 : 0 ≤ max (max C1 C2) 0 := le_max_right _ _
      have key : ∀ (C N : ℝ), C ≤ max (max C1 C2) 0 → N ≤ max (max N1 N2) 0 →
          C * w X * δ X ^ (-N) ≤ max (max C1 C2) 0 * w X * δ X ^ (-(max (max N1 N2) 0)) := by
        intro C N hC hN
        have hp : δ X ^ (-N) ≤ δ X ^ (-(max (max N1 N2) 0)) :=
          Real.rpow_le_rpow_of_exponent_ge hd0 hd1 (by linarith)
        have hp0 : 0 ≤ δ X ^ (-N) := Real.rpow_nonneg hd0.le _
        calc C * w X * δ X ^ (-N) ≤ max (max C1 C2) 0 * w X * δ X ^ (-N) :=
              mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hC hw) hp0
          _ ≤ max (max C1 C2) 0 * w X * δ X ^ (-(max (max N1 N2) 0)) :=
              mul_le_mul_of_nonneg_left hp (mul_nonneg hM0 hw)
      have hC1 : C1 ≤ max (max C1 C2) 0 := le_trans (le_max_left _ _) (le_max_left _ _)
      have hC2 : C2 ≤ max (max C1 C2) 0 := le_trans (le_max_right _ _) (le_max_left _ _)
      have hN1 : N1 ≤ max (max N1 N2) 0 := le_trans (le_max_left _ _) (le_max_left _ _)
      have hN2 : N2 ≤ max (max N1 N2) 0 := le_trans (le_max_right _ _) (le_max_left _ _)
      rcases hS hX with hX' | hX'
      · obtain ⟨a1, a2, a3, a4⟩ := hb1 X hX' η h1 h2
        exact ⟨a1.trans (key C1 N1 hC1 hN1), a2.trans (key C1 N1 hC1 hN1), a3.trans hC1,
          a4.trans hC1⟩
      · obtain ⟨a1, a2, a3, a4⟩ := hb2 X hX' η h1 h2
        exact ⟨a1.trans (key C2 N2 hC2 hN2), a2.trans (key C2 N2 hC2 hN2), a3.trans hC2,
          a4.trans hC2⟩
    · intro X hX η h1 h2
      rcases hS hX with hX' | hX'
      · obtain ⟨b1, b2, b3, b4, b5⟩ := hcone1 X hX' η h1 h2
        refine ⟨le_trans (min_le_left _ _) b1, le_trans (min_le_left _ _) b2,
          le_trans (min_le_left _ _) b3,
          le_trans (mul_le_mul_of_nonneg_right (min_le_left _ _) (Real.sqrt_nonneg _)) b4,
          le_trans b5 (mul_le_mul_of_nonneg_right ?_ (sq_nonneg _))⟩
        linarith [min_le_left k1 k2]
      · obtain ⟨b1, b2, b3, b4, b5⟩ := hcone2 X hX' η h1 h2
        refine ⟨le_trans (min_le_right _ _) b1, le_trans (min_le_right _ _) b2,
          le_trans (min_le_right _ _) b3,
          le_trans (mul_le_mul_of_nonneg_right (min_le_right _ _) (Real.sqrt_nonneg _)) b4,
          le_trans b5 (mul_le_mul_of_nonneg_right ?_ (sq_nonneg _))⟩
        linarith [min_le_right k1 k2]
  have hAdm : AdmBlk h (fun X => Real.exp (-(4 / Real.log (Xb / X) ^ 2)))
      (fun X => min 1 (Real.log (Xb / X))) (Ico Xg Xb) Fo Uo := by
    refine hunion _ _ (Ico Xg Xb) (Ico Xg (Xb * Real.exp (-(5 / 2))))
      (Ico (Xb * Real.exp (-(5 / 2))) Xb) ?_ ?_ hAdm1 hAdm2
    · intro X hX
      by_cases hXl : X < Xb * Real.exp (-(5 / 2))
      · exact Or.inl ⟨hX.1, hXl⟩
      · exact Or.inr ⟨not_lt.1 hXl, hX.2⟩
    · intro X hX
      have hX0 : 0 < X := by linarith [hX.1]
      refine ⟨(Real.exp_pos _).le, lt_min one_pos (Real.log_pos ?_), min_le_left _ _⟩
      exact (one_lt_div hX0).2 hX.2
  refine ⟨cpatch, cinf, Xg, Xg2, r1, r2, p1, p2, m1, m2, Xv, Xc, Xb, Fo, Uo, ?_⟩
  refine ⟨⟨hcp, hci, by norm_num, hXR0, hXRg, hgg2, hg2r1, hr12, hr2p1, hp12, hp2m1, hm12, hm2v,
    hvc, hcb⟩, ⟨hFs, hUs, hFpos, hbd⟩, hin, hpatch, ?_, hXv, ?_, ?_, ?_,
    ⟨fun X η hX h1 h2 => tail_stress_zero h cinf ρ Xb Fo Uo hTF X η hX h1 h2, hsm.1, hsm.2,
      hAdm, hRel⟩⟩
  · intro X η hX h1 h2
    have he : Real.exp (-(11 / 4 : ℝ)) ≤ 1 := Real.exp_le_one_iff.2 (by norm_num)
    have hXt : Xb * Real.exp (-(11 / 4)) ≤ X :=
      le_trans (mul_le_of_le_one_right hXb0.le he) hX
    obtain ⟨hU, -, hE⟩ := htail X η hXt h1 h2
    refine ⟨hU, ?_⟩
    have hfac : tailFac ρ Xb X = 1 := by
      have hl : 0 ≤ Real.log (X / Xb) := Real.log_nonneg ((one_le_div hXb0).2 hX)
      have hy : 1 ≤ (Real.log (X / Xb) + 2) / 2 := by linarith
      unfold tailFac sigA
      rw [if_neg (by linarith), if_pos hy]
      ring
    rw [hE, hfac, mul_one]
  · intro η h1 h2
    obtain ⟨i1, i2, i3, i4, t1, t2, t3, -⟩ := hint η h1 h2
    exact ⟨i1, i2, i3, i4, t1, t2, t3, hPi η h1 h2⟩
  · intro η h1 h2 X hX
    exact (hint η h1 h2).2.2.2.2.2.2.2 X hX
  · intro m
    obtain ⟨C, N, hCN⟩ := hO8 m
    exact ⟨C, N, fun X η hX1 hX2 h1 h2 => hCN X η (le_trans hXcb.le hX1) hX2 h1 h2⟩

theorem ax_stress_local : AxStressLocal :=
by
  have hInt : ∀ (g g' : ℝ → ℝ → ℝ) (X1 X e : ℝ),
      (∀ x e : ℝ, 0 < x → x < X1 → -1 < e → e < 1 → g' x e = g x e) →
      0 < X → X < X1 → -1 < e → e < 1 → profRadInt g' X e = profRadInt g X e := by
    intro g g' X1 X e hg hX hX1 he1 he2
    unfold profRadInt
    apply intervalIntegral.integral_congr_ae
    refine MeasureTheory.ae_of_all _ (fun x hx => ?_)
    rw [Set.uIoc_of_le hX.le] at hx
    exact hg x e hx.1 (lt_of_le_of_lt hx.2 hX1) he1 he2
  have hAvg : ∀ (g g' : ℝ → ℝ → ℝ) (X1 X e : ℝ),
      (∀ x e : ℝ, 0 < x → x < X1 → -1 < e → e < 1 → g' x e = g x e) →
      0 < X → X < X1 → -1 < e → e < 1 → profRadAvg g' X e = profRadAvg g X e := by
    intro g g' X1 X e hg hX hX1 he1 he2
    unfold profRadAvg
    apply intervalIntegral.integral_congr_ae
    refine MeasureTheory.ae_of_all _ (fun s hs => ?_)
    rw [Set.uIoc_of_le zero_le_one] at hs
    have h1 : 0 < s * X := mul_pos hs.1 hX
    have h2 : s * X ≤ X := mul_le_of_le_one_left hX.le hs.2
    exact hg (s * X) e h1 (lt_of_le_of_lt h2 hX1) he1 he2
  have hEta : ∀ (G G' : ℝ → ℝ → ℝ) (X η : ℝ), -1 < η → η < 1 →
      (∀ e : ℝ, -1 < e → e < 1 → G' X e = G X e) → profEtaD G' X η = profEtaD G X η := by
    intro G G' X η h1 h2 hG
    unfold profEtaD
    apply Filter.EventuallyEq.deriv_eq
    exact Filter.eventuallyEq_of_mem (Ioo_mem_nhds h1 h2) (fun e he => hG e he.1 he.2)
  refine ⟨?_, ?_⟩
  · intro h X1 Pax F U F' U' hag X η hX0 hX1 hη1 hη2
    have hF : F' X η = F X η := (hag X η hX0 hX1 hη1 hη2).1
    have hU : U' X η = U X η := (hag X η hX0 hX1 hη1 hη2).2
    have hdF : deriv (fun Y => F' Y η) X = deriv (fun Y => F Y η) X :=
      Filter.EventuallyEq.deriv_eq (Filter.eventuallyEq_of_mem (Ioo_mem_nhds hX0 hX1)
        (fun Y hY => (hag Y η hY.1 hY.2 hη1 hη2).1))
    have hdU : deriv (fun Y => U' Y η) X = deriv (fun Y => U Y η) X :=
      Filter.EventuallyEq.deriv_eq (Filter.eventuallyEq_of_mem (Ioo_mem_nhds hX0 hX1)
        (fun Y hY => (hag Y η hY.1 hY.2 hη1 hη2).2))
    have hR : ∀ g g' : ℝ → ℝ → ℝ,
        (∀ x e : ℝ, 0 < x → x < X1 → -1 < e → e < 1 → g' x e = g x e) →
        profRadInt g' X η = profRadInt g X η ∧
          profEtaD (profRadInt g') X η = profEtaD (profRadInt g) X η := by
      intro g g' hg
      exact ⟨hInt g g' X1 X η hg hX0 hX1 hη1 hη2,
        hEta _ _ X η hη1 hη2 (fun e a b => hInt g g' X1 X e hg hX0 hX1 a b)⟩
    have gU : ∀ x e : ℝ, 0 < x → x < X1 → -1 < e → e < 1 → U' x e = U x e :=
      fun x e a b c d => (hag x e a b c d).2
    have r1 := hR (fun x e => 2 * x * F x e) (fun x e => 2 * x * F' x e) (by
      intro x e a b c d
      obtain ⟨h1, h2⟩ := hag x e a b c d
      simp only [h1])
    have r2 := hR (fun x e => U x e * (2 * x * F x e)) (fun x e => U' x e * (2 * x * F' x e)) (by
      intro x e a b c d
      obtain ⟨h1, h2⟩ := hag x e a b c d
      simp only [h1, h2])
    have r3 := hR U U' gU
    have r4 := hR (fun x e => U x e ^ 2 - x * F x e ^ 2) (fun x e => U' x e ^ 2 - x * F' x e ^ 2) (by
      intro x e a b c d
      obtain ⟨h1, h2⟩ := hag x e a b c d
      simp only [h1, h2])
    have g5 : ∀ x e : ℝ, 0 < x → x < X1 → -1 < e → e < 1 →
        (fun x e => F' x e ^ 2) x e = (fun x e => F x e ^ 2) x e := by
      intro x e a b c d
      obtain ⟨h1, h2⟩ := hag x e a b c d
      simp only [h1]
    have hW : leadW h U' X η = leadW h U X η := by
      unfold leadW
      rw [hAvg U U' X1 X η gU hX0 hX1 hη1 hη2,
        hEta _ _ X η hη1 hη2 (fun e a b => hAvg U U' X1 X e gU hX0 hX1 a b)]
    have hPi : axPi Pax F' X η = axPi Pax F X η := by
      unfold axPi
      rw [hInt _ _ X1 X η g5 hX0 hX1 hη1 hη2]
    have hdPi : profEtaD (axPi Pax F') X η = profEtaD (axPi Pax F) X η :=
      hEta _ _ X η hη1 hη2 (fun e a b => by
        unfold axPi
        rw [hInt _ _ X1 X e g5 hX0 hX1 a b])
    refine ⟨?_, ?_, ?_, ?_⟩
    · unfold leadQs
      rw [hW, r1.1, r1.2, r2.1, r2.2, hF]
    · unfold axNs
      rw [hW, hU, r3.1, r3.2, r4.1, r4.2, hPi, hdPi]
    · unfold shearA
      rw [hdF, hF]
    · unfold shearB
      rw [hdU, hF]
  · intro h Pax F U hdat X η hX hη1 hη2
    have hC : ∀ e : ℝ, -1 < e → e < 1 → leadPi F X e = axPi Pax F X e := by
      intro e he1 he2
      obtain ⟨hI, hP⟩ := hdat e he1 he2
      unfold leadPi at hP ⊢
      unfold axPi profRadInt
      have hUn : Ioc 0 X ∪ Ioi X = Ioi (0:ℝ) := Set.Ioc_union_Ioi_eq_Ioi hX.le
      have hsplit : ∫ x in Ioi (0:ℝ), F x e ^ 2 =
          (∫ x in Ioc 0 X, F x e ^ 2) + ∫ x in Ioi X, F x e ^ 2 := by
        rw [← hUn]
        exact MeasureTheory.setIntegral_union Set.Ioc_disjoint_Ioi_same measurableSet_Ioi
          (hI.mono_set (fun x hx => hx.1)) (hI.mono_set (Set.Ioi_subset_Ioi hX.le))
      rw [intervalIntegral.integral_of_le hX.le]
      linarith
    unfold leadNs axNs
    rw [hC η hη1 hη2, hEta (axPi Pax F) (leadPi F) X η hη1 hη2 hC]

theorem ax_stress_smooth : AxStressSmooth :=
by
  intro h ε Pax F U hh0 hh1 hε hF hU hFpos hPax
  set Ω : Set (ℝ × ℝ) := Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 with hΩdef
  have hΩo : IsOpen Ω := isOpen_Ioi.prod isOpen_Ioo
  have hsub : Ω ⊆ Ioi (-ε) ×ˢ Ioo (-1) 1 := fun p hp =>
    ⟨show -ε < p.1 from lt_trans (neg_lt_zero.mpr hε) hp.1, hp.2⟩

  have hpd : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) Ω →
      ContDiffOn ℝ ∞ (↿(profEtaD g)) Ω ∧ ContDiffOn ℝ ∞ (↿(pdX g)) Ω := by
    intro g hg
    obtain ⟨hd, hG'⟩ := (contDiffOn_infty_iff_fderiv_of_isOpen hΩo).1 hg
    have hhas : ∀ p ∈ Ω, HasFDerivAt (↿g) (fderiv ℝ (↿g) p) (p.1, p.2) := fun p hp =>
      ((hd p hp).differentiableAt (hΩo.mem_nhds hp)).hasFDerivAt
    constructor
    · refine (hG'.clm_apply (contDiffOn_const (c := ((0:ℝ), (1:ℝ))))).congr ?_
      intro p hp
      have hc : HasDerivAt (fun e : ℝ => (p.1, e)) ((0:ℝ), (1:ℝ)) p.2 :=
        (hasDerivAt_const p.2 p.1).prodMk (hasDerivAt_id' p.2)
      exact ((hhas p hp).comp_hasDerivAt p.2 hc).deriv
    · refine (hG'.clm_apply (contDiffOn_const (c := ((1:ℝ), (0:ℝ))))).congr ?_
      intro p hp
      have hc : HasDerivAt (fun Y : ℝ => (Y, p.2)) ((1:ℝ), (0:ℝ)) p.1 :=
        (hasDerivAt_id' p.1).prodMk (hasDerivAt_const p.1 p.2)
      exact ((hhas p hp).comp_hasDerivAt p.1 hc).deriv

  have hrad : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿(profRadInt g)) Ω := by
    intro g hg
    obtain ⟨hA, -, hId⟩ := profRadAvg_props g ε hε hg
    refine ((contDiffOn_fst.mul hA).mono hsub).congr ?_
    intro p hp
    exact ((hId p.1 p.2 (hsub hp).1 hp.2.1 hp.2.2).1).symm

  have hFp : ∀ p ∈ Ω, 0 < F p.1 p.2 := fun p hp => hFpos _ _ (le_of_lt hp.1) hp.2.1 hp.2.2
  have hLp : ∀ p ∈ Ω, 0 < 1 - 2 * h * p.2 ^ 2 := by
    intro p hp
    have h1 : -1 < p.2 := hp.2.1
    have h2 : p.2 < 1 := hp.2.2
    have hsq : p.2 ^ 2 < 1 := by nlinarith
    nlinarith [mul_pos hh0 (sub_pos.2 hsq)]

  have g2 : ContDiffOn ℝ ∞ (↿(fun x e : ℝ => 2 * x * F x e)) (Ioi (-ε) ×ˢ Ioo (-1) 1) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 2 * p.1 * F p.1 p.2) _
    exact (contDiffOn_const.mul contDiffOn_fst).mul hF
  have g3 : ContDiffOn ℝ ∞ (↿(fun x e : ℝ => U x e * (2 * x * F x e)))
      (Ioi (-ε) ×ˢ Ioo (-1) 1) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => U p.1 p.2 * (2 * p.1 * F p.1 p.2)) _
    exact hU.mul ((contDiffOn_const.mul contDiffOn_fst).mul hF)
  have g4 : ContDiffOn ℝ ∞ (↿(fun x e : ℝ => U x e ^ 2 - x * F x e ^ 2))
      (Ioi (-ε) ×ˢ Ioo (-1) 1) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => U p.1 p.2 ^ 2 - p.1 * F p.1 p.2 ^ 2) _
    exact (hU.pow 2).sub (contDiffOn_fst.mul (hF.pow 2))
  have g5 : ContDiffOn ℝ ∞ (↿(fun x e : ℝ => F x e ^ 2)) (Ioi (-ε) ×ˢ Ioo (-1) 1) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => F p.1 p.2 ^ 2) _
    exact hF.pow 2

  have f : ContDiffOn ℝ ∞ (↿F) Ω := hF.mono hsub
  have u : ContDiffOn ℝ ∞ (↿U) Ω := hU.mono hsub
  have fx : ContDiffOn ℝ ∞ (↿(pdX F)) Ω := (hpd F f).2
  have ux : ContDiffOn ℝ ∞ (↿(pdX U)) Ω := (hpd U u).2
  have a : ContDiffOn ℝ ∞ (↿(profRadAvg U)) Ω := (profRadAvg_props U ε hε hU).1.mono hsub
  have a' := (hpd _ a).1
  have I := hrad _ g2
  have I' := (hpd _ I).1
  have J := hrad _ g3
  have J' := (hpd _ J).1
  have M := hrad _ hU
  have M' := (hpd _ M).1
  have S := hrad _ g4
  have S' := (hpd _ S).1
  have hPi : ContDiffOn ℝ ∞ (↿(axPi Pax F)) Ω := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Pax p.2 + profRadInt (fun x e => F x e ^ 2) p.1 p.2) Ω
    exact (hPax.comp contDiffOn_snd (fun p hp => hp.2)).add (hrad _ g5)
  have hPi' := (hpd _ hPi).1

  have hLs : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 1 - 2 * h * p.2 ^ 2) Ω :=
    contDiffOn_const.sub (contDiffOn_const.mul (contDiffOn_snd.pow 2))
  have hR : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Real.sqrt (2 * p.1)) Ω :=
    (contDiffOn_const.mul contDiffOn_fst).sqrt (fun p hp => (mul_pos two_pos hp.1).ne')
  have hW : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => leadW h U p.1 p.2) Ω := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 1 - 2 * (1 / 2 - h) * p.2 * profRadAvg U p.1 p.2
      - (1 - p.2 ^ 2) * profEtaD (profRadAvg U) p.1 p.2) Ω
    exact (contDiffOn_const.sub ((contDiffOn_const.mul contDiffOn_snd).mul a)).sub
      ((contDiffOn_const.sub (contDiffOn_snd.pow 2)).mul a')
  constructor
  ·
    have hQ : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => leadQs h F U p.1 p.2) Ω := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => -leadW h U p.1 p.2 +
        ((1 - h) * profRadInt (fun x e => 2 * x * F x e) p.1 p.2
          - (1 / 2 - h) * p.2 * profEtaD (profRadInt (fun x e => 2 * x * F x e)) p.1 p.2
          - (1 - p.2 ^ 2) * profEtaD (profRadInt (fun x e => U x e * (2 * x * F x e))) p.1 p.2
          + 2 * (h - (1 / 2 - h)) * p.2 * profRadInt (fun x e => U x e * (2 * x * F x e)) p.1 p.2) /
        (p.1 * (2 * p.1 * F p.1 p.2))) Ω
      refine hW.neg.add (ContDiffOn.fun_div ?_ ?_ ?_)
      · exact (((contDiffOn_const.mul I).sub ((contDiffOn_const.mul contDiffOn_snd).mul I')).sub
          ((contDiffOn_const.sub (contDiffOn_snd.pow 2)).mul J')).add
          ((contDiffOn_const.mul contDiffOn_snd).mul J)
      · exact contDiffOn_fst.mul ((contDiffOn_const.mul contDiffOn_fst).mul f)
      · intro p hp
        exact (mul_pos hp.1 (mul_pos (mul_pos two_pos hp.1) (hFp p hp))).ne'
    have hSa : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => shearA F p.1 p.2) Ω := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => -2 * p.1 * pdX F p.1 p.2 / F p.1 p.2) Ω
      exact ((contDiffOn_const.mul contDiffOn_fst).mul fx).fun_div f (fun p hp => (hFp p hp).ne')
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => F p.1 p.2 *
      (p.1 * leadQs h F U p.1 p.2 / (1 - 2 * h * p.2 ^ 2) - shearA F p.1 p.2)) Ω
    exact f.mul (((contDiffOn_fst.mul hQ).fun_div hLs (fun p hp => (hLp p hp).ne')).sub hSa)
  ·
    have hNs : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => axNs h Pax F U p.1 p.2) Ω := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => -leadW h U p.1 p.2 * U p.1 p.2 +
        ((1 / 2 - h) * (profRadInt U p.1 p.2 - p.2 * profEtaD (profRadInt U) p.1 p.2)
          + 4 * h * p.2 * profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2) p.1 p.2
          - (1 - p.2 ^ 2) * profEtaD (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2)) p.1 p.2) / p.1
        + 4 * (1 / 2 + h) * p.2 * axPi Pax F p.1 p.2 - (1 - p.2 ^ 2) * profEtaD (axPi Pax F) p.1 p.2) Ω
      have hnum : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ =>
          (1 / 2 - h) * (profRadInt U p.1 p.2 - p.2 * profEtaD (profRadInt U) p.1 p.2)
          + 4 * h * p.2 * profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2) p.1 p.2
          - (1 - p.2 ^ 2) * profEtaD (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2)) p.1 p.2) Ω :=
        ((contDiffOn_const.mul (M.sub (contDiffOn_snd.mul M'))).add
          ((contDiffOn_const.mul contDiffOn_snd).mul S)).sub
          ((contDiffOn_const.sub (contDiffOn_snd.pow 2)).mul S')
      exact (((hW.neg.mul u).add (hnum.fun_div contDiffOn_fst (fun p hp => (ne_of_gt hp.1)))).add
        ((contDiffOn_const.mul contDiffOn_snd).mul hPi)).sub
        ((contDiffOn_const.sub (contDiffOn_snd.pow 2)).mul hPi')
    have hPs : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => axPs2 h Pax F U p.1 p.2) Ω := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 * axNs h Pax F U p.1 p.2 /
        ((1 - 2 * h * p.2 ^ 2) * (Real.sqrt (2 * p.1) * F p.1 p.2))) Ω
      refine (contDiffOn_fst.mul hNs).fun_div (hLs.mul (hR.mul f)) ?_
      intro p hp
      exact (mul_pos (hLp p hp) (mul_pos (Real.sqrt_pos.mpr (mul_pos two_pos hp.1)) (hFp p hp))).ne'
    have hSb : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => shearB F U p.1 p.2) Ω := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Real.sqrt (2 * p.1) * pdX U p.1 p.2 / F p.1 p.2) Ω
      exact (hR.mul ux).fun_div f (fun p hp => (hFp p hp).ne')
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => F p.1 p.2 *
      (axPs2 h Pax F U p.1 p.2 + shearB F U p.1 p.2)) Ω
    exact f.mul (hPs.add hSb)

theorem ax_source_identity : AxSourceId :=
by
  intro h ε Pax F U hh0 hh1 hε hF hU hFpos hPax X η hX hη1 hη2
  have hΩ : IsOpen (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hXε : -ε < X := by linarith

  have etap : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) →
      ∃ gη : ℝ → ℝ → ℝ, ContinuousOn (↿gη) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) ∧
        ∀ x e : ℝ, -ε < x → -1 < e → e < 1 → HasDerivAt (fun e' => g x e') (gη x e) e := by
    intro g hg
    refine ⟨fun x e => fderiv ℝ (↿g) (x, e) ((0 : ℝ), (1 : ℝ)), ?_, ?_⟩
    · show ContinuousOn (fun p : ℝ × ℝ => fderiv ℝ (↿g) p ((0 : ℝ), (1 : ℝ))) _
      exact (hg.continuousOn_fderiv_of_isOpen hΩ (by norm_num)).clm_apply continuousOn_const
    · intro x e hx he1 he2
      have hd : DifferentiableAt ℝ (↿g) (x, e) :=
        (hg.contDiffAt (hΩ.mem_nhds (show ((x, e) : ℝ × ℝ) ∈ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 from
          ⟨hx, he1, he2⟩))).differentiableAt (by norm_num)
      have hc : HasDerivAt (fun e' : ℝ => ((x, e') : ℝ × ℝ)) ((0 : ℝ), (1 : ℝ)) e :=
        (hasDerivAt_const e x).prodMk (hasDerivAt_id' e)
      exact hd.hasFDerivAt.comp_hasDerivAt e hc
  have hsubI : ∀ Y : ℝ, -ε < Y → uIcc 0 Y ⊆ Ioi (-ε) := by
    intro Y hY x hx
    exact lt_of_lt_of_le (lt_min (by linarith) hY) hx.1

  have ftc : ∀ k : ℝ → ℝ → ℝ, ContinuousOn (↿k) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) →
      ∀ Y e : ℝ, -ε < Y → -1 < e → e < 1 →
        HasDerivAt (fun Z => ∫ x in (0:ℝ)..Z, k x e) (k Y e) Y := by
    intro k hk Y e hY he1 he2
    have hcs : ContinuousOn (fun x => k x e) (Ioi (-ε)) :=
      hk.comp (f := fun x : ℝ => ((x, e) : ℝ × ℝ)) (by fun_prop) (fun x hx => ⟨hx, he1, he2⟩)
    exact intervalIntegral.integral_hasDerivAt_right ((hcs.mono (hsubI Y hY)).intervalIntegrable)
      (hcs.stronglyMeasurableAtFilter isOpen_Ioi Y hY) (hcs.continuousAt (Ioi_mem_nhds hY))

  have param : ∀ k kη : ℝ → ℝ → ℝ, ContinuousOn (↿k) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) →
      ContinuousOn (↿kη) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) →
      (∀ x e : ℝ, -ε < x → -1 < e → e < 1 → HasDerivAt (fun e' => k x e') (kη x e) e) →
      ∀ Y e : ℝ, -ε < Y → -1 < e → e < 1 →
        HasDerivAt (fun e' => ∫ x in (0:ℝ)..Y, k x e') (∫ x in (0:ℝ)..Y, kη x e) e := by
    intro k kη hk hkη hder Y e hY he1 he2
    obtain ⟨r, hr, hr1, hr2⟩ : ∃ r : ℝ, 0 < r ∧ r ≤ (1 - e) / 2 ∧ r ≤ (1 + e) / 2 :=
      ⟨min ((1 - e) / 2) ((1 + e) / 2), lt_min (by linarith) (by linarith),
        min_le_left _ _, min_le_right _ _⟩
    have hball : ∀ e' ∈ Metric.closedBall e r, -1 < e' ∧ e' < 1 := by
      intro e' he'
      rw [Metric.mem_closedBall, Real.dist_eq, abs_le] at he'
      constructor <;> linarith [he'.1, he'.2]
    have hsub := hsubI Y hY
    have hK : IsCompact (uIcc 0 Y ×ˢ Metric.closedBall e r) :=
      isCompact_uIcc.prod (isCompact_closedBall e r)
    have hKΩ : uIcc 0 Y ×ˢ Metric.closedBall e r ⊆ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 :=
      fun p hp => ⟨hsub hp.1, hball p.2 hp.2⟩
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn (hkη.mono hKΩ)
    have hslice : ∀ m : ℝ → ℝ → ℝ, ContinuousOn (↿m) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) →
        ∀ e' : ℝ, -1 < e' → e' < 1 → ContinuousOn (fun x => m x e') (uIcc 0 Y) :=
      fun m hm e' h1 h2 => hm.comp (f := fun x : ℝ => ((x, e') : ℝ × ℝ)) (by fun_prop)
        (fun x hx => ⟨hsub hx, h1, h2⟩)
    have hmeas : ∀ m : ℝ → ℝ → ℝ, ContinuousOn (↿m) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) →
        ∀ e' : ℝ, -1 < e' → e' < 1 →
          AEStronglyMeasurable (fun x => m x e') (volume.restrict (uIoc 0 Y)) :=
      fun m hm e' h1 h2 =>
        ((hslice m hm e' h1 h2).mono uIoc_subset_uIcc).aestronglyMeasurable measurableSet_uIoc
    have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (μ := volume) (a := 0) (b := Y) (bound := fun _ => C)
      (F := fun (e' : ℝ) (x : ℝ) => k x e') (F' := fun (e' : ℝ) (x : ℝ) => kη x e') (x₀ := e)
      (Metric.closedBall_mem_nhds e hr)
      (Filter.eventually_of_mem (Metric.closedBall_mem_nhds e hr)
        (fun e' he' => hmeas k hk e' (hball e' he').1 (hball e' he').2))
      ((hslice k hk e he1 he2).intervalIntegrable)
      (hmeas kη hkη e he1 he2)
      (Filter.Eventually.of_forall (fun t ht e' he' => hC (t, e') ⟨uIoc_subset_uIcc ht, he'⟩))
      intervalIntegrable_const
      (Filter.Eventually.of_forall (fun t ht e' he' =>
        hder t e' (hsub (uIoc_subset_uIcc ht)) (hball e' he').1 (hball e' he').2))
    exact key.2

  have pkg : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) →
      HasDerivAt (fun Y => profRadInt g Y η) (g X η) X ∧
      (∀ v : ℝ, HasDerivAt (fun e => g X e) v η →
        HasDerivAt (fun Y => profEtaD (profRadInt g) Y η) v X) ∧
      (∀ Y : ℝ, -ε < Y → DifferentiableAt ℝ (fun e => profRadInt g Y e) η) := by
    intro g hg
    obtain ⟨gη, hgηc, hgd⟩ := etap g hg
    have hgc : ContinuousOn (↿g) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := hg.continuousOn
    refine ⟨ftc g hgc X η hXε hη1 hη2, ?_, ?_⟩
    · intro v hv
      have hval : gη X η = v := (hgd X η hXε hη1 hη2).unique hv
      have heq : (fun Y => profEtaD (profRadInt g) Y η) =ᶠ[nhds X]
          (fun Y => ∫ x in (0:ℝ)..Y, gη x η) := by
        filter_upwards [Ioi_mem_nhds hXε] with Y hY
        exact (param g gη hgc hgηc hgd Y η hY hη1 hη2).deriv
      have h2 := ftc gη hgηc X η hXε hη1 hη2
      rw [hval] at h2
      exact h2.congr_of_eventuallyEq heq
    · intro Y hY
      exact (param g gη hgc hgηc hgd Y η hY hη1 hη2).differentiableAt

  have slice : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) →
      HasDerivAt (fun Y => g Y η) (deriv (fun Y => g Y η) X) X ∧
      HasDerivAt (fun e => g X e) (deriv (fun e => g X e) η) η := by
    intro g hg
    have hd : DifferentiableAt ℝ (↿g) (X, η) :=
      (hg.contDiffAt (hΩ.mem_nhds (show ((X, η) : ℝ × ℝ) ∈ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 from
        ⟨hXε, hη1, hη2⟩))).differentiableAt (by norm_num)
    have h1 : HasDerivAt (fun Y : ℝ => ((Y, η) : ℝ × ℝ)) ((1 : ℝ), (0 : ℝ)) X :=
      (hasDerivAt_id' X).prodMk (hasDerivAt_const X η)
    have h2 : HasDerivAt (fun e : ℝ => ((X, e) : ℝ × ℝ)) ((0 : ℝ), (1 : ℝ)) η :=
      (hasDerivAt_const η X).prodMk (hasDerivAt_id' η)
    have k1' := hd.hasFDerivAt.comp_hasDerivAt X h1
    have k2' := hd.hasFDerivAt.comp_hasDerivAt η h2
    have k1 : DifferentiableAt ℝ (fun Y => g Y η) X := k1'.differentiableAt
    have k2 : DifferentiableAt ℝ (fun e => g X e) η := k2'.differentiableAt
    exact ⟨k1.hasDerivAt, k2.hasDerivAt⟩
  have hF0 : ∀ Y, 0 < Y → F Y η ≠ 0 := fun Y hY => (hFpos Y η hY.le hη1 hη2).ne'
  have hI : ContDiffOn ℝ ∞ (↿(fun x e => 2 * x * F x e)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 2 * p.1 * F p.1 p.2) _
    exact (contDiffOn_const.mul contDiffOn_fst).mul hF
  have hJ : ContDiffOn ℝ ∞ (↿(fun x e => U x e * (2 * x * F x e)))
      (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => U p.1 p.2 * (2 * p.1 * F p.1 p.2)) _
    exact hU.mul ((contDiffOn_const.mul contDiffOn_fst).mul hF)
  have hS : ContDiffOn ℝ ∞ (↿(fun x e => U x e ^ 2 - x * F x e ^ 2))
      (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => U p.1 p.2 ^ 2 - p.1 * F p.1 p.2 ^ 2) _
    exact (hU.pow 2).sub (contDiffOn_fst.mul (hF.pow 2))
  have hP : ContDiffOn ℝ ∞ (↿(fun x e => F x e ^ 2)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => F p.1 p.2 ^ 2) _
    exact hF.pow 2
  obtain ⟨hFY, hFe⟩ := slice F hF
  obtain ⟨hUY, hUe⟩ := slice U hU
  have sq : ∀ (f : ℝ → ℝ) (f' x : ℝ), HasDerivAt f f' x →
      HasDerivAt (fun y => f y ^ 2) (2 * f x * f') x := by
    intro f f' x hf
    have e1 : (fun y => f y ^ 2) = fun y => f y * f y := funext fun y => pow_two _
    rw [e1]
    exact (hf.mul hf).congr_deriv (by ring)
  obtain ⟨hUa, hUb, -⟩ := pkg U hU
  obtain ⟨hIa, hIb, -⟩ := pkg _ hI
  obtain ⟨hJa, hJb, -⟩ := pkg _ hJ
  obtain ⟨hSa, hSb, -⟩ := pkg _ hS
  obtain ⟨hPa, hPb, hPc⟩ := pkg _ hP
  have hUb' := hUb _ hUe
  have hIb' := hIb _ (hFe.const_mul (2 * X))
  have hJb' := hJb _ (hUe.mul (hFe.const_mul (2 * X)))
  have hSb' := hSb _ ((sq _ _ _ hUe).sub ((sq _ _ _ hFe).const_mul X))
  have hPb' := hPb _ (sq _ _ _ hFe)
  have hPaxd : DifferentiableAt ℝ Pax η :=
    (hPax.contDiffAt (Ioo_mem_nhds hη1 hη2)).differentiableAt (by norm_num)

  have hW : ∀ Y, 0 < Y → Y * leadW h U Y η =
      Y - 2 * (1 / 2 - h) * η * profRadInt U Y η - (1 - η ^ 2) * profEtaD (profRadInt U) Y η := by
    intro Y hY
    have key : ∀ e, -1 < e → e < 1 → Y * profRadAvg U Y e = profRadInt U Y e := by
      intro e _ _
      unfold profRadAvg profRadInt
      rw [intervalIntegral.integral_comp_mul_right (fun x => U x e) hY.ne', zero_mul, one_mul,
        smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hY.ne', one_mul]
    have hev : (fun e => Y * profRadAvg U Y e) =ᶠ[nhds η] (fun e => profRadInt U Y e) := by
      filter_upwards [Ioo_mem_nhds hη1 hη2] with e he
      exact key e he.1 he.2
    have hd : Y * profEtaD (profRadAvg U) Y η = profEtaD (profRadInt U) Y η := by
      unfold profEtaD
      rw [← hev.deriv_eq, deriv_const_mul_field']
    have hk := key η hη1 hη2
    unfold leadW
    linear_combination (-(2 * (1 / 2 - h) * η)) * hk + (-(1 - η ^ 2)) * hd
  have hPiη : ∀ Y, -ε < Y → profEtaD (axPi Pax F) Y η =
      deriv Pax η + profEtaD (profRadInt (fun x e => F x e ^ 2)) Y η := by
    intro Y hY
    exact (hPaxd.hasDerivAt.add (hPc Y hY).hasDerivAt).deriv
  have hQrw : ∀ Y, 0 < Y → Y * (2 * Y * F Y η) * leadQs h F U Y η =
      -(2 * Y * F Y η) * (Y * leadW h U Y η) +
      ((1 - h) * profRadInt (fun x e => 2 * x * F x e) Y η
        - (1 / 2 - h) * η * profEtaD (profRadInt (fun x e => 2 * x * F x e)) Y η
        - (1 - η ^ 2) * profEtaD (profRadInt (fun x e => U x e * (2 * x * F x e))) Y η
        + 2 * (h - (1 / 2 - h)) * η * profRadInt (fun x e => U x e * (2 * x * F x e)) Y η) := by
    intro Y hY
    have hY0 := hY.ne'
    have hFY0 := hF0 Y hY
    unfold leadQs
    field_simp
  have hNrw : ∀ Y, 0 < Y → Y * axNs h Pax F U Y η =
      -(Y * leadW h U Y η) * U Y η +
      ((1 / 2 - h) * (profRadInt U Y η - η * profEtaD (profRadInt U) Y η)
        + 4 * h * η * profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2) Y η
        - (1 - η ^ 2) * profEtaD (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2)) Y η)
      + Y * (4 * (1 / 2 + h) * η * axPi Pax F Y η - (1 - η ^ 2) * profEtaD (axPi Pax F) Y η) := by
    intro Y hY
    have hY0 := hY.ne'
    unfold axNs
    field_simp
    ring

  have hV := ((hasDerivAt_id' X).sub (hUa.const_mul (2 * (1 / 2 - h) * η))).sub
    (hUb'.const_mul (1 - η ^ 2))
  have hfQ := ((((hasDerivAt_id' X).const_mul 2).mul hFY).neg.mul hV).add
    ((((hIa.const_mul (1 - h)).sub (hIb'.const_mul ((1 / 2 - h) * η))).sub
      (hJb'.const_mul (1 - η ^ 2))).add (hJa.const_mul (2 * (h - (1 / 2 - h)) * η)))
  have hfN := (((hV.neg).mul hUY).add ((((hUa.sub (hUb'.const_mul η)).const_mul (1 / 2 - h)).add
      (hSa.const_mul (4 * h * η))).sub (hSb'.const_mul (1 - η ^ 2)))).add
    ((hasDerivAt_id' X).mul ((((hasDerivAt_const X (Pax η)).add hPa).const_mul
      (4 * (1 / 2 + h) * η)).sub (((hasDerivAt_const X (deriv Pax η)).add hPb').const_mul
        (1 - η ^ 2))))
  have hWX := hW X hX
  have hF0X := hF0 X hX
  have hX0 := hX.ne'
  have hSq : 2 * X * F X η * axSq h F U X η =
      -(2 * X * leadW h U X η * (F X η + X * deriv (fun Y => F Y η) X))
        - 2 * X * F X η * h * (1 - 2 * η * U X η)
        - 2 * X * ((1 / 2 - h) * η + (1 - η ^ 2) * U X η) * deriv (fun e => F X e) η := by
    unfold axSq
    field_simp
  refine ⟨?_, ?_⟩
  · refine (hfQ.congr_of_eventuallyEq ?_).congr_deriv ?_
    · filter_upwards [Ioi_mem_nhds hX] with Y hY
      have hY' : 0 < Y := hY
      simp only [Pi.add_apply, Pi.sub_apply, Pi.mul_apply, Pi.neg_apply]
      linear_combination (hQrw Y hY') + (-(2 * Y * F Y η)) * (hW Y hY')
    · rw [hSq]
      simp only [Pi.add_apply, Pi.sub_apply, Pi.mul_apply, Pi.neg_apply]
      linear_combination (2 * F X η + 2 * X * deriv (fun Y => F Y η) X) * hWX
  · refine (hfN.congr_of_eventuallyEq ?_).congr_deriv ?_
    · filter_upwards [Ioi_mem_nhds hX] with Y hY
      have hY' : 0 < Y := hY
      rw [hNrw Y hY', hPiη Y (by linarith)]
      simp only [axPi, Pi.add_apply, Pi.sub_apply, Pi.mul_apply, Pi.neg_apply]
      linear_combination (-(U Y η)) * (hW Y hY')
    · unfold axSn
      rw [show deriv (fun e => axPi Pax F X e) η =
        deriv Pax η + profEtaD (profRadInt (fun x e => F x e ^ 2)) X η from hPiη X hXε]
      simp only [axPi, Pi.add_apply, Pi.sub_apply, Pi.mul_apply, Pi.neg_apply]
      linear_combination (deriv (fun Y => U Y η) X) * hWX

theorem weighted_bump : ∀ (a b : ℝ) (f : ℝ → ℝ), 0 < a → a < b → ContDiffOn ℝ ∞ f (Ioi 0) → ContDiff ℝ ∞ (fun x => Real.smoothTransition (x - a) * Real.smoothTransition (b - x)) ∧ ContDiff ℝ ∞ (fun x => f x * (Real.smoothTransition (x - a) * Real.smoothTransition (b - x))) ∧ (∀ x, (x ≤ a ∨ b ≤ x) → Real.smoothTransition (x - a) * Real.smoothTransition (b - x) = 0) ∧ (∀ x, 0 ≤ Real.smoothTransition (x - a) * Real.smoothTransition (b - x) ∧ Real.smoothTransition (x - a) * Real.smoothTransition (b - x) ≤ 1) ∧ (∀ x, a < x → x < b → 0 < Real.smoothTransition (x - a) * Real.smoothTransition (b - x)) :=
by
  intro a b f ha hab hf
  have hS : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff
  have hψ : ContDiff ℝ ∞ (fun x => Real.smoothTransition (x - a) * Real.smoothTransition (b - x)) :=
    (hS.comp (contDiff_id.sub contDiff_const)).mul (hS.comp (contDiff_const.sub contDiff_id))
  refine ⟨hψ, ?_, ?_, ?_, ?_⟩
  · rw [contDiff_iff_contDiffAt]
    intro x
    rcases lt_or_ge 0 x with hx | hx
    · exact (hf.contDiffAt (Ioi_mem_nhds hx)).mul hψ.contDiffAt
    · have hxa : x < a := lt_of_le_of_lt hx ha
      have hev : (fun y => f y * (Real.smoothTransition (y - a) * Real.smoothTransition (b - y)))
          =ᶠ[nhds x] fun _ => (0 : ℝ) := by
        filter_upwards [Iio_mem_nhds hxa] with y hy
        have hy' : y - a ≤ 0 := by
          have : y < a := hy
          linarith
        rw [Real.smoothTransition.zero_of_nonpos hy']
        ring
      exact contDiffAt_const.congr_of_eventuallyEq hev
  · intro x hx
    rcases hx with hx | hx
    · rw [Real.smoothTransition.zero_of_nonpos (by linarith : x - a ≤ 0)]
      ring
    · rw [Real.smoothTransition.zero_of_nonpos (by linarith : b - x ≤ 0)]
      ring
  · intro x
    refine ⟨mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _), ?_⟩
    calc Real.smoothTransition (x - a) * Real.smoothTransition (b - x) ≤ 1 * 1 :=
          mul_le_mul (Real.smoothTransition.le_one _) (Real.smoothTransition.le_one _)
            (Real.smoothTransition.nonneg _) zero_le_one
      _ = 1 := one_mul 1
  · intro x h1 h2
    exact mul_pos (Real.smoothTransition.pos_of_pos (by linarith))
      (Real.smoothTransition.pos_of_pos (by linarith))

theorem gram_form_pos : ∀ (n : ℕ) (f : Fin n → ℝ → ℝ) (w : ℝ → ℝ) (lo hi a b : ℝ), lo ≤ a → a < b → b ≤ hi → (∀ i, ContinuousOn (f i) (Icc lo hi)) → ContinuousOn w (Icc lo hi) → (∀ x ∈ Icc lo hi, 0 ≤ w x) → (∀ x ∈ Ioo a b, 0 < w x) → (∀ v : Fin n → ℝ, (∀ x ∈ Ioo a b, ∑ j, v j * f j x = 0) → v = 0) → ∀ v : Fin n → ℝ, v ≠ 0 → 0 < ∑ i, ∑ j, v i * v j * ∫ x in lo..hi, f i x * (f j x * w x) :=
by
  intro n f w lo hi a b hla hab hbh hf hw hw0 hwpos hind v hv
  have hlohi : lo < hi := lt_of_le_of_lt hla (lt_of_lt_of_le hab hbh)
  have hF : ∀ i j, ContinuousOn (fun x => f i x * (f j x * w x)) (Icc lo hi) :=
    fun i j => (hf i).mul ((hf j).mul hw)
  have hII : ∀ i j, IntervalIntegrable (fun x => v i * v j * (f i x * (f j x * w x)))
      MeasureTheory.volume lo hi :=
    fun i j => (continuousOn_const.mul (hF i j)).intervalIntegrable_of_Icc hlohi.le
  have hII2 : ∀ i, IntervalIntegrable (fun x => ∑ j, v i * v j * (f i x * (f j x * w x)))
      MeasureTheory.volume lo hi :=
    fun i => (continuousOn_finset_sum _
      (fun j _ => continuousOn_const.mul (hF i j))).intervalIntegrable_of_Icc hlohi.le
  have hlin : ∑ i, ∑ j, v i * v j * ∫ x in lo..hi, f i x * (f j x * w x)
      = ∫ x in lo..hi, ∑ i, ∑ j, v i * v j * (f i x * (f j x * w x)) := by
    rw [intervalIntegral.integral_finsetSum (fun i _ => hII2 i)]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [intervalIntegral.integral_finsetSum (fun j _ => hII i j)]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [intervalIntegral.integral_const_mul]
  have hpt : (fun x => ∑ i, ∑ j, v i * v j * (f i x * (f j x * w x)))
      = fun x => (∑ j, v j * f j x) ^ 2 * w x := by
    funext x
    rw [sq, Finset.sum_mul_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    ring
  rw [hlin, hpt]
  obtain ⟨x0, hx0, hgx0⟩ : ∃ x0 ∈ Ioo a b, ∑ j, v j * f j x0 ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    exact hv (hind v hcon)
  have hg : ContinuousOn (fun x => ∑ j, v j * f j x) (Icc lo hi) :=
    continuousOn_finset_sum _ (fun j _ => continuousOn_const.mul (hf j))
  apply intervalIntegral.integral_pos hlohi ((hg.pow 2).mul hw)
  · intro x hx
    exact mul_nonneg (sq_nonneg _) (hw0 x (Ioc_subset_Icc_self hx))
  · refine ⟨x0, ⟨by linarith [hx0.1], by linarith [hx0.2]⟩, mul_pos ?_ (hwpos x0 hx0)⟩
    exact lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 hgx0))

theorem repair_weights_independent : ∀ (a b : ℝ), 0 < a → a < b → (∀ v0 v1 : ℝ, (∀ x ∈ Ioo a b, v0 * 1 + v1 * (Real.sqrt (2 * x) * x ^ (1 / 10 : ℝ)) = 0) → v0 = 0 ∧ v1 = 0) ∧ (∀ v0 v1 v2 : ℝ, (∀ x ∈ Ioo a b, v0 * Real.sqrt (2 * x) + v1 * x ^ (1 / 10 : ℝ) + v2 * (x ^ (1 / 10 : ℝ) / x) = 0) → v0 = 0 ∧ v1 = 0 ∧ v2 = 0) :=
by
  intro a b ha hab
  have hpoly : ∀ (c d : ℝ), c < d → ∀ p : Polynomial ℝ, (∀ t ∈ Ioo c d, p.eval t = 0) → p = 0 := by
    intro c d hcd p hp
    apply Polynomial.eq_zero_of_infinite_isRoot
    exact (Set.Ioo_infinite hcd).mono (fun t ht => hp t ht)
  have h10 : (1 / 10 : ℝ) = ((10 : ℕ) : ℝ)⁻¹ := by norm_num
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = a ^ (1 / 10 : ℝ) := ⟨_, rfl⟩
  obtain ⟨d, hd⟩ : ∃ d : ℝ, d = b ^ (1 / 10 : ℝ) := ⟨_, rfl⟩
  have hc0 : 0 < c := by rw [hc]; exact Real.rpow_pos_of_pos ha _
  have hcd : c < d := by rw [hc, hd]; exact Real.rpow_lt_rpow ha.le hab (by norm_num)
  have hca : c ^ 10 = a := by
    rw [hc, h10]; exact Real.rpow_inv_natCast_pow ha.le (by norm_num)
  have hdb : d ^ 10 = b := by
    rw [hd, h10]; exact Real.rpow_inv_natCast_pow (ha.trans hab).le (by norm_num)
  have hmem : ∀ t ∈ Ioo c d, 0 < t ∧ t ^ 10 ∈ Ioo a b ∧ (t ^ 10) ^ (1 / 10 : ℝ) = t ∧
      Real.sqrt (2 * t ^ 10) = Real.sqrt 2 * t ^ 5 := by
    intro t ht
    have ht0 : 0 < t := hc0.trans ht.1
    refine ⟨ht0, ⟨?_, ?_⟩, ?_, ?_⟩
    · rw [← hca]; exact pow_lt_pow_left₀ ht.1 hc0.le (by norm_num)
    · rw [← hdb]; exact pow_lt_pow_left₀ ht.2 ht0.le (by norm_num)
    · rw [h10]; exact Real.pow_rpow_inv_natCast ht0.le (by norm_num)
    · rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2), show t ^ 10 = (t ^ 5) ^ 2 by ring,
        Real.sqrt_sq (by positivity)]
  have hs2 : Real.sqrt 2 ≠ 0 := by positivity
  refine ⟨?_, ?_⟩
  · intro v0 v1 h
    have hp := hpoly c d hcd
      (Polynomial.C (v1 * Real.sqrt 2) * Polynomial.X ^ 6 + Polynomial.C v0) (by
      intro t ht
      obtain ⟨_, hx, hr, hs⟩ := hmem t ht
      have := h (t ^ 10) hx
      rw [hr, hs] at this
      simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow,
        Polynomial.eval_X]
      linear_combination this)
    have e0 := congrArg (fun p => Polynomial.coeff p 0) hp
    have e6 := congrArg (fun p => Polynomial.coeff p 6) hp
    simp only [Polynomial.coeff_add, Polynomial.coeff_C_mul_X_pow, Polynomial.coeff_C,
      Polynomial.coeff_zero] at e0 e6
    norm_num at e0 e6
    exact ⟨e0, e6⟩
  · intro v0 v1 v2 h
    have hp := hpoly c d hcd
      (Polynomial.C (v0 * Real.sqrt 2) * Polynomial.X ^ 14 + Polynomial.C v1 * Polynomial.X ^ 10 +
        Polynomial.C v2) (by
      intro t ht
      obtain ⟨ht0, hx, hr, hs⟩ := hmem t ht
      have := h (t ^ 10) hx
      rw [hr, hs] at this
      have key : t ^ 9 * (t / t ^ 10) = 1 := by
        field_simp
      simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow,
        Polynomial.eval_X]
      linear_combination t ^ 9 * this - v2 * key)
    have e0 := congrArg (fun p => Polynomial.coeff p 0) hp
    have e10 := congrArg (fun p => Polynomial.coeff p 10) hp
    have e14 := congrArg (fun p => Polynomial.coeff p 14) hp
    simp only [Polynomial.coeff_add, Polynomial.coeff_C_mul_X_pow, Polynomial.coeff_C,
      Polynomial.coeff_zero] at e0 e10 e14
    norm_num at e0 e10 e14
    exact ⟨e14, e10, e0⟩

theorem repair_moment_expand : ∀ (x1 x2 k η : ℝ) (β : Fin 2 → ℝ → ℝ) (γ : Fin 3 → ℝ → ℝ) (c : Fin 5 → ℝ), 0 < x1 → x1 < x2 → (∀ i, Continuous (β i)) → (∀ j, Continuous (γ j)) → (∀ i j x, β i x * γ j x = 0) → let E0 : ℝ → ℝ := fun x => k * x ^ (1 / 10 : ℝ); let Uc : ℝ → ℝ := fun x => 4 * η + (c 0 * β 0 x + c 1 * β 1 x); let Ec : ℝ → ℝ := fun x => E0 x + (c 2 * γ 0 x + c 3 * γ 1 x + c 4 * γ 2 x); let cU : Fin 2 → ℝ := ![c 0, c 1]; let cE : Fin 3 → ℝ := ![c 2, c 3, c 4]; (∫ x in x1..x2, (Uc x - 4 * η)) = ∑ i, cU i * (∫ x in x1..x2, β i x) ∧ (∫ x in x1..x2, Real.sqrt (2 * x) * (Ec x - E0 x)) = ∑ j, cE j * (∫ x in x1..x2, Real.sqrt (2 * x) * γ j x) ∧ (∫ x in x1..x2, (Uc x * (Real.sqrt (2 * x) * Ec x) - 4 * η * (Real.sqrt (2 * x) * E0 x))) = 4 * η * (∑ j, cE j * (∫ x in x1..x2, Real.sqrt (2 * x) * γ j x)) + k * ∑ i, cU i * (∫ x in x1..x2, Real.sqrt (2 * x) * x ^ (1 / 10 : ℝ) * β i x) ∧ (∫ x in x1..x2, ((Uc x ^ 2 - Ec x ^ 2 / 2) - ((4 * η) ^ 2 - E0 x ^ 2 / 2))) = 8 * η * (∑ i, cU i * (∫ x in x1..x2, β i x)) + ∑ i, ∑ i', cU i * cU i' * (∫ x in x1..x2, β i x * β i' x) - k * ∑ j, cE j * (∫ x in x1..x2, x ^ (1 / 10 : ℝ) * γ j x) - 1 / 2 * ∑ j, ∑ l, cE j * cE l * (∫ x in x1..x2, γ j x * γ l x) ∧ (∫ x in x1..x2, (Ec x ^ 2 - E0 x ^ 2) / (2 * x)) = k * ∑ j, cE j * (∫ x in x1..x2, x ^ (1 / 10 : ℝ) / x * γ j x) + 1 / 2 * ∑ j, ∑ l, cE j * cE l * (∫ x in x1..x2, γ j x * γ l x / x) :=
by
  intro x1 x2 k η β γ c hx1 hx12 hβ hγ hdisj
  intro E0 Uc Ec cU cE
  have hpos : ∀ x ∈ Set.uIcc x1 x2, 0 < x := fun x hx => by
    rw [Set.uIcc_of_le hx12.le] at hx
    exact lt_of_lt_of_le hx1 hx.1
  have cs : Continuous (fun x : ℝ => Real.sqrt (2 * x)) := (continuous_const.mul continuous_id).sqrt
  have cp : Continuous (fun x : ℝ => x ^ (1 / 10 : ℝ)) := Real.continuous_rpow_const (by norm_num)
  have hIc : ∀ g : ℝ → ℝ, Continuous g → IntervalIntegrable g MeasureTheory.volume x1 x2 :=
    fun g hg => hg.intervalIntegrable _ _
  have hIo : ∀ g : ℝ → ℝ, ContinuousOn g (Set.uIcc x1 x2) →
      IntervalIntegrable g MeasureTheory.volume x1 x2 :=
    fun g hg => hg.intervalIntegrable
  have H1 : ∀ (n : ℕ) (a : Fin n → ℝ) (f : Fin n → ℝ → ℝ),
      (∀ i, ContinuousOn (f i) (Set.uIcc x1 x2)) →
      ∫ x in x1..x2, ∑ i, a i * f i x = ∑ i, a i * ∫ x in x1..x2, f i x := by
    intro n a f hf
    rw [intervalIntegral.integral_finset_sum
      (fun i _ => ((hf i).intervalIntegrable).const_mul (a i))]
    simp only [intervalIntegral.integral_const_mul]
  have H2 : ∀ (n : ℕ) (a : Fin n → ℝ) (f : Fin n → Fin n → ℝ → ℝ),
      (∀ i j, ContinuousOn (f i j) (Set.uIcc x1 x2)) →
      ∫ x in x1..x2, ∑ i, ∑ j, a i * a j * f i j x =
        ∑ i, ∑ j, a i * a j * ∫ x in x1..x2, f i j x := by
    intro n a f hf
    have hi : ∀ i ∈ (Finset.univ : Finset (Fin n)), IntervalIntegrable
        (fun x => ∑ j, a i * a j * f i j x) MeasureTheory.volume x1 x2 := by
      intro i _
      exact hIo _ (continuousOn_finset_sum _ (fun j _ => continuousOn_const.mul (hf i j)))
    rw [intervalIntegral.integral_finset_sum hi]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [intervalIntegral.integral_finset_sum
      (fun j _ => ((hf i j).intervalIntegrable).const_mul (a i * a j))]
    simp only [intervalIntegral.integral_const_mul]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  ·
    rw [← H1 2 cU β (fun i => (hβ i).continuousOn)]
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    simp only [Uc, cU, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons]
    ring
  ·
    have h : ∫ x in x1..x2, ∑ j, cE j * (Real.sqrt (2 * x) * γ j x) =
        ∑ j, cE j * ∫ x in x1..x2, Real.sqrt (2 * x) * γ j x :=
      H1 3 cE (fun j x => Real.sqrt (2 * x) * γ j x) (fun j => (cs.mul (hγ j)).continuousOn)
    rw [← h]
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    simp only [Ec, E0, cE, Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    ring
  ·
    have h2 : ∫ x in x1..x2, ∑ j, cE j * (Real.sqrt (2 * x) * γ j x) =
        ∑ j, cE j * ∫ x in x1..x2, Real.sqrt (2 * x) * γ j x :=
      H1 3 cE (fun j x => Real.sqrt (2 * x) * γ j x) (fun j => (cs.mul (hγ j)).continuousOn)
    have h3 : ∫ x in x1..x2, ∑ i, cU i * (Real.sqrt (2 * x) * x ^ (1 / 10 : ℝ) * β i x) =
        ∑ i, cU i * ∫ x in x1..x2, Real.sqrt (2 * x) * x ^ (1 / 10 : ℝ) * β i x :=
      H1 2 cU (fun i x => Real.sqrt (2 * x) * x ^ (1 / 10 : ℝ) * β i x)
        (fun i => ((cs.mul cp).mul (hβ i)).continuousOn)
    have c2 : Continuous (fun x => 4 * η * ∑ j, cE j * (Real.sqrt (2 * x) * γ j x)) :=
      continuous_const.mul (continuous_finset_sum _ (fun j _ => continuous_const.mul (cs.mul (hγ j))))
    have c3 : Continuous
        (fun x => k * ∑ i, cU i * (Real.sqrt (2 * x) * x ^ (1 / 10 : ℝ) * β i x)) :=
      continuous_const.mul (continuous_finset_sum _
        (fun i _ => continuous_const.mul ((cs.mul cp).mul (hβ i))))
    rw [← h2, ← h3, ← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_const_mul,
      ← intervalIntegral.integral_add (hIc _ c2) (hIc _ c3)]
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    simp only [Uc, Ec, E0, cU, cE, Fin.sum_univ_two, Fin.sum_univ_three, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    linear_combination Real.sqrt (2 * x) * (c 0 * c 2 * hdisj 0 0 x + c 0 * c 3 * hdisj 0 1 x +
      c 0 * c 4 * hdisj 0 2 x + c 1 * c 2 * hdisj 1 0 x + c 1 * c 3 * hdisj 1 1 x +
      c 1 * c 4 * hdisj 1 2 x)
  ·
    have hA : ∫ x in x1..x2, ∑ i, cU i * β i x = ∑ i, cU i * ∫ x in x1..x2, β i x :=
      H1 2 cU β (fun i => (hβ i).continuousOn)
    have hB : ∫ x in x1..x2, ∑ i, ∑ i', cU i * cU i' * (β i x * β i' x) =
        ∑ i, ∑ i', cU i * cU i' * ∫ x in x1..x2, β i x * β i' x :=
      H2 2 cU (fun i i' x => β i x * β i' x) (fun i i' => ((hβ i).mul (hβ i')).continuousOn)
    have hC : ∫ x in x1..x2, ∑ j, cE j * (x ^ (1 / 10 : ℝ) * γ j x) =
        ∑ j, cE j * ∫ x in x1..x2, x ^ (1 / 10 : ℝ) * γ j x :=
      H1 3 cE (fun j x => x ^ (1 / 10 : ℝ) * γ j x) (fun j => (cp.mul (hγ j)).continuousOn)
    have hD : ∫ x in x1..x2, ∑ j, ∑ l, cE j * cE l * (γ j x * γ l x) =
        ∑ j, ∑ l, cE j * cE l * ∫ x in x1..x2, γ j x * γ l x :=
      H2 3 cE (fun j l x => γ j x * γ l x) (fun j l => ((hγ j).mul (hγ l)).continuousOn)
    have cA : Continuous (fun x => 8 * η * ∑ i, cU i * β i x) :=
      continuous_const.mul (continuous_finset_sum _ (fun i _ => continuous_const.mul (hβ i)))
    have cB : Continuous (fun x => ∑ i, ∑ i', cU i * cU i' * (β i x * β i' x)) :=
      continuous_finset_sum _ (fun i _ => continuous_finset_sum _
        (fun i' _ => continuous_const.mul ((hβ i).mul (hβ i'))))
    have cC : Continuous (fun x => k * ∑ j, cE j * (x ^ (1 / 10 : ℝ) * γ j x)) :=
      continuous_const.mul (continuous_finset_sum _ (fun j _ => continuous_const.mul (cp.mul (hγ j))))
    have cD : Continuous (fun x => 1 / 2 * ∑ j, ∑ l, cE j * cE l * (γ j x * γ l x)) :=
      continuous_const.mul (continuous_finset_sum _ (fun j _ => continuous_finset_sum _
        (fun l _ => continuous_const.mul ((hγ j).mul (hγ l)))))
    rw [← hA, ← hB, ← hC, ← hD, ← intervalIntegral.integral_const_mul,
      ← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_const_mul,
      ← intervalIntegral.integral_add (hIc _ cA) (hIc _ cB),
      ← intervalIntegral.integral_sub ((hIc _ cA).add (hIc _ cB)) (hIc _ cC),
      ← intervalIntegral.integral_sub (((hIc _ cA).add (hIc _ cB)).sub (hIc _ cC)) (hIc _ cD)]
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    simp only [Uc, Ec, E0, cU, cE, Fin.sum_univ_two, Fin.sum_univ_three, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    ring
  ·
    have hpx : ∀ j, ContinuousOn (fun x : ℝ => x ^ (1 / 10 : ℝ) / x * γ j x) (Set.uIcc x1 x2) :=
      fun j => (cp.continuousOn.div₀ continuous_id'.continuousOn
        (fun x hx => (hpos x hx).ne')).mul (hγ j).continuousOn
    have hgg : ∀ j l, ContinuousOn (fun x : ℝ => γ j x * γ l x / x) (Set.uIcc x1 x2) :=
      fun j l => ((hγ j).mul (hγ l)).continuousOn.div₀ continuous_id'.continuousOn
        (fun x hx => (hpos x hx).ne')
    have hP : ∫ x in x1..x2, ∑ j, cE j * (x ^ (1 / 10 : ℝ) / x * γ j x) =
        ∑ j, cE j * ∫ x in x1..x2, x ^ (1 / 10 : ℝ) / x * γ j x :=
      H1 3 cE (fun j x => x ^ (1 / 10 : ℝ) / x * γ j x) hpx
    have hQ : ∫ x in x1..x2, ∑ j, ∑ l, cE j * cE l * (γ j x * γ l x / x) =
        ∑ j, ∑ l, cE j * cE l * ∫ x in x1..x2, γ j x * γ l x / x :=
      H2 3 cE (fun j l x => γ j x * γ l x / x) hgg
    have iP : IntervalIntegrable (fun x => k * ∑ j, cE j * (x ^ (1 / 10 : ℝ) / x * γ j x))
        MeasureTheory.volume x1 x2 :=
      hIo _ (continuousOn_const.mul (continuousOn_finset_sum _
        (fun j _ => continuousOn_const.mul (hpx j))))
    have iQ : IntervalIntegrable (fun x => 1 / 2 * ∑ j, ∑ l, cE j * cE l * (γ j x * γ l x / x))
        MeasureTheory.volume x1 x2 :=
      hIo _ (continuousOn_const.mul (continuousOn_finset_sum _ (fun j _ =>
        continuousOn_finset_sum _ (fun l _ => continuousOn_const.mul (hgg j l)))))
    rw [← hP, ← hQ, ← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_const_mul,
      ← intervalIntegral.integral_add iP iQ]
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    simp only [Ec, E0, cE, Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    ring

theorem quad_map_local_inverse : ∀ (n : ℕ) (a : Fin n → Fin n → ℝ) (b : Fin n → Fin n → Fin n → ℝ), (∀ v : Fin n → ℝ, (∀ i, ∑ j, a i j * v j = 0) → v = 0) → ∃ (r L : ℝ) (g : (Fin n → ℝ) → (Fin n → ℝ)), 0 < r ∧ 0 ≤ L ∧ g 0 = 0 ∧ ContDiffOn ℝ ∞ g (Metric.ball 0 r) ∧ ∀ z ∈ Metric.ball (0 : Fin n → ℝ) r, (∀ i, ∑ j, a i j * g z j + ∑ j, ∑ l, b i j l * g z j * g z l = z i) ∧ ‖g z‖ ≤ L * ‖z‖ :=
by
  intro n a b hinj
  set F : (Fin n → ℝ) → (Fin n → ℝ) :=
    fun v i => ∑ j, a i j * v j + ∑ j, ∑ l, b i j l * v j * v l with hFdef
  have hn : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hF : ContDiff ℝ ∞ F := by
    rw [hFdef]
    refine contDiff_pi.2 (fun i => ?_)
    exact ContDiff.add (ContDiff.sum fun j _ => contDiff_const.mul (contDiff_apply ℝ ℝ j))
      (ContDiff.sum fun j _ => ContDiff.sum fun l _ =>
        (contDiff_const.mul (contDiff_apply ℝ ℝ j)).mul (contDiff_apply ℝ ℝ l))
  have hF0 : F 0 = 0 := by
    funext i; simp [hFdef]

  let A' : (Fin n → ℝ) →L[ℝ] (Fin n → ℝ) :=
    ContinuousLinearMap.pi (fun i => ∑ j, a i j • ContinuousLinearMap.proj j)
  have hA' : ∀ w i, A' w i = ∑ j, a i j * w j := by
    intro w i; simp [A']
  have hD : HasFDerivAt F A' 0 := by
    rw [hasFDerivAt_pi']
    intro i
    have h1 : HasFDerivAt (fun v : Fin n → ℝ => ∑ j, a i j * v j)
        (∑ j, a i j • ContinuousLinearMap.proj j : (Fin n → ℝ) →L[ℝ] ℝ) 0 := by
      apply HasFDerivAt.fun_sum
      intro j _
      exact (hasFDerivAt_apply j 0).const_mul (a i j)
    have h2 : HasFDerivAt (fun v : Fin n → ℝ => ∑ j, ∑ l, b i j l * v j * v l)
        (∑ j, ∑ l, ((b i j l * (0 : Fin n → ℝ) j) • ContinuousLinearMap.proj l +
          (0 : Fin n → ℝ) l • (b i j l • ContinuousLinearMap.proj j)) :
          (Fin n → ℝ) →L[ℝ] ℝ) 0 := by
      apply HasFDerivAt.fun_sum
      intro j _
      apply HasFDerivAt.fun_sum
      intro l _
      exact ((hasFDerivAt_apply j 0).const_mul (b i j l)).mul (hasFDerivAt_apply l 0)
    refine (h1.add h2).congr_fderiv ?_
    refine ContinuousLinearMap.ext (fun w => ?_)
    simp [A']

  have hinj' : Function.Injective (A' : (Fin n → ℝ) →ₗ[ℝ] (Fin n → ℝ)) := by
    intro v w hvw
    have hsub : v - w = 0 := hinj (v - w) (fun i => by
      have h := congrFun hvw i
      simp only [ContinuousLinearMap.coe_coe, hA'] at h
      simp only [Pi.sub_apply, mul_sub, Finset.sum_sub_distrib, h, sub_self])
    exact sub_eq_zero.1 hsub
  let E0 : (Fin n → ℝ) ≃L[ℝ] (Fin n → ℝ) :=
    (LinearEquiv.ofInjectiveEndo _ hinj').toContinuousLinearEquiv
  have hE0 : (E0 : (Fin n → ℝ) →L[ℝ] (Fin n → ℝ)) = A' := by
    ext1 w; rfl
  have hD' : HasFDerivAt F (E0 : (Fin n → ℝ) →L[ℝ] (Fin n → ℝ)) 0 := by
    rw [hE0]; exact hD

  have hFa : ContDiffAt ℝ ∞ F 0 := hF.contDiffAt
  set e := ContDiffAt.toOpenPartialHomeomorph F hFa hD' hn with he
  have heF : (e : (Fin n → ℝ) → (Fin n → ℝ)) = F :=
    ContDiffAt.toOpenPartialHomeomorph_coe hFa hD' hn
  have h0s : (0 : Fin n → ℝ) ∈ e.source := ContDiffAt.mem_toOpenPartialHomeomorph_source hFa hD' hn
  have h0t : (0 : Fin n → ℝ) ∈ e.target := by
    have h := ContDiffAt.image_mem_toOpenPartialHomeomorph_target hFa hD' hn
    rw [hF0] at h
    exact h
  have hs0 : e.symm 0 = 0 := by
    have h := e.left_inv h0s
    rw [heF, hF0] at h
    exact h

  obtain ⟨Ω, hΩdef⟩ : ∃ Ω : Set (Fin n → ℝ), Ω = fderiv ℝ F ⁻¹'
      range (ContinuousLinearEquiv.toContinuousLinearMap :
        ((Fin n → ℝ) ≃L[ℝ] (Fin n → ℝ)) → ((Fin n → ℝ) →L[ℝ] (Fin n → ℝ))) := ⟨_, rfl⟩
  have hΩ : IsOpen Ω := by
    rw [hΩdef]; exact ContinuousLinearEquiv.isOpen.preimage (hF.continuous_fderiv hn)
  have h0Ω : (0 : Fin n → ℝ) ∈ Ω := by
    rw [hΩdef]; exact ⟨E0, hD'.fderiv.symm⟩

  have hsymm0 : ContDiffAt ℝ ∞ e.symm 0 := by
    apply e.contDiffAt_symm h0t (f₀' := E0)
    · rw [hs0, heF]; exact hD'
    · rw [hs0, heF]; exact hFa
  have h1le : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  obtain ⟨K, t, ht, hK⟩ := (hsymm0.of_le h1le).exists_lipschitzOnWith
  have hSo : IsOpen (e.target ∩ e.symm ⁻¹' Ω) := e.isOpen_inter_preimage_symm hΩ
  have hS0 : (0 : Fin n → ℝ) ∈ e.target ∩ e.symm ⁻¹' Ω :=
    ⟨h0t, by simp only [mem_preimage, hs0]; exact h0Ω⟩
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.1 (Filter.inter_mem (hSo.mem_nhds hS0) ht)
  refine ⟨r, K, e.symm, hr, K.coe_nonneg, hs0, ?_, ?_⟩
  · intro z hz
    obtain ⟨⟨hzt, hzΩ⟩, -⟩ := hball hz
    rw [mem_preimage, hΩdef] at hzΩ
    obtain ⟨E1, hE1⟩ := hzΩ
    apply ContDiffAt.contDiffWithinAt
    apply e.contDiffAt_symm hzt (f₀' := E1)
    · rw [heF]
      have h : HasFDerivAt F (fderiv ℝ F (e.symm z)) (e.symm z) :=
        (hF.differentiable hn _).hasFDerivAt
      rw [← hE1] at h
      exact h
    · rw [heF]; exact hF.contDiffAt
  · intro z hz
    obtain ⟨⟨hzt, -⟩, hzt'⟩ := hball hz
    refine ⟨fun i => ?_, ?_⟩
    · have h := e.right_inv hzt
      rw [heF] at h
      have h' := congrFun h i
      simpa [hFdef] using h'
    · have h0t' : (0 : Fin n → ℝ) ∈ t := (hball (Metric.mem_ball_self hr)).2
      have h := hK.norm_sub_le hzt' h0t'
      simpa [hs0] using h

theorem ax_repair_ideal : AxRepairIdeal :=
by
  intro Pst x1 x2 hP hx1 hx12
  have hF5 : ∀ i : Fin 5, i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 := by decide
  have hF3 : ∀ i : Fin 3, i = 0 ∨ i = 1 ∨ i = 2 := by decide
  have hF2 : ∀ i : Fin 2, i = 0 ∨ i = 1 := by decide

  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : ℝ, ℓ = (x2 - x1) / 8 := ⟨_, rfl⟩
  have hℓ0 : 0 < ℓ := by rw [hℓ]; linarith
  have hx2ℓ : x2 = x1 + 8 * ℓ := by rw [hℓ]; ring
  obtain ⟨pA, hpA⟩ : ∃ p : ℝ, p = x1 + 2 * ℓ := ⟨_, rfl⟩
  obtain ⟨pB, hpB⟩ : ∃ p : ℝ, p = x1 + 4 * ℓ := ⟨_, rfl⟩
  obtain ⟨pC, hpC⟩ : ∃ p : ℝ, p = x1 + 6 * ℓ := ⟨_, rfl⟩
  have hpA0 : 0 < pA := by rw [hpA]; linarith
  have hpB0 : 0 < pB := by rw [hpB]; linarith
  have hAB : pA < pB := by rw [hpA, hpB]; linarith
  have hBC : pB < pC := by rw [hpB, hpC]; linarith

  obtain ⟨fU, hfU⟩ : ∃ f : Fin 2 → ℝ → ℝ,
      f = ![fun _ => 1, fun x => Real.sqrt (2 * x) * x ^ (1 / 10 : ℝ)] := ⟨_, rfl⟩
  obtain ⟨W, hW⟩ : ∃ f : Fin 3 → ℝ → ℝ, f = ![fun x => Real.sqrt (2 * x), fun x => x ^ (1 / 10 : ℝ),
      fun x => x ^ (1 / 10 : ℝ) / x] := ⟨_, rfl⟩
  have hfU0 : ∀ x, fU 0 x = 1 := fun x => by rw [hfU]; rfl
  have hfU1 : ∀ x, fU 1 x = Real.sqrt (2 * x) * x ^ (1 / 10 : ℝ) := fun x => by rw [hfU]; rfl
  have hW0 : ∀ x, W 0 x = Real.sqrt (2 * x) := fun x => by rw [hW]; rfl
  have hW1 : ∀ x, W 1 x = x ^ (1 / 10 : ℝ) := fun x => by rw [hW]; rfl
  have hW2 : ∀ x, W 2 x = x ^ (1 / 10 : ℝ) / x := fun x => by rw [hW]; rfl
  have hsq : ∀ x : ℝ, 0 < x → ContDiffAt ℝ ∞ (fun y : ℝ => Real.sqrt (2 * y)) x := fun x hx =>
    (contDiffAt_const.mul contDiffAt_id).sqrt (by simp; positivity)
  have hfUsm : ∀ i, ContDiffOn ℝ ∞ (fU i) (Ioi 0) := by
    intro i
    rcases hF2 i with rfl | rfl
    · have e : fU 0 = fun _ => (1 : ℝ) := funext hfU0
      rw [e]; exact contDiffOn_const
    · have e : fU 1 = fun y => Real.sqrt (2 * y) * y ^ (1 / 10 : ℝ) := funext hfU1
      rw [e]
      intro x hx
      have hx' : (0 : ℝ) < x := hx
      exact ((hsq x hx').mul (Real.contDiffAt_rpow_const_of_ne hx'.ne')).contDiffWithinAt
  have hWsm : ∀ i, ContDiffOn ℝ ∞ (W i) (Ioi 0) := by
    intro i
    rcases hF3 i with rfl | rfl | rfl
    · have e : W 0 = fun y => Real.sqrt (2 * y) := funext hW0
      rw [e]
      intro x hx
      exact (hsq x hx).contDiffWithinAt
    · have e : W 1 = fun y => y ^ (1 / 10 : ℝ) := funext hW1
      rw [e]
      intro x hx
      have hx' : (0 : ℝ) < x := hx
      exact (Real.contDiffAt_rpow_const_of_ne hx'.ne').contDiffWithinAt
    · have e : W 2 = fun y => y ^ (1 / 10 : ℝ) / y := funext hW2
      rw [e]
      intro x hx
      have hx' : (0 : ℝ) < x := hx
      exact ((Real.contDiffAt_rpow_const_of_ne hx'.ne').div contDiffAt_id hx'.ne').contDiffWithinAt

  obtain ⟨ψU, hψU⟩ : ∃ ψ : ℝ → ℝ,
      ψ = fun x => Real.smoothTransition (x - pA) * Real.smoothTransition (pB - x) := ⟨_, rfl⟩
  obtain ⟨ψE, hψE⟩ : ∃ ψ : ℝ → ℝ,
      ψ = fun x => Real.smoothTransition (x - pB) * Real.smoothTransition (pC - x) := ⟨_, rfl⟩
  obtain ⟨hψUc, -, hψUz, hψUb, hψUp⟩ :=
    weighted_bump pA pB (fun _ => (1 : ℝ)) hpA0 hAB contDiffOn_const
  obtain ⟨hψEc, -, hψEz, hψEb, hψEp⟩ :=
    weighted_bump pB pC (fun _ => (1 : ℝ)) hpB0 hBC contDiffOn_const
  have hψUc' : Continuous ψU := by rw [hψU]; exact hψUc.continuous
  have hψEc' : Continuous ψE := by rw [hψE]; exact hψEc.continuous
  have hψUz' : ∀ x, (x ≤ pA ∨ pB ≤ x) → ψU x = 0 := fun x hx => by rw [hψU]; exact hψUz x hx
  have hψEz' : ∀ x, (x ≤ pB ∨ pC ≤ x) → ψE x = 0 := fun x hx => by rw [hψE]; exact hψEz x hx
  have hψUb' : ∀ x, 0 ≤ ψU x ∧ ψU x ≤ 1 := fun x => by rw [hψU]; exact hψUb x
  have hψEb' : ∀ x, 0 ≤ ψE x ∧ ψE x ≤ 1 := fun x => by rw [hψE]; exact hψEb x
  have hψUp' : ∀ x, pA < x → x < pB → 0 < ψU x := fun x h1 h2 => by rw [hψU]; exact hψUp x h1 h2
  have hψEp' : ∀ x, pB < x → x < pC → 0 < ψE x := fun x h1 h2 => by rw [hψE]; exact hψEp x h1 h2
  obtain ⟨β, hβ⟩ : ∃ β : Fin 2 → ℝ → ℝ, β = fun i x => fU i x * ψU x := ⟨_, rfl⟩
  obtain ⟨γ, hγ⟩ : ∃ γ : Fin 3 → ℝ → ℝ, γ = fun j x => W j x * ψE x := ⟨_, rfl⟩
  have hβx : ∀ i x, β i x = fU i x * ψU x := fun i x => by rw [hβ]
  have hγx : ∀ j x, γ j x = W j x * ψE x := fun j x => by rw [hγ]
  have hβsm : ∀ i, ContDiff ℝ ∞ (β i) := by
    intro i
    have h := (weighted_bump pA pB (fU i) hpA0 hAB (hfUsm i)).2.1
    have e : β i = fun x => fU i x * (Real.smoothTransition (x - pA) * Real.smoothTransition (pB - x)) := by
      funext x; rw [hβx, hψU]
    rw [e]; exact h
  have hγsm : ∀ j, ContDiff ℝ ∞ (γ j) := by
    intro j
    have h := (weighted_bump pB pC (W j) hpB0 hBC (hWsm j)).2.1
    have e : γ j = fun x => W j x * (Real.smoothTransition (x - pB) * Real.smoothTransition (pC - x)) := by
      funext x; rw [hγx, hψE]
    rw [e]; exact h
  have hdisj : ∀ i j x, β i x * γ j x = 0 := by
    intro i j x
    rcases le_total x pB with h | h
    · rw [hγx, hψEz' x (Or.inl h)]; ring
    · rw [hβx, hψUz' x (Or.inr h)]; ring

  obtain ⟨G, hG⟩ : ∃ G : Fin 2 → Fin 2 → ℝ,
      G = fun i j => ∫ x in x1..x2, fU i x * (fU j x * ψU x) := ⟨_, rfl⟩
  obtain ⟨GE, hGE⟩ : ∃ G : Fin 3 → Fin 3 → ℝ,
      G = fun i j => ∫ x in x1..x2, W i x * (W j x * ψE x) := ⟨_, rfl⟩
  obtain ⟨P, hPd⟩ : ∃ P : Fin 2 → Fin 2 → ℝ, P = fun i i' => ∫ x in x1..x2, β i x * β i' x := ⟨_, rfl⟩
  obtain ⟨Q, hQd⟩ : ∃ Q : Fin 3 → Fin 3 → ℝ, Q = fun j l => ∫ x in x1..x2, γ j x * γ l x := ⟨_, rfl⟩
  obtain ⟨R, hRd⟩ : ∃ R : Fin 3 → Fin 3 → ℝ, R = fun j l => ∫ x in x1..x2, γ j x * γ l x / x := ⟨_, rfl⟩
  have hGij : ∀ i j, (∫ x in x1..x2, fU i x * (fU j x * ψU x)) = G i j := fun i j => by rw [hG]
  have hGEij : ∀ i j, (∫ x in x1..x2, W i x * (W j x * ψE x)) = GE i j := fun i j => by rw [hGE]
  have hPij : ∀ i i', (∫ x in x1..x2, β i x * β i' x) = P i i' := fun i i' => by rw [hPd]
  have hQij : ∀ j l, (∫ x in x1..x2, γ j x * γ l x) = Q j l := fun j l => by rw [hQd]
  have hRij : ∀ j l, (∫ x in x1..x2, γ j x * γ l x / x) = R j l := fun j l => by rw [hRd]
  have hI0 : ∀ j, (∫ x in x1..x2, β j x) = G 0 j := by
    intro j; rw [hG]; simp only [hβx, hfU0, one_mul]
  have hI1 : ∀ j, (∫ x in x1..x2, Real.sqrt (2 * x) * x ^ (1 / 10 : ℝ) * β j x) = G 1 j := by
    intro j; rw [hG]; simp only [hβx, hfU1]
  have hJ0 : ∀ j, (∫ x in x1..x2, Real.sqrt (2 * x) * γ j x) = GE 0 j := by
    intro j; rw [hGE]; simp only [hγx, hW0]
  have hJ1 : ∀ j, (∫ x in x1..x2, x ^ (1 / 10 : ℝ) * γ j x) = GE 1 j := by
    intro j; rw [hGE]; simp only [hγx, hW1]
  have hJ2 : ∀ j, (∫ x in x1..x2, x ^ (1 / 10 : ℝ) / x * γ j x) = GE 2 j := by
    intro j; rw [hGE]; simp only [hγx, hW2]

  obtain ⟨a, ha⟩ : ∃ a : Fin 5 → Fin 5 → ℝ, a = ![![G 0 0, G 0 1, 0, 0, 0], ![G 1 0, G 1 1, 0, 0, 0],
      ![0, 0, GE 0 0, GE 0 1, GE 0 2], ![0, 0, -GE 1 0, -GE 1 1, -GE 1 2],
      ![0, 0, GE 2 0, GE 2 1, GE 2 2]] := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : Fin 5 → Fin 5 → Fin 5 → ℝ, b = ![0, 0, 0,
      ![![P 0 0, P 0 1, 0, 0, 0], ![P 1 0, P 1 1, 0, 0, 0],
        ![0, 0, -(Q 0 0 / 2), -(Q 0 1 / 2), -(Q 0 2 / 2)],
        ![0, 0, -(Q 1 0 / 2), -(Q 1 1 / 2), -(Q 1 2 / 2)],
        ![0, 0, -(Q 2 0 / 2), -(Q 2 1 / 2), -(Q 2 2 / 2)]],
      ![0, 0, ![0, 0, R 0 0 / 2, R 0 1 / 2, R 0 2 / 2], ![0, 0, R 1 0 / 2, R 1 1 / 2, R 1 2 / 2],
        ![0, 0, R 2 0 / 2, R 2 1 / 2, R 2 2 / 2]]] := ⟨_, rfl⟩

  have hsubI : Icc x1 x2 ⊆ Ioi 0 := fun x hx => lt_of_lt_of_le hx1 hx.1
  obtain ⟨indU, -⟩ := repair_weights_independent pA pB hpA0 hAB
  obtain ⟨-, indE⟩ := repair_weights_independent pB pC hpB0 hBC
  have hindU : ∀ v : Fin 2 → ℝ, (∀ x ∈ Ioo pA pB, ∑ j, v j * fU j x = 0) → v = 0 := by
    intro v hv
    obtain ⟨h0, h1⟩ := indU (v 0) (v 1) (fun x hx => by
      have := hv x hx
      rw [Fin.sum_univ_two, hfU0, hfU1] at this
      exact this)
    funext i
    rcases hF2 i with rfl | rfl
    · exact h0
    · exact h1
  have hindE : ∀ v : Fin 3 → ℝ, (∀ x ∈ Ioo pB pC, ∑ j, v j * W j x = 0) → v = 0 := by
    intro v hv
    obtain ⟨h0, h1, h2⟩ := indE (v 0) (v 1) (v 2) (fun x hx => by
      have := hv x hx
      rw [Fin.sum_univ_three, hW0, hW1, hW2] at this
      exact this)
    funext i
    rcases hF3 i with rfl | rfl | rfl
    · exact h0
    · exact h1
    · exact h2
  have gramU := gram_form_pos 2 fU ψU x1 x2 pA pB (by rw [hpA]; linarith) hAB
    (by rw [hpB, hx2ℓ]; linarith) (fun i => ((hfUsm i).continuousOn).mono hsubI)
    hψUc'.continuousOn (fun x _ => (hψUb' x).1) (fun x hx => hψUp' x hx.1 hx.2) hindU
  have gramE := gram_form_pos 3 W ψE x1 x2 pB pC (by rw [hpB]; linarith) hBC
    (by rw [hpC, hx2ℓ]; linarith) (fun i => ((hWsm i).continuousOn).mono hsubI)
    hψEc'.continuousOn (fun x _ => (hψEb' x).1) (fun x hx => hψEp' x hx.1 hx.2) hindE
  simp only [hGij] at gramU
  simp only [hGEij] at gramE
  have hinj : ∀ v : Fin 5 → ℝ, (∀ i, ∑ j, a i j * v j = 0) → v = 0 := by
    intro v hv
    have r0 := hv 0
    have r1 := hv 1
    have r2 := hv 2
    have r3 := hv 3
    have r4 := hv 4
    simp only [ha, Fin.sum_univ_five, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons, zero_mul,
      add_zero, zero_add] at r0 r1 r2 r3 r4
    have hU : v 0 = 0 ∧ v 1 = 0 := by
      by_contra hne
      have hvne : (![v 0, v 1] : Fin 2 → ℝ) ≠ 0 := by
        intro h; apply hne
        exact ⟨by simpa using congrFun h 0, by simpa using congrFun h 1⟩
      have pos := gramU _ hvne
      have e : (∑ i, ∑ j, (![v 0, v 1] : Fin 2 → ℝ) i * (![v 0, v 1] : Fin 2 → ℝ) j * G i j) = 0 := by
        simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
        linear_combination v 0 * r0 + v 1 * r1
      linarith
    have hE : v 2 = 0 ∧ v 3 = 0 ∧ v 4 = 0 := by
      by_contra hne
      have hvne : (![v 2, v 3, v 4] : Fin 3 → ℝ) ≠ 0 := by
        intro h; apply hne
        exact ⟨by simpa using congrFun h 0, by simpa using congrFun h 1, by simpa using congrFun h 2⟩
      have pos := gramE _ hvne
      have e : (∑ i, ∑ j, (![v 2, v 3, v 4] : Fin 3 → ℝ) i * (![v 2, v 3, v 4] : Fin 3 → ℝ) j * GE i j)
          = 0 := by
        simp only [Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
          Matrix.head_cons, Matrix.tail_cons]
        linear_combination v 2 * r2 - v 3 * r3 + v 4 * r4
      linarith
    funext i
    rcases hF5 i with rfl | rfl | rfl | rfl | rfl
    · exact hU.1
    · exact hU.2
    · exact hE.1
    · exact hE.2.1
    · exact hE.2.2

  obtain ⟨r, L, g, hr, hL, hg0, hgsm, hgsol⟩ := quad_map_local_inverse 5 a b hinj

  obtain ⟨κm, hκm⟩ : ∃ t : ℝ, t = 5 / Pst := ⟨_, rfl⟩
  have hκm0 : 0 < κm := by rw [hκm]; exact div_pos (by norm_num) hP
  obtain ⟨K, hK⟩ : ∃ t : ℝ, t = κm + 17 * κm ^ 2 := ⟨_, rfl⟩
  have hK0 : 0 < K := by rw [hK]; have := sq_nonneg κm; linarith
  have hKa : κm ≤ K := by rw [hK]; have := sq_nonneg κm; linarith
  have hKb : 17 * κm ^ 2 ≤ K := by rw [hK]; linarith
  obtain ⟨Wb, hWb⟩ : ∃ t : ℝ,
      t = Real.sqrt (2 * x2) + x2 ^ (1 / 10 : ℝ) + x2 ^ (1 / 10 : ℝ) / x1 := ⟨_, rfl⟩
  have hx20 : 0 < x2 := by linarith
  have hWb0 : 0 < Wb := by
    rw [hWb]
    have h1 : 0 < x2 ^ (1 / 10 : ℝ) := Real.rpow_pos_of_pos hx20 _
    have h2 : 0 ≤ Real.sqrt (2 * x2) := Real.sqrt_nonneg _
    have h3 : 0 < x2 ^ (1 / 10 : ℝ) / x1 := div_pos h1 hx1
    linarith
  have hx1p : 0 < x1 ^ (1 / 10 : ℝ) := Real.rpow_pos_of_pos hx1 _
  have hpos2 : 0 < 2 * Wb * (L + 1) * K :=
    mul_pos (mul_pos (mul_pos two_pos hWb0) (by linarith)) hK0
  obtain ⟨δ, hδ⟩ : ∃ t : ℝ, t = min (r / K) (x1 ^ (1 / 10 : ℝ) / (2 * Wb * (L + 1) * K)) := ⟨_, rfl⟩
  have hδ0 : 0 < δ := by rw [hδ]; exact lt_min (div_pos hr hK0) (div_pos hx1p hpos2)
  have hδ1 : δ ≤ r / K := by rw [hδ]; exact min_le_left _ _
  have hδ2 : δ ≤ x1 ^ (1 / 10 : ℝ) / (2 * Wb * (L + 1) * K) := by rw [hδ]; exact min_le_right _ _

