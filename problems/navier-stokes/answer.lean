  rw [e1] at hn1
  rw [e2] at hn2
  have q0 : (n 0 - Bs * σ) ^ 2 ≤ δ ^ 2 := sq_le_sq' (abs_le.mp hn0).1 (abs_le.mp hn0).2
  have q1 : (n 1 - Bs * -N2) ^ 2 ≤ δ ^ 2 := sq_le_sq' (abs_le.mp hn1).1 (abs_le.mp hn1).2
  have q2 : (n 2 - Bs * N1) ^ 2 ≤ δ ^ 2 := sq_le_sq' (abs_le.mp hn2).1 (abs_le.mp hn2).2

  have hxX : ∀ i, x i ^ 2 ≤ dotProduct x x := fun i => by
    rw [sq]
    exact Finset.single_le_sum (f := fun j => x j * x j) (fun j _ => mul_self_nonneg (x j))
      (Finset.mem_univ i)
  have hX : dotProduct x x = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    simp only [dotProduct, Fin.sum_univ_three]; ring
  have hg : dotProduct n x = n 0 * x 0 + n 1 * x 1 + n 2 * x 2 := by
    simp only [dotProduct, Fin.sum_univ_three]

  obtain ⟨P, hP⟩ : ∃ P : ℝ, P = -(2 * F0 * N1) := ⟨_, rfl⟩
  obtain ⟨S, hS⟩ : ∃ S : ℝ, S = 2 * F0 * N1 + G0 := ⟨_, rfl⟩
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = x 0 + σ * N2 * x 1 - σ * N1 * x 2 := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : ℝ, b = N1 * x 1 + N2 * x 2 := ⟨_, rfl⟩
  obtain ⟨g, hgd⟩ : ∃ g : ℝ, g = dotProduct n x := ⟨_, rfl⟩
  obtain ⟨X, hXd⟩ : ∃ X : ℝ, X = dotProduct x x := ⟨_, rfl⟩
  rw [← hP, ← hS] at hPS'
  rw [← hP, ← hS, ← ha, ← hb, ← hgd, ← hXd]
  rw [← hXd] at hX hxX
  rw [← hgd] at hg
  obtain ⟨Q, hQ⟩ : ∃ Q : ℝ, Q = S * a ^ 2 + P * (1 + σ ^ 2) * b ^ 2 := ⟨_, rfl⟩
  rw [← hQ]

  have hP2 : 2 ≤ P * M ^ 2 := by
    have h1 : 1 ≤ -(N1 * M) := by linarith
    have h2 : 1 * 1 ≤ (F0 * M) * (-(N1 * M)) := mul_le_mul hF1' h1 zero_le_one (by linarith)
    have h3 : P * M ^ 2 = 2 * ((F0 * M) * (-(N1 * M))) := by rw [hP]; ring
    linarith
  have hPpos : 0 < P := by
    by_contra h
    have h' : P ≤ 0 := not_lt.mp h
