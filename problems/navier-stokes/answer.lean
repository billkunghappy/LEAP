    simp only [Function.comp_def, ContinuousMultilinearMap.compContinuousLinearMapL_apply] at h3
    have hcl := isClosed_le h3 (continuous_const (y := C * SC B.h ξ ^ b))
    have hsub := hcl.closure_subset_iff.mpr hint
    rw [closure_Ioo hL.ne] at hsub
    exact hsub ⟨hv0, hvL⟩
  ·
    obtain ⟨-, hrect, -⟩ := pulse_line_rect5 B.h G.r0 γ (G.ctr γ) ξ.2.2.2 hr0 hr0' hR v hv0 hvL
    rw [← hd, ← hy0] at hrect
    obtain ⟨⟨U, hUo, hξU, hAU⟩, hNB⟩ :=
      hCb γ (ξ.1, ξ.2.1, ξ.2.2.1, ξ.2.2.2 + (v - y0) • d) (by omega) hAct heta hD hrect hX1 hX2
    rw [← hAf] at hAU hNB
    have hev : (fun z : ℝ × ℝ × ℝ => M γ ((ξ.1, ξ.2.1, ξ.2.2.1) + z) v) =ᶠ[nhds 0]
        fun z => Af ((ξ.1, ξ.2.1, ξ.2.2.1, ξ.2.2.2 + (v - y0) • d) +
          (Lι.comp (ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ)) z) := by
      have hmem : {z : ℝ × ℝ × ℝ | (ξ.1, ξ.2.1, ξ.2.2.1) + z ∈ Ω} ∈ nhds (0 : ℝ × ℝ × ℝ) := by
