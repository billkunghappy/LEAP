    have hmul := nb_real_mul_le_v5 B.h ξ (fun η => (qC B.h η / Qb γ.1) ^ (1 + B.h))
      (fun η => 1 * Kmat B G γ η i j + μ * dDamp5 B G γ η) k Arc
      (AKc * SC B.h ξ + |μ| * (ADc * SC B.h ξ ^ 2))
      (hrW.contDiffAt (hWo.mem_nhds hξW)) (hgW.contDiffAt (hWo.mem_nhds hξW)) hra hgb
    rw [hf]
    refine le_trans hmul ?_
    rw [Real.rpow_two]
    have hS2 : SC B.h ξ ≤ SC B.h ξ ^ 2 := by
      rw [sq]; exact le_mul_of_one_le_right hS0 hS1
    have t1 : AKc * SC B.h ξ ≤ AKc * SC B.h ξ ^ 2 := mul_le_mul_of_nonneg_left hS2 hAK0
    have hADS : 0 ≤ ADc * SC B.h ξ ^ 2 := mul_nonneg hAD0 (sq_nonneg _)
    have t2 : |μ| * (ADc * SC B.h ξ ^ 2) ≤ (m : ℝ) ^ 2 * (ADc * SC B.h ξ ^ 2) :=
