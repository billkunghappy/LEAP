  · rw [hVpt η]
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const
      (a := rfpY4 P.Md P.lam) (b := rfpY4 P.Md P.lam + 60) (C := M)
      (f := fun y => W y * Real.exp (-(Θ y * Real.log (1 + η ^ 2))))
