    have hpow : ∀ η y : ℝ, 0 ≤ ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y) ∧ ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y) ≤ 1 :=
      fun η y =>
      ⟨Real.rpow_nonneg (hb0 η).le _, Real.rpow_le_one (hb0 η).le (hb1 η) (by linarith [(hb2 y).1])⟩
    have hbd : ∀ η : ℝ, HasDerivAt (fun η : ℝ => (1 + η ^ 2)⁻¹) (-(2 * η) * ((1 + η ^ 2)⁻¹) ^ 2) η := by
      intro η
      have h1 : HasDerivAt (fun η : ℝ => 1 + η ^ 2) (2 * η) η := by
