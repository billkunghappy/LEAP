    have := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hR hD
      (fun z hz => hK z (hsub (Metric.sphere_subset_closedBall hz)))
    calc ‖deriv f (e : ℂ)‖ ≤ K / (s / 2) := this
      _ = 2 * K / s := by rw [div_div_eq_mul_div]; ring

  have G4 : ∀ (c : ℕ → ℂ) (y : ℂ),
      (∑' n : ℕ, c n * (n.descFactorial 1 : ℂ) * y ^ (n - 1) =
        ∑' n : ℕ, ((n : ℂ) + 1) * c (n + 1) * y ^ n) ∧
      (∑' n : ℕ, c n * (n.descFactorial 2 : ℂ) * y ^ (n - 2) =
        ∑' n : ℕ, ((n : ℂ) + 1) * ((n : ℂ) + 2) * c (n + 2) * y ^ n) := by
    intro c y
    constructor
    · rw [← (add_left_injective 1).tsum_eq]
      · apply tsum_congr
        intro m
        simp only [Nat.descFactorial_one, Nat.add_sub_cancel]
        push_cast; ring
      · intro n hn
        rcases n with _ | n
        · simp at hn
        · exact ⟨n, rfl⟩
    · rw [← (add_left_injective 2).tsum_eq]
      · apply tsum_congr
        intro m
        simp only [Nat.descFactorial_succ, Nat.descFactorial_zero, Nat.add_sub_cancel]
        push_cast; ring
      · intro n hn
        rcases n with _ | _ | n
        · simp at hn
        · simp at hn
        · exact ⟨n, rfl⟩

  have hΛX : Λ * X < 9 / 2 := by
    rw [lt_div_iff₀ (by positivity)] at hX1; nlinarith
  have hΛX0 : 0 < Λ * X := mul_pos hΛpos hX0
  have hΛXabs : |Λ * X| < 9 / 2 := abs_lt.mpr ⟨by linarith, hΛX⟩
  have ax_ps_iter_deriv : ∀ (a : ℕ → ℝ) (B Λ : ℝ), 0 < Λ → (∀ n : ℕ, |a n| ≤ B * (1 / 10) ^ n) →
      ∀ (k : ℕ) (Y : ℝ), |Λ * Y| < 5 →
      HasDerivAt (fun Y' : ℝ => Λ ^ k * ∑' n : ℕ, a n * (n.descFactorial k : ℝ) * (Λ * Y') ^ (n - k))
        (Λ ^ (k + 1) * ∑' n : ℕ, a n * (n.descFactorial (k + 1) : ℝ) * (Λ * Y) ^ (n - (k + 1))) Y := by
    intro a B Λ hΛ ha
    have hB : 0 ≤ B := by
      have h0 := ha 0
      rw [pow_zero, mul_one] at h0
      exact le_trans (abs_nonneg _) h0
    have hterm : ∀ (t : ℝ), |t| < 5 → ∀ j n : ℕ,
        |a n * (n.descFactorial j : ℝ) * t ^ (n - j)| ≤ B * ((n : ℝ) ^ j * (1 / 2) ^ n) := by
