    have hRη : inRect B.h γ (G.ctr γ) G.r0 η.2.2.2 := by rw [hη3]; exact hRY0
    have hvη : vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = 0 := by rw [hη3]; exact hvY0
