        (-Xe + L * M0 + (A * I0 - B * J0) / G + (A - 1) * (X - Xe)) = (L - B) * D := by ring
    have hp : 0 ≤ (L - B) * D := mul_nonneg hLB' hD'
    linarith
  unfold rinQf
  rw [hsplit _ hkc, hsplit _ hgc, hsplit _ hkgc, hI, hJ, hgXe, hgX]
  exact key _ _ _ _ _ _ _ hLB hD

theorem rinQ_decr_region : ∀ (h η X0 : ℝ) (c k : ℝ → ℝ), 0 < X0 → ContinuousOn (fun x => Real.sqrt (2 * x) * c (Real.log x)) (Set.Ici 0) → ContinuousOn (fun x => k (Real.log x)) (Set.Ici 0) → (∀ x : ℝ, 0 < x → 0 < Real.sqrt (2 * x) * c (Real.log x)) → (∀ x X : ℝ, X0 ≤ x → x ≤ X → Real.sqrt (2 * X) * c (Real.log X) ≤ Real.sqrt (2 * x) * c (Real.log x)) → (∀ x : ℝ, X0 ≤ x → k (Real.log x) = 0) → 0 ≤ 1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2)) → 1 - 2 * h * η ^ 2 ≤ 1 → 0 ≤ rinMom (fun x => k (Real.log x)) X0 → rinMom (fun x => k (Real.log x)) X0 ≤ X0 → 0 ≤ rinQf h c k X0 η → ∀ X : ℝ, X0 ≤ X → X0 * rinQf h c k X0 η + ((1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2))) - 1) * (X - X0) ≤ X * rinQf h c k X η :=
