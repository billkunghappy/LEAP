theorem simCut_props : ∀ (h qs : ℝ), 0 < h → h < 1 / 2 → 0 < qs → qs ≤ 1 → SimScaleProps h → (∀ a : ℝ, ContDiffOn ℝ ∞ (↿(simCut h a)) (simDomain h qs)) ∧ (∀ (a : ℝ) (x : ℝ³) (t : ℝ), (a * simScale h (x 2) (1 - t) ≤ 1 / 2 → simCut h a x t = 1) ∧ (1 ≤ a * simScale h (x 2) (1 - t) → simCut h a x t = 0) ∧ 0 ≤ simCut h a x t ∧ simCut h a x t ≤ 1) ∧ (∀ (a : ℝ) (w : ℝ³ × ℝ), w ∈ simDomain h qs → 1 < a * simScale h (w.1 2) (1 - w.2) → (↿(simCut h a)) =ᶠ[nhds w] fun _ => (0 : ℝ)) ∧ (∀ (a : ℕ → ℝ), (∀ j, 1 ≤ a j) → (∀ j, 2 * a j ≤ a (j + 1)) → ∀ w ∈ simDomain h qs, ∃ U ∈ nhds w, ∃ n : ℕ, ∀ j, n ≤ j → ∀ z ∈ U, (↿(simCut h (a j))) z = 0) ∧ (∀ k : ℕ, ∃ M : ℝ, ∀ a : ℝ, 0 < a → ∀ x t, (x, t) ∈ simDomain h qs → ‖iteratedFDeriv ℝ k (↿(simCut h a)) (x, t)‖ ≤ M * simScale h (x 2) (1 - t) ^ (-(k : ℝ))) ∧ (∀ (a : ℝ) (x : ℝ³) (t : ℝ) (v : ℝ³), t < 1 → v 2 = 0 → fderiv ℝ (fun y => simCut h a y t) x v = 0) :=
by
  intro h qs hh0 hh1 hqs0 hqs1 hS
  have simQ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} ∧ IsOpen (simDomain h qs) ∧ (∀ w : ℝ³ × ℝ, w.2 < 1 → 0 < simScale h (w.1 2) (1 - w.2)) ∧ (∀ k : ℕ, 1 ≤ k → ∃ C : ℝ, ∀ w : ℝ³ × ℝ, w.2 < 1 → simScale h (w.1 2) (1 - w.2) ≤ 1 → ‖iteratedFDeriv ℝ k (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) w‖ ≤ C * simScale h (w.1 2) (1 - w.2) ^ (1 - (k : ℝ))) := by
    obtain ⟨hS1, -, -, hS4, hS5⟩ := hS
    obtain ⟨L₀, hL₀def⟩ : ∃ L : (EuclideanSpace ℝ (Fin 3)) × ℝ →L[ℝ] ℝ × ℝ,
        L = ((EuclideanSpace.proj (2 : Fin 3) : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ).comp
          (ContinuousLinearMap.fst ℝ (EuclideanSpace ℝ (Fin 3)) ℝ)).prod
          (-(ContinuousLinearMap.snd ℝ (EuclideanSpace ℝ (Fin 3)) ℝ)) := ⟨_, rfl⟩
    have hL₀ : ∀ v : ℝ³ × ℝ, L₀ v = (v.1 2, -v.2) := by
      intro v; rw [hL₀def]; rfl
    have hΦ : ∀ v : ℝ³ × ℝ, L₀ v + ((0:ℝ), (1:ℝ)) = (v.1 2, 1 - v.2) := by
      intro v
      rw [hL₀, Prod.mk_add_mk, add_zero]
      congr 1
      ring
    have hfun : (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) =
        (fun y : ℝ × ℝ => (fun p : ℝ × ℝ => simScale h p.1 p.2) (y + ((0:ℝ), (1:ℝ)))) ∘ L₀ := by
      funext v
      simp only [Function.comp]
      rw [hΦ v]
    have hT : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
    have ha : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2))
        {w : ℝ³ × ℝ | w.2 < 1} := by
      rw [hfun]
      refine hS4.comp ((contDiff_id.add contDiff_const).comp L₀.contDiff).contDiffOn ?_
      intro w hw
      show L₀ w + ((0:ℝ), (1:ℝ)) ∈ _
      rw [hΦ w]
      exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
    have hb : IsOpen (simDomain h qs) := by
      have e : simDomain h qs = {w : ℝ³ × ℝ | w.2 < 1} ∩
          (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) ⁻¹' Iio qs := rfl
      rw [e]
      exact ha.continuousOn.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const)
        isOpen_Iio
    have hc : ∀ w : ℝ³ × ℝ, w.2 < 1 → 0 < simScale h (w.1 2) (1 - w.2) :=
      fun w hw => (hS1 (w.1 2) (1 - w.2) (sub_pos.mpr hw)).1
    have hLn : ‖L₀‖ ≤ 1 := by
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => ?_)
      rw [hL₀, one_mul, Prod.norm_def, Prod.norm_def]
      simp only [norm_neg]
      exact max_le_max (PiLp.norm_apply_le x.1 2) le_rfl
    refine ⟨ha, hb, hc, ?_⟩
    intro k hk
    obtain ⟨C, hC⟩ := hS5 k hk
    refine ⟨C, fun w hw hq1 => ?_⟩
    have hso : IsOpen ((fun y : ℝ × ℝ => y + ((0:ℝ), (1:ℝ))) ⁻¹' (univ ×ˢ Ioi (0:ℝ))) :=
      hT.preimage (continuous_id.add continuous_const)
    have hg₁ : ContDiffOn ℝ ∞
        (fun y : ℝ × ℝ => (fun p : ℝ × ℝ => simScale h p.1 p.2) (y + ((0:ℝ), (1:ℝ))))
        ((fun y : ℝ × ℝ => y + ((0:ℝ), (1:ℝ))) ⁻¹' (univ ×ˢ Ioi (0:ℝ))) :=
      hS4.comp (contDiff_id.add contDiff_const).contDiffOn (fun y hy => hy)
    have hLw : L₀ w ∈ (fun y : ℝ × ℝ => y + ((0:ℝ), (1:ℝ))) ⁻¹' (univ ×ˢ Ioi (0:ℝ)) := by
      rw [Set.mem_preimage, hΦ w]
      exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
    have hLso : IsOpen (L₀ ⁻¹' ((fun y : ℝ × ℝ => y + ((0:ℝ), (1:ℝ))) ⁻¹' (univ ×ˢ Ioi (0:ℝ)))) :=
      hso.preimage L₀.continuous
    have key := ContinuousLinearMap.iteratedFDerivWithin_comp_right L₀ hg₁ hso.uniqueDiffOn
      hLso.uniqueDiffOn hLw (i := k) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen k hLso (show w ∈ L₀ ⁻¹' _ from hLw),
      iteratedFDerivWithin_of_isOpen k hso hLw] at key
    have htr := iteratedFDeriv_comp_add_right (𝕜 := ℝ) (f := fun p : ℝ × ℝ => simScale h p.1 p.2)
      k ((0:ℝ), (1:ℝ)) (L₀ w)
    calc ‖iteratedFDeriv ℝ k (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) w‖
        = ‖(iteratedFDeriv ℝ k (fun p : ℝ × ℝ => simScale h p.1 p.2)
            (L₀ w + ((0:ℝ), (1:ℝ)))).compContinuousLinearMap fun _ => L₀‖ := by
          rw [hfun, key, htr]
      _ ≤ ‖iteratedFDeriv ℝ k (fun p : ℝ × ℝ => simScale h p.1 p.2) (L₀ w + ((0:ℝ), (1:ℝ)))‖ *
            ∏ _i : Fin k, ‖L₀‖ :=
          ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
      _ ≤ ‖iteratedFDeriv ℝ k (fun p : ℝ × ℝ => simScale h p.1 p.2) (L₀ w + ((0:ℝ), (1:ℝ)))‖ := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
          exact mul_le_of_le_one_right (norm_nonneg _) (pow_le_one₀ (norm_nonneg _) hLn)
      _ ≤ C * simScale h (w.1 2) (1 - w.2) ^ (1 - (k : ℝ)) := by
          rw [hΦ w]
          exact hC _ _ (sub_pos.mpr hw) hq1
  obtain ⟨hQa, hΩ, hQpos, hQd⟩ := simQ
  have hUo : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  have hΩU : simDomain h qs ⊆ {w : ℝ³ × ℝ | w.2 < 1} := fun w hw => hw.1
  have hQc : ∀ w : ℝ³ × ℝ, w.2 < 1 →
      ContinuousAt (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) w :=
    fun w hw => hQa.continuousOn.continuousAt (hUo.mem_nhds hw)
  have hGs : ContDiff ℝ ∞ (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) :=
    Real.smoothTransition.contDiff.comp (contDiff_const.sub (contDiff_const.mul contDiff_id))

  have hP : ∀ (a : ℝ) (x : ℝ³) (t : ℝ), (a * simScale h (x 2) (1 - t) ≤ 1 / 2 → simCut h a x t = 1) ∧
      (1 ≤ a * simScale h (x 2) (1 - t) → simCut h a x t = 0) ∧ 0 ≤ simCut h a x t ∧
      simCut h a x t ≤ 1 := by
    intro a x t
    unfold simCut
    refine ⟨fun h1 => ?_, fun h1 => ?_, Real.smoothTransition.nonneg _,
      Real.smoothTransition.le_one _⟩
    · exact Real.smoothTransition.one_of_one_le (by linarith)
    · exact Real.smoothTransition.zero_of_nonpos (by linarith)

  have hfs : ∀ a : ℝ, ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => a * simScale h (w.1 2) (1 - w.2))
      (simDomain h qs) := fun a => contDiffOn_const.mul (hQa.mono hΩU)
  have hi : ∀ a : ℝ, ContDiffOn ℝ ∞ (↿(simCut h a)) (simDomain h qs) := fun a =>
    hGs.comp_contDiffOn (hfs a)

  have hiii : ∀ (a : ℝ) (w : ℝ³ × ℝ), w ∈ simDomain h qs →
      1 < a * simScale h (w.1 2) (1 - w.2) → (↿(simCut h a)) =ᶠ[nhds w] fun _ => (0 : ℝ) := by
    intro a w hw h1
    have hev : ∀ᶠ z in nhds w, (1 : ℝ) < a * simScale h (z.1 2) (1 - z.2) :=
      continuousAt_const.eventually_lt (continuousAt_const.mul (hQc w hw.1)) h1
    exact hev.mono fun z hz => (hP a z.1 z.2).2.1 hz.le

  have hiv : ∀ (a : ℕ → ℝ), (∀ j, 1 ≤ a j) → (∀ j, 2 * a j ≤ a (j + 1)) →
      ∀ w ∈ simDomain h qs, ∃ U ∈ nhds w, ∃ n : ℕ, ∀ j, n ≤ j → ∀ z ∈ U,
        (↿(simCut h (a j))) z = 0 := by
    intro a ha1 ha2 w hw
    have hpow : ∀ j : ℕ, (2 : ℝ) ^ j ≤ a j := by
      intro j
      induction j with
      | zero => simpa using ha1 0
      | succ j ih => rw [pow_succ]; linarith [ha2 j]
    have hq0 : 0 < simScale h (w.1 2) (1 - w.2) := hQpos w hw.1
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (2 / simScale h (w.1 2) (1 - w.2))
      (one_lt_two : (1 : ℝ) < 2)
    refine ⟨{z | simScale h (w.1 2) (1 - w.2) / 2 < simScale h (z.1 2) (1 - z.2)}, ?_, n, ?_⟩
    · exact continuousAt_const.eventually_lt (hQc w hw.1) (by linarith)
    · intro j hj z hz
      have hz' : simScale h (w.1 2) (1 - w.2) / 2 < simScale h (z.1 2) (1 - z.2) := hz
      have h2n : (2 : ℝ) ^ n ≤ a j := (pow_le_pow_right₀ (by norm_num) hj).trans (hpow j)
      have hn' : 2 < 2 ^ n * simScale h (w.1 2) (1 - w.2) := by
        rwa [div_lt_iff₀ hq0] at hn
      have hzpos : 0 < simScale h (z.1 2) (1 - z.2) := by linarith
      apply (hP (a j) z.1 z.2).2.1
      nlinarith [mul_le_mul_of_nonneg_right h2n hzpos.le,
        mul_lt_mul_of_pos_left hz' (pow_pos (two_pos : (0 : ℝ) < 2) n)]

  have hv : ∀ k : ℕ, ∃ M : ℝ, ∀ a : ℝ, 0 < a → ∀ x t, (x, t) ∈ simDomain h qs →
      ‖iteratedFDeriv ℝ k (↿(simCut h a)) (x, t)‖ ≤
        M * simScale h (x 2) (1 - t) ^ (-(k : ℝ)) := by
    intro k
    have hQd' : ∀ i : ℕ, ∃ C : ℝ, 1 ≤ i → ∀ w : ℝ³ × ℝ, w.2 < 1 →
        simScale h (w.1 2) (1 - w.2) ≤ 1 →
        ‖iteratedFDeriv ℝ i (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) w‖ ≤
          C * simScale h (w.1 2) (1 - w.2) ^ (1 - (i : ℝ)) := by
      intro i
      by_cases hi1 : 1 ≤ i
      · obtain ⟨C, hC⟩ := hQd i hi1
        exact ⟨C, fun _ => hC⟩
      · exact ⟨0, fun h1 => absurd h1 hi1⟩
    choose Cq hCq using hQd'
    have hGb : ∀ i : ℕ, ∃ B : ℝ, ∀ σ ∈ Icc (0 : ℝ) 1,
        ‖iteratedFDeriv ℝ i (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) σ‖ ≤ B := by
      intro i
      exact isCompact_Icc.exists_bound_of_continuousOn
        ((hGs.continuous_iteratedFDeriv (by exact_mod_cast le_top)).continuousOn)
    choose B hB using hGb
    obtain ⟨C', hC'⟩ : ∃ C' : ℝ, C' = 1 + ∑ i ∈ Finset.range (k + 1), |Cq i| := ⟨_, rfl⟩
    obtain ⟨Cg, hCg⟩ : ∃ Cg : ℝ, Cg = ∑ i ∈ Finset.range (k + 1), |B i| := ⟨_, rfl⟩
    have hC'1 : 1 ≤ C' := by
      have := Finset.sum_nonneg (fun i (_ : i ∈ Finset.range (k + 1)) => abs_nonneg (Cq i))
      linarith
    have hCqle : ∀ i ≤ k, |Cq i| ≤ C' := by
      intro i hi
      have := Finset.single_le_sum (f := fun i => |Cq i|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
      linarith
    have hBle : ∀ i ≤ k, ∀ σ ∈ Icc (0 : ℝ) 1,
        ‖iteratedFDeriv ℝ i (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) σ‖ ≤ Cg := by
      intro i hi σ hσ
      have := Finset.single_le_sum (f := fun i => |B i|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
      rw [hCg]
      exact (hB i σ hσ).trans ((le_abs_self _).trans this)
    have hCg0 : 0 ≤ Cg := by
      rw [hCg]; exact Finset.sum_nonneg (fun i _ => abs_nonneg (B i))
    refine ⟨(k.factorial : ℝ) * Cg * C' ^ k, ?_⟩
    intro a ha x t hxt
    have ht : t < 1 := hxt.1
    have hq0 : 0 < simScale h (x 2) (1 - t) := hQpos (x, t) ht
    have hq1 : simScale h (x 2) (1 - t) ≤ 1 := by have := hxt.2; linarith
    have hC'0 : 0 ≤ C' := by linarith
    have hM0 : 0 ≤ (k.factorial : ℝ) * Cg * C' ^ k := by positivity
    by_cases hcase : 1 < a * simScale h (x 2) (1 - t)
    · have hev := hiii a (x, t) hxt hcase
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_zero]
      simp only [Pi.zero_apply, norm_zero]
      exact mul_nonneg hM0 (Real.rpow_nonneg hq0.le _)
    · push_neg at hcase
      have hg : ∀ i ≤ k, ‖iteratedFDerivWithin ℝ i
          (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) univ
          (a * simScale h (x 2) (1 - t))‖ ≤ Cg := by
        intro i hi
        rw [iteratedFDerivWithin_univ]
        exact hBle i hi _ ⟨(mul_pos ha hq0).le, hcase⟩
      have hf : ∀ i : ℕ, 1 ≤ i → i ≤ k → ‖iteratedFDerivWithin ℝ i
          (fun w : ℝ³ × ℝ => a * simScale h (w.1 2) (1 - w.2)) (simDomain h qs) (x, t)‖ ≤
          (C' * (simScale h (x 2) (1 - t))⁻¹) ^ i := by
        intro i hi1 hik
        rw [iteratedFDerivWithin_of_isOpen i hΩ hxt]
        have hfeq : (fun w : ℝ³ × ℝ => a * simScale h (w.1 2) (1 - w.2)) =
            a • (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) := by
          funext w; simp [smul_eq_mul]
        rw [hfeq, iteratedFDeriv_const_smul_apply
          ((hQa.contDiffAt (hUo.mem_nhds ht)).of_le (by exact_mod_cast le_top)),
          norm_smul, Real.norm_of_nonneg ha.le]
        have hQb : ‖iteratedFDeriv ℝ i (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) (x, t)‖
            ≤ Cq i * simScale h (x 2) (1 - t) ^ (1 - (i : ℝ)) := hCq i hi1 (x, t) ht hq1
        have e1 : simScale h (x 2) (1 - t) ^ (1 - (i : ℝ)) =
            simScale h (x 2) (1 - t) * (simScale h (x 2) (1 - t))⁻¹ ^ i := by
          rw [Real.rpow_sub hq0, Real.rpow_one, Real.rpow_natCast, div_eq_mul_inv, inv_pow]
        rw [e1] at hQb
        have hP0 : 0 < (simScale h (x 2) (1 - t))⁻¹ ^ i := by positivity
        have hC'i : C' ≤ C' ^ i := le_self_pow₀ hC'1 (by omega)
        have hCqi := hCqle i hik
        rw [mul_pow]
        have h1 : a * ‖iteratedFDeriv ℝ i (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) (x, t)‖
            ≤ a * (|Cq i| * (simScale h (x 2) (1 - t) * (simScale h (x 2) (1 - t))⁻¹ ^ i)) := by
          apply mul_le_mul_of_nonneg_left _ ha.le
          exact hQb.trans (mul_le_mul_of_nonneg_right (le_abs_self _) (by positivity))
        calc _ ≤ _ := h1
          _ = |Cq i| * (a * simScale h (x 2) (1 - t)) * (simScale h (x 2) (1 - t))⁻¹ ^ i := by
            ring
          _ ≤ |Cq i| * 1 * (simScale h (x 2) (1 - t))⁻¹ ^ i := by
            apply mul_le_mul_of_nonneg_right _ hP0.le
            exact mul_le_mul_of_nonneg_left hcase (abs_nonneg _)
          _ ≤ C' ^ i * (simScale h (x 2) (1 - t))⁻¹ ^ i := by
            apply mul_le_mul_of_nonneg_right _ hP0.le
            linarith
      have key := norm_iteratedFDerivWithin_comp_le hGs.contDiffOn (hfs a)
        (by exact_mod_cast le_top) uniqueDiffOn_univ hΩ.uniqueDiffOn (mapsTo_univ _ _) hxt hg hf
      rw [iteratedFDerivWithin_of_isOpen k hΩ hxt] at key
      have e2 : simScale h (x 2) (1 - t) ^ (-(k : ℝ)) = (simScale h (x 2) (1 - t))⁻¹ ^ k := by
        rw [Real.rpow_neg hq0.le, Real.rpow_natCast, inv_pow]
      rw [e2]
      calc ‖iteratedFDeriv ℝ k (↿(simCut h a)) (x, t)‖ =
          ‖iteratedFDeriv ℝ k ((fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) ∘
            (fun w : ℝ³ × ℝ => a * simScale h (w.1 2) (1 - w.2))) (x, t)‖ := rfl
        _ ≤ _ := key
        _ = _ := by rw [mul_pow]; ring

  have hvi : ∀ (a : ℝ) (x : ℝ³) (t : ℝ) (v : ℝ³), t < 1 → v 2 = 0 →
      fderiv ℝ (fun y => simCut h a y t) x v = 0 := by
    intro a x t v ht hv
    have hS4 := hS.2.2.2.1
    obtain ⟨φ, hφ⟩ : ∃ φ : ℝ → ℝ,
        φ = fun z => Real.smoothTransition (2 - 2 * (a * simScale h z (1 - t))) := ⟨_, rfl⟩
    have hcomp : (fun y : ℝ³ => simCut h a y t) =
        φ ∘ (EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ) := by
      rw [hφ]; rfl
    have hι : ContDiffAt ℝ ∞ (fun z : ℝ => simScale h z (1 - t)) (x 2) := by
      have h1 : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale h w.1 w.2) (x 2, 1 - t) :=
        hS4.contDiffAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds
          ⟨mem_univ _, show (0 : ℝ) < 1 - t by linarith⟩)
      exact ContDiffAt.comp (g := fun w : ℝ × ℝ => simScale h w.1 w.2)
        (f := fun z : ℝ => (z, 1 - t)) (x 2) h1 (contDiffAt_id.prodMk contDiffAt_const)
    have hφd : DifferentiableAt ℝ φ (x 2) := by
      have h2 : DifferentiableAt ℝ (fun z : ℝ => a * simScale h z (1 - t)) (x 2) :=
        (hι.differentiableAt (by norm_num)).const_mul a
      rw [hφ]
      exact (hGs.differentiable (by norm_num) _).comp (x 2) h2
    rw [hcomp, fderiv_comp x hφd
      (EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).differentiableAt,
      ContinuousLinearMap.fderiv, ContinuousLinearMap.comp_apply]
    show (fderiv ℝ φ _) (v 2) = 0
    rw [hv, map_zero]
  exact ⟨hi, hP, hiii, hiv, hv, hvi⟩

theorem cutoff_product_bound : ∀ (h qs β : ℝ) (ℓ : ℕ → ℝ) {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : ℝ³ → ℝ → V), 0 < h → h < 1 / 2 → 0 < qs → qs ≤ 1 → SimScaleProps h → ContDiffOn ℝ ∞ (↿F) (simDomain h qs) → (∀ m : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain h qs → ‖iteratedFDeriv ℝ m (↿F) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (β - ℓ m)) → ∀ m : ℕ, ∃ C : ℝ, ∀ a : ℝ, 0 < a → ∀ x t, (x, t) ∈ simDomain h qs → ‖iteratedFDeriv ℝ m (↿(fun y s => simCut h a y s • F y s)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (β - ((m : ℝ) + ∑ i ∈ Finset.range (m + 1), |ℓ i|)) :=
by
  intro h qs β ℓ V _ _ F hh0 hh1 hqs0 hqs1 hS hFs hFb m
  obtain ⟨hcs, -, -, -, hcb, -⟩ := simCut_props h qs hh0 hh1 hqs0 hqs1 hS
  have hΩ : IsOpen (simDomain h qs) := (simQ_props h qs hh0 hh1 hS).2.1
  choose M hM using hcb
  choose C hC using hFb
  refine ⟨∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * |M i| * |C (m - i)|, ?_⟩
  intro a ha x t hxt
  have ht : t < 1 := hxt.1
  have hqs : simScale h (x 2) (1 - t) < qs := hxt.2
  have hq0 : 0 < simScale h (x 2) (1 - t) := (hS.1 (x 2) (1 - t) (by linarith)).1
  have hq1 : simScale h (x 2) (1 - t) ≤ 1 := by linarith
  have hU : UniqueDiffOn ℝ (simDomain h qs) := hΩ.uniqueDiffOn
  have key := norm_iteratedFDerivWithin_smul_le (hcs a) hFs hU hxt (n := m)
    (by exact_mod_cast le_top)
  have e1 : iteratedFDerivWithin ℝ m (fun w : ℝ³ × ℝ => (↿(simCut h a)) w • (↿F) w)
      (simDomain h qs) (x, t) =
      iteratedFDeriv ℝ m (fun w : ℝ³ × ℝ => (↿(simCut h a)) w • (↿F) w) (x, t) :=
    iteratedFDerivWithin_of_isOpen m hΩ hxt
  have e2 : ∀ i : ℕ, iteratedFDerivWithin ℝ i (↿(simCut h a)) (simDomain h qs) (x, t) =
      iteratedFDeriv ℝ i (↿(simCut h a)) (x, t) := fun i => iteratedFDerivWithin_of_isOpen i hΩ hxt
  have e3 : ∀ i : ℕ, iteratedFDerivWithin ℝ i (↿F) (simDomain h qs) (x, t) =
      iteratedFDeriv ℝ i (↿F) (x, t) := fun i => iteratedFDerivWithin_of_isOpen i hΩ hxt
  rw [e1] at key
  simp only [e2, e3] at key
  show ‖iteratedFDeriv ℝ m (fun w : ℝ³ × ℝ => (↿(simCut h a)) w • (↿F) w) (x, t)‖ ≤ _
  refine key.trans ?_
  rw [Finset.sum_mul]
  apply Finset.sum_le_sum
  intro i hi
  have him : i ≤ m := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
  have hA : ‖iteratedFDeriv ℝ i (↿(simCut h a)) (x, t)‖ ≤
      |M i| * simScale h (x 2) (1 - t) ^ (-(i : ℝ)) :=
    (hM i a ha x t hxt).trans
      (mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hq0.le _))
  have hB : ‖iteratedFDeriv ℝ (m - i) (↿F) (x, t)‖ ≤
      |C (m - i)| * simScale h (x 2) (1 - t) ^ (β - ℓ (m - i)) :=
    (hC (m - i) x t hxt).trans
      (mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hq0.le _))
  have hprod : ‖iteratedFDeriv ℝ i (↿(simCut h a)) (x, t)‖ * ‖iteratedFDeriv ℝ (m - i) (↿F) (x, t)‖ ≤
      (|M i| * simScale h (x 2) (1 - t) ^ (-(i : ℝ))) *
        (|C (m - i)| * simScale h (x 2) (1 - t) ^ (β - ℓ (m - i))) :=
    mul_le_mul hA hB (norm_nonneg _)
      (mul_nonneg (abs_nonneg _) (Real.rpow_nonneg hq0.le _))
  have hrw : simScale h (x 2) (1 - t) ^ (-(i : ℝ)) * simScale h (x 2) (1 - t) ^ (β - ℓ (m - i)) =
      simScale h (x 2) (1 - t) ^ (-(i : ℝ) + (β - ℓ (m - i))) :=
    (Real.rpow_add hq0 _ _).symm
  have hsum : ℓ (m - i) ≤ ∑ j ∈ Finset.range (m + 1), |ℓ j| :=
    (le_abs_self _).trans
      (Finset.single_le_sum (f := fun j => |ℓ j|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.mpr (by omega)))
  have hcast : (i : ℝ) ≤ (m : ℝ) := by exact_mod_cast him
  have hexp : simScale h (x 2) (1 - t) ^ (-(i : ℝ) + (β - ℓ (m - i))) ≤
      simScale h (x 2) (1 - t) ^ (β - ((m : ℝ) + ∑ j ∈ Finset.range (m + 1), |ℓ j|)) :=
    Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (by linarith)
  have hMC : 0 ≤ |M i| * |C (m - i)| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
  have hfin : ‖iteratedFDeriv ℝ i (↿(simCut h a)) (x, t)‖ * ‖iteratedFDeriv ℝ (m - i) (↿F) (x, t)‖ ≤
      |M i| * |C (m - i)| *
        simScale h (x 2) (1 - t) ^ (β - ((m : ℝ) + ∑ j ∈ Finset.range (m + 1), |ℓ j|)) := by
    calc _ ≤ _ := hprod
      _ = |M i| * |C (m - i)| * (simScale h (x 2) (1 - t) ^ (-(i : ℝ)) *
            simScale h (x 2) (1 - t) ^ (β - ℓ (m - i))) := by ring
      _ = |M i| * |C (m - i)| * simScale h (x 2) (1 - t) ^ (-(i : ℝ) + (β - ℓ (m - i))) := by
          rw [hrw]
      _ ≤ _ := mul_le_mul_of_nonneg_left hexp hMC
  have hc : (0 : ℝ) ≤ (m.choose i : ℝ) := Nat.cast_nonneg _
  calc (m.choose i : ℝ) * ‖iteratedFDeriv ℝ i (↿(simCut h a)) (x, t)‖ *
        ‖iteratedFDeriv ℝ (m - i) (↿F) (x, t)‖
      = (m.choose i : ℝ) * (‖iteratedFDeriv ℝ i (↿(simCut h a)) (x, t)‖ *
        ‖iteratedFDeriv ℝ (m - i) (↿F) (x, t)‖) := by ring
    _ ≤ (m.choose i : ℝ) * (|M i| * |C (m - i)| *
        simScale h (x 2) (1 - t) ^ (β - ((m : ℝ) + ∑ j ∈ Finset.range (m + 1), |ℓ j|))) :=
        mul_le_mul_of_nonneg_left hfin hc
    _ = _ := by ring

theorem cut_scale_choice : ∀ (γ qs : ℝ) (Ch : ℕ → ℕ → ℝ), 0 < γ → 0 < qs → ∃ a : ℕ → ℝ, (∀ j, 1 ≤ a j) ∧ (∀ j, 2 / qs ≤ a j) ∧ (∀ j, 2 * a j ≤ a (j + 1)) ∧ ∀ j : ℕ, 1 ≤ j → ∀ m : ℕ, m ≤ j → ∀ q : ℝ, 0 < q → q ≤ 1 / a j → |Ch j m| * q ^ (γ * (j : ℝ) / 2) ≤ (1 / 2) ^ j :=
by
  intro γ qs Ch hγ hqs
  obtain ⟨S, hS⟩ : ∃ S : ℕ → ℝ, S = fun j => ∑ m ∈ Finset.range (j + 1), |Ch j m| := ⟨_, rfl⟩
  obtain ⟨M, hM⟩ : ∃ M : ℕ → ℝ, M = fun j => (2 : ℝ) ^ j * (1 + S j) := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : ℕ → ℝ, b = fun j => M j ^ ((γ * (j : ℝ) / 2)⁻¹) := ⟨_, rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : ℕ → ℝ, T = fun j => 1 + 2 / qs + ∑ i ∈ Finset.range (j + 1), b i :=
    ⟨_, rfl⟩
  have hS0 : ∀ j, 0 ≤ S j := fun j => by
    rw [hS]; exact Finset.sum_nonneg (fun m _ => abs_nonneg _)
  have h2j : ∀ j : ℕ, (1 : ℝ) ≤ 2 ^ j := fun j => one_le_pow₀ (by norm_num)
  have hM1 : ∀ j, 1 ≤ M j := fun j => by
    rw [hM]
    show 1 ≤ (2 : ℝ) ^ j * (1 + S j)
    nlinarith [h2j j, hS0 j]
  have hb0 : ∀ j, 0 ≤ b j := fun j => by
    rw [hb]; exact Real.rpow_nonneg (by linarith [hM1 j]) _
  have hbpos : ∀ j, 0 < b j := fun j => by
    rw [hb]; exact Real.rpow_pos_of_pos (by linarith [hM1 j]) _
  have hq2 : 0 < 2 / qs := div_pos two_pos hqs
  have hsum0 : ∀ j, 0 ≤ ∑ i ∈ Finset.range (j + 1), b i := fun j =>
    Finset.sum_nonneg (fun i _ => hb0 i)
  have hTe : ∀ j, T j = 1 + 2 / qs + ∑ i ∈ Finset.range (j + 1), b i := fun j => by rw [hT]
  have hT1 : ∀ j, 1 ≤ T j := fun j => by rw [hTe]; linarith [hsum0 j]
  have hTq : ∀ j, 2 / qs ≤ T j := fun j => by rw [hTe]; linarith [hsum0 j]
  have hTa : ∀ j, T j ≤ 2 ^ j * T j := fun j =>
    le_mul_of_one_le_left (by linarith [hT1 j]) (h2j j)
  have hbT : ∀ j, b j ≤ T j := fun j => by
    have := Finset.single_le_sum (f := b) (fun i _ => hb0 i) (Finset.self_mem_range_succ j)
    rw [hTe]; linarith
  refine ⟨fun j => 2 ^ j * T j, fun j => ?_, fun j => ?_, fun j => ?_, ?_⟩
  · show 1 ≤ 2 ^ j * T j
    nlinarith [h2j j, hT1 j]
  · exact (hTq j).trans (hTa j)
  · show 2 * (2 ^ j * T j) ≤ 2 ^ (j + 1) * T (j + 1)
    have hTs : T (j + 1) = T j + b (j + 1) := by
      rw [hTe, hTe, Finset.sum_range_succ _ (j + 1)]; ring
    rw [hTs, pow_succ]
    nlinarith [hb0 (j + 1), h2j j]
  · intro j hj m hm q hq hqa
    show |Ch j m| * q ^ (γ * (j : ℝ) / 2) ≤ (1 / 2) ^ j
    have hjr : (1 : ℝ) ≤ j := Nat.one_le_cast.mpr hj
    have he : 0 < γ * (j : ℝ) / 2 := by positivity
    have hbe : b j ^ (γ * (j : ℝ) / 2) = M j := by
      rw [hb]; exact Real.rpow_inv_rpow (by linarith [hM1 j]) he.ne'
    have hab : b j ≤ 2 ^ j * T j := (hbT j).trans (hTa j)
    have hqb : q ≤ (b j)⁻¹ := by
      calc q ≤ 1 / (2 ^ j * T j) := hqa
        _ ≤ 1 / b j := one_div_le_one_div_of_le (hbpos j) hab
        _ = (b j)⁻¹ := one_div _
    have hqe : q ^ (γ * (j : ℝ) / 2) ≤ (M j)⁻¹ := by
      calc q ^ (γ * (j : ℝ) / 2) ≤ ((b j)⁻¹) ^ (γ * (j : ℝ) / 2) :=
            Real.rpow_le_rpow hq.le hqb he.le
        _ = (M j)⁻¹ := by rw [Real.inv_rpow (hb0 j), hbe]
    have hCh : |Ch j m| ≤ S j := by
      rw [hS]
      exact Finset.single_le_sum (f := fun m => |Ch j m|) (fun i _ => abs_nonneg _)
        (Finset.mem_range.mpr (by omega))
    have hMeq : M j = 2 ^ j * (1 + S j) := by rw [hM]
    have hMpos : 0 < M j := by linarith [hM1 j]
    have hS1 : (0 : ℝ) < 1 + S j := by linarith [hS0 j]
    have h2pos : (0 : ℝ) < 2 ^ j := by positivity
    calc |Ch j m| * q ^ (γ * (j : ℝ) / 2) ≤ |Ch j m| * (M j)⁻¹ :=
          mul_le_mul_of_nonneg_left hqe (abs_nonneg _)
      _ ≤ (1 + S j) * (M j)⁻¹ :=
          mul_le_mul_of_nonneg_right (by linarith) (inv_nonneg.mpr hMpos.le)
      _ = (1 / 2) ^ j := by
        rw [hMeq, one_div_pow, one_div]
        field_simp

theorem cutSum_props : ∀ (h qs γ : ℝ) (L : ℕ → ℝ) (a : ℕ → ℝ) {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : ℕ → ℝ³ → ℝ → V), 0 < h → h < 1 / 2 → 0 < qs → qs ≤ 1 → 0 < γ → SimScaleProps h → (∀ j, 1 ≤ a j) → (∀ j, 2 * a j ≤ a (j + 1)) → (∀ j, ContDiffOn ℝ ∞ (↿(F j)) (simDomain h qs)) → (∀ j : ℕ, 1 ≤ j → ∀ k : ℕ, k ≤ j → ∀ x t, (x, t) ∈ simDomain h qs → a j * simScale h (x 2) (1 - t) ≤ 1 → ‖iteratedFDeriv ℝ k (↿(fun y s => simCut h (a j) y s • F j y s)) (x, t)‖ ≤ (1 / 2) ^ j * simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) / 2 - L k)) → (∀ j : ℕ, 1 ≤ j → ∀ k : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain h qs → ‖iteratedFDeriv ℝ k (↿(fun y s => simCut h (a j) y s • F j y s)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (- L k)) → ContDiffOn ℝ ∞ (↿(cutSum h a F)) (simDomain h qs) ∧ (∀ k : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain h qs → ‖iteratedFDeriv ℝ k (↿(cutSum h a F)) (x, t)‖ ≤ ‖iteratedFDeriv ℝ k (↿(F 0)) (x, t)‖ + C * simScale h (x 2) (1 - t) ^ (- L k)) ∧ (∀ J k : ℕ, k ≤ J → ∀ x t, (x, t) ∈ simDomain h qs → a J * simScale h (x 2) (1 - t) < 1 / 2 → ‖iteratedFDeriv ℝ k (fun z => (↿(cutSum h a F)) z - ∑ j ∈ Finset.range (J + 1), (↿(F j)) z) (x, t)‖ ≤ (1 / 2) ^ J * simScale h (x 2) (1 - t) ^ (γ * ((J : ℝ) + 1) / 2 - L k)) :=
by
  intro h qs γ L a V _ _ F hh0 hh1 hqs0 hqs1 hγ hS ha1 ha2 hF hsupp hglob

  have lf_tsum : ∀ (O : Set (ℝ³ × ℝ)) (G : ℕ → ℝ³ × ℝ → V), IsOpen O → (∀ j, ContDiffOn ℝ ∞ (G j) O) →
      (∀ w ∈ O, ∃ U ∈ nhds w, ∃ n : ℕ, ∀ j, n ≤ j → ∀ z ∈ U, G j z = 0) →
      ContDiffOn ℝ ∞ (fun z => ∑' j, G j z) O ∧
      ∀ w ∈ O, ∀ U ∈ nhds w, ∀ n : ℕ, (∀ j, n ≤ j → ∀ z ∈ U, G j z = 0) → ∀ k : ℕ,
        iteratedFDeriv ℝ k (fun z => ∑' j, G j z) w = ∑ j ∈ Finset.range n, iteratedFDeriv ℝ k (G j) w := by
    intro O G hO hG hlfG
    have key : ∀ U : Set (ℝ³ × ℝ), ∀ n : ℕ, (∀ j, n ≤ j → ∀ z ∈ U, G j z = 0) → ∀ z ∈ U,
        ∑' j, G j z = ∑ j ∈ Finset.range n, G j z := by
      intro U n hU z hz
      apply tsum_eq_sum
      intro b hb
      exact hU b (by simpa using hb) z hz
    refine ⟨?_, ?_⟩
    · apply contDiffOn_of_locally_contDiffOn
      intro w hw
      obtain ⟨U, hU, n, hn⟩ := hlfG w hw
      refine ⟨interior U, isOpen_interior, mem_interior_iff_mem_nhds.mpr hU, ?_⟩
      have hs : ContDiffOn ℝ ∞ (fun z => ∑ j ∈ Finset.range n, G j z) O :=
        ContDiffOn.sum (fun j _ => hG j)
      exact (hs.mono inter_subset_left).congr (fun z hz => key U n hn z (interior_subset hz.2))
    · intro w hw U hU n hn k
      have hev : (fun z => ∑' j, G j z) =ᶠ[nhds w] (fun z => ∑ j ∈ Finset.range n, G j z) :=
        Filter.eventuallyEq_of_mem hU (fun z hz => key U n hn z hz)
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      have h2 : (fun z => ∑ j ∈ Finset.range n, G j z) = ∑ j ∈ Finset.range n, G j := by
        funext z; simp [Finset.sum_apply]
      rw [← iteratedFDerivWithin_of_isOpen k hO hw, h2,
        iteratedFDerivWithin_sum_apply hO.uniqueDiffOn hw
          (fun j _ => ((hG j) w hw).of_le (by exact_mod_cast le_top))]
      exact Finset.sum_congr rfl (fun j _ => iteratedFDerivWithin_of_isOpen k hO hw)
  have hgeom : ∀ n : ℕ, ∑ i ∈ Finset.range n, (1 / 2 : ℝ) ^ (i + 1) ≤ 1 := by
    intro n
    simp_rw [pow_succ]
    rw [← Finset.sum_mul]
    have := sum_geometric_two_le n
    linarith

  set Q : ℝ³ × ℝ → ℝ := fun w => simScale h (w.1 2) (1 - w.2) with hQdef
  have hS1o : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  have hQs : ContDiffOn ℝ ∞ Q {w : ℝ³ × ℝ | w.2 < 1} := by
    have hΦ : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
      ((contDiff_piLp_apply 2 (i := (2 : Fin 3))).comp contDiff_fst).prodMk
        (contDiff_const.sub contDiff_snd)
    exact hS.2.2.2.1.comp hΦ.contDiffOn
      (fun w hw => ⟨mem_univ _, show (0 : ℝ) < 1 - w.2 by have : w.2 < 1 := hw; linarith⟩)
  have hΩS1 : simDomain h qs ⊆ {w : ℝ³ × ℝ | w.2 < 1} := fun w hw => hw.1
  have hΩo : IsOpen (simDomain h qs) :=
    hQs.continuousOn.isOpen_inter_preimage hS1o (isOpen_Iio (a := qs))
  have hQpos : ∀ w ∈ simDomain h qs, 0 < Q w ∧ Q w ≤ 1 := by
    intro w hw
    have h1 : w.2 < 1 := hw.1
    have h2 : Q w < qs := hw.2
    exact ⟨(hS.1 (w.1 2) (1 - w.2) (by linarith)).1, by linarith⟩

  have hcut1 : ∀ (b : ℝ) (x : ℝ³) (t : ℝ), b * simScale h (x 2) (1 - t) ≤ 1 / 2 →
      simCut h b x t = 1 := by
    intro b x t hb
    unfold simCut
    exact Real.smoothTransition.one_of_one_le (by linarith)
  have hcut0 : ∀ (b : ℝ) (x : ℝ³) (t : ℝ), 1 ≤ b * simScale h (x 2) (1 - t) →
      simCut h b x t = 0 := by
    intro b x t hb
    unfold simCut
    exact Real.smoothTransition.zero_of_nonpos (by linarith)
  have hcs : ∀ b : ℝ, ContDiffOn ℝ ∞ (↿(simCut h b)) (simDomain h qs) := by
    intro b
    have hin : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => 2 - 2 * (b * Q w)) {w : ℝ³ × ℝ | w.2 < 1} :=
      contDiffOn_const.sub (contDiffOn_const.mul (contDiffOn_const.mul hQs))
    exact ((Real.smoothTransition.contDiff (n := ⊤)).comp_contDiffOn hin).mono hΩS1

  set T : ℕ → ℝ³ × ℝ → V := fun j => ↿(fun y s => simCut h (a j) y s • F j y s) with hTdef
  have hTs : ∀ j, ContDiffOn ℝ ∞ (T j) (simDomain h qs) := fun j => (hcs (a j)).smul (hF j)
  have hapow : ∀ j : ℕ, (2 : ℝ) ^ j ≤ a j := by
    intro j
    induction j with
    | zero => simpa using ha1 0
    | succ j ih => rw [pow_succ]; linarith [ha2 j]
  have hamono : Monotone a := monotone_nat_of_le_succ (fun j => by linarith [ha1 j, ha2 j])
  have hlf : ∀ w ∈ simDomain h qs, ∃ U ∈ nhds w, ∃ n : ℕ, ∀ j, n ≤ j → ∀ z ∈ U, T j z = 0 := by
    intro w hw
    obtain ⟨hq0, -⟩ := hQpos w hw
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (2 / Q w) (one_lt_two : (1 : ℝ) < 2)
    refine ⟨{w : ℝ³ × ℝ | w.2 < 1} ∩ Q ⁻¹' Ioi (Q w / 2), ?_, n, ?_⟩
    · exact (hQs.continuousOn.isOpen_inter_preimage hS1o isOpen_Ioi).mem_nhds
        ⟨hw.1, show Q w / 2 < Q w by linarith⟩
    · intro j hj z hz
      have hz2 : Q w / 2 < Q z := hz.2
      have h2n : (2 : ℝ) ^ n ≤ a j := (pow_le_pow_right₀ (by norm_num) hj).trans (hapow j)
      have e : 2 / Q w * (Q w / 2) = 1 := by field_simp
      have hprod : 1 < (2 : ℝ) ^ n * (Q w / 2) := by
        have := mul_lt_mul_of_pos_right hn (show 0 < Q w / 2 by linarith)
        rw [e] at this
        exact this
      have hle : (2 : ℝ) ^ n * (Q w / 2) ≤ a j * Q z :=
        mul_le_mul h2n hz2.le (by linarith) (by linarith [ha1 j])
      have hc : simCut h (a j) z.1 z.2 = 0 :=
        hcut0 (a j) z.1 z.2 (by show 1 ≤ a j * Q z; linarith)
      show simCut h (a j) z.1 z.2 • F j z.1 z.2 = 0
      rw [hc, zero_smul]

  have hstar : ∀ j : ℕ, 1 ≤ j → ∀ k : ℕ, k ≤ j → ∀ w ∈ simDomain h qs,
      ‖iteratedFDeriv ℝ k (T j) w‖ ≤ (1 / 2) ^ j * Q w ^ (γ * (j : ℝ) / 2 - L k) := by
    intro j hj k hk w hw
    by_cases hc : a j * Q w ≤ 1
    · exact hsupp j hj k hk w.1 w.2 hw hc
    · push_neg at hc
      have hVo : IsOpen (simDomain h qs ∩ (fun z => a j * Q z) ⁻¹' Ioi 1) :=
        (continuousOn_const.mul (hQs.continuousOn.mono hΩS1)).isOpen_inter_preimage hΩo isOpen_Ioi
      have hev : T j =ᶠ[nhds w] fun _ => (0 : V) :=
        Filter.eventuallyEq_of_mem (hVo.mem_nhds ⟨hw, hc⟩) (fun z hz => by
          have hz2 : 1 < a j * Q z := hz.2
          show simCut h (a j) z.1 z.2 • F j z.1 z.2 = 0
          rw [hcut0 (a j) z.1 z.2 hz2.le, zero_smul])
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_zero]
      simp only [Pi.zero_apply, norm_zero]
      exact mul_nonneg (by positivity) (Real.rpow_nonneg (hQpos w hw).1.le _)

  have hcutSum_eq : ↿(cutSum h a F) = fun z => ↿(F 0) z + ∑' i : ℕ, T (i + 1) z := by
    funext z; rfl
  have hT1lf : ∀ w ∈ simDomain h qs, ∃ U ∈ nhds w, ∃ n : ℕ, ∀ i, n ≤ i → ∀ z ∈ U,
      T (i + 1) z = 0 := by
    intro w hw
    obtain ⟨U, hU, n, hn⟩ := hlf w hw
    exact ⟨U, hU, n, fun i hi z hz => hn (i + 1) (by omega) z hz⟩
  obtain ⟨hsum1, hder1⟩ := lf_tsum (simDomain h qs) (fun i => T (i + 1)) hΩo
    (fun i => hTs (i + 1)) hT1lf
  have hi : ContDiffOn ℝ ∞ (↿(cutSum h a F)) (simDomain h qs) := by
    rw [hcutSum_eq]; exact (hF 0).add hsum1

  have hii : ∀ k : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain h qs →
      ‖iteratedFDeriv ℝ k (↿(cutSum h a F)) (x, t)‖ ≤
        ‖iteratedFDeriv ℝ k (↿(F 0)) (x, t)‖ + C * simScale h (x 2) (1 - t) ^ (- L k) := by
    intro k
    have hglob' := fun j (hj : 1 ≤ j) => hglob j hj k
    choose! C0 hC0 using hglob'
    obtain ⟨M, hM⟩ : ∃ M : ℝ, M = ∑ j ∈ Finset.range k, |C0 j| := ⟨_, rfl⟩
    have hM0 : 0 ≤ M := by rw [hM]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
    refine ⟨1 + 2 ^ k * M, fun x t hw => ?_⟩
    have hq := hQpos (x, t) hw
    have hq0 : 0 < simScale h (x 2) (1 - t) := hq.1
    have hq1 : simScale h (x 2) (1 - t) ≤ 1 := hq.2
    obtain ⟨U, hU, n, hn⟩ := hT1lf (x, t) hw
    have hD := hder1 (x, t) hw U hU n hn k
    have hA : ContDiffAt ℝ k (↿(F 0)) (x, t) :=
      ((hF 0).contDiffAt (hΩo.mem_nhds hw)).of_le (by exact_mod_cast le_top)
    have hB : ContDiffAt ℝ k (fun z => ∑' i : ℕ, T (i + 1) z) (x, t) :=
      (hsum1.contDiffAt (hΩo.mem_nhds hw)).of_le (by exact_mod_cast le_top)
    have e : (fun z => ↿(F 0) z + ∑' i : ℕ, T (i + 1) z) =
        ↿(F 0) + (fun z => ∑' i : ℕ, T (i + 1) z) := rfl
    rw [hcutSum_eq, e, iteratedFDeriv_add_apply hA hB, hD]
    refine (norm_add_le _ _).trans (add_le_add le_rfl ?_)
    refine (norm_sum_le _ _).trans ?_
    obtain ⟨p, hp⟩ : ∃ p : ℝ, p = simScale h (x 2) (1 - t) ^ (-L k) := ⟨_, rfl⟩
    have hp0 : 0 ≤ p := by rw [hp]; exact Real.rpow_nonneg hq0.le _
    have h2kM : 0 ≤ (2 : ℝ) ^ k * M := by positivity
    have hterm : ∀ i ∈ Finset.range n, ‖iteratedFDeriv ℝ k (T (i + 1)) (x, t)‖ ≤
        (1 / 2) ^ (i + 1) * ((1 + 2 ^ k * M) * p) := by
      intro i _
      by_cases hki : k ≤ i + 1
      · have h1 := hstar (i + 1) (by omega) k hki (x, t) hw
        have h2 : simScale h (x 2) (1 - t) ^ (γ * ((i + 1 : ℕ) : ℝ) / 2 - L k) ≤ p := by
          rw [hp]
          apply Real.rpow_le_rpow_of_exponent_ge hq0 hq1
          have : (0 : ℝ) ≤ γ * ((i + 1 : ℕ) : ℝ) / 2 := by positivity
          linarith
        calc ‖iteratedFDeriv ℝ k (T (i + 1)) (x, t)‖
            ≤ (1 / 2) ^ (i + 1) * simScale h (x 2) (1 - t) ^ (γ * ((i + 1 : ℕ) : ℝ) / 2 - L k) := h1
          _ ≤ (1 / 2) ^ (i + 1) * p := mul_le_mul_of_nonneg_left h2 (by positivity)
          _ ≤ (1 / 2) ^ (i + 1) * ((1 + 2 ^ k * M) * p) :=
              mul_le_mul_of_nonneg_left (by nlinarith) (by positivity)
      · push_neg at hki
        have h1 := hC0 (i + 1) (by omega) x t hw
        have h2 : |C0 (i + 1)| ≤ M := by
          rw [hM]
          exact Finset.single_le_sum (f := fun j => |C0 j|) (fun j _ => abs_nonneg _)
            (Finset.mem_range.mpr hki)
        have h3 : M ≤ (1 / 2) ^ (i + 1) * (2 ^ k * M) := by
          have e2 : (1 / 2 : ℝ) ^ (i + 1) * 2 ^ (i + 1) = 1 := by rw [← mul_pow]; norm_num
          have h4 : (2 : ℝ) ^ (i + 1) ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hki.le
          have h5 : (0 : ℝ) < (1 / 2) ^ (i + 1) := by positivity
          have h6 : (1 : ℝ) ≤ (1 / 2) ^ (i + 1) * 2 ^ k := by nlinarith
          nlinarith
        calc ‖iteratedFDeriv ℝ k (T (i + 1)) (x, t)‖ ≤ C0 (i + 1) * p := by rw [hp]; exact h1
          _ ≤ |C0 (i + 1)| * p := mul_le_mul_of_nonneg_right (le_abs_self _) hp0
          _ ≤ M * p := mul_le_mul_of_nonneg_right h2 hp0
          _ ≤ ((1 / 2) ^ (i + 1) * (2 ^ k * M)) * p := mul_le_mul_of_nonneg_right h3 hp0
          _ = (1 / 2) ^ (i + 1) * (2 ^ k * M * p) := by ring
          _ ≤ (1 / 2) ^ (i + 1) * ((1 + 2 ^ k * M) * p) :=
              mul_le_mul_of_nonneg_left (by nlinarith) (by positivity)
    have hCp : 0 ≤ (1 + 2 ^ k * M) * p := by positivity
    calc ∑ i ∈ Finset.range n, ‖iteratedFDeriv ℝ k (T (i + 1)) (x, t)‖
        ≤ ∑ i ∈ Finset.range n, (1 / 2) ^ (i + 1) * ((1 + 2 ^ k * M) * p) := Finset.sum_le_sum hterm
      _ = (∑ i ∈ Finset.range n, (1 / 2 : ℝ) ^ (i + 1)) * ((1 + 2 ^ k * M) * p) := by
          rw [Finset.sum_mul]
      _ ≤ 1 * ((1 + 2 ^ k * M) * p) := mul_le_mul_of_nonneg_right (hgeom n) hCp
      _ = (1 + 2 ^ k * M) * simScale h (x 2) (1 - t) ^ (-L k) := by rw [hp]; ring

  have hiii : ∀ J k : ℕ, k ≤ J → ∀ x t, (x, t) ∈ simDomain h qs →
      a J * simScale h (x 2) (1 - t) < 1 / 2 →
      ‖iteratedFDeriv ℝ k (fun z => (↿(cutSum h a F)) z - ∑ j ∈ Finset.range (J + 1), (↿(F j)) z)
          (x, t)‖ ≤ (1 / 2) ^ J * simScale h (x 2) (1 - t) ^ (γ * ((J : ℝ) + 1) / 2 - L k) := by
    intro J k hkJ x t hw hJ
    have hNo : IsOpen (simDomain h qs ∩ (fun z => a J * Q z) ⁻¹' Iio (1 / 2)) :=
      (continuousOn_const.mul (hQs.continuousOn.mono hΩS1)).isOpen_inter_preimage hΩo isOpen_Iio
    have hclaimA : ∀ z ∈ simDomain h qs ∩ (fun z => a J * Q z) ⁻¹' Iio (1 / 2), ∀ j, j ≤ J →
        T j z = ↿(F j) z := by
      intro z hz j hj
      have hz2 : a J * Q z < 1 / 2 := hz.2
      have hqz := (hQpos z hz.1).1
      have : a j * Q z ≤ a J * Q z := mul_le_mul_of_nonneg_right (hamono hj) hqz.le
      show simCut h (a j) z.1 z.2 • F j z.1 z.2 = F j z.1 z.2
      rw [hcut1 (a j) z.1 z.2 (by show a j * Q z ≤ 1 / 2; linarith), one_smul]
    have hTJlf : ∀ w ∈ simDomain h qs, ∃ U ∈ nhds w, ∃ n : ℕ, ∀ i, n ≤ i → ∀ z ∈ U,
        T (i + J + 1) z = 0 := by
      intro w hw'
      obtain ⟨U, hU, n, hn⟩ := hlf w hw'
      exact ⟨U, hU, n, fun i hi z hz => hn (i + J + 1) (by omega) z hz⟩
    obtain ⟨-, hderJ⟩ := lf_tsum (simDomain h qs) (fun i => T (i + J + 1)) hΩo
      (fun i => hTs (i + J + 1)) hTJlf
    have hclaimB : ∀ z ∈ simDomain h qs ∩ (fun z => a J * Q z) ⁻¹' Iio (1 / 2),
        (↿(cutSum h a F)) z - ∑ j ∈ Finset.range (J + 1), (↿(F j)) z = ∑' i, T (i + J + 1) z := by
      intro z hz
      obtain ⟨U', hU', n', hn'⟩ := hT1lf z hz.1
      have hsum : Summable (fun i => T (i + 1) z) := by
        apply summable_of_ne_finset_zero (s := Finset.range n')
        intro b hb
        exact hn' b (by simpa using hb) z (mem_of_mem_nhds hU')
      have e1 : ∑ i ∈ Finset.range J, T (i + 1) z + ∑' i, T (i + J + 1) z = ∑' i, T (i + 1) z :=
        hsum.sum_add_tsum_nat_add J
      have e2 : ∑ i ∈ Finset.range J, T (i + 1) z = ∑ i ∈ Finset.range J, (↿(F (i + 1))) z :=
        Finset.sum_congr rfl (fun i hi => hclaimA z hz (i + 1) (by simp at hi; omega))
      rw [Finset.sum_range_succ', congrFun hcutSum_eq z]
      show (↿(F 0)) z + ∑' i : ℕ, T (i + 1) z - _ = _
      rw [← e1, e2]
      abel
    have hev : (fun z => (↿(cutSum h a F)) z - ∑ j ∈ Finset.range (J + 1), (↿(F j)) z)
        =ᶠ[nhds (x, t)] (fun z => ∑' i, T (i + J + 1) z) :=
      Filter.eventuallyEq_of_mem (hNo.mem_nhds ⟨hw, hJ⟩) hclaimB
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    obtain ⟨U, hU, n, hn⟩ := hTJlf (x, t) hw
    rw [hderJ (x, t) hw U hU n hn k]
    refine (norm_sum_le _ _).trans ?_
    have hq := hQpos (x, t) hw
    have hq0 : 0 < simScale h (x 2) (1 - t) := hq.1
    have hq1 : simScale h (x 2) (1 - t) ≤ 1 := hq.2
    obtain ⟨r, hr⟩ : ∃ r : ℝ, r = simScale h (x 2) (1 - t) ^ (γ * ((J : ℝ) + 1) / 2 - L k) :=
      ⟨_, rfl⟩
    have hr0 : 0 ≤ r := by rw [hr]; exact Real.rpow_nonneg hq0.le _
    have hterm : ∀ i ∈ Finset.range n, ‖iteratedFDeriv ℝ k (T (i + J + 1)) (x, t)‖ ≤
        (1 / 2) ^ J * ((1 / 2) ^ (i + 1) * r) := by
      intro i _
      have h1 := hstar (i + J + 1) (by omega) k (by omega) (x, t) hw
      have h2 : simScale h (x 2) (1 - t) ^ (γ * ((i + J + 1 : ℕ) : ℝ) / 2 - L k) ≤ r := by
        rw [hr]
        apply Real.rpow_le_rpow_of_exponent_ge hq0 hq1
        push_cast
        have : (0 : ℝ) ≤ γ * (i : ℝ) := by positivity
        linarith
      calc ‖iteratedFDeriv ℝ k (T (i + J + 1)) (x, t)‖
          ≤ (1 / 2) ^ (i + J + 1) *
              simScale h (x 2) (1 - t) ^ (γ * ((i + J + 1 : ℕ) : ℝ) / 2 - L k) := h1
        _ ≤ (1 / 2) ^ (i + J + 1) * r := mul_le_mul_of_nonneg_left h2 (by positivity)
        _ = (1 / 2) ^ J * ((1 / 2) ^ (i + 1) * r) := by ring
    calc ∑ i ∈ Finset.range n, ‖iteratedFDeriv ℝ k (T (i + J + 1)) (x, t)‖
        ≤ ∑ i ∈ Finset.range n, (1 / 2) ^ J * ((1 / 2) ^ (i + 1) * r) := Finset.sum_le_sum hterm
      _ = (1 / 2) ^ J * ((∑ i ∈ Finset.range n, (1 / 2 : ℝ) ^ (i + 1)) * r) := by
          rw [Finset.sum_mul, Finset.mul_sum]
      _ ≤ (1 / 2) ^ J * (1 * r) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (hgeom n) hr0) (by positivity)
      _ = (1 / 2) ^ J * simScale h (x 2) (1 - t) ^ (γ * ((J : ℝ) + 1) / 2 - L k) := by
          rw [hr, one_mul]
  exact ⟨hi, hii, hiii⟩

theorem cutSum_div_tangent : ∀ (h qs : ℝ) (a : ℕ → ℝ) (Bv : ℕ → ℝ³ → ℝ → ℝ³), 0 < h → h < 1 / 2 → 0 < qs → qs ≤ 1 → SimScaleProps h → (∀ j, 1 ≤ a j) → (∀ j, 2 * a j ≤ a (j + 1)) → (∀ j, ContDiffOn ℝ ∞ (↿(Bv j)) (simDomain h qs)) → (∀ (j : ℕ) x t, (x, t) ∈ simDomain h qs → divergence (fun y => Bv j y t) x = 0 ∧ inner ℝ x (Bv j x t) = (0 : ℝ) ∧ Bv j x t 2 = 0) → ∀ x t, (x, t) ∈ simDomain h qs → divergence (fun y => cutSum h a Bv y t) x = 0 ∧ inner ℝ x (cutSum h a Bv x t) = (0 : ℝ) :=
by
  intro h qs a Bv hh0 hh1 hqs0 hqs1 hS ha1 ha2 hBv hdiv x t hxt
  have ht : t < 1 := hxt.1
  have hτ : (0:ℝ) < 1 - t := by linarith

  have hScont : Continuous (fun y : ℝ³ => simScale h (y 2) (1 - t)) :=
    hS.2.2.2.1.continuousOn.comp_continuous (f := fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ))
      (by fun_prop) (fun y => ⟨mem_univ _, hτ⟩)

  have hΩ : IsOpen (simDomain h qs) := by
    have hc : ContinuousOn (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} :=
      hS.2.2.2.1.continuousOn.comp
        (by fun_prop : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ))).continuousOn
        (fun w hw => ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by have : w.2 < 1 := hw; linarith⟩)
    exact hc.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio

  have hBd : ∀ j, DifferentiableAt ℝ (fun y => Bv j y t) x := by
    intro j
    have hc : ContDiffAt ℝ ∞ (fun y => Bv j y t) x :=
      ((hBv j).contDiffAt (hΩ.mem_nhds hxt)).comp x
        ((contDiff_id.prodMk contDiff_const).contDiffAt)
    exact hc.differentiableAt (by simp)

  have hcut : ∀ c : ℝ, DifferentiableAt ℝ (fun y => simCut h c y t) x ∧
      ∀ v : ℝ³, v 2 = 0 → fderiv ℝ (fun y => simCut h c y t) x v = 0 := by
    intro c
    have hgd : DifferentiableAt ℝ (fun z => simScale h z (1 - t)) (x 2) := by
      have hc0 : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale h w.1 w.2) ((x 2, 1 - t) : ℝ × ℝ) :=
        hS.2.2.2.1.contDiffAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds
          (show ((x 2, 1 - t) : ℝ × ℝ) ∈ univ ×ˢ Ioi 0 from ⟨mem_univ _, hτ⟩))
      have hc1 : ContDiffAt ℝ ∞ (fun z : ℝ => ((z, 1 - t) : ℝ × ℝ)) (x 2) :=
        (contDiff_id.prodMk contDiff_const).contDiffAt
      exact (hc0.comp (x 2) hc1).differentiableAt (by simp)
    have h1 : DifferentiableAt ℝ (fun z => 2 - 2 * (c * simScale h z (1 - t))) (x 2) :=
      (differentiableAt_const _).sub ((differentiableAt_const _).mul ((differentiableAt_const _).mul hgd))
    have hψd : DifferentiableAt ℝ (fun z => Real.smoothTransition (2 - 2 * (c * simScale h z (1 - t)))) (x 2) :=
      ((Real.smoothTransition.contDiff (n := 1)).differentiable (by norm_num) _).comp (x 2) h1
    have hproj : HasFDerivAt (fun y : ℝ³ => y 2) (EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ) x :=
      (EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).hasFDerivAt
    have hF : HasFDerivAt (fun y : ℝ³ => simCut h c y t)
        (deriv (fun z => Real.smoothTransition (2 - 2 * (c * simScale h z (1 - t)))) (x 2) •
          (EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ)) x :=
      HasDerivAt.comp_hasFDerivAt (f := fun y : ℝ³ => y 2)
        (h₂ := fun z => Real.smoothTransition (2 - 2 * (c * simScale h z (1 - t)))) x
        hψd.hasDerivAt hproj
    refine ⟨hF.differentiableAt, fun v hv => ?_⟩
    rw [hF.fderiv]
    simp [hv]

  have ha_pow : ∀ j : ℕ, (2:ℝ) ^ j ≤ a j := by
    intro j
    induction j with
    | zero => simpa using ha1 0
    | succ k ih => rw [pow_succ]; linarith [ha2 k]
  obtain ⟨q0, hq0⟩ : ∃ q0, q0 = simScale h (x 2) (1 - t) := ⟨_, rfl⟩
  have hq0pos : 0 < q0 := by rw [hq0]; exact (hS.1 (x 2) (1 - t) hτ).1
  obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (2 / q0) (one_lt_two : (1:ℝ) < 2)
  have hUn : {y : ℝ³ | q0 / 2 < simScale h (y 2) (1 - t)} ∈ nhds x :=
    (isOpen_lt continuous_const hScont).mem_nhds (by show q0 / 2 < simScale h (x 2) (1 - t); rw [← hq0]; linarith)
  have hzero : ∀ y ∈ {y : ℝ³ | q0 / 2 < simScale h (y 2) (1 - t)}, ∀ j, n ≤ j → simCut h (a j) y t = 0 := by
    intro y hy j hj
    have hy' : q0 / 2 < simScale h (y 2) (1 - t) := hy
    have h2j : (2:ℝ) ^ n ≤ a j := (pow_le_pow_right₀ one_le_two hj).trans (ha_pow j)
    have hprod : 1 < a j * simScale h (y 2) (1 - t) := by
      have e : 2 / q0 * (q0 / 2) = 1 := by field_simp
      calc (1:ℝ) = 2 / q0 * (q0 / 2) := e.symm
        _ < 2 ^ n * (q0 / 2) := by apply mul_lt_mul_of_pos_right hn; positivity
        _ ≤ a j * (q0 / 2) := by apply mul_le_mul_of_nonneg_right h2j; positivity
        _ < a j * simScale h (y 2) (1 - t) := by
          apply mul_lt_mul_of_pos_left hy'; linarith [ha1 j]
    unfold simCut
    exact Real.smoothTransition.zero_of_nonpos (by linarith)

  have hEq : ∀ y ∈ {y : ℝ³ | q0 / 2 < simScale h (y 2) (1 - t)}, cutSum h a Bv y t =
      Bv 0 y t + ∑ i ∈ Finset.range n, simCut h (a (i + 1)) y t • Bv (i + 1) y t := by
    intro y hy
    simp only [cutSum]
    congr 1
    apply tsum_eq_sum
    intro b hb
    rw [Finset.mem_range, not_lt] at hb
    rw [hzero y hy (b + 1) (by omega), zero_smul]
  have hev : (fun y => cutSum h a Bv y t) =ᶠ[nhds x]
      (fun y => Bv 0 y t + ∑ i ∈ Finset.range n, simCut h (a (i + 1)) y t • Bv (i + 1) y t) :=
    Filter.eventuallyEq_of_mem hUn hEq

  have hTd : ∀ i : ℕ, DifferentiableAt ℝ (fun y => simCut h (a (i + 1)) y t • Bv (i + 1) y t) x :=
    fun i => (hcut (a (i + 1))).1.smul (hBd (i + 1))
  have hTdiv : ∀ i : ℕ, divergence (fun y => simCut h (a (i + 1)) y t • Bv (i + 1) y t) x = 0 := by
    intro i
    have dsf : ∀ (φ : ℝ³ → ℝ) (V : ℝ³ → ℝ³), DifferentiableAt ℝ φ x → DifferentiableAt ℝ V x →
        divergence (fun y => φ y • V y) x = φ x * divergence V x + fderiv ℝ φ x (V x) := by
      intro φ V hφ hV
      rw [divergence, fderiv_fun_smul hφ hV, ContinuousLinearMap.toLinearMap_add,
        ContinuousLinearMap.toLinearMap_smul, map_add, map_smul, divergence, smul_eq_mul]
      congr 1
      have hh : ((fderiv ℝ φ x).smulRight (V x) : ℝ³ →ₗ[ℝ] ℝ³) =
          (fderiv ℝ φ x : ℝ³ →ₗ[ℝ] ℝ).smulRight (V x) := rfl
      rw [hh, LinearMap.trace_smulRight]
      rfl
    have key := dsf (fun y => simCut h (a (i + 1)) y t) (fun y => Bv (i + 1) y t)
      (hcut (a (i + 1))).1 (hBd (i + 1))
    rw [key]
    obtain ⟨d1, -, d3⟩ := hdiv (i + 1) x t hxt
    rw [d1, (hcut (a (i + 1))).2 _ d3]
    simp
  have hsum : ∀ s : Finset ℕ,
      DifferentiableAt ℝ (fun y => ∑ i ∈ s, simCut h (a (i + 1)) y t • Bv (i + 1) y t) x ∧
      divergence (fun y => ∑ i ∈ s, simCut h (a (i + 1)) y t • Bv (i + 1) y t) x = 0 := by
    intro s
    refine Finset.induction_on s ?_ ?_
    · simp only [Finset.sum_empty]
      exact ⟨differentiableAt_const _, divergence_const _ _⟩
    · intro i s hi ih
      have e : (fun y => ∑ j ∈ insert i s, simCut h (a (j + 1)) y t • Bv (j + 1) y t) =
          fun y => simCut h (a (i + 1)) y t • Bv (i + 1) y t +
            ∑ j ∈ s, simCut h (a (j + 1)) y t • Bv (j + 1) y t := by
        funext y
        rw [Finset.sum_insert hi]
      rw [e]
      exact ⟨(hTd i).add ih.1, by rw [divergence_add (hTd i) ih.1, hTdiv i, ih.2, add_zero]⟩
  refine ⟨?_, ?_⟩
  · have hdeq : divergence (fun y => cutSum h a Bv y t) x =
        divergence (fun y => Bv 0 y t + ∑ i ∈ Finset.range n, simCut h (a (i + 1)) y t • Bv (i + 1) y t) x := by
      unfold divergence
      rw [hev.fderiv_eq]
    rw [hdeq, divergence_add (hBd 0) (hsum (Finset.range n)).1, (hdiv 0 x t hxt).1,
      (hsum (Finset.range n)).2, add_zero]
  · rw [hEq x (mem_of_mem_nhds hUn), inner_add_right, inner_sum, (hdiv 0 x t hxt).2.1, zero_add]
    apply Finset.sum_eq_zero
    intro i _
    rw [real_inner_smul_right, (hdiv (i + 1) x t hxt).2.1, mul_zero]

theorem simScale_homog : ∀ (h l z τ : ℝ), 0 < l → simScale h (l ^ (1 / 2 - h) * z) (l * τ) = l * simScale h z τ :=
by
  intro h l z τ hl
  have hl2 : l ^ (1 - 2 * h) * l ^ (2 * h) = l := by
    rw [← Real.rpow_add hl, show (1 - 2 * h) + 2 * h = (1 : ℝ) by ring, Real.rpow_one]
  have ha : (l ^ (1 / 2 - h) * z) ^ 2 = l ^ (1 - 2 * h) * z ^ 2 := by
    rw [mul_pow, sq (l ^ (1 / 2 - h)), ← Real.rpow_add hl,
      show (1 / 2 - h) + (1 / 2 - h) = 1 - 2 * h by ring]
  have key : ∀ p : ℝ, 0 < p → l * p - (l ^ (1 / 2 - h) * z) ^ 2 * (l * p) ^ (2 * h) =
      l * (p - z ^ 2 * p ^ (2 * h)) := by
    intro p hp
    rw [ha, Real.mul_rpow hl.le hp.le]
    linear_combination (-(z ^ 2 * p ^ (2 * h))) * hl2
  letI : SMul ℝ (Set ℝ) := Set.smulSet
  have hset : {q : ℝ | 0 < q ∧ l * τ ≤ q - (l ^ (1 / 2 - h) * z) ^ 2 * q ^ (2 * h)} =
      l • {q : ℝ | 0 < q ∧ τ ≤ q - z ^ 2 * q ^ (2 * h)} := by
    ext q
    rw [Set.mem_smul_set_iff_inv_smul_mem₀ hl.ne', smul_eq_mul, Set.mem_setOf_eq,
      Set.mem_setOf_eq]
    obtain ⟨p, hpdef⟩ : ∃ p : ℝ, p = l⁻¹ * q := ⟨_, rfl⟩
    have hq : q = l * p := by rw [hpdef]; field_simp
    rw [← hpdef, hq]
    constructor
    · rintro ⟨hq0, hc⟩
      have hp : 0 < p := by nlinarith
      refine ⟨hp, ?_⟩
      rw [key _ hp] at hc
      exact le_of_mul_le_mul_left hc hl
    · rintro ⟨hp, hc⟩
      refine ⟨mul_pos hl hp, ?_⟩
      rw [key _ hp]
      exact mul_le_mul_of_nonneg_left hc hl.le
  unfold simScale
  rw [hset, Real.sInf_smul_of_nonneg hl.le, smul_eq_mul]

theorem bg_field_dilation : ∀ (h l : ℝ) (n : ℕ) (g : ℝ → ℝ → ℝ) (y y' : ℝ³) (s : ℝ), 0 < l → s < 1 → y' 0 = l ^ (1 / 2 : ℝ) * y 0 → y' 1 = l ^ (1 / 2 : ℝ) * y 1 → y' 2 = l ^ (1 / 2 - h) * y 2 → bgAn h n g y' (1 - l * (1 - s)) = l ^ (-h + 2 * (n : ℝ) * h) • bgAn h n g y s ∧ bgBn h n g y' (1 - l * (1 - s)) = l ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) • bgBn h n g y s ∧ bgPn h n g y' (1 - l * (1 - s)) = l ^ (-(1 + 2 * h) + 2 * (n : ℝ) * h) * bgPn h n g y s :=
by
  intro h l n g y y' s hl hs hy0 hy1 hy2
  have hQ0 : 0 ≤ simScale h (y 2) (1 - s) := by
    unfold simScale
    exact Real.sInf_nonneg (fun x hx => hx.1.le)
  have homog : ∀ (h l z τ : ℝ), 0 < l → simScale h (l ^ (1 / 2 - h) * z) (l * τ) = l * simScale h z τ := by
    intro h l z τ hl
    have hl2 : l ^ (1 - 2 * h) * l ^ (2 * h) = l := by
      rw [← Real.rpow_add hl, show (1 - 2 * h) + 2 * h = (1 : ℝ) by ring, Real.rpow_one]
    have ha : (l ^ (1 / 2 - h) * z) ^ 2 = l ^ (1 - 2 * h) * z ^ 2 := by
      rw [mul_pow, sq (l ^ (1 / 2 - h)), ← Real.rpow_add hl,
        show (1 / 2 - h) + (1 / 2 - h) = 1 - 2 * h by ring]
    have key : ∀ p : ℝ, 0 < p → l * p - (l ^ (1 / 2 - h) * z) ^ 2 * (l * p) ^ (2 * h) =
        l * (p - z ^ 2 * p ^ (2 * h)) := by
      intro p hp
      rw [ha, Real.mul_rpow hl.le hp.le]
      linear_combination (-(z ^ 2 * p ^ (2 * h))) * hl2
    letI : SMul ℝ (Set ℝ) := Set.smulSet
    have hset : {q : ℝ | 0 < q ∧ l * τ ≤ q - (l ^ (1 / 2 - h) * z) ^ 2 * q ^ (2 * h)} =
        l • {q : ℝ | 0 < q ∧ τ ≤ q - z ^ 2 * q ^ (2 * h)} := by
      ext q
      rw [Set.mem_smul_set_iff_inv_smul_mem₀ hl.ne', smul_eq_mul, Set.mem_setOf_eq,
        Set.mem_setOf_eq]
      obtain ⟨p, hpdef⟩ : ∃ p : ℝ, p = l⁻¹ * q := ⟨_, rfl⟩
      have hq : q = l * p := by rw [hpdef]; field_simp
      rw [← hpdef, hq]
      constructor
      · rintro ⟨hq0, hc⟩
        have hp : 0 < p := by nlinarith
        refine ⟨hp, ?_⟩
        rw [key _ hp] at hc
        exact le_of_mul_le_mul_left hc hl
      · rintro ⟨hp, hc⟩
        refine ⟨mul_pos hl hp, ?_⟩
        rw [key _ hp]
        exact mul_le_mul_of_nonneg_left hc hl.le
    unfold simScale
    rw [hset, Real.sInf_smul_of_nonneg hl.le, smul_eq_mul]
  have hQ : simScale h (y' 2) (1 - (1 - l * (1 - s))) = l * simScale h (y 2) (1 - s) := by
    rw [hy2, show (1:ℝ) - (1 - l * (1 - s)) = l * (1 - s) by ring]
    exact homog h l (y 2) (1 - s) hl
  have hsq : (l ^ (1 / 2 : ℝ)) ^ 2 = l := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hl.le]
    norm_num
  have hX : simX h y' (1 - l * (1 - s)) = simX h y s := by
    unfold simX
    rw [hQ, hy0, hy1]
    have e1 : (l ^ (1 / 2 : ℝ) * y 0) ^ 2 + (l ^ (1 / 2 : ℝ) * y 1) ^ 2 =
        l * (y 0 ^ 2 + y 1 ^ 2) := by
      rw [mul_pow, mul_pow, hsq]; ring
    rw [e1, show 2 * (l * simScale h (y 2) (1 - s)) = l * (2 * simScale h (y 2) (1 - s)) by ring,
      mul_div_mul_left _ _ hl.ne']
  have hE : simEta h y' (1 - l * (1 - s)) = simEta h y s := by
    unfold simEta
    rw [hQ, hy2, Real.mul_rpow hl.le hQ0]
    have hll : l ^ (1 / 2 - h) * l ^ (-(1 / 2 - h)) = 1 := by
      rw [← Real.rpow_add hl, add_neg_cancel, Real.rpow_zero]
    linear_combination (y 2 * simScale h (y 2) (1 - s) ^ (-(1 / 2 - h))) * hll
  have hJ : azVec y' = l ^ (1 / 2 : ℝ) • azVec y := by
    unfold azVec
    rw [hy0, hy1, smul_add, smul_smul, smul_smul, mul_neg]
  refine ⟨?_, ?_, ?_⟩
  · unfold bgAn
    rw [hQ, hX, hE, hJ, Real.mul_rpow hl.le hQ0, smul_smul, smul_smul]
    congr 1
    have hA : l ^ (-h + 2 * (n : ℝ) * h) = l ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * l ^ (1 / 2 : ℝ) := by
      rw [← Real.rpow_add hl]; congr 1; ring
    rw [hA]
    generalize l ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) = A
    generalize l ^ (1 / 2 : ℝ) = B
    generalize simScale h (y 2) (1 - s) ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) = C
    ring
  · unfold bgBn
    rw [hQ, hX, hE, hJ, Real.mul_rpow hl.le hQ0, smul_smul, smul_smul]
    congr 1
    have hB : l ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) = l ^ (-(1 + h) + 2 * (n : ℝ) * h) * l ^ (1 / 2 : ℝ) := by
      rw [← Real.rpow_add hl]; congr 1; ring
    rw [hB]
    generalize l ^ (-(1 + h) + 2 * (n : ℝ) * h) = A
    generalize l ^ (1 / 2 : ℝ) = B
    generalize simScale h (y 2) (1 - s) ^ (-(1 + h) + 2 * (n : ℝ) * h) = C
    ring
  · unfold bgPn
    rw [hQ, hX, hE, Real.mul_rpow hl.le hQ0]
    ring

theorem dil_clm_exists : ∀ (h l : ℝ), 0 < h → h < 1 / 2 → 1 ≤ l → ∃ Λ : ℝ³ × ℝ →L[ℝ] ℝ³ × ℝ, ‖Λ‖ ≤ l ∧ ∀ (y : ℝ³) (s : ℝ), (Λ (y, s)).1 0 = l ^ (1 / 2 : ℝ) * y 0 ∧ (Λ (y, s)).1 1 = l ^ (1 / 2 : ℝ) * y 1 ∧ (Λ (y, s)).1 2 = l ^ (1 / 2 - h) * y 2 ∧ (Λ (y, s)).2 = l * s :=
by
  intro h l hh0 hh1 hl
  have hl0 : 0 ≤ l := by linarith
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = l ^ (1 / 2 : ℝ) := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : ℝ, b = l ^ (1 / 2 - h) := ⟨_, rfl⟩
  have ha0 : 0 ≤ a := by rw [ha]; exact Real.rpow_nonneg hl0 _
  have hb0 : 0 ≤ b := by rw [hb]; exact Real.rpow_nonneg hl0 _
  have hal : a ≤ l := by rw [ha]; exact Real.rpow_le_self_of_one_le hl (by norm_num)
  have hbl : b ≤ l := by rw [hb]; exact Real.rpow_le_self_of_one_le hl (by linarith)
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ³ →L[ℝ] ℝ³, D = a • ContinuousLinearMap.id ℝ ℝ³ +
      (EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).smulRight
        ((b - a) • EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) := ⟨_, rfl⟩
  have hD : ∀ y : ℝ³, D y 0 = a * y 0 ∧ D y 1 = a * y 1 ∧ D y 2 = b * y 2 := by
    intro y
    subst hDdef
    refine ⟨?_, ?_, ?_⟩ <;> simp <;> ring
  have hDn : ∀ y : ℝ³, ‖D y‖ ≤ l * ‖y‖ := by
    intro y
    obtain ⟨h0, h1, h2⟩ := hD y
    have e1 := EuclideanSpace.real_norm_sq_eq (D y)
    have e2 := EuclideanSpace.real_norm_sq_eq y
    rw [Fin.sum_univ_three] at e1 e2
    have hsq : ‖D y‖ ^ 2 ≤ (l * ‖y‖) ^ 2 := by
      rw [e1, mul_pow, e2]
      have h0' : (D y).ofLp 0 = a * y.ofLp 0 := h0
      have h1' : (D y).ofLp 1 = a * y.ofLp 1 := h1
      have h2' : (D y).ofLp 2 = b * y.ofLp 2 := h2
      rw [h0', h1', h2']
      have ea : a ^ 2 ≤ l ^ 2 := pow_le_pow_left₀ ha0 hal 2
      have eb : b ^ 2 ≤ l ^ 2 := pow_le_pow_left₀ hb0 hbl 2
      have k0 := mul_le_mul_of_nonneg_right ea (sq_nonneg (y.ofLp 0))
      have k1 := mul_le_mul_of_nonneg_right ea (sq_nonneg (y.ofLp 1))
      have k2 := mul_le_mul_of_nonneg_right eb (sq_nonneg (y.ofLp 2))
      nlinarith
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) (mul_nonneg hl0 (norm_nonneg _))
      two_ne_zero).mp hsq
  refine ⟨(D.comp (ContinuousLinearMap.fst ℝ ℝ³ ℝ)).prod (l • ContinuousLinearMap.snd ℝ ℝ³ ℝ),
    ?_, ?_⟩
  · refine ContinuousLinearMap.opNorm_le_bound _ hl0 ?_
    rintro ⟨y, s⟩
    simp only [ContinuousLinearMap.prod_apply, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.coe_fst', ContinuousLinearMap.smul_apply, ContinuousLinearMap.coe_snd',
      Prod.norm_def]
    rw [norm_smul, Real.norm_of_nonneg hl0]
    apply max_le
    · exact (hDn y).trans (mul_le_mul_of_nonneg_left (le_max_left _ _) hl0)
    · exact mul_le_mul_of_nonneg_left (le_max_right _ _) hl0
  · intro y s
    obtain ⟨h0, h1, h2⟩ := hD y
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [← ha]; exact h0
    · rw [← ha]; exact h1
    · rw [← hb]; exact h2
    · simp [smul_eq_mul]

theorem affine_rescale_deriv_bound : ∀ {E V : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup V] [NormedSpace ℝ V] (F : E → V) (Λ : E →L[ℝ] E) (c : E) (U : Set E) (a b : ℝ) (m : ℕ), IsOpen U → ContDiffOn ℝ ∞ F U → (∀ w ∈ U, Λ w + c ∈ U) → (∀ w ∈ U, F (Λ w + c) = a • F w) → ‖Λ‖ ≤ b → ∀ w ∈ U, |a| * ‖iteratedFDeriv ℝ m F w‖ ≤ b ^ m * ‖iteratedFDeriv ℝ m F (Λ w + c)‖ :=
by
  intro E V _ _ _ _ F Λ c U a b m hU hF hmaps hid hΛ w hw
  have hm : ((m : ℕ∞) : WithTop ℕ∞) ≤ (∞ : WithTop ℕ∞) := by exact_mod_cast le_top
  have hU₁ : IsOpen ((fun z : E => z + c) ⁻¹' U) :=
    hU.preimage (continuous_id.add continuous_const)
  have hU₂ : IsOpen (Λ ⁻¹' ((fun z : E => z + c) ⁻¹' U)) := hU₁.preimage Λ.continuous
  have hΛw : Λ w ∈ (fun z : E => z + c) ⁻¹' U := hmaps w hw
  have hF₁ : ContDiffOn ℝ ∞ (fun z => F (z + c)) ((fun z : E => z + c) ⁻¹' U) :=
    hF.comp (contDiff_id.add contDiff_const).contDiffOn (fun z hz => hz)
  have hchain := Λ.iteratedFDerivWithin_comp_right hF₁ hU₁.uniqueDiffOn hU₂.uniqueDiffOn hΛw hm
  rw [iteratedFDerivWithin_of_isOpen m hU₂ (show w ∈ Λ ⁻¹' ((fun z : E => z + c) ⁻¹' U) from hΛw),
    iteratedFDerivWithin_of_isOpen m hU₁ hΛw, iteratedFDeriv_comp_add_right] at hchain
  have hev : ((fun z => F (z + c)) ∘ Λ) =ᶠ[nhds w] (fun z => a • F z) :=
    Filter.eventuallyEq_of_mem (hU.mem_nhds hw) (fun z hz => hid z hz)
  have hloc := (hev.iteratedFDeriv ℝ m).eq_of_nhds
  rw [iteratedFDeriv_const_smul_apply' ((hF.contDiffAt (hU.mem_nhds hw)).of_le hm)] at hloc
  rw [hloc] at hchain
  have hnorm := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
    (iteratedFDeriv ℝ m F (Λ w + c)) (fun _ : Fin m => Λ)
  rw [← hchain, norm_smul, Real.norm_eq_abs] at hnorm
  simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin] at hnorm
  calc |a| * ‖iteratedFDeriv ℝ m F w‖ ≤ ‖iteratedFDeriv ℝ m F (Λ w + c)‖ * ‖Λ‖ ^ m := hnorm
    _ ≤ ‖iteratedFDeriv ℝ m F (Λ w + c)‖ * b ^ m :=
      mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg Λ) hΛ m) (norm_nonneg _)
    _ = b ^ m * ‖iteratedFDeriv ℝ m F (Λ w + c)‖ := mul_comm _ _

theorem axis_extension_bound : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : ℝ³ × ℝ → V) (m : ℕ) (P : ℝ → ℝ → Prop) (B R : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ f {w : ℝ³ × ℝ | w.2 < 1} → (∀ (x : ℝ³) (t : ℝ), t < 1 → P (x 2) t → 0 < x 0 ^ 2 + x 1 ^ 2 → x 0 ^ 2 + x 1 ^ 2 ≤ R (x 2) t → ‖iteratedFDeriv ℝ m f (x, t)‖ ≤ B (x 2) t) → ∀ (x : ℝ³) (t : ℝ), t < 1 → P (x 2) t → 0 < R (x 2) t → x 0 ^ 2 + x 1 ^ 2 ≤ R (x 2) t → ‖iteratedFDeriv ℝ m f (x, t)‖ ≤ B (x 2) t :=
by
  intro V _ _ f m P B R hf hoff x t ht hP hR hr
  by_cases hpos : 0 < x 0 ^ 2 + x 1 ^ 2
  · exact hoff x t ht hP hpos hr
  have hs : x 0 ^ 2 + x 1 ^ 2 = 0 := le_antisymm (not_lt.mp hpos) (by positivity)
  have hx0 : x 0 = 0 := by
    have h0 : x 0 ^ 2 = 0 := by nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]
    exact (pow_eq_zero_iff two_ne_zero).mp h0
  have hx1 : x 1 = 0 := by
    have h0 : x 1 ^ 2 = 0 := by nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]
    exact (pow_eq_zero_iff two_ne_zero).mp h0
  set e : ℝ³ := EuclideanSpace.single (0 : Fin 3) (1 : ℝ) with he
  have hy0 : ∀ ε : ℝ, (x + ε • e) 0 = ε := by intro ε; simp [he, hx0]
  have hy1 : ∀ ε : ℝ, (x + ε • e) 1 = 0 := by intro ε; simp [he, hx1]
  have hy2 : ∀ ε : ℝ, (x + ε • e) 2 = x 2 := by intro ε; simp [he]
  have hbound : ∀ ε ∈ Set.Ioo (0 : ℝ) (min 1 (R (x 2) t)),
      ‖iteratedFDeriv ℝ m f (x + ε • e, t)‖ ≤ B (x 2) t := by
    rintro ε ⟨hε0, hε1⟩
    have h1 : ε < 1 := lt_of_lt_of_le hε1 (min_le_left _ _)
    have h2 : ε < R (x 2) t := lt_of_lt_of_le hε1 (min_le_right _ _)
    have hb := hoff (x + ε • e) t ht (by rw [hy2]; exact hP)
      (by rw [hy0, hy1]; nlinarith [mul_pos hε0 hε0])
      (by rw [hy0, hy1, hy2]; nlinarith [mul_pos hε0 hε0])
    rwa [hy2] at hb
  have hU : {w : ℝ³ × ℝ | w.2 < 1} ∈ nhds (x, t) :=
    (isOpen_lt continuous_snd continuous_const).mem_nhds ht
  have hcont : ContinuousAt (iteratedFDeriv ℝ m f) (x, t) :=
    (hf.contDiffAt hU).continuousAt_iteratedFDeriv (by exact_mod_cast le_top)
  have hγ : Continuous (fun ε : ℝ => (x + ε • e, t)) := by fun_prop
  have hγ0 : (fun ε : ℝ => (x + ε • e, t)) 0 = (x, t) := by simp
  have hφ : Filter.Tendsto (fun ε : ℝ => ‖iteratedFDeriv ℝ m f (x + ε • e, t)‖)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds ‖iteratedFDeriv ℝ m f (x, t)‖) := by
    have h1 : ContinuousAt (fun ε : ℝ => iteratedFDeriv ℝ m f (x + ε • e, t)) 0 :=
      ContinuousAt.comp_of_eq hcont hγ.continuousAt hγ0
    have h2 := h1.norm.tendsto
    simp only [zero_smul, add_zero] at h2
    exact h2.mono_left nhdsWithin_le_nhds
  apply le_of_tendsto hφ
  filter_upwards [Ioo_mem_nhdsGT (lt_min one_pos hR)] with ε hε
  exact hbound ε hε

theorem bg_field_vanish_far : ∀ (h Xp : ℝ) (n : ℕ) (g : ℝ → ℝ → ℝ), SimScaleProps h → 0 < h → h < 1 / 2 → (∀ X η : ℝ, Xp ≤ X → g X η = 0) → ∀ (m : ℕ) (x : ℝ³) (t : ℝ), t < 1 → Xp < simX h x t → iteratedFDeriv ℝ m (↿(bgAn h n g)) (x, t) = 0 ∧ iteratedFDeriv ℝ m (↿(bgBn h n g)) (x, t) = 0 ∧ iteratedFDeriv ℝ m (↿(bgPn h n g)) (x, t) = 0 :=
by
  intro h Xp n g hS hh0 hh1 hvan m x t ht hX
  have hQc : ContinuousAt (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) (x, t) := by
    have hc4 : ContinuousAt (fun p : ℝ × ℝ => simScale h p.1 p.2) (x 2, 1 - t) :=
      hS.2.2.2.1.continuousOn.continuousAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds
        ⟨mem_univ _, show (0 : ℝ) < 1 - t by linarith⟩)
    have hφ : Continuous (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)) :=
      ((EuclideanSpace.proj (2 : Fin 3)).continuous.comp continuous_fst).prodMk
        (continuous_const.sub continuous_snd)
    exact hc4.comp_of_eq (f := fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)) hφ.continuousAt rfl
  have hN : Continuous (fun w : ℝ³ × ℝ => w.1 0 ^ 2 + w.1 1 ^ 2) := by
    have h0 : Continuous (fun w : ℝ³ × ℝ => w.1 0) :=
      (EuclideanSpace.proj (0 : Fin 3)).continuous.comp continuous_fst
    have h1 : Continuous (fun w : ℝ³ × ℝ => w.1 1) :=
      (EuclideanSpace.proj (1 : Fin 3)).continuous.comp continuous_fst
    exact (h0.pow 2).add (h1.pow 2)
  have hXc : ContinuousAt (fun w : ℝ³ × ℝ => simX h w.1 w.2) (x, t) := by
    have hD : ContinuousAt (fun w : ℝ³ × ℝ => 2 * simScale h (w.1 2) (1 - w.2)) (x, t) :=
      continuousAt_const.mul hQc
    have hne : 2 * simScale h (x 2) (1 - t) ≠ 0 := by
      have := (hS.1 (x 2) (1 - t) (by linarith)).1
      positivity
    have := hN.continuousAt.div hD hne
    unfold simX
    exact this
  have hev : ∀ᶠ w in nhds ((x, t) : ℝ³ × ℝ), Xp < simX h w.1 w.2 :=
    continuousAt_const.eventually_lt hXc hX
  have hg : ∀ᶠ w in nhds ((x, t) : ℝ³ × ℝ), g (simX h w.1 w.2) (simEta h w.1 w.2) = 0 :=
    hev.mono fun w hw => hvan _ _ hw.le
  have hA : (↿(bgAn h n g)) =ᶠ[nhds ((x, t) : ℝ³ × ℝ)] fun _ => (0 : ℝ³) :=
    hg.mono fun w hw => by
      show bgAn h n g w.1 w.2 = 0
      unfold bgAn
      rw [hw, mul_zero, zero_smul]
  have hB : (↿(bgBn h n g)) =ᶠ[nhds ((x, t) : ℝ³ × ℝ)] fun _ => (0 : ℝ³) :=
    hg.mono fun w hw => by
      show bgBn h n g w.1 w.2 = 0
      unfold bgBn
      rw [hw, mul_zero, zero_smul]
  have hP : (↿(bgPn h n g)) =ᶠ[nhds ((x, t) : ℝ³ × ℝ)] fun _ => (0 : ℝ) :=
    hg.mono fun w hw => by
      show bgPn h n g w.1 w.2 = 0
      unfold bgPn
      rw [hw, mul_zero]
  refine ⟨?_, ?_, ?_⟩
  · rw [(hA.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
    rfl
  · rw [(hB.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
    rfl
  · rw [(hP.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
    rfl

theorem bg_field_offaxis_wt_bounds : ∀ (h M : ℝ) (n : ℕ) (g : ℝ → ℝ → ℝ), SimScaleProps h → 0 < h → h < 1 / 2 → 0 < M → ContDiffOn ℝ ∞ (↿g) (Ioi 0 ×ˢ Ioo (-1) 1) → (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿g) (X, η)‖ ≤ C) → ∀ m : ℕ, ∃ C K : ℝ, ∀ (x : ℝ³) (t : ℝ), t < 1 → simScale h (x 2) (1 - t) ≤ 1 → 0 < x 0 ^ 2 + x 1 ^ 2 → x 0 ^ 2 + x 1 ^ 2 ≤ M * simScale h (x 2) (1 - t) → ‖iteratedFDeriv ℝ m (↿(bgAn h n g)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧ ‖iteratedFDeriv ℝ m (↿(bgBn h n g)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧ ‖iteratedFDeriv ℝ m (↿(bgPn h n g)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) :=
by
  intro h M n g hS h0 hh2 hM hg hgb m

  obtain ⟨Ω, hΩ⟩ : ∃ Ω : Set (ℝ³ × ℝ), Ω = {w : ℝ³ × ℝ | w.2 < 1} ∩
      {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2} := ⟨_, rfl⟩
  obtain ⟨S, hSd⟩ : ∃ S : Set (ℝ³ × ℝ), S = {w : ℝ³ × ℝ | w.2 < 1 ∧
      0 < w.1 0 ^ 2 + w.1 1 ^ 2 ∧
      simScale h (w.1 2) (1 - w.2) ≤ 1 ∧
      w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M * simScale h (w.1 2) (1 - w.2)} := ⟨_, rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : ℝ³ × ℝ → ℝ, Q = fun w => simScale h (w.1 2) (1 - w.2) := ⟨_, rfl⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ³ × ℝ → ℝ × ℝ, Φ = fun z => (simX h z.1 z.2, simEta h z.1 z.2) :=
    ⟨_, rfl⟩
  obtain ⟨Jf, hJf⟩ : ∃ Jf : ℝ³ × ℝ → ℝ³, Jf = fun z : ℝ³ × ℝ =>
      -(z.1 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        z.1 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ) := ⟨_, rfl⟩
  have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => z.1 i) := fun i =>
    ((EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).comp (ContinuousLinearMap.fst ℝ ℝ³ ℝ)).contDiff
  have hr2c : Continuous (fun w : ℝ³ × ℝ => w.1 0 ^ 2 + w.1 1 ^ 2) :=
    ((hc 0).continuous.pow 2).add ((hc 1).continuous.pow 2)
  have hΩo : IsOpen Ω := by
    rw [hΩ]
    exact (isOpen_lt continuous_snd continuous_const).inter (isOpen_lt continuous_const hr2c)
  have hTo : IsOpen (Ioi (0 : ℝ) ×ˢ Ioo (-1 : ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hmemS : ∀ w : ℝ³ × ℝ, w ∈ S ↔ (w.2 < 1 ∧ 0 < w.1 0 ^ 2 + w.1 1 ^ 2 ∧
      simScale h (w.1 2) (1 - w.2) ≤ 1 ∧
      w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M * simScale h (w.1 2) (1 - w.2)) := by
    intro w; rw [hSd]; rfl
  have hmemΩ : ∀ w : ℝ³ × ℝ, w ∈ Ω ↔ (w.2 < 1 ∧ 0 < w.1 0 ^ 2 + w.1 1 ^ 2) := by
    intro w; rw [hΩ]; rfl
  have hΩsub : Ω ⊆ {w : ℝ³ × ℝ | w.2 < 1} := fun w hw => ((hmemΩ w).1 hw).1
  have hSΩ : S ⊆ Ω := by
    intro w hw
    obtain ⟨h1, h2, -⟩ := (hmemS w).1 hw
    exact (hmemΩ w).2 ⟨h1, h2⟩
  have hreg := bg_interior_region_facts h M hS h0 hh2 hM
  have hρ : ∀ w ∈ S, 0 < Q w ∧ Q w ≤ 1 := by
    intro w hw
    obtain ⟨h1, -, h2, -⟩ := (hmemS w).1 hw
    rw [hQ]
    exact ⟨(hreg w h1).1.1, h2⟩
  have hmaps : MapsTo Φ Ω (Ioi (0 : ℝ) ×ˢ Ioo (-1 : ℝ) 1) := by
    intro w hw
    obtain ⟨h1, hr⟩ := (hmemΩ w).1 hw
    obtain ⟨⟨hq, -, he1, he2⟩, -⟩ := hreg w h1
    have hX : 0 < simX h w.1 w.2 := by
      unfold simX
      exact div_pos hr (mul_pos two_pos hq)
    rw [hΦ]
    exact ⟨mem_Ioi.mpr hX, he1, he2⟩

  have hconv : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F),
      (∀ k : ℕ, ∃ C K : ℝ, ∀ w : ℝ³ × ℝ, w.2 < 1 → simScale h (w.1 2) (1 - w.2) ≤ 1 →
        w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M * simScale h (w.1 2) (1 - w.2) →
        ‖iteratedFDeriv ℝ k f w‖ ≤ C * simScale h (w.1 2) (1 - w.2) ^ (-K)) →
      ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k f w‖ ≤ C * Q w ^ (-K) := by
    intro F _ _ f hf k
    obtain ⟨C, K, hCK⟩ := hf k
    refine ⟨C, K, fun w hw => ?_⟩
    obtain ⟨h1, -, h2, h3⟩ := (hmemS w).1 hw
    rw [hQ]
    exact hCK w h1 h2 h3

  obtain ⟨hΦs, hΦb⟩ := simXEta_wt_bound h M hS h0 hh2 hM
  have hΦs' : ContDiffOn ℝ ∞ Φ Ω := by rw [hΦ]; exact hΦs.mono hΩsub
  have hΦb' : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k Φ w‖ ≤ C * Q w ^ (-K) := by
    rw [hΦ]; exact hconv _ hΦb
  have houter : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S,
      ‖iteratedFDeriv ℝ k (↿g) (Φ w)‖ ≤ C * Q w ^ (-K) := by
    intro k
    obtain ⟨C, hC⟩ := hgb k
    refine ⟨C, 0, fun w hw => ?_⟩
    have hT := hmaps (hSΩ hw)
    rw [hΦ] at hT
    obtain ⟨hX0, he1, he2⟩ := hT
    rw [neg_zero, Real.rpow_zero, mul_one, hΦ]
    exact hC _ _ hX0 he1 he2
  obtain ⟨hGs, hGb⟩ := wt_comp_bound (↿g) Φ Q Ω S (Ioi (0 : ℝ) ×ˢ Ioo (-1 : ℝ) 1) hΩo hTo hSΩ
    hmaps hρ hg hΦs' houter hΦb'

  have hpow : ∀ p : ℝ, ContDiffOn ℝ ∞ (fun z => Q z ^ p) Ω ∧
      ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k (fun z => Q z ^ p) w‖ ≤ C * Q w ^ (-K) := by
    intro p
    obtain ⟨hs, hb⟩ := simScale_rpow_wt_bound h p hS h0 hh2
    refine ⟨by rw [hQ]; exact hs.mono hΩsub, fun k => ?_⟩
    obtain ⟨C, K, hCK⟩ := hb k
    refine ⟨C, K, fun w hw => ?_⟩
    obtain ⟨h1, -, h2, -⟩ := (hmemS w).1 hw
    rw [hQ]
    exact hCK w h1 h2

  have hJs : ContDiff ℝ ∞ Jf := by
    rw [hJf]
    exact ((hc 1).neg.smul contDiff_const).add ((hc 0).smul contDiff_const)
  have hJb : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k Jf w‖ ≤ C * Q w ^ (-K) := by
    intro k
    obtain ⟨C, hC⟩ := ball_iteratedFDeriv_bound Jf hJs (M + 1) k
    refine ⟨C, 0, fun w hw => ?_⟩
    obtain ⟨h1, -, h2, h3⟩ := (hmemS w).1 hw
    obtain ⟨hn, -⟩ := (hreg w h1).2 h2 h3
    rw [neg_zero, Real.rpow_zero, mul_one]
    exact hC w hn

  obtain ⟨hPs, hPb⟩ := wt_bilinear_bound (ContinuousLinearMap.mul ℝ ℝ)
    (fun z => Q z ^ (-(1 + 2 * h) + 2 * (n : ℝ) * h)) (↿g ∘ Φ) Q Ω S hΩo hSΩ hρ
    (hpow _).1 hGs (hpow _).2 hGb
  obtain ⟨hsBs, hsBb⟩ := wt_bilinear_bound (ContinuousLinearMap.mul ℝ ℝ)
    (fun z => Q z ^ (-(1 + h) + 2 * (n : ℝ) * h)) (↿g ∘ Φ) Q Ω S hΩo hSΩ hρ
    (hpow _).1 hGs (hpow _).2 hGb
  obtain ⟨-, hBb⟩ := wt_bilinear_bound (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
    _ Jf Q Ω S hΩo hSΩ hρ hsBs hJs.contDiffOn hsBb hJb
  obtain ⟨hsAs, hsAb⟩ := wt_bilinear_bound ((1 / 2 : ℝ) • ContinuousLinearMap.mul ℝ ℝ)
    (fun z => Q z ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h)) (↿g ∘ Φ) Q Ω S hΩo hSΩ hρ
    (hpow _).1 hGs (hpow _).2 hGb
  obtain ⟨-, hAb⟩ := wt_bilinear_bound (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
    _ Jf Q Ω S hΩo hSΩ hρ hsAs hJs.contDiffOn hsAb hJb

  have eP : (↿(bgPn h n g)) = fun z => ContinuousLinearMap.mul ℝ ℝ
      (Q z ^ (-(1 + 2 * h) + 2 * (n : ℝ) * h)) ((↿g ∘ Φ) z) := by
    funext z
    rw [ContinuousLinearMap.mul_apply', hQ, hΦ]
    rfl
  have eB : (↿(bgBn h n g)) = fun z => (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
      (ContinuousLinearMap.mul ℝ ℝ (Q z ^ (-(1 + h) + 2 * (n : ℝ) * h)) ((↿g ∘ Φ) z)) (Jf z) := by
    funext z
    rw [ContinuousLinearMap.lsmul_apply, ContinuousLinearMap.mul_apply', hQ, hΦ, hJf]
    rfl
  have eA : (↿(bgAn h n g)) = fun z => (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
      (((1 / 2 : ℝ) • ContinuousLinearMap.mul ℝ ℝ) (Q z ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h))
        ((↿g ∘ Φ) z)) (Jf z) := by
    funext z
    rw [ContinuousLinearMap.lsmul_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smul_apply, ContinuousLinearMap.mul_apply', smul_eq_mul, hQ, hΦ, hJf,
      ← mul_assoc]
    rfl

  obtain ⟨CA, KA, hA⟩ := hAb m
  obtain ⟨CB, KB, hB⟩ := hBb m
  obtain ⟨CP, KP, hP⟩ := hPb m
  refine ⟨|CA| + |CB| + |CP|, max (max KA KB) KP, ?_⟩
  intro x t ht hq1 hr0 hr
  have hw : ((x, t) : ℝ³ × ℝ) ∈ S := (hmemS (x, t)).2 ⟨ht, hr0, hq1, hr⟩
  have hQw : Q (x, t) = simScale h (x 2) (1 - t) := by rw [hQ]
  have hq0 : 0 < simScale h (x 2) (1 - t) := by rw [← hQw]; exact (hρ _ hw).1
  have hqK0 : 0 ≤ simScale h (x 2) (1 - t) ^ (-max (max KA KB) KP) :=
    (Real.rpow_pos_of_pos hq0 _).le
  have hgen : ∀ Ci Ki : ℝ, Ki ≤ max (max KA KB) KP → |Ci| ≤ |CA| + |CB| + |CP| →
      Ci * Q (x, t) ^ (-Ki) ≤
        (|CA| + |CB| + |CP|) * simScale h (x 2) (1 - t) ^ (-max (max KA KB) KP) := by
    intro Ci Ki hKi hCi
    rw [hQw]
    calc Ci * simScale h (x 2) (1 - t) ^ (-Ki)
        ≤ |Ci| * simScale h (x 2) (1 - t) ^ (-Ki) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_pos_of_pos hq0 _).le
      _ ≤ |Ci| * simScale h (x 2) (1 - t) ^ (-max (max KA KB) KP) :=
          mul_le_mul_of_nonneg_left
            (Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (by linarith)) (abs_nonneg _)
      _ ≤ (|CA| + |CB| + |CP|) * simScale h (x 2) (1 - t) ^ (-max (max KA KB) KP) :=
          mul_le_mul_of_nonneg_right hCi hqK0
  have hKA : KA ≤ max (max KA KB) KP := (le_max_left KA KB).trans (le_max_left _ _)
  have hKB : KB ≤ max (max KA KB) KP := (le_max_right KA KB).trans (le_max_left _ _)
  have hKP : KP ≤ max (max KA KB) KP := le_max_right _ _
  refine ⟨?_, ?_, ?_⟩
  · rw [eA]
    exact (hA _ hw).trans (hgen CA KA hKA (by linarith [abs_nonneg CB, abs_nonneg CP]))
  · rw [eB]
    exact (hB _ hw).trans (hgen CB KB hKB (by linarith [abs_nonneg CA, abs_nonneg CP]))
  · rw [eP]
    exact (hP _ hw).trans (hgen CP KP hKP (by linarith [abs_nonneg CA, abs_nonneg CB]))

theorem bg_field_scaled_bounds : ∀ (h Xp : ℝ) (n : ℕ) (g : ℝ → ℝ → ℝ), SimScaleProps h → 0 < h → h < 1 / 2 → ContDiffOn ℝ ∞ (↿g) (Ici 0 ×ˢ Ioo (-1) 1) → (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿g) (X, η)‖ ≤ C) → (∀ X η : ℝ, Xp ≤ X → g X η = 0) → ∀ m : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ‖iteratedFDeriv ℝ m (↿(bgAn h n g)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (2 * h * (n : ℝ) - ((m : ℝ) + 2)) ∧ ‖iteratedFDeriv ℝ m (↿(bgBn h n g)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (2 * h * (n : ℝ) - ((m : ℝ) + 2)) ∧ ‖iteratedFDeriv ℝ m (↿(bgPn h n g)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (2 * h * (n : ℝ) - ((m : ℝ) + 2)) :=
by
  intro h Xp n g hS hh0 hh1 hg hgb hvan m
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = 2 * |Xp| + 2 := ⟨_, rfl⟩
  have hM : 0 < M := by rw [hMdef]; positivity
  have hgT : ContDiffOn ℝ ∞ (↿g) (Ioi 0 ×ˢ Ioo (-1) 1) :=
    hg.mono (Set.prod_mono Set.Ioi_subset_Ici_self subset_rfl)
  obtain ⟨C₁, K, hC₁⟩ := bg_field_offaxis_wt_bounds h M n g hS hh0 hh1 hM hgT hgb m
  obtain ⟨hsmA, hsmB, hsmP, -⟩ := bg_field_smooth_div h n g hS hg

  have hslice : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : ℝ³ × ℝ → V),
      ContDiffOn ℝ ∞ f {w : ℝ³ × ℝ | w.2 < 1} →
      (∀ (x : ℝ³) (t : ℝ), t < 1 → simScale h (x 2) (1 - t) ≤ 1 → 0 < x 0 ^ 2 + x 1 ^ 2 →
        x 0 ^ 2 + x 1 ^ 2 ≤ M * simScale h (x 2) (1 - t) →
        ‖iteratedFDeriv ℝ m f (x, t)‖ ≤ C₁ * simScale h (x 2) (1 - t) ^ (-K)) →
      (∀ (x : ℝ³) (t : ℝ), t < 1 → Xp < simX h x t → iteratedFDeriv ℝ m f (x, t) = 0) →
      ∀ (y : ℝ³) (s : ℝ), s < 1 → simScale h (y 2) (1 - s) = 1 →
        ‖iteratedFDeriv ℝ m f (y, s)‖ ≤ |C₁| := by
    intro V _ _ f hf hoff hz y s hs hq
    by_cases hr : y 0 ^ 2 + y 1 ^ 2 ≤ M
    · have hb := axis_extension_bound f m (fun z s => simScale h z (1 - s) ≤ 1)
        (fun z s => C₁ * simScale h z (1 - s) ^ (-K)) (fun z s => M * simScale h z (1 - s)) hf
        (fun x t ht hP hr0 hrR => hoff x t ht hP hr0 hrR) y s hs
        (show simScale h (y 2) (1 - s) ≤ 1 by rw [hq])
        (show 0 < M * simScale h (y 2) (1 - s) by rw [hq]; linarith)
        (show y 0 ^ 2 + y 1 ^ 2 ≤ M * simScale h (y 2) (1 - s) by rw [hq]; linarith)
      have hb' : ‖iteratedFDeriv ℝ m f (y, s)‖ ≤ C₁ * simScale h (y 2) (1 - s) ^ (-K) := hb
      rw [hq, Real.one_rpow, mul_one] at hb'
      exact hb'.trans (le_abs_self _)
    · push_neg at hr
      have hX : Xp < simX h y s := by
        unfold simX
        rw [hq, lt_div_iff₀ (by norm_num : (0:ℝ) < 2 * 1)]
        have := le_abs_self Xp
        linarith
      rw [hz y s hs hX, norm_zero]
      exact abs_nonneg _

  have hU : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  have hscale : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : ℝ³ × ℝ → V) (e : ℝ),
      ContDiffOn ℝ ∞ f {w : ℝ³ × ℝ | w.2 < 1} →
      (∀ (l : ℝ) (y y' : ℝ³) (s : ℝ), 0 < l → s < 1 → y' 0 = l ^ (1 / 2 : ℝ) * y 0 →
        y' 1 = l ^ (1 / 2 : ℝ) * y 1 → y' 2 = l ^ (1 / 2 - h) * y 2 →
        f (y', 1 - l * (1 - s)) = l ^ e • f (y, s)) →
      (∀ (y : ℝ³) (s : ℝ), s < 1 → simScale h (y 2) (1 - s) = 1 →
        ‖iteratedFDeriv ℝ m f (y, s)‖ ≤ |C₁|) →
      2 * h * (n : ℝ) - ((m : ℝ) + 2) ≤ e - m →
      ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
        ‖iteratedFDeriv ℝ m f (x, t)‖ ≤
          |C₁| * simScale h (x 2) (1 - t) ^ (2 * h * (n : ℝ) - ((m : ℝ) + 2)) := by
    intro V _ _ f e hf hdil hsl he x t hxt
    have ht : t < 1 := hxt.1
    have hq1' : simScale h (x 2) (1 - t) < 1 := hxt.2
    obtain ⟨q, hqdef⟩ : ∃ q : ℝ, q = simScale h (x 2) (1 - t) := ⟨_, rfl⟩
    rw [← hqdef] at hq1' ⊢
    have hq0 : 0 < q := by rw [hqdef]; exact (hS.1 (x 2) (1 - t) (by linarith)).1
    obtain ⟨l, hldef⟩ : ∃ l : ℝ, l = q⁻¹ := ⟨_, rfl⟩
    have hl0 : 0 < l := by rw [hldef]; exact inv_pos.mpr hq0
    have hl1 : 1 ≤ l := by rw [hldef]; exact (one_le_inv₀ hq0).mpr hq1'.le
    obtain ⟨Λ, hΛn, hΛ⟩ := dil_clm_exists h l hh0 hh1 hl1
    obtain ⟨c, hc⟩ : ∃ c : ℝ³ × ℝ, c = ((0 : ℝ³), 1 - l) := ⟨_, rfl⟩
    have hc1 : c.1 = 0 := by rw [hc]
    have hc2 : c.2 = 1 - l := by rw [hc]
    have hsnd : ∀ (y : ℝ³) (s : ℝ), (Λ (y, s) + c).2 = 1 - l * (1 - s) := by
      intro y s
      rw [Prod.snd_add, (hΛ y s).2.2.2, hc2]
      ring
    have hmaps : ∀ w ∈ {w : ℝ³ × ℝ | w.2 < 1}, Λ w + c ∈ {w : ℝ³ × ℝ | w.2 < 1} := by
      rintro ⟨y, s⟩ hw
      have hw' : s < 1 := hw
      show (Λ (y, s) + c).2 < 1
      rw [hsnd y s]
      have : 0 < l * (1 - s) := mul_pos hl0 (by linarith)
      linarith
    have hid : ∀ w ∈ {w : ℝ³ × ℝ | w.2 < 1}, f (Λ w + c) = l ^ e • f w := by
      rintro ⟨y, s⟩ hw
      have hw' : s < 1 := hw
      obtain ⟨h0, h1, h2, -⟩ := hΛ y s
      have e1 : Λ (y, s) + c = ((Λ (y, s)).1, 1 - l * (1 - s)) := by
        refine Prod.ext ?_ ?_
        · rw [Prod.fst_add, hc1, add_zero]
        · exact hsnd y s
      rw [e1]
      exact hdil l y (Λ (y, s)).1 s hl0 hw' h0 h1 h2
    have key := affine_rescale_deriv_bound f Λ c {w : ℝ³ × ℝ | w.2 < 1} (l ^ e) l m hU hf hmaps
      hid hΛn (x, t) ht
    have hw1 : (Λ (x, t) + c).2 < 1 := hmaps (x, t) ht
    have hwq : simScale h ((Λ (x, t) + c).1 2) (1 - (Λ (x, t) + c).2) = 1 := by
      have a1 : (Λ (x, t) + c).1 2 = l ^ (1 / 2 - h) * x 2 := by
        rw [Prod.fst_add, hc1, add_zero, (hΛ x t).2.2.1]
      have a2 : 1 - (Λ (x, t) + c).2 = l * (1 - t) := by
        rw [hsnd x t]; ring
      rw [a1, a2, simScale_homog h l (x 2) (1 - t) hl0, ← hqdef, hldef, inv_mul_cancel₀ hq0.ne']
    have hb : ‖iteratedFDeriv ℝ m f (Λ (x, t) + c)‖ ≤ |C₁| := hsl _ _ hw1 hwq
    have hle : l ^ e * ‖iteratedFDeriv ℝ m f (x, t)‖ ≤ l ^ m * |C₁| := by
      have k2 := key
      rw [abs_of_pos (Real.rpow_pos_of_pos hl0 e)] at k2
      exact k2.trans (mul_le_mul_of_nonneg_left hb (pow_nonneg hl0.le m))
    have hqe : 0 < q ^ e := Real.rpow_pos_of_pos hq0 e
    have hqm : 0 < q ^ m := pow_pos hq0 m
    rw [hldef, Real.inv_rpow hq0.le, inv_pow] at hle
    have hle2 : q ^ m * ‖iteratedFDeriv ℝ m f (x, t)‖ ≤ q ^ e * |C₁| := by
      have e1 : q ^ e * q ^ m * ((q ^ e)⁻¹ * ‖iteratedFDeriv ℝ m f (x, t)‖) =
          q ^ m * ‖iteratedFDeriv ℝ m f (x, t)‖ := by
        field_simp
      have e2 : q ^ e * q ^ m * ((q ^ m)⁻¹ * |C₁|) = q ^ e * |C₁| := by
        field_simp
      rw [← e1, ← e2]
      exact mul_le_mul_of_nonneg_left hle (mul_pos hqe hqm).le
    have hle3 : ‖iteratedFDeriv ℝ m f (x, t)‖ ≤ |C₁| * q ^ (e - m) := by
      rw [Real.rpow_sub hq0, Real.rpow_natCast, mul_div_assoc', le_div_iff₀ hqm]
      linarith
    have hmono : q ^ (e - m) ≤ q ^ (2 * h * (n : ℝ) - ((m : ℝ) + 2)) :=
      Real.rpow_le_rpow_of_exponent_ge hq0 hq1'.le he
    exact hle3.trans (mul_le_mul_of_nonneg_left hmono (abs_nonneg _))
  refine ⟨|C₁|, fun x t hxt => ⟨?_, ?_, ?_⟩⟩
  · exact hscale (↿(bgAn h n g)) (-h + 2 * (n : ℝ) * h) hsmA
      (fun l y y' s hl hs h0 h1 h2 => (bg_field_dilation h l n g y y' s hl hs h0 h1 h2).1)
      (hslice _ hsmA (fun x t ht hq hr0 hrR => (hC₁ x t ht hq hr0 hrR).1)
        (fun x t ht hX => (bg_field_vanish_far h Xp n g hS hh0 hh1 hvan m x t ht hX).1))
      (by linarith) x t hxt
  · exact hscale (↿(bgBn h n g)) (-(1 / 2 + h) + 2 * (n : ℝ) * h) hsmB
      (fun l y y' s hl hs h0 h1 h2 => (bg_field_dilation h l n g y y' s hl hs h0 h1 h2).2.1)
      (hslice _ hsmB (fun x t ht hq hr0 hrR => (hC₁ x t ht hq hr0 hrR).2.1)
        (fun x t ht hX => (bg_field_vanish_far h Xp n g hS hh0 hh1 hvan m x t ht hX).2.1))
      (by linarith) x t hxt
  · exact hscale (↿(bgPn h n g)) (-(1 + 2 * h) + 2 * (n : ℝ) * h) hsmP
      (fun l y y' s hl hs h0 h1 h2 => by
        rw [smul_eq_mul]
        exact (bg_field_dilation h l n g y y' s hl hs h0 h1 h2).2.2)
      (hslice _ hsmP (fun x t ht hq hr0 hrR => (hC₁ x t ht hq hr0 hrR).2.2)
        (fun x t ht hX => (bg_field_vanish_far h Xp n g hS hh0 hh1 hvan m x t ht hX).2.2))
      (by linarith) x t hxt

theorem bg_curl_identities : ∀ (h : ℝ) (a : ℕ → ℝ) (S G Uc Vc : ℕ → ℝ → ℝ → ℝ), 0 < h → h < 1 / 2 → SimScaleProps h → (∀ j, 1 ≤ a j) → (∀ j, 2 * a j ≤ a (j + 1)) → (∀ n : ℕ, ContDiffOn ℝ ∞ (↿(bgAn h n (S n))) (simDomain h 1)) → (∀ (n : ℕ) (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → 0 < x 0 ^ 2 + x 1 ^ 2 → (curl3 (fun w => bgAn h n (S n) w t) x) 2 = simScale h (x 2) (1 - t) ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * Uc n (simX h x t) (simEta h x t) ∧ inner ℝ (curl3 (fun w => bgAn h n (S n) w t) x) (radVec x) = simScale h (x 2) (1 - t) ^ (2 * (n : ℝ) * h) * Vc n (simX h x t) (simEta h x t) ∧ inner ℝ (curl3 (fun w => bgAn h n (S n) w t) x) (azVec x) = (0 : ℝ)) → ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → 0 < x 0 ^ 2 + x 1 ^ 2 → inner ℝ (curl3 (fun w => cutSum h a (fun n => bgAn h n (S n)) w t) x + cutSum h a (fun n => bgBn h n (G n)) x t) (azVec x) = Real.sqrt (x 0 ^ 2 + x 1 ^ 2) * simScale h (x 2) (1 - t) ^ (-(1 / 2 + h)) * bgEb h a G (simScale h (x 2) (1 - t)) (simX h x t) (simEta h x t) ∧ (curl3 (fun w => cutSum h a (fun n => bgAn h n (S n)) w t) x + cutSum h a (fun n => bgBn h n (G n)) x t) 2 = simScale h (x 2) (1 - t) ^ (-(1 / 2 + h)) * bgSum h a Uc (simScale h (x 2) (1 - t)) (simX h x t) (simEta h x t) ∧ inner ℝ (curl3 (fun w => cutSum h a (fun n => bgAn h n (S n)) w t) x + cutSum h a (fun n => bgBn h n (G n)) x t) (radVec x) = bgVb h a S Vc (simScale h (x 2) (1 - t)) (simX h x t) (simEta h x t) :=
by
  intro h a S G Uc Vc hh0 hh1 hS ha1 ha2 hsmA hC x t hxt hr
  have ht : t < 1 := hxt.1
  have hτ : (0:ℝ) < 1 - t := by linarith
  obtain ⟨Q, hQ⟩ : ∃ Q, Q = simScale h (x 2) (1 - t) := ⟨_, rfl⟩
  have hQpos : 0 < Q := by rw [hQ]; exact (hS.1 (x 2) (1 - t) hτ).1
  have hQne : Q ≠ 0 := hQpos.ne'

  have hΩ : IsOpen (simDomain h 1) := by
    have hc : ContinuousOn (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} :=
      hS.2.2.2.1.continuousOn.comp
        (by fun_prop : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ))).continuousOn
        (fun w hw => ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by have : w.2 < 1 := hw; linarith⟩)
    exact hc.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  have hKd : ∀ n : ℕ, DifferentiableAt ℝ (fun y => bgAn h n (S n) y t) x := by
    intro n
    have h1 : ContDiffAt ℝ ∞ (↿(bgAn h n (S n))) (x, t) := (hsmA n).contDiffAt (hΩ.mem_nhds hxt)
    have h2 : ContDiffAt ℝ ∞ (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) x :=
      (contDiff_id.prodMk contDiff_const).contDiffAt
    exact (h1.comp x h2).differentiableAt (by simp)

  have hQd : DifferentiableAt ℝ (fun z => simScale h z (1 - t)) (x 2) := by
    have h1 : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale h w.1 w.2) (x 2, 1 - t) :=
      hS.2.2.2.1.contDiffAt (prod_mem_nhds Filter.univ_mem (Ioi_mem_nhds hτ))
    have h2 : ContDiffAt ℝ ∞ (fun z : ℝ => ((z, 1 - t) : ℝ × ℝ)) (x 2) :=
      (contDiff_id.prodMk contDiff_const).contDiffAt
    exact (h1.comp (x 2) h2).differentiableAt (by norm_num)
  obtain ⟨Q', hQh⟩ : ∃ Q', HasDerivAt (fun z => simScale h z (1 - t)) Q' (x 2) :=
    ⟨_, hQd.hasDerivAt⟩

  have hst : Differentiable ℝ Real.smoothTransition :=
    (Real.smoothTransition.contDiff (n := 1)).differentiable (by norm_num)
  have hΨdiff : Differentiable ℝ (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) := by fun_prop
  have hcut : ∀ c : ℝ, HasFDerivAt (fun y : ℝ³ => simCut h c y t)
      ((deriv (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) (c * Q) * (c * Q')) •
        (EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ)) x := by
    intro c
    have h1 : HasDerivAt (fun z => c * simScale h z (1 - t)) (c * Q') (x 2) := hQh.const_mul c
    have h2 : HasDerivAt (fun z => Real.smoothTransition (2 - 2 * (c * simScale h z (1 - t))))
        (deriv (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) (c * Q) * (c * Q')) (x 2) := by
      rw [hQ]
      exact (hΨdiff _).hasDerivAt.comp (x 2) h1
    exact HasDerivAt.comp_hasFDerivAt (f := fun y : ℝ³ => y 2)
      (h₂ := fun z => Real.smoothTransition (2 - 2 * (c * simScale h z (1 - t)))) x h2
      (EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).hasFDerivAt
  have hφd : ∀ c : ℝ, DifferentiableAt ℝ (fun y : ℝ³ => simCut h c y t) x :=
    fun c => (hcut c).differentiableAt
  have hφv : ∀ (c : ℝ) (v : ℝ³), fderiv ℝ (fun y : ℝ³ => simCut h c y t) x v =
      deriv (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) (c * Q) * (c * Q') * v 2 := by
    intro c v
    rw [(hcut c).fderiv]
    simp

  have s3 : ∀ (φ : ℝ³ → ℝ) (K : ℝ³ → ℝ³) (k : ℝ), DifferentiableAt ℝ φ x → DifferentiableAt ℝ K x →
      fderiv ℝ φ x (EuclideanSpace.single 0 1) = 0 → fderiv ℝ φ x (EuclideanSpace.single 1 1) = 0 →
      K x = k • azVec x →
      curl3 (fun y => φ y • K y) x =
        φ x • curl3 K x - (fderiv ℝ φ x (EuclideanSpace.single 2 1) * k) • radVec x := by
    intro φ K k hφ hK h0 h1 hKx
    unfold curl3
    rw [fderiv_fun_smul hφ hK]
    ext i
    fin_cases i <;> simp [h0, h1, hKx, azVec, radVec] <;> ring

  have hadd : ∀ F1 F2 : ℝ³ → ℝ³, DifferentiableAt ℝ F1 x → DifferentiableAt ℝ F2 x →
      curl3 (fun y => F1 y + F2 y) x = curl3 F1 x + curl3 F2 x := by
    intro F1 F2 h1 h2
    unfold curl3
    rw [fderiv_fun_add h1 h2]
    ext i
    fin_cases i <;> simp <;> ring
  have hsumcurl : ∀ (F : ℕ → ℝ³ → ℝ³), (∀ i, DifferentiableAt ℝ (F i) x) → ∀ s : Finset ℕ,
      DifferentiableAt ℝ (fun y => ∑ i ∈ s, F i y) x ∧
      curl3 (fun y => ∑ i ∈ s, F i y) x = ∑ i ∈ s, curl3 (F i) x := by
    intro F hF s
    refine Finset.induction_on s ?_ ?_
    · simp only [Finset.sum_empty]
      refine ⟨differentiableAt_const _, ?_⟩
      simp [curl3]
    · intro i s hi ih
      have e : (fun y => ∑ j ∈ insert i s, F j y) = fun y => F i y + ∑ j ∈ s, F j y := by
        funext y; rw [Finset.sum_insert hi]
      rw [e, Finset.sum_insert hi]
      refine ⟨(hF i).add ih.1, ?_⟩
      rw [hadd (F i) (fun y => ∑ j ∈ s, F j y) (hF i) ih.1, ih.2]
  have hcurl_congr : ∀ F₁ F₂ : ℝ³ → ℝ³, F₁ =ᶠ[nhds x] F₂ → curl3 F₁ x = curl3 F₂ x := by
    intro F₁ F₂ hF
    simp only [curl3, hF.fderiv_eq]

  have hScont : Continuous (fun y : ℝ³ => simScale h (y 2) (1 - t)) :=
    hS.2.2.2.1.continuousOn.comp_continuous (f := fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ))
      (by fun_prop) (fun y => ⟨mem_univ _, hτ⟩)
  have ha_pow : ∀ j : ℕ, (2:ℝ) ^ j ≤ a j := by
    intro j
    induction j with
    | zero => simpa using ha1 0
    | succ k ih => rw [pow_succ]; linarith [ha2 k]
  obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt (2 / Q) (one_lt_two : (1:ℝ) < 2)
  have hUn : {y : ℝ³ | Q / 2 < simScale h (y 2) (1 - t)} ∈ nhds x :=
    (isOpen_lt continuous_const hScont).mem_nhds
      (by show Q / 2 < simScale h (x 2) (1 - t); rw [← hQ]; linarith)
  have hxU : x ∈ {y : ℝ³ | Q / 2 < simScale h (y 2) (1 - t)} := mem_of_mem_nhds hUn
  have hbig : ∀ y ∈ {y : ℝ³ | Q / 2 < simScale h (y 2) (1 - t)}, ∀ j, N ≤ j →
      1 < a j * simScale h (y 2) (1 - t) := by
    intro y hy j hj
    have hy' : Q / 2 < simScale h (y 2) (1 - t) := hy
    have h2j : (2:ℝ) ^ N ≤ a j := (pow_le_pow_right₀ one_le_two hj).trans (ha_pow j)
    have e : 2 / Q * (Q / 2) = 1 := by field_simp
    calc (1:ℝ) = 2 / Q * (Q / 2) := e.symm
      _ < 2 ^ N * (Q / 2) := by apply mul_lt_mul_of_pos_right hN; positivity
      _ ≤ a j * (Q / 2) := by apply mul_le_mul_of_nonneg_right h2j; positivity
      _ < a j * simScale h (y 2) (1 - t) := by
        apply mul_lt_mul_of_pos_left hy'; linarith [ha1 j]
  have hzero : ∀ y ∈ {y : ℝ³ | Q / 2 < simScale h (y 2) (1 - t)}, ∀ j, N ≤ j →
      simCut h (a j) y t = 0 := by
    intro y hy j hj
    have := hbig y hy j hj
    unfold simCut
    exact Real.smoothTransition.zero_of_nonpos (by linarith)
  have hbc : ∀ c : ℝ, simCut h c x t = bgCut c Q := by intro c; rw [hQ]; rfl
  have hcz : ∀ j, N ≤ j → bgCut (a j) Q = 0 := fun j hj => by rw [← hbc]; exact hzero x hxU j hj
  have hdz : ∀ j, N ≤ j → deriv (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) (a j * Q) = 0 := by
    intro j hj
    have hgt : 1 < a j * Q := by have := hbig x hxU j hj; rwa [← hQ] at this
    have hev : (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) =ᶠ[nhds (a j * Q)] fun _ => (0:ℝ) := by
      filter_upwards [Ioi_mem_nhds hgt] with σ hσ
      have : (1:ℝ) < σ := hσ
      exact Real.smoothTransition.zero_of_nonpos (by linarith)
    rw [hev.deriv_eq]
    simp

  have hEqA : ∀ y ∈ {y : ℝ³ | Q / 2 < simScale h (y 2) (1 - t)},
      cutSum h a (fun n => bgAn h n (S n)) y t =
        bgAn h 0 (S 0) y t + ∑ i ∈ Finset.range N, simCut h (a (i + 1)) y t • bgAn h (i + 1) (S (i + 1)) y t := by
    intro y hy
    simp only [cutSum]
    congr 1
    apply tsum_eq_sum
    intro b hb
    rw [Finset.mem_range, not_lt] at hb
    rw [hzero y hy (b + 1) (by omega), zero_smul]
  have hBx : cutSum h a (fun n => bgBn h n (G n)) x t =
      bgBn h 0 (G 0) x t + ∑ i ∈ Finset.range N, simCut h (a (i + 1)) x t • bgBn h (i + 1) (G (i + 1)) x t := by
    simp only [cutSum]
    congr 1
    apply tsum_eq_sum
    intro b hb
    rw [Finset.mem_range, not_lt] at hb
    rw [hzero x hxU (b + 1) (by omega), zero_smul]

  have hTd : ∀ i : ℕ, DifferentiableAt ℝ
      (fun y => simCut h (a (i + 1)) y t • bgAn h (i + 1) (S (i + 1)) y t) x :=
    fun i => (hφd (a (i + 1))).smul (hKd (i + 1))
  have hFS := hsumcurl (fun i y => simCut h (a (i + 1)) y t • bgAn h (i + 1) (S (i + 1)) y t) hTd
    (Finset.range N)
  have hterm : ∀ i : ℕ, curl3 (fun y => simCut h (a (i + 1)) y t • bgAn h (i + 1) (S (i + 1)) y t) x =
      simCut h (a (i + 1)) x t • curl3 (fun y => bgAn h (i + 1) (S (i + 1)) y t) x -
      (deriv (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) (a (i + 1) * Q) * (a (i + 1) * Q') *
        (1 / 2 * Q ^ (-(1 / 2 + h) + 2 * ((i + 1 : ℕ) : ℝ) * h) *
          S (i + 1) (simX h x t) (simEta h x t))) • radVec x := by
    intro i
    have hk : bgAn h (i + 1) (S (i + 1)) x t =
        (1 / 2 * Q ^ (-(1 / 2 + h) + 2 * ((i + 1 : ℕ) : ℝ) * h) *
          S (i + 1) (simX h x t) (simEta h x t)) • azVec x := by
      rw [hQ]; rfl
    rw [s3 (fun y => simCut h (a (i + 1)) y t) (fun y => bgAn h (i + 1) (S (i + 1)) y t) _
      (hφd _) (hKd _) (by rw [hφv]; simp) (by rw [hφv]; simp) hk, hφv]
    simp
  have hcA : curl3 (fun w => cutSum h a (fun n => bgAn h n (S n)) w t) x =
      curl3 (fun y => bgAn h 0 (S 0) y t) x + ∑ i ∈ Finset.range N,
        (simCut h (a (i + 1)) x t • curl3 (fun y => bgAn h (i + 1) (S (i + 1)) y t) x -
          (deriv (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) (a (i + 1) * Q) * (a (i + 1) * Q') *
            (1 / 2 * Q ^ (-(1 / 2 + h) + 2 * ((i + 1 : ℕ) : ℝ) * h) *
              S (i + 1) (simX h x t) (simEta h x t))) • radVec x) := by
    rw [hcurl_congr _ _ (Filter.eventuallyEq_of_mem hUn hEqA), hadd _ _ (hKd 0) hFS.1, hFS.2]
    congr 1
    exact Finset.sum_congr rfl (fun i _ => hterm i)

  have hQne0 : simScale h (x 2) (1 - t) ≠ 0 := by rw [← hQ]; exact hQne
  have hphi := hQh.sub ((hasDerivAt_pow 2 (x 2)).mul (hQh.rpow_const (p := 2 * h) (Or.inl hQne0)))
  have hconst : ((fun z => simScale h z (1 - t)) - (fun z : ℝ => z ^ 2) *
      fun z => simScale h z (1 - t) ^ (2 * h)) = fun _ => 1 - t := by
    funext z; simp only [Pi.sub_apply, Pi.mul_apply]; exact (hS.1 z (1 - t) hτ).2
  rw [hconst] at hphi
  have hrel := hphi.unique (hasDerivAt_const (x 2) (1 - t))
  rw [← hQ] at hrel
  obtain ⟨p, hp⟩ : ∃ p, p = Q ^ (-(1 / 2 - h)) := ⟨_, rfl⟩
  have hppos : 0 < p := by rw [hp]; exact Real.rpow_pos_of_pos hQpos _
  have hR4 : Q ^ (2 * h - 1) = p ^ 2 := by
    rw [hp, ← Real.rpow_natCast, ← Real.rpow_mul hQpos.le]
    congr 1; push_cast; ring
  have hR5 : Q ^ (2 * h) = Q * p ^ 2 := by
    have e : Q ^ (2 * h) = Q ^ (1:ℝ) * Q ^ (2 * h - 1) := by
      rw [← Real.rpow_add hQpos]; congr 1; ring
    rw [e, Real.rpow_one, hR4]
  have hprod : Q ^ (1 - 2 * h) * Q ^ (2 * h - 1) = 1 := by
    rw [← Real.rpow_add hQpos, show 1 - 2 * h + (2 * h - 1) = (0:ℝ) by ring, Real.rpow_zero]
  have hz2 : x 2 ^ 2 < Q ^ (1 - 2 * h) := by
    have := (hS.2.1 (x 2) (1 - t) hτ).2; rwa [← hQ] at this
  have heta2 : (x 2 * p) ^ 2 < 1 := by
    have e : (x 2 * p) ^ 2 = x 2 ^ 2 * Q ^ (2 * h - 1) := by rw [hR4]; ring
    rw [e]
    calc x 2 ^ 2 * Q ^ (2 * h - 1) < Q ^ (1 - 2 * h) * Q ^ (2 * h - 1) :=
          mul_lt_mul_of_pos_right hz2 (Real.rpow_pos_of_pos hQpos _)
      _ = 1 := hprod
  have hL : 0 < 1 - 2 * h * (x 2 * p) ^ 2 := by
    have := mul_lt_mul_of_pos_left heta2 (by linarith : (0:ℝ) < 2 * h)
    linarith
  have hLne : 1 - 2 * h * (x 2 * p) ^ 2 ≠ 0 := hL.ne'
  rw [hR4, hR5] at hrel
  have hQ' : Q' = 2 * x 2 * Q * p ^ 2 / (1 - 2 * h * (x 2 * p) ^ 2) := by
    rw [eq_div_iff hLne]
    simp only [Nat.cast_ofNat] at hrel
    norm_num at hrel
    linear_combination hrel
  have hXdef : simX h x t = (x 0 ^ 2 + x 1 ^ 2) / (2 * Q) := by rw [hQ]; rfl
  have hEdef : simEta h x t = x 2 * p := by rw [hp, hQ]; rfl
  have hk : ∀ n : ℕ, Q ^ (2 * (n : ℝ) * h) = Q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * (Q * p) := by
    intro n
    have e1 : Q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * Q = Q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h + 1) := by
      rw [Real.rpow_add hQpos (-(1 / 2 + h) + 2 * (n : ℝ) * h) 1, Real.rpow_one]
    rw [hp, ← mul_assoc, e1, ← Real.rpow_add hQpos]
    congr 1; ring
  have hcrux : ∀ (c D s : ℝ) (n : ℕ),
      D * (c * Q') * (1 / 2 * Q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * s) * (x 0 ^ 2 + x 1 ^ 2) =
        Q ^ (2 * (n : ℝ) * h) * (2 * simEta h x t / (1 - 2 * h * simEta h x t ^ 2) * (c * Q) * D *
          (simX h x t * s)) := by
    intro c D s n
    rw [hk n, hXdef, hEdef]
    generalize Q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) = M
    rw [hQ']
    field_simp
    try ring

  have hin : ∀ v w : ℝ³, inner ℝ v w = v 0 * w 0 + v 1 * w 1 + v 2 * w 2 := by
    intro v w
    rw [PiLp.inner_apply, Fin.sum_univ_three]
    simp only [RCLike.inner_apply, conj_trivial]
    ring
  have he2 : ∀ v : ℝ³, v 2 = inner ℝ v (EuclideanSpace.single 2 (1:ℝ)) := by
    intro v; rw [hin]; simp
  have i_ra : inner ℝ (radVec x) (azVec x) = (0:ℝ) := by rw [hin]; simp [azVec, radVec] <;> ring
  have i_ar : inner ℝ (azVec x) (radVec x) = (0:ℝ) := by rw [hin]; simp [azVec, radVec] <;> ring
  have i_aa : inner ℝ (azVec x) (azVec x) = x 0 ^ 2 + x 1 ^ 2 := by
    rw [hin]; simp [azVec] <;> ring
  have i_rr : inner ℝ (radVec x) (radVec x) = x 0 ^ 2 + x 1 ^ 2 := by
    rw [hin]; simp [radVec] <;> ring
  have i_re : inner ℝ (radVec x) (EuclideanSpace.single 2 (1:ℝ)) = (0:ℝ) := by
    rw [← he2]; simp [radVec]
  have i_ae : inner ℝ (azVec x) (EuclideanSpace.single 2 (1:ℝ)) = (0:ℝ) := by
    rw [← he2]; simp [azVec]

  have hCx : ∀ n : ℕ, (curl3 (fun y => bgAn h n (S n) y t) x) 2 =
        Q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * Uc n (simX h x t) (simEta h x t) ∧
      inner ℝ (curl3 (fun y => bgAn h n (S n) y t) x) (radVec x) =
        Q ^ (2 * (n : ℝ) * h) * Vc n (simX h x t) (simEta h x t) ∧
      inner ℝ (curl3 (fun y => bgAn h n (S n) y t) x) (azVec x) = (0:ℝ) := by
    intro n; rw [hQ]; exact hC n x t hxt hr
  have hCz : ∀ n : ℕ, inner ℝ (curl3 (fun y => bgAn h n (S n) y t) x) (EuclideanSpace.single 2 (1:ℝ)) =
      Q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * Uc n (simX h x t) (simEta h x t) := by
    intro n; rw [← he2]; exact (hCx n).1
  have hCr : ∀ n : ℕ, inner ℝ (curl3 (fun y => bgAn h n (S n) y t) x) (radVec x) =
      Q ^ (2 * (n : ℝ) * h) * Vc n (simX h x t) (simEta h x t) := fun n => (hCx n).2.1
  have hCa : ∀ n : ℕ, inner ℝ (curl3 (fun y => bgAn h n (S n) y t) x) (azVec x) = (0:ℝ) :=
    fun n => (hCx n).2.2

  have hBn : ∀ n : ℕ, bgBn h n (G n) x t =
      (Q ^ (-(1 + h) + 2 * (n : ℝ) * h) * G n (simX h x t) (simEta h x t)) • azVec x := by
    intro n; rw [hQ]; rfl

  have hgen : ∀ v : ℝ³, inner ℝ (curl3 (fun w => cutSum h a (fun n => bgAn h n (S n)) w t) x +
      cutSum h a (fun n => bgBn h n (G n)) x t) v =
      inner ℝ (curl3 (fun y => bgAn h 0 (S 0) y t) x) v + ∑ i ∈ Finset.range N,
        (simCut h (a (i + 1)) x t * inner ℝ (curl3 (fun y => bgAn h (i + 1) (S (i + 1)) y t) x) v -
          (deriv (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) (a (i + 1) * Q) * (a (i + 1) * Q') *
            (1 / 2 * Q ^ (-(1 / 2 + h) + 2 * ((i + 1 : ℕ) : ℝ) * h) *
              S (i + 1) (simX h x t) (simEta h x t))) * inner ℝ (radVec x) v) +
      ((Q ^ (-(1 + h) + 2 * ((0 : ℕ) : ℝ) * h) * G 0 (simX h x t) (simEta h x t)) * inner ℝ (azVec x) v +
        ∑ i ∈ Finset.range N, simCut h (a (i + 1)) x t *
          ((Q ^ (-(1 + h) + 2 * ((i + 1 : ℕ) : ℝ) * h) * G (i + 1) (simX h x t) (simEta h x t)) *
            inner ℝ (azVec x) v)) := by
    intro v
    rw [hcA, hBx]
    simp only [hBn, inner_add_left, sum_inner, inner_sub_left, real_inner_smul_left]

  have hsumG : ∀ T : ℕ → ℝ → ℝ → ℝ, bgSum h a T Q (simX h x t) (simEta h x t) =
      T 0 (simX h x t) (simEta h x t) + ∑ n ∈ Finset.range N,
        bgCut (a (n + 1)) Q * Q ^ (2 * ((n : ℝ) + 1) * h) * T (n + 1) (simX h x t) (simEta h x t) := by
    intro T
    unfold bgSum
    congr 1
    apply tsum_eq_sum
    intro b hb
    rw [Finset.mem_range, not_lt] at hb
    rw [hcz (b + 1) (by omega), zero_mul, zero_mul]
  have hsumV : bgVb h a S Vc Q (simX h x t) (simEta h x t) =
      Vc 0 (simX h x t) (simEta h x t) + ∑ n ∈ Finset.range N, Q ^ (2 * ((n : ℝ) + 1) * h) *
        (bgCut (a (n + 1)) Q * Vc (n + 1) (simX h x t) (simEta h x t) -
          2 * simEta h x t / (1 - 2 * h * simEta h x t ^ 2) * (a (n + 1) * Q) *
            deriv (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) (a (n + 1) * Q) *
              (simX h x t * S (n + 1) (simX h x t) (simEta h x t))) := by
    unfold bgVb
    congr 1
    apply tsum_eq_sum
    intro b hb
    rw [Finset.mem_range, not_lt] at hb
    rw [hcz (b + 1) (by omega), hdz (b + 1) (by omega)]
    ring
  have hcast : ∀ i : ℕ, 2 * ((i + 1 : ℕ) : ℝ) * h = 2 * ((i : ℝ) + 1) * h := by
    intro i; push_cast; ring
  have h0A : Q ^ (-(1 / 2 + h) + 2 * ((0 : ℕ) : ℝ) * h) = Q ^ (-(1 / 2 + h)) := by simp
  have h0B : Q ^ (-(1 + h) + 2 * ((0 : ℕ) : ℝ) * h) = Q ^ (-(1 + h)) := by simp
  have h0V : Q ^ (2 * ((0 : ℕ) : ℝ) * h) = 1 := by simp

  have hfac : ∀ Y : ℝ, Real.sqrt (x 0 ^ 2 + x 1 ^ 2) * Q ^ (-(1 / 2 + h)) *
      (Real.sqrt (2 * simX h x t) * Y) = (x 0 ^ 2 + x 1 ^ 2) * Q ^ (-(1 + h)) * Y := by
    intro Y
    have h2X : 2 * simX h x t = (x 0 ^ 2 + x 1 ^ 2) / Q := by rw [hXdef]; field_simp
    have hsq : Real.sqrt (2 * simX h x t) = Real.sqrt (x 0 ^ 2 + x 1 ^ 2) / Real.sqrt Q := by
      rw [h2X, Real.sqrt_div hr.le]
    have hQh2 : Q ^ (-(1 / 2 + h)) = Q ^ (-(1 + h)) * Real.sqrt Q := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_add hQpos]; congr 1; ring
    have hne : Real.sqrt Q ≠ 0 := (Real.sqrt_pos.mpr hQpos).ne'
    have hrr : Real.sqrt (x 0 ^ 2 + x 1 ^ 2) * Real.sqrt (x 0 ^ 2 + x 1 ^ 2) = x 0 ^ 2 + x 1 ^ 2 :=
      Real.mul_self_sqrt hr.le
    rw [hsq, hQh2]
    calc Real.sqrt (x 0 ^ 2 + x 1 ^ 2) * (Q ^ (-(1 + h)) * Real.sqrt Q) *
          (Real.sqrt (x 0 ^ 2 + x 1 ^ 2) / Real.sqrt Q * Y)
        = (Real.sqrt (x 0 ^ 2 + x 1 ^ 2) * Real.sqrt (x 0 ^ 2 + x 1 ^ 2)) * Q ^ (-(1 + h)) *
            (Real.sqrt Q / Real.sqrt Q) * Y := by ring
      _ = (x 0 ^ 2 + x 1 ^ 2) * Q ^ (-(1 + h)) * Y := by rw [hrr, div_self hne, mul_one]

  rw [← hQ]
  refine ⟨?_, ?_, ?_⟩
  ·
    rw [hgen (azVec x)]
    simp only [hCa, i_ra, i_aa, mul_zero, sub_self, Finset.sum_const_zero, zero_add]
    unfold bgEb
    rw [hsumG G, hfac, h0B]
    conv_rhs => rw [mul_add, Finset.mul_sum]
    congr 1
    · ring
    · apply Finset.sum_congr rfl
      intro i _
      rw [hbc, hcast i, Real.rpow_add hQpos]
      ring
  ·
    rw [he2 (curl3 (fun w => cutSum h a (fun n => bgAn h n (S n)) w t) x +
      cutSum h a (fun n => bgBn h n (G n)) x t), hgen]
    simp only [hCz, i_re, i_ae, mul_zero, sub_zero, Finset.sum_const_zero, add_zero]
    rw [hsumG Uc, h0A]
    conv_rhs => rw [mul_add, Finset.mul_sum]
    congr 1
    · apply Finset.sum_congr rfl
      intro i _
      rw [hbc, hcast i, Real.rpow_add hQpos]
      ring
  ·
    rw [hgen (radVec x)]
    simp only [hCr, i_rr, i_ar, mul_zero, Finset.sum_const_zero, add_zero]
    rw [hsumV]
    congr 1
    · rw [h0V, one_mul]
    · apply Finset.sum_congr rfl
      intro i _
      rw [hcrux (a (i + 1)) _ _ (i + 1), hbc, hcast i]
      ring

theorem bps_cut_profiles : (ContDiff ℝ ∞ bpsChi ∧ (∀ σ : ℝ, 1 < σ → bpsChi σ = 0) ∧ ∀ k : ℕ, ∃ M : ℝ, ∀ u : ℝ, |iteratedDeriv k (fun u : ℝ => bpsChi (Real.exp u)) u| ≤ M) ∧ (ContDiff ℝ ∞ bpsPsi ∧ (∀ σ : ℝ, 1 < σ → bpsPsi σ = 0) ∧ ∀ k : ℕ, ∃ M : ℝ, ∀ u : ℝ, |iteratedDeriv k (fun u : ℝ => bpsPsi (Real.exp u)) u| ≤ M) :=
by

  have hgen : ∀ (φ : ℝ → ℝ) (c : ℝ), ContDiff ℝ ∞ φ → (∀ σ : ℝ, σ < 1 / 2 → φ σ = c) →
      (∀ σ : ℝ, 1 < σ → φ σ = 0) →
      ∀ k : ℕ, ∃ M : ℝ, ∀ u : ℝ, |iteratedDeriv k (fun u : ℝ => φ (Real.exp u)) u| ≤ M := by
    intro φ c hφ hc h0 k
    have hΦ : ContDiff ℝ ∞ (fun u : ℝ => φ (Real.exp u)) := hφ.comp Real.contDiff_exp
    have hcont : Continuous (iteratedDeriv k (fun u : ℝ => φ (Real.exp u))) :=
      hΦ.continuous_iteratedDeriv k (by exact_mod_cast le_top)
    obtain ⟨M₀, hM₀⟩ := (isCompact_Icc (a := (-1 : ℝ)) (b := 0)).exists_bound_of_continuousOn
      hcont.continuousOn
    have he : Real.exp (-1) ≤ 1 / 2 := by
      have h2 : (2 : ℝ) ≤ Real.exp 1 := by linarith [Real.add_one_le_exp (1 : ℝ)]
      have h3 : Real.exp (-1) * Real.exp 1 = 1 := by
        rw [← Real.exp_add]; norm_num
      have h4 : 0 < Real.exp (-1) := Real.exp_pos _
      nlinarith
    refine ⟨max M₀ |c|, fun u => ?_⟩
    rcases lt_or_ge u (-1) with hu | hu
    · have hev : (fun u : ℝ => φ (Real.exp u)) =ᶠ[nhds u] (fun _ => c) := by
        filter_upwards [Iio_mem_nhds hu] with τ hτ
        apply hc
        have : Real.exp τ < Real.exp (-1) := Real.exp_lt_exp.mpr hτ
        linarith
      rw [hev.iteratedDeriv_eq, iteratedDeriv_const]
      refine le_trans ?_ (le_max_right _ _)
      split_ifs
      · exact le_rfl
      · simp
    · rcases lt_or_ge 0 u with hu' | hu'
      · have hev : (fun u : ℝ => φ (Real.exp u)) =ᶠ[nhds u] (fun _ => (0 : ℝ)) := by
          filter_upwards [Ioi_mem_nhds hu'] with τ hτ
          apply h0
          have : Real.exp 0 < Real.exp τ := Real.exp_lt_exp.mpr hτ
          rw [Real.exp_zero] at this
          exact this
        rw [hev.iteratedDeriv_eq, iteratedDeriv_const]
        refine le_trans ?_ (le_max_right _ _)
        split_ifs <;> simp
      · have := hM₀ u ⟨hu, hu'⟩
        rw [Real.norm_eq_abs] at this
        exact le_trans this (le_max_left _ _)

  have hgs : ContDiff ℝ ∞ (fun σ : ℝ => Real.smoothTransition (2 - 2 * σ)) :=
    (Real.smoothTransition.contDiff (n := ⊤) : ContDiff ℝ ∞ Real.smoothTransition).comp
      (contDiff_const.sub (contDiff_const.mul contDiff_id))
  have hg1 : ∀ σ : ℝ, σ < 1 / 2 → Real.smoothTransition (2 - 2 * σ) = 1 := fun σ hσ =>
    Real.smoothTransition.one_of_one_le (by linarith)
  have hg0 : ∀ σ : ℝ, 1 < σ → Real.smoothTransition (2 - 2 * σ) = 0 := fun σ hσ =>
    Real.smoothTransition.zero_of_nonpos (by linarith)
  have hχs : ContDiff ℝ ∞ bpsChi := by unfold bpsChi; exact hgs
  have hχ1 : ∀ σ : ℝ, σ < 1 / 2 → bpsChi σ = 1 := by unfold bpsChi; exact hg1
  have hχ0 : ∀ σ : ℝ, 1 < σ → bpsChi σ = 0 := by unfold bpsChi; exact hg0
  have hdg1 : ∀ σ : ℝ, σ < 1 / 2 → deriv (fun σ' : ℝ => Real.smoothTransition (2 - 2 * σ')) σ = 0 := by
    intro σ hσ
    have hev : (fun σ' : ℝ => Real.smoothTransition (2 - 2 * σ')) =ᶠ[nhds σ] (fun _ => (1 : ℝ)) := by
      filter_upwards [Iio_mem_nhds hσ] with τ hτ
      exact hg1 τ hτ
    rw [hev.deriv_eq, deriv_const]
  have hdg0 : ∀ σ : ℝ, 1 < σ → deriv (fun σ' : ℝ => Real.smoothTransition (2 - 2 * σ')) σ = 0 := by
    intro σ hσ
    have hev : (fun σ' : ℝ => Real.smoothTransition (2 - 2 * σ')) =ᶠ[nhds σ] (fun _ => (0 : ℝ)) := by
      filter_upwards [Ioi_mem_nhds hσ] with τ hτ
      exact hg0 τ hτ
    rw [hev.deriv_eq, deriv_const]
  have hψs : ContDiff ℝ ∞ bpsPsi := by
    unfold bpsPsi
    exact contDiff_id.mul (contDiff_infty_iff_deriv.mp hgs).2
  have hψ1 : ∀ σ : ℝ, σ < 1 / 2 → bpsPsi σ = 0 := by
    intro σ hσ
    unfold bpsPsi
    rw [hdg1 σ hσ, mul_zero]
  have hψ0 : ∀ σ : ℝ, 1 < σ → bpsPsi σ = 0 := by
    intro σ hσ
    unfold bpsPsi
    rw [hdg0 σ hσ, mul_zero]
  exact ⟨⟨hχs, hχ0, hgen bpsChi 1 hχs hχ1 hχ0⟩, ⟨hψs, hψ0, hgen bpsPsi 0 hψs hψ1 hψ0⟩⟩

theorem bps_log_tail : ∀ (h : ℝ) (φ : ℝ → ℝ) (T : ℕ → ℝ → ℝ → ℝ) (wt : ℕ → ℝ → ℝ) (D : Set (ℝ × ℝ)), 0 < h → ContDiff ℝ ∞ φ → (∀ σ : ℝ, 1 < σ → φ σ = 0) → (∀ k : ℕ, ∃ M : ℝ, ∀ u : ℝ, |iteratedDeriv k (fun u : ℝ => φ (Real.exp u)) u| ≤ M) → (∀ n : ℕ, 1 ≤ n → ContDiffOn ℝ ∞ (↿(T n)) (Ioi 0 ×ˢ Ioo (-1) 1)) → D ⊆ Ioi 0 ×ˢ Ioo (-1) 1 → (∀ (m : ℕ) (X η : ℝ), (X, η) ∈ D → 0 ≤ wt m X) → (∀ n : ℕ, 1 ≤ n → ∀ m : ℕ, ∃ C : ℝ, ∀ i : ℕ, i ≤ m → ∀ X η : ℝ, (X, η) ∈ D → ‖iteratedFDeriv ℝ i (↿(T n)) (X, η)‖ ≤ C * wt m X) → ∃ Cp : ℕ → ℕ → ℝ, ∀ a : ℕ → ℝ, (∀ j, 1 ≤ a j) → (∀ j, 2 * a j ≤ a (j + 1)) → (∀ j : ℕ, 1 ≤ j → ∀ m : ℕ, m ≤ j → ∀ q : ℝ, 0 < q → q ≤ 1 / a j → |Cp j m| * q ^ (2 * h * (j : ℝ) / 2) ≤ (1 / 2) ^ j) → ContDiffOn ℝ ∞ (bpsTail h φ a T) (univ ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) ∧ ∀ m : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ q X η : ℝ, 0 < q → q < 1 → (X, η) ∈ D → ‖iteratedFDeriv ℝ m (bpsTail h φ a T) (Real.log q, X, η)‖ ≤ C * q ^ (2 * h) * wt m X :=
by
  intro h φ T wt D hh hφs hφ0 hφM hTs hD hwt hTb


  have bps_lift_mul : ∀ (g : ℝ → ℝ → ℝ) (f : ℝ × ℝ × ℝ → ℝ), ContDiffOn ℝ ∞ (↿g) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ f (univ ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) → ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => g w.2.1 w.2.2) (univ ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) ∧ (∀ (m : ℕ) (w : ℝ × ℝ × ℝ), w.2 ∈ Ioi 0 ×ˢ Ioo (-1) 1 → ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => g w.2.1 w.2.2) w‖ ≤ ‖iteratedFDeriv ℝ m (↿g) w.2‖) ∧ ∀ (m : ℕ) (w : ℝ × ℝ × ℝ), w.2 ∈ Ioi 0 ×ˢ Ioo (-1) 1 → ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => g w.2.1 w.2.2 * f w) w‖ ≤ ∑ k ∈ Finset.range (m + 1), (m.choose k : ℝ) * ‖iteratedFDeriv ℝ k (↿g) w.2‖ * ‖iteratedFDeriv ℝ (m - k) f w‖ := by
    intro g f hg hf
    have hO : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
    have hS : IsOpen ((univ : Set ℝ) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) := isOpen_univ.prod hO
    let L : ℝ × ℝ × ℝ →L[ℝ] ℝ × ℝ := ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)
    have hpre : (L : ℝ × ℝ × ℝ → ℝ × ℝ) ⁻¹' (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) =
        (univ : Set ℝ) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := by
      ext w
      simp [L]
    have hG : (fun w : ℝ × ℝ × ℝ => g w.2.1 w.2.2) = (↿g) ∘ (L : ℝ × ℝ × ℝ → ℝ × ℝ) := by
      funext w
      rfl
    have hGs : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => g w.2.1 w.2.2)
        ((univ : Set ℝ) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) := by
      rw [hG, ← hpre]
      exact hg.comp_continuousLinearMap L
    have hSo : IsOpen ((L : ℝ × ℝ × ℝ → ℝ × ℝ) ⁻¹' (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) := hpre ▸ hS
    have hB : ∀ (m : ℕ) (w : ℝ × ℝ × ℝ), w.2 ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 →
        ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => g w.2.1 w.2.2) w‖ ≤
          ‖iteratedFDeriv ℝ m (↿g) w.2‖ := by
      intro m w hw
      have hwS : w ∈ (L : ℝ × ℝ × ℝ → ℝ × ℝ) ⁻¹' (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := hw
      have hLw : L w ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := hw
      have hm : ((m : ℕ∞) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
      have E1 := L.iteratedFDerivWithin_comp_right hg hO.uniqueDiffOn hSo.uniqueDiffOn hLw hm
      rw [iteratedFDerivWithin_of_isOpen m hSo hwS, iteratedFDerivWithin_of_isOpen m hO hLw] at E1
      rw [hG, E1]
      refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
      have hL : ‖L‖ ≤ 1 := ContinuousLinearMap.norm_snd_le ℝ ℝ (ℝ × ℝ)
      have hp : ∏ _i : Fin m, ‖L‖ ≤ 1 :=
        Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) (fun _ _ => hL)
      exact mul_le_of_le_one_right (norm_nonneg _) hp
    refine ⟨hGs, hB, ?_⟩
    intro m w hw
    have hwS : w ∈ (univ : Set ℝ) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := ⟨mem_univ _, hw⟩
    have hm : ((m : ℕ∞) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
    have h1 := norm_iteratedFDerivWithin_mul_le hGs hf hS.uniqueDiffOn hwS hm
    refine le_trans (le_of_eq ?_) (le_trans h1 (Finset.sum_le_sum fun k _ => ?_))
    · rw [iteratedFDerivWithin_of_isOpen m hS hwS]
    · rw [iteratedFDerivWithin_of_isOpen k hS hwS, iteratedFDerivWithin_of_isOpen (m - k) hS hwS]
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (hB k w hw) (Nat.cast_nonneg _)) (norm_nonneg _)

  have hprof : ∀ k : ℕ, ∃ Mb : ℝ, 0 ≤ Mb ∧ ∀ b c : ℝ, 0 < b → 0 ≤ c → ∀ i : ℕ, i ≤ k → ∀ s : ℝ,
      |iteratedDeriv i (fun s : ℝ => φ (b * Real.exp s) * Real.exp s ^ c) s| ≤
        Mb * (1 + c) ^ k * Real.exp s ^ c := by
    obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ → ℝ, Φ = fun u => φ (Real.exp u) := ⟨_, rfl⟩
    have hΦs : ContDiff ℝ ∞ Φ := by rw [hΦ]; exact hφs.comp Real.contDiff_exp
    have hΦM : ∀ k : ℕ, ∃ M : ℝ, ∀ u : ℝ, |iteratedDeriv k Φ u| ≤ M := by rw [hΦ]; exact hφM
    choose M hM using hΦM
    intro k
    obtain ⟨S, hSdef⟩ : ∃ S : ℝ, S = ∑ l ∈ Finset.range (k + 1), |M l| := ⟨_, rfl⟩
    have hS0 : 0 ≤ S := by rw [hSdef]; exact Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    refine ⟨2 ^ k * S, mul_nonneg (by positivity) hS0, ?_⟩
    intro b c hb hc i hi s
    have hML : ∀ l, l ≤ k → ∀ u, |iteratedDeriv l Φ u| ≤ S := by
      intro l hl u
      rw [hSdef]
      exact (hM l u).trans ((le_abs_self _).trans (Finset.single_le_sum (f := fun l => |M l|)
        (fun _ _ => abs_nonneg _) (Finset.mem_range.2 (by omega))))
    have hfun : (fun s : ℝ => φ (b * Real.exp s) * Real.exp s ^ c) =
        fun s => Φ (s + Real.log b) * Real.exp (c * s) := by
      funext s
      simp only [hΦ]
      rw [Real.exp_add, Real.exp_log hb, mul_comm (Real.exp s) b, mul_comm c s, Real.exp_mul]
    have h1 : ContDiff ℝ ∞ (fun z => Φ (z + Real.log b)) := hΦs.comp (contDiff_id.add contDiff_const)
    have h2 : ContDiff ℝ ∞ (fun z : ℝ => Real.exp (c * z)) :=
      Real.contDiff_exp.comp (contDiff_const.mul contDiff_id)
    rw [hfun, iteratedDeriv_fun_mul (h1.contDiffAt.of_le (by exact_mod_cast le_top))
      (h2.contDiffAt.of_le (by exact_mod_cast le_top))]
    have e1 : ∀ l, iteratedDeriv l (fun z => Φ (z + Real.log b)) s = iteratedDeriv l Φ (s + Real.log b) :=
      fun l => congrFun (iteratedDeriv_comp_add_const l Φ (Real.log b)) s
    have e2 : ∀ l, iteratedDeriv l (fun z : ℝ => Real.exp (c * z)) s = c ^ l * Real.exp (c * s) :=
      fun l => congrFun (iteratedDeriv_exp_const_mul l c) s
    simp only [e1, e2]
    have hE : Real.exp s ^ c = Real.exp (c * s) := by rw [mul_comm, Real.exp_mul]
    rw [hE]
    have e0 := Real.exp_pos (c * s)
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    refine (Finset.sum_le_sum (g := fun l => (i.choose l : ℝ) * (S * (1 + c) ^ k * Real.exp (c * s)))
      ?_).trans ?_
    · intro l hl
      have hl' : l ≤ i := Nat.lt_succ_iff.1 (Finset.mem_range.1 hl)
      have hD := hML l (by omega) (s + Real.log b)
      have hcpow : c ^ (i - l) ≤ (1 + c) ^ k :=
        (pow_le_pow_left₀ hc (by linarith) _).trans (pow_le_pow_right₀ (by linarith) (by omega))
      have key : |iteratedDeriv l Φ (s + Real.log b)| * (c ^ (i - l) * Real.exp (c * s)) ≤
          S * ((1 + c) ^ k * Real.exp (c * s)) :=
        mul_le_mul hD (mul_le_mul_of_nonneg_right hcpow e0.le) (mul_nonneg (pow_nonneg hc _) e0.le) hS0
      simp only [abs_mul, Nat.abs_cast, abs_of_nonneg (pow_nonneg hc (i - l)), abs_of_pos e0]
      calc _ = (i.choose l : ℝ) * (|iteratedDeriv l Φ (s + Real.log b)| *
            (c ^ (i - l) * Real.exp (c * s))) := by ring
        _ ≤ (i.choose l : ℝ) * (S * ((1 + c) ^ k * Real.exp (c * s))) :=
            mul_le_mul_of_nonneg_left key (Nat.cast_nonneg _)
        _ = _ := by ring
    · rw [← Finset.sum_mul]
      have hsum : (∑ l ∈ Finset.range (i + 1), (i.choose l : ℝ)) = 2 ^ i := by
        exact_mod_cast Nat.sum_range_choose i
      rw [hsum]
      have h2i : (2:ℝ) ^ i ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hi
      have hX : 0 ≤ S * (1 + c) ^ k * Real.exp (c * s) :=
        mul_nonneg (mul_nonneg hS0 (pow_nonneg (by linarith) _)) e0.le
      calc (2:ℝ) ^ i * (S * (1 + c) ^ k * Real.exp (c * s)) ≤
            2 ^ k * (S * (1 + c) ^ k * Real.exp (c * s)) := mul_le_mul_of_nonneg_right h2i hX
        _ = _ := by ring
  choose Mb hMb0 hMb using hprof

  have hfS : ∀ b c : ℝ, ContDiff ℝ ∞ (fun s : ℝ => φ (b * Real.exp s) * Real.exp s ^ c) := fun b c =>
    (hφs.comp (contDiff_const.mul Real.contDiff_exp)).mul
      (Real.contDiff_exp.rpow_const_of_ne (fun s => (Real.exp_pos s).ne'))
  have hfS3 : ∀ b c : ℝ, ContDiff ℝ ∞
      (fun w : ℝ × ℝ × ℝ => φ (b * Real.exp w.1) * Real.exp w.1 ^ c) := fun b c =>
    (hfS b c).comp contDiff_fst

  have hfst : ∀ (f : ℝ → ℝ), ContDiff ℝ ∞ f → ∀ (m : ℕ) (w : ℝ × ℝ × ℝ),
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => f w.1) w‖ ≤ |iteratedDeriv m f w.1| := by
    intro f hf m w
    have e : (fun w : ℝ × ℝ × ℝ => f w.1) = f ∘ ⇑(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)) := rfl
    rw [e, ContinuousLinearMap.iteratedFDeriv_comp_right _ hf w (by exact_mod_cast le_top)]
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    rw [← Real.norm_eq_abs, ← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
    have hp : ∏ _i : Fin m, ‖ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)‖ ≤ 1 :=
      Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) (fun _ _ => ContinuousLinearMap.norm_fst_le _ _ _)
    calc _ ≤ ‖iteratedFDeriv ℝ m f ((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)) w)‖ * 1 :=
          mul_le_mul_of_nonneg_left hp (norm_nonneg _)
      _ = _ := by rw [mul_one]; rfl

  have hTb' : ∀ n m : ℕ, ∃ C : ℝ, 1 ≤ n → ∀ i : ℕ, i ≤ m → ∀ X η : ℝ, (X, η) ∈ D →
      ‖iteratedFDeriv ℝ i (↿(T n)) (X, η)‖ ≤ C * wt m X := by
    intro n m
    by_cases hn : 1 ≤ n
    · obtain ⟨C, hC⟩ := hTb n hn m
      exact ⟨C, fun _ => hC⟩
    · exact ⟨0, fun h1 => absurd h1 hn⟩
  choose Cj hCj using hTb'
  obtain ⟨Cp, hCp⟩ : ∃ Cp : ℕ → ℕ → ℝ,
      Cp = fun (j m : ℕ) => 2 ^ m * Mb m * (1 + 2 * h * (j : ℝ)) ^ m * |Cj j m| := ⟨_, rfl⟩
  have hCp0 : ∀ j m, 0 ≤ Cp j m := by
    intro j m
    simp only [hCp]
    exact mul_nonneg (mul_nonneg (mul_nonneg (by positivity) (hMb0 m))
      (pow_nonneg (add_nonneg zero_le_one (mul_nonneg (mul_nonneg zero_le_two hh.le)
        (Nat.cast_nonneg _))) _)) (abs_nonneg _)
  refine ⟨Cp, ?_⟩
  intro a ha1 ha2 hsm
  have hapos : ∀ j, 0 < a j := fun j => lt_of_lt_of_le one_pos (ha1 j)
  have h2pow : ∀ j, (2:ℝ) ^ j ≤ a j := by
    intro j
    induction j with
    | zero => simpa using ha1 0
    | succ k ih => rw [pow_succ]; linarith [ha2 k]

  obtain ⟨tm, htm⟩ : ∃ tm : ℕ → ℝ × ℝ × ℝ → ℝ, tm = fun n w =>
      φ (a (n + 1) * Real.exp w.1) * Real.exp w.1 ^ (2 * ((n : ℝ) + 1) * h) * T (n + 1) w.2.1 w.2.2 :=
    ⟨_, rfl⟩
  have hUo : IsOpen (univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) : Set (ℝ × ℝ × ℝ)) :=
    isOpen_univ.prod (isOpen_Ioi.prod isOpen_Ioo)
  have htmS : ∀ n, ContDiffOn ℝ ∞ (tm n) (univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) := by
    intro n
    have lift := bps_lift_mul (T (n + 1))
      (fun w : ℝ × ℝ × ℝ => φ (a (n + 1) * Real.exp w.1) * Real.exp w.1 ^ (2 * ((n : ℝ) + 1) * h))
      (hTs (n + 1) (by omega)) (hfS3 _ _).contDiffOn
    have e : tm n = fun w : ℝ × ℝ × ℝ =>
        (φ (a (n + 1) * Real.exp w.1) * Real.exp w.1 ^ (2 * ((n : ℝ) + 1) * h)) * T (n + 1) w.2.1 w.2.2 := by
      rw [htm]
    rw [e]
    exact (hfS3 _ _).contDiffOn.mul lift.1

  have hvan : ∀ (n m : ℕ) (w : ℝ × ℝ × ℝ), 1 < a (n + 1) * Real.exp w.1 →
      iteratedFDeriv ℝ m (tm n) w = 0 := by
    intro n m w hw
    have hV : IsOpen {w : ℝ × ℝ × ℝ | 1 < a (n + 1) * Real.exp w.1} :=
      isOpen_lt continuous_const (continuous_const.mul (Real.continuous_exp.comp continuous_fst))
    have hev : tm n =ᶠ[nhds w] fun _ => (0:ℝ) := by
      filter_upwards [hV.mem_nhds hw] with v hv
      have hv' : 1 < a (n + 1) * Real.exp v.1 := hv
      rw [htm]
      simp only [hφ0 _ hv', zero_mul]
    rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
    rfl

  have hest : ∀ n m : ℕ, ∀ q X η : ℝ, 0 < q → (X, η) ∈ D →
      ‖iteratedFDeriv ℝ m (tm n) (Real.log q, X, η)‖ ≤
        Cp (n + 1) m * q ^ (2 * ((n : ℝ) + 1) * h) * wt m X := by
    intro n m q X η hq hXD
    have hXO := hD hXD
    have hc : (0:ℝ) ≤ 2 * ((n : ℝ) + 1) * h := by positivity
    have lift := bps_lift_mul (T (n + 1))
      (fun w : ℝ × ℝ × ℝ => φ (a (n + 1) * Real.exp w.1) * Real.exp w.1 ^ (2 * ((n : ℝ) + 1) * h))
      (hTs (n + 1) (by omega)) (hfS3 _ _).contDiffOn
    have e : tm n = fun w : ℝ × ℝ × ℝ => T (n + 1) w.2.1 w.2.2 *
        (φ (a (n + 1) * Real.exp w.1) * Real.exp w.1 ^ (2 * ((n : ℝ) + 1) * h)) := by
      rw [htm]; funext w; ring
    rw [e]
    refine (lift.2.2 m (Real.log q, X, η) hXO).trans ?_
    have hexp : Real.exp (Real.log q) = q := Real.exp_log hq
    have hwt0 := hwt m X η hXD
    simp only [hCp]
    have hcast : (1 + 2 * h * ((n + 1 : ℕ) : ℝ)) = 1 + 2 * ((n : ℝ) + 1) * h := by push_cast; ring
    rw [hcast]
    have hterm : ∀ k ∈ Finset.range (m + 1),
        (m.choose k : ℝ) * ‖iteratedFDeriv ℝ k (↿(T (n + 1))) (Real.log q, X, η).2‖ *
          ‖iteratedFDeriv ℝ (m - k) (fun w : ℝ × ℝ × ℝ =>
            φ (a (n + 1) * Real.exp w.1) * Real.exp w.1 ^ (2 * ((n : ℝ) + 1) * h)) (Real.log q, X, η)‖ ≤
        (m.choose k : ℝ) * ((|Cj (n + 1) m| * wt m X) *
          (Mb m * (1 + 2 * ((n : ℝ) + 1) * h) ^ m * q ^ (2 * ((n : ℝ) + 1) * h))) := by
      intro k hk
      have hk' : k ≤ m := Nat.lt_succ_iff.1 (Finset.mem_range.1 hk)
      have b1 : ‖iteratedFDeriv ℝ k (↿(T (n + 1))) (X, η)‖ ≤ |Cj (n + 1) m| * wt m X :=
        (hCj (n + 1) m (by omega) k hk' X η hXD).trans (mul_le_mul_of_nonneg_right (le_abs_self _) hwt0)
      have b2 := (hfst _ (hfS (a (n + 1)) (2 * ((n : ℝ) + 1) * h)) (m - k) (Real.log q, X, η)).trans
        (hMb m (a (n + 1)) _ (hapos _) hc (m - k) (by omega) (Real.log q))
      rw [hexp] at b2
      exact (mul_le_mul (mul_le_mul_of_nonneg_left b1 (Nat.cast_nonneg _)) b2 (norm_nonneg _)
        (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (abs_nonneg _) hwt0))).trans_eq (by ring)
    refine (Finset.sum_le_sum hterm).trans (le_of_eq ?_)
    rw [← Finset.sum_mul]
    have hsum : (∑ k ∈ Finset.range (m + 1), (m.choose k : ℝ)) = 2 ^ m := by
      exact_mod_cast Nat.sum_range_choose m
    rw [hsum]
    ring

  have hloc : ∀ s₀ : ℝ, ∃ N : ℕ, ∀ w : ℝ × ℝ × ℝ, s₀ - 1 < w.1 →
      bpsTail h φ a T w = ∑ n ∈ Finset.range N, tm n w := by
    intro s₀
    obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt (Real.exp (1 - s₀)) (by norm_num : (1:ℝ) < 2)
    refine ⟨N, fun w hw => ?_⟩
    have e : bpsTail h φ a T w = ∑' n, tm n w := by rw [htm]; rfl
    rw [e]
    apply tsum_eq_sum
    intro n hn
    have hn' : N ≤ n := by simpa using hn
    have h1 : (2:ℝ) ^ N ≤ a (n + 1) :=
      (pow_le_pow_right₀ (by norm_num) (by omega)).trans (h2pow (n + 1))
    have h2 : Real.exp (s₀ - 1) < Real.exp w.1 := Real.exp_lt_exp.2 hw
    have h3 : Real.exp (1 - s₀) * Real.exp (s₀ - 1) = 1 := by
      rw [← Real.exp_add, show 1 - s₀ + (s₀ - 1) = (0:ℝ) by ring, Real.exp_zero]
    have h4 : 1 < a (n + 1) * Real.exp w.1 := by
      have := mul_lt_mul'' (hN.trans_le h1) h2 (Real.exp_pos _).le (Real.exp_pos _).le
      linarith
    rw [htm]
    simp only [hφ0 _ h4, zero_mul]

  have hfin : ∀ (N : ℕ) (w : ℝ × ℝ × ℝ),
      w ∈ (univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) : Set (ℝ × ℝ × ℝ)) → ∀ m : ℕ,
      iteratedFDeriv ℝ m (fun w => ∑ n ∈ Finset.range N, tm n w) w =
        ∑ n ∈ Finset.range N, iteratedFDeriv ℝ m (tm n) w := by
    intro N w hw m
    have e1 : (fun w => ∑ n ∈ Finset.range N, tm n w) = ∑ n ∈ Finset.range N, tm n :=
      (Finset.sum_fn _ _).symm
    rw [e1, ← iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := ∑ n ∈ Finset.range N, tm n) m hUo hw,
      iteratedFDerivWithin_sum_apply hUo.uniqueDiffOn hw
        (fun j _ => ((htmS j).contDiffWithinAt hw).of_le (by exact_mod_cast le_top))]
    exact Finset.sum_congr rfl (fun j _ => iteratedFDerivWithin_of_isOpen m hUo hw)
  refine ⟨?_, ?_⟩
  ·
    apply contDiffOn_of_locally_contDiffOn
    intro w₀ _
    obtain ⟨N, hN⟩ := hloc w₀.1
    refine ⟨{w : ℝ × ℝ × ℝ | w₀.1 - 1 < w.1}, isOpen_lt continuous_const continuous_fst,
      by show w₀.1 - 1 < w₀.1; linarith, ?_⟩
    exact ((ContDiffOn.sum (s := Finset.range N) (fun n _ => htmS n)).mono inter_subset_left).congr
      (fun w hw => hN w hw.2)
  ·
    intro m
    obtain ⟨j₀, hj₀m, hj₀2⟩ : ∃ j₀ : ℕ, m ≤ j₀ ∧ 2 ≤ j₀ := ⟨max m 2, le_max_left _ _, le_max_right _ _⟩
    refine ⟨1 + ∑ n ∈ Finset.range j₀, Cp (n + 1) m,
      add_nonneg zero_le_one (Finset.sum_nonneg (fun n _ => hCp0 _ _)), ?_⟩
    intro q X η hq hq1 hXD
    have hXO := hD hXD
    have hw₀ : (Real.log q, X, η) ∈ (univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) : Set (ℝ × ℝ × ℝ)) :=
      ⟨mem_univ _, hXO⟩
    obtain ⟨N, hN⟩ := hloc (Real.log q)
    have hev : bpsTail h φ a T =ᶠ[nhds (Real.log q, X, η)] fun w => ∑ n ∈ Finset.range N, tm n w :=
      Filter.eventuallyEq_of_mem
        ((isOpen_lt continuous_const continuous_fst : IsOpen {w : ℝ × ℝ × ℝ | Real.log q - 1 < w.1}).mem_nhds
          (by show Real.log q - 1 < Real.log q; linarith))
        (fun w hw => hN w hw)
    rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds, hfin N _ hw₀ m]
    refine (norm_sum_le _ _).trans ?_
    have hwt0 := hwt m X η hXD
    have hQ : 0 ≤ q ^ (2 * h) * wt m X := mul_nonneg (Real.rpow_nonneg hq.le _) hwt0
    have hx : ∀ n ∈ Finset.range N, ‖iteratedFDeriv ℝ m (tm n) (Real.log q, X, η)‖ ≤
        ((if n + 1 < j₀ then Cp (n + 1) m else 0) + (1 / 2 : ℝ) ^ (n + 1)) * (q ^ (2 * h) * wt m X) := by
      intro n _
      have hb := hest n m q X η hq hXD
      by_cases hj : n + 1 < j₀
      · rw [if_pos hj]
        have hc_ge : 2 * h ≤ 2 * ((n : ℝ) + 1) * h := by
          have := (Nat.cast_nonneg n : (0:ℝ) ≤ n); nlinarith
        have hqc := Real.rpow_le_rpow_of_exponent_ge hq hq1.le hc_ge
        have h1 : Cp (n + 1) m * q ^ (2 * ((n : ℝ) + 1) * h) * wt m X ≤ Cp (n + 1) m * q ^ (2 * h) * wt m X :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hqc (hCp0 _ _)) hwt0
        have h2 : 0 ≤ (1 / 2 : ℝ) ^ (n + 1) * (q ^ (2 * h) * wt m X) := mul_nonneg (by positivity) hQ
        calc _ ≤ Cp (n + 1) m * q ^ (2 * h) * wt m X := hb.trans h1
          _ ≤ Cp (n + 1) m * q ^ (2 * h) * wt m X + (1 / 2 : ℝ) ^ (n + 1) * (q ^ (2 * h) * wt m X) :=
              le_add_of_nonneg_right h2
          _ = _ := by ring
      · rw [if_neg hj, zero_add]
        have hn2 : 2 ≤ n + 1 := by omega
        have hmn : m ≤ n + 1 := by omega
        by_cases hv : 1 < a (n + 1) * q
        · have h0 := hvan n m (Real.log q, X, η)
            (by show 1 < a (n + 1) * Real.exp (Real.log q); rw [Real.exp_log hq]; exact hv)
          rw [h0, norm_zero]
          exact mul_nonneg (by positivity) hQ
        · push_neg at hv
          have hqa : q ≤ 1 / a (n + 1) := by rw [le_div_iff₀ (hapos _), mul_comm]; exact hv
          have hs := hsm (n + 1) (by omega) m hmn q hq hqa
          rw [abs_of_nonneg (hCp0 _ _)] at hs
          have he : 2 * h * ((n + 1 : ℕ) : ℝ) / 2 = h * ((n : ℝ) + 1) := by push_cast; ring
          rw [he] at hs
          have hcsplit : q ^ (2 * ((n : ℝ) + 1) * h) =
              q ^ (h * ((n : ℝ) + 1)) * q ^ (h * ((n : ℝ) + 1)) := by
            rw [← Real.rpow_add hq]; congr 1; ring
          have hn2r : (2:ℝ) ≤ (n : ℝ) + 1 := by exact_mod_cast hn2
          have hqe : q ^ (h * ((n : ℝ) + 1)) ≤ q ^ (2 * h) :=
            Real.rpow_le_rpow_of_exponent_ge hq hq1.le (by nlinarith)
          have hqe0 : 0 ≤ q ^ (h * ((n : ℝ) + 1)) := Real.rpow_nonneg hq.le _
          calc _ ≤ Cp (n + 1) m * q ^ (2 * ((n : ℝ) + 1) * h) * wt m X := hb
            _ = (Cp (n + 1) m * q ^ (h * ((n : ℝ) + 1))) * q ^ (h * ((n : ℝ) + 1)) * wt m X := by
                rw [hcsplit]; ring
            _ ≤ (1 / 2) ^ (n + 1) * q ^ (h * ((n : ℝ) + 1)) * wt m X :=
                mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hs hqe0) hwt0
            _ ≤ (1 / 2) ^ (n + 1) * q ^ (2 * h) * wt m X :=
                mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hqe (by positivity)) hwt0
            _ = (1 / 2) ^ (n + 1) * (q ^ (2 * h) * wt m X) := by ring
    have hgeo : ∑ n ∈ Finset.range N, (1 / 2 : ℝ) ^ (n + 1) ≤ 1 := by
      have := sum_geometric_two_le N
      have e : ∑ n ∈ Finset.range N, (1 / 2 : ℝ) ^ (n + 1) =
          (1 / 2) * ∑ n ∈ Finset.range N, (1 / 2 : ℝ) ^ n := by
        rw [Finset.mul_sum]; exact Finset.sum_congr rfl (fun n _ => by ring)
      rw [e]; linarith
    have hfinp : ∑ n ∈ Finset.range N, (if n + 1 < j₀ then Cp (n + 1) m else 0) ≤
        ∑ n ∈ Finset.range j₀, Cp (n + 1) m := by
      rw [← Finset.sum_filter]
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · intro n hn
        simp only [Finset.mem_filter, Finset.mem_range] at hn ⊢
        omega
      · intro n _ _; exact hCp0 _ _
    have key : (∑ n ∈ Finset.range N, (if n + 1 < j₀ then Cp (n + 1) m else 0) +
        ∑ n ∈ Finset.range N, (1 / 2 : ℝ) ^ (n + 1)) ≤ 1 + ∑ n ∈ Finset.range j₀, Cp (n + 1) m := by
      linarith
    calc _ ≤ ∑ n ∈ Finset.range N, ((if n + 1 < j₀ then Cp (n + 1) m else 0) + (1 / 2 : ℝ) ^ (n + 1)) *
          (q ^ (2 * h) * wt m X) := Finset.sum_le_sum hx
      _ = (∑ n ∈ Finset.range N, (if n + 1 < j₀ then Cp (n + 1) m else 0) +
          ∑ n ∈ Finset.range N, (1 / 2 : ℝ) ^ (n + 1)) * (q ^ (2 * h) * wt m X) := by
          rw [← Finset.sum_mul, Finset.sum_add_distrib]
      _ ≤ (1 + ∑ n ∈ Finset.range j₀, Cp (n + 1) m) * (q ^ (2 * h) * wt m X) :=
          mul_le_mul_of_nonneg_right key hQ
      _ = _ := by ring

theorem bps_stress_weight : ∀ (Xa Xb Xm Xp aa ab : ℝ) (T : ℕ → ℝ → ℝ → ℝ), 0 < Xa → Xa < Xm → Xm < Xp → Xp < Xb → (∀ n : ℕ, 1 ≤ n → ContDiffOn ℝ ∞ (↿(T n)) (Ioi 0 ×ˢ Ioo (-1) 1)) → (∀ n : ℕ, 1 ≤ n → ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿(T n)) (X, η)‖ ≤ C) → (∀ n : ℕ, 1 ≤ n → ∀ X η : ℝ, X ≤ Xm → T n X η = 0) → (∀ n : ℕ, 2 ≤ n → ∀ X η : ℝ, Xp ≤ X → T n X η = 0) → (∀ m : ℕ, ∃ C N : ℝ, ∀ X η : ℝ, Xa < X → X < Xb → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿(T 1)) (X, η)‖ ≤ C * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N)) → ∀ m : ℕ, ∃ N₀ : ℝ, ∀ N : ℝ, N₀ ≤ N → ∀ n : ℕ, 1 ≤ n → ∃ C : ℝ, ∀ i : ℕ, i ≤ m → ∀ X η : ℝ, Xa < X → X < Xb → -1 < η → η < 1 → ‖iteratedFDeriv ℝ i (↿(T n)) (X, η)‖ ≤ C * (edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N)) :=
by
  intro Xa Xb Xm Xp aa ab T hXa hXam hmp hpb H1 H2 H3 H4 H5 m
  have hew0 : ∀ X : ℝ, 0 ≤ edgeWeight Xa Xb aa ab X := by
    intro X
    unfold edgeWeight
    split_ifs
    · exact (Real.exp_pos _).le
    · exact le_rfl
  have hed : ∀ X : ℝ, Xa < X → X < Xb → 0 < edgeDist Xa Xb X ∧ edgeDist Xa Xb X ≤ 1 := by
    intro X h1 h2
    have hX : 0 < X := by linarith
    unfold edgeDist
    refine ⟨lt_min one_pos (lt_min ?_ ?_), min_le_left _ _⟩
    · exact Real.log_pos ((one_lt_div hXa).2 h1)
    · exact Real.log_pos ((one_lt_div hX).2 h2)
  have hlow : ∃ c : ℝ, 0 < c ∧ ∀ X : ℝ, Xm ≤ X → X ≤ Xp → c ≤ edgeWeight Xa Xb aa ab X := by
    have hXp : 0 < Xp := by linarith
    have la0 : 0 < Real.log (Xm / Xa) := Real.log_pos ((one_lt_div hXa).2 hXam)
    have lb0 : 0 < Real.log (Xb / Xp) := Real.log_pos ((one_lt_div hXp).2 hpb)
    refine ⟨Real.exp (-(|aa| / Real.log (Xm / Xa) ^ 2) - |ab| / Real.log (Xb / Xp) ^ 2),
      Real.exp_pos _, ?_⟩
    intro X hX1 hX2
    have hX : 0 < X := by linarith
    unfold edgeWeight
    rw [if_pos ⟨by linarith, by linarith⟩]
    apply Real.exp_le_exp.2
    have L1 : Real.log (Xm / Xa) ≤ Real.log (X / Xa) :=
      Real.log_le_log (div_pos (by linarith) hXa) (div_le_div_of_nonneg_right hX1 hXa.le)
    have L2 : Real.log (Xb / Xp) ≤ Real.log (Xb / X) :=
      Real.log_le_log (div_pos (by linarith) hXp) (div_le_div_of_nonneg_left (by linarith) hX hX2)
    have S1 : Real.log (Xm / Xa) ^ 2 ≤ Real.log (X / Xa) ^ 2 := pow_le_pow_left₀ la0.le L1 2
    have S2 : Real.log (Xb / Xp) ^ 2 ≤ Real.log (Xb / X) ^ 2 := pow_le_pow_left₀ lb0.le L2 2
    have pa : 0 < Real.log (Xm / Xa) ^ 2 := by positivity
    have pb : 0 < Real.log (Xb / Xp) ^ 2 := by positivity
    have A1 : aa / Real.log (X / Xa) ^ 2 ≤ |aa| / Real.log (Xm / Xa) ^ 2 :=
      le_trans (div_le_div_of_nonneg_right (le_abs_self aa) (by positivity))
        (div_le_div_of_nonneg_left (abs_nonneg aa) pa S1)
    have A2 : ab / Real.log (Xb / X) ^ 2 ≤ |ab| / Real.log (Xb / Xp) ^ 2 :=
      le_trans (div_le_div_of_nonneg_right (le_abs_self ab) (by positivity))
        (div_le_div_of_nonneg_left (abs_nonneg ab) pb S2)
    linarith
  obtain ⟨c, hc0, hc⟩ := hlow
  choose Cn Nn hN using H5
  refine ⟨∑ i ∈ Finset.range (m + 1), |Nn i|, ?_⟩
  intro N hN0 n hn
  have hNle : ∀ i, i ≤ m → Nn i ≤ N := by
    intro i hi
    have := Finset.single_le_sum (f := fun i => |Nn i|) (fun j _ => abs_nonneg _)
      (Finset.mem_range.2 (by omega : i < m + 1))
    linarith [le_abs_self (Nn i)]
  have hNnn : 0 ≤ N := le_trans (Finset.sum_nonneg (fun j _ => abs_nonneg _)) hN0
  rcases (show n = 1 ∨ 2 ≤ n by omega) with rfl | hn2
  · refine ⟨∑ i ∈ Finset.range (m + 1), |Cn i|, ?_⟩
    intro i hi X η h1 h2 h3 h4
    obtain ⟨he0, he1⟩ := hed X h1 h2
    have hb := hN i X η h1 h2 h3 h4
    have ea : edgeDist Xa Xb X ^ (-Nn i) ≤ edgeDist Xa Xb X ^ (-N) :=
      Real.rpow_le_rpow_of_exponent_ge he0 he1 (by linarith [hNle i hi])
    have v0 := hew0 X
    have r0 : 0 ≤ edgeDist Xa Xb X ^ (-Nn i) := Real.rpow_nonneg he0.le _
    have r1 : 0 ≤ edgeDist Xa Xb X ^ (-N) := Real.rpow_nonneg he0.le _
    have hCi : |Cn i| ≤ ∑ i ∈ Finset.range (m + 1), |Cn i| :=
      Finset.single_le_sum (f := fun i => |Cn i|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.2 (by omega))
    calc ‖iteratedFDeriv ℝ i (↿(T 1)) (X, η)‖
        ≤ Cn i * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-Nn i) := hb
      _ = Cn i * (edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-Nn i)) := by ring
      _ ≤ |Cn i| * (edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-Nn i)) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (mul_nonneg v0 r0)
      _ ≤ |Cn i| * (edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left ea v0) (abs_nonneg _)
      _ ≤ _ := mul_le_mul_of_nonneg_right hCi (mul_nonneg v0 r1)
  · have hn1 : 1 ≤ n := hn
    choose C hC using H2 n hn1
    obtain ⟨S, hS⟩ : ∃ S : ℝ, S = ∑ i ∈ Finset.range (m + 1), |C i| := ⟨_, rfl⟩
    have hS0 : 0 ≤ S := by rw [hS]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
    refine ⟨S / c, ?_⟩
    intro i hi X η h1 h2 h3 h4
    obtain ⟨he0, he1⟩ := hed X h1 h2
    have hw0 : 0 ≤ edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N) :=
      mul_nonneg (hew0 X) (Real.rpow_nonneg he0.le _)
    have hK0 : 0 ≤ S / c := div_nonneg hS0 hc0.le
    have zero_case : ∀ V : Set (ℝ × ℝ), IsOpen V → (X, η) ∈ V → (∀ p ∈ V, T n p.1 p.2 = 0) →
        ‖iteratedFDeriv ℝ i (↿(T n)) (X, η)‖ ≤
          S / c * (edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N)) := by
      intro V hV hmem hz
      have hev : (↿(T n)) =ᶠ[nhds (X, η)] fun _ => (0 : ℝ) :=
        Filter.eventuallyEq_of_mem (hV.mem_nhds hmem) (fun p hp => hz p hp)
      rw [(hev.iteratedFDeriv ℝ i).eq_of_nhds, iteratedFDeriv_fun_zero]
      simp only [Pi.zero_apply, norm_zero]
      exact mul_nonneg hK0 hw0
    rcases lt_or_ge X Xm with hXm | hXm
    · exact zero_case {p | p.1 < Xm} (isOpen_lt continuous_fst continuous_const) hXm
        (fun p hp => H3 n hn1 p.1 p.2 (le_of_lt hp))
    rcases lt_or_ge Xp X with hXp | hXp
    · exact zero_case {p | Xp < p.1} (isOpen_lt continuous_const continuous_fst) hXp
        (fun p hp => H4 n hn2 p.1 p.2 (le_of_lt hp))
    have hb := hC i X η (by linarith) h3 h4
    have hCi : |C i| ≤ S := by
      rw [hS]
      exact Finset.single_le_sum (f := fun i => |C i|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.2 (by omega))
    have hone : 1 ≤ edgeDist Xa Xb X ^ (-N) :=
      Real.one_le_rpow_of_pos_of_le_one_of_nonpos he0 he1 (by linarith)
    have hcw : c ≤ edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N) := by
      have := mul_le_mul (hc X hXm hXp) hone zero_le_one (hew0 X)
      linarith
    have hSc : S = S / c * c := (div_mul_cancel₀ S hc0.ne').symm
    calc ‖iteratedFDeriv ℝ i (↿(T n)) (X, η)‖ ≤ C i := hb
      _ ≤ |C i| := le_abs_self _
      _ ≤ S := hCi
      _ = S / c * c := hSc
      _ ≤ _ := mul_le_mul_of_nonneg_left hcw hK0

theorem bps_Vb_split : ∀ (h : ℝ) (a : ℕ → ℝ) (S Vc : ℕ → ℝ → ℝ → ℝ), (∀ j, 1 ≤ a j) → (∀ j, 2 * a j ≤ a (j + 1)) → ∀ w : ℝ × ℝ × ℝ, logLift (bgVb h a S Vc) w = Vc 0 w.2.1 w.2.2 + bpsTail h bpsChi a Vc w + bpsTail h bpsPsi a (bpsRcoef h S) w :=
by
  intro h a S Vc H1 H2 w
  have hs1 : ∀ j : ℕ, (j : ℝ) + 1 ≤ a j := by
    intro j
    induction j with
    | zero => simpa using H1 0
    | succ j ih =>
      have e1 := H2 j
      have e2 := H1 j
      push_cast
      linarith
  have hq : 0 < Real.exp w.1 := Real.exp_pos _
  have hs2 : ∀ n : ℕ, ⌈1 / Real.exp w.1⌉₊ ≤ n → 1 < a (n + 1) * Real.exp w.1 := by
    intro n hn
    have h1 : 1 / Real.exp w.1 ≤ (⌈1 / Real.exp w.1⌉₊ : ℝ) := Nat.le_ceil _
    have h2 : (⌈1 / Real.exp w.1⌉₊ : ℝ) ≤ n := by exact_mod_cast hn
    have h3 := hs1 (n + 1)
    push_cast at h3
    have h4 : 1 / Real.exp w.1 < a (n + 1) := by linarith
    rw [div_lt_iff₀ hq] at h4
    linarith
  have hchi : ∀ σ : ℝ, 1 < σ → bpsChi σ = 0 := by
    intro σ hσ
    unfold bpsChi
    exact Real.smoothTransition.zero_of_nonpos (by linarith)
  have hpsi : ∀ σ : ℝ, 1 < σ → bpsPsi σ = 0 := by
    intro σ hσ
    unfold bpsPsi
    have hev : (fun σ' : ℝ => Real.smoothTransition (2 - 2 * σ')) =ᶠ[nhds σ] fun _ => (0 : ℝ) := by
      filter_upwards [isOpen_Ioi.mem_nhds (show σ ∈ Set.Ioi (1:ℝ) from hσ)] with τ hτ
      have hτ' : (1:ℝ) < τ := hτ
      exact Real.smoothTransition.zero_of_nonpos (by linarith)
    rw [hev.deriv_eq, deriv_const, mul_zero]
  have hfs : Summable (fun n : ℕ => bpsChi (a (n + 1) * Real.exp w.1) *
      Real.exp w.1 ^ (2 * ((n : ℝ) + 1) * h) * Vc (n + 1) w.2.1 w.2.2) := by
    apply summable_of_ne_finset_zero (s := Finset.range ⌈1 / Real.exp w.1⌉₊)
    intro n hn
    rw [Finset.mem_range, not_lt] at hn
    simp only [hchi _ (hs2 n hn), zero_mul]
  have hgs : Summable (fun n : ℕ => bpsPsi (a (n + 1) * Real.exp w.1) *
      Real.exp w.1 ^ (2 * ((n : ℝ) + 1) * h) * bpsRcoef h S (n + 1) w.2.1 w.2.2) := by
    apply summable_of_ne_finset_zero (s := Finset.range ⌈1 / Real.exp w.1⌉₊)
    intro n hn
    rw [Finset.mem_range, not_lt] at hn
    simp only [hpsi _ (hs2 n hn), zero_mul]
  have key : logLift (bgVb h a S Vc) w = Vc 0 w.2.1 w.2.2 + ∑' n : ℕ,
      ((bpsChi (a (n + 1) * Real.exp w.1) *
        Real.exp w.1 ^ (2 * ((n : ℝ) + 1) * h) * Vc (n + 1) w.2.1 w.2.2) +
      (bpsPsi (a (n + 1) * Real.exp w.1) *
        Real.exp w.1 ^ (2 * ((n : ℝ) + 1) * h) * bpsRcoef h S (n + 1) w.2.1 w.2.2)) := by
    unfold logLift bgVb
    congr 1
    apply tsum_congr
    intro n
    simp only [bgCut, bpsChi, bpsPsi, bpsRcoef]
    ring
  rw [key, hfs.tsum_add hgs, add_assoc]
  rfl

theorem bps_Rcoef_bounds : ∀ (h : ℝ) (S : ℕ → ℝ → ℝ → ℝ), 0 < h → h < 1 / 2 → (∀ n : ℕ, 1 ≤ n → ContDiffOn ℝ ∞ (↿(S n)) (Ici 0 ×ˢ Ioo (-1) 1)) → (∀ n : ℕ, 1 ≤ n → ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿(S n)) (X, η)‖ ≤ C) → ∀ n : ℕ, 1 ≤ n → ContDiffOn ℝ ∞ (↿(bpsRcoef h S n)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ∀ m : ℕ, ∃ C : ℝ, ∀ i : ℕ, i ≤ m → ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → ‖iteratedFDeriv ℝ i (↿(bpsRcoef h S n)) (X, η)‖ ≤ C * (1 + X) :=
by
  intro h S hh0 hh1 hSs hSb n hn
  have hO : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hOu : UniqueDiffOn ℝ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := hO.uniqueDiffOn

  have leib : ∀ (f g : ℝ × ℝ → ℝ), ContDiffOn ℝ ∞ f (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) →
      ContDiffOn ℝ ∞ g (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) →
      ∀ (a b : ℕ → ℝ) (p : ℝ × ℝ) (w : ℝ), p ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 → 0 ≤ w →
      (∀ k, ‖iteratedFDeriv ℝ k f p‖ ≤ a k * w) → (∀ k, ‖iteratedFDeriv ℝ k g p‖ ≤ b k) →
      ∀ i, ‖iteratedFDeriv ℝ i (fun y => f y * g y) p‖ ≤
        (∑ k ∈ Finset.range (i + 1), (i.choose k : ℝ) * a k * b (i - k)) * w := by
    intro f g hf hg a b p w hp hw ha hb i
    have hL := norm_iteratedFDerivWithin_mul_le hf hg hOu hp (n := i) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen i hO hp] at hL
    rw [Finset.sum_mul]
    refine hL.trans (Finset.sum_le_sum fun k _ => ?_)
    rw [iteratedFDerivWithin_of_isOpen k hO hp, iteratedFDerivWithin_of_isOpen (i - k) hO hp]
    have h1 := ha k
    have h2 := hb (i - k)
    have hc : (0:ℝ) ≤ (i.choose k : ℝ) := Nat.cast_nonneg _
    calc (i.choose k : ℝ) * ‖iteratedFDeriv ℝ k f p‖ * ‖iteratedFDeriv ℝ (i - k) g p‖
        ≤ (i.choose k : ℝ) * (a k * w) * b (i - k) := by
          apply mul_le_mul (mul_le_mul_of_nonneg_left h1 hc) h2 (norm_nonneg _)
          exact mul_nonneg hc ((norm_nonneg _).trans h1)
      _ = (i.choose k : ℝ) * a k * b (i - k) * w := by ring

  obtain ⟨bt, hbt⟩ : ∃ bt : ℝ → ℝ, bt = fun η => -(2 * η / (1 - 2 * h * η ^ 2)) := ⟨_, rfl⟩
  have hVo : IsOpen {η : ℝ | 2 * h * η ^ 2 < 1} :=
    isOpen_lt (continuous_const.mul (continuous_pow 2)) continuous_const
  have hIccV : Icc (-1:ℝ) 1 ⊆ {η : ℝ | 2 * h * η ^ 2 < 1} := by
    intro η hη
    show 2 * h * η ^ 2 < 1
    have : η ^ 2 ≤ 1 := by nlinarith [hη.1, hη.2]
    nlinarith
  have hbts : ContDiffOn ℝ ∞ bt {η : ℝ | 2 * h * η ^ 2 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun η : ℝ => 2 * η) {η : ℝ | 2 * h * η ^ 2 < 1} :=
      (contDiff_const.mul contDiff_id).contDiffOn
    have h2 : ContDiffOn ℝ ∞ (fun η : ℝ => 1 - 2 * h * η ^ 2) {η : ℝ | 2 * h * η ^ 2 < 1} :=
      (contDiff_const.sub (contDiff_const.mul (contDiff_id.pow 2))).contDiffOn
    have h3 := (h1.div h2 (fun η hη => by
      have hη' : 2 * h * η ^ 2 < 1 := hη
      exact (show (0:ℝ) < 1 - 2 * h * η ^ 2 by linarith).ne')).neg
    rw [hbt]
    exact h3
  have hbtb : ∀ k : ℕ, ∃ M : ℝ, ∀ η ∈ Icc (-1:ℝ) 1,
      ‖iteratedFDerivWithin ℝ k bt {η : ℝ | 2 * h * η ^ 2 < 1} η‖ ≤ M := by
    intro k
    exact isCompact_Icc.exists_bound_of_continuousOn
      ((hbts.continuousOn_iteratedFDerivWithin (by exact_mod_cast le_top) hVo.uniqueDiffOn).mono hIccV)
  have hWo : IsOpen (⇑(ContinuousLinearMap.snd ℝ ℝ ℝ) ⁻¹' {η : ℝ | 2 * h * η ^ 2 < 1}) :=
    hVo.preimage (ContinuousLinearMap.snd ℝ ℝ ℝ).continuous
  have hOW : Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ⊆
      ⇑(ContinuousLinearMap.snd ℝ ℝ ℝ) ⁻¹' {η : ℝ | 2 * h * η ^ 2 < 1} :=
    fun p hp => hIccV (Ioo_subset_Icc_self hp.2)
  have hβs : ContDiffOn ℝ ∞ (bt ∘ ⇑(ContinuousLinearMap.snd ℝ ℝ ℝ)) (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) :=
    hbts.comp (ContinuousLinearMap.snd ℝ ℝ ℝ).contDiff.contDiffOn (fun p hp => hOW hp)
  have hβb : ∀ k : ℕ, ∃ M : ℝ, ∀ p ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1,
      ‖iteratedFDeriv ℝ k (bt ∘ ⇑(ContinuousLinearMap.snd ℝ ℝ ℝ)) p‖ ≤ M := by
    intro k
    obtain ⟨M, hM⟩ := hbtb k
    refine ⟨M, fun p hp => ?_⟩
    have hpW := hOW hp
    have e := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := bt ∘ ⇑(ContinuousLinearMap.snd ℝ ℝ ℝ)) k hWo hpW
    rw [← e, (ContinuousLinearMap.snd ℝ ℝ ℝ).iteratedFDerivWithin_comp_right hbts hVo.uniqueDiffOn
      hWo.uniqueDiffOn hpW (by exact_mod_cast le_top)]
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    have hprod : ∏ _i : Fin k, ‖ContinuousLinearMap.snd ℝ ℝ ℝ‖ ≤ 1 := by
      rw [Finset.prod_const]
      exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_snd_le ℝ ℝ ℝ)
    have hb := hM (ContinuousLinearMap.snd ℝ ℝ ℝ p) (Ioo_subset_Icc_self hp.2)
    calc _ ≤ ‖iteratedFDerivWithin ℝ k bt {η : ℝ | 2 * h * η ^ 2 < 1}
          (ContinuousLinearMap.snd ℝ ℝ ℝ p)‖ * 1 :=
          mul_le_mul_of_nonneg_left hprod (norm_nonneg _)
      _ ≤ M := by rw [mul_one]; exact hb

  have hSO : ContDiffOn ℝ ∞ (↿(S n)) (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) :=
    (hSs n hn).mono (prod_mono Ioi_subset_Ici_self subset_rfl)
  choose Mβ hMβ using hβb
  choose MS hMS using hSb n hn
  have hQs : ContDiffOn ℝ ∞ (fun y => (bt ∘ ⇑(ContinuousLinearMap.snd ℝ ℝ ℝ)) y * ↿(S n) y)
      (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := hβs.mul hSO
  obtain ⟨MQ, hMQ⟩ : ∃ MQ : ℕ → ℝ, ∀ i, MQ i =
      (∑ k ∈ Finset.range (i + 1), (i.choose k : ℝ) * Mβ k * MS (i - k)) * 1 := ⟨_, fun i => rfl⟩
  have hQb : ∀ (i : ℕ) (p : ℝ × ℝ), p ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 →
      ‖iteratedFDeriv ℝ i (fun y => (bt ∘ ⇑(ContinuousLinearMap.snd ℝ ℝ ℝ)) y * ↿(S n) y) p‖ ≤ MQ i := by
    intro i p hp
    rw [hMQ]
    exact leib _ (↿(S n)) hβs hSO Mβ MS p 1 hp zero_le_one
      (fun k => by rw [mul_one]; exact hMβ k p hp)
      (fun k => hMS k p.1 p.2 hp.1 hp.2.1 hp.2.2) i

  have hfst : ∀ (k : ℕ) (p : ℝ × ℝ), 0 < p.1 →
      ‖iteratedFDeriv ℝ k (fun y : ℝ × ℝ => y.1) p‖ ≤ 1 * (1 + p.1) := by
    intro k p hp
    rw [one_mul]
    rcases k with _ | k
    · rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs, abs_of_pos hp]; linarith
    · rw [← norm_iteratedFDeriv_fderiv]
      have hd : fderiv ℝ (fun y : ℝ × ℝ => y.1) = fun _ => ContinuousLinearMap.fst ℝ ℝ ℝ := by
        funext q; exact fderiv_fst
      rw [hd]
      rcases k with _ | k
      · rw [norm_iteratedFDeriv_zero]; linarith [ContinuousLinearMap.norm_fst_le ℝ ℝ ℝ]
      · rw [iteratedFDeriv_const_of_ne (Nat.succ_ne_zero k)]
        simp only [Pi.zero_apply, norm_zero]
        linarith

  have hid : ↿(bpsRcoef h S n) = fun p : ℝ × ℝ =>
      p.1 * ((bt ∘ ⇑(ContinuousLinearMap.snd ℝ ℝ ℝ)) p * ↿(S n) p) := by
    funext p
    obtain ⟨X, η⟩ := p
    rw [hbt]
    show bpsRcoef h S n X η = X * (-(2 * η / (1 - 2 * h * η ^ 2)) * S n X η)
    unfold bpsRcoef
    ring
  refine ⟨?_, fun m => ?_⟩
  · rw [hid]
    exact contDiffOn_fst.mul hQs
  · refine ⟨∑ i ∈ Finset.range (m + 1),
      |∑ k ∈ Finset.range (i + 1), (i.choose k : ℝ) * 1 * MQ (i - k)|,
      fun i hi X η hX hη1 hη2 => ?_⟩
    have hp : ((X, η) : ℝ × ℝ) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := ⟨hX, hη1, hη2⟩
    have hb := leib (fun y : ℝ × ℝ => y.1) _ contDiffOn_fst hQs (fun _ => 1) MQ (X, η) (1 + X) hp
      (by linarith) (fun k => hfst k (X, η) hX) (fun k => hQb k (X, η) hp) i
    rw [hid]
    refine hb.trans (mul_le_mul_of_nonneg_right ((le_abs_self _).trans
      (Finset.single_le_sum (f := fun i => |∑ k ∈ Finset.range (i + 1), (i.choose k : ℝ) * 1 * MQ (i - k)|)
        (fun j _ => abs_nonneg _) (Finset.mem_range.2 (by omega)))) (by linarith))

theorem bps_lift_mul : ∀ (g : ℝ → ℝ → ℝ) (f : ℝ × ℝ × ℝ → ℝ), ContDiffOn ℝ ∞ (↿g) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ f (univ ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) → ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => g w.2.1 w.2.2) (univ ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) ∧ (∀ (m : ℕ) (w : ℝ × ℝ × ℝ), w.2 ∈ Ioi 0 ×ˢ Ioo (-1) 1 → ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => g w.2.1 w.2.2) w‖ ≤ ‖iteratedFDeriv ℝ m (↿g) w.2‖) ∧ ∀ (m : ℕ) (w : ℝ × ℝ × ℝ), w.2 ∈ Ioi 0 ×ˢ Ioo (-1) 1 → ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => g w.2.1 w.2.2 * f w) w‖ ≤ ∑ k ∈ Finset.range (m + 1), (m.choose k : ℝ) * ‖iteratedFDeriv ℝ k (↿g) w.2‖ * ‖iteratedFDeriv ℝ (m - k) f w‖ :=
by
  intro g f hg hf
  have hO : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hS : IsOpen ((univ : Set ℝ) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) := isOpen_univ.prod hO
  let L : ℝ × ℝ × ℝ →L[ℝ] ℝ × ℝ := ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)
  have hpre : (L : ℝ × ℝ × ℝ → ℝ × ℝ) ⁻¹' (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) =
      (univ : Set ℝ) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := by
    ext w
    simp [L]
  have hG : (fun w : ℝ × ℝ × ℝ => g w.2.1 w.2.2) = (↿g) ∘ (L : ℝ × ℝ × ℝ → ℝ × ℝ) := by
    funext w
    rfl
  have hGs : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => g w.2.1 w.2.2)
      ((univ : Set ℝ) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) := by
    rw [hG, ← hpre]
    exact hg.comp_continuousLinearMap L
  have hSo : IsOpen ((L : ℝ × ℝ × ℝ → ℝ × ℝ) ⁻¹' (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) := hpre ▸ hS
  have hB : ∀ (m : ℕ) (w : ℝ × ℝ × ℝ), w.2 ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 →
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => g w.2.1 w.2.2) w‖ ≤
        ‖iteratedFDeriv ℝ m (↿g) w.2‖ := by
    intro m w hw
    have hwS : w ∈ (L : ℝ × ℝ × ℝ → ℝ × ℝ) ⁻¹' (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := hw
    have hLw : L w ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := hw
    have hm : ((m : ℕ∞) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
    have E1 := L.iteratedFDerivWithin_comp_right hg hO.uniqueDiffOn hSo.uniqueDiffOn hLw hm
    rw [iteratedFDerivWithin_of_isOpen m hSo hwS, iteratedFDerivWithin_of_isOpen m hO hLw] at E1
    rw [hG, E1]
    refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
    have hL : ‖L‖ ≤ 1 := ContinuousLinearMap.norm_snd_le ℝ ℝ (ℝ × ℝ)
    have hp : ∏ _i : Fin m, ‖L‖ ≤ 1 :=
      Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) (fun _ _ => hL)
    exact mul_le_of_le_one_right (norm_nonneg _) hp
  refine ⟨hGs, hB, ?_⟩
  intro m w hw
  have hwS : w ∈ (univ : Set ℝ) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := ⟨mem_univ _, hw⟩
  have hm : ((m : ℕ∞) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have h1 := norm_iteratedFDerivWithin_mul_le hGs hf hS.uniqueDiffOn hwS hm
  refine le_trans (le_of_eq ?_) (le_trans h1 (Finset.sum_le_sum fun k _ => ?_))
  · rw [iteratedFDerivWithin_of_isOpen m hS hwS]
  · rw [iteratedFDerivWithin_of_isOpen k hS hwS, iteratedFDerivWithin_of_isOpen (m - k) hS hwS]
    exact mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left (hB k w hw) (Nat.cast_nonneg _)) (norm_nonneg _)

theorem bps_sqrt_profile : ContDiffOn ℝ ∞ (↿(fun (X _ : ℝ) => Real.sqrt (2 * X))) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ∀ X₀ X₁ : ℝ, 0 < X₀ → ∀ k : ℕ, ∃ M : ℝ, ∀ X η : ℝ, X₀ ≤ X → X ≤ X₁ → -1 < η → η < 1 → ‖iteratedFDeriv ℝ k (↿(fun (X _ : ℝ) => Real.sqrt (2 * X))) (X, η)‖ ≤ M :=
by
  have hpt : ∀ p : ℝ × ℝ, p.1 ≠ 0 →
      ContDiffAt ℝ ∞ (↿(fun (X _ : ℝ) => Real.sqrt (2 * X))) p := by
    intro p hp
    have hg : ContDiffAt ℝ ∞ (fun q : ℝ × ℝ => 2 * q.1) p :=
      contDiffAt_const.mul contDiffAt_fst
    exact hg.sqrt (mul_ne_zero two_ne_zero hp)
  refine ⟨fun p hp => (hpt p (ne_of_gt hp.1)).contDiffWithinAt, ?_⟩
  intro X₀ X₁ hX₀ k
  have hK : IsCompact (Icc X₀ X₁ ×ˢ Icc (-1 : ℝ) 1) := isCompact_Icc.prod isCompact_Icc
  have hc : ContinuousOn (iteratedFDeriv ℝ k (↿(fun (X _ : ℝ) => Real.sqrt (2 * X))))
      (Icc X₀ X₁ ×ˢ Icc (-1 : ℝ) 1) := by
    refine continuousOn_of_forall_continuousAt (fun p hp => ?_)
    have hp1 : p.1 ≠ 0 := ne_of_gt (lt_of_lt_of_le hX₀ hp.1.1)
    exact (hpt p hp1).continuousAt_iteratedFDeriv (by exact_mod_cast le_top)
  obtain ⟨M, hM⟩ := hK.exists_bound_of_continuousOn hc
  exact ⟨M, fun X η h1 h2 h3 h4 => hM (X, η) ⟨⟨h1, h2⟩, h3.le, h4.le⟩⟩

theorem bg_profile_sums : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) (S G Uc Vc W Tth Tz : ℕ → ℝ → ℝ → ℝ), SimScaleProps h → LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → BgOrderZero h Xb cinf F U → BgPositive h Xa Xb m1 m2 aa ab F U T0th T0z S G Uc Vc W Tth Tz → ∃ Cp : ℕ → ℕ → ℝ, ∀ a : ℕ → ℝ, (∀ j, 1 ≤ a j) → (∀ j, 2 * a j ≤ a (j + 1)) → (∀ j : ℕ, 1 ≤ j → ∀ m : ℕ, m ≤ j → ∀ q : ℝ, 0 < q → q ≤ 1 / a j → |Cp j m| * q ^ (2 * h * (j : ℝ) / 2) ≤ (1 / 2) ^ j) → (ContDiffOn ℝ ∞ (logLift (bgEb h a G)) (Iio (Real.log 1) ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) ∧ ContDiffOn ℝ ∞ (logLift (bgSum h a Uc)) (Iio (Real.log 1) ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) ∧ ContDiffOn ℝ ∞ (logLift (bgVb h a S Vc)) (Iio (Real.log 1) ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) ∧ ∀ X₀ X₁ : ℝ, 0 < X₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ q X η : ℝ, 0 < q → q < 1 → X₀ ≤ X → X ≤ X₁ → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => logLift (bgEb h a G) w - Real.sqrt (2 * w.2.1) * F w.2.1 w.2.2) (Real.log q, X, η)‖ ≤ C * q ^ (2 * h) ∧ ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => logLift (bgSum h a Uc) w - U w.2.1 w.2.2) (Real.log q, X, η)‖ ≤ C * q ^ (2 * h) ∧ ‖iteratedFDeriv ℝ m (logLift (bgVb h a S Vc)) (Real.log q, X, η)‖ ≤ C) ∧ (ContDiffOn ℝ ∞ (logLift (bgSum h a Tth)) (Iio (Real.log 1) ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) ∧ ContDiffOn ℝ ∞ (logLift (bgSum h a Tz)) (Iio (Real.log 1) ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) ∧ (∀ q X η : ℝ, (X ≤ Xa ∨ Xb ≤ X) → bgSum h a Tth q X η = 0 ∧ bgSum h a Tz q X η = 0) ∧ (∀ m : ℕ, ∃ C N : ℝ, ∀ q X η : ℝ, 0 < q → q < 1 → Xa < X → X < Xb → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => logLift (bgSum h a Tth) w - T0th w.2.1 w.2.2) (Real.log q, X, η)‖ ≤ C * q ^ h * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N) ∧ ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => logLift (bgSum h a Tz) w - T0z w.2.1 w.2.2) (Real.log q, X, η)‖ ≤ C * q ^ h * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N))) :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z S G Uc Vc W Tth Tz hS hL hO hP
  obtain ⟨⟨hh0, hh1, -, -, -, -, -, hXa, -⟩, ⟨hFs, hUs, -⟩, ⟨hT0s, hT0zs, -⟩, -⟩ := hL
  obtain ⟨-, -, -, -, -, ⟨hLVs, hLVb⟩⟩ := hO
  obtain ⟨⟨-, hG0, hU0, hV0, -, hT0⟩, ⟨Xm, Xp, hXam, hmp, hpb, hTsupp, -, -, hTm, hTp⟩, hP2, hP3, -⟩ := hP
  have hh2 : h < 1 / 2 := by linarith
  obtain ⟨⟨hχs, hχ0, hχM⟩, ⟨hψs, hψ0, hψM⟩⟩ := bps_cut_profiles
  have hsq := bps_sqrt_profile
  have hbd : ∀ n : ℕ, 1 ≤ n → ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 < X → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿(S n)) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(G n)) (X, η)‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (↿(W n)) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(Uc n)) (X, η)‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (↿(Vc n)) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(Tth n)) (X, η)‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (↿(Tz n)) (X, η)‖ ≤ C := fun n hn => (hP2 n hn).2.2.2.2.2.2.2
  have hconv : ∀ f : ℝ → ℝ → ℝ, (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 < X → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿f) (X, η)‖ ≤ C) → ∀ m : ℕ, ∃ C : ℝ, ∀ i : ℕ, i ≤ m → ∀ X η : ℝ,
      (X, η) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 → ‖iteratedFDeriv ℝ i (↿f) (X, η)‖ ≤ C * 1 := by
    intro f hf m
    choose C hC using hf
    refine ⟨∑ i ∈ Finset.range (m + 1), |C i|, fun i hi X η hXη => ?_⟩
    have h1 := hC i X η hXη.1 hXη.2.1 hXη.2.2
    have h2 : |C i| ≤ ∑ i ∈ Finset.range (m + 1), |C i| :=
      Finset.single_le_sum (f := fun i => |C i|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.2 (by omega))
    rw [mul_one]
    linarith [le_abs_self (C i)]
  have hew0 : ∀ X : ℝ, 0 ≤ edgeWeight Xa Xb aa ab X := by
    intro X
    unfold edgeWeight
    split_ifs
    · exact (Real.exp_pos _).le
    · exact le_rfl
  have hed0 : ∀ X : ℝ, Xa < X → X < Xb → 0 < edgeDist Xa Xb X := by
    intro X h1 h2
    unfold edgeDist
    have hX : 0 < X := by linarith
    refine lt_min one_pos (lt_min ?_ ?_)
    · exact Real.log_pos ((one_lt_div hXa).2 h1)
    · exact Real.log_pos ((one_lt_div hX).2 h2)
  have hD' : Ioo Xa Xb ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 :=
    fun p hp => ⟨lt_trans hXa hp.1.1, hp.2⟩
  have hO_sub : Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ⊆ Ici 0 ×ˢ Ioo (-1) 1 :=
    prod_mono Ioi_subset_Ici_self subset_rfl

  obtain ⟨Cp1, hCp1⟩ := bps_log_tail h bpsChi G (fun _ _ => 1) (Ioi 0 ×ˢ Ioo (-1) 1) hh0 hχs hχ0 hχM
    (fun n hn => (hP2 n hn).2.1.mono hO_sub) subset_rfl (fun _ _ _ _ => zero_le_one)
    (fun n hn => hconv (G n) (fun m => (hbd n hn m).imp fun C hC X η h1 h2 h3 => (hC X η h1 h2 h3).2.1))
  obtain ⟨Cp2, hCp2⟩ := bps_log_tail h bpsChi Uc (fun _ _ => 1) (Ioi 0 ×ˢ Ioo (-1) 1) hh0 hχs hχ0 hχM
    (fun n hn => (hP2 n hn).2.2.2.1) subset_rfl (fun _ _ _ _ => zero_le_one)
    (fun n hn => hconv (Uc n) (fun m => (hbd n hn m).imp fun C hC X η h1 h2 h3 => (hC X η h1 h2 h3).2.2.2.1))
  obtain ⟨Cp3, hCp3⟩ := bps_log_tail h bpsChi Vc (fun _ _ => 1) (Ioi 0 ×ˢ Ioo (-1) 1) hh0 hχs hχ0 hχM
    (fun n hn => (hP2 n hn).2.2.2.2.1) subset_rfl (fun _ _ _ _ => zero_le_one)
    (fun n hn => hconv (Vc n) (fun m => (hbd n hn m).imp fun C hC X η h1 h2 h3 => (hC X η h1 h2 h3).2.2.2.2.1))
  have hR := bps_Rcoef_bounds h S hh0 hh2 (fun n hn => (hP2 n hn).1)
    (fun n hn m => (hbd n hn m).imp fun C hC X η h1 h2 h3 => (hC X η h1 h2 h3).1)
  obtain ⟨Cp4, hCp4⟩ := bps_log_tail h bpsPsi (bpsRcoef h S) (fun _ X => 1 + X) (Ioi 0 ×ˢ Ioo (-1) 1)
    hh0 hψs hψ0 hψM (fun n hn => (hR n hn).1) subset_rfl
    (fun _ X η hX => by
      show (0:ℝ) ≤ 1 + X
      have : (0:ℝ) < X := hX.1
      linarith)
    (fun n hn m => by
      obtain ⟨C, hC⟩ := (hR n hn).2 m
      exact ⟨C, fun i hi X η hX => hC i hi X η hX.1 hX.2.1 hX.2.2⟩)
  have hSWth := bps_stress_weight Xa Xb Xm Xp aa ab Tth hXa hXam hmp hpb
    (fun n hn => (hP2 n hn).2.2.2.2.2.1)
    (fun n hn m => (hbd n hn m).imp fun C hC X η h1 h2 h3 => (hC X η h1 h2 h3).2.2.2.2.2.1)
    (fun n hn X η hX => (hTm n hn X η hX).1) (fun n hn X η hX => (hTp n hn X η hX).1)
    (fun m => (hP3 m).imp fun C hC => hC.imp fun N hN X η h1 h2 h3 h4 => (hN X η h1 h2 h3 h4).1)
  have hSWz := bps_stress_weight Xa Xb Xm Xp aa ab Tz hXa hXam hmp hpb
    (fun n hn => (hP2 n hn).2.2.2.2.2.2.1)
    (fun n hn m => (hbd n hn m).imp fun C hC X η h1 h2 h3 => (hC X η h1 h2 h3).2.2.2.2.2.2)
    (fun n hn X η hX => (hTm n hn X η hX).2) (fun n hn X η hX => (hTp n hn X η hX).2)
    (fun m => (hP3 m).imp fun C hC => hC.imp fun N hN X η h1 h2 h3 h4 => (hN X η h1 h2 h3 h4).2)
  choose N0th hN0th using hSWth
  choose N0z hN0z using hSWz
  obtain ⟨Cp5, hCp5⟩ := bps_log_tail h bpsChi Tth
    (fun m X => edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-(max (N0th m) (N0z m))))
    (Ioo Xa Xb ×ˢ Ioo (-1) 1) hh0 hχs hχ0 hχM (fun n hn => (hP2 n hn).2.2.2.2.2.1) hD'
    (fun m X _ hX => mul_nonneg (hew0 X) (Real.rpow_nonneg (hed0 X hX.1.1 hX.1.2).le _))
    (fun n hn m => by
      obtain ⟨C, hC⟩ := hN0th m (max (N0th m) (N0z m)) (le_max_left _ _) n hn
      exact ⟨C, fun i hi X η hX => hC i hi X η hX.1.1 hX.1.2 hX.2.1 hX.2.2⟩)
  obtain ⟨Cp6, hCp6⟩ := bps_log_tail h bpsChi Tz
    (fun m X => edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-(max (N0th m) (N0z m))))
    (Ioo Xa Xb ×ˢ Ioo (-1) 1) hh0 hχs hχ0 hχM (fun n hn => (hP2 n hn).2.2.2.2.2.2.1) hD'
    (fun m X _ hX => mul_nonneg (hew0 X) (Real.rpow_nonneg (hed0 X hX.1.1 hX.1.2).le _))
    (fun n hn m => by
      obtain ⟨C, hC⟩ := hN0z m (max (N0th m) (N0z m)) (le_max_right _ _) n hn
      exact ⟨C, fun i hi X η hX => hC i hi X η hX.1.1 hX.1.2 hX.2.1 hX.2.2⟩)
  obtain ⟨Cp, hCp⟩ : ∃ Cp : ℕ → ℕ → ℝ, ∀ j m, Cp j m =
      |Cp1 j m| + |Cp2 j m| + |Cp3 j m| + |Cp4 j m| + |Cp5 j m| + |Cp6 j m| := ⟨_, fun j m => rfl⟩
  refine ⟨Cp, fun a ha1 ha2 hsm => ?_⟩
  have hsm_of : ∀ D : ℕ → ℕ → ℝ, (∀ j m, |D j m| ≤ Cp j m) → ∀ j : ℕ, 1 ≤ j → ∀ m : ℕ, m ≤ j →
      ∀ q : ℝ, 0 < q → q ≤ 1 / a j → |D j m| * q ^ (2 * h * (j : ℝ) / 2) ≤ (1 / 2) ^ j := by
    intro D hD j hj m hm q hq hqa
    have hs := hsm j hj m hm q hq hqa
    have h0 : 0 ≤ Cp j m := by rw [hCp]; positivity
    rw [abs_of_nonneg h0] at hs
    exact le_trans (mul_le_mul_of_nonneg_right (hD j m) (Real.rpow_nonneg hq.le _)) hs
  have hall : ∀ j m, 0 ≤ |Cp1 j m| ∧ 0 ≤ |Cp2 j m| ∧ 0 ≤ |Cp3 j m| ∧ 0 ≤ |Cp4 j m| ∧
      0 ≤ |Cp5 j m| ∧ 0 ≤ |Cp6 j m| := fun j m =>
    ⟨abs_nonneg _, abs_nonneg _, abs_nonneg _, abs_nonneg _, abs_nonneg _, abs_nonneg _⟩
  obtain ⟨tGs, tGb⟩ := hCp1 a ha1 ha2 (hsm_of Cp1 (fun j m => by
    rw [hCp]; obtain ⟨_, b2, b3, b4, b5, b6⟩ := hall j m; linarith))
  obtain ⟨tUs, tUb⟩ := hCp2 a ha1 ha2 (hsm_of Cp2 (fun j m => by
    rw [hCp]; obtain ⟨b1, _, b3, b4, b5, b6⟩ := hall j m; linarith))
  obtain ⟨tVs, tVb⟩ := hCp3 a ha1 ha2 (hsm_of Cp3 (fun j m => by
    rw [hCp]; obtain ⟨b1, b2, _, b4, b5, b6⟩ := hall j m; linarith))
  obtain ⟨tRs, tRb⟩ := hCp4 a ha1 ha2 (hsm_of Cp4 (fun j m => by
    rw [hCp]; obtain ⟨b1, b2, b3, _, b5, b6⟩ := hall j m; linarith))
  obtain ⟨tThs, tThb⟩ := hCp5 a ha1 ha2 (hsm_of Cp5 (fun j m => by
    rw [hCp]; obtain ⟨b1, b2, b3, b4, _, b6⟩ := hall j m; linarith))
  obtain ⟨tTzs, tTzb⟩ := hCp6 a ha1 ha2 (hsm_of Cp6 (fun j m => by
    rw [hCp]; obtain ⟨b1, b2, b3, b4, b5, _⟩ := hall j m; linarith))
  choose CG hCG0 hCG using tGb
  choose CU hCU0 hCU using tUb
  choose CV hCV0 hCV using tVb
  choose CR hCR0 hCR using tRb
  choose CTh hCTh0 hCTh using tThb
  choose CTz hCTz0 hCTz using tTzb

  have eEb' : ∀ w : ℝ × ℝ × ℝ, logLift (bgEb h a G) w =
      Real.sqrt (2 * w.2.1) * (F w.2.1 w.2.2 + bpsTail h bpsChi a G w) := fun w => by
    rw [← hG0]; rfl
  have eU' : ∀ w : ℝ × ℝ × ℝ, logLift (bgSum h a Uc) w = U w.2.1 w.2.2 + bpsTail h bpsChi a Uc w :=
    fun w => by rw [← hU0]; rfl
  have eV' : ∀ w : ℝ × ℝ × ℝ, logLift (bgVb h a S Vc) w = leadV h U w.2.1 w.2.2 +
      bpsTail h bpsChi a Vc w + bpsTail h bpsPsi a (bpsRcoef h S) w := fun w => by
    rw [bps_Vb_split h a S Vc ha1 ha2 w, hV0]
  have eTh' : ∀ w : ℝ × ℝ × ℝ, logLift (bgSum h a Tth) w = Tth 0 w.2.1 w.2.2 + bpsTail h bpsChi a Tth w :=
    fun w => rfl
  have eTz' : ∀ w : ℝ × ℝ × ℝ, logLift (bgSum h a Tz) w = Tz 0 w.2.1 w.2.2 + bpsTail h bpsChi a Tz w :=
    fun w => rfl
  have hUo : IsOpen (univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) : Set (ℝ × ℝ × ℝ)) :=
    isOpen_univ.prod (isOpen_Ioi.prod isOpen_Ioo)
  have hsub : (Iio (Real.log 1) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) : Set (ℝ × ℝ × ℝ)) ⊆
      univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := prod_mono (subset_univ _) subset_rfl
  have hTh0s : ContDiffOn ℝ ∞ (↿(Tth 0)) (Ioi 0 ×ˢ Ioo (-1) 1) :=
    hT0s.congr (fun p hp => (hT0 p.1 p.2 hp.1 hp.2.1 hp.2.2).1)
  have hTz0s : ContDiffOn ℝ ∞ (↿(Tz 0)) (Ioi 0 ×ˢ Ioo (-1) 1) :=
    hT0zs.congr (fun p hp => (hT0 p.1 p.2 hp.1 hp.2.1 hp.2.2).2)
  have sEb : ContDiffOn ℝ ∞ (logLift (bgEb h a G)) (univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) :=
    ((bps_lift_mul (fun (X _ : ℝ) => Real.sqrt (2 * X)) (bpsTail h bpsChi a G) hsq.1 tGs).1.mul
      ((bps_lift_mul F (bpsTail h bpsChi a G) hFs tGs).1.add tGs)).congr (fun w _ => eEb' w)
  have sU : ContDiffOn ℝ ∞ (logLift (bgSum h a Uc)) (univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) :=
    ((bps_lift_mul U (bpsTail h bpsChi a Uc) hUs tUs).1.add tUs).congr (fun w _ => eU' w)
  have sV : ContDiffOn ℝ ∞ (logLift (bgVb h a S Vc)) (univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) :=
    (((bps_lift_mul (leadV h U) (bpsTail h bpsChi a Vc) hLVs tVs).1.add tVs).add tRs).congr
      (fun w _ => eV' w)
  have sTh : ContDiffOn ℝ ∞ (logLift (bgSum h a Tth)) (univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) :=
    ((bps_lift_mul (Tth 0) (bpsTail h bpsChi a Tth) hTh0s tThs).1.add tThs).congr (fun w _ => eTh' w)
  have sTz : ContDiffOn ℝ ∞ (logLift (bgSum h a Tz)) (univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) :=
    ((bps_lift_mul (Tz 0) (bpsTail h bpsChi a Tz) hTz0s tTzs).1.add tTzs).congr (fun w _ => eTz' w)
  refine ⟨⟨sEb.mono hsub, sU.mono hsub, sV.mono hsub, ?_⟩, ⟨sTh.mono hsub, sTz.mono hsub, ?_, ?_⟩⟩
  ·
    intro X₀ X₁ hX₀ m
    choose M hM using hsq.2 X₀ X₁ hX₀
    obtain ⟨CL, hCL⟩ := hLVb X₁ m
    obtain ⟨CE, hCE⟩ : ∃ CE : ℝ,
        CE = ∑ k ∈ Finset.range (m + 1), (m.choose k : ℝ) * |M k| * CG (m - k) := ⟨_, rfl⟩
    have hCE0 : 0 ≤ CE := by
      rw [hCE]
      exact Finset.sum_nonneg (fun k _ =>
        mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (abs_nonneg _)) (hCG0 _))
    have hR0 : 0 ≤ CR m * (1 + |X₁|) := mul_nonneg (hCR0 m) (by positivity)
    refine ⟨CE + CU m + (|CL| + CV m + CR m * (1 + |X₁|)),
      fun q X η hq hq1 hX0 hX1 hη1 hη2 => ?_⟩
    have hXpos : 0 < X := lt_of_lt_of_le hX₀ hX0
    have hw : (X, η) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := ⟨hXpos, hη1, hη2⟩
    have hmem : (Real.log q, X, η) ∈ (univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) : Set (ℝ × ℝ × ℝ)) :=
      ⟨mem_univ _, hw⟩
    have hq2 : 0 ≤ q ^ (2 * h) := Real.rpow_nonneg hq.le _
    have hq21 : q ^ (2 * h) ≤ 1 := Real.rpow_le_one hq.le hq1.le (by linarith)
    have cd : ∀ f : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ f (univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) →
        ContDiffAt ℝ m f (Real.log q, X, η) :=
      fun f hf => contDiffAt_infty.1 (hf.contDiffAt (hUo.mem_nhds hmem)) m
    have bE : ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ =>
        logLift (bgEb h a G) w - Real.sqrt (2 * w.2.1) * F w.2.1 w.2.2) (Real.log q, X, η)‖ ≤
        CE * q ^ (2 * h) := by
      have hEq : (fun w : ℝ × ℝ × ℝ => logLift (bgEb h a G) w - Real.sqrt (2 * w.2.1) * F w.2.1 w.2.2) =
          fun w => Real.sqrt (2 * w.2.1) * bpsTail h bpsChi a G w := by
        funext w; rw [eEb' w]; ring
      rw [hEq]
      refine le_trans ((bps_lift_mul (fun (X _ : ℝ) => Real.sqrt (2 * X)) (bpsTail h bpsChi a G)
        hsq.1 tGs).2.2 m (Real.log q, X, η) hw) ?_
      rw [hCE, Finset.sum_mul]
      refine Finset.sum_le_sum (fun k _ => ?_)
      have hk1 : ‖iteratedFDeriv ℝ k (↿(fun (X _ : ℝ) => Real.sqrt (2 * X))) (X, η)‖ ≤ |M k| :=
        (hM k X η hX0 hX1 hη1 hη2).trans (le_abs_self _)
      have hk2 : ‖iteratedFDeriv ℝ (m - k) (bpsTail h bpsChi a G) (Real.log q, X, η)‖ ≤
          CG (m - k) * q ^ (2 * h) := by
        have h3 : ‖iteratedFDeriv ℝ (m - k) (bpsTail h bpsChi a G) (Real.log q, X, η)‖ ≤
            CG (m - k) * q ^ (2 * h) * 1 := hCG (m - k) q X η hq hq1 hw
        linarith
      have e : (m.choose k : ℝ) * |M k| * CG (m - k) * q ^ (2 * h) =
          (m.choose k : ℝ) * |M k| * (CG (m - k) * q ^ (2 * h)) := by ring
      rw [e]
      exact mul_le_mul (mul_le_mul_of_nonneg_left hk1 (Nat.cast_nonneg _)) hk2 (norm_nonneg _)
        (mul_nonneg (Nat.cast_nonneg _) (abs_nonneg _))
    have bU : ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => logLift (bgSum h a Uc) w - U w.2.1 w.2.2)
        (Real.log q, X, η)‖ ≤ CU m * q ^ (2 * h) := by
      have hEqU : (fun w : ℝ × ℝ × ℝ => logLift (bgSum h a Uc) w - U w.2.1 w.2.2) =
          bpsTail h bpsChi a Uc := by
        funext w; rw [eU' w]; ring
      rw [hEqU]
      have h1 : ‖iteratedFDeriv ℝ m (bpsTail h bpsChi a Uc) (Real.log q, X, η)‖ ≤
          CU m * q ^ (2 * h) * 1 := hCU m q X η hq hq1 hw
      linarith
    have bV : ‖iteratedFDeriv ℝ m (logLift (bgVb h a S Vc)) (Real.log q, X, η)‖ ≤
        |CL| + CV m + CR m * (1 + |X₁|) := by
      have liftLV := bps_lift_mul (leadV h U) (bpsTail h bpsChi a Vc) hLVs tVs
      have e1 : logLift (bgVb h a S Vc) = ((fun w : ℝ × ℝ × ℝ => leadV h U w.2.1 w.2.2) +
          bpsTail h bpsChi a Vc) + bpsTail h bpsPsi a (bpsRcoef h S) := by
        funext w
        simp only [Pi.add_apply]
        exact eV' w
      rw [e1, iteratedFDeriv_add_apply
          (f := (fun w : ℝ × ℝ × ℝ => leadV h U w.2.1 w.2.2) + bpsTail h bpsChi a Vc)
          (g := bpsTail h bpsPsi a (bpsRcoef h S)) (cd _ (liftLV.1.add tVs)) (cd _ tRs),
        iteratedFDeriv_add_apply (f := fun w : ℝ × ℝ × ℝ => leadV h U w.2.1 w.2.2)
          (g := bpsTail h bpsChi a Vc) (cd _ liftLV.1) (cd _ tVs)]
      have b1 : ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => leadV h U w.2.1 w.2.2) (Real.log q, X, η)‖ ≤
          |CL| :=
        le_trans (liftLV.2.1 m (Real.log q, X, η) hw)
          ((hCL X η hXpos hX1 hη1 hη2).trans (le_abs_self _))
      have b2 : ‖iteratedFDeriv ℝ m (bpsTail h bpsChi a Vc) (Real.log q, X, η)‖ ≤ CV m := by
        have h1 : ‖iteratedFDeriv ℝ m (bpsTail h bpsChi a Vc) (Real.log q, X, η)‖ ≤
            CV m * q ^ (2 * h) * 1 := hCV m q X η hq hq1 hw
        have h2 : CV m * q ^ (2 * h) ≤ CV m * 1 := mul_le_mul_of_nonneg_left hq21 (hCV0 m)
        linarith
      have b3 : ‖iteratedFDeriv ℝ m (bpsTail h bpsPsi a (bpsRcoef h S)) (Real.log q, X, η)‖ ≤
          CR m * (1 + |X₁|) := by
        have h1 : ‖iteratedFDeriv ℝ m (bpsTail h bpsPsi a (bpsRcoef h S)) (Real.log q, X, η)‖ ≤
            CR m * q ^ (2 * h) * (1 + X) := hCR m q X η hq hq1 hw
        have h2 : q ^ (2 * h) * (1 + X) ≤ 1 + |X₁| := by
          have : q ^ (2 * h) * (1 + X) ≤ 1 * (1 + X) := mul_le_mul_of_nonneg_right hq21 (by linarith)
          linarith [le_abs_self X₁]
        have h3 : CR m * (q ^ (2 * h) * (1 + X)) ≤ CR m * (1 + |X₁|) :=
          mul_le_mul_of_nonneg_left h2 (hCR0 m)
        have h4 : CR m * q ^ (2 * h) * (1 + X) = CR m * (q ^ (2 * h) * (1 + X)) := by ring
        linarith
      exact le_trans norm_add₃_le (by linarith)
    refine ⟨le_trans bE (mul_le_mul_of_nonneg_right (by linarith [hCU0 m, abs_nonneg CL, hCV0 m]) hq2),
      le_trans bU (mul_le_mul_of_nonneg_right (by linarith [abs_nonneg CL, hCV0 m]) hq2),
      le_trans bV (by linarith [hCU0 m])⟩
  ·
    intro q X η hX
    have z1 : ∀ n : ℕ, bgCut (a (n + 1)) q * q ^ (2 * ((n : ℝ) + 1) * h) * Tth (n + 1) X η = 0 :=
      fun n => by rw [(hTsupp (n + 1) X η hX).1, mul_zero]
    have z2 : ∀ n : ℕ, bgCut (a (n + 1)) q * q ^ (2 * ((n : ℝ) + 1) * h) * Tz (n + 1) X η = 0 :=
      fun n => by rw [(hTsupp (n + 1) X η hX).2, mul_zero]
    refine ⟨?_, ?_⟩
    · simp only [bgSum, z1, tsum_zero, add_zero]
      exact (hTsupp 0 X η hX).1
    · simp only [bgSum, z2, tsum_zero, add_zero]
      exact (hTsupp 0 X η hX).2
  ·
    intro m
    refine ⟨CTh m + CTz m, max (N0th m) (N0z m), fun q X η hq hq1 hXa' hXb' hη1 hη2 => ?_⟩
    have hXpos : 0 < X := lt_trans hXa hXa'
    have hmem : (Real.log q, X, η) ∈ (univ ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) : Set (ℝ × ℝ × ℝ)) :=
      ⟨mem_univ _, hXpos, hη1, hη2⟩
    have hD : (X, η) ∈ Ioo Xa Xb ×ˢ Ioo (-1:ℝ) 1 := ⟨⟨hXa', hXb'⟩, hη1, hη2⟩
    have hqh : q ^ (2 * h) ≤ q ^ h := Real.rpow_le_rpow_of_exponent_ge hq hq1.le (by linarith)
    have hWt : 0 ≤ edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-(max (N0th m) (N0z m))) :=
      mul_nonneg (hew0 X) (Real.rpow_nonneg (hed0 X hXa' hXb').le _)
    have hA : CTh m * q ^ (2 * h) ≤ (CTh m + CTz m) * q ^ h :=
      mul_le_mul (by linarith [hCTz0 m]) hqh (Real.rpow_nonneg hq.le _) (by linarith [hCTh0 m, hCTz0 m])
    have hB : CTz m * q ^ (2 * h) ≤ (CTh m + CTz m) * q ^ h :=
      mul_le_mul (by linarith [hCTh0 m]) hqh (Real.rpow_nonneg hq.le _) (by linarith [hCTh0 m, hCTz0 m])
    constructor
    · have hev : (fun w : ℝ × ℝ × ℝ => logLift (bgSum h a Tth) w - T0th w.2.1 w.2.2) =ᶠ[nhds (Real.log q, X, η)]
          bpsTail h bpsChi a Tth := by
        filter_upwards [hUo.mem_nhds hmem] with w hw
        show logLift (bgSum h a Tth) w - T0th w.2.1 w.2.2 = bpsTail h bpsChi a Tth w
        rw [eTh' w, (hT0 w.2.1 w.2.2 hw.2.1 hw.2.2.1 hw.2.2.2).1]
        ring
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
      have h1 : ‖iteratedFDeriv ℝ m (bpsTail h bpsChi a Tth) (Real.log q, X, η)‖ ≤ CTh m * q ^ (2 * h) *
          (edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-(max (N0th m) (N0z m)))) :=
        hCTh m q X η hq hq1 hD
      refine le_trans h1 (le_trans (mul_le_mul_of_nonneg_right hA hWt) (le_of_eq ?_))
      ring
    · have hev : (fun w : ℝ × ℝ × ℝ => logLift (bgSum h a Tz) w - T0z w.2.1 w.2.2) =ᶠ[nhds (Real.log q, X, η)]
          bpsTail h bpsChi a Tz := by
        filter_upwards [hUo.mem_nhds hmem] with w hw
        show logLift (bgSum h a Tz) w - T0z w.2.1 w.2.2 = bpsTail h bpsChi a Tz w
        rw [eTz' w, (hT0 w.2.1 w.2.2 hw.2.1 hw.2.2.1 hw.2.2.2).2]
        ring
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
      have h1 : ‖iteratedFDeriv ℝ m (bpsTail h bpsChi a Tz) (Real.log q, X, η)‖ ≤ CTz m * q ^ (2 * h) *
          (edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-(max (N0th m) (N0z m)))) :=
        hCTz m q X η hq hq1 hD
      refine le_trans h1 (le_trans (mul_le_mul_of_nonneg_right hB hWt) (le_of_eq ?_))
      ring

theorem bg_stress_term_props : ∀ (h Xa Xb : ℝ) (n : ℕ) (T1 T2 : ℝ → ℝ → ℝ), SimScaleProps h → 0 < h → h < 1 / 2 → 0 < Xa → Xa < Xb → ContDiffOn ℝ ∞ (↿T1) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿T2) (Ioi 0 ×ˢ Ioo (-1) 1) → (∀ X η : ℝ, (X ≤ Xa ∨ Xb ≤ X) → T1 X η = 0 ∧ T2 X η = 0) → (∀ Y η : ℝ, -1 < η → η < 1 → DifferentiableAt ℝ (fun Y' => T1 Y' η) Y ∧ DifferentiableAt ℝ (fun Y' => T2 Y' η) Y) ∧ ContDiffOn ℝ ∞ (↿(stressDivField h (fun q X η => q ^ (2 * (n : ℝ) * h) * T1 X η) (fun q X η => q ^ (2 * (n : ℝ) * h) * T2 X η))) {w : ℝ³ × ℝ | w.2 < 1} ∧ ((∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿T1) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿T2) (X, η)‖ ≤ C) → ∀ m : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ‖iteratedFDeriv ℝ m (↿(stressDivField h (fun q X η => q ^ (2 * (n : ℝ) * h) * T1 X η) (fun q X η => q ^ (2 * (n : ℝ) * h) * T2 X η))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (2 * h * (n : ℝ) - ((m : ℝ) + 3))) :=
by
  intro h Xa Xb n T1 T2 hS hh0 hh2 hXa hXab hT1 hT2 hv

  have gen : ∀ (T : ℝ → ℝ → ℝ) (φ ψ : ℝ → ℝ) (c : ℝ → ℝ → ℝ),
      ContDiffOn ℝ ∞ (↿T) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ φ (Ioi 0) → ContDiffOn ℝ ∞ ψ (Ioi 0) →
      (∀ X η : ℝ, (X ≤ Xa ∨ Xb ≤ X) → T X η = 0) →
      (∀ X η : ℝ, c X η = φ X * deriv (fun Y => T Y η) X + ψ X * T X η) →
      (∀ Y η : ℝ, -1 < η → η < 1 → DifferentiableAt ℝ (fun Y' => T Y' η) Y) ∧
      ContDiffOn ℝ ∞ (↿c) (univ ×ˢ Ioo (-1) 1) ∧
      (∀ X η : ℝ, Xb < X → c X η = 0) ∧
      ((∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿T) (X, η)‖ ≤ C) →
        ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ Xb → -1 < η → η < 1 →
          ‖iteratedFDeriv ℝ m (↿c) (X, η)‖ ≤ C) := by
    intro T φ ψ c hT hφ hψ hvT hc
    have hV : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
    have hz0 : ∀ X η : ℝ, (X < Xa ∨ Xb < X) → (fun Y => T Y η) =ᶠ[nhds X] fun _ => (0:ℝ) := by
      intro X η hX
      rcases hX with hX | hX
      · filter_upwards [Iio_mem_nhds hX] with Y hY using hvT Y η (Or.inl (le_of_lt hY))
      · filter_upwards [Ioi_mem_nhds hX] with Y hY using hvT Y η (Or.inr (le_of_lt hY))
    have hpz : ∀ X η : ℝ, (X < Xa ∨ Xb < X) → c X η = 0 := by
      intro X η hX
      have h1 : deriv (fun Y => T Y η) X = 0 := by rw [(hz0 X η hX).deriv_eq]; simp
      have h2 : T X η = 0 := (hz0 X η hX).eq_of_nhds
      rw [hc, h1, h2]; ring
    have hfdT : ContDiffOn ℝ ∞ (fderiv ℝ (↿T)) (Ioi 0 ×ˢ Ioo (-1) 1) :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hV).1 hT).2
    have hCR : ∀ w ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1,
        HasDerivAt (fun Y => T Y w.2) (fderiv ℝ (↿T) w ((1:ℝ), (0:ℝ))) w.1 := by
      intro w hw
      have hF : HasFDerivAt (↿T) (fderiv ℝ (↿T) w) w :=
        ((hT.contDiffAt (hV.mem_nhds hw)).differentiableAt (by simp)).hasFDerivAt
      exact hF.comp_hasDerivAt w.1 ((hasDerivAt_id w.1).prodMk (hasDerivAt_const w.1 w.2))
    have hφV : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => φ w.1) (Ioi 0 ×ˢ Ioo (-1) 1) :=
      hφ.comp contDiffOn_fst (fun w hw => hw.1)
    have hψV : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => ψ w.1) (Ioi 0 ×ˢ Ioo (-1) 1) :=
      hψ.comp contDiffOn_fst (fun w hw => hw.1)
    have hDV : ContDiffOn ℝ ∞ (fun w => fderiv ℝ (↿T) w ((1:ℝ), (0:ℝ))) (Ioi 0 ×ˢ Ioo (-1) 1) :=
      hfdT.clm_apply contDiffOn_const
    have hAV : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => φ w.1 * fderiv ℝ (↿T) w ((1:ℝ), (0:ℝ)))
        (Ioi 0 ×ˢ Ioo (-1) 1) := hφV.mul hDV
    have hBV : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => ψ w.1 * (↿T) w) (Ioi 0 ×ˢ Ioo (-1) 1) := hψV.mul hT
    have heqV : ∀ w ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1,
        (↿c) w = ((fun w : ℝ × ℝ => φ w.1 * fderiv ℝ (↿T) w ((1:ℝ), (0:ℝ))) +
          (fun w : ℝ × ℝ => ψ w.1 * (↿T) w)) w := by
      intro w hw
      show c w.1 w.2 = _
      rw [hc, (hCR w hw).deriv]
      rfl
    refine ⟨?_, ?_, fun X η hX => hpz X η (Or.inr hX), ?_⟩
    · intro Y η h1 h2
      rcases lt_or_ge Y Xa with hY | hY
      · exact (differentiableAt_const (0:ℝ)).congr_of_eventuallyEq (hz0 Y η (Or.inl hY))
      · exact (hCR (Y, η) ⟨lt_of_lt_of_le hXa hY, h1, h2⟩).differentiableAt
    · apply contDiffOn_of_locally_contDiffOn
      intro w hw
      rcases lt_or_ge w.1 Xa with hw1 | hw1
      · refine ⟨{z : ℝ × ℝ | z.1 < Xa}, isOpen_lt continuous_fst continuous_const, hw1, ?_⟩
        exact (contDiffOn_const (c := (0:ℝ))).congr (fun z hz => hpz z.1 z.2 (Or.inl hz.2))
      · refine ⟨{z : ℝ × ℝ | 0 < z.1}, isOpen_lt continuous_const continuous_fst,
          lt_of_lt_of_le hXa hw1, ?_⟩
        refine ((hAV.add hBV).mono ?_).congr ?_
        · intro z hz; exact ⟨hz.2, hz.1.2⟩
        · intro z hz; exact heqV z ⟨hz.2, hz.1.2⟩
    · intro hTb m
      have hSV : Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi 0 ×ˢ Ioo (-1) 1 :=
        fun w hw => ⟨lt_of_lt_of_le hXa hw.1.1, hw.2⟩
      have hmult : ∀ f : ℝ → ℝ, ContDiffOn ℝ ∞ f (Ioi 0) → ∀ k : ℕ, ∃ C : ℝ,
          ∀ w ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1, ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => f w.1) w‖ ≤ C := by
        intro f hf k
        have hO : IsOpen (Ioi (0:ℝ) ×ˢ (univ : Set ℝ)) := isOpen_Ioi.prod isOpen_univ
        have hfO : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => f w.1) (Ioi 0 ×ˢ univ) :=
          hf.comp contDiffOn_fst (fun w hw => hw.1)
        have hcont : ContinuousOn (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => f w.1)) (Ioi 0 ×ˢ univ) :=
          (hfO.continuousOn_iteratedFDerivWithin (by exact_mod_cast le_top) hO.uniqueDiffOn).congr
            (fun w hw => (iteratedFDerivWithin_of_isOpen k hO hw).symm)
        have hK : IsCompact (Icc Xa Xb ×ˢ ({0} : Set ℝ)) := isCompact_Icc.prod isCompact_singleton
        obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn
          (hcont.mono (fun w hw => ⟨lt_of_lt_of_le hXa hw.1.1, mem_univ _⟩))
        refine ⟨C, fun w hw => ?_⟩
        have e : iteratedFDeriv ℝ k (fun w : ℝ × ℝ => f w.1) w =
            iteratedFDeriv ℝ k (fun w : ℝ × ℝ => f w.1) (w.1, 0) := by
          have := iteratedFDeriv_comp_add_right (𝕜 := ℝ) (f := fun w : ℝ × ℝ => f w.1) k
            ((0:ℝ), w.2) (w.1, 0)
          simp only [Prod.fst_add, add_zero, Prod.mk_add_mk, zero_add] at this
          exact this.symm
        rw [e]
        exact hC (w.1, 0) ⟨hw.1, rfl⟩
      have hprod : ∀ f1 f2 : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ f1 (Ioi 0 ×ˢ Ioo (-1) 1) →
          ContDiffOn ℝ ∞ f2 (Ioi 0 ×ˢ Ioo (-1) 1) →
          (∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1, ‖iteratedFDeriv ℝ k f1 w‖ ≤ C) →
          (∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1, ‖iteratedFDeriv ℝ k f2 w‖ ≤ C) →
          ∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1,
            ‖iteratedFDeriv ℝ k (fun z => f1 z * f2 z) w‖ ≤ C := by
        intro f1 f2 h1 h2 b1 b2 k
        choose C1 hC1 using b1
        choose C2 hC2 using b2
        refine ⟨∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (|C1 i| * |C2 (k - i)|), fun w hw => ?_⟩
        have hwV := hSV hw
        rw [← iteratedFDerivWithin_of_isOpen (f := fun z => f1 z * f2 z) k hV hwV]
        refine (norm_iteratedFDerivWithin_mul_le h1 h2 hV.uniqueDiffOn hwV
          (by exact_mod_cast le_top)).trans ?_
        refine Finset.sum_le_sum (fun i _ => ?_)
        rw [iteratedFDerivWithin_of_isOpen i hV hwV, iteratedFDerivWithin_of_isOpen (k - i) hV hwV]
        have a1 := (hC1 i w hw).trans (le_abs_self _)
        have a2 := (hC2 (k - i) w hw).trans (le_abs_self _)
        have a3 := mul_le_mul a1 a2 (norm_nonneg _) (abs_nonneg _)
        have a4 : (0:ℝ) ≤ (k.choose i : ℝ) := by positivity
        calc (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i f1 w‖ * ‖iteratedFDeriv ℝ (k - i) f2 w‖
            = (k.choose i : ℝ) * (‖iteratedFDeriv ℝ i f1 w‖ * ‖iteratedFDeriv ℝ (k - i) f2 w‖) := by ring
          _ ≤ (k.choose i : ℝ) * (|C1 i| * |C2 (k - i)|) := mul_le_mul_of_nonneg_left a3 a4
      have hDb : ∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1,
          ‖iteratedFDeriv ℝ k (fun w => fderiv ℝ (↿T) w ((1:ℝ), (0:ℝ))) w‖ ≤ C := by
        intro k
        obtain ⟨C, hC⟩ := hTb (k + 1)
        refine ⟨‖ContinuousLinearMap.apply ℝ ℝ ((1:ℝ), (0:ℝ))‖ * C, fun w hw => ?_⟩
        have hwV := hSV hw
        have e : (fun w => fderiv ℝ (↿T) w ((1:ℝ), (0:ℝ))) =
            (ContinuousLinearMap.apply ℝ ℝ ((1:ℝ), (0:ℝ))) ∘ fderiv ℝ (↿T) := rfl
        rw [e]
        refine (ContinuousLinearMap.norm_iteratedFDeriv_comp_left _
          (hfdT.contDiffAt (hV.mem_nhds hwV)) (by exact_mod_cast le_top)).trans ?_
        rw [norm_iteratedFDeriv_fderiv]
        exact mul_le_mul_of_nonneg_left (hC w.1 w.2 hwV.1 hwV.2.1 hwV.2.2) (norm_nonneg _)
      obtain ⟨C1, hC1⟩ := hprod _ _ hφV hDV (hmult φ hφ) hDb m
      obtain ⟨C2, hC2⟩ := hprod _ _ hψV hT (hmult ψ hψ)
        (fun k => (hTb k).imp fun C hC w hw => hC w.1 w.2 (hSV hw).1 (hSV hw).2.1 (hSV hw).2.2) m
      refine ⟨max (C1 + C2) 0, fun X η h0 hXb h1 h2 => ?_⟩
      rcases lt_or_ge X Xa with hX | hX
      · have hev : (↿c) =ᶠ[nhds (X, η)] fun _ => (0:ℝ) :=
          Filter.eventuallyEq_of_mem ((isOpen_lt continuous_fst continuous_const).mem_nhds
            (show (X, η) ∈ {z : ℝ × ℝ | z.1 < Xa} from hX)) (fun z hz => hpz z.1 z.2 (Or.inl hz))
        rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
        simp
      · have hw : (X, η) ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1 := ⟨⟨hX, hXb⟩, h1, h2⟩
        have hwV := hSV hw
        have hev : (↿c) =ᶠ[nhds (X, η)]
            ((fun w : ℝ × ℝ => φ w.1 * fderiv ℝ (↿T) w ((1:ℝ), (0:ℝ))) +
              (fun w : ℝ × ℝ => ψ w.1 * (↿T) w)) :=
          Filter.eventuallyEq_of_mem (hV.mem_nhds hwV) heqV
        rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds,
          iteratedFDeriv_add_apply ((hAV.contDiffAt (hV.mem_nhds hwV)).of_le (by exact_mod_cast le_top))
            ((hBV.contDiffAt (hV.mem_nhds hwV)).of_le (by exact_mod_cast le_top))]
        have e1 : ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ => φ w.1 * fderiv ℝ (↿T) w ((1:ℝ), (0:ℝ))) (X, η)‖
            ≤ C1 := hC1 _ hw
        have e2 : ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ => ψ w.1 * (↿T) w) (X, η)‖ ≤ C2 := hC2 _ hw
        refine (norm_add_le _ _).trans ?_
        linarith [le_max_left (C1 + C2) 0]

  have hφ1 : ContDiffOn ℝ ∞ (fun _ : ℝ => (-1 : ℝ)) (Ioi 0) := contDiffOn_const
  have hψ1 : ContDiffOn ℝ ∞ (fun X : ℝ => -X⁻¹) (Ioi 0) := by
    have := ((contDiffOn_id : ContDiffOn ℝ ∞ (id : ℝ → ℝ) (Ioi 0)).inv
      (fun X (hX : X ∈ Ioi (0:ℝ)) => ne_of_gt hX)).neg
    exact this
  have hlin : ContDiffOn ℝ ∞ (fun X : ℝ => 2 * X) (Ioi 0) := (contDiffOn_const.mul contDiffOn_id)
  have hlin0 : ∀ X ∈ Ioi (0:ℝ), 2 * X ≠ 0 := fun X hX => (mul_pos two_pos (mem_Ioi.mp hX)).ne'
  have hsq : ContDiffOn ℝ ∞ (fun X : ℝ => Real.sqrt (2 * X)) (Ioi 0) := hlin.sqrt hlin0
  have hφ2 : ContDiffOn ℝ ∞ (fun X : ℝ => -Real.sqrt (2 * X)) (Ioi 0) := hsq.neg
  have hψ2 : ContDiffOn ℝ ∞ (fun X : ℝ => -(Real.sqrt (2 * X) / (2 * X))) (Ioi 0) := by
    have := (hsq.div hlin hlin0).neg
    exact this

  obtain ⟨c1, hc1⟩ : ∃ c1 : ℝ → ℝ → ℝ,
      c1 = fun X η => -1 * deriv (fun Y => T1 Y η) X + -X⁻¹ * T1 X η := ⟨_, rfl⟩
  obtain ⟨c2, hc2⟩ : ∃ c2 : ℝ → ℝ → ℝ, c2 = fun X η =>
      -Real.sqrt (2 * X) * deriv (fun Y => T2 Y η) X + -(Real.sqrt (2 * X) / (2 * X)) * T2 X η :=
    ⟨_, rfl⟩
  have g1 := gen T1 _ _ c1 hT1 hφ1 hψ1 (fun X η hX => (hv X η hX).1) (fun X η => by rw [hc1])
  have g2 := gen T2 _ _ c2 hT2 hφ2 hψ2 (fun X η hX => (hv X η hX).2) (fun X η => by rw [hc2])

  have hΩ : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  have hQpos : ∀ z ∈ {w : ℝ³ × ℝ | w.2 < 1}, 0 < simScale h (z.1 2) (1 - z.2) := by
    intro z hz
    have hz' : z.2 < 1 := hz
    exact (hS.1 _ _ (by linarith)).1
  have hQne : ∀ z ∈ {w : ℝ³ × ℝ | w.2 < 1}, simScale h (z.1 2) (1 - z.2) ≠ 0 :=
    fun z hz => (hQpos z hz).ne'
  have hQs : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => simScale h (z.1 2) (1 - z.2)) {w : ℝ³ × ℝ | w.2 < 1} := by
    have hlinQ : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => ((z.1 2 : ℝ), 1 - z.2)) := by fun_prop
    have := hS.2.2.2.1.comp hlinQ.contDiffOn
      (fun z (hz : z ∈ {w : ℝ³ × ℝ | w.2 < 1}) =>
        (⟨mem_univ _, show (0:ℝ) < 1 - z.2 by have : z.2 < 1 := hz; linarith⟩ :
          ((z.1 2 : ℝ), 1 - z.2) ∈ (univ : Set ℝ) ×ˢ Ioi (0:ℝ)))
    exact this
  have hX : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => simX h z.1 z.2) {w : ℝ³ × ℝ | w.2 < 1} := by
    have hnum : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => z.1 0 ^ 2 + z.1 1 ^ 2) := by fun_prop
    have hden : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => 2 * simScale h (z.1 2) (1 - z.2)) {w : ℝ³ × ℝ | w.2 < 1} :=
      contDiffOn_const.mul hQs
    exact hnum.contDiffOn.div hden (fun z hz => mul_ne_zero two_ne_zero (hQne z hz))
  have hE : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => simEta h z.1 z.2) {w : ℝ³ × ℝ | w.2 < 1} := by
    have hx2 : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => z.1 2) := by fun_prop
    exact hx2.contDiffOn.mul (hQs.rpow_const_of_ne (p := -(1 / 2 - h)) hQne)
  have hEta : ∀ z ∈ {w : ℝ³ × ℝ | w.2 < 1}, -1 < simEta h z.1 z.2 ∧ simEta h z.1 z.2 < 1 := by
    intro z hz
    have hz' : z.2 < 1 := hz
    have hq := hQpos z hz
    have hsq2 := (hS.2.1 (z.1 2) (1 - z.2) (by linarith)).2
    have hp : 0 < simScale h (z.1 2) (1 - z.2) ^ (1 / 2 - h) := Real.rpow_pos_of_pos hq _
    have e1 : simScale h (z.1 2) (1 - z.2) ^ (1 - 2 * h) =
        (simScale h (z.1 2) (1 - z.2) ^ (1 / 2 - h)) ^ 2 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hq.le]
      congr 1; push_cast; ring
    rw [e1] at hsq2
    obtain ⟨l, r⟩ := abs_lt.mp (abs_lt_of_sq_lt_sq hsq2 hp.le)
    have e2 : simEta h z.1 z.2 = z.1 2 / simScale h (z.1 2) (1 - z.2) ^ (1 / 2 - h) := by
      simp only [simEta, Real.rpow_neg hq.le, div_eq_mul_inv]
    rw [e2]
    constructor
    · rw [lt_div_iff₀ hp]; linarith
    · rw [div_lt_iff₀ hp]; linarith
  have hP : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2)) {w : ℝ³ × ℝ | w.2 < 1} :=
    hX.prodMk hE
  have hcomp : ∀ c : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿c) (univ ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => c (simX h z.1 z.2) (simEta h z.1 z.2)) {w : ℝ³ × ℝ | w.2 < 1} := by
    intro c hc
    exact hc.comp hP (fun z hz => ⟨mem_univ _, (hEta z hz).1, (hEta z hz).2⟩)
  have hAz : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => azVec z.1) := by unfold azVec; fun_prop

  obtain ⟨F1, hF1⟩ : ∃ F1 : ℝ³ × ℝ → ℝ³, F1 = fun z =>
      (simScale h (z.1 2) (1 - z.2) ^ (-(2 + h) + 2 * (n : ℝ) * h) * c1 (simX h z.1 z.2) (simEta h z.1 z.2)) •
        azVec z.1 := ⟨_, rfl⟩
  obtain ⟨F2, hF2⟩ : ∃ F2 : ℝ³ × ℝ → ℝ³, F2 = fun z =>
      (simScale h (z.1 2) (1 - z.2) ^ (-(3 / 2 + h) + 2 * (n : ℝ) * h) * c2 (simX h z.1 z.2) (simEta h z.1 z.2)) •
        EuclideanSpace.single (2 : Fin 3) (1 : ℝ) := ⟨_, rfl⟩
  have hF1s : ContDiffOn ℝ ∞ F1 {w : ℝ³ × ℝ | w.2 < 1} := by
    rw [hF1]
    exact ((hQs.rpow_const_of_ne hQne).mul (hcomp c1 g1.2.1)).smul hAz.contDiffOn
  have hF2s : ContDiffOn ℝ ∞ F2 {w : ℝ³ × ℝ | w.2 < 1} := by
    rw [hF2]
    exact ((hQs.rpow_const_of_ne hQne).mul (hcomp c2 g2.2.1)).smul contDiffOn_const

  have key : ∀ z : ℝ³ × ℝ, z.2 < 1 →
      (↿(stressDivField h (fun q X η => q ^ (2 * (n : ℝ) * h) * T1 X η)
        (fun q X η => q ^ (2 * (n : ℝ) * h) * T2 X η))) z = (F1 + F2) z := by
    intro z hz
    have hq : 0 < simScale h (z.1 2) (1 - z.2) := (hS.1 _ _ (by linarith)).1
    rw [Pi.add_apply, hF1, hF2, hc1, hc2]
    change stressDivField h (fun q X η => q ^ (2 * (n : ℝ) * h) * T1 X η)
      (fun q X η => q ^ (2 * (n : ℝ) * h) * T2 X η) z.1 z.2 = _
    simp only [stressDivField]
    rw [deriv_const_mul_field, deriv_const_mul_field, Real.rpow_add hq, Real.rpow_add hq]
    congr 1 <;> congr 1 <;> ring
  have hΦs : ContDiffOn ℝ ∞ (↿(stressDivField h (fun q X η => q ^ (2 * (n : ℝ) * h) * T1 X η)
      (fun q X η => q ^ (2 * (n : ℝ) * h) * T2 X η))) {w : ℝ³ × ℝ | w.2 < 1} :=
    (hF1s.add hF2s).congr (fun z hz => key z hz)
  refine ⟨fun Y η h1 h2 => ⟨g1.1 Y η h1 h2, g2.1 Y η h1 h2⟩, hΦs, ?_⟩

  intro hTb m
  have hb1 := g1.2.2.2 (fun k => (hTb k).imp fun C hC X η a b d => (hC X η a b d).1)
  have hb2 := g2.2.2.2 (fun k => (hTb k).imp fun C hC X η a b d => (hC X η a b d).2)
  obtain ⟨-, hB1⟩ := sim_frame_field_bound h hh0 hh2 hS c1 (-(2 + h) + 2 * (n : ℝ) * h) 1 Xb azVec one_pos
    (g1.2.1.mono (fun w hw => ⟨mem_univ _, hw.2⟩)) (fun X η hX _ _ => g1.2.2.1 X η hX) hb1
    (Or.inr (Or.inl rfl))
  obtain ⟨-, hB2⟩ := sim_frame_field_bound h hh0 hh2 hS c2 (-(3 / 2 + h) + 2 * (n : ℝ) * h) 1 Xb
    (fun _ => EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) one_pos
    (g2.2.1.mono (fun w hw => ⟨mem_univ _, hw.2⟩)) (fun X η hX _ _ => g2.2.2.1 X η hX) hb2
    (Or.inr (Or.inr rfl))
  obtain ⟨C1, hC1⟩ := hB1 m
  obtain ⟨C2, hC2⟩ := hB2 m
  refine ⟨|C1| + |C2|, fun x t hxt => ?_⟩
  have ht : t < 1 := hxt.1
  have hq : 0 < simScale h (x 2) (1 - t) := (hS.1 _ _ (by linarith)).1
  have hq1 : simScale h (x 2) (1 - t) ≤ 1 := le_of_lt hxt.2
  have hmem : ((x, t) : ℝ³ × ℝ) ∈ {w : ℝ³ × ℝ | w.2 < 1} := ht
  have b1 : ‖iteratedFDeriv ℝ m F1 (x, t)‖ ≤
      C1 * simScale h (x 2) (1 - t) ^ ((-(2 + h) + 2 * (n : ℝ) * h) - (m : ℝ)) := by
    rw [hF1]; exact hC1 x t hxt
  have b2 : ‖iteratedFDeriv ℝ m F2 (x, t)‖ ≤
      C2 * simScale h (x 2) (1 - t) ^ ((-(3 / 2 + h) + 2 * (n : ℝ) * h) - (m : ℝ)) := by
    rw [hF2]; exact hC2 x t hxt
  have hev : (↿(stressDivField h (fun q X η => q ^ (2 * (n : ℝ) * h) * T1 X η)
      (fun q X η => q ^ (2 * (n : ℝ) * h) * T2 X η))) =ᶠ[nhds (x, t)] (F1 + F2) :=
    Filter.eventuallyEq_of_mem (hΩ.mem_nhds hmem) (fun z hz => key z hz)
  rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds,
    iteratedFDeriv_add_apply ((hF1s.contDiffAt (hΩ.mem_nhds hmem)).of_le (by exact_mod_cast le_top))
      ((hF2s.contDiffAt (hΩ.mem_nhds hmem)).of_le (by exact_mod_cast le_top))]
  have r1 : simScale h (x 2) (1 - t) ^ ((-(2 + h) + 2 * (n : ℝ) * h) - (m : ℝ)) ≤
      simScale h (x 2) (1 - t) ^ (2 * h * (n : ℝ) - ((m : ℝ) + 3)) :=
    Real.rpow_le_rpow_of_exponent_ge hq hq1 (by linarith)
  have r2 : simScale h (x 2) (1 - t) ^ ((-(3 / 2 + h) + 2 * (n : ℝ) * h) - (m : ℝ)) ≤
      simScale h (x 2) (1 - t) ^ (2 * h * (n : ℝ) - ((m : ℝ) + 3)) :=
    Real.rpow_le_rpow_of_exponent_ge hq hq1 (by linarith)
  have p1 := Real.rpow_nonneg hq.le ((-(2 + h) + 2 * (n : ℝ) * h) - (m : ℝ))
  have p2 := Real.rpow_nonneg hq.le ((-(3 / 2 + h) + 2 * (n : ℝ) * h) - (m : ℝ))
  have b1' : ‖iteratedFDeriv ℝ m F1 (x, t)‖ ≤
      |C1| * simScale h (x 2) (1 - t) ^ (2 * h * (n : ℝ) - ((m : ℝ) + 3)) :=
    b1.trans ((mul_le_mul_of_nonneg_right (le_abs_self _) p1).trans
      (mul_le_mul_of_nonneg_left r1 (abs_nonneg _)))
  have b2' : ‖iteratedFDeriv ℝ m F2 (x, t)‖ ≤
      |C2| * simScale h (x 2) (1 - t) ^ (2 * h * (n : ℝ) - ((m : ℝ) + 3)) :=
    b2.trans ((mul_le_mul_of_nonneg_right (le_abs_self _) p2).trans
      (mul_le_mul_of_nonneg_left r2 (abs_nonneg _)))
  refine (norm_add_le _ _).trans ?_
  rw [add_mul]
  exact add_le_add b1' b2'

theorem bg_stress_cutSum : ∀ (h : ℝ) (a : ℕ → ℝ) (Tth Tz : ℕ → ℝ → ℝ → ℝ), 0 < h → h < 1 / 2 → SimScaleProps h → (∀ j, 1 ≤ a j) → (∀ j, 2 * a j ≤ a (j + 1)) → (∀ (n : ℕ) (Y η : ℝ), -1 < η → η < 1 → DifferentiableAt ℝ (fun Y' => Tth n Y' η) Y ∧ DifferentiableAt ℝ (fun Y' => Tz n Y' η) Y) → ∀ (x : ℝ³) (t : ℝ), t < 1 → stressDivField h (bgSum h a Tth) (bgSum h a Tz) x t = cutSum h a (fun n => stressDivField h (fun q X η => q ^ (2 * (n : ℝ) * h) * Tth n X η) (fun q X η => q ^ (2 * (n : ℝ) * h) * Tz n X η)) x t ∧ ∀ J : ℕ, stressDivField h (bgTsum h Tth J) (bgTsum h Tz J) x t = ∑ n ∈ Finset.range (J + 1), stressDivField h (fun q X η => q ^ (2 * (n : ℝ) * h) * Tth n X η) (fun q X η => q ^ (2 * (n : ℝ) * h) * Tz n X η) x t :=
by
  intro h a Tth Tz hh0 hh1 hS ha1 ha2 hD x t ht
  have htau : 0 < 1 - t := by linarith
  have hq : 0 < simScale h (x 2) (1 - t) := (hS.1 (x 2) (1 - t) htau).1
  have hz : x 2 ^ 2 < simScale h (x 2) (1 - t) ^ (1 - 2 * h) := (hS.2.1 (x 2) (1 - t) htau).2

  have hη : -1 < simEta h x t ∧ simEta h x t < 1 := by
    have hr : (simScale h (x 2) (1 - t) ^ (-(1 / 2 - h))) ^ 2 *
        simScale h (x 2) (1 - t) ^ (1 - 2 * h) = 1 := by
      have e : (-(1 / 2 - h)) * ((2 : ℕ) : ℝ) + (1 - 2 * h) = 0 := by push_cast; ring
      rw [← Real.rpow_natCast, ← Real.rpow_mul hq.le, ← Real.rpow_add hq, e, Real.rpow_zero]
    have hr2 : 0 < (simScale h (x 2) (1 - t) ^ (-(1 / 2 - h))) ^ 2 := by
      have := Real.rpow_pos_of_pos hq (-(1 / 2 - h))
      positivity
    have hsq : simEta h x t ^ 2 < 1 := by
      have e2 : simEta h x t ^ 2 = x 2 ^ 2 * (simScale h (x 2) (1 - t) ^ (-(1 / 2 - h))) ^ 2 := by
        unfold simEta; ring
      rw [e2]
      calc x 2 ^ 2 * (simScale h (x 2) (1 - t) ^ (-(1 / 2 - h))) ^ 2
          < simScale h (x 2) (1 - t) ^ (1 - 2 * h) * (simScale h (x 2) (1 - t) ^ (-(1 / 2 - h))) ^ 2 :=
            mul_lt_mul_of_pos_right hz hr2
        _ = 1 := by rw [mul_comm]; exact hr
    constructor <;> nlinarith [sq_nonneg (simEta h x t + 1), sq_nonneg (simEta h x t - 1)]
  have hDX : ∀ n : ℕ, DifferentiableAt ℝ (fun Y' => Tth n Y' (simEta h x t)) (simX h x t) ∧
      DifferentiableAt ℝ (fun Y' => Tz n Y' (simEta h x t)) (simX h x t) :=
    fun n => hD n _ _ hη.1 hη.2

  have hlin : ∀ (s : Finset ℕ) (c : ℕ → ℝ) (Tth' Tz' : ℝ → ℝ → ℝ → ℝ),
      (∀ Y : ℝ, Tth' (simScale h (x 2) (1 - t)) Y (simEta h x t) =
        ∑ n ∈ s, c n * Tth n Y (simEta h x t)) →
      (∀ Y : ℝ, Tz' (simScale h (x 2) (1 - t)) Y (simEta h x t) =
        ∑ n ∈ s, c n * Tz n Y (simEta h x t)) →
      stressDivField h Tth' Tz' x t =
        ∑ n ∈ s, c n • stressDivField h (fun _ X η => Tth n X η) (fun _ X η => Tz n X η) x t := by
    intro s c Tth' Tz' h1 h2
    have d1 : deriv (fun Y => ∑ n ∈ s, c n * Tth n Y (simEta h x t)) (simX h x t) =
        ∑ n ∈ s, c n * deriv (fun Y => Tth n Y (simEta h x t)) (simX h x t) := by
      rw [deriv_fun_sum (fun n _ => ((hDX n).1.const_mul (c n)))]
      exact Finset.sum_congr rfl (fun n _ => deriv_const_mul _ (hDX n).1)
    have d2 : deriv (fun Y => ∑ n ∈ s, c n * Tz n Y (simEta h x t)) (simX h x t) =
        ∑ n ∈ s, c n * deriv (fun Y => Tz n Y (simEta h x t)) (simX h x t) := by
      rw [deriv_fun_sum (fun n _ => ((hDX n).2.const_mul (c n)))]
      exact Finset.sum_congr rfl (fun n _ => deriv_const_mul _ (hDX n).2)
    unfold stressDivField
    simp only [h1, h2]
    rw [d1, d2]
    simp only [Finset.sum_div, ← Finset.sum_add_distrib, Finset.mul_sum, ← Finset.sum_neg_distrib,
      Finset.sum_smul]
    refine Finset.sum_congr rfl (fun n _ => ?_)
    rw [smul_add, smul_smul, smul_smul]
    congr 2 <;> ring

  have hscale : ∀ n : ℕ, stressDivField h (fun q X η => q ^ (2 * (n : ℝ) * h) * Tth n X η)
      (fun q X η => q ^ (2 * (n : ℝ) * h) * Tz n X η) x t =
      simScale h (x 2) (1 - t) ^ (2 * (n : ℝ) * h) •
        stressDivField h (fun _ X η => Tth n X η) (fun _ X η => Tz n X η) x t := by
    intro n
    have := hlin {n} (fun _ => simScale h (x 2) (1 - t) ^ (2 * (n : ℝ) * h))
      (fun q X η => q ^ (2 * (n : ℝ) * h) * Tth n X η) (fun q X η => q ^ (2 * (n : ℝ) * h) * Tz n X η)
      (fun Y => by rw [Finset.sum_singleton]) (fun Y => by rw [Finset.sum_singleton])
    rw [this, Finset.sum_singleton]
  refine ⟨?_, fun J => ?_⟩
  swap
  · rw [hlin (Finset.range (J + 1)) (fun n => simScale h (x 2) (1 - t) ^ (2 * (n : ℝ) * h))
      (bgTsum h Tth J) (bgTsum h Tz J) (fun Y => rfl) (fun Y => rfl)]
    exact Finset.sum_congr rfl (fun n _ => (hscale n).symm)

  have hlinA : ∀ j : ℕ, (j : ℝ) + 1 ≤ a j := by
    intro j
    induction j with
    | zero => simpa using ha1 0
    | succ k ih =>
      have e1 := ha2 k
      have e2 := ha1 k
      push_cast
      linarith
  obtain ⟨N₀, hN₀⟩ := exists_nat_gt (1 / simScale h (x 2) (1 - t))
  have hcut0 : ∀ j : ℕ, N₀ ≤ j → bgCut (a (j + 1)) (simScale h (x 2) (1 - t)) = 0 := by
    intro j hj
    have h1 : (N₀ : ℝ) ≤ j := by exact_mod_cast hj
    have h2 := hlinA (j + 1)
    push_cast at h2
    have h3 : 1 / simScale h (x 2) (1 - t) < a (j + 1) := by linarith
    have h4 : 1 < a (j + 1) * simScale h (x 2) (1 - t) := by
      rw [div_lt_iff₀ hq] at h3
      linarith
    unfold bgCut
    exact Real.smoothTransition.zero_of_nonpos (by linarith)
  obtain ⟨c, hc⟩ : ∃ c : ℕ → ℝ, c = fun n => if n = 0 then 1 else
      bgCut (a n) (simScale h (x 2) (1 - t)) * simScale h (x 2) (1 - t) ^ (2 * (n : ℝ) * h) :=
    ⟨_, rfl⟩
  have hc0 : c 0 = 1 := by rw [hc]; simp
  have hcs : ∀ j : ℕ, c (j + 1) = bgCut (a (j + 1)) (simScale h (x 2) (1 - t)) *
      simScale h (x 2) (1 - t) ^ (2 * ((j + 1 : ℕ) : ℝ) * h) := by
    intro j; rw [hc]; simp
  have hsumT : ∀ (T : ℕ → ℝ → ℝ → ℝ) (Y : ℝ),
      bgSum h a T (simScale h (x 2) (1 - t)) Y (simEta h x t) =
        ∑ n ∈ Finset.range (N₀ + 1), c n * T n Y (simEta h x t) := by
    intro T Y
    unfold bgSum
    rw [tsum_eq_sum (s := Finset.range N₀) (fun j hj => by
      rw [hcut0 j (by simpa using hj), zero_mul, zero_mul])]
    rw [Finset.sum_range_succ', hc0, one_mul]
    refine (add_comm _ _).trans ?_
    congr 1
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [hcs j]
    push_cast
    ring
  have hsc : ∀ b : ℝ, simCut h b x t = bgCut b (simScale h (x 2) (1 - t)) := fun b => rfl
  rw [hlin (Finset.range (N₀ + 1)) c (bgSum h a Tth) (bgSum h a Tz) (hsumT Tth) (hsumT Tz)]
  simp only [cutSum]
  rw [tsum_eq_sum (s := Finset.range N₀) (fun j hj => by
    rw [hsc, hcut0 j (by simpa using hj), zero_smul])]
  rw [Finset.sum_range_succ']
  refine (add_comm _ _).trans ?_
  congr 1
  · rw [hscale 0, hc0, one_smul]
    simp
  · refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [hscale (j + 1), smul_smul, hcs j, hsc]

theorem bg_flat_assembly : ∀ (h : ℝ) (a L M Kr : ℕ → ℝ) (A Bv Ψ : ℕ → ℝ³ → ℝ → ℝ³) (P : ℕ → ℝ³ → ℝ → ℝ) (A' Bv' Φ0 Ψ' : ℝ³ → ℝ → ℝ³) (P' : ℝ³ → ℝ → ℝ), 0 < h → h < 1 / 2 → SimScaleProps h → (∀ j, 1 ≤ a j) → (∀ j, ContDiffOn ℝ ∞ (↿(A j)) (simDomain h 1) ∧ ContDiffOn ℝ ∞ (↿(Bv j)) (simDomain h 1) ∧ ContDiffOn ℝ ∞ (↿(P j)) (simDomain h 1) ∧ ContDiffOn ℝ ∞ (↿(Ψ j)) (simDomain h 1)) → ContDiffOn ℝ ∞ (↿A') (simDomain h 1) → ContDiffOn ℝ ∞ (↿Bv') (simDomain h 1) → ContDiffOn ℝ ∞ (↿P') (simDomain h 1) → ContDiffOn ℝ ∞ (↿Φ0) (simDomain h 1) → ContDiffOn ℝ ∞ (↿Ψ') (simDomain h 1) → (∀ k : ℕ, ∃ K : ℝ, ∀ j : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ‖iteratedFDeriv ℝ k (↿(A j)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧ ‖iteratedFDeriv ℝ k (↿(Bv j)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧ ‖iteratedFDeriv ℝ k (↿(P j)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧ ‖iteratedFDeriv ℝ k (↿(Ψ j)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K)) → (∀ k : ℕ, ∃ C K : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ‖iteratedFDeriv ℝ k (↿A') (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧ ‖iteratedFDeriv ℝ k (↿Bv') (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧ ‖iteratedFDeriv ℝ k (↿P') (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧ ‖iteratedFDeriv ℝ k (↿Ψ') (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K)) → (∀ J k : ℕ, k ≤ J → ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → a J * simScale h (x 2) (1 - t) < 1 / 2 → ‖iteratedFDeriv ℝ k (fun z => (↿A') z - ∑ j ∈ Finset.range (J + 1), (↿(A j)) z) (x, t)‖ ≤ (1 / 2) ^ J * simScale h (x 2) (1 - t) ^ (2 * h * ((J : ℝ) + 1) / 2 - L k) ∧ ‖iteratedFDeriv ℝ k (fun z => (↿Bv') z - ∑ j ∈ Finset.range (J + 1), (↿(Bv j)) z) (x, t)‖ ≤ (1 / 2) ^ J * simScale h (x 2) (1 - t) ^ (2 * h * ((J : ℝ) + 1) / 2 - L k) ∧ ‖iteratedFDeriv ℝ k (fun z => (↿P') z - ∑ j ∈ Finset.range (J + 1), (↿(P j)) z) (x, t)‖ ≤ (1 / 2) ^ J * simScale h (x 2) (1 - t) ^ (2 * h * ((J : ℝ) + 1) / 2 - L k) ∧ ‖iteratedFDeriv ℝ k (fun z => (↿Ψ') z - ∑ j ∈ Finset.range (J + 1), (↿(Ψ j)) z) (x, t)‖ ≤ (1 / 2) ^ J * simScale h (x 2) (1 - t) ^ (2 * h * ((J : ℝ) + 1) / 2 - M k)) → (∀ J m : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ‖iteratedFDeriv ℝ m (↿(fun (y : ℝ³) (s : ℝ) => nsResidual 1 (fun y' s' => curl3 (fun w => ∑ j ∈ Finset.range (J + 1), A j w s') y' + ∑ j ∈ Finset.range (J + 1), Bv j y' s') (fun y' s' => ∑ j ∈ Finset.range (J + 1), P j y' s') y s - (Φ0 y s + ∑ j ∈ Finset.range (J + 1), Ψ j y s))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (2 * h * ((J : ℝ) + 1) - Kr m)) → ∀ m N : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ‖iteratedFDeriv ℝ m (↿(fun (y : ℝ³) (s : ℝ) => nsResidual 1 (fun y' s' => curl3 (fun w => A' w s') y' + Bv' y' s') P' y s - (Φ0 y s + Ψ' y s))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (N : ℝ) :=
by
  suffices hRC : ∀ m : ℕ, ∃ c : ℝ, 0 ≤ c ∧ ∀ (A₀ B₀ A₁ B₁ : ℝ³ → ℝ → ℝ³) (P₀ P₁ : ℝ³ → ℝ → ℝ) (O : Set (ℝ³ × ℝ)), IsOpen O → ContDiffOn ℝ ∞ (↿A₀) O → ContDiffOn ℝ ∞ (↿B₀) O → ContDiffOn ℝ ∞ (↿P₀) O → ContDiffOn ℝ ∞ (↿A₁) O → ContDiffOn ℝ ∞ (↿B₁) O → ContDiffOn ℝ ∞ (↿P₁) O → ∀ z ∈ O, (ContDiffAt ℝ m (↿(nsResidual 1 (fun y s => curl3 (fun w => A₁ w s) y + B₁ y s) P₁)) z ∧ ContDiffAt ℝ m (↿(nsResidual 1 (fun y s => curl3 (fun w => A₀ w s) y + B₀ y s) P₀)) z) ∧ ‖iteratedFDeriv ℝ m (↿(nsResidual 1 (fun y s => curl3 (fun w => A₁ w s) y + B₁ y s) P₁)) z - iteratedFDeriv ℝ m (↿(nsResidual 1 (fun y s => curl3 (fun w => A₀ w s) y + B₀ y s) P₀)) z‖ ≤ c * (∑ k ∈ Finset.range (m + 4), (‖iteratedFDeriv ℝ k (fun w => (↿A₁) w - (↿A₀) w) z‖ + ‖iteratedFDeriv ℝ k (fun w => (↿B₁) w - (↿B₀) w) z‖ + ‖iteratedFDeriv ℝ k (fun w => (↿P₁) w - (↿P₀) w) z‖)) * (1 + ∑ k ∈ Finset.range (m + 4), (‖iteratedFDeriv ℝ k (↿A₀) z‖ + ‖iteratedFDeriv ℝ k (↿B₀) z‖ + ‖iteratedFDeriv ℝ k (fun w => (↿A₁) w - (↿A₀) w) z‖ + ‖iteratedFDeriv ℝ k (fun w => (↿B₁) w - (↿B₀) w) z‖)) by
    intro h a L M Kr A Bv Ψ P A' Bv' Φ0 Ψ' P' hh0 hh1 hS ha hsmj hsA' hsB' hsP' hsΦ hsΨ' hPer hSum
      htail htr m N

    have hΩ : IsOpen (simDomain h 1) := by
      have hU : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
      have h1 : ContinuousOn (fun v : ℝ × ℝ => simScale h v.1 v.2) (univ ×ˢ Ioi 0) :=
        hS.2.2.2.1.continuousOn
      have hf : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) := by fun_prop
      have hg : ContinuousOn (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2))
          {w : ℝ³ × ℝ | w.2 < 1} := by
        refine h1.comp hf.continuousOn ?_
        intro w hw
        have hw' : w.2 < 1 := hw
        exact ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by linarith⟩
      exact hg.isOpen_inter_preimage hU isOpen_Iio
    have hpos : ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
        0 < simScale h (x 2) (1 - t) ∧ simScale h (x 2) (1 - t) ≤ 1 := by
      intro x t hxt
      have ht : t < 1 := hxt.1
      have hlt : simScale h (x 2) (1 - t) < 1 := hxt.2
      exact ⟨(hS.1 (x 2) (1 - t) (by linarith)).1, hlt.le⟩
    have hca : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : ℝ³ × ℝ → V) (k : ℕ)
        (z : ℝ³ × ℝ), z ∈ simDomain h 1 → ContDiffOn ℝ ∞ f (simDomain h 1) → ContDiffAt ℝ k f z := by
      intro V _ _ f k z hz hf
      exact (hf.contDiffAt (hΩ.mem_nhds hz)).of_le (by exact_mod_cast le_top)
    have hdiffb : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f g : ℝ³ × ℝ → V) (k : ℕ)
        (z : ℝ³ × ℝ), z ∈ simDomain h 1 → ContDiffOn ℝ ∞ f (simDomain h 1) →
        ContDiffOn ℝ ∞ g (simDomain h 1) →
        ‖iteratedFDeriv ℝ k (fun w => f w - g w) z‖ ≤ ‖iteratedFDeriv ℝ k f z‖ + ‖iteratedFDeriv ℝ k g z‖ := by
      intro V _ _ f g k z hz hf hg
      have e : (fun w => f w - g w) = f - g := rfl
      rw [e, iteratedFDeriv_sub_apply (hca f k z hz hf) (hca g k z hz hg)]
      exact norm_sub_le _ _
    have hsplit3 : ∀ (R1 R0 X2 X3 G : ℝ³ × ℝ → ℝ³) (z : ℝ³ × ℝ), ContDiffAt ℝ m R1 z →
        ContDiffAt ℝ m R0 z → ContDiffAt ℝ m X2 z → ContDiffAt ℝ m X3 z →
        (∀ w, G w = (R1 w - R0 w) + X2 w - X3 w) →
        ‖iteratedFDeriv ℝ m G z‖ ≤ ‖iteratedFDeriv ℝ m R1 z - iteratedFDeriv ℝ m R0 z‖ +
          ‖iteratedFDeriv ℝ m X2 z‖ + ‖iteratedFDeriv ℝ m X3 z‖ := by
      intro R1 R0 X2 X3 G z h1 h0 h2 h3 hG
      have e1 : G = ((R1 - R0) + X2) - X3 := funext hG
      rw [e1, iteratedFDeriv_sub_apply (f := (R1 - R0) + X2) (g := X3) ((h1.sub h0).add h2) h3,
        iteratedFDeriv_add_apply (f := R1 - R0) (g := X2) (h1.sub h0) h2,
        iteratedFDeriv_sub_apply (f := R1) (g := R0) h1 h0]
      exact (norm_sub_le _ _).trans (add_le_add (norm_add_le _ _) le_rfl)
    have eid : ∀ (r1 r0 φ ψ s : ℝ³), r1 - (φ + ψ) = (r1 - r0) + (r0 - (φ + s)) - (ψ - s) := by
      intro r1 r0 φ ψ s
      abel

    obtain ⟨c, hc0, hRD⟩ := hRC m
    choose Kp hKp using hPer
    choose Cp hCp using hKp
    choose Cs Ks hCs using hSum
    have hsingle : ∀ (f : ℕ → ℝ) (S : ℝ), ∑ i ∈ Finset.range (m + 4), |f i| = S → ∀ k, k < m + 4 →
        f k ≤ S ∧ |f k| ≤ S ∧ 0 ≤ S := by
      intro f S hS k hk
      rw [← hS]
      have h1 : |f k| ≤ ∑ i ∈ Finset.range (m + 4), |f i| :=
        Finset.single_le_sum (f := fun i => |f i|) (fun i _ => abs_nonneg _) (Finset.mem_range.mpr hk)
      exact ⟨(le_abs_self _).trans h1, h1, (abs_nonneg _).trans h1⟩
    obtain ⟨Kst, hKst⟩ : ∃ S : ℝ, ∑ i ∈ Finset.range (m + 4), |Kp i| = S := ⟨_, rfl⟩
    obtain ⟨Kss, hKss⟩ : ∃ S : ℝ, ∑ i ∈ Finset.range (m + 4), |Ks i| = S := ⟨_, rfl⟩
    obtain ⟨Css, hCss⟩ : ∃ S : ℝ, ∑ i ∈ Finset.range (m + 4), |Cs i| = S := ⟨_, rfl⟩
    obtain ⟨Lst, hLst⟩ : ∃ S : ℝ, ∑ i ∈ Finset.range (m + 4), |L i| = S := ⟨_, rfl⟩
    have hKst0 := (hsingle Kp Kst hKst 0 (by omega)).2.2
    have hKss0 := (hsingle Ks Kss hKss 0 (by omega)).2.2
    have hCss0 := (hsingle Cs Css hCss 0 (by omega)).2.2
    have hLst0 := (hsingle L Lst hLst 0 (by omega)).2.2
    have hN0 : (0:ℝ) ≤ (N:ℝ) := Nat.cast_nonneg N
    have hm0 : (0:ℝ) ≤ (m:ℝ) := Nat.cast_nonneg m
    have habM := abs_nonneg (M m)
    have habK := abs_nonneg (Kr m)
    have hleM := le_abs_self (M m)
    have hleK := le_abs_self (Kr m)
    have hTT : (0:ℝ) ≤ (N:ℝ) + Kst + Lst + |M m| + |Kr m| := by linarith
    obtain ⟨J, hJ⟩ := exists_nat_gt ((m:ℝ) + 3 + ((N:ℝ) + Kst + Lst + |M m| + |Kr m|) / h)
    have hd : 0 ≤ ((N:ℝ) + Kst + Lst + |M m| + |Kr m|) / h := div_nonneg hTT hh0.le
    have hJ1 : m + 3 ≤ J := by
      have : ((m + 3 : ℕ) : ℝ) < J := by push_cast; linarith
      exact_mod_cast this.le
    have hJh : (N:ℝ) + Kst + Lst + |M m| + |Kr m| ≤ (J:ℝ) * h := by
      have h1 : ((N:ℝ) + Kst + Lst + |M m| + |Kr m|) / h < J := by linarith
      rw [div_lt_iff₀ hh0] at h1
      linarith
    have hJ0 : (0:ℝ) ≤ (J:ℝ) := Nat.cast_nonneg J
    have hJh0 : 0 ≤ (J:ℝ) * h := mul_nonneg hJ0 hh0.le
    have eJ : 2 * h * ((J : ℝ) + 1) / 2 = (J:ℝ) * h + h := by ring
    have eJ' : 2 * h * ((J : ℝ) + 1) = 2 * ((J:ℝ) * h) + 2 * h := by ring
    have hJ2 : ∀ k, k < m + 4 → (N:ℝ) + Kst ≤ 2 * h * ((J : ℝ) + 1) / 2 - L k := by
      intro k hk
      have hLk := (hsingle L Lst hLst k hk).1
      rw [eJ]
      linarith
    have hJ3 : (N:ℝ) ≤ 2 * h * ((J : ℝ) + 1) / 2 - M m := by
      rw [eJ]
      linarith
    have hJ4 : (N:ℝ) ≤ 2 * h * ((J : ℝ) + 1) - Kr m := by
      rw [eJ']
      linarith
    obtain ⟨D, hD⟩ : ∃ D : ℝ, ∑ i ∈ Finset.range (m + 4), ∑ j ∈ Finset.range (J + 1), |Cp i j| = D :=
      ⟨_, rfl⟩
    have hCpD : ∀ k, k < m + 4 → ∑ j ∈ Finset.range (J + 1), |Cp k j| ≤ D := by
      intro k hk
      rw [← hD]
      exact Finset.single_le_sum (f := fun i => ∑ j ∈ Finset.range (J + 1), |Cp i j|)
