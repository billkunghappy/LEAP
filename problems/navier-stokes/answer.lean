  have pin : ∀ s : ℝ × ℝ × ℝ, s ∈ Ω → ∀ v' : ℝ, 0 ≤ v' → v' ≤ Lsb B.h G.r0 γ.1 →
      M γ s v' = Af (s.1, s.2.1, s.2.2, ξ.2.2.2 + (v' - y0) • d) := by
    intro s hs v' h0 h1
    obtain ⟨hvco, hrect, -⟩ := pulse_line_rect5 B.h G.r0 γ (G.ctr γ) ξ.2.2.2 hr0 hr0' hR v' h0 h1
    rw [← hd, ← hy0] at hvco hrect
    have hDs : ((s.1, s.2.1, s.2.2, ξ.2.2.2 + (v' - y0) • d) : Cyl) ∈ DomC B.h B.qB := hs
    have hMe : ∀ z : Fin 3 → ℝ, Matrix.mulVec (M γ s v') z =
        (APhi5 B G γ (s.1, s.2.1, s.2.2, ξ.2.2.2 + (v' - y0) • d)).mulVec z -
          dDamp5 B G γ (s.1, s.2.1, s.2.2, ξ.2.2.2 + (v' - y0) • d) • z := by
      intro z
      calc Matrix.mulVec (M γ s v') z
          = Matrix.mulVec (M γ s (vco B.h G.r0 γ (G.ctr γ) (ξ.2.2.2 + (v' - y0) • d))) z := by rw [hvco]
        _ = _ := hM γ (s.1, s.2.1, s.2.2, ξ.2.2.2 + (v' - y0) • d) hDs hrect z
    rw [hAf]
    funext a c
    beta_reduce
    have h1 := congrFun (hMe (Pi.single c 1)) a
    have e1 : Matrix.mulVec (M γ s v') (Pi.single c 1) a = M γ s v' a c :=
