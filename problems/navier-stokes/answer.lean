      refine ⟨?_, fun X w a b hw => ?_⟩
      · rw [hIf j]; exact this.1
      · rw [hI j X w]; exact this.2 X w a b hw
    have hlev1 : ∀ j : ℕ, ∀ X, 0 < X → X < Xi → ∀ w ∈ cStrip (ρ j),
