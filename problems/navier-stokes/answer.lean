  have e1 := (hΩ (ξ.1, ξ.2.1, ξ.2.2.1) hD).symm.trans hN0
  have h1e : pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) 0 1 = A := by
    rw [← congrFun e1 1, hAdef]
    show pang5 B G γ / (ξ.1 / Real.sqrt (Qb γ.1)) = pang5 B G γ * Real.sqrt (Qb γ.1) / ξ.1
