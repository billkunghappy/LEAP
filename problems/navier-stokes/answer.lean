theorem pulse_small_coeff5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ lP : ℕ, ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ (γ : Lab) (ξ : Cyl), ActiveL4 B G γ → γ.1 < lP → ξ ∈ DomC B.h B.qB → etaL B.h γ ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), (∀ y : Fin 3 → ℝ, ‖(APhi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv))).mulVec y - dDamp5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) • y‖ ≤ Λ * ‖y‖) ∧ |lam0_5 B G γ / Real.sqrt (1 + sco B G γ v ^ 2) - epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 * (1 + sco B G γ v ^ 2)| ≤ Λ :=
by
