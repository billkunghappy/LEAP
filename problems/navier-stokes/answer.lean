    _ = _ := by rw [hqm, hSb, hQdef]; ring

theorem stress5_linear_harmonics : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
