theorem stress5_signed_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (l5 : ℕ) (c : ℝ), 0 < c →
    PrimNondegAt4 B G l5 c → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (S : CState) (Bo : ℝ), 7/10 ≤ Bo → StressIn5 B G l0 S Bo → StressTargetOK5 B G l0 S Bo →
    SignedClass5 B G l0 S Bo :=
by
  intro B G hB hG l5 c hc h5
  obtain ⟨lP, hP⟩ := pulse_profile_bound_v5 B G hB hG
  obtain ⟨lD, hD⟩ := signed_scalar_amplitude_bound_v5 B G hB hG l5 c hc h5
  obtain ⟨lE, hE⟩ := lsh5_class_from_bounds_v5 B G hB hG l5 c hc h5 lP hP
  obtain ⟨lG, cG, b0, hcG, hGeo⟩ := nphi5_geometry_v5 B G hB hG
  obtain ⟨lF, hF⟩ := wave_potential_transfer_v5 B G hB hG lG cG b0 hcG hGeo
  obtain ⟨-, -, -, -, -, -, -, hqB0, -⟩ := hB.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨lD + lE + lF + n0, ?_⟩
  intro l0 hl0 S Bo _hBo _hIn hT
  have hr0 : 0 < G.r0 := hG.1.1

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hDom : ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ DomC B.h B.qB := fun ξ hξ =>
    ⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqsB⟩

  have hcib : ∀ l : ℕ, 0 < cib B.h l := by
    intro l
    unfold cib
    have hTg : (0:ℝ) < Tgc := by unfold Tgc; positivity
    have hQ : (0:ℝ) < Qb l := by unfold Qb; positivity
    exact mul_pos (zpow_pos hTg _) (Real.rpow_pos_of_pos hQ _)

  have hchig : ∀ s : ℝ, chig G.r0 s ≠ 0 → |s| < G.r0 / 4 := by
    intro s hs
    unfold chig bumpR at hs
    by_contra hcon
    apply hs
    apply Real.smoothTransition.zero_of_nonpos
    push_neg at hcon
    have h1 : G.r0 ≤ |4 * s| := by
      rw [abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 4)]; linarith
    have h2 : 1 ≤ (4 * s / G.r0) ^ 2 := by
      rw [div_pow, le_div_iff₀ (by positivity), one_mul, ← sq_abs (4 * s)]
      nlinarith [abs_nonneg (4 * s)]
    linarith

  have hpsi : ∀ (γ : Lab) (Y : ℝ × ℝ), psiT (Lsb B.h G.r0 γ.1) (vco B.h G.r0 γ (G.ctr γ) Y) ≠ 0 →
      |etG B.h γ (G.ctr γ) Y| < 2 * G.r0 / 3 := by
    intro γ Y hs
    have hc := hcib γ.1
    unfold psiT at hs
    by_contra hcon
    apply hs
    apply Real.smoothTransition.zero_of_nonpos
    push_neg at hcon
    have hv : vco B.h G.r0 γ (G.ctr γ) Y - Lsb B.h G.r0 γ.1 / 2 = etG B.h γ (G.ctr γ) Y / cib B.h γ.1 := by
      unfold vco Lsb; ring
    rw [hv]
    have hL : 0 < 2 * G.r0 / cib B.h γ.1 := div_pos (by linarith) hc
    apply div_nonpos_of_nonpos_of_nonneg
    · unfold Lsb
      rw [abs_div, abs_of_pos hc]
      have e : 2 * G.r0 / cib B.h γ.1 / 3 = (2 * G.r0 / 3) / cib B.h γ.1 := by ring
      rw [e, sub_nonpos]
      gcongr
    · unfold Lsb
      linarith

  have hsupp : ∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), LSc5 B G l0 S γ ξ ≠ 0 →
      ActiveL4 B G γ ∧ etaL B.h γ ξ ≠ 0 ∧ |xiG B.h γ (G.ctr γ) ξ.2.2.2| ≤ G.r0 / 4 ∧
        |etG B.h γ (G.ctr γ) ξ.2.2.2| ≤ 2 * G.r0 / 3 := by
    intro γ ξ _hξ hne
    unfold LSc5 at hne
    split_ifs at hne with hg
    · have h1 : (Real.sqrt (epsb B.h γ.1) / 2 * etaL B.h γ ξ * sigAmp5 B G l0 S γ ξ *
          chig G.r0 (xiG B.h γ (G.ctr γ) ξ.2.2.2) *
          psiT (Lsb B.h G.r0 γ.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) ≠ 0 := by
        intro h0; apply hne; rw [h0, zero_smul]
      obtain ⟨h2, hps⟩ := mul_ne_zero_iff.mp h1
      obtain ⟨h3, hch⟩ := mul_ne_zero_iff.mp h2
      obtain ⟨h4, -⟩ := mul_ne_zero_iff.mp h3
      obtain ⟨-, heta⟩ := mul_ne_zero_iff.mp h4
      exact ⟨hg.1, heta, (hchig _ hch).le, (hpsi γ _ hps).le⟩
    · exact absurd rfl hne

  have htr : ∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), dotProduct (nPhi5 B G γ ξ) (LSc5 B G l0 S γ ξ) = 0 := by
    intro γ ξ hξ
    by_cases h0 : LSc5 B G l0 S γ ξ = 0
    · rw [h0, dotProduct_zero]
    · obtain ⟨hA, heta, hxi, het⟩ := hsupp γ ξ hξ h0
      have hR : inRect B.h γ (G.ctr γ) G.r0 ξ.2.2.2 := ⟨by linarith, by linarith⟩
      have hT0 := tH_transversal_v5 B G hB hG γ ξ hA heta (hDom ξ hξ) hR
      unfold LSc5
      split_ifs
      · rw [dotProduct_smul, hT0, smul_zero]
      · exact dotProduct_zero _

  have hσ := hT.2.2.1
  have hsc := hD l0 (by omega) S (Bo + 1/2 - kapS) hσ
  have e1 : Bo + 1/2 - kapS - 1/2 = Bo - kapS := by ring
  simp only [e1] at hsc
  have hL := hE l0 (by omega) S (Bo - kapS) (Bo + 1/2 - kapS) hσ hT.1 hsc
  obtain ⟨F1, F2, F3, F4⟩ := hF l0 (by omega) (LSc5 B G l0 S) (Bo - kapS) hsupp htr hL
  have e2 : Bo - kapS + 1/2 = Bo + 1/2 - kapS := by ring
  have e3 : Bo - kapS + 1/2 - kapS = Bo + 1/2 - 2 * kapS := by ring
  rw [e2] at F1 F4
  rw [e3] at F3
  exact ⟨hL, F1, F2, F3, F4⟩

theorem curl3_rotZ_conj : ∀ (α : ℝ) (F : ℝ³ → ℝ³) (x : ℝ³),
    curl3 (fun y => rotZ (-α) (F (rotZ α y))) x = rotZ (-α) (curl3 F (rotZ α x)) :=
by
  intro α F x
  have hadd : ∀ (β : ℝ) (u v : ℝ³), rotZ β (u + v) = rotZ β u + rotZ β v := by
    intro β u v; ext i; fin_cases i <;> simp [rotZ] <;> ring
  have hsmul : ∀ (β k : ℝ) (u : ℝ³), rotZ β (k • u) = k • rotZ β u := by
    intro β k u; ext i; fin_cases i <;> simp [rotZ] <;> ring
  have hinv : ∀ (β : ℝ) (y : ℝ³), rotZ (-β) (rotZ β y) = y := by
    intro β y
    have h := Real.cos_sq_add_sin_sq β
    ext i; fin_cases i
    · simp [rotZ, Real.cos_neg, Real.sin_neg]
      linear_combination y 0 * h
    · simp [rotZ, Real.cos_neg, Real.sin_neg]
      linear_combination y 1 * h
    · simp [rotZ]
  have hinv' : ∀ y : ℝ³, rotZ α (rotZ (-α) y) = y := by
    intro y; have := hinv (-α) y; rwa [neg_neg] at this
  let f : ℝ³ ≃ₗ[ℝ] ℝ³ :=
    { toFun := rotZ α, map_add' := hadd α, map_smul' := hsmul α,
      invFun := rotZ (-α), left_inv := hinv α, right_inv := hinv' }
  let e : ℝ³ ≃L[ℝ] ℝ³ := f.toContinuousLinearEquiv
  have he : ∀ y, e y = rotZ α y := fun y => rfl
  have hes : ∀ y, e.symm y = rotZ (-α) y := fun y => rfl
  have hfun : (fun y => rotZ (-α) (F (rotZ α y))) = ⇑e.symm ∘ (F ∘ ⇑e) := by
    funext y; simp only [Function.comp, he, hes]
  have hD : ∀ v, fderiv ℝ (fun y => rotZ (-α) (F (rotZ α y))) x v
      = rotZ (-α) (fderiv ℝ F (rotZ α x) (rotZ α v)) := by
    intro v
    rw [hfun, ContinuousLinearEquiv.comp_fderiv, ContinuousLinearEquiv.comp_right_fderiv]
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe, he, hes]
  have hb0 : rotZ α (EuclideanSpace.single 0 1 : ℝ³) =
      Real.cos α • (EuclideanSpace.single 0 1 : ℝ³) + Real.sin α • (EuclideanSpace.single 1 1 : ℝ³) := by
    ext i; fin_cases i <;> simp [rotZ]
  have hb1 : rotZ α (EuclideanSpace.single 1 1 : ℝ³) =
      (-Real.sin α) • (EuclideanSpace.single 0 1 : ℝ³) + Real.cos α • (EuclideanSpace.single 1 1 : ℝ³) := by
    ext i; fin_cases i <;> simp [rotZ]
  have hb2 : rotZ α (EuclideanSpace.single 2 1 : ℝ³) = (EuclideanSpace.single 2 1 : ℝ³) := by
    ext i; fin_cases i <;> simp [rotZ]
  have hc2 := Real.cos_sq_add_sin_sq α
  unfold curl3
  simp only [hD, hb0, hb1, hb2, map_add, map_smul]
  generalize fderiv ℝ F (rotZ α x) = D
  ext i; fin_cases i
  · simp [rotZ, Real.cos_neg, Real.sin_neg]
    ring
  · simp [rotZ, Real.cos_neg, Real.sin_neg]
    ring
  · simp [rotZ, Real.cos_neg, Real.sin_neg]
    linear_combination (D (EuclideanSpace.single 0 1) 1 -
      D (EuclideanSpace.single 1 1) 0) * hc2

theorem wave_fld_rot_trig5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (a : WC), B.ok → GeomPrim5 B G →
    qsOf l0 ≤ B.qB → (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → a γ m = 0) →
    (∀ γ m, ContDiffOn ℝ ∞ (a γ m) (DomC B.h (qsOf l0))) →
    (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → a γ m ξ ≠ 0 → SuppW B G γ ξ) →
    ∀ ξ ∈ DomC B.h (qsOf l0), ∃ (K : Finset (Lab × ℤ)) (P Q : Lab × ℤ → ℝ³ → ℝ³),
      (∀ k ∈ K, k.2 * pint5 B G k.1 ≠ 0 ∧ DifferentiableAt ℝ (P k) (rotPt ξ.1 0 ξ.2.1) ∧
        DifferentiableAt ℝ (Q k) (rotPt ξ.1 0 ξ.2.1)) ∧
      ∀ᶠ y in nhds (rotPt ξ.1 0 ξ.2.1), ∀ θ : ℝ,
        rotZ (-θ) (waveFld5 B G l0 a ξ.2.2.1 (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1) (rotZ θ y)) =
          ∑ k ∈ K, (Real.cos (((k.2 * pint5 B G k.1 : ℤ) : ℝ) * θ) • P k y -
            Real.sin (((k.2 * pint5 B G k.1 : ℤ) : ℝ) * θ) • Q k y) :=
by
  intro B G l0 a hB hG hqsB hHex hCD hSupp ξ hξ
  obtain ⟨H, h0H, hH⟩ := hHex

  have hMC : ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      DifferentiableAt ℝ (modeCoef5 B G a γ m) ξ := by
    intro γ m ξ hξ
    have hok := hB
    have hqs := hqsB
    generalize qsOf l0 = qs at hξ hqs hCD hSupp
    have hDopen : IsOpen (DomC B.h qs) := by
      have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
        (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
      have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
        hok.1.2.2.2.1.continuousOn
      have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
      have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
          ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
        intro ξ hξ
        have h' : ξ.2.2.1 < 1 := hξ.2
        exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
      have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
          (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
          ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
      have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
      have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qs))
      have e : DomC B.h qs =
          ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio qs := by
        ext ξ
        constructor
        · rintro ⟨e1, e2, e3⟩
          exact ⟨⟨e1, e2⟩, e3⟩
        · rintro ⟨⟨e1, e2⟩, e3⟩
          exact ⟨e1, e2, e3⟩
      rw [e]
      exact h3'
    have hDn : DomC B.h qs ∈ nhds ξ := hDopen.mem_nhds hξ
    obtain ⟨hr, ht, hqξ⟩ := id hξ
    have hamp : DifferentiableAt ℝ (a γ m) ξ :=
      ((hCD γ m).contDiffAt hDn).differentiableAt (by norm_num)
    have hai : ∀ i, DifferentiableAt ℝ (fun η => a γ m η i) ξ := differentiableAt_pi.1 hamp
    set v : Cyl → ℝ × ℝ := fun η => Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ with hv
    have hvc : Continuous v := by
      rw [hv]
      unfold Jpow
      fun_prop
    set U : Set Cyl := DomC B.h qs ∩ {η | |(v η).1 - (v ξ).1| < 1/8} ∩
      {η | |(v η).2 - (v ξ).2| < 1/8} with hU
    have hUo : IsOpen U :=
      (hDopen.inter (isOpen_lt ((hvc.fst.sub continuous_const).abs) continuous_const)).inter
        (isOpen_lt ((hvc.snd.sub continuous_const).abs) continuous_const)
    have hξU : ξ ∈ U := by
      refine ⟨⟨hξ, ?_⟩, ?_⟩
      · show |(v ξ).1 - (v ξ).1| < 1/8
