    have hT : Tgc ≠ 0 := by unfold Tgc; intro h0; linarith
    have hN : (1 + bgc ^ 2) ≠ 0 := by positivity
    have c1 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).1 = Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) +
        Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) * bgc := by
      intro n Y
      simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
      ring
    have c2 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).2 = -(Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) * bgc) +
        Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) := by
      intro n Y
      simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
      ring
    have hcomp : ∀ (m n : ℤ) (Y : ℝ × ℝ), Jpow m (Jpow n Y) = Jpow (m + n) Y := by
      intro m n Y
      refine Prod.ext ?_ ?_
      · rw [c1 m, c1 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
        field_simp
        ring
      · rw [c2 m, c2 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
        field_simp
        ring
    have hid : ∀ Y : ℝ × ℝ, Jpow 0 Y = Y := by
      intro Y
      refine Prod.ext ?_ ?_
      · rw [c1, zpow_zero, zpow_zero]
        field_simp
        ring
      · rw [c2, zpow_zero, zpow_zero]
        field_simp
        ring
    have hsym : ∀ (n : ℤ) (Y W : ℝ × ℝ), (Jpow n Y).1 * W.1 + (Jpow n Y).2 * W.2 =
        Y.1 * (Jpow n W).1 + Y.2 * (Jpow n W).2 := by
      intro n Y W
      rw [c1 n Y, c2 n Y, c1 n W, c2 n W]
      field_simp
      ring
    have heig : ∀ (n : ℤ) (Y : ℝ × ℝ), bgc * (Jpow n Y).1 + (Jpow n Y).2 = Tgc ^ n * (bgc * Y.1 + Y.2) := by
      intro n Y
      rw [c1 n Y, c2 n Y]
      field_simp
      ring
    have hNinv : ∀ x : ℝ, x / (1 + bgc ^ 2) = x * (2 + Real.sqrt 2) / 4 := by
      intro x
      rw [div_eq_div_iff hN (by norm_num)]
      unfold bgc
      linear_combination (-x * Real.sqrt 2) * hs
    have hJ1 : ∀ Y : ℝ × ℝ, Jpow 1 Y = (3 * Y.1 + Y.2, Y.1 + 5 * Y.2) := by
      intro Y
      refine Prod.ext ?_ ?_
      · rw [c1, zpow_one, zpow_one, hNinv, hNinv]
        unfold Lgc Tgc bgc
        linear_combination ((Real.sqrt 2 ^ 2 + 4 * Real.sqrt 2 - 2) * Y.1 + 2 * (Real.sqrt 2 + 1) * Y.2) / 4 * hs
      · rw [c2, zpow_one, zpow_one, hNinv, hNinv]
        unfold Lgc Tgc bgc
        linear_combination (2 * (Real.sqrt 2 + 1) * Y.1 - (Real.sqrt 2 ^ 2 - 4 * Real.sqrt 2 - 2) * Y.2) / 4 * hs
    have hint : ∀ k : ℕ, ∀ i j : ℤ, ∃ i' j' : ℤ,
        Jpow (k : ℤ) ((i : ℝ), (j : ℝ)) = ((i' : ℝ), (j' : ℝ)) := by
      intro k
      induction k with
      | zero => intro i j; exact ⟨i, j, by rw [Nat.cast_zero, hid]⟩
      | succ k ih =>
        intro i j
        obtain ⟨i', j', h'⟩ := ih i j
        refine ⟨3 * i' + j', i' + 5 * j', ?_⟩
        have e : ((k + 1 : ℕ) : ℤ) = 1 + (k : ℤ) := by push_cast; ring
        rw [e, ← hcomp 1 k, h', hJ1]
        push_cast
        rfl
    refine ⟨fun n i j hn => ?_, hcomp, hid, hsym, heig⟩
    obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hn
    exact hint k i j
  have BP : (∀ q : ℝ, 0 < q → q ≤ 1/256 → 0 ≤ coarseIdx h q) ∧
      (∀ q : ℝ, 0 < q → q ≤ 1 → q < 2 * (2:ℝ) ^ (-(bandOf q : ℝ))) ∧
      (∀ q q' : ℝ, 0 < q → q ≤ 1/256 → 0 < q' → q' < 2 * (2:ℝ) ^ (-(bandOf q : ℝ)) →
        coarseIdx h q ≤ coarseIdx h q') ∧
      (∀ q : ℝ, 0 < q → q ≤ 1/256 →
        Tgc ^ (-(coarseIdx h q)) ≤ 2 ^ 5 * Tgc / Real.log 2 ^ 2 * q ^ (1 + h) * (1 + |Real.log q|) ^ 2) := by
    have hT1 : 1 < Tgc := by unfold Tgc; linarith [Real.sqrt_nonneg 2]
    have hT0 : 0 < Tgc := by linarith
    have hpowx : ∀ q : ℝ, 0 < q → (2:ℝ) ^ (-Real.logb 2 (1 / q)) = q := by
      intro q hq
      rw [Real.rpow_neg (by norm_num), Real.rpow_logb (by norm_num) (by norm_num) (by positivity),
        one_div, inv_inv]
    have hx8 : ∀ q : ℝ, 0 < q → q ≤ 1/256 → 8 ≤ Real.logb 2 (1 / q) := by
      intro q hq hq1
      rw [Real.le_logb_iff_rpow_le (by norm_num) (by positivity)]
      have e : (2:ℝ) ^ (8:ℝ) = 256 := by
        rw [show (8:ℝ) = ((8:ℕ):ℝ) by norm_num, Real.rpow_natCast]; norm_num
      rw [e, le_div_iff₀ hq]
      linarith
    have hN8 : ∀ q : ℝ, 0 < q → q ≤ 1/256 → 8 ≤ bandOf q := by
      intro q hq hq1
      have h1 := hx8 q hq hq1
      have h2 : Real.logb 2 (1 / q) ≤ (bandOf q : ℝ) := Nat.le_ceil _
      exact_mod_cast (show (8:ℝ) ≤ bandOf q by linarith)
    obtain ⟨R, hRdef⟩ : ∃ R : ℕ → ℝ, R = fun l : ℕ => (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) :=
      ⟨_, rfl⟩
    have hband : ∀ l : ℕ, bandIdx h l = ⌊Real.logb Tgc (R l)⌋ := by
      intro l; rw [hRdef]; rfl
    have hpowl : ∀ l : ℕ, 4 ≤ l → (l:ℝ) ^ 2 ≤ (2:ℝ) ^ l := by
      intro l hl
      induction l, hl using Nat.le_induction with
      | base => norm_num
      | succ n hn ih =>
        have hn' : (4:ℝ) ≤ n := by exact_mod_cast hn
        push_cast
        rw [pow_succ (2:ℝ) n]
        nlinarith [ih, mul_nonneg (sub_nonneg.2 hn') (by linarith : (0:ℝ) ≤ (n:ℝ) + 2)]
    have hR1 : ∀ l : ℕ, 4 ≤ l → 1 ≤ R l := by
      intro l hl
      have hl' : (4:ℝ) ≤ l := by exact_mod_cast hl
      have hlpos : 0 < (l:ℝ) ^ 2 := pow_pos (by linarith) 2
      rw [hRdef]
      show 1 ≤ (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2)
      rw [one_le_div hlpos]
      calc (l:ℝ) ^ 2 ≤ (2:ℝ) ^ l := hpowl l hl
        _ = (2:ℝ) ^ (l:ℝ) := (Real.rpow_natCast 2 l).symm
        _ ≤ (2:ℝ) ^ ((1 + h) * (l:ℝ)) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) (by nlinarith)
    have hRstep : ∀ l : ℕ, 4 ≤ l → R l ≤ R (l + 1) := by
      intro l hl
      have hl' : (4:ℝ) ≤ l := by exact_mod_cast hl
      have hc : 0 < (2:ℝ) ^ ((1 + h) * (l:ℝ)) := Real.rpow_pos_of_pos (by norm_num) _
      have h2 : (2:ℝ) ≤ (2:ℝ) ^ (1 + h) := by
        calc (2:ℝ) = 2 ^ (1:ℝ) := (Real.rpow_one 2).symm
          _ ≤ 2 ^ (1 + h) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
      have e : (2:ℝ) ^ ((1 + h) * ((l + 1 : ℕ) : ℝ)) =
          (2:ℝ) ^ ((1 + h) * (l:ℝ)) * (2:ℝ) ^ (1 + h) := by
        rw [← Real.rpow_add (by norm_num)]; congr 1; push_cast; ring
      rw [hRdef]
      show (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) ≤
        (2:ℝ) ^ ((1 + h) * ((l + 1 : ℕ) : ℝ)) / (((l + 1 : ℕ) : ℝ) ^ 2)
      have hlp : 0 < (l:ℝ) ^ 2 := pow_pos (by linarith) 2
      have hlp1 : 0 < ((l + 1 : ℕ) : ℝ) ^ 2 := pow_pos (by push_cast; linarith) 2
      rw [e, div_le_div_iff₀ hlp hlp1]
      push_cast
      have key : ((l:ℝ) + 1) ^ 2 ≤ 2 ^ (1 + h) * (l:ℝ) ^ 2 := by
        nlinarith [mul_le_mul_of_nonneg_right h2 (sq_nonneg (l:ℝ)),
          mul_nonneg (sub_nonneg.2 hl') (by linarith : (0:ℝ) ≤ (l:ℝ) + 2)]
      have := mul_le_mul_of_nonneg_left key hc.le
      linarith
    have hRmono : ∀ l l' : ℕ, 4 ≤ l → l ≤ l' → R l ≤ R l' := by
      intro l l' hl hll'
      induction l', hll' using Nat.le_induction with
      | base => exact le_rfl
      | succ n hn ih => exact le_trans ih (hRstep n (le_trans hl hn))
    have hbandmono : ∀ l l' : ℕ, 4 ≤ l → l ≤ l' → bandIdx h l ≤ bandIdx h l' := by
      intro l l' hl hll'
      rw [hband, hband]
      apply Int.floor_mono
      exact Real.logb_le_logb_of_le hT1 (by linarith [hR1 l hl]) (hRmono l l' hl hll')
    have hbandnn : ∀ l : ℕ, 4 ≤ l → 0 ≤ bandIdx h l := by
      intro l hl
      rw [hband]
      exact Int.floor_nonneg.mpr (Real.logb_nonneg hT1 (hR1 l hl))
    refine ⟨fun q hq hq1 => ?_, fun q hq hq1 => ?_, fun q q' hq hq1 hq' hq'2 => ?_, fun q hq hq1 => ?_⟩
    ·
      have := hN8 q hq hq1
      exact hbandnn _ (by omega)
    ·
      have hx0 : 0 ≤ Real.logb 2 (1 / q) :=
        Real.logb_nonneg (by norm_num) (by rw [le_div_iff₀ hq]; linarith)
      have hc : (bandOf q : ℝ) < Real.logb 2 (1 / q) + 1 := Nat.ceil_lt_add_one hx0
      have h1 : (2:ℝ) ^ (-Real.logb 2 (1 / q) - 1) < (2:ℝ) ^ (-(bandOf q : ℝ)) :=
        Real.rpow_lt_rpow_of_exponent_lt (by norm_num) (by linarith)
      have h2 : (2:ℝ) ^ (-Real.logb 2 (1 / q) - 1) = q / 2 := by
        rw [Real.rpow_sub (by norm_num), Real.rpow_one, hpowx q hq]
      linarith
    ·
      have hN := hN8 q hq hq1
      have hx' : (bandOf q : ℝ) - 1 < Real.logb 2 (1 / q') := by
        rw [Real.lt_logb_iff_rpow_lt (by norm_num) (by positivity)]
        have e : (2:ℝ) ^ ((bandOf q : ℝ) - 1) = (2 * (2:ℝ) ^ (-(bandOf q : ℝ)))⁻¹ := by
          rw [Real.rpow_sub (by norm_num), Real.rpow_one, Real.rpow_neg (by norm_num)]
          field_simp
        rw [e, one_div]
        exact (inv_lt_inv₀ (by positivity) hq').mpr hq'2
      have hb : bandOf q - 1 < bandOf q' := by
        show bandOf q - 1 < ⌈Real.logb 2 (1 / q')⌉₊
        apply Nat.lt_ceil.mpr
        rw [Nat.cast_sub (by omega : 1 ≤ bandOf q), Nat.cast_one]
        exact hx'
      exact hbandmono _ _ (by omega) (by omega)
    ·
      obtain ⟨x, hx⟩ : ∃ x : ℝ, Real.logb 2 (1 / q) = x := ⟨_, rfl⟩
      have hx8' : 8 ≤ x := hx ▸ hx8 q hq hq1
      have hN := hN8 q hq hq1
      have hceil_le : x ≤ (bandOf q : ℝ) := hx ▸ Nat.le_ceil _
      have hceil_lt : (bandOf q : ℝ) < x + 1 := hx ▸ Nat.ceil_lt_add_one (by linarith)
      have hpowx' : (2:ℝ) ^ (-x) = q := hx ▸ hpowx q hq
      obtain ⟨m, hm⟩ : ∃ m : ℕ, m = bandOf q - 4 := ⟨_, rfl⟩
      have hm4 : 4 ≤ m := by omega
      have hmcast : (m:ℝ) = (bandOf q : ℝ) - 4 := by
        rw [hm, Nat.cast_sub (by omega)]; norm_num
      have hm4' : (4:ℝ) ≤ m := by exact_mod_cast hm4
      have hR0 : 0 < R m := lt_of_lt_of_le one_pos (hR1 m hm4)
      obtain ⟨y, hy⟩ : ∃ y : ℝ, y = Real.logb Tgc (R m) := ⟨_, rfl⟩
      have hci : coarseIdx h q = ⌊y⌋ := by
        rw [hy, ← hband, hm]; rfl
      rw [hci]
      have hW1 : Tgc ^ (-⌊y⌋) ≤ Tgc * (m:ℝ) ^ 2 * (2:ℝ) ^ (-((1 + h) * (m:ℝ))) := by
        rw [← Real.rpow_intCast]
        push_cast
        have hfl := Int.sub_one_lt_floor y
        calc Tgc ^ (-(⌊y⌋ : ℝ)) ≤ Tgc ^ (1 - y) :=
              Real.rpow_le_rpow_of_exponent_le hT1.le (by linarith)
          _ = Tgc / R m := by
              rw [Real.rpow_sub hT0, Real.rpow_one, hy, Real.rpow_logb hT0 hT1.ne' hR0]
          _ = _ := by
              rw [hRdef]
              show Tgc / ((2:ℝ) ^ ((1 + h) * (m:ℝ)) / ((m : ℝ) ^ 2)) = _
              rw [Real.rpow_neg (by norm_num), div_div_eq_mul_div, div_eq_mul_inv]
      have hW2 : (2:ℝ) ^ (-((1 + h) * (m:ℝ))) ≤ 2 ^ 5 * q ^ (1 + h) := by
        have e : (2:ℝ) ^ (5 + (-x) * (1 + h)) = (2:ℝ) ^ 5 * q ^ (1 + h) := by
          rw [Real.rpow_add two_pos, Real.rpow_mul two_pos.le, hpowx',
            show (5:ℝ) = ((5:ℕ):ℝ) by norm_num, Real.rpow_natCast]
        rw [← e]
        apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
        have : (1 + h) * (x - m) ≤ (1 + h) * 4 :=
          mul_le_mul_of_nonneg_left (by linarith) (by linarith)
        nlinarith
      have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
      have hlq : Real.log q ≤ 0 := Real.log_nonpos hq.le (by linarith)
      have hxeq : x = |Real.log q| / Real.log 2 := by
        rw [← hx, abs_of_nonpos hlq, Real.logb, one_div, Real.log_inv]
      have hmx : (m:ℝ) ≤ (1 + |Real.log q|) / Real.log 2 := by
        have hmx0 : (m:ℝ) ≤ x := by linarith
        calc (m:ℝ) ≤ x := hmx0
          _ = |Real.log q| / Real.log 2 := hxeq
          _ ≤ (1 + |Real.log q|) / Real.log 2 := by
              rw [div_le_div_iff₀ hlog2 hlog2]; nlinarith
      have hW3 : (m:ℝ) ^ 2 ≤ (1 + |Real.log q|) ^ 2 / Real.log 2 ^ 2 := by
        rw [← div_pow]; exact pow_le_pow_left₀ (by positivity) hmx 2
      have hA : 0 ≤ (2:ℝ) ^ (-((1 + h) * (m:ℝ))) := (Real.rpow_pos_of_pos two_pos _).le
      calc Tgc ^ (-⌊y⌋) ≤ Tgc * (m:ℝ) ^ 2 * (2:ℝ) ^ (-((1 + h) * (m:ℝ))) := hW1
        _ ≤ Tgc * ((1 + |Real.log q|) ^ 2 / Real.log 2 ^ 2) * (2 ^ 5 * q ^ (1 + h)) :=
            mul_le_mul (mul_le_mul_of_nonneg_left hW3 hT0.le) hW2 hA
              (mul_nonneg hT0.le (by positivity))
        _ = _ := by ring
  obtain ⟨A2, A3, A4, A5, A6⟩ := JP
  obtain ⟨B1, B7, B8, B9⟩ := BP
  exact ⟨B1, A2, A3, A4, A5, A6, B7, B8, B9⟩

theorem tn_mode_smooth_v5 : ∀ (F : Cyl → ℝ) (κ : ℤ × ℤ), ContDiff ℝ ∞ F →
    (∀ (η : Cyl) (n m : ℤ), F (shY η ((n : ℝ), (m : ℝ))) = F η) →
    ContDiff ℝ ∞ (fun x : Cyl => fourY F x κ *
        Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (x.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (x.2.2.2.2 : ℂ)))) ∧
    ∀ (k : ℕ) (ξ : Cyl) (w : Fin k → Cyl),
      iteratedFDeriv ℝ k (fun x : Cyl => fourY F x κ *
          Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (x.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (x.2.2.2.2 : ℂ)))) ξ w =
        fourY (fun η => iteratedFDeriv ℝ k F η w) ξ κ *
          Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (ξ.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (ξ.2.2.2.2 : ℂ))) :=
by
  intro F κ hF hper

  have PIC : ∀ {P E' F : Type} [NormedAddCommGroup P] [NormedSpace ℝ P]
      [FiniteDimensional ℝ P] [NormedAddCommGroup E'] [NormedSpace ℝ E'] [FiniteDimensional ℝ E']
      [MeasurableSpace E'] [BorelSpace E'] [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (μ : MeasureTheory.Measure E') [MeasureTheory.IsFiniteMeasureOnCompacts μ]
      (U : Set P) (V K : Set E') (G : P → E' → F) (hU : IsOpen U) (hV : IsOpen V) (hK : IsCompact K)
      (hKV : K ⊆ V) (hG : ContDiffOn ℝ ∞ (fun z : P × E' => G z.1 z.2) (U ×ˢ V)),
      ContDiffOn ℝ ∞ (fun x => ∫ y in K, G x y ∂μ) U ∧
      (∀ k : ℕ, ∀ x ∈ U, iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) x =
        ∫ y in K, iteratedFDeriv ℝ k (fun x' => G x' y) x ∂μ) := by
    intro P E' F _ _ _ _ _ _ _ _ _ _ _ μ _ U V K G hU hV hK hKV hG
    have hO : IsOpen (U ×ˢ V) := hU.prod hV
    have hKm : MeasurableSet K := hK.isClosed.measurableSet
    have slice : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F'] (H : P → E' → F'),
        ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) →
        ∀ x ∈ U, ContinuousOn (fun y => H x y) K := by
      intro F' _ _ H hH x hx
      have hc : Continuous (fun y : E' => ((x, y) : P × E')) := by fun_prop
      have h := ContinuousOn.comp (g := fun z : P × E' => H z.1 z.2) (f := fun y : E' => ((x, y) : P × E'))
        hH.continuousOn hc.continuousOn (fun y hy => ⟨hx, hKV hy⟩)
      exact h
    have param_fderiv : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F'] (H : P → E' → F'),
        ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) →
        ContDiffOn ℝ ∞ (fun z : P × E' => fderiv ℝ (fun x' => H x' z.2) z.1) (U ×ˢ V) := by
      intro F' _ _ H hH p hp
      have hHa : ContDiffAt ℝ ∞ (fun z : P × E' => H z.1 z.2) p := hH.contDiffAt (hO.mem_nhds hp)
      apply ContDiffAt.contDiffWithinAt
      have h1 : ContDiffAt ℝ ∞ (Function.uncurry (fun (q : P × E') (x' : P) => H x' q.2)) (p, p.1) := by
        have e : Function.uncurry (fun (q : P × E') (x' : P) => H x' q.2) =
            (fun z : P × E' => H z.1 z.2) ∘ (fun w : (P × E') × P => (w.2, w.1.2)) := rfl
        rw [e]
        apply ContDiffAt.comp (g := fun z : P × E' => H z.1 z.2) (p, p.1)
        · simpa using hHa
        · fun_prop
      exact ContDiffAt.fderiv (f := fun (q : P × E') (x' : P) => H x' q.2)
        (g := Prod.fst) h1 contDiffAt_fst (le_of_eq ENat.coe_top_add_one)
    have param_hasFDeriv : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F']
        (H : P → E' → F'), ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) → ∀ x ∈ U,
        HasFDerivAt (fun x' => ∫ y in K, H x' y ∂μ) (∫ y in K, fderiv ℝ (fun x' => H x' y) x ∂μ) x := by
      intro F' _ _ H hH x hx
      have hHs := param_fderiv H hH
      obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hU x hx
      have hsU : Metric.closedBall x (δ / 2) ⊆ U :=
        (Metric.closedBall_subset_ball (by linarith)).trans hball
      have hsn : Metric.closedBall x (δ / 2) ∈ nhds x := Metric.closedBall_mem_nhds x (by linarith)
      have hC : IsCompact (Metric.closedBall x (δ / 2) ×ˢ K) := (isCompact_closedBall _ _).prod hK
      have hCsub : Metric.closedBall x (δ / 2) ×ˢ K ⊆ U ×ˢ V := fun z hz => ⟨hsU hz.1, hKV hz.2⟩
      obtain ⟨Bd, hB⟩ := hC.exists_bound_of_continuousOn (hHs.continuousOn.mono hCsub)
      refine hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := μ.restrict K)
        (F := fun x' y => H x' y) (F' := fun x' y => fderiv ℝ (fun x'' => H x'' y) x')
        (bound := fun _ => Bd) hsn ?_ ?_ ?_ ?_ ?_ ?_
      · filter_upwards [hU.mem_nhds hx] with x' hx'
        exact (slice H hH x' hx').aestronglyMeasurable_of_isCompact hK hKm
      · exact (slice H hH x hx).integrableOn_compact hK
      · exact (slice (fun x' y => fderiv ℝ (fun x'' => H x'' y) x') hHs x hx).aestronglyMeasurable_of_isCompact
          hK hKm
      · exact ae_restrict_of_forall_mem hKm (fun y hy x' hx' => hB (x', y) ⟨hx', hy⟩)
      · exact continuousOn_const.integrableOn_compact hK
      · refine ae_restrict_of_forall_mem hKm (fun y hy x' hx' => ?_)
        have hHa : ContDiffAt ℝ ∞ (fun z : P × E' => H z.1 z.2) (x', y) :=
          hH.contDiffAt (hO.mem_nhds ⟨hsU hx', hKV hy⟩)
        have hc : ContDiffAt ℝ ∞ (fun x'' : P => ((x'', y) : P × E')) x' := by fun_prop
        have h2 := ContDiffAt.comp (g := fun z : P × E' => H z.1 z.2) x' hHa hc
        have : ContDiffAt ℝ ∞ (fun x'' => H x'' y) x' := h2
        exact (this.differentiableAt (by simp)).hasFDerivAt
    have hD0 : ∀ x y, iteratedFDeriv ℝ 0 (fun x' => G x' y) x =
        (continuousMultilinearCurryFin0 ℝ P F).symm (G x y) := by
      intro x y; rw [iteratedFDeriv_zero_eq_comp]; rfl
    have hDs : ∀ (k : ℕ) x y, iteratedFDeriv ℝ (k + 1) (fun x' => G x' y) x =
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm
          (fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') x) := by
      intro k x y; rw [iteratedFDeriv_succ_eq_comp_left]; rfl
    have D_smooth : ∀ k : ℕ, ContDiffOn ℝ ∞
        (fun z : P × E' => iteratedFDeriv ℝ k (fun x' => G x' z.2) z.1) (U ×ˢ V) := by
      intro k
      induction k with
      | zero =>
        have e : (fun z : P × E' => iteratedFDeriv ℝ 0 (fun x' => G x' z.2) z.1) =
            (continuousMultilinearCurryFin0 ℝ P F).symm ∘ (fun z : P × E' => G z.1 z.2) := by
          funext z; exact hD0 z.1 z.2
        rw [e]
        exact (continuousMultilinearCurryFin0 ℝ P F).symm.contDiff.comp_contDiffOn hG
      | succ k ih =>
        have e : (fun z : P × E' => iteratedFDeriv ℝ (k + 1) (fun x' => G x' z.2) z.1) =
            (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm ∘
              (fun z : P × E' => fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' z.2) x') z.1) := by
          funext z; exact hDs k z.1 z.2
        rw [e]
        have h2 := param_fderiv (fun x' y => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') ih
        exact (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm.contDiff.comp_contDiffOn h2
    have formula : ∀ k : ℕ, ∀ x ∈ U, iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) x =
        ∫ y in K, iteratedFDeriv ℝ k (fun x' => G x' y) x ∂μ := by
      intro k
      induction k with
      | zero =>
        intro x _
        rw [iteratedFDeriv_zero_eq_comp (f := fun x' => ∫ y in K, G x' y ∂μ)]
        simp only [hD0]
        exact (ContinuousLinearEquiv.integral_comp_comm
          (continuousMultilinearCurryFin0 ℝ P F).symm.toContinuousLinearEquiv (fun y => G x y)).symm
      | succ k ih =>
        intro x hx
        have hα : iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) =ᶠ[nhds x]
            (fun x' => ∫ y in K, iteratedFDeriv ℝ k (fun x'' => G x'' y) x' ∂μ) :=
          Filter.eventuallyEq_of_mem (hU.mem_nhds hx) ih
        have hβ := (param_hasFDeriv (fun x' y => iteratedFDeriv ℝ k (fun x'' => G x'' y) x')
          (D_smooth k) x hx).fderiv
        rw [iteratedFDeriv_succ_eq_comp_left (f := fun x' => ∫ y in K, G x' y ∂μ), Function.comp_apply,
          hα.fderiv_eq, hβ]
        simp only [hDs]
        have hL := ContinuousLinearEquiv.integral_comp_comm (μ := μ.restrict K) (𝕜 := ℝ)
          (E := P →L[ℝ] ContinuousMultilinearMap ℝ (fun _ : Fin k => P) F)
          (F := ContinuousMultilinearMap ℝ (fun _ : Fin (k + 1) => P) F)
          (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm.toContinuousLinearEquiv
          (fun y => fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') x)
        exact hL.symm
    have hsmooth : ContDiffOn ℝ ∞ (fun x => ∫ y in K, G x y ∂μ) U := by
      have key : ∀ m : ℕ, EqOn (iteratedFDerivWithin ℝ m (fun x => ∫ y in K, G x y ∂μ) U)
          (fun x => ∫ y in K, iteratedFDeriv ℝ m (fun x' => G x' y) x ∂μ) U := by
        intro m x hx
        rw [iteratedFDerivWithin_of_isOpen m hU hx]
        exact formula m x hx
      have hdiff : ∀ m : ℕ, DifferentiableOn ℝ
          (fun x => ∫ y in K, iteratedFDeriv ℝ m (fun x' => G x' y) x ∂μ) U :=
        fun m x hx => (param_hasFDeriv (fun x' y => iteratedFDeriv ℝ m (fun x'' => G x'' y) x')
          (D_smooth m) x hx).differentiableAt.differentiableWithinAt
      exact contDiffOn_of_continuousOn_differentiableOn (n := ⊤)
        (fun m _ => ((hdiff m).continuousOn).congr (key m))
        (fun m _ => (hdiff m).congr (key m))
    exact ⟨hsmooth, formula⟩

  have per1 : ∀ (ψ : ℝ → ℂ), Function.Periodic ψ 1 → ∀ b : ℝ,
      ∫ y in Icc (0:ℝ) 1, ψ (y + b) = ∫ y in Icc (0:ℝ) 1, ψ y := by
    intro ψ hψ b
    rw [integral_Icc_eq_integral_Ioc, integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le zero_le_one, ← intervalIntegral.integral_of_le zero_le_one,
      intervalIntegral.integral_comp_add_right, zero_add, add_comm 1 b,
      hψ.intervalIntegral_add_eq b 0, zero_add]

  have cell : ∀ (Φ : ℝ × ℝ → ℂ), Continuous Φ →
      (∀ (n m : ℤ) (Y : ℝ × ℝ), Φ (Y + ((n : ℝ), (m : ℝ))) = Φ Y) →
      ∀ b : ℝ × ℝ, ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Φ (Z + b) =
        ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Φ Z := by
    intro Φ hΦ hp b
    have fub : ∀ Ψ : ℝ × ℝ → ℂ, Continuous Ψ →
        ∫ Z in (Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1), Ψ Z =
          ∫ x in Icc (0:ℝ) 1, ∫ y in Icc (0:ℝ) 1, Ψ (x, y) := by
      intro Ψ hΨ
      rw [Measure.volume_eq_prod]
      exact setIntegral_prod Ψ
        ((hΨ.continuousOn).integrableOn_compact (isCompact_Icc.prod isCompact_Icc))
    rw [fub (fun Z => Φ (Z + b)) (hΦ.comp (continuous_id.add continuous_const)), fub _ hΦ]
    have h1 : ∀ x : ℝ, ∫ y in Icc (0:ℝ) 1, Φ ((x, y) + b) =
        ∫ y in Icc (0:ℝ) 1, Φ (x + b.1, y) := by
      intro x
      have hper1 : Function.Periodic (fun y => Φ (x + b.1, y)) 1 := by
        intro y
        have := hp 0 1 (x + b.1, y)
        simpa using this
      exact per1 _ hper1 b.2
    have hχ : Function.Periodic (fun u => ∫ y in Icc (0:ℝ) 1, Φ (u, y)) 1 := by
      intro u
      show ∫ y in Icc (0:ℝ) 1, Φ (u + 1, y) = ∫ y in Icc (0:ℝ) 1, Φ (u, y)
      congr 1
      funext y
      have := hp 1 0 (u, y)
      simpa using this
    rw [show (fun x => ∫ y in Icc (0:ℝ) 1, Φ ((x, y) + b)) =
        fun x => (fun u => ∫ y in Icc (0:ℝ) 1, Φ (u, y)) (x + b.1) from funext h1]
    exact per1 _ hχ b.1

  have rep : ∀ (H : Cyl → ℝ), Continuous H →
      (∀ (η : Cyl) (n m : ℤ), H (shY η ((n : ℝ), (m : ℝ))) = H η) → ∀ x : Cyl,
      fourY H x κ * Complex.exp ((2 * Real.pi * Complex.I) *
          ((κ.1 : ℂ) * (x.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (x.2.2.2.2 : ℂ))) =
        ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (H (x + (((0:ℝ), (0:ℝ), (0:ℝ), Z) : Cyl)) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (Z.1 : ℂ) + (κ.2 : ℂ) * (Z.2 : ℂ))) := by
    intro H hH hHp x
    obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ × ℝ → ℂ, Φ = fun Z => (H (x.1, x.2.1, x.2.2.1, Z) : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (Z.1 : ℂ) + (κ.2 : ℂ) * (Z.2 : ℂ))) *
        Complex.exp ((2 * Real.pi * Complex.I) *
          ((κ.1 : ℂ) * (x.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (x.2.2.2.2 : ℂ))) := ⟨_, rfl⟩
    have hL : fourY H x κ * Complex.exp ((2 * Real.pi * Complex.I) *
          ((κ.1 : ℂ) * (x.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (x.2.2.2.2 : ℂ))) =
        ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Φ Z := by
      rw [hΦ]
      unfold fourY
      exact (integral_mul_const _ _).symm
    have hHs : Continuous (fun Z : ℝ × ℝ => H (x.1, x.2.1, x.2.2.1, Z)) := hH.comp (by fun_prop)
    have hΦc : Continuous Φ := by
      rw [hΦ]
      exact ((Complex.continuous_ofReal.comp hHs).mul (Complex.continuous_exp.comp (by fun_prop))).mul
        continuous_const
    have hΦp : ∀ (n m : ℤ) (Y : ℝ × ℝ), Φ (Y + ((n : ℝ), (m : ℝ))) = Φ Y := by
      intro n m Y
      rw [hΦ]
      dsimp only
      have hH' : H (x.1, x.2.1, x.2.2.1, Y + ((n : ℝ), (m : ℝ))) = H (x.1, x.2.1, x.2.2.1, Y) :=
        hHp (x.1, x.2.1, x.2.2.1, Y) n m
      rw [hH']
      congr 2
      rw [Complex.exp_eq_exp_iff_exists_int]
      refine ⟨-(κ.1 * n + κ.2 * m), ?_⟩
      simp only [Prod.fst_add, Prod.snd_add]
      push_cast
      ring
    have htr := cell Φ hΦc hΦp x.2.2.2
    rw [hL, ← htr]
    congr 1
    funext Z
    rw [hΦ]
    dsimp only
    have hpt : ((x.1, x.2.1, x.2.2.1, Z + x.2.2.2) : Cyl) = x + (((0:ℝ), (0:ℝ), (0:ℝ), Z) : Cyl) := by
      ext <;> simp [add_comm]
    rw [hpt, mul_assoc _ (Complex.exp _) (Complex.exp _), ← Complex.exp_add]
    congr 2
    simp only [Prod.fst_add, Prod.snd_add]
    push_cast
    ring

  obtain ⟨G, hG⟩ : ∃ G : Cyl → ℝ × ℝ → ℂ, G = fun x Z =>
      (F (x + (((0:ℝ), (0:ℝ), (0:ℝ), Z) : Cyl)) : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (Z.1 : ℂ) + (κ.2 : ℂ) * (Z.2 : ℂ))) :=
    ⟨_, rfl⟩
  have hrep : (fun x : Cyl => fourY F x κ *
      Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (x.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (x.2.2.2.2 : ℂ)))) =
      fun x => ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), G x Z := by
    funext x
    rw [hG]
    exact rep F hF.continuous hper x
  have hGs : ContDiffOn ℝ ∞ (fun z : Cyl × (ℝ × ℝ) => G z.1 z.2) (univ ×ˢ univ) := by
    rw [hG]
    show ContDiffOn ℝ ∞ (fun z : Cyl × (ℝ × ℝ) =>
      (F (z.1 + (((0:ℝ), (0:ℝ), (0:ℝ), z.2) : Cyl)) : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (z.2.1 : ℂ) + (κ.2 : ℂ) * (z.2.2 : ℂ))))
      (univ ×ˢ univ)
    apply ContDiff.contDiffOn
    have hin : ContDiff ℝ ∞ (fun z : Cyl × (ℝ × ℝ) => z.1 + (((0:ℝ), (0:ℝ), (0:ℝ), z.2) : Cyl)) := by
      fun_prop
    have hA : ContDiff ℝ ∞ (fun z : Cyl × (ℝ × ℝ) => (F (z.1 + (((0:ℝ), (0:ℝ), (0:ℝ), z.2) : Cyl)) : ℂ)) :=
      Complex.ofRealCLM.contDiff.comp (hF.comp hin)
    have h1 : ContDiff ℝ ∞ (fun z : Cyl × (ℝ × ℝ) => ((z.2.1 : ℝ) : ℂ)) :=
      Complex.ofRealCLM.contDiff.comp (contDiff_fst.comp contDiff_snd)
    have h2 : ContDiff ℝ ∞ (fun z : Cyl × (ℝ × ℝ) => ((z.2.2 : ℝ) : ℂ)) :=
      Complex.ofRealCLM.contDiff.comp (contDiff_snd.comp contDiff_snd)
    exact hA.mul (Complex.contDiff_exp.comp
      (contDiff_const.mul ((contDiff_const.mul h1).add (contDiff_const.mul h2))))
  obtain ⟨hsm, hformula⟩ := PIC (μ := volume) univ univ (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) G
    isOpen_univ isOpen_univ (isCompact_Icc.prod isCompact_Icc) (subset_univ _) hGs
  refine ⟨?_, ?_⟩
  · rw [hrep]
    exact contDiffOn_univ.mp hsm
  · intro k ξ w

    have hHwc : Continuous (fun η : Cyl => iteratedFDeriv ℝ k F η w) :=
      (continuous_eval_const w).comp (hF.continuous_iteratedFDeriv (m := k) (by exact_mod_cast le_top))
    have hHwp : ∀ (η : Cyl) (n m : ℤ),
        iteratedFDeriv ℝ k F (shY η ((n : ℝ), (m : ℝ))) w = iteratedFDeriv ℝ k F η w := by
      intro η n m
      have hs : shY η ((n : ℝ), (m : ℝ)) = η + (((0:ℝ), (0:ℝ), (0:ℝ), ((n : ℝ), (m : ℝ))) : Cyl) := by
        simp only [shY]
        ext <;> simp
      have hfun : (fun z : Cyl => F (z + (((0:ℝ), (0:ℝ), (0:ℝ), ((n : ℝ), (m : ℝ))) : Cyl))) = F := by
        funext z
        have hz : z + (((0:ℝ), (0:ℝ), (0:ℝ), ((n : ℝ), (m : ℝ))) : Cyl) = shY z ((n : ℝ), (m : ℝ)) := by
          simp only [shY]
          ext <;> simp
        rw [hz, hper]
      have h3 := iteratedFDeriv_comp_add_right (𝕜 := ℝ) (f := F) k
        (((0:ℝ), (0:ℝ), (0:ℝ), ((n : ℝ), (m : ℝ))) : Cyl) η
      rw [hfun] at h3
      rw [hs, ← h3]

    have hpt : ∀ Z : ℝ × ℝ, iteratedFDeriv ℝ k (fun x' => G x' Z) ξ =
        Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (Z.1 : ℂ) + (κ.2 : ℂ) * (Z.2 : ℂ))) •
          Complex.ofRealCLM.compContinuousMultilinearMap
            (iteratedFDeriv ℝ k F (ξ + (((0:ℝ), (0:ℝ), (0:ℝ), Z) : Cyl))) := by
      intro Z
      have hf0 : ContDiff ℝ ∞ (fun x' : Cyl => F (x' + (((0:ℝ), (0:ℝ), (0:ℝ), Z) : Cyl))) :=
        hF.comp (contDiff_id.add contDiff_const)
      have e : (fun x' => G x' Z) =
          Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (Z.1 : ℂ) + (κ.2 : ℂ) * (Z.2 : ℂ))) •
            (⇑Complex.ofRealCLM ∘ (fun x' : Cyl => F (x' + (((0:ℝ), (0:ℝ), (0:ℝ), Z) : Cyl)))) := by
        funext x'
        rw [hG]
        simp only [Pi.smul_apply, Function.comp_apply, Complex.ofRealCLM_apply, smul_eq_mul]
        ring
      rw [e, iteratedFDeriv_const_smul_apply
          ((Complex.ofRealCLM.contDiff.comp hf0).contDiffAt.of_le (by exact_mod_cast le_top)),
        ContinuousLinearMap.iteratedFDeriv_comp_left Complex.ofRealCLM hf0.contDiffAt (i := k)
          (by exact_mod_cast le_top),
        iteratedFDeriv_comp_add_right]
    have hΨc : Continuous (fun Z : ℝ × ℝ =>
        Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (Z.1 : ℂ) + (κ.2 : ℂ) * (Z.2 : ℂ))) •
          Complex.ofRealCLM.compContinuousMultilinearMap
            (iteratedFDeriv ℝ k F (ξ + (((0:ℝ), (0:ℝ), (0:ℝ), Z) : Cyl)))) := by
      have he : Continuous (fun Z : ℝ × ℝ =>
          Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (Z.1 : ℂ) + (κ.2 : ℂ) * (Z.2 : ℂ)))) :=
        Complex.continuous_exp.comp (by fun_prop)
      have hc : Continuous (fun Z : ℝ × ℝ => iteratedFDeriv ℝ k F (ξ + (((0:ℝ), (0:ℝ), (0:ℝ), Z) : Cyl))) :=
        (hF.continuous_iteratedFDeriv (m := k) (by exact_mod_cast le_top)).comp (by fun_prop)
      have hm : Continuous (fun Z : ℝ × ℝ => Complex.ofRealCLM.compContinuousMultilinearMap
          (iteratedFDeriv ℝ k F (ξ + (((0:ℝ), (0:ℝ), (0:ℝ), Z) : Cyl)))) := by
        have := (ContinuousLinearMap.compContinuousMultilinearMapL ℝ (fun _ : Fin k => Cyl) ℝ ℂ
          Complex.ofRealCLM).continuous.comp hc
        simpa only [Function.comp_def, ContinuousLinearMap.compContinuousMultilinearMapL_apply] using this
      exact he.smul hm
    have hInt := hΨc.continuousOn.integrableOn_compact (μ := volume)
      ((isCompact_Icc (a := (0:ℝ)) (b := 1)).prod (isCompact_Icc (a := (0:ℝ)) (b := 1)))
    rw [hrep, hformula k ξ (mem_univ ξ)]
    simp_rw [hpt]
    rw [ContinuousMultilinearMap.integral_apply hInt w, rep (fun η => iteratedFDeriv ℝ k F η w) hHwc hHwp ξ]
    congr 1
    funext Z
    simp only [ContinuousMultilinearMap.smul_apply, ContinuousLinearMap.compContinuousMultilinearMap_coe,
      Function.comp_apply, Complex.ofRealCLM_apply, smul_eq_mul]
    ring

theorem tn_mode_decay_v5 : ∀ (F : Cyl → ℝ), ContDiff ℝ ∞ F →
    (∀ (η : Cyl) (n m : ℤ), F (shY η ((n : ℝ), (m : ℝ))) = F η) →
    (∀ n : ℕ, ∃ C : ℝ, ∀ η : Cyl, ‖iteratedFDeriv ℝ n F η‖ ≤ C) →
    ∀ n : ℕ, ∃ C : ℝ, ∀ (κ : ℤ × ℤ) (x : Cyl),
      ‖iteratedFDeriv ℝ n (fun y : Cyl => fourY F y κ *
          Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (y.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (y.2.2.2.2 : ℂ)))) x‖ ≤
        C / (1 + |(κ.1 : ℝ)| + |(κ.2 : ℝ)|) ^ 5 :=
by
  intro F hF hper hbd n

  have hexpn : ∀ (k1 k2 : ℤ) (s1 s2 : ℝ),
      ‖Complex.exp ((2 * Real.pi * Complex.I) * ((k1 : ℂ) * (s1 : ℂ) + (k2 : ℂ) * (s2 : ℂ)))‖ = 1 := by
    intro k1 k2 s1 s2
    have e : (2 * Real.pi * Complex.I) * ((k1 : ℂ) * (s1 : ℂ) + (k2 : ℂ) * (s2 : ℂ)) =
        ((2 * Real.pi * ((k1 : ℝ) * s1 + (k2 : ℝ) * s2) : ℝ) : ℂ) * Complex.I := by
      push_cast; ring
    rw [e, Complex.norm_exp_ofReal_mul_I]
  have hexpn' : ∀ (k1 k2 : ℤ) (s1 s2 : ℝ),
      ‖Complex.exp (-(2 * Real.pi * Complex.I) * ((k1 : ℂ) * (s1 : ℂ) + (k2 : ℂ) * (s2 : ℂ)))‖ = 1 := by
    intro k1 k2 s1 s2
    have e : -(2 * Real.pi * Complex.I) * ((k1 : ℂ) * (s1 : ℂ) + (k2 : ℂ) * (s2 : ℂ)) =
        ((-(2 * Real.pi * ((k1 : ℝ) * s1 + (k2 : ℝ) * s2)) : ℝ) : ℂ) * Complex.I := by
      push_cast; ring
    rw [e, Complex.norm_exp_ofReal_mul_I]

  have hvol : (volume (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) = 1 := by
    rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc]
    simp
  have hsup : ∀ (H : Cyl → ℝ) (A : ℝ) (κ : ℤ × ℤ) (y : Cyl), (∀ η : Cyl, |H η| ≤ A) →
      ‖fourY H y κ *
        Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (y.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (y.2.2.2.2 : ℂ)))‖ ≤ A := by
    intro H A κ y hH
    rw [norm_mul, hexpn, mul_one]
    unfold fourY
    have h := norm_setIntegral_le_of_norm_le_const (μ := volume)
      (s := Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) (C := A)
      (f := fun Y : ℝ × ℝ => (H (y.1, y.2.1, y.2.2.1, Y) : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (Y.1 : ℂ) + (κ.2 : ℂ) * (Y.2 : ℂ))))
      (by rw [hvol]; exact ENNReal.one_lt_top)
