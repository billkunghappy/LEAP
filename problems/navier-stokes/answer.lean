    hInt _ (hEm2.mul ((hbm.comp (by fun_prop)).pow_const 2)) ((P.Pst + |C|) ^ 2) (fun y _ => by
      have h1 : ‖rfpBmp (y - rfpY4 P.Md P.lam + s) ^ 2‖ ≤ 1 := by
        rw [norm_pow, Real.norm_eq_abs]
        exact pow_le_one₀ (abs_nonneg _) (hb _)
      calc ‖Real.exp (y + 2 * rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + s) ^ 2‖
