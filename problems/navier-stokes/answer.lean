      intro a b ha hb
      obtain ⟨hW'1, hW'2, hW'3⟩ := iter _ b _ he2 hH1
      obtain ⟨hW1, hW2, hW3⟩ := iter _ a _ he1 hW'1
      have hpt : ∀ Z : ℝ × ℝ, ‖(Tv ((0:ℝ), ((1:ℝ), (0:ℝ))))^[a] ((Tv ((0:ℝ), ((0:ℝ), (1:ℝ))))^[b]
          ((Tv ((1:ℝ), ((0:ℝ), (0:ℝ))))^[j] G)) (s, Z)‖ ≤ M := by
        intro Z
        exact le_trans (le_of_eq (norm_iteratedFDeriv_zero (𝕜 := ℝ)
          (f := (Tv ((0:ℝ), ((1:ℝ), (0:ℝ))))^[a] ((Tv ((0:ℝ), ((0:ℝ), (1:ℝ))))^[b]
            ((Tv ((1:ℝ), ((0:ℝ), (0:ℝ))))^[j] G))) (x := (s, Z))).symm)
          ((hW2 0 (s, Z)).trans ((hW'2 _ _).trans ((hH2 _ _).trans (hM _ (by omega) _))))
      have hc := cfb _ M s hpt
