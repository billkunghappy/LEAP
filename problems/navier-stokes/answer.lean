    fun c e f hf => tdg_qshift_v5 B (qsOf l0) hok hSN hqs0 hqs1 c e 1 f hf
  have hE1 : Aex B.h + 1 + B.h * 1 = 2 * Aex B.h + 1/2 := by unfold Aex; ring
  have hE2 : Aex B.h + 1/2 + 1/2 + B.h * 1 = 2 * Aex B.h + 1/2 := by unfold Aex; ring
  have hE3 : Aex B.h + Aex B.h + 1/2 = 2 * Aex B.h + 1/2 := by ring

  obtain ⟨t0, ht0⟩ : ∃ f : Cyl → ℝ, f = fun ξ => ubase B ξ 1 * momDvP B dv ξ / ξ.1 := ⟨_, rfl⟩
  have hT0 : InM B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) t0) := by
    have a1 := (h4 l0 hl4 α (Aex B.h) (momDvP B dv) hw).1
    rw [ht0]
    exact hexp _ _ _ _ (h3 l0 hl3 _ _ _ a1).2.2.1 hE3
  obtain ⟨t1, ht1⟩ : ∃ f : Cyl → ℝ, f = dT (momDbP B dPsi) := ⟨_, rfl⟩
  have hT1 : InM B (qsOf l0) (α + 1) (nrm B (2 * Aex B.h + 1/2) t1) := by
    rw [ht1]
    exact hmono _ _ _ _
      (hexp _ _ _ _ (hsh _ _ _ (h7 l0 hl7 (α + 1) (Aex B.h) (momDbP B dPsi) hb)) hE1) (by linarith)
  obtain ⟨Fn, hFn⟩ : ∃ f : Cyl → ℝ, f = fun η => 2 * ubase B η 0 * momDbP B dPsi η +
      2 * mcor5 B G l0 S 0 η * momDbP B dPsi η + momDbP B dPsi η ^ 2 := ⟨_, rfl⟩
  have hFnC : InM B (qsOf l0) (α + 2) (nrm B (Aex B.h + Aex B.h) Fn) := by
    have a1 := h5 l0 hl5 (α + 1) (Aex B.h) (momDbP B dPsi) hb
    have a2 := hmul _ _ _ _ hβ hb
    have a3 := hmul _ _ _ _ hb hb
    have p1 := hlin _ _ (α + 2) _ 2 2 _ _
      (fun η => 2 * ubase B η 0 * momDbP B dPsi η + 2 * mcor5 B G l0 S 0 η * momDbP B dPsi η)
      a1 a2 (by linarith) (by linarith) (fun ξ _ => by (try dsimp only); ring)
    rw [hFn]
    exact hlin _ _ (α + 2) _ 1 1 _ _ _ p1 a3 le_rfl (by linarith)
      (fun ξ _ => by (try dsimp only); ring)
  obtain ⟨t2, ht2⟩ : ∃ f : Cyl → ℝ, f = dR B.h Fn := ⟨_, rfl⟩
  have hT2 : InM B (qsOf l0) (α + 2 - kapS) (nrm B (2 * Aex B.h + 1/2) t2) := by
    rw [ht2]
    exact hexp _ _ _ _ (h3 l0 hl3 Fn _ _ hFnC).1 hE3
  obtain ⟨t3, ht3⟩ : ∃ f : Cyl → ℝ, f = fun ξ => Fn ξ / ξ.1 := ⟨_, rfl⟩
  have hT3 : InM B (qsOf l0) (α + 2) (nrm B (2 * Aex B.h + 1/2) t3) := by
    rw [ht3]
    exact hexp _ _ _ _ (h3 l0 hl3 Fn _ _ hFnC).2.2.1 hE3
  obtain ⟨En, hEn⟩ : ∃ f : Cyl → ℝ, f = fun η => ubase B η 0 * momDgP B dPsi η +
      ubase B η 2 * momDbP B dPsi η + mcor5 B G l0 S 0 η * momDgP B dPsi η +
      mcor5 B G l0 S 2 η * momDbP B dPsi η + momDbP B dPsi η * momDgP B dPsi η := ⟨_, rfl⟩
  have hEnC : InM B (qsOf l0) (α + 1) (nrm B (Aex B.h + Aex B.h) En) := by
    have a1 := h5 l0 hl5 α (Aex B.h) (momDgP B dPsi) hg
    have a2 := (h4 l0 hl4 (α + 1) (Aex B.h) (momDbP B dPsi) hb).2
    have a3 := hmul _ _ _ _ hβ hg
    have a4 := hmul _ _ _ _ hγ hb
    have a5 := hmul _ _ _ _ hb hg
    have p1 := hlin _ _ (α + 1) _ 1 1 _ _
      (fun η => ubase B η 0 * momDgP B dPsi η + ubase B η 2 * momDbP B dPsi η)
      a1 a2 (by linarith) (by linarith) (fun ξ _ => by (try dsimp only); ring)
    have p2 := hlin _ _ (α + 1) _ 1 1 _ _
      (fun η => ubase B η 0 * momDgP B dPsi η + ubase B η 2 * momDbP B dPsi η +
        mcor5 B G l0 S 0 η * momDgP B dPsi η)
      p1 a3 le_rfl (by linarith) (fun ξ _ => by (try dsimp only); ring)
    have p3 := hlin _ _ (α + 1) _ 1 1 _ _
      (fun η => ubase B η 0 * momDgP B dPsi η + ubase B η 2 * momDbP B dPsi η +
        mcor5 B G l0 S 0 η * momDgP B dPsi η + mcor5 B G l0 S 2 η * momDbP B dPsi η)
      p2 a4 le_rfl (by linarith) (fun ξ _ => by (try dsimp only); ring)
    rw [hEn]
    exact hlin _ _ (α + 1) _ 1 1 _ _ _ p3 a5 le_rfl (by linarith)
      (fun ξ _ => by (try dsimp only); ring)
  obtain ⟨t4, ht4⟩ : ∃ f : Cyl → ℝ, f = dZ En := ⟨_, rfl⟩
  have hT4 : InM B (qsOf l0) (α + 1 + 1 - kapS) (nrm B (2 * Aex B.h + 1/2) t4) := by
    rw [ht4]
    exact hexp _ _ _ _ (h3 l0 hl3 En _ _ hEnC).2.1 hE3
  obtain ⟨N5, hN5⟩ : ∃ f : Cyl → ℝ, f = fun η => 2 * mcor5 B G l0 S 1 η * momDvP B dv η +
      momDvP B dv η ^ 2 := ⟨_, rfl⟩
  have hN5C : InM B (qsOf l0) α (nrm B (Aex B.h + Aex B.h) N5) := by
    have a1 := hmul _ _ _ _ hv hw
    have a2 := hmul _ _ _ _ hw hw
    rw [hN5]
    exact hlin _ _ α _ 2 1 _ _ _ a1 a2 (by linarith) (by linarith)
      (fun ξ _ => by (try dsimp only); ring)
  obtain ⟨t5, ht5⟩ : ∃ f : Cyl → ℝ, f = fun ξ => N5 ξ / ξ.1 := ⟨_, rfl⟩
  have hT5 : InM B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) t5) := by
    rw [ht5]
    exact hexp _ _ _ _ (h3 l0 hl3 N5 _ _ hN5C).2.2.1 hE3
  obtain ⟨t6, ht6⟩ : ∃ f : Cyl → ℝ, f = fun ξ => lap0 B.h (momDbP B dPsi) ξ -
      momDbP B dPsi ξ / ξ.1 ^ 2 := ⟨_, rfl⟩
  have hT6 : InM B (qsOf l0) (α + 2 - 2 * kapS) (nrm B (2 * Aex B.h + 1/2) t6) := by
    have d0 := h3 l0 hl3 (momDbP B dPsi) _ _ hb
    have d1 := h3 l0 hl3 (dR B.h (momDbP B dPsi)) _ _ d0.1
    have d2 := h3 l0 hl3 (dZ (momDbP B dPsi)) _ _ d0.2.1
    have d3 := h3 l0 hl3 (fun ξ => momDbP B dPsi ξ / ξ.1) _ _ d0.2.2.1
    have p1 := hlin _ _ (α + 1 - 2 * kapS) _ 1 1 _ _
      (fun ξ => dR B.h (dR B.h (momDbP B dPsi)) ξ + dR B.h (momDbP B dPsi) ξ / ξ.1)
      d1.1 d1.2.2.1 (by linarith) (by linarith) (fun ξ _ => by (try dsimp only); ring)
    have p2 := hlin _ _ (α + 1 - 2 * kapS) _ 1 1 _ _ (lap0 B.h (momDbP B dPsi))
      p1 d2.2.1 le_rfl (by linarith) (fun ξ _ => by simp only [lap0]; ring)
    have p3 := hlin _ _ (α + 1 - 2 * kapS) _ 1 (-1) _ _
      (fun ξ => lap0 B.h (momDbP B dPsi) ξ - momDbP B dPsi ξ / ξ.1 ^ 2)
      p2 d3.2.2.1 le_rfl (by linarith) (fun ξ _ => by (try dsimp only); ring)
    have p4 := hexp _ _ _ _ (hsh _ _ _ p3) hE2
    rw [ht6]
    exact hmono _ _ _ _ p4 (by linarith)

  have K1 := hlin _ _ α _ 2 (-1) t0 t1 (fun ξ => 2 * t0 ξ - t1 ξ) hT0 hT1 le_rfl (by linarith)
    (fun ξ _ => by (try dsimp only); ring)
  have K2 := hlin _ _ α _ 1 (-1) _ t2 (fun ξ => 2 * t0 ξ - t1 ξ - t2 ξ) K1 hT2 le_rfl
    (by linarith) (fun ξ _ => by (try dsimp only); ring)
  have K3 := hlin _ _ α _ 1 (-1) _ t3 (fun ξ => 2 * t0 ξ - t1 ξ - t2 ξ - t3 ξ) K2 hT3 le_rfl
    (by linarith) (fun ξ _ => by (try dsimp only); ring)
  have K4 := hlin _ _ α _ 1 (-1) _ t4 (fun ξ => 2 * t0 ξ - t1 ξ - t2 ξ - t3 ξ - t4 ξ) K3 hT4
    le_rfl (by linarith) (fun ξ _ => by (try dsimp only); ring)
  have K5 := hlin _ _ α _ 1 1 _ t5 (fun ξ => 2 * t0 ξ - t1 ξ - t2 ξ - t3 ξ - t4 ξ + t5 ξ) K4 hT5
    le_rfl le_rfl (fun ξ _ => by (try dsimp only); ring)
  have K6 := hlin _ _ α _ 1 1 _ t6
    (fun ξ => 2 * t0 ξ - t1 ξ - t2 ξ - t3 ξ - t4 ξ + t5 ξ + t6 ξ) K5 hT6
    le_rfl (by linarith) (fun ξ _ => by (try dsimp only); ring)
  refine hlin _ _ α _ 1 0 _ _ _ K6 K6 le_rfl le_rfl (fun ξ _ => ?_)
  subst ht0 ht1 ht2 ht3 ht4 ht5 ht6
  subst hFn hEn hN5
  simp only [momDg5, momRg5]
  ring

theorem wcov5_shell_vanish : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (bw ca cm cd : ℝ), B.ok → qsOf l0 ≤ B.qB → StOrd5 B G l0 S bw ca cm cd → ∀ a c : Fin 3, ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → Wcov5 B G l0 S a c ξ = 0 :=
by
  intro B G l0 S bw ca cm cd hok hqsB hSt a c ξ hξ hsh
  obtain ⟨r, z, t, Y⟩ := ξ
  obtain ⟨hr, ht, hqs⟩ : 0 < r ∧ t < 1 ∧ qC B.h (r, z, t, Y) < qsOf l0 := hξ
  obtain ⟨hS1, -, -, hS4, -⟩ := hok.1
  obtain ⟨-, -, -, -, -, hVel, -⟩ := hok.2
  unfold StOrd5 at hSt
  obtain ⟨hAw, -, -, -, hShP, hShb, -⟩ := hSt
  have hτ : 0 < 1 - t := by linarith
  obtain ⟨q, hqdef⟩ : ∃ q : ℝ, q = qC B.h (r, z, t, Y) := ⟨_, rfl⟩
  have hq : 0 < q := by rw [hqdef]; exact (hS1 z (1 - t) hτ).1
  have hqs' : q < qsOf l0 := by rw [hqdef]; exact hqs
  have hXC : XC B.h (r, z, t, Y) = r ^ 2 / (2 * q) := by rw [hqdef]; rfl

  have hc0 : ∀ ρ θ ζ : ℝ, rotPt ρ θ ζ 0 = ρ * Real.cos θ := by intro ρ θ ζ; simp [rotPt]
  have hc1 : ∀ ρ θ ζ : ℝ, rotPt ρ θ ζ 1 = ρ * Real.sin θ := by intro ρ θ ζ; simp [rotPt]
  have hc2 : ∀ ρ θ ζ : ℝ, rotPt ρ θ ζ 2 = ζ := by intro ρ θ ζ; simp [rotPt]
  have hsq : ∀ θ : ℝ, rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2 = r ^ 2 := by
    intro θ; rw [hc0, hc1]; linear_combination r ^ 2 * Real.cos_sq_add_sin_sq θ
  have hrad : ∀ θ : ℝ, rad (rotPt r θ z) = r := by
    intro θ
    show Real.sqrt (rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2) = r
    rw [hsq, Real.sqrt_sq hr.le]
  have hsx : ∀ θ : ℝ, simScale B.h (rotPt r θ z 2) (1 - t) = q := by
    intro θ; rw [hc2, hqdef]; rfl

  have hco : ∀ i : Fin 3, Continuous fun w : ℝ³ => w i := by
    intro i
    have h0 : Continuous (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) i) := ContinuousLinearMap.continuous _
    rwa [EuclideanSpace.coe_proj] at h0
  have hscont : Continuous fun y : ℝ³ => simScale B.h (y 2) (1 - t) := by
    have hg : Continuous fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ) := (hco 2).prodMk continuous_const
    exact hS4.continuousOn.comp_continuous hg (fun y => ⟨mem_univ _, hτ⟩)
  have hsum : Continuous fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2 := ((hco 0).pow 2).add ((hco 1).pow 2)

  obtain ⟨N, hN⟩ : ∃ N : Set ℝ³, N = {y | y 0 ^ 2 + y 1 ^ 2 < 2 * B.Xa * simScale B.h (y 2) (1 - t)} ∪
      {y | 2 * B.Xb * simScale B.h (y 2) (1 - t) < y 0 ^ 2 + y 1 ^ 2} := ⟨_, rfl⟩
  have hNo : IsOpen N := by
    rw [hN]
    exact (isOpen_lt hsum (continuous_const.mul hscont)).union (isOpen_lt (continuous_const.mul hscont) hsum)
  have hxN : ∀ θ : ℝ, rotPt r θ z ∈ N := by
    intro θ
    rw [hN]
    rcases hsh with h | h
    · refine Set.mem_union_left _ ?_
      show rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2 < 2 * B.Xa * simScale B.h (rotPt r θ z 2) (1 - t)
      rw [hsq, hsx]
      rw [hXC, div_lt_iff₀ (by linarith)] at h
      linarith
    · refine Set.mem_union_right _ ?_
      show 2 * B.Xb * simScale B.h (rotPt r θ z 2) (1 - t) < rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2
      rw [hsq, hsx]
      rw [hXC, lt_div_iff₀ (by linarith)] at h
      linarith

  have hshell : ∀ y ∈ N, ∀ Y' : ℝ × ℝ, corrOn B l0 y t →
      ptOf y t Y' ∈ DomC B.h (qsOf l0) ∧
        (XC B.h (ptOf y t Y') < B.Xa ∨ B.Xb < XC B.h (ptOf y t Y')) := by
    intro y hy Y' hc
    obtain ⟨hc1, hc2', hc3⟩ := hc
    refine ⟨(show ptOf y t Y' ∈ DomC B.h (qsOf l0) from ⟨hc1, hc2', hc3⟩), ?_⟩
    have hsy : 0 < simScale B.h (y 2) (1 - t) := (hS1 (y 2) (1 - t) hτ).1
    have hXy : XC B.h (ptOf y t Y') = (y 0 ^ 2 + y 1 ^ 2) / (2 * simScale B.h (y 2) (1 - t)) := by
      show rad y ^ 2 / (2 * simScale B.h (y 2) (1 - t)) = _
      rw [rad, Real.sq_sqrt (by positivity)]
    rw [hXy]
    rw [hN] at hy
    rcases hy with h | h
    · have h' : y 0 ^ 2 + y 1 ^ 2 < 2 * B.Xa * simScale B.h (y 2) (1 - t) := h
      left
      rw [div_lt_iff₀ (by linarith)]
      linarith
    · have h' : 2 * B.Xb * simScale B.h (y 2) (1 - t) < y 0 ^ 2 + y 1 ^ 2 := h
      right
      rw [lt_div_iff₀ (by linarith)]
      linarith

  have hAX : ∀ y ∈ N, ∀ Y' : ℝ × ℝ, AX5 B G l0 S y t Y' = B.AB y t := by
    intro y hy Y'
    unfold AX5
    by_cases hc : corrOn B l0 y t
    · rw [if_pos hc]
      obtain ⟨hD, hsh'⟩ := hshell y hy Y' hc
      have hz : ∀ γ m, S.Aw γ m (ptOf y t Y') = 0 := by
        intro γ m
        by_contra hne
        have hW := hAw.2.2.2.1 γ m (ptOf y t Y') hD hne
        obtain ⟨-, -, -, -, h5, h6⟩ := hW
        rcases hsh' with h | h <;> linarith
      have hwave : waveV5 B G S.Aw (thetaOf y) (ptOf y t Y') = 0 := by
        funext i
        simp only [waveV5, hz, Pi.zero_apply, zero_mul, finsum_zero, Complex.zero_re]
      have hpsi : S.Psi (ptOf y t Y') = 0 := hShP _ (hsh'.imp le_of_lt le_of_lt)
      rw [hwave, hpsi]
      simp [cyl2cart]
    · rw [if_neg hc, add_zero]

  have hcurl : ∀ θ : ℝ, curlX B.h (AX5 B G l0 S) (rotPt r θ z) t Y =
      curl3 (fun w => B.AB w t) (rotPt r θ z) := by
    intro θ
    have hev : (fun y => evOff B.h (AX5 B G l0 S) (Y - Yph B.h (rad (rotPt r θ z)) t) y t)
        =ᶠ[nhds (rotPt r θ z)] (fun w => B.AB w t) :=
      Filter.eventuallyEq_of_mem (hNo.mem_nhds (hxN θ)) (fun y hy => by
        show AX5 B G l0 S y t _ = B.AB y t
        exact hAX y hy _)
    show curl3 (fun y => evOff B.h (AX5 B G l0 S) (Y - Yph B.h (rad (rotPt r θ z)) t) y t) (rotPt r θ z) = _
    simp only [curl3, hev.fderiv_eq]

  have hptx : ∀ θ : ℝ, ptOf (rotPt r θ z) t Y = (r, z, t, Y) := by
    intro θ
    show (rad (rotPt r θ z), rotPt r θ z 2, t, Y) = _
    rw [hrad, hc2]
  have hbd : S.bdir (r, z, t, Y) = 0 := hShb _ (hsh.imp le_of_lt le_of_lt)
  have hBX : ∀ θ : ℝ, BX B G l0 S (rotPt r θ z) t Y = B.BvB (rotPt r θ z) t := by
    intro θ
    unfold BX
    rw [hptx θ, hbd, mul_zero, zero_smul, ite_self, add_zero]
  have huX : ∀ θ : ℝ, uX5 B G l0 S (rotPt r θ z) t Y = uB B (rotPt r θ z) t := by
    intro θ
    show curlX B.h (AX5 B G l0 S) (rotPt r θ z) t Y + BX B G l0 S (rotPt r θ z) t Y = _
    rw [hcurl θ, hBX θ]
    rfl

  have hX : ∀ θ : ℝ, simX B.h (rotPt r θ z) t = r ^ 2 / (2 * q) := by
    intro θ; unfold simX; rw [hsx, hsq]
  have hE : ∀ θ : ℝ, simEta B.h (rotPt r θ z) t = z * q ^ (-(1/2 - B.h)) := by
    intro θ; unfold simEta; rw [hsx, hc2]
  have hmem : ∀ θ : ℝ, (rotPt r θ z, t) ∈ simDomain B.h B.qB := by
    intro θ
    show t < 1 ∧ simScale B.h (rotPt r θ z 2) (1 - t) < B.qB
    rw [hsx]
    exact ⟨ht, lt_of_lt_of_le hqs' hqsB⟩
  have hpos : ∀ θ : ℝ, 0 < rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2 := by
    intro θ; rw [hsq]; positivity
  have key : ∀ θ : ℝ,
      inner ℝ (uB B (rotPt r θ z) t) (frameAt θ (r, z, t, Y) 0) =
          r⁻¹ * B.Vb q (r ^ 2 / (2 * q)) (z * q ^ (-(1/2 - B.h))) ∧
      inner ℝ (uB B (rotPt r θ z) t) (frameAt θ (r, z, t, Y) 1) =
          r⁻¹ * (r * q ^ (-(1/2 + B.h)) * B.Eb q (r ^ 2 / (2 * q)) (z * q ^ (-(1/2 - B.h)))) ∧
      inner ℝ (uB B (rotPt r θ z) t) (frameAt θ (r, z, t, Y) 2) =
          q ^ (-(1/2 + B.h)) * B.Ub q (r ^ 2 / (2 * q)) (z * q ^ (-(1/2 - B.h))) := by
    intro θ
    obtain ⟨hEq, hUq, hVq⟩ := hVel (rotPt r θ z) t (hmem θ) (hpos θ)
    simp only [hsx, hX, hE] at hEq hUq hVq
    rw [hsq, Real.sqrt_sq hr.le] at hEq
    refine ⟨?_, ?_, ?_⟩
    · have hf : frameAt θ (r, z, t, Y) 0 = (rad (rotPt r θ z))⁻¹ • radVec (rotPt r θ z) := rfl
      rw [hf, real_inner_smul_right, hrad]
      exact congrArg (fun v => r⁻¹ * v) hVq
    · have hf : frameAt θ (r, z, t, Y) 1 = (rad (rotPt r θ z))⁻¹ • azVec (rotPt r θ z) := rfl
      rw [hf, real_inner_smul_right, hrad]
      exact congrArg (fun v => r⁻¹ * v) hEq
    · have hf : frameAt θ (r, z, t, Y) 2 = EuclideanSpace.single 2 1 := rfl
      rw [hf, EuclideanSpace.inner_single_right, conj_trivial, one_mul]
      exact hUq
  have hind : ∀ (θ : ℝ) (b : Fin 3),
      inner ℝ (uB B (rotPt r θ z) t) (frameAt θ (r, z, t, Y) b) = ubase B (r, z, t, Y) b := by
    intro θ b
    obtain ⟨k0, k1, k2⟩ := key θ
    obtain ⟨m0, m1, m2⟩ := key 0
    obtain rfl | rfl | rfl : b = 0 ∨ b = 1 ∨ b = 2 := by fin_cases b <;> simp
    · exact k0.trans m0.symm
    · exact k1.trans m1.symm
    · exact k2.trans m2.symm
  have hu : ∀ (θ : ℝ) (b : Fin 3), ucyl5 B G l0 S θ (r, z, t, Y) b = ubase B (r, z, t, Y) b := by
    intro θ b
    show inner ℝ (uX5 B G l0 S (rotPt r θ z) t Y) (frameAt θ (r, z, t, Y) b) = _
    rw [huX θ]
    exact hind θ b

  have hthc : ∀ c0 : ℝ, thA (fun _ => c0) = c0 := by
    intro c0
    simp only [thA]
    have hπ : (2 * Real.pi) ≠ 0 := by positivity
    rw [intervalIntegral.integral_const, smul_eq_mul, sub_zero, ← mul_assoc, inv_mul_cancel₀ hπ, one_mul]
  show thA (fun θ => (ucyl5 B G l0 S θ (r, z, t, Y) a - thA (fun θ' => ucyl5 B G l0 S θ' (r, z, t, Y) a)) *
      (ucyl5 B G l0 S θ (r, z, t, Y) c - thA (fun θ' => ucyl5 B G l0 S θ' (r, z, t, Y) c))) = 0
  simp only [hu, hthc, sub_self, mul_zero]

theorem grP5_state_regular_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (bw ca cm cd : ℝ), B.ok → GeomPrim5 B G → qsOf l0 ≤ B.qB → StOrd5 B G l0 S bw ca cm cd → ContDiffOn ℝ ∞ (grP5 B G l0 S) (DomC B.h (qsOf l0)) ∧ ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → grP5 B G l0 S ξ = 0 :=
by
  intro B G l0 S bw ca cm cd hok hG hqsB hSt
  obtain ⟨-, hub, hmc, hW, -⟩ := state_cyl_smooth_v5 B G l0 S bw ca cm cd hok hG hqsB hSt
  obtain ⟨-, -, -, -, hcl, hsv⟩ := domc_open_calculus B (qsOf l0) hok
  have hSt0 := hSt
  unfold StOrd5 at hSt0
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hm1, hm2, -, hm0, -, -⟩ := hSt0
  have hβ := g_regular_of_nrm_InM_v5 B (qsOf l0) _ _ _ hok hm0
  have hv := g_regular_of_nrm_InM_v5 B (qsOf l0) _ _ _ hok hm1
  have hγ := g_regular_of_nrm_InM_v5 B (qsOf l0) _ _ _ hok hm2
  have hWv := wcov5_shell_vanish B G l0 S bw ca cm cd hok hqsB hSt
  have hne : ∀ ξ ∈ DomC B.h (qsOf l0), ξ.1 ≠ 0 := by
    intro ξ hξ
    have h : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    exact h.1.ne'
  have hne2 : ∀ ξ ∈ DomC B.h (qsOf l0), ξ.1 ^ 2 ≠ 0 := fun ξ hξ => pow_ne_zero 2 (hne ξ hξ)
  have hfst : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1) (DomC B.h (qsOf l0)) := contDiff_fst.contDiffOn
  have hβs : ContDiffOn ℝ ∞ (mcor5 B G l0 S 0) (DomC B.h (qsOf l0)) := hmc 0
  have hvs : ContDiffOn ℝ ∞ (mcor5 B G l0 S 1) (DomC B.h (qsOf l0)) := hmc 1
  have hγs : ContDiffOn ℝ ∞ (mcor5 B G l0 S 2) (DomC B.h (qsOf l0)) := hmc 2
  have hF0s : ContDiffOn ℝ ∞ (fun η => 2 * ubase B η 0 * mcor5 B G l0 S 0 η + mcor5 B G l0 S 0 η ^ 2
      + Wcov5 B G l0 S 0 0 η) (DomC B.h (qsOf l0)) := by
    have h := ((((contDiffOn_const (c := (2:ℝ))).mul (hub 0)).mul hβs).add (hβs.pow 2)).add (hW 0 0)
    exact h
  have hF2s : ContDiffOn ℝ ∞ (fun η => ubase B η 0 * mcor5 B G l0 S 2 η + ubase B η 2 * mcor5 B G l0 S 0 η
      + mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 2 0 η) (DomC B.h (qsOf l0)) := by
    have h := ((((hub 0).mul hγs).add ((hub 2).mul hβs)).add (hβs.mul hγs)).add (hW 2 0)
    exact h
  have hF11 : ContDiffOn ℝ ∞ (fun η => 2 * ubase B η 1 * mcor5 B G l0 S 1 η + mcor5 B G l0 S 1 η ^ 2
      + Wcov5 B G l0 S 1 1 η) (DomC B.h (qsOf l0)) := by
    have h := ((((contDiffOn_const (c := (2:ℝ))).mul (hub 1)).mul hvs).add (hvs.pow 2)).add (hW 1 1)
    exact h
  have hdβ := hcl _ hβs
  have hdRRβ := (hcl _ hdβ.1).1
  have hdZZβ := (hcl _ hdβ.2.1).2.1
  have hdRF0 := (hcl _ hF0s).1
  have hdZF2 := (hcl _ hF2s).2.1
  refine ⟨?_, ?_⟩
  · have hR := (((((contDiffOn_const (c := (0:ℝ))).sub hdβ.2.2).sub (hdRF0.add (hF0s.div hfst hne))).sub
      hdZF2).add (hF11.div hfst hne)).add
      (((hdRRβ.add (hdβ.1.div hfst hne)).add hdZZβ).sub (hβs.div (hfst.pow 2) hne2))
    exact hR.congr (fun ξ _ => rfl)
  · intro ξ hξ hX
    have SV0 : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) → mcor5 B G l0 S 0 η = 0 :=
      fun η hη hX' => hβ.2 η hη (hX'.imp le_of_lt le_of_lt)
    have SV1 : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) → mcor5 B G l0 S 1 η = 0 :=
      fun η hη hX' => hv.2 η hη (hX'.imp le_of_lt le_of_lt)
    have SV2 : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) → mcor5 B G l0 S 2 η = 0 :=
      fun η hη hX' => hγ.2 η hη (hX'.imp le_of_lt le_of_lt)
    have SVF0 : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) →
        (fun η => 2 * ubase B η 0 * mcor5 B G l0 S 0 η + mcor5 B G l0 S 0 η ^ 2
          + Wcov5 B G l0 S 0 0 η) η = 0 := by
      intro η hη hX'
      simp only [SV0 η hη hX', hWv 0 0 η hη hX']
      ring
    have SVF2 : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) →
        (fun η => ubase B η 0 * mcor5 B G l0 S 2 η + ubase B η 2 * mcor5 B G l0 S 0 η
          + mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 2 0 η) η = 0 := by
      intro η hη hX'
      simp only [SV0 η hη hX', SV2 η hη hX', hWv 2 0 η hη hX']
      ring
    have hRF0 := (hsv _ SVF0 ξ hξ hX).1
    have hZF2 := (hsv _ SVF2 ξ hξ hX).2.1
    have hb3 := hsv (mcor5 B G l0 S 0) SV0
    obtain ⟨hRβ, -, hTβ⟩ := hb3 ξ hξ hX
    have hRR := (hsv (dR B.h (mcor5 B G l0 S 0)) (fun η hη hX' => (hb3 η hη hX').1) ξ hξ hX).1
    have hZZ := (hsv (dZ (mcor5 B G l0 S 0)) (fun η hη hX' => (hb3 η hη hX').2.1) ξ hξ hX).2.1
    show (0:ℝ) - dT (mcor5 B G l0 S 0) ξ
        - (dR B.h (fun η => 2 * ubase B η 0 * mcor5 B G l0 S 0 η + mcor5 B G l0 S 0 η ^ 2
            + Wcov5 B G l0 S 0 0 η) ξ
          + (2 * ubase B ξ 0 * mcor5 B G l0 S 0 ξ + mcor5 B G l0 S 0 ξ ^ 2 + Wcov5 B G l0 S 0 0 ξ) / ξ.1)
        - dZ (fun η => ubase B η 0 * mcor5 B G l0 S 2 η + ubase B η 2 * mcor5 B G l0 S 0 η
            + mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 2 0 η) ξ
        + (2 * ubase B ξ 1 * mcor5 B G l0 S 1 ξ + mcor5 B G l0 S 1 ξ ^ 2 + Wcov5 B G l0 S 1 1 ξ) / ξ.1
        + ((dR B.h (dR B.h (mcor5 B G l0 S 0)) ξ + dR B.h (mcor5 B G l0 S 0) ξ / ξ.1
            + dZ (dZ (mcor5 B G l0 S 0)) ξ) - mcor5 B G l0 S 0 ξ / ξ.1 ^ 2) = 0
    rw [hTβ, hRF0, hZF2, hRR, hRβ, hZZ, SV0 ξ hξ hX, SV1 ξ hξ hX, hWv 0 0 ξ hξ hX, hWv 1 1 ξ hξ hX]
    simp

theorem pmP5_update_split_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S S' : CState) (g : Cyl → ℝ), B.ok → ContinuousOn (grP5 B G l0 S) (DomC B.h (qsOf l0)) → ContinuousOn g (DomC B.h (qsOf l0)) → (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → grP5 B G l0 S ξ = 0 ∧ g ξ = 0) → (∀ ξ ∈ DomC B.h (qsOf l0), grP5 B G l0 S' ξ = grP5 B G l0 S ξ + g ξ) → (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → calP5 B G l0 S' z t = calP5 B G l0 S z t + radMom g 0 z t) ∧ (∀ ξ ∈ DomC B.h (qsOf l0), pmP5 B G l0 S' ξ - pmP5 B G l0 S ξ = Icut B (momDgt B g) ξ ∧ pmP5 B G l0 S' ξ - pmP5 B G l0 S ξ = Icut B (fun η => (grP5 B G l0 S' η - grP5 B G l0 S η) - rhoP B η * (calP5 B G l0 S' η.2.1 η.2.2.1 - calP5 B G l0 S η.2.1 η.2.2.1)) ξ) :=
by
  intro B G l0 S S' g hok hc hgc hvan hS'
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -⟩ := hok.2.1

  have shell : ∀ (z t : ℝ), t < 1 → ∃ a b : ℝ, 0 < a ∧ ∀ (r : ℝ) (W : ℝ × ℝ), 0 < r →
      r ∉ Set.Icc a b → XC B.h (r, z, t, W) < B.Xa ∨ B.Xb < XC B.h (r, z, t, W) := by
    intro z t ht
    have hq : 0 < simScale B.h z (1 - t) := (hok.1.1 z (1 - t) (by linarith)).1
    refine ⟨Real.sqrt (2 * B.Xa * simScale B.h z (1 - t)), Real.sqrt (2 * B.Xb * simScale B.h z (1 - t)),
      Real.sqrt_pos.mpr (by positivity), ?_⟩
    intro r W hr hn
    have hX : XC B.h (r, z, t, W) = r ^ 2 / (2 * simScale B.h z (1 - t)) := rfl
    rw [hX]
    rw [Set.mem_Icc, not_and_or] at hn
    rcases hn with h1 | h1
    · left
      have h1' : r < Real.sqrt (2 * B.Xa * simScale B.h z (1 - t)) := not_le.mp h1
      have h2 := (Real.lt_sqrt hr.le).mp h1'
      rw [div_lt_iff₀ (by positivity)]
      linarith
    · right
      have h1' : Real.sqrt (2 * B.Xb * simScale B.h z (1 - t)) < r := not_le.mp h1
      have h2 := (Real.sqrt_lt' hr).mp h1'
      rw [lt_div_iff₀ (by positivity)]
      linarith

  have mem : ∀ (r z t : ℝ) (W : ℝ × ℝ), 0 < r → t < 1 → simScale B.h z (1 - t) < qsOf l0 →
      ((r, z, t, W) : Cyl) ∈ DomC B.h (qsOf l0) := by
    intro r z t W hr ht hq
    show 0 < r ∧ t < 1 ∧ qC B.h (r, z, t, W) < qsOf l0
    exact ⟨hr, ht, hq⟩

  have curve : ∀ (F : Cyl → ℝ) (z t : ℝ) (W : ℝ → ℝ × ℝ), t < 1 → simScale B.h z (1 - t) < qsOf l0 →
      ContinuousOn F (DomC B.h (qsOf l0)) →
      (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → F ξ = 0) →
      ContinuousOn W (Set.Ioi 0) →
      MeasureTheory.IntegrableOn (fun r : ℝ => F (r, z, t, W r)) (Set.Ioi 0) := by
    intro F z t W ht hq hF hFv hW
    obtain ⟨a, b, ha, hsh⟩ := shell z t ht
    have hsub : Set.Icc a b ⊆ Set.Ioi 0 := fun r hr => lt_of_lt_of_le ha hr.1
    have hcc : ContinuousOn (fun r : ℝ => ((r, z, t, W r) : Cyl)) (Set.Icc a b) :=
      continuousOn_id.prodMk (continuousOn_const.prodMk (continuousOn_const.prodMk (hW.mono hsub)))
    have hI : MeasureTheory.IntegrableOn (fun r : ℝ => F (r, z, t, W r)) (Set.Icc a b) := by
      apply ContinuousOn.integrableOn_Icc
      exact hF.comp hcc (fun r hr => mem r z t (W r) (hsub hr) ht hq)
    refine hI.of_forall_sdiff_eq_zero measurableSet_Ioi ?_
    intro r hr
    exact hFv _ (mem r z t (W r) hr.1 ht hq) (hsh r (W r) hr.1 hr.2)

  have yavg : ∀ (F : Cyl → ℝ) (z t : ℝ), t < 1 → simScale B.h z (1 - t) < qsOf l0 →
      ContinuousOn F (DomC B.h (qsOf l0)) →
      (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → F ξ = 0) →
      (∀ r : ℝ, 0 < r → MeasureTheory.IntegrableOn (fun Y : ℝ × ℝ => F (r, z, t, Y))
        (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) ∧
      MeasureTheory.IntegrableOn (fun r : ℝ => yAvg F (r, z, t, 0)) (Set.Ioi 0) := by
    intro F z t ht hq hF hFv
    obtain ⟨a, b, ha, hsh⟩ := shell z t ht
    have hcomp : IsCompact (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
    refine ⟨fun r hr => ?_, ?_⟩
    · have hcont : Continuous (fun Y : ℝ × ℝ => F (r, z, t, Y)) :=
        hF.comp_continuous (continuous_const.prodMk (continuous_const.prodMk
          (continuous_const.prodMk continuous_id))) (fun Y => mem r z t Y hr ht hq)
      exact hcont.continuousOn.integrableOn_compact hcomp
    · let f : ℝ → ℝ × ℝ → ℝ := fun r Y => F (max r a, z, t, Y)
      have hf : Continuous (Function.uncurry f) :=
        hF.comp_continuous ((continuous_fst.max continuous_const).prodMk (continuous_const.prodMk
          (continuous_const.prodMk continuous_snd)))
          (fun p => mem (max p.1 a) z t p.2 (lt_of_lt_of_le ha (le_max_right _ _)) ht hq)
      have hΦ : Continuous (fun r : ℝ => ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, f r Y) :=
        continuous_parametric_integral_of_continuous hf hcomp
      have hI : MeasureTheory.IntegrableOn (fun r : ℝ => yAvg F (r, z, t, 0)) (Set.Icc a b) := by
        apply ContinuousOn.integrableOn_Icc
        refine hΦ.continuousOn.congr ?_
        intro r hr
        show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, F (r, z, t, Y)) =
          ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, F (max r a, z, t, Y)
        rw [max_eq_left hr.1]
      refine hI.of_forall_sdiff_eq_zero measurableSet_Ioi ?_
      intro r hr
      show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, F (r, z, t, Y)) = 0
      have h0 : ∀ Y : ℝ × ℝ, F (r, z, t, Y) = 0 := fun Y =>
        hFv _ (mem r z t Y hr.1 ht hq) (hsh r Y hr.1 hr.2)
      simp only [h0, MeasureTheory.integral_zero]

  have icut_add : ∀ (k k1 k2 : Cyl → ℝ) (ξ : Cyl), 0 < ξ.1 →
      MeasureTheory.IntegrableOn (fun r' : ℝ => k1 (pathPt B.h ξ r')) (Set.Ioi 0) →
      MeasureTheory.IntegrableOn (fun r' : ℝ => k2 (pathPt B.h ξ r')) (Set.Ioi 0) →
      (∀ r' : ℝ, 0 < r' → k (pathPt B.h ξ r') = k1 (pathPt B.h ξ r') + k2 (pathPt B.h ξ r')) →
      Icut B k ξ = Icut B k1 ξ + Icut B k2 ξ := by
    intro k k1 k2 ξ hξ h1 h2 hk
    have e1 : (∫ r' in (0:ℝ)..ξ.1, k (pathPt B.h ξ r')) =
        (∫ r' in (0:ℝ)..ξ.1, k1 (pathPt B.h ξ r')) + ∫ r' in (0:ℝ)..ξ.1, k2 (pathPt B.h ξ r') := by
      rw [intervalIntegral.integral_of_le hξ.le, intervalIntegral.integral_of_le hξ.le,
        intervalIntegral.integral_of_le hξ.le]
      rw [MeasureTheory.setIntegral_congr_fun
        (g := fun r' => k1 (pathPt B.h ξ r') + k2 (pathPt B.h ξ r')) measurableSet_Ioc
        (fun r' hr' => hk r' hr'.1)]
      exact MeasureTheory.integral_add (h1.mono_set Set.Ioc_subset_Ioi_self)
        (h2.mono_set Set.Ioc_subset_Ioi_self)
    have e2 : (∫ r' in Set.Ioi (0:ℝ), k (pathPt B.h ξ r')) =
        (∫ r' in Set.Ioi (0:ℝ), k1 (pathPt B.h ξ r')) + ∫ r' in Set.Ioi (0:ℝ), k2 (pathPt B.h ξ r') := by
      rw [MeasureTheory.setIntegral_congr_fun
        (g := fun r' => k1 (pathPt B.h ξ r') + k2 (pathPt B.h ξ r')) measurableSet_Ioi
        (fun r' hr' => hk r' hr')]
      exact MeasureTheory.integral_add h1 h2
    unfold Icut
    rw [e1, e2]
    ring

  have rad_add : ∀ (F F2 K : Cyl → ℝ) (z t : ℝ),
      (∀ r : ℝ, 0 < r → MeasureTheory.IntegrableOn (fun Y : ℝ × ℝ => F (r, z, t, Y))
        (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) →
      (∀ r : ℝ, 0 < r → MeasureTheory.IntegrableOn (fun Y : ℝ × ℝ => F2 (r, z, t, Y))
        (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) →
      MeasureTheory.IntegrableOn (fun r : ℝ => yAvg F (r, z, t, 0)) (Set.Ioi 0) →
      MeasureTheory.IntegrableOn (fun r : ℝ => yAvg F2 (r, z, t, 0)) (Set.Ioi 0) →
      (∀ (r : ℝ) (Y : ℝ × ℝ), 0 < r → K (r, z, t, Y) = F (r, z, t, Y) + F2 (r, z, t, Y)) →
      radMom K 0 z t = radMom F 0 z t + radMom F2 0 z t := by
    intro F F2 K z t hF1 hG1 hF2 hG2 hK
    have hpt : ∀ r : ℝ, 0 < r → yAvg K (r, z, t, 0) = yAvg F (r, z, t, 0) + yAvg F2 (r, z, t, 0) := by
      intro r hr
      show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, K (r, z, t, Y)) =
        (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, F (r, z, t, Y)) +
          ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, F2 (r, z, t, Y)
      rw [MeasureTheory.setIntegral_congr_fun (g := fun Y => F (r, z, t, Y) + F2 (r, z, t, Y))
        (measurableSet_Icc.prod measurableSet_Icc) (fun Y _ => hK r Y hr)]
      exact MeasureTheory.integral_add (hF1 r hr) (hG1 r hr)
    unfold radMom
    simp only [pow_zero, one_mul]
    rw [MeasureTheory.setIntegral_congr_fun (g := fun r => yAvg F (r, z, t, 0) + yAvg F2 (r, z, t, 0))
      measurableSet_Ioi (fun r hr => hpt r hr)]
    exact MeasureTheory.integral_add hF2 hG2

  have hA : ∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 →
      calP5 B G l0 S' z t = calP5 B G l0 S z t + radMom g 0 z t := by
    intro z t ht hq
    obtain ⟨hF1, hF2⟩ := yavg (grP5 B G l0 S) z t ht hq hc (fun ξ hξ hX => (hvan ξ hξ hX).1)
    obtain ⟨hG1, hG2⟩ := yavg g z t ht hq hgc (fun ξ hξ hX => (hvan ξ hξ hX).2)
    exact rad_add _ _ _ z t hF1 hG1 hF2 hG2 (fun r Y hr => hS' _ (mem r z t Y hr ht hq))
  refine ⟨hA, fun ξ hξ => ?_⟩
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  obtain ⟨hr0, ht, hq⟩ := hξ'
  have hq' : simScale B.h ξ.2.1 (1 - ξ.2.2.1) < qsOf l0 := hq
  have hW : ContinuousOn (fun r' : ℝ => ξ.2.2.2 + (r' ^ drx B.h - ξ.1 ^ drx B.h) • vrv) (Set.Ioi 0) :=
    continuousOn_const.add (((continuousOn_id.rpow_const
      (fun x hx => Or.inl (Set.mem_Ioi.mp hx).ne')).sub continuousOn_const).smul continuousOn_const)
  have Ig : MeasureTheory.IntegrableOn (fun r' : ℝ => grP5 B G l0 S (pathPt B.h ξ r')) (Set.Ioi 0) :=
    curve _ ξ.2.1 ξ.2.2.1 _ ht hq' hc (fun η hη hX => (hvan η hη hX).1) hW
  have Iγ : MeasureTheory.IntegrableOn (fun r' : ℝ => g (pathPt B.h ξ r')) (Set.Ioi 0) :=
    curve _ ξ.2.1 ξ.2.2.1 _ ht hq' hgc (fun η hη hX => (hvan η hη hX).2) hW
  have Iρ : MeasureTheory.IntegrableOn (fun r' : ℝ => rhoP B (pathPt B.h ξ r')) (Set.Ioi 0) := by
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    have hsq : 0 < Real.sqrt (qC B.h ξ) := Real.sqrt_pos.mpr hq0
    have hm1 : 0 < B.m1 := lt_trans hXa hXam1
    have hw : 0 < (Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2 := by
      have := Real.sqrt_lt_sqrt (by linarith) (by linarith : 2 * B.m1 < 2 * B.m2)
      linarith
    set c : ℝ := (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2 with hc_def
    set w : ℝ := (Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2 with hw_def
    have e : (fun r' : ℝ => rhoP B (pathPt B.h ξ r')) =
        fun r' : ℝ => qC B.h ξ ^ (-(1/2:ℝ)) * rhoHat B (r' / Real.sqrt (qC B.h ξ)) := rfl
    rw [e]
    have hb : Continuous bumpR := by
      unfold bumpR
      exact Real.smoothTransition.continuous.comp (continuous_const.sub (continuous_id.pow 2))
    have hrh : Continuous (rhoHat B) := by
      unfold rhoHat
      exact (hb.comp ((continuous_id.sub continuous_const).div_const _)).div_const _
    have hcont : Continuous (fun r' : ℝ => qC B.h ξ ^ (-(1/2:ℝ)) * rhoHat B (r' / Real.sqrt (qC B.h ξ))) :=
      continuous_const.mul (hrh.comp (continuous_id.div_const _))
    have hbz : ∀ u : ℝ, 1 ≤ |u| → bumpR u = 0 := by
      intro u hu
      unfold bumpR
      apply Real.smoothTransition.zero_of_nonpos
      have h2 := sq_abs u
      nlinarith [abs_nonneg u]
    have hrz : ∀ s : ℝ, w ≤ |s - c| → rhoHat B s = 0 := by
