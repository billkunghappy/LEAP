      have f2 : SC B.h ξ ^ bf i ≤ SC B.h ξ ^ (∑ j ∈ Finset.range (k + 2), |bf j|) :=
        Real.rpow_le_rpow_of_exponent_le hS1 hb
      have f3 : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df i) ≤
          edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(∑ j ∈ Finset.range (k + 2), |df j|)) :=
        Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hd)
      have p2 : 0 ≤ SC B.h ξ ^ bf i := Real.rpow_nonneg (by linarith) _
      have p3 : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df i) := Real.rpow_nonneg he0.le _
      have m1 := mul_le_mul_of_nonneg_left f2 hqa
      have m2 := mul_le_mul_of_nonneg_right m1 hsq
      have m3 := mul_le_mul m2 f3 p3 (mul_nonneg (mul_nonneg hqa hSb) hsq)
      have m4 := mul_le_mul_of_nonneg_right m3 hP
      have hnn : 0 ≤ qC B.h ξ ^ (B.h * (β + 1/2)) * SC B.h ξ ^ bf i *
          Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
          edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df i) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) :=
        mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hqa p2) hsq) p3) hP
      calc NB B.h (π γ m) i ξ
          ≤ Cf i * qC B.h ξ ^ (B.h * (β + 1/2)) * SC B.h ξ ^ bf i *
            Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df i) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) :=
            hCf i γ m ξ hξ hX1 hX2
        _ = Cf i * (qC B.h ξ ^ (B.h * (β + 1/2)) * SC B.h ξ ^ bf i *
            Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df i) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) := by
            ring
        _ ≤ |Cf i| * (qC B.h ξ ^ (B.h * (β + 1/2)) * SC B.h ξ ^ bf i *
            Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df i) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) :=
            mul_le_mul_of_nonneg_right (le_abs_self _) hnn
        _ ≤ |Cf i| * W := by
            rw [hW]
            exact mul_le_mul_of_nonneg_left m4 (abs_nonneg _)
    have hqk : 0 ≤ qC B.h ξ ^ (-(B.h * kapS)) := Real.rpow_nonneg hq0.le _
    have hCs : 0 ≤ ∑ i ∈ Finset.range (k + 2), |Cf i| := Finset.sum_nonneg (fun i _ => abs_nonneg _)
    have hexp : qC B.h ξ ^ (B.h * (β + 1/2 - 3 * kapS)) ≥ qC B.h ξ ^ (-(B.h * kapS)) * qC B.h ξ ^ (B.h * (β + 1/2)) := by
      rw [← Real.rpow_add hq0]
      apply Real.rpow_le_rpow_of_exponent_ge hq0 hq1'
      have e : -(B.h * kapS) + B.h * (β + 1/2) - B.h * (β + 1/2 - 3 * kapS) = 2 * (B.h * kapS) := by ring
      have hp : 0 ≤ B.h * kapS := mul_nonneg hh.le (by rw [hk]; norm_num)
      linarith
    have hRHS : K * (∑ i ∈ Finset.range (k + 2), |Cf i|) * qC B.h ξ ^ (B.h * (β + 1/2 - 3 * kapS)) *
        SC B.h ξ ^ (∑ i ∈ Finset.range (k + 2), |bf i|) *
        Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(∑ i ∈ Finset.range (k + 2), |df i|)) *
        Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) =
        (K * (∑ i ∈ Finset.range (k + 2), |Cf i|) * (SC B.h ξ ^ (∑ i ∈ Finset.range (k + 2), |bf i|) *
        Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(∑ i ∈ Finset.range (k + 2), |df i|)) *
        Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2))) * qC B.h ξ ^ (B.h * (β + 1/2 - 3 * kapS)) := by
      ring
    have hW' : W = (SC B.h ξ ^ (∑ i ∈ Finset.range (k + 2), |bf i|) *
        Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(∑ i ∈ Finset.range (k + 2), |df i|)) *
        Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) * qC B.h ξ ^ (B.h * (β + 1/2)) := by
      rw [hW]; ring
    have hR0 : 0 ≤ K * (∑ i ∈ Finset.range (k + 2), |Cf i|) * (SC B.h ξ ^ (∑ i ∈ Finset.range (k + 2), |bf i|) *
        Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(∑ i ∈ Finset.range (k + 2), |df i|)) *
