    simpa only [add_zero] using hN'
  have hLs := (pwr5_waveV_add B G hok (qsOf l0) hqs1 _ _ β β' H2 hN).1
  rw [min_eq_left hbb'] at hLs
  have hL : InWg5 B G (qsOf l0) β (liftH5 d) := by
    convert hLs using 1
    funext γ m ξ i
    simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
