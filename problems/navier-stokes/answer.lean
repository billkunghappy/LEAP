      fun_prop
    have hm2 : ∀ p : Set.Icc a b × (ℝ × ℝ), (((p.1 : ℝ), ζ.1, ζ.2.1, p.2) : Cyl) ∈ DomC B.h qs :=
      fun p => ⟨lt_of_lt_of_le ha0 p.1.2.1, hζ1, hζ2⟩
    have hG : Continuous (Function.uncurry fun (r : Set.Icc a b) (Y : ℝ × ℝ) =>
