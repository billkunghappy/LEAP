    have hR : (∫ r in Ioi (0:ℝ), deriv (fun x => Φ r x) x0) =
        ∫ r in Icc a b, fderiv ℝ (fun p : ℝ × ℝ => Φ p.1 p.2) (r, x0) ((0:ℝ), (1:ℝ)) := by
      rw [RES _ a b ha le_rfl le_rfl hRv]
      exact setIntegral_congr_fun measurableSet_Icc (fun r hr => (hDd r x0 (hab' hr) hx0).deriv)
    rw [hR]
    exact hLB.congr_of_eventuallyEq hL
  set Ω := Ioi (0:ℝ) ×ˢ (Metric.ball z0 ε ×ˢ Metric.ball t0 ε) with hΩdef
  have hΩo : IsOpen Ω := isOpen_Ioi.prod (Metric.isOpen_ball.prod Metric.isOpen_ball)
  have memΩ : ∀ r z t : ℝ, 0 < r → |z - z0| < ε → |t - t0| < ε → ((r, z, t) : ℝ × ℝ × ℝ) ∈ Ω :=
    fun r z t hr hz ht => ⟨hr, (bz _ _ _).2 hz, (bz _ _ _).2 ht⟩
  have FLD : ∀ P' : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ P' Ω → ∀ v : ℝ × ℝ × ℝ,
      ContDiffOn ℝ ∞ (fun p => fderiv ℝ P' p v) Ω := fun P' hP' v =>
    (hP'.fderiv_of_isOpen hΩo (by simp)).clm_apply contDiffOn_const
  have SDz : ∀ P' : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ P' Ω → ∀ r z t : ℝ, 0 < r → |z - z0| < ε →
      |t - t0| < ε → HasDerivAt (fun z' => P' (r, z', t)) (fderiv ℝ P' (r, z, t) ((0:ℝ), (1:ℝ), (0:ℝ))) z := by
    intro P' hP' r z t hr hz ht
    have hd := ((hP'.differentiableOn (by simp)).differentiableAt
      (hΩo.mem_nhds (memΩ r z t hr hz ht))).hasFDerivAt
    have hc : HasDerivAt (fun z' : ℝ => ((r, z', t) : ℝ × ℝ × ℝ)) ((0:ℝ), (1:ℝ), (0:ℝ)) z :=
      (hasDerivAt_const z r).prodMk ((hasDerivAt_id' z).prodMk (hasDerivAt_const z t))
    exact hd.comp_hasDerivAt z hc
  have SDt : ∀ P' : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ P' Ω → ∀ r z t : ℝ, 0 < r → |z - z0| < ε →
      |t - t0| < ε → HasDerivAt (fun t' => P' (r, z, t')) (fderiv ℝ P' (r, z, t) ((0:ℝ), (0:ℝ), (1:ℝ))) t := by
    intro P' hP' r z t hr hz ht
    have hd := ((hP'.differentiableOn (by simp)).differentiableAt
      (hΩo.mem_nhds (memΩ r z t hr hz ht))).hasFDerivAt
    have hc : HasDerivAt (fun t' : ℝ => ((r, z, t') : ℝ × ℝ × ℝ)) ((0:ℝ), (0:ℝ), (1:ℝ)) t :=
      (hasDerivAt_const t r).prodMk ((hasDerivAt_const t z).prodMk (hasDerivAt_id' t))
    exact hd.comp_hasDerivAt t hc
  have embM : MapsTo (fun r : ℝ => ((r, z0, t0) : ℝ × ℝ × ℝ)) (Ioi 0) Ω :=
    fun r hr => memΩ r z0 t0 hr h0z h0t
  have SLc : ∀ g : ℝ × ℝ × ℝ → ℝ, ContinuousOn g Ω → ContinuousOn (fun r => g (r, z0, t0)) (Ioi 0) :=
    fun g hg => hg.comp (by fun_prop : Continuous fun r : ℝ => ((r, z0, t0) : ℝ × ℝ × ℝ)).continuousOn embM
  have SLs : ∀ g : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ g Ω → ContDiffOn ℝ ∞ (fun r => g (r, z0, t0)) (Ioi 0) :=
    fun g hg => hg.comp (by fun_prop : ContDiff ℝ ∞ fun r : ℝ => ((r, z0, t0) : ℝ × ℝ × ℝ)).contDiffOn embM
  have hpow : ContDiff ℝ ∞ (fun p : ℝ × ℝ => p.1 ^ 1) := contDiff_fst.pow 1
  have TRI : ∀ x z1 : ℝ, |x - z1| < ε / 2 → |z1 - z0| < ε / 2 → |x - z0| < ε := by
    intro x z1 h1 h2
    rw [abs_sub_lt_iff] at h1 h2 ⊢
    constructor <;> linarith
  have DZ0 : ∀ r y, 0 < r → (r ≤ a ∨ b ≤ r) → |y - z0| < ε → deriv (fun z' => pg r z' t0) y = 0 :=
    fun r y hr h hy => LZ _ (Metric.ball z0 ε) y Metric.isOpen_ball ((bz _ _ _).2 hy)
      (fun w hw => (hvan r w t0 hr h ((bz _ _ _).1 hw) h0t).1)
  set Q : ℝ × ℝ × ℝ → ℝ := fun p => fderiv ℝ (fun p : ℝ × ℝ × ℝ => pg p.1 p.2.1 p.2.2) p ((0:ℝ), (1:ℝ), (0:ℝ))
    with hQdef
  have hQs : ContDiffOn ℝ ∞ Q Ω := FLD _ hPg _
  have hZZeq : ∀ r, 0 < r → deriv (fun z => deriv (fun z' => pg r z' t0) z) z0 =
      fderiv ℝ Q (r, z0, t0) ((0:ℝ), (1:ℝ), (0:ℝ)) := by
    intro r hr
    have hev : (fun z => deriv (fun z' => pg r z' t0) z) =ᶠ[nhds z0] (fun z => Q (r, z, t0)) := by
      filter_upwards [Metric.ball_mem_nhds z0 hε] with y hy
      exact (SDz _ hPg r y t0 hr ((bz _ _ _).1 hy) h0t).deriv
    rw [hev.deriv_eq]
    exact (SDz Q hQs r z0 t0 hr h0z h0t).deriv
  have v1 : (∫ r in Ioi (0:ℝ), r ^ 1 * deriv (fun t => pg r z0 t) t0) = 0 := by
    have hreg : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 ^ 1 * pg p.1 z0 p.2) (Ioi 0 ×ˢ Metric.ball t0 ε) :=
      hpow.contDiffOn.mul (hPg.comp (by fun_prop : ContDiff ℝ ∞ fun p : ℝ × ℝ =>
        ((p.1, z0, p.2) : ℝ × ℝ × ℝ)).contDiffOn
        (fun p hp => memΩ p.1 z0 p.2 hp.1 h0z ((bz _ _ _).1 hp.2)))
    have hD := LB (fun r t => r ^ 1 * pg r z0 t) t0 ε hε hreg
      (fun r t hr h ht => by simp only [(hvan r z0 t hr h h0z ht).1, mul_zero])
    have hu := hD.unique ((hasDerivAt_const t0 (0:ℝ)).congr_of_eventuallyEq (by
      filter_upwards [Metric.ball_mem_nhds t0 hε] with x hx
      exact hmom z0 x h0z ((bz _ _ _).1 hx)))
    simp only [deriv_const_mul_field] at hu
    exact hu
  have hJ : ∀ z1, |z1 - z0| < ε / 2 →
      (∫ r in Ioi (0:ℝ), r ^ 1 * deriv (fun z => pg r z t0) z1) = 0 := by
    intro z1 hz1
    have hreg : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 ^ 1 * pg p.1 p.2 t0)
        (Ioi 0 ×ˢ Metric.ball z1 (ε / 2)) :=
      hpow.contDiffOn.mul (hPg.comp (by fun_prop : ContDiff ℝ ∞ fun p : ℝ × ℝ =>
        ((p.1, p.2, t0) : ℝ × ℝ × ℝ)).contDiffOn
        (fun p hp => memΩ p.1 p.2 t0 hp.1 (TRI _ _ ((bz _ _ _).1 hp.2) hz1) h0t))
    have hD := LB (fun r z => r ^ 1 * pg r z t0) z1 (ε / 2) (by linarith) hreg
      (fun r z hr h hz => by simp only [(hvan r z t0 hr h (TRI _ _ hz hz1) h0t).1, mul_zero])
    have hu := hD.unique ((hasDerivAt_const z1 (0:ℝ)).congr_of_eventuallyEq (by
      filter_upwards [Metric.ball_mem_nhds z1 (by linarith : (0:ℝ) < ε / 2)] with x hx
      exact hmom x t0 (TRI _ _ ((bz _ _ _).1 hx) hz1) h0t))
    simp only [deriv_const_mul_field] at hu
    exact hu
  have v5 : (∫ r in Ioi (0:ℝ), r ^ 1 * deriv (fun z => deriv (fun z' => pg r z' t0) z) z0) = 0 := by
    have hreg0 : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 ^ 1 * Q (p.1, p.2, t0))
        (Ioi 0 ×ˢ Metric.ball z0 (ε / 2)) :=
      hpow.contDiffOn.mul (hQs.comp (by fun_prop : ContDiff ℝ ∞ fun p : ℝ × ℝ =>
        ((p.1, p.2, t0) : ℝ × ℝ × ℝ)).contDiffOn
        (fun p hp => memΩ p.1 p.2 t0 hp.1 (by have := (bz _ _ _).1 hp.2; linarith) h0t))
    have hreg : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 ^ 1 * deriv (fun z' => pg p.1 z' t0) p.2)
        (Ioi 0 ×ˢ Metric.ball z0 (ε / 2)) := by
      refine hreg0.congr (fun p hp => ?_)
      have hp2 : |p.2 - z0| < ε := by have := (bz _ _ _).1 hp.2; linarith
      show p.1 ^ 1 * deriv (fun z' => pg p.1 z' t0) p.2 = p.1 ^ 1 * Q (p.1, p.2, t0)
      rw [(SDz _ hPg p.1 p.2 t0 hp.1 hp2 h0t).deriv]
    have hD := LB (fun r z => r ^ 1 * deriv (fun z' => pg r z' t0) z) z0 (ε / 2) (by linarith) hreg
      (fun r z hr h hz => by simp only [DZ0 r z hr h (by linarith), mul_zero])
    have hu := hD.unique ((hasDerivAt_const z0 (0:ℝ)).congr_of_eventuallyEq (by
      filter_upwards [Metric.ball_mem_nhds z0 (by linarith : (0:ℝ) < ε / 2)] with x hx
      exact hJ x ((bz _ _ _).1 hx)))
    simp only [deriv_const_mul_field] at hu
    exact hu
  have v3 : (∫ r in Ioi (0:ℝ), r ^ 1 * deriv (fun z => pG r z t0) z0) =
      deriv (fun z => ∫ r in Set.Ioi (0:ℝ), r ^ 1 * pG r z t0) z0 := by
    have hreg : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 ^ 1 * pG p.1 p.2 t0) (Ioi 0 ×ˢ Metric.ball z0 ε) :=
      hpow.contDiffOn.mul (hPG.comp (by fun_prop : ContDiff ℝ ∞ fun p : ℝ × ℝ =>
        ((p.1, p.2, t0) : ℝ × ℝ × ℝ)).contDiffOn
        (fun p hp => memΩ p.1 p.2 t0 hp.1 ((bz _ _ _).1 hp.2) h0t))
    have hD := LB (fun r z => r ^ 1 * pG r z t0) z0 ε hε hreg
      (fun r z hr h hz => by simp only [(hvan r z t0 hr h hz h0t).2.2, mul_zero])
    have hd := hD.deriv
    simp only [deriv_const_mul_field] at hd
    exact hd.symm
  have cF : ContDiffOn ℝ ∞ (fun r => pF r z0 t0) (Ioi 0) := SLs _ hPF
  have cψ : ContDiffOn ℝ ∞ (fun r => pg r z0 t0) (Ioi 0) := SLs _ hPg
  have cF' : ContinuousOn (deriv fun r => pF r z0 t0) (Ioi 0) :=
    cF.continuousOn_deriv_of_isOpen isOpen_Ioi (by simp)
  have cψ1 : ContDiffOn ℝ ∞ (deriv fun r => pg r z0 t0) (Ioi 0) :=
    cψ.deriv_of_isOpen isOpen_Ioi (by simp)
  have cψ2 : ContinuousOn (deriv (deriv fun r => pg r z0 t0)) (Ioi 0) :=
    cψ1.continuousOn_deriv_of_isOpen isOpen_Ioi (by simp)
  have vF : ∀ r, 0 < r → (r < a ∨ b < r) → pF r z0 t0 = 0 :=
    fun r hr h => (hvan r z0 t0 hr (h.imp le_of_lt le_of_lt) h0z h0t).2.1
  have vψ : ∀ r, 0 < r → (r < a ∨ b < r) → pg r z0 t0 = 0 :=
    fun r hr h => (hvan r z0 t0 hr (h.imp le_of_lt le_of_lt) h0z h0t).1
  have vF' := OPEN _ vF
  have vψ1 := OPEN _ vψ
  have vψ2 := OPEN _ vψ1
  have van2 : ∀ r, 0 < r → (r < a ∨ b < r) →
      r * deriv (fun r' => pF r' z0 t0) r + pF r z0 t0 = 0 := by
    intro r hr h
    rw [vF' r hr h, vF r hr h]; ring
  have van4 : ∀ r, 0 < r → (r < a ∨ b < r) →
      r * deriv (fun r' => deriv (fun r'' => pg r'' z0 t0) r') r + deriv (fun r' => pg r' z0 t0) r = 0 := by
    intro r hr h
    have e2 : deriv (fun r' => deriv (fun r'' => pg r'' z0 t0) r') r = 0 := vψ2 r hr h
    rw [e2, vψ1 r hr h]; ring
  have v2 : (∫ r in Ioi (0:ℝ), (r * deriv (fun r' => pF r' z0 t0) r + pF r z0 t0)) = 0 :=
    IBP (fun r' => pF r' z0 t0) a b ha le_rfl le_rfl
      (fun r hr => (cF.differentiableOn (by simp)).differentiableAt (isOpen_Ioi.mem_nhds hr)) cF'
      (hvan a z0 t0 ha (Or.inl le_rfl) h0z h0t).2.1 (hvan b z0 t0 (by linarith) (Or.inr le_rfl) h0z h0t).2.1
      van2
  have v4 : (∫ r in Ioi (0:ℝ), (r * deriv (fun r' => deriv (fun r'' => pg r'' z0 t0) r') r +
      deriv (fun r' => pg r' z0 t0) r)) = 0 :=
    IBP (fun r' => deriv (fun r'' => pg r'' z0 t0) r') (a / 2) (2 * b) (by linarith) (by linarith)
      (by linarith)
      (fun r hr => (cψ1.differentiableOn (by simp)).differentiableAt (isOpen_Ioi.mem_nhds hr)) cψ2
      (vψ1 (a / 2) (by linarith) (Or.inl (by linarith)))
      (vψ1 (2 * b) (by linarith) (Or.inr (by linarith))) van4
  have i1 : IntegrableOn (fun r => r ^ 1 * deriv (fun t => pg r z0 t) t0) (Ioi 0) := by
    refine INT _ ((continuous_pow 1).continuousOn.mul ?_) ?_
    · exact (SLc _ (FLD _ hPg ((0:ℝ), (0:ℝ), (1:ℝ))).continuousOn).congr
        (fun r hr => (SDt _ hPg r z0 t0 hr h0z h0t).deriv)
    · intro r hr h
      rw [LZ _ (Metric.ball t0 ε) t0 Metric.isOpen_ball (Metric.mem_ball_self hε)
        (fun y hy => (hvan r z0 y hr (h.imp le_of_lt le_of_lt) h0z ((bz _ _ _).1 hy)).1), mul_zero]
  have i2 : IntegrableOn (fun r => r * deriv (fun r' => pF r' z0 t0) r + pF r z0 t0) (Ioi 0) :=
    INT _ ((continuousOn_id.mul cF').add cF.continuousOn) van2
  have i3 : IntegrableOn (fun r => r ^ 1 * deriv (fun z => pG r z t0) z0) (Ioi 0) := by
    refine INT _ ((continuous_pow 1).continuousOn.mul ?_) ?_
    · exact (SLc _ (FLD _ hPG ((0:ℝ), (1:ℝ), (0:ℝ))).continuousOn).congr
        (fun r hr => (SDz _ hPG r z0 t0 hr h0z h0t).deriv)
    · intro r hr h
      rw [LZ _ (Metric.ball z0 ε) z0 Metric.isOpen_ball (Metric.mem_ball_self hε)
        (fun y hy => (hvan r y t0 hr (h.imp le_of_lt le_of_lt) ((bz _ _ _).1 hy) h0t).2.2), mul_zero]
  have i4 : IntegrableOn (fun r => r * deriv (fun r' => deriv (fun r'' => pg r'' z0 t0) r') r +
      deriv (fun r' => pg r' z0 t0) r) (Ioi 0) :=
    INT _ ((continuousOn_id.mul cψ2).add cψ1.continuousOn) van4
  have i5 : IntegrableOn (fun r => r ^ 1 * deriv (fun z => deriv (fun z' => pg r z' t0) z) z0) (Ioi 0) := by
    refine INT _ ((continuous_pow 1).continuousOn.mul ?_) ?_
    · exact (SLc _ (FLD _ hQs ((0:ℝ), (1:ℝ), (0:ℝ))).continuousOn).congr
        (fun r hr => hZZeq r hr)
    · intro r hr h
      rw [LZ _ (Metric.ball z0 ε) z0 Metric.isOpen_ball (Metric.mem_ball_self hε)
        (fun y hy => DZ0 r y hr (h.imp le_of_lt le_of_lt) ((bz _ _ _).1 hy)), mul_zero]
  have i6 : IntegrableOn (fun r => r ^ 1 * sb r z0 t0) (Ioi 0) :=
    INT _ ((continuous_pow 1).continuousOn.mul hsb)
      (fun r hr h => by rw [hsbv r hr (h.imp le_of_lt le_of_lt), mul_zero])
  have ADD6 : ∀ (g1 g2 g3 g4 g5 g6 : ℝ → ℝ), IntegrableOn g1 (Ioi 0) → IntegrableOn g2 (Ioi 0) →
      IntegrableOn g3 (Ioi 0) → IntegrableOn g4 (Ioi 0) → IntegrableOn g5 (Ioi 0) →
      IntegrableOn g6 (Ioi 0) →
      ∫ r in Ioi (0:ℝ), (g1 r + g2 r + g3 r - g4 r - g5 r + g6 r) =
        (∫ r in Ioi (0:ℝ), g1 r) + (∫ r in Ioi (0:ℝ), g2 r) + (∫ r in Ioi (0:ℝ), g3 r) -
          (∫ r in Ioi (0:ℝ), g4 r) - (∫ r in Ioi (0:ℝ), g5 r) + (∫ r in Ioi (0:ℝ), g6 r) := by
    intro g1 g2 g3 g4 g5 g6 h1 h2 h3 h4 h5 h6
    have a2 : IntegrableOn (fun r => g1 r + g2 r) (Ioi 0) := h1.add h2
    have a3 : IntegrableOn (fun r => g1 r + g2 r + g3 r) (Ioi 0) := a2.add h3
    have a4 : IntegrableOn (fun r => g1 r + g2 r + g3 r - g4 r) (Ioi 0) := a3.sub h4
    have a5 : IntegrableOn (fun r => g1 r + g2 r + g3 r - g4 r - g5 r) (Ioi 0) := a4.sub h5
    rw [integral_add a5 h6, integral_sub a4 h5, integral_sub a3 h4, integral_add a2 h3,
      integral_add h1 h2]
  have hpt : EqOn
      (fun r : ℝ => r ^ 1 * (deriv (fun t => pg r z0 t) t0 + (deriv (fun r' => pF r' z0 t0) r + pF r z0 t0 / r) + deriv (fun z => pG r z t0) z0 - (deriv (fun r' => deriv (fun r'' => pg r'' z0 t0) r') r + deriv (fun r' => pg r' z0 t0) r / r + deriv (fun z => deriv (fun z' => pg r z' t0) z) z0) + sb r z0 t0))
      (fun r : ℝ => r ^ 1 * deriv (fun t => pg r z0 t) t0 + (r * deriv (fun r' => pF r' z0 t0) r + pF r z0 t0) + r ^ 1 * deriv (fun z => pG r z t0) z0 - (r * deriv (fun r' => deriv (fun r'' => pg r'' z0 t0) r') r + deriv (fun r' => pg r' z0 t0) r) - r ^ 1 * deriv (fun z => deriv (fun z' => pg r z' t0) z) z0 + r ^ 1 * sb r z0 t0)
      (Ioi 0) := by
    intro r hr
    have hr0 : r ≠ 0 := ne_of_gt hr
    have e1 : r * (pF r z0 t0 / r) = pF r z0 t0 := by field_simp
    have e2 : r * (deriv (fun r' => pg r' z0 t0) r / r) = deriv (fun r' => pg r' z0 t0) r := by field_simp
    show _ = _
    linear_combination e1 - e2
  rw [setIntegral_congr_fun measurableSet_Ioi hpt, ADD6 _ _ _ _ _ _ i1 i2 i3 i4 i5 i6, v1, v2, v3, v4,
    v5, hsmom]
  ring

theorem stp5_moment_identity : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState), B.ok → qsOf l0 ≤ B.qB → IsOpen (DomC B.h (qsOf l0)) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (fun ξ => ubase B ξ a) (DomC B.h (qsOf l0))) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 S a) (DomC B.h (qsOf l0))) → (∀ a b : Fin 3, ContDiffOn ℝ ∞ (Wcov5 B G l0 S a b) (DomC B.h (qsOf l0))) → ContDiffOn ℝ ∞ (pmP5 B G l0 S) (DomC B.h (qsOf l0)) → (∀ ξ ∈ DomC B.h (qsOf l0), ∀ n m : ℤ, (∀ a : Fin 3, mcor5 B G l0 S a (shY ξ ((n : ℝ), (m : ℝ))) = mcor5 B G l0 S a ξ) ∧ (∀ a b : Fin 3, Wcov5 B G l0 S a b (shY ξ ((n : ℝ), (m : ℝ))) = Wcov5 B G l0 S a b ξ) ∧ pmP5 B G l0 S (shY ξ ((n : ℝ), (m : ℝ))) = pmP5 B G l0 S ξ) → (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → (∀ a : Fin 3, mcor5 B G l0 S a ξ = 0) ∧ (∀ a b : Fin 3, Wcov5 B G l0 S a b ξ = 0) ∧ pmP5 B G l0 S ξ = 0) → (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → radMom (mcor5 B G l0 S 1) 2 z t = 0) → (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → radMom (mcor5 B G l0 S 2) 1 z t = 0) → (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → (∫ r in Set.Ioi (0:ℝ), r ^ 2 * sBase B 1 (r, z, t, 0)) = 0 ∧ (∫ r in Set.Ioi (0:ℝ), r * sBase B 2 (r, z, t, 0)) = 0 ∧ ContinuousOn (fun r => sBase B 1 (r, z, t, 0)) (Set.Ioi 0) ∧ ContinuousOn (fun r => sBase B 2 (r, z, t, 0)) (Set.Ioi 0)) → (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → sBase B 1 ξ = 0 ∧ sBase B 2 ξ = 0) → (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → radMom (pmP5 B G l0 S) 1 z t = -(1/2) * radMom (grP5 B G l0 S) 2 z t + (1/2) * (∫ r in Set.Ioi (0:ℝ), r ^ 2 * rhoP B (r, z, t, 0)) * calP5 B G l0 S z t) → ∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → ME5 B G l0 S 2 z t = deriv (fun z' => calJth5 B G l0 S z' t) z ∧ ME5 B G l0 S 1 z t = deriv (fun z' => calJz5 B G l0 S z' t + (1/2) * (∫ r in Set.Ioi (0:ℝ), r ^ 2 * rhoP B (r, z', t, 0)) * calP5 B G l0 S z' t) z :=
by
  intro B G l0 S hB hqsB hDo hub hmc hWc hpm hPer hShell hv2 hg1 hsb hsbS hPM z0 t0 ht0 hq0
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -⟩ := hB.2.1
  have hXb : 0 < B.Xb := by linarith
  obtain ⟨-, hqCs, -⟩ := domc_open_calculus B (qsOf l0) hB

  obtain ⟨q0, hq0d⟩ : ∃ q0 : ℝ, q0 = simScale B.h z0 (1 - t0) := ⟨_, rfl⟩
  have hq0pos : 0 < q0 := by rw [hq0d]; exact (hB.1.1 z0 (1 - t0) (by linarith)).1
  have hqs : 0 < qsOf l0 := by rw [hq0d] at hq0pos; exact lt_trans hq0pos hq0
  have hV : IsOpen (DomC B.h (qsOf l0) ∩ qC B.h ⁻¹' Set.Ioi (q0 / 2)) :=
    hqCs.continuousOn.isOpen_inter_preimage hDo isOpen_Ioi
  have hξ0 : ((1:ℝ), z0, t0, (0:ℝ × ℝ)) ∈ DomC B.h (qsOf l0) := ⟨one_pos, ht0, hq0⟩
  have hξ0V : ((1:ℝ), z0, t0, (0:ℝ × ℝ)) ∈ DomC B.h (qsOf l0) ∩ qC B.h ⁻¹' Set.Ioi (q0 / 2) := by
    refine ⟨hξ0, ?_⟩
    show q0 / 2 < simScale B.h z0 (1 - t0)
    rw [← hq0d]; linarith
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hV _ hξ0V
  obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = min 1 (B.Xa * q0 / 2) := ⟨_, rfl⟩
  have ha1 : a ≤ 1 := by rw [ha_def]; exact min_le_left _ _
  have ha2 : a ≤ B.Xa * q0 / 2 := by rw [ha_def]; exact min_le_right _ _
  have ha : 0 < a := by rw [ha_def]; exact lt_min one_pos (div_pos (mul_pos hXa hq0pos) two_pos)
  obtain ⟨b, hb_def⟩ : ∃ b : ℝ, b = a + 1 + 2 * qsOf l0 * B.Xb := ⟨_, rfl⟩
  have hab : a < b := by
    rw [hb_def]; have := mul_pos (mul_pos two_pos hqs) hXb; linarith
  have hbox : ∀ z t : ℝ, |z - z0| < ε → |t - t0| < ε → t < 1 ∧ simScale B.h z (1 - t) < qsOf l0 ∧
      ∀ r : ℝ, 0 < r → (r ≤ a ∨ b ≤ r) → ∀ Y : ℝ × ℝ,
        (XC B.h (r, z, t, Y) < B.Xa ∨ B.Xb < XC B.h (r, z, t, Y)) := by
    intro z t h1 h2
    have hmemb : ((1:ℝ), z, t, (0:ℝ × ℝ)) ∈ Metric.ball ((1:ℝ), z0, t0, (0:ℝ × ℝ)) ε := by
      simp [Metric.mem_ball, Prod.dist_eq, Real.dist_eq, h1, h2, hε]
    obtain ⟨⟨-, htl, hql⟩, hqg⟩ := hball hmemb
    have ht : t < 1 := htl
    have hq : simScale B.h z (1 - t) < qsOf l0 := hql
    have hqg' : q0 / 2 < simScale B.h z (1 - t) := hqg
    have hqp : 0 < simScale B.h z (1 - t) := by linarith
    refine ⟨ht, hq, fun r hr hr' Y => ?_⟩
    have hXC : XC B.h (r, z, t, Y) = r ^ 2 / (2 * simScale B.h z (1 - t)) := rfl
    have h2q : 0 < 2 * simScale B.h z (1 - t) := by linarith
    rw [hXC]
    rcases hr' with h | h
    · left
      rw [div_lt_iff₀ h2q]
      have e1 : r ≤ 1 := le_trans h ha1
      have e2 : r ≤ B.Xa * q0 / 2 := le_trans h ha2
      have e3 : r ^ 2 ≤ r := by rw [sq]; exact mul_le_of_le_one_right hr.le e1
      have e4 : B.Xa * (q0 / 2) < B.Xa * simScale B.h z (1 - t) := mul_lt_mul_of_pos_left hqg' hXa
      have e5 : 0 < B.Xa * simScale B.h z (1 - t) := mul_pos hXa hqp
      linarith
    · right
      rw [lt_div_iff₀ h2q]
      rw [hb_def] at h
      have e0 := mul_pos (mul_pos two_pos hqs) hXb
      have e1 : 1 ≤ r := by linarith
      have e3 : r ≤ r ^ 2 := by rw [sq]; exact le_mul_of_one_le_right hr.le e1
      have e4 : B.Xb * simScale B.h z (1 - t) < B.Xb * qsOf l0 := mul_lt_mul_of_pos_left hq hXb
      linarith
  have hz00 : |z0 - z0| < ε := by simp [hε]
  have ht00 : |t0 - t0| < ε := by simp [hε]

  have hubP : ∀ (ξ : Cyl) (c : ℝ × ℝ) (i : Fin 3), ubase B (shY ξ c) i = ubase B ξ i := fun _ _ _ => rfl
  have pk_v := stp5_avg_field_pack B (qsOf l0) z0 t0 ε a b (mcor5 B G l0 S 1) hB hDo (hmc 1)
    (fun ξ hξ n m => (hPer ξ hξ n m).1 1) (fun ξ hξ hX => (hShell ξ hξ hX).1 1) hε hbox
  have pk_g := stp5_avg_field_pack B (qsOf l0) z0 t0 ε a b (mcor5 B G l0 S 2) hB hDo (hmc 2)
    (fun ξ hξ n m => (hPer ξ hξ n m).1 2) (fun ξ hξ hX => (hShell ξ hξ hX).1 2) hε hbox
  have pk_F1 := stp5_avg_field_pack B (qsOf l0) z0 t0 ε a b
    (fun η => ubase B η 0 * mcor5 B G l0 S 1 η + mcor5 B G l0 S 0 η * ubase B η 1 +
      mcor5 B G l0 S 0 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 0 1 η) hB hDo
    (((((hub 0).mul (hmc 1)).add ((hmc 0).mul (hub 1))).add ((hmc 0).mul (hmc 1))).add (hWc 0 1))
    (fun ξ hξ n m => by obtain ⟨h1, h2, -⟩ := hPer ξ hξ n m; simp only [hubP, h1, h2])
    (fun ξ hξ hX => by obtain ⟨h1, h2, -⟩ := hShell ξ hξ hX; simp [h1, h2]) hε hbox
  have pk_F2 := stp5_avg_field_pack B (qsOf l0) z0 t0 ε a b
    (fun η => ubase B η 2 * mcor5 B G l0 S 1 η + ubase B η 1 * mcor5 B G l0 S 2 η +
      mcor5 B G l0 S 2 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 2 1 η) hB hDo
    (((((hub 2).mul (hmc 1)).add ((hub 1).mul (hmc 2))).add ((hmc 2).mul (hmc 1))).add (hWc 2 1))
    (fun ξ hξ n m => by obtain ⟨h1, h2, -⟩ := hPer ξ hξ n m; simp only [hubP, h1, h2])
    (fun ξ hξ hX => by obtain ⟨h1, h2, -⟩ := hShell ξ hξ hX; simp [h1, h2]) hε hbox
  have pk_F3 := stp5_avg_field_pack B (qsOf l0) z0 t0 ε a b
    (fun η => ubase B η 0 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 0 η * ubase B η 2 +
      mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 0 2 η) hB hDo
    (((((hub 0).mul (hmc 2)).add ((hmc 0).mul (hub 2))).add ((hmc 0).mul (hmc 2))).add (hWc 0 2))
    (fun ξ hξ n m => by obtain ⟨h1, h2, -⟩ := hPer ξ hξ n m; simp only [hubP, h1, h2])
    (fun ξ hξ hX => by obtain ⟨h1, h2, -⟩ := hShell ξ hξ hX; simp [h1, h2]) hε hbox
  have hA4s : ContDiffOn ℝ ∞ (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η ^ 2 +
      Wcov5 B G l0 S 2 2 η) (DomC B.h (qsOf l0)) :=
    (((contDiffOn_const.mul (hub 2)).mul (hmc 2)).add ((hmc 2).pow 2)).add (hWc 2 2)
  have pk_F4 := stp5_avg_field_pack B (qsOf l0) z0 t0 ε a b
    (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η ^ 2 +
      Wcov5 B G l0 S 2 2 η + pmP5 B G l0 S η) hB hDo (hA4s.add hpm)
    (fun ξ hξ n m => by obtain ⟨h1, h2, h3⟩ := hPer ξ hξ n m; simp only [hubP, h1, h2, h3])
    (fun ξ hξ hX => by obtain ⟨h1, h2, h3⟩ := hShell ξ hξ hX; simp [h1, h2, h3]) hε hbox
  have pk_A4 := stp5_avg_field_pack B (qsOf l0) z0 t0 ε a b
    (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η ^ 2 +
      Wcov5 B G l0 S 2 2 η) hB hDo hA4s
    (fun ξ hξ n m => by obtain ⟨h1, h2, -⟩ := hPer ξ hξ n m; simp only [hubP, h1, h2])
    (fun ξ hξ hX => by obtain ⟨h1, h2, -⟩ := hShell ξ hξ hX; simp [h1, h2]) hε hbox
  have pk_P := stp5_avg_field_pack B (qsOf l0) z0 t0 ε a b (pmP5 B G l0 S) hB hDo hpm
    (fun ξ hξ n m => (hPer ξ hξ n m).2.2) (fun ξ hξ hX => (hShell ξ hξ hX).2.2) hε hbox

  have hsb0 := hsb z0 t0 ht0 hq0
  have hsbv : ∀ r : ℝ, 0 < r → (r ≤ a ∨ b ≤ r) → sBase B 1 (r, z0, t0, 0) = 0 ∧ sBase B 2 (r, z0, t0, 0) = 0 :=
    fun r hr h => hsbS _ ⟨hr, ht0, hq0⟩
      (Or.imp le_of_lt le_of_lt ((hbox z0 t0 hz00 ht00).2.2 r hr h 0))
  have hFE2 : ∀ ξ, FE5 B G l0 S 2 ξ = yAvg (EthP5 B G l0 S) ξ := fun ξ => by simp [FE5]
  have hFE1 : ∀ ξ, FE5 B G l0 S 1 ξ = yAvg (EzP5 B G l0 S) ξ := fun ξ => by simp [FE5]
  have hEth := stp5_yavg_Eth_expand B G l0 S hDo hub hmc hWc
    (fun ξ hξ n m => ⟨(hPer ξ hξ n m).1, (hPer ξ hξ n m).2.1⟩)
  have hEz := stp5_yavg_Ez_expand B G l0 S hDo hub hmc hWc hpm hPer

  have key2 : ME5 B G l0 S 2 z0 t0 = deriv (fun z => ∫ r in Set.Ioi (0:ℝ), r ^ 2 *
      yAvg (fun η => ubase B η 2 * mcor5 B G l0 S 1 η + ubase B η 1 * mcor5 B G l0 S 2 η +
        mcor5 B G l0 S 2 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 2 1 η) (r, z, t0, 0)) z0 := by
    refine Eq.trans ?_ (stp5_moment_assembly_th
      (fun r z t => yAvg (mcor5 B G l0 S 1) (r, z, t, 0))
      (fun r z t => yAvg (fun η => ubase B η 0 * mcor5 B G l0 S 1 η + mcor5 B G l0 S 0 η * ubase B η 1 +
        mcor5 B G l0 S 0 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 0 1 η) (r, z, t, 0))
      (fun r z t => yAvg (fun η => ubase B η 2 * mcor5 B G l0 S 1 η + ubase B η 1 * mcor5 B G l0 S 2 η +
        mcor5 B G l0 S 2 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 2 1 η) (r, z, t, 0))
      (fun r z t => sBase B 1 (r, z, t, 0)) z0 t0 ε a b ha hab hε pk_v.1 pk_F1.1 pk_F2.1 hsb0.2.2.1
      (fun r z t hr h h1 h2 => ⟨pk_v.2 r z t hr h h1 h2, pk_F1.2 r z t hr h h1 h2, pk_F2.2 r z t hr h h1 h2⟩)
      (fun r hr h => (hsbv r hr h).1)
      (fun z t h1 h2 => hv2 z t (hbox z t h1 h2).1 (hbox z t h1 h2).2.1) hsb0.1)
    unfold ME5
    refine setIntegral_congr_fun measurableSet_Ioi (fun r hr => ?_)
    show r ^ 2 * FE5 B G l0 S 2 (r, z0, t0, 0) = _
    rw [hFE2]
    exact congrArg (fun x => r ^ 2 * x) (hEth _ ⟨hr, ht0, hq0⟩)

  have key1 : ME5 B G l0 S 1 z0 t0 = deriv (fun z => ∫ r in Set.Ioi (0:ℝ), r ^ 1 *
      yAvg (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η ^ 2 +
        Wcov5 B G l0 S 2 2 η + pmP5 B G l0 S η) (r, z, t0, 0)) z0 := by
    refine Eq.trans ?_ (stp5_moment_assembly_z
      (fun r z t => yAvg (mcor5 B G l0 S 2) (r, z, t, 0))
      (fun r z t => yAvg (fun η => ubase B η 0 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 0 η * ubase B η 2 +
        mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 0 2 η) (r, z, t, 0))
      (fun r z t => yAvg (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η ^ 2 +
        Wcov5 B G l0 S 2 2 η + pmP5 B G l0 S η) (r, z, t, 0))
      (fun r z t => sBase B 2 (r, z, t, 0)) z0 t0 ε a b ha hab hε pk_g.1 pk_F3.1 pk_F4.1 hsb0.2.2.2
      (fun r z t hr h h1 h2 => ⟨pk_g.2 r z t hr h h1 h2, pk_F3.2 r z t hr h h1 h2, pk_F4.2 r z t hr h h1 h2⟩)
      (fun r hr h => (hsbv r hr h).2)
      (fun z t h1 h2 => hg1 z t (hbox z t h1 h2).1 (hbox z t h1 h2).2.1)
      (by simpa only [pow_one] using hsb0.2.1))
    unfold ME5
    refine setIntegral_congr_fun measurableSet_Ioi (fun r hr => ?_)
    show r ^ 1 * FE5 B G l0 S 1 (r, z0, t0, 0) = _
    rw [hFE1]
    exact congrArg (fun x => r ^ 1 * x) (hEz _ ⟨hr, ht0, hq0⟩)

  have fibInt : ∀ (f : Cyl → ℝ), ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) → ∀ r z t : ℝ, 0 < r → t < 1 →
      simScale B.h z (1 - t) < qsOf l0 →
      IntegrableOn (fun Y : ℝ × ℝ => f (r, z, t, Y)) (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := by
    intro f hf r z t hr ht hq
    apply ContinuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
    refine hf.continuousOn.comp (by fun_prop) ?_
    intro Y _
    exact ⟨hr, ht, hq⟩
  have radInt : ∀ f : ℝ → ℝ, ContinuousOn f (Set.Ioi 0) → (∀ r, 0 < r → (r ≤ a ∨ b ≤ r) → f r = 0) →
      IntegrableOn f (Set.Ioi 0) := by
    intro f hf h0
    have hI : IntegrableOn f (Set.Icc a b) :=
      (hf.mono (fun x hx => lt_of_lt_of_le ha hx.1)).integrableOn_Icc
    refine hI.of_forall_sdiff_eq_zero measurableSet_Ioi ?_
    intro x hx
    apply h0 x hx.1
    by_contra hcon
    push_neg at hcon
    exact hx.2 ⟨hcon.1.le, hcon.2.le⟩
  have rcont : ∀ f : Cyl → ℝ, ContDiffOn ℝ ∞ (fun p : ℝ × ℝ × ℝ => yAvg f (p.1, p.2.1, p.2.2, 0))
      (Set.Ioi 0 ×ˢ (Metric.ball z0 ε ×ˢ Metric.ball t0 ε)) → ∀ z, |z - z0| < ε →
      ContinuousOn (fun r => yAvg f (r, z, t0, 0)) (Set.Ioi 0) := by
    intro f hf z hz
    have hc : ContinuousOn (fun r : ℝ => ((r, z, t0) : ℝ × ℝ × ℝ)) (Set.Ioi 0) :=
      (continuous_id.prodMk continuous_const).continuousOn
    refine hf.continuousOn.comp hc ?_
    intro r hr
    exact ⟨hr, (show dist z z0 < ε by rw [Real.dist_eq]; exact hz), Metric.mem_ball_self hε⟩

  have hev : (fun z => ∫ r in Set.Ioi (0:ℝ), r ^ 1 *
      yAvg (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η ^ 2 +
        Wcov5 B G l0 S 2 2 η + pmP5 B G l0 S η) (r, z, t0, 0)) =ᶠ[nhds z0]
      (fun z' => calJz5 B G l0 S z' t0 + (1/2) * (∫ r in Set.Ioi (0:ℝ), r ^ 2 * rhoP B (r, z', t0, 0)) *
        calP5 B G l0 S z' t0) := by
    refine Filter.eventuallyEq_of_mem (Metric.ball_mem_nhds z0 hε) ?_
    intro z hz
    have hz' : |z - z0| < ε := by rw [Metric.mem_ball, Real.dist_eq] at hz; exact hz
    obtain ⟨ht, hqz, -⟩ := hbox z t0 hz' ht00
    have hsplit : ∀ r ∈ Set.Ioi (0:ℝ), r ^ 1 *
        yAvg (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η ^ 2 +
          Wcov5 B G l0 S 2 2 η + pmP5 B G l0 S η) (r, z, t0, 0) =
        r ^ 1 * yAvg (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η ^ 2 +
          Wcov5 B G l0 S 2 2 η) (r, z, t0, 0) + r ^ 1 * yAvg (pmP5 B G l0 S) (r, z, t0, 0) := by
      intro r hr
      rw [← mul_add]
      congr 1
      exact integral_add (fibInt _ hA4s r z t0 hr ht hqz) (fibInt _ hpm r z t0 hr ht hqz)
    have iA := radInt (fun r => r ^ 1 * yAvg (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η +
        mcor5 B G l0 S 2 η ^ 2 + Wcov5 B G l0 S 2 2 η) (r, z, t0, 0))
      ((continuous_pow 1).continuousOn.mul (rcont _ pk_A4.1 z hz'))
      (fun r hr h => by simp only [pk_A4.2 r z t0 hr h hz' ht00, mul_zero])
    have iP := radInt (fun r => r ^ 1 * yAvg (pmP5 B G l0 S) (r, z, t0, 0))
      ((continuous_pow 1).continuousOn.mul (rcont _ pk_P.1 z hz'))
      (fun r hr h => by simp only [pk_P.2 r z t0 hr h hz' ht00, mul_zero])
    show (∫ r in Set.Ioi (0:ℝ), r ^ 1 *
      yAvg (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η ^ 2 +
        Wcov5 B G l0 S 2 2 η + pmP5 B G l0 S η) (r, z, t0, 0)) = calJz5 B G l0 S z t0 + _
    rw [setIntegral_congr_fun measurableSet_Ioi hsplit, integral_add iA iP]
    have hp := hPM z t0 ht hqz
    unfold radMom at hp
    rw [hp]
    unfold calJz5 radMom
    ring
  refine ⟨key2, ?_⟩
  rw [key1]
  exact hev.deriv_eq

theorem stp5_ins_mul : ∀ (B : BG) (qs α β : ℝ) (F G : ℝ × ℝ → ℝ), B.ok → InS B qs α F → InS B qs β G → InS B qs (α + β) (fun w => F w * G w) :=
by
  intro B qs α β F G hB hF hG
  obtain ⟨hFs, hFb⟩ := hF
  obtain ⟨hGs, hGb⟩ := hG

  have hDo : IsOpen {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} := by
    have hs : IsOpen {w : ℝ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
    have hφ : Continuous (fun w : ℝ × ℝ => (w.1, 1 - w.2)) :=
      continuous_fst.prodMk (continuous_const.sub continuous_snd)
    have hS : ContinuousOn (fun v : ℝ × ℝ => simScale B.h v.1 v.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hB.1.2.2.2.1.continuousOn
    have hg : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2)) {w : ℝ × ℝ | w.2 < 1} :=
      hS.comp hφ.continuousOn (fun w hw => by
        have hw' : w.2 < 1 := hw
        exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - w.2 by linarith⟩)
    exact hg.isOpen_inter_preimage hs isOpen_Iio

  have leib : ∀ (L : ℝ × ℝ →L[ℝ] ℝ × ℝ) (ξ : ℝ × ℝ) (U : Set (ℝ × ℝ)) (n : ℕ),
      IsOpen U → ξ ∈ U → ∀ (f g : ℝ × ℝ → ℝ), ContDiffOn ℝ n f U → ContDiffOn ℝ n g U →
      ‖(iteratedFDeriv ℝ n (fun η => f η * g η) ξ).compContinuousLinearMap (fun _ => L)‖ ≤
        ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
          ‖(iteratedFDeriv ℝ i f ξ).compContinuousLinearMap (fun _ => L)‖ *
          ‖(iteratedFDeriv ℝ (n - i) g ξ).compContinuousLinearMap (fun _ => L)‖ := by
    intro L ξ U n hU hξ f g hf hg
    obtain ⟨s, hs_def⟩ : ∃ s : Set (ℝ × ℝ), s = (fun z : ℝ × ℝ => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
    have h0s : (0 : ℝ × ℝ) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : ℝ × ℝ) ∈ ⇑L ⁻¹' s := hL0s
    have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : ℝ × ℝ → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + z)) s := by
      intro W _ _ F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : ℝ × ℝ → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
      intro W _ _ F hF
      exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
    have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : ℝ × ℝ → W),
        ContDiffOn ℝ n F U → ∀ i : ℕ, i ≤ n →
        iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
          (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
      intro W _ _ F hF i hi
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
      calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
              (fun _ => L) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
              (fun _ => L) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
              (fun _ => L) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
    have hfg : ContDiffOn ℝ n (fun η => f η * g η) U := hf.mul hg
    have hl := norm_iteratedFDerivWithin_smul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
      (n := n) le_rfl
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) • g (ξ + L y)) n hO h0O] at hl
    rw [← key _ hfg n le_rfl]
    calc ‖iteratedFDeriv ℝ n (fun z => (fun η => f η * g η) (ξ + L z)) 0‖
        = ‖iteratedFDeriv ℝ n (fun y => f (ξ + L y) • g (ξ + L y)) 0‖ := rfl
      _ ≤ _ := hl
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (n - i) hO h0O,
          key f hf i hik, key g hg (n - i) (Nat.sub_le n i)]

  choose CF bF hCF using hFb
  choose CG bG hCG using hGb
  refine ⟨hFs.mul hGs, fun k => ?_⟩
  obtain ⟨Cs, hCs⟩ : ∃ Cs : ℝ, Cs = ∑ i ∈ Finset.range (k + 1), (|CF i| + |CG i|) := ⟨_, rfl⟩
  obtain ⟨bs, hbs⟩ : ∃ bs : ℝ, bs = ∑ i ∈ Finset.range (k + 1), (|bF i| + |bG i|) := ⟨_, rfl⟩
  have hCi : ∀ i, i ≤ k → |CF i| ≤ Cs ∧ |CG i| ≤ Cs := by
    intro i hi
    have hmem : i ∈ Finset.range (k + 1) := Finset.mem_range.mpr (Nat.lt_succ_of_le hi)
    have h1 : |CF i| + |CG i| ≤ Cs := by
      rw [hCs]
      exact Finset.single_le_sum (f := fun j => |CF j| + |CG j|)
        (fun j _ => add_nonneg (abs_nonneg _) (abs_nonneg _)) hmem
    exact ⟨by linarith [abs_nonneg (CG i)], by linarith [abs_nonneg (CF i)]⟩
  have hbi : ∀ i, i ≤ k → bF i ≤ bs ∧ bG i ≤ bs := by
    intro i hi
    have hmem : i ∈ Finset.range (k + 1) := Finset.mem_range.mpr (Nat.lt_succ_of_le hi)
    have h1 : |bF i| + |bG i| ≤ bs := by
      rw [hbs]
      exact Finset.single_le_sum (f := fun j => |bF j| + |bG j|)
        (fun j _ => add_nonneg (abs_nonneg _) (abs_nonneg _)) hmem
    exact ⟨by linarith [abs_nonneg (bG i), le_abs_self (bF i)],
      by linarith [abs_nonneg (bF i), le_abs_self (bG i)]⟩
  have hCs0 : 0 ≤ Cs := le_trans (abs_nonneg _) (hCi 0 (Nat.zero_le k)).1

  have bnd : ∀ (q C b x N : ℝ), 0 < q → b ≤ bs → |C| ≤ Cs →
      N ≤ C * q ^ x * (1 + |Real.log q|) ^ (2 * b) →
      N ≤ Cs * q ^ x * (1 + |Real.log q|) ^ (2 * bs) := by
    intro q C b x N hq0 hb hC hN
    have hLg1 : (1:ℝ) ≤ 1 + |Real.log q| := by linarith [abs_nonneg (Real.log q)]
    have hqx : 0 ≤ q ^ x := Real.rpow_nonneg hq0.le x
    have hL1 : (1 + |Real.log q|) ^ (2 * b) ≤ (1 + |Real.log q|) ^ (2 * bs) :=
      Real.rpow_le_rpow_of_exponent_le hLg1 (by linarith)
    have hL0 : 0 ≤ (1 + |Real.log q|) ^ (2 * b) := Real.rpow_nonneg (by linarith) _
    calc N ≤ C * q ^ x * (1 + |Real.log q|) ^ (2 * b) := hN
      _ ≤ |C| * q ^ x * (1 + |Real.log q|) ^ (2 * b) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_abs_self C) hqx) hL0
      _ ≤ Cs * q ^ x * (1 + |Real.log q|) ^ (2 * bs) :=
          mul_le_mul (mul_le_mul_of_nonneg_right hC hqx) hL1 hL0 (mul_nonneg hCs0 hqx)
  refine ⟨2 ^ k * Cs ^ 2, 2 * bs, fun w hw1 hw2 => ?_⟩
  have hq0 : 0 < simScale B.h w.1 (1 - w.2) := (hB.1.1 w.1 (1 - w.2) (by linarith)).1
  have hFi := fun i (hi : i ≤ k) =>
    bnd _ (CF i) (bF i) _ _ hq0 (hbi i hi).1 (hCi i hi).1 (hCF i w hw1 hw2)
  have hGi := fun i (hi : i ≤ k) =>
    bnd _ (CG i) (bG i) _ _ hq0 (hbi i hi).2 (hCi i hi).2 (hCG i w hw1 hw2)

  refine le_trans (leib _ w _ k hDo ⟨hw1, hw2⟩ F G (hFs.of_le (by exact_mod_cast le_top))
    (hGs.of_le (by exact_mod_cast le_top))) ?_
  set q := simScale B.h w.1 (1 - w.2) with hq
  set Lg := 1 + |Real.log q| with hLg
  have hLg0 : 0 < Lg := by rw [hLg]; linarith [abs_nonneg (Real.log q)]
  have hA0 : 0 ≤ Cs * q ^ (B.h * α) * Lg ^ (2 * bs) :=
    mul_nonneg (mul_nonneg hCs0 (Real.rpow_nonneg hq0.le _)) (Real.rpow_nonneg hLg0.le _)
  calc _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (Cs * q ^ (B.h * α) * Lg ^ (2 * bs)) *
          (Cs * q ^ (B.h * β) * Lg ^ (2 * bs)) := by
        apply Finset.sum_le_sum
        intro i hi
        have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        exact mul_le_mul (mul_le_mul_of_nonneg_left (hFi i hik) (Nat.cast_nonneg _))
          (hGi _ (Nat.sub_le k i)) (norm_nonneg _) (mul_nonneg (Nat.cast_nonneg _) hA0)
    _ = (Cs * q ^ (B.h * α) * Lg ^ (2 * bs)) * (Cs * q ^ (B.h * β) * Lg ^ (2 * bs)) *
          ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) := by
        rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro i _; ring
    _ = 2 ^ k * Cs ^ 2 * q ^ (B.h * (α + β)) * Lg ^ (2 * (2 * bs)) := by
        have hs : ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) = 2 ^ k := by
          exact_mod_cast Nat.sum_range_choose k
        rw [hs, show B.h * (α + β) = B.h * α + B.h * β by ring,
          show 2 * (2 * bs) = 2 * bs + 2 * bs by ring, Real.rpow_add hq0, Real.rpow_add hLg0]
        ring

theorem stp5_ins_qpow : ∀ (B : BG) (qs : ℝ), B.ok → 0 < qs → qs ≤ 1 → (∀ (p : ℝ) (k : ℕ), ∃ C : ℝ, ∀ z τ : ℝ, 0 < τ → simScale B.h z τ ≤ 1 → ‖(iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale B.h w.1 w.2 ^ p) (z, τ)).compContinuousLinearMap (fun _ => (simScale B.h z τ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap (simScale B.h z τ • ContinuousLinearMap.id ℝ ℝ))‖ ≤ C * simScale B.h z τ ^ p) → ∀ p : ℝ, InS B qs (p / B.h) (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2) ^ p) :=
by
  intro B qs hB hqs0 hqs1 hS8 p
  have hS : SimScaleProps B.h := hB.1
  have hh : 0 < B.h := hB.2.1.1
  have hne : B.h ≠ 0 := hh.ne'

  have key : ∀ (F : ℝ × ℝ → ℝ) (V : Set (ℝ × ℝ)) (a : ℝ × ℝ) (T : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)),
      IsOpen V → ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set (ℝ × ℝ), s = (fun z : ℝ × ℝ => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : ℝ × ℝ) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : ℝ × ℝ) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]
  have hW : IsOpen (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
  have hSp : ContDiffOn ℝ ∞ (fun v : ℝ × ℝ => simScale B.h v.1 v.2 ^ p) (Set.univ ×ˢ Set.Ioi 0) :=
    hS.2.2.2.1.rpow_const_of_ne (fun v hv => (hS.1 v.1 v.2 hv.2).1.ne')
  have hφ : ContDiff ℝ ∞ (fun w : ℝ × ℝ => ((w.1, 1 - w.2) : ℝ × ℝ)) :=
    contDiff_fst.prodMk (contDiff_const.sub contDiff_snd)
  refine ⟨?_, fun k => ?_⟩
  · exact hSp.comp hφ.contDiffOn (fun w hw =>
      ⟨Set.mem_univ _, show (0:ℝ) < 1 - w.2 by linarith [hw.1]⟩)
  · obtain ⟨C, hC⟩ := hS8 p k
    refine ⟨C, 0, fun w hw1 hw2 => ?_⟩
    have ht : (0:ℝ) < 1 - w.2 := by linarith
    have hq1 : simScale B.h w.1 (1 - w.2) ≤ 1 := le_trans hw2.le hqs1

    obtain ⟨P, hPdef⟩ : ∃ P : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ),
        P = (ContinuousLinearMap.id ℝ ℝ).prodMap (-ContinuousLinearMap.id ℝ ℝ) := ⟨_, rfl⟩
    have hPapp : ∀ v : ℝ × ℝ, P v = (v.1, -v.2) := by
      intro v; rw [hPdef]; rfl
    have hP1 : ‖P‖ ≤ 1 := by
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun v => ?_)
      rw [hPapp v, one_mul, Prod.norm_def (v.1, -v.2), Prod.norm_def v]
      exact max_le (le_max_left _ _) ((norm_neg v.2).trans_le (le_max_right _ _))
    obtain ⟨a, hadef⟩ : ∃ a : ℝ × ℝ, a = (w.1, 1 - w.2) := ⟨_, rfl⟩
    have ha : a ∈ (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := by
      rw [hadef]; exact ⟨Set.mem_univ _, ht⟩

    have hD : iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2) ^ p) w =
        (iteratedFDeriv ℝ k (fun v : ℝ × ℝ => simScale B.h v.1 v.2 ^ p) a).compContinuousLinearMap
          (fun _ => P) := by
      calc iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2) ^ p) w
          = iteratedFDeriv ℝ k (fun v : ℝ × ℝ => simScale B.h (w + v).1 (1 - (w + v).2) ^ p) 0 := by
            have e1 := iteratedFDeriv_comp_add_left (𝕜 := ℝ)
              (f := fun u : ℝ × ℝ => simScale B.h u.1 (1 - u.2) ^ p) k w 0
            rw [add_zero] at e1
            exact e1.symm
        _ = iteratedFDeriv ℝ k (fun v : ℝ × ℝ => simScale B.h (a + P v).1 (a + P v).2 ^ p) 0 := by
            congr 1
            funext v
            rw [hPapp v, hadef]
            show simScale B.h (w.1 + v.1) (1 - (w.2 + v.2)) ^ p =
              simScale B.h (w.1 + v.1) ((1 - w.2) + -v.2) ^ p
            rw [show (1:ℝ) - (w.2 + v.2) = (1 - w.2) + -v.2 by ring]
        _ = (iteratedFDeriv ℝ k (fun v : ℝ × ℝ => simScale B.h v.1 v.2 ^ p) a).compContinuousLinearMap
              (fun _ => P) := key (fun v : ℝ × ℝ => simScale B.h v.1 v.2 ^ p) _ a P hW hSp ha k

    obtain ⟨M, hMdef⟩ : ∃ M : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ),
        M = (simScale B.h w.1 (1 - w.2) ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
          (simScale B.h w.1 (1 - w.2) • ContinuousLinearMap.id ℝ ℝ) := ⟨_, rfl⟩
    have hPM : ∀ v : ℝ × ℝ, P (M v) = M (P v) := by
      intro v
      rw [hMdef]
      simp [hPapp, ContinuousLinearMap.coe_prodMap']
    have hcomm : ((iteratedFDeriv ℝ k (fun v : ℝ × ℝ => simScale B.h v.1 v.2 ^ p) a).compContinuousLinearMap
          (fun _ => P)).compContinuousLinearMap (fun _ => M) =
        ((iteratedFDeriv ℝ k (fun v : ℝ × ℝ => simScale B.h v.1 v.2 ^ p) a).compContinuousLinearMap
          (fun _ => M)).compContinuousLinearMap (fun _ => P) := by
      ext m
      simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply, hPM]
    have hCi : ‖(iteratedFDeriv ℝ k (fun v : ℝ × ℝ => simScale B.h v.1 v.2 ^ p) a).compContinuousLinearMap
        (fun _ => M)‖ ≤ C * simScale B.h w.1 (1 - w.2) ^ p := by
      rw [hMdef, hadef]; exact hC w.1 (1 - w.2) ht hq1
    have hprod : ∏ i : Fin k, ‖P‖ ≤ 1 := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_one₀ (norm_nonneg _) hP1
    have hb1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
      ((iteratedFDeriv ℝ k (fun v : ℝ × ℝ => simScale B.h v.1 v.2 ^ p) a).compContinuousLinearMap
        (fun _ => M)) (fun _ : Fin k => P)
    have he : B.h * (p / B.h) = p := by field_simp
    rw [he, mul_zero, Real.rpow_zero, mul_one, hD, ← hMdef, hcomm]
    exact hb1.trans ((mul_le_of_le_one_right (norm_nonneg _) hprod).trans hCi)

theorem stp5_ins_dz : ∀ (B : BG) (qs α : ℝ) (F : ℝ × ℝ → ℝ), B.ok → InS B qs α F → InS B qs (α + 1 - 1 / (2 * B.h)) (fun w => fderiv ℝ F w (1, 0)) :=
by
  intro B qs α F hB hF
  obtain ⟨hFs, hFb⟩ := hF
  have hh : 0 < B.h := hB.2.1.1
  have hh0 : B.h ≠ 0 := hh.ne'
  have hS : SimScaleProps B.h := hB.1

  have hD : IsOpen {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} := by
    have hT : IsOpen {w : ℝ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
    have hg : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2)) {w : ℝ × ℝ | w.2 < 1} := by
      have h1 : ContinuousOn (fun v : ℝ × ℝ => simScale B.h v.1 v.2) (univ ×ˢ Ioi 0) :=
        hS.2.2.2.1.continuousOn
      have h2 : ContinuousOn (fun w : ℝ × ℝ => (w.1, 1 - w.2)) {w : ℝ × ℝ | w.2 < 1} :=
        (continuous_fst.prodMk (continuous_const.sub continuous_snd)).continuousOn
      exact h1.comp h2 (fun w hw => ⟨mem_univ _, show (0:ℝ) < 1 - w.2 from sub_pos.mpr hw⟩)
    exact hg.isOpen_inter_preimage hT isOpen_Iio

  have hFd : ContDiffOn ℝ ∞ (fderiv ℝ F) {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} :=
    hFs.fderiv_of_isOpen hD (by exact_mod_cast le_top)
  refine ⟨hFd.clm_apply contDiffOn_const, fun k => ?_⟩

  obtain ⟨C, b, hC⟩ := hFb (k + 1)
  refine ⟨C, b, fun w hw1 hw2 => ?_⟩
  have hwD : w ∈ {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} := ⟨hw1, hw2⟩
  have hFdw : ContDiffAt ℝ ∞ (fderiv ℝ F) w := hFd.contDiffAt (hD.mem_nhds hwD)
  have hCw := hC w hw1 hw2
  have hq : 0 < simScale B.h w.1 (1 - w.2) := (hS.1 w.1 (1 - w.2) (by linarith)).1
  set q := simScale B.h w.1 (1 - w.2) with hqdef
  set Λ : ℝ × ℝ →L[ℝ] ℝ × ℝ :=
    (q ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap (q • ContinuousLinearMap.id ℝ ℝ) with hΛ

  have nbdir : ∀ v : ℝ × ℝ,
      ‖(iteratedFDeriv ℝ k (fun y => fderiv ℝ F y (Λ v)) w).compContinuousLinearMap (fun _ => Λ)‖ ≤
        ‖v‖ * ‖(iteratedFDeriv ℝ (k+1) F w).compContinuousLinearMap (fun _ => Λ)‖ := by
    intro v
    have hcomp : (fun y => fderiv ℝ F y (Λ v)) =
        (ContinuousLinearMap.apply ℝ ℝ (Λ v)) ∘ (fderiv ℝ F) := by
      funext y; rfl
    have hit : iteratedFDeriv ℝ k (fun y => fderiv ℝ F y (Λ v)) w =
        (ContinuousLinearMap.apply ℝ ℝ (Λ v)).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fderiv ℝ F) w) := by
      rw [hcomp]
      exact ContinuousLinearMap.iteratedFDeriv_comp_left _ hFdw (by exact_mod_cast le_top)
    have hN0 : 0 ≤ ‖(iteratedFDeriv ℝ (k+1) F w).compContinuousLinearMap (fun _ => Λ)‖ :=
      norm_nonneg _
    rw [hit]
    apply ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg (norm_nonneg _) hN0)
    intro m
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      ContinuousLinearMap.apply_apply]
    have key : (iteratedFDeriv ℝ k (fderiv ℝ F) w (fun i => Λ (m i))) (Λ v) =
        ((iteratedFDeriv ℝ (k+1) F w).compContinuousLinearMap (fun _ => Λ))
          (Fin.snoc (α := fun _ => ℝ × ℝ) m v) := by
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_succ_apply_right]
      have e1' : Fin.init (fun i : Fin (k+1) => Λ (Fin.snoc (α := fun _ => ℝ × ℝ) m v i)) =
          fun i => Λ (m i) := by
        funext i
        simp [Fin.init, Fin.snoc_castSucc]
      rw [e1']
      simp only [Fin.snoc_last]
    rw [key]
    have hprod : ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => ℝ × ℝ) m v i‖ =
        (∏ i : Fin k, ‖m i‖) * ‖v‖ := by
      rw [Fin.prod_univ_castSucc]
      simp [Fin.snoc_castSucc, Fin.snoc_last]
    calc _ ≤ ‖(iteratedFDeriv ℝ (k+1) F w).compContinuousLinearMap (fun _ => Λ)‖ *
          ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => ℝ × ℝ) m v i‖ :=
          ContinuousMultilinearMap.le_opNorm _ _
      _ = ‖v‖ * ‖(iteratedFDeriv ℝ (k+1) F w).compContinuousLinearMap (fun _ => Λ)‖ *
          ∏ i : Fin k, ‖m i‖ := by rw [hprod]; ring
  have hc0 : 0 ≤ q ^ (-(1/2 - B.h)) := Real.rpow_nonneg hq.le _
  have hΛv : Λ (q ^ (-(1/2 - B.h)), (0:ℝ)) = ((1:ℝ), (0:ℝ)) := by
    rw [hΛ]
    refine Prod.ext ?_ ?_
    · simp only [ContinuousLinearMap.coe_prodMap', Prod.map_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.id_apply, smul_eq_mul]
      rw [← Real.rpow_add hq, add_neg_cancel, Real.rpow_zero]
    · simp [ContinuousLinearMap.coe_prodMap']
  have nv : ‖((q ^ (-(1/2 - B.h)), (0:ℝ)) : ℝ × ℝ)‖ ≤ q ^ (-(1/2 - B.h)) := by
    simp only [Prod.norm_mk, norm_zero, Real.norm_eq_abs, abs_of_nonneg hc0]
    exact max_le le_rfl hc0
  have h1 := nbdir (q ^ (-(1/2 - B.h)), (0:ℝ))
  rw [hΛv] at h1
  have e2 : B.h * (1 / (2 * B.h)) = 1 / 2 := by field_simp
  have hexp : q ^ (-(1/2 - B.h)) * q ^ (B.h * α) = q ^ (B.h * (α + 1 - 1 / (2 * B.h))) := by
    rw [← Real.rpow_add hq]
    congr 1
    linear_combination e2
  refine le_trans h1 ?_
  calc ‖((q ^ (-(1/2 - B.h)), (0:ℝ)) : ℝ × ℝ)‖ *
        ‖(iteratedFDeriv ℝ (k+1) F w).compContinuousLinearMap (fun _ => Λ)‖
      ≤ q ^ (-(1/2 - B.h)) * ‖(iteratedFDeriv ℝ (k+1) F w).compContinuousLinearMap (fun _ => Λ)‖ :=
        mul_le_mul_of_nonneg_right nv (norm_nonneg _)
    _ ≤ q ^ (-(1/2 - B.h)) * (C * q ^ (B.h * α) * (1 + |Real.log q|) ^ (2 * b)) :=
        mul_le_mul_of_nonneg_left hCw hc0
    _ = C * q ^ (B.h * (α + 1 - 1 / (2 * B.h))) * (1 + |Real.log q|) ^ (2 * b) := by
        rw [← hexp]; ring

theorem stp5_ins_dz_gain : ∀ (B : BG) (qs α a : ℝ) (K : ℝ × ℝ → ℝ), B.ok → 0 < qs → qs ≤ 1 → (∀ (α β : ℝ) (F G : ℝ × ℝ → ℝ), InS B qs α F → InS B qs β G → InS B qs (α + β) (fun w => F w * G w)) → (∀ p : ℝ, InS B qs (p / B.h) (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2) ^ p)) → (∀ (α : ℝ) (F : ℝ × ℝ → ℝ), InS B qs α F → InS B qs (α + 1 - 1 / (2 * B.h)) (fun w => fderiv ℝ F w (1, 0))) → InS B qs α K → InS B qs (α + 1) (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2) ^ (1/2 - a) * deriv (fun z' => simScale B.h z' (1 - w.2) ^ a * K (z', w.2)) w.1) :=
by
  intro B qs α a K hB hqs0 hqs1 H1 H2 H3 hK
  have hDo : IsOpen {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} := by
    have hc : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hB.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun w : ℝ × ℝ => (w.1, 1 - w.2)) :=
      continuous_fst.prodMk (continuous_const.sub continuous_snd)
    have hs : IsOpen {w : ℝ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
    have hmaps : Set.MapsTo (fun w : ℝ × ℝ => (w.1, 1 - w.2)) {w : ℝ × ℝ | w.2 < 1}
        (Set.univ ×ˢ Set.Ioi 0) := by
      intro w hw
      have hw' : w.2 < 1 := hw
      exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - w.2 by linarith⟩
    have hcomp : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2)) {w : ℝ × ℝ | w.2 < 1} :=
      hc.comp hφ.continuousOn hmaps
    exact hcomp.isOpen_inter_preimage hs isOpen_Iio
  have hQa := H2 a
  have hQb := H2 (1/2 - a)
  have hQaz := H3 _ _ hQa
  have hKz := H3 _ _ hK
  have hT1 := H1 _ _ _ _ hQb (H1 _ _ _ _ hQaz hK)
  have hT2 := H1 _ _ _ _ hQb (H1 _ _ _ _ hQa hKz)
  have hh : 0 < B.h := hB.2.1.1
  have hAS : ∀ (α β γ c d : ℝ) (F G K : ℝ × ℝ → ℝ), InS B qs α F → InS B qs β G → γ ≤ α → γ ≤ β →
      (∀ w : ℝ × ℝ, w.2 < 1 → simScale B.h w.1 (1 - w.2) < qs → K w = c * F w + d * G w) →
      InS B qs γ K := by
    have lin : ∀ (U : Set (ℝ × ℝ)) (f g k : ℝ × ℝ → ℝ)
        (c d : ℝ), IsOpen U → ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ g U →
        (∀ x ∈ U, k x = c * f x + d * g x) →
        ContDiffOn ℝ ∞ k U ∧ ∀ (n : ℕ) (x : ℝ × ℝ) (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)), x ∈ U →
          ‖(iteratedFDeriv ℝ n k x).compContinuousLinearMap (fun _ => L)‖ ≤
            |c| * ‖(iteratedFDeriv ℝ n f x).compContinuousLinearMap (fun _ => L)‖ +
            |d| * ‖(iteratedFDeriv ℝ n g x).compContinuousLinearMap (fun _ => L)‖ := by
      intro U f g k c d hU hf hg hk
      have hp : ContDiffOn ℝ ∞ (fun y => c * f y + d * g y) U :=
        (contDiffOn_const.mul hf).add (contDiffOn_const.mul hg)
      refine ⟨hp.congr hk, ?_⟩
      intro n x L hx
      have hev : k =ᶠ[nhds x] (c • f + d • g) :=
        Filter.eventuallyEq_of_mem (hU.mem_nhds hx) (fun y hy => by simp [hk y hy, smul_eq_mul])
      have hfa : ContDiffAt ℝ n f x := (hf.contDiffAt (hU.mem_nhds hx)).of_le (by exact_mod_cast le_top)
      have hga : ContDiffAt ℝ n g x := (hg.contDiffAt (hU.mem_nhds hx)).of_le (by exact_mod_cast le_top)
      have heq : iteratedFDeriv ℝ n k x =
          c • iteratedFDeriv ℝ n f x + d • iteratedFDeriv ℝ n g x := by
        have e1 : iteratedFDeriv ℝ n (c • f + d • g) x =
            iteratedFDeriv ℝ n (c • f) x + iteratedFDeriv ℝ n (d • g) x :=
          iteratedFDeriv_add_apply (hfa.const_smul c) (hga.const_smul d)
        rw [(hev.iteratedFDeriv ℝ n).eq_of_nhds, e1,
          iteratedFDeriv_const_smul_apply hfa, iteratedFDeriv_const_smul_apply hga]
      have hlin : (c • iteratedFDeriv ℝ n f x + d • iteratedFDeriv ℝ n g x).compContinuousLinearMap
            (fun _ => L) =
          c • (iteratedFDeriv ℝ n f x).compContinuousLinearMap (fun _ => L) +
          d • (iteratedFDeriv ℝ n g x).compContinuousLinearMap (fun _ => L) := by
        ext v; simp
      rw [heq, hlin]
      refine (norm_add_le _ _).trans ?_
      rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
    have wm : ∀ (C q α γ S b b' : ℝ), 0 < q → q ≤ 1 → γ ≤ α → 1 ≤ S → b ≤ b' →
        C * q ^ (B.h * α) * S ^ b ≤ |C| * q ^ (B.h * γ) * S ^ b' := by
      intro C q α γ S b b' hq0 hq1 hγ hS1 hb
      have h1 : q ^ (B.h * α) ≤ q ^ (B.h * γ) :=
        Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (mul_le_mul_of_nonneg_left hγ hh.le)
      have h2 : S ^ b ≤ S ^ b' := Real.rpow_le_rpow_of_exponent_le hS1 hb
      have h3 : 0 ≤ q ^ (B.h * α) := Real.rpow_nonneg hq0.le _
      have h4 : 0 ≤ S ^ b := Real.rpow_nonneg (by linarith) _
      calc C * q ^ (B.h * α) * S ^ b ≤ |C| * q ^ (B.h * α) * S ^ b :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_abs_self C) h3) h4
        _ ≤ |C| * q ^ (B.h * γ) * S ^ b' :=
            mul_le_mul (mul_le_mul_of_nonneg_left h1 (abs_nonneg C)) h2 h4
              (mul_nonneg (abs_nonneg C) (Real.rpow_nonneg hq0.le _))
    intro α β γ c d F G K hF hG hγα hγβ hK
    obtain ⟨F1, F2⟩ := hF
    obtain ⟨G1, G2⟩ := hG
    obtain ⟨hKsm, hKb⟩ := lin _ F G K c d hDo F1 G1 (fun w hw => hK w hw.1 hw.2)
    refine ⟨hKsm, fun n => ?_⟩
    obtain ⟨C₁, b₁, H₁⟩ := F2 n
    obtain ⟨C₂, b₂, H₂⟩ := G2 n
    refine ⟨|c| * |C₁| + |d| * |C₂|, max b₁ b₂, fun w hw1 hw2 => ?_⟩
    have hs0 : 0 < simScale B.h w.1 (1 - w.2) := (hB.1.1 w.1 (1 - w.2) (by linarith)).1
    have hs1 : simScale B.h w.1 (1 - w.2) ≤ 1 := hw2.le.trans hqs1
    have hL : 1 ≤ 1 + |Real.log (simScale B.h w.1 (1 - w.2))| := by
      linarith [abs_nonneg (Real.log (simScale B.h w.1 (1 - w.2)))]
    have k1 := (H₁ w hw1 hw2).trans (wm C₁ _ α γ _ (2 * b₁) (2 * max b₁ b₂) hs0 hs1 hγα hL
      (by linarith [le_max_left b₁ b₂]))
    have k2 := (H₂ w hw1 hw2).trans (wm C₂ _ β γ _ (2 * b₂) (2 * max b₁ b₂) hs0 hs1 hγβ hL
      (by linarith [le_max_right b₁ b₂]))
    have hk0 := hKb n w ((simScale B.h w.1 (1 - w.2) ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
        (simScale B.h w.1 (1 - w.2) • ContinuousLinearMap.id ℝ ℝ)) ⟨hw1, hw2⟩
    exact hk0.trans ((add_le_add (mul_le_mul_of_nonneg_left k1 (abs_nonneg c))
      (mul_le_mul_of_nonneg_left k2 (abs_nonneg d))).trans (le_of_eq (by ring)))
  refine hAS _ _ (α + 1) 1 1 _ _ _ hT1 hT2
    (le_of_eq (by ring)) (le_of_eq (by ring)) ?_
  intro w hw1 hw2
  obtain ⟨z, t⟩ := w
  have hw : ((z, t) : ℝ × ℝ) ∈ {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} :=
    ⟨hw1, hw2⟩
  have hn := hDo.mem_nhds hw
  have hdQa : DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2) ^ a) (z, t) :=
    (hQa.1.differentiableOn (by simp)).differentiableAt hn
  have hdK : DifferentiableAt ℝ K (z, t) := (hK.1.differentiableOn (by simp)).differentiableAt hn
  have hprod := hdQa.hasFDerivAt.mul hdK.hasFDerivAt
  have hι : HasDerivAt (fun x : ℝ => (x, t)) ((1:ℝ), (0:ℝ)) z :=
    (hasDerivAt_id z).prodMk (hasDerivAt_const z t)
  have hch := hprod.comp_hasDerivAt z hι
  have hder : deriv (fun z' => simScale B.h z' (1 - t) ^ a * K (z', t)) z =
      (simScale B.h z (1 - t) ^ a • fderiv ℝ K (z, t) +
        K (z, t) • fderiv ℝ (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2) ^ a) (z, t))
        ((1:ℝ), (0:ℝ)) := hch.deriv
  show simScale B.h z (1 - t) ^ (1/2 - a) * deriv (fun z' => simScale B.h z' (1 - t) ^ a * K (z', t)) z =
    1 * (simScale B.h z (1 - t) ^ (1/2 - a) *
      (fderiv ℝ (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2) ^ a) (z, t) ((1:ℝ), (0:ℝ)) * K (z, t))) +
    1 * (simScale B.h z (1 - t) ^ (1/2 - a) *
      (simScale B.h z (1 - t) ^ a * fderiv ℝ K (z, t) ((1:ℝ), (0:ℝ))))
  rw [hder]
  simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
  ring

theorem stp5_bhat_lift : ∀ (B : BG) (qs β : ℝ) (e : ℕ) (M : ℝ × ℝ → ℝ), B.ok → 0 < qs → qs ≤ 1 → (∀ (p : ℝ) (k : ℕ), ∃ C : ℝ, ∀ z τ : ℝ, 0 < τ → simScale B.h z τ ≤ 1 → ‖(iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale B.h w.1 w.2 ^ p) (z, τ)).compContinuousLinearMap (fun _ => (simScale B.h z τ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap (simScale B.h z τ • ContinuousLinearMap.id ℝ ℝ))‖ ≤ C * simScale B.h z τ ^ p) → InS B qs β M → InM B qs β (fun ξ : Cyl => bHatE B e (ξ.1 / Real.sqrt (qC B.h ξ)) * M (ξ.2.1, ξ.2.2.1)) :=
by
  intro B qs β e M hB hqs0 hqs1 hS8 hM
  obtain ⟨hh0, hh1, hXa, hXam1, hm12, -⟩ := hB.2.1
  have hSN : SimNorm B.h := by
    intro k
    obtain ⟨C, hC⟩ := hS8 1 k
    refine ⟨C, fun z τ hτ hle => ?_⟩
    have := hC z τ hτ hle
    simp only [Real.rpow_one] at this
    exact this
  have hform : ∀ s : ℝ, bHatE B e s =
      Real.smoothTransition (1 - ((s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) ^ 2) /
        (∫ u in (Real.sqrt (2 * B.m1))..(Real.sqrt (2 * B.m2)),
          bumpR ((u - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
            ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2))) /
        (∫ u in (Real.sqrt (2 * B.m1))..(Real.sqrt (2 * B.m2)), u ^ e * rhoHat B u) := by
    intro s
    rfl
  have hΦ : ContDiff ℝ ∞ (bHatE B e) := by
    have hfun := funext hform
    rw [hfun]
    have h1 : ContDiff ℝ ∞ (fun s : ℝ => (s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) :=
      (contDiff_id.sub contDiff_const).div_const _
    have h2 := (contDiff_const (c := (1:ℝ))).sub (h1.pow 2)
    exact ((Real.smoothTransition.contDiff.comp h2).div_const _).div_const _
  have hs12 : Real.sqrt (2 * B.m1) < Real.sqrt (2 * B.m2) :=
    Real.sqrt_lt_sqrt (by linarith) (by linarith)
  have hΦs : ∀ x, bHatE B e x ≠ 0 → Real.sqrt (2 * B.m1) < x ∧ x < Real.sqrt (2 * B.m2) := by
    intro x hx
    rw [hform x] at hx
    set s1 := Real.sqrt (2 * B.m1) with hs1
    set s2 := Real.sqrt (2 * B.m2) with hs2
    have hw : 0 < (s2 - s1) / 2 := by linarith
    set y := (x - (s1 + s2) / 2) / ((s2 - s1) / 2) with hy
    have hst : Real.smoothTransition (1 - y ^ 2) ≠ 0 := by
      intro h0
      apply hx
      rw [h0, zero_div, zero_div]
    have hpos : 0 < 1 - y ^ 2 := by
      by_contra hle
      exact hst (Real.smoothTransition.zero_of_nonpos (not_lt.mp hle))
    have hy2 : y ^ 2 < 1 := by linarith
    have hyabs : |y| < 1 := (sq_lt_one_iff_abs_lt_one y).mp hy2
    obtain ⟨hyl, hyu⟩ := abs_lt.mp hyabs
    have hxy : y * ((s2 - s1) / 2) = x - (s1 + s2) / 2 := div_mul_cancel₀ _ hw.ne'
    have hl : -1 * ((s2 - s1) / 2) < y * ((s2 - s1) / 2) := mul_lt_mul_of_pos_right hyl hw
    have hu : y * ((s2 - s1) / 2) < 1 * ((s2 - s1) / 2) := mul_lt_mul_of_pos_right hyu hw
    constructor
    · linarith
    · linarith
  have hψ : ContDiff ℝ ∞ (fun _ : ℝ => (1:ℝ)) := contDiff_const
  have H := mom_profile_class_v4 B qs β (fun _ => 1) (bHatE B e) M hB hSN hqs0 hqs1 hψ hΦ hΦs hM
  have heq : (fun ξ : Cyl => bHatE B e (ξ.1 / Real.sqrt (qC B.h ξ)) * M (ξ.2.1, ξ.2.2.1)) =
      (fun ξ : Cyl => (fun _ : ℝ => (1:ℝ)) (etaC B.h ξ) * M (ξ.2.1, ξ.2.2.1) *
        bHatE B e (ξ.1 / Real.sqrt (qC B.h ξ))) := by
    funext ξ
    simp only [one_mul]
    ring
  rw [heq]
  exact H

theorem stp5_bm_class : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (cd : ℝ), B.ok → SimNorm B.h → (∀ (p : ℝ) (k : ℕ), ∃ C : ℝ, ∀ z τ : ℝ, 0 < τ → simScale B.h z τ ≤ 1 → ‖(iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale B.h w.1 w.2 ^ p) (z, τ)).compContinuousLinearMap (fun _ => (simScale B.h z τ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap (simScale B.h z τ • ContinuousLinearMap.id ℝ ℝ))‖ ≤ C * simScale B.h z τ ^ p) → InS B (qsOf l0) cd (nrmS B (2 * Aex B.h) (calP5 B G l0 S)) → InS B (qsOf l0) cd (nrmS B (2 * Aex B.h - 3/2) (calJth5 B G l0 S)) → InS B (qsOf l0) cd (nrmS B (2 * Aex B.h - 1) (calJz5 B G l0 S)) → (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → ME5 B G l0 S 2 z t = deriv (fun z' => calJth5 B G l0 S z' t) z ∧ ME5 B G l0 S 1 z t = deriv (fun z' => calJz5 B G l0 S z' t + (1/2) * (∫ r in Set.Ioi (0:ℝ), r ^ 2 * rhoP B (r, z', t, 0)) * calP5 B G l0 S z' t) z) → ∀ e : ℕ, (e = 1 ∨ e = 2) → InM B (qsOf l0) (cd + 1) (nrm B (2 * Aex B.h + 1/2) (fun ξ => bE B e ξ * ME5 B G l0 S e ξ.2.1 ξ.2.2.1)) :=
by
  intro B G l0 S cd hB _hSN hS8 hP hJth hJz hID e he
  have hqs0 : 0 < qsOf l0 := by
    show (0:ℝ) < (2:ℝ) ^ (-(l0:ℝ))
    positivity
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hpos : ∀ z t : ℝ, t < 1 → 0 < simScale B.h z (1 - t) := fun z t ht =>
    (hB.1.1 z (1 - t) (by linarith)).1
  obtain ⟨hAM, hAS⟩ := mom_class_algebra_v4 B (qsOf l0) hB hqs0 hqs1
  have H1 : ∀ (α β : ℝ) (F G : ℝ × ℝ → ℝ), InS B (qsOf l0) α F → InS B (qsOf l0) β G →
      InS B (qsOf l0) (α + β) (fun w => F w * G w) :=
    fun α β F G hF hG => stp5_ins_mul B _ α β F G hB hF hG
  have H2 := stp5_ins_qpow B (qsOf l0) hB hqs0 hqs1 hS8
  have H3 : ∀ (α : ℝ) (F : ℝ × ℝ → ℝ), InS B (qsOf l0) α F →
      InS B (qsOf l0) (α + 1 - 1 / (2 * B.h)) (fun w => fderiv ℝ F w (1, 0)) :=
    fun α F hF => stp5_ins_dz B _ α F hB hF

  have gen : ∀ (a : ℝ) (K : ℝ × ℝ → ℝ), InS B (qsOf l0) cd K →
      2 * Aex B.h + 1/2 + (-(((e:ℝ) + 1) / 2)) = 1/2 - a →
      (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 →
        ME5 B G l0 S e z t = deriv (fun z' => simScale B.h z' (1 - t) ^ a * K (z', t)) z) →
      InM B (qsOf l0) (cd + 1) (nrm B (2 * Aex B.h + 1/2) (fun ξ => bE B e ξ * ME5 B G l0 S e ξ.2.1 ξ.2.2.1)) := by
    intro a K hK hexp hME
    have hM := stp5_ins_dz_gain B (qsOf l0) cd a K hB hqs0 hqs1 H1 H2 H3 hK
    have hL := stp5_bhat_lift B (qsOf l0) (cd + 1) e _ hB hqs0 hqs1 hS8 hM
    refine hAM (cd + 1) (cd + 1) (cd + 1) 1 0 _ _ _ hL hL le_rfl le_rfl ?_
    intro ξ hξ
    obtain ⟨_hr, ht, hq⟩ := hξ
    have hq0 : 0 < qC B.h ξ := hpos _ _ ht
    have e1 : qC B.h ξ ^ (2 * Aex B.h + 1/2) * qC B.h ξ ^ (-(((e:ℝ) + 1) / 2)) = qC B.h ξ ^ (1/2 - a) := by
      rw [← Real.rpow_add hq0, hexp]
    show qC B.h ξ ^ (2 * Aex B.h + 1/2) * (qC B.h ξ ^ (-(((e:ℝ) + 1) / 2)) *
        bHatE B e (ξ.1 / Real.sqrt (qC B.h ξ)) * ME5 B G l0 S e ξ.2.1 ξ.2.2.1) =
      1 * (bHatE B e (ξ.1 / Real.sqrt (qC B.h ξ)) * (qC B.h ξ ^ (1/2 - a) *
        deriv (fun z' => simScale B.h z' (1 - ξ.2.2.1) ^ a * K (z', ξ.2.2.1)) ξ.2.1)) +
      0 * (bHatE B e (ξ.1 / Real.sqrt (qC B.h ξ)) * (qC B.h ξ ^ (1/2 - a) *
        deriv (fun z' => simScale B.h z' (1 - ξ.2.2.1) ^ a * K (z', ξ.2.2.1)) ξ.2.1))
    rw [hME ξ.2.1 ξ.2.2.1 ht hq, ← e1]
    ring
  rcases he with rfl | rfl
  ·

    have hmom : ∀ z' t : ℝ, t < 1 → (∫ r in Set.Ioi (0:ℝ), r ^ 2 * rhoP B (r, z', t, 0)) =
        simScale B.h z' (1 - t) * ∫ s in Set.Ioi (0:ℝ), s ^ 2 * rhoHat B s := by
      intro z' t ht
      have hq : 0 < simScale B.h z' (1 - t) := hpos z' t ht
      set q := simScale B.h z' (1 - t) with hqdef
      have hsq : 0 < Real.sqrt q := Real.sqrt_pos.mpr hq
      have hqm : q ^ (-(1/2:ℝ)) = (Real.sqrt q)⁻¹ := by
        rw [Real.rpow_neg hq.le, Real.sqrt_eq_rpow]
      have hfun : (fun r : ℝ => r ^ 2 * rhoP B (r, z', t, 0)) =
          fun r => Real.sqrt q * (((Real.sqrt q)⁻¹ * r) ^ 2 * rhoHat B ((Real.sqrt q)⁻¹ * r)) := by
        funext r
        show r ^ 2 * (q ^ (-(1/2:ℝ)) * rhoHat B (r / Real.sqrt q)) = _
        rw [hqm, div_eq_inv_mul]
        have hs1 : Real.sqrt q * (Real.sqrt q)⁻¹ = 1 := mul_inv_cancel₀ hsq.ne'
        generalize rhoHat B ((Real.sqrt q)⁻¹ * r) = X
        linear_combination (-((Real.sqrt q)⁻¹ * r ^ 2 * X)) * hs1
      have hsub := MeasureTheory.integral_comp_mul_left_Ioi (fun s : ℝ => s ^ 2 * rhoHat B s) 0
        (inv_pos.mpr hsq)
      simp only [mul_zero, inv_inv, smul_eq_mul] at hsub
      rw [hfun, MeasureTheory.integral_const_mul, hsub, ← mul_assoc,
        Real.mul_self_sqrt hq.le]
    set chat : ℝ := (1/2) * ∫ s in Set.Ioi (0:ℝ), s ^ 2 * rhoHat B s with hchat
    have hK1 : InS B (qsOf l0) cd (fun w => nrmS B (2 * Aex B.h - 1) (calJz5 B G l0 S) w +
        chat * nrmS B (2 * Aex B.h) (calP5 B G l0 S) w) :=
      hAS cd cd cd 1 chat _ _ _ hJz hP le_rfl le_rfl (fun w _ _ => by simp only [one_mul])
    refine gen (1 - 2 * Aex B.h) _ hK1 (by push_cast; ring) ?_
    intro z t ht hq
    rw [(hID z t ht hq).2]
    congr 1
    funext z'
    have hq' : 0 < simScale B.h z' (1 - t) := hpos z' t ht
    have h1 : simScale B.h z' (1 - t) ^ (1 - 2 * Aex B.h) * simScale B.h z' (1 - t) ^ (2 * Aex B.h - 1) = 1 := by
      rw [← Real.rpow_add hq', show (1 - 2 * Aex B.h) + (2 * Aex B.h - 1) = 0 by ring, Real.rpow_zero]
    have h2 : simScale B.h z' (1 - t) ^ (1 - 2 * Aex B.h) * simScale B.h z' (1 - t) ^ (2 * Aex B.h) =
        simScale B.h z' (1 - t) := by
      rw [← Real.rpow_add hq', show (1 - 2 * Aex B.h) + 2 * Aex B.h = 1 by ring, Real.rpow_one]
    show calJz5 B G l0 S z' t + (1/2) * (∫ r in Set.Ioi (0:ℝ), r ^ 2 * rhoP B (r, z', t, 0)) * calP5 B G l0 S z' t =
      simScale B.h z' (1 - t) ^ (1 - 2 * Aex B.h) *
        (simScale B.h z' (1 - t) ^ (2 * Aex B.h - 1) * calJz5 B G l0 S z' t +
          chat * (simScale B.h z' (1 - t) ^ (2 * Aex B.h) * calP5 B G l0 S z' t))
    rw [hmom z' t ht, hchat]
    linear_combination (-(calJz5 B G l0 S z' t)) * h1 +
      (-(1/2) * (∫ s in Set.Ioi (0:ℝ), s ^ 2 * rhoHat B s) * calP5 B G l0 S z' t) * h2
  ·
    refine gen (3/2 - 2 * Aex B.h) _ hJth (by push_cast; ring) ?_
    intro z t ht hq
    rw [(hID z t ht hq).1]
    congr 1
    funext z'
    have hq' : 0 < simScale B.h z' (1 - t) := hpos z' t ht
    show calJth5 B G l0 S z' t = simScale B.h z' (1 - t) ^ (3/2 - 2 * Aex B.h) *
      (simScale B.h z' (1 - t) ^ (2 * Aex B.h - 3/2) * calJth5 B G l0 S z' t)
    rw [← mul_assoc, ← Real.rpow_add hq', show (3/2 - 2 * Aex B.h) + (2 * Aex B.h - 3/2) = 0 by ring,
      Real.rpow_zero, one_mul]

theorem stress5_target_props : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
    l1 ≤ l0 → ∀ (S : CState) (Bo : ℝ), 7/10 ≤ Bo → StressIn5 B G l0 S Bo →
    StressTargetOK5 B G l0 S Bo :=
by
  intro B G hB hG
  obtain ⟨hh0, hh1, hXa, hXam1, hm12, hm2Xb, -, hqB0, -, -, -, haa, hab⟩ := hB.2.1
  have hSN : SimNorm B.h := simscale_normalized_v4 B.h hh0 hh1 hB.1
  have hS8 := stp5_simscale_rpow_norm B.h hh0 hh1 hB.1 hSN
  have hXaXb : B.Xa < B.Xb := by linarith
  have hEM := fun (d : ℝ) (hd : 0 ≤ d) => stp5_edge_mono B.Xa B.Xb B.aa B.ab d hXa hXaXb haa hab hd
  obtain ⟨hdk1, hdk2, hdk3⟩ := stp5_int_deck B.h hh0 hh1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0 + 7, ?_⟩
  intro l0 hl0 S Bo _ hIn
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hl7 : 7 ≤ l0 := by omega
  have hSt : StOrd5 B G l0 S (Bo + 2/5) (Bo + 1/2 - kapS) (Bo + 1/2 - kapS) (Bo + 1/2 - kapS) := hIn
