    rw [e]
    exact h3'
  have hDsh : ∀ η ∈ DomC B.h qs, ∀ a : ℝ × ℝ, shY η a ∈ DomC B.h qs := fun η hη _ => hη

  have hrad : ∀ z t : ℝ, radMom f 0 z t =
      ∫ r in Set.Ioi (0:ℝ), ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, f (r, z, t, Y) := by
