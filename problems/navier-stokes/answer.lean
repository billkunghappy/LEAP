    have hxi : |xiG B.h γ (G.ctr γ) η.2.2.2| < 1/8 := by rw [hη3]; exact hxY0
    have het : |etG B.h γ (G.ctr γ) η.2.2.2| < 1/8 := by rw [hη3]; exact heY0
    have hvη : vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = 0 := by rw [hη3]; exact hvY0
    obtain ⟨U', c', -, hηU', -, hU'⟩ := nPhi5_local_model_v5 B G γ η hB hDη hxi het
