    have fub2 : ∀ Ψ : ℝ × ℝ → ℂ, Continuous Ψ →
        ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Ψ Z =
          ∫ y in Set.Icc (0:ℝ) 1, ∫ x in Set.Icc (0:ℝ) 1, Ψ (x, y) := by
      intro Ψ hΨ
