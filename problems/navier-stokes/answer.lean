      (f' := fun x : ℝ => Real.exp (-(2 * x)) * (x - 1 / 50) ^ 2) (fun x _ => hF (1 / 50) x)
      ((by fun_prop : Continuous fun x : ℝ => Real.exp (-(2 * x)) * (x - 1 / 50) ^ 2).intervalIntegrable _ _)
    have hmono : (∫ ξ in (1 / 50 : ℝ)..10, Real.exp (-(2 * ξ)) * (ξ - 1 / 50) ^ 2) ≤
        ∫ ξ in (1 / 50 : ℝ)..10, G ξ := by
      apply intervalIntegral.integral_mono_on (by norm_num)
        ((by fun_prop : Continuous fun x : ℝ => Real.exp (-(2 * x)) * (x - 1 / 50) ^ 2).intervalIntegrable _ _)
        (GII (1 / 50) 10 (by norm_num) (by norm_num) (by norm_num))
      intro x hx
      simp only [hG]
      have h3 := R0lo x hx.1 hx.2
