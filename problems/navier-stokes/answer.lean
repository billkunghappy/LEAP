  have h3KE : 3 * KE * t ≤ C1 / (γ.1:ℝ) ^ 2 := hfin _ (by rw [hC1]; linarith)
  obtain ⟨eF1, eF2⟩ := abs_le.mp eFa
  obtain ⟨eR1, eR2⟩ := abs_le.mp eRF
  obtain ⟨eB1, eB2⟩ := abs_le.mp eRB
  rw [hN, hNP, hKm]
  refine ⟨hvec _ _ _ _ _ _ _ _ _ _ _ _ ?_ ?_ ?_ ?_ ?_ ?_, hmat _ _ _ _ _ _ _ _ rfl hX0 ?_ ?_ ?_⟩
  ·
    show |sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 - v * (pang5 B G γ * (Real.sqrt (Qb γ.1) *
        fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))) + pzr5 B G γ *
        (Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)))) -
        Bs5 B G γ * (sgn γ.2.2 * (G.ustar / 2 + G.ustar * v / Lsb B.h G.r0 γ.1))| ≤ C1 / (γ.1:ℝ) ^ 2
    calc _ ≤ K5 * Lsb B.h G.r0 γ.1 * (3 / 2 * (t * t) + KE * (t * t)) := hla1
      _ = K5 * (Lsb B.h G.r0 γ.1 * (3 / 2 * (t * t) + KE * (t * t))) := by ring
      _ ≤ K5 * (T * W0 * t) := mul_le_mul_of_nonneg_left hLsW hK50
      _ = (K5 * (T * W0)) * t := by ring
      _ ≤ C1 / (γ.1:ℝ) ^ 2 := hfin _ (by rw [hC1]; linarith)
  ·
    show |pang5 B G γ / pcRC5 γ.1 (ξ.1, ξ.2.1, ξ.2.2.1) - Bs5 B G γ * (-((eN (g0r5 B G γ))⁻¹ * (g0r5 B G γ).2))|
