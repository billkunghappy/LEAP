      Fin.succ_one_eq_two, Matrix.cons_val_one, Matrix.cons_val_two]
    push_cast
    field_simp
    ring

theorem pq5_vel_rep : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → InWg5 B G (qsOf l0) 1 (primState5 B G).Aw → InWg5 B G (qsOf l0) (1/2) (velW5 B G (primState5 B G).Aw) → (∀ γ m, ContDiffOn ℝ ∞ (pq5Vw B G γ m) (DomC B.h (qsOf l0))) ∧ (∀ γ m, m ≠ 1 → m ≠ -1 → pq5Vw B G γ m = 0) ∧ (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → pq5Vw B G γ m ξ ≠ 0 → SuppW B G γ ξ) ∧ ∀ x t Y, corrOn B l0 x t → pwrW5 B G l0 x t Y = cyl2cart x (waveV5 B G (pq5Vw B G) (thetaOf x) (ptOf x t Y)) :=
