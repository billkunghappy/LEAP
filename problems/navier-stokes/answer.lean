theorem rfp_pulse_N_exact : ∀ P : RfpPar, RfpRegime P → ∀ x : ℝ, rfpXk P 0 ≤ x → x ≤ rfpXv P → (∫ y in Iic (Real.log x), Real.exp (y + rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))) = x * Real.exp (rfpLam P (Real.log x)) * (∫ s in (0:ℝ)..(Real.log x - rfpY3 P.Md P.lam), Real.exp (-((1 / 2 - P.lam) * ((Real.log x - rfpY3 P.Md P.lam) - s))) * rfpR0 (P.lam * s)) ∧ 0 ≤ (∫ s in (0:ℝ)..(Real.log x - rfpY3 P.Md P.lam), Real.exp (-((1 / 2 - P.lam) * ((Real.log x - rfpY3 P.Md P.lam) - s))) * rfpR0 (P.lam * s)) ∧ (∫ s in (0:ℝ)..(Real.log x - rfpY3 P.Md P.lam), Real.exp (-((1 / 2 - P.lam) * ((Real.log x - rfpY3 P.Md P.lam) - s))) * rfpR0 (P.lam * s)) ≤ 23 ∧ 0 ≤ (∫ y in Iic (Real.log x), Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 3)) ∧ (∫ y in Iic (Real.log x), Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 3)) ≤ 3 * (x * Real.exp (rfpLam P (Real.log x))) ∧ 0 ≤ (∫ y in Iic (Real.log x), Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 1)) ∧ (∫ y in Iic (Real.log x), Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 1)) ≤ 3 * (x * Real.exp (rfpLam P (Real.log x))) ∧ 0 ≤ (∫ y in Iic (Real.log x), Real.exp (y + 2 * rfpLam P y)) ∧ 0 ≤ (∫ y in Iic (Real.log x), Real.exp (y + 2 * rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam)) ^ 2) ∧ (∫ y in Iic (Real.log x), Real.exp (y + 2 * rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam)) ^ 2) ≤ 121 * (∫ y in Iic (Real.log x), Real.exp (y + 2 * rfpLam P y)) ∧ 0 ≤ (∫ y in Iic (Real.log x), Real.exp (y + 2 * rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 3) ^ 2) ∧ (∫ y in Iic (Real.log x), Real.exp (y + 2 * rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 3) ^ 2) ≤ (∫ y in Iic (Real.log x), Real.exp (y + 2 * rfpLam P y)) ∧ 0 ≤ (∫ y in Iic (Real.log x), Real.exp (y + 2 * rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 1) ^ 2) ∧ (∫ y in Iic (Real.log x), Real.exp (y + 2 * rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 1) ^ 2) ≤ (∫ y in Iic (Real.log x), Real.exp (y + 2 * rfpLam P y)) :=
by
  intro P hP x hx1 hx2
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hP

