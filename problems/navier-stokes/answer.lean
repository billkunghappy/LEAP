      simp
    · intro Y₀
      show ContDiffOn ℝ ∞ (fun _ : ℝ³ × ℝ => (0 : ℝ³)) _
      exact contDiffOn_const
    · intro x t Y _ _
      rfl
  · intro x t Y hc
    exact (hTh x t Y hc).trans (add_zero _).symm

theorem pulse_self_harmonics_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
