  have hGhold : rfpY5 P.Md P.lam + 1 ≤ y → a = 1 ∧ d = 0 ∧ R = 0 := by
    intro hy5
    refine ⟨by rw [ha]; exact hs1 _ (by linarith), ?_, ?_⟩
    · rw [hd]
