    intro a b Ma Mb ha hb'
    rw [abs_mul]
    exact mul_le_mul ha hb' (abs_nonneg _) ((abs_nonneg _).trans ha)
  have iκ : IntervalIntegrable κ volume 0 X := hII κ B hκ (fun s h0 h1 => (hb s h0 h1).1)
  have igφ : ∀ φ : ℝ → ℝ, Measurable φ → (∀ s, 0 ≤ s → s ≤ X → |φ s| ≤ B) →
      IntervalIntegrable (fun s => g s * φ s) volume 0 X :=
    fun φ hφ hφb => hII _ (B * B) (hg.mul hφ)
      (fun s h0 h1 => hmulb _ _ _ _ (hb s h0 h1).2.1 (hφb s h0 h1))
  have iJ : ∀ φ : ℝ → ℝ, Measurable φ → (∀ s, 0 ≤ s → s ≤ X → |φ s| ≤ B) →
      IntervalIntegrable (fun s => Real.sqrt (2 * s) * g s ^ 2 * φ s) volume 0 X :=
    fun φ hφ hφb => hII _ (Real.sqrt (2 * X) * B ^ 2 * B) ((hsq_m.mul (hg.pow_const 2)).mul hφ)
      (fun s h0 h1 => hmulb _ _ _ _ (hmulb _ _ _ _ (hsq_b s h0 h1)
        (by rw [abs_pow]; exact pow_le_pow_left₀ (abs_nonneg _) (hb s h0 h1).2.1 2)) (hφb s h0 h1))
  have iGk : IntervalIntegrable (fun s => Real.sqrt (2 * s) * g s * κ s) volume 0 X :=
    hII _ (Real.sqrt (2 * X) * B * B) ((hsq_m.mul hg).mul hκ)
      (fun s h0 h1 => hmulb _ _ _ _ (hmulb _ _ _ _ (hsq_b s h0 h1) (hb s h0 h1).2.1) (hb s h0 h1).1)
  have i0 := igφ φ0 hφ0 (fun s h0 h1 => (hb s h0 h1).2.2.1)
  have i1 := igφ φ1 hφ1 (fun s h0 h1 => (hb s h0 h1).2.2.2.1)
  have i2 := igφ φ2 hφ2 (fun s h0 h1 => (hb s h0 h1).2.2.2.2)
  have j0 := iJ φ0 hφ0 (fun s h0 h1 => (hb s h0 h1).2.2.1)
  have j1 := iJ φ1 hφ1 (fun s h0 h1 => (hb s h0 h1).2.2.2.1)
  have j2 := iJ φ2 hφ2 (fun s h0 h1 => (hb s h0 h1).2.2.2.2)

  have lin4 : ∀ (f1 f2 f3 f4 : ℝ → ℝ) (a1 a2 a3 a4 : ℝ), IntervalIntegrable f1 volume 0 X →
      IntervalIntegrable f2 volume 0 X → IntervalIntegrable f3 volume 0 X →
      IntervalIntegrable f4 volume 0 X →
      (∫ x in (0:ℝ)..X, (a1 * f1 x + a2 * f2 x + a3 * f3 x + a4 * f4 x)) =
        a1 * (∫ x in (0:ℝ)..X, f1 x) + a2 * (∫ x in (0:ℝ)..X, f2 x) +
          a3 * (∫ x in (0:ℝ)..X, f3 x) + a4 * (∫ x in (0:ℝ)..X, f4 x) := by
    intro f1 f2 f3 f4 a1 a2 a3 a4 h1 h2 h3 h4
    rw [intervalIntegral.integral_add (((h1.const_mul a1).add (h2.const_mul a2)).add (h3.const_mul a3))
        (h4.const_mul a4),
      intervalIntegral.integral_add ((h1.const_mul a1).add (h2.const_mul a2)) (h3.const_mul a3),
      intervalIntegral.integral_add (h1.const_mul a1) (h2.const_mul a2),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
  obtain ⟨Ik, hIk⟩ : ∃ v : ℝ, v = ∫ s in (0:ℝ)..X, κ s := ⟨_, rfl⟩
  obtain ⟨IG, hIG⟩ : ∃ v : ℝ, v = ∫ s in (0:ℝ)..X, Real.sqrt (2 * s) * g s := ⟨_, rfl⟩
  obtain ⟨IJk, hIJk⟩ : ∃ v : ℝ, v = ∫ s in (0:ℝ)..X, Real.sqrt (2 * s) * g s * κ s := ⟨_, rfl⟩
  obtain ⟨M0, hM0⟩ : ∃ v : ℝ, v = ∫ s in (0:ℝ)..X, g s * φ0 s := ⟨_, rfl⟩
  obtain ⟨M1, hM1⟩ : ∃ v : ℝ, v = ∫ s in (0:ℝ)..X, g s * φ1 s := ⟨_, rfl⟩
  obtain ⟨M2, hM2⟩ : ∃ v : ℝ, v = ∫ s in (0:ℝ)..X, g s * φ2 s := ⟨_, rfl⟩
  obtain ⟨J0, hJ0⟩ : ∃ v : ℝ, v = ∫ s in (0:ℝ)..X, Real.sqrt (2 * s) * g s ^ 2 * φ0 s := ⟨_, rfl⟩
  obtain ⟨J1, hJ1⟩ : ∃ v : ℝ, v = ∫ s in (0:ℝ)..X, Real.sqrt (2 * s) * g s ^ 2 * φ1 s := ⟨_, rfl⟩
  obtain ⟨J2, hJ2⟩ : ∃ v : ℝ, v = ∫ s in (0:ℝ)..X, Real.sqrt (2 * s) * g s ^ 2 * φ2 s := ⟨_, rfl⟩

  have S1 : ∀ t : ℝ, profRadAvg U X t =
      X⁻¹ * (t * Ik + (1 + t ^ 2)⁻¹ * (A t * M0 + c1 t * M1 + c2 t * M2)) := by
    intro t
    unfold profRadAvg
    rw [intervalIntegral.integral_comp_mul_right (fun x => U x t) hX.ne']
    simp only [zero_mul, one_mul, smul_eq_mul]
    have hc : (∫ x in (0:ℝ)..X, U x t) = ∫ x in (0:ℝ)..X, (t * κ x + ((1 + t ^ 2)⁻¹ * A t) * (g x * φ0 x)
        + ((1 + t ^ 2)⁻¹ * c1 t) * (g x * φ1 x) + ((1 + t ^ 2)⁻¹ * c2 t) * (g x * φ2 x)) := by
      apply intervalIntegral.integral_congr
      intro x hx
      rw [Set.uIcc_of_le hX.le] at hx
      dsimp only
      rw [(hrep x t hx.1 hx.2).1]
      ring
    rw [hc, lin4 κ (fun x => g x * φ0 x) (fun x => g x * φ1 x) (fun x => g x * φ2 x) _ _ _ _ iκ i0 i1 i2,
      hIk, hM0, hM1, hM2]
    ring
  have S2 : ∀ t : ℝ, profRadInt (fun x e => 2 * x * F x e) X t = (1 + t ^ 2)⁻¹ * IG := by
    intro t
    simp only [profRadInt]
    have hc : (∫ x in (0:ℝ)..X, 2 * x * F x t) =
        ∫ x in (0:ℝ)..X, (1 + t ^ 2)⁻¹ * (Real.sqrt (2 * x) * g x) := by
      apply intervalIntegral.integral_congr
      intro x hx
      rw [Set.uIcc_of_le hX.le] at hx
      dsimp only
      rw [(hrep x t hx.1 hx.2).2]
    rw [hc, intervalIntegral.integral_const_mul, hIG]
  have S3 : ∀ t : ℝ, profRadInt (fun x e => U x e * (2 * x * F x e)) X t =
      t * (1 + t ^ 2)⁻¹ * IJk + ((1 + t ^ 2)⁻¹) ^ 2 * (A t * J0 + c1 t * J1 + c2 t * J2) := by
    intro t
    simp only [profRadInt]
    have hc : (∫ x in (0:ℝ)..X, U x t * (2 * x * F x t)) =
        ∫ x in (0:ℝ)..X, ((t * (1 + t ^ 2)⁻¹) * (Real.sqrt (2 * x) * g x * κ x)
          + (((1 + t ^ 2)⁻¹) ^ 2 * A t) * (Real.sqrt (2 * x) * g x ^ 2 * φ0 x)
          + (((1 + t ^ 2)⁻¹) ^ 2 * c1 t) * (Real.sqrt (2 * x) * g x ^ 2 * φ1 x)
          + (((1 + t ^ 2)⁻¹) ^ 2 * c2 t) * (Real.sqrt (2 * x) * g x ^ 2 * φ2 x)) := by
      apply intervalIntegral.integral_congr
      intro x hx
      rw [Set.uIcc_of_le hX.le] at hx
      dsimp only
      rw [(hrep x t hx.1 hx.2).1, (hrep x t hx.1 hx.2).2]
      ring
    rw [hc, lin4 (fun x => Real.sqrt (2 * x) * g x * κ x) (fun x => Real.sqrt (2 * x) * g x ^ 2 * φ0 x)
      (fun x => Real.sqrt (2 * x) * g x ^ 2 * φ1 x) (fun x => Real.sqrt (2 * x) * g x ^ 2 * φ2 x)
      _ _ _ _ iGk j0 j1 j2, hIJk, hJ0, hJ1, hJ2]
    ring

  have hq : (1 + η ^ 2) ≠ 0 := by positivity
  have hf : HasDerivAt (fun e : ℝ => (1 + e ^ 2)⁻¹) (-(2 * η * ((1 + η ^ 2)⁻¹) ^ 2)) η := by
    have h1 : HasDerivAt (fun e : ℝ => 1 + e ^ 2) (2 * η) η := by
      simpa using (hasDerivAt_pow 2 η).const_add 1
    convert h1.fun_inv hq using 1
    rw [div_eq_mul_inv, inv_pow]
    ring
  have hSM : HasDerivAt (fun e => A e * M0 + c1 e * M1 + c2 e * M2)
      (deriv A η * M0 + deriv c1 η * M1 + deriv c2 η * M2) η :=
    ((hA.hasDerivAt.mul_const M0).add (hc1.hasDerivAt.mul_const M1)).add (hc2.hasDerivAt.mul_const M2)
  have hSJ : HasDerivAt (fun e => A e * J0 + c1 e * J1 + c2 e * J2)
      (deriv A η * J0 + deriv c1 η * J1 + deriv c2 η * J2) η :=
    ((hA.hasDerivAt.mul_const J0).add (hc1.hasDerivAt.mul_const J1)).add (hc2.hasDerivAt.mul_const J2)
  have D1 : HasDerivAt (fun e => X⁻¹ * (e * Ik + (1 + e ^ 2)⁻¹ * (A e * M0 + c1 e * M1 + c2 e * M2)))
      (X⁻¹ * (1 * Ik + (-(2 * η * ((1 + η ^ 2)⁻¹) ^ 2) * (A η * M0 + c1 η * M1 + c2 η * M2)
        + (1 + η ^ 2)⁻¹ * (deriv A η * M0 + deriv c1 η * M1 + deriv c2 η * M2)))) η :=
    (((hasDerivAt_id' η).mul_const Ik).add (hf.mul hSM)).const_mul X⁻¹
  have D2 : HasDerivAt (fun e => (1 + e ^ 2)⁻¹ * IG) (-(2 * η * ((1 + η ^ 2)⁻¹) ^ 2) * IG) η :=
    hf.mul_const IG
  have D3 : HasDerivAt (fun e => e * (1 + e ^ 2)⁻¹ * IJk
        + (1 + e ^ 2)⁻¹ * (1 + e ^ 2)⁻¹ * (A e * J0 + c1 e * J1 + c2 e * J2))
      ((1 * (1 + η ^ 2)⁻¹ + η * (-(2 * η * ((1 + η ^ 2)⁻¹) ^ 2))) * IJk
        + ((-(2 * η * ((1 + η ^ 2)⁻¹) ^ 2) * (1 + η ^ 2)⁻¹
          + (1 + η ^ 2)⁻¹ * (-(2 * η * ((1 + η ^ 2)⁻¹) ^ 2))) * (A η * J0 + c1 η * J1 + c2 η * J2)
          + (1 + η ^ 2)⁻¹ * (1 + η ^ 2)⁻¹ * (deriv A η * J0 + deriv c1 η * J1 + deriv c2 η * J2))) η :=
    (((hasDerivAt_id' η).mul hf).mul_const IJk).add ((hf.mul hf).mul hSJ)
  refine ⟨Ik, IG, IJk, M0, M1, M2, J0, J1, J2, hIk, hIG, hIJk, hM0, hM1, hM2, hJ0, hJ1, hJ2,
    S1 η, ?_, S2 η, ?_, S3 η, ?_, (hrep X η hX.le le_rfl).2⟩
  · have hfun : profRadAvg U X = fun e =>
        X⁻¹ * (e * Ik + (1 + e ^ 2)⁻¹ * (A e * M0 + c1 e * M1 + c2 e * M2)) := funext S1
    unfold profEtaD
    rw [hfun, D1.deriv]
    ring
  · have hfun : profRadInt (fun x e => 2 * x * F x e) X = fun e => (1 + e ^ 2)⁻¹ * IG := funext S2
    unfold profEtaD
    rw [hfun, D2.deriv]
  · have hfun : profRadInt (fun x e => U x e * (2 * x * F x e)) X = fun e =>
        e * (1 + e ^ 2)⁻¹ * IJk
          + (1 + e ^ 2)⁻¹ * (1 + e ^ 2)⁻¹ * (A e * J0 + c1 e * J1 + c2 e * J2) := by
      funext e
      rw [S3 e]
      ring
    unfold profEtaD
    rw [hfun, D3.deriv]
    ring

theorem pqc_QF_close : ∀ (lam h η A dA a1 da1 a2 da2 r k jk m0 m1 m2 j0 j1 j2 δ : ℝ), 0 < lam → lam ≤ 1 / 100 → 0 ≤ h → h ≤ 1 / 100 → -1 ≤ η → η ≤ 1 → |A| ≤ 6 / 5 → |dA| ≤ 1 → |a1| ≤ 1 → |da1| ≤ 1 → |a2| ≤ 1 → |da2| ≤ 1 → 0 ≤ δ → |r - 1 / (1 - lam)| ≤ δ → |k| ≤ δ → |jk| ≤ δ → |m0| ≤ δ → |m1| ≤ δ → |m2| ≤ δ → |j0| ≤ δ → |j1| ≤ δ → |j2| ≤ δ → |-1 + (1 - h + (1 - 2 * h) * η ^ 2 / (1 + η ^ 2)) * r + (1 - 2 * h * η ^ 2) * k - ((1 - η ^ 2) ^ 2 / (1 + η ^ 2) + (1 - 4 * h) * η ^ 2) * jk + 2 * (1 / 2 - h) * η * (1 + η ^ 2)⁻¹ * (A * m0 + a1 * m1 + a2 * m2) + (1 - η ^ 2) * (-(2 * η * ((1 + η ^ 2)⁻¹) ^ 2) * (A * m0 + a1 * m1 + a2 * m2) + (1 + η ^ 2)⁻¹ * (dA * m0 + da1 * m1 + da2 * m2)) - (1 - η ^ 2) * (-(4 * η * ((1 + η ^ 2)⁻¹) ^ 2) * (A * j0 + a1 * j1 + a2 * j2) + (1 + η ^ 2)⁻¹ * (dA * j0 + da1 * j1 + da2 * j2)) + (4 * h - 1) * η * (1 + η ^ 2)⁻¹ * (A * j0 + a1 * j1 + a2 * j2) - (lam - h + (1 - 2 * h) * η ^ 2 / (1 + η ^ 2)) / (1 - lam)| ≤ 40 * δ :=
by
  intro lam h η A dA a1 da1 a2 da2 r k jk m0 m1 m2 j0 j1 j2 δ hl0 hl1 hh0 hh1 he0 he1 hA hdA
    ha1 hda1 ha2 hda2 hδ hr hk hjk hm0 hm1 hm2 hj0 hj1 hj2
  have hlne : (1 - lam) ≠ 0 := by
    intro h0
    linarith
  have hpos : (0:ℝ) < 1 + η ^ 2 := by positivity
  have he2 : η ^ 2 ≤ 1 := by nlinarith
  have he2' : 0 ≤ η ^ 2 := sq_nonneg η
  have hq0 : 0 ≤ (1 - 2 * h) * η ^ 2 / (1 + η ^ 2) :=
    div_nonneg (mul_nonneg (by linarith) he2') hpos.le
  have hq1 : (1 - 2 * h) * η ^ 2 / (1 + η ^ 2) ≤ 1 := (div_le_one hpos).mpr (by nlinarith)
  have hp0 : 0 ≤ (1 - η ^ 2) ^ 2 / (1 + η ^ 2) := by positivity
  have hp1 : (1 - η ^ 2) ^ 2 / (1 + η ^ 2) ≤ 1 := (div_le_one hpos).mpr (by nlinarith)
  have hw0 : 0 < (1 + η ^ 2)⁻¹ := inv_pos.mpr hpos
  have hw1 : (1 + η ^ 2)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by linarith)
  have key : ∀ Q : ℝ, -1 + (1 - h + Q) * r - (lam - h + Q) / (1 - lam)
      = (1 - h + Q) * (r - 1 / (1 - lam)) := by
    intro Q
    field_simp
    ring
  have hE := key ((1 - 2 * h) * η ^ 2 / (1 + η ^ 2))
  have mul3 : ∀ x y a b : ℝ, |x| ≤ a → |y| ≤ b → 0 ≤ a → |x * y| ≤ a * b :=
    fun x y a b hx hy ha => by
      rw [abs_mul]
      exact mul_le_mul hx hy (abs_nonneg _) ha
  have hη : |η| ≤ 1 := abs_le.mpr ⟨he0, he1⟩
  have hw : |(1 + η ^ 2)⁻¹| ≤ 1 := abs_le.mpr ⟨by linarith, hw1⟩
  have hw2 : |((1 + η ^ 2)⁻¹) ^ 2| ≤ 1 := abs_le.mpr ⟨by nlinarith, by nlinarith⟩
  have h1e : |1 - η ^ 2| ≤ 1 := abs_le.mpr ⟨by linarith, by linarith⟩
  have hc1 : |1 - h + (1 - 2 * h) * η ^ 2 / (1 + η ^ 2)| ≤ 2 :=
    abs_le.mpr ⟨by linarith, by linarith⟩
  have hc2 : |1 - 2 * h * η ^ 2| ≤ 1 := abs_le.mpr ⟨by nlinarith, by nlinarith⟩
  have hc3 : |(1 - η ^ 2) ^ 2 / (1 + η ^ 2) + (1 - 4 * h) * η ^ 2| ≤ 2 :=
    abs_le.mpr ⟨by nlinarith, by nlinarith⟩
  have hc4 : |2 * (1 / 2 - h)| ≤ 1 := abs_le.mpr ⟨by linarith, by linarith⟩
  have hc7 : |4 * h - 1| ≤ 1 := abs_le.mpr ⟨by linarith, by linarith⟩
  have hηw : |η * ((1 + η ^ 2)⁻¹) ^ 2| ≤ 1 * 1 := mul3 _ _ _ _ hη hw2 (by norm_num)
  have hηw' := abs_le.mp hηw
  have hc5 : |-(2 * η * ((1 + η ^ 2)⁻¹) ^ 2)| ≤ 2 := by
    rw [abs_neg, mul_assoc, abs_mul]
    have : |(2:ℝ)| = 2 := by norm_num
    rw [this]
    linarith [abs_nonneg (η * ((1 + η ^ 2)⁻¹) ^ 2)]
  have hc6 : |-(4 * η * ((1 + η ^ 2)⁻¹) ^ 2)| ≤ 4 := by
    rw [abs_neg, mul_assoc, abs_mul]
    have : |(4:ℝ)| = 4 := by norm_num
    rw [this]
    linarith [abs_nonneg (η * ((1 + η ^ 2)⁻¹) ^ 2)]
  have hSm : |A * m0 + a1 * m1 + a2 * m2| ≤ 6 / 5 * δ + 1 * δ + 1 * δ :=
    (abs_add_le _ _).trans (add_le_add ((abs_add_le _ _).trans
      (add_le_add (mul3 _ _ _ _ hA hm0 (by norm_num)) (mul3 _ _ _ _ ha1 hm1 (by norm_num))))
      (mul3 _ _ _ _ ha2 hm2 (by norm_num)))
  have hSmp : |dA * m0 + da1 * m1 + da2 * m2| ≤ 1 * δ + 1 * δ + 1 * δ :=
    (abs_add_le _ _).trans (add_le_add ((abs_add_le _ _).trans
      (add_le_add (mul3 _ _ _ _ hdA hm0 (by norm_num)) (mul3 _ _ _ _ hda1 hm1 (by norm_num))))
      (mul3 _ _ _ _ hda2 hm2 (by norm_num)))
  have hSj : |A * j0 + a1 * j1 + a2 * j2| ≤ 6 / 5 * δ + 1 * δ + 1 * δ :=
    (abs_add_le _ _).trans (add_le_add ((abs_add_le _ _).trans
      (add_le_add (mul3 _ _ _ _ hA hj0 (by norm_num)) (mul3 _ _ _ _ ha1 hj1 (by norm_num))))
      (mul3 _ _ _ _ ha2 hj2 (by norm_num)))
  have hSjp : |dA * j0 + da1 * j1 + da2 * j2| ≤ 1 * δ + 1 * δ + 1 * δ :=
    (abs_add_le _ _).trans (add_le_add ((abs_add_le _ _).trans
      (add_le_add (mul3 _ _ _ _ hdA hj0 (by norm_num)) (mul3 _ _ _ _ hda1 hj1 (by norm_num))))
      (mul3 _ _ _ _ hda2 hj2 (by norm_num)))
  have T1 := abs_le.mp (mul3 _ _ _ _ hc1 hr (by norm_num))
  have T2 := abs_le.mp (mul3 _ _ _ _ hc2 hk (by norm_num))
  have T3 := abs_le.mp (mul3 _ _ _ _ hc3 hjk (by norm_num))
  have T4 := abs_le.mp (mul3 _ _ _ _ (mul3 _ _ _ _ (mul3 _ _ _ _ hc4 hη (by norm_num)) hw
    (by norm_num)) hSm (by norm_num))
  have T5 := abs_le.mp (mul3 _ _ _ _ h1e ((abs_add_le _ _).trans
    (add_le_add (mul3 _ _ _ _ hc5 hSm (by norm_num)) (mul3 _ _ _ _ hw hSmp (by norm_num))))
    (by norm_num))
  have T6 := abs_le.mp (mul3 _ _ _ _ h1e ((abs_add_le _ _).trans
    (add_le_add (mul3 _ _ _ _ hc6 hSj (by norm_num)) (mul3 _ _ _ _ hw hSjp (by norm_num))))
    (by norm_num))
  have T7 := abs_le.mp (mul3 _ _ _ _ (mul3 _ _ _ _ (mul3 _ _ _ _ hc7 hη (by norm_num)) hw
    (by norm_num)) hSj (by norm_num))
  rw [abs_le]
  constructor
  · linarith [T1.1, T2.2, T3.2, T4.1, T5.1, T6.2, T7.1]
  · linarith [T1.2, T2.1, T3.1, T4.2, T5.2, T6.1, T7.2]

theorem pqc_scalar_base : ∀ (lam x0 X Cs P1 : ℝ) (g κ : ℝ → ℝ), 0 < lam → lam ≤ 1 / 100 → 0 < x0 → x0 ≤ X → 0 < Cs → Measurable g → Measurable κ → (∀ s : ℝ, 0 ≤ s → s ≤ X → 0 ≤ g s ∧ g s ≤ P1) → (∀ s : ℝ, x0 ≤ s → s ≤ X → g s = Cs * s ^ (-(1 / 2 + lam))) → (∀ s : ℝ, 0 ≤ s → s ≤ X → 0 ≤ κ s ∧ κ s ≤ 4) → (∀ s : ℝ, x0 ≤ s → s ≤ X → κ s = 0) → |(∫ s in (0:ℝ)..X, Real.sqrt (2 * s) * g s) / (X * (Real.sqrt (2 * X) * g X)) - 1 / (1 - lam)| ≤ (2 + (P1 * x0 ^ (1 / 2 + lam) / Cs)) * Real.sqrt (x0 / X) ∧ |(∫ s in (0:ℝ)..X, κ s) / X| ≤ 4 * Real.sqrt (x0 / X) ∧ |(∫ s in (0:ℝ)..X, Real.sqrt (2 * s) * g s * κ s) / (X * (Real.sqrt (2 * X) * g X))| ≤ 4 * (P1 * x0 ^ (1 / 2 + lam) / Cs) * Real.sqrt (x0 / X) :=
by
  intro lam x0 X Cs P1 g κ hl0 hl1 hx0 hx0X hCs hgm hκm hg hpow hk hk0
  have hX : 0 < X := lt_of_lt_of_le hx0 hx0X
  have hP1 : 0 ≤ P1 := le_trans (hg 0 le_rfl hX.le).1 (hg 0 le_rfl hX.le).2

  have split : ∀ (φ : ℝ → ℝ) (B M : ℝ), Measurable φ → (∀ s, 0 ≤ s → s ≤ X → |φ s| ≤ B) →
      (∀ s, 0 ≤ s → s ≤ x0 → |φ s| ≤ M) →
      (∫ s in (0:ℝ)..X, φ s) = (∫ s in (0:ℝ)..x0, φ s) + (∫ s in x0..X, φ s) ∧
      |∫ s in (0:ℝ)..x0, φ s| ≤ M * x0 := by
    intro φ B M hφ hB hM
    have hint : IntervalIntegrable φ volume 0 X := by
      rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hX.le]
      refine Measure.integrableOn_of_bounded (M := B) ?_ hφ.aestronglyMeasurable ?_
      · rw [Real.volume_Ioc]; exact ENNReal.ofReal_ne_top
      · refine ae_restrict_of_forall_mem measurableSet_Ioc ?_
        intro s hs
        rw [Real.norm_eq_abs]; exact hB s hs.1.le hs.2
    have h1 : IntervalIntegrable φ volume 0 x0 := hint.mono_set (by
      rw [Set.uIcc_of_le hx0.le, Set.uIcc_of_le hX.le]; exact Set.Icc_subset_Icc le_rfl hx0X)
    have h2 : IntervalIntegrable φ volume x0 X := hint.mono_set (by
      rw [Set.uIcc_of_le hx0X, Set.uIcc_of_le hX.le]; exact Set.Icc_subset_Icc hx0.le le_rfl)
    refine ⟨(intervalIntegral.integral_add_adjacent_intervals h1 h2).symm, ?_⟩
    have hh := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := x0) (C := M)
      (f := φ) (fun s hs => by
        rw [Set.uIoc_of_le hx0.le] at hs
        rw [Real.norm_eq_abs]; exact hM s hs.1.le hs.2)
    rw [Real.norm_eq_abs, sub_zero, abs_of_pos hx0] at hh
    exact hh

  have tail1 : (∫ s in x0..X, Real.sqrt (2 * s) * g s)
      = Real.sqrt 2 * Cs * ((X ^ (1 - lam) - x0 ^ (1 - lam)) / (1 - lam)) := by
    have hcongr : ∀ s ∈ Set.uIcc x0 X, Real.sqrt (2 * s) * g s = Real.sqrt 2 * Cs * s ^ (-lam) := by
      intro s hs
      rw [Set.uIcc_of_le hx0X] at hs
      have hs0 : 0 < s := lt_of_lt_of_le hx0 hs.1
      rw [hpow s hs.1 hs.2, Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2), Real.sqrt_eq_rpow s]
      have e : s ^ (1 / (2:ℝ)) * s ^ (-(1 / 2 + lam)) = s ^ (-lam) := by
        rw [← Real.rpow_add hs0]; congr 1; ring
      rw [← e]; ring
    rw [intervalIntegral.integral_congr hcongr, intervalIntegral.integral_const_mul,
      integral_rpow (Or.inl (by linarith))]
    rw [show -lam + 1 = 1 - lam by ring]
  have tail2 : (∫ s in x0..X, κ s) = 0 := by
    have hcongr : ∀ s ∈ Set.uIcc x0 X, κ s = (fun _ => (0:ℝ)) s := by
      intro s hs
      rw [Set.uIcc_of_le hx0X] at hs
      exact hk0 s hs.1 hs.2
    rw [intervalIntegral.integral_congr hcongr]
    simp
  have tail3 : (∫ s in x0..X, Real.sqrt (2 * s) * g s * κ s) = 0 := by
    have hcongr : ∀ s ∈ Set.uIcc x0 X, Real.sqrt (2 * s) * g s * κ s = (fun _ => (0:ℝ)) s := by
      intro s hs
      rw [Set.uIcc_of_le hx0X] at hs
      simp [hk0 s hs.1 hs.2]
    rw [intervalIntegral.integral_congr hcongr]
    simp

  have hgX : g X = Cs * X ^ (-(1 / 2 + lam)) := hpow X hx0X le_rfl
  have hD : X * (Real.sqrt (2 * X) * g X) = Real.sqrt 2 * Cs * X ^ (1 - lam) := by
    rw [hgX, Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2), Real.sqrt_eq_rpow X]
    have h3 : X ^ (1:ℝ) * (X ^ (1 / (2:ℝ)) * X ^ (-(1 / 2 + lam))) = X ^ (1 - lam) := by
      rw [← Real.rpow_add hX, ← Real.rpow_add hX]; congr 1; ring
    rw [Real.rpow_one] at h3
    rw [← h3]; ring

  have hl' : 0 < 1 - lam := by linarith
  have hEpos : 0 < X ^ (1 - lam) := Real.rpow_pos_of_pos hX _
  have hDpos : 0 < Real.sqrt 2 * Cs * X ^ (1 - lam) := by positivity
  have hapos : 0 ≤ x0 ^ (1 / 2 + lam) := Real.rpow_nonneg hx0.le _
  have hεnn := Real.sqrt_nonneg (x0 / X)
  have ht0 : 0 < x0 / X := div_pos hx0 hX
  have ht1 : x0 / X ≤ 1 := (div_le_one hX).2 hx0X
  have hb : x0 ^ (1 / 2 - lam) ≤ X ^ (1 / 2 - lam) := Real.rpow_le_rpow hx0.le hx0X (by linarith)
  have hab : x0 ^ (1 / 2 + lam) * x0 ^ (1 / 2 - lam) = x0 := by
    rw [← Real.rpow_add hx0, show (1 / 2 + lam) + (1 / 2 - lam) = (1:ℝ) by ring, Real.rpow_one]
  have hcX : X ^ (1 / 2 - lam) * Real.sqrt X = X ^ (1 - lam) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_add hX]; congr 1; ring
  have hε : Real.sqrt (x0 / X) * Real.sqrt X = Real.sqrt x0 := by
    rw [← Real.sqrt_mul (div_nonneg hx0.le hX.le)]; congr 1; field_simp
  have hhead : Real.sqrt (2 * x0) * x0
      ≤ Real.sqrt 2 * (x0 ^ (1 / 2 + lam) * Real.sqrt (x0 / X)) * X ^ (1 - lam) := by
    rw [← hcX, Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2)]
    calc Real.sqrt 2 * Real.sqrt x0 * x0
        = Real.sqrt 2 * Real.sqrt x0 * x0 ^ (1 / 2 + lam) * x0 ^ (1 / 2 - lam) := by
          rw [mul_assoc (Real.sqrt 2 * Real.sqrt x0), hab]
      _ ≤ Real.sqrt 2 * Real.sqrt x0 * x0 ^ (1 / 2 + lam) * X ^ (1 / 2 - lam) :=
          mul_le_mul_of_nonneg_left hb (by positivity)
      _ = Real.sqrt 2 * (x0 ^ (1 / 2 + lam) * (Real.sqrt (x0 / X) * Real.sqrt X))
            * X ^ (1 / 2 - lam) := by rw [hε]; ring
      _ = _ := by ring
  have hdef : x0 ^ (1 - lam) / ((1 - lam) * X ^ (1 - lam)) ≤ 2 * Real.sqrt (x0 / X) := by
    have h1 : x0 ^ (1 - lam) / X ^ (1 - lam) ≤ Real.sqrt (x0 / X) := by
      rw [← Real.div_rpow hx0.le hX.le, Real.sqrt_eq_rpow]
      exact Real.rpow_le_rpow_of_exponent_ge ht0 ht1 (by linarith)
    rw [mul_comm, ← div_div, div_le_iff₀ hl']
    nlinarith
  have htle : x0 / X ≤ Real.sqrt (x0 / X) := by
    have h1 := Real.sq_sqrt ht0.le
    have h2 : Real.sqrt (x0 / X) ≤ 1 := Real.sqrt_le_one.mpr ht1
    nlinarith
  have hK : P1 * x0 ^ (1 / 2 + lam) / Cs * Real.sqrt (x0 / X) * (Real.sqrt 2 * Cs * X ^ (1 - lam))
      = P1 * (Real.sqrt 2 * (x0 ^ (1 / 2 + lam) * Real.sqrt (x0 / X)) * X ^ (1 - lam)) := by
    field_simp

  have hφ1m : Measurable (fun s => Real.sqrt (2 * s) * g s) := Measurable.mul (by fun_prop) hgm
  have hφ3m : Measurable (fun s => Real.sqrt (2 * s) * g s * κ s) := hφ1m.mul hκm
  have b1 : ∀ Y, Y ≤ X → ∀ s, 0 ≤ s → s ≤ Y → |Real.sqrt (2 * s) * g s| ≤ Real.sqrt (2 * Y) * P1 := by
    intro Y hY s hs0 hsY
    have hgs := hg s hs0 (le_trans hsY hY)
    rw [abs_of_nonneg (mul_nonneg (Real.sqrt_nonneg _) hgs.1)]
    exact mul_le_mul (Real.sqrt_le_sqrt (by linarith)) hgs.2 hgs.1 (Real.sqrt_nonneg _)
  have b2 : ∀ s, 0 ≤ s → s ≤ X → |κ s| ≤ 4 := by
    intro s hs0 hsX
    have := hk s hs0 hsX
    rw [abs_of_nonneg this.1]; exact this.2
  have b3 : ∀ Y, Y ≤ X → ∀ s, 0 ≤ s → s ≤ Y →
      |Real.sqrt (2 * s) * g s * κ s| ≤ Real.sqrt (2 * Y) * P1 * 4 := by
    intro Y hY s hs0 hsY
    rw [abs_mul]
    exact mul_le_mul (b1 Y hY s hs0 hsY) (b2 s hs0 (le_trans hsY hY)) (abs_nonneg _)
      (mul_nonneg (Real.sqrt_nonneg _) hP1)
  obtain ⟨S1, H1⟩ := split (fun s => Real.sqrt (2 * s) * g s) _ _ hφ1m (b1 X le_rfl) (b1 x0 hx0X)
  obtain ⟨S2, H2⟩ := split κ _ _ hκm b2 (fun s h0 h1 => b2 s h0 (le_trans h1 hx0X))
  obtain ⟨S3, H3⟩ := split (fun s => Real.sqrt (2 * s) * g s * κ s) _ _ hφ3m (b3 X le_rfl)
    (b3 x0 hx0X)
  rw [hD]
  have hhP := mul_le_mul_of_nonneg_left hhead hP1
  refine ⟨?_, ?_, ?_⟩
  · rw [S1, tail1]
    set H := ∫ s in (0:ℝ)..x0, Real.sqrt (2 * s) * g s with hHdef
    have alg : (H + Real.sqrt 2 * Cs * ((X ^ (1 - lam) - x0 ^ (1 - lam)) / (1 - lam)))
          / (Real.sqrt 2 * Cs * X ^ (1 - lam)) - 1 / (1 - lam)
        = H / (Real.sqrt 2 * Cs * X ^ (1 - lam)) - x0 ^ (1 - lam) / ((1 - lam) * X ^ (1 - lam)) := by
      field_simp
      ring
    rw [alg]
    have hq : |H / (Real.sqrt 2 * Cs * X ^ (1 - lam))|
        ≤ P1 * x0 ^ (1 / 2 + lam) / Cs * Real.sqrt (x0 / X) := by
      rw [abs_div, abs_of_pos hDpos, div_le_iff₀ hDpos, hK]
      calc |H| ≤ Real.sqrt (2 * x0) * P1 * x0 := H1
        _ = P1 * (Real.sqrt (2 * x0) * x0) := by ring
        _ ≤ _ := hhP
    have hdn : 0 ≤ x0 ^ (1 - lam) / ((1 - lam) * X ^ (1 - lam)) := by positivity
    calc _ ≤ |H / (Real.sqrt 2 * Cs * X ^ (1 - lam))|
          + |x0 ^ (1 - lam) / ((1 - lam) * X ^ (1 - lam))| := abs_sub _ _
      _ ≤ _ := by rw [abs_of_nonneg hdn]; nlinarith
  · rw [S2, tail2, add_zero, abs_div, abs_of_pos hX, div_le_iff₀ hX]
    nlinarith [mul_le_mul_of_nonneg_left htle (by norm_num : (0:ℝ) ≤ 4), div_mul_cancel₀ x0 hX.ne']
  · rw [S3, tail3, add_zero, abs_div, abs_of_pos hDpos, div_le_iff₀ hDpos,
      show 4 * (P1 * x0 ^ (1 / 2 + lam) / Cs) * Real.sqrt (x0 / X) * (Real.sqrt 2 * Cs * X ^ (1 - lam))
        = 4 * (P1 * x0 ^ (1 / 2 + lam) / Cs * Real.sqrt (x0 / X) * (Real.sqrt 2 * Cs * X ^ (1 - lam)))
        by ring, hK]
    calc _ ≤ Real.sqrt (2 * x0) * P1 * 4 * x0 := H3
      _ = 4 * (P1 * (Real.sqrt (2 * x0) * x0)) := by ring
      _ ≤ _ := by linarith

theorem pqc_scalar_phi : ∀ (lam x0 X Cs P1 : ℝ) (g φ : ℝ → ℝ), 0 < lam → lam ≤ 1 / 100 → 0 < x0 → x0 ≤ X → 0 < Cs → Measurable g → Measurable φ → (∀ s : ℝ, 0 ≤ s → s ≤ X → 0 ≤ g s ∧ g s ≤ P1) → (∀ s : ℝ, x0 ≤ s → s ≤ X → g s = Cs * s ^ (-(1 / 2 + lam))) → (∀ s : ℝ, 0 ≤ s → s ≤ X → |φ s| ≤ 11) → |(∫ s in (0:ℝ)..X, g s * φ s) / X| ≤ 34 * P1 * Real.sqrt (x0 / X) ∧ |(∫ s in (0:ℝ)..X, Real.sqrt (2 * s) * g s ^ 2 * φ s) / (X * (Real.sqrt (2 * X) * g X))| ≤ (11 * P1 * (P1 * x0 ^ (1 / 2 + lam) / Cs) + 23 * P1) * Real.sqrt (x0 / X) :=
by
  intro lam x0 X Cs P1 g φ hl0 hl1 hx0 hx0X hCs hgm hφm hg hpow hφ
  have hX : 0 < X := lt_of_lt_of_le hx0 hx0X
  have hP1 : 0 ≤ P1 := le_trans (hg 0 le_rfl hX.le).1 (hg 0 le_rfl hX.le).2

  have split : ∀ (ψ : ℝ → ℝ) (B M : ℝ), Measurable ψ → (∀ s, 0 ≤ s → s ≤ X → |ψ s| ≤ B) →
      (∀ s, 0 ≤ s → s ≤ x0 → |ψ s| ≤ M) →
      (∫ s in (0:ℝ)..X, ψ s) = (∫ s in (0:ℝ)..x0, ψ s) + (∫ s in x0..X, ψ s) ∧
      |∫ s in (0:ℝ)..x0, ψ s| ≤ M * x0 := by
    intro ψ B M hψ hB hM
    have hint : IntervalIntegrable ψ volume 0 X := by
      rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hX.le]
      refine Measure.integrableOn_of_bounded (M := B) ?_ hψ.aestronglyMeasurable ?_
      · rw [Real.volume_Ioc]; exact ENNReal.ofReal_ne_top
      · refine ae_restrict_of_forall_mem measurableSet_Ioc ?_
        intro s hs
        rw [Real.norm_eq_abs]; exact hB s hs.1.le hs.2
    have h1 : IntervalIntegrable ψ volume 0 x0 := hint.mono_set (by
      rw [Set.uIcc_of_le hx0.le, Set.uIcc_of_le hX.le]; exact Set.Icc_subset_Icc le_rfl hx0X)
    have h2 : IntervalIntegrable ψ volume x0 X := hint.mono_set (by
      rw [Set.uIcc_of_le hx0X, Set.uIcc_of_le hX.le]; exact Set.Icc_subset_Icc hx0.le le_rfl)
    refine ⟨(intervalIntegral.integral_add_adjacent_intervals h1 h2).symm, ?_⟩
    have hh := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := x0) (C := M)
      (f := ψ) (fun s hs => by
        rw [Set.uIoc_of_le hx0.le] at hs
        rw [Real.norm_eq_abs]; exact hM s hs.1.le hs.2)
    rw [Real.norm_eq_abs, sub_zero, abs_of_pos hx0] at hh
    exact hh

  have tailb : ∀ (ψ : ℝ → ℝ) (c r : ℝ), -1 < r → 0 ≤ c →
      (∀ s, x0 ≤ s → s ≤ X → |ψ s| ≤ c * s ^ r) →
      |∫ s in x0..X, ψ s| ≤ c * (X ^ (r + 1) / (r + 1)) := by
    intro ψ c r hr hc hb
    have h1 := intervalIntegral.norm_integral_le_of_norm_le (μ := volume) (f := ψ)
      (g := fun s => c * s ^ r) hx0X
      (ae_of_all _ (fun s hs => by rw [Real.norm_eq_abs]; exact hb s hs.1.le hs.2))
      ((intervalIntegral.intervalIntegrable_rpow' hr).const_mul c)
    rw [Real.norm_eq_abs, intervalIntegral.integral_const_mul, integral_rpow (Or.inl hr)] at h1
    refine h1.trans (mul_le_mul_of_nonneg_left ?_ hc)
    have hr1 : 0 < r + 1 := by linarith
    have : 0 ≤ x0 ^ (r + 1) := Real.rpow_nonneg hx0.le _
    exact div_le_div_of_nonneg_right (by linarith) hr1.le

  have ht0 : 0 < x0 / X := div_pos hx0 hX
  have ht1 : x0 / X ≤ 1 := (div_le_one hX).2 hx0X
  have hεnn := Real.sqrt_nonneg (x0 / X)
  have hCsP : Cs ≤ P1 * x0 ^ (1 / 2 + lam) := by
    have h1 := (hg x0 hx0.le hx0X).2
    rw [hpow x0 le_rfl hx0X, Real.rpow_neg hx0.le, ← div_eq_mul_inv,
      div_le_iff₀ (Real.rpow_pos_of_pos hx0 _)] at h1
    exact h1
  have hEpos : 0 < X ^ (-(1 / 2 + lam)) := Real.rpow_pos_of_pos hX _
  have hu : Cs * X ^ (-(1 / 2 + lam)) ≤ P1 * Real.sqrt (x0 / X) := by
    have e1 : x0 ^ (1 / 2 + lam) * X ^ (-(1 / 2 + lam)) = (x0 / X) ^ (1 / 2 + lam) := by
      rw [Real.div_rpow hx0.le hX.le, Real.rpow_neg hX.le]
      exact (div_eq_mul_inv _ _).symm
    have e2 : (x0 / X) ^ (1 / 2 + lam) ≤ Real.sqrt (x0 / X) := by
      rw [Real.sqrt_eq_rpow]
      exact Real.rpow_le_rpow_of_exponent_ge ht0 ht1 (by linarith)
    calc Cs * X ^ (-(1 / 2 + lam)) ≤ P1 * x0 ^ (1 / 2 + lam) * X ^ (-(1 / 2 + lam)) :=
          mul_le_mul_of_nonneg_right hCsP hEpos.le
      _ = P1 * (x0 / X) ^ (1 / 2 + lam) := by rw [mul_assoc, e1]
      _ ≤ P1 * Real.sqrt (x0 / X) := mul_le_mul_of_nonneg_left e2 hP1
  have htle : x0 / X ≤ Real.sqrt (x0 / X) := by
    have h1 := Real.sq_sqrt ht0.le
    have h2 : Real.sqrt (x0 / X) ≤ 1 := Real.sqrt_le_one.mpr ht1
    nlinarith
  have hx0t : x0 ≤ Real.sqrt (x0 / X) * X := by
    have := mul_le_mul_of_nonneg_right htle hX.le
    rwa [div_mul_cancel₀ x0 hX.ne'] at this
  refine ⟨?_, ?_⟩
  ·
    have hm : Measurable (fun s => g s * φ s) := hgm.mul hφm
    have hb : ∀ s, 0 ≤ s → s ≤ X → |g s * φ s| ≤ P1 * 11 := by
      intro s h0 h1
      have hgs := hg s h0 h1
      rw [abs_mul, abs_of_nonneg hgs.1]
      exact mul_le_mul hgs.2 (hφ s h0 h1) (abs_nonneg _) hP1
    obtain ⟨S, H⟩ := split (fun s => g s * φ s) _ _ hm hb
      (fun s h0 h1 => hb s h0 (le_trans h1 hx0X))
    have T := tailb (fun s => g s * φ s) (11 * Cs) (-(1 / 2 + lam)) (by linarith) (by positivity)
      (by
        intro s h1 h2
        have hs0 : 0 < s := lt_of_lt_of_le hx0 h1
        have hp : 0 < Cs * s ^ (-(1 / 2 + lam)) := mul_pos hCs (Real.rpow_pos_of_pos hs0 _)
        show |g s * φ s| ≤ 11 * Cs * s ^ (-(1 / 2 + lam))
        rw [abs_mul, hpow s h1 h2, abs_of_pos hp]
        calc Cs * s ^ (-(1 / 2 + lam)) * |φ s| ≤ Cs * s ^ (-(1 / 2 + lam)) * 11 :=
              mul_le_mul_of_nonneg_left (hφ s (hx0.le.trans h1) h2) hp.le
          _ = 11 * Cs * s ^ (-(1 / 2 + lam)) := by ring)
    have hden : 0 < -(1 / 2 + lam) + 1 := by linarith
    have hT2 : 11 * Cs * (X ^ (-(1 / 2 + lam) + 1) / (-(1 / 2 + lam) + 1))
        ≤ 23 * (P1 * Real.sqrt (x0 / X) * X) := by
      rw [Real.rpow_add hX, Real.rpow_one, mul_div_assoc', div_le_iff₀ hden]
      have hu' := mul_le_mul_of_nonneg_right hu hX.le
      have hQ : 0 ≤ P1 * Real.sqrt (x0 / X) * X := by positivity
      nlinarith [mul_nonneg hQ (show 0 ≤ 23 * (-(1 / 2 + lam) + 1) - 11 by linarith)]
    rw [S, abs_div, abs_of_pos hX, div_le_iff₀ hX]
    have hPx := mul_le_mul_of_nonneg_left hx0t hP1
    have hsum := abs_add_le (∫ s in (0:ℝ)..x0, g s * φ s) (∫ s in x0..X, g s * φ s)
    nlinarith
  ·
    have hm : Measurable (fun s => Real.sqrt (2 * s) * g s ^ 2 * φ s) :=
      ((by fun_prop : Measurable fun s : ℝ => Real.sqrt (2 * s)).mul (hgm.pow_const 2)).mul hφm
    have hb : ∀ Y, Y ≤ X → ∀ s, 0 ≤ s → s ≤ Y →
        |Real.sqrt (2 * s) * g s ^ 2 * φ s| ≤ Real.sqrt (2 * Y) * P1 ^ 2 * 11 := by
      intro Y hY s h0 h1
      have hgs := hg s h0 (le_trans h1 hY)
      rw [abs_mul, abs_mul, abs_of_nonneg (Real.sqrt_nonneg _), abs_of_nonneg (sq_nonneg _)]
      exact mul_le_mul (mul_le_mul (Real.sqrt_le_sqrt (by linarith))
        (pow_le_pow_left₀ hgs.1 hgs.2 2) (sq_nonneg _) (Real.sqrt_nonneg _))
        (hφ s h0 (le_trans h1 hY)) (abs_nonneg _) (by positivity)
    obtain ⟨S, H⟩ := split (fun s => Real.sqrt (2 * s) * g s ^ 2 * φ s) _ _ hm (hb X le_rfl)
      (hb x0 hx0X)
    have T := tailb (fun s => Real.sqrt (2 * s) * g s ^ 2 * φ s) (11 * Real.sqrt 2 * Cs ^ 2)
      (-(1 / 2 + 2 * lam)) (by linarith) (by positivity)
      (by
        intro s h1 h2
        have hs0 : 0 < s := lt_of_lt_of_le hx0 h1
        have hid : Real.sqrt (2 * s) * g s ^ 2 = Real.sqrt 2 * Cs ^ 2 * s ^ (-(1 / 2 + 2 * lam)) := by
          rw [hpow s h1 h2, Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2), Real.sqrt_eq_rpow s]
          have e : s ^ (1 / (2:ℝ)) * (s ^ (-(1 / 2 + lam))) ^ 2 = s ^ (-(1 / 2 + 2 * lam)) := by
            rw [sq, ← Real.rpow_add hs0, ← Real.rpow_add hs0]; congr 1; ring
          rw [← e]; ring
        have hp : 0 ≤ Real.sqrt 2 * Cs ^ 2 * s ^ (-(1 / 2 + 2 * lam)) :=
          mul_nonneg (by positivity) (Real.rpow_nonneg hs0.le _)
        show |Real.sqrt (2 * s) * g s ^ 2 * φ s| ≤ 11 * Real.sqrt 2 * Cs ^ 2 * s ^ (-(1 / 2 + 2 * lam))
        rw [hid, abs_mul, abs_of_nonneg hp]
        calc Real.sqrt 2 * Cs ^ 2 * s ^ (-(1 / 2 + 2 * lam)) * |φ s|
            ≤ Real.sqrt 2 * Cs ^ 2 * s ^ (-(1 / 2 + 2 * lam)) * 11 :=
              mul_le_mul_of_nonneg_left (hφ s (hx0.le.trans h1) h2) hp
          _ = 11 * Real.sqrt 2 * Cs ^ 2 * s ^ (-(1 / 2 + 2 * lam)) := by ring)

    have hgX : g X = Cs * X ^ (-(1 / 2 + lam)) := hpow X hx0X le_rfl
    have hD : X * (Real.sqrt (2 * X) * g X) = Real.sqrt 2 * Cs * X ^ (1 - lam) := by
      rw [hgX, Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2), Real.sqrt_eq_rpow X]
      have h3 : X ^ (1:ℝ) * (X ^ (1 / (2:ℝ)) * X ^ (-(1 / 2 + lam))) = X ^ (1 - lam) := by
        rw [← Real.rpow_add hX, ← Real.rpow_add hX]; congr 1; ring
      rw [Real.rpow_one] at h3
      rw [← h3]; ring
    have hDpos : 0 < Real.sqrt 2 * Cs * X ^ (1 - lam) := by
      have := Real.rpow_pos_of_pos hX (1 - lam)
      positivity
    have hb' : x0 ^ (1 / 2 - lam) ≤ X ^ (1 / 2 - lam) := Real.rpow_le_rpow hx0.le hx0X (by linarith)
    have hab : x0 ^ (1 / 2 + lam) * x0 ^ (1 / 2 - lam) = x0 := by
      rw [← Real.rpow_add hx0, show (1 / 2 + lam) + (1 / 2 - lam) = (1:ℝ) by ring, Real.rpow_one]
    have hcX : X ^ (1 / 2 - lam) * Real.sqrt X = X ^ (1 - lam) := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_add hX]; congr 1; ring
    have hε : Real.sqrt (x0 / X) * Real.sqrt X = Real.sqrt x0 := by
      rw [← Real.sqrt_mul (div_nonneg hx0.le hX.le)]; congr 1; field_simp
    have hhead : Real.sqrt (2 * x0) * x0
        ≤ Real.sqrt 2 * (x0 ^ (1 / 2 + lam) * Real.sqrt (x0 / X)) * X ^ (1 - lam) := by
      rw [← hcX, Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2)]
      calc Real.sqrt 2 * Real.sqrt x0 * x0
          = Real.sqrt 2 * Real.sqrt x0 * x0 ^ (1 / 2 + lam) * x0 ^ (1 / 2 - lam) := by
            rw [mul_assoc (Real.sqrt 2 * Real.sqrt x0), hab]
        _ ≤ Real.sqrt 2 * Real.sqrt x0 * x0 ^ (1 / 2 + lam) * X ^ (1 / 2 - lam) :=
            mul_le_mul_of_nonneg_left hb' (by positivity)
        _ = Real.sqrt 2 * (x0 ^ (1 / 2 + lam) * (Real.sqrt (x0 / X) * Real.sqrt X))
              * X ^ (1 / 2 - lam) := by rw [hε]; ring
        _ = _ := by ring
    have hK : P1 * x0 ^ (1 / 2 + lam) / Cs * Real.sqrt (x0 / X) * (Real.sqrt 2 * Cs * X ^ (1 - lam))
        = P1 * (Real.sqrt 2 * (x0 ^ (1 / 2 + lam) * Real.sqrt (x0 / X)) * X ^ (1 - lam)) := by
      field_simp
    have hHK : |∫ s in (0:ℝ)..x0, Real.sqrt (2 * s) * g s ^ 2 * φ s|
        ≤ 11 * P1 * (P1 * x0 ^ (1 / 2 + lam) / Cs * Real.sqrt (x0 / X)
          * (Real.sqrt 2 * Cs * X ^ (1 - lam))) := by
      rw [hK]
      have := mul_le_mul_of_nonneg_left hhead (mul_nonneg (by norm_num : (0:ℝ) ≤ 11)
        (mul_nonneg hP1 hP1))
      calc _ ≤ Real.sqrt (2 * x0) * P1 ^ 2 * 11 * x0 := H
        _ = 11 * P1 * P1 * (Real.sqrt (2 * x0) * x0) := by ring
        _ ≤ _ := by linarith
    have hden : 0 < -(1 / 2 + 2 * lam) + 1 := by linarith
    have hT2 : 11 * Real.sqrt 2 * Cs ^ 2 * (X ^ (-(1 / 2 + 2 * lam) + 1) / (-(1 / 2 + 2 * lam) + 1))
        ≤ 23 * P1 * Real.sqrt (x0 / X) * (Real.sqrt 2 * Cs * X ^ (1 - lam)) := by
      rw [show -(1 / 2 + 2 * lam) + 1 = (1 - lam) + (-(1 / 2 + lam)) by ring, Real.rpow_add hX,
        mul_div_assoc', div_le_iff₀ (by linarith)]
      have hW := hDpos.le
      have hu' := mul_le_mul_of_nonneg_left hu hW
      have hQ : 0 ≤ Real.sqrt 2 * Cs * X ^ (1 - lam) * (P1 * Real.sqrt (x0 / X)) := by positivity
      nlinarith [mul_nonneg hQ (show 0 ≤ 23 * ((1 - lam) + (-(1 / 2 + lam))) - 11 by linarith)]
    rw [hD, S, abs_div, abs_of_pos hDpos, div_le_iff₀ hDpos]
    have hsum := abs_add_le (∫ s in (0:ℝ)..x0, Real.sqrt (2 * s) * g s ^ 2 * φ s)
      (∫ s in x0..X, Real.sqrt (2 * s) * g s ^ 2 * φ s)
    nlinarith

theorem pqc_rinC_facts : ∀ Md Pst lam : ℝ, 0 < Pst → 0 ≤ lam → lam ≤ 1 / 100 → Continuous (rinC Md Pst lam) ∧ (∀ y : ℝ, 0 < rinC Md Pst lam y) ∧ (∀ y : ℝ, rinC Md Pst lam y ≤ Pst * Real.exp (1 / 10)) ∧ (∀ y : ℝ, rfpY2 Md + 1 ≤ y → rinC Md Pst lam y = rinC Md Pst lam (rfpY2 Md + 1) * Real.exp (-((1 / 2 + lam) * (y - (rfpY2 Md + 1))))) ∧ Pst * Real.exp (1 / 10) ≤ rinC Md Pst lam (rfpY2 Md + 1) * Real.exp (rfpY2 Md / 2 + 7 / 10) :=
by
  intro Md Pst lam hPst hlam0 hlam1
  have hbasics : (∀ y : ℝ, y ≤ 0 → sigA y = 0) ∧ (∀ y : ℝ, 1 ≤ y → sigA y = 1) ∧ (∀ y : ℝ, 0 ≤ sigA y ∧ sigA y ≤ 1) ∧ Continuous sigA ∧ Continuous rfpSigI ∧ (∀ t : ℝ, t ≤ 0 → rfpSigI t = 0) ∧ (∀ t : ℝ, 1 ≤ t → rfpSigI t = t - 1 + rfpSigI 1) ∧ 0 ≤ rfpSigI 1 ∧ rfpSigI 1 ≤ 1 := by
    have h1 : ∀ y : ℝ, y ≤ 0 → sigA y = 0 := by
      intro y hy
      unfold sigA
      rw [if_pos hy]
    have h2 : ∀ y : ℝ, 1 ≤ y → sigA y = 1 := by
      intro y hy
      unfold sigA
      rw [if_neg (by linarith), if_pos hy]
    have h3 : ∀ y : ℝ, 0 ≤ sigA y ∧ sigA y ≤ 1 := by
      intro y
      unfold sigA
      split_ifs
      · norm_num
      · norm_num
      · have ha := Real.exp_pos (-1 / y ^ 2)
        have hb := Real.exp_pos (-1 / (1 - y) ^ 2)
        refine ⟨div_nonneg ha.le (by linarith), ?_⟩
        rw [div_le_one (by linarith)]
        linarith
    have hcont : Continuous sigA := by
      set G : ℝ → ℝ := fun y => expNegInvGlue (max y 0 ^ 2) with hG
      have hGc : Continuous G :=
        ((expNegInvGlue.contDiff (n := 0)).continuous).comp ((continuous_id.max continuous_const).pow 2)
      have hG0 : ∀ y : ℝ, y ≤ 0 → G y = 0 := by
        intro y hy
        simp only [hG, max_eq_right hy]
        exact expNegInvGlue.zero_of_nonpos (by norm_num)
      have hGp : ∀ y : ℝ, 0 < y → G y = Real.exp (-1 / y ^ 2) := by
        intro y hy
        simp only [hG, max_eq_left hy.le]
        unfold expNegInvGlue
        rw [if_neg (not_le.mpr (pow_pos hy 2)), neg_div, one_div]
      have hGpos : ∀ y : ℝ, 0 < y → 0 < G y := by
        intro y hy
        rw [hGp y hy]; exact Real.exp_pos _
      have hGnn : ∀ y : ℝ, 0 ≤ G y := by
        intro y
        rcases le_or_gt y 0 with hy | hy
        · rw [hG0 y hy]
        · exact (hGpos y hy).le
      have hden : ∀ y : ℝ, G y + G (1 - y) ≠ 0 := by
        intro y
        rcases le_or_gt y 0 with hy | hy
        · have := hGpos (1 - y) (by linarith)
          have := hGnn y
          linarith
        · have := hGpos y hy
          have := hGnn (1 - y)
          linarith
      have heq : sigA = fun y => G y / (G y + G (1 - y)) := by
        funext y
        unfold sigA
        split_ifs with hy0 hy1
        · rw [hG0 y hy0, zero_div]
        · rw [hG0 (1 - y) (by linarith), add_zero, div_self (hGpos y (by linarith)).ne']
        · push_neg at hy0 hy1
          rw [hGp y hy0, hGp (1 - y) (by linarith)]
      rw [heq]
      exact hGc.div (hGc.add (hGc.comp (continuous_const.sub continuous_id))) hden
    have hII : ∀ a b : ℝ, IntervalIntegrable sigA MeasureTheory.volume a b :=
      fun a b => hcont.intervalIntegrable a b
    have hS : Continuous rfpSigI := by
      show Continuous (fun t => ∫ s in (0:ℝ)..t, sigA s)
      exact intervalIntegral.continuous_primitive hII 0
    have h6 : ∀ t : ℝ, t ≤ 0 → rfpSigI t = 0 := by
      intro t ht
      show (∫ s in (0:ℝ)..t, sigA s) = 0
      rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ))]
      · simp
      · intro s hs
        rw [Set.uIcc_of_ge ht] at hs
        exact h1 s hs.2
    have h7 : ∀ t : ℝ, 1 ≤ t → rfpSigI t = t - 1 + rfpSigI 1 := by
      intro t ht
      show (∫ s in (0:ℝ)..t, sigA s) = t - 1 + ∫ s in (0:ℝ)..1, sigA s
      rw [← intervalIntegral.integral_add_adjacent_intervals (hII 0 1) (hII 1 t)]
      have e : (∫ s in (1:ℝ)..t, sigA s) = ∫ s in (1:ℝ)..t, (1:ℝ) := by
        apply intervalIntegral.integral_congr
        intro s hs
        rw [Set.uIcc_of_le ht] at hs
        exact h2 s hs.1
      rw [e, intervalIntegral.integral_const, smul_eq_mul, mul_one]
      ring
    have h8 : 0 ≤ rfpSigI 1 := by
      show 0 ≤ ∫ s in (0:ℝ)..1, sigA s
      exact intervalIntegral.integral_nonneg (by norm_num) (fun u _ => (h3 u).1)
    have h9 : rfpSigI 1 ≤ 1 := by
      show (∫ s in (0:ℝ)..1, sigA s) ≤ 1
      have := intervalIntegral.integral_mono_on (by norm_num : (0:ℝ) ≤ 1) (hII 0 1)
        (intervalIntegrable_const : IntervalIntegrable (fun _ => (1:ℝ)) MeasureTheory.volume 0 1)
        (fun x _ => (h3 x).2)
      simpa using this
    exact ⟨h1, h2, h3, hcont, hS, h6, h7, h8, h9⟩
  obtain ⟨-, -, hsig01, -, hSc, hS0, hS1, hS1lo, hS1hi⟩ := hbasics
  have hSnn : ∀ t : ℝ, 0 ≤ rfpSigI t := by
    intro t
    rcases le_total t 0 with ht | ht
    · rw [hS0 t ht]
    · unfold rfpSigI
      exact intervalIntegral.integral_nonneg ht (fun u _ => (hsig01 u).1)
  have hy2 : 0 < rfpY2 Md := by unfold rfpY2; linarith [Real.exp_pos Md]
  have hE : ∀ y : ℝ, rinC Md Pst lam y =
      Pst * Real.exp (y / 10 - 3 / 5 * rfpSigI y - lam * rfpSigI (y - rfpY2 Md)) := fun y => rfl
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · have : rinC Md Pst lam =
        fun y => Pst * Real.exp (y / 10 - 3 / 5 * rfpSigI y - lam * rfpSigI (y - rfpY2 Md)) :=
      funext hE
    rw [this]
    exact continuous_const.mul (Continuous.rexp (((continuous_id.div_const 10).sub
      (continuous_const.mul hSc)).sub
      (continuous_const.mul (hSc.comp (continuous_id.sub continuous_const)))))
  · intro y
    rw [hE]
    exact mul_pos hPst (Real.exp_pos _)
  · intro y
    rw [hE]
    apply mul_le_mul_of_nonneg_left _ hPst.le
    apply Real.exp_le_exp.mpr
    have hb := mul_nonneg hlam0 (hSnn (y - rfpY2 Md))
    rcases le_total y 1 with hy | hy
    · linarith [hSnn y]
    · rw [hS1 y hy]
      linarith
  · intro y hy
    have h1 : 1 ≤ y := by linarith
    have h2 : 1 ≤ y - rfpY2 Md := by linarith
    have h3 : 1 ≤ rfpY2 Md + 1 := by linarith
    have h4 : rfpY2 Md + 1 - rfpY2 Md = 1 := by ring
    rw [hE, hE, hS1 y h1, hS1 _ h2, hS1 _ h3, h4, mul_assoc, ← Real.exp_add]
    congr 2
    ring
  · have h3 : 1 ≤ rfpY2 Md + 1 := by linarith
    have h4 : rfpY2 Md + 1 - rfpY2 Md = 1 := by ring
    rw [hE, hS1 _ h3, h4, mul_assoc, ← Real.exp_add]
    apply mul_le_mul_of_nonneg_left _ hPst.le
    apply Real.exp_le_exp.mpr
    have hm : lam * rfpSigI 1 ≤ 1 / 100 * 1 := mul_le_mul hlam1 hS1hi hS1lo (by norm_num)
    linarith

theorem pqc_rfp_rep : ∀ P : RfpPar, RfpRegime P → Continuous rfpR0 ∧ Continuous rfpBmp ∧ (∀ t : ℝ, 0 ≤ rfpBmp t ∧ rfpBmp t ≤ 1) ∧ (∀ y : ℝ, y ≤ rfpY4 P.Md P.lam → Real.exp (rfpLam P y) = rinC P.Md P.Pst P.lam y) ∧ ∀ s e : ℝ, 0 ≤ s → s ≤ rfpXv P → rfpU P s e = e * rfpK P.Md (Real.log s) + (1 + e ^ 2)⁻¹ * rinC P.Md P.Pst P.lam (Real.log s) * (P.Amp e * rfpR0 (P.lam * (Real.log s - rfpY3 P.Md P.lam)) + P.c1 e * rfpBmp (Real.log s - rfpY4 P.Md P.lam + 3) + P.c2 e * rfpBmp (Real.log s - rfpY4 P.Md P.lam + 1)) ∧ 2 * s * rfpF P s e = (1 + e ^ 2)⁻¹ * (Real.sqrt (2 * s) * rinC P.Md P.Pst P.lam (Real.log s)) :=
by
  intro P hP
  obtain ⟨hs0, -, hsb, hsc, -, hsI0, -, -, -⟩ := rfp_sig_basics
  obtain ⟨⟨h14, h45, h5b⟩, hcl, -, -, -⟩ := rfp_clamp_identities P hP
  have hP' := hP
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hP'

  have hR0 : Continuous rfpR0 := by
    have hprim : Continuous fun ξ : ℝ => ∫ v in (0:ℝ)..ξ, sigA (50 * v) :=
      intervalIntegral.continuous_primitive
        (fun a b => (hsc.comp (continuous_const.mul continuous_id)).intervalIntegrable a b) 0
    have h2 : Continuous fun ξ : ℝ => 1 - sigA (ξ - 10) :=
      continuous_const.sub (hsc.comp (continuous_id.sub continuous_const))
    exact hprim.mul h2

  have hBc : Continuous rfpBmp := by
    have h1 : Continuous fun t : ℝ => sigA (1 + t / (3 / 20)) :=
      hsc.comp (continuous_const.add (continuous_id.div_const _))
    have h2 : Continuous fun t : ℝ => sigA (1 - t / (3 / 20)) :=
      hsc.comp (continuous_const.sub (continuous_id.div_const _))
    exact h1.mul h2

  have hBb : ∀ t : ℝ, 0 ≤ rfpBmp t ∧ rfpBmp t ≤ 1 := by
    intro t
    have h1 := hsb (1 + t / (3 / 20))
    have h2 := hsb (1 - t / (3 / 20))
    unfold rfpBmp
    exact ⟨mul_nonneg h1.1 h2.1, mul_le_one₀ h1.2 h2.1 h2.2⟩

  have hlam2 : P.lam ^ 2 ≤ 1 / 10000 := by nlinarith
  have hh1 : P.h < 1 := by linarith
  have hT0 : 0 ≤ P.T1 := by
    have h1h : 1 ≤ 1 / P.h := by rw [le_div_iff₀ hh0]; linarith
    have := Real.log_nonneg h1h
    linarith
  have hρ1 : P.ρ < 1 := by linarith
  have hPst0 : 0 < P.Pst := lt_trans (Real.exp_pos _) hPst

  have hd : ∀ y : ℝ, y ≤ rfpY4 P.Md P.lam → Real.exp (rfpLam P y) = rinC P.Md P.Pst P.lam y := by
    intro y hy
    have e1 : rfpSigI (y - rfpY5 P.Md P.lam) = 0 := hsI0 _ (by linarith)
    have e2 : rfpSigI (y - rfpY5 P.Md P.lam - 1 - P.T1) = 0 := hsI0 _ (by linarith)
    have e3 : sigA ((y - rfpY4 P.Md P.lam) / 60) = 0 := hs0 _ (by linarith)
    have hz : (Real.log (Real.exp y / Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) + 2) / 2 ≤ 0 := by
      rw [← Real.exp_sub, Real.log_exp]
      unfold rfpYb
      linarith
    have e4 : tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) = 1 - P.ρ := by
      unfold tailFac
      rw [hs0 _ hz]
      ring
    have e5 : Real.log (tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) / (1 - P.ρ)) = 0 := by
      rw [e4, div_self (sub_pos.mpr hρ1).ne', Real.log_one]
    have hΛ : rfpLam P y = Real.log P.Pst + (y / 10 - 3 / 5 * rfpSigI y - P.lam * rfpSigI (y - rfpY2 P.Md)) := by
      unfold rfpLam
      rw [e1, e2, e3, e5]
      ring
    rw [hΛ, Real.exp_add, Real.exp_log hPst0]
    rfl
  refine ⟨hR0, hBc, hBb, hd, ?_⟩

  intro s e hs0' hs
  have hY : Real.log s ≤ rfpY4 P.Md P.lam := by
    rcases hs0'.eq_or_lt with h | h
    · rw [← h, Real.log_zero]
      linarith
    · calc Real.log s ≤ Real.log (rfpXv P) := Real.log_le_log h hs
        _ = rfpY4 P.Md P.lam := by unfold rfpXv; exact Real.log_exp _
  have hE : rfpE P (Real.log s) e = rinC P.Md P.Pst P.lam (Real.log s) * (1 + e ^ 2)⁻¹ := by
    unfold rfpE
    rw [mul_assoc, hcl _ _ hY, hd _ hY]
  refine ⟨?_, ?_⟩
  · unfold rfpU
    rw [hE]
    unfold rfpRb
    ring
  · unfold rfpF
    rw [hE]
    rcases hs0'.eq_or_lt with h | h
    · subst h
      simp
    · have hq : 0 < Real.sqrt (2 * s) := Real.sqrt_pos.mpr (by linarith)
      have hq2 : Real.sqrt (2 * s) ^ 2 = 2 * s := Real.sq_sqrt (by linarith)
      have alg : ∀ q A f : ℝ, q ≠ 0 → q ^ 2 = 2 * s → 2 * s * (A * f / q) = f * (q * A) := by
        intro q A f hq0 hqs
        rw [← hqs, div_eq_mul_inv]
        calc q ^ 2 * (A * f * q⁻¹) = (q * q⁻¹) * (q * A * f) := by ring
          _ = f * (q * A) := by rw [mul_inv_cancel₀ hq0]; ring
      exact alg _ _ _ hq.ne' hq2

theorem rfp_pulse_Q_close : rfpPref (fun P => ∀ x η : ℝ, rfpXk P 0 ≤ x → x ≤ rfpXv P → -1 ≤ η → η ≤ 1 → |leadQs P.h (rfpF P) (rfpU P) x η - (P.lam - P.h + (1 - 2 * P.h) * η ^ 2 / (1 + η ^ 2)) / (1 - P.lam)| ≤ P.lam ^ 3) :=
by
  obtain ⟨B0, hB0, HR⟩ := rfp_r0_bounds
  obtain ⟨-, HK⟩ := rfp_inner_kC_facts
  refine ⟨1, one_pos, ?_⟩
  intro Md hMd
  refine ⟨1, ?_⟩
  intro Pst hPst
  obtain ⟨E, hE⟩ : ∃ E : ℝ, E = Real.exp (rfpY2 Md / 2 + 7 / 10) := ⟨_, rfl⟩
  obtain ⟨P1, hP1⟩ : ∃ P1 : ℝ, P1 = Pst * Real.exp (1 / 10) := ⟨_, rfl⟩
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ℝ, Θ = 4 + 4 * E + 11 * P1 * E + 34 * P1 := ⟨_, rfl⟩
  have hE0 : 0 < E := by rw [hE]; exact Real.exp_pos _
  have hP10 : 0 < P1 := by rw [hP1]; exact mul_pos (by linarith) (Real.exp_pos _)
  have hΘ0 : 0 < Θ := by rw [hΘ]; positivity
  refine ⟨min (1 / 100) (1 / (40 * Θ)), lt_min (by norm_num) (by positivity), ?_⟩
  intro lam hlam hlaml
  refine ⟨1, one_pos, ?_⟩
  intro P hPMd hPPst hPlam _ hReg hClos
  subst hPMd hPPst hPlam
  intro x η hx1 hx2 he1 he2
  have hReg' := hReg
  obtain ⟨hMd0, -, hl0, hl100, hh0, hhl, -⟩ := hReg'
  have hPst0 : 0 < P.Pst := by linarith
  obtain ⟨hCcont, hCpos, hCle, hCaff, hCE⟩ := pqc_rinC_facts P.Md P.Pst P.lam hPst0 hl0.le hl100
  obtain ⟨hR0c, hBc, hBb, -, hrep⟩ := pqc_rfp_rep P hReg
  obtain ⟨hKd, hKb, -, hK0, -, -⟩ := HK P.Md P.Pst P.lam hMd0 hPst0
  obtain ⟨hAc, hc1c, hc2c, -, hAmp, -⟩ := hClos
  obtain ⟨hA1, hA2, hAd, hc1b, hc2b⟩ := hAmp η he1 he2
  have hl1 : P.lam ≤ 1 := by linarith
  have hh100 : P.h ≤ 1 / 100 := by nlinarith

  have hxk0 : 0 < rfpXk P 0 := by unfold rfpXk; exact Real.exp_pos _
  have hx0 : 0 < x := lt_of_lt_of_le hxk0 hx1
  have hlog : 0 ≤ Real.log (1 / P.lam) := by
    rw [one_div, Real.log_inv]; linarith [Real.log_nonpos hl0.le hl1]
  obtain ⟨x0, hx0d⟩ : ∃ x0 : ℝ, x0 = Real.exp (rfpY2 P.Md + 1) := ⟨_, rfl⟩
  have hx00 : 0 < x0 := by rw [hx0d]; exact Real.exp_pos _
  have hxk : rfpXk P 0 = Real.exp (rfpY3 P.Md P.lam) := by unfold rfpXk; rw [sub_zero]
  have hx0x : x0 ≤ x := by
    refine le_trans ?_ hx1
    rw [hxk, hx0d]
    apply Real.exp_le_exp.mpr
    unfold rfpY3
    linarith

  have hlogm := Real.measurable_log
  have hκm : Measurable (fun s : ℝ => rfpK P.Md (Real.log s)) :=
    hKd.continuous.measurable.comp hlogm
  have hgm : Measurable (fun s : ℝ => rinC P.Md P.Pst P.lam (Real.log s)) :=
    hCcont.measurable.comp hlogm
  have hφ0m : Measurable (fun s : ℝ => rfpR0 (P.lam * (Real.log s - rfpY3 P.Md P.lam))) :=
    hR0c.measurable.comp ((hlogm.sub_const _).const_mul _)
  have hφ1m : Measurable (fun s : ℝ => rfpBmp (Real.log s - rfpY4 P.Md P.lam + 3)) :=
    hBc.measurable.comp ((hlogm.sub_const _).add_const _)
  have hφ2m : Measurable (fun s : ℝ => rfpBmp (Real.log s - rfpY4 P.Md P.lam + 1)) :=
    hBc.measurable.comp ((hlogm.sub_const _).add_const _)

  have hgP : ∀ s : ℝ, 0 ≤ rinC P.Md P.Pst P.lam (Real.log s) ∧
      rinC P.Md P.Pst P.lam (Real.log s) ≤ P1 :=
    fun s => ⟨(hCpos _).le, by rw [hP1]; exact hCle _⟩
  have hφ0b : ∀ s : ℝ, |rfpR0 (P.lam * (Real.log s - rfpY3 P.Md P.lam))| ≤ 11 := by
    intro s
    obtain ⟨a, b, -, -⟩ := HR (P.lam * (Real.log s - rfpY3 P.Md P.lam))
    rw [abs_le]; constructor <;> linarith
  have hBmp11 : ∀ t : ℝ, |rfpBmp t| ≤ 11 := by
    intro t
    obtain ⟨a, b⟩ := hBb t
    rw [abs_le]; constructor <;> linarith
  have hκb : ∀ s : ℝ, |rfpK P.Md (Real.log s)| ≤ 4 := by
    intro s
    obtain ⟨a, b⟩ := hKb (Real.log s)
    rw [abs_le]; constructor <;> linarith
  have hbnd : ∀ s : ℝ, 0 ≤ s → s ≤ x → |rfpK P.Md (Real.log s)| ≤ 4 + P1 + 11 ∧
      |rinC P.Md P.Pst P.lam (Real.log s)| ≤ 4 + P1 + 11 ∧
      |rfpR0 (P.lam * (Real.log s - rfpY3 P.Md P.lam))| ≤ 4 + P1 + 11 ∧
      |rfpBmp (Real.log s - rfpY4 P.Md P.lam + 3)| ≤ 4 + P1 + 11 ∧
      |rfpBmp (Real.log s - rfpY4 P.Md P.lam + 1)| ≤ 4 + P1 + 11 := by
    intro s _ _
    have h1 := hκb s
    have h2 := hgP s
    have h3 := hφ0b s
