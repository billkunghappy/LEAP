    rw [e]
    refine ((nb_real_algebra_v5 B.h _ ξ hDo hξU _ _ hqp hqp i).2.1 (Qb l ^ (1/2 + B.h)) 0).trans ?_
    rw [abs_zero, zero_mul, add_zero, abs_of_pos (Real.rpow_pos_of_pos hQ _)]
