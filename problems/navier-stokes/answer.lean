      exact ibp (fun y => (x, y)) ((0:ℝ), (1:ℝ)) (k.2 : ℂ)
        (fun t => (hasDerivAt_const t x).prodMk (hasDerivAt_id' t)) (hEy x) (hφy x) (hEy1 x)
    have fub : ∀ Ψ : ℝ × ℝ → ℂ, Continuous Ψ →
        ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Ψ Z =
          ∫ x in Set.Icc (0:ℝ) 1, ∫ y in Set.Icc (0:ℝ) 1, Ψ (x, y) := by
      intro Ψ hΨ
      rw [MeasureTheory.Measure.volume_eq_prod]
      exact MeasureTheory.setIntegral_prod Ψ
