theorem temp_wave_harmonics_gen_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
    l1 ≤ l0 → ∀ (S : CState) (bw ca H : ℝ), 7/10 ≤ bw → bw ≤ H → 9/10 ≤ H → ca ≤ H + 1 - 2 * kapS →
