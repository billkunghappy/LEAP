  have htl := fun (k : ℕ) (hk : k < m + 4) => htail J k (by omega) x t hxt haJ
  have hDk := fun (k : ℕ) (hk : k < m + 4) => hD k (by omega) x t hxt

  obtain ⟨Q, hQ⟩ : ∃ Q : ℝ, simScale h (x 2) (1 - t) = Q := ⟨_, rfl⟩
