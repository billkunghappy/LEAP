theorem plin5_princ_active : ∀ (B : BG) (G : CorrGeom), B.ok → ∀ (l0 : ℕ), InWg5 B G (qsOf l0) (1/2) (W0h4 B G) → ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), princC5 B G γ m ξ ≠ 0 → etaL B.h γ ξ ≠ 0 :=
by
  intro B G _ l0 _ γ m ξ _ hne hη
  apply hne

  have hc : ∀ η : Cyl, etaL B.h γ η = 0 → W0c4 B G γ η = 0 := by
    intro η h
    unfold W0c4
    split_ifs
    · rw [h]; simp
    · rfl

  have hshift : ∀ s : ℝ, etaL B.h γ (ξ + s • dVdir B.h γ.1) = etaL B.h γ ξ := by
    intro s
    have e : ξ + s • dVdir B.h γ.1 =
        (ξ.1, ξ.2.1, ξ.2.2.1, ξ.2.2.2 + s • ((cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) • vtv)) := by
      refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_)) <;> simp [dVdir]
    rw [e]
    unfold etaL qC chartR chartZ chartT
    rfl
  have hh : ∀ η : Cyl, W0c4 B G γ η = 0 → W0h4 B G γ m η = 0 := by
    intro η h
    unfold W0h4
    split_ifs
    · funext i; simp [h]
    · rfl
  have hline : ∀ s : ℝ, W0h4 B G γ m (ξ + s • dVdir B.h γ.1) = 0 := fun s =>
    hh _ (hc _ (by rw [hshift s, hη]))
  have hW0 : W0h4 B G γ m ξ = 0 := hh _ (hc _ hη)

  have hdV : dVc B γ.1 (W0h4 B G γ m) ξ = 0 := by
    unfold dVc
    by_cases hd : DifferentiableAt ℝ (W0h4 B G γ m) ξ
    · have hℓ : HasDerivAt (fun s : ℝ => ξ + s • dVdir B.h γ.1) (dVdir B.h γ.1) 0 := by
        have := ((hasDerivAt_id (0:ℝ)).smul_const (dVdir B.h γ.1)).const_add ξ
        simpa using this
      have hcomp := hd.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hℓ (by simp)
      have hfun : (W0h4 B G γ m ∘ fun s : ℝ => ξ + s • dVdir B.h γ.1) = fun _ => 0 := by
        funext s; exact hline s
      rw [hfun] at hcomp
      exact hcomp.unique (hasDerivAt_const _ _)
    · rw [fderiv_zero_of_not_differentiableAt hd]
      rfl
  have hpres : presW5 B G (W0c4 B G) γ m ξ = 0 := by
    simp [presW5, hc ξ hη]
  have hpw : (primState5 B G).pw γ m ξ = 0 := by
    show (((qC B.h ξ / Qb γ.1) ^ (Aex B.h + 1/2) : ℝ) : ℂ) * presW5 B G (W0c4 B G) γ m ξ = 0
    rw [hpres, mul_zero]
  simp only [princC5, hdV, hW0, hpw]
  simp

theorem plin5_princ_smooth : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → InWg5 B G (qsOf l0) (1/2) (W0h4 B G) → InWg5 B G (qsOf l0) 1 (primState5 B G).pw → ∀ (γ : Lab) (m : ℤ), ContDiffOn ℝ ∞ (princC5 B G γ m) (DomC B.h (qsOf l0)) :=
by
  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 hW0 hpw γ m => ?_⟩
  have hr1 : G.r0 ≤ 1/100 := hG.1.2.1
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 < B.qB := by
    rw [hQb]
    exact lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0
  have hSP : SimScaleProps B.h := hok.1
  have hqcont : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h4 := hSP.2.2.2.1
    have hm : MapsTo (fun η : Cyl => (η.2.1, 1 - η.2.2.1)) {η : Cyl | η.2.2.1 < 1} (univ ×ˢ Ioi 0) := by
      intro η hη
      have hη' : η.2.2.1 < 1 := hη
      exact ⟨mem_univ _, show (0:ℝ) < 1 - η.2.2.1 by linarith⟩
    exact (h4.comp (f := fun η : Cyl => (η.2.1, 1 - η.2.2.1)) (ContDiff.contDiffOn (by fun_prop)) hm).congr
      (fun η _ => rfl)
  have hT1o : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt (by fun_prop) continuous_const
  have hDo : IsOpen (DomC B.h (qsOf l0)) := by
    have e : DomC B.h (qsOf l0) = {η : Cyl | 0 < η.1} ∩
        ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Iio (qsOf l0)) := by
      ext η
      simp only [DomC, mem_setOf_eq, mem_inter_iff, mem_preimage, mem_Iio]
    rw [e]
    exact (isOpen_lt continuous_const continuous_fst).inter
      (hqcont.continuousOn.isOpen_inter_preimage hT1o isOpen_Iio)
  have hqD : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h (qsOf l0)) :=
    hqcont.mono (fun η hη => hη.2.1)
  have hq0D : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ :=
    fun ξ hξ => (hSP.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).1
  have hDsub : ∀ η ∈ DomC B.h (qsOf l0), η ∈ DomC B.h B.qB :=
    fun η hη => ⟨hη.1, hη.2.1, lt_trans hη.2.2 hqsB⟩
  have hWs : ContDiffOn ℝ ∞ (W0h4 B G γ m) (DomC B.h (qsOf l0)) := hW0.2.1 γ m
  have hPs : ContDiffOn ℝ ∞ ((primState5 B G).pw γ m) (DomC B.h (qsOf l0)) := hpw.2.1 γ m

  have hcast : ∀ (f : Cyl → ℝ) (s : Set Cyl), ContDiffOn ℝ ∞ f s →
      ContDiffOn ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) s := by
    intro f s hf
    exact (Complex.ofRealCLM.contDiff.comp_contDiffOn hf).congr (fun η _ => by simp)
  have transfer : ∀ (O : Set Cyl), IsOpen O → ∀ (f g : Cyl → ℝ) (d : Cyl → Cyl), (∀ η ∈ O, f η = g η) →
      ContDiffOn ℝ ∞ g O → ContDiffOn ℝ ∞ d O → ContDiffOn ℝ ∞ (fun η => fderiv ℝ f η (d η)) O := by
    intro O hO f g d hfg hg hd
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ g) O := ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hg).2
    refine (h1.clm_apply hd).congr ?_
