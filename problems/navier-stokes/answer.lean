  have hμ : ‖((m : ℂ) ^ 2)‖ = 1 := by rcases hm with rfl | rfl <;> simp
  have hκ : ‖Complex.I * (kb B.h γ.1 : ℂ) * (m : ℂ)‖ = ((kb B.h γ.1 : ℕ) : ℝ) := by
    rcases hm with rfl | rfl <;> simp
  have hc0' : |epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2| ≤ 4 := by
    rw [abs_of_nonneg (mul_nonneg heps0.le (sq_nonneg _))]; exact hc0
  rw [hμ, hκ] at hmain
  obtain ⟨qi, hqidef⟩ : ∃ qi : ℝ, qi = (qC B.h ξ)⁻¹ := ⟨_, rfl⟩
  rw [← hqidef] at hqi1 hkq
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = Λg * X := ⟨_, rfl⟩
  rw [← hMdef] at hmain
  have hM0 : 0 ≤ M := by rw [hMdef]; exact mul_nonneg hΛg0 (by linarith)
  have a1 : M ≤ qi * M := le_mul_of_one_le_left hM0 hqi1
  have a2 : M ^ 2 ≤ qi * M ^ 2 := le_mul_of_one_le_left (sq_nonneg M) hqi1
  have a3 : 1 * |epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2| * M ^ 2 ≤ 4 * M ^ 2 := by
    rw [one_mul]; exact mul_le_mul_of_nonneg_right hc0' (sq_nonneg M)
  have a4 : ((kb B.h γ.1 : ℕ) : ℝ) * M ≤ 4 * qi * M := mul_le_mul_of_nonneg_right hkq hM0
  have hT1 : 1 + 3 * M + 3 * 1 * |epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2| * M ^ 2 +
      ((kb B.h γ.1 : ℕ) : ℝ) * M ≤ qi * (1 + 7 * M + 12 * M ^ 2) := by
    have e : 3 * 1 * |epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2| * M ^ 2 =
        3 * (1 * |epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2| * M ^ 2) := by ring
    have e2 : qi * (1 + 7 * M + 12 * M ^ 2) = qi + 3 * (qi * M) + 4 * qi * M + 12 * (qi * M ^ 2) := by ring
    rw [e, e2]
    linarith
  have hXX : X ≤ X * X := le_mul_of_one_le_right (by linarith) hX1'
  have hT2 : 1 + 7 * M + 12 * M ^ 2 ≤ X ^ 2 * (1 + 7 * Λg + 12 * Λg ^ 2) := by
    have b1 : Λg * X ≤ Λg * (X * X) := mul_le_mul_of_nonneg_left hXX hΛg0
    have b2 : (1:ℝ) ≤ X * X := le_trans hX1' hXX
    rw [hMdef]
    have e : X ^ 2 * (1 + 7 * Λg + 12 * Λg ^ 2) = X * X + 7 * (Λg * (X * X)) + 12 * (Λg * X) ^ 2 := by ring
    rw [e]
    linarith
  have hqi0 : 0 ≤ qi := by linarith
  have hT : 1 + 3 * M + 3 * 1 * |epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2| * M ^ 2 +
      ((kb B.h γ.1 : ℕ) : ℝ) * M ≤ qi * (X ^ 2 * (1 + 7 * Λg + 12 * Λg ^ 2)) :=
    hT1.trans (mul_le_mul_of_nonneg_left hT2 hqi0)
  have hpre : 0 ≤ 8 ^ k * R0 * (Λ * Q) := mul_nonneg (mul_nonneg (by positivity) hR00) (mul_nonneg hΛ0 hQ0)
  have hSb : SC B.h ξ ^ (bE + 2 * bG) = SC B.h ξ ^ bE * X ^ 2 := by
    rw [hXdef, ← Real.rpow_natCast, ← Real.rpow_mul hS0.le, ← Real.rpow_add hS0]
    congr 1; push_cast; ring
  have hqm : qC B.h ξ ^ (-1:ℝ) = qi := by rw [hqidef, Real.rpow_neg_one]
  calc _ ≤ 8 ^ k * R0 * (Λ * Q) * (1 + 3 * M + 3 * 1 * |epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2| * M ^ 2 +
        ((kb B.h γ.1 : ℕ) : ℝ) * M) := hmain
    _ ≤ 8 ^ k * R0 * (Λ * Q) * (qi * (X ^ 2 * (1 + 7 * Λg + 12 * Λg ^ 2))) :=
        mul_le_mul_of_nonneg_left hT hpre
    _ = _ := by rw [hqm, hSb, hQdef]; ring

theorem nbg5_plain_le_nb : ∀ (h : ℝ), 0 < h → h < 1/100 → ∃ C0 : ℝ, 1 ≤ C0 ∧ ∀ ξ : Cyl, 0 < qC h ξ → qC h ξ < 1 → ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (k : ℕ), ‖iteratedFDeriv ℝ k f ξ‖ ≤ (C0 * qC h ξ ^ (-3:ℝ)) ^ k * NB h f k ξ :=
by
  intro h hh0 hh1

  have hcoarse : ∀ q : ℝ, 0 < q → q < (2:ℝ) ^ (-(10:ℝ)) →
      0 ≤ coarseIdx h q ∧ Tgc ^ (coarseIdx h q) ≤ q ^ (-(2:ℝ)) := by
    have hs2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
    have hs3 : Real.sqrt 2 ^ 3 = 2 * Real.sqrt 2 := by rw [pow_succ, hs2]
    have hs14 : (1.4:ℝ) < Real.sqrt 2 := by nlinarith
    have hs15 : Real.sqrt 2 < 1.5 := by nlinarith
    have hL1 : 1 < Lgc := by unfold Lgc; linarith
    have hT1 : 1 < Tgc := by unfold Tgc; linarith
    have hL0 : 0 < Lgc := by linarith
    have hT0 : 0 < Tgc := by linarith
    have hTL2 : Tgc ≤ Lgc ^ 2 := by unfold Tgc Lgc; nlinarith
    have hL3T2 : Lgc ^ 3 ≤ Tgc ^ 2 := by unfold Tgc Lgc; nlinarith
    have hlT0 : 0 < Real.log Tgc := Real.log_pos hT1
    have hlL0 : 0 < Real.log Lgc := Real.log_pos hL1
    have hlT2 : Real.log Tgc ≤ 2 * Real.log Lgc := by
      have := Real.log_le_log hT0 hTL2
      rw [Real.log_pow] at this; push_cast at this; linarith
    have hlL3 : 3 * Real.log Lgc ≤ 2 * Real.log Tgc := by
      have := Real.log_le_log (pow_pos hL0 3) hL3T2
      rw [Real.log_pow, Real.log_pow] at this; push_cast at this; linarith
    have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    obtain ⟨θ, hθ⟩ : ∃ θ : ℝ, θ = Real.log Lgc / Real.log Tgc := ⟨_, rfl⟩
    have hθb : θ * Real.log Tgc = Real.log Lgc := by rw [hθ]; exact div_mul_cancel₀ _ hlT0.ne'
    have hθ1 : 1/2 ≤ θ := by rw [hθ, le_div_iff₀ hlT0]; linarith
    have hθ2 : θ ≤ 2/3 := by rw [hθ, div_le_iff₀ hlT0]; linarith
    have hk : kapS = 1/100000 := rfl
    have hdrx : drx h = 2 * ((1 + h) * θ - h * kapS) := by rw [hθ]; rfl
    have hθh1 : (1 + h) * (1/2) ≤ (1 + h) * θ := mul_le_mul_of_nonneg_left hθ1 (by linarith)
    have hθh2 : (1 + h) * θ ≤ (1 + h) * (2/3) := mul_le_mul_of_nonneg_left hθ2 (by linarith)
    have hθh3 : (1 + h) * θ ≤ 1 := by linarith
    have hθ0 : 0 ≤ (1 + h) * θ := by linarith

    obtain ⟨φ, hφ⟩ : ∃ φ : ℕ → ℝ, φ = fun l : ℕ => (1 + h) * (l:ℝ) * Real.log 2 - 2 * Real.log (l:ℝ) :=
      ⟨_, rfl⟩
    have hφv : ∀ l : ℕ, φ l = (1 + h) * (l:ℝ) * Real.log 2 - 2 * Real.log (l:ℝ) := fun l => by rw [hφ]
    have hφdef : ∀ l : ℕ, 1 ≤ l → bandIdx h l = ⌊φ l / Real.log Tgc⌋ := by
      intro l hl
      have hl0 : (0:ℝ) < l := by exact_mod_cast hl
      unfold bandIdx
      congr 1
      unfold Real.logb
      rw [hφv, Real.log_div (Real.rpow_pos_of_pos two_pos _).ne' (pow_pos hl0 2).ne',
        Real.log_rpow two_pos, Real.log_pow]
      push_cast; ring
    have hstep : ∀ m : ℕ, 3 ≤ m → φ m ≤ φ (m+1) := by
      intro m hm
      have hm3 : (3:ℝ) ≤ m := by exact_mod_cast hm
      have hm0 : (0:ℝ) < m := by linarith
      have hsq : ((m:ℝ) + 1) ^ 2 ≤ 2 * (m:ℝ) ^ 2 := by nlinarith
      have hlog := Real.log_le_log (by positivity) hsq
      rw [Real.log_mul (by norm_num) (by positivity), Real.log_pow, Real.log_pow] at hlog
      rw [hφv, hφv]
      push_cast at hlog ⊢
      nlinarith [mul_pos hh0 hl2]
    have hmono : ∀ a b : ℕ, 3 ≤ a → a ≤ b → φ a ≤ φ b := by
      intro a b ha hab
      induction b, hab using Nat.le_induction with
      | base => exact le_rfl
      | succ n hn ih => exact ih.trans (hstep n (le_trans ha hn))
    have hφ4 : 0 ≤ φ 4 := by
      rw [hφv]
      have e4 : Real.log ((4:ℕ):ℝ) = 2 * Real.log 2 := by
        rw [show ((4:ℕ):ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; norm_num
      rw [e4]; push_cast; nlinarith [mul_pos hh0 hl2]

    intro q hq0 hq
    have hq1 : q < 1 := lt_trans hq (Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by norm_num))
    have hlq : Real.log q < 0 := Real.log_neg hq0 hq1
    have hu0 : 0 < 1 + -Real.log q := by linarith
    have hlq10 : Real.log q < -10 * Real.log 2 := by
      have := Real.log_lt_log hq0 hq
      rw [Real.log_rpow two_pos] at this; linarith
    have hbof : ∀ p : ℝ, 0 < p → bandOf p = ⌈-Real.log p / Real.log 2⌉₊ := by
      intro p hp
      unfold bandOf Real.logb
      rw [one_div, Real.log_inv]
    obtain ⟨l', hl'⟩ : ∃ l' : ℕ, l' = bandOf q := ⟨_, rfl⟩
    have hx10 : 10 < -Real.log q / Real.log 2 := by rw [lt_div_iff₀ hl2]; linarith
    have hle : -Real.log q / Real.log 2 ≤ l' := by rw [hl', hbof q hq0]; exact Nat.le_ceil _
    have hlt : (l':ℝ) < -Real.log q / Real.log 2 + 1 := by
      rw [hl', hbof q hq0]; exact Nat.ceil_lt_add_one (by linarith)
    have hu1 : -Real.log q ≤ l' * Real.log 2 := (div_le_iff₀ hl2).mp hle
    have hu2 : ((l':ℝ) - 1) * Real.log 2 < -Real.log q := by
      have : (l':ℝ) - 1 < -Real.log q / Real.log 2 := by linarith
      exact (lt_div_iff₀ hl2).mp this
    have hl'11 : 11 ≤ l' := by
      have h10 : (10:ℝ) < l' := lt_of_lt_of_le hx10 hle
      have h10' : 10 < l' := by exact_mod_cast h10
      omega
    obtain ⟨l, hl⟩ : ∃ l : ℕ, l = l' - 4 := ⟨_, rfl⟩
    have hlR : (l:ℝ) = l' - 4 := by rw [hl, Nat.cast_sub (by omega)]; norm_num
    have hl7 : 7 ≤ l := by omega
    have hlR7 : (7:ℝ) ≤ l := by exact_mod_cast hl7
    have hu1' : -Real.log q ≤ ((l:ℝ) + 4) * Real.log 2 := by
      have e : (l:ℝ) + 4 = l' := by linarith
      rw [e]; exact hu1
    have hu2' : ((l:ℝ) + 3) * Real.log 2 < -Real.log q := by
      have e : (l:ℝ) + 3 = l' - 1 := by linarith
      rw [e]; exact hu2
    have hcI : coarseIdx h q = ⌊φ l / Real.log Tgc⌋ := by
      rw [← hφdef l (by omega)]; unfold coarseIdx; rw [← hl', ← hl]
    have hφl : 0 ≤ φ l := le_trans hφ4 (hmono 4 l (by norm_num) (by omega))
    have hn1 : ((coarseIdx h q : ℤ) : ℝ) * Real.log Tgc ≤ φ l := by
      rw [hcI]; exact (le_div_iff₀ hlT0).mp (Int.floor_le _)
    have hn2 : φ l - Real.log Tgc < ((coarseIdx h q : ℤ) : ℝ) * Real.log Tgc := by
      rw [hcI]
      have h1 := Int.sub_one_lt_floor (φ l / Real.log Tgc)
      have h' : φ l / Real.log Tgc < (⌊φ l / Real.log Tgc⌋ : ℝ) + 1 := by linarith
      rw [div_lt_iff₀ hlT0] at h'
      linarith
    have hloglnn : 0 ≤ Real.log (l:ℝ) := Real.log_nonneg (by linarith)
    have hlogl : Real.log (l:ℝ) ≤ Real.log 2 + Real.log (1 + -Real.log q) := by
      rw [← Real.log_mul (by norm_num) hu0.ne']
      apply Real.log_le_log (by linarith)
      have h12 : (1:ℝ)/2 < Real.log 2 := by have := Real.log_two_gt_d9; linarith
      nlinarith [mul_le_mul_of_nonneg_left h12.le (show (0:ℝ) ≤ l by linarith)]

    have hii : Tgc ^ (coarseIdx h q) ≤ q ^ (-(2:ℝ)) := by
      rw [← Real.log_le_log_iff (zpow_pos hT0 _) (Real.rpow_pos_of_pos hq0 _), Real.log_zpow,
        Real.log_rpow hq0]
      have hA : 0 ≤ (l:ℝ) * Real.log 2 := by positivity
      have hB : (1 + h) * ((l:ℝ) * Real.log 2) ≤ 2 * ((l:ℝ) * Real.log 2) :=
        mul_le_mul_of_nonneg_right (by linarith) hA
      rw [hφv] at hn1
      nlinarith
    exact ⟨by rw [hcI]; exact Int.floor_nonneg.mpr (div_nonneg hφl hlT0.le), hii⟩

  have hL : Lgc ≠ 0 := by
    unfold Lgc; intro h0
    have : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
    linarith
  have hT : Tgc ≠ 0 := by unfold Tgc; intro h0; linarith [Real.sqrt_nonneg 2]
  have hN : (1 + bgc ^ 2) ≠ 0 := by positivity
  have c1 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).1 = Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) * bgc := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have c2 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).2 = -(Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) * bgc) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have hcomp : ∀ (m n : ℤ) (Y : ℝ × ℝ), Jpow m (Jpow n Y) = Jpow (m + n) Y := by
    intro m n Y
    refine Prod.ext ?_ ?_
    · rw [c1 m, c1 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
      field_simp
      ring
    · rw [c2 m, c2 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
      field_simp
      ring
  have hid : ∀ Y : ℝ × ℝ, Jpow 0 Y = Y := by
    intro Y
    refine Prod.ext ?_ ?_
    · rw [c1, zpow_zero, zpow_zero]
      field_simp
      ring
    · rw [c2, zpow_zero, zpow_zero]
      field_simp
      ring
  have hJ : ∀ (m : ℤ) (Y : ℝ × ℝ), JpowL m Y = Jpow m Y := by
    intro m Y
    refine Prod.ext ?_ ?_
    · simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
        ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Prod.fst_add, Prod.smul_fst,
        smul_eq_mul]
      rw [c1, c1, c1]
      ring
    · simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
        ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Prod.snd_add, Prod.smul_snd,
        smul_eq_mul]
      rw [c2, c2, c2]
      ring
  have hJinv : ∀ (n : ℤ) (Y : ℝ × ℝ), JpowL (-n) (JpowL n Y) = Y := by
    intro n Y
    rw [hJ, hJ, hcomp, neg_add_cancel, hid]

  have hs1 : 1 < Real.sqrt 2 := (Real.lt_sqrt (by norm_num)).mpr (by norm_num)
  have hs2 : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
  have hb0 : 0 < bgc := by unfold bgc; linarith
  have hb1 : bgc ≤ 1 := by unfold bgc; linarith
  have hβ0 : 0 < 1 + bgc ^ 2 := by positivity
  have hβ : 1 ≤ 1 + bgc ^ 2 := le_add_of_nonneg_right (sq_nonneg _)
  have hL0 : 0 < Lgc := by unfold Lgc; linarith
  have hT0 : 0 < Tgc := by unfold Tgc; linarith
  have hLT : Lgc ≤ Tgc := by unfold Lgc Tgc; linarith [Real.sqrt_nonneg 2]
  have hgrow : ∀ (n : ℤ), 0 ≤ n → ∀ Y : ℝ × ℝ, ‖JpowL n Y‖ ≤ 4 * Tgc ^ n * ‖Y‖ := by
    intro n hn Y
    lift n to ℕ using hn
    have ha0 : 0 < Lgc ^ (n:ℤ) := zpow_pos hL0 _
    have hT0n : 0 < Tgc ^ (n:ℤ) := zpow_pos hT0 _
    have hab : Lgc ^ (n:ℤ) ≤ Tgc ^ (n:ℤ) := by
      rw [zpow_natCast, zpow_natCast]; exact pow_le_pow_left₀ hL0.le hLT n
    have hY1 : |Y.1| ≤ ‖Y‖ := by rw [← Real.norm_eq_abs]; exact norm_fst_le Y
    have hY2 : |Y.2| ≤ ‖Y‖ := by rw [← Real.norm_eq_abs]; exact norm_snd_le Y
    have hbY1 : |bgc * Y.1| ≤ ‖Y‖ := by
      rw [abs_mul, abs_of_pos hb0]
      exact le_trans (mul_le_mul_of_nonneg_left hY1 hb0.le) (mul_le_of_le_one_left (norm_nonneg _) hb1)
    have hbY2 : |bgc * Y.2| ≤ ‖Y‖ := by
      rw [abs_mul, abs_of_pos hb0]
      exact le_trans (mul_le_mul_of_nonneg_left hY2 hb0.le) (mul_le_of_le_one_left (norm_nonneg _) hb1)
    obtain ⟨x, hx⟩ : ∃ x : ℝ, x = (Y.1 - bgc * Y.2) / (1 + bgc ^ 2) := ⟨_, rfl⟩
    obtain ⟨y, hy⟩ : ∃ y : ℝ, y = (bgc * Y.1 + Y.2) / (1 + bgc ^ 2) := ⟨_, rfl⟩
    have hxb : |x| ≤ 2 * ‖Y‖ := by
      have e1 := abs_le.mp hY1
      have e2 := abs_le.mp hbY2
      have hnum : |Y.1 - bgc * Y.2| ≤ 2 * ‖Y‖ := abs_le.mpr ⟨by linarith, by linarith⟩
      rw [hx, abs_div, abs_of_pos hβ0]
      exact le_trans (div_le_self (abs_nonneg _) hβ) hnum
    have hyb : |y| ≤ 2 * ‖Y‖ := by
      have e1 := abs_le.mp hbY1
      have e2 := abs_le.mp hY2
      have hnum : |bgc * Y.1 + Y.2| ≤ 2 * ‖Y‖ := abs_le.mpr ⟨by linarith, by linarith⟩
      rw [hy, abs_div, abs_of_pos hβ0]
      exact le_trans (div_le_self (abs_nonneg _) hβ) hnum
    have t1 : |Lgc ^ (n:ℤ) * x| ≤ Tgc ^ (n:ℤ) * (2 * ‖Y‖) := by
      rw [abs_mul, abs_of_pos ha0]; exact mul_le_mul hab hxb (abs_nonneg _) hT0n.le
    have t2 : |Tgc ^ (n:ℤ) * y| ≤ Tgc ^ (n:ℤ) * (2 * ‖Y‖) := by
      rw [abs_mul, abs_of_pos hT0n]; exact mul_le_mul_of_nonneg_left hyb hT0n.le
    have t3 : |Lgc ^ (n:ℤ) * x * bgc| ≤ Tgc ^ (n:ℤ) * (2 * ‖Y‖) := by
      rw [abs_mul (Lgc ^ (n:ℤ) * x) bgc, abs_of_pos hb0]
      exact le_trans (mul_le_of_le_one_right (abs_nonneg _) hb1) t1
    have t4 : |Tgc ^ (n:ℤ) * y * bgc| ≤ Tgc ^ (n:ℤ) * (2 * ‖Y‖) := by
      rw [abs_mul (Tgc ^ (n:ℤ) * y) bgc, abs_of_pos hb0]
      exact le_trans (mul_le_of_le_one_right (abs_nonneg _) hb1) t2
    rw [hJ]
    refine norm_prod_le_iff.mpr ⟨?_, ?_⟩
    · rw [Real.norm_eq_abs, c1, ← hx, ← hy]
      calc _ ≤ |Lgc ^ (n:ℤ) * x| + |Tgc ^ (n:ℤ) * y * bgc| := abs_add_le _ _
        _ ≤ _ := by linarith
    · rw [Real.norm_eq_abs, c2, ← hx, ← hy]
      calc _ ≤ |-(Lgc ^ (n:ℤ) * x * bgc)| + |Tgc ^ (n:ℤ) * y| := abs_add_le _ _
        _ ≤ _ := by rw [abs_neg]; linarith

  obtain ⟨q0, hq0def⟩ : ∃ q0 : ℝ, q0 = (2:ℝ) ^ (-(10:ℝ)) := ⟨_, rfl⟩
  have hq0 : 0 < q0 := by rw [hq0def]; exact Real.rpow_pos_of_pos two_pos _
  obtain ⟨S, hSdef⟩ : ∃ S : ℝ, S = ∑ l ∈ Finset.range (bandOf q0 + 1),
      (‖JpowL (-(bandIdx h l))‖ + ‖JpowL (bandIdx h l)‖) := ⟨_, rfl⟩
  have hS0 : 0 ≤ S := by
    rw [hSdef]; exact Finset.sum_nonneg (fun l _ => by positivity)
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = 1 + 1 / q0 + S := ⟨_, rfl⟩
  have hq0inv : 0 < q0⁻¹ := inv_pos.mpr hq0
  have hM1 : 1 ≤ M := by rw [hMdef, one_div]; linarith
  have hMq : q0⁻¹ ≤ M := by rw [hMdef, one_div]; linarith
  have hMS : S ≤ M := by rw [hMdef, one_div]; linarith
  have hM0 : 0 ≤ M := by linarith
  have hC4 : (4:ℝ) ≤ max 4 M := le_max_left _ _
  have hCM : M ≤ max 4 M := le_max_right _ _
  have hC0 : 0 ≤ max 4 M := by linarith
  refine ⟨max 4 M, by linarith, ?_⟩
  intro ξ hq hq1 V _ _ f k
  have hhi : qC h ξ ≤ 1 := hq1.le

  have hsq0 : 0 < Real.sqrt (qC h ξ) := Real.sqrt_pos.mpr hq
  have hsq1 : Real.sqrt (qC h ξ) ≤ 1 := by
    rw [← Real.sqrt_one]; exact Real.sqrt_le_sqrt hhi
  have hqsq : qC h ξ ≤ Real.sqrt (qC h ξ) := by
    have e := Real.mul_self_sqrt hq.le
    have := mul_le_mul_of_nonneg_left hsq1 hsq0.le
    nlinarith
  have hqe0 : 0 < qC h ξ ^ (1/2 - h) := Real.rpow_pos_of_pos hq _
  have hqqe : qC h ξ ≤ qC h ξ ^ (1/2 - h) := by
    have := Real.rpow_le_rpow_of_exponent_ge hq hhi (show 1/2 - h ≤ 1 by linarith)
    rwa [Real.rpow_one] at this
  have hq3 : 1 ≤ qC h ξ ^ (-3:ℝ) := by
    have := Real.rpow_le_rpow_of_exponent_ge hq hhi (show (-3:ℝ) ≤ 0 by norm_num)
    rwa [Real.rpow_zero] at this

  have hnorm4 : ∀ (a b c : ℝ) (d : ℝ × ℝ) (r : ℝ), ‖a‖ ≤ r → ‖b‖ ≤ r → ‖c‖ ≤ r → ‖d‖ ≤ r →
      ‖((a, b, c, d) : Cyl)‖ ≤ r := by
    intro a b c d r ha hb hc hd
    exact norm_prod_le_iff.mpr ⟨ha, norm_prod_le_iff.mpr ⟨hb, norm_prod_le_iff.mpr ⟨hc, hd⟩⟩⟩
  have hsc : ∀ (c x r K : ℝ), 0 ≤ c → c ≤ K → ‖x‖ ≤ r → 0 ≤ K → ‖c * x‖ ≤ K * r := by
    intro c x r K hc hcK hx hK
    rw [norm_mul, Real.norm_of_nonneg hc]
    exact mul_le_mul hcK hx (norm_nonneg _) hK
  have hu1 : ∀ u : Cyl, ‖u.1‖ ≤ ‖u‖ := fun u => norm_fst_le u
  have hu2 : ∀ u : Cyl, ‖u.2.1‖ ≤ ‖u‖ := fun u => (norm_fst_le u.2).trans (norm_snd_le u)
  have hu3 : ∀ u : Cyl, ‖u.2.2.1‖ ≤ ‖u‖ := fun u =>
    ((norm_fst_le u.2.2).trans (norm_snd_le u.2)).trans (norm_snd_le u)
  have hu4 : ∀ u : Cyl, ‖u.2.2.2‖ ≤ ‖u‖ := fun u =>
    ((norm_snd_le u.2.2).trans (norm_snd_le u.2)).trans (norm_snd_le u)

  have hLap : ∀ u : Cyl, Lnorm h ξ u = (Real.sqrt (qC h ξ) * u.1, qC h ξ ^ (1/2 - h) * u.2.1,
      qC h ξ * u.2.2.1, JpowL (-(coarseIdx h (qC h ξ))) u.2.2.2) := fun u => rfl
  obtain ⟨R, hRdef⟩ : ∃ R : Cyl →L[ℝ] Cyl,
      R = ((Real.sqrt (qC h ξ))⁻¹ • ContinuousLinearMap.id ℝ ℝ).prodMap
        (((qC h ξ ^ (1/2 - h))⁻¹ • ContinuousLinearMap.id ℝ ℝ).prodMap
          (((qC h ξ)⁻¹ • ContinuousLinearMap.id ℝ ℝ).prodMap (JpowL (coarseIdx h (qC h ξ))))) :=
    ⟨_, rfl⟩
  have hRap : ∀ u : Cyl, R u = ((Real.sqrt (qC h ξ))⁻¹ * u.1, (qC h ξ ^ (1/2 - h))⁻¹ * u.2.1,
      (qC h ξ)⁻¹ * u.2.2.1, JpowL (coarseIdx h (qC h ξ)) u.2.2.2) := by
    intro u; rw [hRdef]; rfl
  have hPR : ∀ u : Cyl, Lnorm h ξ (R u) = u := by
    intro u
    obtain ⟨a, b, c, d⟩ := u
    rw [hRap, hLap]
    simp only [Prod.mk.injEq]
    refine ⟨mul_inv_cancel_left₀ hsq0.ne' a, mul_inv_cancel_left₀ hqe0.ne' b,
      mul_inv_cancel_left₀ hq.ne' c, hJinv _ d⟩

  have hRn : ‖R‖ ≤ max 4 M * qC h ξ ^ (-3:ℝ) := by
    rcases lt_or_ge (qC h ξ) q0 with hs | hlo
    ·
      obtain ⟨hn0, hTn⟩ := hcoarse (qC h ξ) hq (by rw [← hq0def]; exact hs)
      have hinvq : (qC h ξ)⁻¹ ≤ qC h ξ ^ (-3:ℝ) := by
        rw [← Real.rpow_neg_one]
        exact Real.rpow_le_rpow_of_exponent_ge hq hhi (by norm_num)
      have h23 : qC h ξ ^ (-(2:ℝ)) ≤ qC h ξ ^ (-3:ℝ) :=
        Real.rpow_le_rpow_of_exponent_ge hq hhi (by norm_num)
      have hQ0 : 0 ≤ qC h ξ ^ (-3:ℝ) := by linarith
      have hK : qC h ξ ^ (-3:ℝ) ≤ 4 * qC h ξ ^ (-3:ℝ) := by linarith
      have hK0 : 0 ≤ 4 * qC h ξ ^ (-3:ℝ) := by linarith
      have hi1 : (Real.sqrt (qC h ξ))⁻¹ ≤ 4 * qC h ξ ^ (-3:ℝ) :=
        le_trans (inv_anti₀ hq hqsq) (le_trans hinvq hK)
      have hi2 : (qC h ξ ^ (1/2 - h))⁻¹ ≤ 4 * qC h ξ ^ (-3:ℝ) :=
        le_trans (inv_anti₀ hq hqqe) (le_trans hinvq hK)
      have hi3 : (qC h ξ)⁻¹ ≤ 4 * qC h ξ ^ (-3:ℝ) := le_trans hinvq hK
      have hj : ∀ (Y : ℝ × ℝ) (r : ℝ), ‖Y‖ ≤ r →
          ‖JpowL (coarseIdx h (qC h ξ)) Y‖ ≤ 4 * qC h ξ ^ (-3:ℝ) * r := by
        intro Y r hY
        calc ‖JpowL (coarseIdx h (qC h ξ)) Y‖ ≤ 4 * Tgc ^ (coarseIdx h (qC h ξ)) * ‖Y‖ :=
              hgrow _ hn0 Y
          _ ≤ 4 * qC h ξ ^ (-3:ℝ) * r := mul_le_mul (by linarith) hY (norm_nonneg _) hK0
      have hRb : ∀ u : Cyl, ‖R u‖ ≤ 4 * qC h ξ ^ (-3:ℝ) * ‖u‖ := by
        intro u
        rw [hRap]
        exact hnorm4 _ _ _ _ _ (hsc _ _ _ _ (inv_nonneg.mpr hsq0.le) hi1 (hu1 u) hK0)
          (hsc _ _ _ _ (inv_nonneg.mpr hqe0.le) hi2 (hu2 u) hK0)
          (hsc _ _ _ _ (inv_nonneg.mpr hq.le) hi3 (hu3 u) hK0) (hj _ _ (hu4 u))
      calc ‖R‖ ≤ 4 * qC h ξ ^ (-3:ℝ) := ContinuousLinearMap.opNorm_le_bound _ hK0 hRb
        _ ≤ max 4 M * qC h ξ ^ (-3:ℝ) := mul_le_mul_of_nonneg_right hC4 hQ0
    ·
      have hband : bandOf (qC h ξ) ≤ bandOf q0 := by
        unfold bandOf
        apply Nat.ceil_mono
        apply Real.logb_le_logb_of_le one_lt_two (by positivity)
        exact one_div_le_one_div_of_le hq0 hlo
      have hl : bandOf (qC h ξ) - 4 ∈ Finset.range (bandOf q0 + 1) :=
        Finset.mem_range.mpr (by omega)
      have hsingle := Finset.single_le_sum
        (f := fun l => ‖JpowL (-(bandIdx h l))‖ + ‖JpowL (bandIdx h l)‖) (fun l _ => by positivity) hl
      have hci : coarseIdx h (qC h ξ) = bandIdx h (bandOf (qC h ξ) - 4) := rfl
      have hJp : ‖JpowL (coarseIdx h (qC h ξ))‖ ≤ S := by
        rw [hSdef, hci]
        exact le_trans (le_add_of_nonneg_left (norm_nonneg _)) hsingle
      have hi1 : (Real.sqrt (qC h ξ))⁻¹ ≤ M := le_trans (inv_anti₀ hq0 (le_trans hlo hqsq)) hMq
      have hi2 : (qC h ξ ^ (1/2 - h))⁻¹ ≤ M := le_trans (inv_anti₀ hq0 (le_trans hlo hqqe)) hMq
      have hi3 : (qC h ξ)⁻¹ ≤ M := le_trans (inv_anti₀ hq0 hlo) hMq
      have hlin : ∀ (T : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)) (x : ℝ × ℝ) (r : ℝ), ‖T‖ ≤ S → ‖x‖ ≤ r →
          ‖T x‖ ≤ M * r := by
        intro T x r hTS hx
        have hr : 0 ≤ r := le_trans (norm_nonneg _) hx
        calc ‖T x‖ ≤ ‖T‖ * ‖x‖ := ContinuousLinearMap.le_opNorm _ _
          _ ≤ S * r := mul_le_mul hTS hx (norm_nonneg _) hS0
          _ ≤ M * r := mul_le_mul_of_nonneg_right hMS hr
      have hR : ∀ u : Cyl, ‖R u‖ ≤ M * ‖u‖ := by
        intro u
        rw [hRap]
        exact hnorm4 _ _ _ _ _ (hsc _ _ _ _ (inv_nonneg.mpr hsq0.le) hi1 (hu1 u) hM0)
          (hsc _ _ _ _ (inv_nonneg.mpr hqe0.le) hi2 (hu2 u) hM0)
          (hsc _ _ _ _ (inv_nonneg.mpr hq.le) hi3 (hu3 u) hM0) (hlin _ _ _ hJp (hu4 u))
      calc ‖R‖ ≤ M := ContinuousLinearMap.opNorm_le_bound _ hM0 hR
        _ ≤ max 4 M := hCM
        _ ≤ max 4 M * qC h ξ ^ (-3:ℝ) := le_mul_of_one_le_right hC0 hq3

  unfold NB
  obtain ⟨A, hAdef⟩ : ∃ A, A = iteratedFDeriv ℝ k f ξ := ⟨_, rfl⟩
  rw [← hAdef]
  have hA : A = (A.compContinuousLinearMap (fun _ => Lnorm h ξ)).compContinuousLinearMap
      (fun _ => R) := by
    ext m
    simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply, hPR]
  have h1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
    (A.compContinuousLinearMap (fun _ => Lnorm h ξ)) (fun _ : Fin k => R)
  rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin] at h1
  calc ‖A‖ = ‖(A.compContinuousLinearMap (fun _ => Lnorm h ξ)).compContinuousLinearMap
        (fun _ => R)‖ := congrArg _ hA
    _ ≤ ‖A.compContinuousLinearMap (fun _ => Lnorm h ξ)‖ * ‖R‖ ^ k := h1
    _ ≤ ‖A.compContinuousLinearMap (fun _ => Lnorm h ξ)‖ * (max 4 M * qC h ξ ^ (-3:ℝ)) ^ k :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) hRn k) (norm_nonneg _)
    _ = _ := mul_comm _ _

theorem nbg5_gauss_absorb : ∀ (c b P : ℝ), 0 < c → 0 ≤ P → ∃ K : ℝ, 0 ≤ K ∧ ∀ (q : ℝ) (l : ℕ), 0 < q → q ≤ 1 → 1/2 < q / Qb l → ((1 + |Real.log q|) ^ 2) ^ b * Real.exp (-c * (l : ℝ) ^ 2) ≤ K * q ^ P :=
by
  intro c b P hc hP
  obtain ⟨bp, hbp⟩ : ∃ bp : ℝ, bp = max b 0 := ⟨_, rfl⟩
  have hbp0 : 0 ≤ bp := by rw [hbp]; exact le_max_right b 0
  have hbbp : b ≤ bp := by rw [hbp]; exact le_max_left b 0
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = (P + 2 * bp) * Real.log 2 := ⟨_, rfl⟩
  have hPb : 0 ≤ P + 2 * bp := by linarith
  have ha0 : 0 ≤ a := by rw [ha]; exact mul_nonneg hPb hlog2.le
  refine ⟨Real.exp (a + a ^ 2 / (4 * c)), (Real.exp_pos _).le, ?_⟩
  intro q l hq0 hq1 hpin
  have hL0 : (0 : ℝ) ≤ (l : ℝ) := Nat.cast_nonneg l
  have hlq : Real.log q ≤ 0 := Real.log_nonpos hq0.le hq1
  obtain ⟨y, hy⟩ : ∃ y : ℝ, y = -Real.log q := ⟨_, rfl⟩
  have hy0 : 0 ≤ y := by rw [hy]; linarith
  have habs : |Real.log q| = y := by rw [hy]; exact abs_of_nonpos hlq
  rw [habs]
  have h1y : 0 < 1 + y := by linarith
  have hSpos : 0 < (1 + y) ^ 2 := by positivity
  have hlogS : Real.log ((1 + y) ^ 2) = 2 * Real.log (1 + y) := by
    rw [Real.log_pow]; norm_num
  have hl1 : 0 ≤ Real.log (1 + y) := Real.log_nonneg (by linarith)
  have hl2 : Real.log (1 + y) ≤ y := by
    have := Real.log_le_sub_one_of_pos h1y
    linarith
  have hlS0 : 0 ≤ Real.log ((1 + y) ^ 2) := by rw [hlogS]; linarith
  have hlS : Real.log ((1 + y) ^ 2) ≤ 2 * y := by rw [hlogS]; linarith
  have hb1 : Real.log ((1 + y) ^ 2) * b ≤ Real.log ((1 + y) ^ 2) * bp :=
    mul_le_mul_of_nonneg_left hbbp hlS0
  have hb2 : Real.log ((1 + y) ^ 2) * bp ≤ (2 * y) * bp :=
    mul_le_mul_of_nonneg_right hlS hbp0

  have hQ : 0 < Qb l := by unfold Qb; exact Real.rpow_pos_of_pos (by norm_num) _
  have hlt : 1 / 2 * Qb l < q := by
    rw [lt_div_iff₀ hQ] at hpin
    linarith
  have hlogQ : Real.log (Qb l) = -(l : ℝ) * Real.log 2 := by
    unfold Qb
    rw [Real.log_rpow (by norm_num)]
  have hlog12 : Real.log (1 / 2 * Qb l) = -Real.log 2 + Real.log (Qb l) := by
    rw [Real.log_mul (by norm_num) hQ.ne', one_div, Real.log_inv]
  have hll := Real.log_lt_log (by positivity) hlt
  rw [hlog12, hlogQ] at hll
  have E2 : y < ((l : ℝ) + 1) * Real.log 2 := by
    rw [hy]
    linarith
  have E3 : (P + 2 * bp) * y ≤ a * (l : ℝ) + a := by
    calc (P + 2 * bp) * y ≤ (P + 2 * bp) * (((l : ℝ) + 1) * Real.log 2) :=
          mul_le_mul_of_nonneg_left E2.le hPb
      _ = a * (l : ℝ) + a := by rw [ha]; ring
  have E4 : a * (l : ℝ) - c * (l : ℝ) ^ 2 ≤ a ^ 2 / (4 * c) := by
    have key : a ^ 2 / (4 * c) - (a * (l : ℝ) - c * (l : ℝ) ^ 2) =
        (a - 2 * c * (l : ℝ)) ^ 2 / (4 * c) := by
      field_simp
      ring
    have hnn : 0 ≤ (a - 2 * c * (l : ℝ)) ^ 2 / (4 * c) :=
      div_nonneg (sq_nonneg _) (by linarith)
    linarith
  have hqP : Real.log q * P = -(y * P) := by rw [hy]; ring
  rw [Real.rpow_def_of_pos hSpos, Real.rpow_def_of_pos hq0, ← Real.exp_add, ← Real.exp_add]
  apply Real.exp_le_exp.mpr
  have E3' : P * y + 2 * (bp * y) ≤ a * (l : ℝ) + a := by linarith [E3]
  have hb2' : Real.log ((1 + y) ^ 2) * bp ≤ 2 * (bp * y) := by linarith [hb2]
  have hneg : -c * (l : ℝ) ^ 2 = -(c * (l : ℝ) ^ 2) := by ring
  rw [hneg, hqP]
  have hyP : y * P = P * y := by ring
  rw [hyP]
  linarith

theorem nbg5_closure_extend : ∀ (B : BG) (qs : ℝ) {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (g : Cyl → ℝ) (k : ℕ), IsOpen (DomC B.h qs) → 0 < B.Xa → B.Xa < B.Xb → ContDiffOn ℝ ∞ f (DomC B.h qs) → ContinuousOn g (DomC B.h qs) → (∀ ξ ∈ DomC B.h qs, 0 ≤ g ξ) → (∀ ξ ∈ DomC B.h qs, f ξ ≠ 0 → B.Xa ≤ XC B.h ξ ∧ XC B.h ξ ≤ B.Xb) → (∀ ξ ∈ DomC B.h qs, f ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ‖iteratedFDeriv ℝ k f ξ‖ ≤ g ξ) → ∀ ξ ∈ DomC B.h qs, ‖iteratedFDeriv ℝ k f ξ‖ ≤ g ξ :=
by
  intro B qs V _ _ f g k hD hXa hXab hf hg hg0 hsupp hshell ξ hξ
  have hfc : ContinuousOn f (DomC B.h qs) := hf.continuousOn

  have hT : ∀ η ∈ DomC B.h qs, f η ≠ 0 → η ∈ closure
      {ζ : Cyl | ζ ∈ DomC B.h qs ∧ f ζ ≠ 0 ∧ B.Xa < XC B.h ζ ∧ XC B.h ζ < B.Xb} := by
    intro η hη hne
    have hTo : IsOpen (DomC B.h qs ∩ f ⁻¹' {(0:V)}ᶜ) :=
      hfc.isOpen_inter_preimage hD isOpen_compl_singleton
    have hTn : DomC B.h qs ∩ f ⁻¹' {(0:V)}ᶜ ∈ nhds η := hTo.mem_nhds ⟨hη, hne⟩
    obtain ⟨h1, h2⟩ := hsupp η hη hne
    obtain ⟨X0, hX0⟩ : ∃ X0 : ℝ, X0 = XC B.h η := ⟨_, rfl⟩
    rw [← hX0] at h1 h2
    have hX0pos : 0 < X0 := lt_of_lt_of_le hXa h1
    let r : ℝ → ℝ := fun l => ((1 - l) * X0 + l * ((B.Xa + B.Xb) / 2)) / X0
    let φ : ℝ → Cyl := fun l => (Real.sqrt (r l) * η.1, η.2)
    have hrc : Continuous r := by
      show Continuous (fun l : ℝ => ((1 - l) * X0 + l * ((B.Xa + B.Xb) / 2)) / X0)
      fun_prop
    have hφc : Continuous φ := by
      show Continuous (fun l : ℝ => ((Real.sqrt (r l) * η.1, η.2) : Cyl))
      exact Continuous.prodMk ((Real.continuous_sqrt.comp hrc).mul continuous_const) continuous_const
    have hr0 : r 0 = 1 := by
      show ((1 - 0) * X0 + 0 * ((B.Xa + B.Xb) / 2)) / X0 = 1
      rw [sub_zero, one_mul, zero_mul, add_zero, div_self hX0pos.ne']
    have hφ0 : φ 0 = η := by
      show ((Real.sqrt (r 0) * η.1, η.2) : Cyl) = η
      rw [hr0, Real.sqrt_one, one_mul]
    have htend : Filter.Tendsto φ (nhdsWithin 0 (Set.Ioi 0)) (nhds η) := by
      have := hφc.tendsto 0
      rw [hφ0] at this
      exact this.mono_left nhdsWithin_le_nhds
    have hev : ∀ᶠ l in nhdsWithin (0:ℝ) (Set.Ioi 0), φ l ∈
        {ζ : Cyl | ζ ∈ DomC B.h qs ∧ f ζ ≠ 0 ∧ B.Xa < XC B.h ζ ∧ XC B.h ζ < B.Xb} := by
      filter_upwards [htend hTn, Ioo_mem_nhdsGT (zero_lt_one' ℝ)] with l hl hl01
      obtain ⟨hlD, hlne⟩ := hl
      have hl0 : 0 < l := hl01.1
      have hl1 : 0 < 1 - l := sub_pos.mpr hl01.2
      have hmpos : 0 < (B.Xa + B.Xb) / 2 := by linarith
      have hYpos : 0 < (1 - l) * X0 + l * ((B.Xa + B.Xb) / 2) := by
        nlinarith [mul_pos hl1 hX0pos, mul_pos hl0 hmpos]
      have hrnn : 0 ≤ r l := by
        show 0 ≤ ((1 - l) * X0 + l * ((B.Xa + B.Xb) / 2)) / X0
        exact div_nonneg hYpos.le hX0pos.le
      have hY : XC B.h (φ l) = (1 - l) * X0 + l * ((B.Xa + B.Xb) / 2) := by
        show (Real.sqrt (r l) * η.1) ^ 2 / (2 * qC B.h (φ l)) = _
        have hq : qC B.h (φ l) = qC B.h η := rfl
        have hX : η.1 ^ 2 / (2 * qC B.h η) = X0 := by rw [hX0]; rfl
        rw [hq, mul_pow, Real.sq_sqrt hrnn, mul_div_assoc, hX]
        show ((1 - l) * X0 + l * ((B.Xa + B.Xb) / 2)) / X0 * X0 = _
        exact div_mul_cancel₀ _ hX0pos.ne'
      refine ⟨hlD, hlne, ?_, ?_⟩
      · rw [hY]
        nlinarith [mul_nonneg hl1.le (sub_nonneg.mpr h1), mul_pos hl0 (sub_pos.mpr hXab)]
      · rw [hY]
        nlinarith [mul_nonneg hl1.le (sub_nonneg.mpr h2), mul_pos hl0 (sub_pos.mpr hXab)]
    exact mem_closure_of_tendsto htend hev

  have hFc : ContinuousOn (fun η => ‖iteratedFDeriv ℝ k f η‖) (DomC B.h qs) :=
    ((hf.continuousOn_iteratedFDerivWithin (m := k) (by exact_mod_cast le_top) hD.uniqueDiffOn).congr
      (fun x hx => (iteratedFDerivWithin_of_isOpen k hD hx).symm)).norm

  by_cases hA : ∀ᶠ η in nhds ξ, f η = 0
  · have h0 : iteratedFDeriv ℝ k f ξ = 0 := by
      have hE : f =ᶠ[nhds ξ] fun _ => (0:V) := hA
      rw [(hE.iteratedFDeriv ℝ k).eq_of_nhds]
      have h := (iteratedFDeriv_fun_zero : iteratedFDeriv ℝ k (fun _ : Cyl => (0:V)) = 0)
      exact congrFun h ξ
    rw [h0, norm_zero]
    exact hg0 ξ hξ
  · have hfr : ∃ᶠ η in nhds ξ, ¬ f η = 0 := Filter.not_eventually.mp hA
    have hfr2 : ∃ᶠ η in nhds ξ, η ∈ DomC B.h qs ∩ {η | f η ≠ 0} :=
      (hfr.and_eventually (hD.mem_nhds hξ)).mono (fun η h => ⟨h.2, h.1⟩)
    have hcl : ξ ∈ closure (DomC B.h qs ∩ {η | f η ≠ 0}) := mem_closure_iff_frequently.mpr hfr2
    have hsub : DomC B.h qs ∩ {η | f η ≠ 0} ⊆
        closure {ζ : Cyl | ζ ∈ DomC B.h qs ∧ f ζ ≠ 0 ∧ B.Xa < XC B.h ζ ∧ XC B.h ζ < B.Xb} :=
      fun η hη => hT η hη.1 hη.2
    have hξS := closure_mono hsub hcl
    rw [closure_closure] at hξS
    exact ContinuousWithinAt.closure_le hξS
      ((hFc.continuousAt (hD.mem_nhds hξ)).continuousWithinAt)
      ((hg.continuousAt (hD.mem_nhds hξ)).continuousWithinAt)
      (fun y hy => hshell y hy.1 hy.2.1 hy.2.2.1 hy.2.2.2)

theorem plin5_nb_gauss_flat : ∀ (B : BG) (G : CorrGeom), B.ok → ∀ (l0 : ℕ), qsOf l0 ≤ B.qB → ∀ (a : WC) (c : ℝ), 0 < c → (∀ γ m, ContDiffOn ℝ ∞ (a γ m) (DomC B.h (qsOf l0))) → (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → a γ m ξ ≠ 0 → B.Xa ≤ XC B.h ξ ∧ XC B.h ξ ≤ B.Xb ∧ etaL B.h γ ξ ≠ 0) → (∀ k : ℕ, ∃ C b : ℝ, ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), a γ m ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → NB B.h (a γ m) k ξ ≤ C * qC B.h ξ ^ (-1:ℝ) * SC B.h ξ ^ b * Real.exp (-c * (γ.1 : ℝ) ^ 2)) → ∀ k N : ℕ, ∃ C : ℝ, ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ‖iteratedFDeriv ℝ k (a γ m) ξ‖ ≤ C * qC B.h ξ ^ (N : ℝ) :=
by
  intro B G hok l0 hqs a c hc hsm hsupp hnb k N
  obtain ⟨hh0, hh1, hXa, hXam1, hm12, hm2Xb, -, -, hqB1, -, -, -, -⟩ := hok.2.1
  have hXab : B.Xa < B.Xb := by linarith
  have hq1 : qsOf l0 ≤ 1 := le_trans hqs hqB1
  obtain ⟨hDo, hqC, hq0, -, -, -⟩ := domc_open_calculus B (qsOf l0) hok
  obtain ⟨C0, hC0, hC0b⟩ := nbg5_plain_le_nb B.h hh0 hh1
  obtain ⟨C, b, hCb⟩ := hnb k
  have hP0 : (0:ℝ) ≤ (N:ℝ) + 3 * (k:ℝ) + 1 := by positivity
  obtain ⟨K, hK0, hK⟩ := nbg5_gauss_absorb c b ((N:ℝ) + 3 * (k:ℝ) + 1) hc hP0
  have hCf : 0 ≤ C0 ^ k * |C| * K :=
    mul_nonneg (mul_nonneg (pow_nonneg (by linarith) k) (abs_nonneg C)) hK0
  refine ⟨C0 ^ k * |C| * K, fun γ m => ?_⟩

  have hshell : ∀ ξ ∈ DomC B.h (qsOf l0), a γ m ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      ‖iteratedFDeriv ℝ k (a γ m) ξ‖ ≤ C0 ^ k * |C| * K * qC B.h ξ ^ (N:ℝ) := by
    intro ξ hξ hne hX1 hX2
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hq : 0 < qC B.h ξ := hq0 ξ hξ
    have hqlt : qC B.h ξ < 1 := lt_of_lt_of_le hξ'.2.2 hq1
    have hpin := (etaL_band_window_v5 B.h γ ξ hq (hsupp γ m ξ hξ hne).2.2).1
    have h1 := hC0b ξ hq hqlt (a γ m) k
    have h2 := hCb γ m ξ hξ hne hX1 hX2
    have h3 := hK (qC B.h ξ) γ.1 hq hqlt.le hpin
    have hSE0 : 0 ≤ ((1 + |Real.log (qC B.h ξ)|) ^ 2) ^ b * Real.exp (-c * (γ.1:ℝ) ^ 2) :=
      mul_nonneg (Real.rpow_nonneg (by positivity) _) (Real.exp_pos _).le
    have hqi : 0 ≤ qC B.h ξ ^ (-1:ℝ) := Real.rpow_nonneg hq.le _
    have h2' : NB B.h (a γ m) k ξ ≤
        |C| * qC B.h ξ ^ (-1:ℝ) * (K * qC B.h ξ ^ ((N:ℝ) + 3 * (k:ℝ) + 1)) := by
      calc NB B.h (a γ m) k ξ
          ≤ C * qC B.h ξ ^ (-1:ℝ) * (((1 + |Real.log (qC B.h ξ)|) ^ 2) ^ b *
              Real.exp (-c * (γ.1:ℝ) ^ 2)) := by rw [← mul_assoc]; exact h2
        _ ≤ |C| * qC B.h ξ ^ (-1:ℝ) * (((1 + |Real.log (qC B.h ξ)|) ^ 2) ^ b *
              Real.exp (-c * (γ.1:ℝ) ^ 2)) := by
            apply mul_le_mul_of_nonneg_right _ hSE0
            exact mul_le_mul_of_nonneg_right (le_abs_self C) hqi
        _ ≤ _ := mul_le_mul_of_nonneg_left h3 (mul_nonneg (abs_nonneg C) hqi)
    have hpow : (C0 * qC B.h ξ ^ (-3:ℝ)) ^ k = C0 ^ k * qC B.h ξ ^ ((-3:ℝ) * (k:ℝ)) := by
      rw [mul_pow, ← Real.rpow_natCast (qC B.h ξ ^ (-3:ℝ)) k, ← Real.rpow_mul hq.le]
    have hexp : qC B.h ξ ^ ((-3:ℝ) * (k:ℝ)) * qC B.h ξ ^ (-1:ℝ) *
        qC B.h ξ ^ ((N:ℝ) + 3 * (k:ℝ) + 1) = qC B.h ξ ^ (N:ℝ) := by
      rw [← Real.rpow_add hq, ← Real.rpow_add hq]
      congr 1
      ring
    have hPk : 0 ≤ (C0 * qC B.h ξ ^ (-3:ℝ)) ^ k :=
      pow_nonneg (mul_nonneg (by linarith) (Real.rpow_nonneg hq.le _)) k
    calc ‖iteratedFDeriv ℝ k (a γ m) ξ‖
        ≤ (C0 * qC B.h ξ ^ (-3:ℝ)) ^ k * NB B.h (a γ m) k ξ := h1
      _ ≤ (C0 * qC B.h ξ ^ (-3:ℝ)) ^ k *
            (|C| * qC B.h ξ ^ (-1:ℝ) * (K * qC B.h ξ ^ ((N:ℝ) + 3 * (k:ℝ) + 1))) :=
          mul_le_mul_of_nonneg_left h2' hPk
      _ = C0 ^ k * |C| * K * (qC B.h ξ ^ ((-3:ℝ) * (k:ℝ)) * qC B.h ξ ^ (-1:ℝ) *
            qC B.h ξ ^ ((N:ℝ) + 3 * (k:ℝ) + 1)) := by rw [hpow]; ring
      _ = C0 ^ k * |C| * K * qC B.h ξ ^ (N:ℝ) := by rw [hexp]

  have hgc : ContinuousOn (fun ξ => C0 ^ k * |C| * K * qC B.h ξ ^ (N:ℝ)) (DomC B.h (qsOf l0)) :=
    continuousOn_const.mul (hqC.continuousOn.rpow_const (fun x hx => Or.inl (hq0 x hx).ne'))
  exact nbg5_closure_extend B (qsOf l0) (a γ m) (fun ξ => C0 ^ k * |C| * K * qC B.h ξ ^ (N:ℝ)) k
    hDo hXa hXab (hsm γ m) hgc (fun ξ hξ => mul_nonneg hCf (Real.rpow_nonneg (hq0 ξ hξ).le _))
    (fun ξ hξ hne => ⟨(hsupp γ m ξ hξ hne).1, (hsupp γ m ξ hξ hne).2.1⟩) hshell

theorem phiL5_local_form_v5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl), B.ok → ξ ∈ DomC B.h B.qB → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → (∃ U : Set Cyl, IsOpen U ∧ ξ ∈ U ∧ ContDiffOn ℝ ∞ (phiL5 B G γ) U) ∧ ContDiffAt ℝ ∞ (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) ξ :=
by
  intro B G γ ξ hok hξ hxi het
  obtain ⟨U, c, hUo, hξU, hUD, hmod⟩ := nPhi5_local_model_v5 B G γ ξ hok hξ hxi het
  have hAff : ContDiff ℝ ∞ (fun η : Cyl =>
      Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1 * lamT η.2.2.2 + c) := by
    simp only [lamT]
    fun_prop
  have hVU : ∀ η ∈ U, vco B.h G.r0 γ (G.ctr γ) η.2.2.2 =
      Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1 * lamT η.2.2.2 + c := fun η hη => (hmod η hη).1
  have hV : ContDiffAt ℝ ∞ (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) ξ :=
    hAff.contDiffAt.congr_of_eventuallyEq (Filter.eventuallyEq_of_mem (hUo.mem_nhds hξU) hVU)
  have hVo : ContDiffOn ℝ ∞ (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) U :=
    hAff.contDiffOn.congr hVU
  obtain ⟨-, hgs⟩ := geom_slow_base_smooth_v5 B hok
  have hπ : ContDiff ℝ ∞ (fun η : Cyl => ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ)) := by fun_prop
  have hmaps : Set.MapsTo (fun η : Cyl => ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ)) (DomC B.h B.qB)
      {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
    intro η hη
    have hη' : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < B.qB := hη
    exact ⟨hη'.1, hη'.2.1, hη'.2.2⟩
  have hbase : ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η => baseC B γ.1 η j) (DomC B.h B.qB) := by
    intro j
    exact ((hgs γ.1 j).comp hπ.contDiffOn hmaps).congr (fun η _ => rfl)
  have hRC : ContDiff ℝ ∞ (fun η : Cyl => RC γ.1 η) := by
    simp only [RC]
    fun_prop
  have hQ : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.2 (Real.rpow_pos_of_pos (by norm_num) _)
  have hRC0 : ∀ η ∈ DomC B.h B.qB, RC γ.1 η ≠ 0 := by
    intro η hη
    have hη' : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < B.qB := hη
    exact (div_pos hη'.1 hQ).ne'
  have hFang : ContDiffOn ℝ ∞ (fun η => Fang B γ.1 η) (DomC B.h B.qB) :=
    (hbase 1).div hRC.contDiffOn hRC0
  have hP : ContDiffOn ℝ ∞ (fun η => pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2)
      (DomC B.h B.qB) :=
    (contDiffOn_const.mul hFang).add (contDiffOn_const.mul (hbase 2))
  have hL : ContDiff ℝ ∞ (fun η : Cyl => pzr5 B G γ * chartZ B.h γ.1 η / epsb B.h γ.1 +
      sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 * RC γ.1 η) := by
    simp only [chartZ, RC]
    fun_prop
  have hφ : ContDiffOn ℝ ∞ (fun η : Cyl => (pzr5 B G γ * chartZ B.h γ.1 η / epsb B.h γ.1 +
      sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 * RC γ.1 η) -
      vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2)) U :=
    hL.contDiffOn.sub (hVo.mul (hP.mono hUD))
  exact ⟨⟨U, hUo, hξU, hφ⟩, hV⟩

theorem phiL5_vP_nb_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C : ℝ, ∀ (l0 : ℕ) (γ : Lab) (ξ : Cyl), l1 ≤ l0 → ξ ∈ DomC B.h (qsOf l0) → SuppW B G γ ξ → etaL B.h γ ξ ≠ 0 → NB B.h (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2)) k ξ ≤ C * (γ.1 : ℝ) ^ 2 :=
by
  intro B G hok hG
  obtain ⟨hh0, hh1, hXa, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨hr0, hr01, -, -, -⟩ := hG.1
  obtain ⟨lr, cr, Cr, -, hR⟩ := rep_consts_v5 B G hok hG
  obtain ⟨lv, Cv, hV⟩ := vco_nb_v5 B hok
  obtain ⟨lcp, hCP⟩ := chart_profile_nb_v5 B hok
  choose Ccp hCcp using hCP
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  obtain ⟨hDo, -, -, -, -, -⟩ := domc_open_calculus B B.qB hok
  obtain ⟨-, hBsm⟩ := geom_slow_base_smooth_v5 B hok
  have hQb : ∀ l : ℕ, Qb l = (1/2:ℝ) ^ l := fun l => by
    show (2:ℝ) ^ (-(l:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  refine ⟨lr + lv + lcp + n0, fun k => ?_⟩
  obtain ⟨E, hE⟩ : ∃ E : ℝ, E = ∑ j ∈ Finset.range (k + 1), |Ccp j| := ⟨_, rfl⟩
  have hCE : ∀ j, j ≤ k → |Ccp j| ≤ E := by
    intro j hj
    rw [hE]
    exact Finset.single_le_sum (f := fun j => |Ccp j|) (fun i _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  refine ⟨2 ^ k * Cv * (2 * |Cr| * E), ?_⟩
  intro l0 γ ξ hl0 hξ hS het
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have hqs : qsOf l0 = (1/2:ℝ) ^ l0 := hQb l0
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hqs]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hξB : ξ ∈ DomC B.h B.qB := ⟨hξ'.1, hξ'.2.1, lt_of_lt_of_le hξ'.2.2 hqsB⟩
  obtain ⟨hb1, hb2⟩ := etaL_band_window_v5 B.h γ ξ hq0 het
  have hq1 : 1/4 < qC B.h ξ / Qb γ.1 := by linarith
  have hq2 : qC B.h ξ / Qb γ.1 < 4 := by linarith
  have hQ0 : 0 < Qb γ.1 := by rw [hQb]; positivity
  have hl0γ : l0 ≤ γ.1 := by
    by_contra hcon
    push_neg at hcon
    have h1 : (1/2:ℝ) ^ l0 ≤ (1/2:ℝ) ^ (γ.1 + 1) :=
      pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
    have h2 : (1/2:ℝ) ^ (γ.1 + 1) = Qb γ.1 / 2 := by rw [hQb, pow_succ]; ring
    have h3 : qC B.h ξ < (1/2:ℝ) ^ l0 := by rw [← hqs]; exact hξ'.2.2
    have hQq : Qb γ.1 < 2 * qC B.h ξ := by
      have := (lt_div_iff₀ hQ0).1 hb1
      linarith
    linarith
  have hXab : B.Xa ≤ B.Xb := le_trans hS.2.2.2.2.1 hS.2.2.2.2.2
  have hX1 : B.Xa / 2 < XC B.h ξ := by linarith [hS.2.2.2.2.1]
  have hX2 : XC B.h ξ < 2 * B.Xb := by linarith [hS.2.2.2.2.2]
  have hxi : |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 := by have := hS.2.2.1; linarith
  have het8 : |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 := by have := hS.2.2.2.1; linarith
  have hAct : ActiveL4 B G γ := ⟨hS.1.1, ξ, hξB, het, hS.2.2.2.2.1, hS.2.2.2.2.2⟩
  have hRc := hR γ hAct (by omega)
  have hpa : |pang5 B G γ| ≤ |Cr| := hRc.2.2.1.trans (le_abs_self _)
  have hpz : |pzr5 B G γ| ≤ |Cr| := hRc.2.1.trans (le_abs_self _)

  have hVb : ∀ i, NB B.h (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) i ξ ≤ Cv * (γ.1 : ℝ) ^ 2 :=
    fun i => hV γ G.r0 (G.ctr γ) l0 hr0.le hr01 (by omega) hl0γ ξ hξ hq1 hq2 hxi het8 i

  obtain ⟨U, c1, hUo, hξU, -, hloc⟩ := nPhi5_local_model_v5 B G γ ξ hok hξB hxi het8
  have hvaS : ContDiff ℝ ∞ (fun η : Cyl => Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1 * lamT η.2.2.2 + c1) := by
    unfold lamT; fun_prop
  have hVc : ContDiffAt ℝ ∞ (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) ξ :=
    hvaS.contDiffAt.congr_of_eventuallyEq
      (Filter.eventuallyEq_of_mem (hUo.mem_nhds hξU) (fun η hη => (hloc η hη).1))

  set Ω : Set (ℝ × ℝ × ℝ) := {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}
    with hΩ
  have hB2 : ContDiffOn ℝ ∞ (pcB5 B γ.1 2) Ω := hBsm γ.1 2
  have hB1 : ContDiffOn ℝ ∞ (pcB5 B γ.1 1) Ω := hBsm γ.1 1
  have hRC : ContDiffOn ℝ ∞ (pcRC5 γ.1) Ω := by
    have : ContDiff ℝ ∞ (pcRC5 γ.1) := by unfold pcRC5; fun_prop
    exact this.contDiffOn
  have hFa : ContDiffOn ℝ ∞ (pcFa5 B γ.1) Ω := by
    have := hB1.div hRC (fun s hs => by
      unfold pcRC5
      exact div_ne_zero (ne_of_gt hs.1) (Real.sqrt_pos.mpr hQ0).ne')
    exact this
  have hmaps : Set.MapsTo (fun η : Cyl => ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ)) (DomC B.h B.qB) Ω := by
    intro η hη
    simp only [hΩ, Set.mem_setOf_eq]
    exact ⟨hη.1, hη.2.1, hη.2.2⟩
  have hπ : ContDiff ℝ ∞ (fun η : Cyl => ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ)) := by fun_prop
  have eFa : Fang B γ.1 = fun η : Cyl => pcFa5 B γ.1 (η.1, η.2.1, η.2.2.1) := rfl
  have eB2 : (fun η : Cyl => baseC B γ.1 η 2) = fun η : Cyl => pcB5 B γ.1 2 (η.1, η.2.1, η.2.2.1) := rfl
  have hFaD : ContDiffOn ℝ ∞ (Fang B γ.1) (DomC B.h B.qB) := by
    rw [eFa]; exact hFa.comp hπ.contDiffOn hmaps
  have hB2D : ContDiffOn ℝ ∞ (fun η : Cyl => baseC B γ.1 η 2) (DomC B.h B.qB) := by
    rw [eB2]; exact hB2.comp hπ.contDiffOn hmaps
  have hPD : ContDiffOn ℝ ∞ (fun η : Cyl => pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2)
      (DomC B.h B.qB) := (contDiffOn_const.mul hFaD).add (contDiffOn_const.mul hB2D)
  have hPc := hPD.contDiffAt (hDo.mem_nhds hξB)

  have hPb : ∀ i, i ≤ k →
      NB B.h (fun η : Cyl => pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2) i ξ ≤
        2 * |Cr| * E := by
    intro i hi
    have hlin := (nb_real_algebra_v5 B.h (DomC B.h B.qB) ξ hDo hξB (Fang B γ.1)
      (fun η : Cyl => baseC B γ.1 η 2) hFaD hB2D i).2.1 (pang5 B G γ) (pzr5 B G γ)
    refine hlin.trans ?_
    obtain ⟨a1, a2⟩ := hCcp i γ.1 l0 (by omega) hl0γ ξ hξ hq1 hq2 hX1 hX2
    have hc := hCE i hi
    have f1 : NB B.h (Fang B γ.1) i ξ ≤ E := by
      rw [eFa]; exact a1.trans ((le_abs_self _).trans hc)
    have f2 : NB B.h (fun η : Cyl => baseC B γ.1 η 2) i ξ ≤ E := by
      rw [eB2]; exact a2.trans ((le_abs_self _).trans hc)
    have m1 : |pang5 B G γ| * NB B.h (Fang B γ.1) i ξ ≤ |Cr| * E :=
      mul_le_mul hpa f1 (norm_nonneg _) (abs_nonneg _)
    have m2 : |pzr5 B G γ| * NB B.h (fun η : Cyl => baseC B γ.1 η 2) i ξ ≤ |Cr| * E :=
      mul_le_mul hpz f2 (norm_nonneg _) (abs_nonneg _)
    linarith
  have hprod := nb_real_mul_le_v5 B.h ξ (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2)
    (fun η : Cyl => pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2) k
    (Cv * (γ.1 : ℝ) ^ 2) (2 * |Cr| * E) hVc hPc (fun i _ => hVb i) hPb
  refine hprod.trans (le_of_eq ?_)
  ring

theorem phiL5_jet_poly_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C M : ℝ, 0 ≤ M ∧ ∀ (l0 : ℕ) (γ : Lab) (ξ : Cyl), l1 ≤ l0 → ξ ∈ DomC B.h (qsOf l0) → SuppW B G γ ξ → etaL B.h γ ξ ≠ 0 → (∃ U : Set Cyl, IsOpen U ∧ ξ ∈ U ∧ ContDiffOn ℝ ∞ (phiL5 B G γ) U) ∧ (1 ≤ k → (kb B.h γ.1 : ℝ) * ‖iteratedFDeriv ℝ k (phiL5 B G γ) ξ‖ ≤ C * qC B.h ξ ^ (-M)) :=
by
  intro B G hok hG
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨hr0, hr1, hu, -, -⟩ := hG.1
  obtain ⟨C0, hC0, hconv⟩ := nbg5_plain_le_nb B.h hh0 hh1
  obtain ⟨l4, h4⟩ := phiL5_vP_nb_v5 B G hok hG
  obtain ⟨lr, cr, Cr, -, hrep⟩ := rep_consts_v5 B G hok hG
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  have hQb : ∀ l : ℕ, Qb l = (1/2:ℝ) ^ l := fun l => by
    show (2:ℝ) ^ (-(l:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  refine ⟨l4 + n0 + lr, fun k => ?_⟩
  obtain ⟨C4, hC4⟩ := h4 k
  refine ⟨3 * |Cr| * (2 + G.ustar) + 12 * C0 ^ k * |C4|, ((3 * k + 3 : ℕ) : ℝ), Nat.cast_nonneg _, ?_⟩
  intro l0 γ ξ hl0 hξ hS het
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have hqs : qsOf l0 = (1/2:ℝ) ^ l0 := hQb l0
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hqs]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hq1 : qC B.h ξ < 1 :=
    lt_of_lt_of_le hξ'.2.2 (by rw [hqs]; exact pow_le_one₀ (by norm_num) (by norm_num))
  have hξB : ξ ∈ DomC B.h B.qB := ⟨hξ'.1, hξ'.2.1, lt_of_lt_of_le hξ'.2.2 hqsB⟩
  obtain ⟨hb1, hb2⟩ := etaL_band_window_v5 B.h γ ξ hq0 het
  have hQ0 : 0 < Qb γ.1 := by rw [hQb]; positivity
  have hQ1 : Qb γ.1 ≤ 1 := by rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have hQq : Qb γ.1 < 2 * qC B.h ξ := by
    have := (lt_div_iff₀ hQ0).1 hb1
    linarith

  have hl0γ : l0 ≤ γ.1 := by
    by_contra hcon
    push_neg at hcon
    have h1 : (1/2:ℝ) ^ l0 ≤ (1/2:ℝ) ^ (γ.1 + 1) :=
      pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
    have h2 : (1/2:ℝ) ^ (γ.1 + 1) = Qb γ.1 / 2 := by rw [hQb, pow_succ]; ring
    have h3 : qC B.h ξ < (1/2:ℝ) ^ l0 := by rw [← hqs]; exact hξ'.2.2
    linarith
  obtain ⟨x, hxdef⟩ : ∃ x : ℝ, x = (qC B.h ξ)⁻¹ := ⟨_, rfl⟩
  have hx0 : 0 < x := by rw [hxdef]; exact inv_pos.2 hq0
  have hx1 : 1 ≤ x := by rw [hxdef]; exact (one_le_inv₀ hq0).2 hq1.le
  have hQinv : (Qb γ.1)⁻¹ < 2 * x := by
    have e : (qC B.h ξ)⁻¹ * (qC B.h ξ / Qb γ.1) = (Qb γ.1)⁻¹ := by
      rw [div_eq_mul_inv, ← mul_assoc, inv_mul_cancel₀ hq0.ne', one_mul]
    rw [← e, hxdef]
    have := mul_lt_mul_of_pos_left hb2 (inv_pos.2 hq0)
    linarith
  have hkb : (kb B.h γ.1 : ℝ) ≤ 3 * x := by
    have hep : 0 ≤ epsb B.h γ.1 := Real.rpow_nonneg hQ0.le _
    have hE : epsb B.h γ.1 ^ (-(1/2:ℝ)) ≤ (Qb γ.1)⁻¹ := by
      rw [epsb, ← Real.rpow_mul hQ0.le, ← Real.rpow_neg_one]
      exact Real.rpow_le_rpow_of_exponent_ge hQ0 hQ1 (by linarith)
    have hc := Nat.ceil_lt_add_one (Real.rpow_nonneg hep (-(1/2:ℝ)))
    unfold kb
    linarith
  have hℓ : (γ.1 : ℝ) ^ 2 ≤ 4 * x ^ 2 := by
    have h1 : (γ.1 : ℝ) < 2 ^ γ.1 := by exact_mod_cast (Nat.lt_two_pow_self : γ.1 < 2 ^ γ.1)
    have h2 : (2:ℝ) ^ γ.1 = (Qb γ.1)⁻¹ := by rw [hQb, one_div, inv_pow, inv_inv]
    have h3 : (γ.1 : ℝ) ≤ 2 * x := by linarith
    have h0 : (0:ℝ) ≤ γ.1 := Nat.cast_nonneg _
    calc (γ.1 : ℝ) ^ 2 = (γ.1 : ℝ) * γ.1 := sq _
      _ ≤ (2 * x) * (2 * x) := mul_le_mul h3 h3 h0 (by linarith)
      _ = 4 * x ^ 2 := by ring

  have hAct : ActiveL4 B G γ := ⟨hS.1.1, ξ, hξB, het, hS.2.2.2.2.1, hS.2.2.2.2.2⟩
  obtain ⟨-, hpz, -, hBs⟩ := hrep γ hAct (by omega)
  have hxi : |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 := by have := hS.2.2.1; linarith
  have het8 : |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 := by have := hS.2.2.2.1; linarith
  obtain ⟨⟨U, hUo, hξU, hφU⟩, -⟩ := phiL5_local_form_v5 B G γ ξ hok hξB hxi het8
  refine ⟨⟨U, hUo, hξU, hφU⟩, fun hk => ?_⟩

  obtain ⟨A1, hA1⟩ : ∃ A1 : ℝ, A1 = pzr5 B G γ * (Qb γ.1 ^ (1/2 - B.h) * epsb B.h γ.1)⁻¹ := ⟨_, rfl⟩
  obtain ⟨A2, hA2⟩ : ∃ A2 : ℝ, A2 = (sgn γ.2.2 * Bs5 B G γ * G.ustar / 2) * (Real.sqrt (Qb γ.1))⁻¹ :=
    ⟨_, rfl⟩
  obtain ⟨Lc, hLc⟩ : ∃ Lc : Cyl →L[ℝ] ℝ, ∀ v : Cyl, Lc v = A1 * v.2.1 + A2 * v.1 :=
    ⟨A1 • ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
        (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))) +
      A2 • ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)), fun v => by simp⟩
  obtain ⟨Wf, hWf⟩ : ∃ Wf : Cyl → ℝ, Wf = fun η => Lc η - phiL5 B G γ η := ⟨_, rfl⟩
  have hWeq : Wf = fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2 *
      (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2) := by
    rw [hWf]
    funext η
    rw [hLc]
    simp only [phiL5, chartZ, RC, hA1, hA2]
    ring
  have hsplit : phiL5 B G γ = ⇑Lc - Wf := by
    funext η
    rw [hWf]
    simp only [Pi.sub_apply]
    ring
  have hφc : ContDiffAt ℝ ∞ (phiL5 B G γ) ξ := hφU.contDiffAt (hUo.mem_nhds hξU)
  have hLcc : ContDiffAt ℝ ∞ (⇑Lc) ξ := Lc.contDiff.contDiffAt
  have hWc : ContDiffAt ℝ ∞ Wf ξ := by rw [hWf]; exact hLcc.sub hφc
  have hDk : ‖iteratedFDeriv ℝ k (phiL5 B G γ) ξ‖ ≤
      ‖iteratedFDeriv ℝ k (⇑Lc) ξ‖ + ‖iteratedFDeriv ℝ k Wf ξ‖ := by
    rw [hsplit, iteratedFDeriv_sub_apply (hLcc.of_le (by exact_mod_cast le_top))
      (hWc.of_le (by exact_mod_cast le_top))]
    exact norm_sub_le _ _

  have hDL : ‖iteratedFDeriv ℝ k (⇑Lc) ξ‖ ≤ ‖Lc‖ := by
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    rw [← norm_iteratedFDeriv_fderiv]
    have hfd : fderiv ℝ (⇑Lc) = fun _ => Lc := funext (fun y => Lc.fderiv)
    rw [hfd]
    rcases Nat.eq_zero_or_pos j with hj | hj
    · subst hj
      rw [norm_iteratedFDeriv_zero]
    · rw [iteratedFDeriv_const_of_ne (by omega) Lc]
      simp
  have hLcn : ‖Lc‖ ≤ ‖A1‖ + ‖A2‖ := by
    refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun v => ?_)
    rw [hLc]
    have h1 : ‖v.2.1‖ ≤ ‖v‖ := (norm_fst_le v.2).trans (norm_snd_le v)
    have h2 : ‖v.1‖ ≤ ‖v‖ := norm_fst_le v
    calc ‖A1 * v.2.1 + A2 * v.1‖ ≤ ‖A1 * v.2.1‖ + ‖A2 * v.1‖ := norm_add_le _ _
      _ = ‖A1‖ * ‖v.2.1‖ + ‖A2‖ * ‖v.1‖ := by rw [norm_mul, norm_mul]
      _ ≤ ‖A1‖ * ‖v‖ + ‖A2‖ * ‖v‖ :=
          add_le_add (mul_le_mul_of_nonneg_left h1 (norm_nonneg _))
            (mul_le_mul_of_nonneg_left h2 (norm_nonneg _))
      _ = (‖A1‖ + ‖A2‖) * ‖v‖ := by ring
  have hD1 : Qb γ.1 ^ (1/2 - B.h) * epsb B.h γ.1 = Qb γ.1 ^ (1/2:ℝ) := by
    rw [epsb, ← Real.rpow_add hQ0]
    congr 1
    ring
  have hQhalf : Qb γ.1 ≤ Qb γ.1 ^ (1/2:ℝ) := by
    have := Real.rpow_le_rpow_of_exponent_ge hQ0 hQ1 (by norm_num : (1/2:ℝ) ≤ 1)
    rwa [Real.rpow_one] at this
  have hD1pos : 0 < Qb γ.1 ^ (1/2 - B.h) * epsb B.h γ.1 := by
    rw [hD1]; exact Real.rpow_pos_of_pos hQ0 _
  have hD1inv : (Qb γ.1 ^ (1/2 - B.h) * epsb B.h γ.1)⁻¹ ≤ (Qb γ.1)⁻¹ := by
    rw [hD1]; exact inv_anti₀ hQ0 hQhalf
  have hsq : Qb γ.1 ≤ Real.sqrt (Qb γ.1) := by
    rw [Real.le_sqrt hQ0.le hQ0.le, sq]
    exact mul_le_of_le_one_left hQ0.le hQ1
  have hsqinv : (Real.sqrt (Qb γ.1))⁻¹ ≤ (Qb γ.1)⁻¹ := inv_anti₀ hQ0 hsq
  have hA1b : ‖A1‖ ≤ |Cr| * (2 * x) := by
    rw [hA1, norm_mul, Real.norm_of_nonneg (inv_nonneg.2 hD1pos.le), Real.norm_eq_abs]
    exact mul_le_mul (hpz.trans (le_abs_self _)) (hD1inv.trans hQinv.le)
      (inv_nonneg.2 hD1pos.le) (abs_nonneg _)
  have hsgn : |sgn γ.2.2| = 1 := by
    unfold sgn
    split_ifs <;> simp
  have hA2b : ‖A2‖ ≤ |Cr| * G.ustar / 2 * (2 * x) := by
    have e : |sgn γ.2.2 * Bs5 B G γ * G.ustar / 2| = |Bs5 B G γ| * G.ustar / 2 := by
      rw [abs_div, abs_mul, abs_mul, hsgn, one_mul, abs_of_pos hu, abs_two]
    have hB2 : |Bs5 B G γ| * G.ustar / 2 ≤ |Cr| * G.ustar / 2 :=
      div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_right (hBs.trans (le_abs_self _)) hu.le) (by norm_num)
    rw [hA2, norm_mul, Real.norm_of_nonneg (inv_nonneg.2 (Real.sqrt_nonneg _)), Real.norm_eq_abs, e]
    exact mul_le_mul hB2 (hsqinv.trans hQinv.le) (inv_nonneg.2 (Real.sqrt_nonneg _))
      (by have := abs_nonneg Cr; positivity)
  have hDLb : ‖iteratedFDeriv ℝ k (⇑Lc) ξ‖ ≤ |Cr| * (2 + G.ustar) * x := by
    have := hDL.trans (hLcn.trans (add_le_add hA1b hA2b))
    calc _ ≤ |Cr| * (2 * x) + |Cr| * G.ustar / 2 * (2 * x) := this
      _ = |Cr| * (2 + G.ustar) * x := by ring

  have hq3 : qC B.h ξ ^ (-3:ℝ) = x ^ 3 := by
    rw [show (-3:ℝ) = -((3:ℕ):ℝ) by norm_num, Real.rpow_neg hq0.le, Real.rpow_natCast, hxdef, inv_pow]
  have hNB : NB B.h Wf k ξ ≤ |C4| * (4 * x ^ 2) := by
    rw [hWeq]
    refine (hC4 l0 γ ξ (by omega) hξ hS het).trans ?_
    exact (mul_le_mul_of_nonneg_right (le_abs_self _) (sq_nonneg _)).trans
      (mul_le_mul_of_nonneg_left hℓ (abs_nonneg _))
  have hDW : ‖iteratedFDeriv ℝ k Wf ξ‖ ≤ (C0 * x ^ 3) ^ k * (|C4| * (4 * x ^ 2)) := by
    have hc := hconv ξ hq0 hq1 Wf k
    rw [hq3] at hc
    exact hc.trans (mul_le_mul_of_nonneg_left hNB
      (pow_nonneg (mul_nonneg (by linarith) (pow_nonneg hx0.le 3)) k))

  have hnorm : ‖iteratedFDeriv ℝ k (phiL5 B G γ) ξ‖ ≤
      |Cr| * (2 + G.ustar) * x + (C0 * x ^ 3) ^ k * (|C4| * (4 * x ^ 2)) :=
    hDk.trans (add_le_add hDLb hDW)
  have hx2 : x ^ 2 ≤ x ^ (3 * k + 3) := pow_le_pow_right₀ hx1 (by omega)
  have hL0 : 0 ≤ 3 * (|Cr| * (2 + G.ustar)) :=
    mul_nonneg (by norm_num) (mul_nonneg (abs_nonneg _) (by linarith))
  have hqM : qC B.h ξ ^ (-((3 * k + 3 : ℕ) : ℝ)) = x ^ (3 * k + 3) := by
    rw [Real.rpow_neg hq0.le, Real.rpow_natCast, hxdef, inv_pow]
  rw [hqM]
  calc (kb B.h γ.1 : ℝ) * ‖iteratedFDeriv ℝ k (phiL5 B G γ) ξ‖
      ≤ (3 * x) * (|Cr| * (2 + G.ustar) * x + (C0 * x ^ 3) ^ k * (|C4| * (4 * x ^ 2))) :=
        mul_le_mul hkb hnorm (norm_nonneg _) (by linarith)
    _ = 3 * (|Cr| * (2 + G.ustar)) * x ^ 2 + 12 * C0 ^ k * |C4| * x ^ (3 * k + 3) := by
        rw [mul_pow, ← pow_mul]
        ring
    _ ≤ 3 * (|Cr| * (2 + G.ustar)) * x ^ (3 * k + 3) + 12 * C0 ^ k * |C4| * x ^ (3 * k + 3) :=
        add_le_add (mul_le_mul_of_nonneg_left hx2 hL0) le_rfl
    _ = (3 * |Cr| * (2 + G.ustar) + 12 * C0 ^ k * |C4|) * x ^ (3 * k + 3) := by ring

theorem plin5_phase_flat : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (a : WC), (∀ γ m, ContDiffOn ℝ ∞ (a γ m) (DomC B.h (qsOf l0))) → (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → a γ m ξ ≠ 0 → (m = 1 ∨ m = -1) ∧ SuppW B G γ ξ ∧ etaL B.h γ ξ ≠ 0) → (∀ k N : ℕ, ∃ C : ℝ, ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ‖iteratedFDeriv ℝ k (a γ m) ξ‖ ≤ C * qC B.h ξ ^ (N : ℝ)) → ∀ (i : Fin 3), (∀ γ m, ContDiffOn ℝ ∞ (fun η => a γ m η i * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ)))) (DomC B.h (qsOf l0))) ∧ ∀ k N : ℕ, ∃ C : ℝ, ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ‖iteratedFDeriv ℝ k (fun η => a γ m η i * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ)))) ξ‖ ≤ C * qC B.h ξ ^ (N : ℝ) :=
by
  intro B G hok hG

  have core : ∀ (D U : Set Cyl) (ξ : Cyl) (f : Cyl → ℂ) (φ : Cyl → ℝ) (c A Cp P : ℝ) (k : ℕ),
      IsOpen D → IsOpen U → ξ ∈ D → ξ ∈ U → ContDiffOn ℝ ∞ f D → ContDiffOn ℝ ∞ φ U → 1 ≤ A →
      (∀ j : ℕ, 1 ≤ j → j ≤ k → |c| * ‖iteratedFDeriv ℝ j φ ξ‖ ≤ A) →
      (∀ j : ℕ, j ≤ k → ‖iteratedFDeriv ℝ j f ξ‖ ≤ Cp * P) →
      ‖iteratedFDeriv ℝ k (fun η => f η * Complex.exp (Complex.I * ((c * φ η : ℝ) : ℂ))) ξ‖ ≤
        2 ^ k * (k.factorial : ℝ) * (Cp * P) * A ^ k := by
    intro D U ξ f φ c A Cp P k hD hU hξD hξU hf hφ hA hφb hfb
    have hg : ContDiff ℝ ∞ (fun s : ℝ => Complex.exp (Complex.I * (s : ℂ))) :=
      Complex.contDiff_exp.comp (contDiff_const.mul Complex.ofRealCLM.contDiff)
    have hgd : ∀ (n : ℕ) (s : ℝ), iteratedDeriv n (fun s : ℝ => Complex.exp (Complex.I * (s : ℂ))) s =
        Complex.I ^ n * Complex.exp (Complex.I * (s : ℂ)) := by
      intro n
      induction n with
      | zero => intro s; simp
      | succ n ih =>
        intro s
        rw [iteratedDeriv_succ]
        have e : iteratedDeriv n (fun s : ℝ => Complex.exp (Complex.I * (s : ℂ))) =
            fun s : ℝ => Complex.I ^ n * Complex.exp (Complex.I * (s : ℂ)) := funext ih
        rw [e]
        have h : HasDerivAt (fun s : ℝ => Complex.I ^ n * Complex.exp (Complex.I * (s : ℂ)))
            (Complex.I ^ n * (Complex.exp (Complex.I * (s : ℂ)) * (Complex.I * 1))) s := by
          apply HasDerivAt.const_mul
          apply HasDerivAt.cexp
          apply HasDerivAt.const_mul
          exact (hasDerivAt_id s).ofReal_comp
        rw [h.deriv]
        ring
    have hgn : ∀ (n : ℕ) (s : ℝ),
        ‖iteratedFDeriv ℝ n (fun s : ℝ => Complex.exp (Complex.I * (s : ℂ))) s‖ = 1 := by
      intro n s
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, hgd, norm_mul, norm_pow, Complex.norm_I, one_pow,
        one_mul, mul_comm]
      exact Complex.norm_exp_ofReal_mul_I s
    have hcφ : ContDiffOn ℝ ∞ (fun η => c * φ η) U := contDiffOn_const.mul hφ
    have hE : ContDiffOn ℝ ∞ (fun η => Complex.exp (Complex.I * ((c * φ η : ℝ) : ℂ))) U :=
      hg.comp_contDiffOn hcφ
    have hEb : ∀ j : ℕ, j ≤ k →
        ‖iteratedFDeriv ℝ j (fun η => Complex.exp (Complex.I * ((c * φ η : ℝ) : ℂ))) ξ‖ ≤
          (k.factorial : ℝ) * A ^ k := by
      intro j hj
      have hcomp := norm_iteratedFDerivWithin_comp_le (n := j) (s := U) (t := Set.univ) (x := ξ)
        (C := 1) (D := A) hg.contDiffOn hcφ (by exact_mod_cast le_top) uniqueDiffOn_univ hU.uniqueDiffOn
        (Set.mapsTo_univ _ _) hξU
        (fun i _ => by rw [iteratedFDerivWithin_univ, hgn])
        (fun i hi1 hij => by
          rw [iteratedFDerivWithin_of_isOpen i hU hξU]
          have e : (fun η => c * φ η) = c • φ := by funext η; simp [smul_eq_mul]
          rw [e, iteratedFDeriv_const_smul_apply ((hφ.contDiffAt (hU.mem_nhds hξU)).of_le
            (by exact_mod_cast le_top)), norm_smul, Real.norm_eq_abs]
          exact le_trans (hφb i hi1 (le_trans hij hj)) (le_self_pow₀ hA (by omega)))
      rw [iteratedFDerivWithin_of_isOpen j hU hξU] at hcomp
      have e2 : ((fun s : ℝ => Complex.exp (Complex.I * (s : ℂ))) ∘ fun η => c * φ η) =
          fun η => Complex.exp (Complex.I * ((c * φ η : ℝ) : ℂ)) := rfl
      rw [e2] at hcomp
      calc _ ≤ (j.factorial : ℝ) * 1 * A ^ j := hcomp
        _ ≤ (k.factorial : ℝ) * A ^ k := by
          rw [mul_one]
          apply mul_le_mul (by exact_mod_cast Nat.factorial_le hj) (pow_le_pow_right₀ hA hj)
            (by positivity) (by positivity)
    have hW : IsOpen (U ∩ D) := hU.inter hD
    have hξW : ξ ∈ U ∩ D := ⟨hξU, hξD⟩
    have hL := norm_iteratedFDerivWithin_mul_le (n := k) (hf.mono Set.inter_subset_right)
      (hE.mono Set.inter_subset_left) hW.uniqueDiffOn hξW (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen k hW hξW] at hL
    refine le_trans hL ?_
    have hP0 : ∀ j ≤ k, 0 ≤ Cp * P := fun j hj => le_trans (norm_nonneg _) (hfb j hj)
    calc ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * ‖iteratedFDerivWithin ℝ i f (U ∩ D) ξ‖ *
          ‖iteratedFDerivWithin ℝ (k - i) (fun η => Complex.exp (Complex.I * ((c * φ η : ℝ) : ℂ)))
            (U ∩ D) ξ‖
        ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (Cp * P) * ((k.factorial : ℝ) * A ^ k) := by
          apply Finset.sum_le_sum
          intro i hi
          have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [iteratedFDerivWithin_of_isOpen i hW hξW, iteratedFDerivWithin_of_isOpen (k - i) hW hξW]
          apply mul_le_mul (mul_le_mul_of_nonneg_left (hfb i hik) (by positivity))
            (hEb (k - i) (Nat.sub_le k i)) (norm_nonneg _)
            (mul_nonneg (by positivity) (hP0 i hik))
      _ = 2 ^ k * (k.factorial : ℝ) * (Cp * P) * A ^ k := by
          rw [← Finset.sum_mul, ← Finset.sum_mul]
          have hs : ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) = 2 ^ k := by
            exact_mod_cast Nat.sum_range_choose k
          rw [hs]
          ring

