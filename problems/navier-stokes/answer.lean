      rw [hint]
      unfold shapeDatum
      push_cast
      ring

  have hder : ∀ η₀ : ℝ, HasDerivAt (shapeDatum c ϑ)
      (2 * η₀ * (1 + η₀ ^ 2)⁻¹ * ∫ y, ϑ y * c y ^ 2 * ((1 + η₀ ^ 2)⁻¹) ^ (2 * ϑ y)) η₀ := by
