          ((m * pint5 B G γ : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
        push_cast; ring
      rw [e, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]
    have hper_w : ∀ (θ : ℝ) (ξ : Cyl) (i : Fin 3),
        waveV5 B G S.Aw (θ + 2 * Real.pi) ξ i = waveV5 B G S.Aw θ ξ i := by
      intro θ ξ i
      simp only [waveV5, hper_e]
    have hterm := wave5_term B G (qsOf l0) α S.Aw hok hG hqB hAw
    have hwave : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => waveV5 B G S.Aw p.1 p.2 i)
        (univ ×ˢ DomC B.h (qsOf l0)) := by
      intro i
      apply contDiffOn_of_locally_contDiffOn
      rintro ⟨θ₀, ξ₀⟩ ⟨-, hξ₀⟩
      obtain ⟨N, hNo, hξN, Γ, H, hΓ⟩ := wave5_lf B G (qsOf l0) α S.Aw hok hAw ξ₀ hξ₀
      refine ⟨univ ×ˢ N, isOpen_univ.prod hNo, ⟨mem_univ _, hξN⟩, ?_⟩
      have h1 : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl =>
          ∑ γ ∈ Γ, ∑ m ∈ H, S.Aw γ m p.2 i * ephase5 B G γ m p.1 p.2) (univ ×ˢ DomC B.h (qsOf l0)) :=
        ContDiffOn.sum (fun γ _ => ContDiffOn.sum (fun m _ => hterm γ m i))
      have hsum := Complex.reCLM.contDiff.comp_contDiffOn h1
      refine (hsum.mono inter_subset_left).congr ?_
      rintro ⟨θ, ξ⟩ ⟨⟨-, hξD⟩, ⟨-, hξN'⟩⟩
      have hmem : ξ ∈ N ∩ DomC B.h (qsOf l0) := ⟨hξN', hξD⟩
      simp only [waveV5, Function.comp_apply, Complex.reCLM_apply]
      congr 1
      have hin : ∀ γ, ∑ᶠ m : ℤ, S.Aw γ m ξ i * ephase5 B G γ m θ ξ =
          ∑ m ∈ H, S.Aw γ m ξ i * ephase5 B G γ m θ ξ := by
        intro γ
        apply finsum_eq_sum_of_support_subset
        intro m hm
        rw [Function.mem_support] at hm
        have hne : S.Aw γ m ξ ≠ 0 := by
          intro h0; apply hm; simp [h0]
        exact Finset.mem_coe.mpr (hΓ ξ hmem γ m hne).2
      rw [finsum_congr hin]
      apply finsum_eq_sum_of_support_subset
      intro γ hγ
      rw [Function.mem_support] at hγ
      apply Finset.mem_coe.mpr
      by_contra hnot
      apply hγ
      apply Finset.sum_eq_zero
      intro m _
      have h0 : S.Aw γ m ξ = 0 := by
        by_contra h0
        exact hnot (hΓ ξ hmem γ m h0).1
      simp [h0]
    have hwθ : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ³ × Cyl => waveV5 B G S.Aw (thetaOf p.1) p.2 i)
        ({y : ℝ³ | 0 < rad y} ×ˢ DomC B.h (qsOf l0)) := fun i =>
      thetaOf_pc (DomC B.h (qsOf l0)) (fun q : ℝ × Cyl => waveV5 B G S.Aw q.1 q.2 i) (hwave i)
        (fun θ e => hper_w θ e i)
    have hAX := ax5_lift B G l0 S hok hqB hPsi.1 hwθ
    have hg : ContDiff ℝ ∞ (fun y : ℝ³ => ((y, t, Y0) : ℝ³ × ℝ × (ℝ × ℝ))) :=
      contDiff_id.prodMk contDiff_const
    exact (hAX.comp hg.contDiffOn (fun y hy => hy)).congr (fun y _ => rfl)

theorem mmu_circle_avg_shift : ∀ (F₀ D b : ℝ³ → ℝ³) (φ : ℝ × ℝ → ℝ) (U : Set ℝ³) (ξ : Cyl) (ψ : ℝ), IsOpen U → 0 < ξ.1 → (∀ θ : ℝ, rotPt ξ.1 θ ξ.2.1 ∈ U) → ContDiffOn ℝ 1 F₀ U → ContinuousOn b U → DifferentiableAt ℝ φ (ξ.1, ξ.2.1) → (∀ y ∈ U, D y = φ (rad y, y 2) • eTh y) → (∀ a : Fin 3, thA (fun θ => inner ℝ (curl3 (fun y => F₀ y + D y) (rotPt ξ.1 θ ξ.2.1) + (b (rotPt ξ.1 θ ξ.2.1) + ψ • eTh (rotPt ξ.1 θ ξ.2.1))) (frameAt θ ξ a)) = thA (fun θ => inner ℝ (curl3 F₀ (rotPt ξ.1 θ ξ.2.1) + b (rotPt ξ.1 θ ξ.2.1)) (frameAt θ ξ a)) + ![-(fderiv ℝ φ (ξ.1, ξ.2.1) (0, 1)), ψ, fderiv ℝ φ (ξ.1, ξ.2.1) (1, 0) + φ (ξ.1, ξ.2.1) / ξ.1] a) ∧ (∀ a a' : Fin 3, thA (fun θ => (inner ℝ (curl3 (fun y => F₀ y + D y) (rotPt ξ.1 θ ξ.2.1) + (b (rotPt ξ.1 θ ξ.2.1) + ψ • eTh (rotPt ξ.1 θ ξ.2.1))) (frameAt θ ξ a) - thA (fun θ' => inner ℝ (curl3 (fun y => F₀ y + D y) (rotPt ξ.1 θ' ξ.2.1) + (b (rotPt ξ.1 θ' ξ.2.1) + ψ • eTh (rotPt ξ.1 θ' ξ.2.1))) (frameAt θ' ξ a))) * (inner ℝ (curl3 (fun y => F₀ y + D y) (rotPt ξ.1 θ ξ.2.1) + (b (rotPt ξ.1 θ ξ.2.1) + ψ • eTh (rotPt ξ.1 θ ξ.2.1))) (frameAt θ ξ a') - thA (fun θ' => inner ℝ (curl3 (fun y => F₀ y + D y) (rotPt ξ.1 θ' ξ.2.1) + (b (rotPt ξ.1 θ' ξ.2.1) + ψ • eTh (rotPt ξ.1 θ' ξ.2.1))) (frameAt θ' ξ a')))) = thA (fun θ => (inner ℝ (curl3 F₀ (rotPt ξ.1 θ ξ.2.1) + b (rotPt ξ.1 θ ξ.2.1)) (frameAt θ ξ a) - thA (fun θ' => inner ℝ (curl3 F₀ (rotPt ξ.1 θ' ξ.2.1) + b (rotPt ξ.1 θ' ξ.2.1)) (frameAt θ' ξ a))) * (inner ℝ (curl3 F₀ (rotPt ξ.1 θ ξ.2.1) + b (rotPt ξ.1 θ ξ.2.1)) (frameAt θ ξ a') - thA (fun θ' => inner ℝ (curl3 F₀ (rotPt ξ.1 θ' ξ.2.1) + b (rotPt ξ.1 θ' ξ.2.1)) (frameAt θ' ξ a'))))) :=
by
  intro F₀ D b φ U ξ ψ hU hr hcirc hF₀ hb hφ hD
  obtain ⟨r, z, t, Y⟩ := ξ
  dsimp only at hr hcirc hφ ⊢
  have hr0 : r ≠ 0 := hr.ne'

  have hcoord : ∀ (i : Fin 3) (y : ℝ³), DifferentiableAt ℝ (fun w : ℝ³ => w i) y := by
    intro i y
    have h0 : DifferentiableAt ℝ (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) i) y :=
      ContinuousLinearMap.differentiableAt _
    rwa [EuclideanSpace.coe_proj] at h0
  have hc0 : ∀ ρ θ ζ : ℝ, rotPt ρ θ ζ 0 = ρ * Real.cos θ := by intro ρ θ ζ; simp [rotPt]
  have hc1 : ∀ ρ θ ζ : ℝ, rotPt ρ θ ζ 1 = ρ * Real.sin θ := by intro ρ θ ζ; simp [rotPt]
  have hc2 : ∀ ρ θ ζ : ℝ, rotPt ρ θ ζ 2 = ζ := by intro ρ θ ζ; simp [rotPt]
  have hsq : ∀ ρ θ : ℝ, (ρ * Real.cos θ) ^ 2 + (ρ * Real.sin θ) ^ 2 = ρ ^ 2 := by
    intro ρ θ; linear_combination ρ ^ 2 * Real.cos_sq_add_sin_sq θ
  have hradG : ∀ ρ θ ζ : ℝ, 0 < ρ → rad (rotPt ρ θ ζ) = ρ := by
    intro ρ θ ζ hρ
    show Real.sqrt ((rotPt ρ θ ζ) 0 ^ 2 + (rotPt ρ θ ζ) 1 ^ 2) = ρ
    rw [hc0, hc1, hsq, Real.sqrt_sq hρ.le]
  have heR : ∀ θ : ℝ, eR (rotPt r θ z) = Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
      Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) := by
    intro θ
    rw [eR, hradG r θ z hr, radVec, hc0, hc1, smul_add, smul_smul, smul_smul,
      inv_mul_cancel_left₀ hr0, inv_mul_cancel_left₀ hr0]
  have heTh : ∀ θ : ℝ, eTh (rotPt r θ z) = (-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
      Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) := by
    intro θ
    rw [eTh, hradG r θ z hr, azVec, hc0, hc1, smul_add, smul_smul, smul_smul, mul_neg,
      inv_mul_cancel_left₀ hr0, inv_mul_cancel_left₀ hr0]

  have hinF : ∀ (θ c0 c1 c2 : ℝ) (a : Fin 3),
      inner ℝ (c0 • eR (rotPt r θ z) + c1 • eTh (rotPt r θ z) + c2 • eZ) (frameAt θ (r, z, t, Y) a) =
        ![c0, c1, c2] a := by
    intro θ c0 c1 c2 a
    have hf : frameAt θ (r, z, t, Y) = ![eR (rotPt r θ z), eTh (rotPt r θ z), eZ] := rfl
    rw [hf, heR, heTh]
    obtain rfl | rfl | rfl : a = 0 ∨ a = 1 ∨ a = 2 := by fin_cases a <;> simp
    · simp [eZ, inner_add_left, inner_add_right, real_inner_smul_left, real_inner_smul_right,
        EuclideanSpace.inner_single_left]
      linear_combination c0 * Real.cos_sq_add_sin_sq θ
    · simp [eZ, inner_add_left, inner_add_right, real_inner_smul_left, real_inner_smul_right,
        EuclideanSpace.inner_single_left]
      linear_combination c1 * Real.cos_sq_add_sin_sq θ
    · simp [eZ, inner_add_left, inner_add_right, real_inner_smul_left, real_inner_smul_right,
        EuclideanSpace.inner_single_left]

  set L : ℝ³ →L[ℝ] ℝ³ :=
    (-(EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ)).smulRight (EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) +
    (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).smulRight (EuclideanSpace.single (1 : Fin 3) (1 : ℝ))
    with hLdef
  have hL : (⇑L : ℝ³ → ℝ³) = azVec := by
    funext y
    simp only [hLdef, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
      ContinuousLinearMap.neg_apply]
    unfold azVec
    simp
  have hLv : ∀ v : ℝ³, L v = azVec v := fun v => by rw [hL]

  have hpt : ∀ (θ : ℝ) (a : Fin 3),
      inner ℝ (curl3 (fun y => F₀ y + D y) (rotPt r θ z) + (b (rotPt r θ z) + ψ • eTh (rotPt r θ z)))
        (frameAt θ (r, z, t, Y) a) =
      inner ℝ (curl3 F₀ (rotPt r θ z) + b (rotPt r θ z)) (frameAt θ (r, z, t, Y) a) +
        ![-(fderiv ℝ φ (r, z) (0, 1)), ψ, fderiv ℝ φ (r, z) (1, 0) + φ (r, z) / r] a := by
    intro θ a
    have hxU : rotPt r θ z ∈ U := hcirc θ
    have hUx : U ∈ nhds (rotPt r θ z) := hU.mem_nhds hxU
    have hF0d : DifferentiableAt ℝ F₀ (rotPt r θ z) :=
      (hF₀.differentiableOn one_ne_zero).differentiableAt hUx
    obtain ⟨g, hgdef⟩ : ∃ g : ℝ³ → ℝ, g = fun y => φ (rad y, y 2) * (rad y)⁻¹ := ⟨_, rfl⟩
    have hsum : 0 < rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2 := by
      rw [hc0, hc1, hsq]; positivity
    have hradD : DifferentiableAt ℝ rad (rotPt r θ z) :=
      (((hcoord 0 _).pow 2).add ((hcoord 1 _).pow 2)).sqrt hsum.ne'
    have hrx : rad (rotPt r θ z) = r := hradG r θ z hr
    have hφ' : DifferentiableAt ℝ φ (rad (rotPt r θ z), rotPt r θ z 2) := by
      rw [hrx, hc2]; exact hφ
    have hgd : DifferentiableAt ℝ g (rotPt r θ z) := by
      rw [hgdef]
      exact (DifferentiableAt.comp (f := fun y : ℝ³ => (rad y, y 2)) (rotPt r θ z) hφ'
        (hradD.prodMk (hcoord 2 _))).mul (hradD.inv (by rw [hrx]; exact hr0))
    obtain ⟨G, hG⟩ : ∃ G : ℝ³ →L[ℝ] ℝ, HasFDerivAt g G (rotPt r θ z) := ⟨_, hgd.hasFDerivAt⟩
    have hAz : HasFDerivAt azVec L (rotPt r θ z) := by rw [← hL]; exact L.hasFDerivAt
    have hev : D =ᶠ[nhds (rotPt r θ z)] fun y => g y • azVec y := by
      filter_upwards [hUx] with y hy
      rw [hD y hy, hgdef, eTh, smul_smul]
    have hDfd : HasFDerivAt D (g (rotPt r θ z) • L + G.smulRight (azVec (rotPt r θ z))) (rotPt r θ z) :=
      (hG.smul hAz).congr_of_eventuallyEq hev

    have hmZ : HasDerivAt (fun ζ : ℝ => rotPt r θ ζ) (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³) z := by
      unfold rotPt
      exact ((hasDerivAt_const z ((r * Real.cos θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        (r * Real.sin θ) • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))).add
        ((hasDerivAt_id' z).smul_const (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³))).congr_deriv
        (by rw [zero_add, one_smul])
    have hv1 : HasDerivAt (fun ζ : ℝ => g (rotPt r θ ζ)) (G (EuclideanSpace.single (2 : Fin 3) (1 : ℝ))) z :=
      hG.comp_hasDerivAt z hmZ
    have hv2 : HasDerivAt (fun ζ : ℝ => φ (r, ζ) * r⁻¹) (fderiv ℝ φ (r, z) (0, 1) * r⁻¹) z := by
      have h := (hφ.hasFDerivAt.comp_hasDerivAt z ((hasDerivAt_const z r).prodMk (hasDerivAt_id' z))).mul_const r⁻¹
      exact h
    have hv3 : HasDerivAt (fun ζ : ℝ => g (rotPt r θ ζ)) (fderiv ℝ φ (r, z) (0, 1) * r⁻¹) z := by
      refine hv2.congr_of_eventuallyEq (Filter.Eventually.of_forall fun ζ => ?_)
      simp only [hgdef, hradG r θ ζ hr, hc2]
    have hGz := hv1.unique hv3
    have hGz2 : r * G (EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) = fderiv ℝ φ (r, z) (0, 1) := by
      rw [hGz]; field_simp

    have hmR : HasDerivAt (fun ρ : ℝ => rotPt ρ θ z)
        (Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)) r := by
      unfold rotPt
      exact ((((hasDerivAt_mul_const (Real.cos θ)).smul_const
        (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³)).add
        ((hasDerivAt_mul_const (Real.sin θ)).smul_const
        (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))).add
        (hasDerivAt_const r (z • (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³)))).congr_deriv
        (add_zero _)
    have hr1 : HasDerivAt (fun ρ : ℝ => g (rotPt ρ θ z))
        (G (Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))) r :=
      hG.comp_hasDerivAt r hmR
    have hr2 : HasDerivAt (fun ρ : ℝ => φ (ρ, z) * ρ⁻¹)
        (fderiv ℝ φ (r, z) (1, 0) * r⁻¹ + φ (r, z) * (-(r ^ 2)⁻¹)) r := by
      have h1 : HasDerivAt (fun ρ : ℝ => φ (ρ, z)) (fderiv ℝ φ (r, z) (1, 0)) r := by
        have h := hφ.hasFDerivAt.comp_hasDerivAt r ((hasDerivAt_id' r).prodMk (hasDerivAt_const r z))
        exact h
      exact h1.mul (hasDerivAt_inv hr0)
    have hr3 : HasDerivAt (fun ρ : ℝ => g (rotPt ρ θ z))
        (fderiv ℝ φ (r, z) (1, 0) * r⁻¹ + φ (r, z) * (-(r ^ 2)⁻¹)) r := by
      refine hr2.congr_of_eventuallyEq ?_
      filter_upwards [Ioi_mem_nhds hr] with ρ hρ
      simp only [hgdef, hradG ρ θ z hρ, hc2]
    have hGr := hr1.unique hr3
    rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul] at hGr
    have hGr2 : r * (Real.cos θ * G (EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) +
        Real.sin θ * G (EuclideanSpace.single (1 : Fin 3) (1 : ℝ))) =
        fderiv ℝ φ (r, z) (1, 0) - φ (r, z) / r := by
      rw [hGr]; field_simp; ring

    have hgx : g (rotPt r θ z) = φ (r, z) * r⁻¹ := by simp only [hgdef, hrx, hc2]
    have hcurlD : curl3 D (rotPt r θ z) = (-(fderiv ℝ φ (r, z) (0, 1))) • eR (rotPt r θ z) +
        (fderiv ℝ φ (r, z) (1, 0) + φ (r, z) / r) • eZ := by
      unfold curl3
      rw [hDfd.fderiv, heR θ, hgx]
      ext i
      fin_cases i
      · simp [eZ, hLv, azVec, hc0, hc1]
        linear_combination (Real.cos θ) * hGz2
      · simp [eZ, hLv, azVec, hc0, hc1]
        linear_combination (Real.sin θ) * hGz2
      · simp [eZ, hLv, azVec, hc0, hc1]
        linear_combination hGr2
    have hDd : DifferentiableAt ℝ D (rotPt r θ z) := hDfd.differentiableAt
    have hadd : curl3 (fun y => F₀ y + D y) (rotPt r θ z) = curl3 F₀ (rotPt r θ z) + curl3 D (rotPt r θ z) := by
      unfold curl3
      rw [fderiv_fun_add hF0d hDd]
      simp only [ContinuousLinearMap.add_apply, PiLp.add_apply]
      module
    rw [hadd, hcurlD]
    have e : curl3 F₀ (rotPt r θ z) + ((-(fderiv ℝ φ (r, z) (0, 1))) • eR (rotPt r θ z) +
        (fderiv ℝ φ (r, z) (1, 0) + φ (r, z) / r) • eZ) + (b (rotPt r θ z) + ψ • eTh (rotPt r θ z)) =
        (curl3 F₀ (rotPt r θ z) + b (rotPt r θ z)) + ((-(fderiv ℝ φ (r, z) (0, 1))) • eR (rotPt r θ z) +
          ψ • eTh (rotPt r θ z) + (fderiv ℝ φ (r, z) (1, 0) + φ (r, z) / r) • eZ) := by abel
    rw [e, inner_add_left (curl3 F₀ (rotPt r θ z) + b (rotPt r θ z)), hinF]

  let Φ : (ℝ³ →L[ℝ] ℝ³) →ₗ[ℝ] ℝ³ :=
    { toFun := fun L =>
        (L (EuclideanSpace.single 1 1) 2 - L (EuclideanSpace.single 2 1) 1) •
            EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
          (L (EuclideanSpace.single 2 1) 0 - L (EuclideanSpace.single 0 1) 2) •
            EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
          (L (EuclideanSpace.single 0 1) 1 - L (EuclideanSpace.single 1 1) 0) •
            EuclideanSpace.single (2 : Fin 3) (1 : ℝ)
      map_add' := by
        intro L M
        simp only [ContinuousLinearMap.add_apply, PiLp.add_apply]
        module
      map_smul' := by
        intro c L
        simp only [ContinuousLinearMap.smul_apply, PiLp.smul_apply, smul_eq_mul, RingHom.id_apply]
        module }
  have hγ : Continuous fun θ : ℝ => rotPt r θ z := by unfold rotPt; fun_prop
  have hfdC : Continuous fun θ : ℝ => fderiv ℝ F₀ (rotPt r θ z) := by
    have h := (hF₀.continuousOn_fderiv_of_isOpen hU le_rfl).comp_continuous hγ hcirc
    exact h
  have hcurlC : Continuous fun θ : ℝ => curl3 F₀ (rotPt r θ z) := by
    have e : (fun θ : ℝ => curl3 F₀ (rotPt r θ z)) = fun θ => Φ (fderiv ℝ F₀ (rotPt r θ z)) := rfl
    rw [e]
    exact (LinearMap.continuous_of_finiteDimensional Φ).comp hfdC
  have hbC : Continuous fun θ : ℝ => b (rotPt r θ z) := by
    have h := hb.comp_continuous hγ hcirc
    exact h
  have hfrC : ∀ a : Fin 3, Continuous fun θ => frameAt θ (r, z, t, Y) a := by
    intro a
    obtain rfl | rfl | rfl : a = 0 ∨ a = 1 ∨ a = 2 := by fin_cases a <;> simp
    · have e : (fun θ => frameAt θ (r, z, t, Y) 0) = fun θ =>
          Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
            Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) := funext fun θ => heR θ
      rw [e]; fun_prop
    · have e : (fun θ => frameAt θ (r, z, t, Y) 1) = fun θ =>
          (-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
            Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) := funext fun θ => heTh θ
      rw [e]; fun_prop
    · have e : (fun θ => frameAt θ (r, z, t, Y) 2) = fun _ => eZ := rfl
      rw [e]; exact continuous_const
  have hcont : ∀ a : Fin 3, Continuous fun θ =>
      inner ℝ (curl3 F₀ (rotPt r θ z) + b (rotPt r θ z)) (frameAt θ (r, z, t, Y) a) :=
    fun a => (hcurlC.add hbC).inner (hfrC a)

  have hshift : ∀ (f : ℝ → ℝ) (c : ℝ), Continuous f → thA (fun θ => f θ + c) = thA f + c := by
    intro f c hf
    simp only [thA]
    have hπ : (2 * Real.pi) ≠ 0 := by positivity
    rw [intervalIntegral.integral_add (hf.intervalIntegrable _ _) (continuous_const.intervalIntegrable _ _),
      intervalIntegral.integral_const, smul_eq_mul, sub_zero, mul_add, inv_mul_cancel_left₀ hπ]
  refine ⟨fun a => ?_, fun a a' => ?_⟩
  · simp only [hpt]
    exact hshift _ _ (hcont a)
  · simp only [hpt]
    rw [hshift _ _ (hcont a), hshift _ _ (hcont a')]
    congr 1
    funext θ
    ring

theorem mmu_bx_continuous_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (β t : ℝ) (Y : ℝ × ℝ), B.ok → qsOf l0 ≤ B.qB → InM B (qsOf l0) β S.bdir → ContinuousOn (fun y : ℝ³ => BX B G l0 S y t Y) {y : ℝ³ | 0 < rad y ∧ t < 1 ∧ simScale B.h (y 2) (1 - t) < qsOf l0} :=
by
  intro B G l0 S β t Y hok hqB hbdir
  have hS := hok.1
  have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun x : ℝ³ => x i) := fun i => contDiff_piLp_apply 2
  have hf : ContDiff ℝ ∞ (fun x : ℝ³ => x 0 ^ 2 + x 1 ^ 2) := ((hc 0).pow 2).add ((hc 1).pow 2)
  have hradS : ContDiffOn ℝ ∞ rad {x : ℝ³ | 0 < rad x} := by
    have h := hf.contDiffOn.sqrt (s := {x : ℝ³ | 0 < rad x}) (fun x hx => by
      have hx' : 0 < Real.sqrt (x 0 ^ 2 + x 1 ^ 2) := hx
      exact (Real.sqrt_pos.mp hx').ne')
    exact h
  have hinv : ContDiffOn ℝ ∞ (fun x => (rad x)⁻¹) {x : ℝ³ | 0 < rad x} :=
    hradS.inv (fun x hx => ne_of_gt hx)
  have haz : ContDiff ℝ ∞ azVec := by
    have h : ContDiff ℝ ∞ (fun x : ℝ³ => -(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) :=
      ((hc 1).neg.smul contDiff_const).add ((hc 0).smul contDiff_const)
    exact h
  have heTh : ContDiffOn ℝ ∞ eTh {x : ℝ³ | 0 < rad x} := hinv.smul haz.contDiffOn
  set U : Set ℝ³ := {y : ℝ³ | 0 < rad y ∧ t < 1 ∧ simScale B.h (y 2) (1 - t) < qsOf l0} with hU
  have heThU : ContDiffOn ℝ ∞ eTh U := heTh.mono (fun y hy => hy.1)
  have hradU : ContDiffOn ℝ ∞ rad U := hradS.mono (fun y hy => hy.1)
  have hπ : ContDiffOn ℝ ∞ (fun y : ℝ³ => ((rad y, y 2, t, Y) : Cyl)) U :=
    hradU.prodMk ((hc 2).contDiffOn.prodMk contDiffOn_const)
  have hmapsD : MapsTo (fun y : ℝ³ => ((rad y, y 2, t, Y) : Cyl)) U (DomC B.h (qsOf l0)) :=
    fun y hy => hy
  have hBXeq : ∀ y ∈ U, BX B G l0 S y t Y =
      B.BvB y t + (qC B.h ((rad y, y 2, t, Y) : Cyl) ^ (-Aex B.h) *
        S.bdir ((rad y, y 2, t, Y) : Cyl)) • eTh y := by
    intro y hy
    have hw : corrOn B l0 y t := hy
    simp only [BX, if_pos hw, ptOf]
  have hBP := hok.2
  unfold BackgroundProps at hBP
  obtain ⟨-, -, -, ⟨-, hBv0, -⟩, -⟩ := hBP
  have hBvc : ContDiffOn ℝ ∞ (fun y : ℝ³ => B.BvB y t) U := by
    have hg : ContDiff ℝ ∞ (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) := contDiff_id.prodMk contDiff_const
    refine hBv0.comp hg.contDiffOn (fun y hy => ?_)
    show t < 1 ∧ simScale B.h (y 2) (1 - t) < B.qB
    exact ⟨hy.2.1, lt_of_lt_of_le hy.2.2 hqB⟩
  have hqC : ContDiffOn ℝ ∞ (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have hπq : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
      contDiff_snd.fst.prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact hS.2.2.2.1.comp hπq.contDiffOn (fun ξ (hξ : ξ.2.2.1 < 1) =>
      (⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩ : (ξ.2.1, 1 - ξ.2.2.1) ∈ univ ×ˢ Ioi (0:ℝ)))
  have hq1 : ContDiffOn ℝ ∞ (fun y : ℝ³ => qC B.h ((rad y, y 2, t, Y) : Cyl)) U :=
    hqC.comp hπ (fun y hy => hy.2.1)
  have hq2 : ContDiffOn ℝ ∞ (fun y : ℝ³ => qC B.h ((rad y, y 2, t, Y) : Cyl) ^ (-Aex B.h)) U :=
    hq1.rpow_const_of_ne (fun y hy => by
      have ht : t < 1 := hy.2.1
      exact (hS.1 (y 2) (1 - t) (by linarith)).1.ne')
  have hbd : ContDiffOn ℝ ∞ (fun y : ℝ³ => S.bdir ((rad y, y 2, t, Y) : Cyl)) U :=
    hbdir.1.comp hπ hmapsD
  have hE := hBvc.add ((hq2.mul hbd).smul heThU)
  refine hE.continuousOn.congr (fun y hy => ?_)
  rw [hBXeq y hy]
  rfl

theorem temp_mean_update_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (S : CState) (bw ca cm cd α : ℝ) (P d : Cyl → ℝ), StOrd5 B G l0 S bw ca cm cd →
    InM B (qsOf l0) α (nrm B (Aex B.h - 1/2) P) → InM B (qsOf l0) α (nrm B (Aex B.h) d) →
    ∀ ξ ∈ DomC B.h (qsOf l0),
      mcor5 B G l0 (tempUpd5 B S P d) 1 ξ = mcor5 B G l0 S 1 ξ + d ξ ∧
      mcor5 B G l0 (tempUpd5 B S P d) 2 ξ = mcor5 B G l0 S 2 ξ + (dR B.h P ξ + P ξ / ξ.1) ∧
      mcor5 B G l0 (tempUpd5 B S P d) 0 ξ = mcor5 B G l0 S 0 ξ - dZ P ξ ∧
      ∀ a b : Fin 3, Wcov5 B G l0 (tempUpd5 B S P d) a b ξ = Wcov5 B G l0 S a b ξ :=
by
  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, ?_⟩
  intro l0 hl0 S bw ca cm cd α P d hSt hP hd ξ hξ

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  unfold StOrd5 at hSt
  obtain ⟨hAw, -, hPsi, hbd, -⟩ := hSt
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ

  have hT : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
  have hπq : ContDiff ℝ ∞ (fun η : Cyl => (η.2.1, 1 - η.2.2.1)) :=
    contDiff_snd.fst.prodMk (contDiff_const.sub contDiff_snd.snd.fst)
  have hqC : ContDiffOn ℝ ∞ (qC B.h) {η : Cyl | η.2.2.1 < 1} := by
    have h4 := hok.1.2.2.2.1
    have hc := h4.comp hπq.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      (⟨mem_univ _, show (0:ℝ) < 1 - η.2.2.1 by linarith⟩ : (η.2.1, 1 - η.2.2.1) ∈ univ ×ˢ Ioi (0:ℝ)))
    exact hc
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have h1 : IsOpen {η : Cyl | 0 < η.1} := isOpen_lt continuous_const continuous_fst
    have h2 := hqC.continuousOn.isOpen_inter_preimage hT (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        {η : Cyl | 0 < η.1} ∩ ({η : Cyl | η.2.2.1 < 1} ∩ qC B.h ⁻¹' Iio (qsOf l0)) := by
      ext η; exact Iff.rfl
    rw [e]; exact h1.inter h2
  have hqpos : ∀ η ∈ DomC B.h (qsOf l0), 0 < qC B.h η := by
    intro η hη
    have hη' : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < qsOf l0 := hη
    exact (hok.1.1 η.2.1 (1 - η.2.2.1) (by linarith [hη'.2.1])).1
  have hqCD : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h (qsOf l0)) :=
    hqC.mono (fun η (hη : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < qsOf l0) => hη.2.1)

  have hPs : ContDiffOn ℝ ∞ P (DomC B.h (qsOf l0)) := by
    have hneg : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-(Aex B.h - 1/2))) (DomC B.h (qsOf l0)) :=
      hqCD.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
    refine (hneg.mul hP.1).congr (fun η hη => ?_)
    have hp := hqpos η hη
    simp only [nrm]
    rw [← mul_assoc, ← Real.rpow_add hp, neg_add_cancel, Real.rpow_zero, one_mul]
  have hPd : DifferentiableAt ℝ P ξ :=
    (hPs.differentiableOn (by simp)).differentiableAt (hDopen.mem_nhds hξ)

  have hrot : ∀ θ : ℝ, rad (rotPt ξ.1 θ ξ.2.1) = ξ.1 ∧ (rotPt ξ.1 θ ξ.2.1) 2 = ξ.2.1 := by
    intro θ
    have h0 : (rotPt ξ.1 θ ξ.2.1) 0 = ξ.1 * Real.cos θ := by simp [rotPt, EuclideanSpace.single_apply]
    have h1 : (rotPt ξ.1 θ ξ.2.1) 1 = ξ.1 * Real.sin θ := by simp [rotPt, EuclideanSpace.single_apply]
    have h2 : (rotPt ξ.1 θ ξ.2.1) 2 = ξ.2.1 := by simp [rotPt, EuclideanSpace.single_apply]
    refine ⟨?_, h2⟩
    rw [rad, h0, h1, mul_pow, mul_pow, ← mul_add, Real.cos_sq_add_sin_sq, mul_one,
      Real.sqrt_sq hξ'.1.le]
  have hcorr : ∀ θ : ℝ, corrOn B l0 (rotPt ξ.1 θ ξ.2.1) ξ.2.2.1 := by
    intro θ
    show 0 < rad (rotPt ξ.1 θ ξ.2.1) ∧ ξ.2.2.1 < 1 ∧
      simScale B.h ((rotPt ξ.1 θ ξ.2.1) 2) (1 - ξ.2.2.1) < qsOf l0
    rw [(hrot θ).1, (hrot θ).2]
    exact hξ'
  have hpt : ∀ θ : ℝ, ptOf (rotPt ξ.1 θ ξ.2.1) ξ.2.2.1 ξ.2.2.2 = ξ := by
    intro θ
    show (rad (rotPt ξ.1 θ ξ.2.1), (rotPt ξ.1 θ ξ.2.1) 2, ξ.2.2.1, ξ.2.2.2) = ξ
    rw [(hrot θ).1, (hrot θ).2]

  obtain ⟨ι, hιdef⟩ : ∃ ι : ℝ × ℝ → Cyl,
      ι = fun p => (p.1, p.2, ξ.2.2.1, Yph B.h p.1 ξ.2.2.1 + (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1)) := ⟨_, rfl⟩
  have hιξ : ι (ξ.1, ξ.2.1) = ξ := by
    rw [hιdef]
    show ((ξ.1, ξ.2.1, ξ.2.2.1, Yph B.h ξ.1 ξ.2.2.1 + (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1)) : Cyl) = ξ
    rw [add_sub_cancel]
  have hpow : HasDerivAt (fun ρ : ℝ => ρ ^ drx B.h) (drx B.h * ξ.1 ^ (drx B.h - 1)) ξ.1 :=
    Real.hasDerivAt_rpow_const (Or.inl hξ'.1.ne')
  have h4 : HasDerivAt (fun ρ : ℝ => Yph B.h ρ ξ.2.2.1 + (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1))
      ((drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) ξ.1 :=
    ((hpow.smul_const vrv).add_const (ξ.2.2.1 • vtv)).add_const _
  have hι : HasFDerivAt ι ((ContinuousLinearMap.fst ℝ ℝ ℝ).prod ((ContinuousLinearMap.snd ℝ ℝ ℝ).prod
      ((0 : ℝ × ℝ →L[ℝ] ℝ).prod (((1 : ℝ →L[ℝ] ℝ).smulRight ((drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)).comp
        (ContinuousLinearMap.fst ℝ ℝ ℝ))))) (ξ.1, ξ.2.1) := by
    rw [hιdef]
    have h4' : HasFDerivAt (fun p : ℝ × ℝ => Yph B.h p.1 ξ.2.2.1 + (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1))
        (((1 : ℝ →L[ℝ] ℝ).smulRight ((drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)).comp
          (ContinuousLinearMap.fst ℝ ℝ ℝ)) (ξ.1, ξ.2.1) :=
      HasFDerivAt.comp (g := fun ρ : ℝ => Yph B.h ρ ξ.2.2.1 + (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1))
        (f := (Prod.fst : ℝ × ℝ → ℝ)) (ξ.1, ξ.2.1) h4.hasFDerivAt hasFDerivAt_fst
    exact hasFDerivAt_fst.prodMk (hasFDerivAt_snd.prodMk ((hasFDerivAt_const _ _).prodMk h4'))
  have hPξ : HasFDerivAt P (fderiv ℝ P ξ) (ι (ξ.1, ξ.2.1)) := by
    rw [hιξ]; exact hPd.hasFDerivAt
  have hφ := hPξ.comp (ξ.1, ξ.2.1) hι
  have hφd : DifferentiableAt ℝ (P ∘ ι) (ξ.1, ξ.2.1) := hφ.differentiableAt
  have hR : fderiv ℝ (P ∘ ι) (ξ.1, ξ.2.1) (1, 0) = dR B.h P ξ := by
    rw [hφ.fderiv]; simp [dR]
  have hZ : fderiv ℝ (P ∘ ι) (ξ.1, ξ.2.1) (0, 1) = dZ P ξ := by
    rw [hφ.fderiv]; simp [dZ]
  have hφ0 : (P ∘ ι) (ξ.1, ξ.2.1) = P ξ := by
    rw [Function.comp_apply, hιξ]

  obtain ⟨hUo, hF⟩ := mmu_axoff_smooth_v5 B G l0 S 1 (1/2) ξ.2.2.1 (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1)
    hok hG hqB hAw hPsi
  obtain ⟨F0, hF0⟩ : ∃ F0 : ℝ³ → ℝ³,
      F0 = fun y => AX5 B G l0 S y ξ.2.2.1 (Yph B.h (rad y) ξ.2.2.1 + (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1)) :=
    ⟨_, rfl⟩
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ³ → ℝ³, D = fun y =>
      AX5 B G l0 (tempUpd5 B S P d) y ξ.2.2.1 (Yph B.h (rad y) ξ.2.2.1 + (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1))
        - F0 y := ⟨_, rfl⟩
  obtain ⟨bf, hbf⟩ : ∃ bf : ℝ³ → ℝ³, bf = fun y => BX B G l0 S y ξ.2.2.1 ξ.2.2.2 := ⟨_, rfl⟩
  have hF1 : ContDiffOn ℝ 1 F0
      {y : ℝ³ | 0 < rad y ∧ ξ.2.2.1 < 1 ∧ simScale B.h (y 2) (1 - ξ.2.2.1) < qsOf l0} := by
    rw [hF0]; exact hF.of_le (by exact_mod_cast le_top)
  have hbs : ContinuousOn bf
      {y : ℝ³ | 0 < rad y ∧ ξ.2.2.1 < 1 ∧ simScale B.h (y 2) (1 - ξ.2.2.1) < qsOf l0} := by
    rw [hbf]; exact mmu_bx_continuous_v5 B G l0 S (1/2) ξ.2.2.1 ξ.2.2.2 hok hqB hbd

  have hFD : (fun y => F0 y + D y) = fun y =>
      AX5 B G l0 (tempUpd5 B S P d) y ξ.2.2.1 (Yph B.h (rad y) ξ.2.2.1 + (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1)) := by
    funext y; rw [hDdef]; exact add_sub_cancel (F0 y) _
  have hDφ : ∀ y ∈ {y : ℝ³ | 0 < rad y ∧ ξ.2.2.1 < 1 ∧ simScale B.h (y 2) (1 - ξ.2.2.1) < qsOf l0},
      D y = (P ∘ ι) (rad y, y 2) • eTh y := by
    intro y hy
    have hc : corrOn B l0 y ξ.2.2.1 := hy
    have hc' : 0 < rad y ∧ ξ.2.2.1 < 1 ∧ simScale B.h (y 2) (1 - ξ.2.2.1) < qsOf l0 := hy
    have hq : 0 < qC B.h (ptOf y ξ.2.2.1 (Yph B.h (rad y) ξ.2.2.1 + (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1))) :=
      (hok.1.1 (y 2) (1 - ξ.2.2.1) (by linarith [hc'.2.1])).1
    have hcan : qC B.h (ptOf y ξ.2.2.1 (Yph B.h (rad y) ξ.2.2.1 + (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1)))
          ^ (1/2 - Aex B.h) *
        nrm B (Aex B.h - 1/2) P (ptOf y ξ.2.2.1 (Yph B.h (rad y) ξ.2.2.1 + (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1)))
        = (P ∘ ι) (rad y, y 2) := by
      simp only [nrm]
      rw [← mul_assoc, ← Real.rpow_add hq, show (1/2 - Aex B.h + (Aex B.h - 1/2) : ℝ) = 0 by ring,
        Real.rpow_zero, one_mul, hιdef]
      rfl
    rw [← hcan, hDdef, hF0]
    simp only [AX5, if_pos hc, tempUpd5]
    simp only [add_smul, smul_add, smul_smul]
    abel
  have hcan2 : qC B.h ξ ^ (-Aex B.h) * nrm B (Aex B.h) d ξ = d ξ := by
    simp only [nrm]
    rw [← mul_assoc, ← Real.rpow_add (hqpos ξ hξ), neg_add_cancel, Real.rpow_zero, one_mul]
  have hBX : ∀ θ : ℝ, BX B G l0 (tempUpd5 B S P d) (rotPt ξ.1 θ ξ.2.1) ξ.2.2.1 ξ.2.2.2 =
      BX B G l0 S (rotPt ξ.1 θ ξ.2.1) ξ.2.2.1 ξ.2.2.2 + d ξ • eTh (rotPt ξ.1 θ ξ.2.1) := by
    intro θ
    simp only [BX, if_pos (hcorr θ), hpt θ, tempUpd5]
    rw [mul_add, add_smul, hcan2]
    abel

  have h7a : ∀ (θ : ℝ) (a : Fin 3), ucyl5 B G l0 S θ ξ a =
      inner ℝ (curl3 F0 (rotPt ξ.1 θ ξ.2.1) + bf (rotPt ξ.1 θ ξ.2.1)) (frameAt θ ξ a) := by
    intro θ a
    rw [hF0, hbf]
    simp only [ucyl5, uX5, curlX, evOff, (hrot θ).1]
  have h7b : ∀ (θ : ℝ) (a : Fin 3), ucyl5 B G l0 (tempUpd5 B S P d) θ ξ a =
      inner ℝ (curl3 (fun y => F0 y + D y) (rotPt ξ.1 θ ξ.2.1) +
        (bf (rotPt ξ.1 θ ξ.2.1) + d ξ • eTh (rotPt ξ.1 θ ξ.2.1))) (frameAt θ ξ a) := by
    intro θ a
    rw [hFD]
    simp only [hbf]
    rw [← hBX θ]
    simp only [ucyl5, uX5, curlX, evOff, (hrot θ).1]

  obtain ⟨hmean, hcov⟩ := mmu_circle_avg_shift F0 D bf (P ∘ ι)
    {y : ℝ³ | 0 < rad y ∧ ξ.2.2.1 < 1 ∧ simScale B.h (y 2) (1 - ξ.2.2.1) < qsOf l0} ξ (d ξ)
    hUo hξ'.1 hcorr hF1 hbs hφd hDφ
  have hM : ∀ a : Fin 3, mcor5 B G l0 (tempUpd5 B S P d) a ξ = mcor5 B G l0 S a ξ +
      ![-(fderiv ℝ (P ∘ ι) (ξ.1, ξ.2.1) (0, 1)), d ξ,
        fderiv ℝ (P ∘ ι) (ξ.1, ξ.2.1) (1, 0) + (P ∘ ι) (ξ.1, ξ.2.1) / ξ.1] a := by
    intro a
    have e1 : (fun θ => ucyl5 B G l0 (tempUpd5 B S P d) θ ξ a) = fun θ =>
        inner ℝ (curl3 (fun y => F0 y + D y) (rotPt ξ.1 θ ξ.2.1) +
          (bf (rotPt ξ.1 θ ξ.2.1) + d ξ • eTh (rotPt ξ.1 θ ξ.2.1))) (frameAt θ ξ a) :=
      funext fun θ => h7b θ a
    have e2 : (fun θ => ucyl5 B G l0 S θ ξ a) = fun θ =>
        inner ℝ (curl3 F0 (rotPt ξ.1 θ ξ.2.1) + bf (rotPt ξ.1 θ ξ.2.1)) (frameAt θ ξ a) :=
      funext fun θ => h7a θ a
    unfold mcor5
    rw [e1, e2, hmean a]
    ring
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact (hM 1).trans rfl
  · rw [hM 2]
    show mcor5 B G l0 S 2 ξ + (fderiv ℝ (P ∘ ι) (ξ.1, ξ.2.1) (1, 0) + (P ∘ ι) (ξ.1, ξ.2.1) / ξ.1) = _
    rw [hR, hφ0]
  · rw [hM 0]
    show mcor5 B G l0 S 0 ξ + -(fderiv ℝ (P ∘ ι) (ξ.1, ξ.2.1) (0, 1)) = _
    rw [hZ, sub_eq_add_neg]
  · intro a b
    simp only [Wcov5, h7a, h7b]
    exact hcov a b

theorem mom_flux_update_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (dPsi dv : Cyl → ℝ), IsOpen (DomC B.h (qsOf l0)) → (∀ f : Cyl → ℝ, ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) → ContDiffOn ℝ ∞ (dR B.h f) (DomC B.h (qsOf l0)) ∧ ContDiffOn ℝ ∞ (dZ f) (DomC B.h (qsOf l0)) ∧ ContDiffOn ℝ ∞ (dT f) (DomC B.h (qsOf l0))) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 S a) (DomC B.h (qsOf l0))) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (fun ξ => ubase B ξ a) (DomC B.h (qsOf l0))) → (∀ a c : Fin 3, ContDiffOn ℝ ∞ (Wcov5 B G l0 S a c) (DomC B.h (qsOf l0))) → ContDiffOn ℝ ∞ (momDbP B dPsi) (DomC B.h (qsOf l0)) → ContDiffOn ℝ ∞ (momDgP B dPsi) (DomC B.h (qsOf l0)) → ContDiffOn ℝ ∞ (momDvP B dv) (DomC B.h (qsOf l0)) → MomMeanId5 B G l0 S dPsi dv → ∀ ξ ∈ DomC B.h (qsOf l0), grP5 B G l0 (momUpd S dPsi dv) ξ = grP5 B G l0 S ξ + momDg5 B G l0 S dPsi dv ξ :=
by
  intro B G l0 S dPsi dv hDo hcl hmc hub hW hdb hdg hdw hmean ξ hξ
  have hdiff : ∀ φ : Cyl → ℝ, ContDiffOn ℝ ∞ φ (DomC B.h (qsOf l0)) →
      ∀ η ∈ DomC B.h (qsOf l0), DifferentiableAt ℝ φ η := by
    intro φ hφ η hη
    exact (hφ.differentiableOn (by simp)).differentiableAt (hDo.mem_nhds hη)
  have split : ∀ (f g k : Cyl → ℝ) (x w : Cyl), x ∈ DomC B.h (qsOf l0) →
      (∀ η ∈ DomC B.h (qsOf l0), f η = g η + k η) →
      DifferentiableAt ℝ g x → DifferentiableAt ℝ k x →
      fderiv ℝ f x w = fderiv ℝ g x w + fderiv ℝ k x w := by
    intro f g k x w hx hfgk hg hk
    have hev : f =ᶠ[nhds x] fun η => g η + k η :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hx) hfgk
    rw [hev.fderiv_eq]
    exact congrArg (fun L : Cyl →L[ℝ] ℝ => L w) ((hg.hasFDerivAt.add hk.hasFDerivAt).fderiv)
  have lapsplit : ∀ (f g k : Cyl → ℝ), ContDiffOn ℝ ∞ g (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ k (DomC B.h (qsOf l0)) →
      (∀ η ∈ DomC B.h (qsOf l0), f η = g η + k η) →
      lap0 B.h f ξ = lap0 B.h g ξ + lap0 B.h k ξ := by
    intro f g k hg hk hfgk
    have hR : ∀ η ∈ DomC B.h (qsOf l0), dR B.h f η = dR B.h g η + dR B.h k η := fun η hη =>
      split f g k η _ hη hfgk (hdiff g hg η hη) (hdiff k hk η hη)
    have hZ : ∀ η ∈ DomC B.h (qsOf l0), dZ f η = dZ g η + dZ k η := fun η hη =>
      split f g k η _ hη hfgk (hdiff g hg η hη) (hdiff k hk η hη)
    have hRR : dR B.h (dR B.h f) ξ = dR B.h (dR B.h g) ξ + dR B.h (dR B.h k) ξ :=
      split _ _ _ ξ _ hξ hR (hdiff _ (hcl g hg).1 ξ hξ) (hdiff _ (hcl k hk).1 ξ hξ)
    have hZZ : dZ (dZ f) ξ = dZ (dZ g) ξ + dZ (dZ k) ξ :=
      split _ _ _ ξ _ hξ hZ (hdiff _ (hcl g hg).2.1 ξ hξ) (hdiff _ (hcl k hk).2.1 ξ hξ)
    unfold lap0
    rw [hRR, hZZ, hR ξ hξ]
    ring
  have hT : dT (mcor5 B G l0 (momUpd S dPsi dv) 0) ξ =
      dT (mcor5 B G l0 S 0) ξ + dT (momDbP B dPsi) ξ :=
    split _ _ _ ξ _ hξ (fun η hη => (hmean η hη).1) (hdiff _ (hmc 0) ξ hξ) (hdiff _ hdb ξ hξ)
  have hR : dR B.h (fun η => 2 * ubase B η 0 * mcor5 B G l0 (momUpd S dPsi dv) 0 η +
        mcor5 B G l0 (momUpd S dPsi dv) 0 η ^ 2 + Wcov5 B G l0 (momUpd S dPsi dv) 0 0 η) ξ =
      dR B.h (fun η => 2 * ubase B η 0 * mcor5 B G l0 S 0 η + mcor5 B G l0 S 0 η ^ 2 +
        Wcov5 B G l0 S 0 0 η) ξ +
      dR B.h (fun η => 2 * ubase B η 0 * momDbP B dPsi η + 2 * mcor5 B G l0 S 0 η * momDbP B dPsi η +
        momDbP B dPsi η ^ 2) ξ := by
    refine split _ _ _ ξ _ hξ ?_ ?_ ?_
    · intro η hη
      obtain ⟨m0, -, -, mW⟩ := hmean η hη
      simp only [m0, mW]
      ring
    · apply hdiff _ _ ξ hξ
      exact (((contDiffOn_const.mul (hub 0)).mul (hmc 0)).add ((hmc 0).pow 2)).add (hW 0 0)
    · apply hdiff _ _ ξ hξ
      exact (((contDiffOn_const.mul (hub 0)).mul hdb).add
        ((contDiffOn_const.mul (hmc 0)).mul hdb)).add (hdb.pow 2)
  have hZ : dZ (fun η => ubase B η 0 * mcor5 B G l0 (momUpd S dPsi dv) 2 η +
        ubase B η 2 * mcor5 B G l0 (momUpd S dPsi dv) 0 η +
        mcor5 B G l0 (momUpd S dPsi dv) 0 η * mcor5 B G l0 (momUpd S dPsi dv) 2 η +
        Wcov5 B G l0 (momUpd S dPsi dv) 2 0 η) ξ =
      dZ (fun η => ubase B η 0 * mcor5 B G l0 S 2 η + ubase B η 2 * mcor5 B G l0 S 0 η +
        mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 2 0 η) ξ +
      dZ (fun η => ubase B η 0 * momDgP B dPsi η + ubase B η 2 * momDbP B dPsi η +
        mcor5 B G l0 S 0 η * momDgP B dPsi η + mcor5 B G l0 S 2 η * momDbP B dPsi η +
        momDbP B dPsi η * momDgP B dPsi η) ξ := by
    refine split _ _ _ ξ _ hξ ?_ ?_ ?_
    · intro η hη
      obtain ⟨m0, -, m2, mW⟩ := hmean η hη
      simp only [m0, m2, mW]
      ring
    · apply hdiff _ _ ξ hξ
      exact ((((hub 0).mul (hmc 2)).add ((hub 2).mul (hmc 0))).add ((hmc 0).mul (hmc 2))).add (hW 2 0)
    · apply hdiff _ _ ξ hξ
      exact (((((hub 0).mul hdg).add ((hub 2).mul hdb)).add ((hmc 0).mul hdg)).add
        ((hmc 2).mul hdb)).add (hdb.mul hdg)
  have hL : lap0 B.h (mcor5 B G l0 (momUpd S dPsi dv) 0) ξ =
      lap0 B.h (mcor5 B G l0 S 0) ξ + lap0 B.h (momDbP B dPsi) ξ :=
    lapsplit _ _ _ (hmc 0) hdb (fun η hη => (hmean η hη).1)
  obtain ⟨m0, m1, m2, mW⟩ := hmean ξ hξ
  simp only [grP5, momDg5, momRg5]
  rw [hT, hR, hZ, hL]
  simp only [m0, m1, m2, mW]
  ring

theorem inm_mul_nrm_v5 : ∀ (B : BG) (qs α β e₁ e₂ : ℝ) (f g : Cyl → ℝ), B.ok → 0 < qs → qs ≤ 1 → InM B qs α (nrm B e₁ f) → InM B qs β (nrm B e₂ g) → InM B qs (α + β) (nrm B (e₁ + e₂) (fun ξ => f ξ * g ξ)) :=
by
  intro B qs α β e₁ e₂ f g hok _ _ hF hG
  have hS := hok.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1

  have hT : IsOpen {ξ : Cyl | ξ.2.2.1 < 1} :=
    isOpen_lt continuous_snd.snd.fst continuous_const
  have hπq : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
    contDiff_snd.fst.prodMk (contDiff_const.sub contDiff_snd.snd.fst)
  have hqC : ContDiffOn ℝ ∞ (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have h4 := hS.2.2.2.1
    have hc := h4.comp hπq.contDiffOn (fun ξ (hξ : ξ.2.2.1 < 1) =>
      (⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩ : (ξ.2.1, 1 - ξ.2.2.1) ∈ univ ×ˢ Ioi (0:ℝ)))
    exact hc
  have hDopen : IsOpen (DomC B.h qs) := by
    have h1 : IsOpen {ξ : Cyl | 0 < ξ.1} := isOpen_lt continuous_const continuous_fst
    have h2 := hqC.continuousOn.isOpen_inter_preimage hT (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Iio qs) := by
      ext ξ; exact Iff.rfl
    rw [e]; exact h1.inter h2
  have hq : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ := by
    intro ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    exact (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1

  have hpt : ∀ ξ ∈ DomC B.h qs, nrm B (e₁ + e₂) (fun ξ => f ξ * g ξ) ξ =
      nrm B e₁ f ξ * nrm B e₂ g ξ := by
    intro ξ hξ
    simp only [nrm]
    rw [Real.rpow_add (hq ξ hξ)]
    ring

  have leibR : ∀ (U : Set Cyl), IsOpen U → ∀ (u v : Cyl → ℝ), ContDiffOn ℝ ∞ u U →
      ContDiffOn ℝ ∞ v U → ∀ ξ ∈ U, ∀ k : ℕ, NB B.h (fun η => u η * v η) k ξ ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB B.h u i ξ * NB B.h v (k - i) ξ := by
    intro U hU u v hu hv ξ hξ k
    unfold NB
    generalize Lnorm B.h ξ = L
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
    have hsm : ∀ F : Cyl → ℝ, ContDiffOn ℝ ∞ F U → ContDiffOn ℝ ∞ (fun z => F (ξ + z)) s := by
      intro F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ F : Cyl → ℝ, ContDiffOn ℝ ∞ F U →
        ContDiffOn ℝ ∞ (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
      intro F hF
      exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
    have key : ∀ F : Cyl → ℝ, ContDiffOn ℝ ∞ F U → ∀ i : ℕ,
        iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
          (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
      intro F hF i
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast le_top)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
      calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
              (fun _ => L) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
              (fun _ => L) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
              (fun _ => L) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
    have huv : ContDiffOn ℝ ∞ (fun η => u η * v η) U := hu.mul hv
    have leib := norm_iteratedFDerivWithin_mul_le (hsmO u hu) (hsmO v hv) hO.uniqueDiffOn h0O
      (n := k) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => u (ξ + L y) * v (ξ + L y)) k hO h0O] at leib
    rw [← key _ huv k]
    calc ‖iteratedFDeriv ℝ k (fun z => (fun η => u η * v η) (ξ + L z)) 0‖
        = ‖iteratedFDeriv ℝ k (fun y => u (ξ + L y) * v (ξ + L y)) 0‖ := rfl
      _ ≤ _ := leib
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i _
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => u (ξ + L z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => v (ξ + L z)) (k - i) hO h0O,
          key u hu i, key v hv (k - i)]
  refine ⟨?_, ?_, ?_, ?_⟩
  ·
    exact (hF.1.mul hG.1).congr hpt
  ·
    intro ξ hξ a ha
    have hξ' : shY ξ a ∈ DomC B.h qs := hξ
    rw [hpt _ hξ', hpt ξ hξ, hF.2.1 ξ hξ a ha, hG.2.1 ξ hξ a ha]
  ·
    intro ξ hξ hx
    rw [hpt ξ hξ, hF.2.2.1 ξ hξ hx, zero_mul]
  ·
    intro k

    have unif : ∀ (α' : ℝ) (u : Cyl → ℝ), InM B qs α' u → ∀ k' : ℕ,
        ∃ A b : ℝ, ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ j : ℕ, j ≤ k' →
          NB B.h u j ξ ≤ A * qC B.h ξ ^ (B.h * α') * (1 + |Real.log (qC B.h ξ)|) ^ (2 * b) := by
      intro α u hf k
      obtain ⟨hS, hBP⟩ := hok
      obtain ⟨-, -, hXa, -, -, -, -, -, -, -, -, haa, hab⟩ := hBP.1
      have core : ∀ (c δ d : ℝ) (m : ℕ), 0 < c → 0 < δ → δ ≤ 1 → d ≤ 2 * (m:ℝ) →
          Real.exp (-(c / δ ^ 2)) * δ ^ (-d) ≤ (m.factorial : ℝ) / c ^ m := by
        intro c δ d m hc hδ hδ1 hd
        have h1 : δ ^ (-d) ≤ δ ^ (-(2 * (m:ℝ))) :=
          Real.rpow_le_rpow_of_exponent_ge hδ hδ1 (by linarith)
        have h2 : δ ^ (-(2 * (m:ℝ))) = (1 / δ ^ 2) ^ m := by
          rw [Real.rpow_neg hδ.le, Real.rpow_mul hδ.le, Real.rpow_two, Real.rpow_natCast, one_div,
            inv_pow]
        have hx : 0 ≤ c * (1 / δ ^ 2) := by positivity
        have h3 := Real.pow_div_factorial_le_exp (c * (1 / δ ^ 2)) hx m
        have hfac : (0:ℝ) < m.factorial := by exact_mod_cast Nat.factorial_pos m
        have hcm : (0:ℝ) < c ^ m := pow_pos hc m
        have he : Real.exp (-(c / δ ^ 2)) = Real.exp (-(c * (1 / δ ^ 2))) := by rw [mul_one_div]
        have hee : Real.exp (-(c * (1 / δ ^ 2))) * Real.exp (c * (1 / δ ^ 2)) = 1 := by
          rw [← Real.exp_add]; simp
        calc Real.exp (-(c / δ ^ 2)) * δ ^ (-d) ≤ Real.exp (-(c / δ ^ 2)) * (1 / δ ^ 2) ^ m := by
              rw [← h2]; exact mul_le_mul_of_nonneg_left h1 (Real.exp_pos _).le
          _ = (m.factorial : ℝ) / c ^ m *
                (Real.exp (-(c * (1 / δ ^ 2))) * ((c * (1 / δ ^ 2)) ^ m / m.factorial)) := by
              rw [he, mul_pow]; field_simp
          _ ≤ (m.factorial : ℝ) / c ^ m *
                (Real.exp (-(c * (1 / δ ^ 2))) * Real.exp (c * (1 / δ ^ 2))) := by
              apply mul_le_mul_of_nonneg_left _ (by positivity)
              exact mul_le_mul_of_nonneg_left h3 (Real.exp_pos _).le
          _ = (m.factorial : ℝ) / c ^ m := by rw [hee, mul_one]
      have edge : ∀ d : ℝ, ∃ M : ℝ, 0 ≤ M ∧ ∀ X : ℝ, B.Xa < X → X < B.Xb →
          edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-d) ≤ M := by
        intro d
        obtain ⟨m, hm⟩ : ∃ m : ℕ, m = ⌈d / 2⌉₊ := ⟨_, rfl⟩
        have hdm : d ≤ 2 * (m:ℝ) := by
          have := Nat.le_ceil (d / 2); rw [← hm] at this; linarith
        have hfa : 0 ≤ (m.factorial : ℝ) / B.aa ^ m := by positivity
        have hfb : 0 ≤ (m.factorial : ℝ) / B.ab ^ m := by positivity
        refine ⟨1 + (m.factorial : ℝ) / B.aa ^ m + (m.factorial : ℝ) / B.ab ^ m, by linarith, ?_⟩
        intro X hX1 hX2
        have hX0 : 0 < X := lt_trans hXa hX1
        have hda : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr hX1)
        have hdb : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX0).mpr hX2)
        have hEW : edgeWeight B.Xa B.Xb B.aa B.ab X =
            Real.exp (-(B.aa / Real.log (X / B.Xa) ^ 2) - B.ab / Real.log (B.Xb / X) ^ 2) := by
          unfold edgeWeight; rw [if_pos ⟨hX1, hX2⟩]
        have hta : 0 ≤ B.aa / Real.log (X / B.Xa) ^ 2 := by positivity
        have htb : 0 ≤ B.ab / Real.log (B.Xb / X) ^ 2 := by positivity
        have hED1 : edgeDist B.Xa B.Xb X ≤ 1 := min_le_left _ _
        rcases min_choice 1 (min (Real.log (X / B.Xa)) (Real.log (B.Xb / X))) with h | h
        · have hE : edgeDist B.Xa B.Xb X = 1 := h
          rw [hE, Real.one_rpow, mul_one, hEW]
          have : Real.exp (-(B.aa / Real.log (X / B.Xa) ^ 2) - B.ab / Real.log (B.Xb / X) ^ 2) ≤ 1 :=
            Real.exp_le_one_iff.mpr (by linarith)
          linarith
        · rcases min_choice (Real.log (X / B.Xa)) (Real.log (B.Xb / X)) with h' | h'
          · have hE : edgeDist B.Xa B.Xb X = Real.log (X / B.Xa) := by
              unfold edgeDist; rw [h, h']
            have hle1 : Real.log (X / B.Xa) ≤ 1 := by rw [← hE]; exact hED1
            calc edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-d)
                ≤ Real.exp (-(B.aa / Real.log (X / B.Xa) ^ 2)) * Real.log (X / B.Xa) ^ (-d) := by
                  rw [hEW, hE]
                  apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hda.le _)
                  exact Real.exp_le_exp.mpr (by linarith)
              _ ≤ (m.factorial : ℝ) / B.aa ^ m := core _ _ _ _ haa hda hle1 hdm
              _ ≤ _ := by linarith
          · have hE : edgeDist B.Xa B.Xb X = Real.log (B.Xb / X) := by
              unfold edgeDist; rw [h, h']
            have hle1 : Real.log (B.Xb / X) ≤ 1 := by rw [← hE]; exact hED1
            calc edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-d)
                ≤ Real.exp (-(B.ab / Real.log (B.Xb / X) ^ 2)) * Real.log (B.Xb / X) ^ (-d) := by
                  rw [hEW, hE]
                  apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hdb.le _)
                  exact Real.exp_le_exp.mpr (by linarith)
              _ ≤ (m.factorial : ℝ) / B.ab ^ m := core _ _ _ _ hab hdb hle1 hdm
              _ ≤ _ := by linarith
      obtain ⟨-, -, -, hf4⟩ := hf
      choose Cc bb dd hCbd using hf4
      choose M hM0 hM using fun j => edge (dd j)
      refine ⟨∑ i ∈ Finset.range (k + 1), |Cc i| * M i, ∑ i ∈ Finset.range (k + 1), |bb i|, ?_⟩
      intro ξ hξ hX1 hX2 j hj
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
      have hq0 : 0 < qC B.h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
      have hjr : j ∈ Finset.range (k + 1) := Finset.mem_range.mpr (by omega)
      have hP : 0 ≤ qC B.h ξ ^ (B.h * α) := Real.rpow_nonneg hq0.le _
      have hL1 : 1 ≤ 1 + |Real.log (qC B.h ξ)| := by
        have := abs_nonneg (Real.log (qC B.h ξ)); linarith
      have hS1 : 1 ≤ SC B.h ξ := by
        show 1 ≤ (1 + |Real.log (qC B.h ξ)|) ^ 2
        nlinarith
      have hbj : bb j ≤ ∑ i ∈ Finset.range (k + 1), |bb i| :=
        le_trans (le_abs_self _)
          (Finset.single_le_sum (f := fun i => |bb i|) (fun i _ => abs_nonneg _) hjr)
      have hSb : SC B.h ξ ^ bb j ≤ SC B.h ξ ^ (∑ i ∈ Finset.range (k + 1), |bb i|) :=
        Real.rpow_le_rpow_of_exponent_le hS1 hbj
      have hSbj0 : 0 ≤ SC B.h ξ ^ bb j := Real.rpow_nonneg (by linarith) _
      have hSb0 : 0 ≤ SC B.h ξ ^ (∑ i ∈ Finset.range (k + 1), |bb i|) :=
        Real.rpow_nonneg (by linarith) _
      have hEW0 : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
        unfold edgeWeight; split_ifs
        · exact (Real.exp_pos _).le
        · exact le_rfl
      have hX0 : 0 < XC B.h ξ := lt_trans hXa hX1
      have hED0 : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) :=
        lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
          (Real.log_pos ((one_lt_div hX0).mpr hX2)))
      have hE0 : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd j) := Real.rpow_nonneg hED0.le _
      have hWt := hM j (XC B.h ξ) hX1 hX2
      have hAj : |Cc j| * M j ≤ ∑ i ∈ Finset.range (k + 1), |Cc i| * M i :=
        Finset.single_le_sum (f := fun i => |Cc i| * M i)
          (fun i _ => mul_nonneg (abs_nonneg _) (hM0 i)) hjr
      have hSeq : SC B.h ξ ^ (∑ i ∈ Finset.range (k + 1), |bb i|) =
          (1 + |Real.log (qC B.h ξ)|) ^ (2 * ∑ i ∈ Finset.range (k + 1), |bb i|) := by
        show ((1 + |Real.log (qC B.h ξ)|) ^ 2) ^ (∑ i ∈ Finset.range (k + 1), |bb i|) = _
        rw [← Real.rpow_two, ← Real.rpow_mul (by linarith)]
      calc NB B.h u j ξ
          ≤ Cc j * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bb j *
              edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd j) :=
            hCbd j ξ hξ hX1 hX2
        _ = Cc j * (qC B.h ξ ^ (B.h * α) * (SC B.h ξ ^ bb j *
              (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
                edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd j)))) := by ring
        _ ≤ |Cc j| * (qC B.h ξ ^ (B.h * α) *
              (SC B.h ξ ^ (∑ i ∈ Finset.range (k + 1), |bb i|) * M j)) := by
            apply mul_le_mul (le_abs_self _) _
              (mul_nonneg hP (mul_nonneg hSbj0 (mul_nonneg hEW0 hE0))) (abs_nonneg _)
            apply mul_le_mul_of_nonneg_left _ hP
            exact mul_le_mul hSb hWt (mul_nonneg hEW0 hE0) hSb0
        _ = (|Cc j| * M j) * (qC B.h ξ ^ (B.h * α) *
              SC B.h ξ ^ (∑ i ∈ Finset.range (k + 1), |bb i|)) := by ring
        _ ≤ (∑ i ∈ Finset.range (k + 1), |Cc i| * M i) * (qC B.h ξ ^ (B.h * α) *
              SC B.h ξ ^ (∑ i ∈ Finset.range (k + 1), |bb i|)) :=
            mul_le_mul_of_nonneg_right hAj (mul_nonneg hP hSb0)
        _ = _ := by rw [hSeq]; ring
    choose Cc bb dd hCbd using hF.2.2.2
    obtain ⟨A, b₂, hAG⟩ := unif β (nrm B e₂ g) hG k
    obtain ⟨Bb, hBb⟩ : ∃ x : ℝ, x = ∑ i ∈ Finset.range (k + 1), |bb i| := ⟨_, rfl⟩
    obtain ⟨Dd, hDd⟩ : ∃ x : ℝ, x = ∑ i ∈ Finset.range (k + 1), |dd i| := ⟨_, rfl⟩
    refine ⟨(∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |Cc i|) * |A|, Bb + b₂, Dd, ?_⟩
    intro ξ hξ hX1 hX2
    have hq0 := hq ξ hξ
    have hNB0 : ∀ (w : Cyl → ℝ) (j : ℕ), 0 ≤ NB B.h w j ξ := fun w j => norm_nonneg _
    have hev : nrm B (e₁ + e₂) (fun ξ => f ξ * g ξ) =ᶠ[nhds ξ]
        (fun η => nrm B e₁ f η * nrm B e₂ g η) :=
      Filter.eventuallyEq_of_mem (hDopen.mem_nhds hξ) hpt
    have hNBeq : NB B.h (nrm B (e₁ + e₂) (fun ξ => f ξ * g ξ)) k ξ =
        NB B.h (fun η => nrm B e₁ f η * nrm B e₂ g η) k ξ := by
      unfold NB
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    have hLb := leibR _ hDopen _ _ hF.1 hG.1 ξ hξ k
    have hP : 0 ≤ qC B.h ξ ^ (B.h * α) := Real.rpow_nonneg hq0.le _
    have hPb : 0 ≤ qC B.h ξ ^ (B.h * β) := Real.rpow_nonneg hq0.le _
    have hL1 : 1 ≤ 1 + |Real.log (qC B.h ξ)| := by
      have := abs_nonneg (Real.log (qC B.h ξ)); linarith
    have hS1 : 1 ≤ SC B.h ξ := by
      show 1 ≤ (1 + |Real.log (qC B.h ξ)|) ^ 2
      nlinarith
    have hEW0 : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
      unfold edgeWeight; split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    have hX0 : 0 < XC B.h ξ := lt_trans hXa hX1
    have hED0 : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) :=
      lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
        (Real.log_pos ((one_lt_div hX0).mpr hX2)))
    have hED1 : edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := min_le_left _ _
    have hSB0 : 0 ≤ SC B.h ξ ^ Bb := Real.rpow_nonneg (by linarith) _
    have hDD0 : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-Dd) := Real.rpow_nonneg hED0.le _
    obtain ⟨X, hX⟩ : ∃ x : ℝ, x = qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ Bb *
        edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-Dd) :=
      ⟨_, rfl⟩
    obtain ⟨Y, hY⟩ : ∃ y : ℝ, y = qC B.h ξ ^ (B.h * β) * (1 + |Real.log (qC B.h ξ)|) ^ (2 * b₂) :=
      ⟨_, rfl⟩
    have hY0 : 0 ≤ Y := by rw [hY]; exact mul_nonneg hPb (Real.rpow_nonneg (by linarith) _)
    have hFi : ∀ i ∈ Finset.range (k + 1), NB B.h (nrm B e₁ f) i ξ ≤ |Cc i| * X := by
      intro i hi
      have hbi : bb i ≤ Bb := by
        rw [hBb]
        exact le_trans (le_abs_self _)
          (Finset.single_le_sum (f := fun i => |bb i|) (fun i _ => abs_nonneg _) hi)
      have hdi : dd i ≤ Dd := by
        rw [hDd]
        exact le_trans (le_abs_self _)
          (Finset.single_le_sum (f := fun i => |dd i|) (fun i _ => abs_nonneg _) hi)
      have h1 : SC B.h ξ ^ bb i ≤ SC B.h ξ ^ Bb := Real.rpow_le_rpow_of_exponent_le hS1 hbi
      have h2 : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd i) ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-Dd) :=
        Real.rpow_le_rpow_of_exponent_ge hED0 hED1 (by linarith)
      have h1' : 0 ≤ SC B.h ξ ^ bb i := Real.rpow_nonneg (by linarith) _
      have h2' : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd i) := Real.rpow_nonneg hED0.le _
      calc NB B.h (nrm B e₁ f) i ξ
          ≤ Cc i * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bb i *
              edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd i) :=
            hCbd i ξ hξ hX1 hX2
        _ = Cc i * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bb i *
              edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd i)) := by
            ring
        _ ≤ |Cc i| * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ Bb *
              edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-Dd)) := by
            apply mul_le_mul (le_abs_self _) _
              (mul_nonneg (mul_nonneg (mul_nonneg hP h1') hEW0) h2') (abs_nonneg _)
            exact mul_le_mul (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left h1 hP) hEW0) h2 h2'
              (mul_nonneg (mul_nonneg hP hSB0) hEW0)
        _ = |Cc i| * X := by rw [hX]
    have hGj : ∀ j : ℕ, j ≤ k → NB B.h (nrm B e₂ g) j ξ ≤ |A| * Y := by
      intro j hj
      calc NB B.h (nrm B e₂ g) j ξ
          ≤ A * qC B.h ξ ^ (B.h * β) * (1 + |Real.log (qC B.h ξ)|) ^ (2 * b₂) := hAG ξ hξ hX1 hX2 j hj
        _ = A * Y := by rw [hY]; ring
        _ ≤ |A| * Y := mul_le_mul_of_nonneg_right (le_abs_self _) hY0
    have hSC0 : 0 < SC B.h ξ := by linarith
    have hSeq : SC B.h ξ ^ b₂ = (1 + |Real.log (qC B.h ξ)|) ^ (2 * b₂) := by
      show ((1 + |Real.log (qC B.h ξ)|) ^ 2) ^ b₂ = _
      rw [← Real.rpow_two, ← Real.rpow_mul (by linarith)]
    calc NB B.h (nrm B (e₁ + e₂) (fun ξ => f ξ * g ξ)) k ξ
        = NB B.h (fun η => nrm B e₁ f η * nrm B e₂ g η) k ξ := hNBeq
      _ ≤ ∑ i ∈ Finset.range (k + 1),
            (k.choose i : ℝ) * NB B.h (nrm B e₁ f) i ξ * NB B.h (nrm B e₂ g) (k - i) ξ := hLb
      _ ≤ ∑ i ∈ Finset.range (k + 1), ((k.choose i : ℝ) * |Cc i|) * (|A| * (X * Y)) := by
          apply Finset.sum_le_sum
          intro i hi
          have hik : k - i ≤ k := Nat.sub_le k i
          have hm := mul_le_mul (hFi i hi) (hGj (k - i) hik) (hNB0 _ _)
            (le_trans (hNB0 _ _) (hFi i hi))
          calc (k.choose i : ℝ) * NB B.h (nrm B e₁ f) i ξ * NB B.h (nrm B e₂ g) (k - i) ξ
              = (k.choose i : ℝ) * (NB B.h (nrm B e₁ f) i ξ * NB B.h (nrm B e₂ g) (k - i) ξ) := by
                ring
            _ ≤ (k.choose i : ℝ) * ((|Cc i| * X) * (|A| * Y)) :=
                mul_le_mul_of_nonneg_left hm (Nat.cast_nonneg _)
            _ = ((k.choose i : ℝ) * |Cc i|) * (|A| * (X * Y)) := by ring
      _ = (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |Cc i|) * (|A| * (X * Y)) := by
          rw [← Finset.sum_mul]
      _ = (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |Cc i|) * |A| *
            qC B.h ξ ^ (B.h * (α + β)) * SC B.h ξ ^ (Bb + b₂) *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-Dd) := by
          rw [hX, hY, show B.h * (α + β) = B.h * α + B.h * β by ring, Real.rpow_add hq0,
            Real.rpow_add hSC0, hSeq]
          ring

theorem inm_ubase_mul_v5 : ∀ (B : BG), B.ok → SimNorm B.h → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (α e : ℝ) (f : Cyl → ℝ), InM B (qsOf l0) α (nrm B e f) → InM B (qsOf l0) α (nrm B (e + Aex B.h) (fun ξ => ubase B ξ 1 * f ξ)) ∧ InM B (qsOf l0) α (nrm B (e + Aex B.h) (fun ξ => ubase B ξ 2 * f ξ)) :=
by
  intro B hB _
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -, hqB0, -, -, -, -, -⟩ := hB.2.1
  obtain ⟨-, -, -, -, -, hc6, ⟨hGE, hGU, -, -⟩, -⟩ := hB.2
  have hS : SimScaleProps B.h := hB.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)

  have hqpos : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hqC' : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) (DomC B.h B.qB) :=
    hqC'.mono (fun η hη => hη.2.1)
  have hDog : ∀ s : ℝ, IsOpen (DomC B.h s) := by
    intro s
    have hT : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
    have h1 : IsOpen ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Iio s) :=
      hqC'.continuousOn.isOpen_inter_preimage hT isOpen_Iio
    have h2 : IsOpen {η : Cyl | 0 < η.1} := isOpen_lt continuous_const continuous_fst
    have e : DomC B.h s = {η : Cyl | 0 < η.1} ∩
        ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Iio s) := by
      ext η
      exact ⟨fun h => ⟨h.1, h.2.1, h.2.2⟩, fun h => ⟨h.1, h.2.1, h.2.2⟩⟩
    rw [e]; exact h2.inter h1
  have hDo : IsOpen (DomC B.h B.qB) := hDog B.qB
  have hne : ∀ η ∈ DomC B.h B.qB, qC B.h η ≠ 0 := fun η hη => (hqpos η hη.2.1).ne'
  have hφ1 : ContDiffOn ℝ ∞ (fun η : Cyl => Real.log (qC B.h η)) (DomC B.h B.qB) := hqC.log hne
  have hφ2 : ContDiffOn ℝ ∞ (XC B.h) (DomC B.h B.qB) := by
    have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ 2) (DomC B.h B.qB) :=
      (contDiff_fst.pow 2).contDiffOn
    have h2 : ContDiffOn ℝ ∞ (fun η : Cyl => 2 * qC B.h η) (DomC B.h B.qB) :=
      contDiffOn_const.mul hqC
    exact (h1.div h2 (fun η hη => mul_ne_zero two_ne_zero (hne η hη))).congr (fun η _ => rfl)
  have hφ3 : ContDiffOn ℝ ∞ (etaC B.h) (DomC B.h B.qB) := by
    have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => η.2.1) (DomC B.h B.qB) := contDiff_snd.fst.contDiffOn
    exact (h1.mul (hqC.rpow_const_of_ne (p := -(1/2 - B.h)) hne)).congr (fun η _ => rfl)
  have hWo : IsOpen (Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) :=
    isOpen_Iio.prod (isOpen_Ioi.prod isOpen_Ioo)
  have hmaps : ∀ η ∈ DomC B.h B.qB, (Real.log (qC B.h η), XC B.h η, etaC B.h η) ∈
      Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := by
    intro η hη
    have hqη := hqpos η hη.2.1
    have hs : 0 < qC B.h η ^ (1/2 - B.h) := Real.rpow_pos_of_pos hqη _
    have hs2 : (qC B.h η ^ (1/2 - B.h)) ^ 2 = qC B.h η ^ (1 - 2 * B.h) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hqη.le]; congr 1; push_cast; ring
    have hz : η.2.1 ^ 2 < (qC B.h η ^ (1/2 - B.h)) ^ 2 := by
      rw [hs2]; exact (hS.2.1 η.2.1 (1 - η.2.2.1) (by linarith [hη.2.1])).2
    have habs := abs_lt.mp (abs_lt_of_sq_lt_sq hz hs.le)
    have he : etaC B.h η = η.2.1 / qC B.h η ^ (1/2 - B.h) := by
      unfold etaC; rw [Real.rpow_neg hqη.le]; exact (div_eq_mul_inv _ _).symm
    refine Set.mk_mem_prod (Set.mem_Iio.mpr (Real.log_lt_log hqη hη.2.2))
      (Set.mk_mem_prod (Set.mem_Ioi.mpr ?_) (Set.mem_Ioo.mpr ⟨?_, ?_⟩))
    · exact div_pos (pow_pos hη.1 2) (mul_pos two_pos hqη)
    · rw [he, lt_div_iff₀ hs]; linarith
    · rw [he, div_lt_iff₀ hs]; linarith
  have hGEs : ContDiffOn ℝ ∞ (fun η : Cyl => logLift B.Eb (Real.log (qC B.h η), XC B.h η, etaC B.h η))
      (DomC B.h B.qB) := hGE.comp (hφ1.prodMk (hφ2.prodMk hφ3)) hmaps
  have hGUs : ContDiffOn ℝ ∞ (fun η : Cyl => logLift B.Ub (Real.log (qC B.h η), XC B.h η, etaC B.h η))
      (DomC B.h B.qB) := hGU.comp (hφ1.prodMk (hφ2.prodMk hφ3)) hmaps

  have hrep : ∀ η ∈ DomC B.h B.qB,
      logLift B.Eb (Real.log (qC B.h η), XC B.h η, etaC B.h η) = qC B.h η ^ Aex B.h * ubase B η 1 ∧
      logLift B.Ub (Real.log (qC B.h η), XC B.h η, etaC B.h η) = qC B.h η ^ Aex B.h * ubase B η 2 := by
    intro η hη
    have hqη : 0 < qC B.h η := hqpos η hη.2.1
    have hr0 : η.1 ≠ 0 := ne_of_gt hη.1
    have hx0 : (rotPt η.1 0 η.2.1) 0 = η.1 := by simp [rotPt]
    have hx1 : (rotPt η.1 0 η.2.1) 1 = 0 := by simp [rotPt]
    have hx2 : (rotPt η.1 0 η.2.1) 2 = η.2.1 := by simp [rotPt]
    have hsq : (rotPt η.1 0 η.2.1) 0 ^ 2 + (rotPt η.1 0 η.2.1) 1 ^ 2 = η.1 ^ 2 := by
      rw [hx0, hx1]; ring
    have hrad : rad (rotPt η.1 0 η.2.1) = η.1 := by
      unfold rad; rw [hsq]; exact Real.sqrt_sq hη.1.le
    have hS2 : simScale B.h ((rotPt η.1 0 η.2.1) 2) (1 - η.2.2.1) = qC B.h η := by
      rw [hx2]; rfl
    have hmem : ((rotPt η.1 0 η.2.1), η.2.2.1) ∈ simDomain B.h B.qB :=
      ⟨hη.2.1, by show simScale B.h ((rotPt η.1 0 η.2.1) 2) (1 - η.2.2.1) < B.qB; rw [hS2]; exact hη.2.2⟩
    have hpos : 0 < (rotPt η.1 0 η.2.1) 0 ^ 2 + (rotPt η.1 0 η.2.1) 1 ^ 2 := by
      rw [hsq]; exact pow_pos hη.1 2
    obtain ⟨h6a, h6b, -⟩ := hc6 (rotPt η.1 0 η.2.1) η.2.2.1 hmem hpos
    have hsX : simX B.h (rotPt η.1 0 η.2.1) η.2.2.1 = XC B.h η := by
      unfold simX XC; rw [hsq, hS2]
    have hsE : simEta B.h (rotPt η.1 0 η.2.1) η.2.2.1 = etaC B.h η := by
      unfold simEta etaC; rw [hS2, hx2]
    rw [hS2, hsX, hsE, hsq, Real.sqrt_sq hη.1.le] at h6a
    rw [hS2, hsX, hsE] at h6b
    have hl : ∀ g : ℝ → ℝ → ℝ → ℝ, logLift g (Real.log (qC B.h η), XC B.h η, etaC B.h η) =
        g (qC B.h η) (XC B.h η) (etaC B.h η) := by
      intro g; unfold logLift; rw [Real.exp_log hqη]
    have hu1 : ubase B η 1 = qC B.h η ^ (-(1/2 + B.h)) * B.Eb (qC B.h η) (XC B.h η) (etaC B.h η) := by
      show inner ℝ (curl3 (fun w => B.AB w η.2.2.1) (rotPt η.1 0 η.2.1) + B.BvB (rotPt η.1 0 η.2.1) η.2.2.1)
        (eTh (rotPt η.1 0 η.2.1)) = _
      rw [eTh, real_inner_smul_right, h6a, hrad, mul_assoc η.1, ← mul_assoc η.1⁻¹,
        inv_mul_cancel₀ hr0, one_mul]
    have hu2 : ubase B η 2 = qC B.h η ^ (-(1/2 + B.h)) * B.Ub (qC B.h η) (XC B.h η) (etaC B.h η) := by
      have hz : ∀ v : ℝ³, inner ℝ v eZ = v 2 := by
        intro v; simp [eZ, EuclideanSpace.inner_single_right]
      show inner ℝ (curl3 (fun w => B.AB w η.2.2.1) (rotPt η.1 0 η.2.1) + B.BvB (rotPt η.1 0 η.2.1) η.2.2.1)
        eZ = _
      rw [hz, h6b]
    have hA : qC B.h η ^ Aex B.h * qC B.h η ^ (-(1/2 + B.h)) = 1 := by
      rw [← Real.rpow_add hqη, show Aex B.h + -(1/2 + B.h) = 0 by unfold Aex; ring, Real.rpow_zero]
    refine ⟨?_, ?_⟩
    · rw [hl, hu1, ← mul_assoc, hA, one_mul]
    · rw [hl, hu2, ← mul_assoc, hA, one_mul]

  choose C3 hC3 using outer_profile_bounds_v5 B hB
  have h4 : ∀ i : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h B.qB, 1 ≤ i →
      NB B.h (fun η : Cyl => Real.log (qC B.h η)) i ξ ≤ C := by
    intro i
    rcases Nat.eq_zero_or_pos i with hi | hi
    · exact ⟨0, fun ξ _ h => absurd h (by omega)⟩
    · obtain ⟨C, hC⟩ := logqC_nb_v5 B hB i hi
      exact ⟨C, fun ξ hξ _ => hC ξ hξ⟩
  choose C4 hC4 using h4
  choose C5 hC5 using xc_etac_nb_v5 B hB
  have hcomp : ∀ (G : ℝ × ℝ × ℝ → ℝ),
      ContDiffOn ℝ ∞ G (Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) →
      (∀ (m : ℕ) (ξ : Cyl), ξ ∈ DomC B.h B.qB → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        ‖iteratedFDeriv ℝ m G (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ)‖ ≤ |C3 m|) →
      ∀ k : ℕ, ∃ M : ℝ, ∀ ξ ∈ DomC B.h B.qB, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ i, i ≤ k →
        NB B.h (fun η => G (Real.log (qC B.h η), XC B.h η, etaC B.h η)) i ξ ≤ M := by
    intro G hG hGb k
    have hsum : ∀ (g : ℕ → ℝ) (j : ℕ), j ≤ k → |g j| ≤ ∑ i ∈ Finset.range (k + 1), |g i| :=
      fun g j hj => Finset.single_le_sum (f := fun i => |g i|) (fun i _ => abs_nonneg _)
        (Finset.mem_range.mpr (by omega))
    have hs0 : ∀ g : ℕ → ℝ, 0 ≤ ∑ i ∈ Finset.range (k + 1), |g i| :=
      fun g => Finset.sum_nonneg (fun i _ => abs_nonneg _)
    obtain ⟨SG, hSG⟩ : ∃ A : ℝ, A = ∑ i ∈ Finset.range (k + 1), |C3 i| := ⟨_, rfl⟩
    obtain ⟨D, hD⟩ : ∃ A : ℝ, A = 1 + ∑ i ∈ Finset.range (k + 1), |C4 i| +
        ∑ i ∈ Finset.range (k + 1), |C5 i| := ⟨_, rfl⟩
    have hSG0 : 0 ≤ SG := by rw [hSG]; exact hs0 C3
    have hD1 : 1 ≤ D := by rw [hD]; linarith [hs0 C4, hs0 C5]
    refine ⟨(k.factorial : ℝ) * SG * (3 * D) ^ k, fun ξ hξU hX1 hX2 i hi => ?_⟩
    have hX2' : XC B.h ξ < 2 * B.Xb := by linarith
    have h := nb_comp3_v5 B.h (DomC B.h B.qB) _ ξ G (fun η => Real.log (qC B.h η)) (XC B.h) (etaC B.h)
      i SG D hDo hWo hξU hG hφ1 hφ2 hφ3 hmaps hD1
      (fun m hm => (hGb m ξ hξU hX1 hX2).trans (by rw [hSG]; exact hsum C3 m (hm.trans hi)))
      (fun j hj1 hji => ⟨(hC4 j ξ hξU hj1).trans ((le_abs_self _).trans
          (by rw [hD]; linarith [hsum C4 j (hji.trans hi), hs0 C5])),
        ((hC5 j ξ hξU hX2').1).trans ((le_abs_self _).trans
          (by rw [hD]; linarith [hsum C5 j (hji.trans hi), hs0 C4])),
        ((hC5 j ξ hξU hX2').2).trans ((le_abs_self _).trans
          (by rw [hD]; linarith [hsum C5 j (hji.trans hi), hs0 C4]))⟩)
    refine h.trans ?_
    have hf : (i.factorial : ℝ) ≤ k.factorial := by exact_mod_cast Nat.factorial_le hi
    have h3 : (1:ℝ) ≤ 3 * D := by linarith
    exact mul_le_mul (mul_le_mul_of_nonneg_right hf hSG0) (pow_le_pow_right₀ h3 hi)
      (pow_nonneg (by linarith) _) (mul_nonneg (Nat.cast_nonneg _) hSG0)

  have key : ∀ (c C P S1 S2 W d1 d2 : ℝ), c ≤ C → 0 ≤ C → 0 ≤ P → 0 ≤ S1 → S1 ≤ S2 → 0 ≤ W →
      0 ≤ d1 → d1 ≤ d2 → c * P * S1 * W * d1 ≤ C * P * S2 * W * d2 := by
    intro c C P S1 S2 W d1 d2 h1 h2 h3 h4 h5 h6 h7 h8
    have hY1 : 0 ≤ P * S1 * W * d1 := mul_nonneg (mul_nonneg (mul_nonneg h3 h4) h6) h7
    have hY12 : P * S1 * W * d1 ≤ P * S2 * W * d2 :=
      mul_le_mul (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left h5 h3) h6) h8 h7
        (mul_nonneg (mul_nonneg h3 (h4.trans h5)) h6)
    calc c * P * S1 * W * d1 = c * (P * S1 * W * d1) := by ring
      _ ≤ C * (P * S1 * W * d1) := mul_le_mul_of_nonneg_right h1 hY1
      _ ≤ C * (P * S2 * W * d2) := mul_le_mul_of_nonneg_left hY12 h2
      _ = C * P * S2 * W * d2 := by ring

  have hmain : ∀ (m u : Cyl → ℝ), ContDiffOn ℝ ∞ m (DomC B.h B.qB) →
      (∀ η ∈ DomC B.h B.qB, m η = qC B.h η ^ Aex B.h * u η) →
      (∀ (ξ : Cyl) (c : ℝ × ℝ), u (shY ξ c) = u ξ) →
      (∀ k : ℕ, ∃ M : ℝ, ∀ ξ ∈ DomC B.h B.qB, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ i, i ≤ k →
        NB B.h m i ξ ≤ M) →
      ∀ l0 : ℕ, n0 ≤ l0 → ∀ (α e : ℝ) (f : Cyl → ℝ), InM B (qsOf l0) α (nrm B e f) →
      InM B (qsOf l0) α (nrm B (e + Aex B.h) (fun ξ => u ξ * f ξ)) := by
    intro m u hm hmu hu hNB l0 hl0 α e f hF
    have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
      show (2:ℝ) ^ (-(l0:ℝ)) = _
      rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
    have hqsB : qsOf l0 ≤ B.qB := by
      rw [hQb]; exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
    have hDU : ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ DomC B.h B.qB :=
      fun ξ hξ => ⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqsB⟩
    have hDs : IsOpen (DomC B.h (qsOf l0)) := hDog _
    obtain ⟨F1, F2, F3, F4⟩ := hF
    have hid : ∀ ξ ∈ DomC B.h (qsOf l0),
        nrm B (e + Aex B.h) (fun ξ => u ξ * f ξ) ξ = m ξ * nrm B e f ξ := by
      intro ξ hξ
      have hq := hqpos ξ hξ.2.1
      rw [hmu ξ (hDU ξ hξ)]
      simp only [nrm]
      rw [Real.rpow_add hq]
      ring
    refine ⟨?_, ?_, ?_, ?_⟩
    · exact ((hm.mono hDU).mul F1).congr hid
    · intro ξ hξ c hc
      have hξ' : shY ξ c ∈ DomC B.h (qsOf l0) := hξ
      have hqs : qC B.h (shY ξ c) = qC B.h ξ := rfl
      rw [hid _ hξ', hid ξ hξ, F2 ξ hξ c hc, hmu _ (hDU _ hξ'), hmu ξ (hDU ξ hξ), hu ξ c, hqs]
    · intro ξ hξ hX
      rw [hid ξ hξ, F3 ξ hξ hX, mul_zero]
    · intro k
      obtain ⟨M, hM⟩ := hNB k
      choose Cf bf df hCf using F4
      have hsum : ∀ (g : ℕ → ℝ) (j : ℕ), j ≤ k → |g j| ≤ ∑ i ∈ Finset.range (k + 1), |g i| :=
        fun g j hj => Finset.single_le_sum (f := fun i => |g i|) (fun i _ => abs_nonneg _)
          (Finset.mem_range.mpr (by omega))
      obtain ⟨Cs, hCs⟩ : ∃ A : ℝ, A = ∑ i ∈ Finset.range (k + 1), |Cf i| := ⟨_, rfl⟩
      obtain ⟨bs, hbs⟩ : ∃ A : ℝ, A = ∑ i ∈ Finset.range (k + 1), |bf i| := ⟨_, rfl⟩
      obtain ⟨ds, hds⟩ : ∃ A : ℝ, A = ∑ i ∈ Finset.range (k + 1), |df i| := ⟨_, rfl⟩
      refine ⟨2 ^ k * |M| * Cs, bs, ds, fun ξ hξ hX1 hX2 => ?_⟩
      have hq0 : 0 < qC B.h ξ := hqpos ξ hξ.2.1
      have hP0 : 0 ≤ qC B.h ξ ^ (B.h * α) := (Real.rpow_pos_of_pos hq0 _).le
      have hSC1 : 1 ≤ SC B.h ξ := by
        unfold SC; exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h ξ))])
      have hew : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
        unfold edgeWeight
        split_ifs
        · positivity
        · exact le_rfl
      have hδ0 : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) := by
        have hX0 : 0 < XC B.h ξ := lt_trans hXa hX1
        unfold edgeDist
        exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
          (Real.log_pos ((one_lt_div hX0).mpr hX2)))
      have hδ1 : edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := by unfold edgeDist; exact min_le_left _ _
      obtain ⟨E, hE⟩ : ∃ A : ℝ, A = Cs * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bs *
          edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-ds) := ⟨_, rfl⟩
      have hFb : ∀ i, i ≤ k → NB B.h (nrm B e f) i ξ ≤ E := by
        intro i hi
        refine (hCf i ξ hξ hX1 hX2).trans ?_
        have hC : Cf i ≤ Cs := (le_abs_self _).trans (by rw [hCs]; exact hsum Cf i hi)
        have hCs0 : 0 ≤ Cs := le_trans (abs_nonneg _) (by rw [hCs]; exact hsum Cf i hi)
        have hSb : SC B.h ξ ^ bf i ≤ SC B.h ξ ^ bs :=
          Real.rpow_le_rpow_of_exponent_le hSC1
            ((le_abs_self _).trans (by rw [hbs]; exact hsum bf i hi))
        have hdi : df i ≤ ds := (le_abs_self _).trans (by rw [hds]; exact hsum df i hi)
        have hdb : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df i) ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-ds) :=
          Real.rpow_le_rpow_of_exponent_ge hδ0 hδ1 (by linarith)
        rw [hE]
        exact key _ _ _ _ _ _ _ _ hC hCs0 hP0 (Real.rpow_nonneg (by linarith) _) hSb hew
          (Real.rpow_nonneg hδ0.le _) hdb
      have hDsξ := hDs.mem_nhds hξ
      have hev : nrm B (e + Aex B.h) (fun ξ => u ξ * f ξ) =ᶠ[nhds ξ] fun η => m η * nrm B e f η :=
        Filter.eventuallyEq_of_mem hDsξ hid
      have hNBeq : NB B.h (nrm B (e + Aex B.h) (fun ξ => u ξ * f ξ)) k ξ =
          NB B.h (fun η => m η * nrm B e f η) k ξ := by
        unfold NB; rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      rw [hNBeq]
      have hmul := nb_real_mul_le_v5 B.h ξ m (nrm B e f) k |M| E
        (hm.contDiffAt (hDo.mem_nhds (hDU ξ hξ))) (F1.contDiffAt hDsξ)
        (fun i hi => (hM ξ (hDU ξ hξ) hX1 hX2 i hi).trans (le_abs_self _)) hFb
      refine hmul.trans (le_of_eq ?_)
      rw [hE]; ring
  refine ⟨n0, fun l0 hl0 α e f hf => ⟨?_, ?_⟩⟩
  · exact hmain _ (fun ξ => ubase B ξ 1) hGEs (fun η hη => (hrep η hη).1) (fun ξ c => rfl)
      (hcomp _ hGE (fun m ξ hξU hX1 hX2 =>
        ((hC3 m (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) (hqpos ξ hξU.2.1) hξU.2.2 (by linarith)
          (by linarith) (hmaps ξ hξU).2.2.1 (hmaps ξ hξU).2.2.2).1).trans (le_abs_self _)))
      l0 hl0 α e f hf
  · exact hmain _ (fun ξ => ubase B ξ 2) hGUs (fun η hη => (hrep η hη).2) (fun ξ c => rfl)
      (hcomp _ hGU (fun m ξ hξU hX1 hX2 =>
        ((hC3 m (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) (hqpos ξ hξU.2.1) hξU.2.2 (by linarith)
          (by linarith) (hmaps ξ hξU).2.2.1 (hmaps ξ hξU).2.2.2).2).trans (le_abs_self _)))
      l0 hl0 α e f hf

theorem tdg_ubase0_mul_v5 : ∀ (B : BG), B.ok → SimNorm B.h → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (α e : ℝ) (f : Cyl → ℝ), InM B (qsOf l0) α (nrm B e f) → InM B (qsOf l0) (α + 1) (nrm B (e + Aex B.h) (fun ξ => ubase B ξ 0 * f ξ)) :=
by
  intro B hok hSN
  obtain ⟨-, -, hXa, -, -, -, -, hqB0, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, ?_⟩
  intro l0 hl0 α e f hF
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs0 : 0 < qsOf l0 := by rw [hQb]; positivity
  have hqs1 : qsOf l0 ≤ 1 := by rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  obtain ⟨hMc, -⟩ := mom_class_algebra_v4 B (qsOf l0) hok hqs0 hqs1
  obtain ⟨hDo, -, hqpos, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hDsub : DomC B.h (qsOf l0) ⊆ DomC B.h B.qB :=
    fun ξ hξ => ⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqsB⟩

  have hrep : ∀ ξ ∈ DomC B.h B.qB, qC B.h ξ ^ Aex B.h * ubase B ξ 0 =
      qC B.h ξ ^ B.h * (2 * XC B.h ξ) ^ (-(1/2:ℝ)) *
        logLift B.Vb (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) := by
    intro ξ hξ
    obtain ⟨hr, ht, hqB⟩ := hξ
    obtain ⟨hS1, -⟩ := hok.1
    obtain ⟨-, -, -, -, -, hVel, -⟩ := hok.2
    have hτ : 0 < 1 - ξ.2.2.1 := by linarith
    have hq : 0 < qC B.h ξ := (hS1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
    have hx0 : (rotPt ξ.1 0 ξ.2.1) 0 = ξ.1 := by simp [rotPt]
    have hx1 : (rotPt ξ.1 0 ξ.2.1) 1 = 0 := by simp [rotPt]
    have hx2 : (rotPt ξ.1 0 ξ.2.1) 2 = ξ.2.1 := by simp [rotPt]
    set x := rotPt ξ.1 0 ξ.2.1 with hx
    have hsc : simScale B.h (x 2) (1 - ξ.2.2.1) = qC B.h ξ := by rw [hx2]; rfl
    have hrr : x 0 ^ 2 + x 1 ^ 2 = ξ.1 ^ 2 := by rw [hx0, hx1]; ring
    have hpos : 0 < x 0 ^ 2 + x 1 ^ 2 := by rw [hrr]; positivity
    have hsqrt : Real.sqrt (x 0 ^ 2 + x 1 ^ 2) = ξ.1 := by rw [hrr, Real.sqrt_sq hr.le]
    have hsimX : simX B.h x ξ.2.2.1 = XC B.h ξ := by
      unfold simX XC
      rw [hsc, hrr]
    have hsimEta : simEta B.h x ξ.2.2.1 = etaC B.h ξ := by
      unfold simEta etaC
      rw [hsc, hx2]
    have hmem : (x, ξ.2.2.1) ∈ simDomain B.h B.qB := by
      show ξ.2.2.1 < 1 ∧ simScale B.h (x 2) (1 - ξ.2.2.1) < B.qB
      rw [hsc]
      exact ⟨ht, hqB⟩
    obtain ⟨-, -, hV⟩ := hVel x ξ.2.2.1 hmem hpos
    rw [hsimX, hsimEta, hsc] at hV
    have hrad : rad x = ξ.1 := hsqrt
    have hb : ubase B ξ 0 = ξ.1⁻¹ * B.Vb (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) := by
      show inner ℝ (uB B x ξ.2.2.1) (frameAt 0 ξ 0) = _
      have hf : frameAt 0 ξ 0 = (rad x)⁻¹ • radVec x := rfl
      rw [hf, real_inner_smul_right, hrad]
      show ξ.1⁻¹ * inner ℝ (curl3 (fun w => B.AB w ξ.2.2.1) x + B.BvB x ξ.2.2.1) (radVec x) = _
      rw [hV]
    have hL : logLift B.Vb (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) =
        B.Vb (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) := by
      simp only [logLift, Real.exp_log hq]
    have hqne : qC B.h ξ ≠ 0 := hq.ne'
    have h2X : 2 * XC B.h ξ = ξ.1 ^ 2 * (qC B.h ξ)⁻¹ := by
      unfold XC
      field_simp
    have hphi : (2 * XC B.h ξ) ^ (-(1/2:ℝ)) = ξ.1⁻¹ * qC B.h ξ ^ (1/2:ℝ) := by
      rw [h2X, Real.mul_rpow (by positivity) (by positivity), Real.inv_rpow hq.le,
        Real.rpow_neg (sq_nonneg _), Real.rpow_neg hq.le, inv_inv]
      have h12 : (ξ.1 ^ 2) ^ (1/2:ℝ) = ξ.1 := by rw [← Real.sqrt_eq_rpow, Real.sqrt_sq hr.le]
      rw [h12]
    have hA : qC B.h ξ ^ Aex B.h = qC B.h ξ ^ (1/2:ℝ) * qC B.h ξ ^ B.h := by
      unfold Aex
      rw [Real.rpow_add hq]
    rw [hb, hL, hphi, hA]
    ring

  obtain ⟨φ, hφdef⟩ : ∃ g : ℝ → ℝ, g = fun X => (2 * X) ^ (-(1/2:ℝ)) := ⟨_, rfl⟩
  have hφ : ContDiffOn ℝ ∞ φ (Set.Ioi 0) := by
    rw [hφdef]
    have h2 : ContDiffOn ℝ ∞ (fun X : ℝ => 2 * X) (Set.Ioi 0) :=
      contDiffOn_const.mul contDiffOn_id
    exact h2.rpow_const_of_ne (fun X hX => (mul_pos two_pos (Set.mem_Ioi.mp hX)).ne')
  have hP := qpow_profile_nb_v4 B (qsOf l0) hok hSN hqs0 hqs1 φ B.h hφ
  obtain ⟨-, -, -, -, -, -, ⟨-, -, hVbS, hbd⟩, -⟩ := hok.2
  have hVbB : ∀ m : ℕ, ∃ C : ℝ, ∀ q X η : ℝ, 0 < q → q < B.qB → B.Xa ≤ X → X ≤ B.Xb →
      -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (logLift B.Vb) (Real.log q, X, η)‖ ≤ C := by
    intro m
    obtain ⟨C, hC⟩ := hbd B.Xa B.Xb hXa m
    exact ⟨C, fun q X η h1 h2 h3 h4 h5 h6 => (hC q X η h1 h2 h3 h4 h5 h6).2.2⟩
  have hΛ := bg_chart_nb_v5 B (logLift B.Vb) hok hVbS hVbB
  obtain ⟨Pf, hPf⟩ : ∃ g : Cyl → ℝ, g = fun η => qC B.h η ^ B.h * φ (XC B.h η) := ⟨_, rfl⟩
  obtain ⟨Lf, hLf⟩ : ∃ g : Cyl → ℝ,
      g = fun η => logLift B.Vb (Real.log (qC B.h η), XC B.h η, etaC B.h η) := ⟨_, rfl⟩
  obtain ⟨m, hm⟩ : ∃ g : Cyl → ℝ, g = fun η => Pf η * Lf η := ⟨_, rfl⟩
  have hPs : ContDiffOn ℝ ∞ Pf (DomC B.h (qsOf l0)) := by rw [hPf]; exact hP.1
  have hPb : ∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      NB B.h Pf k ξ ≤ C * qC B.h ξ ^ B.h := by rw [hPf]; exact hP.2
  have hLs : ContDiffOn ℝ ∞ Lf (DomC B.h B.qB) := by rw [hLf]; exact hΛ.1
  have hLb : ∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h B.qB, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      NB B.h Lf k ξ ≤ C := by rw [hLf]; exact hΛ.2
  have hms : ContDiffOn ℝ ∞ m (DomC B.h (qsOf l0)) := by
    rw [hm]; exact hPs.mul (hLs.mono hDsub)
  have hmdeck : ∀ (ξ : Cyl) (a : ℝ × ℝ), m (shY ξ a) = m ξ := by
    intro ξ a
    subst hm hPf hLf
    rfl
  choose CP hCP using hPb
  choose CL hCL using hLb
  obtain ⟨KM, hKM⟩ : ∃ g : ℕ → ℝ,
      g = fun i => ∑ j ∈ Finset.range (i + 1), (i.choose j : ℝ) * |CP j| * |CL (i - j)| := ⟨_, rfl⟩
  have hmB : ∀ i : ℕ, ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      NB B.h m i ξ ≤ KM i * qC B.h ξ ^ B.h := by
    intro i ξ hξ hX1 hX2
    have hq0 := hqpos ξ hξ
    have hQ : 0 ≤ qC B.h ξ ^ B.h := Real.rpow_nonneg hq0.le _
    have hLe := nb_mul_le_v4 B.h (DomC B.h (qsOf l0)) Pf Lf hDo hPs (hLs.mono hDsub) ξ hξ i
    rw [hm]
    refine le_trans hLe ?_
    rw [hKM]
    beta_reduce
    rw [Finset.sum_mul]
    apply Finset.sum_le_sum
    intro j _
    have h1 : NB B.h Pf j ξ ≤ |CP j| * qC B.h ξ ^ B.h :=
      le_trans (hCP j ξ hξ hX1 hX2) (mul_le_mul_of_nonneg_right (le_abs_self _) hQ)
    have h2 : NB B.h Lf (i - j) ξ ≤ |CL (i - j)| :=
      le_trans (hCL (i - j) ξ (hDsub hξ) hX1 hX2) (le_abs_self _)
    have h0' : 0 ≤ NB B.h Lf (i - j) ξ := norm_nonneg _
    calc (i.choose j : ℝ) * NB B.h Pf j ξ * NB B.h Lf (i - j) ξ
        ≤ (i.choose j : ℝ) * (|CP j| * qC B.h ξ ^ B.h) * |CL (i - j)| := by
          apply mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) h2 h0'
            (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (abs_nonneg _) hQ))
      _ = (i.choose j : ℝ) * |CP j| * |CL (i - j)| * qC B.h ξ ^ B.h := by ring

  have hInM : InM B (qsOf l0) (α + 1) (fun ξ => m ξ * nrm B e f ξ) := by
    refine ⟨hms.mul hF.1, ?_, ?_, ?_⟩
    · intro ξ hξ a ha
      show m (shY ξ a) * nrm B e f (shY ξ a) = m ξ * nrm B e f ξ
      rw [hF.2.1 ξ hξ a ha, hmdeck ξ a]
    · intro ξ hξ hX
      show m ξ * nrm B e f ξ = 0
      rw [hF.2.2.1 ξ hξ hX, mul_zero]
    · intro k
      choose Cc bb dd hCbd using hF.2.2.2
      obtain ⟨Bb, hBb⟩ : ∃ x : ℝ, x = ∑ i ∈ Finset.range (k + 1), |bb i| := ⟨_, rfl⟩
      obtain ⟨Dd, hDd⟩ : ∃ x : ℝ, x = ∑ i ∈ Finset.range (k + 1), |dd i| := ⟨_, rfl⟩
      refine ⟨∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |KM i| * |Cc (k - i)|, Bb, Dd, ?_⟩
      intro ξ hξ hX1 hX2
      have hq0 := hqpos ξ hξ
      have hP : 0 ≤ qC B.h ξ ^ (B.h * α) := Real.rpow_nonneg hq0.le _
      have hQ : 0 ≤ qC B.h ξ ^ B.h := Real.rpow_nonneg hq0.le _
      have hL1 : 1 ≤ 1 + |Real.log (qC B.h ξ)| := by
        have := abs_nonneg (Real.log (qC B.h ξ)); linarith
      have hS1 : 1 ≤ SC B.h ξ := by
        show 1 ≤ (1 + |Real.log (qC B.h ξ)|) ^ 2
        exact one_le_pow₀ hL1
      have hEW0 : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
        unfold edgeWeight; split_ifs
        · exact (Real.exp_pos _).le
        · exact le_rfl
      have hX0 : 0 < XC B.h ξ := lt_trans hXa hX1
      have hED0 : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) :=
        lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
          (Real.log_pos ((one_lt_div hX0).mpr hX2)))
      have hED1 : edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := min_le_left _ _
      have hSB0 : 0 ≤ SC B.h ξ ^ Bb := Real.rpow_nonneg (by linarith) _
      obtain ⟨X, hX⟩ : ∃ x : ℝ, x = qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ Bb *
          edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-Dd) :=
        ⟨_, rfl⟩
      have hFi : ∀ i ∈ Finset.range (k + 1), NB B.h (nrm B e f) i ξ ≤ |Cc i| * X := by
        intro i hi
        have hbi : bb i ≤ Bb := by
          rw [hBb]
          exact le_trans (le_abs_self _)
            (Finset.single_le_sum (f := fun i => |bb i|) (fun i _ => abs_nonneg _) hi)
        have hdi : dd i ≤ Dd := by
          rw [hDd]
          exact le_trans (le_abs_self _)
            (Finset.single_le_sum (f := fun i => |dd i|) (fun i _ => abs_nonneg _) hi)
        have h1 : SC B.h ξ ^ bb i ≤ SC B.h ξ ^ Bb := Real.rpow_le_rpow_of_exponent_le hS1 hbi
        have h2 : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd i) ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-Dd) :=
          Real.rpow_le_rpow_of_exponent_ge hED0 hED1 (by linarith)
        have h1' : 0 ≤ SC B.h ξ ^ bb i := Real.rpow_nonneg (by linarith) _
        have h2' : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd i) := Real.rpow_nonneg hED0.le _
        calc NB B.h (nrm B e f) i ξ
            ≤ Cc i * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bb i *
                edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd i) :=
              hCbd i ξ hξ hX1 hX2
          _ = Cc i * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bb i *
                edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd i)) := by
              ring
          _ ≤ |Cc i| * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ Bb *
                edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-Dd)) := by
              apply mul_le_mul (le_abs_self _) _
                (mul_nonneg (mul_nonneg (mul_nonneg hP h1') hEW0) h2') (abs_nonneg _)
              exact mul_le_mul (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left h1 hP) hEW0) h2 h2'
                (mul_nonneg (mul_nonneg hP hSB0) hEW0)
          _ = |Cc i| * X := by rw [hX]
      have hLe := nb_mul_le_v4 B.h (DomC B.h (qsOf l0)) m (nrm B e f) hDo hms hF.1 ξ hξ k
      calc NB B.h (fun ξ => m ξ * nrm B e f ξ) k ξ
          ≤ ∑ i ∈ Finset.range (k + 1),
              (k.choose i : ℝ) * NB B.h m i ξ * NB B.h (nrm B e f) (k - i) ξ := hLe
        _ ≤ ∑ i ∈ Finset.range (k + 1),
              ((k.choose i : ℝ) * |KM i| * |Cc (k - i)|) * (qC B.h ξ ^ B.h * X) := by
            apply Finset.sum_le_sum
            intro i hi
            have hki : k - i ∈ Finset.range (k + 1) := Finset.mem_range.mpr (by omega)
            have hm1 : NB B.h m i ξ ≤ |KM i| * qC B.h ξ ^ B.h :=
              le_trans (hmB i ξ hξ hX1 hX2) (mul_le_mul_of_nonneg_right (le_abs_self _) hQ)
            have hf1 := hFi (k - i) hki
            have hmm := mul_le_mul hm1 hf1 (norm_nonneg _) (mul_nonneg (abs_nonneg _) hQ)
            calc (k.choose i : ℝ) * NB B.h m i ξ * NB B.h (nrm B e f) (k - i) ξ
                = (k.choose i : ℝ) * (NB B.h m i ξ * NB B.h (nrm B e f) (k - i) ξ) := by ring
              _ ≤ (k.choose i : ℝ) * ((|KM i| * qC B.h ξ ^ B.h) * (|Cc (k - i)| * X)) :=
                  mul_le_mul_of_nonneg_left hmm (Nat.cast_nonneg _)
              _ = ((k.choose i : ℝ) * |KM i| * |Cc (k - i)|) * (qC B.h ξ ^ B.h * X) := by ring
        _ = (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |KM i| * |Cc (k - i)|) *
              (qC B.h ξ ^ B.h * X) := by rw [← Finset.sum_mul]
        _ = (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |KM i| * |Cc (k - i)|) *
              qC B.h ξ ^ (B.h * (α + 1)) * SC B.h ξ ^ Bb *
              edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-Dd) := by
            rw [hX, show B.h * (α + 1) = B.h * α + B.h by ring, Real.rpow_add hq0]
            ring

  refine hMc (α + 1) (α + 1) (α + 1) 1 0 _ _ _ hInM hInM le_rfl le_rfl ?_
  intro ξ hξ
  have hq0 := hqpos ξ hξ
  have hr := hrep ξ (hDsub hξ)
  have hmξ : m ξ = qC B.h ξ ^ B.h * (2 * XC B.h ξ) ^ (-(1/2:ℝ)) *
      logLift B.Vb (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) := by
    subst hm hPf hLf hφdef
    rfl
  show qC B.h ξ ^ (e + Aex B.h) * (ubase B ξ 0 * f ξ) =
    1 * (m ξ * (qC B.h ξ ^ e * f ξ)) + 0 * (m ξ * (qC B.h ξ ^ e * f ξ))
  rw [hmξ, ← hr, Real.rpow_add hq0]
  ring

theorem tdg_qshift_v5 : ∀ (B : BG) (qs : ℝ), B.ok → SimNorm B.h → 0 < qs → qs ≤ 1 → ∀ (α e s : ℝ) (f : Cyl → ℝ), InM B qs α (nrm B e f) → InM B qs (α + s) (nrm B (e + B.h * s) f) :=
by
  intro B qs hok hSN hqs0 hqs1 α₀ e₀ s₀ f₀ hf₀
  suffices hgen : ∀ (c e α : ℝ) (f : Cyl → ℝ), InM B qs α f →
      InM B qs (α + (c + e / 2) / B.h) (fun η => qC B.h η ^ c * η.1 ^ e * f η) by
    have hh : 0 < B.h := hok.2.1.1
    have hA := hgen (B.h * s₀) 0 α₀ (nrm B e₀ f₀) hf₀
    have hord : α₀ + (B.h * s₀ + 0 / 2) / B.h = α₀ + s₀ := by
      rw [zero_div, add_zero, mul_div_cancel_left₀ s₀ hh.ne']
    rw [hord] at hA
    have hS : SimScaleProps B.h := hok.1
    have hU : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
    have hqCU : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
      have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
        hS.2.2.2.1
      have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
        (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
      exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
        ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
    have hqposU : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
      (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
    have hDsub : DomC B.h qs ⊆ {η : Cyl | η.2.2.1 < 1} := fun η hη => hη.2.1
    have hDo : IsOpen (DomC B.h qs) := by
      have h1 : IsOpen ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Set.Iio qs) :=
        hqCU.continuousOn.isOpen_inter_preimage hU isOpen_Iio
      have h2 : IsOpen {η : Cyl | 0 < η.1} := isOpen_lt continuous_const continuous_fst
      have e : DomC B.h qs =
          {η : Cyl | 0 < η.1} ∩ ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Set.Iio qs) := by
        ext η
        simp only [DomC, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iio]
      rw [e]; exact h2.inter h1
    have heq : ∀ η ∈ DomC B.h qs, nrm B (e₀ + B.h * s₀) f₀ η =
        qC B.h η ^ (B.h * s₀) * η.1 ^ (0:ℝ) * nrm B e₀ f₀ η := by
      intro η hη
      simp only [nrm]
      rw [Real.rpow_add (hqposU η (hDsub hη)) e₀ (B.h * s₀), Real.rpow_zero]
      ring
    obtain ⟨A1, A2, A3, A4⟩ := hA
    refine ⟨A1.congr heq, ?_, ?_, ?_⟩
    · intro ξ hξ a ha
      have h1 : qC B.h ξ ^ e₀ * f₀ (shY ξ a) = qC B.h ξ ^ e₀ * f₀ ξ := hf₀.2.1 ξ hξ a ha
      have h2 : f₀ (shY ξ a) = f₀ ξ :=
        mul_left_cancel₀ (Real.rpow_pos_of_pos (hqposU ξ (hDsub hξ)) _).ne' h1
      show qC B.h ξ ^ (e₀ + B.h * s₀) * f₀ (shY ξ a) = qC B.h ξ ^ (e₀ + B.h * s₀) * f₀ ξ
      rw [h2]
    · intro ξ hξ hX
      rw [heq ξ hξ]
      exact A3 ξ hξ hX
    · intro k
      obtain ⟨C, b, d, hC⟩ := A4 k
      refine ⟨C, b, d, fun ξ hξ hX1 hX2 => ?_⟩
      have hev : nrm B (e₀ + B.h * s₀) f₀ =ᶠ[nhds ξ]
          (fun η => qC B.h η ^ (B.h * s₀) * η.1 ^ (0:ℝ) * nrm B e₀ f₀ η) :=
        Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) heq
      have hNB : NB B.h (nrm B (e₀ + B.h * s₀) f₀) k ξ =
          NB B.h (fun η => qC B.h η ^ (B.h * s₀) * η.1 ^ (0:ℝ) * nrm B e₀ f₀ η) k ξ := by
        unfold NB
        rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      rw [hNB]
      exact hC ξ hξ hX1 hX2
  intro c e α f hf
  have hS : SimScaleProps B.h := hok.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1

  have key : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (F : E → G) (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  have hU : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
  have hqCU : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqposU : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hDsub : DomC B.h qs ⊆ {η : Cyl | η.2.2.1 < 1} := fun η hη => hη.2.1
  have hDo : IsOpen (DomC B.h qs) := by
    have h1 : IsOpen ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Set.Iio qs) :=
      hqCU.continuousOn.isOpen_inter_preimage hU isOpen_Iio
    have h2 : IsOpen {η : Cyl | 0 < η.1} := isOpen_lt continuous_const continuous_fst
    have e : DomC B.h qs =
        {η : Cyl | 0 < η.1} ∩ ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Set.Iio qs) := by
      ext η
      simp only [DomC, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iio]
    rw [e]; exact h2.inter h1
  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) (DomC B.h qs) := hqCU.mono hDsub
  have hqpos : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ := fun ξ hξ => hqposU ξ (hDsub hξ)

  have hmul : ∀ (U : Set Cyl) (f g : Cyl → ℝ), IsOpen U → ContDiffOn ℝ ∞ f U →
      ContDiffOn ℝ ∞ g U → ∀ ξ ∈ U, ∀ k : ℕ,
        NB B.h (fun η => f η * g η) k ξ ≤
          ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB B.h f i ξ * NB B.h g (k - i) ξ := by
    intro U f g hU' hf hg ξ hξ k
    have hfg : ContDiffOn ℝ ∞ (fun η => f η * g η) U := hf.mul hg
    have kf := key f U ξ (Lnorm B.h ξ) hU' hf hξ
    have kg := key g U ξ (Lnorm B.h ξ) hU' hg hξ
    have kfg := key (fun η => f η * g η) U ξ (Lnorm B.h ξ) hU' hfg hξ k
    unfold NB
    obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = (fun v => ξ + Lnorm B.h ξ v) ⁻¹' U := ⟨_, rfl⟩
    have hO : IsOpen O := by
      rw [hOdef]; exact hU'.preimage (continuous_const.add (Lnorm B.h ξ).continuous)
    have h0O : (0 : Cyl) ∈ O := by
      rw [hOdef]; show ξ + Lnorm B.h ξ 0 ∈ U; rw [map_zero, add_zero]; exact hξ
    have hsmO : ∀ F : Cyl → ℝ, ContDiffOn ℝ ∞ F U →
        ContDiffOn ℝ ∞ (fun z => F (ξ + Lnorm B.h ξ z)) O := by
      intro F hF
      exact hF.comp (contDiff_const.add (Lnorm B.h ξ).contDiff).contDiffOn
        (fun z hz => by rw [hOdef] at hz; exact hz)
    have leib := norm_iteratedFDerivWithin_mul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
      (n := k) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen
      (f := fun y => f (ξ + Lnorm B.h ξ y) * g (ξ + Lnorm B.h ξ y)) k hO h0O] at leib
    rw [← kfg]
    calc ‖iteratedFDeriv ℝ k (fun z => (fun η => f η * g η) (ξ + Lnorm B.h ξ z)) 0‖
        = ‖iteratedFDeriv ℝ k (fun y => f (ξ + Lnorm B.h ξ y) * g (ξ + Lnorm B.h ξ y)) 0‖ := rfl
      _ ≤ _ := leib
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i _
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + Lnorm B.h ξ z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + Lnorm B.h ξ z)) (k - i) hO h0O,
          kf i, kg (k - i)]

  have hqpow : ∀ (c : ℝ) (j : ℕ), ∃ C : ℝ, ∀ ξ ∈ DomC B.h qs,
      NB B.h (fun η => qC B.h η ^ c) j ξ ≤ C * qC B.h ξ ^ c := by
    intro c j
    have hN := hSN
    unfold SimNorm at hN
    choose C hC using hN
    obtain ⟨A, hAdef⟩ : ∃ A : ℝ,
