    have hTg : (0:ℝ) < Tgc := by unfold Tgc; positivity
    have hκ : 0 < cib h γ.1 := by
      unfold cib
      have hQ : (0:ℝ) < Qb γ.1 := by unfold Qb; positivity
      exact mul_pos (zpow_pos hTg _) (Real.rpow_pos_of_pos hQ _)
    have hvtv1 : ∀ (w : ℝ × ℝ) (a : ℝ), (w + a • vtv).1 = w.1 + a * bgc := by
      intro w a; simp [vtv]
    have hvtv2 : ∀ (w : ℝ × ℝ) (a : ℝ), (w + a • vtv).2 = w.2 + a := by
      intro w a; simp [vtv]
    have s1 : ∀ (w : ℝ × ℝ) (a : ℝ), lamR (w + a • vtv) = lamR w ∧ lamT (w + a • vtv) = lamT w + a := by
      intro w a
      unfold lamR lamT
      rw [hvtv1, hvtv2]
      constructor
      · congr 1; ring
      · field_simp; ring
    have s2 : ∀ (n : ℤ) (Z : ℝ × ℝ) (a : ℝ), Jpow n (Z + a • vtv) = Jpow n Z + (Tgc ^ n * a) • vtv := by
      intro n Z a
      have hc1 : (Z.1 + a * bgc - bgc * (Z.2 + a)) / (1 + bgc ^ 2) = (Z.1 - bgc * Z.2) / (1 + bgc ^ 2) := by
        congr 1; ring
      have hc2 : (bgc * (Z.1 + a * bgc) + (Z.2 + a)) / (1 + bgc ^ 2) =
          (bgc * Z.1 + Z.2) / (1 + bgc ^ 2) + a := by
        field_simp; ring
      unfold Jpow
      rw [hvtv1, hvtv2, hc1, hc2, mul_add, add_smul]
      abel
    have hround : ∀ (x : ℝ) (m : ℤ), |x - m| < 1/2 → round x = m := by
      intro x m hx
      obtain ⟨h1, h2⟩ := abs_lt.mp hx
      rw [round_eq, Int.floor_eq_iff]
      constructor <;> linarith
    obtain ⟨k, hk⟩ : ∃ k : ℝ × ℝ, k = (((round (Jpow (bandIdx h γ.1) Y - c).1 : ℤ) : ℝ),
        ((round (Jpow (bandIdx h γ.1) Y - c).2 : ℤ) : ℝ)) := ⟨_, rfl⟩
    have hk1 : k.1 = ((round (Jpow (bandIdx h γ.1) Y - c).1 : ℤ) : ℝ) := by rw [hk]
    have hk2 : k.2 = ((round (Jpow (bandIdx h γ.1) Y - c).2 : ℤ) : ℝ) := by rw [hk]
    obtain ⟨w, hwdef⟩ : ∃ w : ℝ × ℝ, w = Jpow (bandIdx h γ.1) Y - c - k := ⟨_, rfl⟩
    have hw : rectW h γ c Y = w := by
      rw [hwdef]
      unfold rectW frac0
      ext
      · simp only [Prod.fst_sub, hk1]
      · simp only [Prod.snd_sub, hk2]
    have hR1 : |lamR w| ≤ r0 := by have := hR.1; unfold xiG at this; rwa [hw] at this
    have hR2 : |lamT w| ≤ r0 := by have := hR.2; unfold etG at this; rwa [hw] at this
    have hvs : vco h r0 γ c Y = (lamT w + r0) / cib h γ.1 := by unfold vco etG; rw [hw]
    have hunit : Tgc ^ (bandIdx h γ.1) * Tgc ^ (-(bandIdx h γ.1)) = 1 := by
      rw [zpow_neg, mul_inv_cancel₀ (zpow_ne_zero _ hTg.ne')]
    have hτκ : (v - vco h r0 γ c Y) * cib h γ.1 = v * cib h γ.1 - (lamT w + r0) := by
      rw [hvs, sub_mul, div_mul_cancel₀ _ hκ.ne']
    generalize hPdef : Y + (v - vco h r0 γ c Y) • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv) = P
    have hJ : Jpow (bandIdx h γ.1) P - c - k = w + ((v - vco h r0 γ c Y) * cib h γ.1) • vtv := by
      rw [← hPdef, smul_smul, s2, hwdef]
      have e : Tgc ^ (bandIdx h γ.1) * ((v - vco h r0 γ c Y) * (cib h γ.1 * Tgc ^ (-(bandIdx h γ.1)))) =
          (v - vco h r0 γ c Y) * cib h γ.1 := by
        linear_combination ((v - vco h r0 γ c Y) * cib h γ.1) * hunit
      rw [e]
      abel
    obtain ⟨l1, l2⟩ := s1 w ((v - vco h r0 γ c Y) * cib h γ.1)
    have hvk1 : v * cib h γ.1 ≤ 2 * r0 := by
      have := hvL; unfold Lsb at this; exact (le_div_iff₀ hκ).1 this
    have hvk0 : 0 ≤ v * cib h γ.1 := mul_nonneg hv0 hκ.le
    have hWR : |lamR (w + ((v - vco h r0 γ c Y) * cib h γ.1) • vtv)| ≤ r0 := by rw [l1]; exact hR1
    have hWT : lamT (w + ((v - vco h r0 γ c Y) * cib h γ.1) • vtv) = v * cib h γ.1 - r0 := by
      rw [l2, hτκ]; ring
    have hWT' : |lamT (w + ((v - vco h r0 γ c Y) * cib h γ.1) • vtv)| ≤ r0 := by
      rw [hWT, abs_le]; constructor <;> linarith
    have s3 : ∀ w' : ℝ × ℝ, |lamR w'| ≤ r0 → |lamT w'| ≤ r0 → |w'.1| < 1/2 ∧ |w'.2| < 1/2 := by
      intro w' h1 h2
      have r1 : w'.1 = lamR w' + bgc * lamT w' := by unfold lamR lamT; field_simp; ring
      have r2 : w'.2 = -bgc * lamR w' + lamT w' := by unfold lamR lamT; field_simp; ring
      have t1 : |bgc * lamT w'| ≤ r0 := by
        rw [abs_mul, abs_of_nonneg hb0]
        calc bgc * |lamT w'| ≤ 1 * |lamT w'| := mul_le_mul_of_nonneg_right hb1 (abs_nonneg _)
          _ ≤ r0 := by rw [one_mul]; exact h2
      have t2 : |-bgc * lamR w'| ≤ r0 := by
        rw [abs_mul, abs_neg, abs_of_nonneg hb0]
        calc bgc * |lamR w'| ≤ 1 * |lamR w'| := mul_le_mul_of_nonneg_right hb1 (abs_nonneg _)
          _ ≤ r0 := by rw [one_mul]; exact h1
      constructor
      · rw [r1]
        calc |lamR w' + bgc * lamT w'| ≤ |lamR w'| + |bgc * lamT w'| := abs_add_le _ _
          _ < 1/2 := by linarith
      · rw [r2]
        calc |-bgc * lamR w' + lamT w'| ≤ |-bgc * lamR w'| + |lamT w'| := abs_add_le _ _
          _ < 1/2 := by linarith
    obtain ⟨c1, c2⟩ := s3 (Jpow (bandIdx h γ.1) P - c - k) (by rw [hJ]; exact hWR) (by rw [hJ]; exact hWT')
    have d1 : |(Jpow (bandIdx h γ.1) P - c).1 - k.1| < 1/2 := by
      simpa only [Prod.fst_sub] using c1
    have d2 : |(Jpow (bandIdx h γ.1) P - c).2 - k.2| < 1/2 := by
      simpa only [Prod.snd_sub] using c2
    have hPw0 : rectW h γ c P = Jpow (bandIdx h γ.1) P - c - k := by
      rw [hk1] at d1
      rw [hk2] at d2
      have q1 := hround _ _ d1
      have q2 := hround _ _ d2
      unfold rectW frac0
      rw [q1, q2]
      ext
      · simp only [Prod.fst_sub, hk1]
      · simp only [Prod.snd_sub, hk2]
    have hPw : rectW h γ c P = w + ((v - vco h r0 γ c Y) * cib h γ.1) • vtv := hPw0.trans hJ
    refine ⟨?_, ?_⟩
    · unfold vco etG
      rw [hPw, hWT, sub_add_cancel, mul_div_cancel_right₀ _ hκ.ne']
    · show |xiG h γ c P| ≤ r0 ∧ |etG h γ c P| ≤ r0
      unfold xiG etG
      rw [hPw]
      exact ⟨hWR, hWT'⟩
  intro h r0 γ c v hr0 hr1 hv
  obtain ⟨hY0, hline⟩ := pulse_line_base5 h r0 γ c hr0 hr1
  have hEq4 := congrArg (fun z : Cyl => z.2.2.2) (hline ((0:ℝ), (0:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ))) v)
  have hEq : Jpow (-(bandIdx h γ.1)) (c - r0 • vtv) + (v - vco h r0 γ c (Jpow (-(bandIdx h γ.1)) (c - r0 • vtv))) •
      ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv) =
      Jpow (-(bandIdx h γ.1)) (c + (v * cib h γ.1 - r0) • vtv) := by
    simpa [dVdir] using hEq4
  obtain ⟨hvco, hrect⟩ := pulse_line_rect5 h r0 γ c _ hr0 hr1 hY0 v hv.1 hv.2
  rw [hEq] at hvco hrect
  have hrect' : |xiG h γ c (Jpow (-(bandIdx h γ.1)) (c + (v * cib h γ.1 - r0) • vtv))| ≤ r0 ∧
      |etG h γ c (Jpow (-(bandIdx h γ.1)) (c + (v * cib h γ.1 - r0) • vtv))| ≤ r0 := hrect
  refine ⟨hrect, hvco, ?_, ?_⟩
  · linarith [hrect'.1]
  · linarith [hrect'.2]

theorem pulse5_slice_model_v5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (v : ℝ), B.ok → 0 < G.r0 → G.r0 ≤ 1/100 → v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1) → ∀ s : ℝ × ℝ × ℝ, ((s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) : Cyl) ∈ DomC B.h B.qB → nPhi5 B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) = pcN5 B G γ s v ∧ nPhiP5 B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) = -pcPsi5 B G γ s ∧ Kmat B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) = pcKm5 B γ.1 s ∧ APhi5 B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) - dDamp5 B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) • (1 : Matrix (Fin 3) (Fin 3) ℝ) = pcM5 B G γ s v ∧ (v = 0 → Bcol5 B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) 1 = (![1, 0, 0] - (pcN5 B G γ s 0 0 / pcNt5 B G γ s) • pcKa5 B G γ s) + (1 * c0f5 B G γ * Real.sqrt (1 + sco B G γ 0 ^ 2)) • ![0, pcKa5 B G γ s 2, -(pcKa5 B G γ s 1)]) :=
by
  intro B G γ v hB hr0 hr1 hv s hη
  obtain ⟨-, hvco, hxi, het⟩ := pulse5_point_rect B.h G.r0 γ (G.ctr γ) v hr0 hr1 hv
  have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have hsq : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr hQ

  have hA : ∀ t : ℝ × ℝ × ℝ, pcA5 B G γ t 0 = sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 ∧
      pcA5 B G γ t 2 = pzr5 B G γ := by
    intro t
    obtain ⟨a, ha⟩ : ∃ a : ℝ, a = pzr5 B G γ / Qb γ.1 ^ (1/2 - B.h) / epsb B.h γ.1 := ⟨_, rfl⟩
    obtain ⟨b, hb⟩ : ∃ b : ℝ, b = sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 / Real.sqrt (Qb γ.1) :=
      ⟨_, rfl⟩
    let Λ : (ℝ × ℝ × ℝ) →L[ℝ] ℝ :=
      a • ((ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))) +
        b • ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)
    have hΛx : ∀ x : ℝ × ℝ × ℝ, Λ x = a * x.2.1 + b * x.1 := by
      intro x
      simp [Λ]
    have hΛ : pcPhi1_5 B G γ = ⇑Λ := by
      funext x
      rw [hΛx]
      simp only [pcPhi1_5, pcRC5]
      rw [ha, hb]
      ring
    have hd : fderiv ℝ (pcPhi1_5 B G γ) t = Λ := by rw [hΛ]; exact Λ.fderiv
    have he : Qb γ.1 ^ (1/2 - B.h) * epsb B.h γ.1 = Real.sqrt (Qb γ.1) := by
      unfold epsb
      rw [← Real.rpow_add hQ, Real.sqrt_eq_rpow]
      congr 1
      ring
    constructor
    · show Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi1_5 B G γ) t ((1:ℝ), (0:ℝ), (0:ℝ)) = _
      rw [hd, hΛx]
      simp only [mul_zero, mul_one, zero_add]
      rw [hb]
      field_simp
    · show Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi1_5 B G γ) t ((0:ℝ), (1:ℝ), (0:ℝ)) = _
      rw [hd, hΛx]
      simp only [mul_zero, mul_one, add_zero]
      rw [ha, div_div, he]
      field_simp
  obtain ⟨s1, s2, s3⟩ := s
  dsimp only at hη ⊢
  generalize hYd : Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv) = Y at hvco hxi het hη ⊢
  obtain ⟨U, c, -, hηU, -, hU⟩ := nPhi5_local_model_v5 B G γ (s1, s2, s3, Y) hB hη hxi het
  have hN0 := (hU _ hηU).2
  obtain ⟨U', -, hηU', -, hU'⟩ := nPhiP5_local_model_v5 B G γ (s1, s2, s3, Y) hB hη hxi het
  have hNP0 := hU' _ hηU'
  have hK : Kmat B G γ (s1, s2, s3, Y) = pcKm5 B γ.1 (s1, s2, s3) := kmat_slow_form_v5 B G γ hB _ hη
  dsimp only at hN0 hNP0
  rw [hvco] at hN0
  obtain ⟨hA0, hA2⟩ := hA (s1, s2, s3)
  have hN : nPhi5 B G γ (s1, s2, s3, Y) = pcN5 B G γ (s1, s2, s3) v := by
    rw [hN0]
    funext i
    fin_cases i
    · show sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 - v * (Real.sqrt (Qb γ.1) *
          fderiv ℝ (pcPhi2_5 B G γ) (s1, s2, s3) ((1:ℝ), (0:ℝ), (0:ℝ))) =
          pcA5 B G γ (s1, s2, s3) 0 - v * pcPsi5 B G γ (s1, s2, s3) 0
      rw [hA0]
      rfl
    · show pang5 B G γ / RC γ.1 (s1, s2, s3, Y) = pang5 B G γ / pcRC5 γ.1 (s1, s2, s3) - v * 0
      rw [mul_zero, sub_zero]
      rfl
    · show pzr5 B G γ - v * (Real.sqrt (Qb γ.1) *
          fderiv ℝ (pcPhi2_5 B G γ) (s1, s2, s3) ((0:ℝ), (1:ℝ), (0:ℝ))) =
          pcA5 B G γ (s1, s2, s3) 2 - v * pcPsi5 B G γ (s1, s2, s3) 2
      rw [hA2]
      rfl
  have hNP : nPhiP5 B G γ (s1, s2, s3, Y) = -pcPsi5 B G γ (s1, s2, s3) := by
    rw [hNP0]
    funext i
    fin_cases i
    · rfl
    · show (0:ℝ) = -(0:ℝ)
      rw [neg_zero]
    · rfl
  have hM : APhi5 B G γ (s1, s2, s3, Y) - dDamp5 B G γ (s1, s2, s3, Y) • (1 : Matrix (Fin 3) (Fin 3) ℝ) =
      pcM5 B G γ (s1, s2, s3) v := by
    unfold APhi5 dDamp5 pcM5
    rw [hN, hNP, hK]
  refine ⟨hN, hNP, hK, hM, ?_⟩
  intro hv0
  subst hv0
  simp only [Bcol5, ntan5, hN, hvco]
  rfl

theorem pulse5_slow_smooth_v5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab), B.ok → (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun s : ℝ × ℝ × ℝ => pcA5 B G γ s i) {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}) ∧ (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun s : ℝ × ℝ × ℝ => pcPsi5 B G γ s i) {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}) ∧ (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun s : ℝ × ℝ × ℝ => pcKm5 B γ.1 s i j) {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}) ∧ ∀ v : ℝ, ContDiffOn ℝ ∞ (fun s : ℝ × ℝ × ℝ => fun i j : Fin 3 => pcM5 B G γ s v i j) {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} :=
by
  intro B G γ hB
  have hSlow : IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} ∧
      ∀ (l : ℕ) (i : Fin 3), ContDiffOn ℝ ∞ (fun s : ℝ × ℝ × ℝ => baseC B l (s.1, s.2.1, s.2.2, ((0:ℝ), (0:ℝ))) i)
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
    obtain ⟨hS, hBP⟩ := hB
    have hsc : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1.continuousOn
    have hA : IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
      have hm : Continuous (fun s : ℝ × ℝ × ℝ => (s.2.1, 1 - s.2.2)) := by fun_prop
      have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun s : ℝ × ℝ × ℝ => (s.2.1, 1 - s.2.2)))
          {s : ℝ × ℝ × ℝ | s.2.2 < 1} := by
        refine hsc.comp hm.continuousOn ?_
        intro s hs
        have hs' : s.2.2 < 1 := hs
        exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - s.2.2 by linarith⟩
      have hU : IsOpen {s : ℝ × ℝ × ℝ | s.2.2 < 1} := isOpen_lt (by fun_prop) continuous_const
      have h1 := hc.isOpen_inter_preimage hU (isOpen_Iio (a := B.qB))
      have h2 : IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1} := isOpen_lt continuous_const continuous_fst
      have e : {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} =
          {s : ℝ × ℝ × ℝ | 0 < s.1} ∩ ({s : ℝ × ℝ × ℝ | s.2.2 < 1} ∩
            ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun s : ℝ × ℝ × ℝ => (s.2.1, 1 - s.2.2))) ⁻¹'
              Set.Iio B.qB) := by
        ext s
        simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iio, Function.comp]
      rw [e]
      exact h2.inter h1
    have hD : IsOpen (simDomain B.h B.qB) := by
      have hm : Continuous (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)) := by fun_prop
      have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)))
          {w : ℝ³ × ℝ | w.2 < 1} := by
        refine hsc.comp hm.continuousOn ?_
        intro w hw
        have hw' : w.2 < 1 := hw
        exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - w.2 by linarith⟩
      have hU : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
      have h1 := hc.isOpen_inter_preimage hU (isOpen_Iio (a := B.qB))
      have e : simDomain B.h B.qB = {w : ℝ³ × ℝ | w.2 < 1} ∩
          ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2))) ⁻¹' Set.Iio B.qB := by
        ext w
        simp only [simDomain, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iio, Function.comp]
      rw [e]
      exact h1
    have hu : ContDiffOn ℝ ∞ (↿(uB B)) (simDomain B.h B.qB) := by
      have hAB : ContDiffOn ℝ ∞ (↿B.AB) (simDomain B.h B.qB) := hBP.2.2.2.1.1
      have hBv : ContDiffOn ℝ ∞ (↿B.BvB) (simDomain B.h B.qB) := hBP.2.2.2.1.2.1
      have hDA : ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z) (simDomain B.h B.qB) :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hAB).2
      have hc : ∀ (v : ℝ³) (j : Fin 3),
          ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z (v, (0:ℝ)) j) (simDomain B.h B.qB) := by
        intro v j
        have h1 : ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z (v, (0:ℝ))) (simDomain B.h B.qB) :=
          hDA.clm_apply contDiffOn_const
        exact (EuclideanSpace.proj j : ℝ³ →L[ℝ] ℝ).contDiff.comp_contDiffOn h1
      let e0 : ℝ³ := EuclideanSpace.single 0 1
      let e1 : ℝ³ := EuclideanSpace.single 1 1
      let e2 : ℝ³ := EuclideanSpace.single 2 1
      have hg : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ =>
          (fderiv ℝ (↿B.AB) z (e1, (0:ℝ)) 2 - fderiv ℝ (↿B.AB) z (e2, (0:ℝ)) 1) •
              EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
          (fderiv ℝ (↿B.AB) z (e2, (0:ℝ)) 0 - fderiv ℝ (↿B.AB) z (e0, (0:ℝ)) 2) •
              EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
          (fderiv ℝ (↿B.AB) z (e0, (0:ℝ)) 1 - fderiv ℝ (↿B.AB) z (e1, (0:ℝ)) 0) •
              EuclideanSpace.single (2 : Fin 3) (1 : ℝ) + (↿B.BvB) z) (simDomain B.h B.qB) := by
        refine ((((hc e1 2).sub (hc e2 1)).smul contDiffOn_const).add
          (((hc e2 0).sub (hc e0 2)).smul contDiffOn_const)).add
          (((hc e0 1).sub (hc e1 0)).smul contDiffOn_const) |>.add hBv
      refine hg.congr ?_
      rintro ⟨y, s⟩ hz
      have hdiff : DifferentiableAt ℝ (↿B.AB) (y, s) :=
        (hAB.contDiffAt (hD.mem_nhds hz)).differentiableAt (by norm_num)
      have hpart : fderiv ℝ (fun w => B.AB w s) y =
          (fderiv ℝ (↿B.AB) (y, s)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := by
        have h1 : HasFDerivAt (fun w : ℝ³ => (w, s)) (ContinuousLinearMap.inl ℝ ℝ³ ℝ) y :=
          hasFDerivAt_prodMk_left y s
        have h2 : HasFDerivAt ((↿B.AB) ∘ (fun w : ℝ³ => (w, s)))
            ((fderiv ℝ (↿B.AB) (y, s)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ)) y :=
          HasFDerivAt.comp (g := ↿B.AB) y hdiff.hasFDerivAt h1
        exact h2.fderiv
      show curl3 (fun w => B.AB w s) y + B.BvB y s = _
      unfold curl3
      rw [hpart]
      simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.inl_apply]
      rfl
    have frame : ∀ r z : ℝ, 0 < r → (rotPt r 0 z) 2 = z ∧
        eR (rotPt r 0 z) = EuclideanSpace.single (0 : Fin 3) (1 : ℝ) ∧
        eTh (rotPt r 0 z) = EuclideanSpace.single (1 : Fin 3) (1 : ℝ) := by
      intro r z hr
      have h0 : (rotPt r 0 z) 0 = r := by simp [rotPt]
      have h1 : (rotPt r 0 z) 1 = 0 := by simp [rotPt]
      have h2 : (rotPt r 0 z) 2 = z := by simp [rotPt]
      have hrad : rad (rotPt r 0 z) = r := by
        unfold rad
        rw [h0, h1]
        simp [Real.sqrt_sq hr.le]
      refine ⟨h2, ?_, ?_⟩
      · unfold eR radVec
        rw [hrad, h0, h1, zero_smul, add_zero, smul_smul, inv_mul_cancel₀ hr.ne', one_smul]
      · unfold eTh azVec
        rw [hrad, h0, h1, neg_zero, zero_smul, zero_add, smul_smul, inv_mul_cancel₀ hr.ne', one_smul]
    let ψ : ℝ × ℝ × ℝ → ℝ³ × ℝ := fun s => (rotPt s.1 0 s.2.1, s.2.2)
    have hψ : ContDiff ℝ ∞ ψ := by
      have hr : ContDiff ℝ ∞ (fun s : ℝ × ℝ × ℝ => rotPt s.1 0 s.2.1) := by
        unfold rotPt
        fun_prop
      exact hr.prodMk (contDiff_snd.comp contDiff_snd)
    have hmaps : Set.MapsTo ψ {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}
        (simDomain B.h B.qB) := by
      intro s hs
      obtain ⟨h1, h2, h3⟩ := hs
      show s.2.2 < 1 ∧ simScale B.h ((rotPt s.1 0 s.2.1) 2) (1 - s.2.2) < B.qB
      rw [(frame s.1 s.2.1 h1).1]
      exact ⟨h2, h3⟩
    refine ⟨hA, fun l i => ?_⟩
    have hcomp : ContDiffOn ℝ ∞ ((↿(uB B)) ∘ ψ)
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} :=
      hu.comp hψ.contDiffOn hmaps
    have hg : ContDiffOn ℝ ∞ (fun s => Qb l ^ (1/2 + B.h) * inner ℝ (((↿(uB B)) ∘ ψ) s)
        ((![EuclideanSpace.single (0 : Fin 3) (1 : ℝ), EuclideanSpace.single (1 : Fin 3) (1 : ℝ), eZ] :
          Fin 3 → ℝ³) i))
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} :=
      contDiffOn_const.mul (ContDiffOn.inner ℝ hcomp contDiffOn_const)
    refine hg.congr ?_
    intro s hs
    obtain ⟨_, f2, f3⟩ := frame s.1 s.2.1 hs.1
    show Qb l ^ (1/2 + B.h) * inner ℝ (uB B (rotPt s.1 0 s.2.1) s.2.2)
        (![eR (rotPt s.1 0 s.2.1), eTh (rotPt s.1 0 s.2.1), eZ] i) = _
    rw [f2, f3]
    rfl
  obtain ⟨hΩ, hbase⟩ := hSlow
  set Ω := {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} with hΩe
  have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have hsQ : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr hQ
  have hkb : (0:ℝ) < (kb B.h γ.1 : ℝ) := by
    have : 0 < kb B.h γ.1 := Nat.ceil_pos.mpr (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos hQ _) _)
    exact_mod_cast this
  have hpint : pint5 B G γ ≠ 0 := by
    unfold pint5; split_ifs with h
    · exact one_ne_zero
    · exact h
  have hpang : pang5 B G γ ≠ 0 := div_ne_zero (Int.cast_ne_zero.mpr hpint) hkb.ne'
  have hRC : ∀ s ∈ Ω, pcRC5 γ.1 s ≠ 0 := fun s hs => div_ne_zero (ne_of_gt hs.1) hsQ.ne'
  have hRCs : ContDiff ℝ ∞ (pcRC5 γ.1) := by unfold pcRC5; fun_prop
  have hb : ∀ i, ContDiffOn ℝ ∞ (pcB5 B γ.1 i) Ω := fun i => hbase γ.1 i
  have hFa : ContDiffOn ℝ ∞ (pcFa5 B γ.1) Ω := (hb 1).div hRCs.contDiffOn hRC
  have hP1 : ContDiff ℝ ∞ (pcPhi1_5 B G γ) := by unfold pcPhi1_5 pcRC5; fun_prop
  have hP1on : ContDiffOn ℝ ∞ (pcPhi1_5 B G γ) Ω := hP1.contDiffOn
  have hP2 : ContDiffOn ℝ ∞ (pcPhi2_5 B G γ) Ω := (contDiffOn_const.mul hFa).add (contDiffOn_const.mul (hb 2))
  have hD : ∀ f : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ f Ω → ∀ e : ℝ × ℝ × ℝ,
      ContDiffOn ℝ ∞ (fun s => fderiv ℝ f s e) Ω := by
    intro f hf e
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hΩ).1 hf).2.clm_apply contDiffOn_const
  have hA : ∀ i, ContDiffOn ℝ ∞ (fun s => pcA5 B G γ s i) Ω := by
    intro i; fin_cases i
    · exact (contDiffOn_const.mul (hD _ hP1on _) : ContDiffOn ℝ ∞
        (fun s => Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi1_5 B G γ) s ((1:ℝ), (0:ℝ), (0:ℝ))) Ω)
    · exact (contDiffOn_const.div hRCs.contDiffOn hRC : ContDiffOn ℝ ∞
        (fun s => pang5 B G γ / pcRC5 γ.1 s) Ω)
    · exact (contDiffOn_const.mul (hD _ hP1on _) : ContDiffOn ℝ ∞
        (fun s => Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi1_5 B G γ) s ((0:ℝ), (1:ℝ), (0:ℝ))) Ω)
  have hPs : ∀ i, ContDiffOn ℝ ∞ (fun s => pcPsi5 B G γ s i) Ω := by
    intro i; fin_cases i
    · exact (contDiffOn_const.mul (hD _ hP2 _) : ContDiffOn ℝ ∞
        (fun s => Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) s ((1:ℝ), (0:ℝ), (0:ℝ))) Ω)
    · exact (contDiffOn_const : ContDiffOn ℝ ∞ (fun _ : ℝ × ℝ × ℝ => (0:ℝ)) Ω)
    · exact (contDiffOn_const.mul (hD _ hP2 _) : ContDiffOn ℝ ∞
        (fun s => Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) s ((0:ℝ), (1:ℝ), (0:ℝ))) Ω)
  have hKm : ∀ k j, ContDiffOn ℝ ∞ (fun s => pcKm5 B γ.1 s k j) Ω := by
    intro k j
    fin_cases k <;> fin_cases j <;>
    first
    | exact (contDiffOn_const : ContDiffOn ℝ ∞ (fun _ : ℝ × ℝ × ℝ => (0:ℝ)) Ω)
    | exact (contDiffOn_const.mul hFa : ContDiffOn ℝ ∞ (fun s => -2 * pcFa5 B γ.1 s) Ω)
    | exact ((contDiffOn_const.mul hFa).add (hRCs.contDiffOn.mul (contDiffOn_const.mul (hD _ hFa _))) :
        ContDiffOn ℝ ∞ (fun s => 2 * pcFa5 B γ.1 s + pcRC5 γ.1 s *
          (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) s ((1:ℝ), (0:ℝ), (0:ℝ)))) Ω)
    | exact (contDiffOn_const.mul (hD _ (hb 2) _) : ContDiffOn ℝ ∞
        (fun s => Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) s ((1:ℝ), (0:ℝ), (0:ℝ))) Ω)
  have hN1 : ∀ s v, pcN5 B G γ s v 1 = pang5 B G γ / pcRC5 γ.1 s := by
    intro s v; show pang5 B G γ / pcRC5 γ.1 s - v * 0 = _; ring
  let Mf : ℝ × ℝ × ℝ → ℝ → Fin 3 → Fin 3 → ℝ := fun s v => pcM5 B G γ s v
  have hMs : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => Mf w.1 w.2) (Ω ×ˢ Set.univ) := by
    have hmaps : Set.MapsTo Prod.fst (Ω ×ˢ (Set.univ : Set ℝ)) Ω := fun w hw => hw.1
    have hKw : ∀ k j, ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => pcKm5 B γ.1 w.1 k j) (Ω ×ˢ Set.univ) :=
      fun k j => (hKm k j).comp contDiffOn_fst hmaps
    have hPw : ∀ k, ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => pcPsi5 B G γ w.1 k) (Ω ×ˢ Set.univ) :=
      fun k => (hPs k).comp contDiffOn_fst hmaps
    have hNw : ∀ k, ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => pcN5 B G γ w.1 w.2 k) (Ω ×ˢ Set.univ) :=
      fun k => ((hA k).comp contDiffOn_fst hmaps).sub (contDiffOn_snd.mul (hPw k))
    have hdot : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ =>
        dotProduct (pcN5 B G γ w.1 w.2) (pcN5 B G γ w.1 w.2)) (Ω ×ˢ Set.univ) := by
      show ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ =>
        ∑ k, pcN5 B G γ w.1 w.2 k * pcN5 B G γ w.1 w.2 k) (Ω ×ˢ Set.univ)
      exact ContDiffOn.sum (fun k _ => (hNw k).mul (hNw k))
    have hne : ∀ w ∈ Ω ×ˢ (Set.univ : Set ℝ),
        dotProduct (pcN5 B G γ w.1 w.2) (pcN5 B G γ w.1 w.2) ≠ 0 := by
      intro w hw
      have h1 : pcN5 B G γ w.1 w.2 1 ≠ 0 := by
        rw [hN1]; exact div_ne_zero hpang (hRC _ hw.1)
      have q1 := mul_self_pos.2 h1
      have q0 := mul_self_nonneg (pcN5 B G γ w.1 w.2 0)
      have q2 := mul_self_nonneg (pcN5 B G γ w.1 w.2 2)
      rw [dotProduct, Fin.sum_univ_three]
      exact ne_of_gt (by linarith)
    have hinv := hdot.inv hne
    rw [contDiffOn_pi]; intro i; rw [contDiffOn_pi]; intro j
    have hdK : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ =>
        dotProduct (pcN5 B G γ w.1 w.2) (fun k => pcKm5 B γ.1 w.1 k j)) (Ω ×ˢ Set.univ) := by
      show ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ =>
        ∑ k, pcN5 B G γ w.1 w.2 k * pcKm5 B γ.1 w.1 k j) (Ω ×ˢ Set.univ)
      exact ContDiffOn.sum (fun k _ => (hNw k).mul (hKw k j))
    show ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => -pcKm5 B γ.1 w.1 i j +
      (dotProduct (pcN5 B G γ w.1 w.2) (pcN5 B G γ w.1 w.2))⁻¹ * (pcN5 B G γ w.1 w.2 i *
        (dotProduct (pcN5 B G γ w.1 w.2) (fun k => pcKm5 B γ.1 w.1 k j) - -pcPsi5 B G γ w.1 j)) -
      epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * dotProduct (pcN5 B G γ w.1 w.2) (pcN5 B G γ w.1 w.2) *
        (1 : Matrix (Fin 3) (Fin 3) ℝ) i j) (Ω ×ˢ Set.univ)
    exact (((hKw i j).neg).add (hinv.mul ((hNw i).mul (hdK.sub (hPw j).neg)))).sub
      ((contDiffOn_const.mul hdot).mul contDiffOn_const)
  refine ⟨hA, hPs, hKm, fun v => ?_⟩
  have hι : ContDiff ℝ ∞ (fun s : ℝ × ℝ × ℝ => (s, v)) := contDiff_id.prodMk contDiff_const
  have hmaps' : Set.MapsTo (fun s : ℝ × ℝ × ℝ => (s, v)) Ω (Ω ×ˢ Set.univ) :=
    fun s hs => ⟨hs, Set.mem_univ v⟩
  have hc : ContDiffOn ℝ ∞ ((fun w : (ℝ × ℝ × ℝ) × ℝ => Mf w.1 w.2) ∘
      (fun s : ℝ × ℝ × ℝ => (s, v))) Ω :=
    hMs.comp hι.contDiffOn hmaps'
  exact hc

theorem rc_nb_v5 : ∀ B : BG, B.ok → ∀ (l : ℕ) (ξ : Cyl), 0 < ξ.1 → ξ.2.2.1 < 1 → qC B.h ξ / Qb l < 4 → XC B.h ξ < 2 * B.Xb → ∀ k : ℕ, NB B.h (fun η : Cyl => RC l η) k ξ ≤ 4 * Real.sqrt B.Xb + 2 :=
by
  intro B hB l ξ hr ht hqQ hX k

  have key : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (F : E → G) (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  have hq : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hQ : 0 < Qb l := by unfold Qb; exact Real.rpow_pos_of_pos (by norm_num) _
  have hsQ : 0 < Real.sqrt (Qb l) := Real.sqrt_pos.mpr hQ
  have H1 : qC B.h ξ < 4 * Qb l := by rwa [div_lt_iff₀ hQ] at hqQ
  have H2 : ξ.1 ^ 2 < 4 * B.Xb * qC B.h ξ := by
    have e : XC B.h ξ = ξ.1 ^ 2 / (2 * qC B.h ξ) := rfl
    rw [e, div_lt_iff₀ (by positivity)] at hX
    linarith
  have hXb : 0 < B.Xb := by
    by_contra hcon
    push_neg at hcon
    nlinarith [sq_nonneg ξ.1, mul_nonpos_of_nonpos_of_nonneg hcon hq.le]

  obtain ⟨π, hπ⟩ : ∃ π : Cyl →L[ℝ] ℝ, π = ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)) := ⟨_, rfl⟩
  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = Real.sqrt (qC B.h ξ) := ⟨_, rfl⟩
  have hs0 : 0 ≤ s := by rw [hs]; exact Real.sqrt_nonneg _
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = (Real.sqrt (Qb l))⁻¹ := ⟨_, rfl⟩
  have hc0 : 0 < c := by rw [hc]; exact inv_pos.mpr hsQ

  have hle : ξ.1 ≤ 4 * Real.sqrt B.Xb * Real.sqrt (Qb l) := by
    have h16 : ξ.1 ^ 2 ≤ (4 * Real.sqrt B.Xb * Real.sqrt (Qb l)) ^ 2 := by
      rw [mul_pow, mul_pow, Real.sq_sqrt hXb.le, Real.sq_sqrt hQ.le]
      nlinarith [mul_lt_mul_of_pos_left H1 hXb]
    exact (pow_le_pow_iff_left₀ hr.le (by positivity) two_ne_zero).1 h16
  have B0 : c * ξ.1 ≤ 4 * Real.sqrt B.Xb := by
    rw [hc, ← div_eq_inv_mul, div_le_iff₀ hsQ]; exact hle
  have hs2 : s ≤ 2 * Real.sqrt (Qb l) := by
    refine (pow_le_pow_iff_left₀ hs0 (by positivity) two_ne_zero).1 ?_
    rw [mul_pow, hs, Real.sq_sqrt hq.le, Real.sq_sqrt hQ.le]
    linarith
  have B1 : c * s ≤ 2 := by
    rw [hc, ← div_eq_inv_mul, div_le_iff₀ hsQ]; exact hs2
  have hsX : 0 ≤ Real.sqrt B.Xb := Real.sqrt_nonneg _

  have hfun : ∀ z : Cyl, RC l (ξ + Lnorm B.h ξ z) = c * (ξ.1 + (s • π) z) := by
    intro z
    have h1 : (ξ + Lnorm B.h ξ z).1 = ξ.1 + (s • π) z := by
      rw [hπ, hs]; simp [Lnorm]
    show (ξ + Lnorm B.h ξ z).1 / Real.sqrt (Qb l) = _
    rw [h1, hc, div_eq_mul_inv, mul_comm]
  have hfunEq : (fun z : Cyl => (fun η : Cyl => RC l η) (ξ + Lnorm B.h ξ z)) =
      (fun z : Cyl => (fun x : ℝ => c * x) (ξ.1 + (s • π) z)) := funext hfun
  have hFV : ContDiffOn ℝ ∞ (fun η : Cyl => RC l η) Set.univ := by unfold RC; fun_prop
  have hg : ContDiffOn ℝ ∞ (fun x : ℝ => c * x) Set.univ := by fun_prop
  have e1 := key (fun η : Cyl => RC l η) Set.univ ξ (Lnorm B.h ξ) isOpen_univ hFV (Set.mem_univ _) k
  have e2 := key (fun x : ℝ => c * x) Set.univ ξ.1 (s • π) isOpen_univ hg (Set.mem_univ _) k
  have hNBeq : NB B.h (fun η : Cyl => RC l η) k ξ =
      ‖(iteratedFDeriv ℝ k (fun x : ℝ => c * x) ξ.1).compContinuousLinearMap (fun _ => s • π)‖ := by
    unfold NB
    rw [← e1, hfunEq, e2]
  rw [hNBeq]
  refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_

  have hπ1 : ‖π‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
    rw [hπ]
    show ‖η.1‖ ≤ 1 * ‖η‖
    rw [one_mul]
    exact norm_fst_le η
  have hn : ‖s • π‖ ≤ s := by
    rw [norm_smul, Real.norm_of_nonneg hs0]
    exact mul_le_of_le_one_right hs0 hπ1
  have hprod : ∏ _i : Fin k, ‖s • π‖ ≤ s ^ k := by
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    exact pow_le_pow_left₀ (norm_nonneg _) hn k

  have hd : ‖iteratedFDeriv ℝ k (fun x : ℝ => c * x) ξ.1‖ =
      |c * (if k = 0 then ξ.1 else if k = 1 then 1 else 0)| := by
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs]
    have e : iteratedDeriv k (fun x : ℝ => c * x) ξ.1 = c * iteratedDeriv k id ξ.1 :=
      iteratedDeriv_const_mul (f := id) c contDiff_id.contDiffAt
    rw [e, iteratedDeriv_id]
  rw [hd]
  refine le_trans (mul_le_mul_of_nonneg_left hprod (abs_nonneg _)) ?_

  by_cases h0 : k = 0
  · subst h0
    rw [if_pos rfl, pow_zero, mul_one, abs_of_pos (mul_pos hc0 hr)]
    linarith
  · by_cases h1 : k = 1
    · subst h1
      rw [if_neg one_ne_zero, if_pos rfl, mul_one, pow_one, abs_of_pos hc0]
      linarith
    · rw [if_neg h0, if_neg h1, mul_zero, abs_zero, zero_mul]
      positivity

theorem slow_profile_nb_qB_v5 : ∀ B : BG, B.ok → ∀ k : ℕ, ∃ C : ℝ, ∀ (l : ℕ), ∀ ξ ∈ DomC B.h B.qB, 1/4 < qC B.h ξ / Qb l → qC B.h ξ / Qb l < 4 → B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → ∀ F : ℝ × ℝ × ℝ → ℝ, (F = pcFa5 B l ∨ F = pcB5 B l 2) → NB B.h (fun η : Cyl => F (η.1, η.2.1, η.2.2.1)) k ξ ≤ C ∧ NB B.h (fun η : Cyl => Real.sqrt (Qb l) * fderiv ℝ F (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))) k ξ ≤ C ∧ NB B.h (fun η : Cyl => Real.sqrt (Qb l) * fderiv ℝ F (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))) k ξ ≤ C * qC B.h ξ ^ B.h :=
by

  have hAlg : ∀ (h : ℝ) (U : Set Cyl) (ξ : Cyl), IsOpen U → ξ ∈ U → ∀ (f g : Cyl → ℝ), ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ g U → ∀ k : ℕ, NB h (fun η => f η * g η) k ξ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB h f i ξ * NB h g (k - i) ξ ∧ (∀ a b : ℝ, NB h (fun η => a * f η + b * g η) k ξ ≤ |a| * NB h f k ξ + |b| * NB h g k ξ) ∧ (∀ a : ℝ, NB h (fun _ : Cyl => a) k ξ ≤ if k = 0 then |a| else 0) := by
    intro h U ξ hU hξ f g hf hg k
    have leib : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (U : Set Cyl) (n : ℕ),
        IsOpen U → ξ ∈ U → ∀ (f : Cyl → ℝ) (g : Cyl → V), ContDiffOn ℝ n f U → ContDiffOn ℝ n g U →
        NB h (fun η => f η • g η) n ξ ≤
          ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * NB h f i ξ * NB h g (n - i) ξ := by
      intro V _ _ U n hU hξ f g hf hg
      unfold NB
      generalize Lnorm h ξ = L
      obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
      have hs : IsOpen s := by
        rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
      have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
      have h0s : (0 : Cyl) ∈ s := by
        rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
      have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
      have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
      have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + z)) s := by
        intro W _ _ F hF
        exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
          (fun z hz => by rw [hs_def] at hz; exact hz)
      have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
        intro W _ _ F hF
        exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
      have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ∀ i : ℕ, i ≤ n →
          iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
            (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
        intro W _ _ F hF i hi
        have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
        have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
          hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
        have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
        have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
        calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
            = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
          _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
                (fun _ => L) := e2
          _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
                (fun _ => L) := by rw [map_zero]
          _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
                (fun _ => L) := by rw [e3]
          _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
      have hfg : ContDiffOn ℝ n (fun η => f η • g η) U := hf.smul hg
      have hl := norm_iteratedFDerivWithin_smul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
        (n := n) le_rfl
      rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) • g (ξ + L y)) n hO h0O] at hl
      rw [← key _ hfg n le_rfl]
      calc ‖iteratedFDeriv ℝ n (fun z => (fun η => f η • g η) (ξ + L z)) 0‖
          = ‖iteratedFDeriv ℝ n (fun y => f (ξ + L y) • g (ξ + L y)) 0‖ := rfl
        _ ≤ _ := hl
        _ = _ := by
          apply Finset.sum_congr rfl
          intro i hi
          have hik : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
            iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (n - i) hO h0O,
            key f hf i hik, key g hg (n - i) (Nat.sub_le n i)]
    have hfk : ContDiffOn ℝ k f U := hf.of_le (by exact_mod_cast le_top)
    have hgk : ContDiffOn ℝ k g U := hg.of_le (by exact_mod_cast le_top)
    have hfa : ContDiffAt ℝ k f ξ := hfk.contDiffAt (hU.mem_nhds hξ)
    have hga : ContDiffAt ℝ k g ξ := hgk.contDiffAt (hU.mem_nhds hξ)
    refine ⟨?_, fun a b => ?_, fun a => ?_⟩
    · have l1 := leib U k hU hξ f g hfk hgk
      have l1' : NB h (fun η => f η * g η) k ξ ≤ ∑ i ∈ Finset.range (k + 1),
          (k.choose i : ℝ) * NB h f i ξ * NB h g (k - i) ξ := l1
      exact l1'
    · unfold NB
      have hfa' : ContDiffAt ℝ k (fun η => a * f η) ξ := contDiffAt_const.mul hfa
      have hga' : ContDiffAt ℝ k (fun η => b * g η) ξ := contDiffAt_const.mul hga
      have e0 : iteratedFDeriv ℝ k (fun η => a * f η + b * g η) ξ =
          iteratedFDeriv ℝ k (fun η => a * f η) ξ + iteratedFDeriv ℝ k (fun η => b * g η) ξ :=
        iteratedFDeriv_add_apply hfa' hga'
      have ea : iteratedFDeriv ℝ k (fun η => a * f η) ξ = a • iteratedFDeriv ℝ k f ξ := by
        have := iteratedFDeriv_const_smul_apply (a := a) hfa
        exact this
      have eb : iteratedFDeriv ℝ k (fun η => b * g η) ξ = b • iteratedFDeriv ℝ k g ξ := by
        have := iteratedFDeriv_const_smul_apply (a := b) hga
        exact this
      rw [e0, ea, eb]
      have e2 : (a • iteratedFDeriv ℝ k f ξ + b • iteratedFDeriv ℝ k g ξ).compContinuousLinearMap
          (fun _ => Lnorm h ξ) =
          a • (iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) +
          b • (iteratedFDeriv ℝ k g ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) := by
        ext m; simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      rw [e2]
      refine (norm_add_le _ _).trans (le_of_eq ?_)
      rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
    · unfold NB
      have hle := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
        (iteratedFDeriv ℝ k (fun _ : Cyl => a) ξ) (fun _ : Fin k => Lnorm h ξ)
      split_ifs with hk
      · subst hk
        rw [Fin.prod_univ_zero, mul_one, norm_iteratedFDeriv_zero, Real.norm_eq_abs] at hle
        exact hle
      · have hz : iteratedFDeriv ℝ k (fun _ : Cyl => a) ξ = 0 := by
          rw [iteratedFDeriv_const_of_ne hk a]; rfl
        rw [hz] at hle ⊢
        rw [norm_zero, zero_mul] at hle
        exact hle

  have hMul : ∀ (h : ℝ) (ξ : Cyl) (a b : Cyl → ℝ) (k : ℕ) (A E : ℝ), ContDiffAt ℝ ∞ a ξ → ContDiffAt ℝ ∞ b ξ → (∀ i : ℕ, i ≤ k → NB h a i ξ ≤ A) → (∀ i : ℕ, i ≤ k → NB h b i ξ ≤ E) → NB h (fun η => a η * b η) k ξ ≤ 2 ^ k * A * E := by
    intro h ξ a b k A E ha hb hA hE
    have hNBnn : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (i : ℕ),
        0 ≤ NB h f i ξ := fun f i => norm_nonneg _
    have hA0 : 0 ≤ A := le_trans (hNBnn a 0) (hA 0 (Nat.zero_le k))
    have hE0 : 0 ≤ E := le_trans (hNBnn b 0) (hE 0 (Nat.zero_le k))
    have ha' : ContDiffAt ℝ k a ξ := ha.of_le (by exact_mod_cast le_top)
    have hb' : ContDiffAt ℝ k b ξ := hb.of_le (by exact_mod_cast le_top)
    obtain ⟨ua, hua, hau⟩ := ha'.contDiffOn le_rfl (by simp)
    obtain ⟨ub, hub, hbu⟩ := hb'.contDiffOn le_rfl (by simp)
    obtain ⟨O, hOsub, hOopen, hξO⟩ := mem_nhds_iff.mp (Filter.inter_mem hua hub)
    have haO : ContDiffOn ℝ k a O := hau.mono (fun x hx => (hOsub hx).1)
    have hbO : ContDiffOn ℝ k b O := hbu.mono (fun x hx => (hOsub hx).2)

    have leib : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (U : Set Cyl) (n : ℕ),
        IsOpen U → ξ ∈ U → ∀ (f : Cyl → ℝ) (g : Cyl → V), ContDiffOn ℝ n f U → ContDiffOn ℝ n g U →
        NB h (fun η => f η • g η) n ξ ≤
          ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * NB h f i ξ * NB h g (n - i) ξ := by
      intro V _ _ U n hU hξ f g hf hg
      unfold NB
      generalize Lnorm h ξ = L
      obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
      have hs : IsOpen s := by
        rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
      have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
      have h0s : (0 : Cyl) ∈ s := by
        rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
      have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
      have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
      have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + z)) s := by
        intro W _ _ F hF
        exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
          (fun z hz => by rw [hs_def] at hz; exact hz)
      have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
        intro W _ _ F hF
        exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
      have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ∀ i : ℕ, i ≤ n →
          iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
            (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
        intro W _ _ F hF i hi
        have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
        have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
          hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
        have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
        have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
        calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
            = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
          _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
                (fun _ => L) := e2
          _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
                (fun _ => L) := by rw [map_zero]
          _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
                (fun _ => L) := by rw [e3]
          _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
      have hfg : ContDiffOn ℝ n (fun η => f η • g η) U := hf.smul hg
      have hl := norm_iteratedFDerivWithin_smul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
        (n := n) le_rfl
      rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) • g (ξ + L y)) n hO h0O] at hl
      rw [← key _ hfg n le_rfl]
      calc ‖iteratedFDeriv ℝ n (fun z => (fun η => f η • g η) (ξ + L z)) 0‖
          = ‖iteratedFDeriv ℝ n (fun y => f (ξ + L y) • g (ξ + L y)) 0‖ := rfl
        _ ≤ _ := hl
        _ = _ := by
          apply Finset.sum_congr rfl
          intro i hi
          have hik : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
            iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (n - i) hO h0O,
            key f hf i hik, key g hg (n - i) (Nat.sub_le n i)]
    have l1 := leib O k hOopen hξO a b haO hbO
    have l1' : NB h (fun η => a η * b η) k ξ ≤ ∑ i ∈ Finset.range (k + 1),
