  have hg3 : ContDiffOn ℝ ∞ (↿(fun x e => U x e * (2 * x * F x e))) (Ioi 0 ×ˢ Ioo (-1) 1) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => U p.1 p.2 * (2 * p.1 * F p.1 p.2)) _
    fun_prop
  have hg4 : ContDiffOn ℝ ∞ (↿(fun x e => U x e ^ 2 - x * F x e ^ 2)) (Ioi 0 ×ˢ Ioo (-1) 1) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => U p.1 p.2 ^ 2 - p.1 * F p.1 p.2 ^ 2) _
    fun_prop
  have hI1 := radSmooth U hU hbU
  have hI2 := radSmooth (fun x e => 2 * x * F x e) hg2 hb2F
  have hI3 := radSmooth (fun x e => U x e * (2 * x * F x e)) hg3 hbU2F
  have hI4 := radSmooth (fun x e => U x e ^ 2 - x * F x e ^ 2) hg4 hbU2
  obtain ⟨hTh, hTz⟩ := assemble F U (profRadInt U) (profEtaD (profRadInt U))
    (profRadInt (fun x e => 2 * x * F x e)) (profEtaD (profRadInt (fun x e => 2 * x * F x e)))
    (profRadInt (fun x e => U x e * (2 * x * F x e)))
    (profEtaD (profRadInt (fun x e => U x e * (2 * x * F x e))))
    (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2))
    (profEtaD (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2)))
    (leadPi F) (profEtaD (leadPi F))
    (fun X η => deriv (fun Y => F Y η) X) (fun X η => deriv (fun Y => U Y η) X)
    hF hU hI1 (s1 _ hI1).2.1 hI2 (s1 _ hI2).2.1 hI3 (s1 _ hI3).2.1 hI4 (s1 _ hI4).2.1
    hPi (s1 _ hPi).2.1 (s1 F hF).1 (s1 U hU).1
    (fun p hp => hFpos p.1 p.2 hp.1 hp.2.1 hp.2.2)
  refine ⟨hTh.congr ?_, hTz.congr ?_⟩
  · rintro ⟨X, η⟩ ⟨hX, h1, h2⟩
    have hX0 : X ≠ 0 := ne_of_gt hX
    show leadStressTh h F U X η = _
    simp only [leadStressTh, leadQs, leadW, shearA, havg X η hX0, hdavg X η hX0]
  · rintro ⟨X, η⟩ ⟨hX, h1, h2⟩
    have hX0 : X ≠ 0 := ne_of_gt hX
    show leadStressTz h F U X η = _
    simp only [leadStressTz, leadNs, leadW, shearB, havg X η hX0, hdavg X η hX0]

theorem cone_pointwise : ∀ μ : ℝ, 0 < μ → μ ≤ 1 → ∃ κ P0 c0 : ℝ, 0 < κ ∧ κ < 2 ∧ 0 < P0 ∧ 0 < c0 ∧ ∀ a b p1 p2 s F : ℝ, μ ≤ a → a ≤ 1 / μ → |b| ≤ 1 / μ → μ ≤ p1 → |p2| ≤ p1 / μ → μ ≤ a - b * (p2 / p1) → μ ≤ 2 - 2 * b * (p2 / p1) - b ^ 2 / a - (a - 2) * (p2 / p1) ^ 2 → P0 ≤ s → 0 < F → κ ≤ a ∧ κ ≤ s * p1 - b / a * (s * p2) - 2 ∧ κ ≤ coneUp (s * p1 - b / a * (s * p2)) (s * p2 + b / a * (s * p1)) - a * (1 + (b / a) ^ 2) ∧ c0 * F ≤ Real.sqrt ((F * (s * p1 - a)) ^ 2 + (F * (s * p2 + b)) ^ 2) ∧ (μ ≤ a * (1 + (b / a) ^ 2) - 2 → κ ≤ a * (1 + (b / a) ^ 2) - 2 ∧ κ * Real.sqrt ((F * (s * p1 - a)) ^ 2 + (F * (s * p2 + b)) ^ 2) ≤ F * (s * p1 - a) - b / a * (F * (s * p2 + b)) ∧ (a * (1 + (b / a) ^ 2) - 2) * (F * (s * p2 + b) + b / a * (F * (s * p1 - a))) ^ 2 ≤ (2 - κ) * (F * (s * p1 - a) - b / a * (F * (s * p2 + b))) ^ 2) :=
by
  intro μ hμ hμ1

  have hcone : ∀ X J u : ℝ, 2 ≤ X → 0 ≤ X - u + J ^ 2 / 4 →
      0 ≤ 2 * (X - u) ^ 2 - (u - 2) * J ^ 2 → u ≤ coneUp X J := by
    intro X J u hX hA hq
    unfold coneUp
    have hD : 0 ≤ (X - 2) / 2 + J ^ 2 / 16 := by linarith [sq_nonneg J]
    have hB0 : 0 ≤ |J| * Real.sqrt ((X - 2) / 2 + J ^ 2 / 16) :=
      mul_nonneg (abs_nonneg _) (Real.sqrt_nonneg _)
    have hB2 : (|J| * Real.sqrt ((X - 2) / 2 + J ^ 2 / 16)) ^ 2
        = J ^ 2 * ((X - 2) / 2 + J ^ 2 / 16) := by
      rw [mul_pow, sq_abs, Real.sq_sqrt hD]
    have hid : (X - u + J ^ 2 / 4) ^ 2 - J ^ 2 * ((X - 2) / 2 + J ^ 2 / 16)
        = (2 * (X - u) ^ 2 - (u - 2) * J ^ 2) / 2 := by ring
    have hle : |J| * Real.sqrt ((X - 2) / 2 + J ^ 2 / 16) ≤ X - u + J ^ 2 / 4 := by
      rw [← pow_le_pow_iff_left₀ hB0 hA two_ne_zero, hB2]
      linarith [hid, hq]
    linarith
  obtain ⟨m, hm⟩ : ∃ m : ℝ, m = 1 / μ := ⟨_, rfl⟩
  have hm0 : 0 < m := by rw [hm]; positivity
  have hμm : μ * m = 1 := by rw [hm]; field_simp
  have hm1 : 1 ≤ m := by
    have h := mul_le_mul_of_nonneg_right hμ1 hm0.le
    rw [one_mul, hμm] at h
    exact h
  have hμ7 : μ ^ 7 ≤ 1 := pow_le_one₀ hμ.le hμ1
  have hμ13 : μ ^ 13 ≤ 1 := pow_le_one₀ hμ.le hμ1
  have hμ14 : μ ^ 14 ≤ 1 := pow_le_one₀ hμ.le hμ1
  have hμ7μ : μ ^ 7 ≤ μ := pow_le_of_le_one hμ.le hμ1 (by norm_num)
  have hμ3μ : μ ^ 3 ≤ μ := pow_le_of_le_one hμ.le hμ1 (by norm_num)
  have hμ13p : 0 < μ ^ 13 := pow_pos hμ 13
  have hm2 : 1 ≤ m ^ 2 := one_le_pow₀ hm1
  have hm3 : 1 ≤ m ^ 3 := one_le_pow₀ hm1
  have hm12 : m ^ 1 ≤ m ^ 2 := pow_le_pow_right₀ hm1 (by norm_num)
  have hm13 : m ^ 1 ≤ m ^ 3 := pow_le_pow_right₀ hm1 (by norm_num)
  rw [pow_one] at hm12 hm13
  have hm35 : m ^ 3 ≤ m ^ 5 := pow_le_pow_right₀ hm1 (by norm_num)
  have hm4 : 1 ≤ m ^ 4 := one_le_pow₀ hm1
