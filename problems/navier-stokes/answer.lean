theorem twg5_mult_cub : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → SimNorm B.h → ∃ l1 : ℕ, ∀ l0 : ℕ,
    l1 ≤ l0 → ∀ (S : CState) (bw ca cm cd : ℝ), StOrd5 B G l0 S bw ca cm cd → ∀ k : ℕ,
