    have k3 : InM B (qsOf l0) H (nrm B (Aex B.h + Aex B.h) (fun η => ubase B η 2 * dvT5 B G l0 S η + ubase B η 1 * (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) + mcor5 B G l0 S 2 η * dvT5 B G l0 S η + (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) * mcor5 B G l0 S 1 η)) :=
