    refine ⟨lam * u ^ 2 * ((2 + e) * (1 / (R * S * (R + S)) + 1 / (S ^ 2 * S))), ?_, ?_, ?_⟩
    · apply mul_le_mul_of_nonneg_left _ hc
      have hA := mul_nonneg (show (0:ℝ) ≤ 1 + e by linarith) ht2p.le
      have hB := mul_nonneg (show (0:ℝ) ≤ 2 + e by linarith) ht1n
      have hE : (2 + e) * (1 / (R * S * (R + S)) + 1 / (S ^ 2 * S)) =
          (1 + e) * (1 / (S ^ 2 * S)) + (2 + e) * (1 / (R * S * (R + S))) + 1 / (S ^ 2 * S) := by
        ring
      rw [hE]
      linarith
    · apply mul_le_mul_of_nonneg_left _ hc
      have := mul_le_mul (show 2 + e ≤ 5 / 2 by linarith)
        (show 1 / (R * S * (R + S)) + 1 / (S ^ 2 * S) ≤ 3 / 2 by linarith)
        (by linarith) (by norm_num)
      linarith
    · have hK : u ^ 2 * e * (2 + e) = R ^ 2 - S ^ 2 := by rw [hRsq, hSsq]; ring
      rw [show -(lam * u ^ 2 * ((2 + e) * (1 / (R * S * (R + S)) + 1 / (S ^ 2 * S)))) * e =
        -lam * (u ^ 2 * e * (2 + e)) * (1 / (R * S * (R + S)) + 1 / (S ^ 2 * S)) by ring, hK]
      field_simp
      ring
  have hcont : Continuous (fun w => lam / Real.sqrt (1 + (u / 2 + u * w / L) ^ 2) -
      lam * (1 + (u / 2 + u * w / L) ^ 2) / (S ^ 2 * S)) :=
    Continuous.sub (Continuous.div continuous_const (Real.continuous_sqrt.comp (by fun_prop))
      (fun w => (Real.sqrt_pos.mpr (by positivity)).ne')) (by fun_prop)
  obtain ⟨h1, h2⟩ := main _ _ _ hcont hpt
  rw [hP]
  constructor
  · calc -(lam * (9 * u ^ 2 / 4)) * (v - L / 2) ^ 2 / L
          = -(lam * u ^ 2 * (9 / 2)) * (v - L / 2) ^ 2 / (2 * L) := by ring
      _ ≤ _ := h1
  · calc _ ≤ -(lam * u ^ 2 * (1 / (S ^ 2 * S))) * (v - L / 2) ^ 2 / (2 * L) := h2
