      right
      rw [le_div_iff₀ (by norm_num)]
      rw [eY5] at hy5
      linarith
    · have hq0 : q = 0 := by
        rw [hq, hB0 _ (by linarith), hB0 _ (by linarith)]; ring
      rw [hR, hq0]; ring
  have hGii : G ≤ -(1 / 2 + P.h) := by
    by_cases hz : y ≤ rfpY5 P.Md P.lam + 1 + P.T1
    · have := hGz hz; linarith
    · obtain ⟨ha1, hd0, hR0⟩ := hGhold (by linarith)
      rw [hG, ha1, hd0, hR0]
      linarith
  have hGiv : rfpY5 P.Md P.lam + 1 ≤ y → y ≤ rfpY5 P.Md P.lam + 1 + P.T1 → G ≤ -(3 / 2) := by
    intro hy5 hz
    obtain ⟨ha1, hd0, hR0⟩ := hGhold hy5
    have hb0 : b = 0 := by rw [hb]; exact hs0 _ (by linarith)
    rw [hG, ha1, hd0, hR0, hb0]
    linarith

  refine ⟨hEE'.differentiableAt, ?_, ?_, ?_, ?_⟩
  · rw [hDG]; have := mul_le_mul_of_nonneg_left hGi hEpos.le; linarith
  · rw [hDG]; have := mul_le_mul_of_nonneg_left hGii hEpos.le; linarith
  · intro hz
    rw [hDG]; have := mul_le_mul_of_nonneg_left (hGz hz) hEpos.le; linarith
  · intro hy5 hz
