      have h1 := R.hasFDerivAt.comp_hasDerivWithinAt u (hy u hu)
      have h2 : R (((A0 u).map (fun a : ℝ => (a : ℂ))).mulVec (y u) + r u) =
          (A1 u).mulVec (R (y u)) + R (r u) := by
        rw [map_add, hRM, hA1 u hu]
      rw [h2] at h1
      exact h1
    have hrb : ∀ u ∈ Set.Icc (0:ℝ) L, ‖R (r u)‖ ≤ F * P u := by
      intro u hu
      refine le_trans ?_ (hr u hu)
      rw [hR]
      refine (pi_norm_le_iff_of_nonneg (norm_nonneg _)).2 (fun i => ?_)
      exact (hφ _).trans (norm_le_pi_norm (r u) i)
    have h := forced_duhamel_within5 A1 P L K F (fun t => R (y t)) (fun t => R (r t)) hA1c hP hK hF
      hprop1 hder hrb v hv
    have h0 : R (y 0) = 0 := by rw [hy0, map_zero]
    simp only [h0, norm_zero, zero_div, zero_add] at h
    show ‖R (y v)‖ ≤ K * P v * F * v
    calc ‖R (y v)‖ ≤ K * P v * (F * v) := h
      _ = K * P v * F * v := by ring
  have hre := key Complex.reCLM (fun z => by
    rw [Complex.reCLM_apply, Real.norm_eq_abs]; exact Complex.abs_re_le_norm z)
  have him := key Complex.imCLM (fun z => by
    rw [Complex.imCLM_apply, Real.norm_eq_abs]; exact Complex.abs_im_le_norm z)
  have hB : 0 ≤ 2 * K * P v * F * v :=
    mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hK) (hP v).le) hF) hv.1
  refine (pi_norm_le_iff_of_nonneg hB).2 (fun i => ?_)
  have h1 := Complex.norm_le_abs_re_add_abs_im (y v i)
  have h2 : |(y v i).re| ≤ K * P v * F * v := by
    have := (norm_le_pi_norm (fun j : Fin 3 => Complex.reCLM (y v j)) i).trans hre
    simpa [Complex.reCLM_apply, Real.norm_eq_abs] using this
  have h3 : |(y v i).im| ≤ K * P v * F * v := by
    have := (norm_le_pi_norm (fun j : Fin 3 => Complex.imCLM (y v j)) i).trans him
    simpa [Complex.imCLM_apply, Real.norm_eq_abs] using this
  linarith

theorem fsj_leibniz_rem : ∀ (a : Cyl → Matrix (Fin 3) (Fin 3) ℝ) (z : Cyl → (Fin 3 → ℂ)) (p0 : Cyl) (Λ : Cyl →L[ℝ] Cyl) (j : ℕ) (Qa : ℝ) (Cy : ℕ → ℝ), ContDiffAt ℝ ∞ (fun p => fun i l : Fin 3 => a p i l) p0 → ContDiffAt ℝ ∞ z p0 → (∀ i : ℕ, 1 ≤ i → i ≤ j → ‖(iteratedFDeriv ℝ i (fun p => fun i' l : Fin 3 => a p i' l) p0).compContinuousLinearMap (fun _ => Λ)‖ ≤ Qa) → (∀ i : ℕ, i < j → ‖(iteratedFDeriv ℝ i z p0).compContinuousLinearMap (fun _ => Λ)‖ ≤ Cy i) → ∀ m : Fin j → Cyl, ‖(iteratedFDeriv ℝ j (fun p => Matrix.mulVec ((a p).map (fun x : ℝ => (x : ℂ))) (z p)) p0) (fun i => Λ (m i)) - Matrix.mulVec ((a p0).map (fun x : ℝ => (x : ℂ))) ((iteratedFDeriv ℝ j z p0) (fun i => Λ (m i)))‖ ≤ 3 * Qa * (∑ i ∈ Finset.range j, (j.choose i : ℝ) * Cy i) * ∏ i, ‖m i‖ :=
by
  intro a z p0 Λ j Qa Cy ha hz hA hY m
  set A : Cyl → Fin 3 → Fin 3 → ℝ := fun p => fun i l : Fin 3 => a p i l with hAd

  obtain ⟨Bil, hBn, hBdef⟩ : ∃ B : (Fin 3 → Fin 3 → ℝ) →L[ℝ] (Fin 3 → ℂ) →L[ℝ] (Fin 3 → ℂ),
      ‖B‖ ≤ 3 ∧ ∀ (M : Fin 3 → Fin 3 → ℝ) (w : Fin 3 → ℂ),
        B M w = fun i => ∑ l, ((M i l : ℝ) : ℂ) * w l := by
    let B0 : (Fin 3 → Fin 3 → ℝ) →ₗ[ℝ] (Fin 3 → ℂ) →ₗ[ℝ] (Fin 3 → ℂ) :=
      LinearMap.mk₂ ℝ (fun (M : Fin 3 → Fin 3 → ℝ) (w : Fin 3 → ℂ) =>
          fun i => ∑ l, ((M i l : ℝ) : ℂ) * w l)
        (fun M1 M2 w => by
          funext i
          simp only [Pi.add_apply, Complex.ofReal_add, ← Finset.sum_add_distrib]
          exact Finset.sum_congr rfl (fun _ _ => by ring))
        (fun c M w => by
          funext i
          simp only [Pi.smul_apply, smul_eq_mul, Complex.ofReal_mul, Finset.smul_sum,
            Complex.real_smul]
          exact Finset.sum_congr rfl (fun _ _ => by ring))
        (fun M w1 w2 => by
          funext i
          simp only [Pi.add_apply, ← Finset.sum_add_distrib]
          exact Finset.sum_congr rfl (fun _ _ => by ring))
        (fun c M w => by
          funext i
          simp only [Pi.smul_apply, Finset.smul_sum, Complex.real_smul]
          exact Finset.sum_congr rfl (fun _ _ => by ring))
    have hb : ∀ M w, ‖B0 M w‖ ≤ 3 * ‖M‖ * ‖w‖ := by
      intro M w
      refine (pi_norm_le_iff_of_nonneg (by positivity)).2 (fun i => ?_)
      show ‖∑ l, ((M i l : ℝ) : ℂ) * w l‖ ≤ _
      calc ‖∑ l, ((M i l : ℝ) : ℂ) * w l‖ ≤ ∑ l, ‖((M i l : ℝ) : ℂ) * w l‖ := norm_sum_le _ _
        _ ≤ ∑ l : Fin 3, ‖M‖ * ‖w‖ := Finset.sum_le_sum (fun l _ => by
            rw [norm_mul, Complex.norm_real]
            exact mul_le_mul ((norm_le_pi_norm (M i) l).trans (norm_le_pi_norm M i))
              (norm_le_pi_norm w l) (norm_nonneg _) (norm_nonneg _))
        _ = 3 * ‖M‖ * ‖w‖ := by simp; ring
    exact ⟨B0.mkContinuous₂ 3 hb, LinearMap.mkContinuous₂_norm_le _ (by norm_num) hb,
      fun M w => rfl⟩
  have hBap : ∀ (p : Cyl) (w : Fin 3 → ℂ),
      Bil (A p) w = Matrix.mulVec ((a p).map (fun x : ℝ => (x : ℂ))) w := by
    intro p w
    rw [hBdef]
    funext i
    simp [Matrix.mulVec, dotProduct, Matrix.map_apply, hAd]

  have lb : ∀ (f : Cyl → (Fin 3 → Fin 3 → ℝ)) (g : Cyl → (Fin 3 → ℂ)),
      ContDiffAt ℝ ∞ f p0 → ContDiffAt ℝ ∞ g p0 →
      ‖(iteratedFDeriv ℝ j (fun x => Bil (f x) (g x)) p0).compContinuousLinearMap (fun _ => Λ)‖ ≤
        ‖Bil‖ * ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) *
          ‖(iteratedFDeriv ℝ i f p0).compContinuousLinearMap (fun _ => Λ)‖ *
          ‖(iteratedFDeriv ℝ (j - i) g p0).compContinuousLinearMap (fun _ => Λ)‖ := by
    intro f g hf hg
    have hf' : ContDiffAt ℝ j f p0 := hf.of_le (by exact_mod_cast le_top)
    have hg' : ContDiffAt ℝ j g p0 := hg.of_le (by exact_mod_cast le_top)
    obtain ⟨uf, huf, hfu⟩ := hf'.contDiffOn le_rfl (by simp)
    obtain ⟨ug, hug, hgu⟩ := hg'.contDiffOn le_rfl (by simp)
    obtain ⟨O, hOsub, hOopen, hxO⟩ := mem_nhds_iff.mp (Filter.inter_mem huf hug)
    have hfO : ContDiffOn ℝ j f O := hfu.mono (fun x hx => (hOsub hx).1)
    have hgO : ContDiffOn ℝ j g O := hgu.mono (fun x hx => (hOsub hx).2)
    have hBO : ContDiffOn ℝ j (fun x => Bil (f x) (g x)) O :=
      (Bil.contDiff.comp_contDiffOn hfO).clm_apply hgO
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun w : Cyl => p0 + w) ⁻¹' O :=
      ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hOopen.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑Λ ⁻¹' s) := hs.preimage Λ.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show p0 + 0 ∈ O; rw [add_zero]; exact hxO
    have hL0s : Λ 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑Λ ⁻¹' s := hL0s
    have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ j F O → ContDiffOn ℝ j (fun w => F (p0 + w)) s := by
      intro W _ _ F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun w hw => by rw [hs_def] at hw; exact hw)
    have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ j F O → ContDiffOn ℝ j (fun w => F (p0 + Λ w)) (⇑Λ ⁻¹' s) := by
      intro W _ _ F hF
      exact (hsm F hF).comp Λ.contDiff.contDiffOn (fun w hw => hw)
    have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ j F O → ∀ i : ℕ, i ≤ j →
        iteratedFDeriv ℝ i (fun w => F (p0 + Λ w)) 0 =
          (iteratedFDeriv ℝ i F p0).compContinuousLinearMap (fun _ => Λ) := by
      intro W _ _ F hF i hi
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun w => F (p0 + Λ w)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right Λ (hsm F hF) hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun w => F (p0 + w)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i p0 0
      calc iteratedFDeriv ℝ i (fun w => F (p0 + Λ w)) 0
          = iteratedFDerivWithin ℝ i ((fun w => F (p0 + w)) ∘ ⇑Λ) (⇑Λ ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun w => F (p0 + w)) s (Λ 0)).compContinuousLinearMap
              (fun _ => Λ) := e2
        _ = (iteratedFDerivWithin ℝ i (fun w => F (p0 + w)) s 0).compContinuousLinearMap
              (fun _ => Λ) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun w => F (p0 + w)) 0).compContinuousLinearMap
              (fun _ => Λ) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F p0).compContinuousLinearMap (fun _ => Λ) := by rw [e4, add_zero]
    have hl := ContinuousLinearMap.norm_iteratedFDerivWithin_le_of_bilinear Bil (hsmO f hfO)
      (hsmO g hgO) hO.uniqueDiffOn h0O (n := j) le_rfl
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => Bil (f (p0 + Λ y)) (g (p0 + Λ y))) j hO h0O]
      at hl
    rw [← key _ hBO j le_rfl]
    calc ‖iteratedFDeriv ℝ j (fun w => (fun x => Bil (f x) (g x)) (p0 + Λ w)) 0‖
        = ‖iteratedFDeriv ℝ j (fun y => Bil (f (p0 + Λ y)) (g (p0 + Λ y))) 0‖ := rfl
      _ ≤ _ := hl
      _ = _ := by
        congr 1
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i ≤ j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [iteratedFDerivWithin_of_isOpen (f := fun w => f (p0 + Λ w)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun w => g (p0 + Λ w)) (j - i) hO h0O,
          key f hfO i hik, key g hgO (j - i) (Nat.sub_le j i)]

  have hφ : ContDiffAt ℝ ∞ (fun p => A p - A p0) p0 := ha.sub contDiffAt_const
  have hg : ContDiffAt ℝ ∞ (fun p => Bil (A p - A p0) (z p)) p0 :=
    (show ContDiffAt ℝ ∞ (fun p => Bil (A p - A p0)) p0 from
      Bil.contDiff.contDiffAt.comp p0 hφ).clm_apply hz
  have hT : ContDiffAt ℝ ∞ (fun p => Bil (A p0) (z p)) p0 :=
    (Bil (A p0)).contDiff.contDiffAt.comp p0 hz
  have hfun : (fun p => Matrix.mulVec ((a p).map (fun x : ℝ => (x : ℂ))) (z p)) =
      (fun p => Bil (A p - A p0) (z p)) + (fun p => Bil (A p0) (z p)) := by
    funext p
    rw [Pi.add_apply, ← ContinuousLinearMap.add_apply, ← map_add, sub_add_cancel, hBap]

  have hD : iteratedFDeriv ℝ j (fun p => Matrix.mulVec ((a p).map (fun x : ℝ => (x : ℂ))) (z p)) p0
        (fun i => Λ (m i)) -
      Matrix.mulVec ((a p0).map (fun x : ℝ => (x : ℂ))) (iteratedFDeriv ℝ j z p0 (fun i => Λ (m i))) =
      iteratedFDeriv ℝ j (fun p => Bil (A p - A p0) (z p)) p0 (fun i => Λ (m i)) := by
    rw [hfun, iteratedFDeriv_add_apply (hg.of_le (by exact_mod_cast le_top))
      (hT.of_le (by exact_mod_cast le_top))]
    have e := (Bil (A p0)).iteratedFDeriv_comp_left hz (i := j) (by exact_mod_cast le_top)
    have e' : iteratedFDeriv ℝ j (fun p => Bil (A p0) (z p)) p0 =
        (Bil (A p0)).compContinuousMultilinearMap (iteratedFDeriv ℝ j z p0) := e
    rw [e', ContinuousMultilinearMap.add_apply,
      ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply, hBap,
      add_sub_cancel_right]
  have hle : ‖iteratedFDeriv ℝ j (fun p => Bil (A p - A p0) (z p)) p0 (fun i => Λ (m i))‖ ≤
      ‖(iteratedFDeriv ℝ j (fun p => Bil (A p - A p0) (z p)) p0).compContinuousLinearMap
        (fun _ => Λ)‖ * ∏ i, ‖m i‖ := by
    have h := ((iteratedFDeriv ℝ j (fun p => Bil (A p - A p0) (z p)) p0).compContinuousLinearMap
      (fun _ => Λ)).le_opNorm m
    simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply] at h
    exact h

  have h0 : ‖(iteratedFDeriv ℝ 0 (fun p => A p - A p0) p0).compContinuousLinearMap
      (fun _ => Λ)‖ = 0 := by
    apply le_antisymm _ (norm_nonneg _)
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    rw [norm_iteratedFDeriv_zero, sub_self, norm_zero, zero_mul]
  have hφi : ∀ i : ℕ, i ≠ 0 →
      iteratedFDeriv ℝ i (fun p => A p - A p0) p0 = iteratedFDeriv ℝ i A p0 := by
    intro i hi
    have e := iteratedFDeriv_sub_apply (ha.of_le (by exact_mod_cast le_top))
      (contDiffAt_const : ContDiffAt ℝ i (fun _ => A p0) p0)
    rw [iteratedFDeriv_const_of_ne hi, Pi.zero_apply, sub_zero] at e
    exact e
  have hμ : 0 ≤ ∏ i, ‖m i‖ := Finset.prod_nonneg (fun i _ => norm_nonneg _)
  have hS0 : 0 ≤ ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) *
      ‖(iteratedFDeriv ℝ i (fun p => A p - A p0) p0).compContinuousLinearMap (fun _ => Λ)‖ *
      ‖(iteratedFDeriv ℝ (j - i) z p0).compContinuousLinearMap (fun _ => Λ)‖ :=
    Finset.sum_nonneg (fun i _ => mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (norm_nonneg _))
      (norm_nonneg _))
  have hS : ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) *
      ‖(iteratedFDeriv ℝ i (fun p => A p - A p0) p0).compContinuousLinearMap (fun _ => Λ)‖ *
      ‖(iteratedFDeriv ℝ (j - i) z p0).compContinuousLinearMap (fun _ => Λ)‖ ≤
      Qa * ∑ i ∈ Finset.range j, (j.choose i : ℝ) * Cy i := by
    rw [Finset.sum_range_succ', h0, mul_zero, zero_mul, add_zero]
    calc ∑ i ∈ Finset.range j, (j.choose (i + 1) : ℝ) *
          ‖(iteratedFDeriv ℝ (i + 1) (fun p => A p - A p0) p0).compContinuousLinearMap
            (fun _ => Λ)‖ *
          ‖(iteratedFDeriv ℝ (j - (i + 1)) z p0).compContinuousLinearMap (fun _ => Λ)‖
        ≤ ∑ i ∈ Finset.range j, Qa * ((j.choose (i + 1) : ℝ) * Cy (j - (i + 1))) := by
          refine Finset.sum_le_sum (fun i hi => ?_)
          have hi' := Finset.mem_range.mp hi
          rw [hφi (i + 1) (Nat.succ_ne_zero i)]
          have hN : ‖(iteratedFDeriv ℝ (i + 1) A p0).compContinuousLinearMap (fun _ => Λ)‖ ≤ Qa :=
            hA (i + 1) (by omega) (by omega)
          have hNy := hY (j - (i + 1)) (by omega)
          have hQa0 : 0 ≤ Qa := (norm_nonneg _).trans hN
          have hC0 : (0 : ℝ) ≤ (j.choose (i + 1) : ℝ) := Nat.cast_nonneg _
          calc (j.choose (i + 1) : ℝ) *
                ‖(iteratedFDeriv ℝ (i + 1) A p0).compContinuousLinearMap (fun _ => Λ)‖ *
                ‖(iteratedFDeriv ℝ (j - (i + 1)) z p0).compContinuousLinearMap (fun _ => Λ)‖
              ≤ (j.choose (i + 1) : ℝ) * Qa * Cy (j - (i + 1)) :=
                mul_le_mul (mul_le_mul_of_nonneg_left hN hC0) hNy (norm_nonneg _)
                  (mul_nonneg hC0 hQa0)
            _ = Qa * ((j.choose (i + 1) : ℝ) * Cy (j - (i + 1))) := by ring
      _ = Qa * ∑ i ∈ Finset.range j, (j.choose (i + 1) : ℝ) * Cy (j - (i + 1)) := by
          rw [Finset.mul_sum]
      _ = Qa * ∑ i ∈ Finset.range j, (j.choose i : ℝ) * Cy i := by
          congr 1
          have r1 : ∑ i ∈ Finset.range j, (j.choose (i + 1) : ℝ) * Cy (j - (i + 1)) =
              ∑ i ∈ Finset.range j, (fun l => (j.choose (j - l) : ℝ) * Cy l) (j - 1 - i) := by
            refine Finset.sum_congr rfl (fun i hi => ?_)
            have hi' := Finset.mem_range.mp hi
            have e1 : j - (j - 1 - i) = i + 1 := by omega
            have e2 : j - 1 - i = j - (i + 1) := by omega
            show (j.choose (i + 1) : ℝ) * Cy (j - (i + 1)) =
              (j.choose (j - (j - 1 - i)) : ℝ) * Cy (j - 1 - i)
            rw [e1, e2]
          refine r1.trans ((Finset.sum_range_reflect (fun l => (j.choose (j - l) : ℝ) * Cy l) j).trans ?_)
          refine Finset.sum_congr rfl (fun l hl => ?_)
          show (j.choose (j - l) : ℝ) * Cy l = (j.choose l : ℝ) * Cy l
          rw [Nat.choose_symm (Finset.mem_range.mp hl).le]

  have hLb := lb (fun p => A p - A p0) z hφ hz
  rw [hD]
  calc ‖iteratedFDeriv ℝ j (fun p => Bil (A p - A p0) (z p)) p0 (fun i => Λ (m i))‖
      ≤ ‖(iteratedFDeriv ℝ j (fun p => Bil (A p - A p0) (z p)) p0).compContinuousLinearMap
        (fun _ => Λ)‖ * ∏ i, ‖m i‖ := hle
    _ ≤ (3 * (Qa * ∑ i ∈ Finset.range j, (j.choose i : ℝ) * Cy i)) * ∏ i, ‖m i‖ := by
        apply mul_le_mul_of_nonneg_right _ hμ
        exact hLb.trans (mul_le_mul hBn hS hS0 (by norm_num))
    _ = 3 * Qa * (∑ i ∈ Finset.range j, (j.choose i : ℝ) * Cy i) * ∏ i, ‖m i‖ := by ring

theorem fsj_jet_ode : ∀ (U : Set Cyl) (J : Set ℝ) (Z Gs : Cyl × ℝ → (Fin 3 → ℂ)) (Ar : Cyl × ℝ → Matrix (Fin 3) (Fin 3) ℝ) (p0 : Cyl) (j : ℕ) (m : Fin j → Cyl), IsOpen U → IsOpen J → p0 ∈ U → ContDiffOn ℝ ∞ Z (U ×ˢ J) → ContDiffOn ℝ ∞ (fun pv : Cyl × ℝ => fun i j' : Fin 3 => Ar pv i j') (U ×ˢ J) → ContDiffOn ℝ ∞ Gs (U ×ˢ J) → (∀ p ∈ U, ∀ v ∈ J, HasDerivAt (fun v' => Z (p, v')) (Matrix.mulVec ((Ar (p, v)).map (fun a : ℝ => (a : ℂ))) (Z (p, v)) - Gs (p, v)) v) → ∀ v ∈ J, HasDerivAt (fun v' => (iteratedFDeriv ℝ j (fun p : Cyl => Z (p, v')) p0) m) ((iteratedFDeriv ℝ j (fun p : Cyl => Matrix.mulVec ((Ar (p, v)).map (fun a : ℝ => (a : ℂ))) (Z (p, v))) p0) m - (iteratedFDeriv ℝ j (fun p : Cyl => Gs (p, v)) p0) m) v :=
by
  intro U J Z Gs Ar p0 j m hU hJ hp0 hZs hArs hGs hODE v hv


  have symmG : ∀ {E V : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup V]
      [NormedSpace ℝ V] (U : Set E) (f : E → V), IsOpen U → ContDiffOn ℝ ∞ f U → ∀ z ∈ U,
      ∀ (m : ℕ) (w : Fin m → E) (σ : Equiv.Perm (Fin m)),
      iteratedFDeriv ℝ m f z (w ∘ σ) = iteratedFDeriv ℝ m f z w := by
    intro E V _ _ _ _ U f hU hf z hz m w σ
    have hperm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (n : ℕ)
        (A : ContinuousMultilinearMap ℝ (fun _ : Fin (n + 1) => E) W),
        (∀ (i : Fin n) (w : Fin (n + 1) → E), A (w ∘ Equiv.swap i.castSucc i.succ) = A w) →
        ∀ (w : Fin (n + 1) → E) (σ : Equiv.Perm (Fin (n + 1))), A (w ∘ σ) = A w := by
      intro W _ _ n A hA w σ
      have hσ : σ ∈ Submonoid.closure (Set.range fun i : Fin n => Equiv.swap i.castSucc i.succ) := by
        rw [Equiv.Perm.mclosure_swap_castSucc_succ]; exact Submonoid.mem_top σ
      induction hσ using Submonoid.closure_induction generalizing w with
      | mem x hx => obtain ⟨i, rfl⟩ := hx; exact hA i w
      | one => rfl
      | mul x y _ _ hx hy =>
        rw [Equiv.Perm.coe_mul, ← Function.comp_assoc, hy, hx]
    have Q : ∀ k : ℕ, ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (g : E → W),
        ContDiffOn ℝ ∞ g U → ∀ y ∈ U, ∀ (u : Fin (k + 2) → E) (τ : Equiv.Perm (Fin (k + 2))),
        iteratedFDeriv ℝ (k + 2) g y (u ∘ τ) = iteratedFDeriv ℝ (k + 2) g y u := by
      intro k
      induction k with
      | zero =>
        intro W _ _ g hg y hy u τ
        refine hperm 1 (iteratedFDeriv ℝ 2 g y) ?_ u τ
        intro i v
        have hi : i = 0 := Subsingleton.elim _ _
        subst hi
        have hS : IsSymmSndFDerivAt ℝ g y :=
          (hg.contDiffAt (hU.mem_nhds hy)).isSymmSndFDerivAt
            (by rw [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.mpr le_top)
        rw [iteratedFDeriv_two_apply, iteratedFDeriv_two_apply]
        simp only [Function.comp_apply]
        have h0 : Equiv.swap (0 : Fin 1).castSucc (0 : Fin 1).succ 0 = 1 := by decide
        have h1 : Equiv.swap (0 : Fin 1).castSucc (0 : Fin 1).succ 1 = 0 := by decide
        rw [h0, h1]
        exact hS.eq _ _
      | succ k ih =>
        intro W _ _ g hg y hy u τ
        have hgy : ContDiffAt ℝ ∞ g y := hg.contDiffAt (hU.mem_nhds hy)
        have hzero : ∀ v : Fin (k + 2 + 1) → E,
            iteratedFDeriv ℝ (k + 2 + 1) g y
              (v ∘ Equiv.swap (0 : Fin (k + 2)).castSucc (0 : Fin (k + 2)).succ) =
            iteratedFDeriv ℝ (k + 2 + 1) g y v := by
          intro v
          have hg' : ContDiffOn ℝ ∞ (fderiv ℝ g) U :=
            ((contDiffOn_infty_iff_fderiv_of_isOpen hU).mp hg).2
          rw [iteratedFDeriv_succ_apply_right (n := k + 2), iteratedFDeriv_succ_apply_right (n := k + 2)]
          have hlast : (v ∘ Equiv.swap (0 : Fin (k + 2)).castSucc (0 : Fin (k + 2)).succ)
              (Fin.last (k + 2)) = v (Fin.last (k + 2)) := by
            simp only [Function.comp_apply]
            rw [Equiv.swap_apply_of_ne_of_ne]
            · apply Fin.ne_of_val_ne; simp
            · apply Fin.ne_of_val_ne; simp
          have hinit : Fin.init (v ∘ Equiv.swap (0 : Fin (k + 2)).castSucc (0 : Fin (k + 2)).succ) =
              Fin.init v ∘ Equiv.swap (0 : Fin (k + 1)).castSucc (0 : Fin (k + 1)).succ := by
            funext l
            simp only [Fin.init, Function.comp_apply]
            congr 1
            rw [Function.Injective.map_swap (Fin.castSucc_injective _)]
            congr 1
          rw [hlast, hinit]
          exact congrArg (fun A => A (v (Fin.last (k + 2))))
            (ih (fderiv ℝ g) hg' y hy (Fin.init v)
              (Equiv.swap (0 : Fin (k + 1)).castSucc (0 : Fin (k + 1)).succ))
        have hsucc : ∀ (j : Fin (k + 1)) (v : Fin (k + 2 + 1) → E),
            iteratedFDeriv ℝ (k + 2 + 1) g y (v ∘ Equiv.swap j.succ.castSucc j.succ.succ) =
            iteratedFDeriv ℝ (k + 2 + 1) g y v := by
          intro j v
          rw [iteratedFDeriv_succ_apply_left (n := k + 2), iteratedFDeriv_succ_apply_left (n := k + 2)]
          have h0 : (v ∘ Equiv.swap j.succ.castSucc j.succ.succ) 0 = v 0 := by
            simp only [Function.comp_apply]
            rw [Equiv.swap_apply_of_ne_of_ne]
            · rw [← Fin.succ_castSucc]; exact (Fin.succ_ne_zero _).symm
            · exact (Fin.succ_ne_zero _).symm
          have htail : Fin.tail (v ∘ Equiv.swap j.succ.castSucc j.succ.succ) =
              Fin.tail v ∘ Equiv.swap j.castSucc j.succ := by
            funext l
            simp only [Fin.tail, Function.comp_apply]
            rw [Function.Injective.map_swap (Fin.succ_injective _), Fin.succ_castSucc]
          rw [h0, htail]
          have hd : DifferentiableAt ℝ (iteratedFDeriv ℝ (k + 2) g) y :=
            hgy.differentiableAt_iteratedFDeriv
              (WithTop.coe_lt_coe.mpr (ENat.natCast_lt_top (k + 2)))
          rw [← fderiv_continuousMultilinear_apply_const_apply hd
                (Fin.tail v ∘ Equiv.swap j.castSucc j.succ) (v 0),
              ← fderiv_continuousMultilinear_apply_const_apply hd (Fin.tail v) (v 0)]
          congr 1
          apply Filter.EventuallyEq.fderiv_eq
          filter_upwards [hU.mem_nhds hy] with y' hy'
          exact ih g hg y' hy' _ _
        show iteratedFDeriv ℝ (k + 2 + 1) g y (u ∘ τ) = iteratedFDeriv ℝ (k + 2 + 1) g y u
        refine hperm (k + 2) (iteratedFDeriv ℝ (k + 2 + 1) g y) ?_ u τ
        intro i v
        refine Fin.cases ?_ (fun j => ?_) i
        · exact hzero v
        · exact hsucc j v
    rcases m with _ | _ | k
    · congr 1; funext i; exact Fin.elim0 i
    · congr 1; funext i; simp only [Function.comp_apply]; congr 1
      exact Fin.ext (by have := (σ i).isLt; have := i.isLt; omega)
    · exact Q k f hf z hz w σ


  have pbG : ∀ {E E' V : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup E']
      [NormedSpace ℝ E'] [NormedAddCommGroup V] [NormedSpace ℝ V] (O : Set E) (h : E → V) (c : E)
      (M : E' →L[ℝ] E) (y0 : E') (n : ℕ), IsOpen O → ContDiffOn ℝ ∞ h O → c + M y0 ∈ O →
      iteratedFDeriv ℝ n (fun y => h (c + M y)) y0 =
        (iteratedFDeriv ℝ n h (c + M y0)).compContinuousLinearMap (fun _ => M) := by
    intro E E' V _ _ _ _ _ _ O h c M y0 n hO hh hc
    have hO1o : IsOpen {z : E | c + z ∈ O} := hO.preimage (continuous_const.add continuous_id)
    have hh1 : ContDiffOn ℝ ∞ (fun z => h (c + z)) {z : E | c + z ∈ O} :=
      hh.comp (contDiff_const.add contDiff_id).contDiffOn (fun z hz => hz)
    have hO2o : IsOpen (M ⁻¹' {z : E | c + z ∈ O}) := hO1o.preimage M.continuous
    have hy0 : y0 ∈ M ⁻¹' {z : E | c + z ∈ O} := hc
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := (fun z => h (c + z)) ∘ M) n hO2o hy0
    have e2 := M.iteratedFDerivWithin_comp_right hh1 hO1o.uniqueDiffOn hO2o.uniqueDiffOn hy0 (i := n)
      (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => h (c + z)) n hO1o
      (show M y0 ∈ {z : E | c + z ∈ O} from hc)
    rw [iteratedFDeriv_comp_add_left] at e3
    show iteratedFDeriv ℝ n ((fun z => h (c + z)) ∘ M) y0 = _
    rw [← e1, e2, e3]


  obtain ⟨O, hOdef⟩ : ∃ O : Set (Cyl × ℝ), O = U ×ˢ J := ⟨_, rfl⟩
  rw [← hOdef] at hZs hArs hGs
  have hO : IsOpen O := by rw [hOdef]; exact hU.prod hJ
  have hmem : ∀ s ∈ U, ∀ r ∈ J, ((s, r) : Cyl × ℝ) ∈ O := by
    intro s hs r hr; rw [hOdef]; exact ⟨hs, hr⟩
  obtain ⟨ι, hι⟩ : ∃ M : Cyl →L[ℝ] Cyl × ℝ, M = ContinuousLinearMap.inl ℝ Cyl ℝ := ⟨_, rfl⟩

  have star : ∀ (h : Cyl × ℝ → (Fin 3 → ℂ)), ContDiffOn ℝ ∞ h O → ∀ s ∈ U, ∀ r ∈ J,
      ∀ n : ℕ, iteratedFDeriv ℝ n (fun s' => h (s', r)) s =
        (iteratedFDeriv ℝ n h (s, r)).compContinuousLinearMap (fun _ => ι) := by
    intro h hh s hs r hr n
    have hcy : ∀ y : Cyl, (((0 : Cyl), r) : Cyl × ℝ) + ι y = (y, r) := by
      intro y; rw [hι]; simp
    have := pbG O h ((0 : Cyl), r) ι s n hO hh (by rw [hcy]; exact hmem s hs r hr)
    simp only [hcy] at this
    exact this
  have p0O : ((p0, v) : Cyl × ℝ) ∈ O := hmem p0 hp0 v hv


  have hcomm : HasDerivAt (fun v' => iteratedFDeriv ℝ j (fun p : Cyl => Z (p, v')) p0)
      (iteratedFDeriv ℝ j (fun p : Cyl => deriv (fun v'' => Z (p, v'')) v) p0) v := by
    have hgp : ContDiffAt ℝ ∞ Z (p0, v) := hZs.contDiffAt (hO.mem_nhds p0O)
    have hΦd : DifferentiableAt ℝ (iteratedFDeriv ℝ j Z) (p0, v) :=
      hgp.differentiableAt_iteratedFDeriv (WithTop.coe_lt_coe.mpr (ENat.natCast_lt_top j))
    obtain ⟨e, he⟩ : ∃ e : Cyl × ℝ, e = ((0 : Cyl), (1 : ℝ)) := ⟨_, rfl⟩
    have hγ : ∀ s : Cyl, HasDerivAt (fun r : ℝ => ((s, r) : Cyl × ℝ)) e v := by
      intro s; rw [he]; exact (hasDerivAt_const v s).prodMk (hasDerivAt_id v)
    have h1 : HasDerivAt (fun r => iteratedFDeriv ℝ j Z (p0, r))
        (fderiv ℝ (iteratedFDeriv ℝ j Z) (p0, v) e) v :=
      hΦd.hasFDerivAt.comp_hasDerivAt v (hγ p0)
    obtain ⟨Cι, hCι⟩ : ∃ C : ContinuousMultilinearMap ℝ (fun _ : Fin j => Cyl × ℝ) (Fin 3 → ℂ)
        →L[ℝ] ContinuousMultilinearMap ℝ (fun _ : Fin j => Cyl) (Fin 3 → ℂ),
        C = ContinuousMultilinearMap.compContinuousLinearMapL (fun _ => ι) := ⟨_, rfl⟩
    have h2 : HasDerivAt (fun v' => iteratedFDeriv ℝ j (fun s : Cyl => Z (s, v')) p0)
        (Cι (fderiv ℝ (iteratedFDeriv ℝ j Z) (p0, v) e)) v := by
      have h := Cι.hasFDerivAt.comp_hasDerivAt v h1
      refine h.congr_of_eventuallyEq ?_
      filter_upwards [hJ.mem_nhds hv] with r hr
      simp only [Function.comp_apply, hCι, ContinuousMultilinearMap.compContinuousLinearMapL_apply]
      exact star Z hZs p0 hp0 r hr j
    refine h2.congr_deriv ?_
    have hfd' : ContDiffOn ℝ ∞ (fderiv ℝ Z) O := ((contDiffOn_infty_iff_fderiv_of_isOpen hO).mp hZs).2
    obtain ⟨g1, hg1⟩ : ∃ g1 : Cyl × ℝ → (Fin 3 → ℂ), g1 = fun y => fderiv ℝ Z y e :=
      ⟨_, rfl⟩
    have hg1s : ContDiffOn ℝ ∞ g1 O := by rw [hg1]; exact hfd'.clm_apply contDiffOn_const
    have hg1comp : iteratedFDeriv ℝ j g1 (p0, v) =
        (ContinuousLinearMap.apply ℝ (Fin 3 → ℂ) e).compContinuousMultilinearMap
          (iteratedFDeriv ℝ j (fun y => fderiv ℝ Z y) (p0, v)) := by
      rw [hg1]
      exact (ContinuousLinearMap.apply ℝ (Fin 3 → ℂ) e).iteratedFDeriv_comp_left
        (hfd'.contDiffAt (hO.mem_nhds p0O)) (i := j) (by exact_mod_cast le_top)
    have hderiv_eq : (fun s : Cyl => g1 (s, v)) =ᶠ[nhds p0]
        (fun s : Cyl => deriv (fun v'' => Z (s, v'')) v) := by
      filter_upwards [hU.mem_nhds hp0] with s hs
      have hfd : DifferentiableAt ℝ Z (s, v) :=
        (hZs.contDiffAt (hO.mem_nhds (hmem s hs v hv))).differentiableAt (by simp)
      have h3 : HasDerivAt (fun v'' => Z (s, v'')) (fderiv ℝ Z (s, v) e) v :=
        hfd.hasFDerivAt.comp_hasDerivAt v (hγ s)
      rw [h3.deriv, hg1]
    rw [← (hderiv_eq.iteratedFDeriv ℝ j).eq_of_nhds, star g1 hg1s p0 hp0 v hv j, hCι]
    ext w
    simp only [ContinuousMultilinearMap.compContinuousLinearMapL_apply,
      ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [hg1comp, ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      ContinuousLinearMap.apply_apply]
    have hL : iteratedFDeriv ℝ (j + 1) Z (p0, v)
        (Fin.cons e (fun i => ι (w i)) : Fin (j + 1) → Cyl × ℝ) =
        fderiv ℝ (iteratedFDeriv ℝ j Z) (p0, v) e (fun i => ι (w i)) := by
      rw [iteratedFDeriv_succ_apply_left, Fin.cons_zero, Fin.tail_cons]
    have hR : iteratedFDeriv ℝ (j + 1) Z (p0, v)
        (Fin.snoc (fun i => ι (w i)) e : Fin (j + 1) → Cyl × ℝ) =
        iteratedFDeriv ℝ j (fun y => fderiv ℝ Z y) (p0, v) (fun i => ι (w i)) e := by
      rw [iteratedFDeriv_succ_apply_right, Fin.init_snoc, Fin.snoc_last]
    have hrot : (Fin.cons e (fun i => ι (w i)) : Fin (j + 1) → Cyl × ℝ) ∘ finRotate (j + 1) =
        (Fin.snoc (fun i => ι (w i)) e : Fin (j + 1) → Cyl × ℝ) := by
      funext i
      exact (congrFun (Fin.snoc_eq_cons_rotate (fun i => ι (w i)) e) i).symm
    have hsymm := symmG O Z hO hZs (p0, v) p0O (j + 1)
      (Fin.cons e (fun i => ι (w i)) : Fin (j + 1) → Cyl × ℝ) (finRotate (j + 1))
    rw [← hL, ← hR, ← hrot]
    exact congrFun hsymm.symm _


  have h2 : HasDerivAt (fun v' => (iteratedFDeriv ℝ j (fun p : Cyl => Z (p, v')) p0) m)
      ((iteratedFDeriv ℝ j (fun p : Cyl => deriv (fun v'' => Z (p, v'')) v) p0) m) v := by
    have h := (ContinuousMultilinearMap.apply ℝ (fun _ : Fin j => Cyl) (Fin 3 → ℂ) m).hasFDerivAt.comp_hasDerivAt
      v hcomm
    simp only [Function.comp_def, ContinuousMultilinearMap.apply_apply] at h
    exact h


  have hev : (fun p : Cyl => deriv (fun v'' => Z (p, v'')) v) =ᶠ[nhds p0]
      (fun p : Cyl => Matrix.mulVec ((Ar (p, v)).map (fun a : ℝ => (a : ℂ))) (Z (p, v)) - Gs (p, v)) := by
    filter_upwards [hU.mem_nhds hp0] with p hp
    exact (hODE p hp v hv).deriv
  rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds] at h2


  have hmv : ContDiffOn ℝ ∞
      (fun pv : Cyl × ℝ => Matrix.mulVec ((Ar pv).map (fun a : ℝ => (a : ℂ))) (Z pv)) O := by
    refine contDiffOn_pi.mpr (fun i => ?_)
    have e : (fun pv : Cyl × ℝ => Matrix.mulVec ((Ar pv).map (fun a : ℝ => (a : ℂ))) (Z pv) i) =
        fun pv => ∑ l : Fin 3, ((Ar pv i l : ℝ) : ℂ) * Z pv l := by
      funext pv; simp [Matrix.mulVec, dotProduct, Matrix.map_apply]
    rw [e]
    refine ContDiffOn.sum (fun l _ => ?_)
    refine ContDiffOn.mul ?_ (contDiffOn_pi.mp hZs l)
    have hA : ContDiffOn ℝ ∞ (fun pv : Cyl × ℝ => Ar pv i l) O :=
      contDiffOn_pi.mp (contDiffOn_pi.mp hArs i) l
    exact Complex.ofRealCLM.contDiff.comp_contDiffOn hA
  have hιv : ContDiff ℝ ∞ (fun p : Cyl => ((p, v) : Cyl × ℝ)) := contDiff_id.prodMk contDiff_const
  have hf1 : ContDiffAt ℝ ∞
      (fun p : Cyl => Matrix.mulVec ((Ar (p, v)).map (fun a : ℝ => (a : ℂ))) (Z (p, v))) p0 :=
    ContDiffAt.comp (g := fun pv : Cyl × ℝ => Matrix.mulVec ((Ar pv).map (fun a : ℝ => (a : ℂ))) (Z pv))
      p0 (hmv.contDiffAt (hO.mem_nhds p0O)) hιv.contDiffAt
  have hf2 : ContDiffAt ℝ ∞ (fun p : Cyl => Gs (p, v)) p0 :=
    ContDiffAt.comp (g := Gs) p0 (hGs.contDiffAt (hO.mem_nhds p0O)) hιv.contDiffAt


  have hsub : iteratedFDeriv ℝ j
      (fun p : Cyl => Matrix.mulVec ((Ar (p, v)).map (fun a : ℝ => (a : ℂ))) (Z (p, v)) - Gs (p, v)) p0 =
      iteratedFDeriv ℝ j
        (fun p : Cyl => Matrix.mulVec ((Ar (p, v)).map (fun a : ℝ => (a : ℂ))) (Z (p, v))) p0 -
      iteratedFDeriv ℝ j (fun p : Cyl => Gs (p, v)) p0 :=
    iteratedFDeriv_sub_apply (hf1.of_le (by exact_mod_cast le_top))
      (hf2.of_le (by exact_mod_cast le_top))
  rw [hsub, ContinuousMultilinearMap.sub_apply] at h2
  exact h2

theorem fpj_slow_jet : ∀ (U : Set Cyl) (J : Set ℝ) (Z Gs : Cyl × ℝ → (Fin 3 → ℂ)) (Ar : Cyl × ℝ → Matrix (Fin 3) (Fin 3) ℝ) (p0 : Cyl) (Λ : Cyl →L[ℝ] Cyl) (L K Q I : ℝ) (P : ℝ → ℝ) (k : ℕ), IsOpen U → IsOpen J → p0 ∈ U → Set.Icc 0 L ⊆ J → ContDiffOn ℝ ∞ Z (U ×ˢ J) → ContDiffOn ℝ ∞ (fun pv : Cyl × ℝ => fun i j' : Fin 3 => Ar pv i j') (U ×ˢ J) → ContDiffOn ℝ ∞ Gs (U ×ˢ J) → (∀ p ∈ U, Z (p, 0) = 0) → (∀ p ∈ U, ∀ v ∈ J, HasDerivAt (fun v' => Z (p, v')) (Matrix.mulVec ((Ar (p, v)).map (fun a : ℝ => (a : ℂ))) (Z (p, v)) - Gs (p, v)) v) → (∀ v, 0 < P v) → 0 ≤ K → (∀ (x : ℝ → (Fin 3 → ℝ)) (w : ℝ), 0 ≤ w → w ≤ L → (∀ v ∈ Set.Icc w L, HasDerivAt x ((Ar (p0, v)).mulVec (x v)) v) → ∀ v ∈ Set.Icc w L, ‖x v‖ ≤ K * (P v / P w) * ‖x w‖) → 0 ≤ Q → (∀ j : ℕ, j ≤ k → ∀ v ∈ Set.Icc 0 L, ‖(iteratedFDeriv ℝ j (fun p : Cyl => fun i j' : Fin 3 => Ar (p, v) i j') p0).compContinuousLinearMap (fun _ => Λ)‖ ≤ Q) → 0 ≤ I → (∀ j : ℕ, j ≤ k → ∀ w ∈ Set.Icc 0 L, ‖(iteratedFDeriv ℝ j (fun p : Cyl => Gs (p, w)) p0).compContinuousLinearMap (fun _ => Λ)‖ ≤ I * P w) → ∀ j : ℕ, j ≤ k → ∀ v ∈ Set.Icc 0 L, ‖(iteratedFDeriv ℝ j (fun p : Cyl => Z (p, v)) p0).compContinuousLinearMap (fun _ => Λ)‖ ≤ ((1 + K) * (1 + L) * 6 * 2 ^ k * (1 + Q)) ^ (k + 1) * I * P v :=
by
  intro U J Z Gs Ar p0 Λ L K Q I P k hU hJ hp0 hIJ hZs hArs hGs hZ0 hODE hP hK hprop hQ hArJ hI hGJ
  obtain ⟨X, hX⟩ : ∃ X : ℝ, X = (1 + K) * (1 + L) * 6 * 2 ^ k * (1 + Q) := ⟨_, rfl⟩
  have hO : IsOpen (U ×ˢ J) := hU.prod hJ
  have hZat : ∀ w ∈ J, ContDiffAt ℝ ∞ (fun p : Cyl => Z (p, w)) p0 := fun w hw =>
    (hZs.contDiffAt (hO.mem_nhds ⟨hp0, hw⟩)).comp p0
      ((contDiff_id.prodMk contDiff_const).contDiffAt)
  have hArat : ∀ w ∈ J, ContDiffAt ℝ ∞ (fun p : Cyl => fun i l : Fin 3 => Ar (p, w) i l) p0 :=
    fun w hw => (hArs.contDiffAt (hO.mem_nhds ⟨hp0, hw⟩)).comp p0
      ((contDiff_id.prodMk contDiff_const).contDiffAt)
  have hA0c : ContinuousOn (fun w : ℝ => Ar (p0, w)) (Set.Icc 0 L) := by
    have h1 : ContinuousOn (fun w : ℝ => ((p0, w) : Cyl × ℝ)) (Set.Icc 0 L) :=
      (continuous_const.prodMk continuous_id).continuousOn
    exact hArs.continuousOn.comp h1 (fun w hw => ⟨hp0, hIJ hw⟩)
  have H : ∀ j : ℕ, j ≤ k → ∀ v ∈ Set.Icc (0:ℝ) L,
      ‖(iteratedFDeriv ℝ j (fun p : Cyl => Z (p, v)) p0).compContinuousLinearMap (fun _ => Λ)‖ ≤
        X ^ (j + 1) * I * P v := by
    intro j
    induction j using Nat.strong_induction_on with
    | _ j ih =>
    intro hj v hv
    have hL : 0 ≤ L := le_trans hv.1 hv.2
    have hX1 : 1 ≤ X := by
      rw [hX]
      exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le
        (one_le_mul_of_one_le_of_one_le
          (one_le_mul_of_one_le_of_one_le (by linarith) (by linarith)) (by norm_num))
        (one_le_pow₀ (by norm_num))) (by linarith)
    have hX0 : 0 ≤ X := by linarith
    have hIPv : 0 ≤ I * P v := mul_nonneg hI (hP v).le
    have hM0 : 0 ≤ X ^ (j + 1) * I * P v := by
      rw [mul_assoc]; exact mul_nonneg (pow_nonneg hX0 _) hIPv
    refine ContinuousMultilinearMap.opNorm_le_bound hM0 (fun m' => ?_)
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    obtain ⟨Pm, hPm⟩ : ∃ Pm : ℝ, Pm = ∏ i, ‖m' i‖ := ⟨_, rfl⟩
    have hPm0 : 0 ≤ Pm := by rw [hPm]; exact Finset.prod_nonneg (fun i _ => norm_nonneg _)
    obtain ⟨y, hy⟩ : ∃ y : ℝ → (Fin 3 → ℂ), y = fun w =>
        (iteratedFDeriv ℝ j (fun p : Cyl => Z (p, w)) p0) (fun i => Λ (m' i)) := ⟨_, rfl⟩
    obtain ⟨Bf, hBf⟩ : ∃ Bf : ℝ → (Fin 3 → ℂ), Bf = fun w =>
        (iteratedFDeriv ℝ j (fun p : Cyl => Matrix.mulVec ((Ar (p, w)).map (fun a : ℝ => (a : ℂ)))
          (Z (p, w))) p0) (fun i => Λ (m' i)) := ⟨_, rfl⟩
    obtain ⟨Γ, hΓ⟩ : ∃ Γ : ℝ → (Fin 3 → ℂ), Γ = fun w =>
        (iteratedFDeriv ℝ j (fun p : Cyl => Gs (p, w)) p0) (fun i => Λ (m' i)) := ⟨_, rfl⟩
    obtain ⟨r, hr⟩ : ∃ r : ℝ → (Fin 3 → ℂ), r = fun w =>
        (Bf w - ((Ar (p0, w)).map (fun a : ℝ => (a : ℂ))).mulVec (y w)) - Γ w := ⟨_, rfl⟩
    obtain ⟨S, hS⟩ : ∃ S : ℝ, S = ∑ i ∈ Finset.range j, (j.choose i : ℝ) * X ^ (i + 1) := ⟨_, rfl⟩
    have hS0 : 0 ≤ S := by
      rw [hS]; exact Finset.sum_nonneg (fun i _ => mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hX0 _))
    obtain ⟨F, hF⟩ : ∃ F : ℝ, F = (3 * Q * S * I + I) * Pm := ⟨_, rfl⟩
    have hF0 : 0 ≤ F := by
      rw [hF]
      exact mul_nonneg (add_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hQ) hS0) hI) hI)
        hPm0

    have hG1 : ∀ w ∈ Set.Icc (0:ℝ) L, HasDerivWithinAt y
        (((Ar (p0, w)).map (fun a : ℝ => (a : ℂ))).mulVec (y w) + r w) (Set.Icc 0 L) w := by
      intro w hw
      have h := fsj_jet_ode U J Z Gs Ar p0 j (fun i => Λ (m' i)) hU hJ hp0 hZs hArs hGs hODE w (hIJ hw)
      have h' : HasDerivAt y (Bf w - Γ w) w := by
        rw [hy, hBf, hΓ]; exact h
      have he : ((Ar (p0, w)).map (fun a : ℝ => (a : ℂ))).mulVec (y w) + r w = Bf w - Γ w := by
        simp only [hr]; abel
      rw [he]
      exact h'.hasDerivWithinAt

    have hG2 : y 0 = 0 := by
      have hev : (fun p : Cyl => Z (p, 0)) =ᶠ[nhds p0] fun _ => (0 : Fin 3 → ℂ) :=
        Filter.eventuallyEq_of_mem (hU.mem_nhds hp0) (fun p hp => hZ0 p hp)
      rw [hy]
      show (iteratedFDeriv ℝ j (fun p : Cyl => Z (p, 0)) p0) (fun i => Λ (m' i)) = 0
      rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds, iteratedFDeriv_fun_zero]
      simp

    have hG3 : ∀ w ∈ Set.Icc (0:ℝ) L, ‖r w‖ ≤ F * P w := by
      intro w hw
      have hwJ : w ∈ J := hIJ hw
      have h3 := fsj_leibniz_rem (fun p => Ar (p, w)) (fun p => Z (p, w)) p0 Λ j Q
        (fun i => X ^ (i + 1) * I * P w) (hArat w hwJ) (hZat w hwJ)
        (fun i _ hij => hArJ i (le_trans hij hj) w hw)
        (fun i hij => ih i hij (le_trans hij.le hj) w hw) m'
      have h3' : ‖Bf w - ((Ar (p0, w)).map (fun a : ℝ => (a : ℂ))).mulVec (y w)‖ ≤
          3 * Q * (∑ i ∈ Finset.range j, (j.choose i : ℝ) * (X ^ (i + 1) * I * P w)) *
            ∏ i, ‖m' i‖ := by
        rw [hBf, hy]; exact h3
      have hΓb : ‖Γ w‖ ≤ I * P w * ∏ i, ‖m' i‖ := by
        have h0 := ContinuousMultilinearMap.le_opNorm
          ((iteratedFDeriv ℝ j (fun p : Cyl => Gs (p, w)) p0).compContinuousLinearMap (fun _ => Λ)) m'
        rw [ContinuousMultilinearMap.compContinuousLinearMap_apply] at h0
        rw [hΓ]
        exact h0.trans (mul_le_mul_of_nonneg_right (hGJ j hj w hw)
          (Finset.prod_nonneg (fun i _ => norm_nonneg _)))
      have hsum : (∑ i ∈ Finset.range j, (j.choose i : ℝ) * (X ^ (i + 1) * I * P w)) =
          S * (I * P w) := by
        rw [hS, Finset.sum_mul]
        exact Finset.sum_congr rfl (fun i _ => by ring)
      have hrw : r w = (Bf w - ((Ar (p0, w)).map (fun a : ℝ => (a : ℂ))).mulVec (y w)) - Γ w := by
        rw [hr]
      rw [hrw]
      rw [hsum, ← hPm] at h3'
      rw [← hPm] at hΓb
      calc ‖Bf w - ((Ar (p0, w)).map (fun a : ℝ => (a : ℂ))).mulVec (y w) - Γ w‖
          ≤ ‖Bf w - ((Ar (p0, w)).map (fun a : ℝ => (a : ℂ))).mulVec (y w)‖ + ‖Γ w‖ :=
            norm_sub_le _ _
        _ ≤ 3 * Q * (S * (I * P w)) * Pm + I * P w * Pm := add_le_add h3' hΓb
        _ = F * P w := by rw [hF]; ring

    have h4 := fsj_cpx_duhamel (fun w => Ar (p0, w)) P L K F y r hA0c hP hK hF0 hprop hG1 hG3 hG2 v hv

    have hchoose : (∑ i ∈ Finset.range j, (j.choose i : ℝ)) ≤ 2 ^ k := by
      have h1 : (∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ)) = 2 ^ j := by
        exact_mod_cast Nat.sum_range_choose j
      rw [Finset.sum_range_succ] at h1
      have h2 : (0:ℝ) ≤ (j.choose j : ℝ) := Nat.cast_nonneg _
      have h3 : (2:ℝ) ^ j ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hj
      linarith
    have hSle : S ≤ X ^ j * 2 ^ k := by
      rw [hS]
      calc ∑ i ∈ Finset.range j, (j.choose i : ℝ) * X ^ (i + 1)
          ≤ ∑ i ∈ Finset.range j, (j.choose i : ℝ) * X ^ j :=
            Finset.sum_le_sum (fun i hi => mul_le_mul_of_nonneg_left
              (pow_le_pow_right₀ hX1 (Nat.succ_le_of_lt (Finset.mem_range.mp hi))) (Nat.cast_nonneg _))
        _ = (∑ i ∈ Finset.range j, (j.choose i : ℝ)) * X ^ j := by rw [Finset.sum_mul]
        _ ≤ 2 ^ k * X ^ j := mul_le_mul_of_nonneg_right hchoose (pow_nonneg hX0 _)
        _ = X ^ j * 2 ^ k := by ring
    have hXj1 : 1 ≤ X ^ j := one_le_pow₀ hX1
    have h2k : (1:ℝ) ≤ 2 ^ k := one_le_pow₀ (by norm_num)
    have hKL : 0 ≤ K * L := mul_nonneg hK hL
    have hstep1 : 3 * Q * S + 1 ≤ (3 * Q * 2 ^ k + 1) * X ^ j := by
      have h1 : 3 * Q * S ≤ 3 * Q * (X ^ j * 2 ^ k) := mul_le_mul_of_nonneg_left hSle (by linarith)
      nlinarith
    have hstep2 : 2 * K * L * (3 * Q * 2 ^ k + 1) ≤ X := by
      rw [hX]
      have ha : 2 * K * L ≤ 2 * ((1 + K) * (1 + L)) := by nlinarith
      have hb : 3 * Q * 2 ^ k + 1 ≤ 3 * 2 ^ k * (1 + Q) := by nlinarith
      have hc : (0:ℝ) ≤ 3 * Q * 2 ^ k + 1 := by
        have := mul_nonneg (mul_nonneg (by norm_num : (0:ℝ) ≤ 3) hQ) (by positivity : (0:ℝ) ≤ 2 ^ k)
        linarith
      have hd : (0:ℝ) ≤ 2 * ((1 + K) * (1 + L)) := by nlinarith
      calc 2 * K * L * (3 * Q * 2 ^ k + 1) ≤ 2 * ((1 + K) * (1 + L)) * (3 * 2 ^ k * (1 + Q)) :=
            mul_le_mul ha hb hc hd
        _ = (1 + K) * (1 + L) * 6 * 2 ^ k * (1 + Q) := by ring
    have hkey : 2 * K * L * (3 * Q * S + 1) ≤ X ^ (j + 1) := by
      calc 2 * K * L * (3 * Q * S + 1) ≤ 2 * K * L * ((3 * Q * 2 ^ k + 1) * X ^ j) :=
            mul_le_mul_of_nonneg_left hstep1 (by linarith)
        _ = (2 * K * L * (3 * Q * 2 ^ k + 1)) * X ^ j := by ring
        _ ≤ X * X ^ j := mul_le_mul_of_nonneg_right hstep2 (pow_nonneg hX0 _)
        _ = X ^ (j + 1) := by ring
    have hy_le : ‖y v‖ ≤ X ^ (j + 1) * I * P v * Pm := by
      calc ‖y v‖ ≤ 2 * K * P v * F * v := h4
        _ ≤ 2 * K * P v * F * L := mul_le_mul_of_nonneg_left hv.2
            (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hK) (hP v).le) hF0)
        _ = (2 * K * L * (3 * Q * S + 1)) * (I * P v * Pm) := by rw [hF]; ring
        _ ≤ X ^ (j + 1) * (I * P v * Pm) := mul_le_mul_of_nonneg_right hkey (mul_nonneg hIPv hPm0)
        _ = X ^ (j + 1) * I * P v * Pm := by ring
    rw [hPm, hy] at hy_le
    exact hy_le
  intro j hj v hv
  have hL : 0 ≤ L := le_trans hv.1 hv.2
  have hX1 : 1 ≤ X := by
    rw [hX]
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le
      (one_le_mul_of_one_le_of_one_le
        (one_le_mul_of_one_le_of_one_le (by linarith) (by linarith)) (by norm_num))
      (one_le_pow₀ (by norm_num))) (by linarith)
  rw [← hX]
  have hIPv : 0 ≤ I * P v := mul_nonneg hI (hP v).le
  calc ‖(iteratedFDeriv ℝ j (fun p : Cyl => Z (p, v)) p0).compContinuousLinearMap (fun _ => Λ)‖
      ≤ X ^ (j + 1) * I * P v := H j hj v hv
    _ = X ^ (j + 1) * (I * P v) := by ring
    _ ≤ X ^ (k + 1) * (I * P v) :=
        mul_le_mul_of_nonneg_right (pow_le_pow_right₀ hX1 (by omega)) hIPv
    _ = X ^ (k + 1) * I * P v := by ring

theorem fpj_mixed_jet : ∀ (U : Set Cyl) (J : Set ℝ) (Z Gs : Cyl × ℝ → (Fin 3 → ℂ)) (Ar : Cyl × ℝ → Matrix (Fin 3) (Fin 3) ℝ) (p0 : Cyl) (Λ : Cyl →L[ℝ] Cyl) (Q Bm : ℝ) (k : ℕ) (v : ℝ), IsOpen U → IsOpen J → p0 ∈ U → v ∈ J → ContDiffOn ℝ ∞ Z (U ×ˢ J) → ContDiffOn ℝ ∞ (fun pv : Cyl × ℝ => fun i j' : Fin 3 => Ar pv i j') (U ×ˢ J) → ContDiffOn ℝ ∞ Gs (U ×ˢ J) → (∀ p ∈ U, ∀ v' ∈ J, HasDerivAt (fun v'' => Z (p, v'')) (Matrix.mulVec ((Ar (p, v')).map (fun a : ℝ => (a : ℂ))) (Z (p, v')) - Gs (p, v')) v') → 0 ≤ Q → 0 ≤ Bm → (∀ j : ℕ, j ≤ k → ‖(iteratedFDeriv ℝ j (fun pv : Cyl × ℝ => fun i j' : Fin 3 => Ar pv i j') (p0, v)).compContinuousLinearMap (fun _ => Λ.prodMap (ContinuousLinearMap.id ℝ ℝ))‖ ≤ Q) → (∀ j : ℕ, j ≤ k → ‖(iteratedFDeriv ℝ j Gs (p0, v)).compContinuousLinearMap (fun _ => Λ.prodMap (ContinuousLinearMap.id ℝ ℝ))‖ ≤ Bm) → (∀ j : ℕ, j ≤ k → ‖(iteratedFDeriv ℝ j (fun p : Cyl => Z (p, v)) p0).compContinuousLinearMap (fun _ => Λ)‖ ≤ Bm) → ‖(iteratedFDeriv ℝ k Z (p0, v)).compContinuousLinearMap (fun _ => Λ.prodMap (ContinuousLinearMap.id ℝ ℝ))‖ ≤ (4 ^ k * 4 * (1 + Q)) ^ (k + 1) * Bm :=
by
  intro U J Z Gs Ar p0 Λ Q Bm k v hU hJ hp0 hv hZ hA hG hode hQ hBm hcoef hGj hslow


  have symmG : ∀ {E V : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup V]
      [NormedSpace ℝ V] (U : Set E) (f : E → V), IsOpen U → ContDiffOn ℝ ∞ f U → ∀ z ∈ U,
      ∀ (m : ℕ) (w : Fin m → E) (σ : Equiv.Perm (Fin m)),
      iteratedFDeriv ℝ m f z (w ∘ σ) = iteratedFDeriv ℝ m f z w := by
    intro E V _ _ _ _ U f hU hf z hz m w σ
    have hperm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (n : ℕ)
        (A : ContinuousMultilinearMap ℝ (fun _ : Fin (n + 1) => E) W),
        (∀ (i : Fin n) (w : Fin (n + 1) → E), A (w ∘ Equiv.swap i.castSucc i.succ) = A w) →
        ∀ (w : Fin (n + 1) → E) (σ : Equiv.Perm (Fin (n + 1))), A (w ∘ σ) = A w := by
      intro W _ _ n A hA w σ
      have hσ : σ ∈ Submonoid.closure (Set.range fun i : Fin n => Equiv.swap i.castSucc i.succ) := by
        rw [Equiv.Perm.mclosure_swap_castSucc_succ]; exact Submonoid.mem_top σ
      induction hσ using Submonoid.closure_induction generalizing w with
      | mem x hx => obtain ⟨i, rfl⟩ := hx; exact hA i w
      | one => rfl
      | mul x y _ _ hx hy =>
        rw [Equiv.Perm.coe_mul, ← Function.comp_assoc, hy, hx]
    have Q : ∀ k : ℕ, ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (g : E → W),
        ContDiffOn ℝ ∞ g U → ∀ y ∈ U, ∀ (u : Fin (k + 2) → E) (τ : Equiv.Perm (Fin (k + 2))),
        iteratedFDeriv ℝ (k + 2) g y (u ∘ τ) = iteratedFDeriv ℝ (k + 2) g y u := by
      intro k
      induction k with
      | zero =>
        intro W _ _ g hg y hy u τ
        refine hperm 1 (iteratedFDeriv ℝ 2 g y) ?_ u τ
        intro i v
        have hi : i = 0 := Subsingleton.elim _ _
        subst hi
        have hS : IsSymmSndFDerivAt ℝ g y :=
          (hg.contDiffAt (hU.mem_nhds hy)).isSymmSndFDerivAt
            (by rw [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.mpr le_top)
        rw [iteratedFDeriv_two_apply, iteratedFDeriv_two_apply]
        simp only [Function.comp_apply]
        have h0 : Equiv.swap (0 : Fin 1).castSucc (0 : Fin 1).succ 0 = 1 := by decide
        have h1 : Equiv.swap (0 : Fin 1).castSucc (0 : Fin 1).succ 1 = 0 := by decide
        rw [h0, h1]
        exact hS.eq _ _
      | succ k ih =>
        intro W _ _ g hg y hy u τ
        have hgy : ContDiffAt ℝ ∞ g y := hg.contDiffAt (hU.mem_nhds hy)
        have hzero : ∀ v : Fin (k + 2 + 1) → E,
            iteratedFDeriv ℝ (k + 2 + 1) g y
              (v ∘ Equiv.swap (0 : Fin (k + 2)).castSucc (0 : Fin (k + 2)).succ) =
            iteratedFDeriv ℝ (k + 2 + 1) g y v := by
          intro v
          have hg' : ContDiffOn ℝ ∞ (fderiv ℝ g) U :=
            ((contDiffOn_infty_iff_fderiv_of_isOpen hU).mp hg).2
          rw [iteratedFDeriv_succ_apply_right (n := k + 2), iteratedFDeriv_succ_apply_right (n := k + 2)]
          have hlast : (v ∘ Equiv.swap (0 : Fin (k + 2)).castSucc (0 : Fin (k + 2)).succ)
              (Fin.last (k + 2)) = v (Fin.last (k + 2)) := by
            simp only [Function.comp_apply]
            rw [Equiv.swap_apply_of_ne_of_ne]
            · apply Fin.ne_of_val_ne; simp
            · apply Fin.ne_of_val_ne; simp
          have hinit : Fin.init (v ∘ Equiv.swap (0 : Fin (k + 2)).castSucc (0 : Fin (k + 2)).succ) =
              Fin.init v ∘ Equiv.swap (0 : Fin (k + 1)).castSucc (0 : Fin (k + 1)).succ := by
            funext l
            simp only [Fin.init, Function.comp_apply]
            congr 1
            rw [Function.Injective.map_swap (Fin.castSucc_injective _)]
            congr 1
          rw [hlast, hinit]
          exact congrArg (fun A => A (v (Fin.last (k + 2))))
            (ih (fderiv ℝ g) hg' y hy (Fin.init v)
              (Equiv.swap (0 : Fin (k + 1)).castSucc (0 : Fin (k + 1)).succ))
        have hsucc : ∀ (j : Fin (k + 1)) (v : Fin (k + 2 + 1) → E),
            iteratedFDeriv ℝ (k + 2 + 1) g y (v ∘ Equiv.swap j.succ.castSucc j.succ.succ) =
            iteratedFDeriv ℝ (k + 2 + 1) g y v := by
          intro j v
          rw [iteratedFDeriv_succ_apply_left (n := k + 2), iteratedFDeriv_succ_apply_left (n := k + 2)]
          have h0 : (v ∘ Equiv.swap j.succ.castSucc j.succ.succ) 0 = v 0 := by
            simp only [Function.comp_apply]
            rw [Equiv.swap_apply_of_ne_of_ne]
            · rw [← Fin.succ_castSucc]; exact (Fin.succ_ne_zero _).symm
            · exact (Fin.succ_ne_zero _).symm
          have htail : Fin.tail (v ∘ Equiv.swap j.succ.castSucc j.succ.succ) =
              Fin.tail v ∘ Equiv.swap j.castSucc j.succ := by
            funext l
            simp only [Fin.tail, Function.comp_apply]
            rw [Function.Injective.map_swap (Fin.succ_injective _), Fin.succ_castSucc]
          rw [h0, htail]
          have hd : DifferentiableAt ℝ (iteratedFDeriv ℝ (k + 2) g) y :=
            hgy.differentiableAt_iteratedFDeriv
              (WithTop.coe_lt_coe.mpr (ENat.natCast_lt_top (k + 2)))
          rw [← fderiv_continuousMultilinear_apply_const_apply hd
                (Fin.tail v ∘ Equiv.swap j.castSucc j.succ) (v 0),
              ← fderiv_continuousMultilinear_apply_const_apply hd (Fin.tail v) (v 0)]
          congr 1
          apply Filter.EventuallyEq.fderiv_eq
          filter_upwards [hU.mem_nhds hy] with y' hy'
          exact ih g hg y' hy' _ _
        show iteratedFDeriv ℝ (k + 2 + 1) g y (u ∘ τ) = iteratedFDeriv ℝ (k + 2 + 1) g y u
        refine hperm (k + 2) (iteratedFDeriv ℝ (k + 2 + 1) g y) ?_ u τ
        intro i v
        refine Fin.cases ?_ (fun j => ?_) i
        · exact hzero v
        · exact hsucc j v
    rcases m with _ | _ | k
    · congr 1; funext i; exact Fin.elim0 i
    · congr 1; funext i; simp only [Function.comp_apply]; congr 1
      exact Fin.ext (by have := (σ i).isLt; have := i.isLt; omega)
    · exact Q k f hf z hz w σ


  have pbG : ∀ {E E' V : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup E']
      [NormedSpace ℝ E'] [NormedAddCommGroup V] [NormedSpace ℝ V] (O : Set E) (h : E → V) (c : E)
      (M : E' →L[ℝ] E) (y0 : E') (n : ℕ), IsOpen O → ContDiffOn ℝ ∞ h O → c + M y0 ∈ O →
      iteratedFDeriv ℝ n (fun y => h (c + M y)) y0 =
        (iteratedFDeriv ℝ n h (c + M y0)).compContinuousLinearMap (fun _ => M) := by
    intro E E' V _ _ _ _ _ _ O h c M y0 n hO hh hc
    have hO1o : IsOpen {z : E | c + z ∈ O} := hO.preimage (continuous_const.add continuous_id)
    have hh1 : ContDiffOn ℝ ∞ (fun z => h (c + z)) {z : E | c + z ∈ O} :=
      hh.comp (contDiff_const.add contDiff_id).contDiffOn (fun z hz => hz)
    have hO2o : IsOpen (M ⁻¹' {z : E | c + z ∈ O}) := hO1o.preimage M.continuous
    have hy0 : y0 ∈ M ⁻¹' {z : E | c + z ∈ O} := hc
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := (fun z => h (c + z)) ∘ M) n hO2o hy0
    have e2 := M.iteratedFDerivWithin_comp_right hh1 hO1o.uniqueDiffOn hO2o.uniqueDiffOn hy0 (i := n)
      (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => h (c + z)) n hO1o
      (show M y0 ∈ {z : E | c + z ∈ O} from hc)
    rw [iteratedFDeriv_comp_add_left] at e3
    show iteratedFDeriv ℝ n ((fun z => h (c + z)) ∘ M) y0 = _
    rw [← e1, e2, e3]


  have mvG : ∃ B : (Fin 3 → Fin 3 → ℝ) →L[ℝ] (Fin 3 → ℂ) →L[ℝ] (Fin 3 → ℂ), ‖B‖ ≤ 3 ∧
      ∀ (M : Matrix (Fin 3) (Fin 3) ℝ) (z : Fin 3 → ℂ),
        B (fun i j => M i j) z = Matrix.mulVec (M.map (fun a : ℝ => (a : ℂ))) z := by
    let B0 : (Fin 3 → Fin 3 → ℝ) →ₗ[ℝ] (Fin 3 → ℂ) →ₗ[ℝ] (Fin 3 → ℂ) :=
      LinearMap.mk₂ ℝ (fun M z => fun i => ∑ j, ((M i j : ℝ) : ℂ) * z j)
        (fun M1 M2 z => by
          funext i
          simp only [Pi.add_apply, Complex.ofReal_add, add_mul, Finset.sum_add_distrib])
        (fun c M z => by
          funext i
          simp only [Pi.smul_apply, smul_eq_mul, Complex.ofReal_mul, Complex.real_smul,
            Finset.mul_sum]
          exact Finset.sum_congr rfl (fun _ _ => by ring))
        (fun M z1 z2 => by
          funext i
          simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib])
        (fun c M z => by
          funext i
          simp only [Pi.smul_apply, Complex.real_smul, Finset.mul_sum]
          exact Finset.sum_congr rfl (fun _ _ => by ring))
    have hb : ∀ M z, ‖B0 M z‖ ≤ 3 * ‖M‖ * ‖z‖ := by
      intro M z
      refine (pi_norm_le_iff_of_nonneg (by positivity)).2 (fun i => ?_)
      show ‖∑ j, ((M i j : ℝ) : ℂ) * z j‖ ≤ _
      calc ‖∑ j, ((M i j : ℝ) : ℂ) * z j‖ ≤ ∑ j, ‖((M i j : ℝ) : ℂ) * z j‖ := norm_sum_le _ _
        _ ≤ ∑ j : Fin 3, ‖M‖ * ‖z‖ := Finset.sum_le_sum (fun j _ => by
            rw [norm_mul, Complex.norm_real]
            exact mul_le_mul ((norm_le_pi_norm (M i) j).trans (norm_le_pi_norm M i))
              (norm_le_pi_norm z j) (norm_nonneg _) (norm_nonneg _))
        _ = 3 * ‖M‖ * ‖z‖ := by simp; ring
    refine ⟨B0.mkContinuous₂ 3 hb, LinearMap.mkContinuous₂_norm_le _ (by norm_num) hb, fun M z => ?_⟩
    show (fun i => ∑ j, ((M i j : ℝ) : ℂ) * z j) = _
    funext i
    simp [Matrix.mulVec, dotProduct, Matrix.map_apply]


  have lbG : ∀ {X X' F G H : Type} [NormedAddCommGroup X] [NormedSpace ℝ X] [NormedAddCommGroup X']
      [NormedSpace ℝ X'] [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G]
      [NormedSpace ℝ G] [NormedAddCommGroup H] [NormedSpace ℝ H] (B : F →L[ℝ] G →L[ℝ] H) (φ : X → F)
      (ψ : X → G) (O : Set X) (x0 : X) (M : X' →L[ℝ] X) (n : ℕ), IsOpen O → x0 ∈ O →
      ContDiffOn ℝ ∞ φ O → ContDiffOn ℝ ∞ ψ O →
      ‖(iteratedFDeriv ℝ n (fun w => B (φ w) (ψ w)) x0).compContinuousLinearMap (fun _ => M)‖ ≤
        ‖B‖ * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
          ‖(iteratedFDeriv ℝ i φ x0).compContinuousLinearMap (fun _ => M)‖ *
          ‖(iteratedFDeriv ℝ (n - i) ψ x0).compContinuousLinearMap (fun _ => M)‖ := by
    intro X X' F G H _ _ _ _ _ _ _ _ _ _ B φ ψ O x0 M n hO hx hφ hψ
    have hO' : IsOpen {y : X' | x0 + M y ∈ O} := hO.preimage (continuous_const.add M.continuous)
    have h0 : (0 : X') ∈ {y : X' | x0 + M y ∈ O} := by simp [hx]
    have hx0 : x0 + M 0 = x0 := by simp
    have hcomp : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (g : X → W),
        ContDiffOn ℝ ∞ g O → ContDiffOn ℝ ∞ (fun y => g (x0 + M y)) {y : X' | x0 + M y ∈ O} :=
      fun g hg => hg.comp (contDiff_const.add M.contDiff).contDiffOn (fun y hy => hy)
    have hpb : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (g : X → W),
        ContDiffOn ℝ ∞ g O → ∀ j : ℕ, iteratedFDeriv ℝ j (fun y => g (x0 + M y)) 0 =
          (iteratedFDeriv ℝ j g x0).compContinuousLinearMap (fun _ => M) := by
      intro W _ _ g hg j
      have := pbG O g x0 M 0 j hO hg (by rw [hx0]; exact hx)
      rw [hx0] at this
      exact this
    have hBc : ContDiffOn ℝ ∞ (fun w => B (φ w) (ψ w)) O :=
      (B.contDiff.comp_contDiffOn hφ).clm_apply hψ
    have key := B.norm_iteratedFDerivWithin_le_of_bilinear (hcomp φ hφ) (hcomp ψ hψ)
      hO'.uniqueDiffOn h0 (n := n) (by exact_mod_cast le_top)
    calc ‖(iteratedFDeriv ℝ n (fun w => B (φ w) (ψ w)) x0).compContinuousLinearMap (fun _ => M)‖
        = ‖iteratedFDerivWithin ℝ n (fun y => B (φ (x0 + M y)) (ψ (x0 + M y)))
            {y : X' | x0 + M y ∈ O} 0‖ := by
          rw [iteratedFDerivWithin_of_isOpen n hO' h0, ← hpb _ hBc n]
      _ ≤ _ := key
      _ = _ := by
          congr 1
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [iteratedFDerivWithin_of_isOpen i hO' h0, iteratedFDerivWithin_of_isOpen (n - i) hO' h0,
            hpb φ hφ i, hpb ψ hψ (n - i)]


  have sbG : ∀ {E V : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup V]
      [NormedSpace ℝ V] (n : ℕ) (T : ContinuousMultilinearMap ℝ (fun _ : Fin (n + 1) => E × ℝ) V)
      (α β : ℝ), 0 ≤ α → 0 ≤ β →
      (∀ a : Fin (n + 1) → E, ‖T (fun i => (a i, (0 : ℝ)))‖ ≤ α * ∏ i, ‖a i‖) →
      (∀ (z : Fin (n + 1) → E × ℝ) (j : Fin (n + 1)), (z j).1 = 0 → ‖T z‖ ≤ β * ∏ i, ‖z i‖) →
      ‖T‖ ≤ 2 ^ (n + 1) * (α + β) := by
    intro E V _ _ _ _ n T α β hα0 hβ0 hα hβ
    refine ContinuousMultilinearMap.opNorm_le_bound (by positivity) (fun m => ?_)
    obtain ⟨ma, hma⟩ : ∃ ma : Fin (n + 1) → E × ℝ, ma = fun i => ((m i).1, (0 : ℝ)) := ⟨_, rfl⟩
    obtain ⟨mt, hmt⟩ : ∃ mt : Fin (n + 1) → E × ℝ, mt = fun i => ((0 : E), (m i).2) := ⟨_, rfl⟩
    have hm : m = ma + mt := by
      funext i
      rw [hma, hmt]
      refine Prod.ext ?_ ?_ <;> simp
    have hP : 0 ≤ ∏ i, ‖m i‖ := Finset.prod_nonneg (fun i _ => norm_nonneg _)
    have hterm : ∀ S : Finset (Fin (n + 1)), ‖T (S.piecewise ma mt)‖ ≤ (α + β) * ∏ i, ‖m i‖ := by
      intro S
      have hz : ∀ i, ‖S.piecewise ma mt i‖ ≤ ‖m i‖ := by
        intro i
        by_cases hi : i ∈ S
        · rw [Finset.piecewise_eq_of_mem _ _ _ hi, hma, Prod.norm_def]
          show max ‖(m i).1‖ ‖(0 : ℝ)‖ ≤ ‖m i‖
          exact max_le (norm_fst_le _) (by simp)
        · rw [Finset.piecewise_eq_of_notMem _ _ _ hi, hmt, Prod.norm_def]
          show max ‖(0 : E)‖ ‖(m i).2‖ ≤ ‖m i‖
          exact max_le (by simp) (norm_snd_le _)
      have hzP : ∏ i, ‖S.piecewise ma mt i‖ ≤ ∏ i, ‖m i‖ :=
        Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) (fun i _ => hz i)
      by_cases hS : S = Finset.univ
      · subst hS
        rw [Finset.piecewise_univ, hma]
        calc ‖T (fun i => ((m i).1, (0 : ℝ)))‖ ≤ α * ∏ i, ‖(m i).1‖ := hα (fun i => (m i).1)
          _ ≤ α * ∏ i, ‖m i‖ := mul_le_mul_of_nonneg_left
              (Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) (fun i _ => norm_fst_le _)) hα0
          _ ≤ (α + β) * ∏ i, ‖m i‖ := mul_le_mul_of_nonneg_right (by linarith) hP
      · obtain ⟨j, hj⟩ : ∃ j, j ∉ S := by
          by_contra h
          push_neg at h
          exact hS (Finset.eq_univ_iff_forall.mpr h)
        have h1 : (S.piecewise ma mt j).1 = 0 := by
          rw [Finset.piecewise_eq_of_notMem _ _ _ hj, hmt]
        calc ‖T (S.piecewise ma mt)‖ ≤ β * ∏ i, ‖S.piecewise ma mt i‖ := hβ _ j h1
          _ ≤ β * ∏ i, ‖m i‖ := mul_le_mul_of_nonneg_left hzP hβ0
          _ ≤ (α + β) * ∏ i, ‖m i‖ := mul_le_mul_of_nonneg_right (by linarith) hP
    calc ‖T m‖ = ‖∑ S : Finset (Fin (n + 1)), T (S.piecewise ma mt)‖ := by
          rw [← T.map_add_univ, ← hm]
      _ ≤ ∑ S : Finset (Fin (n + 1)), ‖T (S.piecewise ma mt)‖ := norm_sum_le _ _
      _ ≤ ∑ S : Finset (Fin (n + 1)), (α + β) * ∏ i, ‖m i‖ :=
          Finset.sum_le_sum (fun S _ => hterm S)
      _ = 2 ^ (n + 1) * (α + β) * ∏ i, ‖m i‖ := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_finset, Fintype.card_fin, nsmul_eq_mul]
          push_cast
          ring


  have srG : ∀ (k : ℕ) (E : ℕ → ℝ) (Q Bm : ℝ), 0 ≤ Q → 0 ≤ Bm → E 0 ≤ Bm →
      (∀ n : ℕ, n + 1 ≤ k → E (n + 1) ≤ 2 ^ (n + 1) * (2 * Bm + 3 * ∑ i ∈ Finset.range (n + 1),
        (n.choose i : ℝ) * Q * E (n - i))) →
      E k ≤ (4 ^ k * 4 * (1 + Q)) ^ (k + 1) * Bm := by
    intro k E Q Bm hQ hB h0 hs
    obtain ⟨X, hX⟩ : ∃ X : ℝ, X = 4 ^ k * 4 * (1 + Q) := ⟨_, rfl⟩
    rw [← hX]
    have h4 : (1 : ℝ) ≤ 4 ^ k := one_le_pow₀ (by norm_num)
    have hX1 : 1 ≤ X := by
      rw [hX]
      calc (1 : ℝ) = 1 * 1 * 1 := by norm_num
        _ ≤ 4 ^ k * 4 * (1 + Q) := by gcongr <;> linarith
    have main : ∀ n, n ≤ k → E n ≤ X ^ n * Bm := by
      intro n
      induction n using Nat.strong_induction_on with
      | _ n ih =>
        intro hn
        rcases n with _ | n
        · simpa using h0
        · have hih : ∀ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * Q * E (n - i) ≤
              (n.choose i : ℝ) * Q * (X ^ n * Bm) := by
            intro i hi
            have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
            have h1 : E (n - i) ≤ X ^ (n - i) * Bm := ih (n - i) (by omega) (by omega)
            have h2 : X ^ (n - i) ≤ X ^ n := pow_le_pow_right₀ hX1 (by omega)
            have h3 : E (n - i) ≤ X ^ n * Bm := h1.trans (mul_le_mul_of_nonneg_right h2 hB)
            exact mul_le_mul_of_nonneg_left h3 (mul_nonneg (Nat.cast_nonneg _) hQ)
          have hsum : ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * Q * E (n - i) ≤
              2 ^ n * Q * (X ^ n * Bm) := by
            calc _ ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * Q * (X ^ n * Bm) :=
                  Finset.sum_le_sum hih
              _ = (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ)) * Q * (X ^ n * Bm) := by
                  rw [Finset.sum_mul, Finset.sum_mul]
              _ = 2 ^ n * Q * (X ^ n * Bm) := by
                  rw [← Nat.cast_sum, Nat.sum_range_choose]
                  push_cast
                  ring
          have hXn : 1 ≤ X ^ n := one_le_pow₀ hX1
          have h2n : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
          have h5 : (1 : ℝ) ≤ 2 ^ n * X ^ n := by
            calc (1 : ℝ) = 1 * 1 := by norm_num
              _ ≤ 2 ^ n * X ^ n := by gcongr
          have h6 : Bm ≤ 2 ^ n * X ^ n * Bm := le_mul_of_one_le_left hB h5
          have hQP : 0 ≤ Q * (2 ^ n * X ^ n * Bm) := by positivity
          have h7 : (2 : ℝ) ^ (2 * n + 1) ≤ 4 ^ k := by
            calc (2 : ℝ) ^ (2 * n + 1) ≤ 2 ^ (2 * k) := pow_le_pow_right₀ (by norm_num) (by omega)
              _ = 4 ^ k := by rw [pow_mul]; norm_num
          have h8 : 0 ≤ 4 * (1 + Q) * X ^ n * Bm := by positivity
          calc E (n + 1) ≤ 2 ^ (n + 1) * (2 * Bm + 3 * ∑ i ∈ Finset.range (n + 1),
                (n.choose i : ℝ) * Q * E (n - i)) := hs n hn
            _ ≤ 2 ^ (n + 1) * (2 * Bm + 3 * (2 ^ n * Q * (X ^ n * Bm))) := by gcongr
            _ ≤ 2 ^ (n + 1) * (2 ^ n * 4 * (1 + Q) * X ^ n * Bm) := by
                apply mul_le_mul_of_nonneg_left _ (by positivity)
                nlinarith
            _ = 2 ^ (2 * n + 1) * (4 * (1 + Q) * X ^ n * Bm) := by ring
            _ ≤ 4 ^ k * (4 * (1 + Q) * X ^ n * Bm) := mul_le_mul_of_nonneg_right h7 h8
            _ = X ^ (n + 1) * Bm := by rw [hX]; ring
    calc E k ≤ X ^ k * Bm := main k le_rfl
      _ ≤ X ^ (k + 1) * Bm := mul_le_mul_of_nonneg_right (pow_le_pow_right₀ hX1 (Nat.le_succ k)) hB


  obtain ⟨Λ', hΛ'⟩ : ∃ M : (Cyl × ℝ) →L[ℝ] (Cyl × ℝ),
      M = Λ.prodMap (ContinuousLinearMap.id ℝ ℝ) := ⟨_, rfl⟩
  rw [← hΛ'] at hcoef hGj ⊢
  obtain ⟨O, hOdef⟩ : ∃ O : Set (Cyl × ℝ), O = U ×ˢ J := ⟨_, rfl⟩
  rw [← hOdef] at hZ hA hG
  have hO : IsOpen O := by rw [hOdef]; exact hU.prod hJ
  have hx0 : ((p0, v) : Cyl × ℝ) ∈ O := by rw [hOdef]; exact ⟨hp0, hv⟩
  obtain ⟨B, hB3, hB⟩ := mvG
  obtain ⟨e, he⟩ : ∃ e : Cyl × ℝ, e = ((0 : Cyl), (1 : ℝ)) := ⟨_, rfl⟩
  obtain ⟨g1, hg1⟩ : ∃ g : Cyl × ℝ → (Fin 3 → ℂ), g = fun w => fderiv ℝ Z w e := ⟨_, rfl⟩
  obtain ⟨g2, hg2⟩ : ∃ g : Cyl × ℝ → (Fin 3 → ℂ),
      g = fun w => B (fun i j' => Ar w i j') (Z w) - Gs w := ⟨_, rfl⟩
  have hsymm := symmG O Z hO hZ (p0, v) hx0

  have hpt : ∀ w ∈ O, g1 w = g2 w := by
    intro w hw
    have hw' : w.1 ∈ U ∧ w.2 ∈ J := by rw [hOdef] at hw; exact hw
    have hfd : DifferentiableAt ℝ Z w :=
      (hZ.contDiffAt (hO.mem_nhds hw)).differentiableAt (by simp)
    have hγ : HasDerivAt (fun r : ℝ => ((w.1, r) : Cyl × ℝ)) ((0 : Cyl), (1 : ℝ)) w.2 :=
      (hasDerivAt_const w.2 w.1).prodMk (hasDerivAt_id w.2)
    have h1 : HasDerivAt (fun v'' => Z (w.1, v'')) (fderiv ℝ Z w ((0 : Cyl), (1 : ℝ))) w.2 :=
      hfd.hasFDerivAt.comp_hasDerivAt w.2 hγ
    have h2 := h1.unique (hode w.1 hw'.1 w.2 hw'.2)
    rw [hg1, hg2]
    show fderiv ℝ Z w e = B (fun i j' => Ar w i j') (Z w) - Gs w
    rw [he, hB (Ar w) (Z w)]
    exact h2
  have hfd' : ContDiffOn ℝ ∞ (fderiv ℝ Z) O := ((contDiffOn_infty_iff_fderiv_of_isOpen hO).mp hZ).2

  have hjet : ∀ n : ℕ, iteratedFDeriv ℝ n g1 (p0, v) = iteratedFDeriv ℝ n g2 (p0, v) := by
    intro n
    have hev : g1 =ᶠ[nhds ((p0, v) : Cyl × ℝ)] g2 := by
      filter_upwards [hO.mem_nhds hx0] with w hw
      exact hpt w hw
    exact (hev.iteratedFDeriv ℝ n).eq_of_nhds
  have hg1comp : ∀ n : ℕ, iteratedFDeriv ℝ n g1 (p0, v) =
      (ContinuousLinearMap.apply ℝ (Fin 3 → ℂ) e).compContinuousMultilinearMap
        (iteratedFDeriv ℝ n (fun y => fderiv ℝ Z y) (p0, v)) := by
    intro n
    rw [hg1]
    exact (ContinuousLinearMap.apply ℝ (Fin 3 → ℂ) e).iteratedFDeriv_comp_left
      (hfd'.contDiffAt (hO.mem_nhds hx0)) (i := n) (by exact_mod_cast le_top)

  have hlastslot : ∀ n : ℕ, ∀ (w : Fin (n + 1) → Cyl × ℝ) (c : ℝ), w (Fin.last n) = c • e →
      iteratedFDeriv ℝ (n + 1) Z (p0, v) w = c • iteratedFDeriv ℝ n g2 (p0, v) (Fin.init w) := by
    intro n w c hw
    rw [iteratedFDeriv_succ_apply_right, hw, ContinuousLinearMap.map_smul, ← hjet n, hg1comp n]
    rfl
  have htime : ∀ n : ℕ, ∀ (z : Fin (n + 1) → Cyl × ℝ) (j : Fin (n + 1)), (z j).1 = 0 →
      ‖((iteratedFDeriv ℝ (n + 1) Z (p0, v)).compContinuousLinearMap (fun _ => Λ')) z‖ ≤
        ‖(iteratedFDeriv ℝ n g2 (p0, v)).compContinuousLinearMap (fun _ => Λ')‖ * ∏ i, ‖z i‖ := by
    intro n z j hj
    obtain ⟨σ, hσ⟩ : ∃ σ : Equiv.Perm (Fin (n + 1)), σ = Equiv.swap j (Fin.last n) := ⟨_, rfl⟩
    obtain ⟨w, hw⟩ : ∃ w : Fin (n + 1) → Cyl × ℝ, w = fun i => Λ' (z (σ i)) := ⟨_, rfl⟩
    have hT : ((iteratedFDeriv ℝ (n + 1) Z (p0, v)).compContinuousLinearMap (fun _ => Λ')) z =
        iteratedFDeriv ℝ (n + 1) Z (p0, v) w := by
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, hw]
      exact (hsymm (n + 1) (fun i => Λ' (z i)) σ).symm
    have hwl : w (Fin.last n) = (z j).2 • e := by
      rw [hw, hσ, he]
      simp only [Equiv.swap_apply_right]
      refine Prod.ext ?_ ?_ <;> simp [hΛ', hj]
    have hy : Fin.init w = fun i => Λ' (z (σ (Fin.castSucc i))) := by
      rw [hw]; rfl
    rw [hT, hlastslot n w _ hwl, norm_smul, hy]
    have hle := ContinuousMultilinearMap.le_opNorm
      ((iteratedFDeriv ℝ n g2 (p0, v)).compContinuousLinearMap (fun _ => Λ'))
      (fun i => z (σ (Fin.castSucc i)))
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply] at hle
    have hc : ‖(z j).2‖ ≤ ‖z (σ (Fin.last n))‖ := by
      rw [hσ, Equiv.swap_apply_right]; exact norm_snd_le _
    have hprod : ∏ i, ‖z i‖ = (∏ i : Fin n, ‖z (σ (Fin.castSucc i))‖) * ‖z (σ (Fin.last n))‖ := by
      rw [← Fin.prod_univ_castSucc (fun i => ‖z (σ i)‖)]
      exact (Equiv.prod_comp σ (fun i => ‖z i‖)).symm
    rw [hprod]
    calc ‖(z j).2‖ * ‖iteratedFDeriv ℝ n g2 (p0, v) (fun i => Λ' (z (σ (Fin.castSucc i))))‖
        ≤ ‖z (σ (Fin.last n))‖ * (‖(iteratedFDeriv ℝ n g2 (p0, v)).compContinuousLinearMap
            (fun _ => Λ')‖ * ∏ i : Fin n, ‖z (σ (Fin.castSucc i))‖) :=
          mul_le_mul hc hle (norm_nonneg _) (norm_nonneg _)
      _ = ‖(iteratedFDeriv ℝ n g2 (p0, v)).compContinuousLinearMap (fun _ => Λ')‖ *
            ((∏ i : Fin n, ‖z (σ (Fin.castSucc i))‖) * ‖z (σ (Fin.last n))‖) := by ring

  have hslowpb : ∀ j : ℕ, iteratedFDeriv ℝ j (fun p : Cyl => Z (p, v)) p0 =
      (iteratedFDeriv ℝ j Z (p0, v)).compContinuousLinearMap
        (fun _ => ContinuousLinearMap.inl ℝ Cyl ℝ) := by
    intro j
    have hc : ((0 : Cyl), v) + ContinuousLinearMap.inl ℝ Cyl ℝ p0 = (p0, v) := by simp
    have h1 := pbG O Z ((0 : Cyl), v) (ContinuousLinearMap.inl ℝ Cyl ℝ) p0 j hO hZ
      (by rw [hc]; exact hx0)
    have hfun : (fun y => Z (((0 : Cyl), v) + ContinuousLinearMap.inl ℝ Cyl ℝ y)) =
        fun p : Cyl => Z (p, v) := by
      funext y; simp
    rw [hc, hfun] at h1
    exact h1
  have hslowb : ∀ n : ℕ, n ≤ k → ∀ a : Fin n → Cyl,
      ‖((iteratedFDeriv ℝ n Z (p0, v)).compContinuousLinearMap (fun _ => Λ'))
        (fun i => (a i, (0 : ℝ)))‖ ≤ Bm * ∏ i, ‖a i‖ := by
    intro n hn a
    have h1 := ContinuousMultilinearMap.le_opNorm
      ((iteratedFDeriv ℝ n (fun p : Cyl => Z (p, v)) p0).compContinuousLinearMap (fun _ => Λ)) a
    have h2 : ((iteratedFDeriv ℝ n Z (p0, v)).compContinuousLinearMap (fun _ => Λ'))
        (fun i => (a i, (0 : ℝ))) =
        ((iteratedFDeriv ℝ n (fun p : Cyl => Z (p, v)) p0).compContinuousLinearMap (fun _ => Λ)) a := by
      rw [hslowpb n]
      simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      congr 1
      funext i
      rw [hΛ']
      simp
    rw [h2]
    exact h1.trans (mul_le_mul_of_nonneg_right (hslow n hn)
      (Finset.prod_nonneg (fun i _ => norm_nonneg _)))

  obtain ⟨E, hE⟩ : ∃ E : ℕ → ℝ,
      E = fun n => ‖(iteratedFDeriv ℝ n Z (p0, v)).compContinuousLinearMap (fun _ => Λ')‖ :=
    ⟨_, rfl⟩
  have hEn : ∀ n, E n = ‖(iteratedFDeriv ℝ n Z (p0, v)).compContinuousLinearMap (fun _ => Λ')‖ :=
    fun n => by rw [hE]
  have hE0 : E 0 ≤ Bm := by
    rw [hEn]
    refine ContinuousMultilinearMap.opNorm_le_bound hBm (fun m => ?_)
    have h1 := ContinuousMultilinearMap.le_opNorm
      ((iteratedFDeriv ℝ 0 (fun p : Cyl => Z (p, v)) p0).compContinuousLinearMap (fun _ => Λ))
      (fun i => Fin.elim0 i)
    have h2 := hslow 0 (Nat.zero_le _)
    simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_zero_apply,
      Finset.univ_eq_empty, Finset.prod_empty, mul_one] at h1 ⊢
    linarith
  have hh1s : ContDiffOn ℝ ∞ (fun w => B (fun i j' => Ar w i j') (Z w)) O :=
    (B.contDiff.comp_contDiffOn hA).clm_apply hZ
  have hrec : ∀ n : ℕ, n + 1 ≤ k → E (n + 1) ≤ 2 ^ (n + 1) * (2 * Bm + 3 * ∑ i ∈ Finset.range (n + 1),
      (n.choose i : ℝ) * Q * E (n - i)) := by
    intro n hn
    have hsb := sbG n ((iteratedFDeriv ℝ (n + 1) Z (p0, v)).compContinuousLinearMap (fun _ => Λ')) Bm
      ‖(iteratedFDeriv ℝ n g2 (p0, v)).compContinuousLinearMap (fun _ => Λ')‖ hBm (norm_nonneg _)
      (hslowb (n + 1) hn) (htime n)
    have hl := lbG B (fun pv : Cyl × ℝ => fun i j' : Fin 3 => Ar pv i j') Z O (p0, v) Λ' n hO hx0 hA hZ
    have hH : ‖(iteratedFDeriv ℝ n (fun w => B (fun i j' => Ar w i j') (Z w)) (p0, v)).compContinuousLinearMap
        (fun _ => Λ')‖ ≤ 3 * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * Q * E (n - i) := by
      refine hl.trans ?_
      apply mul_le_mul hB3 _ (Finset.sum_nonneg (fun i _ => by positivity)) (by norm_num)
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      rw [hEn]
      have hq := hcoef i (by omega)
      have hnn : 0 ≤ ‖(iteratedFDeriv ℝ (n - i) Z (p0, v)).compContinuousLinearMap (fun _ => Λ')‖ :=
