    have hXu : XC B.h ((u * ξ0.1, ξ0.2.1, ξ0.2.2.1, (0 : ℝ × ℝ)) : Cyl) = u ^ 2 * XC B.h ξ0 := by
      show (u * ξ0.1) ^ 2 / (2 * qC B.h ξ0) = u ^ 2 * (ξ0.1 ^ 2 / (2 * qC B.h ξ0))
      ring
    have hNBu : NB B.h F i ((u * ξ0.1, ξ0.2.1, ξ0.2.2.1, (0 : ℝ × ℝ)) : Cyl) ≤
        C0 * qC B.h ξ0 ^ (B.h * α) * SC B.h ξ0 ^ b * W := by
      by_cases hsh : B.Xa < u ^ 2 * XC B.h ξ0 ∧ u ^ 2 * XC B.h ξ0 < B.Xb
      · have h1 := hNB i hi _ hξu (by rw [hXu]; exact hsh.1) (by rw [hXu]; exact hsh.2)
        rw [hXu] at h1
        have h2 := hW u hu.1 hu.2 hsh.1 hsh.2
        calc NB B.h F i ((u * ξ0.1, ξ0.2.1, ξ0.2.2.1, (0 : ℝ × ℝ)) : Cyl)
            ≤ C0 * qC B.h ξ0 ^ (B.h * α) * SC B.h ξ0 ^ b * sgc5w B d (u ^ 2 * XC B.h ξ0) := h1
          _ ≤ C0 * qC B.h ξ0 ^ (B.h * α) * SC B.h ξ0 ^ b * W := mul_le_mul_of_nonneg_left h2 hCQ
      · have hX : XC B.h ((u * ξ0.1, ξ0.2.1, ξ0.2.2.1, (0 : ℝ × ℝ)) : Cyl) ≤ B.Xa ∨
            B.Xb ≤ XC B.h ((u * ξ0.1, ξ0.2.1, ξ0.2.2.1, (0 : ℝ × ℝ)) : Cyl) := by
          rw [hXu]
          by_contra hcon
          push_neg at hcon
          exact hsh ⟨hcon.1, hcon.2⟩
        have hz := hbdry i _ hξu hX
        have h0 : NB B.h F i ((u * ξ0.1, ξ0.2.1, ξ0.2.2.1, (0 : ℝ × ℝ)) : Cyl) = 0 := by
          unfold NB
          rw [hz]
          have hz0 : (0 : ContinuousMultilinearMap ℝ (fun _ : Fin i => Cyl) ℝ).compContinuousLinearMap
