theorem temp_moments_gen_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
    l1 ≤ l0 → ∀ (S : CState) (bw ca H : ℝ), 7/10 ≤ bw → bw ≤ H → 9/10 ≤ H → ca ≤ H + 1 - 2 * kapS →
    StOrd5 B G l0 S bw ca H H → TInv5 B G l0 S H → TPot5 B G l0 S H → TMean5 B G l0 S →
    (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 →
      radMom (mcor5 B G l0 (tempState5 B G l0 S) 1) 2 z t = 0) ∧
    (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 →
      radMom (mcor5 B G l0 (tempState5 B G l0 S) 2) 1 z t = 0) :=
by
  intro B G hok _hG
  refine ⟨0, ?_⟩
  intro l0 _ S bw ca H _ _ _ _ hSt hI hP hM
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hqpos : ∀ z t : ℝ, t < 1 → 0 < simScale B.h z (1 - t) := fun z t ht =>
    (hok.1.1 z (1 - t) (by linarith)).1
  have hmem : ∀ (z t r : ℝ) (Y : ℝ × ℝ), t < 1 → simScale B.h z (1 - t) < qsOf l0 → 0 < r →
      ((r, z, t, Y) : Cyl) ∈ DomC B.h (qsOf l0) := fun z t r Y ht hq hr =>
    show 0 < r ∧ t < 1 ∧ simScale B.h z (1 - t) < qsOf l0 from ⟨hr, ht, hq⟩

  have hGeq : ∀ (e : ℝ) (f : Cyl → ℝ) (z t r : ℝ) (Y : ℝ × ℝ), t < 1 →
      simScale B.h z (1 - t) ^ (-e) * nrm B e f (r, z, t, Y) = f (r, z, t, Y) := by
    intro e f z t r Y ht
    have hq := hqpos z t ht
    show simScale B.h z (1 - t) ^ (-e) * (simScale B.h z (1 - t) ^ e * f (r, z, t, Y)) = _
    rw [← mul_assoc, ← Real.rpow_add hq, neg_add_cancel, Real.rpow_zero, one_mul]

  have hG : ∀ (α e : ℝ) (f : Cyl → ℝ), InM B (qsOf l0) α (nrm B e f) →
      ∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → ∀ c : ℝ, 0 < c →
      Continuous (fun p : ℝ × (ℝ × ℝ) =>
        simScale B.h z (1 - t) ^ (-e) * nrm B e f (max p.1 c, z, t, p.2)) := by
    intro α e f hf z t ht hq c hc
    have hcont : ContinuousOn (nrm B e f) (DomC B.h (qsOf l0)) := hf.1.continuousOn
    have hφ : Continuous (fun p : ℝ × (ℝ × ℝ) => ((max p.1 c, z, t, p.2) : Cyl)) :=
      (continuous_fst.max continuous_const).prodMk
        (continuous_const.prodMk (continuous_const.prodMk continuous_snd))
    have h2 : Continuous (fun p : ℝ × (ℝ × ℝ) => nrm B e f (max p.1 c, z, t, p.2)) :=
      hcont.comp_continuous hφ
        (fun p => hmem z t _ p.2 ht hq (lt_of_lt_of_le hc (le_max_right _ _)))
    exact continuous_const.mul h2

  have hslice : ∀ (α e : ℝ) (f : Cyl → ℝ), InM B (qsOf l0) α (nrm B e f) →
      ∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → ∀ r : ℝ, 0 < r →
      IntegrableOn (fun Y : ℝ × ℝ => f (r, z, t, Y)) (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := by
    intro α e f hf z t ht hq r hr
    have hc := hG α e f hf z t ht hq r hr
    have hc2 : Continuous (fun Y : ℝ × ℝ => f (r, z, t, Y)) := by
      have h3 := hc.comp
        (Continuous.prodMk continuous_const continuous_id : Continuous fun Y : ℝ × ℝ => (r, Y))
      refine h3.congr (fun Y => ?_)
      show simScale B.h z (1 - t) ^ (-e) * nrm B e f (max r r, z, t, Y) = f (r, z, t, Y)
      rw [max_self]
      exact hGeq e f z t r Y ht
    exact hc2.continuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)

  have hadd : ∀ (α1 α2 e1 e2 : ℝ) (g1 g2 g : Cyl → ℝ), InM B (qsOf l0) α1 (nrm B e1 g1) →
      InM B (qsOf l0) α2 (nrm B e2 g2) → (∀ ξ ∈ DomC B.h (qsOf l0), g ξ = g1 ξ + g2 ξ) →
      ∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → ∀ r : ℝ, 0 < r →
      yAvg g (r, z, t, 0) = yAvg g1 (r, z, t, 0) + yAvg g2 (r, z, t, 0) := by
    intro α1 α2 e1 e2 g1 g2 g h1 h2 heq z t ht hq r hr
    have e : (fun Y : ℝ × ℝ => g (r, z, t, Y)) = fun Y => g1 (r, z, t, Y) + g2 (r, z, t, Y) :=
      funext fun Y => heq _ (hmem z t r Y ht hq hr)
    show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (r, z, t, Y)) =
      (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g1 (r, z, t, Y)) +
        ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g2 (r, z, t, Y)
    rw [e]
    exact integral_add (hslice α1 e1 g1 h1 z t ht hq r hr) (hslice α2 e2 g2 h2 z t ht hq r hr)

  have hrad : ∀ (α e : ℝ) (f : Cyl → ℝ), InM B (qsOf l0) α (nrm B e f) →
      ∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → ∀ n : ℕ,
      IntegrableOn (fun r : ℝ => r ^ n * yAvg f (r, z, t, 0)) (Set.Ioi 0) := by
    intro α e f hf z t ht hq n
    obtain ⟨q, hqdef⟩ : ∃ q : ℝ, q = simScale B.h z (1 - t) := ⟨_, rfl⟩
    have hq0 : 0 < q := by rw [hqdef]; exact hqpos z t ht
    obtain ⟨a, ha⟩ : ∃ a : ℝ, a = min 1 (2 * B.Xa * q) := ⟨_, rfl⟩
    obtain ⟨b, hb⟩ : ∃ b : ℝ, b = max 1 (2 * B.Xb * q) := ⟨_, rfl⟩
    have ha0 : 0 < a := by rw [ha]; exact lt_min one_pos (by positivity)
    have hvan : ∀ r : ℝ, 0 < r → (r < a ∨ b < r) → yAvg f (r, z, t, 0) = 0 := by
      intro r hr hab
      have hz : ∀ Y : ℝ × ℝ, f (r, z, t, Y) = 0 := by
        intro Y
        have hX : XC B.h (r, z, t, Y) ≤ B.Xa ∨ B.Xb ≤ XC B.h (r, z, t, Y) := by
          have hXC : XC B.h (r, z, t, Y) = r ^ 2 / (2 * q) := by rw [hqdef]; rfl
          rw [hXC]
          rcases hab with h | h
          · left
            have h1 : r < 1 := lt_of_lt_of_le h (by rw [ha]; exact min_le_left _ _)
            have h2 : r < 2 * B.Xa * q := lt_of_lt_of_le h (by rw [ha]; exact min_le_right _ _)
            rw [div_le_iff₀ (by positivity)]
            nlinarith
          · right
            have h1 : 1 < r := lt_of_le_of_lt (by rw [hb]; exact le_max_left _ _) h
            have h2 : 2 * B.Xb * q < r := lt_of_le_of_lt (by rw [hb]; exact le_max_right _ _) h
            rw [le_div_iff₀ (by positivity)]
            nlinarith
        have h0 := hf.2.2.1 _ (hmem z t r Y ht hq hr) hX
        rw [← hGeq e f z t r Y ht, h0, mul_zero]
      show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, f (r, z, t, Y)) = 0
      simp only [hz, integral_zero]
    have hcG := hG α e f hf z t ht hq a ha0
    have hpc : Continuous (fun r : ℝ => ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
        simScale B.h z (1 - t) ^ (-e) * nrm B e f (max r a, z, t, Y)) :=
      continuous_parametric_integral_of_continuous hcG (isCompact_Icc.prod isCompact_Icc)
    have hIcc : IntegrableOn (fun r : ℝ => r ^ n * yAvg f (r, z, t, 0)) (Set.Icc a b) := by
      have hc3 : ContinuousOn (fun r : ℝ => r ^ n * ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
          simScale B.h z (1 - t) ^ (-e) * nrm B e f (max r a, z, t, Y)) (Set.Icc a b) :=
        ((continuous_pow n).mul hpc).continuousOn
      refine (hc3.integrableOn_compact isCompact_Icc).congr_fun (fun r hr => ?_) measurableSet_Icc
      have hra : a ≤ r := hr.1
      have hfun : (fun Y : ℝ × ℝ => simScale B.h z (1 - t) ^ (-e) * nrm B e f (max r a, z, t, Y)) =
          fun Y => f (r, z, t, Y) :=
        funext fun Y => by rw [max_eq_left hra]; exact hGeq e f z t r Y ht
      show r ^ n * (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
          simScale B.h z (1 - t) ^ (-e) * nrm B e f (max r a, z, t, Y)) = r ^ n * yAvg f (r, z, t, 0)
      exact congrArg (fun F : ℝ × ℝ → ℝ => r ^ n * ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, F Y) hfun
    refine hIcc.of_forall_sdiff_eq_zero measurableSet_Ioi (fun r hr => ?_)
    obtain ⟨hr0, hrn⟩ := hr
    have hr0' : 0 < r := hr0
    have hab : r < a ∨ b < r := by
      by_contra hc
      push_neg at hc
      exact hrn ⟨hc.1, hc.2⟩
    show r ^ n * yAvg f (r, z, t, 0) = 0
    rw [hvan r hr0' hab, mul_zero]

  unfold StOrd5 at hSt
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, c18, c19, -, -, c22, c23⟩ := hSt
  obtain ⟨hI1, -, -, hI4⟩ := hI
  obtain ⟨-, hP2, -, -, -, -, hP7⟩ := hP
  refine ⟨fun z t ht hq => ?_, fun z t ht hq => ?_⟩
  · have hpt : Set.EqOn (fun r : ℝ => r ^ 2 * yAvg (mcor5 B G l0 (tempState5 B G l0 S) 1) (r, z, t, 0))
        (fun r : ℝ => r ^ 2 * yAvg (mcor5 B G l0 S 1) (r, z, t, 0)) (Set.Ioi 0) := by
      intro r hr
      have hr0 : 0 < r := hr
      show r ^ 2 * yAvg (mcor5 B G l0 (tempState5 B G l0 S) 1) (r, z, t, 0) =
        r ^ 2 * yAvg (mcor5 B G l0 S 1) (r, z, t, 0)
      rw [hadd _ _ (Aex B.h) (Aex B.h) (mcor5 B G l0 S 1) (dvT5 B G l0 S)
        (mcor5 B G l0 (tempState5 B G l0 S) 1) c18 hI1 (fun ξ hξ => (hM ξ hξ).1) z t ht hq r hr0,
        (hI4 _ (hmem z t r 0 ht hq hr0)).1, add_zero]
    show (∫ r in Set.Ioi (0:ℝ), r ^ 2 * yAvg (mcor5 B G l0 (tempState5 B G l0 S) 1) (r, z, t, 0)) = 0
    exact (setIntegral_congr_fun measurableSet_Ioi hpt).trans (c22 z t ht hq)
  · have hpt : Set.EqOn (fun r : ℝ => r ^ 1 * yAvg (mcor5 B G l0 (tempState5 B G l0 S) 2) (r, z, t, 0))
        (fun r : ℝ => r ^ 1 * yAvg (mcor5 B G l0 S 2) (r, z, t, 0) +
          r ^ 1 * yAvg (fun ξ => dR B.h (PsiT5 B G l0 S) ξ + PsiT5 B G l0 S ξ / ξ.1) (r, z, t, 0))
        (Set.Ioi 0) := by
      intro r hr
      have hr0 : 0 < r := hr
      show r ^ 1 * yAvg (mcor5 B G l0 (tempState5 B G l0 S) 2) (r, z, t, 0) =
