      have h1 : ((Γ.filter (fun γ => ξ ∈ tsupport (etaL B.h γ))).card : ℝ) * M ≤ 162 * M :=
        mul_le_mul_of_nonneg_right hc' hM0
      have h2 := mul_le_mul_of_nonneg_left h1 hH0
