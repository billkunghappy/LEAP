  have W3 : profRadInt (fun x' e' => rfpU P x' e' ^ 2 - x' * rfpF P x' e' ^ 2) x η =
      η ^ 2 * K2 + ((1 + η ^ 2)⁻¹) ^ 2 *
        (P.Amp η ^ 2 * S0 + P.c1 η ^ 2 * S1 + P.c2 η ^ 2 * S2 - S00 / 2) := hMom2 η
  have W4 : profEtaD (profRadInt (fun x' e' => rfpU P x' e' ^ 2 - x' * rfpF P x' e' ^ 2)) x η =
