    have hBv := ((hP 0).2.2.2.2.1 x t hxt (Or.inl hr)).2.1
    show curl3 (fun w => fA5 B G l0 (st 0) w t) x + fB B G l0 (st 0) x t = curl3 (fun w => AB w t) x + BvB x t
    rw [hcurl, hBv]
    all_goals rfl

theorem ns_approximate_family : ∃ (h qs Xe Xin c e0 γ : ℝ) (ℓ K : ℕ → ℝ) (A Bv : ℕ → ℝ³ → ℝ → ℝ³) (P : ℕ → ℝ³ → ℝ → ℝ), 0 < h ∧ h < 1 / 2 ∧ 0 < qs ∧ qs ≤ 1 ∧ 0 < Xin ∧ Xin < Xe ∧ 0 < e0 ∧ 0 < γ ∧ ApproxFamily h qs Xe Xin c e0 γ ℓ K A Bv P :=
by
  obtain ⟨h, Xa, Xb, Xext, m1, m2, lam, cpatch, qB, c, aa, ab, F, U, T0th, T0z, AB, BvB, PB, Eb, Ub, Vb,
    Tth, Tz, hB⟩ := ns_background_exists
  have hB' := hB
  unfold BackgroundProps at hB'
  obtain ⟨⟨hh0, hh1, hXa, hXam1, hm12, hm2Xb, hXbXe, hqB0, hqB1, -, -, -, -⟩, ⟨-, -, hFpos, -⟩, -, -, -,
    hB5, ⟨-, -, -, hB6⟩, -, -, -, -, hB11⟩ := hB'
  have hh2 : h < 1 / 2 := by linarith
  have hS := simScale_props h hh0 hh2
  obtain ⟨qs, γ, ℓ, K, A, Bv, P, hC⟩ := ns_correction_family h Xa Xb Xext m1 m2 lam cpatch qB c aa ab
    F U T0th T0z AB BvB PB Eb Ub Vb Tth Tz hS hB
  unfold CorrectionFamily at hC
  obtain ⟨⟨hqs0, hqsB, hγ⟩, hC1, hC2, hC3, hC4, hC5, hC6, hC7⟩ := hC
  obtain ⟨hS1, -, -, -, -⟩ := hS
  obtain ⟨E0, hE0⟩ : ∃ E0 : ℝ, E0 = Real.sqrt (2 * (Xa / 2)) * F (Xa / 2) 0 := ⟨_, rfl⟩
  have hXin : 0 < Xa / 2 := by linarith
  have hE0pos : 0 < E0 := by
    rw [hE0]
    exact mul_pos (Real.sqrt_pos.mpr (by linarith)) (hFpos _ _ hXin (by norm_num) (by norm_num))
  have hdom : ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h qs →
      0 < simScale h (x 2) (1 - t) ∧ (x, t) ∈ simDomain h qB := by
    intro x t hxt
    have hxt' : t < 1 ∧ simScale h (x 2) (1 - t) < qs := hxt
    have hq := (hS1 (x 2) (1 - t) (by linarith [hxt'.1])).1
    exact ⟨hq, show t < 1 ∧ simScale h (x 2) (1 - t) < qB from
      ⟨hxt'.1, lt_of_lt_of_le hxt'.2 hqsB⟩⟩
  refine ⟨h, qs, Xext, Xa / 2, c, E0 / 4, γ, ℓ, K, A, Bv, P, hh0, hh2, hqs0, le_trans hqsB hqB1,
    hXin, by linarith, by linarith, hγ, ?_⟩
  refine ⟨hC1, hC2, hC3, hC4, hC5, ?_, ?_, ?_⟩
  · intro x t hxt hr
    obtain ⟨hq, hxtB⟩ := hdom x t hxt
    have hr' : 2 * Xb * simScale h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2 := by
      have : 2 * Xb * simScale h (x 2) (1 - t) ≤ 2 * Xext * simScale h (x 2) (1 - t) := by
        apply mul_le_mul_of_nonneg_right _ hq.le
        linarith
      linarith
    obtain ⟨hA0, hBv0, hP0, hj⟩ := hC6 x t hxt (Or.inr hr')
    obtain ⟨h1, h2, h3⟩ := hB11 x t hxtB hr
    exact ⟨hA0.trans h1, hBv0.trans h2, hP0.trans h3, hj⟩
  · intro j hj x t hxt hr
    have hr' : x 0 ^ 2 + x 1 ^ 2 < 2 * Xa * simScale h (x 2) (1 - t) := by
      have e : 4 * (Xa / 2) = 2 * Xa := by ring
      rw [e] at hr
      exact hr
    exact (hC6 x t hxt (Or.inl hr')).2.2.2 j hj
  · obtain ⟨CE, hCE⟩ := hB6 (Xa / 2) (Xa / 2) hXin 0
    have hCE1 : 0 < |CE| + 1 := by positivity
    obtain ⟨b, hb⟩ : ∃ b : ℝ, b = E0 / (2 * (|CE| + 1)) := ⟨_, rfl⟩
    have hbpos : 0 < b := by rw [hb]; positivity
    have h2h : 0 < 2 * h := by linarith
    refine ⟨min qs (min 1 (b ^ (1 / (2 * h)))),
      lt_min hqs0 (lt_min one_pos (Real.rpow_pos_of_pos hbpos _)), ?_⟩
    intro τ hτ0 hτ1
    have hτqs : τ < qs := lt_of_lt_of_le hτ1 (min_le_left _ _)
    have hτ1' : τ < 1 := lt_of_lt_of_le hτ1 ((min_le_right _ _).trans (min_le_left _ _))
    have hτb : τ < b ^ (1 / (2 * h)) :=
      lt_of_lt_of_le hτ1 ((min_le_right _ _).trans (min_le_right _ _))
    set ρ := Real.sqrt (2 * (Xa / 2) * τ) with hρ
    have hρpos : 0 < ρ := Real.sqrt_pos.mpr (by positivity)
    have hρsq : ρ ^ 2 = Xa * τ := by
      rw [hρ, Real.sq_sqrt (by positivity)]
      ring
    set x : ℝ³ := ρ • EuclideanSpace.single (0 : Fin 3) (1 : ℝ) with hx
    have hx0 : x 0 = ρ := by simp [hx]
    have hx1 : x 1 = 0 := by simp [hx]
    have hx2 : x 2 = 0 := by simp [hx]
    have h1t : (1 : ℝ) - (1 - τ) = τ := by ring
    have hqτ : simScale h (x 2) (1 - (1 - τ)) = τ := by
      rw [hx2, h1t]
      have := (hS1 0 τ hτ0).2
      simpa using this
    have hmem : (x, 1 - τ) ∈ simDomain h qs :=
      show (1 : ℝ) - τ < 1 ∧ simScale h (x 2) (1 - (1 - τ)) < qs from
        ⟨by linarith, by rw [hqτ]; exact hτqs⟩
    obtain ⟨-, hmemB⟩ := hdom x (1 - τ) hmem
    have hr2 : x 0 ^ 2 + x 1 ^ 2 = Xa * τ := by
      rw [hx0, hx1, hρsq]
      ring
    have hcore : x 0 ^ 2 + x 1 ^ 2 < 2 * Xa * simScale h (x 2) (1 - (1 - τ)) := by
      rw [hr2, hqτ]
      nlinarith [mul_pos hXa hτ0]
    have hu := hC7 x (1 - τ) hmem hcore
    have hrpos : 0 < x 0 ^ 2 + x 1 ^ 2 := by rw [hr2]; positivity
    have hsw := (hB5 x (1 - τ) hmemB hrpos).1
    have hsimX : simX h x (1 - τ) = Xa / 2 := by
      unfold simX
      rw [hqτ, hr2]
      field_simp
    have hsimEta : simEta h x (1 - τ) = 0 := by
      unfold simEta
      rw [hx2]
      simp
    have hsqrt : Real.sqrt (x 0 ^ 2 + x 1 ^ 2) = ρ := by
      rw [hx0, hx1]
      simp [Real.sqrt_sq hρpos.le]
    rw [hsqrt, hqτ, hsimX, hsimEta, ← hu] at hsw
    have hcl := (hCE τ (Xa / 2) 0 hτ0 (lt_of_lt_of_le hτqs hqsB) le_rfl le_rfl
      (by norm_num) (by norm_num)).1
    rw [norm_iteratedFDeriv_zero] at hcl
    simp only [logLift, Real.exp_log hτ0] at hcl
    rw [Real.norm_eq_abs] at hcl
    have hτpow : τ ^ (2 * h) < b := by
      have := Real.rpow_lt_rpow hτ0.le hτb h2h
      rwa [← Real.rpow_mul hbpos.le, one_div, inv_mul_cancel₀ h2h.ne', Real.rpow_one] at this
    have hEb : E0 / 2 < Eb τ (Xa / 2) 0 := by
      have h1 := neg_abs_le (Eb τ (Xa / 2) 0 - Real.sqrt (2 * (Xa / 2)) * F (Xa / 2) 0)
      have hτpos2 : 0 ≤ τ ^ (2 * h) := Real.rpow_nonneg hτ0.le _
      have h2 : CE * τ ^ (2 * h) ≤ |CE| * b :=
        calc CE * τ ^ (2 * h) ≤ |CE| * τ ^ (2 * h) :=
              mul_le_mul_of_nonneg_right (le_abs_self _) hτpos2
          _ ≤ |CE| * b := mul_le_mul_of_nonneg_left hτpow.le (abs_nonneg _)
      have h3 : (|CE| + 1) * b = E0 / 2 := by
        rw [hb]
        field_simp
      linarith
    have haz : azVec x = ρ • EuclideanSpace.single (1 : Fin 3) (1 : ℝ) := by
      unfold azVec
      rw [hx0, hx1]
      simp
    have hnaz : ‖azVec x‖ = ρ := by
      rw [haz, norm_smul]
      simp [abs_of_pos hρpos]
    have hP : 0 < τ ^ (-(1 / 2 + h)) := Real.rpow_pos_of_pos hτ0 _
    have hexp : τ ^ (-(1 / 2 : ℝ)) ≤ τ ^ (-(1 / 2 + h)) :=
      Real.rpow_le_rpow_of_exponent_ge hτ0 hτ1'.le (by linarith)
    have hinner := real_inner_le_norm (curl3 (fun w => A 0 w (1 - τ)) x + Bv 0 x (1 - τ)) (azVec x)
    rw [hsw, hnaz] at hinner
    have key : τ ^ (-(1 / 2 + h)) * Eb τ (Xa / 2) 0 ≤
        ‖curl3 (fun w => A 0 w (1 - τ)) x + Bv 0 x (1 - τ)‖ := by
      have hh : ρ * (τ ^ (-(1 / 2 + h)) * Eb τ (Xa / 2) 0) ≤
          ρ * ‖curl3 (fun w => A 0 w (1 - τ)) x + Bv 0 x (1 - τ)‖ := by linarith
      exact le_of_mul_le_mul_left hh hρpos
    calc 2 * (E0 / 4) * τ ^ (-(1 / 2 : ℝ)) = (E0 / 2) * τ ^ (-(1 / 2 : ℝ)) := by ring
      _ ≤ (E0 / 2) * τ ^ (-(1 / 2 + h)) := mul_le_mul_of_nonneg_left hexp (by linarith)
      _ ≤ τ ^ (-(1 / 2 + h)) * Eb τ (Xa / 2) 0 := by
          nlinarith [mul_le_mul_of_nonneg_left hEb.le hP.le]
      _ ≤ _ := key

theorem residual_comparison : ∀ m : ℕ, ∃ c : ℝ, 0 ≤ c ∧ ∀ (A₀ B₀ A₁ B₁ : ℝ³ → ℝ → ℝ³) (P₀ P₁ : ℝ³ → ℝ → ℝ) (O : Set (ℝ³ × ℝ)), IsOpen O → ContDiffOn ℝ ∞ (↿A₀) O → ContDiffOn ℝ ∞ (↿B₀) O → ContDiffOn ℝ ∞ (↿P₀) O → ContDiffOn ℝ ∞ (↿A₁) O → ContDiffOn ℝ ∞ (↿B₁) O → ContDiffOn ℝ ∞ (↿P₁) O → ∀ z ∈ O, ‖iteratedFDeriv ℝ m (↿(nsResidual 1 (fun y s => curl3 (fun w => A₁ w s) y + B₁ y s) P₁)) z‖ ≤ ‖iteratedFDeriv ℝ m (↿(nsResidual 1 (fun y s => curl3 (fun w => A₀ w s) y + B₀ y s) P₀)) z‖ + c * (∑ k ∈ Finset.range (m + 4), (‖iteratedFDeriv ℝ k (fun w => (↿A₁) w - (↿A₀) w) z‖ + ‖iteratedFDeriv ℝ k (fun w => (↿B₁) w - (↿B₀) w) z‖ + ‖iteratedFDeriv ℝ k (fun w => (↿P₁) w - (↿P₀) w) z‖)) * (1 + ∑ k ∈ Finset.range (m + 4), (‖iteratedFDeriv ℝ k (↿A₀) z‖ + ‖iteratedFDeriv ℝ k (↿B₀) z‖ + ‖iteratedFDeriv ℝ k (fun w => (↿A₁) w - (↿A₀) w) z‖ + ‖iteratedFDeriv ℝ k (fun w => (↿B₁) w - (↿B₀) w) z‖)) :=
by
  intro m

  let ev : Fin 3 → Fin 3 → ((ℝ³ × ℝ) →L[ℝ] ℝ³) →L[ℝ] ℝ := fun a b =>
    (EuclideanSpace.proj b).comp
      (ContinuousLinearMap.apply ℝ ℝ³ ((EuclideanSpace.single a (1:ℝ) : ℝ³), (0:ℝ)))
  let L : ((ℝ³ × ℝ) →L[ℝ] ℝ³) →L[ℝ] ℝ³ :=
    (ev 1 2 - ev 2 1).smulRight (EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) +
    (ev 2 0 - ev 0 2).smulRight (EuclideanSpace.single (1 : Fin 3) (1 : ℝ)) +
    (ev 0 1 - ev 1 0).smulRight (EuclideanSpace.single (2 : Fin 3) (1 : ℝ))
  have hLapp : ∀ Φ : (ℝ³ × ℝ) →L[ℝ] ℝ³, L Φ =
      (Φ (EuclideanSpace.single 1 1, 0) 2 - Φ (EuclideanSpace.single 2 1, 0) 1) •
          EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
        (Φ (EuclideanSpace.single 2 1, 0) 0 - Φ (EuclideanSpace.single 0 1, 0) 2) •
          EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
        (Φ (EuclideanSpace.single 0 1, 0) 1 - Φ (EuclideanSpace.single 1 1, 0) 0) •
          EuclideanSpace.single (2 : Fin 3) (1 : ℝ) := by
    intro Φ
    rfl
  let e : Fin 3 → ℝ³ := fun i => EuclideanSpace.single i (1 : ℝ)
  let L₁ : (ℝ³ × ℝ →L[ℝ] ℝ³) →L[ℝ] ℝ³ := ContinuousLinearMap.apply ℝ ℝ³ ((0 : ℝ³), (1 : ℝ))
  let B : (ℝ³ × ℝ →L[ℝ] ℝ³) →L[ℝ] (ℝ³ × ℝ) →L[ℝ] ℝ³ :=
    ContinuousLinearMap.id ℝ (ℝ³ × ℝ →L[ℝ] ℝ³)
  let L₃ : (type_of% (fderiv ℝ (fderiv ℝ (fun _ : ℝ³ × ℝ => (0 : ℝ³))) (0 : ℝ³ × ℝ))) →L[ℝ] ℝ³ :=
    -((1:ℝ) • ∑ i : Fin 3, (ContinuousLinearMap.apply ℝ ℝ³ (e i, (0 : ℝ))).comp
      (ContinuousLinearMap.apply ℝ (ℝ³ × ℝ →L[ℝ] ℝ³) (e i, (0 : ℝ))))
  let L₄ : (ℝ³ × ℝ →L[ℝ] ℝ) →L[ℝ] ℝ³ :=
    ∑ i : Fin 3, (ContinuousLinearMap.toSpanSingleton ℝ (e i)).comp
      (ContinuousLinearMap.apply ℝ ℝ (e i, (0 : ℝ)))
  let ι : ℝ³ →L[ℝ] ℝ³ × ℝ := ContinuousLinearMap.inl ℝ ℝ³ ℝ
  have hL3 : ∀ Ψ, L₃ Ψ = -((1:ℝ) • ∑ i : Fin 3, Ψ (e i, (0 : ℝ)) (e i, (0 : ℝ))) := by
    intro Ψ
    show (-((1:ℝ) • ∑ i : Fin 3, (ContinuousLinearMap.apply ℝ ℝ³ (e i, (0 : ℝ))).comp
      (ContinuousLinearMap.apply ℝ (ℝ³ × ℝ →L[ℝ] ℝ³) (e i, (0 : ℝ))))) Ψ = _
    simp only [ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_sum', Finset.sum_apply, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.apply_apply]
  have heq : ∀ (v : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (q : ℝ³ × ℝ), nsJet 1 v p q =
      ((L₁ (fderiv ℝ (↿v) q) + B (fderiv ℝ (↿v) q) (ι ((↿v) q)))
        + L₃ (fderiv ℝ (fderiv ℝ (↿v)) q)) + L₄ (fderiv ℝ (↿p) q) := by
    intro v p q
    rw [hL3]
    simp [nsJet, L₁, B, L₄, e, ι, ContinuousLinearMap.sum_apply, sub_eq_add_neg]
  clear_value L₁ B L₃ L₄ ι L
  clear hL3

  have hnn : ∀ {F G : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (Lc : F →L[ℝ] G), ∃ n : ℝ, n = ‖Lc‖ ∧ 0 ≤ n := by
    intro F G _ _ _ _ Lc
    exact ⟨_, rfl, ContinuousLinearMap.opNorm_nonneg Lc⟩
  obtain ⟨nL, hnLe, hnL0⟩ := hnn (F := (ℝ³ × ℝ) →L[ℝ] ℝ³) (G := ℝ³) L
  obtain ⟨n1, hn1e, hn10⟩ := hnn (F := ℝ³ × ℝ →L[ℝ] ℝ³) (G := ℝ³) L₁
  obtain ⟨n3, hn3e, hn30⟩ := hnn
    (F := type_of% (fderiv ℝ (fderiv ℝ (fun _ : ℝ³ × ℝ => (0 : ℝ³))) (0 : ℝ³ × ℝ))) (G := ℝ³) L₃
  obtain ⟨n4, hn4e, hn40⟩ := hnn (F := ℝ³ × ℝ →L[ℝ] ℝ) (G := ℝ³) L₄
  obtain ⟨nB, hnBe, hnB0⟩ := hnn (F := ℝ³ × ℝ →L[ℝ] ℝ³) (G := (ℝ³ × ℝ) →L[ℝ] ℝ³) B
  obtain ⟨nι, hnιe, hnι0⟩ := hnn (F := ℝ³) (G := ℝ³ × ℝ) ι
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = nL + 1 := ⟨_, rfl⟩
  have hK0 : 0 ≤ K := by rw [hK]; linarith
  obtain ⟨c1, hc1⟩ : ∃ c1 : ℝ, c1 = (n1 + n3) * K + n4 := ⟨_, rfl⟩
  obtain ⟨c2, hc2⟩ : ∃ c2 : ℝ, c2 = 3 * (nB * 2 ^ m * (K * (nι * K))) := ⟨_, rfl⟩
  have hc10 : 0 ≤ c1 := by
    rw [hc1]
    exact add_nonneg (mul_nonneg (add_nonneg hn10 hn30) hK0) hn40
  have hc20 : 0 ≤ c2 := by
    rw [hc2]
    exact mul_nonneg (by norm_num) (mul_nonneg (mul_nonneg hnB0 (by positivity))
      (mul_nonneg hK0 (mul_nonneg hnι0 hK0)))
  refine ⟨c1 + c2, add_nonneg hc10 hc20, ?_⟩
  intro A₀ B₀ A₁ B₁ P₀ P₁ O hO hA₀ hB₀ hP₀ hA₁ hB₁ hP₁ z hz
  have hzO : O ∈ nhds z := hO.mem_nhds hz

  have hca : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (k : ℕ),
      ContDiffOn ℝ ∞ f O → ContDiffAt ℝ k f z := by
    intro F _ _ f k hf
    exact (hf.contDiffAt hzO).of_le (by exact_mod_cast le_top)
  have hlin : ∀ {F G : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (Lc : F →L[ℝ] G) (n : ℝ), ‖Lc‖ = n → ∀ (f : ℝ³ × ℝ → F) (k : ℕ),
      ContDiffOn ℝ ∞ f O →
      ‖iteratedFDeriv ℝ k (fun q => Lc (f q)) z‖ ≤ n * ‖iteratedFDeriv ℝ k f z‖ := by
    intro F G _ _ _ _ Lc n hn f k hf
    rw [← hn]
    exact Lc.norm_iteratedFDeriv_comp_left (hf.contDiffAt hzO) (by exact_mod_cast le_top)
  have hfd : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F),
      ContDiffOn ℝ ∞ f O → ContDiffOn ℝ ∞ (fderiv ℝ f) O := by
    intro F _ _ f hf
    exact hf.fderiv_of_isOpen hO (by simp)
  have hbil : ∀ {F G : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (Bm : F →L[ℝ] G →L[ℝ] ℝ³) (n : ℝ), ‖Bm‖ = n →
      ∀ (f : ℝ³ × ℝ → F) (g : ℝ³ × ℝ → G) (X Y : ℝ),
      ContDiffOn ℝ ∞ f O → ContDiffOn ℝ ∞ g O →
      (∀ i, i ≤ m → ‖iteratedFDeriv ℝ i f z‖ ≤ X) → (∀ i, i ≤ m → ‖iteratedFDeriv ℝ i g z‖ ≤ Y) →
      ‖iteratedFDeriv ℝ m (fun q => Bm (f q) (g q)) z‖ ≤ n * 2 ^ m * (X * Y) := by
    intro F G _ _ _ _ Bm n hn f g X Y hf hg hX hY
    rw [← hn]
    have hX0 : 0 ≤ X := (norm_nonneg _).trans (hX 0 (Nat.zero_le _))
    have key := ContinuousLinearMap.norm_iteratedFDerivWithin_le_of_bilinear Bm hf hg
      hO.uniqueDiffOn hz (n := m) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen m hO hz] at key
    have hs : (∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ)) = 2 ^ m := by
      exact_mod_cast Nat.sum_range_choose m
    calc ‖iteratedFDeriv ℝ m (fun q => Bm (f q) (g q)) z‖
        ≤ ‖Bm‖ * ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) *
            ‖iteratedFDerivWithin ℝ i f O z‖ * ‖iteratedFDerivWithin ℝ (m - i) g O z‖ := key
      _ ≤ ‖Bm‖ * ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * X * Y := by
          refine mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun i hi => ?_)
            (ContinuousLinearMap.opNorm_nonneg Bm)
          have him : i ≤ m := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [iteratedFDerivWithin_of_isOpen i hO hz, iteratedFDerivWithin_of_isOpen (m - i) hO hz]
          have h0 : (0 : ℝ) ≤ m.choose i := Nat.cast_nonneg _
          exact mul_le_mul (mul_le_mul_of_nonneg_left (hX i him) h0) (hY (m - i) (Nat.sub_le m i))
            (norm_nonneg _) (mul_nonneg h0 hX0)
      _ = ‖Bm‖ * 2 ^ m * (X * Y) := by
          rw [← Finset.sum_mul, ← Finset.sum_mul, hs]
          ring
  have hadd : ∀ (f g : ℝ³ × ℝ → ℝ³) (a b : ℝ), ContDiffOn ℝ ∞ f O → ContDiffOn ℝ ∞ g O →
      ‖iteratedFDeriv ℝ m f z‖ ≤ a → ‖iteratedFDeriv ℝ m g z‖ ≤ b →
      ContDiffOn ℝ ∞ (fun q => f q + g q) O ∧
        ‖iteratedFDeriv ℝ m (fun q => f q + g q) z‖ ≤ a + b := by
    intro f g a b hf hg ha hb
    refine ⟨hf.add hg, ?_⟩
    have hs : iteratedFDeriv ℝ m (fun q => f q + g q) z =
        iteratedFDeriv ℝ m f z + iteratedFDeriv ℝ m g z :=
      iteratedFDeriv_add_apply (hca f m hf) (hca g m hg)
    rw [hs]
    exact (norm_add_le _ _).trans (add_le_add ha hb)
  have hcb : ∀ (V F G : ℝ³ × ℝ → ℝ³), ContDiffOn ℝ ∞ F O → ContDiffOn ℝ ∞ G O →
      (∀ q ∈ O, V q = L (fderiv ℝ F q) + G q) → ∀ k : ℕ,
      ‖iteratedFDeriv ℝ k V z‖ ≤ nL * ‖iteratedFDeriv ℝ (k + 1) F z‖ + ‖iteratedFDeriv ℝ k G z‖ := by
    intro V F G hF hG hV k
    have hev : V =ᶠ[nhds z] fun q => L (fderiv ℝ F q) + G q := Filter.eventuallyEq_of_mem hzO hV
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    have hLf : ContDiffOn ℝ ∞ (fun q => L (fderiv ℝ F q)) O := (hfd F hF).continuousLinearMap_comp L
    have hsplit : iteratedFDeriv ℝ k (fun q => L (fderiv ℝ F q) + G q) z =
        iteratedFDeriv ℝ k (fun q => L (fderiv ℝ F q)) z + iteratedFDeriv ℝ k G z :=
      iteratedFDeriv_add_apply (hca _ k hLf) (hca _ k hG)
    rw [hsplit]
    have h1 := hlin L nL hnLe.symm (fderiv ℝ F) k (hfd F hF)
    rw [norm_iteratedFDeriv_fderiv] at h1
    exact (norm_add_le _ _).trans (add_le_add h1 le_rfl)
  have hcurl : ∀ (F G : ℝ³ → ℝ → ℝ³), ContDiffOn ℝ ∞ (↿F) O → ∀ q ∈ O,
      (↿(fun y s => curl3 (fun w => F w s) y + G y s)) q = L (fderiv ℝ (↿F) q) + (↿G) q := by
    intro F G hF q hq
    have hslice : ∀ v : ℝ³, fderiv ℝ (fun w => F w q.2) q.1 v = fderiv ℝ (↿F) q (v, 0) := by
      intro v
      have hd : DifferentiableAt ℝ (↿F) q :=
        (hF.contDiffAt (hO.mem_nhds hq)).differentiableAt (by simp)
      have hd' : DifferentiableAt ℝ (↿F) (q.1, q.2) := hd
      have he : (fun w => F w q.2) = (↿F) ∘ (fun w : ℝ³ => (w, q.2)) := rfl
      rw [he, fderiv_comp q.1 hd' (hasFDerivAt_prodMk_left q.1 q.2).differentiableAt,
        (hasFDerivAt_prodMk_left q.1 q.2).fderiv]
      rfl
    show curl3 (fun w => F w q.2) q.1 + G q.1 q.2 = L (fderiv ℝ (↿F) q) + G q.1 q.2
    rw [hLapp]
    simp only [curl3, hslice]

  have hRJ : ∀ (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿u) O →
      ContDiffOn ℝ ∞ (↿p) O → ContDiffOn ℝ ∞ (↿(nsResidual 1 u p)) O ∧
        ∀ q ∈ O, (↿(nsResidual 1 u p)) q = nsJet 1 u p q := by
    intro u p hu hp
    have s1 : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (x : ℝ³)
        (t : ℝ), DifferentiableAt ℝ f (x, t) →
        deriv (fun s => f (x, s)) t = fderiv ℝ f (x, t) ((0 : ℝ³), (1 : ℝ)) ∧
        fderiv ℝ (fun y => f (y, t)) x =
          (fderiv ℝ f (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := by
      intro F _ _ f x t hf
      constructor
      · have hγ : HasDerivAt (fun s : ℝ => ((x, s) : ℝ³ × ℝ)) ((0 : ℝ³), (1 : ℝ)) t :=
          (hasDerivAt_const t x).prodMk (hasDerivAt_id t)
        exact (hf.hasFDerivAt.comp_hasDerivAt t hγ).deriv
      · exact (hf.hasFDerivAt.comp x (hasFDerivAt_prodMk_left x t)).fderiv
    have s2 : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (x : ℝ³)
        (t : ℝ), ContDiffOn ℝ ∞ f O → (x, t) ∈ O → ∀ a b : ℝ³,
        fderiv ℝ (fderiv ℝ (fun y => f (y, t))) x a b =
          fderiv ℝ (fderiv ℝ f) (x, t) (a, (0 : ℝ)) (b, (0 : ℝ)) := by
      intro F _ _ f x t hf hxt a b
      have hemb : Continuous (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) :=
        continuous_id.prodMk continuous_const
      have hN : {y : ℝ³ | (y, t) ∈ O} ∈ nhds x := (hO.preimage hemb).mem_nhds hxt
      let Φ : (ℝ³ × ℝ →L[ℝ] F) →L[ℝ] (ℝ³ →L[ℝ] F) :=
        (ContinuousLinearMap.compL ℝ ℝ³ (ℝ³ × ℝ) F).flip (ContinuousLinearMap.inl ℝ ℝ³ ℝ)
      have hΦ : ∀ M, Φ M = M.comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := fun M => rfl
      have hev : fderiv ℝ (fun y => f (y, t)) =ᶠ[nhds x] fun y => Φ (fderiv ℝ f (y, t)) := by
        filter_upwards [hN] with y hy
        have hd : DifferentiableAt ℝ f (y, t) :=
          (hf.contDiffAt (hO.mem_nhds hy)).differentiableAt (by simp)
        rw [hΦ]
        exact (s1 f y t hd).2
      have hDf : ContDiffOn ℝ ∞ (fderiv ℝ f) O :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hf).2
      have hD2 : HasFDerivAt (fderiv ℝ f) (fderiv ℝ (fderiv ℝ f) (x, t)) (x, t) :=
        ((hDf.contDiffAt (hO.mem_nhds hxt)).differentiableAt (by simp)).hasFDerivAt
      have hg : HasFDerivAt (fun y => Φ (fderiv ℝ f (y, t)))
          (Φ.comp ((fderiv ℝ (fderiv ℝ f) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ))) x :=
        Φ.hasFDerivAt.comp x (hD2.comp x (hasFDerivAt_prodMk_left x t))
      rw [hev.fderiv_eq, hg.fderiv]
      rfl
    have s3 : ∀ (g : ℝ³ → ℝ) (x : ℝ³), gradient g x = ∑ i : Fin 3,
        fderiv ℝ g x (EuclideanSpace.single i (1 : ℝ)) • EuclideanSpace.single i (1 : ℝ) := by
      intro g x
      have h := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr' (gradient g x)
      rw [← h]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [EuclideanSpace.basisFun_apply]
      congr 1
      rw [real_inner_comm]
      exact InnerProductSpace.toDual_symm_apply
    have s4 : ∀ (g : ℝ³ → ℝ³) (x : ℝ³), Δ g x = ∑ i : Fin 3,
        fderiv ℝ (fderiv ℝ g) x (EuclideanSpace.single i (1 : ℝ)) (EuclideanSpace.single i (1 : ℝ)) := by
      intro g x
      have h := congrFun (InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis g
        (EuclideanSpace.basisFun (Fin 3) ℝ)) x
      rw [h]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [iteratedFDeriv_two_apply]
      simp [EuclideanSpace.basisFun_apply]
    have hDu : ContDiffOn ℝ ∞ (fderiv ℝ (↿u)) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hu).2
    have hD2u : ContDiffOn ℝ ∞ (fderiv ℝ (fderiv ℝ (↿u))) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hDu).2
    have hDp : ContDiffOn ℝ ∞ (fderiv ℝ (↿p)) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hp).2
    have hT3 : ContDiffOn ℝ ∞ (fun z => ∑ i : Fin 3, fderiv ℝ (fderiv ℝ (↿u)) z
        (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) (EuclideanSpace.single i (1 : ℝ), (0 : ℝ))) O :=
      ContDiffOn.sum fun i _ => (hD2u.clm_apply contDiffOn_const).clm_apply contDiffOn_const
    have hT4 : ContDiffOn ℝ ∞ (fun z => ∑ i : Fin 3, fderiv ℝ (↿p) z
        (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) • EuclideanSpace.single i (1 : ℝ)) O :=
      ContDiffOn.sum fun i _ => (hDp.clm_apply contDiffOn_const).smul contDiffOn_const
    have hJ : ContDiffOn ℝ ∞ (nsJet 1 u p) O := by
      unfold nsJet
      exact (((hDu.clm_apply contDiffOn_const).add
        (hDu.clm_apply (hu.prodMk contDiffOn_const))).sub (hT3.const_smul (1:ℝ))).add hT4
    have hid : ∀ z ∈ O, (↿(nsResidual 1 u p)) z = nsJet 1 u p z := by
      rintro ⟨x, t⟩ hz
      have hu' : DifferentiableAt ℝ (↿u) (x, t) :=
        (hu.contDiffAt (hO.mem_nhds hz)).differentiableAt (by simp)
      have hp' : DifferentiableAt ℝ (↿p) (x, t) :=
        (hp.contDiffAt (hO.mem_nhds hz)).differentiableAt (by simp)
      have e1 : deriv (fun s => u x s) t = fderiv ℝ (↿u) (x, t) ((0 : ℝ³), (1 : ℝ)) :=
        (s1 (↿u) x t hu').1
      have e2 : fderiv ℝ (fun y => u y t) x (u x t) =
          fderiv ℝ (↿u) (x, t) ((↿u) (x, t), (0 : ℝ)) := by
        have h2 : fderiv ℝ (fun y => u y t) x =
            (fderiv ℝ (↿u) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := (s1 (↿u) x t hu').2
        rw [h2]
        rfl
      have e3 : Δ (fun y => u y t) x = ∑ i : Fin 3, fderiv ℝ (fderiv ℝ (↿u)) (x, t)
          (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) := by
        rw [s4]
        exact Finset.sum_congr rfl (fun i _ => s2 (↿u) x t hu hz _ _)
      have e4 : gradient (fun y => p y t) x = ∑ i : Fin 3, fderiv ℝ (↿p) (x, t)
          (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) • EuclideanSpace.single i (1 : ℝ) := by
        have h2 : fderiv ℝ (fun y => p y t) x =
            (fderiv ℝ (↿p) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := (s1 (↿p) x t hp').2
        rw [s3, h2]
        rfl
      show nsResidual 1 u p x t = nsJet 1 u p (x, t)
      rw [nsResidual, e1, e2, e3, e4]
      rfl
    exact ⟨hJ.congr hid, hid⟩

  have hf₀ := hcurl A₀ B₀ hA₀
  have hf₁ := hcurl A₁ B₁ hA₁
  have hu₀s : ContDiffOn ℝ ∞ (↿(fun (y : ℝ³) (s : ℝ) => curl3 (fun w => A₀ w s) y + B₀ y s)) O :=
    ContDiffOn.congr (f := fun q => L (fderiv ℝ (↿A₀) q) + (↿B₀) q)
      (((hfd _ hA₀).continuousLinearMap_comp L).add hB₀) hf₀
  have hu₁s : ContDiffOn ℝ ∞ (↿(fun (y : ℝ³) (s : ℝ) => curl3 (fun w => A₁ w s) y + B₁ y s)) O :=
    ContDiffOn.congr (f := fun q => L (fderiv ℝ (↿A₁) q) + (↿B₁) q)
      (((hfd _ hA₁).continuousLinearMap_comp L).add hB₁) hf₁
  have hR₀ := hRJ
    (fun (y : ℝ³) (s : ℝ) => curl3 (fun w => A₀ w s) y + B₀ y s) P₀ hu₀s hP₀
  have hR₁ := hRJ
    (fun (y : ℝ³) (s : ℝ) => curl3 (fun w => A₁ w s) y + B₁ y s) P₁ hu₁s hP₁
  generalize hda : (fun w : ℝ³ × ℝ => (↿A₁) w - (↿A₀) w) = da
  generalize hdb : (fun w : ℝ³ × ℝ => (↿B₁) w - (↿B₀) w) = db
  generalize hdp : (fun w : ℝ³ × ℝ => (↿P₁) w - (↿P₀) w) = dp
  obtain ⟨E, hE⟩ : ∃ E : ℝ, (∑ k ∈ Finset.range (m + 4), (‖iteratedFDeriv ℝ k da z‖ +
      ‖iteratedFDeriv ℝ k db z‖ + ‖iteratedFDeriv ℝ k dp z‖)) = E := ⟨_, rfl⟩
  obtain ⟨U, hU⟩ : ∃ U : ℝ, (∑ k ∈ Finset.range (m + 4), (‖iteratedFDeriv ℝ k (↿A₀) z‖ +
      ‖iteratedFDeriv ℝ k (↿B₀) z‖ + ‖iteratedFDeriv ℝ k da z‖ + ‖iteratedFDeriv ℝ k db z‖)) = U :=
    ⟨_, rfl⟩
  rw [hE, hU]
  revert hf₀ hf₁ hu₀s hu₁s hR₀ hR₁
  generalize (fun (y : ℝ³) (s : ℝ) => curl3 (fun w => A₀ w s) y + B₀ y s) = u₀
  generalize (fun (y : ℝ³) (s : ℝ) => curl3 (fun w => A₁ w s) y + B₁ y s) = u₁
  intro hf₀ hf₁ hu₀s hu₁s hR₀ hR₁

  have hEs : ∀ j, j < m + 4 → ‖iteratedFDeriv ℝ j da z‖ + ‖iteratedFDeriv ℝ j db z‖ +
      ‖iteratedFDeriv ℝ j dp z‖ ≤ E := by
    intro j hj
    rw [← hE]
    exact Finset.single_le_sum (f := fun k => ‖iteratedFDeriv ℝ k da z‖ +
      ‖iteratedFDeriv ℝ k db z‖ + ‖iteratedFDeriv ℝ k dp z‖)
      (fun i _ => add_nonneg (add_nonneg (norm_nonneg _) (norm_nonneg _)) (norm_nonneg _))
      (Finset.mem_range.mpr hj)
  have hUs : ∀ j, j < m + 4 → ‖iteratedFDeriv ℝ j (↿A₀) z‖ + ‖iteratedFDeriv ℝ j (↿B₀) z‖ +
      ‖iteratedFDeriv ℝ j da z‖ + ‖iteratedFDeriv ℝ j db z‖ ≤ U := by
    intro j hj
    rw [← hU]
    exact Finset.single_le_sum (f := fun k => ‖iteratedFDeriv ℝ k (↿A₀) z‖ +
      ‖iteratedFDeriv ℝ k (↿B₀) z‖ + ‖iteratedFDeriv ℝ k da z‖ + ‖iteratedFDeriv ℝ k db z‖)
      (fun i _ => add_nonneg (add_nonneg (add_nonneg (norm_nonneg _) (norm_nonneg _))
        (norm_nonneg _)) (norm_nonneg _))
      (Finset.mem_range.mpr hj)
  have hE0 : 0 ≤ E := le_trans (add_nonneg (add_nonneg (norm_nonneg _) (norm_nonneg _))
    (norm_nonneg _)) (hEs 0 (by omega))
  have hU0 : 0 ≤ U := le_trans (add_nonneg (add_nonneg (add_nonneg (norm_nonneg _)
    (norm_nonneg _)) (norm_nonneg _)) (norm_nonneg _)) (hUs 0 (by omega))

  obtain ⟨ε, hε⟩ : ∃ ε : ℝ³ × ℝ → ℝ³, ε = fun q => (↿u₁) q - (↿u₀) q := ⟨_, rfl⟩
  have hεs : ContDiffOn ℝ ∞ ε O := by rw [hε]; exact hu₁s.sub hu₀s
  have hdps : ContDiffOn ℝ ∞ dp O := by rw [← hdp]; exact hP₁.sub hP₀
  have hdas : ContDiffOn ℝ ∞ da O := by rw [← hda]; exact hA₁.sub hA₀
  have hdbs : ContDiffOn ℝ ∞ db O := by rw [← hdb]; exact hB₁.sub hB₀
  have hfε : ∀ q ∈ O, ε q = L (fderiv ℝ da q) + db q := by
    intro q hq
    have hqO := hO.mem_nhds hq
    have h1 : DifferentiableAt ℝ (↿A₁) q := (hA₁.contDiffAt hqO).differentiableAt (by simp)
    have h0 : DifferentiableAt ℝ (↿A₀) q := (hA₀.contDiffAt hqO).differentiableAt (by simp)
    rw [hε, ← hda, ← hdb]
    beta_reduce
    rw [hf₁ q hq, hf₀ q hq, fderiv_fun_sub h1 h0, map_sub]
    abel

  have hεE : ∀ k, k < m + 3 → ‖iteratedFDeriv ℝ k ε z‖ ≤ K * E := by
    intro k hk
    have h := hcb ε da db hdas hdbs hfε k
    have h1 := hEs (k + 1) (by omega)
    have h2 := hEs k (by omega)
    have n1 := norm_nonneg (iteratedFDeriv ℝ (k + 1) db z)
    have n2 := norm_nonneg (iteratedFDeriv ℝ (k + 1) dp z)
    have n3 := norm_nonneg (iteratedFDeriv ℝ k da z)
    have n4 := norm_nonneg (iteratedFDeriv ℝ k dp z)
    have h3 : nL * ‖iteratedFDeriv ℝ (k + 1) da z‖ ≤ nL * E :=
      mul_le_mul_of_nonneg_left (by linarith only [h1, n1, n2]) hnL0
    rw [hK]
    linarith only [h, h2, h3, n3, n4]
  have hεU : ∀ k, k < m + 3 → ‖iteratedFDeriv ℝ k ε z‖ ≤ K * U := by
    intro k hk
    have h := hcb ε da db hdas hdbs hfε k
    have h1 := hUs (k + 1) (by omega)
    have h2 := hUs k (by omega)
    have n1 := norm_nonneg (iteratedFDeriv ℝ (k + 1) (↿A₀) z)
    have n2 := norm_nonneg (iteratedFDeriv ℝ (k + 1) (↿B₀) z)
    have n3 := norm_nonneg (iteratedFDeriv ℝ (k + 1) db z)
    have n4 := norm_nonneg (iteratedFDeriv ℝ k (↿A₀) z)
    have n5 := norm_nonneg (iteratedFDeriv ℝ k (↿B₀) z)
    have n6 := norm_nonneg (iteratedFDeriv ℝ k da z)
    have h3 : nL * ‖iteratedFDeriv ℝ (k + 1) da z‖ ≤ nL * U :=
      mul_le_mul_of_nonneg_left (by linarith only [h1, n1, n2, n3]) hnL0
    rw [hK]
    linarith only [h, h2, h3, n4, n5, n6]
  have hu₀U : ∀ k, k < m + 3 → ‖iteratedFDeriv ℝ k (↿u₀) z‖ ≤ K * U := by
    intro k hk
    have h := hcb (↿u₀) (↿A₀) (↿B₀) hA₀ hB₀ hf₀ k
    have h1 := hUs (k + 1) (by omega)
    have h2 := hUs k (by omega)
    have n1 := norm_nonneg (iteratedFDeriv ℝ (k + 1) (↿B₀) z)
    have n2 := norm_nonneg (iteratedFDeriv ℝ (k + 1) da z)
    have n3 := norm_nonneg (iteratedFDeriv ℝ (k + 1) db z)
    have n4 := norm_nonneg (iteratedFDeriv ℝ k (↿A₀) z)
    have n5 := norm_nonneg (iteratedFDeriv ℝ k da z)
    have n6 := norm_nonneg (iteratedFDeriv ℝ k db z)
    have h3 : nL * ‖iteratedFDeriv ℝ (k + 1) (↿A₀) z‖ ≤ nL * U :=
      mul_le_mul_of_nonneg_left (by linarith only [h1, n1, n2, n3]) hnL0
    rw [hK]
    linarith only [h, h2, h3, n4, n5, n6]
  have hdpE : ‖iteratedFDeriv ℝ (m + 1) dp z‖ ≤ E := by
    have h1 := hEs (m + 1) (by omega)
    have n1 := norm_nonneg (iteratedFDeriv ℝ (m + 1) da z)
    have n2 := norm_nonneg (iteratedFDeriv ℝ (m + 1) db z)
    linarith only [h1, n1, n2]

  have hu1q : ∀ q, (↿u₁) q = (↿u₀) q + ε q := by
    intro q
    simp only [hε]
    abel
  have hDu : ∀ q ∈ O, fderiv ℝ (↿u₁) q = fderiv ℝ (↿u₀) q + fderiv ℝ ε q := by
    intro q hq
    have hqO := hO.mem_nhds hq
    have e1 : (↿u₁) = fun q => (↿u₀) q + ε q := funext hu1q
    rw [e1]
    exact fderiv_fun_add ((hu₀s.contDiffAt hqO).differentiableAt (by simp))
      ((hεs.contDiffAt hqO).differentiableAt (by simp))
  have hD2u : ∀ q ∈ O, fderiv ℝ (fderiv ℝ (↿u₁)) q =
      fderiv ℝ (fderiv ℝ (↿u₀)) q + fderiv ℝ (fderiv ℝ ε) q := by
    intro q hq
    have hqO := hO.mem_nhds hq
    have hev : fderiv ℝ (↿u₁) =ᶠ[nhds q] fun q' => fderiv ℝ (↿u₀) q' + fderiv ℝ ε q' :=
      Filter.eventuallyEq_of_mem hqO hDu
    rw [hev.fderiv_eq]
    exact fderiv_fun_add (((hfd _ hu₀s).contDiffAt hqO).differentiableAt (by simp))
      (((hfd _ hεs).contDiffAt hqO).differentiableAt (by simp))
  have hDp : ∀ q ∈ O, fderiv ℝ (↿P₁) q = fderiv ℝ (↿P₀) q + fderiv ℝ dp q := by
    intro q hq
    have hqO := hO.mem_nhds hq
    have e2 : (↿P₁) = fun q => (↿P₀) q + dp q := by
      funext q
      have h : dp q = (↿P₁) q - (↿P₀) q := by rw [← hdp]
      rw [h]
      ring
    rw [e2]
    exact fderiv_fun_add ((hP₀.contDiffAt hqO).differentiableAt (by simp))
      ((hdps.contDiffAt hqO).differentiableAt (by simp))

  obtain ⟨Dj, hDj⟩ : ∃ Dj : ℝ³ × ℝ → ℝ³, Dj = fun q =>
      ((((L₁ (fderiv ℝ ε q) + B (fderiv ℝ (↿u₀) q) (ι (ε q))) +
        B (fderiv ℝ ε q) (ι ((↿u₀) q))) + B (fderiv ℝ ε q) (ι (ε q))) +
        L₃ (fderiv ℝ (fderiv ℝ ε) q)) + L₄ (fderiv ℝ dp q) := ⟨_, rfl⟩
  have hdiff : ∀ q ∈ O, (↿(nsResidual 1 u₁ P₁)) q - (↿(nsResidual 1 u₀ P₀)) q = Dj q := by
    intro q hq
    rw [hR₁.2 q hq, hR₀.2 q hq, hDj, heq u₁ P₁ q, heq u₀ P₀ q]
    rw [hD2u q hq, hDu q hq, hDp q hq, hu1q q]
    simp only [map_add, ContinuousLinearMap.add_apply]
    abel
  have hRR : iteratedFDeriv ℝ m (↿(nsResidual 1 u₁ P₁)) z -
      iteratedFDeriv ℝ m (↿(nsResidual 1 u₀ P₀)) z = iteratedFDeriv ℝ m Dj z := by
    rw [← iteratedFDeriv_sub_apply (hca _ m hR₁.1) (hca _ m hR₀.1)]
    have hev : (↿(nsResidual 1 u₁ P₁)) - (↿(nsResidual 1 u₀ P₀)) =ᶠ[nhds z] Dj :=
      Filter.eventuallyEq_of_mem hzO (fun q hq => by rw [Pi.sub_apply]; exact hdiff q hq)
    exact (hev.iteratedFDeriv ℝ m).eq_of_nhds

  have sT1 : ContDiffOn ℝ ∞ (fun q => L₁ (fderiv ℝ ε q)) O :=
    (hfd ε hεs).continuousLinearMap_comp L₁
  have sT2 : ContDiffOn ℝ ∞ (fun q => B (fderiv ℝ (↿u₀) q) (ι (ε q))) O :=
    ((hfd _ hu₀s).continuousLinearMap_comp B).clm_apply (hεs.continuousLinearMap_comp ι)
  have sT3 : ContDiffOn ℝ ∞ (fun q => B (fderiv ℝ ε q) (ι ((↿u₀) q))) O :=
    ((hfd ε hεs).continuousLinearMap_comp B).clm_apply (hu₀s.continuousLinearMap_comp ι)
  have sT4 : ContDiffOn ℝ ∞ (fun q => B (fderiv ℝ ε q) (ι (ε q))) O :=
    ((hfd ε hεs).continuousLinearMap_comp B).clm_apply (hεs.continuousLinearMap_comp ι)
  have hD2ε : ContDiffOn ℝ ∞ (fderiv ℝ (fderiv ℝ ε)) O := hfd _ (hfd ε hεs)
  have hcomp : ∀ {F G : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (Lc : F →L[ℝ] G) (f : ℝ³ × ℝ → F), ContDiffOn ℝ ∞ f O →
      ContDiffOn ℝ ∞ (fun q => Lc (f q)) O := by
    intro F G _ _ _ _ Lc f hf
    exact hf.continuousLinearMap_comp Lc
  have sT5 : ContDiffOn ℝ ∞ (fun q => L₃ (fderiv ℝ (fderiv ℝ ε) q)) O :=
    hcomp L₃ (fderiv ℝ (fderiv ℝ ε)) hD2ε
  have sT6 : ContDiffOn ℝ ∞ (fun q => L₄ (fderiv ℝ dp q)) O :=
    (hfd dp hdps).continuousLinearMap_comp L₄
  have bT1 : ‖iteratedFDeriv ℝ m (fun q => L₁ (fderiv ℝ ε q)) z‖ ≤ n1 * (K * E) := by
    have h := hlin L₁ n1 hn1e.symm (fderiv ℝ ε) m (hfd ε hεs)
    rw [norm_iteratedFDeriv_fderiv] at h
    exact h.trans (mul_le_mul_of_nonneg_left (hεE (m + 1) (by omega)) hn10)
  have bT5 : ‖iteratedFDeriv ℝ m (fun q => L₃ (fderiv ℝ (fderiv ℝ ε) q)) z‖ ≤ n3 * (K * E) := by
    have h := hlin L₃ n3 hn3e.symm (fderiv ℝ (fderiv ℝ ε)) m hD2ε
    rw [norm_iteratedFDeriv_fderiv, norm_iteratedFDeriv_fderiv] at h
    exact h.trans (mul_le_mul_of_nonneg_left (hεE (m + 1 + 1) (by omega)) hn30)
  have bT6 : ‖iteratedFDeriv ℝ m (fun q => L₄ (fderiv ℝ dp q)) z‖ ≤ n4 * E := by
    have h := hlin L₄ n4 hn4e.symm (fderiv ℝ dp) m (hfd dp hdps)
    rw [norm_iteratedFDeriv_fderiv] at h
    exact h.trans (mul_le_mul_of_nonneg_left hdpE hn40)
  have bT2 : ‖iteratedFDeriv ℝ m (fun q => B (fderiv ℝ (↿u₀) q) (ι (ε q))) z‖ ≤
      nB * 2 ^ m * ((K * U) * (nι * (K * E))) :=
    hbil B nB hnBe.symm (fderiv ℝ (↿u₀)) (fun q => ι (ε q)) (K * U) (nι * (K * E)) (hfd _ hu₀s)
      (hεs.continuousLinearMap_comp ι)
      (fun i hi => by rw [norm_iteratedFDeriv_fderiv]; exact hu₀U (i + 1) (by omega))
      (fun i hi => (hlin ι nι hnιe.symm ε i hεs).trans
        (mul_le_mul_of_nonneg_left (hεE i (by omega)) hnι0))
  have bT3 : ‖iteratedFDeriv ℝ m (fun q => B (fderiv ℝ ε q) (ι ((↿u₀) q))) z‖ ≤
      nB * 2 ^ m * ((K * E) * (nι * (K * U))) :=
    hbil B nB hnBe.symm (fderiv ℝ ε) (fun q => ι ((↿u₀) q)) (K * E) (nι * (K * U)) (hfd _ hεs)
      (hu₀s.continuousLinearMap_comp ι)
      (fun i hi => by rw [norm_iteratedFDeriv_fderiv]; exact hεE (i + 1) (by omega))
      (fun i hi => (hlin ι nι hnιe.symm (↿u₀) i hu₀s).trans
        (mul_le_mul_of_nonneg_left (hu₀U i (by omega)) hnι0))
  have bT4 : ‖iteratedFDeriv ℝ m (fun q => B (fderiv ℝ ε q) (ι (ε q))) z‖ ≤
      nB * 2 ^ m * ((K * E) * (nι * (K * U))) :=
    hbil B nB hnBe.symm (fderiv ℝ ε) (fun q => ι (ε q)) (K * E) (nι * (K * U)) (hfd _ hεs)
      (hεs.continuousLinearMap_comp ι)
      (fun i hi => by rw [norm_iteratedFDeriv_fderiv]; exact hεE (i + 1) (by omega))
      (fun i hi => (hlin ι nι hnιe.symm ε i hεs).trans
        (mul_le_mul_of_nonneg_left (hεU i (by omega)) hnι0))
  obtain ⟨s2, b2⟩ := hadd _ _ _ _ sT1 sT2 bT1 bT2
  obtain ⟨s3, b3⟩ := hadd _ _ _ _ s2 sT3 b2 bT3
  obtain ⟨s4, b4⟩ := hadd _ _ _ _ s3 sT4 b3 bT4
  obtain ⟨s5, b5⟩ := hadd _ _ _ _ s4 sT5 b4 bT5
  obtain ⟨_, b6⟩ := hadd _ _ _ _ s5 sT6 b5 bT6
  have hfin : ‖iteratedFDeriv ℝ m Dj z‖ ≤ c1 * E + c2 * (E * U) := by
    rw [hDj]
    refine b6.trans (le_of_eq ?_)
    rw [hc1, hc2]
