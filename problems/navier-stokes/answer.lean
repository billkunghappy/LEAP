      _ = X := by
          show 4 / Λ * Real.exp (Real.log (X * Λ / 4)) = X
          rw [Real.exp_log hXpos]
          field_simp
      _ ≤ 110 := hX1
  have hc : -1 - r < η := by linarith
  have hd : η < 1 + r := by linarith
  obtain ⟨ha0, ha1, hdA⟩ := hparam (axShearA h Λ t1 κ0 om Fn Un) (-1 - r) (1 + r) 0 (axLogY Λ X)
    hSA hc hd
  obtain ⟨hb0, hb1, hdB⟩ := hparam (axSlopeU h Λ t1 κ0 om Pax Fn Un) (-1 - r) (1 + r) 0
