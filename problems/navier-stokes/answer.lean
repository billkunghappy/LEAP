  have hEv : ∀ γ N η, E γ N η = ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) •
      (pchPair5 B G (pchAmp5 B P) (pchAmp5 B P) N γ η + pchPair5 B G (pchAmp5 B P) (pchAmp5 B P) N γ η) := by
