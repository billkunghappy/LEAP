    have e65 : Real.exp (-6) ≤ Real.exp (-5) := Real.exp_le_exp.mpr (by norm_num)
    have hX1 : 0 ≤ XR * Real.exp (-6) := by positivity
    have hX15 : XR * Real.exp (-6) ≤ XR * Real.exp (-5) := mul_le_mul_of_nonneg_left e65 hXR.le
