  · have h1 := hsplit (fun y => deriv (fun e => axShearA h Λ t1 κ0 om Fn Un y e) η)
      (fun y => axKap κ0 t1 y) (axLogY Λ X) (|M 1|) hs0.le hM1 ha1
      (fun y hy1 hy2 => (hpt y hy1.le (hZb y hy2)).2.2.1)
      (fun y hy1 hy2 => (hpt y hy1.le (hZb y hy2)).2.2.2.2.1)
      (fun y hy1 hy2 => (hpt y (by linarith) (hZb y hy2)).2.2.2.2.2 hy1)
    calc _ ≤ (t1 + κ0 * axLogY Λ X) * |M 1| := h1
      _ ≤ (t1 + κ0 * Real.log (110 * Λ / 4)) * |M 1| :=
          mul_le_mul_of_nonneg_right (by linarith) hM1
  · have h1 := hsplit (fun y => deriv (fun e => axSlopeU h Λ t1 κ0 om Pax Fn Un y e) η)
      (fun y => axKap κ0 t1 y) (axLogY Λ X) (|M 1| / 2) hs0.le (by positivity) hb1
