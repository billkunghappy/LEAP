theorem penv5_gauss : ∀ (lam u L : ℝ), 0 < lam → 0 < u → 0 < L → ∀ v : ℝ, 0 ≤ v → v ≤ L →
    -(lam * (9 * u ^ 2 / 4)) * (v - L / 2) ^ 2 / L ≤
      ∫ w in (L / 2)..v, (lam / Real.sqrt (1 + (u / 2 + u * w / L) ^ 2) -
        lam * (1 + (u / 2 + u * w / L) ^ 2) / (1 + u ^ 2) ^ (3/2:ℝ)) ∧
    ∫ w in (L / 2)..v, (lam / Real.sqrt (1 + (u / 2 + u * w / L) ^ 2) -
        lam * (1 + (u / 2 + u * w / L) ^ 2) / (1 + u ^ 2) ^ (3/2:ℝ)) ≤
      -(lam * u ^ 2 / (2 * (1 + u ^ 2) ^ (3/2:ℝ))) * (v - L / 2) ^ 2 / L :=
by
  intro lam u L hlam hu hL v hv0 hvL

  obtain ⟨S, hS⟩ : ∃ S : ℝ, S = Real.sqrt (1 + u ^ 2) := ⟨_, rfl⟩
  have hB1 : (1:ℝ) ≤ 1 + u ^ 2 := le_add_of_nonneg_right (sq_nonneg u)
  have hS1 : 1 ≤ S := by rw [hS]; exact Real.one_le_sqrt.mpr hB1
  have hSsq : S ^ 2 = 1 + u ^ 2 := by rw [hS]; exact Real.sq_sqrt (by linarith)
  have hP : (1 + u ^ 2) ^ (3/2:ℝ) = S ^ 2 * S := by
    rw [hS, Real.sq_sqrt (by linarith), show (3/2:ℝ) = 1 + 1/2 by norm_num,
      Real.rpow_add (by linarith), Real.rpow_one, Real.sqrt_eq_rpow]
  have hS0 : 0 < S := by linarith
  have hBS : 1 ≤ S ^ 2 * S := by
    have h := one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le hS1 hS1) hS1
    simpa [pow_two] using h

  have hG : ∀ a b : ℝ, ∫ w in a..b, (w - L / 2) / L =
      (b - L / 2) ^ 2 / (2 * L) - (a - L / 2) ^ 2 / (2 * L) := by
    intro a b
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (f := fun w => (w - L / 2) ^ 2 / (2 * L))]
    · intro x _
      have h0 := (((hasDerivAt_id' x).sub_const (L / 2)).pow 2).div_const (2 * L)
      refine HasDerivAt.congr_deriv h0 ?_
      field_simp
      ring
    · exact (by fun_prop : Continuous fun w : ℝ => (w - L / 2) / L).intervalIntegrable a b

  have main : ∀ (f : ℝ → ℝ) (α β : ℝ), Continuous f →
      (∀ w : ℝ, 0 ≤ w → w ≤ L → ∃ m : ℝ, α ≤ m ∧ m ≤ β ∧ f w = -m * ((w - L / 2) / L)) →
      -β * (v - L / 2) ^ 2 / (2 * L) ≤ ∫ w in (L / 2)..v, f w ∧
        ∫ w in (L / 2)..v, f w ≤ -α * (v - L / 2) ^ 2 / (2 * L) := by
    intro f α β hf hm
    have hcm : ∀ (k a b : ℝ), ∫ w in a..b, -k * ((w - L / 2) / L) =
        -k * ((b - L / 2) ^ 2 / (2 * L) - (a - L / 2) ^ 2 / (2 * L)) := by
      intro k a b
      rw [intervalIntegral.integral_const_mul, hG]
    have hki : ∀ k a b : ℝ, IntervalIntegrable (fun w : ℝ => -k * ((w - L / 2) / L))
        MeasureTheory.volume a b := fun k a b =>
      (by fun_prop : Continuous fun w : ℝ => -k * ((w - L / 2) / L)).intervalIntegrable a b
    rcases le_total (L / 2) v with hv | hv
    · have h1 : ∫ w in (L / 2)..v, -β * ((w - L / 2) / L) ≤ ∫ w in (L / 2)..v, f w := by
        apply intervalIntegral.integral_mono_on hv (hki _ _ _) (hf.intervalIntegrable _ _)
        intro w hw
        obtain ⟨m, _, hmβ, hfw⟩ := hm w (by linarith [hw.1]) (by linarith [hw.2])
        have hg : 0 ≤ (w - L / 2) / L := div_nonneg (by linarith [hw.1]) hL.le
        rw [hfw]
        have := mul_le_mul_of_nonneg_right hmβ hg
        linarith
      have h2 : ∫ w in (L / 2)..v, f w ≤ ∫ w in (L / 2)..v, -α * ((w - L / 2) / L) := by
        apply intervalIntegral.integral_mono_on hv (hf.intervalIntegrable _ _) (hki _ _ _)
        intro w hw
        obtain ⟨m, hαm, _, hfw⟩ := hm w (by linarith [hw.1]) (by linarith [hw.2])
        have hg : 0 ≤ (w - L / 2) / L := div_nonneg (by linarith [hw.1]) hL.le
        rw [hfw]
        have := mul_le_mul_of_nonneg_right hαm hg
        linarith
      rw [hcm] at h1 h2
      have e1 : -β * ((v - L / 2) ^ 2 / (2 * L) - (L / 2 - L / 2) ^ 2 / (2 * L)) =
          -β * (v - L / 2) ^ 2 / (2 * L) := by ring
      have e2 : -α * ((v - L / 2) ^ 2 / (2 * L) - (L / 2 - L / 2) ^ 2 / (2 * L)) =
          -α * (v - L / 2) ^ 2 / (2 * L) := by ring
      rw [e1] at h1
      rw [e2] at h2
      exact ⟨h1, h2⟩
    · have h1 : ∫ w in v..(L / 2), -α * ((w - L / 2) / L) ≤ ∫ w in v..(L / 2), f w := by
        apply intervalIntegral.integral_mono_on hv (hki _ _ _) (hf.intervalIntegrable _ _)
        intro w hw
        obtain ⟨m, hαm, _, hfw⟩ := hm w (by linarith [hw.1]) (by linarith [hw.2])
        have hg : (w - L / 2) / L ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith [hw.2]) hL.le
        rw [hfw]
        have := mul_le_mul_of_nonpos_right hαm hg
        linarith
      have h2 : ∫ w in v..(L / 2), f w ≤ ∫ w in v..(L / 2), -β * ((w - L / 2) / L) := by
        apply intervalIntegral.integral_mono_on hv (hf.intervalIntegrable _ _) (hki _ _ _)
        intro w hw
        obtain ⟨m, _, hmβ, hfw⟩ := hm w (by linarith [hw.1]) (by linarith [hw.2])
        have hg : (w - L / 2) / L ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith [hw.2]) hL.le
        rw [hfw]
        have := mul_le_mul_of_nonpos_right hmβ hg
        linarith
      rw [hcm] at h1 h2
      have e1 : -α * ((L / 2 - L / 2) ^ 2 / (2 * L) - (v - L / 2) ^ 2 / (2 * L)) =
          -(-α * (v - L / 2) ^ 2 / (2 * L)) := by ring
      have e2 : -β * ((L / 2 - L / 2) ^ 2 / (2 * L) - (v - L / 2) ^ 2 / (2 * L)) =
          -(-β * (v - L / 2) ^ 2 / (2 * L)) := by ring
      rw [e1] at h1
      rw [e2] at h2
      rw [intervalIntegral.integral_symm v (L / 2)]
      constructor <;> linarith

  have hpt : ∀ w : ℝ, 0 ≤ w → w ≤ L → ∃ m : ℝ, lam * u ^ 2 * (1 / (S ^ 2 * S)) ≤ m ∧
      m ≤ lam * u ^ 2 * (9 / 2) ∧
      (fun w => lam / Real.sqrt (1 + (u / 2 + u * w / L) ^ 2) -
        lam * (1 + (u / 2 + u * w / L) ^ 2) / (S ^ 2 * S)) w = -m * ((w - L / 2) / L) := by
    intro w hw0 hwL
    beta_reduce
    obtain ⟨e, he⟩ : ∃ e : ℝ, e = (w - L / 2) / L := ⟨_, rfl⟩
    have he1 : -1 / 2 ≤ e := by rw [he, le_div_iff₀ hL]; linarith
    have he2 : e ≤ 1 / 2 := by rw [he, div_le_iff₀ hL]; linarith
    have hY : u / 2 + u * w / L = u * (1 + e) := by rw [he]; field_simp; ring
    rw [hY, ← he]
    obtain ⟨R, hR⟩ : ∃ R : ℝ, R = Real.sqrt (1 + (u * (1 + e)) ^ 2) := ⟨_, rfl⟩
    have hR1 : 1 ≤ R := by
      rw [hR]; exact Real.one_le_sqrt.mpr (le_add_of_nonneg_right (sq_nonneg _))
    have hRsq : R ^ 2 = 1 + (u * (1 + e)) ^ 2 := by rw [hR]; exact Real.sq_sqrt (by positivity)
    have hR0 : 0 < R := by linarith
    rw [← hR, ← hRsq]

    have hRS : 1 ≤ R * S := one_le_mul_of_one_le_of_one_le hR1 hS1
    have hD : 2 ≤ R * S * (R + S) := by
      have := mul_le_mul hRS (show (2:ℝ) ≤ R + S by linarith) (by norm_num) (by linarith)
      linarith
    have ht1n : 0 ≤ 1 / (R * S * (R + S)) := by positivity
    have ht1u : 1 / (R * S * (R + S)) ≤ 1 / 2 := one_div_le_one_div_of_le (by norm_num) hD
    have ht2p : 0 < 1 / (S ^ 2 * S) := by positivity
