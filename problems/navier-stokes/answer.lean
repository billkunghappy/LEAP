    intro e he1 he2
    have hz : ∀ s ∈ Ioi (0:ℝ) \ Ioc 0 x, rfpU P s e * (2 * s * rfpF P s e) = 0 := by
      intro s hs
      rw [hUx s e (not_le.1 (fun h => hs.2 ⟨hs.1, h⟩)), zero_mul]
    unfold profRadInt
    rw [intervalIntegral.integral_of_le hx0.le,
      ← setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi Ioc_subset_Ioi_self hz]
    exact (hClM e he1 he2).2.1
  have hS : ∀ e, -1 < e → e < 1 →
      profRadInt (fun s e => rfpU P s e ^ 2 - s * rfpF P s e ^ 2) x e = rfpExtS P x e := by
    intro e he1 he2
    have hI := (hInt e he1 he2).2.1
    have hsplit : (∫ s in Ioi (0:ℝ), (rfpU P s e ^ 2 - s * rfpF P s e ^ 2)) =
        (∫ s in (0:ℝ)..x, (rfpU P s e ^ 2 - s * rfpF P s e ^ 2)) +
          ∫ s in Ioi x, (rfpU P s e ^ 2 - s * rfpF P s e ^ 2) := by
      rw [intervalIntegral.integral_of_le hx0.le, ← Ioc_union_Ioi_eq_Ioi hx0.le]
      exact setIntegral_union (Ioc_disjoint_Ioi_same) measurableSet_Ioi
        (hI.mono_set (by rw [← Ioc_union_Ioi_eq_Ioi hx0.le]; exact subset_union_left))
        (hI.mono_set (by rw [← Ioc_union_Ioi_eq_Ioi hx0.le]; exact subset_union_right))
    have htail : (∫ s in Ioi x, (rfpU P s e ^ 2 - s * rfpF P s e ^ 2)) = -rfpExtS P x e := by
      unfold rfpExtS
      rw [← integral_neg]
      refine setIntegral_congr_fun measurableSet_Ioi (fun s hs => ?_)
      show rfpU P s e ^ 2 - s * rfpF P s e ^ 2 = -(s * rfpF P s e ^ 2)
      rw [hUx s e hs]; ring
    have h0 := (hClM e he1 he2).2.2.1
    unfold profRadInt
    linarith
  have hAvg : ∀ e, profRadAvg (rfpU P) x e = x⁻¹ * profRadInt (rfpU P) x e := by
    intro e
    have h := intervalIntegral.integral_comp_mul_right (fun t => rfpU P t e) hx0.ne' (a := 0) (b := 1)
    simp only [zero_mul, one_mul, smul_eq_mul] at h
    exact h

  have hend : ∀ φ : ℝ → ℝ, (∀ e : ℝ, -1 < e → e < 1 → φ e = 0) →
      deriv φ η = 0 ∧ (ContinuousAt φ η → φ η = 0) := by
    intro φ hφ
    obtain ⟨L, hLne, hLle, hLev⟩ : ∃ L : Filter ℝ, L.NeBot ∧ L ≤ nhdsWithin η {η}ᶜ ∧
        ∀ᶠ e in L, φ e = 0 := by
      rcases eq_or_lt_of_le hη1 with h | h
      · refine ⟨nhdsWithin η (Ioi η), inferInstance, nhdsGT_le_nhdsNE η, ?_⟩
        filter_upwards [Ioo_mem_nhdsGT (show η < 1 by linarith)] with e he
        exact hφ e (by rw [h]; exact he.1) he.2
      · refine ⟨nhdsWithin η (Iio η), inferInstance, nhdsLT_le_nhdsNE η, ?_⟩
        filter_upwards [Ioo_mem_nhdsLT h] with e he
        exact hφ e he.1 (by linarith [he.2])
    have hval : ContinuousAt φ η → φ η = 0 := by
      intro hc
      have t1 : Filter.Tendsto φ L (nhds (φ η)) := hc.tendsto.mono_left (hLle.trans nhdsWithin_le_nhds)
      have t2 : Filter.Tendsto φ L (nhds 0) := tendsto_const_nhds.congr' (hLev.mono fun e he => he.symm)
      exact tendsto_nhds_unique t1 t2
    refine ⟨?_, hval⟩
    by_cases hd : DifferentiableAt ℝ φ η
    · have h0 := hval hd.continuousAt
      have t1 := (hasDerivAt_iff_tendsto_slope.mp hd.hasDerivAt).mono_left hLle
      have t2 : Filter.Tendsto (slope φ η) L (nhds 0) := by
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [hLev] with e he
        simp [slope_def_field, he, h0]
      exact tendsto_nhds_unique t1 t2
    · exact deriv_zero_of_not_differentiableAt hd

  obtain ⟨C, hC⟩ := hW 0
  simp only [iteratedDeriv_zero] at hC
  have hC0 : 0 ≤ C := (abs_nonneg _).trans (hC 1 0 one_pos (by norm_num)).2
  have hUb : ∀ s e, 0 < s → |e| ≤ 3 / 2 → |rfpU P s e| ≤ C := fun s e hs he => (hC s e hs he).2
  have hFb : ∀ s e, 0 < s → |e| ≤ 3 / 2 → |rfpF P s e| ≤ C * s ^ (-(2 / 5 : ℝ)) := by
    intro s e hs he
    have h1 : (1 + s) ^ (-(3 / 5 + P.h)) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (by linarith) (by linarith)
    calc |rfpF P s e| ≤ C * s ^ (-(2 / 5 : ℝ)) * (1 + s) ^ (-(3 / 5 + P.h)) := (hC s e hs he).1
      _ ≤ C * s ^ (-(2 / 5 : ℝ)) * 1 :=
          mul_le_mul_of_nonneg_left h1 (mul_nonneg hC0 (Real.rpow_nonneg hs.le _))
      _ = C * s ^ (-(2 / 5 : ℝ)) := mul_one _
  have hFt : ∀ s e, 0 < s → |e| ≤ 3 / 2 → |rfpF P s e| ≤ C * s ^ (-1 - P.h) := by
    intro s e hs he
    have h1 : (1 + s) ^ (-(3 / 5 + P.h)) ≤ s ^ (-(3 / 5 + P.h)) :=
      Real.rpow_le_rpow_of_nonpos hs (by linarith) (by linarith)
    have h2 : s ^ (-(2 / 5 : ℝ)) * s ^ (-(3 / 5 + P.h)) = s ^ (-1 - P.h) := by
      rw [← Real.rpow_add hs]; congr 1; ring
    calc |rfpF P s e| ≤ C * s ^ (-(2 / 5 : ℝ)) * (1 + s) ^ (-(3 / 5 + P.h)) := (hC s e hs he).1
      _ ≤ C * s ^ (-(2 / 5 : ℝ)) * s ^ (-(3 / 5 + P.h)) :=
          mul_le_mul_of_nonneg_left h1 (mul_nonneg hC0 (Real.rpow_nonneg hs.le _))
      _ = C * s ^ (-1 - P.h) := by rw [mul_assoc, h2]
  have hUc : ContinuousOn (fun p : ℝ × ℝ => rfpU P p.1 p.2) (Ioi 0 ×ˢ Ioo (-2) 2) := hUs.continuousOn
  have hFc : ContinuousOn (fun p : ℝ × ℝ => rfpF P p.1 p.2) (Ioi 0 ×ˢ Ioo (-2) 2) := hFs.continuousOn
  have hpt : ∀ (G : ℝ → ℝ → ℝ), ContinuousOn (fun p : ℝ × ℝ => G p.1 p.2) (Ioi 0 ×ˢ Ioo (-2) 2) →
      ∀ s, 0 < s → ContinuousAt (fun e => G s e) η := fun G hG s hs =>
    (hG.continuousAt (prod_mem_nhds (Ioi_mem_nhds hs) (Ioo_mem_nhds (by linarith) (by linarith)))).comp
      (f := fun e : ℝ => (s, e)) (continuous_const.prodMk continuous_id).continuousAt
  have hsl : ∀ (G : ℝ → ℝ → ℝ), ContinuousOn (fun p : ℝ × ℝ => G p.1 p.2) (Ioi 0 ×ˢ Ioo (-2) 2) →
      ∀ e, -2 < e → e < 2 → ContinuousOn (fun s => G s e) (Ioi 0) := fun G hG e h1 h2 =>
    hG.comp (continuous_id.prodMk continuous_const).continuousOn (fun s hs => ⟨hs, h1, h2⟩)
  have hcont : ∀ (G : ℝ → ℝ → ℝ) (Bd : ℝ),
      ContinuousOn (fun p : ℝ × ℝ => G p.1 p.2) (Ioi 0 ×ˢ Ioo (-2) 2) →
      (∀ s e : ℝ, 0 < s → s ≤ x → |e| ≤ 3 / 2 → |G s e| ≤ Bd) →
      ContinuousAt (fun e => ∫ s in (0:ℝ)..x, G s e) η := by
    intro G Bd hG hBd
    apply intervalIntegral.continuousAt_of_dominated_interval (bound := fun _ => Bd)
    · filter_upwards [Ioo_mem_nhds (show -2 < η by linarith) (show η < 2 by linarith)] with e he
      rw [Set.uIoc_of_le hx0.le]
      exact ((hsl G hG e he.1 he.2).mono Ioc_subset_Ioi_self).aestronglyMeasurable measurableSet_Ioc
    · filter_upwards [Ioo_mem_nhds (show -3 / 2 < η by linarith) (show η < 3 / 2 by linarith)] with e he
      refine ae_of_all _ (fun s hs => ?_)
      rw [Set.uIoc_of_le hx0.le] at hs
      rw [Real.norm_eq_abs]
      exact hBd s e hs.1 hs.2 (abs_le.2 ⟨by linarith [he.1], by linarith [he.2]⟩)
    · exact intervalIntegrable_const
    · refine ae_of_all _ (fun s hs => ?_)
      rw [Set.uIoc_of_le hx0.le] at hs
      exact hpt G hG s hs.1
  have hcM : ContinuousAt (fun e => profRadInt (rfpU P) x e) η :=
    hcont (rfpU P) C hUc (fun s e hs _ he => hUb s e hs he)
  have hcJ : ContinuousAt (fun e => profRadInt (fun s e => rfpU P s e * (2 * s * rfpF P s e)) x e) η := by
    refine hcont (fun s e => rfpU P s e * (2 * s * rfpF P s e)) (2 * C ^ 2 * x ^ (3 / 5 : ℝ))
      (hUc.mul ((continuousOn_const.mul continuousOn_fst).mul hFc)) ?_
    intro s e hs hsx he
    have hU := hUb s e hs he
    have hF := hFb s e hs he
    have e35 : s ^ (1:ℝ) * s ^ (-(2 / 5 : ℝ)) = s ^ (3 / 5 : ℝ) := by
      rw [← Real.rpow_add hs]; norm_num
    rw [Real.rpow_one] at e35
    have h3 : s ^ (3 / 5 : ℝ) ≤ x ^ (3 / 5 : ℝ) := Real.rpow_le_rpow hs.le hsx (by norm_num)
    have h1 : |rfpU P s e * (2 * s * rfpF P s e)| ≤ C * (2 * s * (C * s ^ (-(2 / 5 : ℝ)))) := by
      rw [abs_mul, abs_mul, abs_mul, abs_two, abs_of_pos hs]
      exact mul_le_mul hU (mul_le_mul_of_nonneg_left hF (by linarith))
        (mul_nonneg (by linarith) (abs_nonneg _)) hC0
    calc |rfpU P s e * (2 * s * rfpF P s e)| ≤ C * (2 * s * (C * s ^ (-(2 / 5 : ℝ)))) := h1
      _ = 2 * C ^ 2 * (s * s ^ (-(2 / 5 : ℝ))) := by ring
      _ ≤ 2 * C ^ 2 * x ^ (3 / 5 : ℝ) := by
          rw [e35]; exact mul_le_mul_of_nonneg_left h3 (by positivity)
  have hcS0 : ContinuousAt
      (fun e => profRadInt (fun s e => rfpU P s e ^ 2 - s * rfpF P s e ^ 2) x e) η := by
    refine hcont (fun s e => rfpU P s e ^ 2 - s * rfpF P s e ^ 2) (C ^ 2 + C ^ 2 * x ^ (1 / 5 : ℝ))
      ((hUc.pow 2).sub (continuousOn_fst.mul (hFc.pow 2))) ?_
    intro s e hs hsx he
    have hU := hUb s e hs he
    have hF := hFb s e hs he
    have hU2 : rfpU P s e ^ 2 ≤ C ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hU 2
    have hF2 : rfpF P s e ^ 2 ≤ (C * s ^ (-(2 / 5 : ℝ))) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hF 2
    have e15 : s ^ (1:ℝ) * s ^ (-(2 / 5 : ℝ)) * s ^ (-(2 / 5 : ℝ)) = s ^ (1 / 5 : ℝ) := by
      rw [← Real.rpow_add hs, ← Real.rpow_add hs]; norm_num
    rw [Real.rpow_one] at e15
    have h4 : s * rfpF P s e ^ 2 ≤ s * (C * s ^ (-(2 / 5 : ℝ))) ^ 2 :=
      mul_le_mul_of_nonneg_left hF2 hs.le
    have h5 : s * (C * s ^ (-(2 / 5 : ℝ))) ^ 2 = C ^ 2 * s ^ (1 / 5 : ℝ) := by rw [← e15]; ring
    have h6 : s ^ (1 / 5 : ℝ) ≤ x ^ (1 / 5 : ℝ) := Real.rpow_le_rpow hs.le hsx (by norm_num)
    have h7 : C ^ 2 * s ^ (1 / 5 : ℝ) ≤ C ^ 2 * x ^ (1 / 5 : ℝ) := mul_le_mul_of_nonneg_left h6 (sq_nonneg C)
    have h8 : 0 ≤ s * rfpF P s e ^ 2 := mul_nonneg hs.le (sq_nonneg _)
    have h9 : 0 ≤ rfpU P s e ^ 2 := sq_nonneg _
    have h10 : 0 ≤ C ^ 2 * x ^ (1 / 5 : ℝ) := mul_nonneg (sq_nonneg C) (Real.rpow_nonneg hx0.le _)
    rw [abs_le]
    constructor <;> nlinarith
  have hcSt : ContinuousAt (fun e => rfpExtS P x e) η := by
    show ContinuousAt (fun e => ∫ s in Ioi x, s * rfpF P s e ^ 2) η
    apply continuousAt_of_dominated (bound := fun s => C ^ 2 * s ^ (-1 - 2 * P.h))
    · filter_upwards [Ioo_mem_nhds (show -2 < η by linarith) (show η < 2 by linarith)] with e he
      have hc : ContinuousOn (fun s => s * rfpF P s e ^ 2) (Ioi x) :=
        (continuousOn_id.mul ((hsl (rfpF P) hFc e he.1 he.2).pow 2)).mono
          (Ioi_subset_Ioi hx0.le)
      exact hc.aestronglyMeasurable measurableSet_Ioi
    · filter_upwards [Ioo_mem_nhds (show -3 / 2 < η by linarith) (show η < 3 / 2 by linarith)] with e he
      refine (ae_restrict_iff' measurableSet_Ioi).2 (ae_of_all _ (fun s hs => ?_))
      have hs0 : 0 < s := lt_trans hx0 hs
      have hF := hFt s e hs0 (abs_le.2 ⟨by linarith [he.1], by linarith [he.2]⟩)
      have hF2 : rfpF P s e ^ 2 ≤ (C * s ^ (-1 - P.h)) ^ 2 := by
        rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hF 2
      have e1 : s ^ (1:ℝ) * s ^ (-1 - P.h) * s ^ (-1 - P.h) = s ^ (-1 - 2 * P.h) := by
        rw [← Real.rpow_add hs0, ← Real.rpow_add hs0]; congr 1; ring
      rw [Real.rpow_one] at e1
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hs0.le (sq_nonneg _))]
      calc s * rfpF P s e ^ 2 ≤ s * (C * s ^ (-1 - P.h)) ^ 2 := mul_le_mul_of_nonneg_left hF2 hs0.le
        _ = C ^ 2 * s ^ (-1 - 2 * P.h) := by rw [← e1]; ring
    · exact (integrableOn_Ioi_rpow_of_lt (by linarith) hx0).const_mul _
    · refine (ae_restrict_iff' measurableSet_Ioi).2 (ae_of_all _ (fun s hs => ?_))
      exact continuousAt_const.mul ((hpt (rfpF P) hFc s (lt_trans hx0 hs)).pow 2)

  have hMv : profRadInt (rfpU P) x η = 0 := (hend (fun e => profRadInt (rfpU P) x e) hM).2 hcM
  have hMd : profEtaD (profRadInt (rfpU P)) x η = 0 :=
    (hend (fun e => profRadInt (rfpU P) x e) hM).1
  have hJv : profRadInt (fun s e => rfpU P s e * (2 * s * rfpF P s e)) x η = 0 :=
    (hend (fun e => profRadInt (fun s e => rfpU P s e * (2 * s * rfpF P s e)) x e) hJ).2 hcJ
  have hJd : profEtaD (profRadInt (fun s e => rfpU P s e * (2 * s * rfpF P s e))) x η = 0 :=
    (hend (fun e => profRadInt (fun s e => rfpU P s e * (2 * s * rfpF P s e)) x e) hJ).1
  have hS0v : profRadInt (fun s e => rfpU P s e ^ 2 - s * rfpF P s e ^ 2) x η = rfpExtS P x η := by
    have h := (hend (fun e => profRadInt (fun s e => rfpU P s e ^ 2 - s * rfpF P s e ^ 2) x e
      - rfpExtS P x e) (fun e h1 h2 => by simp only [hS e h1 h2, sub_self])).2 (hcS0.sub hcSt)
    exact sub_eq_zero.1 h
  have hSd : (1 - η ^ 2) * profEtaD (profRadInt (fun s e => rfpU P s e ^ 2 - s * rfpF P s e ^ 2)) x η =
      (1 - η ^ 2) * profEtaD (rfpExtS P) x η := by
    rcases lt_or_eq_of_le hη1 with h1 | h1
    · rcases lt_or_eq_of_le hη2 with h2 | h2
      · congr 1
        unfold profEtaD
        apply Filter.EventuallyEq.deriv_eq
        filter_upwards [Ioo_mem_nhds h1 h2] with e he
        exact hS e he.1 he.2
      · rw [h2]; ring
    · rw [← h1]; ring
  have hAv : profRadAvg (rfpU P) x η = 0 := by rw [hAvg, hMv, mul_zero]
  have hAd : profEtaD (profRadAvg (rfpU P)) x η = 0 :=
    (hend (fun e => profRadAvg (rfpU P) x e) (fun e h1 h2 => by rw [hAvg, hM e h1 h2, mul_zero])).1
  have hW1 : leadW P.h (rfpU P) x η = 1 := by
    unfold leadW
    rw [hAv, hAd]; ring
  refine ⟨hB, ?_, ?_⟩
  · unfold leadQs rfpExtQ
    rw [hW1, hJv, hJd]
    ring
  · unfold leadNs rfpExtN
    rw [hW1, hUz x η hltx, hMv, hMd, hSd, hS0v]
    ring

theorem sigA_deriv_facts : Differentiable ℝ sigA ∧ (∀ t : ℝ, 0 ≤ deriv sigA t ∧ deriv sigA t ≤ 200) ∧ (∀ t : ℝ, (t ≤ 0 ∨ 1 ≤ t) → deriv sigA t = 0) :=
by

  have hC : ContDiff ℝ 1 sigA := by
    have hm : ∀ y : ℝ, HasDerivAt (fun w : ℝ => w * |w|) (2 * |y|) y := by
      intro y
      rcases lt_trichotomy y 0 with hy | hy | hy
      · have h1 : HasDerivAt (fun w : ℝ => -(w ^ 2)) (2 * |y|) y := by
          have := (hasDerivAt_pow 2 y).neg
          convert this using 1
          rw [abs_of_neg hy]; push_cast; ring
        refine h1.congr_of_eventuallyEq ?_
        filter_upwards [Iio_mem_nhds hy] with w hw
        rw [abs_of_neg hw]; ring
      · subst hy
        rw [hasDerivAt_iff_isLittleO, Asymptotics.isLittleO_iff]
        intro c hc
        filter_upwards [Metric.ball_mem_nhds (0:ℝ) hc] with w hw
        rw [Metric.mem_ball, Real.dist_eq, sub_zero] at hw
        simp only [abs_zero, mul_zero, sub_zero, smul_zero, Real.norm_eq_abs, abs_mul, abs_abs]
        exact mul_le_mul_of_nonneg_right hw.le (abs_nonneg w)
      · have h1 : HasDerivAt (fun w : ℝ => w ^ 2) (2 * |y|) y := by
          convert hasDerivAt_pow 2 y using 1
          rw [abs_of_pos hy]; push_cast; ring
        refine h1.congr_of_eventuallyEq ?_
        filter_upwards [Ioi_mem_nhds hy] with w hw
        rw [abs_of_pos hw]; ring
    have hmC : ContDiff ℝ 1 (fun w : ℝ => w * |w|) := by
      rw [contDiff_one_iff_deriv]
      refine ⟨fun y => (hm y).differentiableAt, ?_⟩
      have hd : deriv (fun w : ℝ => w * |w|) = fun y => 2 * |y| := funext fun y => (hm y).deriv
      rw [hd]
      exact continuous_const.mul continuous_abs
    obtain ⟨q, hq_def⟩ : ∃ q : ℝ → ℝ, q = fun y => expNegInvGlue (y * |y|) := ⟨_, rfl⟩
    have hqC : ContDiff ℝ 1 q := by
      rw [hq_def]
      exact expNegInvGlue.contDiff.comp hmC
    have hq1C : ContDiff ℝ 1 (fun y => q (1 - y)) := hqC.comp (contDiff_const.sub contDiff_id)
    have hDC : ContDiff ℝ 1 (fun y => q y + q (1 - y)) := hqC.add hq1C
    have qpos_arg : ∀ y : ℝ, 0 < y → 0 < y * |y| := fun y hy => by
      rw [abs_of_pos hy]; exact mul_pos hy hy
    have qa : ∀ y : ℝ, y ≤ 0 → q y = 0 := fun y hy => by
      rw [hq_def]
      exact expNegInvGlue.zero_of_nonpos (mul_nonpos_of_nonpos_of_nonneg hy (abs_nonneg y))
    have qb : ∀ y : ℝ, 0 < y → 0 < q y := fun y hy => by
      rw [hq_def]
      exact expNegInvGlue.pos_of_pos (qpos_arg y hy)
    have qc : ∀ y : ℝ, 0 ≤ q y := fun y => by
      rw [hq_def]
      exact expNegInvGlue.nonneg _
    have qd : ∀ y : ℝ, 0 < y → q y = Real.exp (-1 / y ^ 2) := by
      intro y hy
      rw [hq_def]
      show expNegInvGlue (y * |y|) = _
      rw [expNegInvGlue, if_neg (not_le.mpr (qpos_arg y hy)), abs_of_pos hy]
      congr 1
      rw [neg_div, one_div, sq]
    have hDpos : ∀ y : ℝ, 0 < q y + q (1 - y) := by
      intro y
      by_cases hy : 0 < y
      · exact add_pos_of_pos_of_nonneg (qb y hy) (qc _)
      · exact add_pos_of_nonneg_of_pos (qc y) (qb _ (by linarith [not_lt.mp hy]))
    have heq : sigA = fun y => q y / (q y + q (1 - y)) := by
      funext y
      unfold sigA
      split_ifs with h1 h2
      · rw [qa y h1, zero_div]
      · have hy : 0 < y := not_le.mp h1
        rw [qa (1 - y) (by linarith), add_zero, div_self (qb y hy).ne']
      · have hy : 0 < y := not_le.mp h1
        rw [qd y hy, qd (1 - y) (by linarith [not_le.mp h2])]
    rw [heq]
    exact hqC.div hDC (fun y => (hDpos y).ne')
  have hdiff : Differentiable ℝ sigA := hC.differentiable (by norm_num)
  have hcont : Continuous (deriv sigA) := hC.continuous_deriv le_rfl

  have hneg : ∀ t : ℝ, t < 0 → deriv sigA t = 0 := by
    intro t ht
    have hev : sigA =ᶠ[nhds t] fun _ => (0:ℝ) := by
      filter_upwards [Iio_mem_nhds ht] with y hy
      have hy' : y < 0 := hy
      unfold sigA
      rw [if_pos hy'.le]
    rw [hev.deriv_eq]
    simp
  have hbig : ∀ t : ℝ, 1 < t → deriv sigA t = 0 := by
    intro t ht
    have hev : sigA =ᶠ[nhds t] fun _ => (1:ℝ) := by
      filter_upwards [Ioi_mem_nhds ht] with y hy
      have hy' : (1:ℝ) < y := hy
      unfold sigA
      rw [if_neg (by linarith), if_pos hy'.le]
    rw [hev.deriv_eq]
    simp

  have hZ : IsClosed {y : ℝ | deriv sigA y = 0} := isClosed_eq hcont continuous_const
  have hle0 : ∀ t : ℝ, t ≤ 0 → deriv sigA t = 0 := by
    intro t ht
    have hsub : Set.Iio (0:ℝ) ⊆ {y : ℝ | deriv sigA y = 0} := fun y hy => hneg y hy
    have h2 := hZ.closure_subset_iff.mpr hsub
    rw [closure_Iio] at h2
    exact h2 (Set.mem_Iic.mpr ht)
  have hge1 : ∀ t : ℝ, 1 ≤ t → deriv sigA t = 0 := by
    intro t ht
    have hsub : Set.Ioi (1:ℝ) ⊆ {y : ℝ | deriv sigA y = 0} := fun y hy => hbig y hy
    have h2 := hZ.closure_subset_iff.mpr hsub
    rw [closure_Ioi] at h2
    exact h2 (Set.mem_Ici.mpr ht)

  have hmid : ∀ t : ℝ, 0 < t → t < 1 → HasDerivAt sigA
      (Real.exp (-1 / t ^ 2) * Real.exp (-1 / (1 - t) ^ 2) * (2 / t ^ 3 + 2 / (1 - t) ^ 3) /
        (Real.exp (-1 / t ^ 2) + Real.exp (-1 / (1 - t) ^ 2)) ^ 2) t := by
    intro t ht0 ht1
    have hs0 : (1 - t) ≠ 0 := by linarith
    have ht0' : t ≠ 0 := ht0.ne'
    have hp : HasDerivAt (fun y : ℝ => -1 / y ^ 2) (2 / t ^ 3) t := by
      have h1 : HasDerivAt (fun y : ℝ => y ^ 2) (2 * t) t := by
        simpa using hasDerivAt_pow 2 t
      have := (hasDerivAt_const t (-1:ℝ)).div h1 (pow_ne_zero 2 ht0')
      convert this using 1
      field_simp
      ring
    have hq : HasDerivAt (fun y : ℝ => -1 / (1 - y) ^ 2) (-(2 / (1 - t) ^ 3)) t := by
      have h1 : HasDerivAt (fun y : ℝ => (1 - y) ^ 2) (-(2 * (1 - t))) t := by
        have h0 : HasDerivAt (fun y : ℝ => 1 - y) (-1) t := by
          simpa using (hasDerivAt_id t).const_sub (1:ℝ)
        have := h0.pow 2
        convert this using 1
        simp
      have := (hasDerivAt_const t (-1:ℝ)).div h1 (pow_ne_zero 2 hs0)
      convert this using 1
      field_simp
      ring
    have ha := hp.exp
    have hb := hq.exp
    have hS : Real.exp (-1 / t ^ 2) + Real.exp (-1 / (1 - t) ^ 2) ≠ 0 := by positivity
    have hg := ha.div (ha.add hb) hS
    have hev : sigA =ᶠ[nhds t] fun y => Real.exp (-1 / y ^ 2) /
        (Real.exp (-1 / y ^ 2) + Real.exp (-1 / (1 - y) ^ 2)) := by
      filter_upwards [isOpen_Ioo.mem_nhds (show t ∈ Set.Ioo (0:ℝ) 1 from ⟨ht0, ht1⟩)] with y hy
      unfold sigA
      rw [if_neg (not_le.mpr hy.1), if_neg (not_le.mpr hy.2)]
    refine (hg.congr_of_eventuallyEq hev).congr_deriv ?_
    simp only [Pi.add_apply]
    congr 1
    ring

  have key : ∀ u v : ℝ, 0 < u → u ≤ 1 / 2 → 1 / 2 ≤ v →
      Real.exp (-1 / u ^ 2) * Real.exp (-1 / v ^ 2) * (2 / u ^ 3 + 2 / v ^ 3) ≤
        166 * (Real.exp (-1 / u ^ 2) + Real.exp (-1 / v ^ 2)) ^ 2 := by
    intro u v hu hu2 hv
    have hv0 : 0 < v := by linarith
    have hA0 : 0 < Real.exp (-1 / u ^ 2) := Real.exp_pos _
    have hB0 : 0 < Real.exp (-1 / v ^ 2) := Real.exp_pos _

    have hAx : Real.exp (-1 / u ^ 2) * (1 / u ^ 2) ^ 2 ≤ 2 := by
      have hx0 : 0 ≤ 1 / u ^ 2 := by positivity
      have h3 := Real.pow_div_factorial_le_exp (1 / u ^ 2) hx0 2
      have hf : ((Nat.factorial 2 : ℕ) : ℝ) = 2 := by norm_num [Nat.factorial]
      rw [hf] at h3
      have hprod : Real.exp (-1 / u ^ 2) * Real.exp (1 / u ^ 2) = 1 := by
        rw [← Real.exp_add]
        rw [show -1 / u ^ 2 + 1 / u ^ 2 = 0 by ring, Real.exp_zero]
      have := mul_le_mul_of_nonneg_left h3 hA0.le
      nlinarith
    have hX : Real.exp (-1 / u ^ 2) * (2 / u ^ 3) ≤ 2 := by
      have e : Real.exp (-1 / u ^ 2) * (2 / u ^ 3) =
          Real.exp (-1 / u ^ 2) * (1 / u ^ 2) ^ 2 * (2 * u) := by
        have hu0 : u ≠ 0 := hu.ne'
        field_simp
      rw [e]
      have := mul_le_mul_of_nonneg_right hAx (by positivity : (0:ℝ) ≤ 2 * u)
      nlinarith
    have hY : 2 / v ^ 3 ≤ 16 := by
      have hv3 : (1 / 2 : ℝ) ^ 3 ≤ v ^ 3 := pow_le_pow_left₀ (by norm_num) hv 3
      rw [div_le_iff₀ (by positivity)]
      nlinarith
    have hB : 1 ≤ 81 * Real.exp (-1 / v ^ 2) := by
      have hiv : 1 / v ^ 2 ≤ 4 := by
        have hv2 : (1 / 2 : ℝ) ^ 2 ≤ v ^ 2 := pow_le_pow_left₀ (by norm_num) hv 2
        rw [div_le_iff₀ (by positivity)]
        nlinarith
      have hle : Real.exp (-4) ≤ Real.exp (-1 / v ^ 2) := by
        apply Real.exp_le_exp.mpr
        rw [neg_div]
        linarith
      have he1 := Real.exp_one_lt_d9
      have he0 := Real.exp_pos 1
      have he4 : Real.exp 4 = Real.exp 1 * Real.exp 1 * Real.exp 1 * Real.exp 1 := by
        rw [← Real.exp_add, ← Real.exp_add, ← Real.exp_add]
        norm_num
      have h81 : Real.exp 4 < 81 := by
        rw [he4]
        have h3 : Real.exp 1 < 3 := by linarith
        have h1 : Real.exp 1 * Real.exp 1 < 9 := by nlinarith
        nlinarith
      have hprod : Real.exp (-4) * Real.exp 4 = 1 := by
        rw [← Real.exp_add]; norm_num
      have := Real.exp_pos (-4)
      nlinarith
    set A := Real.exp (-1 / u ^ 2) with hAdef
    set B := Real.exp (-1 / v ^ 2) with hBdef
    have e : A * B * (2 / u ^ 3 + 2 / v ^ 3) = (A * (2 / u ^ 3)) * B + A * B * (2 / v ^ 3) := by
      ring
    rw [e]
    have i1 := mul_le_mul_of_nonneg_right hX hB0.le
    have i2 := mul_le_mul_of_nonneg_left hY (mul_pos hA0 hB0).le
    have i3 := mul_le_mul_of_nonneg_left hB (by positivity : (0:ℝ) ≤ 2 * B)
    nlinarith [sq_nonneg (A - B), mul_pos hA0 hB0]
  have hbound : ∀ t : ℝ, 0 < t → t < 1 →
      0 ≤ Real.exp (-1 / t ^ 2) * Real.exp (-1 / (1 - t) ^ 2) * (2 / t ^ 3 + 2 / (1 - t) ^ 3) /
        (Real.exp (-1 / t ^ 2) + Real.exp (-1 / (1 - t) ^ 2)) ^ 2 ∧
      Real.exp (-1 / t ^ 2) * Real.exp (-1 / (1 - t) ^ 2) * (2 / t ^ 3 + 2 / (1 - t) ^ 3) /
        (Real.exp (-1 / t ^ 2) + Real.exp (-1 / (1 - t) ^ 2)) ^ 2 ≤ 200 := by
    intro t ht0 ht1
    have hs : 0 < 1 - t := by linarith
    have hA0 : 0 < Real.exp (-1 / t ^ 2) := Real.exp_pos _
    have hB0 : 0 < Real.exp (-1 / (1 - t) ^ 2) := Real.exp_pos _
    have hS2 : 0 < (Real.exp (-1 / t ^ 2) + Real.exp (-1 / (1 - t) ^ 2)) ^ 2 := by positivity
    have hN : Real.exp (-1 / t ^ 2) * Real.exp (-1 / (1 - t) ^ 2) * (2 / t ^ 3 + 2 / (1 - t) ^ 3) ≤
        166 * (Real.exp (-1 / t ^ 2) + Real.exp (-1 / (1 - t) ^ 2)) ^ 2 := by
      by_cases hc : t ≤ 1 / 2
      · exact key t (1 - t) ht0 hc (by linarith)
      · have h := key (1 - t) t hs (by linarith) (by linarith)
        have e1 : Real.exp (-1 / t ^ 2) * Real.exp (-1 / (1 - t) ^ 2) * (2 / t ^ 3 + 2 / (1 - t) ^ 3) =
            Real.exp (-1 / (1 - t) ^ 2) * Real.exp (-1 / t ^ 2) * (2 / (1 - t) ^ 3 + 2 / t ^ 3) := by
          ring
        have e2 : (Real.exp (-1 / t ^ 2) + Real.exp (-1 / (1 - t) ^ 2)) ^ 2 =
            (Real.exp (-1 / (1 - t) ^ 2) + Real.exp (-1 / t ^ 2)) ^ 2 := by
          ring
        rw [e1, e2]
        exact h
    have hpos : 0 ≤ Real.exp (-1 / t ^ 2) * Real.exp (-1 / (1 - t) ^ 2) * (2 / t ^ 3 + 2 / (1 - t) ^ 3) := by
      have : 0 ≤ 2 / (1 - t) ^ 3 := by positivity
      have : 0 ≤ 2 / t ^ 3 := by positivity
      positivity
    refine ⟨div_nonneg hpos hS2.le, ?_⟩
    rw [div_le_iff₀ hS2]
    linarith

  refine ⟨hdiff, ?_, ?_⟩
  · intro t
    by_cases h0 : t ≤ 0
    · rw [hle0 t h0]; norm_num
    by_cases h1 : 1 ≤ t
    · rw [hge1 t h1]; norm_num
    have ht0 : 0 < t := not_le.mp h0
    have ht1 : t < 1 := not_le.mp h1
    rw [(hmid t ht0 ht1).deriv]
    exact hbound t ht0 ht1
  · intro t ht
    rcases ht with h | h
    · exact hle0 t h
    · exact hge1 t h

theorem rfp_extA_slope : (Differentiable ℝ sigA ∧ (∀ t : ℝ, 0 ≤ deriv sigA t ∧ deriv sigA t ≤ 200) ∧ (∀ t : ℝ, (t ≤ 0 ∨ 1 ≤ t) → deriv sigA t = 0)) → ∀ P : RfpPar, RfpRegime P → RfpClos P → ∀ y η : ℝ, rfpY2 P.Md + 1 ≤ y → y ≤ rfpY6 P → -1 ≤ η → η ≤ 1 → DifferentiableAt ℝ (fun v => rfpE P v η) y ∧ -5 * rfpE P y η ≤ deriv (fun v => rfpE P v η) y ∧ deriv (fun v => rfpE P v η) y ≤ -(1 / 2 + P.h) * rfpE P y η ∧ (y ≤ rfpY5 P.Md P.lam + 1 + P.T1 → deriv (fun v => rfpE P v η) y ≤ -(1 / 2 + P.lam / 2) * rfpE P y η) ∧ (rfpY5 P.Md P.lam + 1 ≤ y → y ≤ rfpY5 P.Md P.lam + 1 + P.T1 → deriv (fun v => rfpE P v η) y ≤ -(3 / 2) * rfpE P y η) :=
by
  intro H P hReg hClos y η hy1 hy2 hη1 hη2
  obtain ⟨hσd, hσ'b, hσ'0⟩ := H
  obtain ⟨hs0, hs1, hs01, hσc, -, -, -, -, -⟩ := rfp_sig_basics
  have hReg' := hReg
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hReg'

  have hl2 : P.lam ^ 2 ≤ P.lam / 100 := by nlinarith
  have hhs : P.h ≤ 1 / 10000 := by nlinarith
  have hhlam : P.h ≤ P.lam / 100 := by linarith
  have hlog1l : 0 ≤ Real.log (1 / P.lam) :=
    Real.log_nonneg (by rw [le_div_iff₀ hl0]; linarith)
  have hlogh : 0 ≤ Real.log (1 / P.h) :=
    Real.log_nonneg (by rw [le_div_iff₀ hh0]; linarith)
  have hT0 : 0 ≤ P.T1 := by linarith
  have hρ1 : 0 < 1 - P.ρ := by linarith
  have hy211 : 11 ≤ rfpY2 P.Md := by unfold rfpY2; linarith [Real.exp_pos P.Md]
  have eY5 : rfpY5 P.Md P.lam = rfpY4 P.Md P.lam + 60 + 30 * Real.log (1 / P.lam) := rfl
  have eY6 : rfpY6 P = rfpY5 P.Md P.lam + 2 + P.T1 := rfl
  have eYb : rfpYb P.Md P.lam P.T1 P.Lh = rfpY5 P.Md P.lam + 2 + P.T1 + P.Lh + 3 := rfl

  have hSI : ∀ t, HasDerivAt rfpSigI (sigA t) t := by
    intro t
    show HasDerivAt (fun u => ∫ x in (0:ℝ)..u, sigA x) (sigA t) t
    exact (hσc.integral_hasStrictDerivAt 0 t).hasDerivAt
  have hS2 : HasDerivAt (fun v => rfpSigI (v - rfpY2 P.Md)) (sigA (y - rfpY2 P.Md)) y := by
    have h := (hSI (y - rfpY2 P.Md)).comp y ((hasDerivAt_id' y).sub_const (rfpY2 P.Md))
    rw [mul_one] at h
    exact h
  have hS5 : HasDerivAt (fun v => rfpSigI (v - rfpY5 P.Md P.lam)) (sigA (y - rfpY5 P.Md P.lam)) y := by
    have h := (hSI (y - rfpY5 P.Md P.lam)).comp y ((hasDerivAt_id' y).sub_const (rfpY5 P.Md P.lam))
    rw [mul_one] at h
    exact h
  have hSz : HasDerivAt (fun v => rfpSigI (v - rfpY5 P.Md P.lam - 1 - P.T1))
      (sigA (y - rfpY5 P.Md P.lam - 1 - P.T1)) y := by
    have h := (hSI (y - rfpY5 P.Md P.lam - 1 - P.T1)).comp y
      ((((hasDerivAt_id' y).sub_const (rfpY5 P.Md P.lam)).sub_const 1).sub_const P.T1)
    rw [mul_one] at h
    exact h
  have hsig : HasDerivAt (fun v => sigA ((v - rfpY4 P.Md P.lam) / 60))
      (deriv sigA ((y - rfpY4 P.Md P.lam) / 60) * (1 / 60)) y := by
    have h := (hσd ((y - rfpY4 P.Md P.lam) / 60)).hasDerivAt.comp y
      (((hasDerivAt_id' y).sub_const (rfpY4 P.Md P.lam)).div_const 60)
    exact h

  have hT : HasDerivAt (fun v => Real.log (tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh))
      (Real.exp v) / (1 - P.ρ))) 0 y := by
    apply (hasDerivAt_const y (0:ℝ)).congr_of_eventuallyEq
    have hyb : y < rfpYb P.Md P.lam P.T1 P.Lh - 2 := by rw [eYb]; rw [eY6] at hy2; linarith
    filter_upwards [Iio_mem_nhds hyb] with v hv
    have hv' : v < rfpYb P.Md P.lam P.T1 P.Lh - 2 := hv
    show Real.log (tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp v) / (1 - P.ρ)) = 0
    unfold tailFac
    rw [← Real.exp_sub, Real.log_exp,
      hs0 ((v - rfpYb P.Md P.lam P.T1 P.Lh + 2) / 2) (by linarith), sub_zero, mul_one,
      div_self hρ1.ne', Real.log_one]

  have hLam : HasDerivAt (rfpLam P) (1 / 10 - 3 / 5 * sigA y - P.lam * sigA (y - rfpY2 P.Md)
      - (1 - P.lam) * sigA (y - rfpY5 P.Md P.lam) + (1 - P.h) * sigA (y - rfpY5 P.Md P.lam - 1 - P.T1)
      - deriv sigA ((y - rfpY4 P.Md P.lam) / 60) / 60 * Real.log 2) y := by
    have h0 := (((((((hasDerivAt_const y (Real.log P.Pst)).add ((hasDerivAt_id' y).div_const 10)).sub
      ((hSI y).const_mul (3 / 5))).sub (hS2.const_mul P.lam)).sub (hS5.const_mul (1 - P.lam))).add
      (hSz.const_mul (1 - P.h))).sub (hsig.mul_const (Real.log 2))).add hT
    have h1 : HasDerivAt (fun v => rfpLam P v) _ y := h0
    exact h1.congr_deriv (by ring)

  have hTh : HasDerivAt (rfpTh P) (-(deriv sigA ((y - rfpY4 P.Md P.lam) / 60) * (1 / 60))) y :=
    hsig.const_sub 1

  obtain ⟨Bf, hBf⟩ : ∃ Bf : ℝ → ℝ, ∀ t, Bf t = deriv sigA (1 + t / (3 / 20)) * (1 / (3 / 20)) *
      sigA (1 - t / (3 / 20)) + sigA (1 + t / (3 / 20)) * (deriv sigA (1 - t / (3 / 20)) * -(1 / (3 / 20))) :=
    ⟨_, fun t => rfl⟩
  have hB : ∀ t, HasDerivAt rfpBmp (Bf t) t := by
    intro t
    rw [hBf]
    have u1 : HasDerivAt (fun x => 1 + x / (3 / 20)) (1 / (3 / 20)) t :=
      ((hasDerivAt_id' t).div_const (3 / 20)).const_add 1
    have u2 : HasDerivAt (fun x => 1 - x / (3 / 20)) (-(1 / (3 / 20))) t :=
      ((hasDerivAt_id' t).div_const (3 / 20)).const_sub 1
    have a1 := (hσd (1 + t / (3 / 20))).hasDerivAt.comp t u1
    have a2 := (hσd (1 - t / (3 / 20))).hasDerivAt.comp t u2
    exact a1.mul a2
  have Bbound : ∀ d1 d2 s1 s2 : ℝ, 0 ≤ d1 → d1 ≤ 200 → 0 ≤ d2 → d2 ≤ 200 → 0 ≤ s1 → s1 ≤ 1 →
      0 ≤ s2 → s2 ≤ 1 → |d1 * (1 / (3 / 20)) * s2 + s1 * (d2 * -(1 / (3 / 20)))| ≤ 4000 / 3 := by
    intro d1 d2 s1 s2 h1 h2 h3 h4 h5 h6 h7 h8
    have p : d1 * s2 ≤ 200 := by nlinarith
    have q : s1 * d2 ≤ 200 := by nlinarith
    have p0 : 0 ≤ d1 * s2 := mul_nonneg h1 h7
    have q0 : 0 ≤ s1 * d2 := mul_nonneg h5 h3
    have e : d1 * (1 / (3 / 20)) * s2 + s1 * (d2 * -(1 / (3 / 20))) =
        20 / 3 * (d1 * s2) - 20 / 3 * (s1 * d2) := by ring
    rw [e, abs_le]; constructor <;> linarith
  have hBb : ∀ t, |Bf t| ≤ 4000 / 3 := by
    intro t
    rw [hBf]
    exact Bbound _ _ _ _ (hσ'b _).1 (hσ'b _).2 (hσ'b _).1 (hσ'b _).2 (hs01 _).1 (hs01 _).2
      (hs01 _).1 (hs01 _).2
  have hB0 : ∀ t, 3 / 20 ≤ t → Bf t = 0 := by
    intro t ht
    have e : t / (3 / 20) = 20 / 3 * t := by ring
    have e1 : 1 ≤ 1 + t / (3 / 20) := by rw [e]; linarith
    have e2 : 1 - t / (3 / 20) ≤ 0 := by rw [e]; linarith
    rw [hBf, hσ'0 _ (Or.inr e1), hσ'0 _ (Or.inl e2)]
    ring

  have hPsi : HasDerivAt (rfpPsi P) (Bf (y - rfpY5 P.Md P.lam + 3) - rfpKa P * Bf (y - rfpY5 P.Md P.lam + 1)) y := by
    have b1 := (hB (y - rfpY5 P.Md P.lam + 3)).comp y
      (((hasDerivAt_id' y).sub_const (rfpY5 P.Md P.lam)).add_const 3)
    have b2 := (hB (y - rfpY5 P.Md P.lam + 1)).comp y
      (((hasDerivAt_id' y).sub_const (rfpY5 P.Md P.lam)).add_const 1)
    have b3 := b1.sub (b2.const_mul (rfpKa P))
    exact b3.congr_deriv (by ring)

  have hcd1 := sigA_contDiff_one
  obtain ⟨hBc, hB01, hBz, hBl⟩ := rfp_bump_facts hcd1
  have hwin := (rfp_lam_window hcd1 P hReg).2.1
  obtain ⟨hKa, -, -, -, -⟩ := rfp_psi_window P hReg hBc hB01 hBz hBl hwin
  have hKpos : 0 < rfpKa P := by rw [hKa]; exact Real.exp_pos _
  have hKle : rfpKa P ≤ 21 := by
    rw [hKa]
    have e1 : Real.exp 1 < 2.72 := lt_trans Real.exp_one_lt_d9 (by norm_num)
    have h0 := Real.exp_pos 1
    have e2 : Real.exp 1 * Real.exp 1 < 2.72 * 2.72 := mul_lt_mul'' e1 e1 h0.le h0.le
    have e3 : Real.exp 1 * Real.exp 1 * Real.exp 1 < 2.72 * 2.72 * 2.72 :=
      mul_lt_mul'' e2 e1 (by positivity) h0.le
    have e4 : Real.exp 3 = Real.exp 1 * Real.exp 1 * Real.exp 1 := by
      rw [← Real.exp_add, ← Real.exp_add]; norm_num
    have e5 : Real.exp (2 + 4 * P.lam) ≤ Real.exp 3 := Real.exp_le_exp.2 (by linarith)
    have : (2.72 : ℝ) * 2.72 * 2.72 ≤ 21 := by norm_num
    linarith
  obtain ⟨q, hq⟩ : ∃ q : ℝ, q = Bf (y - rfpY5 P.Md P.lam + 3) - rfpKa P * Bf (y - rfpY5 P.Md P.lam + 1) :=
    ⟨_, rfl⟩
  have hqb : |q| ≤ 30000 := by
    rw [hq]
    have h1 := abs_sub (Bf (y - rfpY5 P.Md P.lam + 3)) (rfpKa P * Bf (y - rfpY5 P.Md P.lam + 1))
    rw [abs_mul, abs_of_pos hKpos] at h1
    have h2 := mul_le_mul hKle (hBb (y - rfpY5 P.Md P.lam + 1)) (abs_nonneg _) (by norm_num)
    linarith [hBb (y - rfpY5 P.Md P.lam + 3)]

  obtain ⟨-, -, -, -, -, hca, -, -⟩ := hClos
  have hcaη := hca η (by linarith) (by linarith)
  have hc : |P.ca η| ≤ P.lam ^ 20 := by linarith [hcaη.1, abs_nonneg (deriv P.ca η)]
  have hcp := hcaη.2 y
  have hpos : 0 < 1 + P.ca η * rfpPsi P y := by linarith [(abs_le.1 hcp).1]
  have hf : (0:ℝ) < (1 + η ^ 2)⁻¹ := by positivity

  obtain ⟨R, hR⟩ : ∃ R : ℝ, R = P.ca η * q / (2 * (1 + P.ca η * rfpPsi P y)) := ⟨_, rfl⟩
  have hRb : |R| ≤ P.lam / 2 := by
    rw [hR]
    have hD : 1 ≤ 2 * (1 + P.ca η * rfpPsi P y) := by linarith [(abs_le.1 hcp).1]
    rw [abs_div, abs_of_pos (by linarith : (0:ℝ) < 2 * (1 + P.ca η * rfpPsi P y))]
    have h1 : |P.ca η * q| / (2 * (1 + P.ca η * rfpPsi P y)) ≤ |P.ca η * q| :=
      div_le_self (abs_nonneg _) hD
    have h2 : |P.ca η * q| ≤ P.lam ^ 20 * 30000 := by
      rw [abs_mul]; exact mul_le_mul hc hqb (abs_nonneg _) (by positivity)
    have h19 : P.lam ^ 19 ≤ (1 / 100 : ℝ) ^ 19 := pow_le_pow_left₀ hl0.le hl1 19
    have e : P.lam ^ 20 = P.lam * P.lam ^ 19 := by ring
    have h3 : P.lam ^ 20 * 30000 ≤ P.lam / 2 := by
      rw [e]
      have h4 := mul_le_mul_of_nonneg_left h19 hl0.le
      have h5 : (1 / 100 : ℝ) ^ 19 * 30000 ≤ 1 / 2 := by norm_num
      nlinarith
    linarith

  have hE1 := hLam.exp
  have hE2 := hTh.const_rpow hf
  have hE3 := ((hPsi.const_mul (P.ca η)).const_add 1).sqrt hpos.ne'
  have hEE := (hE1.mul hE2).mul hE3
  have hEE' : HasDerivAt (fun v => rfpE P v η) _ y := hEE
  have hSne : Real.sqrt (1 + P.ca η * rfpPsi P y) ≠ 0 := (Real.sqrt_pos.2 hpos).ne'
  have hSS : Real.sqrt (1 + P.ca η * rfpPsi P y) * Real.sqrt (1 + P.ca η * rfpPsi P y) =
      1 + P.ca η * rfpPsi P y := Real.mul_self_sqrt hpos.le
  have alg : ∀ eL F S L th l c qq p : ℝ, S ≠ 0 → S * S = 1 + c * p →
      (eL * L * F + eL * (l * th * F)) * S + eL * F * (c * qq / (2 * S)) =
      eL * F * S * (L + th * l + c * qq / (2 * (1 + c * p))) := by
    intro eL F S L th l c qq p hS h
    rw [← h]; field_simp; try ring
  have hDval := hEE'.deriv
  rw [Pi.mul_apply] at hDval
  rw [alg _ _ _ _ _ _ _ _ _ hSne hSS] at hDval
  have hEpos : 0 < rfpE P y η := by
    unfold rfpE
    exact mul_pos (mul_pos (Real.exp_pos _) (Real.rpow_pos_of_pos hf _)) (Real.sqrt_pos.2 hpos)
  have hEdef : rfpE P y η = Real.exp (rfpLam P y) * ((1 + η ^ 2)⁻¹) ^ (rfpTh P y) *
      Real.sqrt (1 + P.ca η * rfpPsi P y) := rfl

  have hsy : sigA y = 1 := hs1 y (by linarith)
  have hsy2 : sigA (y - rfpY2 P.Md) = 1 := hs1 _ (by linarith)
  obtain ⟨a, ha⟩ : ∃ a, a = sigA (y - rfpY5 P.Md P.lam) := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b, b = sigA (y - rfpY5 P.Md P.lam - 1 - P.T1) := ⟨_, rfl⟩
  obtain ⟨d, hd⟩ : ∃ d, d = deriv sigA ((y - rfpY4 P.Md P.lam) / 60) := ⟨_, rfl⟩
  obtain ⟨l, hl⟩ : ∃ l, l = Real.log ((1 + η ^ 2)⁻¹) := ⟨_, rfl⟩
  obtain ⟨G, hG, hDG⟩ : ∃ G, G = 1 / 10 - 3 / 5 - P.lam - (1 - P.lam) * a + (1 - P.h) * b
      - d * (Real.log 2 + l) / 60 + R ∧ deriv (fun v => rfpE P v η) y = rfpE P y η * G := by
    refine ⟨_, rfl, ?_⟩
    rw [hDval, hEdef, ha, hb, hd, hl, hR, hq, hsy, hsy2]
    ring

  have a0 : 0 ≤ a := by rw [ha]; exact (hs01 _).1
  have a1 : a ≤ 1 := by rw [ha]; exact (hs01 _).2
  have b0 : 0 ≤ b := by rw [hb]; exact (hs01 _).1
  have b1 : b ≤ 1 := by rw [hb]; exact (hs01 _).2
  have d0 : 0 ≤ d := by rw [hd]; exact (hσ'b _).1
  have d1 : d ≤ 200 := by rw [hd]; exact (hσ'b _).2
  have hlog2 : Real.log 2 < 0.6931471808 := Real.log_two_lt_d9
