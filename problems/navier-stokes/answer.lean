    rw [div_mul_cancel₀ _ hΛ0.ne'] at this; linarith
  have hXΛ' : X * Λ / 4 < Real.exp t1 := by
    have := mul_lt_mul_of_pos_right hX1 hΛ0
    have e : 4 / Λ * Real.exp t1 * Λ = 4 * Real.exp t1 := by field_simp
    linarith
  have hL0 : 0 < L := by rw [hLdef]; exact Real.log_pos hXΛ
  have hLt : L < t1 := by
    have := Real.log_lt_log (by linarith) hXΛ'
    rw [Real.log_exp] at this
    rw [hLdef]; exact this
  have hLX : 4 / Λ * Real.exp L = X := by
    rw [hLdef]; unfold axLogY; rw [Real.exp_log (by linarith)]; field_simp

  have hψs : ContDiffOn ℝ ∞ (fun Y => Un Y η) (Ioo (-1 / Λ) (5 / Λ)) :=
    hUs.comp (contDiffOn_id.prodMk contDiffOn_const) (fun _ hY => Set.mk_mem_prod hY hηρ)
  have hψd : ContinuousOn (deriv fun Y => Un Y η) (Ioo (-1 / Λ) (5 / Λ)) :=
    hψs.continuousOn_deriv_of_isOpen isOpen_Ioo (by simp)
  have hψh : ∀ x ∈ Ioo (-1 / Λ) (5 / Λ),
      HasDerivAt (fun Y => Un Y η) (deriv (fun Y => Un Y η) x) x :=
    fun x hx => ((hψs.differentiableOn (by simp)).differentiableAt (isOpen_Ioo.mem_nhds hx)).hasDerivAt
  have hXJ : X < 5 / Λ := by
    have h1 : 4 / Λ * Real.exp t1 < 4 / Λ * (41 / 40) := mul_lt_mul_of_pos_left hexp hX0
    have h2 : 4 / Λ * (41 / 40) = 41 / 10 * (1 / Λ) := by ring
    rw [e5]; linarith
  have hIccJ : Icc 0 X ⊆ Ioo (-1 / Λ) (5 / Λ) := by
    intro x hx
    exact ⟨by rw [em1]; linarith [hx.1], by linarith [hx.2]⟩
  have hdc : ContinuousOn (deriv fun Y => Un Y η) (Icc 0 X) := hψd.mono hIccJ
  have hgc : ContinuousOn (fun x => (1 - axEa Λ t1 κ0 x) * deriv (fun Y => Un Y η) x) (Icc 0 X) :=
    (continuous_const.sub hEc).continuousOn.mul hdc
  have hedc : ContinuousOn (fun x => axEa Λ t1 κ0 x * deriv (fun Y => Un Y η) x) (Icc 0 X) :=
    hEc.continuousOn.mul hdc
  have hsub : Icc (4 / Λ) X ⊆ Icc 0 X := Icc_subset_Icc_left hX0.le
  have hsub0 : Icc 0 (4 / Λ) ⊆ Icc 0 X := Icc_subset_Icc_right hXa.le
  have hu1 : Set.uIcc (4 / Λ) X = Icc (4 / Λ) X := Set.uIcc_of_le hXa.le
  have hu0 : Set.uIcc 0 (4 / Λ) = Icc 0 (4 / Λ) := Set.uIcc_of_le hX0.le
  have hdi : IntervalIntegrable (deriv fun Y => Un Y η) MeasureTheory.volume (4 / Λ) X := by
    apply ContinuousOn.intervalIntegrable; rw [hu1]; exact hdc.mono hsub
  have hedi : IntervalIntegrable (fun x => axEa Λ t1 κ0 x * deriv (fun Y => Un Y η) x)
      MeasureTheory.volume (4 / Λ) X := by
    apply ContinuousOn.intervalIntegrable; rw [hu1]; exact hedc.mono hsub
  have hedi0 : IntervalIntegrable (fun x => axEa Λ t1 κ0 x * deriv (fun Y => Un Y η) x)
      MeasureTheory.volume 0 (4 / Λ) := by
    apply ContinuousOn.intervalIntegrable; rw [hu0]; exact hedc.mono hsub0

  have hint : (∫ y in (0:ℝ)..L, axSlopeU h Λ t1 κ0 om Pax Fn Un y η) =
      ∫ y in (0:ℝ)..L, ((fun x => (1 - axEa Λ t1 κ0 x) * deriv (fun Y => Un Y η) x) ∘
        (fun y => 4 / Λ * Real.exp y)) y * (fun y => 4 / Λ * Real.exp y) y := by
    apply intervalIntegral.integral_congr
    intro y hy
    rw [Set.uIcc_of_le hL0.le] at hy
    simp only [Function.comp]
    rw [hwin y (by linarith [hy.2]) (by linarith [hy.2]), hkapE y hy.1]
    ring
  have himg : (fun y => 4 / Λ * Real.exp y) '' Set.uIcc 0 L ⊆ Icc 0 X := by
    rintro _ ⟨y, hy, rfl⟩
    rw [Set.uIcc_of_le hL0.le] at hy
    show 0 ≤ 4 / Λ * Real.exp y ∧ 4 / Λ * Real.exp y ≤ X
    refine ⟨(mul_pos hX0 (Real.exp_pos y)).le, ?_⟩
    rw [← hLX]
    exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hy.2) hX0.le
  have hcov := intervalIntegral.integral_comp_mul_deriv' (a := 0) (b := L)
    (f := fun y => 4 / Λ * Real.exp y) (f' := fun y => 4 / Λ * Real.exp y)
    (g := fun x => (1 - axEa Λ t1 κ0 x) * deriv (fun Y => Un Y η) x)
    (fun x _ => (Real.hasDerivAt_exp x).const_mul (4 / Λ))
    (continuous_const.mul Real.continuous_exp).continuousOn (hgc.mono himg)
  have hmain : (∫ y in (0:ℝ)..L, axSlopeU h Λ t1 κ0 om Pax Fn Un y η) =
      ∫ x in (4 / Λ)..X, (1 - axEa Λ t1 κ0 x) * deriv (fun Y => Un Y η) x := by
    rw [hint, hcov]
    simp only [Real.exp_zero, mul_one, hLX]

  have hsplit : (∫ x in (4 / Λ)..X, (1 - axEa Λ t1 κ0 x) * deriv (fun Y => Un Y η) x) =
      (∫ x in (4 / Λ)..X, deriv (fun Y => Un Y η) x) -
        ∫ x in (4 / Λ)..X, axEa Λ t1 κ0 x * deriv (fun Y => Un Y η) x := by
    rw [← intervalIntegral.integral_sub hdi hedi]
    congr 1; funext x; ring
  have hftc : (∫ x in (4 / Λ)..X, deriv (fun Y => Un Y η) x) = Un X η - Un (4 / Λ) η :=
    intervalIntegral.integral_eq_sub_of_hasDerivAt
      (fun x hx => by rw [hu1] at hx; exact hψh x (hIccJ (hsub hx))) hdi
  have hext : (∫ x in (0:ℝ)..X, axEa Λ t1 κ0 x * deriv (fun Y => Un Y η) x) =
      ∫ x in (4 / Λ)..X, axEa Λ t1 κ0 x * deriv (fun Y => Un Y η) x := by
    rw [← intervalIntegral.integral_add_adjacent_intervals hedi0 hedi]
    have heq : Set.EqOn (fun x => axEa Λ t1 κ0 x * deriv (fun Y => Un Y η) x) (fun _ => (0:ℝ))
        (Set.uIcc 0 (4 / Λ)) := by
      intro x hx
      rw [hu0] at hx
      simp only [hEa0 x hx.2, zero_mul]
    rw [intervalIntegral.integral_congr heq]
    simp
  rw [hmain, hsplit, hftc, hext]
  ring

theorem ax_axis_jets : ∀ (h j0 σ δ : ℝ) (Pax : ℝ → ℝ) (Λ C K ρ1 Xan : ℝ) (Kder : ℕ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 1 ≤ Λ → 0 < ρ1 → 0 ≤ Xan → Xan < 41 / (10 * Λ) → AxAxisOut h j0 σ δ Pax Λ C K ρ1 Kder Fn Un → ∃ ρ : ℝ, 0 < ρ ∧ AxHJet Xan ρ Fn ∧ AxHJet Xan ρ Un ∧ AxHJet Xan ρ (fun _ η => Pax η) ∧ (∀ η : ℝ, -1 < η → η < 1 → ∃ ε : ℝ, 0 < ε ∧ ∀ Y : ℝ, -ε < Y → Y < Xan + ε → 0 < Fn Y η) ∧ ContinuousOn (fun p : ℝ × ℝ => Fn p.1 p.2) (Icc 0 Xan ×ˢ Icc (-1) 1) ∧ (∀ X η : ℝ, 0 ≤ X → X ≤ Xan → -1 ≤ η → η ≤ 1 → 0 < Fn X η) ∧ ∃ Fc0 : ℝ → ℂ → ℂ, ContinuousOn (fun p : ℝ × ℂ => Fc0 p.1 p.2) (Icc 0 Xan ×ˢ axRect ρ) ∧ (∀ X : ℝ, 0 ≤ X → X ≤ Xan → DifferentiableOn ℂ (Fc0 X) (axRect ρ)) ∧ ∀ X η : ℝ, 0 ≤ X → X ≤ Xan → -1 < η → η < 1 → Fc0 X (η : ℂ) = ((Fn X η : ℝ) : ℂ) :=
by
  intro h j0 σ δ Pax Λ C K ρ1 Xan Kder Fn Un hΛ hρ1 hXan0 hXan41 hA
  obtain ⟨hFs, hUs, hpos, -, ⟨ρ, hρ, Fc, Uc, Pc, hjet⟩, -⟩ := hA
  have hΛ0 : 0 < Λ := by linarith
  have hX41 : 0 < 41 / (10 * Λ) := by positivity
  have hes : 0 < 9 / (10 * Λ) := by positivity
  have hc2 : -1 / Λ < -(9 / (10 * Λ)) := by
    rw [neg_div, neg_lt_neg_iff, div_lt_div_iff₀ (by positivity) hΛ0]
    nlinarith
  have hc3 : Xan + 9 / (10 * Λ) < 5 / Λ := by
    have e : 41 / (10 * Λ) + 9 / (10 * Λ) = 5 / Λ := by
      field_simp
      ring
    linarith
  have hc4 : -1 / Λ < 0 := by
    rw [neg_div]
    exact neg_neg_of_pos (by positivity)
  have hXX : Xan ≤ 41 / (10 * Λ) := hXan41.le
  have hSUB : Icc 0 Xan ×ˢ axRect ρ ⊆
      Icc 0 (41 / (10 * Λ)) ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} :=
    prod_mono (Icc_subset_Icc le_rfl hXX) subset_rfl
  have hSL : ∀ G : ℝ → ℝ → ℝ,
      ContDiffOn ℝ ∞ (↿G) (Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) →
      ∀ η : ℝ, -1 < η → η < 1 →
        ContDiffOn ℝ ∞ (fun Y => G Y η) (Ioo (-(9 / (10 * Λ))) (Xan + 9 / (10 * Λ))) := by
    intro G hG η h1 h2
    have hι : ContDiffOn ℝ ∞ (fun Y : ℝ => (Y, η)) (Ioo (-(9 / (10 * Λ))) (Xan + 9 / (10 * Λ))) :=
      (contDiff_id.prodMk contDiff_const).contDiffOn
    exact hG.comp hι (fun Y hY => ⟨⟨by linarith [hY.1], by linarith [hY.2]⟩, ⟨by linarith, by linarith⟩⟩)
  have jF : AxHJet Xan ρ Fn := by
    refine ⟨fun η h1 h2 => ⟨_, hes, hSL Fn hFs η h1 h2⟩, fun k => ?_⟩
    obtain ⟨Ck, hFc, -, -, hX⟩ := hjet k
    refine ⟨Fc k, Ck, hFc.mono hSUB, fun X hX0 hXa => ?_⟩
    obtain ⟨dF, -, -, hbd, hre⟩ := hX X hX0 (le_trans hXa hXX)
    exact ⟨dF, fun w hw => (hbd w hw.1 hw.2.1 hw.2.2).1, fun η h1 h2 => (hre η h1 h2).1⟩
  have jU : AxHJet Xan ρ Un := by
    refine ⟨fun η h1 h2 => ⟨_, hes, hSL Un hUs η h1 h2⟩, fun k => ?_⟩
    obtain ⟨Ck, -, hUc, -, hX⟩ := hjet k
    refine ⟨Uc k, Ck, hUc.mono hSUB, fun X hX0 hXa => ?_⟩
    obtain ⟨-, dU, -, hbd, hre⟩ := hX X hX0 (le_trans hXa hXX)
    exact ⟨dU, fun w hw => (hbd w hw.1 hw.2.1 hw.2.2).2.1, fun η h1 h2 => (hre η h1 h2).2.1⟩
  have jP : AxHJet Xan ρ (fun _ η => Pax η) := by
    refine ⟨fun η _ _ => ⟨1, one_pos, contDiffOn_const⟩, fun k => ?_⟩
    rcases k with _ | k
    · obtain ⟨C0, -, -, hPc0, hX0'⟩ := hjet 0
      obtain ⟨-, -, dP, hbd, hre⟩ := hX0' 0 le_rfl hX41.le
      refine ⟨fun _ w => Pc 0 0 w, C0, ?_, fun X _ _ =>
        ⟨dP, fun w hw => (hbd w hw.1 hw.2.1 hw.2.2).2.2, fun η h1 h2 => ?_⟩⟩
      · have hc : Continuous (fun p : ℝ × ℂ => ((0:ℝ), p.2)) := continuous_const.prodMk continuous_snd
        exact hPc0.comp hc.continuousOn (fun p hp => ⟨⟨le_rfl, hX41.le⟩, hp.2⟩)
      · have hr := (hre η h1 h2).2.2
        simp only [iteratedDeriv_zero, profRadInt, intervalIntegral.integral_same, add_zero] at hr ⊢
        exact hr
    · refine ⟨fun _ _ => 0, 0, continuousOn_const, fun X _ _ =>
        ⟨differentiableOn_const 0, fun w _ => by simp, fun η _ _ => by simp [iteratedDeriv_const]⟩⟩
  have G4 : ∀ η : ℝ, -1 < η → η < 1 → ∃ ε : ℝ, 0 < ε ∧
      ∀ Y : ℝ, -ε < Y → Y < Xan + ε → 0 < Fn Y η := by
    intro η h1 h2
    have hg0 : 0 < Fn 0 η := hpos 0 η le_rfl hX41.le (by linarith) (by linarith)
    have hgc : ContinuousAt (fun Y => Fn Y η) 0 :=
      (hSL Fn hFs η h1 h2).continuousOn.continuousAt (Ioo_mem_nhds (by linarith) (by linarith))
    have hev : ∀ᶠ Y in nhds (0:ℝ), 0 < Fn Y η := hgc.eventually (lt_mem_nhds hg0)
    obtain ⟨ε0, hε0, hball⟩ := Metric.eventually_nhds_iff.mp hev
    refine ⟨min ε0 (41 / (10 * Λ) - Xan), lt_min hε0 (by linarith), fun Y hY1 hY2 => ?_⟩
    have m1 := min_le_left ε0 (41 / (10 * Λ) - Xan)
    have m2 := min_le_right ε0 (41 / (10 * Λ) - Xan)
    rcases lt_or_ge Y 0 with hY | hY
    · apply hball
      rw [Real.dist_eq, sub_zero, abs_of_neg hY]
      linarith
    · exact hpos Y η hY (by linarith) (by linarith) (by linarith)
  have G5 : ContinuousOn (fun p : ℝ × ℝ => Fn p.1 p.2) (Icc 0 Xan ×ˢ Icc (-1) 1) :=
    hFs.continuousOn.mono (prod_mono (fun X hX => ⟨by linarith [hX.1], by linarith [hX.2]⟩)
      (fun η hη => ⟨by linarith [hη.1], by linarith [hη.2]⟩))
  have G6 : ∀ X η : ℝ, 0 ≤ X → X ≤ Xan → -1 ≤ η → η ≤ 1 → 0 < Fn X η :=
    fun X η a b c d => hpos X η a (le_trans b hXX) (by linarith) (by linarith)
  obtain ⟨C0, hFc0, -, -, hX0⟩ := hjet 0
  refine ⟨ρ, hρ, jF, jU, jP, G4, G5, G6, Fc 0, hFc0.mono hSUB,
    fun X a b => (hX0 X a (le_trans b hXX)).1, fun X η a b h1 h2 => ?_⟩
  have hr := ((hX0 X a (le_trans b hXX)).2.2.2.2 η h1 h2).1
  rw [hr, iteratedDeriv_zero]

theorem ax_strip_nonvanish : ∀ (f : ℝ → ℂ → ℂ) (φ : ℝ → ℝ → ℝ) (a b ρ : ℝ), a ≤ b → 0 < ρ → ContinuousOn (fun p : ℝ × ℂ => f p.1 p.2) (Icc a b ×ˢ axRect ρ) → ContinuousOn (fun p : ℝ × ℝ => φ p.1 p.2) (Icc a b ×ˢ Icc (-1) 1) → (∀ X η : ℝ, a ≤ X → X ≤ b → -1 ≤ η → η ≤ 1 → 0 < φ X η) → (∀ X η : ℝ, a ≤ X → X ≤ b → -1 < η → η < 1 → f X (η : ℂ) = ((φ X η : ℝ) : ℂ)) → ∃ ρ' m : ℝ, 0 < ρ' ∧ ρ' ≤ ρ ∧ 0 < m ∧ ∀ X w, a ≤ X → X ≤ b → w ∈ axRect ρ' → m ≤ ‖f X w‖ :=
by
  intro f φ a b ρ hab hρ hf hφc hpos hagree

  have hK : IsCompact (Icc a b ×ˢ Icc (-1:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
  have hKne : (Icc a b ×ˢ Icc (-1:ℝ) 1).Nonempty :=
    ⟨(a, 0), ⟨le_refl a, hab⟩, by norm_num, by norm_num⟩
  obtain ⟨p0, hp0, hmin⟩ := hK.exists_isMinOn hKne hφc
  rw [isMinOn_iff] at hmin
  obtain ⟨m0, hm0⟩ : ∃ m0 : ℝ, m0 = φ p0.1 p0.2 := ⟨_, rfl⟩
  have hm0pos : 0 < m0 := by
    rw [hm0]; exact hpos p0.1 p0.2 hp0.1.1 hp0.1.2 hp0.2.1 hp0.2.2
  have hmin' : ∀ X η : ℝ, a ≤ X → X ≤ b → -1 ≤ η → η ≤ 1 → m0 ≤ φ X η :=
    fun X η h1 h2 h3 h4 => by rw [hm0]; exact hmin (X, η) ⟨⟨h1, h2⟩, h3, h4⟩

  obtain ⟨Kc, hKc⟩ : ∃ Kc : Set (ℝ × ℂ), Kc = Icc a b ×ˢ
      Complex.reProdIm (Icc (-1 - ρ / 2) (1 + ρ / 2)) (Icc (-(ρ / 2)) (ρ / 2)) := ⟨_, rfl⟩
  have hKcc : IsCompact Kc := by
    rw [hKc]; exact isCompact_Icc.prod (isCompact_Icc.reProdIm isCompact_Icc)
  have hsub : Kc ⊆ Icc a b ×ˢ axRect ρ := by
    rw [hKc]
    rintro ⟨X, w⟩ ⟨hX, hw⟩
    refine ⟨hX, ?_⟩
    rw [Complex.mem_reProdIm] at hw
    obtain ⟨⟨h1, h2⟩, h3, h4⟩ := hw
    simp only [axRect, Set.mem_setOf_eq]
    exact ⟨abs_lt.mpr ⟨by linarith, by linarith⟩, by linarith, by linarith⟩

  have huc := hKcc.uniformContinuousOn_of_continuous (hf.mono hsub)
  rw [Metric.uniformContinuousOn_iff] at huc
  obtain ⟨δ, hδ, hδb⟩ := huc (m0 / 2) (by linarith)

  have hr0 : 0 < min (ρ / 2) (min (1 / 2) (δ / 3)) :=
    lt_min (by linarith) (lt_min (by norm_num) (by linarith))
  have hr1 : min (ρ / 2) (min (1 / 2) (δ / 3)) ≤ ρ / 2 := min_le_left _ _
  have hr2 : min (ρ / 2) (min (1 / 2) (δ / 3)) ≤ 1 / 2 :=
    le_trans (min_le_right _ _) (min_le_left _ _)
  have hr3 : min (ρ / 2) (min (1 / 2) (δ / 3)) ≤ δ / 3 :=
    le_trans (min_le_right _ _) (min_le_right _ _)
  refine ⟨min (ρ / 2) (min (1 / 2) (δ / 3)), m0 / 2, hr0, by linarith, by linarith, ?_⟩
  intro X w hXa hXb hw
  obtain ⟨r, hr⟩ : ∃ r : ℝ, r = min (ρ / 2) (min (1 / 2) (δ / 3)) := ⟨_, rfl⟩
  rw [← hr] at hr0 hr1 hr2 hr3 hw

  simp only [axRect, Set.mem_setOf_eq] at hw
  obtain ⟨hwi, hwr1, hwr2⟩ := hw
  obtain ⟨hwi1, hwi2⟩ := abs_lt.mp hwi
  obtain ⟨η, hη⟩ : ∃ η : ℝ, η = max (-1 + r) (min (1 - r) w.re) := ⟨_, rfl⟩
  have hη1 : -1 + r ≤ η := by rw [hη]; exact le_max_left _ _
  have hη2 : η ≤ 1 - r := by rw [hη]; exact max_le (by linarith) (min_le_left _ _)
  have hηd : |w.re - η| < 2 * r := by
    rw [abs_sub_lt_iff]
    rcases le_total w.re (1 - r) with h | h
    · rw [min_eq_right h] at hη
      rcases le_total (-1 + r) w.re with h' | h'
      · rw [max_eq_right h'] at hη; constructor <;> linarith
      · rw [max_eq_left h'] at hη; constructor <;> linarith
    · rw [min_eq_left h, max_eq_right (by linarith)] at hη; constructor <;> linarith
  have hnorm : ‖w - (η : ℂ)‖ < δ := by
    have := Complex.norm_le_abs_re_add_abs_im (w - (η : ℂ))
    rw [Complex.sub_re, Complex.sub_im, Complex.ofReal_re, Complex.ofReal_im, sub_zero] at this
    linarith

  have hp : ((X, w) : ℝ × ℂ) ∈ Kc := by
    rw [hKc]
    refine ⟨⟨hXa, hXb⟩, ?_⟩
    rw [Complex.mem_reProdIm]
    exact ⟨⟨by linarith, by linarith⟩, by linarith, by linarith⟩
  have hq : ((X, (η : ℂ)) : ℝ × ℂ) ∈ Kc := by
    rw [hKc]
    refine ⟨⟨hXa, hXb⟩, ?_⟩
    rw [Complex.mem_reProdIm, Complex.ofReal_re, Complex.ofReal_im]
    exact ⟨⟨by linarith, by linarith⟩, by linarith, by linarith⟩
  have hdist : dist ((X, w) : ℝ × ℂ) (X, (η : ℂ)) < δ := by
    rw [Prod.dist_eq, dist_self, Complex.dist_eq]
    exact max_lt hδ hnorm

  have hfd := hδb _ hp _ hq hdist
  simp only at hfd
  rw [Complex.dist_eq] at hfd
  have hag := hagree X η hXa hXb (by linarith) (by linarith)
  have hφη := hmin' X η hXa hXb (by linarith) (by linarith)
  have hφpos := hpos X η hXa hXb (by linarith) (by linarith)
  have hnq : ‖f X (η : ℂ)‖ = φ X η := by
    rw [hag, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hφpos]
  have htri := norm_sub_norm_le (f X (η : ℂ)) (f X w)
  rw [norm_sub_rev] at htri
  linarith

theorem axhjet_mul : ∀ (Xan ρ : ℝ) (φ ψ : ℝ → ℝ → ℝ), 0 ≤ Xan → AxHJet Xan ρ φ → AxHJet Xan ρ ψ → AxHJet Xan ρ (fun X η => φ X η * ψ X η) :=
by
  intro Xan ρ φ ψ _ hφ hψ
  unfold AxHJet AxHJetK at *
  obtain ⟨hs1, hj1⟩ := hφ
  obtain ⟨hs2, hj2⟩ := hψ
  choose Φ C1 hc1 hX1 using hj1
  choose Ψ C2 hc2 hX2 using hj2
  refine ⟨fun η h1 h2 => ?_, fun k => ?_⟩
  · obtain ⟨e1, he1, s1⟩ := hs1 η h1 h2
    obtain ⟨e2, he2, s2⟩ := hs2 η h1 h2
    refine ⟨min e1 e2, lt_min he1 he2, ?_⟩
    exact (s1.mono (fun x hx => ⟨by linarith [hx.1, min_le_left e1 e2],
        by linarith [hx.2, min_le_left e1 e2]⟩)).mul
      (s2.mono (fun x hx => ⟨by linarith [hx.1, min_le_right e1 e2],
        by linarith [hx.2, min_le_right e1 e2]⟩))
  · refine ⟨fun X w => ∑ i ∈ Finset.range (k + 1),
        ((k.choose i : ℕ) : ℂ) * Φ i X w * Ψ (k - i) X w,
      ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |C1 i| * |C2 (k - i)|, ?_,
      fun X hXa hXb => ⟨?_, fun w hw => ?_, fun η h1 h2 => ?_⟩⟩
    · apply continuousOn_finset_sum
      intro i _
      exact (continuousOn_const.mul (hc1 i)).mul (hc2 (k - i))
    · apply DifferentiableOn.fun_sum
      intro i _
      exact ((differentiableOn_const _).mul (hX1 i X hXa hXb).1).mul (hX2 (k - i) X hXa hXb).1
    · refine (norm_sum_le _ _).trans (Finset.sum_le_sum (fun i _ => ?_))
      rw [norm_mul, norm_mul, Complex.norm_natCast]
      have b1 : ‖Φ i X w‖ ≤ |C1 i| := ((hX1 i X hXa hXb).2.1 w hw).trans (le_abs_self _)
      have b2 : ‖Ψ (k - i) X w‖ ≤ |C2 (k - i)| :=
        ((hX2 (k - i) X hXa hXb).2.1 w hw).trans (le_abs_self _)
      have c0 : (0 : ℝ) ≤ (k.choose i : ℝ) := Nat.cast_nonneg _
      exact mul_le_mul (mul_le_mul_of_nonneg_left b1 c0) b2 (norm_nonneg _)
        (mul_nonneg c0 (abs_nonneg _))
    · obtain ⟨e1, he1, s1⟩ := hs1 η h1 h2
      obtain ⟨e2, he2, s2⟩ := hs2 η h1 h2
      have ca : ContDiffAt ℝ k (fun Y => φ Y η) X :=
        contDiffAt_infty.mp (s1.contDiffAt (Ioo_mem_nhds (by linarith) (by linarith))) k
      have cb : ContDiffAt ℝ k (fun Y => ψ Y η) X :=
        contDiffAt_infty.mp (s2.contDiffAt (Ioo_mem_nhds (by linarith) (by linarith))) k
      show ∑ i ∈ Finset.range (k + 1), ((k.choose i : ℕ) : ℂ) * Φ i X (η : ℂ) * Ψ (k - i) X (η : ℂ)
        = ((iteratedDeriv k (fun Y => φ Y η * ψ Y η) X : ℝ) : ℂ)
      rw [iteratedDeriv_fun_mul ca cb]
      push_cast
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [(hX1 i X hXa hXb).2.2 η h1 h2, (hX2 (k - i) X hXa hXb).2.2 η h1 h2]

theorem axhjet_exp : ∀ (Xan ρ : ℝ) (φ : ℝ → ℝ → ℝ), 0 ≤ Xan → AxHJet Xan ρ φ → AxHJet Xan ρ (fun X η => Real.exp (φ X η)) :=
by
  intro Xan ρ φ _ hφ
  unfold AxHJet at hφ ⊢
  obtain ⟨hs, hj⟩ := hφ
  unfold AxHJetK at hj
  choose Φ C hc hX using hj

  have key : ∀ (X η : ℝ), 0 ≤ X → X ≤ Xan → -1 < η → η < 1 → ∀ n : ℕ,
      iteratedDeriv (n + 1) (fun Y => Real.exp (φ Y η)) X =
        ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * iteratedDeriv (i + 1) (fun Y => φ Y η) X *
          iteratedDeriv (n - i) (fun Y => Real.exp (φ Y η)) X := by
    intro X η hXa hXb h1 h2 n
    obtain ⟨ε, hε, s⟩ := hs η h1 h2
    have hI : Ioo (-ε) (Xan + ε) ∈ nhds X := Ioo_mem_nhds (by linarith) (by linarith)
    have hb : ContDiffOn ℝ ∞ (deriv (fun Y => φ Y η)) (Ioo (-ε) (Xan + ε)) :=
      ((contDiffOn_infty_iff_deriv_of_isOpen isOpen_Ioo).mp s).2
    have hd : deriv (fun Y => Real.exp (φ Y η)) =ᶠ[nhds X]
        fun Y => deriv (fun Y => φ Y η) Y * Real.exp (φ Y η) := by
      filter_upwards [hI] with Y hY
      have hdiff : DifferentiableAt ℝ (fun Y => φ Y η) Y :=
        (s.differentiableOn (by simp)).differentiableAt (isOpen_Ioo.mem_nhds hY)
      exact (hdiff.hasDerivAt.exp).deriv.trans (mul_comm _ _)
    have e1 : ContDiffAt ℝ n (deriv (fun Y => φ Y η)) X :=
      contDiffAt_infty.mp (hb.contDiffAt hI) n
    have e2 : ContDiffAt ℝ n (fun Y => Real.exp (φ Y η)) X :=
      contDiffAt_infty.mp (s.exp.contDiffAt hI) n
    rw [iteratedDeriv_succ' (n := n), hd.iteratedDeriv_eq n, iteratedDeriv_fun_mul e1 e2]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [iteratedDeriv_succ' (n := i)]
  refine ⟨fun η h1 h2 => ?_, fun k => ?_⟩
  · obtain ⟨ε, hε, s⟩ := hs η h1 h2
    exact ⟨ε, hε, s.exp⟩
  induction k using Nat.strong_induction_on with
  | _ k IH =>
    rcases k with _ | n
    · unfold AxHJetK
      refine ⟨fun X w => Complex.exp (Φ 0 X w), Real.exp (C 0), (hc 0).cexp,
        fun X hXa hXb => ⟨(hX 0 X hXa hXb).1.cexp, fun w hw => ?_, fun η h1 h2 => ?_⟩⟩
      · exact (Complex.norm_exp_le_exp_norm _).trans
          (Real.exp_le_exp.mpr ((hX 0 X hXa hXb).2.1 w hw))
      · show Complex.exp (Φ 0 X η) = ((iteratedDeriv 0 (fun Y => Real.exp (φ Y η)) X : ℝ) : ℂ)
        rw [(hX 0 X hXa hXb).2.2 η h1 h2, iteratedDeriv_zero, iteratedDeriv_zero,
          Complex.ofReal_exp]
    · have IH' : ∀ m : ℕ, m < n + 1 → AxHJetK Xan ρ (fun X η => Real.exp (φ X η)) m := IH
      unfold AxHJetK at IH'
      choose E B hEc hEX using IH'
      have hm : ∀ i : ℕ, n - i < n + 1 := fun i => Nat.lt_succ_of_le (Nat.sub_le n i)
      unfold AxHJetK
      refine ⟨fun X w => ∑ i ∈ Finset.range (n + 1),
          ((n.choose i : ℕ) : ℂ) * Φ (i + 1) X w * E (n - i) (hm i) X w,
        ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * |C (i + 1)| * |B (n - i) (hm i)|, ?_,
        fun X hXa hXb => ⟨?_, fun w hw => ?_, fun η h1 h2 => ?_⟩⟩
      · show ContinuousOn (fun p : ℝ × ℂ => ∑ i ∈ Finset.range (n + 1),
          ((n.choose i : ℕ) : ℂ) * Φ (i + 1) p.1 p.2 * E (n - i) (hm i) p.1 p.2) _
        refine continuousOn_finsetSum _ (fun i _ => ?_)
        exact (continuousOn_const.mul (hc (i + 1))).mul (hEc (n - i) (hm i))
      · show DifferentiableOn ℂ (fun w => ∑ i ∈ Finset.range (n + 1),
          ((n.choose i : ℕ) : ℂ) * Φ (i + 1) X w * E (n - i) (hm i) X w) _
        refine DifferentiableOn.fun_sum (fun i _ => ?_)
        exact ((differentiableOn_const _).mul (hX (i + 1) X hXa hXb).1).mul
          (hEX (n - i) (hm i) X hXa hXb).1
      · show ‖∑ i ∈ Finset.range (n + 1),
          ((n.choose i : ℕ) : ℂ) * Φ (i + 1) X w * E (n - i) (hm i) X w‖ ≤ _
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum (fun i _ => ?_))
        rw [norm_mul, norm_mul, Complex.norm_natCast]
        have a1 := ((hX (i + 1) X hXa hXb).2.1 w hw).trans (le_abs_self _)
        have a2 := ((hEX (n - i) (hm i) X hXa hXb).2.1 w hw).trans (le_abs_self _)
        exact mul_le_mul (mul_le_mul_of_nonneg_left a1 (Nat.cast_nonneg _)) a2 (norm_nonneg _)
          (mul_nonneg (Nat.cast_nonneg _) (abs_nonneg _))
      · show (∑ i ∈ Finset.range (n + 1),
          ((n.choose i : ℕ) : ℂ) * Φ (i + 1) X η * E (n - i) (hm i) X η) = _
        rw [key X η hXa hXb h1 h2 n]
        push_cast
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [(hX (i + 1) X hXa hXb).2.2 η h1 h2, (hEX (n - i) (hm i) X hXa hXb).2.2 η h1 h2]

theorem axhjet_inv : ∀ (Xan ρ m : ℝ) (φ : ℝ → ℝ → ℝ) (Φ0 : ℝ → ℂ → ℂ), 0 ≤ Xan → 0 < m → AxHJet Xan ρ φ → (∀ η : ℝ, -1 < η → η < 1 → ∃ ε : ℝ, 0 < ε ∧ ∀ Y : ℝ, -ε < Y → Y < Xan + ε → φ Y η ≠ 0) → ContinuousOn (fun p : ℝ × ℂ => Φ0 p.1 p.2) (Icc 0 Xan ×ˢ axRect ρ) → (∀ X : ℝ, 0 ≤ X → X ≤ Xan → DifferentiableOn ℂ (Φ0 X) (axRect ρ) ∧ ∀ w ∈ axRect ρ, m ≤ ‖Φ0 X w‖) → (∀ X η : ℝ, 0 ≤ X → X ≤ Xan → -1 < η → η < 1 → Φ0 X (η : ℂ) = ((φ X η : ℝ) : ℂ)) → AxHJet Xan ρ (fun X η => (φ X η)⁻¹) :=
by
  intro Xan ρ m φ Φ0 _ hm hφ hnz hΦ0c hΦ0 hΦ0r
  unfold AxHJet at hφ ⊢
  obtain ⟨hs, hj⟩ := hφ
  unfold AxHJetK at hj
  choose Φ C hc hX using hj

  have hloc : ∀ η : ℝ, -1 < η → η < 1 → ∃ e : ℝ, 0 < e ∧
      ContDiffOn ℝ ∞ (fun Y => φ Y η) (Ioo (-e) (Xan + e)) ∧
      ∀ Y ∈ Ioo (-e) (Xan + e), φ Y η ≠ 0 := by
    intro η h1 h2
    obtain ⟨e1, he1, s1⟩ := hs η h1 h2
    obtain ⟨e2, he2, n2⟩ := hnz η h1 h2
    refine ⟨min e1 e2, lt_min he1 he2, s1.mono (fun x hx => ⟨by linarith [hx.1, min_le_left e1 e2],
      by linarith [hx.2, min_le_left e1 e2]⟩), fun Y hY => n2 Y
      (by linarith [hY.1, min_le_right e1 e2]) (by linarith [hY.2, min_le_right e1 e2])⟩

  have hrec : ∀ (η X : ℝ) (n : ℕ), -1 < η → η < 1 → 0 ≤ X → X ≤ Xan →
      iteratedDeriv (n + 1) (fun Y => (φ Y η)⁻¹) X =
        -(φ X η)⁻¹ * ∑ i ∈ Finset.range (n + 1), ((n + 1).choose (i + 1) : ℝ) *
          iteratedDeriv (i + 1) (fun Y => φ Y η) X * iteratedDeriv (n - i) (fun Y => (φ Y η)⁻¹) X := by
    intro η X n h1 h2 hX0 hX1
    obtain ⟨e, he, sU, nU⟩ := hloc η h1 h2
    have hXU : Ioo (-e) (Xan + e) ∈ nhds X := Ioo_mem_nhds (by linarith) (by linarith)
    have sg : ContDiffOn ℝ ∞ (fun Y => (φ Y η)⁻¹) (Ioo (-e) (Xan + e)) := sU.inv nU
    have cf : ContDiffAt ℝ ((n + 1 : ℕ) : ℕ∞) (fun Y => φ Y η) X :=
      contDiffAt_infty.mp (sU.contDiffAt hXU) (n + 1)
    have cg : ContDiffAt ℝ ((n + 1 : ℕ) : ℕ∞) (fun Y => (φ Y η)⁻¹) X :=
      contDiffAt_infty.mp (sg.contDiffAt hXU) (n + 1)
    have hev : (fun Y => φ Y η * (φ Y η)⁻¹) =ᶠ[nhds X] (fun _ => (1:ℝ)) :=
      Filter.eventuallyEq_of_mem hXU (fun Y hY => mul_inv_cancel₀ (nU Y hY))
    have h0 : iteratedDeriv (n + 1) (fun Y => φ Y η * (φ Y η)⁻¹) X = 0 := by
      rw [hev.iteratedDeriv_eq, iteratedDeriv_const]; simp
    rw [iteratedDeriv_fun_mul cf cg, Finset.sum_range_succ'] at h0
    simp only [Nat.choose_zero_right, iteratedDeriv_zero, Nat.cast_one, one_mul, Nat.sub_zero,
      Nat.add_sub_add_right] at h0
    have hne : φ X η ≠ 0 := nU X ⟨by linarith, by linarith⟩
    have key : φ X η * iteratedDeriv (n + 1) (fun Y => (φ Y η)⁻¹) X =
        -∑ i ∈ Finset.range (n + 1), ((n + 1).choose (i + 1) : ℝ) *
          iteratedDeriv (i + 1) (fun Y => φ Y η) X * iteratedDeriv (n - i) (fun Y => (φ Y η)⁻¹) X := by
      linarith
    calc iteratedDeriv (n + 1) (fun Y => (φ Y η)⁻¹) X
        = (φ X η)⁻¹ * (φ X η * iteratedDeriv (n + 1) (fun Y => (φ Y η)⁻¹) X) := by
          rw [← mul_assoc, inv_mul_cancel₀ hne, one_mul]
      _ = _ := by rw [key]; ring
  refine ⟨fun η h1 h2 => ?_, fun k => ?_⟩
  · obtain ⟨e, he, sU, nU⟩ := hloc η h1 h2
    exact ⟨e, he, sU.inv nU⟩
  · induction k using Nat.strong_induction_on with
    | _ k ih =>
    rcases k with _ | n
    · unfold AxHJetK
      have hnz0 : ∀ X, 0 ≤ X → X ≤ Xan → ∀ w ∈ axRect ρ, Φ0 X w ≠ 0 := fun X a b w hw =>
        norm_pos_iff.mp (lt_of_lt_of_le hm ((hΦ0 X a b).2 w hw))
      refine ⟨fun X w => (Φ0 X w)⁻¹, m⁻¹, ?_, fun X a b => ⟨?_, fun w hw => ?_, fun η h1 h2 => ?_⟩⟩
      · exact hΦ0c.inv₀ (fun p hp => hnz0 p.1 hp.1.1 hp.1.2 p.2 hp.2)
      · exact (hΦ0 X a b).1.inv (fun w hw => hnz0 X a b w hw)
      · show ‖(Φ0 X w)⁻¹‖ ≤ m⁻¹
        rw [norm_inv]; exact inv_anti₀ hm ((hΦ0 X a b).2 w hw)
      · show (Φ0 X (η : ℂ))⁻¹ = ((iteratedDeriv 0 (fun Y => (φ Y η)⁻¹) X : ℝ) : ℂ)
        rw [iteratedDeriv_zero, hΦ0r X η a b h1 h2, Complex.ofReal_inv]
    · have ih' : ∀ j : ℕ, AxHJetK Xan ρ (fun X η => (φ X η)⁻¹) (min j n) :=
        fun j => ih _ (by omega)
      unfold AxHJetK at ih' ⊢
      choose W B hWc hWX using ih'
      have hmin : ∀ i ∈ Finset.range (n + 1), min (n - i) n = n - i := fun i _ => by omega
      refine ⟨fun X w => -(W 0 X w) * ∑ i ∈ Finset.range (n + 1),
          (((n + 1).choose (i + 1) : ℕ) : ℂ) * Φ (i + 1) X w * W (n - i) X w,
        |B 0| * ∑ i ∈ Finset.range (n + 1), ((n + 1).choose (i + 1) : ℝ) * |C (i + 1)| * |B (n - i)|,
        ?_, fun X a b => ⟨?_, fun w hw => ?_, fun η h1 h2 => ?_⟩⟩
      · apply ContinuousOn.mul (hWc 0).neg
        apply continuousOn_finset_sum
        intro i _
        exact (continuousOn_const.mul (hc (i + 1))).mul (hWc (n - i))
      · apply DifferentiableOn.mul (hWX 0 X a b).1.neg
        apply DifferentiableOn.fun_sum
        intro i _
        exact ((differentiableOn_const _).mul (hX (i + 1) X a b).1).mul (hWX (n - i) X a b).1
      · show ‖-(W 0 X w) * ∑ i ∈ Finset.range (n + 1),
          (((n + 1).choose (i + 1) : ℕ) : ℂ) * Φ (i + 1) X w * W (n - i) X w‖ ≤ _
        rw [norm_mul, norm_neg]
        have b0 : ‖W 0 X w‖ ≤ |B 0| := ((hWX 0 X a b).2.1 w hw).trans (le_abs_self _)
        have bs : ‖∑ i ∈ Finset.range (n + 1),
            (((n + 1).choose (i + 1) : ℕ) : ℂ) * Φ (i + 1) X w * W (n - i) X w‖ ≤
            ∑ i ∈ Finset.range (n + 1), ((n + 1).choose (i + 1) : ℝ) * |C (i + 1)| * |B (n - i)| := by
          refine (norm_sum_le _ _).trans (Finset.sum_le_sum (fun i _ => ?_))
          rw [norm_mul, norm_mul, Complex.norm_natCast]
          have b1 : ‖Φ (i + 1) X w‖ ≤ |C (i + 1)| :=
            ((hX (i + 1) X a b).2.1 w hw).trans (le_abs_self _)
          have b2 : ‖W (n - i) X w‖ ≤ |B (n - i)| :=
            ((hWX (n - i) X a b).2.1 w hw).trans (le_abs_self _)
          have c0 : (0 : ℝ) ≤ ((n + 1).choose (i + 1) : ℝ) := Nat.cast_nonneg _
          exact mul_le_mul (mul_le_mul_of_nonneg_left b1 c0) b2 (norm_nonneg _)
            (mul_nonneg c0 (abs_nonneg _))
        exact mul_le_mul b0 bs (norm_nonneg _) (abs_nonneg _)
      · have hW0 : W 0 X (η : ℂ) = (((φ X η)⁻¹ : ℝ) : ℂ) := by
          have := (hWX 0 X a b).2.2 η h1 h2
          rw [show min 0 n = 0 from Nat.zero_min n, iteratedDeriv_zero] at this
          exact this
        have e1 : ∀ i ∈ Finset.range (n + 1),
            (((n + 1).choose (i + 1) : ℕ) : ℂ) * Φ (i + 1) X (η : ℂ) * W (n - i) X (η : ℂ) =
            ((((n + 1).choose (i + 1) : ℝ) * iteratedDeriv (i + 1) (fun Y => φ Y η) X *
              iteratedDeriv (n - i) (fun Y => (φ Y η)⁻¹) X : ℝ) : ℂ) := by
          intro i hi
          have hw := (hWX (n - i) X a b).2.2 η h1 h2
          rw [hmin i hi] at hw
          rw [(hX (i + 1) X a b).2.2 η h1 h2, hw]
          push_cast
          ring
        show -(W 0 X (η : ℂ)) * ∑ i ∈ Finset.range (n + 1),
            (((n + 1).choose (i + 1) : ℕ) : ℂ) * Φ (i + 1) X (η : ℂ) * W (n - i) X (η : ℂ) =
            ((iteratedDeriv (n + 1) (fun Y => (φ Y η)⁻¹) X : ℝ) : ℂ)
        rw [Finset.sum_congr rfl e1, hW0, hrec η X n h1 h2 a b]
        push_cast
        ring

theorem axhjet_integral : ∀ (Xan ρ : ℝ) (φ : ℝ → ℝ → ℝ), 0 ≤ Xan → 0 < ρ → AxHJet Xan ρ φ → AxHJet Xan ρ (fun X η => ∫ s in (0:ℝ)..X, φ s η) :=
by
  intro Xan ρ φ hXan _hρ hφ
  have hSo : IsOpen (axRect ρ) := by
    unfold axRect
    exact (isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).inter
      ((isOpen_lt continuous_const Complex.continuous_re).inter
        (isOpen_lt Complex.continuous_re continuous_const))

  have hprim : ∀ (f : ℝ → ℝ) (a c : ℝ), a < 0 → 0 < c → ContDiffOn ℝ ∞ f (Ioo a c) →
      ContDiffOn ℝ ∞ (fun Y => ∫ s in (0:ℝ)..Y, f s) (Ioo a c) ∧
      ∀ Y ∈ Ioo a c, deriv (fun Y => ∫ s in (0:ℝ)..Y, f s) Y = f Y := by
    intro f a c ha hc hf
    have hcont : ContinuousOn f (Ioo a c) := hf.continuousOn
    have h0 : (0:ℝ) ∈ Ioo a c := ⟨ha, hc⟩
    have hD : ∀ Y ∈ Ioo a c, HasDerivAt (fun Y => ∫ s in (0:ℝ)..Y, f s) (f Y) Y := by
      intro Y hY
      have hsub : uIcc 0 Y ⊆ Ioo a c := Set.OrdConnected.uIcc_subset ordConnected_Ioo h0 hY
      exact intervalIntegral.integral_hasDerivAt_right ((hcont.mono hsub).intervalIntegrable)
        (ContinuousOn.stronglyMeasurableAtFilter isOpen_Ioo hcont Y hY)
        (hcont.continuousAt (Ioo_mem_nhds hY.1 hY.2))
    have hE : ∀ Y ∈ Ioo a c, deriv (fun Y => ∫ s in (0:ℝ)..Y, f s) Y = f Y :=
      fun Y hY => (hD Y hY).deriv
    exact ⟨(contDiffOn_infty_iff_deriv_of_isOpen isOpen_Ioo).mpr
      ⟨fun Y hY => (hD Y hY).differentiableAt.differentiableWithinAt, hf.congr hE⟩, hE⟩
  unfold AxHJet AxHJetK at *
  obtain ⟨hs, hj⟩ := hφ
  refine ⟨fun η h1 h2 => ?_, fun k => ?_⟩
  · obtain ⟨ε, hε, hsm⟩ := hs η h1 h2
    exact ⟨ε, hε, (hprim (fun Y => φ Y η) (-ε) (Xan + ε) (by linarith) (by linarith) hsm).1⟩
  cases k with
  | succ k =>
    obtain ⟨Φ, C, hc, hX⟩ := hj k
    refine ⟨Φ, C, hc, fun X hXa hXb => ?_⟩
    obtain ⟨d, b, r⟩ := hX X hXa hXb
    refine ⟨d, b, fun η h1 h2 => ?_⟩
    obtain ⟨ε, hε, hsm⟩ := hs η h1 h2
    have hder := (hprim (fun Y => φ Y η) (-ε) (Xan + ε) (by linarith) (by linarith) hsm).2
    have hev : deriv (fun Y => ∫ s in (0:ℝ)..Y, φ s η) =ᶠ[nhds X] (fun Y => φ Y η) :=
      Filter.eventuallyEq_of_mem
        (Ioo_mem_nhds (show -ε < X by linarith) (show X < Xan + ε by linarith)) hder
    rw [r η h1 h2]
    show ((iteratedDeriv k (fun Y => φ Y η) X : ℝ) : ℂ) =
      ((iteratedDeriv (k + 1) (fun Y => ∫ s in (0:ℝ)..Y, φ s η) X : ℝ) : ℂ)
    rw [iteratedDeriv_succ', hev.iteratedDeriv_eq k]
  | zero =>
    obtain ⟨Φ, C, hc, hX⟩ := hj 0
    have hsl : ∀ w ∈ axRect ρ, ContinuousOn (fun s => Φ s w) (Icc 0 Xan) := fun w hw =>
      hc.comp (continuous_id.prodMk continuous_const).continuousOn (fun s hs => ⟨hs, hw⟩)

    obtain ⟨cl, hcl⟩ : ∃ cl : ℝ → ℝ, cl = fun s => max 0 (min Xan s) := ⟨_, rfl⟩
    have hclc : Continuous cl := by
      rw [hcl]; exact continuous_const.max (continuous_const.min continuous_id)
    have hclm : ∀ s, cl s ∈ Icc 0 Xan := fun s => by
      rw [hcl]; exact ⟨le_max_left _ _, max_le hXan (min_le_left _ _)⟩
    have hcle : ∀ s ∈ Icc 0 Xan, cl s = s := fun s hs => by
      rw [hcl]; simp only [min_eq_right hs.2, max_eq_right hs.1]
    have hfc : Continuous (Function.uncurry
        (fun (p : ℝ × axRect ρ) (t : ℝ) => Φ (cl t) (p.2 : ℂ))) :=
      hc.comp_continuous ((hclc.comp continuous_snd).prodMk
        (continuous_subtype_val.comp (continuous_snd.comp continuous_fst)))
        (fun z => ⟨hclm z.2, z.1.2.2⟩)
    have hH := intervalIntegral.continuous_parametric_intervalIntegral_of_continuous
      (μ := volume) (a₀ := 0) hfc continuous_fst
    have hΓc : ContinuousOn (fun p : ℝ × ℂ => ∫ s in (0:ℝ)..p.1, Φ s p.2)
        (Icc 0 Xan ×ˢ axRect ρ) := by
      rw [continuousOn_iff_continuous_domRestrict]
      refine (hH.comp (continuous_subtype_val.fst.prodMk
        ((continuous_subtype_val.snd).subtype_mk
          (fun q : (Icc 0 Xan ×ˢ axRect ρ : Set (ℝ × ℂ)) => q.2.2)))).congr (fun q => ?_)
      show (∫ t in (0:ℝ)..(q : ℝ × ℂ).1, Φ (cl t) (q : ℝ × ℂ).2) =
        ∫ s in (0:ℝ)..(q : ℝ × ℂ).1, Φ s (q : ℝ × ℂ).2
      apply intervalIntegral.integral_congr
      intro t ht
      rw [uIcc_of_le q.2.1.1] at ht
      simp only
      rw [hcle t ⟨ht.1, ht.2.trans q.2.1.2⟩]

    have hΓd : ∀ X, 0 ≤ X → X ≤ Xan →
        DifferentiableOn ℂ (fun w => ∫ s in (0:ℝ)..X, Φ s w) (axRect ρ) := by
      intro X hX0 hX1 w0 hw0
      apply DifferentiableAt.differentiableWithinAt
      obtain ⟨R, hR, hRS⟩ := Metric.isOpen_iff.mp hSo w0 hw0
      obtain ⟨r, hr⟩ : ∃ r : ℝ, r = R / 3 := ⟨_, rfl⟩
      have hr0 : 0 < r := by rw [hr]; positivity
      have hsubI : uIoc 0 X ⊆ Icc 0 Xan := by
        rw [uIoc_of_le hX0]; exact fun t ht => ⟨ht.1.le, ht.2.trans hX1⟩
      have hsubC : uIcc 0 X ⊆ Icc 0 Xan := by
        rw [uIcc_of_le hX0]; exact Icc_subset_Icc le_rfl hX1
      have hball : ∀ x ∈ Metric.ball w0 r, Metric.closedBall x r ⊆ axRect ρ := by
        intro x hx z hz
        apply hRS
        rw [Metric.mem_ball] at hx ⊢
        rw [Metric.mem_closedBall] at hz
        calc dist z w0 ≤ dist z x + dist x w0 := dist_triangle _ _ _
          _ < R := by linarith
      have hballS : Metric.ball w0 r ⊆ axRect ρ := fun x hx =>
        hball x hx (Metric.mem_closedBall_self hr0.le)
      have hcauchy : ∀ t ∈ Icc 0 Xan, ∀ x ∈ Metric.ball w0 r, ‖deriv (Φ t) x‖ ≤ C / r := by
        intro t ht x hx
        apply Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr0
        · apply DifferentiableOn.diffContOnCl
          rw [closure_ball x hr0.ne']
          exact (hX t ht.1 ht.2).1.mono (hball x hx)
        · intro z hz
          exact (hX t ht.1 ht.2).2.1 z (hball x hx (Metric.sphere_subset_closedBall hz))
      have hmeasF : ∀ x ∈ axRect ρ,
          AEStronglyMeasurable (fun t => Φ t x) (volume.restrict (uIoc 0 X)) :=
        fun x hx => ((hsl x hx).mono hsubI).aestronglyMeasurable measurableSet_uIoc
      have hmeasF' : AEStronglyMeasurable (fun t => deriv (Φ t) w0)
          (volume.restrict (uIoc 0 X)) := by
        obtain ⟨h, hh⟩ : ∃ h : ℕ → ℂ, h = fun n : ℕ => ((r / ((n : ℝ) + 2) : ℝ) : ℂ) := ⟨_, rfl⟩
        have hpos : ∀ n : ℕ, 0 < r / ((n : ℝ) + 2) := fun n => by positivity
        have hhn : ∀ n : ℕ, w0 + h n ∈ axRect ρ := by
          intro n
          apply hballS
          rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, hh]
          simp only [Complex.norm_real, Real.norm_eq_abs]
          rw [abs_of_pos (hpos n)]
          exact div_lt_self hr0 (by have := Nat.cast_nonneg (α := ℝ) n; linarith)
        have hreal : Filter.Tendsto (fun n : ℕ => r / ((n : ℝ) + 2)) Filter.atTop (nhds 0) :=
          Filter.Tendsto.div_atTop tendsto_const_nhds
            (Filter.tendsto_atTop_add_const_right _ 2 tendsto_natCast_atTop_atTop)
        have hh0 : Filter.Tendsto h Filter.atTop (nhds 0) := by
          have := (Complex.continuous_ofReal.tendsto 0).comp hreal
          rw [Complex.ofReal_zero] at this
          rw [hh]; exact this
        have hhT : Filter.Tendsto h Filter.atTop (nhdsWithin 0 {0}ᶜ) :=
          tendsto_nhdsWithin_iff.mpr ⟨hh0, Filter.Eventually.of_forall (fun n => by
            rw [hh]
            exact mem_compl_singleton_iff.mpr (Complex.ofReal_ne_zero.mpr (hpos n).ne'))⟩
        apply aestronglyMeasurable_of_tendsto_ae Filter.atTop
          (f := fun n t => (h n)⁻¹ • (Φ t (w0 + h n) - Φ t w0))
        · intro n
          exact (((hmeasF _ (hhn n)).sub (hmeasF _ hw0)).const_smul (h n)⁻¹ : _)
        · apply ae_restrict_of_forall_mem measurableSet_uIoc
          intro t ht
          have hdt : HasDerivAt (Φ t) (deriv (Φ t) w0) w0 :=
            ((hX t (hsubI ht).1 (hsubI ht).2).1.differentiableAt (hSo.mem_nhds hw0)).hasDerivAt
          exact hdt.tendsto_slope_zero.comp hhT
      have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le (𝕜 := ℂ)
        (μ := volume) (a := 0) (b := X) (bound := fun _ => C / r) (F := fun x t => Φ t x)
        (F' := fun x t => deriv (Φ t) x) (x₀ := w0) (s := Metric.ball w0 r)
        (Metric.ball_mem_nhds w0 hr0)
        (Filter.eventually_of_mem (hSo.mem_nhds hw0) hmeasF)
        (((hsl w0 hw0).mono hsubC).intervalIntegrable)
        hmeasF'
        (Filter.Eventually.of_forall (fun t ht x hx => hcauchy t (hsubI ht) x hx))
        intervalIntegrable_const
        (Filter.Eventually.of_forall (fun t ht x hx =>
          ((hX t (hsubI ht).1 (hsubI ht).2).1.differentiableAt
            (hSo.mem_nhds (hballS hx))).hasDerivAt))
      exact key.2.differentiableAt
    refine ⟨fun X w => ∫ s in (0:ℝ)..X, Φ s w, |C| * Xan, hΓc,
      fun X hXa hXb => ⟨hΓd X hXa hXb, fun w hw => ?_, fun η h1 h2 => ?_⟩⟩
    · have hsubI : uIoc 0 X ⊆ Icc 0 Xan := by
        rw [uIoc_of_le hXa]; exact fun t ht => ⟨ht.1.le, ht.2.trans hXb⟩
      have hb := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := X) (C := |C|)
        (f := fun s => Φ s w)
        (fun s hs => ((hX s (hsubI hs).1 (hsubI hs).2).2.1 w hw).trans (le_abs_self C))
      rw [sub_zero, abs_of_nonneg hXa] at hb
      exact hb.trans (mul_le_mul_of_nonneg_left hXb (abs_nonneg C))
    · show ∫ s in (0:ℝ)..X, Φ s (η : ℂ) =
        ((iteratedDeriv 0 (fun Y => ∫ s in (0:ℝ)..Y, φ s η) X : ℝ) : ℂ)
      rw [iteratedDeriv_zero, ← intervalIntegral.integral_ofReal]
      apply intervalIntegral.integral_congr
      intro s hs
      rw [uIcc_of_le hXa] at hs
      have := (hX s hs.1 (hs.2.trans hXb)).2.2 η h1 h2
      rw [iteratedDeriv_zero] at this
      exact this

theorem ax_collar_analytic_unit : AxDatumSmooth → ∀ (h Pst : ℝ) (Pax : ℝ → ℝ), AxDatum h Pst Pax → ∀ (j0 σ δ ρ : ℝ) (Pc : ℂ → ℂ), 0 < j0 → j0 ≤ 1 / 20 → AxData h j0 σ δ ρ Pc Pax → ∀ (Λ C K ρ1 t1 κ0 om : ℝ) (Kder M : ℕ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 1 ≤ Λ → 0 < K → 0 < ρ1 → 0 < t1 → t1 ≤ 1 / 100 → 0 < κ0 → κ0 < 1 / 2 → 0 < om → om ≤ 1 / 25 → AxAxisOut h j0 σ δ Pax Λ C K ρ1 Kder Fn Un → AxRefPI h j0 σ Pax Λ C K ρ1 M (axRefF Λ t1 Fn) (axRefU Λ t1 Un) →
    ∀ Xan : ℝ, 4 / Λ < Xan → Xan < 4 / Λ * Real.exp t1 →
    (∃ ρ : ℝ, 0 < ρ ∧ ∃ Fc Uc Pc : ℕ → ℝ → ℂ → ℂ, ∀ k : ℕ, ∃ C : ℝ,
      ContinuousOn (fun p : ℝ × ℂ => Fc k p.1 p.2)
        (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
      ContinuousOn (fun p : ℝ × ℂ => Uc k p.1 p.2)
        (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
      ContinuousOn (fun p : ℝ × ℂ => Pc k p.1 p.2)
        (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
      ∀ X : ℝ, 0 ≤ X → X ≤ Xan →
        DifferentiableOn ℂ (Fc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
        DifferentiableOn ℂ (Uc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
        DifferentiableOn ℂ (Pc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
        (∀ w : ℂ, |w.im| < ρ → -1 - ρ < w.re → w.re < 1 + ρ →
          ‖Fc k X w‖ ≤ C ∧ ‖Uc k X w‖ ≤ C ∧ ‖Pc k X w‖ ≤ C) ∧
        (∀ η : ℝ, -1 < η → η < 1 →
          Fc k X (η : ℂ) = ((iteratedDeriv k (fun Y => axProfF h Λ t1 κ0 om Fn Un Y η) X : ℝ) : ℂ) ∧
          Uc k X (η : ℂ) = ((iteratedDeriv k (fun Y => axProfU h Λ t1 κ0 om Pax Fn Un Y η) X : ℝ) : ℂ) ∧
          Pc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Pax η + profRadInt (fun x e => axProfF h Λ t1 κ0 om Fn Un x e ^ 2) Y η) X : ℝ) : ℂ))) :=
by
  intro _hSm h _Pst Pax _hD j0 σ δ _ρ _Pc _hj0 _hj0' _hAD Λ C K ρ1 t1 κ0 om Kder _M Fn Un hΛ _hK
    hρ1 ht1 ht1' _hκ0 _hκ0' hom _hom' hA _hR Xan hXan1 hXan2

  have hΛ0 : 0 < Λ := by linarith
  have hX0 : 0 < 4 / Λ := div_pos (by norm_num) hΛ0
  have hXan0 : 0 ≤ Xan := by linarith
  have hexp : Real.exp t1 < 41 / 40 := by
    have h1 := Real.exp_bound_div_one_sub_of_interval' ht1 (by linarith)
    have h2 : 1 / (1 - t1) < 41 / 40 := by
      rw [div_lt_div_iff₀ (by linarith) (by norm_num)]; linarith
    linarith
  have hXan41 : Xan < 41 / (10 * Λ) := by
    have h1 : 4 / Λ * Real.exp t1 < 4 / Λ * (41 / 40) := mul_lt_mul_of_pos_left hexp hX0
    have h2 : 4 / Λ * (41 / 40) = 41 / (10 * Λ) := by field_simp; ring
    linarith
  have hε1 : 0 < 4 / Λ * Real.exp t1 - Xan := by linarith

  have hsub : ∀ a b : ℝ, a ≤ b → axRect a ⊆ axRect b := by
    intro a b hab w hw
    simp only [axRect, mem_setOf_eq] at hw ⊢
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩

  have hcongr : ∀ (ρa ρb ε0 : ℝ) (φ ψ : ℝ → ℝ → ℝ), ρb ≤ ρa → 0 < ε0 →
      (∀ X η : ℝ, -ε0 < X → X < Xan + ε0 → -1 < η → η < 1 → ψ X η = φ X η) →
      AxHJet Xan ρa φ → AxHJet Xan ρb ψ := by
    intro ρa ρb ε0 φ ψ hab hε0 heq hφ
    unfold AxHJet AxHJetK at *
    obtain ⟨hs, hj⟩ := hφ
    refine ⟨fun η h1 h2 => ?_, fun k => ?_⟩
    · obtain ⟨ε, hε, hsm⟩ := hs η h1 h2
      refine ⟨min ε ε0, lt_min hε hε0, ?_⟩
      have hs' : Ioo (-min ε ε0) (Xan + min ε ε0) ⊆ Ioo (-ε) (Xan + ε) := fun x hx =>
        ⟨by linarith [hx.1, min_le_left ε ε0], by linarith [hx.2, min_le_left ε ε0]⟩
      exact (hsm.mono hs').congr (fun x hx =>
        heq x η (by linarith [hx.1, min_le_right ε ε0]) (by linarith [hx.2, min_le_right ε ε0]) h1 h2)
    · obtain ⟨Φ, C0, hc, hX⟩ := hj k
      refine ⟨Φ, C0, hc.mono (prod_mono subset_rfl (hsub _ _ hab)), fun X hXa hXb => ?_⟩
      obtain ⟨hd, hb, hr⟩ := hX X hXa hXb
      refine ⟨hd.mono (hsub _ _ hab), fun w hw => hb w (hsub _ _ hab hw), fun η h1 h2 => ?_⟩
      have hev : (fun Y => φ Y η) =ᶠ[nhds X] (fun Y => ψ Y η) :=
        Filter.eventuallyEq_of_mem (Ioo_mem_nhds (by linarith) (by linarith))
          (fun Y hY => (heq Y η hY.1 hY.2 h1 h2).symm)
      rw [hr η h1 h2, hev.iteratedDeriv_eq k]

  have hadd : ∀ (ρa : ℝ) (φ ψ : ℝ → ℝ → ℝ), AxHJet Xan ρa φ → AxHJet Xan ρa ψ →
      AxHJet Xan ρa (fun X η => φ X η + ψ X η) := by
    intro ρa φ ψ hφ hψ
    unfold AxHJet AxHJetK at *
    obtain ⟨hs1, hj1⟩ := hφ
    obtain ⟨hs2, hj2⟩ := hψ
    refine ⟨fun η h1 h2 => ?_, fun k => ?_⟩
    · obtain ⟨e1, he1, s1⟩ := hs1 η h1 h2
      obtain ⟨e2, he2, s2⟩ := hs2 η h1 h2
      refine ⟨min e1 e2, lt_min he1 he2, ?_⟩
      exact (s1.mono (fun x hx => ⟨by linarith [hx.1, min_le_left e1 e2],
          by linarith [hx.2, min_le_left e1 e2]⟩)).add
        (s2.mono (fun x hx => ⟨by linarith [hx.1, min_le_right e1 e2],
          by linarith [hx.2, min_le_right e1 e2]⟩))
    · obtain ⟨Φ, C1, hc1, hX1⟩ := hj1 k
      obtain ⟨Ψ, C2, hc2, hX2⟩ := hj2 k
      refine ⟨fun X w => Φ X w + Ψ X w, C1 + C2, hc1.add hc2, fun X hXa hXb => ?_⟩
      obtain ⟨d1, b1, r1⟩ := hX1 X hXa hXb
      obtain ⟨d2, b2, r2⟩ := hX2 X hXa hXb
      refine ⟨d1.add d2, fun w hw => (norm_add_le _ _).trans (add_le_add (b1 w hw) (b2 w hw)),
        fun η h1 h2 => ?_⟩
      obtain ⟨e1, he1, s1⟩ := hs1 η h1 h2
      obtain ⟨e2, he2, s2⟩ := hs2 η h1 h2
      have ca : ContDiffAt ℝ k (fun Y => φ Y η) X :=
        contDiffAt_infty.mp (s1.contDiffAt (Ioo_mem_nhds (by linarith) (by linarith))) k
      have cb : ContDiffAt ℝ k (fun Y => ψ Y η) X :=
        contDiffAt_infty.mp (s2.contDiffAt (Ioo_mem_nhds (by linarith) (by linarith))) k
      show Φ X η + Ψ X η = ((iteratedDeriv k (fun Y => φ Y η + ψ Y η) X : ℝ) : ℂ)
      rw [r1 η h1 h2, r2 η h1 h2,
        show (fun Y => φ Y η + ψ Y η) = (fun Y => φ Y η) + (fun Y => ψ Y η) from rfl,
        iteratedDeriv_add ca cb, Complex.ofReal_add]

  have hscal : ∀ (ρa : ℝ) (e : ℝ → ℝ), ContDiff ℝ ∞ e → AxHJet Xan ρa (fun X _ => e X) := by
    intro ρa e he
    unfold AxHJet AxHJetK
    refine ⟨fun η _ _ => ⟨1, one_pos, he.contDiffOn⟩, fun k => ?_⟩
    have hc : Continuous (iteratedDeriv k e) :=
      (contDiff_infty.mp he k).continuous_iteratedDeriv k le_rfl
    obtain ⟨B, hB⟩ := (isCompact_Icc : IsCompact (Icc (0:ℝ) Xan)).exists_bound_of_continuousOn
      hc.continuousOn
    refine ⟨fun X _ => ((iteratedDeriv k e X : ℝ) : ℂ), B, ?_, fun X hXa hXb =>
      ⟨differentiableOn_const _, fun w _ => ?_, fun η _ _ => rfl⟩⟩
    · exact (Complex.continuous_ofReal.comp (hc.comp continuous_fst)).continuousOn
    · show ‖((iteratedDeriv k e X : ℝ) : ℂ)‖ ≤ B
      rw [Complex.norm_real]; exact hB X ⟨hXa, hXb⟩

  have hder : ∀ (ρa : ℝ) (φ : ℝ → ℝ → ℝ), AxHJet Xan ρa φ →
      AxHJet Xan ρa (fun X η => deriv (fun Y => φ Y η) X) := by
    intro ρa φ hφ
    unfold AxHJet AxHJetK at *
    obtain ⟨hs, hj⟩ := hφ
    refine ⟨fun η h1 h2 => ?_, fun k => ?_⟩
    · obtain ⟨e, he, s⟩ := hs η h1 h2
      exact ⟨e, he, ((contDiffOn_infty_iff_deriv_of_isOpen isOpen_Ioo).mp s).2⟩
    · obtain ⟨Φ, C0, hc, hX⟩ := hj (k + 1)
      refine ⟨Φ, C0, hc, fun X hXa hXb => ?_⟩
      obtain ⟨d, b, r⟩ := hX X hXa hXb
      refine ⟨d, b, fun η h1 h2 => ?_⟩
      rw [r η h1 h2, iteratedDeriv_succ']

  have hsig : ContDiff ℝ ∞ sigA := sigA_collar_facts.1
  have hEa : ContDiff ℝ ∞ (axEa Λ t1 κ0) := by
    rw [contDiff_iff_contDiffAt]
    intro x
    rcases lt_or_ge x (4 / Λ) with hx | hx
    · exact (contDiffAt_const (c := (0:ℝ))).congr_of_eventuallyEq
        (Filter.eventuallyEq_of_mem (Iio_mem_nhds hx)
          (fun y hy => by unfold axEa; rw [if_pos (le_of_lt hy)]))
    · have hxp : 0 < x := lt_of_lt_of_le hX0 hx
      have hne : x * Λ / 4 ≠ 0 := by positivity
      have hlin : ContDiffAt ℝ ∞ (fun y : ℝ => y * Λ / 4) x := by fun_prop
      have hlog : ContDiffAt ℝ ∞ (fun y : ℝ => Real.log (y * Λ / 4)) x := hlin.log hne
      have hf : ContDiffAt ℝ ∞ (fun y : ℝ => Real.log (y * Λ / 4) / t1) x :=
        hlog.div_const t1
      have hg : ContDiffAt ℝ ∞ (fun y : ℝ => (1 - κ0) * sigA (Real.log (y * Λ / 4) / t1)) x :=
        contDiffAt_const.mul (hsig.contDiffAt.comp x hf)
      apply hg.congr_of_eventuallyEq
      filter_upwards [Ioi_mem_nhds hxp] with y hy
      have hy' : 0 < y := hy
      unfold axEa axLogY
      split_ifs with hyl
      · have h4 : y * Λ ≤ 4 := by
          have := mul_le_mul_of_nonneg_right hyl hΛ0.le
          rw [div_mul_cancel₀ _ hΛ0.ne'] at this; exact this
        have hl : Real.log (y * Λ / 4) ≤ 0 :=
          Real.log_nonpos (by positivity) (by linarith)
        have hs0 : sigA (Real.log (y * Λ / 4) / t1) = 0 := by
          unfold sigA; rw [if_pos (div_nonpos_of_nonpos_of_nonneg hl ht1.le)]
        rw [hs0, mul_zero]
      · rfl

  obtain ⟨ρ0, hρ0, jFn, jUn, jPax, hposN, hcont, hposK, Fc0, hFc0c, hFc0d, hFc0r⟩ :=
    ax_axis_jets h j0 σ δ Pax Λ C K ρ1 Xan Kder Fn Un hΛ hρ1 hXan0 hXan41 hA
  obtain ⟨ρ', m, hρ', hρ'le, hm, hmb⟩ :=
    ax_strip_nonvanish Fc0 Fn 0 Xan ρ0 hXan0 hρ0 hFc0c hcont hposK hFc0r
  have jFn' := hcongr ρ0 ρ' 1 Fn Fn hρ'le one_pos (fun _ _ _ _ _ _ => rfl) jFn
  have jUn' := hcongr ρ0 ρ' 1 Un Un hρ'le one_pos (fun _ _ _ _ _ _ => rfl) jUn
  have jPax' := hcongr ρ0 ρ' 1 _ (fun _ η => Pax η) hρ'le one_pos (fun _ _ _ _ _ _ => rfl) jPax
  have jE := hscal ρ' (axEa Λ t1 κ0) hEa
  have jM := hscal ρ' (fun _ => (-1:ℝ)) contDiff_const

  have jFd := hder ρ' Fn jFn'
  have jR := axhjet_inv Xan ρ' m Fn Fc0 hXan0 hm jFn'
    (fun η h1 h2 => by
      obtain ⟨ε, hε, hp⟩ := hposN η h1 h2
      exact ⟨ε, hε, fun Y a b => (hp Y a b).ne'⟩)
    (hFc0c.mono (prod_mono subset_rfl (hsub _ _ hρ'le)))
    (fun X a b => ⟨(hFc0d X a b).mono (hsub _ _ hρ'le), fun w hw => hmb X w a b hw⟩) hFc0r
  have jq := axhjet_mul Xan ρ' _ _ hXan0 jFd jR
  have jg := axhjet_mul Xan ρ' _ _ hXan0 jE jq
  have jG := axhjet_integral Xan ρ' _ hXan0 hρ' jg
  have jmG := axhjet_mul Xan ρ' _ _ hXan0 jM jG
  have jEx := axhjet_exp Xan ρ' _ hXan0 jmG
  have jFr := axhjet_mul Xan ρ' _ _ hXan0 jFn' jEx
  have jF : AxHJet Xan ρ' (axProfF h Λ t1 κ0 om Fn Un) :=
    hcongr ρ' ρ' (4 / Λ * Real.exp t1 - Xan) _ _ le_rfl hε1
      (fun X η _ b h1 h2 => ax_collar_rep_F h j0 σ δ Λ C K ρ1 t1 κ0 om Pax Kder Fn Un hΛ hρ1 ht1 ht1'
        hom hA X η (by linarith) h1 h2) jFr

  have jUd := hder ρ' Un jUn'
  have jh := axhjet_integral Xan ρ' _ hXan0 hρ' (axhjet_mul Xan ρ' _ _ hXan0 jE jUd)
  have jUr := hadd ρ' _ _ jUn' (axhjet_mul Xan ρ' _ _ hXan0 jM jh)
  have jU : AxHJet Xan ρ' (axProfU h Λ t1 κ0 om Pax Fn Un) :=
    hcongr ρ' ρ' (4 / Λ * Real.exp t1 - Xan) _ _ le_rfl hε1
      (fun X η _ b h1 h2 => ax_collar_rep_U h j0 σ δ Λ C K ρ1 t1 κ0 om Pax Kder Fn Un hΛ hρ1 ht1 ht1'
        hom hA X η (by linarith) h1 h2) jUr

  have jI := axhjet_integral Xan ρ' _ hXan0 hρ' (axhjet_mul Xan ρ' _ _ hXan0 jF jF)
  have jPr := hadd ρ' _ _ jPax' jI
  have jP : AxHJet Xan ρ'
      (fun Y η => Pax η + profRadInt (fun x e => axProfF h Λ t1 κ0 om Fn Un x e ^ 2) Y η) :=
    hcongr ρ' ρ' 1 _ _ le_rfl one_pos (fun X η _ _ _ _ => by simp only [profRadInt, sq]) jPr

  obtain ⟨-, jFk⟩ := jF
  obtain ⟨-, jUk⟩ := jU
  obtain ⟨-, jPk⟩ := jP
  unfold AxHJetK at jFk jUk jPk
  choose ΦF CF hΦFc hΦF using jFk
  choose ΦU CU hΦUc hΦU using jUk
  choose ΦP CP hΦPc hΦP using jPk
  refine ⟨ρ', hρ', ΦF, ΦU, ΦP, fun k => ⟨max (max (CF k) (CU k)) (CP k), hΦFc k, hΦUc k, hΦPc k,
    fun X hXa hXb => ?_⟩⟩
  obtain ⟨dF, bF, rF⟩ := hΦF k X hXa hXb
  obtain ⟨dU, bU, rU⟩ := hΦU k X hXa hXb
  obtain ⟨dP, bP, rP⟩ := hΦP k X hXa hXb
  refine ⟨dF, dU, dP, fun w w1 w2 w3 => ?_, fun η h1 h2 => ⟨rF η h1 h2, rU η h1 h2, rP η h1 h2⟩⟩
  have hw : w ∈ axRect ρ' := by simp only [axRect, mem_setOf_eq]; exact ⟨w1, w2, w3⟩
  exact ⟨(bF w hw).trans (le_trans (le_max_left _ _) (le_max_left _ _)),
    (bU w hw).trans (le_trans (le_max_right _ _) (le_max_left _ _)),
    (bP w hw).trans (le_max_right _ _)⟩

theorem ax_ff_model_eq : ∀ (h j0 σ δ Λ C K ρ1 t1 κ0 om : ℝ) (Pax : ℝ → ℝ) (Kder : ℕ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 1 ≤ Λ → 0 < ρ1 → 0 < t1 → t1 ≤ 1 / 100 → 0 < om → AxAxisOut h j0 σ δ Pax Λ C K ρ1 Kder Fn Un → ∀ X η : ℝ, 0 < X → X < 4 / Λ * Real.exp t1 → -1 < η → η < 1 → axProfF h Λ t1 κ0 om Fn Un X η = axFfModelF Λ t1 κ0 Fn X η ∧ axProfU h Λ t1 κ0 om Pax Fn Un X η = axFfModelU Λ t1 κ0 Un X η :=
by
  intro h j0 σ δ Λ C K ρ1 t1 κ0 om Pax Kder Fn Un hΛ hρ1 ht1 ht1' hom hA X η _hX hX2 hη1 hη2
  have hΛ0 : 0 < Λ := by linarith
  have hc : 0 < 4 / Λ := div_pos (by norm_num) hΛ0
  have s3 : ∀ (g : ℝ → ℝ) (c : ℝ), 0 < c → (∀ s, s ≤ c → g s = 0) → ∀ Y : ℝ,
      (∫ s in (0:ℝ)..Y, g s) = ∫ s in c..Y, g s := by
    intro g c hc0 hg Y
    by_cases hY : Y ≤ c
    · have e1 : (∫ s in (0:ℝ)..Y, g s) = ∫ s in (0:ℝ)..Y, (0:ℝ) := by
        apply intervalIntegral.integral_congr
        intro s hs
        rcases Set.mem_uIcc.mp hs with ⟨_, h2⟩ | ⟨_, h2⟩
        · exact hg s (by linarith)
        · exact hg s (by linarith)
      have e2 : (∫ s in c..Y, g s) = ∫ s in c..Y, (0:ℝ) := by
        apply intervalIntegral.integral_congr
        intro s hs
        rcases Set.mem_uIcc.mp hs with ⟨_, h2⟩ | ⟨_, h2⟩
        · exact hg s (by linarith)
        · exact hg s (by linarith)
      rw [e1, e2, intervalIntegral.integral_zero, intervalIntegral.integral_zero]
    · push_neg at hY
      rw [intervalIntegral.integral_of_le (by linarith), intervalIntegral.integral_of_le hY.le]
      refine MeasureTheory.setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioc
        (Set.Ioc_subset_Ioc_left hc0.le) ?_
      intro x hx
      apply hg
      by_contra hxc
      push_neg at hxc
      exact hx.2 ⟨hxc, hx.1.2⟩
  have hzero : ∀ s, s ≤ 4 / Λ → axEa Λ t1 κ0 s = 0 := by
    intro s hs
    unfold axEa
    rw [if_pos hs]
  refine ⟨?_, ?_⟩
  · rw [ax_collar_rep_F h j0 σ δ Λ C K ρ1 t1 κ0 om Pax Kder Fn Un hΛ hρ1 ht1 ht1' hom hA X η hX2 hη1 hη2]
    unfold axFfModelF
    rw [s3 (fun s => axEa Λ t1 κ0 s * (deriv (fun Y => Fn Y η) s * (Fn s η)⁻¹)) (4 / Λ) hc
      (fun s hs => by simp only [hzero s hs, zero_mul]) X, neg_one_mul]
    simp only [div_eq_mul_inv]
  · rw [ax_collar_rep_U h j0 σ δ Λ C K ρ1 t1 κ0 om Pax Kder Fn Un hΛ hρ1 ht1 ht1' hom hA X η hX2 hη1 hη2]
    unfold axFfModelU
    rw [s3 (fun s => axEa Λ t1 κ0 s * deriv (fun Y => Un Y η) s) (4 / Λ) hc
      (fun s hs => by simp only [hzero s hs, zero_mul]) X]
    ring

theorem ax_ff_model_deriv : ∀ (h j0 σ δ Λ C K ρ1 t1 κ0 : ℝ) (Pax : ℝ → ℝ) (Kder : ℕ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 1 ≤ Λ → 0 < ρ1 → 0 < t1 → t1 ≤ 1 / 100 → 0 < κ0 → κ0 < 1 / 2 → AxAxisOut h j0 σ δ Pax Λ C K ρ1 Kder Fn Un → ∀ X η : ℝ, 4 / Λ < X → X < 4 / Λ * Real.exp t1 → -1 < η → η < 1 → HasDerivAt (fun Y => axFfModelF Λ t1 κ0 Fn Y η) ((1 - axEa Λ t1 κ0 X) * deriv (fun Y => Fn Y η) X * axFfModelF Λ t1 κ0 Fn X η / Fn X η) X ∧ HasDerivAt (fun Y => axFfModelU Λ t1 κ0 Un Y η) ((1 - axEa Λ t1 κ0 X) * deriv (fun Y => Un Y η) X) X :=
by
  intro h j0 σ δ Λ C K ρ1 t1 κ0 Pax Kder Fn Un hΛ hρ1 ht1 ht1' hκ0 hκ0' hA X η hX1 hX2 hη1 hη2
  obtain ⟨hFs, hUs, hpos, -⟩ := hA
  have hΛ0 : 0 < Λ := by linarith
  have hc : 0 < 4 / Λ := div_pos (by norm_num) hΛ0
  have hXpos : 0 < X := lt_trans hc hX1

  have he1 : Real.exp t1 < 41 / 40 := by
    have h1 : Real.exp t1 ≤ Real.exp (1 / 100) := Real.exp_le_exp.mpr ht1'
    have h2 : Real.exp (1 / 100) < 1 / (1 - 1 / 100) :=
      Real.exp_bound_div_one_sub_of_interval' (by norm_num) (by norm_num)
    have h3 : (1 : ℝ) / (1 - 1 / 100) < 41 / 40 := by norm_num
    linarith
  have hXV : X < 41 / (10 * Λ) := by
    have h1 : 4 / Λ * Real.exp t1 < 4 / Λ * (41 / 40) := mul_lt_mul_of_pos_left he1 hc
    have h2 : 4 / Λ * (41 / 40) = 41 / (10 * Λ) := by field_simp; ring
    linarith
  have hVO : 41 / (10 * Λ) < 5 / Λ := by
    rw [div_lt_div_iff₀ (by positivity) hΛ0]; nlinarith
  have hO0 : -1 / Λ < 0 := div_neg_of_neg_of_pos (by norm_num) hΛ0
  have hVsub : Ioo 0 (41 / (10 * Λ)) ⊆ Ioo (-1 / Λ) (5 / Λ) :=
    fun s hs => ⟨lt_trans hO0 hs.1, lt_trans hs.2 hVO⟩
  have hηS : η ∈ Ioo (-1 - ρ1) (1 + ρ1) := ⟨by linarith, by linarith⟩
  have hmaps : MapsTo (fun Y : ℝ => (Y, η)) (Ioo (-1 / Λ) (5 / Λ))
      (Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) := fun Y hY => ⟨hY, hηS⟩

  have hφ : ContDiffOn ℝ ∞ (fun Y => Fn Y η) (Ioo (-1 / Λ) (5 / Λ)) :=
    hFs.comp ((contDiff_id.prodMk contDiff_const).contDiffOn) hmaps
  have hψ : ContDiffOn ℝ ∞ (fun Y => Un Y η) (Ioo (-1 / Λ) (5 / Λ)) :=
    hUs.comp ((contDiff_id.prodMk contDiff_const).contDiffOn) hmaps
  have hOo : IsOpen (Ioo (-1 / Λ) (5 / Λ)) := isOpen_Ioo
  have hVo : IsOpen (Ioo 0 (41 / (10 * Λ))) := isOpen_Ioo
  have hXVm : X ∈ Ioo 0 (41 / (10 * Λ)) := ⟨hXpos, hXV⟩
  have hXO : X ∈ Ioo (-1 / Λ) (5 / Λ) := hVsub hXVm
  have hdφ : ContinuousOn (deriv (fun Y => Fn Y η)) (Ioo (-1 / Λ) (5 / Λ)) :=
    hφ.continuousOn_deriv_of_isOpen hOo (by simp)
  have hdψ : ContinuousOn (deriv (fun Y => Un Y η)) (Ioo (-1 / Λ) (5 / Λ)) :=
    hψ.continuousOn_deriv_of_isOpen hOo (by simp)
  have hφX : HasDerivAt (fun Y => Fn Y η) (deriv (fun Y => Fn Y η) X) X :=
    ((hφ.differentiableOn (by simp)).differentiableAt (hOo.mem_nhds hXO)).hasDerivAt
  have hψX : HasDerivAt (fun Y => Un Y η) (deriv (fun Y => Un Y η) X) X :=
    ((hψ.differentiableOn (by simp)).differentiableAt (hOo.mem_nhds hXO)).hasDerivAt

  have hFpos : ∀ s ∈ Ioo 0 (41 / (10 * Λ)), 0 < Fn s η :=
    fun s hs => hpos s η hs.1.le hs.2.le hηS.1 hηS.2

  have hsig : Continuous sigA := by
    have he_cont : Continuous (fun y : ℝ => expNegInvGlue (y * |y|)) :=
      (expNegInvGlue.contDiff (n := 0)).continuous.comp (continuous_id.mul continuous_abs)
    have he0 : ∀ y : ℝ, y ≤ 0 → expNegInvGlue (y * |y|) = 0 := by
      intro y hy
      apply expNegInvGlue.zero_of_nonpos
      rw [abs_of_nonpos hy]
      nlinarith
    have hepos : ∀ y : ℝ, 0 < y → expNegInvGlue (y * |y|) = Real.exp (-1 / y ^ 2) := by
      intro y hy
      rw [abs_of_pos hy]
      unfold expNegInvGlue
      rw [if_neg (by nlinarith)]
      congr 1
      rw [neg_div, one_div, sq]
    have hnn : ∀ y : ℝ, 0 ≤ expNegInvGlue (y * |y|) := fun y => expNegInvGlue.nonneg _
    have hden : ∀ y : ℝ, expNegInvGlue (y * |y|) + expNegInvGlue ((1 - y) * |1 - y|) ≠ 0 := by
      intro y
      apply ne_of_gt
      rcases lt_or_ge 0 y with hy | hy
      · rw [hepos y hy]
        linarith [Real.exp_pos (-1 / y ^ 2), hnn (1 - y)]
      · rw [hepos (1 - y) (by linarith)]
        linarith [Real.exp_pos (-1 / (1 - y) ^ 2), hnn y]
    have hfun : sigA = fun y => expNegInvGlue (y * |y|) /
        (expNegInvGlue (y * |y|) + expNegInvGlue ((1 - y) * |1 - y|)) := by
      funext y
      unfold sigA
      split_ifs with h1 h2
      · rw [he0 y h1, zero_div]
      · rw [he0 (1 - y) (by linarith), add_zero]
        have hne : expNegInvGlue (y * |y|) ≠ 0 := by
          rw [hepos y (by linarith)]; exact (Real.exp_pos _).ne'
        exact (div_self hne).symm
      · push_neg at h1 h2
        rw [hepos y h1, hepos (1 - y) (by linarith)]
    have h1m : Continuous (fun y : ℝ => expNegInvGlue ((1 - y) * |1 - y|)) :=
      he_cont.comp (continuous_const.sub continuous_id)
    rw [hfun]
    exact he_cont.div (he_cont.add h1m) hden
  have hEa : ContinuousOn (fun s => axEa Λ t1 κ0 s) (Ioi 0) := by
    have hlog : ContinuousOn (fun s => Real.log (s * Λ / 4)) (Ioi 0) :=
      ContinuousOn.log (by fun_prop) (fun s hs => (div_pos (mul_pos hs hΛ0) (by norm_num)).ne')
    have he1c : ContinuousOn (fun s => (1 - κ0) * sigA (Real.log (s * Λ / 4) / t1)) (Ioi 0) :=
      continuousOn_const.mul (hsig.comp_continuousOn (hlog.div_const t1))
    refine he1c.congr ?_
    intro s hs
    have hs0 : (0 : ℝ) < s := hs
    show axEa Λ t1 κ0 s = (1 - κ0) * sigA (Real.log (s * Λ / 4) / t1)
    unfold axEa axLogY
    split_ifs with hsl
    · have hle : s * Λ / 4 ≤ 1 := by
        rw [div_le_one (by norm_num)]
        rw [le_div_iff₀ hΛ0] at hsl
        linarith
      have hlg : Real.log (s * Λ / 4) ≤ 0 :=
        Real.log_nonpos (div_pos (mul_pos hs0 hΛ0) (by norm_num)).le hle
      have hneg : Real.log (s * Λ / 4) / t1 ≤ 0 := div_nonpos_of_nonpos_of_nonneg hlg ht1.le
      have hs0' : sigA (Real.log (s * Λ / 4) / t1) = 0 := by
        unfold sigA; rw [if_pos hneg]
      rw [hs0', mul_zero]
    · rfl

  have hEaV : ContinuousOn (fun s => axEa Λ t1 κ0 s) (Ioo 0 (41 / (10 * Λ))) :=
    hEa.mono (fun s hs => hs.1)
  have hg : ContinuousOn (fun s => axEa Λ t1 κ0 s * (deriv (fun Y => Fn Y η) s / Fn s η))
      (Ioo 0 (41 / (10 * Λ))) :=
    hEaV.mul ((hdφ.mono hVsub).div (hφ.continuousOn.mono hVsub) (fun s hs => (hFpos s hs).ne'))
  have hk : ContinuousOn (fun s => axEa Λ t1 κ0 s * deriv (fun Y => Un Y η) s)
      (Ioo 0 (41 / (10 * Λ))) :=
    hEaV.mul (hdψ.mono hVsub)
  have hIcc : Icc (4 / Λ) X ⊆ Ioo 0 (41 / (10 * Λ)) :=
    fun s hs => ⟨lt_of_lt_of_le hc hs.1, lt_of_le_of_lt hs.2 hXV⟩

  have hI : HasDerivAt
      (fun u => ∫ s in (4 / Λ)..u, axEa Λ t1 κ0 s * (deriv (fun Y => Fn Y η) s / Fn s η))
      (axEa Λ t1 κ0 X * (deriv (fun Y => Fn Y η) X / Fn X η)) X :=
    intervalIntegral.integral_hasDerivAt_right ((hg.mono hIcc).intervalIntegrable_of_Icc hX1.le)
      (hg.stronglyMeasurableAtFilter hVo X hXVm) (hg.continuousAt (hVo.mem_nhds hXVm))
  have hJ : HasDerivAt
      (fun u => ∫ s in (4 / Λ)..u, axEa Λ t1 κ0 s * deriv (fun Y => Un Y η) s)
      (axEa Λ t1 κ0 X * deriv (fun Y => Un Y η) X) X :=
    intervalIntegral.integral_hasDerivAt_right ((hk.mono hIcc).intervalIntegrable_of_Icc hX1.le)
      (hk.stronglyMeasurableAtFilter hVo X hXVm) (hk.continuousAt (hVo.mem_nhds hXVm))
  have hF0 : Fn X η ≠ 0 := (hFpos X hXVm).ne'
  refine ⟨?_, ?_⟩
  ·
    have hprod := hφX.mul (hI.neg.exp)
    simp only [Pi.neg_apply] at hprod
    unfold axFfModelF
    convert hprod using 1
    field_simp
    ring
  ·
    unfold axFfModelU
    convert hψX.sub hJ using 1
    ring

theorem ax_osb_algebra : ∀ W : Set (ℝ × ℝ), IsOpen W → Bornology.IsBounded W → (∀ f g : ℝ × ℝ → ℝ, osbGood W W f → osbGood W W g → osbGood W W (fun p => f p * g p)) ∧ (∀ f g : ℝ × ℝ → ℝ, osbGood W W f → osbGood W W g → osbGood W W (fun p => f p + g p)) ∧ (∀ f g : ℝ × ℝ → ℝ, osbGood W W f → osbGood W W g → osbGood W W (fun p => f p - g p)) ∧ (∀ (f : ℝ × ℝ → ℝ) (c : ℝ), osbGood W W f → 0 < c → (∀ p ∈ W, c ≤ |f p|) → osbGood W W (fun p => (f p)⁻¹)) ∧ (∀ (f : ℝ × ℝ → ℝ) (φ : ℝ → ℝ), osbGood W W f → ContDiff ℝ ∞ φ → osbGood W W (fun p => φ (f p))) ∧ (∀ φ : ℝ × ℝ → ℝ, ContDiff ℝ ∞ φ → osbGood W W φ) ∧ (∀ f : ℝ × ℝ → ℝ, osbGood W W f → osbGood W W (fun p => fderiv ℝ f p (0, 1)) ∧ osbGood W W (fun p => fderiv ℝ f p (1, 0))) ∧ (∀ (V : Set (ℝ × ℝ)) (f : ℝ × ℝ → ℝ), IsOpen V → V ⊆ W → osbGood W W f → osbGood V V f) :=
by
  intro W hWo hWb
  have hWu : UniqueDiffOn ℝ W := hWo.uniqueDiffOn
  have hW : ∀ (F : ℝ × ℝ → ℝ) (n : ℕ) (x : ℝ × ℝ), x ∈ W →
      iteratedFDerivWithin ℝ n F W x = iteratedFDeriv ℝ n F x :=
    fun F n x hx => iteratedFDerivWithin_of_isOpen n hWo hx
  have hN : ∀ n : ℕ, ((n : ℕ∞ω)) ≤ ∞ := fun n => by exact_mod_cast le_top
  have hAt : ∀ (F : ℝ × ℝ → ℝ), ContDiffOn ℝ ∞ F W →
      ∀ (n : ℕ) (x : ℝ × ℝ), x ∈ W → ContDiffAt ℝ n F x :=
    fun F hF n x hx => (hF.contDiffAt (hWo.mem_nhds hx)).of_le (hN n)

  have hmul : ∀ f g : ℝ × ℝ → ℝ, osbGood W W f → osbGood W W g →
      osbGood W W (fun p => f p * g p) := by
    intro f g hf hg
    refine ⟨hf.1.mul hg.1, fun n => ?_⟩
    choose A hA using hf.2
    choose B hB using hg.2
    refine ⟨∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * A i * B (n - i), fun p hp => ?_⟩
    rw [← hW _ n p hp]
    refine (norm_iteratedFDerivWithin_mul_le hf.1 hg.1 hWu hp (hN n)).trans ?_
    apply Finset.sum_le_sum
    intro i _
    rw [hW _ i p hp, hW _ (n - i) p hp]
    have h1 := hA i p hp
    have h2 := hB (n - i) p hp
    have h0 : 0 ≤ ‖iteratedFDeriv ℝ i f p‖ := norm_nonneg _
    have h0' : 0 ≤ ‖iteratedFDeriv ℝ (n - i) g p‖ := norm_nonneg _
    have hc : (0:ℝ) ≤ n.choose i := Nat.cast_nonneg _
    exact mul_le_mul (mul_le_mul_of_nonneg_left h1 hc) h2 h0' (mul_nonneg hc (h0.trans h1))

  have hadd : ∀ f g : ℝ × ℝ → ℝ, osbGood W W f → osbGood W W g →
      osbGood W W (fun p => f p + g p) := by
    intro f g hf hg
    refine ⟨hf.1.add hg.1, fun n => ?_⟩
    obtain ⟨Cf, hCf⟩ := hf.2 n
    obtain ⟨Cg, hCg⟩ := hg.2 n
    refine ⟨Cf + Cg, fun p hp => ?_⟩
    have e : iteratedFDeriv ℝ n (fun p => f p + g p) p =
        iteratedFDeriv ℝ n f p + iteratedFDeriv ℝ n g p :=
      iteratedFDeriv_add_apply (hAt f hf.1 n p hp) (hAt g hg.1 n p hp)
    rw [e]
    exact (norm_add_le _ _).trans (add_le_add (hCf p hp) (hCg p hp))

  have hsub : ∀ f g : ℝ × ℝ → ℝ, osbGood W W f → osbGood W W g →
      osbGood W W (fun p => f p - g p) := by
    intro f g hf hg
    refine ⟨hf.1.sub hg.1, fun n => ?_⟩
    obtain ⟨Cf, hCf⟩ := hf.2 n
    obtain ⟨Cg, hCg⟩ := hg.2 n
    refine ⟨Cf + Cg, fun p hp => ?_⟩
    have e : iteratedFDeriv ℝ n (fun p => f p - g p) p =
        iteratedFDeriv ℝ n f p - iteratedFDeriv ℝ n g p :=
      iteratedFDeriv_sub_apply (hAt f hf.1 n p hp) (hAt g hg.1 n p hp)
    rw [e]
    exact (norm_sub_le _ _).trans (add_le_add (hCf p hp) (hCg p hp))

  have hinv : ∀ (f : ℝ × ℝ → ℝ) (c : ℝ), osbGood W W f → 0 < c →
      (∀ p ∈ W, c ≤ |f p|) → osbGood W W (fun p => (f p)⁻¹) := by
    intro f c hf hc hlow
    have hne : ∀ p ∈ W, f p ≠ 0 := fun p hp => abs_pos.mp (lt_of_lt_of_le hc (hlow p hp))
    have hsm : ContDiffOn ℝ ∞ (fun p => (f p)⁻¹) W := hf.1.inv hne
    refine ⟨hsm, fun n => ?_⟩
    choose A hA using hf.2
    have hgs : ContDiffOn ℝ ∞ (Inv.inv : ℝ → ℝ) ({0}ᶜ) := contDiffOn_inv ℝ
    have hgd : ∀ (i : ℕ) (y : ℝ),
        ‖iteratedFDeriv ℝ i (Inv.inv : ℝ → ℝ) y‖ = (i.factorial : ℝ) * (|y| ^ (i + 1))⁻¹ := by
      intro i y
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate, iter_deriv_inv]
      rw [show (-1 - (i:ℤ)) = -((i + 1 : ℕ) : ℤ) by push_cast; ring, zpow_neg, zpow_natCast]
      rw [norm_mul, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul, norm_inv, norm_pow,
        Real.norm_natCast, Real.norm_eq_abs]
    refine ⟨(n.factorial : ℝ) * ((n.factorial : ℝ) * (c⁻¹ + 1) ^ (n + 1)) *
      (1 + ∑ i ∈ Finset.range (n + 1), |A i|) ^ n, fun p hp => ?_⟩
    have hD1 : (1:ℝ) ≤ 1 + ∑ i ∈ Finset.range (n + 1), |A i| :=
      le_add_of_nonneg_right (Finset.sum_nonneg (fun i _ => abs_nonneg _))
    have hC : ∀ i ≤ n, ‖iteratedFDerivWithin ℝ i (Inv.inv : ℝ → ℝ) ({0}ᶜ) (f p)‖ ≤
        (n.factorial : ℝ) * (c⁻¹ + 1) ^ (n + 1) := by
      intro i hi
      rw [iteratedFDerivWithin_of_isOpen i isOpen_compl_singleton
        (show f p ∈ ({0}ᶜ : Set ℝ) from hne p hp), hgd i (f p)]
      have hfi : (i.factorial : ℝ) ≤ n.factorial := by exact_mod_cast Nat.factorial_le hi
      have hci : 0 ≤ c⁻¹ := inv_nonneg.2 hc.le
      have hy : (|f p| ^ (i + 1))⁻¹ ≤ (c⁻¹ + 1) ^ (n + 1) := by
        have h1 : (|f p| ^ (i + 1))⁻¹ ≤ (c ^ (i + 1))⁻¹ :=
          inv_anti₀ (pow_pos hc _) (pow_le_pow_left₀ hc.le (hlow p hp) _)
        have h2 : (c ^ (i + 1))⁻¹ = (c⁻¹) ^ (i + 1) := (inv_pow c (i + 1)).symm
        have h3 : (c⁻¹) ^ (i + 1) ≤ (c⁻¹ + 1) ^ (i + 1) :=
          pow_le_pow_left₀ hci (by linarith) _
        have h4 : (c⁻¹ + 1) ^ (i + 1) ≤ (c⁻¹ + 1) ^ (n + 1) :=
          pow_le_pow_right₀ (by linarith) (by omega)
        linarith
      exact mul_le_mul hfi hy (inv_nonneg.2 (pow_nonneg (abs_nonneg _) _)) (Nat.cast_nonneg _)
    have hD : ∀ i, 1 ≤ i → i ≤ n →
        ‖iteratedFDerivWithin ℝ i f W p‖ ≤ (1 + ∑ i ∈ Finset.range (n + 1), |A i|) ^ i := by
      intro i hi1 hin
      rw [hW f i p hp]
      have h1 := hA i p hp
      have h2 : |A i| ≤ ∑ j ∈ Finset.range (n + 1), |A j| :=
        Finset.single_le_sum (f := fun j => |A j|) (fun j _ => abs_nonneg _)
          (Finset.mem_range.2 (by omega))
      have h3 : (1 + ∑ j ∈ Finset.range (n + 1), |A j|) ≤
          (1 + ∑ j ∈ Finset.range (n + 1), |A j|) ^ i := le_self_pow₀ hD1 (by omega)
      linarith [le_abs_self (A i)]
    have hmaps : MapsTo f W ({0}ᶜ : Set ℝ) := fun p hp => hne p hp
    have key := norm_iteratedFDerivWithin_comp_le hgs hf.1 (hN n)
      isOpen_compl_singleton.uniqueDiffOn hWu hmaps hp hC hD
    rw [← hW _ n p hp]
    exact key

  have hcomp : ∀ (f : ℝ × ℝ → ℝ) (φ : ℝ → ℝ), osbGood W W f → ContDiff ℝ ∞ φ →
      osbGood W W (fun p => φ (f p)) := by
    intro f φ hf hφ
    refine ⟨hφ.comp_contDiffOn hf.1, fun n => ?_⟩
    obtain ⟨M, hM⟩ := hf.2 0
    have hfM : ∀ p ∈ W, f p ∈ Icc (-M) M := by
      intro p hp
      have h1 := hM p hp
      rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at h1
      exact abs_le.mp h1
    have hBex : ∀ i : ℕ, ∃ B : ℝ, ∀ y ∈ Icc (-M) M, ‖iteratedFDeriv ℝ i φ y‖ ≤ B :=
      fun i => isCompact_Icc.exists_bound_of_continuousOn
        (hφ.continuous_iteratedFDeriv (hN i)).continuousOn
    choose B hB using hBex
    choose A hA using hf.2
    refine ⟨(n.factorial : ℝ) * (∑ i ∈ Finset.range (n + 1), |B i|) *
      (1 + ∑ i ∈ Finset.range (n + 1), |A i|) ^ n, fun p hp => ?_⟩
    have hD1 : (1:ℝ) ≤ 1 + ∑ i ∈ Finset.range (n + 1), |A i| :=
      le_add_of_nonneg_right (Finset.sum_nonneg (fun i _ => abs_nonneg _))
    have hC : ∀ i ≤ n, ‖iteratedFDerivWithin ℝ i φ univ (f p)‖ ≤
        ∑ i ∈ Finset.range (n + 1), |B i| := by
      intro i hi
      rw [iteratedFDerivWithin_univ]
      have h1 := hB i (f p) (hfM p hp)
      have h2 : |B i| ≤ ∑ j ∈ Finset.range (n + 1), |B j| :=
        Finset.single_le_sum (f := fun j => |B j|) (fun j _ => abs_nonneg _)
          (Finset.mem_range.2 (by omega))
      linarith [le_abs_self (B i)]
    have hD : ∀ i, 1 ≤ i → i ≤ n →
        ‖iteratedFDerivWithin ℝ i f W p‖ ≤ (1 + ∑ i ∈ Finset.range (n + 1), |A i|) ^ i := by
      intro i hi1 hin
      rw [hW f i p hp]
      have h1 := hA i p hp
      have h2 : |A i| ≤ ∑ j ∈ Finset.range (n + 1), |A j| :=
        Finset.single_le_sum (f := fun j => |A j|) (fun j _ => abs_nonneg _)
          (Finset.mem_range.2 (by omega))
      have h3 : (1 + ∑ j ∈ Finset.range (n + 1), |A j|) ≤
          (1 + ∑ j ∈ Finset.range (n + 1), |A j|) ^ i := le_self_pow₀ hD1 (by omega)
      linarith [le_abs_self (A i)]
    have key := norm_iteratedFDerivWithin_comp_le hφ.contDiffOn hf.1 (hN n)
      uniqueDiffOn_univ hWu (mapsTo_univ _ _) hp hC hD
    rw [← hW _ n p hp]
    exact key

  have hglob : ∀ φ : ℝ × ℝ → ℝ, ContDiff ℝ ∞ φ → osbGood W W φ := by
    intro φ hφ
    refine ⟨hφ.contDiffOn, fun m => ?_⟩
    obtain ⟨C, hC⟩ := hWb.isCompact_closure.exists_bound_of_continuousOn
      (hφ.continuous_iteratedFDeriv (hN m)).continuousOn
    exact ⟨C, fun p hp => hC p (subset_closure hp)⟩

  have hpart : ∀ (f : ℝ × ℝ → ℝ) (v : ℝ × ℝ), osbGood W W f →
      osbGood W W (fun p => fderiv ℝ f p v) := by
    intro f v hf
    have hfd : ContDiffOn ℝ ∞ (fderiv ℝ f) W := hf.1.fderiv_of_isOpen hWo (le_of_eq rfl)
    have hfun : (fun p => fderiv ℝ f p v) =
        ⇑(ContinuousLinearMap.apply ℝ ℝ v : (ℝ × ℝ →L[ℝ] ℝ) →L[ℝ] ℝ) ∘ fderiv ℝ f := rfl
    refine ⟨?_, fun n => ?_⟩
    · rw [hfun]
      exact (ContinuousLinearMap.apply ℝ ℝ v : (ℝ × ℝ →L[ℝ] ℝ) →L[ℝ] ℝ).contDiff.comp_contDiffOn hfd
    · obtain ⟨C, hC⟩ := hf.2 (n + 1)
      refine ⟨‖(ContinuousLinearMap.apply ℝ ℝ v : (ℝ × ℝ →L[ℝ] ℝ) →L[ℝ] ℝ)‖ * C, fun z hz => ?_⟩
      rw [hfun]
      have hAtz : ContDiffAt ℝ ∞ (fderiv ℝ f) z := hfd.contDiffAt (hWo.mem_nhds hz)
      refine ((ContinuousLinearMap.apply ℝ ℝ v : (ℝ × ℝ →L[ℝ] ℝ) →L[ℝ] ℝ).norm_iteratedFDeriv_comp_left
        hAtz (hN n)).trans ?_
      rw [norm_iteratedFDeriv_fderiv]
      exact mul_le_mul_of_nonneg_left (hC z hz) (norm_nonneg _)

  have hres : ∀ (V : Set (ℝ × ℝ)) (f : ℝ × ℝ → ℝ), IsOpen V → V ⊆ W → osbGood W W f →
      osbGood V V f := fun V f _ hVW hf =>
    ⟨hf.1.mono hVW, fun m => (hf.2 m).imp (fun C hC z hz => hC z (hVW hz))⟩
  exact ⟨hmul, hadd, hsub, hinv, hcomp, hglob, fun f hf => ⟨hpart f (0, 1) hf, hpart f (1, 0) hf⟩,
    hres⟩

theorem ax_ff_box_reg : ∀ (h j0 σ δ Λ C K ρ1 t1 κ0 : ℝ) (Pax : ℝ → ℝ) (Kder : ℕ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 1 ≤ Λ → 0 < ρ1 → 0 < t1 → t1 ≤ 1 / 100 → 0 < κ0 → κ0 < 1 / 2 → AxAxisOut h j0 σ δ Pax Λ C K ρ1 Kder Fn Un → osbGood (Ioo (3 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1) 1) (Ioo (3 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1) 1) (fun p => Fn p.1 p.2) ∧ osbGood (Ioo (3 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1) 1) (Ioo (3 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1) 1) (fun p => (Fn p.1 p.2)⁻¹) ∧ osbGood (Ioo (3 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1) 1) (Ioo (3 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1) 1) (fun p => deriv (fun Y => Fn Y p.2) p.1) ∧ osbGood (Ioo (3 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1) 1) (Ioo (3 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1) 1) (fun p => Un p.1 p.2) ∧ osbGood (Ioo (3 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1) 1) (Ioo (3 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1) 1) (fun p => deriv (fun Y => Un Y p.2) p.1) ∧ osbGood (Ioo (3 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1) 1) (Ioo (3 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1) 1) (fun p => axEa Λ t1 κ0 p.1) ∧ (∃ m : ℝ, 0 < m ∧ ∀ X η : ℝ, 3 / Λ < X → X < 41 / (10 * Λ) → -1 < η → η < 1 → m ≤ Fn X η) ∧ (∀ X : ℝ, 0 ≤ axEa Λ t1 κ0 X ∧ axEa Λ t1 κ0 X ≤ 1) ∧ (∀ g : ℝ → ℝ → ℝ, (g = Un ∨ g = (fun x e => 2 * x * Fn x e) ∨ g = (fun x e => Un x e * (2 * x * Fn x e)) ∨ g = (fun x e => Un x e ^ 2 - x * Fn x e ^ 2) ∨ g = (fun x e => Fn x e ^ 2)) → osbGood (Ioo (4 / Λ) (4 / Λ * Real.exp (t1 / 2)) ×ˢ Ioo (-1) 1) (Ioo (4 / Λ) (4 / Λ * Real.exp (t1 / 2)) ×ˢ Ioo (-1) 1) (fun p => profRadInt g p.1 p.2) ∧ osbGood (Ioo (4 / Λ) (4 / Λ * Real.exp (t1 / 2)) ×ˢ Ioo (-1) 1) (Ioo (4 / Λ) (4 / Λ * Real.exp (t1 / 2)) ×ˢ Ioo (-1) 1) (fun p => profEtaD (profRadInt g) p.1 p.2) ∧ ∀ X η : ℝ, 4 / Λ < X → X < 4 / Λ * Real.exp (t1 / 2) → -1 < η → η < 1 → DifferentiableAt ℝ (fun e => profRadInt g X e) η) :=
by
  intro h j0 σ δ Λ C K ρ1 t1 κ0 Pax Kder Fn Un hΛ hρ1 ht1 ht1' hκ0 hκ0' hA
  have hΛ0 : 0 < Λ := by linarith

  have s1 : ∀ (O Kc W S : Set (ℝ × ℝ)) (f : ℝ × ℝ → ℝ), IsOpen O → IsCompact Kc → Kc ⊆ O →
      W ⊆ O → S ⊆ Kc → ContDiffOn ℝ ∞ f O → osbGood W S f := by
    intro O Kc W S f hO hK hKO hWO hSK hf
    refine ⟨hf.mono hWO, fun m => ?_⟩
    have h1 : ContinuousOn (iteratedFDerivWithin ℝ m f O) O :=
      hf.continuousOn_iteratedFDerivWithin (by exact_mod_cast le_top) hO.uniqueDiffOn
    have h2 : ContinuousOn (iteratedFDeriv ℝ m f) O :=
      h1.congr (fun x hx => (iteratedFDerivWithin_of_isOpen m hO hx).symm)
    obtain ⟨C0, hC0⟩ := hK.exists_bound_of_continuousOn (h2.mono hKO)
    exact ⟨C0, fun z hz => hC0 z (hSK hz)⟩

  have s2 : ∀ (O : Set (ℝ × ℝ)) (F : ℝ → ℝ → ℝ), IsOpen O →
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => F p.1 p.2) O →
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => deriv (fun Y => F Y p.2) p.1) O ∧
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => deriv (fun e => F p.1 e) p.2) O ∧
      ∀ p ∈ O, DifferentiableAt ℝ (fun e => F p.1 e) p.2 := by
    intro O F hO hF
    have hd : ContDiffOn ℝ ∞ (fderiv ℝ (fun p : ℝ × ℝ => F p.1 p.2)) O :=
      hF.fderiv_of_isOpen hO (by simp)
    have hfd : ∀ p ∈ O, HasFDerivAt (fun p : ℝ × ℝ => F p.1 p.2)
        (fderiv ℝ (fun p : ℝ × ℝ => F p.1 p.2) p) p :=
      fun p hp => ((hF.contDiffAt (hO.mem_nhds hp)).differentiableAt (by norm_num)).hasFDerivAt
    have hX : ∀ p ∈ O, HasDerivAt (fun Y => F Y p.2)
        (fderiv ℝ (fun p : ℝ × ℝ => F p.1 p.2) p ((1 : ℝ), (0 : ℝ))) p.1 := by
      rintro ⟨X, η⟩ hp
      have h1 : HasDerivAt (fun Y : ℝ => (Y, η)) ((1 : ℝ), (0 : ℝ)) X :=
        (hasDerivAt_id X).prodMk (hasDerivAt_const X η)
