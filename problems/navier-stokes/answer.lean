theorem pulse_path_geom_v5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl), 0 < G.r0 → G.r0 ≤ 1/100 → |xiG B.h γ (G.ctr γ) ξ.2.2.2| ≤ G.r0 / 4 → 0 ≤ vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 → vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 ≤ Lsb B.h G.r0 γ.1 → ∃ W : Set Cyl, IsOpen W ∧ ξ ∈ W ∧ ContDiffOn ℝ ∞ (fun p : Cyl => vco B.h G.r0 γ (G.ctr γ) p.2.2.2) W ∧ (∀ p ∈ W, |xiG B.h γ (G.ctr γ) p.2.2.2| < G.r0 / 2) ∧ ∀ p ∈ W, ∀ v : ℝ, -(Lsb B.h G.r0 γ.1 / 2) < v → v < 3 * Lsb B.h G.r0 γ.1 / 2 → |xiG B.h γ (G.ctr γ) (pulsePth5 B G γ p v).2.2.2| < 1/8 ∧ |etG B.h γ (G.ctr γ) (pulsePth5 B G γ p v).2.2.2| < 1/8 ∧ vco B.h G.r0 γ (G.ctr γ) (pulsePth5 B G γ p v).2.2.2 = v :=
by
  intro B G γ ξ hr0 hr0le hxi hv0 hvL
  have hTgc : 0 < Tgc := by unfold Tgc; positivity
  have hcb : 0 < cib B.h γ.1 :=
    mul_pos (zpow_pos hTgc _) (Real.rpow_pos_of_pos (by unfold Qb; positivity) _)
  have hcbne : cib B.h γ.1 ≠ 0 := hcb.ne'
  have hIv : ∀ Y : ℝ × ℝ, vco B.h G.r0 γ (G.ctr γ) Y * cib B.h γ.1 = etG B.h γ (G.ctr γ) Y + G.r0 :=
    fun Y => by unfold vco; rw [div_mul_cancel₀ _ hcbne]
  have hIL : Lsb B.h G.r0 γ.1 * cib B.h γ.1 = 2 * G.r0 := by
    unfold Lsb; rw [div_mul_cancel₀ _ hcbne]
  obtain ⟨hA, -, hC, -⟩ := pulse_rect_path_v5 B.h G.r0 γ (G.ctr γ) hr0 hr0le

  have hv0' : 0 ≤ vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 * cib B.h γ.1 := mul_nonneg hv0 hcb.le
  have hvL' : vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 * cib B.h γ.1 ≤ 2 * G.r0 := by
    rw [← hIL]; exact mul_le_mul_of_nonneg_right hvL hcb.le
  rw [hIv] at hv0' hvL'
  have hxi2 : |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 2 * G.r0 := by linarith
  have het2 : |etG B.h γ (G.ctr γ) ξ.2.2.2| < 2 * G.r0 := by
    rw [abs_lt]; constructor <;> linarith
