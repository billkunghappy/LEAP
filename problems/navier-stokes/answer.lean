  intro h η P c k hP H1 H2 H3 H4 H5 X hX
  have he3 : Real.exp 1 < 3 := lt_trans Real.exp_one_lt_d9 (by norm_num)
  have he1 : 1 ≤ Real.exp 1 := Real.one_le_exp (by norm_num)
  have hM : ∀ Y : ℝ, 0 < Y → Y ≤ Real.exp 1 → rinMom (fun x => k (Real.log x)) Y = 4 * Y := by
    intro Y hY hYe
    unfold rinMom
    rw [intervalIntegral.integral_congr (g := fun _ => (4:ℝ)) ?_]
    · rw [intervalIntegral.integral_const, smul_eq_mul]; ring
    · intro x hx
      rw [Set.uIcc_of_le hY.le] at hx
      exact H4 x hx.1 (hx.2.trans hYe)
  have hJ : ∀ Y : ℝ, 0 < Y → Y ≤ Real.exp 1 →
      rinMom (fun x => k (Real.log x) * (Real.sqrt (2 * x) * c (Real.log x))) Y
        = 4 * rinMom (fun x => Real.sqrt (2 * x) * c (Real.log x)) Y := by
    intro Y hY hYe
    unfold rinMom
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr
    intro x hx
    rw [Set.uIcc_of_le hY.le] at hx
    simp only
    rw [H4 x hx.1 (hx.2.trans hYe)]
