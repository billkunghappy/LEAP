    intro z hz0 hz1
    obtain ⟨hxa, hxb⟩ := hXz z hz0 (by linarith)
    have hx0 : 0 < 4 / Λ * Real.exp z := lt_of_lt_of_le hΛ4 hxa
    have hxX1 : 4 / Λ * Real.exp z ≤ 4 / Λ * Real.exp t1 :=
