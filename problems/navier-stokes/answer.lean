        have hX : 0 ≤ qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ b :=
          mul_nonneg (Real.rpow_nonneg (hDq ξ hξ).1.le _) (Real.rpow_nonneg (by unfold SC; positivity) _)
        have h3 : C * qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ b ≤
