  ring

theorem ax_prof_integral_bounds : ∀ (h j0 σ Λ C K ρ1 t1 κ0 om r : ℝ) (Pax : ℝ → ℝ) (M : ℕ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 1 ≤ Λ → 0 < ρ1 → 0 < t1 → t1 ≤ 1 / 100 → 0 < κ0 → κ0 ≤ 1 → 0 < om → 0 < r → AxRefPI h j0 σ Pax Λ C K ρ1 M (axRefF Λ t1 Fn) (axRefU Λ t1 Un) → ContDiffOn ℝ ∞ (↿(axShearA h Λ t1 κ0 om Fn Un)) (univ ×ˢ Ioo (-1 - r) (1 + r)) → ContDiffOn ℝ ∞ (↿(axSlopeU h Λ t1 κ0 om Pax Fn Un)) (univ ×ˢ Ioo (-1 - r) (1 + r)) → ∀ X η : ℝ, 4 / Λ < X → X ≤ 110 → -1 < η → η < 1 → |∫ y in (0:ℝ)..axLogY Λ X, axShearA h Λ t1 κ0 om Fn Un y η| ≤ (|M 0| + 1) * Real.log (110 * Λ / 4) ∧ |∫ y in (0:ℝ)..axLogY Λ X, axSlopeU h Λ t1 κ0 om Pax Fn Un y η| ≤ (t1 + κ0 * Real.log (110 * Λ / 4)) * |M 0| / 2 ∧ HasDerivAt (fun e => ∫ y in (0:ℝ)..axLogY Λ X, axShearA h Λ t1 κ0 om Fn Un y e) (∫ y in (0:ℝ)..axLogY Λ X, deriv (fun e => axShearA h Λ t1 κ0 om Fn Un y e) η) η ∧ |∫ y in (0:ℝ)..axLogY Λ X, deriv (fun e => axShearA h Λ t1 κ0 om Fn Un y e) η| ≤ (t1 + κ0 * Real.log (110 * Λ / 4)) * |M 1| ∧ HasDerivAt (fun e => ∫ y in (0:ℝ)..axLogY Λ X, axSlopeU h Λ t1 κ0 om Pax Fn Un y e) (∫ y in (0:ℝ)..axLogY Λ X, deriv (fun e => axSlopeU h Λ t1 κ0 om Pax Fn Un y e) η) η ∧ |∫ y in (0:ℝ)..axLogY Λ X, deriv (fun e => axSlopeU h Λ t1 κ0 om Pax Fn Un y e) η| ≤ (t1 + κ0 * Real.log (110 * Λ / 4)) * |M 1| / 2 :=
by
  intro h j0 σ Λ C K ρ1 t1 κ0 om r Pax M Fn Un hΛ hρ1 ht1 ht1' hκ0 hκ1 hom hr hRef hSA hSU
    X η hX hX1 hη1 hη2
  have hΛ0 : 0 < Λ := by linarith

  have hparam : ∀ (G : ℝ → ℝ → ℝ) (c d a b : ℝ), ContDiffOn ℝ ∞ (↿G) (univ ×ˢ Ioo c d) →
      c < η → η < d → Continuous (fun y => G y η) ∧ Continuous (fun y => deriv (fun e => G y e) η) ∧
      HasDerivAt (fun e => ∫ y in a..b, G y e) (∫ y in a..b, deriv (fun e => G y e) η) η := by
    intro G c d a b hG hc hd
    have hW : IsOpen (univ ×ˢ Ioo c d : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioo
    have hslice : ∀ x ∈ Ioo c d, Continuous (fun y => G y x) := by
      intro x hx
      exact hG.continuousOn.comp_continuous (continuous_id.prodMk continuous_const)
        (fun y => ⟨mem_univ _, hx⟩)
    have hpd : ∀ y x, x ∈ Ioo c d →
        HasDerivAt (fun e => G y e) (fderiv ℝ (↿G) (y, x) ((0:ℝ), (1:ℝ))) x := by
      intro y x hx
      have hdf : DifferentiableAt ℝ (↿G) (y, x) :=
        (hG.contDiffAt (hW.mem_nhds ⟨mem_univ _, hx⟩)).differentiableAt (by simp)
      have hcv : HasDerivAt (fun e : ℝ => (y, e)) ((0:ℝ), (1:ℝ)) x :=
        (hasDerivAt_const x y).prodMk (hasDerivAt_id x)
      exact hdf.hasFDerivAt.comp_hasDerivAt x hcv
    have hfc : ContinuousOn (fderiv ℝ (↿G)) (univ ×ˢ Ioo c d) :=
      hG.continuousOn_fderiv_of_isOpen hW (by simp)
    have hηm : η ∈ Ioo c d := ⟨hc, hd⟩
    have hderc : Continuous (fun y => deriv (fun e => G y e) η) := by
      have h1 : Continuous (fun y => fderiv ℝ (↿G) (y, η)) :=
        hfc.comp_continuous (continuous_id.prodMk continuous_const) (fun y => ⟨mem_univ _, hηm⟩)
      have h2 : Continuous (fun y => fderiv ℝ (↿G) (y, η) ((0:ℝ), (1:ℝ))) :=
        h1.clm_apply continuous_const
      have h3 : (fun y => deriv (fun e => G y e) η) =
          (fun y => fderiv ℝ (↿G) (y, η) ((0:ℝ), (1:ℝ))) := by
        funext y; exact (hpd y η hηm).deriv
      rw [h3]; exact h2
    refine ⟨hslice η hηm, hderc, ?_⟩
    obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = min (η - c) (d - η) / 2 := ⟨_, rfl⟩
    have hm1 : min (η - c) (d - η) ≤ η - c := min_le_left _ _
    have hm2 : min (η - c) (d - η) ≤ d - η := min_le_right _ _
    have hm0 : 0 < min (η - c) (d - η) := lt_min (by linarith) (by linarith)
    have hδ0 : 0 < δ := by rw [hδ]; linarith
    have hsub : Icc (η - δ) (η + δ) ⊆ Ioo c d :=
      Icc_subset_Ioo (by rw [hδ]; linarith) (by rw [hδ]; linarith)
    have hK : IsCompact (uIcc a b ×ˢ Icc (η - δ) (η + δ)) := isCompact_uIcc.prod isCompact_Icc
    obtain ⟨Cb, hCb⟩ := hK.exists_bound_of_continuousOn
      (hfc.mono (prod_mono (subset_univ _) hsub))
    have hs : Ioo (η - δ) (η + δ) ∈ nhds η :=
      Ioo_mem_nhds (show η - δ < η by linarith) (show η < η + δ by linarith)
    have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume)
      (F := fun x t => G t x) (F' := fun x t => deriv (fun e => G t e) x) (x₀ := η)
      (bound := fun _ => Cb) (a := a) (b := b) hs ?_ ?_ ?_ ?_ ?_ ?_
    · exact key.2
    · filter_upwards [hs] with x hx
      exact (hslice x (hsub ⟨hx.1.le, hx.2.le⟩)).aestronglyMeasurable
    · exact (hslice η hηm).intervalIntegrable a b
    · exact hderc.aestronglyMeasurable
    · refine ae_of_all _ (fun t ht x hx => ?_)
      have hxm : x ∈ Ioo c d := hsub ⟨hx.1.le, hx.2.le⟩
      show ‖deriv (fun e => G t e) x‖ ≤ Cb
      rw [(hpd t x hxm).deriv]
      have hb := hCb (t, x) ⟨Set.uIoc_subset_uIcc ht, hx.1.le, hx.2.le⟩
      calc ‖fderiv ℝ (↿G) (t, x) ((0:ℝ), (1:ℝ))‖
          ≤ ‖fderiv ℝ (↿G) (t, x)‖ * ‖((0:ℝ), (1:ℝ))‖ := ContinuousLinearMap.le_opNorm _ _
