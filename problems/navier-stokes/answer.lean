          push Not at hc
          exact hx.2 ⟨hc.1, hc.2.le⟩
        simp [(hV p hp.2 x hx0 hor).1]
    refine ⟨hM, ?_⟩
    apply contDiffOn_of_locally_contDiffOn
    intro x0 hx0
    obtain ⟨V, hVo, hp0V, hVU, ρ0, ρ1, hρ0, hρ01, hV⟩ := hsupp x0.2 hx0.2
    set b := max x0.1 ρ1 + 1 with hb
