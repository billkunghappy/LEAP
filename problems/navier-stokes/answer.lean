    ring
  have hEl : Real.exp (rfpLam P y) = rinC P.Md P.Pst P.lam y := by
    rw [hLam, Real.exp_add, Real.exp_log hPst0]
    rfl
  have hF : rfpF P x η = rinC P.Md P.Pst P.lam y * (1 + η ^ 2)⁻¹ / Real.sqrt (2 * x) := by
    have hTh1 : rfpTh P y = 1 := by
      unfold rfpTh
      rw [hs0 ((y - rfpY4 P.Md P.lam) / 60)
        (by rw [div_le_iff₀ (by norm_num : (0:ℝ) < 60)]; linarith), sub_zero]
    have hPsi : rfpPsi P y = 0 := by
