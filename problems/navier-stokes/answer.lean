    rintro a ⟨X, η⟩ ⟨-, hη⟩
    by_cases hX : X < XR
    · exact Or.inl ⟨mem_Iio.mpr hX, hη⟩
    · exact Or.inr ⟨mem_Ioi.mpr (lt_of_lt_of_le hXh1R (not_lt.mp hX)), hη⟩

  have hS1 : ∀ (m : ℕ) (X η : ℝ), X < XR → -1 < η → η < 1 →
      iteratedFDeriv ℝ m (↿F) (X, η) = iteratedFDeriv ℝ m (↿Fi) (X, η) ∧
      iteratedFDeriv ℝ m (↿U) (X, η) = iteratedFDeriv ℝ m (↿Ui) (X, η) := by
    intro m X η hX h1 h2
    have hmem : Iio XR ×ˢ Ioo (-1 : ℝ) 1 ∈ nhds (X, η) := hB1o.mem_nhds ⟨hX, h1, h2⟩
    have hev1 : (↿F) =ᶠ[nhds (X, η)] (↿Fi) :=
      Filter.eventuallyEq_of_mem hmem (fun z hz => hFin z.1 z.2 (mem_Iio.mp hz.1))
    have hev2 : (↿U) =ᶠ[nhds (X, η)] (↿Ui) :=
      Filter.eventuallyEq_of_mem hmem (fun z hz => hUin z.1 z.2 (mem_Iio.mp hz.1))
    exact ⟨(hev1.iteratedFDeriv ℝ m).eq_of_nhds, (hev2.iteratedFDeriv ℝ m).eq_of_nhds⟩
  have hS2 : ∀ (m : ℕ) (X η : ℝ), Xh1 < X → -1 < η → η < 1 →
      iteratedFDeriv ℝ m (↿F) (X, η) = iteratedFDeriv ℝ m (↿Fo) (X, η) ∧
      iteratedFDeriv ℝ m (↿U) (X, η) = iteratedFDeriv ℝ m (↿Uo) (X, η) := by
    intro m X η hX h1 h2
    have hmem : Ioi Xh1 ×ˢ Ioo (-1 : ℝ) 1 ∈ nhds (X, η) := hB2o.mem_nhds ⟨hX, h1, h2⟩
    have hev1 : (↿F) =ᶠ[nhds (X, η)] (↿Fo) :=
      Filter.eventuallyEq_of_mem hmem
        (fun z hz => (hagree z.1 z.2 (mem_Ioi.mp hz.1) hz.2.1 hz.2.2).1)
    have hev2 : (↿U) =ᶠ[nhds (X, η)] (↿Uo) :=
      Filter.eventuallyEq_of_mem hmem
        (fun z hz => (hagree z.1 z.2 (mem_Ioi.mp hz.1) hz.2.1 hz.2.2).2)
    exact ⟨(hev1.iteratedFDeriv ℝ m).eq_of_nhds, (hev2.iteratedFDeriv ℝ m).eq_of_nhds⟩

  have hFSε : ContDiffOn ℝ ∞ (↿F) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) :=
    two_patch (↿F) (↿Fi) (↿Fo) _ _ _ _ _ hB1o hB2o (hcover (-ε)) hFiS hFoS inter_subset_left
      (by
        rintro ⟨X, η⟩ ⟨-, ⟨hX, hη⟩⟩
