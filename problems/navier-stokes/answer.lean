import Mathlib
set_option maxHeartbeats 4000000

/-!
# Existence And Smoothness Of The Navier–Stokes Equation

Standalone comparator copied from:
https://github.com/google-deepmind/formal-conjectures/blob/8bf45ed70d48b2b2a501de9c00b26bfa38c573ee/FormalConjectures/Millenium/NavierStokes.lean

The upstream definitions, helper proofs, and breakdown alternatives (C) and (D)
are retained, including their intentional `sorry` challenge placeholders. The
imports, metadata attributes, namespace, and local notation are adapted for this
project. All utility dependencies are inlined; only Mathlib is imported.
Neither the proof root nor the submission imports this reference.

This file formalizes the Clay Mathematics Institute millennium problem concerning
the existence and smoothness of solutions to the Navier-Stokes equations in three
spatial dimensions. While the definitions are generalized to arbitrary dimension n,
the millennium problem specifically concerns the case n = 3.

## References
- [Wikipedia](https://en.wikipedia.org/wiki/Navier%E2%80%93Stokes_existence_and_smoothness)

## Main Theorems (Clay Millennium Problem for n = 3)

This reference states the two breakdown alternatives as a single conjunction:
- `navier_stokes_breakdown`: (C) Existence of breakdown scenario on ℝ³ **and**
  (D) Existence of breakdown scenario on ℝ³/ℤ³

## Variable conventions

Fefferman writes the velocity as $u(x,t)$, the initial velocity as $u^\circ(x)$, the
pressure as $p(x,t)$, the force as $f(x,t)$, and the viscosity as $\nu$. In Lean,
`u₀ : ℝ^n → ℝ^n` denotes the initial velocity, while `v : ℝ^n → ℝ → ℝ^n`
denotes the solution velocity. The curried order `v x t`, `p x t`, and `f x t`
keeps the source convention that position comes before time.

Since the Clay statement gives equation (1) on the closed time half-line $t \ge 0$,
the time derivative is encoded with `derivWithin` relative to `Set.Ici 0`.
-/

open ContDiff Set InnerProductSpace MeasureTheory
open scoped Laplacian

namespace NavierStokes.Comparator

-- Inlined notation from FormalConjecturesForMathlib.Geometry.Euclidean and Geometry.«3d».
local notation "ℝ^" n:65 => EuclideanSpace ℝ (Fin n)
local notation "ℝ³" => EuclideanSpace ℝ (Fin 3)

variable {n : ℕ}

/--
The divergence $\nabla \cdot v$ of a vector field $v : \mathbb{R}^n \to \mathbb{R}^n$
at a point $x$, computed as the trace of the Jacobian matrix.

In coordinates, $\nabla \cdot v = \sum_i \partial v_i / \partial x_i$.

This is available as the notation `∇⬝ v`. If `v` is not differentiable at `x`, then
`fderiv` is the zero map, so this definition has the corresponding junk value $0$.
-/
noncomputable
def divergence (v : ℝ^n → ℝ^n) (x : ℝ^n) : ℝ := (fderiv ℝ v x).trace ℝ (ℝ^n)

@[inherit_doc]
local notation "∇⬝" => divergence

/-- The divergence of a vector field is $0$ at points where `fderiv` has its junk value. -/
@[simp]
theorem divergence_of_not_differentiableAt {v : ℝ^n → ℝ^n} {x : ℝ^n}
    (hv : ¬ DifferentiableAt ℝ v x) : ∇⬝ v x = 0 := by
  simp [divergence, fderiv_zero_of_not_differentiableAt hv]

/-- The divergence of the zero vector field is zero. -/
@[simp]
theorem divergence_zero (x : ℝ^n) : ∇⬝ (0 : ℝ^n → ℝ^n) x = 0 := by
  simp [divergence]

/-- The divergence of a constant vector field is zero. -/
@[simp]
theorem divergence_const (c : ℝ^n) (x : ℝ^n) :
    ∇⬝ (fun _ : ℝ^n => c) x = 0 := by
  simp [divergence]

/-- Divergence is additive at points where both vector fields are differentiable. -/
theorem divergence_add {v w : ℝ^n → ℝ^n} {x : ℝ^n}
    (hv : DifferentiableAt ℝ v x) (hw : DifferentiableAt ℝ w x) :
    ∇⬝ (fun y => v y + w y) x = ∇⬝ v x + ∇⬝ w x := by
  rw [divergence, fderiv_fun_add hv hw]
  exact map_add _ _ _

/-- Divergence commutes with scalar multiplication at differentiability points. -/
theorem divergence_smul (c : ℝ) {v : ℝ^n → ℝ^n} {x : ℝ^n}
    (hv : DifferentiableAt ℝ v x) : ∇⬝ (fun y => c • v y) x = c * ∇⬝ v x := by
  rw [divergence, fderiv_fun_const_smul hv c]
  simp [divergence]

/--
A function $f : \mathbb{R}^n \to \alpha$ is 1-periodic if it is periodic in each
coordinate with period $1$, i.e. $f(x + e_i) = f(x)$ for each unit vector $e_i$.
This captures functions on the $n$-torus $\mathbb{R}^n/\mathbb{Z}^n$.
-/
def IsOnePeriodic {α : Sort*} (f : ℝ^n → α) : Prop :=
  ∀ x i, f (x + EuclideanSpace.single i 1) = f x

/--
Basic conditions on initial velocity field for the Navier-Stokes equations
in $n$-dimensional space.

The initial velocity must be:
- Divergence-free (incompressibility condition: $\nabla \cdot u_0 = 0$)
- Smooth ($C^\infty$)

These conditions apply regardless of spatial dimension.
-/
structure InitialVelocityCondition (u₀ : ℝ^n → ℝ^n) : Prop where
  /-- The initial velocity field is divergence-free (equation 2).
      This is the incompressibility constraint for the fluid. -/
  div_free : ∀ x, ∇⬝ u₀ x = 0
  /-- The initial velocity field is smooth ($C^\infty$ in all variables). -/
  smooth : ContDiff ℝ ∞ u₀

/--
Initial velocity conditions for the Navier-Stokes problem on all of $\mathbb{R}^n$.

In addition to being smooth and divergence-free, the velocity must decay
faster than any polynomial at spatial infinity (condition 4 in Fefferman's paper).

This condition ensures the velocity field has finite energy and reasonable
behavior as $\lVert x \rVert \to \infty$.
-/
structure InitialVelocityConditionDecay (u₀ : ℝ^n → ℝ^n) : Prop extends
    InitialVelocityCondition u₀ where
  /-- All derivatives of u₀ decay faster than any polynomial (condition 4).
  For any derivative order $m$ and any decay rate $K$, there exists a constant $C$
  such that $\lVert \partial^m u_0(x) \rVert \le C/(1+\lVert x \rVert)^K$. -/
  decay : ∀ m : ℕ, ∀ K : ℝ, ∃ C : ℝ, ∀ x, ‖iteratedFDeriv ℝ m u₀ x‖ ≤ C / (1 + ‖x‖) ^ K

/--
Initial velocity conditions for the periodic Navier-Stokes problem on
$\mathbb{R}^n/\mathbb{Z}^n$.

The velocity must be smooth, divergence-free, and 1-periodic in each coordinate
(condition 8, part 1 in Fefferman's paper).
-/
structure InitialVelocityConditionPeriodic (u₀ : ℝ^n → ℝ^n) : Prop extends
    InitialVelocityCondition u₀ where
  /-- The initial velocity is 1-periodic in each direction (condition 8, part 1). -/
  isOnePeriodic : IsOnePeriodic u₀

/--
The basic smoothness condition on the external forcing term.

The force $f(x,t)$ must be smooth ($C^\infty$) in both space and time variables
for $t \ge 0$.
-/
structure ForceCondition (f : ℝ^n → ℝ → ℝ^n) : Prop where
  /-- The force is smooth on $\mathbb{R}^n \times [0,\infty)$. -/
  smooth : ContDiffOn ℝ ∞ (↿f) (Set.univ ×ˢ Set.Ici 0)

/--
Force conditions for the Navier-Stokes problem on all of $\mathbb{R}^n$.

The force must be smooth and decay faster than any polynomial
in both space and time (condition 5 in Fefferman's paper).
-/
structure ForceConditionDecay (f : ℝ^n → ℝ → ℝ^n) : Prop extends ForceCondition f where
  /-- All derivatives of f decay faster than any polynomial in space and time (condition 5).
  For any derivative order $m$ and any decay rate $K$, there exists $C$ such that
  $\lVert \partial^m_{x,t} f(x,t) \rVert \le C/(1+\lVert x \rVert+t)^K$ for
  $t \ge 0$. -/
  decay : ∀ m : ℕ, ∀ K : ℝ, ∃ C : ℝ, ∀ x, ∀ t ≥ 0,
    ‖iteratedFDerivWithin ℝ m (↿f) (Set.univ ×ˢ Set.Ici 0) (x, t)‖ ≤ C / (1 + ‖x‖ + t) ^ K

/--
Force conditions for the periodic Navier-Stokes problem on
$\mathbb{R}^n/\mathbb{Z}^n$.

The force must be smooth, 1-periodic in space, and decay in time
(conditions 8, part 1 and 9 in Fefferman's paper).
-/
structure ForceConditionPeriodic (f : ℝ^n → ℝ → ℝ^n) : Prop extends ForceCondition f where
  /-- The force is 1-periodic in space for all times $t \ge 0$ (condition 8, part 1). -/
  isOnePeriodic : ∀ t ≥ 0, IsOnePeriodic (f · t)
  /-- All derivatives of f decay faster than any polynomial in time (condition 9). -/
  decay : ∀ m : ℕ, ∀ K : ℝ, ∃ C : ℝ, ∀ x, ∀ t ≥ 0,
    ‖iteratedFDerivWithin ℝ m (↿f) (Set.univ ×ˢ Set.Ici 0) (x, t)‖ ≤ C / (1 + t) ^ K

/--
A solution (v, p) to the Navier-Stokes equations in n-dimensional space
with viscosity $\nu$, initial velocity $u_0$, and external force $f$.

This structure captures the core requirements for a solution:
1. The velocity and pressure satisfy the Navier-Stokes PDE (equation 1)
2. The velocity remains divergence-free for all time (equation 2)
3. The initial condition is satisfied (equation 3)
4. The solution is smooth ($C^\infty$) for all time $t \ge 0$ (equations 6, 11)
-/
structure NavierStokesExistenceAndSmoothness
    (nu : ℝ) (u₀ : ℝ^n → ℝ^n) (f : ℝ^n → ℝ → ℝ^n)
    (v : ℝ^n → ℝ → ℝ^n) (p : ℝ^n → ℝ → ℝ) : Prop where
  /-- The Navier-Stokes equation (equation 1):
  $\partial v/\partial t + (v \cdot \nabla)v = \nu\Delta v - \nabla p + f$. -/
  navier_stokes : ∀ x, ∀ t ≥ 0,
    derivWithin (v x ·) (Set.Ici 0) t + fderiv ℝ (v · t) x (v x t) =
      nu • Δ (v · t) x - gradient (p · t) x + f x t
  /-- Incompressibility constraint (equation 2): $\nabla \cdot v = 0$ for all
  $x$ and $t \ge 0$. -/
  div_free : ∀ x, ∀ t ≥ 0, ∇⬝ (v · t) x = 0
  /-- Initial condition (equation 3): $v(x,0) = u_0(x)$ for all $x$. -/
  initial_condition : ∀ x, v x 0 = u₀ x
  /-- The velocity field is smooth ($C^\infty$) on $\mathbb{R}^n \times [0,\infty)$
  (conditions 6, 11). -/
  velocity_smooth : ContDiffOn ℝ ∞ (↿v) (Set.univ ×ˢ Set.Ici 0)
  /-- The pressure field is smooth ($C^\infty$) on $\mathbb{R}^n \times [0,\infty)$
  (conditions 6, 11). -/
  pressure_smooth : ContDiffOn ℝ ∞ (↿p) (Set.univ ×ˢ Set.Ici 0)

/--
A solution to the Navier-Stokes equations on all of $\mathbb{R}^n$ with appropriate
decay and energy bounds.

In addition to the basic solution properties, we require:
- The velocity is in $L^2$ at each time $t \ge 0$ (finite kinetic energy)
- The total energy remains bounded for all time (condition 7)
-/
structure NavierStokesExistenceAndSmoothnessRn
    (nu : ℝ) (u₀ : ℝ^n → ℝ^n) (f : ℝ^n → ℝ → ℝ^n)
    (v : ℝ^n → ℝ → ℝ^n) (p : ℝ^n → ℝ → ℝ) : Prop
  extends NavierStokesExistenceAndSmoothness nu u₀ f v p where
  /-- The velocity is square-integrable at each time $t \ge 0$ (condition 7). -/
  integrable : ∀ t ≥ 0, MemLp (‖v · t‖) 2
  /-- The kinetic energy $\int \lVert v(x,t) \rVert^2\,dx$ remains uniformly bounded
  for all time (condition 7), where the integral is the Lebesgue integral. -/
  globally_bounded_energy : ∃ E, ∀ t ≥ 0, (∫ x : ℝ^n, ‖v x t‖ ^ 2) < E

/--
A solution to the Navier-Stokes equations on the $n$-torus $\mathbb{R}^n/\mathbb{Z}^n$.

The velocity must be 1-periodic in each spatial direction for all times (condition 10).
The pressure is also required to be 1-periodic, following the errata appended to the
Clay problem statement.
-/
structure NavierStokesExistenceAndSmoothnessPeriodic
    (nu : ℝ) (u₀ : ℝ^n → ℝ^n) (f : ℝ^n → ℝ → ℝ^n)
    (v : ℝ^n → ℝ → ℝ^n) (p : ℝ^n → ℝ → ℝ) : Prop
  extends NavierStokesExistenceAndSmoothness nu u₀ f v p where
  /-- The velocity is 1-periodic in space for all times $t \ge 0$ (condition 10). -/
  isOnePeriodic_velocity : ∀ t ≥ 0, IsOnePeriodic (v · t)
  /-- The pressure is 1-periodic in space for all times $t \ge 0$ (Clay errata). -/
  isOnePeriodic_pressure : ∀ t ≥ 0, IsOnePeriodic (p · t)


/-- (C) ∧ (D) Breakdown of Navier–Stokes solutions on both ℝ³ and ℝ³/ℤ³.

The first conjunct is the breakdown scenario (C) on ℝ³; the second conjunct is the
breakdown scenario (D) on the torus ℝ³/ℤ³. -/
noncomputable def nsResidual (ν : ℝ) (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (x : ℝ³) (t : ℝ) : ℝ³ :=
  deriv (fun s => u x s) t + fderiv ℝ (fun y => u y t) x (u x t)
    - ν • Δ (fun y => u y t) x + gradient (fun y => p y t) x


def BlowupPackage (ν T R : ℝ) (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (f : ℝ³ → ℝ → ℝ³) : Prop :=
  0 < T ∧ 0 < R ∧
  ContDiffOn ℝ ∞ (↿u) (univ ×ˢ Iio T) ∧ ContDiffOn ℝ ∞ (↿p) (univ ×ˢ Iio T) ∧
  ContDiff ℝ ∞ (↿f) ∧
  (∀ x t, t < T → R ≤ ‖x‖ → u x t = 0 ∧ p x t = 0) ∧
  (∀ x, u x 0 = 0) ∧
  (∀ x t, (R ≤ ‖x‖ ∨ t ≤ 0) → f x t = 0) ∧
  (∃ S : ℝ, ∀ x t, S ≤ t → f x t = 0) ∧
  (∀ x t, t < T → nsResidual ν u p x t = f x t) ∧
  (∀ x t, t < T → divergence (fun y => u y t) x = 0) ∧
  (∀ M : ℝ, ∃ x t, 0 ≤ t ∧ t < T ∧ M < ‖u x t‖)
noncomputable def curl3 (F : ℝ³ → ℝ³) (x : ℝ³) : ℝ³ :=
  (fderiv ℝ F x (EuclideanSpace.single 1 1) 2 - fderiv ℝ F x (EuclideanSpace.single 2 1) 1) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
  (fderiv ℝ F x (EuclideanSpace.single 2 1) 0 - fderiv ℝ F x (EuclideanSpace.single 0 1) 2) • EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
  (fderiv ℝ F x (EuclideanSpace.single 0 1) 1 - fderiv ℝ F x (EuclideanSpace.single 1 1) 0) • EuclideanSpace.single (2 : Fin 3) (1 : ℝ)


noncomputable def nsJet (ν : ℝ) (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (z : ℝ³ × ℝ) : ℝ³ :=
  fderiv ℝ (↿u) z ((0 : ℝ³), (1 : ℝ)) + fderiv ℝ (↿u) z ((↿u) z, (0 : ℝ))
    - ν • ∑ i : Fin 3, fderiv ℝ (fderiv ℝ (↿u)) z (EuclideanSpace.single i (1 : ℝ), (0 : ℝ))
        (EuclideanSpace.single i (1 : ℝ), (0 : ℝ))
    + ∑ i : Fin 3, fderiv ℝ (↿p) z (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) • EuclideanSpace.single i (1 : ℝ)
noncomputable def pd (i : Fin 3) (F : ℝ³ → ℝ) (x : ℝ³) : ℝ := fderiv ℝ F x (EuclideanSpace.single i 1)


noncomputable def newtonKernel (z : ℝ³) : ℝ := (4 * Real.pi * ‖z‖)⁻¹


noncomputable def newtonPot (g : ℝ³ → ℝ) (x : ℝ³) : ℝ := ∫ y, newtonKernel (x - y) * g y


noncomputable def stressPressure (g : Fin 3 → Fin 3 → ℝ³ → ℝ) (x : ℝ³) : ℝ :=
  ∑ i, ∑ j, pd i (pd j (newtonPot (g i j))) x


noncomputable def bump12 : ContDiffBump (0 : ℝ³) := ⟨1, 2, one_pos, one_lt_two⟩


noncomputable def cutPhi (R : ℝ) (x : ℝ³) : ℝ := bump12 (R⁻¹ • x)


noncomputable def hessKernel (i j : Fin 3) (z : ℝ³) : ℝ :=
  (3 * z i * z j - (if i = j then 1 else 0) * ‖z‖ ^ 2) / (4 * Real.pi * ‖z‖ ^ 5)
noncomputable def simScale (h z τ : ℝ) : ℝ := sInf {q : ℝ | 0 < q ∧ τ ≤ q - z ^ 2 * q ^ (2 * h)}


noncomputable def simDomain (h qs : ℝ) : Set (ℝ³ × ℝ) :=
  {w | w.2 < 1 ∧ simScale h (w.1 2) (1 - w.2) < qs}


noncomputable def heatProfile (h Z : ℝ) : ℝ :=
  (Real.Gamma (1 + h))⁻¹ * ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h)


noncomputable def heatSwirl (h c : ℝ) (x : ℝ³) (t : ℝ) : ℝ³ :=
  (c * (x 0 ^ 2 + x 1 ^ 2) ^ (-(1 + h)) * heatProfile h (4 * (1 - t) / (x 0 ^ 2 + x 1 ^ 2))) •
    (-(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))


noncomputable def heatPressure (h c : ℝ) (x : ℝ³) (t : ℝ) : ℝ :=
  -(c ^ 2 / 2) * ∫ s in Ioi (x 0 ^ 2 + x 1 ^ 2), s ^ (-(2 + 2 * h)) * heatProfile h (4 * (1 - t) / s) ^ 2

def SimScaleProps (h : ℝ) : Prop :=
  (∀ z τ : ℝ, 0 < τ → 0 < simScale h z τ ∧ simScale h z τ - z ^ 2 * simScale h z τ ^ (2 * h) = τ) ∧
  (∀ z τ : ℝ, 0 < τ → τ ≤ simScale h z τ ∧ z ^ 2 < simScale h z τ ^ (1 - 2 * h)) ∧
  (∀ z τ : ℝ, 0 < τ → simScale h z τ ≤ 2 * τ + (2 * z ^ 2) ^ (1 / (1 - 2 * h))) ∧
  ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale h w.1 w.2) (univ ×ˢ Ioi 0) ∧
  (∀ k : ℕ, 1 ≤ k → ∃ C : ℝ, ∀ z τ : ℝ, 0 < τ → simScale h z τ ≤ 1 →
     ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, τ)‖ ≤ C * simScale h z τ ^ (1 - (k : ℝ)))

def HeatExteriorProps (h c : ℝ) : Prop :=
  ContDiffOn ℝ ∞ (↿(heatSwirl h c)) {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2 ∧ w.2 < 1} ∧
  ContDiffOn ℝ ∞ (↿(heatPressure h c)) {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2 ∧ w.2 < 1} ∧
  (∀ (x : ℝ³) (t : ℝ), 0 < x 0 ^ 2 + x 1 ^ 2 → t < 1 →
     nsResidual 1 (heatSwirl h c) (heatPressure h c) x t = 0 ∧
     divergence (fun y => heatSwirl h c y t) x = 0 ∧ inner ℝ x (heatSwirl h c x t) = (0:ℝ) ∧
     heatSwirl h c x t 2 = 0) ∧
  (∀ r₀ : ℝ, 0 < r₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), r₀ ^ 2 ≤ x 0 ^ 2 + x 1 ^ 2 →
     x 0 ^ 2 + x 1 ^ 2 ≤ 1 → 0 < t → t < 1 →
     ‖iteratedFDeriv ℝ m (↿(heatSwirl h c)) (x, t)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(heatPressure h c)) (x, t)‖ ≤ C)

def ApproxFamily (h qs Xe Xin c e0 γ : ℝ) (ℓ K : ℕ → ℝ) (A Bv : ℕ → ℝ³ → ℝ → ℝ³) (P : ℕ → ℝ³ → ℝ → ℝ) : Prop :=
  (∀ j : ℕ, ContDiffOn ℝ ∞ (↿(A j)) (simDomain h qs) ∧ ContDiffOn ℝ ∞ (↿(Bv j)) (simDomain h qs) ∧
    ContDiffOn ℝ ∞ (↿(P j)) (simDomain h qs)) ∧
  (∀ (j : ℕ) x t, (x, t) ∈ simDomain h qs →
    divergence (fun y => Bv j y t) x = 0 ∧ inner ℝ x (Bv j x t) = (0 : ℝ) ∧ Bv j x t 2 = 0) ∧
  (∀ m : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain h qs →
    ‖iteratedFDeriv ℝ m (↿(A 0)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K m) ∧
    ‖iteratedFDeriv ℝ m (↿(Bv 0)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K m) ∧
    ‖iteratedFDeriv ℝ m (↿(P 0)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K m)) ∧
  (∀ j : ℕ, 1 ≤ j → ∀ m : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain h qs →
    ‖iteratedFDeriv ℝ m (↿(A j)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (γ * j - ℓ m) ∧
    ‖iteratedFDeriv ℝ m (↿(Bv j)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (γ * j - ℓ m) ∧
    ‖iteratedFDeriv ℝ m (↿(P j)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (γ * j - ℓ m)) ∧
  (∀ J m : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain h qs →
    ‖iteratedFDeriv ℝ m (↿(nsResidual 1
        (fun y s => curl3 (fun w => ∑ j ∈ Finset.range (J + 1), A j w s) y + ∑ j ∈ Finset.range (J + 1), Bv j y s)
        (fun y s => ∑ j ∈ Finset.range (J + 1), P j y s))) (x, t)‖
      ≤ C * simScale h (x 2) (1 - t) ^ (γ * J - K m)) ∧
  (∀ x t, (x, t) ∈ simDomain h qs → 2 * Xe * simScale h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2 →
    A 0 x t = 0 ∧ Bv 0 x t = heatSwirl h c x t ∧ P 0 x t = heatPressure h c x t ∧
    ∀ j : ℕ, 1 ≤ j → A j x t = 0 ∧ Bv j x t = 0 ∧ P j x t = 0) ∧
  (∀ j : ℕ, 1 ≤ j → ∀ x t, (x, t) ∈ simDomain h qs →
    x 0 ^ 2 + x 1 ^ 2 < 4 * Xin * simScale h (x 2) (1 - t) → A j x t = 0 ∧ Bv j x t = 0 ∧ P j x t = 0) ∧
  (∃ τ₁ : ℝ, 0 < τ₁ ∧ ∀ τ : ℝ, 0 < τ → τ < τ₁ →
    2 * e0 * τ ^ (-(1 / 2 : ℝ)) ≤
      ‖curl3 (fun w => A 0 w (1 - τ)) (Real.sqrt (2 * Xin * τ) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) +
        Bv 0 (Real.sqrt (2 * Xin * τ) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) (1 - τ)‖)

def LocalPackage (h qs Xe Xin c e0 : ℝ) (A Bv : ℝ³ → ℝ → ℝ³) (P : ℝ³ → ℝ → ℝ) : Prop :=
  ContDiffOn ℝ ∞ (↿A) (simDomain h qs) ∧ ContDiffOn ℝ ∞ (↿Bv) (simDomain h qs) ∧
    ContDiffOn ℝ ∞ (↿P) (simDomain h qs) ∧
  (∀ x t, (x, t) ∈ simDomain h qs →
    divergence (fun y => Bv y t) x = 0 ∧ inner ℝ x (Bv x t) = (0 : ℝ)) ∧
  (∀ m : ℕ, ∃ C κ : ℝ, 0 ≤ κ ∧ ∀ x t, (x, t) ∈ simDomain h qs →
    ‖iteratedFDeriv ℝ m (↿A) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-κ) ∧
    ‖iteratedFDeriv ℝ m (↿Bv) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-κ) ∧
    ‖iteratedFDeriv ℝ m (↿P) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-κ)) ∧
  (∀ x t, (x, t) ∈ simDomain h qs → 2 * Xe * simScale h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2 →
    A x t = 0 ∧ Bv x t = heatSwirl h c x t ∧ P x t = heatPressure h c x t) ∧
  (∀ m N : ℕ, ∃ C δ : ℝ, 0 < δ ∧ ∀ x t, (x, t) ∈ simDomain h qs → simScale h (x 2) (1 - t) < δ →
    ‖iteratedFDeriv ℝ m (↿(nsResidual 1 (fun y s => curl3 (fun w => A w s) y + Bv y s) P)) (x, t)‖
      ≤ C * simScale h (x 2) (1 - t) ^ N) ∧
  (∃ τ₁ : ℝ, 0 < τ₁ ∧ ∀ τ : ℝ, 0 < τ → τ < τ₁ →
    e0 * τ ^ (-(1 / 2 : ℝ)) ≤
      ‖curl3 (fun w => A w (1 - τ)) (Real.sqrt (2 * Xin * τ) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) +
        Bv (Real.sqrt (2 * Xin * τ) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) (1 - τ)‖)
noncomputable def heatK (β Z : ℝ) : ℝ :=
  ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ β * (1 + Z * v) ^ (-β)

noncomputable def heatQ (h Y : ℝ) : ℝ :=
  ∫ w in Ioi (1:ℝ), w ^ (-(2 + 2 * h)) * heatProfile h (Y / w) ^ 2
noncomputable def simCut (h a : ℝ) (x : ℝ³) (t : ℝ) : ℝ :=
  Real.smoothTransition (2 - 2 * (a * simScale h (x 2) (1 - t)))

noncomputable def cutSum {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V]
    (h : ℝ) (a : ℕ → ℝ) (F : ℕ → ℝ³ → ℝ → V) (x : ℝ³) (t : ℝ) : V :=
  F 0 x t + ∑' j : ℕ, simCut h (a (j + 1)) x t • F (j + 1) x t
noncomputable def simX (h : ℝ) (x : ℝ³) (t : ℝ) : ℝ :=
  (x 0 ^ 2 + x 1 ^ 2) / (2 * simScale h (x 2) (1 - t))

noncomputable def simEta (h : ℝ) (x : ℝ³) (t : ℝ) : ℝ :=
  x 2 * simScale h (x 2) (1 - t) ^ (-(1 / 2 - h))

noncomputable def azVec (x : ℝ³) : ℝ³ :=
  -(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)

noncomputable def radVec (x : ℝ³) : ℝ³ :=
  x 0 • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 1 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)

noncomputable def logLift (f : ℝ → ℝ → ℝ → ℝ) (w : ℝ × ℝ × ℝ) : ℝ := f (Real.exp w.1) w.2.1 w.2.2

noncomputable def edgeWeight (Xa Xb aa ab X : ℝ) : ℝ :=
  if Xa < X ∧ X < Xb then Real.exp (-(aa / Real.log (X / Xa) ^ 2) - ab / Real.log (Xb / X) ^ 2) else 0

noncomputable def edgeDist (Xa Xb X : ℝ) : ℝ := min 1 (min (Real.log (X / Xa)) (Real.log (Xb / X)))

noncomputable def shearA (F : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ := -2 * X * deriv (fun Y => F Y η) X / F X η

noncomputable def shearB (F U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  Real.sqrt (2 * X) * deriv (fun Y => U Y η) X / F X η

noncomputable def stressDivField (h : ℝ) (Tth Tz : ℝ → ℝ → ℝ → ℝ) (x : ℝ³) (t : ℝ) : ℝ³ :=
  (-(simScale h (x 2) (1 - t) ^ (-(2 + h)) *
      (deriv (fun Y => Tth (simScale h (x 2) (1 - t)) Y (simEta h x t)) (simX h x t)
        + Tth (simScale h (x 2) (1 - t)) (simX h x t) (simEta h x t) / simX h x t))) • azVec x
  + (-(Real.sqrt (2 * simX h x t) * simScale h (x 2) (1 - t) ^ (-(3 / 2 + h)) *
      (deriv (fun Y => Tz (simScale h (x 2) (1 - t)) Y (simEta h x t)) (simX h x t)
        + Tz (simScale h (x 2) (1 - t)) (simX h x t) (simEta h x t) / (2 * simX h x t)))) •
      EuclideanSpace.single (2 : Fin 3) (1:ℝ)

def BackgroundProps (h Xa Xb Xext m1 m2 lam cpatch qB c aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ)
    (AB BvB : ℝ³ → ℝ → ℝ³) (PB : ℝ³ → ℝ → ℝ) (Eb Ub Vb Tth Tz : ℝ → ℝ → ℝ → ℝ) : Prop :=
  (0 < h ∧ h < 1 / 100 ∧ 0 < Xa ∧ Xa < m1 ∧ m1 < m2 ∧ m2 < Xb ∧ Xb ≤ Xext ∧
      0 < qB ∧ qB ≤ 1 ∧ 0 < lam ∧ 0 < cpatch ∧ 0 < aa ∧ 0 < ab) ∧
  (ContDiffOn ℝ ∞ (↿F) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿U) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    (∀ X η : ℝ, 0 < X → -1 < η → η < 1 → 0 < F X η) ∧
    (∀ X₀ X₁ : ℝ, 0 < X₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, X₀ ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿F) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿U) (X, η)‖ ≤ C)) ∧
  (ContDiffOn ℝ ∞ (↿T0th) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿T0z) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    (∀ X η : ℝ, 0 < X → (X ≤ Xa ∨ Xb ≤ X) → T0th X η = 0 ∧ T0z X η = 0) ∧
    (∃ c₀ : ℝ, 0 < c₀ ∧ ∀ X η : ℝ, Xa < X → X < Xb → -1 < η → η < 1 →
      c₀ * edgeWeight Xa Xb aa ab X ≤ Real.sqrt (T0th X η ^ 2 + T0z X η ^ 2)) ∧
    (∀ m : ℕ, ∃ C N : ℝ, ∀ X η : ℝ, Xa < X → X < Xb → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿T0th) (X, η)‖ ≤ C * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N) ∧
      ‖iteratedFDeriv ℝ m (↿T0z) (X, η)‖ ≤ C * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N)) ∧
    (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, Xa < X → X < Xb → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ => T0th w.1 w.2 / Real.sqrt (T0th w.1 w.2 ^ 2 + T0z w.1 w.2 ^ 2)) (X, η)‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ => T0z w.1 w.2 / Real.sqrt (T0th w.1 w.2 ^ 2 + T0z w.1 w.2 ^ 2)) (X, η)‖ ≤ C) ∧
    (∃ κ : ℝ, 0 < κ ∧ κ < 2 ∧ ∀ X η : ℝ, Xa < X → X < Xb → -1 < η → η < 1 →
      κ ≤ F X η ∧ κ ≤ shearA F X η ∧
      κ ≤ shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) - 2 ∧
      κ * Real.sqrt (T0th X η ^ 2 + T0z X η ^ 2) ≤ T0th X η - shearB F U X η / shearA F X η * T0z X η ∧
      (shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) - 2) *
          (T0z X η + shearB F U X η / shearA F X η * T0th X η) ^ 2 ≤
        (2 - κ) * (T0th X η - shearB F U X η / shearA F X η * T0z X η) ^ 2)) ∧
  (ContDiffOn ℝ ∞ (↿AB) (simDomain h qB) ∧ ContDiffOn ℝ ∞ (↿BvB) (simDomain h qB) ∧
    ContDiffOn ℝ ∞ (↿PB) (simDomain h qB)) ∧
  (∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h qB →
    divergence (fun y => BvB y t) x = 0 ∧ inner ℝ x (BvB x t) = (0 : ℝ) ∧ BvB x t 2 = 0) ∧
  (∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h qB → 0 < x 0 ^ 2 + x 1 ^ 2 →
    inner ℝ (curl3 (fun w => AB w t) x + BvB x t) (azVec x) =
        Real.sqrt (x 0 ^ 2 + x 1 ^ 2) * simScale h (x 2) (1 - t) ^ (-(1 / 2 + h)) *
          Eb (simScale h (x 2) (1 - t)) (simX h x t) (simEta h x t) ∧
    (curl3 (fun w => AB w t) x + BvB x t) 2 =
        simScale h (x 2) (1 - t) ^ (-(1 / 2 + h)) * Ub (simScale h (x 2) (1 - t)) (simX h x t) (simEta h x t) ∧
    inner ℝ (curl3 (fun w => AB w t) x + BvB x t) (radVec x) =
        Vb (simScale h (x 2) (1 - t)) (simX h x t) (simEta h x t)) ∧
  (ContDiffOn ℝ ∞ (logLift Eb) (Iio (Real.log qB) ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) ∧
    ContDiffOn ℝ ∞ (logLift Ub) (Iio (Real.log qB) ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) ∧
    ContDiffOn ℝ ∞ (logLift Vb) (Iio (Real.log qB) ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) ∧
    ∀ X₀ X₁ : ℝ, 0 < X₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ q X η : ℝ, 0 < q → q < qB → X₀ ≤ X → X ≤ X₁ →
      -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => logLift Eb w - Real.sqrt (2 * w.2.1) * F w.2.1 w.2.2)
          (Real.log q, X, η)‖ ≤ C * q ^ (2 * h) ∧
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => logLift Ub w - U w.2.1 w.2.2) (Real.log q, X, η)‖ ≤
          C * q ^ (2 * h) ∧
      ‖iteratedFDeriv ℝ m (logLift Vb) (Real.log q, X, η)‖ ≤ C) ∧
  (∀ q X η : ℝ, 0 < q → q < qB → m1 ≤ X → X ≤ m2 → -1 < η → η < 1 →
    Eb q X η = cpatch * (1 + η ^ 2)⁻¹ * X ^ (-(1 / 2 + lam)) ∧ Ub q X η = 0) ∧
  (ContDiffOn ℝ ∞ (logLift Tth) (Iio (Real.log qB) ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) ∧
    ContDiffOn ℝ ∞ (logLift Tz) (Iio (Real.log qB) ×ˢ (Ioi 0 ×ˢ Ioo (-1) 1)) ∧
    (∀ q X η : ℝ, (X ≤ Xa ∨ Xb ≤ X) → Tth q X η = 0 ∧ Tz q X η = 0) ∧
    (∀ m : ℕ, ∃ C N : ℝ, ∀ q X η : ℝ, 0 < q → q < qB → Xa < X → X < Xb → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => logLift Tth w - T0th w.2.1 w.2.2) (Real.log q, X, η)‖ ≤
          C * q ^ h * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N) ∧
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => logLift Tz w - T0z w.2.1 w.2.2) (Real.log q, X, η)‖ ≤
          C * q ^ h * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N))) ∧
  (∀ m N : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h qB →
    ‖iteratedFDeriv ℝ m (↿(fun (y : ℝ³) (s : ℝ) =>
        nsResidual 1 (fun y' s' => curl3 (fun w => AB w s') y' + BvB y' s') PB y s -
          stressDivField h Tth Tz y s)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (N : ℝ)) ∧
  (∀ m : ℕ, ∃ C K : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h qB →
    ‖iteratedFDeriv ℝ m (↿AB) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧
    ‖iteratedFDeriv ℝ m (↿BvB) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧
    ‖iteratedFDeriv ℝ m (↿PB) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K)) ∧
  (∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h qB → 2 * Xext * simScale h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2 →
    AB x t = 0 ∧ BvB x t = heatSwirl h c x t ∧ PB x t = heatPressure h c x t)

def CorrectionFamily (h Xa Xb qB : ℝ) (AB BvB : ℝ³ → ℝ → ℝ³) (PB : ℝ³ → ℝ → ℝ)
    (qs γ : ℝ) (ℓ K : ℕ → ℝ) (A Bv : ℕ → ℝ³ → ℝ → ℝ³) (P : ℕ → ℝ³ → ℝ → ℝ) : Prop :=
  (0 < qs ∧ qs ≤ qB ∧ 0 < γ) ∧
  (∀ j : ℕ, ContDiffOn ℝ ∞ (↿(A j)) (simDomain h qs) ∧ ContDiffOn ℝ ∞ (↿(Bv j)) (simDomain h qs) ∧
    ContDiffOn ℝ ∞ (↿(P j)) (simDomain h qs)) ∧
  (∀ (j : ℕ) x t, (x, t) ∈ simDomain h qs →
    divergence (fun y => Bv j y t) x = 0 ∧ inner ℝ x (Bv j x t) = (0 : ℝ) ∧ Bv j x t 2 = 0) ∧
  (∀ m : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain h qs →
    ‖iteratedFDeriv ℝ m (↿(A 0)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K m) ∧
    ‖iteratedFDeriv ℝ m (↿(Bv 0)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K m) ∧
    ‖iteratedFDeriv ℝ m (↿(P 0)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K m)) ∧
  (∀ j : ℕ, 1 ≤ j → ∀ m : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain h qs →
    ‖iteratedFDeriv ℝ m (↿(A j)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (γ * j - ℓ m) ∧
    ‖iteratedFDeriv ℝ m (↿(Bv j)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (γ * j - ℓ m) ∧
    ‖iteratedFDeriv ℝ m (↿(P j)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (γ * j - ℓ m)) ∧
  (∀ J m : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain h qs →
    ‖iteratedFDeriv ℝ m (↿(nsResidual 1
        (fun y s => curl3 (fun w => ∑ j ∈ Finset.range (J + 1), A j w s) y + ∑ j ∈ Finset.range (J + 1), Bv j y s)
        (fun y s => ∑ j ∈ Finset.range (J + 1), P j y s))) (x, t)‖
      ≤ C * simScale h (x 2) (1 - t) ^ (γ * J - K m)) ∧
  (∀ x t, (x, t) ∈ simDomain h qs →
    (x 0 ^ 2 + x 1 ^ 2 < 2 * Xa * simScale h (x 2) (1 - t) ∨
      2 * Xb * simScale h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2) →
    A 0 x t = AB x t ∧ Bv 0 x t = BvB x t ∧ P 0 x t = PB x t ∧
    ∀ j : ℕ, 1 ≤ j → A j x t = 0 ∧ Bv j x t = 0 ∧ P j x t = 0) ∧
  (∀ x t, (x, t) ∈ simDomain h qs → x 0 ^ 2 + x 1 ^ 2 < 2 * Xa * simScale h (x 2) (1 - t) →
    curl3 (fun w => A 0 w t) x + Bv 0 x t = curl3 (fun w => AB w t) x + BvB x t)
noncomputable def fluxBeta (R : ℝ) (w : ℝ³ → ℝ³) (x : ℝ³) : ℝ :=
  8 * cutPhi R x * fderiv ℝ (cutPhi R) x (w x)
noncomputable def profRadInt (f : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ := ∫ x in (0:ℝ)..X, f x η

noncomputable def profRadAvg (f : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ := ∫ s in (0:ℝ)..1, f (s * X) η

noncomputable def profEtaD (g : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ := deriv (fun e => g X e) η

noncomputable def leadPi (F : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ := -∫ x in Ioi X, F x η ^ 2

noncomputable def leadW (h : ℝ) (U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  1 - 2 * (1 / 2 - h) * η * profRadAvg U X η - (1 - η ^ 2) * profEtaD (profRadAvg U) X η

noncomputable def leadQs (h : ℝ) (F U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  -leadW h U X η +
    ((1 - h) * profRadInt (fun x e => 2 * x * F x e) X η
      - (1 / 2 - h) * η * profEtaD (profRadInt (fun x e => 2 * x * F x e)) X η
      - (1 - η ^ 2) * profEtaD (profRadInt (fun x e => U x e * (2 * x * F x e))) X η
      + 2 * (h - (1 / 2 - h)) * η * profRadInt (fun x e => U x e * (2 * x * F x e)) X η) /
    (X * (2 * X * F X η))

noncomputable def leadNs (h : ℝ) (F U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  -leadW h U X η * U X η +
    ((1 / 2 - h) * (profRadInt U X η - η * profEtaD (profRadInt U) X η)
      + 4 * h * η * profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2) X η
      - (1 - η ^ 2) * profEtaD (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2)) X η) / X
    + 4 * (1 / 2 + h) * η * leadPi F X η - (1 - η ^ 2) * profEtaD (leadPi F) X η

noncomputable def leadStressTh (h : ℝ) (F U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  F X η * (X * leadQs h F U X η / (1 - 2 * h * η ^ 2) - shearA F X η)

noncomputable def leadStressTz (h : ℝ) (F U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  F X η * (X * leadNs h F U X η / ((1 - 2 * h * η ^ 2) * (Real.sqrt (2 * X) * F X η)) + shearB F U X η)

def LeadingProfile (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) : Prop :=
  (0 < h ∧ h < 1 / 100 ∧ 0 < lam ∧ 0 < cinf ∧ 0 < cpatch ∧ 0 < aa ∧ 0 < ab ∧
      0 < Xa ∧ Xa < p1 ∧ p1 < p2 ∧ p2 < m1 ∧ m1 < m2 ∧ m2 < Xv ∧ Xv < Xc ∧ Xc < Xb) ∧
  (ContDiffOn ℝ ∞ (↿F) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿U) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    (∀ X η : ℝ, 0 < X → -1 < η → η < 1 → 0 < F X η) ∧
    (∀ X₀ X₁ : ℝ, 0 < X₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, X₀ ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿F) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿U) (X, η)‖ ≤ C)) ∧
  (ContDiffOn ℝ ∞ (↿T0th) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿T0z) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    (∀ X η : ℝ, 0 < X → (X ≤ Xa ∨ Xb ≤ X) → T0th X η = 0 ∧ T0z X η = 0) ∧
    (∃ c₀ : ℝ, 0 < c₀ ∧ ∀ X η : ℝ, Xa < X → X < Xb → -1 < η → η < 1 →
      c₀ * edgeWeight Xa Xb aa ab X ≤ Real.sqrt (T0th X η ^ 2 + T0z X η ^ 2)) ∧
    (∀ m : ℕ, ∃ C N : ℝ, ∀ X η : ℝ, Xa < X → X < Xb → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿T0th) (X, η)‖ ≤ C * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N) ∧
      ‖iteratedFDeriv ℝ m (↿T0z) (X, η)‖ ≤ C * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N)) ∧
    (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, Xa < X → X < Xb → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ => T0th w.1 w.2 / Real.sqrt (T0th w.1 w.2 ^ 2 + T0z w.1 w.2 ^ 2)) (X, η)‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ => T0z w.1 w.2 / Real.sqrt (T0th w.1 w.2 ^ 2 + T0z w.1 w.2 ^ 2)) (X, η)‖ ≤ C) ∧
    (∃ κ : ℝ, 0 < κ ∧ κ < 2 ∧ ∀ X η : ℝ, Xa < X → X < Xb → -1 < η → η < 1 →
      κ ≤ F X η ∧ κ ≤ shearA F X η ∧
      κ ≤ shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) - 2 ∧
      κ * Real.sqrt (T0th X η ^ 2 + T0z X η ^ 2) ≤ T0th X η - shearB F U X η / shearA F X η * T0z X η ∧
      (shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) - 2) *
          (T0z X η + shearB F U X η / shearA F X η * T0th X η) ^ 2 ≤
        (2 - κ) * (T0th X η - shearB F U X η / shearA F X η * T0z X η) ^ 2)) ∧
  (∀ X η : ℝ, 0 < X → -1 < η → η < 1 →
      T0th X η = leadStressTh h F U X η ∧ T0z X η = leadStressTz h F U X η) ∧
  (∃ ε : ℝ, 0 < ε ∧ ContDiffOn ℝ ∞ (↿F) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
    (∀ η : ℝ, -1 < η → η < 1 → 0 < F 0 η) ∧
    (∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿F) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿U) (X, η)‖ ≤ C)) ∧
  (∃ Xan ρ : ℝ, Xa < Xan ∧ Xan < p1 ∧ 0 < ρ ∧ ∃ Fc Uc Pc : ℕ → ℝ → ℂ → ℂ, ∀ k : ℕ, ∃ C : ℝ,
    ContinuousOn (fun p : ℝ × ℂ => Fc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ContinuousOn (fun p : ℝ × ℂ => Uc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ContinuousOn (fun p : ℝ × ℂ => Pc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ∀ X : ℝ, 0 ≤ X → X ≤ Xan →
      DifferentiableOn ℂ (Fc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      DifferentiableOn ℂ (Uc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      DifferentiableOn ℂ (Pc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      (∀ w : ℂ, |w.im| < ρ → -1 - ρ < w.re → w.re < 1 + ρ →
        ‖Fc k X w‖ ≤ C ∧ ‖Uc k X w‖ ≤ C ∧ ‖Pc k X w‖ ≤ C) ∧
      (∀ η : ℝ, -1 < η → η < 1 →
        Fc k X (η : ℂ) = ((iteratedDeriv k (fun Y => F Y η) X : ℝ) : ℂ) ∧
        Uc k X (η : ℂ) = ((iteratedDeriv k (fun Y => U Y η) X : ℝ) : ℂ) ∧
        Pc k X (η : ℂ) = ((iteratedDeriv k (fun Y => leadPi F Y η) X : ℝ) : ℂ))) ∧
  (∀ X η : ℝ, Xb ≤ X → -1 < η → η < 1 → U X η = 0 ∧
      Real.sqrt (2 * X) * F X η = cinf * X ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - η ^ 2) / X)) ∧
  (∀ X η : ℝ, Xv ≤ X → -1 < η → η < 1 → U X η = 0 ∧ profRadInt U X η = 0) ∧
  (∀ X η : ℝ, ((p1 ≤ X ∧ X ≤ p2) ∨ (m1 ≤ X ∧ X ≤ m2)) → -1 < η → η < 1 →
      U X η = 0 ∧ Real.sqrt (2 * X) * F X η = cpatch * (1 + η ^ 2)⁻¹ * X ^ (-(1 / 2 + lam))) ∧
  (∀ η : ℝ, -1 < η → η < 1 →
      (∫ x in Ioi (0:ℝ), U x η * (2 * x * F x η)) = 0 ∧
      (∫ x in Ioi (0:ℝ), (U x η ^ 2 - x * F x η ^ 2)) = 0 ∧
      (∫ x in Ioi (0:ℝ), (2 * x * F x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h)))) = 0) ∧
  (∀ m : ℕ, ∃ C N : ℝ, ∀ X η : ℝ, Xc ≤ X → X < Xb → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ => Real.sqrt (2 * w.1) * F w.1 w.2 -
          cinf * w.1 ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - w.2 ^ 2) / w.1)) (X, η)‖ ≤
        C * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N))
noncomputable def leadV (h : ℝ) (U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  X / (1 - 2 * h * η ^ 2) *
    (2 * η * U X η - 2 * (1 / 2 - h) * η * profRadAvg U X η - (1 - η ^ 2) * profEtaD (profRadAvg U) X η)

noncomputable def bgAn (h : ℝ) (n : ℕ) (S : ℝ → ℝ → ℝ) (x : ℝ³) (t : ℝ) : ℝ³ :=
  ((1 / 2) * simScale h (x 2) (1 - t) ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) *
    S (simX h x t) (simEta h x t)) • azVec x

noncomputable def bgBn (h : ℝ) (n : ℕ) (G : ℝ → ℝ → ℝ) (x : ℝ³) (t : ℝ) : ℝ³ :=
  (simScale h (x 2) (1 - t) ^ (-(1 + h) + 2 * (n : ℝ) * h) * G (simX h x t) (simEta h x t)) • azVec x

noncomputable def bgPn (h : ℝ) (n : ℕ) (W : ℝ → ℝ → ℝ) (x : ℝ³) (t : ℝ) : ℝ :=
  simScale h (x 2) (1 - t) ^ (-(1 + 2 * h) + 2 * (n : ℝ) * h) * W (simX h x t) (simEta h x t)

noncomputable def bgTsum (h : ℝ) (T : ℕ → ℝ → ℝ → ℝ) (N : ℕ) (q X η : ℝ) : ℝ :=
  ∑ n ∈ Finset.range (N + 1), q ^ (2 * (n : ℝ) * h) * T n X η

noncomputable def bgCut (a q : ℝ) : ℝ := Real.smoothTransition (2 - 2 * (a * q))

noncomputable def bgSum (h : ℝ) (a : ℕ → ℝ) (T : ℕ → ℝ → ℝ → ℝ) (q X η : ℝ) : ℝ :=
  T 0 X η + ∑' n : ℕ, bgCut (a (n + 1)) q * q ^ (2 * ((n : ℝ) + 1) * h) * T (n + 1) X η

noncomputable def bgEb (h : ℝ) (a : ℕ → ℝ) (G : ℕ → ℝ → ℝ → ℝ) (q X η : ℝ) : ℝ :=
  Real.sqrt (2 * X) * bgSum h a G q X η

noncomputable def bgVb (h : ℝ) (a : ℕ → ℝ) (S Vc : ℕ → ℝ → ℝ → ℝ) (q X η : ℝ) : ℝ :=
  Vc 0 X η + ∑' n : ℕ, q ^ (2 * ((n : ℝ) + 1) * h) *
    (bgCut (a (n + 1)) q * Vc (n + 1) X η -
      2 * η / (1 - 2 * h * η ^ 2) * (a (n + 1) * q) *
        deriv (fun σ => Real.smoothTransition (2 - 2 * σ)) (a (n + 1) * q) * (X * S (n + 1) X η))

def BgOrderZero (h Xb cinf : ℝ) (F U : ℝ → ℝ → ℝ) : Prop :=
  (ContDiffOn ℝ ∞ (↿(bgAn h 0 (profRadAvg U))) {w : ℝ³ × ℝ | w.2 < 1} ∧
    ContDiffOn ℝ ∞ (↿(bgBn h 0 F)) {w : ℝ³ × ℝ | w.2 < 1} ∧
    ContDiffOn ℝ ∞ (↿(bgPn h 0 (leadPi F))) {w : ℝ³ × ℝ | w.2 < 1}) ∧
  (∀ (x : ℝ³) (t : ℝ), t < 1 → divergence (fun y => bgBn h 0 F y t) x = 0) ∧
  (∀ (x : ℝ³) (t : ℝ), t < 1 → 0 < x 0 ^ 2 + x 1 ^ 2 →
    (curl3 (fun w => bgAn h 0 (profRadAvg U) w t) x) 2 =
        simScale h (x 2) (1 - t) ^ (-(1 / 2 + h)) * U (simX h x t) (simEta h x t) ∧
    inner ℝ (curl3 (fun w => bgAn h 0 (profRadAvg U) w t) x) (radVec x) =
        leadV h U (simX h x t) (simEta h x t) ∧
    inner ℝ (curl3 (fun w => bgAn h 0 (profRadAvg U) w t) x) (azVec x) = (0 : ℝ)) ∧
  (∀ (x : ℝ³) (t : ℝ), t < 1 → 2 * Xb * simScale h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2 →
    bgAn h 0 (profRadAvg U) x t = 0 ∧ bgBn h 0 F x t = heatSwirl h (2 ^ (1 / 2 + h) * cinf) x t ∧
    bgPn h 0 (leadPi F) x t = heatPressure h (2 ^ (1 / 2 + h) * cinf) x t) ∧
  (∀ m : ℕ, ∃ C K : ℝ, ∀ (x : ℝ³) (t : ℝ), t < 1 → simScale h (x 2) (1 - t) ≤ 1 →
    ‖iteratedFDeriv ℝ m (↿(bgAn h 0 (profRadAvg U))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧
    ‖iteratedFDeriv ℝ m (↿(bgBn h 0 F)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧
    ‖iteratedFDeriv ℝ m (↿(bgPn h 0 (leadPi F))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K)) ∧
  (ContDiffOn ℝ ∞ (↿(leadV h U)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    ∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 < X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿(leadV h U)) (X, η)‖ ≤ C)

def BgPositive (h Xa Xb m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ)
    (S G Uc Vc W Tth Tz : ℕ → ℝ → ℝ → ℝ) : Prop :=
  (S 0 = profRadAvg U ∧ G 0 = F ∧ Uc 0 = U ∧ Vc 0 = leadV h U ∧ W 0 = leadPi F ∧
    (∀ X η : ℝ, 0 < X → -1 < η → η < 1 → Tth 0 X η = T0th X η ∧ Tz 0 X η = T0z X η)) ∧
  (∃ Xm Xp : ℝ, Xa < Xm ∧ Xm < Xp ∧ Xp < Xb ∧
    (∀ n : ℕ, ∀ X η : ℝ, (X ≤ Xa ∨ Xb ≤ X) → Tth n X η = 0 ∧ Tz n X η = 0) ∧
    (∀ n : ℕ, 1 ≤ n → ∀ X η : ℝ, Xp ≤ X →
      S n X η = 0 ∧ G n X η = 0 ∧ Uc n X η = 0 ∧ Vc n X η = 0 ∧ W n X η = 0) ∧
    (∀ n : ℕ, 1 ≤ n → ∀ X η : ℝ, m1 ≤ X → X ≤ m2 → G n X η = 0 ∧ Uc n X η = 0) ∧
    (∀ n : ℕ, 1 ≤ n → ∀ X η : ℝ, X ≤ Xm → Tth n X η = 0 ∧ Tz n X η = 0) ∧
    (∀ n : ℕ, 2 ≤ n → ∀ X η : ℝ, Xp ≤ X → Tth n X η = 0 ∧ Tz n X η = 0)) ∧
  (∀ n : ℕ, 1 ≤ n →
    ContDiffOn ℝ ∞ (↿(S n)) (Ici 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(G n)) (Ici 0 ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿(W n)) (Ici 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(Uc n)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿(Vc n)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(Tth n)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿(Tz n)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 < X → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿(S n)) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(G n)) (X, η)‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (↿(W n)) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(Uc n)) (X, η)‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (↿(Vc n)) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(Tth n)) (X, η)‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (↿(Tz n)) (X, η)‖ ≤ C) ∧
  (∀ m : ℕ, ∃ C N : ℝ, ∀ X η : ℝ, Xa < X → X < Xb → -1 < η → η < 1 →
    ‖iteratedFDeriv ℝ m (↿(Tth 1)) (X, η)‖ ≤ C * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N) ∧
    ‖iteratedFDeriv ℝ m (↿(Tz 1)) (X, η)‖ ≤ C * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N)) ∧
  (∀ n : ℕ, 1 ≤ n → ∀ (x : ℝ³) (t : ℝ), t < 1 → 0 < x 0 ^ 2 + x 1 ^ 2 →
    (curl3 (fun w => bgAn h n (S n) w t) x) 2 =
        simScale h (x 2) (1 - t) ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * Uc n (simX h x t) (simEta h x t) ∧
    inner ℝ (curl3 (fun w => bgAn h n (S n) w t) x) (radVec x) =
        simScale h (x 2) (1 - t) ^ (2 * (n : ℝ) * h) * Vc n (simX h x t) (simEta h x t) ∧
    inner ℝ (curl3 (fun w => bgAn h n (S n) w t) x) (azVec x) = (0 : ℝ)) ∧
  (∃ Kr : ℕ → ℝ, ∀ N m : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
    ‖iteratedFDeriv ℝ m (↿(fun (y : ℝ³) (s : ℝ) =>
        nsResidual 1
          (fun y' s' => curl3 (fun w => ∑ n ∈ Finset.range (N + 1), bgAn h n (S n) w s') y' +
            ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y' s')
          (fun y' s' => ∑ n ∈ Finset.range (N + 1), bgPn h n (W n) y' s') y s -
        stressDivField h (bgTsum h Tth N) (bgTsum h Tz N) y s)) (x, t)‖ ≤
      C * simScale h (x 2) (1 - t) ^ (2 * h * ((N : ℝ) + 1) - Kr m))
noncomputable def pdX (f : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ := deriv (fun Y => f Y η) X

noncomputable def pdE (f : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ := deriv (fun e => f X e) η

noncomputable def simTop (h b : ℝ) (f : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  (-b * f X η + (1 / 2 - h) * η * pdE f X η + X * pdX f X η) / (1 - 2 * h * η ^ 2)

noncomputable def simZop (h b : ℝ) (f : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  (2 * b * η * f X η + (1 - η ^ 2) * pdE f X η - 2 * η * X * pdX f X η) / (1 - 2 * h * η ^ 2)

noncomputable def bgUz (S : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ := S X η + X * pdX S X η

noncomputable def bgVx (h : ℝ) (n : ℕ) (S : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  (2 * η * bgUz S X η - 2 * (1 / 2 - h + 2 * (n : ℝ) * h) * η * S X η - (1 - η ^ 2) * pdE S X η) /
    (1 - 2 * h * η ^ 2)

noncomputable def bgResTh (h : ℝ) (S G W : ℕ → ℝ → ℝ → ℝ) (k : ℕ) (X η : ℝ) : ℝ :=
  simTop h (-(1 + h) + 2 * (k : ℝ) * h) (G k) X η
    - 2 * (X * pdX (pdX (G k)) X η + 2 * pdX (G k) X η)
    + ∑ i ∈ Finset.range (k + 1),
        (bgVx h i (S i) X η * (G (k - i) X η + X * pdX (G (k - i)) X η)
          + bgUz (S i) X η * simZop h (-(1 + h) + 2 * ((k - i : ℕ) : ℝ) * h) (G (k - i)) X η)
    - (if 1 ≤ k then simZop h (-(1 + h) + 2 * ((k - 1 : ℕ) : ℝ) * h - (1 / 2 - h))
        (simZop h (-(1 + h) + 2 * ((k - 1 : ℕ) : ℝ) * h) (G (k - 1))) X η else 0)

noncomputable def bgResZ (h : ℝ) (S G W : ℕ → ℝ → ℝ → ℝ) (k : ℕ) (X η : ℝ) : ℝ :=
  simTop h (-(1 / 2 + h) + 2 * (k : ℝ) * h) (bgUz (S k)) X η
    + simZop h (-(1 + 2 * h) + 2 * (k : ℝ) * h) (W k) X η
    - 2 * (X * pdX (pdX (bgUz (S k))) X η + pdX (bgUz (S k)) X η)
    + ∑ i ∈ Finset.range (k + 1),
        (X * bgVx h i (S i) X η * pdX (bgUz (S (k - i))) X η
          + bgUz (S i) X η * simZop h (-(1 / 2 + h) + 2 * ((k - i : ℕ) : ℝ) * h) (bgUz (S (k - i))) X η)
    - (if 1 ≤ k then simZop h (-(1 / 2 + h) + 2 * ((k - 1 : ℕ) : ℝ) * h - (1 / 2 - h))
        (simZop h (-(1 / 2 + h) + 2 * ((k - 1 : ℕ) : ℝ) * h) (bgUz (S (k - 1)))) X η else 0)

noncomputable def bgOm (h : ℝ) (S : ℕ → ℝ → ℝ → ℝ) (k : ℕ) (X η : ℝ) : ℝ :=
  simTop h (-1 + 2 * (k : ℝ) * h) (bgVx h k (S k)) X η
    - 2 * (X * pdX (pdX (bgVx h k (S k))) X η + 2 * pdX (bgVx h k (S k)) X η)
    + ∑ i ∈ Finset.range (k + 1),
        (bgVx h i (S i) X η * (bgVx h (k - i) (S (k - i)) X η / 2 + X * pdX (bgVx h (k - i) (S (k - i))) X η)
          + bgUz (S i) X η * simZop h (-1 + 2 * ((k - i : ℕ) : ℝ) * h) (bgVx h (k - i) (S (k - i))) X η)
    - (if 1 ≤ k then simZop h (-1 + 2 * ((k - 1 : ℕ) : ℝ) * h - (1 / 2 - h))
        (simZop h (-1 + 2 * ((k - 1 : ℕ) : ℝ) * h) (bgVx h (k - 1) (S (k - 1)))) X η else 0)

noncomputable def bgResRad (h : ℝ) (S G W : ℕ → ℝ → ℝ → ℝ) (k : ℕ) (X η : ℝ) : ℝ :=
  pdX (W k) X η - ∑ i ∈ Finset.range (k + 1), G i X η * G (k - i) X η
    + (if 1 ≤ k then bgOm h S (k - 1) X η / 2 else 0)

noncomputable def stressPrimTh (r : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  if 0 < X ∧ -1 < η ∧ η < 1 then -(1 / X) * ∫ x in (0:ℝ)..X, x * r x η else 0

noncomputable def stressPrimZ (r : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  if 0 < X ∧ -1 < η ∧ η < 1 then -(1 / Real.sqrt (2 * X)) * ∫ x in (0:ℝ)..X, r x η else 0

def BgCoeffSeq (h Xm Xs m1 m2 : ℝ) (F U : ℝ → ℝ → ℝ) (S G W : ℕ → ℝ → ℝ → ℝ) : Prop :=
  (S 0 = profRadAvg U ∧ G 0 = F ∧ W 0 = leadPi F) ∧
  (∃ ε : ℝ, 0 < ε ∧ ∀ n : ℕ, 1 ≤ n →
    ContDiffOn ℝ ∞ (↿(S n)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(G n)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿(W n)) (Ioi (-ε) ×ˢ Ioo (-1) 1)) ∧
  (∀ n : ℕ, 1 ≤ n → ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿(S n)) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(G n)) (X, η)‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (↿(W n)) (X, η)‖ ≤ C) ∧
  (∀ n : ℕ, 1 ≤ n → ∀ X η : ℝ, Xs ≤ X → S n X η = 0 ∧ G n X η = 0 ∧ W n X η = 0) ∧
  (∀ n : ℕ, 1 ≤ n → ∀ X η : ℝ, m1 ≤ X → X ≤ m2 → G n X η = 0 ∧ bgUz (S n) X η = 0) ∧
  (∀ k : ℕ, 1 ≤ k → ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → bgResRad h S G W k X η = 0) ∧
  (∀ k : ℕ, 1 ≤ k → ∀ X η : ℝ, 0 < X → X ≤ Xm → -1 < η → η < 1 →
    bgResTh h S G W k X η = 0 ∧ bgResZ h S G W k X η = 0) ∧
  (∀ k : ℕ, 1 ≤ k → ∀ η : ℝ, -1 < η → η < 1 →
    (∫ X in Ioi (0:ℝ), X * bgResTh h S G W k X η) = 0 ∧ (∫ X in Ioi (0:ℝ), bgResZ h S G W k X η) = 0)

noncomputable def bgTthSeq (h : ℝ) (T0 : ℝ → ℝ → ℝ) (S G W : ℕ → ℝ → ℝ → ℝ) (n : ℕ) : ℝ → ℝ → ℝ :=
  if n = 0 then (fun X η => if 0 < X then T0 X η else 0) else stressPrimTh (bgResTh h S G W n)

noncomputable def bgTzSeq (h : ℝ) (T0 : ℝ → ℝ → ℝ) (S G W : ℕ → ℝ → ℝ → ℝ) (n : ℕ) : ℝ → ℝ → ℝ :=
  if n = 0 then (fun X η => if 0 < X then T0 X η else 0) else stressPrimZ (bgResZ h S G W n)
structure BG where
  (h Xa Xb Xext m1 m2 lam cpatch qB c aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ)
  (AB BvB : ℝ³ → ℝ → ℝ³) (PB : ℝ³ → ℝ → ℝ) (Eb Ub Vb Tth Tz : ℝ → ℝ → ℝ → ℝ)

def BG.ok (B : BG) : Prop := SimScaleProps B.h ∧ BackgroundProps B.h B.Xa B.Xb B.Xext B.m1 B.m2 B.lam
  B.cpatch B.qB B.c B.aa B.ab B.F B.U B.T0th B.T0z B.AB B.BvB B.PB B.Eb B.Ub B.Vb B.Tth B.Tz


noncomputable def kapS : ℝ := 1 / 100000
noncomputable def bgc : ℝ := Real.sqrt 2 - 1
noncomputable def Tgc : ℝ := 4 + Real.sqrt 2
noncomputable def Lgc : ℝ := 4 - Real.sqrt 2
noncomputable def vrv : ℝ × ℝ := (1, -bgc)
noncomputable def vtv : ℝ × ℝ := (bgc, 1)
noncomputable def drx (h : ℝ) : ℝ := 2 * ((1 + h) * (Real.log Lgc / Real.log Tgc) - h * kapS)
noncomputable def Jpow (n : ℤ) (Y : ℝ × ℝ) : ℝ × ℝ :=
  ((Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2))) • vrv) + ((Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2))) • vtv)
noncomputable def bandIdx (h : ℝ) (l : ℕ) : ℤ :=
  ⌊Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2))⌋
noncomputable def bandOf (q : ℝ) : ℕ := ⌈Real.logb 2 (1 / q)⌉₊
noncomputable def coarseIdx (h q : ℝ) : ℤ := bandIdx h (bandOf q - 4)
def IsDeck (h q : ℝ) (a : ℝ × ℝ) : Prop := ∃ n m : ℤ, Jpow (coarseIdx h q) a = ((n : ℝ), (m : ℝ))


abbrev Cyl := ℝ × ℝ × ℝ × (ℝ × ℝ)
noncomputable def qC (h : ℝ) (ξ : Cyl) : ℝ := simScale h ξ.2.1 (1 - ξ.2.2.1)
noncomputable def XC (h : ℝ) (ξ : Cyl) : ℝ := ξ.1 ^ 2 / (2 * qC h ξ)
noncomputable def etaC (h : ℝ) (ξ : Cyl) : ℝ := ξ.2.1 * qC h ξ ^ (-(1/2 - h))
noncomputable def SC (h : ℝ) (ξ : Cyl) : ℝ := (1 + |Real.log (qC h ξ)|) ^ 2
noncomputable def rad (x : ℝ³) : ℝ := Real.sqrt (x 0 ^ 2 + x 1 ^ 2)
noncomputable def Yph (h r t : ℝ) : ℝ × ℝ := (r ^ drx h) • vrv + t • vtv
noncomputable def eR (x : ℝ³) : ℝ³ := (rad x)⁻¹ • radVec x
noncomputable def eTh (x : ℝ³) : ℝ³ := (rad x)⁻¹ • azVec x
noncomputable def eZ : ℝ³ := EuclideanSpace.single 2 1
noncomputable def cyl2cart (x : ℝ³) (c : Fin 3 → ℝ) : ℝ³ := c 0 • eR x + c 1 • eTh x + c 2 • eZ
noncomputable def thetaOf (x : ℝ³) : ℝ := Complex.arg (⟨x 0, x 1⟩ : ℂ)
noncomputable def rotPt (r θ z : ℝ) : ℝ³ :=
  (r * Real.cos θ) • EuclideanSpace.single 0 1 + (r * Real.sin θ) • EuclideanSpace.single 1 1 +
    z • EuclideanSpace.single 2 1
abbrev Ext (V : Type) := ℝ³ → ℝ → (ℝ × ℝ) → V
noncomputable def evOff {V : Type} (h : ℝ) (F : Ext V) (Y₀ : ℝ × ℝ) : ℝ³ → ℝ → V :=
  fun x t => F x t (Yph h (rad x) t + Y₀)
noncomputable def curlX (h : ℝ) (A : Ext ℝ³) : Ext ℝ³ :=
  fun x t Y => curl3 (fun y => evOff h A (Y - Yph h (rad x) t) y t) x
noncomputable def resX (h : ℝ) (u : Ext ℝ³) (p : Ext ℝ) : Ext ℝ³ :=
  fun x t Y => nsResidual 1 (evOff h u (Y - Yph h (rad x) t)) (evOff h p (Y - Yph h (rad x) t)) x t
noncomputable def dR {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (h : ℝ) (f : Cyl → V) (ξ : Cyl) : V :=
  fderiv ℝ f ξ (1, 0, 0, (drx h * ξ.1 ^ (drx h - 1)) • vrv)
noncomputable def dZ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (ξ : Cyl) : V :=
  fderiv ℝ f ξ (0, 1, 0, 0)
noncomputable def dT {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (ξ : Cyl) : V :=
  fderiv ℝ f ξ (0, 0, 1, vtv)
noncomputable def thAvg (g : ℝ³ → ℝ) (r z : ℝ) : ℝ :=
  (2 * Real.pi)⁻¹ * ∫ θ in (0:ℝ)..(2 * Real.pi), g (rotPt r θ z)
noncomputable def yAvg (f : Cyl → ℝ) (ξ : Cyl) : ℝ :=
  ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), f (ξ.1, ξ.2.1, ξ.2.2.1, Y)
noncomputable def radMom (f : Cyl → ℝ) (e : ℕ) (z t : ℝ) : ℝ := ∫ r in Set.Ioi (0:ℝ), r ^ e * yAvg f (r, z, t, 0)


noncomputable def JpowL (n : ℤ) : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ) :=
  (ContinuousLinearMap.fst ℝ ℝ ℝ).smulRight (Jpow n (1, 0)) +
    (ContinuousLinearMap.snd ℝ ℝ ℝ).smulRight (Jpow n (0, 1))
noncomputable def Lnorm (h : ℝ) (ξ : Cyl) : Cyl →L[ℝ] Cyl :=
  (Real.sqrt (qC h ξ) • ContinuousLinearMap.id ℝ ℝ).prodMap
   ((qC h ξ ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap
    ((qC h ξ • ContinuousLinearMap.id ℝ ℝ).prodMap (JpowL (-(coarseIdx h (qC h ξ))))))
noncomputable def NB {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (h : ℝ) (f : Cyl → V) (k : ℕ)
    (ξ : Cyl) : ℝ :=
  ‖(iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖
def DomC (h qs : ℝ) : Set Cyl := {ξ | 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC h ξ < qs}
def shY (ξ : Cyl) (a : ℝ × ℝ) : Cyl := (ξ.1, ξ.2.1, ξ.2.2.1, ξ.2.2.2 + a)
def InM {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (B : BG) (qs α : ℝ) (f : Cyl → V) : Prop :=
  ContDiffOn ℝ ∞ f (DomC B.h qs) ∧
  (∀ ξ ∈ DomC B.h qs, ∀ a, IsDeck B.h (qC B.h ξ) a → f (shY ξ a) = f ξ) ∧
  (∀ ξ ∈ DomC B.h qs, (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → f ξ = 0) ∧
  ∀ k : ℕ, ∃ C b d : ℝ, ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
    NB B.h f k ξ ≤ C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
      edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d)
def InS (B : BG) (qs α : ℝ) (F : ℝ × ℝ → ℝ) : Prop :=
  ContDiffOn ℝ ∞ F {w | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} ∧
  ∀ k : ℕ, ∃ C b : ℝ, ∀ w : ℝ × ℝ, w.2 < 1 → simScale B.h w.1 (1 - w.2) < qs →
    ‖(iteratedFDeriv ℝ k F w).compContinuousLinearMap (fun _ =>
        (simScale B.h w.1 (1 - w.2) ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
        (simScale B.h w.1 (1 - w.2) • ContinuousLinearMap.id ℝ ℝ))‖
      ≤ C * simScale B.h w.1 (1 - w.2) ^ (B.h * α) * (1 + |Real.log (simScale B.h w.1 (1 - w.2))|) ^ (2 * b)


abbrev Lab := ℕ × (ℤ × ℤ × ℤ) × Bool
noncomputable def Qb (l : ℕ) : ℝ := (2:ℝ) ^ (-(l:ℝ))
noncomputable def epsb (h : ℝ) (l : ℕ) : ℝ := Qb l ^ h
noncomputable def Sb (l : ℕ) : ℝ := (l:ℝ) ^ 2
noncomputable def cib (h : ℝ) (l : ℕ) : ℝ := Tgc ^ (bandIdx h l) * Qb l ^ (1 + h)
noncomputable def kb (h : ℝ) (l : ℕ) : ℕ := ⌈epsb h l ^ (-(1/2:ℝ))⌉₊
noncomputable def sgn (σ : Bool) : ℝ := if σ then 1 else -1
noncomputable def bumpR (s : ℝ) : ℝ := Real.smoothTransition (1 - s ^ 2)
noncomputable def sqPart (μ : ℝ) (j : ℤ) (s : ℝ) : ℝ :=
  bumpR (s / μ - j) / Real.sqrt (∑' n : ℤ, bumpR (s / μ - n) ^ 2)
noncomputable def chartR (h : ℝ) (l : ℕ) (ξ : Cyl) : ℝ := ξ.1 / Real.sqrt (Qb l)
noncomputable def chartZ (h : ℝ) (l : ℕ) (ξ : Cyl) : ℝ := ξ.2.1 / Qb l ^ (1/2 - h)
noncomputable def chartT (h : ℝ) (l : ℕ) (ξ : Cyl) : ℝ := (1 - ξ.2.2.1) / Qb l
noncomputable def etaL (h : ℝ) (γ : Lab) (ξ : Cyl) : ℝ :=
  sqPart 1 (-(γ.1:ℤ)) (Real.logb 2 (qC h ξ)) *
  (sqPart (Sb γ.1 ^ (-3:ℤ)) γ.2.1.1 (chartR h γ.1 ξ) * sqPart (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.1 (chartZ h γ.1 ξ) *
   sqPart (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.2 (chartT h γ.1 ξ))
noncomputable def lamR (w : ℝ × ℝ) : ℝ := (w.1 - bgc * w.2) / (1 + bgc ^ 2)
noncomputable def lamT (w : ℝ × ℝ) : ℝ := (bgc * w.1 + w.2) / (1 + bgc ^ 2)
noncomputable def frac0 (y : ℝ × ℝ) : ℝ × ℝ := (y.1 - ((round y.1 : ℤ) : ℝ), y.2 - ((round y.2 : ℤ) : ℝ))
noncomputable def rectW (h : ℝ) (γ : Lab) (c : ℝ × ℝ) (Y : ℝ × ℝ) : ℝ × ℝ :=
  frac0 (Jpow (bandIdx h γ.1) Y - c)
noncomputable def xiG (h : ℝ) (γ : Lab) (c : ℝ × ℝ) (Y : ℝ × ℝ) : ℝ := lamR (rectW h γ c Y)
noncomputable def etG (h : ℝ) (γ : Lab) (c : ℝ × ℝ) (Y : ℝ × ℝ) : ℝ := lamT (rectW h γ c Y)
def inRect (h : ℝ) (γ : Lab) (c : ℝ × ℝ) (ρ : ℝ) (Y : ℝ × ℝ) : Prop :=
  |xiG h γ c Y| ≤ ρ ∧ |etG h γ c Y| ≤ ρ
noncomputable def Lsb (h r0 : ℝ) (l : ℕ) : ℝ := 2 * r0 / cib h l
noncomputable def vco (h r0 : ℝ) (γ : Lab) (c : ℝ × ℝ) (Y : ℝ × ℝ) : ℝ := (etG h γ c Y + r0) / cib h γ.1
noncomputable def chig (r0 s : ℝ) : ℝ := bumpR (4 * s / r0)
noncomputable def psiT (Ls v : ℝ) : ℝ := Real.smoothTransition ((Ls/3 - |v - Ls/2|) / (Ls/3 - Ls/5))
noncomputable def dVdir (h : ℝ) (l : ℕ) : Cyl := (0, 0, 0, (cib h l * Tgc ^ (-(bandIdx h l))) • vtv)


structure CorrGeom where
  lmin : ℕ
  r0 : ℝ
  ctr : Lab → ℝ × ℝ
  rep : Lab → ℝ × ℝ × ℝ
  ustar : ℝ
  Crep : ℝ
  tH : Lab → ℝ × ℝ × ℝ → ℝ → (Fin 3 → ℝ)
def rectAbs (B : BG) (G : CorrGeom) (γ : Lab) (ρ : ℝ) : Set (ℝ × ℝ) := {Y | inRect B.h γ (G.ctr γ) ρ Y}
def ActiveL (B : BG) (G : CorrGeom) (γ : Lab) : Prop :=
  G.lmin ≤ γ.1 ∧ ∃ ξ : Cyl, etaL B.h γ ξ ≠ 0 ∧ B.Xa ≤ XC B.h ξ ∧ XC B.h ξ ≤ B.Xb



noncomputable def eN (w : ℝ × ℝ) : ℝ := Real.sqrt (w.1 ^ 2 + w.2 ^ 2)
noncomputable def uB (B : BG) : ℝ³ → ℝ → ℝ³ := fun x t => curl3 (fun w => B.AB w t) x + B.BvB x t
noncomputable def baseC (B : BG) (l : ℕ) (ξ : Cyl) : Fin 3 → ℝ :=
  fun i => Qb l ^ (1/2 + B.h) * inner ℝ (uB B (rotPt ξ.1 0 ξ.2.1) ξ.2.2.1)
    (![eR (rotPt ξ.1 0 ξ.2.1), eTh (rotPt ξ.1 0 ξ.2.1), eZ] i)
noncomputable def RC (l : ℕ) (ξ : Cyl) : ℝ := ξ.1 / Real.sqrt (Qb l)
noncomputable def Fang (B : BG) (l : ℕ) (ξ : Cyl) : ℝ := baseC B l ξ 1 / RC l ξ
noncomputable def DrC {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (B : BG) (l : ℕ) (f : Cyl → V)
    (ξ : Cyl) : V := Real.sqrt (Qb l) • dR B.h f ξ
noncomputable def DzC {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (B : BG) (l : ℕ) (f : Cyl → V)
    (ξ : Cyl) : V := Real.sqrt (Qb l) • dZ f ξ
noncomputable def DtC {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (B : BG) (l : ℕ) (f : Cyl → V)
    (ξ : Cyl) : V := Qb l ^ (1 + B.h) • dT f ξ
noncomputable def F0r (B : BG) (G : CorrGeom) (γ : Lab) : ℝ := B.F (G.rep γ).1 (G.rep γ).2.1
noncomputable def g0r (B : BG) (G : CorrGeom) (γ : Lab) : ℝ × ℝ :=
  F0r B G γ • (-(shearA B.F (G.rep γ).1 (G.rep γ).2.1), shearB B.F B.U (G.rep γ).1 (G.rep γ).2.1)
noncomputable def Nfr (B : BG) (G : CorrGeom) (γ : Lab) : ℝ × ℝ := (eN (g0r B G γ))⁻¹ • g0r B G γ
noncomputable def Kfr (B : BG) (G : CorrGeom) (γ : Lab) : ℝ × ℝ := (-(Nfr B G γ).2, (Nfr B G γ).1)
noncomputable def lam0 (B : BG) (G : CorrGeom) (γ : Lab) : ℝ :=
  Real.sqrt (-(2 * F0r B G γ * (Nfr B G γ).1) * (2 * F0r B G γ * (Nfr B G γ).1 + eN (g0r B G γ)))
noncomputable def c0f (B : BG) (G : CorrGeom) (γ : Lab) : ℝ := lam0 B G γ / (2 * F0r B G γ * (Nfr B G γ).1)
noncomputable def Bs (B : BG) (G : CorrGeom) (γ : Lab) : ℝ :=
  Real.sqrt (lam0 B G γ / (epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * (1 + G.ustar^2) ^ (3/2:ℝ)))
noncomputable def sco (B : BG) (G : CorrGeom) (γ : Lab) (v : ℝ) : ℝ :=
  sgn γ.2.2 * (G.ustar / 2 + G.ustar * v / Lsb B.h G.r0 γ.1)
noncomputable def R0r (B : BG) (G : CorrGeom) (γ : Lab) : ℝ := Real.sqrt (2 * (G.rep γ).1 * (G.rep γ).2.2)
noncomputable def ptil (B : BG) (G : CorrGeom) (γ : Lab) : ℝ := R0r B G γ * Bs B G γ *
  ((Kfr B G γ).1 - sgn γ.2.2 * G.ustar * (g0r B G γ).1 / (Lsb B.h G.r0 γ.1 * eN (g0r B G γ) ^ 2))
noncomputable def pzr (B : BG) (G : CorrGeom) (γ : Lab) : ℝ := Bs B G γ *
  ((Kfr B G γ).2 - sgn γ.2.2 * G.ustar * (g0r B G γ).2 / (Lsb B.h G.r0 γ.1 * eN (g0r B G γ) ^ 2))
noncomputable def pint (B : BG) (G : CorrGeom) (γ : Lab) : ℤ :=
  if round ((kb B.h γ.1 : ℝ) * ptil B G γ) = 0 then 1 else round ((kb B.h γ.1 : ℝ) * ptil B G γ)
noncomputable def pang (B : BG) (G : CorrGeom) (γ : Lab) : ℝ := (pint B G γ : ℝ) / (kb B.h γ.1 : ℝ)
noncomputable def phiL (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl) : ℝ :=
  pzr B G γ * chartZ B.h γ.1 ξ / epsb B.h γ.1 + sgn γ.2.2 * Bs B G γ * G.ustar / 2 * RC γ.1 ξ
  - vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 * (pang B G γ * Fang B γ.1 ξ + pzr B G γ * baseC B γ.1 ξ 2)
noncomputable def nPhi (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl) : Fin 3 → ℝ :=
  ![DrC B γ.1 (phiL B G γ) ξ, pang B G γ / RC γ.1 ξ, DzC B γ.1 (phiL B G γ) ξ]
noncomputable def dV (B : BG) (l : ℕ) (f : Cyl → ℝ) (ξ : Cyl) : ℝ := fderiv ℝ f ξ (dVdir B.h l)
noncomputable def Kmat (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl) : Matrix (Fin 3) (Fin 3) ℝ :=
  !![0, -2 * Fang B γ.1 ξ, 0;
     2 * Fang B γ.1 ξ + RC γ.1 ξ * DrC B γ.1 (Fang B γ.1) ξ, 0, 0;
     DrC B γ.1 (fun η => baseC B γ.1 η 2) ξ, 0, 0]
noncomputable def nPhiP (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl) : Fin 3 → ℝ :=
  fun i => dV B γ.1 (fun η => nPhi B G γ η i) ξ
noncomputable def APhi (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl) : Matrix (Fin 3) (Fin 3) ℝ :=
  -Kmat B G γ ξ + (dotProduct (nPhi B G γ ξ) (nPhi B G γ ξ))⁻¹ •
    Matrix.vecMulVec (nPhi B G γ ξ) (Matrix.vecMul (nPhi B G γ ξ) (Kmat B G γ ξ) - nPhiP B G γ ξ)
noncomputable def dDamp (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl) : ℝ :=
  epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * dotProduct (nPhi B G γ ξ) (nPhi B G γ ξ)
noncomputable def ntan (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl) : ℝ :=
  Real.sqrt ((nPhi B G γ ξ 1)^2 + (nPhi B G γ ξ 2)^2)
noncomputable def Bcol (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl) (σ' : ℝ) : Fin 3 → ℝ :=
  let Ka : Fin 3 → ℝ := ![0, nPhi B G γ ξ 1 / ntan B G γ ξ, nPhi B G γ ξ 2 / ntan B G γ ξ]
  let Na : Fin 3 → ℝ := ![0, Ka 2, -(Ka 1)]
  let sa := nPhi B G γ ξ 0 / ntan B G γ ξ
  let sv := sco B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)
  (![1, 0, 0] - sa • Ka) + (σ' * c0f B G γ * Real.sqrt (1 + sv^2)) • Na
noncomputable def Penv (B : BG) (G : CorrGeom) (γ : Lab) (v : ℝ) : ℝ :=
  Real.exp (∫ w in (Lsb B.h G.r0 γ.1 / 2)..v,
    (lam0 B G γ / Real.sqrt (1 + sco B G γ w ^ 2)
      - epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs B G γ ^ 2 * (1 + sco B G γ w ^ 2)))
noncomputable def Hcol (B : BG) (G : CorrGeom) (γ : Lab) (s : ℝ × ℝ × ℝ) : ℝ × ℝ :=
  ((1 + bgc^2) / 2 * (∫ u in (-G.r0)..G.r0, chig G.r0 u ^ 2) * cib B.h γ.1) •
    ∫ v in (0:ℝ)..(Lsb B.h G.r0 γ.1), (psiT (Lsb B.h G.r0 γ.1) v ^ 2 * (G.tH γ s v) 0) •
      ((G.tH γ s v) 1, (G.tH γ s v) 2)
noncomputable def T0star (B : BG) (l : ℕ) (ξ : Cyl) : ℝ × ℝ :=
  (Qb l / qC B.h ξ) ^ (1 + B.h) • (B.T0th (XC B.h ξ) (etaC B.h ξ), B.T0z (XC B.h ξ) (etaC B.h ξ))
noncomputable def yAmp (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl) : ℝ :=
  let s : ℝ × ℝ × ℝ := (ξ.1, ξ.2.1, ξ.2.2.1)
  let Hp := Hcol B G (γ.1, γ.2.1, true) s
  let Hm := Hcol B G (γ.1, γ.2.1, false) s
  let T := T0star B γ.1 ξ
  let det := Hp.1 * Hm.2 - Hm.1 * Hp.2
  if γ.2.2 then (Hm.2 * T.1 - Hm.1 * T.2) / det else (Hp.1 * T.2 - Hp.2 * T.1) / det
open Classical in
noncomputable def W0c (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl) : Fin 3 → ℝ :=
  if ActiveL B G γ ∧ inRect B.h γ (G.ctr γ) (2 * G.r0) ξ.2.2.2 then
    (Real.sqrt (epsb B.h γ.1) / 2 * etaL B.h γ ξ * Real.sqrt (max (yAmp B G γ ξ) 0) *
      chig G.r0 (xiG B.h γ (G.ctr γ) ξ.2.2.2) * psiT (Lsb B.h G.r0 γ.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) •
      G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)
  else 0

abbrev WC := Lab → ℤ → Cyl → (Fin 3 → ℂ)
abbrev WS := Lab → ℤ → Cyl → ℂ
noncomputable def qsOf (l0 : ℕ) : ℝ := Qb l0
def SuppW (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl) : Prop :=
  ActiveL B G γ ∧ ξ ∈ tsupport (etaL B.h γ) ∧ |xiG B.h γ (G.ctr γ) ξ.2.2.2| ≤ G.r0 / 4 ∧
  |etG B.h γ (G.ctr γ) ξ.2.2.2| ≤ G.r0 ∧ B.Xa ≤ XC B.h ξ ∧ XC B.h ξ ≤ B.Xb
def InWg {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (B : BG) (G : CorrGeom) (qs α : ℝ)
    (a : Lab → ℤ → Cyl → V) : Prop :=
  (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → a γ m = 0) ∧
  (∀ γ m, ContDiffOn ℝ ∞ (a γ m) (DomC B.h qs)) ∧
  (∀ γ m, ∀ ξ ∈ DomC B.h qs, ∀ c, IsDeck B.h (qC B.h ξ) c → a γ m (shY ξ c) = a γ m ξ) ∧
  (∀ γ m ξ, ξ ∈ DomC B.h qs → a γ m ξ ≠ 0 → SuppW B G γ ξ) ∧
  ∀ k : ℕ, ∃ C b d : ℝ, ∀ γ m, ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
    NB B.h (a γ m) k ξ ≤ C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b *
      Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) *
      Penv B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)
noncomputable def ephase (B : BG) (G : CorrGeom) (γ : Lab) (m : ℤ) (θ : ℝ) (ξ : Cyl) : ℂ :=
  Complex.exp (Complex.I * (m : ℂ) * ((pint B G γ : ℂ) * (θ : ℂ) + (kb B.h γ.1 : ℂ) * (phiL B G γ ξ : ℂ)))
noncomputable def waveV (B : BG) (G : CorrGeom) (a : WC) (θ : ℝ) (ξ : Cyl) : Fin 3 → ℝ :=
  fun i => (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, a γ m ξ i * ephase B G γ m θ ξ).re
noncomputable def waveS (B : BG) (G : CorrGeom) (a : WS) (θ : ℝ) (ξ : Cyl) : ℝ :=
  (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, a γ m ξ * ephase B G γ m θ ξ).re
noncomputable def velC (B : BG) (G : CorrGeom) (Cc : WC) (γ : Lab) (m : ℤ) (ξ : Cyl) : Fin 3 → ℂ :=
  let n : Fin 3 → ℂ := fun i => (nPhi B G γ ξ i : ℂ)
  let C := Cc γ m ξ
  let ikm : ℂ := Complex.I * (kb B.h γ.1 : ℂ) * (m : ℂ)
  let Dr : Fin 3 → ℂ := fun i => DrC B γ.1 (fun η => Cc γ m η i) ξ
  let Dz : Fin 3 → ℂ := fun i => DzC B γ.1 (fun η => Cc γ m η i) ξ
  ![ikm * (n 1 * C 2 - n 2 * C 1) - Dz 1,
    ikm * (n 2 * C 0 - n 0 * C 2) + Dz 0 - Dr 2,
    ikm * (n 0 * C 1 - n 1 * C 0) + Dr 1 + C 1 / (RC γ.1 ξ : ℂ)]
structure CState where
  Aw : WC
  pw : WS
  Psi : Cyl → ℝ
  bdir : Cyl → ℝ
noncomputable def Aex (h : ℝ) : ℝ := 1/2 + h
def corrOn (B : BG) (l0 : ℕ) (x : ℝ³) (t : ℝ) : Prop :=
  0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0
noncomputable def ptOf (x : ℝ³) (t : ℝ) (Y : ℝ × ℝ) : Cyl := (rad x, x 2, t, Y)
open Classical in
noncomputable def AX (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) : Ext ℝ³ := fun x t Y =>
  B.AB x t + (if corrOn B l0 x t then
    qC B.h (ptOf x t Y) ^ (1/2 - Aex B.h) • (cyl2cart x (waveV B G S.Aw (thetaOf x) (ptOf x t Y))
      + S.Psi (ptOf x t Y) • eTh x) else 0)
open Classical in
noncomputable def BX (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) : Ext ℝ³ := fun x t Y =>
  B.BvB x t + (if corrOn B l0 x t then (qC B.h (ptOf x t Y) ^ (-Aex B.h) * S.bdir (ptOf x t Y)) • eTh x else 0)


noncomputable def uX (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) : Ext ℝ³ :=
  fun x t Y => curlX B.h (AX B G l0 S) x t Y + BX B G l0 S x t Y
noncomputable def frameAt (θ : ℝ) (ξ : Cyl) : Fin 3 → ℝ³ :=
  ![eR (rotPt ξ.1 θ ξ.2.1), eTh (rotPt ξ.1 θ ξ.2.1), eZ]
noncomputable def ucyl (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (θ : ℝ) (ξ : Cyl) (a : Fin 3) : ℝ :=
  inner ℝ (uX B G l0 S (rotPt ξ.1 θ ξ.2.1) ξ.2.2.1 ξ.2.2.2) (frameAt θ ξ a)
noncomputable def thA (f : ℝ → ℝ) : ℝ := (2 * Real.pi)⁻¹ * ∫ θ in (0:ℝ)..(2 * Real.pi), f θ
noncomputable def ubase (B : BG) (ξ : Cyl) (a : Fin 3) : ℝ :=
  inner ℝ (uB B (rotPt ξ.1 0 ξ.2.1) ξ.2.2.1) (frameAt 0 ξ a)
noncomputable def mcor (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (a : Fin 3) (ξ : Cyl) : ℝ :=
  thA (fun θ => ucyl B G l0 S θ ξ a) - ubase B ξ a
noncomputable def Wcov (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (a b : Fin 3) (ξ : Cyl) : ℝ :=
  thA (fun θ => (ucyl B G l0 S θ ξ a - thA (fun θ' => ucyl B G l0 S θ' ξ a)) *
               (ucyl B G l0 S θ ξ b - thA (fun θ' => ucyl B G l0 S θ' ξ b)))
noncomputable def sBase (B : BG) (a : Fin 3) (ξ : Cyl) : ℝ :=
  inner ℝ (stressDivField B.h B.Tth B.Tz (rotPt ξ.1 0 ξ.2.1) ξ.2.2.1) (frameAt 0 ξ a)
noncomputable def lap0 (h : ℝ) (f : Cyl → ℝ) (ξ : Cyl) : ℝ :=
  dR h (dR h f) ξ + dR h f ξ / ξ.1 + dZ (dZ f) ξ
noncomputable def grP (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (ξ : Cyl) : ℝ :=
  let b : Cyl → ℝ := fun η => ubase B η 0
  let V : Cyl → ℝ := fun η => ubase B η 1
  let Gz : Cyl → ℝ := fun η => ubase B η 2
  let β : Cyl → ℝ := mcor B G l0 S 0
  let v : Cyl → ℝ := mcor B G l0 S 1
  let γz : Cyl → ℝ := mcor B G l0 S 2
  let W := Wcov B G l0 S
  (0:ℝ) - dT β ξ - (dR B.h (fun η => 2 * b η * β η + β η ^ 2 + W 0 0 η) ξ
             + (2 * b ξ * β ξ + β ξ ^ 2 + W 0 0 ξ) / ξ.1)
  - dZ (fun η => b η * γz η + Gz η * β η + β η * γz η + W 2 0 η) ξ
  + (2 * V ξ * v ξ + v ξ ^ 2 + W 1 1 ξ) / ξ.1 + (lap0 B.h β ξ - β ξ / ξ.1 ^ 2)
noncomputable def chiM (B : BG) (X : ℝ) : ℝ := Real.smoothTransition ((X - B.m1) / (B.m2 - B.m1))
noncomputable def rhoHat (B : BG) (s : ℝ) : ℝ :=
  bumpR ((s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) / ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) /
    ∫ u in (Real.sqrt (2 * B.m1))..(Real.sqrt (2 * B.m2)),
      bumpR ((u - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) / ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2))
noncomputable def rhoP (B : BG) (ξ : Cyl) : ℝ := qC B.h ξ ^ (-(1/2:ℝ)) * rhoHat B (ξ.1 / Real.sqrt (qC B.h ξ))
noncomputable def pathPt (h : ℝ) (ξ : Cyl) (r' : ℝ) : Cyl :=
  (r', ξ.2.1, ξ.2.2.1, ξ.2.2.2 + (r' ^ drx h - ξ.1 ^ drx h) • vrv)
noncomputable def Icut (B : BG) (g : Cyl → ℝ) (ξ : Cyl) : ℝ :=
  (∫ r' in (0:ℝ)..ξ.1, g (pathPt B.h ξ r')) - chiM B (XC B.h ξ) * ∫ r' in Set.Ioi (0:ℝ), g (pathPt B.h ξ r')
noncomputable def calP (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (z t : ℝ) : ℝ :=
  radMom (grP B G l0 S) 0 z t
noncomputable def pmP (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (ξ : Cyl) : ℝ :=
  Icut B (fun η => grP B G l0 S η - rhoP B η * calP B G l0 S η.2.1 η.2.2.1) ξ
open Classical in
noncomputable def PX (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) : Ext ℝ := fun x t Y =>
  B.PB x t + (if corrOn B l0 x t then pmP B G l0 S (ptOf x t Y) +
    qC B.h (ptOf x t Y) ^ (-2 * Aex B.h) * waveS B G S.pw (thetaOf x) (ptOf x t Y) else 0)
noncomputable def fA (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) : ℝ³ → ℝ → ℝ³ := evOff B.h (AX B G l0 S) 0
noncomputable def fB (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) : ℝ³ → ℝ → ℝ³ := evOff B.h (BX B G l0 S) 0
noncomputable def fP (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) : ℝ³ → ℝ → ℝ := evOff B.h (PX B G l0 S) 0
noncomputable def fU (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) : ℝ³ → ℝ → ℝ³ :=
  fun y s => curl3 (fun w => fA B G l0 S w s) y + fB B G l0 S y s
noncomputable def fRes (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) : ℝ³ → ℝ → ℝ³ :=
  nsResidual 1 (fU B G l0 S) (fP B G l0 S)
noncomputable def EthP (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (ξ : Cyl) : ℝ :=
  let b : Cyl → ℝ := fun η => ubase B η 0
  let V : Cyl → ℝ := fun η => ubase B η 1
  let Gz : Cyl → ℝ := fun η => ubase B η 2
  let β : Cyl → ℝ := mcor B G l0 S 0
  let v : Cyl → ℝ := mcor B G l0 S 1
  let γz : Cyl → ℝ := mcor B G l0 S 2
  let W := Wcov B G l0 S
  dT v ξ + dR B.h (fun η => b η * v η + β η * V η + β η * v η + W 0 1 η) ξ
    + 2 * (b ξ * v ξ + β ξ * V ξ + β ξ * v ξ + W 0 1 ξ) / ξ.1
    + dZ (fun η => Gz η * v η + V η * γz η + γz η * v η + W 2 1 η) ξ
    - (lap0 B.h v ξ - v ξ / ξ.1 ^ 2) + sBase B 1 ξ
noncomputable def EzP (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (ξ : Cyl) : ℝ :=
  let b : Cyl → ℝ := fun η => ubase B η 0
  let Gz : Cyl → ℝ := fun η => ubase B η 2
  let β : Cyl → ℝ := mcor B G l0 S 0
  let γz : Cyl → ℝ := mcor B G l0 S 2
  let W := Wcov B G l0 S
  dT γz ξ + dR B.h (fun η => b η * γz η + β η * Gz η + β η * γz η + W 0 2 η) ξ
    + (b ξ * γz ξ + β ξ * Gz ξ + β ξ * γz ξ + W 0 2 ξ) / ξ.1
    + dZ (fun η => 2 * Gz η * γz η + γz η ^ 2 + W 2 2 η + pmP B G l0 S η) ξ
    - lap0 B.h γz ξ + sBase B 2 ξ
noncomputable def calJth (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (z t : ℝ) : ℝ :=
  radMom (fun η => ubase B η 2 * mcor B G l0 S 1 η + ubase B η 1 * mcor B G l0 S 2 η
                   + mcor B G l0 S 2 η * mcor B G l0 S 1 η + Wcov B G l0 S 2 1 η) 2 z t
noncomputable def calJz (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (z t : ℝ) : ℝ :=
  radMom (fun η => 2 * ubase B η 2 * mcor B G l0 S 2 η + mcor B G l0 S 2 η ^ 2 + Wcov B G l0 S 2 2 η) 1 z t
  - (1/2) * radMom (grP B G l0 S) 2 z t


noncomputable def nrm (B : BG) (e : ℝ) (f : Cyl → ℝ) : Cyl → ℝ := fun ξ => qC B.h ξ ^ e * f ξ
noncomputable def nrmS (B : BG) (e : ℝ) (F : ℝ → ℝ → ℝ) : ℝ × ℝ → ℝ :=
  fun w => simScale B.h w.1 (1 - w.2) ^ e * F w.1 w.2
noncomputable def W0h (B : BG) (G : CorrGeom) : WC :=
  fun γ m ξ => if m = 1 ∨ m = -1 then (fun i => ((W0c B G γ ξ i : ℝ) : ℂ)) else 0
noncomputable def velW (B : BG) (G : CorrGeom) (a : WC) : WC := fun γ m => velC B G a γ m
def FlatX (B : BG) (qs : ℝ) (Fl : Ext ℝ³) : Prop :=
  ∀ m N : ℕ, ∃ C : ℝ, ∀ Y₀ : ℝ × ℝ, ∀ x t, (x, t) ∈ simDomain B.h qs →
    ‖iteratedFDeriv ℝ m (↿(evOff B.h Fl Y₀)) (x, t)‖ ≤ C * simScale B.h (x 2) (1 - t) ^ (N : ℝ)
noncomputable def meanResP (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (ξ : Cyl) : Fin 3 → ℝ :=
  ![dR B.h (pmP B G l0 S) ξ - grP B G l0 S ξ, EthP B G l0 S ξ, EzP B G l0 S ξ]
def ShellSupp (B : BG) (f : Cyl → ℝ) : Prop := ∀ ξ, (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → f ξ = 0
noncomputable def thAvgVec (F : Ext ℝ³) (x : ℝ³) (t : ℝ) (Y : ℝ × ℝ) : ℝ³ :=
  cyl2cart x (fun a => thA (fun θ => inner ℝ (F (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)))
noncomputable def radRem (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (ξ : Cyl) : ℝ :=
  dR B.h (pmP B G l0 S) ξ - grP B G l0 S ξ + rhoP B ξ * calP B G l0 S ξ.2.1 ξ.2.2.1
def StOrd (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (bw ca cm cd : ℝ) : Prop :=
  InWg B G (qsOf l0) 1 S.Aw ∧ InWg B G (qsOf l0) 1 S.pw ∧ InM B (qsOf l0) (1/2) S.Psi ∧
  InM B (qsOf l0) (1/2) S.bdir ∧ ShellSupp B S.Psi ∧ ShellSupp B S.bdir ∧
  (∃ (f : WC) (Fl : Ext ℝ³), InWg B G (qsOf l0) bw f ∧ FlatX B (qsOf l0) Fl ∧
    ∀ x t Y, corrOn B l0 x t →
      resX B.h (uX B G l0 S) (PX B G l0 S) x t Y - thAvgVec (resX B.h (uX B G l0 S) (PX B G l0 S)) x t Y =
        (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) • cyl2cart x (waveV B G f (thetaOf x) (ptOf x t Y))
          + Fl x t Y) ∧
  InM B (qsOf l0) cm (nrm B (2 * Aex B.h + 1/2) (EthP B G l0 S)) ∧
  InM B (qsOf l0) cm (nrm B (2 * Aex B.h + 1/2) (EzP B G l0 S)) ∧
  InM B (qsOf l0) ca (nrm B (2 * Aex B.h + 1/2) (yAvg (EthP B G l0 S))) ∧
  InM B (qsOf l0) ca (nrm B (2 * Aex B.h + 1/2) (yAvg (EzP B G l0 S))) ∧
  InS B (qsOf l0) cd (nrmS B (2 * Aex B.h) (calP B G l0 S)) ∧
  InS B (qsOf l0) cd (nrmS B (2 * Aex B.h - 3/2) (calJth B G l0 S)) ∧
  InS B (qsOf l0) cd (nrmS B (2 * Aex B.h - 1) (calJz B G l0 S)) ∧
  (∀ m N : ℕ, ∃ C : ℝ, ∀ Y₀ : ℝ × ℝ, ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) → 0 < rad x →
    ‖iteratedFDeriv ℝ m (↿(fun y s => radRem B G l0 S (ptOf y s (Yph B.h (rad y) s + Y₀)))) (x, t)‖
      ≤ C * simScale B.h (x 2) (1 - t) ^ (N : ℝ)) ∧
  InWg B G (qsOf l0) (1/2) (velW B G S.Aw) ∧ InWg B G (qsOf l0) 0.68 (velW B G S.Aw - W0h B G) ∧
  InM B (qsOf l0) 0.9 (nrm B (Aex B.h) (mcor B G l0 S 1)) ∧
  InM B (qsOf l0) 0.9 (nrm B (Aex B.h) (mcor B G l0 S 2)) ∧
  InM B (qsOf l0) 0.9 (nrm B (2 * Aex B.h) (pmP B G l0 S)) ∧
  InM B (qsOf l0) 1.9 (nrm B (Aex B.h) (mcor B G l0 S 0)) ∧
  (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → radMom (mcor B G l0 S 1) 2 z t = 0) ∧
  (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → radMom (mcor B G l0 S 2) 1 z t = 0)
def Incr (B : BG) (G : CorrGeom) (l0 : ℕ) (S S' : CState) (o : ℝ) : Prop :=
  InWg B G (qsOf l0) o (S'.Aw - S.Aw) ∧ InWg B G (qsOf l0) o (velW B G (S'.Aw - S.Aw)) ∧
  InWg B G (qsOf l0) o (S'.pw - S.pw) ∧
  InM B (qsOf l0) o (S'.Psi - S.Psi) ∧ InM B (qsOf l0) o (S'.bdir - S.bdir) ∧
  InM B (qsOf l0) o (nrm B (2 * Aex B.h) (fun ξ => pmP B G l0 S' ξ - pmP B G l0 S ξ)) ∧
  InM B (qsOf l0) (o + 1) (nrm B (Aex B.h) (fun ξ => mcor B G l0 S' 0 ξ - mcor B G l0 S 0 ξ)) ∧
  InM B (qsOf l0) o (nrm B (Aex B.h) (fun ξ => mcor B G l0 S' 2 ξ - mcor B G l0 S 2 ξ))


def GeomPrim (B : BG) (G : CorrGeom) : Prop :=
  (0 < G.r0 ∧ G.r0 ≤ 1/100 ∧ 0 < G.ustar ∧ 0 < G.Crep ∧ 40 ≤ G.lmin) ∧
  (∀ γ γ' : Lab, γ ≠ γ' → G.lmin ≤ γ.1 → G.lmin ≤ γ'.1 → (∃ ξ, etaL B.h γ ξ ≠ 0 ∧ etaL B.h γ' ξ ≠ 0) →
     Disjoint (closure (rectAbs B G γ (2 * G.r0))) (closure (rectAbs B G γ' (2 * G.r0)))) ∧
  (∀ γ, ActiveL B G γ → B.Xa ≤ (G.rep γ).1 ∧ (G.rep γ).1 ≤ B.Xb ∧ |(G.rep γ).2.1| ≤ 1 - Sb γ.1 ^ (-3:ℤ) ∧
     1/2 ≤ (G.rep γ).2.2 ∧ (G.rep γ).2.2 ≤ 2 ∧ ∀ ξ, etaL B.h γ ξ ≠ 0 →
       |XC B.h ξ - (G.rep γ).1| + |etaC B.h ξ - (G.rep γ).2.1| + |qC B.h ξ / Qb γ.1 - (G.rep γ).2.2|
         ≤ G.Crep * Sb γ.1 ^ (-3:ℤ)) ∧
  (∃ ηm : ℝ, 0 < ηm ∧ ∀ γ, ActiveL B G γ → ∀ ξ, etaL B.h γ ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
     B.T0th (XC B.h ξ) (etaC B.h ξ) * (Nfr B G γ).1 + B.T0z (XC B.h ξ) (etaC B.h ξ) * (Nfr B G γ).2
       ≤ -ηm * eN (B.T0th (XC B.h ξ) (etaC B.h ξ), B.T0z (XC B.h ξ) (etaC B.h ξ)) ∧
     |c0f B G γ| * |B.T0th (XC B.h ξ) (etaC B.h ξ) * (Kfr B G γ).1 + B.T0z (XC B.h ξ) (etaC B.h ξ) * (Kfr B G γ).2|
       ≤ (1 - ηm) * (G.ustar / Real.sqrt (1 + G.ustar ^ 2)) *
         |B.T0th (XC B.h ξ) (etaC B.h ξ) * (Nfr B G γ).1 + B.T0z (XC B.h ξ) (etaC B.h ξ) * (Nfr B G γ).2|) ∧
  (∀ γ, ¬ ActiveL B G γ → ∀ s v, G.tH γ s v = 0) ∧
  (∀ γ, ActiveL B G γ → ∀ ξ : Cyl, etaL B.h γ ξ ≠ 0 → inRect B.h γ (G.ctr γ) G.r0 ξ.2.2.2 →
     HasDerivAt (G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1))
       ((APhi B G γ ξ).mulVec (G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2))
         - dDamp B G γ ξ • G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2))
       (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) ∧
     (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 = 0 → G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) 0 = Penv B G γ 0 • Bcol B G γ ξ 1)) ∧
  (∀ γ, ContDiff ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => G.tH γ w.1 w.2))


def telD {X : Type} [AddCommGroup X] (f : ℕ → X) : ℕ → X
  | 0 => f 0
  | (j + 1) => f (j + 1) - f j


def MeanId (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) : Prop :=
  ∃ Fl : Ext ℝ³, FlatX B (qsOf l0) Fl ∧ ∀ x t Y, corrOn B l0 x t →
    thAvgVec (resX B.h (uX B G l0 S) (PX B G l0 S)) x t Y = cyl2cart x (meanResP B G l0 S (ptOf x t Y)) + Fl x t Y
noncomputable def psLead1 (h : ℝ) (F U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ := X * leadQs h F U X η / (1 - 2 * h * η ^ 2)

noncomputable def psLead2 (h : ℝ) (F U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  X * leadNs h F U X η / ((1 - 2 * h * η ^ 2) * (Real.sqrt (2 * X) * F X η))

noncomputable def coneUp (P J : ℝ) : ℝ := P + J ^ 2 / 4 - |J| * Real.sqrt ((P - 2) / 2 + J ^ 2 / 16)

noncomputable def refFin (Pst XR X η : ℝ) : ℝ := Pst * (1 + η ^ 2)⁻¹ * (X / XR) ^ (1 / 10 : ℝ) / Real.sqrt (2 * X)

def RelaxCone (h μ : ℝ) (S : Set ℝ) (F U : ℝ → ℝ → ℝ) : Prop :=
  ∀ X ∈ S, ∀ η : ℝ, -1 < η → η < 1 →
    μ ≤ F X η ∧ μ ≤ shearA F X η ∧
    μ ≤ psLead1 h F U X η - shearB F U X η / shearA F X η * psLead2 h F U X η - 2 ∧
    μ ≤ coneUp (psLead1 h F U X η - shearB F U X η / shearA F X η * psLead2 h F U X η)
          (psLead2 h F U X η + shearB F U X η / shearA F X η * psLead1 h F U X η)
        - shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2)

def AdmBlk (h : ℝ) (w δ : ℝ → ℝ) (S : Set ℝ) (F U : ℝ → ℝ → ℝ) : Prop :=
  (∃ c₀ : ℝ, 0 < c₀ ∧ ∀ X ∈ S, ∀ η : ℝ, -1 < η → η < 1 →
      c₀ * w X ≤ Real.sqrt (leadStressTh h F U X η ^ 2 + leadStressTz h F U X η ^ 2)) ∧
  (∀ m : ℕ, ∃ C N : ℝ, ∀ X ∈ S, ∀ η : ℝ, -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿(leadStressTh h F U)) (X, η)‖ ≤ C * w X * δ X ^ (-N) ∧
      ‖iteratedFDeriv ℝ m (↿(leadStressTz h F U)) (X, η)‖ ≤ C * w X * δ X ^ (-N) ∧
      ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ => leadStressTh h F U z.1 z.2 /
          Real.sqrt (leadStressTh h F U z.1 z.2 ^ 2 + leadStressTz h F U z.1 z.2 ^ 2)) (X, η)‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ => leadStressTz h F U z.1 z.2 /
          Real.sqrt (leadStressTh h F U z.1 z.2 ^ 2 + leadStressTz h F U z.1 z.2 ^ 2)) (X, η)‖ ≤ C) ∧
  (∃ κ : ℝ, 0 < κ ∧ κ < 2 ∧ ∀ X ∈ S, ∀ η : ℝ, -1 < η → η < 1 →
      κ ≤ F X η ∧ κ ≤ shearA F X η ∧
      κ ≤ shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) - 2 ∧
      κ * Real.sqrt (leadStressTh h F U X η ^ 2 + leadStressTz h F U X η ^ 2) ≤
        leadStressTh h F U X η - shearB F U X η / shearA F X η * leadStressTz h F U X η ∧
      (shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) - 2) *
          (leadStressTz h F U X η + shearB F U X η / shearA F X η * leadStressTh h F U X η) ^ 2 ≤
        (2 - κ) * (leadStressTh h F U X η - shearB F U X η / shearA F X η * leadStressTz h F U X η) ^ 2)

def AxDatum (h Pst : ℝ) (Pax : ℝ → ℝ) : Prop :=
  0 < h ∧ h < 1 / 100 ∧ 0 < Pst ∧ Real.exp 10 < Pst ∧
  (∃ ρ : ℝ, 0 < ρ ∧ ∃ Pc : ℂ → ℂ,
     DifferentiableOn ℂ Pc {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
     ∀ η : ℝ, -1 - ρ < η → η < 1 + ρ → Pc (η : ℂ) = ((Pax η : ℝ) : ℂ)) ∧
  (∀ η : ℝ, Pax (-η) = Pax η) ∧
  (∀ η : ℝ, -1 ≤ η → η ≤ 1 → Pax η ≤ -(5 / 2) * Pst ^ 2 * ((1 + η ^ 2)⁻¹) ^ 2) ∧
  (∀ η : ℝ, -1 ≤ η → η ≤ 1 → η ≠ 0 → 0 < η * deriv Pax η)

def OutProf (h lam Pst XR cpatch cinf ab Xg Xg2 r1 r2 p1 p2 m1 m2 Xv Xc Xb : ℝ) (Pax : ℝ → ℝ)
    (Fo Uo : ℝ → ℝ → ℝ) : Prop :=
  (0 < cpatch ∧ 0 < cinf ∧ 0 < ab ∧ 0 < XR ∧ XR < Xg ∧ Xg < Xg2 ∧ Xg2 < r1 ∧ r1 < r2 ∧ r2 < p1 ∧
      p1 < p2 ∧ p2 < m1 ∧ m1 < m2 ∧ m2 < Xv ∧ Xv < Xc ∧ Xc < Xb) ∧
  (ContDiffOn ℝ ∞ (↿Fo) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿Uo) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    (∀ X η : ℝ, 0 < X → -1 < η → η < 1 → 0 < Fo X η) ∧
    (∀ X₀ X₁ : ℝ, 0 < X₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, X₀ ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿Fo) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿Uo) (X, η)‖ ≤ C)) ∧
  (∀ X η : ℝ, 0 < X → X ≤ XR → -1 < η → η < 1 → Uo X η = 4 * η ∧ Fo X η = refFin Pst XR X η) ∧
  (∀ X η : ℝ, ((r1 ≤ X ∧ X ≤ r2) ∨ (p1 ≤ X ∧ X ≤ p2) ∨ (m1 ≤ X ∧ X ≤ m2)) → -1 < η → η < 1 →
      Uo X η = 0 ∧ Real.sqrt (2 * X) * Fo X η = cpatch * (1 + η ^ 2)⁻¹ * X ^ (-(1 / 2 + lam))) ∧
  (∀ X η : ℝ, Xb ≤ X → -1 < η → η < 1 → Uo X η = 0 ∧
      Real.sqrt (2 * X) * Fo X η = cinf * X ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - η ^ 2) / X)) ∧
  (∀ X η : ℝ, Xv ≤ X → -1 < η → η < 1 → Uo X η = 0 ∧ profRadInt Uo X η = 0) ∧
  (∀ η : ℝ, -1 < η → η < 1 →
      IntegrableOn (fun x => Uo x η * (2 * x * Fo x η)) (Ioi 0) ∧
      IntegrableOn (fun x => Uo x η ^ 2 - x * Fo x η ^ 2) (Ioi 0) ∧
      IntegrableOn (fun x => 2 * x * Fo x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h))) (Ioi 0) ∧
      IntegrableOn (fun x => Fo x η ^ 2) (Ioi 0) ∧
      (∫ x in Ioi (0:ℝ), Uo x η * (2 * x * Fo x η)) = 0 ∧
      (∫ x in Ioi (0:ℝ), (Uo x η ^ 2 - x * Fo x η ^ 2)) = 0 ∧
      (∫ x in Ioi (0:ℝ), (2 * x * Fo x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h)))) = 0 ∧
      leadPi Fo 0 η = Pax η) ∧
  (∀ η : ℝ, -1 < η → η < 1 → ∀ X : ℝ, 0 ≤ X →
      IntervalIntegrable (fun x => Uo x η) volume 0 X ∧
      IntervalIntegrable (fun x => 2 * x * Fo x η) volume 0 X ∧
      IntervalIntegrable (fun x => Uo x η * (2 * x * Fo x η)) volume 0 X ∧
      IntervalIntegrable (fun x => Uo x η ^ 2 - x * Fo x η ^ 2) volume 0 X ∧
      IntervalIntegrable (fun x => Fo x η ^ 2) volume 0 X) ∧
  (∀ m : ℕ, ∃ C N : ℝ, ∀ X η : ℝ, Xc ≤ X → X < Xb → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ => Real.sqrt (2 * w.1) * Fo w.1 w.2 -
          cinf * w.1 ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - w.2 ^ 2) / w.1)) (X, η)‖ ≤
        C * Real.exp (-(ab / Real.log (Xb / X) ^ 2)) * (min 1 (Real.log (Xb / X))) ^ (-N)) ∧
  ((∀ X η : ℝ, Xb ≤ X → -1 < η → η < 1 →
      leadStressTh h Fo Uo X η = 0 ∧ leadStressTz h Fo Uo X η = 0) ∧
    ContDiffOn ℝ ∞ (↿(leadStressTh h Fo Uo)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿(leadStressTz h Fo Uo)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    AdmBlk h (fun X => Real.exp (-(ab / Real.log (Xb / X) ^ 2))) (fun X => min 1 (Real.log (Xb / X)))
      (Ico Xg Xb) Fo Uo ∧
    (∃ μ : ℝ, 0 < μ ∧ RelaxCone h μ (Icc (XR * Real.exp (-5)) Xg2) Fo Uo))

def AxProf (h Pst XR Xa Xan Xa1 Xa2 Xh1 aa : ℝ) (Pax : ℝ → ℝ) (Fi Ui : ℝ → ℝ → ℝ) : Prop :=
  (0 < XR ∧ 0 < aa ∧ 0 < Xa ∧ Xa < Xan ∧ Xan < Xa1 ∧ Xa1 < Xa2 ∧ Xa2 < Xh1 ∧
      Xh1 < XR * Real.exp (-5)) ∧
  (∃ ε : ℝ, 0 < ε ∧ ContDiffOn ℝ ∞ (↿Fi) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿Ui) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
    (∀ X η : ℝ, 0 ≤ X → -1 < η → η < 1 → 0 < Fi X η) ∧
    (∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿Fi) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿Ui) (X, η)‖ ≤ C)) ∧
  (∀ X η : ℝ, Xh1 ≤ X → -1 < η → η < 1 → Ui X η = 4 * η ∧ Fi X η = refFin Pst XR X η) ∧
  (∃ ρ : ℝ, 0 < ρ ∧ ∃ Fc Uc Pc : ℕ → ℝ → ℂ → ℂ, ∀ k : ℕ, ∃ C : ℝ,
    ContinuousOn (fun p : ℝ × ℂ => Fc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ContinuousOn (fun p : ℝ × ℂ => Uc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ContinuousOn (fun p : ℝ × ℂ => Pc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ∀ X : ℝ, 0 ≤ X → X ≤ Xan →
      DifferentiableOn ℂ (Fc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      DifferentiableOn ℂ (Uc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      DifferentiableOn ℂ (Pc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      (∀ w : ℂ, |w.im| < ρ → -1 - ρ < w.re → w.re < 1 + ρ →
        ‖Fc k X w‖ ≤ C ∧ ‖Uc k X w‖ ≤ C ∧ ‖Pc k X w‖ ≤ C) ∧
      (∀ η : ℝ, -1 < η → η < 1 →
        Fc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Fi Y η) X : ℝ) : ℂ) ∧
        Uc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Ui Y η) X : ℝ) : ℂ) ∧
        Pc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Pax η + profRadInt (fun x e => Fi x e ^ 2) Y η) X : ℝ) : ℂ))) ∧
  (∀ η : ℝ, -1 < η → η < 1 →
     profRadInt Ui (XR * Real.exp (-5)) η = profRadInt (fun _ e => 4 * e) (XR * Real.exp (-5)) η ∧
     profRadInt (fun x e => 2 * x * Fi x e) (XR * Real.exp (-5)) η =
       profRadInt (fun x e => 2 * x * refFin Pst XR x e) (XR * Real.exp (-5)) η ∧
     profRadInt (fun x e => Ui x e * (2 * x * Fi x e)) (XR * Real.exp (-5)) η =
       profRadInt (fun x e => 4 * e * (2 * x * refFin Pst XR x e)) (XR * Real.exp (-5)) η ∧
     profRadInt (fun x e => Ui x e ^ 2 - x * Fi x e ^ 2) (XR * Real.exp (-5)) η =
       profRadInt (fun x e => (4 * e) ^ 2 - x * refFin Pst XR x e ^ 2) (XR * Real.exp (-5)) η ∧
     profRadInt (fun x e => Fi x e ^ 2) (XR * Real.exp (-5)) η =
       profRadInt (fun x e => refFin Pst XR x e ^ 2) (XR * Real.exp (-5)) η) ∧
  (∀ F U : ℝ → ℝ → ℝ,
    (∀ X η : ℝ, 0 < X → X < XR → -1 < η → η < 1 → F X η = Fi X η ∧ U X η = Ui X η) →
    (∀ η : ℝ, -1 < η → η < 1 → IntegrableOn (fun x => F x η ^ 2) (Ioi 0) ∧ leadPi F 0 η = Pax η) →
    (∀ X η : ℝ, 0 < X → X ≤ Xa → -1 < η → η < 1 →
        leadStressTh h F U X η = 0 ∧ leadStressTz h F U X η = 0) ∧
    ContDiffOn ℝ ∞ (↿(leadStressTh h F U)) (Ioo 0 XR ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿(leadStressTz h F U)) (Ioo 0 XR ×ˢ Ioo (-1) 1) ∧
    AdmBlk h (fun X => Real.exp (-(aa / Real.log (X / Xa) ^ 2))) (fun X => min 1 (Real.log (X / Xa)))
      (Ioc Xa Xa2) F U ∧
    (∃ μ : ℝ, 0 < μ ∧ RelaxCone h μ (Icc Xa1 (XR * Real.exp (-5))) F U))

def JoinProf (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xan Xm Xm2 Xp2 Xp r1 r2 : ℝ)
    (F U : ℝ → ℝ → ℝ) : Prop :=
  (0 < h ∧ h < 1 / 100 ∧ 0 < lam ∧ 0 < cinf ∧ 0 < cpatch ∧ 0 < aa ∧ 0 < ab ∧
      0 < Xa ∧ Xa < p1 ∧ p1 < p2 ∧ p2 < m1 ∧ m1 < m2 ∧ m2 < Xv ∧ Xv < Xc ∧ Xc < Xb ∧
      Xa < Xan ∧ Xan < Xm ∧ Xm < Xm2 ∧ Xm2 < Xp2 ∧ Xp2 < Xp ∧ Xp < r1 ∧ r1 < r2 ∧ r2 < p1) ∧
  (∀ X η : ℝ, r1 ≤ X → X ≤ r2 → -1 < η → η < 1 →
      U X η = 0 ∧ Real.sqrt (2 * X) * F X η = cpatch * (1 + η ^ 2)⁻¹ * X ^ (-(1 / 2 + lam))) ∧
  ((∀ X η : ℝ, 0 < X → (X ≤ Xa ∨ Xb ≤ X) → -1 < η → η < 1 →
      leadStressTh h F U X η = 0 ∧ leadStressTz h F U X η = 0) ∧
    ContDiffOn ℝ ∞ (↿(leadStressTh h F U)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿(leadStressTz h F U)) (Ioi 0 ×ˢ Ioo (-1) 1)) ∧
  AdmBlk h (edgeWeight Xa Xb aa ab) (edgeDist Xa Xb) (Ioc Xa Xm2 ∪ Ico Xp2 Xb) F U ∧
  (∃ μ : ℝ, 0 < μ ∧ RelaxCone h μ (Icc Xm Xp) F U) ∧
  (∀ η : ℝ, -1 < η → η < 1 → IntegrableOn (fun x => F x η ^ 2) (Ioi 0) ∧ ∀ X : ℝ, 0 ≤ X →
      IntervalIntegrable (fun x => U x η) volume 0 X ∧
      IntervalIntegrable (fun x => 2 * x * F x η) volume 0 X ∧
      IntervalIntegrable (fun x => U x η * (2 * x * F x η)) volume 0 X ∧
      IntervalIntegrable (fun x => U x η ^ 2 - x * F x η ^ 2) volume 0 X ∧
      IntervalIntegrable (fun x => F x η ^ 2) volume 0 X) ∧
  (ContDiffOn ℝ ∞ (↿F) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿U) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    (∀ X η : ℝ, 0 < X → -1 < η → η < 1 → 0 < F X η) ∧
    (∀ X₀ X₁ : ℝ, 0 < X₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, X₀ ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿F) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿U) (X, η)‖ ≤ C)) ∧
  (∃ ε : ℝ, 0 < ε ∧ ContDiffOn ℝ ∞ (↿F) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
    (∀ η : ℝ, -1 < η → η < 1 → 0 < F 0 η) ∧
    (∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿F) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿U) (X, η)‖ ≤ C)) ∧
  (∃ ρ : ℝ, 0 < ρ ∧ ∃ Fc Uc Pc : ℕ → ℝ → ℂ → ℂ, ∀ k : ℕ, ∃ C : ℝ,
    ContinuousOn (fun p : ℝ × ℂ => Fc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ContinuousOn (fun p : ℝ × ℂ => Uc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ContinuousOn (fun p : ℝ × ℂ => Pc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ∀ X : ℝ, 0 ≤ X → X ≤ Xan →
      DifferentiableOn ℂ (Fc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      DifferentiableOn ℂ (Uc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      DifferentiableOn ℂ (Pc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      (∀ w : ℂ, |w.im| < ρ → -1 - ρ < w.re → w.re < 1 + ρ →
        ‖Fc k X w‖ ≤ C ∧ ‖Uc k X w‖ ≤ C ∧ ‖Pc k X w‖ ≤ C) ∧
      (∀ η : ℝ, -1 < η → η < 1 →
        Fc k X (η : ℂ) = ((iteratedDeriv k (fun Y => F Y η) X : ℝ) : ℂ) ∧
        Uc k X (η : ℂ) = ((iteratedDeriv k (fun Y => U Y η) X : ℝ) : ℂ) ∧
        Pc k X (η : ℂ) = ((iteratedDeriv k (fun Y => leadPi F Y η) X : ℝ) : ℂ))) ∧
  (∀ X η : ℝ, Xb ≤ X → -1 < η → η < 1 → U X η = 0 ∧
      Real.sqrt (2 * X) * F X η = cinf * X ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - η ^ 2) / X)) ∧
  (∀ X η : ℝ, Xv ≤ X → -1 < η → η < 1 → U X η = 0 ∧ profRadInt U X η = 0) ∧
  (∀ X η : ℝ, ((p1 ≤ X ∧ X ≤ p2) ∨ (m1 ≤ X ∧ X ≤ m2)) → -1 < η → η < 1 →
      U X η = 0 ∧ Real.sqrt (2 * X) * F X η = cpatch * (1 + η ^ 2)⁻¹ * X ^ (-(1 / 2 + lam))) ∧
  (∀ η : ℝ, -1 < η → η < 1 →
      (∫ x in Ioi (0:ℝ), U x η * (2 * x * F x η)) = 0 ∧
      (∫ x in Ioi (0:ℝ), (U x η ^ 2 - x * F x η ^ 2)) = 0 ∧
      (∫ x in Ioi (0:ℝ), (2 * x * F x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h)))) = 0) ∧
  (∀ m : ℕ, ∃ C N : ℝ, ∀ X η : ℝ, Xc ≤ X → X < Xb → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ => Real.sqrt (2 * w.1) * F w.1 w.2 -
          cinf * w.1 ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - w.2 ^ 2) / w.1)) (X, η)‖ ≤
        C * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N))

noncomputable def patchF0 (lam cpatch η x : ℝ) : ℝ :=
  cpatch * (1 + η ^ 2)⁻¹ * x ^ (-(1 / 2 + lam)) / Real.sqrt (2 * x)

def repU (β : Fin 2 → ℝ → ℝ) (c : Fin 5 → ℝ) (x : ℝ) : ℝ := c 0 * β 0 x + c 1 * β 1 x

noncomputable def repF (lam cpatch : ℝ) (γ : Fin 3 → ℝ → ℝ) (c : Fin 5 → ℝ) (η x : ℝ) : ℝ :=
  patchF0 lam cpatch η x + c 2 * γ 0 x + c 3 * γ 1 x + c 4 * γ 2 x

def LoopProperty : Prop :=
  ∀ μ A δ0 : ℝ, 0 < μ → 0 < A → 0 < δ0 →
  ∃ κ : ℝ, 0 < κ ∧ ∃ aL bL : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ,
    ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ × ℝ × ℝ => aL z.1 z.2.1 z.2.2.1 z.2.2.2.1 z.2.2.2.2)
      {z : ℝ × ℝ × ℝ × ℝ × ℝ | μ / 2 < z.1 ∧ |z.2.2.2.1| < 2 * A} ∧
    ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ × ℝ × ℝ => bL z.1 z.2.1 z.2.2.1 z.2.2.2.1 z.2.2.2.2)
      {z : ℝ × ℝ × ℝ × ℝ × ℝ | μ / 2 < z.1 ∧ |z.2.2.2.1| < 2 * A} ∧
    (∀ a b p1 p2 : ℝ, μ / 2 < a → |p2| < 2 * A →
      (∀ φ : ℝ, aL a b p1 p2 (φ + 1) = aL a b p1 p2 φ ∧ bL a b p1 p2 (φ + 1) = bL a b p1 p2 φ) ∧
      (∫ φ in (0:ℝ)..1, aL a b p1 p2 φ) = a ∧ (∫ φ in (0:ℝ)..1, bL a b p1 p2 φ) = b ∧
      (2 + δ0 ≤ a * (1 + (b / a) ^ 2) → ∀ φ : ℝ, aL a b p1 p2 φ = a ∧ bL a b p1 p2 φ = b)) ∧
    (∀ a b p1 p2 φ : ℝ, μ ≤ a → a ≤ A → |b| ≤ A → |p1| ≤ A → |p2| ≤ A →
      μ ≤ p1 - b / a * p2 - 2 →
      μ ≤ coneUp (p1 - b / a * p2) (p2 + b / a * p1) - a * (1 + (b / a) ^ 2) →
      κ ≤ aL a b p1 p2 φ ∧
      κ ≤ aL a b p1 p2 φ * (1 + (bL a b p1 p2 φ / aL a b p1 p2 φ) ^ 2) - 2 ∧
      κ ≤ p1 - bL a b p1 p2 φ / aL a b p1 p2 φ * p2 - 2 ∧
      κ ≤ coneUp (p1 - bL a b p1 p2 φ / aL a b p1 p2 φ * p2)
            (p2 + bL a b p1 p2 φ / aL a b p1 p2 φ * p1)
        - aL a b p1 p2 φ * (1 + (bL a b p1 p2 φ / aL a b p1 p2 φ) ^ 2))

def RepairProperty : Prop :=
  ∀ lam cpatch r1 r2 : ℝ, 0 < lam → 0 < cpatch → 0 < r1 → r1 < r2 →
  ∃ (s1 s2 δ C : ℝ) (β : Fin 2 → ℝ → ℝ) (γ : Fin 3 → ℝ → ℝ) (Φ : (Fin 5 → ℝ) → ℝ → (Fin 5 → ℝ)),
    r1 < s1 ∧ s1 < s2 ∧ s2 < r2 ∧ 0 < δ ∧
    (∀ i, ContDiff ℝ ∞ (β i)) ∧ (∀ j, ContDiff ℝ ∞ (γ j)) ∧
    (∀ i x, (x ≤ s1 ∨ s2 ≤ x) → β i x = 0) ∧ (∀ j x, (x ≤ s1 ∨ s2 ≤ x) → γ j x = 0) ∧
    ContDiffOn ℝ ∞ (fun p : (Fin 5 → ℝ) × ℝ => Φ p.1 p.2)
      (Metric.ball (0 : Fin 5 → ℝ) δ ×ˢ Ioo (-2) 2) ∧
    (∀ η : ℝ, Φ 0 η = 0) ∧
    ∀ (d : Fin 5 → ℝ) (η : ℝ), ‖d‖ < δ → -2 < η → η < 2 →
      ‖Φ d η‖ ≤ C * ‖d‖ ∧
      (∫ x in r1..r2, repU β (Φ d η) x) = d 0 ∧
      (∫ x in r1..r2, 2 * x * (repF lam cpatch γ (Φ d η) η x - patchF0 lam cpatch η x)) = d 1 ∧
      (∫ x in r1..r2, repU β (Φ d η) x * (2 * x * repF lam cpatch γ (Φ d η) η x)) = d 2 ∧
      (∫ x in r1..r2, (repU β (Φ d η) x ^ 2 - x * repF lam cpatch γ (Φ d η) η x ^ 2
          + x * patchF0 lam cpatch η x ^ 2)) = d 3 ∧
      (∫ x in r1..r2, (repF lam cpatch γ (Φ d η) η x ^ 2 - patchF0 lam cpatch η x ^ 2)) = d 4 ∧
      ∀ x : ℝ, r1 ≤ x → x ≤ r2 → patchF0 lam cpatch η x / 2 ≤ repF lam cpatch γ (Φ d η) η x

def ProfileReg (h cinf Xb ε : ℝ) (F U : ℝ → ℝ → ℝ) : Prop :=
  ContDiffOn ℝ ∞ (↿F) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
    (∀ X η : ℝ, 0 ≤ X → -1 < η → η < 1 → 0 < F X η) ∧
    (∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿F) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿U) (X, η)‖ ≤ C) ∧
    (∀ η : ℝ, -1 < η → η < 1 → IntegrableOn (fun x => F x η ^ 2) (Ioi 0)) ∧
    (∀ X η : ℝ, Xb ≤ X → -1 < η → η < 1 → U X η = 0 ∧
      Real.sqrt (2 * X) * F X η = cinf * X ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - η ^ 2) / X))

def LeadPsRegularity : Prop :=
  ∀ (h cinf Xb ε : ℝ) (F U : ℝ → ℝ → ℝ), 0 < h → h < 1 / 100 → 0 < Xb → 0 < ε →
    ProfileReg h cinf Xb ε F U →
    (ContDiffOn ℝ ∞ (↿(psLead1 h F U)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
      ContDiffOn ℝ ∞ (↿(psLead2 h F U)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
      ContDiffOn ℝ ∞ (↿(leadStressTh h F U)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
      ContDiffOn ℝ ∞ (↿(leadStressTz h F U)) (Ioi 0 ×ˢ Ioo (-1) 1)) ∧
    (∀ X₁ X₂ c : ℝ, 0 < X₁ → 0 < c → (∀ X η : ℝ, X₁ ≤ X → X ≤ X₂ → -1 < η → η < 1 → c ≤ F X η) →
      ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, X₁ ≤ X → X ≤ X₂ → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ m (↿(psLead1 h F U)) (X, η)‖ ≤ C ∧
        ‖iteratedFDeriv ℝ m (↿(psLead2 h F U)) (X, η)‖ ≤ C ∧
        ‖iteratedFDeriv ℝ m (↿(leadStressTh h F U)) (X, η)‖ ≤ C ∧
        ‖iteratedFDeriv ℝ m (↿(leadStressTz h F U)) (X, η)‖ ≤ C)

def PsPerturbation : Prop :=
  ∀ (h cinf Xb ε X₁ X₂ c : ℝ) (F U : ℝ → ℝ → ℝ), 0 < h → h < 1 / 100 → 0 < Xb → 0 < ε →
    0 < X₁ → X₁ ≤ X₂ → 0 < c → ProfileReg h cinf Xb ε F U →
    (∀ X η : ℝ, X₁ ≤ X → X ≤ X₂ → -1 < η → η < 1 → c ≤ F X η) →
    ∃ C δ₀ : ℝ, 0 < δ₀ ∧ ∀ (F' U' : ℝ → ℝ → ℝ) (δ : ℝ), ProfileReg h cinf Xb ε F' U' → δ ≤ δ₀ →
      (∀ η : ℝ, -1 < η → η < 1 → leadPi F' 0 η = leadPi F 0 η) →
      (∀ X η : ℝ, 0 ≤ X → X ≤ X₂ → -1 < η → η < 1 →
        |F' X η - F X η| ≤ δ ∧ |U' X η - U X η| ≤ δ ∧
        |deriv (fun e => F' X e) η - deriv (fun e => F X e) η| ≤ δ ∧
        |deriv (fun e => U' X e) η - deriv (fun e => U X e) η| ≤ δ) →
      ∀ X η : ℝ, X₁ ≤ X → X ≤ X₂ → -1 < η → η < 1 →
        |psLead1 h F' U' X η - psLead1 h F U X η| ≤ C * δ ∧
        |psLead2 h F' U' X η - psLead2 h F U X η| ≤ C * δ

def ConeGapQuadratic : Prop :=
  (∀ κ W P J v : ℝ, 0 < κ → 2 + κ ≤ P → v ≤ coneUp P J - κ → P - v ≤ W →
    κ ≤ P - v ∧ (v - 2) * J ^ 2 ≤ (2 - min 1 (2 * κ ^ 2 / W ^ 2)) * (P - v) ^ 2) ∧
  (∀ κ W P J v : ℝ, 0 < κ → κ ≤ 2 → 2 ≤ P → κ ≤ P - v → (v - 2) * J ^ 2 ≤ (2 - κ) * (P - v) ^ 2 →
    P - v ≤ W → |J| ≤ W → κ ^ 3 / (4 * W + W ^ 2) ≤ coneUp P J - v)

def ModulatedFamily (h Xm Xp : ℝ) (F U : ℝ → ℝ → ℝ) (FN UN : ℕ → ℝ → ℝ → ℝ) : Prop :=
  ∃ (Xm' Xp' κ C : ℝ) (N0 : ℕ), Xm < Xm' ∧ Xm' < Xp' ∧ Xp' < Xp ∧ 0 < κ ∧ 1 ≤ N0 ∧
  ∀ N : ℕ, N0 ≤ N →
    (∀ X η : ℝ, (X ≤ Xm' ∨ Xp' ≤ X) → FN N X η = F X η ∧ UN N X η = U X η) ∧
    ContDiffOn ℝ ∞ (↿(FN N)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(UN N)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    (∀ X η : ℝ, 0 < X → -1 < η → η < 1 → 0 < FN N X η) ∧
    (∀ m : ℕ, ∃ C' : ℝ, ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿(FN N)) (X, η)‖ ≤ C' ∧ ‖iteratedFDeriv ℝ m (↿(UN N)) (X, η)‖ ≤ C') ∧
    (∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 →
      |FN N X η - F X η| ≤ C / (N : ℝ) ∧ |UN N X η - U X η| ≤ C / (N : ℝ) ∧
      |deriv (fun e => FN N X e) η - deriv (fun e => F X e) η| ≤ C / (N : ℝ) ∧
      |deriv (fun e => UN N X e) η - deriv (fun e => U X e) η| ≤ C / (N : ℝ) ∧
      κ ≤ shearA (FN N) X η ∧ shearA (FN N) X η ≤ 1 / κ ∧ |shearB (FN N) (UN N) X η| ≤ 1 / κ ∧
      κ ≤ shearA (FN N) X η * (1 + (shearB (FN N) (UN N) X η / shearA (FN N) X η) ^ 2) - 2 ∧
      κ ≤ psLead1 h F U X η - shearB (FN N) (UN N) X η / shearA (FN N) X η * psLead2 h F U X η - 2 ∧
      κ ≤ coneUp (psLead1 h F U X η - shearB (FN N) (UN N) X η / shearA (FN N) X η * psLead2 h F U X η)
            (psLead2 h F U X η + shearB (FN N) (UN N) X η / shearA (FN N) X η * psLead1 h F U X η)
          - shearA (FN N) X η * (1 + (shearB (FN N) (UN N) X η / shearA (FN N) X η) ^ 2))
abbrev bgCoefGood (ε : ℝ) (f : ℝ → ℝ → ℝ) : Prop :=
  ContDiffOn ℝ ∞ (↿f) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) ∧
  ∀ X1 : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X1 → -1 < η → η < 1 →
    ‖iteratedFDeriv ℝ m (↿f) (X, η)‖ ≤ C
noncomputable def sigA (y : ℝ) : ℝ :=
  if y ≤ 0 then 0 else if 1 ≤ y then 1 else
    Real.exp (-1 / y ^ 2) / (Real.exp (-1 / y ^ 2) + Real.exp (-1 / (1 - y) ^ 2))

noncomputable def tailFac (ρ Xb X : ℝ) : ℝ := 1 - ρ * (1 - sigA ((Real.log (X / Xb) + 2) / 2))

noncomputable def shapeDatum (c ϑ : ℝ → ℝ) (η : ℝ) : ℝ :=
  -(1 / 2) * ∫ y, c y ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y)

def ShapeData (Pst : ℝ) (c ϑ : ℝ → ℝ) : Prop :=
  Measurable c ∧ Measurable ϑ ∧ (∀ y, 0 ≤ c y ∧ 0 ≤ ϑ y ∧ ϑ y ≤ 1) ∧
  (∀ y, y ≤ 0 → ϑ y = 1 ∧ c y = Pst * Real.exp (y / 10)) ∧
  (∃ C κ : ℝ, 0 < κ ∧ ∀ y, 0 ≤ y → c y ≤ C * Real.exp (-(κ * y)))

def TailForm (h cinf ρ Xb : ℝ) (F U : ℝ → ℝ → ℝ) : Prop :=
  0 < h ∧ h < 1 / 100 ∧ 0 < cinf ∧ 0 < Xb ∧ 0 ≤ ρ ∧ ρ < 1 ∧
  ContDiffOn ℝ ∞ (↿F) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿U) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
  (∀ X η : ℝ, 0 < X → -1 < η → η < 1 → 0 < F X η) ∧
  (∀ X η : ℝ, Xb * Real.exp (-(11 / 4)) ≤ X → -1 < η → η < 1 →
     U X η = 0 ∧ profRadInt U X η = 0 ∧
     Real.sqrt (2 * X) * F X η =
       cinf * X ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - η ^ 2) / X) * tailFac ρ Xb X) ∧
  (∀ η : ℝ, -1 < η → η < 1 →
     IntegrableOn (fun x => U x η * (2 * x * F x η)) (Ioi 0) ∧
     IntegrableOn (fun x => U x η ^ 2 - x * F x η ^ 2) (Ioi 0) ∧
     IntegrableOn (fun x => 2 * x * F x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h))) (Ioi 0) ∧
     IntegrableOn (fun x => F x η ^ 2) (Ioi 0) ∧
     (∫ x in Ioi (0:ℝ), U x η * (2 * x * F x η)) = 0 ∧
     (∫ x in Ioi (0:ℝ), (U x η ^ 2 - x * F x η ^ 2)) = 0 ∧
     (∫ x in Ioi (0:ℝ), (2 * x * F x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h)))) = 0 ∧
     ∀ X : ℝ, 0 ≤ X →
       IntervalIntegrable (fun x => U x η) volume 0 X ∧
       IntervalIntegrable (fun x => 2 * x * F x η) volume 0 X ∧
       IntervalIntegrable (fun x => U x η * (2 * x * F x η)) volume 0 X ∧
       IntervalIntegrable (fun x => U x η ^ 2 - x * F x η ^ 2) volume 0 X ∧
       IntervalIntegrable (fun x => F x η ^ 2) volume 0 X)
noncomputable def axPi (Pax : ℝ → ℝ) (F : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  Pax η + profRadInt (fun x e => F x e ^ 2) X η

noncomputable def axNs (h : ℝ) (Pax : ℝ → ℝ) (F U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  -leadW h U X η * U X η +
    ((1 / 2 - h) * (profRadInt U X η - η * profEtaD (profRadInt U) X η)
      + 4 * h * η * profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2) X η
      - (1 - η ^ 2) * profEtaD (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2)) X η) / X
    + 4 * (1 / 2 + h) * η * axPi Pax F X η - (1 - η ^ 2) * profEtaD (axPi Pax F) X η

noncomputable def axPs2 (h : ℝ) (Pax : ℝ → ℝ) (F U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  X * axNs h Pax F U X η / ((1 - 2 * h * η ^ 2) * (Real.sqrt (2 * X) * F X η))

noncomputable def axTz (h : ℝ) (Pax : ℝ → ℝ) (F U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  F X η * (axPs2 h Pax F U X η + shearB F U X η)

noncomputable def axSq (h : ℝ) (F U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  -leadW h U X η * (1 + X * deriv (fun Y => F Y η) X / F X η) - h * (1 - 2 * η * U X η)
    - ((1 / 2 - h) * η + (1 - η ^ 2) * U X η) * deriv (fun e => F X e) η / F X η

noncomputable def axSn (h : ℝ) (Pax : ℝ → ℝ) (F U : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
  -leadW h U X η * (X * deriv (fun Y => U Y η) X) - (1 / 2 + h) * (1 - 2 * η * U X η) * U X η
    - ((1 / 2 - h) * η + (1 - η ^ 2) * U X η) * deriv (fun e => U X e) η
    - (1 - η ^ 2) * deriv (fun e => axPi Pax F X e) η + 4 * (1 / 2 + h) * η * axPi Pax F X η
    + 2 * η * X * F X η ^ 2

def AxCone (h μ : ℝ) (Pax : ℝ → ℝ) (S : Set ℝ) (F U : ℝ → ℝ → ℝ) : Prop :=
  ∀ X ∈ S, ∀ η : ℝ, -1 < η → η < 1 →
    μ ≤ F X η ∧ μ ≤ shearA F X η ∧
    μ ≤ psLead1 h F U X η - shearB F U X η / shearA F X η * axPs2 h Pax F U X η - 2 ∧
    μ ≤ coneUp (psLead1 h F U X η - shearB F U X η / shearA F X η * axPs2 h Pax F U X η)
          (axPs2 h Pax F U X η + shearB F U X η / shearA F X η * psLead1 h F U X η)
        - shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2)

def AxAdm (h : ℝ) (Pax : ℝ → ℝ) (w δ : ℝ → ℝ) (S : Set ℝ) (F U : ℝ → ℝ → ℝ) : Prop :=
  (∃ c₀ : ℝ, 0 < c₀ ∧ ∀ X ∈ S, ∀ η : ℝ, -1 < η → η < 1 →
      c₀ * w X ≤ Real.sqrt (leadStressTh h F U X η ^ 2 + axTz h Pax F U X η ^ 2)) ∧
  (∀ m : ℕ, ∃ C N : ℝ, ∀ X ∈ S, ∀ η : ℝ, -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿(leadStressTh h F U)) (X, η)‖ ≤ C * w X * δ X ^ (-N) ∧
      ‖iteratedFDeriv ℝ m (↿(axTz h Pax F U)) (X, η)‖ ≤ C * w X * δ X ^ (-N) ∧
      ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ => leadStressTh h F U z.1 z.2 /
          Real.sqrt (leadStressTh h F U z.1 z.2 ^ 2 + axTz h Pax F U z.1 z.2 ^ 2)) (X, η)‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ => axTz h Pax F U z.1 z.2 /
          Real.sqrt (leadStressTh h F U z.1 z.2 ^ 2 + axTz h Pax F U z.1 z.2 ^ 2)) (X, η)‖ ≤ C) ∧
  (∃ κ : ℝ, 0 < κ ∧ κ < 2 ∧ ∀ X ∈ S, ∀ η : ℝ, -1 < η → η < 1 →
      κ ≤ F X η ∧ κ ≤ shearA F X η ∧
      κ ≤ shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) - 2 ∧
      κ * Real.sqrt (leadStressTh h F U X η ^ 2 + axTz h Pax F U X η ^ 2) ≤
        leadStressTh h F U X η - shearB F U X η / shearA F X η * axTz h Pax F U X η ∧
      (shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) - 2) *
          (axTz h Pax F U X η + shearB F U X η / shearA F X η * leadStressTh h F U X η) ^ 2 ≤
        (2 - κ) * (leadStressTh h F U X η - shearB F U X η / shearA F X η * axTz h Pax F U X η) ^ 2)

noncomputable def axHs (h j0 η : ℝ) : ℝ := (1 / 2 - h) * η + (1 - η ^ 2) * (4 * η + j0)

noncomputable def axZs (h j0 : ℝ) (Pax : ℝ → ℝ) (η : ℝ) : ℝ :=
  -(1 / 2 + h) * (1 - 2 * η * (4 * η + j0)) * (4 * η + j0) - 4 * axHs h j0 η
    - (1 - η ^ 2) * deriv Pax η + 4 * (1 / 2 + h) * η * Pax η

def AxData (h j0 σ δ ρ : ℝ) (Pc : ℂ → ℂ) (Pax : ℝ → ℝ) : Prop :=
  0 < σ ∧ 0 < δ ∧ 0 < ρ ∧ ρ ≤ 1 / 50 ∧
  DifferentiableOn ℂ Pc {w : ℂ | |w.im| < 2 * ρ ∧ -1 - 2 * ρ < w.re ∧ w.re < 1 + 2 * ρ} ∧
  (∀ η : ℝ, -1 - 2 * ρ < η → η < 1 + 2 * ρ → Pc (η : ℂ) = ((Pax η : ℝ) : ℂ)) ∧
  (∀ w : ℂ, |w.im| ≤ ρ → -1 - ρ ≤ w.re → w.re ≤ 1 + ρ →
      ((1 / 2 - (h : ℂ)) * w + (1 - w ^ 2) * (4 * w + (j0 : ℂ))) ^ 2 + ((σ : ℝ) : ℂ) ^ 2 ≠ 0 ∧
      1 - 2 * (h : ℂ) * w ^ 2 ≠ 0) ∧
  (∀ η : ℝ, -1 - ρ ≤ η → η ≤ 1 + ρ → |axZs h j0 Pax η| ≤ δ → 99 * σ ^ 2 < axHs h j0 η ^ 2) ∧
  (∀ η : ℝ, -1 - ρ ≤ η → η ≤ 1 + ρ → 14 / 5 < 3 - 8 * h * η ^ 2 + (1 - 2 * h) * j0 * η)

def AxProfI (h Pst XR Xa Xan Xa1 Xa2 Xh1 aa : ℝ) (Pax : ℝ → ℝ) (Fi Ui : ℝ → ℝ → ℝ) : Prop :=
  (0 < XR ∧ 0 < aa ∧ 0 < Xa ∧ Xa < Xan ∧ Xan < Xa1 ∧ Xa1 < Xa2 ∧ Xa2 < Xh1 ∧
      Xh1 < XR * Real.exp (-5)) ∧
  (∃ ε : ℝ, 0 < ε ∧ ContDiffOn ℝ ∞ (↿Fi) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿Ui) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
    (∀ X η : ℝ, 0 ≤ X → -1 < η → η < 1 → 0 < Fi X η) ∧
    (∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿Fi) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿Ui) (X, η)‖ ≤ C)) ∧
  (∀ X η : ℝ, Xh1 ≤ X → -1 < η → η < 1 → Ui X η = 4 * η ∧ Fi X η = refFin Pst XR X η) ∧
  (∃ ρ : ℝ, 0 < ρ ∧ ∃ Fc Uc Pc : ℕ → ℝ → ℂ → ℂ, ∀ k : ℕ, ∃ C : ℝ,
    ContinuousOn (fun p : ℝ × ℂ => Fc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ContinuousOn (fun p : ℝ × ℂ => Uc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ContinuousOn (fun p : ℝ × ℂ => Pc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ∀ X : ℝ, 0 ≤ X → X ≤ Xan →
      DifferentiableOn ℂ (Fc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      DifferentiableOn ℂ (Uc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      DifferentiableOn ℂ (Pc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      (∀ w : ℂ, |w.im| < ρ → -1 - ρ < w.re → w.re < 1 + ρ →
        ‖Fc k X w‖ ≤ C ∧ ‖Uc k X w‖ ≤ C ∧ ‖Pc k X w‖ ≤ C) ∧
      (∀ η : ℝ, -1 < η → η < 1 →
        Fc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Fi Y η) X : ℝ) : ℂ) ∧
        Uc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Ui Y η) X : ℝ) : ℂ) ∧
        Pc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Pax η + profRadInt (fun x e => Fi x e ^ 2) Y η) X : ℝ) : ℂ))) ∧
  (∀ η : ℝ, -1 < η → η < 1 →
     profRadInt Ui (XR * Real.exp (-5)) η = profRadInt (fun _ e => 4 * e) (XR * Real.exp (-5)) η ∧
     profRadInt (fun x e => 2 * x * Fi x e) (XR * Real.exp (-5)) η =
       profRadInt (fun x e => 2 * x * refFin Pst XR x e) (XR * Real.exp (-5)) η ∧
     profRadInt (fun x e => Ui x e * (2 * x * Fi x e)) (XR * Real.exp (-5)) η =
       profRadInt (fun x e => 4 * e * (2 * x * refFin Pst XR x e)) (XR * Real.exp (-5)) η ∧
     profRadInt (fun x e => Ui x e ^ 2 - x * Fi x e ^ 2) (XR * Real.exp (-5)) η =
       profRadInt (fun x e => (4 * e) ^ 2 - x * refFin Pst XR x e ^ 2) (XR * Real.exp (-5)) η ∧
     profRadInt (fun x e => Fi x e ^ 2) (XR * Real.exp (-5)) η =
       profRadInt (fun x e => refFin Pst XR x e ^ 2) (XR * Real.exp (-5)) η) ∧
  ((∀ X η : ℝ, 0 < X → X ≤ Xa → -1 < η → η < 1 →
      leadStressTh h Fi Ui X η = 0 ∧ axTz h Pax Fi Ui X η = 0) ∧
   AxAdm h Pax (fun X => Real.exp (-(aa / Real.log (X / Xa) ^ 2))) (fun X => min 1 (Real.log (X / Xa)))
      (Ioc Xa Xa2) Fi Ui ∧
   ∃ μ : ℝ, 0 < μ ∧ AxCone h μ Pax (Icc Xa1 (XR * Real.exp (-5))) Fi Ui)

def AxInner (h : ℝ) (Pax : ℝ → ℝ) (ε Bd C Xa Xan Xa1 Xa2 aa τ : ℝ) (ℓ G : ℝ → ℝ) (F U : ℝ → ℝ → ℝ) : Prop :=
  (0 < Xa ∧ Xa < Xan ∧ Xan < Xa1 ∧ Xa1 < Xa2 ∧ Xa2 < 110 * Real.exp (-τ) ∧ 0 < τ ∧ 0 < aa ∧ 1 ≤ C) ∧
  (∃ ε' : ℝ, 0 < ε' ∧ ContDiffOn ℝ ∞ (↿F) (Ioi (-ε') ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿U) (Ioi (-ε') ×ˢ Ioo (-1) 1) ∧
    (∀ X η : ℝ, 0 ≤ X → -1 < η → η < 1 → 0 < F X η) ∧
    (∀ X₁ : ℝ, ∀ m : ℕ, ∃ C' : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿F) (X, η)‖ ≤ C' ∧ ‖iteratedFDeriv ℝ m (↿U) (X, η)‖ ≤ C')) ∧
  (∃ ρ : ℝ, 0 < ρ ∧ ∃ Fc Uc Pc : ℕ → ℝ → ℂ → ℂ, ∀ k : ℕ, ∃ C : ℝ,
    ContinuousOn (fun p : ℝ × ℂ => Fc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ContinuousOn (fun p : ℝ × ℂ => Uc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ContinuousOn (fun p : ℝ × ℂ => Pc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ∀ X : ℝ, 0 ≤ X → X ≤ Xan →
      DifferentiableOn ℂ (Fc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      DifferentiableOn ℂ (Uc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      DifferentiableOn ℂ (Pc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      (∀ w : ℂ, |w.im| < ρ → -1 - ρ < w.re → w.re < 1 + ρ →
        ‖Fc k X w‖ ≤ C ∧ ‖Uc k X w‖ ≤ C ∧ ‖Pc k X w‖ ≤ C) ∧
      (∀ η : ℝ, -1 < η → η < 1 →
        Fc k X (η : ℂ) = ((iteratedDeriv k (fun Y => F Y η) X : ℝ) : ℂ) ∧
        Uc k X (η : ℂ) = ((iteratedDeriv k (fun Y => U Y η) X : ℝ) : ℂ) ∧
        Pc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Pax η + profRadInt (fun x e => F x e ^ 2) Y η) X : ℝ) : ℂ))) ∧
  (∀ X η : ℝ, 110 * Real.exp (-τ) ≤ X → -1 < η → η < 1 →
      U X η = G η ∧ F X η = Real.exp (ℓ η) * (X / 110) ^ (1 / 10 : ℝ) / (C * Real.sqrt (2 * X))) ∧
  ContDiffOn ℝ ∞ ℓ (Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ G (Ioo (-1) 1) ∧
  (∀ η : ℝ, -1 < η → η < 1 → |ℓ η| ≤ Bd ∧ |deriv ℓ η| ≤ Bd ∧ |G η - 4 * η| ≤ ε ∧ |deriv G η - 4| ≤ ε ∧
      -(1 / 2) ≤ -((1 / 2 - h) * η + (1 - η ^ 2) * G η) * deriv ℓ η) ∧
  (∀ X η : ℝ, 0 ≤ X → X ≤ 110 → -1 < η → η < 1 →
      |U X η - 4 * η| ≤ ε ∧ |deriv (fun e => U X e) η - 4| ≤ ε ∧
      C * F X η ≤ Bd ∧ |C * deriv (fun e => F X e) η| ≤ Bd) ∧
  ((∀ X η : ℝ, 0 < X → X ≤ Xa → -1 < η → η < 1 →
      leadStressTh h F U X η = 0 ∧ axTz h Pax F U X η = 0) ∧
   AxAdm h Pax (fun X => Real.exp (-(aa / Real.log (X / Xa) ^ 2))) (fun X => min 1 (Real.log (X / Xa)))
      (Ioc Xa Xa2) F U ∧
   ∃ μ : ℝ, 0 < μ ∧ AxCone h μ Pax (Icc Xa1 110) F U)

def AxStressLocal : Prop :=
  (∀ (h X1 : ℝ) (Pax : ℝ → ℝ) (F U F' U' : ℝ → ℝ → ℝ),
    (∀ X η : ℝ, 0 < X → X < X1 → -1 < η → η < 1 → F' X η = F X η ∧ U' X η = U X η) →
    ∀ X η : ℝ, 0 < X → X < X1 → -1 < η → η < 1 →
      leadQs h F' U' X η = leadQs h F U X η ∧ axNs h Pax F' U' X η = axNs h Pax F U X η ∧
      shearA F' X η = shearA F X η ∧ shearB F' U' X η = shearB F U X η) ∧
  (∀ (h : ℝ) (Pax : ℝ → ℝ) (F U : ℝ → ℝ → ℝ),
    (∀ η : ℝ, -1 < η → η < 1 → IntegrableOn (fun x => F x η ^ 2) (Ioi 0) ∧ leadPi F 0 η = Pax η) →
    ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → leadNs h F U X η = axNs h Pax F U X η)

def AxStressSmooth : Prop :=
  ∀ (h ε : ℝ) (Pax : ℝ → ℝ) (F U : ℝ → ℝ → ℝ), 0 < h → h < 1 / 2 → 0 < ε →
    ContDiffOn ℝ ∞ (↿F) (Ioi (-ε) ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
    (∀ X η : ℝ, 0 ≤ X → -1 < η → η < 1 → 0 < F X η) → ContDiffOn ℝ ∞ Pax (Ioo (-1) 1) →
    ContDiffOn ℝ ∞ (↿(leadStressTh h F U)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿(axTz h Pax F U)) (Ioi 0 ×ˢ Ioo (-1) 1)

def AxSourceId : Prop :=
  ∀ (h ε : ℝ) (Pax : ℝ → ℝ) (F U : ℝ → ℝ → ℝ), 0 < h → h < 1 / 2 → 0 < ε →
    ContDiffOn ℝ ∞ (↿F) (Ioi (-ε) ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
