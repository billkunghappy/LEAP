  have E3 : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dS) * (edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dP)) ^ k =
      edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(dS + dP * (k:ℝ))) := by
    rw [← Real.rpow_natCast (edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dP)) k, ← Real.rpow_mul hδ0.le,
      ← Real.rpow_add hδ0]
