theorem ax_holo_coeffs : ∀ (h Pst : ℝ) (Pax : ℝ → ℝ) (j0 σ δ ρ : ℝ) (Pc : ℂ → ℂ) (r M Λ0 A : ℝ) (χc ζc ℓc zc Ξ : ℂ → ℂ), AxDatum h Pst Pax → 0 < j0 → j0 ≤ 1 / 20 → AxData h j0 σ δ ρ Pc Pax → AxCoefData h j0 σ ρ Pc Pax r M χc ζc ℓc zc Ξ → AxMajor h j0 r Λ0 A χc ζc ℓc zc → 1 ≤ Λ0 ∧ 0 < A ∧ 0 < r ∧ 20 ≤ M ∧ ∀ Λ C : ℝ, Λ0 ≤ Λ → Real.exp (Λ * M) ≤ C → (∀ n : ℕ, DifferentiableOn ℂ (fun w => axGain Λ C Ξ w * (axRecPV h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) n).1 w) (axRect (r / 2)) ∧ DifferentiableOn ℂ (axRecPV h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) n).2 (axRect (r / 2))) ∧ DifferentiableOn ℂ Pc (axRect (r / 2)) ∧ (∀ n : ℕ, ∀ w ∈ axRect (r / 2), ‖axGain Λ C Ξ w * (axRecPV h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) n).1 w‖ ≤ A * (1 / 10) ^ n ∧ ‖(axRecPV h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) n).2 w‖ ≤ A * (1 / 10) ^ n ∧ ‖Pc w‖ ≤ M ∧ ‖4 * w + (j0 : ℂ)‖ ≤ 5) ∧ (∀ n : ℕ, ∀ η : ℝ, -1 < η → η < 1 → (axGain Λ C Ξ (η : ℂ) * (axRecPV h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) n).1 (η : ℂ)).im = 0 ∧ ((axRecPV h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) n).2 (η : ℂ)).im = 0 ∧ Pc (η : ℂ) = ((Pax η : ℝ) : ℂ)) :=
by
  intro h Pst Pax j0 σ δ ρ Pc r M Λ0 A χc ζc ℓc zc Ξ _hD hj0 hj0' hAD hCD hMaj
  obtain ⟨hΛ0, hA, hMj⟩ := hMaj
  obtain ⟨hr, _hrρ, hr100, hM, _hχd, _hζd, _hℓd, _hzd, hΞd, hPcd, hbd, hreal⟩ := hCD
  obtain ⟨_hσ, _hδ, hρ, _hρ50, _hPcd2, hPcR, _⟩ := hAD
  refine ⟨hΛ0, hA, hr, hM, ?_⟩
  intro Λ C hΛ hC
  have hΛnn : 0 ≤ Λ := by linarith
  have hCpos : 0 < C := lt_of_lt_of_le (Real.exp_pos _) hC

  have hgd : DifferentiableOn ℂ (axGain Λ C Ξ) (axRect r) := by
    have e : axGain Λ C Ξ = fun w => Complex.exp ((Λ : ℂ) * Ξ w) / (C : ℂ) := by
      funext w; rfl
    rw [e]
    exact ((hΞd.const_mul (Λ : ℂ)).cexp).div_const (C : ℂ)
  have hgb : ∀ w ∈ axRect r, ‖axGain Λ C Ξ w‖ ≤ 1 := by
    intro w hw
    have hΞw : ‖Ξ w‖ ≤ M := (hbd w hw).2.2.2.2.1
    show ‖Complex.exp ((Λ : ℂ) * Ξ w) / (C : ℂ)‖ ≤ 1
    rw [norm_div, Complex.norm_exp, Complex.norm_real, Real.norm_of_nonneg hCpos.le,
      Complex.re_ofReal_mul, div_le_one hCpos]
    have h1 : Λ * (Ξ w).re ≤ Λ * M :=
      mul_le_mul_of_nonneg_left (le_trans (Complex.re_le_norm _) hΞw) hΛnn
    exact le_trans (Real.exp_le_exp.mpr h1) hC
  have hgR : ∀ η : ℝ, (Ξ (η : ℂ)).im = 0 → (axGain Λ C Ξ (η : ℂ)).im = 0 := by
    intro η hη
    show (Complex.exp ((Λ : ℂ) * Ξ (η : ℂ)) / (C : ℂ)).im = 0
    rw [Complex.div_ofReal_im, Complex.exp_im, Complex.im_ofReal_mul, hη, mul_zero,
      Real.sin_zero, mul_zero, zero_div]
  have hsub : axRect (r / 2) ⊆ axRect r := by
    intro w hw
    obtain ⟨h1, h2, h3⟩ := hw
    exact ⟨by linarith, by linarith, by linarith⟩
  have hRealHyp : ∀ η : ℝ, -1 - r < η → η < 1 + r → (χc (η : ℂ)).im = 0 ∧ (ζc (η : ℂ)).im = 0 ∧
      (ℓc (η : ℂ)).im = 0 ∧ (zc (η : ℂ)).im = 0 ∧ (axGain Λ C Ξ (η : ℂ)).im = 0 := by
    intro η h1 h2
    obtain ⟨e1, e2, e3, e4, e5, -⟩ := hreal η h1 h2
    refine ⟨?_, ?_, e5, ?_, hgR η e4⟩
    · rw [e1, Complex.ofReal_im]
    · rw [e2, Complex.ofReal_im]
    · rw [e3, Complex.ofReal_im]
  refine ⟨fun n => ?_, hPcd.mono hsub, fun n w hw => ?_, fun n η h1 h2 => ?_⟩
  · obtain ⟨hPd, hVd, -, -⟩ := hMj Λ hΛ (axGain Λ C Ξ) hgd hgb n
    exact ⟨(hgd.mul hPd).mono hsub, hVd.mono hsub⟩
  · obtain ⟨-, -, hPVb, -⟩ := hMj Λ hΛ (axGain Λ C Ξ) hgd hgb n
    obtain ⟨b1, b2, -, -⟩ := hPVb w hw
    have hwr := hsub hw
    refine ⟨?_, b2, (hbd w hwr).2.2.2.2.2.1, ?_⟩
    · rw [norm_mul]
      calc ‖axGain Λ C Ξ w‖ * ‖(axRecPV h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) n).1 w‖
          ≤ 1 * (A * (1 / 10) ^ n) :=
            mul_le_mul (hgb w hwr) b1 (norm_nonneg _) zero_le_one
        _ = A * (1 / 10) ^ n := one_mul _
    · obtain ⟨w1, w2, w3⟩ := hw
      have hre : |w.re| < 1 + r / 2 := abs_lt.mpr ⟨by linarith, by linarith⟩
      have hnw : ‖w‖ ≤ |w.re| + |w.im| := Complex.norm_le_abs_re_add_abs_im w
      have h4 : ‖(4 : ℂ) * w‖ = 4 * ‖w‖ := by
        rw [norm_mul]; norm_num
      have hj : ‖(j0 : ℂ)‖ = j0 := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hj0]
      have := norm_add_le ((4 : ℂ) * w) (j0 : ℂ)
      rw [h4, hj] at this
      linarith
  · obtain ⟨-, -, -, hPVR⟩ := hMj Λ hΛ (axGain Λ C Ξ) hgd hgb n
    have hη1 : -1 - r < η := by linarith
    have hη2 : η < 1 + r := by linarith
    obtain ⟨p1, p2⟩ := hPVR hRealHyp η hη1 hη2
    refine ⟨?_, p2, hPcR η (by linarith) (by linarith)⟩
    rw [Complex.mul_im, p1, hgR η (hreal η hη1 hη2).2.2.2.1, mul_zero, zero_mul, add_zero]

theorem ax_ps_iter_deriv : ∀ (a : ℕ → ℝ) (B Λ : ℝ), 0 < Λ → (∀ n : ℕ, |a n| ≤ B * (1 / 10) ^ n) → ∀ (k : ℕ) (Y : ℝ), |Λ * Y| < 5 → HasDerivAt (fun Y' : ℝ => Λ ^ k * ∑' n : ℕ, a n * (n.descFactorial k : ℝ) * (Λ * Y') ^ (n - k)) (Λ ^ (k + 1) * ∑' n : ℕ, a n * (n.descFactorial (k + 1) : ℝ) * (Λ * Y) ^ (n - (k + 1))) Y ∧ iteratedDeriv k (fun Y' : ℝ => ∑' n : ℕ, a n * (Λ * Y') ^ n) Y = Λ ^ k * ∑' n : ℕ, a n * (n.descFactorial k : ℝ) * (Λ * Y) ^ (n - k) :=
by
  intro a B Λ hΛ ha
  have hB : 0 ≤ B := by
    have h0 := ha 0
    rw [pow_zero, mul_one] at h0
    exact le_trans (abs_nonneg _) h0

  have hterm : ∀ (t : ℝ), |t| < 5 → ∀ j n : ℕ,
      |a n * (n.descFactorial j : ℝ) * t ^ (n - j)| ≤ B * ((n : ℝ) ^ j * (1 / 2) ^ n) := by
    intro t ht j n
    rw [abs_mul, abs_mul, Nat.abs_cast, abs_pow]
    have h1 : ((n.descFactorial j : ℕ) : ℝ) ≤ (n : ℝ) ^ j := by
      exact_mod_cast Nat.descFactorial_le_pow n j
    have h2 : |t| ^ (n - j) ≤ (5 : ℝ) ^ n :=
      (pow_le_pow_left₀ (abs_nonneg t) ht.le _).trans
        (pow_le_pow_right₀ (by norm_num) (Nat.sub_le n j))
    have h3 : (1 / 10 : ℝ) ^ n * 5 ^ n = (1 / 2) ^ n := by rw [← mul_pow]; norm_num
    have hBn : 0 ≤ B * (1 / 10 : ℝ) ^ n := mul_nonneg hB (by positivity)
    calc |a n| * (n.descFactorial j : ℝ) * |t| ^ (n - j)
        ≤ (B * (1 / 10) ^ n) * (n : ℝ) ^ j * 5 ^ n :=
          mul_le_mul (mul_le_mul (ha n) h1 (Nat.cast_nonneg _) hBn) h2 (by positivity)
            (mul_nonneg hBn (by positivity))
      _ = B * ((n : ℝ) ^ j * (1 / 2) ^ n) := by rw [← h3]; ring
  have memt : ∀ y : ℝ, y ∈ Set.Ioo (-5 / Λ) (5 / Λ) ↔ |Λ * y| < 5 := by
    intro y
    rw [Set.mem_Ioo, abs_lt, div_lt_iff₀ hΛ, lt_div_iff₀ hΛ]
    constructor
    · rintro ⟨h1, h2⟩; constructor <;> linarith [mul_comm y Λ]
    · rintro ⟨h1, h2⟩; constructor <;> linarith [mul_comm y Λ]
  have hsum : ∀ j : ℕ, Summable (fun n : ℕ => (n : ℝ) ^ j * (1 / 2 : ℝ) ^ n) := by
    intro j
    exact summable_pow_mul_geometric_of_norm_lt_one j
      (by rw [Real.norm_eq_abs, abs_of_pos (by norm_num)]; norm_num)

  have hi : ∀ (k : ℕ) (Y : ℝ), |Λ * Y| < 5 → HasDerivAt (fun Y' : ℝ => Λ ^ k * ∑' n : ℕ, a n * (n.descFactorial k : ℝ) * (Λ * Y') ^ (n - k)) (Λ ^ (k + 1) * ∑' n : ℕ, a n * (n.descFactorial (k + 1) : ℝ) * (Λ * Y) ^ (n - (k + 1))) Y := by
    intro k Y hY
    have hderiv : ∀ n : ℕ, ∀ y : ℝ,
        HasDerivAt (fun y : ℝ => a n * (n.descFactorial k : ℝ) * (Λ * y) ^ (n - k))
          (a n * (n.descFactorial (k + 1) : ℝ) * (Λ * y) ^ (n - (k + 1)) * Λ) y := by
      intro n y
      have h0 : HasDerivAt (fun y : ℝ => Λ * y) Λ y := by
        simpa using (hasDerivAt_id y).const_mul Λ
      have h1 := (h0.fun_pow (n - k)).const_mul (a n * (n.descFactorial k : ℝ))
      refine h1.congr_deriv ?_
      rw [Nat.descFactorial_succ, Nat.cast_mul, Nat.sub_sub]
      ring
    have hYt : Y ∈ Set.Ioo (-5 / Λ) (5 / Λ) := (memt Y).2 hY
    have hu : Summable (fun n : ℕ => Λ * (B * ((n : ℝ) ^ (k + 1) * (1 / 2 : ℝ) ^ n))) :=
      ((hsum (k + 1)).mul_left B).mul_left Λ
    have hbd : ∀ (n : ℕ), ∀ y ∈ Set.Ioo (-5 / Λ) (5 / Λ),
        ‖a n * (n.descFactorial (k + 1) : ℝ) * (Λ * y) ^ (n - (k + 1)) * Λ‖ ≤
          Λ * (B * ((n : ℝ) ^ (k + 1) * (1 / 2 : ℝ) ^ n)) := by
      intro n y hy
      rw [Real.norm_eq_abs, abs_mul, abs_of_pos hΛ, mul_comm]
      exact mul_le_mul_of_nonneg_left (hterm _ ((memt y).1 hy) (k + 1) n) hΛ.le
    have hs0 : Summable (fun n : ℕ => a n * (n.descFactorial k : ℝ) * (Λ * Y) ^ (n - k)) :=
      Summable.of_norm_bounded ((hsum k).mul_left B)
        (fun n => by rw [Real.norm_eq_abs]; exact hterm _ hY k n)
    have key := hasDerivAt_tsum_of_isPreconnected
      (g := fun n y => a n * (n.descFactorial k : ℝ) * (Λ * y) ^ (n - k))
      (g' := fun n y => a n * (n.descFactorial (k + 1) : ℝ) * (Λ * y) ^ (n - (k + 1)) * Λ)
      hu isOpen_Ioo isPreconnected_Ioo (fun n y _ => hderiv n y) hbd hYt hs0 hYt
    refine (key.const_mul (Λ ^ k)).congr_deriv ?_
    show Λ ^ k * ∑' n : ℕ, (a n * (n.descFactorial (k + 1) : ℝ) * (Λ * Y) ^ (n - (k + 1)) * Λ) = _
    rw [tsum_mul_right, pow_succ]
    ring

  have hii : ∀ (k : ℕ) (Y : ℝ), |Λ * Y| < 5 → iteratedDeriv k (fun Y' : ℝ => ∑' n : ℕ, a n * (Λ * Y') ^ n) Y = Λ ^ k * ∑' n : ℕ, a n * (n.descFactorial k : ℝ) * (Λ * Y) ^ (n - k) := by
    intro k
    induction k with
    | zero =>
      intro Y _
      simp
    | succ k ih =>
      intro Y hY
      rw [iteratedDeriv_succ]
      have hYt : Y ∈ Set.Ioo (-5 / Λ) (5 / Λ) := (memt Y).2 hY
      have hev : iteratedDeriv k (fun Y' : ℝ => ∑' n : ℕ, a n * (Λ * Y') ^ n) =ᶠ[nhds Y]
          (fun Y' : ℝ => Λ ^ k * ∑' n : ℕ, a n * (n.descFactorial k : ℝ) * (Λ * Y') ^ (n - k)) :=
        Filter.eventuallyEq_of_mem (isOpen_Ioo.mem_nhds hYt) (fun y hy => ih y ((memt y).1 hy))
      rw [hev.deriv_eq]
      exact (hi k Y hY).deriv
  intro k Y hY
  exact ⟨hi k Y hY, hii k Y hY⟩

theorem ax_ps_holo_family : ∀ (c : ℕ → ℂ → ℂ) (U : Set ℂ) (B Λ : ℝ), IsOpen U → 0 < Λ → (∀ n : ℕ, DifferentiableOn ℂ (c n) U) → (∀ n : ℕ, ∀ w ∈ U, ‖c n w‖ ≤ B * (1 / 10) ^ n) → ∀ k : ℕ, ContinuousOn (fun p : ℝ × ℂ => ∑' n : ℕ, c n p.2 * (n.descFactorial k : ℂ) * (((Λ * p.1 : ℝ)) : ℂ) ^ (n - k)) (Icc 0 (41 / (10 * Λ)) ×ˢ U) ∧ ∀ X : ℝ, 0 ≤ X → X ≤ 41 / (10 * Λ) → DifferentiableOn ℂ (fun w => ∑' n : ℕ, c n w * (n.descFactorial k : ℂ) * (((Λ * X : ℝ)) : ℂ) ^ (n - k)) U ∧ ∀ w ∈ U, ‖∑' n : ℕ, c n w * (n.descFactorial k : ℂ) * (((Λ * X : ℝ)) : ℂ) ^ (n - k)‖ ≤ |B| * ∑' n : ℕ, (n : ℝ) ^ k * (1 / 2) ^ n :=
by
  intro c U B Λ hU hΛ hc hcb k
  have hsum0 : Summable (fun n : ℕ => (n : ℝ) ^ k * (1 / 2 : ℝ) ^ n) :=
    summable_pow_mul_geometric_of_norm_lt_one k (by norm_num)
  have hsum : Summable (fun n : ℕ => |B| * ((n : ℝ) ^ k * (1 / 2 : ℝ) ^ n)) :=
    hsum0.mul_left |B|
  have hbound : ∀ n : ℕ, ∀ X : ℝ, 0 ≤ X → X ≤ 41 / (10 * Λ) → ∀ w ∈ U,
      ‖c n w * (n.descFactorial k : ℂ) * (((Λ * X : ℝ)) : ℂ) ^ (n - k)‖ ≤
        |B| * ((n : ℝ) ^ k * (1 / 2 : ℝ) ^ n) := by
    intro n X hX0 hX1 w hw
    have ht0 : 0 ≤ Λ * X := mul_nonneg hΛ.le hX0
    have ht1 : Λ * X ≤ 41 / 10 := by
      calc Λ * X ≤ Λ * (41 / (10 * Λ)) := mul_le_mul_of_nonneg_left hX1 hΛ.le
        _ = 41 / 10 := by field_simp
    rw [norm_mul, norm_mul, Complex.norm_natCast, norm_pow, Complex.norm_real,
      Real.norm_of_nonneg ht0]
    have h1 : ‖c n w‖ ≤ |B| * (1 / 10 : ℝ) ^ n :=
      (hcb n w hw).trans (mul_le_mul_of_nonneg_right (le_abs_self B) (by positivity))
    have h2 : ((n.descFactorial k : ℕ) : ℝ) ≤ (n : ℝ) ^ k := by
      exact_mod_cast Nat.descFactorial_le_pow n k
    have h3 : (Λ * X) ^ (n - k) ≤ (41 / 10 : ℝ) ^ n :=
      (pow_le_pow_left₀ ht0 ht1 _).trans (pow_le_pow_right₀ (by norm_num) (Nat.sub_le n k))
    have h4 : (41 / 100 : ℝ) ^ n ≤ (1 / 2 : ℝ) ^ n :=
      pow_le_pow_left₀ (by norm_num) (by norm_num) n
    calc ‖c n w‖ * ((n.descFactorial k : ℕ) : ℝ) * (Λ * X) ^ (n - k)
        ≤ (|B| * (1 / 10 : ℝ) ^ n) * (n : ℝ) ^ k * (41 / 10 : ℝ) ^ n :=
          mul_le_mul (mul_le_mul h1 h2 (by positivity) (by positivity)) h3
            (by positivity) (by positivity)
      _ = |B| * ((n : ℝ) ^ k * (41 / 100 : ℝ) ^ n) := by
          rw [show (41 / 100 : ℝ) = (1 / 10) * (41 / 10) by norm_num, mul_pow]; ring
      _ ≤ |B| * ((n : ℝ) ^ k * (1 / 2 : ℝ) ^ n) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h4 (by positivity))
            (abs_nonneg B)
  refine ⟨?_, fun X hX0 hX1 => ⟨?_, fun w hw => ?_⟩⟩
  · refine continuousOn_tsum (u := fun n : ℕ => |B| * ((n : ℝ) ^ k * (1 / 2 : ℝ) ^ n))
      (fun n => ?_) hsum (fun n p hp => hbound n p.1 hp.1.1 hp.1.2 p.2 hp.2)
    have hcn : ContinuousOn (fun p : ℝ × ℂ => c n p.2) (Icc 0 (41 / (10 * Λ)) ×ˢ U) :=
      (hc n).continuousOn.comp continuousOn_snd (fun p hp => hp.2)
    have hpow : Continuous (fun p : ℝ × ℂ => (((Λ * p.1 : ℝ)) : ℂ) ^ (n - k)) := by
      fun_prop
    exact (hcn.mul continuousOn_const).mul hpow.continuousOn
  · exact Complex.differentiableOn_tsum_of_summable_norm hsum
      (fun n => ((hc n).mul_const _).mul_const _) hU (fun n w hw => hbound n X hX0 hX1 w hw)
  · rw [← tsum_mul_left]
    exact tsum_of_norm_bounded hsum.hasSum (fun n => hbound n X hX0 hX1 w hw)

theorem ax_raw_holo : ∀ (h Pst : ℝ) (Pax : ℝ → ℝ) (j0 σ δ ρ : ℝ) (Pc : ℂ → ℂ) (r M Λ0 A : ℝ) (χc ζc ℓc zc Ξ : ℂ → ℂ), AxDatum h Pst Pax → 0 < j0 → j0 ≤ 1 / 20 → AxData h j0 σ δ ρ Pc Pax → AxCoefData h j0 σ ρ Pc Pax r M χc ζc ℓc zc Ξ → AxMajor h j0 r Λ0 A χc ζc ℓc zc → ∃ Λ1 : ℝ, ∀ Λ C : ℝ, Λ1 ≤ Λ → Real.exp (Λ * M) ≤ C →
    let Fn := axFnDef h j0 Λ C χc ζc ℓc zc Ξ
    let Un := axUnDef h j0 Λ C χc ζc ℓc zc Ξ
    ∃ ρ' : ℝ, 0 < ρ' ∧ ∃ Fc Uc Pk : ℕ → ℝ → ℂ → ℂ, ∀ k : ℕ, ∃ Ck : ℝ,
      ContinuousOn (fun p : ℝ × ℂ => Fc k p.1 p.2)
        (Icc 0 (41 / (10 * Λ)) ×ˢ {w : ℂ | |w.im| < ρ' ∧ -1 - ρ' < w.re ∧ w.re < 1 + ρ'}) ∧
      ContinuousOn (fun p : ℝ × ℂ => Uc k p.1 p.2)
        (Icc 0 (41 / (10 * Λ)) ×ˢ {w : ℂ | |w.im| < ρ' ∧ -1 - ρ' < w.re ∧ w.re < 1 + ρ'}) ∧
      ContinuousOn (fun p : ℝ × ℂ => Pk k p.1 p.2)
        (Icc 0 (41 / (10 * Λ)) ×ˢ {w : ℂ | |w.im| < ρ' ∧ -1 - ρ' < w.re ∧ w.re < 1 + ρ'}) ∧
      ∀ X : ℝ, 0 ≤ X → X ≤ 41 / (10 * Λ) →
        DifferentiableOn ℂ (Fc k X) {w : ℂ | |w.im| < ρ' ∧ -1 - ρ' < w.re ∧ w.re < 1 + ρ'} ∧
        DifferentiableOn ℂ (Uc k X) {w : ℂ | |w.im| < ρ' ∧ -1 - ρ' < w.re ∧ w.re < 1 + ρ'} ∧
        DifferentiableOn ℂ (Pk k X) {w : ℂ | |w.im| < ρ' ∧ -1 - ρ' < w.re ∧ w.re < 1 + ρ'} ∧
        (∀ w : ℂ, |w.im| < ρ' → -1 - ρ' < w.re → w.re < 1 + ρ' →
          ‖Fc k X w‖ ≤ Ck ∧ ‖Uc k X w‖ ≤ Ck ∧ ‖Pk k X w‖ ≤ Ck) ∧
        (∀ η : ℝ, -1 < η → η < 1 →
          Fc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Fn Y η) X : ℝ) : ℂ) ∧
          Uc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Un Y η) X : ℝ) : ℂ) ∧
          Pk k X (η : ℂ) = ((iteratedDeriv k (fun Y => Pax η + profRadInt (fun x e => Fn x e ^ 2) Y η) X : ℝ) : ℂ)) :=
by
  intro h Pst Pax j0 σ δ ρ Pc r M Λ0 A χc ζc ℓc zc Ξ hD hj0 hj0' hAD hCD hMaj
  obtain ⟨hΛ0, hA, hr, hM, hpk⟩ :=
    ax_holo_coeffs h Pst Pax j0 σ δ ρ Pc r M Λ0 A χc ζc ℓc zc Ξ hD hj0 hj0' hAD hCD hMaj
  refine ⟨Λ0, ?_⟩
  intro Λ C hΛ hC Fn Un
  obtain ⟨hHol, hPcHol, hBd, hReal⟩ := hpk Λ C hΛ hC
  have hΛ1 : 1 ≤ Λ := le_trans hΛ0 hΛ
  have hΛpos : 0 < Λ := by linarith

  have hUo : IsOpen (axRect (r / 2)) :=
    (isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).inter
      ((isOpen_lt continuous_const Complex.continuous_re).inter
        (isOpen_lt Complex.continuous_re continuous_const))

  have hN : ∀ X : ℝ, 0 ≤ X → X ≤ 41 / (10 * Λ) → X ∈ Ioo (-5 / Λ) (9 / (2 * Λ)) := by
    intro X hX0 hX1
    have h1 : -5 / Λ < 0 := div_neg_of_neg_of_pos (by norm_num) hΛpos
    have h2 : 41 / (10 * Λ) < 9 / (2 * Λ) := by
      rw [div_lt_div_iff₀ (by linarith) (by linarith)]; linarith
    exact ⟨by linarith, by linarith⟩
  have hNY : ∀ Y ∈ Ioo (-5 / Λ) (9 / (2 * Λ)), -5 < Λ * Y ∧ Λ * Y < 9 / 2 := by
    intro Y hY
    have h1 := hY.1
    have h2 := hY.2
    rw [div_lt_iff₀ hΛpos] at h1
    rw [lt_div_iff₀ (by linarith : (0:ℝ) < 2 * Λ)] at h2
    constructor <;> nlinarith
  have hN5 : ∀ Y ∈ Ioo (-5 / Λ) (9 / (2 * Λ)), |Λ * Y| < 5 := fun Y hY =>
    abs_lt.mpr ⟨(hNY Y hY).1, by linarith [(hNY Y hY).2]⟩
  have hNcut : ∀ Y ∈ Ioo (-5 / Λ) (9 / (2 * Λ)), axCut (Λ * Y) = 1 := by
    intro Y hY
    unfold axCut
    exact Real.smoothTransition.one_of_one_le (by linarith [(hNY Y hY).2])

  have hre : ∀ z : ℂ, z.im = 0 → z = ((z.re : ℝ) : ℂ) := fun z hz =>
    Complex.ext (by simp) (by simp [hz])

  have hsumm : ∀ (a : ℕ → ℝ) (B t : ℝ), (∀ n, |a n| ≤ B * (1 / 10) ^ n) → |t| < 5 →
      Summable (fun n => a n * t ^ n) := by
    intro a B t hab ht
    refine Summable.of_norm_bounded (g := fun n => B * (1 / 2) ^ n)
      ((summable_geometric_of_lt_one (by norm_num) (by norm_num)).mul_left B) (fun n => ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_pow]
    have h1 : |t| ^ n ≤ 5 ^ n := pow_le_pow_left₀ (abs_nonneg t) ht.le n
    have hB : 0 ≤ B * (1 / 10) ^ n := le_trans (abs_nonneg _) (hab n)
    calc |a n| * |t| ^ n ≤ (B * (1 / 10) ^ n) * 5 ^ n := mul_le_mul (hab n) h1 (by positivity) hB
      _ = B * (1 / 2) ^ n := by rw [mul_assoc, ← mul_pow]; norm_num

  obtain ⟨cF, hcFdef⟩ : ∃ cF : ℕ → ℂ → ℂ,
      cF = fun n w => axGain Λ C Ξ w * (axRecPV h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) n).1 w := ⟨_, rfl⟩
  obtain ⟨V, hVdef⟩ : ∃ V : ℕ → ℂ → ℂ,
      V = fun n => (axRecPV h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) n).2 := ⟨_, rfl⟩
  obtain ⟨cU, hcUdef⟩ : ∃ cU : ℕ → ℂ → ℂ,
      cU = fun n w => (if n = 0 then 4 * w + (j0 : ℂ) else 0) + V n w / (Λ : ℂ) := ⟨_, rfl⟩
  obtain ⟨cP, hcPdef⟩ : ∃ cP : ℕ → ℂ → ℂ,
      cP = fun n w => if n = 0 then Pc w else
        (∑ i ∈ Finset.range n, cF i w * cF (n - 1 - i) w) / ((n : ℂ) * (Λ : ℂ)) := ⟨_, rfl⟩
  have hcFh : ∀ n, DifferentiableOn ℂ (cF n) (axRect (r / 2)) := by
    intro n; rw [hcFdef]; exact (hHol n).1
  have hVh : ∀ n, DifferentiableOn ℂ (V n) (axRect (r / 2)) := by
    intro n; rw [hVdef]; exact (hHol n).2
  have hcFb : ∀ n, ∀ w ∈ axRect (r / 2), ‖cF n w‖ ≤ A * (1 / 10) ^ n := by
    intro n w hw; rw [hcFdef]; exact (hBd n w hw).1
  have hVb : ∀ n, ∀ w ∈ axRect (r / 2), ‖V n w‖ ≤ A * (1 / 10) ^ n := by
    intro n w hw; rw [hVdef]; exact (hBd n w hw).2.1
  have hVdiv : ∀ n, ∀ w ∈ axRect (r / 2), ‖V n w / (Λ : ℂ)‖ ≤ A * (1 / 10) ^ n := by
    intro n w hw
    rw [norm_div, Complex.norm_real, Real.norm_of_nonneg hΛpos.le]
    exact le_trans (div_le_self (norm_nonneg _) hΛ1) (hVb n w hw)
  have hcUh : ∀ n, DifferentiableOn ℂ (cU n) (axRect (r / 2)) := by
    intro n
    by_cases hn : n = 0
    · have e : cU n = fun w => 4 * w + (j0 : ℂ) + V n w / (Λ : ℂ) := by
        funext w; rw [hcUdef]; dsimp only; rw [if_pos hn]
      rw [e]
      refine DifferentiableOn.add ?_ ((hVh n).div_const _)
      fun_prop
    · have e : cU n = fun w => V n w / (Λ : ℂ) := by
        funext w; rw [hcUdef]; dsimp only; rw [if_neg hn, zero_add]
      rw [e]
      exact (hVh n).div_const _
  have hcUb : ∀ n, ∀ w ∈ axRect (r / 2), ‖cU n w‖ ≤ (5 + A) * (1 / 10) ^ n := by
    intro n w hw
    by_cases hn : n = 0
    · subst hn
      rw [hcUdef]; dsimp only; rw [if_pos (rfl : (0:ℕ) = 0), pow_zero, mul_one]
      have h1 := hVdiv 0 w hw
      rw [pow_zero, mul_one] at h1
      exact le_trans (norm_add_le _ _) (add_le_add (hBd 0 w hw).2.2.2 h1)
    · rw [hcUdef]; dsimp only; rw [if_neg hn, zero_add]
      have hq : 0 ≤ (1 / 10 : ℝ) ^ n := by positivity
      nlinarith [hVdiv n w hw]
  have hcPh : ∀ n, DifferentiableOn ℂ (cP n) (axRect (r / 2)) := by
    intro n
    by_cases hn : n = 0
    · have e : cP n = Pc := by
        funext w; rw [hcPdef]; dsimp only; rw [if_pos hn]
      rw [e]; exact hPcHol
    · have e : cP n = fun w =>
          (∑ i ∈ Finset.range n, cF i w * cF (n - 1 - i) w) / ((n : ℂ) * (Λ : ℂ)) := by
        funext w; rw [hcPdef]; dsimp only; rw [if_neg hn]
      rw [e]
      exact (DifferentiableOn.fun_sum (fun i _ => (hcFh i).mul (hcFh (n - 1 - i)))).div_const _
  have hcPb : ∀ n, ∀ w ∈ axRect (r / 2), ‖cP n w‖ ≤ (M + 10 * A ^ 2) * (1 / 10) ^ n := by
    intro n w hw
    by_cases hn : n = 0
    · subst hn
      rw [hcPdef]; dsimp only; rw [if_pos (rfl : (0:ℕ) = 0), pow_zero, mul_one]
      have := (hBd 0 w hw).2.2.1
      nlinarith [sq_nonneg A]
    · rw [hcPdef]; dsimp only; rw [if_neg hn]
      have hnpos : (0:ℝ) < n := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn)
      have hsum : ‖∑ i ∈ Finset.range n, cF i w * cF (n - 1 - i) w‖ ≤
          n * (A ^ 2 * (1 / 10) ^ (n - 1)) := by
        refine le_trans (norm_sum_le _ _) ?_
        have hterm : ∀ i ∈ Finset.range n,
            ‖cF i w * cF (n - 1 - i) w‖ ≤ A ^ 2 * (1 / 10) ^ (n - 1) := by
          intro i hi
          have hi' : i < n := Finset.mem_range.mp hi
          have e : (1 / 10 : ℝ) ^ (n - 1) = (1 / 10) ^ i * (1 / 10) ^ (n - 1 - i) := by
            rw [← pow_add]; congr 1; omega
          rw [norm_mul, e]
          calc ‖cF i w‖ * ‖cF (n - 1 - i) w‖
              ≤ (A * (1 / 10) ^ i) * (A * (1 / 10) ^ (n - 1 - i)) :=
                mul_le_mul (hcFb i w hw) (hcFb _ w hw) (norm_nonneg _)
                  (mul_nonneg hA.le (by positivity))
            _ = A ^ 2 * ((1 / 10) ^ i * (1 / 10) ^ (n - 1 - i)) := by ring
        refine le_trans (Finset.sum_le_sum hterm) ?_
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      rw [norm_div, norm_mul, Complex.norm_natCast, Complex.norm_real,
        Real.norm_of_nonneg hΛpos.le, div_le_iff₀ (mul_pos hnpos hΛpos)]
      refine le_trans hsum ?_
      have e2 : (1 / 10 : ℝ) ^ (n - 1) = 10 * (1 / 10) ^ n := by
        obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
        rw [Nat.add_sub_cancel, pow_succ]; ring
      rw [e2]
      have hq : 0 < (1 / 10 : ℝ) ^ n := by positivity
      have hX : 0 ≤ 10 * A ^ 2 * (1 / 10 : ℝ) ^ n * n := by positivity
      have hY : 0 < (1 / 10 : ℝ) ^ n * n * Λ := mul_pos (mul_pos hq hnpos) hΛpos
      nlinarith [mul_le_mul_of_nonneg_left hΛ1 hX, mul_le_mul_of_nonneg_right hM hY.le]

  have G1 : ∀ (c : ℕ → ℂ → ℂ) (B : ℝ), (∀ n, DifferentiableOn ℂ (c n) (axRect (r / 2))) →
      (∀ n, ∀ w ∈ axRect (r / 2), ‖c n w‖ ≤ B * (1 / 10) ^ n) → ∀ k : ℕ,
      ContinuousOn (fun p : ℝ × ℂ => (Λ : ℂ) ^ k * ∑' n : ℕ, c n p.2 * (n.descFactorial k : ℂ) *
          ((Λ * p.1 : ℝ) : ℂ) ^ (n - k)) (Icc 0 (41 / (10 * Λ)) ×ˢ axRect (r / 2)) ∧
      ∀ X : ℝ, 0 ≤ X → X ≤ 41 / (10 * Λ) →
        DifferentiableOn ℂ (fun w => (Λ : ℂ) ^ k * ∑' n : ℕ, c n w * (n.descFactorial k : ℂ) *
          ((Λ * X : ℝ) : ℂ) ^ (n - k)) (axRect (r / 2)) ∧
        ∀ w ∈ axRect (r / 2), ‖(Λ : ℂ) ^ k * ∑' n : ℕ, c n w * (n.descFactorial k : ℂ) *
          ((Λ * X : ℝ) : ℂ) ^ (n - k)‖ ≤ Λ ^ k * (|B| * ∑' n : ℕ, (n : ℝ) ^ k * (1 / 2) ^ n) := by
    intro c B hc hcb k
    obtain ⟨h1, h2⟩ := ax_ps_holo_family c (axRect (r / 2)) B Λ hUo hΛpos hc hcb k
    refine ⟨continuousOn_const.mul h1, fun X hX0 hX1 => ?_⟩
    obtain ⟨h3, h4⟩ := h2 X hX0 hX1
    refine ⟨h3.const_mul _, fun w hw => ?_⟩
    rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_of_nonneg hΛpos.le]
    exact mul_le_mul_of_nonneg_left (h4 w hw) (pow_nonneg hΛpos.le k)

  have G2 : ∀ (c : ℕ → ℂ → ℂ) (a : ℕ → ℝ) (B : ℝ) (f : ℝ → ℝ) (η : ℝ),
      (∀ n, c n (η : ℂ) = ((a n : ℝ) : ℂ)) → (∀ n, |a n| ≤ B * (1 / 10) ^ n) →
      (∀ Y ∈ Ioo (-5 / Λ) (9 / (2 * Λ)), f Y = ∑' n : ℕ, a n * (Λ * Y) ^ n) →
      ∀ k : ℕ, ∀ X : ℝ, 0 ≤ X → X ≤ 41 / (10 * Λ) →
      (Λ : ℂ) ^ k * ∑' n : ℕ, c n (η : ℂ) * (n.descFactorial k : ℂ) * ((Λ * X : ℝ) : ℂ) ^ (n - k) =
        ((iteratedDeriv k f X : ℝ) : ℂ) := by
    intro c a B f η hca hab hf k X hX0 hX1
    have hXN := hN X hX0 hX1
    have hev : f =ᶠ[nhds X] (fun Y => ∑' n : ℕ, a n * (Λ * Y) ^ n) :=
      Filter.eventuallyEq_of_mem (isOpen_Ioo.mem_nhds hXN) (fun Y hY => hf Y hY)
    rw [Filter.EventuallyEq.iteratedDeriv_eq k hev,
      (ax_ps_iter_deriv a B Λ hΛpos hab k X (hN5 X hXN)).2,
      Complex.ofReal_mul (Λ ^ k), Complex.ofReal_pow Λ k, Complex.ofReal_tsum]
    congr 1
    refine tsum_congr (fun n => ?_)
    rw [hca n]
    push_cast
    ring

  refine ⟨r / 2, half_pos hr,
    fun k X w => (Λ : ℂ) ^ k * ∑' n : ℕ, cF n w * (n.descFactorial k : ℂ) * ((Λ * X : ℝ) : ℂ) ^ (n - k),
    fun k X w => (Λ : ℂ) ^ k * ∑' n : ℕ, cU n w * (n.descFactorial k : ℂ) * ((Λ * X : ℝ) : ℂ) ^ (n - k),
    fun k X w => (Λ : ℂ) ^ k * ∑' n : ℕ, cP n w * (n.descFactorial k : ℂ) * ((Λ * X : ℝ) : ℂ) ^ (n - k),
    fun k => ?_⟩
  obtain ⟨cF1, cF2⟩ := G1 cF A hcFh hcFb k
  obtain ⟨cU1, cU2⟩ := G1 cU (5 + A) hcUh hcUb k
  obtain ⟨cP1, cP2⟩ := G1 cP (M + 10 * A ^ 2) hcPh hcPb k
  have hS : 0 ≤ ∑' n : ℕ, (n : ℝ) ^ k * (1 / 2) ^ n := tsum_nonneg (fun n => by positivity)
  refine ⟨Λ ^ k * ((|A| + |5 + A| + |M + 10 * A ^ 2|) * ∑' n : ℕ, (n : ℝ) ^ k * (1 / 2) ^ n),
    cF1, cU1, cP1, ?_⟩
  intro X hX0 hX1
  obtain ⟨dF, bF⟩ := cF2 X hX0 hX1
  obtain ⟨dU, bU⟩ := cU2 X hX0 hX1
  obtain ⟨dP, bP⟩ := cP2 X hX0 hX1
  have hΛk : 0 ≤ Λ ^ k := pow_nonneg hΛpos.le k
  have hmono : ∀ B : ℝ, |B| ≤ |A| + |5 + A| + |M + 10 * A ^ 2| →
      Λ ^ k * (|B| * ∑' n : ℕ, (n : ℝ) ^ k * (1 / 2) ^ n) ≤
        Λ ^ k * ((|A| + |5 + A| + |M + 10 * A ^ 2|) * ∑' n : ℕ, (n : ℝ) ^ k * (1 / 2) ^ n) :=
    fun B hB => mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hB hS) hΛk
  have a1 := abs_nonneg A
  have a2 := abs_nonneg (5 + A)
  have a3 := abs_nonneg (M + 10 * A ^ 2)
  refine ⟨dF, dU, dP, fun w hw1 hw2 hw3 => ?_, fun η hη1 hη2 => ?_⟩
  · have hw : w ∈ axRect (r / 2) := ⟨hw1, hw2, hw3⟩
    exact ⟨le_trans (bF w hw) (hmono A (by linarith)),
      le_trans (bU w hw) (hmono _ (by linarith)), le_trans (bP w hw) (hmono _ (by linarith))⟩
  · have hηU : (η : ℂ) ∈ axRect (r / 2) := by
      show |(η : ℂ).im| < r / 2 ∧ -1 - r / 2 < (η : ℂ).re ∧ (η : ℂ).re < 1 + r / 2
      simp only [Complex.ofReal_im, Complex.ofReal_re, abs_zero]
      exact ⟨by linarith, by linarith, by linarith⟩

    obtain ⟨aF, haF⟩ : ∃ aF : ℕ → ℝ, ∀ n, cF n (η : ℂ) = ((aF n : ℝ) : ℂ) :=
      ⟨fun n => (cF n (η : ℂ)).re, fun n => hre (cF n (η : ℂ))
        (by rw [hcFdef]; exact (hReal n η hη1 hη2).1)⟩
    have haFb : ∀ n, |aF n| ≤ A * (1 / 10) ^ n := by
      intro n; have := hcFb n (η : ℂ) hηU
      rwa [haF n, Complex.norm_real, Real.norm_eq_abs] at this
    obtain ⟨vr, hvr⟩ : ∃ vr : ℕ → ℝ, ∀ n, V n (η : ℂ) = ((vr n : ℝ) : ℂ) :=
      ⟨fun n => (V n (η : ℂ)).re, fun n => hre (V n (η : ℂ))
        (by rw [hVdef]; exact (hReal n η hη1 hη2).2.1)⟩
    have hvrb : ∀ n, |vr n| ≤ A * (1 / 10) ^ n := by
      intro n; have := hVb n (η : ℂ) hηU
      rwa [hvr n, Complex.norm_real, Real.norm_eq_abs] at this
    obtain ⟨aU, haUdef⟩ : ∃ aU : ℕ → ℝ,
        aU = fun n => (if n = 0 then 4 * η + j0 else 0) + vr n / Λ := ⟨_, rfl⟩
    have haU : ∀ n, cU n (η : ℂ) = ((aU n : ℝ) : ℂ) := by
      intro n
      rw [hcUdef, haUdef]; dsimp only; rw [hvr n]
      by_cases hn : n = 0
      · rw [if_pos hn, if_pos hn]; push_cast; ring
      · rw [if_neg hn, if_neg hn]; push_cast; ring
    have haUb : ∀ n, |aU n| ≤ (5 + A) * (1 / 10) ^ n := by
      intro n; have := hcUb n (η : ℂ) hηU
      rwa [haU n, Complex.norm_real, Real.norm_eq_abs] at this
    obtain ⟨aP, haPdef⟩ : ∃ aP : ℕ → ℝ, aP = fun n => if n = 0 then Pax η else
        (∑ i ∈ Finset.range n, aF i * aF (n - 1 - i)) / ((n : ℝ) * Λ) := ⟨_, rfl⟩
    have haP : ∀ n, cP n (η : ℂ) = ((aP n : ℝ) : ℂ) := by
      intro n
      rw [hcPdef, haPdef]; dsimp only
      by_cases hn : n = 0
      · rw [if_pos hn, if_pos hn]; exact (hReal 0 η hη1 hη2).2.2
      · rw [if_neg hn, if_neg hn]; simp only [haF]; push_cast; ring
    have hsq := ax_ps_sq_primitive aF A Λ (Pax η) hΛpos haFb
    have haPb : ∀ n, |aP n| ≤ (|Pax η| + 10 * A ^ 2 / Λ) * (1 / 10) ^ n := by
      intro n; rw [haPdef]; exact hsq.1 n

    have hFser : ∀ Y ∈ Ioo (-5 / Λ) (9 / (2 * Λ)), Fn Y η = ∑' n : ℕ, aF n * (Λ * Y) ^ n := by
      intro Y hY
      have hphi : axGain Λ C Ξ (η : ℂ) * axPhi h j0 Λ C χc ζc ℓc zc Ξ (Λ * Y) (η : ℂ) =
          ((∑' n : ℕ, aF n * (Λ * Y) ^ n : ℝ) : ℂ) := by
        unfold axPhi
        rw [← tsum_mul_left, Complex.ofReal_tsum]
        refine tsum_congr (fun n => ?_)
        have e := haF n
        rw [hcFdef] at e
        dsimp only at e
        rw [← mul_assoc, e]
        push_cast
        ring
      show axFnDef h j0 Λ C χc ζc ℓc zc Ξ Y η = _
      unfold axFnDef
      rw [hNcut Y hY, hphi, Complex.ofReal_re]
      ring
    have hUser : ∀ Y ∈ Ioo (-5 / Λ) (9 / (2 * Λ)), Un Y η = ∑' n : ℕ, aU n * (Λ * Y) ^ n := by
      intro Y hY
      have hps : axPsiU h j0 Λ C χc ζc ℓc zc Ξ (Λ * Y) (η : ℂ) =
          ((∑' n : ℕ, vr n * (Λ * Y) ^ n : ℝ) : ℂ) := by
        unfold axPsiU
        rw [Complex.ofReal_tsum]
        refine tsum_congr (fun n => ?_)
        have e := hvr n
        rw [hVdef] at e
        dsimp only at e
        rw [e]
        push_cast
        ring
      have hs1 : HasSum (fun n : ℕ => (if n = 0 then 4 * η + j0 else 0) * (Λ * Y) ^ n)
          (4 * η + j0) := by
        have := hasSum_single (f := fun n : ℕ => (if n = 0 then 4 * η + j0 else 0) * (Λ * Y) ^ n) 0
          (fun b hb => by simp [hb])
        simpa using this
      have hs2 : Summable (fun n : ℕ => vr n * (Λ * Y) ^ n) := hsumm vr A (Λ * Y) hvrb (hN5 Y hY)
      have e : ∀ n, aU n * (Λ * Y) ^ n =
          (if n = 0 then 4 * η + j0 else 0) * (Λ * Y) ^ n + vr n * (Λ * Y) ^ n / Λ := by
        intro n; rw [haUdef]; dsimp only; ring
      show axUnDef h j0 Λ C χc ζc ℓc zc Ξ Y η = _
      unfold axUnDef
      rw [hNcut Y hY, hps, Complex.ofReal_re, tsum_congr e,
        Summable.tsum_add hs1.summable (hs2.div_const Λ), hs1.tsum_eq, tsum_div_const]
      ring
    have hPser : ∀ Y ∈ Ioo (-5 / Λ) (9 / (2 * Λ)),
        Pax η + profRadInt (fun x e => Fn x e ^ 2) Y η = ∑' n : ℕ, aP n * (Λ * Y) ^ n := by
      intro Y hY
      have h0N : (0:ℝ) ∈ Ioo (-5 / Λ) (9 / (2 * Λ)) :=
        hN 0 le_rfl (div_nonneg (by norm_num) (by linarith))
      have hsub : uIcc 0 Y ⊆ Ioo (-5 / Λ) (9 / (2 * Λ)) := Set.ordConnected_Ioo.uIcc_subset h0N hY
      have hint : profRadInt (fun x e => Fn x e ^ 2) Y η =
          ∫ x in (0:ℝ)..Y, (∑' n : ℕ, aF n * (Λ * x) ^ n) ^ 2 := by
        unfold profRadInt
        refine intervalIntegral.integral_congr (fun x hx => ?_)
        show Fn x η ^ 2 = (∑' n : ℕ, aF n * (Λ * x) ^ n) ^ 2
        rw [hFser x (hsub hx)]
      rw [hint, hsq.2 Y (hN5 Y hY), haPdef]
    exact ⟨G2 cF aF A (fun Y => Fn Y η) η haF haFb hFser k X hX0 hX1,
      G2 cU aU (5 + A) (fun Y => Un Y η) η haU haUb hUser k X hX0 hX1,
      G2 cP aP (|Pax η| + 10 * A ^ 2 / Λ) (fun Y => Pax η + profRadInt (fun x e => Fn x e ^ 2) Y η)
        η haP haPb hPser k X hX0 hX1⟩

theorem ax_f0_bounds : (∀ z : ℝ, 0 ≤ z → z ≤ 41 / 10 → 53 / 200 ≤ axF0 z ∧ axF0 z ≤ 1 ∧ -(1 / 4) ≤ deriv axF0 z ∧ deriv axF0 z ≤ 0) ∧ (∀ z : ℝ, 99 / 25 ≤ z → z ≤ 4 → axF0 z + z * deriv axF0 z ≤ -(9 / 50)) :=
by

  have hderiv : ∀ z : ℝ, HasDerivAt axF0
      (-(1 / 2) * ∑' n : ℕ, (-z / 2) ^ n / ((n.factorial : ℝ) * ((n + 2).factorial : ℝ))) z := by
    intro z
    set R : ℝ := |z| + 1 with hR
    have hR1 : 1 ≤ R := by have := abs_nonneg z; linarith
    set g' : ℕ → ℝ → ℝ := fun n y =>
      (n : ℝ) * (-y / 2) ^ (n - 1) * (-1 / 2) / ((n.factorial : ℝ) * ((n + 1).factorial : ℝ)) with hg'
    have hgd : ∀ n : ℕ, ∀ y ∈ Set.Ioo (-R) R, HasDerivAt
        (fun y : ℝ => (-y / 2) ^ n / ((n.factorial : ℝ) * ((n + 1).factorial : ℝ))) (g' n y) y := by
      intro n y _
      have h1 : HasDerivAt (fun y : ℝ => -y / 2) (-1 / 2) y := (hasDerivAt_id' y).neg.div_const 2
      exact (h1.pow n).div_const _
    have hbound : ∀ n : ℕ, ∀ y ∈ Set.Ioo (-R) R, ‖g' n y‖ ≤ R ^ n / (n.factorial : ℝ) := by
      intro n y hy
      have hy' : |-y / 2| ≤ R := by
        rw [abs_div, abs_neg, abs_two]
        have := abs_lt.mpr ⟨hy.1, hy.2⟩
        linarith [abs_nonneg y]
      have hpow : |-y / 2| ^ (n - 1) ≤ R ^ n :=
        (pow_le_pow_left₀ (abs_nonneg _) hy' _).trans (pow_le_pow_right₀ hR1 (Nat.sub_le n 1))
      have hn : (n : ℝ) ≤ ((n + 1).factorial : ℝ) := by
        exact_mod_cast (Nat.self_le_factorial n).trans (Nat.factorial_le (Nat.le_succ n))
      have hf1 : (0 : ℝ) < (n.factorial : ℝ) := by positivity
      have hf2 : (0 : ℝ) < ((n + 1).factorial : ℝ) := by positivity
      simp only [hg']
      rw [Real.norm_eq_abs, abs_div, abs_mul, abs_mul, abs_pow, abs_of_pos (mul_pos hf1 hf2),
        div_le_div_iff₀ (mul_pos hf1 hf2) hf1, Nat.abs_cast]
      have h12 : |(-1 / 2 : ℝ)| = 1 / 2 := by norm_num
      rw [h12]
      calc (n : ℝ) * |-y / 2| ^ (n - 1) * (1 / 2) * (n.factorial : ℝ)
          ≤ ((n + 1).factorial : ℝ) * R ^ n * 1 * (n.factorial : ℝ) := by gcongr; norm_num
        _ = R ^ n * ((n.factorial : ℝ) * ((n + 1).factorial : ℝ)) := by ring
    have hsu : Summable (fun n : ℕ => R ^ n / (n.factorial : ℝ)) := Real.summable_pow_div_factorial R
    have hmem : z ∈ Set.Ioo (-R) R := ⟨by linarith [neg_abs_le z], by linarith [le_abs_self z]⟩
    have h0mem : (0 : ℝ) ∈ Set.Ioo (-R) R := ⟨by linarith, by linarith⟩
    have hs0 : Summable (fun n : ℕ => (-(0 : ℝ) / 2) ^ n / ((n.factorial : ℝ) * ((n + 1).factorial : ℝ))) := by
      apply (hasSum_single 0 _).summable
      intro b hb
      simp [hb]
    have hD := hasDerivAt_tsum_of_isPreconnected hsu isOpen_Ioo isPreconnected_Ioo hgd hbound h0mem hs0 hmem
    have hsg : Summable (fun n => g' n z) := Summable.of_norm_bounded hsu (fun n => hbound n z hmem)
    have heq : ∑' n, g' n z = -(1 / 2) * ∑' n : ℕ, (-z / 2) ^ n / ((n.factorial : ℝ) * ((n + 2).factorial : ℝ)) := by
      rw [hsg.tsum_eq_zero_add, ← tsum_mul_left]
      have h0 : g' 0 z = 0 := by simp [hg']
      rw [h0, zero_add]
      congr 1
      ext m
      simp only [hg']
      rw [Nat.add_sub_cancel, show m + 1 + 1 = m + 2 by ring, Nat.factorial_succ m]
      have hf1 : (m.factorial : ℝ) ≠ 0 := by positivity
      have hf2 : ((m + 2).factorial : ℝ) ≠ 0 := by positivity
      push_cast
      field_simp
    rw [← heq]
    exact hD

  have leib : ∀ (k M : ℕ) (t : ℝ), 0 ≤ t → t ≤ ((M : ℝ) + 1) * ((M : ℝ) + 1 + (k : ℝ)) →
      0 ≤ (-1) ^ M * ((∑' n : ℕ, (-t) ^ n / ((Nat.factorial n : ℝ) * (Nat.factorial (n + k) : ℝ))) -
        ∑ n ∈ Finset.range M, (-t) ^ n / ((Nat.factorial n : ℝ) * (Nat.factorial (n + k) : ℝ))) := by
    intro k M t ht0 htM
    set a : ℕ → ℝ := fun n => t ^ n / ((Nat.factorial n : ℝ) * (Nat.factorial (n + k) : ℝ)) with ha
    have hterm : ∀ n, (-t) ^ n / ((Nat.factorial n : ℝ) * (Nat.factorial (n + k) : ℝ)) = (-1) ^ n * a n := by
      intro n; simp only [ha]; rw [neg_pow, mul_div_assoc]
    have ha0 : ∀ n, 0 ≤ a n := fun n => by simp only [ha]; positivity
    have hsum_a : Summable a := by
      refine Summable.of_nonneg_of_le ha0 (fun n => ?_) (Real.summable_pow_div_factorial t)
      simp only [ha]
      have h1 : (1:ℝ) ≤ (Nat.factorial (n + k) : ℝ) := by
        exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero _)
      have h2 : (0:ℝ) < (Nat.factorial n : ℝ) := by positivity
      apply div_le_div_of_nonneg_left (by positivity) h2
      nlinarith
    have hsum : Summable (fun n => (-1:ℝ) ^ n * a n) := by
      refine Summable.of_norm_bounded hsum_a (fun n => ?_)
      rw [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul, Real.norm_of_nonneg (ha0 n)]
    simp_rw [hterm]
    rw [← hsum.sum_add_tsum_nat_add M, add_sub_cancel_left, ← tsum_mul_left]
    have hsq : ((-1:ℝ) ^ M) ^ 2 = 1 := by
      rw [← pow_mul, mul_comm, pow_mul]; norm_num
    have e : ∀ i, (-1:ℝ) ^ M * ((-1) ^ (i + M) * a (i + M)) = (-1) ^ i * a (i + M) := by
      intro i; rw [pow_add]; linear_combination ((-1:ℝ) ^ i * a (i + M)) * hsq
    simp_rw [e]
    have hrec : ∀ n, a (n + 1) * (((n:ℝ) + 1) * ((n:ℝ) + 1 + k)) = t * a n := by
      intro n
      simp only [ha]
      rw [show n + 1 + k = (n + k) + 1 by ring, Nat.factorial_succ, Nat.factorial_succ]
      have h1 : (n.factorial : ℝ) ≠ 0 := by positivity
      have h2 : ((n + k).factorial : ℝ) ≠ 0 := by positivity
      push_cast
      field_simp
      ring
    have hanti : Antitone (fun i => a (i + M)) := by
      apply antitone_nat_of_succ_le
      intro i
      have hr := hrec (i + M)
      have hP : (0:ℝ) < (((i + M : ℕ) : ℝ) + 1) * (((i + M : ℕ) : ℝ) + 1 + k) := by positivity
      have hle : t ≤ (((i + M : ℕ) : ℝ) + 1) * (((i + M : ℕ) : ℝ) + 1 + k) := by
        push_cast
        have hi : (0:ℝ) ≤ i := Nat.cast_nonneg i
        have hk : (0:ℝ) ≤ k := Nat.cast_nonneg k
        have hM : (0:ℝ) ≤ M := Nat.cast_nonneg M
        nlinarith
      have h0 := ha0 (i + M)
      show a (i + 1 + M) ≤ a (i + M)
      rw [show i + 1 + M = i + M + 1 by ring]
      by_contra hcon
      push_neg at hcon
      have : a (i + M) * ((((i + M : ℕ) : ℝ) + 1) * (((i + M : ℕ) : ℝ) + 1 + k)) <
          a (i + M + 1) * ((((i + M : ℕ) : ℝ) + 1) * (((i + M : ℕ) : ℝ) + 1 + k)) :=
        mul_lt_mul_of_pos_right hcon hP
      nlinarith
    have hsumf : Summable (fun i => (-1:ℝ) ^ i * a (i + M)) := by
      refine Summable.of_norm_bounded ((summable_nat_add_iff M).mpr hsum_a) (fun n => ?_)
      rw [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul, Real.norm_of_nonneg (ha0 _)]
    have := Antitone.alternating_series_le_tendsto hsumf.hasSum.tendsto_sum_nat hanti 0
    simpa using this

  obtain ⟨A, hA⟩ : ∃ A : ℕ → ℝ → ℝ,
      A = fun k t => ∑' n : ℕ, (-t) ^ n / ((Nat.factorial n : ℝ) * (Nat.factorial (n + k) : ℝ)) :=
    ⟨_, rfl⟩
  have leib' : ∀ (k M : ℕ) (t : ℝ), 0 ≤ t → t ≤ ((M : ℝ) + 1) * ((M : ℝ) + 1 + (k : ℝ)) →
      0 ≤ (-1) ^ M * (A k t -
        ∑ n ∈ Finset.range M, (-t) ^ n / ((Nat.factorial n : ℝ) * (Nat.factorial (n + k) : ℝ))) := by
    intro k M t h0 h1
    rw [hA]
    exact leib k M t h0 h1
  have key : ∀ z : ℝ, axF0 z = A 1 (z / 2) ∧ deriv axF0 z = -(1 / 2) * A 2 (z / 2) := by
    intro z
    constructor
    · unfold axF0
      simp only [hA, neg_div]
    · rw [(hderiv z).deriv]
      simp only [hA, neg_div]
  have s11 : ∀ t : ℝ, ∑ n ∈ Finset.range 1, (-t) ^ n / ((Nat.factorial n : ℝ) * (Nat.factorial (n + 1) : ℝ)) = 1 := by
    intro t; norm_num [Finset.sum_range_succ, Nat.factorial]
  have s14 : ∀ t : ℝ, ∑ n ∈ Finset.range 4, (-t) ^ n / ((Nat.factorial n : ℝ) * (Nat.factorial (n + 1) : ℝ)) =
      1 - t / 2 + t ^ 2 / 12 - t ^ 3 / 144 := by
    intro t; norm_num [Finset.sum_range_succ, Nat.factorial] <;> ring
