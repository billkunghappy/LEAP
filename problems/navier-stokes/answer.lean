        g.compContinuousMultilinearMap
          ((iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    exact g.norm_compContinuousMultilinearMap_le _
  have hNBconst : ∀ (u : Fin 3 → ℂ) (ξ : Cyl) (k : ℕ), NB B.h (fun _ : Cyl => u) k ξ ≤ ‖u‖ := by
    intro u ξ k
    unfold NB
    rcases Nat.eq_zero_or_pos k with hk | hk
    · subst hk
      refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
      simp [norm_iteratedFDeriv_zero]
    · rw [iteratedFDeriv_const_of_ne (n := k) (by omega) u]
