  have hι : ContDiff ℝ ∞ (fun z : ℝ × ℝ × ℝ × ℝ × ℝ =>
      (((z.1, z.2.1, z.2.2.1, z.2.2.2.1) : ℝ × ℝ × ℝ × ℝ), z.2.2.2.2)) := by fun_prop
  have hιm : MapsTo (fun z : ℝ × ℝ × ℝ × ℝ × ℝ =>
      (((z.1, z.2.1, z.2.2.1, z.2.2.2.1) : ℝ × ℝ × ℝ × ℝ), z.2.2.2.2))
      {z : ℝ × ℝ × ℝ × ℝ × ℝ | μ / 2 < z.1 ∧ |z.2.2.2.1| < 2 * A} (U ×ˢ univ) := by
    intro z hz
