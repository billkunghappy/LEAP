    have hfin : Real.sqrt (qC B.h ξ) * NB B.h (dR B.h F) n ξ ≤ (1 + S) * Q * T := by
      calc Real.sqrt (qC B.h ξ) * NB B.h (dR B.h F) n ξ
          ≤ Real.sqrt (qC B.h ξ) * (NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u1)) n ξ +
            NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) n ξ) :=
            mul_le_mul_of_nonneg_left hsub hs0.le
