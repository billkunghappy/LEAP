  have hX1sq : X1 ^ 2 ≤ 3 * X := by
    have e : 3 * X - X1 ^ 2 = (|x 0| - |x 1|) ^ 2 + (|x 1| - |x 2|) ^ 2 + (|x 0| - |x 2|) ^ 2 := by
      rw [hXx, hX1d, ← abs_mul_abs_self (x 0), ← abs_mul_abs_self (x 1), ← abs_mul_abs_self (x 2)]
      ring
    linarith [sq_nonneg (|x 0| - |x 1|), sq_nonneg (|x 1| - |x 2|), sq_nonneg (|x 0| - |x 2|)]

  have hMδ : 1 * δ ≤ M * δ := mul_le_mul_of_nonneg_right hM hδ0.le
  have habsBs : |Bs| ≤ M := by rw [abs_of_pos hBs0]; exact hBsb
  have hplus : ∀ u v B : ℝ, |u + v| ≤ δ → |v| ≤ B → |u| ≤ δ + B := fun u v B h hv => by
    have h' := abs_add_le (u + v) (-v)
    rw [abs_neg, add_neg_cancel_right] at h'
    linarith
  have hminus : ∀ u v B : ℝ, |u - v| ≤ δ → |v| ≤ B → |u| ≤ δ + B := fun u v B h hv => by
    have := habs_tri u v; linarith
  have nb0 : |n 0| ≤ 3 * M ^ 2 := by
    have := hminus (n 0) (Bs * σ) _ h0 (hab2 Bs σ M (2 * M) habsBs hσ hM0.le); linarith
