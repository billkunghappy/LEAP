  obtain ⟨pB, hpB⟩ : ∃ p : ℝ, p = r1 + 4 * ℓ := ⟨_, rfl⟩
  obtain ⟨pC, hpC⟩ : ∃ p : ℝ, p = r1 + 6 * ℓ := ⟨_, rfl⟩
  have hpA0 : 0 < pA := by rw [hpA]; linarith
  have hpB0 : 0 < pB := by rw [hpB]; linarith
  have hAB : pA < pB := by rw [hpA, hpB]; linarith
  have hBC : pB < pC := by rw [hpB, hpC]; linarith
  have hs2 : 0 < Real.sqrt 2 := Real.sqrt_pos.2 (by norm_num)

  obtain ⟨f0, hf0⟩ : ∃ f : ℝ → ℝ, f = fun x => x ^ (-(1 / 2 + lam)) / Real.sqrt (2 * x) :=
    ⟨_, rfl⟩
