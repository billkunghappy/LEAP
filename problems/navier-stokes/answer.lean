            (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ))).prodMap (ContinuousLinearMap.id ℝ ℝ))‖ ≤
        C * SC B.h ξ ^ b := by
    intro v' hv'
    obtain ⟨-, hrect, -⟩ :=
      pulse_line_rect5 B.h G.r0 γ (G.ctr γ) ξ.2.2.2 hr0 hr0' hR v' hv'.1.le hv'.2.le
    rw [← hd, ← hy0] at hrect
    obtain ⟨⟨U, hUo, hξU, hAU⟩, hNB⟩ :=
