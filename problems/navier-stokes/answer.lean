  have hZ0b : chartZ h γ.1 ξ₀ ^ 2 < 2 := lt_of_lt_of_le hZ₀2 (hrb _ _ he1 hρ₀1.le hρ₀2.le)
  have hDn : 0 ≤ |ρ - ρ0| := abs_nonneg _
  have hPP : |ρ ^ (2 * h) - ρ0 ^ (2 * h)| ≤ 8 * h * |ρ - ρ0| := by
    calc |ρ ^ (2 * h) - ρ0 ^ (2 * h)| ≤ 4 * |2 * h| * |ρ - ρ0| := hrpow _ _ _ he2 hρ1.le hρ₀1.le
