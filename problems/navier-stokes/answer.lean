      _ = 2 * Real.exp (10 * M / r) * (r / 20) ^ n / ((n : ℝ) + 1) ^ 2 := by ring

  obtain ⟨μ, hμ⟩ : ∃ μ : ℕ → ℝ, μ = fun n =>
      ∏ j ∈ Finset.range n, (1 + 10 * M / r * ((j : ℝ) + 2) / ((j : ℝ) + 1) ^ 3) := ⟨_, rfl⟩
  have hμ0 : μ 0 = 1 := by rw [hμ]; simp
  have hμs : ∀ n : ℕ, μ (n + 1) = μ n * (1 + 10 * M / r * ((n : ℝ) + 2) / ((n : ℝ) + 1) ^ 3) := by
