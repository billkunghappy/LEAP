    have hc : corrOn B l0 x t := ⟨hrad, hxt'.1, hxt'.2⟩
    have hzU : {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} ∈ nhds (x, t) := hUo.mem_nhds hc
    have hzΩ : simDomain B.h (qsOf l0) ∈ nhds (x, t) := hΩ.mem_nhds hxt
    have hEv : (↿(fRes5 B G l0 S)) =ᶠ[nhds (x, t)] fun w =>
        ipb5WV B G l0 e f w + (↿(evOff B.h Fl1 0)) w + (↿(evOff B.h Fl2 0)) w +
        ipb5MV B l0 e (nrm B (2 * Aex B.h + 1/2) (EthP5 B G l0 S)) w +
        (fun w' => ipb5MS B l0 e (nrm B (2 * Aex B.h + 1/2) (EzP5 B G l0 S)) w' • eZ) w +
        (fun w' => (↿(fun y s => radRem5 B G l0 S (ptOf y s (Yph B.h (rad y) s + 0)))) w' • eR w'.1) w -
        (fun w' => ipb5MS B l0 e (nrm B (2 * Aex B.h + 1/2)
          (fun η => rhoP B η * calP5 B G l0 S η.2.1 η.2.2.1)) w' • eR w'.1) w :=
      Filter.eventually_of_mem hzU (fun w hw => hId w hw)
    have hA := assemble m (↿(fRes5 B G l0 S)) (ipb5WV B G l0 e f) (↿(evOff B.h Fl1 0))
      (↿(evOff B.h Fl2 0)) (ipb5MV B l0 e (nrm B (2 * Aex B.h + 1/2) (EthP5 B G l0 S)))
      (fun w' => ipb5MS B l0 e (nrm B (2 * Aex B.h + 1/2) (EzP5 B G l0 S)) w' • eZ)
      (fun w' => (↿(fun y s => radRem5 B G l0 S (ptOf y s (Yph B.h (rad y) s + 0)))) w' • eR w'.1)
      (fun w' => ipb5MS B l0 e (nrm B (2 * Aex B.h + 1/2)
          (fun η => rhoP B η * calP5 B G l0 S η.2.1 η.2.2.1)) w' • eR w'.1)
      (x, t) (hRes.contDiffAt hzU) (HWf.1.contDiffAt hzΩ)
      (hF1s.contDiffAt hzU) (HEth.1.contDiffAt hzΩ)
      ((HEz.2.1.contDiffAt hzΩ).smul contDiffAt_const)
      ((hRs.contDiffAt hzU).smul (hERU.contDiffAt hzU))
      ((HRho.2.1.contDiffAt hzΩ).smul (hERU.contDiffAt hzU)) hEv

    have b1 := le_trans (hCW x t hxt) (key2 CW _ (B.h * min bw (min cm cd) - (Lw m + Lbar m + m))
      _ hq0 hq1 (by linarith))
    have b2 := le_trans (hCF1 0 x t hxt) (key2 CF1 _ _ _ hq0 hq1 le_rfl)
    have b3 := le_trans (hCF2 0 x t hxt) (key2 CF2 _ _ _ hq0 hq1 le_rfl)
    have b4 := le_trans (hCMV x t hxt).1 (key2 CMV _ (B.h * min bw (min cm cd) - (Lw m + Lbar m + m))
      _ hq0 hq1 (by linarith))
    have b5 := le_trans (heZ m _ (x, t) (HEz.2.1.contDiffAt hzΩ))
      (le_trans (hCMz x t hxt).2 (key2 CMz _ (B.h * min bw (min cm cd) - (Lw m + Lbar m + m))
        _ hq0 hq1 (by linarith)))
    have b6 : ‖iteratedFDeriv ℝ m (fun w' => (↿(fun y s => radRem5 B G l0 S
        (ptOf y s (Yph B.h (rad y) s + 0)))) w' • eR w'.1) (x, t)‖ ≤
        |K * CgR| * simScale B.h (x 2) (1 - t) ^ (N : ℝ) := by
      have hb := hK _ x t ((N + m : ℕ) : ℝ) CgR hRs hxt hb1 hb2 (fun i hi => by
        refine le_trans (hCR i 0 x t hxt hrad) ?_
        exact mul_le_mul_of_nonneg_right ((le_abs_self _).trans (hCRle i hi))
          (Real.rpow_nonneg hq0.le _))
      have hex : ((N + m : ℕ) : ℝ) - (m : ℝ) = (N : ℝ) := by push_cast; ring
      rw [hex] at hb
      exact le_trans hb (mul_le_mul_of_nonneg_right (le_abs_self _) hNp.le)
    have b7 : ‖iteratedFDeriv ℝ m (fun w' => ipb5MS B l0 e (nrm B (2 * Aex B.h + 1/2)
        (fun η => rhoP B η * calP5 B G l0 S η.2.1 η.2.2.1)) w' • eR w'.1) (x, t)‖ ≤
        |K * CgM| * simScale B.h (x 2) (1 - t) ^ (B.h * min bw (min cm cd) - (Lw m + Lbar m + m)) := by
      have hb := hK _ x t (B.h * cd - Lbar m) CgM (HRho.2.1.mono hUΩ) hxt hb1 hb2 (fun i hi => by
        refine le_trans (hCr i x t hxt).2 ?_
        refine le_trans (key2 (Cr i) _ (B.h * cd - Lbar m) _ hq0 hq1
          (by linarith [hLmle m i hi])) ?_
        exact mul_le_mul_of_nonneg_right (hCrle i hi) (Real.rpow_nonneg hq0.le _))
      exact le_trans hb (key2 (K * CgM) _ _ _ hq0 hq1 (by linarith))
    have hexp1 : Cnf * simScale B.h (x 2) (1 - t) ^ (B.h * min bw (min cm cd) - (Lw m + Lbar m + m)) =
        |CW| * simScale B.h (x 2) (1 - t) ^ (B.h * min bw (min cm cd) - (Lw m + Lbar m + m)) +
        |CMV| * simScale B.h (x 2) (1 - t) ^ (B.h * min bw (min cm cd) - (Lw m + Lbar m + m)) +
        |CMz| * simScale B.h (x 2) (1 - t) ^ (B.h * min bw (min cm cd) - (Lw m + Lbar m + m)) +
        |K * CgM| * simScale B.h (x 2) (1 - t) ^ (B.h * min bw (min cm cd) - (Lw m + Lbar m + m)) := by
      rw [hCnf]; ring
    have hexp2 : Cfl * simScale B.h (x 2) (1 - t) ^ (N : ℝ) =
        |CF1| * simScale B.h (x 2) (1 - t) ^ (N : ℝ) + |CF2| * simScale B.h (x 2) (1 - t) ^ (N : ℝ) +
        |K * CgR| * simScale B.h (x 2) (1 - t) ^ (N : ℝ) := by
      rw [hCfl]; ring
    have h5 : Cnf * simScale B.h (x 2) (1 - t) ^ (B.h * min bw (min cm cd) - (Lw m + Lbar m + m)) ≤
        (|Coff| + Cnf + Cfl) *
          simScale B.h (x 2) (1 - t) ^ (B.h * min bw (min cm cd) - (Lw m + Lbar m + m)) :=
      mul_le_mul_of_nonneg_right (by linarith [abs_nonneg Coff]) hE.le
    have h6 : Cfl * simScale B.h (x 2) (1 - t) ^ (N : ℝ) ≤
        (|Coff| + Cnf + Cfl) * simScale B.h (x 2) (1 - t) ^ (N : ℝ) :=
      mul_le_mul_of_nonneg_right (by linarith [abs_nonneg Coff]) hNp.le
    linarith

theorem state_physical_bounds_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
    l1 ≤ l0 → ∃ L : ℕ → ℝ, (∀ m, 0 ≤ L m) ∧ ∀ (S : CState) (bw ca cm cd : ℝ), StOrd5 B G l0 S bw ca cm cd →
    MeanId5 B G l0 S →
    (ContDiffOn ℝ ∞ (↿(fA5 B G l0 S)) (simDomain B.h (qsOf l0)) ∧
      ContDiffOn ℝ ∞ (↿(fB B G l0 S)) (simDomain B.h (qsOf l0)) ∧
      ContDiffOn ℝ ∞ (↿(fP5 B G l0 S)) (simDomain B.h (qsOf l0))) ∧
    (∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) → divergence (fun y => fB B G l0 S y t) x = 0 ∧
      inner ℝ x (fB B G l0 S x t) = (0:ℝ) ∧ fB B G l0 S x t 2 = 0) ∧
    (∀ m : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) →
      ‖iteratedFDeriv ℝ m (↿(fA5 B G l0 S)) (x, t)‖ ≤ C * simScale B.h (x 2) (1 - t) ^ (-L m) ∧
      ‖iteratedFDeriv ℝ m (↿(fB B G l0 S)) (x, t)‖ ≤ C * simScale B.h (x 2) (1 - t) ^ (-L m) ∧
      ‖iteratedFDeriv ℝ m (↿(fP5 B G l0 S)) (x, t)‖ ≤ C * simScale B.h (x 2) (1 - t) ^ (-L m)) ∧
    (∀ m N : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) →
      ‖iteratedFDeriv ℝ m (↿(fRes5 B G l0 S)) (x, t)‖ ≤
        C * simScale B.h (x 2) (1 - t) ^ (B.h * min bw (min cm cd) - L m) +
          C * simScale B.h (x 2) (1 - t) ^ (N : ℝ)) ∧
    (∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) →
      (x 0 ^ 2 + x 1 ^ 2 < 2 * B.Xa * simScale B.h (x 2) (1 - t) ∨
        2 * B.Xb * simScale B.h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2) →
      fA5 B G l0 S x t = B.AB x t ∧ fB B G l0 S x t = B.BvB x t ∧ fP5 B G l0 S x t = B.PB x t) ∧
    (∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) → x 0 ^ 2 + x 1 ^ 2 < 2 * B.Xa * simScale B.h (x 2) (1 - t) →
      curl3 (fun w => fA5 B G l0 S w t) x = curl3 (fun w => B.AB w t) x) :=
by
  intro B G hok hG
  have hSim : SimScaleProps B.h := hok.1
  have hBP := hok.2
  unfold BackgroundProps at hBP
  obtain ⟨hB0, -, -, hB3, hB4, -, -, -, -, -, hB10, -⟩ := hBP
  obtain ⟨hh0, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hB0
  obtain ⟨hABs, hBvBs, hPBs⟩ := hB3
  choose CB KB hCB using hB10
  obtain ⟨la, ha⟩ := ipb5_wave_vec_conversion B G hok hG
  obtain ⟨lb, hb⟩ := ipb5_wave_scal_conversion B G hok hG
  obtain ⟨lc, hc⟩ := ipb5_mean_conversion B G hok hG
  obtain ⟨l9, h9⟩ := spb5_residual_bound B G hok hG
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0 + la + lb + lc + l9, fun l0 hl0 => ?_⟩

  have hqcont : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    have hmap : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
      (((EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst).prodMk
        (continuous_const.sub continuous_snd))
    refine hSim.2.2.2.1.continuousOn.comp hmap.continuousOn ?_
    intro w hw
    exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
  have hopen : ∀ qs : ℝ, IsOpen (simDomain B.h qs) := by
    intro qs
    have e : simDomain B.h qs = {w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio qs := rfl
    rw [e]
    exact hqcont.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  have hΩ := hopen (qsOf l0)
  have hΩB := hopen B.qB
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hsub : simDomain B.h (qsOf l0) ⊆ simDomain B.h B.qB := by
    intro z hz
    have hz' : z.2 < 1 ∧ simScale B.h (z.1 2) (1 - z.2) < qsOf l0 := hz
    show z.2 < 1 ∧ simScale B.h (z.1 2) (1 - z.2) < B.qB
    exact ⟨hz'.1, lt_of_lt_of_le hz'.2 hqsB⟩
  have hq : ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) →
      0 < simScale B.h (x 2) (1 - t) ∧ simScale B.h (x 2) (1 - t) ≤ 1 := by
    intro x t hxt
    have hxt' : t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
    exact ⟨(hSim.1 (x 2) (1 - t) (by linarith [hxt'.1])).1, le_trans hxt'.2.le hqs1⟩
  have key2 : ∀ (C a b q : ℝ), 0 < q → q ≤ 1 → b ≤ a → C * q ^ a ≤ |C| * q ^ b := by
    intro C a b q hq0 hq1 hba
    calc C * q ^ a ≤ |C| * q ^ a :=
          mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0.le _)
      _ ≤ |C| * q ^ b :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0 hq1 hba) (abs_nonneg C)
  have hmle : ∀ m : ℕ, ((m : ℕ) : WithTop ℕ∞) ≤ ∞ := fun m => by exact_mod_cast le_top

  obtain ⟨L1, hL1, H1⟩ := ha l0 (by omega) (1/2 - Aex B.h)
  obtain ⟨L2, hL2, H2⟩ := hb l0 (by omega) (-2 * Aex B.h)
  obtain ⟨L3, hL3, H3⟩ := hc l0 (by omega) (1/2 - Aex B.h)
  obtain ⟨L4, hL4, H4⟩ := hc l0 (by omega) (-Aex B.h)
  obtain ⟨L5, hL5, H5⟩ := hc l0 (by omega) (-2 * Aex B.h)
  obtain ⟨L9, hL9, H9⟩ := h9 l0 (by omega)
  obtain ⟨L, hLdef⟩ : ∃ L : ℕ → ℝ, L = fun m =>
      max (max (max (L1 m) (L2 m)) (max (L3 m) (L4 m))) (max (max (L5 m) (L9 m)) |KB m|) := ⟨_, rfl⟩
  have hLm : ∀ m, L m =
      max (max (max (L1 m) (L2 m)) (max (L3 m) (L4 m))) (max (max (L5 m) (L9 m)) |KB m|) := by
    intro m; rw [hLdef]
  have hL1le : ∀ m, L1 m ≤ L m := fun m => by
    rw [hLm m]; exact le_max_of_le_left (le_max_of_le_left (le_max_left _ _))
  have hL2le : ∀ m, L2 m ≤ L m := fun m => by
    rw [hLm m]; exact le_max_of_le_left (le_max_of_le_left (le_max_right _ _))
  have hL3le : ∀ m, L3 m ≤ L m := fun m => by
    rw [hLm m]; exact le_max_of_le_left (le_max_of_le_right (le_max_left _ _))
  have hL4le : ∀ m, L4 m ≤ L m := fun m => by
    rw [hLm m]; exact le_max_of_le_left (le_max_of_le_right (le_max_right _ _))
  have hL5le : ∀ m, L5 m ≤ L m := fun m => by
    rw [hLm m]; exact le_max_of_le_right (le_max_of_le_left (le_max_left _ _))
  have hL9le : ∀ m, L9 m ≤ L m := fun m => by
    rw [hLm m]; exact le_max_of_le_right (le_max_of_le_left (le_max_right _ _))
  have hKle : ∀ m, |KB m| ≤ L m := fun m => by
    rw [hLm m]; exact le_max_of_le_right (le_max_right _ _)
  refine ⟨L, fun m => le_trans (hL1 m) (hL1le m), ?_⟩
  intro S bw ca cm cd hSt hMI
  have hSt0 := hSt
  unfold StOrd5 at hSt
  obtain ⟨hAw, hpw, hPsi, hbd, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hpm, -, -, -⟩ := hSt

  have hfA : ∀ x t, fA5 B G l0 S x t = B.AB x t + (ipb5WV B G l0 (1/2 - Aex B.h) S.Aw (x, t) +
      ipb5MV B l0 (1/2 - Aex B.h) S.Psi (x, t)) := by
    intro x t
    by_cases hcx : corrOn B l0 x t
    · simp only [fA5, evOff, AX5, ipb5WV, ipb5MV, hcx, ↓reduceIte, smul_add, smul_smul]
    · simp only [fA5, evOff, AX5, ipb5WV, ipb5MV, hcx, ↓reduceIte, add_zero]
  have hfB : ∀ x t, fB B G l0 S x t = B.BvB x t + ipb5MV B l0 (-Aex B.h) S.bdir (x, t) := by
    intro x t
    by_cases hcx : corrOn B l0 x t
    · simp only [fB, evOff, BX, ipb5MV, hcx, ↓reduceIte]
    · simp only [fB, evOff, BX, ipb5MV, hcx, ↓reduceIte]
  have hfP : ∀ x t, fP5 B G l0 S x t = B.PB x t +
      (ipb5MS B l0 (-2 * Aex B.h) (nrm B (2 * Aex B.h) (pmP5 B G l0 S)) (x, t) +
        ipb5WS B G l0 (-2 * Aex B.h) S.pw (x, t)) := by
    intro x t
    by_cases hcx : corrOn B l0 x t
    · have hq0 : 0 < qC B.h (ptOf x t (Yph B.h (rad x) t + 0)) :=
        (hSim.1 (x 2) (1 - t) (by linarith [hcx.2.1])).1
      have key : ∀ p : ℝ, qC B.h (ptOf x t (Yph B.h (rad x) t + 0)) ^ (-2 * Aex B.h) *
          (qC B.h (ptOf x t (Yph B.h (rad x) t + 0)) ^ (2 * Aex B.h) * p) = p := by
        intro p
        rw [← mul_assoc, ← Real.rpow_add hq0, show -2 * Aex B.h + 2 * Aex B.h = 0 by ring,
          Real.rpow_zero, one_mul]
      simp only [fP5, evOff, PX5, ipb5MS, ipb5WS, nrm, hcx, ↓reduceIte]
      rw [key]
    · simp only [fP5, evOff, PX5, ipb5MS, ipb5WS, nrm, hcx, ↓reduceIte, add_zero]
  have hFA : (↿(fA5 B G l0 S)) = fun z => (↿B.AB) z + (ipb5WV B G l0 (1/2 - Aex B.h) S.Aw z +
      ipb5MV B l0 (1/2 - Aex B.h) S.Psi z) := by
    funext z; exact hfA z.1 z.2
  have hFB : (↿(fB B G l0 S)) = fun z => (↿B.BvB) z + ipb5MV B l0 (-Aex B.h) S.bdir z := by
    funext z; exact hfB z.1 z.2
  have hFP : (↿(fP5 B G l0 S)) = fun z => (↿B.PB) z +
      (ipb5MS B l0 (-2 * Aex B.h) (nrm B (2 * Aex B.h) (pmP5 B G l0 S)) z +
        ipb5WS B G l0 (-2 * Aex B.h) S.pw z) := by
    funext z; exact hfP z.1 z.2

  obtain ⟨sWV, bWV⟩ := H1 1 S.Aw hAw
  obtain ⟨sWS, bWS⟩ := H2 1 S.pw hpw
  obtain ⟨sPsi, -, bPsi⟩ := H3 (1/2) S.Psi hPsi
  obtain ⟨sbd, -, bbd⟩ := H4 (1/2) S.bdir hbd
  obtain ⟨-, spm, bpm⟩ := H5 0.9 _ hpm
  have hABΩ := hABs.mono hsub
  have hBvBΩ := hBvBs.mono hsub
  have hPBΩ := hPBs.mono hsub

  have hshell : ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) →
      (x 0 ^ 2 + x 1 ^ 2 < 2 * B.Xa * simScale B.h (x 2) (1 - t) ∨
        2 * B.Xb * simScale B.h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2) → corrOn B l0 x t →
      ptOf x t (Yph B.h (rad x) t + 0) ∈ DomC B.h (qsOf l0) ∧
      (XC B.h (ptOf x t (Yph B.h (rad x) t + 0)) < B.Xa ∨
        B.Xb < XC B.h (ptOf x t (Yph B.h (rad x) t + 0))) := by
    intro x t hxt hoff hcx
    obtain ⟨hq0, -⟩ := hq x t hxt
    obtain ⟨hr, ht, hqs⟩ := hcx
    refine ⟨show 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 from ⟨hr, ht, hqs⟩, ?_⟩
    have hrad : rad x ^ 2 = x 0 ^ 2 + x 1 ^ 2 := Real.sq_sqrt (by positivity)
    have hXC : XC B.h (ptOf x t (Yph B.h (rad x) t + 0)) =
        (x 0 ^ 2 + x 1 ^ 2) / (2 * simScale B.h (x 2) (1 - t)) := by
      show rad x ^ 2 / (2 * simScale B.h (x 2) (1 - t)) = _
      rw [hrad]
    rw [hXC]
    rcases hoff with hoff | hoff
    · left
      rw [div_lt_iff₀ (by linarith)]
      linarith
    · right
      rw [lt_div_iff₀ (by linarith)]
      linarith
  have hM0 : ∀ (e : ℝ) (f : Cyl → ℝ), (∀ ξ ∈ DomC B.h (qsOf l0),
      (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → f ξ = 0) → ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) →
      (x 0 ^ 2 + x 1 ^ 2 < 2 * B.Xa * simScale B.h (x 2) (1 - t) ∨
        2 * B.Xb * simScale B.h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2) →
      ipb5MV B l0 e f (x, t) = 0 ∧ ipb5MS B l0 e f (x, t) = 0 := by
    intro e f hf x t hxt hoff
    by_cases hcx : corrOn B l0 x t
    · obtain ⟨hd, hs⟩ := hshell x t hxt hoff hcx
      have h0 := hf _ hd (hs.imp le_of_lt le_of_lt)
      simp only [ipb5MV, ipb5MS, hcx, ↓reduceIte, h0, mul_zero, zero_smul, and_self,
        eq_self_iff_true]
    · simp only [ipb5MV, ipb5MS, hcx, ↓reduceIte, and_self, eq_self_iff_true]
