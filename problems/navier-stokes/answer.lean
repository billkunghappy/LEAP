    have n1 := norm_nonneg (iteratedFDeriv ℝ (k + 1) (↿A₀) z)
    have n2 := norm_nonneg (iteratedFDeriv ℝ (k + 1) (↿B₀) z)
    have n3 := norm_nonneg (iteratedFDeriv ℝ (k + 1) db z)
    have n4 := norm_nonneg (iteratedFDeriv ℝ k (↿A₀) z)
    have n5 := norm_nonneg (iteratedFDeriv ℝ k (↿B₀) z)
    have n6 := norm_nonneg (iteratedFDeriv ℝ k da z)
    have h3 : nL * ‖iteratedFDeriv ℝ (k + 1) da z‖ ≤ nL * U :=
      mul_le_mul_of_nonneg_left (by linarith only [h1, n1, n2, n3]) hnL0
    rw [hK]
    linarith only [h, h2, h3, n4, n5, n6]
  have hu₀U : ∀ k, k < m + 3 → ‖iteratedFDeriv ℝ k (↿u₀) z‖ ≤ K * U := by
    intro k hk
    have h := hcb (↿u₀) (↿A₀) (↿B₀) hA₀ hB₀ hf₀ k
    have h1 := hUs (k + 1) (by omega)
    have h2 := hUs k (by omega)
    have n1 := norm_nonneg (iteratedFDeriv ℝ (k + 1) (↿B₀) z)
    have n2 := norm_nonneg (iteratedFDeriv ℝ (k + 1) da z)
    have n3 := norm_nonneg (iteratedFDeriv ℝ (k + 1) db z)
    have n4 := norm_nonneg (iteratedFDeriv ℝ k (↿A₀) z)
    have n5 := norm_nonneg (iteratedFDeriv ℝ k da z)
    have n6 := norm_nonneg (iteratedFDeriv ℝ k db z)
    have h3 : nL * ‖iteratedFDeriv ℝ (k + 1) (↿A₀) z‖ ≤ nL * U :=
      mul_le_mul_of_nonneg_left (by linarith only [h1, n1, n2, n3]) hnL0
    rw [hK]
    linarith only [h, h2, h3, n4, n5, n6]
  have hdpE : ‖iteratedFDeriv ℝ (m + 1) dp z‖ ≤ E := by
    have h1 := hEs (m + 1) (by omega)
    have n1 := norm_nonneg (iteratedFDeriv ℝ (m + 1) da z)
    have n2 := norm_nonneg (iteratedFDeriv ℝ (m + 1) db z)
    linarith only [h1, n1, n2]
  have hu1q : ∀ q, (↿u₁) q = (↿u₀) q + ε q := by
    intro q
    simp only [hε]
    abel
  have hDu : ∀ q ∈ O, fderiv ℝ (↿u₁) q = fderiv ℝ (↿u₀) q + fderiv ℝ ε q := by
    intro q hq
    have hqO := hO.mem_nhds hq
    have e1 : (↿u₁) = fun q => (↿u₀) q + ε q := funext hu1q
    rw [e1]
    exact fderiv_fun_add ((hu₀s.contDiffAt hqO).differentiableAt (by simp))
      ((hεs.contDiffAt hqO).differentiableAt (by simp))
  have hD2u : ∀ q ∈ O, fderiv ℝ (fderiv ℝ (↿u₁)) q =
      fderiv ℝ (fderiv ℝ (↿u₀)) q + fderiv ℝ (fderiv ℝ ε) q := by
    intro q hq
    have hqO := hO.mem_nhds hq
    have hev : fderiv ℝ (↿u₁) =ᶠ[nhds q] fun q' => fderiv ℝ (↿u₀) q' + fderiv ℝ ε q' :=
      Filter.eventuallyEq_of_mem hqO hDu
    rw [hev.fderiv_eq]
    exact fderiv_fun_add (((hfd _ hu₀s).contDiffAt hqO).differentiableAt (by simp))
      (((hfd _ hεs).contDiffAt hqO).differentiableAt (by simp))
  have hDp : ∀ q ∈ O, fderiv ℝ (↿P₁) q = fderiv ℝ (↿P₀) q + fderiv ℝ dp q := by
    intro q hq
    have hqO := hO.mem_nhds hq
    have e2 : (↿P₁) = fun q => (↿P₀) q + dp q := by
      funext q
      have h : dp q = (↿P₁) q - (↿P₀) q := by rw [← hdp]
      rw [h]
      ring
    rw [e2]
    exact fderiv_fun_add ((hP₀.contDiffAt hqO).differentiableAt (by simp))
      ((hdps.contDiffAt hqO).differentiableAt (by simp))
  obtain ⟨Dj, hDj⟩ : ∃ Dj : ℝ³ × ℝ → ℝ³, Dj = fun q =>
      ((((L₁ (fderiv ℝ ε q) + B (fderiv ℝ (↿u₀) q) (ι (ε q))) +
        B (fderiv ℝ ε q) (ι ((↿u₀) q))) + B (fderiv ℝ ε q) (ι (ε q))) +
        L₃ (fderiv ℝ (fderiv ℝ ε) q)) + L₄ (fderiv ℝ dp q) := ⟨_, rfl⟩
  have hdiff : ∀ q ∈ O, (↿(nsResidual 1 u₁ P₁)) q - (↿(nsResidual 1 u₀ P₀)) q = Dj q := by
    intro q hq
    rw [hR₁.2 q hq, hR₀.2 q hq, hDj, heq u₁ P₁ q, heq u₀ P₀ q]
    rw [hD2u q hq, hDu q hq, hDp q hq, hu1q q]
    simp only [map_add, ContinuousLinearMap.add_apply]
    abel
  have hRR : iteratedFDeriv ℝ m (↿(nsResidual 1 u₁ P₁)) z -
      iteratedFDeriv ℝ m (↿(nsResidual 1 u₀ P₀)) z = iteratedFDeriv ℝ m Dj z := by
    rw [← iteratedFDeriv_sub_apply (hca _ m hR₁.1) (hca _ m hR₀.1)]
    have hev : (↿(nsResidual 1 u₁ P₁)) - (↿(nsResidual 1 u₀ P₀)) =ᶠ[nhds z] Dj :=
      Filter.eventuallyEq_of_mem hzO (fun q hq => by rw [Pi.sub_apply]; exact hdiff q hq)
    exact (hev.iteratedFDeriv ℝ m).eq_of_nhds
  have sT1 : ContDiffOn ℝ ∞ (fun q => L₁ (fderiv ℝ ε q)) O :=
    (hfd ε hεs).continuousLinearMap_comp L₁
  have sT2 : ContDiffOn ℝ ∞ (fun q => B (fderiv ℝ (↿u₀) q) (ι (ε q))) O :=
    ((hfd _ hu₀s).continuousLinearMap_comp B).clm_apply (hεs.continuousLinearMap_comp ι)
  have sT3 : ContDiffOn ℝ ∞ (fun q => B (fderiv ℝ ε q) (ι ((↿u₀) q))) O :=
    ((hfd ε hεs).continuousLinearMap_comp B).clm_apply (hu₀s.continuousLinearMap_comp ι)
  have sT4 : ContDiffOn ℝ ∞ (fun q => B (fderiv ℝ ε q) (ι (ε q))) O :=
    ((hfd ε hεs).continuousLinearMap_comp B).clm_apply (hεs.continuousLinearMap_comp ι)
  have hD2ε : ContDiffOn ℝ ∞ (fderiv ℝ (fderiv ℝ ε)) O := hfd _ (hfd ε hεs)
  have hcomp : ∀ {F G : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (Lc : F →L[ℝ] G) (f : ℝ³ × ℝ → F), ContDiffOn ℝ ∞ f O →
      ContDiffOn ℝ ∞ (fun q => Lc (f q)) O := by
    intro F G _ _ _ _ Lc f hf
    exact hf.continuousLinearMap_comp Lc
  have sT5 : ContDiffOn ℝ ∞ (fun q => L₃ (fderiv ℝ (fderiv ℝ ε) q)) O :=
    hcomp L₃ (fderiv ℝ (fderiv ℝ ε)) hD2ε
  have sT6 : ContDiffOn ℝ ∞ (fun q => L₄ (fderiv ℝ dp q)) O :=
    (hfd dp hdps).continuousLinearMap_comp L₄
  have bT1 : ‖iteratedFDeriv ℝ m (fun q => L₁ (fderiv ℝ ε q)) z‖ ≤ n1 * (K * E) := by
    have h := hlin L₁ n1 hn1e.symm (fderiv ℝ ε) m (hfd ε hεs)
    rw [norm_iteratedFDeriv_fderiv] at h
    exact h.trans (mul_le_mul_of_nonneg_left (hεE (m + 1) (by omega)) hn10)
  have bT5 : ‖iteratedFDeriv ℝ m (fun q => L₃ (fderiv ℝ (fderiv ℝ ε) q)) z‖ ≤ n3 * (K * E) := by
    have h := hlin L₃ n3 hn3e.symm (fderiv ℝ (fderiv ℝ ε)) m hD2ε
    rw [norm_iteratedFDeriv_fderiv, norm_iteratedFDeriv_fderiv] at h
    exact h.trans (mul_le_mul_of_nonneg_left (hεE (m + 1 + 1) (by omega)) hn30)
  have bT6 : ‖iteratedFDeriv ℝ m (fun q => L₄ (fderiv ℝ dp q)) z‖ ≤ n4 * E := by
    have h := hlin L₄ n4 hn4e.symm (fderiv ℝ dp) m (hfd dp hdps)
    rw [norm_iteratedFDeriv_fderiv] at h
    exact h.trans (mul_le_mul_of_nonneg_left hdpE hn40)
  have bT2 : ‖iteratedFDeriv ℝ m (fun q => B (fderiv ℝ (↿u₀) q) (ι (ε q))) z‖ ≤
      nB * 2 ^ m * ((K * U) * (nι * (K * E))) :=
    hbil B nB hnBe.symm (fderiv ℝ (↿u₀)) (fun q => ι (ε q)) (K * U) (nι * (K * E)) (hfd _ hu₀s)
      (hεs.continuousLinearMap_comp ι)
      (fun i hi => by rw [norm_iteratedFDeriv_fderiv]; exact hu₀U (i + 1) (by omega))
      (fun i hi => (hlin ι nι hnιe.symm ε i hεs).trans
        (mul_le_mul_of_nonneg_left (hεE i (by omega)) hnι0))
  have bT3 : ‖iteratedFDeriv ℝ m (fun q => B (fderiv ℝ ε q) (ι ((↿u₀) q))) z‖ ≤
      nB * 2 ^ m * ((K * E) * (nι * (K * U))) :=
    hbil B nB hnBe.symm (fderiv ℝ ε) (fun q => ι ((↿u₀) q)) (K * E) (nι * (K * U)) (hfd _ hεs)
      (hu₀s.continuousLinearMap_comp ι)
      (fun i hi => by rw [norm_iteratedFDeriv_fderiv]; exact hεE (i + 1) (by omega))
      (fun i hi => (hlin ι nι hnιe.symm (↿u₀) i hu₀s).trans
        (mul_le_mul_of_nonneg_left (hu₀U i (by omega)) hnι0))
  have bT4 : ‖iteratedFDeriv ℝ m (fun q => B (fderiv ℝ ε q) (ι (ε q))) z‖ ≤
      nB * 2 ^ m * ((K * E) * (nι * (K * U))) :=
    hbil B nB hnBe.symm (fderiv ℝ ε) (fun q => ι (ε q)) (K * E) (nι * (K * U)) (hfd _ hεs)
      (hεs.continuousLinearMap_comp ι)
      (fun i hi => by rw [norm_iteratedFDeriv_fderiv]; exact hεE (i + 1) (by omega))
      (fun i hi => (hlin ι nι hnιe.symm ε i hεs).trans
        (mul_le_mul_of_nonneg_left (hεU i (by omega)) hnι0))
  obtain ⟨s2, b2⟩ := hadd _ _ _ _ sT1 sT2 bT1 bT2
  obtain ⟨s3, b3⟩ := hadd _ _ _ _ s2 sT3 b2 bT3
  obtain ⟨s4, b4⟩ := hadd _ _ _ _ s3 sT4 b3 bT4
  obtain ⟨s5, b5⟩ := hadd _ _ _ _ s4 sT5 b4 bT5
  obtain ⟨_, b6⟩ := hadd _ _ _ _ s5 sT6 b5 bT6
  have hfin : ‖iteratedFDeriv ℝ m Dj z‖ ≤ c1 * E + c2 * (E * U) := by
    rw [hDj]
    refine b6.trans (le_of_eq ?_)
    rw [hc1, hc2]
    ring
  refine ⟨⟨hca _ m hR₁.1, hca _ m hR₀.1⟩, ?_⟩
  rw [hRR]
  have x1 := mul_nonneg (mul_nonneg hc10 hE0) hU0
  have x2 := mul_nonneg hc20 hE0
  have hid2 : (c1 + c2) * E * (1 + U) = c1 * E + c2 * (E * U) + (c1 * E * U + c2 * E) := by ring
  rw [hid2]
  linarith only [hfin, x1, x2]

theorem bg_flatness : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) (S G Uc Vc W Tth Tz : ℕ → ℝ → ℝ → ℝ), SimScaleProps h → LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → BgOrderZero h Xb cinf F U → BgPositive h Xa Xb m1 m2 aa ab F U T0th T0z S G Uc Vc W Tth Tz → (∀ j : ℕ, 1 ≤ j → ∀ k : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ‖iteratedFDeriv ℝ k (↿(bgAn h j (S j))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) - ((k : ℝ) + 2)) ∧ ‖iteratedFDeriv ℝ k (↿(bgBn h j (G j))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) - ((k : ℝ) + 2)) ∧ ‖iteratedFDeriv ℝ k (↿(bgPn h j (W j))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) - ((k : ℝ) + 2))) → ∃ Cp : ℕ → ℕ → ℝ, ∀ (a L : ℕ → ℝ), (∀ j, 1 ≤ a j) → (∀ j, 2 * a j ≤ a (j + 1)) → (∀ j : ℕ, 1 ≤ j → ∀ m : ℕ, m ≤ j → ∀ q : ℝ, 0 < q → q ≤ 1 / a j → |Cp j m| * q ^ (2 * h * (j : ℝ) / 2) ≤ (1 / 2) ^ j) → ContDiffOn ℝ ∞ (↿(cutSum h a (fun n => bgAn h n (S n)))) (simDomain h 1) → ContDiffOn ℝ ∞ (↿(cutSum h a (fun n => bgBn h n (G n)))) (simDomain h 1) → ContDiffOn ℝ ∞ (↿(cutSum h a (fun n => bgPn h n (W n)))) (simDomain h 1) → (∀ k : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ‖iteratedFDeriv ℝ k (↿(cutSum h a (fun n => bgAn h n (S n)))) (x, t)‖ ≤ ‖iteratedFDeriv ℝ k (↿(bgAn h 0 (S 0))) (x, t)‖ + C * simScale h (x 2) (1 - t) ^ (- L k)) → (∀ k : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ‖iteratedFDeriv ℝ k (↿(cutSum h a (fun n => bgBn h n (G n)))) (x, t)‖ ≤ ‖iteratedFDeriv ℝ k (↿(bgBn h 0 (G 0))) (x, t)‖ + C * simScale h (x 2) (1 - t) ^ (- L k)) → (∀ k : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ‖iteratedFDeriv ℝ k (↿(cutSum h a (fun n => bgPn h n (W n)))) (x, t)‖ ≤ ‖iteratedFDeriv ℝ k (↿(bgPn h 0 (W 0))) (x, t)‖ + C * simScale h (x 2) (1 - t) ^ (- L k)) → (∀ J k : ℕ, k ≤ J → ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → a J * simScale h (x 2) (1 - t) < 1 / 2 → ‖iteratedFDeriv ℝ k (fun z => (↿(cutSum h a (fun n => bgAn h n (S n)))) z - ∑ j ∈ Finset.range (J + 1), (↿(bgAn h j (S j))) z) (x, t)‖ ≤ (1 / 2) ^ J * simScale h (x 2) (1 - t) ^ (2 * h * ((J : ℝ) + 1) / 2 - L k) ∧ ‖iteratedFDeriv ℝ k (fun z => (↿(cutSum h a (fun n => bgBn h n (G n)))) z - ∑ j ∈ Finset.range (J + 1), (↿(bgBn h j (G j))) z) (x, t)‖ ≤ (1 / 2) ^ J * simScale h (x 2) (1 - t) ^ (2 * h * ((J : ℝ) + 1) / 2 - L k) ∧ ‖iteratedFDeriv ℝ k (fun z => (↿(cutSum h a (fun n => bgPn h n (W n)))) z - ∑ j ∈ Finset.range (J + 1), (↿(bgPn h j (W j))) z) (x, t)‖ ≤ (1 / 2) ^ J * simScale h (x 2) (1 - t) ^ (2 * h * ((J : ℝ) + 1) / 2 - L k)) → ∀ m N : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ‖iteratedFDeriv ℝ m (↿(fun (y : ℝ³) (s : ℝ) => nsResidual 1 (fun y' s' => curl3 (fun w => cutSum h a (fun n => bgAn h n (S n)) w s') y' + cutSum h a (fun n => bgBn h n (G n)) y' s') (cutSum h a (fun n => bgPn h n (W n))) y s - stressDivField h (bgSum h a Tth) (bgSum h a Tz) y s)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (N : ℝ) :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z S G Uc Vc W Tth Tz hS hL hO hP hbdj
  have hL' := hL
  have hO' := hO
  have hP' := hP
  obtain ⟨⟨hh0, hh1, -, -, -, -, -, hXa, hXap1, hp12, hp2m1, hm12, hm2Xv, hXvXc, hXcXb⟩, -,
    ⟨hT0th, hT0z, -⟩, -⟩ := hL'
  obtain ⟨⟨hO1a, hO1b, hO1c⟩, -, -, -, hO5, -⟩ := hO'
  obtain ⟨⟨hS0, hG0, -, -, hW0, hT0⟩, ⟨Xm, Xp, -, -, -, hvanT, -⟩, hP2, -, -, ⟨Kr, hKr⟩⟩ := hP'
  have hh2 : h < 1 / 2 := by linarith
  have hγ : 0 < 2 * h := by linarith
  have hXaXb : Xa < Xb := by linarith
  have hsub : simDomain h 1 ⊆ {w : ℝ³ × ℝ | w.2 < 1} := fun w hw => hw.1
  have hΩ : IsOpen (simDomain h 1) := (simQ_props h 1 hh0 hh2 hS).2.1
  have hQpos : ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → 0 < simScale h (x 2) (1 - t) := by
    intro x t hxt
    have ht : t < 1 := hxt.1
    exact (hS.1 (x 2) (1 - t) (by linarith)).1
  have hQle1 : ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → simScale h (x 2) (1 - t) ≤ 1 := by
    intro x t hxt
    have hlt : simScale h (x 2) (1 - t) < 1 := hxt.2
    linarith
  have transfer : ∀ (f g : ℝ³ × ℝ → ℝ³) (k : ℕ) (z : ℝ³ × ℝ), z ∈ simDomain h 1 →
      (∀ w ∈ simDomain h 1, f w = g w) → iteratedFDeriv ℝ k f z = iteratedFDeriv ℝ k g z := by
    intro f g k z hz hfg
    exact ((Filter.eventuallyEq_of_mem (hΩ.mem_nhds hz) hfg).iteratedFDeriv ℝ k).eq_of_nhds

  have hsmA : ∀ n : ℕ, ContDiffOn ℝ ∞ (↿(bgAn h n (S n))) (simDomain h 1) := by
    intro n
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [hS0]; exact hO1a.mono hsub
    · exact (bg_field_smooth_div h n (S n) hS (hP2 n (by omega)).1).1.mono hsub
  have hsmB : ∀ n : ℕ, ContDiffOn ℝ ∞ (↿(bgBn h n (G n))) (simDomain h 1) := by
    intro n
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [hG0]; exact hO1b.mono hsub
    · exact (bg_field_smooth_div h n (G n) hS (hP2 n (by omega)).2.1).2.1.mono hsub
  have hsmP : ∀ n : ℕ, ContDiffOn ℝ ∞ (↿(bgPn h n (W n))) (simDomain h 1) := by
    intro n
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [hW0]; exact hO1c.mono hsub
    · exact (bg_field_smooth_div h n (W n) hS (hP2 n (by omega)).2.2.1).2.2.1.mono hsub

  have hsmT : ∀ n : ℕ, ContDiffOn ℝ ∞ (↿(Tth n)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
      ContDiffOn ℝ ∞ (↿(Tz n)) (Ioi 0 ×ˢ Ioo (-1) 1) := by
    intro n
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · exact ⟨hT0th.congr (fun w hw => (hT0 w.1 w.2 hw.1 hw.2.1 hw.2.2).1),
        hT0z.congr (fun w hw => (hT0 w.1 w.2 hw.1 hw.2.1 hw.2.2).2)⟩
    · exact ⟨(hP2 n (by omega)).2.2.2.2.2.1, (hP2 n (by omega)).2.2.2.2.2.2.1⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℕ → ℝ³ → ℝ → ℝ³, Φ = fun (n : ℕ) => stressDivField h
      (fun q X η => q ^ (2 * (n : ℝ) * h) * Tth n X η) (fun q X η => q ^ (2 * (n : ℝ) * h) * Tz n X η) :=
    ⟨_, rfl⟩
  have hs2 : ∀ n : ℕ, (∀ Y η : ℝ, -1 < η → η < 1 → DifferentiableAt ℝ (fun Y' => Tth n Y' η) Y ∧
      DifferentiableAt ℝ (fun Y' => Tz n Y' η) Y) ∧ ContDiffOn ℝ ∞ (↿(Φ n)) {w : ℝ³ × ℝ | w.2 < 1} ∧
      ((∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 < X → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ m (↿(Tth n)) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(Tz n)) (X, η)‖ ≤ C) →
      ∀ m : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
        ‖iteratedFDeriv ℝ m (↿(Φ n)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (2 * h * (n : ℝ) - ((m : ℝ) + 3))) := by
    intro n
    rw [hΦ]
    exact bg_stress_term_props h Xa Xb n (Tth n) (Tz n) hS hh0 hh2 hXa hXaXb (hsmT n).1 (hsmT n).2 (hvanT n)
  have hDiff := fun n => (hs2 n).1
  have hsmΦ : ∀ n : ℕ, ContDiffOn ℝ ∞ (↿(Φ n)) (simDomain h 1) := fun n => (hs2 n).2.1.mono hsub
  have hbdΦ : ∀ j : ℕ, 1 ≤ j → ∀ m : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
      ‖iteratedFDeriv ℝ m (↿(Φ j)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) - ((m : ℝ) + 3)) := by
    intro j hj
    exact (hs2 j).2.2 (fun m => ((hP2 j hj).2.2.2.2.2.2.2 m).imp fun C hC X η hX e1 e2 =>
      ⟨(hC X η hX e1 e2).2.2.2.2.2.1, (hC X η hX e1 e2).2.2.2.2.2.2⟩)

  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ℕ → ℝ³ → ℝ → ℝ³, Ψ = fun n y s => if n = 0 then (0 : ℝ³) else Φ n y s :=
    ⟨_, rfl⟩
  have hΨ0 : ∀ (y : ℝ³) (s : ℝ), Ψ 0 y s = 0 := by
    intro y s; rw [hΨ]; simp
  have hΨs : ∀ (j : ℕ) (y : ℝ³) (s : ℝ), Ψ (j + 1) y s = Φ (j + 1) y s := by
    intro j y s; rw [hΨ]; simp
  have hΨn : ∀ j : ℕ, 1 ≤ j → Ψ j = Φ j := by
    intro j hj
    rw [hΨ]
    funext y s
    simp [show j ≠ 0 by omega]
  have hzΨ : ∀ (k : ℕ) (z : ℝ³ × ℝ), iteratedFDeriv ℝ k (↿(Ψ 0)) z = 0 := by
    intro k z
    have e : (↿(Ψ 0)) = fun _ : ℝ³ × ℝ => (0 : ℝ³) := funext fun w => hΨ0 w.1 w.2
    rw [e, iteratedFDeriv_fun_zero, Pi.zero_apply]
  have hsmΨ : ∀ j : ℕ, ContDiffOn ℝ ∞ (↿(Ψ j)) (simDomain h 1) := by
    intro j
    rcases Nat.eq_zero_or_pos j with rfl | hj
    · exact (contDiffOn_const (c := (0 : ℝ³))).congr (fun z _ => hΨ0 z.1 z.2)
    · rw [hΨn j (by omega)]; exact hsmΦ j

  obtain ⟨LΦ, hLΦ⟩ : ∃ LΦ : ℕ → ℝ, ∀ m, LΦ m = (m : ℝ) + ∑ i ∈ Finset.range (m + 1), |(fun i : ℕ => (i : ℝ) + 3) i| :=
    ⟨_, fun m => rfl⟩
  have hcut : ∀ j m : ℕ, ∃ C : ℝ, 1 ≤ j → ∀ a : ℝ, 0 < a → ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
      ‖iteratedFDeriv ℝ m (↿(fun y s => simCut h a y s • Φ j y s)) (x, t)‖ ≤
        C * simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) - LΦ m) := by
    intro j m
    by_cases hj : 1 ≤ j
    · obtain ⟨C1, h1⟩ := cutoff_product_bound h 1 (2 * h * (j : ℝ)) (fun i : ℕ => (i : ℝ) + 3) (Φ j)
        hh0 hh2 one_pos le_rfl hS (hsmΦ j) (fun m => hbdΦ j hj m) m
      refine ⟨C1, fun _ a ha x t hxt => ?_⟩
      rw [hLΦ]
      exact h1 a ha x t hxt
    · exact ⟨0, fun h1 => absurd h1 hj⟩
  choose Cf hCf using hcut
  refine ⟨Cf, ?_⟩
  intro a L ha1 ha2 hsmall hcA hcB hcP hgA hgB hgP htail m N
  have hapos : ∀ j, 0 < a j := fun j => lt_of_lt_of_le one_pos (ha1 j)
  have hsupp : ∀ j : ℕ, 1 ≤ j → ∀ k : ℕ, k ≤ j → ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
      a j * simScale h (x 2) (1 - t) ≤ 1 → ∀ X : ℝ,
      X ≤ Cf j k * simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) - LΦ k) →
      X ≤ (1 / 2) ^ j * simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) / 2 - LΦ k) := by
    intro j hj k hk x t hxt hsup X hX
    have hq := hQpos x t hxt
    have hqa : simScale h (x 2) (1 - t) ≤ 1 / a j := by
      rw [le_div_iff₀ (hapos j)]
      linarith
    have hs := hsmall j hj k hk _ hq hqa
    have e : simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) - LΦ k) =
        simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) / 2) *
          simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) / 2 - LΦ k) := by
      rw [← Real.rpow_add hq]
      congr 1
      ring
    rw [e] at hX
    have h1 : 0 ≤ simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) / 2 - LΦ k) := Real.rpow_nonneg hq.le _
    have h2 : 0 ≤ simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) / 2) := Real.rpow_nonneg hq.le _
    calc X ≤ Cf j k * (simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) / 2) *
          simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) / 2 - LΦ k)) := hX
      _ = (Cf j k * simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) / 2)) *
          simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) / 2 - LΦ k) := by ring
      _ ≤ (1 / 2) ^ j * simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) / 2 - LΦ k) :=
          mul_le_mul_of_nonneg_right
            (le_trans (mul_le_mul_of_nonneg_right (le_abs_self _) h2) hs) h1
  have hglob : ∀ (j k : ℕ) (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ∀ X : ℝ,
      X ≤ Cf j k * simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) - LΦ k) →
      X ≤ |Cf j k| * simScale h (x 2) (1 - t) ^ (- LΦ k) := by
    intro j k x t hxt X hX
    have hq := hQpos x t hxt
    have hq1 := hQle1 x t hxt
    have hγj : 0 ≤ 2 * h * (j : ℝ) := by positivity
    have e1 : simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) - LΦ k) ≤
        simScale h (x 2) (1 - t) ^ (- LΦ k) :=
      Real.rpow_le_rpow_of_exponent_ge hq hq1 (by linarith)
    calc X ≤ Cf j k * simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) - LΦ k) := hX
      _ ≤ |Cf j k| * simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) - LΦ k) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hq.le _)
      _ ≤ |Cf j k| * simScale h (x 2) (1 - t) ^ (- LΦ k) :=
          mul_le_mul_of_nonneg_left e1 (abs_nonneg _)
  obtain ⟨hΨS, hΨG, hΨT⟩ := cutSum_props h 1 (2 * h) LΦ a Ψ hh0 hh2 one_pos le_rfl hγ hS ha1 ha2 hsmΨ
    (fun j hj k hk x t hxt hsup => by
      rw [hΨn j hj]
      exact hsupp j hj k hk x t hxt hsup _ (hCf j k hj (a j) (hapos j) x t hxt))
    (fun j hj k => ⟨|Cf j k|, fun x t hxt => by
      rw [hΨn j hj]
      exact hglob j k x t hxt _ (hCf j k hj (a j) (hapos j) x t hxt)⟩)

  have hI : ∀ (x : ℝ³) (t : ℝ), t < 1 →
      stressDivField h (bgSum h a Tth) (bgSum h a Tz) x t = Φ 0 x t + cutSum h a Ψ x t ∧
      ∀ J : ℕ, stressDivField h (bgTsum h Tth J) (bgTsum h Tz J) x t =
        Φ 0 x t + ∑ j ∈ Finset.range (J + 1), Ψ j x t := by
    intro x t ht
    obtain ⟨e1, e2⟩ := bg_stress_cutSum h a Tth Tz hh0 hh2 hS ha1 ha2 hDiff x t ht
    refine ⟨?_, fun J => ?_⟩
    · have hc : cutSum h a Ψ x t = ∑' j : ℕ, simCut h (a (j + 1)) x t • Φ (j + 1) x t := by
        simp only [cutSum, hΨ0, hΨs, zero_add]
      (rw [e1, hc, hΦ]) <;> rfl
    · have hs : ∑ j ∈ Finset.range (J + 1), Ψ j x t = ∑ j ∈ Finset.range J, Φ (j + 1) x t := by
        rw [Finset.sum_range_succ', hΨ0, add_zero]
        exact Finset.sum_congr rfl (fun j _ => hΨs j x t)
      rw [hs, e2 J, Finset.sum_range_succ', hΦ]
      exact add_comm _ _

  have hPer : ∀ k : ℕ, ∃ K : ℝ, ∀ j : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
      ‖iteratedFDeriv ℝ k (↿(bgAn h j (S j))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧
      ‖iteratedFDeriv ℝ k (↿(bgBn h j (G j))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧
      ‖iteratedFDeriv ℝ k (↿(bgPn h j (W j))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧
      ‖iteratedFDeriv ℝ k (↿(Ψ j)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) := by
    intro k
    obtain ⟨C0, K0, h0⟩ := hO5 k
    refine ⟨max K0 ((k : ℝ) + 3), fun j => ?_⟩
    rcases Nat.eq_zero_or_pos j with rfl | hj
    · refine ⟨|C0|, fun x t hxt => ?_⟩
      have hq := hQpos x t hxt
      have hq1 := hQle1 x t hxt
      have eK : simScale h (x 2) (1 - t) ^ (-K0) ≤ simScale h (x 2) (1 - t) ^ (-max K0 ((k : ℝ) + 3)) :=
        Real.rpow_le_rpow_of_exponent_ge hq hq1 (neg_le_neg (le_max_left _ _))
      have conv : ∀ X : ℝ, X ≤ C0 * simScale h (x 2) (1 - t) ^ (-K0) →
          X ≤ |C0| * simScale h (x 2) (1 - t) ^ (-max K0 ((k : ℝ) + 3)) := fun X hX =>
        hX.trans ((mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hq.le _)).trans
          (mul_le_mul_of_nonneg_left eK (abs_nonneg _)))
      obtain ⟨b1, b2, b3⟩ := h0 x t hxt.1 hq1
      rw [← hS0] at b1
      rw [← hG0] at b2
      rw [← hW0] at b3
      refine ⟨conv _ b1, conv _ b2, conv _ b3, ?_⟩
      rw [hzΨ, norm_zero]
      exact mul_nonneg (abs_nonneg _) (Real.rpow_nonneg hq.le _)
    · obtain ⟨Cb, hCb⟩ := hbdj j hj k
      obtain ⟨Cs, hCs⟩ := hbdΦ j hj k
      refine ⟨|Cb| + |Cs|, fun x t hxt => ?_⟩
      have hq := hQpos x t hxt
      have hq1 := hQle1 x t hxt
      have hj0 : (0 : ℝ) ≤ 2 * h * (j : ℝ) := by positivity
      have hmx := le_max_right K0 ((k : ℝ) + 3)
      have e2 : simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) - ((k : ℝ) + 2)) ≤
          simScale h (x 2) (1 - t) ^ (-max K0 ((k : ℝ) + 3)) :=
        Real.rpow_le_rpow_of_exponent_ge hq hq1 (by linarith)
      have e3 : simScale h (x 2) (1 - t) ^ (2 * h * (j : ℝ) - ((k : ℝ) + 3)) ≤
          simScale h (x 2) (1 - t) ^ (-max K0 ((k : ℝ) + 3)) :=
        Real.rpow_le_rpow_of_exponent_ge hq hq1 (by linarith)
      have conv : ∀ (X D e : ℝ), simScale h (x 2) (1 - t) ^ e ≤ simScale h (x 2) (1 - t) ^ (-max K0 ((k : ℝ) + 3)) →
          |D| ≤ |Cb| + |Cs| → X ≤ D * simScale h (x 2) (1 - t) ^ e →
          X ≤ (|Cb| + |Cs|) * simScale h (x 2) (1 - t) ^ (-max K0 ((k : ℝ) + 3)) := by
        intro X D e he hD hX
        calc X ≤ D * simScale h (x 2) (1 - t) ^ e := hX
          _ ≤ |D| * simScale h (x 2) (1 - t) ^ e :=
              mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hq.le _)
          _ ≤ (|Cb| + |Cs|) * simScale h (x 2) (1 - t) ^ (-max K0 ((k : ℝ) + 3)) :=
              mul_le_mul hD he (Real.rpow_nonneg hq.le _) (by positivity)
      obtain ⟨b1, b2, b3⟩ := hCb x t hxt
      have hCb' : |Cb| ≤ |Cb| + |Cs| := by linarith [abs_nonneg Cs]
      have hCs' : |Cs| ≤ |Cb| + |Cs| := by linarith [abs_nonneg Cb]
      refine ⟨conv _ _ _ e2 hCb' b1, conv _ _ _ e2 hCb' b2, conv _ _ _ e2 hCb' b3, ?_⟩
      rw [hΨn j (by omega)]
      exact conv _ _ _ e3 hCs' (hCs x t hxt)
  have comb : ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ∀ (Nn N0 C1 C2 K1 K2 Km T : ℝ), K1 ≤ Km → K2 ≤ Km →
      Nn ≤ N0 + C2 * simScale h (x 2) (1 - t) ^ (-K2) → N0 ≤ C1 * simScale h (x 2) (1 - t) ^ (-K1) →
      |C1| + |C2| ≤ T → Nn ≤ T * simScale h (x 2) (1 - t) ^ (-Km) := by
    intro x t hxt Nn N0 C1 C2 K1 K2 Km T hK1 hK2 hN hN0 hT
    have hq := hQpos x t hxt
    have hq1 := hQle1 x t hxt
    have a1 : C1 * simScale h (x 2) (1 - t) ^ (-K1) ≤ |C1| * simScale h (x 2) (1 - t) ^ (-Km) :=
      le_trans (mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hq.le _))
        (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq hq1 (neg_le_neg hK1)) (abs_nonneg _))
    have a2 : C2 * simScale h (x 2) (1 - t) ^ (-K2) ≤ |C2| * simScale h (x 2) (1 - t) ^ (-Km) :=
      le_trans (mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hq.le _))
        (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq hq1 (neg_le_neg hK2)) (abs_nonneg _))
    have a3 : (|C1| + |C2|) * simScale h (x 2) (1 - t) ^ (-Km) ≤ T * simScale h (x 2) (1 - t) ^ (-Km) :=
      mul_le_mul_of_nonneg_right hT (Real.rpow_nonneg hq.le _)
    linarith
  have hSum : ∀ k : ℕ, ∃ C K : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
      ‖iteratedFDeriv ℝ k (↿(cutSum h a (fun n => bgAn h n (S n)))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧
      ‖iteratedFDeriv ℝ k (↿(cutSum h a (fun n => bgBn h n (G n)))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧
      ‖iteratedFDeriv ℝ k (↿(cutSum h a (fun n => bgPn h n (W n)))) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧
      ‖iteratedFDeriv ℝ k (↿(cutSum h a Ψ)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) := by
    intro k
    obtain ⟨C0, K0, h0⟩ := hO5 k
    obtain ⟨CA, hCA⟩ := hgA k
    obtain ⟨CB, hCB⟩ := hgB k
    obtain ⟨CP, hCP⟩ := hgP k
    obtain ⟨CΨ, hCΨ⟩ := hΨG k
    refine ⟨|C0| + |CA| + |CB| + |CP| + |CΨ|, max K0 (max (L k) (LΦ k)), fun x t hxt => ?_⟩
    have hq1 := hQle1 x t hxt
    have k1 : K0 ≤ max K0 (max (L k) (LΦ k)) := le_max_left _ _
    have k2 : L k ≤ max K0 (max (L k) (LΦ k)) := le_trans (le_max_left _ _) (le_max_right _ _)
    have k3 : LΦ k ≤ max K0 (max (L k) (LΦ k)) := le_trans (le_max_right _ _) (le_max_right _ _)
    obtain ⟨b1, b2, b3⟩ := h0 x t hxt.1 hq1
    rw [← hS0] at b1
    rw [← hG0] at b2
    rw [← hW0] at b3
    have b4 : ‖iteratedFDeriv ℝ k (↿(Ψ 0)) (x, t)‖ ≤ 0 * simScale h (x 2) (1 - t) ^ (-K0) := by
      rw [hzΨ, norm_zero, zero_mul]
    have n0 := abs_nonneg C0
    have nA := abs_nonneg CA
    have nB := abs_nonneg CB
    have nP := abs_nonneg CP
    have nΨ := abs_nonneg CΨ
    refine ⟨comb x t hxt _ _ C0 CA K0 (L k) _ _ k1 k2 (hCA x t hxt) b1 (by linarith),
      comb x t hxt _ _ C0 CB K0 (L k) _ _ k1 k2 (hCB x t hxt) b2 (by linarith),
      comb x t hxt _ _ C0 CP K0 (L k) _ _ k1 k2 (hCP x t hxt) b3 (by linarith),
      comb x t hxt _ _ 0 CΨ K0 (LΦ k) _ _ k1 k3 (hCΨ x t hxt) b4 (by rw [abs_zero]; linarith)⟩
  have hTrunc : ∀ J m : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
      ‖iteratedFDeriv ℝ m (↿(fun (y : ℝ³) (s : ℝ) => nsResidual 1
        (fun y' s' => curl3 (fun w => ∑ j ∈ Finset.range (J + 1), bgAn h j (S j) w s') y' +
          ∑ j ∈ Finset.range (J + 1), bgBn h j (G j) y' s')
        (fun y' s' => ∑ j ∈ Finset.range (J + 1), bgPn h j (W j) y' s') y s -
        (Φ 0 y s + ∑ j ∈ Finset.range (J + 1), Ψ j y s))) (x, t)‖ ≤
        C * simScale h (x 2) (1 - t) ^ (2 * h * ((J : ℝ) + 1) - Kr m) := by
    intro J m
    obtain ⟨C, hC⟩ := hKr J m
    refine ⟨C, fun x t hxt => (le_of_eq ?_).trans (hC x t hxt)⟩
    congr 1
    refine transfer _ _ m (x, t) hxt (fun w hw => ?_)
    show nsResidual 1 _ _ w.1 w.2 - (Φ 0 w.1 w.2 + ∑ j ∈ Finset.range (J + 1), Ψ j w.1 w.2) =
      nsResidual 1 _ _ w.1 w.2 - stressDivField h (bgTsum h Tth J) (bgTsum h Tz J) w.1 w.2
    rw [(hI w.1 w.2 hw.1).2 J]
  obtain ⟨C, hC⟩ := bg_flat_assembly h a L LΦ Kr (fun n => bgAn h n (S n)) (fun n => bgBn h n (G n)) Ψ
    (fun n => bgPn h n (W n)) (cutSum h a (fun n => bgAn h n (S n))) (cutSum h a (fun n => bgBn h n (G n)))
    (Φ 0) (cutSum h a Ψ) (cutSum h a (fun n => bgPn h n (W n))) hh0 hh2 hS ha1
    (fun j => ⟨hsmA j, hsmB j, hsmP j, hsmΨ j⟩) hcA hcB hcP (hsmΦ 0) hΨS hPer hSum
    (fun J k hk x t hxt hJ => ⟨(htail J k hk x t hxt hJ).1, (htail J k hk x t hxt hJ).2.1,
      (htail J k hk x t hxt hJ).2.2, hΨT J k hk x t hxt hJ⟩) hTrunc m N
  refine ⟨C, fun x t hxt => (le_of_eq ?_).trans (hC x t hxt)⟩
  congr 1
  refine transfer _ _ m (x, t) hxt (fun w hw => ?_)
  show nsResidual 1 _ _ w.1 w.2 - stressDivField h (bgSum h a Tth) (bgSum h a Tz) w.1 w.2 =
    nsResidual 1 _ _ w.1 w.2 - (Φ 0 w.1 w.2 + cutSum h a Ψ w.1 w.2)
  rw [(hI w.1 w.2 hw.1).1]

theorem bg_summation : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) (S G Uc Vc W Tth Tz : ℕ → ℝ → ℝ → ℝ), SimScaleProps h → LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → BgOrderZero h Xb cinf F U → BgPositive h Xa Xb m1 m2 aa ab F U T0th T0z S G Uc Vc W Tth Tz → ∃ (qB : ℝ) (AB BvB : ℝ³ → ℝ → ℝ³) (PB : ℝ³ → ℝ → ℝ) (Eb Ub Vb Tth' Tz' : ℝ → ℝ → ℝ → ℝ), BackgroundProps h Xa Xb Xb m1 m2 lam cpatch qB (2 ^ (1 / 2 + h) * cinf) aa ab F U T0th T0z AB BvB PB Eb Ub Vb Tth' Tz' :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z S G Uc Vc W Tth Tz hS hL hO hP
  have hL' := hL
  have hO' := hO
  have hP' := hP
  obtain ⟨⟨hh0, hh1, hlam, hcinf, hcpatch, haa, hab, hXa, hXap1, hp12, hp2m1, hm12, hm2Xv, hXvXc,
    hXcXb⟩, hL1, hL2, -, -, -, -, -, hL8, -, -⟩ := hL'
  obtain ⟨⟨hO1a, hO1b, hO1c⟩, hO2, hO3, hO4, hO5, -⟩ := hO'
