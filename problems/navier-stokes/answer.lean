  have hrC : ((ξ.1 : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr.ne'
  rw [f2, f3]
  simp only [wmoAmp5, velW5, velC5, rotC, nPhi5, DrC, DzC, RC, pang5, f1]
  fin_cases i
  all_goals
    simp only [axV5, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Fin.zero_eta, Fin.mk_one, Fin.isValue, Fin.reduceFinMk, hR, hZ]
