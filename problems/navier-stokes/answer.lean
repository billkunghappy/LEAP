  obtain ⟨Λ, hΛdef⟩ : ∃ Λ : (ℝ × ℝ × ℝ) →L[ℝ] (ℝ × ℝ × ℝ),
      Λ = (Real.sqrt (qC B.h ξ) • ContinuousLinearMap.id ℝ ℝ).prodMap
