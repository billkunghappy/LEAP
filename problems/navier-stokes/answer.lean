    have h1 : ‖∫ y in (0:ℝ)..m, g y‖ ≤ B * |m - 0| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro y hy
      rw [uIoc_of_le hm0] at hy
      rw [Real.norm_eq_abs]
      have e1 := hb y hy.1 (hy.2.trans hmS)
      have e2 := hk1 y hy.1 (hy.2.trans hmS)
      nlinarith
    have h2 : ‖∫ y in m..S, g y‖ ≤ κ0 * B * |S - m| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro y hy
      rw [uIoc_of_le hmS] at hy
      rw [Real.norm_eq_abs]
      have hty : t1 ≤ y := by
