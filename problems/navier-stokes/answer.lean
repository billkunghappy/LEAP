    have hTo : IsOpen (DomC B.h (qsOf l0) ∩ U) := hDo.inter hUo

    have hv : ContDiff ℝ ∞ (fun η : Cyl =>
        (lamT (Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ - ((K1 : ℝ), (K2 : ℝ))) + G.r0) / cib B.h γ.1) := by
      unfold lamT Jpow; fun_prop
    obtain ⟨φt, hφt⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl => pzr5 B G γ * chartZ B.h γ.1 η / epsb B.h γ.1 +
        sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 * RC γ.1 η -
        ((lamT (Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ - ((K1 : ℝ), (K2 : ℝ))) + G.r0) / cib B.h γ.1) *
          (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2) := ⟨_, rfl⟩
    have hφ : ContDiffOn ℝ ∞ φt (DomC B.h (qsOf l0)) := by
      rw [hφt]
      exact (((contDiffOn_const.mul hchartZ.contDiffOn).div_const _).add
        (contDiffOn_const.mul hRC.contDiffOn)).sub
        (hv.contDiffOn.mul ((contDiffOn_const.mul hFang).add (contDiffOn_const.mul (hbase 2))))
    have hEq : ∀ η ∈ U, phiL5 B G γ η = φt η := by
      intro η hη
      rw [hφt]
      simp only [phiL5, vco, etG, hfr _ (hUV η hη)]
    have hN : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhi5 B G γ η i) (DomC B.h (qsOf l0) ∩ U) := by
      intro i
      fin_cases i
      · show ContDiffOn ℝ ∞ (fun η : Cyl => Real.sqrt (Qb γ.1) *
          fderiv ℝ (phiL5 B G γ) η ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv))
          (DomC B.h (qsOf l0) ∩ U)
        exact contDiffOn_const.mul (transfer _ hTo _ φt _ (fun η hη => hEq η hη.2)
          (hφ.mono Set.inter_subset_left) (hdR.mono Set.inter_subset_left))
      · show ContDiffOn ℝ ∞ (fun η : Cyl => pang5 B G γ / RC γ.1 η) (DomC B.h (qsOf l0) ∩ U)
        exact contDiffOn_const.div hRC.contDiffOn (fun η hη => hRCne η hη.1)
      · show ContDiffOn ℝ ∞ (fun η : Cyl => Real.sqrt (Qb γ.1) *
          fderiv ℝ (phiL5 B G γ) η (((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ)) : Cyl)) (DomC B.h (qsOf l0) ∩ U)
        exact contDiffOn_const.mul (transfer _ hTo _ φt (fun _ => (((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ)) : Cyl))
          (fun η hη => hEq η hη.2) (hφ.mono Set.inter_subset_left) contDiffOn_const)

    have hWT : ContDiffOn ℝ ∞ (W0h4 B G γ m) (DomC B.h (qsOf l0) ∩ U) := hWs.mono Set.inter_subset_left
    have hPT : ContDiffOn ℝ ∞ ((primState5 B G).pw γ m) (DomC B.h (qsOf l0) ∩ U) :=
      hPs.mono Set.inter_subset_left
    have hρT : ∀ e : ℝ, ContDiffOn ℝ ∞ (fun η : Cyl => (((rhoQ B γ η ^ e) : ℝ) : ℂ)) (DomC B.h (qsOf l0) ∩ U) :=
      fun e => (hρs e).mono Set.inter_subset_left
    have hdVT : ContDiffOn ℝ ∞ (fun η => dVc B γ.1 (W0h4 B G γ m) η) (DomC B.h (qsOf l0) ∩ U) :=
      hdV.mono Set.inter_subset_left
    have hKT : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => Kmat B G γ η i j) (DomC B.h (qsOf l0) ∩ U) :=
      fun i j => (hK i j).mono Set.inter_subset_left
    have hmv : ContDiffOn ℝ ∞ (fun η => (pulseMatC (Kmat B G γ η)).mulVec (W0h4 B G γ m η))
        (DomC B.h (qsOf l0) ∩ U) := by
      apply contDiffOn_pi.2
      intro i
      have h1 : ContDiffOn ℝ ∞ (fun η => ∑ j : Fin 3, ((Kmat B G γ η i j : ℝ) : ℂ) * W0h4 B G γ m η j)
          (DomC B.h (qsOf l0) ∩ U) :=
        ContDiffOn.sum (fun j _ => (hcast _ _ (hKT i j)).mul (contDiffOn_pi.1 hWT j))
      exact h1.congr (fun η _ => rfl)
    have hdd : ContDiffOn ℝ ∞ (fun η => dDamp5 B G γ η) (DomC B.h (qsOf l0) ∩ U) := by
      have h1 : ContDiffOn ℝ ∞ (fun η => epsb B.h γ.1 * ((kb B.h γ.1 : ℝ)) ^ 2 *
          ∑ i : Fin 3, nPhi5 B G γ η i * nPhi5 B G γ η i) (DomC B.h (qsOf l0) ∩ U) :=
        contDiffOn_const.mul (ContDiffOn.sum (fun i _ => (hN i).mul (hN i)))
      exact h1.congr (fun η _ => rfl)
    have hnc : ContDiffOn ℝ ∞ (fun η => nPhiC5 B G γ η) (DomC B.h (qsOf l0) ∩ U) :=
      contDiffOn_pi.2 (fun i => hcast _ _ (hN i))
    have hfin : ContDiffOn ℝ ∞ (fun η => (((rhoQ B γ η ^ (Aex B.h + 1)) : ℝ) : ℂ) •
        (dVc B γ.1 (W0h4 B G γ m) η + (pulseMatC (Kmat B G γ η)).mulVec (W0h4 B G γ m η)
          + ((m : ℂ) ^ 2 * ((dDamp5 B G γ η : ℝ) : ℂ)) • W0h4 B G γ m η)
        + ((((rhoQ B γ η ^ (1/2 : ℝ)) : ℝ) : ℂ) * (Complex.I * (kb B.h γ.1 : ℂ) * (m : ℂ))
          * (primState5 B G).pw γ m η) • nPhiC5 B G γ η) (DomC B.h (qsOf l0) ∩ U) :=
      ((hρT _).smul ((hdVT.add hmv).add ((contDiffOn_const.mul (hcast _ _ hdd)).smul hWT))).add
        ((((hρT _).mul contDiffOn_const).mul hPT).smul hnc)
    exact ⟨U, hUo, hξU, hfin.congr (fun η _ => rfl)⟩
  ·
    have hfarN : ∃ N : Set Cyl, IsOpen N ∧ ξ0 ∈ N ∧
        ∀ η ∈ N, ¬ inRect B.h γ (G.ctr γ) (2 * G.r0) η.2.2.2 := by
      rw [not_and_or, not_lt, not_lt] at hgood
      rcases hgood with h1 | h1
      · refine ⟨{η : Cyl | |(Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ).1 -
            (Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).1| < 1/24},
          isOpen_lt (hJη.fst.sub continuous_const).abs continuous_const, by simp, ?_⟩
        intro η hη hR
        have e1 : 1/12 ≤ |(Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).1 -
            ((round (Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).1 : ℤ) : ℝ)| := h1
        have e2 : |(Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ).1 -
            ((round (Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ).1 : ℤ) : ℝ)| ≤ 3/100 := (hsmall _ hR).1
        have e3 := hfar _ _ e1 hη
        linarith
      · refine ⟨{η : Cyl | |(Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ).2 -
            (Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).2| < 1/24},
          isOpen_lt (hJη.snd.sub continuous_const).abs continuous_const, by simp, ?_⟩
        intro η hη hR
        have e1 : 1/12 ≤ |(Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).2 -
            ((round (Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).2 : ℤ) : ℝ)| := h1
        have e2 : |(Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ).2 -
            ((round (Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ).2 : ℤ) : ℝ)| ≤ 3/100 := (hsmall _ hR).2
        have e3 := hfar _ _ e1 hη
        linarith
    obtain ⟨N, hNo, hξ0N, hNR⟩ := hfarN
    have hc0 : ∀ η ∈ N, W0c4 B G γ η = 0 := by
      intro η hη
      unfold W0c4
      rw [if_neg (fun h => hNR η hη h.2)]
    have hW0z : ∀ η ∈ N, W0h4 B G γ m η = 0 := by
      intro η hη
      have h0 := hc0 η hη
      show (if m = 1 ∨ m = -1 then (fun i => ((W0c4 B G γ η i : ℝ) : ℂ)) else 0) = 0
      split_ifs
      · funext i
        simp [h0]
      · rfl
    have hp0 : ∀ η ∈ N, (primState5 B G).pw γ m η = 0 := by
      intro η hη
      have h0 := hc0 η hη
      show (((qC B.h η / Qb γ.1) ^ (Aex B.h + 1/2) : ℝ) : ℂ) * presW5 B G (W0c4 B G) γ m η = 0
      unfold presW5
      rw [h0]
      simp
    have hd0 : ∀ η ∈ N, dVc B γ.1 (W0h4 B G γ m) η = 0 := by
      intro η hη
      have hev : W0h4 B G γ m =ᶠ[nhds η] fun _ => (0 : Fin 3 → ℂ) :=
        Filter.eventuallyEq_of_mem (hNo.mem_nhds hη) hW0z
      unfold dVc
      rw [hev.fderiv_eq]
      simp
    have hz : ∀ η ∈ N, princC5 B G γ m η = 0 := by
      intro η hη
      unfold princC5
      rw [hd0 η hη, hW0z η hη, hp0 η hη]
      simp
    exact ⟨N, hNo, hξ0N, (contDiffOn_const (c := (0 : Fin 3 → ℂ))).congr (fun η hη => hz η hη.2)⟩

theorem plin5_window_env : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ c : ℝ, 0 < c ∧ ∀ (γ : Lab) (v : ℝ), ActiveL4 B G γ → 0 ≤ v → v ≤ Lsb B.h G.r0 γ.1 → Lsb B.h G.r0 γ.1 / 5 ≤ |v - Lsb B.h G.r0 γ.1 / 2| → Penv5 B G γ v ≤ Real.exp (-c * (γ.1 : ℝ) ^ 2) :=
by
  intro B G hok hG
  obtain ⟨cl, Cl, hcl, hF⟩ := frame5_consts B G hok hG
  obtain ⟨⟨hr0, -, hu, -, hlmin⟩, -⟩ := hG

  have s1 : ∀ (h : ℝ) (l : ℕ), 1 ≤ l → 0 < cib h l ∧ cib h l * (l : ℝ) ^ 2 ≤ 1 := by
    intro h l hl
    have hL : (1:ℝ) ≤ (l:ℝ) := by exact_mod_cast hl
    have hL2 : (0:ℝ) < (l:ℝ) ^ 2 := by positivity
    have hT1 : (1:ℝ) < Tgc := by
      unfold Tgc
      have := Real.sqrt_nonneg 2
      linarith
    have hT0 : (0:ℝ) < Tgc := by linarith
    have hy0 : (0:ℝ) < (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) :=
      div_pos (Real.rpow_pos_of_pos two_pos _) hL2
    have hQ0 : 0 < Qb l := Real.rpow_pos_of_pos two_pos _
    have hQp : 0 < Qb l ^ (1 + h) := Real.rpow_pos_of_pos hQ0 _
    have hfl : ((bandIdx h l : ℤ) : ℝ) ≤
        Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2)) := Int.floor_le _
    have hz : Tgc ^ (bandIdx h l) ≤ (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) := by
      rw [← Real.rpow_intCast]
      calc Tgc ^ ((bandIdx h l : ℤ) : ℝ)
          ≤ Tgc ^ (Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2))) :=
            Real.rpow_le_rpow_of_exponent_le hT1.le hfl
        _ = (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) := Real.rpow_logb hT0 hT1.ne' hy0
    have hQe : Qb l ^ (1 + h) * (2:ℝ) ^ ((1 + h) * (l:ℝ)) = 1 := by
      unfold Qb
      rw [← Real.rpow_mul (by norm_num), ← Real.rpow_add two_pos]
      have e : -(l:ℝ) * (1 + h) + (1 + h) * (l:ℝ) = 0 := by ring
      rw [e, Real.rpow_zero]
    have hyL : (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) * (l:ℝ) ^ 2 =
        (2:ℝ) ^ ((1 + h) * (l:ℝ)) := div_mul_cancel₀ _ hL2.ne'
    refine ⟨mul_pos (zpow_pos hT0 _) hQp, ?_⟩
    unfold cib
    calc Tgc ^ (bandIdx h l) * Qb l ^ (1 + h) * (l:ℝ) ^ 2
        ≤ (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) * Qb l ^ (1 + h) * (l:ℝ) ^ 2 := by
          have := mul_le_mul_of_nonneg_right hz hQp.le
          exact mul_le_mul_of_nonneg_right this hL2.le
      _ = ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) * (l:ℝ) ^ 2) * Qb l ^ (1 + h) := by ring
      _ = 1 := by rw [hyL, mul_comm]; exact hQe

  have win : ∀ (g : ℝ → ℝ) (L K v : ℝ), Continuous g → 0 < L → 0 ≤ K →
      (∀ w : ℝ, L / 2 ≤ w → g w ≤ 0) → (∀ w : ℝ, 6 * L / 10 ≤ w → g w ≤ -K) →
      (∀ w : ℝ, 0 ≤ w → w ≤ L / 2 → 0 ≤ g w) → (∀ w : ℝ, 0 ≤ w → w ≤ 4 * L / 10 → K ≤ g w) →
      0 ≤ v → L / 5 ≤ |v - L / 2| → ∫ w in (L / 2)..v, g w ≤ -(K * L / 10) := by
    intro g L K v hg hL hK h1 h2 h3 h4 hv0 hw
    have hi : ∀ a b : ℝ, IntervalIntegrable g MeasureTheory.volume a b :=
      fun a b => hg.intervalIntegrable a b
    have hc : ∀ (c a b : ℝ), IntervalIntegrable (fun _ : ℝ => c) MeasureTheory.volume a b :=
      fun c a b => continuous_const.intervalIntegrable a b
    rcases le_or_gt (L / 2) v with hv | hv
    · rw [abs_of_nonneg (by linarith)] at hw
      rw [← intervalIntegral.integral_add_adjacent_intervals (hi (L / 2) (6 * L / 10)) (hi (6 * L / 10) v)]
      have I1 : ∫ w in (L / 2)..(6 * L / 10), g w ≤ ∫ w in (L / 2)..(6 * L / 10), (0:ℝ) :=
        intervalIntegral.integral_mono_on (by linarith) (hi _ _) (hc 0 _ _)
          (fun w hw' => h1 w hw'.1)
      have I2 : ∫ w in (6 * L / 10)..v, g w ≤ ∫ w in (6 * L / 10)..v, (-K) :=
        intervalIntegral.integral_mono_on (by linarith) (hi _ _) (hc (-K) _ _)
          (fun w hw' => h2 w hw'.1)
      rw [intervalIntegral.integral_zero] at I1
      rw [intervalIntegral.integral_const, smul_eq_mul] at I2
      have hp : 0 ≤ K * (v - 7 * L / 10) := mul_nonneg hK (by linarith)
      linarith
    · rw [abs_of_neg (by linarith)] at hw
      rw [intervalIntegral.integral_symm,
        ← intervalIntegral.integral_add_adjacent_intervals (hi v (4 * L / 10)) (hi (4 * L / 10) (L / 2))]
      have J1 : ∫ w in v..(4 * L / 10), K ≤ ∫ w in v..(4 * L / 10), g w :=
        intervalIntegral.integral_mono_on (by linarith) (hc K _ _) (hi _ _)
          (fun w hw' => h4 w (le_trans hv0 hw'.1) hw'.2)
      have J2 : 0 ≤ ∫ w in (4 * L / 10)..(L / 2), g w :=
        intervalIntegral.integral_nonneg (by linarith)
          (fun w hw' => h3 w (by linarith [hw'.1]) hw'.2)
      rw [intervalIntegral.integral_const, smul_eq_mul] at J1
      have hp : 0 ≤ K * (3 * L / 10 - v) := mul_nonneg hK (by linarith)
      linarith

  have ha1 : (1:ℝ) ≤ 1 + G.ustar ^ 2 := by linarith [sq_nonneg G.ustar]
  have ha0 : (0:ℝ) < 1 + G.ustar ^ 2 := by linarith
  have hA : 0 < (1 + G.ustar ^ 2) ^ (3/2:ℝ) := Real.rpow_pos_of_pos ha0 _
  have hM : 0 < 19/100 * G.ustar ^ 2 := by have := pow_pos hu 2; linarith
  have hr32 : (1 + G.ustar ^ 2) ^ (3/2:ℝ) = (1 + G.ustar ^ 2) * Real.sqrt (1 + G.ustar ^ 2) := by
    rw [Real.sqrt_eq_rpow, show (3/2:ℝ) = 1 + 1/2 by norm_num, Real.rpow_add ha0, Real.rpow_one]
  have hsa : 0 < Real.sqrt (1 + G.ustar ^ 2) := Real.sqrt_pos.mpr ha0
  have hc0 : 0 < cl / (1 + G.ustar ^ 2) ^ (3/2:ℝ) := div_pos hcl hA
  refine ⟨cl / (1 + G.ustar ^ 2) ^ (3/2:ℝ) * (19/100 * G.ustar ^ 2) * (2 * G.r0) / 10,
    div_pos (mul_pos (mul_pos hc0 hM) (by linarith)) (by norm_num), ?_⟩
  intro γ v hAct hv0 _hvL hwin
  obtain ⟨-, -, -, -, -, hlam, -⟩ := hF γ hAct
  have hl1 : 1 ≤ γ.1 := by have := hAct.1; omega
  obtain ⟨hci, hciL⟩ := s1 B.h γ.1 hl1
  have hL : 0 < Lsb B.h G.r0 γ.1 := by unfold Lsb; exact div_pos (by linarith) hci
  have hLl : 2 * G.r0 * (γ.1:ℝ) ^ 2 ≤ Lsb B.h G.r0 γ.1 := by
    unfold Lsb
    rw [le_div_iff₀ hci]
    have := mul_le_mul_of_nonneg_left hciL (show (0:ℝ) ≤ 2 * G.r0 by linarith)
    linarith
  have hlam0 : 0 < lam0_5 B G γ := lt_of_lt_of_le hcl hlam
  have hQb : 0 < Qb γ.1 := by unfold Qb; exact Real.rpow_pos_of_pos (by norm_num) _
  have hep : 0 < epsb B.h γ.1 := by unfold epsb; exact Real.rpow_pos_of_pos hQb _
  have hkb : (0:ℝ) < (kb B.h γ.1 : ℝ) := by
    unfold kb
    exact Nat.cast_pos.mpr (Nat.ceil_pos.mpr (Real.rpow_pos_of_pos hep _))
  have hc : 0 < epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 := mul_pos hep (pow_pos hkb 2)
  have hBs : Bs5 B G γ ^ 2 = lam0_5 B G γ /
      (epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * (1 + G.ustar ^ 2) ^ (3/2:ℝ)) := by
    unfold Bs5
    rw [Real.sq_sqrt (div_nonneg hlam0.le (mul_pos hc hA).le)]
  obtain ⟨D, hD⟩ : ∃ D : ℝ, D = lam0_5 B G γ / (1 + G.ustar ^ 2) ^ (3/2:ℝ) := ⟨_, rfl⟩
  have hD0 : 0 ≤ D := by rw [hD]; exact div_nonneg hlam0.le hA.le
  have hcoef : epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 = D := by
    rw [hBs, hD]
    field_simp
  have hDa : D * (1 + G.ustar ^ 2) = lam0_5 B G γ / Real.sqrt (1 + G.ustar ^ 2) := by
    rw [hD, hr32]
    field_simp
  have hDl : cl / (1 + G.ustar ^ 2) ^ (3/2:ℝ) ≤ D := by
    rw [hD]; exact div_le_div_of_nonneg_right hlam hA.le

  have key : ∀ w : ℝ,
      (1 + sco B G γ w ^ 2 ≤ 1 + G.ustar ^ 2 →
        D * ((1 + G.ustar ^ 2) - (1 + sco B G γ w ^ 2)) ≤
          lam0_5 B G γ / Real.sqrt (1 + sco B G γ w ^ 2)
            - epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 * (1 + sco B G γ w ^ 2)) ∧
      (1 + G.ustar ^ 2 ≤ 1 + sco B G γ w ^ 2 →
        lam0_5 B G γ / Real.sqrt (1 + sco B G γ w ^ 2)
            - epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 * (1 + sco B G γ w ^ 2) ≤
          D * ((1 + G.ustar ^ 2) - (1 + sco B G γ w ^ 2))) := by
    intro w
    rw [hcoef]
    have hX0 : 0 < 1 + sco B G γ w ^ 2 := by positivity
    have hsX : 0 < Real.sqrt (1 + sco B G γ w ^ 2) := Real.sqrt_pos.mpr hX0
    constructor
    · intro h
      have := div_le_div_of_nonneg_left hlam0.le hsX (Real.sqrt_le_sqrt h)
      linarith
    · intro h
      have := div_le_div_of_nonneg_left hlam0.le hsa (Real.sqrt_le_sqrt h)
      linarith
  have hsg : sgn γ.2.2 ^ 2 = 1 := by unfold sgn; split_ifs <;> norm_num
  have hsco : ∀ w, sco B G γ w ^ 2 = G.ustar ^ 2 * (1/2 + w / Lsb B.h G.r0 γ.1) ^ 2 := by
    intro w
    unfold sco
    have : G.ustar / 2 + G.ustar * w / Lsb B.h G.r0 γ.1 = G.ustar * (1/2 + w / Lsb B.h G.r0 γ.1) := by
      ring
    rw [this, mul_pow, hsg, one_mul, mul_pow]
  have hu2 : 0 ≤ G.ustar ^ 2 := sq_nonneg _

  have hscc : Continuous (fun w => sco B G γ w) := by
    unfold sco; fun_prop
  have hsqc : Continuous (fun w => Real.sqrt (1 + sco B G γ w ^ 2)) := by fun_prop
  have hgc : Continuous (fun w => lam0_5 B G γ / Real.sqrt (1 + sco B G γ w ^ 2)
      - epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 * (1 + sco B G γ w ^ 2)) := by
    apply Continuous.sub
    · exact Continuous.div continuous_const hsqc
        (fun w => (Real.sqrt_pos.mpr (by positivity)).ne')
    · fun_prop
  have hI := win (fun w => lam0_5 B G γ / Real.sqrt (1 + sco B G γ w ^ 2)
      - epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 * (1 + sco B G γ w ^ 2))
    (Lsb B.h G.r0 γ.1) (D * (19/100 * G.ustar ^ 2)) v hgc hL (mul_nonneg hD0 hM.le)
    (fun w hw => by
      have ht : 1 ≤ 1/2 + w / Lsb B.h G.r0 γ.1 := by
        have : 1/2 ≤ w / Lsb B.h G.r0 γ.1 := by rw [le_div_iff₀ hL]; linarith
        linarith
      have ht2 : 1 ≤ (1/2 + w / Lsb B.h G.r0 γ.1) ^ 2 := one_le_pow₀ ht
      have hX : 1 + G.ustar ^ 2 ≤ 1 + sco B G γ w ^ 2 := by
        rw [hsco w]
        have := mul_le_mul_of_nonneg_left ht2 hu2
        linarith
      have h1 := (key w).2 hX
      have h2 : D * ((1 + G.ustar ^ 2) - (1 + sco B G γ w ^ 2)) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos hD0 (by linarith)
      show lam0_5 B G γ / Real.sqrt (1 + sco B G γ w ^ 2)
        - epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 * (1 + sco B G γ w ^ 2) ≤ 0
      linarith)
    (fun w hw => by
      have ht : 11/10 ≤ 1/2 + w / Lsb B.h G.r0 γ.1 := by
        have : 6/10 ≤ w / Lsb B.h G.r0 γ.1 := by rw [le_div_iff₀ hL]; linarith
        linarith
      have ht2 : (11/10:ℝ) ^ 2 ≤ (1/2 + w / Lsb B.h G.r0 γ.1) ^ 2 :=
        pow_le_pow_left₀ (by norm_num) ht 2
      have h3 := mul_le_mul_of_nonneg_left ht2 hu2
      have hX : 1 + G.ustar ^ 2 ≤ 1 + sco B G γ w ^ 2 := by
        rw [hsco w]
        norm_num at h3
        linarith
      have h1 := (key w).2 hX
      have hm : (1 + G.ustar ^ 2) - (1 + sco B G γ w ^ 2) ≤ -(19/100 * G.ustar ^ 2) := by
        rw [hsco w]
        norm_num at h3
        linarith
      have h2 := mul_le_mul_of_nonneg_left hm hD0
      show lam0_5 B G γ / Real.sqrt (1 + sco B G γ w ^ 2)
        - epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 * (1 + sco B G γ w ^ 2) ≤
          -(D * (19/100 * G.ustar ^ 2))
      linarith)
    (fun w hw0 hw1 => by
      have ht0 : 0 ≤ w / Lsb B.h G.r0 γ.1 := div_nonneg hw0 hL.le
      have ht1 : w / Lsb B.h G.r0 γ.1 ≤ 1/2 := by rw [div_le_iff₀ hL]; linarith
      have ht2 : (1/2 + w / Lsb B.h G.r0 γ.1) ^ 2 ≤ 1 :=
        pow_le_one₀ (by linarith) (by linarith)
      have hX : 1 + sco B G γ w ^ 2 ≤ 1 + G.ustar ^ 2 := by
        rw [hsco w]
        have := mul_le_mul_of_nonneg_left ht2 hu2
        linarith
      have h1 := (key w).1 hX
      have h2 : 0 ≤ D * ((1 + G.ustar ^ 2) - (1 + sco B G γ w ^ 2)) :=
        mul_nonneg hD0 (by linarith)
      show 0 ≤ lam0_5 B G γ / Real.sqrt (1 + sco B G γ w ^ 2)
        - epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 * (1 + sco B G γ w ^ 2)
      linarith)
    (fun w hw0 hw1 => by
      have ht0 : 0 ≤ w / Lsb B.h G.r0 γ.1 := div_nonneg hw0 hL.le
      have ht1 : w / Lsb B.h G.r0 γ.1 ≤ 4/10 := by rw [div_le_iff₀ hL]; linarith
      have ht2 : (1/2 + w / Lsb B.h G.r0 γ.1) ^ 2 ≤ (9/10:ℝ) ^ 2 :=
        pow_le_pow_left₀ (by linarith) (by linarith) 2
      have h3 := mul_le_mul_of_nonneg_left ht2 hu2
      have hX : 1 + sco B G γ w ^ 2 ≤ 1 + G.ustar ^ 2 := by
        rw [hsco w]
        norm_num at h3
        linarith
      have h1 := (key w).1 hX
      have hm : 19/100 * G.ustar ^ 2 ≤ (1 + G.ustar ^ 2) - (1 + sco B G γ w ^ 2) := by
        rw [hsco w]
        norm_num at h3
        linarith
      have h2 := mul_le_mul_of_nonneg_left hm hD0
      show D * (19/100 * G.ustar ^ 2) ≤ lam0_5 B G γ / Real.sqrt (1 + sco B G γ w ^ 2)
        - epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 * (1 + sco B G γ w ^ 2)
      linarith)
    hv0 hwin
  unfold Penv5
  apply Real.exp_le_exp.mpr
  refine le_trans hI ?_
  have h5 : cl / (1 + G.ustar ^ 2) ^ (3/2:ℝ) * (19/100 * G.ustar ^ 2) * (2 * G.r0 * (γ.1:ℝ) ^ 2) ≤
      D * (19/100 * G.ustar ^ 2) * Lsb B.h G.r0 γ.1 :=
    mul_le_mul (mul_le_mul_of_nonneg_right hDl hM.le) hLl
      (mul_nonneg (by linarith) (sq_nonneg _))
      (mul_nonneg hD0 hM.le)
  have e1 : -(cl / (1 + G.ustar ^ 2) ^ (3/2:ℝ) * (19/100 * G.ustar ^ 2) * (2 * G.r0) / 10) *
      (γ.1:ℝ) ^ 2 =
      -(cl / (1 + G.ustar ^ 2) ^ (3/2:ℝ) * (19/100 * G.ustar ^ 2) * (2 * G.r0 * (γ.1:ℝ) ^ 2)) / 10 := by
    ring
  rw [e1]
  linarith

theorem nb_princ_shape : ∀ (h : ℝ) (U : Set Cyl) (ξ : Cyl) (r1 r2 P : Cyl → ℂ) (Dv W : Cyl → (Fin 3 → ℂ)) (Km : Cyl → Matrix (Fin 3) (Fin 3) ℝ) (n : Cyl → (Fin 3 → ℝ)) (c0 : ℝ) (μ κ : ℂ) (k : ℕ) (R E M : ℝ), IsOpen U → ξ ∈ U → ContDiffOn ℝ ∞ r1 U → ContDiffOn ℝ ∞ r2 U → ContDiffOn ℝ ∞ P U → ContDiffOn ℝ ∞ Dv U → ContDiffOn ℝ ∞ W U → (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun η => Km η a b) U) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (fun η => n η a) U) → (∀ j : ℕ, j ≤ k → NB h r1 j ξ ≤ R ∧ NB h r2 j ξ ≤ R) → (∀ j : ℕ, j ≤ k → NB h Dv j ξ ≤ E ∧ NB h W j ξ ≤ E ∧ NB h P j ξ ≤ E) → (∀ j : ℕ, j ≤ k → (∀ a b : Fin 3, NB h (fun η => Km η a b) j ξ ≤ M) ∧ (∀ a : Fin 3, NB h (fun η => n η a) j ξ ≤ M)) → NB h (fun η => r1 η • (Dv η + (pulseMatC (Km η)).mulVec (W η) + (μ * ((c0 * dotProduct (n η) (n η) : ℝ) : ℂ)) • W η) + (r2 η * κ * P η) • (fun i => ((n η i : ℝ) : ℂ))) k ξ ≤ 8 ^ k * R * E * (1 + 3 * M + 3 * ‖μ‖ * |c0| * M ^ 2 + ‖κ‖ * M) :=
by
  intro h U ξ r1 r2 P Dv W Km n c0 μ κ k R E M hU hξ hr1 hr2 hP hDv hW hKm hn HR HE HM
  have hUn : U ∈ nhds ξ := hU.mem_nhds hξ

  have nbnn : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (j : ℕ),
      0 ≤ NB h f j ξ := by
    intro V _ _ f j
    unfold NB
    exact norm_nonneg _
  have clm : ∀ {V V' : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedAddCommGroup V']
      [NormedSpace ℝ V'] (L : V →L[ℝ] V') (f : Cyl → V) (j : ℕ), ContDiffAt ℝ ∞ f ξ →
      NB h (fun η => L (f η)) j ξ ≤ ‖L‖ * NB h f j ξ := by
    intro V V' _ _ _ _ L f j hf
    have e1 : iteratedFDeriv ℝ j (⇑L ∘ f) ξ = L.compContinuousMultilinearMap (iteratedFDeriv ℝ j f ξ) :=
      L.iteratedFDeriv_comp_left hf (i := j) (by exact_mod_cast le_top)
    have e0 : (fun η => L (f η)) = ⇑L ∘ f := rfl
    unfold NB
    rw [e0, e1]
    have e2 : (L.compContinuousMultilinearMap (iteratedFDeriv ℝ j f ξ)).compContinuousLinearMap
          (fun _ => Lnorm h ξ) =
        L.compContinuousMultilinearMap ((iteratedFDeriv ℝ j f ξ).compContinuousLinearMap
          (fun _ => Lnorm h ξ)) := by
      ext v
      rfl
    rw [e2]
    exact ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
  have add : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f g : Cyl → V) (j : ℕ),
      ContDiffAt ℝ ∞ f ξ → ContDiffAt ℝ ∞ g ξ →
      NB h (fun η => f η + g η) j ξ ≤ NB h f j ξ + NB h g j ξ := by
    intro V _ _ f g j hf hg
    have e1 : iteratedFDeriv ℝ j (f + g) ξ = iteratedFDeriv ℝ j f ξ + iteratedFDeriv ℝ j g ξ :=
      iteratedFDeriv_add_apply (hf.of_le (by exact_mod_cast le_top)) (hg.of_le (by exact_mod_cast le_top))
    have e0 : (fun η => f η + g η) = f + g := rfl
    unfold NB
    rw [e0, e1]
    have e2 : (iteratedFDeriv ℝ j f ξ + iteratedFDeriv ℝ j g ξ).compContinuousLinearMap
          (fun _ => Lnorm h ξ) =
        (iteratedFDeriv ℝ j f ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) +
          (iteratedFDeriv ℝ j g ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) := by
      ext v
      rfl
    rw [e2]
    exact norm_add_le _ _
  have pi3 : ∀ (F : Cyl → (Fin 3 → ℂ)) (j : ℕ) (X : ℝ), ContDiffAt ℝ ∞ F ξ → 0 ≤ X →
      (∀ i : Fin 3, NB h (fun η => F η i) j ξ ≤ X) → NB h F j ξ ≤ X := by
    intro F j X hF hX hi
    unfold NB
    refine ContinuousMultilinearMap.opNorm_le_bound hX (fun m => ?_)
    rw [pi_norm_le_iff_of_nonneg (mul_nonneg hX (Finset.prod_nonneg (fun l _ => norm_nonneg _)))]
    intro i
    have e1 : iteratedFDeriv ℝ j (⇑(ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i) ∘ F) ξ =
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i).compContinuousMultilinearMap
          (iteratedFDeriv ℝ j F ξ) :=
      ContinuousLinearMap.iteratedFDeriv_comp_left _ hF (i := j) (by exact_mod_cast le_top)
    have e0 : (fun η => F η i) = ⇑(ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i) ∘ F := rfl
    have e2 : ((iteratedFDeriv ℝ j F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)) m i =
        ((iteratedFDeriv ℝ j (fun η => F η i) ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)) m := by
      rw [e0, e1]
      rfl
    rw [e2]
    calc _ ≤ ‖(iteratedFDeriv ℝ j (fun η => F η i) ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ *
          ∏ l, ‖m l‖ := ContinuousMultilinearMap.le_opNorm _ _
      _ ≤ X * ∏ l, ‖m l‖ :=
          mul_le_mul_of_nonneg_right (hi i) (Finset.prod_nonneg (fun l _ => norm_nonneg _))

  have leib : ∀ (f g : Cyl → ℂ), ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ g U → ∀ kk : ℕ,
      NB h (fun η => f η * g η) kk ξ ≤
        ∑ i ∈ Finset.range (kk + 1), (kk.choose i : ℝ) * NB h f i ξ * NB h g (kk - i) ξ := by
    intro f g hf hg kk
    unfold NB
    generalize Lnorm h ξ = L
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
    have hsm : ∀ F : Cyl → ℂ, ContDiffOn ℝ ∞ F U → ContDiffOn ℝ ∞ (fun z => F (ξ + z)) s := by
      intro F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ F : Cyl → ℂ, ContDiffOn ℝ ∞ F U →
        ContDiffOn ℝ ∞ (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
      intro F hF
      exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
    have key : ∀ F : Cyl → ℂ, ContDiffOn ℝ ∞ F U → ∀ i : ℕ,
        iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
          (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
      intro F hF i
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast le_top)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
      calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
              (fun _ => L) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
              (fun _ => L) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
              (fun _ => L) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
    have hfg : ContDiffOn ℝ ∞ (fun η => f η * g η) U := hf.mul hg
    have leib0 := norm_iteratedFDerivWithin_mul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
      (n := kk) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) * g (ξ + L y)) kk hO h0O] at leib0
    rw [← key _ hfg kk]
    calc ‖iteratedFDeriv ℝ kk (fun z => (fun η => f η * g η) (ξ + L z)) 0‖
        = ‖iteratedFDeriv ℝ kk (fun y => f (ξ + L y) * g (ξ + L y)) 0‖ := rfl
      _ ≤ _ := leib0
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i _
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (kk - i) hO h0O,
          key f hf i, key g hg (kk - i)]
  obtain ⟨a2, ha2⟩ : ∃ a2 : ℝ, a2 = 2 ^ k := ⟨_, rfl⟩
  have ha1 : 1 ≤ a2 := by rw [ha2]; exact one_le_pow₀ (by norm_num)
  have ha0 : 0 ≤ a2 := by linarith
  have mulu : ∀ (f g : Cyl → ℂ) (X Y : ℝ), ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ g U → 0 ≤ X → 0 ≤ Y →
      (∀ i : ℕ, i ≤ k → NB h f i ξ ≤ X ∧ NB h g i ξ ≤ Y) → ∀ j : ℕ, j ≤ k →
      NB h (fun η => f η * g η) j ξ ≤ a2 * X * Y := by
    intro f g X Y hf hg hX hY hb j hj
    refine (leib f g hf hg j).trans ?_
    calc ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * NB h f i ξ * NB h g (j - i) ξ
        ≤ ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * X * Y := by
          apply Finset.sum_le_sum
          intro i hi
          have hi' : i ≤ j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have h1 := (hb i (by omega)).1
          have h2 := (hb (j - i) (by omega)).2
          have hc : (0:ℝ) ≤ (j.choose i : ℝ) := Nat.cast_nonneg _
          exact mul_le_mul (mul_le_mul_of_nonneg_left h1 hc) h2 (nbnn g (j - i)) (mul_nonneg hc hX)
      _ = (2:ℝ) ^ j * X * Y := by
          rw [← Finset.sum_mul, ← Finset.sum_mul]
          congr 2
          exact_mod_cast Nat.sum_range_choose j
      _ ≤ a2 * X * Y := by
          rw [ha2]
          exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right
            (pow_le_pow_right₀ (by norm_num) hj) hX) hY
  have cmul : ∀ (c : ℂ) (f : Cyl → ℂ) (j : ℕ), ContDiffAt ℝ ∞ f ξ →
      NB h (fun η => c * f η) j ξ ≤ ‖c‖ * NB h f j ξ := by
    intro c f j hf
    have e := clm (ContinuousLinearMap.mul ℝ ℂ c) f j hf
    simp only [ContinuousLinearMap.mul_apply'] at e
    exact e.trans (mul_le_mul_of_nonneg_right (ContinuousLinearMap.opNorm_mul_apply_le ℝ ℂ c) (nbnn f j))
  have hg1 : ‖(Complex.ofRealCLM : ℝ →L[ℝ] ℂ)‖ ≤ 1 :=
    ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => by
      rw [Complex.ofRealCLM_apply, Complex.norm_real, one_mul])
  have ofr : ∀ (g : Cyl → ℝ) (j : ℕ), ContDiffAt ℝ ∞ g ξ →
      NB h (fun η => ((g η : ℝ) : ℂ)) j ξ ≤ NB h g j ξ := by
    intro g j hg
    have e := clm Complex.ofRealCLM g j hg
    simp only [Complex.ofRealCLM_apply] at e
    exact e.trans (mul_le_of_le_one_left (nbnn g j) hg1)
  have hp1 : ∀ b : Fin 3, ‖(ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) b)‖ ≤ 1 :=
    fun b => ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => by
      rw [one_mul]; exact norm_le_pi_norm x b)
  have prj : ∀ (F : Cyl → (Fin 3 → ℂ)) (b : Fin 3) (j : ℕ), ContDiffAt ℝ ∞ F ξ →
      NB h (fun η => F η b) j ξ ≤ NB h F j ξ := by
    intro F b j hF
    have e := clm (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) b) F j hF
    simp only [ContinuousLinearMap.proj_apply] at e
    exact e.trans (mul_le_of_le_one_left (nbnn F j) (hp1 b))

  have hR0 : 0 ≤ R := (nbnn r1 0).trans (HR 0 (Nat.zero_le _)).1
  have hE0 : 0 ≤ E := (nbnn W 0).trans (HE 0 (Nat.zero_le _)).2.1
  have hM0 : 0 ≤ M := (nbnn (fun η => n η 0) 0).trans ((HM 0 (Nat.zero_le _)).2 0)

  have hntS : ∀ p : Fin 3, ContDiffOn ℝ ∞ (fun η => ((n η p : ℝ) : ℂ)) U := fun p =>
    (Complex.ofRealCLM.contDiff.comp_contDiffOn (hn p)).congr (fun η _ => by simp)
  have hKtS : ∀ i b : Fin 3, ContDiffOn ℝ ∞ (fun η => ((Km η i b : ℝ) : ℂ)) U := fun i b =>
    (Complex.ofRealCLM.contDiff.comp_contDiffOn (hKm i b)).congr (fun η _ => by simp)
  have hWS : ∀ b : Fin 3, ContDiffOn ℝ ∞ (fun η => W η b) U := fun b => contDiffOn_pi.1 hW b
  have hDvS : ∀ b : Fin 3, ContDiffOn ℝ ∞ (fun η => Dv η b) U := fun b => contDiffOn_pi.1 hDv b
  have hKWS : ∀ i b : Fin 3, ContDiffOn ℝ ∞ (fun η => ((Km η i b : ℝ) : ℂ) * W η b) U :=
    fun i b => (hKtS i b).mul (hWS b)
  have hnnS : ∀ p : Fin 3, ContDiffOn ℝ ∞ (fun η => ((n η p : ℝ) : ℂ) * ((n η p : ℝ) : ℂ)) U :=
    fun p => (hntS p).mul (hntS p)

  have bK : ∀ i b : Fin 3, ∀ j, j ≤ k → NB h (fun η => ((Km η i b : ℝ) : ℂ)) j ξ ≤ M :=
    fun i b j hj => (ofr (fun η => Km η i b) j ((hKm i b).contDiffAt hUn)).trans ((HM j hj).1 i b)
  have bn : ∀ p : Fin 3, ∀ j, j ≤ k → NB h (fun η => ((n η p : ℝ) : ℂ)) j ξ ≤ M :=
    fun p j hj => (ofr (fun η => n η p) j ((hn p).contDiffAt hUn)).trans ((HM j hj).2 p)
  have bW : ∀ b : Fin 3, ∀ j, j ≤ k → NB h (fun η => W η b) j ξ ≤ E :=
    fun b j hj => (prj W b j (hW.contDiffAt hUn)).trans (HE j hj).2.1
  have bDv : ∀ b : Fin 3, ∀ j, j ≤ k → NB h (fun η => Dv η b) j ξ ≤ E :=
    fun b j hj => (prj Dv b j (hDv.contDiffAt hUn)).trans (HE j hj).1
  have bKW : ∀ i b : Fin 3, ∀ j, j ≤ k →
      NB h (fun η => ((Km η i b : ℝ) : ℂ) * W η b) j ξ ≤ a2 * M * E :=
    fun i b => mulu _ _ M E (hKtS i b) (hWS b) hM0 hE0 (fun j hj => ⟨bK i b j hj, bW b j hj⟩)
  have bnn : ∀ p : Fin 3, ∀ j, j ≤ k →
      NB h (fun η => ((n η p : ℝ) : ℂ) * ((n η p : ℝ) : ℂ)) j ξ ≤ a2 * M * M :=
    fun p => mulu _ _ M M (hntS p) (hntS p) hM0 hM0 (fun j hj => ⟨bn p j hj, bn p j hj⟩)

  obtain ⟨T, hT⟩ : ∃ T : Fin 3 → Cyl → ℂ, T = fun i η =>
      (((Km η i 0 : ℝ) : ℂ) * W η 0 + ((Km η i 1 : ℝ) : ℂ) * W η 1) + ((Km η i 2 : ℝ) : ℂ) * W η 2 :=
    ⟨_, rfl⟩
  obtain ⟨S, hS⟩ : ∃ S : Cyl → ℂ, S = fun η =>
      (((n η 0 : ℝ) : ℂ) * ((n η 0 : ℝ) : ℂ) + ((n η 1 : ℝ) : ℂ) * ((n η 1 : ℝ) : ℂ)) +
