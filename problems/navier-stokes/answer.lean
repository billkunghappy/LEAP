theorem rinQ_low_region : ∀ (h η P : ℝ) (c k : ℝ → ℝ), 0 < P → (∀ x : ℝ, 0 ≤ x → x ≤ 1 → Real.sqrt (2 * x) * c (Real.log x) = P * x ^ (3 / 5 : ℝ)) → ContinuousOn (fun x => Real.sqrt (2 * x) * c (Real.log x)) (Set.Ici 0) → (∀ x X : ℝ, 0 < x → x ≤ X → X ≤ Real.exp 1 → Real.sqrt (2 * x) * c (Real.log x) ≤ Real.sqrt (2 * X) * c (Real.log X)) → (∀ x : ℝ, 0 ≤ x → x ≤ Real.exp 1 → k (Real.log x) = 4) → 0 < 4 * ((1 - η ^ 2) * (1 - 2 * η ^ 2 / (1 + η ^ 2)) + (1 - 4 * h) * η ^ 2) - (1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2))) → ∀ X : ℝ, 0 < X → (X ≤ 1 → 1 ≤ 4 * (1 - 2 * h * η ^ 2) - 1 - 5 / 8 * (4 * ((1 - η ^ 2) * (1 - 2 * η ^ 2 / (1 + η ^ 2)) + (1 - 4 * h) * η ^ 2) - (1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2)))) → 1 ≤ rinQf h c k X η) ∧ (1 ≤ X → X ≤ Real.exp 1 → 1 / 5 ≤ 4 * (1 - 2 * h * η ^ 2) - 1 - 7 / 8 * (4 * ((1 - η ^ 2) * (1 - 2 * η ^ 2 / (1 + η ^ 2)) + (1 - 4 * h) * η ^ 2) - (1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2)))) → 1 / 5 ≤ rinQf h c k X η) :=
