theorem ax_repair_moments : ∀ (Pst C T : ℝ) (ℓ G : ℝ → ℝ) (F U : ℝ → ℝ → ℝ) (s1 s2 : ℝ) (β : Fin 2 → ℝ → ℝ) (γ : Fin 3 → ℝ → ℝ) (c : ℝ → Fin 5 → ℝ) (η : ℝ), 0 < Pst → 1 ≤ C → 0 < T → 110 * Real.exp (1 + T) ≤ 110 * (C * Pst) ^ 10 * Real.exp (-9) → AxBumps s1 s2 β γ → AxReg (axFm Pst C T ℓ F γ c) (axUm Pst C G U β c) → -1 < η → η < 1 →
    (∫ x in (Real.exp (-6))..(Real.exp (-5)), ((4 * η + (c η 0 * β 0 x + c η 1 * β 1 x)) - 4 * η)) = axDisc Pst (110 * (C * Pst) ^ 10) (axFm Pst C T ℓ F γ (fun _ => 0)) (axUm Pst C G U β (fun _ => 0)) η 0 →
    (∫ x in (Real.exp (-6))..(Real.exp (-5)), Real.sqrt (2 * x) * ((Pst * (1 + η ^ 2)⁻¹ * x ^ (1 / 10 : ℝ) + (c η 2 * γ 0 x + c η 3 * γ 1 x + c η 4 * γ 2 x)) - Pst * (1 + η ^ 2)⁻¹ * x ^ (1 / 10 : ℝ))) = axDisc Pst (110 * (C * Pst) ^ 10) (axFm Pst C T ℓ F γ (fun _ => 0)) (axUm Pst C G U β (fun _ => 0)) η 1 →
    (∫ x in (Real.exp (-6))..(Real.exp (-5)), ((4 * η + (c η 0 * β 0 x + c η 1 * β 1 x)) * (Real.sqrt (2 * x) * (Pst * (1 + η ^ 2)⁻¹ * x ^ (1 / 10 : ℝ) + (c η 2 * γ 0 x + c η 3 * γ 1 x + c η 4 * γ 2 x))) - 4 * η * (Real.sqrt (2 * x) * (Pst * (1 + η ^ 2)⁻¹ * x ^ (1 / 10 : ℝ))))) = axDisc Pst (110 * (C * Pst) ^ 10) (axFm Pst C T ℓ F γ (fun _ => 0)) (axUm Pst C G U β (fun _ => 0)) η 2 →
    (∫ x in (Real.exp (-6))..(Real.exp (-5)), (((4 * η + (c η 0 * β 0 x + c η 1 * β 1 x)) ^ 2 - (Pst * (1 + η ^ 2)⁻¹ * x ^ (1 / 10 : ℝ) + (c η 2 * γ 0 x + c η 3 * γ 1 x + c η 4 * γ 2 x)) ^ 2 / 2) - ((4 * η) ^ 2 - (Pst * (1 + η ^ 2)⁻¹ * x ^ (1 / 10 : ℝ)) ^ 2 / 2))) = axDisc Pst (110 * (C * Pst) ^ 10) (axFm Pst C T ℓ F γ (fun _ => 0)) (axUm Pst C G U β (fun _ => 0)) η 3 →
    (∫ x in (Real.exp (-6))..(Real.exp (-5)), ((Pst * (1 + η ^ 2)⁻¹ * x ^ (1 / 10 : ℝ) + (c η 2 * γ 0 x + c η 3 * γ 1 x + c η 4 * γ 2 x)) ^ 2 - (Pst * (1 + η ^ 2)⁻¹ * x ^ (1 / 10 : ℝ)) ^ 2) / (2 * x)) = axDisc Pst (110 * (C * Pst) ^ 10) (axFm Pst C T ℓ F γ (fun _ => 0)) (axUm Pst C G U β (fun _ => 0)) η 4 →
    profRadInt (axUm Pst C G U β c) (110 * (C * Pst) ^ 10 * Real.exp (-5)) η = profRadInt (fun _ e => 4 * e) (110 * (C * Pst) ^ 10 * Real.exp (-5)) η ∧
    profRadInt (fun x e => 2 * x * axFm Pst C T ℓ F γ c x e) (110 * (C * Pst) ^ 10 * Real.exp (-5)) η =
      profRadInt (fun x e => 2 * x * refFin Pst (110 * (C * Pst) ^ 10) x e) (110 * (C * Pst) ^ 10 * Real.exp (-5)) η ∧
    profRadInt (fun x e => axUm Pst C G U β c x e * (2 * x * axFm Pst C T ℓ F γ c x e)) (110 * (C * Pst) ^ 10 * Real.exp (-5)) η =
      profRadInt (fun x e => 4 * e * (2 * x * refFin Pst (110 * (C * Pst) ^ 10) x e)) (110 * (C * Pst) ^ 10 * Real.exp (-5)) η ∧
    profRadInt (fun x e => axUm Pst C G U β c x e ^ 2 - x * axFm Pst C T ℓ F γ c x e ^ 2) (110 * (C * Pst) ^ 10 * Real.exp (-5)) η =
      profRadInt (fun x e => (4 * e) ^ 2 - x * refFin Pst (110 * (C * Pst) ^ 10) x e ^ 2) (110 * (C * Pst) ^ 10 * Real.exp (-5)) η ∧
    profRadInt (fun x e => axFm Pst C T ℓ F γ c x e ^ 2) (110 * (C * Pst) ^ 10 * Real.exp (-5)) η =
      profRadInt (fun x e => refFin Pst (110 * (C * Pst) ^ 10) x e ^ 2) (110 * (C * Pst) ^ 10 * Real.exp (-5)) η :=
by
  intro Pst C T ℓ G F U s1 s2 β γ c η hPst hC hT hXR hB hReg hη1 hη2 h0 h1 h2 h3 h4

  have split : ∀ (g g0 gr H : ℝ → ℝ) (XR s d : ℝ), 0 < XR →
