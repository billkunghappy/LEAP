          rw [show bp + bc + bI = bp + (bc + bI) by ring, Real.rpow_add hX0 bp]
          ring
  have hQ : ∀ n : ℕ, ∃ C b : ℝ, 0 ≤ C ∧ 0 ≤ b ∧ ∀ j < n, ∀ (γ : Lab) (ξ : Cyl), ActiveL4 B G γ →
      ξ ∈ DomC B.h B.qB → etaL B.h γ ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      ∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
      sJet5 (fun s : ℝ × ℝ × ℝ => G.tH γ s v) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) j ≤
        C * SC B.h ξ ^ b * Penv5 B G γ v := by
    intro n
    induction n with
    | zero => exact ⟨0, 0, le_rfl, le_rfl, fun j hj => absurd hj (Nat.not_lt_zero _)⟩
    | succ n ih =>
      obtain ⟨CI, bI, hCI, hbI, hI⟩ := ih
      obtain ⟨C', b', hC', hb', hS⟩ := step n CI bI hCI hbI hI
      refine ⟨max CI C', max bI b', le_trans hCI (le_max_left _ _), le_trans hbI (le_max_left _ _), ?_⟩
      intro j hj γ ξ h1 h2 h3 h4 h5 v hv
      have hPv := (hPpos γ v).le
      rcases Nat.lt_or_ge j n with hlt | hge
      · exact (hI j hlt γ ξ h1 h2 h3 h4 h5 v hv).trans (mul_le_mul_of_nonneg_right
          (hmono ξ _ CI _ bI _ le_rfl (le_max_left _ _) (le_max_left _ _) (le_trans hCI (le_max_left _ _))) hPv)
      · have hjn : j = n := by omega
        subst hjn
        exact (hS γ ξ h1 h2 h3 h4 h5 v hv).trans (mul_le_mul_of_nonneg_right
          (hmono ξ _ C' _ b' _ le_rfl (le_max_right _ _) (le_max_right _ _) (le_trans hCI (le_max_left _ _))) hPv)
  unfold THJetBound5
  intro k
  obtain ⟨C, b, -, -, h⟩ := hQ (k+1)
  exact ⟨C, b, h k (Nat.lt_succ_self k)⟩

theorem hcol_pair_sjet : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → THJetBound5 B G →
    ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (ξ : Cyl), ActiveL4 B G γ → ξ ∈ DomC B.h B.qB → etaL B.h γ ξ ≠ 0 →
    B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
    ContDiffAt ℝ ∞ (HPair5 B G γ) (ξ.1, ξ.2.1, ξ.2.2.1) ∧
    ∀ i : ℕ, i ≤ k → sJet5 (HPair5 B G γ) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) i ≤ C * SC B.h ξ ^ b :=
by
  intro B G hB hG hTH k

  have PIC : ∀ {P E' F : Type} [NormedAddCommGroup P] [NormedSpace ℝ P]
      [FiniteDimensional ℝ P] [NormedAddCommGroup E'] [NormedSpace ℝ E'] [FiniteDimensional ℝ E']
      [MeasurableSpace E'] [BorelSpace E'] [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (μ : MeasureTheory.Measure E') [MeasureTheory.IsFiniteMeasureOnCompacts μ]
      (U : Set P) (V K : Set E') (G : P → E' → F) (hU : IsOpen U) (hV : IsOpen V) (hK : IsCompact K)
      (hKV : K ⊆ V) (hG : ContDiffOn ℝ ∞ (fun z : P × E' => G z.1 z.2) (U ×ˢ V)),
      ContDiffOn ℝ ∞ (fun x => ∫ y in K, G x y ∂μ) U ∧
      (∀ k : ℕ, ∀ x ∈ U, iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) x =
        ∫ y in K, iteratedFDeriv ℝ k (fun x' => G x' y) x ∂μ) := by
    intro P E' F _ _ _ _ _ _ _ _ _ _ _ μ _ U V K G hU hV hK hKV hG
    have hO : IsOpen (U ×ˢ V) := hU.prod hV
    have hKm : MeasurableSet K := hK.isClosed.measurableSet
    have slice : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F'] (H : P → E' → F'),
        ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) →
        ∀ x ∈ U, ContinuousOn (fun y => H x y) K := by
      intro F' _ _ H hH x hx
      have hc : Continuous (fun y : E' => ((x, y) : P × E')) := by fun_prop
      have h := ContinuousOn.comp (g := fun z : P × E' => H z.1 z.2) (f := fun y : E' => ((x, y) : P × E'))
        hH.continuousOn hc.continuousOn (fun y hy => ⟨hx, hKV hy⟩)
      exact h
    have param_fderiv : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F'] (H : P → E' → F'),
        ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) →
        ContDiffOn ℝ ∞ (fun z : P × E' => fderiv ℝ (fun x' => H x' z.2) z.1) (U ×ˢ V) := by
      intro F' _ _ H hH p hp
      have hHa : ContDiffAt ℝ ∞ (fun z : P × E' => H z.1 z.2) p := hH.contDiffAt (hO.mem_nhds hp)
      apply ContDiffAt.contDiffWithinAt
      have h1 : ContDiffAt ℝ ∞ (Function.uncurry (fun (q : P × E') (x' : P) => H x' q.2)) (p, p.1) := by
        have e : Function.uncurry (fun (q : P × E') (x' : P) => H x' q.2) =
            (fun z : P × E' => H z.1 z.2) ∘ (fun w : (P × E') × P => (w.2, w.1.2)) := rfl
        rw [e]
        apply ContDiffAt.comp (g := fun z : P × E' => H z.1 z.2) (p, p.1)
        · simpa using hHa
        · fun_prop
      exact ContDiffAt.fderiv (f := fun (q : P × E') (x' : P) => H x' q.2)
        (g := Prod.fst) h1 contDiffAt_fst (le_of_eq ENat.coe_top_add_one)
    have param_hasFDeriv : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F']
        (H : P → E' → F'), ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) → ∀ x ∈ U,
        HasFDerivAt (fun x' => ∫ y in K, H x' y ∂μ) (∫ y in K, fderiv ℝ (fun x' => H x' y) x ∂μ) x := by
      intro F' _ _ H hH x hx
      have hHs := param_fderiv H hH
      obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hU x hx
      have hsU : Metric.closedBall x (δ / 2) ⊆ U :=
        (Metric.closedBall_subset_ball (by linarith)).trans hball
      have hsn : Metric.closedBall x (δ / 2) ∈ nhds x := Metric.closedBall_mem_nhds x (by linarith)
      have hC : IsCompact (Metric.closedBall x (δ / 2) ×ˢ K) := (isCompact_closedBall _ _).prod hK
      have hCsub : Metric.closedBall x (δ / 2) ×ˢ K ⊆ U ×ˢ V := fun z hz => ⟨hsU hz.1, hKV hz.2⟩
      obtain ⟨Bd, hB⟩ := hC.exists_bound_of_continuousOn (hHs.continuousOn.mono hCsub)
      refine hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := μ.restrict K)
        (F := fun x' y => H x' y) (F' := fun x' y => fderiv ℝ (fun x'' => H x'' y) x')
        (bound := fun _ => Bd) hsn ?_ ?_ ?_ ?_ ?_ ?_
      · filter_upwards [hU.mem_nhds hx] with x' hx'
        exact (slice H hH x' hx').aestronglyMeasurable_of_isCompact hK hKm
      · exact (slice H hH x hx).integrableOn_compact hK
      · exact (slice (fun x' y => fderiv ℝ (fun x'' => H x'' y) x') hHs x hx).aestronglyMeasurable_of_isCompact
          hK hKm
      · exact ae_restrict_of_forall_mem hKm (fun y hy x' hx' => hB (x', y) ⟨hx', hy⟩)
      · exact continuousOn_const.integrableOn_compact hK
      · refine ae_restrict_of_forall_mem hKm (fun y hy x' hx' => ?_)
        have hHa : ContDiffAt ℝ ∞ (fun z : P × E' => H z.1 z.2) (x', y) :=
          hH.contDiffAt (hO.mem_nhds ⟨hsU hx', hKV hy⟩)
        have hc : ContDiffAt ℝ ∞ (fun x'' : P => ((x'', y) : P × E')) x' := by fun_prop
        have h2 := ContDiffAt.comp (g := fun z : P × E' => H z.1 z.2) x' hHa hc
        have : ContDiffAt ℝ ∞ (fun x'' => H x'' y) x' := h2
        exact (this.differentiableAt (by simp)).hasFDerivAt
    have hD0 : ∀ x y, iteratedFDeriv ℝ 0 (fun x' => G x' y) x =
        (continuousMultilinearCurryFin0 ℝ P F).symm (G x y) := by
      intro x y; rw [iteratedFDeriv_zero_eq_comp]; rfl
    have hDs : ∀ (k : ℕ) x y, iteratedFDeriv ℝ (k + 1) (fun x' => G x' y) x =
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm
          (fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') x) := by
      intro k x y; rw [iteratedFDeriv_succ_eq_comp_left]; rfl
    have D_smooth : ∀ k : ℕ, ContDiffOn ℝ ∞
        (fun z : P × E' => iteratedFDeriv ℝ k (fun x' => G x' z.2) z.1) (U ×ˢ V) := by
      intro k
      induction k with
      | zero =>
        have e : (fun z : P × E' => iteratedFDeriv ℝ 0 (fun x' => G x' z.2) z.1) =
            (continuousMultilinearCurryFin0 ℝ P F).symm ∘ (fun z : P × E' => G z.1 z.2) := by
          funext z; exact hD0 z.1 z.2
        rw [e]
        exact (continuousMultilinearCurryFin0 ℝ P F).symm.contDiff.comp_contDiffOn hG
      | succ k ih =>
        have e : (fun z : P × E' => iteratedFDeriv ℝ (k + 1) (fun x' => G x' z.2) z.1) =
            (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm ∘
              (fun z : P × E' => fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' z.2) x') z.1) := by
          funext z; exact hDs k z.1 z.2
        rw [e]
        have h2 := param_fderiv (fun x' y => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') ih
        exact (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm.contDiff.comp_contDiffOn h2
    have formula : ∀ k : ℕ, ∀ x ∈ U, iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) x =
        ∫ y in K, iteratedFDeriv ℝ k (fun x' => G x' y) x ∂μ := by
      intro k
      induction k with
      | zero =>
        intro x _
        rw [iteratedFDeriv_zero_eq_comp (f := fun x' => ∫ y in K, G x' y ∂μ)]
        simp only [hD0]
        exact (ContinuousLinearEquiv.integral_comp_comm
          (continuousMultilinearCurryFin0 ℝ P F).symm.toContinuousLinearEquiv (fun y => G x y)).symm
      | succ k ih =>
        intro x hx
        have hα : iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) =ᶠ[nhds x]
            (fun x' => ∫ y in K, iteratedFDeriv ℝ k (fun x'' => G x'' y) x' ∂μ) :=
          Filter.eventuallyEq_of_mem (hU.mem_nhds hx) ih
        have hβ := (param_hasFDeriv (fun x' y => iteratedFDeriv ℝ k (fun x'' => G x'' y) x')
          (D_smooth k) x hx).fderiv
        rw [iteratedFDeriv_succ_eq_comp_left (f := fun x' => ∫ y in K, G x' y ∂μ), Function.comp_apply,
          hα.fderiv_eq, hβ]
        simp only [hDs]
        have hL := ContinuousLinearEquiv.integral_comp_comm (μ := μ.restrict K) (𝕜 := ℝ)
          (E := P →L[ℝ] ContinuousMultilinearMap ℝ (fun _ : Fin k => P) F)
          (F := ContinuousMultilinearMap ℝ (fun _ : Fin (k + 1) => P) F)
          (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm.toContinuousLinearEquiv
          (fun y => fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') x)
        exact hL.symm
    have hsmooth : ContDiffOn ℝ ∞ (fun x => ∫ y in K, G x y ∂μ) U := by
      have key : ∀ m : ℕ, EqOn (iteratedFDerivWithin ℝ m (fun x => ∫ y in K, G x y ∂μ) U)
          (fun x => ∫ y in K, iteratedFDeriv ℝ m (fun x' => G x' y) x ∂μ) U := by
        intro m x hx
        rw [iteratedFDerivWithin_of_isOpen m hU hx]
        exact formula m x hx
      have hdiff : ∀ m : ℕ, DifferentiableOn ℝ
          (fun x => ∫ y in K, iteratedFDeriv ℝ m (fun x' => G x' y) x ∂μ) U :=
        fun m x hx => (param_hasFDeriv (fun x' y => iteratedFDeriv ℝ m (fun x'' => G x'' y) x')
          (D_smooth m) x hx).differentiableAt.differentiableWithinAt
      exact contDiffOn_of_continuousOn_differentiableOn (n := ⊤)
        (fun m _ => ((hdiff m).continuousOn).congr (key m))
        (fun m _ => (hdiff m).congr (key m))
    exact ⟨hsmooth, formula⟩

  have NJB : ∀ {E F₁ F₂ F₃ : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F₁]
      [NormedSpace ℝ F₁] [NormedAddCommGroup F₂] [NormedSpace ℝ F₂] [NormedAddCommGroup F₃] [NormedSpace ℝ F₃]
      (Bil : F₁ →L[ℝ] F₂ →L[ℝ] F₃) (f : E → F₁) (g : E → F₂) (x0 : E) (Λ : E →L[ℝ] E) (k : ℕ)
      (hf : ContDiffAt ℝ ∞ f x0) (hg : ContDiffAt ℝ ∞ g x0),
      ContDiffAt ℝ ∞ (fun x => Bil (f x) (g x)) x0 ∧
        sJet5 (fun x => Bil (f x) (g x)) x0 Λ k ≤
          ‖Bil‖ * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * sJet5 f x0 Λ i * sJet5 g x0 Λ (k - i) := by
    intro E F₁ F₂ F₃ _ _ _ _ _ _ _ _ Bil f g x0 Λ k hf hg
    have hBf : ContDiffAt ℝ ∞ (fun x => Bil (f x)) x0 := Bil.contDiff.contDiffAt.comp x0 hf
    refine ⟨hBf.clm_apply hg, ?_⟩
    have hf' : ContDiffAt ℝ k f x0 := hf.of_le (by exact_mod_cast le_top)
    have hg' : ContDiffAt ℝ k g x0 := hg.of_le (by exact_mod_cast le_top)
    obtain ⟨uf, huf, hfu⟩ := hf'.contDiffOn le_rfl (by simp)
    obtain ⟨ug, hug, hgu⟩ := hg'.contDiffOn le_rfl (by simp)
    obtain ⟨O, hOsub, hOopen, hxO⟩ := mem_nhds_iff.mp (Filter.inter_mem huf hug)
    have hfO : ContDiffOn ℝ k f O := hfu.mono (fun x hx => (hOsub hx).1)
    have hgO : ContDiffOn ℝ k g O := hgu.mono (fun x hx => (hOsub hx).2)
    have hBO : ContDiffOn ℝ k (fun x => Bil (f x) (g x)) O :=
      (Bil.contDiff.comp_contDiffOn hfO).clm_apply hgO
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => x0 + z) ⁻¹' O := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hOopen.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑Λ ⁻¹' s) := hs.preimage Λ.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show x0 + 0 ∈ O; rw [add_zero]; exact hxO
    have hL0s : Λ 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : E) ∈ ⇑Λ ⁻¹' s := hL0s
    have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : E → W),
        ContDiffOn ℝ k F O → ContDiffOn ℝ k (fun z => F (x0 + z)) s := by
      intro W _ _ F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : E → W),
        ContDiffOn ℝ k F O → ContDiffOn ℝ k (fun z => F (x0 + Λ z)) (⇑Λ ⁻¹' s) := by
      intro W _ _ F hF
      exact (hsm F hF).comp Λ.contDiff.contDiffOn (fun z hz => hz)
    have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : E → W),
        ContDiffOn ℝ k F O → ∀ i : ℕ, i ≤ k →
        iteratedFDeriv ℝ i (fun z => F (x0 + Λ z)) 0 =
          (iteratedFDeriv ℝ i F x0).compContinuousLinearMap (fun _ => Λ) := by
      intro W _ _ F hF i hi
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (x0 + Λ z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right Λ (hsm F hF) hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (x0 + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i x0 0
      calc iteratedFDeriv ℝ i (fun z => F (x0 + Λ z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (x0 + z)) ∘ ⇑Λ) (⇑Λ ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (x0 + z)) s (Λ 0)).compContinuousLinearMap
              (fun _ => Λ) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (x0 + z)) s 0).compContinuousLinearMap
              (fun _ => Λ) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (x0 + z)) 0).compContinuousLinearMap
              (fun _ => Λ) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F x0).compContinuousLinearMap (fun _ => Λ) := by rw [e4, add_zero]
    have hl := ContinuousLinearMap.norm_iteratedFDerivWithin_le_of_bilinear Bil (hsmO f hfO)
      (hsmO g hgO) hO.uniqueDiffOn h0O (n := k) le_rfl
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => Bil (f (x0 + Λ y)) (g (x0 + Λ y))) k hO h0O]
      at hl
    unfold sJet5
    rw [← key _ hBO k le_rfl]
    calc ‖iteratedFDeriv ℝ k (fun z => (fun x => Bil (f x) (g x)) (x0 + Λ z)) 0‖
        = ‖iteratedFDeriv ℝ k (fun y => Bil (f (x0 + Λ y)) (g (x0 + Λ y))) 0‖ := rfl
      _ ≤ _ := hl
      _ = _ := by
        congr 1
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (x0 + Λ z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (x0 + Λ z)) (k - i) hO h0O,
          key f hfO i hik, key g hgO (k - i) (Nat.sub_le k i)]

  have hr0 : 0 < G.r0 := hG.1.1
  have hsmT := hG.2.2.2.2.2.2

  have penv : ∀ (γ : Lab) (v : ℝ), 0 ≤ v → Penv5 B G γ v ≤ 1 := by
    intro γ v hv
    have hQb : 0 < Qb γ.1 := by unfold Qb; exact Real.rpow_pos_of_pos (by norm_num) _
    have hep : 0 < epsb B.h γ.1 := by unfold epsb; exact Real.rpow_pos_of_pos hQb _
    have hkb : (0:ℝ) < (kb B.h γ.1 : ℝ) := by
      unfold kb
      exact Nat.cast_pos.mpr (Nat.ceil_pos.mpr (Real.rpow_pos_of_pos hep _))
    have hc : 0 < epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 := mul_pos hep (pow_pos hkb 2)
    have hTgc : (0:ℝ) < Tgc := by unfold Tgc; positivity
    have hcib : 0 < cib B.h γ.1 := by
      unfold cib; exact mul_pos (zpow_pos hTgc _) (Real.rpow_pos_of_pos hQb _)
    have hL : 0 < Lsb B.h G.r0 γ.1 := by unfold Lsb; exact div_pos (by linarith) hcib
    have hlam : 0 ≤ lam0_5 B G γ := by unfold lam0_5; exact Real.sqrt_nonneg _
    have hsg : sgn γ.2.2 ^ 2 = 1 := by unfold sgn; split_ifs <;> norm_num
    have hU1 : (1:ℝ) ≤ 1 + G.ustar ^ 2 := by linarith [sq_nonneg G.ustar]
    have hP : 0 < (1 + G.ustar ^ 2) ^ (3/2:ℝ) := Real.rpow_pos_of_pos (by linarith) _
    have hBs : Bs5 B G γ ^ 2 = lam0_5 B G γ /
        (epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * (1 + G.ustar ^ 2) ^ (3/2:ℝ)) := by
      unfold Bs5
      rw [Real.sq_sqrt (div_nonneg hlam (mul_pos hc hP).le)]
    have key : ∀ (lam c P A : ℝ), 0 ≤ lam → 0 < c → 0 < P → 1 ≤ A →
        (A * Real.sqrt A ≤ P → 0 ≤ lam / Real.sqrt A - c * (lam / (c * P)) * A) ∧
        (P ≤ A * Real.sqrt A → lam / Real.sqrt A - c * (lam / (c * P)) * A ≤ 0) := by
      intro lam c P A hlam hc hP hA
      have hsA : 0 < Real.sqrt A := Real.sqrt_pos.mpr (by linarith)
      have hsq : Real.sqrt A * Real.sqrt A = A := Real.mul_self_sqrt (by linarith)
      have e : c * (lam / (c * P)) * A = lam * A / P := by field_simp
      rw [e]
      constructor
      · intro h
        rw [sub_nonneg, div_le_div_iff₀ hP hsA]
        have := mul_le_mul_of_nonneg_left h hlam
        calc lam * A * Real.sqrt A = lam * (A * Real.sqrt A) := by ring
          _ ≤ lam * P := this
      · intro h
        rw [sub_nonpos, div_le_div_iff₀ hsA hP]
        have := mul_le_mul_of_nonneg_left h hlam
        calc lam * P ≤ lam * (A * Real.sqrt A) := this
