  have hpt : ∀ (w : ℝ → ℝ) (t e : ℝ), (∀ v, 0 ≤ w v) → -2 < e → e < 2 →
      |w t * (2 * rfpE P t e * G t e)| ≤ 4 * (w t * rfpE P t e ^ 2) := by
    intro w t e hw h1 h2
