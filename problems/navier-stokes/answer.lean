    intro Ω S f g hΩ hS hf heq
    refine ⟨hf.1.congr heq, fun k => (hf.2 k).imp fun C hC z hz => ?_⟩
    have hev : g =ᶠ[nhds z] f := Filter.eventuallyEq_of_mem (hΩ.mem_nhds (hS hz)) heq
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    exact hC z hz
  have hcompT : ∀ {Ω S : Set (ℝ × ℝ)} {T : Set ℝ} (g : ℝ → ℝ) (f : ℝ × ℝ → ℝ) (a b : ℝ),
      IsOpen Ω → S ⊆ Ω → IsOpen T → Icc a b ⊆ T → ContDiffOn ℝ ∞ g T → MapsTo f Ω T →
      (∀ z ∈ S, f z ∈ Icc a b) → axgeGood Ω S f → axgeGood Ω S (g ∘ f) := by
    intro Ω S T g f a b hΩ hS hT hab hg hmap hrange hf
    refine ⟨hg.comp hf.1 hmap, fun m => ?_⟩
    have hgb : ∀ i : ℕ, ∃ C : ℝ, ∀ y ∈ Icc a b, ‖iteratedFDerivWithin ℝ i g T y‖ ≤ C := fun i =>
      isCompact_Icc.exists_bound_of_continuousOn
        ((hg.continuousOn_iteratedFDerivWithin (hle i) hT.uniqueDiffOn).mono hab)
    choose Cg hCg using hgb
    choose Df hDf using hf.2
    refine ⟨(m.factorial : ℝ) * (∑ i ∈ Finset.range (m + 1), |Cg i|) *
      (1 + ∑ i ∈ Finset.range (m + 1), |Df i|) ^ m, fun z hz => ?_⟩
    have hzO := hS hz
    rw [← iteratedFDerivWithin_of_isOpen (f := g ∘ f) m hΩ hzO]
    refine norm_iteratedFDerivWithin_comp_le hg hf.1 (hle m) hT.uniqueDiffOn
      hΩ.uniqueDiffOn hmap hzO ?_ ?_
    · intro i hi
      calc ‖iteratedFDerivWithin ℝ i g T (f z)‖ ≤ Cg i := hCg i (f z) (hrange z hz)
        _ ≤ |Cg i| := le_abs_self _
        _ ≤ ∑ j ∈ Finset.range (m + 1), |Cg j| :=
            Finset.single_le_sum (f := fun j => |Cg j|) (fun j _ => abs_nonneg _)
              (Finset.mem_range.mpr (by omega))
    · intro i hi1 him
      rw [iteratedFDerivWithin_of_isOpen i hΩ hzO]
      have hsum : 0 ≤ ∑ j ∈ Finset.range (m + 1), |Df j| :=
        Finset.sum_nonneg (fun j _ => abs_nonneg _)
      have hD1 : 1 ≤ 1 + ∑ j ∈ Finset.range (m + 1), |Df j| := by linarith
      calc ‖iteratedFDeriv ℝ i f z‖ ≤ Df i := hDf i z hz
        _ ≤ |Df i| := le_abs_self _
        _ ≤ ∑ j ∈ Finset.range (m + 1), |Df j| :=
            Finset.single_le_sum (f := fun j => |Df j|) (fun j _ => abs_nonneg _)
