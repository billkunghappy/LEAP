theorem pa5_scalar_compare : ∀ (Q G r Qd Gd : ℝ → ℝ) (w L c c2 δ : ℝ), 0 < δ → 0 ≤ c2 → Continuous r → (∀ v ∈ Set.Icc w L, HasDerivAt Q (Qd v) v) → (∀ v ∈ Set.Icc w L, HasDerivAt G (Gd v) v) → (∀ v ∈ Set.Icc w L, Qd v ≤ (2 * r v + c) * Q v + c2 * G v / δ) → (∀ v ∈ Set.Icc w L, Gd v ≤ (2 * r v + c) * G v) → 0 ≤ Q w → ∀ v ∈ Set.Icc w L, Q v + G v ≤ Real.exp (2 * (∫ y in w..v, r y) + c * (v - w)) * (1 + c2 * (v - w) / δ) * (Q w + G w) :=
by
  intro Q G r Qd Gd w L c c2 δ hδ hc2 hr hQd hGd hQi hGi hQw v hv
  obtain ⟨A, hAeq⟩ : ∃ A : ℝ → ℝ, A = fun u => 2 * (∫ y in w..u, r y) + c * (u - w) := ⟨_, rfl⟩
  have hA : ∀ u, HasDerivAt A (2 * r u + c) u := by
    intro u
    have h1 : HasDerivAt (fun u => ∫ y in w..u, r y) (r u) u :=
      (hr.integral_hasStrictDerivAt w u).hasDerivAt
    have h2 : HasDerivAt (fun u : ℝ => u - w) 1 u := (hasDerivAt_id' u).sub_const w
    rw [hAeq]
    convert (h1.const_mul 2).add (h2.const_mul c) using 1
    ring
  have hAw : A w = 0 := by rw [hAeq]; simp
  have hAv : A v = 2 * (∫ y in w..v, r y) + c * (v - w) := by rw [hAeq]
  have hE : ∀ u, HasDerivAt (fun u => Real.exp (-A u))
      (Real.exp (-A u) * (-(2 * r u + c))) u := fun u => (hA u).neg.exp
  have hwL : w ≤ L := hv.1.trans hv.2
  have hwI : w ∈ Set.Icc w L := ⟨le_rfl, hwL⟩

  have hg : AntitoneOn (fun u => G u * Real.exp (-A u)) (Set.Icc w L) := by
    have hder : ∀ u ∈ Set.Icc w L, HasDerivAt (fun u => G u * Real.exp (-A u))
        (Gd u * Real.exp (-A u) + G u * (Real.exp (-A u) * (-(2 * r u + c)))) u :=
      fun u hu => (hGd u hu).mul (hE u)
    refine antitoneOn_of_hasDerivWithinAt_nonpos
      (f' := fun u => Gd u * Real.exp (-A u) + G u * (Real.exp (-A u) * (-(2 * r u + c))))
      (convex_Icc w L) ?_ ?_ ?_
    · intro u hu; exact (hder u hu).continuousAt.continuousWithinAt
    · intro u hu
      rw [interior_Icc] at hu
      exact (hder u (Set.Ioo_subset_Icc_self hu)).hasDerivWithinAt
    · intro u hu
      rw [interior_Icc] at hu
      have hu' := Set.Ioo_subset_Icc_self hu
      have h1 := hGi u hu'
      have h2 := Real.exp_pos (-A u)
      have e : Gd u * Real.exp (-A u) + G u * (Real.exp (-A u) * (-(2 * r u + c))) =
          Real.exp (-A u) * (Gd u - (2 * r u + c) * G u) := by ring
      show Gd u * Real.exp (-A u) + G u * (Real.exp (-A u) * (-(2 * r u + c))) ≤ 0
      rw [e]
      exact mul_nonpos_of_nonneg_of_nonpos h2.le (by linarith)
  have hgle : ∀ u ∈ Set.Icc w L, G u * Real.exp (-A u) ≤ G w := by
    intro u hu
    have h : G u * Real.exp (-A u) ≤ G w * Real.exp (-A w) := hg hwI hu hu.1
    rw [hAw, neg_zero, Real.exp_zero, mul_one] at h
    exact h

  have ht : 0 ≤ c2 / δ := div_nonneg hc2 hδ.le
  have hh : AntitoneOn (fun u => Q u * Real.exp (-A u) - c2 * G w / δ * (u - w)) (Set.Icc w L) := by
    have hder : ∀ u ∈ Set.Icc w L, HasDerivAt
        (fun u => Q u * Real.exp (-A u) - c2 * G w / δ * (u - w))
        (Qd u * Real.exp (-A u) + Q u * (Real.exp (-A u) * (-(2 * r u + c))) - c2 * G w / δ * 1) u :=
      fun u hu => ((hQd u hu).mul (hE u)).sub (((hasDerivAt_id' u).sub_const w).const_mul (c2 * G w / δ))
    refine antitoneOn_of_hasDerivWithinAt_nonpos
      (f' := fun u => Qd u * Real.exp (-A u) + Q u * (Real.exp (-A u) * (-(2 * r u + c))) - c2 * G w / δ * 1)
      (convex_Icc w L) ?_ ?_ ?_
    · intro u hu; exact (hder u hu).continuousAt.continuousWithinAt
    · intro u hu
      rw [interior_Icc] at hu
      exact (hder u (Set.Ioo_subset_Icc_self hu)).hasDerivWithinAt
    · intro u hu
      rw [interior_Icc] at hu
      have hu' := Set.Ioo_subset_Icc_self hu
      have h1 := hQi u hu'
      have h2 := Real.exp_pos (-A u)
      have h3 : Real.exp (-A u) * (Qd u - (2 * r u + c) * Q u) ≤ Real.exp (-A u) * (c2 * G u / δ) :=
        mul_le_mul_of_nonneg_left (by linarith) h2.le
      have h4 : Real.exp (-A u) * (c2 * G u / δ) = c2 / δ * (G u * Real.exp (-A u)) := by ring
      have h5 : c2 / δ * (G u * Real.exp (-A u)) ≤ c2 / δ * G w :=
        mul_le_mul_of_nonneg_left (hgle u hu') ht
      have e : Qd u * Real.exp (-A u) + Q u * (Real.exp (-A u) * (-(2 * r u + c))) - c2 * G w / δ * 1 =
          Real.exp (-A u) * (Qd u - (2 * r u + c) * Q u) - c2 / δ * G w := by ring
      show Qd u * Real.exp (-A u) + Q u * (Real.exp (-A u) * (-(2 * r u + c))) - c2 * G w / δ * 1 ≤ 0
      rw [e]
      linarith
  have hQ : Q v * Real.exp (-A v) ≤ Q w + c2 * G w / δ * (v - w) := by
    have h : Q v * Real.exp (-A v) - c2 * G w / δ * (v - w) ≤
        Q w * Real.exp (-A w) - c2 * G w / δ * (w - w) := hh hwI hv hv.1
    rw [hAw, neg_zero, Real.exp_zero, mul_one, sub_self, mul_zero, sub_zero] at h
    linarith

  rw [← hAv]
  have hX := Real.exp_pos (A v)
  have hXE : Real.exp (A v) * Real.exp (-A v) = 1 := by
    rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
  have hQv : Q v ≤ Real.exp (A v) * (Q w + c2 * G w / δ * (v - w)) := by
    have h := mul_le_mul_of_nonneg_left hQ hX.le
    have e : Real.exp (A v) * (Q v * Real.exp (-A v)) = Q v := by
      calc Real.exp (A v) * (Q v * Real.exp (-A v)) = Q v * (Real.exp (A v) * Real.exp (-A v)) := by ring
        _ = Q v := by rw [hXE, mul_one]
    linarith
  have hGv : G v ≤ Real.exp (A v) * G w := by
    have h := mul_le_mul_of_nonneg_left (hgle v hv) hX.le
    have e : Real.exp (A v) * (G v * Real.exp (-A v)) = G v := by
      calc Real.exp (A v) * (G v * Real.exp (-A v)) = G v * (Real.exp (A v) * Real.exp (-A v)) := by ring
        _ = G v := by rw [hXE, mul_one]
    linarith
  have hextra : 0 ≤ Real.exp (A v) * (c2 * (v - w) / δ) * Q w :=
    mul_nonneg (mul_nonneg hX.le (div_nonneg (mul_nonneg hc2 (sub_nonneg.2 hv.1)) hδ.le)) hQw
  have e : Real.exp (A v) * (1 + c2 * (v - w) / δ) * (Q w + G w) =
      Real.exp (A v) * (Q w + c2 * G w / δ * (v - w)) + Real.exp (A v) * G w +
        Real.exp (A v) * (c2 * (v - w) / δ) * Q w := by ring
  rw [e]
  linarith

theorem pa5_normal_mode : ∀ M : ℝ, 1 ≤ M → ∃ C : ℝ, 0 < C ∧ ∀ (F0 G0 N1 N2 Bs E lam δ σ : ℝ) (n p x : Fin 3 → ℝ) (K : Matrix (Fin 3) (Fin 3) ℝ), 1 / M ≤ F0 → F0 ≤ M → 0 ≤ G0 → G0 ≤ M → N1 ^ 2 + N2 ^ 2 = 1 → N1 ≤ -1 / M → 1 / M ^ 2 ≤ -(2 * F0 * N1) * (2 * F0 * N1 + G0) → lam = Real.sqrt (-(2 * F0 * N1) * (2 * F0 * N1 + G0)) → 1 / M ≤ Bs → Bs ≤ M → 0 ≤ E → E ≤ M → |σ| ≤ 2 * M → 0 < δ → δ ≤ 1 / (8 * M) → (∀ i : Fin 3, |n i - Bs * ![σ, -N2, N1] i| ≤ δ) → 1 / (4 * M ^ 2) ≤ dotProduct n n ∧ dotProduct n ((-K + (dotProduct n n)⁻¹ • Matrix.vecMulVec n (Matrix.vecMul n K - p)).mulVec x - (E * dotProduct n n) • x) + dotProduct p x = -(E * dotProduct n n) * dotProduct n x ∧ -(2 * (E * dotProduct n n)) ≤ 2 * (lam / Real.sqrt (1 + σ ^ 2) - E * Bs ^ 2 * (1 + σ ^ 2)) + C * δ :=
by
  intro M hM
  have hM0 : 0 < M := by linarith
  refine ⟨18 * M ^ 3, by positivity, ?_⟩
  intro F0 G0 N1 N2 Bs E lam δ σ n p x K hF0a hF0b hG0a hG0b hN hN1 hPS hlam hBsa hBsb hE0 hE1
    hσ hδ0 hδ1 hn
  have h0 : |n 0 - Bs * σ| ≤ δ := by simpa using hn 0
  have h1 : |n 1 + Bs * N2| ≤ δ := by simpa using hn 1
  have h2 : |n 2 - Bs * N1| ≤ δ := by simpa using hn 2
  obtain ⟨a0, b0⟩ := abs_le.mp h0
  obtain ⟨a1, b1⟩ := abs_le.mp h1
  obtain ⟨a2, b2⟩ := abs_le.mp h2
  have hBsM : 1 ≤ Bs * M := by rw [div_le_iff₀ hM0] at hBsa; linarith
  have hδM : δ * M ≤ 1 / 8 := by
    rw [le_div_iff₀ (by positivity)] at hδ1; linarith
  have hBs0 : 0 < Bs := lt_of_lt_of_le (by positivity) hBsa
  have hN1abs : |N1| ≤ 1 := by
    rw [← sq_le_one_iff_abs_le_one]; nlinarith [sq_nonneg N2]
  have hN2abs : |N2| ≤ 1 := by
    rw [← sq_le_one_iff_abs_le_one]; nlinarith [sq_nonneg N1]
  have hν : dotProduct n n = n 0 * n 0 + n 1 * n 1 + n 2 * n 2 := by
    simp [dotProduct, Fin.sum_univ_three]

  have hBN : (Bs * N2) ^ 2 + (Bs * N1) ^ 2 = Bs ^ 2 := by linear_combination Bs ^ 2 * hN
  have q1 : (Bs * N2) ^ 2 / 2 - (n 1 + Bs * N2) ^ 2 ≤ n 1 * n 1 := by
    nlinarith [sq_nonneg (2 * n 1 + Bs * N2)]
  have q2 : (Bs * N1) ^ 2 / 2 - (n 2 - Bs * N1) ^ 2 ≤ n 2 * n 2 := by
    nlinarith [sq_nonneg (2 * n 2 - Bs * N1)]
  have s1 : (n 1 + Bs * N2) ^ 2 ≤ δ ^ 2 := sq_le_sq' a1 b1
  have s2 : (n 2 - Bs * N1) ^ 2 ≤ δ ^ 2 := sq_le_sq' a2 b2
  have hSlow : Bs ^ 2 / 2 - 2 * δ ^ 2 ≤ dotProduct n n := by
    rw [hν]; nlinarith [mul_self_nonneg (n 0)]
  have hc1 : 1 / (4 * M ^ 2) ≤ dotProduct n n := by
    rw [div_le_iff₀ (by positivity)]
    have hδM0 : 0 ≤ δ * M := by positivity
    have k1 : 1 ≤ (Bs * M) * (Bs * M) := by nlinarith
    have k2 : (δ * M) * (δ * M) ≤ 1 / 64 := by nlinarith
    calc (1:ℝ) ≤ (Bs ^ 2 / 2 - 2 * δ ^ 2) * (4 * M ^ 2) := by nlinarith
      _ ≤ dotProduct n n * (4 * M ^ 2) := mul_le_mul_of_nonneg_right hSlow (by positivity)
  have hSpos : 0 < dotProduct n n := lt_of_lt_of_le (by positivity) hc1
  refine ⟨hc1, ?_, ?_⟩
  ·
    have ht : (dotProduct n n)⁻¹ * dotProduct n n = 1 := inv_mul_cancel₀ hSpos.ne'
    generalize hT : (dotProduct n n)⁻¹ = T at ht ⊢
    rw [hν] at ht ⊢
    simp only [dotProduct, Fin.sum_univ_three, Matrix.mulVec, Matrix.vecMul, Matrix.vecMulVec_apply,
      Matrix.add_apply, Matrix.neg_apply, Matrix.smul_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
    linear_combination ((n 0 * K 0 0 + n 1 * K 1 0 + n 2 * K 2 0 - p 0) * x 0
      + (n 0 * K 0 1 + n 1 * K 1 1 + n 2 * K 2 1 - p 1) * x 1
      + (n 0 * K 0 2 + n 1 * K 1 2 + n 2 * K 2 2 - p 2) * x 2) * ht
  ·
    have hid : dotProduct n n = Bs ^ 2 * (1 + σ ^ 2)
        + 2 * Bs * (σ * (n 0 - Bs * σ) - N2 * (n 1 + Bs * N2) + N1 * (n 2 - Bs * N1))
        + ((n 0 - Bs * σ) ^ 2 + (n 1 + Bs * N2) ^ 2 + (n 2 - Bs * N1) ^ 2) := by
      rw [hν]; linear_combination Bs ^ 2 * hN
    have e0 : |σ * (n 0 - Bs * σ)| ≤ 2 * M * δ := by
      rw [abs_mul]; exact mul_le_mul hσ h0 (abs_nonneg _) (by linarith)
    have e1 : |N2 * (n 1 + Bs * N2)| ≤ 1 * δ := by
      rw [abs_mul]; exact mul_le_mul hN2abs h1 (abs_nonneg _) zero_le_one
    have e2 : |N1 * (n 2 - Bs * N1)| ≤ 1 * δ := by
      rw [abs_mul]; exact mul_le_mul hN1abs h2 (abs_nonneg _) zero_le_one
    have f0 := neg_abs_le (σ * (n 0 - Bs * σ))
    have f1 := le_abs_self (N2 * (n 1 + Bs * N2))
    have f2 := neg_abs_le (N1 * (n 2 - Bs * N1))
    have hMδ : 1 * δ ≤ M * δ := mul_le_mul_of_nonneg_right hM hδ0.le
    have hμ : 0 ≤ (σ * (n 0 - Bs * σ) - N2 * (n 1 + Bs * N2) + N1 * (n 2 - Bs * N1))
        + 4 * M * δ := by linarith
    have hD : Bs ^ 2 * (1 + σ ^ 2) - dotProduct n n ≤ 8 * M ^ 2 * δ := by
      have g1 := mul_nonneg hBs0.le hμ
      have g2 : Bs * (8 * M * δ) ≤ M * (8 * M * δ) :=
        mul_le_mul_of_nonneg_right hBsb (by positivity)
      have g3 := sq_nonneg (n 0 - Bs * σ)
      have g4 := sq_nonneg (n 1 + Bs * N2)
      have g5 := sq_nonneg (n 2 - Bs * N1)
      rw [hid]; linarith
    have hED : E * (Bs ^ 2 * (1 + σ ^ 2) - dotProduct n n) ≤ M * (8 * M ^ 2 * δ) := by
      calc E * (Bs ^ 2 * (1 + σ ^ 2) - dotProduct n n) ≤ E * (8 * M ^ 2 * δ) :=
            mul_le_mul_of_nonneg_left hD hE0
        _ ≤ M * (8 * M ^ 2 * δ) := mul_le_mul_of_nonneg_right hE1 (by positivity)
    have hq : 0 ≤ lam / Real.sqrt (1 + σ ^ 2) :=
      div_nonneg (by rw [hlam]; exact Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
    have hM3 : 0 ≤ M ^ 3 * δ := by positivity
    linarith

theorem prop_abstract5 : ∀ M : ℝ, 1 ≤ M → ∃ (δ0 K0 : ℝ), 0 < δ0 ∧ 0 < K0 ∧ ∀ (F0 G0 N1 N2 Bs E lam u sg δ L w : ℝ) (n p : ℝ → (Fin 3 → ℝ)) (K : ℝ → Matrix (Fin 3) (Fin 3) ℝ) (x : ℝ → (Fin 3 → ℝ)), 1 / M ≤ F0 → F0 ≤ M → 0 ≤ G0 → G0 ≤ M → N1 ^ 2 + N2 ^ 2 = 1 → N1 ≤ -1 / M → 1 / M ^ 2 ≤ -(2 * F0 * N1) * (2 * F0 * N1 + G0) → lam = Real.sqrt (-(2 * F0 * N1) * (2 * F0 * N1 + G0)) → 1 / M ≤ Bs → Bs ≤ M → 0 ≤ E → E ≤ M → (sg = 1 ∨ sg = -1) → 0 ≤ u → u ≤ M → 0 < δ → δ ≤ δ0 → 0 < L → u / L ≤ δ → 0 ≤ w → w ≤ L → (∀ v ∈ Set.Icc w L, ∀ i : Fin 3, |n v i - Bs * ![sg * (u / 2 + u * v / L), -N2, N1] i| ≤ δ ∧ |p v i| ≤ M) → (∀ v ∈ Set.Icc w L, ∀ i j : Fin 3, |K v i j - !![0, -2 * F0, 0; 2 * F0 + G0 * N1, 0, 0; G0 * N2, 0, 0] i j| ≤ δ) → (∀ v ∈ Set.Icc w L, ∀ i : Fin 3, HasDerivAt (fun y => n y i) (p v i) v) → (∀ v ∈ Set.Icc w L, HasDerivAt x ((-K v + (dotProduct (n v) (n v))⁻¹ • Matrix.vecMulVec (n v) (Matrix.vecMul (n v) (K v) - p v)).mulVec (x v) - (E * dotProduct (n v) (n v)) • x v) v) → ∀ v ∈ Set.Icc w L, ‖x v‖ ≤ K0 * Real.exp (K0 * δ * (L - w)) * (1 + (L - w) / δ) * (Real.exp (∫ y in (L / 2)..v, (lam / Real.sqrt (1 + (sg * (u / 2 + u * y / L)) ^ 2) - E * Bs ^ 2 * (1 + (sg * (u / 2 + u * y / L)) ^ 2))) / Real.exp (∫ y in (L / 2)..w, (lam / Real.sqrt (1 + (sg * (u / 2 + u * y / L)) ^ 2) - E * Bs ^ 2 * (1 + (sg * (u / 2 + u * y / L)) ^ 2)))) * ‖x w‖ :=
by
  intro M hM
  have hM0 : 0 < M := by linarith
  obtain ⟨C1, hC1, hs1⟩ := pa5_norm_equiv M hM
  obtain ⟨C2, hC2, hs2⟩ := pa5_deriv_ineq M hM
  obtain ⟨C6, hC6, hs6⟩ := pa5_normal_mode M hM
  obtain ⟨c2, hc2⟩ : ∃ c2 : ℝ, c2 = C2 * (1 + C1) := ⟨_, rfl⟩
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = C2 * (1 + C1) + C6 := ⟨_, rfl⟩
  have hc2nn : 0 ≤ c2 := by rw [hc2]; exact mul_nonneg hC2.le (by linarith)
  have hcC6 : C6 ≤ c := by rw [hc, ← hc2]; linarith
  have hc0 : 0 ≤ c := by linarith
  obtain ⟨K0, hK0⟩ : ∃ K0 : ℝ, K0 = C1 * (1 + c2) + c + 1 := ⟨_, rfl⟩
  have hC1c2 : 0 ≤ C1 * (1 + c2) := mul_nonneg hC1.le (by linarith)
  have hK0pos : 0 < K0 := by rw [hK0]; linarith
  have hK0c : c ≤ K0 := by rw [hK0]; linarith
  have hK0C : C1 * (1 + c2) ≤ K0 := by rw [hK0]; linarith
  refine ⟨1 / (8 * M), K0, div_pos one_pos (by linarith), hK0pos, ?_⟩
  intro F0 G0 N1 N2 Bs E lam u sg δ L w n p K x hF1 hF2 hG1 hG2 hN hN1 hPS hlam hB1 hB2 hE1 hE2
    hsg hu1 hu2 hδ hδ0 hL huL hw0 hwL hnp hK hn hx v hv

  have h8M : 1 / (8 * M) ≤ 1 := by rw [div_le_one (by linarith)]; linarith
  have hδ1 : δ ≤ 1 := le_trans hδ0 h8M
  have hsgabs : |sg| = 1 := by rcases hsg with h | h <;> simp [h]
  have hsb : |sg * u / L| ≤ δ := by
    rw [mul_div_assoc, abs_mul, hsgabs, one_mul, abs_of_nonneg (div_nonneg hu1 hL.le)]
    exact huL
  have hσb : ∀ y ∈ Set.Icc w L, |sg * (u / 2 + u * y / L)| ≤ 2 * M := by
    intro y hy
    have hy0 : 0 ≤ y := le_trans hw0 hy.1
    have h1 : 0 ≤ u * y / L := div_nonneg (mul_nonneg hu1 hy0) hL.le
    have h2 : u * y / L ≤ u := by
      rw [div_le_iff₀ hL]; exact mul_le_mul_of_nonneg_left hy.2 hu1
    rw [abs_mul, hsgabs, one_mul, abs_le]
    constructor <;> linarith

  obtain ⟨xd, hxd⟩ : ∃ f : ℝ → (Fin 3 → ℝ), ∀ y, f y = (-K y + (dotProduct (n y) (n y))⁻¹ • Matrix.vecMulVec (n y) (Matrix.vecMul (n y) (K y) - p y)).mulVec (x y) - (E * dotProduct (n y) (n y)) • x y := ⟨_, fun y => rfl⟩
  obtain ⟨Qf, hQf⟩ : ∃ f : ℝ → ℝ, ∀ y, f y = (2 * F0 * N1 + G0) * (x y 0 + sg * (u / 2 + u * y / L) * N2 * x y 1 - sg * (u / 2 + u * y / L) * N1 * x y 2) ^ 2 + (-(2 * F0 * N1)) * (1 + (sg * (u / 2 + u * y / L)) ^ 2) * (N1 * x y 1 + N2 * x y 2) ^ 2 := ⟨_, fun y => rfl⟩
  obtain ⟨Gf, hGf⟩ : ∃ f : ℝ → ℝ, ∀ y, f y = (dotProduct (n y) (x y)) ^ 2 := ⟨_, fun y => rfl⟩
  obtain ⟨rf, hrf⟩ : ∃ f : ℝ → ℝ, ∀ y, f y = lam / Real.sqrt (1 + (sg * (u / 2 + u * y / L)) ^ 2) - E * Bs ^ 2 * (1 + (sg * (u / 2 + u * y / L)) ^ 2) := ⟨_, fun y => rfl⟩
  obtain ⟨Qd, hQd⟩ : ∃ f : ℝ → ℝ, ∀ y, f y = 2 * (2 * F0 * N1 + G0) * (x y 0 + sg * (u / 2 + u * y / L) * N2 * x y 1 - sg * (u / 2 + u * y / L) * N1 * x y 2) * ((xd y 0 + sg * (u / 2 + u * y / L) * N2 * xd y 1 - sg * (u / 2 + u * y / L) * N1 * xd y 2) + sg * u / L * (N2 * x y 1 - N1 * x y 2)) + (-(2 * F0 * N1)) * (2 * (sg * (u / 2 + u * y / L)) * (sg * u / L)) * (N1 * x y 1 + N2 * x y 2) ^ 2 + 2 * (-(2 * F0 * N1)) * (1 + (sg * (u / 2 + u * y / L)) ^ 2) * (N1 * x y 1 + N2 * x y 2) * (N1 * xd y 1 + N2 * xd y 2) := ⟨_, fun y => rfl⟩
  obtain ⟨Gd, hGd⟩ : ∃ f : ℝ → ℝ, ∀ y, f y = 2 * dotProduct (n y) (x y) * (dotProduct (p y) (x y) + dotProduct (n y) (xd y)) := ⟨_, fun y => rfl⟩

  have hQder : ∀ y ∈ Set.Icc w L, HasDerivAt Qf (Qd y) y := by
    intro y hy
    have hxy : HasDerivAt x (xd y) y := by rw [hxd y]; exact hx y hy
    have hxi : ∀ i, HasDerivAt (fun z => x z i) (xd y i) y := fun i => hasDerivAt_pi.mp hxy i
    have hσ : HasDerivAt (fun z : ℝ => sg * (u / 2 + u * z / L)) (sg * u / L) y := by
      have h := ((((hasDerivAt_id' y).const_mul u).div_const L).const_add (u / 2)).const_mul sg
      convert h using 1; ring
    have ha := ((hxi 0).add ((hσ.mul_const N2).mul (hxi 1))).sub ((hσ.mul_const N1).mul (hxi 2))
    have hb := ((hxi 1).const_mul N1).add ((hxi 2).const_mul N2)
    have hr := (hσ.pow 2).const_add 1
    have hQ := ((ha.pow 2).const_mul (2 * F0 * N1 + G0)).add
      ((hr.const_mul (-(2 * F0 * N1))).mul (hb.pow 2))
    have hfun : Qf = fun z => (2 * F0 * N1 + G0) * (x z 0 + sg * (u / 2 + u * z / L) * N2 * x z 1 - sg * (u / 2 + u * z / L) * N1 * x z 2) ^ 2 + (-(2 * F0 * N1)) * (1 + (sg * (u / 2 + u * z / L)) ^ 2) * (N1 * x z 1 + N2 * x z 2) ^ 2 := funext hQf
    rw [hfun, hQd y]
    convert hQ using 1
    norm_num
    ring
  have hGder : ∀ y ∈ Set.Icc w L, HasDerivAt Gf (Gd y) y := by
    intro y hy
    have hxy : HasDerivAt x (xd y) y := by rw [hxd y]; exact hx y hy
    have hxi : ∀ i, HasDerivAt (fun z => x z i) (xd y i) y := fun i => hasDerivAt_pi.mp hxy i
    have hni := hn y hy
    have hg := (((hni 0).mul (hxi 0)).add ((hni 1).mul (hxi 1))).add ((hni 2).mul (hxi 2))
    have hG := hg.pow 2
    have hfun : Gf = fun z => (n z 0 * x z 0 + n z 1 * x z 1 + n z 2 * x z 2) ^ 2 := by
      funext z; rw [hGf z]; simp [dotProduct, Fin.sum_univ_three]
    rw [hfun, hGd y]
    convert hG using 1
    have e : (2:ℕ) - 1 = 1 := rfl
    all_goals try simp only [dotProduct, Fin.sum_univ_three, Pi.add_apply, Pi.mul_apply, e, pow_one, Nat.cast_ofNat]
    all_goals ring

  have hQineq : ∀ y ∈ Set.Icc w L, Qd y ≤ (2 * rf y + c * δ) * Qf y + c2 * Gf y / δ := by
    intro y hy
    obtain ⟨hQnn, -, hXle, -⟩ := hs1 F0 G0 N1 N2 Bs δ (sg * (u / 2 + u * y / L)) (n y) (x y) hF1 hF2
      hG1 hG2 hN hN1 hPS hB1 hB2 (hσb y hy) hδ hδ0 (fun i => (hnp y hy i).1)
    have h2 := hs2 F0 G0 N1 N2 Bs E lam δ (sg * (u / 2 + u * y / L)) (sg * u / L) (n y) (p y) (x y)
      (K y) hF1 hF2 hG1 hG2 hN hN1 hPS hlam hB1 hB2 hE1 hE2 (hσb y hy) hsb hδ hδ0
      (fun i => (hnp y hy i).1) (fun i => (hnp y hy i).2) (hK y hy) (xd y) (hxd y)
    rw [← hQd y] at h2
    rw [← hQf y] at hQnn hXle h2
    rw [← hGf y] at hXle h2
    rw [← hrf y] at h2
    have hGnn : 0 ≤ Gf y := by rw [hGf y]; positivity
    have hGd' : δ * Gf y ≤ Gf y / δ := by
      rw [le_div_iff₀ hδ]
      have h3 : δ * δ ≤ 1 := by nlinarith
      nlinarith [mul_le_mul_of_nonneg_right h3 hGnn]
    have hXC : C2 * (δ * dotProduct (x y) (x y)) ≤ C2 * (δ * (C1 * (Qf y + Gf y))) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hXle hδ.le) hC2.le
    have hGC : C2 * C1 * (δ * Gf y) ≤ C2 * C1 * (Gf y / δ) :=
      mul_le_mul_of_nonneg_left hGd' (mul_nonneg hC2.le hC1.le)
    have h6 : 0 ≤ C6 * δ * Qf y := mul_nonneg (mul_nonneg hC6.le hδ.le) hQnn
    rw [mul_div_assoc]
    generalize Gf y / δ = gd at *
    subst hc hc2
    linarith
  have hGineq : ∀ y ∈ Set.Icc w L, Gd y ≤ (2 * rf y + c * δ) * Gf y := by
    intro y hy
    obtain ⟨-, hid, hrate⟩ := hs6 F0 G0 N1 N2 Bs E lam δ (sg * (u / 2 + u * y / L)) (n y) (p y) (x y)
      (K y) hF1 hF2 hG1 hG2 hN hN1 hPS hlam hB1 hB2 hE1 hE2 (hσb y hy) hδ hδ0
      (fun i => (hnp y hy i).1)
    rw [← hxd y] at hid
    rw [← hrf y] at hrate
    have hGnn : 0 ≤ Gf y := by rw [hGf y]; positivity
    have heq : Gd y = -(2 * (E * dotProduct (n y) (n y))) * Gf y := by
      rw [hGd y, hGf y, add_comm (dotProduct (p y) (x y)), hid]; ring
    rw [heq]
    have hle : -(2 * (E * dotProduct (n y) (n y))) ≤ 2 * rf y + c * δ := by
      have : C6 * δ ≤ c * δ := mul_le_mul_of_nonneg_right hcC6 hδ.le
      linarith
    exact mul_le_mul_of_nonneg_right hle hGnn

  have hrfun : rf = fun z => lam / Real.sqrt (1 + (sg * (u / 2 + u * z / L)) ^ 2) - E * Bs ^ 2 * (1 + (sg * (u / 2 + u * z / L)) ^ 2) := funext hrf
  have hrcont : Continuous rf := by
    rw [hrfun]
    have hc1 : Continuous (fun z : ℝ => 1 + (sg * (u / 2 + u * z / L)) ^ 2) := by fun_prop
    refine Continuous.sub (Continuous.div continuous_const hc1.sqrt ?_) (by fun_prop)
    intro z
    exact (Real.sqrt_pos.mpr (by positivity)).ne'

  have hwmem : w ∈ Set.Icc w L := ⟨le_rfl, hwL⟩
  obtain ⟨hQw, -, -, hQGw⟩ := hs1 F0 G0 N1 N2 Bs δ (sg * (u / 2 + u * w / L)) (n w) (x w) hF1 hF2
    hG1 hG2 hN hN1 hPS hB1 hB2 (hσb w hwmem) hδ hδ0 (fun i => (hnp w hwmem i).1)
  rw [← hQf w] at hQw hQGw
  rw [← hGf w] at hQGw
  obtain ⟨-, hnv, hXv, -⟩ := hs1 F0 G0 N1 N2 Bs δ (sg * (u / 2 + u * v / L)) (n v) (x v) hF1 hF2
    hG1 hG2 hN hN1 hPS hB1 hB2 (hσb v hv) hδ hδ0 (fun i => (hnp v hv i).1)
  rw [← hQf v] at hXv
  rw [← hGf v] at hXv

  have hcmp := pa5_scalar_compare Qf Gf rf Qd Gd w L (c * δ) c2 δ hδ hc2nn hrcont hQder hGder
    hQineq hGineq hQw v hv

  have hint : (∫ y in (L / 2)..v, rf y) - (∫ y in (L / 2)..w, rf y) = ∫ y in w..v, rf y :=
    intervalIntegral.integral_interval_sub_left (hrcont.intervalIntegrable _ _)
      (hrcont.intervalIntegrable _ _)
  obtain ⟨I, hI⟩ : ∃ I : ℝ, I = ∫ y in w..v, rf y := ⟨_, rfl⟩
  rw [← hI] at hcmp hint
  have hratio : Real.exp (∫ y in (L / 2)..v, rf y) / Real.exp (∫ y in (L / 2)..w, rf y) =
      Real.exp I := by
    rw [← Real.exp_sub, hint]
  have hI1 : ∀ z, (∫ y in (L / 2)..z, (lam / Real.sqrt (1 + (sg * (u / 2 + u * y / L)) ^ 2) - E * Bs ^ 2 * (1 + (sg * (u / 2 + u * y / L)) ^ 2))) = ∫ y in (L / 2)..z, rf y := by
    intro z; simp only [hrf]
  rw [hI1 v, hI1 w, hratio]

  have hvw : 0 ≤ v - w := by linarith [hv.1]
  have hT : v - w ≤ L - w := by linarith [hv.2]
  have hq0 : 0 ≤ (L - w) / δ := div_nonneg (by linarith) hδ.le
  have hKT : 0 ≤ K0 * δ * (L - w) := mul_nonneg (mul_nonneg hK0pos.le hδ.le) (by linarith)
