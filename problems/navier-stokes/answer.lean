theorem dvdir_lnorm_frame_v5 : ∀ (h : ℝ) (l : ℕ) (ξ : Cyl), 1 ≤ l → coarseIdx h (qC h ξ) ≤ bandIdx h l → ∃ eh : Cyl, Lnorm h ξ eh = dVdir h l ∧ ‖eh‖ ≤ 1 ∧ ∀ (p : Cyl) (t : ℝ), qC h (p + t • dVdir h l) = qC h p ∧ XC h (p + t • dVdir h l) = XC h p ∧ SC h (p + t • dVdir h l) = SC h p ∧ Lnorm h (p + t • dVdir h l) = Lnorm h p :=
by
  intro h l ξ hl hcb
  have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
  have hs2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hs1 : 1 ≤ Real.sqrt 2 := by nlinarith
  have hs2' : Real.sqrt 2 ≤ 2 := by nlinarith
  have hT1 : (1:ℝ) ≤ Tgc := by unfold Tgc; linarith
  have hT0 : (0:ℝ) < Tgc := by linarith
  have hTne : Tgc ≠ 0 := hT0.ne'
  have hb0 : 0 ≤ bgc := by unfold bgc; linarith
  have hb1 : bgc ≤ 1 := by unfold bgc; linarith
  have hN : (1 + bgc ^ 2) ≠ 0 := by positivity
  have hl1 : (1:ℝ) ≤ (l:ℝ) := Nat.one_le_cast.mpr hl
  have hT1' : (1:ℝ) < Tgc := by unfold Tgc; linarith
  have hQ : 0 < Qb l ^ (1 + h) := Real.rpow_pos_of_pos (by unfold Qb; positivity) _
  have hcpos : 0 < cib h l := by unfold cib; exact mul_pos (zpow_pos hT0 _) hQ
  have hy : 0 < (2:ℝ) ^ ((1 + h) * (l:ℝ)) / (l:ℝ) ^ 2 := by positivity
  have hTz : Tgc ^ (bandIdx h l) ≤ (2:ℝ) ^ ((1 + h) * (l:ℝ)) / (l:ℝ) ^ 2 := by
    rw [← Real.rpow_intCast]
    calc Tgc ^ ((bandIdx h l : ℤ) : ℝ)
        ≤ Tgc ^ (Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / (l:ℝ) ^ 2)) :=
          Real.rpow_le_rpow_of_exponent_le hT1 (by unfold bandIdx; exact Int.floor_le _)
      _ = _ := Real.rpow_logb hT0 hT1'.ne' hy
  have hQe : Qb l ^ (1 + h) = (2:ℝ) ^ (-((1 + h) * (l:ℝ))) := by
    unfold Qb
    rw [← Real.rpow_mul (by norm_num)]
    congr 1
    ring
  have hcle : cib h l ≤ 1 := by
    show Tgc ^ (bandIdx h l) * Qb l ^ (1 + h) ≤ 1
    calc Tgc ^ (bandIdx h l) * Qb l ^ (1 + h)
        ≤ ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / (l:ℝ) ^ 2) * Qb l ^ (1 + h) :=
          mul_le_mul_of_nonneg_right hTz hQ.le
      _ = 1 / (l:ℝ) ^ 2 := by
          rw [hQe, div_mul_eq_mul_div, ← Real.rpow_add (by norm_num)]
          simp
      _ ≤ 1 := by
          rw [div_le_one (by positivity)]
          nlinarith
  have hzle : Tgc ^ (coarseIdx h (qC h ξ) - bandIdx h l) ≤ 1 :=
    zpow_le_one_of_nonpos₀ hT1 (by omega)
  have hzpos : 0 < Tgc ^ (coarseIdx h (qC h ξ) - bandIdx h l) := zpow_pos hT0 _
  have hκ0 : 0 < cib h l * Tgc ^ (coarseIdx h (qC h ξ) - bandIdx h l) := mul_pos hcpos hzpos
  have hκ1 : cib h l * Tgc ^ (coarseIdx h (qC h ξ) - bandIdx h l) ≤ 1 := by
    calc cib h l * Tgc ^ (coarseIdx h (qC h ξ) - bandIdx h l) ≤ 1 * 1 :=
