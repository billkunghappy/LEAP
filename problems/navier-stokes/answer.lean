    have h4 : B * m ≤ B * t1 := mul_le_mul_of_nonneg_left hmt hB
    have h5 : 0 ≤ κ0 * B * m := by positivity
    nlinarith

  have hsig : ∀ u : ℝ, 0 ≤ sigA u ∧ sigA u ≤ 1 := by
