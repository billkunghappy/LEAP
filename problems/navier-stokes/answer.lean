    · exact hlinb 0
    · exact hlinb 1
    · exact hsqb 2
    · exact hsqb 3
    · exact hsqb 4
  have hzmem : ∀ d η, ‖d‖ < δ → -2 < η → η < 2 → zf d η ∈ Metric.ball (0 : Fin 5 → ℝ) r := by
    intro d η hd h1 h2
    rw [mem_ball_zero_iff]
    have hδ1' := (le_div_iff₀ hK0).1 hδ1
    calc ‖zf d η‖ ≤ K * ‖d‖ := hzb d η h1 h2
