  rw [← hΛdef, (hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_const_smul_apply hcdk,
    key aa L _ k hz0O]
  have heq : (Penv5 B G γ 0 • (iteratedFDeriv ℝ k Φ (aa + L (ξ.1, ξ.2.1, ξ.2.2.1))).compContinuousLinearMap
      (fun _ => L)).compContinuousLinearMap (fun _ => Λ) =
      Penv5 B G γ 0 • (iteratedFDeriv ℝ k Φ (aa + L (ξ.1, ξ.2.1, ξ.2.2.1))).compContinuousLinearMap
        (fun _ => L.comp Λ) := by
    ext v; rfl
  have hP0 : 0 < Penv5 B G γ 0 := by unfold Penv5; exact Real.exp_pos _
  rw [heq, norm_smul, Real.norm_eq_abs, abs_of_pos hP0, Real.rpow_zero, mul_one]

  have hsc : ξ.1⁻¹ * Real.sqrt (qC B.h ξ) ≤ A0 := by
    have hs2 : 0 < Real.sqrt (2 * B.Xa) := Real.sqrt_pos.mpr (by linarith)
    have h1 : Real.sqrt (qC B.h ξ) * Real.sqrt (2 * B.Xa) ≤ ξ.1 := by
      rw [← Real.sqrt_mul hq0.le]
      calc Real.sqrt (qC B.h ξ * (2 * B.Xa)) ≤ Real.sqrt (ξ.1 ^ 2) :=
            Real.sqrt_le_sqrt (by linarith)
        _ = ξ.1 := Real.sqrt_sq hx0.le
    rw [hA0def, inv_mul_eq_div, ← one_div, div_le_div_iff₀ hx0 hs2]
    linarith
  have hLΛ : ‖L.comp Λ‖ ≤ A0 := by
    refine ContinuousLinearMap.opNorm_le_bound _ hA0 (fun v => ?_)
    have e : (L.comp Λ) v = (ξ.1⁻¹ * (Real.sqrt (qC B.h ξ) * v.1), (0 : ℝ × ℝ × ℝ × ℝ)) := by
      rw [hLdef, hΛdef]; rfl
    rw [e, Prod.norm_def, norm_zero, max_eq_left (norm_nonneg _), Real.norm_eq_abs, abs_mul, abs_mul,
      abs_of_pos (inv_pos.mpr hx0), abs_of_nonneg (Real.sqrt_nonneg _)]
    have hv : |v.1| ≤ ‖v‖ := by rw [← Real.norm_eq_abs]; exact norm_fst_le v
    calc ξ.1⁻¹ * (Real.sqrt (qC B.h ξ) * |v.1|) = (ξ.1⁻¹ * Real.sqrt (qC B.h ξ)) * |v.1| := by ring
      _ ≤ A0 * ‖v‖ := mul_le_mul hsc hv (abs_nonneg _) hA0
  have hDb : ‖iteratedFDeriv ℝ k Φ (aa + L (ξ.1, ξ.2.1, ξ.2.2.1))‖ ≤ |Mk| := by
    rw [hz0, ← iteratedFDerivWithin_of_isOpen (f := Φ) k hOo (hKO hz0K)]
    exact (hMk _ hz0K).trans (le_abs_self _)
  have hb2 : ‖(iteratedFDeriv ℝ k Φ (aa + L (ξ.1, ξ.2.1, ξ.2.2.1))).compContinuousLinearMap
      (fun _ => L.comp Λ)‖ ≤ |Mk| * A0 ^ k := by
    calc _ ≤ ‖iteratedFDeriv ℝ k Φ (aa + L (ξ.1, ξ.2.1, ξ.2.2.1))‖ * ∏ _i : Fin k, ‖L.comp Λ‖ :=
          ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
      _ = ‖iteratedFDeriv ℝ k Φ (aa + L (ξ.1, ξ.2.1, ξ.2.2.1))‖ * ‖L.comp Λ‖ ^ k := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      _ ≤ |Mk| * A0 ^ k :=
          mul_le_mul hDb (pow_le_pow_left₀ (norm_nonneg _) hLΛ k) (by positivity) (abs_nonneg _)
  calc Penv5 B G γ 0 * ‖(iteratedFDeriv ℝ k Φ (aa + L (ξ.1, ξ.2.1, ξ.2.2.1))).compContinuousLinearMap
        (fun _ => L.comp Λ)‖ ≤ Penv5 B G γ 0 * (|Mk| * A0 ^ k) :=
        mul_le_mul_of_nonneg_left hb2 hP0.le
    _ = |Mk| * A0 ^ k * Penv5 B G γ 0 := by ring

theorem tH_jet_envelope_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (lP : ℕ) (CP bP : ℝ), (∀ (γ : Lab) (ξ : Cyl), lP ≤ γ.1 → ActiveL4 B G γ → etaL B.h γ ξ ≠ 0 → ξ ∈ DomC B.h B.qB → B.Xa ≤ XC B.h ξ → XC B.h ξ ≤ B.Xb → inRect B.h γ (G.ctr γ) G.r0 ξ.2.2.2 → ∀ (x : ℝ → (Fin 3 → ℝ)) (w : ℝ), 0 ≤ w → w ≤ Lsb B.h G.r0 γ.1 → (∀ v ∈ Set.Icc w (Lsb B.h G.r0 γ.1), HasDerivAt x ((APhi5 B G γ (ξ + (v - vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) • dVdir B.h γ.1)).mulVec (x v) - dDamp5 B G γ (ξ + (v - vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) • dVdir B.h γ.1) • x v) v) → ∀ v ∈ Set.Icc w (Lsb B.h G.r0 γ.1), ‖x v‖ ≤ CP * (γ.1 : ℝ) ^ bP * (Penv5 B G γ v / Penv5 B G γ w) * ‖x w‖) → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (ξ : Cyl) (v : ℝ), l1 ≤ γ.1 → ActiveL4 B G γ → etaL B.h γ ξ ≠ 0 → ξ ∈ DomC B.h B.qB → B.Xa ≤ XC B.h ξ → XC B.h ξ ≤ B.Xb → inRect B.h γ (G.ctr γ) G.r0 ξ.2.2.2 → 0 ≤ v → v ≤ Lsb B.h G.r0 γ.1 → ‖(iteratedFDeriv ℝ k (fun w : (ℝ × ℝ × ℝ) × ℝ => G.tH γ w.1 w.2) ((ξ.1, ξ.2.1, ξ.2.2.1), v)).compContinuousLinearMap (fun _ => ((Real.sqrt (qC B.h ξ) • ContinuousLinearMap.id ℝ ℝ).prodMap ((qC B.h ξ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ))).prodMap (ContinuousLinearMap.id ℝ ℝ))‖ ≤ C * SC B.h ξ ^ b * Penv5 B G γ v :=
by
  intro B G hB hG lP CP bP hP
  have hr0 : 0 < G.r0 := hG.1.1
  have hr0' : G.r0 ≤ 1/100 := hG.1.2.1
  obtain ⟨hΩ, hbase⟩ := geom_slow_base_smooth_v5 B hB
  have hgc := fun γ : Lab => geom_pulse_coeff_v5 B G γ hB hr0 hr0' hΩ hbase
  choose M z0 hMs hz0 hMid using hgc
  obtain ⟨l9, h9⟩ := tHjet_coef_bound_v5 B G hB hG M hMs (fun γ ξ hξ hR z => (hMid γ ξ hξ hR).1 z)
  obtain ⟨l10, h10⟩ := tHjet_init_bound_v5 B G hB hG
  choose C9 b9 h9c using h9
  choose C10 b10 h10c using h10
  refine ⟨lP + l9 + l10 + 1, fun k => ?_⟩
  obtain ⟨Cc, hCc⟩ : ∃ x : ℝ, x = ∑ j ∈ Finset.range (k + 1), |C9 j| := ⟨_, rfl⟩
  obtain ⟨βc, hβc⟩ : ∃ x : ℝ, x = ∑ j ∈ Finset.range (k + 1), |b9 j| := ⟨_, rfl⟩
  obtain ⟨Ci, hCi⟩ : ∃ x : ℝ, x = ∑ j ∈ Finset.range (k + 1), |C10 j| := ⟨_, rfl⟩
  obtain ⟨βi, hβi⟩ : ∃ x : ℝ, x = ∑ j ∈ Finset.range (k + 1), |b10 j| := ⟨_, rfl⟩
  have hCc0 : 0 ≤ Cc := by rw [hCc]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have hβc0 : 0 ≤ βc := by rw [hβc]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have hCi0 : 0 ≤ Ci := by rw [hCi]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have hβi0 : 0 ≤ βi := by rw [hβi]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have hCcj : ∀ j, j ≤ k → |C9 j| ≤ Cc := fun j hj => by
    rw [hCc]
    exact Finset.single_le_sum (f := fun i => |C9 i|) (fun i _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  have hβcj : ∀ j, j ≤ k → |b9 j| ≤ βc := fun j hj => by
    rw [hβc]
    exact Finset.single_le_sum (f := fun i => |b9 i|) (fun i _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  have hCij : ∀ j, j ≤ k → |C10 j| ≤ Ci := fun j hj => by
    rw [hCi]
    exact Finset.single_le_sum (f := fun i => |C10 i|) (fun i _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  have hβij : ∀ j, j ≤ k → |b10 j| ≤ βi := fun j hj => by
    rw [hβi]
    exact Finset.single_le_sum (f := fun i => |b10 i|) (fun i _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  obtain ⟨cK, hcK⟩ : ∃ x : ℝ, x = 1 + |CP| * (2:ℝ) ^ |bP| := ⟨_, rfl⟩
  have hcK1 : 1 ≤ cK := by
    rw [hcK]
    have : 0 ≤ |CP| * (2:ℝ) ^ |bP| := by positivity
    linarith
  obtain ⟨D, hDdef⟩ : ∃ x : ℝ, x = cK + 2 + (1 + Cc) + (1 + Ci) := ⟨_, rfl⟩
  obtain ⟨bw, hbw⟩ : ∃ x : ℝ, x = |bP| + 1 + βc + βi := ⟨_, rfl⟩
  refine ⟨(4 ^ k * 3 * D) ^ k * (D * D * (3 * 2 ^ k * D * D * D) ^ k),
    bw * ((4 * k + 2 : ℕ) : ℝ), ?_⟩
  intro γ ξ v hl hA heta hD hX1 hX2 hR hv0 hvL

  have hℓ1 : (1:ℝ) ≤ (γ.1 : ℝ) := by exact_mod_cast (show 1 ≤ γ.1 by omega)
  have hS1 : 1 ≤ SC B.h ξ := by
    unfold SC
    nlinarith [abs_nonneg (Real.log (qC B.h ξ))]
  obtain ⟨S, hSdef⟩ : ∃ x : ℝ, x = SC B.h ξ := ⟨_, rfl⟩
  rw [← hSdef] at hS1 ⊢
  have hS0 : 0 ≤ S := by linarith
  obtain ⟨T, hTdef⟩ : ∃ x : ℝ, x = S ^ bw := ⟨_, rfl⟩
  have hbw1 : 1 ≤ bw := by
    rw [hbw]
    have := abs_nonneg bP
    linarith
  have hT1 : 1 ≤ T := by rw [hTdef]; exact Real.one_le_rpow hS1 (by linarith)
  have hST : ∀ a : ℝ, a ≤ bw → S ^ a ≤ T := fun a ha => by
    rw [hTdef]; exact Real.rpow_le_rpow_of_exponent_le hS1 ha
  have hSleT : S ≤ T := by
    have := hST 1 hbw1
    rwa [Real.rpow_one] at this
  have hgen : ∀ c e c' e' : ℝ, |c| ≤ c' → |e| ≤ e' → c * S ^ e ≤ c' * S ^ e' := by
    intro c e c' e' hc he
    have h1 : S ^ e ≤ S ^ e' := Real.rpow_le_rpow_of_exponent_le hS1 (le_trans (le_abs_self e) he)
    have h2 : 0 ≤ S ^ e := Real.rpow_nonneg hS0 e
    calc c * S ^ e ≤ |c| * S ^ e := mul_le_mul_of_nonneg_right (le_abs_self c) h2
      _ ≤ c' * S ^ e' := mul_le_mul hc h1 h2 (le_trans (abs_nonneg c) hc)

  obtain ⟨hcib_lb, hℓS⟩ := tHjet_band_scales_v5 B hB γ ξ (by omega) hD heta
  rw [← hSdef] at hℓS
  have hTg0 : (0:ℝ) < Tgc := by unfold Tgc; positivity
  have hTg6 : Tgc ≤ 6 := by
    unfold Tgc
    nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
  have hci : 0 < cib B.h γ.1 := by
    unfold cib
    have hQ : (0:ℝ) < Qb γ.1 := by unfold Qb; positivity
    exact mul_pos (zpow_pos hTg0 _) (Real.rpow_pos_of_pos hQ _)
  have hℓ4S : (γ.1 : ℝ) ^ 2 ≤ 4 * S := by
    nlinarith [Real.sq_sqrt hS0, Real.sqrt_nonneg S,
      mul_le_mul hℓS hℓS (by linarith) (by positivity)]
  have hsqS : Real.sqrt S ≤ S := by
    nlinarith [Real.sq_sqrt hS0, Real.sqrt_nonneg S, Real.one_le_sqrt.mpr hS1]
  have hℓ2S : (γ.1 : ℝ) ≤ 2 * S := by linarith
  set L := Lsb B.h G.r0 γ.1 with hLdef
  have hL : 0 < L := by
    show 0 < 2 * G.r0 / cib B.h γ.1
    exact div_pos (by linarith) hci
  have hLS : L ≤ S := by
    have hpos : 0 < 1 / (Tgc * (γ.1 : ℝ) ^ 2) :=
      div_pos one_pos (mul_pos hTg0 (pow_pos (by linarith) 2))
    have h1 : 2 * G.r0 / cib B.h γ.1 ≤ 2 * G.r0 / (1 / (Tgc * (γ.1 : ℝ) ^ 2)) :=
      div_le_div_of_nonneg_left (by linarith) hpos hcib_lb
    rw [div_div_eq_mul_div, div_one] at h1
    have h2 : Tgc * (γ.1 : ℝ) ^ 2 ≤ 6 * (4 * S) := mul_le_mul hTg6 hℓ4S (sq_nonneg _) (by norm_num)
    have h3 : 2 * G.r0 * (Tgc * (γ.1 : ℝ) ^ 2) ≤ 2 * (1/100) * (6 * (4 * S)) :=
      mul_le_mul (by linarith) h2 (mul_pos hTg0 (pow_pos (by linarith) 2)).le (by norm_num)
    show 2 * G.r0 / cib B.h γ.1 ≤ S
    linarith

  obtain ⟨K, hKdef⟩ : ∃ x : ℝ, x = |CP| * (γ.1 : ℝ) ^ bP := ⟨_, rfl⟩
  have hK0 : 0 ≤ K := by rw [hKdef]; positivity
  have hKle : 1 + K ≤ cK * T := by
    have e1 : (γ.1 : ℝ) ^ bP ≤ (γ.1 : ℝ) ^ |bP| :=
      Real.rpow_le_rpow_of_exponent_le hℓ1 (le_abs_self bP)
    have e2 : (γ.1 : ℝ) ^ |bP| ≤ (2 * S) ^ |bP| := Real.rpow_le_rpow (by linarith) hℓ2S (abs_nonneg bP)
    have e3 : (2 * S) ^ |bP| = (2:ℝ) ^ |bP| * S ^ |bP| := Real.mul_rpow (by norm_num) hS0
    have e4 : S ^ |bP| ≤ T := hST _ (by rw [hbw]; linarith)
    have e5 : (γ.1 : ℝ) ^ bP ≤ (2:ℝ) ^ |bP| * T := by
      calc (γ.1 : ℝ) ^ bP ≤ (2:ℝ) ^ |bP| * S ^ |bP| := by rw [← e3]; linarith
        _ ≤ (2:ℝ) ^ |bP| * T := mul_le_mul_of_nonneg_left e4 (by positivity)
    have e6 : K ≤ |CP| * ((2:ℝ) ^ |bP| * T) := by
      rw [hKdef]; exact mul_le_mul_of_nonneg_left e5 (abs_nonneg _)
    rw [hcK]
    have e7 : (1 + |CP| * (2:ℝ) ^ |bP|) * T = T + |CP| * ((2:ℝ) ^ |bP| * T) := by ring
    linarith
  obtain ⟨Q, hQdef⟩ : ∃ x : ℝ, x = Cc * S ^ βc := ⟨_, rfl⟩
  obtain ⟨I, hIdef⟩ : ∃ x : ℝ, x = Ci * S ^ βi := ⟨_, rfl⟩
  have hQ0 : 0 ≤ Q := by rw [hQdef]; exact mul_nonneg hCc0 (Real.rpow_nonneg hS0 _)
  have hI0 : 0 ≤ I := by rw [hIdef]; exact mul_nonneg hCi0 (Real.rpow_nonneg hS0 _)
  have hQle : 1 + Q ≤ (1 + Cc) * T := by
    have h1 : S ^ βc ≤ T := hST _ (by rw [hbw]; linarith [abs_nonneg bP])
    have h2 : Q ≤ Cc * T := by rw [hQdef]; exact mul_le_mul_of_nonneg_left h1 hCc0
    have e : (1 + Cc) * T = T + Cc * T := by ring
    linarith
  have hIle : 1 + I ≤ (1 + Ci) * T := by
    have h1 : S ^ βi ≤ T := hST _ (by rw [hbw]; linarith [abs_nonneg bP])
    have h2 : I ≤ Ci * T := by rw [hIdef]; exact mul_le_mul_of_nonneg_left h1 hCi0
    have e : (1 + Ci) * T = T + Ci * T := by ring
    linarith
  have hT0 : 0 ≤ T := by linarith
  have hZK : 1 + K ≤ D * T :=
    le_trans hKle (mul_le_mul_of_nonneg_right (by rw [hDdef]; linarith) hT0)
  have hZQ : 1 + Q ≤ D * T :=
    le_trans hQle (mul_le_mul_of_nonneg_right (by rw [hDdef]; linarith) hT0)
  have hZI : 1 + I ≤ D * T :=
    le_trans hIle (mul_le_mul_of_nonneg_right (by rw [hDdef]; linarith) hT0)
  have hZL : 1 + L ≤ D * T := by
    have h1 : 1 + L ≤ 2 * T := by linarith
    exact le_trans h1 (mul_le_mul_of_nonneg_right (by rw [hDdef]; linarith) hT0)

  have hPpos : ∀ w, 0 < Penv5 B G γ w := fun w => by unfold Penv5; exact Real.exp_pos _
  obtain ⟨U, hUo, hs0U, hUprop⟩ := tHjet_eta_open_v5 B hB γ ξ hD heta
  have hUΩ : ∀ s ∈ U, s ∈ {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} :=
    fun s hs => (hUprop s hs (0, 0)).1
  have hf : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => G.tH γ w.1 w.2) (U ×ˢ Set.univ) :=
    (hG.2.2.2.2.2.2 γ).mono (fun w hw => hUΩ w.1 hw.1)
  have hAs : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => M γ w.1 w.2) (U ×ˢ Set.univ) :=
    (hMs γ).mono (fun w hw => ⟨hUΩ w.1 hw.1, trivial⟩)
  have hode : ∀ s ∈ U, ∀ v' ∈ Set.Icc 0 L,
      HasDerivAt (fun v'' => (fun w : (ℝ × ℝ × ℝ) × ℝ => G.tH γ w.1 w.2) (s, v''))
        (Matrix.mulVec (M γ s v') ((fun w : (ℝ × ℝ × ℝ) × ℝ => G.tH γ w.1 w.2) (s, v'))) v' := by
    intro s hs v' hv'
    obtain ⟨hvco, hrect, -⟩ :=
      pulse_line_rect5 B.h G.r0 γ (G.ctr γ) ξ.2.2.2 hr0 hr0' hR v' hv'.1 hv'.2
    set Y' := ξ.2.2.2 + (v' - vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) •
      ((cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) • vtv) with hY'
    obtain ⟨hDs, hetas⟩ := hUprop s hs Y'
    have h6 : HasDerivAt (G.tH γ s)
        ((APhi5 B G γ (s.1, s.2.1, s.2.2, Y')).mulVec (G.tH γ s (vco B.h G.r0 γ (G.ctr γ) Y'))
          - dDamp5 B G γ (s.1, s.2.1, s.2.2, Y') • G.tH γ s (vco B.h G.r0 γ (G.ctr γ) Y'))
        (vco B.h G.r0 γ (G.ctr γ) Y') :=
      (hG.2.2.2.2.2.1 γ hA (s.1, s.2.1, s.2.2, Y') hDs hetas hrect).1
    have hM : ∀ z : Fin 3 → ℝ, Matrix.mulVec (M γ s (vco B.h G.r0 γ (G.ctr γ) Y')) z =
        (APhi5 B G γ (s.1, s.2.1, s.2.2, Y')).mulVec z - dDamp5 B G γ (s.1, s.2.1, s.2.2, Y') • z :=
      fun z => (hMid γ (s.1, s.2.1, s.2.2, Y') hDs hrect).1 z
    rw [hvco] at h6 hM
    show HasDerivAt (G.tH γ s) (Matrix.mulVec (M γ s v') (G.tH γ s v')) v'
    rw [hM]
    exact h6
  have hprop : ∀ (x : ℝ → (Fin 3 → ℝ)) (w : ℝ), 0 ≤ w → w ≤ L →
      (∀ v' ∈ Set.Icc w L, HasDerivAt x (Matrix.mulVec (M γ (ξ.1, ξ.2.1, ξ.2.2.1) v') (x v')) v') →
      ∀ v' ∈ Set.Icc w L, ‖x v'‖ ≤ K * (Penv5 B G γ v' / Penv5 B G γ w) * ‖x w‖ := by
    intro x w hw0 hwL hx v' hv'
    have hPP := hP γ ξ (by omega) hA heta hD hX1 hX2 hR x w hw0 hwL ?_ v' hv'
    · have hnn : 0 ≤ (γ.1 : ℝ) ^ bP * (Penv5 B G γ v' / Penv5 B G γ w) * ‖x w‖ :=
        mul_nonneg (mul_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _)
          (div_nonneg (hPpos v').le (hPpos w).le)) (norm_nonneg _)
      have key := mul_le_mul_of_nonneg_right (le_abs_self CP) hnn
      calc ‖x v'‖ ≤ CP * (γ.1 : ℝ) ^ bP * (Penv5 B G γ v' / Penv5 B G γ w) * ‖x w‖ := hPP
        _ = CP * ((γ.1 : ℝ) ^ bP * (Penv5 B G γ v' / Penv5 B G γ w) * ‖x w‖) := by ring
        _ ≤ |CP| * ((γ.1 : ℝ) ^ bP * (Penv5 B G γ v' / Penv5 B G γ w) * ‖x w‖) := key
        _ = K * (Penv5 B G γ v' / Penv5 B G γ w) * ‖x w‖ := by rw [hKdef]; ring
    · intro u hu
      have hu0 : 0 ≤ u := le_trans hw0 hu.1
      obtain ⟨hvco, hrect, -⟩ :=
        pulse_line_rect5 B.h G.r0 γ (G.ctr γ) ξ.2.2.2 hr0 hr0' hR u hu0 hu.2
      set Yu := ξ.2.2.2 + (u - vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) •
        ((cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) • vtv) with hYu
      have hpath : ξ + (u - vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) • dVdir B.h γ.1 =
          (ξ.1, ξ.2.1, ξ.2.2.1, Yu) := by
        rw [hYu]
        ext <;> simp [dVdir]
      have hDu : (ξ.1, ξ.2.1, ξ.2.2.1, Yu) ∈ DomC B.h B.qB := hD
      have hMu : Matrix.mulVec (M γ (ξ.1, ξ.2.1, ξ.2.2.1) (vco B.h G.r0 γ (G.ctr γ) Yu)) (x u) =
          (APhi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1, Yu)).mulVec (x u) -
            dDamp5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1, Yu) • x u :=
        (hMid γ (ξ.1, ξ.2.1, ξ.2.2.1, Yu) hDu hrect).1 (x u)
      rw [hvco] at hMu
      rw [hpath, ← hMu]
      exact hx u hu

  set Λ : (ℝ × ℝ × ℝ) →L[ℝ] (ℝ × ℝ × ℝ) := (Real.sqrt (qC B.h ξ) • ContinuousLinearMap.id ℝ ℝ).prodMap
    ((qC B.h ξ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ))
    with hΛ
  have hcoefS : ∀ j : ℕ, j ≤ k → ∀ v' ∈ Set.Icc 0 L,
      ‖(iteratedFDeriv ℝ j (fun s => M γ s v') (ξ.1, ξ.2.1, ξ.2.2.1)).compContinuousLinearMap
        (fun _ => Λ)‖ ≤ Q := by
    intro j hj v' hv'
    have h := (h9c j γ ξ v' (by omega) hA heta hD hX1 hX2 hR hv'.1 hv'.2).2
    rw [← hSdef] at h
    calc _ ≤ C9 j * S ^ b9 j := h
      _ ≤ Cc * S ^ βc := hgen _ _ _ _ (hCcj j hj) (hβcj j hj)
      _ = Q := hQdef.symm
  have hcoefJ : ∀ j : ℕ, j ≤ k →
      ‖(iteratedFDeriv ℝ j (fun w : (ℝ × ℝ × ℝ) × ℝ => M γ w.1 w.2) ((ξ.1, ξ.2.1, ξ.2.2.1), v)).compContinuousLinearMap
        (fun _ => Λ.prodMap (ContinuousLinearMap.id ℝ ℝ))‖ ≤ Q := by
    intro j hj
    have h := (h9c j γ ξ v (by omega) hA heta hD hX1 hX2 hR hv0 hvL).1
    rw [← hSdef] at h
    calc _ ≤ C9 j * S ^ b9 j := h
      _ ≤ Cc * S ^ βc := hgen _ _ _ _ (hCcj j hj) (hβcj j hj)
      _ = Q := hQdef.symm
  have hinit : ∀ j : ℕ, j ≤ k →
      ‖(iteratedFDeriv ℝ j (fun s => (fun w : (ℝ × ℝ × ℝ) × ℝ => G.tH γ w.1 w.2) (s, 0))
        (ξ.1, ξ.2.1, ξ.2.2.1)).compContinuousLinearMap (fun _ => Λ)‖ ≤ I * Penv5 B G γ 0 := by
    intro j hj
    have h := h10c j γ ξ (by omega) hA heta hD hX1 hX2 hR
    rw [← hSdef] at h
