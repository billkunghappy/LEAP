    rw [hfun, iteratedFDeriv_const_smul_apply hga, norm_smul, Real.norm_of_nonneg (pow_nonneg hu0.le e)]
    have hξu : ((u * ξ0.1, ξ0.2.1, ξ0.2.2.1, (0 : ℝ × ℝ)) : Cyl) ∈ DomC B.h qs :=
