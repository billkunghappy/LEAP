    fun c e f hf => tdg_qshift_v5 B (qsOf l0) hok hSN hqs0 hqs1 c e 1 f hf
  have hE1 : Aex B.h + 1 + B.h * 1 = 2 * Aex B.h + 1/2 := by unfold Aex; ring
