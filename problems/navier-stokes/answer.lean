  refine ⟨fin _ _ (hsumle (fun j => ↿(A j)) k (x, t) (fun j => (hsm j).1) hxt)
      (fun j => (hCh j k hk x t hxt).1),
    fin _ _ (hsumle (fun j => ↿(Bv j)) k (x, t) (fun j => (hsm j).2.1) hxt)
      (fun j => (hCh j k hk x t hxt).2.1),
    fin _ _ (hsumle (fun j => ↿(P j)) k (x, t) (fun j => (hsm j).2.2) hxt)
      (fun j => (hCh j k hk x t hxt).2.2)⟩

theorem flat_residual_of_tail : ∀ (h qs Xe Xin c e0 γ : ℝ) (ℓ K L : ℕ → ℝ) (A Bv : ℕ → ℝ³ → ℝ → ℝ³) (P : ℕ → ℝ³ → ℝ → ℝ) (A' Bv' : ℝ³ → ℝ → ℝ³) (P' : ℝ³ → ℝ → ℝ) (a : ℕ → ℝ), 0 < h → h < 1 / 2 → 0 < qs → qs ≤ 1 → 0 < γ → SimScaleProps h → ApproxFamily h qs Xe Xin c e0 γ ℓ K A Bv P → (∀ j, 1 ≤ a j) → ContDiffOn ℝ ∞ (↿A') (simDomain h qs) → ContDiffOn ℝ ∞ (↿Bv') (simDomain h qs) → ContDiffOn ℝ ∞ (↿P') (simDomain h qs) → (∀ J k : ℕ, k ≤ J → ∀ x t, (x, t) ∈ simDomain h qs → a J * simScale h (x 2) (1 - t) < 1 / 2 → ‖iteratedFDeriv ℝ k (fun z => (↿A') z - ∑ j ∈ Finset.range (J + 1), (↿(A j)) z) (x, t)‖ ≤ (1 / 2) ^ J * simScale h (x 2) (1 - t) ^ (γ * ((J : ℝ) + 1) / 2 - L k) ∧ ‖iteratedFDeriv ℝ k (fun z => (↿Bv') z - ∑ j ∈ Finset.range (J + 1), (↿(Bv j)) z) (x, t)‖ ≤ (1 / 2) ^ J * simScale h (x 2) (1 - t) ^ (γ * ((J : ℝ) + 1) / 2 - L k) ∧ ‖iteratedFDeriv ℝ k (fun z => (↿P') z - ∑ j ∈ Finset.range (J + 1), (↿(P j)) z) (x, t)‖ ≤ (1 / 2) ^ J * simScale h (x 2) (1 - t) ^ (γ * ((J : ℝ) + 1) / 2 - L k)) → ∀ m N : ℕ, ∃ C δ : ℝ, 0 < δ ∧ ∀ x t, (x, t) ∈ simDomain h qs → simScale h (x 2) (1 - t) < δ → ‖iteratedFDeriv ℝ m (↿(nsResidual 1 (fun y s => curl3 (fun w => A' w s) y + Bv' y s) P')) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ N :=
