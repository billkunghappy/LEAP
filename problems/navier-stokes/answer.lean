    exact h

  have hchar : ∀ (M : Cyl → ℂ) (κ : ℤ × ℤ), ContDiff ℝ ∞ M →
      (∀ (a : ℝ × ℝ) (x : Cyl), M (x + ((0:ℝ), (0:ℝ), (0:ℝ), a)) =
        Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (a.1 : ℂ) + (κ.2 : ℂ) * (a.2 : ℂ))) * M x) →
      ∀ (j : ℕ) (x : Cyl) (v : ℝ × ℝ) (m : Fin j → Cyl),
        iteratedFDeriv ℝ (j + 1) M x (Fin.cons ((0:ℝ), (0:ℝ), (0:ℝ), v) m : Fin (j + 1) → Cyl) =
          (2 * Real.pi * Complex.I * ((κ.1 : ℂ) * (v.1 : ℂ) + (κ.2 : ℂ) * (v.2 : ℂ))) *
            iteratedFDeriv ℝ j M x m := by
    intro M κ hM hsh j x v m
    have hshift : ∀ t : ℝ, iteratedFDeriv ℝ j M (x + t • (((0:ℝ), (0:ℝ), (0:ℝ), v) : Cyl)) =
        Complex.exp ((t : ℂ) * (2 * Real.pi * Complex.I * ((κ.1 : ℂ) * (v.1 : ℂ) + (κ.2 : ℂ) * (v.2 : ℂ)))) •
          iteratedFDeriv ℝ j M x := by
      intro t
      have hfun : (fun z => M (z + t • (((0:ℝ), (0:ℝ), (0:ℝ), v) : Cyl))) =
          Complex.exp ((t : ℂ) * (2 * Real.pi * Complex.I * ((κ.1 : ℂ) * (v.1 : ℂ) + (κ.2 : ℂ) * (v.2 : ℂ)))) • M := by
