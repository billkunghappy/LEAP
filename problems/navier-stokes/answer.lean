  have hIpw : P.lam * (∫ y in Iic Y4, Real.exp (w y) * rfpR0 (P.lam * (y - Y3)) ^ 2) =
      D * ∫ ξ in (0:ℝ)..13, G ξ := by
    rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (s := Icc Y3 Y4) measurableSet_Iic ?_ ?_]
    · rw [integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hY34le]
      rw [intervalIntegral.integral_congr (g := fun y => D * G (P.lam * y - P.lam * Y3)) ?_]
      · rw [intervalIntegral.integral_const_mul,
          intervalIntegral.integral_comp_mul_sub G hl0' (P.lam * Y3), sub_self, smul_eq_mul]
        have h13' : P.lam * Y4 - P.lam * Y3 = 13 := by linear_combination hY43
        rw [h13']
        have hinv : P.lam * P.lam⁻¹ = 1 := mul_inv_cancel₀ hl0'
