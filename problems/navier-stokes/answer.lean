    have hW8 : W ^ ((1:ℝ)/8) ≤ C₀ ^ ((1:ℝ)/8) := Real.rpow_le_rpow hW hWC (by norm_num)
    have h1 : W ^ ((1:ℝ)/8) * S ^ ((1:ℝ)/8)
