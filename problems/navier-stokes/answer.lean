theorem rfp_S_V_smooth : ∀ P : RfpPar, RfpRegime P → ContDiff ℝ ∞ (fun η : ℝ => ∫ y in (rfpY4 P.Md P.lam)..(rfpY4 P.Md P.lam + 60), Real.exp (y + 2 * rfpLam P y) * ((1 + η ^ 2)⁻¹) ^ (2 * rfpTh P y)) ∧ ∀ η : ℝ, 0 ≤ (∫ y in (rfpY4 P.Md P.lam)..(rfpY4 P.Md P.lam + 60), Real.exp (y + 2 * rfpLam P y) * ((1 + η ^ 2)⁻¹) ^ (2 * rfpTh P y)) ∧ (∫ y in (rfpY4 P.Md P.lam)..(rfpY4 P.Md P.lam + 60), Real.exp (y + 2 * rfpLam P y) * ((1 + η ^ 2)⁻¹) ^ (2 * rfpTh P y)) ≤ 60 * Real.exp (-26) * Real.exp (rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam)) ∧ |deriv (fun e : ℝ => ∫ y in (rfpY4 P.Md P.lam)..(rfpY4 P.Md P.lam + 60), Real.exp (y + 2 * rfpLam P y) * ((1 + e ^ 2)⁻¹) ^ (2 * rfpTh P y)) η| ≤ 120 * Real.exp (-26) * Real.exp (rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam)) :=
by
  intro P hP
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hP

  have hEP : ∀ (a b : ℝ) (w θ : ℝ → ℝ), Continuous w → Continuous θ →
      ContDiff ℝ ∞ (fun s : ℝ => ∫ y in a..b, w y * Real.exp (-(θ y * s))) ∧
      ∀ s : ℝ, HasDerivAt (fun s : ℝ => ∫ y in a..b, w y * Real.exp (-(θ y * s)))
        (∫ y in a..b, -(θ y) * (w y * Real.exp (-(θ y * s)))) s := by
    intro a b w θ hw hθ
    have hder : ∀ v : ℝ → ℝ, Continuous v → ∀ s₀ : ℝ,
        HasDerivAt (fun s : ℝ => ∫ y in a..b, v y * Real.exp (-(θ y * s)))
          (∫ y in a..b, -(θ y) * (v y * Real.exp (-(θ y * s₀)))) s₀ := by
      intro v hv s₀
      obtain ⟨Cv, hCv⟩ :=
        (isCompact_uIcc (a := a) (b := b)).exists_bound_of_continuousOn hv.continuousOn
      obtain ⟨Cθ, hCθ⟩ :=
        (isCompact_uIcc (a := a) (b := b)).exists_bound_of_continuousOn hθ.continuousOn
      have hCv0 : 0 ≤ max Cv 0 := le_max_right _ _
      have hCθ0 : 0 ≤ max Cθ 0 := le_max_right _ _
      have hcontF : ∀ x : ℝ, Continuous (fun t => v t * Real.exp (-(θ t * x))) := by
        intro x; fun_prop
      have hcontF' : ∀ x : ℝ, Continuous (fun t => -(θ t) * (v t * Real.exp (-(θ t * x)))) := by
        intro x; fun_prop
      have hbound : ∀ t ∈ Set.uIoc a b, ∀ x ∈ Metric.ball s₀ 1,
          ‖-(θ t) * (v t * Real.exp (-(θ t * x)))‖ ≤
            max Cθ 0 * (max Cv 0 * Real.exp (max Cθ 0 * (|s₀| + 1))) := by
        intro t ht x hx
        have ht' : t ∈ Set.uIcc a b := Set.uIoc_subset_uIcc ht
        have h1 : |v t| ≤ max Cv 0 :=
          le_trans (by simpa [Real.norm_eq_abs] using hCv t ht') (le_max_left _ _)
        have h2 : |θ t| ≤ max Cθ 0 :=
          le_trans (by simpa [Real.norm_eq_abs] using hCθ t ht') (le_max_left _ _)
        have hx' : |x| ≤ |s₀| + 1 := by
          have hd : dist x s₀ < 1 := hx
          rw [Real.dist_eq] at hd
          have := abs_sub_abs_le_abs_sub x s₀
          linarith
        have h3 : Real.exp (-(θ t * x)) ≤ Real.exp (max Cθ 0 * (|s₀| + 1)) := by
          apply Real.exp_le_exp.mpr
          have e1 : -(θ t * x) ≤ |θ t * x| := neg_le_abs _
          rw [abs_mul] at e1
          have e2 : |θ t| * |x| ≤ max Cθ 0 * (|s₀| + 1) :=
            mul_le_mul h2 hx' (abs_nonneg _) hCθ0
          linarith
        rw [Real.norm_eq_abs, abs_mul, abs_neg, abs_mul, Real.abs_exp]
        exact mul_le_mul h2 (mul_le_mul h1 h3 (Real.exp_pos _).le hCv0) (by positivity) hCθ0
      have hdx : ∀ t x : ℝ, HasDerivAt (fun x => v t * Real.exp (-(θ t * x)))
          (-(θ t) * (v t * Real.exp (-(θ t * x)))) x := by
        intro t x
        have h : HasDerivAt (fun x => v t * Real.exp (-(θ t * x)))
            (v t * (Real.exp (-(θ t * x)) * -(θ t * 1))) x :=
          (((hasDerivAt_id' x).const_mul (θ t)).neg.exp).const_mul (v t)
        exact h.congr_deriv (by ring)
      have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
        (μ := MeasureTheory.volume) (a := a) (b := b)
        (F := fun x t => v t * Real.exp (-(θ t * x)))
        (F' := fun x t => -(θ t) * (v t * Real.exp (-(θ t * x))))
        (x₀ := s₀)
        (bound := fun _ => max Cθ 0 * (max Cv 0 * Real.exp (max Cθ 0 * (|s₀| + 1))))
        (Metric.ball_mem_nhds s₀ one_pos)
        (Filter.Eventually.of_forall (fun x => (hcontF x).aestronglyMeasurable))
        ((hcontF s₀).intervalIntegrable _ _)
        ((hcontF' s₀).aestronglyMeasurable)
        (MeasureTheory.ae_of_all _ (fun t ht x hx => hbound t ht x hx))
        intervalIntegrable_const
        (MeasureTheory.ae_of_all _ (fun t _ x _ => hdx t x))
      exact key.2
    have hstep : ∀ v : ℝ → ℝ, Continuous v → ∀ s : ℝ,
        HasDerivAt (fun s : ℝ => ∫ y in a..b, v y * Real.exp (-(θ y * s)))
          ((fun s : ℝ => ∫ y in a..b, (-(θ y) * v y) * Real.exp (-(θ y * s))) s) s := by
      intro v hv s
      refine (hder v hv s).congr_deriv ?_
      show _ = ∫ y in a..b, (-(θ y) * v y) * Real.exp (-(θ y * s))
      congr 1
      funext y
      ring
    have hnat : ∀ n : ℕ, ∀ v : ℝ → ℝ, Continuous v →
        ContDiff ℝ n (fun s : ℝ => ∫ y in a..b, v y * Real.exp (-(θ y * s))) := by
      intro n
      induction n with
      | zero =>
        intro v hv
        have hd : Differentiable ℝ (fun s : ℝ => ∫ y in a..b, v y * Real.exp (-(θ y * s))) :=
          fun s => (hstep v hv s).differentiableAt
        rw [Nat.cast_zero]
        exact contDiff_zero.mpr hd.continuous
      | succ n ih =>
        intro v hv
        have hd : Differentiable ℝ (fun s : ℝ => ∫ y in a..b, v y * Real.exp (-(θ y * s))) :=
          fun s => (hstep v hv s).differentiableAt
        have hderiv : deriv (fun s : ℝ => ∫ y in a..b, v y * Real.exp (-(θ y * s))) =
            (fun s : ℝ => ∫ y in a..b, (-(θ y) * v y) * Real.exp (-(θ y * s))) := by
          funext s; exact (hstep v hv s).deriv
        have hT : Continuous (fun y => -(θ y) * v y) := hθ.neg.mul hv
        have hih := ih (fun y => -(θ y) * v y) hT
        rw [show ((n + 1 : ℕ) : WithTop ℕ∞) = (n : WithTop ℕ∞) + 1 by push_cast; rfl]
        refine contDiff_succ_iff_deriv.mpr ⟨hd, fun h => absurd h (by simp), ?_⟩
        rw [hderiv]
        exact hih
    exact ⟨contDiff_infty.mpr (fun n => hnat n w hw), hder w hw⟩

  have s0 : ∀ t : ℝ, t ≤ 0 → sigA t = 0 := fun t ht => by unfold sigA; rw [if_pos ht]
  have s1 : ∀ t : ℝ, 1 ≤ t → sigA t = 1 := fun t ht => by
    unfold sigA; rw [if_neg (by linarith), if_pos ht]
  have sb : ∀ t : ℝ, 0 ≤ sigA t ∧ sigA t ≤ 1 := by
    intro t
    unfold sigA
    split_ifs
    · norm_num
    · norm_num
    · have ha := Real.exp_pos (-1 / t ^ 2)
      have hc := Real.exp_pos (-1 / (1 - t) ^ 2)
      constructor
      · positivity
      · rw [div_le_one (by positivity)]; linarith
  have scont : Continuous sigA := by
    set G : ℝ → ℝ := fun y => expNegInvGlue (max y 0 ^ 2) with hG
    have hGc : Continuous G :=
      ((expNegInvGlue.contDiff (n := 0)).continuous).comp ((continuous_id.max continuous_const).pow 2)
    have hG0 : ∀ y : ℝ, y ≤ 0 → G y = 0 := by
      intro y hy
      simp only [hG, max_eq_right hy]
      exact expNegInvGlue.zero_of_nonpos (by norm_num)
    have hGp : ∀ y : ℝ, 0 < y → G y = Real.exp (-1 / y ^ 2) := by
      intro y hy
      simp only [hG, max_eq_left hy.le]
      unfold expNegInvGlue
      rw [if_neg (not_le.mpr (pow_pos hy 2)), neg_div, one_div]
    have hGpos : ∀ y : ℝ, 0 < y → 0 < G y := by
      intro y hy
      rw [hGp y hy]; exact Real.exp_pos _
    have hGnn : ∀ y : ℝ, 0 ≤ G y := by
      intro y
      rcases le_or_gt y 0 with hy | hy
      · rw [hG0 y hy]
      · exact (hGpos y hy).le
    have hden : ∀ y : ℝ, G y + G (1 - y) ≠ 0 := by
      intro y
      rcases le_or_gt y 0 with hy | hy
      · have := hGpos (1 - y) (by linarith)
        have := hGnn y
        linarith
      · have := hGpos y hy
        have := hGnn (1 - y)
        linarith
    have heq : sigA = fun y => G y / (G y + G (1 - y)) := by
      funext y
      unfold sigA
      split_ifs with hy0 hy1
      · rw [hG0 y hy0, zero_div]
      · rw [hG0 (1 - y) (by linarith), add_zero, div_self (hGpos y (by linarith)).ne']
      · push_neg at hy0 hy1
        rw [hGp y hy0, hGp (1 - y) (by linarith)]
    rw [heq]
    exact hGc.div (hGc.add (hGc.comp (continuous_const.sub continuous_id))) hden
  have sII : ∀ a b : ℝ, IntervalIntegrable sigA MeasureTheory.volume a b :=
    fun a b => scont.intervalIntegrable a b
  have Sig0 : ∀ t : ℝ, t ≤ 0 → rfpSigI t = 0 := by
    intro t ht
    unfold rfpSigI
    rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ)) ?_]
    · simp
    · intro x hx
      rw [Set.uIcc_of_ge ht] at hx
      exact s0 x hx.2
  have Sig1 : ∀ a b : ℝ, 1 ≤ a → 1 ≤ b → rfpSigI b - rfpSigI a = b - a := by
    intro a b ha hb
    unfold rfpSigI
    rw [intervalIntegral.integral_interval_sub_left (sII 0 b) (sII 0 a)]
    rw [intervalIntegral.integral_congr (g := fun _ => (1:ℝ)) ?_]
    · simp
    · intro x hx
      apply s1
      rcases le_total a b with h | h
      · rw [Set.uIcc_of_le h] at hx; linarith [hx.1]
      · rw [Set.uIcc_of_ge h] at hx; linarith [hx.1]

  have hL : 0 ≤ Real.log (1 / P.lam) := Real.log_nonneg (by rw [le_div_iff₀ hl0]; linarith)
  have hh1 : P.h ≤ 1 := by nlinarith
  have hlogh : 0 ≤ Real.log (1 / P.h) := Real.log_nonneg (by rw [le_div_iff₀ hh0]; linarith)
  have hT1pos : 0 ≤ P.T1 := by linarith
  have hρ1 : P.ρ < 1 := by linarith
  have hlog2 : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  have hy2pos : 0 < rfpY2 P.Md := by unfold rfpY2; positivity
  have e3 : rfpY3 P.Md P.lam = rfpY2 P.Md + 1 + 60 * Real.log (1 / P.lam) := rfl
  have e4 : rfpY4 P.Md P.lam = rfpY3 P.Md P.lam + 13 / P.lam := rfl
  have e5 : rfpY5 P.Md P.lam = rfpY4 P.Md P.lam + 60 + 30 * Real.log (1 / P.lam) := rfl
  have eb : rfpYb P.Md P.lam P.T1 P.Lh = rfpY5 P.Md P.lam + 2 + P.T1 + P.Lh + 3 := rfl
  have h13 : 0 < 13 / P.lam := div_pos (by norm_num) hl0
  have hy3lo : rfpY2 P.Md + 1 ≤ rfpY3 P.Md P.lam := by rw [e3]; linarith
  have hy34 : rfpY3 P.Md P.lam ≤ rfpY4 P.Md P.lam := by rw [e4]; linarith
  have hy45 : rfpY4 P.Md P.lam + 60 ≤ rfpY5 P.Md P.lam := by rw [e5]; linarith
  have hy35 : rfpY3 P.Md P.lam ≤ rfpY5 P.Md P.lam := by linarith
  have hab : rfpY4 P.Md P.lam ≤ rfpY4 P.Md P.lam + 60 := by linarith

  have hLam : ∀ z : ℝ, rfpY2 P.Md + 1 ≤ z → z ≤ rfpY5 P.Md P.lam →
      rfpLam P z = Real.log P.Pst + z / 10 - 3 / 5 * rfpSigI z - P.lam * rfpSigI (z - rfpY2 P.Md)
        - sigA ((z - rfpY4 P.Md P.lam) / 60) * Real.log 2 := by
    intro z hz1 hz2
    have t1 : rfpSigI (z - rfpY5 P.Md P.lam) = 0 := Sig0 _ (by linarith)
    have t2 : rfpSigI (z - rfpY5 P.Md P.lam - 1 - P.T1) = 0 := Sig0 _ (by linarith)
    have hs : sigA ((Real.log (Real.exp z / Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) + 2) / 2) = 0 := by
      apply s0
      rw [← Real.exp_sub, Real.log_exp, eb]
      linarith
    have t4 : tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp z) = 1 - P.ρ := by
      unfold tailFac; rw [hs]; ring
    have t5 : Real.log (tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp z) / (1 - P.ρ)) = 0 := by
      rw [t4, div_self (by linarith), Real.log_one]
    rw [rfpLam, t1, t2, t5]
    ring

  have hPulse : ∀ y, rfpY3 P.Md P.lam ≤ y → y ≤ rfpY5 P.Md P.lam →
      rfpLam P y = rfpLam P (rfpY3 P.Md P.lam) - (1 / 2 + P.lam) * (y - rfpY3 P.Md P.lam)
        - sigA ((y - rfpY4 P.Md P.lam) / 60) * Real.log 2 := by
    intro y hy1 hy2
    have h30 : sigA ((rfpY3 P.Md P.lam - rfpY4 P.Md P.lam) / 60) = 0 :=
      s0 _ (div_nonpos_of_nonpos_of_nonneg (by linarith) (by norm_num))
    rw [hLam y (by linarith) hy2, hLam _ hy3lo hy35, h30]
    have a1 := Sig1 (rfpY3 P.Md P.lam) y (by linarith) (by linarith)
    have a2 := Sig1 (rfpY3 P.Md P.lam - rfpY2 P.Md) (y - rfpY2 P.Md) (by linarith) (by linarith)
    linear_combination (-(3 / 5 : ℝ)) * a1 - P.lam * a2

  obtain ⟨W, hW⟩ : ∃ W : ℝ → ℝ, ∀ y, W y = Real.exp (y + 2 * (rfpLam P (rfpY3 P.Md P.lam)
      - (1 / 2 + P.lam) * (y - rfpY3 P.Md P.lam) - sigA ((y - rfpY4 P.Md P.lam) / 60) * Real.log 2)) :=
    ⟨_, fun y => rfl⟩
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ℝ → ℝ, ∀ y, Θ y = 2 * (1 - sigA ((y - rfpY4 P.Md P.lam) / 60)) :=
    ⟨_, fun y => rfl⟩
  obtain ⟨M, hM⟩ : ∃ M : ℝ, M = Real.exp (-26) *
      Real.exp (rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam)) := ⟨_, rfl⟩
  have hM0 : 0 ≤ M := by rw [hM]; positivity
  have hWc : Continuous W := by
    rw [show W = fun y => Real.exp (y + 2 * (rfpLam P (rfpY3 P.Md P.lam)
      - (1 / 2 + P.lam) * (y - rfpY3 P.Md P.lam) - sigA ((y - rfpY4 P.Md P.lam) / 60) * Real.log 2))
      from funext hW]
    fun_prop
