theorem ax_ref_eta_close : ∀ (h r ε : ℝ) (Pax : ℝ → ℝ) (F U : ℝ → ℝ → ℝ), 0 < h → h < 1 / 100 → 0 < r → r ≤ 1 → 0 < ε → ContDiffOn ℝ ∞ (↿F) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) → ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) → (∀ X η : ℝ, 0 ≤ X → -1 - r < η → η < 1 + r → 0 < F X η) → ContDiffOn ℝ ∞ Pax (Ioo (-1 - r) (1 + r)) → ∀ X c1 c2 : ℝ, 0 < X → 0 < c1 → (∀ η : ℝ, -1 < η → η < 1 → c1 ≤ psLead1 h F U X η ∧ c2 ≤ psLead1 h F U X η + axPs2 h Pax F U X η ^ 2 / psLead1 h F U X η) → ∀ η : ℝ, -1 ≤ η → η ≤ 1 → c1 ≤ psLead1 h F U X η ∧ c2 ≤ psLead1 h F U X η + axPs2 h Pax F U X η ^ 2 / psLead1 h F U X η :=
