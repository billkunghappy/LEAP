          ≤ a⁻¹ * (β * ξ.1) ^ i * |iteratedDeriv i (fun s : ℝ => (s ^ d + u) ^ (1 / d)) ξ.1| :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hpw hai) hX0
        _ = a⁻¹ * β ^ i * (|iteratedDeriv i (fun s : ℝ => (s ^ d + u) ^ (1 / d)) ξ.1| * ξ.1 ^ i) := by
            ring
        _ ≤ a⁻¹ * β ^ i * (|C2 i| * (Real.sqrt (2 * B.Xb) * a)) :=
            mul_le_mul_of_nonneg_left hb2 (mul_nonneg hai (pow_nonneg hβ0 _))
        _ = (a⁻¹ * a) * (|C2 i| * β ^ i * Real.sqrt (2 * B.Xb)) := by ring
        _ = M i := by rw [hia, one_mul, hM]
    have hMs : M i ≤ ∑ j ∈ Finset.range (k + 1), M j :=
      Finset.single_le_sum (fun j _ => hM0 j) (Finset.mem_range.mpr (by omega))
    calc _ ≤ ‖iteratedFDeriv ℝ i θ 0‖ + 1 := hP
      _ ≤ D := by rw [hD]; linarith
      _ ≤ D ^ i := le_self_pow₀ hD1 (by omega)
  have hFdB := norm_iteratedFDerivWithin_comp_le hGs (hΘs.mono Set.inter_subset_left) (n := k)
    (by exact_mod_cast le_top) ht.uniqueDiffOn hs0.uniqueDiffOn (fun w hw => hw.2) h0s hCb hDb

  obtain ⟨U, hUdef⟩ : ∃ U : Set Cyl, U = DomC B.h qs ∩ {η : Cyl | 0 < η.1 ^ d + u} := ⟨_, rfl⟩
  have hUo : IsOpen U := by
    rw [hUdef]
    exact hDo.inter (isOpen_lt continuous_const
      ((continuous_fst.rpow_const (fun _ => Or.inr hd.le)).add continuous_const))
  have hFs : ContDiffOn ℝ ∞
      (fun η : Cyl => f ((η.1 ^ d + u) ^ (1 / d), η.2.1, η.2.2.1, η.2.2.2 + u • vrv)) U := by
    intro η hη
    rw [hUdef] at hη
    have hη1 : 0 < η.1 := hη.1.1
    have hη2 : 0 < η.1 ^ d + u := hη.2
    have hmem : ((η.1 ^ d + u) ^ (1 / d), η.2.1, η.2.2.1, η.2.2.2 + u • vrv) ∈ DomC B.h qs := by
      rw [← hpid η u hη2]; exact hpath η hη.1 _ (Real.rpow_pos_of_pos hη2 _)
    have hΦ : ContDiffAt ℝ ∞
        (fun η : Cyl => ((η.1 ^ d + u) ^ (1 / d), η.2.1, η.2.2.1, η.2.2.2 + u • vrv)) η :=
      (((contDiffAt_fst.rpow_const_of_ne hη1.ne').add contDiffAt_const).rpow_const_of_ne
        hη2.ne').prodMk
        (contDiff_snd.fst.prodMk (contDiff_snd.snd.fst.prodMk
          (contDiff_snd.snd.snd.add contDiff_const))).contDiffAt
    exact ((hf.contDiffAt (hDo.mem_nhds hmem)).comp η hΦ).contDiffWithinAt
  have hξU : ξ + Lnorm B.h ξ 0 ∈ U := by
    rw [map_zero, add_zero, hUdef]; exact ⟨hξ, hs⟩
  have hk := key (fun η : Cyl => f ((η.1 ^ d + u) ^ (1 / d), η.2.1, η.2.2.1, η.2.2.2 + u • vrv))
    U ξ 0 (Lnorm B.h ξ) k hUo hFs hξU
  rw [map_zero, add_zero] at hk
  have hid : (fun z : Cyl => (fun η : Cyl => f ((η.1 ^ d + u) ^ (1 / d), η.2.1, η.2.2.1,
      η.2.2.2 + u • vrv)) (ξ + Lnorm B.h ξ z)) = (fun y => f (p₀ + Lnorm B.h ξ y)) ∘ Θ := by
    funext w
    simp only [Function.comp_apply]
    congr 1
    rw [hLw, hLw, hΘdef, hθdef, hp₀]
    simp only [Prod.fst_add, Prod.snd_add, Prod.mk_add_mk, zero_add, mul_inv_cancel_left₀ ha.ne']
    refine Prod.ext rfl (Prod.ext rfl (Prod.ext rfl ?_))
    show ξ.2.2.2 + _ + u • vrv = ξ.2.2.2 + u • vrv + _
    abel
  calc NB B.h (fun η => f ((η.1 ^ d + u) ^ (1 / d), η.2.1, η.2.2.1, η.2.2.2 + u • vrv)) k ξ
      = ‖iteratedFDeriv ℝ k (fun z : Cyl => (fun η : Cyl => f ((η.1 ^ d + u) ^ (1 / d), η.2.1,
          η.2.2.1, η.2.2.2 + u • vrv)) (ξ + Lnorm B.h ξ z)) 0‖ := by
        unfold NB; rw [hk]
    _ = ‖iteratedFDeriv ℝ k ((fun y => f (p₀ + Lnorm B.h ξ y)) ∘ Θ) 0‖ := by rw [hid]
    _ = ‖iteratedFDerivWithin ℝ k ((fun y => f (p₀ + Lnorm B.h ξ y)) ∘ Θ)
          ((Prod.fst ⁻¹' Vθ : Set Cyl) ∩ Θ ⁻¹' ((fun y => p₀ + Lnorm B.h ξ y) ⁻¹' DomC B.h qs)) 0‖ := by
        rw [iteratedFDerivWithin_of_isOpen k hs0 h0s]
    _ ≤ (k.factorial : ℝ) * Csum * D ^ k := hFdB
    _ = (k.factorial : ℝ) * D ^ k *
          ∑ i ∈ Finset.range (k + 1), NB B.h f i (pathPt B.h ξ ((ξ.1 ^ d + u) ^ (1 / d))) := by
        rw [hCsum]; ring

theorem path_kernel_smooth_v4 : ∀ (B : BG) (qs : ℝ), B.ok → 0 < drx B.h → 0 < qs → qs ≤ 1 →
     ∀ (f : Cyl → ℝ), ContDiffOn ℝ ∞ f (DomC B.h qs) →
     (∀ ξ ∈ DomC B.h qs, (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → f ξ = 0) →
     ContDiffOn ℝ ∞ (fun p : Cyl × ℝ => if 0 < p.1.1 ^ drx B.h + p.2 then (1 / drx B.h) * (p.1.1 ^ drx B.h + p.2) ^ (1 / drx B.h - 1) *
         f ((p.1.1 ^ drx B.h + p.2) ^ (1 / drx B.h), p.1.2.1, p.1.2.2.1, p.1.2.2.2 + p.2 • vrv) else 0) (DomC B.h qs ×ˢ Set.univ) ∧
     ∀ ξ ∈ DomC B.h qs, ∀ u : ℝ,
       (ξ.1 ^ drx B.h + u < (2 * B.Xa * qC B.h ξ) ^ (drx B.h / 2) ∨ (2 * B.Xb * qC B.h ξ) ^ (drx B.h / 2) < ξ.1 ^ drx B.h + u) →
       (fun η : Cyl => if 0 < η.1 ^ drx B.h + u then (1 / drx B.h) * (η.1 ^ drx B.h + u) ^ (1 / drx B.h - 1) *
         f ((η.1 ^ drx B.h + u) ^ (1 / drx B.h), η.2.1, η.2.2.1, η.2.2.2 + u • vrv) else 0) =ᶠ[nhds ξ] fun _ => (0:ℝ) :=
by
  intro B qs hok hd0 hqs0 hqs1 f hf hfz
  obtain ⟨d, hdd⟩ : ∃ d : ℝ, drx B.h = d := ⟨_, rfl⟩
  rw [hdd]
  have hd : 0 < d := by rw [← hdd]; exact hd0
  have hd2 : 0 < d / 2 := by linarith
  have hqpos : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ := fun ξ hξ =>
    (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by have := hξ.2.1; linarith)).1
  have hqc : ContinuousOn (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have h1 : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have h2 : Continuous (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
      continuous_snd.fst.prodMk (continuous_const.sub continuous_snd.snd.fst)
    exact h1.comp h2.continuousOn (fun ξ hξ => ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by
      have : ξ.2.2.1 < 1 := hξ; linarith⟩)
  have hDo : IsOpen (DomC B.h qs) := by
    have ho : IsOpen ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Set.Iio qs) :=
      hqc.isOpen_inter_preimage (isOpen_lt continuous_snd.snd.fst continuous_const) isOpen_Iio
    have e : DomC B.h qs = {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Set.Iio qs) := by
      ext ξ; rfl
    rw [e]
    exact (isOpen_lt continuous_const continuous_fst).inter ho
  have hqD : ContinuousOn (qC B.h) (DomC B.h qs) := hqc.mono (fun ξ hξ => hξ.2.1)
  obtain ⟨hh0, hh1, hXa, hXam1, hm12, hm2Xb, -⟩ := hok.2.1
  have hXb0 : 0 < B.Xb := by linarith

  have hvan : ∀ η ∈ DomC B.h qs, ∀ u : ℝ,
      (η.1 ^ d + u < (2 * B.Xa * qC B.h η) ^ (d / 2) ∨ (2 * B.Xb * qC B.h η) ^ (d / 2) < η.1 ^ d + u) →
      (if 0 < η.1 ^ d + u then (1 / d) * (η.1 ^ d + u) ^ (1 / d - 1) *
          f ((η.1 ^ d + u) ^ (1 / d), η.2.1, η.2.2.1, η.2.2.2 + u • vrv) else 0) = 0 := by
    intro η hη u hu
    split_ifs with hs
    · have hq := hqpos η hη
      have h2q : 0 < 2 * qC B.h η := by linarith
      have hρpos : 0 < (η.1 ^ d + u) ^ (1 / d) := Real.rpow_pos_of_pos hs _
      have hmem : ((η.1 ^ d + u) ^ (1 / d), η.2.1, η.2.2.1, η.2.2.2 + u • vrv) ∈ DomC B.h qs :=
        show 0 < (η.1 ^ d + u) ^ (1 / d) ∧ η.2.2.1 < 1 ∧ qC B.h η < qs from
          ⟨hρpos, hη.2.1, hη.2.2⟩
      have hX : XC B.h ((η.1 ^ d + u) ^ (1 / d), η.2.1, η.2.2.1, η.2.2.2 + u • vrv) =
          ((η.1 ^ d + u) ^ (1 / d)) ^ 2 / (2 * qC B.h η) := rfl
      have hρsq : (((η.1 ^ d + u) ^ (1 / d)) ^ 2) ^ (d / 2) = η.1 ^ d + u := by
        rw [← Real.rpow_natCast ((η.1 ^ d + u) ^ (1 / d)) 2, ← Real.rpow_mul hρpos.le,
          ← Real.rpow_mul hs.le]
        have hdne : d ≠ 0 := hd.ne'
        have e : 1 / d * (((2:ℕ):ℝ) * (d / 2)) = 1 := by
          push_cast; field_simp
        rw [e, Real.rpow_one]
      have hc : 0 < 2 * B.Xa * qC B.h η := mul_pos (mul_pos two_pos hXa) hq
      have hc' : 0 < 2 * B.Xb * qC B.h η := mul_pos (mul_pos two_pos hXb0) hq
      have hf0 : f ((η.1 ^ d + u) ^ (1 / d), η.2.1, η.2.2.1, η.2.2.2 + u • vrv) = 0 := by
        apply hfz _ hmem
        rw [hX]
        rcases hu with h | h
        · left
          rw [← hρsq] at h
          have h3 := (Real.rpow_lt_rpow_iff (sq_nonneg _) hc.le hd2).mp h
          rw [div_le_iff₀ h2q]; nlinarith
        · right
          rw [← hρsq] at h
          have h3 := (Real.rpow_lt_rpow_iff hc'.le (sq_nonneg _) hd2).mp h
          rw [le_div_iff₀ h2q]; nlinarith
      rw [hf0, mul_zero]
    · rfl

  have hK1 : ContDiffOn ℝ ∞ (fun p : Cyl × ℝ => (1 / d) * (p.1.1 ^ d + p.2) ^ (1 / d - 1) *
      f ((p.1.1 ^ d + p.2) ^ (1 / d), p.1.2.1, p.1.2.2.1, p.1.2.2.2 + p.2 • vrv))
      ((DomC B.h qs ×ˢ Set.univ) ∩ {p : Cyl × ℝ | 0 < p.1.1 ^ d + p.2}) := by
    intro p hp
    have hp1 : 0 < p.1.1 := hp.1.1.1
    have hp2 : 0 < p.1.1 ^ d + p.2 := hp.2
    have hs : ContDiffAt ℝ ∞ (fun p : Cyl × ℝ => p.1.1 ^ d + p.2) p :=
      (contDiff_fst.fst.contDiffAt.rpow_const_of_ne hp1.ne').add contDiff_snd.contDiffAt
    have hΦ : ContDiffAt ℝ ∞ (fun p : Cyl × ℝ => ((p.1.1 ^ d + p.2) ^ (1 / d), p.1.2.1, p.1.2.2.1,
        p.1.2.2.2 + p.2 • vrv)) p :=
      (hs.rpow_const_of_ne hp2.ne').prodMk
        (contDiff_fst.snd.fst.prodMk (contDiff_fst.snd.snd.fst.prodMk
          (contDiff_fst.snd.snd.snd.add (contDiff_snd.smul contDiff_const)))).contDiffAt
    have hmem : ((p.1.1 ^ d + p.2) ^ (1 / d), p.1.2.1, p.1.2.2.1, p.1.2.2.2 + p.2 • vrv) ∈
        DomC B.h qs :=
      show 0 < (p.1.1 ^ d + p.2) ^ (1 / d) ∧ p.1.2.2.1 < 1 ∧ qC B.h p.1 < qs from
        ⟨Real.rpow_pos_of_pos hp2 _, hp.1.1.2.1, hp.1.1.2.2⟩
    have hfΦ := (hf.contDiffAt (hDo.mem_nhds hmem)).comp p hΦ
    exact ((contDiffAt_const.mul (hs.rpow_const_of_ne hp2.ne')).mul hfΦ).contDiffWithinAt
  have hsc : Continuous (fun p : Cyl × ℝ => p.1.1 ^ d + p.2) :=
    (continuous_fst.fst.rpow_const (fun _ => Or.inr hd.le)).add continuous_snd
  have hgc : ContinuousOn (fun p : Cyl × ℝ => (2 * B.Xa * qC B.h p.1) ^ (d / 2))
      (DomC B.h qs ×ˢ Set.univ) :=
    (continuousOn_const.mul (hqD.comp continuous_fst.continuousOn (fun p hp => hp.1))).rpow_const
      (fun _ _ => Or.inr hd2.le)
  have hO2o : IsOpen ((DomC B.h qs ×ˢ Set.univ) ∩
      (fun p : Cyl × ℝ => (2 * B.Xa * qC B.h p.1) ^ (d / 2) - (p.1.1 ^ d + p.2)) ⁻¹' Set.Ioi 0) :=
    (hgc.sub hsc.continuousOn).isOpen_inter_preimage (hDo.prod isOpen_univ) isOpen_Ioi
  refine ⟨?_, ?_⟩
  · apply contDiffOn_of_locally_contDiffOn
    intro p hp
    by_cases hpos : 0 < p.1.1 ^ d + p.2
    · refine ⟨{p : Cyl × ℝ | 0 < p.1.1 ^ d + p.2}, isOpen_lt continuous_const hsc, hpos, ?_⟩
      exact hK1.congr (fun x hx => if_pos hx.2)
    · refine ⟨_, hO2o, ⟨hp, ?_⟩, ?_⟩
      · show 0 < (2 * B.Xa * qC B.h p.1) ^ (d / 2) - (p.1.1 ^ d + p.2)
        have : 0 < (2 * B.Xa * qC B.h p.1) ^ (d / 2) :=
          Real.rpow_pos_of_pos (mul_pos (mul_pos two_pos hXa) (hqpos _ hp.1)) _
        linarith [not_lt.mp hpos]
      · refine (contDiffOn_const (c := (0:ℝ))).congr (fun x hx => ?_)
        have hx1 : x.1 ∈ DomC B.h qs := hx.1.1
        have hx2 : 0 < (2 * B.Xa * qC B.h x.1) ^ (d / 2) - (x.1.1 ^ d + x.2) := hx.2.2
        exact hvan x.1 hx1 x.2 (Or.inl (by linarith))
  · intro ξ hξ u hu
    have hsu : Continuous (fun η : Cyl => η.1 ^ d + u) :=
      (continuous_fst.rpow_const (fun _ => Or.inr hd.le)).add continuous_const
    rcases hu with hu | hu
    · have hgo : ContinuousOn (fun η : Cyl => (2 * B.Xa * qC B.h η) ^ (d / 2)) (DomC B.h qs) :=
        (continuousOn_const.mul hqD).rpow_const (fun _ _ => Or.inr hd2.le)
      have hNo : IsOpen (DomC B.h qs ∩
