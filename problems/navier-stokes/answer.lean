def PulseSol5 (B : BG) (G : CorrGeom) (l0 : ℕ) (α : ℝ) (f tw : WC) (pr : WS) : Prop :=
  InWg5 B G (qsOf l0) α (cutA B G tw) ∧ InWg5 B G (qsOf l0) (α + 1/2) (cutS B G pr) ∧
  (∀ γ m, m = 0 → tw γ m = 0 ∧ pr γ m = 0) ∧
  (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), dotProduct (nPhiC5 B G γ ξ) (tw γ m ξ) = 0) ∧
  (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), psiW B G γ ξ ≠ 0 →
     DifferentiableAt ℝ (tw γ m) ξ ∧
     dVc B γ.1 (tw γ m) ξ = (pulseMatC (APhi5 B G γ ξ)).mulVec (tw γ m ξ)
        - ((m : ℂ) ^ 2 * ((dDamp5 B G γ ξ : ℝ) : ℂ)) • tw γ m ξ - projT5 B G γ ξ (srcHat B f γ m ξ)) ∧
  (∀ γ m, m ≠ 0 → ∀ ξ ∈ DomC B.h (qsOf l0),
