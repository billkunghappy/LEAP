        + (2 * Real.exp y * e * (Real.exp (rfpLam P y) * (1 + e ^ 2)⁻¹) * P.c2 e) * k2
        + (2 * Real.exp y * (Real.exp (rfpLam P y) * (1 + e ^ 2)⁻¹) ^ 2 * P.Amp e * P.c1 e) * p01
        + (2 * Real.exp y * (Real.exp (rfpLam P y) * (1 + e ^ 2)⁻¹) ^ 2 * P.Amp e * P.c2 e) * p02
        + (2 * Real.exp y * (Real.exp (rfpLam P y) * (1 + e ^ 2)⁻¹) ^ 2 * P.c1 e * P.c2 e) * p12
    show (∫ t in (0:ℝ)..x, (rfpU P t e ^ 2 - t * rfpF P t e ^ 2)) = _
    rw [hsub (fun t => rfpU P t e ^ 2 - t * rfpF P t e ^ 2),
      setIntegral_congr_fun measurableSet_Iic hpt]
    have j1 : Integrable (fun y => e ^ 2 * (Real.exp y * rfpK P.Md y ^ 2))
        (volume.restrict (Iic (Real.log x))) := iK2.const_mul _
    have j2 : Integrable (fun y => (((1 + e ^ 2)⁻¹) ^ 2 * P.Amp e ^ 2) *
        (Real.exp (y + 2 * rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam)) ^ 2))
        (volume.restrict (Iic (Real.log x))) := iR2.const_mul _
    have j3 : Integrable (fun y => (((1 + e ^ 2)⁻¹) ^ 2 * P.c1 e ^ 2) *
