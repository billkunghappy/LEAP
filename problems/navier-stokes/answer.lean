  have gU : osbGood (Ioi 0 ×ˢ Ioo (-1) 1) (Icc a X₂ ×ˢ Ioo (-1) 1) (fun p : ℝ × ℝ => U p.1 p.2) :=
    ⟨hU, fun k => (hcomp a X₂ ha k).imp fun C hC z hz =>
      (hC z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).2⟩
  have g2 : osbGood (Ioi 0 ×ˢ Ioo (-1) 1) (Icc a X₂ ×ˢ Ioo (-1) 1)
      (fun p : ℝ × ℝ => 2 * p.1 * F p.1 p.2) :=
    gmulΩ _ _ (gmulΩ _ _ (gcoefΩ _ (by fun_prop)) (gcoefΩ _ (by fun_prop))) gF
  have g3 : osbGood (Ioi 0 ×ˢ Ioo (-1) 1) (Icc a X₂ ×ˢ Ioo (-1) 1)
      (fun p : ℝ × ℝ => U p.1 p.2 * (2 * p.1 * F p.1 p.2)) := gmulΩ _ _ gU g2
  have gFF : osbGood (Ioi 0 ×ˢ Ioo (-1) 1) (Icc a X₂ ×ˢ Ioo (-1) 1)
      (fun p : ℝ × ℝ => F p.1 p.2 ^ 2) :=
    good_congr _ _ _ _ hΩ hSa (gmulΩ _ _ gF gF) (fun z _ => sq _)
  have g4 : osbGood (Ioi 0 ×ˢ Ioo (-1) 1) (Icc a X₂ ×ˢ Ioo (-1) 1)
      (fun p : ℝ × ℝ => U p.1 p.2 ^ 2 - p.1 * F p.1 p.2 ^ 2) :=
    good_congr _ _ _ _ hΩ hSa
      (gaddΩ _ _ (gmulΩ _ _ gU gU) (gmulΩ _ _ (gcoefΩ (fun p => -p.1) (by fun_prop)) (gmulΩ _ _ gF gF)))
      (fun z _ => by ring)

  have hWa : IsOpen (Ioi a ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hSW : Icc X₁ X₂ ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi a ×ˢ Ioo (-1) 1 :=
    fun z hz => ⟨lt_of_lt_of_le haX hz.1.1, hz.2⟩
  have hWaΩ : Ioi a ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi 0 ×ˢ Ioo (-1) 1 := fun z hz => ⟨lt_trans ha hz.1, hz.2⟩
  have hFa : osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) (fun p : ℝ × ℝ => F p.1 p.2) :=
    ⟨hF.mono hWaΩ, fun k => (hcomp X₁ X₂ hX₁ k).imp fun C hC z hz =>
      (hC z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).1⟩
  have hUa : osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) (fun p : ℝ × ℝ => U p.1 p.2) :=
    ⟨hU.mono hWaΩ, fun k => (hcomp X₁ X₂ hX₁ k).imp fun C hC z hz =>
      (hC z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).2⟩
  have hFX := (good_partials _ _ F hWa hSW hFa).1
  have hUX := (good_partials _ _ U hWa hSW hUa).1
  have hI1 := rad U a X₁ X₂ ha ha1 haX gU hbU
  have hI2 := rad (fun x e => 2 * x * F x e) a X₁ X₂ ha ha1 haX g2 hb2F
  have hI3 := rad (fun x e => U x e * (2 * x * F x e)) a X₁ X₂ ha ha1 haX g3 hbU2F
  have hI4 := rad (fun x e => U x e ^ 2 - x * F x e ^ 2) a X₁ X₂ ha ha1 haX g4 hbU2
  have hPi := lpi a X₁ X₂ ha haX gFF hbF2
  have hdI1 := (good_partials _ _ _ hWa hSW hI1).2
  have hdI2 := (good_partials _ _ _ hWa hSW hI2).2
  have hdI3 := (good_partials _ _ _ hWa hSW hI3).2
  have hdI4 := (good_partials _ _ _ hWa hSW hI4).2
  have hdPi := (good_partials _ _ _ hWa hSW hPi).2

  have hV : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-2:ℝ) 2) := isOpen_Ioi.prod isOpen_Ioo
  have hLV : ∀ p : ℝ × ℝ, p ∈ Ioi (0:ℝ) ×ˢ Ioo (-2:ℝ) 2 → 0 < 1 - 2 * h * p.2 ^ 2 := by
    intro p hp
    have a1 : -2 < p.2 := hp.2.1
    have a2 : p.2 < 2 := hp.2.2
    have hsq : p.2 ^ 2 < 4 := by nlinarith
    nlinarith
  have gc : ∀ f : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ f (Ioi (0:ℝ) ×ˢ Ioo (-2:ℝ) 2) →
      osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) f :=
    fun f hf => good_coef _ (Icc X₁ X₂ ×ˢ Icc (-1) 1) _ _ f hV (isCompact_Icc.prod isCompact_Icc)
      (fun z hz => ⟨hz.1, hz.2.1.le, hz.2.2.le⟩)
      (fun z hz => ⟨lt_of_lt_of_le hX₁ hz.1.1, by linarith [hz.2.1], by linarith [hz.2.2]⟩)
      (fun z hz => ⟨lt_trans ha hz.1, by linarith [hz.2.1], by linarith [hz.2.2]⟩) hf
  have ga : ∀ f g : ℝ × ℝ → ℝ, osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) f →
      osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) g →
      osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) (fun z => f z + g z) :=
    fun f g => good_add _ _ f g hWa hSW
  have gm : ∀ f g : ℝ × ℝ → ℝ, osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) f →
      osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) g →
      osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) (fun z => f z * g z) :=
    fun f g => good_mul _ _ f g hWa hSW
  have cX : osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) (fun z : ℝ × ℝ => z.1) :=
    gc _ (by fun_prop)
  have cXi : osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) (fun z : ℝ × ℝ => z.1⁻¹) :=
    gc _ (by fun_prop (disch := (intro p hp; exact (show (0:ℝ) < p.1 from hp.1).ne')))
  have cLi : osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1)
      (fun z : ℝ × ℝ => (1 - 2 * h * z.2 ^ 2)⁻¹) :=
    gc _ (by fun_prop (disch := (intro p hp; exact (hLV p hp).ne')))
  have cS : osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1)
      (fun z : ℝ × ℝ => Real.sqrt (2 * z.1)) :=
    gc _ (by fun_prop (disch := (intro p hp; have h0 : (0:ℝ) < p.1 := hp.1; positivity)))
  have cSi : osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1)
      (fun z : ℝ × ℝ => (Real.sqrt (2 * z.1))⁻¹) :=
    gc _ (by fun_prop (disch := (intro p hp; have h0 : (0:ℝ) < p.1 := hp.1; positivity)))
  have cE : osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) (fun z : ℝ × ℝ => z.2) :=
    gc _ (by fun_prop)
  have cK : ∀ k : ℝ, osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) (fun _ : ℝ × ℝ => k) :=
    fun k => gc _ contDiffOn_const
  have cE2 : osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1)
      (fun z : ℝ × ℝ => 1 - z.2 ^ 2) := gc _ (by fun_prop)

  have hETh : osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) (fun z : ℝ × ℝ =>
      (-1 * (z.1 * (1 - 2 * h * z.2 ^ 2)⁻¹)) * (F z.1 z.2 * (1 + (-(1 - 2 * h) * z.2 * z.1⁻¹) *
        profRadInt U z.1 z.2 + (-1 * (1 - z.2 ^ 2) * z.1⁻¹) * profEtaD (profRadInt U) z.1 z.2)) +
      (1 / 2 * z.1⁻¹ * (1 - 2 * h * z.2 ^ 2)⁻¹) *
        ((1 - h) * profRadInt (fun x e => 2 * x * F x e) z.1 z.2 +
          (-(1 / 2 - h) * z.2) * profEtaD (profRadInt (fun x e => 2 * x * F x e)) z.1 z.2 +
          (-1 * (1 - z.2 ^ 2)) * profEtaD (profRadInt (fun x e => U x e * (2 * x * F x e))) z.1 z.2 +
          ((4 * h - 1) * z.2) * profRadInt (fun x e => U x e * (2 * x * F x e)) z.1 z.2) +
      (2 * z.1) * deriv (fun Y => F Y z.2) z.1) := by
    repeat
      first
      | exact hFa | exact hUa | exact hFX | exact hUX | exact hI1 | exact hI2
      | exact hI3 | exact hI4 | exact hPi | exact hdI1 | exact hdI2 | exact hdI3 | exact hdI4
      | exact hdPi | exact cX | exact cXi | exact cLi | exact cS | exact cSi | exact cE | exact cE2
      | exact cK _ | refine ga _ _ ?_ ?_ | refine gm _ _ ?_ ?_
  have hETz : osbGood (Ioi a ×ˢ Ioo (-1) 1) (Icc X₁ X₂ ×ˢ Ioo (-1) 1) (fun z : ℝ × ℝ =>
      (z.1 * (1 - 2 * h * z.2 ^ 2)⁻¹ * (Real.sqrt (2 * z.1))⁻¹) *
        (-1 * ((1 + (-(1 - 2 * h) * z.2 * z.1⁻¹) * profRadInt U z.1 z.2 +
            (-1 * (1 - z.2 ^ 2) * z.1⁻¹) * profEtaD (profRadInt U) z.1 z.2) * U z.1 z.2) +
          z.1⁻¹ * ((1 / 2 - h) * profRadInt U z.1 z.2 +
            (-(1 / 2 - h) * z.2) * profEtaD (profRadInt U) z.1 z.2 +
            (4 * h * z.2) * profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2) z.1 z.2 +
            (-1 * (1 - z.2 ^ 2)) * profEtaD (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2)) z.1 z.2) +
          (4 * (1 / 2 + h) * z.2) * leadPi F z.1 z.2 + (-1 * (1 - z.2 ^ 2)) * profEtaD (leadPi F) z.1 z.2) +
      Real.sqrt (2 * z.1) * deriv (fun Y => U Y z.2) z.1) := by
    repeat
      first
      | exact hFa | exact hUa | exact hFX | exact hUX | exact hI1 | exact hI2
      | exact hI3 | exact hI4 | exact hPi | exact hdI1 | exact hdI2 | exact hdI3 | exact hdI4
      | exact hdPi | exact cX | exact cXi | exact cLi | exact cS | exact cSi | exact cE | exact cE2
      | exact cK _ | refine ga _ _ ?_ ?_ | refine gm _ _ ?_ ?_

  have havg : ∀ X η : ℝ, X ≠ 0 → profRadAvg U X η = X⁻¹ * profRadInt U X η := by
    intro X η hX
    have := intervalIntegral.integral_comp_mul_right (a := 0) (b := 1) (fun x => U x η) hX
    simp only [zero_mul, one_mul, smul_eq_mul] at this
    simp only [profRadAvg, profRadInt]
    exact this
  have hdavg : ∀ X η : ℝ, X ≠ 0 →
      profEtaD (profRadAvg U) X η = X⁻¹ * profEtaD (profRadInt U) X η := by
    intro X η hX
    have hfun : (fun e => profRadAvg U X e) = fun e => X⁻¹ * profRadInt U X e :=
      funext fun e => havg X e hX
    show deriv (fun e => profRadAvg U X e) η = X⁻¹ * deriv (fun e => profRadInt U X e) η
    rw [hfun]
    exact congrFun (deriv_const_mul_field' (𝕜 := ℝ) (v := fun e => profRadInt U X e) X⁻¹) η
  have algTh : ∀ (X η f fx i1 di1 i2 di2 i3 di3 : ℝ), X ≠ 0 → f ≠ 0 →
      1 - 2 * h * η ^ 2 ≠ 0 →
      f * (X * (-(1 - 2 * (1 / 2 - h) * η * (X⁻¹ * i1) - (1 - η ^ 2) * (X⁻¹ * di1)) +
        ((1 - h) * i2 - (1 / 2 - h) * η * di2 - (1 - η ^ 2) * di3 + 2 * (h - (1 / 2 - h)) * η * i3) /
          (X * (2 * X * f))) / (1 - 2 * h * η ^ 2) - -2 * X * fx / f) =
      (-1 * (X * (1 - 2 * h * η ^ 2)⁻¹)) * (f * (1 + (-(1 - 2 * h) * η * X⁻¹) * i1 +
        (-1 * (1 - η ^ 2) * X⁻¹) * di1)) +
      (1 / 2 * X⁻¹ * (1 - 2 * h * η ^ 2)⁻¹) * ((1 - h) * i2 + (-(1 / 2 - h) * η) * di2 +
        (-1 * (1 - η ^ 2)) * di3 + ((4 * h - 1) * η) * i3) + (2 * X) * fx := by
    intro X η f fx i1 di1 i2 di2 i3 di3 hX hf hL
    field_simp
    ring
  have algTz : ∀ (X η f u ux i1 di1 i4 di4 pv dpv : ℝ), 0 < X → f ≠ 0 →
      1 - 2 * h * η ^ 2 ≠ 0 →
      f * (X * (-(1 - 2 * (1 / 2 - h) * η * (X⁻¹ * i1) - (1 - η ^ 2) * (X⁻¹ * di1)) * u +
        ((1 / 2 - h) * (i1 - η * di1) + 4 * h * η * i4 - (1 - η ^ 2) * di4) / X +
        4 * (1 / 2 + h) * η * pv - (1 - η ^ 2) * dpv) /
          ((1 - 2 * h * η ^ 2) * (Real.sqrt (2 * X) * f)) + Real.sqrt (2 * X) * ux / f) =
      (X * (1 - 2 * h * η ^ 2)⁻¹ * (Real.sqrt (2 * X))⁻¹) *
        (-1 * ((1 + (-(1 - 2 * h) * η * X⁻¹) * i1 + (-1 * (1 - η ^ 2) * X⁻¹) * di1) * u) +
          X⁻¹ * ((1 / 2 - h) * i1 + (-(1 / 2 - h) * η) * di1 + (4 * h * η) * i4 +
            (-1 * (1 - η ^ 2)) * di4) + (4 * (1 / 2 + h) * η) * pv + (-1 * (1 - η ^ 2)) * dpv) +
      Real.sqrt (2 * X) * ux := by
    intro X η f u ux i1 di1 i4 di4 pv dpv hX hf hL
    have hs : Real.sqrt (2 * X) ≠ 0 := (Real.sqrt_pos.2 (by linarith)).ne'
    have hX0 : X ≠ 0 := hX.ne'
    field_simp
    ring
  have hL1 : ∀ η : ℝ, -1 < η → η < 1 → 1 - 2 * h * η ^ 2 ≠ 0 := by
    intro η h1 h2
    have hsq : η ^ 2 < 1 := by nlinarith
    nlinarith
  have hTh := good_congr _ _ _ (fun p : ℝ × ℝ => leadStressTh h F U p.1 p.2) hWa hSW hETh (by
    rintro ⟨X, η⟩ ⟨hX, h1, h2⟩
    have hX0 : 0 < X := lt_trans ha hX
    have := algTh X η (F X η) (deriv (fun Y => F Y η) X) (profRadInt U X η)
      (profEtaD (profRadInt U) X η) (profRadInt (fun x e => 2 * x * F x e) X η)
      (profEtaD (profRadInt (fun x e => 2 * x * F x e)) X η)
      (profRadInt (fun x e => U x e * (2 * x * F x e)) X η)
      (profEtaD (profRadInt (fun x e => U x e * (2 * x * F x e))) X η) hX0.ne'
      (hFpos X η hX0 h1 h2).ne' (hL1 η h1 h2)
    show leadStressTh h F U X η = _
    simp only [leadStressTh, leadQs, leadW, shearA, havg X η hX0.ne', hdavg X η hX0.ne']
    exact this)
  have hTz := good_congr _ _ _ (fun p : ℝ × ℝ => leadStressTz h F U p.1 p.2) hWa hSW hETz (by
    rintro ⟨X, η⟩ ⟨hX, h1, h2⟩
    have hX0 : 0 < X := lt_trans ha hX
    have := algTz X η (F X η) (U X η) (deriv (fun Y => U Y η) X) (profRadInt U X η)
      (profEtaD (profRadInt U) X η) (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2) X η)
      (profEtaD (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2)) X η)
      (leadPi F X η) (profEtaD (leadPi F) X η) hX0
      (hFpos X η hX0 h1 h2).ne' (hL1 η h1 h2)
    show leadStressTz h F U X η = _
    simp only [leadStressTz, leadNs, leadW, shearB, havg X η hX0.ne', hdavg X η hX0.ne']
    exact this)
  obtain ⟨C1, hC1⟩ := hTh.2 m
  obtain ⟨C2, hC2⟩ := hTz.2 m
  refine ⟨max C1 C2, fun X η hX1 hX2 h1 h2 => ?_⟩
  have hmem : ((X, η) : ℝ × ℝ) ∈ Icc X₁ X₂ ×ˢ Ioo (-1:ℝ) 1 := ⟨⟨hX1, hX2⟩, h1, h2⟩
  exact ⟨(hC1 _ hmem).trans (le_max_left _ _), (hC2 _ hmem).trans (le_max_right _ _)⟩

theorem rfp_bump_facts : ContDiff ℝ 1 sigA → Continuous rfpBmp ∧ (∀ t : ℝ, 0 ≤ rfpBmp t ∧ rfpBmp t ≤ 1) ∧ (∀ t : ℝ, 3 / 20 ≤ |t| → rfpBmp t = 0) ∧ ∀ t : ℝ, |t| ≤ 3 / 40 → 1 / 4 ≤ rfpBmp t :=
by
  intro hσ
  have hσc : Continuous sigA := hσ.continuous
  have h01 : ∀ y : ℝ, 0 ≤ sigA y ∧ sigA y ≤ 1 := by
    intro y
    unfold sigA
    split_ifs with h1 h2
    · norm_num
    · norm_num
    · have ha := Real.exp_pos (-1 / y ^ 2)
      have hb := Real.exp_pos (-1 / (1 - y) ^ 2)
      refine ⟨by positivity, ?_⟩
      rw [div_le_one (by positivity)]
      linarith
  have hhalf : ∀ y : ℝ, 1 / 2 ≤ y → 1 / 2 ≤ sigA y := by
    intro y hy
    unfold sigA
    split_ifs with h1 h2
    · linarith
    · norm_num
    · push_neg at h1 h2
      have ha := Real.exp_pos (-1 / y ^ 2)
      have hb := Real.exp_pos (-1 / (1 - y) ^ 2)
      have hsq : (1 - y) ^ 2 ≤ y ^ 2 := by nlinarith
      have h1y : 0 < 1 - y := by linarith
      have hpos : 0 < (1 - y) ^ 2 := by positivity
      have hinv : 1 / y ^ 2 ≤ 1 / (1 - y) ^ 2 := one_div_le_one_div_of_le hpos hsq
      have hle : -1 / (1 - y) ^ 2 ≤ -1 / y ^ 2 := by
        rw [neg_div, neg_div]; linarith
      have hba := Real.exp_le_exp.mpr hle
      rw [le_div_iff₀ (by positivity)]
      linarith
  have hB : ∀ t : ℝ, rfpBmp t = sigA (1 + t / (3 / 20)) * sigA (1 - t / (3 / 20)) := by
    intro t; rfl
  refine ⟨?_, ?_, ?_, ?_⟩
  · have : rfpBmp = fun t => sigA (1 + t / (3 / 20)) * sigA (1 - t / (3 / 20)) := by
      funext t; exact hB t
    rw [this]
    exact (hσc.comp (continuous_const.add (continuous_id.div_const _))).mul
      (hσc.comp (continuous_const.sub (continuous_id.div_const _)))
  · intro t
    rw [hB]
    obtain ⟨hp0, hp1⟩ := h01 (1 + t / (3 / 20))
    obtain ⟨hq0, hq1⟩ := h01 (1 - t / (3 / 20))
    refine ⟨mul_nonneg hp0 hq0, ?_⟩
    calc sigA (1 + t / (3 / 20)) * sigA (1 - t / (3 / 20))
        ≤ 1 * sigA (1 - t / (3 / 20)) := mul_le_mul_of_nonneg_right hp1 hq0
      _ ≤ 1 := by linarith
  · intro t ht
    rw [hB]
    have e : t / (3 / 20) = 20 / 3 * t := by ring
    rw [e]
    rcases le_abs'.mp ht with h | h
    · have hz : sigA (1 + 20 / 3 * t) = 0 := by
        unfold sigA; rw [if_pos (by linarith)]
      rw [hz, zero_mul]
    · have hz : sigA (1 - 20 / 3 * t) = 0 := by
        unfold sigA; rw [if_pos (by linarith)]
      rw [hz, mul_zero]
  · intro t ht
    rw [hB]
    have e : t / (3 / 20) = 20 / 3 * t := by ring
    rw [e]
    obtain ⟨h1, h2⟩ := abs_le.mp ht
    have hp := hhalf (1 + 20 / 3 * t) (by linarith)
    have hq := hhalf (1 - 20 / 3 * t) (by linarith)
    nlinarith

theorem rfp_lam_window : ContDiff ℝ 1 sigA → ∀ P : RfpPar, RfpRegime P → Continuous (rfpLam P) ∧ (∀ y : ℝ, rfpY5 P.Md P.lam - 4 ≤ y → y ≤ rfpY5 P.Md P.lam → rfpLam P y = rfpLam P (rfpY5 P.Md P.lam) + (1 / 2 + P.lam) * (rfpY5 P.Md P.lam - y)) ∧ ∀ y : ℝ, y ≤ rfpY5 P.Md P.lam → 3 / 2 * y + rfpLam P y ≤ 3 / 2 * rfpY5 P.Md P.lam + rfpLam P (rfpY5 P.Md P.lam) + Real.log 2 - (1 - P.lam) * (rfpY5 P.Md P.lam - y) :=
by
  intro hσ P hP
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hP
  have hσc : Continuous sigA := hσ.continuous
  have sig0 : ∀ y : ℝ, y ≤ 0 → sigA y = 0 := by
    intro y hy; unfold sigA; simp [hy]
  have sig1 : ∀ y : ℝ, 1 ≤ y → sigA y = 1 := by
    intro y hy; unfold sigA; rw [if_neg (by linarith), if_pos hy]
  have sigR : ∀ y, 0 ≤ sigA y ∧ sigA y ≤ 1 := by
    intro y
    unfold sigA
    split_ifs with h1 h2
    · norm_num
    · norm_num
    · have ha := Real.exp_pos (-1 / y ^ 2)
      have hb := Real.exp_pos (-1 / (1 - y) ^ 2)
      constructor
      · positivity
      · rw [div_le_one (by positivity)]; linarith
  have sigInt : ∀ a b : ℝ, IntervalIntegrable sigA MeasureTheory.volume a b :=
    fun a b => hσc.intervalIntegrable a b
  have hSc : Continuous rfpSigI := by
    show Continuous (fun t => ∫ s in (0:ℝ)..t, sigA s)
    exact intervalIntegral.continuous_primitive sigInt 0
  have hdiff : ∀ a b : ℝ, rfpSigI b - rfpSigI a = ∫ s in a..b, sigA s := by
    intro a b
    exact intervalIntegral.integral_interval_sub_left (sigInt 0 b) (sigInt 0 a)
  have hS0 : ∀ t : ℝ, t ≤ 0 → rfpSigI t = 0 := by
    intro t ht
    have e : ∫ s in (0:ℝ)..t, sigA s = ∫ s in (0:ℝ)..t, (0:ℝ) :=
      intervalIntegral.integral_congr (fun s hs => by
        rw [Set.uIcc_of_ge ht] at hs; exact sig0 s hs.2)
    show ∫ s in (0:ℝ)..t, sigA s = 0
    rw [e]; simp
  have hD : ∀ a b : ℝ, a ≤ b → 0 ≤ rfpSigI b - rfpSigI a ∧ rfpSigI b - rfpSigI a ≤ b - a := by
    intro a b hab
    rw [hdiff]
    refine ⟨intervalIntegral.integral_nonneg hab (fun u _ => (sigR u).1), ?_⟩
    have h := intervalIntegral.integral_mono_on hab (sigInt a b)
      (intervalIntegrable_const (c := (1:ℝ)))
      (fun u _ => (sigR u).2)
    simpa using h
  have hS1 : ∀ t : ℝ, 1 ≤ t → rfpSigI t = rfpSigI 1 + (t - 1) := by
    intro t ht
    have e := hdiff 1 t
    have e2 : ∫ s in (1:ℝ)..t, sigA s = ∫ s in (1:ℝ)..t, (1:ℝ) :=
      intervalIntegral.integral_congr (fun s hs => by
        rw [Set.uIcc_of_le ht] at hs; exact sig1 s hs.1)
    rw [e2] at e
    simp at e
    linarith

  have eY5 : rfpY5 P.Md P.lam = rfpY4 P.Md P.lam + 60 + 30 * Real.log (1 / P.lam) := rfl
  have eY4 : rfpY4 P.Md P.lam = rfpY3 P.Md P.lam + 13 / P.lam := rfl
  have eY3 : rfpY3 P.Md P.lam = rfpY2 P.Md + 1 + 60 * Real.log (1 / P.lam) := rfl
  have eY2 : rfpY2 P.Md = Real.exp P.Md + 11 := rfl
  have eYb : rfpYb P.Md P.lam P.T1 P.Lh = rfpY5 P.Md P.lam + 2 + P.T1 + P.Lh + 3 := rfl
  have hL : 99 / 100 ≤ Real.log (1 / P.lam) := by
    have h := Real.one_sub_inv_le_log_of_pos (one_div_pos.mpr hl0)
    have e : (1 / P.lam)⁻¹ = P.lam := by rw [one_div, inv_inv]
    rw [e] at h
    linarith
  have h13 : 0 < 13 / P.lam := by positivity
  have hexp := Real.exp_pos P.Md
  have hl2 : P.lam ^ 2 ≤ 1 / 10000 := by nlinarith
  have hh1 : P.h ≤ 1 := by linarith
  have h1ρ : 0 < 1 - P.ρ := by linarith
  have hlogh : 0 ≤ Real.log (1 / P.h) := by
    apply Real.log_nonneg
    rw [le_div_iff₀ hh0]; linarith
  have hT0 : 0 ≤ P.T1 := by linarith

  have hτ : ∀ y : ℝ, tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) =
      1 - P.ρ * (1 - sigA ((y - rfpYb P.Md P.lam P.T1 P.Lh + 2) / 2)) := by
    intro y; unfold tailFac; rw [← Real.exp_sub, Real.log_exp]
  have hτ0 : ∀ y : ℝ, y ≤ rfpY5 P.Md P.lam →
      Real.log (tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) / (1 - P.ρ)) = 0 := by
    intro y hy
    have hs : sigA ((y - rfpYb P.Md P.lam P.T1 P.Lh + 2) / 2) = 0 :=
      sig0 _ (by rw [eYb]; linarith)
    rw [hτ, hs, sub_zero, mul_one, div_self h1ρ.ne', Real.log_one]
  have hΛE : ∀ y : ℝ, y ≤ rfpY5 P.Md P.lam → rfpLam P y = Real.log P.Pst + y / 10 - 3 / 5 * rfpSigI y
      - P.lam * rfpSigI (y - rfpY2 P.Md) - sigA ((y - rfpY4 P.Md P.lam) / 60) * Real.log 2 := by
    intro y hy
    unfold rfpLam
    rw [hτ0 y hy, hS0 (y - rfpY5 P.Md P.lam) (by linarith),
      hS0 (y - rfpY5 P.Md P.lam - 1 - P.T1) (by linarith)]
    ring
  have hσw : ∀ y : ℝ, rfpY5 P.Md P.lam - 4 ≤ y → sigA ((y - rfpY4 P.Md P.lam) / 60) = 1 := by
    intro y hy
    exact sig1 _ (by rw [eY5] at hy; rw [le_div_iff₀ (by norm_num)]; linarith)
  refine ⟨?_, ?_, ?_⟩
  · have hτc : Continuous (fun y => Real.log
        (tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) / (1 - P.ρ))) := by
      have hc : Continuous (fun y =>
          (1 - P.ρ * (1 - sigA ((y - rfpYb P.Md P.lam P.T1 P.Lh + 2) / 2))) / (1 - P.ρ)) := by
        fun_prop
      refine Continuous.log ?_ ?_
      · simp only [hτ]; exact hc
      · intro y
        rw [hτ]
        apply ne_of_gt
        apply div_pos _ h1ρ
        have := mul_nonneg hρ0.le (sigR ((y - rfpYb P.Md P.lam P.T1 P.Lh + 2) / 2)).1
        nlinarith
    have h1 : Continuous (fun y => Real.log P.Pst + y / 10 - 3 / 5 * rfpSigI y
        - P.lam * rfpSigI (y - rfpY2 P.Md)
        - (1 - P.lam) * rfpSigI (y - rfpY5 P.Md P.lam)
        + (1 - P.h) * rfpSigI (y - rfpY5 P.Md P.lam - 1 - P.T1)
        - sigA ((y - rfpY4 P.Md P.lam) / 60) * Real.log 2) := by
      fun_prop
    exact h1.add hτc
  · intro y hy1 hy2
    rw [hΛE y hy2, hΛE _ le_rfl, hσw y hy1, hσw (rfpY5 P.Md P.lam) (by linarith)]
    have a1 := hS1 y (by rw [eY5, eY4, eY3, eY2] at hy1; linarith)
    have a2 := hS1 (rfpY5 P.Md P.lam) (by rw [eY5, eY4, eY3, eY2]; linarith)
    have a3 := hS1 (y - rfpY2 P.Md) (by rw [eY5, eY4, eY3] at hy1; linarith)
    have a4 := hS1 (rfpY5 P.Md P.lam - rfpY2 P.Md) (by rw [eY5, eY4, eY3]; linarith)
    rw [a1, a2, a3, a4]
    ring
  · intro y hy
    rw [hΛE y hy, hΛE _ le_rfl, hσw (rfpY5 P.Md P.lam) (by linarith)]
    have d1 := (hD y (rfpY5 P.Md P.lam) hy).2
    have d2 := (hD (y - rfpY2 P.Md) (rfpY5 P.Md P.lam - rfpY2 P.Md) (by linarith)).2
    have m2 := mul_le_mul_of_nonneg_left d2 hl0.le
    have s0 := mul_nonneg (sigR ((y - rfpY4 P.Md P.lam) / 60)).1
      (Real.log_nonneg (by norm_num : (1:ℝ) ≤ 2))
    linarith

theorem rfp_psi_window : ∀ P : RfpPar, RfpRegime P → Continuous rfpBmp → (∀ t : ℝ, 0 ≤ rfpBmp t ∧ rfpBmp t ≤ 1) → (∀ t : ℝ, 3 / 20 ≤ |t| → rfpBmp t = 0) → (∀ t : ℝ, |t| ≤ 3 / 40 → 1 / 4 ≤ rfpBmp t) → (∀ y : ℝ, rfpY5 P.Md P.lam - 4 ≤ y → y ≤ rfpY5 P.Md P.lam → rfpLam P y = rfpLam P (rfpY5 P.Md P.lam) + (1 / 2 + P.lam) * (rfpY5 P.Md P.lam - y)) → rfpKa P = Real.exp (2 + 4 * P.lam) ∧ Continuous (rfpPsi P) ∧ (∀ y : ℝ, |rfpPsi P y| ≤ 8) ∧ (∀ y : ℝ, y ≤ rfpY5 P.Md P.lam - 4 → rfpPsi P y = 0) ∧ ∀ s : ℝ, rfpPsi P (rfpY5 P.Md P.lam + s) = rfpBmp (s + 3) - Real.exp (2 + 4 * P.lam) * rfpBmp (s + 1) :=
by
  intro P hP hbc hb01 hbsupp hblow hΛaff
  have hlam1 : P.lam ≤ 1 / 100 := hP.2.2.2.1
  have hKa : rfpKa P = Real.exp (2 + 4 * P.lam) := by
    unfold rfpKa
    generalize rfpY5 P.Md P.lam = y5 at hΛaff ⊢
    obtain ⟨g, hg⟩ : ∃ g : ℝ → ℝ,
        g = fun y => Real.exp (2 * rfpLam P y5 + (1 + 2 * P.lam) * (y5 - y)) := ⟨_, rfl⟩
    have hg_s : ∀ y, g y = Real.exp (2 * rfpLam P y5 + (1 + 2 * P.lam) * (y5 - y)) :=
      fun y => by rw [hg]
    have hgpos : ∀ y, 0 < g y := fun y => by rw [hg_s]; exact Real.exp_pos _
    have hgc : Continuous g := by rw [hg]; fun_prop
    have hloc : ∀ c y : ℝ, (c = 3 ∨ c = 1) →
        Real.exp (2 * rfpLam P y) * rfpBmp (y - y5 + c) = g y * rfpBmp (y - y5 + c) := by
      intro c y hc
      by_cases hb : rfpBmp (y - y5 + c) = 0
      · rw [hb, mul_zero, mul_zero]
      · have hlt : |y - y5 + c| < 3 / 20 := by
          by_contra h
          exact hb (hbsupp _ (not_lt.mp h))
        obtain ⟨h1, h2⟩ := abs_lt.mp hlt
        have hw := hΛaff y (by rcases hc with rfl | rfl <;> linarith)
          (by rcases hc with rfl | rfl <;> linarith)
        rw [hw, hg_s]
        congr 2
        ring
    have hN : (fun y => Real.exp (2 * rfpLam P y) * rfpBmp (y - y5 + 3)) =
        fun y => g y * rfpBmp (y - y5 + 3) := funext fun y => hloc 3 y (Or.inl rfl)
    have hD : (fun y => Real.exp (2 * rfpLam P y) * rfpBmp (y - y5 + 1)) =
        fun y => g y * rfpBmp (y - y5 + 1) := funext fun y => hloc 1 y (Or.inr rfl)
    have hshift : (∫ y, g y * rfpBmp (y - y5 + 3)) =
        Real.exp (2 + 4 * P.lam) * ∫ y, g y * rfpBmp (y - y5 + 1) := by
      have h := MeasureTheory.integral_sub_right_eq_self (μ := MeasureTheory.volume)
        (fun y => g y * rfpBmp (y - y5 + 3)) (2 : ℝ)
      rw [← h, ← MeasureTheory.integral_const_mul]
      congr 1
      funext x
      rw [hg_s, hg_s, ← mul_assoc, ← Real.exp_add]
      congr 2 <;> ring
    have hDpos : 0 < ∫ y, g y * rfpBmp (y - y5 + 1) := by
      have hcont : Continuous (fun y => g y * rfpBmp (y - y5 + 1)) := by fun_prop
      refine hcont.integral_pos_of_hasCompactSupport_nonneg_nonzero ?_ ?_ (x := y5 - 1) ?_
      · refine HasCompactSupport.intro (isCompact_Icc (a := y5 - 1 - 3 / 20) (b := y5 - 1 + 3 / 20)) ?_
        intro x hx
        have h320 : 3 / 20 ≤ |x - y5 + 1| := by
          rw [Set.mem_Icc, not_and_or, not_le, not_le] at hx
          rcases hx with h | h
          · rw [abs_of_neg (by linarith)]; linarith
          · rw [abs_of_pos (by linarith)]; linarith
        show g x * rfpBmp (x - y5 + 1) = 0
        rw [hbsupp _ h320, mul_zero]
      · intro x
        exact mul_nonneg (hgpos x).le (hb01 _).1
      · show g (y5 - 1) * rfpBmp (y5 - 1 - y5 + 1) ≠ 0
        rw [show y5 - 1 - y5 + 1 = (0:ℝ) by ring]
        exact mul_ne_zero (hgpos _).ne'
          (lt_of_lt_of_le (by norm_num) (hblow 0 (by norm_num))).ne'
    rw [hN, hD, hshift, mul_div_assoc, div_self hDpos.ne', mul_one]
  have hκ8 : Real.exp (2 + 4 * P.lam) ≤ 8 := by
    have he1 := Real.exp_one_lt_d9
    have he2 : Real.exp 2 = Real.exp 1 * Real.exp 1 := by rw [← Real.exp_add]; norm_num
    have hsplit : Real.exp (2 + 4 * P.lam) = Real.exp 2 * Real.exp (4 * P.lam) := Real.exp_add _ _
    have hm : Real.exp (4 * P.lam) * Real.exp (-(4 * P.lam)) = 1 := by
      rw [← Real.exp_add]; simp
    have hl := Real.add_one_le_exp (-(4 * P.lam))
    have hq : Real.exp (4 * P.lam) * (-(4 * P.lam) + 1) ≤ 1 := by
      have h := mul_le_mul_of_nonneg_left hl (Real.exp_pos (4 * P.lam)).le
      linarith
    have h4 : Real.exp (4 * P.lam) ≤ 25 / 24 := by
      nlinarith [mul_nonneg (Real.exp_pos (4 * P.lam)).le
        (by linarith : (0:ℝ) ≤ 1 / 25 - 4 * P.lam)]
    have h2 : Real.exp 2 < 739 / 100 := by rw [he2]; nlinarith [Real.exp_pos 1]
    have h5 := mul_le_mul h2.le h4 (Real.exp_pos _).le (by norm_num)
    rw [hsplit]; linarith
  have hκ0 : 0 < Real.exp (2 + 4 * P.lam) := Real.exp_pos _
  have hpsiF : rfpPsi P = fun y => rfpBmp (y - rfpY5 P.Md P.lam + 3) -
      Real.exp (2 + 4 * P.lam) * rfpBmp (y - rfpY5 P.Md P.lam + 1) := by
    funext y; unfold rfpPsi; rw [hKa]
  refine ⟨hKa, ?_⟩
  rw [hpsiF]
  clear hpsiF hKa
  generalize rfpY5 P.Md P.lam = y5
  generalize Real.exp (2 + 4 * P.lam) = κ at hκ8 hκ0 ⊢
  refine ⟨by fun_prop, ?_, ?_, ?_⟩
  · intro y
    show |rfpBmp (y - y5 + 3) - κ * rfpBmp (y - y5 + 1)| ≤ 8
    by_cases h : 3 / 20 ≤ |y - y5 + 3|
    · rw [hbsupp _ h]
      have hq := hb01 (y - y5 + 1)
      rw [abs_le]; constructor <;> nlinarith
    · push_neg at h
      have h2 := (abs_lt.mp h).2
      have h3 : 3 / 20 ≤ |y - y5 + 1| := by rw [abs_of_neg (by linarith)]; linarith
      rw [hbsupp _ h3, mul_zero, sub_zero]
      have hp := hb01 (y - y5 + 3)
      rw [abs_le]; constructor <;> linarith
  · intro y hy
    show rfpBmp (y - y5 + 3) - κ * rfpBmp (y - y5 + 1) = 0
    rw [hbsupp (y - y5 + 3) (by rw [abs_of_neg (by linarith)]; linarith),
      hbsupp (y - y5 + 1) (by rw [abs_of_neg (by linarith)]; linarith)]
    ring
  · intro s
    show rfpBmp (y5 + s - y5 + 3) - κ * rfpBmp (y5 + s - y5 + 1) =
      rfpBmp (s + 3) - κ * rfpBmp (s + 1)
    rw [show y5 + s - y5 + 3 = s + 3 by ring, show y5 + s - y5 + 1 = s + 1 by ring]

theorem rfp_low_mass : ∀ P : RfpPar, RfpRegime P → Continuous (rfpLam P) → (∀ y : ℝ, y ≤ rfpY5 P.Md P.lam → 3 / 2 * y + rfpLam P y ≤ 3 / 2 * rfpY5 P.Md P.lam + rfpLam P (rfpY5 P.Md P.lam) + Real.log 2 - (1 - P.lam) * (rfpY5 P.Md P.lam - y)) → IntervalIntegrable (fun x : ℝ => Real.sqrt (2 * x) * Real.exp (rfpLam P (Real.log x))) MeasureTheory.volume 0 (Real.exp (rfpY4 P.Md P.lam)) ∧ (∫ x in (0:ℝ)..Real.exp (rfpY4 P.Md P.lam), Real.sqrt (2 * x) * Real.exp (rfpLam P (Real.log x))) + (∫ y in rfpY4 P.Md P.lam..rfpY4 P.Md P.lam + 60, Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y)) ≤ P.lam ^ 29 * (Real.sqrt 2 * Real.exp (3 / 2 * rfpY5 P.Md P.lam + rfpLam P (rfpY5 P.Md P.lam))) :=
by

  have t_numeric : ∀ lam : ℝ, 0 < lam → lam ≤ 1 / 100 →
      2 / (1 - lam) * Real.exp (-((1 - lam) * (30 * Real.log (1 / lam)))) ≤ lam ^ 29 := by
    intro lam h0 h1
    have hinv : 0 < 1 / lam := by positivity
    have hL4 : 4 ≤ Real.log (1 / lam) := by
      rw [Real.le_log_iff_exp_le hinv]
      have he := Real.exp_one_lt_d9
      have hp := Real.exp_pos 1
      have h4 : Real.exp 4 = Real.exp 1 ^ 4 := by
        rw [← Real.exp_nat_mul]; norm_num
      have h100 : 100 ≤ 1 / lam := by rw [le_div_iff₀ h0]; linarith
      have : Real.exp 1 ^ 4 < 100 := by
        calc Real.exp 1 ^ 4 < 2.7182818286 ^ 4 := by gcongr
          _ < 100 := by norm_num
      linarith
    set L := Real.log (1 / lam) with hL
    have hexpL : Real.exp (-L) = lam := by
      rw [Real.exp_neg, hL, Real.exp_log hinv]; field_simp
    have hsplit : -((1 - lam) * (30 * L)) = ((29:ℕ):ℝ) * (-L) + (-((1 - 30 * lam) * L)) := by
      push_cast; ring
    have ht : 14 / 5 ≤ (1 - 30 * lam) * L := by nlinarith
    have hE1 := Real.add_one_le_exp ((1 - 30 * lam) * L)
    have hEm : Real.exp (-((1 - 30 * lam) * L)) * Real.exp ((1 - 30 * lam) * L) = 1 := by
      rw [← Real.exp_add]; simp
    have hEpos := Real.exp_pos (-((1 - 30 * lam) * L))
    have hE : Real.exp (-((1 - 30 * lam) * L)) ≤ 5 / 19 := by nlinarith
    rw [hsplit, Real.exp_add, Real.exp_nat_mul, hexpL]
    have hb : 0 < 1 - lam := by linarith
    rw [div_mul_eq_mul_div, div_le_iff₀ hb]
    have hl29 : 0 ≤ lam ^ 29 := by positivity
    nlinarith [mul_nonneg hl29 (by linarith : (0:ℝ) ≤ 1 - lam - 2 * Real.exp (-((1 - 30 * lam) * L)))]

  have t_window : ∀ (Λ : ℝ → ℝ) (a C β : ℝ), Continuous Λ → 0 < β →
      (∀ y : ℝ, a ≤ y → y ≤ a + 60 →
        Real.sqrt 2 * Real.exp (3 / 2 * y + Λ y) ≤ C * Real.exp (β * y)) →
      (∫ y in a..a + 60, Real.sqrt 2 * Real.exp (3 / 2 * y + Λ y)) ≤
        C / β * (Real.exp (β * (a + 60)) - Real.exp (β * a)) := by
    intro Λ a C β hΛ hβ h
    have h1 : (∫ y in a..a + 60, Real.sqrt 2 * Real.exp (3 / 2 * y + Λ y)) ≤
        ∫ y in a..a + 60, C * Real.exp (β * y) :=
      intervalIntegral.integral_mono_on (by linarith) (Continuous.intervalIntegrable (by fun_prop) _ _)
        (Continuous.intervalIntegrable (by fun_prop) _ _) (fun y hy => h y hy.1 hy.2)
    have h2 : (∫ y in a..a + 60, C * Real.exp (β * y)) =
        C / β * (Real.exp (β * (a + 60)) - Real.exp (β * a)) := by
      have hd : ∀ x ∈ Set.uIcc a (a + 60),
          HasDerivAt (fun t => C / β * Real.exp (β * t)) (C * Real.exp (β * x)) x := by
        intro x _
        have := (((hasDerivAt_id' x).const_mul β).exp).const_mul (C / β)
        convert this using 1
        field_simp
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hd
        (Continuous.intervalIntegrable (by fun_prop) _ _)]
      ring
    linarith

  have t_xpart : ∀ (Λ : ℝ → ℝ) (y4 C lam : ℝ), Continuous Λ → 0 < lam → lam < 1 →
      (∀ y : ℝ, y ≤ y4 → Real.sqrt 2 * Real.exp (3 / 2 * y + Λ y) ≤ C * Real.exp ((1 - lam) * y)) →
      IntervalIntegrable (fun x : ℝ => Real.sqrt (2 * x) * Real.exp (Λ (Real.log x)))
        MeasureTheory.volume 0 (Real.exp y4) ∧
      (∫ x in (0:ℝ)..Real.exp y4, Real.sqrt (2 * x) * Real.exp (Λ (Real.log x))) ≤
        C * Real.exp ((1 - lam) * y4) / (1 - lam) := by
    intro Λ y4 C lam hΛ h0 h1 h
    have hX : 0 < Real.exp y4 := Real.exp_pos _
    have hne : (-lam) ≠ 0 := by linarith
    have hpt : ∀ x ∈ Set.Icc (0:ℝ) (Real.exp y4),
        Real.sqrt (2 * x) * Real.exp (Λ (Real.log x)) ≤ C * x ^ (-lam) := by
      intro x hx
      rcases eq_or_lt_of_le hx.1 with hx0 | hx0
      · subst hx0
        simp [Real.zero_rpow hne]
      · have hy : Real.log x ≤ y4 := by
          rw [← Real.log_exp y4]; exact Real.log_le_log hx0 hx.2
        have hb := h (Real.log x) hy
        have hsq : Real.sqrt (2 * x) = Real.sqrt 2 * Real.exp (Real.log x / 2) := by
          rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2), Real.exp_half, Real.exp_log hx0]
        have e1 : Real.sqrt 2 * Real.exp (Real.log x / 2) * Real.exp (Λ (Real.log x)) =
            Real.sqrt 2 * Real.exp (3 / 2 * Real.log x + Λ (Real.log x)) *
              Real.exp (-Real.log x) := by
          rw [mul_assoc, ← Real.exp_add, mul_assoc, ← Real.exp_add]; congr 2; ring
        have e2 : C * x ^ (-lam) =
            C * Real.exp ((1 - lam) * Real.log x) * Real.exp (-Real.log x) := by
          rw [Real.rpow_def_of_pos hx0, mul_assoc, ← Real.exp_add]; congr 2; ring
        rw [hsq, e1, e2]
        exact mul_le_mul_of_nonneg_right hb (Real.exp_pos _).le
    have hrp : IntervalIntegrable (fun x : ℝ => x ^ (-lam)) MeasureTheory.volume 0 (Real.exp y4) :=
      intervalIntegral.intervalIntegrable_rpow' (by linarith)
    have hCi : IntervalIntegrable (fun x : ℝ => C * x ^ (-lam)) MeasureTheory.volume 0
        (Real.exp y4) := hrp.const_mul C
    have hmeas : Measurable (fun x : ℝ => Real.sqrt (2 * x) * Real.exp (Λ (Real.log x))) :=
      (Real.continuous_sqrt.measurable.comp (measurable_const.mul measurable_id)).mul
        (Real.measurable_exp.comp (hΛ.measurable.comp Real.measurable_log))
    have hgi : IntervalIntegrable (fun x : ℝ => Real.sqrt (2 * x) * Real.exp (Λ (Real.log x)))
        MeasureTheory.volume 0 (Real.exp y4) := by
      refine hCi.mono_fun' hmeas.aestronglyMeasurable ?_
      refine MeasureTheory.ae_restrict_of_forall_mem measurableSet_uIoc (fun x hx => ?_)
      rw [Set.uIoc_of_le hX.le] at hx
      beta_reduce
      rw [Real.norm_of_nonneg (by positivity)]
      exact hpt x ⟨hx.1.le, hx.2⟩
    refine ⟨hgi, ?_⟩
    have hm := intervalIntegral.integral_mono_on hX.le hgi hCi hpt
    rw [intervalIntegral.integral_const_mul, integral_rpow (Or.inl (by linarith)),
      Real.zero_rpow (by linarith : (-lam + 1) ≠ 0), ← Real.exp_mul] at hm
    rw [show y4 * (-lam + 1) = (1 - lam) * y4 by ring, show -lam + 1 = 1 - lam by ring,
      sub_zero] at hm
    calc _ ≤ _ := hm
      _ = _ := by ring

  intro P hP hΛc hEnv
  have hl0 : 0 < P.lam := hP.2.2.1
  have hl1 : P.lam ≤ 1 / 100 := hP.2.2.2.1
  have hy5 : rfpY5 P.Md P.lam = rfpY4 P.Md P.lam + 60 + 30 * Real.log (1 / P.lam) := rfl
  have hL0 : 0 ≤ Real.log (1 / P.lam) :=
    Real.log_nonneg (by rw [le_div_iff₀ hl0]; linarith)
  have hnum := t_numeric P.lam hl0 hl1
  generalize rfpY5 P.Md P.lam = y5 at hEnv hy5 ⊢
  generalize rfpY4 P.Md P.lam = y4 at hy5 ⊢
  generalize rfpLam P = Λ at hΛc hEnv ⊢
  generalize Real.log (1 / P.lam) = L at hy5 hL0 hnum
  generalize P.lam = lam at hl0 hl1 hEnv hnum ⊢
  obtain ⟨N5, hN5⟩ : ∃ N5 : ℝ, N5 = Real.sqrt 2 * Real.exp (3 / 2 * y5 + Λ y5) := ⟨_, rfl⟩
  obtain ⟨C, hC⟩ : ∃ C : ℝ, C = 2 * N5 * Real.exp (-((1 - lam) * y5)) := ⟨_, rfl⟩
  have hN5pos : 0 < N5 := by rw [hN5]; positivity
  have hdom : ∀ y : ℝ, y ≤ y5 →
      Real.sqrt 2 * Real.exp (3 / 2 * y + Λ y) ≤ C * Real.exp ((1 - lam) * y) := by
    intro y hy
    have h1 := hEnv y hy
    calc Real.sqrt 2 * Real.exp (3 / 2 * y + Λ y)
        ≤ Real.sqrt 2 * Real.exp (3 / 2 * y5 + Λ y5 + Real.log 2 - (1 - lam) * (y5 - y)) :=
          mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 h1) (Real.sqrt_nonneg _)
      _ = C * Real.exp ((1 - lam) * y) := by
          rw [show 3 / 2 * y5 + Λ y5 + Real.log 2 - (1 - lam) * (y5 - y) =
              3 / 2 * y5 + Λ y5 + Real.log 2 + (-((1 - lam) * y5)) + (1 - lam) * y by ring,
            Real.exp_add, Real.exp_add, Real.exp_add, Real.exp_log (by norm_num : (0:ℝ) < 2),
            hC, hN5]
          ring
  have hβ : 0 < 1 - lam := by linarith
  have hx := t_xpart Λ y4 C lam hΛc hl0 (by linarith) (fun y hy => hdom y (by linarith))
  have hw := t_window Λ y4 C (1 - lam) hΛc hβ (fun y _ hy => hdom y (by linarith))
  refine ⟨hx.1, ?_⟩
  have hE : Real.exp (-((1 - lam) * y5)) * Real.exp ((1 - lam) * (y4 + 60)) =
      Real.exp (-((1 - lam) * (30 * L))) := by
    rw [← Real.exp_add, hy5]; congr 1; ring
  rw [← hN5]
  calc _ ≤ C * Real.exp ((1 - lam) * y4) / (1 - lam) +
        C / (1 - lam) * (Real.exp ((1 - lam) * (y4 + 60)) - Real.exp ((1 - lam) * y4)) :=
        add_le_add hx.2 hw
    _ = N5 * (2 / (1 - lam) *
          (Real.exp (-((1 - lam) * y5)) * Real.exp ((1 - lam) * (y4 + 60)))) := by
        rw [hC]; field_simp; ring
    _ = N5 * (2 / (1 - lam) * Real.exp (-((1 - lam) * (30 * L)))) := by rw [hE]
    _ ≤ N5 * lam ^ 29 := mul_le_mul_of_nonneg_left hnum hN5pos.le
    _ = lam ^ 29 * N5 := by ring

theorem rfp_I_window_identity : ∀ P : RfpPar, RfpRegime P → Continuous (rfpLam P) → Continuous (rfpPsi P) → Continuous (rfpTh P) → (∀ y : ℝ, y ≤ rfpY5 P.Md P.lam - 4 → rfpPsi P y = 0) → IntervalIntegrable (fun x : ℝ => Real.sqrt (2 * x) * Real.exp (rfpLam P (Real.log x))) MeasureTheory.volume 0 (Real.exp (rfpY4 P.Md P.lam)) → ∀ (ca : ℝ → ℝ) (η : ℝ), (∫ x in (0:ℝ)..Real.exp (rfpY5 P.Md P.lam), 2 * x * rfpF { P with ca := ca } x η) = (1 + η ^ 2)⁻¹ * (∫ x in (0:ℝ)..Real.exp (rfpY4 P.Md P.lam), Real.sqrt (2 * x) * Real.exp (rfpLam P (Real.log x))) + (∫ y in rfpY4 P.Md P.lam..rfpY4 P.Md P.lam + 60, Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * ((1 + η ^ 2)⁻¹) ^ (rfpTh P y)) + (∫ y in rfpY4 P.Md P.lam + 60..rfpY5 P.Md P.lam - 4, Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y)) + ∫ y in rfpY5 P.Md P.lam - 4..rfpY5 P.Md P.lam, Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * Real.sqrt (1 + ca η * rfpPsi P y) :=
by
  intro P hP hΛc hψc hθc hψ0 hkint ca η
  have hlam0 : 0 < P.lam := hP.2.2.1
  have hlam1 : P.lam ≤ 1 / 100 := hP.2.2.2.1
  have hE : ∀ x, rfpF { P with ca := ca } x η = Real.exp (rfpLam P (Real.log x)) *
      ((1 + η ^ 2)⁻¹) ^ (rfpTh P (Real.log x)) * Real.sqrt (1 + ca η * rfpPsi P (Real.log x)) /
      Real.sqrt (2 * x) := fun x => rfl
  have hL : 1 - P.lam ≤ Real.log (1 / P.lam) := by
    have h := Real.one_sub_inv_le_log_of_pos (one_div_pos.mpr hlam0)
    have e : (1 / P.lam)⁻¹ = P.lam := by rw [one_div, inv_inv]
    rw [e] at h
    exact h
  have hy5 : rfpY5 P.Md P.lam = rfpY4 P.Md P.lam + 60 + 30 * Real.log (1 / P.lam) := rfl
  have hord : rfpY4 P.Md P.lam + 60 ≤ rfpY5 P.Md P.lam - 4 := by rw [hy5]; linarith
  have hth1 : ∀ y, y ≤ rfpY4 P.Md P.lam → rfpTh P y = 1 := by
    intro y hy
    show 1 - sigA ((y - rfpY4 P.Md P.lam) / 60) = 1
    have h1 : (y - rfpY4 P.Md P.lam) / 60 ≤ 0 :=
      div_nonpos_of_nonpos_of_nonneg (by linarith) (by norm_num)
    unfold sigA
    rw [if_pos h1]
    ring
  have hth0 : ∀ y, rfpY4 P.Md P.lam + 60 ≤ y → rfpTh P y = 0 := by
    intro y hy
    show 1 - sigA ((y - rfpY4 P.Md P.lam) / 60) = 0
    have h1 : 1 ≤ (y - rfpY4 P.Md P.lam) / 60 := by
      rw [le_div_iff₀ (by norm_num : (0:ℝ) < 60)]; linarith
    have h2 : ¬ ((y - rfpY4 P.Md P.lam) / 60 ≤ 0) := by linarith
    unfold sigA
    rw [if_neg h2, if_pos h1]
    ring
  have hf0 : (1 + η ^ 2)⁻¹ ≠ 0 := by positivity
  have key : ∀ t A : ℝ, 2 * t * (A / Real.sqrt (2 * t)) = Real.sqrt (2 * t) * A := by
    intro t A
    rw [show 2 * t * (A / Real.sqrt (2 * t)) = (2 * t / Real.sqrt (2 * t)) * A by ring,
      Real.div_sqrt]
  have hc1 : Continuous (fun y => Real.exp (rfpLam P y)) := Real.continuous_exp.comp hΛc
  have hc2 : Continuous (fun y => ((1 + η ^ 2)⁻¹) ^ (rfpTh P y)) :=
    (Real.continuous_const_rpow hf0).comp hθc
  have hc3 : Continuous (fun y => Real.sqrt (1 + ca η * rfpPsi P y)) := by fun_prop
  have hK := (hc1.mul hc2).mul hc3
  have hgc : ContinuousOn (fun x => 2 * x * rfpF { P with ca := ca } x η) (Set.Ioi 0) := by
    have hlog : ContinuousOn Real.log (Set.Ioi 0) :=
      Real.continuousOn_log.mono (fun x hx => Set.mem_compl_singleton_iff.mpr (ne_of_gt hx))
    have h4 : ContinuousOn (fun x : ℝ => Real.sqrt (2 * x)) (Set.Ioi 0) :=
      (Real.continuous_sqrt.comp (continuous_const.mul continuous_id)).continuousOn
    have h5 : ContinuousOn (fun x : ℝ => 2 * x) (Set.Ioi 0) :=
      (continuous_const.mul continuous_id).continuousOn
    have h6 := h5.mul ((hK.comp_continuousOn hlog).div h4
      (fun x hx => (Real.sqrt_pos.mpr (by have : (0:ℝ) < x := hx; linarith)).ne'))
    exact h6.congr (fun x _ => rfl)
  obtain ⟨H, hH⟩ : ∃ H : ℝ → ℝ, H = fun y => Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) *
      ((1 + η ^ 2)⁻¹) ^ (rfpTh P y) * Real.sqrt (1 + ca η * rfpPsi P y) := ⟨_, rfl⟩
  have hH_s : ∀ y, H y = Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) *
      ((1 + η ^ 2)⁻¹) ^ (rfpTh P y) * Real.sqrt (1 + ca η * rfpPsi P y) := fun y => by rw [hH]
  have hHc : Continuous H := by
    have hw : Continuous (fun y => Real.exp (3 / 2 * y + rfpLam P y)) := by fun_prop
    rw [hH]
    exact ((continuous_const.mul hw).mul hc2).mul hc3
  have hpt : ∀ y, (fun x => 2 * x * rfpF { P with ca := ca } x η) (Real.exp y) * Real.exp y =
      H y := by
    intro y
    show 2 * Real.exp y * rfpF { P with ca := ca } (Real.exp y) η * Real.exp y = H y
    rw [hH_s, hE, Real.log_exp, key, Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2), ← Real.exp_half]
    have e : Real.exp (3 / 2 * y + rfpLam P y) =
        Real.exp (y / 2) * Real.exp y * Real.exp (rfpLam P y) := by
      rw [← Real.exp_add, ← Real.exp_add]; congr 1; ring
    rw [e]
    ring
  have hX4 : 0 < Real.exp (rfpY4 P.Md P.lam) := Real.exp_pos _
  have hlow : Set.EqOn (fun x => 2 * x * rfpF { P with ca := ca } x η)
      (fun x => (1 + η ^ 2)⁻¹ * (Real.sqrt (2 * x) * Real.exp (rfpLam P (Real.log x))))
      (Set.uIcc 0 (Real.exp (rfpY4 P.Md P.lam))) := by
    intro x hx
    rw [Set.uIcc_of_le hX4.le] at hx
    rcases eq_or_lt_of_le hx.1 with h0 | hpos
    · subst h0; simp
    · have hlx : Real.log x ≤ rfpY4 P.Md P.lam := by
        rw [← Real.log_exp (rfpY4 P.Md P.lam)]; exact Real.log_le_log hpos hx.2
      show 2 * x * rfpF { P with ca := ca } x η = _
      rw [hE x, hth1 (Real.log x) hlx, hψ0 (Real.log x) (by linarith)]
      simp only [Real.rpow_one, mul_zero, add_zero, Real.sqrt_one, mul_one]
      rw [key]
      ring
  have hX45 : Real.exp (rfpY4 P.Md P.lam) ≤ Real.exp (rfpY5 P.Md P.lam) :=
    Real.exp_le_exp.mpr (by linarith)
  have hgint1 : IntervalIntegrable (fun x => 2 * x * rfpF { P with ca := ca } x η) volume 0
      (Real.exp (rfpY4 P.Md P.lam)) :=
    IntervalIntegrable.congr (hlow.symm.mono Set.uIoc_subset_uIcc) (hkint.const_mul _)
  have hgint2 : IntervalIntegrable (fun x => 2 * x * rfpF { P with ca := ca } x η) volume
      (Real.exp (rfpY4 P.Md P.lam)) (Real.exp (rfpY5 P.Md P.lam)) := by
    refine (hgc.mono ?_).intervalIntegrable
    rw [Set.uIcc_of_le hX45]
    intro x hx
    exact lt_of_lt_of_le hX4 hx.1
  have hsplit : (∫ x in (0:ℝ)..Real.exp (rfpY5 P.Md P.lam), 2 * x * rfpF { P with ca := ca } x η) =
      (∫ x in (0:ℝ)..Real.exp (rfpY4 P.Md P.lam), 2 * x * rfpF { P with ca := ca } x η) +
      ∫ x in Real.exp (rfpY4 P.Md P.lam)..Real.exp (rfpY5 P.Md P.lam),
        2 * x * rfpF { P with ca := ca } x η :=
    (intervalIntegral.integral_add_adjacent_intervals hgint1 hgint2).symm
  have hI1 : (∫ x in (0:ℝ)..Real.exp (rfpY4 P.Md P.lam), 2 * x * rfpF { P with ca := ca } x η) =
      (1 + η ^ 2)⁻¹ * ∫ x in (0:ℝ)..Real.exp (rfpY4 P.Md P.lam),
        Real.sqrt (2 * x) * Real.exp (rfpLam P (Real.log x)) := by
    rw [intervalIntegral.integral_congr hlow, intervalIntegral.integral_const_mul]
  have hsub : (∫ x in Real.exp (rfpY4 P.Md P.lam)..Real.exp (rfpY5 P.Md P.lam),
      2 * x * rfpF { P with ca := ca } x η) = ∫ y in rfpY4 P.Md P.lam..rfpY5 P.Md P.lam, H y := by
    have h := intervalIntegral.integral_comp_mul_deriv' (a := rfpY4 P.Md P.lam)
      (b := rfpY5 P.Md P.lam) (f := Real.exp) (f' := Real.exp)
      (g := fun x => 2 * x * rfpF { P with ca := ca } x η)
      (fun x _ => Real.hasDerivAt_exp x) Real.continuous_exp.continuousOn
      (hgc.mono (by rintro _ ⟨y, _, rfl⟩; exact Real.exp_pos y))
    refine h.symm.trans ?_
    exact intervalIntegral.integral_congr (fun y _ => hpt y)
  rw [hsplit, hI1, hsub]
  have hi : ∀ a b, IntervalIntegrable H volume a b := fun a b => hHc.intervalIntegrable a b
  generalize rfpY4 P.Md P.lam = y4 at hth1 hth0 hord ⊢
  generalize rfpY5 P.Md P.lam = y5 at hord hψ0 ⊢
  have hw1 : (∫ y in y4..y4 + 60, H y) = ∫ y in y4..y4 + 60,
      Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * ((1 + η ^ 2)⁻¹) ^ (rfpTh P y) := by
    apply intervalIntegral.integral_congr
    intro y hy
    rw [Set.uIcc_of_le (by linarith)] at hy
    show H y = _
    rw [hH_s, hψ0 y (by linarith [hy.2])]
    simp only [mul_zero, add_zero, Real.sqrt_one, mul_one]
  have hw2 : (∫ y in y4 + 60..y5 - 4, H y) = ∫ y in y4 + 60..y5 - 4,
      Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) := by
    apply intervalIntegral.integral_congr
    intro y hy
    rw [Set.uIcc_of_le hord] at hy
    show H y = _
    rw [hH_s, hψ0 y (by linarith [hy.2]), hth0 y (by linarith [hy.1])]
    simp only [Real.rpow_zero, mul_zero, add_zero, Real.sqrt_one, mul_one]
  have hw3 : (∫ y in y5 - 4..y5, H y) = ∫ y in y5 - 4..y5,
      Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * Real.sqrt (1 + ca η * rfpPsi P y) := by
    apply intervalIntegral.integral_congr
    intro y hy
    rw [Set.uIcc_of_le (by linarith)] at hy
    show H y = _
    rw [hH_s, hth0 y (by linarith [hy.1]), Real.rpow_zero, mul_one]
  rw [← intervalIntegral.integral_add_adjacent_intervals (hi y4 (y4 + 60)) (hi (y4 + 60) y5),
    ← intervalIntegral.integral_add_adjacent_intervals (hi (y4 + 60) (y5 - 4)) (hi (y5 - 4) y5),
    hw1, hw2, hw3]
  ring

theorem exp_param_interval_integral : ∀ (a b : ℝ) (w θ : ℝ → ℝ), Continuous w → Continuous θ → ContDiff ℝ ∞ (fun s : ℝ => ∫ y in a..b, w y * Real.exp (-(θ y * s))) ∧ ∀ s : ℝ, HasDerivAt (fun s : ℝ => ∫ y in a..b, w y * Real.exp (-(θ y * s))) (∫ y in a..b, -(θ y) * (w y * Real.exp (-(θ y * s)))) s :=
by
  intro a b w θ hw hθ

  have hder : ∀ v : ℝ → ℝ, Continuous v → ∀ s₀ : ℝ,
      HasDerivAt (fun s : ℝ => ∫ y in a..b, v y * Real.exp (-(θ y * s)))
        (∫ y in a..b, -(θ y) * (v y * Real.exp (-(θ y * s₀)))) s₀ := by
    intro v hv s₀
    obtain ⟨Cv, hCv⟩ :=
      (isCompact_uIcc (a := a) (b := b)).exists_bound_of_continuousOn hv.continuousOn
    obtain ⟨Cθ, hCθ⟩ :=
      (isCompact_uIcc (a := a) (b := b)).exists_bound_of_continuousOn hθ.continuousOn
    have hCv0 : 0 ≤ max Cv 0 := le_max_right _ _
    have hCθ0 : 0 ≤ max Cθ 0 := le_max_right _ _
    have hcontF : ∀ x : ℝ, Continuous (fun t => v t * Real.exp (-(θ t * x))) := by
      intro x; fun_prop
    have hcontF' : ∀ x : ℝ, Continuous (fun t => -(θ t) * (v t * Real.exp (-(θ t * x)))) := by
      intro x; fun_prop
    have hbound : ∀ t ∈ Set.uIoc a b, ∀ x ∈ Metric.ball s₀ 1,
        ‖-(θ t) * (v t * Real.exp (-(θ t * x)))‖ ≤
          max Cθ 0 * (max Cv 0 * Real.exp (max Cθ 0 * (|s₀| + 1))) := by
      intro t ht x hx
      have ht' : t ∈ Set.uIcc a b := Set.uIoc_subset_uIcc ht
      have h1 : |v t| ≤ max Cv 0 :=
        le_trans (by simpa [Real.norm_eq_abs] using hCv t ht') (le_max_left _ _)
      have h2 : |θ t| ≤ max Cθ 0 :=
        le_trans (by simpa [Real.norm_eq_abs] using hCθ t ht') (le_max_left _ _)
      have hx' : |x| ≤ |s₀| + 1 := by
        have hd : dist x s₀ < 1 := hx
        rw [Real.dist_eq] at hd
        have := abs_sub_abs_le_abs_sub x s₀
        linarith
      have h3 : Real.exp (-(θ t * x)) ≤ Real.exp (max Cθ 0 * (|s₀| + 1)) := by
        apply Real.exp_le_exp.mpr
        have e1 : -(θ t * x) ≤ |θ t * x| := neg_le_abs _
        rw [abs_mul] at e1
        have e2 : |θ t| * |x| ≤ max Cθ 0 * (|s₀| + 1) :=
          mul_le_mul h2 hx' (abs_nonneg _) hCθ0
        linarith
      rw [Real.norm_eq_abs, abs_mul, abs_neg, abs_mul, Real.abs_exp]
      exact mul_le_mul h2 (mul_le_mul h1 h3 (Real.exp_pos _).le hCv0) (by positivity) hCθ0
    have hdx : ∀ t x : ℝ, HasDerivAt (fun x => v t * Real.exp (-(θ t * x)))
        (-(θ t) * (v t * Real.exp (-(θ t * x)))) x := by
      intro t x
      have h : HasDerivAt (fun x => v t * Real.exp (-(θ t * x)))
          (v t * (Real.exp (-(θ t * x)) * -(θ t * 1))) x :=
        (((hasDerivAt_id' x).const_mul (θ t)).neg.exp).const_mul (v t)
      exact h.congr_deriv (by ring)
    have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (μ := MeasureTheory.volume) (a := a) (b := b)
      (F := fun x t => v t * Real.exp (-(θ t * x)))
      (F' := fun x t => -(θ t) * (v t * Real.exp (-(θ t * x))))
      (x₀ := s₀)
      (bound := fun _ => max Cθ 0 * (max Cv 0 * Real.exp (max Cθ 0 * (|s₀| + 1))))
      (Metric.ball_mem_nhds s₀ one_pos)
      (Filter.Eventually.of_forall (fun x => (hcontF x).aestronglyMeasurable))
      ((hcontF s₀).intervalIntegrable _ _)
      ((hcontF' s₀).aestronglyMeasurable)
      (MeasureTheory.ae_of_all _ (fun t ht x hx => hbound t ht x hx))
      intervalIntegrable_const
      (MeasureTheory.ae_of_all _ (fun t _ x _ => hdx t x))
    exact key.2

  have hstep : ∀ v : ℝ → ℝ, Continuous v → ∀ s : ℝ,
      HasDerivAt (fun s : ℝ => ∫ y in a..b, v y * Real.exp (-(θ y * s)))
        ((fun s : ℝ => ∫ y in a..b, (-(θ y) * v y) * Real.exp (-(θ y * s))) s) s := by
    intro v hv s
    refine (hder v hv s).congr_deriv ?_
    show _ = ∫ y in a..b, (-(θ y) * v y) * Real.exp (-(θ y * s))
    congr 1
    funext y
    ring
  have hnat : ∀ n : ℕ, ∀ v : ℝ → ℝ, Continuous v →
      ContDiff ℝ n (fun s : ℝ => ∫ y in a..b, v y * Real.exp (-(θ y * s))) := by
    intro n
    induction n with
    | zero =>
      intro v hv
      have hd : Differentiable ℝ (fun s : ℝ => ∫ y in a..b, v y * Real.exp (-(θ y * s))) :=
        fun s => (hstep v hv s).differentiableAt
      rw [Nat.cast_zero]
      exact contDiff_zero.mpr hd.continuous
    | succ n ih =>
      intro v hv
      have hd : Differentiable ℝ (fun s : ℝ => ∫ y in a..b, v y * Real.exp (-(θ y * s))) :=
        fun s => (hstep v hv s).differentiableAt
      have hderiv : deriv (fun s : ℝ => ∫ y in a..b, v y * Real.exp (-(θ y * s))) =
          (fun s : ℝ => ∫ y in a..b, (-(θ y) * v y) * Real.exp (-(θ y * s))) := by
        funext s; exact (hstep v hv s).deriv
      have hT : Continuous (fun y => -(θ y) * v y) := hθ.neg.mul hv
      have hih := ih (fun y => -(θ y) * v y) hT
      rw [show ((n + 1 : ℕ) : WithTop ℕ∞) = (n : WithTop ℕ∞) + 1 by push_cast; rfl]
      refine contDiff_succ_iff_deriv.mpr ⟨hd, fun h => absurd h (by simp), ?_⟩
      rw [hderiv]
      exact hih
  exact ⟨contDiff_infty.mpr (fun n => hnat n w hw), hder w hw⟩

theorem sqrt_param_interval_integral : ∀ (a b M : ℝ) (u v : ℝ → ℝ), 0 < M → Continuous u → Continuous v → (∀ s : ℝ, |v s| ≤ M) → ContDiffOn ℝ ∞ (fun c : ℝ => ∫ s in a..b, u s * (Real.sqrt (1 + c * v s) - 1)) (Ioo (-(1 / M)) (1 / M)) ∧ ∀ c : ℝ, -(1 / M) < c → c < 1 / M → HasDerivAt (fun c : ℝ => ∫ s in a..b, u s * (Real.sqrt (1 + c * v s) - 1)) (∫ s in a..b, u s * v s / (2 * Real.sqrt (1 + c * v s))) c :=
by
  intro a b M u v hM hu hv hvM

  have hpos : ∀ c : ℝ, -(1 / M) < c → c < 1 / M → ∀ s, 0 < 1 + c * v s := by
    intro c h1 h2 s
    have hc : |c| < 1 / M := abs_lt.mpr ⟨h1, h2⟩
    have hcM : |c| * M < 1 := by rwa [lt_div_iff₀ hM] at hc
    have hcv : |c * v s| ≤ |c| * M := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left (hvM s) (abs_nonneg _)
    have := neg_abs_le (c * v s)
    linarith

  have key : ∀ (p : ℝ) (w : ℝ → ℝ), Continuous w → ∀ c₀ : ℝ, -(1 / M) < c₀ → c₀ < 1 / M →
      HasDerivAt (fun c : ℝ => ∫ s in a..b, w s * (1 + c * v s) ^ p)
        (∫ s in a..b, p * w s * v s * (1 + c₀ * v s) ^ (p - 1)) c₀ := by
    intro p w hw c₀ h1 h2
    have hc : |c₀| < 1 / M := abs_lt.mpr ⟨h1, h2⟩
    have hcM : |c₀| * M < 1 := by rwa [lt_div_iff₀ hM] at hc
    obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = 1 - |c₀| * M := ⟨_, rfl⟩
    have hδpos : 0 < δ := by linarith
    obtain ⟨r, hr⟩ : ∃ r : ℝ, r = δ / (2 * M) := ⟨_, rfl⟩
    have hrpos : 0 < r := by rw [hr]; exact div_pos hδpos (by linarith)
    have hrM : r * M = δ / 2 := by rw [hr]; field_simp
    have hwin : ∀ x ∈ Metric.ball c₀ r, ∀ t, δ / 2 ≤ 1 + x * v t ∧ 1 + x * v t ≤ 2 := by
      intro x hx t
      have hx' : |x - c₀| < r := by rw [Metric.mem_ball, Real.dist_eq] at hx; exact hx
      have hxabs : |x| ≤ |c₀| + r := by
        have := abs_sub_abs_le_abs_sub x c₀
        linarith
      have hxv : |x * v t| ≤ (|c₀| + r) * M := by
        rw [abs_mul]
        exact mul_le_mul hxabs (hvM t) (abs_nonneg _) (by positivity)
      have hxv' : |x * v t| ≤ |c₀| * M + r * M := by rw [add_mul] at hxv; exact hxv
      have hab := abs_le.mp hxv'
      constructor <;> linarith [hab.1, hab.2]
    have hK : ∀ y : ℝ, δ / 2 ≤ y → y ≤ 2 → y ^ (p - 1) ≤ (δ / 2) ^ (p - 1) + (2 : ℝ) ^ (p - 1) := by
      intro y hy1 hy2
      have hA : 0 < (δ / 2) ^ (p - 1) := Real.rpow_pos_of_pos (by linarith) _
      have hB : 0 < (2 : ℝ) ^ (p - 1) := Real.rpow_pos_of_pos (by norm_num) _
      rcases le_total 0 (p - 1) with hq | hq
      · have := Real.rpow_le_rpow (by linarith) hy2 hq
        linarith
      · have := Real.rpow_le_rpow_of_nonpos (by linarith) hy1 hq
        linarith
    have hKpos : 0 ≤ (δ / 2) ^ (p - 1) + (2 : ℝ) ^ (p - 1) :=
      add_nonneg (Real.rpow_nonneg (by linarith) _) (Real.rpow_nonneg (by norm_num) _)
    have hball : Metric.ball c₀ r ∈ nhds c₀ := Metric.ball_mem_nhds c₀ hrpos
    have hmeas : ∀ x : ℝ, Measurable (fun t => w t * (1 + x * v t) ^ p) := fun x =>
      hw.measurable.mul ((measurable_const.add (measurable_const.mul hv.measurable)).pow_const p)
    have hmeas' : Measurable (fun t => p * w t * v t * (1 + c₀ * v t) ^ (p - 1)) :=
      ((measurable_const.mul hw.measurable).mul hv.measurable).mul
        ((measurable_const.add (measurable_const.mul hv.measurable)).pow_const (p - 1))
    have hpos0 : ∀ t, 0 < 1 + c₀ * v t := hpos c₀ h1 h2
    have hcont0 : Continuous (fun t => w t * (1 + c₀ * v t) ^ p) :=
      hw.mul ((continuous_const.add (continuous_const.mul hv)).rpow_const
        (fun t => Or.inl (hpos0 t).ne'))
    have hres := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (μ := volume) (a := a) (b := b)
      (F := fun x t => w t * (1 + x * v t) ^ p)
      (F' := fun x t => p * w t * v t * (1 + x * v t) ^ (p - 1))
      (bound := fun t => |p| * M * ((δ / 2) ^ (p - 1) + (2 : ℝ) ^ (p - 1)) * |w t|) hball
      (Filter.Eventually.of_forall (fun x => (hmeas x).aestronglyMeasurable))
      (hcont0.intervalIntegrable a b)
      hmeas'.aestronglyMeasurable
      (Filter.Eventually.of_forall (fun t _ x hx => by
        obtain ⟨hy1, hy2⟩ := hwin x hx t
        have hy0 : 0 ≤ (1 + x * v t) ^ (p - 1) := Real.rpow_nonneg (by linarith) _
        have hyK := hK _ hy1 hy2
        rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_mul, abs_of_nonneg hy0]
        have h1 : |p| * |w t| * |v t| ≤ |p| * |w t| * M :=
          mul_le_mul_of_nonneg_left (hvM t) (by positivity)
        calc |p| * |w t| * |v t| * (1 + x * v t) ^ (p - 1)
            ≤ |p| * |w t| * M * ((δ / 2) ^ (p - 1) + (2 : ℝ) ^ (p - 1)) :=
              mul_le_mul h1 hyK hy0 (by positivity)
          _ = |p| * M * ((δ / 2) ^ (p - 1) + (2 : ℝ) ^ (p - 1)) * |w t| := by ring))
      ((continuous_const.mul hw.abs).intervalIntegrable a b)
      (Filter.Eventually.of_forall (fun t _ x hx => by
        obtain ⟨hy1, _⟩ := hwin x hx t
        have hp : 0 < 1 + x * v t := by linarith
        have hd : HasDerivAt (fun y => 1 + y * v t) (v t) x := by
          convert ((hasDerivAt_id' x).mul_const (v t)).const_add 1 using 1
          ring
        have := (hd.rpow_const (p := p) (Or.inl hp.ne')).const_mul (w t)
        convert this using 1
        ring))
    exact hres.2

  have fam : ∀ (S : Set ℝ) (P : (ℝ → ℝ) → Prop), IsOpen S →
      (∀ f : ℝ → ℝ, P f → ∃ g : ℝ → ℝ, P g ∧ ∀ x ∈ S, HasDerivAt f (g x) x) →
      ∀ f : ℝ → ℝ, P f → ContDiffOn ℝ ∞ f S := by
    intro S P hS hcl
    have hn : ∀ n : ℕ, ∀ f : ℝ → ℝ, P f → ContDiffOn ℝ n f S := by
      intro n
      induction n with
      | zero =>
        intro f hf
        obtain ⟨g, _, hg⟩ := hcl f hf
        rw [Nat.cast_zero, contDiffOn_zero]
        exact fun x hx => (hg x hx).continuousAt.continuousWithinAt
      | succ n ih =>
        intro f hf
        obtain ⟨g, hgP, hg⟩ := hcl f hf
        rw [Nat.cast_succ, contDiffOn_succ_iff_deriv_of_isOpen hS]
        refine ⟨fun x hx => (hg x hx).differentiableAt.differentiableWithinAt, ?_, ?_⟩
        · intro h; simp at h
        · exact (ih g hgP).congr (fun x hx => (hg x hx).deriv)
    intro f hf
    exact contDiffOn_infty.mpr (fun n => hn n f hf)

  have hfun : (fun c : ℝ => ∫ s in a..b, u s * (Real.sqrt (1 + c * v s) - 1)) =
      fun c : ℝ => (∫ s in a..b, u s * (1 + c * v s) ^ (1 / 2 : ℝ)) - ∫ s in a..b, u s := by
    funext c
    have h1 : Continuous (fun s => u s * (1 + c * v s) ^ (1 / 2 : ℝ)) :=
      hu.mul ((continuous_const.add (continuous_const.mul hv)).rpow_const
        (fun _ => Or.inr (by norm_num)))
    rw [← intervalIntegral.integral_sub (h1.intervalIntegrable a b) (hu.intervalIntegrable a b)]
    refine intervalIntegral.integral_congr (fun s _ => ?_)
    rw [Real.sqrt_eq_rpow]
    ring
  have hderiv : ∀ c : ℝ, -(1 / M) < c → c < 1 / M →
      HasDerivAt (fun c : ℝ => ∫ s in a..b, u s * (Real.sqrt (1 + c * v s) - 1))
        (∫ s in a..b, u s * v s / (2 * Real.sqrt (1 + c * v s))) c := by
    intro c h1 h2
    rw [hfun]
    have := (key (1 / 2) u hu c h1 h2).sub_const (∫ s in a..b, u s)
    convert this using 1
    refine intervalIntegral.integral_congr (fun s _ => ?_)
    have hp := hpos c h1 h2 s
    have hsq : 0 < Real.sqrt (1 + c * v s) := Real.sqrt_pos.mpr hp
    have e : (1 + c * v s) ^ ((1 : ℝ) / 2 - 1) = (Real.sqrt (1 + c * v s))⁻¹ := by
      rw [show (1 : ℝ) / 2 - 1 = -(1 / 2) by norm_num, Real.rpow_neg hp.le, Real.sqrt_eq_rpow]
    rw [e]
    field_simp
  have hcd : ContDiffOn ℝ ∞ (fun c : ℝ => ∫ s in a..b, u s * (1 + c * v s) ^ (1 / 2 : ℝ))
      (Ioo (-(1 / M)) (1 / M)) := by
    refine fam (Ioo (-(1 / M)) (1 / M))
      (fun g => ∃ (p : ℝ) (w : ℝ → ℝ), Continuous w ∧
        g = fun c => ∫ s in a..b, w s * (1 + c * v s) ^ p) isOpen_Ioo ?_ _ ⟨1 / 2, u, hu, rfl⟩
    rintro g ⟨p, w, hw, rfl⟩
    refine ⟨_, ⟨p - 1, fun s => p * w s * v s, (continuous_const.mul hw).mul hv, rfl⟩, ?_⟩
    intro x hx
    exact key p w hw x hx.1 hx.2
  refine ⟨?_, hderiv⟩
  rw [hfun]
  exact hcd.sub contDiffOn_const

theorem bump_slope_bound : ∀ (b : ℝ → ℝ) (lam κ c : ℝ), Continuous b → (∀ t : ℝ, 0 ≤ b t ∧ b t ≤ 1) → (∀ t : ℝ, 3 / 20 ≤ |t| → b t = 0) → (∀ t : ℝ, |t| ≤ 3 / 40 → 1 / 4 ≤ b t) → 0 < lam → lam ≤ 1 / 100 → 7 ≤ κ → κ ≤ 8 → |c| ≤ 1 / 16 → (∫ s in (-4:ℝ)..0, Real.exp ((1 - lam) * s) * (b (s + 3) - κ * b (s + 1)) / (2 * Real.sqrt (1 + c * (b (s + 3) - κ * b (s + 1))))) ≤ -(1 / 40) :=
by
  intro b lam κ c hbc hb01 hbsupp hblow hlam0 hlam1 hκ7 hκ8 hc
  obtain ⟨hc1, hc2⟩ := abs_le.mp hc

  have he14 : Real.exp (-(14 / 5)) ≤ 1 / 12 := by
    have h1 := Real.exp_one_gt_d9
    have h2 := Real.add_one_le_exp (4 / 5 : ℝ)
    have hsplit : Real.exp (14 / 5) = Real.exp 1 * Real.exp 1 * Real.exp (4 / 5) := by
      rw [← Real.exp_add, ← Real.exp_add]; norm_num
    have h3 : (12 : ℝ) ≤ Real.exp (14 / 5) := by
      rw [hsplit]
      have h4 : (27 / 10 : ℝ) * (27 / 10) ≤ Real.exp 1 * Real.exp 1 :=
        mul_le_mul (by linarith) (by linarith) (by norm_num) (Real.exp_pos 1).le
      have h5 := mul_le_mul h4 (show (9 / 5 : ℝ) ≤ Real.exp (4 / 5) by linarith) (by norm_num)
        (by positivity)
      linarith
    have hm : Real.exp (-(14 / 5)) * Real.exp (14 / 5) = 1 := by
      rw [← Real.exp_add]; norm_num
    nlinarith [Real.exp_pos (-(14 / 5))]
  have he43 : 1 / 3 ≤ Real.exp (-(43 / 40)) := by
    have h1 := Real.exp_one_lt_d9
    have h2 := Real.add_one_le_exp (-(3 / 40) : ℝ)
    have hm : Real.exp (3 / 40) * Real.exp (-(3 / 40)) = 1 := by
      rw [← Real.exp_add]; norm_num
    have h3 : Real.exp (3 / 40) ≤ 40 / 37 := by
      nlinarith [Real.exp_pos (3 / 40)]
    have hsplit : Real.exp (43 / 40) = Real.exp 1 * Real.exp (3 / 40) := by
      rw [← Real.exp_add]; norm_num
    have h4 : Real.exp (43 / 40) ≤ 3 := by
      rw [hsplit]
      have := mul_le_mul h1.le h3 (Real.exp_pos _).le (by norm_num)
      linarith
    have hm2 : Real.exp (-(43 / 40)) * Real.exp (43 / 40) = 1 := by
      rw [← Real.exp_add]; norm_num
    nlinarith [Real.exp_pos (-(43 / 40)), Real.exp_pos (43 / 40)]

  have hpos : ∀ s : ℝ, 0 < 1 + c * (b (s + 3) - κ * b (s + 1)) := by
    intro s
    obtain ⟨h1, h2⟩ := hb01 (s + 3)
    obtain ⟨h3, h4⟩ := hb01 (s + 1)
    have hk0 : 0 ≤ κ * b (s + 1) := mul_nonneg (by linarith) h3
    have hk8 : κ * b (s + 1) ≤ 8 := by nlinarith
    rcases le_total 0 (b (s + 3) - κ * b (s + 1)) with hy | hy
    · nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ c + 1 / 16) hy]
    · nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ 1 / 16 - c) (by linarith : (0:ℝ) ≤ -(b (s + 3) - κ * b (s + 1)))]
  have hD : ∀ s : ℝ, 0 < 2 * Real.sqrt (1 + c * (b (s + 3) - κ * b (s + 1))) := by
    intro s
    have := Real.sqrt_pos.mpr (hpos s)
    linarith

  have hA : ∀ s : ℝ, 3 / 20 ≤ |s + 3| →
      Real.exp ((1 - lam) * s) * (b (s + 3) - κ * b (s + 1)) /
        (2 * Real.sqrt (1 + c * (b (s + 3) - κ * b (s + 1)))) ≤ 0 := by
    intro s hs
    rw [div_le_iff₀ (hD s), zero_mul, hbsupp _ hs]
    have h3 := (hb01 (s + 1)).1
    have hk0 : 0 ≤ κ * b (s + 1) := mul_nonneg (by linarith) h3
    have hE := Real.exp_pos ((1 - lam) * s)
    nlinarith

  have hB : ∀ s : ℝ, -(63 / 20) ≤ s → s ≤ -(57 / 20) →
      Real.exp ((1 - lam) * s) * (b (s + 3) - κ * b (s + 1)) /
        (2 * Real.sqrt (1 + c * (b (s + 3) - κ * b (s + 1)))) ≤ 8 / 15 * Real.exp (-(14 / 5)) := by
    intro s hs1 hs2
    rw [div_le_iff₀ (hD s)]
    have hb1 : b (s + 1) = 0 := hbsupp _ (by rw [abs_of_neg (by linarith)]; linarith)
    have hy := hpos s
    rw [hb1, mul_zero, sub_zero] at hy ⊢
    obtain ⟨h1, h2⟩ := hb01 (s + 3)
    have hr0 := Real.sqrt_nonneg (1 + c * b (s + 3))
    have hr2 := Real.sq_sqrt hy.le
    have hcy : -(1 / 16) ≤ c * b (s + 3) := by
      nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ c + 1 / 16) h1]
    have hr : 15 / 16 ≤ Real.sqrt (1 + c * b (s + 3)) := by
      nlinarith
    have hE : Real.exp ((1 - lam) * s) ≤ Real.exp (-(14 / 5)) := by
      apply Real.exp_le_exp.mpr
      nlinarith
    have hE0 := Real.exp_pos ((1 - lam) * s)
    have hE140 := Real.exp_pos (-(14 / 5))
    have k1 := mul_le_mul_of_nonneg_left h2 hE0.le
    have k2 := mul_le_mul_of_nonneg_left hr hE140.le
    nlinarith

  have hC : ∀ s : ℝ, -(43 / 40) ≤ s → s ≤ -(37 / 40) →
      Real.exp ((1 - lam) * s) * (b (s + 3) - κ * b (s + 1)) /
        (2 * Real.sqrt (1 + c * (b (s + 3) - κ * b (s + 1)))) ≤ -(4 / 5) * Real.exp (-(43 / 40)) := by
    intro s hs1 hs2
    rw [div_le_iff₀ (hD s)]
    have hb3 : b (s + 3) = 0 := hbsupp _ (by rw [abs_of_pos (by linarith)]; linarith)
    have hb1 : 1 / 4 ≤ b (s + 1) := hblow _ (abs_le.mpr ⟨by linarith, by linarith⟩)
    have hy := hpos s
    rw [hb3] at hy ⊢
    obtain ⟨h1, h2⟩ := hb01 (s + 1)
    have hz1 : 7 / 4 ≤ κ * b (s + 1) := by nlinarith
    have hz2 : κ * b (s + 1) ≤ 8 := by nlinarith
    have hr0 := Real.sqrt_nonneg (1 + c * (0 - κ * b (s + 1)))
    have hr2 := Real.sq_sqrt hy.le
    have hcz : 1 + c * (0 - κ * b (s + 1)) ≤ 1 + κ * b (s + 1) / 16 := by
      nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ c + 1 / 16) (by linarith : (0:ℝ) ≤ κ * b (s + 1))]
    have hr : Real.sqrt (1 + c * (0 - κ * b (s + 1))) ≤ 5 / 8 * (κ * b (s + 1)) := by
      nlinarith
    have hE : Real.exp (-(43 / 40)) ≤ Real.exp ((1 - lam) * s) := by
      apply Real.exp_le_exp.mpr
      nlinarith
    have hE0 := Real.exp_pos ((1 - lam) * s)
    have hE430 := Real.exp_pos (-(43 / 40))
    have k1 := mul_le_mul_of_nonneg_right hE (by linarith : (0:ℝ) ≤ κ * b (s + 1))
    have k2 := mul_le_mul_of_nonneg_left hr hE430.le
    nlinarith

  have hcont : Continuous (fun s : ℝ => Real.exp ((1 - lam) * s) * (b (s + 3) - κ * b (s + 1)) /
        (2 * Real.sqrt (1 + c * (b (s + 3) - κ * b (s + 1))))) := by
    apply Continuous.div
    · fun_prop
    · fun_prop
    · intro s; exact (hD s).ne'
  have hint : ∀ a a' : ℝ, IntervalIntegrable (fun s : ℝ => Real.exp ((1 - lam) * s) * (b (s + 3) - κ * b (s + 1)) /
        (2 * Real.sqrt (1 + c * (b (s + 3) - κ * b (s + 1))))) MeasureTheory.volume a a' :=
    fun a a' => hcont.intervalIntegrable a a'
  have piece : ∀ a a' C : ℝ, a ≤ a' → (∀ s ∈ Set.Icc a a', Real.exp ((1 - lam) * s) * (b (s + 3) - κ * b (s + 1)) /
        (2 * Real.sqrt (1 + c * (b (s + 3) - κ * b (s + 1)))) ≤ C) →
      (∫ s in a..a', Real.exp ((1 - lam) * s) * (b (s + 3) - κ * b (s + 1)) /
        (2 * Real.sqrt (1 + c * (b (s + 3) - κ * b (s + 1))))) ≤ (a' - a) * C := by
    intro a a' C hle h
    have := intervalIntegral.integral_mono_on hle (hint a a') intervalIntegrable_const h
    rw [intervalIntegral.integral_const, smul_eq_mul] at this
    exact this
  have p1 := piece (-4) (-(63 / 20)) 0 (by norm_num) (fun s hs => hA s (by
    rw [abs_of_nonpos (by linarith [hs.2])]; linarith [hs.2]))
  have p2 := piece (-(63 / 20)) (-(57 / 20)) _ (by norm_num) (fun s hs => hB s hs.1 hs.2)
  have p3 := piece (-(57 / 20)) (-(43 / 40)) 0 (by norm_num) (fun s hs => hA s (by
    rw [abs_of_nonneg (by linarith [hs.1])]; linarith [hs.1]))
  have p4 := piece (-(43 / 40)) (-(37 / 40)) _ (by norm_num) (fun s hs => hC s hs.1 hs.2)
  have p5 := piece (-(37 / 40)) 0 0 (by norm_num) (fun s hs => hA s (by
    rw [abs_of_nonneg (by linarith [hs.1])]; linarith [hs.1]))
  have e1 := intervalIntegral.integral_add_adjacent_intervals (hint (-4) (-(63 / 20))) (hint (-(63 / 20)) 0)
  have e2 := intervalIntegral.integral_add_adjacent_intervals (hint (-(63 / 20)) (-(57 / 20))) (hint (-(57 / 20)) 0)
  have e3 := intervalIntegral.integral_add_adjacent_intervals (hint (-(57 / 20)) (-(43 / 40))) (hint (-(43 / 40)) 0)
  have e4 := intervalIntegral.integral_add_adjacent_intervals (hint (-(43 / 40)) (-(37 / 40))) (hint (-(37 / 40)) 0)
  rw [← e1, ← e2, ← e3, ← e4]
  nlinarith

theorem rfp_I_reduction : ∀ P : RfpPar, RfpRegime P → ∃ (N5 : ℝ) (G δ : ℝ → ℝ), 0 < N5 ∧ ContDiffOn ℝ ∞ G (Ioo (-(1/8)) (1/8)) ∧ G 0 = 0 ∧ (∀ c : ℝ, -(1/16) ≤ c → c ≤ 1/16 → deriv G c ≤ -(1/40)) ∧ ContDiff ℝ ∞ δ ∧ δ 0 = 0 ∧ (∀ η : ℝ, 0 ≤ δ η ∧ δ η ≤ P.lam ^ 29 ∧ |deriv δ η| ≤ P.lam ^ 29) ∧ (∀ y : ℝ, |rfpPsi P y| ≤ 8) ∧ ∀ (ca : ℝ → ℝ) (η : ℝ), (∀ e : ℝ, |ca e| ≤ 1/16) → (∫ x in (0:ℝ)..Real.exp (rfpY5 P.Md P.lam), 2 * x * rfpF { P with ca := ca } x η) - (∫ x in (0:ℝ)..Real.exp (rfpY5 P.Md P.lam), 2 * x * rfpF { P with ca := ca } x 0) = N5 * (G (ca η) - G (ca 0) - δ η) :=
by
  intro P hP
  have hlam0 : 0 < P.lam := hP.2.2.1
  have hlam1 : P.lam ≤ 1 / 100 := hP.2.2.2.1
  have hσc : Continuous sigA := sigA_contDiff_one.continuous
  obtain ⟨hbc, hb01, hbsupp, hblow⟩ := rfp_bump_facts sigA_contDiff_one
  obtain ⟨hΛc, hΛaff, hΛenv⟩ := rfp_lam_window sigA_contDiff_one P hP
  obtain ⟨-, hψc, hψ8, hψ0, hψtr⟩ := rfp_psi_window P hP hbc hb01 hbsupp hblow hΛaff
  obtain ⟨hA0int, hmass⟩ := rfp_low_mass P hP hΛc hΛenv
  have hθc : Continuous (rfpTh P) := by
    show Continuous (fun y => 1 - sigA ((y - rfpY4 P.Md P.lam) / 60))
    exact continuous_const.sub (hσc.comp ((continuous_id.sub continuous_const).div_const _))
  have hσ01 : ∀ y, 0 ≤ sigA y ∧ sigA y ≤ 1 := by
    intro y
    unfold sigA
    split_ifs with h1 h2
    · norm_num
    · norm_num
    · have ha := Real.exp_pos (-1 / y ^ 2)
      have hb := Real.exp_pos (-1 / (1 - y) ^ 2)
      constructor
      · positivity
      · rw [div_le_one (by positivity)]; linarith
  have hθ01 : ∀ y, 0 ≤ rfpTh P y ∧ rfpTh P y ≤ 1 := by
    intro y
    have h := hσ01 ((y - rfpY4 P.Md P.lam) / 60)
    show 0 ≤ 1 - sigA ((y - rfpY4 P.Md P.lam) / 60) ∧ 1 - sigA ((y - rfpY4 P.Md P.lam) / 60) ≤ 1
    constructor <;> linarith [h.1, h.2]
  have hwin := rfp_I_window_identity P hP hΛc hψc hθc hψ0 hA0int
  have hwc : Continuous (fun y : ℝ => Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y)) := by
    fun_prop
  have hs6 := exp_param_interval_integral (rfpY4 P.Md P.lam) (rfpY4 P.Md P.lam + 60)
    (fun y : ℝ => Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y)) (rfpTh P) hwc hθc
  clear hψ0 hA0int hΛenv
  generalize rfpY4 P.Md P.lam = y4 at hwin hmass hs6
  generalize rfpY5 P.Md P.lam = y5 at hwin hmass hΛaff hψtr ⊢

  obtain ⟨A0, hA0def⟩ : ∃ A0 : ℝ, A0 = ∫ x in (0:ℝ)..Real.exp y4,
      Real.sqrt (2 * x) * Real.exp (rfpLam P (Real.log x)) := ⟨_, rfl⟩
  obtain ⟨N5, hN5def⟩ : ∃ N5 : ℝ, N5 = Real.sqrt 2 * Real.exp (3 / 2 * y5 + rfpLam P y5) :=
    ⟨_, rfl⟩
  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : ℝ → ℝ, Φ = fun s => ∫ y in y4..y4 + 60,
      Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * Real.exp (-(rfpTh P y * s)) := ⟨_, rfl⟩
  obtain ⟨Φd, hΦddef⟩ : ∃ Φd : ℝ → ℝ, Φd = fun s => ∫ y in y4..y4 + 60,
