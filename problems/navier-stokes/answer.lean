  have hidt : 2 * S * a * ((y 0 + σ * N2 * y 1 - σ * N1 * y 2) + s * (N2 * x 1 - N1 * x 2))
      + P * (2 * σ * s) * b ^ 2 + 2 * P * (1 + σ ^ 2) * b * (N1 * y 1 + N2 * y 2)
      = -(4 * P * S * a * b) - 2 * (E * ν) * Q - c * α
        + (2 * S * a * T1 + P * (2 * σ * s) * b ^ 2 + 2 * P * (1 + σ ^ 2) * b * T2) := by
    rw [hy0, hy1, hy2]
    subst hT1d hT2d hQ hαd hD0d hD1d hD2d ha hb hc hPd hSd
    linear_combination (-(4 * (2 * F0 * N1 + G0) * F0 * (x 0 + σ * N2 * x 1 - σ * N1 * x 2) * x 1
      + 2 * (-(2 * F0 * N1)) * (1 + σ ^ 2) * G0 * x 0 * (N1 * x 1 + N2 * x 2))) * hN

  have hSa0 : 0 ≤ S * a ^ 2 := mul_nonneg hS0.le (sq_nonneg a)
  have hPb0 : 0 ≤ P * b ^ 2 := mul_nonneg hP0.le (sq_nonneg b)
  have hσPb : 0 ≤ σ ^ 2 * (P * b ^ 2) := mul_nonneg (sq_nonneg σ) hPb0
  have hQe : Q = S * a ^ 2 + P * b ^ 2 + σ ^ 2 * (P * b ^ 2) := by rw [hQ]; ring
  have hQ0 : 0 ≤ Q := by linarith
  have hX0 : 0 ≤ X := by
    rw [hXx]; linarith [mul_self_nonneg (x 0), mul_self_nonneg (x 1), mul_self_nonneg (x 2)]
  have hδQ : 0 ≤ δ * Q := mul_nonneg hδ0.le hQ0
  have hδX : 0 ≤ δ * X := mul_nonneg hδ0.le hX0
  have hZ0 : 0 ≤ Z := by rw [hZ]; exact div_nonneg (sq_nonneg g) hδ0.le

  have ht2 : t ^ 2 = 1 + σ ^ 2 := by rw [ht]; exact Real.sq_sqrt (by positivity)
  have htpos : 0 < t := by rw [ht]; exact Real.sqrt_pos.mpr (by positivity)
  have hlam0 : 0 ≤ lam := by rw [hlam]; exact Real.sqrt_nonneg _
  have hlam2 : lam ^ 2 = P * S := by rw [hlam]; exact Real.sq_sqrt (mul_nonneg hP0.le hS0.le)
  have htne : t ≠ 0 := htpos.ne'
  have htu : t * u = lam := by rw [hu]; field_simp
  have key : t * S * (2 * u * Q + 4 * P * S * a * b) = 2 * lam * (S * a + lam * t * b) ^ 2 := by
    rw [hQ]
    linear_combination (2 * S * (S * a ^ 2 + P * (1 + σ ^ 2) * b ^ 2)) * htu
      + (-4 * S * t * a * b - 2 * lam * b ^ 2 * t ^ 2) * hlam2 + (-2 * lam * b ^ 2 * P * S) * ht2
  have hsq : 0 ≤ t * S * (2 * u * Q + 4 * P * S * a * b) := by
