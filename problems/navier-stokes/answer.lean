          Real.norm_eq_abs, abs_of_pos (hpos n)]
        have h1 : 1 / ((n : ℝ) + 1) ≤ 1 := by
          rw [div_le_one (by positivity)]
          linarith [(Nat.cast_nonneg n : (0:ℝ) ≤ n)]
        nlinarith
      have htend : Filter.Tendsto (fun n : ℕ => ((ε / 4 * (1 / ((n : ℝ) + 1)) : ℝ) : ℂ))
          Filter.atTop (nhdsWithin 0 {0}ᶜ) := by
        refine tendsto_nhdsWithin_iff.2 ⟨?_, Filter.Eventually.of_forall hne⟩
        have h0 : Filter.Tendsto (fun n : ℕ => ε / 4 * (1 / ((n : ℝ) + 1))) Filter.atTop
