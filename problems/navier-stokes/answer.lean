      have hp : (min 1 (Real.log (Xb / X))) ^ (-N') ≤
          (min 1 (Real.log (Xb / X))) ^ (-(max (max N1 N2) 0)) :=
        Real.rpow_le_rpow_of_exponent_ge hδ0 hδ1 (by linarith)
      have hp0 : 0 ≤ (min 1 (Real.log (Xb / X))) ^ (-N') := Real.rpow_nonneg hδ0.le _
      calc C' * Real.exp (-(4 / Real.log (Xb / X) ^ 2)) * (min 1 (Real.log (Xb / X))) ^ (-N')
          ≤ max (max C1 C2) (max C3 0) * Real.exp (-(4 / Real.log (Xb / X) ^ 2)) *
              (min 1 (Real.log (Xb / X))) ^ (-N') :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hC hW0) hp0
        _ ≤ _ := mul_le_mul_of_nonneg_left hp (mul_nonneg hM0 hW0)
    have hC1 : C1 ≤ max (max C1 C2) (max C3 0) := le_trans (le_max_left _ _) (le_max_left _ _)
    have hC2 : C2 ≤ max (max C1 C2) (max C3 0) := le_trans (le_max_right _ _) (le_max_left _ _)
    have hC3 : C3 ≤ max (max C1 C2) (max C3 0) := le_trans (le_max_left _ _) (le_max_right _ _)
    have hN1 : N1 ≤ max (max N1 N2) 0 := le_trans (le_max_left _ _) (le_max_left _ _)
    have hN2 : N2 ≤ max (max N1 N2) 0 := le_trans (le_max_right _ _) (le_max_left _ _)
    obtain ⟨d1, d2⟩ := hb3 X η hX.1 hX.2 h1 h2
    exact ⟨(hb1 X η hX.1 hX.2 h1 h2).trans (key C1 N1 hC1 hN1),
      (hb2 X η hX.1 hX.2 h1 h2).trans (key C2 N2 hC2 hN2), d1.trans hC3, d2.trans hC3⟩
  ·
    have hκ0 : 0 < min (min h (1 / 2)) (Real.sqrt 2 * cinf * Xb ^ (-h) / (8 * Xb)) :=
      lt_min (lt_min hh0 (by norm_num))
        (div_pos (mul_pos (mul_pos (Real.sqrt_pos.2 two_pos) hc0) (Real.rpow_pos_of_pos hXb0 _))
          (mul_pos (by norm_num) hXb0))
    have hκh : min (min h (1 / 2)) (Real.sqrt 2 * cinf * Xb ^ (-h) / (8 * Xb)) ≤ h :=
      (min_le_left _ _).trans (min_le_left _ _)
    have hκ12 : min (min h (1 / 2)) (Real.sqrt 2 * cinf * Xb ^ (-h) / (8 * Xb)) ≤ 1 / 2 :=
      (min_le_left _ _).trans (min_le_right _ _)
    have hκF : min (min h (1 / 2)) (Real.sqrt 2 * cinf * Xb ^ (-h) / (8 * Xb)) ≤
        Real.sqrt 2 * cinf * Xb ^ (-h) / (8 * Xb) := min_le_right _ _
    refine ⟨min (min h (1 / 2)) (Real.sqrt 2 * cinf * Xb ^ (-h) / (8 * Xb)), hκ0, by linarith, ?_⟩
    intro X hX η h1 h2
    obtain ⟨hA1, hA2, hB, hF⟩ := collar_shear_F_bounds h cinf ρ Xb F U hTF hρh hXb X η hX.1 hX.2 h1 h2
    have hX1 : Xb * Real.exp (-(11 / 4)) < X := lt_of_lt_of_le hXtl hX.1
    have hX0 : 0 < X := (hchart X hX1 hX.2).1
    have hM : ∀ s : ℝ, X ≤ s → s < Xb → tailEh h cinf s η ≤ 1 / 8 := by
      intro s hs1 hs2
      have hs : Xb * Real.exp (-(11 / 4)) ≤ s := hX1.le.trans hs1
      have e1 := (htail s η hs h1 h2).2.2
      have e2 := hsmall s η hs hs2 h1 h2
      have hf : 1 / 2 ≤ tailFac ρ Xb s := by
        have hsg := sigA_nonneg ((Real.log (s / Xb) + 2) / 2)
        unfold tailFac
        nlinarith [mul_nonneg hρ0' hsg]
      have e3 : tailEh h cinf s η * tailFac ρ Xb s = Real.sqrt (2 * s) * F s η := by
        unfold tailEh
        rw [e1]
      nlinarith
    obtain ⟨hT0, hTz⟩ := collar_ratio_bound h cinf ρ Xb X η (1 / 8) hh0 hh1 hc0 hρ0' hρ12 hX0 hX.2 h1 h2 hM
    rw [← collar_Tth_identity h cinf ρ Xb F U hTF X η hX1 h1 h2,
      ← collar_Tz_identity h cinf ρ Xb F U hTF X η hX1 h1 h2] at hTz
    rw [← collar_Tth_identity h cinf ρ Xb F U hTF X η hX1 h1 h2] at hT0
    have hb2 : leadStressTz h F U X η ^ 2 ≤ (leadStressTh h F U X η / 4) ^ 2 := by
      have := abs_le.1 hTz
      nlinarith
    have hS : Real.sqrt (leadStressTh h F U X η ^ 2 + leadStressTz h F U X η ^ 2) ≤
        2 * leadStressTh h F U X η := by
      calc Real.sqrt (leadStressTh h F U X η ^ 2 + leadStressTz h F U X η ^ 2)
          ≤ Real.sqrt ((2 * leadStressTh h F U X η) ^ 2) := Real.sqrt_le_sqrt (by nlinarith)
        _ = 2 * leadStressTh h F U X η := Real.sqrt_sq (by linarith)
    rw [hB, zero_div]
    have e0 : shearA F X η * (1 + (0:ℝ) ^ 2) - 2 = shearA F X η - 2 := by ring
    rw [e0]
    refine ⟨hκF.trans hF, by linarith, by linarith, ?_, ?_⟩
    · have := mul_le_mul_of_nonneg_right hκ12
        (Real.sqrt_nonneg (leadStressTh h F U X η ^ 2 + leadStressTz h F U X η ^ 2))
      nlinarith
    · nlinarith [mul_nonneg (show (0:ℝ) ≤ 4 - shearA F X η by linarith)
          (sq_nonneg (leadStressTz h F U X η)),
        mul_nonneg (show (0:ℝ) ≤ 1 / 2 - min (min h (1 / 2))
          (Real.sqrt 2 * cinf * Xb ^ (-h) / (8 * Xb)) by linarith) (sq_nonneg (leadStressTh h F U X η)),
        sq_nonneg (leadStressTh h F U X η)]
  ·
    intro m
    obtain ⟨C, N, hCN⟩ := flat_weight_transfer Xb 0 β8 hXb0 h8s
      (fun m => (hbd m).imp fun C hC p hp => (hC p hp).2.2.1) m
    refine ⟨C, N, fun X η hX1 hX2 h1 h2 => ?_⟩
    have hN := hΩo.mem_nhds (hcol X η hX1 hX2 h1 h2)
    rw [((Filter.eventuallyEq_of_mem hN hE8).iteratedFDeriv ℝ m).eq_of_nhds]
    exact hCN X η hX1 hX2 h1 h2

theorem profRadAvg_props : ∀ (g : ℝ → ℝ → ℝ) (ε : ℝ), 0 < ε → ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿(profRadAvg g)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ (∀ X₁ : ℝ, ∀ m : ℕ, (∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿g) (X, η)‖ ≤ C) → ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿(profRadAvg g)) (X, η)‖ ≤ C) ∧ (∀ X η : ℝ, -ε < X → -1 < η → η < 1 → X * profRadAvg g X η = profRadInt g X η ∧ HasDerivAt (fun Y => Y * profRadAvg g Y η) (g X η) X) :=
by
  have hIoc : uIoc (0:ℝ) 1 ⊆ Icc 0 1 := by
    rw [uIoc_of_le zero_le_one]; exact Ioc_subset_Icc_self

  have s1 : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (k : ℝ × (ℝ × ℝ) → F) (O : Set (ℝ × ℝ)) (V : Set (ℝ × (ℝ × ℝ))), IsOpen O → IsOpen V →
      Icc (0:ℝ) 1 ×ˢ O ⊆ V → ContDiffOn ℝ ∞ k V → ∀ p ∈ O,
      HasFDerivAt (fun q => ∫ s in (0:ℝ)..1, k (s, q))
        (∫ s in (0:ℝ)..1, (fderiv ℝ k (s, p)).comp (ContinuousLinearMap.inr ℝ ℝ (ℝ × ℝ))) p := by
    intro F _ _ _ k O V hO hV hsub hk p₀ hp₀
    obtain ⟨u, v, hu, hv, hIu, hpv, huv⟩ := generalized_tube_lemma isCompact_Icc
      (isCompact_singleton (x := p₀)) hV
      (fun z hz => hsub ⟨hz.1, by rw [mem_singleton_iff.mp hz.2]; exact hp₀⟩)
    obtain ⟨δ₀, hδ₀, hball⟩ := Metric.isOpen_iff.mp hv p₀ (hpv (mem_singleton p₀))
    have hδpos : 0 < δ₀ / 2 := by positivity
    have hT : Icc (0:ℝ) 1 ×ˢ Metric.closedBall p₀ (δ₀ / 2) ⊆ V := by
      intro z hz
      apply huv
      exact ⟨hIu hz.1, hball (Metric.closedBall_subset_ball (by linarith) hz.2)⟩
    have hTc : IsCompact (Icc (0:ℝ) 1 ×ˢ Metric.closedBall p₀ (δ₀ / 2)) :=
      isCompact_Icc.prod (isCompact_closedBall p₀ _)
    have hk'c : ContinuousOn
        (fun z => (fderiv ℝ k z).comp (ContinuousLinearMap.inr ℝ ℝ (ℝ × ℝ))) V :=
      (hk.continuousOn_fderiv_of_isOpen hV (by simp)).clm_comp continuousOn_const
    obtain ⟨B, hB⟩ := hTc.exists_bound_of_continuousOn (hk'c.mono hT)
    have hkc : ContinuousOn k V := hk.continuousOn
    have hderiv : ∀ t ∈ Icc (0:ℝ) 1, ∀ x ∈ Metric.ball p₀ (δ₀ / 2),
        HasFDerivAt (fun x => k (t, x))
          ((fderiv ℝ k (t, x)).comp (ContinuousLinearMap.inr ℝ ℝ (ℝ × ℝ))) x := by
      intro t ht x hx
      have hmem : (t, x) ∈ V := hT ⟨ht, Metric.ball_subset_closedBall hx⟩
      have hd : HasFDerivAt k (fderiv ℝ k (t, x)) (t, x) :=
        ((hk.differentiableOn (by simp)).differentiableAt (hV.mem_nhds hmem)).hasFDerivAt
      exact hd.comp x (hasFDerivAt_prodMk_right t x)
    have hcont_t : ∀ x ∈ Metric.closedBall p₀ (δ₀ / 2),
        ContinuousOn (fun t => k (t, x)) (Icc 0 1) := by
      intro x hx
      exact hkc.comp ((continuous_id.prodMk continuous_const :
        Continuous fun t : ℝ => (t, x)).continuousOn) (fun t ht => hT ⟨ht, hx⟩)
    have hcont'_t : ∀ x ∈ Metric.closedBall p₀ (δ₀ / 2),
        ContinuousOn (fun t => (fderiv ℝ k (t, x)).comp (ContinuousLinearMap.inr ℝ ℝ (ℝ × ℝ)))
          (Icc 0 1) := by
      intro x hx
      exact hk'c.comp ((continuous_id.prodMk continuous_const :
        Continuous fun t : ℝ => (t, x)).continuousOn) (fun t ht => hT ⟨ht, hx⟩)
    have hp₀c : p₀ ∈ Metric.closedBall p₀ (δ₀ / 2) := Metric.mem_closedBall_self hδpos.le
    refine intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ)
      (μ := volume) (s := Metric.ball p₀ (δ₀ / 2)) (bound := fun _ => B)
      (F := fun x t => k (t, x))
      (F' := fun x t => (fderiv ℝ k (t, x)).comp (ContinuousLinearMap.inr ℝ ℝ (ℝ × ℝ)))
      (Metric.ball_mem_nhds p₀ hδpos) ?_ ?_ ?_ ?_ intervalIntegrable_const ?_
    · filter_upwards [Metric.ball_mem_nhds p₀ hδpos] with x hx
      exact ((hcont_t x (Metric.ball_subset_closedBall hx)).mono hIoc).aestronglyMeasurable
        measurableSet_uIoc
    · exact (hcont_t p₀ hp₀c).intervalIntegrable_of_Icc zero_le_one
    · exact ((hcont'_t p₀ hp₀c).mono hIoc).aestronglyMeasurable measurableSet_uIoc
    · exact Filter.Eventually.of_forall
        (fun t ht x hx => hB (t, x) ⟨hIoc ht, Metric.ball_subset_closedBall hx⟩)
    · exact Filter.Eventually.of_forall (fun t ht x hx => hderiv t (hIoc ht) x hx)

  have s2 : ∀ n : ℕ, ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (k : ℝ × (ℝ × ℝ) → F) (O : Set (ℝ × ℝ)) (V : Set (ℝ × (ℝ × ℝ))), IsOpen O → IsOpen V →
      Icc (0:ℝ) 1 ×ˢ O ⊆ V → ContDiffOn ℝ ∞ k V →
      ContDiffOn ℝ n (fun p => ∫ s in (0:ℝ)..1, k (s, p)) O := by
    intro n
    induction n with
    | zero =>
      intro F _ _ _ k O V hO hV hsub hk
      rw [Nat.cast_zero, contDiffOn_zero]
      intro p hp
      exact (s1 k O V hO hV hsub hk p hp).continuousAt.continuousWithinAt
    | succ n ih =>
      intro F _ _ _ k O V hO hV hsub hk
      have hk' : ContDiffOn ℝ ∞
          (fun z => (fderiv ℝ k z).comp (ContinuousLinearMap.inr ℝ ℝ (ℝ × ℝ))) V :=
        (hk.fderiv_of_isOpen hV (by simp)).clm_comp contDiffOn_const
      have hD := ih _ O V hO hV hsub hk'
      rw [Nat.cast_succ, contDiffOn_succ_iff_fderiv_of_isOpen hO]
      refine ⟨fun p hp => (s1 k O V hO hV hsub hk p hp).differentiableAt.differentiableWithinAt,
        by simp, ?_⟩
      exact hD.congr (fun p hp => (s1 k O V hO hV hsub hk p hp).fderiv)

  have s3 : ∀ m : ℕ, ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (k : ℝ × (ℝ × ℝ) → F) (O : Set (ℝ × ℝ)) (V : Set (ℝ × (ℝ × ℝ))), IsOpen O → IsOpen V →
      Icc (0:ℝ) 1 ×ˢ O ⊆ V → ContDiffOn ℝ ∞ k V → ∀ (p : ℝ × ℝ) (C : ℝ), p ∈ O →
      (∀ s ∈ Icc (0:ℝ) 1, ‖iteratedFDeriv ℝ m (fun q => k (s, q)) p‖ ≤ C) →
      ‖iteratedFDeriv ℝ m (fun q => ∫ s in (0:ℝ)..1, k (s, q)) p‖ ≤ C := by
    intro m
    induction m with
    | zero =>
      intro F _ _ _ k O V hO hV hsub hk p C hp hC
      rw [norm_iteratedFDeriv_zero]
      have := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := 1) (C := C)
        (f := fun s => k (s, p)) (fun s hs => by
          have h := hC s (hIoc hs)
          rwa [norm_iteratedFDeriv_zero] at h)
      simpa using this
    | succ m ih =>
      intro F _ _ _ k O V hO hV hsub hk p C hp hC
      have hk' : ContDiffOn ℝ ∞
          (fun z => (fderiv ℝ k z).comp (ContinuousLinearMap.inr ℝ ℝ (ℝ × ℝ))) V :=
        (hk.fderiv_of_isOpen hV (by simp)).clm_comp contDiffOn_const
      rw [← norm_iteratedFDeriv_fderiv]
      have hev : fderiv ℝ (fun q => ∫ s in (0:ℝ)..1, k (s, q)) =ᶠ[nhds p]
          (fun q => ∫ s in (0:ℝ)..1,
            (fderiv ℝ k (s, q)).comp (ContinuousLinearMap.inr ℝ ℝ (ℝ × ℝ))) :=
        Filter.eventuallyEq_of_mem (hO.mem_nhds hp)
          (fun q hq => (s1 k O V hO hV hsub hk q hq).fderiv)
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
      refine ih _ O V hO hV hsub hk' p C hp ?_
      intro s hs
      have hN : IsOpen {q : ℝ × ℝ | (s, q) ∈ V} :=
        hV.preimage (continuous_const.prodMk continuous_id)
      have hpN : p ∈ {q : ℝ × ℝ | (s, q) ∈ V} := hsub ⟨hs, hp⟩
      have hev2 : fderiv ℝ (fun q => k (s, q)) =ᶠ[nhds p]
          (fun q => (fderiv ℝ k (s, q)).comp (ContinuousLinearMap.inr ℝ ℝ (ℝ × ℝ))) := by
        filter_upwards [hN.mem_nhds hpN] with q hq
        have hd : HasFDerivAt k (fderiv ℝ k (s, q)) (s, q) :=
          ((hk.differentiableOn (by simp)).differentiableAt (hV.mem_nhds hq)).hasFDerivAt
        exact (hd.comp q (hasFDerivAt_prodMk_right s q)).fderiv
      rw [← (hev2.iteratedFDeriv ℝ m).eq_of_nhds, norm_iteratedFDeriv_fderiv]
      exact hC s hs
  intro g ε hε hg
  have hO : IsOpen (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo

  have s4 : ∀ (m : ℕ) (s : ℝ) (p : ℝ × ℝ), 0 ≤ s → s ≤ 1 →
      (s * p.1, p.2) ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 →
      ‖iteratedFDeriv ℝ m (fun q : ℝ × ℝ => g (s * q.1) q.2) p‖ ≤
        ‖iteratedFDeriv ℝ m (↿g) (s * p.1, p.2)‖ := by
    intro m s p hs0 hs1 hp
    obtain ⟨L, hL⟩ : ∃ L : ℝ × ℝ →L[ℝ] ℝ × ℝ, ∀ q, L q = (s * q.1, q.2) :=
      ⟨(s • ContinuousLinearMap.fst ℝ ℝ ℝ).prod (ContinuousLinearMap.snd ℝ ℝ ℝ),
        fun q => by simp⟩
    have hfun : (fun q : ℝ × ℝ => g (s * q.1) q.2) = (↿g) ∘ L := by
      funext q
      show g (s * q.1) q.2 = ↿g (L q)
      rw [hL]
      rfl
    have hW : IsOpen (L ⁻¹' (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1)) := hO.preimage L.continuous
    have hLp : L p ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 := by rw [hL]; exact hp
    have hcomp := L.iteratedFDerivWithin_comp_right hg hO.uniqueDiffOn hW.uniqueDiffOn
      (x := p) hLp (i := m) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen m hW hLp,
      iteratedFDerivWithin_of_isOpen m hO hLp] at hcomp
    have hLnorm : ‖L‖ ≤ 1 := by
      refine ContinuousLinearMap.opNorm_le_bound L zero_le_one (fun q => ?_)
      rw [hL, one_mul]
      simp only [Prod.norm_def, Real.norm_eq_abs]
      refine max_le_max ?_ le_rfl
      rw [abs_mul, abs_of_nonneg hs0]
      exact mul_le_of_le_one_left (abs_nonneg _) hs1
    rw [hfun, hcomp, ← hL p]
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    exact mul_le_of_le_one_right (norm_nonneg _)
      (by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
          exact pow_le_one₀ (norm_nonneg _) hLnorm)

  have s5 : ∀ X η : ℝ, -ε < X → -1 < η → η < 1 → X * profRadAvg g X η = profRadInt g X η ∧
      HasDerivAt (fun Y => Y * profRadAvg g Y η) (g X η) X := by
    intro X η hX hη1 hη2
    have hid : ∀ Y : ℝ, Y * profRadAvg g Y η = ∫ x in (0:ℝ)..Y, g x η := by
      intro Y
      by_cases hY : Y = 0
      · subst hY; simp
      · unfold profRadAvg
        have := intervalIntegral.integral_comp_mul_right (fun x => g x η) hY (a := 0) (b := 1)
        simp only [zero_mul, one_mul, smul_eq_mul] at this
        rw [this, mul_inv_cancel_left₀ hY]
    have hfeq : (fun Y => Y * profRadAvg g Y η) = fun Y => ∫ x in (0:ℝ)..Y, g x η := funext hid
    refine ⟨hid X, ?_⟩
    have hφ : ContinuousOn (fun x => g x η) (Ioi (-ε)) :=
      hg.continuousOn.comp ((continuous_id.prodMk continuous_const :
        Continuous fun x : ℝ => (x, η)).continuousOn) (fun x hx => ⟨hx, hη1, hη2⟩)
    rw [hfeq]
    apply intervalIntegral.integral_hasDerivAt_right
    · apply ContinuousOn.intervalIntegrable
      refine hφ.mono (fun y hy => ?_)
      rw [mem_uIcc] at hy
      show -ε < y
      rcases hy with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> linarith
    · exact hφ.stronglyMeasurableAtFilter isOpen_Ioi X hX
    · exact hφ.continuousAt (isOpen_Ioi.mem_nhds hX)

  have hφc : ContDiff ℝ ∞ (fun z : ℝ × (ℝ × ℝ) => (z.1 * z.2.1, z.2.2)) :=
    (contDiff_fst.mul (contDiff_fst.comp contDiff_snd)).prodMk (contDiff_snd.comp contDiff_snd)
  have hV : IsOpen ((fun z : ℝ × (ℝ × ℝ) => (z.1 * z.2.1, z.2.2)) ⁻¹'
      (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1)) := hO.preimage hφc.continuous
  have hk : ContDiffOn ℝ ∞ (fun z : ℝ × (ℝ × ℝ) => g (z.1 * z.2.1) z.2.2)
      ((fun z : ℝ × (ℝ × ℝ) => (z.1 * z.2.1, z.2.2)) ⁻¹' (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1)) :=
    hg.comp hφc.contDiffOn (mapsTo_preimage _ _)
  have htube : Icc (0:ℝ) 1 ×ˢ (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) ⊆
      (fun z : ℝ × (ℝ × ℝ) => (z.1 * z.2.1, z.2.2)) ⁻¹' (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
    rintro ⟨s, X, η⟩ ⟨⟨hs0, hs1⟩, hX, hη⟩
    refine ⟨?_, hη⟩
    show -ε < s * X
    have hX' : -ε < X := hX
    rcases le_or_gt 0 X with h | h
    · have := mul_nonneg hs0 h; linarith
    · nlinarith [mul_nonneg (sub_nonneg.mpr hs1) (neg_nonneg.mpr h.le)]
  have hS : (↿(profRadAvg g)) = fun p : ℝ × ℝ => ∫ s in (0:ℝ)..1,
      (fun z : ℝ × (ℝ × ℝ) => g (z.1 * z.2.1) z.2.2) (s, p) := rfl
  refine ⟨?_, ?_, s5⟩
  · rw [hS]
    exact contDiffOn_infty.mpr (fun n => s2 n _ _ _ hO hV htube hk)
  · rintro X₁ m ⟨C, hC⟩
    refine ⟨C, fun X η hX hX1 hη1 hη2 => ?_⟩
    rw [hS]
    have hεX : -ε < X := by linarith
    refine s3 m _ _ _ hO hV htube hk (X, η) C ⟨hεX, hη1, hη2⟩ ?_
    intro s hs
    have hsX : 0 ≤ s * X := mul_nonneg hs.1 hX
    have hmem : (s * X, η) ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 :=
      ⟨show -ε < s * X by linarith, hη1, hη2⟩
    refine (s4 m s (X, η) hs.1 hs.2 hmem).trans ?_
    exact hC _ _ hsX ((mul_le_of_le_one_left hX hs.2).trans hX1) hη1 hη2

theorem outer_stress_smooth : ∀ (h : ℝ) (F U : ℝ → ℝ → ℝ), 0 < h → h < 1 / 100 → ContDiffOn ℝ ∞ (↿F) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿U) (Ioi 0 ×ˢ Ioo (-1) 1) → (∀ X η : ℝ, 0 < X → -1 < η → η < 1 → 0 < F X η) → (∀ m : ℕ, ∃ C : ℝ, ∀ x η : ℝ, 0 < x → -1 < η → η < 1 → |iteratedDeriv m (fun e => F x e) η| ≤ C * x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)) ∧ |iteratedDeriv m (fun e => U x e) η| ≤ C) → ContDiffOn ℝ ∞ (↿(leadStressTh h F U)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(leadStressTz h F U)) (Ioi 0 ×ˢ Ioo (-1) 1) :=
by
  intro h F U hh0 hh1 hF hU hFpos hb
  have hΩ : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo

  have s1aux : ∀ H : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ H (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (fun p => fderiv ℝ H p (0, 1)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
      ContDiffOn ℝ ∞ (fun p => fderiv ℝ H p (1, 0)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
      ∀ X η : ℝ, 0 < X → -1 < η → η < 1 →
        HasDerivAt (fun e => H (X, e)) (fderiv ℝ H (X, η) (0, 1)) η ∧
        HasDerivAt (fun Y => H (Y, η)) (fderiv ℝ H (X, η) (1, 0)) X := by
    intro H hH
    have hd := hH.fderiv_of_isOpen hΩ (m := ∞) (by simp)
    refine ⟨hd.clm_apply contDiffOn_const, hd.clm_apply contDiffOn_const, ?_⟩
    intro X η hX h1 h2
    have hp : (X, η) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := ⟨hX, h1, h2⟩
    have hdiff : DifferentiableAt ℝ H (X, η) :=
      (hH.contDiffAt (hΩ.mem_nhds hp)).differentiableAt (by simp)
    constructor
    · have := hdiff.hasFDerivAt.comp_hasDerivAt η ((hasDerivAt_const η X).prodMk (hasDerivAt_id η))
      exact this
    · have := hdiff.hasFDerivAt.comp_hasDerivAt X ((hasDerivAt_id X).prodMk (hasDerivAt_const X η))
      exact this
  have s1 : ∀ G : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿G) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => deriv (fun Y => G Y p.2) p.1) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => deriv (fun e => G p.1 e) p.2) (Ioi 0 ×ˢ Ioo (-1) 1) ∧
      ∀ m : ℕ, ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => iteratedDeriv m (fun e => G p.1 e) p.2)
          (Ioi 0 ×ˢ Ioo (-1) 1) ∧
        ∀ X η : ℝ, 0 < X → -1 < η → η < 1 →
          HasDerivAt (fun e => iteratedDeriv m (fun e' => G X e') e)
            (iteratedDeriv (m + 1) (fun e => G X e) η) η := by
    intro G hG
    obtain ⟨a2, a1, ad⟩ := s1aux (↿G) hG
    refine ⟨a1.congr ?_, a2.congr ?_, ?_⟩
    · rintro ⟨X, η⟩ ⟨hX, h1, h2⟩
      exact (ad X η hX h1 h2).2.deriv
    · rintro ⟨X, η⟩ ⟨hX, h1, h2⟩
      exact (ad X η hX h1 h2).1.deriv
    have ex : ∀ m : ℕ, ∃ K : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ K (Ioi 0 ×ˢ Ioo (-1) 1) ∧
        ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → iteratedDeriv m (fun e => G X e) η = K (X, η) := by
      intro m
      induction m with
      | zero => exact ⟨↿G, hG, fun X η _ _ _ => by simp only [iteratedDeriv_zero]; rfl⟩
      | succ m ih =>
        obtain ⟨K, hK, hKe⟩ := ih
        obtain ⟨b2, -, bd⟩ := s1aux K hK
        refine ⟨_, b2, fun X η hX h1 h2 => ?_⟩
        rw [iteratedDeriv_succ]
        have hev : iteratedDeriv m (fun e => G X e) =ᶠ[nhds η] fun e => K (X, e) :=
          Filter.eventuallyEq_of_mem (isOpen_Ioo.mem_nhds ⟨h1, h2⟩)
            (fun e he => hKe X e hX he.1 he.2)
        rw [hev.deriv_eq]
        exact (bd X η hX h1 h2).1.deriv
    intro m
    obtain ⟨K, hK, hKe⟩ := ex m
    refine ⟨hK.congr ?_, ?_⟩
    · rintro ⟨X, η⟩ ⟨hX, h1, h2⟩
      exact hKe X η hX h1 h2
    · intro X η hX h1 h2
      obtain ⟨-, -, bd⟩ := s1aux K hK
      have hev : iteratedDeriv m (fun e => G X e) =ᶠ[nhds η] fun e => K (X, e) :=
        Filter.eventuallyEq_of_mem (isOpen_Ioo.mem_nhds ⟨h1, h2⟩) (fun e he => hKe X e hX he.1 he.2)
      have hdA : DifferentiableAt ℝ (iteratedDeriv m (fun e => G X e)) η :=
        (bd X η hX h1 h2).1.differentiableAt.congr_of_eventuallyEq hev
      have := hdA.hasDerivAt
      rw [← iteratedDeriv_succ] at this
      exact this

  have s2 : ∀ (S : Set ℝ) (D : ℕ → ℝ → ℝ → ℝ), MeasurableSet S →
      (∀ (m : ℕ) (η : ℝ), -1 < η → η < 1 → ContinuousOn (fun x => D m x η) S) →
      (∀ (m : ℕ) (x η : ℝ), x ∈ S → -1 < η → η < 1 →
        HasDerivAt (fun e => D m x e) (D (m + 1) x η) η) →
      (∀ m : ℕ, ∃ b : ℝ → ℝ, IntegrableOn b S ∧
        ∀ x η : ℝ, x ∈ S → -1 < η → η < 1 → |D m x η| ≤ b x) →
      ContDiffOn ℝ ∞ (fun η => ∫ x in S, D 0 x η) (Ioo (-1) 1) := by
    intro S D hS hc hd hb
    have step : ∀ m : ℕ, ∀ η ∈ Ioo (-1:ℝ) 1,
        HasDerivAt (fun e => ∫ x in S, D m x e) (∫ x in S, D (m+1) x η) η := by
      intro m η hη
      obtain ⟨b, hbi, hbb⟩ := hb (m+1)
      obtain ⟨b0, hb0i, hb0b⟩ := hb m
      have hmeas : ∀ k e, e ∈ Ioo (-1:ℝ) 1 →
          AEStronglyMeasurable (fun x => D k x e) (volume.restrict S) :=
        fun k e he => (hc k e he.1 he.2).aestronglyMeasurable hS
      have := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume.restrict S)
        (F := fun e x => D m x e) (F' := fun e x => D (m+1) x e) (x₀ := η) (bound := b)
        (isOpen_Ioo.mem_nhds hη) ?_ ?_ ?_ ?_ hbi ?_
      · exact this.2
      · filter_upwards [isOpen_Ioo.mem_nhds hη] with e he using hmeas m e he
      · exact Integrable.mono' hb0i (hmeas m η hη) ((ae_restrict_iff' hS).2
          (Filter.Eventually.of_forall fun x hx => by
            rw [Real.norm_eq_abs]; exact hb0b x η hx hη.1 hη.2))
      · exact hmeas (m+1) η hη
      · exact (ae_restrict_iff' hS).2 (Filter.Eventually.of_forall fun x hx e he => by
          rw [Real.norm_eq_abs]; exact hbb x e hx he.1 he.2)
      · exact (ae_restrict_iff' hS).2
          (Filter.Eventually.of_forall fun x hx e he => hd m x e hx he.1 he.2)
    have key : ∀ n : ℕ, ∀ m : ℕ, ContDiffOn ℝ n (fun η => ∫ x in S, D m x η) (Ioo (-1) 1) := by
      intro n
      induction n with
      | zero =>
        intro m
        rw [CharP.cast_eq_zero, contDiffOn_zero]
        exact fun η hη => (step m η hη).continuousAt.continuousWithinAt
      | succ n ih =>
        intro m
        rw [Nat.cast_succ, contDiffOn_succ_iff_deriv_of_isOpen isOpen_Ioo]
        refine ⟨fun η hη => (step m η hη).differentiableAt.differentiableWithinAt, by simp, ?_⟩
        exact (ih (m+1)).congr fun η hη => (step m η hη).deriv
    exact contDiffOn_infty.2 fun n => key n 0

  have s4 : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => ∫ x in (1:ℝ)..p.1, g x p.2) (Ioi 0 ×ˢ Ioo (-1) 1) := by
    intro g hg
    have hgt : ContDiffOn ℝ ∞ (↿(fun y e => g (1 + y) e)) (Ioi (-1) ×ˢ Ioo (-1) 1) :=
      hg.comp (f := fun q : ℝ × ℝ => ((1 + q.1, q.2) : ℝ × ℝ)) (by fun_prop)
        (fun q hq => ⟨show (0:ℝ) < 1 + q.1 by linarith [show (-1:ℝ) < q.1 from hq.1], hq.2⟩)
    obtain ⟨hP, -, hPid⟩ := profRadAvg_props (fun y e => g (1 + y) e) 1 one_pos hgt
    have hc : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => profRadAvg (fun y e => g (1 + y) e) (p.1 - 1) p.2)
        (Ioi 0 ×ˢ Ioo (-1) 1) :=
      hP.comp (f := fun p : ℝ × ℝ => ((p.1 - 1, p.2) : ℝ × ℝ)) (by fun_prop)
        (fun p hp => ⟨show (-1:ℝ) < p.1 - 1 by linarith [show (0:ℝ) < p.1 from hp.1], hp.2⟩)
    refine ((contDiffOn_fst.sub (contDiffOn_const (c := (1:ℝ)))).mul hc).congr ?_
    rintro ⟨X, η⟩ ⟨hX, h1, h2⟩
    have hX' : (0:ℝ) < X := hX
    have e := (hPid (X - 1) η (by linarith) h1 h2).1
    have e2 := intervalIntegral.integral_comp_add_left (a := 0) (b := X - 1) (fun x => g x η) 1
    rw [show (1:ℝ) + (X - 1) = X by ring, add_zero] at e2
    show (∫ x in (1:ℝ)..X, g x η) = (X - 1) * profRadAvg (fun y e => g (1 + y) e) (X - 1) η
    rw [e]
    simp only [profRadInt]
    exact e2.symm

  have hsl : ∀ (G : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿G) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ∀ x η : ℝ, 0 < x → -1 < η → η < 1 → ContDiffAt ℝ ∞ (fun e => G x e) η := by
    intro G hG x η hx h1 h2
    have hf : ContDiffAt ℝ ∞ (fun e : ℝ => ((x, e) : ℝ × ℝ)) η :=
      contDiffAt_const.prodMk contDiffAt_id
    exact (hG.contDiffAt (hΩ.mem_nhds
      (show ((x, η) : ℝ × ℝ) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 from ⟨hx, h1, h2⟩))).comp
      (f := fun e : ℝ => ((x, e) : ℝ × ℝ)) η hf

  have prodb : ∀ (a b : ℝ → ℝ) (η A B : ℝ) (m : ℕ), ContDiffAt ℝ ∞ a η → ContDiffAt ℝ ∞ b η →
      (∀ i ≤ m, |iteratedDeriv i a η| ≤ A) → (∀ i ≤ m, |iteratedDeriv i b η| ≤ B) →
      |iteratedDeriv m (a * b) η| ≤ 2 ^ m * (A * B) := by
    intro a b η A B m ha hb' hA hB
    have hA0 : 0 ≤ A := le_trans (abs_nonneg _) (hA 0 (Nat.zero_le m))
    rw [iteratedDeriv_mul (ha.of_le (by exact_mod_cast le_top)) (hb'.of_le (by exact_mod_cast le_top))]
    calc _ ≤ ∑ i ∈ Finset.range (m+1),
            |(m.choose i : ℝ) * iteratedDeriv i a η * iteratedDeriv (m-i) b η| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i ∈ Finset.range (m+1), (m.choose i : ℝ) * (A * B) := by
          apply Finset.sum_le_sum
          intro i hi
          have hi' : i ≤ m := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [abs_mul, abs_mul, Nat.abs_cast, mul_assoc]
          exact mul_le_mul_of_nonneg_left
            (mul_le_mul (hA i hi') (hB (m-i) (Nat.sub_le m i)) (abs_nonneg _) hA0) (Nat.cast_nonneg _)
      _ = 2 ^ m * (A * B) := by
          rw [← Finset.sum_mul]
          congr 1
          exact_mod_cast Nat.sum_range_choose m
  choose C hC using hb
  have hw : ∀ x : ℝ, 0 < x → 0 ≤ x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)) :=
    fun x hx => by positivity
  have hK : ∀ m : ℕ, ∃ K : ℝ, 0 ≤ K ∧ ∀ i ≤ m, ∀ x η : ℝ, 0 < x → -1 < η → η < 1 →
      |iteratedDeriv i (fun e => F x e) η| ≤ K * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))) ∧
      |iteratedDeriv i (fun e => U x e) η| ≤ K := by
    intro m
    refine ⟨∑ j ∈ Finset.range (m+1), |C j|, Finset.sum_nonneg (fun j _ => abs_nonneg _), ?_⟩
    intro i hi x η hx h1 h2
    have hCi : |C i| ≤ ∑ j ∈ Finset.range (m+1), |C j| :=
      Finset.single_le_sum (f := fun j => |C j|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.2 (Nat.lt_succ_of_le hi))
    obtain ⟨b1, b2⟩ := hC i x η hx h1 h2
    constructor
    · calc _ ≤ C i * x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)) := b1
        _ = C i * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))) := by ring
        _ ≤ _ := mul_le_mul_of_nonneg_right ((le_abs_self _).trans hCi) (hw x hx)
    · exact b2.trans ((le_abs_self _).trans hCi)
  have wsmall : ∀ x : ℝ, 0 < x → x ≤ 1 →
      x * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))) ≤ 1 ∧
      x * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))) ^ 2 ≤ 1 := by
    intro x hx hx1
    have hb0 : 0 ≤ (1 + x) ^ (-(3 / 5 + h)) := by positivity
    have hb1 : (1 + x) ^ (-(3 / 5 + h)) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (by linarith) (by linarith)
    have e1 : x * x ^ (-(2 / 5 : ℝ)) = x ^ (3 / 5 : ℝ) := by
      rw [show (3 / 5 : ℝ) = 1 + (-(2 / 5)) by norm_num, Real.rpow_add hx, Real.rpow_one]
    have e2 : x * (x ^ (-(2 / 5 : ℝ))) ^ 2 = x ^ (1 / 5 : ℝ) := by
      rw [sq, ← mul_assoc, e1, ← Real.rpow_add hx]; norm_num
    have f1 : x ^ (3 / 5 : ℝ) ≤ 1 := Real.rpow_le_one hx.le hx1 (by norm_num)
    have f2 : x ^ (1 / 5 : ℝ) ≤ 1 := Real.rpow_le_one hx.le hx1 (by norm_num)
    constructor
    · calc x * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)))
          = x ^ (3 / 5 : ℝ) * (1 + x) ^ (-(3 / 5 + h)) := by rw [← e1]; ring
        _ ≤ 1 * 1 := mul_le_mul f1 hb1 hb0 zero_le_one
        _ = 1 := one_mul 1
    · calc x * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))) ^ 2
          = x ^ (1 / 5 : ℝ) * ((1 + x) ^ (-(3 / 5 + h))) ^ 2 := by rw [← e2]; ring
        _ ≤ 1 * 1 := mul_le_mul f2 (pow_le_one₀ hb0 hb1) (by positivity) zero_le_one
        _ = 1 := one_mul 1
  have wlarge : ∀ x : ℝ, 1 ≤ x →
      (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))) ^ 2 ≤ x ^ (-(6 / 5 : ℝ)) := by
    intro x hx
    have hx0 : 0 < x := by linarith
    have ha1 : x ^ (-(2 / 5 : ℝ)) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hx (by norm_num)
    have hb : (1 + x) ^ (-(3 / 5 + h)) ≤ x ^ (-(3 / 5 : ℝ)) :=
      (Real.rpow_le_rpow_of_nonpos hx0 (by linarith) (by linarith)).trans
        (Real.rpow_le_rpow_of_exponent_le hx (by linarith))
    have hb0 : 0 ≤ (1 + x) ^ (-(3 / 5 + h)) := by positivity
    have hwx : x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)) ≤ x ^ (-(3 / 5 : ℝ)) := by
      calc _ ≤ 1 * x ^ (-(3 / 5 : ℝ)) := mul_le_mul ha1 hb hb0 zero_le_one
        _ = _ := one_mul _
    have e : x ^ (-(6 / 5 : ℝ)) = x ^ (-(3 / 5 : ℝ)) * x ^ (-(3 / 5 : ℝ)) := by
      rw [← Real.rpow_add hx0]; norm_num
    rw [e, sq]
    exact mul_le_mul hwx hwx (by positivity) (by positivity)

  have hbU : ∀ m : ℕ, ∃ Cg : ℝ, ∀ x η : ℝ, 0 < x → x ≤ 1 → -1 < η → η < 1 →
      |iteratedDeriv m (fun e => U x e) η| ≤ Cg := by
    intro m
    obtain ⟨K, -, hKb⟩ := hK m
    exact ⟨K, fun x η hx _ h1 h2 => (hKb m le_rfl x η hx h1 h2).2⟩
  have b2F : ∀ m : ℕ, ∃ K : ℝ, 0 ≤ K ∧ ∀ i ≤ m, ∀ x η : ℝ, 0 < x → x ≤ 1 → -1 < η → η < 1 →
      |iteratedDeriv i (fun e => 2 * x * F x e) η| ≤ 2 * K ∧
      |iteratedDeriv i (fun e => U x e) η| ≤ K := by
    intro m
    obtain ⟨K, hK0, hKb⟩ := hK m
    refine ⟨K, hK0, fun i hi x η hx hx1 h1 h2 => ⟨?_, (hKb i hi x η hx h1 h2).2⟩⟩
    rw [iteratedDeriv_const_mul_field, abs_mul, abs_of_pos (by positivity : (0:ℝ) < 2 * x)]
    have hb1 := (hKb i hi x η hx h1 h2).1
    have hws := (wsmall x hx hx1).1
    calc 2 * x * |iteratedDeriv i (fun e => F x e) η|
        ≤ 2 * x * (K * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)))) :=
          mul_le_mul_of_nonneg_left hb1 (by positivity)
      _ = 2 * K * (x * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)))) := by ring
      _ ≤ 2 * K * 1 := mul_le_mul_of_nonneg_left hws (by positivity)
      _ = 2 * K := mul_one _
  have hb2F : ∀ m : ℕ, ∃ Cg : ℝ, ∀ x η : ℝ, 0 < x → x ≤ 1 → -1 < η → η < 1 →
      |iteratedDeriv m (fun e => 2 * x * F x e) η| ≤ Cg := by
    intro m
    obtain ⟨K, -, hKb⟩ := b2F m
    exact ⟨2 * K, fun x η hx hx1 h1 h2 => (hKb m le_rfl x η hx hx1 h1 h2).1⟩
  have hbU2F : ∀ m : ℕ, ∃ Cg : ℝ, ∀ x η : ℝ, 0 < x → x ≤ 1 → -1 < η → η < 1 →
      |iteratedDeriv m (fun e => U x e * (2 * x * F x e)) η| ≤ Cg := by
    intro m
    obtain ⟨K, -, hKb⟩ := b2F m
    refine ⟨2 ^ m * (K * (2 * K)), fun x η hx hx1 h1 h2 => ?_⟩
    have hFs := hsl F hF x η hx h1 h2
    have hUs := hsl U hU x η hx h1 h2
    have hFs2 : ContDiffAt ℝ ∞ (fun e => 2 * x * F x e) η := contDiffAt_const.mul hFs
    exact prodb (fun e => U x e) (fun e => 2 * x * F x e) η K (2 * K) m hUs hFs2
      (fun i hi => (hKb i hi x η hx hx1 h1 h2).2) (fun i hi => (hKb i hi x η hx hx1 h1 h2).1)
  have hbU2 : ∀ m : ℕ, ∃ Cg : ℝ, ∀ x η : ℝ, 0 < x → x ≤ 1 → -1 < η → η < 1 →
      |iteratedDeriv m (fun e => U x e ^ 2 - x * F x e ^ 2) η| ≤ Cg := by
    intro m
    obtain ⟨K, hK0, hKb⟩ := hK m
    refine ⟨2 ^ m * (K * K) + 2 ^ m * (K * K), fun x η hx hx1 h1 h2 => ?_⟩
    have hFs := hsl F hF x η hx h1 h2
    have hUs := hsl U hU x η hx h1 h2
    have hw0 := hw x hx
    have e : (fun e => U x e ^ 2 - x * F x e ^ 2) =
        ((fun e => U x e) * (fun e => U x e)) -
          (fun e => x * ((fun e => F x e) * (fun e => F x e)) e) := by
      funext e; simp only [Pi.mul_apply, Pi.sub_apply]; ring
    have c1 : ContDiffAt ℝ m ((fun e => U x e) * (fun e => U x e)) η :=
      (hUs.mul hUs).of_le (by exact_mod_cast le_top)
    have c2 : ContDiffAt ℝ m (fun e => x * ((fun e => F x e) * (fun e => F x e)) e) η :=
      (contDiffAt_const.mul (hFs.mul hFs)).of_le (by exact_mod_cast le_top)
    rw [e, iteratedDeriv_sub c1 c2, iteratedDeriv_const_mul_field]
    have p1 := prodb (fun e => U x e) (fun e => U x e) η K K m hUs hUs
      (fun i hi => (hKb i hi x η hx h1 h2).2) (fun i hi => (hKb i hi x η hx h1 h2).2)
    have p2 := prodb (fun e => F x e) (fun e => F x e) η
      (K * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))))
      (K * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)))) m hFs hFs
      (fun i hi => (hKb i hi x η hx h1 h2).1) (fun i hi => (hKb i hi x η hx h1 h2).1)
    have hws := (wsmall x hx hx1).2
    refine (abs_sub _ _).trans (add_le_add p1 ?_)
    rw [abs_mul, abs_of_pos hx]
    calc x * |iteratedDeriv m ((fun e => F x e) * (fun e => F x e)) η|
        ≤ x * (2 ^ m * (K * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))) *
            (K * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)))))) :=
          mul_le_mul_of_nonneg_left p2 hx.le
      _ = 2 ^ m * (K * K) * (x * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))) ^ 2) := by ring
      _ ≤ 2 ^ m * (K * K) * 1 := mul_le_mul_of_nonneg_left hws (by positivity)
      _ = 2 ^ m * (K * K) := mul_one _
  have hbF2 : ∀ m : ℕ, ∃ Cg : ℝ, ∀ x η : ℝ, 1 ≤ x → -1 < η → η < 1 →
      |iteratedDeriv m (fun e => F x e ^ 2) η| ≤ Cg * x ^ (-(6 / 5 : ℝ)) := by
    intro m
    obtain ⟨K, hK0, hKb⟩ := hK m
    refine ⟨2 ^ m * (K * K), fun x η hx h1 h2 => ?_⟩
    have hx0 : 0 < x := by linarith
    have hFs := hsl F hF x η hx0 h1 h2
    have e : (fun e => F x e ^ 2) = (fun e => F x e) * (fun e => F x e) := by
      funext e; simp only [Pi.mul_apply]; ring
    rw [e]
    have p2 := prodb (fun e => F x e) (fun e => F x e) η
      (K * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))))
      (K * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)))) m hFs hFs
      (fun i hi => (hKb i hi x η hx0 h1 h2).1) (fun i hi => (hKb i hi x η hx0 h1 h2).1)
    refine p2.trans ?_
    have hwl := wlarge x hx
    calc 2 ^ m * (K * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))) *
          (K * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)))))
        = 2 ^ m * (K * K) * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))) ^ 2 := by ring
      _ ≤ 2 ^ m * (K * K) * x ^ (-(6 / 5 : ℝ)) := mul_le_mul_of_nonneg_left hwl (by positivity)

  have radSmooth : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) (Ioi 0 ×ˢ Ioo (-1) 1) →
      (∀ m : ℕ, ∃ Cg : ℝ, ∀ x η : ℝ, 0 < x → x ≤ 1 → -1 < η → η < 1 →
        |iteratedDeriv m (fun e => g x e) η| ≤ Cg) →
      ContDiffOn ℝ ∞ (↿(profRadInt g)) (Ioi 0 ×ˢ Ioo (-1) 1) := by
    intro g hg hgb
    obtain ⟨-, -, hg3⟩ := s1 g hg
    have hA : ContDiffOn ℝ ∞ (fun η => ∫ x in Ioc (0:ℝ) 1, iteratedDeriv 0 (fun e => g x e) η)
        (Ioo (-1) 1) := by
      refine s2 (Ioc 0 1) (fun m x η => iteratedDeriv m (fun e => g x e) η) measurableSet_Ioc
        ?_ ?_ ?_
      · intro m η h1 h2
        exact (hg3 m).1.continuousOn.comp (f := fun x : ℝ => ((x, η) : ℝ × ℝ)) (by fun_prop)
          (fun x hx => ⟨hx.1, h1, h2⟩)
      · intro m x η hx h1 h2
        exact (hg3 m).2 x η hx.1 h1 h2
      · intro m
        obtain ⟨Cg, hCg⟩ := hgb m
        exact ⟨fun _ => Cg, integrableOn_const (by simp),
          fun x η hx h1 h2 => hCg x η hx.1 hx.2 h1 h2⟩
    simp only [iteratedDeriv_zero] at hA
    have hB := s4 g hg
    have hcont : ∀ η, -1 < η → η < 1 → ContinuousOn (fun x => g x η) (Ioi 0) := fun η h1 h2 =>
      hg.continuousOn.comp (f := fun x : ℝ => ((x, η) : ℝ × ℝ)) (by fun_prop)
        (fun x hx => ⟨hx, h1, h2⟩)
    refine ((hA.comp contDiffOn_snd (fun p hp => hp.2)).add hB).congr ?_
    rintro ⟨X, η⟩ ⟨hX, h1, h2⟩
    have hX' : (0:ℝ) < X := hX
    obtain ⟨C0, hC0⟩ := hgb 0
    show profRadInt g X η = (∫ x in Ioc (0:ℝ) 1, g x η) + ∫ x in (1:ℝ)..X, g x η
    have hi1 : IntervalIntegrable (fun x => g x η) volume 0 1 := by
      rw [intervalIntegrable_iff_integrableOn_Ioc_of_le zero_le_one]
      refine Integrable.mono' (integrableOn_const (C := C0) (by simp))
        (((hcont η h1 h2).mono Ioc_subset_Ioi_self).aestronglyMeasurable measurableSet_Ioc) ?_
      refine (ae_restrict_iff' measurableSet_Ioc).2 (Filter.Eventually.of_forall fun x hx => ?_)
      have := hC0 x η hx.1 hx.2 h1 h2
      rw [iteratedDeriv_zero] at this
      rw [Real.norm_eq_abs]; exact this
    have hi2 : IntervalIntegrable (fun x => g x η) volume 1 X := by
      apply ContinuousOn.intervalIntegrable
      apply (hcont η h1 h2).mono
      intro x hx
      rw [Set.mem_uIcc] at hx
      show 0 < x
      rcases hx with hx | hx <;> linarith [hx.1]
    unfold profRadInt
    rw [← intervalIntegral.integral_add_adjacent_intervals hi1 hi2,
      intervalIntegral.integral_of_le zero_le_one]

  have hF2 : ContDiffOn ℝ ∞ (↿(fun x e => F x e ^ 2)) (Ioi 0 ×ˢ Ioo (-1) 1) := by
    have : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => (↿F) p ^ 2) (Ioi 0 ×ˢ Ioo (-1) 1) := hF.pow 2
    exact this
  obtain ⟨-, -, hF23⟩ := s1 (fun x e => F x e ^ 2) hF2
  have hT : ContDiffOn ℝ ∞ (fun η => ∫ x in Ioi (1:ℝ), iteratedDeriv 0 (fun e => F x e ^ 2) η)
      (Ioo (-1) 1) := by
    refine s2 (Ioi 1) (fun m x η => iteratedDeriv m (fun e => F x e ^ 2) η) measurableSet_Ioi
      ?_ ?_ ?_
    · intro m η h1 h2
      exact (hF23 m).1.continuousOn.comp (f := fun x : ℝ => ((x, η) : ℝ × ℝ)) (by fun_prop)
        (fun x (hx : x ∈ Ioi (1:ℝ)) => ⟨show (0:ℝ) < x from lt_trans one_pos hx, h1, h2⟩)
    · intro m x η hx h1 h2
      exact (hF23 m).2 x η (lt_trans one_pos hx) h1 h2
    · intro m
      obtain ⟨Cg, hCg⟩ := hbF2 m
      exact ⟨fun x => Cg * x ^ (-(6 / 5 : ℝ)),
        Integrable.const_mul (integrableOn_Ioi_rpow_of_lt (by norm_num) one_pos) Cg,
        fun x η hx h1 h2 => hCg x η (le_of_lt hx) h1 h2⟩
  simp only [iteratedDeriv_zero] at hT
  have hPi : ContDiffOn ℝ ∞ (↿(leadPi F)) (Ioi 0 ×ˢ Ioo (-1) 1) := by
    have hB := s4 (fun x e => F x e ^ 2) hF2
    refine ((hT.comp contDiffOn_snd (fun p hp => hp.2)).neg.add hB).congr ?_
    rintro ⟨X, η⟩ ⟨hX, h1, h2⟩
    have hX' : (0:ℝ) < X := hX
    show leadPi F X η = -(∫ x in Ioi (1:ℝ), F x η ^ 2) + ∫ x in (1:ℝ)..X, F x η ^ 2
    have hcont : ContinuousOn (fun x => F x η ^ 2) (Ioi 0) :=
      hF2.continuousOn.comp (f := fun x : ℝ => ((x, η) : ℝ × ℝ)) (by fun_prop)
        (fun x hx => ⟨hx, h1, h2⟩)
    obtain ⟨C0, hC0⟩ := hbF2 0
    have hI1 : IntegrableOn (fun x => F x η ^ 2) (Ioi 1) := by
      refine Integrable.mono'
        (Integrable.const_mul (integrableOn_Ioi_rpow_of_lt (by norm_num : -(6 / 5 : ℝ) < -1) one_pos) C0)
        ((hcont.mono (fun x (hx : 1 < x) => show (0:ℝ) < x from lt_trans one_pos hx)).aestronglyMeasurable
          measurableSet_Ioi) ?_
      refine (ae_restrict_iff' measurableSet_Ioi).2 (Filter.Eventually.of_forall fun x hx => ?_)
      have := hC0 x η (le_of_lt hx) h1 h2
      rw [iteratedDeriv_zero] at this
      rw [Real.norm_eq_abs]; exact this
    have hIX : IntegrableOn (fun x => F x η ^ 2) (Ioi X) := by
      have hIcc : IntegrableOn (fun x => F x η ^ 2) (Icc X 1) :=
        (hcont.mono (fun x (hx : x ∈ Icc X 1) => show (0:ℝ) < x from lt_of_lt_of_le hX' hx.1)).integrableOn_Icc
      refine (hIcc.union hI1).mono_set ?_
      intro x hx
      by_cases hx1 : x ≤ 1
      · exact Or.inl ⟨le_of_lt hx, hx1⟩
      · exact Or.inr (lt_of_not_ge hx1)
    have := intervalIntegral.integral_Ioi_sub_Ioi' hI1 hIX
    beta_reduce at this
    unfold leadPi
    linarith

  have havg : ∀ X η : ℝ, X ≠ 0 → profRadAvg U X η = X⁻¹ * profRadInt U X η := by
    intro X η hX
    have := intervalIntegral.integral_comp_mul_right (a := 0) (b := 1) (fun x => U x η) hX
    simp only [zero_mul, one_mul, smul_eq_mul] at this
