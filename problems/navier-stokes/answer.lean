theorem ax_glue_explicit_regular : ∀ (Pst C T : ℝ) (ℓ G : ℝ → ℝ) (β : Fin 2 → ℝ → ℝ) (γ : Fin 3 → ℝ → ℝ) (c : ℝ → Fin 5 → ℝ), 0 < Pst → 0 < C → ContDiffOn ℝ ∞ ℓ (Ioo (-1) 1) → ContDiffOn ℝ ∞ G (Ioo (-1) 1) → ContDiffOn ℝ ∞ c (Ioo (-1) 1) → (∀ i, ContDiff ℝ ∞ (β i)) → (∀ j, ContDiff ℝ ∞ (γ j)) → (∀ m : ℕ, ∃ K : ℝ, ∀ η : ℝ, -1 < η → η < 1 → |iteratedDeriv m ℓ η| ≤ K ∧ |iteratedDeriv m G η| ≤ K ∧ ‖iteratedDeriv m c η‖ ≤ K) → ContDiffOn ℝ ∞ (↿(axGlueFe Pst C T ℓ γ c)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(axGlueUe Pst C G β c)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ∀ a b : ℝ, 0 < a → ∀ m : ℕ, ∃ K : ℝ, ∀ X η : ℝ, a ≤ X → X ≤ b → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿(axGlueFe Pst C T ℓ γ c)) (X, η)‖ ≤ K ∧ ‖iteratedFDeriv ℝ m (↿(axGlueUe Pst C G β c)) (X, η)‖ ≤ K :=
