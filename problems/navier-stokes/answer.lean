  have gmulΩ : ∀ f g : ℝ × ℝ → ℝ, osbGood (Ioi 0 ×ˢ Ioo (-1) 1) (Icc a X₂ ×ˢ Ioo (-1) 1) f →
      osbGood (Ioi 0 ×ˢ Ioo (-1) 1) (Icc a X₂ ×ˢ Ioo (-1) 1) g →
