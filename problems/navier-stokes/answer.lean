    show |FN N X η + rcRF γ c X η - F X η| ≤ τ ∧ |UN N X η + rcRU β c X η - U X η| ≤ τ ∧
      |deriv (fun e => FN N X e + rcRF γ c X e) η - deriv (fun e => F X e) η| ≤ τ ∧
      |deriv (fun e => UN N X e + rcRU β c X e) η - deriv (fun e => U X e) η| ≤ τ
    by_cases hA : X ≤ Xm'
    · have hfF : (fun e => FN N X e + rcRF γ c X e) = fun e => F X e := funext fun e => by
        rw [(hagr X e (Or.inl hA)).1, (hRF0 c X e (Or.inl (by linarith))).1, add_zero]
      have hfU : (fun e => UN N X e + rcRU β c X e) = fun e => U X e := funext fun e => by
        rw [(hagr X e (Or.inl hA)).2, (hRF0 c X e (Or.inl (by linarith))).2, add_zero]
      have v1 : FN N X η + rcRF γ c X η = F X η := congrFun hfF η
      have v2 : UN N X η + rcRU β c X η = U X η := congrFun hfU η
      rw [hfF, hfU, v1, v2]
      simp only [sub_self, abs_zero]
      exact ⟨hτ.le, hτ.le, hτ.le, hτ.le⟩
    · by_cases hB' : X ≤ Xp
      · have hXm : Xm ≤ X := by linarith
        have hfF : (fun e => FN N X e + rcRF γ c X e) = fun e => FN N X e := funext fun e => by
          rw [(hRF0 c X e (Or.inl (by linarith))).1, add_zero]
        have hfU : (fun e => UN N X e + rcRU β c X e) = fun e => UN N X e := funext fun e => by
          rw [(hRF0 c X e (Or.inl (by linarith))).2, add_zero]
        have v1 : FN N X η + rcRF γ c X η = FN N X η := congrFun hfF η
        have v2 : UN N X η + rcRU β c X η = UN N X η := congrFun hfU η
        obtain ⟨k1, k2, k3, k4, -⟩ := hclose X η hXm hB' e1 e2
        rw [hfF, hfU, v1, v2]
        exact ⟨(k1.trans hCNq).trans hqτ, (k2.trans hCNq).trans hqτ, (k3.trans hCNq).trans hqτ,
          (k4.trans hCNq).trans hqτ⟩
      · push_neg at hB'
        have hG : ∀ e, FN N X e = F X e ∧ UN N X e = U X e :=
          fun e => hagr X e (Or.inr (by linarith))
        obtain ⟨hR1, hR2, -, -, hRv1, hRv2, hRd1, hRd2, -, -⟩ := hRpt X η e1 e2
        have hmem : (X, η) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := ⟨show (0:ℝ) < X by linarith, e1, e2⟩
        have hFd := (slice_deriv_facts F _ X η hSo hFs hmem).2.1
        have hUd := (slice_deriv_facts U _ X η hSo hUs hmem).2.1
        have hfF : (fun e => FN N X e + rcRF γ c X e) = fun e => F X e + rcRF γ c X e :=
          funext fun e => by rw [(hG e).1]
        have hfU : (fun e => UN N X e + rcRU β c X e) = fun e => U X e + rcRU β c X e :=
          funext fun e => by rw [(hG e).2]
        have hd1 : deriv (fun e => F X e + rcRF γ c X e) η =
            deriv (fun e => F X e) η + deriv (fun e => rcRF γ c X e) η := (hFd.add hR1).deriv
        have hd2 : deriv (fun e => U X e + rcRU β c X e) η =
            deriv (fun e => U X e) η + deriv (fun e => rcRU β c X e) η := (hUd.add hR2).deriv
        rw [hfF, hfU, (hG η).1, (hG η).2, hd1, hd2, s1h, s1h, s1h, s1h]
        exact ⟨hRv1.trans hΓτ, hRv2.trans hΓτ, hRd1.trans hΓτ, hRd2.trans hΓτ⟩
  ·
    intro X η hX1 hX2 e1 e2
    have hXs : X < s1 := by linarith
    have evF : (fun Y => FN N Y η + rcRF γ c Y η) =ᶠ[nhds X] (fun Y => FN N Y η) :=
      Filter.eventuallyEq_of_mem (Iio_mem_nhds hXs) (fun Y hY => by
        show FN N Y η + rcRF γ c Y η = FN N Y η
        rw [(hRF0 c Y η (Or.inl (le_of_lt hY))).1, add_zero])
    have evU : (fun Y => UN N Y η + rcRU β c Y η) =ᶠ[nhds X] (fun Y => UN N Y η) :=
      Filter.eventuallyEq_of_mem (Iio_mem_nhds hXs) (fun Y hY => by
        show UN N Y η + rcRU β c Y η = UN N Y η
        rw [(hRF0 c Y η (Or.inl (le_of_lt hY))).2, add_zero])
    have hv : FN N X η + rcRF γ c X η = FN N X η := by
      rw [(hRF0 c X η (Or.inl hXs.le)).1, add_zero]
    have hsA : shearA (fun X η => FN N X η + rcRF γ c X η) X η = shearA (FN N) X η := by
      simp only [shearA]; rw [evF.deriv_eq, hv]
    have hsB : shearB (fun X η => FN N X η + rcRF γ c X η) (fun X η => UN N X η + rcRU β c X η) X η =
        shearB (FN N) (UN N) X η := by
      simp only [shearB]; rw [evU.deriv_eq, hv]
    rw [hsA, hsB]
    obtain ⟨-, -, -, -, k1, k2, k3, k4, k5, k6⟩ := hclose X η hX1 hX2 e1 e2
    exact ⟨k1, k2, k3, k4, k5, k6⟩
  ·
    intro X η hX1 hX2 e1 e2
    have hXp' : Xp' < X := by linarith
    have evF : (fun Y => FN N Y η + rcRF γ c Y η) =ᶠ[nhds X] (fun Y => F Y η + rcRF γ c Y η) :=
      Filter.eventuallyEq_of_mem (Ioi_mem_nhds hXp') (fun Y hY => by
        show FN N Y η + rcRF γ c Y η = F Y η + rcRF γ c Y η
        rw [(hagr Y η (Or.inr (le_of_lt hY))).1])
    have evU : (fun Y => UN N Y η + rcRU β c Y η) =ᶠ[nhds X] (fun Y => U Y η + rcRU β c Y η) :=
      Filter.eventuallyEq_of_mem (Ioi_mem_nhds hXp') (fun Y hY => by
        show UN N Y η + rcRU β c Y η = U Y η + rcRU β c Y η
        rw [(hagr Y η (Or.inr (le_of_lt hY))).2])
    obtain ⟨-, -, hR3, hR4, hRv1, -, -, -, hRx1, hRx2⟩ := hRpt X η e1 e2
    have hmem : (X, η) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := ⟨show (0:ℝ) < X by linarith, e1, e2⟩
    obtain ⟨hFd, -, hFdb, -, -, -⟩ := slice_deriv_facts F _ X η hSo hFs hmem
    obtain ⟨hUd, -, hUdb, -, -, -⟩ := slice_deriv_facts U _ X η hSo hUs hmem
    have hFX : |deriv (fun Y => F Y η) X| ≤ B1 := hFdb.trans (hB1 X η hX1 hX2 e1 e2).1
    have hUX : |deriv (fun Y => U Y η) X| ≤ B1 := hUdb.trans (hB1 X η hX1 hX2 e1 e2).2
    have hκF : κa ≤ F X η := (hκa X (Or.inr ⟨by linarith, by linarith⟩) η e1 e2).1
    have hv : FN N X η + rcRF γ c X η = F X η + rcRF γ c X η := by
      rw [(hagr X η (Or.inr hXp'.le)).1]
    have hd3 : deriv (fun Y => F Y η + rcRF γ c Y η) X =
        deriv (fun Y => F Y η) X + deriv (fun Y => rcRF γ c Y η) X := (hFd.add hR3).deriv
    have hd4 : deriv (fun Y => U Y η + rcRU β c Y η) X =
        deriv (fun Y => U Y η) X + deriv (fun Y => rcRU β c Y η) X := (hUd.add hR4).deriv
    have hsA : shearA (fun X η => FN N X η + rcRF γ c X η) X η - shearA F X η =
        -2 * X * (deriv (fun Y => F Y η) X + deriv (fun Y => rcRF γ c Y η) X) /
          (F X η + rcRF γ c X η) - -2 * X * deriv (fun Y => F Y η) X / F X η := by
      simp only [shearA]; rw [evF.deriv_eq, hd3, hv]
    have hsB : shearB (fun X η => FN N X η + rcRF γ c X η) (fun X η => UN N X η + rcRU β c X η) X η -
        shearB F U X η =
        Real.sqrt (2 * X) * (deriv (fun Y => U Y η) X + deriv (fun Y => rcRU β c Y η) X) /
          (F X η + rcRF γ c X η) - Real.sqrt (2 * X) * deriv (fun Y => U Y η) X / F X η := by
      simp only [shearB]; rw [evU.deriv_eq, hd4, hv]
    have hc1 : κa / 2 ≤ F X η + rcRF γ c X η := by
      have := neg_abs_le (rcRF γ c X η); linarith
    have key := hL X (Γ * (K2 * (M0 * q))) (F X η) (deriv (fun Y => F Y η) X)
      (deriv (fun Y => U Y η) X) (F X η + rcRF γ c X η)
      (deriv (fun Y => F Y η) X + deriv (fun Y => rcRF γ c Y η) X)
      (deriv (fun Y => U Y η) X + deriv (fun Y => rcRU β c Y η) X) hX1 hX2 hΓθ0 (by linarith) hc1
      hFX hUX (by rw [s1h]; exact hRv1) (by rw [s1h]; exact hRx1) (by rw [s1h]; exact hRx2)
    rw [hsA, hsB]
    exact ⟨key.1.trans hLΓ, key.2.trans hLΓ⟩

theorem middle_ref_margins : LeadPsRegularity → ConeGapQuadratic → ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xan Xm Xm2 Xp2 Xp r1 r2 ε κ : ℝ) (F U : ℝ → ℝ → ℝ), JoinProf h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xan Xm Xm2 Xp2 Xp r1 r2 F U → 0 < ε → ProfileReg h cinf Xb ε F U → 0 < κ → ∃ cF k A : ℝ, 0 < cF ∧ 0 < k ∧ k ≤ 1 ∧ 0 ≤ A ∧ (∀ X η : ℝ, Xm ≤ X → X ≤ r2 → -1 < η → η < 1 → cF ≤ F X η) ∧ (∀ X η : ℝ, Xp ≤ X → X ≤ r2 → -1 < η → η < 1 → k ≤ shearA F X η ∧ shearA F X η ≤ A ∧ |shearB F U X η| ≤ A ∧ |psLead1 h F U X η| ≤ A ∧ |psLead2 h F U X η| ≤ A ∧ k ≤ shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) - 2 ∧ k ≤ psLead1 h F U X η - shearB F U X η / shearA F X η * psLead2 h F U X η - shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) ∧ (shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) - 2) * (psLead2 h F U X η + shearB F U X η / shearA F X η * psLead1 h F U X η) ^ 2 ≤ (2 - k) * (psLead1 h F U X η - shearB F U X η / shearA F X η * psLead2 h F U X η - shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2)) ^ 2) ∧ (∀ a b X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 → κ ≤ a → a ≤ 1 / κ → |b| ≤ 1 / κ → κ ≤ a * (1 + (b / a) ^ 2) - 2 → κ ≤ psLead1 h F U X η - b / a * psLead2 h F U X η - 2 → κ ≤ coneUp (psLead1 h F U X η - b / a * psLead2 h F U X η) (psLead2 h F U X η + b / a * psLead1 h F U X η) - a * (1 + (b / a) ^ 2) → k ≤ a ∧ a ≤ A ∧ |b| ≤ A ∧ |psLead1 h F U X η| ≤ A ∧ |psLead2 h F U X η| ≤ A ∧ k ≤ a * (1 + (b / a) ^ 2) - 2 ∧ k ≤ psLead1 h F U X η - b / a * psLead2 h F U X η - a * (1 + (b / a) ^ 2) ∧ (a * (1 + (b / a) ^ 2) - 2) * (psLead2 h F U X η + b / a * psLead1 h F U X η) ^ 2 ≤ (2 - k) * (psLead1 h F U X η - b / a * psLead2 h F U X η - a * (1 + (b / a) ^ 2)) ^ 2) :=
by
  intro hLPR hCG h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xan Xm Xm2 Xp2 Xp r1 r2 ε κ F U hJ hε hPR hκ
  obtain ⟨⟨hh0, hh1, hlam, hcinf, hcp, haa, hab, hXa, hXap1, hp12, hp2m1, hm12, hm2Xv, hXvXc, hXcXb,
    hXaXan, hXanXm, hXmXm2, hXm2Xp2, hXp2Xp, hXpr1, hr1r2, hr2p1⟩, -, -, hJadm, ⟨μ, hμ, hRC⟩, -⟩ := hJ
  obtain ⟨⟨c₀, hc₀, hlow⟩, -, ⟨κa, hκa0, -, hcone⟩⟩ := hJadm
  have hPR' := hPR
  obtain ⟨hFs, hUs, hFpos, hBd, -⟩ := hPR'
  have hXm0 : 0 < Xm := by linarith
  have hXp0 : 0 < Xp := by linarith
  have hXmXp : Xm ≤ Xp := by linarith
  have hXpr2 : Xp ≤ r2 := by linarith
  have hr20 : 0 < r2 := by linarith
  have hr2Xb : r2 < Xb := by linarith
  have hXb0 : 0 < Xb := by linarith
  have hXaXp : Xa < Xp := by linarith

  have adm_to_quad : ∀ κ c1 B f a b q1 q2 : ℝ, 0 < κ → 0 < c1 → 0 < f → f ≤ B → 0 < a →
      c1 ≤ Real.sqrt ((f * (q1 - a)) ^ 2 + (f * (q2 + b)) ^ 2) →
      κ * Real.sqrt ((f * (q1 - a)) ^ 2 + (f * (q2 + b)) ^ 2) ≤ f * (q1 - a) - b / a * (f * (q2 + b)) →
      (a * (1 + (b / a) ^ 2) - 2) * (f * (q2 + b) + b / a * (f * (q1 - a))) ^ 2 ≤
        (2 - κ) * (f * (q1 - a) - b / a * (f * (q2 + b))) ^ 2 →
      κ * c1 / B ≤ q1 - b / a * q2 - a * (1 + (b / a) ^ 2) ∧
      (a * (1 + (b / a) ^ 2) - 2) * (q2 + b / a * q1) ^ 2 ≤
        (2 - κ) * (q1 - b / a * q2 - a * (1 + (b / a) ^ 2)) ^ 2 := by
    intro κ c1 B f a b q1 q2 hκ hc1 hf hfB ha hT hc hq
    have hra : a * (b / a) = b := by field_simp
    have id1 : f * (q1 - a) - b / a * (f * (q2 + b)) = f * (q1 - b / a * q2 - a * (1 + (b / a) ^ 2)) := by
      linear_combination (f * (b / a)) * hra
    have id2 : f * (q2 + b) + b / a * (f * (q1 - a)) = f * (q2 + b / a * q1) := by
      linear_combination (-f) * hra
    rw [id1] at hc
    rw [id1, id2] at hq
    have hfD : κ * c1 ≤ f * (q1 - b / a * q2 - a * (1 + (b / a) ^ 2)) :=
      le_trans (mul_le_mul_of_nonneg_left hT hκ.le) hc
    have hD0 : 0 ≤ q1 - b / a * q2 - a * (1 + (b / a) ^ 2) := by
      by_contra hneg
      push_neg at hneg
      linarith [mul_neg_of_pos_of_neg hf hneg, mul_pos hκ hc1]
    have hB : 0 < B := lt_of_lt_of_le hf hfB
    refine ⟨?_, ?_⟩
    · rw [div_le_iff₀ hB]
      nlinarith [mul_le_mul_of_nonneg_right hfB hD0]
    · have hf2 : 0 < f ^ 2 := by positivity
      have h2 : f ^ 2 * ((a * (1 + (b / a) ^ 2) - 2) * (q2 + b / a * q1) ^ 2) ≤
          f ^ 2 * ((2 - κ) * (q1 - b / a * q2 - a * (1 + (b / a) ^ 2)) ^ 2) := by
        calc f ^ 2 * ((a * (1 + (b / a) ^ 2) - 2) * (q2 + b / a * q1) ^ 2)
            = (a * (1 + (b / a) ^ 2) - 2) * (f * (q2 + b / a * q1)) ^ 2 := by ring
          _ ≤ (2 - κ) * (f * (q1 - b / a * q2 - a * (1 + (b / a) ^ 2))) ^ 2 := hq
          _ = f ^ 2 * ((2 - κ) * (q1 - b / a * q2 - a * (1 + (b / a) ^ 2)) ^ 2) := by ring
      exact le_of_mul_le_mul_left h2 hf2
  have relax_to_quad : ∀ AQ : ℝ, 0 ≤ AQ → ∀ a b q1 q2 : ℝ, κ ≤ a → |b| ≤ 1 / κ → |q1| ≤ AQ → |q2| ≤ AQ →
      κ ≤ a * (1 + (b / a) ^ 2) - 2 → κ ≤ q1 - b / a * q2 - 2 →
      κ ≤ coneUp (q1 - b / a * q2) (q2 + b / a * q1) - a * (1 + (b / a) ^ 2) →
      κ ≤ q1 - b / a * q2 - a * (1 + (b / a) ^ 2) ∧
      (a * (1 + (b / a) ^ 2) - 2) * (q2 + b / a * q1) ^ 2 ≤
        (2 - min 1 (2 * κ ^ 2 / (AQ + AQ / κ ^ 2 + 1) ^ 2)) * (q1 - b / a * q2 - a * (1 + (b / a) ^ 2)) ^ 2 := by
    intro AQ hAQ a b q1 q2 ha hb hq1 hq2 hv hP hcu
    have ha0 : 0 < a := lt_of_lt_of_le hκ ha
    have hrb : |b / a| ≤ 1 / κ ^ 2 := by
      rw [abs_div, abs_of_pos ha0]
      calc |b| / a ≤ (1 / κ) / a := div_le_div_of_nonneg_right hb ha0.le
        _ ≤ (1 / κ) / κ := div_le_div_of_nonneg_left (one_div_pos.mpr hκ).le hκ ha
        _ = 1 / κ ^ 2 := by rw [div_div, ← pow_two]
    have hPle : q1 - b / a * q2 ≤ AQ + AQ / κ ^ 2 := by
      have h1 : q1 ≤ AQ := (le_abs_self q1).trans hq1
      have h2 : -(b / a * q2) ≤ AQ / κ ^ 2 := by
        calc -(b / a * q2) ≤ |b / a * q2| := neg_le_abs _
          _ = |b / a| * |q2| := abs_mul _ _
          _ ≤ (1 / κ ^ 2) * AQ := mul_le_mul hrb hq2 (abs_nonneg _) (by positivity)
          _ = AQ / κ ^ 2 := by ring
      linarith
    exact hCG.1 κ (AQ + AQ / κ ^ 2 + 1) (q1 - b / a * q2) (q2 + b / a * q1) (a * (1 + (b / a) ^ 2)) hκ
      (by linarith) (by linarith) (by linarith)
  have hslice : ∀ f : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿f) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
      ∀ X η : ℝ, 0 ≤ X → -1 < η → η < 1 →
      |deriv (fun Y => f Y η) X| ≤ ‖iteratedFDeriv ℝ 1 (↿f) (X, η)‖ := by
    intro f hf X η hX e1 e2
    have hmem : ((X, η) : ℝ × ℝ) ∈ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 :=
      ⟨show -ε < X by linarith, e1, e2⟩
    have hd : DifferentiableAt ℝ (↿f) (X, η) :=
      (hf.contDiffAt ((isOpen_Ioi.prod isOpen_Ioo).mem_nhds hmem)).differentiableAt (by norm_num)
    have hp : HasDerivAt (fun Y : ℝ => ((Y, η) : ℝ × ℝ)) ((1 : ℝ), (0 : ℝ)) X :=
      (hasDerivAt_id X).prodMk (hasDerivAt_const X η)
    have hc := hd.hasFDerivAt.comp_hasDerivAt X hp
    have heq : deriv (fun Y => f Y η) X = fderiv ℝ (↿f) (X, η) ((1 : ℝ), (0 : ℝ)) := hc.deriv
    rw [heq, norm_iteratedFDeriv_one]
    calc |fderiv ℝ (↿f) (X, η) ((1 : ℝ), (0 : ℝ))|
        = ‖fderiv ℝ (↿f) (X, η) ((1 : ℝ), (0 : ℝ))‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖fderiv ℝ (↿f) (X, η)‖ * ‖((1 : ℝ), (0 : ℝ))‖ := ContinuousLinearMap.le_opNorm _ _
      _ = ‖fderiv ℝ (↿f) (X, η)‖ := by simp [Prod.norm_def]

  obtain ⟨cF, hcFdef⟩ : ∃ c : ℝ, c = min μ κa := ⟨_, rfl⟩
  have hcF : 0 < cF := by rw [hcFdef]; exact lt_min hμ hκa0
  have hcFμ : cF ≤ μ := by rw [hcFdef]; exact min_le_left _ _
  have hcFκ : cF ≤ κa := by rw [hcFdef]; exact min_le_right _ _
  have hFlow : ∀ X η : ℝ, Xm ≤ X → X ≤ r2 → -1 < η → η < 1 → cF ≤ F X η := by
    intro X η h1 h2 e1 e2
    rcases le_total X Xp with hX | hX
    · exact le_trans hcFμ (hRC X ⟨h1, hX⟩ η e1 e2).1
    · exact le_trans hcFκ (hcone X (Or.inr ⟨by linarith, by linarith⟩) η e1 e2).1

  obtain ⟨-, hLb⟩ := hLPR h cinf Xb ε F U hh0 hh1 hXb0 hε hPR
  obtain ⟨AP, hAP⟩ := hLb Xm r2 cF hXm0 hcF hFlow 0
  have hPs : ∀ X η : ℝ, Xm ≤ X → X ≤ r2 → -1 < η → η < 1 →
      |psLead1 h F U X η| ≤ |AP| ∧ |psLead2 h F U X η| ≤ |AP| := by
    intro X η h1 h2 e1 e2
    obtain ⟨q1, q2, -, -⟩ := hAP X η h1 h2 e1 e2
    rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at q1 q2
    have q1' : |psLead1 h F U X η| ≤ AP := q1
    have q2' : |psLead2 h F U X η| ≤ AP := q2
    exact ⟨q1'.trans (le_abs_self _), q2'.trans (le_abs_self _)⟩

  obtain ⟨C0, hC0⟩ := hBd r2 0
  obtain ⟨C1, hC1⟩ := hBd r2 1
  have hB0 : 0 < |C0| + 1 := by positivity
  have hFup : ∀ X η : ℝ, 0 ≤ X → X ≤ r2 → -1 < η → η < 1 → F X η ≤ |C0| + 1 := by
    intro X η h1 h2 e1 e2
    have q := (hC0 X η h1 h2 e1 e2).1
    rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at q
    have q' : |F X η| ≤ C0 := q
    linarith [le_abs_self (F X η), le_abs_self C0]
  have hdF : ∀ X η : ℝ, 0 ≤ X → X ≤ r2 → -1 < η → η < 1 →
      |deriv (fun Y => F Y η) X| ≤ |C1| ∧ |deriv (fun Y => U Y η) X| ≤ |C1| := by
    intro X η h1 h2 e1 e2
    obtain ⟨b1, b2⟩ := hC1 X η h1 h2 e1 e2
    exact ⟨((hslice F hFs X η h1 e1 e2).trans b1).trans (le_abs_self _),
      ((hslice U hUs X η h1 e1 e2).trans b2).trans (le_abs_self _)⟩

  have hs1 : 0 ≤ 2 * r2 * |C1| / cF := div_nonneg (by positivity) hcF.le
  have hs2 : 0 ≤ Real.sqrt (2 * r2) * |C1| / cF := div_nonneg (by positivity) hcF.le
  have hShear : ∀ X η : ℝ, Xp ≤ X → X ≤ r2 → -1 < η → η < 1 →
      |shearA F X η| ≤ 2 * r2 * |C1| / cF ∧ |shearB F U X η| ≤ Real.sqrt (2 * r2) * |C1| / cF := by
    intro X η h1 h2 e1 e2
    have hX0 : 0 < X := by linarith
    have hf : 0 < F X η := hFpos X η hX0.le e1 e2
    have hcf : cF ≤ F X η := hFlow X η (by linarith) h2 e1 e2
    obtain ⟨d1, d2⟩ := hdF X η hX0.le h2 e1 e2
    constructor
    · have e : |shearA F X η| = 2 * X * |deriv (fun Y => F Y η) X| / F X η := by
        unfold shearA
        rw [abs_div, abs_of_pos hf, abs_mul, abs_mul, abs_of_pos hX0]
        norm_num
      rw [e]
      exact div_le_div₀ (by positivity)
        (mul_le_mul (by linarith) d1 (abs_nonneg _) (by linarith)) hcF hcf
    · have e : |shearB F U X η| = Real.sqrt (2 * X) * |deriv (fun Y => U Y η) X| / F X η := by
        unfold shearB
        rw [abs_div, abs_of_pos hf, abs_mul, abs_of_nonneg (Real.sqrt_nonneg _)]
      rw [e]
      exact div_le_div₀ (by positivity)
        (mul_le_mul (Real.sqrt_le_sqrt (by linarith)) d2 (abs_nonneg _) (Real.sqrt_nonneg _)) hcF hcf

  have hL1 : 0 < Real.log (Xp / Xa) := Real.log_pos ((one_lt_div hXa).mpr hXaXp)
  have hL2 : 0 < Real.log (Xb / r2) := Real.log_pos ((one_lt_div hr20).mpr hr2Xb)
  obtain ⟨W, hWdef⟩ : ∃ W : ℝ, W = Real.exp (-(aa / Real.log (Xp / Xa) ^ 2) - ab / Real.log (Xb / r2) ^ 2) :=
    ⟨_, rfl⟩
  have hW0 : 0 < W := by rw [hWdef]; exact Real.exp_pos _
  have hW : ∀ X : ℝ, Xp ≤ X → X ≤ r2 → W ≤ edgeWeight Xa Xb aa ab X := by
    intro X h1 h2
    have hX0 : 0 < X := by linarith
    unfold edgeWeight
    rw [if_pos ⟨by linarith, by linarith⟩, hWdef]
    apply Real.exp_le_exp.mpr
    have l1 : Real.log (Xp / Xa) ≤ Real.log (X / Xa) :=
      Real.log_le_log (div_pos hXp0 hXa) (div_le_div_of_nonneg_right h1 hXa.le)
    have l2 : Real.log (Xb / r2) ≤ Real.log (Xb / X) :=
      Real.log_le_log (div_pos hXb0 hr20) (div_le_div_of_nonneg_left hXb0.le hX0 h2)
    have s1 : aa / Real.log (X / Xa) ^ 2 ≤ aa / Real.log (Xp / Xa) ^ 2 :=
      div_le_div_of_nonneg_left haa.le (pow_pos hL1 2) (pow_le_pow_left₀ hL1.le l1 2)
    have s2 : ab / Real.log (Xb / X) ^ 2 ≤ ab / Real.log (Xb / r2) ^ 2 :=
      div_le_div_of_nonneg_left hab.le (pow_pos hL2 2) (pow_le_pow_left₀ hL2.le l2 2)
    linarith
  have hc1 : 0 < c₀ * W := mul_pos hc₀ hW0

  have hQR : ∀ X η : ℝ, Xp ≤ X → X ≤ r2 → -1 < η → η < 1 →
      κa ≤ shearA F X η ∧
      κa ≤ shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) - 2 ∧
      κa * (c₀ * W) / (|C0| + 1) ≤ psLead1 h F U X η - shearB F U X η / shearA F X η * psLead2 h F U X η -
        shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) ∧
      (shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2) - 2) *
          (psLead2 h F U X η + shearB F U X η / shearA F X η * psLead1 h F U X η) ^ 2 ≤
        (2 - κa) * (psLead1 h F U X η - shearB F U X η / shearA F X η * psLead2 h F U X η -
          shearA F X η * (1 + (shearB F U X η / shearA F X η) ^ 2)) ^ 2 := by
    intro X η h1 h2 e1 e2
    have hX0 : 0 < X := by linarith
    have hmem : X ∈ Ioc Xa Xm2 ∪ Ico Xp2 Xb := Or.inr ⟨by linarith, by linarith⟩
    obtain ⟨-, ka, kv, kc, kq⟩ := hcone X hmem η e1 e2
    have hT := le_trans (mul_le_mul_of_nonneg_left (hW X h1 h2) hc₀.le) (hlow X hmem η e1 e2)
    have eTh : leadStressTh h F U X η = F X η * (psLead1 h F U X η - shearA F X η) := rfl
    have eTz : leadStressTz h F U X η = F X η * (psLead2 h F U X η + shearB F U X η) := rfl
    rw [eTh, eTz] at hT kc kq
    obtain ⟨r1', r2'⟩ := adm_to_quad κa (c₀ * W) (|C0| + 1) (F X η) (shearA F X η) (shearB F U X η)
      (psLead1 h F U X η) (psLead2 h F U X η) hκa0 hc1 (hFpos X η hX0.le e1 e2)
      (hFup X η hX0.le h2 e1 e2) (lt_of_lt_of_le hκa0 ka) hT kc kq
    exact ⟨ka, kv, r1', r2'⟩

  have hWq : 0 < |AP| + |AP| / κ ^ 2 + 1 := by positivity
  have hθ0 : 0 < min 1 (2 * κ ^ 2 / (|AP| + |AP| / κ ^ 2 + 1) ^ 2) :=
    lt_min one_pos (div_pos (mul_pos two_pos (pow_pos hκ 2)) (pow_pos hWq 2))
  obtain ⟨k, hkdef⟩ : ∃ k : ℝ, k = min (min κa (κa * (c₀ * W) / (|C0| + 1)))
      (min κ (min 1 (2 * κ ^ 2 / (|AP| + |AP| / κ ^ 2 + 1) ^ 2))) := ⟨_, rfl⟩
  have hk0 : 0 < k := by
    rw [hkdef]; exact lt_min (lt_min hκa0 (div_pos (mul_pos hκa0 hc1) hB0)) (lt_min hκ hθ0)
  have hkκa : k ≤ κa := by rw [hkdef]; exact (min_le_left _ _).trans (min_le_left _ _)
  have hkq : k ≤ κa * (c₀ * W) / (|C0| + 1) := by
    rw [hkdef]; exact (min_le_left _ _).trans (min_le_right _ _)
  have hkκ : k ≤ κ := by rw [hkdef]; exact (min_le_right _ _).trans (min_le_left _ _)
  have hkθ : k ≤ min 1 (2 * κ ^ 2 / (|AP| + |AP| / κ ^ 2 + 1) ^ 2) := by
    rw [hkdef]; exact (min_le_right _ _).trans (min_le_right _ _)
  have hk1 : k ≤ 1 := hkθ.trans (min_le_left _ _)
  have hκinv : 0 < 1 / κ := one_div_pos.mpr hκ
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = 1 / κ + (2 * r2 * |C1| / cF + Real.sqrt (2 * r2) * |C1| / cF) + |AP| :=
    ⟨_, rfl⟩
  have hAP_A : |AP| ≤ A := by rw [hAdef]; linarith
  have hκ_A : 1 / κ ≤ A := by rw [hAdef]; linarith [abs_nonneg AP]
  have hs1_A : 2 * r2 * |C1| / cF ≤ A := by rw [hAdef]; linarith [abs_nonneg AP]
  have hs2_A : Real.sqrt (2 * r2) * |C1| / cF ≤ A := by rw [hAdef]; linarith [abs_nonneg AP]
  have hA0 : 0 ≤ A := le_trans (abs_nonneg _) hAP_A
  refine ⟨cF, k, A, hcF, hk0, hk1, hA0, hFlow, ?_, ?_⟩
  · intro X η h1 h2 e1 e2
    obtain ⟨ka, kv, kD, kq⟩ := hQR X η h1 h2 e1 e2
    obtain ⟨sA, sB⟩ := hShear X η h1 h2 e1 e2
    obtain ⟨P1, P2⟩ := hPs X η (by linarith) h2 e1 e2
    refine ⟨hkκa.trans ka, ((le_abs_self _).trans sA).trans hs1_A, sB.trans hs2_A, P1.trans hAP_A,
      P2.trans hAP_A, hkκa.trans kv, hkq.trans kD, ?_⟩
    exact le_trans kq (mul_le_mul_of_nonneg_right (by linarith) (sq_nonneg _))
  · intro a b X η h1 h2 e1 e2 ha ha' hb hv hP hcu
    obtain ⟨P1, P2⟩ := hPs X η h1 (by linarith) e1 e2
    obtain ⟨rD, rq⟩ := relax_to_quad |AP| (abs_nonneg _) a b (psLead1 h F U X η) (psLead2 h F U X η)
      ha hb P1 P2 hv hP hcu
    refine ⟨hkκ.trans ha, ha'.trans hκ_A, hb.trans hκ_A, P1.trans hAP_A, P2.trans hAP_A, hkκ.trans hv,
      hkκ.trans rD, ?_⟩
    exact le_trans rq (mul_le_mul_of_nonneg_right (by linarith) (sq_nonneg _))

theorem quad_cone_stress : ∀ k A c : ℝ, 0 < k → k ≤ 1 → 0 ≤ A → 0 < c → ∃ κ' c' : ℝ, 0 < κ' ∧ κ' < 2 ∧ 0 < c' ∧ ∀ f a b p1 p2 : ℝ, c ≤ f → k ≤ a → |b| ≤ A → k ≤ a * (1 + (b / a) ^ 2) - 2 → k ≤ p1 - b / a * p2 - a * (1 + (b / a) ^ 2) → (a * (1 + (b / a) ^ 2) - 2) * (p2 + b / a * p1) ^ 2 ≤ (2 - k) * (p1 - b / a * p2 - a * (1 + (b / a) ^ 2)) ^ 2 → c' ≤ Real.sqrt ((f * (p1 - a)) ^ 2 + (f * (p2 + b)) ^ 2) ∧ κ' ≤ f ∧ κ' ≤ a ∧ κ' ≤ a * (1 + (b / a) ^ 2) - 2 ∧ κ' * Real.sqrt ((f * (p1 - a)) ^ 2 + (f * (p2 + b)) ^ 2) ≤ f * (p1 - a) - b / a * (f * (p2 + b)) ∧ (a * (1 + (b / a) ^ 2) - 2) * (f * (p2 + b) + b / a * (f * (p1 - a))) ^ 2 ≤ (2 - κ') * (f * (p1 - a) - b / a * (f * (p2 + b))) ^ 2 :=
by
  intro k A c hk hk1 hA hc
  have hkA : 0 < k + A := by linarith
  refine ⟨min c (k / 3), c * k ^ 2 / (k + A), lt_min hc (by linarith),
    by linarith [min_le_right c (k / 3)], div_pos (mul_pos hc (pow_pos hk 2)) hkA, ?_⟩
  intro f a b p1 p2 h1 h2 h3 h4 h5 h6
  have ha : 0 < a := lt_of_lt_of_le hk h2
  have hf : 0 < f := lt_of_lt_of_le hc h1
  have hb : b = b / a * a := (div_mul_cancel₀ b ha.ne').symm
  generalize b / a = r at hb h4 h5 h6 ⊢
  subst hb
  have hκc : min c (k / 3) ≤ c := min_le_left _ _
  have hκk : min c (k / 3) ≤ k / 3 := min_le_right _ _
  have hκ0 : 0 < min c (k / 3) := lt_min hc (by linarith)
  set κ := min c (k / 3) with hκ
  have hN0 : 0 ≤ Real.sqrt ((f * (p1 - a)) ^ 2 + (f * (p2 + r * a)) ^ 2) := Real.sqrt_nonneg _
  have hN2 : Real.sqrt ((f * (p1 - a)) ^ 2 + (f * (p2 + r * a)) ^ 2) ^ 2
      = (f * (p1 - a)) ^ 2 + (f * (p2 + r * a)) ^ 2 := Real.sq_sqrt (by positivity)
  set N := Real.sqrt ((f * (p1 - a)) ^ 2 + (f * (p2 + r * a)) ^ 2) with hN
  have e1 : f * (p1 - a) - r * (f * (p2 + r * a)) = f * (p1 - r * p2 - a * (1 + r ^ 2)) := by ring
  have e2 : f * (p2 + r * a) + r * (f * (p1 - a)) = f * (p2 + r * p1) := by ring
  have hid : (1 + r ^ 2) * N ^ 2
      = (f * (p1 - r * p2 - a * (1 + r ^ 2))) ^ 2 + (f * (p2 + r * p1)) ^ 2 := by
    rw [hN2, ← e1, ← e2]; ring
  set D := p1 - r * p2 - a * (1 + r ^ 2) with hD
  set P := p2 + r * p1 with hP
  set Q := a * (1 + r ^ 2) - 2 with hQ
  have hX : c * k ≤ f * D := mul_le_mul h1 h5 hk.le hf.le
  have hX0 : 0 < f * D := lt_of_lt_of_le (mul_pos hc hk) hX
  have h6' : Q * (f * P) ^ 2 ≤ (2 - k) * (f * D) ^ 2 := by
    have := mul_le_mul_of_nonneg_left h6 (sq_nonneg f)
    calc Q * (f * P) ^ 2 = f ^ 2 * (Q * P ^ 2) := by ring
      _ ≤ f ^ 2 * ((2 - k) * D ^ 2) := this
      _ = (2 - k) * (f * D) ^ 2 := by ring
  rw [e1, e2]
  refine ⟨?_, by linarith, by linarith, by linarith, ?_, ?_⟩
  ·
    have hr : r ^ 2 * k ^ 2 ≤ A ^ 2 := by
      have h3' : |r * a| ≤ A := h3
      rw [abs_mul, abs_of_pos ha] at h3'
      have h3'' : |r| * k ≤ A := le_trans (mul_le_mul_of_nonneg_left h2 (abs_nonneg r)) h3'
      have h0 : 0 ≤ |r| * k := mul_nonneg (abs_nonneg r) hk.le
      calc r ^ 2 * k ^ 2 = (|r| * k) ^ 2 := by rw [mul_pow, sq_abs]
        _ ≤ A ^ 2 := pow_le_pow_left₀ h0 h3'' 2
    have hcX : (c * k) ^ 2 ≤ (f * D) ^ 2 := pow_le_pow_left₀ (mul_pos hc hk).le hX 2
    have hN1 : (f * D) ^ 2 ≤ (1 + r ^ 2) * N ^ 2 := by nlinarith [sq_nonneg (f * P)]
    have hsq : (c * k ^ 2) ^ 2 ≤ ((k + A) * N) ^ 2 := by
      calc (c * k ^ 2) ^ 2 = k ^ 2 * (c * k) ^ 2 := by ring
        _ ≤ k ^ 2 * ((1 + r ^ 2) * N ^ 2) :=
            mul_le_mul_of_nonneg_left (hcX.trans hN1) (sq_nonneg k)
        _ = (k ^ 2 + r ^ 2 * k ^ 2) * N ^ 2 := by ring
        _ ≤ (k + A) ^ 2 * N ^ 2 :=
            mul_le_mul_of_nonneg_right (by nlinarith [mul_nonneg hk.le hA]) (sq_nonneg N)
        _ = ((k + A) * N) ^ 2 := by ring
    have hle : c * k ^ 2 ≤ (k + A) * N :=
      (pow_le_pow_iff_left₀ (mul_pos hc (pow_pos hk 2)).le (mul_nonneg hkA.le hN0)
        two_ne_zero).mp hsq
    rw [div_le_iff₀ hkA]
    linarith
  ·
    have hN1 : N ^ 2 ≤ (f * D) ^ 2 + (f * P) ^ 2 := by
      nlinarith [mul_nonneg (sq_nonneg r) (sq_nonneg N)]
    have hY : k * (f * P) ^ 2 ≤ (2 - k) * (f * D) ^ 2 :=
      le_trans (mul_le_mul_of_nonneg_right h4 (sq_nonneg _)) h6'
    have hkN : k * N ^ 2 ≤ 2 * (f * D) ^ 2 := by
      nlinarith [mul_le_mul_of_nonneg_left hN1 hk.le]
    have hκ2 : 2 * κ ^ 2 ≤ k := by
      nlinarith [mul_le_mul hκk hκk hκ0.le (by linarith : (0:ℝ) ≤ k / 3)]
    have hmain : k * (κ * N) ^ 2 ≤ k * (f * D) ^ 2 := by
      calc k * (κ * N) ^ 2 = κ ^ 2 * (k * N ^ 2) := by ring
        _ ≤ κ ^ 2 * (2 * (f * D) ^ 2) := mul_le_mul_of_nonneg_left hkN (sq_nonneg _)
        _ = (2 * κ ^ 2) * (f * D) ^ 2 := by ring
        _ ≤ k * (f * D) ^ 2 := mul_le_mul_of_nonneg_right hκ2 (sq_nonneg _)
    have hsq := le_of_mul_le_mul_left hmain hk
    exact (pow_le_pow_iff_left₀ (mul_nonneg hκ0.le hN0) hX0.le two_ne_zero).mp hsq
  ·
    exact h6'.trans (mul_le_mul_of_nonneg_right (by linarith) (sq_nonneg _))

theorem quad_margin_stable : ∀ k A : ℝ, 0 < k → k ≤ 1 → 0 ≤ A → ∃ τ0 : ℝ, 0 < τ0 ∧ ∀ a b p1 p2 a' b' p1' p2' : ℝ, k ≤ a → a ≤ A → |b| ≤ A → |p1| ≤ A → |p2| ≤ A → k ≤ a * (1 + (b / a) ^ 2) - 2 → k ≤ p1 - b / a * p2 - a * (1 + (b / a) ^ 2) → (a * (1 + (b / a) ^ 2) - 2) * (p2 + b / a * p1) ^ 2 ≤ (2 - k) * (p1 - b / a * p2 - a * (1 + (b / a) ^ 2)) ^ 2 → |a' - a| ≤ τ0 → |b' - b| ≤ τ0 → |p1' - p1| ≤ τ0 → |p2' - p2| ≤ τ0 → k / 2 ≤ a' ∧ a' ≤ A + 1 ∧ |b'| ≤ A + 1 ∧ |p1'| ≤ A + 1 ∧ |p2'| ≤ A + 1 ∧ k / 2 ≤ a' * (1 + (b' / a') ^ 2) - 2 ∧ k / 2 ≤ p1' - b' / a' * p2' - a' * (1 + (b' / a') ^ 2) ∧ (a' * (1 + (b' / a') ^ 2) - 2) * (p2' + b' / a' * p1') ^ 2 ≤ (2 - k / 2) * (p1' - b' / a' * p2' - a' * (1 + (b' / a') ^ 2)) ^ 2 :=
by
  intro k A hk hk1 hA

  have key : ∀ g1 g2 q g1' g2' q' : ℝ, k ≤ g1 → k ≤ g2 → g1 * q ^ 2 ≤ (2 - k) * g2 ^ 2 →
      |g1' - g1| ≤ k ^ 3 / 4 → |g2' - g2| ≤ k ^ 3 / 4 →
      |((2 - k / 2) * g2' ^ 2 - g1' * q' ^ 2) - ((2 - k / 2) * g2 ^ 2 - g1 * q ^ 2)| ≤ k ^ 3 / 4 →
      k / 2 ≤ g1' ∧ k / 2 ≤ g2' ∧ g1' * q' ^ 2 ≤ (2 - k / 2) * g2' ^ 2 := by
    intro g1 g2 q g1' g2' q' h1 h2 h3 e1 e2 e3
    have hk3 : k ^ 3 ≤ k := by
      have : k ^ 2 ≤ 1 := by nlinarith
      nlinarith
    have hsq : k ^ 2 ≤ g2 ^ 2 := by nlinarith
    obtain ⟨e1l, e1r⟩ := abs_le.mp e1
    obtain ⟨e2l, e2r⟩ := abs_le.mp e2
    obtain ⟨e3l, e3r⟩ := abs_le.mp e3
    refine ⟨by linarith, by linarith, ?_⟩
    have hk3' : k * k ^ 2 = k ^ 3 := by ring
    nlinarith [mul_le_mul_of_nonneg_left hsq (by linarith : (0:ℝ) ≤ k / 2)]

  set K : Set (ℝ × ℝ × ℝ × ℝ) := Set.Icc (k / 2) (A + 1) ×ˢ (Set.Icc (-(A + 1)) (A + 1) ×ˢ
    (Set.Icc (-(A + 1)) (A + 1) ×ˢ Set.Icc (-(A + 1)) (A + 1))) with hKdef
  have hKc : IsCompact K :=
    isCompact_Icc.prod (isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc))
  have hne : ∀ x ∈ K, x.1 ≠ 0 := by
    intro x hx
    have h := hx.1.1
    have : 0 < x.1 := lt_of_lt_of_le (by linarith) h
    exact this.ne'
  let Φ1 : ℝ × ℝ × ℝ × ℝ → ℝ := fun x => x.1 * (1 + (x.2.1 / x.1) ^ 2) - 2
  let Φ2 : ℝ × ℝ × ℝ × ℝ → ℝ := fun x =>
    x.2.2.1 - x.2.1 / x.1 * x.2.2.2 - x.1 * (1 + (x.2.1 / x.1) ^ 2)
  let Φ3 : ℝ × ℝ × ℝ × ℝ → ℝ := fun x =>
    (2 - k / 2) * (x.2.2.1 - x.2.1 / x.1 * x.2.2.2 - x.1 * (1 + (x.2.1 / x.1) ^ 2)) ^ 2 -
      (x.1 * (1 + (x.2.1 / x.1) ^ 2) - 2) * (x.2.2.2 + x.2.1 / x.1 * x.2.2.1) ^ 2
  have c1 : ContinuousOn (fun x : ℝ × ℝ × ℝ × ℝ => x.1) K := continuous_fst.continuousOn
  have c21 : ContinuousOn (fun x : ℝ × ℝ × ℝ × ℝ => x.2.1) K := continuous_snd.fst.continuousOn
  have c221 : ContinuousOn (fun x : ℝ × ℝ × ℝ × ℝ => x.2.2.1) K :=
    continuous_snd.snd.fst.continuousOn
  have c222 : ContinuousOn (fun x : ℝ × ℝ × ℝ × ℝ => x.2.2.2) K :=
    continuous_snd.snd.snd.continuousOn
  have hr : ContinuousOn (fun x : ℝ × ℝ × ℝ × ℝ => x.2.1 / x.1) K := c21.div c1 hne
  have hm : ContinuousOn (fun x : ℝ × ℝ × ℝ × ℝ => x.1 * (1 + (x.2.1 / x.1) ^ 2)) K :=
    c1.mul (continuousOn_const.add (hr.pow 2))
  have hc1 : ContinuousOn Φ1 K := hm.sub continuousOn_const
  have hc2 : ContinuousOn Φ2 K := (c221.sub (hr.mul c222)).sub hm
  have hc3 : ContinuousOn Φ3 K :=
    (continuousOn_const.mul (hc2.pow 2)).sub (hc1.mul ((c222.add (hr.mul c221)).pow 2))
  have hε : (0:ℝ) < k ^ 3 / 4 := by positivity
  obtain ⟨δ1, hδ1, h1⟩ :=
    (Metric.uniformContinuousOn_iff_le.mp (hKc.uniformContinuousOn_of_continuous hc1)) _ hε
  obtain ⟨δ2, hδ2, h2⟩ :=
    (Metric.uniformContinuousOn_iff_le.mp (hKc.uniformContinuousOn_of_continuous hc2)) _ hε
  obtain ⟨δ3, hδ3, h3⟩ :=
    (Metric.uniformContinuousOn_iff_le.mp (hKc.uniformContinuousOn_of_continuous hc3)) _ hε
  set τ := min (min δ1 (min δ2 δ3)) (k / 2) with hτdef
  have hτpos : 0 < τ := lt_min (lt_min hδ1 (lt_min hδ2 hδ3)) (by linarith)
  have hτ1 : τ ≤ δ1 := (min_le_left _ _).trans (min_le_left _ _)
  have hτ2 : τ ≤ δ2 := (min_le_left _ _).trans ((min_le_right _ _).trans (min_le_left _ _))
  have hτ3 : τ ≤ δ3 := (min_le_left _ _).trans ((min_le_right _ _).trans (min_le_right _ _))
  have hτk : τ ≤ k / 2 := min_le_right _ _
  refine ⟨τ, hτpos, ?_⟩
  intro a b p1 p2 a' b' p1' p2' ha haA hb hp1 hp2 hG1 hG2 hQ ha' hb' hp1' hp2'
  obtain ⟨ha'l, ha'r⟩ := abs_le.mp ha'
  obtain ⟨hb'l, hb'r⟩ := abs_le.mp hb'
  obtain ⟨hp1'l, hp1'r⟩ := abs_le.mp hp1'
  obtain ⟨hp2'l, hp2'r⟩ := abs_le.mp hp2'
  obtain ⟨hbl, hbr⟩ := abs_le.mp hb
  obtain ⟨hp1l, hp1r⟩ := abs_le.mp hp1
  obtain ⟨hp2l, hp2r⟩ := abs_le.mp hp2
  have hk2 : k / 2 ≤ 1 / 2 := by linarith
  have hxK : ((a, b, p1, p2) : ℝ × ℝ × ℝ × ℝ) ∈ K :=
    ⟨⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩,
      ⟨by linarith, by linarith⟩⟩
