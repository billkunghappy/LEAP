        have hc : ContinuousOn (fun Y : ℝ => ((Y, w) : ℝ × ℂ)) (Ioo 0 Xi) :=
          (continuous_id.prodMk continuous_const).continuousOn
        exact (h2 (j + 1)).comp hc (fun Y hY => ⟨hY, hw⟩)
      have := t_s3 Xi |C j| |C (j + 1)| (fun t => kk t * t ^ j) (rc j) (rc (j + 1)) w X
        (hκc j) (hκi j) hX hXi' (fun Y a b => h4 j Y w a b hw) hψc
        (fun Y a b => hbC j Y w a b hwj) (fun Y a b => hbC (j + 1) Y w a b hw)
      have e : (fun Y => I j Y w) =
          fun Y => ∫ t in (0:ℝ)..1, ((kk t * t ^ j : ℝ) : ℂ) * rc j (t * Y) w :=
        funext fun Y => hI j Y w
      rw [e, hI (j + 1) X w]
      convert this using 1
      refine intervalIntegral.integral_congr (fun t _ => ?_)
      congr 1
      push_cast
      ring
    have hstrip1 : ∀ j : ℕ, cStrip (ρ j) ⊆ cStrip (ρ (j - 1)) :=
      fun j => hmono _ _ (hanti (Nat.sub_le j 1))
    have hstrip2 : ∀ j : ℕ, cStrip (ρ (j + 1)) ⊆ cStrip (ρ (j - 1 + 1)) :=
      fun j => hmono _ _ (hanti (by omega))
    have hI0 : ∀ X e : ℝ, 0 < X → X < Xi → -1 < e → e < 1 →
        I 0 X (e : ℂ) = ((∫ t in (0:ℝ)..1, kk t * r (t * X) e : ℝ) : ℂ) := by
      intro X e hX hXi' he1 he2
      rw [hI, ← intervalIntegral.integral_ofReal]
      refine intervalIntegral.integral_congr_ae (Filter.Eventually.of_forall fun t ht => ?_)
      rw [uIoc_of_le zero_le_one] at ht
      have hm := hmapT t ht X hX hXi'
      rw [h5 _ _ hm.1 hm.2 he1 he2, pow_zero, mul_one]
      push_cast
      ring
    refine ⟨⟨fun j X w => (X : ℂ) * I j X w + (j : ℂ) * I (j - 1) X w, ρ,
      fun j => Xi * ((∫ t in (0:ℝ)..1, |kk t * t ^ j|) * |C j|) +
        j * ((∫ t in (0:ℝ)..1, |kk t * t ^ (j - 1)|) * |C (j - 1)|), h1, ?_, ?_, ?_, ?_⟩, ?_⟩
    · intro j
      exact ((Complex.continuous_ofReal.comp continuous_fst).continuousOn.mul (hlev2 j).1).add
        (continuousOn_const.mul ((hlev2 (j - 1)).1.mono (prod_mono subset_rfl (hstrip1 j))))
    · intro j X hX hXi'
      refine ⟨?_, fun w hw => ?_⟩
      · exact ((differentiableOn_const _).mul (hdiff j X hX hXi')).add
          ((differentiableOn_const _).mul ((hdiff (j - 1) X hX hXi').mono (hstrip1 j)))
      · have hb1 := (hlev2 j).2 X w hX hXi' hw
        have hb2 := (hlev2 (j - 1)).2 X w hX hXi' (hstrip1 j hw)
        calc ‖(X : ℂ) * I j X w + (j : ℂ) * I (j - 1) X w‖
            ≤ ‖(X : ℂ) * I j X w‖ + ‖(j : ℂ) * I (j - 1) X w‖ := norm_add_le _ _
          _ = X * ‖I j X w‖ + j * ‖I (j - 1) X w‖ := by
            rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_of_nonneg hX.le,
              Complex.norm_natCast]
          _ ≤ _ := add_le_add (mul_le_mul hXi'.le hb1 (norm_nonneg _) hXi.le)
            (mul_le_mul_of_nonneg_left hb2 (Nat.cast_nonneg _))
    · intro j X w hX hXi' hw
      have hA := hderI j X w hX hXi' hw
      have hB := hderI (j - 1) X w hX hXi' (hstrip2 j hw)
      have hofr : HasDerivAt (fun Y : ℝ => (Y : ℂ)) 1 X := by
        simpa using (hasDerivAt_id X).ofReal_comp
      have hT := (hofr.mul hA).add (hB.const_mul (j : ℂ))
      refine hT.congr_deriv ?_
      rcases j with _ | i
      · show 1 * I 0 X w + (X : ℂ) * I 1 X w + ((0 : ℕ) : ℂ) * I 1 X w =
          (X : ℂ) * I 1 X w + ((1 : ℕ) : ℂ) * I 0 X w
        push_cast
        ring
      · simp only [Nat.add_sub_cancel]
        push_cast
        ring
    · intro X η hX hXi' he1 he2
      show (X : ℂ) * I 0 X η + ((0 : ℕ) : ℂ) * I (0 - 1) X η = ((bgKer kk r X η : ℝ) : ℂ)
      rw [hI0 X η hX hXi' he1 he2, bgKer]
      push_cast
      ring
    · intro X η hX hXi' he1 he2
      have hη : ((η : ℂ)) ∈ cStrip (ρ 0) := hreal _ η (h1 0).1 he1 he2
      obtain ⟨hint, hJ⟩ := hlev1 0 X hX hXi' (η : ℂ) hη
      have hd1 : HasDerivAt (fun e : ℝ => X * (I 0 X (e : ℂ)).re)
          (X * (∫ t in (0:ℝ)..1,
            deriv (fun z => ((kk t * t ^ 0 : ℝ) : ℂ) * rc 0 (t * X) z) (η : ℂ)).re) η :=
        hJ.real_of_complex.const_mul X
      have heq : (fun e => bgKer kk r X e) =ᶠ[nhds η] fun e : ℝ => X * (I 0 X (e : ℂ)).re := by
        filter_upwards [Ioo_mem_nhds he1 he2] with e he
        rw [hI0 X e hX hXi' he.1 he.2, Complex.ofReal_re, bgKer]
      have hpd : pdE (bgKer kk r) X η = X * (∫ t in (0:ℝ)..1,
          deriv (fun z => ((kk t * t ^ 0 : ℝ) : ℂ) * rc 0 (t * X) z) (η : ℂ)).re := by
        unfold pdE
        exact (hd1.congr_of_eventuallyEq heq).deriv
      rw [hpd, bgKer]
      congr 1
      have hre : (∫ t in (0:ℝ)..1,
          deriv (fun z => ((kk t * t ^ 0 : ℝ) : ℂ) * rc 0 (t * X) z) (η : ℂ)).re =
          ∫ t in (0:ℝ)..1,
            (deriv (fun z => ((kk t * t ^ 0 : ℝ) : ℂ) * rc 0 (t * X) z) (η : ℂ)).re := by
        have := ContinuousLinearMap.intervalIntegral_comp_comm Complex.reCLM hint
        simp only [Complex.reCLM_apply] at this
        exact this.symm
      rw [hre]
      refine intervalIntegral.integral_congr_ae (Filter.Eventually.of_forall fun t ht => ?_)
      rw [uIoc_of_le zero_le_one] at ht
      have hm := hmapT t ht X hX hXi'
      have hda : DifferentiableAt ℂ (rc 0 (t * X)) (η : ℂ) :=
        ((h3 0 _ hm.1 hm.2).1).differentiableAt ((hopen _).mem_nhds hη)
      rw [deriv_const_mul _ hda, Complex.re_ofReal_mul, pow_zero, mul_one]
      congr 1
      have hd := hda.hasDerivAt.real_of_complex
      have heq2 : (fun e => r (t * X) e) =ᶠ[nhds η]
          fun x : ℝ => (rc 0 (t * X) (x : ℂ)).re := by
        filter_upwards [Ioo_mem_nhds he1 he2] with e he
        rw [h5 _ _ hm.1 hm.2 he.1 he.2, Complex.ofReal_re]
      unfold pdE
      exact ((hd.congr_of_eventuallyEq heq2).deriv).symm

  intro Xi r hXi hr
  have hk := t_main Xi r hXi hr
  have hlogc : ContinuousOn Real.log (Ioc 0 1) :=
    Real.continuousOn_log.mono (fun t ht => (ne_of_gt ht.1 : t ≠ 0))
  refine ⟨?_, ?_⟩
  · obtain ⟨fc, ρ, C, a, b, c, d, e⟩ := (hk (fun _ => 1) continuousOn_const
      (intervalIntegrable_const)).1
    refine ⟨fc, ρ, C, a, b, c, d, fun X η hX hXi' h1 h2 => ?_⟩
    rw [e X η hX hXi' h1 h2]
    congr 1
    unfold bgKer profRadInt
    simp only [one_mul]
    have := intervalIntegral.integral_comp_mul_right (fun x => r x η) hX.ne' (a := 0) (b := 1)
    rw [this, zero_mul, one_mul, smul_eq_mul, mul_inv_cancel_left₀ hX.ne']
  · intro kk hkk
    rcases hkk with rfl | rfl | rfl | rfl | rfl
    · have hc : Continuous bgkG := (continuous_const.sub continuous_id).div_const 2
      exact hk _ hc.continuousOn (hc.intervalIntegrable 0 1)
    · have hc : Continuous bgkGp := continuous_id.div_const 2
      exact hk _ hc.continuousOn (hc.intervalIntegrable 0 1)
    · exact hk _ (hlogc.neg.div_const 2) (intervalIntegral.intervalIntegrable_log'.neg.div_const 2)
    · have hc : Continuous bgkUp := continuous_const
      exact hk _ hc.continuousOn (hc.intervalIntegrable 0 1)
    · exact hk _ (((continuous_id.sub continuous_const).continuousOn.sub hlogc).div_const 2)
        ((((continuous_id.sub continuous_const).intervalIntegrable 0 1).sub
          intervalIntegral.intervalIntegrable_log').div_const 2)

theorem bgKer_identities : ∀ (Xi : ℝ) (r : ℝ → ℝ → ℝ), 0 < Xi → BgHolo Xi r → ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 → X * pdX (bgKer bgkG r) X η = bgKer bgkGp r X η ∧ 2 * (X * pdX (pdX (bgKer bgkG r)) X η + 2 * pdX (bgKer bgkG r) X η) = r X η ∧ bgUz (bgKer bgkS r) X η = bgKer bgkU r X η ∧ X * pdX (bgUz (bgKer bgkS r)) X η = bgKer bgkUp r X η ∧ 2 * (X * pdX (pdX (bgUz (bgKer bgkS r))) X η + pdX (bgUz (bgKer bgkS r)) X η) = r X η ∧ pdE (bgUz (bgKer bgkS r)) X η = pdE (bgKer bgkU r) X η :=
by
  intro Xi r hXi hr X η hX0 hX1 hη1 hη2

  have hderiv : ∀ (F Fh : ℝ → ℝ) (c Y : ℝ), 0 < Y → Y < Xi →
      (∀ Z, 0 < Z → Z < Xi → F Z = Fh Z) → HasDerivAt Fh c Y → deriv F Y = c := by
    intro F Fh c Y h0 h1 hEq hd
    have hev : F =ᶠ[nhds Y] Fh := by
      filter_upwards [Ioo_mem_nhds h0 h1] with Z hZ
      exact hEq Z hZ.1 hZ.2
    exact (hd.congr_of_eventuallyEq hev).deriv

  have hC : ∀ e : ℝ, -1 < e → e < 1 →
      X * pdX (bgKer bgkG r) X e = bgKer bgkGp r X e ∧
      2 * (X * pdX (pdX (bgKer bgkG r)) X e + 2 * pdX (bgKer bgkG r) X e) = r X e ∧
      bgUz (bgKer bgkS r) X e = bgKer bgkU r X e ∧
      X * pdX (bgUz (bgKer bgkS r)) X e = bgKer bgkUp r X e ∧
      2 * (X * pdX (pdX (bgUz (bgKer bgkS r))) X e + pdX (bgUz (bgKer bgkS r)) X e) = r X e := by
    intro e he1 he2

    have hs1 : ContinuousOn (fun x => r x e) (Ioo 0 Xi) ∧
        ∃ M : ℝ, ∀ x : ℝ, 0 < x → x < Xi → |r x e| ≤ M := by
      obtain ⟨fc, ρ, C, hρ, -, hb, hd, h0⟩ := hr
      have hmem : ∀ k, (e : ℂ) ∈ cStrip (ρ k) := by
        intro k
        have := (hρ k).1
        simp only [cStrip, Set.mem_setOf_eq, Complex.ofReal_im, Complex.ofReal_re, abs_zero]
        exact ⟨this, by linarith, by linarith⟩
      refine ⟨?_, C 0, fun x hx0 hx1 => ?_⟩
      · intro x hx
        have hca : ContinuousAt (fun Y => (fc 0 Y (e : ℂ)).re) x :=
          Complex.continuous_re.continuousAt.comp (hd 0 x _ hx.1 hx.2 (hmem 1)).continuousAt
        have hev : (fun Y => (fc 0 Y (e : ℂ)).re) =ᶠ[nhds x] (fun Y => r Y e) := by
          filter_upwards [Ioo_mem_nhds hx.1 hx.2] with Y hY
          rw [h0 Y e hY.1 hY.2 he1 he2, Complex.ofReal_re]
        exact (hca.congr hev).continuousWithinAt
      · have := (hb 0 x hx0 hx1).2 _ (hmem 0)
        rw [h0 x e hx0 hx1 he1 he2, Complex.norm_real, Real.norm_eq_abs] at this
        exact this
    obtain ⟨hc, M, hM⟩ := hs1

    have hint : ∀ Y : ℝ, 0 < Y → Y < Xi →
        IntervalIntegrable (fun x => r x e) volume 0 Y ∧
        IntervalIntegrable (fun x => x * r x e) volume 0 Y ∧
        IntervalIntegrable (fun x => Real.log x * r x e) volume 0 Y := by
      intro Y hY0 hY
      have hsub : Ioc 0 Y ⊆ Ioo 0 Xi := fun x hx => ⟨hx.1, lt_of_le_of_lt hx.2 hY⟩
      have hcY : ContinuousOn (fun x => r x e) (Ioc 0 Y) := hc.mono hsub
      have hP : IntervalIntegrable (fun x => r x e) volume 0 Y := by
        refine IntervalIntegrable.mono_fun' (g := fun _ => M) intervalIntegrable_const ?_ ?_
        · rw [Set.uIoc_of_le hY0.le]
          exact hcY.aestronglyMeasurable measurableSet_Ioc
        · rw [Set.uIoc_of_le hY0.le]
          refine ae_restrict_of_forall_mem measurableSet_Ioc (fun x hx => ?_)
          show ‖r x e‖ ≤ M
          rw [Real.norm_eq_abs]; exact hM x hx.1 (lt_of_le_of_lt hx.2 hY)
      refine ⟨hP, ?_, ?_⟩
      · exact hP.continuousOn_mul continuousOn_id
      · have hg : IntervalIntegrable (fun x => M * ‖Real.log x‖) volume 0 Y :=
          (intervalIntegral.intervalIntegrable_log').norm.const_mul M
        refine IntervalIntegrable.mono_fun' hg ?_ ?_
        · rw [Set.uIoc_of_le hY0.le]
          exact ((Real.continuousOn_log.mono (fun x hx => hx.1.ne')).mul hcY).aestronglyMeasurable
            measurableSet_Ioc
        · rw [Set.uIoc_of_le hY0.le]
          refine ae_restrict_of_forall_mem measurableSet_Ioc (fun x hx => ?_)
          show ‖Real.log x * r x e‖ ≤ M * ‖Real.log x‖
          rw [norm_mul, mul_comm]
          exact mul_le_mul_of_nonneg_right
            (by rw [Real.norm_eq_abs]; exact hM x hx.1 (lt_of_le_of_lt hx.2 hY)) (norm_nonneg _)

    obtain ⟨P, hPdef⟩ : ∃ P : ℝ → ℝ, P = fun Z => ∫ x in (0:ℝ)..Z, r x e := ⟨_, rfl⟩
    obtain ⟨Q, hQdef⟩ : ∃ Q : ℝ → ℝ, Q = fun Z => ∫ x in (0:ℝ)..Z, x * r x e := ⟨_, rfl⟩
    obtain ⟨L, hLdef⟩ : ∃ L : ℝ → ℝ, L = fun Z => ∫ x in (0:ℝ)..Z, Real.log x * r x e := ⟨_, rfl⟩

    have hftc : ∀ (f : ℝ → ℝ) (Y : ℝ), 0 < Y → Y < Xi → ContinuousOn f (Ioo 0 Xi) →
        IntervalIntegrable f volume 0 Y → HasDerivAt (fun Z => ∫ x in (0:ℝ)..Z, f x) (f Y) Y :=
      fun f Y h0 h1 hf hi => intervalIntegral.integral_hasDerivAt_right hi
        (hf.stronglyMeasurableAtFilter isOpen_Ioo Y ⟨h0, h1⟩) (hf.continuousAt (Ioo_mem_nhds h0 h1))
    have hcQ : ContinuousOn (fun x => x * r x e) (Ioo 0 Xi) := continuousOn_id.mul hc
    have hcL : ContinuousOn (fun x => Real.log x * r x e) (Ioo 0 Xi) :=
      (Real.continuousOn_log.mono (fun x hx => hx.1.ne')).mul hc
    have dP : ∀ Y, 0 < Y → Y < Xi → HasDerivAt P (r Y e) Y := fun Y h0 h1 => by
      rw [hPdef]; exact hftc _ Y h0 h1 hc (hint Y h0 h1).1
    have dQ : ∀ Y, 0 < Y → Y < Xi → HasDerivAt Q (Y * r Y e) Y := fun Y h0 h1 => by
      rw [hQdef]; exact hftc (fun x => x * r x e) Y h0 h1 hcQ (hint Y h0 h1).2.1
    have dL : ∀ Y, 0 < Y → Y < Xi → HasDerivAt L (Real.log Y * r Y e) Y := fun Y h0 h1 => by
      rw [hLdef]; exact hftc (fun x => Real.log x * r x e) Y h0 h1 hcL (hint Y h0 h1).2.2

    have hlin : ∀ Y, 0 < Y → Y < Xi → ∀ a b c : ℝ,
        (∫ x in (0:ℝ)..Y, (a * r x e + b * (x * r x e) + c * (Real.log x * r x e))) =
          a * P Y + b * Q Y + c * L Y := by
      intro Y h0 h1 a b c
      obtain ⟨i1, i2, i3⟩ := hint Y h0 h1
      rw [intervalIntegral.integral_add ((i1.const_mul a).add (i2.const_mul b)) (i3.const_mul c),
        intervalIntegral.integral_add (i1.const_mul a) (i2.const_mul b),
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul, hPdef, hQdef, hLdef]
    have hcf : ∀ Y, 0 < Y → Y < Xi →
        bgKer bgkG r Y e = P Y / 2 - Q Y / (2 * Y) ∧ bgKer bgkGp r Y e = Q Y / (2 * Y) ∧
        bgKer bgkU r Y e = (Real.log Y * P Y - L Y) / 2 ∧ bgKer bgkUp r Y e = P Y / 2 ∧
        bgKer bgkS r Y e = Q Y / (2 * Y) - P Y / 2 - L Y / 2 + Real.log Y * P Y / 2 := by
      intro Y h0 h1
      have hY : Y ≠ 0 := h0.ne'
      have hsub : ∀ k : ℝ → ℝ, bgKer k r Y e = ∫ x in (0:ℝ)..Y, k (x / Y) * r x e := by
        intro k
        unfold bgKer
        have := intervalIntegral.integral_comp_mul_right (a := 0) (b := 1)
          (fun x => k (x / Y) * r x e) hY
        simp only [zero_mul, one_mul, smul_eq_mul, ne_eq, hY, not_false_eq_true,
          mul_div_cancel_right₀] at this
        rw [this, mul_inv_cancel_left₀ hY]
      have hae : ∀ (k : ℝ → ℝ) (a b c : ℝ), (∀ x, 0 < x → k (x / Y) * r x e =
          a * r x e + b * (x * r x e) + c * (Real.log x * r x e)) →
          bgKer k r Y e = a * P Y + b * Q Y + c * L Y := by
        intro k a b c hk
        rw [hsub k, ← hlin Y h0 h1 a b c]
        refine intervalIntegral.integral_congr_ae (Filter.Eventually.of_forall (fun x hx => ?_))
        rw [Set.uIoc_of_le h0.le] at hx
        exact hk x hx.1
      refine ⟨?_, ?_, ?_, ?_, ?_⟩
      · rw [hae bgkG (1 / 2) (-(1 / (2 * Y))) 0 (fun x hx => by unfold bgkG; field_simp; ring)]
        field_simp; ring
      · rw [hae bgkGp 0 (1 / (2 * Y)) 0 (fun x hx => by unfold bgkGp; field_simp; ring)]
        field_simp; ring
      · rw [hae bgkU (Real.log Y / 2) 0 (-(1 / 2)) (fun x hx => by
          unfold bgkU; rw [Real.log_div hx.ne' hY]; ring)]
        ring
      · rw [hae bgkUp (1 / 2) 0 0 (fun x hx => by unfold bgkUp; ring)]
        ring
      · rw [hae bgkS (-(1 / 2) + Real.log Y / 2) (1 / (2 * Y)) (-(1 / 2)) (fun x hx => by
          unfold bgkS; rw [Real.log_div hx.ne' hY]; field_simp; ring)]
        field_simp; ring

    have hD1 : ∀ Y, 0 < Y → Y < Xi → deriv (fun Z => bgKer bgkG r Z e) Y = Q Y / (2 * Y * Y) := by
      intro Y h0 h1
      have hY : Y ≠ 0 := h0.ne'
      have hd := ((dP Y h0 h1).div_const 2).sub
        ((dQ Y h0 h1).div ((hasDerivAt_id' Y).const_mul 2) (by positivity))
      rw [hderiv _ _ _ Y h0 h1 (fun Z z0 z1 => (hcf Z z0 z1).1) hd]
      field_simp; ring
    have hD2 : ∀ Y, 0 < Y → Y < Xi →
        deriv (fun Z => bgKer bgkS r Z e) Y = P Y / (2 * Y) - Q Y / (2 * Y * Y) := by
      intro Y h0 h1
      have hY : Y ≠ 0 := h0.ne'
      have hd := ((((dQ Y h0 h1).div ((hasDerivAt_id' Y).const_mul 2) (by positivity)).sub
        ((dP Y h0 h1).div_const 2)).sub ((dL Y h0 h1).div_const 2)).add
        (((Real.hasDerivAt_log hY).mul (dP Y h0 h1)).div_const 2)
      rw [hderiv _ _ _ Y h0 h1 (fun Z z0 z1 => (hcf Z z0 z1).2.2.2.2) hd]
      field_simp; ring
    have hD3 : ∀ Y, 0 < Y → Y < Xi →
        bgUz (bgKer bgkS r) Y e = (Real.log Y * P Y - L Y) / 2 := by
      intro Y h0 h1
      have hY : Y ≠ 0 := h0.ne'
      show bgKer bgkS r Y e + Y * deriv (fun Z => bgKer bgkS r Z e) Y = _
      rw [hD2 Y h0 h1, (hcf Y h0 h1).2.2.2.2]
      field_simp; ring
    have hD4 : ∀ Y, 0 < Y → Y < Xi → pdX (bgUz (bgKer bgkS r)) Y e = P Y / (2 * Y) := by
      intro Y h0 h1
      have hY : Y ≠ 0 := h0.ne'
      have hd := (((Real.hasDerivAt_log hY).mul (dP Y h0 h1)).sub (dL Y h0 h1)).div_const 2
      show deriv (fun Z => bgUz (bgKer bgkS r) Z e) Y = _
      rw [hderiv _ _ _ Y h0 h1 hD3 hd]
      field_simp; ring
    have hXne : X ≠ 0 := hX0.ne'
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · show X * deriv (fun Z => bgKer bgkG r Z e) X = _
      rw [hD1 X hX0 hX1, (hcf X hX0 hX1).2.1]
      field_simp
    · have hd : HasDerivAt (fun Z => Q Z / (2 * Z * Z))
          ((X * r X e * (2 * X * X) - Q X * (2 * 1 * X + 2 * X * 1)) / (2 * X * X) ^ 2) X :=
        (dQ X hX0 hX1).div (((hasDerivAt_id' X).const_mul 2).mul (hasDerivAt_id' X))
          (by positivity)
      have e1 : pdX (pdX (bgKer bgkG r)) X e = _ := hderiv _ _ _ X hX0 hX1 hD1 hd
      have e2 : pdX (bgKer bgkG r) X e = Q X / (2 * X * X) := hD1 X hX0 hX1
      rw [e1, e2]
      field_simp; ring
    · rw [hD3 X hX0 hX1, (hcf X hX0 hX1).2.2.1]
    · rw [hD4 X hX0 hX1, (hcf X hX0 hX1).2.2.2.1]
      field_simp
    · have hd : HasDerivAt (fun Z => P Z / (2 * Z))
          ((r X e * (2 * X) - P X * (2 * 1)) / (2 * X) ^ 2) X :=
        (dP X hX0 hX1).div ((hasDerivAt_id' X).const_mul 2) (by positivity)
      have e1 : pdX (pdX (bgUz (bgKer bgkS r))) X e = _ := hderiv _ _ _ X hX0 hX1 hD4 hd
      rw [e1, hD4 X hX0 hX1]
      field_simp; ring
  obtain ⟨i1, i2, i3, i4, i5⟩ := hC η hη1 hη2
  refine ⟨i1, i2, i3, i4, i5, ?_⟩
  show deriv (fun e => bgUz (bgKer bgkS r) X e) η = deriv (fun e => bgKer bgkU r X e) η
  apply Filter.EventuallyEq.deriv_eq
  filter_upwards [Ioo_mem_nhds hη1 hη2] with e he
  exact (hC e he.1 he.2).2.2.1

theorem bgHolo_radInt_calc : ∀ (Xi : ℝ) (g G Gd K : ℝ → ℝ → ℝ), 0 < Xi → BgHolo Xi g → BgHolo Xi G → BgHolo Xi K → (∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 → pdE G X η = Gd X η) → BgHolo Xi (profRadInt (fun x e => g x e * G x e + K x e)) ∧ ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 → pdX (profRadInt (fun x e => g x e * G x e + K x e)) X η = g X η * G X η + K X η ∧ profRadInt (fun x e => g x e * G x e + K x e) X η = profRadInt (fun x e => g x e * G x e) X η + profRadInt K X η ∧ pdE (profRadInt (fun x e => g x e * G x e + K x e)) X η = profRadInt (fun x e => pdE g x e * G x e + g x e * Gd x e) X η + profRadInt (pdE K) X η :=
by
  intro Xi g G Gd K hXi hg hG hK hGd

  have slice : ∀ f : ℝ → ℝ → ℝ, BgHolo Xi f → ∀ η : ℝ, -1 < η → η < 1 →
      ContinuousOn (fun x => f x η) (Ioo 0 Xi) ∧
      ∀ X : ℝ, 0 ≤ X → X < Xi → IntervalIntegrable (fun x => f x η) volume 0 X := by
    intro f hf η h1 h2
    obtain ⟨fc, ρ, C, hρ, hcont, hdiff, -, hreal⟩ := hf
    have hmem : (η : ℂ) ∈ cStrip (ρ 0) := by
      have := (hρ 0).1
      simp only [cStrip, mem_setOf_eq, Complex.ofReal_im, Complex.ofReal_re, abs_zero]
      exact ⟨this, by linarith, by linarith⟩
    have hc : ContinuousOn (fun x => f x η) (Ioo 0 Xi) := by
      have h1' : ContinuousOn (fun x : ℝ => fc 0 x (η : ℂ)) (Ioo 0 Xi) :=
        (hcont 0).comp (Continuous.prodMk continuous_id continuous_const).continuousOn
          (fun x hx => ⟨hx, hmem⟩)
      have h2' : ContinuousOn (fun x : ℝ => (fc 0 x (η : ℂ)).re) (Ioo 0 Xi) :=
        Complex.continuous_re.comp_continuousOn h1'
      refine h2'.congr (fun x hx => ?_)
      simp only [hreal x η hx.1 hx.2 h1 h2, Complex.ofReal_re]
    refine ⟨hc, fun X hX0 hXX => ?_⟩
    rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hX0]
    have hsub : Ioc 0 X ⊆ Ioo 0 Xi := fun x hx => ⟨hx.1, lt_of_le_of_lt hx.2 hXX⟩
    haveI : IsFiniteMeasure (volume.restrict (Ioc (0:ℝ) X)) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact measure_Ioc_lt_top⟩
    show Integrable (fun x => f x η) (volume.restrict (Ioc 0 X))
    refine Integrable.of_bound (C := C 0)
      ((hc.mono hsub).aestronglyMeasurable measurableSet_Ioc) ?_
    refine ae_restrict_of_forall_mem measurableSet_Ioc (fun x hx => ?_)
    have hx' := hsub hx
    have hb := (hdiff 0 x hx'.1 hx'.2).2 _ hmem
    rw [hreal x η hx'.1 hx'.2 h1 h2, Complex.norm_real] at hb
    exact hb

  have etadiff : ∀ f : ℝ → ℝ → ℝ, BgHolo Xi f → ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 →
      DifferentiableAt ℝ (fun e => f X e) η := by
    intro f hf X η hX0 hXX h1 h2
    obtain ⟨fc, ρ, C, hρ, -, hdiff, -, hreal⟩ := hf
    have hopen : IsOpen (cStrip (ρ 0)) := by
      have e : cStrip (ρ 0) = {w : ℂ | |w.im| < ρ 0} ∩
          ({w : ℂ | -1 - ρ 0 < w.re} ∩ {w : ℂ | w.re < 1 + ρ 0}) := by
        ext w
        simp only [cStrip, mem_setOf_eq, mem_inter_iff]
      rw [e]
      exact (isOpen_lt Complex.continuous_im.abs continuous_const).inter
        ((isOpen_lt continuous_const Complex.continuous_re).inter
          (isOpen_lt Complex.continuous_re continuous_const))
    have hmem : (η : ℂ) ∈ cStrip (ρ 0) := by
      have := (hρ 0).1
      simp only [cStrip, mem_setOf_eq, Complex.ofReal_im, Complex.ofReal_re, abs_zero]
      exact ⟨this, by linarith, by linarith⟩
    have hd : HasDerivAt (fc 0 X) (deriv (fc 0 X) (η : ℂ)) (η : ℂ) :=
      ((hdiff 0 X hX0 hXX).1.differentiableAt (hopen.mem_nhds hmem)).hasDerivAt
    have hr := hd.real_of_complex
    have hev : (fun e => f X e) =ᶠ[nhds η] (fun y : ℝ => (fc 0 X (y : ℂ)).re) := by
      filter_upwards [Ioo_mem_nhds h1 h2] with y hy
      rw [hreal X y hX0 hXX hy.1 hy.2, Complex.ofReal_re]
    exact (hr.congr_of_eventuallyEq hev).differentiableAt

  have repr : ∀ (f : ℝ → ℝ → ℝ) (X η : ℝ), profRadInt f X η = 2 * bgKer bgkUp f X η := by
    intro f X η
    unfold profRadInt bgKer bgkUp
    rw [intervalIntegral.integral_const_mul]
    rcases eq_or_ne X 0 with hX | hX
    · subst hX
      simp
    · have hc := intervalIntegral.integral_comp_mul_right (a := 0) (b := 1) (fun x => f x η) hX
      simp only [zero_mul, one_mul, smul_eq_mul] at hc
      rw [hc]
      set I := ∫ x in (0:ℝ)..X, f x η
      rw [show 2 * (X * (1 / 2 * (X⁻¹ * I))) = (X * X⁻¹) * I by ring, mul_inv_cancel₀ hX, one_mul]

  have hgG : BgHolo Xi (fun x e => g x e * G x e) := (bgHolo_add_mul Xi g G hg hG).2
  have hH : BgHolo Xi (fun x e => g x e * G x e + K x e) := (bgHolo_add_mul Xi _ K hgG hK).1
  refine ⟨(bgHolo_kernels Xi _ hXi hH).1, ?_⟩
  intro X η hX0 hXX h1 h2

  have split : ∀ e : ℝ, -1 < e → e < 1 →
      profRadInt (fun x e => g x e * G x e + K x e) X e =
        profRadInt (fun x e => g x e * G x e) X e + profRadInt K X e := by
    intro e e1 e2
    unfold profRadInt
    exact intervalIntegral.integral_add (f := fun x => g x e * G x e) (g := fun x => K x e)
      ((slice _ hgG e e1 e2).2 X hX0.le hXX) ((slice _ hK e e1 e2).2 X hX0.le hXX)

  have hB1 : pdX (profRadInt (fun x e => g x e * G x e + K x e)) X η = g X η * G X η + K X η := by
    obtain ⟨hc, hi⟩ := slice _ hH η h1 h2
    have hmem : Ioo 0 Xi ∈ nhds X := Ioo_mem_nhds hX0 hXX
    have hd := intervalIntegral.integral_hasDerivAt_right (hi X hX0.le hXX)
      (hc.stronglyMeasurableAtFilter isOpen_Ioo X ⟨hX0, hXX⟩) (hc.continuousAt hmem)
    unfold pdX profRadInt
    exact hd.deriv

  have commute : ∀ r : ℝ → ℝ → ℝ, BgHolo Xi r →
      pdE (profRadInt r) X η = profRadInt (pdE r) X η := by
    intro r hr
    have hk := ((bgHolo_kernels Xi r hXi hr).2 bgkUp
      (Or.inr (Or.inr (Or.inr (Or.inl rfl))))).2 X η hX0 hXX h1 h2
    have hfun : (fun e => profRadInt r X e) = fun e => 2 * bgKer bgkUp r X e :=
      funext fun e => repr r X e
    have e1 : pdE (profRadInt r) X η = deriv (fun e => 2 * bgKer bgkUp r X e) η := by
      show deriv (fun e => profRadInt r X e) η = _
      rw [hfun]
    have e2 : deriv (fun e => 2 * bgKer bgkUp r X e) η = 2 * pdE (bgKer bgkUp r) X η := by
      rw [deriv_const_mul_field]
      rfl
    rw [e1, e2, hk, ← repr]
  have hPgG := bgHolo_kernels Xi _ hXi hgG
  have hPK := bgHolo_kernels Xi _ hXi hK
  have hdiffgG := etadiff _ hPgG.1 X η hX0 hXX h1 h2
  have hdiffK := etadiff _ hPK.1 X η hX0 hXX h1 h2
  have hev : (fun e => profRadInt (fun x e => g x e * G x e + K x e) X e) =ᶠ[nhds η]
      (fun e => profRadInt (fun x e => g x e * G x e) X e + profRadInt K X e) := by
    filter_upwards [Ioo_mem_nhds h1 h2] with e he
    exact split e he.1 he.2
  have hB3a : pdE (profRadInt (fun x e => g x e * G x e + K x e)) X η =
      pdE (profRadInt (fun x e => g x e * G x e)) X η + pdE (profRadInt K) X η := by
    unfold pdE
    rw [hev.deriv_eq]
    exact (hdiffgG.hasDerivAt.add hdiffK.hasDerivAt).deriv
  have hB3b : profRadInt (pdE (fun x e => g x e * G x e)) X η =
      profRadInt (fun x e => pdE g x e * G x e + g x e * Gd x e) X η := by
    unfold profRadInt
    refine intervalIntegral.integral_congr_ae (ae_of_all _ (fun x hx => ?_))
    rw [uIoc_of_le hX0.le] at hx
    have hx0 : 0 < x := hx.1
    have hxX : x < Xi := lt_of_le_of_lt hx.2 hXX
    show deriv (fun e => g x e * G x e) η = pdE g x η * G x η + g x η * Gd x η
    rw [← hGd x η hx0 hxX h1 h2]
    exact ((etadiff g hg x η hx0 hxX h1 h2).hasDerivAt.mul
      (etadiff G hG x η hx0 hxX h1 h2).hasDerivAt).deriv
  refine ⟨hB1, split η h1 h2, ?_⟩
  rw [hB3a, commute _ hgG, commute _ hK, hB3b]

theorem bgHolo_extend : ∀ (Xi : ℝ) (f : ℝ → ℝ → ℝ), 0 < Xi → BgHolo Xi f → ∃ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) (Ico 0 Xi ×ˢ Ioo (-1) 1) ∧ (∀ X η : ℝ, 0 < X → X < Xi → g X η = f X η) ∧ (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿g) (X, η)‖ ≤ C) ∧ BgAnalytic Xi g :=
by

  have L1open : ∀ ρ : ℝ, IsOpen (cStrip ρ) := by
    intro ρ
    have h1 : IsOpen {w : ℂ | |w.im| < ρ} := isOpen_lt Complex.continuous_im.abs continuous_const
    have h2 : IsOpen {w : ℂ | -1 - ρ < w.re} := isOpen_lt continuous_const Complex.continuous_re
    have h3 : IsOpen {w : ℂ | w.re < 1 + ρ} := isOpen_lt Complex.continuous_re continuous_const
    have e : cStrip ρ = {w : ℂ | |w.im| < ρ} ∩ ({w : ℂ | -1 - ρ < w.re} ∩ {w : ℂ | w.re < 1 + ρ}) := by
      ext w
      simp only [cStrip, Set.mem_setOf_eq, Set.mem_inter_iff]
    rw [e]
    exact h1.inter (h2.inter h3)
  have L1mono : ∀ a ρ : ℝ, a ≤ ρ → cStrip a ⊆ cStrip ρ := by
    intro a ρ h w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    obtain ⟨h1, h2, h3⟩ := hw
    exact ⟨by linarith, by linarith, by linarith⟩
  have L1real : ∀ ρ : ℝ, 0 < ρ → ∀ η : ℝ, -1 < η → η < 1 → ((η : ℝ) : ℂ) ∈ cStrip ρ := by
    intro ρ hρ η h1 h2
    simp only [cStrip, Set.mem_setOf_eq, Complex.ofReal_im, Complex.ofReal_re, abs_zero]
    exact ⟨hρ, by linarith, by linarith⟩
  have L1ball : ∀ (a r ρ : ℝ) (w : ℂ), w ∈ cStrip a → 0 ≤ r → a + r ≤ ρ →
      Metric.closedBall w r ⊆ cStrip ρ := by
    intro a r ρ w hw hr har z hz
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    rw [Metric.mem_closedBall, dist_eq_norm] at hz
    have hre := Complex.abs_re_le_norm (z - w)
    have him := Complex.abs_im_le_norm (z - w)
    rw [Complex.sub_re] at hre
    rw [Complex.sub_im] at him
    obtain ⟨h1, h2, h3⟩ := hw
    have e1 := abs_le.mp (hre.trans hz)
    have e2 := abs_le.mp (him.trans hz)
    have e3 := abs_lt.mp h1
    exact ⟨abs_lt.mpr ⟨by linarith, by linarith⟩, by linarith, by linarith⟩
  have L3 : ∀ (g : ℝ → ℝ) (φ : ℝ → ℂ) (z : ℂ) (x : ℝ), HasDerivAt φ z x →
      (∀ᶠ y in nhds x, φ y = ((g y : ℝ) : ℂ)) → z = ((deriv g x : ℝ) : ℂ) := by
    intro g φ z x hφ hev
    have hψ : HasDerivAt (fun y => ((g y : ℝ) : ℂ)) z x :=
      hφ.congr_of_eventuallyEq (hev.mono fun y hy => hy.symm)
    have hre0 : HasDerivAt (fun y => Complex.reCLM ((g y : ℝ) : ℂ)) (Complex.reCLM z) x :=
      (Complex.reCLM.hasFDerivAt).comp_hasDerivAt x hψ
    have him0 : HasDerivAt (fun y => Complex.imCLM ((g y : ℝ) : ℂ)) (Complex.imCLM z) x :=
      (Complex.imCLM.hasFDerivAt).comp_hasDerivAt x hψ
    have hre : HasDerivAt g z.re x := by simpa using hre0
    have him : HasDerivAt (fun _ : ℝ => (0:ℝ)) z.im x := by simpa using him0
    have h0 : z.im = 0 := him.unique (hasDerivAt_const x 0)
    apply Complex.ext
    · rw [hre.deriv]; simp
    · simp [h0]
  have L3h : ∀ (g : ℝ → ℝ) (φ : ℝ → ℂ) (z : ℂ) (x : ℝ), HasDerivAt φ z x →
      (∀ᶠ y in nhds x, φ y = ((g y : ℝ) : ℂ)) → HasDerivAt g (deriv g x) x := by
    intro g φ z x hφ hev
    have hψ : HasDerivAt (fun y => ((g y : ℝ) : ℂ)) z x :=
      hφ.congr_of_eventuallyEq (hev.mono fun y hy => hy.symm)
    have hre0 : HasDerivAt (fun y => Complex.reCLM ((g y : ℝ) : ℂ)) (Complex.reCLM z) x :=
      (Complex.reCLM.hasFDerivAt).comp_hasDerivAt x hψ
    have hre : HasDerivAt g z.re x := by simpa using hre0
    rw [hre.deriv]; exact hre
  have L4 : ∀ (I : Set ℝ) (Ω Ω' : Set ℂ) (s : ℝ) (F : ℝ → ℂ → ℂ), IsOpen I → 0 < s →
      (∀ w ∈ Ω', Metric.closedBall w s ⊆ Ω) →
      ContinuousOn (fun p : ℝ × ℂ => F p.1 p.2) (I ×ˢ Ω) →
      (∀ X ∈ I, DifferentiableOn ℂ (F X) Ω) →
      ContinuousOn (fun p : ℝ × ℂ => deriv (F p.1) p.2) (I ×ˢ Ω') := by
    intro I Ω Ω' s F hI hs hball hcont hdiff
    rintro ⟨X₀, w₀⟩ ⟨hX₀, hw₀⟩
    rw [Metric.continuousWithinAt_iff]
    intro ε hε
    obtain ⟨e, he, heI⟩ := Metric.isOpen_iff.mp hI X₀ hX₀
    have hJI : Icc (X₀ - e / 2) (X₀ + e / 2) ⊆ I := by
      intro t ht
      apply heI
      rw [Metric.mem_ball, Real.dist_eq, abs_lt]
      constructor <;> linarith [ht.1, ht.2]
    have hKΩ : Metric.closedBall w₀ s ⊆ Ω := hball w₀ hw₀
    have hcomp : IsCompact (Icc (X₀ - e / 2) (X₀ + e / 2) ×ˢ Metric.closedBall w₀ s) :=
      isCompact_Icc.prod (isCompact_closedBall _ _)
    have huc := hcomp.uniformContinuousOn_of_continuous (hcont.mono (prod_mono hJI hKΩ))
    rw [Metric.uniformContinuousOn_iff] at huc
    obtain ⟨δ₁, hδ₁, hu⟩ := huc (ε * s / 4) (div_pos (mul_pos hε hs) (by norm_num))
    have hballΩ : Metric.ball w₀ s ⊆ Ω := Metric.ball_subset_closedBall.trans hKΩ
    have hdd : DifferentiableOn ℂ (deriv (F X₀)) (Metric.ball w₀ s) :=
      ((hdiff X₀ hX₀).mono hballΩ).deriv Metric.isOpen_ball
    have hca : ContinuousAt (deriv (F X₀)) w₀ :=
      hdd.continuousOn.continuousAt (Metric.ball_mem_nhds w₀ hs)
    rw [Metric.continuousAt_iff] at hca
    obtain ⟨δ₂, hδ₂, hc2⟩ := hca (ε / 2) (half_pos hε)
    refine ⟨min (min (e / 2) δ₁) (min δ₂ (s / 2)),
      lt_min (lt_min (half_pos he) hδ₁) (lt_min hδ₂ (half_pos hs)), ?_⟩
    rintro ⟨X, w⟩ ⟨hX, hw⟩ hdist
    rw [Prod.dist_eq] at hdist
    have hd1 : dist X X₀ < min (min (e / 2) δ₁) (min δ₂ (s / 2)) :=
      lt_of_le_of_lt (le_max_left _ _) hdist
    have hd2 : dist w w₀ < min (min (e / 2) δ₁) (min δ₂ (s / 2)) :=
      lt_of_le_of_lt (le_max_right _ _) hdist
    have hXe : dist X X₀ < e / 2 := lt_of_lt_of_le hd1 ((min_le_left _ _).trans (min_le_left _ _))
    have hXδ : dist X X₀ < δ₁ := lt_of_lt_of_le hd1 ((min_le_left _ _).trans (min_le_right _ _))
    have hwδ : dist w w₀ < δ₂ := lt_of_lt_of_le hd2 ((min_le_right _ _).trans (min_le_left _ _))
    have hws : dist w w₀ < s / 2 :=
      lt_of_lt_of_le hd2 ((min_le_right _ _).trans (min_le_right _ _))
    have hXJ : X ∈ Icc (X₀ - e / 2) (X₀ + e / 2) := by
      rw [Real.dist_eq, abs_lt] at hXe
      constructor <;> linarith [hXe.1, hXe.2]
    have hX₀J : X₀ ∈ Icc (X₀ - e / 2) (X₀ + e / 2) := by constructor <;> linarith
    have hsub : Metric.closedBall w (s / 2) ⊆ Metric.closedBall w₀ s := by
      intro z hz
      rw [Metric.mem_closedBall] at hz ⊢
      linarith [dist_triangle z w w₀]
    have hgd : DifferentiableOn ℂ (fun z => F X z - F X₀ z) (Metric.closedBall w (s / 2)) :=
      ((hdiff X hX).sub (hdiff X₀ hX₀)).mono (hsub.trans hKΩ)
    have hgc : DiffContOnCl ℂ (fun z => F X z - F X₀ z) (Metric.ball w (s / 2)) := by
      apply DifferentiableOn.diffContOnCl
      rw [closure_ball w (half_pos hs).ne']
      exact hgd
    have hgb : ∀ z ∈ Metric.sphere w (s / 2), ‖F X z - F X₀ z‖ ≤ ε * s / 4 := by
      intro z hz
      have hzK : z ∈ Metric.closedBall w₀ s := hsub (Metric.sphere_subset_closedBall hz)
      have hdz : dist ((X, z) : ℝ × ℂ) (X₀, z) < δ₁ := by
        simp only [Prod.dist_eq, dist_self]
        rw [max_eq_left dist_nonneg]
        exact hXδ
      have := hu (X, z) ⟨hXJ, hzK⟩ (X₀, z) ⟨hX₀J, hzK⟩ hdz
      rw [dist_eq_norm] at this
      exact this.le
    have hcauchy := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le (half_pos hs) hgc hgb
    have hwΩ : Ω ∈ nhds w :=
      Filter.mem_of_superset (Metric.ball_mem_nhds w (half_pos hs))
        (Metric.ball_subset_closedBall.trans (hsub.trans hKΩ))
    have hderiv : deriv (fun z => F X z - F X₀ z) w = deriv (F X) w - deriv (F X₀) w :=
      (((hdiff X hX).differentiableAt hwΩ).hasDerivAt.sub
        ((hdiff X₀ hX₀).differentiableAt hwΩ).hasDerivAt).deriv
    show dist (deriv (F X) w) (deriv (F X₀) w₀) < ε
    have h2 := hc2 hwδ
    rw [dist_eq_norm] at h2 ⊢
    have hsplit : deriv (F X) w - deriv (F X₀) w₀ =
        deriv (fun z => F X z - F X₀ z) w + (deriv (F X₀) w - deriv (F X₀) w₀) := by
      rw [hderiv]; ring
    rw [hsplit]
    have hq : ε * s / 4 / (s / 2) = ε / 2 := by
      rw [div_div_eq_mul_div]
      field_simp
      ring
    calc ‖deriv (fun z => F X z - F X₀ z) w + (deriv (F X₀) w - deriv (F X₀) w₀)‖
        ≤ ‖deriv (fun z => F X z - F X₀ z) w‖ + ‖deriv (F X₀) w - deriv (F X₀) w₀‖ :=
          norm_add_le _ _
      _ < ε / 2 + ε / 2 := by linarith
      _ = ε := by ring
  have L5 : ∀ (I : Set ℝ) (Ω Ω' : Set ℂ) (s : ℝ) (F F' : ℝ → ℂ → ℂ), IsOpen I → 0 < s →
      (∀ w ∈ Ω', Metric.closedBall w s ⊆ Ω) →
      ContinuousOn (fun p : ℝ × ℂ => F' p.1 p.2) (I ×ˢ Ω) →
      (∀ X ∈ I, DifferentiableOn ℂ (F X) Ω ∧ DifferentiableOn ℂ (F' X) Ω) →
      (∀ X ∈ I, ∀ z ∈ Ω, HasDerivAt (fun Y : ℝ => F Y z) (F' X z) X) →
      ∀ X ∈ I, ∀ w ∈ Ω', HasDerivAt (fun Y : ℝ => deriv (F Y) w) (deriv (F' X) w) X := by
    intro I Ω Ω' s F F' hI hs hball hcont hdiff hder X hX w hw
    rw [hasDerivAt_iff_isLittleO, Asymptotics.isLittleO_iff]
    intro c hc
    obtain ⟨e, he, heI⟩ := Metric.isOpen_iff.mp hI X hX
    have hJI : Icc (X - e / 2) (X + e / 2) ⊆ I := by
      intro t ht
      apply heI
      rw [Metric.mem_ball, Real.dist_eq, abs_lt]
      constructor <;> linarith [ht.1, ht.2]
    have hKΩ : Metric.closedBall w s ⊆ Ω := hball w hw
    have hcomp : IsCompact (Icc (X - e / 2) (X + e / 2) ×ˢ Metric.closedBall w s) :=
      isCompact_Icc.prod (isCompact_closedBall _ _)
    have huc := hcomp.uniformContinuousOn_of_continuous (hcont.mono (prod_mono hJI hKΩ))
    rw [Metric.uniformContinuousOn_iff] at huc
    obtain ⟨δ₁, hδ₁, hu⟩ := huc (c * s) (mul_pos hc hs)
    filter_upwards [Metric.ball_mem_nhds X (lt_min (half_pos he) hδ₁)] with Y hY
    rw [Metric.mem_ball, Real.dist_eq] at hY
    have hYe : |Y - X| < e / 2 := lt_of_lt_of_le hY (min_le_left _ _)
    have hYδ : |Y - X| < δ₁ := lt_of_lt_of_le hY (min_le_right _ _)
    have hXJ : X ∈ Icc (X - e / 2) (X + e / 2) := by constructor <;> linarith
    have htJ : ∀ t ∈ uIcc X Y, t ∈ Icc (X - e / 2) (X + e / 2) ∧ |t - X| ≤ |Y - X| := by
      intro t ht
      rw [mem_uIcc] at ht
      have hYe' := abs_lt.mp hYe
      rcases ht with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · refine ⟨⟨by linarith, by linarith⟩, ?_⟩
        rw [abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]
        linarith
      · refine ⟨⟨by linarith, by linarith⟩, ?_⟩
        rw [abs_of_nonpos (by linarith), abs_of_nonpos (by linarith)]
        linarith
    have hYI : Y ∈ I := hJI (htJ Y right_mem_uIcc).1
    have hR : ∀ z ∈ Metric.closedBall w s,
        ‖F Y z - F X z - ((Y - X : ℝ) : ℂ) * F' X z‖ ≤ c * s * ‖Y - X‖ := by
      intro z hz
      have hzΩ := hKΩ hz
      have hdR : ∀ t ∈ uIcc X Y, HasDerivWithinAt
          (fun t : ℝ => F t z - F X z - ((t - X : ℝ) : ℂ) * F' X z) (F' t z - F' X z) (uIcc X Y) t := by
        intro t ht
        have h1 := hder t (hJI (htJ t ht).1) z hzΩ
        have h2 : HasDerivAt (fun t : ℝ => ((t - X : ℝ) : ℂ) * F' X z) (F' X z) t := by
          have := ((hasDerivAt_id t).sub_const X).ofReal_comp.mul_const (F' X z)
          simpa using this
        exact ((h1.sub_const (F X z)).sub h2).hasDerivWithinAt
      have hbd : ∀ t ∈ uIcc X Y, ‖F' t z - F' X z‖ ≤ c * s := by
        intro t ht
        obtain ⟨htJ', hle⟩ := htJ t ht
        have hdz : dist ((t, z) : ℝ × ℂ) (X, z) < δ₁ := by
          simp only [Prod.dist_eq, dist_self]
          rw [max_eq_left dist_nonneg, Real.dist_eq]
          linarith
        have := hu (t, z) ⟨htJ', hz⟩ (X, z) ⟨hXJ, hz⟩ hdz
        rw [dist_eq_norm] at this
        exact this.le
      have := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le hdR hbd (convex_uIcc X Y)
        left_mem_uIcc right_mem_uIcc
      simpa using this
    have hgd : DifferentiableOn ℂ (fun z => F Y z - F X z - ((Y - X : ℝ) : ℂ) * F' X z) Ω :=
      ((hdiff Y hYI).1.sub (hdiff X hX).1).sub ((hdiff X hX).2.const_mul _)
    have hgc : DiffContOnCl ℂ (fun z => F Y z - F X z - ((Y - X : ℝ) : ℂ) * F' X z)
        (Metric.ball w s) := by
      apply DifferentiableOn.diffContOnCl
      rw [closure_ball w hs.ne']
      exact hgd.mono hKΩ
    have hcauchy := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hs hgc
      (fun z hz => hR z (Metric.sphere_subset_closedBall hz))
    have hwΩ : Ω ∈ nhds w :=
      Filter.mem_of_superset (Metric.ball_mem_nhds w hs) (Metric.ball_subset_closedBall.trans hKΩ)
    have hd1 := (hdiff Y hYI).1.differentiableAt hwΩ
    have hd2 := (hdiff X hX).1.differentiableAt hwΩ
    have hd3 := (hdiff X hX).2.differentiableAt hwΩ
    have hderiv : deriv (fun z => F Y z - F X z - ((Y - X : ℝ) : ℂ) * F' X z) w =
        deriv (F Y) w - deriv (F X) w - ((Y - X : ℝ) : ℂ) * deriv (F' X) w :=
      ((hd1.hasDerivAt.sub hd2.hasDerivAt).sub (hd3.hasDerivAt.const_mul _)).deriv
    show ‖deriv (F Y) w - deriv (F X) w - (Y - X) • deriv (F' X) w‖ ≤ c * ‖Y - X‖
    rw [Complex.real_smul, ← hderiv]
    have hq : c * s * ‖Y - X‖ / s = c * ‖Y - X‖ := by
      field_simp
    rw [← hq]
    exact hcauchy
  have PD : ∀ (Xi : ℝ) (f : ℝ → ℝ → ℝ), BgHolo Xi f → BgHolo Xi (pdX f) ∧ BgHolo Xi (pdE f) := by
    intro Xi f hf
    unfold BgHolo at hf
    obtain ⟨fc, ρ, C, H1, H2, H3, H4, H5⟩ := hf
    refine ⟨?_, ?_⟩
    · unfold BgHolo
      refine ⟨fun k => fc (k + 1), fun k => ρ (k + 1), fun k => C (k + 1), fun k => H1 (k + 1),
        fun k => H2 (k + 1), fun k X h0 h1 => H3 (k + 1) X h0 h1,
        fun k X w h0 h1 hw => H4 (k + 1) X w h0 h1 hw, ?_⟩
      intro X η h0 h1 e1 e2
      have hmem : ((η : ℝ) : ℂ) ∈ cStrip (ρ (0 + 1)) := L1real _ (H1 1).1 η e1 e2
      have hd := H4 0 X (η : ℂ) h0 h1 hmem
      have hev : ∀ᶠ Y in nhds X, fc 0 Y (η : ℂ) = ((f Y η : ℝ) : ℂ) := by
        filter_upwards [Ioo_mem_nhds h0 h1] with Y hY
        exact H5 Y η hY.1 hY.2 e1 e2
      exact L3 (fun Y => f Y η) (fun Y => fc 0 Y (η : ℂ)) _ X hd hev
    · unfold BgHolo
      refine ⟨fun k X w => deriv (fc k X) w, fun k => ρ k / 2, fun k => 2 * C k / ρ k,
        ?_, ?_, ?_, ?_, ?_⟩
      · intro k
        have a := (H1 k).1
        have b := (H1 k).2
        exact ⟨by linarith, by linarith⟩
      · intro k
        have hρ := (H1 k).1
        exact L4 (Ioo 0 Xi) (cStrip (ρ k)) (cStrip (ρ k / 2)) (ρ k / 2) (fc k) isOpen_Ioo
          (half_pos hρ)
          (fun w hw => L1ball (ρ k / 2) (ρ k / 2) (ρ k) w hw (by linarith) (by linarith))
          (H2 k) (fun X hX => (H3 k X hX.1 hX.2).1)
      · intro k X h0 h1
        have hρ := (H1 k).1
        obtain ⟨hdk, hbk⟩ := H3 k X h0 h1
        refine ⟨(hdk.deriv (L1open _)).mono (L1mono _ _ (by linarith)), ?_⟩
        intro w hw
        have hcb : Metric.closedBall w (ρ k / 2) ⊆ cStrip (ρ k) :=
          L1ball (ρ k / 2) (ρ k / 2) (ρ k) w hw (by linarith) (by linarith)
        have hgc : DiffContOnCl ℂ (fc k X) (Metric.ball w (ρ k / 2)) := by
          apply DifferentiableOn.diffContOnCl
          rw [closure_ball w (half_pos hρ).ne']
          exact hdk.mono hcb
        have hc := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le (half_pos hρ) hgc
          (fun z hz => hbk z (hcb (Metric.sphere_subset_closedBall hz)))
        calc ‖deriv (fc k X) w‖ ≤ C k / (ρ k / 2) := hc
          _ = 2 * C k / ρ k := by rw [div_div_eq_mul_div, mul_comm (C k) 2]
      · intro k X w h0 h1 hw
        have hρ1 := (H1 (k + 1)).1
        have hle := (H1 k).2
        exact L5 (Ioo 0 Xi) (cStrip (ρ (k + 1))) (cStrip (ρ (k + 1) / 2)) (ρ (k + 1) / 2) (fc k)
          (fc (k + 1)) isOpen_Ioo (half_pos hρ1)
          (fun w hw => L1ball _ _ _ w hw (by linarith) (by linarith)) (H2 (k + 1))
          (fun Y hY => ⟨(H3 k Y hY.1 hY.2).1.mono (L1mono _ _ hle), (H3 (k + 1) Y hY.1 hY.2).1⟩)
          (fun Y hY z hz => H4 k Y z hY.1 hY.2 hz) X ⟨h0, h1⟩ w hw
      · intro X η h0 h1 e1 e2
        have hmem := L1real (ρ 0) (H1 0).1 η e1 e2
        have hda : DifferentiableAt ℂ (fc 0 X) (η : ℂ) :=
          (H3 0 X h0 h1).1.differentiableAt ((L1open _).mem_nhds hmem)
        have hd : HasDerivAt (fun y : ℝ => fc 0 X (y : ℂ)) (deriv (fc 0 X) (η : ℂ)) η :=
          hda.hasDerivAt.comp_ofReal
        have hev : ∀ᶠ y : ℝ in nhds η, fc 0 X (y : ℂ) = ((f X y : ℝ) : ℂ) := by
          filter_upwards [Ioo_mem_nhds e1 e2] with y hy
          exact H5 X y h0 h1 hy.1 hy.2
        exact L3 (fun e => f X e) (fun y : ℝ => fc 0 X (y : ℂ)) _ η hd hev

  intro Xi f hXi hf
  set Ω : Set (ℝ × ℝ) := Ioo 0 Xi ×ˢ Ioo (-1) 1 with hΩdef
  have hΩo : IsOpen Ω := isOpen_Ioo.prod isOpen_Ioo
  have hΩc : Convex ℝ Ω := (convex_Ioo 0 Xi).prod (convex_Ioo (-1) 1)

  have SF : ∀ g : ℝ → ℝ → ℝ, BgHolo Xi g → ContinuousOn (↿g) Ω ∧
      (∃ C : ℝ, ∀ q ∈ Ω, |(↿g) q| ≤ C) ∧
      ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 →
        HasDerivAt (fun Y => g Y η) (pdX g X η) X ∧ HasDerivAt (fun e => g X e) (pdE g X η) η := by
    intro g hg
    obtain ⟨fc, ρ, C, H1, H2, H3, H4, H5⟩ := hg
    refine ⟨?_, ⟨C 0, ?_⟩, ?_⟩
    · have hι : Continuous (fun q : ℝ × ℝ => ((q.1, ((q.2 : ℝ) : ℂ)) : ℝ × ℂ)) :=
        continuous_fst.prodMk (Complex.continuous_ofReal.comp continuous_snd)
      have hmaps : MapsTo (fun q : ℝ × ℝ => ((q.1, ((q.2 : ℝ) : ℂ)) : ℝ × ℂ)) Ω
          (Ioo 0 Xi ×ˢ cStrip (ρ 0)) := by
        intro q hq
        exact ⟨hq.1, L1real _ (H1 0).1 _ hq.2.1 hq.2.2⟩
      have hc : ContinuousOn (fun q : ℝ × ℝ => Complex.re (fc 0 q.1 ((q.2 : ℝ) : ℂ))) Ω :=
        Complex.continuous_re.comp_continuousOn ((H2 0).comp hι.continuousOn hmaps)
      refine hc.congr ?_
      intro q hq
      show g q.1 q.2 = Complex.re (fc 0 q.1 ((q.2 : ℝ) : ℂ))
      rw [H5 q.1 q.2 hq.1.1 hq.1.2 hq.2.1 hq.2.2, Complex.ofReal_re]
    · intro q hq
      have := (H3 0 q.1 hq.1.1 hq.1.2).2 _ (L1real _ (H1 0).1 _ hq.2.1 hq.2.2)
      rw [H5 q.1 q.2 hq.1.1 hq.1.2 hq.2.1 hq.2.2, Complex.norm_real, Real.norm_eq_abs] at this
      exact this
    · intro X η h0 h1 e1 e2
      constructor
      · have hmem : ((η : ℝ) : ℂ) ∈ cStrip (ρ (0 + 1)) := L1real _ (H1 1).1 η e1 e2
        have hd := H4 0 X (η : ℂ) h0 h1 hmem
        have hev : ∀ᶠ Y in nhds X, fc 0 Y (η : ℂ) = ((g Y η : ℝ) : ℂ) := by
          filter_upwards [Ioo_mem_nhds h0 h1] with Y hY
          exact H5 Y η hY.1 hY.2 e1 e2
        exact L3h (fun Y => g Y η) (fun Y => fc 0 Y (η : ℂ)) _ X hd hev
      · have hmem := L1real (ρ 0) (H1 0).1 η e1 e2
        have hda : DifferentiableAt ℂ (fc 0 X) (η : ℂ) :=
          (H3 0 X h0 h1).1.differentiableAt ((L1open _).mem_nhds hmem)
        have hd : HasDerivAt (fun y : ℝ => fc 0 X (y : ℂ)) (deriv (fc 0 X) (η : ℂ)) η :=
          hda.hasDerivAt.comp_ofReal
        have hev : ∀ᶠ y : ℝ in nhds η, fc 0 X (y : ℂ) = ((g X y : ℝ) : ℂ) := by
          filter_upwards [Ioo_mem_nhds e1 e2] with y hy
          exact H5 X y h0 h1 hy.1 hy.2
        exact L3h (fun e => g X e) (fun y : ℝ => fc 0 X (y : ℂ)) _ η hd hev

  have S3 : ∀ (u A B : ℝ × ℝ → ℝ) (x y : ℝ), ((x, y) : ℝ × ℝ) ∈ Ω →
      (∀ p ∈ Ω, HasDerivAt (fun e => u (p.1, e)) (B p) p.2) → ContinuousAt B (x, y) →
      HasDerivAt (fun s => u (s, y)) (A (x, y)) x →
      HasFDerivAt u (A (x, y) • ContinuousLinearMap.fst ℝ ℝ ℝ +
        B (x, y) • ContinuousLinearMap.snd ℝ ℝ ℝ) (x, y) := by
    intro u A B x y hxy hB hBc hA
    rw [hasFDerivAt_iff_isLittleO_nhds_zero, Asymptotics.isLittleO_iff]
    intro c hc
    obtain ⟨δ0, hδ0, hball⟩ := Metric.isOpen_iff.mp hΩo (x, y) hxy
    rw [Metric.continuousAt_iff] at hBc
    obtain ⟨δ1, hδ1, hB1⟩ := hBc (c / 2) (half_pos hc)
    rw [hasDerivAt_iff_isLittleO_nhds_zero, Asymptotics.isLittleO_iff] at hA
    have hA2 := hA (half_pos hc)
    rw [Metric.eventually_nhds_iff] at hA2
    obtain ⟨δ2, hδ2, hA3⟩ := hA2
    rw [Metric.eventually_nhds_iff]
    refine ⟨min δ0 (min δ1 δ2), lt_min hδ0 (lt_min hδ1 hδ2), ?_⟩
    rintro ⟨s, t⟩ hst
    rw [dist_zero_right, Prod.norm_mk, Real.norm_eq_abs, Real.norm_eq_abs] at hst
    have hMs : |s| ≤ max |s| |t| := le_max_left _ _
    have hMt : |t| ≤ max |s| |t| := le_max_right _ _
    have hδ0' : max |s| |t| < δ0 := lt_of_lt_of_le hst (min_le_left _ _)
    have hδ1' : max |s| |t| < δ1 := lt_of_lt_of_le hst ((min_le_right _ _).trans (min_le_left _ _))
    have hδ2' : max |s| |t| < δ2 := lt_of_lt_of_le hst ((min_le_right _ _).trans (min_le_right _ _))
    have hpt : ∀ e ∈ uIcc y (y + t), dist ((x + s, e) : ℝ × ℝ) (x, y) ≤ max |s| |t| := by
      intro e he
      rw [Prod.dist_eq, Real.dist_eq, Real.dist_eq]
      have h1 := abs_sub_left_of_mem_uIcc he
      rw [add_sub_cancel_left] at h1
      rw [add_sub_cancel_left]
      exact max_le_max le_rfl h1
    have hφ : ∀ e ∈ uIcc y (y + t), HasDerivWithinAt (fun e => u (x + s, e) - e * B (x, y))
        (B (x + s, e) - B (x, y)) (uIcc y (y + t)) e := by
      intro e he
      have hmem : ((x + s, e) : ℝ × ℝ) ∈ Ω := hball (lt_of_le_of_lt (hpt e he) hδ0')
      have h1 : HasDerivAt (fun e' => u (x + s, e')) (B (x + s, e)) e := hB (x + s, e) hmem
      have h2 : HasDerivAt (fun e' => u (x + s, e') - e' * B (x, y)) (B (x + s, e) - 1 * B (x, y)) e :=
        h1.sub ((hasDerivAt_id' e).mul_const (B (x, y)))
      rw [one_mul] at h2
      exact h2.hasDerivWithinAt
    have hφb : ∀ e ∈ uIcc y (y + t), ‖B (x + s, e) - B (x, y)‖ ≤ c / 2 := by
      intro e he
      have h1 := hB1 (lt_of_le_of_lt (hpt e he) hδ1')
      rw [Real.dist_eq] at h1
      rw [Real.norm_eq_abs]
      exact h1.le
    have hMVT := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le hφ hφb (convex_uIcc y (y + t))
      left_mem_uIcc right_mem_uIcc
    have hX := hA3 (show dist s 0 < δ2 by rw [dist_zero_right, Real.norm_eq_abs]; linarith)
    simp only [smul_eq_mul, Real.norm_eq_abs] at hX hMVT
    rw [add_sub_cancel_left] at hMVT
    have e1 : ((x, y) : ℝ × ℝ) + (s, t) = (x + s, y + t) := Prod.mk_add_mk _ _ _ _
    have e2 : (A (x, y) • ContinuousLinearMap.fst ℝ ℝ ℝ + B (x, y) • ContinuousLinearMap.snd ℝ ℝ ℝ) (s, t)
        = A (x, y) * s + B (x, y) * t := by simp
    rw [e1, e2, Real.norm_eq_abs, Prod.norm_mk, Real.norm_eq_abs, Real.norm_eq_abs]
    have key : u (x + s, y + t) - u (x, y) - (A (x, y) * s + B (x, y) * t) =
        ((u (x + s, y + t) - (y + t) * B (x, y)) - (u (x + s, y) - y * B (x, y))) +
        (u (x + s, y) - u (x, y) - s * A (x, y)) := by ring
    rw [key]
    have hc2 : 0 ≤ c / 2 := (half_pos hc).le
    calc _ ≤ |(u (x + s, y + t) - (y + t) * B (x, y)) - (u (x + s, y) - y * B (x, y))| +
          |u (x + s, y) - u (x, y) - s * A (x, y)| := abs_add_le _ _
      _ ≤ c / 2 * |t| + c / 2 * |s| := add_le_add hMVT hX
      _ ≤ c / 2 * max |s| |t| + c / 2 * max |s| |t| :=
          add_le_add (mul_le_mul_of_nonneg_left hMt hc2) (mul_le_mul_of_nonneg_left hMs hc2)
      _ = c * max |s| |t| := by ring

  have HF : ∀ g : ℝ → ℝ → ℝ, BgHolo Xi g → ∀ q ∈ Ω, HasFDerivAt (↿g)
      (pdX g q.1 q.2 • ContinuousLinearMap.fst ℝ ℝ ℝ + pdE g q.1 q.2 • ContinuousLinearMap.snd ℝ ℝ ℝ) q := by
    intro g hg q hq
    obtain ⟨x, y⟩ := q
    have hE := (PD Xi g hg).2
    have hBc : ContinuousAt (↿(pdE g)) (x, y) := (SF _ hE).1.continuousAt (hΩo.mem_nhds hq)
    exact S3 (↿g) (↿(pdX g)) (↿(pdE g)) x y hq
      (fun p hp => ((SF g hg).2.2 p.1 p.2 hp.1.1 hp.1.2 hp.2.1 hp.2.2).2) hBc
      ((SF g hg).2.2 x y hq.1.1 hq.1.2 hq.2.1 hq.2.2).1
  have FD : ∀ g : ℝ → ℝ → ℝ, BgHolo Xi g → ∀ q ∈ Ω, fderiv ℝ (↿g) q =
      (fun p : ℝ × ℝ => pdX g p.1 p.2 • ContinuousLinearMap.fst ℝ ℝ ℝ +
        pdE g p.1 p.2 • ContinuousLinearMap.snd ℝ ℝ ℝ) q :=
    fun g hg q hq => (HF g hg q hq).fderiv

  have SM : ∀ N : ℕ, ∀ g : ℝ → ℝ → ℝ, BgHolo Xi g → ContDiffOn ℝ N (↿g) Ω := by
    intro N
    induction N with
    | zero =>
      intro g hg
      have h0 : ContDiffOn ℝ 0 (↿g) Ω :=
        contDiffOn_zero.mpr (fun q hq => (HF g hg q hq).continuousAt.continuousWithinAt)
      exact_mod_cast h0
    | succ N ih =>
      intro g hg
      rw [Nat.cast_succ, contDiffOn_succ_iff_fderiv_of_isOpen hΩo]
      refine ⟨fun q hq => (HF g hg q hq).differentiableAt.differentiableWithinAt,
        fun h => absurd h (by simp), ?_⟩
      have hX := ih _ (PD Xi g hg).1
      have hE := ih _ (PD Xi g hg).2
      have hD : ContDiffOn ℝ N (fun p : ℝ × ℝ => pdX g p.1 p.2 • ContinuousLinearMap.fst ℝ ℝ ℝ +
          pdE g p.1 p.2 • ContinuousLinearMap.snd ℝ ℝ ℝ) Ω :=
        (hX.smul contDiffOn_const).add (hE.smul contDiffOn_const)
      exact hD.congr (FD g hg)

  have BD : ∀ m : ℕ, ∀ g : ℝ → ℝ → ℝ, BgHolo Xi g →
      ∃ C : ℝ, ∀ q ∈ Ω, ‖iteratedFDeriv ℝ m (↿g) q‖ ≤ C := by
    intro m
    induction m with
    | zero =>
      intro g hg
      obtain ⟨C, hC⟩ := (SF g hg).2.1
      exact ⟨C, fun q hq => by rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs]; exact hC q hq⟩
    | succ m ih =>
      intro g hg
      obtain ⟨CA, hCA⟩ := ih _ (PD Xi g hg).1
      obtain ⟨CB, hCB⟩ := ih _ (PD Xi g hg).2
      obtain ⟨T1, hT1⟩ : ∃ T : ℝ →L[ℝ] (ℝ × ℝ →L[ℝ] ℝ),
          T = ContinuousLinearMap.toSpanSingleton ℝ (ContinuousLinearMap.fst ℝ ℝ ℝ) := ⟨_, rfl⟩
      obtain ⟨T2, hT2⟩ : ∃ T : ℝ →L[ℝ] (ℝ × ℝ →L[ℝ] ℝ),
          T = ContinuousLinearMap.toSpanSingleton ℝ (ContinuousLinearMap.snd ℝ ℝ ℝ) := ⟨_, rfl⟩
      refine ⟨‖T1‖ * CA + ‖T2‖ * CB, fun q hq => ?_⟩
      have hev : fderiv ℝ (↿g) =ᶠ[nhds q] ((T1 ∘ ↿(pdX g)) + (T2 ∘ ↿(pdE g))) := by
        filter_upwards [hΩo.mem_nhds hq] with p hp
        rw [FD g hg p hp]
        show _ = T1 (pdX g p.1 p.2) + T2 (pdE g p.1 p.2)
        rw [hT1, hT2, ContinuousLinearMap.toSpanSingleton_apply,
          ContinuousLinearMap.toSpanSingleton_apply]
      have hcA : ContDiffAt ℝ m (↿(pdX g)) q := (SM m _ (PD Xi g hg).1).contDiffAt (hΩo.mem_nhds hq)
      have hcB : ContDiffAt ℝ m (↿(pdE g)) q := (SM m _ (PD Xi g hg).2).contDiffAt (hΩo.mem_nhds hq)
      have hA : ContDiffAt ℝ m (T1 ∘ ↿(pdX g)) q := T1.contDiff.comp_contDiffAt q hcA
      have hB : ContDiffAt ℝ m (T2 ∘ ↿(pdE g)) q := T2.contDiff.comp_contDiffAt q hcB
      rw [← norm_iteratedFDeriv_fderiv, (hev.iteratedFDeriv ℝ m).eq_of_nhds,
        iteratedFDeriv_add_apply hA hB]
      have h1 := T1.norm_iteratedFDeriv_comp_left hcA le_rfl
      have h2 := T2.norm_iteratedFDeriv_comp_left hcB le_rfl
      calc _ ≤ ‖iteratedFDeriv ℝ m (T1 ∘ ↿(pdX g)) q‖ + ‖iteratedFDeriv ℝ m (T2 ∘ ↿(pdE g)) q‖ :=
            norm_add_le _ _
        _ ≤ ‖T1‖ * CA + ‖T2‖ * CB :=
            add_le_add (h1.trans (mul_le_mul_of_nonneg_left (hCA q hq) (norm_nonneg _)))
              (h2.trans (mul_le_mul_of_nonneg_left (hCB q hq) (norm_nonneg _)))

  have AN : BgAnalytic Xi f := by
    obtain ⟨fc, ρ, C, H1, H2, H3, H4, H5⟩ := hf
    have R : ∀ k : ℕ, ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 →
        fc k X (η : ℂ) = ((iteratedDeriv k (fun Y => f Y η) X : ℝ) : ℂ) := by
      intro k
      induction k with
      | zero =>
        intro X η h0 h1 e1 e2
        rw [iteratedDeriv_zero]
        exact H5 X η h0 h1 e1 e2
      | succ k ih =>
        intro X η h0 h1 e1 e2
        have hd := H4 k X (η : ℂ) h0 h1 (L1real _ (H1 (k + 1)).1 η e1 e2)
        have hev : ∀ᶠ Y in nhds X, fc k Y (η : ℂ) =
            ((iteratedDeriv k (fun Y => f Y η) Y : ℝ) : ℂ) := by
          filter_upwards [Ioo_mem_nhds h0 h1] with Y hY
          exact ih Y η hY.1 hY.2 e1 e2
        rw [iteratedDeriv_succ]
        exact L3 _ _ _ X hd hev
    intro k
    exact ⟨ρ k, C k, fc k, (H1 k).1, H2 k, fun X h0 h1 =>
      ⟨(H3 k X h0 h1).1, (H3 k X h0 h1).2, fun η e1 e2 => R k X η h0 h1 e1 e2⟩⟩

  have hsm : ContDiffOn ℝ ∞ (↿f) Ω := contDiffOn_infty.mpr (fun N => SM N f hf)
  have F2 : ∀ m : ℕ, ∀ q ∈ Ω, DifferentiableAt ℝ (iteratedFDeriv ℝ m (↿f)) q := fun m q hq =>
    (hsm.contDiffAt (hΩo.mem_nhds hq)).differentiableAt_iteratedFDeriv
      (WithTop.coe_lt_coe.2 (ENat.coe_lt_top m))
  have F3 : ∀ m : ℕ, ∀ K : ℝ, (∀ q ∈ Ω, ‖iteratedFDeriv ℝ (m + 1) (↿f) q‖ ≤ K) →
      ∀ q ∈ Ω, ∀ q' ∈ Ω, ‖iteratedFDeriv ℝ m (↿f) q' - iteratedFDeriv ℝ m (↿f) q‖ ≤ K * ‖q' - q‖ := by
    intro m K hK q hq q' hq'
    exact Convex.norm_image_sub_le_of_norm_fderiv_le (𝕜 := ℝ) (fun p hp => F2 m p hp)
      (fun p hp => by rw [norm_fderiv_iteratedFDeriv]; exact hK p hp) hΩc hq hq'
  have F4 : ∀ m : ℕ, ∀ z ∈ closure Ω, ∃ L, Filter.Tendsto (iteratedFDeriv ℝ m (↿f)) (nhdsWithin z Ω) (nhds L) := by
    intro m z hz
    obtain ⟨K0, hK0⟩ := BD (m + 1) f hf
    have hne : (nhdsWithin z Ω).NeBot := mem_closure_iff_nhdsWithin_neBot.mp hz
    have hcau : Cauchy (Filter.map (iteratedFDeriv ℝ m (↿f)) (nhdsWithin z Ω)) := by
      rw [Metric.cauchy_iff]
      refine ⟨hne.map _, fun ε hε => ?_⟩
      have hK1 : 0 < |K0| + 1 := by positivity
      obtain ⟨r, hr⟩ : ∃ r : ℝ, r = ε / (2 * (|K0| + 1)) := ⟨_, rfl⟩
      have hrpos : 0 < r := by rw [hr]; positivity
      have h2r : 2 * r * (|K0| + 1) = ε := by
        rw [hr]; field_simp
      refine ⟨iteratedFDeriv ℝ m (↿f) '' (Ω ∩ Metric.ball z r),
        Filter.image_mem_map (inter_mem_nhdsWithin Ω (Metric.ball_mem_nhds z hrpos)), ?_⟩
      rintro _ ⟨q, ⟨hq, hqb⟩, rfl⟩ _ ⟨q', ⟨hq', hqb'⟩, rfl⟩
      have hL := F3 m K0 hK0 q' hq' q hq
      rw [dist_eq_norm]
      rw [Metric.mem_ball] at hqb hqb'
      have hd : ‖q - q'‖ < 2 * r := by
        rw [← dist_eq_norm]
        calc dist q q' ≤ dist q z + dist q' z := dist_triangle_right _ _ _
          _ < 2 * r := by linarith
      have hlin : |K0| * (2 * r) = ε - 2 * r := by linear_combination h2r
      calc ‖iteratedFDeriv ℝ m (↿f) q - iteratedFDeriv ℝ m (↿f) q'‖ ≤ K0 * ‖q - q'‖ := hL
        _ ≤ |K0| * ‖q - q'‖ := mul_le_mul_of_nonneg_right (le_abs_self _) (norm_nonneg _)
        _ ≤ |K0| * (2 * r) := mul_le_mul_of_nonneg_left hd.le (abs_nonneg _)
        _ < ε := by linarith
    obtain ⟨L, hL⟩ := CompleteSpace.complete hcau
    exact ⟨L, hL⟩
  obtain ⟨E, hE⟩ : ∃ E : (m : ℕ) → ℝ × ℝ → ContinuousMultilinearMap ℝ (fun _ : Fin m => ℝ × ℝ) ℝ,
      E = fun m => extendFrom Ω (iteratedFDeriv ℝ m (↿f)) := ⟨_, rfl⟩
  have Econt : ∀ m : ℕ, ContinuousOn (E m) (closure Ω) := by
    intro m; rw [hE]; exact continuousOn_extendFrom subset_rfl (F4 m)
  have Eeq : ∀ m : ℕ, ∀ q ∈ Ω, E m q = iteratedFDeriv ℝ m (↿f) q := by
    intro m q hq; rw [hE]
    exact extendFrom_extends (fun p hp => (F2 m p hp).continuousAt.continuousWithinAt) q hq
  have Etend : ∀ m : ℕ, ∀ z ∈ closure Ω,
      Filter.Tendsto (iteratedFDeriv ℝ m (↿f)) (nhdsWithin z Ω) (nhds (E m z)) := by
    intro m z hz; rw [hE]; exact tendsto_extendFrom (F4 m z hz)
  have F6 : ∀ m : ℕ, ∀ z ∈ closure Ω, HasFDerivWithinAt (E m)
      (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (m + 1) => ℝ × ℝ) ℝ (E (m + 1) z))
      (closure Ω) z := by
    intro m z hz
    have hevq : ∀ q ∈ Ω, E m =ᶠ[nhds q] iteratedFDeriv ℝ m (↿f) := fun q hq =>
      Filter.eventuallyEq_of_mem (hΩo.mem_nhds hq) (fun p hp => Eeq m p hp)
    apply hasFDerivWithinAt_closure_of_tendsto_fderiv
    · intro q hq
      exact ((F2 m q hq).congr_of_eventuallyEq (hevq q hq)).differentiableWithinAt
    · exact hΩc
    · exact hΩo
    · intro y hy
      exact (Econt m y hy).mono subset_closure
    · have ht := ((continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (m + 1) => ℝ × ℝ) ℝ).continuous.tendsto
        (E (m + 1) z)).comp (Etend (m + 1) z hz)
      refine ht.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with q hq
      rw [(hevq q hq).fderiv_eq, fderiv_iteratedFDeriv]
  have hTcl : Ico 0 Xi ×ˢ Ioo (-1:ℝ) 1 ⊆ closure Ω := by
    rw [hΩdef, closure_prod_eq, closure_Ioo hXi.ne, closure_Ioo (by norm_num)]
    exact prod_mono Ico_subset_Icc_self Ioo_subset_Icc_self
  obtain ⟨g, hg⟩ : ∃ g : ℝ → ℝ → ℝ, g = fun X η => if 0 < X then f X η else (E 0 (X, η)) 0 :=
    ⟨_, rfl⟩
  have hgf : ∀ X η : ℝ, 0 < X → g X η = f X η := by
    intro X η hX; rw [hg]; exact if_pos hX
  have hgΩ : ∀ q ∈ Ω, (↿g) =ᶠ[nhds q] (↿f) := by
    intro q hq
    filter_upwards [hΩo.mem_nhds hq] with p hp
    exact hgf p.1 p.2 hp.1.1
  refine ⟨g, ?_, fun X η h0 _ => hgf X η h0, ?_, ?_⟩
  ·
    have hT : HasFTaylorSeriesUpToOn ((⊤ : ℕ∞) : ℕ∞ω) (↿g) (fun z m => E m z)
        (Ico 0 Xi ×ˢ Ioo (-1:ℝ) 1) := by
      apply HasFTaylorSeriesUpToOn.mk
      · intro z hz
        rw [ContinuousMultilinearMap.curry0_apply]
        obtain ⟨X, η⟩ := z
        show E 0 (X, η) 0 = g X η
        by_cases hX : 0 < X
        · have hzΩ : ((X, η) : ℝ × ℝ) ∈ Ω := ⟨⟨hX, hz.1.2⟩, hz.2⟩
          rw [Eeq 0 _ hzΩ, iteratedFDeriv_zero_apply, hgf X η hX]
          rfl
        · rw [hg]; exact (if_neg hX).symm
      · intro m _ z hz
        show HasFDerivWithinAt (E m) (E (m + 1) z).curryLeft (Ico 0 Xi ×ˢ Ioo (-1:ℝ) 1) z
        have heq : (E (m + 1) z).curryLeft = continuousMultilinearCurryLeftEquiv ℝ
            (fun _ : Fin (m + 1) => ℝ × ℝ) ℝ (E (m + 1) z) := by
          refine ContinuousLinearMap.ext fun x => ContinuousMultilinearMap.ext fun v => ?_
          rw [ContinuousMultilinearMap.curryLeft_apply, continuousMultilinearCurryLeftEquiv_apply]
        rw [heq]
        exact (F6 m z (hTcl hz)).mono hTcl
      · intro m _
        exact (Econt m).mono hTcl
    exact hT.contDiffOn
  ·
    intro m
    obtain ⟨C, hC⟩ := BD m f hf
    refine ⟨C, fun X η h0 h1 e1 e2 => ?_⟩
    have hq : ((X, η) : ℝ × ℝ) ∈ Ω := ⟨⟨h0, h1⟩, e1, e2⟩
    rw [((hgΩ _ hq).iteratedFDeriv ℝ m).eq_of_nhds]
    exact hC _ hq
  ·
    intro k
    obtain ⟨ρ', C, fc, hρ', hcont, hX⟩ := AN k
    refine ⟨ρ', C, fc, hρ', hcont, fun X h0 h1 => ?_⟩
    obtain ⟨a, b, c⟩ := hX X h0 h1
    refine ⟨a, b, fun η e1 e2 => ?_⟩
    have hev : (fun Y => f Y η) =ᶠ[nhds X] (fun Y => g Y η) := by
      filter_upwards [Ioo_mem_nhds h0 h1] with Y hY
      exact (hgf Y η hY.1).symm
    rw [c η e1 e2, hev.iteratedDeriv_eq k]

theorem bg_coef_holo : ∀ (h Xi : ℝ) (S G : ℕ → ℝ → ℝ → ℝ) (n : ℕ), 0 < h → h < 1 / 100 → 0 < Xi → 1 ≤ n → (∀ k : ℕ, k < n → BgHolo Xi (S k) ∧ BgHolo Xi (G k)) → (∀ i, BgHolo Xi (bgCoefA h n (G 0) (S 0) i)) ∧ (∀ i, BgHolo Xi (bgCoefB h n (S 0) i)) ∧ BgHolo Xi (bgKTh h S G n) ∧ BgHolo Xi (bgKZ h S n) ∧ BgHolo Xi (bgKRad h S G n) :=
by
  intro h Xi S G n hh0 hh1 _hXi hn hH

  have hgen : ∀ (φ : ℂ → ℂ) (ρ0 B : ℝ) (g : ℝ → ℝ), 0 < ρ0 → DifferentiableOn ℂ φ (cStrip ρ0) →
      (∀ w ∈ cStrip ρ0, ‖φ w‖ ≤ B) → (∀ η : ℝ, -1 < η → η < 1 → φ (η : ℂ) = ((g η : ℝ) : ℂ)) →
      BgHolo Xi (fun _ η => g η) := by
    intro φ ρ0 B g hρ hd hb hr
    refine ⟨fun k _ w => if k = 0 then φ w else 0, fun _ => ρ0, fun k => if k = 0 then B else 0,
      ?_, ?_, ?_, ?_, ?_⟩
    · intro k; exact ⟨hρ, le_rfl⟩
    · intro k
      by_cases hk : k = 0
      · simp only [if_pos hk]
        exact hd.continuousOn.comp continuous_snd.continuousOn (fun p hp => hp.2)
      · simp only [if_neg hk]
        exact continuousOn_const
    · intro k X _ _
      by_cases hk : k = 0
      · simp only [if_pos hk]
        exact ⟨hd, hb⟩
      · simp only [if_neg hk]
        exact ⟨differentiableOn_const _, fun w _ => by simp⟩
    · intro k X w _ _ _
      beta_reduce
      rw [if_neg (Nat.add_one_ne_zero k)]
      exact hasDerivAt_const _ _
    · intro X η _ _ h1 h2
      show (if (0:ℕ) = 0 then φ (η:ℂ) else 0) = ((g η : ℝ) : ℂ)
      rw [if_pos rfl]
      exact hr η h1 h2
  have hconst : ∀ c : ℝ, BgHolo Xi (fun _ _ => c) := fun c =>
    hgen (fun _ => (c : ℂ)) 1 ‖(c : ℂ)‖ (fun _ => c) one_pos (differentiableOn_const _)
      (fun _ _ => le_rfl) (fun _ _ _ => rfl)
  have hEta : BgHolo Xi (fun _ η => η) := by
    refine hgen (fun w => w) 1 3 (fun η => η) one_pos differentiableOn_id ?_ (fun _ _ _ => rfl)
    intro w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw
    obtain ⟨h1, h2, h3⟩ := hw
    have hre : |w.re| < 2 := abs_lt.mpr ⟨by linarith, by linarith⟩
    have hn' := Complex.norm_le_abs_re_add_abs_im w
    show ‖w‖ ≤ 3
    linarith
  have hLb : ∀ w ∈ cStrip (1 / 4), (1 / 2 : ℝ) ≤ ‖1 - 2 * (h : ℂ) * w ^ 2‖ := by
    intro w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw
    obtain ⟨h1, h2, h3⟩ := hw
    have hre : |w.re| < 5 / 4 := abs_lt.mpr ⟨by linarith, by linarith⟩
    have hn' := Complex.norm_le_abs_re_add_abs_im w
    have hw32 : ‖w‖ ≤ 3 / 2 := by linarith
    have hnorm : ‖2 * (h : ℂ) * w ^ 2‖ = 2 * h * ‖w‖ ^ 2 := by
      rw [norm_mul, norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hh0]
      norm_num
    have hsq : ‖w‖ ^ 2 ≤ 9 / 4 := by nlinarith [norm_nonneg w]
    have hsub := norm_sub_norm_le (1 : ℂ) (2 * (h : ℂ) * w ^ 2)
    rw [norm_one, hnorm] at hsub
    have hm := mul_le_mul_of_nonneg_left hsq hh0.le
    nlinarith
  have hLinv : BgHolo Xi (fun _ η => (1 - 2 * h * η ^ 2)⁻¹) := by
    refine hgen (fun w => (1 - 2 * (h : ℂ) * w ^ 2)⁻¹) (1 / 4) 2 (fun η => (1 - 2 * h * η ^ 2)⁻¹)
      (by norm_num) ?_ ?_ ?_
    · have hd0 : DifferentiableOn ℂ (fun w : ℂ => 1 - 2 * (h : ℂ) * w ^ 2) (cStrip (1 / 4)) := by
        fun_prop
      have hne : ∀ w ∈ cStrip (1 / 4), 1 - 2 * (h : ℂ) * w ^ 2 ≠ 0 := by
        intro w hw h0
        have := hLb w hw
        rw [h0, norm_zero] at this
        linarith
      exact hd0.inv hne
    · intro w hw
      have hx := hLb w hw
      show ‖(1 - 2 * (h : ℂ) * w ^ 2)⁻¹‖ ≤ 2
      rw [norm_inv]
      calc ‖1 - 2 * (h : ℂ) * w ^ 2‖⁻¹ ≤ (1 / 2 : ℝ)⁻¹ := inv_anti₀ (by norm_num) hx
        _ = 2 := by norm_num
    · intro η _ _
      show (1 - 2 * (h : ℂ) * (η : ℂ) ^ 2)⁻¹ = (((1 - 2 * h * η ^ 2)⁻¹ : ℝ) : ℂ)
      push_cast
      try ring
  have hAM := bgHolo_add_mul Xi
  have hadd : ∀ f g : ℝ → ℝ → ℝ, BgHolo Xi f → BgHolo Xi g →
      BgHolo Xi (fun X η => f X η + g X η) := fun f g hf hg => (hAM f g hf hg).1
  have hmul : ∀ f g : ℝ → ℝ → ℝ, BgHolo Xi f → BgHolo Xi g →
      BgHolo Xi (fun X η => f X η * g X η) := fun f g hf hg => (hAM f g hf hg).2
  have hpdX : ∀ f : ℝ → ℝ → ℝ, BgHolo Xi f → BgHolo Xi (pdX f) :=
    fun f hf => (bgHolo_pdX_pdE Xi f hf).1
  have hpdE : ∀ f : ℝ → ℝ → ℝ, BgHolo Xi f → BgHolo Xi (pdE f) :=
    fun f hf => (bgHolo_pdX_pdE Xi f hf).2
  have hXat : BgHolo Xi (fun X _ => X) := by
    refine ⟨fun k X _ => if k = 0 then (X : ℂ) else if k = 1 then 1 else 0, fun _ => 1,
      fun k => if k = 0 then Xi else 1, ?_, ?_, ?_, ?_, ?_⟩
    · intro k; exact ⟨one_pos, le_rfl⟩
    · intro k
      by_cases hk0 : k = 0
      · simp only [if_pos hk0]
        exact (Complex.continuous_ofReal.comp continuous_fst).continuousOn
      · by_cases hk1 : k = 1
        · simp only [if_neg hk0, if_pos hk1]
          exact continuousOn_const
        · simp only [if_neg hk0, if_neg hk1]
          exact continuousOn_const
    · intro k X hX0 hXi
      by_cases hk0 : k = 0
      · simp only [if_pos hk0]
        refine ⟨differentiableOn_const _, fun w _ => ?_⟩
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hX0]
        exact hXi.le
      · by_cases hk1 : k = 1
        · simp only [if_neg hk0, if_pos hk1]
          exact ⟨differentiableOn_const _, fun w _ => by simp⟩
        · simp only [if_neg hk0, if_neg hk1]
          exact ⟨differentiableOn_const _, fun w _ => by simp⟩
    · intro k X w _ _ _
      by_cases hk0 : k = 0
      · simp only [if_pos hk0, if_neg (Nat.add_one_ne_zero k), if_pos (show k + 1 = 1 by omega)]
        first
          | simpa using (hasDerivAt_id X).ofReal_comp
          | simpa using Complex.ofRealCLM.hasDerivAt (x := X)
      · by_cases hk1 : k = 1
        · simp only [if_neg hk0, if_pos hk1, if_neg (Nat.add_one_ne_zero k),
            if_neg (show k + 1 ≠ 1 by omega)]
          exact hasDerivAt_const _ _
        · simp only [if_neg hk0, if_neg hk1, if_neg (Nat.add_one_ne_zero k),
            if_neg (show k + 1 ≠ 1 by omega)]
          exact hasDerivAt_const _ _
    · intro X η _ _ _ _
      show (if (0:ℕ) = 0 then (X : ℂ) else if (0:ℕ) = 1 then 1 else 0) = ((X : ℝ) : ℂ)
      rw [if_pos rfl]
  have hcmul : ∀ (c : ℝ) (f : ℝ → ℝ → ℝ), BgHolo Xi f → BgHolo Xi (fun X η => c * f X η) :=
    fun c f hf => hmul (fun _ _ => c) f (hconst c) hf
  have hsub : ∀ f g : ℝ → ℝ → ℝ, BgHolo Xi f → BgHolo Xi g →
      BgHolo Xi (fun X η => f X η - g X η) := by
    intro f g hf hg
    have e : (fun X η => f X η - g X η) = fun X η => f X η + -1 * g X η := by
      funext X η; ring
    rw [e]
    exact hadd f (fun X η => -1 * g X η) hf (hcmul (-1) g hg)
  have hneg : ∀ f : ℝ → ℝ → ℝ, BgHolo Xi f → BgHolo Xi (fun X η => -f X η) := by
    intro f hf
    have e : (fun X η => -f X η) = fun X η => -1 * f X η := by
      funext X η; ring
    rw [e]
    exact hcmul (-1) f hf
  have hdiv : ∀ f g : ℝ → ℝ → ℝ, BgHolo Xi f → BgHolo Xi (fun X η => (g X η)⁻¹) →
      BgHolo Xi (fun X η => f X η / g X η) := by
    intro f g hf hg
    have e : (fun X η => f X η / g X η) = fun X η => f X η * (g X η)⁻¹ := by
      funext X η; rw [div_eq_mul_inv]
    rw [e]
    exact hmul f (fun X η => (g X η)⁻¹) hf hg
  have hpow : ∀ f : ℝ → ℝ → ℝ, BgHolo Xi f → BgHolo Xi (fun X η => f X η ^ 2) := by
    intro f hf
    have e : (fun X η => f X η ^ 2) = fun X η => f X η * f X η := by
      funext X η; ring
    rw [e]
    exact hmul f f hf hf
  have hite : ∀ (c : Prop) [Decidable c] (f g : ℝ → ℝ → ℝ), BgHolo Xi f → BgHolo Xi g →
      BgHolo Xi (fun X η => if c then f X η else g X η) := by
    intro c _ f g hf hg
    by_cases hc : c
    · have e : (fun X η => if c then f X η else g X η) = f := by
        funext X η; simp [hc]
      rw [e]; exact hf
    · have e : (fun X η => if c then f X η else g X η) = g := by
        funext X η; simp [hc]
      rw [e]; exact hg
  have hsum : ∀ (s : Finset ℕ) (F : ℕ → ℝ → ℝ → ℝ), (∀ i ∈ s, BgHolo Xi (F i)) →
      BgHolo Xi (fun X η => ∑ i ∈ s, F i X η) := by
    intro s F
    induction s using Finset.induction_on with
    | empty =>
      intro _
      simpa using hconst 0
    | @insert a s ha ih =>
      intro hF
      have e : (fun X η => ∑ i ∈ insert a s, F i X η) =
          fun X η => F a X η + ∑ i ∈ s, F i X η := by
        funext X η; rw [Finset.sum_insert ha]
      rw [e]
      exact hadd _ _ (hF a (Finset.mem_insert_self a s))
        (ih fun i hi => hF i (Finset.mem_insert_of_mem hi))
  have hUz : ∀ f : ℝ → ℝ → ℝ, BgHolo Xi f → BgHolo Xi (bgUz f) := by
    intro f hf
    unfold bgUz
    exact hadd _ _ hf (hmul _ _ hXat (hpdX f hf))
  have hZop : ∀ (b : ℝ) (f : ℝ → ℝ → ℝ), BgHolo Xi f → BgHolo Xi (simZop h b f) := by
    intro b f hf
    unfold simZop
    repeat' (first
      | exact hconst _
      | exact hEta
      | exact hLinv
      | exact hXat
      | assumption
      | with_reducible apply hpdX
