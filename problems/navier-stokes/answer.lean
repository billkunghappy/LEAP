    rw [h, abs_zero] at h2
    linarith
  obtain ⟨A0, hA0def⟩ : ∃ A0 : ℝ, A0 = (Real.sqrt (2 * B.Xa))⁻¹ := ⟨_, rfl⟩
  have hA0 : 0 ≤ A0 := by rw [hA0def]; positivity
  refine ⟨lr, fun k => ?_⟩
  obtain ⟨Mk, hMk⟩ := hKc.exists_bound_of_continuousOn
    ((hΦO.continuousOn_iteratedFDerivWithin (m := k) (by exact_mod_cast le_top) hOo.uniqueDiffOn).mono hKO)
  refine ⟨|Mk| * A0 ^ k, 0, ?_⟩
  intro γ ξ hl hA heta hD hX1 hX2 hR
  obtain ⟨hcp, hpC, hangC, hBsC⟩ := hrep γ hA hl
  obtain ⟨-, -, -, -, -, -, -, hc8, hc9, -⟩ := hfr γ hA
  have hx0 : 0 < ξ.1 := hD.1
  have hq0 : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hD.2.1])).1
  have hQb0 : 0 < Qb γ.1 := by unfold Qb; positivity
  have hXC : B.Xa * (2 * qC B.h ξ) ≤ ξ.1 ^ 2 := by
    have h := hX1
    unfold XC at h
    rwa [le_div_iff₀ (by positivity)] at h
  have hwin := (etaL_band_window_v5 B.h γ ξ hq0 heta).1
  rw [lt_div_iff₀ hQb0] at hwin
  have hsgn : |sgn γ.2.2| = 1 := by unfold sgn; split_ifs <;> simp

  obtain ⟨β, hβdef⟩ : ∃ β : ℝ, β = sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 := ⟨_, rfl⟩
  obtain ⟨κ, hκdef⟩ : ∃ κ : ℝ, κ = 1 * c0f5 B G γ * Real.sqrt (1 + sco B G γ 0 ^ 2) := ⟨_, rfl⟩
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = pang5 B G γ * Real.sqrt (Qb γ.1) / ξ.1 := ⟨_, rfl⟩
  obtain ⟨p, hpdef⟩ : ∃ p : ℝ, p = pzr5 B G γ := ⟨_, rfl⟩
  have hcp' : c ≤ |p| := by rw [hpdef]; exact hcp
  have hp0 : p ≠ 0 := by
    intro h
    rw [h, abs_zero] at hcp'
    linarith
  have hβb : |β| ≤ |Cr| * |G.ustar| := by
    rw [hβdef, abs_div, abs_mul, abs_mul, hsgn, one_mul, abs_two]
    have h1 : |Bs5 B G γ| * |G.ustar| ≤ |Cr| * |G.ustar| :=
      mul_le_mul_of_nonneg_right (hBsC.trans (le_abs_self _)) (abs_nonneg _)
    have h2 : 0 ≤ |Bs5 B G γ| * |G.ustar| := by positivity
    linarith
  have hsco : |sco B G γ 0| ≤ |G.ustar| := by
    unfold sco
    rw [mul_zero, zero_div, add_zero, abs_mul, hsgn, one_mul, abs_div, abs_two]
    linarith [abs_nonneg G.ustar]
  have hκb : |κ| ≤ |Cf| * (1 + |G.ustar|) := by
    have hc0f : |c0f5 B G γ| ≤ |Cf| :=
      (abs_le.mpr ⟨by linarith, by linarith⟩).trans (le_abs_self Cf)
    have hsq2 : sco B G γ 0 ^ 2 ≤ |G.ustar| ^ 2 := by
      rw [← sq_abs (sco B G γ 0)]
      exact pow_le_pow_left₀ (abs_nonneg _) hsco 2
    have hsq1 : 1 + sco B G γ 0 ^ 2 ≤ (1 + |G.ustar|) ^ 2 := by
      have e : (1 + |G.ustar|) ^ 2 = 1 + 2 * |G.ustar| + |G.ustar| ^ 2 := by ring
      rw [e]
      linarith [abs_nonneg G.ustar]
