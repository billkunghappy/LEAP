    fun N y h1 h2 => mul_nonneg (hew_nn y) (Real.rpow_nonneg (hed_pos y h1 h2).le _)

  choose C N hCN using hbd
  obtain ⟨Cs, hCs⟩ : ∃ Cs : ℝ, Cs = ∑ j ∈ Finset.range (m + 1), |C j| := ⟨_, rfl⟩
  obtain ⟨Ns, hNs⟩ : ∃ Ns : ℝ, Ns = ∑ j ∈ Finset.range (m + 1), |N j| := ⟨_, rfl⟩
  have hCs0 : 0 ≤ Cs := by rw [hCs]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
  have hNs0 : 0 ≤ Ns := by rw [hNs]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
  have hnorm : ∀ j, j ≤ m → ∀ x e : ℝ, Xa < x → x < Xb → -1 < e → e < 1 →
      ‖iteratedFDeriv ℝ j (↿r1) (x, e)‖ ≤
        Cs * (edgeWeight Xa Xb aa ab x * edgeDist Xa Xb x ^ (-Ns)) ∧
      ‖iteratedFDeriv ℝ j (↿r2) (x, e)‖ ≤
        Cs * (edgeWeight Xa Xb aa ab x * edgeDist Xa Xb x ^ (-Ns)) := by
    intro j hj x e hx1 hx2 he1 he2
    obtain ⟨b1, b2⟩ := hCN j x e hx1 hx2 he1 he2
    have hew0 := hew_nn x
    have hed0 := hed_pos x hx1 hx2
    have hjm : j ∈ Finset.range (m + 1) := Finset.mem_range.mpr (Nat.lt_succ_of_le hj)
    have hCj : |C j| ≤ Cs := by
      rw [hCs]; exact Finset.single_le_sum (f := fun i => |C i|) (fun i _ => abs_nonneg _) hjm
    have hNj : |N j| ≤ Ns := by
      rw [hNs]; exact Finset.single_le_sum (f := fun i => |N i|) (fun i _ => abs_nonneg _) hjm
    have hrp : edgeDist Xa Xb x ^ (-N j) ≤ edgeDist Xa Xb x ^ (-Ns) :=
      Real.rpow_le_rpow_of_exponent_ge hed0 (hed_le x) (by linarith [le_abs_self (N j)])
    have hp1 : 0 ≤ edgeWeight Xa Xb aa ab x * edgeDist Xa Xb x ^ (-N j) :=
      mul_nonneg hew0 (Real.rpow_nonneg hed0.le _)
    have key : C j * edgeWeight Xa Xb aa ab x * edgeDist Xa Xb x ^ (-N j) ≤
        Cs * (edgeWeight Xa Xb aa ab x * edgeDist Xa Xb x ^ (-Ns)) := by
      calc C j * edgeWeight Xa Xb aa ab x * edgeDist Xa Xb x ^ (-N j)
          = C j * (edgeWeight Xa Xb aa ab x * edgeDist Xa Xb x ^ (-N j)) := by ring
        _ ≤ |C j| * (edgeWeight Xa Xb aa ab x * edgeDist Xa Xb x ^ (-N j)) :=
            mul_le_mul_of_nonneg_right (le_abs_self _) hp1
        _ ≤ Cs * (edgeWeight Xa Xb aa ab x * edgeDist Xa Xb x ^ (-Ns)) :=
            mul_le_mul hCj (mul_le_mul_of_nonneg_left hrp hew0) hp1 ((abs_nonneg _).trans hCj)
    exact ⟨b1.trans key, b2.trans key⟩

  obtain ⟨K, hK0, hK⟩ := quasi Xa Xm Xb aa ab Ns hXa hXam hXmb haa hab hNs0

  have hO2 : IsOpen (Ioi (0:ℝ) ×ˢ (univ : Set ℝ)) := isOpen_Ioi.prod isOpen_univ
  have cbound : ∀ a : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ a (Ioi 0 ×ˢ univ) → ∃ A : ℝ, 0 ≤ A ∧
      ∀ j, j ≤ m → ∀ q ∈ Icc Xm Xb ×ˢ Icc (-1:ℝ) 1, ‖iteratedFDeriv ℝ j a q‖ ≤ A := by
    intro a ha
    have hKc : IsCompact (Icc Xm Xb ×ˢ Icc (-1:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
    have hsub : Icc Xm Xb ×ˢ Icc (-1:ℝ) 1 ⊆ Ioi 0 ×ˢ univ :=
      fun q hq => ⟨show (0:ℝ) < q.1 by linarith [hq.1.1], mem_univ _⟩
    have hb : ∀ j : ℕ, ∃ A : ℝ, ∀ q ∈ Icc Xm Xb ×ˢ Icc (-1:ℝ) 1,
