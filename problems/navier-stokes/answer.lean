  have hP : InWg5 B G (qsOf l0) Bo (wmoAmp5 B G D) := (hw l0 (by omega)).1 D Bo hD hDv
  obtain ⟨M0, hM0d⟩ : ∃ M0 : Cyl → Fin 3 → ℝ, M0 = fun _ _ => 0 := ⟨_, rfl⟩
  have hU : ∀ (Y₀ : ℝ × ℝ) (x : ℝ³) (t : ℝ), corrOn B l0 x t → evOff B.h (wIncX5 B G l0 D) Y₀ x t =
      cyl2cart x (fun a => M0 (ptOf x t (Yph B.h (rad x) t + Y₀)) a +
        qC B.h (ptOf x t (Yph B.h (rad x) t + Y₀)) ^ (-Aex B.h) *
          waveV5 B G (wmoAmp5 B G D) (thetaOf x) (ptOf x t (Yph B.h (rad x) t + Y₀)) a) := by
    intro Y₀ x t hc
    rw [hFr l0 (by omega) D Bo hD hDv Y₀ x t hc, hM0d]
    simp only [zero_add]
  have hTr := hTi l0 (by omega) M0 (wmoAmp5 B G D) (wmoAmp5 B G D) Bo Bo (wIncX5 B G l0 D)
    (wIncX5 B G l0 D) (by rw [hM0d]; exact contDiffOn_const) hP hP hU
    (fun Y₀ x t hc => hFr l0 (by omega) D Bo hD hDv Y₀ x t hc)
  have hPh : InWg5 B G (qsOf l0) (Bo - kapS) (fun γ m ξ =>
      ((qC B.h ξ ^ (1/2:ℝ) * (kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) : ℝ) : ℂ) *
        (((nPhi5 B G γ ξ 0 : ℝ) : ℂ) * wmoAmp5 B G D γ m ξ 0 + ((nPhi5 B G γ ξ 1 : ℝ) : ℂ) * wmoAmp5 B G D γ m ξ 1
          + ((nPhi5 B G γ ξ 2 : ℝ) : ℂ) * wmoAmp5 B G D γ m ξ 2)) :=
    hTv l0 (by omega) D Bo hD hDv
  generalize hPd : wmoAmp5 B G D = P at hP hPh hTr
  obtain ⟨hEs, hEb⟩ := hPw l0 (by omega) P P Bo Bo hP hP hPh hPh

  obtain ⟨g, hgd⟩ : ∃ g : WC, g = fun γ N ξ => (1/2 : ℂ) • pchG5 B G M0 P P γ N ξ := ⟨_, rfl⟩
  have hgv : ∀ γ N η, g γ N η = (1/2 : ℂ) • pchG5 B G M0 P P γ N η := by
    intro γ N η; rw [hgd]
  obtain ⟨E, hEd⟩ : ∃ E : Lab → ℤ → Cyl → (Fin 3 → ℂ), E = fun γ N η =>
      ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) •
        (pchPair5 B G (pchAmp5 B P) (pchAmp5 B P) N γ η + pchPair5 B G (pchAmp5 B P) (pchAmp5 B P) N γ η) :=
