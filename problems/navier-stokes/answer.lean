        show ‖((kk t * t ^ j : ℝ) : ℂ) * rc j (t * X) w‖ ≤ |kk t * t ^ j| * |C j|
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
        exact mul_le_mul_of_nonneg_left (hbC j _ w hm.1 hm.2 hw) (abs_nonneg _)
      · intro w hw
        refine (Complex.continuous_ofReal.comp_continuousOn (hκc j)).mul ?_
        have hc : ContinuousOn (fun t : ℝ => ((t * X, w) : ℝ × ℂ)) (Ioc 0 1) :=
