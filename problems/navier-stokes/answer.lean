theorem frame5_alg_lip : ∀ (κ D : ℝ), 0 < κ → κ < 2 → κ ≤ D → ∃ L : ℝ, 0 ≤ L ∧
    ∀ (s p a b F0 lam s' p' a' b' F0' lam' : ℝ) (g N g' N' : ℝ × ℝ),
      1/4 ≤ s → s ≤ 4 → κ ≤ p → p ≤ D → κ ≤ a → a ≤ D → |b| ≤ D →
      (2 + κ) * a ≤ a ^ 2 + b ^ 2 →
      1/4 ≤ s' → s' ≤ 4 → κ ≤ p' → p' ≤ D → κ ≤ a' → a' ≤ D → |b'| ≤ D →
      (2 + κ) * a' ≤ a' ^ 2 + b' ^ 2 →
      F0 = s * p → g = F0 • (-a, b) → N = (eN g)⁻¹ • g →
      lam = Real.sqrt (-(2 * F0 * N.1) * (2 * F0 * N.1 + eN g)) →
      F0' = s' * p' → g' = F0' • (-a', b') → N' = (eN g')⁻¹ • g' →
      lam' = Real.sqrt (-(2 * F0' * N'.1) * (2 * F0' * N'.1 + eN g')) →
      |F0 - F0'| + eN (N - N') + |lam - lam'| + |lam / (2 * F0 * N.1) - lam' / (2 * F0' * N'.1)| ≤
        L * (|s - s'| + |p - p'| + |a - a'| + |b - b'|) :=
by
  intro κ D hκ hκ2 hκD
  have hD : 0 < D := lt_of_lt_of_le hκ hκD
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = κ⁻¹ := ⟨_, rfl⟩
  have hK0 : 0 < K := by rw [hK]; positivity
  have hKk : K * κ = 1 := by rw [hK]; exact inv_mul_cancel₀ hκ.ne'

  have P1 : ∀ (x y x' y' X Y Cx Cy δ : ℝ), |x| ≤ X → |y'| ≤ Y → |x - x'| ≤ Cx * δ →
      |y - y'| ≤ Cy * δ → 0 ≤ X → 0 ≤ Y → |x * y - x' * y'| ≤ (X * Cy + Y * Cx) * δ := by
    intro x y x' y' X Y Cx Cy δ hx hy hdx hdy hX hY
    have e : x * y - x' * y' = x * (y - y') + (x - x') * y' := by ring
    rw [e]
    calc |x * (y - y') + (x - x') * y'| ≤ |x * (y - y')| + |(x - x') * y'| := abs_add_le _ _
      _ = |x| * |y - y'| + |x - x'| * |y'| := by rw [abs_mul, abs_mul]
      _ ≤ X * (Cy * δ) + (Cx * δ) * Y :=
          add_le_add (mul_le_mul hx hdy (abs_nonneg _) hX)
            (mul_le_mul hdx hy (abs_nonneg _) (le_trans (abs_nonneg _) hdx))
      _ = (X * Cy + Y * Cx) * δ := by ring
  have P2 : ∀ (x x' M C δ : ℝ), 0 < x → 0 < x' → x⁻¹ ≤ M → x'⁻¹ ≤ M → |x - x'| ≤ C * δ →
