  rw [hdZF']
  linear_combination (-(dZ P ξ)) * r1 + ((Aex B.h - 1/2) * P ξ * dZ (qC B.h) ξ) * r2

theorem arem_mean_zero_v5 : ∀ (B : BG) (l0 : ℕ) (g : Cyl → ℝ) (α : ℝ), B.ok → 10 ≤ l0 →
    InM B (qsOf l0) α (nrm B (Aex B.h) g) → ShellSupp B g → (∀ ξ ∈ DomC B.h (qsOf l0), yAvg g ξ = 0) →
    ∀ ξ ∈ DomC B.h (qsOf l0), yAvg (fun η => g η - Arem B 1 g η) ξ = 0 :=
by

  have one : ∀ (f : ℝ → ℝ) (c : ℝ), Function.Periodic f 1 →
      ∫ x in (0:ℝ)..1, f (x + c) = ∫ x in (0:ℝ)..1, f x := by
    intro f c hf
    rw [intervalIntegral.integral_comp_add_right f c, zero_add, add_comm (1:ℝ) c]
    have h := hf.intervalIntegral_add_eq c 0
    rw [zero_add] at h
    exact h

  have hiter : ∀ ψ : ℝ × ℝ → ℝ, Continuous ψ →
      ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, ψ Y = ∫ y₁ in (0:ℝ)..1, ∫ y₂ in (0:ℝ)..1, ψ (y₁, y₂) := by
    intro ψ hψ
    have hint : IntegrableOn ψ (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)
        ((volume : Measure ℝ).prod (volume : Measure ℝ)) :=
      hψ.continuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
    rw [Measure.volume_eq_prod, setIntegral_prod ψ hint]
    simp only [intervalIntegral.integral_of_le (zero_le_one : (0:ℝ) ≤ 1), integral_Icc_eq_integral_Ioc]

  have hsq : ∀ (φ : ℝ × ℝ → ℝ) (w : ℝ × ℝ), Continuous φ →
      (∀ Y : ℝ × ℝ, φ (Y + ((1:ℝ), (0:ℝ))) = φ Y) → (∀ Y : ℝ × ℝ, φ (Y + ((0:ℝ), (1:ℝ))) = φ Y) →
      ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, φ (Y + w) =
        ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, φ Y := by
    intro φ w hφ hp1 hp2
    obtain ⟨w₁, w₂⟩ := w
    have e1 : ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, φ (Y + (w₁, w₂)) =
        ∫ y₁ in (0:ℝ)..1, ∫ y₂ in (0:ℝ)..1, φ ((y₁, y₂) + (w₁, w₂)) :=
      hiter (fun Y => φ (Y + (w₁, w₂))) (hφ.comp (continuous_id.add continuous_const))
    have e2 : ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, φ Y =
        ∫ y₁ in (0:ℝ)..1, ∫ y₂ in (0:ℝ)..1, φ (y₁, y₂) := hiter φ hφ
    obtain ⟨G, hG⟩ : ∃ G : ℝ → ℝ, G = fun s => ∫ y₂ in (0:ℝ)..1, φ (s, y₂) := ⟨_, rfl⟩
    have hGper : Function.Periodic G 1 := by
      intro s
      rw [hG]
      show ∫ y₂ in (0:ℝ)..1, φ (s + 1, y₂) = ∫ y₂ in (0:ℝ)..1, φ (s, y₂)
      congr 1
      funext y₂
      have h := hp1 (s, y₂)
      rw [Prod.mk_add_mk, add_zero] at h
      exact h
    have hinner : ∀ y₁ : ℝ, ∫ y₂ in (0:ℝ)..1, φ ((y₁, y₂) + (w₁, w₂)) = G (y₁ + w₁) := by
      intro y₁
      have hper : Function.Periodic (fun s => φ (y₁ + w₁, s)) 1 := by
        intro s
        have h := hp2 (y₁ + w₁, s)
        rw [Prod.mk_add_mk, add_zero] at h
        exact h
      have h := one (fun s => φ (y₁ + w₁, s)) w₂ hper
      rw [hG]
      simp only [Prod.mk_add_mk]
      exact h
    rw [e1, e2]
    simp only [hinner]
    rw [one G w₁ hGper]
    subst hG
    rfl

  have hfub : ∀ (H : ℝ × ℝ → ℝ → ℝ) (a b : ℝ),
      ContinuousOn (Function.uncurry H) ((Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ×ˢ Set.Icc a b) →
      IntegrableOn (fun Y => ∫ r in Set.Icc a b, H Y r) (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ∧
      ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, ∫ r in Set.Icc a b, H Y r =
        ∫ r in Set.Icc a b, ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, H Y r := by
    intro H a b hH
    have hK : IsCompact ((Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ×ˢ Set.Icc a b) :=
      (isCompact_Icc.prod isCompact_Icc).prod isCompact_Icc
    have hI : Integrable (Function.uncurry H)
        (((volume : Measure (ℝ × ℝ)).restrict (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)).prod
          ((volume : Measure ℝ).restrict (Set.Icc a b))) := by
      rw [Measure.prod_restrict]
      exact hH.integrableOn_compact hK
    exact ⟨hI.integral_prod_left, integral_integral_swap hI⟩

  rintro B l0 g α hok hl0 hg hsh hY ⟨r, z, t, Y0⟩ hξ
  have hξ' : 0 < r ∧ t < 1 ∧ qC B.h ((r, z, t, Y0) : Cyl) < qsOf l0 := hξ
  obtain ⟨hr, ht, hqlt⟩ := hξ'
  have hqs0 : 0 < qsOf l0 := by
    show (0:ℝ) < (2:ℝ) ^ (-(l0:ℝ))
    exact Real.rpow_pos_of_pos (by norm_num) _
  have hqs10 : qsOf l0 ≤ (2:ℝ) ^ (-(10:ℝ)) := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ (2:ℝ) ^ (-(10:ℝ))
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
    have : (10:ℝ) ≤ (l0:ℝ) := by exact_mod_cast hl0
    linarith
  obtain ⟨hgs, -⟩ := g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) α g hok hg
  have hgc : ContinuousOn g (DomC B.h (qsOf l0)) := hgs.continuousOn
  have hdeck := (deck_deriv_invariant_v5 B (qsOf l0) α (nrm B (Aex B.h) g) hok hqs0 hqs10 hg).1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hmem : ∀ (r' : ℝ) (W : ℝ × ℝ), 0 < r' → ((r', z, t, W) : Cyl) ∈ DomC B.h (qsOf l0) :=
    fun r' W hr' => show 0 < r' ∧ t < 1 ∧ qC B.h ((r', z, t, W) : Cyl) < qsOf l0 from ⟨hr', ht, hqlt⟩
  obtain ⟨q, hqdef⟩ : ∃ q : ℝ, q = qC B.h ((r, z, t, Y0) : Cyl) := ⟨_, rfl⟩
  have hq0 : 0 < q := by
    rw [hqdef]
    exact (hok.1.1 z (1 - t) (by linarith)).1
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = Real.sqrt (2 * B.Xa * q) := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : ℝ, b = Real.sqrt (2 * B.Xb * q) := ⟨_, rfl⟩
  have ha0 : 0 < a := by
    rw [ha]
    exact Real.sqrt_pos.mpr (mul_pos (mul_pos two_pos hXa) hq0)

  have hsupp : ∀ (r' : ℝ) (W : ℝ × ℝ), 0 < r' → (r' < a ∨ b < r') → g ((r', z, t, W) : Cyl) = 0 := by
    intro r' W hr' hab
    refine hsh _ ?_
    have hX : XC B.h ((r', z, t, W) : Cyl) = r' ^ 2 / (2 * q) := by
      subst hqdef
      rfl
    rw [hX]
    rcases hab with h | h
    · left
      rw [ha] at h
      have h2 : r' ^ 2 < 2 * B.Xa * q := (Real.lt_sqrt hr'.le).mp h
      rw [div_le_iff₀ (by linarith)]
      linarith
    · right
      rw [hb] at h
      have h2 : 2 * B.Xb * q < r' ^ 2 := (Real.sqrt_lt' hr').mp h
      rw [le_div_iff₀ (by linarith)]
      linarith

  have hper : ∀ (r' : ℝ) (W : ℝ × ℝ) (i j : ℤ), 0 < r' →
      g ((r', z, t, W + ((i:ℝ), (j:ℝ))) : Cyl) = g ((r', z, t, W) : Cyl) := by
    intro r' W i j hr'
    have hm := hmem r' W hr'
    have h1 : qC B.h ((r', z, t, W) : Cyl) ^ Aex B.h * g ((r', z, t, W + ((i:ℝ), (j:ℝ))) : Cyl) =
        qC B.h ((r', z, t, W) : Cyl) ^ Aex B.h * g ((r', z, t, W) : Cyl) :=
      hg.2.1 _ hm _ (hdeck _ hm i j)
    have hq' : 0 < qC B.h ((r', z, t, W) : Cyl) := by
      show 0 < simScale B.h z (1 - t)
      exact (hok.1.1 z (1 - t) (by linarith)).1
    exact mul_left_cancel₀ (Real.rpow_pos_of_pos hq' _).ne' h1

  have hslc : ∀ r' : ℝ, 0 < r' → Continuous (fun W : ℝ × ℝ => g ((r', z, t, W) : Cyl)) := by
    intro r' hr'
    exact hgc.comp_continuous (f := fun W : ℝ × ℝ => ((r', z, t, W) : Cyl)) (by fun_prop)
      (fun W => hmem r' W hr')

  have hdR : ∀ Y' : ℝ × ℝ, dR B.h (fun η => chiM B (XC B.h η)) ((r, z, t, Y') : Cyl) =
      dR B.h (fun η => chiM B (XC B.h η)) ((r, z, t, (0:ℝ × ℝ)) : Cyl) := by
    intro Y'
    have hfun : (fun x : Cyl => chiM B (XC B.h (x + ((0:ℝ), (0:ℝ), (0:ℝ), Y')))) =
        fun η => chiM B (XC B.h η) := by
      funext x
      obtain ⟨x1, x2, x3, x4⟩ := x
      simp only [Prod.mk_add_mk, add_zero]
      rfl
    have hpt : ((r, z, t, (0:ℝ × ℝ)) : Cyl) + ((0:ℝ), (0:ℝ), (0:ℝ), Y') = ((r, z, t, Y') : Cyl) := by
      simp only [Prod.mk_add_mk, add_zero, zero_add]
    have h1 : fderiv ℝ (fun η : Cyl => chiM B (XC B.h η)) ((r, z, t, Y') : Cyl) =
        fderiv ℝ (fun η : Cyl => chiM B (XC B.h η)) ((r, z, t, (0:ℝ × ℝ)) : Cyl) := by
      have h2 := fderiv_comp_add_right (𝕜 := ℝ) (f := fun η : Cyl => chiM B (XC B.h η))
        (x := ((r, z, t, (0:ℝ × ℝ)) : Cyl)) (((0:ℝ), (0:ℝ), (0:ℝ), Y') : Cyl)
      rw [hpt] at h2
      rw [← h2]
      congr 1
    show fderiv ℝ _ _ (1, 0, 0, (drx B.h * r ^ (drx B.h - 1)) • vrv) =
      fderiv ℝ _ _ (1, 0, 0, (drx B.h * r ^ (drx B.h - 1)) • vrv)
    rw [h1]

  obtain ⟨H, hH⟩ : ∃ H : ℝ × ℝ → ℝ → ℝ, H = fun Y' r' =>
      r' ^ ((1:ℕ):ℝ) * g ((r', z, t, Y' + (r' ^ drx B.h - r ^ drx B.h) • vrv) : Cyl) := ⟨_, rfl⟩
  have hHv : ∀ Y' r', H Y' r' = r' ^ ((1:ℕ):ℝ) * g ((r', z, t, Y' + (r' ^ drx B.h - r ^ drx B.h) • vrv) : Cyl) := by
    intro Y' r'
    rw [hH]
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = r ^ (-((1:ℕ):ℝ)) *
      dR B.h (fun η => chiM B (XC B.h η)) ((r, z, t, (0:ℝ × ℝ)) : Cyl) := ⟨_, rfl⟩

  have hArem : ∀ Y' : ℝ × ℝ, Arem B 1 g ((r, z, t, Y') : Cyl) = K * ∫ r' in Set.Icc a b, H Y' r' := by
    intro Y'
    have htr : ∫ r' in Set.Ioi (0:ℝ), r' ^ ((1:ℕ):ℝ) * g (pathPt B.h ((r, z, t, Y') : Cyl) r') =
        ∫ r' in Set.Icc a b, H Y' r' := by
      calc ∫ r' in Set.Ioi (0:ℝ), r' ^ ((1:ℕ):ℝ) * g (pathPt B.h ((r, z, t, Y') : Cyl) r')
          = ∫ r' in Set.Ioi (0:ℝ), H Y' r' := by
            congr 1
            funext r'
            exact (hHv Y' r').symm
        _ = ∫ r' in Set.Icc a b, H Y' r' := by
            apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi
            · intro x hx
              exact lt_of_lt_of_le ha0 hx.1
            · intro x hx
              rw [hHv]
              have hx0 : 0 < x := hx.1
              have hout : x < a ∨ b < x := by
                by_contra hc
                push_neg at hc
                exact hx.2 ⟨hc.1, hc.2⟩
              rw [hsupp x _ hx0 hout, mul_zero]
    show r ^ (-((1:ℕ):ℝ)) * dR B.h (fun η => chiM B (XC B.h η)) ((r, z, t, Y') : Cyl) *
        ∫ r' in Set.Ioi (0:ℝ), r' ^ ((1:ℕ):ℝ) * g (pathPt B.h ((r, z, t, Y') : Cyl) r') = _
    rw [hdR Y', htr, hK]

  have hHc : ContinuousOn (Function.uncurry H) ((Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ×ˢ Set.Icc a b) := by
    have hpow : ContinuousOn (fun p : (ℝ × ℝ) × ℝ => p.2 ^ drx B.h)
        ((Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ×ˢ Set.Icc a b) := by
      intro p hp
      have hp0 : p.2 ≠ 0 := (lt_of_lt_of_le ha0 hp.2.1).ne'
      exact ((Real.continuousAt_rpow_const p.2 (drx B.h) (Or.inl hp0)).comp
        continuous_snd.continuousAt).continuousWithinAt
    have hψ : ContinuousOn (fun p : (ℝ × ℝ) × ℝ =>
        ((p.2, z, t, p.1 + (p.2 ^ drx B.h - r ^ drx B.h) • vrv) : Cyl))
        ((Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ×ˢ Set.Icc a b) :=
      (continuous_snd.continuousOn).prodMk (continuousOn_const.prodMk (continuousOn_const.prodMk
        (continuous_fst.continuousOn.add ((hpow.sub continuousOn_const).smul continuousOn_const))))
    have hg' : ContinuousOn (fun p : (ℝ × ℝ) × ℝ =>
        g ((p.2, z, t, p.1 + (p.2 ^ drx B.h - r ^ drx B.h) • vrv) : Cyl))
        ((Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ×ˢ Set.Icc a b) :=
      hgc.comp hψ (fun p hp => hmem _ _ (lt_of_lt_of_le ha0 hp.2.1))
    have hp1 : ContinuousOn (fun p : (ℝ × ℝ) × ℝ => p.2 ^ ((1:ℕ):ℝ))
        ((Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) ×ˢ Set.Icc a b) := by
      have e : (fun p : (ℝ × ℝ) × ℝ => p.2 ^ ((1:ℕ):ℝ)) = fun p => p.2 := by
        funext p
        simp
      rw [e]
      exact continuous_snd.continuousOn
    exact (hp1.mul hg').congr (fun p _ => hHv p.1 p.2)

  have hin : ∀ r' ∈ Set.Icc a b, ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, H Y r' = 0 := by
    intro r' hr'
    have hr0 : 0 < r' := lt_of_lt_of_le ha0 hr'.1
    have hs : ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
          g ((r', z, t, Y + (r' ^ drx B.h - r ^ drx B.h) • vrv) : Cyl) =
        ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g ((r', z, t, Y) : Cyl) :=
      hsq (fun W => g ((r', z, t, W) : Cyl)) ((r' ^ drx B.h - r ^ drx B.h) • vrv) (hslc r' hr0)
        (fun Y => by
          have h := hper r' Y 1 0 hr0
          rw [Int.cast_one, Int.cast_zero] at h
          exact h)
        (fun Y => by
          have h := hper r' Y 0 1 hr0
          rw [Int.cast_one, Int.cast_zero] at h
          exact h)
    have hy' : ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g ((r', z, t, Y) : Cyl) = 0 :=
      hY _ (hmem r' (0:ℝ × ℝ) hr0)
    simp only [hHv]
    rw [integral_const_mul, hs, hy', mul_zero]

  show ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, (g ((r, z, t, Y) : Cyl) - Arem B 1 g ((r, z, t, Y) : Cyl)) = 0
  have hg_int : IntegrableOn (fun Y : ℝ × ℝ => g ((r, z, t, Y) : Cyl)) (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) :=
    (hslc r hr).continuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
  obtain ⟨hJint, hswap⟩ := hfub H a b hHc
  have hKJ : Integrable (fun Y : ℝ × ℝ => K * ∫ r' in Set.Icc a b, H Y r')
      ((volume : Measure (ℝ × ℝ)).restrict (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) :=
    Integrable.const_mul hJint K
  simp only [hArem]
  rw [integral_sub hg_int hKJ, integral_const_mul, hswap, setIntegral_eq_zero_of_forall_eq_zero hin,
    mul_zero, sub_zero]
  exact hY _ hξ

theorem azimuthal_potential_class_v5 : ∀ (B : BG), B.ok → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (g : Cyl → ℝ) (α : ℝ),
    InM B (qsOf l0) α (nrm B (Aex B.h) g) → ShellSupp B g → (∀ ξ ∈ DomC B.h (qsOf l0), yAvg g ξ = 0) →
    InM B (qsOf l0) α (nrm B (Aex B.h - 1/2) (shInd B (Tprim B 1 g))) ∧
    InM B (qsOf l0) α (nrm B (Aex B.h) (fun ξ => dR B.h (shInd B (Tprim B 1 g)) ξ + shInd B (Tprim B 1 g) ξ / ξ.1)) ∧
    InM B (qsOf l0) (α + 1) (nrm B (Aex B.h) (fun ξ => -dZ (shInd B (Tprim B 1 g)) ξ)) ∧
    (∀ ξ ∈ DomC B.h (qsOf l0), dR B.h (shInd B (Tprim B 1 g)) ξ + shInd B (Tprim B 1 g) ξ / ξ.1
        = g ξ - Arem B 1 g ξ) ∧
    (∀ m N : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0),
        NB B.h (nrm B (Aex B.h) (Arem B 1 g)) m ξ ≤ C * qC B.h ξ ^ (N : ℝ)) ∧
    (∀ ξ ∈ DomC B.h (qsOf l0), (B.m1 ≤ XC B.h ξ ∧ XC B.h ξ ≤ B.m2) ∨ Arem B 1 g ξ = 0) ∧
    (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 →
        radMom (fun ξ => dR B.h (shInd B (Tprim B 1 g)) ξ + shInd B (Tprim B 1 g) ξ / ξ.1) 1 z t = 0) :=
by
  intro B hok
  have hh : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  have hm12 : B.m1 < B.m2 := hok.2.1.2.2.2.2.1
  have hSN : SimNorm B.h := simscale_normalized_v4 B.h hh hh1 hok.1
  obtain ⟨l_ic, hic⟩ := mom_icut_class_v4 B hok hSN
  obtain ⟨l_dz, hdz⟩ := dz_gain_v5 B hok hSN
  refine ⟨l_ic + l_dz + 10, ?_⟩
  intro l0 hl0 g α hg hsh hY
  have hqs0 : 0 < qsOf l0 := by
    show (0:ℝ) < (2:ℝ) ^ (-(l0:ℝ))
    exact Real.rpow_pos_of_pos (by norm_num) _
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  obtain ⟨hDopen, -, hqpos, -, -, -⟩ := domc_open_calculus B (qsOf l0) hok
  obtain ⟨hgs, -⟩ := g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) α g hok hg
  have hCA := (mom_class_algebra_v4 B (qsOf l0) hok hqs0 hqs1).1
  have hcong : ∀ (γ : ℝ) (f k : Cyl → ℝ), InM B (qsOf l0) γ f →
      (∀ ξ ∈ DomC B.h (qsOf l0), k ξ = f ξ) → InM B (qsOf l0) γ k := by
    intro γ f k hf hk
    exact hCA γ γ γ 1 0 f f k hf hf le_rfl le_rfl (fun ξ hξ => by rw [hk ξ hξ]; ring)
  have hord_eq : ∀ (γ γ' : ℝ) (f : Cyl → ℝ), γ = γ' → InM B (qsOf l0) γ f → InM B (qsOf l0) γ' f := by
    intro γ γ' f h hf
    rw [← h]
    exact hf
  have hNBeq : ∀ (f1 f2 : Cyl → ℝ) (k : ℕ), ∀ ξ ∈ DomC B.h (qsOf l0),
      (∀ η ∈ DomC B.h (qsOf l0), f1 η = f2 η) → NB B.h f1 k ξ = NB B.h f2 k ξ := by
    intro f1 f2 k ξ hξ heq
    have hev : f1 =ᶠ[nhds ξ] f2 := Filter.eventuallyEq_of_mem (hDopen.mem_nhds hξ) heq
    unfold NB
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]

  obtain ⟨G, hGdef⟩ : ∃ G : Cyl → ℝ, G = fun η => η.1 ^ (1:ℝ) * g η := ⟨_, rfl⟩
  have hTp : ∀ ξ : Cyl, Tprim B 1 g ξ = ξ.1 ^ (-1:ℝ) * Icut B G ξ := by
    intro ξ
    rw [hGdef]
    simp only [Tprim, Nat.cast_one]

  have hF1 : ∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → radMom G 0 z t = 0 := by
    intro z t ht hq
    unfold radMom
    apply MeasureTheory.setIntegral_eq_zero_of_forall_eq_zero
    intro r hr
    have hr0 : (0:ℝ) < r := hr
    have hmem : ((r, z, t, (0 : ℝ × ℝ)) : Cyl) ∈ DomC B.h (qsOf l0) := by
      show 0 < r ∧ t < 1 ∧ qC B.h (r, z, t, (0 : ℝ × ℝ)) < qsOf l0
      exact ⟨hr0, ht, hq⟩
    have h1 : yAvg G (r, z, t, (0 : ℝ × ℝ)) = r ^ (1:ℝ) * yAvg g (r, z, t, (0 : ℝ × ℝ)) := by
      rw [hGdef]
      unfold yAvg
      simp only [MeasureTheory.integral_const_mul]
    rw [h1, hY _ hmem]
    simp

  have hF2 : ∀ ξ ∈ DomC B.h (qsOf l0), Icut B (momDgt B G) ξ = Icut B G ξ := by
    intro ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hz : radMom G 0 ξ.2.1 ξ.2.2.1 = 0 := hF1 _ _ hξ'.2.1 hξ'.2.2
    have he : ∀ r', momDgt B G (pathPt B.h ξ r') = G (pathPt B.h ξ r') := by
      intro r'
      simp only [momDgt, pathPt, hz, mul_zero, sub_zero]
    unfold Icut
    simp only [he]

  obtain ⟨α', hα'⟩ : ∃ α' : ℝ, α' = α + ((Aex B.h + 1/2) + 1/2) / B.h := ⟨_, rfl⟩
  have hA1 := inM_qpow_rpow_mul_v5 B (qsOf l0) hok hSN hqs0 hqs1 (Aex B.h + 1/2) 1 α (nrm B (Aex B.h) g) hg
  have hG' : InM B (qsOf l0) α' (nrm B (2 * Aex B.h + 1/2) G) := by
    apply hcong α' _ _ (hord_eq _ _ _ hα'.symm hA1)
    intro ξ hξ
    have hq := hqpos ξ hξ
    have e : qC B.h ξ ^ (2 * Aex B.h + 1/2) = qC B.h ξ ^ (Aex B.h + 1/2) * qC B.h ξ ^ (Aex B.h) := by
      rw [← Real.rpow_add hq]
      congr 1
      ring
    simp only [nrm, hGdef]
    rw [e]
    ring
  have hI := hic l0 (by omega) G α' hG'
  have hA2 := inM_qpow_rpow_mul_v5 B (qsOf l0) hok hSN hqs0 hqs1 (-(Aex B.h + 1/2)) (-1) α' _ hI
  have hord : α' + (-(Aex B.h + 1/2) + (-1:ℝ) / 2) / B.h = α := by
    have e : ((Aex B.h + 1/2) + 1/2) / B.h + (-(Aex B.h + 1/2) + (-1:ℝ) / 2) / B.h = 0 := by
      rw [← add_div]
      have e2 : (Aex B.h + 1/2) + 1/2 + (-(Aex B.h + 1/2) + (-1:ℝ) / 2) = 0 := by ring
      rw [e2, zero_div]
    rw [hα']
    linarith
  have hs1 := tprim_shInd_eq_v5 B (qsOf l0) g hok hqs0 hqs1 hgs hsh
  have hT1 : InM B (qsOf l0) α (nrm B (Aex B.h - 1/2) (shInd B (Tprim B 1 g))) := by
    apply hcong α _ _ (hord_eq _ _ _ hord hA2)
    intro ξ hξ
    have hq := hqpos ξ hξ
    have e : qC B.h ξ ^ (Aex B.h - 1/2) = qC B.h ξ ^ (-(Aex B.h + 1/2)) * qC B.h ξ ^ (2 * Aex B.h) := by
      rw [← Real.rpow_add hq]
      congr 1
      ring
    simp only [nrm]
    rw [hs1 ξ hξ, hTp ξ, hF2 ξ hξ, e]
    ring

  have hT4 := tprim_identity_v5 B (qsOf l0) g hok hqs0 hqs1 hgs hsh

  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : ℝ × ℝ × (ℝ × ℝ) → ℝ, Φ = fun ζ : ℝ × ℝ × (ℝ × ℝ) =>
      (∫ r in Set.Ioi (0:ℝ), G (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv)) - radMom G 0 ζ.1 ζ.2.1 :=
    ⟨_, rfl⟩
  have hpath : ∀ (ξ : Cyl) (r : ℝ), pathPt B.h ξ r =
      (r, ξ.2.1, ξ.2.2.1, (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv) := by
    intro ξ r
    have e : ξ.2.2.2 + (r ^ drx B.h - ξ.1 ^ drx B.h) • vrv =
        (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv := by
      rw [sub_smul]
      abel
    simp only [pathPt, e]
  have hint : ∀ ξ : Cyl, (∫ r' in Set.Ioi (0:ℝ), r' ^ (1:ℝ) * g (pathPt B.h ξ r')) =
      ∫ r in Set.Ioi (0:ℝ), G (r, ξ.2.1, ξ.2.2.1, (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv) := by
    intro ξ
    congr 1
    funext r
    rw [hpath ξ r, hGdef]
  have hAR : ∀ ξ ∈ DomC B.h (qsOf l0), nrm B (Aex B.h) (Arem B 1 g) ξ =
      qC B.h ξ ^ (Aex B.h - 1) * deriv (chiM B) (XC B.h ξ) *
        Φ (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) := by
    intro ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hq := hqpos ξ hξ
    have hr0 : ξ.1 ≠ 0 := hξ'.1.ne'
    have hq0 : qC B.h ξ ≠ 0 := hq.ne'
    have hz : radMom G 0 ξ.2.1 ξ.2.2.1 = 0 := hF1 _ _ hξ'.2.1 hξ'.2.2
    have hPhi : Φ (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) =
        ∫ r in Set.Ioi (0:ℝ), G (r, ξ.2.1, ξ.2.2.1, (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv) := by
      simp only [hΦdef, hz, sub_zero]
    have hd := dR_chiM_XC_v5 B ξ hok hξ'.1 hξ'.2.1
    simp only [nrm, Arem, Nat.cast_one]
    rw [hd, hint ξ, ← hPhi, Real.rpow_sub_one hq0, Real.rpow_neg_one]
    first
      | (field_simp; ring)
      | field_simp

  have hchi0 : ∀ X : ℝ, ¬ (B.m1 ≤ X ∧ X ≤ B.m2) → deriv (chiM B) X = 0 := by
    intro X hX
    have hd : 0 < B.m2 - B.m1 := by linarith
    rcases not_and_or.mp hX with h | h
    · push_neg at h
      have hev : chiM B =ᶠ[nhds X] fun _ => (0:ℝ) := by
        filter_upwards [Iio_mem_nhds h] with Y hY
        have hY' : Y < B.m1 := hY
        unfold chiM
        apply Real.smoothTransition.zero_of_nonpos
        exact div_nonpos_iff.mpr (Or.inr ⟨by linarith, by linarith⟩)
      rw [hev.deriv_eq, deriv_const]
    · push_neg at h
      have hev : chiM B =ᶠ[nhds X] fun _ => (1:ℝ) := by
        filter_upwards [Ioi_mem_nhds h] with Y hY
        have hY' : B.m2 < Y := hY
        unfold chiM
        apply Real.smoothTransition.one_of_one_le
        rw [le_div_iff₀ hd]
        linarith
      rw [hev.deriv_eq, deriv_const]

  have hT6 : ∀ ξ ∈ DomC B.h (qsOf l0), (B.m1 ≤ XC B.h ξ ∧ XC B.h ξ ≤ B.m2) ∨ Arem B 1 g ξ = 0 := by
    intro ξ hξ
    by_cases hw : B.m1 ≤ XC B.h ξ ∧ XC B.h ξ ≤ B.m2
    · exact Or.inl hw
    · right
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      have h0 : deriv (chiM B) (XC B.h ξ) = 0 := hchi0 _ hw
      simp only [Arem]
      rw [dR_chiM_XC_v5 B ξ hok hξ'.1 hξ'.2.1, h0]
      simp

  have hs6 := path_functional_flat_v5 B l0 G α' hok (by omega) hG'
  have hΦs : ContDiffOn ℝ ∞ Φ {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qsOf l0} := by
    rw [hΦdef]
    exact hs6.1
  have hΦb : ∀ k N : ℕ, ∃ C : ℝ, ∀ ζ : ℝ × ℝ × (ℝ × ℝ), ζ.2.1 < 1 → simScale B.h ζ.1 (1 - ζ.2.1) < qsOf l0 →
      ‖iteratedFDeriv ℝ k Φ ζ‖ ≤ C * simScale B.h ζ.1 (1 - ζ.2.1) ^ (N : ℝ) := by
    rw [hΦdef]
    exact hs6.2
  have hs7 := cyl_flat_comp_v5 B (qsOf l0) (Aex B.h - 1) Φ hok hqs0 hqs1 hΦs hΦb
  have hT5 : ∀ m N : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0),
      NB B.h (nrm B (Aex B.h) (Arem B 1 g)) m ξ ≤ C * qC B.h ξ ^ (N : ℝ) := by
    intro m N
    obtain ⟨C, hC⟩ := hs7.2 m N
    refine ⟨C, fun ξ hξ => ?_⟩
    rw [hNBeq (nrm B (Aex B.h) (Arem B 1 g)) _ m ξ hξ hAR]
    exact hC ξ hξ

  have hgdeck : ∀ η ∈ DomC B.h (qsOf l0), ∀ a, IsDeck B.h (qC B.h η) a → g (shY η a) = g η := by
    intro η hη a ha
    have h := hg.2.1 η hη a ha
    have hq := hqpos η hη
    have hqA : qC B.h η ^ Aex B.h ≠ 0 := (Real.rpow_pos_of_pos hq _).ne'
    simp only [nrm] at h
    exact mul_left_cancel₀ hqA h
  have hdeckA : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ a, IsDeck B.h (qC B.h ξ) a →
      nrm B (Aex B.h) (Arem B 1 g) (shY ξ a) = nrm B (Aex B.h) (Arem B 1 g) ξ := by
    intro ξ hξ a ha
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hd1 := dR_chiM_XC_v5 B (shY ξ a) hok hξ'.1 hξ'.2.1
    have hd2 := dR_chiM_XC_v5 B ξ hok hξ'.1 hξ'.2.1
    have hIeq : (∫ r' in Set.Ioi (0:ℝ), r' ^ (1:ℝ) * g (pathPt B.h (shY ξ a) r')) =
        ∫ r' in Set.Ioi (0:ℝ), r' ^ (1:ℝ) * g (pathPt B.h ξ r') := by
      apply MeasureTheory.setIntegral_congr_fun measurableSet_Ioi
      intro r' hr'
      have hr0 : (0:ℝ) < r' := hr'
      have hmem : pathPt B.h ξ r' ∈ DomC B.h (qsOf l0) := by
        show 0 < r' ∧ ξ.2.2.1 < 1 ∧ qC B.h (pathPt B.h ξ r') < qsOf l0
        exact ⟨hr0, hξ'.2.1, hξ'.2.2⟩
      have e : pathPt B.h (shY ξ a) r' = shY (pathPt B.h ξ r') a := by
        simp only [pathPt, shY]
        rw [add_right_comm]
      show r' ^ (1:ℝ) * g (pathPt B.h (shY ξ a) r') = r' ^ (1:ℝ) * g (pathPt B.h ξ r')
      rw [e, hgdeck _ hmem a ha]
    simp only [nrm, Arem, Nat.cast_one]
    rw [hd1, hd2, hIeq]
    rfl
  have hwin : ∀ ξ ∈ DomC B.h (qsOf l0),
      (B.m1 ≤ XC B.h ξ ∧ XC B.h ξ ≤ B.m2) ∨ nrm B (Aex B.h) (Arem B 1 g) ξ = 0 := by
    intro ξ hξ
    rcases hT6 ξ hξ with h | h
    · exact Or.inl h
    · right
      simp only [nrm, h, mul_zero]
  have hAremInM : ∀ β : ℝ, InM B (qsOf l0) β (nrm B (Aex B.h) (Arem B 1 g)) := by
    intro β
    exact inM_of_flat_window_v5 B (qsOf l0) (nrm B (Aex B.h) (Arem B 1 g)) hok hqs0 hqs1
      (hs7.1.congr hAR) hdeckA hwin hT5 β

  have hT2 : InM B (qsOf l0) α (nrm B (Aex B.h)
      (fun ξ => dR B.h (shInd B (Tprim B 1 g)) ξ + shInd B (Tprim B 1 g) ξ / ξ.1)) := by
    apply hCA α α α 1 (-1) _ _ _ hg (hAremInM α) le_rfl le_rfl
    intro ξ hξ
    simp only [nrm]
    rw [hT4 ξ hξ]
    ring

  have hT3 := hdz l0 (by omega) (shInd B (Tprim B 1 g)) α hT1

  have hs11 := arem_mean_zero_v5 B l0 g α hok (by omega) hg hsh hY
  have hT7 : ∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 →
      radMom (fun ξ => dR B.h (shInd B (Tprim B 1 g)) ξ + shInd B (Tprim B 1 g) ξ / ξ.1) 1 z t = 0 := by
    intro z t ht hq
    unfold radMom
    apply MeasureTheory.setIntegral_eq_zero_of_forall_eq_zero
    intro r hr
    have hr0 : (0:ℝ) < r := hr
    have hmem : ((r, z, t, (0 : ℝ × ℝ)) : Cyl) ∈ DomC B.h (qsOf l0) := by
      show 0 < r ∧ t < 1 ∧ qC B.h (r, z, t, (0 : ℝ × ℝ)) < qsOf l0
      exact ⟨hr0, ht, hq⟩
    have hya : yAvg (fun ξ => dR B.h (shInd B (Tprim B 1 g)) ξ + shInd B (Tprim B 1 g) ξ / ξ.1)
        (r, z, t, (0 : ℝ × ℝ)) = yAvg (fun η => g η - Arem B 1 g η) (r, z, t, (0 : ℝ × ℝ)) := by
      unfold yAvg
      apply MeasureTheory.setIntegral_congr_fun (measurableSet_Icc.prod measurableSet_Icc)
      intro Y _
      have hm : ((r, z, t, Y) : Cyl) ∈ DomC B.h (qsOf l0) := by
        show 0 < r ∧ t < 1 ∧ qC B.h (r, z, t, Y) < qsOf l0
        exact ⟨hr0, ht, hq⟩
      exact hT4 _ hm
    rw [hya, hs11 _ hmem]
    simp
  exact ⟨hT1, hT2, hT3, hT4, hT5, hT6, hT7⟩

theorem mmu_axoff_smooth_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (α β t : ℝ) (Y0 : ℝ × ℝ), B.ok → GeomPrim5 B G → qsOf l0 ≤ B.qB → InWg5 B G (qsOf l0) α S.Aw → InM B (qsOf l0) β S.Psi → IsOpen {y : ℝ³ | 0 < rad y ∧ t < 1 ∧ simScale B.h (y 2) (1 - t) < qsOf l0} ∧ ContDiffOn ℝ ∞ (fun y : ℝ³ => AX5 B G l0 S y t (Yph B.h (rad y) t + Y0)) {y : ℝ³ | 0 < rad y ∧ t < 1 ∧ simScale B.h (y 2) (1 - t) < qsOf l0} :=
by

  have geom_slow : ∀ B : BG, B.ok →
      IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} ∧
      ∀ (l : ℕ) (i : Fin 3), ContDiffOn ℝ ∞ (fun s : ℝ × ℝ × ℝ => baseC B l (s.1, s.2.1, s.2.2, ((0:ℝ), (0:ℝ))) i)
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
    intro B hB
    obtain ⟨hS, hBP⟩ := hB
    have hsc : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hS.2.2.2.1.continuousOn
    have hA : IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
      have hm : Continuous (fun s : ℝ × ℝ × ℝ => (s.2.1, 1 - s.2.2)) := by fun_prop
      have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun s : ℝ × ℝ × ℝ => (s.2.1, 1 - s.2.2)))
          {s : ℝ × ℝ × ℝ | s.2.2 < 1} := by
        refine hsc.comp hm.continuousOn ?_
        intro s hs
        have hs' : s.2.2 < 1 := hs
        exact ⟨mem_univ _, show (0:ℝ) < 1 - s.2.2 by linarith⟩
      have hU : IsOpen {s : ℝ × ℝ × ℝ | s.2.2 < 1} := isOpen_lt (by fun_prop) continuous_const
      have h1 := hc.isOpen_inter_preimage hU (isOpen_Iio (a := B.qB))
      have h2 : IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1} := isOpen_lt continuous_const continuous_fst
      have e : {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} =
          {s : ℝ × ℝ × ℝ | 0 < s.1} ∩ ({s : ℝ × ℝ × ℝ | s.2.2 < 1} ∩
            ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun s : ℝ × ℝ × ℝ => (s.2.1, 1 - s.2.2))) ⁻¹'
              Iio B.qB) := by
        ext s
        simp only [mem_setOf_eq, mem_inter_iff, mem_preimage, mem_Iio, Function.comp]
      rw [e]
      exact h2.inter h1
    have hD : IsOpen (simDomain B.h B.qB) := by
      have hm : Continuous (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)) := by fun_prop
      have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)))
          {w : ℝ³ × ℝ | w.2 < 1} := by
        refine hsc.comp hm.continuousOn ?_
        intro w hw
        have hw' : w.2 < 1 := hw
        exact ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by linarith⟩
      have hU : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
      have h1 := hc.isOpen_inter_preimage hU (isOpen_Iio (a := B.qB))
      have e : simDomain B.h B.qB = {w : ℝ³ × ℝ | w.2 < 1} ∩
          ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2))) ⁻¹' Iio B.qB := by
        ext w
        simp only [simDomain, mem_setOf_eq, mem_inter_iff, mem_preimage, mem_Iio, Function.comp]
      rw [e]
      exact h1
    have hu : ContDiffOn ℝ ∞ (↿(uB B)) (simDomain B.h B.qB) := by
      have hAB : ContDiffOn ℝ ∞ (↿B.AB) (simDomain B.h B.qB) := hBP.2.2.2.1.1
      have hBv : ContDiffOn ℝ ∞ (↿B.BvB) (simDomain B.h B.qB) := hBP.2.2.2.1.2.1
      have hDA : ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z) (simDomain B.h B.qB) :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hAB).2
      have hc : ∀ (v : ℝ³) (j : Fin 3),
          ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z (v, (0:ℝ)) j) (simDomain B.h B.qB) := by
        intro v j
        have h1 : ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z (v, (0:ℝ))) (simDomain B.h B.qB) :=
          hDA.clm_apply contDiffOn_const
        exact (EuclideanSpace.proj j : ℝ³ →L[ℝ] ℝ).contDiff.comp_contDiffOn h1
      let e0 : ℝ³ := EuclideanSpace.single 0 1
      let e1 : ℝ³ := EuclideanSpace.single 1 1
      let e2 : ℝ³ := EuclideanSpace.single 2 1
      have hg : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ =>
          (fderiv ℝ (↿B.AB) z (e1, (0:ℝ)) 2 - fderiv ℝ (↿B.AB) z (e2, (0:ℝ)) 1) •
              EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
          (fderiv ℝ (↿B.AB) z (e2, (0:ℝ)) 0 - fderiv ℝ (↿B.AB) z (e0, (0:ℝ)) 2) •
              EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
          (fderiv ℝ (↿B.AB) z (e0, (0:ℝ)) 1 - fderiv ℝ (↿B.AB) z (e1, (0:ℝ)) 0) •
              EuclideanSpace.single (2 : Fin 3) (1 : ℝ) + (↿B.BvB) z) (simDomain B.h B.qB) := by
        refine ((((hc e1 2).sub (hc e2 1)).smul contDiffOn_const).add
          (((hc e2 0).sub (hc e0 2)).smul contDiffOn_const)).add
          (((hc e0 1).sub (hc e1 0)).smul contDiffOn_const) |>.add hBv
      refine hg.congr ?_
      rintro ⟨y, s⟩ hz
      have hdiff : DifferentiableAt ℝ (↿B.AB) (y, s) :=
