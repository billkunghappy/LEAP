theorem tail_collar_admblk : ∀ h : ℝ, ∃ ρ0 ε0 X0 : ℝ, 0 < ρ0 ∧ 0 < ε0 ∧ 0 < X0 ∧ ∀ (cinf ρ Xb : ℝ) (F U : ℝ → ℝ → ℝ), 0 < ρ → ρ ≤ ρ0 → X0 ≤ Xb → TailForm h cinf ρ Xb F U → (∀ X η : ℝ, Xb * Real.exp (-(11 / 4)) ≤ X → X < Xb → -1 < η → η < 1 → Real.sqrt (2 * X) * F X η ≤ ε0) → AdmBlk h (fun X => Real.exp (-(4 / Real.log (Xb / X) ^ 2))) (fun X => min 1 (Real.log (Xb / X))) (Ico (Xb * Real.exp (-(5 / 2))) Xb) F U ∧ ∀ m : ℕ, ∃ C N : ℝ, ∀ X η : ℝ, Xb * Real.exp (-(5 / 2)) ≤ X → X < Xb → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ => Real.sqrt (2 * w.1) * F w.1 w.2 - cinf * w.1 ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - w.2 ^ 2) / w.1)) (X, η)‖ ≤ C * Real.exp (-(4 / Real.log (Xb / X) ^ 2)) * (min 1 (Real.log (Xb / X))) ^ (-N) :=
by
  intro h
  refine ⟨if 0 < h then h / 800 else 1, 1 / 16, 400, ?_, by norm_num, by norm_num, ?_⟩
  · split_ifs with hh
