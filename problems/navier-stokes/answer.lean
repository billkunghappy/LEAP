theorem rfp_nmargin_of_strict : ∀ (h x1 x2 : ℝ) (F U : ℝ → ℝ → ℝ) (adm : Prop), 0 < x1 → x1 ≤ x2 → ContinuousOn (fun z : ℝ × ℝ => F z.1 z.2) (Icc x1 x2 ×ˢ Icc (-1) 1) → ContinuousOn (fun z : ℝ × ℝ => shearA F z.1 z.2) (Icc x1 x2 ×ˢ Icc (-1) 1) → ContinuousOn (fun z : ℝ × ℝ => shearB F U z.1 z.2) (Icc x1 x2 ×ˢ Icc (-1) 1) → ContinuousOn (fun z : ℝ × ℝ => psLead1 h F U z.1 z.2) (Icc x1 x2 ×ˢ Icc (-1) 1) → ContinuousOn (fun z : ℝ × ℝ => psLead2 h F U z.1 z.2) (Icc x1 x2 ×ˢ Icc (-1) 1) → (∀ x η : ℝ, x1 ≤ x → x ≤ x2 → -1 ≤ η → η ≤ 1 → RfpStrict adm h F U x η) → ∃ μ0 : ℝ, 0 < μ0 ∧ μ0 ≤ 1 ∧ ∀ μ : ℝ, 0 < μ → μ ≤ μ0 → NMargin h μ (Icc x1 x2) F U adm :=
by
  intro h x1 x2 F U adm hx1 hx12 hFc hAc hBc hP1c hP2c hstr
  have hK : IsCompact (Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1) := isCompact_Icc.prod isCompact_Icc
  have hne : (Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1).Nonempty :=
    (Set.nonempty_Icc.2 hx12).prod (Set.nonempty_Icc.2 (by norm_num))
  have hS : ∀ z ∈ Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1, RfpStrict adm h F U z.1 z.2 :=
    fun z hz => hstr z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2
  have hmin : ∀ g : ℝ × ℝ → ℝ, ContinuousOn g (Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1) →
      (∀ z ∈ Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1, 0 < g z) →
      ∃ m : ℝ, 0 < m ∧ ∀ z ∈ Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1, m ≤ g z := by
    intro g hg hpos
    obtain ⟨z0, hz0, hmn⟩ := hK.exists_isMinOn hne hg
    exact ⟨g z0, hpos z0 hz0, fun z hz => isMinOn_iff.1 hmn z hz⟩
  have hAne : ∀ z ∈ Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1, shearA F z.1 z.2 ≠ 0 :=
    fun z hz => ne_of_gt (hS z hz).2.1
  have hP1ne : ∀ z ∈ Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1, psLead1 h F U z.1 z.2 ≠ 0 :=
    fun z hz => ne_of_gt (hS z hz).2.2.1
  have hq : ContinuousOn (fun z : ℝ × ℝ => psLead2 h F U z.1 z.2 / psLead1 h F U z.1 z.2)
      (Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1) := hP2c.div hP1c hP1ne
  have hba : ContinuousOn (fun z : ℝ × ℝ => shearB F U z.1 z.2 / shearA F z.1 z.2)
      (Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1) := hBc.div hAc hAne
  have hb2a : ContinuousOn (fun z : ℝ × ℝ => shearB F U z.1 z.2 ^ 2 / shearA F z.1 z.2)
      (Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1) := (hBc.pow 2).div hAc hAne
  have hg1 : ContinuousOn (fun z : ℝ × ℝ => shearA F z.1 z.2 - shearB F U z.1 z.2 *
      (psLead2 h F U z.1 z.2 / psLead1 h F U z.1 z.2)) (Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1) :=
    hAc.sub (hBc.mul hq)
  have hg2 : ContinuousOn (fun z : ℝ × ℝ => 2 - 2 * shearB F U z.1 z.2 *
      (psLead2 h F U z.1 z.2 / psLead1 h F U z.1 z.2) - shearB F U z.1 z.2 ^ 2 / shearA F z.1 z.2
      - (shearA F z.1 z.2 - 2) * (psLead2 h F U z.1 z.2 / psLead1 h F U z.1 z.2) ^ 2)
      (Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1) :=
    ((continuousOn_const.sub ((continuousOn_const.mul hBc).mul hq)).sub hb2a).sub
      ((hAc.sub continuousOn_const).mul (hq.pow 2))
  have hg3 : ContinuousOn (fun z : ℝ × ℝ => shearA F z.1 z.2 *
      (1 + (shearB F U z.1 z.2 / shearA F z.1 z.2) ^ 2) - 2) (Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1) :=
    (hAc.mul (continuousOn_const.add (hba.pow 2))).sub continuousOn_const
  obtain ⟨mF, hmF, hmFb⟩ := hmin _ hFc (fun z hz => (hS z hz).1)
  obtain ⟨ma, hma, hmab⟩ := hmin _ hAc (fun z hz => (hS z hz).2.1)
  obtain ⟨mP, hmP, hmPb⟩ := hmin _ hP1c (fun z hz => (hS z hz).2.2.1)
  obtain ⟨m1, hm1, hm1b⟩ := hmin _ hg1 (fun z hz => (hS z hz).2.2.2.1)
  obtain ⟨m2, hm2, hm2b⟩ := hmin _ hg2 (fun z hz => (hS z hz).2.2.2.2.1)
  obtain ⟨m3, hm3, hm3b⟩ : ∃ m3 : ℝ, 0 < m3 ∧ (adm → ∀ z ∈ Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1,
      m3 ≤ shearA F z.1 z.2 * (1 + (shearB F U z.1 z.2 / shearA F z.1 z.2) ^ 2) - 2) := by
    by_cases hadm : adm
    · obtain ⟨m, hm, hmb⟩ := hmin _ hg3 (fun z hz => by
        have := (hS z hz).2.2.2.2.2 hadm
        show 0 < shearA F z.1 z.2 * (1 + (shearB F U z.1 z.2 / shearA F z.1 z.2) ^ 2) - 2
        linarith)
      exact ⟨m, hm, fun _ => hmb⟩
    · exact ⟨1, one_pos, fun h' => absurd h' hadm⟩
  obtain ⟨Ca, hCa⟩ := hK.exists_bound_of_continuousOn hAc
  obtain ⟨Cb, hCb⟩ := hK.exists_bound_of_continuousOn hBc
  obtain ⟨Cp, hCp⟩ := hK.exists_bound_of_continuousOn hP2c
  obtain ⟨M, hM⟩ : ∃ M : ℝ, M = max 1 (max Ca (max Cb Cp)) := ⟨_, rfl⟩
  have hM1 : 1 ≤ M := by rw [hM]; exact le_max_left _ _
  have hM0 : 0 < M := by linarith
  have hMa : Ca ≤ M := by rw [hM]; exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hMb : Cb ≤ M := by
    rw [hM]; exact le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) (le_max_right _ _)
  have hMp : Cp ≤ M := by
    rw [hM]; exact le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) (le_max_right _ _)
  have hiM : 0 < 1 / M := by positivity
  have hPM : 0 < mP / M := by positivity
  refine ⟨min 1 (min mF (min ma (min (1 / M) (min mP (min (mP / M) (min m1 (min m2 m3))))))),
    ?_, min_le_left _ _, ?_⟩
  · simp only [lt_min_iff]
    exact ⟨one_pos, hmF, hma, hiM, hmP, hPM, hm1, hm2, hm3⟩
  · intro μ hμ hμle x hx η h1 h2
    simp only [le_min_iff] at hμle
    obtain ⟨-, hμF, hμa, hμM, hμP, hμPM, hμ1, hμ2, hμ3⟩ := hμle
    have hz : ((x, η) : ℝ × ℝ) ∈ Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1 := ⟨hx, h1.le, h2.le⟩
    have hp1 : mP ≤ psLead1 h F U x η := hmPb _ hz
    have hMμ : M ≤ 1 / μ := by
      rw [le_div_iff₀ hμ]
      rw [le_div_iff₀ hM0] at hμM
      linarith [mul_comm M μ]
    have hMμP : M ≤ psLead1 h F U x η / μ := by
      rw [le_div_iff₀ hμ]
      rw [le_div_iff₀ hM0] at hμPM
      linarith [mul_comm M μ]
    have ha : ‖shearA F x η‖ ≤ Ca := hCa _ hz
    have hb : ‖shearB F U x η‖ ≤ Cb := hCb _ hz
    have hp : ‖psLead2 h F U x η‖ ≤ Cp := hCp _ hz
    rw [Real.norm_eq_abs] at ha hb hp
    refine ⟨le_trans hμF (hmFb _ hz), le_trans hμa (hmab _ hz), ?_, ?_, le_trans hμP hp1, ?_,
      le_trans hμ1 (hm1b _ hz), le_trans hμ2 (hm2b _ hz),
      fun hadm => le_trans hμ3 (hm3b hadm _ hz)⟩
    · linarith [le_abs_self (shearA F x η)]
    · linarith
    · linarith

theorem rfp_inner_form : ∀ P : RfpPar, RfpRegime P → ∀ x η : ℝ, 0 < x → x < Real.exp (rfpY2 P.Md + 3) → rfpU P x η = η * rfpK P.Md (Real.log x) ∧ rfpF P x η = rinC P.Md P.Pst P.lam (Real.log x) * (1 + η ^ 2)⁻¹ / Real.sqrt (2 * x) ∧ Real.exp (rfpLam P (Real.log x)) = rinC P.Md P.Pst P.lam (Real.log x) :=
by
  intro P hReg x η hx0 hx1
  obtain ⟨hMd, hPst, hl0, hl100, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hReg
  have hs0 : ∀ t : ℝ, t ≤ 0 → sigA t = 0 := fun t ht => by
    unfold sigA; rw [if_pos ht]
  have hbm : ∀ t : ℝ, t ≤ -(3 / 20) → rfpBmp t = 0 := by
    intro t ht
    have e : t / (3 / 20) = 20 * t / 3 := by ring
    unfold rfpBmp
    rw [hs0 (1 + t / (3 / 20)) (by rw [e]; linarith), zero_mul]
  have hR0n : ∀ ξ : ℝ, ξ ≤ 0 → rfpR0 ξ = 0 := by
    intro ξ hξ
    unfold rfpR0
    have hI : (∫ v in (0:ℝ)..ξ, sigA (50 * v)) = ∫ v in (0:ℝ)..ξ, (0:ℝ) := by
      apply intervalIntegral.integral_congr
      intro v hv
      rw [Set.uIcc_of_ge hξ] at hv
      exact hs0 (50 * v) (by linarith [hv.2])
    rw [hI, intervalIntegral.integral_zero, zero_mul]
  have hSI0 : ∀ t : ℝ, t ≤ 0 → rfpSigI t = 0 := by
    intro t ht
    unfold rfpSigI
    have hI : (∫ s in (0:ℝ)..t, sigA s) = ∫ s in (0:ℝ)..t, (0:ℝ) := by
      apply intervalIntegral.integral_congr
      intro s hs
      rw [Set.uIcc_of_ge ht] at hs
      exact hs0 s hs.2
    rw [hI, intervalIntegral.integral_zero]
  have h2 : (2:ℝ) ≤ 1 / P.lam := by rw [le_div_iff₀ hl0]; linarith
  have hL : (1:ℝ) / 2 < Real.log (1 / P.lam) := by
    have := Real.log_le_log (by norm_num) h2
    linarith [Real.log_two_gt_d9]
  have h13 : (1300:ℝ) ≤ 13 / P.lam := by rw [le_div_iff₀ hl0]; linarith
  have hh1 : P.h < 1 := by nlinarith [mul_le_mul_of_nonneg_left hl100 hl0.le]
  have hLh1 : 0 ≤ Real.log (1 / P.h) :=
    Real.log_nonneg (by rw [le_div_iff₀ hh0]; linarith)
  have hρ1 : P.ρ < 1 := by linarith
  have hPst0 : 0 < P.Pst := lt_trans (Real.exp_pos _) hPst
  have hy : Real.log x < rfpY2 P.Md + 3 := (Real.log_lt_iff_lt_exp hx0).2 hx1
  have hY3 : rfpY3 P.Md P.lam = rfpY2 P.Md + 1 + 60 * Real.log (1 / P.lam) := rfl
  have hY4 : rfpY4 P.Md P.lam = rfpY3 P.Md P.lam + 13 / P.lam := rfl
  have hY5 : rfpY5 P.Md P.lam = rfpY4 P.Md P.lam + 60 + 30 * Real.log (1 / P.lam) := rfl
  have hYb : rfpYb P.Md P.lam P.T1 P.Lh = rfpY5 P.Md P.lam + 2 + P.T1 + P.Lh + 3 := rfl
  set y := Real.log x with hydef
  have hRb : rfpRb P y η = 0 := by
    unfold rfpRb
    have hn : P.lam * (y - rfpY3 P.Md P.lam) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos hl0.le (by linarith)
    rw [hR0n _ hn, hbm (y - rfpY4 P.Md P.lam + 3) (by linarith),
      hbm (y - rfpY4 P.Md P.lam + 1) (by linarith)]
    ring
  have hU : rfpU P x η = η * rfpK P.Md y := by
    unfold rfpU
    rw [← hydef, hRb, mul_zero, add_zero]
  have hTail : tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) = 1 - P.ρ := by
    have hlog : Real.log (Real.exp y / Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) =
        y - rfpYb P.Md P.lam P.T1 P.Lh := by
      rw [← Real.exp_sub, Real.log_exp]
    unfold tailFac
    rw [hlog, hs0 _ (by linarith)]
    ring
  have hLam : rfpLam P y = Real.log P.Pst +
      (y / 10 - 3 / 5 * rfpSigI y - P.lam * rfpSigI (y - rfpY2 P.Md)) := by
    unfold rfpLam
    rw [hTail, div_self (by linarith : (1:ℝ) - P.ρ ≠ 0), Real.log_one,
      hSI0 (y - rfpY5 P.Md P.lam) (by linarith),
      hSI0 (y - rfpY5 P.Md P.lam - 1 - P.T1) (by linarith),
      hs0 ((y - rfpY4 P.Md P.lam) / 60)
        (by rw [div_le_iff₀ (by norm_num : (0:ℝ) < 60)]; linarith)]
    ring
  have hEl : Real.exp (rfpLam P y) = rinC P.Md P.Pst P.lam y := by
    rw [hLam, Real.exp_add, Real.exp_log hPst0]
    rfl
  have hF : rfpF P x η = rinC P.Md P.Pst P.lam y * (1 + η ^ 2)⁻¹ / Real.sqrt (2 * x) := by
    have hTh1 : rfpTh P y = 1 := by
      unfold rfpTh
      rw [hs0 ((y - rfpY4 P.Md P.lam) / 60)
        (by rw [div_le_iff₀ (by norm_num : (0:ℝ) < 60)]; linarith), sub_zero]
    have hPsi : rfpPsi P y = 0 := by
      unfold rfpPsi
      rw [hbm (y - rfpY5 P.Md P.lam + 3) (by linarith),
        hbm (y - rfpY5 P.Md P.lam + 1) (by linarith), mul_zero, sub_zero]
    unfold rfpF rfpE
    rw [← hydef, hTh1, hPsi, mul_zero, add_zero, Real.sqrt_one, mul_one, Real.rpow_one, hEl]
  exact ⟨hU, hF, hEl⟩

theorem rfp_lead_explicit : ∀ (h X1 : ℝ) (c k : ℝ → ℝ) (F U : ℝ → ℝ → ℝ), 0 < X1 → Differentiable ℝ c → Differentiable ℝ k → (∀ y, 0 < c y) → (∃ M : ℝ, ∀ y, y ≤ Real.log X1 → |c y| ≤ M ∧ |k y| ≤ M) → (∀ x η : ℝ, 0 < x → x < X1 → U x η = η * k (Real.log x) ∧ F x η = c (Real.log x) * (1 + η ^ 2)⁻¹ / Real.sqrt (2 * x)) → ∀ X η : ℝ, 0 < X → X < X1 → shearA F X η = 1 - 2 * deriv c (Real.log X) / c (Real.log X) ∧ shearB F U X η = 2 * η * deriv k (Real.log X) * (1 + η ^ 2) / c (Real.log X) ∧ leadQs h F U X η = rinQf h c k X η ∧ leadNs h F U X η = η * rinNf h c k X η + 4 * (1 / 2 + h) * η * leadPi F X η - (1 - η ^ 2) * profEtaD (leadPi F) X η :=
by
  intro h X1 c k F U hX1 hc hk hpos hbd hform X η hX hXX1
  obtain ⟨M, hM⟩ := hbd

  have alg1 : ∀ x s A : ℝ, 0 < s → s * s = 2 * x → 2 * x * (A / s) = s * A := by
    intro x s A hs hss
    rw [← hss, mul_div_assoc', div_eq_iff hs.ne']
    ring
  have alg2 : ∀ x s A : ℝ, 0 < s → s * s = 2 * x → x * (A / s) ^ 2 = A ^ 2 / 2 := by
    intro x s A hs hss
    have hx : x = s * s / 2 := by linarith
    rw [hx]
    field_simp
  have h2X : 0 < 2 * X := by linarith
  have hsX : 0 < Real.sqrt (2 * X) := Real.sqrt_pos.2 h2X
  have hssX : Real.sqrt (2 * X) * Real.sqrt (2 * X) = 2 * X := Real.mul_self_sqrt h2X.le
  have hcX : 0 < c (Real.log X) := hpos _



  have hnhds : Ioo 0 X1 ∈ nhds X := Ioo_mem_nhds hX hXX1
  have hFe : (fun Y => F Y η) =ᶠ[nhds X]
      (fun Y => c (Real.log Y) * (1 + η ^ 2)⁻¹ / Real.sqrt (2 * Y)) :=
    Filter.eventuallyEq_of_mem hnhds (fun Y hY => (hform Y η hY.1 hY.2).2)
  have hUe : (fun Y => U Y η) =ᶠ[nhds X] (fun Y => η * k (Real.log Y)) :=
    Filter.eventuallyEq_of_mem hnhds (fun Y hY => (hform Y η hY.1 hY.2).1)
  have hlog : HasDerivAt Real.log X⁻¹ X := Real.hasDerivAt_log hX.ne'
  have hcl : HasDerivAt (fun Y => c (Real.log Y)) (deriv c (Real.log X) * X⁻¹) X :=
    (hc (Real.log X)).hasDerivAt.comp X hlog
  have hkl : HasDerivAt (fun Y => k (Real.log Y)) (deriv k (Real.log X) * X⁻¹) X :=
    (hk (Real.log X)).hasDerivAt.comp X hlog
  have hsq : HasDerivAt (fun Y => Real.sqrt (2 * Y)) (2 * 1 / (2 * Real.sqrt (2 * X))) X :=
    ((hasDerivAt_id' X).const_mul 2).sqrt h2X.ne'
  have hG := (hcl.mul_const ((1 + η ^ 2)⁻¹)).div hsq hsX.ne'
  have hV := hkl.const_mul η
  have hdF : deriv (fun Y => F Y η) X =
      (deriv c (Real.log X) * X⁻¹ * (1 + η ^ 2)⁻¹ * Real.sqrt (2 * X)
        - c (Real.log X) * (1 + η ^ 2)⁻¹ * (2 * 1 / (2 * Real.sqrt (2 * X)))) /
        Real.sqrt (2 * X) ^ 2 := by
    rw [hFe.deriv_eq]; exact hG.deriv
  have hdU : deriv (fun Y => U Y η) X = η * (deriv k (Real.log X) * X⁻¹) := by
    rw [hUe.deriv_eq]; exact hV.deriv
  have hFX := (hform X η hX hXX1).2
  have hUX := (hform X η hX hXX1).1
  have hpart1 : shearA F X η = 1 - 2 * deriv c (Real.log X) / c (Real.log X) := by
    unfold shearA
    rw [hdF, hFX]
    generalize Real.sqrt (2 * X) = s at *
    generalize c (Real.log X) = cy at *
    generalize deriv c (Real.log X) = dc at *
    have hX' : X = s * s / 2 := by linarith
    subst hX'
    have hf : (0:ℝ) < 1 + η ^ 2 := by positivity
    field_simp
    ring
  have hpart2 : shearB F U X η = 2 * η * deriv k (Real.log X) * (1 + η ^ 2) / c (Real.log X) := by
    unfold shearB
    rw [hdU, hFX]
    generalize Real.sqrt (2 * X) = s at *
    generalize c (Real.log X) = cy at *
    generalize deriv k (Real.log X) = dk at *
    have hX' : X = s * s / 2 := by linarith
    subst hX'
    have hf : (0:ℝ) < 1 + η ^ 2 := by positivity
    field_simp



  have hcongr : ∀ (g1 g2 : ℝ → ℝ), (∀ x, 0 < x → x < X1 → x ≤ X → g1 x = g2 x) →
      ∫ x in (0:ℝ)..X, g1 x = ∫ x in (0:ℝ)..X, g2 x := by
    intro g1 g2 H
    apply intervalIntegral.integral_congr_ae
    refine Filter.Eventually.of_forall (fun x hx => ?_)
    rw [uIoc_of_le hX.le] at hx
    exact H x hx.1 (lt_of_le_of_lt hx.2 hXX1) hx.2
  have hsx : ∀ x : ℝ, 0 < x → 0 < Real.sqrt (2 * x) := fun x hx => Real.sqrt_pos.2 (by linarith)
  have hssx : ∀ x : ℝ, 0 < x → Real.sqrt (2 * x) * Real.sqrt (2 * x) = 2 * x :=
    fun x hx => Real.mul_self_sqrt (by linarith)
  have hm1 : ∀ e : ℝ, profRadInt (fun x e => 2 * x * F x e) X e =
      (1 + e ^ 2)⁻¹ * rinMom (fun x => Real.sqrt (2 * x) * c (Real.log x)) X := by
    intro e
    unfold profRadInt rinMom
    rw [← intervalIntegral.integral_const_mul]
    apply hcongr
    intro x hx0 hx1 _
    beta_reduce
    rw [(hform x e hx0 hx1).2, alg1 x _ _ (hsx x hx0) (hssx x hx0)]
    ring
  have hm2 : ∀ e : ℝ, profRadInt (fun x e => U x e * (2 * x * F x e)) X e =
      e * (1 + e ^ 2)⁻¹ * rinMom (fun x => k (Real.log x) * (Real.sqrt (2 * x) * c (Real.log x))) X := by
    intro e
    unfold profRadInt rinMom
    rw [← intervalIntegral.integral_const_mul]
    apply hcongr
    intro x hx0 hx1 _
    beta_reduce
    rw [(hform x e hx0 hx1).2, (hform x e hx0 hx1).1, alg1 x _ _ (hsx x hx0) (hssx x hx0)]
    ring
  have hm3 : ∀ e : ℝ, profRadInt U X e = e * rinMom (fun x => k (Real.log x)) X := by
    intro e
    unfold profRadInt rinMom
    rw [← intervalIntegral.integral_const_mul]
    apply hcongr
    intro x hx0 hx1 _
    rw [(hform x e hx0 hx1).1]
  have hIk : IntervalIntegrable (fun x => k (Real.log x) ^ 2) volume 0 X := by
    rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hX.le]
    refine Measure.integrableOn_of_bounded (M := M ^ 2) measure_Ioc_lt_top.ne
      ((hk.continuous.measurable.comp Real.measurable_log).pow_const 2).aestronglyMeasurable ?_
    refine ae_restrict_of_forall_mem measurableSet_Ioc (fun x hx => ?_)
    have hl : Real.log x ≤ Real.log X1 := Real.log_le_log hx.1 (le_of_lt (lt_of_le_of_lt hx.2 hXX1))
    have h1 := pow_le_pow_left₀ (abs_nonneg _) (hM _ hl).2 2
    rw [sq_abs] at h1
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
