    intro u hu
    have hu0 : 0 < u := lt_of_lt_of_le ha0 hu
    have hlog : -2 ≤ Real.log u := (Real.le_log_iff_exp_le hu0).2 hu
    have hr0 : 0 ≤ u ^ (-h) := Real.rpow_nonneg hu0.le _
    have hs1 := hs ((Real.log u + 2) / 2)
    have hrle : u ^ (-h) ≤ 3 := by
      rw [Real.rpow_def_of_pos hu0]
      have hexp : Real.log u * (-h) ≤ 1 := by nlinarith
      calc Real.exp (Real.log u * (-h)) ≤ Real.exp 1 := Real.exp_le_exp.2 hexp
        _ ≤ 3 := Real.exp_one_lt_three.le
    refine ⟨mul_nonneg hr0 (by linarith [hs1.2]), ?_⟩
    calc u ^ (-h) * (1 - s ((Real.log u + 2) / 2)) ≤ u ^ (-h) * 1 :=
          mul_le_mul_of_nonneg_left (by linarith [hs1.1]) hr0
      _ ≤ 3 := by linarith
  refine ⟨intervalIntegral.integral_nonneg ha1 (fun u hu => (hpt u hu.1).1), ?_⟩
  have hn : ‖∫ u in Real.exp (-2)..1, u ^ (-h) * (1 - s ((Real.log u + 2) / 2))‖ ≤
      3 * |1 - Real.exp (-2)| := by
    apply intervalIntegral.norm_integral_le_of_norm_le_const
    intro u hu
    rw [Set.uIoc_of_le ha1] at hu
    have hp := hpt u hu.1.le
    rw [Real.norm_eq_abs, abs_of_nonneg hp.1]
    exact hp.2
  rw [Real.norm_eq_abs, abs_of_nonneg (by linarith : (0:ℝ) ≤ 1 - Real.exp (-2))] at hn
  have := le_abs_self (∫ u in Real.exp (-2)..1, u ^ (-h) * (1 - s ((Real.log u + 2) / 2)))
  linarith

