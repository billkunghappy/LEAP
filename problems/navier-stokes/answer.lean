      ← intervalIntegral.integral_add_adjacent_intervals hgr1 hgr2]
    have c1 : (∫ X in (0:ℝ)..(XR * Real.exp (-6)), g X) = ∫ X in (0:ℝ)..(XR * Real.exp (-6)), g0 X := by
      apply intervalIntegral.integral_congr
