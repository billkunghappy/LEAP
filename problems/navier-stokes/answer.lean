  obtain ⟨hL₀, hR₀s, hZ₀s, hT₀s⟩ := hsuppγ ξ₀ hη₀
  obtain ⟨hρ₀1, hρ₀2⟩ := hlev _ _ hq₀ hL₀
  obtain ⟨c1, hc1⟩ : ∃ c1 : ℝ, c1 = max (Xa + μ) (min (XC h ξ₀) (Xb - μ)) := ⟨_, rfl⟩
  obtain ⟨c2, hc2⟩ : ∃ c2 : ℝ, c2 = max (-(1 - μ)) (min (etaC h ξ₀) (1 - μ)) := ⟨_, rfl⟩
  have hc1a : Xa + μ ≤ c1 := by rw [hc1]; exact le_max_left _ _
  have hc1b : c1 ≤ Xb - μ := by rw [hc1]; exact max_le (by linarith) (min_le_right _ _)
