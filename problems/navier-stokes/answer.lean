theorem tail_param_deriv : ∀ (p k k' : ℝ → ℝ) (β C X η : ℝ), 1 < β → 0 < X → -1 < η → η < 1 → ContinuousOn p (Ioi X) → (∀ x : ℝ, X < x → |p x| ≤ C * x ^ (-β)) → ContinuousOn k (Ioi 0) → ContinuousOn k' (Ioi 0) → (∀ z : ℝ, 0 < z → HasDerivAt k (k' z) z ∧ |k z| ≤ C ∧ |k' z| ≤ C) → IntegrableOn (fun x => p x * k (2 * (1 - η ^ 2) / x)) (Ioi X) ∧ IntegrableOn (fun x => p x * (k' (2 * (1 - η ^ 2) / x) * (-(4 * η) / x))) (Ioi X) ∧ HasDerivAt (fun e => ∫ x in Ioi X, p x * k (2 * (1 - e ^ 2) / x)) (∫ x in Ioi X, p x * (k' (2 * (1 - η ^ 2) / x) * (-(4 * η) / x))) η :=
by
  intro p k k' β C X η hβ hX hη1 hη2 hpc hpb hkc hk'c hkd
  have hC : 0 ≤ C := le_trans (abs_nonneg _) (hkd 1 one_pos).2.1
  have hz : ∀ e x : ℝ, -1 < e → e < 1 → X < x → 0 < 2 * (1 - e ^ 2) / x := by
    intro e x h1 h2 hx
    have : 0 < 1 - e ^ 2 := by nlinarith
    exact div_pos (by linarith) (by linarith)
  have hgi : IntegrableOn (fun x : ℝ => x ^ (-β)) (Ioi X) :=
    integrableOn_Ioi_rpow_of_lt (by linarith) hX
  have hcontF : ∀ e : ℝ, -1 < e → e < 1 →
      ContinuousOn (fun x => p x * k (2 * (1 - e ^ 2) / x)) (Ioi X) := by
    intro e h1 h2
    refine hpc.mul (hkc.comp ?_ ?_)
    · exact continuousOn_const.div continuousOn_id (fun x hx => (hX.trans hx).ne')
    · intro x hx; exact hz e x h1 h2 hx
  have hcontF' : ContinuousOn
      (fun x => p x * (k' (2 * (1 - η ^ 2) / x) * (-(4 * η) / x))) (Ioi X) := by
    refine hpc.mul ((hk'c.comp ?_ ?_).mul ?_)
    · exact continuousOn_const.div continuousOn_id (fun x hx => (hX.trans hx).ne')
    · intro x hx; exact hz η x hη1 hη2 hx
    · exact continuousOn_const.div continuousOn_id (fun x hx => (hX.trans hx).ne')
  have hbF : ∀ x : ℝ, X < x → ‖p x * k (2 * (1 - η ^ 2) / x)‖ ≤ C * C * x ^ (-β) := by
    intro x hx
    rw [Real.norm_eq_abs, abs_mul]
    have h1 := hpb x hx
    have h2 := (hkd _ (hz η x hη1 hη2 hx)).2.1
    calc |p x| * |k (2 * (1 - η ^ 2) / x)| ≤ (C * x ^ (-β)) * C :=
          mul_le_mul h1 h2 (abs_nonneg _) (le_trans (abs_nonneg _) h1)
      _ = C * C * x ^ (-β) := by ring
  have hb4 : ∀ e x : ℝ, -1 < e → e < 1 → X < x → |-(4 * e) / x| ≤ 4 / X := by
    intro e x h1 h2 hx
    have hx0 : 0 < x := hX.trans hx
    rw [abs_div, abs_of_pos hx0, abs_neg, abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 4)]
    rw [div_le_div_iff₀ hx0 hX]
    have : |e| ≤ 1 := abs_le.2 ⟨h1.le, h2.le⟩
    nlinarith [abs_nonneg e]
  have hbF' : ∀ x : ℝ, X < x → ∀ e : ℝ, -1 < e → e < 1 →
      ‖p x * (k' (2 * (1 - e ^ 2) / x) * (-(4 * e) / x))‖ ≤ C * C * (4 / X) * x ^ (-β) := by
    intro x hx e h1 h2
    rw [Real.norm_eq_abs, abs_mul, abs_mul]
    have h1' := hpb x hx
    have h2' := (hkd _ (hz e x h1 h2 hx)).2.2
    have h3' := hb4 e x h1 h2 hx
    have hA : |k' (2 * (1 - e ^ 2) / x)| * |-(4 * e) / x| ≤ C * (4 / X) :=
      mul_le_mul h2' h3' (abs_nonneg _) hC
    calc |p x| * (|k' (2 * (1 - e ^ 2) / x)| * |-(4 * e) / x|) ≤ (C * x ^ (-β)) * (C * (4 / X)) :=
          mul_le_mul h1' hA (by positivity) (le_trans (abs_nonneg _) h1')
      _ = C * C * (4 / X) * x ^ (-β) := by ring
  have hder : ∀ x : ℝ, X < x → ∀ e : ℝ, -1 < e → e < 1 →
      HasDerivAt (fun e => p x * k (2 * (1 - e ^ 2) / x))
        (p x * (k' (2 * (1 - e ^ 2) / x) * (-(4 * e) / x))) e := by
    intro x hx e h1 h2
    have hin : HasDerivAt (fun e : ℝ => 2 * (1 - e ^ 2) / x) (-(4 * e) / x) e := by
      have := (((hasDerivAt_pow 2 e).const_sub 1).const_mul 2).div_const x
      convert this using 1
      norm_num
      ring
    have hout := (hkd _ (hz e x h1 h2 hx)).1
    exact (hout.comp e hin).const_mul (p x)
  have hs : Ioo (-1:ℝ) 1 ∈ nhds η := Ioo_mem_nhds hη1 hη2
  have hmeas : ∀ᶠ e in nhds η, AEStronglyMeasurable
      (fun x => p x * k (2 * (1 - e ^ 2) / x)) (volume.restrict (Ioi X)) := by
    filter_upwards [hs] with e he
    exact (hcontF e he.1 he.2).aestronglyMeasurable measurableSet_Ioi
  have hint : Integrable (fun x => p x * k (2 * (1 - η ^ 2) / x)) (volume.restrict (Ioi X)) := by
    refine Integrable.mono' (hgi.const_mul (C * C))
      ((hcontF η hη1 hη2).aestronglyMeasurable measurableSet_Ioi) ?_
    rw [ae_restrict_iff' measurableSet_Ioi]
    exact Filter.Eventually.of_forall (fun x hx => hbF x hx)
  have hbound_int : Integrable (fun x : ℝ => C * C * (4 / X) * x ^ (-β))
      (volume.restrict (Ioi X)) :=
    hgi.const_mul (C * C * (4 / X))
  have hbd : ∀ᵐ x ∂(volume.restrict (Ioi X)), ∀ e ∈ Ioo (-1:ℝ) 1,
      ‖p x * (k' (2 * (1 - e ^ 2) / x) * (-(4 * e) / x))‖ ≤ C * C * (4 / X) * x ^ (-β) := by
    rw [ae_restrict_iff' measurableSet_Ioi]
    exact Filter.Eventually.of_forall (fun x hx e he => hbF' x hx e he.1 he.2)
  have hdd : ∀ᵐ x ∂(volume.restrict (Ioi X)), ∀ e ∈ Ioo (-1:ℝ) 1,
      HasDerivAt (fun e => p x * k (2 * (1 - e ^ 2) / x))
        (p x * (k' (2 * (1 - e ^ 2) / x) * (-(4 * e) / x))) e := by
    rw [ae_restrict_iff' measurableSet_Ioi]
    exact Filter.Eventually.of_forall (fun x hx e he => hder x hx e he.1 he.2)
  have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume.restrict (Ioi X))
    (F := fun e x => p x * k (2 * (1 - e ^ 2) / x))
    (F' := fun e x => p x * (k' (2 * (1 - e ^ 2) / x) * (-(4 * e) / x)))
    (x₀ := η) (bound := fun x => C * C * (4 / X) * x ^ (-β)) hs hmeas hint
    (hcontF'.aestronglyMeasurable measurableSet_Ioi) hbd hbound_int hdd
  exact ⟨hint, key.1, key.2⟩

theorem collar_tz_ibp : ∀ (H H' f f' : ℝ → ℝ) (h c a X Xb C : ℝ), 0 < h → 0 < a → 0 < X → ContinuousOn H (Ioi 0) → ContinuousOn H' (Ioi 0) → ContinuousOn f' (Ioi 0) → (∀ z : ℝ, 0 < z → HasDerivAt H (H' z) z ∧ |H z| ≤ C ∧ |H' z| ≤ C) → (∀ x : ℝ, 0 < x → HasDerivAt f (f' x) x ∧ |f x| ≤ 1) → (∀ x : ℝ, Xb ≤ x → f' x = 0) → IntegrableOn (fun x => (c * x ^ (-(1 / 2 + h)) * f x) ^ 2 * (H (a / x) ^ 2 + (x - X) * (-(2 * (1 / 2 + h)) * H (a / x) ^ 2 / x + 2 * H (a / x) * H' (a / x) * (-(a / x ^ 2))))) (Ioi X) ∧ ∫ x in Ioi X, (c * x ^ (-(1 / 2 + h)) * f x) ^ 2 * (H (a / x) ^ 2 + (x - X) * (-(2 * (1 / 2 + h)) * H (a / x) ^ 2 / x + 2 * H (a / x) * H' (a / x) * (-(a / x ^ 2)))) = -(2 * ∫ x in X..Xb, (x - X) * (c * x ^ (-(1 / 2 + h)) * H (a / x)) ^ 2 * f x * f' x) :=
by
  intro H H' f f' h c a X Xb C hh ha hX hHc hH'c hf'c hH hf hf0
  obtain ⟨G, hG⟩ : ∃ G : ℝ → ℝ, G = fun x => (c * x ^ (-(1 / 2 + h)) * f x) ^ 2 * (H (a / x) ^ 2 + (x - X) * (-(2 * (1 / 2 + h)) * H (a / x) ^ 2 / x + 2 * H (a / x) * H' (a / x) * (-(a / x ^ 2)))) := ⟨_, rfl⟩
  obtain ⟨K, hK⟩ : ∃ K : ℝ → ℝ, K = fun x => (x - X) * (c * x ^ (-(1 / 2 + h)) * H (a / x)) ^ 2 * f x * f' x := ⟨_, rfl⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ → ℝ, Φ = fun y => (y - X) * (c * y ^ (-(1 / 2 + h)) * f y) ^ 2 * H (a / y) ^ 2 := ⟨_, rfl⟩

  have hx0 : ∀ x ∈ Ioi (0:ℝ), x ≠ 0 := fun x hx => ne_of_gt hx
  have hfc : ContinuousOn f (Ioi 0) := fun x hx => (hf x hx).1.continuousAt.continuousWithinAt
  have hrp : ContinuousOn (fun x : ℝ => x ^ (-(1 / 2 + h))) (Ioi 0) := fun x hx =>
    (Real.continuousAt_rpow_const x _ (Or.inl (ne_of_gt hx))).continuousWithinAt
  have hdv : ContinuousOn (fun x : ℝ => a / x) (Ioi 0) := continuousOn_const.div continuousOn_id hx0
  have hmp : MapsTo (fun x : ℝ => a / x) (Ioi 0) (Ioi 0) := fun x hx => div_pos ha hx
  have hHa : ContinuousOn (fun x : ℝ => H (a / x)) (Ioi 0) := hHc.comp hdv hmp
  have hH'a : ContinuousOn (fun x : ℝ => H' (a / x)) (Ioi 0) := hH'c.comp hdv hmp
  have hGc : ContinuousOn G (Ioi 0) := by
    rw [hG]
    apply ContinuousOn.mul
    · exact ((continuousOn_const.mul hrp).mul hfc).pow 2
    · apply ContinuousOn.add (hHa.pow 2)
      apply ContinuousOn.mul (continuousOn_id.sub continuousOn_const)
      apply ContinuousOn.add
      · exact (continuousOn_const.mul (hHa.pow 2)).div continuousOn_id hx0
      · exact ((continuousOn_const.mul hHa).mul hH'a).mul
          ((continuousOn_const.div (continuousOn_id.pow 2)
            (fun x hx => pow_ne_zero 2 (hx0 x hx))).neg)
  have hKc : ContinuousOn K (Ioi 0) := by
    rw [hK]
    exact (((continuousOn_id.sub continuousOn_const).mul
      (((continuousOn_const.mul hrp).mul hHa).pow 2)).mul hfc).mul hf'c

  have hderiv : ∀ x : ℝ, 0 < x → HasDerivAt Φ (G x + 2 * K x) x := by
    intro x hx
    have hxne : x ≠ 0 := ne_of_gt hx
    have hax : 0 < a / x := div_pos ha hx
    have h1 : HasDerivAt (fun y : ℝ => y ^ (-(1 / 2 + h)))
        ((-(1 / 2 + h)) * x ^ (-(1 / 2 + h) - 1)) x := Real.hasDerivAt_rpow_const (Or.inl hxne)
    have h2 : HasDerivAt (fun y : ℝ => a / y) (-(a / x ^ 2)) x := by
      have := (hasDerivAt_inv hxne).const_mul a
      convert this using 1
      · ext y; simp [div_eq_mul_inv]
      · field_simp
    have h3 : HasDerivAt (fun y => H (a / y)) (H' (a / x) * (-(a / x ^ 2))) x :=
      (hH (a / x) hax).1.comp x h2
    have h4 := (hf x hx).1
    have hg := (h1.const_mul c).mul h4
    have hΦd := (((hasDerivAt_id' x).sub_const X).mul (hg.pow 2)).mul (h3.pow 2)
    rw [hΦ]
    refine hΦd.congr_deriv ?_
    simp only [hG, hK, Pi.mul_apply, Pi.pow_apply, Real.rpow_sub_one hxne]
    field_simp
    ring

  have hGi : IntegrableOn G (Ioi X) := by
    have hmeas : AEStronglyMeasurable G (volume.restrict (Ioi X)) :=
      (hGc.mono (Ioi_subset_Ioi hX.le)).aestronglyMeasurable measurableSet_Ioi
    have hdom : IntegrableOn (fun x : ℝ => c ^ 2 * (C ^ 2 * (1 + 2 * (1 / 2 + h) + 2 * (a / X))) *
        x ^ (-(1 + 2 * h))) (Ioi X) :=
      (integrableOn_Ioi_rpow_of_lt (by linarith) hX).const_mul _
    refine Integrable.mono' hdom hmeas ?_
    refine (ae_restrict_mem measurableSet_Ioi).mono fun x hx => ?_
    have hxp : 0 < x := lt_trans hX (mem_Ioi.mp hx)
    have hxX : X < x := mem_Ioi.mp hx
    have hr2 : (x ^ (-(1 / 2 + h))) ^ 2 = x ^ (-(1 + 2 * h)) := by
      rw [sq, ← Real.rpow_add hxp]; congr 1; ring
    have hax : 0 < a / x := div_pos ha hxp
    obtain ⟨-, hu, hv⟩ := hH (a / x) hax
    have hF := (hf x hxp).2
    have hC0 : 0 ≤ C := le_trans (abs_nonneg _) hu
    have hq : H (a / x) ^ 2 ≤ C ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hu 2
    have hq0 : 0 ≤ H (a / x) ^ 2 := sq_nonneg _
    have hw : |H (a / x) * H' (a / x)| ≤ C ^ 2 := by
      rw [abs_mul, sq]; exact mul_le_mul hu hv (abs_nonneg _) hC0
    have hF2 : f x ^ 2 ≤ 1 := by
      rw [← sq_abs]; nlinarith [abs_nonneg (f x)]
    set t := (x - X) / x with ht
    set s := a / x with hs
    have ht0 : 0 ≤ t := div_nonneg (by linarith) hxp.le
    have ht1 : t ≤ 1 := (div_le_one hxp).mpr (by linarith)
    have hs0 : 0 ≤ s := hax.le
    have hs1 : s ≤ a / X := div_le_div_of_nonneg_left ha.le hX hxX.le
    have hB : H s ^ 2 + (x - X) * (-(2 * (1 / 2 + h)) * H s ^ 2 / x + 2 * H s * H' s * (-(a / x ^ 2)))
        = H s ^ 2 - 2 * (1 / 2 + h) * (t * H s ^ 2) - 2 * (t * s * (H s * H' s)) := by
      rw [ht, hs]; field_simp; ring
    have e1 : t * H s ^ 2 ≤ C ^ 2 := by nlinarith
    have e1' : 0 ≤ t * H s ^ 2 := mul_nonneg ht0 hq0
    have e2 : |t * s * (H s * H' s)| ≤ a / X * C ^ 2 := by
      rw [abs_mul, abs_of_nonneg (mul_nonneg ht0 hs0)]
      have : t * s ≤ a / X := by nlinarith
      exact mul_le_mul this hw (abs_nonneg _) (le_trans (mul_nonneg ht0 hs0) this)
    have e3 := mul_le_mul_of_nonneg_left e1 hh.le
    have e4 := mul_nonneg hh.le e1'
    have haX : 0 ≤ a / X * C ^ 2 := le_trans (abs_nonneg _) e2
    have hBb : |H s ^ 2 - 2 * (1 / 2 + h) * (t * H s ^ 2) - 2 * (t * s * (H s * H' s))|
        ≤ C ^ 2 * (1 + 2 * (1 / 2 + h) + 2 * (a / X)) := by
      rw [abs_le]
      obtain ⟨l2, u2⟩ := abs_le.mp e2
      constructor <;> nlinarith
    rw [hG]
    simp only
    rw [hB, Real.norm_eq_abs, abs_mul, abs_of_nonneg (sq_nonneg _)]
    have hcr : (c * x ^ (-(1 / 2 + h)) * f x) ^ 2 ≤ c ^ 2 * x ^ (-(1 + 2 * h)) := by
      rw [mul_pow, mul_pow, hr2]
      have : 0 ≤ c ^ 2 * x ^ (-(1 + 2 * h)) := mul_nonneg (sq_nonneg _) (Real.rpow_nonneg hxp.le _)
      nlinarith
    calc (c * x ^ (-(1 / 2 + h)) * f x) ^ 2 *
          |H s ^ 2 - 2 * (1 / 2 + h) * (t * H s ^ 2) - 2 * (t * s * (H s * H' s))|
        ≤ (c ^ 2 * x ^ (-(1 + 2 * h))) * (C ^ 2 * (1 + 2 * (1 / 2 + h) + 2 * (a / X))) :=
          mul_le_mul hcr hBb (abs_nonneg _)
            (mul_nonneg (sq_nonneg _) (Real.rpow_nonneg hxp.le _))
      _ = c ^ 2 * (C ^ 2 * (1 + 2 * (1 / 2 + h) + 2 * (a / X))) * x ^ (-(1 + 2 * h)) := by ring

  have hlim : Filter.Tendsto Φ Filter.atTop (nhds 0) := by
    have hm : Filter.Tendsto (fun y : ℝ => c ^ 2 * C ^ 2 * y ^ (-(2 * h))) Filter.atTop (nhds 0) := by
      simpa using (tendsto_rpow_neg_atTop (by linarith : 0 < 2 * h)).const_mul (c ^ 2 * C ^ 2)
    refine squeeze_zero_norm' ?_ hm
    filter_upwards [Filter.eventually_ge_atTop X] with y hy
    have hyp : 0 < y := lt_of_lt_of_le hX hy
    have hr2 : (y ^ (-(1 / 2 + h))) ^ 2 = y ^ (-(1 + 2 * h)) := by
      rw [sq, ← Real.rpow_add hyp]; congr 1; ring
    have hyy : y ^ (-(2 * h)) = y * y ^ (-(1 + 2 * h)) := by
      rw [show -(2 * h) = 1 + (-(1 + 2 * h)) by ring, Real.rpow_add hyp, Real.rpow_one]
    have hay : 0 < a / y := div_pos ha hyp
    obtain ⟨-, hu, -⟩ := hH (a / y) hay
    have hF := (hf y hyp).2
    have hq : H (a / y) ^ 2 ≤ C ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hu 2
    have hF2 : f y ^ 2 ≤ 1 := by
      rw [← sq_abs]; nlinarith [abs_nonneg (f y)]
    have hR : 0 ≤ y ^ (-(1 + 2 * h)) := Real.rpow_nonneg hyp.le _
    have hcr : (c * y ^ (-(1 / 2 + h)) * f y) ^ 2 ≤ c ^ 2 * y ^ (-(1 + 2 * h)) := by
      rw [mul_pow, mul_pow, hr2]
      have : 0 ≤ c ^ 2 * y ^ (-(1 + 2 * h)) := mul_nonneg (sq_nonneg _) hR
      nlinarith
    rw [hΦ]
    simp only
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), hyy]
    calc (y - X) * (c * y ^ (-(1 / 2 + h)) * f y) ^ 2 * H (a / y) ^ 2
        ≤ y * (c ^ 2 * y ^ (-(1 + 2 * h))) * C ^ 2 := by
          apply mul_le_mul _ hq (sq_nonneg _) (mul_nonneg hyp.le (mul_nonneg (sq_nonneg _) hR))
          exact mul_le_mul (by linarith) hcr (sq_nonneg _) hyp.le
      _ = c ^ 2 * C ^ 2 * (y * y ^ (-(1 + 2 * h))) := by ring

  have hK0 : ∀ x : ℝ, Xb ≤ x → K x = 0 := fun x hx => by rw [hK]; simp only; rw [hf0 x hx, mul_zero]
  have hKi1 : IntegrableOn K (Ioc X (max X Xb)) :=
    ((hKc.mono (fun x hx => lt_of_lt_of_le hX hx.1)).integrableOn_Icc).mono_set Ioc_subset_Icc_self
  have hKi2 : IntegrableOn K (Ioi (max X Xb)) :=
    (integrableOn_zero).congr_fun
      (fun x hx => (hK0 x (le_trans (le_max_right _ _) (le_of_lt hx))).symm) measurableSet_Ioi
  have hKi : IntegrableOn K (Ioi X) := by
    rw [← Ioc_union_Ioi_eq_Ioi (le_max_left X Xb)]
    exact hKi1.union hKi2
  have hKint : ∫ x in Ioi X, K x = ∫ x in X..Xb, K x := by
    have hz1 : ∫ x in Ioi (max X Xb), K x = 0 :=
      setIntegral_eq_zero_of_forall_eq_zero
        (fun x (hx : x ∈ Ioi (max X Xb)) => hK0 x (le_trans (le_max_right _ _) (le_of_lt hx)))
    rw [← Ioc_union_Ioi_eq_Ioi (le_max_left X Xb),
      setIntegral_union Ioc_disjoint_Ioi_same measurableSet_Ioi hKi1 hKi2, hz1, add_zero]
    rcases le_total X Xb with hle | hle
    · rw [intervalIntegral.integral_of_le hle, max_eq_right hle]
    · have hz2 : ∫ x in Ioc Xb X, K x = 0 :=
        setIntegral_eq_zero_of_forall_eq_zero (fun x (hx : x ∈ Ioc Xb X) => hK0 x hx.1.le)
      rw [max_eq_left hle, Ioc_self, Measure.restrict_empty, integral_zero_measure,
        intervalIntegral.integral_symm, intervalIntegral.integral_of_le hle, hz2, neg_zero]

  have hftc := integral_Ioi_of_hasDerivAt_of_tendsto (f := Φ) (f' := fun x => G x + 2 * K x)
    (a := X) (m := 0) ((hderiv X hX).continuousAt.continuousWithinAt)
    (fun x hx => hderiv x (lt_trans hX hx)) (hGi.add (hKi.const_mul 2)) hlim
  have hΦX : Φ X = 0 := by rw [hΦ]; simp
  rw [integral_add hGi (hKi.const_mul 2), integral_const_mul, hΦX] at hftc
  have key : IntegrableOn G (Ioi X) ∧ ∫ x in Ioi X, G x = -(2 * ∫ x in X..Xb, K x) :=
    ⟨hGi, by rw [← hKint]; linarith⟩
  subst hG hK
  exact key

theorem collar_Tz_identity : ∀ (h cinf ρ Xb : ℝ) (F U : ℝ → ℝ → ℝ), TailForm h cinf ρ Xb F U → ∀ X η : ℝ, Xb * Real.exp (-(11 / 4)) < X → -1 < η → η < 1 → leadStressTz h F U X η = collarTz h cinf ρ Xb X η :=
by
  intro h cinf ρ Xb F U hT X η hX hη1 hη2
  obtain ⟨hh0, hh1, hc0, hXb0, hρ0, hρ1, hFs, hUs, hFpos, htail, htot⟩ := hT
  have hXt0 : 0 < Xb * Real.exp (-(11 / 4)) := mul_pos hXb0 (Real.exp_pos _)
  have hX0 : 0 < X := hXt0.trans hX
  have hd : 0 < 1 - η ^ 2 := by nlinarith
  have hL : 0 < 1 - 2 * h * η ^ 2 := by nlinarith
  have hsq : 0 < Real.sqrt (2 * X) := Real.sqrt_pos.2 (by linarith)
  have hF0 : 0 < F X η := hFpos X η hX0 hη1 hη2
  have hXne : X ≠ 0 := hX0.ne'
  have hLne : 1 - 2 * h * η ^ 2 ≠ 0 := hL.ne'
  have hsqne : Real.sqrt (2 * X) ≠ 0 := hsq.ne'
  have hFne : F X η ≠ 0 := hF0.ne'

  have hUX : U X η = 0 := (htail X η hX.le hη1 hη2).1
  have hdU : deriv (fun Y => U Y η) X = 0 := by
    have hev : (fun Y => U Y η) =ᶠ[nhds X] fun _ => (0:ℝ) := by
      filter_upwards [Ioi_mem_nhds hX] with Y hY
      exact (htail Y η (le_of_lt hY) hη1 hη2).1
    rw [hev.deriv_eq, deriv_const]
  have hshB : shearB F U X η = 0 := by
    unfold shearB; rw [hdU]; simp
  have hPU : profRadInt U X η = 0 := (htail X η hX.le hη1 hη2).2.1
  have hdPU : profEtaD (profRadInt U) X η = 0 := by
    unfold profEtaD
    have hev : (fun e => profRadInt U X e) =ᶠ[nhds η] fun _ => (0:ℝ) := by
      filter_upwards [Ioo_mem_nhds hη1 hη2] with e he
      exact (htail X e hX.le he.1 he.2).2.1
    rw [hev.deriv_eq, deriv_const]
  have hunf : leadStressTz h F U X η =
      (4 * h * η * profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2) X η
        - (1 - η ^ 2) * profEtaD (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2)) X η
        + X * (4 * (1 / 2 + h) * η * leadPi F X η - (1 - η ^ 2) * profEtaD (leadPi F) X η)) /
      ((1 - 2 * h * η ^ 2) * Real.sqrt (2 * X)) := by
    unfold leadStressTz leadNs
    rw [hshB, hUX, hPU, hdPU]
    field_simp
    ring

  obtain ⟨hHP1, hHP2, -⟩ :=
    heatProfile_props h hh0 heatK_deriv_bound (fun Z hZ => heatK_ode h Z hh0 hZ)
  obtain ⟨C0, hC0⟩ := hHP2 0
  obtain ⟨C1, hC1⟩ := hHP2 1
  simp only [iteratedDeriv_zero] at hC0
  simp only [iteratedDeriv_one] at hC1
  have hC0n : 0 ≤ C0 := (abs_nonneg _).trans (hC0 1 one_pos)
  have hC1n : 0 ≤ C1 := (abs_nonneg _).trans (hC1 1 one_pos)
  have hHd : ∀ Z : ℝ, 0 < Z → HasDerivAt (heatProfile h) (deriv (heatProfile h) Z) Z := fun Z hZ =>
    ((hHP1.contDiffAt (Ioi_mem_nhds hZ)).differentiableAt (by simp)).hasDerivAt
  have hHc : ContinuousOn (heatProfile h) (Ioi 0) := hHP1.continuousOn
  have hH'c : ContinuousOn (deriv (heatProfile h)) (Ioi 0) :=
    hHP1.continuousOn_deriv_of_isOpen isOpen_Ioi (by simp)

  obtain ⟨hTc, hTd⟩ := tailFac_C1 ρ Xb hXb0 hρ0 hρ1
  have hfc : ∀ x : ℝ, 0 < x → ContinuousAt (tailFac ρ Xb) x := fun x hx => (hTd x hx).1.continuousAt
  have hrc : ∀ x : ℝ, 0 < x → ContinuousAt (fun x : ℝ => x ^ (-(1 / 2 + h))) x := fun x hx =>
    Real.continuousAt_rpow_const x _ (Or.inl hx.ne')
  have hf2 : ∀ x : ℝ, 0 < x → tailFac ρ Xb x ^ 2 ≤ 1 := by
    intro x hx
    have a1 := (hTd x hx).2.1
    have a2 := (hTd x hx).2.2.1
    nlinarith

  obtain ⟨k, hk⟩ : ∃ k : ℝ → ℝ, k = fun z => heatProfile h z ^ 2 := ⟨_, rfl⟩
  obtain ⟨k', hk'⟩ : ∃ k' : ℝ → ℝ, k' = fun z => 2 * heatProfile h z * deriv (heatProfile h) z :=
    ⟨_, rfl⟩
  obtain ⟨pS, hpS⟩ : ∃ p : ℝ → ℝ,
      p = fun x => (cinf * x ^ (-(1 / 2 + h)) * tailFac ρ Xb x) ^ 2 / 2 := ⟨_, rfl⟩
  obtain ⟨pP, hpP⟩ : ∃ p : ℝ → ℝ,
      p = fun x => (cinf * x ^ (-(1 / 2 + h)) * tailFac ρ Xb x) ^ 2 / (2 * x) := ⟨_, rfl⟩
  obtain ⟨Cm, hCm⟩ : ∃ Cm : ℝ, Cm = max (cinf ^ 2 / 2) (max (C0 ^ 2) (2 * C0 * C1)) := ⟨_, rfl⟩
  have hCm1 : cinf ^ 2 / 2 ≤ Cm := by rw [hCm]; exact le_max_left _ _
  have hCm2 : C0 ^ 2 ≤ Cm := by rw [hCm]; exact (le_max_left _ _).trans (le_max_right _ _)
  have hCm3 : 2 * C0 * C1 ≤ Cm := by rw [hCm]; exact (le_max_right _ _).trans (le_max_right _ _)

  have hkd : ∀ z : ℝ, 0 < z → HasDerivAt k (k' z) z ∧ |k z| ≤ Cm ∧ |k' z| ≤ Cm := by
    intro z hz
    have hb0 := hC0 z hz
    have hb1 := hC1 z hz
    refine ⟨?_, ?_, ?_⟩
    · rw [hk, hk']
      have h2 := (hHd z hz).mul (hHd z hz)
      have e1 : (fun z => heatProfile h z ^ 2) = fun y => heatProfile h y * heatProfile h y := by
        funext y; ring
      rw [e1]
      convert h2 using 1
      ring
    · rw [hk]
      beta_reduce
      rw [abs_of_nonneg (sq_nonneg _)]
      calc heatProfile h z ^ 2 = |heatProfile h z| ^ 2 := (sq_abs _).symm
        _ ≤ C0 ^ 2 := pow_le_pow_left₀ (abs_nonneg _) hb0 2
        _ ≤ Cm := hCm2
    · rw [hk']
      beta_reduce
      rw [abs_mul, abs_mul, abs_two]
      calc 2 * |heatProfile h z| * |deriv (heatProfile h) z| ≤ 2 * C0 * C1 :=
            mul_le_mul (mul_le_mul_of_nonneg_left hb0 (by norm_num)) hb1 (abs_nonneg _) (by positivity)
        _ ≤ Cm := hCm3
  have hkc : ContinuousOn k (Ioi 0) := by rw [hk]; exact hHc.pow 2
  have hk'c : ContinuousOn k' (Ioi 0) := by rw [hk']; exact (continuousOn_const.mul hHc).mul hH'c

  have hpSc : ContinuousOn pS (Ioi X) := by
    intro x hx
    have hx0 : 0 < x := hX0.trans hx
    rw [hpS]
    exact ((((continuousAt_const.mul (hrc x hx0)).mul (hfc x hx0)).pow 2).div_const 2).continuousWithinAt
  have hpPc : ContinuousOn pP (Ioi X) := by
    intro x hx
    have hx0 : 0 < x := hX0.trans hx
    rw [hpP]
    exact ((((continuousAt_const.mul (hrc x hx0)).mul (hfc x hx0)).pow 2).div
      (continuousAt_const.mul continuousAt_id) (mul_pos two_pos hx0).ne').continuousWithinAt
  have hpow : ∀ x : ℝ, 0 < x → (x ^ (-(1 / 2 + h))) ^ 2 = x ^ (-(1 + 2 * h)) := by
    intro x hx
    rw [sq, ← Real.rpow_add hx]
    congr 1
    ring
  have hpSb : ∀ x : ℝ, X < x → |pS x| ≤ Cm * x ^ (-(1 + 2 * h)) := by
    intro x hx
    have hx0 : 0 < x := hX0.trans hx
    rw [hpS]
    beta_reduce
    have hr : 0 < x ^ (-(1 + 2 * h)) := Real.rpow_pos_of_pos hx0 _
    have h0 : 0 ≤ (cinf * x ^ (-(1 / 2 + h)) * tailFac ρ Xb x) ^ 2 / 2 :=
      div_nonneg (sq_nonneg _) (by norm_num)
    rw [abs_of_nonneg h0, mul_pow, mul_pow, hpow x hx0]
    have hA : cinf ^ 2 * x ^ (-(1 + 2 * h)) * tailFac ρ Xb x ^ 2 ≤ cinf ^ 2 * x ^ (-(1 + 2 * h)) * 1 :=
      mul_le_mul_of_nonneg_left (hf2 x hx0) (mul_nonneg (sq_nonneg _) hr.le)
    have hB : cinf ^ 2 / 2 * x ^ (-(1 + 2 * h)) ≤ Cm * x ^ (-(1 + 2 * h)) :=
      mul_le_mul_of_nonneg_right hCm1 hr.le
    linarith
  have hpPb : ∀ x : ℝ, X < x → |pP x| ≤ Cm * x ^ (-(2 + 2 * h)) := by
    intro x hx
    have hx0 : 0 < x := hX0.trans hx
    have e : pP x = pS x / x := by
      rw [hpP, hpS]
      beta_reduce
      rw [div_div]
    have e2 : x ^ (-(2 + 2 * h)) = x ^ (-(1 + 2 * h)) / x := by
      rw [← Real.rpow_sub_one hx0.ne']
      congr 1
      ring
    rw [e, e2, abs_div, abs_of_pos hx0, mul_div_assoc']
    exact div_le_div_of_nonneg_right (hpSb x hx) hx0.le

  have hrep : ∀ e : ℝ, -1 < e → e < 1 →
      profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2) X e =
          ∫ x in Ioi X, pS x * k (2 * (1 - e ^ 2) / x) ∧
        leadPi F X e = -∫ x in Ioi X, pP x * k (2 * (1 - e ^ 2) / x) := by
    intro e he1 he2
    obtain ⟨-, hI2, -, -, -, hz2, -, -⟩ := htot e he1 he2
    have hpt : ∀ x ∈ Ioi X, U x e ^ 2 - x * F x e ^ 2 = -(pS x * k (2 * (1 - e ^ 2) / x)) ∧
        F x e ^ 2 = pP x * k (2 * (1 - e ^ 2) / x) := by
      intro x hx
      have hx0 : 0 < x := hX0.trans hx
      have hxne : x ≠ 0 := hx0.ne'
      obtain ⟨hU0, -, hE⟩ := htail x e (hX.trans hx).le he1 he2
      have hs2 : Real.sqrt (2 * x) ^ 2 = 2 * x := Real.sq_sqrt (by linarith)
      have hE2 : 2 * x * F x e ^ 2 = (cinf * x ^ (-(1 / 2 + h)) *
          heatProfile h (2 * (1 - e ^ 2) / x) * tailFac ρ Xb x) ^ 2 := by
        rw [← hE, mul_pow, hs2]
      have hF2 : F x e ^ 2 = (cinf * x ^ (-(1 / 2 + h)) *
          heatProfile h (2 * (1 - e ^ 2) / x) * tailFac ρ Xb x) ^ 2 / (2 * x) := by
        rw [← hE2]
        field_simp
      rw [hU0, hpS, hpP, hk]
      beta_reduce
      constructor
      · linear_combination (-1 / 2 : ℝ) * hE2
      · rw [hF2]
        ring
    constructor
    · unfold profRadInt
      show (∫ x in (0:ℝ)..X, (U x e ^ 2 - x * F x e ^ 2)) = _
      rw [intervalIntegral.integral_of_le hX0.le]
      have hsplit := setIntegral_union (Ioc_disjoint_Ioi_same (a := (0:ℝ)) (b := X)) measurableSet_Ioi
        (hI2.mono_set Ioc_subset_Ioi_self) (hI2.mono_set (Ioi_subset_Ioi hX0.le))
      rw [Ioc_union_Ioi_eq_Ioi hX0.le, hz2,
        setIntegral_congr_fun measurableSet_Ioi (fun x hx => (hpt x hx).1), integral_neg] at hsplit
      linarith
    · unfold leadPi
      rw [setIntegral_congr_fun measurableSet_Ioi (fun x hx => (hpt x hx).2)]

  obtain ⟨IS0, IS1, DS⟩ := tail_param_deriv pS k k' (1 + 2 * h) Cm X η (by linarith) hX0 hη1 hη2
    hpSc hpSb hkc hk'c hkd
  obtain ⟨IP0, IP1, DP⟩ := tail_param_deriv pP k k' (2 + 2 * h) Cm X η (by linarith) hX0 hη1 hη2
    hpPc hpPb hkc hk'c hkd
  have hS0 := (hrep η hη1 hη2).1
  have hP0 := (hrep η hη1 hη2).2
  have hS1 : profEtaD (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2)) X η =
      ∫ x in Ioi X, pS x * (k' (2 * (1 - η ^ 2) / x) * (-(4 * η) / x)) := by
    unfold profEtaD
    have hev : (fun e => profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2) X e) =ᶠ[nhds η]
        fun e => ∫ x in Ioi X, pS x * k (2 * (1 - e ^ 2) / x) := by
      filter_upwards [Ioo_mem_nhds hη1 hη2] with e he
      exact (hrep e he.1 he.2).1
    rw [hev.deriv_eq, DS.deriv]
  have hP1 : profEtaD (leadPi F) X η =
      -∫ x in Ioi X, pP x * (k' (2 * (1 - η ^ 2) / x) * (-(4 * η) / x)) := by
    unfold profEtaD
    have hev : (fun e => leadPi F X e) =ᶠ[nhds η]
        fun e => -∫ x in Ioi X, pP x * k (2 * (1 - e ^ 2) / x) := by
      filter_upwards [Ioo_mem_nhds hη1 hη2] with e he
      exact (hrep e he.1 he.2).2
    rw [hev.deriv_eq]
    exact DP.neg.deriv
  rw [hunf, hS0, hP0, hS1, hP1]

  obtain ⟨u1, hu1⟩ : ∃ u : ℝ → ℝ, u = fun x => pS x * k (2 * (1 - η ^ 2) / x) := ⟨_, rfl⟩
  obtain ⟨u2, hu2⟩ : ∃ u : ℝ → ℝ,
      u = fun x => pS x * (k' (2 * (1 - η ^ 2) / x) * (-(4 * η) / x)) := ⟨_, rfl⟩
  obtain ⟨u3, hu3⟩ : ∃ u : ℝ → ℝ, u = fun x => pP x * k (2 * (1 - η ^ 2) / x) := ⟨_, rfl⟩
  obtain ⟨u4, hu4⟩ : ∃ u : ℝ → ℝ,
      u = fun x => pP x * (k' (2 * (1 - η ^ 2) / x) * (-(4 * η) / x)) := ⟨_, rfl⟩
  have eS0 : (∫ x in Ioi X, pS x * k (2 * (1 - η ^ 2) / x)) = ∫ x in Ioi X, u1 x := by rw [hu1]
  have eS1 : (∫ x in Ioi X, pS x * (k' (2 * (1 - η ^ 2) / x) * (-(4 * η) / x))) =
      ∫ x in Ioi X, u2 x := by rw [hu2]
  have eP0 : (∫ x in Ioi X, pP x * k (2 * (1 - η ^ 2) / x)) = ∫ x in Ioi X, u3 x := by rw [hu3]
  have eP1 : (∫ x in Ioi X, pP x * (k' (2 * (1 - η ^ 2) / x) * (-(4 * η) / x))) =
      ∫ x in Ioi X, u4 x := by rw [hu4]
  have J1 : IntegrableOn u1 (Ioi X) := by rw [hu1]; exact IS0
  have J2 : IntegrableOn u2 (Ioi X) := by rw [hu2]; exact IS1
  have J3 : IntegrableOn u3 (Ioi X) := by rw [hu3]; exact IP0
  have J4 : IntegrableOn u4 (Ioi X) := by rw [hu4]; exact IP1
  have i1 : Integrable (fun x => 4 * h * η * u1 x) (volume.restrict (Ioi X)) := Integrable.const_mul J1 _
  have i2 : Integrable (fun x => (1 - η ^ 2) * u2 x) (volume.restrict (Ioi X)) := Integrable.const_mul J2 _
  have i3 : Integrable (fun x => 4 * (1 / 2 + h) * η * X * u3 x) (volume.restrict (Ioi X)) :=
    Integrable.const_mul J3 _
  have i4 : Integrable (fun x => (1 - η ^ 2) * X * u4 x) (volume.restrict (Ioi X)) :=
    Integrable.const_mul J4 _
  have i12 : Integrable (fun x => 4 * h * η * u1 x - (1 - η ^ 2) * u2 x) (volume.restrict (Ioi X)) :=
    i1.sub i2
  have i123 : Integrable (fun x => 4 * h * η * u1 x - (1 - η ^ 2) * u2 x -
      4 * (1 / 2 + h) * η * X * u3 x) (volume.restrict (Ioi X)) := i12.sub i3
  have hcomb : (∫ x in Ioi X, (4 * h * η * u1 x - (1 - η ^ 2) * u2 x -
      4 * (1 / 2 + h) * η * X * u3 x + (1 - η ^ 2) * X * u4 x)) =
      4 * h * η * (∫ x in Ioi X, u1 x) - (1 - η ^ 2) * (∫ x in Ioi X, u2 x) -
        4 * (1 / 2 + h) * η * X * (∫ x in Ioi X, u3 x) + (1 - η ^ 2) * X * (∫ x in Ioi X, u4 x) := by
    rw [integral_add i123 i4, integral_sub i12 i3, integral_sub i1 i2, integral_const_mul,
      integral_const_mul, integral_const_mul, integral_const_mul]

  obtain ⟨Ψ, hΨdef⟩ : ∃ Ψ : ℝ → ℝ, Ψ = fun x =>
      (cinf * x ^ (-(1 / 2 + h)) * tailFac ρ Xb x) ^ 2 *
        (heatProfile h (2 * (1 - η ^ 2) / x) ^ 2 + (x - X) *
          (-(2 * (1 / 2 + h)) * heatProfile h (2 * (1 - η ^ 2) / x) ^ 2 / x +
            2 * heatProfile h (2 * (1 - η ^ 2) / x) * deriv (heatProfile h) (2 * (1 - η ^ 2) / x) *
              (-(2 * (1 - η ^ 2) / x ^ 2)))) := ⟨_, rfl⟩
  have hpt2 : ∀ x ∈ Ioi X, 4 * h * η * u1 x - (1 - η ^ 2) * u2 x -
      4 * (1 / 2 + h) * η * X * u3 x + (1 - η ^ 2) * X * u4 x = (-η) * Ψ x := by
    intro x hx
    have hx0 : 0 < x := hX0.trans hx
    have hxne : x ≠ 0 := hx0.ne'
    rw [hu1, hu2, hu3, hu4, hΨdef, hpS, hpP, hk, hk']
    beta_reduce
    field_simp
    ring
  have hℓ : (∫ x in Ioi X, (4 * h * η * u1 x - (1 - η ^ 2) * u2 x -
      4 * (1 / 2 + h) * η * X * u3 x + (1 - η ^ 2) * X * u4 x)) = (-η) * ∫ x in Ioi X, Ψ x := by
    rw [setIntegral_congr_fun measurableSet_Ioi hpt2, integral_const_mul]

  obtain ⟨-, hΨ⟩ := collar_tz_ibp (heatProfile h) (deriv (heatProfile h)) (tailFac ρ Xb)
    (deriv (tailFac ρ Xb)) h cinf (2 * (1 - η ^ 2)) X Xb (max C0 C1) hh0 (by linarith) hX0 hHc hH'c hTc
    (fun z hz => ⟨hHd z hz, (hC0 z hz).trans (le_max_left _ _), (hC1 z hz).trans (le_max_right _ _)⟩)
    (fun x hx => ⟨(hTd x hx).1, abs_le.2 ⟨by linarith [(hTd x hx).2.1], (hTd x hx).2.2.1⟩⟩)
    (fun x hx => (hTd x (hXb0.trans_le hx)).2.2.2 hx)
  have hΨ' : (∫ x in Ioi X, Ψ x) = -(2 * ∫ x in X..Xb, (x - X) *
      (cinf * x ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - η ^ 2) / x)) ^ 2 *
        tailFac ρ Xb x * deriv (tailFac ρ Xb) x) := by
    rw [hΨdef]; exact hΨ

  unfold collarTz tailEh
  congr 1
  linear_combination 4 * h * η * eS0 - (1 - η ^ 2) * eS1 - 4 * (1 / 2 + h) * η * X * eP0 +
    (1 - η ^ 2) * X * eP1 - hcomb + hℓ + (-η) * hΨ'

theorem sigA_collar_facts : ContDiff ℝ ∞ sigA ∧ ContDiff ℝ ∞ collarG ∧ ContDiff ℝ ∞ collarGam ∧ (∀ u : ℝ, 0 < u → 1 - sigA (1 - u) = Real.exp (-1 / u ^ 2) * collarG u) ∧ (∀ u : ℝ, 0 < u → HasDerivAt sigA (Real.exp (-1 / u ^ 2) / u ^ 3 * collarGam u) (1 - u)) ∧ (∀ u : ℝ, 0 < u → 0 ≤ collarGam u) ∧ (∀ u : ℝ, 0 < u → u ≤ 1 / 2 → Real.exp (-4) / 2 ≤ collarGam u) :=
by
  obtain ⟨F, hF⟩ : ∃ F : ℕ → ℝ → ℝ,
      F = fun j z => if z ≤ 0 then (0 : ℝ) else (z ^ j)⁻¹ * Real.exp (-1 / z ^ 2) := ⟨_, rfl⟩

  have hflat : ∀ (j : ℕ) (z : ℝ), 0 < z → z ≤ 1 →
      (z ^ j)⁻¹ * Real.exp (-1 / z ^ 2) ≤ ((j + 1).factorial : ℝ) * z ^ 2 := by
    intro j z hz hz1
    have hx : (0 : ℝ) ≤ 1 / z ^ 2 := by positivity
    have h1 := Real.pow_div_factorial_le_exp _ hx (j + 1)
    have hA : (0 : ℝ) < ((j + 1).factorial : ℝ) := by exact_mod_cast Nat.factorial_pos _
    have hE : Real.exp (-1 / z ^ 2) = (Real.exp (1 / z ^ 2))⁻¹ := by
      rw [← Real.exp_neg]; ring_nf
    have hEpos := Real.exp_pos (1 / z ^ 2)
    have hzj : z ^ j ≤ 1 := pow_le_one₀ hz.le hz1
    have hzjpos : 0 < z ^ j := pow_pos hz j
    rw [div_le_iff₀ hA] at h1
    have h2 : (1 / z ^ 2) ^ (j + 1) * (z ^ 2) ^ (j + 1) = 1 := by
      rw [← mul_pow]; field_simp; simp
    have h3 : 1 ≤ ((j + 1).factorial : ℝ) * (z ^ 2) ^ (j + 1) * Real.exp (1 / z ^ 2) := by
      calc (1 : ℝ) = (1 / z ^ 2) ^ (j + 1) * (z ^ 2) ^ (j + 1) := h2.symm
        _ ≤ (Real.exp (1 / z ^ 2) * ((j + 1).factorial : ℝ)) * (z ^ 2) ^ (j + 1) :=
            mul_le_mul_of_nonneg_right h1 (by positivity)
        _ = _ := by ring
    have h4 : (z ^ 2) ^ (j + 1) ≤ z ^ 2 * z ^ j := by
      calc (z ^ 2) ^ (j + 1) = z ^ 2 * z ^ j * z ^ j := by ring
        _ ≤ z ^ 2 * z ^ j * 1 := mul_le_mul_of_nonneg_left hzj (by positivity)
        _ = z ^ 2 * z ^ j := by ring
    have key : 1 ≤ ((j + 1).factorial : ℝ) * z ^ 2 * (z ^ j * Real.exp (1 / z ^ 2)) := by
      have := mul_le_mul_of_nonneg_left h4 (le_of_lt (mul_pos hA hEpos))
      nlinarith
    rw [hE, ← mul_inv, ← one_div, div_le_iff₀ (by positivity)]
    exact key

  have hFcont0 : ∀ j, ContinuousAt (F j) 0 := by
    intro j
    have h0 : F j 0 = 0 := by simp only [hF]; rw [if_pos le_rfl]
    rw [ContinuousAt, h0]
    apply squeeze_zero_norm' (a := fun z => ((j + 1).factorial : ℝ) * z ^ 2)
    · filter_upwards [Metric.ball_mem_nhds (0 : ℝ) one_pos] with z hz
      rw [Metric.mem_ball, Real.dist_eq, sub_zero] at hz
      simp only [hF]
      split_ifs with h
      · rw [norm_zero]; positivity
      · push_neg at h
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        exact hflat j z h (by linarith [le_abs_self z])
    · exact (continuous_const.mul (continuous_pow 2)).tendsto' 0 0 (by simp)

  have hpos : ∀ (k : ℕ) (y : ℝ), 0 < y →
      HasDerivAt (fun z : ℝ => (z ^ k)⁻¹ * Real.exp (-1 / z ^ 2))
        (-(k : ℝ) * ((y ^ (k + 1))⁻¹ * Real.exp (-1 / y ^ 2)) +
          2 * ((y ^ (k + 3))⁻¹ * Real.exp (-1 / y ^ 2))) y := by
    intro k y hy
    have hy0 : y ≠ 0 := hy.ne'
    have h1 : HasDerivAt (fun z : ℝ => (z ^ k)⁻¹) (-(k : ℝ) * (y ^ (k + 1))⁻¹) y := by
      have := (hasDerivAt_pow k y).inv (pow_ne_zero k hy0)
      convert this using 1
      rcases k with _ | m
      · simp
      · simp only [Nat.add_sub_cancel]
        field_simp
        ring
    have h2 : HasDerivAt (fun z : ℝ => -1 / z ^ 2) (2 / y ^ 3) y := by
      have := (hasDerivAt_const y (-1 : ℝ)).div (hasDerivAt_pow 2 y) (pow_ne_zero 2 hy0)
      convert this using 1
      field_simp
      ring
    have h3 := h1.mul h2.exp
    convert h3 using 1
    field_simp
    ring
  have hFd : ∀ (k : ℕ) (y : ℝ), HasDerivAt (F k) (-(k : ℝ) * F (k + 1) y + 2 * F (k + 3) y) y := by
    have hneg : ∀ (k : ℕ) (y : ℝ), y < 0 →
        HasDerivAt (F k) (-(k : ℝ) * F (k + 1) y + 2 * F (k + 3) y) y := by
      intro k y hy
      have hev : F k =ᶠ[nhds y] fun _ => (0 : ℝ) := by
        filter_upwards [Iio_mem_nhds hy] with z hz
        simp only [hF]
        rw [if_pos (le_of_lt hz)]
      have hv : -(k : ℝ) * F (k + 1) y + 2 * F (k + 3) y = 0 := by
        simp only [hF]
        rw [if_pos hy.le, if_pos hy.le]
        ring
      rw [hv]
      exact (hasDerivAt_const y (0 : ℝ)).congr_of_eventuallyEq hev
    have hposF : ∀ (k : ℕ) (y : ℝ), 0 < y →
        HasDerivAt (F k) (-(k : ℝ) * F (k + 1) y + 2 * F (k + 3) y) y := by
      intro k y hy
      have hev : F k =ᶠ[nhds y] fun z => (z ^ k)⁻¹ * Real.exp (-1 / z ^ 2) := by
        filter_upwards [Ioi_mem_nhds hy] with z hz
        simp only [hF]
        rw [if_neg (not_le.mpr (show (0 : ℝ) < z from hz))]
      have hv1 : F (k + 1) y = (y ^ (k + 1))⁻¹ * Real.exp (-1 / y ^ 2) := by
        simp only [hF]; rw [if_neg (not_le.mpr hy)]
      have hv3 : F (k + 3) y = (y ^ (k + 3))⁻¹ * Real.exp (-1 / y ^ 2) := by
        simp only [hF]; rw [if_neg (not_le.mpr hy)]
      rw [hv1, hv3]
      exact (hpos k y hy).congr_of_eventuallyEq hev
    intro k y
    rcases lt_trichotomy y 0 with hy | hy | hy
    · exact hneg k y hy
    · subst hy
      have hg : ContinuousAt (fun z => -(k : ℝ) * F (k + 1) z + 2 * F (k + 3) z) 0 :=
        (continuousAt_const.mul (hFcont0 (k + 1))).add (continuousAt_const.mul (hFcont0 (k + 3)))
      exact hasDerivAt_of_hasDerivAt_of_ne (f := F k)
        (g := fun z => -(k : ℝ) * F (k + 1) z + 2 * F (k + 3) z)
        (fun z hz => by
          rcases lt_or_gt_of_ne hz with h | h
          · exact hneg k z h
          · exact hposF k z h) (hFcont0 k) hg
    · exact hposF k y hy

  have hFsmooth : ∀ k, ContDiff ℝ ∞ (F k) := by
    have hdiff : ∀ k, Differentiable ℝ (F k) := fun k y => (hFd k y).differentiableAt
    have hderiv : ∀ k, deriv (F k) = fun y => -(k : ℝ) * F (k + 1) y + 2 * F (k + 3) y :=
      fun k => funext fun y => (hFd k y).deriv
    have hn : ∀ n : ℕ, ∀ k, ContDiff ℝ n (F k) := by
      intro n
      induction n with
      | zero => intro k; exact contDiff_zero.mpr (hdiff k).continuous
      | succ n ih =>
        intro k
        rw [Nat.cast_succ, contDiff_succ_iff_deriv]
        refine ⟨hdiff k, ?_, ?_⟩
        · intro h; exact absurd h (by simp)
        · rw [hderiv k]
          exact (contDiff_const.mul (ih (k + 1))).add (contDiff_const.mul (ih (k + 3)))
    intro k
    exact contDiff_infty.mpr (fun n => hn n k)

  have hsq : sqFlat = F 0 := by
    funext y; simp only [hF, sqFlat, pow_zero, inv_one, one_mul]
  have hsqD : sqFlatD = fun y => 2 * F 3 y := by
    funext y; simp only [hF, sqFlatD]; split_ifs <;> ring
  have hS : ContDiff ℝ ∞ sqFlat := by rw [hsq]; exact hFsmooth 0
  have hSD : ContDiff ℝ ∞ sqFlatD := by rw [hsqD]; exact contDiff_const.mul (hFsmooth 3)
  have hSd : ∀ y, HasDerivAt sqFlat (sqFlatD y) y := by
    intro y
    have := hFd 0 y
    rw [hsq, hsqD]
    convert this using 1
    simp
  have hsq_nn : ∀ y, 0 ≤ sqFlat y := by intro y; unfold sqFlat; split_ifs <;> positivity
  have hsq_le : ∀ y, sqFlat y ≤ 1 := by
    intro y; unfold sqFlat; split_ifs
    · norm_num
    · rw [Real.exp_le_one_iff, show (-1 : ℝ) / y ^ 2 = -(1 / y ^ 2) by ring]
      have : 0 ≤ 1 / y ^ 2 := by positivity
      linarith
  have hsqD_nn : ∀ y, 0 ≤ sqFlatD y := by
    intro y; unfold sqFlatD; split_ifs with h
    · exact le_rfl
    · push_neg at h
      exact mul_nonneg (div_nonneg (by norm_num) (pow_pos h 3).le) (Real.exp_pos _).le
  have hD : ∀ y, 0 < sqFlat y + sqFlat (1 - y) := by
    intro y
    by_cases hy : y ≤ 0
    · have : sqFlat (1 - y) = Real.exp (-1 / (1 - y) ^ 2) := by
        unfold sqFlat; rw [if_neg (not_le.mpr (by linarith))]
      linarith [hsq_nn y, Real.exp_pos (-1 / (1 - y) ^ 2)]
    · have : sqFlat y = Real.exp (-1 / y ^ 2) := by
        unfold sqFlat; rw [if_neg hy]
      linarith [hsq_nn (1 - y), Real.exp_pos (-1 / y ^ 2)]
  have hsig : ∀ y, sigA y = sqFlat y / (sqFlat y + sqFlat (1 - y)) := by
    intro y
    unfold sigA sqFlat
    by_cases h0 : y ≤ 0
    · simp only [if_pos h0, zero_div]
    · by_cases h1 : 1 ≤ y
      · have h2 : 1 - y ≤ 0 := by linarith
        simp only [if_neg h0, if_pos h1, if_pos h2, add_zero]
        rw [div_self (Real.exp_pos _).ne']
      · have h2 : ¬ (1 - y ≤ 0) := not_le.mpr (by linarith)
        simp only [if_neg h0, if_neg h1, if_neg h2]
  have hval : ∀ u : ℝ, 0 < u → sqFlat u = Real.exp (-1 / u ^ 2) ∧
      sqFlatD u = 2 / u ^ 3 * Real.exp (-1 / u ^ 2) := by
    intro u hu
    unfold sqFlat sqFlatD
    rw [if_neg (not_le.mpr hu), if_neg (not_le.mpr hu)]
    exact ⟨rfl, rfl⟩
  have hr : ContDiff ℝ ∞ (fun y : ℝ => 1 - y) := contDiff_const.sub contDiff_id
  have hS1 : ContDiff ℝ ∞ (fun y => sqFlat (1 - y)) := hS.comp hr
  have hSD1 : ContDiff ℝ ∞ (fun y => sqFlatD (1 - y)) := hSD.comp hr
  have hDc : ContDiff ℝ ∞ (fun y => sqFlat y + sqFlat (1 - y)) := hS.add hS1
  have hD0 : ∀ y, sqFlat y + sqFlat (1 - y) ≠ 0 := fun y => (hD y).ne'
  have hsigeq : sigA = fun y => sqFlat y / (sqFlat y + sqFlat (1 - y)) := funext hsig
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hsigeq]; exact hS.div hDc hD0
  · have e : collarG = fun u => (sqFlat u + sqFlat (1 - u))⁻¹ := rfl
    rw [e]; exact hDc.inv hD0
  · have e : collarGam = fun u => (2 * sqFlat (1 - u) + u ^ 3 * sqFlatD (1 - u)) /
        (sqFlat u + sqFlat (1 - u)) ^ 2 := rfl
    rw [e]
    exact ((contDiff_const.mul hS1).add ((contDiff_id.pow 3).mul hSD1)).div (hDc.pow 2)
      (fun u => pow_ne_zero 2 (hD0 u))
  · intro u hu
    have hd' : sqFlat (1 - u) + sqFlat u ≠ 0 := by rw [add_comm]; exact hD0 u
    have hd := hD0 u
    rw [hsig (1 - u), sub_sub_cancel]
    unfold collarG
    rw [← (hval u hu).1]
    field_simp
    ring
  · intro u hu
    have hN := hSd (1 - u)
    have hR : HasDerivAt (fun y => sqFlat (1 - y)) (sqFlatD (1 - (1 - u)) * (-1)) (1 - u) :=
      (hSd (1 - (1 - u))).comp (1 - u) ((hasDerivAt_id (1 - u)).const_sub 1)
    have hDd := hN.add hR
    have hQ := hN.div hDd (hD0 (1 - u))
    rw [hsigeq]
    convert hQ using 1
    unfold collarGam
    simp only [Pi.add_apply, sub_sub_cancel]
    rw [(hval u hu).1, (hval u hu).2]
    have hu0 : u ≠ 0 := hu.ne'
    set E := Real.exp (-1 / u ^ 2) with hE
    set s := sqFlat (1 - u)
    set s' := sqFlatD (1 - u)
    have h1 : E + s ≠ 0 := by
      have := hD0 u; rwa [(hval u hu).1] at this
    have h2 : s + E ≠ 0 := by rw [add_comm]; exact h1
    rw [add_comm s E]
    field_simp
    ring
  · intro u hu
    unfold collarGam
    apply div_nonneg
    · exact add_nonneg (mul_nonneg (by norm_num) (hsq_nn _))
        (mul_nonneg (pow_pos hu 3).le (hsqD_nn _))
    · positivity
  · intro u hu hu2
    have h1u : 0 < 1 - u := by linarith
    have hs : sqFlat (1 - u) = Real.exp (-1 / (1 - u) ^ 2) := by
      unfold sqFlat; rw [if_neg (not_le.mpr h1u)]
    have hsq4 : 1 / 4 ≤ (1 - u) ^ 2 := by nlinarith
    have hexp : Real.exp (-4) ≤ sqFlat (1 - u) := by
      rw [hs]
      apply Real.exp_le_exp.mpr
      rw [le_div_iff₀ (by positivity)]
      linarith
    have hDle : sqFlat u + sqFlat (1 - u) ≤ 2 := by linarith [hsq_le u, hsq_le (1 - u)]
    have hDpos := hD u
    have hD2 : (sqFlat u + sqFlat (1 - u)) ^ 2 ≤ 4 := by nlinarith
    have hnum : 2 * Real.exp (-4) ≤ 2 * sqFlat (1 - u) + u ^ 3 * sqFlatD (1 - u) := by
      have := mul_nonneg (pow_pos hu 3).le (hsqD_nn (1 - u)); linarith
    have he4 := Real.exp_pos (-4)
    unfold collarGam
    rw [le_div_iff₀ (pow_pos hDpos 2)]
    have := mul_le_mul_of_nonneg_left hD2 he4.le
    nlinarith

theorem flat_chart_comp_bound : ∀ ψ : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ ψ (univ ×ˢ Ioo (-1) 1) → (∀ m : ℕ, ∃ C : ℝ, ∀ p ∈ Ioo 0 (11 / 8) ×ˢ Ioo (-1) 1, ‖iteratedFDeriv ℝ m ψ p‖ ≤ C) → ∀ n : ℕ, ∃ A : ℝ, ∀ t : ℝ, 0 ≤ t → ∀ p ∈ Ioo 0 (11 / 8) ×ˢ Ioo (-1) 1, ‖iteratedFDeriv ℝ n (fun q : ℝ × ℝ => ψ (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) p‖ ≤ A * (1 + t) ^ n :=
by
  intro ψ hψ hb n
  have hle : ∀ i : ℕ, (i : WithTop ℕ∞) ≤ ∞ := fun i => by exact_mod_cast le_top

  obtain ⟨f, hfdef⟩ : ∃ f : ℝ → ℕ → ℕ → ℝ → ℝ,
      f = fun t a k x => x ^ a * ((Real.sqrt (1 + x ^ 2 * t)) ^ (2 * k + 1))⁻¹ := ⟨_, rfl⟩
  have hpos : ∀ t x : ℝ, 0 ≤ t → 1 ≤ 1 + x ^ 2 * t := fun t x ht => by
    nlinarith [mul_nonneg (sq_nonneg x) ht]
  have hsq1 : ∀ t x : ℝ, 0 ≤ t → 1 ≤ Real.sqrt (1 + x ^ 2 * t) := fun t x ht =>
    Real.one_le_sqrt.2 (hpos t x ht)
  have hsc : ∀ t : ℝ, 0 ≤ t → ContDiff ℝ ∞ (fun x : ℝ => Real.sqrt (1 + x ^ 2 * t)) := by
    intro t ht
    exact (contDiff_const.add ((contDiff_id.pow 2).mul contDiff_const)).sqrt
      (fun x => (lt_of_lt_of_le one_pos (hpos t x ht)).ne')
  have hfs : ∀ t : ℝ, 0 ≤ t → ∀ a k : ℕ, ContDiff ℝ ∞ (f t a k) := by
    intro t ht a k
    rw [hfdef]
    exact (contDiff_id.pow a).mul (((hsc t ht).pow (2 * k + 1)).inv
      (fun x => (pow_pos (lt_of_lt_of_le one_pos (hsq1 t x ht)) _).ne'))
  have hfd : ∀ t : ℝ, 0 ≤ t → ∀ (a k : ℕ) (x : ℝ), HasDerivAt (f t a k)
      ((a : ℝ) * f t (a - 1) k x - ((2 * k + 1 : ℝ) * t) * f t (a + 1) (k + 1) x) x := by
    intro t ht a k x
    have hs : 0 < Real.sqrt (1 + x ^ 2 * t) := lt_of_lt_of_le one_pos (hsq1 t x ht)
    have hs' : Real.sqrt (1 + x ^ 2 * t) ≠ 0 := hs.ne'
    have h1 : HasDerivAt (fun y : ℝ => 1 + y ^ 2 * t) (2 * x * t) x := by
      have := ((hasDerivAt_pow 2 x).mul_const t).const_add 1
      convert this using 1
      norm_num
    have h2 := (h1.sqrt (lt_of_lt_of_le one_pos (hpos t x ht)).ne').pow (2 * k + 1)
    have h3 := h2.inv (pow_ne_zero _ hs')
    have h4 := (hasDerivAt_pow a x).mul h3
    rw [hfdef]
    convert h4 using 1
    simp only [Pi.pow_apply, Pi.inv_apply, Nat.add_sub_cancel]
    push_cast
    field_simp
    ring
  have hderiv : ∀ t : ℝ, 0 ≤ t → ∀ a k : ℕ, deriv (f t a k) =
      fun x => (a : ℝ) * f t (a - 1) k x - ((2 * k + 1 : ℝ) * t) * f t (a + 1) (k + 1) x := by
    intro t ht a k
    funext x
    exact (hfd t ht a k x).deriv

  have hbd : ∀ j : ℕ, ∀ a k : ℕ, ∃ M : ℝ, ∀ t v : ℝ, 0 ≤ t → |v| ≤ 2 →
      |iteratedDeriv j (f t a k) v| ≤ M * (1 + t) ^ j := by
    intro j
    induction j with
    | zero =>
      intro a k
      refine ⟨2 ^ a, fun t v ht hv => ?_⟩
      rw [iteratedDeriv_zero, pow_zero, mul_one, hfdef]
      simp only []
      have hS := hsq1 t v ht
      have hP : 1 ≤ (Real.sqrt (1 + v ^ 2 * t)) ^ (2 * k + 1) := one_le_pow₀ hS
      have hI : 0 < ((Real.sqrt (1 + v ^ 2 * t)) ^ (2 * k + 1))⁻¹ := inv_pos.2 (by linarith)
      have hI1 : ((Real.sqrt (1 + v ^ 2 * t)) ^ (2 * k + 1))⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hP
      rw [abs_mul, abs_of_pos hI, abs_pow]
      calc |v| ^ a * ((Real.sqrt (1 + v ^ 2 * t)) ^ (2 * k + 1))⁻¹ ≤ 2 ^ a * 1 :=
            mul_le_mul (pow_le_pow_left₀ (abs_nonneg v) hv a) hI1 hI.le (by positivity)
        _ = 2 ^ a := mul_one _
    | succ j ih =>
      intro a k
      obtain ⟨M₁, h₁⟩ := ih (a - 1) k
      obtain ⟨M₂, h₂⟩ := ih (a + 1) (k + 1)
      refine ⟨(a : ℝ) * |M₁| + (2 * k + 1 : ℝ) * |M₂|, fun t v ht hv => ?_⟩
      rw [iteratedDeriv_succ', hderiv t ht a k]
      rw [iteratedDeriv_fun_sub ((contDiff_const.mul (hfs t ht (a - 1) k)).contDiffAt.of_le (hle j))
        ((contDiff_const.mul (hfs t ht (a + 1) (k + 1))).contDiffAt.of_le (hle j))]
      rw [iteratedDeriv_const_mul_field, iteratedDeriv_const_mul_field]
      have ha := h₁ t v ht hv
      have hb := h₂ t v ht hv
      have hT : 0 ≤ (1 + t) ^ j := by positivity
      have hs : (1 + t) ^ (j + 1) = (1 + t) ^ j * (1 + t) := pow_succ _ _
      set X := iteratedDeriv j (f t (a - 1) k) v
      set Y := iteratedDeriv j (f t (a + 1) (k + 1)) v
      have hX : |X| ≤ |M₁| * (1 + t) ^ j :=
        ha.trans (mul_le_mul_of_nonneg_right (le_abs_self _) hT)
      have hY : |Y| ≤ |M₂| * (1 + t) ^ j :=
        hb.trans (mul_le_mul_of_nonneg_right (le_abs_self _) hT)
      have hk : (0 : ℝ) ≤ 2 * k + 1 := by positivity
      have ha0 : (0 : ℝ) ≤ a := Nat.cast_nonneg a
      calc |(a : ℝ) * X - (2 * k + 1 : ℝ) * t * Y|
          ≤ |(a : ℝ) * X| + |(2 * k + 1 : ℝ) * t * Y| := abs_sub _ _
        _ = (a : ℝ) * |X| + (2 * k + 1 : ℝ) * t * |Y| := by
            rw [abs_mul, abs_mul, abs_mul, abs_of_nonneg ha0, abs_of_nonneg hk, abs_of_nonneg ht]
        _ ≤ (a : ℝ) * (|M₁| * (1 + t) ^ j) + (2 * k + 1 : ℝ) * t * (|M₂| * (1 + t) ^ j) := by
            gcongr
        _ ≤ ((a : ℝ) * |M₁| + (2 * k + 1 : ℝ) * |M₂|) * (1 + t) ^ (j + 1) := by
            rw [hs]
            nlinarith [mul_nonneg (mul_nonneg (mul_nonneg ha0 (abs_nonneg M₁)) hT) ht,
              mul_nonneg (mul_nonneg hk (abs_nonneg M₂)) hT]

  have hw : ∀ t : ℝ, 0 ≤ t → (fun x : ℝ => x / Real.sqrt (1 + x ^ 2 * t)) = f t 1 0 := by
    intro t ht
    funext x
    rw [hfdef]
    simp [div_eq_mul_inv]
  have hΦb : ∀ i : ℕ, ∃ M : ℝ, ∀ t : ℝ, 0 ≤ t → ∀ p : ℝ × ℝ, |p.1| ≤ 2 → 1 ≤ i →
      ‖iteratedFDeriv ℝ i (fun q : ℝ × ℝ => (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) p‖ ≤
        M * (1 + t) ^ i := by
    intro i
    obtain ⟨M₀, hM₀⟩ := hbd i 1 0
    refine ⟨|M₀| + 1, fun t ht p hp hi => ?_⟩
    have hwc : ContDiff ℝ ∞ (fun x : ℝ => x / Real.sqrt (1 + x ^ 2 * t)) := by
      rw [hw t ht]; exact hfs t ht 1 0
    have h1 : ContDiffAt ℝ ∞ (fun q : ℝ × ℝ => q.1 / Real.sqrt (1 + q.1 ^ 2 * t)) p :=
      (hwc.comp contDiff_fst).contDiffAt
    have h2 : ContDiffAt ℝ ∞ (fun q : ℝ × ℝ => q.2) p := contDiff_snd.contDiffAt
    rw [iteratedFDeriv_prodMk h1 h2 (hle i), ContinuousMultilinearMap.opNorm_prod]
    have hT1 : 1 ≤ (1 + t) ^ i := one_le_pow₀ (by linarith)
    have hT : 0 ≤ (1 + t) ^ i := by positivity
    apply max_le
    · have e : (fun q : ℝ × ℝ => q.1 / Real.sqrt (1 + q.1 ^ 2 * t)) =
          (fun x : ℝ => x / Real.sqrt (1 + x ^ 2 * t)) ∘ ⇑(ContinuousLinearMap.fst ℝ ℝ ℝ) := rfl
      rw [e, ContinuousLinearMap.iteratedFDeriv_comp_right _ hwc p (hle i)]
      refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
      have hprod : ∏ _i : Fin i, ‖ContinuousLinearMap.fst ℝ ℝ ℝ‖ ≤ 1 := by
        rw [Finset.prod_const]
        exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_fst_le ℝ ℝ ℝ)
      calc _ ≤ ‖iteratedFDeriv ℝ i (fun x : ℝ => x / Real.sqrt (1 + x ^ 2 * t))
              ((ContinuousLinearMap.fst ℝ ℝ ℝ) p)‖ * 1 :=
            mul_le_mul_of_nonneg_left hprod (norm_nonneg _)
        _ = |iteratedDeriv i (f t 1 0) ((ContinuousLinearMap.fst ℝ ℝ ℝ) p)| := by
            rw [mul_one, norm_iteratedFDeriv_eq_norm_iteratedDeriv, hw t ht, Real.norm_eq_abs]
        _ ≤ M₀ * (1 + t) ^ i := hM₀ t p.1 ht hp
        _ ≤ (|M₀| + 1) * (1 + t) ^ i :=
            mul_le_mul_of_nonneg_right (by linarith [le_abs_self M₀]) hT
    · have e : (fun q : ℝ × ℝ => q.2) = (id : ℝ → ℝ) ∘ ⇑(ContinuousLinearMap.snd ℝ ℝ ℝ) := rfl
      rw [e, ContinuousLinearMap.iteratedFDeriv_comp_right _ contDiff_id p (hle i)]
      refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
      have hprod : ∏ _i : Fin i, ‖ContinuousLinearMap.snd ℝ ℝ ℝ‖ ≤ 1 := by
        rw [Finset.prod_const]
        exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_snd_le ℝ ℝ ℝ)
      have hid : ‖iteratedFDeriv ℝ i (id : ℝ → ℝ) ((ContinuousLinearMap.snd ℝ ℝ ℝ) p)‖ ≤ 1 := by
        rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_id, if_neg (show i ≠ 0 by omega)]
        split_ifs <;> simp
      calc _ ≤ 1 * 1 := mul_le_mul hid hprod (by positivity) zero_le_one
        _ ≤ (|M₀| + 1) * (1 + t) ^ i := by nlinarith [abs_nonneg M₀]

  choose Cψ hCψ using hb
  choose Mc hMc using hΦb
  set Ωu : Set (ℝ × ℝ) := Ioo 0 (11 / 8) ×ˢ Ioo (-1) 1 with hΩu
  have hΩuo : IsOpen Ωu := isOpen_Ioo.prod isOpen_Ioo
  set C := ∑ i ∈ Finset.range (n + 1), |Cψ i| with hC
  set K := 1 + ∑ i ∈ Finset.range (n + 1), |Mc i| with hK
  have hK1 : 1 ≤ K := by
    have := Finset.sum_nonneg (fun i (_ : i ∈ Finset.range (n + 1)) => abs_nonneg (Mc i))
    linarith
  refine ⟨(n.factorial : ℝ) * C * K ^ n, fun t ht p hp => ?_⟩
  have hpos' : ∀ q : ℝ × ℝ, 0 < 1 + q.1 ^ 2 * t := fun q =>
    lt_of_lt_of_le one_pos (hpos t q.1 ht)
  have hΦ : ContDiff ℝ ∞ (fun q : ℝ × ℝ => (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) := by
    refine ContDiff.prodMk ?_ contDiff_snd
    refine contDiff_fst.div ((contDiff_const.add ((contDiff_fst.pow 2).mul contDiff_const)).sqrt
      (fun q => (hpos' q).ne')) ?_
    intro q
    exact (Real.sqrt_pos.2 (hpos' q)).ne'
  have hmaps : MapsTo (fun q : ℝ × ℝ => (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) Ωu Ωu := by
    intro q hq
    have h1 : 0 < q.1 := hq.1.1
    have h2 : q.1 < 11 / 8 := hq.1.2
    have hs := hsq1 t q.1 ht
    exact ⟨⟨div_pos h1 (by linarith), lt_of_le_of_lt (div_le_self h1.le hs) h2⟩, hq.2⟩
  have hψΩ : ContDiffOn ℝ ∞ ψ Ωu := hψ.mono (fun q hq => ⟨mem_univ _, hq.2⟩)
  have hΦp : (fun q : ℝ × ℝ => (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) p ∈ Ωu := hmaps hp
  have hFdB := norm_iteratedFDerivWithin_comp_le hψΩ hΦ.contDiffOn (hle n) hΩuo.uniqueDiffOn
    hΩuo.uniqueDiffOn hmaps hp (C := C) (D := K * (1 + t))
    (fun i hi => by
      rw [iteratedFDerivWithin_of_isOpen i hΩuo hΦp]
      refine (hCψ i _ hΦp).trans ((le_abs_self _).trans ?_)
      exact Finset.single_le_sum (f := fun i => |Cψ i|) (fun _ _ => abs_nonneg _)
        (Finset.mem_range.2 (by omega)))
    (fun i hi1 hin => by
      rw [iteratedFDerivWithin_of_isOpen i hΩuo hp]
      have hp1 : |p.1| ≤ 2 := by
        rw [abs_of_pos hp.1.1]; linarith [hp.1.2]
      refine (hMc i t ht p hp1 hi1).trans ?_
      have hMK : Mc i ≤ K := by
        have := Finset.single_le_sum (f := fun i => |Mc i|) (fun _ _ => abs_nonneg _)
          (Finset.mem_range.2 (show i < n + 1 by omega))
        linarith [le_abs_self (Mc i)]
      have hKi : K ≤ K ^ i := le_self_pow₀ hK1 (by omega)
      rw [mul_pow]
      exact mul_le_mul_of_nonneg_right (hMK.trans hKi) (by positivity))
  rw [iteratedFDerivWithin_of_isOpen n hΩuo hp] at hFdB
  have e : (fun q : ℝ × ℝ => ψ (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) =
      ψ ∘ (fun q : ℝ × ℝ => (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) := rfl
  rw [e]
  refine hFdB.trans (le_of_eq ?_)
  rw [mul_pow]
  ring

theorem param_integral_contDiffOn : ∀ (U : Set (ℝ × ℝ)) (G : ℝ × ℝ → ℝ → ℝ), IsOpen U → (∀ t : ℝ, 0 < t → ContDiffOn ℝ ∞ (fun q => G q t) U) → (∀ n : ℕ, ∀ p ∈ U, ContinuousOn (fun t => iteratedFDeriv ℝ n (fun q => G q t) p) (Ioi 0)) → (∀ n : ℕ, ∃ b : ℝ → ℝ, IntegrableOn b (Ioi 0) ∧ ∀ t : ℝ, 0 < t → ∀ p ∈ U, ‖iteratedFDeriv ℝ n (fun q => G q t) p‖ ≤ b t) → ContDiffOn ℝ ∞ (fun p => ∫ t in Ioi (0:ℝ), G p t) U ∧ (∀ n : ℕ, ∃ C : ℝ, ∀ p ∈ U, ‖iteratedFDeriv ℝ n (fun p => ∫ t in Ioi (0:ℝ), G p t) p‖ ≤ C) ∧ ∀ p ∈ U, IntegrableOn (G p) (Ioi 0) :=
by
  intro U G hU h1 h2 h3
  choose b hbI hb using h3
  have hcl : ∀ m : ℕ, ∀ g : ContinuousMultilinearMap ℝ (fun _ : Fin (m + 1) => ℝ × ℝ) ℝ,
      continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (m + 1) => ℝ × ℝ) ℝ g = g.curryLeft := by
    intro m g
    refine ContinuousLinearMap.ext (fun v => ContinuousMultilinearMap.ext (fun w => ?_))
    rw [continuousMultilinearCurryLeftEquiv_apply, ContinuousMultilinearMap.curryLeft_apply]
  have hInt : ∀ n : ℕ, ∀ p ∈ U,
      IntegrableOn (fun t => iteratedFDeriv ℝ n (fun q => G q t) p) (Ioi 0) := by
    intro n p hp
    refine Integrable.mono' (hbI n) ((h2 n p hp).aestronglyMeasurable measurableSet_Ioi) ?_
    exact (ae_restrict_iff' measurableSet_Ioi).2
      (Filter.Eventually.of_forall (fun t ht => hb n t ht p hp))
  have hGint : ∀ p ∈ U, IntegrableOn (G p) (Ioi 0) := by
    intro p hp
    have hc : ContinuousOn (G p) (Ioi 0) := by
      have := (continuousMultilinearCurryFin0 ℝ (ℝ × ℝ) ℝ).continuous.comp_continuousOn (h2 0 p hp)
      refine this.congr (fun t _ => ?_)
      simp only [Function.comp_apply, continuousMultilinearCurryFin0_apply, iteratedFDeriv_zero_apply]
    refine Integrable.mono' (hbI 0) (hc.aestronglyMeasurable measurableSet_Ioi) ?_
    refine (ae_restrict_iff' measurableSet_Ioi).2 (Filter.Eventually.of_forall (fun t ht => ?_))
    have := hb 0 t ht p hp
    rwa [norm_iteratedFDeriv_zero] at this
  have hder : ∀ m : ℕ, ∀ t : ℝ, 0 < t → ∀ x ∈ U, HasFDerivAt (iteratedFDeriv ℝ m (fun q => G q t))
      ((iteratedFDeriv ℝ (m + 1) (fun q => G q t) x).curryLeft) x := by
    intro m t ht x hx
    have hca : ContDiffAt ℝ ∞ (fun q => G q t) x := (h1 t ht).contDiffAt (hU.mem_nhds hx)
    have hd := hca.differentiableAt_iteratedFDeriv (m := m)
      (WithTop.coe_lt_coe.2 (ENat.natCast_lt_top m))
    have := hd.hasFDerivAt
    rw [fderiv_iteratedFDeriv, Function.comp_apply, hcl] at this
    exact this
  have hstep : ∀ m : ℕ, ∀ x₀ ∈ U,
      HasFDerivAt (fun x => ∫ t in Ioi (0:ℝ), iteratedFDeriv ℝ m (fun q => G q t) x)
        ((∫ t in Ioi (0:ℝ), iteratedFDeriv ℝ (m + 1) (fun q => G q t) x₀).curryLeft) x₀ := by
    intro m x₀ hx₀
    have hmeas : AEStronglyMeasurable
        (fun t => (iteratedFDeriv ℝ (m + 1) (fun q => G q t) x₀).curryLeft)
        (volume.restrict (Ioi (0:ℝ))) := by
      have := (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (m + 1) => ℝ × ℝ) ℝ).continuous.comp_aestronglyMeasurable
        (hInt (m + 1) x₀ hx₀).aestronglyMeasurable
      refine this.congr (Filter.Eventually.of_forall (fun t => ?_))
      simp only [hcl]
    have key := hasFDerivAt_integral_of_dominated_of_fderiv_le
      (μ := volume.restrict (Ioi (0:ℝ)))
      (F := fun x t => iteratedFDeriv ℝ m (fun q => G q t) x)
      (F' := fun x t => (iteratedFDeriv ℝ (m + 1) (fun q => G q t) x).curryLeft)
      (bound := b (m + 1)) (hU.mem_nhds hx₀)
      (Filter.eventually_of_mem (hU.mem_nhds hx₀) (fun x hx => (hInt m x hx).aestronglyMeasurable))
      (hInt m x₀ hx₀) hmeas ?_ (hbI (m + 1)) ?_
    · have hcomm : ∫ t in Ioi (0:ℝ), (iteratedFDeriv ℝ (m + 1) (fun q => G q t) x₀).curryLeft =
          (∫ t in Ioi (0:ℝ), iteratedFDeriv ℝ (m + 1) (fun q => G q t) x₀).curryLeft := by
        have := ContinuousLinearEquiv.integral_comp_comm (𝕜 := ℝ)
          (E := ContinuousMultilinearMap ℝ (fun _ : Fin (m + 1) => ℝ × ℝ) ℝ)
          (F := (ℝ × ℝ) →L[ℝ] ContinuousMultilinearMap ℝ (fun _ : Fin m => ℝ × ℝ) ℝ)
          (μ := volume.restrict (Ioi (0:ℝ)))
          (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (m + 1) => ℝ × ℝ) ℝ).toContinuousLinearEquiv
          (fun t => iteratedFDeriv ℝ (m + 1) (fun q => G q t) x₀)
        simpa only [LinearIsometryEquiv.coe_toContinuousLinearEquiv, hcl] using this
      rw [hcomm] at key
      exact key
    · refine (ae_restrict_iff' measurableSet_Ioi).2 (Filter.Eventually.of_forall (fun t ht x hx => ?_))
      rw [ContinuousMultilinearMap.curryLeft_norm]
      exact hb (m + 1) t ht x hx
    · exact (ae_restrict_iff' measurableSet_Ioi).2
        (Filter.Eventually.of_forall (fun t ht x hx => hder m t ht x hx))
  have hT : HasFTaylorSeriesUpToOn ∞ (fun p => ∫ t in Ioi (0:ℝ), G p t)
      (fun x m => ∫ t in Ioi (0:ℝ), iteratedFDeriv ℝ m (fun q => G q t) x) U := by
    refine HasFTaylorSeriesUpToOn.mk ?_ ?_ ?_
    · intro x hx
      rw [ContinuousMultilinearMap.curry0_apply, ContinuousMultilinearMap.integral_apply (hInt 0 x hx)]
      simp only [iteratedFDeriv_zero_apply]
    · intro m _ x hx
      exact (hstep m x hx).hasFDerivWithinAt
    · intro m _ x hx
      exact (hstep m x hx).continuousAt.continuousWithinAt
  refine ⟨hT.contDiffOn, ?_, hGint⟩
  intro n
  refine ⟨∫ t in Ioi (0:ℝ), b n t, fun p hp => ?_⟩
  rw [← iteratedFDerivWithin_of_isOpen n hU hp,
    ← hT.eq_iteratedFDerivWithin_of_uniqueDiffOn (WithTop.coe_le_coe.2 le_top) hU.uniqueDiffOn hp]
  exact norm_integral_le_of_norm_le (hbI n)
    ((ae_restrict_iff' measurableSet_Ioi).2 (Filter.Eventually.of_forall fun t ht => hb n t ht p hp))

theorem param_partial_iteratedFDeriv_contDiffOn : ∀ (H : (ℝ × ℝ) × ℝ → ℝ) (W : Set ((ℝ × ℝ) × ℝ)), IsOpen W → ContDiffOn ℝ ∞ H W → ∀ n : ℕ, ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ) × ℝ => iteratedFDeriv ℝ n (fun q : ℝ × ℝ => H (q, z.2)) z.1) W :=
by
  intro H W hW hH n
  induction n with
  | zero =>
    have e : (fun z : (ℝ × ℝ) × ℝ => iteratedFDeriv ℝ 0 (fun q : ℝ × ℝ => H (q, z.2)) z.1) =
        ⇑(continuousMultilinearCurryFin0 ℝ (ℝ × ℝ) ℝ).symm ∘ H := by
      funext z
      rw [iteratedFDeriv_zero_eq_comp]
      rfl
    rw [e]
    exact (continuousMultilinearCurryFin0 ℝ (ℝ × ℝ) ℝ).symm.contDiff.comp_contDiffOn hH
  | succ n ih =>
    set K := fun z : (ℝ × ℝ) × ℝ => iteratedFDeriv ℝ n (fun q : ℝ × ℝ => H (q, z.2)) z.1 with hK
    have e : (fun z : (ℝ × ℝ) × ℝ => iteratedFDeriv ℝ (n + 1) (fun q : ℝ × ℝ => H (q, z.2)) z.1) =
        fun z => (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (n + 1) => ℝ × ℝ) ℝ).symm
          (fderiv ℝ (fun q => K (q, z.2)) z.1) := by
      funext z
      rw [iteratedFDeriv_succ_eq_comp_left]
      rfl
    rw [e]
    refine (hW.contDiffOn_iff).2 fun z0 hz0 => ?_
    have hKat : ContDiffAt ℝ ∞ K z0 := ih.contDiffAt (hW.mem_nhds hz0)
    have hφ : ContDiff ℝ ∞
        (fun y : ((ℝ × ℝ) × ℝ) × (ℝ × ℝ) => ((y.2, y.1.2) : (ℝ × ℝ) × ℝ)) := by
      fun_prop
    have hU : ContDiffAt ℝ ∞
        (Function.uncurry fun (z : (ℝ × ℝ) × ℝ) (q : ℝ × ℝ) => K (q, z.2)) (z0, z0.1) := by
      have h2 : ContDiffAt ℝ ∞ K ((fun y : ((ℝ × ℝ) × ℝ) × (ℝ × ℝ) =>
          ((y.2, y.1.2) : (ℝ × ℝ) × ℝ)) (z0, z0.1)) := hKat
      exact h2.comp (z0, z0.1) hφ.contDiffAt
    have hF := ContDiffAt.fderiv (f := fun (z : (ℝ × ℝ) × ℝ) (q : ℝ × ℝ) => K (q, z.2))
      (g := Prod.fst) (m := ∞) (n := ∞) hU contDiff_fst.contDiffAt
      (le_of_eq ENat.coe_top_add_one)
    exact (LinearIsometryEquiv.contDiff _).comp_contDiffAt z0 hF

theorem flat_param_integral_smooth : ∀ ψ : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ ψ (univ ×ˢ Ioo (-1) 1) → (∀ m : ℕ, ∃ C : ℝ, ∀ p ∈ Ioo 0 (11 / 8) ×ˢ Ioo (-1) 1, ‖iteratedFDeriv ℝ m ψ p‖ ≤ C) → collarGood (collarFlatInt ψ) ∧ ∀ p ∈ Ioo 0 (11 / 8) ×ˢ Ioo (-1) 1, IntegrableOn (fun t => Real.exp (-t) * ψ (p.1 / Real.sqrt (1 + p.1 ^ 2 * t), p.2)) (Ioi 0) :=
by
  intro ψ hψ hb
  have hUo : IsOpen (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1 : ℝ) 1) := isOpen_Ioo.prod isOpen_Ioo

  have hΦ : ∀ t : ℝ, 0 ≤ t →
      ContDiff ℝ ∞ (fun q : ℝ × ℝ => (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) := by
    intro t ht
    have hpos : ∀ q : ℝ × ℝ, 0 < 1 + q.1 ^ 2 * t := fun q => by
      have := mul_nonneg (sq_nonneg q.1) ht
      linarith
    refine ContDiff.prodMk ?_ contDiff_snd
    refine contDiff_fst.div ((contDiff_const.add ((contDiff_fst.pow 2).mul contDiff_const)).sqrt
      (fun q => (hpos q).ne')) ?_
    intro q
    exact (Real.sqrt_pos.2 (hpos q)).ne'
  have hcomp : ∀ t : ℝ, 0 ≤ t → ContDiffOn ℝ ∞
      (fun q : ℝ × ℝ => ψ (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2))
      (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1 : ℝ) 1) :=
    fun t ht => hψ.comp (hΦ t ht).contDiffOn (fun q hq => ⟨mem_univ _, hq.2⟩)

  have h1 : ∀ t : ℝ, 0 < t → ContDiffOn ℝ ∞
      (fun q : ℝ × ℝ => Real.exp (-t) * ψ (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2))
      (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1 : ℝ) 1) :=
    fun t ht => contDiffOn_const.mul (hcomp t ht.le)

  have hWo : IsOpen {z : (ℝ × ℝ) × ℝ | 0 < 1 + z.1.1 ^ 2 * z.2 ∧ -1 < z.1.2 ∧ z.1.2 < 1} := by
    have c1 : Continuous (fun z : (ℝ × ℝ) × ℝ => 1 + z.1.1 ^ 2 * z.2) := by fun_prop
    have c2 : Continuous (fun z : (ℝ × ℝ) × ℝ => z.1.2) := by fun_prop
    exact (isOpen_lt continuous_const c1).inter
      ((isOpen_lt continuous_const c2).inter (isOpen_lt c2 continuous_const))
  have hH : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ) × ℝ =>
      Real.exp (-z.2) * ψ (z.1.1 / Real.sqrt (1 + z.1.1 ^ 2 * z.2), z.1.2))
      {z : (ℝ × ℝ) × ℝ | 0 < 1 + z.1.1 ^ 2 * z.2 ∧ -1 < z.1.2 ∧ z.1.2 < 1} := by
    have hs : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ) × ℝ => Real.sqrt (1 + z.1.1 ^ 2 * z.2))
        {z : (ℝ × ℝ) × ℝ | 0 < 1 + z.1.1 ^ 2 * z.2 ∧ -1 < z.1.2 ∧ z.1.2 < 1} :=
      ContDiffOn.sqrt (by fun_prop : ContDiff ℝ ∞
        (fun z : (ℝ × ℝ) × ℝ => 1 + z.1.1 ^ 2 * z.2)).contDiffOn (fun z hz => hz.1.ne')
    have hin : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ) × ℝ =>
        (z.1.1 / Real.sqrt (1 + z.1.1 ^ 2 * z.2), z.1.2))
        {z : (ℝ × ℝ) × ℝ | 0 < 1 + z.1.1 ^ 2 * z.2 ∧ -1 < z.1.2 ∧ z.1.2 < 1} := by
      refine ContDiffOn.prodMk ?_
        (by fun_prop : ContDiff ℝ ∞ (fun z : (ℝ × ℝ) × ℝ => z.1.2)).contDiffOn
      exact (by fun_prop : ContDiff ℝ ∞ (fun z : (ℝ × ℝ) × ℝ => z.1.1)).contDiffOn.div hs
        (fun z hz => (Real.sqrt_pos.2 hz.1).ne')
    have hψc : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ) × ℝ =>
        ψ (z.1.1 / Real.sqrt (1 + z.1.1 ^ 2 * z.2), z.1.2))
        {z : (ℝ × ℝ) × ℝ | 0 < 1 + z.1.1 ^ 2 * z.2 ∧ -1 < z.1.2 ∧ z.1.2 < 1} :=
      hψ.comp hin (fun z hz => ⟨mem_univ _, hz.2.1, hz.2.2⟩)
    exact (by fun_prop : ContDiff ℝ ∞ (fun z : (ℝ × ℝ) × ℝ => Real.exp (-z.2))).contDiffOn.mul hψc
  have h2 : ∀ n : ℕ, ∀ p ∈ Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1 : ℝ) 1, ContinuousOn
      (fun t => iteratedFDeriv ℝ n
        (fun q : ℝ × ℝ => Real.exp (-t) * ψ (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) p) (Ioi 0) := by
    intro n p hp
    have hK := (param_partial_iteratedFDeriv_contDiffOn _ _ hWo hH n).continuousOn
    have hmap : MapsTo (fun t : ℝ => ((p, t) : (ℝ × ℝ) × ℝ)) (Ioi 0)
        {z : (ℝ × ℝ) × ℝ | 0 < 1 + z.1.1 ^ 2 * z.2 ∧ -1 < z.1.2 ∧ z.1.2 < 1} := by
      intro t ht
      have ht0 : (0:ℝ) < t := ht
      have := mul_nonneg (sq_nonneg p.1) ht0.le
      exact ⟨by linarith, hp.2.1, hp.2.2⟩
    exact hK.comp (Continuous.continuousOn (by fun_prop)) hmap

  have h3 : ∀ n : ℕ, ∃ b : ℝ → ℝ, IntegrableOn b (Ioi 0) ∧ ∀ t : ℝ, 0 < t →
      ∀ p ∈ Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1 : ℝ) 1, ‖iteratedFDeriv ℝ n
        (fun q : ℝ × ℝ => Real.exp (-t) * ψ (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) p‖ ≤ b t := by
    intro n
    obtain ⟨A, hA⟩ := flat_chart_comp_bound ψ hψ hb n
    refine ⟨fun t => A * ((1 + t) ^ n * Real.exp (-t)), ?_, ?_⟩
    · have hmaj : IntegrableOn (fun t : ℝ => (|A| * 2 ^ n * (n.factorial : ℝ) * Real.exp (1 / 2)) *
          Real.exp (-(1 / 2) * t)) (Ioi 0) :=
        (exp_neg_integrableOn_Ioi 0 (by norm_num : (0:ℝ) < 1 / 2)).const_mul _
      refine hmaj.mono' ?_ ?_
      · exact (by fun_prop : Continuous (fun t : ℝ => A * ((1 + t) ^ n * Real.exp (-t)))).aestronglyMeasurable
      · refine (ae_restrict_iff' measurableSet_Ioi).2 (Filter.Eventually.of_forall ?_)
        intro t ht
        have ht0 : (0:ℝ) < t := ht
        have hx := Real.pow_div_factorial_le_exp ((1 + t) / 2) (by linarith) n
        have hf : (0:ℝ) < (n.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos n
        have h2n : (0:ℝ) < 2 ^ n := by positivity
        rw [div_pow, div_le_iff₀ hf, div_le_iff₀ h2n] at hx
        have hE : Real.exp ((1 + t) / 2) * Real.exp (-t) =
            Real.exp (1 / 2) * Real.exp (-(1 / 2) * t) := by
          rw [← Real.exp_add, ← Real.exp_add]
          congr 1
          ring
        have hp0 : 0 ≤ (1 + t) ^ n * Real.exp (-t) := by positivity
        rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hp0]
        calc |A| * ((1 + t) ^ n * Real.exp (-t))
            ≤ |A| * ((Real.exp ((1 + t) / 2) * (n.factorial : ℝ) * 2 ^ n) * Real.exp (-t)) := by
              gcongr
          _ = |A| * 2 ^ n * (n.factorial : ℝ) * (Real.exp ((1 + t) / 2) * Real.exp (-t)) := by ring
          _ = |A| * 2 ^ n * (n.factorial : ℝ) * Real.exp (1 / 2) * Real.exp (-(1 / 2) * t) := by
              rw [hE]; ring
    · intro t ht p hp
      have hfun : (fun q : ℝ × ℝ => Real.exp (-t) * ψ (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) =
          Real.exp (-t) • (fun q : ℝ × ℝ => ψ (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) := by
        funext q
        simp only [Pi.smul_apply, smul_eq_mul]
      have hca : ContDiffAt ℝ (n : ℕ∞ω)
          (fun q : ℝ × ℝ => ψ (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) p :=
        ((hcomp t ht.le).contDiffAt (hUo.mem_nhds hp)).of_le (by exact_mod_cast le_top)
      rw [hfun, iteratedFDeriv_const_smul_apply hca, norm_smul, Real.norm_eq_abs,
        abs_of_pos (Real.exp_pos _)]
      calc Real.exp (-t) * ‖iteratedFDeriv ℝ n
            (fun q : ℝ × ℝ => ψ (q.1 / Real.sqrt (1 + q.1 ^ 2 * t), q.2)) p‖
          ≤ Real.exp (-t) * (A * (1 + t) ^ n) :=
            mul_le_mul_of_nonneg_left (hA t ht.le p hp) (Real.exp_pos _).le
        _ = A * ((1 + t) ^ n * Real.exp (-t)) := by ring
  obtain ⟨hs, hbd, hint⟩ := param_integral_contDiffOn _
    (fun p t => Real.exp (-t) * ψ (p.1 / Real.sqrt (1 + p.1 ^ 2 * t), p.2)) hUo h1 h2 h3
  refine ⟨?_, hint⟩
  unfold collarGood collarFlatInt
  exact ⟨hs, hbd⟩

theorem collarGood_algebra : (∀ f g : ℝ × ℝ → ℝ, collarGood f → collarGood g → collarGood (fun p => f p * g p)) ∧ (∀ f g : ℝ × ℝ → ℝ, collarGood f → collarGood g → collarGood (fun p => f p + g p)) ∧ (∀ f g : ℝ × ℝ → ℝ, collarGood f → collarGood g → collarGood (fun p => f p - g p)) ∧ (∀ (f : ℝ × ℝ → ℝ) (c : ℝ), collarGood f → 0 < c → (∀ p ∈ Ioo 0 (11 / 8) ×ˢ Ioo (-1) 1, c ≤ f p) → collarGood (fun p => (f p)⁻¹)) ∧ (∀ φ : ℝ × ℝ → ℝ, ContDiff ℝ ∞ φ → collarGood φ) :=
by
  have hΩo : IsOpen (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioo.prod isOpen_Ioo
  have hΩu : UniqueDiffOn ℝ (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1) := hΩo.uniqueDiffOn
  have hW : ∀ (F : ℝ × ℝ → ℝ) (n : ℕ) (x : ℝ × ℝ), x ∈ Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1 →
      iteratedFDerivWithin ℝ n F (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1) x = iteratedFDeriv ℝ n F x :=
    fun F n x hx => iteratedFDerivWithin_of_isOpen n hΩo hx
  have hN : ∀ n : ℕ, ((n : ℕ∞ω)) ≤ ∞ := fun n => by exact_mod_cast le_top
  have hAt : ∀ (F : ℝ × ℝ → ℝ), ContDiffOn ℝ ∞ F (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1) →
      ∀ (n : ℕ) (x : ℝ × ℝ), x ∈ Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1 → ContDiffAt ℝ n F x :=
    fun F hF n x hx => (hF.contDiffAt (hΩo.mem_nhds hx)).of_le (hN n)

  have hmul : ∀ f g : ℝ × ℝ → ℝ, collarGood f → collarGood g → collarGood (fun p => f p * g p) := by
    intro f g hf hg
    refine ⟨hf.1.mul hg.1, fun n => ?_⟩
    choose A hA using hf.2
    choose B hB using hg.2
    refine ⟨∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * A i * B (n - i), fun p hp => ?_⟩
    rw [← hW _ n p hp]
    refine (norm_iteratedFDerivWithin_mul_le hf.1 hg.1 hΩu hp (hN n)).trans ?_
    apply Finset.sum_le_sum
    intro i _
    rw [hW _ i p hp, hW _ (n - i) p hp]
    have h1 := hA i p hp
    have h2 := hB (n - i) p hp
    have h0 : 0 ≤ ‖iteratedFDeriv ℝ i f p‖ := norm_nonneg _
    have h0' : 0 ≤ ‖iteratedFDeriv ℝ (n - i) g p‖ := norm_nonneg _
    have hc : (0:ℝ) ≤ n.choose i := Nat.cast_nonneg _
    exact mul_le_mul (mul_le_mul_of_nonneg_left h1 hc) h2 h0' (mul_nonneg hc (h0.trans h1))

  have hadd : ∀ f g : ℝ × ℝ → ℝ, collarGood f → collarGood g → collarGood (fun p => f p + g p) := by
    intro f g hf hg
    refine ⟨hf.1.add hg.1, fun n => ?_⟩
    obtain ⟨Cf, hCf⟩ := hf.2 n
    obtain ⟨Cg, hCg⟩ := hg.2 n
    refine ⟨Cf + Cg, fun p hp => ?_⟩
    have e : iteratedFDeriv ℝ n (fun p => f p + g p) p =
        iteratedFDeriv ℝ n f p + iteratedFDeriv ℝ n g p :=
      iteratedFDeriv_add_apply (hAt f hf.1 n p hp) (hAt g hg.1 n p hp)
    rw [e]
    exact (norm_add_le _ _).trans (add_le_add (hCf p hp) (hCg p hp))

  have hsub : ∀ f g : ℝ × ℝ → ℝ, collarGood f → collarGood g → collarGood (fun p => f p - g p) := by
    intro f g hf hg
    refine ⟨hf.1.sub hg.1, fun n => ?_⟩
    obtain ⟨Cf, hCf⟩ := hf.2 n
    obtain ⟨Cg, hCg⟩ := hg.2 n
    refine ⟨Cf + Cg, fun p hp => ?_⟩
    have e : iteratedFDeriv ℝ n (fun p => f p - g p) p =
        iteratedFDeriv ℝ n f p - iteratedFDeriv ℝ n g p :=
      iteratedFDeriv_sub_apply (hAt f hf.1 n p hp) (hAt g hg.1 n p hp)
    rw [e]
    exact (norm_sub_le _ _).trans (add_le_add (hCf p hp) (hCg p hp))

  have hinv : ∀ (f : ℝ × ℝ → ℝ) (c : ℝ), collarGood f → 0 < c →
      (∀ p ∈ Ioo 0 (11 / 8) ×ˢ Ioo (-1) 1, c ≤ f p) → collarGood (fun p => (f p)⁻¹) := by
    intro f c hf hc hlow
    have hpos : ∀ p ∈ Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1, 0 < f p :=
      fun p hp => lt_of_lt_of_le hc (hlow p hp)
    have hsm : ContDiffOn ℝ ∞ (fun p => (f p)⁻¹) (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1) :=
      hf.1.inv (fun p hp => (hpos p hp).ne')
    refine ⟨hsm, fun n => ?_⟩
    choose A hA using hf.2
    have hgs : ContDiffOn ℝ ∞ (Inv.inv : ℝ → ℝ) (Ioi 0) :=
      (contDiffOn_inv ℝ).mono (fun y (hy : 0 < y) => (show y ≠ 0 from hy.ne'))
    have hgd : ∀ (i : ℕ) (y : ℝ), 0 < y →
        ‖iteratedFDeriv ℝ i (Inv.inv : ℝ → ℝ) y‖ = (i.factorial : ℝ) * (y ^ (i + 1))⁻¹ := by
      intro i y hy
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate, iter_deriv_inv]
      rw [show (-1 - (i:ℤ)) = -((i + 1 : ℕ) : ℤ) by push_cast; ring, zpow_neg, zpow_natCast]
      rw [norm_mul, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul, norm_inv, norm_pow,
        Real.norm_natCast, Real.norm_of_nonneg hy.le]
    refine ⟨(n.factorial : ℝ) * ((n.factorial : ℝ) * (c⁻¹ + 1) ^ (n + 1)) *
      (1 + ∑ i ∈ Finset.range (n + 1), |A i|) ^ n, fun p hp => ?_⟩
    have hD1 : (1:ℝ) ≤ 1 + ∑ i ∈ Finset.range (n + 1), |A i| :=
      le_add_of_nonneg_right (Finset.sum_nonneg (fun i _ => abs_nonneg _))
    have hC : ∀ i ≤ n, ‖iteratedFDerivWithin ℝ i (Inv.inv : ℝ → ℝ) (Ioi 0) (f p)‖ ≤
        (n.factorial : ℝ) * (c⁻¹ + 1) ^ (n + 1) := by
      intro i hi
      rw [iteratedFDerivWithin_of_isOpen i isOpen_Ioi (show f p ∈ Ioi (0:ℝ) from hpos p hp),
        hgd i (f p) (hpos p hp)]
      have hfi : (i.factorial : ℝ) ≤ n.factorial := by exact_mod_cast Nat.factorial_le hi
      have hci : 0 ≤ c⁻¹ := inv_nonneg.2 hc.le
      have hy : (f p ^ (i + 1))⁻¹ ≤ (c⁻¹ + 1) ^ (n + 1) := by
        have h1 : (f p ^ (i + 1))⁻¹ ≤ (c ^ (i + 1))⁻¹ :=
          inv_anti₀ (pow_pos hc _) (pow_le_pow_left₀ hc.le (hlow p hp) _)
        have h2 : (c ^ (i + 1))⁻¹ = (c⁻¹) ^ (i + 1) := (inv_pow c (i + 1)).symm
        have h3 : (c⁻¹) ^ (i + 1) ≤ (c⁻¹ + 1) ^ (i + 1) :=
          pow_le_pow_left₀ hci (by linarith) _
        have h4 : (c⁻¹ + 1) ^ (i + 1) ≤ (c⁻¹ + 1) ^ (n + 1) :=
          pow_le_pow_right₀ (by linarith) (by omega)
        linarith
      exact mul_le_mul hfi hy (inv_nonneg.2 (pow_nonneg (hpos p hp).le _)) (Nat.cast_nonneg _)
    have hD : ∀ i, 1 ≤ i → i ≤ n →
        ‖iteratedFDerivWithin ℝ i f (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1) p‖ ≤
          (1 + ∑ i ∈ Finset.range (n + 1), |A i|) ^ i := by
      intro i hi1 hin
      rw [hW f i p hp]
      have h1 := hA i p hp
      have h2 : |A i| ≤ ∑ j ∈ Finset.range (n + 1), |A j| :=
        Finset.single_le_sum (f := fun j => |A j|) (fun j _ => abs_nonneg _)
          (Finset.mem_range.2 (by omega))
      have h3 : (1 + ∑ j ∈ Finset.range (n + 1), |A j|) ≤
          (1 + ∑ j ∈ Finset.range (n + 1), |A j|) ^ i := le_self_pow₀ hD1 (by omega)
      linarith [le_abs_self (A i)]
    have hmaps : MapsTo f (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1) (Ioi 0) := fun p hp => hpos p hp
    have key := norm_iteratedFDerivWithin_comp_le hgs hf.1 (hN n) isOpen_Ioi.uniqueDiffOn hΩu
      hmaps hp hC hD
    rw [← hW _ n p hp]
    exact key

  have hglob : ∀ φ : ℝ × ℝ → ℝ, ContDiff ℝ ∞ φ → collarGood φ := by
    intro φ hφ
    refine ⟨hφ.contDiffOn, fun m => ?_⟩
    have hK : IsCompact (Icc (0:ℝ) (11 / 8) ×ˢ Icc (-1:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
    obtain ⟨C, hC⟩ :=
      hK.exists_bound_of_continuousOn (hφ.continuous_iteratedFDeriv (hN m)).continuousOn
    exact ⟨C, fun p hp => hC p ⟨Ioo_subset_Icc_self hp.1, Ioo_subset_Icc_self hp.2⟩⟩
  exact ⟨hmul, hadd, hsub, hinv, hglob⟩

theorem collar_chart_regularity : ∀ h cinf ρ Xb : ℝ, 0 < h → h < 1 / 100 → 0 < cinf → 0 < Xb → (∀ η : ℝ, -1 < η → η < 1 → ContinuousOn (fun x => tailHt h cinf x η) (Ioi 0) ∧ ContinuousOn (fun x => deriv (fun y => tailHt h cinf y η) x) (Ioi 0) ∧ ContinuousOn (fun x => tailEh h cinf x η) (Ioi 0)) ∧ ContinuousOn (tailFac ρ Xb) (Ioi 0) ∧ ContDiffOn ℝ ∞ (collarPsiTh h cinf Xb) (univ ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (collarPsiE h cinf ρ Xb) (univ ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (collarPsiXE h cinf ρ Xb) (univ ×ˢ Ioo (-1) 1) ∧ collarGood (collarPsiTh h cinf Xb) ∧ collarGood (collarPsiE h cinf ρ Xb) ∧ collarGood (collarPsiXE h cinf ρ Xb) ∧ collarGood (fun p : ℝ × ℝ => tailHt h cinf (collarXu Xb p.1) p.2) ∧ collarGood (fun p : ℝ × ℝ => tailEh h cinf (collarXu Xb p.1) p.2) :=
by
  intro h cinf ρ Xb hh0 _hh1 _hc0 hXb0
  obtain ⟨HP1, HP2, HP3⟩ :=
    heatProfile_props h hh0 heatK_deriv_bound (fun Z hZ => heatK_ode h Z hh0 hZ)
  have HP1' : ContDiffOn ℝ ∞ (deriv (heatProfile h)) (Ioi 0) :=
    ((contDiffOn_infty_iff_deriv_of_isOpen isOpen_Ioi).1 HP1).2
  have HP2' : ∀ k : ℕ, ∃ C : ℝ, ∀ Z : ℝ, 0 < Z → |iteratedDeriv k (deriv (heatProfile h)) Z| ≤ C := by
    intro k
    obtain ⟨C, hC⟩ := HP2 (k + 1)
    exact ⟨C, fun Z hZ => by rw [← iteratedDeriv_succ']; exact hC Z hZ⟩
  obtain ⟨hσ, -, hγ, -⟩ := sigA_collar_facts
  obtain ⟨hmul, hadd, -, -, hglob⟩ := collarGood_algebra
  have hΩo : IsOpen (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioo.prod isOpen_Ioo

  have hcomp : ∀ (g : ℝ → ℝ) (Z : ℝ × ℝ → ℝ), ContDiffOn ℝ ∞ g (Ioi 0) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z : ℝ, 0 < z → |iteratedDeriv k g z| ≤ C) → ContDiff ℝ ∞ Z →
      (∀ p ∈ Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1, 0 < Z p) → collarGood (fun p => g (Z p)) := by
    intro g Z hg hgb hZ hZpos
    have hmaps : MapsTo Z (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1) (Ioi 0) := fun p hp => hZpos p hp
    have hsm : ContDiffOn ℝ ∞ (g ∘ Z) (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1) :=
      hg.comp hZ.contDiffOn hmaps
    refine ⟨hsm, fun n => ?_⟩
    have hK : IsCompact (Icc (0:ℝ) (11 / 8) ×ˢ Icc (-1:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
    have hM : ∀ i : ℕ, ∃ M : ℝ, ∀ x ∈ Icc (0:ℝ) (11 / 8) ×ˢ Icc (-1:ℝ) 1,
        ‖iteratedFDeriv ℝ i Z x‖ ≤ M := fun i =>
      hK.exists_bound_of_continuousOn
        ((hZ.continuous_iteratedFDeriv (by exact_mod_cast le_top)).continuousOn)
    choose M hM using hM
    choose Cg hCg using hgb
    refine ⟨n.factorial * (∑ i ∈ Finset.range (n + 1), |Cg i|) *
      (1 + ∑ i ∈ Finset.range (n + 1), |M i|) ^ n, fun p hp => ?_⟩
    have hpK : p ∈ Icc (0:ℝ) (11 / 8) ×ˢ Icc (-1:ℝ) 1 :=
      ⟨Ioo_subset_Icc_self hp.1, Ioo_subset_Icc_self hp.2⟩
    have hgbd : ∀ i ≤ n, ‖iteratedFDerivWithin ℝ i g (Ioi 0) (Z p)‖ ≤
        ∑ i ∈ Finset.range (n + 1), |Cg i| := by
      intro i hi
      rw [iteratedFDerivWithin_of_isOpen i isOpen_Ioi (hmaps hp),
        norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs]
      calc |iteratedDeriv i g (Z p)| ≤ Cg i := hCg i (Z p) (hmaps hp)
        _ ≤ |Cg i| := le_abs_self _
        _ ≤ ∑ j ∈ Finset.range (n + 1), |Cg j| :=
          Finset.single_le_sum (f := fun j => |Cg j|) (fun j _ => abs_nonneg _)
            (Finset.mem_range.2 (by omega))
    have hD : (1:ℝ) ≤ 1 + ∑ j ∈ Finset.range (n + 1), |M j| :=
      le_add_of_nonneg_right (Finset.sum_nonneg (fun j _ => abs_nonneg _))
    have hZbd : ∀ i : ℕ, 1 ≤ i → i ≤ n →
        ‖iteratedFDerivWithin ℝ i Z (Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1) p‖ ≤
          (1 + ∑ j ∈ Finset.range (n + 1), |M j|) ^ i := by
      intro i hi1 hin
      rw [iteratedFDerivWithin_of_isOpen i hΩo hp]
      calc ‖iteratedFDeriv ℝ i Z p‖ ≤ M i := hM i p hpK
        _ ≤ |M i| := le_abs_self _
        _ ≤ ∑ j ∈ Finset.range (n + 1), |M j| :=
          Finset.single_le_sum (f := fun j => |M j|) (fun j _ => abs_nonneg _)
            (Finset.mem_range.2 (by omega))
        _ ≤ 1 + ∑ j ∈ Finset.range (n + 1), |M j| := le_add_of_nonneg_left zero_le_one
        _ ≤ _ := le_self_pow₀ hD (by omega)
    have key := norm_iteratedFDerivWithin_comp_le hg hZ.contDiffOn (n := n)
      (by exact_mod_cast le_top) isOpen_Ioi.uniqueDiffOn hΩo.uniqueDiffOn hmaps hp hgbd hZbd
    rw [iteratedFDerivWithin_of_isOpen n hΩo hp] at key
    exact key

  have hcongr : ∀ f g : ℝ × ℝ → ℝ, collarGood f →
      (∀ p ∈ Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1, g p = f p) → collarGood g := by
    intro f g hf heq
    refine ⟨hf.1.congr heq, fun m => ?_⟩
    obtain ⟨C, hC⟩ := hf.2 m
    refine ⟨C, fun p hp => ?_⟩
    have hev : g =ᶠ[nhds p] f := Filter.eventuallyEq_of_mem (hΩo.mem_nhds hp) (fun q hq => heq q hq)
    rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
    exact hC p hp

  have hQ : ContDiff ℝ ∞ (fun p : ℝ × ℝ => collarXu Xb p.1) := by unfold collarXu; fun_prop
  have hQpos : ∀ p : ℝ × ℝ, 0 < collarXu Xb p.1 := fun p => mul_pos hXb0 (Real.exp_pos _)
  have hQh : ContDiff ℝ ∞ (fun p : ℝ × ℝ => collarXu Xb p.1 ^ (-h)) :=
    hQ.rpow_const_of_ne (fun p => (hQpos p).ne')
  have hQe : ContDiff ℝ ∞ (fun p : ℝ × ℝ => collarXu Xb p.1 ^ (-(1 / 2 + h))) :=
    hQ.rpow_const_of_ne (fun p => (hQpos p).ne')
  have hZ : ContDiff ℝ ∞ (fun p : ℝ × ℝ => 2 * (1 - p.2 ^ 2) / collarXu Xb p.1) :=
    (by fun_prop : ContDiff ℝ ∞ (fun p : ℝ × ℝ => 2 * (1 - p.2 ^ 2))).div hQ (fun p => (hQpos p).ne')
  have hΓ : ContDiff ℝ ∞ (fun p : ℝ × ℝ => collarGam p.1) := hγ.comp contDiff_fst
  have hS : ContDiff ℝ ∞ (fun p : ℝ × ℝ => sigA (1 - p.1)) :=
    hσ.comp (contDiff_const.sub contDiff_fst)
  have hL : ContDiff ℝ ∞ (fun p : ℝ × ℝ => 2 * (1 - 2 * h * p.2 ^ 2)) := by fun_prop
  have hpos1 : ∀ e : ℝ, -1 < e → e < 1 → 0 < 1 - e ^ 2 := by
    intro e h1 h2
    have : 0 < (1 - e) * (1 + e) := mul_pos (by linarith) (by linarith)
    nlinarith
  have hZposS : ∀ q : ℝ × ℝ, -1 < q.2 → q.2 < 1 → 0 < 2 * (1 - q.2 ^ 2) / collarXu Xb q.1 :=
    fun q h1 h2 => div_pos (by linarith [hpos1 q.2 h1 h2]) (hQpos q)
  have hmapS : MapsTo (fun q : ℝ × ℝ => 2 * (1 - q.2 ^ 2) / collarXu Xb q.1)
      (univ ×ˢ Ioo (-1:ℝ) 1) (Ioi 0) := fun q hq => hZposS q hq.2.1 hq.2.2
  have hHZS : ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => heatProfile h (2 * (1 - q.2 ^ 2) / collarXu Xb q.1))
      (univ ×ˢ Ioo (-1:ℝ) 1) := HP1.comp hZ.contDiffOn hmapS
  have hH'ZS : ContDiffOn ℝ ∞
      (fun q : ℝ × ℝ => deriv (heatProfile h) (2 * (1 - q.2 ^ 2) / collarXu Xb q.1))
      (univ ×ˢ Ioo (-1:ℝ) 1) := HP1'.comp hZ.contDiffOn hmapS
  have GH : collarGood (fun q : ℝ × ℝ => heatProfile h (2 * (1 - q.2 ^ 2) / collarXu Xb q.1)) :=
    hcomp (heatProfile h) (fun q => 2 * (1 - q.2 ^ 2) / collarXu Xb q.1) HP1 HP2 hZ
      (fun p hp => hZposS p hp.2.1 hp.2.2)
  have GH' : collarGood
      (fun q : ℝ × ℝ => deriv (heatProfile h) (2 * (1 - q.2 ^ 2) / collarXu Xb q.1)) :=
    hcomp (deriv (heatProfile h)) (fun q => 2 * (1 - q.2 ^ 2) / collarXu Xb q.1) HP1' HP2' hZ
      (fun p hp => hZposS p hp.2.1 hp.2.2)

  have hA1 : ContDiff ℝ ∞ (fun q : ℝ × ℝ => collarGam q.1 * (Real.sqrt 2 * cinf * collarXu Xb q.1 ^ (-h)) *
      (2 * (1 - 2 * h * q.2 ^ 2) * (1 + h) + collarXu Xb q.1)) :=
    (hΓ.mul (contDiff_const.mul hQh)).mul ((hL.mul contDiff_const).add hQ)
  have hA2 : ContDiff ℝ ∞ (fun q : ℝ × ℝ => collarGam q.1 * (Real.sqrt 2 * cinf * collarXu Xb q.1 ^ (-h)) *
      (2 * (1 - 2 * h * q.2 ^ 2) * (2 * (1 - q.2 ^ 2) / collarXu Xb q.1))) :=
    (hΓ.mul (contDiff_const.mul hQh)).mul (hL.mul hZ)
  have hB : ContDiff ℝ ∞ (fun q : ℝ × ℝ => collarGam q.1 * (cinf * collarXu Xb q.1 ^ (-(1 / 2 + h))) ^ 2 *
      (1 - ρ * (1 - sigA (1 - q.1)))) :=
    (hΓ.mul ((contDiff_const.mul hQe).pow 2)).mul
      (contDiff_const.sub (contDiff_const.mul (contDiff_const.sub hS)))

  have hidθ : ∀ (Γ x e : ℝ), 0 < x → -1 < e → e < 1 →
      Γ * (2 * (1 - 2 * h * e ^ 2) * (tailHt h cinf x e - x * deriv (fun y => tailHt h cinf y e) x) +
        x * tailHt h cinf x e) =
      Γ * (Real.sqrt 2 * cinf * x ^ (-h)) * (2 * (1 - 2 * h * e ^ 2) * (1 + h) + x) *
          heatProfile h (2 * (1 - e ^ 2) / x) +
        Γ * (Real.sqrt 2 * cinf * x ^ (-h)) * (2 * (1 - 2 * h * e ^ 2) * (2 * (1 - e ^ 2) / x)) *
          deriv (heatProfile h) (2 * (1 - e ^ 2) / x) := by
    intro Γ x e hx h1 h2
    rw [(tailHt_calculus h cinf x e hx h1 h2 HP1 HP3).1.deriv]
    simp only [tailHt]
    generalize x ^ (-h) = P
    generalize heatProfile h (2 * (1 - e ^ 2) / x) = A
    generalize deriv (heatProfile h) (2 * (1 - e ^ 2) / x) = B
    have hx0 : x ≠ 0 := hx.ne'
    field_simp
    ring
  have hfac : ∀ v : ℝ, tailFac ρ Xb (collarXu Xb v) = 1 - ρ * (1 - sigA (1 - v)) := by
    intro v
    unfold tailFac collarXu
    rw [mul_div_cancel_left₀ _ hXb0.ne', Real.log_exp]
    have e : (-(2 * v) + 2) / 2 = 1 - v := by ring
    rw [e]
  have eθ : ∀ q ∈ univ ×ˢ Ioo (-1:ℝ) 1, collarPsiTh h cinf Xb q =
      collarGam q.1 * (Real.sqrt 2 * cinf * collarXu Xb q.1 ^ (-h)) *
          (2 * (1 - 2 * h * q.2 ^ 2) * (1 + h) + collarXu Xb q.1) *
          heatProfile h (2 * (1 - q.2 ^ 2) / collarXu Xb q.1) +
        collarGam q.1 * (Real.sqrt 2 * cinf * collarXu Xb q.1 ^ (-h)) *
          (2 * (1 - 2 * h * q.2 ^ 2) * (2 * (1 - q.2 ^ 2) / collarXu Xb q.1)) *
          deriv (heatProfile h) (2 * (1 - q.2 ^ 2) / collarXu Xb q.1) :=
    fun q hq => hidθ _ _ _ (hQpos q) hq.2.1 hq.2.2
  have eE : ∀ q : ℝ × ℝ, collarPsiE h cinf ρ Xb q =
      collarGam q.1 * (cinf * collarXu Xb q.1 ^ (-(1 / 2 + h))) ^ 2 * (1 - ρ * (1 - sigA (1 - q.1))) *
        (heatProfile h (2 * (1 - q.2 ^ 2) / collarXu Xb q.1) *
          heatProfile h (2 * (1 - q.2 ^ 2) / collarXu Xb q.1)) := by
    intro q
    unfold collarPsiE
    rw [hfac]
    unfold tailEh
    ring
  have eXE : ∀ q : ℝ × ℝ, collarPsiXE h cinf ρ Xb q = collarXu Xb q.1 * collarPsiE h cinf ρ Xb q := by
    intro q
    unfold collarPsiXE collarPsiE
    ring

  have sθ : ContDiffOn ℝ ∞ (collarPsiTh h cinf Xb) (univ ×ˢ Ioo (-1:ℝ) 1) :=
    ((hA1.contDiffOn.mul hHZS).add (hA2.contDiffOn.mul hH'ZS)).congr eθ
  have sE : ContDiffOn ℝ ∞ (collarPsiE h cinf ρ Xb) (univ ×ˢ Ioo (-1:ℝ) 1) :=
    (hB.contDiffOn.mul (hHZS.mul hHZS)).congr (fun q _ => eE q)
  have sXE : ContDiffOn ℝ ∞ (collarPsiXE h cinf ρ Xb) (univ ×ˢ Ioo (-1:ℝ) 1) :=
    (hQ.contDiffOn.mul sE).congr (fun q _ => eXE q)

  have gθ : collarGood (collarPsiTh h cinf Xb) :=
    hcongr _ _ (hadd _ _ (hmul _ _ (hglob _ hA1) GH) (hmul _ _ (hglob _ hA2) GH'))
      (fun q hq => eθ q ⟨mem_univ _, hq.2⟩)
  have gE : collarGood (collarPsiE h cinf ρ Xb) :=
    hcongr _ _ (hmul _ _ (hglob _ hB) (hmul _ _ GH GH)) (fun q _ => eE q)
  have gXE : collarGood (collarPsiXE h cinf ρ Xb) :=
    hcongr _ _ (hmul _ _ (hglob _ hQ) gE) (fun q _ => eXE q)
  have gHt : collarGood (fun p : ℝ × ℝ => tailHt h cinf (collarXu Xb p.1) p.2) :=
    hmul (fun p : ℝ × ℝ => Real.sqrt 2 * cinf * collarXu Xb p.1 ^ (-h))
      (fun q : ℝ × ℝ => heatProfile h (2 * (1 - q.2 ^ 2) / collarXu Xb q.1))
      (hglob _ (contDiff_const.mul hQh)) GH
  have gEh : collarGood (fun p : ℝ × ℝ => tailEh h cinf (collarXu Xb p.1) p.2) :=
    hmul (fun p : ℝ × ℝ => cinf * collarXu Xb p.1 ^ (-(1 / 2 + h)))
      (fun q : ℝ × ℝ => heatProfile h (2 * (1 - q.2 ^ 2) / collarXu Xb q.1))
      (hglob _ (contDiff_const.mul hQe)) GH

  have hcont : ∀ η : ℝ, -1 < η → η < 1 → ContinuousOn (fun x => tailHt h cinf x η) (Ioi 0) ∧
      ContinuousOn (fun x => deriv (fun y => tailHt h cinf y η) x) (Ioi 0) ∧
      ContinuousOn (fun x => tailEh h cinf x η) (Ioi 0) := by
    intro η h1 h2
    have hzc : ContinuousOn (fun x : ℝ => 2 * (1 - η ^ 2) / x) (Ioi 0) :=
      continuousOn_const.div continuousOn_id (fun x hx => ne_of_gt hx)
    have hzm : MapsTo (fun x : ℝ => 2 * (1 - η ^ 2) / x) (Ioi 0) (Ioi 0) :=
      fun x hx => show 0 < 2 * (1 - η ^ 2) / x from
        div_pos (by linarith [hpos1 η h1 h2]) (show (0:ℝ) < x from hx)
    have HZc : ContinuousOn (fun x : ℝ => heatProfile h (2 * (1 - η ^ 2) / x)) (Ioi 0) :=
      HP1.continuousOn.comp hzc hzm
    have H'Zc : ContinuousOn (fun x : ℝ => deriv (heatProfile h) (2 * (1 - η ^ 2) / x)) (Ioi 0) :=
      HP1'.continuousOn.comp hzc hzm
    have powh : ContinuousOn (fun x : ℝ => x ^ (-h)) (Ioi 0) :=
      continuousOn_id.rpow_const (fun x hx => Or.inl (ne_of_gt hx))
    have powe : ContinuousOn (fun x : ℝ => x ^ (-(1 / 2 + h))) (Ioi 0) :=
      continuousOn_id.rpow_const (fun x hx => Or.inl (ne_of_gt hx))
    refine ⟨?_, ?_, ?_⟩
    · show ContinuousOn (fun x => Real.sqrt 2 * cinf * x ^ (-h) * heatProfile h (2 * (1 - η ^ 2) / x)) (Ioi 0)
      exact (continuousOn_const.mul powh).mul HZc
    · have hc : ContinuousOn (fun x : ℝ => Real.sqrt 2 * cinf * x ^ (-h) / x *
          (-(h * heatProfile h (2 * (1 - η ^ 2) / x)) -
            2 * (1 - η ^ 2) / x * deriv (heatProfile h) (2 * (1 - η ^ 2) / x))) (Ioi 0) :=
        ((continuousOn_const.mul powh).div continuousOn_id (fun x hx => ne_of_gt hx)).mul
          ((continuousOn_const.mul HZc).neg.sub (hzc.mul H'Zc))
      exact hc.congr (fun x hx => (tailHt_calculus h cinf x η hx h1 h2 HP1 HP3).1.deriv)
    · show ContinuousOn (fun x => cinf * x ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - η ^ 2) / x)) (Ioi 0)
      exact (continuousOn_const.mul powe).mul HZc
  exact ⟨hcont, (tailFac_facts ρ Xb hXb0 sigA_contDiff_one).2.2.1, sθ, sE, sXE, gθ, gE, gXE, gHt, gEh⟩

theorem collar_interval_subst : ∀ (ρ Xb X : ℝ) (Φ : ℝ → ℝ) (ψ : ℝ × ℝ → ℝ) (η : ℝ), 0 < Xb → 0 < X → X < Xb → ContinuousOn Φ (Icc X Xb) → (∀ v : ℝ, 0 < v → ψ (v, η) = collarGam v * Φ (collarXu Xb v)) → deriv (tailFac ρ Xb) X = ρ / (2 * X) * (Real.exp (-(4 / Real.log (Xb / X) ^ 2)) / (Real.log (Xb / X) / 2) ^ 3 * collarGam (Real.log (Xb / X) / 2)) ∧ ∫ x in X..Xb, Φ x * deriv (tailFac ρ Xb) x = ρ / 2 * Real.exp (-(4 / Real.log (Xb / X) ^ 2)) * collarFlatInt ψ (Real.log (Xb / X) / 2, η) :=
by
  intro ρ Xb X Φ ψ η hXb hX hXXb _hΦ hψ
  obtain ⟨-, -, -, -, hder, -, -⟩ := sigA_collar_facts

  have hfac : ∀ x : ℝ, 0 < x → x < Xb → HasDerivAt (tailFac ρ Xb)
      (ρ / (2 * x) * (Real.exp (-(4 / Real.log (Xb / x) ^ 2)) / (Real.log (Xb / x) / 2) ^ 3 *
        collarGam (Real.log (Xb / x) / 2))) x := by
    intro x hx hxb
    have hl : 0 < Real.log (Xb / x) := Real.log_pos ((one_lt_div hx).2 hxb)
    have hlne : Real.log (Xb / x) ≠ 0 := hl.ne'
    have hxne : x ≠ 0 := hx.ne'
    have hXbne : Xb ≠ 0 := hXb.ne'
    have hw0 : 0 < Real.log (Xb / x) / 2 := by linarith
    have h1 : HasDerivAt (fun y : ℝ => y / Xb) (1 / Xb) x := (hasDerivAt_id' x).div_const Xb
    have h2 := ((h1.log (div_pos hx hXb).ne').add_const 2).div_const 2
    have hg : HasDerivAt (fun y : ℝ => (Real.log (y / Xb) + 2) / 2) (1 / (2 * x)) x := by
      convert h2 using 1
      field_simp
    have hgx : 1 - Real.log (Xb / x) / 2 = (fun y : ℝ => (Real.log (y / Xb) + 2) / 2) x := by
      show 1 - Real.log (Xb / x) / 2 = (Real.log (x / Xb) + 2) / 2
      have : Real.log (x / Xb) = -Real.log (Xb / x) := by rw [← Real.log_inv, inv_div]
      rw [this]; ring
    have hc := HasDerivAt.comp_of_eq x (hder _ hw0) hg hgx
    have hT := ((hc.const_sub 1).const_mul ρ).const_sub 1
    have hfun : tailFac ρ Xb =
        fun y => 1 - ρ * (1 - (sigA ∘ fun y : ℝ => (Real.log (y / Xb) + 2) / 2) y) := rfl
    have hW : Real.exp (-1 / (Real.log (Xb / x) / 2) ^ 2) =
        Real.exp (-(4 / Real.log (Xb / x) ^ 2)) := by
      congr 1; field_simp; ring
    rw [hfun]
    convert hT using 1
    rw [hW]; ring
  refine ⟨(hfac X hX hXXb).deriv, ?_⟩

  obtain ⟨u, hudef⟩ : ∃ u : ℝ, u = Real.log (Xb / X) / 2 := ⟨_, rfl⟩
  rw [← hudef]
  have hL0 : 0 < Real.log (Xb / X) := Real.log_pos ((one_lt_div hX).2 hXXb)
  have hu : 0 < u := by rw [hudef]; linarith
  have hune : u ≠ 0 := hu.ne'
  have hL : Real.log (Xb / X) = 2 * u := by rw [hudef]; ring

  have hpt : ∀ t : ℝ, 0 < t →
      1 < Real.sqrt (1 + u ^ 2 * t) ∧
      HasDerivAt (fun s : ℝ => collarXu Xb (u / Real.sqrt (1 + u ^ 2 * s)))
        (collarXu Xb (u / Real.sqrt (1 + u ^ 2 * t)) * u ^ 3 / Real.sqrt (1 + u ^ 2 * t) ^ 3) t ∧
      0 < collarXu Xb (u / Real.sqrt (1 + u ^ 2 * t)) ∧
      collarXu Xb (u / Real.sqrt (1 + u ^ 2 * t)) < Xb ∧
      Real.log (Xb / collarXu Xb (u / Real.sqrt (1 + u ^ 2 * t))) =
        2 * (u / Real.sqrt (1 + u ^ 2 * t)) ∧
      Real.exp (-(4 / Real.log (Xb / X) ^ 2)) * Real.exp (-t) =
        Real.exp (-(4 / (2 * (u / Real.sqrt (1 + u ^ 2 * t))) ^ 2)) := by
    intro t ht
    have hut : 0 < u ^ 2 * t := mul_pos (pow_pos hu 2) ht
    have hk0 : 0 < 1 + u ^ 2 * t := by linarith
    have hk0ne : 1 + u ^ 2 * t ≠ 0 := hk0.ne'
    have hS1 : 1 < Real.sqrt (1 + u ^ 2 * t) := by
      rw [Real.lt_sqrt zero_le_one, one_pow]; linarith
    have hS0 : 0 < Real.sqrt (1 + u ^ 2 * t) := by linarith
    have hSne : Real.sqrt (1 + u ^ 2 * t) ≠ 0 := hS0.ne'
    have hSsq : Real.sqrt (1 + u ^ 2 * t) ^ 2 = 1 + u ^ 2 * t := Real.sq_sqrt hk0.le
    have hV0 : 0 < u / Real.sqrt (1 + u ^ 2 * t) := div_pos hu hS0
    refine ⟨hS1, ?_, mul_pos hXb (Real.exp_pos _), ?_, ?_, ?_⟩
    · have hfun : (fun s : ℝ => collarXu Xb (u / Real.sqrt (1 + u ^ 2 * s))) =
          fun s => Xb * Real.exp (-(2 * (u * (Real.sqrt (1 + u ^ 2 * s))⁻¹))) := by
        funext s; unfold collarXu; rw [div_eq_mul_inv]
      rw [hfun]
      have hk : HasDerivAt (fun s : ℝ => 1 + u ^ 2 * s) (u ^ 2) t := by
        simpa using ((hasDerivAt_id' t).const_mul (u ^ 2)).const_add 1
      have hSd : HasDerivAt (fun s : ℝ => Real.sqrt (1 + u ^ 2 * s))
          (u ^ 2 / (2 * Real.sqrt (1 + u ^ 2 * t))) t := hk.sqrt hk0ne
      have hId : HasDerivAt (fun s : ℝ => (Real.sqrt (1 + u ^ 2 * s))⁻¹)
          (-(u ^ 2 / (2 * Real.sqrt (1 + u ^ 2 * t))) / Real.sqrt (1 + u ^ 2 * t) ^ 2) t :=
        hSd.inv hSne
      have hχd : HasDerivAt (fun s : ℝ => Xb * Real.exp (-(2 * (u * (Real.sqrt (1 + u ^ 2 * s))⁻¹))))
          (Xb * (Real.exp (-(2 * (u * (Real.sqrt (1 + u ^ 2 * t))⁻¹))) *
            -(2 * (u * (-(u ^ 2 / (2 * Real.sqrt (1 + u ^ 2 * t))) /
              Real.sqrt (1 + u ^ 2 * t) ^ 2))))) t :=
        (((hId.const_mul u).const_mul 2).neg.exp).const_mul Xb
      convert hχd using 1
      unfold collarXu
      rw [div_eq_mul_inv u]
      generalize Real.exp (-(2 * (u * (Real.sqrt (1 + u ^ 2 * t))⁻¹))) = e
      field_simp
    · have he := Real.exp_lt_exp.2 (show -(2 * (u / Real.sqrt (1 + u ^ 2 * t))) < 0 by linarith)
      rw [Real.exp_zero] at he
      exact mul_lt_of_lt_one_right hXb he
    · show Real.log (Xb / (Xb * Real.exp (-(2 * (u / Real.sqrt (1 + u ^ 2 * t)))))) = _
      rw [Real.exp_neg, div_mul_eq_div_div, div_self hXb.ne', one_div, inv_inv, Real.log_exp]
    · rw [← Real.exp_add, mul_pow, div_pow, hSsq, hL]
      congr 1
      field_simp
      ring

  have hinj : InjOn (fun s : ℝ => collarXu Xb (u / Real.sqrt (1 + u ^ 2 * s))) (Ioi 0) := by
    intro s1 hs1 s2 hs2 heq
    have heq' : collarXu Xb (u / Real.sqrt (1 + u ^ 2 * s1)) =
        collarXu Xb (u / Real.sqrt (1 + u ^ 2 * s2)) := heq
    have hs1' : (0:ℝ) < s1 := hs1
    have hs2' : (0:ℝ) < s2 := hs2
    obtain ⟨a1, -, -, -, e1, -⟩ := hpt s1 hs1'
    obtain ⟨a2, -, -, -, e2, -⟩ := hpt s2 hs2'
    rw [heq'] at e1
    have hV : u / Real.sqrt (1 + u ^ 2 * s1) = u / Real.sqrt (1 + u ^ 2 * s2) := by linarith
    rw [div_eq_div_iff (by linarith) (by linarith)] at hV
    have hS : Real.sqrt (1 + u ^ 2 * s1) = Real.sqrt (1 + u ^ 2 * s2) :=
      (mul_left_cancel₀ hune hV).symm
    have hm1 : 0 < u ^ 2 * s1 := mul_pos (pow_pos hu 2) hs1'
    have hm2 : 0 < u ^ 2 * s2 := mul_pos (pow_pos hu 2) hs2'
    have hk := (Real.sqrt_inj (by linarith) (by linarith)).1 hS
    have hu2 : (u ^ 2) ≠ 0 := (pow_pos hu 2).ne'
    exact mul_left_cancel₀ hu2 (by linarith)
  have hXu : collarXu Xb u = X := by
    unfold collarXu
    rw [show -(2 * u) = -Real.log (Xb / X) by rw [hL], Real.exp_neg, Real.exp_log (div_pos hXb hX)]
    field_simp
  have himage : (fun s : ℝ => collarXu Xb (u / Real.sqrt (1 + u ^ 2 * s))) '' Ioi 0 = Ioo X Xb := by
    ext y
    constructor
    · rintro ⟨s, hs, rfl⟩
      have hs' : (0:ℝ) < s := hs
      obtain ⟨hS1, -, -, hlt, -, -⟩ := hpt s hs'
      refine ⟨?_, hlt⟩
      have hVu : u / Real.sqrt (1 + u ^ 2 * s) < u := div_lt_self hu hS1
      show X < collarXu Xb (u / Real.sqrt (1 + u ^ 2 * s))
      rw [← hXu]
      unfold collarXu
      exact mul_lt_mul_of_pos_left (Real.exp_lt_exp.2 (by linarith)) hXb
    · rintro ⟨hy1, hy2⟩
      have hy0 : 0 < y := hX.trans hy1
      have hℓ0 : 0 < Real.log (Xb / y) := Real.log_pos ((one_lt_div hy0).2 hy2)
      have hℓL : Real.log (Xb / y) < 2 * u := by
        rw [← hL]
        exact Real.log_lt_log (div_pos hXb hy0) (div_lt_div_of_pos_left hXb hX hy1)
      have hℓne : Real.log (Xb / y) ≠ 0 := hℓ0.ne'
      refine ⟨4 / Real.log (Xb / y) ^ 2 - 1 / u ^ 2, ?_, ?_⟩
      · show 0 < 4 / Real.log (Xb / y) ^ 2 - 1 / u ^ 2
        have : 1 / u ^ 2 < 4 / Real.log (Xb / y) ^ 2 := by
          rw [div_lt_div_iff₀ (pow_pos hu 2) (pow_pos hℓ0 2)]
          nlinarith [mul_pos hℓ0 hu]
        linarith
      · show collarXu Xb (u / Real.sqrt (1 + u ^ 2 * (4 / Real.log (Xb / y) ^ 2 - 1 / u ^ 2))) = y
        have e1 : 1 + u ^ 2 * (4 / Real.log (Xb / y) ^ 2 - 1 / u ^ 2) =
            (2 * u / Real.log (Xb / y)) ^ 2 := by
          field_simp; ring
        have e2 : u / (2 * u / Real.log (Xb / y)) = Real.log (Xb / y) / 2 := by
          field_simp
        rw [e1, Real.sqrt_sq (div_pos (by linarith) hℓ0).le, e2]
        unfold collarXu
        rw [show -(2 * (Real.log (Xb / y) / 2)) = -Real.log (Xb / y) by ring, Real.exp_neg,
          Real.exp_log (div_pos hXb hy0)]
        field_simp

  have hcongr : EqOn
      (fun t => |collarXu Xb (u / Real.sqrt (1 + u ^ 2 * t)) * u ^ 3 / Real.sqrt (1 + u ^ 2 * t) ^ 3| •
        (Φ (collarXu Xb (u / Real.sqrt (1 + u ^ 2 * t))) *
          deriv (tailFac ρ Xb) (collarXu Xb (u / Real.sqrt (1 + u ^ 2 * t)))))
      (fun t => ρ / 2 * Real.exp (-(4 / Real.log (Xb / X) ^ 2)) *
        (Real.exp (-t) * ψ (u / Real.sqrt (1 + u ^ 2 * t), η))) (Ioi 0) := by
    intro t ht
    have ht' : (0:ℝ) < t := ht
    obtain ⟨hS1, -, hpos, hlt, hlog, hexp⟩ := hpt t ht'
    have hS0 : 0 < Real.sqrt (1 + u ^ 2 * t) := by linarith
    have hSne : Real.sqrt (1 + u ^ 2 * t) ≠ 0 := hS0.ne'
    have hposne : collarXu Xb (u / Real.sqrt (1 + u ^ 2 * t)) ≠ 0 := hpos.ne'
    have hV0 : 0 < u / Real.sqrt (1 + u ^ 2 * t) := div_pos hu hS0
    beta_reduce
    rw [(hfac _ hpos hlt).deriv, hlog,
      show 2 * (u / Real.sqrt (1 + u ^ 2 * t)) / 2 = u / Real.sqrt (1 + u ^ 2 * t) by ring,
      ← hexp, hψ _ hV0, smul_eq_mul,
      abs_of_pos (div_pos (mul_pos hpos (pow_pos hu 3)) (pow_pos hS0 3))]
    field_simp
  rw [intervalIntegral.integral_of_le hXXb.le, integral_Ioc_eq_integral_Ioo, ← himage,
    integral_image_eq_integral_abs_deriv_smul (s := Ioi (0:ℝ)) measurableSet_Ioi
      (fun t ht => ((hpt t ht).2.1).hasDerivWithinAt) hinj,
    setIntegral_congr_fun measurableSet_Ioi hcongr, integral_const_mul]
  rfl

theorem collar_beta_lower : ∀ h cinf ρ Xb : ℝ, 0 < h → h < 1 / 100 → 0 < cinf → 0 < ρ → 400 ≤ Xb → ∃ c : ℝ, 0 < c ∧ ∀ p ∈ Ioo 0 (11 / 8) ×ˢ Ioo (-1) 1, c ≤ collarBeta h cinf ρ Xb p :=
by
  intro h cinf ρ Xb hh0 hh1 hc0 hρ hXb
  have hXb0 : 0 < Xb := by linarith
  obtain ⟨hC, -, hODE⟩ :=
    heatProfile_props h hh0 heatK_deriv_bound (fun Z hZ => heatK_ode h Z hh0 hZ)
  obtain ⟨-, -, -, -, -, hγ0, hγ4⟩ := sigA_collar_facts
  obtain ⟨-, -, hψs, -, -, hψg, -⟩ := collar_chart_regularity h cinf ρ Xb hh0 hh1 hc0 hXb0
  obtain ⟨Cψ, hCψ⟩ := hψg.2 0

  have hP : ∀ x η : ℝ, 16 ≤ x → -1 < η → η < 1 →
      Real.sqrt 2 * cinf * x ^ (-h) / 2 ≤ tailHt h cinf x η ∧
      0 ≤ tailHt h cinf x η - x * deriv (fun y => tailHt h cinf y η) x := by
    intro x η hx h1 h2
    have hx0 : 0 < x := by linarith
    have hη2 : η ^ 2 < 1 := by nlinarith
    obtain ⟨Z, hZ⟩ : ∃ Z : ℝ, Z = 2 * (1 - η ^ 2) / x := ⟨_, rfl⟩
    have hZ0 : 0 < Z := by rw [hZ]; exact div_pos (by linarith) hx0
    have hZ8 : Z ≤ 1 / 8 := by
      rw [hZ, div_le_iff₀ hx0]; nlinarith
    have hS : 0 < Real.sqrt 2 * cinf * x ^ (-h) :=
      mul_pos (mul_pos (Real.sqrt_pos.2 two_pos) hc0) (Real.rpow_pos_of_pos hx0 _)
    have hhh : h * (h + 1) ≤ 1 / 50 := by nlinarith
    have hH : 1 / 2 ≤ heatProfile h Z := by
      have hn := (abs_le.1 (heat_near_one h Z hh0 hZ0)).1
      have : h * (1 + h) * Z ≤ 1 / 50 * Z := mul_le_mul_of_nonneg_right (by nlinarith) hZ0.le
      linarith
    have hfun : heatProfile h = fun Y => (Real.Gamma (1 + h))⁻¹ * heatK h Y := by
      funext Y; rfl
    have hdH : HasDerivAt (heatProfile h)
        ((Real.Gamma (1 + h))⁻¹ * (-h * heatK (h + 1) Z)) Z := by
      rw [hfun]; exact (heatK_deriv_bound h Z hh0.le hZ0).1.const_mul _
    have hKb := (heatK_deriv_bound (h + 1) Z (by linarith) hZ0).2
    have hG : Real.Gamma (h + 1 + 1) = (h + 1) * Real.Gamma (1 + h) := by
      rw [Real.Gamma_add_one (by linarith : (0:ℝ) < h + 1).ne', add_comm h 1]
    have hGpos : 0 < Real.Gamma (1 + h) := Real.Gamma_pos_of_pos (by linarith)
    have hdb : |deriv (heatProfile h) Z| ≤ h * (h + 1) := by
      rw [hdH.deriv, abs_mul, abs_mul, abs_neg, abs_of_pos hh0, abs_inv, abs_of_pos hGpos,
        inv_mul_le_iff₀ hGpos]
      calc h * |heatK (h + 1) Z| ≤ h * ((h + 1) * Real.Gamma (1 + h)) :=
            mul_le_mul_of_nonneg_left (hKb.trans hG.le) hh0.le
        _ = Real.Gamma (1 + h) * (h * (h + 1)) := by ring
    have hdx := (tailHt_calculus h cinf x η hx0 h1 h2 hC hODE).1.deriv
    rw [← hZ] at hdx
    have hHt : tailHt h cinf x η = Real.sqrt 2 * cinf * x ^ (-h) * heatProfile h Z := by
      rw [hZ]; rfl
    have hxd : x * deriv (fun y => tailHt h cinf y η) x = Real.sqrt 2 * cinf * x ^ (-h) *
        (-(h * heatProfile h Z) - Z * deriv (heatProfile h) Z) := by
      rw [hdx]; field_simp
    rw [hHt, hxd]
    have hd1 := (abs_le.1 hdb).1
    have hZd : -(1 / 8 * (1 / 50)) ≤ Z * deriv (heatProfile h) Z := by
      have e1 : Z * (-(h * (h + 1))) ≤ Z * deriv (heatProfile h) Z :=
        mul_le_mul_of_nonneg_left hd1 hZ0.le
      have e2 : Z * (h * (h + 1)) ≤ 1 / 8 * (1 / 50) :=
        mul_le_mul hZ8 hhh (mul_nonneg hh0.le (by linarith)) (by norm_num)
      linarith
    constructor
    · nlinarith [mul_le_mul_of_nonneg_left hH hS.le]
    · have hpos : 0 ≤ (1 + h) * heatProfile h Z + Z * deriv (heatProfile h) Z := by
        nlinarith [mul_nonneg hh0.le (by linarith : (0:ℝ) ≤ heatProfile h Z)]
      have e : Real.sqrt 2 * cinf * x ^ (-h) * heatProfile h Z - Real.sqrt 2 * cinf * x ^ (-h) *
          (-(h * heatProfile h Z) - Z * deriv (heatProfile h) Z) = Real.sqrt 2 * cinf * x ^ (-h) *
          ((1 + h) * heatProfile h Z + Z * deriv (heatProfile h) Z) := by ring
      rw [e]; exact mul_nonneg hS.le hpos

  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = Real.sqrt 2 * cinf * Xb ^ (-h) := ⟨_, rfl⟩
  have hB : 0 < B := by
    rw [hBdef]
    exact mul_pos (mul_pos (Real.sqrt_pos.2 two_pos) hc0) (Real.rpow_pos_of_pos hXb0 _)
  have he3 : Real.exp 3 < 25 := by
    have h3 : Real.exp 3 = Real.exp 1 ^ 3 := by rw [← Real.exp_nat_mul]; norm_num
    rw [h3]
    calc Real.exp 1 ^ 3 < 2.7182818286 ^ 3 :=
          pow_lt_pow_left₀ Real.exp_one_lt_d9 (Real.exp_pos 1).le (by norm_num)
      _ < 25 := by norm_num
  have hQ : ∀ v : ℝ, 0 < v → v < 11 / 8 → 16 ≤ collarXu Xb v ∧ collarXu Xb v ≤ Xb ∧
      B ≤ Real.sqrt 2 * cinf * (collarXu Xb v) ^ (-h) := by
    intro v hv0 hv1
    have hE : 0 < Real.exp (-(2 * v)) := Real.exp_pos _
    have e1 : Real.exp (-(2 * v)) * Real.exp (2 * v) = 1 := by rw [← Real.exp_add]; simp
    have hlt : Real.exp (2 * v) < 25 := lt_trans (Real.exp_lt_exp.2 (by linarith)) he3
    have hx16 : 16 ≤ collarXu Xb v := by
      unfold collarXu
      nlinarith [mul_pos (sub_pos.2 hlt) hE, mul_nonneg (sub_nonneg.2 hXb) hE.le]
    have hxXb : collarXu Xb v ≤ Xb := by
      unfold collarXu
      exact mul_le_of_le_one_right hXb0.le (Real.exp_le_one_iff.2 (by linarith))
    refine ⟨hx16, hxXb, ?_⟩
    have hr := Real.rpow_le_rpow_of_nonpos (by linarith : (0:ℝ) < collarXu Xb v) hxXb
      (by linarith : -h ≤ 0)
    rw [hBdef]
    exact mul_le_mul_of_nonneg_left hr (mul_pos (Real.sqrt_pos.2 two_pos) hc0).le

  have hψ : ∀ v η : ℝ, 0 < v → v < 11 / 8 → -1 < η → η < 1 →
      B / 2 ≤ tailHt h cinf (collarXu Xb v) η ∧ 0 ≤ collarPsiTh h cinf Xb (v, η) ∧
      (v ≤ 1 / 2 → 4 * Real.exp (-4) * B ≤ collarPsiTh h cinf Xb (v, η)) := by
    intro v η hv0 hv1 h1 h2
    obtain ⟨hx16, hxXb, hSB⟩ := hQ v hv0 hv1
    obtain ⟨hHt, hD⟩ := hP (collarXu Xb v) η hx16 h1 h2
    have hHtB : B / 2 ≤ tailHt h cinf (collarXu Xb v) η := by linarith
    have hη2 : η ^ 2 < 1 := by nlinarith
    have hL0 : 0 ≤ 1 - 2 * h * η ^ 2 := by
      have : h * η ^ 2 ≤ h * 1 := mul_le_mul_of_nonneg_left hη2.le hh0.le
      linarith
    have hK : 8 * B ≤ 2 * (1 - 2 * h * η ^ 2) * (tailHt h cinf (collarXu Xb v) η -
        collarXu Xb v * deriv (fun y => tailHt h cinf y η) (collarXu Xb v)) +
        collarXu Xb v * tailHt h cinf (collarXu Xb v) η := by
      have a1 := mul_nonneg (mul_nonneg (by norm_num : (0:ℝ) ≤ 2) hL0) hD
      have a2 : 16 * (B / 2) ≤ collarXu Xb v * tailHt h cinf (collarXu Xb v) η :=
        mul_le_mul hx16 hHtB (by linarith) (by linarith)
      linarith
    have hψe : collarPsiTh h cinf Xb (v, η) = collarGam v * (2 * (1 - 2 * h * η ^ 2) *
        (tailHt h cinf (collarXu Xb v) η - collarXu Xb v * deriv (fun y => tailHt h cinf y η)
        (collarXu Xb v)) + collarXu Xb v * tailHt h cinf (collarXu Xb v) η) := rfl
    refine ⟨hHtB, ?_, ?_⟩
    · rw [hψe]; exact mul_nonneg (hγ0 v hv0) (by linarith)
    · intro hv
      rw [hψe]
      have hg := hγ4 v hv0 hv
      calc 4 * Real.exp (-4) * B = (Real.exp (-4) / 2) * (8 * B) := by ring
        _ ≤ _ := mul_le_mul hg hK (by linarith) (hγ0 v hv0)

  have hI : ∀ u η : ℝ, 0 < u → u < 11 / 8 → -1 < η → η < 1 →
      4 * Real.exp (-4) * B * Real.exp (-4) ≤ collarFlatInt (collarPsiTh h cinf Xb) (u, η) := by
    intro u η hu0 hu1 h1 h2
    have hw : ∀ t : ℝ, 0 < t → 0 < u / Real.sqrt (1 + u ^ 2 * t) ∧
        u / Real.sqrt (1 + u ^ 2 * t) ≤ u ∧ (4 < t → u / Real.sqrt (1 + u ^ 2 * t) < 1 / 2) := by
      intro t ht
      have hut := mul_pos (pow_pos hu0 2) ht
      have hs1 : 1 < Real.sqrt (1 + u ^ 2 * t) := by
        rw [Real.lt_sqrt zero_le_one]; nlinarith
      have hs0 : 0 < Real.sqrt (1 + u ^ 2 * t) := by linarith
      refine ⟨div_pos hu0 hs0, div_le_self hu0.le hs1.le, fun ht4 => ?_⟩
      rw [div_lt_iff₀ hs0]
      have h2u : 2 * u < Real.sqrt (1 + u ^ 2 * t) := by
        rw [Real.lt_sqrt (by linarith)]
        nlinarith [mul_lt_mul_of_pos_left ht4 (pow_pos hu0 2)]
      linarith
    have hmem : ∀ t : ℝ, 0 < t → ((u / Real.sqrt (1 + u ^ 2 * t), η) : ℝ × ℝ) ∈
        Ioo (0:ℝ) (11 / 8) ×ˢ Ioo (-1:ℝ) 1 := by
      intro t ht
      obtain ⟨a, b, -⟩ := hw t ht
      exact ⟨⟨a, by linarith⟩, h1, h2⟩
    have hcont : ContinuousOn (fun t : ℝ => Real.exp (-t) *
        collarPsiTh h cinf Xb (u / Real.sqrt (1 + u ^ 2 * t), η)) (Ioi 0) := by
      apply ContinuousOn.mul (by fun_prop : Continuous fun t : ℝ => Real.exp (-t)).continuousOn
      refine hψs.continuousOn.comp (ContinuousOn.prodMk ?_ continuousOn_const) ?_
      · apply ContinuousOn.div continuousOn_const
        · exact (by fun_prop : Continuous fun t : ℝ => Real.sqrt (1 + u ^ 2 * t)).continuousOn
        · intro t ht
          have hut := mul_pos (pow_pos hu0 2) (show (0:ℝ) < t from ht)
          exact (Real.sqrt_pos.2 (by linarith)).ne'
      · intro t _
        exact ⟨mem_univ _, h1, h2⟩
    have hInt : IntegrableOn (fun t : ℝ => Real.exp (-t) *
        collarPsiTh h cinf Xb (u / Real.sqrt (1 + u ^ 2 * t), η)) (Ioi 0) := by
      have hg : IntegrableOn (fun t : ℝ => Cψ * Real.exp (-t)) (Ioi 0) := by
        have he := exp_neg_integrableOn_Ioi 0 one_pos
        simp only [neg_mul, one_mul] at he
        exact Integrable.const_mul he Cψ
      refine Integrable.mono' hg (hcont.aestronglyMeasurable measurableSet_Ioi) ?_
      refine ae_restrict_of_forall_mem measurableSet_Ioi (fun t ht => ?_)
      have hb := hCψ _ (hmem t ht)
      rw [norm_iteratedFDeriv_zero] at hb
      rw [norm_mul, Real.norm_of_nonneg (Real.exp_pos _).le, mul_comm Cψ]
      exact mul_le_mul_of_nonneg_left hb (Real.exp_pos _).le
    have hpos : ∀ t : ℝ, 0 < t →
        0 ≤ collarPsiTh h cinf Xb (u / Real.sqrt (1 + u ^ 2 * t), η) := by
      intro t ht
      obtain ⟨a, b, -⟩ := hw t ht
      exact (hψ _ η a (by linarith) h1 h2).2.1
    show 4 * Real.exp (-4) * B * Real.exp (-4) ≤ ∫ t in Ioi (0:ℝ), Real.exp (-t) *
      collarPsiTh h cinf Xb (u / Real.sqrt (1 + u ^ 2 * t), η)
    calc 4 * Real.exp (-4) * B * Real.exp (-4)
        = ∫ t in Ioi (4:ℝ), 4 * Real.exp (-4) * B * Real.exp (-t) := by
          rw [integral_const_mul, integral_exp_neg_Ioi]
      _ ≤ ∫ t in Ioi (4:ℝ), Real.exp (-t) *
            collarPsiTh h cinf Xb (u / Real.sqrt (1 + u ^ 2 * t), η) := by
          apply setIntegral_mono_on
