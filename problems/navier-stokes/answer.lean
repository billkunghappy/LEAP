  have ht' : (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
      iteratedFDeriv ℝ k f (r, ζ.1, ζ.2.1, Y) (fun i => ((0:ℝ), (v i).1, (v i).2.1, (0 : ℝ × ℝ)))) =
      ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
        iteratedFDeriv ℝ k f (r, ζ.1, ζ.2.1, Y) (fun i => ((0:ℝ), (v i).1, (v i).2.1, (v i).2.2)) :=
