  have hV : Q ⁻¹' Iio B.qB ∈ nhds ξ.2.1 := hD.continuousAt.preimage_mem_nhds (Iio_mem_nhds hqlt)
  have hevF : ∀ᶠ y in nhds ξ.2.1, pcFa5 B l (ξ.1, y, ξ.2.2.1) =
      (Qb l ^ (1/2 + B.h) * Real.sqrt (Qb l) / ξ.1) * (Q y ^ (-(1/2 + B.h)) *
        logLift B.Eb (Real.log (Q y), ξ.1 ^ 2 / (2 * Q y), y * Q y ^ (-(1/2 - B.h)))) := by
    filter_upwards [hV] with y hy
    show pcB5 B l 1 (ξ.1, y, ξ.2.2.1) / (ξ.1 / Real.sqrt (Qb l)) = _
    rw [(hrepr y hy).1, div_div_eq_mul_div]
    ring
  have hevB : ∀ᶠ y in nhds ξ.2.1, pcB5 B l 2 (ξ.1, y, ξ.2.2.1) =
      Qb l ^ (1/2 + B.h) * (Q y ^ (-(1/2 + B.h)) *
        logLift B.Ub (Real.log (Q y), ξ.1 ^ 2 / (2 * Q y), y * Q y ^ (-(1/2 - B.h)))) := by
    filter_upwards [hV] with y hy
    exact (hrepr y hy).2
  have hfF := tA (pcFa5 B l) _ _ ξ.1 ξ.2.1 ξ.2.2.1
    (hGE.const_mul (Qb l ^ (1/2 + B.h) * Real.sqrt (Qb l) / ξ.1)) hevF
  have hfB := tA (pcB5 B l 2) _ _ ξ.1 ξ.2.1 ξ.2.2.1 (hGU.const_mul (Qb l ^ (1/2 + B.h))) hevB

  have hs0 : 0 < Real.sqrt (Qb l) := Real.sqrt_pos.mpr hQb
  have hss : Real.sqrt (Qb l) * Real.sqrt (Qb l) = Qb l := Real.mul_self_sqrt hQb.le
  have hP0 : 0 < Qb l ^ B.h := Real.rpow_pos_of_pos hQb _
  have hQa : Qb l ^ (1/2 + B.h) = Real.sqrt (Qb l) * Qb l ^ B.h := by
    rw [Real.rpow_add hQb, Real.sqrt_eq_rpow]
  have hGE2 : Qb l * |GE'| ≤ 2 * K := by
    have := mul_le_mul_of_nonneg_left hQbq.le (abs_nonneg GE')
    linarith
  have hGU2 : Qb l * |GU'| ≤ 2 * K := by
    have := mul_le_mul_of_nonneg_left hQbq.le (abs_nonneg GU')
    linarith
  have hr2 : Real.sqrt (B.Xa / 2) * Real.sqrt (Qb l) ≤ ξ.1 := by
    rw [← Real.sqrt_mul hXa2.le]
    have h1 : ξ.1 ^ 2 = 2 * Q ξ.2.1 * XC B.h ξ := by rw [hXv]; field_simp
    have h2 : B.Xa / 2 * (2 * Q ξ.2.1) ≤ XC B.h ξ * (2 * Q ξ.2.1) :=
      mul_le_mul_of_nonneg_right hX1 (by linarith)
    have h3 : B.Xa / 2 * Qb l ≤ B.Xa / 2 * (2 * Q ξ.2.1) := mul_le_mul_of_nonneg_left hQbq.le hXa2.le
    calc Real.sqrt (B.Xa / 2 * Qb l) ≤ Real.sqrt (ξ.1 ^ 2) := Real.sqrt_le_sqrt (by linarith)
      _ = ξ.1 := Real.sqrt_sq hDom.1.le
  have hsr : Real.sqrt (Qb l) / ξ.1 ≤ 1 / Real.sqrt (B.Xa / 2) := by
    rw [div_le_div_iff₀ hDom.1 hsXa]
    linarith
  have hsr0 : 0 ≤ Real.sqrt (Qb l) / ξ.1 := div_nonneg hs0.le hDom.1.le
  have hc0 : 0 ≤ Qb l ^ (1/2 + B.h) * Real.sqrt (Qb l) / ξ.1 :=
    div_nonneg (mul_nonneg (Real.rpow_pos_of_pos hQb _).le hs0.le) hDom.1.le
  have hc1 : 0 ≤ Qb l ^ (1/2 + B.h) := (Real.rpow_pos_of_pos hQb _).le
  have hfin : 2 * K ≤ 2 * K + 2 * K / Real.sqrt (B.Xa / 2) := by
    have : 0 ≤ 2 * K / Real.sqrt (B.Xa / 2) := by positivity
    linarith
  constructor
  · rw [abs_mul, abs_of_pos hs0]
    calc Real.sqrt (Qb l) * |fderiv ℝ (pcFa5 B l) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))|
        ≤ Real.sqrt (Qb l) * |Qb l ^ (1/2 + B.h) * Real.sqrt (Qb l) / ξ.1 * GE'| :=
          mul_le_mul_of_nonneg_left hfF hs0.le
      _ = (Real.sqrt (Qb l) * Real.sqrt (Qb l) * |GE'|) * (Real.sqrt (Qb l) / ξ.1) * Qb l ^ B.h := by
          rw [abs_mul, abs_of_nonneg hc0, hQa]; ring
      _ = (Qb l * |GE'|) * (Real.sqrt (Qb l) / ξ.1) * Qb l ^ B.h := by rw [hss]
      _ ≤ (2 * K) * (1 / Real.sqrt (B.Xa / 2)) * Qb l ^ B.h :=
          mul_le_mul_of_nonneg_right (mul_le_mul hGE2 hsr hsr0 (by linarith)) hP0.le
      _ ≤ (2 * K + 2 * K / Real.sqrt (B.Xa / 2)) * Qb l ^ B.h := by
          apply mul_le_mul_of_nonneg_right _ hP0.le
          rw [mul_one_div]
          linarith
  · rw [abs_mul, abs_of_pos hs0]
    calc Real.sqrt (Qb l) * |fderiv ℝ (pcB5 B l 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))|
        ≤ Real.sqrt (Qb l) * |Qb l ^ (1/2 + B.h) * GU'| := mul_le_mul_of_nonneg_left hfB hs0.le
      _ = (Real.sqrt (Qb l) * Real.sqrt (Qb l) * |GU'|) * Qb l ^ B.h := by
          rw [abs_mul, abs_of_nonneg hc1, hQa]; ring
      _ = (Qb l * |GU'|) * Qb l ^ B.h := by rw [hss]
      _ ≤ (2 * K) * Qb l ^ B.h := mul_le_mul_of_nonneg_right hGU2 hP0.le
      _ ≤ (2 * K + 2 * K / Real.sqrt (B.Xa / 2)) * Qb l ^ B.h := mul_le_mul_of_nonneg_right hfin hP0.le

theorem rep_lip_win5 : ∀ (B : BG), B.ok → ∃ L : ℝ, 0 ≤ L ∧ ∀ (X η ρ X0 η0 ρ0 : ℝ), B.Xa / 2 ≤ X → X ≤ 2 * B.Xb → -1 < η → η < 1 → 1/2 ≤ ρ → ρ ≤ 2 → B.Xa / 2 ≤ X0 → X0 ≤ 2 * B.Xb → -1 < η0 → η0 < 1 → 1/2 ≤ ρ0 → ρ0 ≤ 2 → |ρ ^ (-(1 + B.h)) * B.F X η - ρ0 ^ (-(1 + B.h)) * B.F X0 η0| + |ρ ^ (-(1 + B.h)) * (2 * X * deriv (fun Y => B.F Y η) X) - ρ0 ^ (-(1 + B.h)) * (2 * X0 * deriv (fun Y => B.F Y η0) X0)| + |ρ ^ (-(1 + B.h)) * (Real.sqrt (2 * X) * deriv (fun Y => B.U Y η) X) - ρ0 ^ (-(1 + B.h)) * (Real.sqrt (2 * X0) * deriv (fun Y => B.U Y η0) X0)| + |Real.sqrt (2 * X * ρ) - Real.sqrt (2 * X0 * ρ0)| ≤ L * (|X - X0| + |η - η0| + |ρ - ρ0|) :=
by
  intro B hB
  obtain ⟨hh0, hh1, hXa, hXam1, hm12, hm2Xb, -⟩ := hB.2.1
  obtain ⟨hFs, hUs, -, hbd⟩ := hB.2.2.1
  have hXb0 : 0 < B.Xb := by linarith
  have ha0 : 0 < B.Xa / 2 := by linarith

  have core : ∀ (F U : ℝ → ℝ → ℝ) (a b : ℝ), 0 < a →
      ContDiffOn ℝ ∞ (Function.uncurry F) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (Function.uncurry U) (Ioi 0 ×ˢ Ioo (-1) 1) →
      (∀ X₀ X₁ : ℝ, 0 < X₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, X₀ ≤ X → X ≤ X₁ → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ m (Function.uncurry F) (X, η)‖ ≤ C ∧
          ‖iteratedFDeriv ℝ m (Function.uncurry U) (X, η)‖ ≤ C) →
      ∃ C0 C1 C2 : ℝ, 0 ≤ C0 ∧ 0 ≤ C1 ∧ 0 ≤ C2 ∧
        ∀ X X' η η' : ℝ, a ≤ X → X ≤ b → a ≤ X' → X' ≤ b → -1 < η → η < 1 → -1 < η' → η' < 1 →
          |F X' η'| ≤ C0 ∧
          |F X η - F X' η'| ≤ C1 * (|X - X'| + |η - η'|) ∧
          |deriv (fun Y => F Y η') X'| ≤ C1 ∧
          |deriv (fun Y => F Y η) X - deriv (fun Y => F Y η') X'| ≤ C2 * (|X - X'| + |η - η'|) ∧
          |deriv (fun Y => U Y η') X'| ≤ C1 ∧
          |deriv (fun Y => U Y η) X - deriv (fun Y => U Y η') X'| ≤ C2 * (|X - X'| + |η - η'|) := by
    intro F U a b ha hFs hUs hbd
    obtain ⟨Cz, hCz⟩ := hbd a b ha 0
    obtain ⟨Ca, hCa⟩ := hbd a b ha 1
    obtain ⟨Cb, hCb⟩ := hbd a b ha 2
    have hO : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
    have hSc : Convex ℝ (Icc a b ×ˢ Ioo (-1:ℝ) 1) := (convex_Icc a b).prod (convex_Ioo (-1) 1)
    have hSO : ∀ z ∈ Icc a b ×ˢ Ioo (-1:ℝ) 1, z ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := fun z hz =>
      ⟨lt_of_lt_of_le ha hz.1.1, hz.2⟩
    have e1 : ‖((1:ℝ), (0:ℝ))‖ = 1 := by simp [Prod.norm_def]
    have mvt : ∀ f : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (Function.uncurry f) (Ioi 0 ×ˢ Ioo (-1) 1) →
        (∀ X η : ℝ, a ≤ X → X ≤ b → -1 < η → η < 1 →
          ‖iteratedFDeriv ℝ 1 (Function.uncurry f) (X, η)‖ ≤ max Ca 0 ∧
          ‖iteratedFDeriv ℝ 2 (Function.uncurry f) (X, η)‖ ≤ max Cb 0) →
        ∀ X X' η η' : ℝ, a ≤ X → X ≤ b → a ≤ X' → X' ≤ b → -1 < η → η < 1 → -1 < η' → η' < 1 →
        |f X η - f X' η'| ≤ max Ca 0 * (|X - X'| + |η - η'|) ∧
        deriv (fun Y => f Y η) X = fderiv ℝ (Function.uncurry f) (X, η) (1, 0) ∧
        |fderiv ℝ (Function.uncurry f) (X, η) (1, 0)| ≤ max Ca 0 ∧
        |fderiv ℝ (Function.uncurry f) (X, η) (1, 0) -
            fderiv ℝ (Function.uncurry f) (X', η') (1, 0)| ≤ max Cb 0 * (|X - X'| + |η - η'|) := by
      intro f hs hb X X' η η' h1 h2 h3 h4 h5 h6 h7 h8
      have hca : ∀ z ∈ Icc a b ×ˢ Ioo (-1:ℝ) 1, ContDiffAt ℝ ∞ (Function.uncurry f) z :=
        fun z hz => hs.contDiffAt (hO.mem_nhds (hSO z hz))
      have hd1 : ∀ z ∈ Icc a b ×ˢ Ioo (-1:ℝ) 1, DifferentiableAt ℝ (Function.uncurry f) z :=
        fun z hz => (hca z hz).differentiableAt (by simp)
      have hd2 : ∀ z ∈ Icc a b ×ˢ Ioo (-1:ℝ) 1,
          DifferentiableAt ℝ (fderiv ℝ (Function.uncurry f)) z := fun z hz =>
        ((hca z hz).fderiv_right (m := 1) (by simp)).differentiableAt (by norm_num)
      have hb1 : ∀ z ∈ Icc a b ×ˢ Ioo (-1:ℝ) 1, ‖fderiv ℝ (Function.uncurry f) z‖ ≤ max Ca 0 :=
        fun z hz => by
          rw [← norm_iteratedFDeriv_one]
          exact (hb z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).1
      have hb2 : ∀ z ∈ Icc a b ×ˢ Ioo (-1:ℝ) 1,
          ‖fderiv ℝ (fderiv ℝ (Function.uncurry f)) z‖ ≤ max Cb 0 := fun z hz => by
        rw [← norm_iteratedFDeriv_one, norm_iteratedFDeriv_fderiv]
        exact (hb z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).2
      have hz : ((X, η) : ℝ × ℝ) ∈ Icc a b ×ˢ Ioo (-1:ℝ) 1 := ⟨⟨h1, h2⟩, h5, h6⟩
      have hz' : ((X', η') : ℝ × ℝ) ∈ Icc a b ×ˢ Ioo (-1:ℝ) 1 := ⟨⟨h3, h4⟩, h7, h8⟩
      have hnorm : ‖((X, η) : ℝ × ℝ) - (X', η')‖ ≤ |X - X'| + |η - η'| := by
        rw [Prod.mk_sub_mk, Prod.norm_def, Real.norm_eq_abs, Real.norm_eq_abs]
        exact max_le (le_add_of_nonneg_right (abs_nonneg _)) (le_add_of_nonneg_left (abs_nonneg _))
      have hC1 : 0 ≤ max Ca 0 := le_max_right _ _
      have hC2 : 0 ≤ max Cb 0 := le_max_right _ _
      refine ⟨?_, ?_, ?_, ?_⟩
      · have := hSc.norm_image_sub_le_of_norm_fderiv_le hd1 hb1 hz' hz
        rw [Real.norm_eq_abs] at this
        exact this.trans (mul_le_mul_of_nonneg_left hnorm hC1)
      · have hF := (hd1 _ hz).hasFDerivAt
        have hc : HasDerivAt (fun Y : ℝ => (id Y, η)) ((1:ℝ), (0:ℝ)) X :=
          (hasDerivAt_id X).prodMk (hasDerivAt_const X η)
        exact (hF.comp_hasDerivAt X hc).deriv
      · calc |fderiv ℝ (Function.uncurry f) (X, η) (1, 0)|
            = ‖fderiv ℝ (Function.uncurry f) (X, η) (1, 0)‖ := (Real.norm_eq_abs _).symm
          _ ≤ ‖fderiv ℝ (Function.uncurry f) (X, η)‖ * ‖((1:ℝ), (0:ℝ))‖ :=
              ContinuousLinearMap.le_opNorm _ _
          _ ≤ max Ca 0 := by rw [e1, mul_one]; exact hb1 _ hz
      · have := hSc.norm_image_sub_le_of_norm_fderiv_le hd2 hb2 hz' hz
        calc |fderiv ℝ (Function.uncurry f) (X, η) (1, 0) -
              fderiv ℝ (Function.uncurry f) (X', η') (1, 0)|
            = ‖(fderiv ℝ (Function.uncurry f) (X, η) -
                fderiv ℝ (Function.uncurry f) (X', η')) (1, 0)‖ := by
              rw [Real.norm_eq_abs, ContinuousLinearMap.sub_apply]
          _ ≤ ‖fderiv ℝ (Function.uncurry f) (X, η) - fderiv ℝ (Function.uncurry f) (X', η')‖ *
                ‖((1:ℝ), (0:ℝ))‖ := ContinuousLinearMap.le_opNorm _ _
          _ ≤ max Cb 0 * (|X - X'| + |η - η'|) := by
              rw [e1, mul_one]; exact this.trans (mul_le_mul_of_nonneg_left hnorm hC2)
    have hbF : ∀ X η : ℝ, a ≤ X → X ≤ b → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ 1 (Function.uncurry F) (X, η)‖ ≤ max Ca 0 ∧
        ‖iteratedFDeriv ℝ 2 (Function.uncurry F) (X, η)‖ ≤ max Cb 0 := fun X η p q r s =>
      ⟨(hCa X η p q r s).1.trans (le_max_left _ _), (hCb X η p q r s).1.trans (le_max_left _ _)⟩
    have hbU : ∀ X η : ℝ, a ≤ X → X ≤ b → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ 1 (Function.uncurry U) (X, η)‖ ≤ max Ca 0 ∧
        ‖iteratedFDeriv ℝ 2 (Function.uncurry U) (X, η)‖ ≤ max Cb 0 := fun X η p q r s =>
      ⟨(hCa X η p q r s).2.trans (le_max_left _ _), (hCb X η p q r s).2.trans (le_max_left _ _)⟩
    refine ⟨max Cz 0, max Ca 0, max Cb 0, le_max_right _ _, le_max_right _ _, le_max_right _ _, ?_⟩
    intro X X' η η' h1 h2 h3 h4 h5 h6 h7 h8
    obtain ⟨F1, F2, -, F4⟩ := mvt F hFs hbF X X' η η' h1 h2 h3 h4 h5 h6 h7 h8
    obtain ⟨-, F2', F3', -⟩ := mvt F hFs hbF X' X η' η h3 h4 h1 h2 h7 h8 h5 h6
    obtain ⟨-, U2, -, U4⟩ := mvt U hUs hbU X X' η η' h1 h2 h3 h4 h5 h6 h7 h8
    obtain ⟨-, U2', U3', -⟩ := mvt U hUs hbU X' X η' η h3 h4 h1 h2 h7 h8 h5 h6
    have hF0 : |F X' η'| ≤ max Cz 0 := by
      have := (hCz X' η' h3 h4 h7 h8).1
      rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at this
      exact this.trans (le_max_left _ _)
    refine ⟨hF0, F1, ?_, ?_, ?_, ?_⟩
    · rw [F2']; exact F3'
    · rw [F2, F2']; exact F4
    · rw [U2']; exact U3'
    · rw [U2, U2']; exact U4
  obtain ⟨C0, C1, C2, hC0, hC1, hC2, hW⟩ :=
    core B.F B.U (B.Xa / 2) (2 * B.Xb) ha0 hFs hUs hbd

  have wbd : ∀ (e x : ℝ), 0 ≤ e → 1/2 ≤ x → x ^ (-e) ≤ (2:ℝ) ^ e := by
    intro e x he hx
    have hx0 : 0 < x := by linarith
    rw [Real.rpow_neg hx0.le, ← Real.inv_rpow hx0.le]
    apply Real.rpow_le_rpow (inv_nonneg.mpr hx0.le) _ he
    rw [inv_eq_one_div, div_le_iff₀ hx0]
    linarith
  have h8 : (2:ℝ) ^ (3:ℝ) = 8 := by
    rw [show (3:ℝ) = ((3:ℕ):ℝ) by norm_num, Real.rpow_natCast]; norm_num
  have wle : ∀ x : ℝ, 1/2 ≤ x → 0 < x ^ (-(1 + B.h)) ∧ x ^ (-(1 + B.h)) ≤ 4 := by
    intro x hx
    refine ⟨Real.rpow_pos_of_pos (by linarith) _, ?_⟩
    calc x ^ (-(1 + B.h)) ≤ (2:ℝ) ^ (1 + B.h) := wbd _ _ (by linarith) hx
      _ ≤ (2:ℝ) ^ (2:ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
      _ = 4 := by rw [Real.rpow_two]; norm_num
  have wlip : ∀ x y : ℝ, 1/2 ≤ x → x ≤ 2 → 1/2 ≤ y → y ≤ 2 →
      |y ^ (-(1 + B.h)) - x ^ (-(1 + B.h))| ≤ 16 * |y - x| := by
    intro x y hx1 hx2 hy1 hy2
    have hder : ∀ z ∈ Set.Icc (1/2:ℝ) 2, HasDerivAt (fun t : ℝ => t ^ (-(1 + B.h)))
        (-(1 + B.h) * z ^ (-(1 + B.h) - 1)) z := fun z hz =>
      Real.hasDerivAt_rpow_const (Or.inl (show (0:ℝ) < z by linarith [hz.1]).ne')
    have hb : ∀ z ∈ Set.Icc (1/2:ℝ) 2, ‖deriv (fun t : ℝ => t ^ (-(1 + B.h))) z‖ ≤ 16 := by
      intro z hz
      rw [(hder z hz).deriv, Real.norm_eq_abs, abs_mul]
      have e : -(1 + B.h) - 1 = -(2 + B.h) := by ring
      rw [e]
      have h1 : |-(1 + B.h)| ≤ 2 := by
        rw [abs_neg, abs_of_pos (show (0:ℝ) < 1 + B.h by linarith)]; linarith
      have h2 : |z ^ (-(2 + B.h))| ≤ 8 := by
        rw [abs_of_pos (Real.rpow_pos_of_pos (show (0:ℝ) < z by linarith [hz.1]) _)]
        calc z ^ (-(2 + B.h)) ≤ (2:ℝ) ^ (2 + B.h) := wbd _ _ (by linarith) hz.1
          _ ≤ (2:ℝ) ^ (3:ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
          _ = 8 := h8
      calc |-(1 + B.h)| * |z ^ (-(2 + B.h))| ≤ 2 * 8 :=
            mul_le_mul h1 h2 (abs_nonneg _) (by norm_num)
        _ = 16 := by norm_num
    have := (convex_Icc (1/2:ℝ) 2).norm_image_sub_le_of_norm_deriv_le
      (fun z hz => (hder z hz).differentiableAt) hb ⟨hx1, hx2⟩ ⟨hy1, hy2⟩
    simpa only [Real.norm_eq_abs] using this
  have prodD : ∀ a b a' b' Ma Mb da db : ℝ, |a| ≤ Ma → |b'| ≤ Mb → |a - a'| ≤ da → |b - b'| ≤ db →
      |a * b - a' * b'| ≤ Ma * db + Mb * da := by
    intro a b a' b' Ma Mb da db ha hb hda hdb
    have e : a * b - a' * b' = a * (b - b') + b' * (a - a') := by ring
    rw [e]
    refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
    · rw [abs_mul]; exact mul_le_mul ha hdb (abs_nonneg _) ((abs_nonneg _).trans ha)
    · rw [abs_mul]; exact mul_le_mul hb hda (abs_nonneg _) ((abs_nonneg _).trans hb)

  have hsXa : 0 < Real.sqrt B.Xa := Real.sqrt_pos.mpr hXa
  have hsa : 0 < Real.sqrt (B.Xa / 2) := Real.sqrt_pos.mpr ha0
  have hsb0 : 0 ≤ Real.sqrt (4 * B.Xb) := Real.sqrt_nonneg _
  have hK1 : 0 ≤ 4 * C1 + C0 * 16 := by positivity
  have hK2 : 0 ≤ 4 * (4 * B.Xb * C2 + 2 * C1) + 4 * B.Xb * C1 * 16 := by positivity
  have hK3 : 0 ≤ 4 * (Real.sqrt (4 * B.Xb) * C2 + C1 / Real.sqrt B.Xa) +
      Real.sqrt (4 * B.Xb) * C1 * 16 := by positivity
  have hK4 : 0 ≤ (4 + 4 * B.Xb) / (2 * Real.sqrt (B.Xa / 2)) := by positivity
  refine ⟨(4 * C1 + C0 * 16) + (4 * (4 * B.Xb * C2 + 2 * C1) + 4 * B.Xb * C1 * 16) +
      (4 * (Real.sqrt (4 * B.Xb) * C2 + C1 / Real.sqrt B.Xa) + Real.sqrt (4 * B.Xb) * C1 * 16) +
      (4 + 4 * B.Xb) / (2 * Real.sqrt (B.Xa / 2)), by linarith, ?_⟩
  intro X η ρ X0 η0 ρ0 hX1 hX2 hη1 hη2 hρ1 hρ2 hX01 hX02 hη01 hη02 hρ01 hρ02
  have hXS : |X - X0| ≤ |X - X0| + |η - η0| + |ρ - ρ0| := by
    linarith [abs_nonneg (η - η0), abs_nonneg (ρ - ρ0)]
  have hρS : |ρ - ρ0| ≤ |X - X0| + |η - η0| + |ρ - ρ0| := by
    linarith [abs_nonneg (η - η0), abs_nonneg (X - X0)]
  have hΔ : |X - X0| + |η - η0| ≤ |X - X0| + |η - η0| + |ρ - ρ0| := by
    linarith [abs_nonneg (ρ - ρ0)]
  have hS0 : 0 ≤ |X - X0| + |η - η0| + |ρ - ρ0| := by
    linarith [abs_nonneg (η - η0), abs_nonneg (X - X0), abs_nonneg (ρ - ρ0)]
  set S := |X - X0| + |η - η0| + |ρ - ρ0| with hS
  set sXa := Real.sqrt B.Xa with hsXadef
  set sa := Real.sqrt (B.Xa / 2) with hsadef
  set sb := Real.sqrt (4 * B.Xb) with hsbdef
  obtain ⟨aF', dF0, aP', dP0, aQ', dQ0⟩ := hW X X0 η η0 hX1 hX2 hX01 hX02 hη1 hη2 hη01 hη02
  have dF : |B.F X η - B.F X0 η0| ≤ C1 * S := dF0.trans (mul_le_mul_of_nonneg_left hΔ hC1)
  have dP : |deriv (fun Y => B.F Y η) X - deriv (fun Y => B.F Y η0) X0| ≤ C2 * S :=
    dP0.trans (mul_le_mul_of_nonneg_left hΔ hC2)
  have dQ : |deriv (fun Y => B.U Y η) X - deriv (fun Y => B.U Y η0) X0| ≤ C2 * S :=
    dQ0.trans (mul_le_mul_of_nonneg_left hΔ hC2)
  obtain ⟨w1, w2⟩ := wle ρ hρ1
  have aw : |ρ ^ (-(1 + B.h))| ≤ 4 := by rw [abs_of_pos w1]; exact w2
  have dw : |ρ ^ (-(1 + B.h)) - ρ0 ^ (-(1 + B.h))| ≤ 16 * S :=
    (wlip ρ0 ρ hρ01 hρ02 hρ1 hρ2).trans (mul_le_mul_of_nonneg_left hρS (by norm_num))

  have T1 : |ρ ^ (-(1 + B.h)) * B.F X η - ρ0 ^ (-(1 + B.h)) * B.F X0 η0| ≤
      4 * (C1 * S) + C0 * (16 * S) :=
    prodD _ _ _ _ _ _ _ _ aw aF' dw dF

  have aG' : |2 * X0 * deriv (fun Y => B.F Y η0) X0| ≤ 4 * B.Xb * C1 := by
    rw [abs_mul, abs_of_pos (by linarith : (0:ℝ) < 2 * X0)]
    exact mul_le_mul (by linarith) aP' (abs_nonneg _) (by linarith)
  have dG : |2 * X * deriv (fun Y => B.F Y η) X - 2 * X0 * deriv (fun Y => B.F Y η0) X0| ≤
      (4 * B.Xb * C2 + 2 * C1) * S := by
    have e : 2 * X * deriv (fun Y => B.F Y η) X - 2 * X0 * deriv (fun Y => B.F Y η0) X0 =
        2 * X * (deriv (fun Y => B.F Y η) X - deriv (fun Y => B.F Y η0) X0) +
          deriv (fun Y => B.F Y η0) X0 * (2 * (X - X0)) := by ring
    rw [e]
    refine (abs_add_le _ _).trans ?_
    have k1 : |2 * X * (deriv (fun Y => B.F Y η) X - deriv (fun Y => B.F Y η0) X0)| ≤
        4 * B.Xb * (C2 * S) := by
      rw [abs_mul (2 * X), abs_of_pos (by linarith : (0:ℝ) < 2 * X)]
      exact mul_le_mul (by linarith) dP (abs_nonneg _) (by linarith)
    have k2 : |deriv (fun Y => B.F Y η0) X0 * (2 * (X - X0))| ≤ C1 * (2 * S) := by
      rw [abs_mul, abs_mul (2:ℝ), abs_two]
      exact mul_le_mul aP' (by linarith) (by linarith [abs_nonneg (X - X0)]) hC1
    have e2 : (4 * B.Xb * C2 + 2 * C1) * S = 4 * B.Xb * (C2 * S) + C1 * (2 * S) := by ring
    linarith
  have T2 := prodD _ _ _ _ _ _ _ _ aw aG' dw dG

  have hs1 : sXa ≤ Real.sqrt (2 * X) := Real.sqrt_le_sqrt (by linarith)
  have hs2 : sXa ≤ Real.sqrt (2 * X0) := Real.sqrt_le_sqrt (by linarith)
  have hs3 : Real.sqrt (2 * X) ≤ sb := Real.sqrt_le_sqrt (by linarith)
  have hs4 : Real.sqrt (2 * X0) ≤ sb := Real.sqrt_le_sqrt (by linarith)
  have hsum : 0 < Real.sqrt (2 * X) + Real.sqrt (2 * X0) := by linarith
  have hsd : Real.sqrt (2 * X) - Real.sqrt (2 * X0) =
      2 * (X - X0) / (Real.sqrt (2 * X) + Real.sqrt (2 * X0)) := by
    rw [eq_div_iff hsum.ne']
    linear_combination (Real.sq_sqrt (show (0:ℝ) ≤ 2 * X by linarith)) -
      (Real.sq_sqrt (show (0:ℝ) ≤ 2 * X0 by linarith))
  have hsdb : |Real.sqrt (2 * X) - Real.sqrt (2 * X0)| ≤ S / sXa := by
    rw [hsd, abs_div, abs_of_pos hsum, abs_mul, abs_two]
    calc 2 * |X - X0| / (Real.sqrt (2 * X) + Real.sqrt (2 * X0)) ≤ 2 * S / (2 * sXa) :=
          div_le_div₀ (by linarith) (by linarith) (by linarith) (by linarith)
      _ = S / sXa := mul_div_mul_left _ _ two_ne_zero
  have aH' : |Real.sqrt (2 * X0) * deriv (fun Y => B.U Y η0) X0| ≤ sb * C1 := by
    rw [abs_mul, abs_of_nonneg (Real.sqrt_nonneg _)]
    exact mul_le_mul hs4 aQ' (abs_nonneg _) hsb0
  have dH : |Real.sqrt (2 * X) * deriv (fun Y => B.U Y η) X -
      Real.sqrt (2 * X0) * deriv (fun Y => B.U Y η0) X0| ≤ (sb * C2 + C1 / sXa) * S := by
    have e : Real.sqrt (2 * X) * deriv (fun Y => B.U Y η) X -
        Real.sqrt (2 * X0) * deriv (fun Y => B.U Y η0) X0 =
        Real.sqrt (2 * X) * (deriv (fun Y => B.U Y η) X - deriv (fun Y => B.U Y η0) X0) +
          deriv (fun Y => B.U Y η0) X0 * (Real.sqrt (2 * X) - Real.sqrt (2 * X0)) := by ring
    rw [e]
    refine (abs_add_le _ _).trans ?_
    have k1 : |Real.sqrt (2 * X) * (deriv (fun Y => B.U Y η) X - deriv (fun Y => B.U Y η0) X0)| ≤
        sb * (C2 * S) := by
      rw [abs_mul, abs_of_nonneg (Real.sqrt_nonneg _)]
      exact mul_le_mul hs3 dQ (abs_nonneg _) hsb0
    have k2 : |deriv (fun Y => B.U Y η0) X0 * (Real.sqrt (2 * X) - Real.sqrt (2 * X0))| ≤
        C1 * (S / sXa) := by
      rw [abs_mul]
      exact mul_le_mul aQ' hsdb (abs_nonneg _) hC1
    have e2 : (sb * C2 + C1 / sXa) * S = sb * (C2 * S) + C1 * (S / sXa) := by ring
    linarith
  have T3 := prodD _ _ _ _ _ _ _ _ aw aH' dw dH

  have ha : B.Xa / 2 ≤ 2 * X * ρ := by
    have := mul_nonneg (show (0:ℝ) ≤ X by linarith) (show (0:ℝ) ≤ ρ - 1/2 by linarith)
    linarith
  have hb : B.Xa / 2 ≤ 2 * X0 * ρ0 := by
    have := mul_nonneg (show (0:ℝ) ≤ X0 by linarith) (show (0:ℝ) ≤ ρ0 - 1/2 by linarith)
    linarith
  have sa1 : sa ≤ Real.sqrt (2 * X * ρ) := Real.sqrt_le_sqrt ha
  have sb1 : sa ≤ Real.sqrt (2 * X0 * ρ0) := Real.sqrt_le_sqrt hb
  have hsum2 : 0 < Real.sqrt (2 * X * ρ) + Real.sqrt (2 * X0 * ρ0) := by linarith
  have hsd2 : Real.sqrt (2 * X * ρ) - Real.sqrt (2 * X0 * ρ0) =
      (2 * X * ρ - 2 * X0 * ρ0) / (Real.sqrt (2 * X * ρ) + Real.sqrt (2 * X0 * ρ0)) := by
    rw [eq_div_iff hsum2.ne']
    linear_combination (Real.sq_sqrt (show (0:ℝ) ≤ 2 * X * ρ by linarith)) -
      (Real.sq_sqrt (show (0:ℝ) ≤ 2 * X0 * ρ0 by linarith))
  have hab : |2 * X * ρ - 2 * X0 * ρ0| ≤ (4 + 4 * B.Xb) * S := by
    have e : 2 * X * ρ - 2 * X0 * ρ0 = 2 * ρ * (X - X0) + 2 * X0 * (ρ - ρ0) := by ring
    rw [e]
    refine (abs_add_le _ _).trans ?_
    rw [abs_mul (2 * ρ) (X - X0), abs_mul (2 * X0) (ρ - ρ0),
      abs_of_pos (by linarith : (0:ℝ) < 2 * ρ),
      abs_of_pos (by linarith : (0:ℝ) < 2 * X0)]
    have k1 : 2 * ρ * |X - X0| ≤ 4 * S :=
      mul_le_mul (by linarith) hXS (abs_nonneg _) (by norm_num)
    have k2 : 2 * X0 * |ρ - ρ0| ≤ 4 * B.Xb * S :=
      mul_le_mul (by linarith) hρS (abs_nonneg _) (by linarith)
    linarith
  have T4 : |Real.sqrt (2 * X * ρ) - Real.sqrt (2 * X0 * ρ0)| ≤
      (4 + 4 * B.Xb) / (2 * sa) * S := by
    rw [hsd2, abs_div, abs_of_pos hsum2, div_mul_eq_mul_div]
    exact div_le_div₀ (mul_nonneg (by linarith) hS0) hab (by linarith) (by linarith)
  have hfin : ((4 * C1 + C0 * 16) + (4 * (4 * B.Xb * C2 + 2 * C1) + 4 * B.Xb * C1 * 16) +
      (4 * (sb * C2 + C1 / sXa) + sb * C1 * 16) + (4 + 4 * B.Xb) / (2 * sa)) * S =
      (4 * (C1 * S) + C0 * (16 * S)) +
      (4 * ((4 * B.Xb * C2 + 2 * C1) * S) + 4 * B.Xb * C1 * (16 * S)) +
      (4 * ((sb * C2 + C1 / sXa) * S) + sb * C1 * (16 * S)) +
      (4 + 4 * B.Xb) / (2 * sa) * S := by ring
  rw [hfin]
  linarith [T1, T2, T3, T4]

theorem ptrack_base_compare5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ (l2 : ℕ) (M : ℝ), ∀ (γ : Lab) (ξ : Cyl), l2 ≤ γ.1 → ActiveL4 B G γ → etaL B.h γ ξ ≠ 0 → ξ ∈ DomC B.h B.qB → |pcFa5 B γ.1 (ξ.1, ξ.2.1, ξ.2.2.1) - F0r5 B G γ| ≤ M * ((γ.1 : ℝ) ^ (-6 : ℤ) + qC B.h ξ ^ B.h) ∧ |pcRC5 γ.1 (ξ.1, ξ.2.1, ξ.2.2.1) * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))) - (g0r5 B G γ).1| ≤ M * ((γ.1 : ℝ) ^ (-6 : ℤ) + qC B.h ξ ^ B.h) ∧ |Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) - (g0r5 B G γ).2| ≤ M * ((γ.1 : ℝ) ^ (-6 : ℤ) + qC B.h ξ ^ B.h) ∧ |pcRC5 γ.1 (ξ.1, ξ.2.1, ξ.2.2.1) - R0r B G γ| ≤ M * ((γ.1 : ℝ) ^ (-6 : ℤ) + qC B.h ξ ^ B.h) ∧ |Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))| ≤ M * qC B.h ξ ^ B.h ∧ |Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))| ≤ M * qC B.h ξ ^ B.h :=
by
  intro B G hB hG
  obtain ⟨Cr, hCr0, hR⟩ := base_r_win5 B hB
  obtain ⟨Cz, hCz0, hZ⟩ := base_z_win5 B hB
  obtain ⟨L, hL0, hLip⟩ := rep_lip_win5 B hB
  have hh0 : 0 < B.h := hB.2.1.1
  have hh1 : B.h < 1 / 100 := hB.2.1.2.1
  have hXa : 0 < B.Xa := hB.2.1.2.2.1
  have hXab : B.Xa < B.Xb := by
    have := hB.2.1.2.2.2.1; have := hB.2.1.2.2.2.2.1; have := hB.2.1.2.2.2.2.2.1; linarith
  have hFpos : ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → 0 < B.F X η := hB.2.2.1.2.2.1
  have hCrep : 0 < G.Crep := hG.1.2.2.2.1
  have split3 : ∀ a b c K : ℝ, 0 ≤ a → 0 ≤ b → 0 ≤ c → a + b + c ≤ K → a ≤ K := by
    intro a b c K ha hb hc h; linarith
  have split4 : ∀ a b c d K : ℝ, 0 ≤ a → 0 ≤ b → 0 ≤ c → 0 ≤ d → a + b + c + d ≤ K →
      a ≤ K ∧ b ≤ K ∧ c ≤ K ∧ d ≤ K := by
    intro a b c d K ha hb hc hd h
    exact ⟨by linarith, by linarith, by linarith, by linarith⟩
  refine ⟨⌈2 * G.Crep / B.Xa⌉₊ + 1, 2 * Cr + 2 * Cz + L * G.Crep, ?_⟩
  intro γ ξ hl hact hη hdom

  have hl1 : 1 ≤ γ.1 := by omega
  have hℓ1 : (1:ℝ) ≤ (γ.1 : ℝ) := by exact_mod_cast hl1
  have hℓ0 : (0:ℝ) < (γ.1 : ℝ) := by linarith
  have hceil : 2 * G.Crep / B.Xa ≤ (γ.1 : ℝ) := by
    have h1 := Nat.le_ceil (2 * G.Crep / B.Xa)
    have h2 : ((⌈2 * G.Crep / B.Xa⌉₊ : ℕ) : ℝ) ≤ (γ.1 : ℝ) := by
      exact_mod_cast (by omega : ⌈2 * G.Crep / B.Xa⌉₊ ≤ γ.1)
    linarith
  have hCl : G.Crep * (γ.1 : ℝ)⁻¹ ≤ B.Xa / 2 := by
    rw [← div_eq_mul_inv, div_le_iff₀ hℓ0]
    rw [div_le_iff₀ hXa] at hceil
    linarith
  have he : Sb γ.1 ^ (-3:ℤ) = (γ.1 : ℝ) ^ (-6:ℤ) := by
    unfold Sb
    rw [← zpow_natCast, ← zpow_mul]
    norm_num
  have he6 : 0 < (γ.1 : ℝ) ^ (-6:ℤ) := zpow_pos hℓ0 _
  have he6le : (γ.1 : ℝ) ^ (-6:ℤ) ≤ (γ.1 : ℝ)⁻¹ := by
    rw [← zpow_neg_one]
    exact zpow_le_zpow_right₀ hℓ1 (by norm_num)

  have hτ : 0 < 1 - ξ.2.2.1 := by linarith [hdom.2.1]
  have hq : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
  have hband : 1/2 < qC B.h ξ / Qb γ.1 ∧ qC B.h ξ / Qb γ.1 < 2 := by
    have h1 : sqPart 1 (-(γ.1:ℤ)) (Real.logb 2 (qC B.h ξ)) ≠ 0 := by
      unfold etaL at hη
      exact left_ne_zero_of_mul hη
    unfold sqPart at h1
    have h2 := (div_ne_zero_iff.mp h1).1
    obtain ⟨x, hx⟩ : ∃ x : ℝ, x = Real.logb 2 (qC B.h ξ) + (γ.1:ℝ) := ⟨_, rfl⟩
    have hxe : Real.logb 2 (qC B.h ξ) / 1 - (((-(γ.1:ℤ)):ℤ):ℝ) = x := by
      rw [hx]; push_cast; ring
    rw [hxe] at h2
    unfold bumpR at h2
    have hx2 : 0 < 1 - x ^ 2 := by
      by_contra hc
      push_neg at hc
      exact h2 (Real.smoothTransition.zero_of_nonpos hc)
    have hx1 : x ^ 2 < 1 ^ 2 := by linarith
    have hxa := abs_lt_of_sq_lt_sq hx1 zero_le_one
    have hlo : -1 < x := by linarith [neg_abs_le x]
    have hhi : x < 1 := by linarith [le_abs_self x]
    have hr : qC B.h ξ / Qb γ.1 = (2:ℝ) ^ x := by
      unfold Qb
      rw [hx, Real.rpow_add (by norm_num), Real.rpow_logb (by norm_num) (by norm_num) hq,
        Real.rpow_neg (by norm_num), div_inv_eq_mul]
    rw [hr]
    constructor
    · have h3 := Real.rpow_lt_rpow_of_exponent_lt (by norm_num : (1:ℝ) < 2) hlo
      rw [Real.rpow_neg_one] at h3
      have e : (2:ℝ)⁻¹ = 1 / 2 := by norm_num
      linarith
    · have h3 := Real.rpow_lt_rpow_of_exponent_lt (by norm_num : (1:ℝ) < 2) hhi
      rwa [Real.rpow_one] at h3
  obtain ⟨hρ1, hρ2⟩ := hband
  have hz := (hB.1.2.1 ξ.2.1 (1 - ξ.2.2.1) hτ).2
  have hetaC : -1 < etaC B.h ξ ∧ etaC B.h ξ < 1 := by
    have hp : 0 < qC B.h ξ ^ (1/2 - B.h) := Real.rpow_pos_of_pos hq _
    have hp2 : (qC B.h ξ ^ (1/2 - B.h)) ^ 2 = qC B.h ξ ^ (1 - 2 * B.h) := by
      rw [sq, ← Real.rpow_add hq]; congr 1; ring
    have hz' : ξ.2.1 ^ 2 < (qC B.h ξ ^ (1/2 - B.h)) ^ 2 := by rw [hp2]; exact hz
    have habs := abs_lt_of_sq_lt_sq hz' hp.le
    have he' : etaC B.h ξ = ξ.2.1 / qC B.h ξ ^ (1/2 - B.h) := by
      rw [etaC, Real.rpow_neg hq.le, div_eq_mul_inv ξ.2.1]
    rw [he']
    constructor
    · rw [lt_div_iff₀ hp]; linarith [neg_abs_le ξ.2.1]
    · rw [div_lt_iff₀ hp]; linarith [le_abs_self ξ.2.1]

  obtain ⟨hX0l, hX0u, hη0, hρc1, hρc2, hrepξ⟩ := hG.2.2.1 γ hact
  have hS := hrepξ ξ hdom hη
  rw [he] at hS hη0
  obtain ⟨hη0a, hη0b⟩ := abs_le.mp hη0
  have hη0l : -1 < (G.rep γ).2.1 := by linarith
  have hη0u : (G.rep γ).2.1 < 1 := by linarith
  have hd1 : |XC B.h ξ - (G.rep γ).1| ≤ B.Xa / 2 := by
    have h1 := split3 _ _ _ _ (abs_nonneg _) (abs_nonneg _) (abs_nonneg _) hS
    have h3 : G.Crep * (γ.1 : ℝ) ^ (-6:ℤ) ≤ G.Crep * (γ.1 : ℝ)⁻¹ :=
      mul_le_mul_of_nonneg_left he6le hCrep.le
    linarith
  obtain ⟨hd1a, hd1b⟩ := abs_le.mp hd1
  have hXl : B.Xa / 2 ≤ XC B.h ξ := by linarith
  have hXu : XC B.h ξ ≤ 2 * B.Xb := by linarith

  obtain ⟨R1, R2, R3, R4⟩ := hR γ.1 ξ hdom hρ1 hρ2 hXl hXu
  obtain ⟨Z1, Z2⟩ := hZ γ.1 ξ hdom hρ1 hρ2 hXl hXu
  have hLp := hLip (XC B.h ξ) (etaC B.h ξ) (qC B.h ξ / Qb γ.1) (G.rep γ).1 (G.rep γ).2.1 (G.rep γ).2.2
    hXl hXu hetaC.1 hetaC.2 hρ1.le hρ2.le (by linarith) (by linarith) hη0l hη0u hρc1 hρc2
  have hLS : L * (|XC B.h ξ - (G.rep γ).1| + |etaC B.h ξ - (G.rep γ).2.1| +
      |qC B.h ξ / Qb γ.1 - (G.rep γ).2.2|) ≤ L * (G.Crep * (γ.1 : ℝ) ^ (-6:ℤ)) :=
    mul_le_mul_of_nonneg_left hS hL0
  obtain ⟨T1, T2, T3, T4⟩ := split4 _ _ _ _ _ (abs_nonneg _) (abs_nonneg _) (abs_nonneg _)
    (abs_nonneg _) (hLp.trans hLS)

  have hF0 : 0 < B.F (G.rep γ).1 (G.rep γ).2.1 := hFpos _ _ (by linarith) hη0l hη0u
  have hF0ne := hF0.ne'
  have hg1 : (g0r5 B G γ).1 = (G.rep γ).2.2 ^ (-(1 + B.h)) *
      (2 * (G.rep γ).1 * deriv (fun Y => B.F Y (G.rep γ).2.1) (G.rep γ).1) := by
    show F0r5 B G γ * -(shearA B.F (G.rep γ).1 (G.rep γ).2.1) = _
    unfold F0r5 shearA
    field_simp
    <;> ring
  have hg2 : (g0r5 B G γ).2 = (G.rep γ).2.2 ^ (-(1 + B.h)) *
      (Real.sqrt (2 * (G.rep γ).1) * deriv (fun Y => B.U Y (G.rep γ).2.1) (G.rep γ).1) := by
    show F0r5 B G γ * shearB B.F B.U (G.rep γ).1 (G.rep γ).2.1 = _
    unfold F0r5 shearB
    field_simp
    <;> ring
  have hR0 : R0r B G γ = Real.sqrt (2 * (G.rep γ).1 * (G.rep γ).2.2) := rfl
  have hF0r : F0r5 B G γ = (G.rep γ).2.2 ^ (-(1 + B.h)) * B.F (G.rep γ).1 (G.rep γ).2.1 := rfl

  have hQ0 : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have hQq : Qb γ.1 < 2 * qC B.h ξ := by
    rw [lt_div_iff₀ hQ0] at hρ1; linarith
  have hrate : Qb γ.1 ^ B.h ≤ 2 * qC B.h ξ ^ B.h := by
    calc Qb γ.1 ^ B.h ≤ (2 * qC B.h ξ) ^ B.h := Real.rpow_le_rpow hQ0.le hQq.le hh0.le
      _ = 2 ^ B.h * qC B.h ξ ^ B.h := Real.mul_rpow (by norm_num) hq.le
      _ ≤ 2 * qC B.h ξ ^ B.h := by
        apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hq.le _)
        calc (2:ℝ) ^ B.h ≤ 2 ^ (1:ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
          _ = 2 := Real.rpow_one 2
  have hP0 : 0 ≤ qC B.h ξ ^ B.h := Real.rpow_nonneg hq.le _
  have hCrr : Cr * Qb γ.1 ^ B.h ≤ Cr * (2 * qC B.h ξ ^ B.h) := mul_le_mul_of_nonneg_left hrate hCr0
  have hCzr : Cz * Qb γ.1 ^ B.h ≤ Cz * (2 * qC B.h ξ ^ B.h) := mul_le_mul_of_nonneg_left hrate hCz0
  have n1 : 0 ≤ Cr * (γ.1 : ℝ) ^ (-6:ℤ) := mul_nonneg hCr0 he6.le
  have n2 : 0 ≤ Cz * (γ.1 : ℝ) ^ (-6:ℤ) := mul_nonneg hCz0 he6.le
  have n3 : 0 ≤ Cz * qC B.h ξ ^ B.h := mul_nonneg hCz0 hP0
  have n4 : 0 ≤ L * G.Crep * qC B.h ξ ^ B.h := mul_nonneg (mul_nonneg hL0 hCrep.le) hP0
  have n5 : 0 ≤ Cr * qC B.h ξ ^ B.h := mul_nonneg hCr0 hP0
  have hM : (2 * Cr + 2 * Cz + L * G.Crep) * ((γ.1 : ℝ) ^ (-6:ℤ) + qC B.h ξ ^ B.h) =
      2 * (Cr * (γ.1 : ℝ) ^ (-6:ℤ)) + 2 * (Cr * qC B.h ξ ^ B.h) + 2 * (Cz * (γ.1 : ℝ) ^ (-6:ℤ)) +
        2 * (Cz * qC B.h ξ ^ B.h) + L * (G.Crep * (γ.1 : ℝ) ^ (-6:ℤ)) +
        L * G.Crep * qC B.h ξ ^ B.h := by ring
  have hM2 : (2 * Cr + 2 * Cz + L * G.Crep) * qC B.h ξ ^ B.h =
      2 * (Cr * qC B.h ξ ^ B.h) + 2 * (Cz * qC B.h ξ ^ B.h) + L * G.Crep * qC B.h ξ ^ B.h := by ring
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hF0r, hM]
    have := abs_sub_le (pcFa5 B γ.1 (ξ.1, ξ.2.1, ξ.2.2.1))
      ((qC B.h ξ / Qb γ.1) ^ (-(1 + B.h)) * B.F (XC B.h ξ) (etaC B.h ξ))
      ((G.rep γ).2.2 ^ (-(1 + B.h)) * B.F (G.rep γ).1 (G.rep γ).2.1)
    linarith
  · rw [hg1, hM]
    have := abs_sub_le (pcRC5 γ.1 (ξ.1, ξ.2.1, ξ.2.2.1) * (Real.sqrt (Qb γ.1) *
        fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))))
      ((qC B.h ξ / Qb γ.1) ^ (-(1 + B.h)) * (2 * XC B.h ξ * deriv (fun Y => B.F Y (etaC B.h ξ)) (XC B.h ξ)))
      ((G.rep γ).2.2 ^ (-(1 + B.h)) *
        (2 * (G.rep γ).1 * deriv (fun Y => B.F Y (G.rep γ).2.1) (G.rep γ).1))
    linarith
  · rw [hg2, hM]
    have := abs_sub_le (Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)))
      ((qC B.h ξ / Qb γ.1) ^ (-(1 + B.h)) *
        (Real.sqrt (2 * XC B.h ξ) * deriv (fun Y => B.U Y (etaC B.h ξ)) (XC B.h ξ)))
      ((G.rep γ).2.2 ^ (-(1 + B.h)) *
        (Real.sqrt (2 * (G.rep γ).1) * deriv (fun Y => B.U Y (G.rep γ).2.1) (G.rep γ).1))
    linarith
  · rw [R4, hR0, hM]
    linarith
  · rw [hM2]; linarith
  · rw [hM2]; linarith

theorem rep_consts_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ (l1 : ℕ) (c C : ℝ), 0 < c ∧ ∀ γ : Lab, ActiveL4 B G γ → l1 ≤ γ.1 → c ≤ |pzr5 B G γ| ∧ |pzr5 B G γ| ≤ C ∧ |pang5 B G γ| ≤ C ∧ |Bs5 B G γ| ≤ C :=
by
  intro B G hB hG

  have s1 : ∀ (h : ℝ) (l : ℕ), 1 ≤ l → 0 < cib h l ∧ cib h l * (l : ℝ) ^ 2 ≤ 1 := by
    intro h l hl
    have hL : (1:ℝ) ≤ (l:ℝ) := by exact_mod_cast hl
    have hL2 : (0:ℝ) < (l:ℝ) ^ 2 := by positivity
    have hT1 : (1:ℝ) < Tgc := by
      unfold Tgc
      have := Real.sqrt_nonneg 2
      linarith
    have hT0 : (0:ℝ) < Tgc := by linarith
    have hy0 : (0:ℝ) < (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) :=
      div_pos (Real.rpow_pos_of_pos two_pos _) hL2
    have hQ0 : 0 < Qb l := Real.rpow_pos_of_pos two_pos _
    have hQp : 0 < Qb l ^ (1 + h) := Real.rpow_pos_of_pos hQ0 _
    have hfl : ((bandIdx h l : ℤ) : ℝ) ≤
        Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2)) := Int.floor_le _
    have hz : Tgc ^ (bandIdx h l) ≤ (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) := by
      rw [← Real.rpow_intCast]
      calc Tgc ^ ((bandIdx h l : ℤ) : ℝ)
          ≤ Tgc ^ (Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2))) :=
            Real.rpow_le_rpow_of_exponent_le hT1.le hfl
        _ = (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) := Real.rpow_logb hT0 hT1.ne' hy0
    have hQe : Qb l ^ (1 + h) * (2:ℝ) ^ ((1 + h) * (l:ℝ)) = 1 := by
      unfold Qb
      rw [← Real.rpow_mul (by norm_num), ← Real.rpow_add two_pos]
      have e : -(l:ℝ) * (1 + h) + (1 + h) * (l:ℝ) = 0 := by ring
      rw [e, Real.rpow_zero]
    have hyL : (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) * (l:ℝ) ^ 2 =
        (2:ℝ) ^ ((1 + h) * (l:ℝ)) := div_mul_cancel₀ _ hL2.ne'
    refine ⟨mul_pos (zpow_pos hT0 _) hQp, ?_⟩
    unfold cib
    calc Tgc ^ (bandIdx h l) * Qb l ^ (1 + h) * (l:ℝ) ^ 2
        ≤ (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) * Qb l ^ (1 + h) * (l:ℝ) ^ 2 := by
          have := mul_le_mul_of_nonneg_right hz hQp.le
          exact mul_le_mul_of_nonneg_right this hL2.le
      _ = ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) * (l:ℝ) ^ 2) * Qb l ^ (1 + h) := by ring
      _ = 1 := by rw [hyL, mul_comm]; exact hQe

  have s2 : ∀ (h : ℝ) (l : ℕ), 0 ≤ h → 0 < epsb h l ∧ 1 ≤ (kb h l : ℝ) ∧
      1 ≤ epsb h l * (kb h l : ℝ) ^ 2 ∧ epsb h l * (kb h l : ℝ) ^ 2 ≤ 4 := by
    intro h l hh
    have hQ0 : 0 < Qb l := Real.rpow_pos_of_pos two_pos _
    have hQ1 : Qb l ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
    have he0 : 0 < epsb h l := Real.rpow_pos_of_pos hQ0 _
    have he1 : epsb h l ≤ 1 := Real.rpow_le_one hQ0.le hQ1 hh
    have hx1 : 1 ≤ epsb h l ^ (-(1/2:ℝ)) :=
      Real.one_le_rpow_of_pos_of_le_one_of_nonpos he0 he1 (by norm_num)
    have hxx : epsb h l * (epsb h l ^ (-(1/2:ℝ))) ^ 2 = 1 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul he0.le]
      have e : (-(1/2:ℝ)) * ((2:ℕ):ℝ) = -1 := by norm_num
      rw [e, Real.rpow_neg_one, mul_inv_cancel₀ he0.ne']
    have hk1 : epsb h l ^ (-(1/2:ℝ)) ≤ (kb h l : ℝ) := Nat.le_ceil _
    have hk2 : (kb h l : ℝ) < epsb h l ^ (-(1/2:ℝ)) + 1 := Nat.ceil_lt_add_one (by linarith)
    refine ⟨he0, by linarith, ?_, ?_⟩
    · have hsq : (epsb h l ^ (-(1/2:ℝ))) ^ 2 ≤ (kb h l : ℝ) ^ 2 :=
        pow_le_pow_left₀ (by linarith) hk1 2
      calc (1:ℝ) = epsb h l * (epsb h l ^ (-(1/2:ℝ))) ^ 2 := hxx.symm
        _ ≤ epsb h l * (kb h l : ℝ) ^ 2 := mul_le_mul_of_nonneg_left hsq he0.le
    · have hk0 : (0:ℝ) ≤ (kb h l : ℝ) := Nat.cast_nonneg _
      have hsq : (kb h l : ℝ) ^ 2 ≤ (2 * epsb h l ^ (-(1/2:ℝ))) ^ 2 :=
        pow_le_pow_left₀ hk0 (by linarith) 2
      calc epsb h l * (kb h l : ℝ) ^ 2 ≤ epsb h l * (2 * epsb h l ^ (-(1/2:ℝ))) ^ 2 :=
            mul_le_mul_of_nonneg_left hsq he0.le
        _ = 4 * (epsb h l * (epsb h l ^ (-(1/2:ℝ))) ^ 2) := by ring
        _ = 4 := by rw [hxx]; ring

  have s3 : ∀ (k p : ℝ) (z : ℤ), 1 ≤ k → (z = 1 ∨ z = round (k * p)) → |(z : ℝ) / k| ≤ |p| + 1 := by
    intro k p z hk hz
    have hk0 : 0 < k := by linarith
    rw [abs_div, abs_of_pos hk0, div_le_iff₀ hk0]
    rcases hz with rfl | rfl
    · push_cast
      rw [abs_one]
      nlinarith [abs_nonneg p]
    · have h1 := abs_sub_round (k * p)
      have h3 := abs_sub_abs_le_abs_sub ((round (k * p) : ℤ) : ℝ) (k * p)
      rw [abs_sub_comm] at h3
      rw [abs_mul, abs_of_pos hk0] at h3
      nlinarith [abs_nonneg p]

  have s4 : ∀ g : ℝ × ℝ, 0 < eN g → |g.1| ≤ eN g ∧ |g.2| ≤ eN g ∧ |((eN g)⁻¹ • g).1| ≤ 1 ∧
      |((eN g)⁻¹ • g).2| ≤ 1 := by
    intro g hE
    have a1 : |g.1| ≤ eN g := Real.abs_le_sqrt (by nlinarith [sq_nonneg g.2])
    have a2 : |g.2| ≤ eN g := Real.abs_le_sqrt (by nlinarith [sq_nonneg g.1])
    refine ⟨a1, a2, ?_, ?_⟩
    · rw [Prod.smul_fst, smul_eq_mul, abs_mul, abs_inv, abs_of_pos hE, inv_mul_le_iff₀ hE]
      linarith
    · rw [Prod.smul_snd, smul_eq_mul, abs_mul, abs_inv, abs_of_pos hE, inv_mul_le_iff₀ hE]
      linarith

  have s5 : ∀ (u r0 cf ci E x σ : ℝ) (l : ℕ), 0 < u → 0 < r0 → 0 < cf → cf ≤ E → |x| ≤ E → 0 < ci →
      ci * (l : ℝ) ^ 2 ≤ 1 → u / (r0 * cf ^ 2) ≤ (l : ℝ) ^ 2 → |σ| = 1 →
      |σ * u * x / (2 * r0 / ci * E ^ 2)| ≤ cf / 2 := by
    intro u r0 cf ci E x σ l hu hr0 hcf hcE hxE hci hcil hul hσ
    have hE0 : 0 < E := lt_of_lt_of_le hcf hcE
    have hLs0 : 0 < 2 * r0 / ci := div_pos (by linarith) hci
    have hD0 : 0 < 2 * r0 / ci * E ^ 2 := mul_pos hLs0 (by positivity)
    have hLs : 2 * r0 * (l:ℝ) ^ 2 ≤ 2 * r0 / ci := by
      rw [le_div_iff₀ hci]
      nlinarith
    have hu' : u ≤ r0 * cf ^ 2 * (l:ℝ) ^ 2 := by
      rw [div_le_iff₀ (by positivity)] at hul
      linarith
    rw [abs_div, abs_mul, abs_mul, hσ, abs_of_pos hu, abs_of_pos hD0, div_le_iff₀ hD0]
    have hl2 : (0:ℝ) ≤ (l:ℝ) ^ 2 := by positivity
    have h1 : u * |x| ≤ u * E := mul_le_mul_of_nonneg_left hxE hu.le
    have h2 : u * E ≤ r0 * cf ^ 2 * (l:ℝ) ^ 2 * E := mul_le_mul_of_nonneg_right hu' hE0.le
    have h3 : r0 * cf ^ 2 * (l:ℝ) ^ 2 * E ≤ r0 * cf * (l:ℝ) ^ 2 * E * E := by
      have hp : 0 ≤ r0 * cf * (l:ℝ) ^ 2 * E := by positivity
      have := mul_le_mul_of_nonneg_left hcE hp
      nlinarith
    have h4 : r0 * cf * (l:ℝ) ^ 2 * E * E ≤ cf / 2 * (2 * r0 / ci * E ^ 2) := by
      have hp : 0 ≤ cf / 2 * E ^ 2 := by positivity
      have := mul_le_mul_of_nonneg_left hLs hp
      nlinarith
    linarith

  obtain ⟨cf, Cf, hcf, hF⟩ := frame5_consts B G hB hG
  obtain ⟨hh, -, hXa, hm1, hm12, hm2, -⟩ := hB.2.1
  have hXb : 0 < B.Xb := by linarith
  obtain ⟨⟨hr0, -, hu, -⟩, -, hrep, -⟩ := hG
  have hDu : 1 ≤ (1 + G.ustar ^ 2) ^ (3/2:ℝ) :=
    Real.one_le_rpow (by nlinarith [sq_nonneg G.ustar]) (by norm_num)
  have hw0 : 0 ≤ Real.sqrt (4 * B.Xb) := Real.sqrt_nonneg _
  have hs0 : 0 ≤ Real.sqrt Cf := Real.sqrt_nonneg _
  refine ⟨⌈G.ustar / (G.r0 * cf ^ 2)⌉₊ + 1,
    Real.sqrt (cf / (4 * (1 + G.ustar ^ 2) ^ (3/2:ℝ))) * (cf / 2),
    (Real.sqrt (4 * B.Xb) + 1) * Real.sqrt Cf * (1 + cf) + 1,
    mul_pos (Real.sqrt_pos.mpr (div_pos hcf (by linarith))) (by linarith), ?_⟩
  intro γ hA hl
  obtain ⟨-, -, hE, -, hN1, hlam, hlamC, -⟩ := hF γ hA
  obtain ⟨hX0a, hX0b, -, hρ1, hρ2, -⟩ := hrep γ hA
  have hl1 : 1 ≤ γ.1 := by omega
  have hL1 : (1:ℝ) ≤ (γ.1:ℝ) := by exact_mod_cast hl1
  have hM : G.ustar / (G.r0 * cf ^ 2) ≤ (γ.1:ℝ) ^ 2 := by
    have h1 := Nat.le_ceil (G.ustar / (G.r0 * cf ^ 2))
    have h2 : ((⌈G.ustar / (G.r0 * cf ^ 2)⌉₊ + 1 : ℕ) : ℝ) ≤ (γ.1:ℝ) := by exact_mod_cast hl
    push_cast at h2
    nlinarith
  have hE0 : 0 < eN (g0r5 B G γ) := lt_of_lt_of_le hcf hE
  have hCf : cf ≤ Cf := le_trans hlam hlamC

  obtain ⟨he0, hk1, hP1, hP4⟩ := s2 B.h γ.1 hh.le
  have hPn : (0:ℝ) ≤ epsb B.h γ.1 * ((kb B.h γ.1 : ℝ)) ^ 2 := by linarith
  have hBsU : Bs5 B G γ ≤ Real.sqrt Cf := by
    unfold Bs5
    apply Real.sqrt_le_sqrt
    have hD1 : 1 ≤ epsb B.h γ.1 * ((kb B.h γ.1 : ℝ)) ^ 2 * (1 + G.ustar ^ 2) ^ (3/2:ℝ) := by
      have := mul_le_mul hP1 hDu zero_le_one hPn
      linarith
    calc lam0_5 B G γ / (epsb B.h γ.1 * ((kb B.h γ.1 : ℝ)) ^ 2 * (1 + G.ustar ^ 2) ^ (3/2:ℝ))
        ≤ lam0_5 B G γ := div_le_self (by linarith) hD1
      _ ≤ Cf := hlamC
  have hBsL : Real.sqrt (cf / (4 * (1 + G.ustar ^ 2) ^ (3/2:ℝ))) ≤ Bs5 B G γ := by
    unfold Bs5
    apply Real.sqrt_le_sqrt
    have hD0 : 0 < epsb B.h γ.1 * ((kb B.h γ.1 : ℝ)) ^ 2 * (1 + G.ustar ^ 2) ^ (3/2:ℝ) :=
      mul_pos (by linarith) (by linarith)
    have hD4 : epsb B.h γ.1 * ((kb B.h γ.1 : ℝ)) ^ 2 * (1 + G.ustar ^ 2) ^ (3/2:ℝ) ≤
        4 * (1 + G.ustar ^ 2) ^ (3/2:ℝ) := mul_le_mul_of_nonneg_right hP4 (by linarith)
    exact div_le_div₀ (by linarith) hlam hD0 hD4
  have hBs0 : 0 ≤ Bs5 B G γ := Real.sqrt_nonneg _

  obtain ⟨hci0, hciL⟩ := s1 B.h γ.1 hl1
  obtain ⟨hg1, hg2, hn1, hn2⟩ := s4 (g0r5 B G γ) hE0
  have hN1a : |(Nfr5 B G γ).1| ≤ 1 := hn1
  have hN2a : |(Nfr5 B G γ).2| ≤ 1 := hn2
  have hsg : |sgn γ.2.2| = 1 := by
    unfold sgn
    split_ifs <;> simp
  obtain ⟨sz, hpzE, hszb⟩ : ∃ sz : ℝ, pzr5 B G γ = Bs5 B G γ * ((Nfr5 B G γ).1 - sz) ∧
      |sz| ≤ cf / 2 :=
    ⟨_, rfl, s5 G.ustar G.r0 cf (cib B.h γ.1) (eN (g0r5 B G γ)) _ (sgn γ.2.2) γ.1 hu hr0 hcf hE hg2
      hci0 hciL hM hsg⟩
  obtain ⟨sr, hptE, hsrb⟩ : ∃ sr : ℝ, ptil5 B G γ = R0r B G γ * Bs5 B G γ * (-(Nfr5 B G γ).2 - sr) ∧
      |sr| ≤ cf / 2 :=
    ⟨_, rfl, s5 G.ustar G.r0 cf (cib B.h γ.1) (eN (g0r5 B G γ)) _ (sgn γ.2.2) γ.1 hu hr0 hcf hE hg1
      hci0 hciL hM hsg⟩
  obtain ⟨hsz1, hsz2⟩ := abs_le.mp hszb
  obtain ⟨hsr1, hsr2⟩ := abs_le.mp hsrb
  obtain ⟨hn11, hn12⟩ := abs_le.mp hN1a
  obtain ⟨hn21, hn22⟩ := abs_le.mp hN2a

  have hlow : cf / 2 ≤ |(Nfr5 B G γ).1 - sz| := le_abs.mpr (Or.inr (by linarith))
  have hupz : |(Nfr5 B G γ).1 - sz| ≤ 1 + cf / 2 := abs_le.mpr ⟨by linarith, by linarith⟩
  have hpzA : |pzr5 B G γ| = Bs5 B G γ * |(Nfr5 B G γ).1 - sz| := by
    rw [hpzE, abs_mul, abs_of_nonneg hBs0]
  have hpz_low : Real.sqrt (cf / (4 * (1 + G.ustar ^ 2) ^ (3/2:ℝ))) * (cf / 2) ≤ |pzr5 B G γ| := by
    rw [hpzA]
    exact mul_le_mul hBsL hlow (by linarith) hBs0
  have hpz_up : |pzr5 B G γ| ≤ Real.sqrt Cf * (1 + cf / 2) := by
    rw [hpzA]
    exact mul_le_mul hBsU hupz (abs_nonneg _) hs0

  have hR0 : 0 ≤ R0r B G γ := Real.sqrt_nonneg _
  have hRb : R0r B G γ ≤ Real.sqrt (4 * B.Xb) := by
    unfold R0r
    apply Real.sqrt_le_sqrt
    have hX0 : 0 ≤ (G.rep γ).1 := by linarith
    have := mul_le_mul_of_nonneg_left hρ2 hX0
    nlinarith
  have hupr : |-(Nfr5 B G γ).2 - sr| ≤ 1 + cf / 2 := abs_le.mpr ⟨by linarith, by linarith⟩
  have hpt : |ptil5 B G γ| ≤ Real.sqrt (4 * B.Xb) * Real.sqrt Cf * (1 + cf / 2) := by
    rw [hptE, abs_mul, abs_mul, abs_of_nonneg hR0, abs_of_nonneg hBs0]
    exact mul_le_mul (mul_le_mul hRb hBsU hBs0 hw0) hupr (abs_nonneg _) (mul_nonneg hw0 hs0)
  have hpang : |pang5 B G γ| ≤ |ptil5 B G γ| + 1 := by
    unfold pang5
    apply s3 (kb B.h γ.1 : ℝ) (ptil5 B G γ) (pint5 B G γ) hk1
    unfold pint5
    split_ifs
    · exact Or.inl rfl
    · exact Or.inr rfl
  have hws : 0 ≤ Real.sqrt (4 * B.Xb) * Real.sqrt Cf := mul_nonneg hw0 hs0
  refine ⟨hpz_low, ?_, ?_, ?_⟩
  · nlinarith [mul_nonneg hws (show (0:ℝ) ≤ 1 + cf by linarith), mul_nonneg hs0 hcf.le]
  · nlinarith [mul_nonneg hws hcf.le, mul_nonneg hs0 (show (0:ℝ) ≤ 1 + cf by linarith)]
  · rw [abs_of_nonneg hBs0]
    nlinarith [mul_nonneg hws (show (0:ℝ) ≤ 1 + cf by linarith), mul_nonneg hs0 hcf.le]

theorem line_alg5 : ∀ (A eg g1 g2 Bs u sg Ls v RC R0 RFa RB ZFa ZB pang ptil pz eps E : ℝ), 1 ≤ A → 0 < eg → eg ^ 2 = g1 ^ 2 + g2 ^ 2 → 1 / A ≤ eg → eg ≤ A → |Bs| ≤ A → |u| ≤ A → (sg = 1 ∨ sg = -1) → 1 ≤ Ls → 0 ≤ v → v ≤ Ls → 1 / A ≤ RC → |R0| ≤ A → 0 ≤ eps → eps ≤ 1 → 0 ≤ E → E ≤ 1 → ptil = R0 * (Bs * (-(eg⁻¹ * g2) - sg * u * g1 / (Ls * eg ^ 2))) → pz = Bs * (eg⁻¹ * g1 - sg * u * g2 / (Ls * eg ^ 2)) → |pang - ptil| ≤ eps → |R0 - RC| ≤ E → |RC * RFa - g1| ≤ E → |RB - g2| ≤ E → |ZFa| ≤ E → |ZB| ≤ E → |sg * Bs * u / 2 - v * (pang * RFa + pz * RB) - Bs * (sg * (u / 2 + u * v / Ls))| ≤ 30 * A ^ 5 * Ls * (eps + E) ∧ |pang / RC - Bs * (-(eg⁻¹ * g2))| ≤ 30 * A ^ 5 * (eps + E + 1 / Ls) ∧ |pz - v * (pang * ZFa + pz * ZB) - Bs * (eg⁻¹ * g1)| ≤ 30 * A ^ 5 * (1 / Ls + Ls * E) ∧ |-(pang * RFa + pz * RB)| ≤ 30 * A ^ 5 ∧ |-(pang * ZFa + pz * ZB)| ≤ 30 * A ^ 5 :=
by
  intro A eg g1 g2 Bs u sg Ls v RC R0 RFa RB ZFa ZB pang ptil pz eps E hA heg heg2 hegl hegu hBs hu
    hsg hLs hv0 hvL hRCl hR0 heps0 heps1 hE0 hE1 hptil hpz hpe hRe hRFe hRBe hZF hZB

  have hmul : ∀ x y X Y : ℝ, |x| ≤ X → |y| ≤ Y → |x * y| ≤ X * Y := fun x y X Y hx hy => by
    rw [abs_mul]; exact mul_le_mul hx hy (abs_nonneg _) ((abs_nonneg _).trans hx)
  have hadd : ∀ x y X Y : ℝ, |x| ≤ X → |y| ≤ Y → |x + y| ≤ X + Y := fun x y X Y hx hy =>
    abs_le.mpr ⟨by linarith [(abs_le.mp hx).1, (abs_le.mp hy).1],
      by linarith [(abs_le.mp hx).2, (abs_le.mp hy).2]⟩
  have hsub : ∀ x y X Y : ℝ, |x| ≤ X → |y| ≤ Y → |x - y| ≤ X + Y := fun x y X Y hx hy =>
    abs_le.mpr ⟨by linarith [(abs_le.mp hx).1, (abs_le.mp hy).2],
      by linarith [(abs_le.mp hx).2, (abs_le.mp hy).1]⟩

  have hA0 : 0 < A := by linarith
  have hp1 : A ≤ A ^ 5 := by
    have := pow_le_pow_right₀ hA (show 1 ≤ 5 by norm_num); rwa [pow_one] at this
  have hp2 : A ^ 2 ≤ A ^ 5 := pow_le_pow_right₀ hA (by norm_num)
  have hp3 : A ^ 3 ≤ A ^ 5 := pow_le_pow_right₀ hA (by norm_num)
  have hp4 : A ^ 4 ≤ A ^ 5 := pow_le_pow_right₀ hA (by norm_num)
  have h13 : A ≤ A ^ 3 := by
    have := pow_le_pow_right₀ hA (show 1 ≤ 3 by norm_num); rwa [pow_one] at this
  have h12 : A ≤ A ^ 2 := by
    have := pow_le_pow_right₀ hA (show 1 ≤ 2 by norm_num); rwa [pow_one] at this
  have h14 : 1 ≤ A ^ 4 := one_le_pow₀ hA
  have hA5 : 0 ≤ A ^ 5 := by positivity
  have hk0 : 0 < eg⁻¹ := inv_pos.mpr heg
  have hku : eg⁻¹ ≤ A := by
    rw [one_div] at hegl; exact inv_le_of_inv_le₀ hA0 hegl
  have hkeg : eg⁻¹ * eg = 1 := inv_mul_cancel₀ heg.ne'
  have hRC0 : 0 < RC := lt_of_lt_of_le (by positivity) hRCl
  have hRCi0 : 0 < RC⁻¹ := inv_pos.mpr hRC0
  have hRCiu : RC⁻¹ ≤ A := by
    rw [one_div] at hRCl; exact inv_le_of_inv_le₀ hA0 hRCl
  have hRCinv : RC * RC⁻¹ = 1 := mul_inv_cancel₀ hRC0.ne'
  have hL0 : 0 < Ls := by linarith
  have hLi0 : 0 < Ls⁻¹ := inv_pos.mpr hL0
  have hLi1 : Ls⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hLs
  have hsg1 : |sg| ≤ 1 := by rcases hsg with h | h <;> simp [h]
  have hg1 : |g1| ≤ eg := abs_le_of_sq_le_sq (by linarith [sq_nonneg g2]) heg.le
  have hg2 : |g2| ≤ eg := abs_le_of_sq_le_sq (by linarith [sq_nonneg g1]) heg.le
  have hg1A : |g1| ≤ A := hg1.trans hegu
  have hkA : |eg⁻¹| ≤ A := by rw [abs_of_pos hk0]; exact hku
  have hRCiA : |RC⁻¹| ≤ A := by rw [abs_of_pos hRCi0]; exact hRCiu
  have hLiA : |Ls⁻¹| ≤ Ls⁻¹ := le_of_eq (abs_of_pos hLi0)

  have hw1 : |eg⁻¹ * g1| ≤ 1 := by
    rw [abs_mul, abs_of_pos hk0]
    calc eg⁻¹ * |g1| ≤ eg⁻¹ * eg := mul_le_mul_of_nonneg_left hg1 hk0.le
      _ = 1 := hkeg
  have hw2 : |eg⁻¹ * g2| ≤ 1 := by
    rw [abs_mul, abs_of_pos hk0]
    calc eg⁻¹ * |g2| ≤ eg⁻¹ * eg := mul_le_mul_of_nonneg_left hg2 hk0.le
      _ = 1 := hkeg
  have ha : |sg * u * eg⁻¹ * Ls⁻¹| ≤ A ^ 2 * Ls⁻¹ := by
    have h3 := hmul _ _ _ _ (hmul _ _ _ _ (hmul _ _ _ _ hsg1 hu) hkA) hLiA
    calc _ ≤ 1 * A * A * Ls⁻¹ := h3
      _ = A ^ 2 * Ls⁻¹ := by ring
  have haA : |sg * u * eg⁻¹ * Ls⁻¹| ≤ A ^ 2 := by
    have : A ^ 2 * Ls⁻¹ ≤ A ^ 2 * 1 := mul_le_mul_of_nonneg_left hLi1 (by positivity)
    linarith
  have haw1 : |sg * u * eg⁻¹ * Ls⁻¹ * (eg⁻¹ * g1)| ≤ A ^ 2 * Ls⁻¹ * 1 := hmul _ _ _ _ ha hw1
  have haw2 : |sg * u * eg⁻¹ * Ls⁻¹ * (eg⁻¹ * g2)| ≤ A ^ 2 * Ls⁻¹ * 1 := hmul _ _ _ _ ha hw2

  obtain ⟨T, hTd⟩ : ∃ T : ℝ,
      T = Bs * (-(eg⁻¹ * g2) - sg * u * eg⁻¹ * Ls⁻¹ * (eg⁻¹ * g1)) := ⟨_, rfl⟩
  have hptT : ptil = R0 * T := by rw [hptil, hTd]; ring
  have hpzT : pz = Bs * (eg⁻¹ * g1 - sg * u * eg⁻¹ * Ls⁻¹ * (eg⁻¹ * g2)) := by rw [hpz]; ring
  have hw2n : |-(eg⁻¹ * g2)| ≤ 1 := by rw [abs_neg]; exact hw2
  have hBaw1 : |-(Bs * (sg * u * eg⁻¹ * Ls⁻¹ * (eg⁻¹ * g1)))| ≤ A * (A ^ 2 * Ls⁻¹ * 1) := by
    rw [abs_neg]; exact hmul _ _ _ _ hBs haw1
  have hBaw2 : |-(Bs * (sg * u * eg⁻¹ * Ls⁻¹ * (eg⁻¹ * g2)))| ≤ A * (A ^ 2 * Ls⁻¹ * 1) := by
    rw [abs_neg]; exact hmul _ _ _ _ hBs haw2
  have hTb : |T| ≤ 2 * A ^ 3 := by
    have h := hmul _ _ _ _ hBs
      (hsub _ _ _ _ hw2n (hmul _ _ _ _ haA hw1))
    rw [← hTd] at h
    linarith
  have hpzb : |pz| ≤ 2 * A ^ 3 := by
    have h := hmul _ _ _ _ hBs (hsub _ _ _ _ hw1 (hmul _ _ _ _ haA hw2))
    rw [← hpzT] at h
    linarith
  have hpang : |pang| ≤ 3 * A ^ 4 := by
    have h1 := hmul _ _ _ _ hR0 hTb
    rw [← hptT] at h1
    have h2 := hadd _ _ _ _ hpe h1
    rw [sub_add_cancel] at h2
    linarith

  have hRFa : |RFa| ≤ 2 * A ^ 2 := by
    have h1 := hadd _ _ _ _ hRFe hg1A
    rw [sub_add_cancel] at h1
    have h2 : |RC * RFa| ≤ 2 * A := by linarith
    have h3 := hmul _ _ _ _ hRCiA h2
    rw [inv_mul_cancel_left₀ hRC0.ne'] at h3
    linarith

  have hslope : T * g1 + pz * g2 = -(Bs * sg * u * Ls⁻¹) := by
    rw [hTd, hpzT]
    linear_combination (-(Bs * sg * u * Ls⁻¹) * (1 + eg⁻¹ * eg)) * hkeg
      + (Bs * sg * u * Ls⁻¹ * eg⁻¹ ^ 2) * heg2

  have hDeq : pang * RFa + pz * RB + Bs * sg * u * Ls⁻¹ =
      (pang - ptil) * RFa + T * (R0 - RC) * RFa + T * (RC * RFa - g1) + pz * (RB - g2) := by
    linear_combination hslope + RFa * hptT
  have hD : |pang * RFa + pz * RB + Bs * sg * u * Ls⁻¹| ≤ 2 * A ^ 5 * eps + 8 * A ^ 5 * E := by
    rw [hDeq]
    have h := hadd _ _ _ _ (hadd _ _ _ _ (hadd _ _ _ _ (hmul _ _ _ _ hpe hRFa)
      (hmul _ _ _ _ (hmul _ _ _ _ hTb hRe) hRFa)) (hmul _ _ _ _ hTb hRFe)) (hmul _ _ _ _ hpzb hRBe)
    have e1 : A ^ 2 * eps ≤ A ^ 5 * eps := mul_le_mul_of_nonneg_right hp2 heps0
    have e2 : A ^ 3 * E ≤ A ^ 5 * E := mul_le_mul_of_nonneg_right hp3 hE0
    linarith
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  ·
    have heq : sg * Bs * u / 2 - v * (pang * RFa + pz * RB) - Bs * (sg * (u / 2 + u * v / Ls)) =
        -(v * (pang * RFa + pz * RB + Bs * sg * u * Ls⁻¹)) := by ring
    rw [heq, abs_neg]
    have hv : |v| ≤ Ls := by rw [abs_of_nonneg hv0]; exact hvL
    have h := hmul _ _ _ _ hv hD
    have n1 : 0 ≤ Ls * A ^ 5 * eps := by positivity
    have n2 : 0 ≤ Ls * A ^ 5 * E := by positivity
    linarith
  ·
    have heq : pang / RC - Bs * (-(eg⁻¹ * g2)) =
        (pang - ptil) * RC⁻¹ + (R0 - RC) * T * RC⁻¹
          + -(Bs * (sg * u * eg⁻¹ * Ls⁻¹ * (eg⁻¹ * g1))) := by
      rw [div_eq_mul_inv]
      linear_combination RC⁻¹ * hptT + T * hRCinv + hTd
    rw [heq]
    have h := hadd _ _ _ _ (hadd _ _ _ _ (hmul _ _ _ _ hpe hRCiA)
      (hmul _ _ _ _ (hmul _ _ _ _ hRe hTb) hRCiA))
      hBaw1
    have e1 : A * eps ≤ A ^ 5 * eps := mul_le_mul_of_nonneg_right hp1 heps0
    have e2 : A ^ 4 * E ≤ A ^ 5 * E := mul_le_mul_of_nonneg_right hp4 hE0
    have e3 : A ^ 3 * Ls⁻¹ ≤ A ^ 5 * Ls⁻¹ := mul_le_mul_of_nonneg_right hp3 hLi0.le
    have n1 : 0 ≤ A ^ 5 * eps := by positivity
    have n2 : 0 ≤ A ^ 5 * E := by positivity
    have n3 : 0 ≤ A ^ 5 * Ls⁻¹ := by positivity
    rw [one_div]
    linarith
  ·
    have heq : pz - v * (pang * ZFa + pz * ZB) - Bs * (eg⁻¹ * g1) =
        -(Bs * (sg * u * eg⁻¹ * Ls⁻¹ * (eg⁻¹ * g2))) - v * (pang * ZFa + pz * ZB) := by
      linear_combination hpzT
    rw [heq]
    have hv : |v| ≤ Ls := by rw [abs_of_nonneg hv0]; exact hvL
    have hPsi := hadd _ _ _ _ (hmul _ _ _ _ hpang hZF) (hmul _ _ _ _ hpzb hZB)
    have h := hsub _ _ _ _ hBaw2 (hmul _ _ _ _ hv hPsi)
    have e1 : Ls * (A ^ 4 * E) ≤ Ls * (A ^ 5 * E) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hp4 hE0) hL0.le
    have e2 : Ls * (A ^ 3 * E) ≤ Ls * (A ^ 5 * E) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hp3 hE0) hL0.le
    have e3 : A ^ 3 * Ls⁻¹ ≤ A ^ 5 * Ls⁻¹ := mul_le_mul_of_nonneg_right hp3 hLi0.le
    have n2 : 0 ≤ Ls * (A ^ 5 * E) := by positivity
    have n3 : 0 ≤ A ^ 5 * Ls⁻¹ := by positivity
    rw [one_div]
    linarith
  ·
    have heq : -(pang * RFa + pz * RB) =
        Bs * sg * u * Ls⁻¹ - (pang * RFa + pz * RB + Bs * sg * u * Ls⁻¹) := by ring
    rw [heq]
    have hc := hmul _ _ _ _ (hmul _ _ _ _ (hmul _ _ _ _ hBs hsg1) hu) hLiA
    have h := hsub _ _ _ _ hc hD
    have e1 : A ^ 5 * eps ≤ A ^ 5 := mul_le_of_le_one_right hA5 heps1
    have e2 : A ^ 5 * E ≤ A ^ 5 := mul_le_of_le_one_right hA5 hE1
    have e3 : A * 1 * A * Ls⁻¹ ≤ A ^ 2 := by
      have : A ^ 2 * Ls⁻¹ ≤ A ^ 2 * 1 := mul_le_mul_of_nonneg_left hLi1 (by positivity)
      calc A * 1 * A * Ls⁻¹ = A ^ 2 * Ls⁻¹ := by ring
        _ ≤ A ^ 2 := by linarith
    linarith
  ·
    rw [abs_neg]
    have hPsi := hadd _ _ _ _ (hmul _ _ _ _ hpang hZF) (hmul _ _ _ _ hpzb hZB)
    have e1 : A ^ 4 * E ≤ A ^ 5 * E := mul_le_mul_of_nonneg_right hp4 hE0
    have e2 : A ^ 3 * E ≤ A ^ 5 * E := mul_le_mul_of_nonneg_right hp3 hE0
    have e3 : A ^ 5 * E ≤ A ^ 5 := mul_le_of_le_one_right hA5 hE1
    have n : 0 ≤ A ^ 5 * E := by positivity
    linarith

theorem etaL_band_window_v5 : ∀ (h : ℝ) (γ : Lab) (ξ : Cyl), 0 < qC h ξ → etaL h γ ξ ≠ 0 → 1/2 < qC h ξ / Qb γ.1 ∧ qC h ξ / Qb γ.1 < 2 :=
by
  intro h γ ξ hq hη
  have h1 : sqPart 1 (-(γ.1:ℤ)) (Real.logb 2 (qC h ξ)) ≠ 0 := by
    unfold etaL at hη
    exact left_ne_zero_of_mul hη
  unfold sqPart at h1
  have h2 := (div_ne_zero_iff.mp h1).1
  obtain ⟨x, hx⟩ : ∃ x : ℝ, x = Real.logb 2 (qC h ξ) + (γ.1:ℝ) := ⟨_, rfl⟩
  have hxe : Real.logb 2 (qC h ξ) / 1 - (((-(γ.1:ℤ)):ℤ):ℝ) = x := by
    rw [hx]; push_cast; ring
  rw [hxe] at h2
  unfold bumpR at h2
  have hx2 : 0 < 1 - x ^ 2 := by
    by_contra hc
    push_neg at hc
    exact h2 (Real.smoothTransition.zero_of_nonpos hc)
  have hlo : -1 < x := by nlinarith
  have hhi : x < 1 := by nlinarith
  have hr : qC h ξ / Qb γ.1 = (2:ℝ) ^ x := by
    unfold Qb
    rw [hx, Real.rpow_add (by norm_num), Real.rpow_logb (by norm_num) (by norm_num) hq,
      Real.rpow_neg (by norm_num), div_inv_eq_mul]
  rw [hr]
  constructor
  · have h3 := Real.rpow_lt_rpow_of_exponent_lt (by norm_num : (1:ℝ) < 2) hlo
    rw [Real.rpow_neg_one] at h3
    have e : (2:ℝ)⁻¹ = 1 / 2 := by norm_num
    linarith
  · have h3 := Real.rpow_lt_rpow_of_exponent_lt (by norm_num : (1:ℝ) < 2) hhi
    rwa [Real.rpow_one] at h3

theorem ptrack_ref_compare5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ M : ℝ, ∃ (l3 : ℕ) (M0 : ℝ), ∀ (γ : Lab) (ξ : Cyl), l3 ≤ γ.1 → ActiveL4 B G γ → etaL B.h γ ξ ≠ 0 → ξ ∈ DomC B.h B.qB → 2 * G.r0 * (γ.1 : ℝ) ^ 2 ≤ Lsb B.h G.r0 γ.1 → Lsb B.h G.r0 γ.1 ≤ 2 * Tgc * G.r0 * (γ.1 : ℝ) ^ 2 → |pcFa5 B γ.1 (ξ.1, ξ.2.1, ξ.2.2.1) - F0r5 B G γ| ≤ M * ((γ.1 : ℝ) ^ (-6 : ℤ) + qC B.h ξ ^ B.h) → |pcRC5 γ.1 (ξ.1, ξ.2.1, ξ.2.2.1) * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))) - (g0r5 B G γ).1| ≤ M * ((γ.1 : ℝ) ^ (-6 : ℤ) + qC B.h ξ ^ B.h) → |Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) - (g0r5 B G γ).2| ≤ M * ((γ.1 : ℝ) ^ (-6 : ℤ) + qC B.h ξ ^ B.h) → |pcRC5 γ.1 (ξ.1, ξ.2.1, ξ.2.2.1) - R0r B G γ| ≤ M * ((γ.1 : ℝ) ^ (-6 : ℤ) + qC B.h ξ ^ B.h) → |Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))| ≤ M * qC B.h ξ ^ B.h → |Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))| ≤ M * qC B.h ξ ^ B.h → (∀ i : Fin 3, |pcA5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) i - ![sgn γ.2.2 * Bs5 B G γ * G.ustar / 2, Bs5 B G γ * (Kfr5 B G γ).1, Bs5 B G γ * (Kfr5 B G γ).2] i| ≤ M0 / Lsb B.h G.r0 γ.1) ∧ (∀ i : Fin 3, |pcPsi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) i - ![-(sgn γ.2.2 * Bs5 B G γ * G.ustar / Lsb B.h G.r0 γ.1), 0, 0] i| ≤ M0 / Lsb B.h G.r0 γ.1 ^ 2) ∧ (∀ i j : Fin 3, |pcKm5 B γ.1 (ξ.1, ξ.2.1, ξ.2.2.1) i j - !![0, -2 * F0r5 B G γ, 0; 2 * F0r5 B G γ + (g0r5 B G γ).1, 0, 0; (g0r5 B G γ).2, 0, 0] i j| ≤ M0 / Lsb B.h G.r0 γ.1) :=
by
  intro B G hB hG M
  have hh0 : 0 < B.h := hB.2.1.1
  have hh1 : B.h ≤ 1 := by have := hB.2.1.2.1; linarith
  have hXa : 0 < B.Xa := hB.2.1.2.2.1

  have hround : ∀ (k : ℕ) (x : ℝ) (pi : ℤ), 1 ≤ k → (round ((k:ℝ) * x) = 0 → pi = 1) →
      (round ((k:ℝ) * x) ≠ 0 → pi = round ((k:ℝ) * x)) →
      |(pi : ℝ) / (k:ℝ) - x| ≤ 3 / (2 * (k:ℝ)) := by
    intro k x pi hk hp1 hp2
    have kpos : (0:ℝ) < k := by exact_mod_cast hk
    have hp : |(pi:ℝ) - k * x| ≤ 3 / 2 := by
      by_cases h0 : round ((k:ℝ) * x) = 0
      · rw [hp1 h0]
        rw [round_eq_zero_iff] at h0
        obtain ⟨a, b⟩ := h0
        rw [abs_le]; push_cast; constructor <;> linarith
      · rw [hp2 h0]
        have := abs_sub_round ((k:ℝ) * x)
        rw [abs_sub_comm] at this; linarith
    have e : (pi:ℝ) / k - x = ((pi:ℝ) - k * x) / k := by field_simp
    rw [e, abs_div, abs_of_pos kpos]
    calc |(pi:ℝ) - k * x| / k ≤ (3 / 2) / k := div_le_div_of_nonneg_right hp kpos.le
      _ = 3 / (2 * k) := by ring

  have hscale : ∀ c : ℝ, ∃ l : ℕ, ∀ n : ℕ, l ≤ n →
      1 ≤ n ∧ c ≤ (n:ℝ) ∧ (n:ℝ) ^ 4 * epsb B.h n ^ (1/2:ℝ) ≤ 1 := by
    intro c
    obtain ⟨r, hr⟩ : ∃ r : ℝ, r = (2:ℝ) ^ (-(B.h / 2)) := ⟨_, rfl⟩
    have hr0 : 0 < r := by rw [hr]; exact Real.rpow_pos_of_pos (by norm_num) _
    have hr1 : r < 1 := by rw [hr]; exact Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
    have hid : ∀ n : ℕ, epsb B.h n ^ (1/2:ℝ) = r ^ n := by
      intro n
      have e1 : epsb B.h n ^ (1/2:ℝ) = (2:ℝ) ^ (-(n:ℝ) * B.h * (1/2)) := by
        unfold epsb Qb
        rw [Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2), Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2)]
      have e2 : r ^ n = (2:ℝ) ^ (-(n:ℝ) * B.h * (1/2)) := by
        rw [hr, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2)]; congr 1; ring
      rw [e1, e2]
    have ht := tendsto_pow_const_mul_const_pow_of_abs_lt_one 4 (by rw [abs_of_pos hr0]; exact hr1)
    obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp (ht.eventually_lt_const zero_lt_one)
    refine ⟨max N (max 1 ⌈c⌉₊), fun n hn => ⟨?_, ?_, ?_⟩⟩
    · exact le_trans (le_max_left _ _) (le_trans (le_max_right _ _) hn)
    · exact (Nat.le_ceil c).trans (by exact_mod_cast le_trans (le_max_right _ _) (le_trans (le_max_right _ _) hn))
    · rw [hid]; exact (hN n (le_trans (le_max_left _ _) hn)).le

  have hsmall : ∀ (l : ℕ) (q : ℝ), 0 < q → q / Qb l < 2 →
      q ^ B.h ≤ 2 * epsb B.h l ^ (1/2:ℝ) ∧ 1 ≤ kb B.h l ∧ 1 / (kb B.h l : ℝ) ≤ epsb B.h l ^ (1/2:ℝ) := by
    intro l q hq hqQ
    have hQ0 : 0 < Qb l := Real.rpow_pos_of_pos (by norm_num) _
    have hQ1 : Qb l ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
    have he0 : 0 < epsb B.h l := Real.rpow_pos_of_pos hQ0 _
    have he1 : epsb B.h l ≤ 1 := Real.rpow_le_one hQ0.le hQ1 hh0.le
    obtain ⟨e, hed⟩ : ∃ e, e = epsb B.h l ^ (1/2:ℝ) := ⟨_, rfl⟩
    have e0 : 0 < e := by rw [hed]; exact Real.rpow_pos_of_pos he0 _
    have e1 : e ≤ 1 := by rw [hed]; exact Real.rpow_le_one he0.le he1 (by norm_num)
    have ee : e * e = epsb B.h l := by rw [hed, ← Real.rpow_add he0]; norm_num
    rw [← hed]
    refine ⟨?_, ?_⟩
    · have hq2 : q < 2 * Qb l := by rw [div_lt_iff₀ hQ0] at hqQ; linarith
      have a1 : q ^ B.h ≤ (2 * Qb l) ^ B.h := Real.rpow_le_rpow hq.le hq2.le hh0.le
      have a2 : (2 * Qb l) ^ B.h = (2:ℝ) ^ B.h * epsb B.h l := Real.mul_rpow (by norm_num) hQ0.le
      have a3 : (2:ℝ) ^ B.h ≤ 2 := by
        have := Real.rpow_le_rpow_of_exponent_le (show (1:ℝ) ≤ 2 by norm_num) hh1
        rwa [Real.rpow_one] at this
      have a4 : epsb B.h l ≤ e := by rw [← ee]; exact mul_le_of_le_one_left e0.le e1
      have a5 : (2:ℝ) ^ B.h * epsb B.h l ≤ 2 * e := mul_le_mul a3 a4 he0.le (by norm_num)
      linarith
