    have hD : ∀ w ∈ (Ioo Xa Xb ×ˢ Ioo (-1) 1 : Set (ℝ × ℝ)), DifferentiableAt ℝ
        (fun w : ℝ × ℝ => P w.1 w.2 / Real.sqrt (T1 w.1 w.2 ^ 2 + T2 w.1 w.2 ^ 2)) w := by
      intro w hw
