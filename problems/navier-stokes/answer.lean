theorem rfp_inter_lam_rinC : ∀ P : RfpPar, RfpRegime P → ∀ y : ℝ, y ≤ rfpY3 P.Md P.lam → Real.exp (rfpLam P y) = rinC P.Md P.Pst P.lam y :=
by
  intro P hReg y hy
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hReg

  have hs0 : ∀ t : ℝ, t ≤ 0 → sigA t = 0 := by
    intro t ht
    unfold sigA
    rw [if_pos ht]
  have hsI0 : ∀ t : ℝ, t ≤ 0 → rfpSigI t = 0 := by
    intro t ht
    unfold rfpSigI
    have hc : (∫ s in (0:ℝ)..t, sigA s) = ∫ s in (0:ℝ)..t, (0:ℝ) := by
      apply intervalIntegral.integral_congr
      intro s hs
      rw [Set.uIcc_of_ge ht] at hs
      exact hs0 s hs.2
    rw [hc]
    simp

  have hlam2 : P.lam ^ 2 ≤ 1 / 10000 := by nlinarith
  have hT0 : 0 ≤ P.T1 := by
    have h1h : 1 ≤ 1 / P.h := by rw [le_div_iff₀ hh0]; nlinarith
    have := Real.log_nonneg h1h
