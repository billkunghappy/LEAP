      · funext e; simp only [Pi.mul_apply, Pi.sub_apply]; ring
      · ring
    show |deriv (fun e => U x e ^ 2 - x * F x e ^ 2) η| ≤ _
    rw [hd.deriv]
    have hu := hUx x hx0 hxX
    have hf := (hFb x hx0 hxX).2
    have t1 : |2 * U x η * deriv (fun e => U x e) η| =
        2 * (|U x η| * |deriv (fun e => U x e) η|) := by
      rw [abs_mul, abs_mul, abs_two]; ring
    have t2 : |x * (2 * F x η * deriv (fun e => F x e) η)| =
        2 * (x * |F x η| * |deriv (fun e => F x e) η|) := by
      rw [abs_mul, abs_mul, abs_mul, abs_two, abs_of_nonneg hx0]; ring
    have t3 : |U x η| * |deriv (fun e => U x e) η| ≤ (4 + k) * (4 + k) :=
      mul_le_mul hu.1 hu.2 (abs_nonneg _) (by linarith)
    have t4 := abs_sub (2 * U x η * deriv (fun e => U x e) η)
      (x * (2 * F x η * deriv (fun e => F x e) η))
