  have hRts : ContDiffOn ℝ ∞ Rt U := by
    rw [hRt]; exact (contDiffOn_const.mul hRFs).add (contDiffOn_const.mul hRBs)
  have hZts : ContDiffOn ℝ ∞ Zt U := by
    rw [hZt]; exact (contDiffOn_const.mul hZFs).add (contDiffOn_const.mul hZBs)
