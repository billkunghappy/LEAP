  have hWo : IsOpen (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) := isOpen_Ioi.prod isOpen_Ioo
  have hη1 : -1 - r < η := by linarith
  have hη2 : η < 1 + r := by linarith
  have hX0 : (0:ℝ) ≤ X := hX.le
  have hdF : ∀ x : ℝ, 0 ≤ x → HasDerivAt (fun e => F x e) (deriv (fun e => F x e) η) η := by
