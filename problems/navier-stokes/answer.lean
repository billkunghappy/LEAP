      have := ((((hasDerivAt_id (0:ℝ)).ofReal_comp).mul_const
        (2 * Real.pi * Complex.I * ((κ.1 : ℂ) * (v.1 : ℂ) + (κ.2 : ℂ) * (v.2 : ℂ)))).cexp).mul_const
