        linarith
      have k5 : ⌊φ l / Real.log Tgc⌋ < ⌊φ a / Real.log Tgc⌋ + 4 := by exact_mod_cast k4
      omega

  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hB.2.1
  obtain ⟨l22, H22⟩ := good_nphi5_nb_v5 B G hB hG
  obtain ⟨lg, Hg⟩ := band_coarse_gap_v5 B.h hh0 hh1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨l22 + lg + n0 + 1, fun k => ?_⟩
