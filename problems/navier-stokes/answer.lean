      exact (hstep m η h1 h2).differentiableAt.congr_of_eventuallyEq hev
    refine ⟨fun η h1 h2 => by simpa using hint 0 η h1 h2, ?_, ?_⟩
    · refine contDiffOn_of_differentiableOn_deriv (n := ⊤) (fun m _ => ?_)
      intro η hη
      have hev : iteratedDerivWithin m (fun η' => ∫ x in Ioi a, g x η') (Ioo (-1) 1) =ᶠ[nhds η]
