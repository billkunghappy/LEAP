  have haJ0 : 0 < a J := lt_of_lt_of_le one_pos (ha J)
  refine ⟨|CJ| + c4 * (3 * ((m:ℝ) + 4)) * (1 + ((m:ℝ) + 4) * (2 * |D| + 2)), 1 / (2 * a J),
