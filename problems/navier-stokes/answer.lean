  have hP2s : ContDiffOn ℝ ∞ P2 U := by rw [hP2]; exact hUt2s.mul hZts
  have hYs : ContDiffOn ℝ ∞ Y U := by
    rw [hY]; exact (contDiffOn_const.mul hP1s).add (contDiffOn_const.mul hP2s)
  have hXs : ContDiffOn ℝ ∞ X U := by
