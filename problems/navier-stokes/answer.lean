    exact le_of_mul_le_mul_left key hs
  have hF2 : ∀ x : ℝ, a ≤ x → F x 0 ^ 2 ≤ ci ^ 2 * x ^ (-(2 + 2 * h)) := by
    intro x hx
    have hx0 : 0 < x := ha.trans_le hx
