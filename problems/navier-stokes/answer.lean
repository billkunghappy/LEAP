  have hSa : Icc a X₂ ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi 0 ×ˢ Ioo (-1) 1 :=
    fun z hz => ⟨lt_of_lt_of_le ha hz.1.1, hz.2⟩
  have gaddΩ : ∀ f g : ℝ × ℝ → ℝ, osbGood (Ioi 0 ×ˢ Ioo (-1) 1) (Icc a X₂ ×ˢ Ioo (-1) 1) f →
