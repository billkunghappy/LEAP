          ![eR (rotPt (rad x) θ (x 2)), eTh (rotPt (rad x) θ (x 2)), eZ] a := rfl
      rw [hf, hframe _ (by rw [hr]; exact hrx)]
      rfl
    have hm1 : ∀ γ m, m ∉ H → g γ m (ptOf x t Y) a = 0 := by
      intro γ m hm
      rw [hH γ m hm]
      rfl
    have hm2 : ∀ γ m, γ ∉ Γ → g γ m (ptOf x t Y) a = 0 := by
      intro γ m hγ
      rw [hTz γ m hγ]
      rfl
    obtain ⟨hcont, hz⟩ := hcirc (fun γ m η => g γ m η a) (ptOf x t Y)
      (rad x) (x 2) H Γ hrx h0H hm1 hm2
    rw [hfun]
    exact hthA _ _ _ hcont hz
  rw [hmean, hF x t Y hxt]
  simp only [cyl2cart, add_smul, smul_add, smul_smul]
  abel

theorem pch5_coeff_struct : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (S : CState) (bw ca cm cd β : ℝ) (D : WC), StOrd5 B G l0 S bw ca cm cd → InWg5 B G (qsOf l0) (β + 1/2) D → InWg5 B G (qsOf l0) β (velW5 B G D) → (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → pchG5 B G (fun ξ a => mcor5 B G l0 S a ξ) (wmoAmp5 B G S.Aw) (wmoAmp5 B G D) γ m = 0) ∧ (∀ γ m, ContDiffOn ℝ ∞ (pchG5 B G (fun ξ a => mcor5 B G l0 S a ξ) (wmoAmp5 B G S.Aw) (wmoAmp5 B G D) γ m) (DomC B.h (qsOf l0))) ∧ (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ∀ c, IsDeck B.h (qC B.h ξ) c → pchG5 B G (fun ξ a => mcor5 B G l0 S a ξ) (wmoAmp5 B G S.Aw) (wmoAmp5 B G D) γ m (shY ξ c) = pchG5 B G (fun ξ a => mcor5 B G l0 S a ξ) (wmoAmp5 B G S.Aw) (wmoAmp5 B G D) γ m ξ) ∧ (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → pchG5 B G (fun ξ a => mcor5 B G l0 S a ξ) (wmoAmp5 B G S.Aw) (wmoAmp5 B G D) γ m ξ ≠ 0 → SuppW B G γ ξ) :=
by
  intro B G hok hG
  obtain ⟨lP, hPS⟩ := pulse_support_good_v5 B G hok hG
  obtain ⟨lw, hw⟩ := wmo_amp_class_v5 B G hok hG
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -⟩ := hok.2.1
  obtain ⟨lB, hB⟩ := band_coarse_gap_v5 B.h hh0 hh1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨lP + lw + lB + n0 + 7, ?_⟩
  intro l0 hl0 S bw ca cm cd β D hSt hD hDv
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  unfold StOrd5 at hSt
  obtain ⟨c1, -, -, -, -, -, -, -, -, -, -, -, -, -, -, c16, -, c18, c19, -, c21, -, -⟩ := hSt
  have hc1' : InWg5 B G (qsOf l0) (1/2 + 1/2) S.Aw := by
    have e : (1/2 + 1/2 : ℝ) = 1 := by norm_num
    rw [e]
    exact c1
  have hP := (hw l0 (by omega)).1 S.Aw (1/2) hc1' c16
  have hQ := (hw l0 (by omega)).1 D β hD hDv

  have hT : IsOpen {ξ : Cyl | ξ.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
  have hπq : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
    contDiff_snd.fst.prodMk (contDiff_const.sub contDiff_snd.snd.fst)
  have hqC : ContDiffOn ℝ ∞ (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have h4 := hok.1.2.2.2.1
    exact h4.comp hπq.contDiffOn (fun ξ (hξ : ξ.2.2.1 < 1) =>
      (⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩ : (ξ.2.1, 1 - ξ.2.2.1) ∈ univ ×ˢ Ioi (0:ℝ)))
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have h1 : IsOpen {ξ : Cyl | 0 < ξ.1} := isOpen_lt continuous_const continuous_fst
    have h2 := hqC.continuousOn.isOpen_inter_preimage hT (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Iio (qsOf l0)) := by
      ext ξ; exact Iff.rfl
    rw [e]; exact h1.inter h2
  have hqpos : ∀ ξ : Cyl, ξ.2.2.1 < 1 → 0 < qC B.h ξ := fun ξ hξ =>
    (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hdom : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 :=
    fun ξ hξ => hξ
  have hDT : DomC B.h (qsOf l0) ⊆ {ξ : Cyl | ξ.2.2.1 < 1} := fun ξ hξ => (hdom ξ hξ).2.1
  have ofR : ∀ {f : Cyl → ℝ} {s : Set Cyl}, ContDiffOn ℝ ∞ f s →
      ContDiffOn ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) s := fun hf =>
    (Complex.ofRealCLM.contDiff.comp_contDiffOn hf).congr (fun η _ => by simp)
  have hdRZ : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : Cyl → V) (O : Set Cyl),
      IsOpen O → (∀ η ∈ O, 0 < η.1) → ContDiffOn ℝ ∞ F O →
      ContDiffOn ℝ ∞ (dR B.h F) O ∧ ContDiffOn ℝ ∞ (dZ F) O := by
    intro V _ _ F O hO hpos hF
    have hDf : ContDiffOn ℝ ∞ (fderiv ℝ F) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hF).2
    have hpow : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1 ^ (drx B.h - 1)) O :=
      contDiff_fst.contDiffOn.rpow_const_of_ne (fun ξ hξ => (hpos ξ hξ).ne')
    have hY : ContDiffOn ℝ ∞ (fun ξ : Cyl => (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) O :=
      (contDiffOn_const.mul hpow).smul_const _
    have hvR : ContDiffOn ℝ ∞ (fun ξ : Cyl =>
        ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) O :=
      contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk hY))
    exact ⟨(hDf.clm_apply hvR).congr (fun ξ _ => rfl),
      (hDf.clm_apply contDiffOn_const).congr (fun ξ _ => rfl)⟩
  have hgr : ∀ (g : Cyl → ℝ) (α : ℝ), InM B (qsOf l0) α (nrm B (Aex B.h) g) →
      ContDiffOn ℝ ∞ g (DomC B.h (qsOf l0)) := by
    intro g α hg
    have hqa : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-Aex B.h)) (DomC B.h (qsOf l0)) :=
      (hqC.rpow_const_of_ne (p := -Aex B.h) (fun ξ hξ => (hqpos ξ hξ).ne')).mono hDT
    refine (hqa.mul hg.1).congr (fun η hη => ?_)
    have hq := hqpos η (hDT hη)
    show g η = qC B.h η ^ (-Aex B.h) * (qC B.h η ^ Aex B.h * g η)
    rw [← mul_assoc, ← Real.rpow_add hq, neg_add_cancel, Real.rpow_zero, one_mul]
  have hgd : ∀ (g : Cyl → ℝ) (α : ℝ), InM B (qsOf l0) α (nrm B (Aex B.h) g) →
      ∀ η ∈ DomC B.h (qsOf l0), ∀ c, IsDeck B.h (qC B.h η) c → g (shY η c) = g η := by
    intro g α hg η hη c hc
    have h := hg.2.1 η hη c hc
    have hq := hqpos η (hDT hη)
    have h' : qC B.h η ^ Aex B.h * g (shY η c) = qC B.h η ^ Aex B.h * g η := h
    exact mul_left_cancel₀ (Real.rpow_pos_of_pos hq _).ne' h'
  have hMs : ContDiffOn ℝ ∞ (pchMnC5 (fun ξ a => mcor5 B G l0 S a ξ)) (DomC B.h (qsOf l0)) := by
    refine contDiffOn_pi.mpr (fun i => ?_)
    fin_cases i
    · exact ofR (hgr _ _ c21)
    · exact ofR (hgr _ _ c18)
    · exact ofR (hgr _ _ c19)
  have hMd : ∀ η ∈ DomC B.h (qsOf l0), ∀ c, IsDeck B.h (qC B.h η) c →
      pchMnC5 (fun ξ a => mcor5 B G l0 S a ξ) (shY η c) = pchMnC5 (fun ξ a => mcor5 B G l0 S a ξ) η := by
    intro η hη c hc
    funext i
    fin_cases i
    · show ((mcor5 B G l0 S 0 (shY η c) : ℝ) : ℂ) = ((mcor5 B G l0 S 0 η : ℝ) : ℂ)
      rw [hgd _ _ c21 η hη c hc]
    · show ((mcor5 B G l0 S 1 (shY η c) : ℝ) : ℂ) = ((mcor5 B G l0 S 1 η : ℝ) : ℂ)
      rw [hgd _ _ c18 η hη c hc]
    · show ((mcor5 B G l0 S 2 (shY η c) : ℝ) : ℂ) = ((mcor5 B G l0 S 2 η : ℝ) : ℂ)
      rw [hgd _ _ c19 η hη c hc]
  suffices key : ∀ (Mn : Cyl → Fin 3 → ℝ) (P Q : WC) (αP αQ : ℝ), InWg5 B G (qsOf l0) αP P →
      InWg5 B G (qsOf l0) αQ Q → ContDiffOn ℝ ∞ (pchMnC5 Mn) (DomC B.h (qsOf l0)) →
      (∀ η ∈ DomC B.h (qsOf l0), ∀ c, IsDeck B.h (qC B.h η) c → pchMnC5 Mn (shY η c) = pchMnC5 Mn η) →
      (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → pchG5 B G Mn P Q γ m = 0) ∧
      (∀ γ m, ContDiffOn ℝ ∞ (pchG5 B G Mn P Q γ m) (DomC B.h (qsOf l0))) ∧
      (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ∀ c, IsDeck B.h (qC B.h ξ) c →
        pchG5 B G Mn P Q γ m (shY ξ c) = pchG5 B G Mn P Q γ m ξ) ∧
      (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → pchG5 B G Mn P Q γ m ξ ≠ 0 → SuppW B G γ ξ) by
    exact key _ _ _ _ _ hP hQ hMs hMd
  intro Mn P Q αP αQ hP hQ hMs hMd

  have Z0' : ∀ (γ : Lab) (n : ℤ) (al : Fin 3 → ℂ) (bt : Cyl → Fin 3 → ℂ) (η : Cyl), al = 0 →
      pchTr5 B G γ n al bt η = 0 := by
    rintro γ n al bt η rfl
    funext i
    fin_cases i <;> simp [pchTr5]
  have Zev : ∀ (γ : Lab) (n : ℤ) (al : Fin 3 → ℂ) (bt : Cyl → Fin 3 → ℂ) (η : Cyl),
      bt =ᶠ[nhds η] (fun _ => (0 : Fin 3 → ℂ)) → pchTr5 B G γ n al bt η = 0 := by
    intro γ n al bt η hev
    have h0 : bt η = 0 := hev.eq_of_nhds
    have hfd : fderiv ℝ bt η = 0 := by
      rw [hev.fderiv_eq]; exact fderiv_const_apply _
    have hr : dR B.h bt η = 0 := by
      unfold dR; rw [hfd, ContinuousLinearMap.zero_apply]
    have hz : dZ bt η = 0 := by
      unfold dZ; rw [hfd, ContinuousLinearMap.zero_apply]
    funext i
    fin_cases i <;> simp [pchTr5, h0, hr, hz]
  have AmpV : ∀ (X : WC) (γ : Lab) (k : ℤ) (η : Cyl), X γ k η = 0 → pchAmp5 B X γ k η = 0 := by
    intro X γ k η h
    show ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ) • X γ k η = 0
    rw [h, smul_zero]
  have Amp0ev : ∀ (X : WC) (γ : Lab) (k : ℤ) (η : Cyl), X γ k =ᶠ[nhds η] (fun _ => 0) →
      pchAmp5 B X γ k =ᶠ[nhds η] (fun _ => (0 : Fin 3 → ℂ)) := by
    intro X γ k η h
    filter_upwards [h] with x hx
    exact AmpV X γ k x hx
  have EvZ : ∀ (X : WC) (γ : Lab) (k : ℤ) (η : Cyl), X γ k = 0 →
      pchAmp5 B X γ k =ᶠ[nhds η] (fun _ => (0 : Fin 3 → ℂ)) := by
    intro X γ k η h
    exact Filter.Eventually.of_forall (fun x => AmpV X γ k x (by simp [h]))
  have PairZ : ∀ (X Y : WC) (N : ℤ) (γ : Lab) (η : Cyl), (∀ m, X γ m η = 0 ∨
      (Y γ (N - m) =ᶠ[nhds η] (fun _ => (0 : Fin 3 → ℂ)) ∧ Y γ (N + m) =ᶠ[nhds η] (fun _ => (0 : Fin 3 → ℂ)))) →
      pchPair5 B G X Y N γ η = 0 := by
    intro X Y N γ η h
    unfold pchPair5
    apply finsum_eq_zero_of_forall_eq_zero
    intro m
    rcases h m with h | ⟨h1, h2⟩
    · rw [Z0' γ (N - m) (X γ m η) (Y γ (N - m)) η h,
        Z0' γ (N + m) (fun i => star (X γ m η i)) (Y γ (N + m)) η (by funext i; simp [h])]
      simp
    · rw [Zev γ (N - m) _ _ η h1, Zev γ (N + m) _ _ η h2]
      simp
  have LocZero : ∀ (γ : Lab) (N : ℤ) (η : Cyl), (∀ m, P γ m =ᶠ[nhds η] (fun _ => 0)) →
      (∀ m, Q γ m =ᶠ[nhds η] (fun _ => 0)) → pchHar5 B G Mn P Q γ N η = 0 := by
    intro γ N η hPe hQe
    unfold pchHar5
    rw [Zev γ N (pchMnC5 Mn η) (pchAmp5 B Q γ N) η (Amp0ev Q γ N η (hQe N)),
      Z0' γ 0 (pchAmp5 B Q γ N η) (pchMnC5 Mn) η (AmpV Q γ N η (hQe N).eq_of_nhds),
      PairZ (pchAmp5 B P) (pchAmp5 B Q) N γ η (fun m => Or.inl (AmpV P γ m η (hPe m).eq_of_nhds)),
      PairZ (pchAmp5 B Q) (pchAmp5 B P) N γ η (fun m => Or.inl (AmpV Q γ m η (hQe m).eq_of_nhds))]
    simp
  obtain ⟨HP, hP0, hPv⟩ := hP.1
  obtain ⟨HQ, hQ0, hQv⟩ := hQ.1

  have HarZ : ∀ γ N η, N ∉ HQ → (∀ p ∈ HP, ∀ q ∈ HQ, p + q ≠ N) → (∀ p ∈ HP, ∀ q ∈ HQ, q - p ≠ N) →
      (∀ p ∈ HP, ∀ q ∈ HQ, p - q ≠ N) → pchHar5 B G Mn P Q γ N η = 0 := by
    intro γ N η h1 h2 h3 h4
    have e1 : pchPair5 B G (pchAmp5 B P) (pchAmp5 B Q) N γ η = 0 := by
      apply PairZ
      intro m
      by_cases hm : m ∈ HP
      · right
        exact ⟨EvZ Q γ _ η (hQv γ _ (fun hq => h2 m hm _ hq (by ring))),
          EvZ Q γ _ η (hQv γ _ (fun hq => h3 m hm _ hq (by ring)))⟩
      · left; exact AmpV P γ m η (by simp [hPv γ m hm])
    have e2 : pchPair5 B G (pchAmp5 B Q) (pchAmp5 B P) N γ η = 0 := by
      apply PairZ
      intro m
      by_cases hm : m ∈ HQ
      · right
        exact ⟨EvZ P γ _ η (hPv γ _ (fun hp => h2 _ hp m hm (by ring))),
          EvZ P γ _ η (hPv γ _ (fun hp => h4 _ hp m hm (by ring)))⟩
      · left; exact AmpV Q γ m η (by simp [hQv γ m hm])
    unfold pchHar5
    rw [Zev γ N _ _ η (EvZ Q γ N η (hQv γ N h1)),
      Z0' γ 0 _ _ η (AmpV Q γ N η (by simp [hQv γ N h1])), e1, e2]
    simp
  have hi : ∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → pchG5 B G Mn P Q γ m = 0 := by
    refine ⟨(HQ ∪ (HP ×ˢ HQ).image (fun p => p.1 + p.2) ∪ (HP ×ˢ HQ).image (fun p => p.2 - p.1) ∪
      (HP ×ˢ HQ).image (fun p => p.1 - p.2)).erase 0, Finset.notMem_erase _ _, ?_⟩
    intro γ N hN
    funext η
    show pchG5 B G Mn P Q γ N η = 0
    by_cases hN0 : N = 0
    · simp [pchG5, hN0]
    have hmem : ∀ x ∈ (HQ ∪ (HP ×ˢ HQ).image (fun p => p.1 + p.2) ∪ (HP ×ˢ HQ).image (fun p => p.2 - p.1) ∪
        (HP ×ˢ HQ).image (fun p => p.1 - p.2)), x ≠ N := by
      intro x hx hxN
      subst hxN
      exact hN (Finset.mem_erase.mpr ⟨hN0, hx⟩)
    have h1 : N ∉ HQ := fun h => hmem N
      (Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _ h))) rfl
    have h2 : ∀ p ∈ HP, ∀ q ∈ HQ, p + q ≠ N := fun p hp q hq => hmem _
      (Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_image.mpr ⟨(p, q), Finset.mem_product.mpr ⟨hp, hq⟩, rfl⟩))))
    have h3 : ∀ p ∈ HP, ∀ q ∈ HQ, q - p ≠ N := fun p hp q hq => hmem _
      (Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_image.mpr ⟨(p, q), Finset.mem_product.mpr ⟨hp, hq⟩, rfl⟩)))
    have h4 : ∀ p ∈ HP, ∀ q ∈ HQ, p - q ≠ N := fun p hp q hq => hmem _
      (Finset.mem_union_right _
        (Finset.mem_image.mpr ⟨(p, q), Finset.mem_product.mpr ⟨hp, hq⟩, rfl⟩))
    simp only [pchG5, if_neg hN0]
    rw [HarZ γ N η h1 h2 h3 h4, smul_zero]

  have hTS : ∀ γ N ξ, pchHar5 B G Mn P Q γ N ξ ≠ 0 →
      ∃ m, ξ ∈ tsupport (P γ m) ∨ ξ ∈ tsupport (Q γ m) := by
    intro γ N ξ hne
    by_contra hcon
    push_neg at hcon
    exact hne (LocZero γ N ξ (fun m => notMem_tsupport_iff_eventuallyEq.mp (hcon m).1)
      (fun m => notMem_tsupport_iff_eventuallyEq.mp (hcon m).2))
  have hiv : ∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → pchG5 B G Mn P Q γ m ξ ≠ 0 → SuppW B G γ ξ := by
    intro γ N ξ hξ hne
    have hH : pchHar5 B G Mn P Q γ N ξ ≠ 0 := by
      intro h0; apply hne; unfold pchG5; split_ifs <;> simp [h0]
    obtain ⟨m, hm | hm⟩ := hTS γ N ξ hH
    · exact (hPS l0 (by omega) αP P hP γ m ξ hξ hm).1
    · exact (hPS l0 (by omega) αQ Q hQ γ m ξ hξ hm).1

  have TrS : ∀ (γ : Lab) (n : ℤ) (O : Set Cyl) (al bt : Cyl → Fin 3 → ℂ), IsOpen O → (∀ η ∈ O, 0 < η.1) →
      ContDiffOn ℝ ∞ al O → ContDiffOn ℝ ∞ bt O →
      (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhi5 B G γ η i) O) →
      ContDiffOn ℝ ∞ (fun η => pchTr5 B G γ n (al η) bt η) O := by
    intro γ n O al bt hO hpos hal hbt hnO
    obtain ⟨hrb, hzb⟩ := hdRZ bt O hO hpos hbt
    have ha : ∀ i, ContDiffOn ℝ ∞ (fun η => al η i) O := fun i => contDiffOn_pi.mp hal i
    have hb : ∀ i, ContDiffOn ℝ ∞ (fun η => bt η i) O := fun i => contDiffOn_pi.mp hbt i
    have hr : ∀ i, ContDiffOn ℝ ∞ (fun η => dR B.h bt η i) O := fun i => contDiffOn_pi.mp hrb i
    have hz : ∀ i, ContDiffOn ℝ ∞ (fun η => dZ bt η i) O := fun i => contDiffOn_pi.mp hzb i
    have hg : ∀ i, ContDiffOn ℝ ∞
        (fun η => (((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) * nPhi5 B G γ η i : ℝ) : ℂ)) O :=
      fun i => ofR (contDiffOn_const.mul (hnO i))
    have hinv : ContDiffOn ℝ ∞ (fun η : Cyl => ((η.1 : ℝ) : ℂ)⁻¹) O := by
      have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => η.1⁻¹) O :=
        contDiff_fst.contDiffOn.inv (fun η hη => (hpos η hη).ne')
      exact (Complex.ofRealCLM.contDiff.comp_contDiffOn h1).congr (fun η _ => by simp)
    have ha0 := ha 0; have ha1 := ha 1; have ha2 := ha 2
    have hb0 := hb 0; have hb1 := hb 1; have hb2 := hb 2
    have hr0 := hr 0; have hr1 := hr 1; have hr2 := hr 2
    have hz0 := hz 0; have hz1 := hz 1; have hz2 := hz 2
    have hg0 := hg 0; have hg1 := hg 1; have hg2 := hg 2
    have e0 : ContDiffOn ℝ ∞ (fun η => pchTr5 B G γ n (al η) bt η 0) O := by
      simp only [pchTr5, Pi.smul_apply, smul_eq_mul, div_eq_mul_inv, Matrix.cons_val_zero]
      fun_prop
    have e1 : ContDiffOn ℝ ∞ (fun η => pchTr5 B G γ n (al η) bt η 1) O := by
      simp only [pchTr5, Pi.smul_apply, smul_eq_mul, div_eq_mul_inv, Matrix.cons_val_one, Matrix.cons_val_zero]
      fun_prop
    have e2 : ContDiffOn ℝ ∞ (fun η => pchTr5 B G γ n (al η) bt η 2) O := by
      simp only [pchTr5, Pi.smul_apply, smul_eq_mul, div_eq_mul_inv, Matrix.cons_val_two, Matrix.tail_cons,
        Matrix.head_cons]
      fun_prop
    refine contDiffOn_pi.mpr fun i => ?_
    fin_cases i
    · exact e0
    · exact e1
    · exact e2
  have hAmpS : ∀ (X : WC) (α : ℝ), InWg5 B G (qsOf l0) α X → ∀ γ k,
      ContDiffOn ℝ ∞ (pchAmp5 B X γ k) (DomC B.h (qsOf l0)) := by
    intro X α hX γ k
    have hqa : ContDiffOn ℝ ∞ (fun η => ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ)) (DomC B.h (qsOf l0)) :=
      ofR ((hqC.rpow_const_of_ne (p := -Aex B.h) (fun ξ hξ => (hqpos ξ hξ).ne')).mono hDT)
    exact (hqa.smul (hX.2.1 γ k)).congr (fun _ _ => rfl)
  have PairS : ∀ (X Y : WC) (HX : Finset ℤ) (N : ℤ) (γ : Lab) (O : Set Cyl), IsOpen O → (∀ η ∈ O, 0 < η.1) →
      (∀ m, m ∉ HX → X γ m = 0) → (∀ k, ContDiffOn ℝ ∞ (pchAmp5 B X γ k) O) →
      (∀ k, ContDiffOn ℝ ∞ (pchAmp5 B Y γ k) O) →
      (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhi5 B G γ η i) O) →
      ContDiffOn ℝ ∞ (fun η => pchPair5 B G (pchAmp5 B X) (pchAmp5 B Y) N γ η) O := by
    intro X Y HX N γ O hO hpos hXv hXs hYs hnO
    have hsum : ContDiffOn ℝ ∞ (fun η => ∑ m ∈ HX,
        ((1/2 : ℂ) • pchTr5 B G γ (N - m) (pchAmp5 B X γ m η) (pchAmp5 B Y γ (N - m)) η +
          (1/2 : ℂ) • pchTr5 B G γ (N + m) (fun i => star (pchAmp5 B X γ m η i)) (pchAmp5 B Y γ (N + m)) η)) O := by
      apply ContDiffOn.sum
      intro m _
      have hst : ContDiffOn ℝ ∞ (fun η => fun i => star (pchAmp5 B X γ m η i)) O := by
        refine contDiffOn_pi.mpr (fun i => ?_)
        exact (Complex.conjCLE.contDiff.comp_contDiffOn (contDiffOn_pi.mp (hXs m) i)).congr
          (fun η _ => by simp [Complex.conjCLE_apply, Complex.star_def])
      exact ((TrS γ (N - m) O _ _ hO hpos (hXs m) (hYs (N - m)) hnO).const_smul (1/2 : ℂ)).add
        ((TrS γ (N + m) O _ _ hO hpos hst (hYs (N + m)) hnO).const_smul (1/2 : ℂ))
    refine hsum.congr (fun η _ => ?_)
    unfold pchPair5
    apply finsum_eq_sum_of_support_subset
    intro m hm
    by_contra hmX
    apply hm
    dsimp only
    have h0 : pchAmp5 B X γ m η = 0 := AmpV X γ m η (by simp [hXv m hmX])
    have hs0 : (fun i => star (pchAmp5 B X γ m η i)) = 0 := by funext i; simp [h0]
    rw [Z0' _ _ _ _ η h0, Z0' _ _ _ _ η hs0]
    simp
  have hii : ∀ γ m, ContDiffOn ℝ ∞ (pchG5 B G Mn P Q γ m) (DomC B.h (qsOf l0)) := by
    intro γ N
    by_cases hN0 : N = 0
    · refine (contDiffOn_const (c := (0 : Fin 3 → ℂ))).congr (fun η _ => ?_)
      simp [pchG5, hN0]
    apply contDiffOn_of_locally_contDiffOn
    intro ξ hξ
    by_cases hsup : ∃ m, ξ ∈ tsupport (P γ m) ∨ ξ ∈ tsupport (Q γ m)
    · obtain ⟨m, hm⟩ := hsup
      have hgood : |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 ∧ |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 := by
        rcases hm with h | h
        · have := hPS l0 (by omega) αP P hP γ m ξ hξ h
          exact ⟨this.2.2.2.2.2.2.2.1, this.2.2.2.2.2.2.2.2⟩
        · have := hPS l0 (by omega) αQ Q hQ γ m ξ hξ h
          exact ⟨this.2.2.2.2.2.2.2.1, this.2.2.2.2.2.2.2.2⟩
      have hξB : ξ ∈ DomC B.h B.qB :=
        ⟨(hdom ξ hξ).1, (hdom ξ hξ).2.1, lt_of_lt_of_le (hdom ξ hξ).2.2 hqsB⟩
      obtain ⟨U, hUo, hξU, -, hnU, -, -⟩ := good_coeff_smooth_v5 B G γ ξ hok hξB hgood.1 hgood.2
      refine ⟨U, hUo, hξU, ?_⟩
      have hO : IsOpen (DomC B.h (qsOf l0) ∩ U) := hDopen.inter hUo
      have hOD : DomC B.h (qsOf l0) ∩ U ⊆ DomC B.h (qsOf l0) := inter_subset_left
      have hpos : ∀ η ∈ DomC B.h (qsOf l0) ∩ U, 0 < η.1 := fun η hη => (hdom η hη.1).1
      have hnO : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => nPhi5 B G γ η i) (DomC B.h (qsOf l0) ∩ U) :=
        fun i => (hnU i).mono inter_subset_right
      have hPs : ∀ k, ContDiffOn ℝ ∞ (pchAmp5 B P γ k) (DomC B.h (qsOf l0) ∩ U) :=
        fun k => (hAmpS P αP hP γ k).mono hOD
      have hQs : ∀ k, ContDiffOn ℝ ∞ (pchAmp5 B Q γ k) (DomC B.h (qsOf l0) ∩ U) :=
        fun k => (hAmpS Q αQ hQ γ k).mono hOD
      have hMO := hMs.mono hOD
      have hq : ContDiffOn ℝ ∞ (fun η => ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ))
          (DomC B.h (qsOf l0) ∩ U) :=
        ofR ((hqC.rpow_const_of_ne (p := 2 * Aex B.h + 1/2) (fun ξ hξ => (hqpos ξ hξ).ne')).mono
          (fun η hη => hDT (hOD hη)))
      have hHar : ContDiffOn ℝ ∞ (fun η => pchHar5 B G Mn P Q γ N η) (DomC B.h (qsOf l0) ∩ U) :=
        (((TrS γ N _ _ _ hO hpos hMO (hQs N) hnO).add (TrS γ 0 _ _ _ hO hpos (hQs N) hMO hnO)).add
          (PairS P Q HP N γ _ hO hpos (hPv γ) hPs hQs hnO)).add
          (PairS Q P HQ N γ _ hO hpos (hQv γ) hQs hPs hnO)
      exact (hq.smul hHar).congr (fun η _ => by simp only [pchG5, if_neg hN0]; rfl)
    · push_neg at hsup
      refine ⟨⋂ m ∈ HP ∪ HQ, ((tsupport (P γ m))ᶜ ∩ (tsupport (Q γ m))ᶜ), ?_, ?_, ?_⟩
      · exact isOpen_biInter_finset (fun m _ =>
          (isClosed_tsupport _).isOpen_compl.inter (isClosed_tsupport _).isOpen_compl)
      · simp only [Set.mem_iInter]
        intro m _
        exact ⟨(hsup m).1, (hsup m).2⟩
      · refine (contDiffOn_const (c := (0 : Fin 3 → ℂ))).congr (fun η hη => ?_)
        have hη2 := hη.2
        simp only [Set.mem_iInter] at hη2
        have hPe : ∀ m, P γ m =ᶠ[nhds η] (fun _ => 0) := by
          intro m
          by_cases hm : m ∈ HP
          · exact notMem_tsupport_iff_eventuallyEq.mp (hη2 m (Finset.mem_union_left _ hm)).1
          · exact Filter.Eventually.of_forall (fun x => by simp [hPv γ m hm])
        have hQe : ∀ m, Q γ m =ᶠ[nhds η] (fun _ => 0) := by
          intro m
          by_cases hm : m ∈ HQ
          · exact notMem_tsupport_iff_eventuallyEq.mp (hη2 m (Finset.mem_union_right _ hm)).2
          · exact Filter.Eventually.of_forall (fun x => by simp [hQv γ m hm])
        show pchG5 B G Mn P Q γ N η = 0
        simp only [pchG5, if_neg hN0]
        rw [LocZero γ N η hPe hQe, smul_zero]

  have hiii : ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ∀ c, IsDeck B.h (qC B.h ξ) c →
      pchG5 B G Mn P Q γ m (shY ξ c) = pchG5 B G Mn P Q γ m ξ := by
    intro γ N ξ hξ c hc
    by_cases hN0 : N = 0
    · simp [pchG5, hN0]
    have hloc : ∀ᶠ η in nhds ξ, η ∈ DomC B.h (qsOf l0) ∧ IsDeck B.h (qC B.h η) c := by
      filter_upwards [hDopen.mem_nhds hξ, deck_locally_stable_v5 B l0 hok (by omega) ξ hξ c hc]
        with η h1 h2
      exact ⟨h1, h2⟩
    obtain ⟨e, he⟩ : ∃ e : Cyl, e = ((0:ℝ), (0:ℝ), (0:ℝ), c) := ⟨_, rfl⟩
    have hsh : ∀ η : Cyl, shY η c = η + e := by
      intro η
      rw [he]
      simp only [shY]
      ext <;> simp
    have htr : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : Cyl → V) (x : Cyl),
        (∀ᶠ η in nhds x, F (shY η c) = F η) →
        F (shY x c) = F x ∧ dR B.h F (shY x c) = dR B.h F x ∧ dZ F (shY x c) = dZ F x := by
      intro V _ _ F x hF
      have hfd : fderiv ℝ F (shY x c) = fderiv ℝ F x := by
        have hev : (fun y => F (y + e)) =ᶠ[nhds x] F := hF.mono (fun η hη => by
          show F (η + e) = F η
          rw [← hsh η, hη])
        rw [hsh x, ← fderiv_comp_add_right]
        exact hev.fderiv_eq
      refine ⟨hF.self_of_nhds, ?_, ?_⟩
      · unfold dR
        rw [hfd]
        try rfl
      · unfold dZ
        rw [hfd]
    have hqsh : ∀ η : Cyl, qC B.h (shY η c) = qC B.h η := fun _ => rfl
    have hAl : ∀ (X : WC) (α : ℝ), InWg5 B G (qsOf l0) α X → ∀ k,
        ∀ᶠ η in nhds ξ, pchAmp5 B X γ k (shY η c) = pchAmp5 B X γ k η := by
      intro X α hX k
      filter_upwards [hloc] with η hη
      show ((qC B.h (shY η c) ^ (-Aex B.h) : ℝ) : ℂ) • X γ k (shY η c) =
        ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ) • X γ k η
      rw [hqsh, hX.2.2.1 γ k η hη.1 c hη.2]
    have hMl : ∀ᶠ η in nhds ξ, pchMnC5 Mn (shY η c) = pchMnC5 Mn η := by
      filter_upwards [hloc] with η hη
      exact hMd η hη.1 c hη.2
    have hn : ∀ (X : WC) (α : ℝ), InWg5 B G (qsOf l0) α X → ∀ k, X γ k ξ ≠ 0 →
        nPhi5 B G γ (shY ξ c) = nPhi5 B G γ ξ := by
      intro X α hX k hne
      have hs := hPS l0 (by omega) α X hX γ k ξ hξ (subset_tsupport _ hne)
      have hcb := (hB γ.1 l0 (qC B.h ξ) (by omega) (hqpos ξ (hdom ξ hξ).2.1) (hdom ξ hξ).2.2
        hs.2.2.2.1 hs.2.2.2.2.1).1
      exact nPhi5_deck_v5 B G γ _ c hcb hc ξ
    have TrD : ∀ (n : ℤ) (al : Fin 3 → ℂ) (bt : Cyl → Fin 3 → ℂ), (∀ᶠ η in nhds ξ, bt (shY η c) = bt η) →
        (nPhi5 B G γ (shY ξ c) = nPhi5 B G γ ξ ∨ al = 0 ∨ bt ξ = 0 ∨ n = 0) →
        pchTr5 B G γ n al bt (shY ξ c) = pchTr5 B G γ n al bt ξ := by
      intro n al bt hbt hor
      obtain ⟨e1, e2, e3⟩ := htr bt ξ hbt
      have h1' : (shY ξ c).1 = ξ.1 := rfl
      rcases hor with h | h | h | h
      · simp only [pchTr5, e1, e2, e3, h1', h]
      · rw [Z0' γ n al bt _ h, Z0' γ n al bt _ h]
      · funext i
        fin_cases i <;> simp [pchTr5, e1, e2, e3, h1', h]
      · subst h
        funext i
        fin_cases i <;> simp [pchTr5, e1, e2, e3, h1']
    obtain ⟨hM1, -, -⟩ := htr (pchMnC5 Mn) ξ hMl
    have hQv1 : ∀ k, pchAmp5 B Q γ k (shY ξ c) = pchAmp5 B Q γ k ξ :=
      fun k => (hAl Q αQ hQ k).self_of_nhds
    have T1 := TrD N (pchMnC5 Mn ξ) (pchAmp5 B Q γ N) (hAl Q αQ hQ N) (by
      by_cases h : Q γ N ξ = 0
      · exact Or.inr (Or.inr (Or.inl (AmpV Q γ N ξ h)))
      · exact Or.inl (hn Q αQ hQ N h))
    have T2 := TrD 0 (pchAmp5 B Q γ N ξ) (pchMnC5 Mn) hMl (Or.inr (Or.inr (Or.inr rfl)))
    have PP : ∀ (X Y : WC) (αX αY : ℝ), InWg5 B G (qsOf l0) αX X → InWg5 B G (qsOf l0) αY Y → ∀ m,
        ((1/2 : ℂ) • pchTr5 B G γ (N - m) (pchAmp5 B X γ m (shY ξ c)) (pchAmp5 B Y γ (N - m)) (shY ξ c) +
          (1/2 : ℂ) • pchTr5 B G γ (N + m) (fun i => star (pchAmp5 B X γ m (shY ξ c) i))
            (pchAmp5 B Y γ (N + m)) (shY ξ c)) =
        ((1/2 : ℂ) • pchTr5 B G γ (N - m) (pchAmp5 B X γ m ξ) (pchAmp5 B Y γ (N - m)) ξ +
          (1/2 : ℂ) • pchTr5 B G γ (N + m) (fun i => star (pchAmp5 B X γ m ξ i)) (pchAmp5 B Y γ (N + m)) ξ) := by
      intro X Y αX αY hX hY m
      rw [(hAl X αX hX m).self_of_nhds]
      by_cases h : X γ m ξ = 0
      · have h0 := AmpV X γ m ξ h
        have hs0 : (fun i => star (pchAmp5 B X γ m ξ i)) = 0 := by funext i; simp [h0]
        rw [Z0' γ (N - m) _ (pchAmp5 B Y γ (N - m)) (shY ξ c) h0, Z0' γ (N - m) _ (pchAmp5 B Y γ (N - m)) ξ h0,
          Z0' γ (N + m) _ (pchAmp5 B Y γ (N + m)) (shY ξ c) hs0,
          Z0' γ (N + m) _ (pchAmp5 B Y γ (N + m)) ξ hs0]
      · have hnn := hn X αX hX m h
        rw [TrD (N - m) (pchAmp5 B X γ m ξ) _ (hAl Y αY hY (N - m)) (Or.inl hnn),
          TrD (N + m) (fun i => star (pchAmp5 B X γ m ξ i)) _ (hAl Y αY hY (N + m)) (Or.inl hnn)]
    have hPair : ∀ (X Y : WC) (αX αY : ℝ), InWg5 B G (qsOf l0) αX X → InWg5 B G (qsOf l0) αY Y →
        pchPair5 B G (pchAmp5 B X) (pchAmp5 B Y) N γ (shY ξ c) =
          pchPair5 B G (pchAmp5 B X) (pchAmp5 B Y) N γ ξ := by
      intro X Y αX αY hX hY
      unfold pchPair5
      exact finsum_congr (PP X Y αX αY hX hY)
    have hHar : pchHar5 B G Mn P Q γ N (shY ξ c) = pchHar5 B G Mn P Q γ N ξ := by
      unfold pchHar5
      rw [hM1, hQv1 N, T1, T2, hPair P Q αP αQ hP hQ, hPair Q P αQ αP hQ hP]
    simp only [pchG5, if_neg hN0]
    rw [hqsh, hHar]
  exact ⟨hi, hii, hiii, hiv⟩

theorem pch5_transversal : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (c : WC) (β : ℝ), InWg5 B G (qsOf l0) (β + 1/2) c → InWg5 B G (qsOf l0) β (velW5 B G c) → InWg5 B G (qsOf l0) (β - kapS) (pchPh5 B G c) :=
by
  intro B G hok hG
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨lv, hv⟩ := velRem5_class B G hok hG
  obtain ⟨lp, hp⟩ := pulse_support_good_v5 B G hok hG
  obtain ⟨lg, hg⟩ := good_nphi5_nb_v5 B G hok hG
  obtain ⟨lb, hb⟩ := band_coarse_gap_v5 B.h hh0 hh1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  obtain ⟨C0, hC0⟩ := visc5_scalar_factors_v5 B hok 0 0
  choose Cn hCn using hg
  refine ⟨lv + lp + lg + lb + n0, fun l0 hl0 c β hc _ => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hq1 : qsOf l0 ≤ 1 := by
    rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hDO : IsOpen (DomC B.h (qsOf l0)) := (domc_open_calculus B (qsOf l0) hok).1
  have hDq : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ := (domc_open_calculus B (qsOf l0) hok).2.2.1

  have key : ∀ (α δ : ℝ) (ρ : Lab → Cyl → ℝ) (a : WC), InWg5 B G (qsOf l0) α a →
      (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), ContDiffAt ℝ ∞ (ρ γ) ξ) →
      (∀ (γ : Lab) (ξ : Cyl) (c : ℝ × ℝ), ρ γ (shY ξ c) = ρ γ ξ) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), 1/4 < qC B.h ξ / Qb γ.1 →
        qC B.h ξ / Qb γ.1 < 4 → B.Xa / 2 < XC B.h ξ → NB B.h (ρ γ) k ξ ≤ C * qC B.h ξ ^ (B.h * δ)) →
      InWg5 B G (qsOf l0) (α + δ)
        (fun γ m ξ => dotProduct (fun i => ((ρ γ ξ * nPhi5 B G γ ξ i : ℝ) : ℂ)) (a γ m ξ)) := by
    intro α δ ρ a ha hρs hρY hρB
    have hsm : ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (a γ m) →
        ContDiffAt ℝ ∞ ((fun (γ : Lab) (_ : ℤ) (ξ : Cyl) (i : Fin 3) =>
          ((ρ γ ξ * nPhi5 B G γ ξ i : ℝ) : ℂ)) γ m) ξ := by
      intro γ m ξ hξ hts
      obtain ⟨-, -, -, -, -, -, -, hxi, het⟩ := hp l0 (by omega) α a ha γ m ξ hξ hts
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      have hξB : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < B.qB :=
        ⟨hξ'.1, hξ'.2.1, lt_of_lt_of_le hξ'.2.2 hqsB⟩
      obtain ⟨U, hUo, hξU, -, hnU, -, -⟩ := good_coeff_smooth_v5 B G γ ξ hok hξB hxi het
      rw [contDiffAt_pi]
      intro i
      have h1 : ContDiffAt ℝ ∞ (fun η => ρ γ η * nPhi5 B G γ η i) ξ :=
        (hρs γ ξ hξ).mul ((hnU i).contDiffAt (hUo.mem_nhds hξU))
      have h2 := (Complex.ofRealCLM.contDiff (n := ∞)).contDiffAt.comp ξ h1
      exact h2
    have hdk : ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), a γ m ξ ≠ 0 → ∀ c : ℝ × ℝ,
        IsDeck B.h (qC B.h ξ) c →
        (fun (γ : Lab) (_ : ℤ) (ξ : Cyl) (i : Fin 3) => ((ρ γ ξ * nPhi5 B G γ ξ i : ℝ) : ℂ)) γ m (shY ξ c) =
        (fun (γ : Lab) (_ : ℤ) (ξ : Cyl) (i : Fin 3) => ((ρ γ ξ * nPhi5 B G γ ξ i : ℝ) : ℂ)) γ m ξ := by
      intro γ m ξ hξ hne c hc
      have hts : ξ ∈ tsupport (a γ m) := subset_tsupport _ hne
      obtain ⟨-, -, -, hb1, hb2, -⟩ := hp l0 (by omega) α a ha γ m ξ hξ hts
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      have hcb := (hb γ.1 l0 (qC B.h ξ) (by omega) (hDq ξ hξ) hξ'.2.2 hb1 hb2).1
      have hn := nPhi5_deck_v5 B G γ (coarseIdx B.h (qC B.h ξ)) c hcb hc ξ
      funext i
      simp only [hρY γ ξ c, hn]
    have hnb : ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (a γ m) →
        B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h ((fun (γ : Lab) (_ : ℤ) (ξ : Cyl) (i : Fin 3) => ((ρ γ ξ * nPhi5 B G γ ξ i : ℝ) : ℂ)) γ m) k ξ
          ≤ C * qC B.h ξ ^ (B.h * δ) * SC B.h ξ ^ b := by
      intro k
      choose Cr hCr using hρB
      refine ⟨3 * (2 ^ k * (∑ j ∈ Finset.range (k+1), |Cr j|) * (∑ j ∈ Finset.range (k+1), |Cn j|)), 1, ?_⟩
      intro γ m ξ hξ hts _ _
      obtain ⟨-, hact, hlγ, hb1, hb2, hX1', hX2', hxi, het⟩ := hp l0 (by omega) α a ha γ m ξ hξ hts
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      have hξB : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < B.qB :=
        ⟨hξ'.1, hξ'.2.1, lt_of_lt_of_le hξ'.2.2 hqsB⟩
      obtain ⟨U, hUo, hξU, -, hnU, -, -⟩ := good_coeff_smooth_v5 B G γ ξ hok hξB hxi het
      have hSC0 : 0 ≤ SC B.h ξ := by unfold SC; positivity
      have hqd : 0 ≤ qC B.h ξ ^ (B.h * δ) := Real.rpow_nonneg (hDq ξ hξ).le _
      have hr : ∀ j, j ≤ k → NB B.h (ρ γ) j ξ ≤
          (∑ j ∈ Finset.range (k+1), |Cr j|) * qC B.h ξ ^ (B.h * δ) := by
        intro j hj
        refine le_trans (hCr j γ ξ hξ hb1 hb2 hX1') (mul_le_mul_of_nonneg_right ?_ hqd)
        refine le_trans (le_abs_self _) ?_
        exact Finset.single_le_sum (f := fun j => |Cr j|) (fun j _ => abs_nonneg _)
          (Finset.mem_range.mpr (by omega))
      have hn : ∀ i : Fin 3, ∀ j, j ≤ k → NB B.h (fun η => nPhi5 B G γ η i) j ξ ≤
          (∑ j ∈ Finset.range (k+1), |Cn j|) * SC B.h ξ := by
        intro i j hj
        refine le_trans (hCn j l0 (by omega) γ hact hlγ ξ hξ hb1 hb2 hX1' hX2' hxi het i) ?_
        apply mul_le_mul_of_nonneg_right _ hSC0
        refine le_trans (le_abs_self _) ?_
        exact Finset.single_le_sum (f := fun j => |Cn j|) (fun j _ => abs_nonneg _)
          (Finset.mem_range.mpr (by omega))
      have hprod : ∀ i : Fin 3, NB B.h (fun η => ρ γ η * nPhi5 B G γ η i) k ξ ≤
          2 ^ k * ((∑ j ∈ Finset.range (k+1), |Cr j|) * qC B.h ξ ^ (B.h * δ)) *
            ((∑ j ∈ Finset.range (k+1), |Cn j|) * SC B.h ξ) :=
        fun i => nb_real_mul_le_v5 B.h ξ (ρ γ) (fun η => nPhi5 B G γ η i) k _ _ (hρs γ ξ hξ)
          ((hnU i).contDiffAt (hUo.mem_nhds hξU)) hr (hn i)
      have hU' : IsOpen (U ∩ DomC B.h (qsOf l0)) := hUo.inter hDO
      have hvec := nb_vec_complex_v5 B.h (U ∩ DomC B.h (qsOf l0)) ξ 1
        (fun i η => ρ γ η * nPhi5 B G γ η i)
        (fun η i => ((ρ γ η * nPhi5 B G γ η i : ℝ) : ℂ)) hU' ⟨hξU, hξ⟩
        (fun i η hη => ((hρs γ η hη.2).contDiffWithinAt).mul ((hnU i).mono Set.inter_subset_left η hη))
        (fun η _ => by funext i; simp only [one_mul]) k
      rw [norm_one, one_mul, Fin.sum_univ_three] at hvec
      rw [Real.rpow_one]
      calc NB B.h (fun η i => ((ρ γ η * nPhi5 B G γ η i : ℝ) : ℂ)) k ξ ≤ _ := hvec
        _ ≤ 2 ^ k * ((∑ j ∈ Finset.range (k+1), |Cr j|) * qC B.h ξ ^ (B.h * δ)) *
              ((∑ j ∈ Finset.range (k+1), |Cn j|) * SC B.h ξ)
            + 2 ^ k * ((∑ j ∈ Finset.range (k+1), |Cr j|) * qC B.h ξ ^ (B.h * δ)) *
              ((∑ j ∈ Finset.range (k+1), |Cn j|) * SC B.h ξ)
            + 2 ^ k * ((∑ j ∈ Finset.range (k+1), |Cr j|) * qC B.h ξ ^ (B.h * δ)) *
              ((∑ j ∈ Finset.range (k+1), |Cn j|) * SC B.h ξ) :=
          add_le_add (add_le_add (hprod 0) (hprod 1)) (hprod 2)
        _ = _ := by ring
    exact inWg5_dot_mult B G l0 hok α δ a
      (fun (γ : Lab) (_ : ℤ) (ξ : Cyl) (i : Fin 3) => ((ρ γ ξ * nPhi5 B G γ ξ i : ℝ) : ℂ)) ha hsm hdk hnb

  have hVR := hv l0 (by omega) (β + 1/2) c hc

  have hRot : InWg5 B G (qsOf l0) (β + 1/2) (fun γ m ξ => rotC (c γ m ξ)) := by
    have e : (fun γ m ξ => rotC (c γ m ξ)) =
        (fun γ m ξ => crossC ((fun (_ : Lab) (_ : ℤ) (_ : Cyl) => (![0, 0, -1] : Fin 3 → ℂ)) γ m ξ)
          (c γ m ξ)) := by
      funext γ m ξ i
      fin_cases i <;> simp [crossC, rotC]
    have h := inWg5_cross_mult B G l0 hok (β + 1/2) 0 c
      (fun (_ : Lab) (_ : ℤ) (_ : Cyl) => (![0, 0, -1] : Fin 3 → ℂ)) hc
      (fun _ _ _ _ _ => contDiffAt_const) (fun _ _ _ _ _ _ _ => rfl) (fun k => ⟨1, 0, fun γ m ξ _ _ _ _ => by
        simp only [mul_zero, Real.rpow_zero, mul_one]
        show ‖(iteratedFDeriv ℝ k (fun _ : Cyl => (![0, 0, -1] : Fin 3 → ℂ)) ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ)‖ ≤ 1
        refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
        rcases Nat.eq_zero_or_pos k with hk | hk
        · subst hk
          rw [norm_iteratedFDeriv_zero, Fin.prod_univ_zero, mul_one]
          refine (pi_norm_le_iff_of_nonneg zero_le_one).mpr (fun i => ?_)
          fin_cases i <;> simp
        · rw [iteratedFDeriv_const_of_ne (by omega : k ≠ 0)]
          simp⟩)
    rw [add_zero] at h
    rw [e]
    exact h

  obtain ⟨hMs, hMb⟩ := wmo_amp_multipliers_v5 B hok (qsOf l0) hq1
  have hdZ : ∀ (ξ : Cyl) (c : ℝ × ℝ), dZ (fun η => Real.log (qC B.h η)) (shY ξ c) =
      dZ (fun η => Real.log (qC B.h η)) ξ := by
    intro ξ c
    have e1 : shY ξ c = ξ + ((0:ℝ), (0:ℝ), (0:ℝ), c) := by
      rcases ξ with ⟨a1, a2, a3, a4⟩
      simp [shY]
    have e2 : (fun x : Cyl => Real.log (qC B.h (x + ((0:ℝ), (0:ℝ), (0:ℝ), c)))) =
        fun η => Real.log (qC B.h η) := by
      funext x
      simp [qC]
    unfold dZ
    rw [e1, ← fderiv_comp_add_right]
    exact congrArg (fun g => fderiv ℝ g ξ (0, 1, 0, 0)) e2
  have hq12 : ∀ ξ ∈ DomC B.h (qsOf l0), ContDiffAt ℝ ∞ (fun η => qC B.h η ^ (1/2:ℝ)) ξ := by
    intro ξ hξ
    have e : (fun η => qC B.h η ^ (1/2:ℝ)) = fun η => Real.sqrt (qC B.h η) := by
      funext η; rw [Real.sqrt_eq_rpow]
    rw [e]; exact (hMs ξ hξ).1
  have hcm : ∀ (a : ℝ) (f : Cyl → ℝ) (ξ : Cyl) (k : ℕ), ξ ∈ DomC B.h (qsOf l0) →
      ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) → NB B.h (fun η => a * f η) k ξ ≤ |a| * NB B.h f k ξ := by
    intro a f ξ k hξ hf
    have h := (nb_real_algebra_v5 B.h _ ξ hDO hξ f f hf hf k).2.1 a 0
    simp only [zero_mul, add_zero, abs_zero] at h
    exact h
  have hNB0 : ∀ (f : Cyl → ℂ) (ξ : Cyl), NB B.h f 0 ξ = ‖f ξ‖ := by
    intro f ξ
    unfold NB
    rw [← ContinuousMultilinearMap.fin0_apply_norm (x := fun i => Fin.elim0 i),
      ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_zero_apply]

  have mult : ∀ (g : Lab → Cyl → ℝ),
      (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), ContDiffAt ℝ ∞ (g γ) ξ) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), 1/4 < qC B.h ξ / Qb γ.1 →
        qC B.h ξ / Qb γ.1 < 4 → NB B.h (g γ) k ξ ≤ C) →
      (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), ContDiffAt ℝ ∞
        (fun η => (kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) * (qC B.h η ^ (1/2:ℝ) * g γ η)) ξ) ∧
      (∀ k : ℕ, ∃ C : ℝ, ∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), 1/4 < qC B.h ξ / Qb γ.1 →
        qC B.h ξ / Qb γ.1 < 4 → B.Xa / 2 < XC B.h ξ →
        NB B.h (fun η => (kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) * (qC B.h η ^ (1/2:ℝ) * g γ η)) k ξ
          ≤ C * qC B.h ξ ^ (B.h * (-(1/2:ℝ)))) := by
    intro g hgs hgB
    have hsm : ∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0),
        ContDiffAt ℝ ∞ (fun η => qC B.h η ^ (1/2:ℝ) * g γ η) ξ :=
      fun γ ξ hξ => (hq12 ξ hξ).mul (hgs γ ξ hξ)
    refine ⟨fun γ ξ hξ => contDiffAt_const.mul (hsm γ ξ hξ), fun k => ?_⟩
    choose Cg hCg using hgB
    choose Cs hCs using hMb
    have hSs : 0 ≤ ∑ j ∈ Finset.range (k+1), |Cs j| := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have hSg : 0 ≤ ∑ j ∈ Finset.range (k+1), |Cg j| := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have hT0 : 0 ≤ 2 ^ k * (∑ j ∈ Finset.range (k+1), |Cs j|) * (∑ j ∈ Finset.range (k+1), |Cg j|) :=
      mul_nonneg (mul_nonneg (pow_nonneg (by norm_num) _) hSs) hSg
    refine ⟨8 * (2 ^ k * (∑ j ∈ Finset.range (k+1), |Cs j|) * (∑ j ∈ Finset.range (k+1), |Cg j|)), ?_⟩
    intro γ ξ hξ hb1 hb2 hX
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hξ1 : ξ ∈ DomC B.h 1 := ⟨hξ'.1, hξ'.2.1, lt_of_lt_of_le hξ'.2.2 hq1⟩
    have hq0 : 0 < qC B.h ξ := hDq ξ hξ
    have hQ0 : 0 ≤ Qb γ.1 := by unfold Qb; exact Real.rpow_nonneg (by norm_num) _
    have hA : ∀ i, i ≤ k → NB B.h (fun η => Real.sqrt (qC B.h η)) i ξ ≤
        (∑ j ∈ Finset.range (k+1), |Cs j|) * Real.sqrt (qC B.h ξ) := by
      intro i hi
      refine le_trans (hCs i ξ hξ).1 (mul_le_mul_of_nonneg_right ?_ (Real.sqrt_nonneg _))
      refine le_trans (le_abs_self _) ?_
      exact Finset.single_le_sum (f := fun j => |Cs j|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.mpr (by omega))
    have hE : ∀ i, i ≤ k → NB B.h (g γ) i ξ ≤ ∑ j ∈ Finset.range (k+1), |Cg j| := by
      intro i hi
      refine le_trans (hCg i γ ξ hξ hb1 hb2) (le_trans (le_abs_self _) ?_)
      exact Finset.single_le_sum (f := fun j => |Cg j|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.mpr (by omega))
    have hP : NB B.h (fun η => qC B.h η ^ (1/2:ℝ) * g γ η) k ξ ≤
        2 ^ k * ((∑ j ∈ Finset.range (k+1), |Cs j|) * Real.sqrt (qC B.h ξ)) *
          (∑ j ∈ Finset.range (k+1), |Cg j|) := by
      have e : (fun η => qC B.h η ^ (1/2:ℝ) * g γ η) = fun η => Real.sqrt (qC B.h η) * g γ η := by
        funext η; rw [Real.sqrt_eq_rpow]
      rw [e]
      exact nb_real_mul_le_v5 B.h ξ (fun η => Real.sqrt (qC B.h η)) (g γ) k _ _ (hMs ξ hξ).1
        (hgs γ ξ hξ) hA hE
    have hC := hcm ((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))) (fun η => qC B.h η ^ (1/2:ℝ) * g γ η) ξ k hξ
      (fun η hη => (hsm γ η hη).contDiffWithinAt)
    obtain ⟨-, -, hQi, hkb⟩ := hC0 γ.1 ξ hξ1 hb1 hb2 hX
    rw [hNB0] at hQi
    rw [hNB0] at hkb
    simp only [Complex.norm_real, Real.norm_eq_abs] at hQi hkb
    rw [abs_of_nonneg (Nat.cast_nonneg _)] at hkb
    rw [abs_of_nonneg (inv_nonneg.mpr (Real.sqrt_nonneg _))] at hQi
    have hcK0 : 0 ≤ (kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) :=
      mul_nonneg (Nat.cast_nonneg _) (Real.rpow_nonneg hQ0 _)
    have hQe : Qb γ.1 ^ (-(1/2:ℝ)) = (Real.sqrt (Qb γ.1))⁻¹ := by
      rw [Real.rpow_neg hQ0, Real.sqrt_eq_rpow]
    have hsq : qC B.h ξ ^ (-(1/2:ℝ)) * Real.sqrt (qC B.h ξ) = 1 := by
      rw [Real.rpow_neg hq0.le, ← Real.sqrt_eq_rpow, inv_mul_cancel₀ (Real.sqrt_pos.mpr hq0).ne']
    have e2 : (Real.sqrt (Qb γ.1))⁻¹ * Real.sqrt (qC B.h ξ) ≤ 2 := by
      calc (Real.sqrt (Qb γ.1))⁻¹ * Real.sqrt (qC B.h ξ)
          ≤ 2 * qC B.h ξ ^ (-(1/2:ℝ)) * Real.sqrt (qC B.h ξ) :=
            mul_le_mul_of_nonneg_right hQi (Real.sqrt_nonneg _)
        _ = 2 := by rw [mul_assoc, hsq, mul_one]
    have e3 : |(kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))| * Real.sqrt (qC B.h ξ) ≤
        8 * qC B.h ξ ^ (B.h * (-(1/2:ℝ))) := by
      rw [abs_of_nonneg hcK0, hQe, mul_assoc]
      have hexp : B.h * (-(1/2:ℝ)) = -(B.h / 2) := by ring
      rw [hexp]
      have hr0 : 0 ≤ qC B.h ξ ^ (-(B.h / 2)) := Real.rpow_nonneg hq0.le _
      calc (kb B.h γ.1 : ℝ) * ((Real.sqrt (Qb γ.1))⁻¹ * Real.sqrt (qC B.h ξ))
          ≤ (4 * qC B.h ξ ^ (-(B.h / 2))) * 2 :=
            mul_le_mul hkb e2 (mul_nonneg (inv_nonneg.mpr (Real.sqrt_nonneg _)) (Real.sqrt_nonneg _))
              (mul_nonneg (by norm_num) hr0)
        _ = 8 * qC B.h ξ ^ (-(B.h / 2)) := by ring
    calc NB B.h (fun η => (kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) * (qC B.h η ^ (1/2:ℝ) * g γ η)) k ξ
        ≤ |(kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))| *
            NB B.h (fun η => qC B.h η ^ (1/2:ℝ) * g γ η) k ξ := hC
      _ ≤ |(kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))| *
            (2 ^ k * ((∑ j ∈ Finset.range (k+1), |Cs j|) * Real.sqrt (qC B.h ξ)) *
              (∑ j ∈ Finset.range (k+1), |Cg j|)) :=
          mul_le_mul_of_nonneg_left hP (abs_nonneg _)
      _ = (2 ^ k * (∑ j ∈ Finset.range (k+1), |Cs j|) * (∑ j ∈ Finset.range (k+1), |Cg j|)) *
            (|(kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))| * Real.sqrt (qC B.h ξ)) := by ring
      _ ≤ (2 ^ k * (∑ j ∈ Finset.range (k+1), |Cs j|) * (∑ j ∈ Finset.range (k+1), |Cg j|)) *
            (8 * qC B.h ξ ^ (B.h * (-(1/2:ℝ)))) :=
          mul_le_mul_of_nonneg_left e3 hT0
      _ = _ := by ring

  obtain ⟨m1s, m1b⟩ := mult (fun γ η => (qC B.h η / Qb γ.1) ^ (1/2:ℝ))
    (fun γ ξ hξ => (rhoQ_rpow_nb_v5 B hok (1/2)).1 γ ξ hξ.2.1)
    (fun k => by
      obtain ⟨C, hC⟩ := (rhoQ_rpow_nb_v5 B hok (1/2)).2 k
      exact ⟨C, fun γ ξ hξ hb1 hb2 => hC γ ξ hξ.2.1 (hξ.2.2.le.trans hq1) hb1 hb2⟩)

  obtain ⟨m2s, m2b⟩ := mult (fun _ η => B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) η)
    (fun γ ξ hξ => (hMs ξ hξ).2)
    (fun k => by
      obtain ⟨C, hC⟩ := hMb k
      exact ⟨C, fun γ ξ hξ _ _ => (hC ξ hξ).2⟩)
  have hP1 := key (β + 1/2 - kapS) (-(1/2:ℝ))
    (fun γ η => (kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) * (qC B.h η ^ (1/2:ℝ) * (qC B.h η / Qb γ.1) ^ (1/2:ℝ)))
    _ hVR m1s (fun γ ξ c => rfl) m1b
  have hP2 := key (β + 1/2) (-(1/2:ℝ))
    (fun γ η => (kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) *
      (qC B.h η ^ (1/2:ℝ) * (B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) η)))
    _ hRot m2s
    (fun γ ξ c => by
      show (kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) * (qC B.h (shY ξ c) ^ (1/2:ℝ) *
        (B.h * qC B.h (shY ξ c) ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) (shY ξ c))) = _
      rw [hdZ ξ c]
      rfl)
    m2b
  have hsum := (@pq5_add_congr_class B G (qsOf l0) hok hq1 ℂ _ _).1 _ _ _ _ hP1 hP2
  have hk0 : (0:ℝ) < kapS := by
    show (0:ℝ) < 1 / 100000
    norm_num
  rw [min_eq_left (by linarith)] at hsum
  have hex : β + 1/2 - kapS + -(1/2:ℝ) = β - kapS := by ring
  rw [hex] at hsum

  have efun : pchPh5 B G c = fun γ m ξ =>
      dotProduct (fun i => (((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) *
          (qC B.h ξ ^ (1/2:ℝ) * (qC B.h ξ / Qb γ.1) ^ (1/2:ℝ)) * nPhi5 B G γ ξ i : ℝ) : ℂ))
        (velRem5 B c γ m ξ) +
      dotProduct (fun i => (((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) *
          (qC B.h ξ ^ (1/2:ℝ) * (B.h * qC B.h ξ ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) ξ)) *
            nPhi5 B G γ ξ i : ℝ) : ℂ))
        (rotC (c γ m ξ)) := by
    funext γ m ξ
    simp only [pchPh5, wmoAmp5, velW5, velC5, velRem5, rotC, dotProduct, Fin.sum_univ_three,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
      Matrix.tail_cons, Complex.ofReal_mul]
    ring
  rw [efun]
  exact hsum

theorem pch5_wave_factor : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (α : ℝ) (a : WC), InWg5 B G (qsOf l0) α a → ∀ k : ℕ, ∃ b d : ℝ, ∀ i : Fin 3, CUB5 B (fun γ m ξ => ξ ∈ DomC B.h (qsOf l0) ∧ B.Xa < XC B.h ξ ∧ XC B.h ξ < B.Xb ∧ ξ ∈ tsupport (a γ m)) k (fun γ m η => pchAmp5 B a γ m η i) (-Aex B.h + B.h * α) (wtW5 B G b d) ∧ CUB5 B (fun γ m ξ => ξ ∈ DomC B.h (qsOf l0) ∧ B.Xa < XC B.h ξ ∧ XC B.h ξ < B.Xb ∧ ξ ∈ tsupport (a γ m)) k (fun γ m η => dR B.h (pchAmp5 B a γ m) η i) (-Aex B.h + B.h * α - 1/2 - B.h * kapS) (wtW5 B G b d) ∧ CUB5 B (fun γ m ξ => ξ ∈ DomC B.h (qsOf l0) ∧ B.Xa < XC B.h ξ ∧ XC B.h ξ < B.Xb ∧ ξ ∈ tsupport (a γ m)) k (fun γ m η => dZ (pchAmp5 B a γ m) η i) (-Aex B.h + B.h * α - 1/2) (wtW5 B G b d) :=
by
  intro B G hok hG
  obtain ⟨lR, hR⟩ := inWg5_dR_class_v5 B G hok hG
  obtain ⟨lZ, hZ⟩ := inWg5_dZ_class_v5 B G hok hG
  refine ⟨lR + lZ, ?_⟩
  intro l0 hl0 α a ha k
  have hh0 : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hk : kapS = 1 / 100000 := rfl
  have haR := hR l0 (by omega) α a ha
  have haZ := hZ l0 (by omega) α a ha
  obtain ⟨hDo, hqC, hqpos, -, hcalc, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  have hDq : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 ∧ 1 ≤ SC B.h ξ := by
    intro ξ hξ
    have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
    obtain ⟨-, -, e3⟩ := hξ
    refine ⟨hq0, by linarith, ?_⟩
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hEdge : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X ∧
      0 < edgeDist B.Xa B.Xb X ∧ edgeDist B.Xa B.Xb X ≤ 1 := by
    intro X e1 e2
    refine ⟨?_, ?_, min_le_left _ _⟩
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · have hX : 0 < X := lt_trans hXa e1
      have l1 : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr e1)
      have l2 : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX).mpr e2)
      exact lt_min one_pos (lt_min l1 l2)
  have hNBnn : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (j : ℕ) (ξ : Cyl),
      0 ≤ NB B.h f j ξ := by
    intro V _ _ f j ξ
    unfold NB
    exact norm_nonneg _
  have hsm : ∀ (U : Set Cyl) (f : Cyl → ℝ), ContDiffOn ℝ ∞ f U →
      ContDiffOn ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) U := by
    intro U f hf
    have hcomp : (fun η => ((f η : ℝ) : ℂ)) = ⇑(Complex.ofRealCLM : ℝ →L[ℝ] ℂ) ∘ f := by
      funext η; simp [Complex.ofRealCLM_apply]
    rw [hcomp]
    exact (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).contDiff.comp_contDiffOn hf

  have hofR : ∀ (ξ : Cyl) (f : Cyl → ℝ), ContDiffAt ℝ ∞ f ξ → ∀ j : ℕ,
      NB B.h (fun η => ((f η : ℝ) : ℂ)) j ξ ≤ NB B.h f j ξ := by
    intro ξ f hf j
    have hLn : ‖(Complex.ofRealCLM : ℝ →L[ℝ] ℂ)‖ ≤ 1 :=
      ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => by
        rw [Complex.ofRealCLM_apply, Complex.norm_real, one_mul])
    have hcomp : (fun η => ((f η : ℝ) : ℂ)) = ⇑(Complex.ofRealCLM : ℝ →L[ℝ] ℂ) ∘ f := by
      funext η; simp [Complex.ofRealCLM_apply]
    rw [hcomp]
    have e1 : iteratedFDeriv ℝ j (⇑(Complex.ofRealCLM : ℝ →L[ℝ] ℂ) ∘ f) ξ =
        (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).compContinuousMultilinearMap (iteratedFDeriv ℝ j f ξ) :=
      ContinuousLinearMap.iteratedFDeriv_comp_left (Complex.ofRealCLM : ℝ →L[ℝ] ℂ) hf
        (i := j) (by exact_mod_cast le_top)
    unfold NB
    rw [e1]
    have e2 : ((Complex.ofRealCLM : ℝ →L[ℝ] ℂ).compContinuousMultilinearMap
          (iteratedFDeriv ℝ j f ξ)).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
        (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).compContinuousMultilinearMap
          ((iteratedFDeriv ℝ j f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext v
      rfl
    rw [e2]
    calc _ ≤ ‖(Complex.ofRealCLM : ℝ →L[ℝ] ℂ)‖ *
          ‖(iteratedFDeriv ℝ j f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ 1 * ‖(iteratedFDeriv ℝ j f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ :=
          mul_le_mul_of_nonneg_right hLn (norm_nonneg _)
      _ = _ := one_mul _

  have hproj : ∀ (ξ : Cyl) (F : Cyl → Fin 3 → ℂ) (i : Fin 3), ContDiffAt ℝ ∞ F ξ → ∀ j : ℕ,
      NB B.h (fun η => F η i) j ξ ≤ NB B.h F j ξ := by
    intro ξ F i hF j
    have hLn : ‖(ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i)‖ ≤ 1 :=
      ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => by
        rw [one_mul]
        exact norm_le_pi_norm x i)
    have hcomp : (fun η => F η i) =
        ⇑(ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i) ∘ F := by
      funext η; rfl
    rw [hcomp]
    have e1 : iteratedFDeriv ℝ j (⇑(ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i) ∘ F) ξ =
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i).compContinuousMultilinearMap
          (iteratedFDeriv ℝ j F ξ) :=
      ContinuousLinearMap.iteratedFDeriv_comp_left
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i) hF
        (i := j) (by exact_mod_cast le_top)
    unfold NB
    rw [e1]
    have e2 : ((ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i).compContinuousMultilinearMap
          (iteratedFDeriv ℝ j F ξ)).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i).compContinuousMultilinearMap
          ((iteratedFDeriv ℝ j F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext v
      rfl
    rw [e2]
    calc _ ≤ ‖(ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i)‖ *
          ‖(iteratedFDeriv ℝ j F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ 1 * ‖(iteratedFDeriv ℝ j F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ :=
          mul_le_mul_of_nonneg_right hLn (norm_nonneg _)
      _ = _ := one_mul _

  have hmono : ∀ (C S Q Sv E e P b b' d d' : ℝ), 0 ≤ Q → 1 ≤ Sv → 0 ≤ E → 0 < e → e ≤ 1 → 0 ≤ P →
      C ≤ S → b' ≤ b → d' ≤ d → 0 ≤ S →
      C * Q * Sv ^ b' * E * e ^ (-d') * P ≤ S * Q * (Sv ^ b * E * e ^ (-d) * P) := by
    intro C S Q Sv E e P b b' d d' hQ hSv hE he0 he1 hP hCS hb hd hS
    have f2 : Sv ^ b' ≤ Sv ^ b := Real.rpow_le_rpow_of_exponent_le hSv hb
    have f3 : e ^ (-d') ≤ e ^ (-d) := Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hd)
    have p2 : 0 ≤ Sv ^ b' := Real.rpow_nonneg (by linarith) _
    have p2' : 0 ≤ Sv ^ b := Real.rpow_nonneg (by linarith) _
    have p3 : 0 ≤ e ^ (-d') := Real.rpow_nonneg he0.le _
    have hX0 : 0 ≤ Q * Sv ^ b' * E * e ^ (-d') * P :=
      mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hQ p2) hE) p3) hP
    have hXY : Q * Sv ^ b' * E * e ^ (-d') * P ≤ Q * Sv ^ b * E * e ^ (-d) * P := by
      have m1 : Q * Sv ^ b' ≤ Q * Sv ^ b := mul_le_mul_of_nonneg_left f2 hQ
      have m2 : Q * Sv ^ b' * E ≤ Q * Sv ^ b * E := mul_le_mul_of_nonneg_right m1 hE
      have m3 : Q * Sv ^ b' * E * e ^ (-d') ≤ Q * Sv ^ b * E * e ^ (-d) :=
        mul_le_mul m2 f3 p3 (mul_nonneg (mul_nonneg hQ p2') hE)
      exact mul_le_mul_of_nonneg_right m3 hP
    calc C * Q * Sv ^ b' * E * e ^ (-d') * P = C * (Q * Sv ^ b' * E * e ^ (-d') * P) := by ring
      _ ≤ S * (Q * Sv ^ b' * E * e ^ (-d') * P) := mul_le_mul_of_nonneg_right hCS hX0
      _ ≤ S * (Q * Sv ^ b * E * e ^ (-d) * P) := mul_le_mul_of_nonneg_left hXY hS
      _ = S * Q * (Sv ^ b * E * e ^ (-d) * P) := by ring
  set P : Lab → ℤ → Cyl → Prop := fun γ m ξ => ξ ∈ DomC B.h (qsOf l0) ∧ B.Xa < XC B.h ξ ∧
    XC B.h ξ < B.Xb ∧ ξ ∈ tsupport (a γ m) with hP
  have hPD : ∀ γ m ξ, P γ m ξ → ξ ∈ DomC B.h (qsOf l0) ∧ B.Xa < XC B.h ξ ∧ XC B.h ξ < B.Xb :=
    fun γ m ξ h => ⟨h.1, h.2.1, h.2.2.1⟩
  have hPq : ∀ γ m ξ, P γ m ξ → 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 :=
    fun γ m ξ h => ⟨(hDq ξ h.1).1, (hDq ξ h.1).2.1⟩
  obtain ⟨-, hadd, -, hweak, -⟩ := cub5_algebra B P k hPq

  have hcongr : ∀ (f f' : Lab → ℤ → Cyl → ℂ) (e : ℝ) (w : Lab → Cyl → ℝ),
      (∀ γ m, ∀ η ∈ DomC B.h (qsOf l0), f γ m η = f' γ m η) → CUB5 B P k f' e w → CUB5 B P k f e w := by
    intro f f' e w heq hf'
    obtain ⟨c, hc, H⟩ := hf'
    refine ⟨c, hc, fun γ m ξ hPξ => ?_⟩
    obtain ⟨hw, ⟨U, hUo, hξU, hU⟩, hb⟩ := H γ m ξ hPξ
    have hξD := (hPD γ m ξ hPξ).1
    refine ⟨hw, ⟨DomC B.h (qsOf l0) ∩ U, hDo.inter hUo, ⟨hξD, hξU⟩,
      (hU.mono inter_subset_right).congr (fun η hη => heq γ m η hη.1)⟩, fun j hj => ?_⟩
    have hev : f γ m =ᶠ[nhds ξ] f' γ m :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξD) (fun η hη => heq γ m η hη)
    have e1 : NB B.h (f γ m) j ξ = NB B.h (f' γ m) j ξ := by
      unfold NB
      rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds]
    rw [e1]
    exact hb j hj

  have hgen : ∀ (s : Cyl → ℝ) (E β : ℝ) (g : WC), InWg5 B G (qsOf l0) β g →
      ContDiffOn ℝ ∞ s (DomC B.h (qsOf l0)) →
      (∀ j : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0), NB B.h s j ξ ≤ C * qC B.h ξ ^ E) →
      ∃ b0 d0 : ℝ, ∀ b d : ℝ, b0 ≤ b → d0 ≤ d → ∀ i : Fin 3,
        CUB5 B P k (fun γ m η => ((s η : ℝ) : ℂ) * g γ m η i) (E + B.h * β) (wtW5 B G b d) := by
    intro s E β g hg hs hsb
    obtain ⟨-, hgs, -, -, hgb⟩ := hg
    choose Cs hCs using hsb
    choose Cg bg dg hCg using hgb
    obtain ⟨Ss, hSsd⟩ : ∃ S : ℝ, S = ∑ j ∈ Finset.range (k+1), |Cs j| := ⟨_, rfl⟩
    obtain ⟨Sg, hSgd⟩ : ∃ S : ℝ, S = ∑ j ∈ Finset.range (k+1), |Cg j| := ⟨_, rfl⟩
    obtain ⟨b0, hb0d⟩ : ∃ S : ℝ, S = ∑ j ∈ Finset.range (k+1), |bg j| := ⟨_, rfl⟩
    obtain ⟨d0, hd0d⟩ : ∃ S : ℝ, S = ∑ j ∈ Finset.range (k+1), |dg j| := ⟨_, rfl⟩
    have hSs : 0 ≤ Ss := by rw [hSsd]; exact Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have hSg : 0 ≤ Sg := by rw [hSgd]; exact Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have hCs_le : ∀ t, t ≤ k → Cs t ≤ Ss := by
      intro t ht
      have htm : t ∈ Finset.range (k+1) := Finset.mem_range.2 (by omega)
      rw [hSsd]
      exact (le_abs_self _).trans (Finset.single_le_sum (fun i _ => abs_nonneg (Cs i)) htm)
    have hCg_le : ∀ t, t ≤ k → Cg t ≤ Sg := by
      intro t ht
      have htm : t ∈ Finset.range (k+1) := Finset.mem_range.2 (by omega)
      rw [hSgd]
      exact (le_abs_self _).trans (Finset.single_le_sum (fun i _ => abs_nonneg (Cg i)) htm)
    have hbg_le : ∀ t, t ≤ k → bg t ≤ b0 := by
      intro t ht
      have htm : t ∈ Finset.range (k+1) := Finset.mem_range.2 (by omega)
      rw [hb0d]
      exact (le_abs_self _).trans (Finset.single_le_sum (fun i _ => abs_nonneg (bg i)) htm)
    have hdg_le : ∀ t, t ≤ k → dg t ≤ d0 := by
      intro t ht
      have htm : t ∈ Finset.range (k+1) := Finset.mem_range.2 (by omega)
      rw [hd0d]
      exact (le_abs_self _).trans (Finset.single_le_sum (fun i _ => abs_nonneg (dg i)) htm)
    refine ⟨b0, d0, fun b d hb hd i => ?_⟩
    refine ⟨((k + 1 : ℕ) : ℝ) * 2 ^ k * Ss * Sg, mul_nonneg (mul_nonneg (by positivity) hSs) hSg,
      fun γ m ξ hPξ => ?_⟩
    obtain ⟨hξ, hX1, hX2⟩ := hPD γ m ξ hPξ
    obtain ⟨hq0, hq1, hS1⟩ := hDq ξ hξ
    obtain ⟨hEW, hED0, hED1⟩ := hEdge _ hX1 hX2
    have hPv : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
      unfold Penv5
      exact (Real.exp_pos _).le
    have hw0 : 0 ≤ wtW5 B G b d γ ξ := by
      unfold wtW5
      exact mul_nonneg (mul_nonneg (mul_nonneg (Real.rpow_nonneg (by linarith) _) (Real.sqrt_nonneg _))
        (Real.rpow_nonneg hED0.le _)) hPv
    have hfs : ContDiffOn ℝ ∞ (fun η => ((s η : ℝ) : ℂ)) (DomC B.h (qsOf l0)) := hsm _ _ hs
    have hgi : ContDiffOn ℝ ∞ (fun η => g γ m η i) (DomC B.h (qsOf l0)) := contDiffOn_pi.1 (hgs γ m) i
    refine ⟨hw0, ⟨_, hDo, hξ, hfs.mul hgi⟩, fun j hj => ?_⟩
    have hcs : ContDiffAt ℝ ∞ s ξ := hs.contDiffAt (hDo.mem_nhds hξ)
    have hcg : ContDiffAt ℝ ∞ (g γ m) ξ := (hgs γ m).contDiffAt (hDo.mem_nhds hξ)
    have hqE : 0 ≤ qC B.h ξ ^ E := Real.rpow_nonneg hq0.le _
    have hqB : 0 ≤ qC B.h ξ ^ (B.h * β) := Real.rpow_nonneg hq0.le _
    have hSb : ∀ t, t ≤ k → NB B.h (fun η => ((s η : ℝ) : ℂ)) t ξ ≤ Ss * qC B.h ξ ^ E := by
      intro t ht
      exact (hofR ξ s hcs t).trans ((hCs t ξ hξ).trans (mul_le_mul_of_nonneg_right (hCs_le t ht) hqE))
    have hWb : ∀ u, u ≤ k → NB B.h (fun η => g γ m η i) u ξ ≤
        Sg * qC B.h ξ ^ (B.h * β) * wtW5 B G b d γ ξ := by
      intro u hu
      exact (hproj ξ (g γ m) i hcg u).trans ((hCg u γ m ξ hξ hX1 hX2).trans
        (hmono _ _ _ _ _ _ _ _ _ _ _ hqB hS1 (Real.sqrt_nonneg _) hED0 hED1 hPv (hCg_le u hu)
          ((hbg_le u hu).trans hb) ((hdg_le u hu).trans hd) hSg))
    have hch : ∀ t ∈ Finset.range (j+1), ((j.choose t : ℕ) : ℝ) ≤ 2 ^ k := by
      intro t ht
      have h1 : j.choose t ≤ 2 ^ j := by
        rw [← Nat.sum_range_choose j]
        exact Finset.single_le_sum (f := fun m => j.choose m) (fun _ _ => Nat.zero_le _) ht
      have h2 : 2 ^ j ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) hj
      exact_mod_cast h1.trans h2
    have hA0 : 0 ≤ Ss * qC B.h ξ ^ E := mul_nonneg hSs hqE
    have hB0 : 0 ≤ Sg * qC B.h ξ ^ (B.h * β) * wtW5 B G b d γ ξ := mul_nonneg (mul_nonneg hSg hqB) hw0
    have hX0 : 0 ≤ (2:ℝ) ^ k * (Ss * qC B.h ξ ^ E) * (Sg * qC B.h ξ ^ (B.h * β) * wtW5 B G b d γ ξ) :=
      mul_nonneg (mul_nonneg (by positivity) hA0) hB0
    have hterm : ∀ t ∈ Finset.range (j+1), ((j.choose t : ℕ) : ℝ) * NB B.h (fun η => ((s η : ℝ) : ℂ)) t ξ *
        NB B.h (fun η => g γ m η i) (j - t) ξ ≤
        (2:ℝ) ^ k * (Ss * qC B.h ξ ^ E) * (Sg * qC B.h ξ ^ (B.h * β) * wtW5 B G b d γ ξ) := by
      intro t ht
      have htj : t ≤ j := Nat.lt_succ_iff.1 (Finset.mem_range.1 ht)
      exact mul_le_mul (mul_le_mul (hch t ht) (hSb t (by omega)) (hNBnn _ _ _) (by positivity))
        (hWb (j - t) (by omega)) (hNBnn _ _ _) (mul_nonneg (by positivity) hA0)
    have hL := nb_mul_le_open B.h (DomC B.h (qsOf l0)) hDo (fun η => ((s η : ℝ) : ℂ))
      (fun η => g γ m η i) hfs hgi ξ hξ j
    show NB B.h (fun η => ((s η : ℝ) : ℂ) * g γ m η i) j ξ ≤ _
    calc NB B.h (fun η => ((s η : ℝ) : ℂ) * g γ m η i) j ξ
        ≤ ∑ t ∈ Finset.range (j + 1), ((j.choose t : ℕ) : ℝ) * NB B.h (fun η => ((s η : ℝ) : ℂ)) t ξ *
            NB B.h (fun η => g γ m η i) (j - t) ξ := hL
      _ ≤ ∑ t ∈ Finset.range (j + 1),
            (2:ℝ) ^ k * (Ss * qC B.h ξ ^ E) * (Sg * qC B.h ξ ^ (B.h * β) * wtW5 B G b d γ ξ) :=
          Finset.sum_le_sum hterm
      _ = ((j + 1 : ℕ) : ℝ) *
            ((2:ℝ) ^ k * (Ss * qC B.h ξ ^ E) * (Sg * qC B.h ξ ^ (B.h * β) * wtW5 B G b d γ ξ)) := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      _ ≤ ((k + 1 : ℕ) : ℝ) *
            ((2:ℝ) ^ k * (Ss * qC B.h ξ ^ E) * (Sg * qC B.h ξ ^ (B.h * β) * wtW5 B G b d γ ξ)) :=
          mul_le_mul_of_nonneg_right (by exact_mod_cast (by omega : j + 1 ≤ k + 1)) hX0
      _ = ((k + 1 : ℕ) : ℝ) * 2 ^ k * Ss * Sg * qC B.h ξ ^ (E + B.h * β) * wtW5 B G b d γ ξ := by
          rw [Real.rpow_add hq0]
          ring

  have hgerm : ∀ (x : Cyl → Fin 3 → ℂ) (η v : Cyl), η ∈ DomC B.h (qsOf l0) → DifferentiableAt ℝ x η →
      fderiv ℝ (fun ξ => ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) • x ξ) η v =
        ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ) • fderiv ℝ x η v +
          ((fderiv ℝ (fun ξ => qC B.h ξ ^ (-Aex B.h)) η v : ℝ) : ℂ) • x η := by
    intro x η v hη hx
    have he : DifferentiableAt ℝ (fun ξ => qC B.h ξ ^ (-Aex B.h)) η :=
      ((hqC.contDiffAt (hDo.mem_nhds hη)).differentiableAt (by norm_num)).rpow_const
        (Or.inl (hqpos η hη).ne')
    have hfun : (fun ξ => ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ)) =
        ⇑(Complex.ofRealCLM : ℝ →L[ℝ] ℂ) ∘ (fun ξ => qC B.h ξ ^ (-Aex B.h)) := by
      funext ξ; simp [Complex.ofRealCLM_apply]
    have hc : DifferentiableAt ℝ (fun ξ => ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ)) η := by
      rw [hfun]
      exact (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).differentiableAt.comp η he
    have hfc : fderiv ℝ (fun ξ => ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ)) η =
        (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).comp (fderiv ℝ (fun ξ => qC B.h ξ ^ (-Aex B.h)) η) := by
      rw [hfun, fderiv_comp η (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).differentiableAt he,
        ContinuousLinearMap.fderiv]
    rw [fderiv_fun_smul hc hx, hfc]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.coe_smul', Pi.smul_apply,
      ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.comp_apply, Complex.ofRealCLM_apply]

  have he : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η ^ (-Aex B.h)) (DomC B.h (qsOf l0)) :=
    hqC.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
  obtain ⟨heR, heZ, -⟩ := hcalc _ he
  have hY : ∀ η : Cyl, (fun η : Cyl => qC B.h η ^ (-Aex B.h)) η =
      (fun η : Cyl => qC B.h η ^ (-Aex B.h)) (η.1, η.2.1, η.2.2.1, ((0:ℝ), (0:ℝ))) := fun η => rfl
  have htn := tn_qpow_normalized_v5 B.h hh0 hh1 hok.1 (-Aex B.h)
  have hS0 : ∀ j : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0),
      NB B.h (fun η : Cyl => qC B.h η ^ (-Aex B.h)) j ξ ≤ C * qC B.h ξ ^ (-Aex B.h) := by
    intro j
    obtain ⟨C, hC⟩ := htn j
    exact ⟨C, fun ξ hξ => hC ξ hξ.2.1 (hDq ξ hξ).2.1⟩
  have hS1 : ∀ j : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0),
      NB B.h (dR B.h (fun η : Cyl => qC B.h η ^ (-Aex B.h))) j ξ ≤ C * qC B.h ξ ^ (-Aex B.h - 1/2) := by
    intro j
    obtain ⟨C, hC⟩ := htn (j + 1)
    refine ⟨C, fun ξ hξ => ?_⟩
    obtain ⟨hq0, hq1, -⟩ := hDq ξ hξ
    have h1 := (nb_dRdZ_yind_v5 B.h _ _ hDo he hY ξ hξ hq0 j).1
    have h2 := hC ξ hξ.2.1 hq1
    calc _ ≤ qC B.h ξ ^ (-(1/2 : ℝ)) * NB B.h (fun η : Cyl => qC B.h η ^ (-Aex B.h)) (j + 1) ξ := h1
      _ ≤ qC B.h ξ ^ (-(1/2 : ℝ)) * (C * qC B.h ξ ^ (-Aex B.h)) :=
          mul_le_mul_of_nonneg_left h2 (Real.rpow_nonneg hq0.le _)
      _ = C * qC B.h ξ ^ (-Aex B.h - 1/2) := by
          rw [show -Aex B.h - 1/2 = -(1/2 : ℝ) + -Aex B.h by ring, Real.rpow_add hq0]
          ring
  have hS2 : ∀ j : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0),
      NB B.h (dZ (fun η : Cyl => qC B.h η ^ (-Aex B.h))) j ξ ≤ C * qC B.h ξ ^ (-Aex B.h - 1/2 + B.h) := by
    intro j
    obtain ⟨C, hC⟩ := htn (j + 1)
    refine ⟨C, fun ξ hξ => ?_⟩
    obtain ⟨hq0, hq1, -⟩ := hDq ξ hξ
    have h1 := (nb_dRdZ_yind_v5 B.h _ _ hDo he hY ξ hξ hq0 j).2
    have h2 := hC ξ hξ.2.1 hq1
    calc _ ≤ qC B.h ξ ^ (-(1/2 - B.h)) * NB B.h (fun η : Cyl => qC B.h η ^ (-Aex B.h)) (j + 1) ξ := h1
      _ ≤ qC B.h ξ ^ (-(1/2 - B.h)) * (C * qC B.h ξ ^ (-Aex B.h)) :=
          mul_le_mul_of_nonneg_left h2 (Real.rpow_nonneg hq0.le _)
      _ = C * qC B.h ξ ^ (-Aex B.h - 1/2 + B.h) := by
          rw [show -Aex B.h - 1/2 + B.h = -(1/2 - B.h) + -Aex B.h by ring, Real.rpow_add hq0]
          ring

  obtain ⟨b1, d1, T1⟩ := hgen _ (-Aex B.h) α a ha he hS0
  obtain ⟨b2, d2, T2⟩ := hgen _ (-Aex B.h) (α - 1 / (2 * B.h) - kapS) _ haR he hS0
  obtain ⟨b3, d3, T3⟩ := hgen _ (-Aex B.h - 1/2) α a ha heR hS1
  obtain ⟨b4, d4, T4⟩ := hgen _ (-Aex B.h) (α - 1 / (2 * B.h)) _ haZ he hS0
  obtain ⟨b5, d5, T5⟩ := hgen _ (-Aex B.h - 1/2 + B.h) α a ha heZ hS2
  have h5 : ∀ x1 x2 x3 x4 x5 : ℝ, x1 ≤ |x1| + |x2| + |x3| + |x4| + |x5| ∧
      x2 ≤ |x1| + |x2| + |x3| + |x4| + |x5| ∧ x3 ≤ |x1| + |x2| + |x3| + |x4| + |x5| ∧
      x4 ≤ |x1| + |x2| + |x3| + |x4| + |x5| ∧ x5 ≤ |x1| + |x2| + |x3| + |x4| + |x5| := by
    intro x1 x2 x3 x4 x5
    have a1 := le_abs_self x1
    have a2 := le_abs_self x2
    have a3 := le_abs_self x3
    have a4 := le_abs_self x4
    have a5 := le_abs_self x5
    have n1 := abs_nonneg x1
    have n2 := abs_nonneg x2
    have n3 := abs_nonneg x3
    have n4 := abs_nonneg x4
    have n5 := abs_nonneg x5
    refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> linarith
  obtain ⟨hb1, hb2, hb3, hb4, hb5⟩ := h5 b1 b2 b3 b4 b5
  obtain ⟨hd1, hd2, hd3, hd4, hd5⟩ := h5 d1 d2 d3 d4 d5
  refine ⟨|b1| + |b2| + |b3| + |b4| + |b5|, |d1| + |d2| + |d3| + |d4| + |d5|, fun i => ⟨?_, ?_, ?_⟩⟩
  ·
    refine hcongr _ _ _ _ (fun γ m η _ => ?_) (T1 _ _ hb1 hd1 i)
    simp only [pchAmp5, Pi.smul_apply, smul_eq_mul]
  ·
    have hinv : B.h * (1 / (2 * B.h)) = 1/2 := by
      field_simp
    have hk0 : 0 ≤ B.h * kapS := mul_nonneg hh0.le (by rw [hk]; norm_num)
    have T2' := hweak _ _ (-Aex B.h + B.h * α - 1/2 - B.h * kapS) _ _ (T2 _ _ hb2 hd2 i)
      (by rw [mul_sub, mul_sub, hinv]; linarith) (fun _ _ _ _ => le_rfl)
    have T3' := hweak _ _ (-Aex B.h + B.h * α - 1/2 - B.h * kapS) _ _ (T3 _ _ hb3 hd3 i)
      (by linarith) (fun _ _ _ _ => le_rfl)
    refine hcongr _ _ _ _ (fun γ m η hη => ?_) (hadd _ _ _ _ T2' T3').1
    have hx : DifferentiableAt ℝ (a γ m) η :=
      ((ha.2.1 γ m).contDiffAt (hDo.mem_nhds hη)).differentiableAt (by norm_num)
    show fderiv ℝ (fun ξ => ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) • a γ m ξ) η
      (1, 0, 0, (drx B.h * η.1 ^ (drx B.h - 1)) • vrv) i = _
    rw [hgerm (a γ m) η _ hη hx]
    simp only [cxAdd5, dR, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  ·
    have hinv : B.h * (1 / (2 * B.h)) = 1/2 := by
      field_simp
    have T4' := hweak _ _ (-Aex B.h + B.h * α - 1/2) _ _ (T4 _ _ hb4 hd4 i)
      (by rw [mul_sub, hinv]; linarith) (fun _ _ _ _ => le_rfl)
    have T5' := hweak _ _ (-Aex B.h + B.h * α - 1/2) _ _ (T5 _ _ hb5 hd5 i)
      (by linarith) (fun _ _ _ _ => le_rfl)
    refine hcongr _ _ _ _ (fun γ m η hη => ?_) (hadd _ _ _ _ T4' T5').1
    have hx : DifferentiableAt ℝ (a γ m) η :=
      ((ha.2.1 γ m).contDiffAt (hDo.mem_nhds hη)).differentiableAt (by norm_num)
    show fderiv ℝ (fun ξ => ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) • a γ m ξ) η (0, 1, 0, 0) i = _
    rw [hgerm (a γ m) η _ hη hx]
    simp only [cxAdd5, dZ, Pi.add_apply, Pi.smul_apply, smul_eq_mul]

theorem pch5_mean_factor : ∀ (B : BG), B.ok → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (Mn : Cyl → Fin 3 → ℝ), (∀ a : Fin 3, InM B (qsOf l0) 0.9 (nrm B (Aex B.h) (fun ξ => Mn ξ a))) → ∀ k : ℕ, ∃ b d : ℝ, ∀ i : Fin 3, CUB5 B (fun _ _ ξ => ξ ∈ DomC B.h (qsOf l0) ∧ B.Xa < XC B.h ξ ∧ XC B.h ξ < B.Xb) k (fun _ _ η => pchMnC5 Mn η i) (-Aex B.h + B.h * 0.9) (wtD5 B b d) ∧ CUB5 B (fun _ _ ξ => ξ ∈ DomC B.h (qsOf l0) ∧ B.Xa < XC B.h ξ ∧ XC B.h ξ < B.Xb) k (fun _ _ η => dR B.h (pchMnC5 Mn) η i) (-Aex B.h + B.h * 0.9 - 1/2 - B.h * kapS) (wtD5 B b d) ∧ CUB5 B (fun _ _ ξ => ξ ∈ DomC B.h (qsOf l0) ∧ B.Xa < XC B.h ξ ∧ XC B.h ξ < B.Xb) k (fun _ _ η => dZ (pchMnC5 Mn) η i) (-Aex B.h + B.h * 0.9 - 1/2) (wtD5 B b d) :=
by
  intro B hok
  obtain ⟨hh0, hh1, hXa, -, -, -, -, -, -, -, -, -, -⟩ := hok.2.1
  have hSN : SimNorm B.h := simscale_normalized_v4 B.h hh0 hh1 hok.1
  refine ⟨7, ?_⟩
  intro l0 hl0 Mn hMn k
  have hk : kapS = 1 / 100000 := rfl
  have hqs0 : 0 < qsOf l0 := by unfold qsOf Qb; positivity
  have hqs1 : qsOf l0 ≤ 1 := by
    unfold qsOf Qb
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  obtain ⟨hUo, hqC, hqpos, -, hcalc, -⟩ := domc_open_calculus B (qsOf l0) hok

  have hdom : ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 ∧ 1 ≤ SC B.h ξ ∧ 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) ∧
      0 < edgeDist B.Xa B.Xb (XC B.h ξ) ∧ edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := by
    intro ξ hξ hX1 hX2
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    refine ⟨hqpos ξ hξ, by linarith [hξ'.2.2], ?_, ?_, ?_, min_le_left _ _⟩
    · unfold SC
      exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h ξ))])
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · have hX : 0 < XC B.h ξ := lt_trans hXa hX1
      unfold edgeDist
      exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
        (Real.log_pos ((one_lt_div hX).mpr hX2)))

  have unnorm : ∀ (e α : ℝ) (g : Cyl → ℝ), InM B (qsOf l0) α (nrm B e g) →
      ∃ C b d : ℝ, 0 ≤ C ∧ ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        ∀ j : ℕ, j ≤ k → NB B.h g j ξ ≤ C * qC B.h ξ ^ (-e + B.h * α) *
          (SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d)) := by
    intro e α g hF
    have hFs : ContDiffOn ℝ ∞ (nrm B e g) (DomC B.h (qsOf l0)) := hF.1
    have hps : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-e)) (DomC B.h (qsOf l0)) :=
      hqC.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
    choose Cf bf df hCf using hF.2.2.2
    choose Kq hKq using nb_qpow_v4 B (qsOf l0) (-e) hok hSN hqs0 hqs1
    obtain ⟨Cs, hCs⟩ : ∃ Cs : ℝ, Cs = ∑ j ∈ Finset.range (k + 1), |Cf j| := ⟨_, rfl⟩
    obtain ⟨bs, hbs⟩ : ∃ bs : ℝ, bs = ∑ j ∈ Finset.range (k + 1), |bf j| := ⟨_, rfl⟩
    obtain ⟨ds, hds⟩ : ∃ ds : ℝ, ds = ∑ j ∈ Finset.range (k + 1), |df j| := ⟨_, rfl⟩
    obtain ⟨Ks, hKs⟩ : ∃ Ks : ℝ, Ks = ∑ j ∈ Finset.range (k + 1), |Kq j| := ⟨_, rfl⟩
    have hCs0 : 0 ≤ Cs := by rw [hCs]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
    have hKs0 : 0 ≤ Ks := by rw [hKs]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
    have mem : ∀ j, j ≤ k → j ∈ Finset.range (k + 1) :=
      fun j hj => Finset.mem_range.mpr (Nat.lt_succ_of_le hj)
    have hCj : ∀ j, j ≤ k → Cf j ≤ Cs := fun j hj => (le_abs_self _).trans (by
      rw [hCs]; exact Finset.single_le_sum (f := fun j => |Cf j|) (fun j _ => abs_nonneg _) (mem j hj))
    have hbj : ∀ j, j ≤ k → bf j ≤ bs := fun j hj => (le_abs_self _).trans (by
      rw [hbs]; exact Finset.single_le_sum (f := fun j => |bf j|) (fun j _ => abs_nonneg _) (mem j hj))
    have hdj : ∀ j, j ≤ k → df j ≤ ds := fun j hj => (le_abs_self _).trans (by
      rw [hds]; exact Finset.single_le_sum (f := fun j => |df j|) (fun j _ => abs_nonneg _) (mem j hj))
    have hKj : ∀ j, j ≤ k → Kq j ≤ Ks := fun j hj => (le_abs_self _).trans (by
      rw [hKs]; exact Finset.single_le_sum (f := fun j => |Kq j|) (fun j _ => abs_nonneg _) (mem j hj))
    refine ⟨2 ^ k * Ks * Cs, bs, ds, mul_nonneg (mul_nonneg (by positivity) hKs0) hCs0,
      fun ξ hξ hX1 hX2 j hj => ?_⟩
    obtain ⟨hq, -, hS1, hE, hδ0, hδ1⟩ := hdom ξ hξ hX1 hX2
    have hqa : 0 ≤ qC B.h ξ ^ (B.h * α) := Real.rpow_nonneg hq.le _
    have hqA : 0 ≤ qC B.h ξ ^ (-e) := Real.rpow_nonneg hq.le _
    obtain ⟨wv, hwv⟩ : ∃ wv : ℝ, wv = SC B.h ξ ^ bs * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-ds) := ⟨_, rfl⟩
    have p3 : 0 ≤ SC B.h ξ ^ bs := Real.rpow_nonneg (by linarith) _
    have hwv0 : 0 ≤ wv := by
      rw [hwv]; exact mul_nonneg (mul_nonneg p3 hE) (Real.rpow_nonneg hδ0.le _)
    have hFb : ∀ m, m ≤ k → NB B.h (nrm B e g) m ξ ≤ Cs * (qC B.h ξ ^ (B.h * α) * wv) := by
      intro m hm
      have h1 := hCf m ξ hξ hX1 hX2
      have hbm : SC B.h ξ ^ (bf m) ≤ SC B.h ξ ^ bs := Real.rpow_le_rpow_of_exponent_le hS1 (hbj m hm)
      have hdm : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df m) ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-ds) :=
        Real.rpow_le_rpow_of_exponent_ge hδ0 hδ1 (neg_le_neg (hdj m hm))
      have p1 : 0 ≤ SC B.h ξ ^ (bf m) := Real.rpow_nonneg (by linarith) _
      have p2 : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df m) := Real.rpow_nonneg hδ0.le _
      calc NB B.h (nrm B e g) m ξ
          ≤ Cf m * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ (bf m) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
              edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df m) := h1
        _ = Cf m * (qC B.h ξ ^ (B.h * α) * (SC B.h ξ ^ (bf m) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
              edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df m))) := by ring
        _ ≤ Cs * (qC B.h ξ ^ (B.h * α) * (SC B.h ξ ^ (bf m) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
              edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df m))) :=
            mul_le_mul_of_nonneg_right (hCj m hm) (mul_nonneg hqa (mul_nonneg (mul_nonneg p1 hE) p2))
        _ ≤ Cs * (qC B.h ξ ^ (B.h * α) * wv) := by
            rw [hwv]
            refine mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left ?_ hqa) hCs0
            exact mul_le_mul (mul_le_mul_of_nonneg_right hbm hE) hdm p2 (mul_nonneg p3 hE)
    have hev : g =ᶠ[nhds ξ] (fun η => qC B.h η ^ (-e) * nrm B e g η) :=
      Filter.eventuallyEq_of_mem (hUo.mem_nhds hξ) (fun η hη => by
        simp only [nrm]
        rw [← mul_assoc, ← Real.rpow_add (hqpos η hη), neg_add_cancel, Real.rpow_zero, one_mul])
    have hNBe : NB B.h g j ξ = NB B.h (fun η => qC B.h η ^ (-e) * nrm B e g η) j ξ := by
      unfold NB; rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds]
    have hl := nb_mul_le_v4 B.h (DomC B.h (qsOf l0)) (fun η => qC B.h η ^ (-e))
      (nrm B e g) hUo hps hFs ξ hξ j
    have hchoose : ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) = 2 ^ j := by
      exact_mod_cast Nat.sum_range_choose j
    have h2 : (2:ℝ) ^ j ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hj
    obtain ⟨X, hX⟩ : ∃ X : ℝ, X = Ks * qC B.h ξ ^ (-e) * (Cs * (qC B.h ξ ^ (B.h * α) * wv)) :=
      ⟨_, rfl⟩
    have hX0 : 0 ≤ X := by
      rw [hX]; exact mul_nonneg (mul_nonneg hKs0 hqA) (mul_nonneg hCs0 (mul_nonneg hqa hwv0))
    have hexp : qC B.h ξ ^ (-e) * qC B.h ξ ^ (B.h * α) = qC B.h ξ ^ (-e + B.h * α) :=
      (Real.rpow_add hq _ _).symm
    rw [hNBe]
    calc NB B.h (fun η => qC B.h η ^ (-e) * nrm B e g η) j ξ
        ≤ ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * NB B.h (fun η => qC B.h η ^ (-e)) i ξ *
            NB B.h (nrm B e g) (j - i) ξ := hl
      _ ≤ ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * X := by
          apply Finset.sum_le_sum
          intro i hi
          have hij : i ≤ j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have b1 : NB B.h (fun η => qC B.h η ^ (-e)) i ξ ≤ Ks * qC B.h ξ ^ (-e) :=
            (hKq i ξ hξ).trans (mul_le_mul_of_nonneg_right (hKj i (by omega)) hqA)
          have b2 := hFb (j - i) (by omega)
          refine le_trans (mul_le_mul (mul_le_mul_of_nonneg_left b1 (Nat.cast_nonneg _)) b2 (norm_nonneg _)
            (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg hKs0 hqA))) (le_of_eq ?_)
          rw [hX]; ring
      _ = (∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ)) * X := by rw [Finset.sum_mul]
      _ = 2 ^ j * X := by rw [hchoose]
      _ ≤ 2 ^ k * X := mul_le_mul_of_nonneg_right h2 hX0
      _ = _ := by rw [hX, hwv, ← hexp]; ring

  have hf : ∀ a : Fin 3, ContDiffOn ℝ ∞ (fun ξ => Mn ξ a) (DomC B.h (qsOf l0)) := fun a =>
    (g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) 0.9 _ hok (hMn a)).1
  have hfR : ∀ a : Fin 3, ContDiffOn ℝ ∞ (dR B.h (fun ξ => Mn ξ a)) (DomC B.h (qsOf l0)) := fun a =>
    (hcalc _ (hf a)).1
  have hfZ : ∀ a : Fin 3, ContDiffOn ℝ ∞ (dZ (fun ξ => Mn ξ a)) (DomC B.h (qsOf l0)) := fun a =>
    (hcalc _ (hf a)).2.1
  have hR := fun a : Fin 3 => wmo_rc_dR_v5 B hok hSN l0 hl0 (fun ξ => Mn ξ a) (Aex B.h) 0.9 (hMn a)
  have hZ := fun a : Fin 3 => wmo_rc_dZ_v5 B hok hSN l0 hl0 (fun ξ => Mn ξ a) (Aex B.h) 0.9 (hMn a)
  choose CM bM dM hCM0 hCM using fun a : Fin 3 => unnorm _ _ _ (hMn a)
  choose CR bR dRr hCR0 hCR using fun a : Fin 3 => unnorm _ _ _ (hR a)
  choose CZ bZ dZz hCZ0 hCZ using fun a : Fin 3 => unnorm _ _ _ (hZ a)

  obtain ⟨b, hbdef⟩ : ∃ b : ℝ, b = ∑ a : Fin 3, (|bM a| + |bR a| + |bZ a|) := ⟨_, rfl⟩
  obtain ⟨d, hddef⟩ : ∃ d : ℝ, d = ∑ a : Fin 3, (|dM a| + |dRr a| + |dZz a|) := ⟨_, rfl⟩
  have hb3 : ∀ a : Fin 3, |bM a| + |bR a| + |bZ a| ≤ b := fun a => by
    rw [hbdef]
    exact Finset.single_le_sum (f := fun a => |bM a| + |bR a| + |bZ a|) (fun i _ => by positivity)
      (Finset.mem_univ a)
  have hd3 : ∀ a : Fin 3, |dM a| + |dRr a| + |dZz a| ≤ d := fun a => by
    rw [hddef]
    exact Finset.single_le_sum (f := fun a => |dM a| + |dRr a| + |dZz a|) (fun i _ => by positivity)
      (Finset.mem_univ a)
  have hbM : ∀ a, bM a ≤ b := fun a => by
    linarith [hb3 a, le_abs_self (bM a), abs_nonneg (bR a), abs_nonneg (bZ a)]
  have hbR : ∀ a, bR a ≤ b := fun a => by
    linarith [hb3 a, le_abs_self (bR a), abs_nonneg (bM a), abs_nonneg (bZ a)]
  have hbZ : ∀ a, bZ a ≤ b := fun a => by
    linarith [hb3 a, le_abs_self (bZ a), abs_nonneg (bM a), abs_nonneg (bR a)]
  have hdM : ∀ a, dM a ≤ d := fun a => by
    linarith [hd3 a, le_abs_self (dM a), abs_nonneg (dRr a), abs_nonneg (dZz a)]
  have hdR : ∀ a, dRr a ≤ d := fun a => by
    linarith [hd3 a, le_abs_self (dRr a), abs_nonneg (dM a), abs_nonneg (dZz a)]
  have hdZ : ∀ a, dZz a ≤ d := fun a => by
    linarith [hd3 a, le_abs_self (dZz a), abs_nonneg (dM a), abs_nonneg (dRr a)]
  have key : ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      ∀ (N C x bi di : ℝ), 0 ≤ C → bi ≤ b → di ≤ d →
      N ≤ C * qC B.h ξ ^ x *
        (SC B.h ξ ^ bi * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-di)) →
      N ≤ C * qC B.h ξ ^ x *
        (SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d)) := by
    intro ξ hξ hX1 hX2 N C x bi di hC hbi hdi H
    refine H.trans ?_
    obtain ⟨hq0, -, hS1, hEW, hED0, hED1⟩ := hdom ξ hξ hX1 hX2
    apply mul_le_mul_of_nonneg_left _ (mul_nonneg hC (Real.rpow_nonneg hq0.le _))
    have hb2 : SC B.h ξ ^ bi ≤ SC B.h ξ ^ b := Real.rpow_le_rpow_of_exponent_le hS1 hbi
    have hd2 : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-di) ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) :=
      Real.rpow_le_rpow_of_exponent_ge hED0 hED1 (neg_le_neg hdi)
    exact mul_le_mul (mul_le_mul_of_nonneg_right hb2 hEW) hd2 (Real.rpow_nonneg hED0.le _)
      (mul_nonneg (Real.rpow_nonneg (by linarith) _) hEW)

  have hofR : ∀ (f : Cyl → ℝ) (ξ : Cyl) (j : ℕ), ContDiffAt ℝ ∞ f ξ →
      NB B.h (fun η => ((f η : ℝ) : ℂ)) j ξ ≤ NB B.h f j ξ := by
    intro f ξ j hf
    have hc : (fun η => ((f η : ℝ) : ℂ)) = ⇑Complex.ofRealCLM ∘ f := by
      funext η; simp only [Function.comp_apply, Complex.ofRealCLM_apply]
    have hit : iteratedFDeriv ℝ j (fun η => ((f η : ℝ) : ℂ)) ξ =
        Complex.ofRealCLM.compContinuousMultilinearMap (iteratedFDeriv ℝ j f ξ) := by
      rw [hc]; exact ContinuousLinearMap.iteratedFDeriv_comp_left _ hf (by exact_mod_cast le_top)
    unfold NB
    rw [hit]
    have e : (Complex.ofRealCLM.compContinuousMultilinearMap (iteratedFDeriv ℝ j f ξ)).compContinuousLinearMap
        (fun _ => Lnorm B.h ξ) = Complex.ofRealCLM.compContinuousMultilinearMap
          ((iteratedFDeriv ℝ j f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext m; rfl
    rw [e]
    calc _ ≤ ‖Complex.ofRealCLM‖ * ‖(iteratedFDeriv ℝ j f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ = _ := by rw [Complex.ofRealCLM_norm, one_mul]
  have hcx : ∀ f : Cyl → ℝ, ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) (DomC B.h (qsOf l0)) := fun f hf =>
    (Complex.ofRealCLM.contDiff.comp_contDiffOn hf).congr (fun η _ => by simp)

  have hcomp : ∀ η ∈ DomC B.h (qsOf l0), ∀ i : Fin 3,
      dR B.h (pchMnC5 Mn) η i = ((dR B.h (fun ζ => Mn ζ i) η : ℝ) : ℂ) ∧
      dZ (pchMnC5 Mn) η i = ((dZ (fun ζ => Mn ζ i) η : ℝ) : ℂ) := by
    intro η hη i
    have hd : ∀ a : Fin 3, DifferentiableAt ℝ (fun ζ => ((Mn ζ a : ℝ) : ℂ)) η := fun a =>
      ((hcx _ (hf a)).contDiffAt (hUo.mem_nhds hη)).differentiableAt (by norm_num)
    have hfd : fderiv ℝ (pchMnC5 Mn) η =
        ContinuousLinearMap.pi (fun a => fderiv ℝ (fun ζ => ((Mn ζ a : ℝ) : ℂ)) η) :=
      fderiv_pi (φ := fun a ζ => ((Mn ζ a : ℝ) : ℂ)) hd
    have hfi : fderiv ℝ (fun ζ => ((Mn ζ i : ℝ) : ℂ)) η =
        Complex.ofRealCLM.comp (fderiv ℝ (fun ζ => Mn ζ i) η) := by
      have hdi : DifferentiableAt ℝ (fun ζ => Mn ζ i) η :=
        ((hf i).contDiffAt (hUo.mem_nhds hη)).differentiableAt (by norm_num)
      have e : (fun ζ => ((Mn ζ i : ℝ) : ℂ)) = ⇑Complex.ofRealCLM ∘ (fun ζ => Mn ζ i) := by
        funext ζ; simp only [Function.comp_apply, Complex.ofRealCLM_apply]
      rw [e]
      exact (Complex.ofRealCLM.hasFDerivAt.comp η hdi.hasFDerivAt).fderiv
    unfold dR dZ
    constructor <;> simp only [hfd, ContinuousLinearMap.pi_apply, hfi, ContinuousLinearMap.comp_apply,
      Complex.ofRealCLM_apply]
  have wnn : ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      0 ≤ SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) := by
    intro ξ hξ hX1 hX2
    obtain ⟨-, -, hS1, hEW, hED0, -⟩ := hdom ξ hξ hX1 hX2
    exact mul_nonneg (mul_nonneg (Real.rpow_nonneg (by linarith) _) hEW) (Real.rpow_nonneg hED0.le _)

  refine ⟨b, d, fun i => ⟨⟨CM i, hCM0 i, fun γ m ξ hP => ?_⟩, ⟨CR i, hCR0 i, fun γ m ξ hP => ?_⟩,
    ⟨CZ i, hCZ0 i, fun γ m ξ hP => ?_⟩⟩⟩
  · obtain ⟨hξ, hX1, hX2⟩ := hP
    refine ⟨wnn ξ hξ hX1 hX2, ⟨_, hUo, hξ, hcx _ (hf i)⟩, fun j hj => ?_⟩
    show NB B.h (fun η => ((Mn η i : ℝ) : ℂ)) j ξ ≤ CM i * qC B.h ξ ^ (-Aex B.h + B.h * 0.9) *
      (SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d))
    exact key ξ hξ hX1 hX2 _ _ _ _ _ (hCM0 i) (hbM i) (hdM i)
      ((hofR _ ξ j ((hf i).contDiffAt (hUo.mem_nhds hξ))).trans (hCM i ξ hξ hX1 hX2 j hj))
  · obtain ⟨hξ, hX1, hX2⟩ := hP
    have hrs : ContDiffOn ℝ ∞ (fun η => dR B.h (pchMnC5 Mn) η i) (DomC B.h (qsOf l0)) :=
      (hcx _ (hfR i)).congr (fun η hη => (hcomp η hη i).1)
    refine ⟨wnn ξ hξ hX1 hX2, ⟨_, hUo, hξ, hrs⟩, fun j hj => ?_⟩
    have hev : (fun η => dR B.h (pchMnC5 Mn) η i) =ᶠ[nhds ξ]
        (fun η => ((dR B.h (fun ζ => Mn ζ i) η : ℝ) : ℂ)) :=
      Filter.eventuallyEq_of_mem (hUo.mem_nhds hξ) (fun η hη => (hcomp η hη i).1)
    have hNBe : NB B.h (fun η => dR B.h (pchMnC5 Mn) η i) j ξ =
        NB B.h (fun η => ((dR B.h (fun ζ => Mn ζ i) η : ℝ) : ℂ)) j ξ := by
      unfold NB; rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds]
    have h1 := hCR i ξ hξ hX1 hX2 j hj
    have hex : -(Aex B.h + 1/2) + B.h * (0.9 - kapS) = -Aex B.h + B.h * 0.9 - 1/2 - B.h * kapS := by ring
    rw [hex] at h1
    show NB B.h (fun η => dR B.h (pchMnC5 Mn) η i) j ξ ≤
      CR i * qC B.h ξ ^ (-Aex B.h + B.h * 0.9 - 1/2 - B.h * kapS) *
      (SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d))
    rw [hNBe]
    exact key ξ hξ hX1 hX2 _ _ _ _ _ (hCR0 i) (hbR i) (hdR i)
      ((hofR _ ξ j ((hfR i).contDiffAt (hUo.mem_nhds hξ))).trans h1)
  · obtain ⟨hξ, hX1, hX2⟩ := hP
    obtain ⟨hq0, hq1, hS1, hEW, hED0, -⟩ := hdom ξ hξ hX1 hX2
    have hzs : ContDiffOn ℝ ∞ (fun η => dZ (pchMnC5 Mn) η i) (DomC B.h (qsOf l0)) :=
      (hcx _ (hfZ i)).congr (fun η hη => (hcomp η hη i).2)
    refine ⟨wnn ξ hξ hX1 hX2, ⟨_, hUo, hξ, hzs⟩, fun j hj => ?_⟩
    have hev : (fun η => dZ (pchMnC5 Mn) η i) =ᶠ[nhds ξ]
        (fun η => ((dZ (fun ζ => Mn ζ i) η : ℝ) : ℂ)) :=
      Filter.eventuallyEq_of_mem (hUo.mem_nhds hξ) (fun η hη => (hcomp η hη i).2)
    have hNBe : NB B.h (fun η => dZ (pchMnC5 Mn) η i) j ξ =
        NB B.h (fun η => ((dZ (fun ζ => Mn ζ i) η : ℝ) : ℂ)) j ξ := by
      unfold NB; rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds]
    have h1 := hCZ i ξ hξ hX1 hX2 j hj
    have hyz : qC B.h ξ ^ (-(Aex B.h + 1/2) + B.h * (0.9 + 1 - kapS)) ≤
        qC B.h ξ ^ (-Aex B.h + B.h * 0.9 - 1/2) := by
      apply Real.rpow_le_rpow_of_exponent_ge hq0 hq1
      have e1 : -(Aex B.h + 1/2) + B.h * (0.9 + 1 - kapS) - (-Aex B.h + B.h * 0.9 - 1/2) =
          B.h * (1 - kapS) := by ring
      have e2 : 0 ≤ B.h * (1 - kapS) := mul_nonneg hh0.le (by rw [hk]; norm_num)
      linarith
    have hw0 : 0 ≤ SC B.h ξ ^ (bZ i) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(dZz i)) :=
      mul_nonneg (mul_nonneg (Real.rpow_nonneg (by linarith) _) hEW) (Real.rpow_nonneg hED0.le _)
    have h2 : NB B.h (dZ (fun ζ => Mn ζ i)) j ξ ≤ CZ i * qC B.h ξ ^ (-Aex B.h + B.h * 0.9 - 1/2) *
        (SC B.h ξ ^ (bZ i) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
          edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(dZz i))) :=
      h1.trans (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hyz (hCZ0 i)) hw0)
    show NB B.h (fun η => dZ (pchMnC5 Mn) η i) j ξ ≤
      CZ i * qC B.h ξ ^ (-Aex B.h + B.h * 0.9 - 1/2) *
      (SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d))
    rw [hNBe]
    exact key ξ hξ hX1 hX2 _ _ _ _ _ (hCZ0 i) (hbZ i) (hdZ i)
      ((hofR _ ξ j ((hfZ i).contDiffAt (hUo.mem_nhds hξ))).trans h2)

theorem pch5_mw_smooth : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (Mn : Cyl → Fin 3 → ℝ) (Q : WC) (β : ℝ), (∀ a : Fin 3, ContDiffOn ℝ ∞ (fun ξ => Mn ξ a) (DomC B.h (qsOf l0))) → InWg5 B G (qsOf l0) β Q → ∀ (γ : Lab) (N : ℤ), ContDiffOn ℝ ∞ (fun η => ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) • (pchTr5 B G γ N (pchMnC5 Mn η) (pchAmp5 B Q γ N) η + pchTr5 B G γ 0 (pchAmp5 B Q γ N η) (pchMnC5 Mn) η)) (DomC B.h (qsOf l0)) :=
by
  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨ls, hs⟩ := pulse_support_good_v5 B G hok hG
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨ls + n0, ?_⟩
  intro l0 hl0 Mn Q β hMn hQ γ N
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 < B.qB := by
    rw [hQb]
    exact lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0
  obtain ⟨hDo, hqC, hqpos, -, -, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hsm : ∀ (U : Set Cyl) (f : Cyl → ℝ), ContDiffOn ℝ ∞ f U →
      ContDiffOn ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) U := by
    intro U f hf
    have hcomp : (fun η => ((f η : ℝ) : ℂ)) = ⇑(Complex.ofRealCLM : ℝ →L[ℝ] ℂ) ∘ f := by
      funext η; simp [Complex.ofRealCLM_apply]
    rw [hcomp]
    exact (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).contDiff.comp_contDiffOn hf

  have hdir : ContDiffOn ℝ ∞ (fun η : Cyl => ((1:ℝ), (0:ℝ), (0:ℝ),
      (drx B.h * η.1 ^ (drx B.h - 1)) • vrv)) (DomC B.h (qsOf l0)) := by
    refine contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk ?_))
    exact (contDiffOn_const.mul (contDiffOn_fst.rpow_const_of_ne (fun η hη => hη.1.ne'))).smul
      contDiffOn_const
  have hvec : ∀ f : Cyl → (Fin 3 → ℂ), ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ (fun η => dR B.h f η) (DomC B.h (qsOf l0)) ∧
      ContDiffOn ℝ ∞ (fun η => dZ f η) (DomC B.h (qsOf l0)) := by
    intro f hf
    have hfd : ContDiffOn ℝ ∞ (fderiv ℝ f) (DomC B.h (qsOf l0)) :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hDo).1 hf).2
    exact ⟨hfd.clm_apply hdir, hfd.clm_apply contDiffOn_const⟩

  have htr : ∀ (V : Set Cyl) (n : ℤ) (al bt : Cyl → Fin 3 → ℂ),
      V ⊆ DomC B.h (qsOf l0) →
      (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => ((nPhi5 B G γ η i : ℝ) : ℂ)) V) →
      (∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η => al η j) V) →
      (∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η => bt η j) V) →
      (∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η => dR B.h bt η j) V) →
      (∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η => dZ bt η j) V) →
      ContDiffOn ℝ ∞ (fun η => pchTr5 B G γ n (al η) bt η) V := by
    intro V n al bt hV hn ha hb hr hz
    have hg : ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η =>
        (((((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))) • nPhi5 B G γ η) j : ℝ) : ℂ)) V := by
      intro j
      refine ((contDiffOn_const (c := (((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) : ℝ) : ℂ))).mul
        (hn j)).congr (fun η _ => ?_)
      simp only [Pi.smul_apply, smul_eq_mul, Complex.ofReal_mul]
    have hρ : ContDiffOn ℝ ∞ (fun η : Cyl => ((η.1 : ℝ) : ℂ)) V :=
      hsm V (fun η : Cyl => η.1) contDiffOn_fst
    have hρ0 : ∀ η ∈ V, ((η.1 : ℝ) : ℂ) ≠ 0 := fun η hη =>
      Complex.ofReal_ne_zero.mpr (hV hη).1.ne'
    have hρi : ContDiffOn ℝ ∞ (fun η : Cyl => (((η.1 : ℝ) : ℂ))⁻¹) V := hρ.inv hρ0
    have hph := (contDiffOn_const (c := Complex.I * (n : ℂ))).mul
      ((((ha 0).mul (hg 0)).add ((ha 1).mul (hg 1))).add ((ha 2).mul (hg 2)))
    have h0 : ContDiffOn ℝ ∞ (fun η => pchTr5 B G γ n (al η) bt η 0) V := by
      refine (((((ha 0).mul (hr 0)).add ((ha 2).mul (hz 0))).add (hph.mul (hb 0))).sub
        (((ha 1).mul (hb 1)).mul hρi)).congr (fun η _ => ?_)
      simp only [pchTr5, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        Matrix.head_cons, Matrix.tail_cons, div_eq_mul_inv, Pi.inv_apply]
    have h1 : ContDiffOn ℝ ∞ (fun η => pchTr5 B G γ n (al η) bt η 1) V := by
      refine (((((ha 0).mul (hr 1)).add ((ha 2).mul (hz 1))).add (hph.mul (hb 1))).add
        (((ha 1).mul (hb 0)).mul hρi)).congr (fun η _ => ?_)
      simp only [pchTr5, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        Matrix.head_cons, Matrix.tail_cons, div_eq_mul_inv, Pi.inv_apply]
    have h2 : ContDiffOn ℝ ∞ (fun η => pchTr5 B G γ n (al η) bt η 2) V := by
      refine ((((ha 0).mul (hr 2)).add ((ha 2).mul (hz 2))).add (hph.mul (hb 2))).congr
        (fun η _ => ?_)
      simp only [pchTr5, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
    refine contDiffOn_pi.mpr (fun i => ?_)
    fin_cases i
    · exact h0
    · exact h1
    · exact h2

  have hoff : ∀ ξ : Cyl, ξ ∉ tsupport (Q γ N) →
      (fun η => ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) • (pchTr5 B G γ N (pchMnC5 Mn η)
        (pchAmp5 B Q γ N) η + pchTr5 B G γ 0 (pchAmp5 B Q γ N η) (pchMnC5 Mn) η)) =ᶠ[nhds ξ]
        (fun _ => (0 : Fin 3 → ℂ)) := by
    intro ξ hξ
    have ha : Q γ N =ᶠ[nhds ξ] 0 := (notMem_tsupport_iff_eventuallyEq).mp hξ
    have hA : pchAmp5 B Q γ N =ᶠ[nhds ξ] 0 := by
      filter_upwards [ha] with y hy
      simp [pchAmp5, hy]
    filter_upwards [hA.eventuallyEq_nhds] with y hy
    have hy0 : pchAmp5 B Q γ N y = 0 := hy.eq_of_nhds
    have hfd : fderiv ℝ (pchAmp5 B Q γ N) y = 0 := by
      rw [hy.fderiv_eq]
      exact fderiv_const_apply (0 : Fin 3 → ℂ)
    funext j
    fin_cases j <;> simp [pchTr5, dR, dZ, hfd, hy0]

  intro ξ hξ
  apply ContDiffAt.contDiffWithinAt
  by_cases hts : ξ ∈ tsupport (Q γ N)
  · obtain ⟨-, -, -, -, -, -, -, hxi, het⟩ := hs l0 (by omega) β Q hQ γ N ξ hξ hts
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hξB : ξ ∈ DomC B.h B.qB := ⟨hξ'.1, hξ'.2.1, lt_trans hξ'.2.2 hqsB⟩
    obtain ⟨U, hUo, hξU, -, hUs, -, -⟩ := good_coeff_smooth_v5 B G γ ξ hok hξB hxi het
    have hVo : IsOpen (DomC B.h (qsOf l0) ∩ U) := hDo.inter hUo
    have hVD : DomC B.h (qsOf l0) ∩ U ⊆ DomC B.h (qsOf l0) := Set.inter_subset_left
    have hn : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => ((nPhi5 B G γ η i : ℝ) : ℂ))
        (DomC B.h (qsOf l0) ∩ U) := fun i =>
      hsm _ (fun η => nPhi5 B G γ η i) ((hUs i).mono Set.inter_subset_right)
    have hMc : ContDiffOn ℝ ∞ (pchMnC5 Mn) (DomC B.h (qsOf l0)) :=
      contDiffOn_pi.mpr (fun j => hsm _ (fun η => Mn η j) (hMn j))
    have hW : ContDiffOn ℝ ∞ (pchAmp5 B Q γ N) (DomC B.h (qsOf l0)) :=
      (hsm _ (fun η => qC B.h η ^ (-Aex B.h))
        (hqC.rpow_const_of_ne (fun η hη => (hqpos η hη).ne'))).smul (hQ.2.1 γ N)
    obtain ⟨hrM, hzM⟩ := hvec _ hMc
    obtain ⟨hrW, hzW⟩ := hvec _ hW
    have hc : ContDiffOn ℝ ∞ (fun η => ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ))
        (DomC B.h (qsOf l0)) :=
      hsm _ (fun η => qC B.h η ^ (2 * Aex B.h + 1/2))
        (hqC.rpow_const_of_ne (fun η hη => (hqpos η hη).ne'))
    have pj : ∀ (f : Cyl → Fin 3 → ℂ), ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) →
        ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η => f η j) (DomC B.h (qsOf l0) ∩ U) :=
      fun f hf j => (contDiffOn_pi.mp hf j).mono hVD
    have hT1 := htr _ N (pchMnC5 Mn) (pchAmp5 B Q γ N) hVD hn (pj _ hMc) (pj _ hW)
      (pj _ hrW) (pj _ hzW)
