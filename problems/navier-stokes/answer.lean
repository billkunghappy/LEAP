    have hx2 : XC B.h ξ < 2 * B.Xb := by linarith
    have hls' : l1s ≤ γ.1 := by omega
    have hqh0 : 0 ≤ qC B.h ξ ^ B.h := Real.rpow_nonneg hq0.le _
    have hD1 : |Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))|
        ≤ max C2 0 * qC B.h ξ ^ B.h :=
      ((hNB0 (fun η : Cyl => Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1)
          ((0:ℝ), (1:ℝ), (0:ℝ)))).trans
        (hC2 γ.1 l1s le_rfl hls' ξ hmem hw1 hw2 hx1 hx2 _ (Or.inl rfl)).2).trans
        (mul_le_mul_of_nonneg_right (le_max_left _ _) hqh0)
    have hD2 : |Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))|
        ≤ max C2 0 * qC B.h ξ ^ B.h :=
      ((hNB0 (fun η : Cyl => Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (η.1, η.2.1, η.2.2.1)
          ((0:ℝ), (1:ℝ), (0:ℝ)))).trans
        (hC2 γ.1 l1s le_rfl hls' ξ hmem hw1 hw2 hx1 hx2 _ (Or.inr rfl)).2).trans
        (mul_le_mul_of_nonneg_right (le_max_left _ _) hqh0)
    have hpa : |pang5 B G γ| ≤ max Cr 0 := hpang.trans (le_max_left _ _)
    have hpz2 : |pzr5 B G γ| ≤ max Cr 0 := (hrep γ hact hl1r).2.1.trans (le_max_left _ _)
    have hPsiB : |pcPsi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) 2| ≤ K * qC B.h ξ ^ B.h := by
      rw [hPsi]
      refine (abs_add_le _ _).trans ?_
      rw [abs_mul (pang5 B G γ), abs_mul (pzr5 B G γ)]
      have hM0 : (0:ℝ) ≤ max Cr 0 := le_max_right _ _
      have e : K * qC B.h ξ ^ B.h = max Cr 0 * (max C2 0 * qC B.h ξ ^ B.h)
          + max Cr 0 * (max C2 0 * qC B.h ξ ^ B.h) := by rw [hK]; ring
      rw [e]
      exact add_le_add (mul_le_mul hpa hD1 (abs_nonneg _) hM0) (mul_le_mul hpz2 hD2 (abs_nonneg _) hM0)

    obtain ⟨hcib1, -⟩ := cib_band_bounds5 B.h γ.1 hl1
    have hl0 : (0:ℝ) < (γ.1:ℝ) := by exact_mod_cast hl1
    have hTl : 0 < Tgc * (γ.1:ℝ) ^ 2 := by positivity
    have hcibpos : 0 < cib B.h γ.1 := lt_trans (by positivity) hcib1
    have hP : 1 < cib B.h γ.1 * (Tgc * (γ.1:ℝ) ^ 2) := (div_lt_iff₀ hTl).mp hcib1
    have hvL : v ≤ Tgc * (γ.1:ℝ) ^ 2 / 50 := by
      refine hv.2.trans ?_
      show 2 * G.r0 / cib B.h γ.1 ≤ _
      rw [div_le_iff₀ hcibpos]
      nlinarith
    have hqh : qC B.h ξ ^ B.h ≤ 2 * Qb γ.1 ^ B.h := by
      calc qC B.h ξ ^ B.h ≤ (2 * Qb γ.1) ^ B.h := Real.rpow_le_rpow hq0.le hq2.le hh.le
        _ = (2:ℝ) ^ B.h * Qb γ.1 ^ B.h := Real.mul_rpow (by norm_num) hQb0.le
        _ ≤ 2 * Qb γ.1 ^ B.h := by
          apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hQb0.le _)
          calc (2:ℝ) ^ B.h ≤ (2:ℝ) ^ (1:ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
            _ = 2 := Real.rpow_one 2
    have hvPsi : |v * pcPsi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) 2| < cr / 2 := by
      rw [abs_mul, abs_of_nonneg hv.1]
      calc v * |pcPsi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) 2|
          ≤ (Tgc * (γ.1:ℝ) ^ 2 / 50) * (K * (2 * Qb γ.1 ^ B.h)) :=
            mul_le_mul hvL (hPsiB.trans (mul_le_mul_of_nonneg_left hqh hK0)) (abs_nonneg _) (by positivity)
        _ = Tgc * K / 25 * (γ.1:ℝ) ^ 2 * Qb γ.1 ^ B.h := by ring
        _ < cr / 2 := hl3 γ.1 hl3'
    have hN2 : pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 2 =
        pzr5 B G γ - v * pcPsi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) 2 := by
      show pcA5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) 2 - v * pcPsi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) 2 = _
      rw [hA2]
    have habs : cr / 2 ≤ |pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 2| := by
      rw [hN2]
      have := abs_sub_abs_le_abs_sub (pzr5 B G γ) (v * pcPsi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) 2)
      linarith
    have hsq2 : (cr / 2) ^ 2 ≤ pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 2 ^ 2 := by
      have := pow_le_pow_left₀ (by linarith) habs 2
      rwa [sq_abs] at this
    have hmin := min_le_left (cr ^ 2 / 4) (epsb B.h lst / (16 * B.Xb))
    nlinarith [sq_nonneg (pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 1)]
  ·
    have hne : pint5 B G γ ≠ 0 := by
      unfold pint5
      split_ifs with h0
      · exact one_ne_zero
      · exact h0
    have hpint : (1:ℝ) ≤ (pint5 B G γ : ℝ) ^ 2 := by
      have h1 : (1:ℝ) ≤ |(pint5 B G γ : ℝ)| := by
        rw [← Int.cast_abs]; exact_mod_cast Int.one_le_abs hne
      calc (1:ℝ) ≤ |(pint5 B G γ : ℝ)| ^ 2 := one_le_pow₀ h1
        _ = (pint5 B G γ : ℝ) ^ 2 := sq_abs _
    have heps0 : 0 < epsb B.h γ.1 := Real.rpow_pos_of_pos hQb0 _
    have hQb1 : Qb γ.1 ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos one_le_two (by simp)
    have heps1 : epsb B.h γ.1 ≤ 1 := Real.rpow_le_one hQb0.le hQb1 hh.le
    obtain ⟨a, ha⟩ : ∃ a : ℝ, a = epsb B.h γ.1 ^ (-(1/2:ℝ)) := ⟨_, rfl⟩
    have ha1 : 1 ≤ a := by
      rw [ha]; exact Real.one_le_rpow_of_pos_of_le_one_of_nonpos heps0 heps1 (by norm_num)
    have hka : ((kb B.h γ.1 : ℕ) : ℝ) < a + 1 := by
      show ((⌈epsb B.h γ.1 ^ (-(1/2:ℝ))⌉₊ : ℕ) : ℝ) < a + 1
      rw [← ha]; exact Nat.ceil_lt_add_one (by linarith)
    have hka' : a ≤ ((kb B.h γ.1 : ℕ) : ℝ) := by
      show a ≤ ((⌈epsb B.h γ.1 ^ (-(1/2:ℝ))⌉₊ : ℕ) : ℝ)
      rw [← ha]; exact Nat.le_ceil _
    have hea : epsb B.h γ.1 * a ^ 2 = 1 := by
      rw [ha, ← Real.rpow_natCast, ← Real.rpow_mul heps0.le]
      norm_num
      rw [Real.rpow_neg_one, mul_inv_cancel₀ heps0.ne']
    have hk2 : ((kb B.h γ.1 : ℕ) : ℝ) ^ 2 ≤ 4 * a ^ 2 := by nlinarith
    have hekb : epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2 ≤ 4 := by
      nlinarith [mul_le_mul_of_nonneg_left hk2 heps0.le]
    have hkpos : 0 < ((kb B.h γ.1 : ℕ) : ℝ) ^ 2 := by
      have : (0:ℝ) < ((kb B.h γ.1 : ℕ) : ℝ) := by linarith
      positivity
    have hpang : epsb B.h γ.1 / 4 ≤ pang5 B G γ ^ 2 := by
      unfold pang5
      rw [div_pow, le_div_iff₀ hkpos]
      nlinarith
    have hN1 : pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 1 = pang5 B G γ * Real.sqrt (Qb γ.1) / ξ.1 := by
      show pang5 B G γ / (ξ.1 / Real.sqrt (Qb γ.1)) - v * 0 = _
      rw [mul_zero, sub_zero, div_div_eq_mul_div]
    have hN1sq : pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 1 ^ 2 = pang5 B G γ ^ 2 * Qb γ.1 / ξ.1 ^ 2 := by
      rw [hN1, div_pow, mul_pow, Real.sq_sqrt hQb0.le]
    have hXCe : XC B.h ξ * (2 * qC B.h ξ) = ξ.1 ^ 2 := by
      unfold XC
      field_simp
    have hxi2 : ξ.1 ^ 2 < 4 * Qb γ.1 * B.Xb := by
      have h1 : XC B.h ξ * (2 * qC B.h ξ) < B.Xb * (2 * qC B.h ξ) :=
        mul_lt_mul_of_pos_right hX2 (by linarith)
      have h2 : B.Xb * (2 * qC B.h ξ) < B.Xb * (2 * (2 * Qb γ.1)) :=
        mul_lt_mul_of_pos_left (by linarith) hXb
      nlinarith
    have hxi0 : 0 < ξ.1 ^ 2 := by have := hdom'.1; positivity
    have hN1low : epsb B.h γ.1 / (16 * B.Xb) ≤ pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 1 ^ 2 := by
      rw [hN1sq, div_le_div_iff₀ (by positivity) hxi0]
      have e1 := mul_le_mul_of_nonneg_left hxi2.le heps0.le
      have e2 := mul_le_mul_of_nonneg_right hpang (by positivity : (0:ℝ) ≤ 16 * Qb γ.1 * B.Xb)
      nlinarith
    have hmono : epsb B.h lst ≤ epsb B.h γ.1 := by
      show Qb lst ^ B.h ≤ Qb γ.1 ^ B.h
      apply Real.rpow_le_rpow (hQbpos lst).le _ hh.le
      show (2:ℝ) ^ (-(lst:ℝ)) ≤ (2:ℝ) ^ (-(γ.1:ℝ))
      apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
      have : (γ.1:ℝ) ≤ (lst:ℝ) := by exact_mod_cast hsmall.le
      linarith
    have hmin := min_le_right (cr ^ 2 / 4) (epsb B.h lst / (16 * B.Xb))
    have hdiv : epsb B.h lst / (16 * B.Xb) ≤ epsb B.h γ.1 / (16 * B.Xb) :=
      div_le_div_of_nonneg_right hmono (by positivity)
    nlinarith [sq_nonneg (pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 2)]

theorem nb_pres_quot_v5 : ∀ (k : ℕ) (c D : ℝ), 0 < c → ∃ C' : ℝ, ∀ (h Sv : ℝ) (U : Set Cyl) (ξ : Cyl) (n p : Fin 3 → Cyl → ℝ) (K : Fin 3 → Fin 3 → Cyl → ℝ), IsOpen U → ξ ∈ U → 1 ≤ Sv → (∀ i, ContDiffOn ℝ ∞ (n i) U) → (∀ i, ContDiffOn ℝ ∞ (p i) U) → (∀ i j, ContDiffOn ℝ ∞ (K i j) U) → c ≤ n 0 ξ * n 0 ξ + n 1 ξ * n 1 ξ + n 2 ξ * n 2 ξ → (∀ j : ℕ, j ≤ k → (∀ i, NB h (n i) j ξ ≤ D * Sv) ∧ (∀ i, NB h (p i) j ξ ≤ D * Sv) ∧ ∀ i i', NB h (K i i') j ξ ≤ D * Sv) → ∀ j : Fin 3, NB h (fun η => (n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η)⁻¹ * (n 0 η * K 0 j η + n 1 η * K 1 j η + n 2 η * K 2 j η - p j η)) k ξ ≤ C' * Sv ^ (2 * k + 2) :=
by

  have mulle : ∀ (h : ℝ) (ξ : Cyl) (a b : Cyl → ℝ) (k : ℕ) (A E : ℝ), ContDiffAt ℝ ∞ a ξ →
      ContDiffAt ℝ ∞ b ξ → (∀ i : ℕ, i ≤ k → NB h a i ξ ≤ A) → (∀ i : ℕ, i ≤ k → NB h b i ξ ≤ E) →
      NB h (fun η => a η * b η) k ξ ≤ 2 ^ k * A * E := by
    intro h ξ a b k A E ha hb hA hE
    have hNBnn : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (i : ℕ),
        0 ≤ NB h f i ξ := fun f i => norm_nonneg _
    have leib : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (U : Set Cyl) (n : ℕ),
        IsOpen U → ξ ∈ U → ∀ (f : Cyl → ℝ) (g : Cyl → V), ContDiffOn ℝ n f U → ContDiffOn ℝ n g U →
        NB h (fun η => f η • g η) n ξ ≤
          ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * NB h f i ξ * NB h g (n - i) ξ := by
      intro V _ _ U n hU hξ f g hf hg
      unfold NB
      generalize Lnorm h ξ = L
      obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
      have hs : IsOpen s := by
        rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
      have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
      have h0s : (0 : Cyl) ∈ s := by
        rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
      have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
      have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
      have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + z)) s := by
        intro W _ _ F hF
        exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
          (fun z hz => by rw [hs_def] at hz; exact hz)
      have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
        intro W _ _ F hF
        exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
      have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ∀ i : ℕ, i ≤ n →
          iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
            (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
        intro W _ _ F hF i hi
        have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
        have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
          hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
        have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
        have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
        calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
            = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
          _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
                (fun _ => L) := e2
          _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
                (fun _ => L) := by rw [map_zero]
          _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
                (fun _ => L) := by rw [e3]
          _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
      have hfg : ContDiffOn ℝ n (fun η => f η • g η) U := hf.smul hg
      have hl := norm_iteratedFDerivWithin_smul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
        (n := n) le_rfl
      rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) • g (ξ + L y)) n hO h0O] at hl
      rw [← key _ hfg n le_rfl]
      calc ‖iteratedFDeriv ℝ n (fun z => (fun η => f η • g η) (ξ + L z)) 0‖
          = ‖iteratedFDeriv ℝ n (fun y => f (ξ + L y) • g (ξ + L y)) 0‖ := rfl
        _ ≤ _ := hl
        _ = _ := by
          apply Finset.sum_congr rfl
          intro i hi
          have hik : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
            iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (n - i) hO h0O,
            key f hf i hik, key g hg (n - i) (Nat.sub_le n i)]
    have hA0 : 0 ≤ A := le_trans (hNBnn a 0) (hA 0 (Nat.zero_le k))
    have hE0 : 0 ≤ E := le_trans (hNBnn b 0) (hE 0 (Nat.zero_le k))
    have ha' : ContDiffAt ℝ k a ξ := ha.of_le (by exact_mod_cast le_top)
    have hb' : ContDiffAt ℝ k b ξ := hb.of_le (by exact_mod_cast le_top)
    obtain ⟨ua, hua, hau⟩ := ha'.contDiffOn le_rfl (by simp)
    obtain ⟨ub, hub, hbu⟩ := hb'.contDiffOn le_rfl (by simp)
    obtain ⟨O, hOsub, hOopen, hξO⟩ := mem_nhds_iff.mp (Filter.inter_mem hua hub)
    have haO : ContDiffOn ℝ k a O := hau.mono (fun x hx => (hOsub hx).1)
    have hbO : ContDiffOn ℝ k b O := hbu.mono (fun x hx => (hOsub hx).2)
    have l1 := leib O k hOopen hξO a b haO hbO
    have l1' : NB h (fun η => a η * b η) k ξ ≤ ∑ i ∈ Finset.range (k + 1),
        (k.choose i : ℝ) * NB h a i ξ * NB h b (k - i) ξ := l1
    refine le_trans l1' ?_
    calc ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB h a i ξ * NB h b (k - i) ξ
        ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * A * E := by
          apply Finset.sum_le_sum
          intro i hi
          have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          exact mul_le_mul (mul_le_mul_of_nonneg_left (hA i hik) (Nat.cast_nonneg _))
            (hE _ (Nat.sub_le k i)) (hNBnn _ _) (mul_nonneg (Nat.cast_nonneg _) hA0)
      _ = A * E * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) := by
          rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro i _; ring
      _ = 2 ^ k * A * E := by
          have hs : ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) = 2 ^ k := by
            exact_mod_cast Nat.sum_range_choose k
          rw [hs]; ring

  have addle : ∀ (h : ℝ) (ξ : Cyl) (f g : Cyl → ℝ) (i : ℕ), ContDiffAt ℝ ∞ f ξ →
      ContDiffAt ℝ ∞ g ξ →
      NB h (fun η => f η + g η) i ξ ≤ NB h f i ξ + NB h g i ξ ∧
      NB h (fun η => f η - g η) i ξ ≤ NB h f i ξ + NB h g i ξ := by
    intro h ξ f g i hf hg
    have hf' : ContDiffAt ℝ i f ξ := hf.of_le (by exact_mod_cast le_top)
    have hg' : ContDiffAt ℝ i g ξ := hg.of_le (by exact_mod_cast le_top)
    constructor
    · unfold NB
      have e : iteratedFDeriv ℝ i (fun η => f η + g η) ξ =
          iteratedFDeriv ℝ i f ξ + iteratedFDeriv ℝ i g ξ := iteratedFDeriv_add_apply hf' hg'
      rw [e]
      have e2 : (iteratedFDeriv ℝ i f ξ + iteratedFDeriv ℝ i g ξ).compContinuousLinearMap
          (fun _ => Lnorm h ξ) =
          (iteratedFDeriv ℝ i f ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) +
          (iteratedFDeriv ℝ i g ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) := by
        ext m; simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      rw [e2]
      exact norm_add_le _ _
    · unfold NB
      have e : iteratedFDeriv ℝ i (fun η => f η - g η) ξ =
          iteratedFDeriv ℝ i f ξ - iteratedFDeriv ℝ i g ξ := iteratedFDeriv_sub_apply hf' hg'
      rw [e]
      have e2 : (iteratedFDeriv ℝ i f ξ - iteratedFDeriv ℝ i g ξ).compContinuousLinearMap
          (fun _ => Lnorm h ξ) =
          (iteratedFDeriv ℝ i f ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) -
          (iteratedFDeriv ℝ i g ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) := by
        ext m; simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      rw [e2]
      exact norm_sub_le _ _

  have dot3 : ∀ (h : ℝ) (ξ : Cyl) (a b : Fin 3 → Cyl → ℝ) (i : ℕ) (A E : ℝ),
      (∀ l, ContDiffAt ℝ ∞ (a l) ξ) → (∀ l, ContDiffAt ℝ ∞ (b l) ξ) →
      (∀ l, ∀ j : ℕ, j ≤ i → NB h (a l) j ξ ≤ A) → (∀ l, ∀ j : ℕ, j ≤ i → NB h (b l) j ξ ≤ E) →
      NB h (fun η => a 0 η * b 0 η + a 1 η * b 1 η + a 2 η * b 2 η) i ξ ≤ 3 * (2 ^ i * A * E) := by
    intro h ξ a b i A E ha hb hA hE
    have P : ∀ l, NB h (fun η => a l η * b l η) i ξ ≤ 2 ^ i * A * E := fun l =>
      mulle h ξ (a l) (b l) i A E (ha l) (hb l) (hA l) (hE l)
    have C : ∀ l, ContDiffAt ℝ ∞ (fun η => a l η * b l η) ξ := fun l => (ha l).mul (hb l)
    have s1 : NB h (fun η => a 0 η * b 0 η + a 1 η * b 1 η) i ξ ≤
        NB h (fun η => a 0 η * b 0 η) i ξ + NB h (fun η => a 1 η * b 1 η) i ξ :=
      (addle h ξ (fun η => a 0 η * b 0 η) (fun η => a 1 η * b 1 η) i (C 0) (C 1)).1
    have C01 : ContDiffAt ℝ ∞ (fun η => a 0 η * b 0 η + a 1 η * b 1 η) ξ := (C 0).add (C 1)
    have s2 : NB h (fun η => a 0 η * b 0 η + a 1 η * b 1 η + a 2 η * b 2 η) i ξ ≤
        NB h (fun η => a 0 η * b 0 η + a 1 η * b 1 η) i ξ + NB h (fun η => a 2 η * b 2 η) i ξ :=
      (addle h ξ (fun η => a 0 η * b 0 η + a 1 η * b 1 η) (fun η => a 2 η * b 2 η) i C01 (C 2)).1
    linarith [P 0, P 1, P 2]

  have invle : ∀ (h c Dd : ℝ) (U : Set Cyl) (f : Cyl → ℝ) (ξ : Cyl) (k : ℕ), IsOpen U → ξ ∈ U →
      ContDiffOn ℝ ∞ f U → (∀ η ∈ U, 0 < f η) → 0 < c → c ≤ f ξ → 1 ≤ Dd →
      (∀ i : ℕ, 1 ≤ i → i ≤ k → NB h f i ξ ≤ Dd ^ i) → ∀ i : ℕ, i ≤ k →
      NB h (fun η => (f η)⁻¹) i ξ ≤
        (k.factorial : ℝ) * ((k.factorial : ℝ) * (max 1 (1 / c)) ^ (k + 1)) * Dd ^ k := by
    intro h c Dd U f ξ k hU hξU hfU hpos hc hcy hDd1 hNBf i hik
    have key : ∀ (F : Cyl → ℝ) (V : Set Cyl) (a : Cyl) (T : Cyl →L[ℝ] Cyl), IsOpen V →
        ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
        iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
          (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
      intro F V a T hV hF ha i
      obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => a + z) ⁻¹' V := ⟨_, rfl⟩
      have hs : IsOpen s := by
        rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
      have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
      have h0s : (0 : Cyl) ∈ s := by
        rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
      have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
      have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
      have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
        hF.comp (contDiff_const.add contDiff_id).contDiffOn
          (fun z hz => by rw [hs_def] at hz; exact hz)
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
        hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
      calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
              (fun _ => T) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
              (fun _ => T) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
              (fun _ => T) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]
    have hinvs : ContDiffOn ℝ ∞ (fun x : ℝ => x⁻¹) (Set.Ioi 0) :=
      (contDiffOn_inv ℝ).mono (fun x hx => Set.mem_compl_singleton_iff.mpr (ne_of_gt hx))
    have hinvb : ∀ (j : ℕ) (y : ℝ), c ≤ y →
        ‖iteratedFDeriv ℝ j (fun x : ℝ => x⁻¹) y‖ ≤ (j.factorial : ℝ) * (1 / c) ^ (j + 1) := by
      intro j y hy
      have hy0 : 0 < y := lt_of_lt_of_le hc hy
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate]
      have e : (fun x : ℝ => x⁻¹) = Inv.inv := rfl
      rw [e, iter_deriv_inv]
      have e2 : (-1 - (j:ℤ)) = -((j + 1 : ℕ) : ℤ) := by push_cast; ring
      rw [e2, zpow_neg, zpow_natCast, norm_mul, norm_mul, norm_pow, norm_neg, norm_one, one_pow,
        one_mul, norm_inv, norm_pow, Real.norm_of_nonneg hy0.le, Real.norm_natCast]
      apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
      rw [one_div_pow, one_div]
      exact inv_anti₀ (pow_pos hc _) (pow_le_pow_left₀ hc.le hy _)
    obtain ⟨Cg, hCg⟩ : ∃ Cg : ℝ, Cg = (k.factorial : ℝ) * (max 1 (1 / c)) ^ (k + 1) := ⟨_, rfl⟩
    have hmax0 : (0:ℝ) ≤ max 1 (1 / c) := le_trans zero_le_one (le_max_left _ _)
    have hCg0 : 0 ≤ Cg := by rw [hCg]; exact mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hmax0 _)
    have hCgb : ∀ j : ℕ, j ≤ k → ‖iteratedFDeriv ℝ j (fun x : ℝ => x⁻¹) (f ξ)‖ ≤ Cg := by
      intro j hj
      refine le_trans (hinvb j (f ξ) hcy) ?_
      rw [hCg]
      have m1 : (1:ℝ) ≤ max 1 (1 / c) := le_max_left _ _
      have b1 : (1 / c) ^ (j + 1) ≤ (max 1 (1 / c)) ^ (j + 1) :=
        pow_le_pow_left₀ (by positivity) (le_max_right _ _) _
      have b2 : (max 1 (1 / c)) ^ (j + 1) ≤ (max 1 (1 / c)) ^ (k + 1) :=
        pow_le_pow_right₀ m1 (by omega)
      have b3 : (j.factorial : ℝ) ≤ k.factorial := by exact_mod_cast Nat.factorial_le hj
      exact mul_le_mul b3 (b1.trans b2) (by positivity) (by positivity)
    obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = (fun z => ξ + Lnorm h ξ z) ⁻¹' U := ⟨_, rfl⟩
    have hO : IsOpen O := by
      rw [hOdef]; exact hU.preimage (continuous_const.add (Lnorm h ξ).continuous)
    have h0O : (0 : Cyl) ∈ O := by
      rw [hOdef]; show ξ + Lnorm h ξ 0 ∈ U; rw [map_zero, add_zero]; exact hξU
    obtain ⟨Φ, hΦdef⟩ : ∃ Φ : Cyl → ℝ, Φ = fun z => f (ξ + Lnorm h ξ z) := ⟨_, rfl⟩
    have hΦ : ContDiffOn ℝ ∞ Φ O := by
      rw [hΦdef]
      exact hfU.comp (contDiff_const.add (Lnorm h ξ).contDiff).contDiffOn
        (fun z hz => by rw [hOdef] at hz; exact hz)
    have hΦmaps : Set.MapsTo Φ O (Set.Ioi 0) := by
      intro z hz; rw [hΦdef]; rw [hOdef] at hz; exact hpos _ hz
    have hΦ0 : Φ 0 = f ξ := by
      rw [hΦdef]; show f (ξ + Lnorm h ξ 0) = f ξ; rw [map_zero, add_zero]
    have hCw : ∀ j ≤ i, ‖iteratedFDerivWithin ℝ j (fun x : ℝ => x⁻¹) (Set.Ioi 0) (Φ 0)‖ ≤ Cg := by
      intro j hj
      rw [hΦ0, iteratedFDerivWithin_of_isOpen j isOpen_Ioi
        (show f ξ ∈ Set.Ioi (0:ℝ) from hpos ξ hξU)]
      exact hCgb j (le_trans hj hik)
    have hDw : ∀ j, 1 ≤ j → j ≤ i → ‖iteratedFDerivWithin ℝ j Φ O 0‖ ≤ Dd ^ j := by
      intro j hj1 hji
      rw [iteratedFDerivWithin_of_isOpen j hO h0O, hΦdef, key f U ξ (Lnorm h ξ) hU hfU hξU j]
      exact hNBf j hj1 (le_trans hji hik)
    have hFdB := norm_iteratedFDerivWithin_comp_le hinvs hΦ (by exact_mod_cast le_top)
      isOpen_Ioi.uniqueDiffOn hO.uniqueDiffOn hΦmaps h0O (C := Cg) (D := Dd) hCw hDw
    have hG : ContDiffOn ℝ ∞ (fun η => (f η)⁻¹) U := hinvs.comp hfU (fun η hη => hpos η hη)
    have hNBeq : NB h (fun η => (f η)⁻¹) i ξ =
        ‖iteratedFDeriv ℝ i (fun z => (f (ξ + Lnorm h ξ z))⁻¹) 0‖ := by
      have := key (fun η => (f η)⁻¹) U ξ (Lnorm h ξ) hU hG hξU i
      unfold NB
      rw [this]
    have hEq : (fun z => (f (ξ + Lnorm h ξ z))⁻¹) = (fun x : ℝ => x⁻¹) ∘ Φ := by
      rw [hΦdef]; rfl
    have hfac : (i.factorial : ℝ) ≤ k.factorial := by exact_mod_cast Nat.factorial_le hik
    have hpow : Dd ^ i ≤ Dd ^ k := pow_le_pow_right₀ hDd1 hik
    have hDd0 : 0 ≤ Dd := by linarith
    calc NB h (fun η => (f η)⁻¹) i ξ
        = ‖iteratedFDeriv ℝ i ((fun x : ℝ => x⁻¹) ∘ Φ) 0‖ := by rw [hNBeq, hEq]
      _ = ‖iteratedFDerivWithin ℝ i ((fun x : ℝ => x⁻¹) ∘ Φ) O 0‖ := by
          rw [iteratedFDerivWithin_of_isOpen i hO h0O]
      _ ≤ (i.factorial : ℝ) * Cg * Dd ^ i := hFdB
      _ ≤ (k.factorial : ℝ) * Cg * Dd ^ k :=
          mul_le_mul (mul_le_mul_of_nonneg_right hfac hCg0) hpow (pow_nonneg hDd0 _)
            (mul_nonneg (Nat.cast_nonneg _) hCg0)
      _ = _ := by rw [hCg]

  intro k c D hc
  refine ⟨2 ^ k * ((k.factorial : ℝ) * ((k.factorial : ℝ) * (max 1 (1 / c)) ^ (k + 1)) *
    (max 1 (3 * 2 ^ k * (D * D))) ^ k) * (3 * 2 ^ k * (D * D) + |D|), ?_⟩
  intro h Sv U ξ n p K hU hξ hSv hn hp hK hc0 hbd j
  have hM1 : (1:ℝ) ≤ max 1 (3 * 2 ^ k * (D * D)) := le_max_left _ _
  have hMD : 3 * 2 ^ k * (D * D) ≤ max 1 (3 * 2 ^ k * (D * D)) := le_max_right _ _
  have hSv0 : 0 ≤ Sv := by linarith
  have hSS : 1 ≤ Sv * Sv := by nlinarith
  have hSS' : Sv ≤ Sv * Sv := by nlinarith
  have hnU := hU.mem_nhds hξ
  have cn : ∀ i, ContDiffAt ℝ ∞ (n i) ξ := fun i => (hn i).contDiffAt hnU
  have cp : ∀ i, ContDiffAt ℝ ∞ (p i) ξ := fun i => (hp i).contDiffAt hnU
  have cK : ∀ i i', ContDiffAt ℝ ∞ (K i i') ξ := fun i i' => (hK i i').contDiffAt hnU
  have hEE : ∀ i : ℕ, i ≤ k →
      3 * (2 ^ i * (D * Sv) * (D * Sv)) ≤ 3 * 2 ^ k * (D * D) * (Sv * Sv) := by
    intro i hi
    have h2 : (2:ℝ) ^ i ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hi
    calc 3 * (2 ^ i * (D * Sv) * (D * Sv)) = 3 * 2 ^ i * ((D * Sv) * (D * Sv)) := by ring
      _ ≤ 3 * 2 ^ k * ((D * Sv) * (D * Sv)) :=
          mul_le_mul_of_nonneg_right (by linarith) (mul_self_nonneg _)
      _ = 3 * 2 ^ k * (D * D) * (Sv * Sv) := by ring
  have bN : ∀ i : ℕ, i ≤ k →
      NB h (fun η => n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η) i ξ ≤
        3 * 2 ^ k * (D * D) * (Sv * Sv) := by
    intro i hi
    exact le_trans (dot3 h ξ n n i (D * Sv) (D * Sv) cn cn
      (fun l j' hj' => (hbd j' (by omega)).1 l) (fun l j' hj' => (hbd j' (by omega)).1 l)) (hEE i hi)
  have bA : ∀ i : ℕ, i ≤ k →
      NB h (fun η => n 0 η * K 0 j η + n 1 η * K 1 j η + n 2 η * K 2 j η - p j η) i ξ ≤
        (3 * 2 ^ k * (D * D) + |D|) * (Sv * Sv) := by
    intro i hi
    have hd : NB h (fun η => n 0 η * K 0 j η + n 1 η * K 1 j η + n 2 η * K 2 j η) i ξ ≤
        3 * (2 ^ i * (D * Sv) * (D * Sv)) :=
      dot3 h ξ n (fun l => K l j) i (D * Sv) (D * Sv) cn (fun l => cK l j)
        (fun l j' hj' => (hbd j' (by omega)).1 l) (fun l j' hj' => (hbd j' (by omega)).2.2 l j)
    have cdot : ContDiffAt ℝ ∞ (fun η => n 0 η * K 0 j η + n 1 η * K 1 j η + n 2 η * K 2 j η) ξ :=
      (((cn 0).mul (cK 0 j)).add ((cn 1).mul (cK 1 j))).add ((cn 2).mul (cK 2 j))
    have hs : NB h (fun η => n 0 η * K 0 j η + n 1 η * K 1 j η + n 2 η * K 2 j η - p j η) i ξ ≤
        NB h (fun η => n 0 η * K 0 j η + n 1 η * K 1 j η + n 2 η * K 2 j η) i ξ + NB h (p j) i ξ :=
      (addle h ξ (fun η => n 0 η * K 0 j η + n 1 η * K 1 j η + n 2 η * K 2 j η) (p j) i cdot
        (cp j)).2
    have hpj := (hbd i hi).2.1 j
    have hDabs : D * Sv ≤ |D| * (Sv * Sv) :=
      le_trans (mul_le_mul_of_nonneg_right (le_abs_self D) hSv0)
        (mul_le_mul_of_nonneg_left hSS' (abs_nonneg D))
    have := hEE i hi
    nlinarith

  have hNon : ContDiffOn ℝ ∞ (fun η => n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η) U :=
    (((hn 0).mul (hn 0)).add ((hn 1).mul (hn 1))).add ((hn 2).mul (hn 2))
  have hNξ : 0 < n 0 ξ * n 0 ξ + n 1 ξ * n 1 ξ + n 2 ξ * n 2 ξ := lt_of_lt_of_le hc hc0
  have hVo : IsOpen (U ∩ (fun η => n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η) ⁻¹' Set.Ioi 0) :=
    hNon.continuousOn.isOpen_inter_preimage hU isOpen_Ioi
  have hξV : ξ ∈ U ∩ (fun η => n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η) ⁻¹' Set.Ioi 0 :=
    ⟨hξ, hNξ⟩
  have hDd1 : 1 ≤ max 1 (3 * 2 ^ k * (D * D)) * (Sv * Sv) := by nlinarith
  have hNBN : ∀ i : ℕ, 1 ≤ i → i ≤ k →
      NB h (fun η => n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η) i ξ ≤
        (max 1 (3 * 2 ^ k * (D * D)) * (Sv * Sv)) ^ i := by
    intro i hi1 hik
    refine le_trans (bN i hik) (le_trans ?_ (le_self_pow₀ hDd1 (by omega)))
    exact mul_le_mul_of_nonneg_right hMD (by linarith)
  have hinv := invle h c (max 1 (3 * 2 ^ k * (D * D)) * (Sv * Sv))
    (U ∩ (fun η => n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η) ⁻¹' Set.Ioi 0)
    (fun η => n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η) ξ k hVo hξV
    (hNon.mono Set.inter_subset_left) (fun η hη => hη.2) hc hc0 hDd1 hNBN
  have cN : ContDiffAt ℝ ∞ (fun η => n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η) ξ :=
    (((cn 0).mul (cn 0)).add ((cn 1).mul (cn 1))).add ((cn 2).mul (cn 2))
  have cNinv : ContDiffAt ℝ ∞ (fun η => (n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η)⁻¹) ξ :=
    cN.inv hNξ.ne'
  have cA : ContDiffAt ℝ ∞
      (fun η => n 0 η * K 0 j η + n 1 η * K 1 j η + n 2 η * K 2 j η - p j η) ξ :=
    ((((cn 0).mul (cK 0 j)).add ((cn 1).mul (cK 1 j))).add ((cn 2).mul (cK 2 j))).sub (cp j)
  have hfinal := mulle h ξ (fun η => (n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η)⁻¹)
    (fun η => n 0 η * K 0 j η + n 1 η * K 1 j η + n 2 η * K 2 j η - p j η) k
    ((k.factorial : ℝ) * ((k.factorial : ℝ) * (max 1 (1 / c)) ^ (k + 1)) *
      (max 1 (3 * 2 ^ k * (D * D)) * (Sv * Sv)) ^ k)
    ((3 * 2 ^ k * (D * D) + |D|) * (Sv * Sv)) cNinv cA hinv bA
  refine le_trans hfinal (le_of_eq ?_)
  ring

theorem nb_aphi_entry_poly_v5 : ∀ (k : ℕ) (c D : ℝ), 0 < c → ∃ C' : ℝ, 0 ≤ C' ∧ ∀ (h Sv e : ℝ) (U : Set Cyl) (ξ : Cyl) (n Ps : Fin 3 → Cyl → ℝ) (K : Fin 3 → Fin 3 → Cyl → ℝ), IsOpen U → ξ ∈ U → 1 ≤ Sv → |e| ≤ 4 → (∀ i, ContDiffOn ℝ ∞ (n i) U) → (∀ i, ContDiffOn ℝ ∞ (Ps i) U) → (∀ i j, ContDiffOn ℝ ∞ (K i j) U) → c ≤ n 0 ξ * n 0 ξ + n 1 ξ * n 1 ξ + n 2 ξ * n 2 ξ → (∀ j : ℕ, j ≤ k → (∀ i, NB h (n i) j ξ ≤ D * Sv) ∧ (∀ i, NB h (Ps i) j ξ ≤ D * Sv) ∧ ∀ i i', NB h (K i i') j ξ ≤ D * Sv) → ∀ a b : Fin 3, NB h (fun η => -K a b η + (n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η)⁻¹ * (n a η * (n 0 η * K 0 b η + n 1 η * K 1 b η + n 2 η * K 2 b η + Ps b η)) - e * (n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η) * (if a = b then (1:ℝ) else 0)) k ξ ≤ C' * Sv ^ (2 * k + 3) :=
by
  intro k c D hc
  choose Cq hCq using fun j : ℕ => nb_pres_quot_v5 j c D hc
  obtain ⟨Cs, hCs⟩ : ∃ Cs : ℝ, Cs = ∑ j ∈ Finset.range (k + 1), |Cq j| := ⟨_, rfl⟩
  have hCs0 : 0 ≤ Cs := by rw [hCs]; exact Finset.sum_nonneg (fun _ _ => abs_nonneg _)
  have h2k : (0:ℝ) ≤ 2 ^ k := by positivity
  refine ⟨|D| + 2 ^ k * |D| * Cs + 12 * 2 ^ k * D ^ 2,
    add_nonneg (add_nonneg (abs_nonneg _) (mul_nonneg (mul_nonneg h2k (abs_nonneg _)) hCs0))
      (by positivity), ?_⟩
  intro h Sv e U ξ n Ps K hU hξ hSv he hn hPs hK hc0 hB a b
  have hNB0 : ∀ (f : Cyl → ℝ) (j : ℕ), 0 ≤ NB h f j ξ := fun f j => by
    unfold NB; exact norm_nonneg _
  have hSv0 : 0 ≤ Sv := by linarith
  have hD : 0 ≤ D := by
    have h1 := (hB 0 (Nat.zero_le _)).1 0
    have h2 := hNB0 (n 0) 0
    by_contra hneg
    push_neg at hneg
    nlinarith
  have hAD : |D| = D := abs_of_nonneg hD
  have hDS : 0 ≤ D * Sv := mul_nonneg hD hSv0
  obtain ⟨g, hg_def⟩ : ∃ g : Cyl → ℝ,
      g = fun η => n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η := ⟨_, rfl⟩
  have hg : ContDiffOn ℝ ∞ g U := by
    rw [hg_def]
    exact (((hn 0).mul (hn 0)).add ((hn 1).mul (hn 1))).add ((hn 2).mul (hn 2))
  obtain ⟨U', hU'_def⟩ : ∃ U' : Set Cyl, U' = U ∩ g ⁻¹' {0}ᶜ := ⟨_, rfl⟩
  have hU' : IsOpen U' := by
    rw [hU'_def]; exact hg.continuousOn.isOpen_inter_preimage hU isOpen_compl_singleton
  have hgξ : g ξ ≠ 0 := by
    rw [hg_def]; exact ne_of_gt (lt_of_lt_of_le hc hc0)
  have hξ' : ξ ∈ U' := by rw [hU'_def]; exact ⟨hξ, hgξ⟩
  have hsub : U' ⊆ U := by rw [hU'_def]; exact Set.inter_subset_left
  have hgne : ∀ η ∈ U', g η ≠ 0 := by
    intro η hη
    rw [hU'_def] at hη
    exact hη.2
  have hn' : ∀ i, ContDiffOn ℝ ∞ (n i) U' := fun i => (hn i).mono hsub
  have hK' : ∀ i j, ContDiffOn ℝ ∞ (K i j) U' := fun i j => (hK i j).mono hsub
  have hPs' : ∀ i, ContDiffOn ℝ ∞ (Ps i) U' := fun i => (hPs i).mono hsub
  have hg' : ContDiffOn ℝ ∞ g U' := hg.mono hsub
  have hginv : ContDiffOn ℝ ∞ (fun η => (g η)⁻¹) U' := hg'.inv hgne
  obtain ⟨W, hW_def⟩ : ∃ W : Cyl → ℝ,
      W = fun η => n 0 η * K 0 b η + n 1 η * K 1 b η + n 2 η * K 2 b η + Ps b η := ⟨_, rfl⟩
  have hW' : ContDiffOn ℝ ∞ W U' := by
    rw [hW_def]
    exact ((((hn' 0).mul (hK' 0 b)).add ((hn' 1).mul (hK' 1 b))).add
      ((hn' 2).mul (hK' 2 b))).add (hPs' b)
  obtain ⟨Q, hQ_def⟩ : ∃ Q : Cyl → ℝ, Q = fun η => (g η)⁻¹ * W η := ⟨_, rfl⟩
  have hQ' : ContDiffOn ℝ ∞ Q U' := by rw [hQ_def]; exact hginv.mul hW'
  have hat : ∀ f : Cyl → ℝ, ContDiffOn ℝ ∞ f U' → ContDiffAt ℝ ∞ f ξ :=
    fun f hf => hf.contDiffAt (hU'.mem_nhds hξ')

  have hnegPs : ∀ i j, NB h (fun η => -Ps i η) j ξ ≤ NB h (Ps i) j ξ := by
    intro i j
    have e1 : (fun η => -Ps i η) = (fun η => (-1) * Ps i η + 0 * Ps i η) := by
      funext η; ring
    rw [e1]
    have := (nb_real_algebra_v5 h U ξ hU hξ (Ps i) (Ps i) (hPs i) (hPs i) j).2.1 (-1) 0
    have hm1 : |(-1:ℝ)| = 1 := by norm_num
    rw [hm1, abs_zero] at this
    linarith

  have hQb : ∀ j, j ≤ k → NB h Q j ξ ≤ Cs * Sv ^ (2 * k + 2) := by
    intro j hj
    have hq := hCq j h Sv U ξ n (fun i η => -Ps i η) K hU hξ hSv hn (fun i => (hPs i).neg) hK hc0
      (fun j' hj' => ⟨(hB j' (by omega)).1,
        fun i => (hnegPs i j').trans ((hB j' (by omega)).2.1 i), (hB j' (by omega)).2.2⟩) b
    have hq' : NB h Q j ξ ≤ Cq j * Sv ^ (2 * j + 2) := by
      convert hq using 2
      funext η
      simp only [hQ_def, hW_def, hg_def]
      ring
    have hSvp : 0 ≤ Sv ^ (2 * j + 2) := by positivity
    have hpow : Sv ^ (2 * j + 2) ≤ Sv ^ (2 * k + 2) := pow_le_pow_right₀ hSv (by omega)
    have hmem : |Cq j| ≤ Cs := by
      rw [hCs]
      exact Finset.single_le_sum (f := fun j => |Cq j|) (fun i _ => abs_nonneg (Cq i))
        (Finset.mem_range.2 (by omega : j < k + 1))
    calc NB h Q j ξ ≤ Cq j * Sv ^ (2 * j + 2) := hq'
      _ ≤ |Cq j| * Sv ^ (2 * j + 2) := mul_le_mul_of_nonneg_right (le_abs_self _) hSvp
      _ ≤ |Cq j| * Sv ^ (2 * k + 2) := mul_le_mul_of_nonneg_left hpow (abs_nonneg _)
      _ ≤ Cs * Sv ^ (2 * k + 2) := mul_le_mul_of_nonneg_right hmem (by positivity)

  have hprod : NB h (fun η => n a η * Q η) k ξ ≤ 2 ^ k * (D * Sv) * (Cs * Sv ^ (2 * k + 2)) :=
    nb_real_mul_le_v5 h ξ (n a) Q k (D * Sv) (Cs * Sv ^ (2 * k + 2)) (hat _ (hn' a)) (hat _ hQ')
      (fun i hi => (hB i hi).1 a) hQb

  have hsq : ∀ m, NB h (fun η => n m η * n m η) k ξ ≤ 2 ^ k * (D * Sv) * (D * Sv) := fun m =>
    nb_real_mul_le_v5 h ξ (n m) (n m) k (D * Sv) (D * Sv) (hat _ (hn' m)) (hat _ (hn' m))
      (fun i hi => (hB i hi).1 m) (fun i hi => (hB i hi).1 m)
  have hsqs : ∀ m, ContDiffOn ℝ ∞ (fun η => n m η * n m η) U' := fun m => (hn' m).mul (hn' m)
  have hg01 : NB h (fun η => n 0 η * n 0 η + n 1 η * n 1 η) k ξ ≤
      2 ^ k * (D * Sv) * (D * Sv) + 2 ^ k * (D * Sv) * (D * Sv) := by
    have := (nb_real_algebra_v5 h U' ξ hU' hξ' _ _ (hsqs 0) (hsqs 1) k).2.1 1 1
    simp only [abs_one, one_mul] at this
    linarith [hsq 0, hsq 1]
  have hgb : NB h g k ξ ≤ 3 * (2 ^ k * (D * Sv) * (D * Sv)) := by
    have := (nb_real_algebra_v5 h U' ξ hU' hξ' _ _ ((hsqs 0).add (hsqs 1)) (hsqs 2) k).2.1 1 1
    simp only [abs_one, one_mul] at this
    rw [hg_def]
    linarith [hsq 2]

  have hδ : |(if a = b then (1:ℝ) else 0)| ≤ 1 := by split_ifs <;> simp
  have hP0 : 0 ≤ 2 ^ k * (D * Sv) * (D * Sv) := mul_nonneg (mul_nonneg h2k hDS) hDS
  have hdamp : NB h (fun η => e * g η * (if a = b then (1:ℝ) else 0)) k ξ ≤
      4 * (3 * (2 ^ k * (D * Sv) * (D * Sv))) := by
    have e1 : (fun η => e * g η * (if a = b then (1:ℝ) else 0)) =
        fun η => (e * (if a = b then (1:ℝ) else 0)) * g η + 0 * g η := by
      funext η; ring
    rw [e1]
    have := (nb_real_algebra_v5 h U' ξ hU' hξ' g g hg' hg' k).2.1
      (e * (if a = b then (1:ℝ) else 0)) 0
    rw [abs_zero, abs_mul] at this
    have hng := hNB0 g k
    have h4 : |e| * |(if a = b then (1:ℝ) else 0)| ≤ 4 := by
      calc _ ≤ 4 * 1 := mul_le_mul he hδ (abs_nonneg _) (by norm_num)
        _ = 4 := by norm_num
    calc _ ≤ |e| * |(if a = b then (1:ℝ) else 0)| * NB h g k ξ + 0 * NB h g k ξ := this
      _ = |e| * |(if a = b then (1:ℝ) else 0)| * NB h g k ξ := by ring
      _ ≤ 4 * NB h g k ξ := mul_le_mul_of_nonneg_right h4 hng
      _ ≤ _ := mul_le_mul_of_nonneg_left hgb (by norm_num)

  have hF' : ContDiffOn ℝ ∞ (fun η => (-1) * K a b η + 1 * (n a η * Q η)) U' :=
    (contDiffOn_const.mul (hK' a b)).add (contDiffOn_const.mul ((hn' a).mul hQ'))
  have hDm' : ContDiffOn ℝ ∞ (fun η => e * g η * (if a = b then (1:ℝ) else 0)) U' :=
    (contDiffOn_const.mul hg').mul contDiffOn_const
  have eE : (fun η => -K a b η + (n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η)⁻¹ * (n a η * (n 0 η * K 0 b η + n 1 η * K 1 b η + n 2 η * K 2 b η + Ps b η)) - e * (n 0 η * n 0 η + n 1 η * n 1 η + n 2 η * n 2 η) * (if a = b then (1:ℝ) else 0)) =
      fun η => 1 * ((-1) * K a b η + 1 * (n a η * Q η)) +
        (-1) * (e * g η * (if a = b then (1:ℝ) else 0)) := by
    funext η
    simp only [hQ_def, hW_def, hg_def]
    ring
  rw [eE]
  have h1 := (nb_real_algebra_v5 h U' ξ hU' hξ' _ _ hF' hDm' k).2.1 1 (-1)
  have h2 := (nb_real_algebra_v5 h U' ξ hU' hξ' _ _ (hK' a b) ((hn' a).mul hQ') k).2.1 (-1) 1
  have hm1 : |(-1:ℝ)| = 1 := by norm_num
  rw [abs_one, hm1] at h1 h2
  have hKab := (hB k le_rfl).2.2 a b
  have hX1 : Sv ≤ Sv ^ (2 * k + 3) := by
    calc Sv = Sv ^ 1 := (pow_one _).symm
      _ ≤ _ := pow_le_pow_right₀ hSv (by omega)
  have hX2 : Sv * Sv ≤ Sv ^ (2 * k + 3) := by
    rw [← pow_two]; exact pow_le_pow_right₀ hSv (by omega)
  have t1 : D * Sv ≤ D * Sv ^ (2 * k + 3) := mul_le_mul_of_nonneg_left hX1 hD
  have t2 : 2 ^ k * (D * Sv) * (Cs * Sv ^ (2 * k + 2)) = 2 ^ k * D * Cs * Sv ^ (2 * k + 3) := by
    ring
  have t3 : 4 * (3 * (2 ^ k * (D * Sv) * (D * Sv))) ≤ 12 * 2 ^ k * D ^ 2 * Sv ^ (2 * k + 3) := by
    have e3 : 4 * (3 * (2 ^ k * (D * Sv) * (D * Sv))) = 12 * 2 ^ k * D ^ 2 * (Sv * Sv) := by ring
    rw [e3]
    exact mul_le_mul_of_nonneg_left hX2 (by positivity)
  have hfin : (|D| + 2 ^ k * |D| * Cs + 12 * 2 ^ k * D ^ 2) * Sv ^ (2 * k + 3) =
      D * Sv ^ (2 * k + 3) + 2 ^ k * D * Cs * Sv ^ (2 * k + 3) +
        12 * 2 ^ k * D ^ 2 * Sv ^ (2 * k + 3) := by
    rw [hAD]; ring
  rw [hfin]
  linarith

theorem pulse5_bcol_sjet_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ c0 : ℝ, 0 < c0 → ∀ k : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ (γ : Lab) (ξ : Cyl), ActiveL4 B G γ → ξ ∈ DomC B.h B.qB → etaL B.h γ ξ ≠ 0 → B.Xa < XC B.h ξ → c0 ≤ pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) 0 1 ^ 2 + pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) 0 2 ^ 2 → sJet5 (fun s : ℝ × ℝ × ℝ => Bcol5 B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + ((0:ℝ) * cib B.h γ.1 - G.r0) • vtv)) 1) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) k ≤ C :=
by
  intro B G hB hG c0 hc0 k
  obtain ⟨cf, Cf, hcf, hfr⟩ := frame5_consts B G hB hG
  have hr0 : 0 < G.r0 := hG.1.1
  have hr1 : G.r0 ≤ 1/100 := hG.1.2.1
  have hXa : 0 < B.Xa := hB.2.1.2.2.1
  obtain ⟨hΩo, -⟩ := geom_slow_base_smooth_v5 B hB

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ × ℝ × ℝ × ℝ × ℝ → Fin 3 → ℝ, Φ = fun z =>
      ![1, -(z.2.1 / Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2)) *
            (z.2.2.2.1 / z.1 / Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2)) +
          z.2.2.1 * (z.2.2.2.2 / Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2)),
        -(z.2.1 / Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2)) *
            (z.2.2.2.2 / Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2)) +
          z.2.2.1 * (-(z.2.2.2.1 / z.1 / Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2)))] := ⟨_, rfl⟩
  have hΦat : ∀ z : ℝ × ℝ × ℝ × ℝ × ℝ, z.1 ≠ 0 → z.2.2.2.1 ^ 2 + (z.1 * z.2.2.2.2) ^ 2 ≠ 0 →
      ContDiffAt ℝ ∞ Φ z := by
    intro z h1 h2
    have hN : (z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2 ≠ 0 := by
      have e : (z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2 =
          (z.2.2.2.1 ^ 2 + (z.1 * z.2.2.2.2) ^ 2) / z.1 ^ 2 := by
        rw [div_pow, eq_div_iff (pow_ne_zero 2 h1), add_mul, div_mul_cancel₀ _ (pow_ne_zero 2 h1)]
        ring
      rw [e]
      exact div_ne_zero h2 (pow_ne_zero 2 h1)
    have hS : Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2) ≠ 0 :=
      Real.sqrt_ne_zero'.mpr (lt_of_le_of_ne (by positivity) (Ne.symm hN))
    rw [hΦ, contDiffAt_pi]
    intro i
    fin_cases i
    · exact contDiffAt_const
    · simp only [Fin.mk_one, Fin.isValue, Matrix.cons_val_one, Matrix.cons_val_zero, Matrix.head_cons]
      fun_prop (disch := assumption)
    · simp only [Fin.reduceFinMk, Fin.isValue, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
      fun_prop (disch := assumption)
  obtain ⟨O, hOdef⟩ : ∃ O : Set (ℝ × ℝ × ℝ × ℝ × ℝ),
      O = {z | z.1 ≠ 0 ∧ z.2.2.2.1 ^ 2 + (z.1 * z.2.2.2.2) ^ 2 ≠ 0} := ⟨_, rfl⟩
  have hOo : IsOpen O := by
    rw [hOdef]
    exact (isOpen_ne_fun continuous_fst continuous_const).inter
      (isOpen_ne_fun ((continuous_snd.snd.snd.fst.pow 2).add
        ((continuous_fst.mul continuous_snd.snd.snd.snd).pow 2)) continuous_const)
  have hΦO : ContDiffOn ℝ ∞ Φ O := by
    intro z hz
    rw [hOdef] at hz
    exact (hΦat z hz.1 hz.2).contDiffWithinAt

  have key : ∀ (aa : ℝ × ℝ × ℝ × ℝ × ℝ) (T : (ℝ × ℝ × ℝ) →L[ℝ] (ℝ × ℝ × ℝ × ℝ × ℝ)) (x : ℝ × ℝ × ℝ) (i : ℕ),
      aa + T x ∈ O → iteratedFDeriv ℝ i (fun z => Φ (aa + T z)) x =
        (iteratedFDeriv ℝ i Φ (aa + T x)).compContinuousLinearMap (fun _ => T) := by
    intro aa T x i ha
    obtain ⟨s, hs_def⟩ : ∃ s : Set (ℝ × ℝ × ℝ × ℝ × ℝ), s = (fun z => aa + z) ⁻¹' O := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hOo.preimage (continuous_const.add continuous_id)
    have hOT : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have hAs : T x ∈ s := by rw [hs_def]; exact ha
    have hxO : x ∈ ⇑T ⁻¹' s := hAs
    have hsm' : ContDiffOn ℝ ∞ (fun z => Φ (aa + z)) s :=
      hΦO.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => Φ (aa + T z)) i hOT hxO
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm' hs.uniqueDiffOn
      hOT.uniqueDiffOn hAs (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => Φ (aa + z)) i hs hAs
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := Φ) i aa (T x)
    calc iteratedFDeriv ℝ i (fun z => Φ (aa + T z)) x
        = iteratedFDerivWithin ℝ i ((fun z => Φ (aa + z)) ∘ ⇑T) (⇑T ⁻¹' s) x := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => Φ (aa + z)) s (T x)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDeriv ℝ i (fun z => Φ (aa + z)) (T x)).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i Φ (aa + T x)).compContinuousLinearMap (fun _ => T) := by rw [e4]

  have hhom : ∀ (w b k' a S r : ℝ), 0 < r → Φ (w, r * b, k', r * a, r * S) = Φ (w, b, k', a, S) := by
    intro w b k' a S r hr
    have hr' : r ≠ 0 := hr.ne'
    have hS : Real.sqrt ((r * a / w) ^ 2 + (r * S) ^ 2) = r * Real.sqrt ((a / w) ^ 2 + S ^ 2) := by
      rw [show (r * a / w) ^ 2 + (r * S) ^ 2 = r ^ 2 * ((a / w) ^ 2 + S ^ 2) by ring,
        Real.sqrt_mul (sq_nonneg r), Real.sqrt_sq hr.le]
    have e4 : r * a / w = r * (a / w) := mul_div_assoc _ _ _
    rw [hΦ]
    dsimp only
    rw [hS, e4, mul_div_mul_left b _ hr', mul_div_mul_left (a / w) _ hr', mul_div_mul_left S _ hr']

  obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = 1 + Real.sqrt Cf * |G.ustar| / Real.sqrt c0 + |Cf| * (1 + |G.ustar|) :=
    ⟨_, rfl⟩
  have hR1 : 0 ≤ Real.sqrt Cf * |G.ustar| / Real.sqrt c0 := by positivity
  have hR2 : 0 ≤ |Cf| * (1 + |G.ustar|) := by positivity
  obtain ⟨K, hKdef⟩ : ∃ K : Set (ℝ × ℝ × ℝ × ℝ × ℝ),
      K = Metric.closedBall 0 R ∩ {z | z.1 = 1 ∧ 1 ≤ z.2.2.2.1 ^ 2 + z.2.2.2.2 ^ 2} := ⟨_, rfl⟩
  have hKc : IsCompact K := by
    rw [hKdef]
    exact (isCompact_closedBall 0 R).inter_right
      ((isClosed_eq continuous_fst continuous_const).inter
        (isClosed_le continuous_const
          ((continuous_snd.snd.snd.fst.pow 2).add (continuous_snd.snd.snd.snd.pow 2))))
  have hKO : K ⊆ O := by
    intro z hz
    rw [hKdef] at hz
    obtain ⟨-, h1, h2⟩ := hz
    rw [hOdef]
    refine ⟨by rw [h1]; exact one_ne_zero, ?_⟩
    rw [h1, one_mul]
    exact (show (0:ℝ) < z.2.2.2.1 ^ 2 + z.2.2.2.2 ^ 2 by linarith).ne'
  obtain ⟨A0, hA0def⟩ : ∃ A0 : ℝ, A0 = (Real.sqrt (2 * B.Xa))⁻¹ := ⟨_, rfl⟩
  have hA0 : 0 ≤ A0 := by rw [hA0def]; positivity
  obtain ⟨Mk, hMk⟩ := hKc.exists_bound_of_continuousOn
    ((hΦO.continuousOn_iteratedFDerivWithin (m := k) (by exact_mod_cast le_top) hOo.uniqueDiffOn).mono hKO)
  refine ⟨|Mk| * A0 ^ k, mul_nonneg (abs_nonneg _) (pow_nonneg hA0 k), ?_⟩
  intro γ ξ hA hD heta hX1 hc
  obtain ⟨-, -, -, -, -, hl1, hl2, hc8, hc9, -⟩ := hfr γ hA
  have hx0 : 0 < ξ.1 := hD.1
  have hq0 : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hD.2.1])).1
  have hQb0 : 0 < Qb γ.1 := by unfold Qb; positivity
  have hXC : B.Xa * (2 * qC B.h ξ) ≤ ξ.1 ^ 2 := by
    have h := hX1
    unfold XC at h
    rw [lt_div_iff₀ (by linarith)] at h
    exact h.le
  have hsgn : |sgn γ.2.2| = 1 := by unfold sgn; split_ifs <;> simp

  have hTg0 : (0:ℝ) < Tgc := by unfold Tgc; positivity
  have hci : 0 < cib B.h γ.1 := by
    unfold cib
    exact mul_pos (zpow_pos hTg0 _) (Real.rpow_pos_of_pos hQb0 _)
  have hL0 : (0:ℝ) ≤ Lsb B.h G.r0 γ.1 := by
    show 0 ≤ 2 * G.r0 / cib B.h γ.1
    exact div_nonneg (by linarith) hci.le
  have h0L : (0:ℝ) ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1) := ⟨le_rfl, hL0⟩
  obtain ⟨Y0, hY0⟩ : ∃ Y0 : ℝ × ℝ,
      Y0 = Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + ((0:ℝ) * cib B.h γ.1 - G.r0) • vtv) := ⟨_, rfl⟩
  have hpt := pulse5_point_rect B.h G.r0 γ (G.ctr γ) 0 hr0 hr1 h0L
  rw [← hY0] at hpt
  obtain ⟨-, hvY0, hxY0, heY0⟩ := hpt
  have hsm := pulse5_slice_model_v5 B G γ 0 hB hr0 hr1 h0L (ξ.1, ξ.2.1, ξ.2.2.1) hD
  rw [← hY0] at hsm
  have hN0 := hsm.1
  rw [← hY0]

  obtain ⟨β, hβdef⟩ : ∃ β : ℝ, β = sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 := ⟨_, rfl⟩
  obtain ⟨κ, hκdef⟩ : ∃ κ : ℝ, κ = 1 * c0f5 B G γ * Real.sqrt (1 + sco B G γ 0 ^ 2) := ⟨_, rfl⟩
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = pang5 B G γ * Real.sqrt (Qb γ.1) / ξ.1 := ⟨_, rfl⟩
  obtain ⟨p, hpdef⟩ : ∃ p : ℝ, p = pzr5 B G γ := ⟨_, rfl⟩
  have hΩ : ∀ s : ℝ × ℝ × ℝ, s ∈ {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} →
      nPhi5 B G γ (s.1, s.2.1, s.2.2, Y0) = ![β, pang5 B G γ / RC γ.1 (s.1, s.2.1, s.2.2, Y0), p] := by
    intro s hs
    obtain ⟨η, hη⟩ : ∃ η : Cyl, η = (s.1, s.2.1, s.2.2, Y0) := ⟨_, rfl⟩
    have hη3 : η.2.2.2 = Y0 := by rw [hη]
