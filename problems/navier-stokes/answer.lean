  refine ⟨by rw [hstar]; exact hPs, ?_⟩

  have hray : ∀ u : ℝ, 0 < u → ∀ i : ℕ, ‖iteratedFDeriv ℝ i (gu u) 0‖ ≤
      max 1 u ^ i * NB B.h F i ((u * ξ0.1, ξ0.2.1, ξ0.2.2.1, (0 : ℝ × ℝ)) : Cyl) := by
    intro u hu i
    set ξu : Cyl := (u * ξ0.1, ξ0.2.1, ξ0.2.2.1, (0 : ℝ × ℝ)) with hξu_def
    obtain ⟨ι, hι⟩ : ∃ ι : ℝ × ℝ × ℝ →L[ℝ] Cyl, ι = (u • ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).prod
        (((ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))).prod
          (((ContinuousLinearMap.snd ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))).prod 0)) :=
      ⟨_, rfl⟩
    have hιa : ∀ a : ℝ × ℝ × ℝ, ι a = ((u * a.1, a.2.1, a.2.2, (0 : ℝ × ℝ)) : Cyl) := by
