  obtain ⟨Φ, hΦ⟩ : ∃ Φ : (Fin 5 → ℝ) → ℝ → (Fin 5 → ℝ),
      Φ = fun d η => (cpatch * (1 + η ^ 2)⁻¹) • g (zf d η) := ⟨_, rfl⟩
  refine ⟨r1 + ℓ, r1 + 7 * ℓ, δ, cpatch * L * K, β, γ, Φ, by linarith, by linarith, by linarith,
