        _ = C j * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ (b j) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
              edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d j)) := by ring
        _ ≤ Cs * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ (b j) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
              edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d j)) :=
            mul_le_mul_of_nonneg_right (hCj j hj)
              (mul_nonneg (mul_nonneg (mul_nonneg hqa p1) hE) p2)
        _ ≤ Cs * W := by
            rw [hW]
            refine mul_le_mul_of_nonneg_left ?_ hCs0
            exact mul_le_mul (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hb hqa) hE) hd p2
              (mul_nonneg (mul_nonneg hqa p3) hE)
    have hexp : qC B.h ξ ^ (B.h * (α + (c + e / 2) / B.h)) =
        qC B.h ξ ^ (c + e / 2) * qC B.h ξ ^ (B.h * α) := by
      rw [← Real.rpow_add hq]
      congr 1
      first
        | (field_simp; ring)
        | field_simp
    have hev : (fun η => qC B.h η ^ c * η.1 ^ e * f η) =ᶠ[nhds ξ] (fun η => M η * f η) :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) heq
    have hNBeq : NB B.h (fun η => qC B.h η ^ c * η.1 ^ e * f η) k ξ =
        NB B.h (fun η => M η * f η) k ξ := by
      unfold NB
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    have hl := hmul (DomC B.h qs) M f hDo hMs F1 ξ hξ k
    calc NB B.h (fun η => qC B.h η ^ c * η.1 ^ e * f η) k ξ
        = NB B.h (fun η => M η * f η) k ξ := hNBeq
      _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB B.h M i ξ * NB B.h f (k - i) ξ := hl
      _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (Ms * qC B.h ξ ^ (c + e / 2)) * (Cs * W) := by
          apply Finset.sum_le_sum
          intro i hi
          have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have hMi : NB B.h M i ξ ≤ Ms * qC B.h ξ ^ (c + e / 2) :=
            (hCM i ξ hξ hX1 hX2).trans (mul_le_mul_of_nonneg_right (hMj i hik) hqc)
          exact mul_le_mul (mul_le_mul_of_nonneg_left hMi (Nat.cast_nonneg _))
            (hFb _ (Nat.sub_le k i)) (norm_nonneg _)
            (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg hMs0 hqc))
      _ = 2 ^ k * (Ms * qC B.h ξ ^ (c + e / 2)) * (Cs * W) := by
          rw [← Finset.sum_mul, ← Finset.sum_mul]
          have hs2 : ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) = 2 ^ k := by
            exact_mod_cast Nat.sum_range_choose k
          rw [hs2]
      _ = 2 ^ k * Ms * Cs * qC B.h ξ ^ (B.h * (α + (c + e / 2) / B.h)) * SC B.h ξ ^ bs *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-ds) := by
          rw [hexp, hW]; ring

theorem cyl_flat_comp_v5 : ∀ (B : BG) (qs c : ℝ) (Φ : ℝ × ℝ × (ℝ × ℝ) → ℝ), B.ok → 0 < qs → qs ≤ 1 →
    ContDiffOn ℝ ∞ Φ {ζ | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} →
    (∀ k N : ℕ, ∃ C : ℝ, ∀ ζ : ℝ × ℝ × (ℝ × ℝ), ζ.2.1 < 1 → simScale B.h ζ.1 (1 - ζ.2.1) < qs →
      ‖iteratedFDeriv ℝ k Φ ζ‖ ≤ C * simScale B.h ζ.1 (1 - ζ.2.1) ^ (N : ℝ)) →
    ContDiffOn ℝ ∞ (fun ξ : Cyl => qC B.h ξ ^ c * deriv (chiM B) (XC B.h ξ) *
      Φ (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv)) (DomC B.h qs) ∧
    ∀ m N : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h qs,
      NB B.h (fun ξ : Cyl => qC B.h ξ ^ c * deriv (chiM B) (XC B.h ξ) *
        Φ (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv)) m ξ ≤ C * qC B.h ξ ^ (N : ℝ) :=
by
  intro B qs c Φ hok hqs0 hqs1 hΦs hΦb
  have hh0 : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  have hSN : SimNorm B.h := simscale_normalized_v4 B.h hh0 hh1 hok.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hXm1 : B.Xa < B.m1 := hok.2.1.2.2.2.1
  have hm12 : B.m1 < B.m2 := hok.2.1.2.2.2.2.1
  have hm2b : B.m2 < B.Xb := hok.2.1.2.2.2.2.2.1
  have hd1 : 1 ≤ drx B.h := (coarseIdx_arith_v5 B.h hh0 hh1).1.1
  have hd0 : 0 ≤ drx B.h := by linarith

  have hmemD : ∀ ξ ∈ DomC B.h qs, 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := fun ξ hξ => hξ
  obtain ⟨hDo, hqpos, hXc⟩ : IsOpen (DomC B.h qs) ∧ (∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ) ∧
      ContinuousOn (XC B.h) (DomC B.h qs) := by
    have hT : IsOpen {ξ : Cyl | ξ.2.2.1 < 1} :=
      isOpen_lt continuous_snd.snd.fst continuous_const
    have hqc : ContinuousOn (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
      have hs := hok.1.2.2.2.1
      have hg : Continuous (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
        continuous_snd.fst.prodMk (continuous_const.sub continuous_snd.snd.fst)
      have hc := hs.continuousOn.comp hg.continuousOn (fun ξ (hξ : ξ.2.2.1 < 1) =>
        (⟨Set.mem_univ _, Set.mem_Ioi.mpr (sub_pos.mpr hξ)⟩ : (ξ.2.1, 1 - ξ.2.2.1) ∈ Set.univ ×ˢ Set.Ioi (0:ℝ)))
      exact hc
    have hqp : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ := fun ξ hξ =>
      (hok.1.1 _ _ (sub_pos.mpr (hmemD ξ hξ).2.1)).1
    refine ⟨?_, hqp, ?_⟩
    · have h1 : IsOpen ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Set.Iio qs) :=
        hqc.isOpen_inter_preimage hT isOpen_Iio
      have h2 : IsOpen {ξ : Cyl | 0 < ξ.1} := isOpen_lt continuous_const continuous_fst
      have e : DomC B.h qs = {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Set.Iio qs) := by
        ext ξ
        simp only [DomC, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iio]
      rw [e]
      exact h2.inter h1
    · have hq' : ContinuousOn (qC B.h) (DomC B.h qs) := hqc.mono (fun ξ hξ => (hmemD ξ hξ).2.1)
      have hc : ContinuousOn (fun ξ : Cyl => ξ.1 ^ 2 / (2 * qC B.h ξ)) (DomC B.h qs) :=
        (continuous_fst.pow 2).continuousOn.div (continuousOn_const.mul hq')
          (fun ξ hξ => by have := hqp ξ hξ; positivity)
      exact hc

  have hΩo : IsOpen {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} := by
    have hT : IsOpen {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1} := isOpen_lt continuous_snd.fst continuous_const
    have hc : ContinuousOn (fun ζ : ℝ × ℝ × (ℝ × ℝ) => simScale B.h ζ.1 (1 - ζ.2.1))
        {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1} := by
      have hs := hok.1.2.2.2.1
      have hg : Continuous (fun ζ : ℝ × ℝ × (ℝ × ℝ) => (ζ.1, 1 - ζ.2.1)) :=
        continuous_fst.prodMk (continuous_const.sub continuous_snd.fst)
      have hc := hs.continuousOn.comp hg.continuousOn (fun ζ (hζ : ζ.2.1 < 1) =>
        (⟨Set.mem_univ _, Set.mem_Ioi.mpr (sub_pos.mpr hζ)⟩ : (ζ.1, 1 - ζ.2.1) ∈ Set.univ ×ˢ Set.Ioi (0:ℝ)))
      exact hc
    have h1 := hc.isOpen_inter_preimage hT (isOpen_Iio (a := qs))
    have e : {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} =
        {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1} ∩
          (fun ζ : ℝ × ℝ × (ℝ × ℝ) => simScale B.h ζ.1 (1 - ζ.2.1)) ⁻¹' Set.Iio qs := by
      ext ζ
      simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iio]
    rw [e]
    exact h1

  have hchiC : ContDiff ℝ ∞ (chiM B) :=
    Real.smoothTransition.contDiff.comp ((contDiff_id.sub contDiff_const).div_const _)
  have hφC : ContDiff ℝ ∞ (deriv (chiM B)) := (contDiff_infty_iff_deriv.mp hchiC).2
  have hchi0 : ∀ X : ℝ, ¬ (B.m1 ≤ X ∧ X ≤ B.m2) → deriv (chiM B) X = 0 := by
    intro X hX
    have hd : 0 < B.m2 - B.m1 := by linarith
    rcases not_and_or.mp hX with h | h
    · push_neg at h
      have hev : chiM B =ᶠ[nhds X] fun _ => (0:ℝ) := by
        filter_upwards [Iio_mem_nhds h] with Y hY
        have hY' : Y < B.m1 := hY
        unfold chiM
        apply Real.smoothTransition.zero_of_nonpos
        exact div_nonpos_iff.mpr (Or.inr ⟨by linarith, by linarith⟩)
      rw [hev.deriv_eq, deriv_const]
    · push_neg at h
      have hev : chiM B =ᶠ[nhds X] fun _ => (1:ℝ) := by
        filter_upwards [Ioi_mem_nhds h] with Y hY
        have hY' : B.m2 < Y := hY
        unfold chiM
        apply Real.smoothTransition.one_of_one_le
        rw [le_div_iff₀ hd]
        linarith
      rw [hev.deriv_eq, deriv_const]

  obtain ⟨hA, hAb⟩ := qpow_profile_nb_v4 B qs hok hSN hqs0 hqs1 (deriv (chiM B)) c hφC.contDiffOn

  have hπ : ContDiffOn ℝ ∞ (fun η : Cyl => ((η.2.1, η.2.2.1, η.2.2.2 - (η.1 ^ drx B.h) • vrv) :
      ℝ × ℝ × (ℝ × ℝ))) (DomC B.h qs) := by
    have hp : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ drx B.h) (DomC B.h qs) :=
      (contDiffOn_fst (s := DomC B.h qs)).rpow_const_of_ne (fun η hη => (hmemD η hη).1.ne')
    exact (contDiff_snd.fst.contDiffOn).prodMk ((contDiff_snd.snd.fst.contDiffOn).prodMk
      (contDiff_snd.snd.snd.contDiffOn.sub (hp.smul contDiffOn_const)))
  set Pfun : Cyl → ℝ × ℝ × (ℝ × ℝ) := fun η => ((η.2.1, η.2.2.1, η.2.2.2 - (η.1 ^ drx B.h) • vrv) :
      ℝ × ℝ × (ℝ × ℝ)) with hPdef
  have hmaps : Set.MapsTo Pfun (DomC B.h qs)
      {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} := fun ξ hξ =>
    show (Pfun ξ).2.1 < 1 ∧ simScale B.h (Pfun ξ).1 (1 - (Pfun ξ).2.1) < qs from
      ⟨(hmemD ξ hξ).2.1, (hmemD ξ hξ).2.2⟩
  have hG : ContDiffOn ℝ ∞ (fun η : Cyl => Φ (Pfun η)) (DomC B.h qs) := hΦs.comp hπ hmaps
  refine ⟨hA.mul hG, ?_⟩
  intro m N

  have hpath : ∀ (d R c0 : ℝ) (v : ℝ × ℝ), ‖v‖ ≤ 1 → 0 ≤ d → 0 < R → 0 < c0 →
      ∀ i : ℕ, 1 ≤ i → ∀ ξ : ℝ × ℝ × ℝ × (ℝ × ℝ), ∀ q : ℝ, 0 < q → q ≤ 1 → c0 * q ≤ ξ.1 → ξ.1 ≤ R →
      ‖iteratedFDeriv ℝ i (fun η : ℝ × ℝ × ℝ × (ℝ × ℝ) =>
          ((η.2.1, η.2.2.1, η.2.2.2 - (η.1 ^ d) • v) : ℝ × ℝ × (ℝ × ℝ))) ξ‖ ≤
        (1 + |Polynomial.eval d (descPochhammer ℝ i)| * R ^ d * (c0⁻¹) ^ i) * (q⁻¹) ^ i := by
    intro d R c0 v hv hd hR hc0 i hi ξ q hq hq1 hlo hhi
    have hs : 0 < ξ.1 := lt_of_lt_of_le (mul_pos hc0 hq) hlo
    set Λ := ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)) with hΛ
    set J := (ContinuousLinearMap.id ℝ ℝ).smulRight (((0:ℝ), (0:ℝ), -v) : ℝ × ℝ × (ℝ × ℝ)) with hJ
    set P := ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)) with hP
    have hdec : (fun η : ℝ × ℝ × ℝ × (ℝ × ℝ) =>
        ((η.2.1, η.2.2.1, η.2.2.2 - (η.1 ^ d) • v) : ℝ × ℝ × (ℝ × ℝ))) =
        ⇑Λ + (⇑J ∘ ((fun x : ℝ => x ^ d) ∘ ⇑P)) := by
      funext η
      refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp [hΛ, hJ, hP, sub_eq_add_neg]
    have hρat : ContDiffAt ℝ ∞ ((fun x : ℝ => x ^ d) ∘ ⇑P) ξ :=
      (Real.contDiffAt_rpow_const_of_ne (x := ξ.1) hs.ne').comp ξ P.contDiff.contDiffAt
    have hJat : ContDiffAt ℝ ∞ (⇑J ∘ ((fun x : ℝ => x ^ d) ∘ ⇑P)) ξ :=
      J.contDiff.contDiffAt.comp ξ hρat
    rw [hdec, iteratedFDeriv_add_apply (Λ.contDiff.contDiffAt.of_le (by exact_mod_cast le_top))
      (hJat.of_le (by exact_mod_cast le_top))]
    have hlin : ‖iteratedFDeriv ℝ i (⇑Λ) ξ‖ ≤ 1 := by
      obtain ⟨n, rfl⟩ : ∃ n, i = n + 1 := ⟨i - 1, by omega⟩
      rw [← norm_iteratedFDeriv_fderiv]
      have hfd : fderiv ℝ (⇑Λ) = fun _ => Λ := funext fun x => Λ.fderiv
      rw [hfd]
      rcases n with _ | n
      · rw [norm_iteratedFDeriv_zero]; exact ContinuousLinearMap.norm_snd_le ℝ ℝ _
      · rw [iteratedFDeriv_const_of_ne (by omega)]; simp
    have hJn : ‖J‖ ≤ 1 := by
      rw [hJ, ContinuousLinearMap.norm_smulRight_apply]
      have h1 : ‖ContinuousLinearMap.id ℝ ℝ‖ ≤ 1 := ContinuousLinearMap.norm_id_le
      have h2 : ‖(((0:ℝ), (0:ℝ), -v) : ℝ × ℝ × (ℝ × ℝ))‖ ≤ 1 :=
        norm_prod_le_iff.mpr ⟨by simp, norm_prod_le_iff.mpr ⟨by simp, by rw [norm_neg]; exact hv⟩⟩
      calc _ ≤ 1 * 1 := mul_le_mul h1 h2 (norm_nonneg _) zero_le_one
        _ = 1 := one_mul 1
    have hρon : ContDiffOn ℝ ∞ (fun x : ℝ => x ^ d) (Set.Ioi 0) :=
      fun x hx => (Real.contDiffAt_rpow_const_of_ne (ne_of_gt hx)).contDiffWithinAt
    have hPmem : P ξ ∈ Set.Ioi (0:ℝ) := hs
    have hOP : IsOpen (⇑P ⁻¹' Set.Ioi (0:ℝ)) := isOpen_Ioi.preimage P.continuous
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := (fun x : ℝ => x ^ d) ∘ ⇑P) i hOP hPmem
    have e2 := P.iteratedFDerivWithin_comp_right hρon (uniqueDiffOn_Ioi 0) hOP.uniqueDiffOn hPmem
      (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun x : ℝ => x ^ d) i isOpen_Ioi hPmem
    have hρn : ‖iteratedFDeriv ℝ i ((fun x : ℝ => x ^ d) ∘ ⇑P) ξ‖ ≤
        ‖iteratedFDeriv ℝ i (fun x : ℝ => x ^ d) ξ.1‖ := by
      rw [← e1, e2, e3]
      refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
      have hp : ∏ _i : Fin i, ‖P‖ ≤ 1 := by
        rw [Finset.prod_const]
        exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_fst_le ℝ ℝ _)
      calc _ ≤ ‖iteratedFDeriv ℝ i (fun x : ℝ => x ^ d) (P ξ)‖ * 1 :=
            mul_le_mul_of_nonneg_left hp (norm_nonneg _)
        _ = _ := mul_one _
    have hval : ‖iteratedFDeriv ℝ i (fun x : ℝ => x ^ d) ξ.1‖ =
        |Polynomial.eval d (descPochhammer ℝ i)| * ξ.1 ^ (d - i) := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate, Real.iter_deriv_rpow_const,
        Real.norm_eq_abs, abs_mul, abs_of_pos (Real.rpow_pos_of_pos hs _)]
    have hwin : ξ.1 ^ (d - i) ≤ R ^ d * (c0⁻¹) ^ i * (q⁻¹) ^ i := by
      rw [Real.rpow_sub hs, Real.rpow_natCast]
      have h1 : ξ.1 ^ d ≤ R ^ d := Real.rpow_le_rpow hs.le hhi hd
      have h2 : (c0 * q) ^ i ≤ ξ.1 ^ i := pow_le_pow_left₀ (mul_pos hc0 hq).le hlo i
      have h3 : 0 < (c0 * q) ^ i := pow_pos (mul_pos hc0 hq) i
      calc ξ.1 ^ d / ξ.1 ^ i ≤ R ^ d / (c0 * q) ^ i :=
            div_le_div₀ (Real.rpow_nonneg hR.le _) h1 h3 h2
        _ = R ^ d * (c0⁻¹) ^ i * (q⁻¹) ^ i := by
            rw [div_eq_mul_inv, mul_pow, mul_inv, inv_pow, inv_pow]; ring
    have hcomp := J.norm_iteratedFDeriv_comp_left (n := i) hρat (by exact_mod_cast le_top)
    have hPa : 0 ≤ |Polynomial.eval d (descPochhammer ℝ i)| := abs_nonneg _
    have hq1' : 1 ≤ (q⁻¹) ^ i := one_le_pow₀ ((one_le_inv₀ hq).mpr hq1)
    calc ‖iteratedFDeriv ℝ i (⇑Λ) ξ + iteratedFDeriv ℝ i (⇑J ∘ ((fun x : ℝ => x ^ d) ∘ ⇑P)) ξ‖
        ≤ ‖iteratedFDeriv ℝ i (⇑Λ) ξ‖ + ‖iteratedFDeriv ℝ i (⇑J ∘ ((fun x : ℝ => x ^ d) ∘ ⇑P)) ξ‖ :=
          norm_add_le _ _
      _ ≤ 1 + 1 * (|Polynomial.eval d (descPochhammer ℝ i)| * (R ^ d * (c0⁻¹) ^ i * (q⁻¹) ^ i)) := by
          refine add_le_add hlin (hcomp.trans (mul_le_mul hJn ?_ (norm_nonneg _) zero_le_one))
          exact hρn.trans (hval.trans_le (mul_le_mul_of_nonneg_left hwin hPa))
      _ ≤ (q⁻¹) ^ i + |Polynomial.eval d (descPochhammer ℝ i)| * R ^ d * (c0⁻¹) ^ i * (q⁻¹) ^ i := by
          have : 1 * (|Polynomial.eval d (descPochhammer ℝ i)| * (R ^ d * (c0⁻¹) ^ i * (q⁻¹) ^ i)) =
              |Polynomial.eval d (descPochhammer ℝ i)| * R ^ d * (c0⁻¹) ^ i * (q⁻¹) ^ i := by ring
          linarith
      _ = _ := by ring

  have hs1 : 1 < Real.sqrt 2 := (Real.lt_sqrt (by norm_num)).mpr (by norm_num)
  have hs2 : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
  have hb0 : 0 < bgc := by unfold bgc; linarith
  have hb1 : bgc ≤ 1 := by unfold bgc; linarith
  have hβ0 : 0 < 1 + bgc ^ 2 := by positivity
  have hβ : 1 ≤ 1 + bgc ^ 2 := le_add_of_nonneg_right (sq_nonneg _)
  have hL1 : 1 ≤ Lgc := by unfold Lgc; linarith
  have hT1 : 1 ≤ Tgc := by unfold Tgc; linarith [Real.sqrt_nonneg 2]
  have hL0 : 0 < Lgc := by linarith
  have hT0 : 0 < Tgc := by linarith
  have c1 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).1 = Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) * bgc := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have c2 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).2 = -(Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) * bgc) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have hJ : ∀ (k : ℤ) (Y : ℝ × ℝ), JpowL k Y = Jpow k Y := by
    intro k Y
    refine Prod.ext ?_ ?_
