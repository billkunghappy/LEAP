theorem pch5_theta_mean : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (g : WC) (α : ℝ) (Zv : Cyl → Fin 3 → ℝ) (F : Ext ℝ³), InWg5 B G (qsOf l0) α g → (∀ x t Y, corrOn B l0 x t → F x t Y = cyl2cart x (fun a => qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2)) * waveV5 B G g (thetaOf x) (ptOf x t Y) a + Zv (ptOf x t Y) a)) → ∀ x t Y, corrOn B l0 x t → F x t Y - thAvgVec F x t Y = (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) • cyl2cart x (waveV5 B G g (thetaOf x) (ptOf x t Y)) :=
