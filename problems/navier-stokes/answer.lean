  ·
    show |pzr5 B G γ - v * (pang5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1)
        ((0:ℝ), (1:ℝ), (0:ℝ))) + pzr5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1)
        ((0:ℝ), (1:ℝ), (0:ℝ)))) - Bs5 B G γ * ((eN (g0r5 B G γ))⁻¹ * (g0r5 B G γ).1)| ≤ C1 / (γ.1:ℝ) ^ 2
    calc _ ≤ K5 * (1 / Lsb B.h G.r0 γ.1 + Lsb B.h G.r0 γ.1 * (KE * (t * t))) := hla3
      _ ≤ K5 * (1 / (2 * G.r0) * t + T * KE * t) := mul_le_mul_of_nonneg_left (by linarith) hK50
      _ = (K5 * (1 / (2 * G.r0) + T * KE)) * t := by ring
      _ ≤ C1 / (γ.1:ℝ) ^ 2 := hfin _ (by rw [hC1]; linarith)
  · exact le_trans hla4 hMK
  · rw [abs_zero]; linarith
  · exact le_trans hla5 hMK
  ·
    rw [abs_le]; constructor <;> linarith
  ·
