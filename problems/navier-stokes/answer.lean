  refine ⟨ε, hεpos, ?_⟩
  intro Bd
  obtain ⟨T, hTd⟩ : ∃ T : ℝ, T = 40 * Ks * (|Bd| + 1) + 1 := ⟨_, rfl⟩
  have hT : 0 < T := by rw [hTd]; positivity
