    rw [hadef, hDldef]
    exact (hRv' w.1 w.2).trans (hRv w.1 w.2 hw.1)
  have hRe : edgeFlatOn Xa Xb aa ab X1 (↿R) := by
    have hprod := T3 0 X1 a Dl hX1pos hXaX1 (has.mono hsub) hDls habd hDle
    intro k
    obtain ⟨C, N, hb⟩ := hprod k
    refine ⟨C, N, fun X η k1 k2 k3 k4 => ?_⟩
    have hw : ((X, η) : ℝ × ℝ) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := ⟨show (0:ℝ) < X by linarith, k3, k4⟩
    have hev : (↿R) =ᶠ[nhds (X, η)] (fun w => a w * Dl w) :=
      Filter.eventuallyEq_of_mem (hO.mem_nhds hw) hRid
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    exact hb X η k1 k2 k3 k4
  have hT1 := T4 X1 (-(1 + h)) R hX1pos hXaX1 hX1b hRs hRe
  have hT2 := T4 X1 (-(1 + h) - (1 / 2 - h)) (simZop h (-(1 + h)) R) hX1pos hXaX1 hX1b hT1.1 hT1.2
  have hZZe := hT2.2

  have hThnorm : ∀ (k : ℕ) (X η : ℝ), Xs < X → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ k (↿(bgResTh h S G W 1)) (X, η)‖ =
        ‖iteratedFDeriv ℝ k (↿(simZop h (-(1 + h) - (1 / 2 - h)) (simZop h (-(1 + h)) R))) (X, η)‖ := by
    intro k X η hX h1 h2
    have hΩ : IsOpen (Ioi Xs ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
    have hw : ((X, η) : ℝ × ℝ) ∈ Ioi Xs ×ˢ Ioo (-1:ℝ) 1 := ⟨hX, h1, h2⟩
    have hev : (↿(bgResTh h S G W 1)) =ᶠ[nhds (X, η)]
        -(↿(simZop h (-(1 + h) - (1 / 2 - h)) (simZop h (-(1 + h)) R))) := by
      apply Filter.eventuallyEq_of_mem (hΩ.mem_nhds hw)
      intro w hw'
      have hws : Xs < w.1 := hw'.1
      have hw0 : 0 < w.1 := by linarith
      show bgResTh h S G W 1 w.1 w.2 = -(simZop h _ (simZop h _ R) w.1 w.2)
      rw [tailTh w.1 w.2 hws hw'.2.1 hw'.2.2, hZZ w.1 w.2 hw0 hw'.2.1 hw'.2.2]
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_neg_apply, norm_neg]
  have zeroZ : ∀ (k : ℕ) (X η : ℝ), X1 < X → -1 < η → η < 1 →
      iteratedFDeriv ℝ k (↿(bgResZ h S G W 1)) (X, η) = 0 := by
    intro k X η hX h1 h2
    have hΩ : IsOpen (Ioi (max Xs Xv) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
    have hmx : max Xs Xv < X := max_lt (by linarith) (by linarith)
    have hw : ((X, η) : ℝ × ℝ) ∈ Ioi (max Xs Xv) ×ˢ Ioo (-1:ℝ) 1 := ⟨hmx, h1, h2⟩
    have hev : (↿(bgResZ h S G W 1)) =ᶠ[nhds (X, η)] fun _ => (0:ℝ) := by
      apply Filter.eventuallyEq_of_mem (hΩ.mem_nhds hw)
      intro w hw'
      have hm : max Xs Xv < w.1 := hw'.1
      exact tailZ w.1 w.2 (lt_of_le_of_lt (le_max_left _ _) hm)
        (lt_of_le_of_lt (le_max_right _ _) hm) hw'.2.1 hw'.2.2
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    exact congrFun iteratedFDeriv_fun_zero (X, η)
  have zeroI : ∀ (k : ℕ) (X η : ℝ), 0 < X → X < Xm → -1 < η → η < 1 →
      iteratedFDeriv ℝ k (↿(bgResTh h S G W 1)) (X, η) = 0 ∧
        iteratedFDeriv ℝ k (↿(bgResZ h S G W 1)) (X, η) = 0 := by
    intro k X η hX0 hXm h1 h2
    have hΩ : IsOpen (Ioo 0 Xm ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioo.prod isOpen_Ioo
    have hw : ((X, η) : ℝ × ℝ) ∈ Ioo 0 Xm ×ˢ Ioo (-1:ℝ) 1 := ⟨⟨hX0, hXm⟩, h1, h2⟩
    have hev1 : (↿(bgResTh h S G W 1)) =ᶠ[nhds (X, η)] fun _ => (0:ℝ) :=
      Filter.eventuallyEq_of_mem (hΩ.mem_nhds hw)
        (fun w hw' => (hBin 1 le_rfl w.1 w.2 hw'.1.1 hw'.1.2.le hw'.2.1 hw'.2.2).1)
    have hev2 : (↿(bgResZ h S G W 1)) =ᶠ[nhds (X, η)] fun _ => (0:ℝ) :=
      Filter.eventuallyEq_of_mem (hΩ.mem_nhds hw)
        (fun w hw' => (hBin 1 le_rfl w.1 w.2 hw'.1.1 hw'.1.2.le hw'.2.1 hw'.2.2).2)
    rw [(hev1.iteratedFDeriv ℝ k).eq_of_nhds, (hev2.iteratedFDeriv ℝ k).eq_of_nhds]
    exact ⟨congrFun iteratedFDeriv_fun_zero (X, η), congrFun iteratedFDeriv_fun_zero (X, η)⟩

  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = Real.exp (-(aa / Real.log (Xm / Xa) ^ 2) - ab / Real.log (Xb / X1) ^ 2) :=
    ⟨_, rfl⟩
  have hcpos : 0 < c := by rw [hc]; exact Real.exp_pos _
  have hcle : ∀ X, Xm ≤ X → X ≤ X1 → c ≤ edgeWeight Xa Xb aa ab X := by
    intro X hX1' hX2'
    have hX0 : 0 < X := by linarith
    unfold edgeWeight
    rw [if_pos ⟨by linarith, by linarith⟩, hc]
    apply Real.exp_le_exp.mpr
    have l1 : 0 < Real.log (Xm / Xa) := Real.log_pos (by rw [lt_div_iff₀ hXa0]; linarith)
    have l2 : Real.log (Xm / Xa) ≤ Real.log (X / Xa) :=
      Real.log_le_log (div_pos (by linarith) hXa0) (div_le_div_of_nonneg_right hX1' hXa0.le)
    have l3 : 0 < Real.log (Xb / X1) := Real.log_pos (by rw [lt_div_iff₀ hX1pos]; linarith)
    have l4 : Real.log (Xb / X1) ≤ Real.log (Xb / X) :=
      Real.log_le_log (div_pos (by linarith) hX1pos) (div_le_div_of_nonneg_left (by linarith) hX0 hX2')
    have q1 : aa / Real.log (X / Xa) ^ 2 ≤ aa / Real.log (Xm / Xa) ^ 2 :=
      div_le_div_of_nonneg_left haa.le (pow_pos l1 2) (pow_le_pow_left₀ l1.le l2 2)
    have q2 : ab / Real.log (Xb / X) ^ 2 ≤ ab / Real.log (Xb / X1) ^ 2 :=
      div_le_div_of_nonneg_left hab.le (pow_pos l3 2) (pow_le_pow_left₀ l3.le l4 2)
    linarith

  intro m
  obtain ⟨ε8, hε8, hR8⟩ := bg_coef_regular h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs
    F U T0th T0z S G W hS hL hB
  obtain ⟨B, hBd⟩ := (hR8 1 le_rfl).2.2.2.2.1 X1 m
  obtain ⟨C3, N3, h3⟩ := hZZe m
  refine ⟨max (max B 0 / c) (max C3 0), max N3 0, ?_⟩
  intro X η hX1' hX2' h1 h2
  have hCnn : 0 ≤ max (max B 0 / c) (max C3 0) := le_max_of_le_right (le_max_right _ _)
  have hew := hew0 X
  have hp1 := hpow_one X (max N3 0) hX1' hX2' (le_max_right _ _)
  have hpn := hpow_nn X (max N3 0) hX1' hX2'
  have hnn : 0 ≤ max (max B 0 / c) (max C3 0) * edgeWeight Xa Xb aa ab X *
      edgeDist Xa Xb X ^ (-max N3 0) := mul_nonneg (mul_nonneg hCnn hew) hpn
  rcases lt_or_ge X Xm with hXm | hXm
  · obtain ⟨z1, z2⟩ := zeroI m X η (by linarith) hXm h1 h2
    rw [z1, z2, norm_zero]
    exact ⟨hnn, hnn⟩
  rcases le_or_gt X X1 with hXX1 | hXX1
  · obtain ⟨b1, b2⟩ := hBd X η (by linarith) hXX1 h1 h2
    have hc1 := hcle X hXm hXX1
    have key : max B 0 ≤ max (max B 0 / c) (max C3 0) * edgeWeight Xa Xb aa ab X *
        edgeDist Xa Xb X ^ (-max N3 0) := by
      calc max B 0 = max B 0 / c * c := (div_mul_cancel₀ _ hcpos.ne').symm
        _ ≤ max (max B 0 / c) (max C3 0) * edgeWeight Xa Xb aa ab X :=
          mul_le_mul (le_max_left _ _) hc1 hcpos.le hCnn
        _ = max (max B 0 / c) (max C3 0) * edgeWeight Xa Xb aa ab X * 1 := (mul_one _).symm
        _ ≤ _ := mul_le_mul_of_nonneg_left hp1 (mul_nonneg hCnn hew)
    exact ⟨b1.trans ((le_max_left _ _).trans key), b2.trans ((le_max_left _ _).trans key)⟩
  · constructor
    · rw [hThnorm m X η (by linarith) h1 h2]
      calc _ ≤ C3 * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N3) := h3 X η hXX1.le hX2' h1 h2
        _ ≤ max C3 0 * edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-N3) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_max_left _ _) hew)
            (hpow_nn X N3 hX1' hX2')
        _ ≤ _ := mul_le_mul (mul_le_mul_of_nonneg_right (le_max_right _ _) hew)
            (hpow_mono X N3 (max N3 0) hX1' hX2' (le_max_left _ _)) (hpow_nn X N3 hX1' hX2')
            (mul_nonneg hCnn hew)
    · rw [zeroZ m X η hXX1 h1 h2, norm_zero]
      exact hnn

theorem bg_res_vanish : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) (S G W : ℕ → ℝ → ℝ → ℝ), SimScaleProps h → LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → Xa < Xm → Xm < Xs → Xs < Xb → BgCoeffSeq h Xm Xs m1 m2 F U S G W → ∀ n : ℕ, 1 ≤ n → ∀ X η : ℝ, -1 < η → η < 1 → (Xb < X ∨ (2 ≤ n ∧ Xs < X)) → bgResTh h S G W n X η = 0 ∧ bgResZ h S G W n X η = 0 :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs F U T0th T0z S G W hS hL hXam hXms
    hXsb hB n hn X η h1 h2 hcase
  unfold BgCoeffSeq at hB
  obtain ⟨⟨hS0, hG0, -⟩, -, -, hBsupp, -⟩ := hB
  unfold LeadingProfile at hL
  obtain ⟨⟨hh0, -, -, hcinf, -, -, -, hXa0, hXap1, hp12, hp2m1, hm12, hm2v, hXvc, hXcb⟩,
    ⟨hFs, -, -, -⟩, -, -, -, -, hL7, hL8, -, -, -⟩ := hL

  have loc : ∀ (a : ℝ) (f : ℝ → ℝ → ℝ), (∀ Y e : ℝ, a < Y → -1 < e → e < 1 → f Y e = 0) →
      ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → pdX f Y e = 0 ∧ pdE f Y e = 0 := by
    intro a f hf Y e hY he1 he2
    constructor
    · unfold pdX
      have hev : (fun Y' => f Y' e) =ᶠ[nhds Y] fun _ => (0:ℝ) := by
        filter_upwards [Ioi_mem_nhds hY] with Y' hY'
        exact hf Y' e hY' he1 he2
      rw [hev.deriv_eq]
      simp
    · unfold pdE
      have hev : (fun e' => f Y e') =ᶠ[nhds e] fun _ => (0:ℝ) := by
        filter_upwards [Ioo_mem_nhds he1 he2] with e' he'
        exact hf Y e' hY he'.1 he'.2
      rw [hev.deriv_eq]
      simp

  have clo : ∀ (a : ℝ) (f : ℝ → ℝ → ℝ), (∀ Y e : ℝ, a < Y → -1 < e → e < 1 → f Y e = 0) →
      (∀ Y e : ℝ, a < Y → -1 < e → e < 1 → pdX f Y e = 0) ∧
      (∀ Y e : ℝ, a < Y → -1 < e → e < 1 → bgUz f Y e = 0) ∧
      (∀ (i : ℕ) (Y e : ℝ), a < Y → -1 < e → e < 1 → bgVx h i f Y e = 0) ∧
      (∀ (b Y e : ℝ), a < Y → -1 < e → e < 1 → simTop h b f Y e = 0) ∧
      (∀ (b Y e : ℝ), a < Y → -1 < e → e < 1 → simZop h b f Y e = 0) := by
    intro a f hf
    refine ⟨fun Y e hY he1 he2 => (loc a f hf Y e hY he1 he2).1, ?_, ?_, ?_, ?_⟩
    · intro Y e hY he1 he2
      simp [bgUz, hf Y e hY he1 he2, (loc a f hf Y e hY he1 he2).1]
    · intro i Y e hY he1 he2
      simp [bgVx, bgUz, hf Y e hY he1 he2, (loc a f hf Y e hY he1 he2).1,
        (loc a f hf Y e hY he1 he2).2]
    · intro b Y e hY he1 he2
      simp [simTop, hf Y e hY he1 he2, (loc a f hf Y e hY he1 he2).1,
        (loc a f hf Y e hY he1 he2).2]
    · intro b Y e hY he1 he2
      simp [simZop, hf Y e hY he1 he2, (loc a f hf Y e hY he1 he2).1,
        (loc a f hf Y e hY he1 he2).2]
  have hXsX : Xs < X := by
    rcases hcase with h' | ⟨_, h'⟩
    · linarith
    · exact h'
  have ZS : ∀ j : ℕ, 1 ≤ j → ∀ Y e : ℝ, Xs < Y → -1 < e → e < 1 → S j Y e = 0 :=
    fun j hj Y e hY _ _ => (hBsupp j hj Y e hY.le).1
  have ZG : ∀ j : ℕ, 1 ≤ j → ∀ Y e : ℝ, Xs < Y → -1 < e → e < 1 → G j Y e = 0 :=
    fun j hj Y e hY _ _ => (hBsupp j hj Y e hY.le).2.1
  have ZW : ∀ j : ℕ, 1 ≤ j → ∀ Y e : ℝ, Xs < Y → -1 < e → e < 1 → W j Y e = 0 :=
    fun j hj Y e hY _ _ => (hBsupp j hj Y e hY.le).2.2

  have hZS0 : ∀ Y e : ℝ, Xv < Y → -1 < e → e < 1 → profRadAvg U Y e = 0 := by
    intro Y e hY he1 he2
    have hY0 : 0 < Y := by linarith
    have h3 : Y * profRadAvg U Y e = profRadInt U Y e := by
      have := intervalIntegral.mul_integral_comp_mul_right (a := 0) (b := 1)
        (f := fun x => U x e) Y
      simpa [profRadAvg, profRadInt] using this
    rw [(hL8 Y e hY.le he1 he2).2] at h3
    rcases mul_eq_zero.mp h3 with h' | h'
    · linarith
    · exact h'
  have hXb0 : 0 < Xb := by linarith
  have hFd : ∀ Y : ℝ, 0 < Y → DifferentiableAt ℝ (fun Y' => F Y' 0) Y := by
    intro Y hY
    have hmem : (Y, (0:ℝ)) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := ⟨hY, by norm_num, by norm_num⟩
    have hopen : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
    have hc := (hFs.contDiffAt (hopen.mem_nhds hmem)).differentiableAt (by simp)
    have h2 : DifferentiableAt ℝ (fun Y' : ℝ => (Y', (0:ℝ))) Y :=
      differentiableAt_id.prodMk (differentiableAt_const _)
    exact DifferentiableAt.comp (g := ↿F) Y hc h2
  have hFeq : ∀ Y e : ℝ, Xb < Y → -1 < e → e < 1 →
      F Y e = cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * heatProfile h (2 * (1 - e ^ 2) / Y) := by
    intro Y e hY he1 he2
    have hY0 : 0 < Y := by linarith
    have hL := (hL7 Y e hY.le he1 he2).2
    have hs2 : 0 < Real.sqrt 2 := by positivity
    have hsY : 0 < Real.sqrt Y := Real.sqrt_pos.mpr hY0
    have hsq : Real.sqrt (2 * Y) = Real.sqrt 2 * Real.sqrt Y := Real.sqrt_mul (by norm_num) Y
    have hpow : Y ^ (-(1 / 2 + h)) = Y ^ (-(1 + h)) * Real.sqrt Y := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_add hY0]
      congr 1
      ring
    rw [hsq, hpow] at hL
    have e1 : F Y e = (Real.sqrt 2 * Real.sqrt Y * F Y e) / (Real.sqrt 2 * Real.sqrt Y) := by
      field_simp
    rw [e1, hL]
    field_simp

  have hHd : ∀ z : ℝ, 0 < z → z < 2 / Xb → DifferentiableAt ℝ (heatProfile h) z := by
    intro z hz hzb
    have h2z : 0 < 2 / z := by positivity
    have hgd : DifferentiableAt ℝ
        (fun w : ℝ => Real.sqrt 2 / cinf * (2 / w) ^ (1 + h) * F (2 / w) 0) z := by
      have hd1 : DifferentiableAt ℝ (fun w : ℝ => 2 / w) z :=
        (differentiableAt_const _).div differentiableAt_id hz.ne'
      have hd2 : DifferentiableAt ℝ (fun w : ℝ => (2 / w) ^ (1 + h)) z :=
        hd1.rpow_const (Or.inl h2z.ne')
      have hd3 : DifferentiableAt ℝ (fun w : ℝ => F (2 / w) 0) z :=
        (hFd (2 / z) h2z).comp z hd1
      exact (hd2.const_mul _).mul hd3
    apply hgd.congr_of_eventuallyEq
    filter_upwards [Ioo_mem_nhds hz hzb] with w hw
    have hw0 : 0 < w := hw.1
    have hY : Xb < 2 / w := by
      rw [lt_div_iff₀ hw0]
      have := (lt_div_iff₀ hXb0).mp hw.2
      linarith
    have hFw := hFeq (2 / w) 0 hY (by norm_num) (by norm_num)
    have harg : 2 * (1 - (0:ℝ) ^ 2) / (2 / w) = w := by
      rw [show (1:ℝ) - 0 ^ 2 = 1 by norm_num]
      field_simp
    rw [harg] at hFw
    rw [hFw]
    have hp : 0 < (2 / w) ^ (1 + h) := Real.rpow_pos_of_pos (by positivity) _
    rw [Real.rpow_neg (by positivity)]
    have hs2 : 0 < Real.sqrt 2 := by positivity
    field_simp
  have hZF : ∀ Y e : ℝ, Xb < Y → -1 < e → e < 1 → simZop h (-(1 + h)) F Y e = 0 := by
    intro Y e hY he1 he2
    have hY0 : 0 < Y := by linarith
    have hd : 0 < 1 - e ^ 2 := by nlinarith
    have hz : 0 < 2 * (1 - e ^ 2) / Y := by positivity
    have hzb : 2 * (1 - e ^ 2) / Y < 2 / Xb := by
      rw [div_lt_div_iff₀ hY0 hXb0]
      have he2' : 0 ≤ e ^ 2 := sq_nonneg e
      nlinarith
    obtain ⟨H', hH⟩ : ∃ H', HasDerivAt (heatProfile h) H' (2 * (1 - e ^ 2) / Y) :=
      ⟨_, (hHd _ hz hzb).hasDerivAt⟩
    have hX1 : HasDerivAt (fun Y' : ℝ => 2 * (1 - e ^ 2) / Y')
        ((0 * Y - 2 * (1 - e ^ 2) * 1) / Y ^ 2) Y :=
      (hasDerivAt_const Y (2 * (1 - e ^ 2))).div (hasDerivAt_id' Y) hY0.ne'
    have hX2 : HasDerivAt (fun Y' : ℝ => Y' ^ (-(1 + h))) (-(1 + h) * Y ^ (-(1 + h) - 1)) Y :=
      Real.hasDerivAt_rpow_const (Or.inl hY0.ne')
    have hXF : HasDerivAt
        (fun Y' : ℝ => cinf / Real.sqrt 2 * Y' ^ (-(1 + h)) * heatProfile h (2 * (1 - e ^ 2) / Y'))
        (cinf / Real.sqrt 2 * (-(1 + h) * Y ^ (-(1 + h) - 1)) * heatProfile h (2 * (1 - e ^ 2) / Y) +
          cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * (H' * ((0 * Y - 2 * (1 - e ^ 2) * 1) / Y ^ 2))) Y :=
      (hX2.const_mul (cinf / Real.sqrt 2)).mul (hH.comp Y hX1)
    have hE1 : HasDerivAt (fun e' : ℝ => 2 * (1 - e' ^ 2) / Y) (-(4 * e) / Y) e := by
      have := (((hasDerivAt_pow 2 e).const_sub 1).const_mul 2).div_const Y
      convert this using 1
      norm_num
      ring
    have hEF : HasDerivAt
        (fun e' : ℝ => cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * heatProfile h (2 * (1 - e' ^ 2) / Y))
        (cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * (H' * (-(4 * e) / Y))) e :=
      (hH.comp e hE1).const_mul _
    have hpdX : pdX F Y e =
        cinf / Real.sqrt 2 * (-(1 + h) * Y ^ (-(1 + h) - 1)) * heatProfile h (2 * (1 - e ^ 2) / Y) +
          cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * (H' * ((0 * Y - 2 * (1 - e ^ 2) * 1) / Y ^ 2)) := by
      unfold pdX
      have hev : (fun Y' => F Y' e) =ᶠ[nhds Y]
          (fun Y' : ℝ => cinf / Real.sqrt 2 * Y' ^ (-(1 + h)) * heatProfile h (2 * (1 - e ^ 2) / Y')) := by
        filter_upwards [Ioi_mem_nhds hY] with Y' hY'
        exact hFeq Y' e hY' he1 he2
      rw [hev.deriv_eq]
      exact hXF.deriv
    have hpdE : pdE F Y e = cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * (H' * (-(4 * e) / Y)) := by
      unfold pdE
      have hev : (fun e' => F Y e') =ᶠ[nhds e]
          (fun e' : ℝ => cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * heatProfile h (2 * (1 - e' ^ 2) / Y)) := by
        filter_upwards [Ioo_mem_nhds he1 he2] with e' he'
        exact hFeq Y e' hY he'.1 he'.2
      rw [hev.deriv_eq]
      exact hEF.deriv
    unfold simZop
    rw [hpdX, hpdE, hFeq Y e hY he1 he2, Real.rpow_sub_one hY0.ne']
    rw [div_eq_zero_iff]
    left
    field_simp
    ring

  have hThfin : simZop h (-(1 + h) + 2 * ((n - 1 : ℕ) : ℝ) * h - (1 / 2 - h))
      (simZop h (-(1 + h) + 2 * ((n - 1 : ℕ) : ℝ) * h) (G (n - 1))) X η = 0 := by
    by_cases h2n : 2 ≤ n
    · have hj : 1 ≤ n - 1 := by omega
      have Z1 := (clo Xs _ (ZG (n - 1) hj)).2.2.2.2 (-(1 + h) + 2 * ((n - 1 : ℕ) : ℝ) * h)
      exact (clo Xs _ Z1).2.2.2.2 _ X η hXsX h1 h2
    · have hX : Xb < X := by
        rcases hcase with h' | ⟨h', _⟩
        · exact h'
        · omega
      have hn1 : n - 1 = 0 := by omega
      have hb : -(1 + h) + 2 * ((n - 1 : ℕ) : ℝ) * h = -(1 + h) := by
        rw [hn1]
        simp
      rw [hb, hn1, hG0]
      exact (clo Xb _ hZF).2.2.2.2 _ X η hX h1 h2
  have hZfin : simZop h (-(1 / 2 + h) + 2 * ((n - 1 : ℕ) : ℝ) * h - (1 / 2 - h))
      (simZop h (-(1 / 2 + h) + 2 * ((n - 1 : ℕ) : ℝ) * h) (bgUz (S (n - 1)))) X η = 0 := by
    by_cases h2n : 2 ≤ n
    · have hj : 1 ≤ n - 1 := by omega
      have Z0 := (clo Xs _ (ZS (n - 1) hj)).2.1
      have Z1 := (clo Xs _ Z0).2.2.2.2 (-(1 / 2 + h) + 2 * ((n - 1 : ℕ) : ℝ) * h)
      exact (clo Xs _ Z1).2.2.2.2 _ X η hXsX h1 h2
    · have hX : Xb < X := by
        rcases hcase with h' | ⟨h', _⟩
        · exact h'
        · omega
      have hn1 : n - 1 = 0 := by omega
      rw [hn1, hS0]
      have Z0 := (clo Xv _ hZS0).2.1
      have Z1 := (clo Xv _ Z0).2.2.2.2 (-(1 / 2 + h) + 2 * ((0 : ℕ) : ℝ) * h)
      exact (clo Xv _ Z1).2.2.2.2 _ X η (by linarith) h1 h2
  have hGn := ZG n hn
  have cG := clo Xs _ hGn
  have cpG := clo Xs _ cG.1
  refine ⟨?_, ?_⟩
  · unfold bgResTh
    rw [if_pos hn, hThfin]
    have hsum : ∑ i ∈ Finset.range (n + 1),
        (bgVx h i (S i) X η * (G (n - i) X η + X * pdX (G (n - i)) X η)
          + bgUz (S i) X η * simZop h (-(1 + h) + 2 * ((n - i : ℕ) : ℝ) * h) (G (n - i)) X η) = 0 := by
      apply Finset.sum_eq_zero
      intro i _
      rcases Nat.eq_zero_or_pos i with hi | hi
      · subst hi
        simp only [Nat.sub_zero]
        rw [hGn X η hXsX h1 h2, cG.1 X η hXsX h1 h2, cG.2.2.2.2 _ X η hXsX h1 h2]
        ring
      · rw [(clo Xs _ (ZS i (by omega))).2.2.1 i X η hXsX h1 h2,
          (clo Xs _ (ZS i (by omega))).2.1 X η hXsX h1 h2]
        ring
    rw [hsum, cG.2.2.2.1 _ X η hXsX h1 h2, cpG.1 X η hXsX h1 h2, cG.1 X η hXsX h1 h2]
    ring
  · unfold bgResZ
    rw [if_pos hn, hZfin]
    have cS := clo Xs _ (ZS n hn)
    have cU := clo Xs _ cS.2.1
    have cpU := clo Xs _ cU.1
    have hsum : ∑ i ∈ Finset.range (n + 1),
        (X * bgVx h i (S i) X η * pdX (bgUz (S (n - i))) X η
          + bgUz (S i) X η * simZop h (-(1 / 2 + h) + 2 * ((n - i : ℕ) : ℝ) * h)
              (bgUz (S (n - i))) X η) = 0 := by
      apply Finset.sum_eq_zero
      intro i _
      rcases Nat.eq_zero_or_pos i with hi | hi
      · subst hi
        simp only [Nat.sub_zero]
        rw [cU.1 X η hXsX h1 h2, cU.2.2.2.2 _ X η hXsX h1 h2]
        ring
      · rw [(clo Xs _ (ZS i (by omega))).2.2.1 i X η hXsX h1 h2,
          (clo Xs _ (ZS i (by omega))).2.1 X η hXsX h1 h2]
        ring
    rw [hsum, cU.2.2.2.1 _ X η hXsX h1 h2, (clo Xs _ (ZW n hn)).2.2.2.2 _ X η hXsX h1 h2,
      cpU.1 X η hXsX h1 h2, cU.1 X η hXsX h1 h2]
    ring

theorem lead_pi_calculus : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ), LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → ∀ η : ℝ, -1 < η → η < 1 → IntegrableOn (fun x => F x η ^ 2) (Ioi 0) ∧ (∀ X : ℝ, 0 ≤ X → leadPi F X η = leadPi F 0 η + profRadInt (fun x e => F x e ^ 2) X η) ∧ ∀ X : ℝ, 0 < X → HasDerivAt (fun Y => leadPi F Y η) (F X η ^ 2) X :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hL η hη1 hη2
  obtain ⟨⟨h0, -, -, -, -, -, -, hXa, hXap1, hp12, hp2m1, hm12, hm2Xv, hXvXc, hXcXb⟩, -, -, -,
    ⟨ε, hε, hFε, -, -, -⟩, -, hL6, -, -, -, -⟩ := hL
  have hXb : 0 < Xb := by linarith

  have hH1 : ∀ Z : ℝ, 0 < Z → heatProfile h Z ^ 2 ≤ 1 := by
    intro Z hZ
    have hG : 0 < Real.Gamma (1 + h) := Real.Gamma_pos_of_pos (by linarith)
    have hconv : IntegrableOn (fun v : ℝ => Real.exp (-v) * v ^ (1 + h - 1)) (Ioi 0) :=
      Real.GammaIntegral_convergent (by linarith)
    have hGeq : Real.Gamma (1 + h) = ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ (1 + h - 1) :=
      Real.Gamma_eq_integral (by linarith)
    have e1 : (1 + h - 1) = h := by ring
    rw [e1] at hconv hGeq
    have hpt0 : ∀ v ∈ Ioi (0:ℝ), 0 ≤ Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h) := by
      intro v hv
      have hv' : (0:ℝ) < v := hv
      have hpos : 0 < 1 + Z * v := by nlinarith
      exact mul_nonneg (mul_nonneg (Real.exp_pos _).le (Real.rpow_nonneg hv'.le _))
        (Real.rpow_nonneg hpos.le _)
    have hpt1 : ∀ v ∈ Ioi (0:ℝ), Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h) ≤
        Real.exp (-v) * v ^ h := by
      intro v hv
      have hv' : (0:ℝ) < v := hv
      have h1 : 1 ≤ 1 + Z * v := by nlinarith
      have h2 : (1 + Z * v) ^ (-h) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos h1 (by linarith)
      have h3 : 0 ≤ Real.exp (-v) * v ^ h :=
        mul_nonneg (Real.exp_pos _).le (Real.rpow_nonneg hv'.le _)
      calc Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h) ≤ Real.exp (-v) * v ^ h * 1 :=
            mul_le_mul_of_nonneg_left h2 h3
        _ = Real.exp (-v) * v ^ h := mul_one _
    have hI0 : 0 ≤ ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h) :=
      setIntegral_nonneg measurableSet_Ioi hpt0
    have hI1 : (∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h)) ≤
        ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ h :=
      integral_mono_of_nonneg (ae_restrict_of_forall_mem measurableSet_Ioi hpt0) hconv
        (ae_restrict_of_forall_mem measurableSet_Ioi hpt1)
    have e : heatProfile h Z = (Real.Gamma (1 + h))⁻¹ *
        ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h) := rfl
    have hp0 : 0 ≤ heatProfile h Z := by
      rw [e]; exact mul_nonneg (inv_nonneg.mpr hG.le) hI0
    have hp1 : heatProfile h Z ≤ 1 := by
      rw [e, inv_mul_le_iff₀ hG, mul_one, hGeq]
      exact hI1
    nlinarith
  have hfc : ContinuousOn (fun x => F x η ^ 2) (Ioi (-ε)) := by
    have h1 : ContinuousOn (fun x => F x η) (Ioi (-ε)) :=
      hFε.continuousOn.comp (Continuous.continuousOn (by fun_prop : Continuous fun x : ℝ => (x, η)))
        (fun x hx => ⟨hx, hη1, hη2⟩)
    exact h1.pow 2
  have hpt : ∀ s : ℝ, Xb ≤ s → F s η ^ 2 =
      cinf ^ 2 / 2 * (s ^ (-(2 + 2 * h)) * heatProfile h (2 * (1 - η ^ 2) / s) ^ 2) := by
    intro s hs
    have hs0 : 0 < s := by linarith
    have hFs := (hL6 s η hs hη1 hη2).2
    have hsq : Real.sqrt (2 * s) ^ 2 = 2 * s := Real.sq_sqrt (by linarith)
    have hpw : s ^ (-(1 / 2 + h)) * s ^ (-(1 / 2 + h)) = s ^ (-(2 + 2 * h)) * s := by
      rw [← Real.rpow_add hs0, ← Real.rpow_add_one hs0.ne']; congr 1; ring
    have h2s : (2:ℝ) * s ≠ 0 := by positivity
    apply mul_left_cancel₀ h2s
    linear_combination (Real.sqrt (2 * s) * F s η +
        cinf * s ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - η ^ 2) / s)) * hFs -
      F s η ^ 2 * hsq + cinf ^ 2 * heatProfile h (2 * (1 - η ^ 2) / s) ^ 2 * hpw
  have hIb : IntegrableOn (fun x => F x η ^ 2) (Ioi Xb) := by
    have hmaj : IntegrableOn (fun s : ℝ => cinf ^ 2 / 2 * s ^ (-(2 + 2 * h))) (Ioi Xb) :=
      Integrable.const_mul (integrableOn_Ioi_rpow_of_lt (by linarith) hXb) _
    refine Integrable.mono' hmaj
      ((hfc.mono (Ioi_subset_Ioi (by linarith))).aestronglyMeasurable measurableSet_Ioi) ?_
    refine ae_restrict_of_forall_mem measurableSet_Ioi (fun s hs => ?_)
    have hs' : Xb < s := hs
    have hs0 : 0 < s := by linarith
    have hsr : 0 ≤ s ^ (-(2 + 2 * h)) := Real.rpow_nonneg hs0.le _
    have hZ : 0 < 2 * (1 - η ^ 2) / s := by
      apply div_pos _ hs0
      nlinarith
    have hH := hH1 _ hZ
    have hc : 0 ≤ cinf ^ 2 / 2 := by positivity
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _), hpt s hs'.le]
    calc cinf ^ 2 / 2 * (s ^ (-(2 + 2 * h)) * heatProfile h (2 * (1 - η ^ 2) / s) ^ 2)
        ≤ cinf ^ 2 / 2 * (s ^ (-(2 + 2 * h)) * 1) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hH hsr) hc
      _ = cinf ^ 2 / 2 * s ^ (-(2 + 2 * h)) := by ring
  have hI0 : IntegrableOn (fun x => F x η ^ 2) (Ioi 0) := by
    rw [← Ioc_union_Ioi_eq_Ioi hXb.le]
    refine IntegrableOn.union ?_ hIb
    have hc2 : ContinuousOn (fun x => F x η ^ 2) (Icc 0 Xb) :=
      hfc.mono (fun x hx => show -ε < x by linarith [hx.1])
    exact hc2.integrableOn_Icc.mono_set Ioc_subset_Icc_self
  have hC2 : ∀ X : ℝ, 0 ≤ X →
      leadPi F X η = leadPi F 0 η + profRadInt (fun x e => F x e ^ 2) X η := by
    intro X hX
    have hIX : IntegrableOn (fun x => F x η ^ 2) (Ioi X) := hI0.mono_set (Ioi_subset_Ioi hX)
    have e2 := intervalIntegral.integral_interval_add_Ioi hI0 hIX
    show -(∫ x in Ioi X, F x η ^ 2) =
      -(∫ x in Ioi (0:ℝ), F x η ^ 2) + ∫ x in (0:ℝ)..X, F x η ^ 2
    linarith
  refine ⟨hI0, hC2, ?_⟩
  intro X hX
  have hII : IntervalIntegrable (fun x => F x η ^ 2) volume 0 X := by
    apply ContinuousOn.intervalIntegrable
    apply hfc.mono
    intro x hx
    rw [mem_uIcc] at hx
    show -ε < x
    rcases hx with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> linarith
  have hXε : X ∈ Ioi (-ε) := show -ε < X by linarith
  have D := intervalIntegral.integral_hasDerivAt_right hII
    (ContinuousOn.stronglyMeasurableAtFilter isOpen_Ioi hfc X hXε)
    (hfc.continuousAt (Ioi_mem_nhds hXε))
  have D2 := D.const_add (leadPi F 0 η)
  refine D2.congr_of_eventuallyEq ?_
  filter_upwards [Ioi_mem_nhds hX] with Y hY
  exact hC2 Y (le_of_lt hY)

theorem bg_lead_th_identity : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) (S G W : ℕ → ℝ → ℝ → ℝ), LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → S 0 = profRadAvg U → G 0 = F → ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → bgResTh h S G W 0 X η = -(deriv (fun Y => T0th Y η) X + T0th X η / X) :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z S G W hL hS0 hG0 X η hX hη1 hη2
  have hL' := hL
  unfold LeadingProfile at hL'
  obtain ⟨⟨hh0, hh1, -⟩, ⟨hFs, -, hFpos, -⟩, -, hT0, ⟨ε, hε, hFe, hUe, hF0pos, -⟩, -⟩ := hL'
  have hηsq : η ^ 2 < 1 := by nlinarith
  have hLpos : 0 < 1 - 2 * h * η ^ 2 := by nlinarith
  have hLne : 1 - 2 * h * η ^ 2 ≠ 0 := hLpos.ne'
  have hF0 : 0 < F X η := hFpos X η hX hη1 hη2
  have hFne : F X η ≠ 0 := hF0.ne'
  have hXne : X ≠ 0 := hX.ne'
  have hFpos' : ∀ Y e : ℝ, 0 ≤ Y → -1 < e → e < 1 → 0 < F Y e := by
    intro Y e hY h1 h2
    rcases hY.lt_or_eq with hY | hY
    · exact hFpos Y e hY h1 h2
    · rw [← hY]; exact hF0pos e h1 h2

  have hUz : bgUz (profRadAvg U) X η = U X η := by
    obtain ⟨hA, -, hA3⟩ := profRadAvg_props U ε hε hUe
    have hmem : (X, η) ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 :=
      ⟨show -ε < X by linarith, hη1, hη2⟩
    have hca := hA.contDiffAt ((isOpen_Ioi.prod isOpen_Ioo).mem_nhds hmem)
    have hin : DifferentiableAt ℝ (fun Y : ℝ => ((Y, η) : ℝ × ℝ)) X :=
      differentiableAt_id.prodMk (differentiableAt_const η)
    have hg : DifferentiableAt ℝ (fun Y => profRadAvg U Y η) X := by
      have hd : DifferentiableAt ℝ (↿(profRadAvg U)) (X, η) := hca.differentiableAt (by norm_num)
      have hc := hd.comp X hin
      exact hc
    have h1 := (hasDerivAt_id' X).mul hg.hasDerivAt
    have h2 := (hA3 X η (by linarith) hη1 hη2).2
    have h3 := h1.unique h2
    unfold bgUz pdX
    linarith

  have hfC : ContDiffOn ℝ ∞ (fun Y => F Y η) (Ioi 0) := by
    have := hFs.comp (contDiffOn_id.prodMk (contDiffOn_const (c := η)))
      (fun Y (hY : Y ∈ Ioi (0:ℝ)) => (⟨hY, hη1, hη2⟩ : ((Y, η) : ℝ × ℝ) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1))
    exact this
  have hgdiff : DifferentiableAt ℝ (fun Y => pdX F Y η) X := by
    have h2 : ContDiffOn ℝ 1 (deriv (fun Y => F Y η)) (Ioi 0) :=
      hfC.deriv_of_isOpen isOpen_Ioi
        (by simp)
    exact (h2.differentiableOn (by norm_num)).differentiableAt (Ioi_mem_nhds hX)
  have hgX : HasDerivAt (fun Y => pdX F Y η) (pdX (pdX F) X η) X := hgdiff.hasDerivAt
  have hP : HasDerivAt (fun Y => Y * (2 * Y * F Y η) * leadQs h F U Y η)
      (2 * X * F X η * axSq h F U X η) X :=
    (ax_source_identity h ε (fun _ => 0) F U hh0 (by linarith) hε hFe hUe hFpos' contDiffOn_const
      X η hX hη1 hη2).1
  have hD : HasDerivAt (fun Y => 2 * Y * (1 - 2 * h * η ^ 2)) (2 * 1 * (1 - 2 * h * η ^ 2)) X :=
    ((hasDerivAt_id' X).const_mul 2).mul_const _
  have hDne : 2 * X * (1 - 2 * h * η ^ 2) ≠ 0 := by positivity
  have hE := (hP.div hD hDne).add (((hasDerivAt_id' X).const_mul 2).mul hgX)
  have hev : (fun Y => T0th Y η) =ᶠ[nhds X] (fun Y => Y * (2 * Y * F Y η) * leadQs h F U Y η /
      (2 * Y * (1 - 2 * h * η ^ 2)) + 2 * Y * pdX F Y η) := by
    filter_upwards [Ioi_mem_nhds hX] with Y hY
    have hY' : (0:ℝ) < Y := hY
    have hYne : Y ≠ 0 := hY'.ne'
    have hFY : F Y η ≠ 0 := (hFpos Y η hY' hη1 hη2).ne'
    rw [(hT0 Y η hY' hη1 hη2).1]
    unfold leadStressTh shearA pdX
    field_simp
    ring
  have hTd := hE.congr_of_eventuallyEq hev
  rw [hTd.deriv, (hT0 X η hX hη1 hη2).1]

  unfold bgResTh
  rw [if_neg (show ¬ (1:ℕ) ≤ 0 by norm_num)]
  simp only [zero_add, Finset.sum_range_one, Nat.sub_self, Nat.cast_zero, mul_zero, zero_mul,
    add_zero, sub_zero, hS0, hG0]
  simp only [simTop, simZop, bgVx, Nat.cast_zero, mul_zero, zero_mul, add_zero]
  rw [hUz]
  simp only [axSq, leadW, profEtaD, pdX, pdE, leadStressTh, shearA]
  field_simp
  ring

theorem bg_lead_z_identity : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) (S G W : ℕ → ℝ → ℝ → ℝ), LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → S 0 = profRadAvg U → W 0 = leadPi F → ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → bgResZ h S G W 0 X η = -(Real.sqrt (2 * X) * (deriv (fun Y => T0z Y η) X + T0z X η / (2 * X))) :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z S G W hL hS0 hW0 X η hX hη1 hη2
  have hL' := hL
  unfold LeadingProfile at hL'
  obtain ⟨⟨hh0, hh1, -⟩, ⟨-, -, hFpos, -⟩, ⟨-, hT0zs, -⟩, hT0eq, ⟨ε, hε, hFs, hUs, hF0, -⟩, -⟩ := hL'
  have hPI := lead_pi_calculus h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hL
  have hASI : AxSourceId := ax_source_identity
  unfold AxSourceId at hASI
  have hASL : AxStressLocal := ax_stress_local
  unfold AxStressLocal at hASL
  obtain ⟨-, hASL2⟩ := hASL

  have hηsq : η ^ 2 < 1 := by nlinarith
  have hhη : h * η ^ 2 < h * 1 := mul_lt_mul_of_pos_left hηsq hh0
  have hLpos : 0 < 1 - 2 * h * η ^ 2 := by nlinarith
  have hLne : 1 - 2 * h * η ^ 2 ≠ 0 := hLpos.ne'

  have hslice : ∀ (f : ℝ → ℝ → ℝ) (a Y e : ℝ), ContDiffOn ℝ ∞ (↿f) (Ioi a ×ˢ Ioo (-1:ℝ) 1) →
      a < Y → -1 < e → e < 1 → DifferentiableAt ℝ (fun Z => f Z e) Y := by
    intro f a Y e hf hY he1 he2
    have hca := hf.contDiffAt ((isOpen_Ioi.prod isOpen_Ioo).mem_nhds
      (show (Y, e) ∈ Ioi a ×ˢ Ioo (-1:ℝ) 1 from ⟨hY, he1, he2⟩))
    have hin : DifferentiableAt ℝ (fun Z : ℝ => ((Z, e) : ℝ × ℝ)) Y :=
      differentiableAt_id.prodMk (differentiableAt_const e)
    exact (hca.differentiableAt (by norm_num)).comp Y hin

  obtain ⟨hS0s, -, hS0d⟩ := profRadAvg_props U ε hε hUs
  have hU0 : ∀ Y e : ℝ, -ε < Y → -1 < e → e < 1 → bgUz (S 0) Y e = U Y e := by
    intro Y e hY he1 he2
    have h1 := (hS0d Y e hY he1 he2).2
    have h2 : HasDerivAt (fun Z => Z * profRadAvg U Z e)
        (1 * profRadAvg U Y e + Y * deriv (fun Z => profRadAvg U Z e) Y) Y :=
      (hasDerivAt_id' Y).mul (hslice (profRadAvg U) (-ε) Y e hS0s hY he1 he2).hasDerivAt
    have h3 := h2.unique h1
    rw [hS0]
    unfold bgUz pdX
    linarith
  have hXε : -ε < X := by linarith

  have hb1 : bgUz (S 0) X η = U X η := hU0 X η hXε hη1 hη2
  have hb2 : ∀ Y : ℝ, -ε < Y → pdX (bgUz (S 0)) Y η = deriv (fun Z => U Z η) Y := by
    intro Y hY
    unfold pdX
    apply Filter.EventuallyEq.deriv_eq
    filter_upwards [Ioi_mem_nhds hY] with Z hZ
    exact hU0 Z η hZ hη1 hη2
  have hb3 : pdE (bgUz (S 0)) X η = deriv (fun e => U X e) η := by
    unfold pdE
    apply Filter.EventuallyEq.deriv_eq
    filter_upwards [Ioo_mem_nhds hη1 hη2] with e he
    exact hU0 X e hXε he.1 he.2
  have hb4 : pdX (pdX (bgUz (S 0))) X η = deriv (fun Y => deriv (fun Z => U Z η) Y) X := by
    show deriv (fun Y => pdX (bgUz (S 0)) Y η) X = _
    apply Filter.EventuallyEq.deriv_eq
    filter_upwards [Ioi_mem_nhds hXε] with Y hY
    exact hb2 Y hY

  have hc1 : pdX (W 0) X η = F X η ^ 2 := by
    unfold pdX
    rw [hW0]
    exact ((hPI η hη1 hη2).2.2 X hX).deriv
  have hc2 : ∀ e : ℝ, -1 < e → e < 1 → W 0 X e = axPi (leadPi F 0) F X e := by
    intro e he1 he2
    rw [hW0]
    exact (hPI e he1 he2).2.1 X hX.le
  have hc3 : pdE (W 0) X η = deriv (fun e => axPi (leadPi F 0) F X e) η := by
    unfold pdE
    apply Filter.EventuallyEq.deriv_eq
    filter_upwards [Ioo_mem_nhds hη1 hη2] with e he
    exact hc2 e he.1 he.2

  have h10 : ¬ ((1:ℕ) ≤ 0) := by norm_num
  have hstar : bgResZ h S G W 0 X η = -(axSn h (leadPi F 0) F U X η / (1 - 2 * h * η ^ 2))
      - 2 * (X * deriv (fun Y => deriv (fun Z => U Z η) Y) X + deriv (fun Y => U Y η) X) := by
    simp only [bgResZ, h10, if_false, Finset.sum_range_one, Nat.sub_self, Nat.cast_zero, mul_zero,
      zero_mul, add_zero, sub_zero, zero_add]
    simp only [simTop, simZop, bgVx]
    rw [hb4, hb2 X hXε, hb3, hb1, hc1, hc2 η hη1 hη2, hc3, hS0]
    simp only [axSn, leadW, pdE, profEtaD, Nat.cast_zero]
    ring

  have hFpos0 : ∀ Y e : ℝ, 0 ≤ Y → -1 < e → e < 1 → 0 < F Y e := by
    intro Y e hY he1 he2
    rcases eq_or_lt_of_le hY with hY0 | hY0
    · rw [← hY0]; exact hF0 e he1 he2
    · exact hFpos Y e hY0 he1 he2
  obtain ⟨ε', hε', hPis, -⟩ :=
    leadPi_smooth_bounds h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hL
  have hPax : ContDiffOn ℝ ∞ (leadPi F 0) (Ioo (-1) 1) := by
    have hm : ContDiffOn ℝ ∞ (fun e : ℝ => ((0 : ℝ), e)) (Ioo (-1) 1) :=
      (contDiff_const.prodMk contDiff_id).contDiffOn
    exact hPis.comp hm (fun e he => ⟨show -ε' < (0:ℝ) by linarith, he⟩)
  have hNs : HasDerivAt (fun Y => Y * axNs h (leadPi F 0) F U Y η) (axSn h (leadPi F 0) F U X η) X :=
    (hASI h ε (leadPi F 0) F U hh0 (by linarith) hε hFs hUs hFpos0 hPax X η hX hη1 hη2).2
  have hloc := hASL2 h (leadPi F 0) F U (fun e he1 he2 => ⟨(hPI e he1 he2).1, rfl⟩)
  have hg : ContDiffOn ℝ ∞ (fun Y => U Y η) (Ioi (-ε)) := by
    have hm : ContDiffOn ℝ ∞ (fun Y : ℝ => ((Y, η) : ℝ × ℝ)) (Ioi (-ε)) :=
      (contDiff_id.prodMk contDiff_const).contDiffOn
    exact hUs.comp hm (fun Y hY => ⟨hY, hη1, hη2⟩)
  have hgd : ContDiffOn ℝ ∞ (deriv (fun Y => U Y η)) (Ioi (-ε)) :=
    hg.deriv_of_isOpen isOpen_Ioi (m := ∞) (by first | exact le_rfl | simp)
  have hU'd : DifferentiableAt ℝ (fun Y => deriv (fun Z => U Z η) Y) X :=
    (ContDiffOn.differentiableOn hgd (by simp)).differentiableAt (Ioi_mem_nhds hXε)
  have hTd : DifferentiableAt ℝ (fun Y => T0z Y η) X := hslice T0z 0 X η hT0zs hX hη1 hη2
  have hR : HasDerivAt (fun Y => Y * axNs h (leadPi F 0) F U Y η / (1 - 2 * h * η ^ 2)
        + 2 * (Y * deriv (fun Z => U Z η) Y))
      (axSn h (leadPi F 0) F U X η / (1 - 2 * h * η ^ 2)
        + 2 * (1 * deriv (fun Z => U Z η) X + X * deriv (fun Y => deriv (fun Z => U Z η) Y) X)) X :=
    (hNs.div_const _).add (((hasDerivAt_id' X).mul hU'd.hasDerivAt).const_mul 2)
  have hsq : HasDerivAt (fun Y => Real.sqrt (2 * Y)) (2 * 1 / (2 * Real.sqrt (2 * X))) X :=
    ((hasDerivAt_id' X).const_mul 2).sqrt (mul_pos two_pos hX).ne'
  have hK : HasDerivAt (fun Y => Real.sqrt (2 * Y) * T0z Y η)
      (2 * 1 / (2 * Real.sqrt (2 * X)) * T0z X η + Real.sqrt (2 * X) * deriv (fun Y => T0z Y η) X) X :=
    hsq.mul hTd.hasDerivAt
  have alg : ∀ s f N V Y L : ℝ, s ≠ 0 → f ≠ 0 → L ≠ 0 →
      s * (f * (Y * N / (L * (s * f)) + s * V / f)) = Y * N / L + (s * s) * V := by
    intro s f N V Y L hs hf hL0
    field_simp <;> ring
  have heq : (fun Y => Real.sqrt (2 * Y) * T0z Y η) =ᶠ[nhds X]
      (fun Y => Y * axNs h (leadPi F 0) F U Y η / (1 - 2 * h * η ^ 2)
        + 2 * (Y * deriv (fun Z => U Z η) Y)) := by
    filter_upwards [Ioi_mem_nhds hX] with Y hY
    have hY' : (0:ℝ) < Y := hY
    rw [(hT0eq Y η hY' hη1 hη2).2]
    unfold leadStressTz shearB
    rw [hloc Y η hY' hη1 hη2]
    have e1 := alg (Real.sqrt (2 * Y)) (F Y η) (axNs h (leadPi F 0) F U Y η)
      (deriv (fun Z => U Z η) Y) Y (1 - 2 * h * η ^ 2) (Real.sqrt_pos.mpr (by linarith)).ne'
      (hFpos Y η hY' hη1 hη2).ne' hLne
    have e2 := Real.mul_self_sqrt (show (0:ℝ) ≤ 2 * Y by linarith)
    linear_combination e1 + deriv (fun Z => U Z η) Y * e2
  have huniq := hK.unique (hR.congr_of_eventuallyEq heq)
  have alg2 : ∀ s T T' Z : ℝ, s ≠ 0 → s * s = 2 * Z →
      s * (T' + T / (2 * Z)) = 2 * 1 / (2 * s) * T + s * T' := by
    intro s T T' Z hs h2
    rw [← h2]
    field_simp <;> ring
  have hrel := alg2 (Real.sqrt (2 * X)) (T0z X η) (deriv (fun Y => T0z Y η) X) X
    (Real.sqrt_pos.mpr (by linarith)).ne' (Real.mul_self_sqrt (by linarith))
  linear_combination hstar + hrel + huniq

theorem sim_profile_closure : ∀ (h ε b : ℝ) (n : ℕ) (f : ℝ → ℝ → ℝ), 0 < h → h < 1 / 2 → 0 < ε → ContDiffOn ℝ ∞ (↿f) (Ioi (-ε) ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿(pdX f)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(pdE f)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(simTop h b f)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(simZop h b f)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(bgUz f)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(bgVx h n f)) (Ioi (-ε) ×ˢ Ioo (-1) 1) :=
by
  intro h ε b n f hh0 hh1 hε hf
  have hΩ : IsOpen (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hD : ContDiffOn ℝ ∞ (fderiv ℝ (↿f)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) :=
    hf.fderiv_of_isOpen hΩ le_rfl
  have hpd : ∀ (v : ℝ × ℝ) (g : ℝ → ℝ → ℝ),
      (∀ X η, ((X, η) : ℝ × ℝ) ∈ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 → g X η = fderiv ℝ (↿f) (X, η) v) →
      ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
    intro v g hgv
    have hDg : ContDiffOn ℝ ∞ ((ContinuousLinearMap.apply ℝ ℝ v) ∘ fderiv ℝ (↿f))
        (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) :=
      (ContinuousLinearMap.apply ℝ ℝ v).contDiff.comp_contDiffOn hD
    refine hDg.congr (fun z hz => ?_)
    have := hgv z.1 z.2 hz
    exact this
  have s4 : ContDiffOn ℝ ∞ (↿(pdX f)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
    refine hpd ((1 : ℝ), (0 : ℝ)) (pdX f) (fun X η hz => ?_)
    have hd : HasFDerivAt (↿f) (fderiv ℝ (↿f) (X, η)) (X, η) :=
      ((hf.contDiffAt (hΩ.mem_nhds hz)).differentiableAt (by norm_num)).hasFDerivAt
    have hc : HasDerivAt (fun Y : ℝ => ((Y, η) : ℝ × ℝ)) ((1 : ℝ), (0 : ℝ)) X :=
      (hasDerivAt_id' X).prodMk (hasDerivAt_const X η)
    exact (hd.comp_hasDerivAt X hc).deriv
  have s5 : ContDiffOn ℝ ∞ (↿(pdE f)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
    refine hpd ((0 : ℝ), (1 : ℝ)) (pdE f) (fun X η hz => ?_)
    have hd : HasFDerivAt (↿f) (fderiv ℝ (↿f) (X, η)) (X, η) :=
      ((hf.contDiffAt (hΩ.mem_nhds hz)).differentiableAt (by norm_num)).hasFDerivAt
    have hc : HasDerivAt (fun e : ℝ => ((X, e) : ℝ × ℝ)) ((0 : ℝ), (1 : ℝ)) η :=
      (hasDerivAt_const η X).prodMk (hasDerivAt_id' η)
    exact (hd.comp_hasDerivAt η hc).deriv
  have hX : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ => z.1) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) :=
    contDiff_fst.contDiffOn
  have hη : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ => z.2) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) :=
    contDiff_snd.contDiffOn
  have hinv : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ => (1 - 2 * h * z.2 ^ 2)⁻¹)
      (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
    refine ((contDiff_const.sub (contDiff_const.mul (contDiff_snd.pow 2))).contDiffOn).inv ?_
    intro w hw
    have h1 : -1 < w.2 := hw.2.1
    have h2 : w.2 < 1 := hw.2.2
    have hη2 : w.2 ^ 2 < 1 := by nlinarith
    have : 0 < 1 - 2 * h * w.2 ^ 2 := by nlinarith
    exact ne_of_gt this
  have s7 : ContDiffOn ℝ ∞ (↿(bgUz f)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
    refine (hf.add (hX.mul s4)).congr (fun z _ => ?_)
    obtain ⟨X, η⟩ := z
    change bgUz f X η = f X η + X * pdX f X η
    rfl
  have s8 : ContDiffOn ℝ ∞ (↿(simTop h b f)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
    refine ((((contDiffOn_const (c := -b)).mul hf).add
      (((contDiffOn_const (c := (1 / 2 - h))).mul hη).mul s5)).add (hX.mul s4)).mul hinv
      |>.congr (fun z _ => ?_)
    obtain ⟨X, η⟩ := z
    change simTop h b f X η = (-b * f X η + (1 / 2 - h) * η * pdE f X η + X * pdX f X η) *
      (1 - 2 * h * η ^ 2)⁻¹
    rw [simTop, div_eq_mul_inv]
  have s9 : ContDiffOn ℝ ∞ (↿(simZop h b f)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
    refine ((((((contDiffOn_const (c := 2 * b)).mul hη).mul hf).add
      (((contDiffOn_const (c := (1 : ℝ))).sub (hη.mul hη)).mul s5)).sub
      ((((contDiffOn_const (c := (2 : ℝ))).mul hη).mul hX).mul s4)).mul hinv)
      |>.congr (fun z _ => ?_)
    obtain ⟨X, η⟩ := z
    change simZop h b f X η = (2 * b * η * f X η + (1 - η * η) * pdE f X η -
      2 * η * X * pdX f X η) * (1 - 2 * h * η ^ 2)⁻¹
    rw [simZop, div_eq_mul_inv]
    ring
  have s10 : ContDiffOn ℝ ∞ (↿(bgVx h n f)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
    refine ((((((contDiffOn_const (c := (2 : ℝ))).mul hη).mul s7).sub
      (((contDiffOn_const (c := 2 * (1 / 2 - h + 2 * (n : ℝ) * h))).mul hη).mul hf)).sub
      (((contDiffOn_const (c := (1 : ℝ))).sub (hη.mul hη)).mul s5)).mul hinv)
      |>.congr (fun z _ => ?_)
    obtain ⟨X, η⟩ := z
    change bgVx h n f X η = (2 * η * bgUz f X η - 2 * (1 / 2 - h + 2 * (n : ℝ) * h) * η * f X η -
      (1 - η * η) * pdE f X η) * (1 - 2 * h * η ^ 2)⁻¹
    rw [bgVx, div_eq_mul_inv]
    ring
  exact ⟨s4, s5, s8, s9, s7, s10⟩

theorem sim_sum_calculus : ∀ (h ε c : ℝ) (N : ℕ) (e : ℕ → ℝ) (f : ℕ → ℝ → ℝ → ℝ), 0 < h → h < 1 / 2 → SimScaleProps h → 0 < ε → (∀ n : ℕ, ContDiffOn ℝ ∞ (↿(f n)) (Ioi (-ε) ×ˢ Ioo (-1) 1)) → ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => simLiftSum h N c e f w.1 w.2.1 w.2.2) (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) ∧ ∀ ρ z s : ℝ, 0 < ρ → s < 1 → cylPs (simLiftSum h N c e f) ρ z s = simLiftSum h N c (fun n => e n - 1) (fun n => simTop h (e n) (f n)) ρ z s ∧ cylPr (simLiftSum h N c e f) ρ z s = simLiftSum h N (c / 2) (fun n => e n - 1) (fun n => pdX (f n)) ρ z s ∧ cylPr (cylPr (simLiftSum h N c e f)) ρ z s = simLiftSum h N (c / 4) (fun n => e n - 1 - 1) (fun n => pdX (pdX (f n))) ρ z s ∧ cylPz (simLiftSum h N c e f) ρ z s = simLiftSum h N c (fun n => e n - (1 / 2 - h)) (fun n => simZop h (e n) (f n)) ρ z s ∧ cylPz (cylPz (simLiftSum h N c e f)) ρ z s = simLiftSum h N c (fun n => e n - (1 / 2 - h) - (1 / 2 - h)) (fun n => simZop h (e n - (1 / 2 - h)) (simZop h (e n) (f n))) ρ z s :=
by
  intro h ε c N e f hh0 hh1 hS hε hf
  have hOo : IsOpen (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo

  have scale : ∀ z τ : ℝ, 0 < τ → 0 < simScale h z τ ∧
      (z * simScale h z τ ^ (-(1 / 2 - h))) ^ 2 < 1 ∧
      simScale h z τ ^ (2 * h - 1) = (simScale h z τ ^ (-(1 / 2 - h))) ^ 2 ∧
      simScale h z τ ^ (2 * h) = simScale h z τ * (simScale h z τ ^ (-(1 / 2 - h))) ^ 2 := by
    intro z τ hτ
    have hq := (hS.1 z τ hτ).1
    have hR4 : simScale h z τ ^ (2 * h - 1) = (simScale h z τ ^ (-(1 / 2 - h))) ^ 2 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hq.le]; congr 1; push_cast; ring
    refine ⟨hq, ?_, hR4, ?_⟩
    · have hz2 := (hS.2.1 z τ hτ).2
      have hprod : simScale h z τ ^ (1 - 2 * h) * simScale h z τ ^ (2 * h - 1) = 1 := by
        rw [← Real.rpow_add hq, show 1 - 2 * h + (2 * h - 1) = (0:ℝ) by ring, Real.rpow_zero]
      rw [mul_pow, ← hR4]
      calc z ^ 2 * simScale h z τ ^ (2 * h - 1)
          < simScale h z τ ^ (1 - 2 * h) * simScale h z τ ^ (2 * h - 1) :=
            mul_lt_mul_of_pos_right hz2 (Real.rpow_pos_of_pos hq _)
        _ = 1 := hprod
    · have e : simScale h z τ ^ (2 * h) = simScale h z τ ^ (1:ℝ) * simScale h z τ ^ (2 * h - 1) := by
        rw [← Real.rpow_add hq]; congr 1; ring
      rw [e, Real.rpow_one, hR4]
  have Lpos : ∀ z τ : ℝ, 0 < τ → 0 < 1 - 2 * h * (z * simScale h z τ ^ (-(1 / 2 - h))) ^ 2 := by
    intro z τ hτ
    obtain ⟨-, hη, -, -⟩ := scale z τ hτ
    have := mul_lt_mul_of_pos_left hη (by linarith : (0:ℝ) < 2 * h)
    linarith
  have qdiff : ∀ z τ : ℝ, 0 < τ →
      DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, τ) := fun z τ hτ =>
    (hS.2.2.2.1.contDiffAt (prod_mem_nhds Filter.univ_mem (Ioi_mem_nhds hτ))).differentiableAt
      (by norm_num)

  have qs : ∀ z s : ℝ, s < 1 → HasDerivAt (fun s' => simScale h z (1 - s'))
      (-1 / (1 - 2 * h * (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) ^ 2)) s := by
    intro z s hs
    have hτ : (0:ℝ) < 1 - s := by linarith
    obtain ⟨hq, -, hR4, -⟩ := scale z (1 - s) hτ
    have hLne := (Lpos z (1 - s) hτ).ne'
    have hl : HasDerivAt (fun s' : ℝ => ((z, 1 - s') : ℝ × ℝ)) ((0:ℝ), (-1:ℝ)) s :=
      (hasDerivAt_const _ _).prodMk ((hasDerivAt_id' s).const_sub 1)
    have hA0 := (qdiff z (1 - s) hτ).hasFDerivAt.comp_hasDerivAt s hl
    obtain ⟨A, hA⟩ : ∃ A, HasDerivAt (fun s' => simScale h z (1 - s')) A s := ⟨_, hA0⟩
    have hk := hA.sub ((hasDerivAt_const s (z ^ 2)).mul (hA.rpow_const (p := 2 * h) (Or.inl hq.ne')))
    have hk2 := hk.congr_of_eventuallyEq (f₁ := fun s' : ℝ => 1 - s') (by
      filter_upwards [Iio_mem_nhds hs] with s' hs'
      exact ((hS.1 z (1 - s') (sub_pos.mpr (show s' < 1 from hs'))).2).symm)
    have hrel := hk2.unique ((hasDerivAt_id' s).const_sub 1)
    rw [hR4] at hrel
    convert hA using 1
    rw [div_eq_iff hLne]
    linear_combination (-1:ℝ) * hrel

  have qz : ∀ z s : ℝ, s < 1 → HasDerivAt (fun w => simScale h w (1 - s))
      (2 * z * simScale h z (1 - s) ^ (2 * h) /
        (1 - 2 * h * (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) ^ 2)) z := by
    intro z s hs
    have hτ : (0:ℝ) < 1 - s := by linarith
    obtain ⟨hq, -, hR4, -⟩ := scale z (1 - s) hτ
    have hLne := (Lpos z (1 - s) hτ).ne'
    have hl : HasDerivAt (fun w : ℝ => ((w, 1 - s) : ℝ × ℝ)) ((1:ℝ), (0:ℝ)) z :=
      (hasDerivAt_id' z).prodMk (hasDerivAt_const _ _)
    have hB0 := (qdiff z (1 - s) hτ).hasFDerivAt.comp_hasDerivAt z hl
    obtain ⟨B, hB⟩ : ∃ B, HasDerivAt (fun w => simScale h w (1 - s)) B z := ⟨_, hB0⟩
    have hk := hB.sub ((hasDerivAt_pow 2 z).mul (hB.rpow_const (p := 2 * h) (Or.inl hq.ne')))
    have hk2 := hk.congr_of_eventuallyEq (f₁ := fun _ : ℝ => 1 - s)
      (Filter.Eventually.of_forall fun w => ((hS.1 w (1 - s) hτ).2).symm)
    have hrel := hk2.unique (hasDerivAt_const z (1 - s))
    rw [hR4] at hrel
    have e21 : z ^ (2 - 1) = z := by norm_num
    rw [e21] at hrel
    simp only [Nat.cast_ofNat] at hrel
    convert hB using 1
    rw [div_eq_iff hLne]
    linear_combination (-1:ℝ) * hrel

  have chain : ∀ (b : ℝ) (g : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
      ∀ (R Zf Q : ℝ → ℝ) (R' Z' Q' u : ℝ), HasDerivAt R R' u → HasDerivAt Zf Z' u →
      HasDerivAt Q Q' u → 0 < Q u → 0 < R u → (Zf u * Q u ^ (-(1 / 2 - h))) ^ 2 < 1 →
      HasDerivAt (fun v => Q v ^ b * g (R v / (2 * Q v)) (Zf v * Q v ^ (-(1 / 2 - h))))
        (Q' * b * Q u ^ (b - 1) * g (R u / (2 * Q u)) (Zf u * Q u ^ (-(1 / 2 - h))) +
          Q u ^ b * (pdX g (R u / (2 * Q u)) (Zf u * Q u ^ (-(1 / 2 - h))) *
              ((R' * (2 * Q u) - R u * (2 * Q')) / (2 * Q u) ^ 2) +
            pdE g (R u / (2 * Q u)) (Zf u * Q u ^ (-(1 / 2 - h))) *
              (Z' * Q u ^ (-(1 / 2 - h)) +
                Zf u * (Q' * (-(1 / 2 - h)) * Q u ^ (-(1 / 2 - h) - 1))))) u := by
    intro b g hg R Zf Q R' Z' Q' u hR hZ hQ hQp hRp hη
    have hmem : (R u / (2 * Q u), Zf u * Q u ^ (-(1 / 2 - h))) ∈ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 := by
      have habs := abs_lt.mp ((sq_lt_one_iff_abs_lt_one _).mp hη)
      have hX0 : 0 < R u / (2 * Q u) := by positivity
      exact ⟨show -ε < R u / (2 * Q u) by linarith, habs.1, habs.2⟩
    obtain ⟨G', hG⟩ : ∃ G', HasFDerivAt (↿g) G' (R u / (2 * Q u), Zf u * Q u ^ (-(1 / 2 - h))) :=
      ⟨_, ((hg.contDiffAt (hOo.mem_nhds hmem)).differentiableAt (by norm_num)).hasFDerivAt⟩
    have hgX : HasDerivAt (fun Y => g Y (Zf u * Q u ^ (-(1 / 2 - h)))) (G' (1, 0))
        (R u / (2 * Q u)) := by
      have hl : HasDerivAt (fun Y : ℝ => (Y, Zf u * Q u ^ (-(1 / 2 - h)))) ((1:ℝ), (0:ℝ))
          (R u / (2 * Q u)) := (hasDerivAt_id' _).prodMk (hasDerivAt_const _ _)
      have := hG.comp_hasDerivAt (R u / (2 * Q u)) hl
      exact this
    have hgE : HasDerivAt (fun e => g (R u / (2 * Q u)) e) (G' (0, 1))
        (Zf u * Q u ^ (-(1 / 2 - h))) := by
      have hl : HasDerivAt (fun e : ℝ => (R u / (2 * Q u), e)) ((0:ℝ), (1:ℝ))
          (Zf u * Q u ^ (-(1 / 2 - h))) := (hasDerivAt_const _ _).prodMk (hasDerivAt_id' _)
      have := hG.comp_hasDerivAt (Zf u * Q u ^ (-(1 / 2 - h))) hl
      exact this
    have hpdX : pdX g (R u / (2 * Q u)) (Zf u * Q u ^ (-(1 / 2 - h))) = G' (1, 0) := hgX.deriv
    have hpdE : pdE g (R u / (2 * Q u)) (Zf u * Q u ^ (-(1 / 2 - h))) = G' (0, 1) := hgE.deriv
    have hQb : HasDerivAt (fun v => Q v ^ b) (Q' * b * Q u ^ (b - 1)) u :=
      hQ.rpow_const (Or.inl hQp.ne')
    have hX : HasDerivAt (fun v => R v / (2 * Q v))
        ((R' * (2 * Q u) - R u * (2 * Q')) / (2 * Q u) ^ 2) u :=
      hR.div (hQ.const_mul 2) (by positivity)
    have hE : HasDerivAt (fun v => Zf v * Q v ^ (-(1 / 2 - h)))
        (Z' * Q u ^ (-(1 / 2 - h)) + Zf u * (Q' * (-(1 / 2 - h)) * Q u ^ (-(1 / 2 - h) - 1))) u :=
      hZ.mul (hQ.rpow_const (Or.inl hQp.ne'))
    have hC : HasDerivAt (fun v => g (R v / (2 * Q v)) (Zf v * Q v ^ (-(1 / 2 - h))))
        (G' ((R' * (2 * Q u) - R u * (2 * Q')) / (2 * Q u) ^ 2,
          Z' * Q u ^ (-(1 / 2 - h)) + Zf u * (Q' * (-(1 / 2 - h)) * Q u ^ (-(1 / 2 - h) - 1)))) u := by
      have := hG.comp_hasDerivAt u (hX.prodMk hE)
      exact this
    have hlin : ∀ a d : ℝ, G' (a, d) = a * G' (1, 0) + d * G' (0, 1) := by
      intro a d
      have e : ((a, d) : ℝ × ℝ) = a • ((1:ℝ), (0:ℝ)) + d • ((0:ℝ), (1:ℝ)) := by ext <;> simp
      rw [e, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
    refine (hQb.mul hC).congr_deriv ?_
    rw [hlin, hpdX, hpdE]
    ring

  have lift_time : ∀ (b : ℝ) (g : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
      ∀ ρ z s : ℝ, 0 < ρ → s < 1 →
      HasDerivAt (fun s' => simLift h b g ρ z s') (simLift h (b - 1) (simTop h b g) ρ z s) s := by
    intro b g hg ρ z s hρ hs
    have hτ : (0:ℝ) < 1 - s := by linarith
    obtain ⟨hq, hη, -, -⟩ := scale z (1 - s) hτ
    have hqne := hq.ne'
    have hLne := (Lpos z (1 - s) hτ).ne'
    have hc := chain b g hg (fun _ => ρ) (fun _ => z) (fun s' => simScale h z (1 - s')) 0 0 _ s
      (hasDerivAt_const _ _) (hasDerivAt_const _ _) (qs z s hs) hq hρ hη
    refine hc.congr_deriv ?_
    simp only [simLift, simTop]
    rw [Real.rpow_sub_one hqne b, Real.rpow_sub_one hqne (-(1 / 2 - h))]
    generalize g (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) = gv
    generalize pdX g (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) = gx
    generalize pdE g (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) = ge
    generalize 1 - 2 * h * (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) ^ 2 = L at hLne ⊢
    generalize simScale h z (1 - s) ^ b = B
    generalize simScale h z (1 - s) ^ (-(1 / 2 - h)) = P
    generalize simScale h z (1 - s) = q at hqne ⊢
    field_simp
    ring

  have lift_rad : ∀ (b : ℝ) (g : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
      ∀ ρ z s : ℝ, 0 < ρ → s < 1 →
      HasDerivAt (fun r => simLift h b g r z s) (1 / 2 * simLift h (b - 1) (pdX g) ρ z s) ρ := by
    intro b g hg ρ z s hρ hs
    have hτ : (0:ℝ) < 1 - s := by linarith
    obtain ⟨hq, hη, -, -⟩ := scale z (1 - s) hτ
    have hqne := hq.ne'
    have hc := chain b g hg (fun r => r) (fun _ => z) (fun _ => simScale h z (1 - s)) 1 0 0 ρ
      (hasDerivAt_id' ρ) (hasDerivAt_const _ _) (hasDerivAt_const _ _) hq hρ hη
    refine hc.congr_deriv ?_
    simp only [simLift]
    rw [Real.rpow_sub_one hqne b, Real.rpow_sub_one hqne (-(1 / 2 - h))]
    generalize g (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) = gv
    generalize pdX g (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) = gx
    generalize pdE g (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) = ge
    generalize simScale h z (1 - s) ^ b = B
    generalize simScale h z (1 - s) ^ (-(1 / 2 - h)) = P
    generalize simScale h z (1 - s) = q at hqne ⊢
    field_simp
    ring

  have lift_axial : ∀ (b : ℝ) (g : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
      ∀ ρ z s : ℝ, 0 < ρ → s < 1 →
      HasDerivAt (fun w => simLift h b g ρ w s)
        (simLift h (b - (1 / 2 - h)) (simZop h b g) ρ z s) z := by
    intro b g hg ρ z s hρ hs
    have hτ : (0:ℝ) < 1 - s := by linarith
    obtain ⟨hq, hη, -, hR5⟩ := scale z (1 - s) hτ
    have hqne := hq.ne'
    have hLne := (Lpos z (1 - s) hτ).ne'
    have hc := chain b g hg (fun _ => ρ) (fun w => w) (fun w => simScale h w (1 - s)) 0 1 _ z
      (hasDerivAt_const _ _) (hasDerivAt_id' z) (qz z s hs) hq hρ hη
    refine hc.congr_deriv ?_
    simp only [simLift, simZop]
    have hbD : simScale h z (1 - s) ^ (b - (1 / 2 - h)) =
        simScale h z (1 - s) ^ b * simScale h z (1 - s) ^ (-(1 / 2 - h)) := by
      rw [← Real.rpow_add hq, ← sub_eq_add_neg]
    rw [hR5, Real.rpow_sub_one hqne b, Real.rpow_sub_one hqne (-(1 / 2 - h)), hbD]
    generalize g (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) = gv
    generalize pdX g (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) = gx
    generalize pdE g (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) = ge
    rw [show (1:ℝ) - (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) ^ 2 =
      (1 - 2 * h * (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) ^ 2) -
        (1 - 2 * h) * (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) ^ 2 by ring]
    generalize 1 - 2 * h * (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) ^ 2 = L at hLne ⊢
    generalize simScale h z (1 - s) ^ b = B
    generalize simScale h z (1 - s) ^ (-(1 / 2 - h)) = P
    generalize simScale h z (1 - s) = q at hqne ⊢
    field_simp
    ring

  have lift_smooth : ∀ (b : ℝ) (g : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => simLift h b g w.1 w.2.1 w.2.2)
        (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) := by
    intro b g hg
    have hQpos : ∀ w ∈ Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ)), 0 < simScale h w.2.1 (1 - w.2.2) :=
      fun w hw => (hS.1 _ _ (sub_pos.mpr (show w.2.2 < 1 from hw.2.2))).1
    have hQ : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => simScale h w.2.1 (1 - w.2.2))
        (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) := by
      have hin : ContDiff ℝ ∞ (fun w : ℝ × ℝ × ℝ => ((w.2.1, 1 - w.2.2) : ℝ × ℝ)) :=
        (contDiff_fst.comp contDiff_snd).prodMk (contDiff_const.sub (contDiff_snd.comp contDiff_snd))
      refine hS.2.2.2.1.comp hin.contDiffOn ?_
      intro w hw
      exact ⟨mem_univ _, sub_pos.mpr (show w.2.2 < 1 from hw.2.2)⟩
    have hQb := hQ.rpow_const_of_ne (p := b) (fun w hw => (hQpos w hw).ne')
    have hP := hQ.rpow_const_of_ne (p := -(1 / 2 - h)) (fun w hw => (hQpos w hw).ne')
    have hX : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => w.1 / (2 * simScale h w.2.1 (1 - w.2.2)))
        (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) :=
      contDiffOn_fst.div (contDiffOn_const.mul hQ) (fun w hw => by
        have := hQpos w hw; positivity)
    have hE : ContDiffOn ℝ ∞
        (fun w : ℝ × ℝ × ℝ => w.2.1 * simScale h w.2.1 (1 - w.2.2) ^ (-(1 / 2 - h)))
        (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) :=
      (contDiff_fst.comp contDiff_snd).contDiffOn.mul hP
    have hmaps : MapsTo (fun w : ℝ × ℝ × ℝ => ((w.1 / (2 * simScale h w.2.1 (1 - w.2.2)),
        w.2.1 * simScale h w.2.1 (1 - w.2.2) ^ (-(1 / 2 - h))) : ℝ × ℝ))
        (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) (Ioi (-ε) ×ˢ Ioo (-1) 1) := by
      intro w hw
      have hτ : 0 < 1 - w.2.2 := sub_pos.mpr (show w.2.2 < 1 from hw.2.2)
      obtain ⟨hq, hη, -, -⟩ := scale w.2.1 (1 - w.2.2) hτ
      have hw1 : 0 < w.1 := hw.1
      have habs := abs_lt.mp ((sq_lt_one_iff_abs_lt_one _).mp hη)
      have hX0 : 0 < w.1 / (2 * simScale h w.2.1 (1 - w.2.2)) := by positivity
      exact ⟨show -ε < w.1 / (2 * simScale h w.2.1 (1 - w.2.2)) by linarith, habs.1, habs.2⟩
    have hcomp := hg.comp (hX.prodMk hE) hmaps
    exact hQb.mul hcomp

  have gen : ∀ (c' : ℝ) (e' : ℕ → ℝ) (f' : ℕ → ℝ → ℝ → ℝ),
      (∀ n, ContDiffOn ℝ ∞ (↿(f' n)) (Ioi (-ε) ×ˢ Ioo (-1) 1)) →
      ∀ ρ z s : ℝ, 0 < ρ → s < 1 →
      cylPs (simLiftSum h N c' e' f') ρ z s =
          simLiftSum h N c' (fun n => e' n - 1) (fun n => simTop h (e' n) (f' n)) ρ z s ∧
        cylPr (simLiftSum h N c' e' f') ρ z s =
          simLiftSum h N (c' / 2) (fun n => e' n - 1) (fun n => pdX (f' n)) ρ z s ∧
        cylPz (simLiftSum h N c' e' f') ρ z s =
          simLiftSum h N c' (fun n => e' n - (1 / 2 - h)) (fun n => simZop h (e' n) (f' n)) ρ z s := by
    intro c' e' f' hf' ρ z s hρ hs
    refine ⟨?_, ?_, ?_⟩
    · unfold cylPs simLiftSum
      exact (HasDerivAt.fun_sum (fun n _ =>
        (lift_time (e' n) (f' n) (hf' n) ρ z s hρ hs).const_mul c')).deriv
    · unfold cylPr simLiftSum
      refine ((HasDerivAt.fun_sum (fun n _ =>
        (lift_rad (e' n) (f' n) (hf' n) ρ z s hρ hs).const_mul c')).deriv).trans ?_
      refine Finset.sum_congr rfl (fun n _ => ?_)
      ring
    · unfold cylPz simLiftSum
      exact (HasDerivAt.fun_sum (fun n _ =>
        (lift_axial (e' n) (f' n) (hf' n) ρ z s hρ hs).const_mul c')).deriv
  refine ⟨?_, ?_⟩
  · show ContDiffOn ℝ ∞
      (fun w : ℝ × ℝ × ℝ => ∑ n ∈ Finset.range (N + 1), c * simLift h (e n) (f n) w.1 w.2.1 w.2.2) _
    exact ContDiffOn.sum (fun n _ => contDiffOn_const.mul (lift_smooth (e n) (f n) (hf n)))
  · intro ρ z s hρ hs
    obtain ⟨d1, d2, d3⟩ := gen c e f hf ρ z s hρ hs

    have closure : ∀ (b : ℝ) (g : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
        ContDiffOn ℝ ∞ (↿(pdX g)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
        ContDiffOn ℝ ∞ (↿(simZop h b g)) (Ioi (-ε) ×ˢ Ioo (-1) 1) := by
      intro b g hg
      have hD : ContDiffOn ℝ ∞ (fderiv ℝ (↿g)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) :=
        hg.fderiv_of_isOpen hOo le_rfl
      have hpd : ∀ (v : ℝ × ℝ) (k : ℝ → ℝ → ℝ),
          (∀ X η, ((X, η) : ℝ × ℝ) ∈ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 → k X η = fderiv ℝ (↿g) (X, η) v) →
          ContDiffOn ℝ ∞ (↿k) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
        intro v k hkv
        have hDg : ContDiffOn ℝ ∞ ((ContinuousLinearMap.apply ℝ ℝ v) ∘ fderiv ℝ (↿g))
            (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) :=
          (ContinuousLinearMap.apply ℝ ℝ v).contDiff.comp_contDiffOn hD
        refine hDg.congr (fun w hw => ?_)
        have := hkv w.1 w.2 hw
        exact this
      have s4 : ContDiffOn ℝ ∞ (↿(pdX g)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
        refine hpd ((1 : ℝ), (0 : ℝ)) (pdX g) (fun X η hz => ?_)
        have hd : HasFDerivAt (↿g) (fderiv ℝ (↿g) (X, η)) (X, η) :=
          ((hg.contDiffAt (hOo.mem_nhds hz)).differentiableAt (by norm_num)).hasFDerivAt
        have hc : HasDerivAt (fun Y : ℝ => ((Y, η) : ℝ × ℝ)) ((1 : ℝ), (0 : ℝ)) X :=
          (hasDerivAt_id' X).prodMk (hasDerivAt_const X η)
        exact (hd.comp_hasDerivAt X hc).deriv
      have s5 : ContDiffOn ℝ ∞ (↿(pdE g)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
        refine hpd ((0 : ℝ), (1 : ℝ)) (pdE g) (fun X η hz => ?_)
        have hd : HasFDerivAt (↿g) (fderiv ℝ (↿g) (X, η)) (X, η) :=
          ((hg.contDiffAt (hOo.mem_nhds hz)).differentiableAt (by norm_num)).hasFDerivAt
        have hc : HasDerivAt (fun e : ℝ => ((X, e) : ℝ × ℝ)) ((0 : ℝ), (1 : ℝ)) η :=
          (hasDerivAt_const η X).prodMk (hasDerivAt_id' η)
        exact (hd.comp_hasDerivAt η hc).deriv
      have hX : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => w.1) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) :=
        contDiff_fst.contDiffOn
      have hη : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => w.2) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) :=
        contDiff_snd.contDiffOn
      have hinv : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => (1 - 2 * h * w.2 ^ 2)⁻¹)
          (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
        refine ((contDiff_const.sub (contDiff_const.mul (contDiff_snd.pow 2))).contDiffOn).inv ?_
        intro w hw
        have h1 : -1 < w.2 := hw.2.1
        have h2 : w.2 < 1 := hw.2.2
        have hη2 : w.2 ^ 2 < 1 := by nlinarith
        have : 0 < 1 - 2 * h * w.2 ^ 2 := by nlinarith
        exact ne_of_gt this
      have s9 : ContDiffOn ℝ ∞ (↿(simZop h b g)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
        refine ((((((contDiffOn_const (c := 2 * b)).mul hη).mul hg).add
          (((contDiffOn_const (c := (1 : ℝ))).sub (hη.mul hη)).mul s5)).sub
          ((((contDiffOn_const (c := (2 : ℝ))).mul hη).mul hX).mul s4)).mul hinv)
          |>.congr (fun w _ => ?_)
        obtain ⟨X, η⟩ := w
        change simZop h b g X η = (2 * b * η * g X η + (1 - η * η) * pdE g X η -
          2 * η * X * pdX g X η) * (1 - 2 * h * η ^ 2)⁻¹
        rw [simZop, div_eq_mul_inv]
        ring
      exact ⟨s4, s9⟩
    have hpdXf : ∀ n, ContDiffOn ℝ ∞ (↿(pdX (f n))) (Ioi (-ε) ×ˢ Ioo (-1) 1) := fun n =>
      (closure 0 (f n) (hf n)).1
    have hZf : ∀ n, ContDiffOn ℝ ∞ (↿(simZop h (e n) (f n))) (Ioi (-ε) ×ˢ Ioo (-1) 1) := fun n =>
      (closure (e n) (f n) (hf n)).2
    refine ⟨d1, d2, ?_, d3, ?_⟩
    · have hev : (fun r => cylPr (simLiftSum h N c e f) r z s) =ᶠ[nhds ρ]
          (fun r => simLiftSum h N (c / 2) (fun n => e n - 1) (fun n => pdX (f n)) r z s) := by
        filter_upwards [Ioi_mem_nhds hρ] with r hr
        exact (gen c e f hf r z s hr hs).2.1
      show deriv (fun r => cylPr (simLiftSum h N c e f) r z s) ρ = _
      rw [hev.deriv_eq, show c / 4 = c / 2 / 2 by ring]
      exact (gen (c / 2) (fun n => e n - 1) (fun n => pdX (f n)) hpdXf ρ z s hρ hs).2.1
    · have hfun : (fun w => cylPz (simLiftSum h N c e f) ρ w s) =
          (fun w => simLiftSum h N c (fun n => e n - (1 / 2 - h))
            (fun n => simZop h (e n) (f n)) ρ w s) := by
        funext w
        exact (gen c e f hf ρ w s hρ hs).2.2
      show deriv (fun w => cylPz (simLiftSum h N c e f) ρ w s) z = _
      rw [hfun]
      exact (gen c (fun n => e n - (1 / 2 - h)) (fun n => simZop h (e n) (f n)) hZf ρ z s hρ hs).2.2

theorem bg_velocity_frame : ∀ (h ε : ℝ) (N : ℕ) (S : ℕ → ℝ → ℝ → ℝ), 0 < h → h < 1 / 2 → SimScaleProps h → 0 < ε → (∀ n : ℕ, ContDiffOn ℝ ∞ (↿(S n)) (Ioi (-ε) ×ˢ Ioo (-1) 1)) → ∀ (y : ℝ³) (s : ℝ), s < 1 → 0 < y 0 ^ 2 + y 1 ^ 2 → curl3 (fun w => ∑ n ∈ Finset.range (N + 1), bgAn h n (S n) w s) y = simLiftSum h N (1 / 2) (fun n : ℕ => -1 + 2 * (n : ℝ) * h) (fun n => bgVx h n (S n)) (y 0 ^ 2 + y 1 ^ 2) (y 2) s • radVec y + simLiftSum h N 1 (fun n : ℕ => -(1 / 2 + h) + 2 * (n : ℝ) * h) (fun n => bgUz (S n)) (y 0 ^ 2 + y 1 ^ 2) (y 2) s • EuclideanSpace.single (2 : Fin 3) (1 : ℝ) :=
by
  intro h ε N S hh0 hh1 hS hε hSm y s hs hy
  have hq : 0 < simScale h (y 2) (1 - s) := (hS.1 (y 2) (1 - s) (by linarith)).1
  have hρ : (0 : ℝ) < y 0 ^ 2 + y 1 ^ 2 := hy

  have hdiff : ∀ n : ℕ, DifferentiableAt ℝ (fun w => bgAn h n (S n) w s) y := by
    intro n
    have hsub : Ici (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi (-ε) ×ˢ Ioo (-1) 1 :=
      prod_mono (fun x hx => by simp only [mem_Ici] at hx; simp only [mem_Ioi]; linarith)
        subset_rfl
    have hsm := (bg_field_smooth_div h n (S n) hS ((hSm n).mono hsub)).1
    have hO : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
    have hca : ContDiffAt ℝ ∞ (↿(bgAn h n (S n))) (y, s) :=
      hsm.contDiffAt (hO.mem_nhds (show (y, s) ∈ {w : ℝ³ × ℝ | w.2 < 1} from hs))
    have hc := hca.comp y ((contDiff_id.prodMk contDiff_const).contDiffAt)
    exact hc.differentiableAt (by norm_num)

  have hadd : ∀ (f g : ℝ³ → ℝ³), DifferentiableAt ℝ f y → DifferentiableAt ℝ g y →
      curl3 (fun w => f w + g w) y = curl3 f y + curl3 g y := by
    intro f g hf hg
    simp only [curl3, fderiv_fun_add hf hg, ContinuousLinearMap.add_apply, PiLp.add_apply]
    module
  have hsum : ∀ (t : Finset ℕ), curl3 (fun w => ∑ n ∈ t, bgAn h n (S n) w s) y =
      ∑ n ∈ t, curl3 (fun w => bgAn h n (S n) w s) y := by
    intro t
    induction t using Finset.induction_on with
    | empty => simp [curl3]
    | @insert a t ha ih =>
      have hd : DifferentiableAt ℝ (fun w => ∑ n ∈ t, bgAn h n (S n) w s) y :=
        DifferentiableAt.fun_sum (fun n _ => hdiff n)
      simp only [Finset.sum_insert ha]
      rw [hadd (fun w => bgAn h a (S a) w s) (fun w => ∑ n ∈ t, bgAn h n (S n) w s) (hdiff a) hd,
        ih]

  have key : ∀ n : ℕ, curl3 (fun w => bgAn h n (S n) w s) y =
      (1 / 2 * simLift h (-1 + 2 * (n : ℝ) * h) (bgVx h n (S n)) (y 0 ^ 2 + y 1 ^ 2) (y 2) s) •
          radVec y +
      (1 * simLift h (-(1 / 2 + h) + 2 * (n : ℝ) * h) (bgUz (S n)) (y 0 ^ 2 + y 1 ^ 2) (y 2) s) •
        EuclideanSpace.single (2 : Fin 3) (1 : ℝ) := by
    intro n
    obtain ⟨h1, h2, h3⟩ := bgAn_curl_identities h ε n (S n) hh0 hh1 hS hε (hSm n) y s hs hy
    have hL1 : simLift h (-1 + 2 * (n : ℝ) * h) (bgVx h n (S n)) (y 0 ^ 2 + y 1 ^ 2) (y 2) s =
        simScale h (y 2) (1 - s) ^ (-1 + 2 * (n : ℝ) * h) *
          bgVx h n (S n) (simX h y s) (simEta h y s) := rfl
    have hL2 : simLift h (-(1 / 2 + h) + 2 * (n : ℝ) * h) (bgUz (S n)) (y 0 ^ 2 + y 1 ^ 2) (y 2) s =
        simScale h (y 2) (1 - s) ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) *
          bgUz (S n) (simX h y s) (simEta h y s) := rfl
    have hX : simX h y s = (y 0 ^ 2 + y 1 ^ 2) / (2 * simScale h (y 2) (1 - s)) := rfl
    rw [hL1, hL2]
    have hc0 : 1 / 2 * (simScale h (y 2) (1 - s) ^ (-1 + 2 * (n : ℝ) * h) *
          bgVx h n (S n) (simX h y s) (simEta h y s)) * (y 0 ^ 2 + y 1 ^ 2) =
        simScale h (y 2) (1 - s) ^ (2 * (n : ℝ) * h) *
          (simX h y s * bgVx h n (S n) (simX h y s) (simEta h y s)) := by
      generalize bgVx h n (S n) (simX h y s) (simEta h y s) = V
      have hqne : simScale h (y 2) (1 - s) ≠ 0 := hq.ne'
      rw [hX, Real.rpow_add hq, Real.rpow_neg_one]
      field_simp
    generalize curl3 (fun w => bgAn h n (S n) w s) y = v at h1 h2 h3 ⊢
    generalize 1 / 2 * (simScale h (y 2) (1 - s) ^ (-1 + 2 * (n : ℝ) * h) *
          bgVx h n (S n) (simX h y s) (simEta h y s)) = c0 at hc0 ⊢
    generalize simScale h (y 2) (1 - s) ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) *
          bgUz (S n) (simX h y s) (simEta h y s) = g at h1 ⊢
    generalize simScale h (y 2) (1 - s) ^ (2 * (n : ℝ) * h) *
          (simX h y s * bgVx h n (S n) (simX h y s) (simEta h y s)) = R at h2 hc0
    have i2 : v 0 * y 0 + v 1 * y 1 = R := by
      rw [← h2]
      simp only [radVec, inner_add_right, inner_smul_right, EuclideanSpace.inner_single_right,
        conj_trivial, one_mul]
      ring
    have i3 : y 0 * v 1 - y 1 * v 0 = 0 := by
      rw [← h3]
      simp only [azVec, inner_add_right, inner_smul_right, EuclideanSpace.inner_single_right,
        conj_trivial, one_mul]
      ring
    have e0 : v 0 = c0 * y 0 := by
      have hm : (v 0 - c0 * y 0) * (y 0 ^ 2 + y 1 ^ 2) = 0 := by
        linear_combination y 0 * i2 - y 1 * i3 - y 0 * hc0
      rcases mul_eq_zero.mp hm with hm | hm
      · linarith
      · linarith
    have e1 : v 1 = c0 * y 1 := by
      have hm : (v 1 - c0 * y 1) * (y 0 ^ 2 + y 1 ^ 2) = 0 := by
        linear_combination y 1 * i2 + y 0 * i3 - y 1 * hc0
      rcases mul_eq_zero.mp hm with hm | hm
      · linarith
      · linarith
    ext i
    fin_cases i
    · simp [radVec, e0]
    · simp [radVec, e1]
    · simp [radVec, h1]
  rw [hsum, Finset.sum_congr rfl (fun n _ => key n), Finset.sum_add_distrib, ← Finset.sum_smul,
    ← Finset.sum_smul]
  rfl

theorem axisym_frame_residual : ∀ (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (α β γ P : ℝ → ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => α w.1 w.2.1 w.2.2) (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) → ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => β w.1 w.2.1 w.2.2) (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) → ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => γ w.1 w.2.1 w.2.2) (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) → ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => P w.1 w.2.1 w.2.2) (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) → (∀ (y : ℝ³) (s : ℝ), s < 1 → 0 < y 0 ^ 2 + y 1 ^ 2 → u y s = α (y 0 ^ 2 + y 1 ^ 2) (y 2) s • radVec y + β (y 0 ^ 2 + y 1 ^ 2) (y 2) s • azVec y + γ (y 0 ^ 2 + y 1 ^ 2) (y 2) s • EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) → (∀ (y : ℝ³) (s : ℝ), s < 1 → 0 < y 0 ^ 2 + y 1 ^ 2 → p y s = P (y 0 ^ 2 + y 1 ^ 2) (y 2) s) → ∀ (x : ℝ³) (t : ℝ), t < 1 → 0 < x 0 ^ 2 + x 1 ^ 2 → nsResidual 1 u p x t = frRadV (x 0 ^ 2 + x 1 ^ 2) (α (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPs α (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPr α (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPr (cylPr α) (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPz α (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPz (cylPz α) (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (β (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (γ (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPr P (x 0 ^ 2 + x 1 ^ 2) (x 2) t) • radVec x + frThV (x 0 ^ 2 + x 1 ^ 2) (α (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (β (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPs β (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPr β (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPr (cylPr β) (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPz β (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPz (cylPz β) (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (γ (x 0 ^ 2 + x 1 ^ 2) (x 2) t) • azVec x + frZV (x 0 ^ 2 + x 1 ^ 2) (α (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (γ (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPs γ (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPr γ (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPr (cylPr γ) (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPz γ (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPz (cylPz γ) (x 0 ^ 2 + x 1 ^ 2) (x 2) t) (cylPz P (x 0 ^ 2 + x 1 ^ 2) (x 2) t) • EuclideanSpace.single (2 : Fin 3) (1 : ℝ) :=
by
  intro u p α β γ P hα hβ hγ hP hu hp x t ht hx
  have hΩo : IsOpen (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) :=
    (isOpen_Ioi (a := (0 : ℝ))).prod ((isOpen_univ (X := ℝ)).prod (isOpen_Iio (a := (1 : ℝ))))

  have hpj : ∀ (i : Fin 3) (v : ℝ³), (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ) v = v i := fun i v => rfl
  have hc : ∀ (i : Fin 3) (y : ℝ³), HasFDerivAt (fun w : ℝ³ => w i)
      (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ) y := fun i y => PiLp.hasFDerivAt_apply 2 y i
  obtain ⟨Dσ, hDσ⟩ : ∃ D : ℝ³ → (ℝ³ →L[ℝ] ℝ), ∀ y v, D y v = 2 * y 0 * v 0 + 2 * y 1 * v 1 :=
    ⟨fun y => (2 * y 0) • (EuclideanSpace.proj 0 : ℝ³ →L[ℝ] ℝ) +
        (2 * y 1) • (EuclideanSpace.proj 1 : ℝ³ →L[ℝ] ℝ),
      fun y v => by simp [hpj]; try ring⟩
  have hσ : ∀ y : ℝ³, HasFDerivAt (fun w : ℝ³ => w 0 ^ 2 + w 1 ^ 2) (Dσ y) y := by
    intro y
    have h := ((hc 0 y).pow 2).add ((hc 1 y).pow 2)
    convert h using 1
    refine ContinuousLinearMap.ext fun v => ?_
    rw [hDσ]; simp [hpj]; try ring
  have hΨ : ∀ (y : ℝ³) (s : ℝ), HasFDerivAt (fun w : ℝ³ => ((w 0 ^ 2 + w 1 ^ 2, w 2, s) : ℝ × ℝ × ℝ))
      ((Dσ y).prod ((EuclideanSpace.proj 2 : ℝ³ →L[ℝ] ℝ).prod (0 : ℝ³ →L[ℝ] ℝ))) y :=
    fun y s => (hσ y).prodMk ((hc 2 y).prodMk (hasFDerivAt_const s y))

  have slice : ∀ g : ℝ → ℝ → ℝ → ℝ,
      ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) →
      ∀ ρ z s : ℝ, 0 < ρ → s < 1 →
      HasFDerivAt (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2)
        (fderiv ℝ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (ρ, z, s)) (ρ, z, s) ∧
      cylPr g ρ z s = fderiv ℝ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (ρ, z, s) (1, 0, 0) ∧
      cylPz g ρ z s = fderiv ℝ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (ρ, z, s) (0, 1, 0) ∧
      HasDerivAt (fun s' => g ρ z s') (cylPs g ρ z s) s := by
    intro g hg ρ z s hρ hs
    have hmem : ((ρ, z, s) : ℝ × ℝ × ℝ) ∈ Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ)) :=
      ⟨hρ, mem_univ _, hs⟩
    have hD : HasFDerivAt (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2)
        (fderiv ℝ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (ρ, z, s)) (ρ, z, s) :=
      ((hg.contDiffAt (hΩo.mem_nhds hmem)).differentiableAt (by simp)).hasFDerivAt
    have k1 : HasDerivAt (fun r : ℝ => g r z s)
        (fderiv ℝ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (ρ, z, s) (1, 0, 0)) ρ := by
      have hf : HasDerivAt (fun r : ℝ => ((r, z, s) : ℝ × ℝ × ℝ)) ((1 : ℝ), (0 : ℝ), (0 : ℝ)) ρ :=
        (hasDerivAt_id' ρ).prodMk ((hasDerivAt_const ρ z).prodMk (hasDerivAt_const ρ s))
      have := hD.comp_hasDerivAt ρ hf
      exact this
    have k2 : HasDerivAt (fun r : ℝ => g ρ r s)
        (fderiv ℝ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (ρ, z, s) (0, 1, 0)) z := by
      have hf : HasDerivAt (fun r : ℝ => ((ρ, r, s) : ℝ × ℝ × ℝ)) ((0 : ℝ), (1 : ℝ), (0 : ℝ)) z :=
        (hasDerivAt_const z ρ).prodMk ((hasDerivAt_id' z).prodMk (hasDerivAt_const z s))
      have := hD.comp_hasDerivAt z hf
      exact this
    have k3 : HasDerivAt (fun r : ℝ => g ρ z r)
        (fderiv ℝ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (ρ, z, s) (0, 0, 1)) s := by
      have hf : HasDerivAt (fun r : ℝ => ((ρ, z, r) : ℝ × ℝ × ℝ)) ((0 : ℝ), (0 : ℝ), (1 : ℝ)) s :=
        (hasDerivAt_const s ρ).prodMk ((hasDerivAt_const s z).prodMk (hasDerivAt_id' s))
      have := hD.comp_hasDerivAt s hf
      exact this
    refine ⟨hD, k1.deriv, k2.deriv, ?_⟩
    have e3 : cylPs g ρ z s = fderiv ℝ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (ρ, z, s) (0, 0, 1) :=
      k3.deriv
    rw [e3]; exact k3

  have cylsm : ∀ g : ℝ → ℝ → ℝ → ℝ,
      ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) →
      ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => cylPr g w.1 w.2.1 w.2.2) (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) ∧
      ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => cylPz g w.1 w.2.1 w.2.2) (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) := by
    intro g hg
    have hdf : ContDiffOn ℝ ∞ (fderiv ℝ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2))
        (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) :=
      hg.fderiv_of_isOpen hΩo (by simp)
    constructor
    · refine (hdf.clm_apply (contDiffOn_const (c := ((1 : ℝ), (0 : ℝ), (0 : ℝ))))).congr ?_
      rintro ⟨ρ, z, s⟩ ⟨hρ, -, hs⟩
      exact (slice g hg ρ z s hρ hs).2.1
    · refine (hdf.clm_apply (contDiffOn_const (c := ((0 : ℝ), (1 : ℝ), (0 : ℝ))))).congr ?_
      rintro ⟨ρ, z, s⟩ ⟨hρ, -, hs⟩
      exact (slice g hg ρ z s hρ hs).2.2.1

  have lift : ∀ g : ℝ → ℝ → ℝ → ℝ,
      ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) →
      ∀ (y : ℝ³) (s : ℝ), 0 < y 0 ^ 2 + y 1 ^ 2 → s < 1 →
      ContDiffAt ℝ ∞ (fun w : ℝ³ => g (w 0 ^ 2 + w 1 ^ 2) (w 2) s) y ∧
      ∀ v : ℝ³, fderiv ℝ (fun w : ℝ³ => g (w 0 ^ 2 + w 1 ^ 2) (w 2) s) y v =
        2 * cylPr g (y 0 ^ 2 + y 1 ^ 2) (y 2) s * (y 0 * v 0 + y 1 * v 1) +
          cylPz g (y 0 ^ 2 + y 1 ^ 2) (y 2) s * v 2 := by
    intro g hg y s hy hs
    have hmem : ((y 0 ^ 2 + y 1 ^ 2, y 2, s) : ℝ × ℝ × ℝ) ∈ Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ)) :=
      ⟨hy, mem_univ _, hs⟩
    have hGa : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (y 0 ^ 2 + y 1 ^ 2, y 2, s) :=
      hg.contDiffAt (hΩo.mem_nhds hmem)
    have hΨs : ContDiff ℝ ∞ (fun w : ℝ³ => ((w 0 ^ 2 + w 1 ^ 2, w 2, s) : ℝ × ℝ × ℝ)) := by fun_prop
    have hcd := hGa.comp y hΨs.contDiffAt
    refine ⟨hcd, fun v => ?_⟩
    obtain ⟨hD, e1, e2, -⟩ := slice g hg _ (y 2) s hy hs
    have hcomp : HasFDerivAt (fun w : ℝ³ => g (w 0 ^ 2 + w 1 ^ 2) (w 2) s)
        ((fderiv ℝ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (y 0 ^ 2 + y 1 ^ 2, y 2, s)).comp
          ((Dσ y).prod ((EuclideanSpace.proj 2 : ℝ³ →L[ℝ] ℝ).prod (0 : ℝ³ →L[ℝ] ℝ)))) y := by
      have := hD.comp y (hΨ y s)
      exact this
    have hv : ((Dσ y).prod ((EuclideanSpace.proj 2 : ℝ³ →L[ℝ] ℝ).prod (0 : ℝ³ →L[ℝ] ℝ))) v =
        (2 * (y 0 * v 0 + y 1 * v 1)) • ((1 : ℝ), (0 : ℝ), (0 : ℝ)) + v 2 • ((0 : ℝ), (1 : ℝ), (0 : ℝ)) := by
      refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp [hDσ, hpj] <;> ring
    rw [hcomp.fderiv, ContinuousLinearMap.comp_apply, hv, map_add, map_smul, map_smul,
      smul_eq_mul, smul_eq_mul, ← e1, ← e2]
    ring

  have hess : ∀ g : ℝ → ℝ → ℝ → ℝ,
      ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => g w.1 w.2.1 w.2.2) (Ioi (0 : ℝ) ×ˢ (univ ×ˢ Iio (1 : ℝ))) →
      ∀ (y : ℝ³) (s : ℝ), 0 < y 0 ^ 2 + y 1 ^ 2 → s < 1 → ∀ v : ℝ³,
      fderiv ℝ (fun w : ℝ³ => fderiv ℝ (fun w' : ℝ³ => g (w' 0 ^ 2 + w' 1 ^ 2) (w' 2) s) w v) y v =
        2 * (2 * cylPr (cylPr g) (y 0 ^ 2 + y 1 ^ 2) (y 2) s * (y 0 * v 0 + y 1 * v 1) +
            cylPz (cylPr g) (y 0 ^ 2 + y 1 ^ 2) (y 2) s * v 2) * (y 0 * v 0 + y 1 * v 1) +
          2 * cylPr g (y 0 ^ 2 + y 1 ^ 2) (y 2) s * (v 0 * v 0 + v 1 * v 1) +
          (2 * cylPr (cylPz g) (y 0 ^ 2 + y 1 ^ 2) (y 2) s * (y 0 * v 0 + y 1 * v 1) +
            cylPz (cylPz g) (y 0 ^ 2 + y 1 ^ 2) (y 2) s * v 2) * v 2 := by
    intro g hg y s hy hs v
    obtain ⟨h1sm, h2sm⟩ := cylsm g hg
    have hUy : {w : ℝ³ | 0 < w 0 ^ 2 + w 1 ^ 2} ∈ nhds y :=
      (isOpen_lt continuous_const (by fun_prop)).mem_nhds hy
    have hev : (fun w : ℝ³ => fderiv ℝ (fun w' : ℝ³ => g (w' 0 ^ 2 + w' 1 ^ 2) (w' 2) s) w v) =ᶠ[nhds y]
        fun w => 2 * cylPr g (w 0 ^ 2 + w 1 ^ 2) (w 2) s * (w 0 * v 0 + w 1 * v 1) +
          cylPz g (w 0 ^ 2 + w 1 ^ 2) (w 2) s * v 2 := by
      filter_upwards [hUy] with w hw
      exact (lift g hg w s hw hs).2 v
    obtain ⟨d1, f1⟩ := lift (cylPr g) h1sm y s hy hs
    obtain ⟨d2, f2⟩ := lift (cylPz g) h2sm y s hy hs
    have hlin : HasFDerivAt (fun w : ℝ³ => w 0 * v 0 + w 1 * v 1)
        (v 0 • (EuclideanSpace.proj 0 : ℝ³ →L[ℝ] ℝ) + v 1 • (EuclideanSpace.proj 1 : ℝ³ →L[ℝ] ℝ)) y :=
      ((hc 0 y).mul_const (v 0)).add ((hc 1 y).mul_const (v 1))
    have H := ((((d1.differentiableAt (by simp)).hasFDerivAt.const_mul (2 : ℝ)).mul hlin).add
      ((d2.differentiableAt (by simp)).hasFDerivAt.mul_const (v 2))).congr_of_eventuallyEq hev
    rw [H.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul, f1, f2, hpj]
    ring

  obtain ⟨Lr, hLr⟩ : ∃ L : ℝ³ →L[ℝ] ℝ³, ∀ v, L v = radVec v :=
    ⟨(EuclideanSpace.proj 0 : ℝ³ →L[ℝ] ℝ).smulRight (EuclideanSpace.single (0 : Fin 3) (1:ℝ)) +
      (EuclideanSpace.proj 1 : ℝ³ →L[ℝ] ℝ).smulRight (EuclideanSpace.single (1 : Fin 3) (1:ℝ)),
      fun v => by simp [radVec, hpj]⟩
  obtain ⟨La, hLa⟩ : ∃ L : ℝ³ →L[ℝ] ℝ³, ∀ v, L v = azVec v :=
    ⟨-(EuclideanSpace.proj 1 : ℝ³ →L[ℝ] ℝ).smulRight (EuclideanSpace.single (0 : Fin 3) (1:ℝ)) +
      (EuclideanSpace.proj 0 : ℝ³ →L[ℝ] ℝ).smulRight (EuclideanSpace.single (1 : Fin 3) (1:ℝ)),
      fun v => by simp [azVec, hpj]⟩
  have eLr : radVec = ⇑Lr := funext fun w => (hLr w).symm
  have eLa : azVec = ⇑La := funext fun w => (hLa w).symm
  have hrad : ∀ y, HasFDerivAt radVec Lr y := fun y => by rw [eLr]; exact Lr.hasFDerivAt
  have haz : ∀ y, HasFDerivAt azVec La y := fun y => by rw [eLa]; exact La.hasFDerivAt
  have hRsm : ContDiff ℝ ∞ radVec := by rw [eLr]; exact Lr.contDiff
  have hAsm : ContDiff ℝ ∞ azVec := by rw [eLa]; exact La.contDiff

  have frame : ∀ (A B C : ℝ³ → ℝ) (A' B' C' : ℝ³ →L[ℝ] ℝ) (y : ℝ³),
      HasFDerivAt A A' y → HasFDerivAt B B' y → HasFDerivAt C C' y →
      HasFDerivAt (fun w => A w • radVec w + B w • azVec w + C w • EuclideanSpace.single (2 : Fin 3) (1 : ℝ))
        (A y • Lr + A'.smulRight (radVec y) + (B y • La + B'.smulRight (azVec y)) +
          C'.smulRight (EuclideanSpace.single (2 : Fin 3) (1 : ℝ))) y :=
    fun A B C A' B' C' y hA hB hC =>
      ((hA.smul (hrad y)).add (hB.smul (haz y))).add (hC.smul_const _)
  have frameV : ∀ (A B C : ℝ³ → ℝ) (y v : ℝ³), DifferentiableAt ℝ A y → DifferentiableAt ℝ B y →
      DifferentiableAt ℝ C y →
      fderiv ℝ (fun w => A w • radVec w + B w • azVec w + C w • EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) y v =
        A y • radVec v + fderiv ℝ A y v • radVec y + (B y • azVec v + fderiv ℝ B y v • azVec y) +
          fderiv ℝ C y v • EuclideanSpace.single (2 : Fin 3) (1 : ℝ) := by
    intro A B C y v hA hB hC
    rw [(frame A B C _ _ _ y hA.hasFDerivAt hB.hasFDerivAt hC.hasFDerivAt).fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smulRight_apply, hLr, hLa]

  have hlap : ∀ (g : ℝ³ → ℝ³) (z : ℝ³), Δ g z = ∑ i : Fin 3,
      fderiv ℝ (fderiv ℝ g) z (EuclideanSpace.single i (1 : ℝ)) (EuclideanSpace.single i (1 : ℝ)) := by
    intro g z
    have h := congrFun (InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis g
      (EuclideanSpace.basisFun (Fin 3) ℝ)) z
    rw [h]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [iteratedFDeriv_two_apply]
    simp [EuclideanSpace.basisFun_apply]
  have hgrad : ∀ (g : ℝ³ → ℝ) (z : ℝ³), gradient g z = ∑ i : Fin 3,
      fderiv ℝ g z (EuclideanSpace.single i (1 : ℝ)) • EuclideanSpace.single i (1 : ℝ) := by
    intro g z
    have h := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr' (gradient g z)
    rw [← h]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    simp only [EuclideanSpace.basisFun_apply]
    congr 1
    rw [real_inner_comm]
    exact InnerProductSpace.toDual_symm_apply

  have hU : {w : ℝ³ | 0 < w 0 ^ 2 + w 1 ^ 2} ∈ nhds x :=
    (isOpen_lt continuous_const (by fun_prop)).mem_nhds hx
  have hevF : (fun y => u y t) =ᶠ[nhds x] (fun w : ℝ³ => α (w 0 ^ 2 + w 1 ^ 2) (w 2) t • radVec w +
      β (w 0 ^ 2 + w 1 ^ 2) (w 2) t • azVec w +
      γ (w 0 ^ 2 + w 1 ^ 2) (w 2) t • EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) := by
    filter_upwards [hU] with w hw
    exact hu w t ht hw
  have hevP : (fun y => p y t) =ᶠ[nhds x] (fun w : ℝ³ => P (w 0 ^ 2 + w 1 ^ 2) (w 2) t) := by
    filter_upwards [hU] with w hw
    exact hp w t ht hw
  have hevT : (fun s => u x s) =ᶠ[nhds t] (fun s => α (x 0 ^ 2 + x 1 ^ 2) (x 2) s • radVec x +
      β (x 0 ^ 2 + x 1 ^ 2) (x 2) s • azVec x +
      γ (x 0 ^ 2 + x 1 ^ 2) (x 2) s • EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) := by
    filter_upwards [Iio_mem_nhds ht] with s hs
    exact hu x s hs hx
  have hux := hu x t ht hx

  have T1 : deriv (fun s => u x s) t = cylPs α (x 0 ^ 2 + x 1 ^ 2) (x 2) t • radVec x +
      cylPs β (x 0 ^ 2 + x 1 ^ 2) (x 2) t • azVec x +
      cylPs γ (x 0 ^ 2 + x 1 ^ 2) (x 2) t • EuclideanSpace.single (2 : Fin 3) (1 : ℝ) := by
    rw [hevT.deriv_eq]
    exact ((((slice α hα (x 0 ^ 2 + x 1 ^ 2) (x 2) t hx ht).2.2.2.smul_const (radVec x)).add
      ((slice β hβ (x 0 ^ 2 + x 1 ^ 2) (x 2) t hx ht).2.2.2.smul_const (azVec x))).add
      ((slice γ hγ (x 0 ^ 2 + x 1 ^ 2) (x 2) t hx ht).2.2.2.smul_const
        (EuclideanSpace.single (2 : Fin 3) (1 : ℝ)))).deriv

  obtain ⟨cα, fα⟩ := lift α hα x t hx ht
  obtain ⟨cβ, fβ⟩ := lift β hβ x t hx ht
  obtain ⟨cγ, fγ⟩ := lift γ hγ x t hx ht
  obtain ⟨-, fP⟩ := lift P hP x t hx ht
  have hessα := hess α hα x t hx ht
  have hessβ := hess β hβ x t hx ht
  have hessγ := hess γ hγ x t hx ht
  have dα := cα.differentiableAt (by simp)
  have dβ := cβ.differentiableAt (by simp)
  have dγ := cγ.differentiableAt (by simp)
  have dDα : ∀ v : ℝ³, DifferentiableAt ℝ
      (fun w : ℝ³ => fderiv ℝ (fun w' : ℝ³ => α (w' 0 ^ 2 + w' 1 ^ 2) (w' 2) t) w v) x :=
    fun v => ((cα.fderiv_right (m := 1) (by simp)).differentiableAt (by simp)).clm_apply
      (differentiableAt_const v)
  have dDβ : ∀ v : ℝ³, DifferentiableAt ℝ
      (fun w : ℝ³ => fderiv ℝ (fun w' : ℝ³ => β (w' 0 ^ 2 + w' 1 ^ 2) (w' 2) t) w v) x :=
    fun v => ((cβ.fderiv_right (m := 1) (by simp)).differentiableAt (by simp)).clm_apply
      (differentiableAt_const v)
  have dDγ : ∀ v : ℝ³, DifferentiableAt ℝ
      (fun w : ℝ³ => fderiv ℝ (fun w' : ℝ³ => γ (w' 0 ^ 2 + w' 1 ^ 2) (w' 2) t) w v) x :=
    fun v => ((cγ.fderiv_right (m := 1) (by simp)).differentiableAt (by simp)).clm_apply
      (differentiableAt_const v)

  have hFsm : ContDiffAt ℝ ∞ (fun w : ℝ³ => α (w 0 ^ 2 + w 1 ^ 2) (w 2) t • radVec w +
      β (w 0 ^ 2 + w 1 ^ 2) (w 2) t • azVec w +
      γ (w 0 ^ 2 + w 1 ^ 2) (w 2) t • EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) x :=
    ((cα.smul hRsm.contDiffAt).add (cβ.smul hAsm.contDiffAt)).add (cγ.smul contDiffAt_const)
  have hDF := (hFsm.fderiv_right (m := 1) (by simp)).differentiableAt (by simp)
  have hsec : ∀ v : ℝ³, fderiv ℝ (fderiv ℝ (fun w : ℝ³ => α (w 0 ^ 2 + w 1 ^ 2) (w 2) t • radVec w +
      β (w 0 ^ 2 + w 1 ^ 2) (w 2) t • azVec w +
      γ (w 0 ^ 2 + w 1 ^ 2) (w 2) t • EuclideanSpace.single (2 : Fin 3) (1 : ℝ))) x v v =
      fderiv ℝ (fun y => fderiv ℝ (fun w : ℝ³ => α (w 0 ^ 2 + w 1 ^ 2) (w 2) t • radVec w +
      β (w 0 ^ 2 + w 1 ^ 2) (w 2) t • azVec w +
      γ (w 0 ^ 2 + w 1 ^ 2) (w 2) t • EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) y v) x v := by
    intro v
    rw [fderiv_clm_apply hDF (differentiableAt_const v)]
    simp
  have hfd : fderiv ℝ (fun y => u y t) =ᶠ[nhds x] fderiv ℝ (fun w : ℝ³ =>
      α (w 0 ^ 2 + w 1 ^ 2) (w 2) t • radVec w + β (w 0 ^ 2 + w 1 ^ 2) (w 2) t • azVec w +
      γ (w 0 ^ 2 + w 1 ^ 2) (w 2) t • EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) :=
    hevF.eventuallyEq_nhds.mono fun w hw => hw.fderiv_eq
  have hΔ : Δ (fun y => u y t) x = ∑ i : Fin 3, fderiv ℝ (fun y => fderiv ℝ (fun w : ℝ³ =>
      α (w 0 ^ 2 + w 1 ^ 2) (w 2) t • radVec w + β (w 0 ^ 2 + w 1 ^ 2) (w 2) t • azVec w +
      γ (w 0 ^ 2 + w 1 ^ 2) (w 2) t • EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) y
        (EuclideanSpace.single i (1 : ℝ))) x (EuclideanSpace.single i (1 : ℝ)) := by
    rw [hlap, hfd.fderiv_eq]
    exact Finset.sum_congr rfl (fun i _ => hsec _)
  have hev2 : ∀ v : ℝ³, (fun y => fderiv ℝ (fun w : ℝ³ =>
      α (w 0 ^ 2 + w 1 ^ 2) (w 2) t • radVec w + β (w 0 ^ 2 + w 1 ^ 2) (w 2) t • azVec w +
      γ (w 0 ^ 2 + w 1 ^ 2) (w 2) t • EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) y v) =ᶠ[nhds x]
      (fun w : ℝ³ => α (w 0 ^ 2 + w 1 ^ 2) (w 2) t • radVec v +
        fderiv ℝ (fun w' : ℝ³ => α (w' 0 ^ 2 + w' 1 ^ 2) (w' 2) t) w v • radVec w +
        (β (w 0 ^ 2 + w 1 ^ 2) (w 2) t • azVec v +
          fderiv ℝ (fun w' : ℝ³ => β (w' 0 ^ 2 + w' 1 ^ 2) (w' 2) t) w v • azVec w) +
        fderiv ℝ (fun w' : ℝ³ => γ (w' 0 ^ 2 + w' 1 ^ 2) (w' 2) t) w v •
          EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) := by
    intro v
    filter_upwards [hU] with w hw
    exact frameV _ _ _ w v ((lift α hα w t hw ht).1.differentiableAt (by simp))
      ((lift β hβ w t hw ht).1.differentiableAt (by simp))
      ((lift γ hγ w t hw ht).1.differentiableAt (by simp))
  have lapEq := fun v : ℝ³ =>
    (((((dα.hasFDerivAt.smul_const (radVec v)).add ((dDα v).hasFDerivAt.smul (hrad x))).add
      ((dβ.hasFDerivAt.smul_const (azVec v)).add ((dDβ v).hasFDerivAt.smul (haz x)))).add
      ((dDγ v).hasFDerivAt.smul_const (EuclideanSpace.single (2 : Fin 3) (1 : ℝ)))).congr_of_eventuallyEq
        (hev2 v)).fderiv

  unfold nsResidual
  rw [T1, hevF.fderiv_eq, frameV _ _ _ x (u x t) dα dβ dγ, hΔ, hgrad, hevP.fderiv_eq]
  simp only [Fin.sum_univ_three, lapEq, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.smulRight_apply, hLr, hLa, fα, fβ, fγ, fP, hessα, hessβ, hessγ]
  rw [hux]
  ext k
  fin_cases k <;> simp [radVec, azVec, frRadV, frThV, frZV, EuclideanSpace.single_apply] <;> ring

theorem bg_rad_coeff_match : ∀ (h : ℝ) (N : ℕ) (S G W : ℕ → ℝ → ℝ → ℝ) (ρ z s : ℝ), 0 < simScale h z (1 - s) → (∀ n : ℕ, N < n → S n = (fun _ _ => 0) ∧ G n = (fun _ _ => 0) ∧ W n = (fun _ _ => 0)) → frRadV ρ (simLiftSum h N (1 / 2) (fun n : ℕ => -1 + 2 * (n : ℝ) * h) (fun n => bgVx h n (S n)) ρ z s) (simLiftSum h N (1 / 2) (fun n : ℕ => -1 + 2 * (n : ℝ) * h - 1) (fun n => simTop h (-1 + 2 * (n : ℝ) * h) (bgVx h n (S n))) ρ z s) (simLiftSum h N (1 / 2 / 2) (fun n : ℕ => -1 + 2 * (n : ℝ) * h - 1) (fun n => pdX (bgVx h n (S n))) ρ z s) (simLiftSum h N (1 / 2 / 4) (fun n : ℕ => -1 + 2 * (n : ℝ) * h - 1 - 1) (fun n => pdX (pdX (bgVx h n (S n)))) ρ z s) (simLiftSum h N (1 / 2) (fun n : ℕ => -1 + 2 * (n : ℝ) * h - (1 / 2 - h)) (fun n => simZop h (-1 + 2 * (n : ℝ) * h) (bgVx h n (S n))) ρ z s) (simLiftSum h N (1 / 2) (fun n : ℕ => -1 + 2 * (n : ℝ) * h - (1 / 2 - h) - (1 / 2 - h)) (fun n => simZop h (-1 + 2 * (n : ℝ) * h - (1 / 2 - h)) (simZop h (-1 + 2 * (n : ℝ) * h) (bgVx h n (S n)))) ρ z s) (simLiftSum h N 1 (fun n : ℕ => -(1 + h) + 2 * (n : ℝ) * h) G ρ z s) (simLiftSum h N 1 (fun n : ℕ => -(1 / 2 + h) + 2 * (n : ℝ) * h) (fun n => bgUz (S n)) ρ z s) (simLiftSum h N (1 / 2) (fun n : ℕ => -(1 + 2 * h) + 2 * (n : ℝ) * h - 1) (fun n => pdX (W n)) ρ z s) = ∑ k ∈ Finset.range (2 * N + 2 + 1), simScale h z (1 - s) ^ (-(2 + 2 * h) + 2 * (k : ℝ) * h) * bgResRad h S G W k (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) :=
by
  intro h N S G W ρ z s hq hvan
  have R1 : ∀ (q e : ℝ), 0 < q → q * q ^ (e - 1) = q ^ e := by
    intro q e hq
    have he : q ^ e = q ^ (1 + (e - 1)) := by congr 1; ring
    rw [he, Real.rpow_add hq, Real.rpow_one]
  have rsub : ∀ a b : ℕ, a ≤ b → Finset.range a ⊆ Finset.range b := fun a b hab =>
    Finset.range_subset.mpr (fun x hx => Finset.mem_range.mpr (by omega))
  have trunc : ∀ (L : ℕ) (F : ℕ → ℝ), N + 1 ≤ L → (∀ n : ℕ, N < n → F n = 0) →
      ∑ n ∈ Finset.range (N + 1), F n = ∑ k ∈ Finset.range L, F k := by
    intro L F hL hF
    refine Finset.sum_subset (rsub _ _ hL) ?_
    intro x _ hx
    simp only [Finset.mem_range, not_lt] at hx
    exact hF x (by omega)
  have shift : ∀ (q : ℝ) (L : ℕ) (β : ℝ) (e : ℕ → ℝ) (y : ℕ → ℝ),
      (∀ n : ℕ, e n = β + 2 * ((n : ℝ) + 1) * h) →
      ∑ n ∈ Finset.range L, q ^ (e n) * y n =
        ∑ k ∈ Finset.range (L + 1), q ^ (β + 2 * (k : ℝ) * h) * (if 1 ≤ k then y (k - 1) else 0) := by
    intro q L β e y he
    rw [Finset.sum_range_succ']
    have h0 : (if 1 ≤ (0:ℕ) then y (0 - 1) else 0) = 0 := if_neg (by norm_num)
    rw [h0, mul_zero, add_zero]
    refine Finset.sum_congr rfl (fun n _ => ?_)
    rw [if_pos (Nat.le_add_left 1 n), Nat.add_sub_cancel, he n, Nat.cast_add, Nat.cast_one]
  have cauchy : ∀ (q : ℝ) (L : ℕ) (α β γ : ℝ) (x y : ℕ → ℝ), 0 < q → α + β = γ → 2 * N + 1 ≤ L →
      (∀ n : ℕ, N < n → x n = 0) → (∀ n : ℕ, N < n → y n = 0) →
      (∑ i ∈ Finset.range (N + 1), q ^ (α + 2 * (i : ℝ) * h) * x i) *
        (∑ j ∈ Finset.range (N + 1), q ^ (β + 2 * (j : ℝ) * h) * y j) =
      ∑ k ∈ Finset.range L, q ^ (γ + 2 * (k : ℝ) * h) * ∑ i ∈ Finset.range (k + 1), x i * y (k - i) := by
    intro q L α β γ x y hq hγ hL hx hy
    have lhs : (∑ i ∈ Finset.range (N + 1), q ^ (α + 2 * (i : ℝ) * h) * x i) *
        (∑ j ∈ Finset.range (N + 1), q ^ (β + 2 * (j : ℝ) * h) * y j) =
        ∑ i ∈ Finset.range (N + 1), ∑ j ∈ Finset.range (N + 1),
          q ^ (γ + 2 * ((i + j : ℕ) : ℝ) * h) * (x i * y j) := by
      rw [Finset.sum_mul_sum]
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
      have hexp : γ + 2 * ((i + j : ℕ) : ℝ) * h = (α + 2 * (i : ℝ) * h) + (β + 2 * (j : ℝ) * h) := by
        rw [← hγ]; push_cast; ring
      rw [hexp, Real.rpow_add hq (α + 2 * (i : ℝ) * h) (β + 2 * (j : ℝ) * h)]
      ring
    have rhs : ∑ k ∈ Finset.range L, q ^ (γ + 2 * (k : ℝ) * h) * ∑ i ∈ Finset.range (k + 1), x i * y (k - i) =
        ∑ k ∈ Finset.range L, ∑ i ∈ Finset.range (k + 1),
          q ^ (γ + 2 * ((i + (k - i) : ℕ) : ℝ) * h) * (x i * y (k - i)) := by
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hik : i + (k - i) = k := Nat.add_sub_of_le (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi))
      rw [hik]
    rw [lhs, rhs, Finset.sum_range_diag_flip L (fun i j => q ^ (γ + 2 * ((i + j : ℕ) : ℝ) * h) * (x i * y j))]
    have h1 : ∀ i ∈ Finset.range (N + 1),
        ∑ j ∈ Finset.range (N + 1), q ^ (γ + 2 * ((i + j : ℕ) : ℝ) * h) * (x i * y j) =
        ∑ j ∈ Finset.range (L - i), q ^ (γ + 2 * ((i + j : ℕ) : ℝ) * h) * (x i * y j) := by
      intro i hi
      have hi' := Finset.mem_range.mp hi
      refine Finset.sum_subset (rsub _ _ (by omega)) ?_
      intro j _ hj
      simp only [Finset.mem_range, not_lt] at hj
      simp [hy j (by omega)]
    rw [Finset.sum_congr rfl h1]
    refine Finset.sum_subset (rsub _ _ (by omega)) ?_
    intro i _ hi
    simp only [Finset.mem_range, not_lt] at hi
    exact Finset.sum_eq_zero (fun j _ => by simp [hx i (by omega)])
  have key : ∀ (q X ρ : ℝ) (V VR VRR T Z ZZ U g WR Om : ℕ → ℝ), 0 < q → ρ = 2 * q * X →
      (∀ m : ℕ, Om m = T m - 2 * (X * VRR m + 2 * VR m) +
        ∑ i ∈ Finset.range (m + 1), (V i * (V (m - i) / 2 + X * VR (m - i)) + U i * Z (m - i)) -
        (if 1 ≤ m then ZZ (m - 1) else 0)) →
      (∀ n : ℕ, N < n → V n = 0 ∧ VR n = 0 ∧ VRR n = 0 ∧ T n = 0 ∧ Z n = 0 ∧ ZZ n = 0 ∧ U n = 0 ∧
        g n = 0 ∧ WR n = 0) →
      frRadV ρ (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h) * V n))
        (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h - 1) * T n))
        (∑ n ∈ Finset.range (N + 1), 1 / 2 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h - 1) * VR n))
        (∑ n ∈ Finset.range (N + 1), 1 / 2 / 4 * (q ^ (-1 + 2 * (n : ℝ) * h - 1 - 1) * VRR n))
        (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h - (1 / 2 - h)) * Z n))
        (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h - (1 / 2 - h) - (1 / 2 - h)) * ZZ n))
        (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h) * g n))
        (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * U n))
        (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-(1 + 2 * h) + 2 * (n : ℝ) * h - 1) * WR n)) =
      ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(2 + 2 * h) + 2 * (k : ℝ) * h) *
        (WR k - ∑ i ∈ Finset.range (k + 1), g i * g (k - i) + (if 1 ≤ k then Om (k - 1) / 2 else 0)) := by
    intro q X ρ V VR VRR T Z ZZ U g WR Om hq hρ hOm hv
    have hs : ∀ (c : ℝ) (e e' : ℕ → ℝ) (x : ℕ → ℝ), (∀ n : ℕ, e n = e' n) →
        ∑ n ∈ Finset.range (N + 1), c * (q ^ (e n) * x n) =
          c * ∑ n ∈ Finset.range (N + 1), q ^ (e' n) * x n := by
      intro c e e' x he
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun n _ => by rw [he n])
    have F1 : (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h - 1) * T n)) =
        1 / 2 * ∑ n ∈ Finset.range (N + 1), q ^ (-2 + 2 * (n : ℝ) * h) * T n :=
      hs (1 / 2) (fun n => -1 + 2 * (n : ℝ) * h - 1) (fun n => -2 + 2 * (n : ℝ) * h) T (fun n => by ring)
    have F2 : (∑ n ∈ Finset.range (N + 1), 1 / 2 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h - 1) * VR n)) =
        1 / 2 / 2 * ∑ n ∈ Finset.range (N + 1), q ^ (-2 + 2 * (n : ℝ) * h) * VR n :=
      hs (1 / 2 / 2) (fun n => -1 + 2 * (n : ℝ) * h - 1) (fun n => -2 + 2 * (n : ℝ) * h) VR (fun n => by ring)
    have F3 : ρ * (∑ n ∈ Finset.range (N + 1), 1 / 2 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h - 1) * VR n)) =
        1 / 2 * X * ∑ n ∈ Finset.range (N + 1), q ^ (-1 + 2 * (n : ℝ) * h) * VR n := by
      rw [hρ, Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun n _ => ?_)
      rw [← R1 q (-1 + 2 * (n : ℝ) * h) hq]
      ring
    have F4 : ρ * (∑ n ∈ Finset.range (N + 1), 1 / 2 / 4 * (q ^ (-1 + 2 * (n : ℝ) * h - 1 - 1) * VRR n)) =
        1 / 4 * X * ∑ n ∈ Finset.range (N + 1), q ^ (-2 + 2 * (n : ℝ) * h) * VRR n := by
      rw [hρ, Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun n _ => ?_)
      rw [show (-2 + 2 * (n : ℝ) * h) = -1 + 2 * (n : ℝ) * h - 1 by ring,
        ← R1 q (-1 + 2 * (n : ℝ) * h - 1) hq]
      ring
    have F5 : (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h) * V n)) =
        1 / 2 * ∑ n ∈ Finset.range (N + 1), q ^ (-1 + 2 * (n : ℝ) * h) * V n :=
      hs (1 / 2) (fun n => -1 + 2 * (n : ℝ) * h) (fun n => -1 + 2 * (n : ℝ) * h) V (fun n => rfl)
    have F6 : (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h - (1 / 2 - h)) * Z n)) =
        1 / 2 * ∑ n ∈ Finset.range (N + 1), q ^ (-(3 / 2 - h) + 2 * (n : ℝ) * h) * Z n :=
      hs (1 / 2) (fun n => -1 + 2 * (n : ℝ) * h - (1 / 2 - h)) (fun n => -(3 / 2 - h) + 2 * (n : ℝ) * h) Z
        (fun n => by ring)
    have F7 : (∑ n ∈ Finset.range (N + 1),
        1 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h - (1 / 2 - h) - (1 / 2 - h)) * ZZ n)) =
        1 / 2 * ∑ n ∈ Finset.range (N + 1), q ^ (-2 + 2 * ((n : ℝ) + 1) * h) * ZZ n :=
      hs (1 / 2) (fun n => -1 + 2 * (n : ℝ) * h - (1 / 2 - h) - (1 / 2 - h))
        (fun n => -2 + 2 * ((n : ℝ) + 1) * h) ZZ (fun n => by ring)
    have F8 : (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h) * g n)) =
        ∑ n ∈ Finset.range (N + 1), q ^ (-(1 + h) + 2 * (n : ℝ) * h) * g n :=
      Finset.sum_congr rfl (fun n _ => one_mul _)
    have F8' : (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * U n)) =
        ∑ n ∈ Finset.range (N + 1), q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * U n :=
      Finset.sum_congr rfl (fun n _ => one_mul _)
    have F9 : (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-(1 + 2 * h) + 2 * (n : ℝ) * h - 1) * WR n)) =
        1 / 2 * ∑ n ∈ Finset.range (N + 1), q ^ (-(2 + 2 * h) + 2 * (n : ℝ) * h) * WR n :=
      hs (1 / 2) (fun n => -(1 + 2 * h) + 2 * (n : ℝ) * h - 1) (fun n => -(2 + 2 * h) + 2 * (n : ℝ) * h) WR
        (fun n => by ring)
    have F10 : ∑ n ∈ Finset.range (N + 1), q ^ (-2 + 2 * (n : ℝ) * h) * (T n - 2 * (X * VRR n + 2 * VR n)) =
        ∑ n ∈ Finset.range (N + 1), q ^ (-2 + 2 * (n : ℝ) * h) * T n -
          2 * X * ∑ n ∈ Finset.range (N + 1), q ^ (-2 + 2 * (n : ℝ) * h) * VRR n -
          4 * ∑ n ∈ Finset.range (N + 1), q ^ (-2 + 2 * (n : ℝ) * h) * VR n := by
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl (fun n _ => by ring)
    have F11 : ∑ j ∈ Finset.range (N + 1), q ^ (-1 + 2 * (j : ℝ) * h) * (V j / 2 + X * VR j) =
        1 / 2 * ∑ n ∈ Finset.range (N + 1), q ^ (-1 + 2 * (n : ℝ) * h) * V n +
          X * ∑ n ∈ Finset.range (N + 1), q ^ (-1 + 2 * (n : ℝ) * h) * VR n := by
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun n _ => by ring)
    have NFg : ∀ (a aS aR aRR aZ aZZ b gm pR ST SR SRa SRR A SZ t4 Bg Γ t6 t1 B2 : ℝ),
        aS = 1 / 2 * ST → aR = 1 / 2 / 2 * SR → ρ * aR = 1 / 2 * X * SRa → ρ * aRR = 1 / 4 * X * SRR →
        a = 1 / 2 * A → aZ = 1 / 2 * SZ → aZZ = 1 / 2 * t4 → b = Bg → gm = Γ → pR = 1 / 2 * t6 →
        t1 = ST - 2 * X * SRR - 4 * SR → B2 = 1 / 2 * A + X * SRa →
        frRadV ρ a aS aR aRR aZ aZZ b gm pR = 1 / 2 * (t1 + A * B2 + Γ * SZ - t4) - Bg * Bg + t6 := by
      intro a aS aR aRR aZ aZZ b gm pR ST SR SRa SRR A SZ t4 Bg Γ t6 t1 B2 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10
        e11 e12
      unfold frRadV
      rw [e1, e5, e6, e7, e8, e9, e10, e11, e12]
      rw [e2] at e3 ⊢
      linear_combination A * e3 - 4 * e4
    rw [NFg _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ F1 F2 F3 F4 F5 F6 F7 F8 F8' F9 F10 F11]
    have Rsplit : ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(2 + 2 * h) + 2 * (k : ℝ) * h) *
        (WR k - ∑ i ∈ Finset.range (k + 1), g i * g (k - i) + (if 1 ≤ k then Om (k - 1) / 2 else 0)) =
        ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(2 + 2 * h) + 2 * (k : ℝ) * h) * WR k -
        ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(2 + 2 * h) + 2 * (k : ℝ) * h) *
          ∑ i ∈ Finset.range (k + 1), g i * g (k - i) +
        ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(2 + 2 * h) + 2 * (k : ℝ) * h) *
          (if 1 ≤ k then Om (k - 1) / 2 else 0) := by
      rw [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun k _ => by ring)
    have c2 : ∑ n ∈ Finset.range (N + 1), q ^ (-(2 + 2 * h) + 2 * (n : ℝ) * h) * WR n =
        ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(2 + 2 * h) + 2 * (k : ℝ) * h) * WR k :=
      trunc _ (fun k => q ^ (-(2 + 2 * h) + 2 * (k : ℝ) * h) * WR k) (by omega)
        (fun n hn => by simp [(hv n hn).2.2.2.2.2.2.2.2])
    have c3 : (∑ i ∈ Finset.range (N + 1), q ^ (-(1 + h) + 2 * (i : ℝ) * h) * g i) *
        (∑ j ∈ Finset.range (N + 1), q ^ (-(1 + h) + 2 * (j : ℝ) * h) * g j) =
        ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(2 + 2 * h) + 2 * (k : ℝ) * h) *
          ∑ i ∈ Finset.range (k + 1), g i * g (k - i) :=
      cauchy q (2 * N + 2 + 1) (-(1 + h)) (-(1 + h)) (-(2 + 2 * h)) g g hq (by ring) (by omega)
        (fun n hn => (hv n hn).2.2.2.2.2.2.2.1) (fun n hn => (hv n hn).2.2.2.2.2.2.2.1)
    have c4 : ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(2 + 2 * h) + 2 * (k : ℝ) * h) *
          (if 1 ≤ k then Om (k - 1) / 2 else 0) =
        ∑ m ∈ Finset.range (2 * N + 2), q ^ (-2 + 2 * (m : ℝ) * h) * (Om m / 2) :=
      (shift q (2 * N + 2) (-(2 + 2 * h)) (fun m => -2 + 2 * (m : ℝ) * h) (fun m => Om m / 2)
        (fun n => by ring)).symm
    have c5 : ∑ m ∈ Finset.range (2 * N + 2), q ^ (-2 + 2 * (m : ℝ) * h) * (Om m / 2) =
        1 / 2 * (∑ m ∈ Finset.range (2 * N + 2), q ^ (-2 + 2 * (m : ℝ) * h) *
              (T m - 2 * (X * VRR m + 2 * VR m)) +
            ∑ m ∈ Finset.range (2 * N + 2), q ^ (-2 + 2 * (m : ℝ) * h) *
              ∑ i ∈ Finset.range (m + 1), V i * (V (m - i) / 2 + X * VR (m - i)) +
            ∑ m ∈ Finset.range (2 * N + 2), q ^ (-2 + 2 * (m : ℝ) * h) *
              ∑ i ∈ Finset.range (m + 1), U i * Z (m - i) -
            ∑ m ∈ Finset.range (2 * N + 2), q ^ (-2 + 2 * (m : ℝ) * h) *
              (if 1 ≤ m then ZZ (m - 1) else 0)) := by
      have e : ∀ m ∈ Finset.range (2 * N + 2), q ^ (-2 + 2 * (m : ℝ) * h) * (Om m / 2) =
          1 / 2 * (q ^ (-2 + 2 * (m : ℝ) * h) * (T m - 2 * (X * VRR m + 2 * VR m)) +
            q ^ (-2 + 2 * (m : ℝ) * h) * ∑ i ∈ Finset.range (m + 1), V i * (V (m - i) / 2 + X * VR (m - i)) +
            q ^ (-2 + 2 * (m : ℝ) * h) * ∑ i ∈ Finset.range (m + 1), U i * Z (m - i) -
            q ^ (-2 + 2 * (m : ℝ) * h) * (if 1 ≤ m then ZZ (m - 1) else 0)) := by
        intro m _
        rw [hOm m, Finset.sum_add_distrib]
        ring
      rw [Finset.sum_congr rfl e, ← Finset.mul_sum, Finset.sum_sub_distrib, Finset.sum_add_distrib,
        Finset.sum_add_distrib]
    have c6 : ∑ m ∈ Finset.range (2 * N + 2), q ^ (-2 + 2 * (m : ℝ) * h) * (T m - 2 * (X * VRR m + 2 * VR m)) =
        ∑ n ∈ Finset.range (N + 1), q ^ (-2 + 2 * (n : ℝ) * h) * (T n - 2 * (X * VRR n + 2 * VR n)) :=
      (trunc (2 * N + 2) (fun m => q ^ (-2 + 2 * (m : ℝ) * h) * (T m - 2 * (X * VRR m + 2 * VR m)))
        (by omega) (fun n hn => by
          obtain ⟨_, h2, h3, h4, _⟩ := hv n hn
          simp [h2, h3, h4])).symm
    have c7 : ∑ m ∈ Finset.range (2 * N + 2), q ^ (-2 + 2 * (m : ℝ) * h) *
          ∑ i ∈ Finset.range (m + 1), V i * (V (m - i) / 2 + X * VR (m - i)) =
        (∑ i ∈ Finset.range (N + 1), q ^ (-1 + 2 * (i : ℝ) * h) * V i) *
          ∑ j ∈ Finset.range (N + 1), q ^ (-1 + 2 * (j : ℝ) * h) * (V j / 2 + X * VR j) :=
      (cauchy q (2 * N + 2) (-1) (-1) (-2) V (fun j => V j / 2 + X * VR j) hq (by norm_num) (by omega)
        (fun n hn => (hv n hn).1) (fun n hn => by
          obtain ⟨h1, h2, _⟩ := hv n hn
          simp [h1, h2])).symm
    have c8 : ∑ m ∈ Finset.range (2 * N + 2), q ^ (-2 + 2 * (m : ℝ) * h) *
          ∑ i ∈ Finset.range (m + 1), U i * Z (m - i) =
        (∑ i ∈ Finset.range (N + 1), q ^ (-(1 / 2 + h) + 2 * (i : ℝ) * h) * U i) *
          ∑ j ∈ Finset.range (N + 1), q ^ (-(3 / 2 - h) + 2 * (j : ℝ) * h) * Z j :=
      (cauchy q (2 * N + 2) (-(1 / 2 + h)) (-(3 / 2 - h)) (-2) U Z hq (by ring) (by omega)
        (fun n hn => (hv n hn).2.2.2.2.2.2.1) (fun n hn => (hv n hn).2.2.2.2.1)).symm
    have c9 : ∑ m ∈ Finset.range (2 * N + 2), q ^ (-2 + 2 * (m : ℝ) * h) * (if 1 ≤ m then ZZ (m - 1) else 0) =
        ∑ n ∈ Finset.range (N + 1), q ^ (-2 + 2 * ((n : ℝ) + 1) * h) * ZZ n := by
      rw [show 2 * N + 2 = 2 * N + 1 + 1 by omega,
        ← shift q (2 * N + 1) (-2) (fun n => -2 + 2 * ((n : ℝ) + 1) * h) ZZ (fun n => rfl)]
      exact (trunc (2 * N + 1) (fun n => q ^ (-2 + 2 * ((n : ℝ) + 1) * h) * ZZ n) (by omega)
        (fun n hn => by simp [(hv n hn).2.2.2.2.2.1])).symm
    linear_combination (-1 : ℝ) * Rsplit + c2 - c3 - c4 - c5 - 1 / 2 * c6 - 1 / 2 * c7 - 1 / 2 * c8 +
      1 / 2 * c9
  have pX0 : pdX (fun _ _ => (0:ℝ)) = fun _ _ => 0 := by
    funext a b; simp [pdX]
  have pE0 : pdE (fun _ _ => (0:ℝ)) = fun _ _ => 0 := by
    funext a b; simp [pdE]
  have bU0 : bgUz (fun _ _ => (0:ℝ)) = fun _ _ => 0 := by
    funext a b; simp [bgUz, pX0]
  have bV0 : ∀ n : ℕ, bgVx h n (fun _ _ => (0:ℝ)) = fun _ _ => 0 := by
    intro n; funext a b; simp [bgVx, bU0, pE0]
  have sT0 : ∀ b : ℝ, simTop h b (fun _ _ => (0:ℝ)) = fun _ _ => 0 := by
    intro b; funext a c; simp [simTop, pX0, pE0]
  have sZ0 : ∀ b : ℝ, simZop h b (fun _ _ => (0:ℝ)) = fun _ _ => 0 := by
    intro b; funext a c; simp [simZop, pX0, pE0]
  simp only [simLiftSum, simLift]
  generalize hQ : simScale h z (1 - s) = q at hq ⊢
  generalize hXd : ρ / (2 * q) = X
  generalize hEt : z * q ^ (-(1 / 2 - h)) = η
  have h2q : (2:ℝ) * q ≠ 0 := mul_ne_zero two_ne_zero hq.ne'
  have hρ : ρ = 2 * q * X := by
    rw [← hXd]; field_simp
  exact key q X ρ (fun n => bgVx h n (S n) X η) (fun n => pdX (bgVx h n (S n)) X η)
    (fun n => pdX (pdX (bgVx h n (S n))) X η) (fun n => simTop h (-1 + 2 * (n : ℝ) * h) (bgVx h n (S n)) X η)
    (fun n => simZop h (-1 + 2 * (n : ℝ) * h) (bgVx h n (S n)) X η)
    (fun n => simZop h (-1 + 2 * (n : ℝ) * h - (1 / 2 - h)) (simZop h (-1 + 2 * (n : ℝ) * h) (bgVx h n (S n))) X η)
    (fun n => bgUz (S n) X η) (fun n => G n X η) (fun n => pdX (W n) X η) (fun m => bgOm h S m X η)
    hq hρ (fun m => rfl) (fun n hn => by
      obtain ⟨hS, hG, hW⟩ := hvan n hn
      simp [hS, hG, hW, bV0, sT0, sZ0, pX0, bU0])

theorem bg_th_coeff_match : ∀ (h : ℝ) (N : ℕ) (S G W : ℕ → ℝ → ℝ → ℝ) (ρ z s : ℝ), 0 < simScale h z (1 - s) → (∀ n : ℕ, N < n → S n = (fun _ _ => 0) ∧ G n = (fun _ _ => 0) ∧ W n = (fun _ _ => 0)) → frThV ρ (simLiftSum h N (1 / 2) (fun n : ℕ => -1 + 2 * (n : ℝ) * h) (fun n => bgVx h n (S n)) ρ z s) (simLiftSum h N 1 (fun n : ℕ => -(1 + h) + 2 * (n : ℝ) * h) G ρ z s) (simLiftSum h N 1 (fun n : ℕ => -(1 + h) + 2 * (n : ℝ) * h - 1) (fun n => simTop h (-(1 + h) + 2 * (n : ℝ) * h) (G n)) ρ z s) (simLiftSum h N (1 / 2) (fun n : ℕ => -(1 + h) + 2 * (n : ℝ) * h - 1) (fun n => pdX (G n)) ρ z s) (simLiftSum h N (1 / 4) (fun n : ℕ => -(1 + h) + 2 * (n : ℝ) * h - 1 - 1) (fun n => pdX (pdX (G n))) ρ z s) (simLiftSum h N 1 (fun n : ℕ => -(1 + h) + 2 * (n : ℝ) * h - (1 / 2 - h)) (fun n => simZop h (-(1 + h) + 2 * (n : ℝ) * h) (G n)) ρ z s) (simLiftSum h N 1 (fun n : ℕ => -(1 + h) + 2 * (n : ℝ) * h - (1 / 2 - h) - (1 / 2 - h)) (fun n => simZop h (-(1 + h) + 2 * (n : ℝ) * h - (1 / 2 - h)) (simZop h (-(1 + h) + 2 * (n : ℝ) * h) (G n))) ρ z s) (simLiftSum h N 1 (fun n : ℕ => -(1 / 2 + h) + 2 * (n : ℝ) * h) (fun n => bgUz (S n)) ρ z s) = ∑ k ∈ Finset.range (2 * N + 2 + 1), simScale h z (1 - s) ^ (-(2 + h) + 2 * (k : ℝ) * h) * bgResTh h S G W k (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) :=
by
  intro h N S G W ρ z s hq hvan

  have hr : ∀ (q e : ℝ), 0 < q → q ^ (e - 1) * q = q ^ e := by
    intro q e hq
    rw [Real.rpow_sub_one hq.ne']
    exact div_mul_cancel₀ _ hq.ne'

  have cauchy : ∀ (q α β γ : ℝ) (x y : ℕ → ℝ), 0 < q → α + β = γ → (∀ n, N < n → x n = 0) →
      (∀ n, N < n → y n = 0) →
      (∑ i ∈ Finset.range (N + 1), q ^ (α + 2 * (i : ℝ) * h) * x i) *
        (∑ j ∈ Finset.range (N + 1), q ^ (β + 2 * (j : ℝ) * h) * y j) =
      ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (γ + 2 * (k : ℝ) * h) *
        ∑ i ∈ Finset.range (k + 1), x i * y (k - i) := by
    intro q α β γ x y hq hαβ hx hy
    obtain ⟨F, hF⟩ : ∃ F : ℕ → ℕ → ℝ,
        F = fun i j => q ^ (γ + 2 * ((i + j : ℕ) : ℝ) * h) * (x i * y j) := ⟨_, rfl⟩
    have hL : (∑ i ∈ Finset.range (N + 1), q ^ (α + 2 * (i : ℝ) * h) * x i) *
        (∑ j ∈ Finset.range (N + 1), q ^ (β + 2 * (j : ℝ) * h) * y j) =
        ∑ i ∈ Finset.range (N + 1), ∑ j ∈ Finset.range (N + 1), F i j := by
      rw [Finset.sum_mul_sum]
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
      rw [hF, ← hαβ]
      beta_reduce
      rw [show α + β + 2 * ((i + j : ℕ) : ℝ) * h = (α + 2 * (i : ℝ) * h) + (β + 2 * (j : ℝ) * h) by
        push_cast; ring, Real.rpow_add hq (α + 2 * (i : ℝ) * h)]
      ring
    have hR : ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (γ + 2 * (k : ℝ) * h) *
        ∑ i ∈ Finset.range (k + 1), x i * y (k - i) =
        ∑ k ∈ Finset.range (2 * N + 2 + 1), ∑ i ∈ Finset.range (k + 1), F i (k - i) := by
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hik : i + (k - i) = k := Nat.add_sub_of_le (Finset.mem_range_succ_iff.mp hi)
      rw [hF]
      simp only [hik]
    rw [hL, hR, Finset.sum_range_diag_flip]
    symm
    calc ∑ m ∈ Finset.range (2 * N + 2 + 1), ∑ j ∈ Finset.range (2 * N + 2 + 1 - m), F m j
        = ∑ m ∈ Finset.range (N + 1), ∑ j ∈ Finset.range (2 * N + 2 + 1 - m), F m j := by
          symm
          refine Finset.sum_subset (Finset.range_subset_range.mpr (by omega)) ?_
          intro m _ hm
          have hNm : N < m := by
            rw [Finset.mem_range] at hm; omega
          refine Finset.sum_eq_zero (fun j _ => ?_)
          rw [hF]; simp [hx m hNm]
      _ = ∑ m ∈ Finset.range (N + 1), ∑ j ∈ Finset.range (N + 1), F m j := by
          refine Finset.sum_congr rfl (fun m hm => ?_)
          have hm' := Finset.mem_range.mp hm
          symm
          refine Finset.sum_subset (Finset.range_subset_range.mpr (by omega)) ?_
          intro j _ hj
          have hNj : N < j := by
            rw [Finset.mem_range] at hj; omega
          rw [hF]; simp [hy j hNj]

  have single : ∀ (q β : ℝ) (y : ℕ → ℝ), (∀ n, N < n → y n = 0) →
      ∑ n ∈ Finset.range (N + 1), q ^ (β + 2 * (n : ℝ) * h) * y n =
      ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (β + 2 * (k : ℝ) * h) * y k := by
    intro q β y hy
    refine Finset.sum_subset (Finset.range_subset_range.mpr (by omega)) ?_
    intro k _ hk
    have hNk : N < k := by rw [Finset.mem_range] at hk; omega
    simp [hy k hNk]
  have shift : ∀ (q β : ℝ) (y : ℕ → ℝ), (∀ n, N < n → y n = 0) →
      ∑ n ∈ Finset.range (N + 1), q ^ (β + 2 * ((n : ℝ) + 1) * h) * y n =
      ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (β + 2 * (k : ℝ) * h) *
        (if 1 ≤ k then y (k - 1) else 0) := by
    intro q β y hy
    rw [Finset.sum_range_succ' _ (2 * N + 2)]
    have e : ∀ k : ℕ, q ^ (β + 2 * ((k + 1 : ℕ) : ℝ) * h) * (if 1 ≤ k + 1 then y (k + 1 - 1) else 0) =
        q ^ (β + 2 * ((k : ℝ) + 1) * h) * y k := by
      intro k
      rw [if_pos (by omega), Nat.add_sub_cancel]
      push_cast; ring
    rw [if_neg (by norm_num : ¬ (1:ℕ) ≤ 0), mul_zero, add_zero]
    rw [Finset.sum_congr rfl (fun k _ => e k)]
    refine Finset.sum_subset (Finset.range_subset_range.mpr (by omega)) ?_
    intro k _ hk
    have hNk : N < k := by rw [Finset.mem_range] at hk; omega
    simp [hy k hNk]

  have gen : ∀ (q X : ℝ) (V U g gR gRR T Z ZZ : ℕ → ℝ), 0 < q → ρ = 2 * q * X →
      (∀ n, N < n → V n = 0) → (∀ n, N < n → U n = 0) → (∀ n, N < n → g n + X * gR n = 0) →
      (∀ n, N < n → Z n = 0) → (∀ n, N < n → ZZ n = 0) →
      (∀ n, N < n → T n - 2 * (X * gRR n + 2 * gR n) = 0) →
      frThV ρ (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h) * V n))
        (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h) * g n))
        (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h - 1) * T n))
        (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h - 1) * gR n))
        (∑ n ∈ Finset.range (N + 1), 1 / 4 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h - 1 - 1) * gRR n))
        (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h - (1 / 2 - h)) * Z n))
        (∑ n ∈ Finset.range (N + 1),
          1 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h - (1 / 2 - h) - (1 / 2 - h)) * ZZ n))
        (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * U n)) =
      ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(2 + h) + 2 * (k : ℝ) * h) *
        (T k - 2 * (X * gRR k + 2 * gR k) +
          ∑ i ∈ Finset.range (k + 1), (V i * (g (k - i) + X * gR (k - i)) + U i * Z (k - i)) -
          (if 1 ≤ k then ZZ (k - 1) else 0)) := by
    intro q X V U g gR gRR T Z ZZ hq hρ hV hU hY hZ hZZ hT
    have hfr : ∀ a b bS bR bRR bZ bZZ gg : ℝ, frThV ρ a b bS bR bRR bZ bZZ gg =
        (bS - (4 * ρ * bRR + 8 * bR)) + (2 * a) * (ρ * bR + b) + gg * bZ - bZZ := by
      intro a b bS bR bRR bZ bZZ gg; unfold frThV; ring
    rw [hfr]
    have hD : (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h - 1) * T n)) -
        (4 * ρ * (∑ n ∈ Finset.range (N + 1), 1 / 4 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h - 1 - 1) * gRR n)) +
          8 * (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h - 1) * gR n))) =
        ∑ n ∈ Finset.range (N + 1), q ^ (-(2 + h) + 2 * (n : ℝ) * h) *
          (T n - 2 * (X * gRR n + 2 * gR n)) := by
      rw [hρ, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun n _ => ?_)
      rw [show -(1 + h) + 2 * (n : ℝ) * h - 1 = -(2 + h) + 2 * (n : ℝ) * h by ring]
      linear_combination (-2 * X * gRR n) * hr q (-(2 + h) + 2 * (n : ℝ) * h) hq
    have hB : ρ * (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h - 1) * gR n)) +
        (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h) * g n)) =
        ∑ n ∈ Finset.range (N + 1), q ^ (-(1 + h) + 2 * (n : ℝ) * h) * (g n + X * gR n) := by
      rw [hρ, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun n _ => ?_)
      linear_combination (X * gR n) * hr q (-(1 + h) + 2 * (n : ℝ) * h) hq
    have hA : 2 * (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h) * V n)) =
        ∑ n ∈ Finset.range (N + 1), q ^ (-1 + 2 * (n : ℝ) * h) * V n := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun n _ => ?_)
      ring
    have hC1 : (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * U n)) =
        ∑ n ∈ Finset.range (N + 1), q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * U n := by
      refine Finset.sum_congr rfl (fun n _ => ?_)
      rw [one_mul]
    have hC2 : (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h - (1 / 2 - h)) * Z n)) =
        ∑ n ∈ Finset.range (N + 1), q ^ (-(3 / 2) + 2 * (n : ℝ) * h) * Z n := by
      refine Finset.sum_congr rfl (fun n _ => ?_)
      rw [show -(1 + h) + 2 * (n : ℝ) * h - (1 / 2 - h) = -(3 / 2) + 2 * (n : ℝ) * h by ring, one_mul]
    have hE : (∑ n ∈ Finset.range (N + 1),
          1 * (q ^ (-(1 + h) + 2 * (n : ℝ) * h - (1 / 2 - h) - (1 / 2 - h)) * ZZ n)) =
        ∑ n ∈ Finset.range (N + 1), q ^ (-(2 + h) + 2 * ((n : ℝ) + 1) * h) * ZZ n := by
      refine Finset.sum_congr rfl (fun n _ => ?_)
      rw [show -(1 + h) + 2 * (n : ℝ) * h - (1 / 2 - h) - (1 / 2 - h) =
        -(2 + h) + 2 * ((n : ℝ) + 1) * h by ring, one_mul]
    rw [hD, hB, hA, hC1, hC2, hE]
    have r1 := single q (-(2 + h)) (fun n => T n - 2 * (X * gRR n + 2 * gR n)) hT
    have r2 := cauchy q (-1) (-(1 + h)) (-(2 + h)) V (fun j => g j + X * gR j) hq (by ring) hV hY
    have r3 := cauchy q (-(1 / 2 + h)) (-(3 / 2)) (-(2 + h)) U Z hq (by ring) hU hZ
    have r4 := shift q (-(2 + h)) ZZ hZZ
    beta_reduce at r1 r2
    rw [r1, r2, r3, r4]
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [Finset.sum_add_distrib]
    ring

  have hz : ∀ b : ℝ, simZop h b (fun _ _ => (0:ℝ)) = fun _ _ => 0 := by
    intro b; funext X η; simp [simZop, pdX, pdE]

  obtain ⟨q, hqd⟩ : ∃ q, q = simScale h z (1 - s) := ⟨_, rfl⟩
  rw [← hqd] at hq
  simp only [simLiftSum, simLift, ← hqd]
  obtain ⟨X, hXd⟩ : ∃ X, X = ρ / (2 * q) := ⟨_, rfl⟩
  obtain ⟨η, hηd⟩ : ∃ η, η = z * q ^ (-(1 / 2 - h)) := ⟨_, rfl⟩
  simp only [← hXd, ← hηd]
  have h2q : (2:ℝ) * q ≠ 0 := by positivity
  have hρ : ρ = 2 * q * X := by rw [hXd]; field_simp
  refine (gen q X (fun n => bgVx h n (S n) X η) (fun n => bgUz (S n) X η) (fun n => G n X η)
    (fun n => pdX (G n) X η) (fun n => pdX (pdX (G n)) X η)
    (fun n => simTop h (-(1 + h) + 2 * (n : ℝ) * h) (G n) X η)
    (fun n => simZop h (-(1 + h) + 2 * (n : ℝ) * h) (G n) X η)
    (fun n => simZop h (-(1 + h) + 2 * (n : ℝ) * h - (1 / 2 - h))
      (simZop h (-(1 + h) + 2 * (n : ℝ) * h) (G n)) X η)
    hq hρ ?_ ?_ ?_ ?_ ?_ ?_).trans ?_
  · intro n hn; beta_reduce
    obtain ⟨hS, -, -⟩ := hvan n hn
    rw [hS]; simp [bgVx, bgUz, pdX, pdE]
  · intro n hn; beta_reduce
    obtain ⟨hS, -, -⟩ := hvan n hn
    rw [hS]; simp [bgUz, pdX]
  · intro n hn; beta_reduce
    obtain ⟨-, hG, -⟩ := hvan n hn
    rw [hG]; simp [pdX]
  · intro n hn; beta_reduce
    obtain ⟨-, hG, -⟩ := hvan n hn
    rw [hG, hz]
  · intro n hn; beta_reduce
    obtain ⟨-, hG, -⟩ := hvan n hn
    rw [hG, hz, hz]
  · intro n hn; beta_reduce
    obtain ⟨-, hG, -⟩ := hvan n hn
    rw [hG]; simp [simTop, pdX, pdE]
  · refine Finset.sum_congr rfl (fun k _ => ?_)
    rfl

theorem bg_z_coeff_match : ∀ (h : ℝ) (N : ℕ) (S G W : ℕ → ℝ → ℝ → ℝ) (ρ z s : ℝ), 0 < simScale h z (1 - s) → (∀ n : ℕ, N < n → S n = (fun _ _ => 0) ∧ G n = (fun _ _ => 0) ∧ W n = (fun _ _ => 0)) → frZV ρ (simLiftSum h N (1 / 2) (fun n : ℕ => -1 + 2 * (n : ℝ) * h) (fun n => bgVx h n (S n)) ρ z s) (simLiftSum h N 1 (fun n : ℕ => -(1 / 2 + h) + 2 * (n : ℝ) * h) (fun n => bgUz (S n)) ρ z s) (simLiftSum h N 1 (fun n : ℕ => -(1 / 2 + h) + 2 * (n : ℝ) * h - 1) (fun n => simTop h (-(1 / 2 + h) + 2 * (n : ℝ) * h) (bgUz (S n))) ρ z s) (simLiftSum h N (1 / 2) (fun n : ℕ => -(1 / 2 + h) + 2 * (n : ℝ) * h - 1) (fun n => pdX (bgUz (S n))) ρ z s) (simLiftSum h N (1 / 4) (fun n : ℕ => -(1 / 2 + h) + 2 * (n : ℝ) * h - 1 - 1) (fun n => pdX (pdX (bgUz (S n)))) ρ z s) (simLiftSum h N 1 (fun n : ℕ => -(1 / 2 + h) + 2 * (n : ℝ) * h - (1 / 2 - h)) (fun n => simZop h (-(1 / 2 + h) + 2 * (n : ℝ) * h) (bgUz (S n))) ρ z s) (simLiftSum h N 1 (fun n : ℕ => -(1 / 2 + h) + 2 * (n : ℝ) * h - (1 / 2 - h) - (1 / 2 - h)) (fun n => simZop h (-(1 / 2 + h) + 2 * (n : ℝ) * h - (1 / 2 - h)) (simZop h (-(1 / 2 + h) + 2 * (n : ℝ) * h) (bgUz (S n)))) ρ z s) (simLiftSum h N 1 (fun n : ℕ => -(1 + 2 * h) + 2 * (n : ℝ) * h - (1 / 2 - h)) (fun n => simZop h (-(1 + 2 * h) + 2 * (n : ℝ) * h) (W n)) ρ z s) = ∑ k ∈ Finset.range (2 * N + 2 + 1), simScale h z (1 - s) ^ (-(3 / 2 + h) + 2 * (k : ℝ) * h) * bgResZ h S G W k (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))) :=
by
  intro h N S G W ρ z s hq hvan

  have key : ∀ (q : ℝ) (T P u1 u2 ZZ v u Z : ℕ → ℝ), 0 < q →
      (∀ n : ℕ, N < n → T n = 0 ∧ P n = 0 ∧ u1 n = 0 ∧ u2 n = 0 ∧ ZZ n = 0 ∧ v n = 0 ∧ u n = 0 ∧
        Z n = 0) →
      frZV ρ (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h) * v n))
        (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * u n))
        (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h - 1) * T n))
        (∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h - 1) * u1 n))
        (∑ n ∈ Finset.range (N + 1), 1 / 4 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h - 1 - 1) * u2 n))
        (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h - (1 / 2 - h)) * Z n))
        (∑ n ∈ Finset.range (N + 1),
          1 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h - (1 / 2 - h) - (1 / 2 - h)) * ZZ n))
        (∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 + 2 * h) + 2 * (n : ℝ) * h - (1 / 2 - h)) * P n)) =
      ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(3 / 2 + h) + 2 * (k : ℝ) * h) *
        (T k + P k - 2 * (ρ / (2 * q) * u2 k + u1 k)
          + ∑ i ∈ Finset.range (k + 1), (ρ / (2 * q) * v i * u1 (k - i) + u i * Z (k - i))
          - (if 1 ≤ k then ZZ (k - 1) else 0)) := by
    intro q T P u1 u2 ZZ v u Z hq hs
    have hq0 : q ≠ 0 := hq.ne'

    have H1 : ∀ (g : ℕ → ℝ) (K : ℕ), N + 1 ≤ K → (∀ n : ℕ, N < n → g n = 0) →
        ∑ n ∈ Finset.range (N + 1), g n = ∑ k ∈ Finset.range K, g k := by
      intro g K hK hg
      apply Finset.sum_subset
      · intro x hx
        simp only [Finset.mem_range] at hx ⊢
        omega
      · intro x hx hx'
        simp only [Finset.mem_range] at hx hx'
        exact hg x (by omega)
    have H2 : ∀ g : ℕ → ℝ, (∀ n : ℕ, N < n → g n = 0) →
        ∑ n ∈ Finset.range (N + 1), g n =
          ∑ k ∈ Finset.range (2 * N + 2 + 1), (if 1 ≤ k then g (k - 1) else 0) := by
      intro g hg
      rw [Finset.sum_range_succ' _ (2 * N + 2)]
      have e1 : ∀ k : ℕ, (if 1 ≤ k + 1 then g (k + 1 - 1) else 0) = g k := fun k => by simp
      simp only [e1]
      rw [if_neg (show ¬ (1 ≤ (0:ℕ)) by norm_num), add_zero]
      exact H1 g _ (by omega) hg
    have H3 : ∀ f : ℕ → ℕ → ℝ, (∀ i j : ℕ, (N < i ∨ N < j) → f i j = 0) →
        ∑ i ∈ Finset.range (N + 1), ∑ j ∈ Finset.range (N + 1), f i j =
          ∑ k ∈ Finset.range (2 * N + 2 + 1), ∑ i ∈ Finset.range (k + 1), f i (k - i) := by
      intro f hf
      calc ∑ i ∈ Finset.range (N + 1), ∑ j ∈ Finset.range (N + 1), f i j
          = ∑ i ∈ Finset.range (N + 1), ∑ j ∈ Finset.range (2 * N + 2 + 1 - i), f i j := by
            apply Finset.sum_congr rfl
            intro m hm
            simp only [Finset.mem_range] at hm
            exact H1 (f m) _ (by omega) (fun n hn => hf m n (Or.inr hn))
        _ = ∑ i ∈ Finset.range (2 * N + 2 + 1), ∑ j ∈ Finset.range (2 * N + 2 + 1 - i), f i j :=
            H1 (fun m => ∑ j ∈ Finset.range (2 * N + 2 + 1 - m), f m j) (2 * N + 2 + 1) (by omega)
              (fun n hn => Finset.sum_eq_zero (fun j _ => hf n j (Or.inl hn)))
        _ = ∑ k ∈ Finset.range (2 * N + 2 + 1), ∑ i ∈ Finset.range (k + 1), f i (k - i) :=
            (Finset.sum_range_diag_flip _ _).symm
    unfold frZV
    set gA := ∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-1 + 2 * (n : ℝ) * h) * v n) with hgA
    set gg := ∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) * u n) with hgg
    set gS := ∑ n ∈ Finset.range (N + 1), 1 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h - 1) * T n)
      with hgS
    set gR := ∑ n ∈ Finset.range (N + 1), 1 / 2 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h - 1) * u1 n)
      with hgR
    set gRR := ∑ n ∈ Finset.range (N + 1),
      1 / 4 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h - 1 - 1) * u2 n) with hgRR
    set gZ := ∑ n ∈ Finset.range (N + 1),
      1 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h - (1 / 2 - h)) * Z n) with hgZ
    set gZZ := ∑ n ∈ Finset.range (N + 1),
      1 * (q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h - (1 / 2 - h) - (1 / 2 - h)) * ZZ n) with hgZZ
    set pZ := ∑ n ∈ Finset.range (N + 1),
      1 * (q ^ (-(1 + 2 * h) + 2 * (n : ℝ) * h - (1 / 2 - h)) * P n) with hpZ

    have hLin : gS + pZ - 4 * ρ * gRR - 4 * gR =
        ∑ n ∈ Finset.range (N + 1), q ^ (-(3 / 2 + h) + 2 * (n : ℝ) * h) *
          (T n + P n - 2 * (ρ / (2 * q) * u2 n + u1 n)) := by
      rw [hgS, hpZ, hgRR, hgR, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib,
        ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun n _ => ?_)
      have s1 : q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h - 1) = q ^ (-(3 / 2 + h) + 2 * (n : ℝ) * h) := by
        congr 1; ring
      have s2 : q ^ (-(1 + 2 * h) + 2 * (n : ℝ) * h - (1 / 2 - h)) =
          q ^ (-(3 / 2 + h) + 2 * (n : ℝ) * h) := by
        congr 1; ring
      have s3 : q ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h - 1 - 1) =
          q ^ (-(3 / 2 + h) + 2 * (n : ℝ) * h) / q := by
        rw [← Real.rpow_sub_one hq0]; congr 1; ring
      linear_combination (T n - 2 * u1 n) * s1 + P n * s2 - ρ * u2 n * s3

    have hZZ : gZZ = ∑ n ∈ Finset.range (N + 1),
        q ^ (-(3 / 2 + h) + 2 * ((n + 1 : ℕ) : ℝ) * h) * ZZ n := by
      rw [hgZZ]
      refine Finset.sum_congr rfl (fun n _ => ?_)
      have e : -(1 / 2 + h) + 2 * (n : ℝ) * h - (1 / 2 - h) - (1 / 2 - h) =
          -(3 / 2 + h) + 2 * ((n + 1 : ℕ) : ℝ) * h := by push_cast; ring
      rw [one_mul, e]

    have hP1 : 2 * ρ * gA * gR + gg * gZ = ∑ i ∈ Finset.range (N + 1), ∑ j ∈ Finset.range (N + 1),
        q ^ (-(3 / 2 + h) + 2 * ((i + j : ℕ) : ℝ) * h) * (ρ / (2 * q) * v i * u1 j + u i * Z j) := by
      rw [hgA, hgR, hgg, hgZ, mul_assoc (2 * ρ), Finset.sum_mul_sum, Finset.sum_mul_sum,
        Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      have r1 : q ^ (-1 + 2 * (i : ℝ) * h) * q ^ (-(1 / 2 + h) + 2 * (j : ℝ) * h - 1) =
          q ^ (-(3 / 2 + h) + 2 * ((i + j : ℕ) : ℝ) * h) / q := by
        rw [← Real.rpow_add hq, ← Real.rpow_sub_one hq0]; congr 1; push_cast; ring
      have r2 : q ^ (-(1 / 2 + h) + 2 * (i : ℝ) * h) *
          q ^ (-(1 / 2 + h) + 2 * (j : ℝ) * h - (1 / 2 - h)) =
          q ^ (-(3 / 2 + h) + 2 * ((i + j : ℕ) : ℝ) * h) := by
        rw [← Real.rpow_add hq]; congr 1; push_cast; ring
      linear_combination (ρ / 2 * v i * u1 j) * r1 + (u i * Z j) * r2

    have hL : ∑ n ∈ Finset.range (N + 1), q ^ (-(3 / 2 + h) + 2 * (n : ℝ) * h) *
          (T n + P n - 2 * (ρ / (2 * q) * u2 n + u1 n)) =
        ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(3 / 2 + h) + 2 * (k : ℝ) * h) *
          (T k + P k - 2 * (ρ / (2 * q) * u2 k + u1 k)) := by
      refine H1 (fun n => q ^ (-(3 / 2 + h) + 2 * (n : ℝ) * h) *
          (T n + P n - 2 * (ρ / (2 * q) * u2 n + u1 n))) _ (by omega) ?_
      intro n hn
      obtain ⟨e1, e2, e3, e4, -⟩ := hs n hn
      simp [e1, e2, e3, e4]
    have hC := H3 (fun i j => q ^ (-(3 / 2 + h) + 2 * ((i + j : ℕ) : ℝ) * h) *
        (ρ / (2 * q) * v i * u1 j + u i * Z j)) (by
      intro i j hij
      rcases hij with hi | hj
      · obtain ⟨-, -, -, -, -, e6, e7, -⟩ := hs i hi
        simp [e6, e7]
      · obtain ⟨-, -, e3, -, -, -, -, e8⟩ := hs j hj
        simp [e3, e8])
    beta_reduce at hC
    have hC2 : ∑ k ∈ Finset.range (2 * N + 2 + 1), ∑ i ∈ Finset.range (k + 1),
          q ^ (-(3 / 2 + h) + 2 * ((i + (k - i) : ℕ) : ℝ) * h) *
            (ρ / (2 * q) * v i * u1 (k - i) + u i * Z (k - i)) =
        ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(3 / 2 + h) + 2 * (k : ℝ) * h) *
          ∑ i ∈ Finset.range (k + 1), (ρ / (2 * q) * v i * u1 (k - i) + u i * Z (k - i)) := by
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      rw [Nat.add_sub_of_le (Finset.mem_range_succ_iff.mp hi)]
    have hZ2 := H2 (fun n => q ^ (-(3 / 2 + h) + 2 * ((n + 1 : ℕ) : ℝ) * h) * ZZ n) (by
      intro n hn
      obtain ⟨-, -, -, -, e5, -⟩ := hs n hn
      simp [e5])
    beta_reduce at hZ2
    have hI : ∑ k ∈ Finset.range (2 * N + 2 + 1),
          (if 1 ≤ k then q ^ (-(3 / 2 + h) + 2 * ((k - 1 + 1 : ℕ) : ℝ) * h) * ZZ (k - 1) else 0) =
        ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(3 / 2 + h) + 2 * (k : ℝ) * h) *
          (if 1 ≤ k then ZZ (k - 1) else 0) := by
      refine Finset.sum_congr rfl (fun k _ => ?_)
      split_ifs with hk
      · rw [Nat.sub_add_cancel hk]
      · simp
    have hsplit : ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(3 / 2 + h) + 2 * (k : ℝ) * h) *
          (T k + P k - 2 * (ρ / (2 * q) * u2 k + u1 k)
            + ∑ i ∈ Finset.range (k + 1), (ρ / (2 * q) * v i * u1 (k - i) + u i * Z (k - i))
            - (if 1 ≤ k then ZZ (k - 1) else 0)) =
        ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(3 / 2 + h) + 2 * (k : ℝ) * h) *
            (T k + P k - 2 * (ρ / (2 * q) * u2 k + u1 k))
          + ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(3 / 2 + h) + 2 * (k : ℝ) * h) *
            ∑ i ∈ Finset.range (k + 1), (ρ / (2 * q) * v i * u1 (k - i) + u i * Z (k - i))
          - ∑ k ∈ Finset.range (2 * N + 2 + 1), q ^ (-(3 / 2 + h) + 2 * (k : ℝ) * h) *
            (if 1 ≤ k then ZZ (k - 1) else 0) := by
      rw [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      ring
    linear_combination hLin + hP1 - hZZ - hsplit + hL + hC + hC2 - hZ2 - hI

  have hpdX0 : ∀ X η : ℝ, pdX (fun _ _ => (0:ℝ)) X η = 0 := fun X η => by simp [pdX]
  have hpdE0 : ∀ X η : ℝ, pdE (fun _ _ => (0:ℝ)) X η = 0 := fun X η => by simp [pdE]
  have hpdXf : pdX (fun _ _ => (0:ℝ)) = fun _ _ => 0 := by
    funext X η; exact hpdX0 X η
  have hUz0 : bgUz (fun _ _ => (0:ℝ)) = fun _ _ => 0 := by
    funext X η; simp [bgUz, hpdX0]
  have hTop0 : ∀ b : ℝ, simTop h b (fun _ _ => (0:ℝ)) = fun _ _ => 0 := by
    intro b; funext X η; simp [simTop, hpdX0, hpdE0]
  have hZop0 : ∀ b : ℝ, simZop h b (fun _ _ => (0:ℝ)) = fun _ _ => 0 := by
    intro b; funext X η; simp [simZop, hpdX0, hpdE0]
  have hVx0 : ∀ n : ℕ, bgVx h n (fun _ _ => (0:ℝ)) = fun _ _ => 0 := by
    intro n; funext X η; simp [bgVx, hUz0, hpdE0]
  exact key (simScale h z (1 - s))
    (fun n => simTop h (-(1 / 2 + h) + 2 * (n : ℝ) * h) (bgUz (S n))
      (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))))
    (fun n => simZop h (-(1 + 2 * h) + 2 * (n : ℝ) * h) (W n)
      (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))))
    (fun n => pdX (bgUz (S n))
      (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))))
    (fun n => pdX (pdX (bgUz (S n)))
      (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))))
    (fun n => simZop h (-(1 / 2 + h) + 2 * (n : ℝ) * h - (1 / 2 - h))
      (simZop h (-(1 / 2 + h) + 2 * (n : ℝ) * h) (bgUz (S n)))
      (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))))
    (fun n => bgVx h n (S n)
      (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))))
    (fun n => bgUz (S n)
      (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))))
    (fun n => simZop h (-(1 / 2 + h) + 2 * (n : ℝ) * h) (bgUz (S n))
      (ρ / (2 * simScale h z (1 - s))) (z * simScale h z (1 - s) ^ (-(1 / 2 - h))))
    hq (fun n hn => by
      obtain ⟨hS, -, hW⟩ := hvan n hn
      simp [hS, hW, hUz0, hTop0, hZop0, hpdXf, hVx0])

theorem bg_residual_expansion : ∀ (h ε : ℝ) (N : ℕ) (S G W : ℕ → ℝ → ℝ → ℝ), 0 < h → h < 1 / 2 → SimScaleProps h → 0 < ε → (∀ n : ℕ, ContDiffOn ℝ ∞ (↿(S n)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(G n)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(W n)) (Ioi (-ε) ×ˢ Ioo (-1) 1)) → (∀ n : ℕ, N < n → S n = (fun _ _ => 0) ∧ G n = (fun _ _ => 0) ∧ W n = (fun _ _ => 0)) → ∀ (x : ℝ³) (t : ℝ), t < 1 → 0 < x 0 ^ 2 + x 1 ^ 2 → nsResidual 1 (fun y s => curl3 (fun w => ∑ n ∈ Finset.range (N + 1), bgAn h n (S n) w s) y + ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y s) (fun y s => ∑ n ∈ Finset.range (N + 1), bgPn h n (W n) y s) x t = bgResField h S G W (2 * N + 2) x t :=
by
  intro h ε N S G W hh0 hh1 hS hε hsm hvan x t ht hx
  have fα : ∀ n : ℕ, ContDiffOn ℝ ∞ (↿((fun n => bgVx h n (S n)) n)) (Ioi (-ε) ×ˢ Ioo (-1) 1) :=
    fun n => (sim_profile_closure h ε 0 n (S n) hh0 hh1 hε (hsm n).1).2.2.2.2.2
  have fγ : ∀ n : ℕ, ContDiffOn ℝ ∞ (↿((fun n => bgUz (S n)) n)) (Ioi (-ε) ×ˢ Ioo (-1) 1) :=
    fun n => (sim_profile_closure h ε 0 n (S n) hh0 hh1 hε (hsm n).1).2.2.2.2.1
  have fβ : ∀ n : ℕ, ContDiffOn ℝ ∞ (↿(G n)) (Ioi (-ε) ×ˢ Ioo (-1) 1) := fun n => (hsm n).2.1
  have fP : ∀ n : ℕ, ContDiffOn ℝ ∞ (↿(W n)) (Ioi (-ε) ×ˢ Ioo (-1) 1) := fun n => (hsm n).2.2
  obtain ⟨sα, dα⟩ := sim_sum_calculus h ε (1 / 2) N (fun n : ℕ => -1 + 2 * (n : ℝ) * h)
    (fun n => bgVx h n (S n)) hh0 hh1 hS hε fα
  obtain ⟨sβ, dβ⟩ := sim_sum_calculus h ε 1 N (fun n : ℕ => -(1 + h) + 2 * (n : ℝ) * h) G hh0 hh1 hS hε fβ
  obtain ⟨sγ, dγ⟩ := sim_sum_calculus h ε 1 N (fun n : ℕ => -(1 / 2 + h) + 2 * (n : ℝ) * h)
    (fun n => bgUz (S n)) hh0 hh1 hS hε fγ
  obtain ⟨sP, dP⟩ := sim_sum_calculus h ε 1 N (fun n : ℕ => -(1 + 2 * h) + 2 * (n : ℝ) * h) W hh0 hh1 hS hε fP
  have hu : ∀ (y : ℝ³) (s : ℝ), s < 1 → 0 < y 0 ^ 2 + y 1 ^ 2 →
      curl3 (fun w => ∑ n ∈ Finset.range (N + 1), bgAn h n (S n) w s) y +
        ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y s =
      simLiftSum h N (1 / 2) (fun n : ℕ => -1 + 2 * (n : ℝ) * h) (fun n => bgVx h n (S n))
          (y 0 ^ 2 + y 1 ^ 2) (y 2) s • radVec y +
        simLiftSum h N 1 (fun n : ℕ => -(1 + h) + 2 * (n : ℝ) * h) G (y 0 ^ 2 + y 1 ^ 2) (y 2) s • azVec y +
        simLiftSum h N 1 (fun n : ℕ => -(1 / 2 + h) + 2 * (n : ℝ) * h) (fun n => bgUz (S n))
          (y 0 ^ 2 + y 1 ^ 2) (y 2) s • EuclideanSpace.single (2 : Fin 3) (1 : ℝ) := by
    intro y s hs hy
    rw [bg_velocity_frame h ε N S hh0 hh1 hS hε (fun n => (hsm n).1) y s hs hy]
    have hB : ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y s =
        simLiftSum h N 1 (fun n : ℕ => -(1 + h) + 2 * (n : ℝ) * h) G (y 0 ^ 2 + y 1 ^ 2) (y 2) s • azVec y := by
      simp only [simLiftSum, simLift, bgBn, Finset.sum_smul, one_mul, simX, simEta]
    rw [hB]
    abel
  have hp : ∀ (y : ℝ³) (s : ℝ), s < 1 → 0 < y 0 ^ 2 + y 1 ^ 2 →
      ∑ n ∈ Finset.range (N + 1), bgPn h n (W n) y s =
        simLiftSum h N 1 (fun n : ℕ => -(1 + 2 * h) + 2 * (n : ℝ) * h) W (y 0 ^ 2 + y 1 ^ 2) (y 2) s := by
    intro y s _ _
    simp only [simLiftSum, simLift, bgPn, one_mul, simX, simEta]
  have hR := axisym_frame_residual
    (fun y s => curl3 (fun w => ∑ n ∈ Finset.range (N + 1), bgAn h n (S n) w s) y +
      ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y s)
    (fun y s => ∑ n ∈ Finset.range (N + 1), bgPn h n (W n) y s)
    (simLiftSum h N (1 / 2) (fun n : ℕ => -1 + 2 * (n : ℝ) * h) (fun n => bgVx h n (S n)))
    (simLiftSum h N 1 (fun n : ℕ => -(1 + h) + 2 * (n : ℝ) * h) G)
    (simLiftSum h N 1 (fun n : ℕ => -(1 / 2 + h) + 2 * (n : ℝ) * h) (fun n => bgUz (S n)))
    (simLiftSum h N 1 (fun n : ℕ => -(1 + 2 * h) + 2 * (n : ℝ) * h) W)
    sα sβ sγ sP hu hp x t ht hx
  obtain ⟨a1, a2, a3, a4, a5⟩ := dα (x 0 ^ 2 + x 1 ^ 2) (x 2) t hx ht
  obtain ⟨b1, b2, b3, b4, b5⟩ := dβ (x 0 ^ 2 + x 1 ^ 2) (x 2) t hx ht
  obtain ⟨g1, g2, g3, g4, g5⟩ := dγ (x 0 ^ 2 + x 1 ^ 2) (x 2) t hx ht
  obtain ⟨-, p2, -, p4, -⟩ := dP (x 0 ^ 2 + x 1 ^ 2) (x 2) t hx ht
  have hq : 0 < simScale h (x 2) (1 - t) := (hS.1 (x 2) (1 - t) (by linarith)).1
  rw [hR, a1, a2, a3, a4, a5, b1, b2, b3, b4, b5, g1, g2, g3, g4, g5, p2, p4,
    bg_rad_coeff_match h N S G W (x 0 ^ 2 + x 1 ^ 2) (x 2) t hq hvan,
    bg_th_coeff_match h N S G W (x 0 ^ 2 + x 1 ^ 2) (x 2) t hq hvan,
    bg_z_coeff_match h N S G W (x 0 ^ 2 + x 1 ^ 2) (x 2) t hq hvan]
  simp only [bgResField, simX, simEta, Finset.sum_add_distrib, Finset.sum_smul]

theorem bg_residual_offaxis : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) (S G W : ℕ → ℝ → ℝ → ℝ), SimScaleProps h → LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → Xa < Xm → Xm < Xs → Xs < Xb → BgCoeffSeq h Xm Xs m1 m2 F U S G W → ∀ (N : ℕ) (x : ℝ³) (t : ℝ), t < 1 → 0 < x 0 ^ 2 + x 1 ^ 2 → nsResidual 1 (fun y' s' => curl3 (fun w => ∑ n ∈ Finset.range (N + 1), bgAn h n (S n) w s') y' + ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y' s') (fun y' s' => ∑ n ∈ Finset.range (N + 1), bgPn h n (W n) y' s') x t - stressDivField h (bgTsum h (bgTthSeq h T0th S G W) N) (bgTsum h (bgTzSeq h T0z S G W) N) x t = bgResTail h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) N x t :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs F U T0th T0z S G W hS hL hXam hXms hXsb hB
    N x t ht hr

  have hL' := hL
  unfold LeadingProfile at hL'
  obtain ⟨⟨hh0, hh1, -, -, -, -, -, hXa, -⟩, -, ⟨hT0s, hT0zs, -⟩, -, ⟨εL, hεL, hFs, hUs, -⟩, -⟩ := hL'
  have hB' := hB
  unfold BgCoeffSeq at hB'
  obtain ⟨⟨hS0, hG0, hW0⟩, ⟨εB, hεB, hBsm⟩, -, -, -, hBrad, hBin, hBint⟩ := hB'
  obtain ⟨εP, hεP, hPs, -⟩ :=
    leadPi_smooth_bounds h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hL
  obtain ⟨ε8, hε8, hR⟩ :=
    bg_coef_regular h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs F U T0th T0z S G W hS hL hB
  have hV := bg_res_vanish h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs F U T0th T0z S G W
    hS hL hXam hXms hXsb hB
  have hXm0 : 0 < Xm := by linarith
  have hXmb : Xm < Xb := by linarith
  have h9 := fun (n : ℕ) (hn : 1 ≤ n) =>
    stress_prim_props (bgResTh h S G W n) (bgResZ h S G W n) ε8 Xm Xb hε8 hXm0 hXmb (hR n hn).1
      (hR n hn).2.1 (fun m => (hR n hn).2.2.2.2.1 Xb m)
      (fun X η hX0 hXm h1 h2 => hBin n hn X η hX0 hXm h1 h2)
      (fun X η hX h1 h2 => hV n hn X η h1 h2 (Or.inl hX))
      (fun η h1 h2 => hBint n hn η h1 h2)

  have hper : ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → ∀ n : ℕ,
      (DifferentiableAt ℝ (fun Y => bgTthSeq h T0th S G W n Y η) X ∧
        DifferentiableAt ℝ (fun Y => bgTzSeq h T0z S G W n Y η) X) ∧
      (deriv (fun Y => bgTthSeq h T0th S G W n Y η) X + bgTthSeq h T0th S G W n X η / X =
          -bgResTh h S G W n X η ∧
        Real.sqrt (2 * X) * (deriv (fun Y => bgTzSeq h T0z S G W n Y η) X +
          bgTzSeq h T0z S G W n X η / (2 * X)) = -bgResZ h S G W n X η) := by
    intro X η hX0 hη1 hη2 n
    have hslice : ∀ f : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿f) (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) →
        DifferentiableAt ℝ (fun Y => f Y η) X := by
      intro f hf
      have hca := hf.contDiffAt ((isOpen_Ioi.prod isOpen_Ioo).mem_nhds
        (show (X, η) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 from ⟨hX0, hη1, hη2⟩))
      have hin : DifferentiableAt ℝ (fun Y : ℝ => ((Y, η) : ℝ × ℝ)) X :=
        differentiableAt_id.prodMk (differentiableAt_const η)
      have hc := (hca.differentiableAt (by norm_num)).comp X hin
      exact hc
    rcases Nat.eq_zero_or_pos n with hn | hn
    · subst hn
      have e1 : bgTthSeq h T0th S G W 0 = fun X η => if 0 < X then T0th X η else 0 := by
        simp [bgTthSeq]
      have e2 : bgTzSeq h T0z S G W 0 = fun X η => if 0 < X then T0z X η else 0 := by
        simp [bgTzSeq]
      have hev1 : (fun Y => bgTthSeq h T0th S G W 0 Y η) =ᶠ[nhds X] (fun Y => T0th Y η) := by
        filter_upwards [Ioi_mem_nhds hX0] with Y hY
        rw [e1]
        exact if_pos (show (0:ℝ) < Y from hY)
      have hev2 : (fun Y => bgTzSeq h T0z S G W 0 Y η) =ᶠ[nhds X] (fun Y => T0z Y η) := by
        filter_upwards [Ioi_mem_nhds hX0] with Y hY
        rw [e2]
        exact if_pos (show (0:ℝ) < Y from hY)
      have hv1 : bgTthSeq h T0th S G W 0 X η = T0th X η := by
        rw [e1]
        exact if_pos hX0
      have hv2 : bgTzSeq h T0z S G W 0 X η = T0z X η := by
        rw [e2]
        exact if_pos hX0
      refine ⟨⟨(hslice T0th hT0s).congr_of_eventuallyEq hev1,
        (hslice T0z hT0zs).congr_of_eventuallyEq hev2⟩, ?_, ?_⟩
      · rw [hev1.deriv_eq, hv1, bg_lead_th_identity h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab
          F U T0th T0z S G W hL hS0 hG0 X η hX0 hη1 hη2, neg_neg]
      · rw [hev2.deriv_eq, hv2, bg_lead_z_identity h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab
          F U T0th T0z S G W hL hS0 hW0 X η hX0 hη1 hη2, neg_neg]
    · have e1 : bgTthSeq h T0th S G W n = stressPrimTh (bgResTh h S G W n) := by
        simp [bgTthSeq, show n ≠ 0 by omega]
      have e2 : bgTzSeq h T0z S G W n = stressPrimZ (bgResZ h S G W n) := by
        simp [bgTzSeq, show n ≠ 0 by omega]
      obtain ⟨t1, t2, -, t4, -⟩ := h9 n (by omega)
      rw [e1, e2]
      exact ⟨⟨hslice _ t1, hslice _ t2⟩, t4 X η hX0 hη1 hη2⟩

  have hH1 : ∀ q X η : ℝ, 0 < q → 0 < X → -1 < η → η < 1 →
      -(q ^ (-(2 + h)) * (deriv (fun Y => bgTsum h (bgTthSeq h T0th S G W) N q Y η) X
        + bgTsum h (bgTthSeq h T0th S G W) N q X η / X)) =
      ∑ k ∈ Finset.range (N + 1), q ^ (-(2 + h) + 2 * (k : ℝ) * h) * bgResTh h S G W k X η := by
    intro q X η hq0 hX0 hη1 hη2
    have hdf : ∀ n ∈ Finset.range (N + 1),
        DifferentiableAt ℝ (fun Y => q ^ (2 * (n : ℝ) * h) * bgTthSeq h T0th S G W n Y η) X :=
      fun n _ => ((hper X η hX0 hη1 hη2 n).1.1).const_mul _
    have hd : deriv (fun Y => bgTsum h (bgTthSeq h T0th S G W) N q Y η) X =
        ∑ n ∈ Finset.range (N + 1),
          q ^ (2 * (n : ℝ) * h) * deriv (fun Y => bgTthSeq h T0th S G W n Y η) X := by
      unfold bgTsum
      rw [deriv_fun_sum hdf]
      exact Finset.sum_congr rfl (fun n _ => deriv_const_mul _ (hper X η hX0 hη1 hη2 n).1.1)
    rw [hd]
    unfold bgTsum
    rw [Finset.sum_div, ← Finset.sum_add_distrib, Finset.mul_sum, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun n _ => ?_)
    rw [Real.rpow_add hq0]
    linear_combination (-(q ^ (-(2 + h)) * q ^ (2 * (n : ℝ) * h))) * (hper X η hX0 hη1 hη2 n).2.1
  have hH2 : ∀ q X η : ℝ, 0 < q → 0 < X → -1 < η → η < 1 →
      -(Real.sqrt (2 * X) * q ^ (-(3 / 2 + h)) *
        (deriv (fun Y => bgTsum h (bgTzSeq h T0z S G W) N q Y η) X
          + bgTsum h (bgTzSeq h T0z S G W) N q X η / (2 * X))) =
      ∑ k ∈ Finset.range (N + 1), q ^ (-(3 / 2 + h) + 2 * (k : ℝ) * h) * bgResZ h S G W k X η := by
    intro q X η hq0 hX0 hη1 hη2
    have hdf : ∀ n ∈ Finset.range (N + 1),
        DifferentiableAt ℝ (fun Y => q ^ (2 * (n : ℝ) * h) * bgTzSeq h T0z S G W n Y η) X :=
      fun n _ => ((hper X η hX0 hη1 hη2 n).1.2).const_mul _
    have hd : deriv (fun Y => bgTsum h (bgTzSeq h T0z S G W) N q Y η) X =
        ∑ n ∈ Finset.range (N + 1),
          q ^ (2 * (n : ℝ) * h) * deriv (fun Y => bgTzSeq h T0z S G W n Y η) X := by
      unfold bgTsum
      rw [deriv_fun_sum hdf]
      exact Finset.sum_congr rfl (fun n _ => deriv_const_mul _ (hper X η hX0 hη1 hη2 n).1.2)
    rw [hd]
    unfold bgTsum
    rw [Finset.sum_div, ← Finset.sum_add_distrib, Finset.mul_sum, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun n _ => ?_)
    rw [Real.rpow_add hq0]
    linear_combination (-(q ^ (-(3 / 2 + h)) * q ^ (2 * (n : ℝ) * h))) * (hper X η hX0 hη1 hη2 n).2.2

  have hrad : ∀ X η : ℝ, 0 < X → -1 < η → η < 1 → ∀ k : ℕ, bgResRad h S G W k X η = 0 := by
    intro X η hX0 hη1 hη2 k
    rcases Nat.eq_zero_or_pos k with hk | hk
    · subst hk
      have hd := ((lead_pi_calculus h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hL η
        hη1 hη2).2.2 X hX0).deriv
      unfold bgResRad pdX
      rw [Finset.sum_range_succ, Finset.sum_range_zero, Nat.sub_self, hW0, hG0, hd,
        if_neg (show ¬ (1 ≤ 0) by norm_num)]
      ring
    · exact hBrad k (by omega) X η hX0 hη1 hη2

  have hloc : ∀ k : ℕ, k ≤ N → ∀ X η : ℝ,
      bgResTh h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k X η = bgResTh h S G W k X η ∧
      bgResZ h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k X η = bgResZ h S G W k X η ∧
      bgResRad h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k X η = bgResRad h S G W k X η := by
    intro k hk X η
    exact bgRes_local h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) S G W k univ isOpen_univ
      (fun i hi p _ => by simp [bgTrunc, show i ≤ N by omega]) (X, η) (mem_univ _)

  have hq0 : 0 < simScale h (x 2) (1 - t) := (hS.1 (x 2) (1 - t) (by linarith)).1
  have hX0 : 0 < simX h x t := by
    unfold simX
    exact div_pos hr (by linarith)
  have hz := (hS.2.1 (x 2) (1 - t) (by linarith)).2
  obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = simScale h (x 2) (1 - t) ^ (-(1 / 2 - h)) := ⟨_, rfl⟩
  have ha : 0 < a := by rw [ha_def]; exact Real.rpow_pos_of_pos hq0 _
  have hsq : a * a * simScale h (x 2) (1 - t) ^ (1 - 2 * h) = 1 := by
    rw [ha_def, ← Real.rpow_add hq0, ← Real.rpow_add hq0,
      show -(1 / 2 - h) + -(1 / 2 - h) + (1 - 2 * h) = 0 by ring, Real.rpow_zero]
  have hηsq : simEta h x t ^ 2 < 1 := by
    have e : simEta h x t ^ 2 = x 2 ^ 2 * (a * a) := by
      rw [ha_def]
      unfold simEta
      ring
    rw [e, ← hsq]
    have haa : 0 < a * a := mul_pos ha ha
    calc x 2 ^ 2 * (a * a) = (a * a) * x 2 ^ 2 := by ring
      _ < (a * a) * simScale h (x 2) (1 - t) ^ (1 - 2 * h) := mul_lt_mul_of_pos_left hz haa
  have hη := abs_lt.mp ((sq_lt_one_iff_abs_lt_one _).mp hηsq)

  obtain ⟨ε, hεdef⟩ : ∃ ε : ℝ, ε = min εL (min εP εB) := ⟨_, rfl⟩
  have hε0 : 0 < ε := by rw [hεdef]; exact lt_min hεL (lt_min hεP hεB)
  have hεL' : ε ≤ εL := by rw [hεdef]; exact min_le_left _ _
  have hεP' : ε ≤ εP := by rw [hεdef]; exact (min_le_right _ _).trans (min_le_left _ _)
  have hεB' : ε ≤ εB := by rw [hεdef]; exact (min_le_right _ _).trans (min_le_right _ _)
  have hsub : ∀ e : ℝ, ε ≤ e → Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi (-e) ×ˢ Ioo (-1) 1 :=
    fun e he => prod_mono (fun y hy => by simp only [mem_Ioi] at hy ⊢; linarith) subset_rfl
  have hsm : ∀ n : ℕ, ContDiffOn ℝ ∞ (↿(bgTrunc N S n)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
      ContDiffOn ℝ ∞ (↿(bgTrunc N G n)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
      ContDiffOn ℝ ∞ (↿(bgTrunc N W n)) (Ioi (-ε) ×ˢ Ioo (-1) 1) := by
    intro n
    by_cases hnN : n ≤ N
    · have e : ∀ T : ℕ → ℝ → ℝ → ℝ, bgTrunc N T n = T n := fun T => by simp [bgTrunc, hnN]
      rw [e S, e G, e W]
      rcases Nat.eq_zero_or_pos n with hn | hn
      · subst hn
        rw [hS0, hG0, hW0]
        exact ⟨((profRadAvg_props U εL hεL hUs).1).mono (hsub _ hεL'), hFs.mono (hsub _ hεL'),
          hPs.mono (hsub _ hεP')⟩
      · obtain ⟨a1, a2, a3⟩ := hBsm n (by omega)
        exact ⟨a1.mono (hsub _ hεB'), a2.mono (hsub _ hεB'), a3.mono (hsub _ hεB')⟩
    · have e : ∀ T : ℕ → ℝ → ℝ → ℝ, bgTrunc N T n = fun _ _ => 0 := fun T => by
        simp [bgTrunc, hnN]
      rw [e S, e G, e W]
      exact ⟨contDiffOn_const, contDiffOn_const, contDiffOn_const⟩
  have hvan0 : ∀ n : ℕ, N < n → bgTrunc N S n = (fun _ _ => 0) ∧ bgTrunc N G n = (fun _ _ => 0) ∧
      bgTrunc N W n = (fun _ _ => 0) := by
    intro n hn
    simp [bgTrunc, show ¬ n ≤ N by omega]

  have hexp := bg_residual_expansion h ε N (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) hh0
    (by linarith) hS hε0 hsm hvan0 x t ht hr
  have hTr : ∀ (T : ℕ → ℝ → ℝ → ℝ) (n : ℕ), n ∈ Finset.range (N + 1) → bgTrunc N T n = T n :=
    fun T n hn => by simp [bgTrunc, Finset.mem_range_succ_iff.mp hn]
  have hTrS : ∀ (w : ℝ³) (s' : ℝ), ∑ n ∈ Finset.range (N + 1), bgAn h n (bgTrunc N S n) w s' =
      ∑ n ∈ Finset.range (N + 1), bgAn h n (S n) w s' :=
    fun w s' => Finset.sum_congr rfl (fun n hn => by rw [hTr S n hn])
  have hTrG : ∀ (w : ℝ³) (s' : ℝ), ∑ n ∈ Finset.range (N + 1), bgBn h n (bgTrunc N G n) w s' =
      ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) w s' :=
    fun w s' => Finset.sum_congr rfl (fun n hn => by rw [hTr G n hn])
  have hTrW : ∀ (w : ℝ³) (s' : ℝ), ∑ n ∈ Finset.range (N + 1), bgPn h n (bgTrunc N W n) w s' =
      ∑ n ∈ Finset.range (N + 1), bgPn h n (W n) w s' :=
    fun w s' => Finset.sum_congr rfl (fun n hn => by rw [hTr W n hn])
  simp only [hTrS, hTrG, hTrW] at hexp

  have hsplit : bgResField h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) (2 * N + 2) x t =
      bgResField h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) N x t +
        bgResTail h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) N x t := by
    unfold bgResField bgResTail
    rw [show 2 * N + 2 + 1 = 2 * N + 3 by omega]
    exact (Finset.sum_range_add_sum_Ico _ (by omega)).symm

  have hhead : stressDivField h (bgTsum h (bgTthSeq h T0th S G W) N) (bgTsum h (bgTzSeq h T0z S G W) N) x t =
      bgResField h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) N x t := by
    unfold stressDivField bgResField
    rw [hH1 _ _ _ hq0 hX0 hη.1 hη.2, hH2 _ _ _ hq0 hX0 hη.1 hη.2, Finset.sum_smul, Finset.sum_smul,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun k hk => ?_)
    obtain ⟨e1, e2, e3⟩ := hloc k (Finset.mem_range_succ_iff.mp hk) (simX h x t) (simEta h x t)
    rw [e1, e2, e3, hrad _ _ hX0 hη.1 hη.2 k, mul_zero, zero_smul, zero_add]
  rw [hexp, hsplit, hhead]
  abel

theorem simQ_props : ∀ (h qs : ℝ), 0 < h → h < 1 / 2 → SimScaleProps h → ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} ∧ IsOpen (simDomain h qs) ∧ (∀ w : ℝ³ × ℝ, w.2 < 1 → 0 < simScale h (w.1 2) (1 - w.2)) ∧ (∀ k : ℕ, 1 ≤ k → ∃ C : ℝ, ∀ w : ℝ³ × ℝ, w.2 < 1 → simScale h (w.1 2) (1 - w.2) ≤ 1 → ‖iteratedFDeriv ℝ k (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) w‖ ≤ C * simScale h (w.1 2) (1 - w.2) ^ (1 - (k : ℝ))) :=
by
  intro h qs hh0 hh1 hS
  obtain ⟨hS1, -, -, hS4, hS5⟩ := hS
  obtain ⟨L₀, hL₀def⟩ : ∃ L : (EuclideanSpace ℝ (Fin 3)) × ℝ →L[ℝ] ℝ × ℝ,
      L = ((EuclideanSpace.proj (2 : Fin 3) : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ).comp
        (ContinuousLinearMap.fst ℝ (EuclideanSpace ℝ (Fin 3)) ℝ)).prod
        (-(ContinuousLinearMap.snd ℝ (EuclideanSpace ℝ (Fin 3)) ℝ)) := ⟨_, rfl⟩
  have hL₀ : ∀ v : ℝ³ × ℝ, L₀ v = (v.1 2, -v.2) := by
    intro v; rw [hL₀def]; rfl
  have hΦ : ∀ v : ℝ³ × ℝ, L₀ v + ((0:ℝ), (1:ℝ)) = (v.1 2, 1 - v.2) := by
    intro v
    rw [hL₀, Prod.mk_add_mk, add_zero]
    congr 1
    ring
  have hfun : (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) =
      (fun y : ℝ × ℝ => (fun p : ℝ × ℝ => simScale h p.1 p.2) (y + ((0:ℝ), (1:ℝ)))) ∘ L₀ := by
    funext v
    simp only [Function.comp]
    rw [hΦ v]
  have hT : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
  have ha : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    rw [hfun]
    refine hS4.comp ((contDiff_id.add contDiff_const).comp L₀.contDiff).contDiffOn ?_
    intro w hw
    show L₀ w + ((0:ℝ), (1:ℝ)) ∈ _
    rw [hΦ w]
    exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
  have hb : IsOpen (simDomain h qs) := by
    have e : simDomain h qs = {w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) ⁻¹' Iio qs := rfl
    rw [e]
    exact ha.continuousOn.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const)
      isOpen_Iio
  have hc : ∀ w : ℝ³ × ℝ, w.2 < 1 → 0 < simScale h (w.1 2) (1 - w.2) :=
    fun w hw => (hS1 (w.1 2) (1 - w.2) (sub_pos.mpr hw)).1
  have hLn : ‖L₀‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => ?_)
    rw [hL₀, one_mul, Prod.norm_def, Prod.norm_def]
    simp only [norm_neg]
    exact max_le_max (PiLp.norm_apply_le x.1 2) le_rfl
  refine ⟨ha, hb, hc, ?_⟩
  intro k hk
  obtain ⟨C, hC⟩ := hS5 k hk
  refine ⟨C, fun w hw hq1 => ?_⟩
  have hso : IsOpen ((fun y : ℝ × ℝ => y + ((0:ℝ), (1:ℝ))) ⁻¹' (univ ×ˢ Ioi (0:ℝ))) :=
    hT.preimage (continuous_id.add continuous_const)
  have hg₁ : ContDiffOn ℝ ∞
      (fun y : ℝ × ℝ => (fun p : ℝ × ℝ => simScale h p.1 p.2) (y + ((0:ℝ), (1:ℝ))))
      ((fun y : ℝ × ℝ => y + ((0:ℝ), (1:ℝ))) ⁻¹' (univ ×ˢ Ioi (0:ℝ))) :=
    hS4.comp (contDiff_id.add contDiff_const).contDiffOn (fun y hy => hy)
  have hLw : L₀ w ∈ (fun y : ℝ × ℝ => y + ((0:ℝ), (1:ℝ))) ⁻¹' (univ ×ˢ Ioi (0:ℝ)) := by
    rw [Set.mem_preimage, hΦ w]
    exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
  have hLso : IsOpen (L₀ ⁻¹' ((fun y : ℝ × ℝ => y + ((0:ℝ), (1:ℝ))) ⁻¹' (univ ×ˢ Ioi (0:ℝ)))) :=
    hso.preimage L₀.continuous
  have key := ContinuousLinearMap.iteratedFDerivWithin_comp_right L₀ hg₁ hso.uniqueDiffOn
    hLso.uniqueDiffOn hLw (i := k) (by exact_mod_cast le_top)
  rw [iteratedFDerivWithin_of_isOpen k hLso (show w ∈ L₀ ⁻¹' _ from hLw),
    iteratedFDerivWithin_of_isOpen k hso hLw] at key
  have htr := iteratedFDeriv_comp_add_right (𝕜 := ℝ) (f := fun p : ℝ × ℝ => simScale h p.1 p.2)
    k ((0:ℝ), (1:ℝ)) (L₀ w)
  calc ‖iteratedFDeriv ℝ k (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) w‖
      = ‖(iteratedFDeriv ℝ k (fun p : ℝ × ℝ => simScale h p.1 p.2)
          (L₀ w + ((0:ℝ), (1:ℝ)))).compContinuousLinearMap fun _ => L₀‖ := by
        rw [hfun, key, htr]
    _ ≤ ‖iteratedFDeriv ℝ k (fun p : ℝ × ℝ => simScale h p.1 p.2) (L₀ w + ((0:ℝ), (1:ℝ)))‖ *
          ∏ _i : Fin k, ‖L₀‖ :=
        ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv ℝ k (fun p : ℝ × ℝ => simScale h p.1 p.2) (L₀ w + ((0:ℝ), (1:ℝ)))‖ := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        exact mul_le_of_le_one_right (norm_nonneg _) (pow_le_one₀ (norm_nonneg _) hLn)
    _ ≤ C * simScale h (w.1 2) (1 - w.2) ^ (1 - (k : ℝ)) := by
        rw [hΦ w]
        exact hC _ _ (sub_pos.mpr hw) hq1

theorem wt_sharp_bilinear : ∀ {E F G H : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G] [NormedSpace ℝ G] [NormedAddCommGroup H] [NormedSpace ℝ H] (B : F →L[ℝ] G →L[ℝ] H) (f : E → F) (g : E → G) (ρ : E → ℝ) (Ω S : Set E) (a a' : ℝ), IsOpen Ω → S ⊆ Ω → (∀ w ∈ S, 0 < ρ w) → ContDiffOn ℝ ∞ f Ω → ContDiffOn ℝ ∞ g Ω → (∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k f w‖ ≤ C * ρ w ^ (a - (k : ℝ))) → (∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k g w‖ ≤ C * ρ w ^ (a' - (k : ℝ))) → ∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k (fun z => B (f z) (g z)) w‖ ≤ C * ρ w ^ (a + a' - (k : ℝ)) :=
by
  intro E F G H _ _ _ _ _ _ _ _ B f g ρ Ω S a a' hΩ hSΩ hρ hf hg hbf hbg k
  choose Cf hCf using hbf
  choose Cg hCg using hbg
  refine ⟨‖B‖ * ∑ i ∈ Finset.range (k + 1),
      (k.choose i : ℝ) * max (Cf i) 0 * max (Cg (k - i)) 0, fun w hw => ?_⟩
  have hwΩ : w ∈ Ω := hSΩ hw
  have hq : 0 < ρ w := hρ w hw
  have hU : UniqueDiffOn ℝ Ω := hΩ.uniqueDiffOn
  have key := ContinuousLinearMap.norm_iteratedFDerivWithin_le_of_bilinear B hf hg hU hwΩ
    (n := k) (by exact_mod_cast le_top)
  rw [iteratedFDerivWithin_of_isOpen k hΩ hwΩ] at key
  refine key.trans ?_
  rw [mul_assoc, Finset.sum_mul]
  refine mul_le_mul_of_nonneg_left ?_ (ContinuousLinearMap.opNorm_nonneg B)
  refine Finset.sum_le_sum fun i hi => ?_
  have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
  rw [iteratedFDerivWithin_of_isOpen i hΩ hwΩ, iteratedFDerivWithin_of_isOpen (k - i) hΩ hwΩ]
  have h1 : ‖iteratedFDeriv ℝ i f w‖ ≤ max (Cf i) 0 * ρ w ^ (a - (i : ℝ)) :=
    (hCf i w hw).trans (mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.rpow_nonneg hq.le _))
  have h2 : ‖iteratedFDeriv ℝ (k - i) g w‖ ≤
      max (Cg (k - i)) 0 * ρ w ^ (a' - ((k - i : ℕ) : ℝ)) :=
    (hCg (k - i) w hw).trans
      (mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.rpow_nonneg hq.le _))
  have h0 : (0 : ℝ) ≤ k.choose i := Nat.cast_nonneg _
  have hexp : ρ w ^ (a - (i : ℝ)) * ρ w ^ (a' - ((k - i : ℕ) : ℝ)) =
      ρ w ^ (a + a' - (k : ℝ)) := by
    rw [← Real.rpow_add hq, Nat.cast_sub hik]
    congr 1
    ring
  calc (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i f w‖ * ‖iteratedFDeriv ℝ (k - i) g w‖
      ≤ (k.choose i : ℝ) * (max (Cf i) 0 * ρ w ^ (a - (i : ℝ))) *
          (max (Cg (k - i)) 0 * ρ w ^ (a' - ((k - i : ℕ) : ℝ))) :=
        mul_le_mul (mul_le_mul_of_nonneg_left h1 h0) h2 (norm_nonneg _)
          (mul_nonneg h0 (mul_nonneg (le_max_right _ _) (Real.rpow_nonneg hq.le _)))
    _ = (k.choose i : ℝ) * max (Cf i) 0 * max (Cg (k - i)) 0 *
          (ρ w ^ (a - (i : ℝ)) * ρ w ^ (a' - ((k - i : ℕ) : ℝ))) := by ring
    _ = (k.choose i : ℝ) * max (Cf i) 0 * max (Cg (k - i)) 0 * ρ w ^ (a + a' - (k : ℝ)) := by
        rw [hexp]

theorem wt_sharp_comp0 : ∀ {E F G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G] [NormedSpace ℝ G] (g : F → G) (f : E → F) (ρ : E → ℝ) (Ω S : Set E) (T : Set F), IsOpen Ω → IsOpen T → S ⊆ Ω → MapsTo f Ω T → (∀ w ∈ S, 0 < ρ w) → ContDiffOn ℝ ∞ g T → ContDiffOn ℝ ∞ f Ω → (∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k g (f w)‖ ≤ C) → (∀ k : ℕ, 1 ≤ k → ∃ C : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k f w‖ ≤ C * ρ w ^ (-(k : ℝ))) → ∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k (g ∘ f) w‖ ≤ C * ρ w ^ (-(k : ℝ)) :=
by
  intro E F G _ _ _ _ _ _ g f ρ Ω S T hΩ hT hSΩ hmaps hρ hg hf hgb hfb k
  choose Cg hCg using hgb
  have hfb' : ∀ i : ℕ, ∃ C : ℝ, 1 ≤ i → ∀ w ∈ S,
      ‖iteratedFDeriv ℝ i f w‖ ≤ C * ρ w ^ (-(i : ℝ)) := by
    intro i
    by_cases hi : 1 ≤ i
    · obtain ⟨C, hC⟩ := hfb i hi
      exact ⟨C, fun _ => hC⟩
    · exact ⟨0, fun h => absurd h hi⟩
  choose Cf hCf using hfb'
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = ∑ i ∈ Finset.range (k + 1), |Cg i| := ⟨_, rfl⟩
  obtain ⟨C1, hC1⟩ : ∃ C1 : ℝ, C1 = 1 + ∑ i ∈ Finset.Ico 1 (k + 1), |Cf i| := ⟨_, rfl⟩
  have hC1ge : 1 ≤ C1 := by
    have : 0 ≤ ∑ i ∈ Finset.Ico 1 (k + 1), |Cf i| :=
      Finset.sum_nonneg (fun i _ => abs_nonneg _)
    rw [hC1]; linarith
  have hCgA : ∀ i ≤ k, |Cg i| ≤ A := by
    intro i hi
    rw [hA]
    exact Finset.single_le_sum (f := fun j => |Cg j|) (fun j _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  have hCfC1 : ∀ i, 1 ≤ i → i ≤ k → |Cf i| ≤ C1 := by
    intro i h1 h2
    have := Finset.single_le_sum (f := fun j => |Cf j|) (fun j _ => abs_nonneg _)
      (Finset.mem_Ico.mpr ⟨h1, (by omega : i < k + 1)⟩)
    rw [hC1]
    linarith
  refine ⟨(k.factorial : ℝ) * A * C1 ^ k, fun w hw => ?_⟩
  have hwΩ : w ∈ Ω := hSΩ hw
  have hfwT : f w ∈ T := hmaps hwΩ
  have hr : 0 < ρ w := hρ w hw
  have hrpow : ∀ i : ℕ, ρ w ^ (-(i : ℝ)) = (ρ w ^ i)⁻¹ := by
    intro i
    rw [Real.rpow_neg hr.le, Real.rpow_natCast]
  have hout : ∀ i ≤ k, ‖iteratedFDerivWithin ℝ i g T (f w)‖ ≤ A := by
    intro i hi
    rw [iteratedFDerivWithin_of_isOpen i hT hfwT]
    exact (hCg i w hw).trans ((le_abs_self _).trans (hCgA i hi))
  have hin : ∀ i, 1 ≤ i → i ≤ k → ‖iteratedFDerivWithin ℝ i f Ω w‖ ≤ (C1 / ρ w) ^ i := by
    intro i h1 h2
    rw [iteratedFDerivWithin_of_isOpen i hΩ hwΩ]
    have hpos : 0 < (ρ w ^ i)⁻¹ := inv_pos.mpr (pow_pos hr i)
    calc ‖iteratedFDeriv ℝ i f w‖ ≤ Cf i * ρ w ^ (-(i : ℝ)) := hCf i h1 w hw
      _ = Cf i * (ρ w ^ i)⁻¹ := by rw [hrpow]
      _ ≤ C1 ^ i * (ρ w ^ i)⁻¹ := by
          apply mul_le_mul_of_nonneg_right _ hpos.le
          exact (le_abs_self _).trans ((hCfC1 i h1 h2).trans (le_self_pow₀ hC1ge (by omega)))
      _ = (C1 / ρ w) ^ i := by rw [div_pow, div_eq_mul_inv]
  have key := norm_iteratedFDerivWithin_comp_le hg hf (by exact_mod_cast le_top)
    hT.uniqueDiffOn hΩ.uniqueDiffOn hmaps hwΩ hout hin
  rw [iteratedFDerivWithin_of_isOpen k hΩ hwΩ] at key
  calc ‖iteratedFDeriv ℝ k (g ∘ f) w‖ ≤ k.factorial * A * (C1 / ρ w) ^ k := key
    _ = (k.factorial : ℝ) * A * C1 ^ k * ρ w ^ (-(k : ℝ)) := by
        rw [hrpow, div_pow, div_eq_mul_inv]; ring

theorem wt_sharp_rpow : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (f : E → ℝ) (Ω S : Set E) (p : ℝ), IsOpen Ω → S ⊆ Ω → ContDiffOn ℝ ∞ f Ω → (∀ w ∈ Ω, 0 < f w) → (∀ k : ℕ, 1 ≤ k → ∃ C : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k f w‖ ≤ C * f w ^ (1 - (k : ℝ))) → ContDiffOn ℝ ∞ (fun z => f z ^ p) Ω ∧ ∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k (fun z => f z ^ p) w‖ ≤ C * f w ^ (p - (k : ℝ)) :=
by
  intro E _ _ f Ω S p hΩ hSΩ hf hpos hd
  have hgs : ContDiffOn ℝ ∞ (fun y : ℝ => y ^ p) (Ioi 0) := fun y hy =>
    (Real.contDiffAt_rpow_const_of_ne (ne_of_gt hy)).contDiffWithinAt
  have hmaps : MapsTo f Ω (Ioi 0) := fun w hw => hpos w hw
  refine ⟨hgs.comp hf hmaps, ?_⟩
  intro k
  have hd' : ∀ i : ℕ, ∃ C : ℝ, 1 ≤ i → ∀ w ∈ S,
      ‖iteratedFDeriv ℝ i f w‖ ≤ C * f w ^ (1 - (i : ℝ)) := by
    intro i
    by_cases hi1 : 1 ≤ i
    · obtain ⟨C, hC⟩ := hd i hi1
      exact ⟨C, fun _ => hC⟩
    · exact ⟨0, fun h1 => absurd h1 hi1⟩
  choose Cq hCq using hd'
  obtain ⟨C', hC'⟩ : ∃ C' : ℝ, C' = 1 + ∑ i ∈ Finset.range (k + 1), |Cq i| := ⟨_, rfl⟩
  obtain ⟨Cg, hCg⟩ : ∃ Cg : ℝ,
      Cg = ∑ i ∈ Finset.range (k + 1), |Polynomial.eval p (descPochhammer ℝ i)| := ⟨_, rfl⟩
  have hC'1 : 1 ≤ C' := by
    have := Finset.sum_nonneg (fun i (_ : i ∈ Finset.range (k + 1)) => abs_nonneg (Cq i))
    linarith
  have hCqle : ∀ i ≤ k, |Cq i| ≤ C' := by
    intro i hi
    have := Finset.single_le_sum (f := fun i => |Cq i|) (fun j _ => abs_nonneg _)
      (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    linarith
  have hCgle : ∀ i ≤ k, |Polynomial.eval p (descPochhammer ℝ i)| ≤ Cg := by
    intro i hi
    have := Finset.single_le_sum (f := fun i => |Polynomial.eval p (descPochhammer ℝ i)|)
      (fun j _ => abs_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    rw [hCg]
    exact this
  refine ⟨(k.factorial : ℝ) * Cg * C' ^ k, ?_⟩
  intro w hw
  have hwΩ : w ∈ Ω := hSΩ hw
  have hN : Ω ∈ nhds w := hΩ.mem_nhds hwΩ
  obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = f w := ⟨_, rfl⟩
  have ha : 0 < a := by rw [ha_def]; exact hpos w hwΩ
  have hai : 0 < a⁻¹ := inv_pos.mpr ha
  have hap : 0 < a ^ p := Real.rpow_pos_of_pos ha p
  have hgsm : ContDiffOn ℝ ∞ (a⁻¹ • f) Ω := hf.const_smul a⁻¹
  have hgmaps : MapsTo (a⁻¹ • f) Ω (Ioi 0) := fun z hz => by
    show 0 < a⁻¹ • f z
    rw [smul_eq_mul]
    exact mul_pos hai (hpos z hz)
  have hgw : (a⁻¹ • f) w = 1 := by
    rw [Pi.smul_apply, smul_eq_mul, ← ha_def]
    exact inv_mul_cancel₀ ha.ne'
  have hGsm : ContDiffOn ℝ ∞ ((fun y : ℝ => y ^ p) ∘ (a⁻¹ • f)) Ω := hgs.comp hgsm hgmaps
  have hGk : ContDiffAt ℝ k ((fun y : ℝ => y ^ p) ∘ (a⁻¹ • f)) w :=
    (hGsm.contDiffAt hN).of_le (by exact_mod_cast le_top)

  have hev : (fun z => f z ^ p) =ᶠ[nhds w] (a ^ p) • ((fun y : ℝ => y ^ p) ∘ (a⁻¹ • f)) := by
    refine Filter.eventuallyEq_of_mem hN (fun z hz => ?_)
    show f z ^ p = a ^ p • (a⁻¹ • f z) ^ p
    rw [smul_eq_mul, smul_eq_mul, Real.mul_rpow hai.le (hpos z hz).le, Real.inv_rpow ha.le,
      ← mul_assoc, mul_inv_cancel₀ hap.ne', one_mul]

  have hout : ∀ i ≤ k, ‖iteratedFDerivWithin ℝ i (fun y : ℝ => y ^ p) (Ioi 0) ((a⁻¹ • f) w)‖ ≤
      Cg := by
    intro i hi
    rw [hgw, iteratedFDerivWithin_of_isOpen i isOpen_Ioi (show (1:ℝ) ∈ Ioi (0:ℝ) from Set.mem_Ioi.mpr one_pos),
      norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
      Real.iter_deriv_rpow_const, Real.one_rpow, mul_one, Real.norm_eq_abs]
    exact hCgle i hi

  have hin : ∀ i : ℕ, 1 ≤ i → i ≤ k →
      ‖iteratedFDerivWithin ℝ i (a⁻¹ • f) Ω w‖ ≤ (C' * a⁻¹) ^ i := by
    intro i hi1 hik
    have hfi : ContDiffAt ℝ i f w := (hf.contDiffAt hN).of_le (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen i hΩ hwΩ, iteratedFDeriv_const_smul_apply hfi, norm_smul,
      Real.norm_eq_abs, abs_of_pos hai]
    have hb : ‖iteratedFDeriv ℝ i f w‖ ≤ Cq i * f w ^ (1 - (i : ℝ)) := hCq i hi1 w hw
    rw [← ha_def] at hb
    have e1 : a ^ (1 - (i : ℝ)) = a * a⁻¹ ^ i := by
      rw [Real.rpow_sub ha, Real.rpow_one, Real.rpow_natCast, div_eq_mul_inv, inv_pow]
    rw [e1] at hb
    have hP0 : 0 < a⁻¹ ^ i := by positivity
    have hC'i : C' ≤ C' ^ i := le_self_pow₀ hC'1 (by omega)
    calc a⁻¹ * ‖iteratedFDeriv ℝ i f w‖ ≤ a⁻¹ * (Cq i * (a * a⁻¹ ^ i)) :=
          mul_le_mul_of_nonneg_left hb hai.le
      _ = Cq i * (a⁻¹ * a) * a⁻¹ ^ i := by ring
      _ = Cq i * a⁻¹ ^ i := by rw [inv_mul_cancel₀ ha.ne', mul_one]
      _ ≤ |Cq i| * a⁻¹ ^ i := mul_le_mul_of_nonneg_right (le_abs_self _) hP0.le
      _ ≤ C' ^ i * a⁻¹ ^ i :=
          mul_le_mul_of_nonneg_right ((hCqle i hik).trans hC'i) hP0.le
      _ = (C' * a⁻¹) ^ i := (mul_pow _ _ _).symm
  have key := norm_iteratedFDerivWithin_comp_le hgs hgsm (by exact_mod_cast le_top)
    isOpen_Ioi.uniqueDiffOn hΩ.uniqueDiffOn hgmaps hwΩ hout hin
  rw [iteratedFDerivWithin_of_isOpen k hΩ hwΩ] at key
  rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_const_smul_apply hGk, norm_smul,
    Real.norm_eq_abs, abs_of_pos hap, ← ha_def]
  have e2 : a ^ (p - (k : ℝ)) = a ^ p * a⁻¹ ^ k := by
    rw [Real.rpow_sub ha, Real.rpow_natCast, div_eq_mul_inv, inv_pow]
  calc a ^ p * ‖iteratedFDeriv ℝ k ((fun y : ℝ => y ^ p) ∘ (a⁻¹ • f)) w‖
      ≤ a ^ p * ((k.factorial : ℝ) * Cg * (C' * a⁻¹) ^ k) := mul_le_mul_of_nonneg_left key hap.le
    _ = (k.factorial : ℝ) * Cg * C' ^ k * a ^ (p - (k : ℝ)) := by rw [e2, mul_pow]; ring

theorem simXEta_sharp : ∀ (h M : ℝ), SimScaleProps h → 0 < h → h < 1 / 2 → 0 < M → ∀ k : ℕ, ∃ C : ℝ, ∀ w : ℝ³ × ℝ, w.2 < 1 → simScale h (w.1 2) (1 - w.2) ≤ 1 → w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M * simScale h (w.1 2) (1 - w.2) → ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2)) w‖ ≤ C * simScale h (w.1 2) (1 - w.2) ^ (-(k : ℝ)) :=
by
  intro h M hS h0 hh2 hM k
  have hΩo : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  obtain ⟨S, hSd⟩ : ∃ S : Set (ℝ³ × ℝ), S = {w : ℝ³ × ℝ | w.2 < 1 ∧
      simScale h (w.1 2) (1 - w.2) ≤ 1 ∧
      w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M * simScale h (w.1 2) (1 - w.2)} := ⟨_, rfl⟩
  have hS1 : ∀ w ∈ S, w.2 < 1 ∧ simScale h (w.1 2) (1 - w.2) ≤ 1 ∧
      w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M * simScale h (w.1 2) (1 - w.2) := by
    rw [hSd]; intro w hw; exact hw
  have hSΩ : S ⊆ {w : ℝ³ × ℝ | w.2 < 1} := fun w hw => (hS1 w hw).1
  obtain ⟨hQs, -, hQpos, hQd⟩ := simQ_props h 1 h0 hh2 hS
  have hreg := bg_interior_region_facts h M hS h0 hh2 hM
  have hqpos : ∀ w ∈ S, 0 < simScale h (w.1 2) (1 - w.2) := fun w hw => hQpos w (hS1 w hw).1
  have hball : ∀ w ∈ S, ‖w‖ ≤ M + 1 := fun w hw =>
    ((hreg w (hS1 w hw).1).2 (hS1 w hw).2.1 (hS1 w hw).2.2).1
  have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => z.1 i) := fun i =>
    ((EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).comp (ContinuousLinearMap.fst ℝ ℝ³ ℝ)).contDiff

  have hhigh : ∀ (p : ℝ³ × ℝ → ℝ), ContDiff ℝ ∞ p → ∀ (a : ℝ) (j : ℕ), a ≤ (j : ℝ) →
      ∃ C : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ j p w‖ ≤
        C * simScale h (w.1 2) (1 - w.2) ^ (a - (j : ℝ)) := by
    intro p hp a j haj
    obtain ⟨C, hC⟩ := ball_iteratedFDeriv_bound p hp (M + 1) j
    refine ⟨max C 0, fun w hw => ?_⟩
    have h1 : 1 ≤ simScale h (w.1 2) (1 - w.2) ^ (a - (j : ℝ)) :=
      Real.one_le_rpow_of_pos_of_le_one_of_nonpos (hqpos w hw) (hS1 w hw).2.1 (by linarith)
    calc ‖iteratedFDeriv ℝ j p w‖ ≤ C := hC w (hball w hw)
      _ ≤ max C 0 := le_max_left _ _
      _ ≤ max C 0 * simScale h (w.1 2) (1 - w.2) ^ (a - (j : ℝ)) :=
          le_mul_of_one_le_right (le_max_right _ _) h1

  have hpow : ∀ p : ℝ,
      ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => simScale h (z.1 2) (1 - z.2) ^ p) {w : ℝ³ × ℝ | w.2 < 1} ∧
      ∀ j : ℕ, ∃ C : ℝ, ∀ w ∈ S,
        ‖iteratedFDeriv ℝ j (fun z : ℝ³ × ℝ => simScale h (z.1 2) (1 - z.2) ^ p) w‖ ≤
          C * simScale h (w.1 2) (1 - w.2) ^ (p - (j : ℝ)) := by
    intro p
    exact wt_sharp_rpow (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} S p
      hΩo hSΩ hQs (fun w hw => hQpos w hw) (fun j hj => by
        obtain ⟨C, hC⟩ := hQd j hj
        exact ⟨C, fun w hw => hC w (hS1 w hw).1 (hS1 w hw).2.1⟩)

  have hP : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => (z.1 0 ^ 2 + z.1 1 ^ 2) / 2) :=
    (((hc 0).pow 2).add ((hc 1).pow 2)).div_const 2
  have hPb : ∀ j : ℕ, ∃ C : ℝ, ∀ w ∈ S,
      ‖iteratedFDeriv ℝ j (fun z : ℝ³ × ℝ => (z.1 0 ^ 2 + z.1 1 ^ 2) / 2) w‖ ≤
        C * simScale h (w.1 2) (1 - w.2) ^ ((1 : ℝ) - (j : ℝ)) := by
    intro j
    rcases Nat.eq_zero_or_pos j with rfl | hj
    · refine ⟨M / 2, fun w hw => ?_⟩
      have hnn : 0 ≤ (w.1 0 ^ 2 + w.1 1 ^ 2) / 2 := by positivity
      rw [norm_iteratedFDeriv_zero]
      simp only [Real.norm_eq_abs, Nat.cast_zero, sub_zero, Real.rpow_one]
      rw [abs_of_nonneg hnn]
      have := (hS1 w hw).2.2
      linarith
    · exact hhigh _ hP 1 j (Nat.one_le_cast.mpr hj)

  have hZb : ∀ j : ℕ, ∃ C : ℝ, ∀ w ∈ S,
      ‖iteratedFDeriv ℝ j (fun z : ℝ³ × ℝ => z.1 2) w‖ ≤
        C * simScale h (w.1 2) (1 - w.2) ^ ((1 / 2 - h) - (j : ℝ)) := by
    intro j
    rcases Nat.eq_zero_or_pos j with rfl | hj
    · refine ⟨1, fun w hw => ?_⟩
      rw [norm_iteratedFDeriv_zero]
      simp only [Real.norm_eq_abs, Nat.cast_zero, sub_zero, one_mul]
      have hτ : 0 < 1 - w.2 := by linarith [(hS1 w hw).1]
      have h2 := (hS.2.1 (w.1 2) (1 - w.2) hτ).2
      have hq := hqpos w hw
      have e : simScale h (w.1 2) (1 - w.2) ^ (1 - 2 * h) =
          (simScale h (w.1 2) (1 - w.2) ^ (1 / 2 - h)) ^ 2 := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul hq.le]
        congr 1
        push_cast
        ring
      rw [e] at h2
      exact (abs_lt_of_sq_lt_sq h2 (Real.rpow_nonneg hq.le _)).le
    · have hj1 : (1 : ℝ) ≤ (j : ℝ) := Nat.one_le_cast.mpr hj
      exact hhigh _ (hc 2) _ j (by linarith)

  have hX := wt_sharp_bilinear (ContinuousLinearMap.mul ℝ ℝ)
    (fun z : ℝ³ × ℝ => (z.1 0 ^ 2 + z.1 1 ^ 2) / 2)
    (fun z : ℝ³ × ℝ => simScale h (z.1 2) (1 - z.2) ^ (-1 : ℝ))
    (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} S 1 (-1)
    hΩo hSΩ hqpos hP.contDiffOn (hpow _).1 hPb (hpow _).2

  have hE := wt_sharp_bilinear (ContinuousLinearMap.mul ℝ ℝ)
    (fun z : ℝ³ × ℝ => z.1 2)
    (fun z : ℝ³ × ℝ => simScale h (z.1 2) (1 - z.2) ^ (-(1 / 2 - h)))
    (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} S (1 / 2 - h)
    (-(1 / 2 - h)) hΩo hSΩ hqpos (hc 2).contDiffOn (hpow _).1 hZb (hpow _).2
  have eX : (fun z : ℝ³ × ℝ => simX h z.1 z.2) = fun z => ContinuousLinearMap.mul ℝ ℝ
      ((z.1 0 ^ 2 + z.1 1 ^ 2) / 2) (simScale h (z.1 2) (1 - z.2) ^ (-1 : ℝ)) := by
    funext z
    rw [ContinuousLinearMap.mul_apply', Real.rpow_neg_one]
    unfold simX
    ring
  have eE : (fun z : ℝ³ × ℝ => simEta h z.1 z.2) = fun z => ContinuousLinearMap.mul ℝ ℝ
      (z.1 2) (simScale h (z.1 2) (1 - z.2) ^ (-(1 / 2 - h))) := by
    funext z
    rw [ContinuousLinearMap.mul_apply']
    rfl
  have hXb : ∀ j : ℕ, ∃ C : ℝ, ∀ w ∈ S,
      ‖iteratedFDeriv ℝ j (fun z : ℝ³ × ℝ => simX h z.1 z.2) w‖ ≤
        C * simScale h (w.1 2) (1 - w.2) ^ (-(j : ℝ)) := by
    intro j
    obtain ⟨C, hC⟩ := hX j
    refine ⟨C, fun w hw => ?_⟩
    have e : (1 : ℝ) + -1 - (j : ℝ) = -(j : ℝ) := by ring
    have := hC w hw
    rw [e] at this
    rw [eX]
    exact this
  have hEb : ∀ j : ℕ, ∃ C : ℝ, ∀ w ∈ S,
      ‖iteratedFDeriv ℝ j (fun z : ℝ³ × ℝ => simEta h z.1 z.2) w‖ ≤
        C * simScale h (w.1 2) (1 - w.2) ^ (-(j : ℝ)) := by
    intro j
    obtain ⟨C, hC⟩ := hE j
    refine ⟨C, fun w hw => ?_⟩
    have e : (1 / 2 - h) + -(1 / 2 - h) - (j : ℝ) = -(j : ℝ) := by ring
    have := hC w hw
    rw [e] at this
    rw [eE]
    exact this

  have hpair := (simXEta_wt_bound h M hS h0 hh2 hM).1
  have hXs : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => simX h z.1 z.2) {w : ℝ³ × ℝ | w.2 < 1} :=
    hpair.fst
  have hEs : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => simEta h z.1 z.2) {w : ℝ³ × ℝ | w.2 < 1} :=
    hpair.snd

  obtain ⟨CX, hCX⟩ := hXb k
  obtain ⟨CE, hCE⟩ := hEb k
  refine ⟨max CX CE, fun w h1 h2 h3 => ?_⟩
  have hw : w ∈ S := by rw [hSd]; exact ⟨h1, h2, h3⟩
  have hwΩ : {w : ℝ³ × ℝ | w.2 < 1} ∈ nhds w := hΩo.mem_nhds (hSΩ hw)
  have hq0 := hqpos w hw
  rw [iteratedFDeriv_prodMk (hXs.contDiffAt hwΩ) (hEs.contDiffAt hwΩ)
    (by exact_mod_cast le_top), ContinuousMultilinearMap.opNorm_prod]
  have hqk : 0 ≤ simScale h (w.1 2) (1 - w.2) ^ (-(k : ℝ)) := (Real.rpow_pos_of_pos hq0 _).le
  exact max_le ((hCX w hw).trans (mul_le_mul_of_nonneg_right (le_max_left _ _) hqk))
    ((hCE w hw).trans (mul_le_mul_of_nonneg_right (le_max_right _ _) hqk))

theorem sim_frame_field_bound : ∀ h : ℝ, 0 < h → h < 1 / 2 → SimScaleProps h → ∀ (c : ℝ → ℝ → ℝ) (b ε X1 : ℝ) (v : ℝ³ → ℝ³), 0 < ε → ContDiffOn ℝ ∞ (↿c) (Ioi (-ε) ×ˢ Ioo (-1) 1) → (∀ X η : ℝ, X1 < X → -1 < η → η < 1 → c X η = 0) → (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X1 → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿c) (X, η)‖ ≤ C) → (v = radVec ∨ v = azVec ∨ v = fun _ => EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) → ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => (simScale h (z.1 2) (1 - z.2) ^ b * c (simX h z.1 z.2) (simEta h z.1 z.2)) • v z.1) {w : ℝ³ × ℝ | w.2 < 1} ∧ ∀ m : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ‖iteratedFDeriv ℝ m (fun z : ℝ³ × ℝ => (simScale h (z.1 2) (1 - z.2) ^ b * c (simX h z.1 z.2) (simEta h z.1 z.2)) • v z.1) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (b - (m : ℝ)) :=
by
  intro h hh0 hh2 hS c b ε X1 v hε hc hcv hcbd hv
  have hΩo : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  obtain ⟨M, hM⟩ : ∃ M : ℝ, M = 2 * |X1| + 2 := ⟨_, rfl⟩
  have hM0 : 0 < M := by rw [hM]; positivity
  obtain ⟨S, hSd⟩ : ∃ S : Set (ℝ³ × ℝ), S = {w : ℝ³ × ℝ | w.2 < 1 ∧
      simScale h (w.1 2) (1 - w.2) ≤ 1 ∧ simX h w.1 w.2 ≤ X1} := ⟨_, rfl⟩
  have hS1 : ∀ w ∈ S, w.2 < 1 ∧ simScale h (w.1 2) (1 - w.2) ≤ 1 ∧ simX h w.1 w.2 ≤ X1 := by
    rw [hSd]; intro w hw; exact hw
  have hSΩ : S ⊆ {w : ℝ³ × ℝ | w.2 < 1} := fun w hw => (hS1 w hw).1
  obtain ⟨hQs, -, hQpos, hQd⟩ := simQ_props h 1 hh0 hh2 hS
  have hreg := bg_interior_region_facts h M hS hh0 hh2 hM0
  have hqpos : ∀ w ∈ S, 0 < simScale h (w.1 2) (1 - w.2) := fun w hw => hQpos w (hS1 w hw).1

  have hr2 : ∀ w ∈ S, w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M * simScale h (w.1 2) (1 - w.2) := by
    intro w hw
    obtain ⟨hw1, -, hwX⟩ := hS1 w hw
    have hq := hQpos w hw1
    have hq' : simScale h (w.1 2) (1 - w.2) ≠ 0 := hq.ne'
    have e : w.1 0 ^ 2 + w.1 1 ^ 2 = 2 * simScale h (w.1 2) (1 - w.2) * simX h w.1 w.2 := by
      unfold simX
      field_simp
    have hX' : simX h w.1 w.2 ≤ |X1| + 1 := by linarith [le_abs_self X1]
    rw [e, hM]
    nlinarith [mul_le_mul_of_nonneg_left hX' hq.le]

  have hball : ∀ w ∈ S, ‖w‖ ≤ M + 1 := fun w hw =>
    ((hreg w (hS1 w hw).1).2 (hS1 w hw).2.1 (hr2 w hw)).1

  obtain ⟨hPs, hPb⟩ := wt_sharp_rpow (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2))
    {w : ℝ³ × ℝ | w.2 < 1} S b hΩo hSΩ hQs (fun w hw => hQpos w hw) (by
      intro k hk
      obtain ⟨C, hC⟩ := hQd k hk
      exact ⟨C, fun w hw => hC w (hS1 w hw).1 (hS1 w hw).2.1⟩)

  have hφs : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2))
      {w : ℝ³ × ℝ | w.2 < 1} := (simXEta_wt_bound h 1 hS hh0 hh2 one_pos).1
  have hTo : IsOpen (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hmaps : MapsTo (fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2))
      {w : ℝ³ × ℝ | w.2 < 1} (Ioi (-ε) ×ˢ Ioo (-1) 1) := by
    intro w hw
    obtain ⟨⟨-, hX0, he1, he2⟩, -⟩ := hreg w hw
    exact ⟨show -ε < simX h w.1 w.2 by linarith, he1, he2⟩
  have hcφs : ContDiffOn ℝ ∞ ((↿c) ∘ fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2))
      {w : ℝ³ × ℝ | w.2 < 1} := hc.comp hφs hmaps

  have hcφ := wt_sharp_comp0 (↿c) (fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2))
    (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} S
    (Ioi (-ε) ×ˢ Ioo (-1) 1) hΩo hTo hSΩ hmaps hqpos hc hφs
    (fun k => by
      obtain ⟨C, hC⟩ := hcbd k
      refine ⟨C, fun w hw => ?_⟩
      obtain ⟨hw1, -, hwX⟩ := hS1 w hw
      obtain ⟨⟨-, hX0, he1, he2⟩, -⟩ := hreg w hw1
      exact hC _ _ hX0 hwX he1 he2)
    (fun k _ => by
      obtain ⟨C, hC⟩ := simXEta_sharp h M hS hh0 hh2 hM0 k
      exact ⟨C, fun w hw => hC w (hS1 w hw).1 (hS1 w hw).2.1 (hr2 w hw)⟩)
  have hcφ' : ∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ S,
      ‖iteratedFDeriv ℝ k ((↿c) ∘ fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2)) w‖ ≤
        C * simScale h (w.1 2) (1 - w.2) ^ ((0 : ℝ) - (k : ℝ)) := by
    intro k
    obtain ⟨C, hC⟩ := hcφ k
    exact ⟨C, fun w hw => by rw [zero_sub]; exact hC w hw⟩

  have hsb := wt_sharp_bilinear (ContinuousLinearMap.mul ℝ ℝ)
    (fun z : ℝ³ × ℝ => (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) z ^ b)
    ((↿c) ∘ fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2))
    (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} S b 0
    hΩo hSΩ hqpos hPs hcφs hPb hcφ'
  have hss : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => ContinuousLinearMap.mul ℝ ℝ
      ((fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) z ^ b)
      (((↿c) ∘ fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2)) z))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    have e : (fun z : ℝ³ × ℝ => ContinuousLinearMap.mul ℝ ℝ
        ((fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) z ^ b)
        (((↿c) ∘ fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2)) z)) =
        fun z : ℝ³ × ℝ => (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) z ^ b *
        ((↿c) ∘ fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2)) z := by
      funext z
      rw [ContinuousLinearMap.mul_apply']
    rw [e]
    exact hPs.mul hcφs

  have hco : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => z.1 i) := fun i =>
    ((EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).comp (ContinuousLinearMap.fst ℝ ℝ³ ℝ)).contDiff
  have hVs : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => v z.1) := by
    rcases hv with rfl | rfl | rfl
    · show ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => z.1 0 • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        z.1 1 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))
      exact ((hco 0).smul contDiff_const).add ((hco 1).smul contDiff_const)
    · show ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => -(z.1 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        z.1 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))
      exact ((hco 1).neg.smul contDiff_const).add ((hco 0).smul contDiff_const)
    · exact contDiff_const
  have hVb : ∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ S,
      ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => v z.1) w‖ ≤
        C * simScale h (w.1 2) (1 - w.2) ^ ((0 : ℝ) - (k : ℝ)) := by
    intro k
    obtain ⟨C, hC⟩ := ball_iteratedFDeriv_bound (fun z : ℝ³ × ℝ => v z.1) hVs (M + 1) k
    refine ⟨max C 0, fun w hw => ?_⟩
    have hq0 := hqpos w hw
    have h1 : 1 ≤ simScale h (w.1 2) (1 - w.2) ^ ((0 : ℝ) - (k : ℝ)) :=
      Real.one_le_rpow_of_pos_of_le_one_of_nonpos hq0 (hS1 w hw).2.1
        (by have : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k; linarith)
    calc ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => v z.1) w‖ ≤ C := hC w (hball w hw)
      _ ≤ max C 0 := le_max_left _ _
      _ ≤ max C 0 * simScale h (w.1 2) (1 - w.2) ^ ((0 : ℝ) - (k : ℝ)) :=
          le_mul_of_one_le_right (le_max_right _ _) h1

  have hPhib := wt_sharp_bilinear (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
    (fun z : ℝ³ × ℝ => ContinuousLinearMap.mul ℝ ℝ
      ((fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) z ^ b)
      (((↿c) ∘ fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2)) z))
    (fun z : ℝ³ × ℝ => v z.1)
    (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} S (b + 0) 0
    hΩo hSΩ hqpos hss hVs.contDiffOn hsb hVb
  have ePhi : (fun z : ℝ³ × ℝ => (simScale h (z.1 2) (1 - z.2) ^ b * c (simX h z.1 z.2) (simEta h z.1 z.2)) • v z.1) =
      fun z : ℝ³ × ℝ => (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
        (ContinuousLinearMap.mul ℝ ℝ
          ((fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) z ^ b)
          (((↿c) ∘ fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2)) z)) (v z.1) := by
    funext z
    rw [ContinuousLinearMap.lsmul_apply, ContinuousLinearMap.mul_apply']
    rfl
  refine ⟨?_, ?_⟩

  · exact (hPs.mul hcφs).smul hVs.contDiffOn

  · intro m
    obtain ⟨C, hC⟩ := hPhib m
    refine ⟨max C 0, fun x t hxt => ?_⟩
    have hxt' : t < 1 ∧ simScale h (x 2) (1 - t) < 1 := hxt
    have hq0 : 0 < simScale h (x 2) (1 - t) := hQpos (x, t) hxt'.1
    by_cases hX : simX h x t ≤ X1
    · have hmem : (x, t) ∈ S := by rw [hSd]; exact ⟨hxt'.1, hxt'.2.le, hX⟩
      have hb := hC (x, t) hmem
      have e : b + 0 + 0 - (m : ℝ) = b - (m : ℝ) := by ring
      rw [e, ← ePhi] at hb
      exact hb.trans (mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.rpow_nonneg hq0.le _))
    · have hX' : X1 < simX h x t := lt_of_not_ge hX
      have hXc : ContinuousOn (fun w : ℝ³ × ℝ => simX h w.1 w.2) {w : ℝ³ × ℝ | w.2 < 1} :=
        continuous_fst.comp_continuousOn hφs.continuousOn
      have hUo := hXc.isOpen_inter_preimage hΩo (isOpen_Ioi (a := X1))
      have hxU : (x, t) ∈ {w : ℝ³ × ℝ | w.2 < 1} ∩
          (fun w : ℝ³ × ℝ => simX h w.1 w.2) ⁻¹' Ioi X1 := ⟨hxt'.1, hX'⟩
      have hev : (fun z : ℝ³ × ℝ => (simScale h (z.1 2) (1 - z.2) ^ b *
          c (simX h z.1 z.2) (simEta h z.1 z.2)) • v z.1) =ᶠ[nhds (x, t)]
          fun _ => (0 : ℝ³) := by
        refine Filter.eventuallyEq_of_mem (hUo.mem_nhds hxU) (fun w hw => ?_)
        obtain ⟨hw1, hw2⟩ := hw
        have hw2' : X1 < simX h w.1 w.2 := hw2
        obtain ⟨⟨-, -, he1, he2⟩, -⟩ := hreg w hw1
        simp only [hcv _ _ hw2' he1 he2, mul_zero, zero_smul]
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
      simp only [Pi.zero_apply, norm_zero]
      exact mul_nonneg (le_max_right _ _) (Real.rpow_nonneg hq0.le _)

theorem bg_res_tail_vanish_generic : ∀ (h a : ℝ) (S G W : ℕ → ℝ → ℝ → ℝ), (∀ Y e : ℝ, a < Y → -1 < e → e < 1 → S 0 Y e = 0) → (∀ Y e : ℝ, a < Y → -1 < e → e < 1 → simZop h (-(1 + h)) (G 0) Y e = 0) → (∀ j : ℕ, 1 ≤ j → ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → S j Y e = 0 ∧ G j Y e = 0 ∧ W j Y e = 0) → ∀ k : ℕ, 1 ≤ k → ∀ X η : ℝ, a < X → -1 < η → η < 1 → bgResRad h S G W k X η = 0 ∧ bgResTh h S G W k X η = 0 ∧ bgResZ h S G W k X η = 0 :=
by
  intro h a S G W H0 HZ Hp k hk X η hX h1 h2

  have hpdX : ∀ f : ℝ → ℝ → ℝ, (∀ Y e : ℝ, a < Y → -1 < e → e < 1 → f Y e = 0) →
      ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → pdX f Y e = 0 := by
    intro f hf Y e hY he1 he2
    unfold pdX
    have hev : (fun Y' => f Y' e) =ᶠ[nhds Y] fun _ => (0:ℝ) :=
      Filter.eventuallyEq_of_mem (Ioi_mem_nhds hY) (fun Y' hY' => hf Y' e hY' he1 he2)
    rw [hev.deriv_eq]
    simp
  have hpdE : ∀ f : ℝ → ℝ → ℝ, (∀ Y e : ℝ, a < Y → -1 < e → e < 1 → f Y e = 0) →
      ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → pdE f Y e = 0 := by
    intro f hf Y e hY he1 he2
    unfold pdE
    have hev : (fun e' => f Y e') =ᶠ[nhds e] fun _ => (0:ℝ) :=
      Filter.eventuallyEq_of_mem (Ioo_mem_nhds he1 he2) (fun e' he' => hf Y e' hY he'.1 he'.2)
    rw [hev.deriv_eq]
    simp

  have hTop : ∀ (b : ℝ) (f : ℝ → ℝ → ℝ), (∀ Y e : ℝ, a < Y → -1 < e → e < 1 → f Y e = 0) →
      ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → simTop h b f Y e = 0 := by
    intro b f hf Y e hY he1 he2
    unfold simTop
    rw [hf Y e hY he1 he2, hpdX f hf Y e hY he1 he2, hpdE f hf Y e hY he1 he2]
    simp
  have hZop : ∀ (b : ℝ) (f : ℝ → ℝ → ℝ), (∀ Y e : ℝ, a < Y → -1 < e → e < 1 → f Y e = 0) →
      ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → simZop h b f Y e = 0 := by
    intro b f hf Y e hY he1 he2
    unfold simZop
    rw [hf Y e hY he1 he2, hpdX f hf Y e hY he1 he2, hpdE f hf Y e hY he1 he2]
    simp
  have hUz : ∀ (f : ℝ → ℝ → ℝ), (∀ Y e : ℝ, a < Y → -1 < e → e < 1 → f Y e = 0) →
      ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → bgUz f Y e = 0 := by
    intro f hf Y e hY he1 he2
    unfold bgUz
    rw [hf Y e hY he1 he2, hpdX f hf Y e hY he1 he2]
    simp
  have hVx : ∀ (n : ℕ) (f : ℝ → ℝ → ℝ), (∀ Y e : ℝ, a < Y → -1 < e → e < 1 → f Y e = 0) →
      ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → bgVx h n f Y e = 0 := by
    intro n f hf Y e hY he1 he2
    unfold bgVx
    rw [hUz f hf Y e hY he1 he2, hf Y e hY he1 he2, hpdE f hf Y e hY he1 he2]
    simp

  have hS : ∀ j : ℕ, ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → S j Y e = 0 := by
    intro j
    rcases Nat.eq_zero_or_pos j with rfl | hj
    · exact H0
    · exact fun Y e hY he1 he2 => (Hp j hj Y e hY he1 he2).1
  have hG : ∀ j : ℕ, 1 ≤ j → ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → G j Y e = 0 :=
    fun j hj Y e hY he1 he2 => (Hp j hj Y e hY he1 he2).2.1
  have hW : ∀ j : ℕ, 1 ≤ j → ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → W j Y e = 0 :=
    fun j hj Y e hY he1 he2 => (Hp j hj Y e hY he1 he2).2.2
  have hU : ∀ j : ℕ, ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → bgUz (S j) Y e = 0 :=
    fun j => hUz _ (hS j)
  have hV : ∀ j : ℕ, ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → bgVx h j (S j) Y e = 0 :=
    fun j => hVx _ _ (hS j)

  have hOm : ∀ m : ℕ, ∀ Y e : ℝ, a < Y → -1 < e → e < 1 → bgOm h S m Y e = 0 := by
    intro m Y e hY he1 he2
    have u : ∀ i : ℕ, bgUz (S i) Y e = 0 := fun i => hU i Y e hY he1 he2
    have v : ∀ i : ℕ, bgVx h i (S i) Y e = 0 := fun i => hV i Y e hY he1 he2
    unfold bgOm
    rw [hTop _ _ (hV m) Y e hY he1 he2, hpdX _ (hpdX _ (hV m)) Y e hY he1 he2,
      hpdX _ (hV m) Y e hY he1 he2]
    split_ifs
    · rw [hZop _ _ (hZop _ _ (hV (m - 1))) Y e hY he1 he2]
      simp [u, v]
    · simp [u, v]
  have u : ∀ i : ℕ, bgUz (S i) X η = 0 := fun i => hU i X η hX h1 h2
  have v : ∀ i : ℕ, bgVx h i (S i) X η = 0 := fun i => hV i X η hX h1 h2

  have hTh : bgResTh h S G W k X η = 0 := by
    have hinner : ∀ Y e : ℝ, a < Y → -1 < e → e < 1 →
        simZop h (-(1 + h) + 2 * ((k - 1 : ℕ) : ℝ) * h) (G (k - 1)) Y e = 0 := by
      rcases Nat.eq_zero_or_pos (k - 1) with h0 | hpos
      · intro Y e hY he1 he2
        rw [h0]
        simp only [Nat.cast_zero, mul_zero, zero_mul, add_zero]
        exact HZ Y e hY he1 he2
      · exact hZop _ _ (hG (k - 1) hpos)
    unfold bgResTh
    rw [if_pos hk, hTop _ _ (hG k hk) X η hX h1 h2, hpdX _ (hpdX _ (hG k hk)) X η hX h1 h2,
      hpdX _ (hG k hk) X η hX h1 h2, hZop _ _ hinner X η hX h1 h2]
    simp [u, v]

  have hZ : bgResZ h S G W k X η = 0 := by
    unfold bgResZ
    rw [if_pos hk, hTop _ _ (hU k) X η hX h1 h2, hZop _ _ (hW k hk) X η hX h1 h2,
      hpdX _ (hpdX _ (hU k)) X η hX h1 h2, hpdX _ (hU k) X η hX h1 h2,
      hZop _ _ (hZop _ _ (hU (k - 1))) X η hX h1 h2]
    simp [u, v]

  have hRad : bgResRad h S G W k X η = 0 := by
    unfold bgResRad
    rw [if_pos hk, hOm (k - 1) X η hX h1 h2, hpdX _ (hW k hk) X η hX h1 h2]
    rw [Finset.sum_eq_zero]
    · ring
    · intro i _
      rcases Nat.eq_zero_or_pos i with rfl | hi0
      · rw [Nat.sub_zero, hG k hk X η hX h1 h2, mul_zero]
      · rw [hG i hi0 X η hX h1 h2, zero_mul]
  exact ⟨hRad, hTh, hZ⟩

theorem bg_trunc_coef_regular : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) (S G W : ℕ → ℝ → ℝ → ℝ), SimScaleProps h → LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → BgCoeffSeq h Xm Xs m1 m2 F U S G W → ∃ ε : ℝ, 0 < ε ∧ (∀ n : ℕ, ContDiffOn ℝ ∞ (↿(S n)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(G n)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(W n)) (Ioi (-ε) ×ˢ Ioo (-1) 1)) ∧ ∀ N k : ℕ, 1 ≤ k → ContDiffOn ℝ ∞ (↿(bgResRad h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(bgResTh h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(bgResZ h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ∀ X1 : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X1 → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿(bgResRad h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k)) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(bgResTh h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k)) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(bgResZ h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k)) (X, η)‖ ≤ C :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs F U T0th T0z S G W hSc hL hB
  obtain ⟨εP, hεP, hPs, hPb⟩ :=
    leadPi_smooth_bounds h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hL
  unfold LeadingProfile at hL
  obtain ⟨⟨hh0, hh1, -⟩, -, -, -, ⟨εL, hεL, hFs, hUs, -, hFU⟩, -⟩ := hL
  unfold BgCoeffSeq at hB
  obtain ⟨⟨hS0, hG0, hW0⟩, ⟨εB, hεB, hBsm⟩, hBbd, -⟩ := hB
  have hh2 : h < 1 / 2 := by linarith
  obtain ⟨ε, hεdef⟩ : ∃ ε : ℝ, ε = min (min εL εB) εP := ⟨_, rfl⟩
  have hε : 0 < ε := by rw [hεdef]; exact lt_min (lt_min hεL hεB) hεP
  have hεL' : ε ≤ εL := by rw [hεdef]; exact (min_le_left _ _).trans (min_le_left _ _)
  have hεB' : ε ≤ εB := by rw [hεdef]; exact (min_le_left _ _).trans (min_le_right _ _)
  have hεP' : ε ≤ εP := by rw [hεdef]; exact min_le_right _ _
  have hΩ : IsOpen (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hle : ∀ m : ℕ, ((m : ℕ) : WithTop ℕ∞) ≤ ∞ := fun m => by exact_mod_cast le_top
  have hmem : ∀ X η : ℝ, 0 ≤ X → -1 < η → η < 1 →
      ((X, η) : ℝ × ℝ) ∈ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 :=
    fun X η h0 h1 h2 => ⟨show -ε < X by linarith, h1, h2⟩

  have hcongr : ∀ f g : ℝ → ℝ → ℝ, bgCoefGood ε f → (∀ X η, f X η = g X η) → bgCoefGood ε g := by
    intro f g hf hfg
    have : f = g := funext fun X => funext fun η => hfg X η
    subst this
    exact hf

  have hadd : ∀ f g : ℝ → ℝ → ℝ, bgCoefGood ε f → bgCoefGood ε g →
      bgCoefGood ε (fun X η => f X η + g X η) := by
    intro f g hf hg
    refine ⟨hf.1.add hg.1, ?_⟩
    intro X1 m
    obtain ⟨C1, hC1⟩ := hf.2 X1 m
    obtain ⟨C2, hC2⟩ := hg.2 X1 m
    refine ⟨C1 + C2, fun X η h0 h1 h2 h3 => ?_⟩
    have hz := hΩ.mem_nhds (hmem X η h0 h2 h3)
    have e : iteratedFDeriv ℝ m (↿(fun X η => f X η + g X η)) (X, η) =
        iteratedFDeriv ℝ m (↿f) (X, η) + iteratedFDeriv ℝ m (↿g) (X, η) :=
      iteratedFDeriv_add_apply ((hf.1.contDiffAt hz).of_le (hle m)) ((hg.1.contDiffAt hz).of_le (hle m))
    rw [e]
    exact (norm_add_le _ _).trans (add_le_add (hC1 X η h0 h1 h2 h3) (hC2 X η h0 h1 h2 h3))
  have hsub : ∀ f g : ℝ → ℝ → ℝ, bgCoefGood ε f → bgCoefGood ε g →
      bgCoefGood ε (fun X η => f X η - g X η) := by
    intro f g hf hg
    refine ⟨hf.1.sub hg.1, ?_⟩
    intro X1 m
    obtain ⟨C1, hC1⟩ := hf.2 X1 m
    obtain ⟨C2, hC2⟩ := hg.2 X1 m
    refine ⟨C1 + C2, fun X η h0 h1 h2 h3 => ?_⟩
    have hz := hΩ.mem_nhds (hmem X η h0 h2 h3)
    have e : iteratedFDeriv ℝ m (↿(fun X η => f X η - g X η)) (X, η) =
        iteratedFDeriv ℝ m (↿f) (X, η) - iteratedFDeriv ℝ m (↿g) (X, η) :=
      iteratedFDeriv_sub_apply ((hf.1.contDiffAt hz).of_le (hle m)) ((hg.1.contDiffAt hz).of_le (hle m))
    rw [e]
    exact (norm_sub_le _ _).trans (add_le_add (hC1 X η h0 h1 h2 h3) (hC2 X η h0 h1 h2 h3))

  have hmul : ∀ f g : ℝ → ℝ → ℝ, bgCoefGood ε f → bgCoefGood ε g →
      bgCoefGood ε (fun X η => f X η * g X η) := by
    intro f g hf hg
    refine ⟨hf.1.mul hg.1, ?_⟩
    intro X1 m
    have hS : Icc (0 : ℝ) X1 ×ˢ Ioo (-1 : ℝ) 1 ⊆ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 :=
      fun z hz => hmem z.1 z.2 hz.1.1 hz.2.1 hz.2.2
    obtain ⟨C, hC⟩ := iteratedFDeriv_bilinear_bounded_on (ContinuousLinearMap.mul ℝ ℝ) (↿f) (↿g)
      (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) (Icc (0 : ℝ) X1 ×ˢ Ioo (-1 : ℝ) 1) hΩ hS hf.1 hg.1
      (fun k => (hf.2 X1 k).imp fun C hC z hz => hC z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2)
      (fun k => (hg.2 X1 k).imp fun C hC z hz => hC z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2) m
    have e : (fun z => (ContinuousLinearMap.mul ℝ ℝ) ((↿f) z) ((↿g) z)) =
        ↿(fun X η => f X η * g X η) := by
      funext z
      rw [ContinuousLinearMap.mul_apply']
      rfl
    refine ⟨C, fun X η h0 h1 h2 h3 => ?_⟩
    rw [← e]
    exact hC (X, η) ⟨⟨h0, h1⟩, h2, h3⟩

  have hbasic : ∀ (f : ℝ → ℝ → ℝ) (V : Set (ℝ × ℝ)), IsOpen V → ContDiffOn ℝ ∞ (↿f) V →
      (∀ X η : ℝ, -ε < X → -1 ≤ η → η ≤ 1 → ((X, η) : ℝ × ℝ) ∈ V) → bgCoefGood ε f := by
    intro f V hV hf hsubV
    refine ⟨hf.mono (fun z hz => hsubV z.1 z.2 hz.1 hz.2.1.le hz.2.2.le), ?_⟩
    intro X1 m
    have hK : IsCompact (Icc (0 : ℝ) X1 ×ˢ Icc (-1 : ℝ) 1) := isCompact_Icc.prod isCompact_Icc
    have hKV : Icc (0 : ℝ) X1 ×ˢ Icc (-1 : ℝ) 1 ⊆ V :=
      fun z hz => hsubV z.1 z.2 (by linarith [hz.1.1]) hz.2.1 hz.2.2
    have hc : ContinuousOn (iteratedFDeriv ℝ m (↿f)) V :=
      (hf.continuousOn_iteratedFDerivWithin (hle m) hV.uniqueDiffOn).congr
        (fun z hz => (iteratedFDerivWithin_of_isOpen m hV hz).symm)
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn (hc.mono hKV)
    exact ⟨C, fun X η h0 h1 h2 h3 => hC (X, η) ⟨⟨h0, h1⟩, h2.le, h3.le⟩⟩
  have hconst : ∀ c : ℝ, bgCoefGood ε (fun _ _ => c) := fun c =>
    hbasic (fun _ _ => c) univ isOpen_univ contDiffOn_const (fun _ _ _ _ _ => mem_univ _)
  have hX : bgCoefGood ε (fun X _ => X) :=
    hbasic (fun X _ => X) univ isOpen_univ contDiff_fst.contDiffOn (fun _ _ _ _ _ => mem_univ _)
  have hη : bgCoefGood ε (fun _ η => η) :=
    hbasic (fun _ η => η) univ isOpen_univ contDiff_snd.contDiffOn (fun _ _ _ _ _ => mem_univ _)
  have hinv : bgCoefGood ε (fun _ η => (1 - 2 * h * η ^ 2)⁻¹) := by
    refine hbasic _ {w : ℝ × ℝ | 0 < 1 - 2 * h * w.2 ^ 2}
      (isOpen_lt continuous_const (by fun_prop)) ?_ ?_
    · exact ((contDiff_const.sub (contDiff_const.mul (contDiff_snd.pow 2))).contDiffOn).inv
        (fun w hw => ne_of_gt hw)
    · intro X η _ h1 h2
      have hη2 : η ^ 2 ≤ 1 := by nlinarith
      show 0 < 1 - 2 * h * η ^ 2
      nlinarith

  have hpd : ∀ (f : ℝ → ℝ → ℝ) (v : ℝ × ℝ) (g : ℝ → ℝ → ℝ), bgCoefGood ε f →
      (∀ X η, ((X, η) : ℝ × ℝ) ∈ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 → g X η = fderiv ℝ (↿f) (X, η) v) →
      bgCoefGood ε g := by
    intro f v g hf hgv
    have hD : ContDiffOn ℝ ∞ (fderiv ℝ (↿f)) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) :=
      hf.1.fderiv_of_isOpen hΩ le_rfl
    have hDg : ContDiffOn ℝ ∞ ((ContinuousLinearMap.apply ℝ ℝ v) ∘ fderiv ℝ (↿f))
        (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) :=
      (ContinuousLinearMap.apply ℝ ℝ v).contDiff.comp_contDiffOn hD
    have heq : ∀ z ∈ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1,
        (↿g) z = ((ContinuousLinearMap.apply ℝ ℝ v) ∘ fderiv ℝ (↿f)) z := by
      intro z hz
      have := hgv z.1 z.2 hz
      exact this
    refine ⟨hDg.congr heq, ?_⟩
    intro X1 m
    obtain ⟨C, hC⟩ := hf.2 X1 (m + 1)
    refine ⟨‖ContinuousLinearMap.apply ℝ ℝ v‖ * C, fun X η h0 h1 h2 h3 => ?_⟩
    have hz := hmem X η h0 h2 h3
    have hev : (↿g) =ᶠ[nhds (X, η)] ((ContinuousLinearMap.apply ℝ ℝ v) ∘ fderiv ℝ (↿f)) :=
      Filter.eventuallyEq_of_mem (hΩ.mem_nhds hz) heq
    rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
    calc ‖iteratedFDeriv ℝ m ((ContinuousLinearMap.apply ℝ ℝ v) ∘ fderiv ℝ (↿f)) (X, η)‖
        ≤ ‖ContinuousLinearMap.apply ℝ ℝ v‖ * ‖iteratedFDeriv ℝ m (fderiv ℝ (↿f)) (X, η)‖ :=
          (ContinuousLinearMap.apply ℝ ℝ v).norm_iteratedFDeriv_comp_left
            (hD.contDiffAt (hΩ.mem_nhds hz)) (hle m)
      _ = ‖ContinuousLinearMap.apply ℝ ℝ v‖ * ‖iteratedFDeriv ℝ (m + 1) (↿f) (X, η)‖ := by
          rw [norm_iteratedFDeriv_fderiv]
      _ ≤ ‖ContinuousLinearMap.apply ℝ ℝ v‖ * C :=
          mul_le_mul_of_nonneg_left (hC X η h0 h1 h2 h3) (by positivity)
  have hpdX : ∀ f, bgCoefGood ε f → bgCoefGood ε (pdX f) := by
    intro f hf
    refine hpd f ((1 : ℝ), (0 : ℝ)) (pdX f) hf (fun X η hz => ?_)
    have hd : HasFDerivAt (↿f) (fderiv ℝ (↿f) (X, η)) (X, η) :=
      ((hf.1.contDiffAt (hΩ.mem_nhds hz)).differentiableAt (by norm_num)).hasFDerivAt
    have hc : HasDerivAt (fun Y : ℝ => ((Y, η) : ℝ × ℝ)) ((1 : ℝ), (0 : ℝ)) X :=
      (hasDerivAt_id' X).prodMk (hasDerivAt_const X η)
    exact (hd.comp_hasDerivAt X hc).deriv
  have hpdE : ∀ f, bgCoefGood ε f → bgCoefGood ε (pdE f) := by
    intro f hf
    refine hpd f ((0 : ℝ), (1 : ℝ)) (pdE f) hf (fun X η hz => ?_)
    have hd : HasFDerivAt (↿f) (fderiv ℝ (↿f) (X, η)) (X, η) :=
      ((hf.1.contDiffAt (hΩ.mem_nhds hz)).differentiableAt (by norm_num)).hasFDerivAt
    have hc : HasDerivAt (fun e : ℝ => ((X, e) : ℝ × ℝ)) ((0 : ℝ), (1 : ℝ)) η :=
      (hasDerivAt_const η X).prodMk (hasDerivAt_id' η)
    exact (hd.comp_hasDerivAt η hc).deriv
  have hsum : ∀ (s : Finset ℕ) (f : ℕ → ℝ → ℝ → ℝ), (∀ i ∈ s, bgCoefGood ε (f i)) →
      bgCoefGood ε (fun X η => ∑ i ∈ s, f i X η) := by
    intro s f
    induction s using Finset.induction_on with
    | empty => intro _; exact hcongr _ _ (hconst 0) (fun X η => by simp)
    | @insert a s ha ih =>
      intro hf
      exact hcongr _ _ (hadd _ _ (hf a (Finset.mem_insert_self a s))
        (ih fun i hi => hf i (Finset.mem_insert_of_mem hi))) (fun X η => by rw [Finset.sum_insert ha])

  have hUz : ∀ f, bgCoefGood ε f → bgCoefGood ε (bgUz f) := fun f hf =>
    hcongr _ _ (hadd _ _ hf (hmul _ _ hX (hpdX f hf))) (fun X η => rfl)
  have hVx : ∀ (n : ℕ) f, bgCoefGood ε f → bgCoefGood ε (bgVx h n f) := by
    intro n f hf
    have A1 := hmul _ _ (hmul _ _ (hconst 2) hη) (hUz f hf)
    have A2 := hmul _ _ (hmul _ _ (hconst (2 * (1 / 2 - h + 2 * (n : ℝ) * h))) hη) hf
    have A3 := hmul _ _ (hsub _ _ (hconst 1) (hmul _ _ hη hη)) (hpdE f hf)
    refine hcongr _ _ (hmul _ _ (hsub _ _ (hsub _ _ A1 A2) A3) hinv) (fun X η => ?_)
    simp only [bgVx]
    ring
  have hTop : ∀ (b : ℝ) f, bgCoefGood ε f → bgCoefGood ε (simTop h b f) := by
    intro b f hf
    have A1 := hmul _ _ (hconst (-b)) hf
    have A2 := hmul _ _ (hmul _ _ (hconst (1 / 2 - h)) hη) (hpdE f hf)
    have A3 := hmul _ _ hX (hpdX f hf)
    refine hcongr _ _ (hmul _ _ (hadd _ _ (hadd _ _ A1 A2) A3) hinv) (fun X η => ?_)
    simp only [simTop]
    ring
  have hZop : ∀ (b : ℝ) f, bgCoefGood ε f → bgCoefGood ε (simZop h b f) := by
    intro b f hf
    have A1 := hmul _ _ (hmul _ _ (hconst (2 * b)) hη) hf
    have A2 := hmul _ _ (hsub _ _ (hconst 1) (hmul _ _ hη hη)) (hpdE f hf)
    have A3 := hmul _ _ (hmul _ _ (hmul _ _ (hconst 2) hη) hX) (hpdX f hf)
    refine hcongr _ _ (hmul _ _ (hsub _ _ (hadd _ _ A1 A2) A3) hinv) (fun X η => ?_)
    simp only [simZop]
    ring

  have hsubL : Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 ⊆ Ioi (-εL) ×ˢ Ioo (-1 : ℝ) 1 :=
    prod_mono (fun x hx => by simp only [mem_Ioi] at hx ⊢; linarith) subset_rfl
  have hsubB : Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 ⊆ Ioi (-εB) ×ˢ Ioo (-1 : ℝ) 1 :=
    prod_mono (fun x hx => by simp only [mem_Ioi] at hx ⊢; linarith) subset_rfl
  have hsubP : Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 ⊆ Ioi (-εP) ×ˢ Ioo (-1 : ℝ) 1 :=
    prod_mono (fun x hx => by simp only [mem_Ioi] at hx ⊢; linarith) subset_rfl
  have hSg : ∀ n, bgCoefGood ε (S n) := by
    intro n
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [hS0]
      obtain ⟨hsm, hbd, -⟩ := profRadAvg_props U εL hεL hUs
      exact ⟨hsm.mono hsubL, fun X1 m => hbd X1 m
        ((hFU X1 m).imp fun C hC X η a b c d => (hC X η a b c d).2)⟩
    · exact ⟨(hBsm n hn).1.mono hsubB, fun X1 m =>
        (hBbd n hn m).imp fun C hC X η a _ c d => (hC X η a c d).1⟩
  have hGg : ∀ n, bgCoefGood ε (G n) := by
    intro n
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [hG0]
      exact ⟨hFs.mono hsubL, fun X1 m =>
        (hFU X1 m).imp fun C hC X η a b c d => (hC X η a b c d).1⟩
    · exact ⟨(hBsm n hn).2.1.mono hsubB, fun X1 m =>
        (hBbd n hn m).imp fun C hC X η a _ c d => (hC X η a c d).2.1⟩
  have hWg : ∀ n, bgCoefGood ε (W n) := by
    intro n
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [hW0]
      exact ⟨hPs.mono hsubP, hPb⟩
    · exact ⟨(hBsm n hn).2.2.mono hsubB, fun X1 m =>
        (hBbd n hn m).imp fun C hC X η a _ c d => (hC X η a c d).2.2⟩

  have htr : ∀ (T : ℕ → ℝ → ℝ → ℝ), (∀ n, bgCoefGood ε (T n)) →
      ∀ N n, bgCoefGood ε (bgTrunc N T n) := by
    intro T hT N n
    unfold bgTrunc
    split_ifs
    · exact hT n
    · exact hconst 0

  have hres : ∀ (S' G' W' : ℕ → ℝ → ℝ → ℝ) (k : ℕ), 1 ≤ k → (∀ i, bgCoefGood ε (S' i)) →
      (∀ i, bgCoefGood ε (G' i)) → (∀ i, bgCoefGood ε (W' i)) →
      bgCoefGood ε (bgResRad h S' G' W' k) ∧ bgCoefGood ε (bgResTh h S' G' W' k) ∧
        bgCoefGood ε (bgResZ h S' G' W' k) := by
    intro S' G' W' k hk hSg' hGg' hWg'
    refine ⟨?_, ?_, ?_⟩
    · have R1 := hpdX _ (hWg' k)
      have R2 := hsum (Finset.range (k + 1)) (fun i X η => G' i X η * G' (k - i) X η)
        (fun i _ => hmul _ _ (hGg' i) (hGg' (k - i)))
      have R3 := hmul _ _ (bgOm_good h ε S' (k - 1) hh0 hh2 hε (fun i _ => hSg' i)) (hconst (1 / 2))
      refine hcongr _ _ (hadd _ _ (hsub _ _ R1 R2) R3) (fun X η => ?_)
      simp only [bgResRad, if_pos hk]
      ring
    · have R1 := hTop (-(1 + h) + 2 * (k : ℝ) * h) _ (hGg' k)
      have R2 := hmul _ _ (hconst 2) (hadd _ _ (hmul _ _ hX (hpdX _ (hpdX _ (hGg' k))))
        (hmul _ _ (hconst 2) (hpdX _ (hGg' k))))
      have R3 := hsum (Finset.range (k + 1))
        (fun i X η => bgVx h i (S' i) X η * (G' (k - i) X η + X * pdX (G' (k - i)) X η)
            + bgUz (S' i) X η * simZop h (-(1 + h) + 2 * ((k - i : ℕ) : ℝ) * h) (G' (k - i)) X η)
        (fun i _ => hadd _ _ (hmul _ _ (hVx i (S' i) (hSg' i))
            (hadd _ _ (hGg' (k - i)) (hmul _ _ hX (hpdX _ (hGg' (k - i))))))
          (hmul _ _ (hUz _ (hSg' i)) (hZop _ _ (hGg' (k - i)))))
      have R4 := hZop (-(1 + h) + 2 * ((k - 1 : ℕ) : ℝ) * h - (1 / 2 - h)) _
        (hZop (-(1 + h) + 2 * ((k - 1 : ℕ) : ℝ) * h) _ (hGg' (k - 1)))
      refine hcongr _ _ (hsub _ _ (hadd _ _ (hsub _ _ R1 R2) R3) R4) (fun X η => ?_)
      simp only [bgResTh, if_pos hk]
    · have Z1 := hTop (-(1 / 2 + h) + 2 * (k : ℝ) * h) _ (hUz _ (hSg' k))
      have Z2 := hZop (-(1 + 2 * h) + 2 * (k : ℝ) * h) _ (hWg' k)
      have Z3 := hmul _ _ (hconst 2) (hadd _ _ (hmul _ _ hX (hpdX _ (hpdX _ (hUz _ (hSg' k)))))
        (hpdX _ (hUz _ (hSg' k))))
      have Z4 := hsum (Finset.range (k + 1))
        (fun i X η => X * bgVx h i (S' i) X η * pdX (bgUz (S' (k - i))) X η
            + bgUz (S' i) X η * simZop h (-(1 / 2 + h) + 2 * ((k - i : ℕ) : ℝ) * h) (bgUz (S' (k - i))) X η)
        (fun i _ => hadd _ _ (hmul _ _ (hmul _ _ hX (hVx i (S' i) (hSg' i)))
            (hpdX _ (hUz _ (hSg' (k - i)))))
          (hmul _ _ (hUz _ (hSg' i)) (hZop _ _ (hUz _ (hSg' (k - i))))))
      have Z5 := hZop (-(1 / 2 + h) + 2 * ((k - 1 : ℕ) : ℝ) * h - (1 / 2 - h)) _
        (hZop (-(1 / 2 + h) + 2 * ((k - 1 : ℕ) : ℝ) * h) _ (hUz _ (hSg' (k - 1))))
      refine hcongr _ _ (hsub _ _ (hadd _ _ (hsub _ _ (hadd _ _ Z1 Z2) Z3) Z4) Z5) (fun X η => ?_)
      simp only [bgResZ, if_pos hk]
  refine ⟨ε, hε, fun n => ⟨(hSg n).1, (hGg n).1, (hWg n).1⟩, ?_⟩
  intro N k hk
  obtain ⟨hR, hT, hZ⟩ := hres _ _ _ k hk (htr S hSg N) (htr G hGg N) (htr W hWg N)
  refine ⟨hR.1, hT.1, hZ.1, ?_⟩
  intro X1 m
  obtain ⟨C1, h1⟩ := hR.2 X1 m
  obtain ⟨C2, h2⟩ := hT.2 X1 m
  obtain ⟨C3, h3⟩ := hZ.2 X1 m
  refine ⟨max C1 (max C2 C3), fun X η a b c d => ⟨(h1 X η a b c d).trans (le_max_left _ _),
    (h2 X η a b c d).trans ((le_max_left _ _).trans (le_max_right _ _)),
    (h3 X η a b c d).trans ((le_max_right _ _).trans (le_max_right _ _))⟩⟩

theorem curl_field_contDiffOn_bounded : ∀ (A Bv : ℝ³ → ℝ → ℝ³) (O S : Set (ℝ³ × ℝ)), IsOpen O → S ⊆ O → ContDiffOn ℝ ∞ (↿A) O → ContDiffOn ℝ ∞ (↿Bv) O → ContDiffOn ℝ ∞ (↿(fun y s => curl3 (fun w => A w s) y + Bv y s)) O ∧ ((∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿A) z‖ ≤ C ∧ ‖iteratedFDeriv ℝ k (↿Bv) z‖ ≤ C) → ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿(fun y s => curl3 (fun w => A w s) y + Bv y s)) z‖ ≤ C) :=
by
  intro A Bv O S hO hS hA hB
  let ev : Fin 3 → Fin 3 → ((ℝ³ × ℝ) →L[ℝ] ℝ³) →L[ℝ] ℝ := fun a b =>
    (EuclideanSpace.proj b).comp
      (ContinuousLinearMap.apply ℝ ℝ³ ((EuclideanSpace.single a (1:ℝ) : ℝ³), (0:ℝ)))
  let L : ((ℝ³ × ℝ) →L[ℝ] ℝ³) →L[ℝ] ℝ³ :=
    (ev 1 2 - ev 2 1).smulRight (EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) +
    (ev 2 0 - ev 0 2).smulRight (EuclideanSpace.single (1 : Fin 3) (1 : ℝ)) +
    (ev 0 1 - ev 1 0).smulRight (EuclideanSpace.single (2 : Fin 3) (1 : ℝ))
  have hLapp : ∀ Φ : (ℝ³ × ℝ) →L[ℝ] ℝ³, L Φ =
      (Φ (EuclideanSpace.single 1 1, 0) 2 - Φ (EuclideanSpace.single 2 1, 0) 1) •
          EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
        (Φ (EuclideanSpace.single 2 1, 0) 0 - Φ (EuclideanSpace.single 0 1, 0) 2) •
          EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
        (Φ (EuclideanSpace.single 0 1, 0) 1 - Φ (EuclideanSpace.single 1 1, 0) 0) •
          EuclideanSpace.single (2 : Fin 3) (1 : ℝ) := by
    intro Φ
    rfl
  have hslice : ∀ z ∈ O, ∀ v : ℝ³,
      fderiv ℝ (fun w => A w z.2) z.1 v = fderiv ℝ (↿A) z (v, 0) := by
    intro z hz v
    have hd : DifferentiableAt ℝ (↿A) z :=
      (hA.contDiffAt (hO.mem_nhds hz)).differentiableAt (by simp)
    have hd' : DifferentiableAt ℝ (↿A) (z.1, z.2) := hd
    have he : (fun w => A w z.2) = (↿A) ∘ (fun w : ℝ³ => (w, z.2)) := rfl
    rw [he, fderiv_comp z.1 hd' (hasFDerivAt_prodMk_left z.1 z.2).differentiableAt,
      (hasFDerivAt_prodMk_left z.1 z.2).fderiv]
    rfl
  let G : ℝ³ × ℝ → ℝ³ := fun z => L (fderiv ℝ (↿A) z) + (↿Bv) z
  have hE : ∀ z ∈ O, (↿(fun y s => curl3 (fun w => A w s) y + Bv y s)) z = G z := by
    intro z hz
    show curl3 (fun w => A w z.2) z.1 + Bv z.1 z.2 = L (fderiv ℝ (↿A) z) + Bv z.1 z.2
    rw [hLapp]
    simp only [curl3, hslice z hz]
  have hfd : ContDiffOn ℝ ∞ (fderiv ℝ (↿A)) O := hA.fderiv_of_isOpen hO (by simp)
  have hLf : ContDiffOn ℝ ∞ (fun z => L (fderiv ℝ (↿A) z)) O := hfd.continuousLinearMap_comp L
  have hGs : ContDiffOn ℝ ∞ G O := hLf.add hB
  refine ⟨hGs.congr hE, ?_⟩
  intro H k
  obtain ⟨C₁, hC₁⟩ := H (k + 1)
  obtain ⟨C₂, hC₂⟩ := H k
  refine ⟨‖L‖ * C₁ + C₂, fun z hz => ?_⟩
  have hzO : O ∈ nhds z := hO.mem_nhds (hS hz)
  have hev : (↿(fun y s => curl3 (fun w => A w s) y + Bv y s)) =ᶠ[nhds z] G :=
    Filter.eventuallyEq_of_mem hzO hE
  rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
  have hkle : ((k : ℕ∞) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have hF : ContDiffAt ℝ k (fun z => L (fderiv ℝ (↿A) z)) z :=
    (hLf.contDiffAt hzO).of_le hkle
  have hG : ContDiffAt ℝ k (↿Bv) z := (hB.contDiffAt hzO).of_le hkle
  have hsplit : iteratedFDeriv ℝ k G z =
      iteratedFDeriv ℝ k (fun z => L (fderiv ℝ (↿A) z)) z + iteratedFDeriv ℝ k (↿Bv) z :=
    iteratedFDeriv_add_apply hF hG
  rw [hsplit]
  have h1 : ‖iteratedFDeriv ℝ k (fun z => L (fderiv ℝ (↿A) z)) z‖ ≤
      ‖L‖ * ‖iteratedFDeriv ℝ k (fderiv ℝ (↿A)) z‖ :=
    L.norm_iteratedFDeriv_comp_left (hfd.contDiffAt hzO) hkle
  rw [norm_iteratedFDeriv_fderiv] at h1
  calc _ ≤ _ := norm_add_le _ _
    _ ≤ ‖L‖ * C₁ + C₂ :=
      add_le_add (h1.trans (mul_le_mul_of_nonneg_left (hC₁ z hz).1 L.opNorm_nonneg))
        (hC₂ z hz).2

theorem nsResidual_contDiffOn_eq_jet : ∀ (ν : ℝ) (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (O : Set (ℝ³ × ℝ)), IsOpen O → ContDiffOn ℝ ∞ (↿u) O → ContDiffOn ℝ ∞ (↿p) O → ContDiffOn ℝ ∞ (↿(nsResidual ν u p)) O ∧ ∀ z ∈ O, (↿(nsResidual ν u p)) z = nsJet ν u p z :=
by
  intro ν u p O hO hu hp

  have s1 : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (x : ℝ³)
      (t : ℝ), DifferentiableAt ℝ f (x, t) →
      deriv (fun s => f (x, s)) t = fderiv ℝ f (x, t) ((0 : ℝ³), (1 : ℝ)) ∧
      fderiv ℝ (fun y => f (y, t)) x =
        (fderiv ℝ f (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := by
    intro F _ _ f x t hf
    constructor
    · have hγ : HasDerivAt (fun s : ℝ => ((x, s) : ℝ³ × ℝ)) ((0 : ℝ³), (1 : ℝ)) t :=
        (hasDerivAt_const t x).prodMk (hasDerivAt_id t)
      exact (hf.hasFDerivAt.comp_hasDerivAt t hγ).deriv
    · exact (hf.hasFDerivAt.comp x (hasFDerivAt_prodMk_left x t)).fderiv

  have s2 : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (x : ℝ³)
      (t : ℝ), ContDiffOn ℝ ∞ f O → (x, t) ∈ O → ∀ a b : ℝ³,
      fderiv ℝ (fderiv ℝ (fun y => f (y, t))) x a b =
        fderiv ℝ (fderiv ℝ f) (x, t) (a, (0 : ℝ)) (b, (0 : ℝ)) := by
    intro F _ _ f x t hf hxt a b
    have hemb : Continuous (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) :=
      continuous_id.prodMk continuous_const
    have hN : {y : ℝ³ | (y, t) ∈ O} ∈ nhds x := (hO.preimage hemb).mem_nhds hxt
    let Φ : (ℝ³ × ℝ →L[ℝ] F) →L[ℝ] (ℝ³ →L[ℝ] F) :=
      (ContinuousLinearMap.compL ℝ ℝ³ (ℝ³ × ℝ) F).flip (ContinuousLinearMap.inl ℝ ℝ³ ℝ)
    have hΦ : ∀ M, Φ M = M.comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := fun M => rfl
    have hev : fderiv ℝ (fun y => f (y, t)) =ᶠ[nhds x] fun y => Φ (fderiv ℝ f (y, t)) := by
      filter_upwards [hN] with y hy
      have hd : DifferentiableAt ℝ f (y, t) :=
        (hf.contDiffAt (hO.mem_nhds hy)).differentiableAt (by simp)
      rw [hΦ]
      exact (s1 f y t hd).2
    have hDf : ContDiffOn ℝ ∞ (fderiv ℝ f) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hf).2
    have hD2 : HasFDerivAt (fderiv ℝ f) (fderiv ℝ (fderiv ℝ f) (x, t)) (x, t) :=
      ((hDf.contDiffAt (hO.mem_nhds hxt)).differentiableAt (by simp)).hasFDerivAt
    have hg : HasFDerivAt (fun y => Φ (fderiv ℝ f (y, t)))
        (Φ.comp ((fderiv ℝ (fderiv ℝ f) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ))) x :=
      Φ.hasFDerivAt.comp x (hD2.comp x (hasFDerivAt_prodMk_left x t))
    rw [hev.fderiv_eq, hg.fderiv]
    rfl

  have s3 : ∀ (g : ℝ³ → ℝ) (x : ℝ³), gradient g x = ∑ i : Fin 3,
      fderiv ℝ g x (EuclideanSpace.single i (1 : ℝ)) • EuclideanSpace.single i (1 : ℝ) := by
    intro g x
    have h := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr' (gradient g x)
    rw [← h]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    simp only [EuclideanSpace.basisFun_apply]
    congr 1
    rw [real_inner_comm]
    exact InnerProductSpace.toDual_symm_apply

  have s4 : ∀ (g : ℝ³ → ℝ³) (x : ℝ³), Δ g x = ∑ i : Fin 3,
      fderiv ℝ (fderiv ℝ g) x (EuclideanSpace.single i (1 : ℝ)) (EuclideanSpace.single i (1 : ℝ)) := by
    intro g x
    have h := congrFun (InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis g
      (EuclideanSpace.basisFun (Fin 3) ℝ)) x
    rw [h]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [iteratedFDeriv_two_apply]
    simp [EuclideanSpace.basisFun_apply]

  have hDu : ContDiffOn ℝ ∞ (fderiv ℝ (↿u)) O :=
    ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hu).2
  have hD2u : ContDiffOn ℝ ∞ (fderiv ℝ (fderiv ℝ (↿u))) O :=
    ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hDu).2
  have hDp : ContDiffOn ℝ ∞ (fderiv ℝ (↿p)) O :=
    ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hp).2
  have hT3 : ContDiffOn ℝ ∞ (fun z => ∑ i : Fin 3, fderiv ℝ (fderiv ℝ (↿u)) z
      (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) (EuclideanSpace.single i (1 : ℝ), (0 : ℝ))) O :=
    ContDiffOn.sum fun i _ => (hD2u.clm_apply contDiffOn_const).clm_apply contDiffOn_const
  have hT4 : ContDiffOn ℝ ∞ (fun z => ∑ i : Fin 3, fderiv ℝ (↿p) z
      (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) • EuclideanSpace.single i (1 : ℝ)) O :=
    ContDiffOn.sum fun i _ => (hDp.clm_apply contDiffOn_const).smul contDiffOn_const
  have hJ : ContDiffOn ℝ ∞ (nsJet ν u p) O := by
    unfold nsJet
    exact (((hDu.clm_apply contDiffOn_const).add
      (hDu.clm_apply (hu.prodMk contDiffOn_const))).sub (hT3.const_smul ν)).add hT4

  have hid : ∀ z ∈ O, (↿(nsResidual ν u p)) z = nsJet ν u p z := by
    rintro ⟨x, t⟩ hz
    have hu' : DifferentiableAt ℝ (↿u) (x, t) :=
      (hu.contDiffAt (hO.mem_nhds hz)).differentiableAt (by simp)
    have hp' : DifferentiableAt ℝ (↿p) (x, t) :=
      (hp.contDiffAt (hO.mem_nhds hz)).differentiableAt (by simp)
    have e1 : deriv (fun s => u x s) t = fderiv ℝ (↿u) (x, t) ((0 : ℝ³), (1 : ℝ)) :=
      (s1 (↿u) x t hu').1
    have e2 : fderiv ℝ (fun y => u y t) x (u x t) =
        fderiv ℝ (↿u) (x, t) ((↿u) (x, t), (0 : ℝ)) := by
      have h2 : fderiv ℝ (fun y => u y t) x =
          (fderiv ℝ (↿u) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := (s1 (↿u) x t hu').2
      rw [h2]
      rfl
    have e3 : Δ (fun y => u y t) x = ∑ i : Fin 3, fderiv ℝ (fderiv ℝ (↿u)) (x, t)
        (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) := by
      rw [s4]
      exact Finset.sum_congr rfl (fun i _ => s2 (↿u) x t hu hz _ _)
    have e4 : gradient (fun y => p y t) x = ∑ i : Fin 3, fderiv ℝ (↿p) (x, t)
        (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) • EuclideanSpace.single i (1 : ℝ) := by
      have h2 : fderiv ℝ (fun y => p y t) x =
          (fderiv ℝ (↿p) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := (s1 (↿p) x t hp').2
      rw [s3, h2]
      rfl
    show nsResidual ν u p x t = nsJet ν u p (x, t)
    rw [nsResidual, e1, e2, e3, e4]
    rfl
  exact ⟨hJ.congr hid, hid⟩

theorem bg_residual_axis_continuous : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) (S G W : ℕ → ℝ → ℝ → ℝ), SimScaleProps h → LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → Xa < Xm → BgCoeffSeq h Xm Xs m1 m2 F U S G W → ∀ (N : ℕ) (x : ℝ³) (t : ℝ), t < 1 → x 0 ^ 2 + x 1 ^ 2 = 0 → ContinuousAt (↿(fun (y : ℝ³) (s : ℝ) => nsResidual 1 (fun y' s' => curl3 (fun w => ∑ n ∈ Finset.range (N + 1), bgAn h n (S n) w s') y' + ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y' s') (fun y' s' => ∑ n ∈ Finset.range (N + 1), bgPn h n (W n) y' s') y s - stressDivField h (bgTsum h (bgTthSeq h T0th S G W) N) (bgTsum h (bgTzSeq h T0z S G W) N) y s)) (x, t) :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs F U T0th T0z S G W hS hL hXam hB N x t ht hr
  have hL' := hL
  obtain ⟨⟨-, -, -, -, -, -, -, hXa, -⟩, -, ⟨-, -, hT0van, -⟩, -, ⟨εL, hεL, hFε, hUε, -⟩, -⟩ := hL'
  have hB' := hB
  obtain ⟨⟨hS0, hG0, hW0⟩, ⟨εB, hεB, hBsm⟩, -, -, -, -, hBin, -⟩ := hB'

  have hsub : ∀ ε : ℝ, 0 < ε → Ici (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi (-ε) ×ˢ Ioo (-1) 1 :=
    fun ε hε => prod_mono (fun y hy => by simp only [mem_Ici] at hy; simp only [mem_Ioi]; linarith)
      subset_rfl
  have hin : ∀ n : ℕ, ContDiffOn ℝ ∞ (↿(S n)) (Ici 0 ×ˢ Ioo (-1) 1) ∧
      ContDiffOn ℝ ∞ (↿(G n)) (Ici 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(W n)) (Ici 0 ×ˢ Ioo (-1) 1) := by
    intro n
    by_cases hn : n = 0
    · subst hn
      obtain ⟨εP, hεP, hP, -⟩ :=
        leadPi_smooth_bounds h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hL
      rw [hS0, hG0, hW0]
      exact ⟨((profRadAvg_props U εL hεL hUε).1).mono (hsub εL hεL), hFε.mono (hsub εL hεL),
        hP.mono (hsub εP hεP)⟩
    · obtain ⟨a, b, c⟩ := hBsm n (by omega)
      exact ⟨a.mono (hsub εB hεB), b.mono (hsub εB hεB), c.mono (hsub εB hεB)⟩

  have hΩo : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  have hA : ContDiffOn ℝ ∞ (↿(fun (w : ℝ³) (s' : ℝ) => ∑ n ∈ Finset.range (N + 1), bgAn h n (S n) w s'))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    show ContDiffOn ℝ ∞ (fun z => ∑ n ∈ Finset.range (N + 1), (↿(bgAn h n (S n))) z) _
    exact ContDiffOn.sum (fun n _ => (bg_field_smooth_div h n (S n) hS (hin n).1).1)
  have hBv : ContDiffOn ℝ ∞ (↿(fun (y' : ℝ³) (s' : ℝ) => ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y' s'))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    show ContDiffOn ℝ ∞ (fun z => ∑ n ∈ Finset.range (N + 1), (↿(bgBn h n (G n))) z) _
    exact ContDiffOn.sum (fun n _ => (bg_field_smooth_div h n (G n) hS (hin n).2.1).2.1)
  have hp : ContDiffOn ℝ ∞ (↿(fun (y' : ℝ³) (s' : ℝ) => ∑ n ∈ Finset.range (N + 1), bgPn h n (W n) y' s'))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    show ContDiffOn ℝ ∞ (fun z => ∑ n ∈ Finset.range (N + 1), (↿(bgPn h n (W n))) z) _
    exact ContDiffOn.sum (fun n _ => (bg_field_smooth_div h n (W n) hS (hin n).2.2).2.2.1)
  have hu : ContDiffOn ℝ ∞ (↿(fun (y' : ℝ³) (s' : ℝ) => curl3 (fun w => ∑ n ∈ Finset.range (N + 1),
      bgAn h n (S n) w s') y' + ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y' s'))
      {w : ℝ³ × ℝ | w.2 < 1} :=
    (curl_field_contDiffOn_bounded _ _ _ _ hΩo subset_rfl hA hBv).1
  have hR : ContDiffOn ℝ ∞ (↿(nsResidual 1 (fun y' s' => curl3 (fun w => ∑ n ∈ Finset.range (N + 1),
      bgAn h n (S n) w s') y' + ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y' s')
      (fun y' s' => ∑ n ∈ Finset.range (N + 1), bgPn h n (W n) y' s'))) {w : ℝ³ × ℝ | w.2 < 1} :=
    (nsResidual_contDiffOn_eq_jet 1 _ _ _ hΩo hu hp).1
  have hRc := hR.continuousOn.continuousAt (hΩo.mem_nhds (show ((x, t) : ℝ³ × ℝ).2 < 1 from ht))

  have hq0 : 0 < simScale h (x 2) (1 - t) := (hS.1 (x 2) (1 - t) (by linarith)).1
  have hq : ContinuousAt (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) (x, t) := by
    have hc : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (x 2, 1 - t) :=
      hS.2.2.2.1.continuousOn.continuousAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds
        ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩)
    have hg : ContinuousAt (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) (x, t) :=
      (by fun_prop : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ))).continuousAt
    exact ContinuousAt.comp (g := fun w : ℝ × ℝ => simScale h w.1 w.2)
      (f := fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) hc hg
  have hX : ContinuousAt (fun w : ℝ³ × ℝ => simX h w.1 w.2) (x, t) := by
    show ContinuousAt (fun w : ℝ³ × ℝ => (w.1 0 ^ 2 + w.1 1 ^ 2) / (2 * simScale h (w.1 2) (1 - w.2))) (x, t)
    refine ContinuousAt.div₀ ?_ (continuousAt_const.mul hq) ?_
    · exact (by fun_prop : Continuous (fun w : ℝ³ × ℝ => w.1 0 ^ 2 + w.1 1 ^ 2)).continuousAt
    · exact mul_ne_zero two_ne_zero hq0.ne'
  have hX0 : simX h x t = 0 := by unfold simX; rw [hr, zero_div]
  have hev : ∀ᶠ w in nhds ((x, t) : ℝ³ × ℝ), simX h w.1 w.2 < Xa :=
    hX.eventually_lt continuousAt_const (show simX h x t < Xa by rw [hX0]; exact hXa)

  have hseq : ∀ (n : ℕ) (Y η : ℝ), Y ≤ Xa →
      bgTthSeq h T0th S G W n Y η = 0 ∧ bgTzSeq h T0z S G W n Y η = 0 := by
    intro n Y η hY
    by_cases hn : n = 0
    · subst hn
      simp only [bgTthSeq, bgTzSeq, ↓reduceIte]
      by_cases hY0 : 0 < Y
      · rw [if_pos hY0, if_pos hY0]; exact hT0van Y η hY0 (Or.inl hY)
      · rw [if_neg hY0, if_neg hY0]; exact ⟨rfl, rfl⟩
    · have hn1 : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hn
      simp only [bgTthSeq, bgTzSeq, hn, ↓reduceIte, stressPrimTh, stressPrimZ]
      by_cases hg : 0 < Y ∧ -1 < η ∧ η < 1
      · rw [if_pos hg, if_pos hg]
        have hint : ∀ u ∈ Ioc (0:ℝ) Y, bgResTh h S G W n u η = 0 ∧ bgResZ h S G W n u η = 0 :=
          fun u hu => hBin n hn1 u η hu.1 (by linarith [hu.2]) hg.2.1 hg.2.2
        have e1 : ∫ u in Ioc (0:ℝ) Y, u * bgResTh h S G W n u η = 0 :=
          MeasureTheory.setIntegral_eq_zero_of_forall_eq_zero (fun u hu => by rw [(hint u hu).1, mul_zero])
        have e2 : ∫ u in Ioc (0:ℝ) Y, bgResZ h S G W n u η = 0 :=
          MeasureTheory.setIntegral_eq_zero_of_forall_eq_zero (fun u hu => (hint u hu).2)
        rw [intervalIntegral.integral_of_le hg.1.le, intervalIntegral.integral_of_le hg.1.le, e1, e2]
        simp
      · rw [if_neg hg, if_neg hg]; exact ⟨rfl, rfl⟩
  have hTs : ∀ q Y η : ℝ, Y ≤ Xa → bgTsum h (bgTthSeq h T0th S G W) N q Y η = 0 ∧
      bgTsum h (bgTzSeq h T0z S G W) N q Y η = 0 := by
    intro q Y η hY
    unfold bgTsum
    exact ⟨Finset.sum_eq_zero (fun n _ => by rw [(hseq n Y η hY).1, mul_zero]),
      Finset.sum_eq_zero (fun n _ => by rw [(hseq n Y η hY).2, mul_zero])⟩

  have hsdf : ∀ (y : ℝ³) (s : ℝ), simX h y s < Xa →
      stressDivField h (bgTsum h (bgTthSeq h T0th S G W) N) (bgTsum h (bgTzSeq h T0z S G W) N) y s = 0 := by
    intro y s hy
    have key : ∀ (T : ℝ → ℝ → ℝ → ℝ), (∀ q Y η, Y ≤ Xa → T q Y η = 0) → ∀ q η,
        deriv (fun Y => T q Y η) (simX h y s) = 0 ∧ T q (simX h y s) η = 0 := by
      intro T hT q η
      refine ⟨?_, hT q _ η hy.le⟩
      have hev0 : (fun Y => T q Y η) =ᶠ[nhds (simX h y s)] fun _ => (0:ℝ) :=
        Filter.eventuallyEq_of_mem (Iio_mem_nhds hy) (fun Y hY => hT q Y η (le_of_lt hY))
      rw [hev0.deriv_eq, deriv_const]
    obtain ⟨d1, v1⟩ := key (bgTsum h (bgTthSeq h T0th S G W) N) (fun q Y η hY => (hTs q Y η hY).1)
      (simScale h (y 2) (1 - s)) (simEta h y s)
    obtain ⟨d2, v2⟩ := key (bgTsum h (bgTzSeq h T0z S G W) N) (fun q Y η hY => (hTs q Y η hY).2)
      (simScale h (y 2) (1 - s)) (simEta h y s)
    unfold stressDivField
    rw [d1, v1, d2, v2]
    simp

  refine hRc.congr ?_
  filter_upwards [hev] with w hw
  rcases w with ⟨y, s⟩
  have e : stressDivField h (bgTsum h (bgTthSeq h T0th S G W) N) (bgTsum h (bgTzSeq h T0z S G W) N) y s = 0 :=
    hsdf y s hw
  show nsResidual 1 (fun y' s' => curl3 (fun w => ∑ n ∈ Finset.range (N + 1), bgAn h n (S n) w s') y' + ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y' s') (fun y' s' => ∑ n ∈ Finset.range (N + 1), bgPn h n (W n) y' s') y s = nsResidual 1 (fun y' s' => curl3 (fun w => ∑ n ∈ Finset.range (N + 1), bgAn h n (S n) w s') y' + ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y' s') (fun y' s' => ∑ n ∈ Finset.range (N + 1), bgPn h n (W n) y' s') y s - stressDivField h (bgTsum h (bgTthSeq h T0th S G W) N) (bgTsum h (bgTzSeq h T0z S G W) N) y s
  rw [e, sub_zero]

theorem bg_residual_remainder : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) (S G W : ℕ → ℝ → ℝ → ℝ), SimScaleProps h → LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → Xa < Xm → Xm < Xs → Xs < Xb → BgCoeffSeq h Xm Xs m1 m2 F U S G W → ∃ Kr : ℕ → ℝ, ∀ N m : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 → ‖iteratedFDeriv ℝ m (↿(fun (y : ℝ³) (s : ℝ) => nsResidual 1 (fun y' s' => curl3 (fun w => ∑ n ∈ Finset.range (N + 1), bgAn h n (S n) w s') y' + ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y' s') (fun y' s' => ∑ n ∈ Finset.range (N + 1), bgPn h n (W n) y' s') y s - stressDivField h (bgTsum h (bgTthSeq h T0th S G W) N) (bgTsum h (bgTzSeq h T0z S G W) N) y s)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (2 * h * ((N : ℝ) + 1) - Kr m) :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs F U T0th T0z S G W hS hL hXam hXms hXsb hB
  have hL' := hL
  unfold LeadingProfile at hL'
  obtain ⟨⟨hh0, hh1, -, -, -, -, -, hXa, hXp1, hp12, hp2m1, hm12, hm2v, hXvc, hXcb⟩, -, -, -, -,
    -, -, hXv, -⟩ := hL'
  have hB' := hB
  unfold BgCoeffSeq at hB'
  obtain ⟨⟨hS0, hG0, hW0⟩, -, -, hBsupp, -, -, -, -⟩ := hB'
  have hh2 : h < 1 / 2 := by linarith
  obtain ⟨ε, hε, -, hεres⟩ :=
    bg_trunc_coef_regular h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs F U T0th T0z S G W hS hL hB
  have hΩo : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  have hup : ∀ {f : ℝ³ × ℝ → ℝ³} {z : ℝ³ × ℝ} (k : ℕ), ContDiffAt ℝ ∞ f z → ContDiffAt ℝ k f z :=
    fun k hf => hf.of_le (by exact_mod_cast le_top)
  have hS0van : ∀ Y e : ℝ, Xv < Y → -1 < e → e < 1 → profRadAvg U Y e = 0 := by
    intro Y e hY h1 h2
    have hY0 : 0 < Y := by linarith
    have hcv : profRadAvg U Y e = Y⁻¹ * profRadInt U Y e := by
      unfold profRadAvg profRadInt
      rw [intervalIntegral.integral_comp_mul_right (fun x => U x e) hY0.ne', zero_mul, one_mul,
        smul_eq_mul]
    rw [hcv, (hXv Y e hY.le h1 h2).2, mul_zero]
  refine ⟨fun m => 2 + 2 * h + (m : ℝ), ?_⟩
  intro N m

  have hTr : ∀ (T : ℕ → ℝ → ℝ → ℝ) (j : ℕ), j ≤ N → bgTrunc N T j = T j :=
    fun T j hj => by simp [bgTrunc, hj]
  have hTr0 : ∀ (T : ℕ → ℝ → ℝ → ℝ) (j : ℕ), ¬ j ≤ N → bgTrunc N T j = fun _ _ => 0 :=
    fun T j hj => by simp [bgTrunc, hj]

  have hvan : ∀ k : ℕ, 1 ≤ k → ∀ X η : ℝ, Xb < X → -1 < η → η < 1 →
      bgResRad h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k X η = 0 ∧
      bgResTh h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k X η = 0 ∧
      bgResZ h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k X η = 0 := by
    refine bg_res_tail_vanish_generic h Xb (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) ?_ ?_ ?_
    · intro Y e hY h1 h2
      rw [hTr S 0 (Nat.zero_le N), hS0]
      exact hS0van Y e (by linarith) h1 h2
    · intro Y e hY h1 h2
      rw [hTr G 0 (Nat.zero_le N), hG0]
      exact lead_F_axial_null_ext h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hL Y e
        hY h1 h2
    · intro j hj Y e hY h1 h2
      by_cases hjN : j ≤ N
      · rw [hTr S j hjN, hTr G j hjN, hTr W j hjN]
        exact hBsupp j hj Y e (by linarith)
      · rw [hTr0 S j hjN, hTr0 G j hjN, hTr0 W j hjN]
        exact ⟨rfl, rfl, rfl⟩

  obtain ⟨E, hE⟩ : ∃ E : ℝ, E = 2 * h * ((N : ℝ) + 1) - (2 + 2 * h + (m : ℝ)) := ⟨_, rfl⟩

  obtain ⟨P, hP⟩ : ∃ P : ℝ → (ℝ → ℝ → ℝ) → (ℝ³ → ℝ³) → ℝ³ × ℝ → ℝ³,
      P = fun b c v z => (simScale h (z.1 2) (1 - z.2) ^ b * c (simX h z.1 z.2) (simEta h z.1 z.2)) • v z.1 :=
    ⟨_, rfl⟩
  have hterm : ∀ (b : ℝ) (c : ℝ → ℝ → ℝ) (v : ℝ³ → ℝ³),
      (v = radVec ∨ v = azVec ∨ v = fun _ => EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) →
      ContDiffOn ℝ ∞ (↿c) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
      (∀ X η : ℝ, Xb < X → -1 < η → η < 1 → c X η = 0) →
      (∀ m' : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ Xb → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ m' (↿c) (X, η)‖ ≤ C) →
      2 * h * ((N : ℝ) + 1) - (2 + 2 * h) ≤ b →
      ContDiffOn ℝ ∞ (P b c v) {w : ℝ³ × ℝ | w.2 < 1} ∧
      ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
        ‖iteratedFDeriv ℝ m (P b c v) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ E := by
    intro b c v hv hc hcv hbd hb
    obtain ⟨hsm, hbnd⟩ := sim_frame_field_bound h hh0 hh2 hS c b ε Xb v hε hc hcv hbd hv
    rw [hP]
    refine ⟨hsm, ?_⟩
    obtain ⟨C, hC⟩ := hbnd m
    refine ⟨max C 0, fun x t hxt => ?_⟩
    have hxt' : t < 1 ∧ simScale h (x 2) (1 - t) < 1 := hxt
    have hq0 : 0 < simScale h (x 2) (1 - t) := (hS.1 (x 2) (1 - t) (by linarith [hxt'.1])).1
    have hpow : simScale h (x 2) (1 - t) ^ (b - (m : ℝ)) ≤ simScale h (x 2) (1 - t) ^ E :=
      Real.rpow_le_rpow_of_exponent_ge hq0 hxt'.2.le (by rw [hE]; linarith)
    have hp0 : 0 ≤ simScale h (x 2) (1 - t) ^ (b - (m : ℝ)) := Real.rpow_nonneg hq0.le _
    calc ‖iteratedFDeriv ℝ m (fun z : ℝ³ × ℝ => (simScale h (z.1 2) (1 - z.2) ^ b *
            c (simX h z.1 z.2) (simEta h z.1 z.2)) • v z.1) (x, t)‖
        ≤ C * simScale h (x 2) (1 - t) ^ (b - (m : ℝ)) := hC x t hxt
      _ ≤ max C 0 * simScale h (x 2) (1 - t) ^ (b - (m : ℝ)) :=
          mul_le_mul_of_nonneg_right (le_max_left _ _) hp0
      _ ≤ max C 0 * simScale h (x 2) (1 - t) ^ E := mul_le_mul_of_nonneg_left hpow (le_max_right _ _)

  obtain ⟨T, hT⟩ : ∃ T : ℕ → ℝ³ × ℝ → ℝ³, T = fun (k : ℕ) (z : ℝ³ × ℝ) =>
      P (-(2 + 2 * h) + 2 * (k : ℝ) * h) (bgResRad h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k) radVec z +
      P (-(2 + h) + 2 * (k : ℝ) * h) (bgResTh h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k) azVec z +
      P (-(3 / 2 + h) + 2 * (k : ℝ) * h) (bgResZ h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k)
        (fun _ => EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) z := ⟨_, rfl⟩
  have hadd3 : ∀ (f1 f2 f3 : ℝ³ × ℝ → ℝ³) (z : ℝ³ × ℝ), ContDiffAt ℝ m f1 z → ContDiffAt ℝ m f2 z →
      ContDiffAt ℝ m f3 z → iteratedFDeriv ℝ m (fun w => f1 w + f2 w + f3 w) z =
        iteratedFDeriv ℝ m f1 z + iteratedFDeriv ℝ m f2 z + iteratedFDeriv ℝ m f3 z := by
    intro f1 f2 f3 z h1 h2 h3
    have h12 : ContDiffAt ℝ m (f1 + f2) z := h1.add h2
    rw [show (fun w => f1 w + f2 w + f3 w) = f1 + f2 + f3 from rfl, iteratedFDeriv_add_apply h12 h3,
      iteratedFDeriv_add_apply h1 h2]
  have hkT : ∀ k ∈ Finset.Ico (N + 1) (2 * N + 3), ContDiffOn ℝ ∞ (T k) {w : ℝ³ × ℝ | w.2 < 1} ∧
      ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
        ‖iteratedFDeriv ℝ m (T k) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ E := by
    intro k hk
    have hk' := Finset.mem_Ico.mp hk
    have hk1 : 1 ≤ k := by omega
    have hkR : (N : ℝ) + 1 ≤ (k : ℝ) := by exact_mod_cast hk'.1
    have hkh : ((N : ℝ) + 1) * h ≤ (k : ℝ) * h := mul_le_mul_of_nonneg_right hkR hh0.le
    obtain ⟨hR, hTh, hZ, hbd⟩ := hεres N k hk1
    obtain ⟨s1, C1, hC1⟩ := hterm (-(2 + 2 * h) + 2 * (k : ℝ) * h)
      (bgResRad h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k) radVec (Or.inl rfl) hR
      (fun X η hX h1 h2 => (hvan k hk1 X η hX h1 h2).1)
      (fun m' => (hbd Xb m').imp fun C hC X η a1 a2 a3 a4 => (hC X η a1 a2 a3 a4).1) (by linarith)
    obtain ⟨s2, C2, hC2⟩ := hterm (-(2 + h) + 2 * (k : ℝ) * h)
      (bgResTh h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k) azVec (Or.inr (Or.inl rfl)) hTh
      (fun X η hX h1 h2 => (hvan k hk1 X η hX h1 h2).2.1)
      (fun m' => (hbd Xb m').imp fun C hC X η a1 a2 a3 a4 => (hC X η a1 a2 a3 a4).2.1) (by linarith)
    obtain ⟨s3, C3, hC3⟩ := hterm (-(3 / 2 + h) + 2 * (k : ℝ) * h)
      (bgResZ h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k)
      (fun _ => EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) (Or.inr (Or.inr rfl)) hZ
      (fun X η hX h1 h2 => (hvan k hk1 X η hX h1 h2).2.2)
      (fun m' => (hbd Xb m').imp fun C hC X η a1 a2 a3 a4 => (hC X η a1 a2 a3 a4).2.2) (by linarith)
    have hTk : T k = fun z =>
        P (-(2 + 2 * h) + 2 * (k : ℝ) * h) (bgResRad h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k) radVec z +
        P (-(2 + h) + 2 * (k : ℝ) * h) (bgResTh h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k) azVec z +
        P (-(3 / 2 + h) + 2 * (k : ℝ) * h) (bgResZ h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k)
          (fun _ => EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) z := by
      rw [hT]
    rw [hTk]
    refine ⟨(s1.add s2).add s3, C1 + C2 + C3, fun x t hxt => ?_⟩
    have hxt' : t < 1 ∧ simScale h (x 2) (1 - t) < 1 := hxt
    have hmem : (x, t) ∈ {w : ℝ³ × ℝ | w.2 < 1} := hxt'.1
    have hn := hΩo.mem_nhds hmem
    have d1 := hup m (s1.contDiffAt hn)
    have d2 := hup m (s2.contDiffAt hn)
    have d3 := hup m (s3.contDiffAt hn)
    rw [hadd3 _ _ _ _ d1 d2 d3]
    calc _ ≤ ‖iteratedFDeriv ℝ m (P (-(2 + 2 * h) + 2 * (k : ℝ) * h)
              (bgResRad h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k) radVec) (x, t)‖ +
            ‖iteratedFDeriv ℝ m (P (-(2 + h) + 2 * (k : ℝ) * h)
              (bgResTh h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k) azVec) (x, t)‖ +
            ‖iteratedFDeriv ℝ m (P (-(3 / 2 + h) + 2 * (k : ℝ) * h)
              (bgResZ h (bgTrunc N S) (bgTrunc N G) (bgTrunc N W) k)
              (fun _ => EuclideanSpace.single (2 : Fin 3) (1 : ℝ))) (x, t)‖ := norm_add₃_le
      _ ≤ C1 * simScale h (x 2) (1 - t) ^ E + C2 * simScale h (x 2) (1 - t) ^ E +
            C3 * simScale h (x 2) (1 - t) ^ E :=
          add_le_add (add_le_add (hC1 x t hxt) (hC2 x t hxt)) (hC3 x t hxt)
      _ = (C1 + C2 + C3) * simScale h (x 2) (1 - t) ^ E := by ring

  obtain ⟨Γ, hΓ⟩ : ∃ Γ : ℝ³ × ℝ → ℝ³, Γ = fun z => ∑ k ∈ Finset.Ico (N + 1) (2 * N + 3), T k z :=
    ⟨_, rfl⟩
  have hΓsm : ContDiffOn ℝ ∞ Γ {w : ℝ³ × ℝ | w.2 < 1} := by
    rw [hΓ]
    exact ContDiffOn.sum (fun k hk => (hkT k hk).1)

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ³ × ℝ → ℝ³, Φ = ↿(fun (y : ℝ³) (s : ℝ) => nsResidual 1 (fun y' s' => curl3 (fun w => ∑ n ∈ Finset.range (N + 1), bgAn h n (S n) w s') y' + ∑ n ∈ Finset.range (N + 1), bgBn h n (G n) y' s') (fun y' s' => ∑ n ∈ Finset.range (N + 1), bgPn h n (W n) y' s') y s - stressDivField h (bgTsum h (bgTthSeq h T0th S G W) N) (bgTsum h (bgTzSeq h T0z S G W) N) y s) :=
    ⟨_, rfl⟩
  have hoff : ∀ (x : ℝ³) (t : ℝ), t < 1 → 0 < x 0 ^ 2 + x 1 ^ 2 → Φ (x, t) = Γ (x, t) := by
    intro x t ht hr
    have hA := bg_residual_offaxis h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs F U T0th T0z
      S G W hS hL hXam hXms hXsb hB N x t ht hr
    rw [hΦ, hΓ, hT, hP]
    exact hA

  have hΦΓ : ∀ w ∈ {w : ℝ³ × ℝ | w.2 < 1}, Φ w = Γ w := by
    rintro ⟨x, t⟩ ht
    have ht' : t < 1 := ht
    by_cases hr : 0 < x 0 ^ 2 + x 1 ^ 2
    · exact hoff x t ht' hr
    · have hr0 : x 0 ^ 2 + x 1 ^ 2 = 0 := le_antisymm (not_lt.mp hr) (by positivity)
      have hx0 : x 0 = 0 := by nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]
      have hx1 : x 1 = 0 := by nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]
      obtain ⟨γ, hγ⟩ : ∃ γ : ℝ → ℝ³ × ℝ,
          γ = fun σ => (x + σ • EuclideanSpace.single (0 : Fin 3) (1 : ℝ), t) := ⟨_, rfl⟩
      have hγt : Filter.Tendsto γ (nhdsWithin 0 (Ioi 0)) (nhds (x, t)) := by
        have hc : Continuous γ := by rw [hγ]; fun_prop
        have h1 := hc.tendsto 0
        have h0 : γ 0 = (x, t) := by rw [hγ]; simp
        rw [h0] at h1
        exact h1.mono_left nhdsWithin_le_nhds
      have hev : (Γ ∘ γ) =ᶠ[nhdsWithin 0 (Ioi 0)] (Φ ∘ γ) := by
        filter_upwards [self_mem_nhdsWithin] with σ hσ
        have hσ' : (0 : ℝ) < σ := hσ
        have e0 : (x + σ • EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) 0 = σ := by simp [hx0]
        have e1 : (x + σ • EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) 1 = 0 := by simp [hx1]
        simp only [Function.comp_apply, hγ]
        refine (hoff _ t ht' ?_).symm
        rw [e0, e1]
        positivity
      have hΦc : ContinuousAt Φ (x, t) := by
        rw [hΦ]
        exact bg_residual_axis_continuous h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xm Xs F U T0th T0z
          S G W hS hL hXam hB N x t ht' hr0
      have hΓc : ContinuousAt Γ (x, t) := hΓsm.continuousOn.continuousAt (hΩo.mem_nhds ht)
      have l1 : Filter.Tendsto (Φ ∘ γ) (nhdsWithin 0 (Ioi 0)) (nhds (Φ (x, t))) :=
        hΦc.tendsto.comp hγt
      have l2 : Filter.Tendsto (Φ ∘ γ) (nhdsWithin 0 (Ioi 0)) (nhds (Γ (x, t))) :=
        (hΓc.tendsto.comp hγt).congr' hev
      exact tendsto_nhds_unique l1 l2

  have hsumD : ∀ (s : Finset ℕ) (g : ℕ → ℝ³ × ℝ → ℝ³) (z : ℝ³ × ℝ), (∀ k ∈ s, ContDiffAt ℝ m (g k) z) →
      iteratedFDeriv ℝ m (fun w => ∑ k ∈ s, g k w) z = ∑ k ∈ s, iteratedFDeriv ℝ m (g k) z := by
    intro s g z
    induction s using Finset.induction_on with
    | empty => intro _; simp
    | @insert a s ha ih =>
      intro hz
      have hza := hz a (Finset.mem_insert_self a s)
      have hzs : ∀ k ∈ s, ContDiffAt ℝ m (g k) z := fun k hk => hz k (Finset.mem_insert_of_mem hk)
      have hsum : ContDiffAt ℝ m (fun w => ∑ k ∈ s, g k w) z := ContDiffAt.sum (fun k hk => hzs k hk)
      rw [Finset.sum_insert ha, ← ih hzs]
      rw [show (fun w => ∑ k ∈ insert a s, g k w) = g a + fun w => ∑ k ∈ s, g k w from by
        funext w; simp [Finset.sum_insert ha]]
      exact iteratedFDeriv_add_apply hza hsum
  have hfin : ∀ s : Finset ℕ, (∀ k ∈ s, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
      ‖iteratedFDeriv ℝ m (T k) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ E) →
      ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h 1 →
        ‖∑ k ∈ s, iteratedFDeriv ℝ m (T k) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ E := by
    intro s
    induction s using Finset.induction_on with
    | empty => intro _; exact ⟨0, fun x t _ => by simp⟩
    | @insert a s ha ih =>
      intro hs
      obtain ⟨Ca, hCa⟩ := hs a (Finset.mem_insert_self a s)
      obtain ⟨Cs, hCs⟩ := ih (fun k hk => hs k (Finset.mem_insert_of_mem hk))
      refine ⟨Ca + Cs, fun x t hxt => ?_⟩
      rw [Finset.sum_insert ha, add_mul]
      exact (norm_add_le _ _).trans (add_le_add (hCa x t hxt) (hCs x t hxt))
  obtain ⟨C, hC⟩ := hfin (Finset.Ico (N + 1) (2 * N + 3)) (fun k hk => (hkT k hk).2)
  refine ⟨C, fun x t hxt => ?_⟩
  have hxt' : t < 1 ∧ simScale h (x 2) (1 - t) < 1 := hxt
  have hmem : (x, t) ∈ {w : ℝ³ × ℝ | w.2 < 1} := hxt'.1
  have hn := hΩo.mem_nhds hmem
  rw [← hΦ]
  have heq : Φ =ᶠ[nhds (x, t)] Γ := Filter.eventuallyEq_of_mem hn hΦΓ
  rw [(heq.iteratedFDeriv ℝ m).eq_of_nhds, hΓ,
    hsumD (Finset.Ico (N + 1) (2 * N + 3)) T (x, t)
      (fun k hk => hup m ((hkT k hk).1.contDiffAt hn))]
  have := hC x t hxt
  rw [hE] at this
  exact this

