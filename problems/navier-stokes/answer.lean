abbrev axgeGood {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (Ω S : Set (ℝ × ℝ)) (f : ℝ × ℝ → V) : Prop :=
  ContDiffOn ℝ ∞ f Ω ∧ ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k f z‖ ≤ C
def EtaJet (B : ℝ) (r : ℝ → ℝ) : Prop :=
  ContDiffOn ℝ ∞ r (Ioo (-1) 1) ∧
  (∀ m : ℕ, ∃ K : ℝ, ∀ η : ℝ, -1 < η → η < 1 → |iteratedDeriv m r η| ≤ K) ∧
  ∀ η : ℝ, -1 < η → η < 1 → |r η| ≤ B ∧ |deriv r η| ≤ B
def cStrip (ρ : ℝ) : Set ℂ := {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}

def BgAnalytic (Xi : ℝ) (f : ℝ → ℝ → ℝ) : Prop :=
  ∀ k : ℕ, ∃ (ρ C : ℝ) (fc : ℝ → ℂ → ℂ), 0 < ρ ∧
    ContinuousOn (fun p : ℝ × ℂ => fc p.1 p.2) (Ioo 0 Xi ×ˢ cStrip ρ) ∧
    ∀ X : ℝ, 0 < X → X < Xi →
      DifferentiableOn ℂ (fc X) (cStrip ρ) ∧ (∀ w ∈ cStrip ρ, ‖fc X w‖ ≤ C) ∧
      ∀ η : ℝ, -1 < η → η < 1 → fc X (η : ℂ) = ((iteratedDeriv k (fun Y => f Y η) X : ℝ) : ℂ)

def BgOrdPre (h ε Xm Xs Xi m1 m2 : ℝ) (S G W : ℕ → ℝ → ℝ → ℝ) (k : ℕ) : Prop :=
  (ContDiffOn ℝ ∞ (↿(S k)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(G k)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
    ContDiffOn ℝ ∞ (↿(W k)) (Ioi (-ε) ×ˢ Ioo (-1) 1)) ∧
  (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿(S k)) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(G k)) (X, η)‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (↿(W k)) (X, η)‖ ≤ C) ∧
  (∀ X η : ℝ, Xs ≤ X → S k X η = 0 ∧ G k X η = 0 ∧ W k X η = 0) ∧
  (∀ X η : ℝ, m1 ≤ X → X ≤ m2 → G k X η = 0 ∧ bgUz (S k) X η = 0) ∧
  (∀ X η : ℝ, 0 < X → -1 < η → η < 1 → bgResRad h S G W k X η = 0) ∧
  (∀ X η : ℝ, 0 < X → X ≤ Xm → -1 < η → η < 1 →
      bgResTh h S G W k X η = 0 ∧ bgResZ h S G W k X η = 0) ∧
  (∀ η : ℝ, -1 < η → η < 1 → (∫ X in Ioi (0:ℝ), X * G k X η) = 0) ∧
  BgAnalytic Xi (S k) ∧ BgAnalytic Xi (G k)

def BgOrdOK (h ε Xm Xs Xi m1 m2 : ℝ) (S G W : ℕ → ℝ → ℝ → ℝ) (k : ℕ) : Prop :=
  BgOrdPre h ε Xm Xs Xi m1 m2 S G W k ∧
  (∀ η : ℝ, -1 < η → η < 1 →
      (∫ X in Ioi (0:ℝ), X * bgResTh h S G W k X η) = 0 ∧ (∫ X in Ioi (0:ℝ), bgResZ h S G W k X η) = 0)

def BgLower (h ε Xm Xs Xi m1 m2 : ℝ) (F U : ℝ → ℝ → ℝ) (S G W : ℕ → ℝ → ℝ → ℝ) (n : ℕ) : Prop :=
  (S 0 = profRadAvg U ∧ G 0 = F ∧ W 0 = leadPi F) ∧
  ∀ k : ℕ, 1 ≤ k → k < n → BgOrdOK h ε Xm Xs Xi m1 m2 S G W k

def BgMom (S G W : ℕ → ℝ → ℝ → ℝ) (k : ℕ) : Prop :=
  ∀ η : ℝ, -1 < η → η < 1 →
    (∫ X in Ioi (0:ℝ), X * ∑ i ∈ Finset.range (k + 1), bgUz (S i) X η * G (k - i) X η) = 0 ∧
    (∫ X in Ioi (0:ℝ), ((∑ i ∈ Finset.range (k + 1), bgUz (S i) X η * bgUz (S (k - i)) X η) + W k X η)) = 0
noncomputable def bgTrunc (N : ℕ) (T : ℕ → ℝ → ℝ → ℝ) (n : ℕ) : ℝ → ℝ → ℝ :=
  if n ≤ N then T n else fun _ _ => 0

noncomputable def bgResTail (h : ℝ) (S G W : ℕ → ℝ → ℝ → ℝ) (N : ℕ) (x : ℝ³) (t : ℝ) : ℝ³ :=
  ∑ k ∈ Finset.Ico (N + 1) (2 * N + 3),
    ((simScale h (x 2) (1 - t) ^ (-(2 + 2 * h) + 2 * (k : ℝ) * h) *
        bgResRad h S G W k (simX h x t) (simEta h x t)) • radVec x +
     (simScale h (x 2) (1 - t) ^ (-(2 + h) + 2 * (k : ℝ) * h) *
        bgResTh h S G W k (simX h x t) (simEta h x t)) • azVec x +
     (simScale h (x 2) (1 - t) ^ (-(3 / 2 + h) + 2 * (k : ℝ) * h) *
        bgResZ h S G W k (simX h x t) (simEta h x t)) • EuclideanSpace.single (2 : Fin 3) (1 : ℝ))
noncomputable def rcDisc (a b : ℝ) (F U G V : ℝ → ℝ → ℝ) (η : ℝ) : Fin 5 → ℝ :=
  ![-∫ x in a..b, (V x η - U x η), -∫ x in a..b, 2 * x * (G x η - F x η),
    -∫ x in a..b, (V x η * (2 * x * G x η) - U x η * (2 * x * F x η)),
    -∫ x in a..b, ((V x η ^ 2 - x * G x η ^ 2) - (U x η ^ 2 - x * F x η ^ 2)),
    -∫ x in a..b, (G x η ^ 2 - F x η ^ 2)]

noncomputable def rcRF (γ : Fin 3 → ℝ → ℝ) (c : ℝ → Fin 5 → ℝ) (X η : ℝ) : ℝ :=
  c η 2 * γ 0 X + c η 3 * γ 1 X + c η 4 * γ 2 X

noncomputable def rcRU (β : Fin 2 → ℝ → ℝ) (c : ℝ → Fin 5 → ℝ) (X η : ℝ) : ℝ :=
  c η 0 * β 0 X + c η 1 * β 1 X
noncomputable def bgResField (h : ℝ) (S G W : ℕ → ℝ → ℝ → ℝ) (K : ℕ) (x : ℝ³) (t : ℝ) : ℝ³ :=
  ∑ k ∈ Finset.range (K + 1),
    ((simScale h (x 2) (1 - t) ^ (-(2 + 2 * h) + 2 * (k : ℝ) * h) *
        bgResRad h S G W k (simX h x t) (simEta h x t)) • radVec x +
     (simScale h (x 2) (1 - t) ^ (-(2 + h) + 2 * (k : ℝ) * h) *
        bgResTh h S G W k (simX h x t) (simEta h x t)) • azVec x +
     (simScale h (x 2) (1 - t) ^ (-(3 / 2 + h) + 2 * (k : ℝ) * h) *
        bgResZ h S G W k (simX h x t) (simEta h x t)) • EuclideanSpace.single (2 : Fin 3) (1 : ℝ))
def BgHolo (Xi : ℝ) (f : ℝ → ℝ → ℝ) : Prop :=
  ∃ (fc : ℕ → ℝ → ℂ → ℂ) (ρ C : ℕ → ℝ),
    (∀ k, 0 < ρ k ∧ ρ (k + 1) ≤ ρ k) ∧
    (∀ k, ContinuousOn (fun p : ℝ × ℂ => fc k p.1 p.2) (Ioo 0 Xi ×ˢ cStrip (ρ k))) ∧
    (∀ k X, 0 < X → X < Xi → DifferentiableOn ℂ (fc k X) (cStrip (ρ k)) ∧
        ∀ w ∈ cStrip (ρ k), ‖fc k X w‖ ≤ C k) ∧
    (∀ k X (w : ℂ), 0 < X → X < Xi → w ∈ cStrip (ρ (k + 1)) →
        HasDerivAt (fun Y : ℝ => fc k Y w) (fc (k + 1) X w) X) ∧
    (∀ (X η : ℝ), 0 < X → X < Xi → -1 < η → η < 1 → fc 0 X (η : ℂ) = ((f X η : ℝ) : ℂ))


noncomputable def bgKer (k : ℝ → ℝ) (r : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
