theorem simScale_props : ∀ h : ℝ, 0 < h → h < 1 / 2 → SimScaleProps h :=
by

  have simScale_rpow_algebra : ∀ h μ q z x : ℝ, 0 < μ → 0 < q → μ * q - (μ ^ ((1 - 2 * h) / 2) * z) ^ 2 * (μ * q) ^ (2 * h) = μ * (q - z ^ 2 * q ^ (2 * h)) ∧ q - z ^ 2 * q ^ (2 * h) = q ^ (2 * h) * (q ^ (1 - 2 * h) - z ^ 2) ∧ (q - z ^ 2 * q ^ (2 * h)) / q = 1 - (q ^ (-((1 - 2 * h) / 2)) * z) ^ 2 ∧ (q ^ (-((1 - 2 * h) / 2)) * z) ^ 2 = z ^ 2 / q ^ (1 - 2 * h) ∧ q ^ ((1 - 2 * h) / 2) * (q ^ (-((1 - 2 * h) / 2)) * x) = x ∧ ∀ k : ℕ, q * q⁻¹ ^ k = q ^ (1 - (k : ℝ)) := by
    intro h μ q z x hμ hq
    have sq_a : ∀ p : ℝ, 0 < p → (p ^ ((1 - 2 * h) / 2)) ^ 2 = p ^ (1 - 2 * h) := by
      intro p hp
      rw [← Real.rpow_natCast, ← Real.rpow_mul hp.le]
      congr 1
      push_cast
      ring
    have split : ∀ p : ℝ, 0 < p → p ^ (1 - 2 * h) * p ^ (2 * h) = p := by
      intro p hp
      rw [← Real.rpow_add hp]
      have : 1 - 2 * h + 2 * h = 1 := by ring
      rw [this, Real.rpow_one]
    have hq1 := split q hq
    have hqθ : 0 < q ^ (1 - 2 * h) := Real.rpow_pos_of_pos hq _
    have hneg : (q ^ (-((1 - 2 * h) / 2)) * z) ^ 2 = z ^ 2 / q ^ (1 - 2 * h) := by
      rw [mul_pow, Real.rpow_neg hq.le, inv_pow, sq_a q hq]
      field_simp
    refine ⟨?_, ?_, ?_, hneg, ?_, ?_⟩
    · rw [mul_pow, sq_a μ hμ, Real.mul_rpow hμ.le hq.le]
      have := split μ hμ
      linear_combination (-(z ^ 2 * q ^ (2 * h))) * this
    · linear_combination (-1 : ℝ) * hq1
    · rw [hneg, div_eq_iff hq.ne']
      have e : q ^ (2 * h) = q / q ^ (1 - 2 * h) := by
        rw [eq_div_iff hqθ.ne', mul_comm]; exact hq1
      rw [e]
      field_simp
    · rw [← mul_assoc, ← Real.rpow_add hq]
      simp
    · intro k
      rw [Real.rpow_sub hq, Real.rpow_one, Real.rpow_natCast, inv_pow, div_eq_mul_inv]

  have simScale_root_exists : ∀ h : ℝ, 0 < h → h < 1 / 2 → ∀ z τ : ℝ, 0 < τ → ∃ q : ℝ, 0 < q ∧ q ≤ 2 * τ + (2 * z ^ 2) ^ (1 / (1 - 2 * h)) ∧ q - z ^ 2 * q ^ (2 * h) = τ := by
    intro h hh0 hh1 z τ hτ
    have hθ0 : 0 < 1 - 2 * h := by linarith
    obtain ⟨A, hA⟩ : ∃ A, A = (2 * z ^ 2) ^ (1 / (1 - 2 * h)) := ⟨_, rfl⟩
    rw [← hA]
    have hA0 : 0 ≤ A := by rw [hA]; exact Real.rpow_nonneg (by positivity) _
    have hB0 : 0 < 2 * τ + A := by linarith
    have hAθ : A ^ (1 - 2 * h) = 2 * z ^ 2 := by
      rw [hA, ← Real.rpow_mul (by positivity), one_div, inv_mul_cancel₀ hθ0.ne', Real.rpow_one]
    have hle : A ^ (1 - 2 * h) ≤ (2 * τ + A) ^ (1 - 2 * h) :=
      Real.rpow_le_rpow hA0 (by linarith) hθ0.le
    have hsplit : (2 * τ + A) ^ (1 - 2 * h) * (2 * τ + A) ^ (2 * h) = 2 * τ + A := by
      rw [← Real.rpow_add hB0]
      have : 1 - 2 * h + 2 * h = 1 := by ring
      rw [this, Real.rpow_one]
    have hgc : Continuous (fun q : ℝ => q - z ^ 2 * q ^ (2 * h)) :=
      continuous_id.sub (continuous_const.mul (Real.continuous_rpow_const (by linarith)))
    have hg0 : (fun q : ℝ => q - z ^ 2 * q ^ (2 * h)) 0 = 0 := by
      simp [Real.zero_rpow (by linarith : (2 * h) ≠ 0)]
    have hgB : τ ≤ (fun q : ℝ => q - z ^ 2 * q ^ (2 * h)) (2 * τ + A) := by
      have h1 : 0 ≤ (2 * τ + A) ^ (2 * h) := Real.rpow_nonneg hB0.le _
      have h2 : 0 ≤ ((2 * τ + A) ^ (1 - 2 * h) - 2 * z ^ 2) * (2 * τ + A) ^ (2 * h) :=
        mul_nonneg (by linarith) h1
      show τ ≤ (2 * τ + A) - z ^ 2 * (2 * τ + A) ^ (2 * h)
      nlinarith
    obtain ⟨q, ⟨hq0, hqB⟩, hgq⟩ := intermediate_value_Icc hB0.le hgc.continuousOn
      (show τ ∈ Icc ((fun q : ℝ => q - z ^ 2 * q ^ (2 * h)) 0) _ from ⟨by rw [hg0]; exact hτ.le, hgB⟩)
    have hqne : q ≠ 0 := by
      rintro rfl
      rw [hg0] at hgq
      linarith
    exact ⟨q, lt_of_le_of_ne hq0 (Ne.symm hqne), hqB, hgq⟩

  have simScale_eq_of_root : ∀ h z τ q : ℝ, 0 < h → h < 1 / 2 → 0 < τ → 0 < q → q - z ^ 2 * q ^ (2 * h) = τ → simScale h z τ = q := by
    intro h z τ q hh0 hh1 hτ hq0 hq
    have fac : ∀ p : ℝ, 0 < p → p ^ (1 - 2 * h) * p ^ (2 * h) = p := by
      intro p hp
      rw [← Real.rpow_add hp]
      have : 1 - 2 * h + 2 * h = 1 := by ring
      rw [this, Real.rpow_one]
    have mono : ∀ q₁ q₂ : ℝ, 0 < q₁ → q₁ ≤ q₂ → z ^ 2 ≤ q₁ ^ (1 - 2 * h) →
        (1 - 2 * h) * (q₂ - q₁) ≤ (q₂ - z ^ 2 * q₂ ^ (2 * h)) - (q₁ - z ^ 2 * q₁ ^ (2 * h)) := by
      intro q₁ q₂ h1 h12 hz
      have hs : -1 ≤ q₂ / q₁ - 1 := by
        have : 0 ≤ q₂ / q₁ := div_nonneg (by linarith) h1.le
        linarith
      have hb := rpow_one_add_le_one_add_mul_self hs (by linarith : (0 : ℝ) ≤ 2 * h)
        (by linarith : 2 * h ≤ 1)
      rw [add_sub_cancel, Real.div_rpow (by linarith) h1.le] at hb
      have hP1 : 0 < q₁ ^ (2 * h) := Real.rpow_pos_of_pos h1 _
      rw [div_le_iff₀ hP1] at hb
      obtain ⟨D, hD⟩ : ∃ D, D = q₂ / q₁ - 1 := ⟨_, rfl⟩
      rw [← hD] at hb
      have hD0 : 0 ≤ D := by
        rw [hD, sub_nonneg, le_div_iff₀ h1]; linarith
      have hDq : D * q₁ = q₂ - q₁ := by
        rw [hD]; field_simp
      have hzP : z ^ 2 * q₁ ^ (2 * h) ≤ q₁ := by
        have := mul_le_mul_of_nonneg_right hz hP1.le
        linarith [fac q₁ h1]
      have e1 : z ^ 2 * (q₂ ^ (2 * h) - (1 + 2 * h * D) * q₁ ^ (2 * h)) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (sq_nonneg z) (by linarith)
      have e2 : 2 * h * D * (z ^ 2 * q₁ ^ (2 * h) - q₁) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (by positivity) (by linarith)
      nlinarith
    have hS : IsLeast {p : ℝ | 0 < p ∧ τ ≤ p - z ^ 2 * p ^ (2 * h)} q := by
      refine ⟨⟨hq0, hq.ge⟩, ?_⟩
      rintro p ⟨hp0, hp⟩
      by_contra hlt
      push_neg at hlt
      by_cases hz : z ^ 2 ≤ p ^ (1 - 2 * h)
      · have h1 := mono p q hp0 hlt.le hz
        have h2 : 0 < (1 - 2 * h) * (q - p) := mul_pos (by linarith) (by linarith)
        linarith
      · push_neg at hz
        have hf := fac p hp0
        have hp2 : 0 < p ^ (2 * h) := Real.rpow_pos_of_pos hp0 _
        have h3 := mul_pos hp2 (sub_pos.mpr hz)
        nlinarith
    exact hS.csInf_eq

  have simScale_local_inverse : ∀ h : ℝ, 0 < h → h < 1 / 2 → ∀ z₀ q₀ : ℝ, 0 < q₀ → 2 * h * z₀ ^ 2 < q₀ ^ (1 - 2 * h) → ∃ f : ℝ × ℝ → ℝ, ContDiffAt ℝ ∞ f (z₀, q₀ - z₀ ^ 2 * q₀ ^ (2 * h)) ∧ ∀ᶠ w in nhds (z₀, q₀ - z₀ ^ 2 * q₀ ^ (2 * h)), 0 < f w ∧ f w - w.1 ^ 2 * f w ^ (2 * h) = w.2 := by
    intro h hh0 hh1 z₀ q₀ hq0 hlt
    set Φ : ℝ × ℝ → ℝ × ℝ := fun p => (p.1, p.2 - p.1 ^ 2 * p.2 ^ (2 * h)) with hΦdef
    set a₀ : ℝ × ℝ := (z₀, q₀) with ha₀
    set c : ℝ := 2 * z₀ * q₀ ^ (2 * h) with hc
    set β : ℝ := 1 - 2 * h * z₀ ^ 2 * q₀ ^ (2 * h - 1) with hβ
    have hβpos : 0 < β := by
      have e : q₀ ^ (2 * h - 1) * q₀ ^ (1 - 2 * h) = 1 := by
        rw [← Real.rpow_add hq0]; simp
      have e2 : 2 * h * z₀ ^ 2 * q₀ ^ (2 * h - 1) < 1 := by
        have hpos : 0 < q₀ ^ (2 * h - 1) := Real.rpow_pos_of_pos hq0 _
        calc 2 * h * z₀ ^ 2 * q₀ ^ (2 * h - 1) < q₀ ^ (1 - 2 * h) * q₀ ^ (2 * h - 1) :=
              mul_lt_mul_of_pos_right hlt hpos
          _ = 1 := by rw [mul_comm]; exact e
      rw [hβ]; linarith
    have hβne : β ≠ 0 := hβpos.ne'
    set Φ' : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ) := (ContinuousLinearMap.fst ℝ ℝ ℝ).prod
        ((-c) • ContinuousLinearMap.fst ℝ ℝ ℝ + β • ContinuousLinearMap.snd ℝ ℝ ℝ) with hΦ'
    set Ψ' : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ) := (ContinuousLinearMap.fst ℝ ℝ ℝ).prod
        (β⁻¹ • (ContinuousLinearMap.snd ℝ ℝ ℝ + c • ContinuousLinearMap.fst ℝ ℝ ℝ)) with hΨ'
    have hl : Function.LeftInverse Ψ' Φ' := by
      intro v
      apply Prod.ext
      · simp [hΦ', hΨ']
      · simp [hΦ', hΨ']
        field_simp
        ring
    have hr : Function.RightInverse Ψ' Φ' := by
      intro v
      apply Prod.ext
      · simp [hΦ', hΨ']
      · simp [hΦ', hΨ']
        field_simp
        ring
    set E : (ℝ × ℝ) ≃L[ℝ] (ℝ × ℝ) := ContinuousLinearEquiv.equivOfInverse Φ' Ψ' hl hr with hE
    have hderiv : HasFDerivAt Φ Φ' a₀ := by
      have hA := (hasFDerivAt_fst (𝕜 := ℝ) (p := a₀)).pow 2
      have hB := (hasFDerivAt_snd (𝕜 := ℝ) (p := a₀)).rpow_const (p := 2 * h) (Or.inl hq0.ne')
      have hC := (hasFDerivAt_snd (𝕜 := ℝ) (p := a₀)).sub (hA.mul hB)
      have hD := (hasFDerivAt_fst (𝕜 := ℝ) (p := a₀)).prodMk hC
      refine hD.congr_fderiv ?_
      apply ContinuousLinearMap.ext
      intro v
      apply Prod.ext
      · simp [hΦ']
      · simp [hΦ', ha₀, hc, hβ]
        ring
    have hEd : HasFDerivAt Φ (E : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)) a₀ := hderiv
    have hsm : ContDiffAt ℝ ∞ Φ a₀ := by
      refine contDiffAt_fst.prodMk (contDiffAt_snd.sub ((contDiffAt_fst.pow 2).mul ?_))
      exact contDiffAt_snd.rpow_const_of_ne hq0.ne'
    have hn : (∞ : ℕ∞ω) ≠ 0 := by simp
    have hs := hsm.hasStrictFDerivAt' hEd hn
    have hinv := hsm.to_localInverse hEd hn
    have hpt : Φ a₀ = (z₀, q₀ - z₀ ^ 2 * q₀ ^ (2 * h)) := rfl
    refine ⟨fun w => (hsm.localInverse hEd hn w).2, ?_, ?_⟩
    · rw [← hpt]; exact hinv.snd
    · rw [← hpt]
      have happ : hsm.localInverse hEd hn (Φ a₀) = a₀ := hs.localInverse_apply_image
      have hcont : ContinuousAt (fun w => (hsm.localInverse hEd hn w).2) (Φ a₀) :=
        hinv.continuousAt.snd
      have hpos : ∀ᶠ w in nhds (Φ a₀), 0 < (hsm.localInverse hEd hn w).2 :=
        hcont.eventually (Ioi_mem_nhds (by
          show 0 < (hsm.localInverse hEd hn (Φ a₀)).2
          rw [happ]; exact hq0))
      filter_upwards [hpos, hs.eventually_right_inverse] with w hw1 hw2
      refine ⟨hw1, ?_⟩
      change Φ (hsm.localInverse hEd hn w) = w at hw2
      have e1 := congrArg Prod.fst hw2
      have e2 := congrArg Prod.snd hw2
      change (hsm.localInverse hEd hn w).1 = w.1 at e1
      change (hsm.localInverse hEd hn w).2 - (hsm.localInverse hEd hn w).1 ^ 2 *
          (hsm.localInverse hEd hn w).2 ^ (2 * h) = w.2 at e2
      rw [e1] at e2
      exact e2

  have compact_iteratedFDeriv_bound : ∀ (F : ℝ × ℝ → ℝ) (K O : Set (ℝ × ℝ)), IsCompact K → IsOpen O → (∀ p ∈ K, ∃ f : ℝ × ℝ → ℝ, ContDiffAt ℝ ∞ f p ∧ ∀ᶠ w in nhds p, w ∈ O → F w = f w) → ∀ k : ℕ, ∃ M : ℝ, ∀ w ∈ K ∩ O, ‖iteratedFDeriv ℝ k F w‖ ≤ M := by
    intro F K O hK hO hyp k
    have key : ∀ p ∈ K, ∃ U ∈ nhds p, ∃ B : ℝ, ∀ w ∈ U ∩ O, ‖iteratedFDeriv ℝ k F w‖ ≤ B := by
      intro p hp
      obtain ⟨f, hf, hev⟩ := hyp p hp
      have hc : ContinuousAt (iteratedFDeriv ℝ k f) p :=
        hf.continuousAt_iteratedFDeriv (by exact_mod_cast le_top)
      have h1 : ∀ᶠ w in nhds p, ‖iteratedFDeriv ℝ k f w‖ < ‖iteratedFDeriv ℝ k f p‖ + 1 :=
        hc.norm.eventually (gt_mem_nhds (lt_add_one _))
      obtain ⟨V, hVsub, hVo, hpV⟩ := eventually_nhds_iff.mp (hev.and h1)
      refine ⟨V, hVo.mem_nhds hpV, ‖iteratedFDeriv ℝ k f p‖ + 1, ?_⟩
      rintro w ⟨hwV, hwO⟩
      have heq : F =ᶠ[nhds w] f := by
        filter_upwards [(hVo.inter hO).mem_nhds ⟨hwV, hwO⟩] with y hy
        exact (hVsub y hy.1).1 hy.2
      rw [(heq.iteratedFDeriv ℝ k).eq_of_nhds]
      exact (hVsub w hwV).2.le
    choose! U hU B hB using key
    obtain ⟨t, htK, hcover⟩ := hK.elim_nhds_subcover U hU
    refine ⟨∑ p ∈ t, |B p|, fun w hw => ?_⟩
    obtain ⟨p, hpt, hwp⟩ := Set.mem_iUnion₂.mp (hcover hw.1)
    calc _ ≤ B p := hB p (htK p hpt) w ⟨hwp, hw.2⟩
      _ ≤ |B p| := le_abs_self _
      _ ≤ ∑ p ∈ t, |B p| := Finset.single_le_sum (fun i _ => abs_nonneg (B i)) hpt

  have iteratedFDeriv_diag_rescale : ∀ (F : ℝ × ℝ → ℝ) (q c₁ c₂ : ℝ) (w : ℝ × ℝ) (k : ℕ), 0 < q → 0 < c₁ → c₁ ≤ c₂ → (F =ᶠ[nhds w] fun w' => q * F (c₁ * w'.1, c₂ * w'.2)) → ‖iteratedFDeriv ℝ k F w‖ ≤ q * c₂ ^ k * ‖iteratedFDeriv ℝ k F (c₁ * w.1, c₂ * w.2)‖ := by
    intro F q c₁ c₂ w k hq hc1 hc12 hev
    have hc2 : 0 < c₂ := hc1.trans_le hc12
    let e₁ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 c₁ hc1.ne')
    let e₂ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 c₂ hc2.ne')
    let L : (ℝ × ℝ) ≃L[ℝ] (ℝ × ℝ) := e₁.prodCongr e₂
    let S : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 q hq.ne')
    have hL : ∀ x : ℝ × ℝ, L x = (c₁ * x.1, c₂ * x.2) := by
      intro x
      simp [L, e₁, e₂, mul_comm]
    have hS : ∀ y : ℝ, S y = q * y := by
      intro y
      simp [S, mul_comm]
    have hfun : (fun w' : ℝ × ℝ => q * F (c₁ * w'.1, c₂ * w'.2)) = S ∘ (F ∘ L) := by
      funext w'
      simp only [Function.comp, hS, hL]
    rw [hfun] at hev
    have hLn : ‖(L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))‖ ≤ c₂ := by
      refine ContinuousLinearMap.opNorm_le_bound _ hc2.le fun x => ?_
      show ‖L x‖ ≤ c₂ * ‖x‖
      rw [hL, Prod.norm_def, Prod.norm_def, Real.norm_eq_abs, Real.norm_eq_abs, Real.norm_eq_abs,
        Real.norm_eq_abs, abs_mul, abs_mul, abs_of_pos hc1, abs_of_pos hc2]
      refine max_le ?_ ?_
      · calc c₁ * |x.1| ≤ c₂ * |x.1| := mul_le_mul_of_nonneg_right hc12 (abs_nonneg _)
          _ ≤ c₂ * max |x.1| |x.2| := mul_le_mul_of_nonneg_left (le_max_left _ _) hc2.le
      · exact mul_le_mul_of_nonneg_left (le_max_right _ _) hc2.le
    have hSn : ‖(S : ℝ →L[ℝ] ℝ)‖ ≤ q := by
      refine ContinuousLinearMap.opNorm_le_bound _ hq.le fun y => ?_
      show ‖S y‖ ≤ q * ‖y‖
      rw [hS, norm_mul, Real.norm_eq_abs q, abs_of_pos hq]
    have hcomp : iteratedFDeriv ℝ k (F ∘ L) w =
        (iteratedFDeriv ℝ k F (L w)).compContinuousLinearMap
          (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) := by
      have := L.iteratedFDerivWithin_comp_right F uniqueDiffOn_univ (mem_univ (L w)) k
      rwa [preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at this
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, S.iteratedFDeriv_comp_left, hcomp, ← hL w]
    calc _ ≤ ‖(S : ℝ →L[ℝ] ℝ)‖ * ‖(iteratedFDeriv ℝ k F (L w)).compContinuousLinearMap
            (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)))‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ q * (‖iteratedFDeriv ℝ k F (L w)‖ * ∏ _i : Fin k, ‖(L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))‖) :=
          mul_le_mul hSn (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _)
            (norm_nonneg _) hq.le
      _ ≤ q * (‖iteratedFDeriv ℝ k F (L w)‖ * c₂ ^ k) := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
          gcongr
      _ = q * c₂ ^ k * ‖iteratedFDeriv ℝ k F (L w)‖ := by ring
  intro h hh0 hh1
  have hP1 : ∀ z τ : ℝ, 0 < τ → 0 < simScale h z τ ∧
      simScale h z τ - z ^ 2 * simScale h z τ ^ (2 * h) = τ := by
    intro z τ hτ
    obtain ⟨q, hq0, -, hq⟩ := simScale_root_exists h hh0 hh1 z τ hτ
    rw [simScale_eq_of_root h z τ q hh0 hh1 hτ hq0 hq]
    exact ⟨hq0, hq⟩
  have hP2 : ∀ z τ : ℝ, 0 < τ → τ ≤ simScale h z τ ∧ z ^ 2 < simScale h z τ ^ (1 - 2 * h) := by
    intro z τ hτ
    obtain ⟨hq0, hq⟩ := hP1 z τ hτ
    obtain ⟨q, hqd⟩ : ∃ q, q = simScale h z τ := ⟨_, rfl⟩
    rw [← hqd] at hq0 hq ⊢
    have hfac := (simScale_rpow_algebra h 1 q z 0 one_pos hq0).2.1
    have hpow : 0 < q ^ (2 * h) := Real.rpow_pos_of_pos hq0 _
    constructor
    · have : 0 ≤ z ^ 2 * q ^ (2 * h) := mul_nonneg (sq_nonneg z) hpow.le
      linarith
    · by_contra hcon
      push_neg at hcon
      have : q ^ (2 * h) * (q ^ (1 - 2 * h) - z ^ 2) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos hpow.le (by linarith)
      linarith
  have hP3 : ∀ z τ : ℝ, 0 < τ → simScale h z τ ≤ 2 * τ + (2 * z ^ 2) ^ (1 / (1 - 2 * h)) := by
    intro z τ hτ
    obtain ⟨q, hq0, hqB, hq⟩ := simScale_root_exists h hh0 hh1 z τ hτ
    rw [simScale_eq_of_root h z τ q hh0 hh1 hτ hq0 hq]
    exact hqB
  have hscale : ∀ μ z τ : ℝ, 0 < μ → 0 < τ →
      simScale h (μ ^ ((1 - 2 * h) / 2) * z) (μ * τ) = μ * simScale h z τ := by
    intro μ z τ hμ hτ
    obtain ⟨hq0, hq⟩ := hP1 z τ hτ
    apply simScale_eq_of_root h _ _ _ hh0 hh1 (mul_pos hμ hτ) (mul_pos hμ hq0)
    rw [(simScale_rpow_algebra h μ (simScale h z τ) z 0 hμ hq0).1, hq]
  have hO : IsOpen {w : ℝ × ℝ | 0 < w.2} := isOpen_lt continuous_const continuous_snd
  have hloc : ∀ z₀ q₀ : ℝ, 0 < q₀ → 2 * h * z₀ ^ 2 < q₀ ^ (1 - 2 * h) →
      ∃ f : ℝ × ℝ → ℝ, ContDiffAt ℝ ∞ f (z₀, q₀ - z₀ ^ 2 * q₀ ^ (2 * h)) ∧
        ∀ᶠ w in nhds (z₀, q₀ - z₀ ^ 2 * q₀ ^ (2 * h)),
          0 < w.2 → simScale h w.1 w.2 = f w := by
    intro z₀ q₀ hq₀ hlt
    obtain ⟨f, hf, hev⟩ := simScale_local_inverse h hh0 hh1 z₀ q₀ hq₀ hlt
    refine ⟨f, hf, hev.mono fun w hw hw2 => ?_⟩
    exact simScale_eq_of_root h w.1 w.2 (f w) hh0 hh1 hw2 hw.1 hw.2
  have hP4 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale h w.1 w.2) (univ ×ˢ Ioi 0) := by
    rintro ⟨z, τ⟩ ⟨-, hτ⟩
    have hτ' : (0 : ℝ) < τ := hτ
    obtain ⟨hq0, hq⟩ := hP1 z τ hτ'
    have h2 := (hP2 z τ hτ').2
    have hlt : 2 * h * z ^ 2 < simScale h z τ ^ (1 - 2 * h) := by
      have : 2 * h * z ^ 2 ≤ z ^ 2 := by nlinarith [sq_nonneg z]
      linarith
    obtain ⟨f, hf, hev⟩ := hloc z (simScale h z τ) hq0 hlt
    rw [hq] at hf hev
    have hev2 : (fun w : ℝ × ℝ => simScale h w.1 w.2) =ᶠ[nhds (z, τ)] f := by
      filter_upwards [hev, hO.mem_nhds (show (0 : ℝ) < (z, τ).2 from hτ')] with w hw hw2
      exact hw hw2
    exact (hf.congr_of_eventuallyEq hev2).contDiffWithinAt
  have hP5 : ∀ k : ℕ, 1 ≤ k → ∃ C : ℝ, ∀ z τ : ℝ, 0 < τ → simScale h z τ ≤ 1 →
      ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, τ)‖ ≤
        C * simScale h z τ ^ (1 - (k : ℝ)) := by
    intro k _
    have hK : IsCompact ((fun η : ℝ => (η, 1 - η ^ 2)) '' Icc (-1) 1) :=
      isCompact_Icc.image (by fun_prop)
    have hhyp : ∀ p ∈ (fun η : ℝ => (η, 1 - η ^ 2)) '' Icc (-1) 1, ∃ f : ℝ × ℝ → ℝ,
        ContDiffAt ℝ ∞ f p ∧ ∀ᶠ w in nhds p, w ∈ {w : ℝ × ℝ | 0 < w.2} →
          (fun w : ℝ × ℝ => simScale h w.1 w.2) w = f w := by
      rintro p ⟨η, ⟨hη1, hη2⟩, rfl⟩
      have hη : η ^ 2 ≤ 1 := by nlinarith
      have hlt : 2 * h * η ^ 2 < (1 : ℝ) ^ (1 - 2 * h) := by
        rw [Real.one_rpow]; nlinarith
      obtain ⟨f, hf, hev⟩ := hloc η 1 one_pos hlt
      simp only [Real.one_rpow, mul_one] at hf hev
      exact ⟨f, hf, hev⟩
    obtain ⟨M, hM⟩ := compact_iteratedFDeriv_bound (fun w : ℝ × ℝ => simScale h w.1 w.2) _
      {w : ℝ × ℝ | 0 < w.2} hK hO hhyp k
    refine ⟨M, fun z τ hτ hq1 => ?_⟩
    obtain ⟨hq0, hq⟩ := hP1 z τ hτ
    have h2 := (hP2 z τ hτ).2
    obtain ⟨q, hqd⟩ : ∃ q, q = simScale h z τ := ⟨_, rfl⟩
    rw [← hqd] at hq0 hq h2 hq1 ⊢
    have alg := simScale_rpow_algebra h q q z z hq0 hq0
    obtain ⟨-, -, hiii, hiv, -, hvi⟩ := alg
    have hc1 : 0 < q ^ (-((1 - 2 * h) / 2)) := Real.rpow_pos_of_pos hq0 _
    have hc12 : q ^ (-((1 - 2 * h) / 2)) ≤ q⁻¹ := by
      rw [← Real.rpow_neg_one]
      exact Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (by linarith)
    have hev : (fun w : ℝ × ℝ => simScale h w.1 w.2) =ᶠ[nhds (z, τ)]
        fun w' => q * (fun w : ℝ × ℝ => simScale h w.1 w.2)
          (q ^ (-((1 - 2 * h) / 2)) * w'.1, q⁻¹ * w'.2) := by
      filter_upwards [hO.mem_nhds (show (0 : ℝ) < (z, τ).2 from hτ)] with w hw
      have hw' : (0 : ℝ) < w.2 := hw
      have hw2 : 0 < q⁻¹ * w.2 := mul_pos (inv_pos.mpr hq0) hw'
      have hs := hscale q (q ^ (-((1 - 2 * h) / 2)) * w.1) (q⁻¹ * w.2) hq0 hw2
      rw [(simScale_rpow_algebra h q q z w.1 hq0 hq0).2.2.2.2.1,
        mul_inv_cancel_left₀ hq0.ne'] at hs
      exact hs
    have hres := iteratedFDeriv_diag_rescale (fun w : ℝ × ℝ => simScale h w.1 w.2) q
      (q ^ (-((1 - 2 * h) / 2))) q⁻¹ (z, τ) k hq0 hc1 hc12 hev
    have hθpos : 0 < q ^ (1 - 2 * h) := Real.rpow_pos_of_pos hq0 _
    have hηsq : (q ^ (-((1 - 2 * h) / 2)) * z) ^ 2 < 1 := by
      rw [hiv, div_lt_one hθpos]; exact h2
    have hηabs : |q ^ (-((1 - 2 * h) / 2)) * z| < 1 := (sq_lt_one_iff_abs_lt_one _).mp hηsq
    have hτeq : q⁻¹ * τ = 1 - (q ^ (-((1 - 2 * h) / 2)) * z) ^ 2 := by
      rw [← hiii, ← hq, inv_mul_eq_div]
    have hmem : (q ^ (-((1 - 2 * h) / 2)) * (z, τ).1, q⁻¹ * (z, τ).2) ∈
        (fun η : ℝ => (η, 1 - η ^ 2)) '' Icc (-1) 1 ∩ {w : ℝ × ℝ | 0 < w.2} := by
      refine ⟨⟨q ^ (-((1 - 2 * h) / 2)) * z, ⟨?_, ?_⟩, ?_⟩, ?_⟩
      · linarith [(abs_lt.mp hηabs).1]
      · linarith [(abs_lt.mp hηabs).2]
      · simp only [hτeq]
      · show 0 < q⁻¹ * τ
        exact mul_pos (inv_pos.mpr hq0) hτ
    have hb := hM _ hmem
    have hnn : 0 ≤ q * q⁻¹ ^ k := mul_nonneg hq0.le (pow_nonneg (inv_nonneg.mpr hq0.le) k)
    calc ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, τ)‖
        ≤ q * q⁻¹ ^ k * M := hres.trans (mul_le_mul_of_nonneg_left hb hnn)
      _ = M * q ^ (1 - (k : ℝ)) := by rw [hvi k, mul_comm]
  unfold SimScaleProps
  exact ⟨hP1, hP2, hP3, hP4, hP5⟩

theorem heatK_deriv_bound : ∀ β Z : ℝ, 0 ≤ β → 0 < Z → HasDerivAt (fun Y => heatK β Y) (-β * heatK (β + 1) Z) Z ∧ |heatK β Z| ≤ Real.Gamma (β + 1) :=
by
  intro β Z hβ hZ
  set μ : Measure ℝ := volume.restrict (Ioi (0:ℝ)) with hμ
  let F : ℝ → ℝ → ℝ := fun Y v => Real.exp (-v) * v ^ β * (1 + Y * v) ^ (-β)
  let F' : ℝ → ℝ → ℝ := fun Y v =>
    -β * (Real.exp (-v) * v ^ (β + 1) * (1 + Y * v) ^ (-(β + 1)))
  have hFm : ∀ Y, Measurable (F Y) := by
    intro Y
    exact ((Real.measurable_exp.comp measurable_neg).mul (measurable_id.pow_const β)).mul
      ((measurable_const.add (measurable_const.mul measurable_id)).pow_const (-β))
  have hF'm : ∀ Y, Measurable (F' Y) := by
    intro Y
    exact measurable_const.mul (((Real.measurable_exp.comp measurable_neg).mul
      (measurable_id.pow_const (β + 1))).mul
      ((measurable_const.add (measurable_const.mul measurable_id)).pow_const (-(β + 1))))
  have hg1 : Integrable (fun v : ℝ => Real.exp (-v) * v ^ ((β + 1) - 1)) μ :=
    Real.GammaIntegral_convergent (by linarith)
  have hg2 : Integrable (fun v : ℝ => β * (Real.exp (-v) * v ^ ((β + 2) - 1))) μ :=
    (Real.GammaIntegral_convergent (by linarith : (0:ℝ) < β + 2)).const_mul β
  have key : ∀ Y v : ℝ, 0 < Y → 0 < v → ∀ γ : ℝ, 0 ≤ γ →
      0 < 1 + Y * v ∧ 0 ≤ (1 + Y * v) ^ (-γ) ∧ (1 + Y * v) ^ (-γ) ≤ 1 := by
    intro Y v hY hv γ hγ
    have h1 : 1 ≤ 1 + Y * v := by nlinarith [mul_pos hY hv]
    exact ⟨by linarith, Real.rpow_nonneg (by linarith) _,
      Real.rpow_le_one_of_one_le_of_nonpos h1 (by linarith)⟩
  have hdomF : ∀ᵐ v ∂μ, ‖F Z v‖ ≤ Real.exp (-v) * v ^ ((β + 1) - 1) := by
    refine (ae_restrict_iff' measurableSet_Ioi).mpr (Filter.Eventually.of_forall fun v hv => ?_)
    have hv' : (0:ℝ) < v := hv
    obtain ⟨_, h2, h3⟩ := key Z v hZ hv' β hβ
    have hA : 0 ≤ Real.exp (-v) * v ^ β :=
      mul_nonneg (Real.exp_pos _).le (Real.rpow_nonneg hv'.le _)
    have he : (β + 1) - 1 = β := by ring
    rw [he, Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hA h2)]
    exact mul_le_of_le_one_right hA h3
  have hFint : Integrable (F Z) μ := hg1.mono' (hFm Z).aestronglyMeasurable hdomF
  have hball : ∀ Y ∈ Metric.ball Z (Z / 2), 0 < Y := by
    intro Y hY
    rw [Metric.mem_ball, Real.dist_eq] at hY
    have := (abs_sub_lt_iff.mp hY).2
    linarith
  have hdomF' : ∀ᵐ v ∂μ, ∀ Y ∈ Metric.ball Z (Z / 2),
      ‖F' Y v‖ ≤ β * (Real.exp (-v) * v ^ ((β + 2) - 1)) := by
    refine (ae_restrict_iff' measurableSet_Ioi).mpr
      (Filter.Eventually.of_forall fun v hv Y hY => ?_)
    have hv' : (0:ℝ) < v := hv
    obtain ⟨_, h2, h3⟩ := key Y v (hball Y hY) hv' (β + 1) (by linarith)
    have hA : 0 ≤ Real.exp (-v) * v ^ (β + 1) :=
      mul_nonneg (Real.exp_pos _).le (Real.rpow_nonneg hv'.le _)
    have he : (β + 2) - 1 = β + 1 := by ring
    rw [he, Real.norm_eq_abs]
    show |-β * (Real.exp (-v) * v ^ (β + 1) * (1 + Y * v) ^ (-(β + 1)))| ≤ _
    rw [abs_mul, abs_neg, abs_of_nonneg hβ, abs_of_nonneg (mul_nonneg hA h2)]
    exact mul_le_mul_of_nonneg_left (mul_le_of_le_one_right hA h3) hβ
  have hderiv : ∀ᵐ v ∂μ, ∀ Y ∈ Metric.ball Z (Z / 2),
      HasDerivAt (fun Y => F Y v) (F' Y v) Y := by
    refine (ae_restrict_iff' measurableSet_Ioi).mpr
      (Filter.Eventually.of_forall fun v hv Y hY => ?_)
    have hv' : (0:ℝ) < v := hv
    obtain ⟨h1, _, _⟩ := key Y v (hball Y hY) hv' β hβ
    have hd : HasDerivAt (fun Y => 1 + Y * v) (1 * v) Y :=
      ((hasDerivAt_id Y).mul_const v).const_add 1
    have hd2 := (hd.rpow_const (p := -β) (Or.inl h1.ne')).const_mul (Real.exp (-v) * v ^ β)
    convert hd2 using 1
    show -β * (Real.exp (-v) * v ^ (β + 1) * (1 + Y * v) ^ (-(β + 1))) =
      Real.exp (-v) * v ^ β * (1 * v * -β * (1 + Y * v) ^ (-β - 1))
    rw [Real.rpow_add_one hv'.ne', show -β - 1 = -(β + 1) by ring]
    ring
  have hL := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := μ) (F := F) (F' := F')
    (x₀ := Z) (Metric.ball_mem_nhds Z (half_pos hZ))
    (Filter.Eventually.of_forall fun Y => (hFm Y).aestronglyMeasurable)
    hFint (hF'm Z).aestronglyMeasurable hdomF' hg2 hderiv
  refine ⟨?_, ?_⟩
  · have hv : ∫ a, F' Z a ∂μ = -β * heatK (β + 1) Z := by
      simp only [F']
      rw [integral_const_mul]
      rfl
    rw [← hv]
    exact hL.2
  · have hb := norm_integral_le_of_norm_le hg1 hdomF
    rw [← Real.Gamma_eq_integral (by linarith : (0:ℝ) < β + 1)] at hb
    rw [← Real.norm_eq_abs]
    exact hb

theorem heatK_ode : ∀ h Z : ℝ, 0 < h → 0 < Z → (h + 1) * Z ^ 2 * heatK (h + 2) Z - (1 + 2 * (1 + h) * Z) * heatK (h + 1) Z + (1 + h) * heatK h Z = 0 :=
by
  intro h Z hh hZ

  have hint : ∀ β : ℝ, 0 ≤ β → Integrable (fun v : ℝ => Real.exp (-v) * v ^ β * (1 + Z * v) ^ (-β))
      (volume.restrict (Ioi 0)) := by
    intro β hβ
    have hG : Integrable (fun v : ℝ => Real.exp (-v) * v ^ β) (volume.restrict (Ioi 0)) := by
      have := Real.GammaIntegral_convergent (s := β + 1) (by linarith)
      have h2 : IntegrableOn (fun x : ℝ => Real.exp (-x) * x ^ β) (Ioi 0) := by simpa using this
      exact h2
    refine hG.mono' ?_ ?_
    · refine ContinuousOn.aestronglyMeasurable ?_ measurableSet_Ioi
      intro v hv
      have hv' : (0:ℝ) < v := hv
      apply ContinuousAt.continuousWithinAt
      have h1 : (0:ℝ) < 1 + Z * v := by positivity
      have hc1 : ContinuousAt (fun v : ℝ => Real.exp (-v)) v := by fun_prop
      have hc2 : ContinuousAt (fun v : ℝ => v ^ β) v :=
        Real.continuousAt_rpow_const v β (Or.inl hv'.ne')
      have hc3 : ContinuousAt (fun v : ℝ => (1 + Z * v) ^ (-β)) v :=
        ContinuousAt.rpow_const (f := fun v : ℝ => 1 + Z * v) (by fun_prop) (Or.inl h1.ne')
      exact (hc1.mul hc2).mul hc3
    · refine ae_restrict_of_forall_mem measurableSet_Ioi ?_
      intro v hv
      have hv' : (0:ℝ) < v := hv
      have h1 : (1:ℝ) ≤ 1 + Z * v := by nlinarith
      have hq0 : 0 ≤ (1 + Z * v) ^ (-β) := Real.rpow_nonneg (by linarith) _
      have hq1 : (1 + Z * v) ^ (-β) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos h1 (by linarith)
      have hp : 0 ≤ Real.exp (-v) * v ^ β :=
        mul_nonneg (Real.exp_pos _).le (Real.rpow_nonneg hv'.le _)
      rw [Real.norm_of_nonneg (mul_nonneg hp hq0)]
      exact mul_le_of_le_one_right hp hq1
  have J2 := hint (h + 2) (by linarith)
  have J1 := hint (h + 1) (by linarith)
  have J0 := hint h hh.le

  have hderiv : ∀ v ∈ Ioi (0:ℝ), HasDerivAt
      (fun w : ℝ => Real.exp (-w) * w ^ (1 + h) * (1 + Z * w) ^ (-(1 + h)))
      ((h + 1) * Z ^ 2 * (Real.exp (-v) * v ^ (h + 2) * (1 + Z * v) ^ (-(h + 2)))
        - (1 + 2 * (1 + h) * Z) * (Real.exp (-v) * v ^ (h + 1) * (1 + Z * v) ^ (-(h + 1)))
        + (1 + h) * (Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h))) v := by
    intro v hv
    have hv' : (0:ℝ) < v := hv
    have hW : (0:ℝ) < 1 + Z * v := by positivity
    have d1 : HasDerivAt (fun w : ℝ => Real.exp (-w)) (Real.exp (-v) * (-1)) v :=
      (hasDerivAt_neg v).exp
    have d2 : HasDerivAt (fun w : ℝ => w ^ (1 + h)) ((1 + h) * v ^ (1 + h - 1)) v :=
      Real.hasDerivAt_rpow_const (Or.inl hv'.ne')
    have d3i : HasDerivAt (fun w : ℝ => 1 + Z * w) Z v := by
      simpa using ((hasDerivAt_id v).const_mul Z).const_add 1
    have d3 : HasDerivAt (fun w : ℝ => (1 + Z * w) ^ (-(1 + h)))
        (Z * (-(1 + h)) * (1 + Z * v) ^ (-(1 + h) - 1)) v :=
      d3i.rpow_const (Or.inl hW.ne')
    have d : HasDerivAt (fun w : ℝ => Real.exp (-w) * w ^ (1 + h) * (1 + Z * w) ^ (-(1 + h)))
        ((Real.exp (-v) * (-1) * v ^ (1 + h) + Real.exp (-v) * ((1 + h) * v ^ (1 + h - 1)))
          * (1 + Z * v) ^ (-(1 + h))
          + Real.exp (-v) * v ^ (1 + h) * (Z * (-(1 + h)) * (1 + Z * v) ^ (-(1 + h) - 1))) v :=
      (d1.mul d2).mul d3
    convert d using 1
    have e1 : v ^ (1 + h) = v ^ h * v := by rw [add_comm, Real.rpow_add_one hv'.ne']
    have e2 : v ^ (1 + h - 1) = v ^ h := by rw [add_sub_cancel_left]
    have e3 : v ^ (h + 2) = v ^ h * v ^ 2 := by rw [Real.rpow_add hv', Real.rpow_two]
    have e4 : v ^ (h + 1) = v ^ h * v := Real.rpow_add_one hv'.ne' h
    have f1 : (1 + Z * v) ^ (-(1 + h)) = (1 + Z * v) ^ (-(h + 2)) * (1 + Z * v) := by
      rw [← Real.rpow_add_one hW.ne']; congr 1; ring
    have f2 : (1 + Z * v) ^ (-(1 + h) - 1) = (1 + Z * v) ^ (-(h + 2)) := by
      congr 1; ring
    have f3 : (1 + Z * v) ^ (-(h + 1)) = (1 + Z * v) ^ (-(h + 2)) * (1 + Z * v) := by
      rw [← Real.rpow_add_one hW.ne']; congr 1; ring
    have f4 : (1 + Z * v) ^ (-h) = (1 + Z * v) ^ (-(h + 2)) * (1 + Z * v) ^ 2 := by
      rw [← Real.rpow_two, ← Real.rpow_add hW]; congr 1; ring
    rw [e1, e2, e3, e4, f1, f2, f3, f4]
    ring

  have hcont : ContinuousWithinAt
      (fun w : ℝ => Real.exp (-w) * w ^ (1 + h) * (1 + Z * w) ^ (-(1 + h))) (Ici 0) 0 := by
    apply ContinuousAt.continuousWithinAt
    have c1 : ContinuousAt (fun w : ℝ => Real.exp (-w)) 0 := by fun_prop
    have c2 : ContinuousAt (fun w : ℝ => w ^ (1 + h)) 0 :=
      Real.continuousAt_rpow_const 0 (1 + h) (Or.inr (by linarith))
    have c3 : ContinuousAt (fun w : ℝ => (1 + Z * w) ^ (-(1 + h))) 0 :=
      ContinuousAt.rpow_const (f := fun w : ℝ => 1 + Z * w) (by fun_prop) (Or.inl (by simp))
    exact (c1.mul c2).mul c3
  have hlim : Filter.Tendsto
      (fun w : ℝ => Real.exp (-w) * w ^ (1 + h) * (1 + Z * w) ^ (-(1 + h))) Filter.atTop (nhds 0) := by
    have hT := tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero (1 + h) 1 one_pos
    refine squeeze_zero' ?_ ?_ hT
    · filter_upwards [Filter.eventually_gt_atTop 0] with w hw
      have h1 : (1:ℝ) ≤ 1 + Z * w := by nlinarith
      exact mul_nonneg (mul_nonneg (Real.exp_pos _).le (Real.rpow_nonneg hw.le _))
        (Real.rpow_nonneg (by linarith) _)
    · filter_upwards [Filter.eventually_gt_atTop 0] with w hw
      have h1 : (1:ℝ) ≤ 1 + Z * w := by nlinarith
      have hq1 : (1 + Z * w) ^ (-(1 + h)) ≤ 1 :=
        Real.rpow_le_one_of_one_le_of_nonpos h1 (by linarith)
      have hp : 0 ≤ Real.exp (-w) * w ^ (1 + h) :=
        mul_nonneg (Real.exp_pos _).le (Real.rpow_nonneg hw.le _)
      calc Real.exp (-w) * w ^ (1 + h) * (1 + Z * w) ^ (-(1 + h))
          ≤ Real.exp (-w) * w ^ (1 + h) * 1 := mul_le_mul_of_nonneg_left hq1 hp
        _ = w ^ (1 + h) * Real.exp (-1 * w) := by rw [neg_one_mul]; ring

  have key := integral_Ioi_of_hasDerivAt_of_tendsto hcont hderiv
    (((J2.const_mul ((h + 1) * Z ^ 2)).sub (J1.const_mul (1 + 2 * (1 + h) * Z))).add
      (J0.const_mul (1 + h))) hlim
  have hsplit : (∫ x in Ioi (0:ℝ),
      ((h + 1) * Z ^ 2 * (Real.exp (-x) * x ^ (h + 2) * (1 + Z * x) ^ (-(h + 2)))
        - (1 + 2 * (1 + h) * Z) * (Real.exp (-x) * x ^ (h + 1) * (1 + Z * x) ^ (-(h + 1)))
        + (1 + h) * (Real.exp (-x) * x ^ h * (1 + Z * x) ^ (-h)))) =
      (h + 1) * Z ^ 2 * heatK (h + 2) Z - (1 + 2 * (1 + h) * Z) * heatK (h + 1) Z
        + (1 + h) * heatK h Z := by
    unfold heatK
    rw [integral_add, integral_sub, integral_const_mul, integral_const_mul, integral_const_mul]
    all_goals first
      | exact J2.const_mul _
      | exact J1.const_mul _
      | exact J0.const_mul _
      | exact (J2.const_mul _).sub (J1.const_mul _)
  rw [← hsplit, key, Real.zero_rpow (by linarith)]
  simp

theorem heatProfile_props : ∀ h : ℝ, 0 < h → (∀ β Z : ℝ, 0 ≤ β → 0 < Z → HasDerivAt (fun Y => heatK β Y) (-β * heatK (β + 1) Z) Z ∧ |heatK β Z| ≤ Real.Gamma (β + 1)) → (∀ Z : ℝ, 0 < Z → (h + 1) * Z ^ 2 * heatK (h + 2) Z - (1 + 2 * (1 + h) * Z) * heatK (h + 1) Z + (1 + h) * heatK h Z = 0) → ContDiffOn ℝ ∞ (heatProfile h) (Ioi 0) ∧ (∀ k : ℕ, ∃ C : ℝ, ∀ Z : ℝ, 0 < Z → |iteratedDeriv k (heatProfile h) Z| ≤ C) ∧ (∀ Z : ℝ, 0 < Z → Z ^ 2 * deriv (deriv (heatProfile h)) Z + (1 + 2 * (1 + h) * Z) * deriv (heatProfile h) Z + h * (1 + h) * heatProfile h Z = 0) :=
by
  intro h hh H1 H2
  have hdef : heatProfile h = fun Y => (Real.Gamma (1 + h))⁻¹ * heatK h Y := rfl
  have hform : ∀ k : ℕ, ∃ a : ℝ, ∀ Z : ℝ, 0 < Z →
      iteratedDeriv k (heatProfile h) Z = a * heatK (h + (k : ℝ)) Z := by
    intro k
    induction k with
    | zero =>
      refine ⟨(Real.Gamma (1 + h))⁻¹, fun Z _ => ?_⟩
      rw [iteratedDeriv_zero, Nat.cast_zero, add_zero, hdef]
    | succ k ih =>
      obtain ⟨a, ha⟩ := ih
      refine ⟨a * (-(h + k)), fun Z hZ => ?_⟩
      rw [iteratedDeriv_succ]
      have hev : iteratedDeriv k (heatProfile h) =ᶠ[nhds Z] fun Y => a * heatK (h + (k:ℝ)) Y :=
        Filter.eventuallyEq_of_mem (Ioi_mem_nhds hZ) (fun Y hY => ha Y hY)
      rw [hev.deriv_eq]
      have hβ : (0:ℝ) ≤ h + k := add_nonneg hh.le (Nat.cast_nonneg k)
      rw [((H1 (h + k) Z hβ hZ).1.const_mul a).deriv]
      have hc : h + ((k + 1 : ℕ) : ℝ) = h + k + 1 := by push_cast; ring
      rw [hc]
      ring
  have hdiffK : ∀ (a β : ℝ), 0 ≤ β → DifferentiableOn ℝ (fun Y => a * heatK β Y) (Ioi 0) :=
    fun a β hβ Y hY => ((H1 β Y hβ hY).1.const_mul a).differentiableAt.differentiableWithinAt
  refine ⟨?_, ?_, ?_⟩
  · apply contDiffOn_of_differentiableOn_deriv
    intro m _
    obtain ⟨a, ha⟩ := hform m
    refine (hdiffK a (h + m) (add_nonneg hh.le (Nat.cast_nonneg m))).congr ?_
    intro Y hY
    rw [iteratedDerivWithin_of_isOpen isOpen_Ioi hY, ha Y hY]
  · intro k
    obtain ⟨a, ha⟩ := hform k
    refine ⟨|a| * Real.Gamma (h + k + 1), fun Z hZ => ?_⟩
    rw [ha Z hZ, abs_mul]
    exact mul_le_mul_of_nonneg_left
      (H1 (h + k) Z (add_nonneg hh.le (Nat.cast_nonneg k)) hZ).2 (abs_nonneg a)
  · intro Z hZ
    have hd1 : ∀ Y : ℝ, 0 < Y → deriv (heatProfile h) Y =
        (Real.Gamma (1 + h))⁻¹ * (-h * heatK (h + 1) Y) := by
      intro Y hY
      rw [hdef]
      exact ((H1 h Y hh.le hY).1.const_mul (Real.Gamma (1 + h))⁻¹).deriv
    have hev : deriv (heatProfile h) =ᶠ[nhds Z]
        fun Y => (Real.Gamma (1 + h))⁻¹ * (-h * heatK (h + 1) Y) :=
      Filter.eventuallyEq_of_mem (Ioi_mem_nhds hZ) hd1
    have hd2 : deriv (deriv (heatProfile h)) Z =
        (Real.Gamma (1 + h))⁻¹ * (-h * (-(h + 1) * heatK (h + 1 + 1) Z)) := by
      rw [hev.deriv_eq]
      exact (((H1 (h + 1) Z (by linarith) hZ).1.const_mul (-h)).const_mul
        (Real.Gamma (1 + h))⁻¹).deriv
    have h2 : h + 1 + 1 = h + 2 := by ring
    rw [h2] at hd2
    have h0 : heatProfile h Z = (Real.Gamma (1 + h))⁻¹ * heatK h Z := rfl
    rw [hd2, hd1 Z hZ, h0]
    linear_combination ((Real.Gamma (1 + h))⁻¹ * h) * H2 Z hZ

theorem heatQ_props : ∀ h : ℝ, 0 < h → ContDiffOn ℝ ∞ (heatProfile h) (Ioi 0) → (∀ k : ℕ, ∃ C : ℝ, ∀ Z : ℝ, 0 < Z → |iteratedDeriv k (heatProfile h) Z| ≤ C) → ContDiffOn ℝ ∞ (heatQ h) (Ioi 0) ∧ (∀ k : ℕ, ∃ C : ℝ, ∀ Y : ℝ, 0 < Y → |iteratedDeriv k (heatQ h) Y| ≤ C) ∧ (∀ Y : ℝ, 0 < Y → (1 + 2 * h) * heatQ h Y + Y * deriv (heatQ h) Y = heatProfile h Y ^ 2) :=
by
  intro h hh hHs hHb

  have hTmeas : ∀ (c : ℝ) (φ : ℝ → ℝ) (y : ℝ), DifferentiableOn ℝ φ (Ioi 0) → 0 < y →
      AEStronglyMeasurable (fun w : ℝ => w ^ (-c) * φ (y / w)) (volume.restrict (Ioi (1:ℝ))) := by
    intro c φ y hd hy
    apply ContinuousOn.aestronglyMeasurable _ measurableSet_Ioi
    apply ContinuousOn.mul
    · exact continuousOn_id.rpow_const (fun w hw => Or.inl (ne_of_gt (lt_trans one_pos hw)))
    · refine hd.continuousOn.comp
        (continuousOn_const.div continuousOn_id (fun w hw => ne_of_gt (lt_trans one_pos hw))) ?_
      intro w hw
      exact div_pos hy (lt_trans one_pos hw)
  have hTmeas' : ∀ (c : ℝ) (φ : ℝ → ℝ) (y : ℝ),
      AEStronglyMeasurable (fun w : ℝ => w ^ (-c) * deriv φ (y / w)) (volume.restrict (Ioi (1:ℝ))) :=
    fun c φ y => ((measurable_id.pow_const _).mul
      ((measurable_deriv φ).comp (measurable_const.div measurable_id))).aestronglyMeasurable

  have hTint : ∀ (c : ℝ) (φ : ℝ → ℝ) (M Y : ℝ), 1 < c →
      AEStronglyMeasurable (fun w : ℝ => w ^ (-c) * φ (Y / w)) (volume.restrict (Ioi (1:ℝ))) →
      (∀ Z : ℝ, 0 < Z → |φ Z| ≤ M) → 0 < Y →
      IntegrableOn (fun w : ℝ => w ^ (-c) * φ (Y / w)) (Ioi 1) := by
    intro c φ M Y hc hmeas hb hY
    have hg : IntegrableOn (fun w : ℝ => M * w ^ (-c)) (Ioi 1) :=
      (integrableOn_Ioi_rpow_of_lt (by linarith) one_pos).const_mul M
    refine Integrable.mono' hg hmeas ?_
    refine ae_restrict_of_forall_mem measurableSet_Ioi (fun w hw => ?_)
    have hw0 : (0:ℝ) < w := lt_trans one_pos hw
    have hp : 0 < w ^ (-c) := Real.rpow_pos_of_pos hw0 _
    show ‖w ^ (-c) * φ (Y / w)‖ ≤ M * w ^ (-c)
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos hp, mul_comm M]
    exact mul_le_mul_of_nonneg_left (hb _ (div_pos hY hw0)) hp.le

  have hT2 : ∀ (c : ℝ) (φ : ℝ → ℝ) (M : ℝ), 1 < c → (∀ Z : ℝ, 0 < Z → |φ Z| ≤ M) →
      ∀ Y : ℝ, 0 < Y → |∫ w in Ioi (1:ℝ), w ^ (-c) * φ (Y / w)| ≤ M / (c - 1) := by
    intro c φ M hc hb Y hY
    have hg : IntegrableOn (fun w : ℝ => M * w ^ (-c)) (Ioi 1) :=
      (integrableOn_Ioi_rpow_of_lt (by linarith) one_pos).const_mul M
    have h1 := norm_integral_le_of_norm_le hg
      (ae_restrict_of_forall_mem measurableSet_Ioi (fun w (hw : w ∈ Ioi (1:ℝ)) => by
        have hw0 : (0:ℝ) < w := lt_trans one_pos hw
        have hp : 0 < w ^ (-c) := Real.rpow_pos_of_pos hw0 _
        show ‖w ^ (-c) * φ (Y / w)‖ ≤ M * w ^ (-c)
        rw [Real.norm_eq_abs, abs_mul, abs_of_pos hp, mul_comm M]
        exact mul_le_mul_of_nonneg_left (hb _ (div_pos hY hw0)) hp.le))
    rw [Real.norm_eq_abs] at h1
    refine h1.trans (le_of_eq ?_)
    rw [integral_const_mul, integral_Ioi_rpow_of_lt (by linarith) one_pos, Real.one_rpow]
    have hc1 : c - 1 ≠ 0 := (by linarith : (0:ℝ) < c - 1).ne'
    have hc2 : -c + 1 ≠ 0 := (by linarith : -c + 1 < 0).ne
    field_simp
    ring

  have hT1 : ∀ (c : ℝ) (φ : ℝ → ℝ) (M : ℝ), 1 < c → DifferentiableOn ℝ φ (Ioi 0) →
      (∀ Z : ℝ, 0 < Z → |φ Z| ≤ M ∧ |deriv φ Z| ≤ M) → ∀ Y : ℝ, 0 < Y →
      HasDerivAt (fun y => ∫ w in Ioi (1:ℝ), w ^ (-c) * φ (y / w))
        (∫ w in Ioi (1:ℝ), w ^ (-(c + 1)) * deriv φ (Y / w)) Y := by
    intro c φ M hc hd hb Y hY
    have hball : Metric.ball Y (Y / 2) ∈ nhds Y := Metric.ball_mem_nhds Y (by linarith)
    have hpos : ∀ y ∈ Metric.ball Y (Y / 2), 0 < y := by
      intro y hy
      rw [Metric.mem_ball, Real.dist_eq] at hy
      have := (abs_lt.mp hy).1
      linarith
    have h := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume.restrict (Ioi (1:ℝ)))
      (F := fun y w => w ^ (-c) * φ (y / w)) (F' := fun y w => w ^ (-(c + 1)) * deriv φ (y / w))
      (bound := fun w => M * w ^ (-(c + 1))) hball
      (by filter_upwards [Ioi_mem_nhds hY] with y hy using hTmeas c φ y hd hy)
      (hTint c φ M Y hc (hTmeas c φ Y hd hY) (fun Z hZ => (hb Z hZ).1) hY)
      (hTmeas' (c + 1) φ Y)
      (ae_restrict_of_forall_mem measurableSet_Ioi (fun w hw y hy => by
        have hw0 : (0:ℝ) < w := lt_trans one_pos hw
        have hyw : 0 < y / w := div_pos (hpos y hy) hw0
        have hp : 0 < w ^ (-(c + 1)) := Real.rpow_pos_of_pos hw0 _
        show ‖w ^ (-(c + 1)) * deriv φ (y / w)‖ ≤ M * w ^ (-(c + 1))
        rw [Real.norm_eq_abs, abs_mul, abs_of_pos hp, mul_comm M]
        exact mul_le_mul_of_nonneg_left (hb _ hyw).2 hp.le))
      ((integrableOn_Ioi_rpow_of_lt (by linarith) one_pos).const_mul M)
      (ae_restrict_of_forall_mem measurableSet_Ioi (fun w hw y hy => by
        have hw0 : (0:ℝ) < w := lt_trans one_pos hw
        have hyw : 0 < y / w := div_pos (hpos y hy) hw0
        have hφ : HasDerivAt φ (deriv φ (y / w)) (y / w) :=
          (hd.differentiableAt (Ioi_mem_nhds hyw)).hasDerivAt
        have h2 : HasDerivAt (fun y => w ^ (-c) * φ (y / w))
            (w ^ (-c) * (deriv φ (y / w) * (1 / w))) y :=
          (hφ.comp y ((hasDerivAt_id' y).div_const w)).const_mul (w ^ (-c))
        refine h2.congr_deriv ?_
        rw [show -(c + 1) = -c + -1 by ring, Real.rpow_add hw0, Real.rpow_neg_one]
        ring))
    exact h.2

  have hT3 : ∀ (c : ℝ) (φ : ℝ → ℝ) (M : ℝ), 1 < c → DifferentiableOn ℝ φ (Ioi 0) →
      (∀ Z : ℝ, 0 < Z → |φ Z| ≤ M ∧ |deriv φ Z| ≤ M) → ∀ Y : ℝ, 0 < Y →
      (c - 1) * (∫ w in Ioi (1:ℝ), w ^ (-c) * φ (Y / w)) +
        Y * (∫ w in Ioi (1:ℝ), w ^ (-(c + 1)) * deriv φ (Y / w)) = φ Y := by
    intro c φ M hc hd hb Y hY
    have hI0 : IntegrableOn (fun w : ℝ => w ^ (-c) * φ (Y / w)) (Ioi 1) :=
      hTint c φ M Y hc (hTmeas c φ Y hd hY) (fun Z hZ => (hb Z hZ).1) hY
    have hI1 : IntegrableOn (fun w : ℝ => w ^ (-(c + 1)) * deriv φ (Y / w)) (Ioi 1) :=
      hTint (c + 1) (deriv φ) M Y (by linarith) (hTmeas' (c + 1) φ Y) (fun Z hZ => (hb Z hZ).2) hY
    have hcont : ContinuousWithinAt (fun w : ℝ => w ^ (1 - c) * φ (Y / w)) (Ici 1) 1 := by
      apply ContinuousAt.continuousWithinAt
      apply ContinuousAt.mul
      · exact Real.continuousAt_rpow_const 1 (1 - c) (Or.inl one_ne_zero)
      · have h1 : ContinuousAt φ (Y / 1) := by
          rw [div_one]; exact (hd.differentiableAt (Ioi_mem_nhds hY)).continuousAt
        exact h1.comp (continuousAt_const.div continuousAt_id one_ne_zero)
    have hderiv : ∀ w ∈ Ioi (1:ℝ), HasDerivAt (fun w : ℝ => w ^ (1 - c) * φ (Y / w))
        (-(c - 1) * (w ^ (-c) * φ (Y / w)) - Y * (w ^ (-(c + 1)) * deriv φ (Y / w))) w := by
      intro w hw
      have hw0 : (0:ℝ) < w := lt_trans one_pos hw
      have hYw : 0 < Y / w := div_pos hY hw0
      have hφ : HasDerivAt φ (deriv φ (Y / w)) (Y / w) :=
        (hd.differentiableAt (Ioi_mem_nhds hYw)).hasDerivAt
      have hq : HasDerivAt (fun x : ℝ => Y / x) (Y * (-(w ^ 2)⁻¹)) w := by
        have e : (fun x : ℝ => Y / x) = fun x => Y * x⁻¹ := by funext x; ring
        rw [e]; exact (hasDerivAt_inv hw0.ne').const_mul Y
      have hr : HasDerivAt (fun x : ℝ => x ^ (1 - c)) ((1 - c) * w ^ (1 - c - 1)) w :=
        Real.hasDerivAt_rpow_const (Or.inl hw0.ne')
      have h2 := hr.mul (hφ.comp w hq)
      refine h2.congr_deriv ?_
      simp only [Function.comp_apply]
      rw [show (1:ℝ) - c - 1 = -c by ring, show (1:ℝ) - c = -c + 1 by ring,
        Real.rpow_add_one hw0.ne', show -(c + 1) = -c + -1 by ring, Real.rpow_add hw0,
        Real.rpow_neg_one]
      field_simp
      ring
    have htend : Filter.Tendsto (fun w : ℝ => w ^ (1 - c) * φ (Y / w)) Filter.atTop (nhds 0) := by
      have hlim : Filter.Tendsto (fun w : ℝ => M * w ^ (-(c - 1))) Filter.atTop (nhds 0) := by
        have := (tendsto_rpow_neg_atTop (by linarith : 0 < c - 1)).const_mul M
        simpa only [mul_zero] using this
      refine squeeze_zero_norm' ?_ hlim
      filter_upwards [Filter.eventually_gt_atTop (0:ℝ)] with w hw0
      have hp : 0 < w ^ (1 - c) := Real.rpow_pos_of_pos hw0 _
      rw [Real.norm_eq_abs, abs_mul, abs_of_pos hp, show -(c - 1) = 1 - c by ring, mul_comm M]
      exact mul_le_mul_of_nonneg_left (hb _ (div_pos hY hw0)).1 hp.le
    have hFTC := integral_Ioi_of_hasDerivAt_of_tendsto hcont hderiv
      ((hI0.const_mul (-(c - 1))).sub (hI1.const_mul Y)) htend
    rw [integral_sub (hI0.const_mul _) (hI1.const_mul _), integral_const_mul,
      integral_const_mul] at hFTC
    simp only [Real.one_rpow, div_one, one_mul, zero_sub] at hFTC
    linear_combination -hFTC

  have key : ∀ (c : ℝ) (φ : ℝ → ℝ), 1 < c → ContDiffOn ℝ ∞ φ (Ioi 0) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ Z : ℝ, 0 < Z → |iteratedDeriv k φ Z| ≤ C) →
      ContDiffOn ℝ ∞ (fun Y => ∫ w in Ioi (1:ℝ), w ^ (-c) * φ (Y / w)) (Ioi 0) ∧
      (∀ k : ℕ, ∃ C : ℝ, ∀ Y : ℝ, 0 < Y →
        |iteratedDeriv k (fun Y => ∫ w in Ioi (1:ℝ), w ^ (-c) * φ (Y / w)) Y| ≤ C) ∧
      (∀ Y : ℝ, 0 < Y → (c - 1) * (∫ w in Ioi (1:ℝ), w ^ (-c) * φ (Y / w)) +
        Y * deriv (fun Y => ∫ w in Ioi (1:ℝ), w ^ (-c) * φ (Y / w)) Y = φ Y) := by
    intro c φ hc hs hb
    choose G hG using hb
    have hF1 : ∀ k : ℕ, DifferentiableOn ℝ (iteratedDeriv k φ) (Ioi 0) := by
      intro k
      have hlt : ((k : WithTop ℕ∞)) < ∞ := by exact_mod_cast ENat.natCast_lt_top k
      exact (hs.differentiableOn_iteratedDerivWithin hlt (uniqueDiffOn_Ioi 0)).congr
        (fun Y hY => (iteratedDerivWithin_of_isOpen isOpen_Ioi hY).symm)
    have hF3 : ∀ k : ℕ, ∀ Z : ℝ, 0 < Z → |iteratedDeriv k φ Z| ≤ max (G k) (G (k + 1)) ∧
        |deriv (iteratedDeriv k φ) Z| ≤ max (G k) (G (k + 1)) := by
      intro k Z hZ
      refine ⟨(hG k Z hZ).trans (le_max_left _ _), ?_⟩
      rw [← iteratedDeriv_succ]
      exact (hG (k + 1) Z hZ).trans (le_max_right _ _)
    have hcm : ∀ k : ℕ, 1 < c + (k : ℝ) := fun k => by
      have := Nat.cast_nonneg (α := ℝ) k; linarith
    have hR : ∀ k : ℕ, ∀ Y : ℝ, 0 < Y →
        iteratedDeriv k (fun Y => ∫ w in Ioi (1:ℝ), w ^ (-c) * φ (Y / w)) Y =
          ∫ w in Ioi (1:ℝ), w ^ (-(c + (k : ℝ))) * iteratedDeriv k φ (Y / w) := by
      intro k
      induction k with
      | zero =>
        intro Y hY
        simp only [iteratedDeriv_zero, Nat.cast_zero, add_zero]
      | succ k ih =>
        intro Y hY
        rw [iteratedDeriv_succ]
        have hev : iteratedDeriv k (fun Y => ∫ w in Ioi (1:ℝ), w ^ (-c) * φ (Y / w)) =ᶠ[nhds Y]
            fun y => ∫ w in Ioi (1:ℝ), w ^ (-(c + (k : ℝ))) * iteratedDeriv k φ (y / w) :=
          Filter.eventuallyEq_of_mem (Ioi_mem_nhds hY) (fun y hy => ih y hy)
        rw [hev.deriv_eq, (hT1 (c + k) (iteratedDeriv k φ) _ (hcm k) (hF1 k) (hF3 k) Y hY).deriv,
          ← iteratedDeriv_succ]
        rw [show (c + ((k + 1 : ℕ) : ℝ)) = c + k + 1 by push_cast; ring]
    refine ⟨?_, ?_, ?_⟩
    · apply contDiffOn_of_differentiableOn_deriv
      intro m _
      have hdm : DifferentiableOn ℝ
          (fun y => ∫ w in Ioi (1:ℝ), w ^ (-(c + (m : ℝ))) * iteratedDeriv m φ (y / w)) (Ioi 0) :=
        fun Y hY => (hT1 (c + m) (iteratedDeriv m φ) _ (hcm m) (hF1 m) (hF3 m) Y
          hY).differentiableAt.differentiableWithinAt
      refine hdm.congr ?_
      intro Y hY
      rw [iteratedDerivWithin_of_isOpen isOpen_Ioi hY, hR m Y hY]
    · intro k
      refine ⟨G k / (c + k - 1), fun Y hY => ?_⟩
      rw [hR k Y hY]
      exact hT2 (c + k) (iteratedDeriv k φ) (G k) (hcm k) (hG k) Y hY
    · intro Y hY
      have hd0 : DifferentiableOn ℝ φ (Ioi 0) := by simpa only [iteratedDeriv_zero] using hF1 0
      have hb0 : ∀ Z : ℝ, 0 < Z → |φ Z| ≤ max (G 0) (G (0 + 1)) ∧
          |deriv φ Z| ≤ max (G 0) (G (0 + 1)) := by
        simpa only [iteratedDeriv_zero] using hF3 0
      rw [(hT1 c φ _ hc hd0 hb0 Y hY).deriv]
      exact hT3 c φ _ hc hd0 hb0 Y hY

  have hgs : ContDiffOn ℝ ∞ (fun Z => heatProfile h Z ^ 2) (Ioi 0) := hHs.pow 2
  have hgb : ∀ k : ℕ, ∃ C : ℝ, ∀ Z : ℝ, 0 < Z →
      |iteratedDeriv k (fun Z => heatProfile h Z ^ 2) Z| ≤ C := by
    choose C hC using hHb
    intro k
    refine ⟨∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |C i| * |C (k - i)|, fun Z hZ => ?_⟩
    have hca : ContDiffAt ℝ k (heatProfile h) Z :=
      (contDiffAt_infty.mp (hHs.contDiffAt (Ioi_mem_nhds hZ))) k
    have e : (fun Z => heatProfile h Z ^ 2) = heatProfile h * heatProfile h := by
      funext Z; simp [sq]
    rw [e, iteratedDeriv_mul hca hca]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    rw [abs_mul, abs_mul, Nat.abs_cast]
    have h1 := (hC i Z hZ).trans (le_abs_self _)
    have h2 := (hC (k - i) Z hZ).trans (le_abs_self _)
    exact mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) h2 (abs_nonneg _)
      (mul_nonneg (Nat.cast_nonneg _) (abs_nonneg _))
  have hc : (1:ℝ) < 2 + 2 * h := by linarith
  obtain ⟨A1, A2, A3⟩ := key (2 + 2 * h) (fun Z => heatProfile h Z ^ 2) hc hgs hgb
  refine ⟨A1, A2, fun Y hY => ?_⟩
  have := A3 Y hY
  rw [show (2 + 2 * h - 1) = 1 + 2 * h by ring] at this
  exact this

theorem heatPressure_integral_eq : ∀ h A S : ℝ, 0 < S → ∫ s in Ioi S, s ^ (-(2 + 2 * h)) * heatProfile h (A / s) ^ 2 = S ^ (-(1 + 2 * h)) * heatQ h (A / S) :=
by
  intro h A S hS
  have h1 := MeasureTheory.integral_comp_mul_left_Ioi
    (fun s : ℝ => s ^ (-(2 + 2 * h)) * heatProfile h (A / s) ^ 2) 1 hS
  rw [mul_one, smul_eq_mul] at h1
  beta_reduce at h1
  have h2 : ∫ w in Ioi (1:ℝ), (S * w) ^ (-(2 + 2 * h)) * heatProfile h (A / (S * w)) ^ 2
      = ∫ w in Ioi (1:ℝ), S ^ (-(2 + 2 * h)) * (w ^ (-(2 + 2 * h)) * heatProfile h (A / S / w) ^ 2) := by
    apply MeasureTheory.setIntegral_congr_fun measurableSet_Ioi
    intro w hw
    have hw0 : (0:ℝ) < w := lt_trans one_pos hw
    beta_reduce
    rw [Real.mul_rpow hS.le hw0.le, div_div]
    ring
  rw [h2, MeasureTheory.integral_const_mul] at h1
  have h3 : S * S ^ (-(2 + 2 * h)) = S ^ (-(1 + 2 * h)) := by
    rw [show (-(1 + 2 * h) : ℝ) = 1 + -(2 + 2 * h) by ring, Real.rpow_add hS, Real.rpow_one]
  have hS0 : S ≠ 0 := hS.ne'
  unfold heatQ
  rw [← h3, mul_assoc, h1, ← mul_assoc, mul_inv_cancel₀ hS0, one_mul]

theorem swirl_profile_heat_eq : ∀ (h c t S : ℝ) (φ : ℝ → ℝ), 0 < S → t < 1 → ContDiffOn ℝ ∞ φ (Ioi 0) → (∀ Z : ℝ, 0 < Z → Z ^ 2 * deriv (deriv φ) Z + (1 + 2 * (1 + h) * Z) * deriv φ Z + h * (1 + h) * φ Z = 0) → deriv (fun s => c * S ^ (-(1 + h)) * φ (4 * (1 - s) / S)) t - 4 * S * deriv (fun σ => deriv (fun ρ => c * ρ ^ (-(1 + h)) * φ (4 * (1 - t) / ρ)) σ) S - 8 * deriv (fun ρ => c * ρ ^ (-(1 + h)) * φ (4 * (1 - t) / ρ)) S = 0 :=
by
  intro h c t S φ hS ht hφ hode
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = -(1 + h) := ⟨_, rfl⟩
  obtain ⟨A, hAd⟩ : ∃ A : ℝ, A = 4 * (1 - t) := ⟨_, rfl⟩
  have hA : 0 < A := by rw [hAd]; linarith
  rw [← ha, ← hAd]
  have hφd : ∀ Z : ℝ, 0 < Z → HasDerivAt φ (deriv φ Z) Z := fun Z hZ =>
    ((hφ.differentiableOn (by simp)).differentiableAt (Ioi_mem_nhds hZ)).hasDerivAt
  have hφ' : ContDiffOn ℝ ∞ (deriv φ) (Ioi 0) := hφ.deriv_of_isOpen isOpen_Ioi (by simp)
  have hφdd : ∀ Z : ℝ, 0 < Z → HasDerivAt (deriv φ) (deriv (deriv φ) Z) Z := fun Z hZ =>
    ((hφ'.differentiableOn (by simp)).differentiableAt (Ioi_mem_nhds hZ)).hasDerivAt
  have hin : ∀ σ : ℝ, 0 < σ → HasDerivAt (fun ρ => A / ρ) (-A / σ ^ 2) σ := by
    intro σ hσ
    have := (hasDerivAt_const σ A).div (hasDerivAt_id' σ) hσ.ne'
    convert this using 1
    ring
  have hrp : ∀ σ : ℝ, 0 < σ → ∀ b : ℝ, HasDerivAt (fun x : ℝ => x ^ b) (b * σ ^ (b - 1)) σ :=
    fun σ hσ b => Real.hasDerivAt_rpow_const (Or.inl hσ.ne')

  have hG1 : ∀ σ : ℝ, 0 < σ → HasDerivAt (fun ρ => c * ρ ^ a * φ (A / ρ))
      (c * a * σ ^ (a - 1) * φ (A / σ) - c * A * σ ^ (a - 1 - 1) * deriv φ (A / σ)) σ := by
    intro σ hσ
    have h2 := (hφd (A / σ) (div_pos hA hσ)).comp σ (hin σ hσ)
    have h3 := ((hrp σ hσ a).const_mul c).mul h2
    refine h3.congr_deriv ?_
    simp only [Real.rpow_sub_one hσ.ne', Function.comp]
    field_simp
    ring

  have hY' : 0 < A / S := div_pos hA hS
  have hG2 : HasDerivAt
      (fun σ => c * a * σ ^ (a - 1) * φ (A / σ) - c * A * σ ^ (a - 1 - 1) * deriv φ (A / σ))
      (c * a * ((a - 1) * S ^ (a - 1 - 1)) * φ (A / S) +
          c * a * S ^ (a - 1) * (deriv φ (A / S) * (-A / S ^ 2)) -
        (c * A * ((a - 1 - 1) * S ^ (a - 1 - 1 - 1)) * deriv φ (A / S) +
          c * A * S ^ (a - 1 - 1) * (deriv (deriv φ) (A / S) * (-A / S ^ 2)))) S := by
    have e1 := ((hrp S hS (a - 1)).const_mul (c * a)).mul ((hφd (A / S) hY').comp S (hin S hS))
    have e2 := ((hrp S hS (a - 1 - 1)).const_mul (c * A)).mul
      ((hφdd (A / S) hY').comp S (hin S hS))
    exact e1.sub e2

  have hinT : HasDerivAt (fun s => 4 * (1 - s) / S) (4 * (-1) / S) t :=
    (((hasDerivAt_id' t).const_sub 1).const_mul 4).div_const S
  have hY : 0 < 4 * (1 - t) / S := div_pos (by linarith) hS
  have hT : deriv (fun s => c * S ^ a * φ (4 * (1 - s) / S)) t =
      c * S ^ a * (deriv φ (4 * (1 - t) / S) * (4 * (-1) / S)) :=
    (((hφd _ hY).comp t hinT).const_mul (c * S ^ a)).deriv

  have hev : (fun σ => deriv (fun ρ => c * ρ ^ a * φ (A / ρ)) σ) =ᶠ[nhds S]
      (fun σ => c * a * σ ^ (a - 1) * φ (A / σ) - c * A * σ ^ (a - 1 - 1) * deriv φ (A / σ)) :=
    Filter.eventuallyEq_of_mem (Ioi_mem_nhds hS) (fun σ hσ => (hG1 σ hσ).deriv)
  rw [hT, hev.deriv_eq, hG2.deriv, (hG1 S hS).deriv, ← hAd]

  have hodeY := hode (A / S) hY'
  simp only [Real.rpow_sub_one hS.ne']
  generalize S ^ a = X
  generalize deriv (deriv φ) (A / S) = R at hodeY ⊢
  generalize deriv φ (A / S) = Q at hodeY ⊢
  generalize φ (A / S) = P at hodeY ⊢
  subst ha
  have hS0 : S ≠ 0 := hS.ne'
  linear_combination (norm := skip) (-(4 * c * X / S)) * hodeY
  field_simp
  ring

theorem pressure_profile_balance : ∀ (h c A S : ℝ) (φ ψ : ℝ → ℝ), 0 < A → 0 < S → DifferentiableAt ℝ ψ (A / S) → (1 + 2 * h) * ψ (A / S) + A / S * deriv ψ (A / S) = φ (A / S) ^ 2 → 2 * deriv (fun σ => -(c ^ 2 / 2) * σ ^ (-(1 + 2 * h)) * ψ (A / σ)) S = (c * S ^ (-(1 + h)) * φ (A / S)) ^ 2 :=
by
  intro h c A S φ ψ hA hS hψ hH
  have hS0 : S ≠ 0 := hS.ne'
  have h1 : HasDerivAt (fun σ : ℝ => σ ^ (-(1 + 2 * h)))
      (-(1 + 2 * h) * S ^ (-(1 + 2 * h) - 1)) S :=
    Real.hasDerivAt_rpow_const (Or.inl hS0)
  have h2 : HasDerivAt (fun σ : ℝ => A / σ) (-(A / S ^ 2)) S := by
    have := (hasDerivAt_inv hS0).const_mul A
    convert this using 1
    · funext σ; simp [div_eq_mul_inv]
    · ring
  have h3 : HasDerivAt (fun σ : ℝ => ψ (A / σ)) (deriv ψ (A / S) * (-(A / S ^ 2))) S :=
    hψ.hasDerivAt.comp S h2
  have h4 : HasDerivAt (fun σ : ℝ => -(c ^ 2 / 2) * σ ^ (-(1 + 2 * h)) * ψ (A / σ))
      (-(c ^ 2 / 2) * (-(1 + 2 * h) * S ^ (-(1 + 2 * h) - 1)) * ψ (A / S) +
        -(c ^ 2 / 2) * S ^ (-(1 + 2 * h)) * (deriv ψ (A / S) * (-(A / S ^ 2)))) S :=
    (h1.const_mul (-(c ^ 2 / 2))).mul h3
  rw [h4.deriv]
  have r1 : S ^ (-(1 + 2 * h) - 1) = S ^ (-(1 + 2 * h)) / S := Real.rpow_sub_one hS0 _
  have r2 : (S ^ (-(1 + h))) ^ 2 = S ^ (-(1 + 2 * h)) / S := by
    rw [pow_two, ← Real.rpow_add hS, ← r1]
    congr 1
    ring
  rw [r1, mul_pow, mul_pow, r2, ← hH]
  field_simp

theorem profile_field_smooth_bounded : ∀ (φ : ℝ → ℝ) (α : ℝ), ContDiffOn ℝ ∞ φ (Ioi 0) → (∀ k : ℕ, ∃ C : ℝ, ∀ Z : ℝ, 0 < Z → |iteratedDeriv k φ Z| ≤ C) → ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => (z.1 0 ^ 2 + z.1 1 ^ 2) ^ α * φ (4 * (1 - z.2) / (z.1 0 ^ 2 + z.1 1 ^ 2))) {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2 ∧ w.2 < 1} ∧ ∀ r₀ : ℝ, 0 < r₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), r₀ ^ 2 ≤ x 0 ^ 2 + x 1 ^ 2 → x 0 ^ 2 + x 1 ^ 2 ≤ 1 → 0 < t → t < 1 → ‖iteratedFDeriv ℝ m (fun z : ℝ³ × ℝ => (z.1 0 ^ 2 + z.1 1 ^ 2) ^ α * φ (4 * (1 - z.2) / (z.1 0 ^ 2 + z.1 1 ^ 2))) (x, t)‖ ≤ C :=
by
  intro φ α hφ hφb
  obtain ⟨σ, hσdef⟩ : ∃ σ : ℝ³ × ℝ → ℝ, σ = fun z => z.1 0 ^ 2 + z.1 1 ^ 2 := ⟨_, rfl⟩
  obtain ⟨P, hPdef⟩ : ∃ P : ℝ³ × ℝ → ℝ, P = fun z => σ z ^ α := ⟨_, rfl⟩
  obtain ⟨Zf, hZdef⟩ : ∃ Zf : ℝ³ × ℝ → ℝ, Zf = fun z => 4 * (1 - z.2) / σ z := ⟨_, rfl⟩
  obtain ⟨O, hOdef⟩ : ∃ O : Set (ℝ³ × ℝ), O = {z | 0 < σ z} := ⟨_, rfl⟩
  obtain ⟨D, hDdef⟩ : ∃ D : Set (ℝ³ × ℝ), D = {w | 0 < σ w ∧ w.2 < 1} := ⟨_, rfl⟩
  have hgoal : (fun z : ℝ³ × ℝ => (z.1 0 ^ 2 + z.1 1 ^ 2) ^ α *
      φ (4 * (1 - z.2) / (z.1 0 ^ 2 + z.1 1 ^ 2))) = fun z => P z * φ (Zf z) := by
    subst hσdef hPdef hZdef; rfl
  have hDgoal : {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2 ∧ w.2 < 1} = D := by
    subst hσdef hDdef; rfl
  rw [hgoal, hDgoal]

  have hσ : ContDiff ℝ ∞ σ := by rw [hσdef]; fun_prop
  have hσc : Continuous σ := hσ.continuous
  have hOo : IsOpen O := by rw [hOdef]; exact isOpen_lt continuous_const hσc
  have hDo : IsOpen D := by
    rw [hDdef]; exact (isOpen_lt continuous_const hσc).inter (isOpen_lt continuous_snd continuous_const)
  have hDO : D ⊆ O := by rw [hDdef, hOdef]; exact fun w hw => hw.1
  have hP : ContDiffOn ℝ ∞ P O := by
    rw [hPdef, hOdef]; exact hσ.contDiffOn.rpow_const_of_ne (fun z hz => ne_of_gt hz)
  have hZ : ContDiffOn ℝ ∞ Zf O := by
    rw [hZdef, hOdef]
    exact (contDiffOn_const.mul (contDiffOn_const.sub contDiff_snd.contDiffOn)).div hσ.contDiffOn
      (fun z hz => ne_of_gt hz)
  have hmaps : MapsTo Zf D (Ioi 0) := by
    intro w hw
    rw [hDdef] at hw
    rw [hZdef]
    show (0:ℝ) < 4 * (1 - w.2) / σ w
    exact div_pos (by linarith [hw.2]) hw.1
  have hcomp : ContDiffOn ℝ ∞ (fun z => φ (Zf z)) D := hφ.comp (hZ.mono hDO) hmaps
  refine ⟨(hP.mono hDO).mul hcomp, ?_⟩

  have hcrux : ∀ (m : ℕ) (M N : ℝ), ∃ C : ℝ, ∀ z ∈ D,
      (∀ i ≤ m, ‖iteratedFDeriv ℝ i P z‖ ≤ M) → (∀ i ≤ m, ‖iteratedFDeriv ℝ i Zf z‖ ≤ N) →
      ‖iteratedFDeriv ℝ m (fun w => P w * φ (Zf w)) z‖ ≤ C := by
    intro m M N
    choose Cφ hCφ using hφb
    obtain ⟨Kφ, hKφ⟩ : ∃ Kφ : ℝ, Kφ = ∑ k ∈ Finset.range (m + 1), |Cφ k| := ⟨_, rfl⟩
    obtain ⟨Dm, hDm⟩ : ∃ Dm : ℝ, Dm = 1 + |N| := ⟨_, rfl⟩
    have hK0 : 0 ≤ Kφ := by rw [hKφ]; exact Finset.sum_nonneg (fun k _ => abs_nonneg _)
    have hD1 : 1 ≤ Dm := by rw [hDm]; linarith [abs_nonneg N]
    refine ⟨∑ i ∈ Finset.range (m + 1),
      (m.choose i : ℝ) * |M| * ((m - i).factorial * Kφ * Dm ^ (m - i)), ?_⟩
    intro z hz hPb hZb
    have hY : 0 < Zf z := hmaps hz
    have hφbd : ∀ i ≤ m, ‖iteratedFDerivWithin ℝ i φ (Ioi 0) (Zf z)‖ ≤ Kφ := by
      intro i hi
      rw [norm_iteratedFDerivWithin_eq_norm_iteratedDerivWithin,
        iteratedDerivWithin_eq_iteratedDeriv (uniqueDiffOn_Ioi 0)
          (contDiffAt_infty.mp (hφ.contDiffAt (Ioi_mem_nhds hY)) i) hY, Real.norm_eq_abs]
      calc |iteratedDeriv i φ (Zf z)| ≤ Cφ i := hCφ i (Zf z) hY
        _ ≤ |Cφ i| := le_abs_self _
        _ ≤ Kφ := by
          rw [hKφ]
          exact Finset.single_le_sum (f := fun k => |Cφ k|) (fun k _ => abs_nonneg _)
            (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    have hZbd : ∀ i, 1 ≤ i → i ≤ m → ‖iteratedFDerivWithin ℝ i Zf D z‖ ≤ Dm ^ i := by
      intro i h1 hi
      rw [iteratedFDerivWithin_of_isOpen i hDo hz]
      calc ‖iteratedFDeriv ℝ i Zf z‖ ≤ N := hZb i hi
        _ ≤ |N| := le_abs_self _
        _ ≤ Dm := by rw [hDm]; linarith
        _ ≤ Dm ^ i := le_self_pow₀ hD1 (by omega)
    have hFdB : ∀ j ≤ m, ‖iteratedFDerivWithin ℝ j (φ ∘ Zf) D z‖ ≤ j.factorial * Kφ * Dm ^ j := by
      intro j hj
      exact norm_iteratedFDerivWithin_comp_le hφ (hZ.mono hDO) (by exact_mod_cast le_top)
        (uniqueDiffOn_Ioi 0) hDo.uniqueDiffOn hmaps hz (fun i hi => hφbd i (le_trans hi hj))
        (fun i h1 hi => hZbd i h1 (le_trans hi hj))
    have hL := norm_iteratedFDerivWithin_mul_le (hP.mono hDO) (hφ.comp (hZ.mono hDO) hmaps)
      hDo.uniqueDiffOn hz (n := m) (by exact_mod_cast le_top)
    rw [← iteratedFDerivWithin_of_isOpen (f := fun w => P w * φ (Zf w)) m hDo hz]
    refine le_trans hL ?_
    apply Finset.sum_le_sum
    intro i hi
    have hi' : i ≤ m := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    rw [iteratedFDerivWithin_of_isOpen i hDo hz]
    have h1 : ‖iteratedFDeriv ℝ i P z‖ ≤ |M| := (hPb i hi').trans (le_abs_self _)
    have h2 := hFdB (m - i) (Nat.sub_le m i)
    exact mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) h2 (norm_nonneg _)
      (mul_nonneg (Nat.cast_nonneg _) (abs_nonneg _))

  intro r₀ hr₀ m
  have hr2 : 0 < r₀ ^ 2 := pow_pos hr₀ 2
  obtain ⟨K, hKdef⟩ : ∃ K : Set (ℝ³ × ℝ),
      K = {z | z.1 2 = 0 ∧ r₀ ^ 2 ≤ σ z ∧ σ z ≤ 1 ∧ 0 ≤ z.2 ∧ z.2 ≤ 1} := ⟨_, rfl⟩
  have hKc : IsCompact K := by
    have hcl : IsClosed K := by
      rw [hKdef]
      have h2 : Continuous (fun z : ℝ³ × ℝ => z.1 2) := by fun_prop
      exact (isClosed_eq h2 continuous_const).inter ((isClosed_le continuous_const hσc).inter
        ((isClosed_le hσc continuous_const).inter ((isClosed_le continuous_const continuous_snd).inter
          (isClosed_le continuous_snd continuous_const))))
    have hsub : K ⊆ Metric.closedBall (0 : ℝ³) 1 ×ˢ Icc (0:ℝ) 1 := by
      intro z hz
      rw [hKdef] at hz
      obtain ⟨h2, -, h1, h3, h4⟩ := hz
      refine ⟨?_, h3, h4⟩
      rw [mem_closedBall_zero_iff, EuclideanSpace.norm_eq, Real.sqrt_le_one, Fin.sum_univ_three]
      simp only [Real.norm_eq_abs, sq_abs]
      rw [hσdef] at h1
      simp only at h1
      rw [h2]
      linarith
    exact ((isCompact_closedBall 0 1).prod isCompact_Icc).of_isClosed_subset hcl hsub
  have hKO : K ⊆ O := by
    intro z hz
    rw [hKdef] at hz
    rw [hOdef]
    exact lt_of_lt_of_le hr2 hz.2.1
  have hbd : ∀ (f : ℝ³ × ℝ → ℝ), ContDiffOn ℝ ∞ f O → ∀ i : ℕ, ∃ C : ℝ, ∀ z ∈ K,
      ‖iteratedFDeriv ℝ i f z‖ ≤ C := by
    intro f hf i
    have hc : ContinuousOn (iteratedFDeriv ℝ i f) O :=
      (hf.continuousOn_iteratedFDerivWithin (by exact_mod_cast le_top) hOo.uniqueDiffOn).congr
        (fun z hz => (iteratedFDerivWithin_of_isOpen i hOo hz).symm)
    exact hKc.exists_bound_of_continuousOn (hc.mono hKO)
  choose CP hCP using hbd P hP
  choose CZ hCZ using hbd Zf hZ
  have hMb : ∀ z ∈ K, ∀ i ≤ m, ‖iteratedFDeriv ℝ i P z‖ ≤ ∑ k ∈ Finset.range (m + 1), |CP k| :=
    fun z hz i hi => (hCP i z hz).trans ((le_abs_self _).trans
      (Finset.single_le_sum (f := fun k => |CP k|) (fun k _ => abs_nonneg _)
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))))
  have hNb : ∀ z ∈ K, ∀ i ≤ m, ‖iteratedFDeriv ℝ i Zf z‖ ≤ ∑ k ∈ Finset.range (m + 1), |CZ k| :=
    fun z hz i hi => (hCZ i z hz).trans ((le_abs_self _).trans
      (Finset.single_le_sum (f := fun k => |CZ k|) (fun k _ => abs_nonneg _)
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))))
  obtain ⟨C, hC⟩ := hcrux m (∑ k ∈ Finset.range (m + 1), |CP k|) (∑ k ∈ Finset.range (m + 1), |CZ k|)
  refine ⟨C, fun x t h1 h2 h3 h4 => ?_⟩

  obtain ⟨a, ha⟩ : ∃ a : ℝ³ × ℝ, a = (x 2 • EuclideanSpace.single (2 : Fin 3) (1:ℝ), (0:ℝ)) :=
    ⟨_, rfl⟩
  obtain ⟨z₀, hz₀⟩ : ∃ z₀ : ℝ³ × ℝ, z₀ = (x - x 2 • EuclideanSpace.single (2 : Fin 3) (1:ℝ), t) :=
    ⟨_, rfl⟩
  have hz0a : z₀ + a = (x, t) := by
    rw [hz₀, ha, Prod.mk_add_mk, sub_add_cancel, add_zero]
  have hσa : ∀ z, σ (z + a) = σ z := by
    intro z
    rw [hσdef, ha]
    simp [EuclideanSpace.single_apply]
  have hsnd : ∀ z : ℝ³ × ℝ, (z + a).2 = z.2 := by
    intro z
    rw [ha]
    simp
  have hinv' : ∀ z, P (z + a) * φ (Zf (z + a)) = P z * φ (Zf z) := by
    intro z
    rw [hPdef, hZdef]
    simp only [hσa z, hsnd z]
  have hσz0 : σ z₀ = x 0 ^ 2 + x 1 ^ 2 := by
    rw [← hσa z₀, hz0a]
    simp only [hσdef]
  have hz02 : z₀.1 2 = 0 := by
    rw [hz₀]
    simp [EuclideanSpace.single_apply]
  have hz0t : z₀.2 = t := by rw [hz₀]
  have hz0K : z₀ ∈ K := by
    rw [hKdef, Set.mem_setOf_eq, hσz0, hz0t]
    exact ⟨hz02, h1, h2, h3.le, h4.le⟩
  have hz0D : z₀ ∈ D := by
    rw [hDdef, Set.mem_setOf_eq, hσz0, hz0t]
    exact ⟨by linarith, h4⟩
  have key := iteratedFDeriv_comp_add_right (𝕜 := ℝ) (f := fun w => P w * φ (Zf w)) m a z₀
  rw [hz0a] at key
  simp only [hinv'] at key
  rw [← key]
  exact hC z₀ hz0D (hMb z₀ hz0K) (hNb z₀ hz0K)

theorem swirl_residual_formula : ∀ (f Pf : ℝ → ℝ → ℝ) (x : ℝ³) (t : ℝ), ContDiffOn ℝ ∞ (↿f) (Ioi 0 ×ˢ Iio 1) → ContDiffOn ℝ ∞ (↿Pf) (Ioi 0 ×ˢ Iio 1) → 0 < x 0 ^ 2 + x 1 ^ 2 → t < 1 → nsResidual 1 (fun y s => f (y 0 ^ 2 + y 1 ^ 2) s • (-(y 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + y 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) (fun y s => Pf (y 0 ^ 2 + y 1 ^ 2) s) x t = (deriv (fun s => f (x 0 ^ 2 + x 1 ^ 2) s) t - 4 * (x 0 ^ 2 + x 1 ^ 2) * deriv (fun σ => deriv (fun ρ => f ρ t) σ) (x 0 ^ 2 + x 1 ^ 2) - 8 * deriv (fun ρ => f ρ t) (x 0 ^ 2 + x 1 ^ 2)) • (-(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) + (2 * deriv (fun ρ => Pf ρ t) (x 0 ^ 2 + x 1 ^ 2) - f (x 0 ^ 2 + x 1 ^ 2) t ^ 2) • (x 0 • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 1 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) :=
by
  intro f Pf x t hf hPf hS ht

  have hpj : ∀ (i : Fin 3) (v : ℝ³), (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ) v = v i := fun i v => rfl
  have hc : ∀ (i : Fin 3) (y : ℝ³), HasFDerivAt (fun w : ℝ³ => w i)
      (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ) y := fun i y => PiLp.hasFDerivAt_apply 2 y i

  obtain ⟨L, hL⟩ : ∃ L : ℝ³ →L[ℝ] ℝ³, ∀ v : ℝ³, L v = -(v 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + v 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ) :=
    ⟨-(EuclideanSpace.proj 1 : ℝ³ →L[ℝ] ℝ).smulRight (EuclideanSpace.single (0 : Fin 3) (1:ℝ)) +
      (EuclideanSpace.proj 0 : ℝ³ →L[ℝ] ℝ).smulRight (EuclideanSpace.single (1 : Fin 3) (1:ℝ)),
      fun v => by simp [hpj]⟩
  have hJ : ∀ y : ℝ³, HasFDerivAt (fun w : ℝ³ => -(w 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + w 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) L y := by
    intro y
    have e : (fun w : ℝ³ => -(w 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + w 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) = L := by
      funext w; rw [hL]
    rw [e]; exact L.hasFDerivAt

  obtain ⟨Dσ, hDσ⟩ : ∃ D : ℝ³ → (ℝ³ →L[ℝ] ℝ), ∀ y v, D y v = 2 * y 0 * v 0 + 2 * y 1 * v 1 :=
    ⟨fun y => (2 * y 0) • (EuclideanSpace.proj 0 : ℝ³ →L[ℝ] ℝ) + (2 * y 1) • (EuclideanSpace.proj 1 : ℝ³ →L[ℝ] ℝ),
      fun y v => by simp [hpj]; try ring⟩
  have hσ : ∀ y : ℝ³, HasFDerivAt (fun w : ℝ³ => w 0 ^ 2 + w 1 ^ 2) (Dσ y) y := by
    intro y
    have h := ((hc 0 y).pow 2).add ((hc 1 y).pow 2)
    convert h using 1
    refine ContinuousLinearMap.ext fun v => ?_
    rw [hDσ]; simp [hpj]; try ring
  have hcomp : ∀ (h : ℝ → ℝ) (h' : ℝ) (y : ℝ³), HasDerivAt h h' (y 0 ^ 2 + y 1 ^ 2) →
      HasFDerivAt (fun w : ℝ³ => h (w 0 ^ 2 + w 1 ^ 2)) (h' • Dσ y) y :=
    fun h h' y hh => hh.comp_hasFDerivAt y (hσ y)
  have hG : ∀ (h : ℝ → ℝ) (h' : ℝ) (y : ℝ³), HasDerivAt h h' (y 0 ^ 2 + y 1 ^ 2) →
      HasFDerivAt (fun w : ℝ³ => h (w 0 ^ 2 + w 1 ^ 2) • (-(w 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + w 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)))
        (h (y 0 ^ 2 + y 1 ^ 2) • L + (h' • Dσ y).smulRight (-(y 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + y 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) y := by
    intro h h' y hh
    exact (hcomp h h' y hh).smul (hJ y)
  have hGv : ∀ (h : ℝ → ℝ) (y v : ℝ³), DifferentiableAt ℝ h (y 0 ^ 2 + y 1 ^ 2) →
      fderiv ℝ (fun w : ℝ³ => h (w 0 ^ 2 + w 1 ^ 2) • (-(w 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + w 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) y v =
        h (y 0 ^ 2 + y 1 ^ 2) • L v + (deriv h (y 0 ^ 2 + y 1 ^ 2) * Dσ v y) • (-(y 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + y 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) := by
    intro h y v hh
    rw [(hG h _ y hh.hasDerivAt).fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smulRight_apply, smul_eq_mul]
    rw [show Dσ y v = Dσ v y by rw [hDσ, hDσ]; ring]

  have hlap : ∀ (g : ℝ³ → ℝ³) (x : ℝ³), Δ g x = ∑ i : Fin 3,
      fderiv ℝ (fderiv ℝ g) x (EuclideanSpace.single i (1 : ℝ)) (EuclideanSpace.single i (1 : ℝ)) := by
    intro g x
    have h := congrFun (InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis g
      (EuclideanSpace.basisFun (Fin 3) ℝ)) x
    rw [h]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [iteratedFDeriv_two_apply]
    simp [EuclideanSpace.basisFun_apply]
  have hgrad : ∀ (g : ℝ³ → ℝ) (x : ℝ³), gradient g x = ∑ i : Fin 3,
      fderiv ℝ g x (EuclideanSpace.single i (1 : ℝ)) • EuclideanSpace.single i (1 : ℝ) := by
    intro g x
    have h := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr' (gradient g x)
    rw [← h]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    simp only [EuclideanSpace.basisFun_apply]
    congr 1
    rw [real_inner_comm]
    exact InnerProductSpace.toDual_symm_apply

  have hg : ContDiffOn ℝ ∞ (fun ρ => f ρ t) (Ioi 0) := by
    have hm : MapsTo (fun ρ : ℝ => ((ρ, t) : ℝ × ℝ)) (Ioi 0) (Ioi 0 ×ˢ Iio 1) := fun ρ hρ => ⟨hρ, ht⟩
    exact hf.comp (contDiffOn_id.prodMk contDiffOn_const) hm
  have hPg : ContDiffOn ℝ ∞ (fun ρ => Pf ρ t) (Ioi 0) := by
    have hm : MapsTo (fun ρ : ℝ => ((ρ, t) : ℝ × ℝ)) (Ioi 0) (Ioi 0 ×ˢ Iio 1) := fun ρ hρ => ⟨hρ, ht⟩
    exact hPf.comp (contDiffOn_id.prodMk contDiffOn_const) hm
  have ha : ContDiffOn ℝ ∞ (fun s => f (x 0 ^ 2 + x 1 ^ 2) s) (Iio 1) := by
    have hm : MapsTo (fun s : ℝ => ((x 0 ^ 2 + x 1 ^ 2, s) : ℝ × ℝ)) (Iio 1) (Ioi 0 ×ˢ Iio 1) :=
      fun s hs => ⟨hS, hs⟩
    exact hf.comp (contDiffOn_const.prodMk contDiffOn_id) hm
  have hg' : ContDiffOn ℝ ∞ (deriv (fun ρ => f ρ t)) (Ioi 0) :=
    hg.deriv_of_isOpen (m := ∞) isOpen_Ioi (by simp)
  have hgd : ∀ ρ : ℝ, 0 < ρ → DifferentiableAt ℝ (fun ρ => f ρ t) ρ := fun ρ hρ =>
    (hg.contDiffAt (Ioi_mem_nhds hρ)).differentiableAt (by simp)
  have hg'd : DifferentiableAt ℝ (deriv (fun ρ => f ρ t)) (x 0 ^ 2 + x 1 ^ 2) :=
    (hg'.contDiffAt (Ioi_mem_nhds hS)).differentiableAt (by simp)
  have hPd : DifferentiableAt ℝ (fun ρ => Pf ρ t) (x 0 ^ 2 + x 1 ^ 2) :=
    (hPg.contDiffAt (Ioi_mem_nhds hS)).differentiableAt (by simp)
  have had : DifferentiableAt ℝ (fun s => f (x 0 ^ 2 + x 1 ^ 2) s) t :=
    (ha.contDiffAt (Iio_mem_nhds ht)).differentiableAt (by simp)

  have hGsm : ContDiffAt ℝ ∞ (fun w : ℝ³ => f (w 0 ^ 2 + w 1 ^ 2) t • (-(w 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + w 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) x := by
    have h1 : ContDiffAt ℝ ∞ (fun w : ℝ³ => f (w 0 ^ 2 + w 1 ^ 2) t) x :=
      ContDiffAt.comp (g := fun ρ => f ρ t) x (hg.contDiffAt (Ioi_mem_nhds hS))
        ((by fun_prop : ContDiff ℝ ∞ (fun w : ℝ³ => w 0 ^ 2 + w 1 ^ 2)).contDiffAt)
    exact h1.smul ((by fun_prop : ContDiff ℝ ∞ (fun w : ℝ³ => -(w 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + w 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))).contDiffAt)
  have hDG : DifferentiableAt ℝ (fderiv ℝ (fun w : ℝ³ => f (w 0 ^ 2 + w 1 ^ 2) t • (-(w 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + w 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)))) x :=
    (hGsm.fderiv_right (m := 1) (by simp)).differentiableAt (by simp)
  have hsec : ∀ v : ℝ³, fderiv ℝ (fderiv ℝ (fun w : ℝ³ => f (w 0 ^ 2 + w 1 ^ 2) t • (-(w 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + w 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)))) x v v =
      fderiv ℝ (fun y => fderiv ℝ (fun w : ℝ³ => f (w 0 ^ 2 + w 1 ^ 2) t • (-(w 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + w 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) y v) x v := by
    intro v
    rw [fderiv_clm_apply hDG (differentiableAt_const v)]
    simp
  have hU : {y : ℝ³ | 0 < y 0 ^ 2 + y 1 ^ 2} ∈ nhds x :=
    (isOpen_lt continuous_const (by fun_prop)).mem_nhds hS
  have hev : ∀ v : ℝ³, (fun y => fderiv ℝ (fun w : ℝ³ => f (w 0 ^ 2 + w 1 ^ 2) t • (-(w 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + w 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) y v) =ᶠ[nhds x]
      fun y => f (y 0 ^ 2 + y 1 ^ 2) t • L v + (deriv (fun ρ => f ρ t) (y 0 ^ 2 + y 1 ^ 2) * Dσ v y) • (-(y 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + y 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) := by
    intro v
    filter_upwards [hU] with y hy
    exact hGv (fun ρ => f ρ t) y v (hgd _ hy)
  have hH : ∀ v : ℝ³, HasFDerivAt (fun y => f (y 0 ^ 2 + y 1 ^ 2) t • L v + (deriv (fun ρ => f ρ t) (y 0 ^ 2 + y 1 ^ 2) * Dσ v y) • (-(y 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + y 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)))
      ((deriv (fun ρ => f ρ t) (x 0 ^ 2 + x 1 ^ 2) • Dσ x).smulRight (L v) +
        ((deriv (fun ρ => f ρ t) (x 0 ^ 2 + x 1 ^ 2) * Dσ v x) • L +
          (deriv (fun ρ => f ρ t) (x 0 ^ 2 + x 1 ^ 2) • Dσ v + Dσ v x • (deriv (fun σ => deriv (fun ρ => f ρ t) σ) (x 0 ^ 2 + x 1 ^ 2) • Dσ x)).smulRight
            (-(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)))) x := by
    intro v
    have hA : HasFDerivAt (fun y : ℝ³ => f (y 0 ^ 2 + y 1 ^ 2) t • L v)
        ((deriv (fun ρ => f ρ t) (x 0 ^ 2 + x 1 ^ 2) • Dσ x).smulRight (L v)) x :=
      (hcomp (fun ρ => f ρ t) _ x (hgd _ hS).hasDerivAt).smul_const (L v)
    have hB1 : HasFDerivAt (fun y : ℝ³ => deriv (fun ρ => f ρ t) (y 0 ^ 2 + y 1 ^ 2) * Dσ v y)
        (deriv (fun ρ => f ρ t) (x 0 ^ 2 + x 1 ^ 2) • Dσ v + Dσ v x • (deriv (fun σ => deriv (fun ρ => f ρ t) σ) (x 0 ^ 2 + x 1 ^ 2) • Dσ x)) x :=
      (hcomp (deriv (fun ρ => f ρ t)) _ x hg'd.hasDerivAt).mul (Dσ v).hasFDerivAt
    have hB : HasFDerivAt (fun y : ℝ³ => (deriv (fun ρ => f ρ t) (y 0 ^ 2 + y 1 ^ 2) * Dσ v y) • (-(y 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + y 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)))
        ((deriv (fun ρ => f ρ t) (x 0 ^ 2 + x 1 ^ 2) * Dσ v x) • L +
          (deriv (fun ρ => f ρ t) (x 0 ^ 2 + x 1 ^ 2) • Dσ v + Dσ v x • (deriv (fun σ => deriv (fun ρ => f ρ t) σ) (x 0 ^ 2 + x 1 ^ 2) • Dσ x)).smulRight
            (-(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) x :=
      hB1.smul (hJ x)
    exact hA.add hB

  have T1 : deriv (fun s => f (x 0 ^ 2 + x 1 ^ 2) s • (-(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) t =
      deriv (fun s => f (x 0 ^ 2 + x 1 ^ 2) s) t • (-(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) :=
    deriv_smul_const had _
  have T2 := hGv (fun ρ => f ρ t) x (f (x 0 ^ 2 + x 1 ^ 2) t • (-(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) (hgd _ hS)
  have T3 : Δ (fun w : ℝ³ => f (w 0 ^ 2 + w 1 ^ 2) t • (-(w 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + w 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) x =
      ∑ i : Fin 3, ((deriv (fun ρ => f ρ t) (x 0 ^ 2 + x 1 ^ 2) • Dσ x).smulRight (L (EuclideanSpace.single i (1:ℝ))) +
        ((deriv (fun ρ => f ρ t) (x 0 ^ 2 + x 1 ^ 2) * Dσ (EuclideanSpace.single i (1:ℝ)) x) • L +
          (deriv (fun ρ => f ρ t) (x 0 ^ 2 + x 1 ^ 2) • Dσ (EuclideanSpace.single i (1:ℝ)) + Dσ (EuclideanSpace.single i (1:ℝ)) x • (deriv (fun σ => deriv (fun ρ => f ρ t) σ) (x 0 ^ 2 + x 1 ^ 2) • Dσ x)).smulRight
            (-(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)))) (EuclideanSpace.single i (1:ℝ)) := by
    rw [hlap]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hsec, (hev _).fderiv_eq, (hH _).fderiv]
  have T4 : gradient (fun y : ℝ³ => Pf (y 0 ^ 2 + y 1 ^ 2) t) x = ∑ i : Fin 3,
      (deriv (fun ρ => Pf ρ t) (x 0 ^ 2 + x 1 ^ 2) • Dσ x) (EuclideanSpace.single i (1 : ℝ)) • EuclideanSpace.single i (1 : ℝ) := by
    rw [hgrad, (hcomp (fun ρ => Pf ρ t) _ x hPd.hasDerivAt).fderiv]
  show deriv (fun s => f (x 0 ^ 2 + x 1 ^ 2) s • (-(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) t +
      fderiv ℝ (fun w : ℝ³ => f (w 0 ^ 2 + w 1 ^ 2) t • (-(w 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + w 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) x
        (f (x 0 ^ 2 + x 1 ^ 2) t • (-(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) -
      (1:ℝ) • Δ (fun w : ℝ³ => f (w 0 ^ 2 + w 1 ^ 2) t • (-(w 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + w 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) x +
      gradient (fun y : ℝ³ => Pf (y 0 ^ 2 + y 1 ^ 2) t) x = _
  rw [T1, T2, T3, T4]
  ext k
  fin_cases k <;>
    simp [Fin.sum_univ_three, hL, hDσ, EuclideanSpace.single_apply] <;> ring

theorem swirl_div_tangent : ∀ (f : ℝ → ℝ → ℝ) (x : ℝ³) (t : ℝ), ContDiffOn ℝ ∞ (↿f) (Ioi 0 ×ˢ Iio 1) → 0 < x 0 ^ 2 + x 1 ^ 2 → t < 1 → divergence (fun y => f (y 0 ^ 2 + y 1 ^ 2) t • (-(y 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + y 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) x = 0 ∧ inner ℝ x (f (x 0 ^ 2 + x 1 ^ 2) t • (-(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) = (0:ℝ) ∧ (f (x 0 ^ 2 + x 1 ^ 2) t • (-(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))) 2 = 0 :=
by
  intro f x t hf hS ht
  have hsmul : ∀ (φ : ℝ³ → ℝ) (V : ℝ³ → ℝ³) (x : ℝ³), DifferentiableAt ℝ φ x →
      DifferentiableAt ℝ V x →
      divergence (fun y => φ y • V y) x = φ x * divergence V x + fderiv ℝ φ x (V x) := by
    intro φ V x hφ hV
    rw [divergence, fderiv_fun_smul hφ hV, ContinuousLinearMap.toLinearMap_add,
      ContinuousLinearMap.toLinearMap_smul, map_add, map_smul, divergence, smul_eq_mul]
    congr 1
    have h : ((fderiv ℝ φ x).smulRight (V x) : ℝ³ →ₗ[ℝ] ℝ³) =
        (fderiv ℝ φ x : ℝ³ →ₗ[ℝ] ℝ).smulRight (V x) := rfl
    rw [h, LinearMap.trace_smulRight]
    rfl
  have c00 : (EuclideanSpace.single (0 : Fin 3) (1:ℝ)) 0 = 1 := by simp
  have c01 : (EuclideanSpace.single (0 : Fin 3) (1:ℝ)) 1 = 0 := by simp
  have c02 : (EuclideanSpace.single (0 : Fin 3) (1:ℝ)) 2 = 0 := by simp
  have c10 : (EuclideanSpace.single (1 : Fin 3) (1:ℝ)) 0 = 0 := by simp
  have c11 : (EuclideanSpace.single (1 : Fin 3) (1:ℝ)) 1 = 1 := by simp
  have c12 : (EuclideanSpace.single (1 : Fin 3) (1:ℝ)) 2 = 0 := by simp
  generalize EuclideanSpace.single (0 : Fin 3) (1:ℝ) = e0 at c00 c01 c02 ⊢
  generalize EuclideanSpace.single (1 : Fin 3) (1:ℝ) = e1 at c10 c11 c12 ⊢
  have hO : IsOpen (Ioi (0:ℝ) ×ˢ Iio (1:ℝ)) := isOpen_Ioi.prod isOpen_Iio
  have hg : ContDiffAt ℝ ∞ (fun σ => f σ t) (x 0 ^ 2 + x 1 ^ 2) :=
    (hf.contDiffAt (hO.mem_nhds
      (show ((x 0 ^ 2 + x 1 ^ 2, t) : ℝ × ℝ) ∈ Ioi (0:ℝ) ×ˢ Iio (1:ℝ) from ⟨hS, ht⟩))).comp
      (x 0 ^ 2 + x 1 ^ 2) ((contDiff_id.prodMk contDiff_const).contDiffAt)
  have hgd : HasDerivAt (fun σ => f σ t) (deriv (fun σ => f σ t) (x 0 ^ 2 + x 1 ^ 2))
      (x 0 ^ 2 + x 1 ^ 2) :=
    (hg.differentiableAt (by norm_num)).hasDerivAt
  have h0 : HasFDerivAt (fun y : ℝ³ => y 0) (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ) x :=
    (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).hasFDerivAt
  have h1 : HasFDerivAt (fun y : ℝ³ => y 1) (EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ) x :=
    (EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ).hasFDerivAt
  have hn1 : HasFDerivAt (fun y : ℝ³ => -(y 1))
      (-(EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ)) x := h1.neg
  have hSd : HasFDerivAt (fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2)
      ((2 * x 0) • (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ) +
        (2 * x 1) • (EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ)) x := by
    convert (h0.pow 2).add (h1.pow 2) using 1
    simp
  have hφd : HasFDerivAt (fun y : ℝ³ => f (y 0 ^ 2 + y 1 ^ 2) t)
      (deriv (fun σ => f σ t) (x 0 ^ 2 + x 1 ^ 2) •
        ((2 * x 0) • (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ) +
          (2 * x 1) • (EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ))) x := by
    have := hgd.comp_hasFDerivAt x hSd
    exact this
  have hJd0 : HasFDerivAt (fun y : ℝ³ => -(y 1) • e0)
      ((-(EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ)).smulRight e0) x :=
    hn1.smul_const e0
  have hJd1 : HasFDerivAt (fun y : ℝ³ => y 0 • e1)
      ((EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).smulRight e1) x :=
    h0.smul_const e1
  have hJ : DifferentiableAt ℝ (fun y : ℝ³ => -(y 1) • e0 + y 0 • e1) x :=
    (hJd0.add hJd1).differentiableAt
  have hdivJ : divergence (fun y : ℝ³ => -(y 1) • e0 + y 0 • e1) x = 0 := by
    rw [divergence_add hJd0.differentiableAt hJd1.differentiableAt]
    have k1 := hsmul (fun y : ℝ³ => -(y 1)) (fun _ => e0) x hn1.differentiableAt
      (differentiableAt_const _)
    have k2 := hsmul (fun y : ℝ³ => y 0) (fun _ => e1) x h0.differentiableAt
      (differentiableAt_const _)
    rw [k1, k2, hn1.fderiv, h0.fderiv]
    simp [c01, c10]
  have hdiv : divergence (fun y : ℝ³ => f (y 0 ^ 2 + y 1 ^ 2) t • (-(y 1) • e0 + y 0 • e1)) x
      = 0 := by
    rw [hsmul _ _ x hφd.differentiableAt hJ, hdivJ, hφd.fderiv]
    simp [c00, c01, c10, c11]
    ring
  refine ⟨hdiv, ?_, ?_⟩
  · rw [real_inner_smul_right]
    apply mul_eq_zero_of_right
    simp [PiLp.inner_apply, Fin.sum_univ_three, c00, c01, c02, c10, c11, c12] <;> ring
  · simp [c02, c12]

theorem jfield_bounds : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => -(z.1 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + z.1 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) ∧ ∀ k : ℕ, ∃ C : ℝ, ∀ z : ℝ³ × ℝ, z.1 0 ^ 2 + z.1 1 ^ 2 ≤ 1 → ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => -(z.1 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + z.1 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) z‖ ≤ C :=
by
  obtain ⟨L, hL⟩ : ∃ L : ℝ³ × ℝ →L[ℝ] ℝ³, L =
      ((EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ).comp
          (ContinuousLinearMap.fst ℝ ℝ³ ℝ)).smulRight
        (-EuclideanSpace.single (0 : Fin 3) (1:ℝ)) +
      ((EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).comp
          (ContinuousLinearMap.fst ℝ ℝ³ ℝ)).smulRight
        (EuclideanSpace.single (1 : Fin 3) (1:ℝ)) := ⟨_, rfl⟩
  have hJ : (fun z : ℝ³ × ℝ => -(z.1 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
      z.1 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) = ⇑L := by
    funext z
    rw [hL]
    simp [neg_smul, smul_neg]
  have hfd : fderiv ℝ (⇑L) = fun _ => L := funext fun _ => L.fderiv
  refine ⟨by rw [hJ]; exact L.contDiff, ?_⟩
  intro k
  refine ⟨2 + ‖L‖, fun z hz => ?_⟩
  have hLn : 0 ≤ ‖L‖ := norm_nonneg L
  rcases k with _ | n
  · rw [norm_iteratedFDeriv_zero]
    have h0 : z.1 0 ^ 2 ≤ 1 := by nlinarith [sq_nonneg (z.1 1)]
    have h1 : z.1 1 ^ 2 ≤ 1 := by nlinarith [sq_nonneg (z.1 0)]
    have a0 : |z.1 0| ≤ 1 := (sq_le_one_iff_abs_le_one _).mp h0
    have a1 : |z.1 1| ≤ 1 := (sq_le_one_iff_abs_le_one _).mp h1
    calc ‖-(z.1 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
          z.1 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)‖
        ≤ ‖-(z.1 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ)‖ +
          ‖z.1 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)‖ := norm_add_le _ _
      _ = |z.1 1| + |z.1 0| := by
          rw [norm_smul, norm_smul, EuclideanSpace.norm_single, EuclideanSpace.norm_single]
          simp
      _ ≤ 2 + ‖L‖ := by linarith
  · rw [hJ, ← norm_iteratedFDeriv_fderiv, hfd]
    rcases n with _ | m
    · rw [norm_iteratedFDeriv_zero]; linarith
    · rw [iteratedFDeriv_succ_const]
      simp only [Pi.zero_apply, norm_zero]
      linarith

theorem iteratedFDeriv_bilinear_bounded_on : ∀ {E F G H : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G] [NormedSpace ℝ G] [NormedAddCommGroup H] [NormedSpace ℝ H] (B : F →L[ℝ] G →L[ℝ] H) (f : E → F) (g : E → G) (O S : Set E), IsOpen O → S ⊆ O → ContDiffOn ℝ ∞ f O → ContDiffOn ℝ ∞ g O → (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k f z‖ ≤ C) → (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k g z‖ ≤ C) → ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (fun z => B (f z) (g z)) z‖ ≤ C :=
by
  intro E F G H _ _ _ _ _ _ _ _ B f g O S hO hSO hf hg hbf hbg k
  choose Cf hCf using hbf
  choose Cg hCg using hbg
  refine ⟨‖B‖ * ∑ i ∈ Finset.range (k + 1),
      (k.choose i : ℝ) * max (Cf i) 0 * max (Cg (k - i)) 0, fun z hz => ?_⟩
  have hzO : z ∈ O := hSO hz
  have hU : UniqueDiffOn ℝ O := hO.uniqueDiffOn
  have key := ContinuousLinearMap.norm_iteratedFDerivWithin_le_of_bilinear B hf hg hU hzO
    (n := k) (by exact_mod_cast le_top)
  rw [iteratedFDerivWithin_of_isOpen k hO hzO] at key
  refine key.trans ?_
  refine mul_le_mul_of_nonneg_left ?_ (ContinuousLinearMap.opNorm_nonneg B)
  refine Finset.sum_le_sum fun i _ => ?_
  rw [iteratedFDerivWithin_of_isOpen i hO hzO, iteratedFDerivWithin_of_isOpen (k - i) hO hzO]
  have h1 : ‖iteratedFDeriv ℝ i f z‖ ≤ max (Cf i) 0 := (hCf i z hz).trans (le_max_left _ _)
  have h2 : ‖iteratedFDeriv ℝ (k - i) g z‖ ≤ max (Cg (k - i)) 0 :=
    (hCg (k - i) z hz).trans (le_max_left _ _)
  have h0 : (0 : ℝ) ≤ k.choose i := Nat.cast_nonneg _
  exact mul_le_mul (mul_le_mul_of_nonneg_left h1 h0) h2 (norm_nonneg _)
    (mul_nonneg h0 (le_max_right _ _))

theorem heat_exterior_field : ∀ h c : ℝ, 0 < h → h < 1 / 2 → HeatExteriorProps h c :=
by
  intro h c hh _

  obtain ⟨hH1, hH2, hH3⟩ := heatProfile_props h hh (fun β Z hβ hZ => heatK_deriv_bound β Z hβ hZ)
    (fun Z hZ => heatK_ode h Z hh hZ)
  obtain ⟨hQ1, hQ2, hQ3⟩ := heatQ_props h hh hH1 hH2

  obtain ⟨D, hD⟩ : ∃ D : Set (ℝ³ × ℝ), D = {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2 ∧ w.2 < 1} :=
    ⟨_, rfl⟩
  have hσc : Continuous (fun w : ℝ³ × ℝ => w.1 0 ^ 2 + w.1 1 ^ 2) := by fun_prop
  have hDo : IsOpen D := by
    rw [hD]
    exact (isOpen_lt continuous_const hσc).inter (isOpen_lt continuous_snd continuous_const)

  obtain ⟨FH, hFH⟩ : ∃ FH : ℝ³ × ℝ → ℝ, FH = fun z => (z.1 0 ^ 2 + z.1 1 ^ 2) ^ (-(1 + h)) *
      heatProfile h (4 * (1 - z.2) / (z.1 0 ^ 2 + z.1 1 ^ 2)) := ⟨_, rfl⟩
  obtain ⟨FQ, hFQ⟩ : ∃ FQ : ℝ³ × ℝ → ℝ, FQ = fun z => (z.1 0 ^ 2 + z.1 1 ^ 2) ^ (-(1 + 2 * h)) *
      heatQ h (4 * (1 - z.2) / (z.1 0 ^ 2 + z.1 1 ^ 2)) := ⟨_, rfl⟩
  obtain ⟨J, hJ⟩ : ∃ J : ℝ³ × ℝ → ℝ³, J = fun z => -(z.1 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
      z.1 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ) := ⟨_, rfl⟩
  have hFHs : ContDiffOn ℝ ∞ FH D := by
    rw [hFH, hD]; exact (profile_field_smooth_bounded (heatProfile h) (-(1 + h)) hH1 hH2).1
  have hFHb : ∀ r₀ : ℝ, 0 < r₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), r₀ ^ 2 ≤ x 0 ^ 2 + x 1 ^ 2 →
      x 0 ^ 2 + x 1 ^ 2 ≤ 1 → 0 < t → t < 1 → ‖iteratedFDeriv ℝ m FH (x, t)‖ ≤ C := by
    rw [hFH]; exact (profile_field_smooth_bounded (heatProfile h) (-(1 + h)) hH1 hH2).2
  have hFQs : ContDiffOn ℝ ∞ FQ D := by
    rw [hFQ, hD]; exact (profile_field_smooth_bounded (heatQ h) (-(1 + 2 * h)) hQ1 hQ2).1
  have hFQb : ∀ r₀ : ℝ, 0 < r₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ (x : ℝ³) (t : ℝ), r₀ ^ 2 ≤ x 0 ^ 2 + x 1 ^ 2 →
      x 0 ^ 2 + x 1 ^ 2 ≤ 1 → 0 < t → t < 1 → ‖iteratedFDeriv ℝ m FQ (x, t)‖ ≤ C := by
    rw [hFQ]; exact (profile_field_smooth_bounded (heatQ h) (-(1 + 2 * h)) hQ1 hQ2).2
  have hJs : ContDiff ℝ ∞ J := by rw [hJ]; exact jfield_bounds.1
  have hJb : ∀ k : ℕ, ∃ C : ℝ, ∀ z : ℝ³ × ℝ, z.1 0 ^ 2 + z.1 1 ^ 2 ≤ 1 →
      ‖iteratedFDeriv ℝ k J z‖ ≤ C := by
    rw [hJ]; exact jfield_bounds.2

  have hSweq : (↿(heatSwirl h c)) = fun z => (c * FH z) • J z := by
    funext z
    show heatSwirl h c z.1 z.2 = _
    simp only [heatSwirl, hFH, hJ, mul_assoc]

  have hPeq : ∀ z ∈ D, (↿(heatPressure h c)) z = -(c ^ 2 / 2) * FQ z := by
    intro z hz
    rw [hD] at hz
    show heatPressure h c z.1 z.2 = _
    simp only [heatPressure, hFQ]
    rw [heatPressure_integral_eq h _ _ hz.1]

  have hprof : ∀ (φ : ℝ → ℝ) (α : ℝ), ContDiffOn ℝ ∞ φ (Ioi 0) →
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 ^ α * φ (4 * (1 - p.2) / p.1)) (Ioi 0 ×ˢ Iio 1) := by
    intro φ α hφ
    have h1 : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 ^ α) (Ioi 0 ×ˢ Iio 1) :=
      contDiff_fst.contDiffOn.rpow_const_of_ne (fun p hp => (hp.1 : (0:ℝ) < p.1).ne')
    have h2 : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 4 * (1 - p.2) / p.1) (Ioi 0 ×ˢ Iio 1) :=
      (contDiffOn_const.mul (contDiffOn_const.sub contDiff_snd.contDiffOn)).div
        contDiff_fst.contDiffOn (fun p hp => (hp.1 : (0:ℝ) < p.1).ne')
    have h3 : MapsTo (fun p : ℝ × ℝ => 4 * (1 - p.2) / p.1) (Ioi 0 ×ˢ Iio 1) (Ioi 0) := by
      intro p hp
      have hp1 : (0:ℝ) < p.1 := hp.1
      have hp2 : p.2 < 1 := hp.2
      show (0:ℝ) < 4 * (1 - p.2) / p.1
      exact div_pos (by linarith) hp1
    exact h1.mul (hφ.comp h2 h3)
  refine ⟨?_, ?_, ?_, ?_⟩
  ·
    rw [hSweq, ← hD]
    exact (contDiffOn_const.mul hFHs).smul hJs.contDiffOn
  ·
    rw [← hD]
    exact (contDiffOn_const.mul hFQs).congr hPeq
  ·
    intro x t hS ht
    have hA : (0:ℝ) < 4 * (1 - t) := by linarith
    obtain ⟨f, hf⟩ : ∃ f : ℝ → ℝ → ℝ, f = fun σ s => c * σ ^ (-(1 + h)) * heatProfile h (4 * (1 - s) / σ) :=
      ⟨_, rfl⟩
    obtain ⟨Pf, hPf⟩ : ∃ Pf : ℝ → ℝ → ℝ, Pf = fun σ s => -(c ^ 2 / 2) *
        ∫ s' in Ioi σ, s' ^ (-(2 + 2 * h)) * heatProfile h (4 * (1 - s) / s') ^ 2 := ⟨_, rfl⟩
    have hsw : heatSwirl h c = fun y s => f (y 0 ^ 2 + y 1 ^ 2) s •
        (-(y 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) + y 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) := by
      rw [hf]; try rfl
    have hpr : heatPressure h c = fun y s => Pf (y 0 ^ 2 + y 1 ^ 2) s := by
      rw [hPf]; try rfl
    have hFs : ContDiffOn ℝ ∞ (↿f) (Ioi 0 ×ˢ Iio 1) := by
      rw [hf]
      exact (contDiffOn_const.mul (hprof (heatProfile h) (-(1 + h)) hH1)).congr (fun p _ => by
        show c * p.1 ^ (-(1 + h)) * heatProfile h (4 * (1 - p.2) / p.1) =
          c * (p.1 ^ (-(1 + h)) * heatProfile h (4 * (1 - p.2) / p.1))
        ring)
    have hPs : ContDiffOn ℝ ∞ (↿Pf) (Ioi 0 ×ˢ Iio 1) := by
      rw [hPf]
      exact (contDiffOn_const.mul (hprof (heatQ h) (-(1 + 2 * h)) hQ1)).congr (fun p hp => by
        show -(c ^ 2 / 2) * (∫ s' in Ioi p.1, s' ^ (-(2 + 2 * h)) * heatProfile h (4 * (1 - p.2) / s') ^ 2) =
          -(c ^ 2 / 2) * (p.1 ^ (-(1 + 2 * h)) * heatQ h (4 * (1 - p.2) / p.1))
        rw [heatPressure_integral_eq h _ _ (hp.1 : (0:ℝ) < p.1)])
    have hB1 : deriv (fun s => f (x 0 ^ 2 + x 1 ^ 2) s) t - 4 * (x 0 ^ 2 + x 1 ^ 2) *
        deriv (fun σ => deriv (fun ρ => f ρ t) σ) (x 0 ^ 2 + x 1 ^ 2) -
        8 * deriv (fun ρ => f ρ t) (x 0 ^ 2 + x 1 ^ 2) = 0 := by
      rw [hf]
      exact swirl_profile_heat_eq h c t _ (heatProfile h) hS ht hH1 hH3
    have hY : (0:ℝ) < 4 * (1 - t) / (x 0 ^ 2 + x 1 ^ 2) := div_pos hA hS
    have hQd : DifferentiableAt ℝ (heatQ h) (4 * (1 - t) / (x 0 ^ 2 + x 1 ^ 2)) :=
      (hQ1.differentiableOn (by norm_num)).differentiableAt (Ioi_mem_nhds hY)
    have hB2 : 2 * deriv (fun ρ => Pf ρ t) (x 0 ^ 2 + x 1 ^ 2) - f (x 0 ^ 2 + x 1 ^ 2) t ^ 2 = 0 := by
      have hev : (fun ρ => Pf ρ t) =ᶠ[nhds (x 0 ^ 2 + x 1 ^ 2)]
          (fun σ : ℝ => -(c ^ 2 / 2) * σ ^ (-(1 + 2 * h)) * heatQ h (4 * (1 - t) / σ)) :=
        Filter.eventuallyEq_of_mem (Ioi_mem_nhds hS) (fun ρ hρ => by
          rw [hPf]
          show -(c ^ 2 / 2) * (∫ s' in Ioi ρ, s' ^ (-(2 + 2 * h)) * heatProfile h (4 * (1 - t) / s') ^ 2) =
            -(c ^ 2 / 2) * ρ ^ (-(1 + 2 * h)) * heatQ h (4 * (1 - t) / ρ)
          rw [heatPressure_integral_eq h _ _ (hρ : (0:ℝ) < ρ)]
          ring)
      rw [hev.deriv_eq, pressure_profile_balance h c _ _ (heatProfile h) (heatQ h) hA hS hQd (hQ3 _ hY)]
      simp only [hf, sub_self]
    have hdt := swirl_div_tangent f x t hFs hS ht
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hsw, hpr, swirl_residual_formula f Pf x t hFs hPs hS ht, hB1, hB2]
      simp
    · rw [hsw]; exact hdt.1
    · rw [hsw]; exact hdt.2.1
    · rw [hsw]; exact hdt.2.2
  ·
    intro r₀ hr₀ m
    obtain ⟨R, hR⟩ : ∃ R : Set (ℝ³ × ℝ), R = {z : ℝ³ × ℝ | r₀ ^ 2 ≤ z.1 0 ^ 2 + z.1 1 ^ 2 ∧
        z.1 0 ^ 2 + z.1 1 ^ 2 ≤ 1 ∧ 0 < z.2 ∧ z.2 < 1} := ⟨_, rfl⟩
    have hr2 : 0 < r₀ ^ 2 := pow_pos hr₀ 2
    have hRD : R ⊆ D := by
      intro z hz
      rw [hR] at hz
      rw [hD]
      exact ⟨by linarith [hz.1], hz.2.2.2⟩
    have hfb : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ R, ‖iteratedFDeriv ℝ k (fun z => c * FH z) z‖ ≤ C := by
      intro k
      obtain ⟨C, hC⟩ := hFHb r₀ hr₀ k
      refine ⟨‖c‖ * C, fun z hz => ?_⟩
      have hca : ContDiffAt ℝ k FH z :=
        contDiffAt_infty.mp (hFHs.contDiffAt (hDo.mem_nhds (hRD hz))) k
      rw [show (fun z => c * FH z) = fun z => c • FH z from rfl, iteratedFDeriv_const_smul_apply' hca,
        norm_smul]
      rw [hR] at hz
      exact mul_le_mul_of_nonneg_left (hC z.1 z.2 hz.1 hz.2.1 hz.2.2.1 hz.2.2.2) (norm_nonneg c)
    have hgb : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ R, ‖iteratedFDeriv ℝ k J z‖ ≤ C := by
      intro k
      obtain ⟨C, hC⟩ := hJb k
      refine ⟨C, fun z hz => ?_⟩
      rw [hR] at hz
      exact hC z hz.2.1
    obtain ⟨C1, hC1⟩ := iteratedFDeriv_bilinear_bounded_on
      (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³) (fun z => c * FH z) J D R hDo hRD
      (contDiffOn_const.mul hFHs) hJs.contDiffOn hfb hgb m
    have heq : (fun z => (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³) (c * FH z) (J z)) =
        ↿(heatSwirl h c) := by
      rw [hSweq]
      funext z
      rw [ContinuousLinearMap.lsmul_apply]
    rw [heq] at hC1
    obtain ⟨C2, hC2⟩ := hFQb r₀ hr₀ m
    refine ⟨max C1 (‖-(c ^ 2 / 2)‖ * C2), fun x t h1 h2 h3 h4 => ?_⟩
    have hz : ((x, t) : ℝ³ × ℝ) ∈ R := by rw [hR]; exact ⟨h1, h2, h3, h4⟩
    refine ⟨(hC1 _ hz).trans (le_max_left _ _), ?_⟩
    have hev : (↿(heatPressure h c)) =ᶠ[nhds ((x, t) : ℝ³ × ℝ)] fun w => (-(c ^ 2 / 2)) • FQ w :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds (hRD hz)) (fun w hw => hPeq w hw)
    have hca : ContDiffAt ℝ m FQ (x, t) :=
      contDiffAt_infty.mp (hFQs.contDiffAt (hDo.mem_nhds (hRD hz))) m
    rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_const_smul_apply' hca, norm_smul]
    exact (mul_le_mul_of_nonneg_left (hC2 x t h1 h2 h3 h4) (norm_nonneg _)).trans (le_max_right _ _)

theorem shape_datum_axdatum : ∀ (Pst : ℝ) (c ϑ : ℝ → ℝ), 0 < Pst → ShapeData Pst c ϑ → (∃ ρ : ℝ, 0 < ρ ∧ ∃ Pc : ℂ → ℂ, DifferentiableOn ℂ Pc {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧ ∀ η : ℝ, -1 - ρ < η → η < 1 + ρ → Pc (η : ℂ) = ((shapeDatum c ϑ η : ℝ) : ℂ)) ∧ (∀ η : ℝ, shapeDatum c ϑ (-η) = shapeDatum c ϑ η) ∧ (∀ η : ℝ, -1 ≤ η → η ≤ 1 → shapeDatum c ϑ η ≤ -(5 / 2) * Pst ^ 2 * ((1 + η ^ 2)⁻¹) ^ 2) ∧ (∀ η : ℝ, -1 ≤ η → η ≤ 1 → η ≠ 0 → 0 < η * deriv (shapeDatum c ϑ) η) :=
by
  intro Pst c ϑ hP hSD
  obtain ⟨hc, hϑ, hb, hneg, C, κ, hκ, hdec⟩ := hSD
  have hb2 : ∀ y, 0 ≤ ϑ y ∧ ϑ y ≤ 1 := fun y => ⟨(hb y).2.1, (hb y).2.2⟩

  have hI : Integrable (fun y => c y ^ 2) := by
    have hm : AEStronglyMeasurable (fun y => c y ^ 2) volume := (hc.pow_const 2).aestronglyMeasurable
    rw [← integrableOn_univ, ← Set.Iic_union_Ioi (a := (0:ℝ)), integrableOn_union]
    constructor
    · have h1 : IntegrableOn (fun y => Pst ^ 2 * Real.exp ((1/5) * y)) (Iic 0) :=
        (integrableOn_exp_mul_Iic (by norm_num : (0:ℝ) < 1/5) 0).const_mul _
      refine h1.congr_fun (fun y hy => ?_) measurableSet_Iic
      simp only
      rw [(hneg y hy).2, mul_pow, ← Real.exp_nat_mul]
      congr 2; push_cast; ring
    · have h1 : IntegrableOn (fun y => C ^ 2 * Real.exp (-(2*κ) * y)) (Ioi 0) :=
        (exp_neg_integrableOn_Ioi 0 (by positivity : 0 < 2*κ)).const_mul (C^2)
      refine Integrable.mono' h1 hm.restrict ?_
      refine ae_restrict_of_forall_mem measurableSet_Ioi (fun y hy => ?_)
      have hy0 : (0:ℝ) ≤ y := le_of_lt hy
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      calc c y ^ 2 ≤ (C * Real.exp (-(κ * y))) ^ 2 := pow_le_pow_left₀ (hb y).1 (hdec y hy0) 2
        _ = C ^ 2 * Real.exp (-(2*κ) * y) := by
          rw [mul_pow, ← Real.exp_nat_mul]; congr 2; push_cast; ring

  have hlb : ∀ η : ℝ, 5 * Pst ^ 2 * ((1 + η ^ 2)⁻¹) ^ 2 ≤ ∫ y, c y ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y) ∧
      5 * Pst ^ 2 * ((1 + η ^ 2)⁻¹) ^ 2 ≤ ∫ y, ϑ y * c y ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y) := by
    intro η
    have hf0 : 0 < (1 + η ^ 2)⁻¹ := by positivity
    have hf1 : (1 + η ^ 2)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by nlinarith [sq_nonneg η])
    have hpow : ∀ y, 0 ≤ ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y) ∧ ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y) ≤ 1 := fun y =>
      ⟨Real.rpow_nonneg hf0.le _, Real.rpow_le_one hf0.le hf1 (by linarith [(hb y).2.1])⟩
    have hmf : Measurable (fun y => ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y)) := measurable_const.pow (hϑ.const_mul 2)
    have hmc : Measurable (fun y => c y ^ 2) := hc.pow_const 2
    have hgi : Integrable (fun y => c y ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y)) := by
      refine hI.mono' (hmc.mul hmf).aestronglyMeasurable (ae_of_all _ (fun y => ?_))
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (sq_nonneg _) (hpow y).1)]
      exact mul_le_of_le_one_right (sq_nonneg _) (hpow y).2
    have hki : Integrable (fun y => ϑ y * c y ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y)) := by
      refine hI.mono' ((hϑ.mul hmc).mul hmf).aestronglyMeasurable (ae_of_all _ (fun y => ?_))
      have h1 := (hb y).2.1
      have h2 := (hb y).2.2
      have h3 := (hpow y).1
      have h4 := (hpow y).2
      have h5 := sq_nonneg (c y)
      rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
      calc ϑ y * c y ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y) ≤ 1 * c y ^ 2 * 1 := by gcongr
        _ = c y ^ 2 := by ring
    have hleft : ∫ y in Iic (0:ℝ), Pst ^ 2 * ((1 + η ^ 2)⁻¹) ^ 2 * Real.exp ((1/5) * y)
        = 5 * Pst ^ 2 * ((1 + η ^ 2)⁻¹) ^ 2 := by
      rw [integral_const_mul, integral_exp_mul_Iic (by norm_num) 0]; simp; ring
    have hexp : ∀ y : ℝ, (Pst * Real.exp (y / 10)) ^ 2 = Pst ^ 2 * Real.exp ((1/5) * y) := by
      intro y
      rw [mul_pow, ← Real.exp_nat_mul]; congr 2; push_cast; ring
    have heq1 : ∀ y ∈ Iic (0:ℝ), c y ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y)
        = Pst ^ 2 * ((1 + η ^ 2)⁻¹) ^ 2 * Real.exp ((1/5) * y) := by
      intro y hy
      rw [(hneg y hy).1, (hneg y hy).2, mul_one, Real.rpow_two, hexp]; ring
    have heq2 : ∀ y ∈ Iic (0:ℝ), ϑ y * c y ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y)
        = Pst ^ 2 * ((1 + η ^ 2)⁻¹) ^ 2 * Real.exp ((1/5) * y) := by
      intro y hy
      rw [(hneg y hy).1, (hneg y hy).2, mul_one, one_mul, Real.rpow_two, hexp]; ring
    constructor
    · have := setIntegral_le_integral (s := Iic (0:ℝ)) hgi
        (ae_of_all _ (fun y => mul_nonneg (sq_nonneg _) (hpow y).1))
      rw [setIntegral_congr_fun measurableSet_Iic heq1, hleft] at this
      exact this
    · have := setIntegral_le_integral (s := Iic (0:ℝ)) hki
        (ae_of_all _ (fun y => mul_nonneg (mul_nonneg (hb y).2.1 (sq_nonneg _)) (hpow y).1))
      rw [setIntegral_congr_fun measurableSet_Iic heq2, hleft] at this
      exact this

  have hcx : ∃ Pc : ℂ → ℂ, DifferentiableOn ℂ Pc
      {w : ℂ | |w.im| < 1 / 4 ∧ -1 - 1 / 4 < w.re ∧ w.re < 1 + 1 / 4} ∧
      ∀ η : ℝ, Pc (η : ℂ) = ((shapeDatum c ϑ η : ℝ) : ℂ) := by
    set S : Set ℂ := {w : ℂ | |w.im| < 1 / 4 ∧ -1 - 1 / 4 < w.re ∧ w.re < 1 + 1 / 4} with hS
    set Fc : ℂ → ℝ → ℂ := fun w y =>
      ((c y ^ 2 : ℝ) : ℂ) * Complex.exp (((-2 * ϑ y : ℝ) : ℂ) * Complex.log (1 + w ^ 2)) with hFc
    set Fc' : ℂ → ℝ → ℂ := fun w y =>
      ((c y ^ 2 : ℝ) : ℂ) * (Complex.exp (((-2 * ϑ y : ℝ) : ℂ) * Complex.log (1 + w ^ 2)) *
        (((-2 * ϑ y : ℝ) : ℂ) * (2 * w / (1 + w ^ 2)))) with hFc'
    refine ⟨fun w => -(1 / 2 : ℂ) * ∫ y, Fc w y, ?_, ?_⟩
    · have hSo : IsOpen S := by
        have h1 : IsOpen {w : ℂ | |w.im| < 1 / 4} :=
          isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
        have h2 : IsOpen {w : ℂ | -1 - 1 / 4 < w.re} := isOpen_lt continuous_const Complex.continuous_re
        have h3 : IsOpen {w : ℂ | w.re < 1 + 1 / 4} := isOpen_lt Complex.continuous_re continuous_const
        exact h1.inter (h2.inter h3)
      have hre : ∀ w ∈ S, 15 / 16 ≤ (1 + w ^ 2).re := by
        intro w hw
        obtain ⟨h1, h2, h3⟩ := hw
        have : (1 + w ^ 2).re = 1 + w.re ^ 2 - w.im ^ 2 := by
          simp [sq, Complex.add_re, Complex.mul_re]; ring
        rw [this]
        have := abs_lt.mp h1
        nlinarith [sq_nonneg w.re]
      have hnw : ∀ w ∈ S, ‖w‖ ≤ 3 / 2 := by
        intro w hw
        obtain ⟨h1, h2, h3⟩ := hw
        have := Complex.norm_le_abs_re_add_abs_im w
        have : |w.re| < 5 / 4 := abs_lt.mpr ⟨by linarith, by linarith⟩
        linarith
      have hnu : ∀ w ∈ S, 15 / 16 ≤ ‖1 + w ^ 2‖ := fun w hw =>
        le_trans (hre w hw) (Complex.re_le_norm _)
      have hslit : ∀ w ∈ S, 1 + w ^ 2 ∈ Complex.slitPlane := fun w hw =>
        Complex.mem_slitPlane_iff.mpr (Or.inl (by linarith [hre w hw]))
      have hexpb : ∀ w ∈ S, ∀ y,
          ‖Complex.exp (((-2 * ϑ y : ℝ) : ℂ) * Complex.log (1 + w ^ 2))‖ ≤ 3 := by
        intro w hw y
        rw [Complex.norm_exp, Complex.re_ofReal_mul, Complex.log_re]
        have hu := hnu w hw
        have hupos : 0 < ‖1 + w ^ 2‖ := by linarith
        have hl : -Real.log ‖1 + w ^ 2‖ ≤ 1 / 15 := by
          have := Real.log_le_sub_one_of_pos (inv_pos.mpr hupos)
          rw [Real.log_inv] at this
          have : ‖1 + w ^ 2‖⁻¹ ≤ 16 / 15 := by
            rw [inv_le_comm₀ hupos (by norm_num)]; linarith
          linarith
        have h1 := (hb2 y).1
        have h2 := (hb2 y).2
        have : -2 * ϑ y * Real.log ‖1 + w ^ 2‖ ≤ 1 := by nlinarith
        calc Real.exp (-2 * ϑ y * Real.log ‖1 + w ^ 2‖) ≤ Real.exp 1 := Real.exp_le_exp.mpr this
