theorem ax_prof_of_intrinsic : AxStressLocal → AxStressSmooth → AxDatumSmooth → ∀ (h Pst XR Xa Xan Xa1 Xa2 Xh1 aa : ℝ) (Pax : ℝ → ℝ) (Fi Ui : ℝ → ℝ → ℝ), AxDatum h Pst Pax → AxProfI h Pst XR Xa Xan Xa1 Xa2 Xh1 aa Pax Fi Ui → AxProf h Pst XR Xa Xan Xa1 Xa2 Xh1 aa Pax Fi Ui :=
by
  intro hL hS hSm h Pst XR Xa Xan Xa1 Xa2 Xh1 aa Pax Fi Ui hD hI
  obtain ⟨hA0, hA1, hA2, hA3, hA4, hvan, hadm, μ, hμ, hcone⟩ := hI
  refine ⟨hA0, hA1, hA2, hA3, hA4, ?_⟩
  obtain ⟨hXR, -, hXa, h1, h2, h3, h4, h5⟩ := hA0
  have he5 : Real.exp (-5) < 1 := Real.exp_lt_one_iff.mpr (by norm_num)
  have hXRe : XR * Real.exp (-5) < XR := mul_lt_of_lt_one_right hXR he5
  intro F U hagree hint
  have key : ∀ X η : ℝ, 0 < X → X < XR → -1 < η → η < 1 →
      F X η = Fi X η ∧ shearA F X η = shearA Fi X η ∧ shearB F U X η = shearB Fi Ui X η ∧
      leadStressTh h F U X η = leadStressTh h Fi Ui X η ∧
      leadStressTz h F U X η = axTz h Pax Fi Ui X η ∧
      psLead1 h F U X η = psLead1 h Fi Ui X η ∧ psLead2 h F U X η = axPs2 h Pax Fi Ui X η := by
    intro X η hX0 hXR' hη1 hη2
    obtain ⟨hQ, hN, hA, hB⟩ := hL.1 h XR Pax Fi Ui F U hagree X η hX0 hXR' hη1 hη2
    have hN2 := hL.2 h Pax F U hint X η hX0 hη1 hη2
    have hF := (hagree X η hX0 hXR' hη1 hη2).1
    refine ⟨hF, hA, hB, ?_, ?_, ?_, ?_⟩
    · unfold leadStressTh; rw [hQ, hA, hF]
    · unfold leadStressTz axTz axPs2; rw [hN2, hN, hB, hF]
    · unfold psLead1; rw [hQ]
    · unfold psLead2 axPs2; rw [hN2, hN, hF]
  have hNo : IsOpen (Ioo 0 XR ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioo.prod isOpen_Ioo
  have tr : ∀ (g₁ g₂ : ℝ × ℝ → ℝ), (∀ z ∈ Ioo 0 XR ×ˢ Ioo (-1:ℝ) 1, g₁ z = g₂ z) →
      ∀ (m : ℕ) (X η : ℝ), 0 < X → X < XR → -1 < η → η < 1 →
      iteratedFDeriv ℝ m g₁ (X, η) = iteratedFDeriv ℝ m g₂ (X, η) := by
    intro g₁ g₂ hg m X η a b c d
    have hp : ((X, η) : ℝ × ℝ) ∈ Ioo 0 XR ×ˢ Ioo (-1:ℝ) 1 := ⟨⟨a, b⟩, ⟨c, d⟩⟩
    exact ((Filter.eventuallyEq_of_mem (hNo.mem_nhds hp) hg).iteratedFDeriv ℝ m).eq_of_nhds
  have hTh : ∀ z ∈ Ioo 0 XR ×ˢ Ioo (-1:ℝ) 1,
      (↿(leadStressTh h F U)) z = (↿(leadStressTh h Fi Ui)) z := fun z hz =>
    (key z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).2.2.2.1
  have hTz : ∀ z ∈ Ioo 0 XR ×ˢ Ioo (-1:ℝ) 1,
      (↿(leadStressTz h F U)) z = (↿(axTz h Pax Fi Ui)) z := fun z hz =>
    (key z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).2.2.2.2.1
  have hR1 : ∀ z ∈ Ioo 0 XR ×ˢ Ioo (-1:ℝ) 1,
      (fun z : ℝ × ℝ => leadStressTh h F U z.1 z.2 /
          Real.sqrt (leadStressTh h F U z.1 z.2 ^ 2 + leadStressTz h F U z.1 z.2 ^ 2)) z =
      (fun z : ℝ × ℝ => leadStressTh h Fi Ui z.1 z.2 /
          Real.sqrt (leadStressTh h Fi Ui z.1 z.2 ^ 2 + axTz h Pax Fi Ui z.1 z.2 ^ 2)) z := by
    intro z hz
    obtain ⟨-, -, -, k4, k5, -, -⟩ := key z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2
    simp only [k4, k5]
  have hR2 : ∀ z ∈ Ioo 0 XR ×ˢ Ioo (-1:ℝ) 1,
      (fun z : ℝ × ℝ => leadStressTz h F U z.1 z.2 /
          Real.sqrt (leadStressTh h F U z.1 z.2 ^ 2 + leadStressTz h F U z.1 z.2 ^ 2)) z =
      (fun z : ℝ × ℝ => axTz h Pax Fi Ui z.1 z.2 /
          Real.sqrt (leadStressTh h Fi Ui z.1 z.2 ^ 2 + axTz h Pax Fi Ui z.1 z.2 ^ 2)) z := by
    intro z hz
    obtain ⟨-, -, -, k4, k5, -, -⟩ := key z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2
    simp only [k4, k5]
  obtain ⟨ε, hε, hFs, hUs, hpos, -⟩ := hA1
  obtain ⟨ρ, hρ, hP⟩ := hSm h Pst Pax hD
  have hPax : ContDiffOn ℝ ∞ Pax (Ioo (-1) 1) :=
    hP.mono (Set.Ioo_subset_Ioo (by linarith) (by linarith))
  obtain ⟨hSTh, hSTz⟩ := hS h ε Pax Fi Ui hD.1 (by linarith [hD.2.1]) hε hFs hUs hpos hPax
  have hsub : Ioo 0 XR ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi 0 ×ˢ Ioo (-1) 1 :=
    Set.prod_mono Set.Ioo_subset_Ioi_self subset_rfl
  refine ⟨?_, (hSTh.mono hsub).congr hTh, (hSTz.mono hsub).congr hTz, ?_, μ, hμ, ?_⟩
  · intro X η hX0 hXa' hη1 hη2
    obtain ⟨-, -, -, k4, k5, -, -⟩ := key X η hX0 (by linarith) hη1 hη2
    rw [k4, k5]
