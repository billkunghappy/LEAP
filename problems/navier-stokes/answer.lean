  have kG1 : ∀ Y : ℝ, 0 < Y → Y ≤ X → ‖cKer bgkG ψ1 Y w‖ ≤ E / 2 := fun Y hY hYX =>
    (hker Q0 _ Y bgkG _ ψ1 hY (lt_of_le_of_lt hYX hXXi) hpG hLi hLμ hv1).trans (ar1 Y hY hYX)
  have kGd1 : ∀ Y : ℝ, 0 < Y → Y ≤ X → ‖cKer bgkG (cDw ψ1) Y w‖ ≤ 3 * E := fun Y hY hYX =>
    (hker _ _ Y bgkG _ (cDw ψ1) hY (lt_of_le_of_lt hYX hXXi) hpG hLi hLμ hd1).trans (ar2 Y hY hYX)
  have kGp1 : ‖cKer bgkGp ψ1 X w‖ ≤ E / 2 :=
    (hker Q0 _ X bgkGp _ ψ1 hX0 hXXi hpGp hCi hCμ hv1).trans ar3
  have kU2 : ‖cKer bgkU ψ2 X w‖ ≤ E / 2 :=
    (hker Q0 _ X bgkU _ ψ2 hX0 hXXi hpU hLi hLμ hv2).trans (ar1 X hX0 le_rfl)
  have kS2 : ‖cKer bgkS ψ2 X w‖ ≤ E / 2 :=
    (hker Q0 _ X bgkS _ ψ2 hX0 hXXi hpS hLi hLμ hv2).trans (ar1 X hX0 le_rfl)
  have kUp2 : ‖cKer bgkUp ψ2 X w‖ ≤ E / 2 :=
    (hker Q0 _ X bgkUp _ ψ2 hX0 hXXi hpUp hCi hCμ hv2).trans ar3
  have kUd2 : ‖cKer bgkU (cDw ψ2) X w‖ ≤ 3 * E :=
    (hker _ _ X bgkU _ (cDw ψ2) hX0 hXXi hpU hLi hLμ hd2).trans (ar2 X hX0 le_rfl)
  have kSd2 : ‖cKer bgkS (cDw ψ2) X w‖ ≤ 3 * E :=
    (hker _ _ X bgkS _ (cDw ψ2) hX0 hXXi hpS hLi hLμ hd2).trans (ar2 X hX0 le_rfl)

  have hrad : ∀ (h : ℝ → ℂ → ℂ) (B : ℝ), (∀ y : ℝ, 0 < y → y ≤ X → ‖h y w‖ ≤ B) →
      ‖cRad h X w‖ ≤ B * X := by
    intro h B hB
    unfold cRad
    have := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := X)
      (f := fun x => h x w) (C := B) (fun x hx => by
        rw [Set.uIoc_of_le hX0.le] at hx
        exact hB x hx.1 hx.2)
    rw [sub_zero, abs_of_pos hX0] at this
    exact this

  have hR : 8 * (1 + A₁) ^ 2 * (1 + Xi) * K * X ^ (m + 1) / (((m : ℝ) + 1) * (σ₀ - s) ^ (m + 1)) =
      8 * (1 + A₁) ^ 2 * (1 + Xi) * E := by
    rw [hE, hQ1]
    have hDp : (σ₀ - s) ^ (m + 1) ≠ 0 := (pow_pos hD _).ne'
    have hnp : (m : ℝ) + 1 ≠ 0 := hn0.ne'
    (field_simp) <;> ring
  rw [hR]
  have hpm : ∀ (a b : ℂ) (B : ℝ), ‖a‖ ≤ A₁ → ‖b‖ ≤ B → ‖a * b‖ ≤ A₁ * B := fun a b B ha hb =>
    (norm_mul_le _ _).trans (mul_le_mul ha hb (norm_nonneg _) hA₁)
  have hA : ∀ {a b : ℂ} {x y : ℝ}, ‖a‖ ≤ x → ‖b‖ ≤ y → ‖a + b‖ ≤ x + y := fun h1 h2 =>
    (norm_add_le _ _).trans (add_le_add h1 h2)
  have hac' : ∀ i, ‖ac i X w‖ ≤ A₁ := fun i => hac i X w hX0 hXXi hw'
  have hbc' : ∀ i, ‖bc i X w‖ ≤ A₁ := fun i => hbc i X w hX0 hXXi hw'
  constructor
  · unfold bgT1
    have p0 := hpm _ _ _ (hac' 0) (kG1 X hX0 le_rfl)
    have p1 := hpm _ _ _ (hac' 1) kGp1
    have p2 := hpm _ _ _ (hac' 2) (kGd1 X hX0 le_rfl)
    have p3 := hpm _ _ _ (hac' 3) kU2
    have p4 := hpm _ _ _ (hac' 4) kS2
    have p5 := hpm _ _ _ (hac' 5) kSd2
    refine (hA (hA (hA (hA (hA p0 p1) p2) p3) p4) p5).trans ?_
    nlinarith [mul_nonneg hA₁ hE0, mul_nonneg (sq_nonneg A₁) hE0, mul_nonneg hXi.le hE0,
      mul_nonneg (mul_nonneg hA₁ hXi.le) hE0, mul_nonneg (mul_nonneg (sq_nonneg A₁) hXi.le) hE0]
  · unfold bgT2
    have p0 := hpm _ _ _ (hbc' 0) kU2
    have p1 := hpm _ _ _ (hbc' 1) kUp2
    have p2 := hpm _ _ _ (hbc' 2) kUd2
    have p3 := hpm _ _ _ (hbc' 3) kS2
    have p4 := hpm _ _ _ (hbc' 4) kSd2
    have r5 : ‖cRad (fun x z => gc x z * cKer bgkG ψ1 x z) X w‖ ≤ A₁ * (E / 2) * X :=
      hrad _ _ (fun y hy0 hyX => by
        show ‖gc y w * cKer bgkG ψ1 y w‖ ≤ _
        exact hpm _ _ _ (hgc y w hy0 (lt_of_le_of_lt hyX hXXi) hw').1 (kG1 y hy0 hyX))
    have r6 : ‖cRad (fun x z => cDw gc x z * cKer bgkG ψ1 x z + gc x z * cKer bgkG (cDw ψ1) x z) X w‖
        ≤ (A₁ * (E / 2) + A₁ * (3 * E)) * X :=
      hrad _ _ (fun y hy0 hyX => by
        show ‖cDw gc y w * cKer bgkG ψ1 y w + gc y w * cKer bgkG (cDw ψ1) y w‖ ≤ _
        have hg := hgc y w hy0 (lt_of_le_of_lt hyX hXXi) hw'
        exact hA (hpm _ _ _ hg.2 (kG1 y hy0 hyX)) (hpm _ _ _ hg.1 (kGd1 y hy0 hyX)))
    have hXn : ‖((X : ℝ) : ℂ)‖ = X := by rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hX0]
    have r7 : ‖((X : ℝ) : ℂ) * (gc X w * cKer bgkG ψ1 X w)‖ ≤ X * (A₁ * (E / 2)) := by
      refine (norm_mul_le _ _).trans ?_
      rw [hXn]
      exact mul_le_mul_of_nonneg_left (hpm _ _ _ (hgc X w hX0 hXXi hw').1 (kG1 X hX0 le_rfl)) hX0.le
    have p5 := hpm _ _ _ (hbc' 5) r5
    have p6 := hpm _ _ _ (hbc' 6) r6
    have p7 := hpm _ _ _ (hbc' 7) r7
    refine (hA (hA (hA (hA (hA (hA (hA p0 p1) p2) p3) p4) p5) p6) p7).trans ?_
    have hXE : A₁ ^ 2 * X * E ≤ A₁ ^ 2 * Xi * E :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hXXi.le (sq_nonneg _)) hE0
    nlinarith [mul_nonneg hA₁ hE0, mul_nonneg (sq_nonneg A₁) hE0, mul_nonneg hXi.le hE0,
      mul_nonneg (mul_nonneg hA₁ hXi.le) hE0, mul_nonneg (mul_nonneg (sq_nonneg A₁) hXi.le) hE0]

theorem bgT_real : ∀ (Xi ρ : ℝ) (ac : Fin 6 → ℝ → ℂ → ℂ) (bc : Fin 8 → ℝ → ℂ → ℂ) (gc ψ1 ψ2 : ℝ → ℂ → ℂ), 0 < ρ → (∀ i, CReal Xi (ac i)) → (∀ i, CReal Xi (bc i)) → CReal Xi gc → CReal Xi ψ1 → CReal Xi ψ2 → (∀ X, 0 < X → X < Xi → DifferentiableOn ℂ (gc X) (cStrip ρ)) → (∀ X, 0 < X → X < Xi → DifferentiableOn ℂ (ψ1 X) (cStrip ρ)) → (∀ X, 0 < X → X < Xi → DifferentiableOn ℂ (ψ2 X) (cStrip ρ)) → CReal Xi (bgT1 ac ψ1 ψ2) ∧ CReal Xi (bgT2 bc gc ψ1 ψ2) :=
by
  intro Xi ρ ac bc gc ψ1 ψ2 hρ hRa hRb hRg hR1 hR2 hdg hd1 hd2
  have hIntIm : ∀ (f : ℝ → ℂ) (a b : ℝ), a ≤ b → (∀ t ∈ Ioo a b, (f t).im = 0) →
      (∫ t in a..b, f t).im = 0 := by
    intro f a b hab hf
    have hcongr : ∫ t in Ioo a b, f t = ∫ t in Ioo a b, (((f t).re : ℝ) : ℂ) := by
      refine setIntegral_congr_fun measurableSet_Ioo (fun t ht => ?_)
      apply Complex.ext
      · simp
      · simp [hf t ht]
    rw [intervalIntegral.integral_of_le hab, integral_Ioc_eq_integral_Ioo, hcongr]
    rw [integral_complex_ofReal]; exact Complex.ofReal_im _
  have hK : ∀ φ : ℝ → ℂ → ℂ, CReal Xi φ → ∀ kk : ℝ → ℝ, CReal Xi (cKer kk φ) := by
    intro φ hφ kk X η h0 h1 e1 e2
    show ((X : ℂ) * ∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * φ (t * X) (η : ℂ)).im = 0
    have hI : (∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * φ (t * X) (η : ℂ)).im = 0 := by
      apply hIntIm _ 0 1 zero_le_one
      intro t ht
      have ht0 : 0 < t * X := mul_pos ht.1 h0
      have ht1 : t * X < Xi := by nlinarith [ht.2]
      rw [Complex.mul_im, hφ (t * X) η ht0 ht1 e1 e2, Complex.ofReal_im]
      ring
    rw [Complex.mul_im, hI, Complex.ofReal_im]
    ring
  have hRd : ∀ φ : ℝ → ℂ → ℂ, CReal Xi φ → CReal Xi (cRad φ) := by
    intro φ hφ X η h0 h1 e1 e2
    show (∫ x in (0:ℝ)..X, φ x (η : ℂ)).im = 0
    apply hIntIm _ 0 X h0.le
    intro t ht
    exact hφ t η ht.1 (lt_trans ht.2 h1) e1 e2
  have hopen : IsOpen (cStrip ρ) :=
    (isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).inter
      ((isOpen_lt continuous_const Complex.continuous_re).inter
        (isOpen_lt Complex.continuous_re continuous_const))
  have hD : ∀ φ : ℝ → ℂ → ℂ, CReal Xi φ →
      (∀ X, 0 < X → X < Xi → DifferentiableOn ℂ (φ X) (cStrip ρ)) → CReal Xi (cDw φ) := by
    intro φ hφ hdφ X η h0 h1 e1 e2
    show (deriv (φ X) (η : ℂ)).im = 0
    have hmem : (η : ℂ) ∈ cStrip ρ := by
      simp only [cStrip, Set.mem_setOf_eq, Complex.ofReal_im, Complex.ofReal_re, abs_zero]
      exact ⟨hρ, by linarith, by linarith⟩
    have hd : HasDerivAt (φ X) (deriv (φ X) (η : ℂ)) (η : ℂ) :=
      ((hdφ X h0 h1).differentiableAt (hopen.mem_nhds hmem)).hasDerivAt
    have hr : HasDerivAt (fun y : ℝ => φ X (y : ℂ)) (deriv (φ X) (η : ℂ)) η := hd.comp_ofReal
    have h2 := Complex.imCLM.hasFDerivAt.comp_hasDerivAt η hr
    have hev : (fun _ : ℝ => (0:ℝ)) =ᶠ[nhds η] (Complex.imCLM ∘ fun y : ℝ => φ X (y : ℂ)) := by
      filter_upwards [Ioo_mem_nhds e1 e2] with y hy
      simp [hφ X y h0 h1 hy.1 hy.2]
    have h3 := (h2.congr_of_eventuallyEq hev).unique (hasDerivAt_const η (0:ℝ))
    simpa using h3
  have D1 := hD ψ1 hR1 hd1
  have D2 := hD ψ2 hR2 hd2
  have Dg := hD gc hRg hdg
  have F5 : CReal Xi (fun x z => gc x z * cKer bgkG ψ1 x z) := by
    intro X η h0 h1 e1 e2
    simp only [Complex.mul_im, hRg X η h0 h1 e1 e2, hK ψ1 hR1 bgkG X η h0 h1 e1 e2, mul_zero,
      zero_mul, add_zero]
  have F6 : CReal Xi
      (fun x z => cDw gc x z * cKer bgkG ψ1 x z + gc x z * cKer bgkG (cDw ψ1) x z) := by
    intro X η h0 h1 e1 e2
    simp only [Complex.add_im, Complex.mul_im, hRg X η h0 h1 e1 e2, Dg X η h0 h1 e1 e2,
      hK ψ1 hR1 bgkG X η h0 h1 e1 e2, hK _ D1 bgkG X η h0 h1 e1 e2, mul_zero, zero_mul, add_zero]
  have R5 := hRd _ F5
  have R6 := hRd _ F6
  refine ⟨?_, ?_⟩
  · intro X η h0 h1 e1 e2
    simp only [bgT1, Complex.add_im, Complex.mul_im,
      hRa 0 X η h0 h1 e1 e2, hRa 1 X η h0 h1 e1 e2, hRa 2 X η h0 h1 e1 e2,
      hRa 3 X η h0 h1 e1 e2, hRa 4 X η h0 h1 e1 e2, hRa 5 X η h0 h1 e1 e2,
      hK ψ1 hR1 bgkG X η h0 h1 e1 e2, hK ψ1 hR1 bgkGp X η h0 h1 e1 e2,
      hK _ D1 bgkG X η h0 h1 e1 e2, hK ψ2 hR2 bgkU X η h0 h1 e1 e2,
      hK ψ2 hR2 bgkS X η h0 h1 e1 e2, hK _ D2 bgkS X η h0 h1 e1 e2,
      mul_zero, zero_mul, add_zero]
  · intro X η h0 h1 e1 e2
    simp only [bgT2, Complex.add_im, Complex.mul_im, Complex.ofReal_im,
      hRb 0 X η h0 h1 e1 e2, hRb 1 X η h0 h1 e1 e2, hRb 2 X η h0 h1 e1 e2,
      hRb 3 X η h0 h1 e1 e2, hRb 4 X η h0 h1 e1 e2, hRb 5 X η h0 h1 e1 e2,
      hRb 6 X η h0 h1 e1 e2, hRb 7 X η h0 h1 e1 e2, hRg X η h0 h1 e1 e2,
      hK ψ1 hR1 bgkG X η h0 h1 e1 e2,
      hK ψ2 hR2 bgkU X η h0 h1 e1 e2, hK ψ2 hR2 bgkUp X η h0 h1 e1 e2,
      hK _ D2 bgkU X η h0 h1 e1 e2, hK ψ2 hR2 bgkS X η h0 h1 e1 e2,
      hK _ D2 bgkS X η h0 h1 e1 e2,
      R5 X η h0 h1 e1 e2, R6 X η h0 h1 e1 e2,
      mul_zero, zero_mul, add_zero]

theorem bg_series_props : ∀ (Xi σ₀ M Λ : ℝ) (F : ℕ → ℝ → ℂ → ℂ), 0 < Xi → 0 < σ₀ → 0 ≤ M → 0 ≤ Λ → (∀ m, CReg Xi σ₀ (F m)) → (∀ (m : ℕ) (s X : ℝ) (w : ℂ), 0 < s → s < σ₀ → 0 < X → X < Xi → w ∈ cStrip s → ‖F m X w‖ ≤ M * Λ ^ m * X ^ m / ((m.factorial : ℝ) * (σ₀ - s) ^ m)) → ∃ u : ℕ → ℝ, Summable u ∧ (∀ (m : ℕ) (X : ℝ) (w : ℂ), 0 < X → X < Xi → w ∈ cStrip (σ₀ / 2) → ‖F m X w‖ ≤ u m) ∧ CB Xi (σ₀ / 2) (∑' m, u m) (fun X w => ∑' m, F m X w) :=
by
  intro Xi σ₀ M Λ F hXi hσ hM hΛ hreg hbd
  have hstrip : ∀ s t : ℝ, s ≤ t → cStrip s ⊆ cStrip t := by
    intro s t hst w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
  have hopen : ∀ ρ : ℝ, IsOpen (cStrip ρ) := by
    intro ρ
    have e : cStrip ρ = {w : ℂ | |w.im| < ρ} ∩ ({w : ℂ | -1 - ρ < w.re} ∩ {w : ℂ | w.re < 1 + ρ}) := by
      ext w; simp [cStrip]
    rw [e]
    exact (isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).inter
      ((isOpen_lt continuous_const Complex.continuous_re).inter
        (isOpen_lt Complex.continuous_re continuous_const))
  set c : ℝ := 2 * Λ * Xi / σ₀ with hc
  have hc0 : 0 ≤ c := by positivity
  set u : ℕ → ℝ := fun m => M * (c ^ m / (m.factorial : ℝ)) with hu
  have hus : Summable u := (Real.summable_pow_div_factorial c).mul_left M
  have hσ2 : (0 : ℝ) < σ₀ / 2 := by linarith
  have hσ2' : σ₀ / 2 < σ₀ := by linarith
  have hub : ∀ (m : ℕ) (X : ℝ) (w : ℂ), 0 < X → X < Xi → w ∈ cStrip (σ₀ / 2) → ‖F m X w‖ ≤ u m := by
    intro m X w h0 h1 hw
    have h := hbd m (σ₀ / 2) X w hσ2 hσ2' h0 h1 hw
    have e1 : σ₀ - σ₀ / 2 = σ₀ / 2 := by ring
    rw [e1] at h
    have hf : (0 : ℝ) < (m.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos m
    have hden : 0 < (m.factorial : ℝ) * (σ₀ / 2) ^ m := by positivity
    have h2 : M * Λ ^ m * X ^ m / ((m.factorial : ℝ) * (σ₀ / 2) ^ m) ≤
        M * Λ ^ m * Xi ^ m / ((m.factorial : ℝ) * (σ₀ / 2) ^ m) := by
      apply div_le_div_of_nonneg_right _ hden.le
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      exact pow_le_pow_left₀ h0.le h1.le m
    have e2 : M * Λ ^ m * Xi ^ m / ((m.factorial : ℝ) * (σ₀ / 2) ^ m) = u m := by
      simp only [hu, hc]
      rw [div_pow, div_pow, mul_pow, mul_pow]
      field_simp
    linarith
  refine ⟨u, hus, hub, ?_, ?_, ?_⟩
  · apply continuousOn_tsum (u := u)
    · intro i
      exact (hreg i).1.mono (Set.prod_mono subset_rfl (hstrip _ _ hσ2'.le))
    · exact hus
    · intro n p hp
      exact hub n p.1 p.2 hp.1.1 hp.1.2 hp.2
  · intro X h0 h1
    exact Complex.differentiableOn_tsum_of_summable_norm hus
      (fun i => ((hreg i).2.1 X h0 h1).mono (hstrip _ _ hσ2'.le)) (hopen _)
      (fun i w hw => hub i X w h0 h1 hw)
  · intro X w h0 h1 hw
    exact tsum_of_norm_bounded hus.hasSum (fun m => hub m X w h0 h1 hw)

theorem bgT_hasSum : ∀ (Xi s₁ A₁ : ℝ) (ac : Fin 6 → ℝ → ℂ → ℂ) (bc : Fin 8 → ℝ → ℂ → ℂ) (gc : ℝ → ℂ → ℂ) (F1 F2 : ℕ → ℝ → ℂ → ℂ) (u : ℕ → ℝ), 0 < Xi → 0 < s₁ → Summable u → (∀ i, CB Xi s₁ A₁ (ac i)) → (∀ i, CB Xi s₁ A₁ (bc i)) → CB Xi s₁ A₁ gc → CB Xi s₁ A₁ (cDw gc) → (∀ m, CReg Xi s₁ (F1 m) ∧ CReg Xi s₁ (F2 m) ∧ CReg Xi s₁ (cDw (F1 m)) ∧ CReg Xi s₁ (cDw (F2 m)) ∧ CReg Xi s₁ (cKer bgkG (F1 m)) ∧ CReg Xi s₁ (cKer bgkG (cDw (F1 m)))) → (∀ (m : ℕ) (X : ℝ) (w : ℂ), 0 < X → X < Xi → w ∈ cStrip s₁ → ‖F1 m X w‖ ≤ u m ∧ ‖F2 m X w‖ ≤ u m) → ∀ (X : ℝ) (w : ℂ), 0 < X → X < Xi → w ∈ cStrip (s₁ / 2) → HasSum (fun m => bgT1 ac (F1 m) (F2 m) X w) (bgT1 ac (fun Y z => ∑' m, F1 m Y z) (fun Y z => ∑' m, F2 m Y z) X w) ∧ HasSum (fun m => bgT2 bc gc (F1 m) (F2 m) X w) (bgT2 bc gc (fun Y z => ∑' m, F1 m Y z) (fun Y z => ∑' m, F2 m Y z) X w) :=
by
  intro Xi s₁ A₁ ac bc gc F1 F2 u hXi hs₁ hu hac hbc hgc hdgc hreg hb X w hX0 hXi' hw
  set ψ1 : ℝ → ℂ → ℂ := fun Y z => ∑' m, F1 m Y z with hψ1
  set ψ2 : ℝ → ℂ → ℂ := fun Y z => ∑' m, F2 m Y z with hψ2

  have hstripOpen : IsOpen (cStrip s₁) := by
    have e : cStrip s₁ = {z : ℂ | |z.im| < s₁} ∩ ({z : ℂ | -1 - s₁ < z.re} ∩ {z : ℂ | z.re < 1 + s₁}) := by
      ext z; simp only [cStrip, Set.mem_setOf_eq, Set.mem_inter_iff]
    rw [e]
    exact (isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).inter
      ((isOpen_lt continuous_const Complex.continuous_re).inter
        (isOpen_lt Complex.continuous_re continuous_const))
  have hw1 : w ∈ cStrip s₁ := by
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
  have hu0 : ∀ m, 0 ≤ u m := fun m => le_trans (norm_nonneg _) (hb m X w hX0 hXi' hw1).1
  have hA : 0 ≤ A₁ := le_trans (norm_nonneg _) (hgc.2.2 X w hX0 hXi' hw1)
  have h2s : 0 ≤ 2 / s₁ := div_nonneg (by norm_num) hs₁.le

  have hball : ∀ z ∈ cStrip (s₁ / 2), Metric.closedBall z (s₁ / 2) ⊆ cStrip s₁ := by
    intro z hz z' hz'
    rw [Metric.mem_closedBall, dist_eq_norm] at hz'
    have h1 : |(z' - z).im| ≤ ‖z' - z‖ := Complex.abs_im_le_norm _
    have h2 : |(z' - z).re| ≤ ‖z' - z‖ := Complex.abs_re_le_norm _
    rw [Complex.sub_im] at h1
    rw [Complex.sub_re] at h2
    have h3 := abs_sub_abs_le_abs_sub z'.im z.im
    have h4 := abs_le.mp (h2.trans hz')
    simp only [cStrip, Set.mem_setOf_eq] at hz ⊢
    obtain ⟨a1, a2, a3⟩ := hz
    exact ⟨by linarith, by linarith [h4.1], by linarith [h4.2]⟩
  have hder : ∀ (f : ℂ → ℂ) (K : ℝ), DifferentiableOn ℂ f (cStrip s₁) →
      (∀ z ∈ cStrip s₁, ‖f z‖ ≤ K) → ∀ z ∈ cStrip (s₁ / 2), ‖deriv f z‖ ≤ 2 / s₁ * K := by
    intro f K hf hK z hz
    have hr : (0:ℝ) < s₁ / 2 := by linarith
    have hd : DiffContOnCl ℂ f (Metric.ball z (s₁ / 2)) := by
      apply DifferentiableOn.diffContOnCl
      rw [closure_ball z hr.ne']
      exact hf.mono (hball z hz)
    have key := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr hd
      (fun z' hz' => hK z' (hball z hz (Metric.sphere_subset_closedBall hz')))
    calc ‖deriv f z‖ ≤ K / (s₁ / 2) := key
      _ = 2 / s₁ * K := by rw [div_div_eq_mul_div]; ring

  have SC : ∀ φ : ℝ → ℂ → ℂ, ContinuousOn (fun p : ℝ × ℂ => φ p.1 p.2) (Ioo 0 Xi ×ˢ cStrip s₁) →
      ContinuousOn (fun Y => φ Y w) (Ioo 0 Xi) := by
    intro φ hφ
    exact hφ.comp (continuous_id.prodMk continuous_const).continuousOn (fun Y hY => ⟨hY, hw1⟩)

  have hKer : ∀ (kk : ℝ → ℝ) (G : ℕ → ℝ → ℂ → ℂ) (g : ℝ → ℂ → ℂ) (v : ℕ → ℝ) (x : ℝ),
      ContinuousOn kk (Ioc 0 1) → IntervalIntegrable kk MeasureTheory.volume 0 1 → Summable v →
      0 < x → x < Xi → (∀ m, ContinuousOn (fun Y => G m Y w) (Ioo 0 Xi)) →
      (∀ (m : ℕ) (Y : ℝ), 0 < Y → Y < Xi → ‖G m Y w‖ ≤ v m) →
      (∀ Y : ℝ, 0 < Y → Y < Xi → HasSum (fun m => G m Y w) (g Y w)) →
      HasSum (fun m => cKer kk (G m) x w) (cKer kk g x w) := by
    intro kk G g v x hkk hki hv hx0 hx1 hG hGb hlim
    have hmaps : ∀ t ∈ Ioc (0:ℝ) 1, t * x ∈ Ioo 0 Xi := by
      intro t ht
      exact ⟨mul_pos ht.1 hx0, lt_of_le_of_lt (mul_le_of_le_one_left hx0.le ht.2) hx1⟩
    have huIoc : uIoc (0:ℝ) 1 = Ioc 0 1 := uIoc_of_le zero_le_one
    have key : HasSum (fun m => ∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * G m (t * x) w)
        (∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * g (t * x) w) := by
      refine intervalIntegral.hasSum_integral_of_dominated_convergence
        (F := fun m t => ((kk t : ℝ) : ℂ) * G m (t * x) w)
        (f := fun t => ((kk t : ℝ) : ℂ) * g (t * x) w)
        (fun m t => |kk t| * v m) ?_ ?_ ?_ ?_ ?_
      · intro m
        rw [huIoc]
        have h1 : ContinuousOn (fun t : ℝ => ((kk t : ℝ) : ℂ)) (Ioc 0 1) :=
          Complex.continuous_ofReal.comp_continuousOn hkk
        have h2 : ContinuousOn (fun t : ℝ => G m (t * x) w) (Ioc 0 1) :=
          (hG m).comp (continuous_id.mul continuous_const).continuousOn hmaps
        exact (h1.mul h2).aestronglyMeasurable measurableSet_Ioc
      · intro m
        refine MeasureTheory.ae_of_all _ (fun t ht => ?_)
        rw [huIoc] at ht
        show ‖((kk t : ℝ) : ℂ) * G m (t * x) w‖ ≤ |kk t| * v m
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
        exact mul_le_mul_of_nonneg_left (hGb m _ (hmaps t ht).1 (hmaps t ht).2) (abs_nonneg _)
      · exact MeasureTheory.ae_of_all _ (fun t _ => hv.mul_left _)
      · have e : (fun t => ∑' m, |kk t| * v m) = fun t => |kk t| * ∑' m, v m := by
          funext t; exact tsum_mul_left
        rw [e]
        exact hki.abs.mul_const _
      · refine MeasureTheory.ae_of_all _ (fun t ht => ?_)
        rw [huIoc] at ht
        exact (hlim _ (hmaps t ht).1 (hmaps t ht).2).mul_left _
    exact key.mul_left ((x : ℝ) : ℂ)

  have hRad : ∀ (H : ℕ → ℝ → ℂ → ℂ) (hh : ℝ → ℂ → ℂ) (v : ℕ → ℝ),
      Summable v → (∀ m, ContinuousOn (fun x => H m x w) (Ioo 0 Xi)) →
      (∀ (m : ℕ) (x : ℝ), 0 < x → x < Xi → ‖H m x w‖ ≤ v m) →
      (∀ x : ℝ, 0 < x → x < Xi → HasSum (fun m => H m x w) (hh x w)) →
      HasSum (fun m => cRad (H m) X w) (cRad hh X w) := by
    intro H hh v hv hH hHb hlim
    have hsub : Ioc (0:ℝ) X ⊆ Ioo 0 Xi := fun x hx => ⟨hx.1, lt_of_le_of_lt hx.2 hXi'⟩
    have huIoc : uIoc (0:ℝ) X = Ioc 0 X := uIoc_of_le hX0.le
    exact intervalIntegral.hasSum_integral_of_dominated_convergence
      (F := fun m x => H m x w) (f := fun x => hh x w) (fun m _ => v m)
      (fun m => by
        rw [huIoc]; exact ((hH m).mono hsub).aestronglyMeasurable measurableSet_Ioc)
      (fun m => MeasureTheory.ae_of_all _ (fun x hx => by
        rw [huIoc] at hx; exact hHb m x (hsub hx).1 (hsub hx).2))
      (MeasureTheory.ae_of_all _ (fun _ _ => hv))
      intervalIntegrable_const
      (MeasureTheory.ae_of_all _ (fun x hx => by
        rw [huIoc] at hx; exact hlim x (hsub hx).1 (hsub hx).2))

  have hKerNorm : ∀ (kk : ℝ → ℝ) (G : ℝ → ℂ → ℂ) (κ v x : ℝ), 0 < x → x < Xi →
      (∀ t : ℝ, 0 < t → t ≤ 1 → |kk t| ≤ κ) → (∀ Y : ℝ, 0 < Y → Y < Xi → ‖G Y w‖ ≤ v) →
      ‖cKer kk G x w‖ ≤ x * (κ * v) := by
    intro kk G κ v x hx0 hx1 hk hG
    have hκ : 0 ≤ κ := le_trans (abs_nonneg _) (hk 1 one_pos le_rfl)
    have hint : ‖∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * G (t * x) w‖ ≤ κ * v * |(1:ℝ) - 0| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro t ht
      rw [uIoc_of_le zero_le_one] at ht
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
      have hY0 : 0 < t * x := mul_pos ht.1 hx0
      have hY1 : t * x < Xi := lt_of_le_of_lt (mul_le_of_le_one_left hx0.le ht.2) hx1
      exact mul_le_mul (hk t ht.1 ht.2) (hG _ hY0 hY1) (norm_nonneg _) hκ
    simp only [sub_zero, abs_one, mul_one] at hint
    show ‖((x : ℝ) : ℂ) * ∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * G (t * x) w‖ ≤ x * (κ * v)
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hx0]
    exact mul_le_mul_of_nonneg_left hint hx0.le

  have hlogC : ContinuousOn Real.log (Ioc (0:ℝ) 1) :=
    Real.continuousOn_log.mono (fun t ht => by
      simp only [Set.mem_compl_iff, Set.mem_singleton_iff]; exact ne_of_gt ht.1)
  have kG : ContinuousOn bgkG (Ioc 0 1) ∧ IntervalIntegrable bgkG MeasureTheory.volume 0 1 := by
    have hc : Continuous bgkG := by unfold bgkG; fun_prop
    exact ⟨hc.continuousOn, hc.intervalIntegrable 0 1⟩
  have kGp : ContinuousOn bgkGp (Ioc 0 1) ∧ IntervalIntegrable bgkGp MeasureTheory.volume 0 1 := by
    have hc : Continuous bgkGp := by unfold bgkGp; fun_prop
    exact ⟨hc.continuousOn, hc.intervalIntegrable 0 1⟩
  have kUp : ContinuousOn bgkUp (Ioc 0 1) ∧ IntervalIntegrable bgkUp MeasureTheory.volume 0 1 := by
    have hc : Continuous bgkUp := by unfold bgkUp; fun_prop
    exact ⟨hc.continuousOn, hc.intervalIntegrable 0 1⟩
  have kU : ContinuousOn bgkU (Ioc 0 1) ∧ IntervalIntegrable bgkU MeasureTheory.volume 0 1 := by
    refine ⟨?_, ?_⟩
    · show ContinuousOn (fun t => -Real.log t / 2) (Ioc 0 1)
      exact hlogC.neg.div_const 2
    · show IntervalIntegrable (fun t => -Real.log t / 2) MeasureTheory.volume 0 1
      exact (intervalIntegral.intervalIntegrable_log'.neg).div_const 2
  have kS : ContinuousOn bgkS (Ioc 0 1) ∧ IntervalIntegrable bgkS MeasureTheory.volume 0 1 := by
    have hc1 : Continuous (fun t : ℝ => t - 1) := by fun_prop
    refine ⟨?_, ?_⟩
    · show ContinuousOn (fun t => (t - 1 - Real.log t) / 2) (Ioc 0 1)
      exact (hc1.continuousOn.sub hlogC).div_const 2
    · show IntervalIntegrable (fun t => (t - 1 - Real.log t) / 2) MeasureTheory.volume 0 1
      exact ((hc1.intervalIntegrable 0 1).sub intervalIntegral.intervalIntegrable_log').div_const 2
  have kGb : ∀ t : ℝ, 0 < t → t ≤ 1 → |bgkG t| ≤ 1 / 2 := by
    intro t ht0 ht1
    show |(1 - t) / 2| ≤ 1 / 2
    rw [abs_le]; constructor <;> linarith

  have P1 : ∀ Y z, 0 < Y → Y < Xi → z ∈ cStrip s₁ → HasSum (fun m => F1 m Y z) (ψ1 Y z) :=
    fun Y z a b c => (Summable.of_norm_bounded hu (fun m => (hb m Y z a b c).1)).hasSum
  have P2 : ∀ Y z, 0 < Y → Y < Xi → z ∈ cStrip s₁ → HasSum (fun m => F2 m Y z) (ψ2 Y z) :=
    fun Y z a b c => (Summable.of_norm_bounded hu (fun m => (hb m Y z a b c).2)).hasSum
  have D1 : ∀ Y z, 0 < Y → Y < Xi → z ∈ cStrip s₁ →
      HasSum (fun m => cDw (F1 m) Y z) (cDw ψ1 Y z) := by
    intro Y z a b c
    have := Complex.hasSum_deriv_of_summable_norm (F := fun m => F1 m Y) (U := cStrip s₁) hu
      (fun m => (hreg m).1.2.1 Y a b) hstripOpen (fun m z' hz' => (hb m Y z' a b hz').1) c
    exact this
  have D2 : ∀ Y z, 0 < Y → Y < Xi → z ∈ cStrip s₁ →
      HasSum (fun m => cDw (F2 m) Y z) (cDw ψ2 Y z) := by
    intro Y z a b c
    have := Complex.hasSum_deriv_of_summable_norm (F := fun m => F2 m Y) (U := cStrip s₁) hu
      (fun m => (hreg m).2.1.2.1 Y a b) hstripOpen (fun m z' hz' => (hb m Y z' a b hz').2) c
    exact this
  have DB1 : ∀ m Y, 0 < Y → Y < Xi → ‖cDw (F1 m) Y w‖ ≤ 2 / s₁ * u m :=
    fun m Y a b => hder (F1 m Y) (u m) ((hreg m).1.2.1 Y a b) (fun z hz => (hb m Y z a b hz).1) w hw
  have DB2 : ∀ m Y, 0 < Y → Y < Xi → ‖cDw (F2 m) Y w‖ ≤ 2 / s₁ * u m :=
    fun m Y a b => hder (F2 m Y) (u m) ((hreg m).2.1.2.1 Y a b) (fun z hz => (hb m Y z a b hz).2) w hw

  have K1 : ∀ kk : ℝ → ℝ, ContinuousOn kk (Ioc 0 1) ∧ IntervalIntegrable kk MeasureTheory.volume 0 1 →
      ∀ x, 0 < x → x < Xi → HasSum (fun m => cKer kk (F1 m) x w) (cKer kk ψ1 x w) :=
    fun kk hk x a b => hKer kk F1 ψ1 u x hk.1 hk.2 hu a b (fun m => SC _ (hreg m).1.1)
      (fun m Y c d => (hb m Y w c d hw1).1) (fun Y c d => P1 Y w c d hw1)
  have K2 : ∀ kk : ℝ → ℝ, ContinuousOn kk (Ioc 0 1) ∧ IntervalIntegrable kk MeasureTheory.volume 0 1 →
      ∀ x, 0 < x → x < Xi → HasSum (fun m => cKer kk (F2 m) x w) (cKer kk ψ2 x w) :=
    fun kk hk x a b => hKer kk F2 ψ2 u x hk.1 hk.2 hu a b (fun m => SC _ (hreg m).2.1.1)
      (fun m Y c d => (hb m Y w c d hw1).2) (fun Y c d => P2 Y w c d hw1)
  have K3 : ∀ kk : ℝ → ℝ, ContinuousOn kk (Ioc 0 1) ∧ IntervalIntegrable kk MeasureTheory.volume 0 1 →
      ∀ x, 0 < x → x < Xi → HasSum (fun m => cKer kk (cDw (F1 m)) x w) (cKer kk (cDw ψ1) x w) :=
    fun kk hk x a b => hKer kk (fun m => cDw (F1 m)) (cDw ψ1) (fun m => 2 / s₁ * u m) x hk.1 hk.2
      (hu.mul_left _) a b (fun m => SC _ (hreg m).2.2.1.1)
      (fun m Y c d => DB1 m Y c d) (fun Y c d => D1 Y w c d hw1)
  have K4 : ∀ kk : ℝ → ℝ, ContinuousOn kk (Ioc 0 1) ∧ IntervalIntegrable kk MeasureTheory.volume 0 1 →
      ∀ x, 0 < x → x < Xi → HasSum (fun m => cKer kk (cDw (F2 m)) x w) (cKer kk (cDw ψ2) x w) :=
    fun kk hk x a b => hKer kk (fun m => cDw (F2 m)) (cDw ψ2) (fun m => 2 / s₁ * u m) x hk.1 hk.2
      (hu.mul_left _) a b (fun m => SC _ (hreg m).2.2.2.1.1)
      (fun m Y c d => DB2 m Y c d) (fun Y c d => D2 Y w c d hw1)

  have R5 : HasSum (fun m => cRad (fun x z => gc x z * cKer bgkG (F1 m) x z) X w)
      (cRad (fun x z => gc x z * cKer bgkG ψ1 x z) X w) := by
    refine hRad (fun m x z => gc x z * cKer bgkG (F1 m) x z) (fun x z => gc x z * cKer bgkG ψ1 x z)
      (fun m => A₁ * (Xi * (1 / 2 * u m))) (((hu.mul_left _).mul_left _).mul_left _) ?_ ?_ ?_
    · intro m
      exact (SC _ hgc.1).mul (SC _ (hreg m).2.2.2.2.1.1)
    · intro m x a b
      have h1 := hgc.2.2 x w a b hw1
      have h2 := hKerNorm bgkG (F1 m) (1 / 2) (u m) x a b kGb (fun Y c d => (hb m Y w c d hw1).1)
      have h3 : x * (1 / 2 * u m) ≤ Xi * (1 / 2 * u m) :=
        mul_le_mul_of_nonneg_right b.le (mul_nonneg (by norm_num) (hu0 m))
      show ‖gc x w * cKer bgkG (F1 m) x w‖ ≤ A₁ * (Xi * (1 / 2 * u m))
      rw [norm_mul]
      exact mul_le_mul h1 (h2.trans h3) (norm_nonneg _) hA
    · intro x a b
      exact (K1 bgkG kG x a b).mul_left (gc x w)
  have R6 : HasSum (fun m => cRad (fun x z => cDw gc x z * cKer bgkG (F1 m) x z +
        gc x z * cKer bgkG (cDw (F1 m)) x z) X w)
      (cRad (fun x z => cDw gc x z * cKer bgkG ψ1 x z + gc x z * cKer bgkG (cDw ψ1) x z) X w) := by
    refine hRad (fun m x z => cDw gc x z * cKer bgkG (F1 m) x z + gc x z * cKer bgkG (cDw (F1 m)) x z)
      (fun x z => cDw gc x z * cKer bgkG ψ1 x z + gc x z * cKer bgkG (cDw ψ1) x z)
      (fun m => A₁ * (Xi * (1 / 2 * u m)) + A₁ * (Xi * (1 / 2 * (2 / s₁ * u m))))
      ((((hu.mul_left _).mul_left _).mul_left _).add
        ((((hu.mul_left _).mul_left _).mul_left _).mul_left _)) ?_ ?_ ?_
    · intro m
      exact ((SC _ hdgc.1).mul (SC _ (hreg m).2.2.2.2.1.1)).add
        ((SC _ hgc.1).mul (SC _ (hreg m).2.2.2.2.2.1))
    · intro m x a b
      have g1 := hdgc.2.2 x w a b hw1
      have g2 := hgc.2.2 x w a b hw1
      have k1 := hKerNorm bgkG (F1 m) (1 / 2) (u m) x a b kGb (fun Y c d => (hb m Y w c d hw1).1)
      have k2 := hKerNorm bgkG (cDw (F1 m)) (1 / 2) (2 / s₁ * u m) x a b kGb
        (fun Y c d => DB1 m Y c d)
      have n1 : 0 ≤ 1 / 2 * u m := mul_nonneg (by norm_num) (hu0 m)
      have n2 : 0 ≤ 1 / 2 * (2 / s₁ * u m) := mul_nonneg (by norm_num) (mul_nonneg h2s (hu0 m))
      have k1' := k1.trans (mul_le_mul_of_nonneg_right b.le n1)
      have k2' := k2.trans (mul_le_mul_of_nonneg_right b.le n2)
      show ‖cDw gc x w * cKer bgkG (F1 m) x w + gc x w * cKer bgkG (cDw (F1 m)) x w‖ ≤
        A₁ * (Xi * (1 / 2 * u m)) + A₁ * (Xi * (1 / 2 * (2 / s₁ * u m)))
      refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
      · rw [norm_mul]; exact mul_le_mul g1 k1' (norm_nonneg _) hA
      · rw [norm_mul]; exact mul_le_mul g2 k2' (norm_nonneg _) hA
    · intro x a b
      exact ((K1 bgkG kG x a b).mul_left (cDw gc x w)).add ((K3 bgkG kG x a b).mul_left (gc x w))
  have B7 : HasSum (fun m => ((X : ℝ) : ℂ) * (gc X w * cKer bgkG (F1 m) X w))
      (((X : ℝ) : ℂ) * (gc X w * cKer bgkG ψ1 X w)) :=
    ((K1 bgkG kG X hX0 hXi').mul_left (gc X w)).mul_left ((X : ℝ) : ℂ)
  refine ⟨?_, ?_⟩
  · have T0 := (K1 bgkG kG X hX0 hXi').mul_left (ac 0 X w)
    have T1 := (K1 bgkGp kGp X hX0 hXi').mul_left (ac 1 X w)
    have T2 := (K3 bgkG kG X hX0 hXi').mul_left (ac 2 X w)
    have T3 := (K2 bgkU kU X hX0 hXi').mul_left (ac 3 X w)
    have T4 := (K2 bgkS kS X hX0 hXi').mul_left (ac 4 X w)
    have T5 := (K4 bgkS kS X hX0 hXi').mul_left (ac 5 X w)
    exact ((((T0.add T1).add T2).add T3).add T4).add T5
  · have U0 := (K2 bgkU kU X hX0 hXi').mul_left (bc 0 X w)
    have U1 := (K2 bgkUp kUp X hX0 hXi').mul_left (bc 1 X w)
    have U2 := (K4 bgkU kU X hX0 hXi').mul_left (bc 2 X w)
    have U3 := (K2 bgkS kS X hX0 hXi').mul_left (bc 3 X w)
    have U4 := (K4 bgkS kS X hX0 hXi').mul_left (bc 4 X w)
    have U5 := R5.mul_left (bc 5 X w)
    have U6 := R6.mul_left (bc 6 X w)
    have U7 := B7.mul_left (bc 7 X w)
    exact ((((((U0.add U1).add U2).add U3).add U4).add U5).add U6).add U7

theorem bg_complex_fixed_point : ∀ (Xi σ A : ℝ) (ac : Fin 6 → ℝ → ℂ → ℂ) (bc : Fin 8 → ℝ → ℂ → ℂ) (gc sc1 sc2 : ℝ → ℂ → ℂ), 0 < Xi → 0 < σ → (∀ i, CB Xi σ A (ac i)) → (∀ i, CB Xi σ A (bc i)) → CB Xi σ A gc → CB Xi σ A sc1 → CB Xi σ A sc2 → (∀ i, CReal Xi (ac i)) → (∀ i, CReal Xi (bc i)) → CReal Xi gc → CReal Xi sc1 → CReal Xi sc2 → ∃ (τ B : ℝ) (ψ1 ψ2 : ℝ → ℂ → ℂ), 0 < τ ∧ CB Xi τ B ψ1 ∧ CB Xi τ B ψ2 ∧ CReal Xi ψ1 ∧ CReal Xi ψ2 ∧ ∀ X w, 0 < X → X < Xi → w ∈ cStrip τ → ψ1 X w = bgT1 ac ψ1 ψ2 X w + sc1 X w ∧ ψ2 X w = bgT2 bc gc ψ1 ψ2 X w + sc2 X w :=
by
  intro Xi σ A ac bc gc sc1 sc2 hXi hσ hac hbc hgc hs1 hs2 hRa hRb hRg hR1 hR2

  have hstrip : ∀ s t : ℝ, s ≤ t → cStrip s ⊆ cStrip t := by
    intro s t hst w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
  have hCBmono : ∀ (s t C D : ℝ) (φ : ℝ → ℂ → ℂ), s ≤ t → C ≤ D → CB Xi t C φ → CB Xi s D φ := by
    intro s t C D φ hst hCD h
    obtain ⟨h1, h2, h3⟩ := h
    exact ⟨h1.mono (Set.prod_mono subset_rfl (hstrip s t hst)),
      fun X h0 h1' => (h2 X h0 h1').mono (hstrip s t hst),
      fun X w h0 h1' hw => (h3 X w h0 h1' (hstrip s t hst hw)).trans hCD⟩
  have h0mem : ∀ s : ℝ, 0 < s → (0 : ℂ) ∈ cStrip s := by
    intro s hs
    simp only [cStrip, Set.mem_setOf_eq, Complex.zero_im, Complex.zero_re, abs_zero]
    exact ⟨hs, by linarith, by linarith⟩
  have hXi2 : (0 : ℝ) < Xi / 2 := by linarith
  have hXi2' : Xi / 2 < Xi := by linarith
  have hA : 0 ≤ A := le_trans (norm_nonneg _) (hs1.2.2 (Xi / 2) 0 hXi2 hXi2' (h0mem σ hσ))

  obtain ⟨σ₀, hσ₀⟩ : ∃ σ₀ : ℝ, σ₀ = min (σ / 2) 1 := ⟨_, rfl⟩
  have hσ₀pos : 0 < σ₀ := by rw [hσ₀]; exact lt_min (by linarith) one_pos
  have hσ₀1 : σ₀ ≤ 1 := by rw [hσ₀]; exact min_le_right _ _
  have hσ₀σ : σ₀ ≤ σ / 2 := by rw [hσ₀]; exact min_le_left _ _
  have hσ₀σ' : σ₀ ≤ σ := by linarith
  obtain ⟨A₁, hA₁⟩ : ∃ A₁ : ℝ, A₁ = A + 2 * A / σ := ⟨_, rfl⟩
  have h2A : 0 ≤ 2 * A / σ := div_nonneg (by linarith) hσ.le
  have hAA₁ : A ≤ A₁ := by rw [hA₁]; linarith
  have hA₁0 : 0 ≤ A₁ := le_trans hA hAA₁

  have hCRgc : CReg Xi σ gc := (creg_algebra Xi σ σ A gc gc).1 hgc
  obtain ⟨hdgc1, hdgc2, -⟩ := (bg_creg_ops Xi σ gc hXi hσ hCRgc).1
  have hdgcB : ∀ X w, 0 < X → X < Xi → w ∈ cStrip σ₀ → ‖cDw gc X w‖ ≤ A₁ := by
    intro X w h0 h1 hw
    have hd : DifferentiableOn ℂ (gc X) (cStrip (σ₀ + σ / 2)) :=
      (hgc.2.1 X h0 h1).mono (hstrip _ _ (by linarith))
    have hb : ∀ z ∈ cStrip (σ₀ + σ / 2), ‖gc X z‖ ≤ A :=
      fun z hz => hgc.2.2 X z h0 h1 (hstrip _ _ (by linarith) hz)
    have key := (strip_cauchy_nagumo (gc X) σ₀).1 σ₀ (σ₀ + σ / 2) A (by linarith) hd hb w hw
    have e : A / (σ₀ + σ / 2 - σ₀) = 2 * A / σ := by
      rw [show σ₀ + σ / 2 - σ₀ = σ / 2 by ring, div_div_eq_mul_div]; ring
    rw [e] at key
    show ‖deriv (gc X) w‖ ≤ A₁
    rw [hA₁]; linarith
  have hCBdgc : CB Xi σ₀ A₁ (cDw gc) :=
    ⟨hdgc1.mono (Set.prod_mono subset_rfl (hstrip _ _ hσ₀σ')),
      fun X h0 h1 => (hdgc2 X h0 h1).mono (hstrip _ _ hσ₀σ'), hdgcB⟩
  have hac0 : ∀ i, CB Xi σ₀ A₁ (ac i) := fun i => hCBmono _ _ _ _ _ hσ₀σ' hAA₁ (hac i)
  have hbc0 : ∀ i, CB Xi σ₀ A₁ (bc i) := fun i => hCBmono _ _ _ _ _ hσ₀σ' hAA₁ (hbc i)
  have hgc0 : CB Xi σ₀ A₁ gc := hCBmono _ _ _ _ _ hσ₀σ' hAA₁ hgc
  have hs10 : CB Xi σ₀ A₁ sc1 := hCBmono _ _ _ _ _ hσ₀σ' hAA₁ hs1
  have hs20 : CB Xi σ₀ A₁ sc2 := hCBmono _ _ _ _ _ hσ₀σ' hAA₁ hs2
  have hCB2CR : ∀ φ : ℝ → ℂ → ℂ, CB Xi σ₀ A₁ φ → CReg Xi σ₀ φ :=
    fun φ h => (creg_algebra Xi σ₀ σ₀ A₁ φ φ).1 h
  have hΛ0 : (0 : ℝ) ≤ 8 * (1 + A₁) ^ 2 * (1 + Xi) := mul_nonneg (by positivity) (by linarith)

  obtain ⟨P, hP0, hPs⟩ : ∃ P : ℕ → (ℝ → ℂ → ℂ) × (ℝ → ℂ → ℂ), P 0 = (sc1, sc2) ∧
      ∀ k, P (k + 1) = (bgT1 ac (P k).1 (P k).2, bgT2 bc gc (P k).1 (P k).2) :=
    ⟨fun n => Nat.rec (motive := fun _ => (ℝ → ℂ → ℂ) × (ℝ → ℂ → ℂ)) (sc1, sc2)
      (fun _ Q => (bgT1 ac Q.1 Q.2, bgT2 bc gc Q.1 Q.2)) n, rfl, fun _ => rfl⟩
  have hInd : ∀ m : ℕ, CReg Xi σ₀ (P m).1 ∧ CReg Xi σ₀ (P m).2 ∧ CReal Xi (P m).1 ∧
      CReal Xi (P m).2 ∧ ∀ (s X : ℝ) (w : ℂ), 0 < s → s < σ₀ → 0 < X → X < Xi → w ∈ cStrip s →
        ‖(P m).1 X w‖ ≤ A₁ * (8 * (1 + A₁) ^ 2 * (1 + Xi)) ^ m * X ^ m /
          ((m.factorial : ℝ) * (σ₀ - s) ^ m) ∧
        ‖(P m).2 X w‖ ≤ A₁ * (8 * (1 + A₁) ^ 2 * (1 + Xi)) ^ m * X ^ m /
          ((m.factorial : ℝ) * (σ₀ - s) ^ m) := by
    intro m
    induction m with
    | zero =>
      rw [hP0]
      refine ⟨hCB2CR sc1 hs10, hCB2CR sc2 hs20, hR1, hR2, ?_⟩
      intro s X w _ hs1' h0 h1 hw
      have hw' : w ∈ cStrip σ₀ := hstrip _ _ hs1'.le hw
      simp only [pow_zero, Nat.factorial_zero, Nat.cast_one, mul_one, div_one]
      exact ⟨hs10.2.2 X w h0 h1 hw', hs20.2.2 X w h0 h1 hw'⟩
    | succ m ih =>
      obtain ⟨hC1, hC2, hRe1, hRe2, hB⟩ := ih
      rw [hPs m]
      obtain ⟨t1, t2⟩ := bgT_creg Xi σ₀ ac bc gc (P m).1 (P m).2 hXi hσ₀pos
        (fun i => hCB2CR _ (hac0 i)) (fun i => hCB2CR _ (hbc0 i)) (hCB2CR _ hgc0) hC1 hC2
      obtain ⟨r1, r2⟩ := bgT_real Xi σ₀ ac bc gc (P m).1 (P m).2 hσ₀pos hRa hRb hRg hRe1 hRe2
        hgc0.2.1 hC1.2.1 hC2.2.1
      refine ⟨t1, t2, r1, r2, ?_⟩
      intro s X w hs0 hs1' h0 h1 hw
      have hf : (0 : ℝ) < (m.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos m
      have hK : 0 ≤ A₁ * (8 * (1 + A₁) ^ 2 * (1 + Xi)) ^ m / (m.factorial : ℝ) :=
        div_nonneg (mul_nonneg hA₁0 (pow_nonneg hΛ0 m)) hf.le
      have hyp : ∀ (s X : ℝ) (w : ℂ), 0 < s → s < σ₀ → 0 < X → X < Xi → w ∈ cStrip s →
          ‖(P m).1 X w‖ ≤ A₁ * (8 * (1 + A₁) ^ 2 * (1 + Xi)) ^ m / (m.factorial : ℝ) * X ^ m /
            (σ₀ - s) ^ m ∧
          ‖(P m).2 X w‖ ≤ A₁ * (8 * (1 + A₁) ^ 2 * (1 + Xi)) ^ m / (m.factorial : ℝ) * X ^ m /
            (σ₀ - s) ^ m := by
        intro s' X' w' a b c d e
        rw [div_mul_eq_mul_div, div_div]
        exact hB s' X' w' a b c d e
      have hstep := bg_one_step Xi σ₀ A₁ (A₁ * (8 * (1 + A₁) ^ 2 * (1 + Xi)) ^ m / (m.factorial : ℝ))
        m ac bc gc (P m).1 (P m).2 hXi hσ₀pos hσ₀1 hA₁0 hK
        (fun i X w a b c => (hac0 i).2.2 X w a b c) (fun i X w a b c => (hbc0 i).2.2 X w a b c)
        (fun X w a b c => ⟨hgc0.2.2 X w a b c, hCBdgc.2.2 X w a b c⟩)
        (fun X a b => ⟨hC1.2.1 X a b, hC2.2.1 X a b⟩) hyp s X w hs0 hs1' h0 h1 hw
      have hD : 0 < σ₀ - s := by linarith
      have eq : 8 * (1 + A₁) ^ 2 * (1 + Xi) *
          (A₁ * (8 * (1 + A₁) ^ 2 * (1 + Xi)) ^ m / (m.factorial : ℝ)) *
          X ^ (m + 1) / (((m : ℝ) + 1) * (σ₀ - s) ^ (m + 1)) =
          A₁ * (8 * (1 + A₁) ^ 2 * (1 + Xi)) ^ (m + 1) * X ^ (m + 1) /
            (((m + 1).factorial : ℝ) * (σ₀ - s) ^ (m + 1)) := by
        rw [Nat.factorial_succ, Nat.cast_mul, Nat.cast_succ]
        field_simp
        ring
      exact ⟨hstep.1.trans_eq eq, hstep.2.trans_eq eq⟩

  obtain ⟨u1, hu1s, hu1b, hCBψ1⟩ := bg_series_props Xi σ₀ A₁ (8 * (1 + A₁) ^ 2 * (1 + Xi))
    (fun m => (P m).1) hXi hσ₀pos hA₁0 hΛ0 (fun m => (hInd m).1)
    (fun m s X w a b c d e => ((hInd m).2.2.2.2 s X w a b c d e).1)
  obtain ⟨u2, hu2s, hu2b, hCBψ2⟩ := bg_series_props Xi σ₀ A₁ (8 * (1 + A₁) ^ 2 * (1 + Xi))
    (fun m => (P m).2) hXi hσ₀pos hA₁0 hΛ0 (fun m => (hInd m).2.1)
    (fun m s X w a b c d e => ((hInd m).2.2.2.2 s X w a b c d e).2)
  have hσ2 : (0 : ℝ) < σ₀ / 2 := by linarith
  have hσ2le : σ₀ / 2 ≤ σ₀ := by linarith
  have hu1nn : ∀ m, 0 ≤ u1 m :=
    fun m => le_trans (norm_nonneg _) (hu1b m (Xi / 2) 0 hXi2 hXi2' (h0mem _ hσ2))
  have hu2nn : ∀ m, 0 ≤ u2 m :=
    fun m => le_trans (norm_nonneg _) (hu2b m (Xi / 2) 0 hXi2 hXi2' (h0mem _ hσ2))
  have hmono : ∀ φ : ℝ → ℂ → ℂ, CReg Xi σ₀ φ → CReg Xi (σ₀ / 2) φ :=
    fun φ h => (creg_algebra Xi σ₀ (σ₀ / 2) 0 φ φ).2.1 h hσ2le
  have hops : ∀ φ : ℝ → ℂ → ℂ, CReg Xi σ₀ φ → CReg Xi σ₀ (cDw φ) ∧ CReg Xi σ₀ (cRad φ) ∧
      ∀ kk : ℝ → ℝ, (kk = bgkG ∨ kk = bgkGp ∨ kk = bgkU ∨ kk = bgkUp ∨ kk = bgkS) →
        CReg Xi σ₀ (cKer kk φ) :=
    fun φ h => bg_creg_ops Xi σ₀ φ hXi hσ₀pos h

  have hS := bgT_hasSum Xi (σ₀ / 2) A₁ ac bc gc (fun m => (P m).1) (fun m => (P m).2)
    (fun m => u1 m + u2 m) hXi hσ2 (hu1s.add hu2s)
    (fun i => hCBmono _ _ _ _ _ hσ2le le_rfl (hac0 i))
    (fun i => hCBmono _ _ _ _ _ hσ2le le_rfl (hbc0 i))
    (hCBmono _ _ _ _ _ hσ2le le_rfl hgc0) (hCBmono _ _ _ _ _ hσ2le le_rfl hCBdgc)
    (fun m => ⟨hmono _ (hInd m).1, hmono _ (hInd m).2.1, hmono _ (hops _ (hInd m).1).1,
      hmono _ (hops _ (hInd m).2.1).1, hmono _ ((hops _ (hInd m).1).2.2 bgkG (Or.inl rfl)),
      hmono _ ((hops _ (hops _ (hInd m).1).1).2.2 bgkG (Or.inl rfl))⟩)
    (fun m X w a b c => ⟨(hu1b m X w a b c).trans (le_add_of_nonneg_right (hu2nn m)),
      (hu2b m X w a b c).trans (le_add_of_nonneg_left (hu1nn m))⟩)
  have hsum1 : ∀ X w, 0 < X → X < Xi → w ∈ cStrip (σ₀ / 2) →
      HasSum (fun m => (P m).1 X w) (∑' m, (P m).1 X w) :=
    fun X w a b c => (Summable.of_norm_bounded (g := u1) hu1s (fun m => hu1b m X w a b c)).hasSum
  have hsum2 : ∀ X w, 0 < X → X < Xi → w ∈ cStrip (σ₀ / 2) →
      HasSum (fun m => (P m).2 X w) (∑' m, (P m).2 X w) :=
    fun X w a b c => (Summable.of_norm_bounded (g := u2) hu2s (fun m => hu2b m X w a b c)).hasSum

  obtain ⟨τ, hτ⟩ : ∃ τ : ℝ, τ = σ₀ / 2 / 2 := ⟨_, rfl⟩
  have hτpos : 0 < τ := by rw [hτ]; linarith
  have hτle : τ ≤ σ₀ / 2 := by rw [hτ]; linarith
  refine ⟨τ, ∑' m, u1 m + ∑' m, u2 m, fun X w => ∑' m, (P m).1 X w,
    fun X w => ∑' m, (P m).2 X w, hτpos,
    hCBmono _ _ _ _ _ hτle (le_add_of_nonneg_right (tsum_nonneg hu2nn)) hCBψ1,
    hCBmono _ _ _ _ _ hτle (le_add_of_nonneg_left (tsum_nonneg hu1nn)) hCBψ2, ?_, ?_, ?_⟩
  · intro X η h0 h1 e1 e2
    have hη : (η : ℂ) ∈ cStrip (σ₀ / 2) := by
      simp only [cStrip, Set.mem_setOf_eq, Complex.ofReal_im, Complex.ofReal_re, abs_zero]
      exact ⟨hσ2, by linarith, by linarith⟩
    have h := Complex.hasSum_im (hsum1 X η h0 h1 hη)
    have h2 : HasSum (fun m => ((P m).1 X (η : ℂ)).im) 0 := by
      have hz : (fun m => ((P m).1 X (η : ℂ)).im) = fun _ => (0 : ℝ) :=
        funext fun m => (hInd m).2.2.1 X η h0 h1 e1 e2
      rw [hz]; exact hasSum_zero
    exact h.unique h2
  · intro X η h0 h1 e1 e2
    have hη : (η : ℂ) ∈ cStrip (σ₀ / 2) := by
      simp only [cStrip, Set.mem_setOf_eq, Complex.ofReal_im, Complex.ofReal_re, abs_zero]
      exact ⟨hσ2, by linarith, by linarith⟩
    have h := Complex.hasSum_im (hsum2 X η h0 h1 hη)
    have h2 : HasSum (fun m => ((P m).2 X (η : ℂ)).im) 0 := by
      have hz : (fun m => ((P m).2 X (η : ℂ)).im) = fun _ => (0 : ℝ) :=
        funext fun m => (hInd m).2.2.2.1 X η h0 h1 e1 e2
      rw [hz]; exact hasSum_zero
    exact h.unique h2
  · intro X w h0 h1 hw
    have hw2 : w ∈ cStrip (σ₀ / 2) := hstrip _ _ hτle hw
    have hw4 : w ∈ cStrip (σ₀ / 2 / 2) := by rw [← hτ]; exact hw
    obtain ⟨hT1, hT2⟩ := hS X w h0 h1 hw4
    have e1 : (fun m => bgT1 ac (P m).1 (P m).2 X w) = fun m => (P (m + 1)).1 X w :=
      funext fun m => congrArg (fun Q : (ℝ → ℂ → ℂ) × (ℝ → ℂ → ℂ) => Q.1 X w) (hPs m).symm
    have e2 : (fun m => bgT2 bc gc (P m).1 (P m).2 X w) = fun m => (P (m + 1)).2 X w :=
      funext fun m => congrArg (fun Q : (ℝ → ℂ → ℂ) × (ℝ → ℂ → ℂ) => Q.2 X w) (hPs m).symm
    have hT1' : HasSum (fun m => (P (m + 1)).1 X w)
        (bgT1 ac (fun X w => ∑' m, (P m).1 X w) (fun X w => ∑' m, (P m).2 X w) X w) := by
      rw [← e1]; exact hT1
    have hT2' : HasSum (fun m => (P (m + 1)).2 X w)
        (bgT2 bc gc (fun X w => ∑' m, (P m).1 X w) (fun X w => ∑' m, (P m).2 X w) X w) := by
      rw [← e2]; exact hT2
    have hA1 : HasSum (fun m => (P (m + 1)).1 X w) ((∑' m, (P m).1 X w) - (P 0).1 X w) := by
      have := (hasSum_nat_add_iff' 1).mpr (hsum1 X w h0 h1 hw2)
      simpa using this
    have hA2 : HasSum (fun m => (P (m + 1)).2 X w) ((∑' m, (P m).2 X w) - (P 0).2 X w) := by
      have := (hasSum_nat_add_iff' 1).mpr (hsum2 X w h0 h1 hw2)
      simpa using this
    have q1 := hA1.unique hT1'
    have q2 := hA2.unique hT2'
    have p1 : (P 0).1 X w = sc1 X w :=
      congrArg (fun Q : (ℝ → ℂ → ℂ) × (ℝ → ℂ → ℂ) => Q.1 X w) hP0
    have p2 : (P 0).2 X w = sc2 X w :=
      congrArg (fun Q : (ℝ → ℂ → ℂ) × (ℝ → ℂ → ℂ) => Q.2 X w) hP0
    exact ⟨by linear_combination q1 + p1, by linear_combination q2 + p2⟩

theorem bgHoloC_add : ∀ (Xi : ℝ) (j : ℕ) (f g : ℝ → ℂ → ℂ), BgHoloC Xi j f → BgHoloC Xi j g → BgHoloC Xi j (fun X w => f X w + g X w) :=
by
  rintro Xi j f g ⟨rf, Cf, hrf, Hf⟩ ⟨rg, Cg, hrg, Hg⟩
  have hsub : ∀ s t : ℝ, s ≤ t → cStrip s ⊆ cStrip t := by
    intro s t hst w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
  have sf : cStrip (min rf rg) ⊆ cStrip rf := hsub _ _ (min_le_left _ _)
  have sg : cStrip (min rf rg) ⊆ cStrip rg := hsub _ _ (min_le_right _ _)
  have hD : ∀ k : ℕ, k ≤ j → ∀ (X : ℝ) (w : ℂ), 0 < X → X < Xi → w ∈ cStrip (min rf rg) →
      iteratedDeriv k (fun Y => f Y w + g Y w) X =
        iteratedDeriv k (fun Y => f Y w) X + iteratedDeriv k (fun Y => g Y w) X := by
    intro k
    induction k with
    | zero => intro _ X w _ _ _; simp only [iteratedDeriv_zero]
    | succ k ih =>
      intro hk X w h0 h1 hw
      have hev : (fun Y => iteratedDeriv k (fun Y' => f Y' w + g Y' w) Y) =ᶠ[nhds X]
          (fun Y => iteratedDeriv k (fun Y' => f Y' w) Y + iteratedDeriv k (fun Y' => g Y' w) Y) := by
        filter_upwards [Ioo_mem_nhds h0 h1] with Y hY
        exact ih (by omega) Y w hY.1 hY.2 hw
      have df := ((Hf k (by omega)).2.2 (by omega) X w h0 h1 (sf hw))
      have dg := ((Hg k (by omega)).2.2 (by omega) X w h0 h1 (sg hw))
      rw [iteratedDeriv_succ, hev.deriv_eq]
      exact (df.add dg).deriv
  refine ⟨min rf rg, Cf + Cg, lt_min hrf hrg, fun k hk => ?_⟩
  obtain ⟨f1, f2, f3⟩ := Hf k hk
  obtain ⟨g1, g2, g3⟩ := Hg k hk
  refine ⟨?_, fun X h0 h1 => ⟨?_, fun w hw => ?_⟩, fun hkj X w h0 h1 hw => ?_⟩
  · refine ((f1.mono (Set.prod_mono subset_rfl sf)).add
      (g1.mono (Set.prod_mono subset_rfl sg))).congr ?_
    intro p hp
    exact hD k hk p.1 p.2 hp.1.1 hp.1.2 hp.2
  · refine (((f2 X h0 h1).1.mono sf).add ((g2 X h0 h1).1.mono sg)).congr ?_
    intro w hw
    exact hD k hk X w h0 h1 hw
  · show ‖iteratedDeriv k (fun Y => f Y w + g Y w) X‖ ≤ Cf + Cg
    rw [hD k hk X w h0 h1 hw]
    exact (norm_add_le _ _).trans
      (add_le_add ((f2 X h0 h1).2 w (sf hw)) ((g2 X h0 h1).2 w (sg hw)))
  · show HasDerivAt (fun Y => iteratedDeriv k (fun Y' => f Y' w + g Y' w) Y)
      (iteratedDeriv (k + 1) (fun Y => f Y w + g Y w) X) X
    rw [hD (k + 1) (by omega) X w h0 h1 hw]
    apply ((f3 hkj X w h0 h1 (sf hw)).add (g3 hkj X w h0 h1 (sg hw))).congr_of_eventuallyEq
    filter_upwards [Ioo_mem_nhds h0 h1] with Y hY
    exact hD k hk Y w hY.1 hY.2 hw

theorem bgHoloC_mul : ∀ (Xi : ℝ) (j : ℕ) (f g : ℝ → ℂ → ℂ), BgHoloC Xi j f → BgHoloC Xi j g → BgHoloC Xi j (fun X w => f X w * g X w) :=
by
  intro Xi j f g hf hg
  obtain ⟨ρf, Cf, hρf, Hf⟩ := hf
  obtain ⟨ρg, Cg, hρg, Hg⟩ := hg
  have hsub : ∀ s t : ℝ, s ≤ t → cStrip s ⊆ cStrip t := by
    intro s t hst w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
  have hsf : cStrip (min ρf ρg) ⊆ cStrip ρf := hsub _ _ (min_le_left _ _)
  have hsg : cStrip (min ρf ρg) ⊆ cStrip ρg := hsub _ _ (min_le_right _ _)
  obtain ⟨L, hL⟩ : ∃ L : ℕ → ℝ → ℂ → ℂ, ∀ k X w, L k X w =
      ∑ l ∈ Finset.range (k + 1), ((k.choose l : ℕ) : ℂ) *
        (iteratedDeriv l (fun Y => f Y w) X * iteratedDeriv (k - l) (fun Y => g Y w) X) :=
    ⟨fun k X w => ∑ l ∈ Finset.range (k + 1), ((k.choose l : ℕ) : ℂ) *
        (iteratedDeriv l (fun Y => f Y w) X * iteratedDeriv (k - l) (fun Y => g Y w) X),
      fun _ _ _ => rfl⟩

  have hD : ∀ k, k < j → ∀ X w, 0 < X → X < Xi → w ∈ cStrip (min ρf ρg) →
      HasDerivAt (fun Y => L k Y w) (L (k + 1) X w) X := by
    intro k hk X w h0 h1 hw
    have hterm : ∀ l ∈ Finset.range (k + 1), HasDerivAt
        (fun Y => ((k.choose l : ℕ) : ℂ) *
          (iteratedDeriv l (fun Y' => f Y' w) Y * iteratedDeriv (k - l) (fun Y' => g Y' w) Y))
        (((k.choose l : ℕ) : ℂ) *
          (iteratedDeriv (l + 1) (fun Y' => f Y' w) X * iteratedDeriv (k - l) (fun Y' => g Y' w) X +
            iteratedDeriv l (fun Y' => f Y' w) X * iteratedDeriv (k - l + 1) (fun Y' => g Y' w) X)) X := by
      intro l hl
      have hl' : l < k + 1 := Finset.mem_range.mp hl
      have h1f := (Hf l (by omega)).2.2 (by omega) X w h0 h1 (hsf hw)
      have h1g := (Hg (k - l) (by omega)).2.2 (by omega) X w h0 h1 (hsg hw)
      exact (h1f.fun_mul h1g).const_mul _
    have hP : ∑ i ∈ Finset.range (k + 1 + 1), (((k + 1).choose i : ℕ) : ℂ) *
          (iteratedDeriv i (fun Y' => f Y' w) X * iteratedDeriv (k + 1 - i) (fun Y' => g Y' w) X) =
        ∑ i ∈ Finset.range (k + 1), ((k.choose i : ℕ) : ℂ) *
          (iteratedDeriv i (fun Y' => f Y' w) X * iteratedDeriv (k + 1 - i) (fun Y' => g Y' w) X) +
        ∑ i ∈ Finset.range (k + 1), ((k.choose i : ℕ) : ℂ) *
          (iteratedDeriv (i + 1) (fun Y' => f Y' w) X * iteratedDeriv (k - i) (fun Y' => g Y' w) X) :=
      Finset.sum_choose_succ_mul
        (fun i m => iteratedDeriv i (fun Y' => f Y' w) X * iteratedDeriv m (fun Y' => g Y' w) X) k
    have hB : ∑ i ∈ Finset.range (k + 1), ((k.choose i : ℕ) : ℂ) *
          (iteratedDeriv i (fun Y' => f Y' w) X * iteratedDeriv (k - i + 1) (fun Y' => g Y' w) X) =
        ∑ i ∈ Finset.range (k + 1), ((k.choose i : ℕ) : ℂ) *
          (iteratedDeriv i (fun Y' => f Y' w) X * iteratedDeriv (k + 1 - i) (fun Y' => g Y' w) X) := by
      apply Finset.sum_congr rfl
      intro i hi
      have hi' : i < k + 1 := Finset.mem_range.mp hi
      rw [show k + 1 - i = k - i + 1 by omega]
    simp only [hL]
    refine (HasDerivAt.fun_sum hterm).congr_deriv ?_
    simp only [mul_add, Finset.sum_add_distrib]
    rw [hB, hP]
    ring

  have hE : ∀ k, k ≤ j → ∀ X w, 0 < X → X < Xi → w ∈ cStrip (min ρf ρg) →
      iteratedDeriv k (fun Y => f Y w * g Y w) X = L k X w := by
    intro k
    induction k with
    | zero =>
      intro _ X w _ _ _
      simp [hL]
    | succ k ih =>
      intro hk X w h0 h1 hw
      rw [iteratedDeriv_succ]
      have hev : iteratedDeriv k (fun Y => f Y w * g Y w) =ᶠ[nhds X] fun Y => L k Y w :=
        Filter.eventuallyEq_of_mem (Ioo_mem_nhds h0 h1)
          (fun Y hY => ih (by omega) Y w hY.1 hY.2 hw)
      rw [hev.deriv_eq]
      exact (hD k (by omega) X w h0 h1 hw).deriv
  refine ⟨min ρf ρg, 2 ^ j * (|Cf| * |Cg|), lt_min hρf hρg, fun k hk =>
    ⟨?_, fun X h0 h1 => ⟨?_, ?_⟩, fun hkj X w h0 h1 hw => ?_⟩⟩
  ·
    have hc : ContinuousOn (fun p : ℝ × ℂ => L k p.1 p.2) (Ioo 0 Xi ×ˢ cStrip (min ρf ρg)) := by
      simp only [hL]
      apply continuousOn_finsetSum
      intro l hl
      have hl' := Finset.mem_range.mp hl
      have cf := ((Hf l (by omega)).1).mono (Set.prod_mono subset_rfl hsf)
      have cg := ((Hg (k - l) (by omega)).1).mono (Set.prod_mono subset_rfl hsg)
      exact continuousOn_const.mul (cf.mul cg)
    refine hc.congr ?_
    intro p hp
    exact hE k hk p.1 p.2 hp.1.1 hp.1.2 hp.2
  ·
    have hd : DifferentiableOn ℂ (fun w => L k X w) (cStrip (min ρf ρg)) := by
      simp only [hL]
      apply DifferentiableOn.fun_sum
      intro l hl
      have hl' := Finset.mem_range.mp hl
      have df := ((Hf l (by omega)).2.1 X h0 h1).1.mono hsf
      have dg := ((Hg (k - l) (by omega)).2.1 X h0 h1).1.mono hsg
      exact (df.mul dg).const_mul _
    exact hd.congr (fun w hw => hE k hk X w h0 h1 hw)
  ·
    intro w hw
    rw [hE k hk X w h0 h1 hw, hL]
    calc ‖∑ l ∈ Finset.range (k + 1), ((k.choose l : ℕ) : ℂ) *
            (iteratedDeriv l (fun Y => f Y w) X * iteratedDeriv (k - l) (fun Y => g Y w) X)‖
        ≤ ∑ l ∈ Finset.range (k + 1), ‖((k.choose l : ℕ) : ℂ) *
            (iteratedDeriv l (fun Y => f Y w) X * iteratedDeriv (k - l) (fun Y => g Y w) X)‖ :=
          norm_sum_le _ _
      _ ≤ ∑ l ∈ Finset.range (k + 1), ((k.choose l : ℕ) : ℝ) * (|Cf| * |Cg|) := by
          apply Finset.sum_le_sum
          intro l hl
          have hl' := Finset.mem_range.mp hl
          have bf := ((Hf l (by omega)).2.1 X h0 h1).2 w (hsf hw)
          have bg := ((Hg (k - l) (by omega)).2.1 X h0 h1).2 w (hsg hw)
          rw [norm_mul, norm_mul, Complex.norm_natCast]
          apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
          exact mul_le_mul (bf.trans (le_abs_self _)) (bg.trans (le_abs_self _))
            (norm_nonneg _) (abs_nonneg _)
      _ = 2 ^ k * (|Cf| * |Cg|) := by
          rw [← Finset.sum_mul]
          congr 1
          exact_mod_cast Nat.sum_range_choose k
      _ ≤ 2 ^ j * (|Cf| * |Cg|) := by
          apply mul_le_mul_of_nonneg_right _ (by positivity)
          exact pow_le_pow_right₀ (by norm_num) hk
  ·
    rw [hE (k + 1) (by omega) X w h0 h1 hw]
    have hev : (fun Y => iteratedDeriv k (fun Y' => f Y' w * g Y' w) Y) =ᶠ[nhds X]
        fun Y => L k Y w :=
      Filter.eventuallyEq_of_mem (Ioo_mem_nhds h0 h1) (fun Y hY => hE k hk Y w hY.1 hY.2 hw)
    exact (hD k hkj X w h0 h1 hw).congr_of_eventuallyEq hev

theorem bgHoloC_cDw : ∀ (Xi : ℝ) (j : ℕ) (φ : ℝ → ℂ → ℂ), BgHoloC Xi j φ → BgHoloC Xi j (cDw φ) :=
by

  have s1 : ∀ (ρ : ℝ), 0 < ρ → IsOpen (cStrip ρ) ∧ cStrip (ρ / 2) ⊆ cStrip ρ ∧
      ∀ w : ℂ, w ∈ cStrip (ρ / 2) → Metric.closedBall w (ρ / 2) ⊆ cStrip ρ := by
    intro ρ hρ
    refine ⟨?_, ?_, ?_⟩
    · have h1 : IsOpen {w : ℂ | |w.im| < ρ} := isOpen_lt (Complex.continuous_im.abs) continuous_const
      have h2 : IsOpen {w : ℂ | -1 - ρ < w.re} := isOpen_lt continuous_const Complex.continuous_re
      have h3 : IsOpen {w : ℂ | w.re < 1 + ρ} := isOpen_lt Complex.continuous_re continuous_const
      have e : cStrip ρ = {w : ℂ | |w.im| < ρ} ∩ ({w : ℂ | -1 - ρ < w.re} ∩ {w : ℂ | w.re < 1 + ρ}) := by
        ext w; simp [cStrip]
      rw [e]; exact h1.inter (h2.inter h3)
    · intro w hw
      simp only [cStrip, mem_setOf_eq] at hw ⊢
      exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
    · intro w hw z hz
      simp only [cStrip, mem_setOf_eq] at hw ⊢
      rw [Metric.mem_closedBall, dist_eq_norm] at hz
      have h1 := Complex.abs_im_le_norm (z - w)
      have h2 := Complex.abs_re_le_norm (z - w)
      rw [Complex.sub_im] at h1
      rw [Complex.sub_re] at h2
      have h3 := abs_sub_abs_le_abs_sub z.im w.im
      obtain ⟨a, b, c⟩ := hw
      rw [abs_le] at h2
      exact ⟨by linarith, by linarith [h2.1], by linarith [h2.2]⟩

  have hcirc : ∀ (w : ℂ) (R : ℝ), 0 < R →
      (∀ θ, ‖circleMap w R θ - w‖ = R) ∧ (∀ θ, ‖deriv (circleMap w R) θ‖ = R) ∧
      Continuous (fun θ => deriv (circleMap w R) θ) := by
    intro w R hR
    refine ⟨fun θ => ?_, fun θ => ?_, ?_⟩
    · rw [circleMap_sub_center, norm_circleMap_zero, abs_of_pos hR]
    · rw [deriv_circleMap, norm_mul, Complex.norm_I, mul_one, norm_circleMap_zero, abs_of_pos hR]
    · have e : (fun θ => deriv (circleMap w R) θ) = fun θ => circleMap 0 R θ * Complex.I :=
        funext fun θ => deriv_circleMap w R θ
      rw [e]; exact (continuous_circleMap 0 R).mul continuous_const

  have s2 : ∀ (a b R C X : ℝ) (U : Set ℂ) (w : ℂ) (f f' : ℝ → ℂ → ℂ), IsOpen U → 0 < R →
      Metric.closedBall w R ⊆ U → a < X → X < b →
      (∀ Y, a < Y → Y < b → DifferentiableOn ℂ (f Y) U) →
      (∀ Y, a < Y → Y < b → DifferentiableOn ℂ (f' Y) U) →
      (∀ Y z, a < Y → Y < b → z ∈ U → ‖f' Y z‖ ≤ C) →
      (∀ Y z, a < Y → Y < b → z ∈ U → HasDerivAt (fun Y' => f Y' z) (f' Y z) Y) →
      HasDerivAt (fun Y => deriv (f Y) w) (deriv (f' X) w) X := by
    intro a b R C X U w f f' hU hR hball haX hXb hf hf' hC hD
    obtain ⟨hsub, hdγ, hdγc⟩ := hcirc w R hR
    have hR0 : R ≠ 0 := hR.ne'
    have hγU : ∀ θ, circleMap w R θ ∈ U := fun θ =>
      hball (Metric.sphere_subset_closedBall (circleMap_mem_sphere w hR.le θ))
    have hγne : ∀ θ, circleMap w R θ - w ≠ 0 := by
      intro θ h
      have := hsub θ
      rw [h, norm_zero] at this
      exact hR0 this.symm
    have hcauchy : ∀ g : ℂ → ℂ, DifferentiableOn ℂ g U → deriv g w =
        (2 * ↑Real.pi * Complex.I)⁻¹ • ∫ θ in (0:ℝ)..2 * Real.pi,
          deriv (circleMap w R) θ • (((circleMap w R θ - w) ^ 2)⁻¹ • g (circleMap w R θ)) := by
      intro g hg
      rw [← Complex.two_pi_I_inv_smul_circleIntegral_sub_sq_inv_smul_of_differentiable hU hball hg
        (Metric.mem_ball_self hR), circleIntegral.eq_1]
    have hcont : ∀ g : ℂ → ℂ, ContinuousOn g U → Continuous (fun θ =>
        deriv (circleMap w R) θ • (((circleMap w R θ - w) ^ 2)⁻¹ • g (circleMap w R θ))) := by
      intro g hg
      have e2 : Continuous (fun θ => ((circleMap w R θ - w) ^ 2)⁻¹) :=
        (((continuous_circleMap w R).sub continuous_const).pow 2).inv₀
          (fun θ => pow_ne_zero 2 (hγne θ))
      have e3 : Continuous (fun θ => g (circleMap w R θ)) :=
        hg.comp_continuous (continuous_circleMap w R) hγU
      exact hdγc.smul (e2.smul e3)
    have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le (𝕜 := ℝ)
      (μ := volume) (a := 0) (b := 2 * Real.pi) (bound := fun _ => C / R)
      (F := fun Y θ => deriv (circleMap w R) θ •
        (((circleMap w R θ - w) ^ 2)⁻¹ • f Y (circleMap w R θ)))
      (F' := fun Y θ => deriv (circleMap w R) θ •
        (((circleMap w R θ - w) ^ 2)⁻¹ • f' Y (circleMap w R θ)))
      (x₀ := X) (s := Ioo a b) (Ioo_mem_nhds haX hXb)
      (Filter.eventually_of_mem (Ioo_mem_nhds haX hXb)
        (fun Y hY => (hcont _ (hf Y hY.1 hY.2).continuousOn).aestronglyMeasurable))
      ((hcont _ (hf X haX hXb).continuousOn).intervalIntegrable _ _)
      ((hcont _ (hf' X haX hXb).continuousOn).aestronglyMeasurable)
      (ae_of_all _ (fun θ _ Y hY => by
        rw [norm_smul, norm_smul, norm_inv, norm_pow, hdγ θ, hsub θ]
        have hx := hC Y (circleMap w R θ) hY.1 hY.2 (hγU θ)
        calc R * ((R ^ 2)⁻¹ * ‖f' Y (circleMap w R θ)‖) = R⁻¹ * ‖f' Y (circleMap w R θ)‖ := by
              field_simp
          _ ≤ R⁻¹ * C := mul_le_mul_of_nonneg_left hx (inv_nonneg.mpr hR.le)
          _ = C / R := by ring))
      intervalIntegrable_const
      (ae_of_all _ (fun θ _ Y hY =>
        ((hD Y (circleMap w R θ) hY.1 hY.2 (hγU θ)).const_smul
          (((circleMap w R θ - w) ^ 2)⁻¹)).const_smul (deriv (circleMap w R) θ)))
    have h2 := key.2.const_smul ((2 * ↑Real.pi * Complex.I)⁻¹)
    rw [hcauchy (f' X) (hf' X haX hXb)]
    apply h2.congr_of_eventuallyEq
    filter_upwards [Ioo_mem_nhds haX hXb] with Y hY
    exact hcauchy (f Y) (hf Y hY.1 hY.2)

  have s3 : ∀ (a b C : ℝ) (U : Set ℂ) (f : ℝ → ℂ → ℂ), IsOpen U →
      ContinuousOn (fun p : ℝ × ℂ => f p.1 p.2) (Ioo a b ×ˢ U) →
      (∀ Y, a < Y → Y < b → DifferentiableOn ℂ (f Y) U) →
      (∀ Y z, a < Y → Y < b → z ∈ U → ‖f Y z‖ ≤ C) →
      ContinuousOn (fun p : ℝ × ℂ => deriv (f p.1) p.2) (Ioo a b ×ˢ U) := by
    intro a b C U f hU hjc hf hC
    apply continuousOn_of_forall_continuousAt
    rintro ⟨X0, w0⟩ ⟨hX0, hw0⟩
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hU w0 hw0
    obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = ε / 2 := ⟨_, rfl⟩
    have hR : 0 < R := by rw [hRdef]; linarith
    have hcb : Metric.closedBall w0 R ⊆ U :=
      (Metric.closedBall_subset_ball (by rw [hRdef]; linarith)).trans hball
    obtain ⟨hsub, hdγ, hdγc⟩ := hcirc w0 R hR
    have hγU : ∀ θ, circleMap w0 R θ ∈ U := fun θ =>
      hcb (Metric.sphere_subset_closedBall (circleMap_mem_sphere w0 hR.le θ))
    have hsep : ∀ θ (w : ℂ), w ∈ Metric.ball w0 (R / 2) → R / 2 < ‖circleMap w0 R θ - w‖ := by
      intro θ w hw
      rw [Metric.mem_ball, dist_eq_norm] at hw
      have := norm_sub_norm_le (circleMap w0 R θ - w0) (w - w0)
      rw [sub_sub_sub_cancel_right, hsub θ] at this
      linarith
    have hN : Ioo a b ×ˢ Metric.ball w0 (R / 2) ∈ nhds ((X0, w0) : ℝ × ℂ) :=
      (isOpen_Ioo.prod Metric.isOpen_ball).mem_nhds ⟨hX0, Metric.mem_ball_self (by linarith)⟩
    have hrep : ∀ q : ℝ × ℂ, q ∈ Ioo a b ×ˢ Metric.ball w0 (R / 2) → deriv (f q.1) q.2 =
        (2 * ↑Real.pi * Complex.I)⁻¹ • ∫ θ in (0:ℝ)..2 * Real.pi,
          deriv (circleMap w0 R) θ • (((circleMap w0 R θ - q.2) ^ 2)⁻¹ • f q.1 (circleMap w0 R θ)) := by
      rintro ⟨X, w⟩ ⟨hX, hw⟩
      rw [← Complex.two_pi_I_inv_smul_circleIntegral_sub_sq_inv_smul_of_differentiable hU hcb
        (hf X hX.1 hX.2) (Metric.ball_subset_ball (by linarith) hw), circleIntegral.eq_1]
    have hint : ContinuousAt (fun q : ℝ × ℂ => ∫ θ in (0:ℝ)..2 * Real.pi,
        deriv (circleMap w0 R) θ • (((circleMap w0 R θ - q.2) ^ 2)⁻¹ • f q.1 (circleMap w0 R θ)))
        (X0, w0) := by
      apply intervalIntegral.continuousAt_of_dominated_interval
        (bound := fun _ => R * (((R / 2) ^ 2)⁻¹ * |C|))
      · filter_upwards [hN] with q hq
        have e2 : Continuous (fun θ => ((circleMap w0 R θ - q.2) ^ 2)⁻¹) :=
          (((continuous_circleMap w0 R).sub continuous_const).pow 2).inv₀
            (fun θ => pow_ne_zero 2 (fun h => by
              have h' : circleMap w0 R θ - q.2 = 0 := h
              have := hsep θ q.2 hq.2
              rw [h', norm_zero] at this
              linarith))
        have e3 : Continuous (fun θ => f q.1 (circleMap w0 R θ)) :=
          (hf q.1 hq.1.1 hq.1.2).continuousOn.comp_continuous (continuous_circleMap w0 R) hγU
        exact (hdγc.smul (e2.smul e3)).aestronglyMeasurable
      · filter_upwards [hN] with q hq
        refine ae_of_all _ (fun θ _ => ?_)
        rw [norm_smul, norm_smul, norm_inv, norm_pow, hdγ θ]
        have hd := hsep θ q.2 hq.2
        have hfC : ‖f q.1 (circleMap w0 R θ)‖ ≤ |C| :=
          (hC _ _ hq.1.1 hq.1.2 (hγU θ)).trans (le_abs_self C)
        have hinv : (‖circleMap w0 R θ - q.2‖ ^ 2)⁻¹ ≤ ((R / 2) ^ 2)⁻¹ :=
          inv_anti₀ (by positivity) (pow_le_pow_left₀ (by positivity) hd.le 2)
        exact mul_le_mul_of_nonneg_left (mul_le_mul hinv hfC (norm_nonneg _) (by positivity)) hR.le
      · exact intervalIntegrable_const
      · refine ae_of_all _ (fun θ _ => ?_)
        have h1 : ContinuousAt (fun p : ℝ × ℂ => f p.1 p.2) (X0, circleMap w0 R θ) :=
          hjc.continuousAt ((isOpen_Ioo.prod hU).mem_nhds ⟨hX0, hγU θ⟩)
        have h1' : ContinuousAt (fun q : ℝ × ℂ => f q.1 (circleMap w0 R θ)) (X0, w0) := by
          have hc : ContinuousAt (fun q : ℝ × ℂ => ((q.1, circleMap w0 R θ) : ℝ × ℂ)) (X0, w0) :=
            (continuous_fst.prodMk continuous_const).continuousAt
          exact ContinuousAt.comp_of_eq (g := fun p : ℝ × ℂ => f p.1 p.2) h1 hc rfl
        have hne : (circleMap w0 R θ - (X0, w0).2) ^ 2 ≠ 0 := by
          apply pow_ne_zero
          intro h
          have := hsub θ
          simp only at h
          rw [h, norm_zero] at this
          linarith
        have h2 : ContinuousAt (fun q : ℝ × ℂ => ((circleMap w0 R θ - q.2) ^ 2)⁻¹) (X0, w0) :=
          ((continuous_const.sub continuous_snd).pow 2).continuousAt.inv₀ hne
        have h3 : ContinuousAt (fun q : ℝ × ℂ =>
            ((circleMap w0 R θ - q.2) ^ 2)⁻¹ • f q.1 (circleMap w0 R θ)) (X0, w0) :=
          h2.smul h1'
        have h4 : ContinuousAt (fun _ : ℝ × ℂ => deriv (circleMap w0 R) θ) (X0, w0) :=
          continuousAt_const
        exact h4.smul h3
    have h3 := hint.const_smul ((2 * ↑Real.pi * Complex.I)⁻¹)
    apply h3.congr
    filter_upwards [hN] with q hq
    exact (hrep q hq).symm

  intro Xi j φ hφ
  obtain ⟨ρ, C, hρ, hP⟩ := hφ
  obtain ⟨hUo, hsub, hdisc⟩ := s1 ρ hρ
  have hρ2 : 0 < ρ / 2 := by linarith
  have hS2 : ∀ k, k < j → ∀ X (w : ℂ), 0 < X → X < Xi → w ∈ cStrip (ρ / 2) →
      HasDerivAt (fun Y => deriv (fun z => iteratedDeriv k (fun Y' => φ Y' z) Y) w)
        (deriv (fun z => iteratedDeriv (k + 1) (fun Y' => φ Y' z) X) w) X := by
    intro k hk X w h0 h1 hw
    obtain ⟨-, hk2, hk3⟩ := hP k hk.le
    obtain ⟨-, hk2', -⟩ := hP (k + 1) hk
    exact s2 0 Xi (ρ / 2) C X (cStrip ρ) w (fun Y z => iteratedDeriv k (fun Y' => φ Y' z) Y)
      (fun Y z => iteratedDeriv (k + 1) (fun Y' => φ Y' z) Y) hUo hρ2 (hdisc w hw) h0 h1
      (fun Y a b => (hk2 Y a b).1) (fun Y a b => (hk2' Y a b).1)
      (fun Y z a b hz => (hk2' Y a b).2 z hz) (fun Y z a b hz => hk3 hk Y z a b hz)
  have hComm : ∀ k, k ≤ j → ∀ X (w : ℂ), 0 < X → X < Xi → w ∈ cStrip (ρ / 2) →
      iteratedDeriv k (fun Y => cDw φ Y w) X =
        deriv (fun z => iteratedDeriv k (fun Y => φ Y z) X) w := by
    intro k
    induction k with
    | zero =>
      intro _ X w _ _ _
      simp only [iteratedDeriv_zero] <;> rfl
    | succ k ih =>
      intro hk X w h0 h1 hw
      rw [iteratedDeriv_succ]
      have hev : iteratedDeriv k (fun Y => cDw φ Y w) =ᶠ[nhds X]
          fun Y => deriv (fun z => iteratedDeriv k (fun Y' => φ Y' z) Y) w := by
        filter_upwards [Ioo_mem_nhds h0 h1] with Y hY
        exact ih (by omega) Y w hY.1 hY.2 hw
      rw [hev.deriv_eq]
      exact (hS2 k (by omega) X w h0 h1 hw).deriv
  refine ⟨ρ / 2, C / (ρ / 2), hρ2, fun k hk =>
    ⟨?_, fun X h0 h1 => ⟨?_, fun w hw => ?_⟩, fun hkj X w h0 h1 hw => ?_⟩⟩
  · obtain ⟨hk1, hk2, -⟩ := hP k hk
    have hc := s3 0 Xi C (cStrip ρ) (fun Y z => iteratedDeriv k (fun Y' => φ Y' z) Y) hUo hk1
      (fun Y a b => (hk2 Y a b).1) (fun Y z a b hz => (hk2 Y a b).2 z hz)
    refine (hc.mono (prod_mono subset_rfl hsub)).congr ?_
    rintro ⟨X, w⟩ ⟨hX, hw⟩
    exact hComm k hk X w hX.1 hX.2 hw
  · obtain ⟨-, hk2, -⟩ := hP k hk
    refine (((hk2 X h0 h1).1.deriv hUo).mono hsub).congr ?_
    intro w hw
    exact hComm k hk X w h0 h1 hw
  · obtain ⟨-, hk2, -⟩ := hP k hk
    rw [hComm k hk X w h0 h1 hw]
    apply Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hρ2
    · apply DifferentiableOn.diffContOnCl
      rw [closure_ball w hρ2.ne']
      exact (hk2 X h0 h1).1.mono (hdisc w hw)
    · intro z hz
      exact (hk2 X h0 h1).2 z (hdisc w hw (Metric.sphere_subset_closedBall hz))
  · rw [hComm (k + 1) (by omega) X w h0 h1 hw]
    apply (hS2 k hkj X w h0 h1 hw).congr_of_eventuallyEq
    filter_upwards [Ioo_mem_nhds h0 h1] with Y hY
    exact hComm k hk Y w hY.1 hY.2 hw

theorem bgHoloC_cKer : ∀ (Xi : ℝ) (j : ℕ) (kk : ℝ → ℝ) (α β γ : ℝ) (φ : ℝ → ℂ → ℂ), 0 < Xi → (∀ t : ℝ, 0 < t → kk t = α + β * t + γ * Real.log t) → BgHoloC Xi j φ → BgHoloC Xi (j + 1) (cKer kk φ) :=
by
  intro Xi j kk α β γ φ hXi hkk hφ

  have s1 : ∀ (C : ℝ) (f : ℝ → ℂ) (X : ℝ),
      ContinuousOn f (Ioo 0 Xi) → (∀ Y : ℝ, 0 < Y → Y < Xi → ‖f Y‖ ≤ C) → 0 < X → X < Xi →
      HasDerivAt (fun Y : ℝ => (Y : ℂ) * ∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * f (t * Y))
        (((α + β : ℝ) : ℂ) * f X + ∫ t in (0:ℝ)..1, ((-β * t - γ : ℝ) : ℂ) * f (t * X)) X := by
    intro C f X hf hb hX0 hX1
    have hlogc : ContinuousOn (fun x : ℝ => ((Real.log x : ℝ) : ℂ)) (Ioo 0 Xi) :=
      Complex.continuous_ofReal.comp_continuousOn
        (Real.continuousOn_log.mono (fun x hx => hx.1.ne'))
    have hxc : ContinuousOn (fun x : ℝ => (x : ℂ)) (Ioo 0 Xi) :=
      Complex.continuous_ofReal.continuousOn
    have hf1 : ContinuousOn (fun x : ℝ => (x : ℂ) * f x) (Ioo 0 Xi) := hxc.mul hf
    have hfL : ContinuousOn (fun x : ℝ => ((Real.log x : ℝ) : ℂ) * f x) (Ioo 0 Xi) :=
      hlogc.mul hf
    have hII : ∀ (h : ℝ → ℂ) (B : ℝ → ℝ), ContinuousOn h (Ioo 0 Xi) →
        (∀ x, 0 < x → x < Xi → ‖h x‖ ≤ B x) → (∀ Y, IntervalIntegrable B volume 0 Y) →
        ∀ Y, 0 < Y → Y < Xi → IntervalIntegrable h volume 0 Y := by
      intro h B hh hB hBi Y h0 h1
      have hsub : Ioc 0 Y ⊆ Ioo 0 Xi := fun x hx => ⟨hx.1, lt_of_le_of_lt hx.2 h1⟩
      refine IntervalIntegrable.mono_fun' (hBi Y) ?_ ?_
      · rw [Set.uIoc_of_le h0.le]
        exact (hh.mono hsub).aestronglyMeasurable measurableSet_Ioc
      · rw [Set.uIoc_of_le h0.le]
        exact ae_restrict_of_forall_mem measurableSet_Ioc
          (fun x hx => hB x (hsub hx).1 (hsub hx).2)
    have i0 : ∀ Y, 0 < Y → Y < Xi → IntervalIntegrable f volume 0 Y :=
      hII f (fun _ => C) hf (fun x h0 h1 => hb x h0 h1) (fun _ => intervalIntegrable_const)
    have i1 : ∀ Y, 0 < Y → Y < Xi → IntervalIntegrable (fun x : ℝ => (x : ℂ) * f x) volume 0 Y :=
      hII _ (fun _ => Xi * C) hf1 (fun x h0 h1 => by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos h0]
        exact mul_le_mul h1.le (hb x h0 h1) (norm_nonneg _) (le_trans hX0.le hX1.le))
        (fun _ => intervalIntegrable_const)
    have iL : ∀ Y, 0 < Y → Y < Xi →
        IntervalIntegrable (fun x : ℝ => ((Real.log x : ℝ) : ℂ) * f x) volume 0 Y :=
      hII _ (fun x => C * |Real.log x|) hfL (fun x h0 h1 => by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_comm]
        exact mul_le_mul_of_nonneg_right (hb x h0 h1) (abs_nonneg _))
        (fun Y => (intervalIntegral.intervalIntegrable_log'.abs).const_mul C)
    have ftc : ∀ (h : ℝ → ℂ), ContinuousOn h (Ioo 0 Xi) → IntervalIntegrable h volume 0 X →
        HasDerivAt (fun u => ∫ x in (0:ℝ)..u, h x) (h X) X := fun h hh hi =>
      intervalIntegral.integral_hasDerivAt_right hi
        (hh.stronglyMeasurableAtFilter isOpen_Ioo X ⟨hX0, hX1⟩)
        (hh.continuousAt (Ioo_mem_nhds hX0 hX1))
    have star : ∀ Y, 0 < Y → Y < Xi →
        (Y : ℂ) * ∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * f (t * Y) =
        (α:ℂ) * (∫ x in (0:ℝ)..Y, f x) + (β:ℂ) * ((Y⁻¹:ℝ):ℂ) * (∫ x in (0:ℝ)..Y, (x:ℂ) * f x)
        + (γ:ℂ) * (∫ x in (0:ℝ)..Y, ((Real.log x:ℝ):ℂ) * f x)
        - (γ:ℂ) * ((Real.log Y:ℝ):ℂ) * (∫ x in (0:ℝ)..Y, f x) := by
      intro Y h0 h1
      have hYc : (Y:ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr h0.ne'
      obtain ⟨g, hg⟩ : ∃ g : ℝ → ℂ, g = fun x => (α:ℂ) * f x
          + ((β:ℂ) * ((Y⁻¹:ℝ):ℂ)) * ((x:ℂ) * f x)
          + (γ:ℂ) * (((Real.log x:ℝ):ℂ) * f x) - ((γ:ℂ) * ((Real.log Y:ℝ):ℂ)) * f x := ⟨_, rfl⟩
      have e1 : ∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * f (t * Y) = ∫ t in (0:ℝ)..1, g (t * Y) := by
        apply intervalIntegral.integral_congr_ae
        refine ae_of_all _ (fun t ht => ?_)
        rw [Set.uIoc_of_le zero_le_one] at ht
        simp only [hg]
        rw [hkk t ht.1, Real.log_mul ht.1.ne' h0.ne']
        simp only [Complex.ofReal_add, Complex.ofReal_mul, Complex.ofReal_inv]
        linear_combination (-((β:ℂ) * (t:ℂ) * f (t * Y))) * (inv_mul_cancel₀ hYc)
      have e2 := intervalIntegral.integral_comp_mul_right g h0.ne' (a := 0) (b := 1)
      simp only [zero_mul, one_mul] at e2
      have hA := (i0 Y h0 h1).const_mul (α:ℂ)
      have hB := (i1 Y h0 h1).const_mul ((β:ℂ) * ((Y⁻¹:ℝ):ℂ))
      have hL := (iL Y h0 h1).const_mul (γ:ℂ)
      have hD := (i0 Y h0 h1).const_mul ((γ:ℂ) * ((Real.log Y:ℝ):ℂ))
      have e3 : ∫ x in (0:ℝ)..Y, g x = (α:ℂ) * (∫ x in (0:ℝ)..Y, f x)
          + ((β:ℂ) * ((Y⁻¹:ℝ):ℂ)) * (∫ x in (0:ℝ)..Y, (x:ℂ) * f x)
          + (γ:ℂ) * (∫ x in (0:ℝ)..Y, ((Real.log x:ℝ):ℂ) * f x)
          - ((γ:ℂ) * ((Real.log Y:ℝ):ℂ)) * (∫ x in (0:ℝ)..Y, f x) := by
        simp only [hg]
        rw [intervalIntegral.integral_sub ((hA.add hB).add hL) hD,
          intervalIntegral.integral_add (hA.add hB) hL, intervalIntegral.integral_add hA hB]
        simp only [intervalIntegral.integral_const_mul]
      have hinvY : (Y:ℂ) * ((Y⁻¹:ℝ):ℂ) = 1 := by
        rw [Complex.ofReal_inv, mul_inv_cancel₀ hYc]
      rw [e1, e2, e3, Complex.real_smul, ← mul_assoc, hinvY, one_mul]
    have hXc : (X:ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hX0.ne'
    have dP := ftc f hf (i0 X hX0 hX1)
    have dP1 := ftc _ hf1 (i1 X hX0 hX1)
    have dPL := ftc _ hfL (iL X hX0 hX1)
    have dinv : HasDerivAt (fun y : ℝ => ((y⁻¹ : ℝ) : ℂ)) ((-(X^2)⁻¹ : ℝ) : ℂ) X :=
      (hasDerivAt_inv hX0.ne').ofReal_comp
    have dlog : HasDerivAt (fun y : ℝ => ((Real.log y : ℝ) : ℂ)) ((X⁻¹ : ℝ) : ℂ) X :=
      (Real.hasDerivAt_log hX0.ne').ofReal_comp
    have dR := (((dP.const_mul (α:ℂ)).add ((dinv.const_mul (β:ℂ)).mul dP1)).add
      (dPL.const_mul (γ:ℂ))).sub ((dlog.const_mul (γ:ℂ)).mul dP)
    have hT : ∫ t in (0:ℝ)..1, ((-β * t - γ : ℝ) : ℂ) * f (t * X) =
        ((X⁻¹:ℝ):ℂ) * (-(β:ℂ) * ((X⁻¹:ℝ):ℂ) * (∫ x in (0:ℝ)..X, (x:ℂ) * f x)
          - (γ:ℂ) * (∫ x in (0:ℝ)..X, f x)) := by
      obtain ⟨q, hq⟩ : ∃ q : ℝ → ℂ, q = fun x : ℝ => (-(β:ℂ) * ((X⁻¹:ℝ):ℂ)) * ((x:ℂ) * f x)
          - (γ:ℂ) * f x := ⟨_, rfl⟩
      have e1 : ∫ t in (0:ℝ)..1, ((-β * t - γ : ℝ) : ℂ) * f (t * X) =
          ∫ t in (0:ℝ)..1, q (t * X) := by
        apply intervalIntegral.integral_congr
        intro t _
        simp only [hq, Complex.ofReal_sub, Complex.ofReal_mul, Complex.ofReal_neg,
          Complex.ofReal_inv]
        linear_combination ((β:ℂ) * (t:ℂ) * f (t * X)) * (mul_inv_cancel₀ hXc)
      have e2 := intervalIntegral.integral_comp_mul_right q hX0.ne' (a := 0) (b := 1)
      simp only [zero_mul, one_mul] at e2
      have hB := (i1 X hX0 hX1).const_mul (-(β:ℂ) * ((X⁻¹:ℝ):ℂ))
      have hG := (i0 X hX0 hX1).const_mul (γ:ℂ)
      have e3 : ∫ x in (0:ℝ)..X, q x = -(β:ℂ) * ((X⁻¹:ℝ):ℂ) * (∫ x in (0:ℝ)..X, (x:ℂ) * f x)
          - (γ:ℂ) * (∫ x in (0:ℝ)..X, f x) := by
        simp only [hq]
        rw [intervalIntegral.integral_sub hB hG]
        simp only [intervalIntegral.integral_const_mul]
      rw [e1, e2, e3, Complex.real_smul]
    have hev : (fun Y : ℝ => (Y : ℂ) * ∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * f (t * Y)) =ᶠ[nhds X]
        (fun Y : ℝ => (α:ℂ) * (∫ x in (0:ℝ)..Y, f x)
          + (β:ℂ) * ((Y⁻¹:ℝ):ℂ) * (∫ x in (0:ℝ)..Y, (x:ℂ) * f x)
          + (γ:ℂ) * (∫ x in (0:ℝ)..Y, ((Real.log x:ℝ):ℂ) * f x)
          - (γ:ℂ) * ((Real.log Y:ℝ):ℂ) * (∫ x in (0:ℝ)..Y, f x)) :=
      Filter.eventuallyEq_of_mem (Ioo_mem_nhds hX0 hX1) (fun Y hY => star Y hY.1 hY.2)
    refine (dR.congr_of_eventuallyEq hev).congr_deriv ?_
    rw [hT]
    simp only [Complex.ofReal_add, Complex.ofReal_neg, Complex.ofReal_inv, Complex.ofReal_pow]
    linear_combination ((β:ℂ) * f X) * (mul_inv_cancel₀ hXc)

  have s2 : ∀ (κ : ℝ → ℝ) (g g' : ℝ → ℂ) (C X : ℝ), Continuous κ →
      ContinuousOn g' (Ioo 0 Xi) →
      (∀ Y, 0 < Y → Y < Xi → HasDerivAt g (g' Y) Y) →
      (∀ Y, 0 < Y → Y < Xi → ‖g Y‖ ≤ C ∧ ‖g' Y‖ ≤ C) → 0 < X → X < Xi →
      HasDerivAt (fun Y : ℝ => ∫ t in (0:ℝ)..1, ((κ t : ℝ) : ℂ) * g (t * Y))
        (∫ t in (0:ℝ)..1, ((t * κ t : ℝ) : ℂ) * g' (t * X)) X := by
    intro κ g g' C X hκ hg' hgd hb hX0 hX1
    obtain ⟨K, hK⟩ := (isCompact_Icc (a := (0:ℝ)) (b := 1)).exists_bound_of_continuousOn
      hκ.continuousOn
    have hK0 : 0 ≤ K := le_trans (norm_nonneg _) (hK 0 ⟨le_rfl, zero_le_one⟩)
    have hgc : ContinuousOn g (Ioo 0 Xi) := fun Y hY =>
      (hgd Y hY.1 hY.2).continuousAt.continuousWithinAt
    have hu : Set.uIoc (0:ℝ) 1 = Ioc 0 1 := Set.uIoc_of_le zero_le_one
    have hmaps : ∀ Y, 0 < Y → Y < Xi → ∀ t ∈ Ioc (0:ℝ) 1, t * Y ∈ Ioo 0 Xi := by
      intro Y h0 h1 t ht
      exact ⟨mul_pos ht.1 h0, by nlinarith [ht.1, ht.2]⟩
    have meas : ∀ (h : ℝ → ℂ) (κ' : ℝ → ℝ), Continuous κ' → ContinuousOn h (Ioo 0 Xi) →
        ∀ Y, 0 < Y → Y < Xi →
        AEStronglyMeasurable (fun t => ((κ' t : ℝ) : ℂ) * h (t * Y))
          (volume.restrict (Set.uIoc 0 1)) := by
      intro h κ' hκ' hh Y h0 h1
      rw [hu]
      apply ContinuousOn.aestronglyMeasurable _ measurableSet_Ioc
      exact (Complex.continuous_ofReal.comp hκ').continuousOn.mul
        (hh.comp (continuous_id.mul continuous_const).continuousOn (hmaps Y h0 h1))
    have hs : Ioo 0 Xi ∈ nhds X := Ioo_mem_nhds hX0 hX1
    have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le (𝕜 := ℝ)
      (μ := volume) (a := 0) (b := 1) (F := fun Y t => ((κ t : ℝ) : ℂ) * g (t * Y))
      (F' := fun Y t => ((t * κ t : ℝ) : ℂ) * g' (t * Y)) (x₀ := X)
      (bound := fun _ => K * C) hs
      (Filter.eventually_of_mem hs (fun Y hY => meas g κ hκ hgc Y hY.1 hY.2)) ?_
      (meas g' (fun t => t * κ t) (continuous_id.mul hκ) hg' X hX0 hX1) ?_
      intervalIntegrable_const ?_
    · exact key.2
    · refine IntervalIntegrable.mono_fun' (g := fun _ => K * C) intervalIntegrable_const
        (meas g κ hκ hgc X hX0 hX1) ?_
      refine (ae_restrict_iff' measurableSet_uIoc).2 (ae_of_all _ (fun t ht => ?_))
      rw [hu] at ht
      show ‖((κ t : ℝ) : ℂ) * g (t * X)‖ ≤ K * C
      rw [norm_mul, Complex.norm_real]
      exact mul_le_mul (hK t ⟨ht.1.le, ht.2⟩) (hb _ (hmaps X hX0 hX1 t ht).1
        (hmaps X hX0 hX1 t ht).2).1 (norm_nonneg _) hK0
    · refine ae_of_all _ (fun t ht Y hY => ?_)
      rw [hu] at ht
      show ‖((t * κ t : ℝ) : ℂ) * g' (t * Y)‖ ≤ K * C
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_mul, abs_of_pos ht.1]
      have h1 : t * |κ t| ≤ K := by
        have := hK t ⟨ht.1.le, ht.2⟩
        rw [Real.norm_eq_abs] at this
        nlinarith [abs_nonneg (κ t), ht.2]
      exact mul_le_mul h1 (hb _ (hmaps Y hY.1 hY.2 t ht).1 (hmaps Y hY.1 hY.2 t ht).2).2
        (norm_nonneg _) hK0
    · refine ae_of_all _ (fun t ht Y hY => ?_)
      rw [hu] at ht
      have hm := hmaps Y hY.1 hY.2 t ht
      have h1 : HasDerivAt (fun Y : ℝ => t * Y) t Y := by
        simpa using (hasDerivAt_id Y).const_mul t
      have h2 := (hgd (t * Y) hm.1 hm.2).scomp Y h1
      have h3 := h2.const_mul ((κ t : ℝ) : ℂ)
      refine h3.congr_deriv ?_
      rw [Complex.real_smul]
      push_cast
      ring

  have s3 : ∀ (a b : ℝ) (n : ℕ) (F : ℝ → ℂ) (G : ℕ → ℝ → ℂ),
      (∀ Y, a < Y → Y < b → HasDerivAt F (G 0 Y) Y) →
      (∀ m, m < n → ∀ Y, a < Y → Y < b → HasDerivAt (G m) (G (m+1) Y) Y) →
      (∀ m, m ≤ n → ∀ Y, a < Y → Y < b → iteratedDeriv (m+1) F Y = G m Y) ∧
      (∀ k, k ≤ n → ∀ Y, a < Y → Y < b →
        HasDerivAt (iteratedDeriv k F) (iteratedDeriv (k+1) F Y) Y) := by
    intro a b n F G hF hG
    have h1 : ∀ m, m ≤ n → ∀ Y, a < Y → Y < b → iteratedDeriv (m+1) F Y = G m Y := by
      intro m
      induction m with
      | zero =>
        intro _ Y h0 h1
        show iteratedDeriv 1 F Y = G 0 Y
        rw [iteratedDeriv_one]; exact (hF Y h0 h1).deriv
      | succ m ih =>
        intro hm Y h0 h1
        rw [iteratedDeriv_succ]
        have hev : iteratedDeriv (m+1) F =ᶠ[nhds Y] G m :=
          Filter.eventuallyEq_of_mem (Ioo_mem_nhds h0 h1) (fun Z hZ => ih (by omega) Z hZ.1 hZ.2)
        rw [hev.deriv_eq]
        exact (hG m (by omega) Y h0 h1).deriv
    refine ⟨h1, ?_⟩
    intro k hk Y h0 h1'
    cases k with
    | zero =>
      rw [iteratedDeriv_zero, h1 0 (Nat.zero_le _) Y h0 h1']
      exact hF Y h0 h1'
    | succ m =>
      have hev : iteratedDeriv (m+1) F =ᶠ[nhds Y] G m :=
        Filter.eventuallyEq_of_mem (Ioo_mem_nhds h0 h1') (fun Z hZ => h1 m (by omega) Z hZ.1 hZ.2)
      rw [h1 (m+1) hk Y h0 h1']
      exact (hG m (by omega) Y h0 h1').congr_of_eventuallyEq hev

  have s4 : ∀ (ρ C : ℝ) (κ : ℝ → ℝ) (ψ : ℝ → ℂ → ℂ), 0 < ρ →
      IntervalIntegrable κ volume 0 1 →
      ContinuousOn (fun p : ℝ × ℂ => ψ p.1 p.2) (Ioo 0 Xi ×ˢ cStrip ρ) →
      (∀ X, 0 < X → X < Xi → DifferentiableOn ℂ (ψ X) (cStrip ρ)) →
      (∀ X w, 0 < X → X < Xi → w ∈ cStrip ρ → ‖ψ X w‖ ≤ C) →
      ContinuousOn (fun p : ℝ × ℂ => ∫ t in (0:ℝ)..1, ((κ t : ℝ) : ℂ) * ψ (t * p.1) p.2)
        (Ioo 0 Xi ×ˢ cStrip ρ) ∧
      (∀ X, 0 < X → X < Xi →
        DifferentiableOn ℂ (fun w => ∫ t in (0:ℝ)..1, ((κ t : ℝ) : ℂ) * ψ (t * X) w) (cStrip ρ)) ∧
      ∀ X w, 0 < X → X < Xi → w ∈ cStrip ρ →
        ‖∫ t in (0:ℝ)..1, ((κ t : ℝ) : ℂ) * ψ (t * X) w‖ ≤ C * ∫ t in (0:ℝ)..1, |κ t| := by
    intro ρ C κ ψ _ hκ hc hd hb
    have hSo : IsOpen (cStrip ρ) := by
      have : cStrip ρ = {w : ℂ | |w.im| < ρ} ∩ ({w : ℂ | -1 - ρ < w.re} ∩ {w : ℂ | w.re < 1 + ρ}) := by
        ext w; simp [cStrip]
      rw [this]
      exact (isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).inter
        ((isOpen_lt continuous_const Complex.continuous_re).inter
          (isOpen_lt Complex.continuous_re continuous_const))
    have hΩo : IsOpen (Ioo 0 Xi ×ˢ cStrip ρ) := isOpen_Ioo.prod hSo
    have hu : Set.uIoc (0:ℝ) 1 = Ioc 0 1 := Set.uIoc_of_le zero_le_one
    have hmapsT : ∀ X, 0 < X → X < Xi → ∀ t ∈ Ioc (0:ℝ) 1, t * X ∈ Ioo 0 Xi := by
      intro X h0 h1 t ht
      exact ⟨mul_pos ht.1 h0, by nlinarith [ht.1, ht.2]⟩
    have contT : ∀ X w, 0 < X → X < Xi → w ∈ cStrip ρ →
        ContinuousOn (fun t : ℝ => ψ (t * X) w) (Ioc 0 1) := by
      intro X w h0 h1 hw
      exact hc.comp (f := fun t : ℝ => (t * X, w)) (by fun_prop)
        (fun t ht => ⟨hmapsT X h0 h1 t ht, hw⟩)
    have hκm : AEStronglyMeasurable (fun t => ((κ t : ℝ) : ℂ)) (volume.restrict (Set.uIoc 0 1)) := by
      rw [hu]; exact Complex.continuous_ofReal.comp_aestronglyMeasurable hκ.aestronglyMeasurable
    have meas : ∀ g : ℝ → ℂ, ContinuousOn g (Ioc 0 1) →
        AEStronglyMeasurable (fun t => ((κ t : ℝ) : ℂ) * g t) (volume.restrict (Set.uIoc 0 1)) := by
      intro g hg
      have : AEStronglyMeasurable g (volume.restrict (Set.uIoc 0 1)) := by
        rw [hu]; exact hg.aestronglyMeasurable measurableSet_Ioc
      exact hκm.mul this
    have hbi : IntervalIntegrable (fun t => C * |κ t|) volume 0 1 := hκ.abs.const_mul C
    have bnd : ∀ X w, 0 < X → X < Xi → w ∈ cStrip ρ → ∀ t ∈ Ioc (0:ℝ) 1,
        ‖((κ t : ℝ) : ℂ) * ψ (t * X) w‖ ≤ C * |κ t| := by
      intro X w h0 h1 hw t ht
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_comm]
      exact mul_le_mul_of_nonneg_right
        (hb _ w (hmapsT X h0 h1 t ht).1 (hmapsT X h0 h1 t ht).2 hw) (abs_nonneg _)
    refine ⟨?_, ?_, ?_⟩
    ·
      intro p hp
      apply ContinuousAt.continuousWithinAt
      apply intervalIntegral.continuousAt_of_dominated_interval (bound := fun t => C * |κ t|)
      · filter_upwards [hΩo.mem_nhds hp] with q hq
        exact meas _ (contT q.1 q.2 hq.1.1 hq.1.2 hq.2)
      · filter_upwards [hΩo.mem_nhds hp] with q hq
        refine (ae_restrict_iff' measurableSet_uIoc).1 ?_
        rw [hu]
        exact ae_restrict_of_forall_mem measurableSet_Ioc
          (fun t ht => bnd q.1 q.2 hq.1.1 hq.1.2 hq.2 t ht)
      · exact hbi
      · refine ae_of_all _ (fun t ht => ?_)
        rw [hu] at ht
        have hmem : (t * p.1, p.2) ∈ Ioo 0 Xi ×ˢ cStrip ρ :=
          ⟨hmapsT p.1 hp.1.1 hp.1.2 t ht, hp.2⟩
        have h1 : ContinuousAt (fun q : ℝ × ℂ => ψ q.1 q.2) (t * p.1, p.2) :=
          hc.continuousAt (hΩo.mem_nhds hmem)
        have h2 : ContinuousAt (fun q : ℝ × ℂ => ψ (t * q.1) q.2) p :=
          h1.comp (f := fun q : ℝ × ℂ => (t * q.1, q.2)) (by fun_prop)
        exact continuousAt_const.mul h2
    ·
      intro X h0 h1 w0 hw0
      obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hSo w0 hw0
      set r := ε / 2 with hr
      have hr0 : 0 < r := by positivity
      have hs : Metric.ball w0 (r / 2) ∈ nhds w0 := Metric.ball_mem_nhds w0 (by positivity)
      have hsS : Metric.ball w0 (r / 2) ⊆ cStrip ρ := fun z hz =>
        hball (Metric.ball_subset_ball (by linarith) hz)
      have hdT : ∀ t ∈ Ioc (0:ℝ) 1, DifferentiableOn ℂ (ψ (t * X)) (cStrip ρ) := fun t ht =>
        hd _ (hmapsT X h0 h1 t ht).1 (hmapsT X h0 h1 t ht).2
      have hderb : ∀ t ∈ Ioc (0:ℝ) 1, ∀ w ∈ Metric.ball w0 (r / 2),
          ‖deriv (ψ (t * X)) w‖ ≤ C / r := by
        intro t ht w hw
        have hcl : Metric.closedBall w r ⊆ cStrip ρ := by
          intro z hz
          apply hball
          rw [Metric.mem_ball]
          rw [Metric.mem_closedBall] at hz
          rw [Metric.mem_ball] at hw
          calc dist z w0 ≤ dist z w + dist w w0 := dist_triangle _ _ _
            _ < ε := by linarith
        apply Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr0
        · apply DifferentiableOn.diffContOnCl
          rw [closure_ball w hr0.ne']
          exact (hdT t ht).mono hcl
        · intro z hz
          exact hb _ z (hmapsT X h0 h1 t ht).1 (hmapsT X h0 h1 t ht).2
            (hcl (Metric.sphere_subset_closedBall hz))

      obtain ⟨hn, hhn⟩ : ∃ hn : ℕ → ℝ, hn = fun n : ℕ => ε / 2 * (1 / ((n : ℝ) + 1)) := ⟨_, rfl⟩
      have hnpos : ∀ n, 0 < hn n := fun n => by rw [hhn]; positivity
      have hnlt : ∀ n, hn n < ε := by
        intro n
        rw [hhn]
        have : 1 / ((n : ℝ) + 1) ≤ 1 := by
          rw [div_le_one (by positivity)]; linarith [(Nat.cast_nonneg n : (0:ℝ) ≤ n)]
        nlinarith
      have hnmem : ∀ n, w0 + ((hn n : ℝ) : ℂ) ∈ cStrip ρ := by
        intro n
        apply hball
        rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, Complex.norm_real,
          Real.norm_eq_abs, abs_of_pos (hnpos n)]
        exact hnlt n
      have htend : Filter.Tendsto (fun n => ((hn n : ℝ) : ℂ)) Filter.atTop
          (nhdsWithin 0 {0}ᶜ) := by
        apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
        · have h1 : Filter.Tendsto hn Filter.atTop (nhds 0) := by
            rw [hhn]
            have := tendsto_one_div_add_atTop_nhds_zero_nat.const_mul (ε / 2)
            simpa using this
          have := (Complex.continuous_ofReal.tendsto 0).comp h1
          rw [Complex.ofReal_zero] at this
          exact this
        · exact Filter.Eventually.of_forall (fun n => by
            simp only [mem_compl_iff, mem_singleton_iff, Complex.ofReal_eq_zero]
            exact (hnpos n).ne')
      have hmF' : AEStronglyMeasurable (fun t => ((κ t : ℝ) : ℂ) * deriv (ψ (t * X)) w0)
          (volume.restrict (Set.uIoc 0 1)) := by
        apply aestronglyMeasurable_of_tendsto_ae Filter.atTop
          (f := fun n t => ((κ t : ℝ) : ℂ) * ((((hn n : ℝ) : ℂ))⁻¹ •
            (ψ (t * X) (w0 + ((hn n : ℝ) : ℂ)) - ψ (t * X) w0)))
        · intro n
          apply meas
          exact ((contT X _ h0 h1 (hnmem n)).sub (contT X w0 h0 h1 hw0)).const_smul
            (((hn n : ℝ) : ℂ))⁻¹
        · rw [hu]
          refine ae_restrict_of_forall_mem measurableSet_Ioc (fun t ht => ?_)
          have hda : HasDerivAt (ψ (t * X)) (deriv (ψ (t * X)) w0) w0 :=
            ((hdT t ht).differentiableAt (hSo.mem_nhds hw0)).hasDerivAt
          exact (hda.tendsto_slope_zero.comp htend).const_mul _
      have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le (𝕜 := ℂ)
        (μ := volume) (a := 0) (b := 1) (F := fun w t => ((κ t : ℝ) : ℂ) * ψ (t * X) w)
        (F' := fun w t => ((κ t : ℝ) : ℂ) * deriv (ψ (t * X)) w) (x₀ := w0)
        (bound := fun t => C / r * |κ t|) hs
        (by
          filter_upwards [hSo.mem_nhds hw0] with w hw
          exact meas _ (contT X w h0 h1 hw))
        (by
          refine IntervalIntegrable.mono_fun' hbi (meas _ (contT X w0 h0 h1 hw0)) ?_
          refine (ae_restrict_iff' measurableSet_uIoc).2 (ae_of_all _ (fun t ht => ?_))
          rw [hu] at ht
          exact bnd X w0 h0 h1 hw0 t ht)
        hmF'
        (by
          refine ae_of_all _ (fun t ht w hw => ?_)
          rw [hu] at ht
          show ‖((κ t : ℝ) : ℂ) * deriv (ψ (t * X)) w‖ ≤ C / r * |κ t|
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_comm]
          exact mul_le_mul_of_nonneg_right (hderb t ht w hw) (abs_nonneg _))
        (hκ.abs.const_mul (C / r))
        (by
          refine ae_of_all _ (fun t ht w hw => ?_)
          rw [hu] at ht
          have hda : HasDerivAt (ψ (t * X)) (deriv (ψ (t * X)) w) w :=
            ((hdT t ht).differentiableAt (hSo.mem_nhds (hsS hw))).hasDerivAt
          exact hda.const_mul _)
      exact key.2.differentiableAt.differentiableWithinAt
    ·
      intro X w h0 h1 hw
      calc ‖∫ t in (0:ℝ)..1, ((κ t : ℝ) : ℂ) * ψ (t * X) w‖ ≤ ∫ t in (0:ℝ)..1, C * |κ t| :=
            intervalIntegral.norm_integral_le_of_norm_le zero_le_one
              (ae_of_all _ (fun t ht => bnd X w h0 h1 hw t ht)) hbi
        _ = C * ∫ t in (0:ℝ)..1, |κ t| := intervalIntegral.integral_const_mul _ _


  obtain ⟨ρ, C, hρ, hφk⟩ := hφ
  have hu : Set.uIoc (0:ℝ) 1 = Ioc 0 1 := Set.uIoc_of_le zero_le_one
  have hkkI : IntervalIntegrable kk volume 0 1 := by
    have h0 : IntervalIntegrable (fun t : ℝ => α + β * t + γ * Real.log t) volume 0 1 :=
      (intervalIntegrable_const.add ((continuous_const.mul continuous_id).intervalIntegrable 0 1)).add
        (intervalIntegral.intervalIntegrable_log'.const_mul γ)
    refine h0.congr (fun t ht => ?_)
    rw [hu] at ht
    exact (hkk t ht.1).symm
  obtain ⟨K0, hK0d⟩ : ∃ K0 : ℝ, K0 = ∫ t in (0:ℝ)..1, |kk t| := ⟨_, rfl⟩
  have hK0 : 0 ≤ K0 := by
    rw [hK0d]; exact intervalIntegral.integral_nonneg zero_le_one (fun u _ => abs_nonneg _)
  have hκc : ∀ m : ℕ, Continuous (fun t : ℝ => (-β * t - γ) * t ^ m) := fun m => by fun_prop
  have hκb : ∀ m : ℕ, ∫ t in (0:ℝ)..1, |(-β * t - γ) * t ^ m| ≤ |β| + |γ| := by
    intro m
    have hle : ∫ t in (0:ℝ)..1, |(-β * t - γ) * t ^ m| ≤ ∫ t in (0:ℝ)..1, (|β| + |γ|) := by
      apply intervalIntegral.integral_mono_on zero_le_one ((hκc m).abs.intervalIntegrable 0 1)
        intervalIntegrable_const
      intro t ht
      have h1 : |-β * t - γ| ≤ |β| + |γ| := by
        have a1 := le_abs_self (β * t)
        have a2 := neg_abs_le (β * t)
        have a3 := le_abs_self γ
        have a4 := neg_abs_le γ
        have e : |β * t| = |β| * t := by rw [abs_mul, abs_of_nonneg ht.1]
        have a5 := mul_le_of_le_one_right (abs_nonneg β) ht.2
        rw [abs_le]; constructor <;> nlinarith
      rw [abs_mul, abs_pow, abs_of_nonneg ht.1]
      calc |-β * t - γ| * t ^ m ≤ (|β| + |γ|) * 1 :=
            mul_le_mul h1 (pow_le_one₀ ht.1 ht.2) (pow_nonneg ht.1 m) (by positivity)
        _ = |β| + |γ| := mul_one _
    rw [intervalIntegral.integral_const] at hle
    simpa using hle

  obtain ⟨Gf, hGf⟩ : ∃ Gf : ℕ → ℝ → ℂ → ℂ, Gf = fun m Y w =>
      ((α + β : ℝ) : ℂ) * iteratedDeriv m (fun Y' => φ Y' w) Y +
        ∫ t in (0:ℝ)..1, (((-β * t - γ) * t ^ m : ℝ) : ℂ) * iteratedDeriv m (fun Y' => φ Y' w) (t * Y) :=
    ⟨_, rfl⟩
  have hDc : ∀ m, m ≤ j → ∀ w ∈ cStrip ρ,
      ContinuousOn (fun Y => iteratedDeriv m (fun Y' => φ Y' w) Y) (Ioo 0 Xi) := by
    intro m hm w hw
    exact (hφk m hm).1.comp (f := fun Y : ℝ => (Y, w)) (by fun_prop) (fun Y hY => ⟨hY, hw⟩)
  have hDb : ∀ m, m ≤ j → ∀ w ∈ cStrip ρ, ∀ Y, 0 < Y → Y < Xi →
      ‖iteratedDeriv m (fun Y' => φ Y' w) Y‖ ≤ C := fun m hm w hw Y h0 h1 =>
    ((hφk m hm).2.1 Y h0 h1).2 w hw
  have perw : ∀ w ∈ cStrip ρ,
      (∀ m, m ≤ j → ∀ Y, 0 < Y → Y < Xi →
        iteratedDeriv (m+1) (fun Y => cKer kk φ Y w) Y = Gf m Y w) ∧
      (∀ k, k ≤ j → ∀ Y, 0 < Y → Y < Xi →
        HasDerivAt (iteratedDeriv k (fun Y => cKer kk φ Y w))
          (iteratedDeriv (k+1) (fun Y => cKer kk φ Y w) Y) Y) := by
    intro w hw
    apply s3 0 Xi j (fun Y => cKer kk φ Y w) (fun m Y => Gf m Y w)
    · intro Y h0 h1
      have hc0 : ContinuousOn (fun Y => φ Y w) (Ioo 0 Xi) := by
        simpa only [iteratedDeriv_zero] using hDc 0 (Nat.zero_le _) w hw
      have hb0 : ∀ Y, 0 < Y → Y < Xi → ‖φ Y w‖ ≤ C := by
        intro Y h0 h1
        simpa only [iteratedDeriv_zero] using hDb 0 (Nat.zero_le _) w hw Y h0 h1
      refine (s1 C (fun Y => φ Y w) Y hc0 hb0 h0 h1).congr_deriv ?_
      rw [hGf]
      simp only [iteratedDeriv_zero, pow_zero, mul_one]
    · intro m hm Y h0 h1
      have hd : ∀ Y, 0 < Y → Y < Xi → HasDerivAt (fun Y => iteratedDeriv m (fun Y' => φ Y' w) Y)
          (iteratedDeriv (m+1) (fun Y' => φ Y' w) Y) Y := fun Y h0 h1 =>
        (hφk m hm.le).2.2 hm Y w h0 h1 hw
      have h2 := s2 (fun t => (-β * t - γ) * t ^ m) (fun Y => iteratedDeriv m (fun Y' => φ Y' w) Y)
        (fun Y => iteratedDeriv (m+1) (fun Y' => φ Y' w) Y) C Y (hκc m)
        (hDc (m+1) (by omega) w hw) hd
        (fun Y h0 h1 => ⟨hDb m hm.le w hw Y h0 h1, hDb (m+1) (by omega) w hw Y h0 h1⟩) h0 h1
      have h3 := ((hd Y h0 h1).const_mul ((α + β : ℝ) : ℂ)).add h2
      have e : ∀ t : ℝ, t * ((-β * t - γ) * t ^ m) = (-β * t - γ) * t ^ (m + 1) := fun t => by ring
      rw [hGf]
      simp only [e] at h3
      exact h3
  refine ⟨ρ, Xi * (|C| * K0) + (|α + β| + |β| + |γ|) * |C|, hρ, fun k hk => ?_⟩
  have hC' : 0 ≤ Xi * (|C| * K0) := by positivity
  have hC'' : 0 ≤ (|α + β| + |β| + |γ|) * |C| := by positivity
  rcases k with _ | m
  ·
    have hc : ContinuousOn (fun p : ℝ × ℂ => φ p.1 p.2) (Ioo 0 Xi ×ˢ cStrip ρ) := by
      simpa only [iteratedDeriv_zero] using (hφk 0 (Nat.zero_le _)).1
    have hd : ∀ X, 0 < X → X < Xi → DifferentiableOn ℂ (φ X) (cStrip ρ) := by
      intro X h0 h1
      simpa only [iteratedDeriv_zero] using ((hφk 0 (Nat.zero_le _)).2.1 X h0 h1).1
    have hb : ∀ X w, 0 < X → X < Xi → w ∈ cStrip ρ → ‖φ X w‖ ≤ C := by
      intro X w h0 h1 hw
      simpa only [iteratedDeriv_zero] using hDb 0 (Nat.zero_le _) w hw X h0 h1
    obtain ⟨m1, m2, m3⟩ := s4 ρ C kk φ hρ hkkI hc hd hb
    simp only [iteratedDeriv_zero]
    refine ⟨?_, fun X h0 h1 => ⟨?_, fun w hw => ?_⟩, fun _ X w h0 h1 hw => ?_⟩
    · exact (Complex.continuous_ofReal.comp continuous_fst).continuousOn.mul m1
    · exact (m2 X h0 h1).const_mul (X : ℂ)
    · show ‖(X : ℂ) * ∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * φ (t * X) w‖ ≤ _
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos h0]
      have h3 : ‖∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * φ (t * X) w‖ ≤ |C| * K0 := by
        refine (m3 X w h0 h1 hw).trans ?_
        rw [← hK0d]
        exact mul_le_mul_of_nonneg_right (le_abs_self C) hK0
      have h4 : X * ‖∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * φ (t * X) w‖ ≤ Xi * (|C| * K0) :=
        mul_le_mul h1.le h3 (norm_nonneg _) hXi.le
      linarith
    · have := (perw w hw).2 0 (Nat.zero_le _) X h0 h1
      simpa only [iteratedDeriv_zero] using this
  ·
    have hm : m ≤ j := by omega
    obtain ⟨m1, m2, m3⟩ := s4 ρ C (fun t => (-β * t - γ) * t ^ m)
      (fun Y w => iteratedDeriv m (fun Y' => φ Y' w) Y) hρ ((hκc m).intervalIntegrable 0 1)
      (hφk m hm).1 (fun X h0 h1 => ((hφk m hm).2.1 X h0 h1).1)
      (fun X w h0 h1 hw => hDb m hm w hw X h0 h1)
    have heq : ∀ p ∈ Ioo 0 Xi ×ˢ cStrip ρ,
        iteratedDeriv (m+1) (fun Y => cKer kk φ Y p.2) p.1 = Gf m p.1 p.2 := fun p hp =>
      (perw p.2 hp.2).1 m hm p.1 hp.1.1 hp.1.2
    refine ⟨?_, fun X h0 h1 => ⟨?_, fun w hw => ?_⟩, fun hlt X w h0 h1 hw => ?_⟩
    · refine ContinuousOn.congr ?_ heq
      rw [hGf]
      exact (continuousOn_const.mul (hφk m hm).1).add m1
    · refine DifferentiableOn.congr ?_ (fun w hw => (perw w hw).1 m hm X h0 h1)
      rw [hGf]
      exact (((hφk m hm).2.1 X h0 h1).1.const_mul _).add (m2 X h0 h1)
    · rw [(perw w hw).1 m hm X h0 h1, hGf]
      refine (norm_add_le _ _).trans ?_
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
      have a1 : |α + β| * ‖iteratedDeriv m (fun Y' => φ Y' w) X‖ ≤ |α + β| * |C| :=
        mul_le_mul_of_nonneg_left ((hDb m hm w hw X h0 h1).trans (le_abs_self C)) (abs_nonneg _)
      have a2 := m3 X w h0 h1 hw
      have a3 : C * ∫ t in (0:ℝ)..1, |(-β * t - γ) * t ^ m| ≤ |C| * (|β| + |γ|) := by
        have hI0 : 0 ≤ ∫ t in (0:ℝ)..1, |(-β * t - γ) * t ^ m| :=
          intervalIntegral.integral_nonneg zero_le_one (fun u _ => abs_nonneg _)
        calc C * ∫ t in (0:ℝ)..1, |(-β * t - γ) * t ^ m|
            ≤ |C| * ∫ t in (0:ℝ)..1, |(-β * t - γ) * t ^ m| :=
              mul_le_mul_of_nonneg_right (le_abs_self C) hI0
          _ ≤ |C| * (|β| + |γ|) := mul_le_mul_of_nonneg_left (hκb m) (abs_nonneg _)
      have a4 : |α + β| * |C| + |C| * (|β| + |γ|) = (|α + β| + |β| + |γ|) * |C| := by ring
      linarith
    · exact (perw w hw).2 (m+1) (by omega) X h0 h1

theorem bg_complex_regularity : ∀ (Xi ρ : ℝ) (ac : Fin 6 → ℝ → ℂ → ℂ) (bc : Fin 8 → ℝ → ℂ → ℂ) (gc sc1 sc2 ψ1 ψ2 : ℝ → ℂ → ℂ), 0 < Xi → 0 < ρ → (∀ j i, BgHoloC Xi j (ac i)) → (∀ j i, BgHoloC Xi j (bc i)) → (∀ j, BgHoloC Xi j gc) → (∀ j, BgHoloC Xi j sc1) → (∀ j, BgHoloC Xi j sc2) → BgHoloC Xi 0 ψ1 → BgHoloC Xi 0 ψ2 → (∀ X w, 0 < X → X < Xi → w ∈ cStrip ρ → ψ1 X w = bgT1 ac ψ1 ψ2 X w + sc1 X w ∧ ψ2 X w = bgT2 bc gc ψ1 ψ2 X w + sc2 X w) → ∀ j, BgHoloC Xi j ψ1 ∧ BgHoloC Xi j ψ2 :=
by
  intro Xi ρ ac bc gc sc1 sc2 ψ1 ψ2 hXi hρ hac hbc hgc hs1 hs2 h1 h2 hfix

  have hmono : ∀ (j : ℕ) (φ : ℝ → ℂ → ℂ), BgHoloC Xi (j + 1) φ → BgHoloC Xi j φ := by
    rintro j φ ⟨r, C, hr, h⟩
    refine ⟨r, C, hr, fun k hk => ?_⟩
    obtain ⟨a, b, c⟩ := h k (by omega)
    exact ⟨a, b, fun hkj => c (by omega)⟩

  have hcongr : ∀ (j : ℕ) (ρ0 : ℝ) (φ χ : ℝ → ℂ → ℂ), 0 < ρ0 →
      (∀ X w, 0 < X → X < Xi → w ∈ cStrip ρ0 → φ X w = χ X w) →
      BgHoloC Xi j χ → BgHoloC Xi j φ := by
    rintro j ρ0 φ χ hρ0 heq ⟨r, C, hr, h⟩
    have hsub : ∀ s t : ℝ, s ≤ t → cStrip s ⊆ cStrip t := by
      intro s t hst w hw
      simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
      exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
    have hs1 : cStrip (min r ρ0) ⊆ cStrip r := hsub _ _ (min_le_left _ _)
    have hs2 : cStrip (min r ρ0) ⊆ cStrip ρ0 := hsub _ _ (min_le_right _ _)
    have hid : ∀ (k : ℕ) (X : ℝ) (w : ℂ), 0 < X → X < Xi → w ∈ cStrip (min r ρ0) →
        iteratedDeriv k (fun Y => φ Y w) X = iteratedDeriv k (fun Y => χ Y w) X := by
      intro k X w h0 h1 hw
      apply Filter.EventuallyEq.iteratedDeriv_eq
      filter_upwards [Ioo_mem_nhds h0 h1] with Y hY
      exact heq Y w hY.1 hY.2 (hs2 hw)
    refine ⟨min r ρ0, C, lt_min hr hρ0, fun k hk => ?_⟩
    obtain ⟨c1, c2, c3⟩ := h k hk
    refine ⟨?_, fun X h0 h1' => ⟨?_, fun w hw => ?_⟩, fun hkj X w h0 h1' hw => ?_⟩
    · exact (c1.mono (Set.prod_mono subset_rfl hs1)).congr
        (fun p hp => hid k p.1 p.2 hp.1.1 hp.1.2 hp.2)
    · exact ((c2 X h0 h1').1.mono hs1).congr (fun w hw => hid k X w h0 h1' hw)
    · rw [hid k X w h0 h1' hw]
      exact (c2 X h0 h1').2 w (hs1 hw)
    · rw [hid (k + 1) X w h0 h1' hw]
      apply (c3 hkj X w h0 h1' (hs1 hw)).congr_of_eventuallyEq
      filter_upwards [Ioo_mem_nhds h0 h1'] with Y hY
      exact hid k Y w hY.1 hY.2 hw

  have hD1 : deriv (fun Y : ℝ => (Y : ℂ)) = fun _ => 1 := by
    funext x
    exact ((hasDerivAt_id x).ofReal_comp).deriv.trans (by simp)
  have hD1' : iteratedDeriv 1 (fun Y : ℝ => (Y : ℂ)) = fun _ => 1 := by
    rw [iteratedDeriv_one, hD1]
  have hZ : ∀ k : ℕ, iteratedDeriv k (fun _ : ℝ => (0 : ℂ)) = fun _ => 0 := by
    intro k
    induction k with
    | zero => simp
    | succ k ih => rw [iteratedDeriv_succ, ih]; simp
  have hDk : ∀ n : ℕ, 2 ≤ n → iteratedDeriv n (fun Y : ℝ => (Y : ℂ)) = fun _ => 0 := by
    intro n hn
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 + 1 := ⟨n - 2, by omega⟩
    rw [iteratedDeriv_succ', iteratedDeriv_succ', hD1]
    simp only [deriv_const']
    exact hZ m
  have hX : ∀ j : ℕ, BgHoloC Xi j (fun X _ => ((X : ℝ) : ℂ)) := by
    intro j
    refine ⟨1, Xi + 1, one_pos, fun k hk => ?_⟩
    show ContinuousOn (fun p : ℝ × ℂ => iteratedDeriv k (fun Y : ℝ => (Y : ℂ)) p.1)
        (Ioo 0 Xi ×ˢ cStrip 1) ∧
      (∀ X, 0 < X → X < Xi →
        DifferentiableOn ℂ (fun _ : ℂ => iteratedDeriv k (fun Y : ℝ => (Y : ℂ)) X) (cStrip 1) ∧
        ∀ w ∈ cStrip 1, ‖iteratedDeriv k (fun Y : ℝ => (Y : ℂ)) X‖ ≤ Xi + 1) ∧
      (k < j → ∀ X (w : ℂ), 0 < X → X < Xi → w ∈ cStrip 1 →
        HasDerivAt (fun Y => iteratedDeriv k (fun Y' : ℝ => (Y' : ℂ)) Y)
          (iteratedDeriv (k + 1) (fun Y : ℝ => (Y : ℂ)) X) X)
    have hcases : k = 0 ∨ k = 1 ∨ 2 ≤ k := by omega
    rcases hcases with rfl | rfl | hk2
    · rw [iteratedDeriv_zero, zero_add, hD1']
      refine ⟨(Complex.continuous_ofReal.comp continuous_fst).continuousOn,
        fun X h0 _ => ⟨differentiableOn_const _, fun w _ => ?_⟩, fun _ X w _ _ _ => ?_⟩
      · rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos h0]; linarith
      · simpa using (hasDerivAt_id X).ofReal_comp
    · rw [hDk (1 + 1) (by norm_num), hD1']
      refine ⟨continuousOn_const, fun X _ _ => ⟨differentiableOn_const _, fun w _ => ?_⟩,
        fun _ X w _ _ _ => hasDerivAt_const X (1 : ℂ)⟩
      simp only [norm_one]; linarith
    · rw [hDk (k + 1) (by omega), hDk k hk2]
      refine ⟨continuousOn_const, fun X _ _ => ⟨differentiableOn_const _, fun w _ => ?_⟩,
        fun _ X w _ _ _ => hasDerivAt_const X (0 : ℂ)⟩
      simp only [norm_zero]; linarith

  have hRad : ∀ (j : ℕ) (φ : ℝ → ℂ → ℂ), BgHoloC Xi j φ → BgHoloC Xi (j + 1) (cRad φ) := by
    intro j φ hφ
    have hK := bgHoloC_cKer Xi j (fun _ => 1) 1 0 0 φ hXi (fun t _ => by ring) hφ
    refine hcongr (j + 1) 1 (cRad φ) (cKer (fun _ => 1) φ) one_pos (fun X w h0 _ _ => ?_) hK
    have hX0 : X ≠ 0 := h0.ne'
    have hsub := intervalIntegral.integral_comp_mul_right (fun x => φ x w) hX0 (a := 0) (b := 1)
    simp only [zero_mul, one_mul] at hsub
    unfold cRad cKer
    simp only [Complex.ofReal_one, one_mul]
    rw [hsub]
    have hXc : (X : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hX0
    rw [Complex.real_smul, Complex.ofReal_inv, ← mul_assoc, mul_inv_cancel₀ hXc, one_mul]

  have tG : ∀ t : ℝ, 0 < t → bgkG t = 1 / 2 + (-1 / 2) * t + 0 * Real.log t := by
    intro t _; unfold bgkG; ring
  have tGp : ∀ t : ℝ, 0 < t → bgkGp t = 0 + (1 / 2) * t + 0 * Real.log t := by
    intro t _; unfold bgkGp; ring
  have tU : ∀ t : ℝ, 0 < t → bgkU t = 0 + 0 * t + (-1 / 2) * Real.log t := by
    intro t _; unfold bgkU; ring
  have tUp : ∀ t : ℝ, 0 < t → bgkUp t = 1 / 2 + 0 * t + 0 * Real.log t := by
    intro t _; unfold bgkUp; ring
  have tS : ∀ t : ℝ, 0 < t → bgkS t = -1 / 2 + (1 / 2) * t + (-1 / 2) * Real.log t := by
    intro t _; unfold bgkS; ring

  intro j
  induction j with
  | zero => exact ⟨h1, h2⟩
  | succ j ih =>
    obtain ⟨i1, i2⟩ := ih
    have d1 : BgHoloC Xi j (cDw ψ1) := bgHoloC_cDw Xi j ψ1 i1
    have d2 : BgHoloC Xi j (cDw ψ2) := bgHoloC_cDw Xi j ψ2 i2
    have dg : BgHoloC Xi (j + 1) (cDw gc) := bgHoloC_cDw Xi (j + 1) gc (hgc (j + 1))
    have kG1 := bgHoloC_cKer Xi j bgkG _ _ _ ψ1 hXi tG i1
    have kGp1 := bgHoloC_cKer Xi j bgkGp _ _ _ ψ1 hXi tGp i1
    have kGd1 := bgHoloC_cKer Xi j bgkG _ _ _ (cDw ψ1) hXi tG d1
    have kU2 := bgHoloC_cKer Xi j bgkU _ _ _ ψ2 hXi tU i2
    have kUp2 := bgHoloC_cKer Xi j bgkUp _ _ _ ψ2 hXi tUp i2
    have kUd2 := bgHoloC_cKer Xi j bgkU _ _ _ (cDw ψ2) hXi tU d2
    have kS2 := bgHoloC_cKer Xi j bgkS _ _ _ ψ2 hXi tS i2
    have kSd2 := bgHoloC_cKer Xi j bgkS _ _ _ (cDw ψ2) hXi tS d2
    have P5 := bgHoloC_mul Xi (j + 1) gc (cKer bgkG ψ1) (hgc (j + 1)) kG1
    have R5 := hRad j _ (hmono j _ P5)
    have P6 := bgHoloC_add Xi (j + 1) _ _
      (bgHoloC_mul Xi (j + 1) (cDw gc) (cKer bgkG ψ1) dg kG1)
      (bgHoloC_mul Xi (j + 1) gc (cKer bgkG (cDw ψ1)) (hgc (j + 1)) kGd1)
    have R6 := hRad j _ (hmono j _ P6)
    have P7 := bgHoloC_mul Xi (j + 1) _ _ (hX (j + 1)) P5
    have T1 : BgHoloC Xi (j + 1) (fun X w => bgT1 ac ψ1 ψ2 X w + sc1 X w) :=
      bgHoloC_add Xi (j + 1) _ _
        (bgHoloC_add Xi (j + 1) _ _
          (bgHoloC_add Xi (j + 1) _ _
            (bgHoloC_add Xi (j + 1) _ _
              (bgHoloC_add Xi (j + 1) _ _
                (bgHoloC_add Xi (j + 1) _ _
                  (bgHoloC_mul Xi (j + 1) _ _ (hac (j + 1) 0) kG1)
                  (bgHoloC_mul Xi (j + 1) _ _ (hac (j + 1) 1) kGp1))
                (bgHoloC_mul Xi (j + 1) _ _ (hac (j + 1) 2) kGd1))
              (bgHoloC_mul Xi (j + 1) _ _ (hac (j + 1) 3) kU2))
            (bgHoloC_mul Xi (j + 1) _ _ (hac (j + 1) 4) kS2))
          (bgHoloC_mul Xi (j + 1) _ _ (hac (j + 1) 5) kSd2))
        (hs1 (j + 1))
    have T2 : BgHoloC Xi (j + 1) (fun X w => bgT2 bc gc ψ1 ψ2 X w + sc2 X w) :=
      bgHoloC_add Xi (j + 1) _ _
        (bgHoloC_add Xi (j + 1) _ _
          (bgHoloC_add Xi (j + 1) _ _
            (bgHoloC_add Xi (j + 1) _ _
              (bgHoloC_add Xi (j + 1) _ _
                (bgHoloC_add Xi (j + 1) _ _
                  (bgHoloC_add Xi (j + 1) _ _
                    (bgHoloC_add Xi (j + 1) _ _
                      (bgHoloC_mul Xi (j + 1) _ _ (hbc (j + 1) 0) kU2)
                      (bgHoloC_mul Xi (j + 1) _ _ (hbc (j + 1) 1) kUp2))
                    (bgHoloC_mul Xi (j + 1) _ _ (hbc (j + 1) 2) kUd2))
                  (bgHoloC_mul Xi (j + 1) _ _ (hbc (j + 1) 3) kS2))
                (bgHoloC_mul Xi (j + 1) _ _ (hbc (j + 1) 4) kSd2))
              (bgHoloC_mul Xi (j + 1) _ _ (hbc (j + 1) 5) R5))
            (bgHoloC_mul Xi (j + 1) _ _ (hbc (j + 1) 6) R6))
          (bgHoloC_mul Xi (j + 1) _ _ (hbc (j + 1) 7) P7))
        (hs2 (j + 1))
    exact ⟨hcongr (j + 1) ρ ψ1 _ hρ (fun X w a b c => (hfix X w a b c).1) T1,
      hcongr (j + 1) ρ ψ2 _ hρ (fun X w a b c => (hfix X w a b c).2) T2⟩

theorem bg_real_trace : ∀ (Xi ρ : ℝ) (φ : ℝ → ℂ → ℂ) (f : ℝ → ℝ → ℝ), 0 < ρ → (∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 → φ X (η : ℂ) = ((f X η : ℝ) : ℂ)) → (∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 → cRad φ X (η : ℂ) = ((profRadInt f X η : ℝ) : ℂ) ∧ ∀ kk : ℝ → ℝ, cKer kk φ X (η : ℂ) = ((bgKer kk f X η : ℝ) : ℂ)) ∧ ((∀ X, 0 < X → X < Xi → DifferentiableOn ℂ (φ X) (cStrip ρ)) → ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 → cDw φ X (η : ℂ) = ((pdE f X η : ℝ) : ℂ)) :=
by
  intro Xi ρ φ f hρ hT
  refine ⟨fun X η h0 h1 e1 e2 => ⟨?_, fun kk => ?_⟩, fun hD X η h0 h1 e1 e2 => ?_⟩
  ·
    unfold cRad profRadInt
    rw [← intervalIntegral.integral_ofReal]
    apply intervalIntegral.integral_congr_ae
    refine Filter.Eventually.of_forall (fun x hx => ?_)
    rw [Set.uIoc_of_le h0.le] at hx
    exact hT x η hx.1 (lt_of_le_of_lt hx.2 h1) e1 e2
  ·
    unfold cKer bgKer
    rw [Complex.ofReal_mul, ← intervalIntegral.integral_ofReal]
    congr 1
    apply intervalIntegral.integral_congr_ae
    refine Filter.Eventually.of_forall (fun t ht => ?_)
    rw [Set.uIoc_of_le zero_le_one] at ht
    have htX0 : 0 < t * X := mul_pos ht.1 h0
    have htX1 : t * X < Xi := lt_of_le_of_lt (mul_le_of_le_one_left h0.le ht.2) h1
    rw [hT (t * X) η htX0 htX1 e1 e2, Complex.ofReal_mul]
  ·
    have hopen : IsOpen (cStrip ρ) := by
      have e : cStrip ρ = {w : ℂ | |w.im| < ρ} ∩ {w : ℂ | -1 - ρ < w.re} ∩ {w : ℂ | w.re < 1 + ρ} := by
        ext w
        simp only [cStrip, Set.mem_setOf_eq, Set.mem_inter_iff, and_assoc]
      rw [e]
      exact ((isOpen_lt Complex.continuous_im.abs continuous_const).inter
        (isOpen_lt continuous_const Complex.continuous_re)).inter
        (isOpen_lt Complex.continuous_re continuous_const)
    have hmem : (η : ℂ) ∈ cStrip ρ := by
      simp only [cStrip, Set.mem_setOf_eq, Complex.ofReal_im, Complex.ofReal_re, abs_zero]
      exact ⟨hρ, by linarith, by linarith⟩
    have hd : HasDerivAt (φ X) (deriv (φ X) (η : ℂ)) (η : ℂ) :=
      ((hD X h0 h1).differentiableAt (hopen.mem_nhds hmem)).hasDerivAt
    set d := deriv (φ X) (η : ℂ) with hd_def
    have hnhds : Set.Ioo (-1 : ℝ) 1 ∈ nhds η := Ioo_mem_nhds e1 e2
    have E1 : (fun e : ℝ => f X e) =ᶠ[nhds η] (fun e : ℝ => (φ X (e : ℂ)).re) :=
      Filter.eventuallyEq_of_mem hnhds (fun e he => by
        show f X e = (φ X (e : ℂ)).re
        rw [hT X e h0 h1 he.1 he.2, Complex.ofReal_re])
    have E2 : (fun e : ℝ => ((f X e : ℝ) : ℂ)) =ᶠ[nhds η] (fun e : ℝ => φ X (e : ℂ)) :=
      Filter.eventuallyEq_of_mem hnhds (fun e he => by
        show ((f X e : ℝ) : ℂ) = φ X (e : ℂ)
        rw [hT X e h0 h1 he.1 he.2])
    have hre : HasDerivAt (fun e : ℝ => f X e) d.re η :=
      hd.real_of_complex.congr_of_eventuallyEq E1
    have hpdE : pdE f X η = d.re := by
      unfold pdE
      exact hre.deriv
    have hc1 : HasDerivAt (fun y : ℝ => φ X (y : ℂ)) d η := hd.comp_ofReal
    have hc2 : HasDerivAt (fun y : ℝ => φ X (y : ℂ)) ((d.re : ℝ) : ℂ) η :=
      hre.ofReal_comp.congr_of_eventuallyEq E2.symm
    have huniq : d = ((d.re : ℝ) : ℂ) := hc1.unique hc2
    show deriv (φ X) (η : ℂ) = _
    rw [← hd_def, hpdE]
    exact huniq

theorem bgHolo_of_complex : ∀ (Xi : ℝ) (ψ : ℝ → ℂ → ℂ), (∀ j : ℕ, BgHoloC Xi j ψ) → CReal Xi ψ → BgHolo Xi (fun X η => (ψ X (η : ℂ)).re) :=
by
  intro Xi ψ H1 H2
  choose ρ' C' hρ' hcl using H1
  have hstrip : ∀ s t : ℝ, s ≤ t → cStrip s ⊆ cStrip t := by
    intro s t hst w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
  obtain ⟨ρ, hρ0, hρs⟩ : ∃ ρ : ℕ → ℝ, ρ 0 = ρ' 0 ∧ ∀ k, ρ (k + 1) = min (ρ k) (ρ' (k + 1)) :=
    ⟨fun k => Nat.rec (motive := fun _ => ℝ) (ρ' 0) (fun k r => min r (ρ' (k + 1))) k,
      rfl, fun _ => rfl⟩
  have P1 : ∀ k, 0 < ρ k := by
    intro k
    induction k with
    | zero => rw [hρ0]; exact hρ' 0
    | succ k ih => rw [hρs]; exact lt_min ih (hρ' _)
  have P2 : ∀ k, ρ k ≤ ρ' k := by
    intro k
    cases k with
    | zero => rw [hρ0]
    | succ k => rw [hρs]; exact min_le_right _ _
  have P3 : ∀ k, ρ (k + 1) ≤ ρ k := fun k => by rw [hρs]; exact min_le_left _ _
  refine ⟨fun k X w => iteratedDeriv k (fun Y => ψ Y w) X, ρ, C', fun k => ⟨P1 k, P3 k⟩,
    ?_, ?_, ?_, ?_⟩
  · intro k
    exact ((hcl k k le_rfl).1).mono (Set.prod_mono subset_rfl (hstrip _ _ (P2 k)))
  · intro k X h0 h1
    obtain ⟨hd, hb⟩ := (hcl k k le_rfl).2.1 X h0 h1
    exact ⟨hd.mono (hstrip _ _ (P2 k)), fun w hw => hb w (hstrip _ _ (P2 k) hw)⟩
  · intro k X w h0 h1 hw
    exact (hcl (k + 1) k (Nat.le_succ k)).2.2 (Nat.lt_succ_self k) X w h0 h1
      (hstrip _ _ (P2 (k + 1)) hw)
  · intro X η h0 h1 e1 e2
    show iteratedDeriv 0 (fun Y => ψ Y (η : ℂ)) X = _
    rw [iteratedDeriv_zero]
    apply Complex.ext <;> simp [H2 X η h0 h1 e1 e2]

theorem bg_volterra_solve : ∀ (Xi : ℝ) (a : Fin 6 → ℝ → ℝ → ℝ) (b : Fin 8 → ℝ → ℝ → ℝ) (g0 s1 s2 : ℝ → ℝ → ℝ), 0 < Xi → (∀ i, BgHolo Xi (a i)) → (∀ i, BgHolo Xi (b i)) → BgHolo Xi g0 → BgHolo Xi s1 → BgHolo Xi s2 → ∃ r1 r2 : ℝ → ℝ → ℝ, BgHolo Xi r1 ∧ BgHolo Xi r2 ∧ ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 → r1 X η = a 0 X η * bgKer bgkG r1 X η + a 1 X η * bgKer bgkGp r1 X η + a 2 X η * bgKer bgkG (pdE r1) X η + a 3 X η * bgKer bgkU r2 X η + a 4 X η * bgKer bgkS r2 X η + a 5 X η * bgKer bgkS (pdE r2) X η + s1 X η ∧ r2 X η = b 0 X η * bgKer bgkU r2 X η + b 1 X η * bgKer bgkUp r2 X η + b 2 X η * bgKer bgkU (pdE r2) X η + b 3 X η * bgKer bgkS r2 X η + b 4 X η * bgKer bgkS (pdE r2) X η + b 5 X η * profRadInt (fun x e => g0 x e * bgKer bgkG r1 x e) X η + b 6 X η * profRadInt (fun x e => pdE g0 x e * bgKer bgkG r1 x e + g0 x e * bgKer bgkG (pdE r1) x e) X η + b 7 X η * (X * (g0 X η * bgKer bgkG r1 X η)) + s2 X η :=
by
  intro Xi a b g0 s1 s2 hXi ha hb hg hs1 hs2

  choose ac ρa Ca hρa hCBa hHa hTa using fun i => bgHolo_complexify Xi (a i) hXi (ha i)
  choose bc ρb Cb hρb hCBb hHb hTb using fun i => bgHolo_complexify Xi (b i) hXi (hb i)
  obtain ⟨gc, ρg, Cg, hρg, hCBg, hHg, hTg⟩ := bgHolo_complexify Xi g0 hXi hg
  obtain ⟨c1, ρ1, C1, hρ1, hCB1, hH1, hT1⟩ := bgHolo_complexify Xi s1 hXi hs1
  obtain ⟨c2, ρ2, C2, hρ2, hCB2, hH2, hT2⟩ := bgHolo_complexify Xi s2 hXi hs2
  obtain ⟨ia, hia⟩ := Finite.exists_min ρa
  obtain ⟨ib, hib⟩ := Finite.exists_min ρb
  obtain ⟨ja, hja⟩ := Finite.exists_max Ca
  obtain ⟨jb, hjb⟩ := Finite.exists_max Cb
  obtain ⟨σ, hσa, hσb, hσg, hσ1, hσ2, hσpos⟩ : ∃ σ : ℝ, (∀ i, σ ≤ ρa i) ∧ (∀ i, σ ≤ ρb i) ∧
      σ ≤ ρg ∧ σ ≤ ρ1 ∧ σ ≤ ρ2 ∧ 0 < σ :=
    ⟨min (min (ρa ia) (ρb ib)) (min ρg (min ρ1 ρ2)),
      fun i => le_trans (min_le_left _ _) (le_trans (min_le_left _ _) (hia i)),
      fun i => le_trans (min_le_left _ _) (le_trans (min_le_right _ _) (hib i)),
      le_trans (min_le_right _ _) (min_le_left _ _),
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _)),
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _)),
      lt_min (lt_min (hρa ia) (hρb ib)) (lt_min hρg (lt_min hρ1 hρ2))⟩
  obtain ⟨A, hAa, hAb, hAg, hA1, hA2⟩ : ∃ A : ℝ, (∀ i, Ca i ≤ A) ∧ (∀ i, Cb i ≤ A) ∧
      Cg ≤ A ∧ C1 ≤ A ∧ C2 ≤ A :=
    ⟨max (max (Ca ja) (Cb jb)) (max Cg (max C1 C2)),
      fun i => (hja i).trans ((le_max_left _ _).trans (le_max_left _ _)),
      fun i => (hjb i).trans ((le_max_right _ _).trans (le_max_left _ _)),
      (le_max_left _ _).trans (le_max_right _ _),
      ((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_right _ _),
      ((le_max_right _ _).trans (le_max_right _ _)).trans (le_max_right _ _)⟩
  have hstrip : ∀ s t : ℝ, s ≤ t → cStrip s ⊆ cStrip t := by
    intro s t hst w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
  have hCBmono : ∀ (s t C D : ℝ) (φ : ℝ → ℂ → ℂ), s ≤ t → C ≤ D → CB Xi t C φ → CB Xi s D φ := by
    intro s t C D φ hst hCD h
    obtain ⟨h1, h2, h3⟩ := h
    exact ⟨h1.mono (Set.prod_mono subset_rfl (hstrip s t hst)),
      fun X h0 h1' => (h2 X h0 h1').mono (hstrip s t hst),
      fun X w h0 h1' hw => (h3 X w h0 h1' (hstrip s t hst hw)).trans hCD⟩
  have hRealOf : ∀ (φ : ℝ → ℂ → ℂ) (f : ℝ → ℝ → ℝ), (∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 →
      φ X (η : ℂ) = ((f X η : ℝ) : ℂ)) → CReal Xi φ := by
    intro φ f hT X η h0 h1 e1 e2
    rw [hT X η h0 h1 e1 e2, Complex.ofReal_im]

  obtain ⟨τ, B, ψ1, ψ2, hτ, hCBψ1, hCBψ2, hRψ1, hRψ2, hfix⟩ :=
    bg_complex_fixed_point Xi σ A ac bc gc c1 c2 hXi hσpos
      (fun i => hCBmono _ _ _ _ _ (hσa i) (hAa i) (hCBa i))
      (fun i => hCBmono _ _ _ _ _ (hσb i) (hAb i) (hCBb i))
      (hCBmono _ _ _ _ _ hσg hAg hCBg) (hCBmono _ _ _ _ _ hσ1 hA1 hCB1)
      (hCBmono _ _ _ _ _ hσ2 hA2 hCB2)
      (fun i => hRealOf _ _ (hTa i)) (fun i => hRealOf _ _ (hTb i))
      (hRealOf _ _ hTg) (hRealOf _ _ hT1) (hRealOf _ _ hT2)
  have hC0 : ∀ (s D : ℝ) (φ : ℝ → ℂ → ℂ), 0 < s → CB Xi s D φ → BgHoloC Xi 0 φ := by
    intro s D φ hs h
    obtain ⟨h1, h2, h3⟩ := h
    refine ⟨s, D, hs, fun k hk => ?_⟩
    have hk0 : k = 0 := by omega
    subst hk0
    refine ⟨?_, fun X h0 h1' => ⟨?_, fun w hw => ?_⟩, fun h => absurd h (lt_irrefl 0)⟩
    · simpa only [iteratedDeriv_zero] using h1
    · simpa only [iteratedDeriv_zero] using h2 X h0 h1'
    · simpa only [iteratedDeriv_zero] using h3 X w h0 h1' hw
  have hreg := bg_complex_regularity Xi τ ac bc gc c1 c2 ψ1 ψ2 hXi hτ (fun j i => hHa i j)
    (fun j i => hHb i j) hHg hH1 hH2 (hC0 τ B ψ1 hτ hCBψ1) (hC0 τ B ψ2 hτ hCBψ2) hfix
  obtain ⟨r1, hr1⟩ : ∃ r : ℝ → ℝ → ℝ, r = fun (X η : ℝ) => (ψ1 X (η : ℂ)).re := ⟨_, rfl⟩
  obtain ⟨r2, hr2⟩ : ∃ r : ℝ → ℝ → ℝ, r = fun (X η : ℝ) => (ψ2 X (η : ℂ)).re := ⟨_, rfl⟩
  have hψ1T : ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 → ψ1 X (η : ℂ) = ((r1 X η : ℝ) : ℂ) := by
    intro X η h0 h1 e1 e2
    rw [hr1]
    apply Complex.ext
    · simp
    · simp [hRψ1 X η h0 h1 e1 e2]
  have hψ2T : ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 → ψ2 X (η : ℂ) = ((r2 X η : ℝ) : ℂ) := by
    intro X η h0 h1 e1 e2
    rw [hr2]
    apply Complex.ext
    · simp
    · simp [hRψ2 X η h0 h1 e1 e2]
  have hBH1 : BgHolo Xi r1 := by
    rw [hr1]; exact bgHolo_of_complex Xi ψ1 (fun j => (hreg j).1) hRψ1
  have hBH2 : BgHolo Xi r2 := by
    rw [hr2]; exact bgHolo_of_complex Xi ψ2 (fun j => (hreg j).2) hRψ2
  refine ⟨r1, r2, hBH1, hBH2, ?_⟩

  obtain ⟨tr1, dr1⟩ := bg_real_trace Xi τ ψ1 r1 hτ hψ1T
  obtain ⟨tr2, dr2⟩ := bg_real_trace Xi τ ψ2 r2 hτ hψ2T
  have hd1 := dr1 hCBψ1.2.1
  have hd2 := dr2 hCBψ2.2.1
  obtain ⟨tr1', -⟩ := bg_real_trace Xi τ (cDw ψ1) (pdE r1) hτ hd1
  obtain ⟨tr2', -⟩ := bg_real_trace Xi τ (cDw ψ2) (pdE r2) hτ hd2
  obtain ⟨-, dg⟩ := bg_real_trace Xi ρg gc g0 hρg hTg
  have hdg := dg hCBg.2.1
  have hT5 : ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 →
      (fun x z => gc x z * cKer bgkG ψ1 x z) X (η : ℂ) =
        (((fun x e => g0 x e * bgKer bgkG r1 x e) X η : ℝ) : ℂ) := by
    intro X η h0 h1 e1 e2
    simp only [hTg X η h0 h1 e1 e2, (tr1 X η h0 h1 e1 e2).2 bgkG, Complex.ofReal_mul]
  have hT6 : ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 →
      (fun x z => cDw gc x z * cKer bgkG ψ1 x z + gc x z * cKer bgkG (cDw ψ1) x z) X (η : ℂ) =
        (((fun x e => pdE g0 x e * bgKer bgkG r1 x e + g0 x e * bgKer bgkG (pdE r1) x e) X η : ℝ) : ℂ) := by
    intro X η h0 h1 e1 e2
    simp only [hdg X η h0 h1 e1 e2, hTg X η h0 h1 e1 e2, (tr1 X η h0 h1 e1 e2).2 bgkG,
      (tr1' X η h0 h1 e1 e2).2 bgkG, Complex.ofReal_mul, Complex.ofReal_add]
  obtain ⟨tr5, -⟩ := bg_real_trace Xi τ (fun x z => gc x z * cKer bgkG ψ1 x z)
    (fun x e => g0 x e * bgKer bgkG r1 x e) hτ hT5
  obtain ⟨tr6, -⟩ := bg_real_trace Xi τ
    (fun x z => cDw gc x z * cKer bgkG ψ1 x z + gc x z * cKer bgkG (cDw ψ1) x z)
    (fun x e => pdE g0 x e * bgKer bgkG r1 x e + g0 x e * bgKer bgkG (pdE r1) x e) hτ hT6

  intro X η h0 h1 e1 e2
  have hw : (η : ℂ) ∈ cStrip τ := by
    simp only [cStrip, Set.mem_setOf_eq, Complex.ofReal_im, Complex.ofReal_re, abs_zero]
    exact ⟨hτ, by linarith, by linarith⟩
  obtain ⟨f1, f2⟩ := hfix X (η : ℂ) h0 h1 hw
  unfold bgT1 at f1
  unfold bgT2 at f2
  have eA : ∀ i, ac i X (η : ℂ) = ((a i X η : ℝ) : ℂ) := fun i => hTa i X η h0 h1 e1 e2
  have eB : ∀ i, bc i X (η : ℂ) = ((b i X η : ℝ) : ℂ) := fun i => hTb i X η h0 h1 e1 e2
  have k1 : ∀ kk, cKer kk ψ1 X (η : ℂ) = ((bgKer kk r1 X η : ℝ) : ℂ) := (tr1 X η h0 h1 e1 e2).2
  have k2 : ∀ kk, cKer kk ψ2 X (η : ℂ) = ((bgKer kk r2 X η : ℝ) : ℂ) := (tr2 X η h0 h1 e1 e2).2
  have k1' : ∀ kk, cKer kk (cDw ψ1) X (η : ℂ) = ((bgKer kk (pdE r1) X η : ℝ) : ℂ) :=
    (tr1' X η h0 h1 e1 e2).2
  have k2' : ∀ kk, cKer kk (cDw ψ2) X (η : ℂ) = ((bgKer kk (pdE r2) X η : ℝ) : ℂ) :=
    (tr2' X η h0 h1 e1 e2).2
  rw [(tr5 X η h0 h1 e1 e2).1, (tr6 X η h0 h1 e1 e2).1] at f2
  rw [hψ1T X η h0 h1 e1 e2] at f1
  rw [hψ2T X η h0 h1 e1 e2] at f2
  simp only [eA, k1, k2, k1', k2', hT1 X η h0 h1 e1 e2] at f1
  simp only [eB, k1, k2, k1', k2', hTg X η h0 h1 e1 e2, hT2 X η h0 h1 e1 e2] at f2
  exact ⟨by exact_mod_cast f1, by exact_mod_cast f2⟩

theorem bgHolo_kernels : ∀ (Xi : ℝ) (r : ℝ → ℝ → ℝ), 0 < Xi → BgHolo Xi r → BgHolo Xi (profRadInt r) ∧ ∀ kk : ℝ → ℝ, (kk = bgkG ∨ kk = bgkGp ∨ kk = bgkU ∨ kk = bgkUp ∨ kk = bgkS) → BgHolo Xi (bgKer kk r) ∧ ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 → pdE (bgKer kk r) X η = bgKer kk (pdE r) X η :=
by

  have t_s2 : ∀ (Xi C : ℝ) (V : Set ℂ) (κ : ℝ → ℝ) (φ : ℝ → ℂ → ℂ),
      ContinuousOn κ (Ioc 0 1) → IntervalIntegrable κ volume 0 1 →
      ContinuousOn (fun p : ℝ × ℂ => φ p.1 p.2) (Ioo 0 Xi ×ˢ V) →
      (∀ X w, 0 < X → X < Xi → w ∈ V → ‖φ X w‖ ≤ C) →
      ContinuousOn (fun p : ℝ × ℂ => ∫ t in (0:ℝ)..1, (κ t : ℂ) * φ (t * p.1) p.2) (Ioo 0 Xi ×ˢ V) ∧
      ∀ X w, 0 < X → X < Xi → w ∈ V →
        ‖∫ t in (0:ℝ)..1, (κ t : ℂ) * φ (t * X) w‖ ≤ (∫ t in (0:ℝ)..1, |κ t|) * C := by
    intro Xi C V κ φ hκc hκi hφ hb
    have hmap : ∀ t ∈ Ioc (0:ℝ) 1, ∀ p ∈ Ioo 0 Xi ×ˢ V,
        ((t * p.1, p.2) : ℝ × ℂ) ∈ Ioo 0 Xi ×ˢ V := by
      intro t ht p hp
      refine ⟨⟨mul_pos ht.1 hp.1.1, ?_⟩, hp.2⟩
      calc t * p.1 ≤ 1 * p.1 := mul_le_mul_of_nonneg_right ht.2 hp.1.1.le
        _ = p.1 := one_mul _
        _ < Xi := hp.1.2
    have hcontT : ∀ p ∈ Ioo 0 Xi ×ˢ V,
        ContinuousOn (fun t => (κ t : ℂ) * φ (t * p.1) p.2) (Ioc 0 1) := by
      intro p hp
      refine (Complex.continuous_ofReal.comp_continuousOn hκc).mul ?_
      have : ContinuousOn (fun t : ℝ => ((t * p.1, p.2) : ℝ × ℂ)) (Ioc 0 1) :=
        ((continuous_id.mul continuous_const).prodMk continuous_const).continuousOn
      exact hφ.comp this (fun t ht => hmap t ht p hp)
    have hint : IntervalIntegrable (fun t => |κ t| * C) volume 0 1 := hκi.norm.mul_const C
    have hbd : ∀ p ∈ Ioo 0 Xi ×ˢ V, ∀ t ∈ Ioc (0:ℝ) 1,
        ‖(κ t : ℂ) * φ (t * p.1) p.2‖ ≤ |κ t| * C := by
      intro p hp t ht
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
      have hm := hmap t ht p hp
      exact mul_le_mul_of_nonneg_left (hb _ _ hm.1.1 hm.1.2 hm.2) (abs_nonneg _)
    refine ⟨?_, ?_⟩
    · have e : (fun p : ℝ × ℂ => ∫ t in (0:ℝ)..1, (κ t : ℂ) * φ (t * p.1) p.2) =
          fun p => ∫ t in Ioc (0:ℝ) 1, (κ t : ℂ) * φ (t * p.1) p.2 := by
        funext p; exact intervalIntegral.integral_of_le zero_le_one
      rw [e]
      refine continuousOn_of_dominated (bound := fun t => |κ t| * C) ?_ ?_ ?_ ?_
      · intro p hp
        exact (hcontT p hp).aestronglyMeasurable measurableSet_Ioc
      · intro p hp
        exact (ae_restrict_iff' measurableSet_Ioc).2
          (Filter.Eventually.of_forall fun t ht => hbd p hp t ht)
      · exact (intervalIntegrable_iff_integrableOn_Ioc_of_le zero_le_one).1 hint
      · refine (ae_restrict_iff' measurableSet_Ioc).2 (Filter.Eventually.of_forall fun t ht => ?_)
        refine continuousOn_const.mul ?_
        have : ContinuousOn (fun p : ℝ × ℂ => ((t * p.1, p.2) : ℝ × ℂ)) (Ioo 0 Xi ×ˢ V) :=
          ((continuous_const.mul continuous_fst).prodMk continuous_snd).continuousOn
        exact hφ.comp this (fun p hp => hmap t ht p hp)
    · intro X w hX hXi hw
      have h := intervalIntegral.norm_integral_le_of_norm_le
        (f := fun t => (κ t : ℂ) * φ (t * X) w) zero_le_one
        (Filter.Eventually.of_forall fun t ht => hbd (X, w) ⟨⟨hX, hXi⟩, hw⟩ t ht) hint
      rw [intervalIntegral.integral_mul_const] at h
      exact h

  have t_s3 : ∀ (Xi B0 B1 : ℝ) (κ : ℝ → ℝ) (φ ψ : ℝ → ℂ → ℂ) (w : ℂ) (X : ℝ),
      ContinuousOn κ (Ioc 0 1) → IntervalIntegrable κ volume 0 1 → 0 < X → X < Xi →
      (∀ Y, 0 < Y → Y < Xi → HasDerivAt (fun Z : ℝ => φ Z w) (ψ Y w) Y) →
      ContinuousOn (fun Y => ψ Y w) (Ioo 0 Xi) →
      (∀ Y, 0 < Y → Y < Xi → ‖φ Y w‖ ≤ B0) →
      (∀ Y, 0 < Y → Y < Xi → ‖ψ Y w‖ ≤ B1) →
      HasDerivAt (fun Y : ℝ => ∫ t in (0:ℝ)..1, (κ t : ℂ) * φ (t * Y) w)
        (∫ t in (0:ℝ)..1, ((t * κ t : ℝ) : ℂ) * ψ (t * X) w) X := by
    intro Xi B0 B1 κ φ ψ w X hκc hκi hX hXi hd hψc hb0 hb1
    have hmap : ∀ t ∈ Ioc (0:ℝ) 1, ∀ Y ∈ Ioo 0 Xi, t * Y ∈ Ioo 0 Xi := by
      intro t ht Y hY
      refine ⟨mul_pos ht.1 hY.1, ?_⟩
      calc t * Y ≤ 1 * Y := mul_le_mul_of_nonneg_right ht.2 hY.1.le
        _ = Y := one_mul _
        _ < Xi := hY.2
    have hφc : ContinuousOn (fun Y => φ Y w) (Ioo 0 Xi) := fun Y hY =>
      (hd Y hY.1 hY.2).continuousAt.continuousWithinAt
    have hu : uIoc (0:ℝ) 1 = Ioc 0 1 := uIoc_of_le zero_le_one
    have hs : Ioo 0 Xi ∈ nhds X := Ioo_mem_nhds hX hXi
    have hFm : ∀ Y ∈ Ioo 0 Xi, ContinuousOn (fun t => (κ t : ℂ) * φ (t * Y) w) (Ioc 0 1) := by
      intro Y hY
      exact (Complex.continuous_ofReal.comp_continuousOn hκc).mul
        (hφc.comp (continuous_id.mul continuous_const).continuousOn (fun t ht => hmap t ht Y hY))
    have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le (𝕜 := ℝ)
      (μ := volume) (a := 0) (b := 1)
      (F := fun Y t => (κ t : ℂ) * φ (t * Y) w)
      (F' := fun Y t => ((t * κ t : ℝ) : ℂ) * ψ (t * Y) w)
      (x₀ := X) (s := Ioo 0 Xi) (bound := fun t => |κ t| * B1) hs ?_ ?_ ?_ ?_ ?_ ?_
    · exact key.2
    · filter_upwards [hs] with Y hY
      rw [hu]
      exact (hFm Y hY).aestronglyMeasurable measurableSet_Ioc
    · refine IntervalIntegrable.mono_fun' (hκi.norm.mul_const B0) ?_ ?_
      · rw [hu]; exact (hFm X ⟨hX, hXi⟩).aestronglyMeasurable measurableSet_Ioc
      · rw [hu]
        refine (ae_restrict_iff' measurableSet_Ioc).2 (Filter.Eventually.of_forall fun t ht => ?_)
        show ‖(κ t : ℂ) * φ (t * X) w‖ ≤ ‖κ t‖ * B0
        rw [norm_mul, Complex.norm_real]
        have hm := hmap t ht X ⟨hX, hXi⟩
        exact mul_le_mul_of_nonneg_left (hb0 _ hm.1 hm.2) (norm_nonneg _)
    · rw [hu]
      refine ContinuousOn.aestronglyMeasurable ?_ measurableSet_Ioc
      refine (Complex.continuous_ofReal.comp_continuousOn
        (continuous_id.continuousOn.mul hκc)).mul ?_
      exact hψc.comp (continuous_id.mul continuous_const).continuousOn
        (fun t ht => hmap t ht X ⟨hX, hXi⟩)
    · refine Filter.Eventually.of_forall fun t ht Y hY => ?_
      rw [hu] at ht
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_mul, abs_of_pos ht.1]
      have hm := hmap t ht Y hY
      have h1 := hb1 _ hm.1 hm.2
      have h2 : 0 ≤ ‖ψ (t * Y) w‖ := norm_nonneg _
      have h3 : 0 ≤ |κ t| := abs_nonneg _
      calc t * |κ t| * ‖ψ (t * Y) w‖ ≤ 1 * |κ t| * ‖ψ (t * Y) w‖ := by
            gcongr; exact ht.2
        _ = |κ t| * ‖ψ (t * Y) w‖ := by ring
        _ ≤ |κ t| * B1 := mul_le_mul_of_nonneg_left h1 h3
    · exact hκi.norm.mul_const B1
    · refine Filter.Eventually.of_forall fun t ht Y hY => ?_
      rw [hu] at ht
      have hm := hmap t ht Y hY
      have h1 : HasDerivAt (fun x : ℝ => t * x) t Y := by
        simpa using (hasDerivAt_id Y).const_mul t
      have h2 := ((hd (t * Y) hm.1 hm.2).scomp Y h1).const_mul (κ t : ℂ)
      refine h2.congr_deriv ?_
      rw [Complex.real_smul]
      push_cast
      ring

  have t_s1 : ∀ (g : ℝ → ℂ → ℂ) (V : Set ℂ) (B : ℝ → ℝ), IsOpen V →
      IntervalIntegrable B volume 0 1 →
      (∀ t ∈ Ioc (0:ℝ) 1, DifferentiableOn ℂ (g t) V) →
      (∀ t ∈ Ioc (0:ℝ) 1, ∀ w ∈ V, ‖g t w‖ ≤ B t) →
      (∀ w ∈ V, ContinuousOn (fun t => g t w) (Ioc 0 1)) →
      ∀ w ∈ V, IntervalIntegrable (fun t => deriv (g t) w) volume 0 1 ∧
        HasDerivAt (fun z => ∫ t in (0:ℝ)..1, g t z) (∫ t in (0:ℝ)..1, deriv (g t) w) w := by
    intro g V B hV hB hg hgb hgc w₀ hw₀
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hV w₀ hw₀
    have hu : uIoc (0:ℝ) 1 = Ioc 0 1 := uIoc_of_le zero_le_one
    have hs : Metric.ball w₀ (ε / 2) ∈ nhds w₀ := Metric.ball_mem_nhds w₀ (by linarith)
