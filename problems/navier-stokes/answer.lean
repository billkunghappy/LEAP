      have e3 : (∫ x in Ioc 0 X0, G' x η ^ 2) = ∫ x in Ioc 0 X0, G x η ^ 2 :=
        setIntegral_congr_fun measurableSet_Ioc (hEc 0)
      rw [← hsplit0] at e1 e2
      linarith
    suffices H : (∫ x in Ioi Y, G' x η ^ 2) = ∫ x in Ioi Y, G x η ^ 2 by
      unfold leadPi
      rw [H]
    have hsplit : Ioi Y = Ioc Y X0 ∪ Ioi X0 := (Ioc_union_Ioi_eq_Ioi hY.le).symm
    by_cases hI : IntegrableOn (fun x => G x η ^ 2) (Ioc Y X0)
    · have hI' : IntegrableOn (fun x => G' x η ^ 2) (Ioc Y X0) :=
        hI.congr_fun (hEc Y).symm measurableSet_Ioc
      have e1 := setIntegral_union (Ioc_disjoint_Ioi_same (a := Y) (b := X0)) measurableSet_Ioi
        hI' (hiG'.mono_set (Ioi_subset_Ioi hX0.le))
      have e2 := setIntegral_union (Ioc_disjoint_Ioi_same (a := Y) (b := X0)) measurableSet_Ioi
        hI (hiG.mono_set (Ioi_subset_Ioi hX0.le))
      have e3 : (∫ x in Ioc Y X0, G' x η ^ 2) = ∫ x in Ioc Y X0, G x η ^ 2 :=
        setIntegral_congr_fun measurableSet_Ioc (hEc Y)
      rw [← hsplit] at e1 e2
      linarith
    · have hI' : ¬ IntegrableOn (fun x => G' x η ^ 2) (Ioc Y X0) := fun h' =>
        hI (h'.congr_fun (hEc Y) measurableSet_Ioc)
      have n1 : ¬ IntegrableOn (fun x => G x η ^ 2) (Ioi Y) := fun h' =>
        hI (h'.mono_set Ioc_subset_Ioi_self)
      have n2 : ¬ IntegrableOn (fun x => G' x η ^ 2) (Ioi Y) := fun h' =>
        hI' (h'.mono_set Ioc_subset_Ioi_self)
      rw [integral_undef n1, integral_undef n2]

  have s3L : ∀ (g g' : ℝ → ℝ) (s : ℝ), 0 < s → (∀ x : ℝ, s < x → g' x = g x) →
      IntervalIntegrable (fun x => g' x - g x) volume 0 s → (∫ x in (0:ℝ)..s, (g' x - g x)) = 0 →
      (∫ x in Ioi (0:ℝ), g' x) = ∫ x in Ioi (0:ℝ), g x := by
    intro g g' s hs hout hii hz
    have hD1 : IntegrableOn (fun x => g' x - g x) (Ioc 0 s) :=
      (intervalIntegrable_iff_integrableOn_Ioc_of_le hs.le).mp hii
    have hD0 : EqOn (fun x => g' x - g x) (fun _ => (0:ℝ)) (Ioi s) := by
      intro x hx
      simp only [hout x hx, sub_self]
    have hD2 : IntegrableOn (fun x => g' x - g x) (Ioi s) :=
      (integrableOn_zero).congr_fun hD0.symm measurableSet_Ioi
    have hsplit : Ioi (0:ℝ) = Ioc 0 s ∪ Ioi s := (Ioc_union_Ioi_eq_Ioi hs.le).symm
    have hD : IntegrableOn (fun x => g' x - g x) (Ioi 0) := by
      rw [hsplit]; exact hD1.union hD2
    have hDint : (∫ x in Ioi (0:ℝ), (g' x - g x)) = 0 := by
      have a1 := setIntegral_union (Ioc_disjoint_Ioi_same (a := (0:ℝ)) (b := s)) measurableSet_Ioi hD1 hD2
      rw [← hsplit] at a1
      have a2 : (∫ x in Ioi s, (g' x - g x)) = 0 := by
        rw [setIntegral_congr_fun measurableSet_Ioi hD0]; simp
      have a3 : (∫ x in Ioc 0 s, (g' x - g x)) = 0 := by
        rw [← intervalIntegral.integral_of_le hs.le]; exact hz
      rw [a1, a2, a3, add_zero]
    by_cases hg : IntegrableOn g (Ioi 0)
    · calc (∫ x in Ioi (0:ℝ), g' x) = ∫ x in Ioi (0:ℝ), (g x + (g' x - g x)) := by
            congr 1; funext x; ring
        _ = (∫ x in Ioi (0:ℝ), g x) + ∫ x in Ioi (0:ℝ), (g' x - g x) := integral_add hg hD
        _ = ∫ x in Ioi (0:ℝ), g x := by rw [hDint, add_zero]
    · have hg' : ¬ IntegrableOn g' (Ioi 0) := by
        intro h'
        apply hg
        refine (h'.sub hD).congr_fun (fun x _ => ?_) measurableSet_Ioi
        simp
      rw [integral_undef hg, integral_undef hg']

  have s4L : ∀ (g g' : ℝ → ℝ → ℝ) (s X η : ℝ), s ≤ X → (∀ x : ℝ, s ≤ x → g' x η = g x η) →
      IntervalIntegrable (fun x => g x η) volume 0 X → IntervalIntegrable (fun x => g x η) volume 0 s →
      IntervalIntegrable (fun x => g' x η) volume 0 X → IntervalIntegrable (fun x => g' x η) volume 0 s →
      profRadInt g' s η = profRadInt g s η → profRadInt g' X η = profRadInt g X η := by
    intro g g' s X η hsX hagr i1 i2 i3 i4 hpr
    unfold profRadInt at hpr ⊢
    have e1 := intervalIntegral.integral_interval_sub_left i1 i2
    have e2 := intervalIntegral.integral_interval_sub_left i3 i4
    have e3 : (∫ x in s..X, g' x η) = ∫ x in s..X, g x η := by
      apply intervalIntegral.integral_congr
      intro x hx
      rw [uIcc_of_le hsX] at hx
      exact hagr x hx.1
    linarith

  generalize hT1 : (fun X η : ℝ => if -1 < η ∧ η < 1 then leadStressTh h F' U' X η else 0) = T0th
  generalize hT2 : (fun X η : ℝ => if -1 < η ∧ η < 1 then leadStressTz h F' U' X η else 0) = T0z
  have hT1' : ∀ X η : ℝ, T0th X η = if -1 < η ∧ η < 1 then leadStressTh h F' U' X η else 0 := by
    intro X η; subst hT1; rfl
  have hT2' : ∀ X η : ℝ, T0z X η = if -1 < η ∧ η < 1 then leadStressTz h F' U' X η else 0 := by
    intro X η; subst hT2; rfl
  have hp1 : ∀ X η : ℝ, -1 < η → η < 1 → T0th X η = leadStressTh h F' U' X η := by
    intro X η e1 e2; rw [hT1', if_pos ⟨e1, e2⟩]
  have hp2 : ∀ X η : ℝ, -1 < η → η < 1 → T0z X η = leadStressTz h F' U' X η := by
    intro X η e1 e2; rw [hT2', if_pos ⟨e1, e2⟩]
  have hΩ : IsOpen ((univ : Set ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_univ.prod isOpen_Ioo
  have iter : ∀ (m : ℕ) (X η : ℝ), -1 < η → η < 1 →
      iteratedFDeriv ℝ m (↿T0th) (X, η) = iteratedFDeriv ℝ m (↿(leadStressTh h F' U')) (X, η) ∧
      iteratedFDeriv ℝ m (↿T0z) (X, η) = iteratedFDeriv ℝ m (↿(leadStressTz h F' U')) (X, η) ∧
      iteratedFDeriv ℝ m (fun w : ℝ × ℝ => T0th w.1 w.2 / Real.sqrt (T0th w.1 w.2 ^ 2 + T0z w.1 w.2 ^ 2)) (X, η) =
        iteratedFDeriv ℝ m (fun z : ℝ × ℝ => leadStressTh h F' U' z.1 z.2 /
          Real.sqrt (leadStressTh h F' U' z.1 z.2 ^ 2 + leadStressTz h F' U' z.1 z.2 ^ 2)) (X, η) ∧
      iteratedFDeriv ℝ m (fun w : ℝ × ℝ => T0z w.1 w.2 / Real.sqrt (T0th w.1 w.2 ^ 2 + T0z w.1 w.2 ^ 2)) (X, η) =
        iteratedFDeriv ℝ m (fun z : ℝ × ℝ => leadStressTz h F' U' z.1 z.2 /
          Real.sqrt (leadStressTh h F' U' z.1 z.2 ^ 2 + leadStressTz h F' U' z.1 z.2 ^ 2)) (X, η) := by
    intro m X η e1 e2
    have hmem : (univ : Set ℝ) ×ˢ Ioo (-1:ℝ) 1 ∈ nhds ((X, η) : ℝ × ℝ) :=
      hΩ.mem_nhds ⟨mem_univ _, e1, e2⟩
    have ev1 : (↿T0th) =ᶠ[nhds ((X, η) : ℝ × ℝ)] (↿(leadStressTh h F' U')) :=
      Filter.eventuallyEq_of_mem hmem (fun w hw => hp1 w.1 w.2 hw.2.1 hw.2.2)
    have ev2 : (↿T0z) =ᶠ[nhds ((X, η) : ℝ × ℝ)] (↿(leadStressTz h F' U')) :=
      Filter.eventuallyEq_of_mem hmem (fun w hw => hp2 w.1 w.2 hw.2.1 hw.2.2)
    have ev3 : (fun w : ℝ × ℝ => T0th w.1 w.2 / Real.sqrt (T0th w.1 w.2 ^ 2 + T0z w.1 w.2 ^ 2))
        =ᶠ[nhds ((X, η) : ℝ × ℝ)] (fun z : ℝ × ℝ => leadStressTh h F' U' z.1 z.2 /
          Real.sqrt (leadStressTh h F' U' z.1 z.2 ^ 2 + leadStressTz h F' U' z.1 z.2 ^ 2)) :=
      Filter.eventuallyEq_of_mem hmem (fun w hw => by
        simp only [hp1 w.1 w.2 hw.2.1 hw.2.2, hp2 w.1 w.2 hw.2.1 hw.2.2])
    have ev4 : (fun w : ℝ × ℝ => T0z w.1 w.2 / Real.sqrt (T0th w.1 w.2 ^ 2 + T0z w.1 w.2 ^ 2))
        =ᶠ[nhds ((X, η) : ℝ × ℝ)] (fun z : ℝ × ℝ => leadStressTz h F' U' z.1 z.2 /
          Real.sqrt (leadStressTh h F' U' z.1 z.2 ^ 2 + leadStressTz h F' U' z.1 z.2 ^ 2)) :=
      Filter.eventuallyEq_of_mem hmem (fun w hw => by
        simp only [hp1 w.1 w.2 hw.2.1 hw.2.2, hp2 w.1 w.2 hw.2.1 hw.2.2])
    exact ⟨(ev1.iteratedFDeriv ℝ m).eq_of_nhds, (ev2.iteratedFDeriv ℝ m).eq_of_nhds,
      (ev3.iteratedFDeriv ℝ m).eq_of_nhds, (ev4.iteratedFDeriv ℝ m).eq_of_nhds⟩
  obtain ⟨⟨c₀, hc₀, hlow⟩, hder, ⟨κ, hκ0, hκ2, hcone⟩⟩ := hAll
  unfold LeadingProfile
  refine ⟨⟨hh0, hh1, hlam, hcinf, hcp, haa, hab, hXa, hXap1, hp12, hp2m1, hm12, hm2Xv, hXvXc, hXcXb⟩,
    ?LP1, ?LP2, ?LP3, ?LP4, ?LP5, PR6, ?LP7, ?LP8, ?LP9, ?LP10⟩
  case LP1 =>
    refine ⟨PR1.mono (prod_mono (Ioi_subset_Ioi (by linarith)) subset_rfl),
      PR2.mono (prod_mono (Ioi_subset_Ioi (by linarith)) subset_rfl),
      fun X η hX e1 e2 => PR3 X η hX.le e1 e2, fun X₀ X₁ hX₀ m => ?_⟩
    obtain ⟨C, hC⟩ := PR4 X₁ m
    exact ⟨C, fun X η h1 h2 e1 e2 => hC X η (by linarith) h2 e1 e2⟩
  case LP2 =>
    refine ⟨hTh.congr (fun z hz => hp1 z.1 z.2 hz.2.1 hz.2.2),
      hTz.congr (fun z hz => hp2 z.1 z.2 hz.2.1 hz.2.2), ?_,
      ⟨c₀, hc₀, fun X η h1 h2 e1 e2 => ?_⟩, fun m => ?_, fun m => ?_,
      ⟨κ, hκ0, hκ2, fun X η h1 h2 e1 e2 => ?_⟩⟩
    · intro X η hX hW
      by_cases hη : -1 < η ∧ η < 1
      · rw [hT1', hT2', if_pos hη, if_pos hη]
        obtain ⟨q1, q2⟩ : leadStressTh h F' U' X η = leadStressTh h F U X η ∧
            leadStressTz h F' U' X η = leadStressTz h F U X η := by
          rcases hW with hW | hW
          · exact hst X η hη.1 hη.2 (Or.inl ⟨hX, by linarith⟩)
          · exact hst X η hη.1 hη.2 (Or.inr (by linarith))
        rw [q1, q2]
        exact J2.1 X η hX hW hη.1 hη.2
      · rw [hT1', hT2', if_neg hη, if_neg hη]
        exact ⟨rfl, rfl⟩
    · rw [hp1 X η e1 e2, hp2 X η e1 e2]
      exact hlow X ⟨h1, h2⟩ η e1 e2
    · obtain ⟨C, N, hb⟩ := hder m
      refine ⟨C, N, fun X η h1 h2 e1 e2 => ?_⟩
      obtain ⟨i1, i2, -, -⟩ := iter m X η e1 e2
      rw [i1, i2]
      exact ⟨(hb X ⟨h1, h2⟩ η e1 e2).1, (hb X ⟨h1, h2⟩ η e1 e2).2.1⟩
    · obtain ⟨C, N, hb⟩ := hder m
      refine ⟨C, fun X η h1 h2 e1 e2 => ?_⟩
      obtain ⟨-, -, i3, i4⟩ := iter m X η e1 e2
      rw [i3, i4]
      exact ⟨(hb X ⟨h1, h2⟩ η e1 e2).2.2.1, (hb X ⟨h1, h2⟩ η e1 e2).2.2.2⟩
    · rw [hp1 X η e1 e2, hp2 X η e1 e2]
      exact hcone X ⟨h1, h2⟩ η e1 e2
  case LP3 =>
    exact fun X η _ e1 e2 => ⟨hp1 X η e1 e2, hp2 X η e1 e2⟩
  case LP4 =>
    exact ⟨ε, hε, PR1, PR2, fun η e1 e2 => PR3 0 η le_rfl e1 e2, PR4⟩
  case LP5 =>
    obtain ⟨ρ, hρ, Fc, Uc, Pc, hk⟩ := J8
    refine ⟨Xan, ρ, hXaXan, by linarith, hρ, Fc, Uc, Pc, fun k => ?_⟩
    obtain ⟨C, c1, c2, c3, hX⟩ := hk k
    refine ⟨C, c1, c2, c3, fun X hX0 hXan => ?_⟩
    obtain ⟨d1, d2, d3, b, hid⟩ := hX X hX0 hXan
    refine ⟨d1, d2, d3, b, fun η e1 e2 => ?_⟩
    obtain ⟨i1, i2, i3⟩ := hid η e1 e2
    have hXm : X < Xm' := by linarith
    have hnb : Iio Xm' ∈ nhds X := isOpen_Iio.mem_nhds hXm
    have eF : iteratedDeriv k (fun Y => F' Y η) X = iteratedDeriv k (fun Y => F Y η) X :=
      Filter.EventuallyEq.iteratedDeriv_eq k
        (Filter.eventuallyEq_of_mem hnb (fun Y hY => (hag Y η (Or.inl (le_of_lt hY))).1))
    have eU : iteratedDeriv k (fun Y => U' Y η) X = iteratedDeriv k (fun Y => U Y η) X :=
      Filter.EventuallyEq.iteratedDeriv_eq k
        (Filter.eventuallyEq_of_mem hnb (fun Y hY => (hag Y η (Or.inl (le_of_lt hY))).2))
    have eP : iteratedDeriv k (fun Y => leadPi F' Y η) X = iteratedDeriv k (fun Y => leadPi F Y η) X :=
      Filter.EventuallyEq.iteratedDeriv_eq k
        (Filter.eventuallyEq_of_mem hnb (fun Y hY => s2L F F' Xm' η hXm'0
          (fun x hx => (hag x η (Or.inl hx)).1) (J5 η e1 e2).1 (PR5 η e1 e2) (hmom η e1 e2).1 Y hY))
    rw [eF, eU, eP]
    exact ⟨i1, i2, i3⟩
  case LP7 =>
    intro X η hX e1 e2
    have hs2X : s2 ≤ X := by linarith
    have hX0 : 0 ≤ X := by linarith
    obtain ⟨u0, pu0⟩ := J10 X η hX e1 e2
    have hm := hmom η e1 e2
    refine ⟨by rw [(hag X η (Or.inr hs2X)).2]; exact u0, ?_⟩
    rw [s4L U U' s2 X η hs2X (fun x hx => (hag x η (Or.inr hx)).2) ((J5 η e1 e2).2 X hX0).1
      ((J5 η e1 e2).2 s2 hs20.le).1 (hm.2.2.2.2.2 X hX0).1 (hm.2.2.2.2.2 s2 hs20.le).1 hm.2.1]
    exact pu0
  case LP8 =>
    intro X η hX e1 e2
    have hs : s2 ≤ X := by
      rcases hX with ⟨h1, _⟩ | ⟨h1, _⟩ <;> linarith
    rw [(hag X η (Or.inr hs)).1, (hag X η (Or.inr hs)).2]
    exact J11 X η hX e1 e2
  case LP9 =>
    intro η e1 e2
    have hm := hmom η e1 e2
    obtain ⟨z1, z2, z3⟩ := J12 η e1 e2
    have pk' := hm.2.2.2.2.2 s2 hs20.le
    have pk := (J5 η e1 e2).2 s2 hs20.le
    have r3 := hm.2.2.1
    have r4 := hm.2.2.2.1
    have r5 := hm.2.2.2.2.1
    simp only [profRadInt] at r3 r4 r5
    refine ⟨?_, ?_, ?_⟩
    · have j1 : (∫ x in (0:ℝ)..s2, (U' x η * (2 * x * F' x η) - U x η * (2 * x * F x η))) = 0 := by
        rw [intervalIntegral.integral_sub pk'.2.2.1 pk.2.2.1]
