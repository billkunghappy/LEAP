    obtain ⟨-, -, hP0, hN0, -⟩ := hRef.2.2.2.2.2 0 (4 / Λ * Real.exp y) η hZ4 hZ hη1.le hη2.le
    obtain ⟨-, -, hP1, hN1, -⟩ := hRef.2.2.2.2.2 1 (4 / Λ * Real.exp y) η hZ4 hZ hη1.le hη2.le
