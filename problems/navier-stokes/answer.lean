  have hlam : 0 ≤ 1 + |(m:ℝ)| := by positivity
  have hX : X ≤ (1 + |(m:ℝ)|) * X0 * simScale B.h (z.1 2) (1 - z.2) ^ (-(aX + aY)) := by
