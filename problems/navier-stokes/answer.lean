  have hE4 : 2 * Aex B.h = Aex B.h + Aex B.h := by ring
  have hW' : ∀ a b : Fin 3, InM B (qsOf l0) 1 (nrm B (Aex B.h + Aex B.h) (Wcov5 B G l0 S a b)) :=
    fun a b => hexp _ _ _ _ (hW a b) hE4

  obtain ⟨t1, ht1⟩ : ∃ f : Cyl → ℝ, f = dT (mcor5 B G l0 S 0) := ⟨_, rfl⟩
  have hT1 : InM B (qsOf l0) (4/5) (nrm B (2 * Aex B.h + 1/2) t1) := by
