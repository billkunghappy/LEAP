  intro cinf ρ Xb F U hρ hρle hXb hTF hsmall
  have hTF' := hTF
  obtain ⟨hh0, hh1, hc0, hXb0, hρ0', _, _, _, _, htail, _⟩ := hTF'
  have hρh : ρ ≤ h / 800 := by rw [if_pos hh0] at hρle; exact hρle
  have hρ12 : ρ ≤ 1 / 2 := by linarith
  obtain ⟨βθ, Bz, β8, r, c, hc, hβs, hBs, h8s, hrs, hbd, hpos, hid⟩ :=
