        _ ≤ 3 * M * ‖z - z'‖ := by
          have := hBb t; have := hP2 z z'
          have := norm_nonneg (P z - P z'); have := norm_nonneg (fun i j : Fin 3 => A (proj t) i j)
          nlinarith
    have hfc : ∀ z, Continuous (fun t => f t z) := by
      intro z
      have hij : ∀ i j, Continuous (fun t => A (proj t) i j) := fun i j =>
        (continuous_apply j).comp ((continuous_apply i).comp hBc)
      refine continuous_pi (fun i => ?_)
      rw [hf]
      simp only [Matrix.mulVec, dotProduct]
      exact continuous_finsetSum _ (fun j _ => (hij i j).mul continuous_const)
    have hPL : IsPicardLindelof f (tmin := w - 1) (tmax := L + 1)
        ⟨w, ⟨by linarith, by linarith⟩⟩ x0
        (Real.toNNReal (3 * M * R * (L + 1 - w))) 0 (Real.toNNReal (3 * M * R))
        (Real.toNNReal (3 * M)) := by
      apply IsPicardLindelof.mk
      · intro t _
        apply LipschitzWith.lipschitzOnWith
        apply LipschitzWith.of_dist_le_mul
        intro z z'
        rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ (by positivity)]
        exact hfL t z z'
      · intro z _
        exact (hfc z).continuousOn
      · intro t _ z _
        rw [Real.coe_toNNReal _ (by positivity)]
        exact hfb t z
      · show ((Real.toNNReal (3 * M * R) : ℝ)) * max (L + 1 - w) (w - (w - 1)) ≤
          (Real.toNNReal (3 * M * R * (L + 1 - w)) : ℝ) - ((0 : NNReal) : ℝ)
        rw [Real.coe_toNNReal _ (by positivity),
          Real.coe_toNNReal _ (mul_nonneg (by positivity) (by linarith)), NNReal.coe_zero, sub_zero,
          max_eq_left (by linarith)]
    obtain ⟨α, hα0, hα⟩ := hPL.exists_eq_forall_mem_Icc_hasDerivWithinAt₀
    have hα0' : α w = x0 := hα0
    have hαd : ∀ t ∈ Set.Icc w L, HasDerivAt α (f t (α t)) t := fun t ht =>
      (hα t ⟨by linarith [ht.1], by linarith [ht.2]⟩).hasDerivAt
