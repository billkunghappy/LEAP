theorem rem_split_offsupp5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (m : ℤ) (ξ : Cyl), (primState5 B G).Aw γ m =ᶠ[nhds ξ] 0 → (primState5 B G).pw γ m =ᶠ[nhds ξ] 0 → W0h4 B G γ m =ᶠ[nhds ξ] 0 → (linC5 B G - princC5 B G) γ m ξ = (remSlow5 B (ampA5 B G) + remPhase5 B G (ampA5 B G) + remPres5 B (presP5 B G) + remVisc5 B G (ampA5 B G) + remBase5 B (ampA5 B G) + primOp5 B G (fun γ' m' η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • ampD5 B G γ' m' η)) γ m ξ :=
by
  intro B G γ m ξ hAw hpw hW

  have gf1 : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (f : Cyl → W) (w : Cyl → Cyl),
      f =ᶠ[nhds ξ] 0 → (fun η => fderiv ℝ f η (w η)) =ᶠ[nhds ξ] 0 := by
    intro W _ _ f w hf
    filter_upwards [hf.eventuallyEq_nhds] with η hη
    rw [hη.fderiv_eq]
    simp [fderiv_zero]
  have hdR : ∀ (f : Cyl → ℂ), f =ᶠ[nhds ξ] 0 → dR B.h f =ᶠ[nhds ξ] 0 := fun f hf =>
    gf1 f (fun η => (1, 0, 0, (drx B.h * η.1 ^ (drx B.h - 1)) • vrv)) hf
  have hdZ : ∀ (f : Cyl → ℂ), f =ᶠ[nhds ξ] 0 → dZ f =ᶠ[nhds ξ] 0 := fun f hf =>
    gf1 f (fun _ => (0, 1, 0, 0)) hf
  have hdT : ∀ (f : Cyl → ℂ), f =ᶠ[nhds ξ] 0 → dT f =ᶠ[nhds ξ] 0 := fun f hf =>
    gf1 f (fun _ => (0, 0, 1, vtv)) hf
  have hdTsV : ∀ (f : Cyl → ℂ), f =ᶠ[nhds ξ] 0 → dTsV f =ᶠ[nhds ξ] 0 := fun f hf =>
    gf1 f (fun _ => (0, 0, 1, ((0:ℝ), (0:ℝ)))) hf
  have hdVc : ∀ (l : ℕ) (F : Cyl → (Fin 3 → ℂ)), F =ᶠ[nhds ξ] 0 → dVc B l F =ᶠ[nhds ξ] 0 := fun l F hF =>
    gf1 F (fun _ => dVdir B.h l) hF

  have hcomp : ∀ (F : Cyl → (Fin 3 → ℂ)) (i : Fin 3), F =ᶠ[nhds ξ] 0 → (fun η => F η i) =ᶠ[nhds ξ] 0 := by
    intro F i hF
    filter_upwards [hF] with η h
    simp [h]

  have ev0 : ∀ {W : Type} [NormedAddCommGroup W] (f : Cyl → W), f =ᶠ[nhds ξ] 0 → f ξ = 0 := by
    intro W _ f hf
    simpa using hf.eq_of_nhds

  have hmcurl : ∀ (n : ℤ) (C : Cyl → (Fin 3 → ℂ)), C =ᶠ[nhds ξ] 0 → mcurlC B.h n C =ᶠ[nhds ξ] 0 := by
    intro n C hC
    filter_upwards [hC, hdZ _ (hcomp C 1 hC), hdZ _ (hcomp C 0 hC), hdR _ (hcomp C 2 hC),
      hdR _ (hcomp C 1 hC)] with η h0 h1 h2 h3 h4
    simp only [Pi.zero_apply] at h0 h1 h2 h3 h4
    funext i
    fin_cases i <;> simp [mcurlC, h0, h1, h2, h3, h4]

  have hmres : ∀ (n : ℤ) (a : Cyl → (Fin 3 → ℂ)) (p : Cyl → ℂ), a =ᶠ[nhds ξ] 0 → p =ᶠ[nhds ξ] 0 →
      mresC B n a p ξ = 0 := by
    intro n a p ha hp
    have hai : ∀ i, (fun η => a η i) =ᶠ[nhds ξ] 0 := fun i => hcomp a i ha
    have v0 : ∀ i, a ξ i = 0 := fun i => ev0 _ (hai i)
    have vT : ∀ i, dT (fun η => a η i) ξ = 0 := fun i => ev0 _ (hdT _ (hai i))
    have vR : ∀ i, dR B.h (fun η => a η i) ξ = 0 := fun i => ev0 _ (hdR _ (hai i))
    have vZ : ∀ i, dZ (fun η => a η i) ξ = 0 := fun i => ev0 _ (hdZ _ (hai i))
    have vRR : ∀ i, dR B.h (dR B.h (fun η => a η i)) ξ = 0 := fun i => ev0 _ (hdR _ (hdR _ (hai i)))
    have vZZ : ∀ i, dZ (dZ (fun η => a η i)) ξ = 0 := fun i => ev0 _ (hdZ _ (hdZ _ (hai i)))
    have pv : p ξ = 0 := ev0 _ hp
    have pR : dR B.h p ξ = 0 := ev0 _ (hdR _ hp)
    have pZ : dZ p ξ = 0 := ev0 _ (hdZ _ hp)
    funext i
    fin_cases i <;> simp [mresC, mlapC, v0, vT, vR, vZ, vRR, vZZ, pv, pR, pZ]

  have hvelg : ∀ (c : WC), c γ m =ᶠ[nhds ξ] 0 → velC5 B G c γ m =ᶠ[nhds ξ] 0 := by
    intro c hc
    filter_upwards [hc, hdR _ (hcomp _ 0 hc), hdR _ (hcomp _ 1 hc), hdR _ (hcomp _ 2 hc),
      hdZ _ (hcomp _ 0 hc), hdZ _ (hcomp _ 1 hc), hdZ _ (hcomp _ 2 hc)] with η h0 r0 r1 r2 z0 z1 z2
    simp only [Pi.zero_apply] at h0 r0 r1 r2 z0 z1 z2
    funext i
    fin_cases i <;> simp [velC5, DrC, DzC, h0, r0, r1, r2, z0, z1, z2]

  have hwmo : wmoAmp5 B G (primState5 B G).Aw γ m =ᶠ[nhds ξ] 0 := by
    filter_upwards [hAw, hvelg _ hAw] with η h1 h2
    simp only [Pi.zero_apply] at h1 h2
    funext i
    fin_cases i <;> simp [wmoAmp5, velW5, h1, h2, rotC]
  have hA : ampA5 B G γ m =ᶠ[nhds ξ] 0 := by
    filter_upwards [hwmo] with η h
    simp only [Pi.zero_apply] at h
    simp [ampA5, h]
  have hPP : presP5 B G γ m =ᶠ[nhds ξ] 0 := by
    filter_upwards [hpw] with η h
    simp only [Pi.zero_apply] at h
    simp [presP5, h]
  have hD : (fun γ' m' η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • ampD5 B G γ' m' η) γ m =ᶠ[nhds ξ] 0 := by
    filter_upwards [hwmo, hW] with η h1 h2
    simp only [Pi.zero_apply] at h1 h2
    simp [ampD5, h1, h2]

  have hrem : ∀ (a : WC) (P : WS) (d : WC), a γ m =ᶠ[nhds ξ] 0 → P γ m =ᶠ[nhds ξ] 0 →
      d γ m =ᶠ[nhds ξ] 0 →
      (remSlow5 B a + remPhase5 B G a + remPres5 B P + remVisc5 B G a + remBase5 B a + primOp5 B G d) γ m ξ
        = 0 := by
    intro a P d ha hP hd
    have hai : ∀ i, (fun η => a γ m η i) =ᶠ[nhds ξ] 0 := fun i => hcomp (a γ m) i ha
    have a0 : a γ m ξ = 0 := ev0 _ ha
    have v0 : ∀ i, a γ m ξ i = 0 := fun i => ev0 _ (hai i)
    have vS : ∀ i, dTsV (fun η => a γ m η i) ξ = 0 := fun i => ev0 _ (hdTsV _ (hai i))
    have vR : ∀ i, dR B.h (fun η => a γ m η i) ξ = 0 := fun i => ev0 _ (hdR _ (hai i))
    have vZ : ∀ i, dZ (fun η => a γ m η i) ξ = 0 := fun i => ev0 _ (hdZ _ (hai i))
    have vRR : ∀ i, dR B.h (fun η => dR B.h (fun η' => a γ m η' i) η) ξ = 0 := fun i =>
      ev0 _ (hdR _ (hdR _ (hai i)))
    have vZZ : ∀ i, dZ (fun η => dZ (fun η' => a γ m η' i) η) ξ = 0 := fun i =>
      ev0 _ (hdZ _ (hdZ _ (hai i)))
    have pR : dR B.h (P γ m) ξ = 0 := ev0 _ (hdR _ hP)
    have pZ : dZ (P γ m) ξ = 0 := ev0 _ (hdZ _ hP)
    have d0 : d γ m ξ = 0 := ev0 _ hd
    have dV : dVc B γ.1 (d γ m) ξ = 0 := ev0 _ (hdVc _ _ hd)
    have e1 : remSlow5 B a γ m ξ = 0 := by
      funext i
      simp [remSlow5, vS, vR, vZ]
    have e2 : remPhase5 B G a γ m ξ = 0 := by
      simp [remPhase5, a0]
    have e3 : remPres5 B P γ m ξ = 0 := by
      funext i
      fin_cases i <;> simp [remPres5, pR, pZ]
    have e4 : remVisc5 B G a γ m ξ = 0 := by
      funext i
      fin_cases i <;> simp [remVisc5, v0, vR, vZ, vRR, vZZ]
    have e5 : remBase5 B a γ m ξ = 0 := by
      funext i
      fin_cases i <;> simp [remBase5, v0]
    have e6 : primOp5 B G d γ m ξ = 0 := by
      simp [primOp5, d0, dV]
    simp only [Pi.add_apply]
    rw [e1, e2, e3, e4, e5, e6]
    simp

  have hC : cofA5 B G γ m =ᶠ[nhds ξ] 0 := by
    filter_upwards [hAw] with η h
    simp only [Pi.zero_apply] at h
    simp [cofA5, h]
  have hP : cofP5 B G γ m =ᶠ[nhds ξ] 0 := by
    filter_upwards [hpw] with η h
    simp only [Pi.zero_apply] at h
    simp [cofP5, h]
  have hL : linC5 B G γ m ξ = 0 := by
    have e : linC5 B G γ m ξ = (((qC B.h ξ ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) *
        (Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))⁻¹) •
        mresC B (m * pint5 B G γ) (mcurlC B.h (m * pint5 B G γ) (cofA5 B G γ m)) (cofP5 B G γ m) ξ := rfl
    rw [e, hmres _ _ _ (hmcurl _ _ hC) hP, smul_zero]
  have hWv : W0h4 B G γ m ξ = 0 := ev0 _ hW
  have hWd : dVc B γ.1 (W0h4 B G γ m) ξ = 0 := ev0 _ (hdVc _ _ hW)
  have hpv : (primState5 B G).pw γ m ξ = 0 := ev0 _ hpw
  have hPr : princC5 B G γ m ξ = 0 := by
    simp [princC5, hWv, hWd, hpv]
  simp only [Pi.sub_apply]
  rw [hL, hPr, sub_zero]
  exact (hrem _ _ _ hA hPP hD).symm

theorem amp_smooth_near5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (m : ℤ) (U : Set Cyl), B.ok → IsOpen U → U ⊆ DomC B.h B.qB → ContDiffOn ℝ ∞ (phiL5 B G γ) U → ContDiffOn ℝ ∞ ((primState5 B G).Aw γ m) U → ContDiffOn ℝ ∞ ((primState5 B G).pw γ m) U → ContDiffOn ℝ ∞ (W0h4 B G γ m) U → ContDiffOn ℝ ∞ (ampA5 B G γ m) U ∧ ContDiffOn ℝ ∞ (ampD5 B G γ m) U ∧ ContDiffOn ℝ ∞ (presP5 B G γ m) U :=
by
  intro B G γ m U hok hU hUsub hφ hAw hpw hW
  have hpos : ∀ ξ ∈ U, 0 < ξ.1 := fun ξ hξ => (hUsub hξ).1

  have hdir : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V),
      ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ (dR B.h f) U ∧ ContDiffOn ℝ ∞ (dZ f) U := by
    intro V _ _ f hf
    have hDf : ContDiffOn ℝ ∞ (fderiv ℝ f) U :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hf).2
    have hpow : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1 ^ (drx B.h - 1)) U :=
      contDiff_fst.contDiffOn.rpow_const_of_ne (fun ξ hξ => (hpos ξ hξ).ne')
    have hY : ContDiffOn ℝ ∞ (fun ξ : Cyl => (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) U :=
      (contDiffOn_const.mul hpow).smul_const _
    have hvR : ContDiffOn ℝ ∞ (fun ξ : Cyl =>
        ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) U :=
      contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk hY))
    exact ⟨(hDf.clm_apply hvR).congr (fun ξ _ => rfl),
      (hDf.clm_apply contDiffOn_const).congr (fun ξ _ => rfl)⟩

  have hq : ContDiffOn ℝ ∞ (qC B.h) U := by
    have h4' : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1
    have hπ : ContDiff ℝ ∞ (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) U (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := (hUsub hξ).2.1
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    exact (h4'.comp hπ.contDiffOn hmaps).congr (fun ξ _ => rfl)
  have hq0 : ∀ ξ ∈ U, 0 < qC B.h ξ := by
    intro ξ hξ
    have h' : ξ.2.2.1 < 1 := (hUsub hξ).2.1
    exact (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hlogU : ContDiffOn ℝ ∞ (fun η => Real.log (qC B.h η)) U :=
    hq.log (fun ξ hξ => (hq0 ξ hξ).ne')
  have hℓ : ContDiffOn ℝ ∞ (dZ (fun η => Real.log (qC B.h η))) U :=
    (hdir _ hlogU).2
  have hcast : ∀ g : Cyl → ℝ, ContDiffOn ℝ ∞ g U →
      ContDiffOn ℝ ∞ (fun η => ((g η : ℝ) : ℂ)) U := by
    intro g hg
    exact (Complex.ofRealCLM.contDiff.comp_contDiffOn hg).congr
      (fun η _ => by simp only [Function.comp_apply, Complex.ofRealCLM_apply])

  have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have hsQ : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr hQ
  have hRC : ContDiffOn ℝ ∞ (fun η : Cyl => RC γ.1 η) U := by
    unfold RC
    exact (contDiff_fst.div_const _).contDiffOn
  have hRCne : ∀ η ∈ U, RC γ.1 η ≠ 0 := fun η hη => (div_pos (hpos η hη) hsQ).ne'
  have hRCi : ContDiffOn ℝ ∞ (fun η : Cyl => (RC γ.1 η)⁻¹) U := hRC.inv hRCne

  have hn : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun ξ => nPhi5 B G γ ξ i) U := by
    obtain ⟨hdRφ, hdZφ⟩ := hdir _ hφ
    intro i
    fin_cases i
    · exact (hdRφ.const_smul (Real.sqrt (Qb γ.1))).congr (fun ξ _ => rfl)
    · exact ((contDiffOn_const (c := pang5 B G γ)).div hRC hRCne).congr (fun ξ _ => rfl)
    · exact (hdZφ.const_smul (Real.sqrt (Qb γ.1))).congr (fun ξ _ => rfl)
  have hnc : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun ξ => ((nPhi5 B G γ ξ i : ℝ) : ℂ)) U :=
    fun i => hcast _ (hn i)

  have hAwi : ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η => (primState5 B G).Aw γ m η j) U :=
    fun j => contDiffOn_pi.1 hAw j
  have hDr : ∀ j : Fin 3, ContDiffOn ℝ ∞
      (fun ξ => DrC B γ.1 (fun η => (primState5 B G).Aw γ m η j) ξ) U :=
    fun j => ((hdir _ (hAwi j)).1.const_smul (Real.sqrt (Qb γ.1))).congr (fun ξ _ => rfl)
  have hDz : ∀ j : Fin 3, ContDiffOn ℝ ∞
      (fun ξ => DzC B γ.1 (fun η => (primState5 B G).Aw γ m η j) ξ) U :=
    fun j => ((hdir _ (hAwi j)).2.const_smul (Real.sqrt (Qb γ.1))).congr (fun ξ _ => rfl)

  have hvel : ContDiffOn ℝ ∞ (velW5 B G (primState5 B G).Aw γ m) U := by
    refine contDiffOn_pi.2 (fun i => ?_)
    fin_cases i
    · exact (((contDiffOn_const (c := Complex.I * (kb B.h γ.1 : ℂ) * (m : ℂ))).mul
        (((hnc 1).mul (hAwi 2)).sub ((hnc 2).mul (hAwi 1)))).sub (hDz 1)).congr (fun ξ _ => rfl)
    · exact ((((contDiffOn_const (c := Complex.I * (kb B.h γ.1 : ℂ) * (m : ℂ))).mul
        (((hnc 2).mul (hAwi 0)).sub ((hnc 0).mul (hAwi 2)))).add (hDz 0)).sub (hDr 2)).congr
        (fun ξ _ => rfl)
    · refine ((((contDiffOn_const (c := Complex.I * (kb B.h γ.1 : ℂ) * (m : ℂ))).mul
        (((hnc 0).mul (hAwi 1)).sub ((hnc 1).mul (hAwi 0)))).add (hDr 1)).add
        ((hAwi 1).mul (hcast _ hRCi))).congr (fun ξ _ => ?_)
      show Complex.I * (kb B.h γ.1 : ℂ) * (m : ℂ) *
          (((nPhi5 B G γ ξ 0 : ℝ) : ℂ) * (primState5 B G).Aw γ m ξ 1 -
            ((nPhi5 B G γ ξ 1 : ℝ) : ℂ) * (primState5 B G).Aw γ m ξ 0) +
          DrC B γ.1 (fun η => (primState5 B G).Aw γ m η 1) ξ +
          (primState5 B G).Aw γ m ξ 1 / ((RC γ.1 ξ : ℝ) : ℂ) =
        Complex.I * (kb B.h γ.1 : ℂ) * (m : ℂ) *
          (((nPhi5 B G γ ξ 0 : ℝ) : ℂ) * (primState5 B G).Aw γ m ξ 1 -
            ((nPhi5 B G γ ξ 1 : ℝ) : ℂ) * (primState5 B G).Aw γ m ξ 0) +
          DrC B γ.1 (fun η => (primState5 B G).Aw γ m η 1) ξ +
          (primState5 B G).Aw γ m ξ 1 * (((RC γ.1 ξ)⁻¹ : ℝ) : ℂ)
      rw [div_eq_mul_inv, Complex.ofReal_inv]

  have he3 : ContDiffOn ℝ ∞ (fun η => (qC B.h η / Qb γ.1) ^ (1/2:ℝ)) U :=
    (hq.div_const _).rpow_const_of_ne (fun η hη => (div_pos (hq0 η hη) hQ).ne')
  have he4 : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (1/2:ℝ)) U :=
    hq.rpow_const_of_ne (fun η hη => (hq0 η hη).ne')
  have he6 : ContDiffOn ℝ ∞
      (fun η => B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun η => Real.log (qC B.h η)) η) U :=
    ((contDiffOn_const (c := B.h)).mul he4).mul hℓ
  have hrot : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => rotC ((primState5 B G).Aw γ m η) i) U := by
    intro i
    fin_cases i
    · exact (hAwi 1).congr (fun _ _ => rfl)
    · exact (hAwi 0).neg.congr (fun _ _ => rfl)
    · exact (contDiffOn_const (c := (0:ℂ))).congr (fun _ _ => rfl)
  have hw : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => wmoAmp5 B G (primState5 B G).Aw γ m η i) U := by
    intro i
    exact (((hcast _ he3).mul (contDiffOn_pi.1 hvel i)).add
      ((hcast _ he6).mul (hrot i))).congr (fun _ _ => rfl)

  have he1 : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-Aex B.h)) U :=
    hq.rpow_const_of_ne (fun η hη => (hq0 η hη).ne')
  have he2 : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-2 * Aex B.h)) U :=
    hq.rpow_const_of_ne (fun η hη => (hq0 η hη).ne')
  have he5 : ContDiffOn ℝ ∞ (fun η => rhoQ B γ η ^ (1/2:ℝ)) U :=
    he3.congr (fun _ _ => rfl)
  refine ⟨?_, ?_, ?_⟩
  · refine contDiffOn_pi.2 (fun i => ?_)
    exact ((hcast _ he1).mul (hw i)).congr (fun _ _ => rfl)
  · refine contDiffOn_pi.2 (fun i => ?_)
    exact ((hw i).sub ((hcast _ he5).mul (contDiffOn_pi.1 hW i))).congr (fun _ _ => rfl)
  · exact ((hcast _ he2).mul hpw).congr (fun _ _ => rfl)

theorem lin_germ_reduction5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (m : ℤ) (U : Set Cyl), B.ok → IsOpen U → U ⊆ DomC B.h B.qB → ContDiffOn ℝ ∞ (phiL5 B G γ) U → ContDiffOn ℝ ∞ ((primState5 B G).Aw γ m) U → ∀ ξ ∈ U, linC5 B G γ m ξ = ((((qC B.h ξ ^ (2 * Aex B.h + 1/2)) : ℝ) : ℂ) * (Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))⁻¹) • mresC B (m * pint5 B G γ) (fun η => Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) • ampA5 B G γ m η) (fun η => Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) * presP5 B G γ m η) ξ :=
by
  intro B G γ m U hok hUo hUsub hφ hAw ξ hξ
  have hS : SimScaleProps B.h := hok.1
  have hqpos : ∀ η ∈ DomC B.h B.qB, 0 < qC B.h η := fun η hη =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith [hη.2.1])).1
  have hqdiff : ∀ η ∈ DomC B.h B.qB, DifferentiableAt ℝ (qC B.h) η := by
    intro η hη
    have hmem : ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) :=
      ⟨mem_univ _, show (0:ℝ) < 1 - η.2.2.1 by linarith [hη.2.1]⟩
    have hat : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (η.2.1, 1 - η.2.2.1) :=
      hS.2.2.2.1.contDiffAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds hmem)
    have hp : DifferentiableAt ℝ (fun η' : Cyl => ((η'.2.1, 1 - η'.2.2.1) : ℝ × ℝ)) η := by fun_prop
    show DifferentiableAt ℝ ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
      (fun η' : Cyl => ((η'.2.1, 1 - η'.2.2.1) : ℝ × ℝ))) η
    exact (hat.differentiableAt (by simp)).comp η hp
  have hQ : 0 < Qb γ.1 := by unfold Qb; positivity
  have hk : 0 < kb B.h γ.1 :=
    Nat.ceil_pos.mpr (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos hQ _) _)
  have hk' : ((kb B.h γ.1 : ℕ) : ℂ) ≠ 0 := by exact_mod_cast hk.ne'
  have hsQ : (((Real.sqrt (Qb γ.1)) : ℝ) : ℂ) ≠ 0 := by
    exact_mod_cast (Real.sqrt_pos.mpr hQ).ne'

  have hgerm : ∀ (n : ℤ) (a a' : Cyl → (Fin 3 → ℂ)) (p : Cyl → ℂ), a =ᶠ[nhds ξ] a' →
      mresC B n a p ξ = mresC B n a' p ξ := by
    intro n a a' p hA
    have hloc : ∀ (f g : Cyl → ℂ) (y : Cyl), f =ᶠ[nhds y] g →
        dR B.h f y = dR B.h g y ∧ dZ f y = dZ g y ∧ dT f y = dT g y := by
      intro f g y hfg
      have e := hfg.fderiv_eq (𝕜 := ℝ)
      simp only [dR, dZ, dT, e, and_self]
    have hc : ∀ i : Fin 3, (fun η => a η i) =ᶠ[nhds ξ] (fun η => a' η i) := fun i =>
      hA.mono (fun η hη => congrFun hη i)
    have hRR : ∀ i : Fin 3, dR B.h (fun η => a η i) =ᶠ[nhds ξ] dR B.h (fun η => a' η i) := by
      intro i
      filter_upwards [(hc i).eventuallyEq_nhds] with y hy
      exact (hloc _ _ y hy).1
    have hZZ : ∀ i : Fin 3, dZ (fun η => a η i) =ᶠ[nhds ξ] dZ (fun η => a' η i) := by
      intro i
      filter_upwards [(hc i).eventuallyEq_nhds] with y hy
      exact (hloc _ _ y hy).2.1
    have hv : a ξ = a' ξ := hA.eq_of_nhds
    have h1 : ∀ i : Fin 3, dR B.h (fun η => a η i) ξ = dR B.h (fun η => a' η i) ξ :=
      fun i => (hloc _ _ ξ (hc i)).1
    have h2 : ∀ i : Fin 3, dZ (fun η => a η i) ξ = dZ (fun η => a' η i) ξ :=
      fun i => (hloc _ _ ξ (hc i)).2.1
    have h3 : ∀ i : Fin 3, dT (fun η => a η i) ξ = dT (fun η => a' η i) ξ :=
      fun i => (hloc _ _ ξ (hc i)).2.2
    have h4 : ∀ i : Fin 3, dR B.h (dR B.h (fun η => a η i)) ξ = dR B.h (dR B.h (fun η => a' η i)) ξ :=
      fun i => (hloc _ _ ξ (hRR i)).1
    have h5 : ∀ i : Fin 3, dZ (dZ (fun η => a η i)) ξ = dZ (dZ (fun η => a' η i)) ξ :=
      fun i => (hloc _ _ ξ (hZZ i)).2.1
    simp only [mresC, mlapC, hv, h1, h2, h3, h4, h5]

  have hprod : ∀ (g φ : Cyl → ℝ) (F : Cyl → ℂ) (e : ℝ) (a b : ℂ) (η v : Cyl), 0 < g η →
      DifferentiableAt ℝ g η → DifferentiableAt ℝ φ η → DifferentiableAt ℝ F η →
      fderiv ℝ (fun η' => ((g η' ^ e : ℝ) : ℂ) * (Complex.exp (a * (b * (φ η' : ℂ))) * F η')) η v =
        ((e * g η ^ (e - 1) * fderiv ℝ g η v : ℝ) : ℂ) * (Complex.exp (a * (b * (φ η : ℂ))) * F η) +
        ((g η ^ e : ℝ) : ℂ) * (Complex.exp (a * (b * (φ η : ℂ))) *
          (fderiv ℝ F η v + a * b * ((fderiv ℝ φ η v : ℝ) : ℂ) * F η)) := by
    intro g φ F e a b η v hg hgd hφd hFd
    have h1 : HasFDerivAt (fun η' => g η' ^ e) ((e * g η ^ (e - 1)) • fderiv ℝ g η) η :=
      hgd.hasFDerivAt.rpow_const (Or.inl hg.ne')
    have h1c : HasFDerivAt (fun η' => ((g η' ^ e : ℝ) : ℂ))
        (Complex.ofRealCLM.comp ((e * g η ^ (e - 1)) • fderiv ℝ g η)) η :=
      Complex.ofRealCLM.hasFDerivAt.comp η h1
    have h2 : HasFDerivAt (fun η' => ((φ η' : ℝ) : ℂ)) (Complex.ofRealCLM.comp (fderiv ℝ φ η)) η :=
      Complex.ofRealCLM.hasFDerivAt.comp η hφd.hasFDerivAt
    have h3 := (h2.const_mul b).const_mul a
    have h4 := h3.cexp
    have h5 := h4.mul hFd.hasFDerivAt
    have h6 := h1c.mul h5
    have h7 : HasFDerivAt
        (fun η' => ((g η' ^ e : ℝ) : ℂ) * (Complex.exp (a * (b * (φ η' : ℂ))) * F η')) _ η := h6
    rw [h7.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.comp_apply, Complex.ofRealCLM_apply, smul_eq_mul, Pi.mul_apply]
    push_cast
    ring

  obtain ⟨Cf, hCf⟩ : ∃ Cf : Cyl → Fin 3 → ℂ, Cf = fun η => (((qC B.h η ^ (1/2 - Aex B.h)) : ℝ) : ℂ) •
      (Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) •
        (primState5 B G).Aw γ m η) := ⟨_, rfl⟩
  have hvec : ∀ v w : Fin 3 → ℂ, v 0 = w 0 → v 1 = w 1 → v 2 = w 2 → v = w := by
    intro v w h0 h1 h2
    ext i
    fin_cases i
    · exact h0
    · exact h1
    · exact h2
  have hcurl : ∀ η ∈ U, mcurlC B.h (m * pint5 B G γ) Cf η =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) • ampA5 B G γ m η := by
    intro η hη
    have hηD := hUsub hη
    have hr : 0 < η.1 := hηD.1
    have hq : 0 < qC B.h η := hqpos η hηD
    have hqd : DifferentiableAt ℝ (qC B.h) η := hqdiff η hηD
    have hφd : DifferentiableAt ℝ (phiL5 B G γ) η :=
      (hφ.contDiffAt (hUo.mem_nhds hη)).differentiableAt (by simp)
    have hAd : ∀ i : Fin 3, DifferentiableAt ℝ (fun η' => (primState5 B G).Aw γ m η' i) η := fun i =>
      differentiableAt_pi.1 ((hAw.contDiffAt (hUo.mem_nhds hη)).differentiableAt (by simp)) i

    have hqdir : ∀ w : ℝ × ℝ, fderiv ℝ (qC B.h) η ((1:ℝ), (0:ℝ), (0:ℝ), w) = 0 := by
      intro w
      have hc : HasDerivAt (fun t : ℝ => η + t • (((1:ℝ), (0:ℝ), (0:ℝ), w) : Cyl))
          (((1:ℝ), (0:ℝ), (0:ℝ), w) : Cyl) 0 := by
        simpa using ((hasDerivAt_id (0:ℝ)).smul_const (((1:ℝ), (0:ℝ), (0:ℝ), w) : Cyl)).const_add η
      have h := hqd.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hc (by simp)
      have hconst : (qC B.h ∘ fun t : ℝ => η + t • (((1:ℝ), (0:ℝ), (0:ℝ), w) : Cyl)) =
          fun _ => qC B.h η := by
        funext t
        simp [qC]
      rw [hconst] at h
      exact h.unique (hasDerivAt_const 0 _)
    have hlog : dZ (fun η' => Real.log (qC B.h η')) η = dZ (qC B.h) η / qC B.h η := by
      have hl := hqd.hasFDerivAt.log hq.ne'
      simp only [dZ]
      rw [hl.fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul, div_eq_inv_mul]
    have hC : ∀ i : Fin 3, Cf η i = (((qC B.h η ^ (1/2 - Aex B.h)) : ℝ) : ℂ) *
        (Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) *
          (primState5 B G).Aw γ m η i) := by
      intro i
      rw [hCf]
      rfl
    have hR : ∀ i : Fin 3, dR B.h (fun η' => Cf η' i) η = (((qC B.h η ^ (1/2 - Aex B.h)) : ℝ) : ℂ) *
        (Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) *
          (dR B.h (fun η' => (primState5 B G).Aw γ m η' i) η + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) *
            ((dR B.h (phiL5 B G γ) η : ℝ) : ℂ) * (primState5 B G).Aw γ m η i)) := by
      intro i
      have h := hprod (qC B.h) (phiL5 B G γ) (fun η' => (primState5 B G).Aw γ m η' i) (1/2 - Aex B.h)
        (Complex.I * (m : ℂ)) (kb B.h γ.1 : ℂ) η (1, 0, 0, (drx B.h * η.1 ^ (drx B.h - 1)) • vrv)
        hq hqd hφd (hAd i)
      simp only [hqdir, mul_zero, Complex.ofReal_zero, zero_mul, zero_add] at h
      rw [hCf]
      exact h
    have hZ : ∀ i : Fin 3, dZ (fun η' => Cf η' i) η =
        ((((1/2 - Aex B.h) * qC B.h η ^ (1/2 - Aex B.h - 1) * dZ (qC B.h) η) : ℝ) : ℂ) *
          (Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) *
            (primState5 B G).Aw γ m η i) +
        (((qC B.h η ^ (1/2 - Aex B.h)) : ℝ) : ℂ) *
        (Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) *
          (dZ (fun η' => (primState5 B G).Aw γ m η' i) η + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) *
            ((dZ (phiL5 B G γ) η : ℝ) : ℂ) * (primState5 B G).Aw γ m η i)) := by
      intro i
      have h := hprod (qC B.h) (phiL5 B G γ) (fun η' => (primState5 B G).Aw γ m η' i) (1/2 - Aex B.h)
        (Complex.I * (m : ℂ)) (kb B.h γ.1 : ℂ) η (0, 1, 0, 0) hq hqd hφd (hAd i)
      rw [hCf]
      exact h
    have e1 : qC B.h η ^ (1/2 - Aex B.h) = qC B.h η ^ (1/2:ℝ) * qC B.h η ^ (-Aex B.h) := by
      rw [← Real.rpow_add hq]
      congr 1
    have e2 : qC B.h η ^ (1/2 - Aex B.h - 1) =
        qC B.h η ^ (1/2:ℝ) * qC B.h η ^ (-Aex B.h) / qC B.h η := by
      rw [Real.rpow_sub_one hq.ne', e1]
    have e3 : (qC B.h η / Qb γ.1) ^ (1/2:ℝ) = qC B.h η ^ (1/2:ℝ) / Real.sqrt (Qb γ.1) := by
      rw [Real.div_rpow hq.le hQ.le, Real.sqrt_eq_rpow]
    have hq' : ((qC B.h η : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hq.ne'
    have hr' : ((η.1 : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hr.ne'
    have hAex : (1/2 : ℝ) - Aex B.h = -B.h := by unfold Aex; ring
    refine hvec _ _ ?_ ?_ ?_
    all_goals
      simp only [mcurlC, ampA5, wmoAmp5, velW5, velC5, nPhi5, DrC, DzC, RC, rotC, pang5, Pi.smul_apply,
        smul_eq_mul, Complex.real_smul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        Matrix.head_cons, Matrix.tail_cons, hC, hR, hZ, hlog, e1, e2, e3]
      generalize qC B.h η ^ (1/2:ℝ) = u
      generalize qC B.h η ^ (-Aex B.h) = w
      generalize Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) = Ev
      try simp only [hAex]
      push_cast
      field_simp
      ring
  have hV : mcurlC B.h (m * pint5 B G γ) Cf =ᶠ[nhds ξ] fun η =>
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) • ampA5 B G γ m η := by
    filter_upwards [hUo.mem_nhds hξ] with η hη
    exact hcurl η hη

  have hP : (fun η => (((qC B.h η ^ (-2 * Aex B.h)) : ℝ) : ℂ) *
      (Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) *
        (primState5 B G).pw γ m η)) =
      fun η => Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) *
        presP5 B G γ m η := by
    funext η
    simp only [presP5]
    ring

  have hL : linC5 B G γ m ξ = ((((qC B.h ξ ^ (2 * Aex B.h + 1/2)) : ℝ) : ℂ) *
      (Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))⁻¹) •
      mresC B (m * pint5 B G γ) (mcurlC B.h (m * pint5 B G γ) Cf)
        (fun η => (((qC B.h η ^ (-2 * Aex B.h)) : ℝ) : ℂ) *
          (Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) *
            (primState5 B G).pw γ m η)) ξ := by
    rw [hCf]
    rfl
  rw [hL, hP, hgerm _ _ _ _ hV]

theorem mres_phase_expand5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (m : ℤ) (U : Set Cyl) (a : WC) (P : WS), B.ok → IsOpen U → U ⊆ DomC B.h B.qB → ContDiffOn ℝ ∞ (phiL5 B G γ) U → ContDiffOn ℝ ∞ (a γ m) U → ContDiffOn ℝ ∞ (P γ m) U → (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => ubase B η i) U) → (∀ (l : ℕ) (η : Cyl) (i : Fin 3), baseC B l η i = Qb l ^ (1/2 + B.h) * ubase B η i) → ∀ ξ ∈ U, ((((qC B.h ξ ^ (2 * Aex B.h + 1/2)) : ℝ) : ℂ) * (Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))⁻¹) • mresC B (m * pint5 B G γ) (fun η => Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) • a γ m η) (fun η => Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) * P γ m η) ξ = (remSlow5 B a + remPhase5 B G a + remPres5 B P + remVisc5 B G a + remBase5 B a + primOp5 B G a) γ m ξ + ((((qC B.h ξ ^ (2 * Aex B.h + 1/2)) : ℝ) : ℂ) * (Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) * (((Qb γ.1 ^ (-(1/2 : ℝ))) : ℝ) : ℂ) * P γ m ξ) • nPhiC5 B G γ ξ :=
by
  intro B G γ m U a P hok hU hUsub hφ ha hP hub hrel ξ hξ
  have hpos : ∀ η ∈ U, 0 < η.1 := fun η hη => (hUsub hη).1
  have hr : 0 < ξ.1 := hpos ξ hξ
  have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have hkpos : 0 < kb B.h γ.1 := by
    unfold kb epsb
    exact Nat.ceil_pos.mpr (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos hQ _) _)

  have hdir : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V),
      ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ (dR B.h f) U ∧ ContDiffOn ℝ ∞ (dZ f) U := by
    intro V _ _ f hf
    have hDf : ContDiffOn ℝ ∞ (fderiv ℝ f) U :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hf).2
    have hpow : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1 ^ (drx B.h - 1)) U :=
      contDiff_fst.contDiffOn.rpow_const_of_ne (fun ξ hξ => (hpos ξ hξ).ne')
    have hY : ContDiffOn ℝ ∞ (fun ξ : Cyl => (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) U :=
      (contDiffOn_const.mul hpow).smul_const _
    have hvR : ContDiffOn ℝ ∞ (fun ξ : Cyl =>
        ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) U :=
      contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk hY))
    exact ⟨(hDf.clm_apply hvR).congr (fun ξ _ => rfl),
      (hDf.clm_apply contDiffOn_const).congr (fun ξ _ => rfl)⟩
  have hdiff : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V),
      ContDiffOn ℝ ∞ f U → ∀ η ∈ U, DifferentiableAt ℝ f η := by
    intro V _ _ f hf η hη
    exact (hf.contDiffAt (hU.mem_nhds hη)).differentiableAt (by norm_num)
  have hai : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => a γ m η i) U := fun i => contDiffOn_pi.1 ha i
  have hφd : ∀ η ∈ U, DifferentiableAt ℝ (phiL5 B G γ) η := hdiff _ hφ
  have haid : ∀ i : Fin 3, ∀ η ∈ U, DifferentiableAt ℝ (fun η => a γ m η i) η :=
    fun i => hdiff _ (hai i)
  have hPd : ∀ η ∈ U, DifferentiableAt ℝ (P γ m) η := hdiff _ hP
  have hadξ : DifferentiableAt ℝ (a γ m) ξ := hdiff _ ha ξ hξ
  have hRφ : DifferentiableAt ℝ (dR B.h (phiL5 B G γ)) ξ := hdiff _ (hdir _ hφ).1 ξ hξ
  have hZφ : DifferentiableAt ℝ (dZ (phiL5 B G γ)) ξ := hdiff _ (hdir _ hφ).2 ξ hξ
  have hRa : ∀ i : Fin 3, DifferentiableAt ℝ (dR B.h (fun η => a γ m η i)) ξ :=
    fun i => hdiff _ (hdir _ (hai i)).1 ξ hξ
  have hZa : ∀ i : Fin 3, DifferentiableAt ℝ (dZ (fun η => a γ m η i)) ξ :=
    fun i => hdiff _ (hdir _ (hai i)).2 ξ hξ
  have hV1 : DifferentiableAt ℝ (fun η => ubase B η 1) ξ := hdiff _ (hub 1) ξ hξ
  have hV2 : DifferentiableAt ℝ (fun η => ubase B η 2) ξ := hdiff _ (hub 2) ξ hξ

  have L1 : ∀ (φ : Cyl → ℝ) (g : Cyl → ℂ) (η v : Cyl), DifferentiableAt ℝ φ η →
      DifferentiableAt ℝ g η →
      fderiv ℝ (fun y => Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (φ y : ℂ))) * g y) η v =
        Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (φ η : ℂ))) *
          (fderiv ℝ g η v + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) * ((fderiv ℝ φ η v : ℝ) : ℂ) * g η) := by
    intro φ g η v hφη hgη
    have h1 : HasFDerivAt (fun y => ((φ y : ℝ) : ℂ)) (Complex.ofRealCLM.comp (fderiv ℝ φ η)) η :=
      Complex.ofRealCLM.hasFDerivAt.comp η hφη.hasFDerivAt
    have h2 := ((h1.const_mul (kb B.h γ.1 : ℂ)).const_mul (Complex.I * (m : ℂ))).cexp
    have h3 := h2.fun_mul hgη.hasFDerivAt
    rw [h3.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.comp_apply, Complex.ofRealCLM_apply, smul_eq_mul]
    ring

  have L2 : ∀ (w : Cyl → Cyl) (φ : Cyl → ℝ) (g : Cyl → ℂ),
      (∀ η ∈ U, DifferentiableAt ℝ φ η) → (∀ η ∈ U, DifferentiableAt ℝ g η) →
      DifferentiableAt ℝ (fun η => fderiv ℝ φ η (w η)) ξ →
      DifferentiableAt ℝ (fun η => fderiv ℝ g η (w η)) ξ →
      fderiv ℝ (fun η => fderiv ℝ (fun y => Complex.exp (Complex.I * (m : ℂ) *
          ((kb B.h γ.1 : ℂ) * (φ y : ℂ))) * g y) η (w η)) ξ (w ξ) =
        Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (φ ξ : ℂ))) *
          (fderiv ℝ (fun η => fderiv ℝ g η (w η)) ξ (w ξ)
            + 2 * (Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) * ((fderiv ℝ φ ξ (w ξ) : ℝ) : ℂ) *
                fderiv ℝ g ξ (w ξ)
            + (Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) *
                ((fderiv ℝ (fun η => fderiv ℝ φ η (w η)) ξ (w ξ) : ℝ) : ℂ) * g ξ
            + (Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) ^ 2 * ((fderiv ℝ φ ξ (w ξ) : ℝ) : ℂ) ^ 2 * g ξ) := by
    intro w φ g hφU hgU hDφ hDg
    have hev : (fun η => fderiv ℝ (fun y => Complex.exp (Complex.I * (m : ℂ) *
          ((kb B.h γ.1 : ℂ) * (φ y : ℂ))) * g y) η (w η)) =ᶠ[nhds ξ]
        (fun η => Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (φ η : ℂ))) *
          (fderiv ℝ g η (w η) + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) *
            ((fderiv ℝ φ η (w η) : ℝ) : ℂ) * g η)) :=
      Filter.eventuallyEq_of_mem (hU.mem_nhds hξ) (fun η hη => L1 φ g η (w η) (hφU η hη) (hgU η hη))
    rw [hev.fderiv_eq]
    have h1 : HasFDerivAt (fun η => ((fderiv ℝ φ η (w η) : ℝ) : ℂ))
        (Complex.ofRealCLM.comp (fderiv ℝ (fun η => fderiv ℝ φ η (w η)) ξ)) ξ :=
      Complex.ofRealCLM.hasFDerivAt.comp ξ hDφ.hasFDerivAt
    have hH := hDg.hasFDerivAt.fun_add
      ((h1.const_mul (Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ))).fun_mul (hgU ξ hξ).hasFDerivAt)
    rw [L1 φ _ ξ (w ξ) (hφU ξ hξ) hH.differentiableAt, hH.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.comp_apply, Complex.ofRealCLM_apply, smul_eq_mul]
    ring

  have hT : ∀ i : Fin 3, dT (fun η => Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) *
      (phiL5 B G γ η : ℂ))) * a γ m η i) ξ =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
        (dTsV (fun η => a γ m η i) ξ + (((Qb γ.1 ^ (-(1 + B.h))) : ℝ) : ℂ) * dVc B γ.1 (a γ m) ξ i
          + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) * ((dT (phiL5 B G γ) ξ : ℝ) : ℂ) * a γ m ξ i) := by
    intro i
    have h := L1 (phiL5 B G γ) (fun η => a γ m η i) ξ ((0:ℝ), (0:ℝ), (1:ℝ), vtv) (hφd ξ hξ) (haid i ξ hξ)
    have hT0 : (0:ℝ) < Tgc := by unfold Tgc; positivity
    have hzp := zpow_pos hT0 (bandIdx B.h γ.1)
    have hqp := Real.rpow_pos_of_pos hQ (1 + B.h)
    have hcT : Qb γ.1 ^ (-(1 + B.h)) * (cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) = 1 := by
      unfold cib
      rw [Real.rpow_neg hQ.le, zpow_neg]
      field_simp
    have hv : (((0:ℝ), (0:ℝ), (1:ℝ), vtv) : Cyl) = ((0:ℝ), (0:ℝ), (1:ℝ), ((0:ℝ), (0:ℝ))) +
        Qb γ.1 ^ (-(1 + B.h)) • dVdir B.h γ.1 := by
      unfold dVdir
      simp only [Prod.smul_mk, smul_zero, Prod.mk_add_mk, add_zero, zero_add, smul_smul, hcT, one_smul,
        Prod.mk_zero_zero]
    have hcomp : fderiv ℝ (fun η => a γ m η i) ξ = (ContinuousLinearMap.proj i).comp (fderiv ℝ (a γ m) ξ) :=
      (hasFDerivAt_pi'.1 hadξ.hasFDerivAt i).fderiv
    have hc2 : fderiv ℝ (fun η => a γ m η i) ξ (dVdir B.h γ.1) = dVc B γ.1 (a γ m) ξ i := by
      rw [hcomp]; rfl
    have hsplit : fderiv ℝ (fun η => a γ m η i) ξ ((0:ℝ), (0:ℝ), (1:ℝ), vtv) =
        dTsV (fun η => a γ m η i) ξ + (((Qb γ.1 ^ (-(1 + B.h))) : ℝ) : ℂ) * dVc B γ.1 (a γ m) ξ i := by
      rw [hv, map_add, map_smul, Complex.real_smul, hc2]
      rfl
    unfold dT
    rw [h, hsplit]
  have hR : ∀ i : Fin 3, dR B.h (fun η => Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) *
      (phiL5 B G γ η : ℂ))) * a γ m η i) ξ =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
        (dR B.h (fun η => a γ m η i) ξ
          + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) * ((dR B.h (phiL5 B G γ) ξ : ℝ) : ℂ) * a γ m ξ i) :=
    fun i => L1 (phiL5 B G γ) (fun η => a γ m η i) ξ _ (hφd ξ hξ) (haid i ξ hξ)
  have hZ : ∀ i : Fin 3, dZ (fun η => Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) *
      (phiL5 B G γ η : ℂ))) * a γ m η i) ξ =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
        (dZ (fun η => a γ m η i) ξ
          + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) * ((dZ (phiL5 B G γ) ξ : ℝ) : ℂ) * a γ m ξ i) :=
    fun i => L1 (phiL5 B G γ) (fun η => a γ m η i) ξ _ (hφd ξ hξ) (haid i ξ hξ)
  have hPR : dR B.h (fun η => Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) *
      (phiL5 B G γ η : ℂ))) * P γ m η) ξ =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
        (dR B.h (P γ m) ξ
          + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) * ((dR B.h (phiL5 B G γ) ξ : ℝ) : ℂ) * P γ m ξ) :=
    L1 (phiL5 B G γ) (P γ m) ξ _ (hφd ξ hξ) (hPd ξ hξ)
  have hPZ : dZ (fun η => Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) *
      (phiL5 B G γ η : ℂ))) * P γ m η) ξ =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
        (dZ (P γ m) ξ
          + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) * ((dZ (phiL5 B G γ) ξ : ℝ) : ℂ) * P γ m ξ) :=
    L1 (phiL5 B G γ) (P γ m) ξ _ (hφd ξ hξ) (hPd ξ hξ)
  have hRR : ∀ i : Fin 3, dR B.h (dR B.h (fun η => Complex.exp (Complex.I * (m : ℂ) *
      ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) * a γ m η i)) ξ =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
        (dR B.h (dR B.h (fun η => a γ m η i)) ξ
          + 2 * (Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) * ((dR B.h (phiL5 B G γ) ξ : ℝ) : ℂ) *
              dR B.h (fun η => a γ m η i) ξ
          + (Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) * ((dR B.h (dR B.h (phiL5 B G γ)) ξ : ℝ) : ℂ) *
              a γ m ξ i
          + (Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) ^ 2 * ((dR B.h (phiL5 B G γ) ξ : ℝ) : ℂ) ^ 2 *
              a γ m ξ i) :=
    fun i => L2 (fun η => ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv))
      (phiL5 B G γ) (fun η => a γ m η i) hφd (haid i) hRφ (hRa i)
  have hZZ : ∀ i : Fin 3, dZ (dZ (fun η => Complex.exp (Complex.I * (m : ℂ) *
      ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) * a γ m η i)) ξ =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
        (dZ (dZ (fun η => a γ m η i)) ξ
          + 2 * (Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) * ((dZ (phiL5 B G γ) ξ : ℝ) : ℂ) *
              dZ (fun η => a γ m η i) ξ
          + (Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) * ((dZ (dZ (phiL5 B G γ)) ξ : ℝ) : ℂ) *
              a γ m ξ i
          + (Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) ^ 2 * ((dZ (phiL5 B G γ) ξ : ℝ) : ℂ) ^ 2 *
              a γ m ξ i) :=
    fun i => L2 (fun _ => ((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ)))
      (phiL5 B G γ) (fun η => a γ m η i) hφd (haid i) hZφ (hZa i)
  have hμ2 : (Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) ^ 2 = -((m : ℂ) * (kb B.h γ.1 : ℂ)) ^ 2 := by
    rw [mul_pow, mul_pow, Complex.I_sq]; ring

  obtain ⟨σ, hσ⟩ : ∃ s : ℝ, s = Real.sqrt (Qb γ.1) := ⟨_, rfl⟩
  have hσpos : 0 < σ := by rw [hσ]; exact Real.sqrt_pos.mpr hQ
  have hσsq : σ ^ 2 = Qb γ.1 := by rw [hσ]; exact Real.sq_sqrt hQ.le
  obtain ⟨c1, hc1⟩ : ∃ c : ℝ, c = Qb γ.1 ^ (1/2 + B.h) := ⟨_, rfl⟩
  have hc1pos : 0 < c1 := by rw [hc1]; exact Real.rpow_pos_of_pos hQ _
  have hQ1 : Qb γ.1 ^ (-(1/2 : ℝ)) = σ⁻¹ := by
    rw [Real.rpow_neg hQ.le, hσ, Real.sqrt_eq_rpow]
  have hQ2 : Qb γ.1 ^ (-(Aex B.h + 1/2)) = (c1 * σ)⁻¹ := by
    rw [Real.rpow_neg hQ.le, hc1, hσ, Real.sqrt_eq_rpow, ← Real.rpow_add hQ]
    congr 2
  have hn0 : nPhi5 B G γ ξ 0 = σ * dR B.h (phiL5 B G γ) ξ := by rw [hσ]; rfl
  have hn1 : nPhi5 B G γ ξ 1 = (pint5 B G γ : ℝ) / (kb B.h γ.1 : ℝ) / (ξ.1 / σ) := by rw [hσ]; rfl
  have hn2 : nPhi5 B G γ ξ 2 = σ * dZ (phiL5 B G γ) ξ := by rw [hσ]; rfl
  have hkR : (kb B.h γ.1 : ℝ) ≠ 0 := by exact_mod_cast hkpos.ne'
  have hQ3 : (kb B.h γ.1 : ℝ) ^ 2 * dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) / Qb γ.1 =
      (kb B.h γ.1 : ℝ) ^ 2 * (dR B.h (phiL5 B G γ) ξ ^ 2 + dZ (phiL5 B G γ) ξ ^ 2) +
        (pint5 B G γ : ℝ) ^ 2 / ξ.1 ^ 2 := by
    simp only [dotProduct, Fin.sum_univ_three, hn0, hn1, hn2]
    rw [← hσsq]
    field_simp
    ring
  have hFang : Fang B γ.1 = fun η => c1 * σ * (ubase B η 1 * (η.1)⁻¹) := by
    funext η
    unfold Fang RC
    rw [hrel, hc1, hσ, div_div_eq_mul_div]
    ring
  have hF0 : Fang B γ.1 ξ = c1 * σ * (ubase B ξ 1 * (ξ.1)⁻¹) := by rw [hFang]
  have hF1 : DrC B γ.1 (Fang B γ.1) ξ = σ * (c1 * σ * (ubase B ξ 1 * (-(ξ.1 ^ 2)⁻¹) +
      (ξ.1)⁻¹ * dR B.h (fun η => ubase B η 1) ξ)) := by
    have hinv : HasFDerivAt (fun η : Cyl => (η.1)⁻¹)
        ((-(ξ.1 ^ 2)⁻¹) • ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) ξ :=
      (hasDerivAt_inv hr.ne').comp_hasFDerivAt ξ hasFDerivAt_fst
    have hprod := (hV1.hasFDerivAt.fun_mul hinv).const_mul (c1 * σ)
    unfold DrC dR
    rw [hFang, hprod.fderiv, ← hσ]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_fst', smul_eq_mul]
    ring
  have hF2 : DrC B γ.1 (fun η => baseC B γ.1 η 2) ξ = σ * (c1 * dR B.h (fun η => ubase B η 2) ξ) := by
    have hb : (fun η => baseC B γ.1 η 2) = fun η => c1 * ubase B η 2 := by
      funext η; rw [hrel, hc1]
    unfold DrC dR
    rw [hb, fderiv_const_mul hV2 c1, ← hσ]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hRC : RC γ.1 ξ = ξ.1 / σ := by unfold RC; rw [hσ]
  have hMV : ∀ v : Fin 3 → ℂ, (pulseMatC (Kmat B G γ ξ)).mulVec v =
      ![((-2 * Fang B γ.1 ξ : ℝ) : ℂ) * v 1,
        ((2 * Fang B γ.1 ξ + RC γ.1 ξ * DrC B γ.1 (Fang B γ.1) ξ : ℝ) : ℂ) * v 0,
        ((DrC B γ.1 (fun η => baseC B γ.1 η 2) ξ : ℝ) : ℂ) * v 0] := by
    intro v
    ext i
    fin_cases i <;> simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three, pulseMatC, Kmat]

  have hr' : (ξ.1 : ℂ) ≠ 0 := by exact_mod_cast hr.ne'
  have hk' : (kb B.h γ.1 : ℂ) ≠ 0 := by exact_mod_cast hkpos.ne'
  have hσ' : (σ : ℂ) ≠ 0 := by exact_mod_cast hσpos.ne'
  have hc1' : (c1 : ℂ) ≠ 0 := by exact_mod_cast hc1pos.ne'
  have hE0 : Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) ≠ 0 :=
    Complex.exp_ne_zero _

  simp only [mresC, mlapC, Pi.smul_apply, smul_eq_mul]
  rw [hT 0, hT 1, hT 2, hR 0, hR 1, hR 2, hZ 0, hZ 1, hZ 2, hRR 0, hRR 1, hRR 2, hZZ 0, hZZ 1, hZZ 2,
    hPR, hPZ, hμ2]
  generalize Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) = e at hE0 ⊢
  ext i
  fin_cases i <;>
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, remSlow5, remPhase5, remPres5, remVisc5, remBase5,
    primOp5, nPhiC5, eikP5, hMV, hQ1, hQ2, hQ3, hn0, hn1, hn2, hF1, hF0, hF2, hRC,
    Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] <;>
  push_cast <;>
  field_simp <;>
  ring

theorem prin_reduce5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (m : ℤ) (qs : ℝ) (ξ : Cyl), B.ok → ξ ∈ DomC B.h qs → DifferentiableAt ℝ (ampD5 B G γ m) ξ → DifferentiableAt ℝ (W0h4 B G γ m) ξ → primOp5 B G (ampA5 B G) γ m ξ + ((((qC B.h ξ ^ (2 * Aex B.h + 1/2)) : ℝ) : ℂ) * (Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) * (((Qb γ.1 ^ (-(1/2 : ℝ))) : ℝ) : ℂ) * presP5 B G γ m ξ) • nPhiC5 B G γ ξ = princC5 B G γ m ξ + primOp5 B G (fun γ' m' η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • ampD5 B G γ' m' η) γ m ξ :=
by
  intro B G γ m qs ξ hok hξ hD hW
  have hS := hok.1
  have hT : IsOpen {ξ : Cyl | ξ.2.2.1 < 1} :=
    isOpen_lt continuous_snd.snd.fst continuous_const
  have hπq : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
    contDiff_snd.fst.prodMk (contDiff_const.sub contDiff_snd.snd.fst)
  have hqC : ContDiffOn ℝ ∞ (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have h4 := hS.2.2.2.1
    have hc := h4.comp hπq.contDiffOn (fun ξ (hξ : ξ.2.2.1 < 1) =>
      (⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩ : (ξ.2.1, 1 - ξ.2.2.1) ∈ univ ×ˢ Ioi (0:ℝ)))
    exact hc
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
  have hq0 : 0 < qC B.h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have hQ0 : 0 < Qb γ.1 := by unfold Qb; positivity
  have hρ : rhoQ B γ ξ = qC B.h ξ / Qb γ.1 := rfl
  have hqd : DifferentiableAt ℝ (qC B.h) ξ :=
    (hqC.contDiffAt (hT.mem_nhds hξ'.2.1)).differentiableAt (by norm_num)

  have hr1 : DifferentiableAt ℝ (fun η => qC B.h η ^ (-Aex B.h)) ξ :=
    hqd.rpow_const (Or.inl hq0.ne')
  have hrho : DifferentiableAt ℝ (fun η => rhoQ B γ η) ξ := by
    have e : (fun η => rhoQ B γ η) = fun η => qC B.h η * (Qb γ.1)⁻¹ := by
      funext η; simp only [rhoQ, div_eq_mul_inv]
    rw [e]; exact hqd.mul_const _
  have hr2 : DifferentiableAt ℝ (fun η => rhoQ B γ η ^ (1/2:ℝ)) ξ := by
    have hne : rhoQ B γ ξ ≠ 0 := by rw [hρ]; exact (div_pos hq0 hQ0).ne'
    exact hrho.rpow_const (Or.inl hne)
  have hc1 : DifferentiableAt ℝ (fun η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ)) ξ := by
    have := Complex.ofRealCLM.differentiableAt.comp ξ hr1
    simpa [Function.comp_def] using this
  have hc2' : DifferentiableAt ℝ (fun η => (((rhoQ B γ η ^ (1/2:ℝ)) : ℝ) : ℂ)) ξ := by
    have := Complex.ofRealCLM.differentiableAt.comp ξ hr2
    simpa [Function.comp_def] using this
  have hc2 : DifferentiableAt ℝ (fun η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) *
      (((rhoQ B γ η ^ (1/2:ℝ)) : ℝ) : ℂ)) ξ := hc1.mul hc2'

  have hinvq : ∀ t : ℝ, qC B.h (ξ + t • dVdir B.h γ.1) = qC B.h ξ := by
    intro t; simp [qC, dVdir]
  have hline : ∀ g : Cyl → ℂ, DifferentiableAt ℝ g ξ →
      (∀ t : ℝ, g (ξ + t • dVdir B.h γ.1) = g ξ) → fderiv ℝ g ξ (dVdir B.h γ.1) = 0 := by
    intro g hg hinv
    have hl : HasDerivAt (fun t : ℝ => ξ + t • dVdir B.h γ.1) (dVdir B.h γ.1) 0 := by
      simpa using ((hasDerivAt_id (0:ℝ)).smul_const (dVdir B.h γ.1)).const_add ξ
    have e0 : ξ + (0:ℝ) • dVdir B.h γ.1 = ξ := by simp
    have hg' : HasFDerivAt g (fderiv ℝ g ξ) (ξ + (0:ℝ) • dVdir B.h γ.1) := by
      rw [e0]; exact hg.hasFDerivAt
    have h1 := hg'.comp_hasDerivAt (0:ℝ) hl
    have h2 : (g ∘ fun t : ℝ => ξ + t • dVdir B.h γ.1) = fun _ => g ξ := by
      funext t; exact hinv t
    rw [h2] at h1
    exact h1.unique (hasDerivAt_const 0 (g ξ))
  have hz1 : fderiv ℝ (fun η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ)) ξ (dVdir B.h γ.1) = 0 :=
    hline _ hc1 (fun t => by simp only [hinvq t])
  have hz2 : fderiv ℝ (fun η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) *
      (((rhoQ B γ η ^ (1/2:ℝ)) : ℝ) : ℂ)) ξ (dVdir B.h γ.1) = 0 :=
    hline _ hc2 (fun t => by simp only [rhoQ, hinvq t])

  have hfun : ampA5 B G γ m = fun η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • ampD5 B G γ m η +
      ((((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) * (((rhoQ B γ η ^ (1/2:ℝ)) : ℝ) : ℂ)) • W0h4 B G γ m η := by
    funext η
    simp only [ampA5, ampD5]
    rw [smul_sub, mul_smul, sub_add_cancel]
  have hA : ampA5 B G γ m ξ = (((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) • ampD5 B G γ m ξ +
      ((((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) * (((rhoQ B γ ξ ^ (1/2:ℝ)) : ℝ) : ℂ)) • W0h4 B G γ m ξ :=
    congrFun hfun ξ

  have hdA : dVc B γ.1 (ampA5 B G γ m) ξ =
      (((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) • dVc B γ.1 (ampD5 B G γ m) ξ +
      ((((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) * (((rhoQ B γ ξ ^ (1/2:ℝ)) : ℝ) : ℂ)) •
        dVc B γ.1 (W0h4 B G γ m) ξ := by
    rw [hfun]
    unfold dVc
    have hs1 : DifferentiableAt ℝ (fun η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • ampD5 B G γ m η) ξ :=
      hc1.smul hD
    have hs2 : DifferentiableAt ℝ (fun η => ((((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) *
        (((rhoQ B γ η ^ (1/2:ℝ)) : ℝ) : ℂ)) • W0h4 B G γ m η) ξ := hc2.smul hW
    rw [fderiv_fun_add hs1 hs2, fderiv_fun_smul hc1 hD, fderiv_fun_smul hc2 hW]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smulRight_apply, hz1, hz2, zero_smul, add_zero]
  have hdD : dVc B γ.1 (fun η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • ampD5 B G γ m η) ξ =
      (((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) • dVc B γ.1 (ampD5 B G γ m) ξ := by
    unfold dVc
    rw [fderiv_fun_smul hc1 hD]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smulRight_apply, hz1, zero_smul, add_zero]

  have key : ∀ (h q Q : ℝ), 0 < q → 0 < Q →
      q ^ (2 * Aex h + 1/2) * Q ^ (-(1 + h)) * (q ^ (-Aex h) * (q / Q) ^ (1/2 : ℝ)) =
        (q / Q) ^ (Aex h + 1) ∧
      q ^ (2 * Aex h + 1/2) * Q ^ (-(Aex h + 1/2)) * (q ^ (-Aex h) * (q / Q) ^ (1/2 : ℝ)) =
        (q / Q) ^ (Aex h + 1) ∧
      q ^ (2 * Aex h + 1/2) * Q⁻¹ * (q ^ (-Aex h) * (q / Q) ^ (1/2 : ℝ)) =
        (q / Q) ^ (Aex h + 1) * Q ^ h ∧
      q ^ (2 * Aex h + 1/2) * Q ^ (-(1/2 : ℝ)) * q ^ (-2 * Aex h) = (q / Q) ^ (1/2 : ℝ) := by
    intro h q Q hq hQ
    have hqQ : 0 < q / Q := div_pos hq hQ
    have hinv : Q⁻¹ = Real.exp (-Real.log Q) := by rw [Real.exp_neg, Real.exp_log hQ]
    simp only [Real.rpow_def_of_pos hq, Real.rpow_def_of_pos hQ, Real.rpow_def_of_pos hqQ, hinv,
      Real.log_div hq.ne' hQ.ne', ← Real.exp_add, Aex]
    refine ⟨?_, ?_, ?_, ?_⟩ <;> congr 1 <;> ring
  obtain ⟨R1, R2, R3, R4⟩ := key B.h (qC B.h ξ) (Qb γ.1) hq0 hQ0
  rw [← hρ] at R1 R2 R3 R4
  have C1 := congrArg (fun x : ℝ => (x : ℂ)) R1
  have C2 := congrArg (fun x : ℝ => (x : ℂ)) R2
  have C3 := congrArg (fun x : ℝ => (x : ℂ)) R3
  have C4 := congrArg (fun x : ℝ => (x : ℂ)) R4
  simp only [Complex.ofReal_mul, Complex.ofReal_inv] at C1 C2 C3 C4

  simp only [primOp5, princC5, presP5, dDamp5, epsb, hA, hdA, hdD]
  ext i
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Matrix.mulVec_add, Matrix.mulVec_smul,
    Complex.ofReal_mul, Complex.ofReal_div, Complex.ofReal_pow, Complex.ofReal_natCast]
  linear_combination (dVc B γ.1 (W0h4 B G γ m) ξ i) * C1
    + ((pulseMatC (Kmat B G γ ξ)).mulVec (W0h4 B G γ m ξ) i) * C2
    + (W0h4 B G γ m ξ i * (m : ℂ) ^ 2 * (kb B.h γ.1 : ℂ) ^ 2 *
        ((dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) : ℝ) : ℂ)) * C3
    + (nPhiC5 B G γ ξ i * (primState5 B G).pw γ m ξ * Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) * C4

theorem plin5_rem_split : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → InWg5 B G (qsOf l0) 1 (primState5 B G).Aw → InWg5 B G (qsOf l0) 1 (primState5 B G).pw → InWg5 B G (qsOf l0) (1/2) (W0h4 B G) → ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), (linC5 B G - princC5 B G) γ m ξ = (remSlow5 B (ampA5 B G) + remPhase5 B G (ampA5 B G) + remPres5 B (presP5 B G) + remVisc5 B G (ampA5 B G) + remBase5 B (ampA5 B G) + primOp5 B G (fun γ' m' η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • ampD5 B G γ' m' η)) γ m ξ :=
by
  intro B G hok hG

  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  obtain ⟨lP, hPS⟩ := pulse_support_good_v5 B G hok hG
  refine ⟨lP + n0, fun l0 hl0 hAw hpw hW0 γ m ξ hξ => ?_⟩

  by_cases hsupp : ξ ∈ tsupport ((primState5 B G).Aw γ m) ∨ ξ ∈ tsupport ((primState5 B G).pw γ m) ∨
      ξ ∈ tsupport (W0h4 B G γ m)
  swap
  · simp only [not_or] at hsupp
    obtain ⟨h1, h2, h3⟩ := hsupp
    exact rem_split_offsupp5 B G γ m ξ (notMem_tsupport_iff_eventuallyEq.1 h1)
      (notMem_tsupport_iff_eventuallyEq.1 h2) (notMem_tsupport_iff_eventuallyEq.1 h3)

  have hS : SimScaleProps B.h := hok.1
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 < B.qB := by
    rw [hQb]
    exact lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0
  have hDsub : DomC B.h (qsOf l0) ⊆ DomC B.h B.qB := fun η hη => ⟨hη.1, hη.2.1, lt_trans hη.2.2 hqsB⟩
  have hDo : IsOpen (DomC B.h (qsOf l0)) := by
    have h4c := hS.2.2.2.1.continuousOn
    have hm : MapsTo (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1} (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have hξ' : ξ.2.2.1 < 1 := hξ
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hcont : ContinuousOn (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1} :=
      h4c.comp (f := fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) (Continuous.continuousOn (by fun_prop)) hm
    have e : DomC B.h (qsOf l0) = {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩
        (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) ⁻¹' Iio (qsOf l0)) := by
      ext ξ
      exact Iff.rfl
    rw [e]
    exact (isOpen_lt continuous_const continuous_fst).inter
      (hcont.isOpen_inter_preimage (isOpen_lt (by fun_prop) continuous_const) isOpen_Iio)
  have hgood : |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 ∧ |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 := by
    rcases hsupp with h | h | h
    · obtain ⟨-, -, -, -, -, -, -, h8, h9⟩ := hPS l0 (by omega) 1 _ hAw γ m ξ hξ h
      exact ⟨h8, h9⟩
    · obtain ⟨-, -, -, -, -, -, -, h8, h9⟩ := hPS l0 (by omega) 1 _ hpw γ m ξ hξ h
      exact ⟨h8, h9⟩
    · obtain ⟨-, -, -, -, -, -, -, h8, h9⟩ := hPS l0 (by omega) (1/2) _ hW0 γ m ξ hξ h
      exact ⟨h8, h9⟩

  obtain ⟨_hΩ, hslowS⟩ := geom_slow_base_smooth_v5 B hok
  have hp : ContDiff ℝ ∞ (fun η : Cyl => ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ)) := by fun_prop
  have hbase : ∀ (l : ℕ) (j : Fin 3), ContDiffOn ℝ ∞ (fun η : Cyl => baseC B l η j) (DomC B.h B.qB) := by
    intro l j
    exact ((hslowS l j).comp hp.contDiffOn (fun η hη => hη)).congr (fun η _ => rfl)
  have hrel : ∀ (l : ℕ) (η : Cyl) (i : Fin 3), baseC B l η i = Qb l ^ (1/2 + B.h) * ubase B η i :=
    fun l η i => rfl
  have hub : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => ubase B η i) (DomC B.h B.qB) := by
    intro i
    have hQ0 : Qb 0 ^ (1/2 + B.h) = 1 := by simp [Qb]
    refine (hbase 0 i).congr (fun η _ => ?_)
    rw [hrel 0 η i, hQ0, one_mul]

  have hbgc : 0 ≤ bgc ∧ bgc < 1/2 := by
    have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
    have hs2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    unfold bgc
    constructor <;> nlinarith
  have hDen : (1 + bgc ^ 2) ≠ 0 := by positivity
  obtain ⟨w, hw⟩ : ∃ w : ℝ × ℝ, w = rectW B.h γ (G.ctr γ) ξ.2.2.2 := ⟨_, rfl⟩
  have hxiw : |lamR w| < 1/8 := by rw [hw]; exact hgood.1
  have hetw : |lamT w| < 1/8 := by rw [hw]; exact hgood.2
  have hinv1 : w.1 = lamR w + bgc * lamT w := by
    have e : lamR w + bgc * lamT w = (w.1 - bgc * w.2 + bgc * (bgc * w.1 + w.2)) / (1 + bgc ^ 2) := by
      unfold lamR lamT; ring
    rw [e, eq_div_iff hDen]
    ring
  have hinv2 : w.2 = lamT w - bgc * lamR w := by
    have e : lamT w - bgc * lamR w = (bgc * w.1 + w.2 - bgc * (w.1 - bgc * w.2)) / (1 + bgc ^ 2) := by
      unfold lamR lamT; ring
    rw [e, eq_div_iff hDen]
    ring
  have hb1 : bgc * |lamT w| ≤ 1/16 := by
    calc bgc * |lamT w| ≤ (1/2) * (1/8) := mul_le_mul hbgc.2.le hetw.le (abs_nonneg _) (by norm_num)
      _ = 1/16 := by norm_num
  have hb2 : bgc * |lamR w| ≤ 1/16 := by
    calc bgc * |lamR w| ≤ (1/2) * (1/8) := mul_le_mul hbgc.2.le hxiw.le (abs_nonneg _) (by norm_num)
      _ = 1/16 := by norm_num
  have hb1' : |bgc * lamT w| ≤ 1/16 := by rw [abs_mul, abs_of_nonneg hbgc.1]; exact hb1
  have hb2' : |bgc * lamR w| ≤ 1/16 := by rw [abs_mul, abs_of_nonneg hbgc.1]; exact hb2
  have hw1 : |w.1| < 1/2 := by
    rw [hinv1]
    obtain ⟨a1, a2⟩ := abs_lt.mp hxiw
    obtain ⟨c1, c2⟩ := abs_le.mp hb1'
    exact abs_lt.mpr ⟨by linarith, by linarith⟩
  have hw2 : |w.2| < 1/2 := by
    rw [hinv2]
    obtain ⟨a1, a2⟩ := abs_lt.mp hetw
    obtain ⟨c1, c2⟩ := abs_le.mp hb2'
    exact abs_lt.mpr ⟨by linarith, by linarith⟩
  obtain ⟨K1, hK1⟩ : ∃ K : ℤ, K = round ((Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).1) := ⟨_, rfl⟩
  obtain ⟨K2, hK2⟩ : ∃ K : ℤ, K = round ((Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).2) := ⟨_, rfl⟩
  have hw1e : w.1 = (Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).1 - (K1 : ℝ) := by
    rw [hw, hK1]; rfl
  have hw2e : w.2 = (Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).2 - (K2 : ℝ) := by
    rw [hw, hK2]; rfl
  have hround : ∀ (x : ℝ) (K : ℤ), |x - (K : ℝ)| < 1/2 → round x = K := by
    intro x K hx
    rw [round_eq, Int.floor_eq_iff]
    obtain ⟨a, b⟩ := abs_lt.mp hx
    constructor <;> linarith
  have hJc : Continuous (fun Y' : ℝ × ℝ => Jpow (bandIdx B.h γ.1) Y' - G.ctr γ) := by
    unfold Jpow; fun_prop
  obtain ⟨V, hV⟩ : ∃ V : Set (ℝ × ℝ), V =
      {Y' : ℝ × ℝ | |(Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).1 - (K1 : ℝ)| < 1/2} ∩
      {Y' : ℝ × ℝ | |(Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).2 - (K2 : ℝ)| < 1/2} := ⟨_, rfl⟩
  have hVo : IsOpen V := by
    rw [hV]
    exact (isOpen_lt ((hJc.fst).sub continuous_const).abs continuous_const).inter
      (isOpen_lt ((hJc.snd).sub continuous_const).abs continuous_const)
  have hYV : ξ.2.2.2 ∈ V := by
    rw [hV]
    refine ⟨?_, ?_⟩
    · show |(Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).1 - (K1 : ℝ)| < 1/2
      rw [← hw1e]; exact hw1
    · show |(Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).2 - (K2 : ℝ)| < 1/2
      rw [← hw2e]; exact hw2
  have hfr : ∀ Y' ∈ V, rectW B.h γ (G.ctr γ) Y' =
      Jpow (bandIdx B.h γ.1) Y' - G.ctr γ - ((K1 : ℝ), (K2 : ℝ)) := by
    intro Y' hY'
    rw [hV] at hY'
    have r1 : round ((Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).1) = K1 := hround _ _ hY'.1
    have r2 : round ((Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).2) = K2 := hround _ _ hY'.2
    unfold rectW frac0
    rw [r1, r2]
    ext <;> simp

  obtain ⟨U, hU⟩ : ∃ U : Set Cyl, U = DomC B.h (qsOf l0) ∩ (fun η : Cyl => η.2.2.2) ⁻¹' V := ⟨_, rfl⟩
  have hUo : IsOpen U := by
    rw [hU]
    exact hDo.inter (hVo.preimage (by fun_prop))
  have hξU : ξ ∈ U := by rw [hU]; exact ⟨hξ, hYV⟩
  have hUD : U ⊆ DomC B.h (qsOf l0) := by rw [hU]; exact Set.inter_subset_left
