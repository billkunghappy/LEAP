      (fun ξ _ => by (try dsimp only); ring)
  obtain ⟨t4, ht4⟩ : ∃ f : Cyl → ℝ, f = dZ F2 := ⟨_, rfl⟩
  have hT4 : InM B (qsOf l0) (4/5) (nrm B (2 * Aex B.h + 1/2) t4) := by
