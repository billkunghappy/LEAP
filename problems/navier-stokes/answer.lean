    rw [hid]
    exact P
  have hs1eq : ∀ (γ : Lab) (η : Cyl), (qC B.h η / Qb γ.1) ^ (1/2:ℝ) =
      (Real.sqrt (Qb γ.1))⁻¹ * Real.sqrt (qC B.h η) := by
    intro γ η
    rw [← Real.sqrt_eq_rpow, Real.sqrt_div' _ (hQ γ.1).le, div_eq_inv_mul]
  have hdZinv : ∀ (ξ : Cyl) (c : ℝ × ℝ), dZ (fun η' => Real.log (qC B.h η')) (shY ξ c) =
