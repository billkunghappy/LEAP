  have nbdir : ∀ (h : ℝ) (U : Set Cyl) (ξ : Cyl) (F : Cyl → ℝ) (w : Cyl), IsOpen U → ξ ∈ U →
      ContDiffOn ℝ ∞ F U → ∀ k : ℕ,
      NB h (fun η => fderiv ℝ F η (Lnorm h ξ w)) k ξ ≤ ‖w‖ * NB h F (k + 1) ξ := by
    intro h U ξ F w hU hξ hF k
    have hFd : ContDiffAt ℝ ∞ (fderiv ℝ F) ξ :=
      (hF.fderiv_of_isOpen hU (by exact_mod_cast le_top)).contDiffAt (hU.mem_nhds hξ)
    have hcomp : (fun η => fderiv ℝ F η (Lnorm h ξ w)) =
        (ContinuousLinearMap.apply ℝ ℝ (Lnorm h ξ w)) ∘ (fderiv ℝ F) := by
      funext η; rfl
    have hit : iteratedFDeriv ℝ k (fun η => fderiv ℝ F η (Lnorm h ξ w)) ξ =
        (ContinuousLinearMap.apply ℝ ℝ (Lnorm h ξ w)).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fderiv ℝ F) ξ) := by
      rw [hcomp]
      exact ContinuousLinearMap.iteratedFDeriv_comp_left _ hFd (by exact_mod_cast le_top)
    have hNB0 : 0 ≤ NB h F (k + 1) ξ := norm_nonneg _
    unfold NB
    rw [hit]
    apply ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg (norm_nonneg _) hNB0)
    intro m
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      ContinuousLinearMap.apply_apply]
    have key : (iteratedFDeriv ℝ k (fderiv ℝ F) ξ (fun i => Lnorm h ξ (m i))) (Lnorm h ξ w) =
        ((iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ))
          (Fin.snoc (α := fun _ => Cyl) m w) := by
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_succ_apply_right]
      have e1 : Fin.init (fun i : Fin (k+1) => Lnorm h ξ (Fin.snoc (α := fun _ => Cyl) m w i)) =
          fun i => Lnorm h ξ (m i) := by
        funext i
        simp [Fin.init, Fin.snoc_castSucc]
      rw [e1]
      simp only [Fin.snoc_last]
    rw [key]
    have hprod : ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ =
        (∏ i : Fin k, ‖m i‖) * ‖w‖ := by
      rw [Fin.prod_univ_castSucc]
      simp [Fin.snoc_castSucc, Fin.snoc_last]
    calc _ ≤ ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ *
          ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ :=
          ContinuousMultilinearMap.le_opNorm _ _
      _ = ‖w‖ * ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ *
          ∏ i : Fin k, ‖m i‖ := by rw [hprod]; ring

  have hJ : ∀ (n : ℤ) (t : ℝ), JpowL n (t • vtv) = (Tgc ^ n * t) • vtv := by
    intro n t
    have hD : (1 + bgc ^ 2) ≠ 0 := by positivity
    simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
      ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Jpow, vrv, vtv]
    refine Prod.ext ?_ ?_
    · simp only [Prod.smul_fst, Prod.smul_snd, Prod.fst_add, smul_eq_mul]
      field_simp
      ring
    · simp only [Prod.smul_fst, Prod.smul_snd, Prod.snd_add, smul_eq_mul]
      field_simp
      ring

  have hcoarse : ∀ h q : ℝ, 0 ≤ h → 0 < q → q ≤ 1 →
      Tgc ^ (coarseIdx h q) ≤ q ^ (-(1 + h)) := by
    intro h q hh0 q0 hq1
    have hs2a : (1:ℝ) ≤ Real.sqrt 2 := by
      have := Real.sqrt_le_sqrt (show (1:ℝ) ≤ 2 by norm_num)
      rwa [Real.sqrt_one] at this
    have hT1 : 1 < Tgc := by unfold Tgc; linarith
    have hT0 : 0 < Tgc := by linarith
    have hTl : 0 < Real.log Tgc := Real.log_pos hT1
    have hl2 : 0 < Real.log 2 := Real.log_pos one_lt_two
    obtain ⟨x, hxdef⟩ : ∃ x : ℝ, x = Real.logb 2 (1 / q) := ⟨_, rfl⟩
    have hx0 : 0 ≤ x := by
      rw [hxdef]; exact Real.logb_nonneg one_lt_two (one_le_one_div q0 hq1)
    have hx : x * Real.log 2 = -Real.log q := by
      rw [hxdef, Real.logb, div_mul_cancel₀ _ hl2.ne', one_div, Real.log_inv]
    have hb : bandOf q = ⌈x⌉₊ := by rw [hxdef]; rfl
    have hR : 0 ≤ (1 + h) * x * Real.log 2 / Real.log Tgc :=
      div_nonneg (mul_nonneg (mul_nonneg (by linarith) hx0) hl2.le) hTl.le
    have hstar : ((coarseIdx h q : ℤ) : ℝ) ≤ (1 + h) * x * Real.log 2 / Real.log Tgc := by
      obtain ⟨l, hl⟩ : ∃ l : ℕ, l = bandOf q - 4 := ⟨_, rfl⟩
      have hc : coarseIdx h q = bandIdx h l := by rw [hl]; rfl
      rw [hc]
      unfold bandIdx
      rcases Nat.eq_zero_or_pos l with h0 | hpos
      · have e : Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l:ℝ) ^ 2)) = 0 := by
          rw [h0]; simp
        rw [e, Int.floor_zero, Int.cast_zero]
        exact hR
      · have hl1 : (1:ℝ) ≤ (l:ℝ) ^ 2 := one_le_pow₀ (by exact_mod_cast hpos)
        have hA : 0 < (2:ℝ) ^ ((1 + h) * (l:ℝ)) := Real.rpow_pos_of_pos two_pos _
        have hAl : 0 < (2:ℝ) ^ ((1 + h) * (l:ℝ)) / (l:ℝ) ^ 2 := div_pos hA (by linarith)
        have h1 := Int.floor_le (Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / (l:ℝ) ^ 2))
        have h2 := Real.logb_le_logb_of_le hT1 hAl (div_le_self hA.le hl1)
        have h3 : Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ))) =
            (1 + h) * l * Real.log 2 / Real.log Tgc := by
          rw [Real.logb_rpow_eq_mul_logb_of_pos two_pos, ← Real.log_div_log]
          ring
        have hlx : (l:ℝ) ≤ x := by
          have e1 : l + 4 = bandOf q := by omega
          have e2 : ((⌈x⌉₊ : ℕ) : ℝ) < x + 1 := Nat.ceil_lt_add_one hx0
          have e3 : ((l:ℝ) + 4) = ((⌈x⌉₊ : ℕ) : ℝ) := by rw [← hb]; exact_mod_cast e1
          linarith
        have h4 : (1 + h) * l * Real.log 2 / Real.log Tgc ≤
            (1 + h) * x * Real.log 2 / Real.log Tgc := by
          rw [div_eq_mul_inv, div_eq_mul_inv]
          apply mul_le_mul_of_nonneg_right _ (inv_nonneg.mpr hTl.le)
          apply mul_le_mul_of_nonneg_right _ hl2.le
          exact mul_le_mul_of_nonneg_left hlx (by linarith)
        linarith
    have hlq : Real.log q = -(x * Real.log 2) := by rw [hx]; ring
    have hcanc : Real.log Tgc * ((1 + h) * x * Real.log 2 / Real.log Tgc) =
        (1 + h) * x * Real.log 2 := by
      rw [mul_comm (Real.log Tgc)]
      exact div_mul_cancel₀ _ hTl.ne'
    rw [← Real.rpow_intCast, Real.rpow_def_of_pos hT0, Real.rpow_def_of_pos q0, Real.exp_le_exp, hlq]
    calc Real.log Tgc * ((coarseIdx h q : ℤ) : ℝ)
        ≤ Real.log Tgc * ((1 + h) * x * Real.log 2 / Real.log Tgc) :=
          mul_le_mul_of_nonneg_left hstar hTl.le
      _ = (1 + h) * x * Real.log 2 := hcanc
      _ = -(x * Real.log 2) * -(1 + h) := by ring
  have hs2a : (1:ℝ) ≤ Real.sqrt 2 := by
    have := Real.sqrt_le_sqrt (show (1:ℝ) ≤ 2 by norm_num)
    rwa [Real.sqrt_one] at this
  have hs2b : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
  have hvtv : ‖vtv‖ ≤ 1 := by
    refine norm_prod_le_iff.mpr ⟨?_, ?_⟩
    · show ‖bgc‖ ≤ 1
      rw [Real.norm_eq_abs, abs_le]
      unfold bgc
      constructor <;> linarith
    · show ‖(1:ℝ)‖ ≤ 1
      simp
  have hTg0 : 0 < Tgc := by unfold Tgc; positivity

  have hdYle : ∀ (G : Cyl → ℝ), ContDiffOn ℝ ∞ G (DomC B.h qs) → ∀ ξ ∈ DomC B.h qs, ∀ n : ℕ,
      NB B.h (dYt G) n ξ ≤ qC B.h ξ ^ (-(1 + B.h)) * NB B.h G (n + 1) ξ := by
    intro G hG ξ hξ n
    have hq := hqpos ξ hξ
    have hq1 : qC B.h ξ ≤ 1 := le_trans hξ.2.2.le hqs1
    obtain ⟨T, hTdef⟩ : ∃ T : ℝ, T = Tgc ^ coarseIdx B.h (qC B.h ξ) := ⟨_, rfl⟩
    have hT0 : 0 < T := by rw [hTdef]; exact zpow_pos hTg0 _
    obtain ⟨w, hwdef⟩ : ∃ w : Cyl, w = ((0:ℝ), (0:ℝ), (0:ℝ), T • vtv) := ⟨_, rfl⟩
    have e3 : ∀ v : Cyl, (Lnorm B.h ξ v).2.2.2 = JpowL (-coarseIdx B.h (qC B.h ξ)) v.2.2.2 := by
      intro v; rfl
    have hframe : Lnorm B.h ξ w = (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl) := by
      refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
      · rw [hwdef]; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      · rw [hwdef]; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      · rw [hwdef]; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      · rw [e3, hwdef]
        show JpowL (-coarseIdx B.h (qC B.h ξ)) (T • vtv) = vtv
        rw [hJ, hTdef, zpow_neg, inv_mul_cancel₀ (zpow_pos hTg0 _).ne', one_smul]
    have hdY : dYt G = fun η => fderiv ℝ G η (Lnorm B.h ξ w) := by
      funext η
      unfold dYt
      rw [hframe]
    have hM0 : 0 ≤ qC B.h ξ ^ (-(1 + B.h)) := Real.rpow_nonneg hq.le _
    have hTM : T ≤ qC B.h ξ ^ (-(1 + B.h)) := by
      rw [hTdef]; exact hcoarse B.h _ hh.le hq hq1
    have hTv : ‖T • vtv‖ ≤ qC B.h ξ ^ (-(1 + B.h)) := by
      rw [norm_smul, Real.norm_of_nonneg hT0.le]
      calc T * ‖vtv‖ ≤ T * 1 := mul_le_mul_of_nonneg_left hvtv hT0.le
        _ = T := mul_one T
        _ ≤ _ := hTM
    have hw : ‖w‖ ≤ qC B.h ξ ^ (-(1 + B.h)) := by
      rw [hwdef]
      refine norm_prod_le_iff.mpr ⟨?_, norm_prod_le_iff.mpr ⟨?_, norm_prod_le_iff.mpr ⟨?_, ?_⟩⟩⟩
      · show ‖(0:ℝ)‖ ≤ _
        rw [norm_zero]; exact hM0
      · show ‖(0:ℝ)‖ ≤ _
        rw [norm_zero]; exact hM0
      · show ‖(0:ℝ)‖ ≤ _
        rw [norm_zero]; exact hM0
      · show ‖T • vtv‖ ≤ _
        exact hTv
    rw [hdY]
    refine (nbdir B.h (DomC B.h qs) ξ G w hDopen hξ hG n).trans ?_
    exact mul_le_mul_of_nonneg_right hw (norm_nonneg _)

  have hdYs : ∀ G : Cyl → ℝ, ContDiffOn ℝ ∞ G (DomC B.h qs) → ContDiffOn ℝ ∞ (dYt G) (DomC B.h qs) :=
    fun G hG => (hG.fderiv_of_isOpen hDopen (by exact_mod_cast le_top)).clm_apply
      (contDiffOn_const (c := (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl)))

  have hqline : ∀ (ξ : Cyl) (s : ℝ), qC B.h (ξ + s • (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl)) = qC B.h ξ := by
    intro ξ s
    simp [qC]
  have hDline : ∀ ξ ∈ DomC B.h qs, ∀ s : ℝ,
      ξ + s • (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl) ∈ DomC B.h qs := by
    intro ξ hξ s
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    show 0 < (ξ + s • (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl)).1 ∧
      (ξ + s • (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl)).2.2.1 < 1 ∧
      qC B.h (ξ + s • (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl)) < qs
    refine ⟨?_, ?_, ?_⟩
    · simpa using hξ'.1
    · simpa using hξ'.2.1
    · rw [hqline]; exact hξ'.2.2
  have hshD : ∀ ξ ∈ DomC B.h qs, ∀ a : ℝ × ℝ, shY ξ a ∈ DomC B.h qs := fun ξ hξ a => hξ
  have hshl : ∀ (ξ : Cyl) (a : ℝ × ℝ) (s : ℝ),
      shY ξ a + s • (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl) =
        shY (ξ + s • (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl)) a := by
    intro ξ a s
    ext <;> simp [shY] <;> ring
  have hγ : ∀ ξ : Cyl, HasDerivAt (fun s : ℝ => ξ + s • (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl))
      (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl) 0 := fun ξ => by
    simpa using ((hasDerivAt_id (0:ℝ)).smul_const (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl)).const_add ξ
  have hlineD : ∀ (G : Cyl → ℝ) (ξ : Cyl), DifferentiableAt ℝ G ξ →
      HasDerivAt (fun s : ℝ => G (ξ + s • (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl))) (dYt G ξ) 0 := by
    intro G ξ hd
    have h0 : ξ + (0:ℝ) • (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl) = ξ := by simp
    have hd' : HasFDerivAt G (fderiv ℝ G ξ) (ξ + (0:ℝ) • (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl)) := by
      rw [h0]; exact hd.hasFDerivAt
    exact hd'.comp_hasDerivAt (x := (0:ℝ)) (hγ ξ)
  have hdiff : ∀ G : Cyl → ℝ, ContDiffOn ℝ ∞ G (DomC B.h qs) → ∀ ξ ∈ DomC B.h qs,
      DifferentiableAt ℝ G ξ := fun G hG ξ hξ =>
    (hG.contDiffAt (hDopen.mem_nhds hξ)).differentiableAt (by simp)

  have hqv0 : ∀ ξ ∈ DomC B.h qs, dYt (qC B.h) ξ = 0 := by
    intro ξ hξ
    have hc := hlineD (qC B.h) ξ (hdiff _ hqCs ξ hξ)
    have hconst : (fun s : ℝ => qC B.h (ξ + s • (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl))) =
        fun _ => qC B.h ξ := funext (fun s => hqline ξ s)
    rw [hconst] at hc
    exact hc.unique (hasDerivAt_const (0:ℝ) (qC B.h ξ))

  have hfac : ∀ (p : ℝ) (G : Cyl → ℝ) (ξ : Cyl), ξ ∈ DomC B.h qs → DifferentiableAt ℝ G ξ →
      dYt (nrm B p G) ξ = qC B.h ξ ^ p * dYt G ξ := by
    intro p G ξ hξ hGd
    have hq := hqpos ξ hξ
    have hqd : DifferentiableAt ℝ (qC B.h) ξ := hdiff _ hqCs ξ hξ
    have hpow : HasFDerivAt (fun η => qC B.h η ^ p)
        ((p * qC B.h ξ ^ (p - 1)) • fderiv ℝ (qC B.h) ξ) ξ :=
      hqd.hasFDerivAt.rpow_const (Or.inl hq.ne')
    have hprod := hpow.mul hGd.hasFDerivAt
    have hfd : fderiv ℝ (nrm B p G) ξ =
        (qC B.h ξ ^ p) • fderiv ℝ G ξ + G ξ • ((p * qC B.h ξ ^ (p - 1)) • fderiv ℝ (qC B.h) ξ) :=
      hprod.fderiv
    have h0 := hqv0 ξ hξ
    unfold dYt at h0 ⊢
    rw [hfd]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [h0]
    ring

  have hreg : ∀ G : Cyl → ℝ, ContDiffOn ℝ ∞ (nrm B (Aex B.h) G) (DomC B.h qs) →
      ContDiffOn ℝ ∞ G (DomC B.h qs) := by
    intro G hG
    have h1 : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-(Aex B.h)) * nrm B (Aex B.h) G η) (DomC B.h qs) :=
      (hqCs.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')).mul hG
    refine h1.congr (fun η hη => ?_)
    have hq := hqpos η hη
    show G η = qC B.h η ^ (-(Aex B.h)) * (qC B.h η ^ (Aex B.h) * G η)
    rw [← mul_assoc, ← Real.rpow_add hq, neg_add_cancel, Real.rpow_zero, one_mul]
  have hgs := hreg g H1.1
  have hds := hreg d H2.1
  have hArgd : ∀ ξ ∈ DomC B.h qs, Ar ξ = g ξ - d ξ := by
    intro ξ hξ
    have := H3 ξ hξ
    linarith
  have hArS : ContDiffOn ℝ ∞ Ar (DomC B.h qs) := (hgs.sub hds).congr hArgd
  have hdeckG : ∀ G : Cyl → ℝ, (∀ ξ ∈ DomC B.h qs, ∀ a, IsDeck B.h (qC B.h ξ) a →
      nrm B (Aex B.h) G (shY ξ a) = nrm B (Aex B.h) G ξ) →
      ∀ ξ ∈ DomC B.h qs, ∀ a, IsDeck B.h (qC B.h ξ) a → G (shY ξ a) = G ξ := by
    intro G hG ξ hξ a ha
    have e : qC B.h ξ ^ Aex B.h * G (shY ξ a) = qC B.h ξ ^ Aex B.h * G ξ := hG ξ hξ a ha
    exact mul_left_cancel₀ (Real.rpow_pos_of_pos (hqpos ξ hξ) _).ne' e
  have hgdeck := hdeckG g H1.2.1
  have hddeck := hdeckG d H2.2.1
  have hArdeck : ∀ ξ ∈ DomC B.h qs, ∀ a, IsDeck B.h (qC B.h ξ) a → Ar (shY ξ a) = Ar ξ := by
    intro ξ hξ a ha
    rw [hArgd _ (hshD ξ hξ a), hArgd ξ hξ, hgdeck ξ hξ a ha, hddeck ξ hξ a ha]
  have hFS : ContDiffOn ℝ ∞ (nrm B (Aex B.h) Ar) (DomC B.h qs) := by
    refine (H1.1.sub H2.1).congr (fun ξ hξ => ?_)
    show qC B.h ξ ^ Aex B.h * Ar ξ = qC B.h ξ ^ Aex B.h * g ξ - qC B.h ξ ^ Aex B.h * d ξ
    rw [hArgd ξ hξ]
    ring

  have hkf : ∀ ξ ∈ DomC B.h qs, nrm B (2 * Aex B.h + 1/2) (fun ξ => -dYt Ar ξ) ξ =
      -(qC B.h ξ ^ (Aex B.h + 1/2) * dYt (nrm B (Aex B.h) Ar) ξ) := by
    intro ξ hξ
    have hq := hqpos ξ hξ
    show qC B.h ξ ^ (2 * Aex B.h + 1/2) * -dYt Ar ξ =
      -(qC B.h ξ ^ (Aex B.h + 1/2) * dYt (nrm B (Aex B.h) Ar) ξ)
    rw [hfac _ Ar ξ hξ (hdiff _ hArS ξ hξ)]
    have r : qC B.h ξ ^ (2 * Aex B.h + 1/2) = qC B.h ξ ^ (Aex B.h + 1/2) * qC B.h ξ ^ Aex B.h := by
      rw [← Real.rpow_add hq]
      congr 1
      ring
    rw [r]
    ring
  have hkS : ContDiffOn ℝ ∞ (fun η => -(qC B.h η ^ (Aex B.h + 1/2) * dYt (nrm B (Aex B.h) Ar) η))
      (DomC B.h qs) :=
    ((hqCs.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')).mul (hdYs _ hFS)).neg
  have hfS : ContDiffOn ℝ ∞ (nrm B (2 * Aex B.h + 1/2) (fun ξ => -dYt Ar ξ)) (DomC B.h qs) :=
    hkS.congr (fun η hη => hkf η hη)

  have hdYdeck : ∀ ξ ∈ DomC B.h qs, ∀ a, IsDeck B.h (qC B.h ξ) a → dYt Ar (shY ξ a) = dYt Ar ξ := by
    intro ξ hξ a ha
    have e1 := hlineD Ar ξ (hdiff _ hArS ξ hξ)
    have e2 := hlineD Ar (shY ξ a) (hdiff _ hArS _ (hshD ξ hξ a))
    have hfun : (fun s : ℝ => Ar (shY ξ a + s • (((0:ℝ), (0:ℝ), (0:ℝ), vtv) : Cyl))) =
