    exact mul_le_mul (mul_le_mul_of_nonneg_left r1 hK20) hpow
      (pow_nonneg (add_nonneg zero_le_one (div_nonneg hA0 hy0p.le)) _)
      (mul_nonneg hK20 (Real.rpow_nonneg hcz.le _))

  have hcomb := nb_cramer_combo_v5 B.h V ξ k γ.2.2 (Qb γ.1 ^ (1 - B.h / 2) / 4) aQ aR aP aS aS
    _ _ _ _ _ hVo hξV hQV hRV hPV hS1V hS2V hQb' hRb hPb hS1b hS2b

  have hev : (fun η : Cyl => Real.sqrt (epsb B.h γ.1) / 2 * sigAmp5 B G l0 S γ η) =ᶠ[nhds ξ] _ :=
