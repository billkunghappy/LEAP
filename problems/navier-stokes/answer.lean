  have hsg : |sgn γ.2.2| = 1 := by unfold sgn; split_ifs <;> simp
  have hv0 : 0 ≤ v := hv.1
  have hvM : v ≤ M := hv.2.trans hL
  have hvD : ∀ D : ℝ, |D| ≤ CD → |v * -D| ≤ M * CD := fun D hD => by
    rw [abs_mul, abs_neg, abs_of_nonneg hv0]; exact mul_le_mul hvM hD (abs_nonneg _) hM0
  have e0 : (a + v • p) 0 = sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 + v * -Dr := by
    rw [haD, hpD]; simp
  have e1 : (a + v • p) 1 = pang5 B G γ / RC γ.1 ξ := by
    rw [haD, hpD]; simp
  have e2 : (a + v • p) 2 = pzr5 B G γ + v * -Dz := by
    rw [haD, hpD]; simp
  have b0 : |(a + v • p) 0| ≤ N := by
    rw [e0]
    have h1 : |sgn γ.2.2 * Bs5 B G γ * G.ustar / 2| ≤ M * G.ustar / 2 := by
      rw [abs_div, abs_mul, abs_mul, hsg, abs_of_pos hu, abs_two]
      have := mul_le_mul_of_nonneg_right hBs hu.le
