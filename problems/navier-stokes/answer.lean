            Fn (4 / Λ * Real.exp z) e)) z := by
        intro z hz
        have hzI := hsub hz
        have hf : HasDerivAt (fun Y => Fn Y e) (deriv (fun Y => Fn Y e) (4 / Λ * Real.exp z))
            (4 / Λ * Real.exp z) :=
          ((hSF.differentiableOn (by norm_num)).differentiableAt
            (isOpen_Ioo.mem_nhds (hV hzI))).hasDerivAt
        have h3 : HasDerivAt (fun z => Fn (4 / Λ * Real.exp z) e)
            (deriv (fun Y => Fn Y e) (4 / Λ * Real.exp z) * (4 / Λ * Real.exp z)) z := by
          have h3' := HasDerivAt.comp z hf (hX' z)
          exact h3'
        have h4 := h3.log (hFpos z hzI).ne'
