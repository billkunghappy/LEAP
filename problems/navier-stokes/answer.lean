  have hc0 : ∀ u : Fin 3 → ℂ, crossC u 0 = 0 := by
    intro u; funext i; fin_cases i <;> simp [crossC]
  have hRS : ∀ (α β : ℝ) (a : WC) (s : Lab → ℤ → Cyl → ℝ), InWg5 B G (qsOf l0) α a →
      (∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (a γ m) → ContDiffAt ℝ ∞ (s γ m) ξ) →
      (∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), a γ m ξ ≠ 0 → ∀ c : ℝ × ℝ,
        IsDeck B.h (qC B.h ξ) c → s γ m (shY ξ c) = s γ m ξ) →
      (∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (a γ m) →
        B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → NB B.h (s γ m) k ξ ≤ C * qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ b) →
      InWg5 B G (qsOf l0) (α + β) (fun γ m ξ i => ((s γ m ξ : ℝ) : ℂ) * a γ m ξ i) := by
