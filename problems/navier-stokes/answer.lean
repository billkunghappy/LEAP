  have hI2' : 0 ≤ Real.exp (3 * (1 - h)) * Kp := mul_nonneg he3a0.le hK0
  set I := Real.exp (1 - h) / (1 - h) + Real.exp (3 * (1 - h)) * Kp with hI
  have hIle : I ≤ 69 := by rw [hI]; linarith
  have hI0 : 0 ≤ I := by rw [hI]; linarith

  have hrle : ρ / (1 - ρ) ≤ 1 / 1000000 := by
    rw [div_le_iff₀ hr0]; linarith
  have hr0' : 0 ≤ ρ / (1 - ρ) := div_nonneg hρ0.le hr0.le

  have hrI : ρ / (1 - ρ) * I ≤ 1 := by
    have := mul_le_mul hrle hIle hI0 (by norm_num : (0:ℝ) ≤ 1 / 1000000)
    linarith
  have hrI0 : 0 ≤ ρ / (1 - ρ) * I := mul_nonneg hr0' hI0
  have hB : 1 / (1 - h) + ρ / (1 - ρ) * I ≤ 3 := by linarith
  have hB0 : 0 ≤ 1 / (1 - h) + ρ / (1 - ρ) * I := by linarith

  have hL : Real.exp ((1 - h) * S1) * (1 / (1 - h) + ρ / (1 - ρ) * I) ≤ 9 := by
    have := mul_le_mul hE1 hB hB0 (by norm_num : (0:ℝ) ≤ 3)
    linarith

  have hlog : 3 ≤ Real.log (1 / h) := by
    have hh' : 10000 ≤ 1 / h := by
      rw [le_div_iff₀ hh0]; linarith
