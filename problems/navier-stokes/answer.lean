  have hR3 : 0 ≤ |Cr| / Real.sqrt B.Xa := by positivity
  have hR4 : 0 ≤ |Cr| := abs_nonneg _
  obtain ⟨K, hKdef⟩ : ∃ K : Set (ℝ × ℝ × ℝ × ℝ × ℝ),
      K = Metric.closedBall 0 R ∩ {z | z.1 = 1 ∧ c ≤ |z.2.2.2.2|} := ⟨_, rfl⟩
