  have hes : ‖((1:ℝ), ((0:ℝ), (0:ℝ)))‖ ≤ 1 := by simp [Prod.norm_def]
  have he1 : ‖((0:ℝ), ((1:ℝ), (0:ℝ)))‖ ≤ 1 := by simp [Prod.norm_def]
  have he2 : ‖((0:ℝ), ((0:ℝ), (1:ℝ)))‖ ≤ 1 := by simp [Prod.norm_def]
  have hsm : ∀ n : ℕ, ContDiff ℝ ∞ ((Tv ((1:ℝ), ((0:ℝ), (0:ℝ))))^[n] G) := fun n =>
