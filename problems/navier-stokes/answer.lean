  obtain ⟨ε', hε', hFsm, hUsm, hFpos, -⟩ := ax_prof_regular h j0 σ δ Λ C K ρ1 t1 κ0 om r Pax Kder
    Fn Un hΛ ht1 hom hr0 hrρ1 hA hSA hSU
  have hglue : ∀ (G G0 : ℝ → ℝ → ℝ),
