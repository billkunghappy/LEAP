  have hF3C : InM B (qsOf l0) (9/10) (nrm B (Aex B.h + Aex B.h) F3) := by
    have a1 := (h4 l0 hl4 (9/10) (Aex B.h) (mcor5 B G l0 S 1) hv).1
    have a2 := hmul _ _ _ _ hv hv
    have p1 := hlin _ _ (9/10) _ 2 1 _ _
      (fun η => 2 * ubase B η 1 * mcor5 B G l0 S 1 η + mcor5 B G l0 S 1 η ^ 2)
