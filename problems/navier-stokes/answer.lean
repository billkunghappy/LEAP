    rw [h3, hss] at h1
    rw [show -(1 * κ * x * N / L) / 2 = -(κ * (x * N)) / L / 2 by ring, h1,
      show -(κ * (-(2 * x) * L * dU)) / L / 2 = κ * (x * dU) * (L / L) by ring,
