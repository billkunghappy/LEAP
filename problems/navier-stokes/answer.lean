    unfold vco; rw [div_mul_cancel₀ _ hcb.ne']; ring

  have hP2 : ∀ t : ℝ, pulsePth5 B G γ ξ t = shY ξ ((t - vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) •
      ((cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) • vtv)) := by
    intro t
