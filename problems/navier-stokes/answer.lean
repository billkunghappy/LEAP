theorem pulse_ar_nb_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C b : ℝ, ∀ (l0 : ℕ), l1 ≤ l0 → ∀ (γ : Lab) (m : ℤ), ActiveL4 B G γ → l0 ≤ γ.1 → ∀ η ∈ DomC B.h (qsOf l0), 1/4 < qC B.h η / Qb γ.1 → qC B.h η / Qb γ.1 < 4 → B.Xa / 2 < XC B.h η → XC B.h η < 2 * B.Xb → |xiG B.h γ (G.ctr γ) η.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) η.2.2.2| < 1/8 → (∃ O : Set Cyl, IsOpen O ∧ η ∈ O ∧ ContDiffOn ℝ ∞ (fun ζ : Cyl => fun i j' : Fin 3 => pulseAr5 B G γ m ζ i j') O) ∧ ∀ j : ℕ, j ≤ k → NB B.h (fun ζ : Cyl => fun i j' : Fin 3 => pulseAr5 B G γ m ζ i j') j η ≤ C * (1 + (m : ℝ) ^ 2) * SC B.h η ^ b :=
by
  intro B G hok hG

  have pile : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (h : ℝ) (F : Cyl → (Fin 3 → V))
