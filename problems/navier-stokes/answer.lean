      have h1 : ∀ a b : ℝ, f (x.1, x.2.1, x.2.2.1, (a + 1, b)) = f (x.1, x.2.1, x.2.2.1, (a, b)) := by
        intro a b
        have h := hper _ (hm (a, b)) 1 0
        simpa [shY] using h
      have h2 : ∀ a b : ℝ, f (x.1, x.2.1, x.2.2.1, (a, b + 1)) = f (x.1, x.2.1, x.2.2.1, (a, b)) := by
        intro a b
        have h := hper _ (hm (a, b)) 0 1
        simpa [shY] using h
      have hs := hshift (fun Y : ℝ × ℝ => f (x.1, x.2.1, x.2.2.1, Y)) hφc h1 h2 x.2.2.2
      have ex : ∀ Y : ℝ × ℝ, x + ((0:ℝ), (0:ℝ), (0:ℝ), Y) = (x.1, x.2.1, x.2.2.1, x.2.2.2 + Y) := by
