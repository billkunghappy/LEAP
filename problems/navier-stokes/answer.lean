  have hR2 : |lamT w| ≤ r0 := by have := hR.2; unfold etG at this; rwa [hw] at this
  have hvs : vco h r0 γ c Y = (lamT w + r0) / cib h γ.1 := by unfold vco etG; rw [hw]
