  obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = Pst * (X1 / XR) ^ (1 / 10 : ℝ) * Real.sqrt (2 * X1) := ⟨_, rfl⟩
  have hR0 : 0 ≤ R := by rw [hRdef]; positivity
  have cw : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ => 2 * z.1 * refFin Pst XR z.1 z.2) (Ioi (0:ℝ) ×ˢ (univ : Set ℝ)) := by
