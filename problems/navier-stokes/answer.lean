  have hjU : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X1 ×ˢ Ioo (-1:ℝ) 1, ‖iteratedFDeriv ℝ k (↿U0) z‖ ≤ C := by
    intro k
