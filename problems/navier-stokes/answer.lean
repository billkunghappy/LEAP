    intro i
    fin_cases i
    · show ContDiffOn ℝ ∞ (fun η : Cyl => Real.sqrt (Qb γ.1) *
        fderiv ℝ (phiL5 B G γ) η ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv)) U
      exact contDiffOn_const.mul (transfer _ φt _ hEq (hφ.mono hUsub) (hdR.mono hUsub))
    · show ContDiffOn ℝ ∞ (fun η : Cyl => pang5 B G γ / RC γ.1 η) U
      exact contDiffOn_const.div hRC.contDiffOn (fun η hη => hRCne η (hUsub hη))
    · show ContDiffOn ℝ ∞ (fun η : Cyl => Real.sqrt (Qb γ.1) *
        fderiv ℝ (phiL5 B G γ) η (((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ)) : Cyl)) U
      exact contDiffOn_const.mul (transfer _ φt (fun _ => (((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ)) : Cyl))
        hEq (hφ.mono hUsub) contDiffOn_const)

  have hP : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhiP5 B G γ η i) U := by
    intro i
    exact transfer (fun η => nPhi5 B G γ η i) (fun η => nPhi5 B G γ η i) (fun _ => dVdir B.h γ.1)
      (fun _ _ => rfl) (hN i) contDiffOn_const

  have hK : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => Kmat B G γ η i j) U := by
    intro i j
    fin_cases i <;> fin_cases j
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) U
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun η : Cyl => -2 * Fang B γ.1 η) U
      exact contDiffOn_const.mul (hFang.mono hUsub)
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) U
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun η : Cyl => 2 * Fang B γ.1 η + RC γ.1 η * (Real.sqrt (Qb γ.1) *
        fderiv ℝ (Fang B γ.1) η ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv))) U
      exact (contDiffOn_const.mul (hFang.mono hUsub)).add (hRC.contDiffOn.mul (contDiffOn_const.mul
        (transfer (Fang B γ.1) (Fang B γ.1) _ (fun _ _ => rfl) (hFang.mono hUsub) (hdR.mono hUsub))))
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) U
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) U
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun η : Cyl => Real.sqrt (Qb γ.1) *
        fderiv ℝ (fun η => baseC B γ.1 η 2) η ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv)) U
      exact contDiffOn_const.mul (transfer _ _ _ (fun _ _ => rfl) ((hbase 2).mono hUsub) (hdR.mono hUsub))
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) U
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) U
      exact contDiffOn_const
  exact ⟨U, hUo, hξU, hUsub, hN, hP, hK⟩

theorem nPhiP5_local_model_v5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl), B.ok → ξ ∈ DomC B.h B.qB → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → ∃ U : Set Cyl, IsOpen U ∧ ξ ∈ U ∧ U ⊆ DomC B.h B.qB ∧ ∀ η ∈ U, nPhiP5 B G γ η = ![-(Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))), 0, -(Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)))] :=
by
  intro B G γ ξ hB hξ hxi het
  obtain ⟨U₁, c, hU₁o, hξU₁, hU₁sub, hU₁⟩ := nPhi5_local_model_v5 B G γ ξ hB hξ hxi het
  obtain ⟨U', hU'o, hξU', -, hN, -, -⟩ := good_coeff_smooth_v5 B G γ ξ hB hξ hxi het

  have hline : ∀ (f : Cyl → ℝ) (U : Set Cyl) (η d : Cyl) (a b : ℝ), IsOpen U → η ∈ U →
      DifferentiableAt ℝ f η → (∀ t : ℝ, η + t • d ∈ U → f (η + t • d) = a + t * b) →
      fderiv ℝ f η d = b := by
    intro f U η d a b hU hη hf hl
    have hW : IsOpen ((fun t : ℝ => η + t • d) ⁻¹' U) :=
      hU.preimage (continuous_const.add (continuous_id.smul continuous_const))
    have h0 : (0:ℝ) ∈ (fun t : ℝ => η + t • d) ⁻¹' U := by
      simp only [Set.mem_preimage, zero_smul, add_zero]; exact hη
    have hev : (fun t : ℝ => f (η + t • d)) =ᶠ[nhds (0:ℝ)] (fun t => a + t * b) :=
      Filter.eventuallyEq_of_mem (hW.mem_nhds h0) (fun t ht => hl t ht)
    have h1 : HasDerivAt (fun t : ℝ => f (η + t • d)) b 0 :=
      ((hasDerivAt_mul_const b).const_add a).congr_of_eventuallyEq hev
    have h2 : HasDerivAt (fun t : ℝ => f (η + t • d)) (fderiv ℝ f η d) 0 :=
      hf.hasFDerivAt.hasLineDerivAt d
    exact h2.unique h1

  have hslope : ∀ (Y : ℝ × ℝ) (t : ℝ), Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1 *
      lamT (Y + t • ((cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) • vtv)) + c =
      (Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1 * lamT Y + c) + t := by
    intro Y t
    have hT : 0 < Tgc := by unfold Tgc; positivity
    have hTn : (0:ℝ) < Tgc ^ bandIdx B.h γ.1 := zpow_pos hT _
    have hQ : 0 < Qb γ.1 := by unfold Qb; positivity
    have hk : 0 < cib B.h γ.1 := by unfold cib; exact mul_pos hTn (Real.rpow_pos_of_pos hQ _)
    have hb : 0 < 1 + bgc ^ 2 := by positivity
    rw [zpow_neg]
    unfold lamT vtv
    simp only [Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    field_simp
    ring
  have hY : ∀ (η : Cyl) (t : ℝ), (η + t • dVdir B.h γ.1).2.2.2 =
      η.2.2.2 + t • ((cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) • vtv) := fun η t => rfl
  have hslow : ∀ (η : Cyl) (t : ℝ), ((η + t • dVdir B.h γ.1).1, (η + t • dVdir B.h γ.1).2.1,
      (η + t • dVdir B.h γ.1).2.2.1) = (η.1, η.2.1, η.2.2.1) := by
    intro η t; simp [dVdir]
  refine ⟨U₁ ∩ U', hU₁o.inter hU'o, ⟨hξU₁, hξU'⟩, fun η hη => hU₁sub hη.1, ?_⟩
  intro η hη
  have hd : ∀ i : Fin 3, DifferentiableAt ℝ (fun η' => nPhi5 B G γ η' i) η := fun i =>
    ((hN i).contDiffAt (hU'o.mem_nhds hη.2)).differentiableAt (by simp)
  have hv := (hU₁ η hη.1).1
  have hvt : ∀ t : ℝ, η + t • dVdir B.h γ.1 ∈ U₁ →
      vco B.h G.r0 γ (G.ctr γ) (η + t • dVdir B.h γ.1).2.2.2 = vco B.h G.r0 γ (G.ctr γ) η.2.2.2 + t := by
    intro t ht
    rw [(hU₁ _ ht).1, hY η t, hv]
    exact hslope η.2.2.2 t
  have e0 : nPhiP5 B G γ η 0 = -(Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))) := by
    show fderiv ℝ (fun η' => nPhi5 B G γ η' 0) η (dVdir B.h γ.1) = _
    refine hline _ U₁ η _ (sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 - vco B.h G.r0 γ (G.ctr γ) η.2.2.2 *
      (Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)))) _
      hU₁o hη.1 (hd 0) ?_
    intro t ht
    have h := congrFun (hU₁ _ ht).2 0
    rw [h]
    simp only [Matrix.cons_val_zero]
    rw [hvt t ht, hslow η t]
    ring
  have e1 : nPhiP5 B G γ η 1 = 0 := by
    show fderiv ℝ (fun η' => nPhi5 B G γ η' 1) η (dVdir B.h γ.1) = 0
    refine hline _ U₁ η _ (pang5 B G γ / RC γ.1 η) 0 hU₁o hη.1 (hd 1) ?_
    intro t _
    show pang5 B G γ / RC γ.1 (η + t • dVdir B.h γ.1) = _
    simp [RC, dVdir]
  have e2 : nPhiP5 B G γ η 2 = -(Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))) := by
    show fderiv ℝ (fun η' => nPhi5 B G γ η' 2) η (dVdir B.h γ.1) = _
    refine hline _ U₁ η _ (pzr5 B G γ - vco B.h G.r0 γ (G.ctr γ) η.2.2.2 *
      (Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)))) _
      hU₁o hη.1 (hd 2) ?_
    intro t ht
    have h := congrFun (hU₁ _ ht).2 2
    rw [h]
    simp only [Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
    rw [hvt t ht, hslow η t]
    ring
  funext i
  fin_cases i
  · exact e0
  · exact e1
  · exact e2

theorem base_r_compare5 : ∀ (B : BG), B.ok → ∃ C : ℝ, 0 ≤ C ∧ ∀ (l : ℕ) (ξ : Cyl), ξ ∈ DomC B.h B.qB → 1/2 < qC B.h ξ / Qb l → qC B.h ξ / Qb l < 2 → B.Xa ≤ XC B.h ξ → XC B.h ξ ≤ B.Xb → DifferentiableAt ℝ (pcFa5 B l) (ξ.1, ξ.2.1, ξ.2.2.1) ∧ DifferentiableAt ℝ (pcB5 B l 2) (ξ.1, ξ.2.1, ξ.2.2.1) ∧ -1 < etaC B.h ξ ∧ etaC B.h ξ < 1 ∧ |pcFa5 B l (ξ.1, ξ.2.1, ξ.2.2.1) - (qC B.h ξ / Qb l) ^ (-(1 + B.h)) * B.F (XC B.h ξ) (etaC B.h ξ)| ≤ C * Qb l ^ B.h ∧ |pcRC5 l (ξ.1, ξ.2.1, ξ.2.2.1) * (Real.sqrt (Qb l) * fderiv ℝ (pcFa5 B l) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))) - (qC B.h ξ / Qb l) ^ (-(1 + B.h)) * B.F (XC B.h ξ) (etaC B.h ξ) * (-(shearA B.F (XC B.h ξ) (etaC B.h ξ)))| ≤ C * Qb l ^ B.h ∧ |Real.sqrt (Qb l) * fderiv ℝ (pcB5 B l 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) - (qC B.h ξ / Qb l) ^ (-(1 + B.h)) * B.F (XC B.h ξ) (etaC B.h ξ) * shearB B.F B.U (XC B.h ξ) (etaC B.h ξ)| ≤ C * Qb l ^ B.h ∧ pcRC5 l (ξ.1, ξ.2.1, ξ.2.2.1) = Real.sqrt (2 * XC B.h ξ * (qC B.h ξ / Qb l)) :=
by
  intro B hB

  have geom : IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} ∧
      ∀ (l : ℕ) (i : Fin 3), ContDiffOn ℝ ∞ (fun s : ℝ × ℝ × ℝ => baseC B l (s.1, s.2.1, s.2.2, ((0:ℝ), (0:ℝ))) i)
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
    obtain ⟨hS, hBP⟩ := hB
    have hsc : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hS.2.2.2.1.continuousOn
    have hA : IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
      have hm : Continuous (fun s : ℝ × ℝ × ℝ => (s.2.1, 1 - s.2.2)) := by fun_prop
      have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun s : ℝ × ℝ × ℝ => (s.2.1, 1 - s.2.2)))
          {s : ℝ × ℝ × ℝ | s.2.2 < 1} := by
        refine hsc.comp hm.continuousOn ?_
        intro s hs
        have hs' : s.2.2 < 1 := hs
        exact ⟨mem_univ _, show (0:ℝ) < 1 - s.2.2 by linarith⟩
      have hU : IsOpen {s : ℝ × ℝ × ℝ | s.2.2 < 1} := isOpen_lt (by fun_prop) continuous_const
      have h1 := hc.isOpen_inter_preimage hU (isOpen_Iio (a := B.qB))
      have h2 : IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1} := isOpen_lt continuous_const continuous_fst
      have e : {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} =
          {s : ℝ × ℝ × ℝ | 0 < s.1} ∩ ({s : ℝ × ℝ × ℝ | s.2.2 < 1} ∩
            ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun s : ℝ × ℝ × ℝ => (s.2.1, 1 - s.2.2))) ⁻¹'
              Iio B.qB) := by
        ext s
        simp only [mem_setOf_eq, mem_inter_iff, mem_preimage, mem_Iio, Function.comp]
      rw [e]
      exact h2.inter h1
    have hD : IsOpen (simDomain B.h B.qB) := by
      have hm : Continuous (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)) := by fun_prop
      have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)))
          {w : ℝ³ × ℝ | w.2 < 1} := by
        refine hsc.comp hm.continuousOn ?_
        intro w hw
        have hw' : w.2 < 1 := hw
        exact ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by linarith⟩
      have hU : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
      have h1 := hc.isOpen_inter_preimage hU (isOpen_Iio (a := B.qB))
      have e : simDomain B.h B.qB = {w : ℝ³ × ℝ | w.2 < 1} ∩
          ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2))) ⁻¹' Iio B.qB := by
        ext w
        simp only [simDomain, mem_setOf_eq, mem_inter_iff, mem_preimage, mem_Iio, Function.comp]
      rw [e]
      exact h1
    have hu : ContDiffOn ℝ ∞ (↿(uB B)) (simDomain B.h B.qB) := by
      have hAB : ContDiffOn ℝ ∞ (↿B.AB) (simDomain B.h B.qB) := hBP.2.2.2.1.1
      have hBv : ContDiffOn ℝ ∞ (↿B.BvB) (simDomain B.h B.qB) := hBP.2.2.2.1.2.1
      have hDA : ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z) (simDomain B.h B.qB) :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hAB).2
      have hc : ∀ (v : ℝ³) (j : Fin 3),
          ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z (v, (0:ℝ)) j) (simDomain B.h B.qB) := by
        intro v j
        have h1 : ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z (v, (0:ℝ))) (simDomain B.h B.qB) :=
          hDA.clm_apply contDiffOn_const
        exact (EuclideanSpace.proj j : ℝ³ →L[ℝ] ℝ).contDiff.comp_contDiffOn h1
      let e0 : ℝ³ := EuclideanSpace.single 0 1
      let e1 : ℝ³ := EuclideanSpace.single 1 1
      let e2 : ℝ³ := EuclideanSpace.single 2 1
      have hg : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ =>
          (fderiv ℝ (↿B.AB) z (e1, (0:ℝ)) 2 - fderiv ℝ (↿B.AB) z (e2, (0:ℝ)) 1) •
              EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
          (fderiv ℝ (↿B.AB) z (e2, (0:ℝ)) 0 - fderiv ℝ (↿B.AB) z (e0, (0:ℝ)) 2) •
              EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
          (fderiv ℝ (↿B.AB) z (e0, (0:ℝ)) 1 - fderiv ℝ (↿B.AB) z (e1, (0:ℝ)) 0) •
              EuclideanSpace.single (2 : Fin 3) (1 : ℝ) + (↿B.BvB) z) (simDomain B.h B.qB) := by
        refine ((((hc e1 2).sub (hc e2 1)).smul contDiffOn_const).add
          (((hc e2 0).sub (hc e0 2)).smul contDiffOn_const)).add
          (((hc e0 1).sub (hc e1 0)).smul contDiffOn_const) |>.add hBv
      refine hg.congr ?_
      rintro ⟨y, s⟩ hz
      have hdiff : DifferentiableAt ℝ (↿B.AB) (y, s) :=
        (hAB.contDiffAt (hD.mem_nhds hz)).differentiableAt (by norm_num)
      have hpart : fderiv ℝ (fun w => B.AB w s) y =
          (fderiv ℝ (↿B.AB) (y, s)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := by
        have h1 : HasFDerivAt (fun w : ℝ³ => (w, s)) (ContinuousLinearMap.inl ℝ ℝ³ ℝ) y :=
          hasFDerivAt_prodMk_left y s
        have h2 : HasFDerivAt ((↿B.AB) ∘ (fun w : ℝ³ => (w, s)))
            ((fderiv ℝ (↿B.AB) (y, s)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ)) y :=
          HasFDerivAt.comp (g := ↿B.AB) y hdiff.hasFDerivAt h1
        exact h2.fderiv
      show curl3 (fun w => B.AB w s) y + B.BvB y s = _
      unfold curl3
      rw [hpart]
      simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.inl_apply]
      rfl
    have frame : ∀ r z : ℝ, 0 < r → (rotPt r 0 z) 2 = z ∧
        eR (rotPt r 0 z) = EuclideanSpace.single (0 : Fin 3) (1 : ℝ) ∧
        eTh (rotPt r 0 z) = EuclideanSpace.single (1 : Fin 3) (1 : ℝ) := by
      intro r z hr
      have h0 : (rotPt r 0 z) 0 = r := by simp [rotPt]
      have h1 : (rotPt r 0 z) 1 = 0 := by simp [rotPt]
      have h2 : (rotPt r 0 z) 2 = z := by simp [rotPt]
      have hrad : rad (rotPt r 0 z) = r := by
        unfold rad
        rw [h0, h1]
        simp [Real.sqrt_sq hr.le]
      refine ⟨h2, ?_, ?_⟩
      · unfold eR radVec
        rw [hrad, h0, h1, zero_smul, add_zero, smul_smul, inv_mul_cancel₀ hr.ne', one_smul]
      · unfold eTh azVec
        rw [hrad, h0, h1, neg_zero, zero_smul, zero_add, smul_smul, inv_mul_cancel₀ hr.ne', one_smul]
    let ψ : ℝ × ℝ × ℝ → ℝ³ × ℝ := fun s => (rotPt s.1 0 s.2.1, s.2.2)
    have hψ : ContDiff ℝ ∞ ψ := by
      have hr : ContDiff ℝ ∞ (fun s : ℝ × ℝ × ℝ => rotPt s.1 0 s.2.1) := by
        unfold rotPt
        fun_prop
      exact hr.prodMk (contDiff_snd.comp contDiff_snd)
    have hmaps : MapsTo ψ {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}
        (simDomain B.h B.qB) := by
      intro s hs
      obtain ⟨h1, h2, h3⟩ := hs
      show s.2.2 < 1 ∧ simScale B.h ((rotPt s.1 0 s.2.1) 2) (1 - s.2.2) < B.qB
      rw [(frame s.1 s.2.1 h1).1]
      exact ⟨h2, h3⟩
    refine ⟨hA, fun l i => ?_⟩
    have hcomp : ContDiffOn ℝ ∞ ((↿(uB B)) ∘ ψ)
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} :=
      hu.comp hψ.contDiffOn hmaps
    have hg : ContDiffOn ℝ ∞ (fun s => Qb l ^ (1/2 + B.h) * inner ℝ (((↿(uB B)) ∘ ψ) s)
        ((![EuclideanSpace.single (0 : Fin 3) (1 : ℝ), EuclideanSpace.single (1 : Fin 3) (1 : ℝ), eZ] :
          Fin 3 → ℝ³) i))
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} :=
      contDiffOn_const.mul (ContDiffOn.inner ℝ hcomp contDiffOn_const)
    refine hg.congr ?_
    intro s hs
