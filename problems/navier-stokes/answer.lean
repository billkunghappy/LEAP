theorem ax_raw_ode : ∀ (h Pst : ℝ) (Pax : ℝ → ℝ) (j0 σ δ ρ : ℝ) (Pc : ℂ → ℂ) (r M Λ0 A : ℝ) (χc ζc ℓc zc Ξ : ℂ → ℂ), AxDatum h Pst Pax → 0 < j0 → j0 ≤ 1 / 20 → AxData h j0 σ δ ρ Pc Pax → AxCoefData h j0 σ ρ Pc Pax r M χc ζc ℓc zc Ξ → AxMajor h j0 r Λ0 A χc ζc ℓc zc → ∃ Λ1 : ℝ, ∀ Λ C : ℝ, Λ1 ≤ Λ → Real.exp (Λ * M) ≤ C →
    let Fn := axFnDef h j0 Λ C χc ζc ℓc zc Ξ
    let Un := axUnDef h j0 Λ C χc ζc ℓc zc Ξ
    ∀ X η : ℝ, 0 < X → X < 9 / (2 * Λ) → -1 - r / 8 < η → η < 1 + r / 8 →
      axSq h Fn Un X η * Fn X η =
        -2 * (1 - 2 * h * η ^ 2) * (X * iteratedDeriv 2 (fun Y => Fn Y η) X + 2 * deriv (fun Y => Fn Y η) X) ∧
      axSn h Pax Fn Un X η =
        -2 * (1 - 2 * h * η ^ 2) * (X * iteratedDeriv 2 (fun Y => Un Y η) X + deriv (fun Y => Un Y η) X) :=
by
  intro h Pst Pax j0 σ δ ρ Pc r M Λ0 A χc ζc ℓc zc Ξ hD hj0 hj0' hAD hCD hMaj
  obtain ⟨Λs, hS⟩ := ax_raw_smooth_pos h Pst Pax j0 σ δ ρ Pc r M Λ0 A χc ζc ℓc zc Ξ hD hj0 hj0' hAD hCD hMaj
  refine ⟨max Λ0 Λs, ?_⟩
  intro Λ C hΛ hC
  dsimp only
  intro X η hX0 hX1 hη1 hη2
  have hΛ0 : Λ0 ≤ Λ := le_trans (le_max_left _ _) hΛ
  have hΛs : Λs ≤ Λ := le_trans (le_max_right _ _) hΛ
  have hΛ1 : 1 ≤ Λ := le_trans hMaj.1 hΛ0
  have hA0 : 0 < A := hMaj.2.1
  have hh0 : 0 < h := hD.1
  have hh1 : h < 1 / 100 := hD.2.1
  obtain ⟨hσ, hδ, hρ, hρ50, hPcd, hPcR, -⟩ := id hAD
  obtain ⟨hr0, hrρ, hr100, hM20, -, -, -, -, -, -, hbdw, hreal⟩ := id hCD
