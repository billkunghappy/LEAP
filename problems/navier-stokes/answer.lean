  have hτ : 0 < 1 - ξ.2.2.1 := by linarith [hξ.2.1]
  have hq : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
  obtain ⟨hw1, hw2⟩ := etaL_band_window_v5 B.h γ ξ hq hη
  obtain ⟨hdF, hF0, hFr, hFz⟩ := hS2 γ.1 ξ hξ hw1 hw2 hXa hXb (pcFa5 B γ.1) (Or.inl rfl)
  obtain ⟨hdB, hB0, hBr, hBz⟩ := hS2 γ.1 ξ hξ hw1 hw2 hXa hXb (pcB5 B γ.1 2) (Or.inr rfl)
  have hfd : fderiv ℝ (pcPhi2_5 B G γ) (ξ.1, ξ.2.1, ξ.2.2.1) =
