        ContinuousLinearMap.inl_apply, ContinuousLinearMap.inl_apply, hR2 a 0, hLι, ← hd]
      rfl
    refine le_trans (cmp _ _ _ (Lnorm B.h ξ) _ hTR' hRi) ?_
    exact hNB

theorem tHjet_init_bound_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (ξ : Cyl), l1 ≤ γ.1 → ActiveL4 B G γ → etaL B.h γ ξ ≠ 0 → ξ ∈ DomC B.h B.qB → B.Xa ≤ XC B.h ξ → XC B.h ξ ≤ B.Xb → inRect B.h γ (G.ctr γ) G.r0 ξ.2.2.2 → ‖(iteratedFDeriv ℝ k (fun s : ℝ × ℝ × ℝ => G.tH γ s 0) (ξ.1, ξ.2.1, ξ.2.2.1)).compContinuousLinearMap (fun _ => (Real.sqrt (qC B.h ξ) • ContinuousLinearMap.id ℝ ℝ).prodMap ((qC B.h ξ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ)))‖ ≤ C * SC B.h ξ ^ b * Penv5 B G γ 0 :=
by
  intro B G hB hG
  obtain ⟨lr, c, Cr, hc, hrep⟩ := rep_consts_v5 B G hB hG
  obtain ⟨cf, Cf, hcf, hfr⟩ := frame5_consts B G hB hG
  have hr0 : 0 < G.r0 := hG.1.1
  have hr0' : G.r0 ≤ 1/100 := hG.1.2.1
  have hXa : 0 < B.Xa := hB.2.1.2.2.1

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ × ℝ × ℝ × ℝ × ℝ → Fin 3 → ℝ, Φ = fun z =>
      ![1, -(z.2.1 / Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2)) *
            (z.2.2.2.1 / z.1 / Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2)) +
          z.2.2.1 * (z.2.2.2.2 / Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2)),
        -(z.2.1 / Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2)) *
            (z.2.2.2.2 / Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2)) +
          z.2.2.1 * (-(z.2.2.2.1 / z.1 / Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2)))] := ⟨_, rfl⟩
  have hΦat : ∀ z : ℝ × ℝ × ℝ × ℝ × ℝ, z.1 ≠ 0 → z.2.2.2.2 ≠ 0 → ContDiffAt ℝ ∞ Φ z := by
    intro z h1 h2
    have hN : (z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2 ≠ 0 := by positivity
    have hS : Real.sqrt ((z.2.2.2.1 / z.1) ^ 2 + z.2.2.2.2 ^ 2) ≠ 0 := by positivity
    rw [hΦ, contDiffAt_pi]
    intro i
    fin_cases i
    · exact contDiffAt_const
    · simp only [Fin.mk_one, Fin.isValue, Matrix.cons_val_one, Matrix.cons_val_zero, Matrix.head_cons]
      fun_prop (disch := assumption)
    · simp only [Fin.reduceFinMk, Fin.isValue, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
      fun_prop (disch := assumption)
  obtain ⟨O, hOdef⟩ : ∃ O : Set (ℝ × ℝ × ℝ × ℝ × ℝ), O = {z | z.1 ≠ 0 ∧ z.2.2.2.2 ≠ 0} := ⟨_, rfl⟩
  have hOo : IsOpen O := by
    rw [hOdef]
    exact (isOpen_ne_fun continuous_fst continuous_const).inter
      (isOpen_ne_fun continuous_snd.snd.snd.snd continuous_const)
  have hΦO : ContDiffOn ℝ ∞ Φ O := by
    intro z hz
    rw [hOdef] at hz
    exact (hΦat z hz.1 hz.2).contDiffWithinAt

  have key : ∀ (aa : ℝ × ℝ × ℝ × ℝ × ℝ) (T : (ℝ × ℝ × ℝ) →L[ℝ] (ℝ × ℝ × ℝ × ℝ × ℝ)) (x : ℝ × ℝ × ℝ) (i : ℕ),
      aa + T x ∈ O → iteratedFDeriv ℝ i (fun z => Φ (aa + T z)) x =
        (iteratedFDeriv ℝ i Φ (aa + T x)).compContinuousLinearMap (fun _ => T) := by
    intro aa T x i ha
    obtain ⟨s, hs_def⟩ : ∃ s : Set (ℝ × ℝ × ℝ × ℝ × ℝ), s = (fun z => aa + z) ⁻¹' O := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hOo.preimage (continuous_const.add continuous_id)
    have hOT : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have hAs : T x ∈ s := by rw [hs_def]; exact ha
    have hxO : x ∈ ⇑T ⁻¹' s := hAs
    have hsm' : ContDiffOn ℝ ∞ (fun z => Φ (aa + z)) s :=
      hΦO.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => Φ (aa + T z)) i hOT hxO
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm' hs.uniqueDiffOn
      hOT.uniqueDiffOn hAs (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => Φ (aa + z)) i hs hAs
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := Φ) i aa (T x)
    calc iteratedFDeriv ℝ i (fun z => Φ (aa + T z)) x
        = iteratedFDerivWithin ℝ i ((fun z => Φ (aa + z)) ∘ ⇑T) (⇑T ⁻¹' s) x := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => Φ (aa + z)) s (T x)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDeriv ℝ i (fun z => Φ (aa + z)) (T x)).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i Φ (aa + T x)).compContinuousLinearMap (fun _ => T) := by rw [e4]

  obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = 1 + |Cr| * |G.ustar| + |Cf| * (1 + |G.ustar|) +
      |Cr| / Real.sqrt B.Xa + |Cr| := ⟨_, rfl⟩
