    have h12 := incr_trans_v5 B G l0 S S1 S2 Bo (Bo - kapS) (Bo - kapS) hok hI1 hI2 (by linarith [hk]) le_rfl
    have h13 := incr_trans_v5 B G l0 S S2 S3 (Bo - kapS) (Bo + 1/2 - 2 * kapS) (Bo - kapS) hok h12 hI3 le_rfl
