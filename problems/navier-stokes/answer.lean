    have hB : ContDiffOn ℝ ∞ (fun e => (1 - h) * I1 e - (1 / 2 - h) * (e * deriv I1 e) -
        (1 - e ^ 2) * deriv I2 e) (Ioo (-1 - r) (1 + r)) := hA.sub hT3
    refine ⟨hB.add hT4, fun k η h1 h2 => ?_⟩
    have hη : η ∈ Ioo (-1 - r) (1 + r) := ⟨by linarith, by linarith⟩
    have cda : ∀ φ : ℝ → ℝ, ContDiffOn ℝ ∞ φ (Ioo (-1 - r) (1 + r)) →
        ContDiffAt ℝ (k : ℕ) φ η :=
      fun φ hφ => (hφ.contDiffAt (hSo.mem_nhds hη)).of_le (by exact_mod_cast le_top)
    rw [iteratedDeriv_fun_add (cda _ hB) (cda _ hT4), iteratedDeriv_fun_sub (cda _ hA) (cda _ hT3),
      iteratedDeriv_fun_sub (cda _ hT1) (cda _ hT2)]
    rw [iteratedDeriv_const_mul_field (1 - h), iteratedDeriv_const_mul_field (1 / 2 - h),
      iteratedDeriv_const_mul_field (2 * (h - (1 / 2 - h)))]
    have e1 : |iteratedDeriv k (fun e => e * deriv I1 e) η| ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * 1 * A1 (k - i + 1) :=
      leib (fun e => e) (deriv I1) _ η (fun _ => 1) (fun j => A1 (j + 1)) k hSo hη contDiffOn_id
        hD1' (fun i => hid i η h1 h2)
        (fun j => by rw [← iteratedDeriv_succ']; exact hb1' (j + 1) η h1 h2)
    have e3 : |iteratedDeriv k (fun e => (1 - e ^ 2) * deriv I2 e) η| ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * 2 * A2 (k - i + 1) :=
      leib (fun e => 1 - e ^ 2) (deriv I2) _ η (fun _ => 2) (fun j => A2 (j + 1)) k hSo hη hp
        hD2' (fun i => hpj i η h1 h2)
        (fun j => by rw [← iteratedDeriv_succ']; exact hb2' (j + 1) η h1 h2)
    have e4 : |iteratedDeriv k (fun e => e * I2 e) η| ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * 1 * A2 (k - i) :=
      leib (fun e => e) I2 _ η (fun _ => 1) A2 k hSo hη contDiffOn_id hI2
        (fun i => hid i η h1 h2) (fun j => hb2' j η h1 h2)
    have k1 : |(1 - h) * iteratedDeriv k I1 η| ≤ |1 - h| * A1 k := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left (hb1' k η h1 h2) (abs_nonneg _)
    have k2 : |(1 / 2 - h) * iteratedDeriv k (fun e => e * deriv I1 e) η| ≤
        |1 / 2 - h| * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * 1 * A1 (k - i + 1) := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left e1 (abs_nonneg _)
    have k4 : |2 * (h - (1 / 2 - h)) * iteratedDeriv k (fun e => e * I2 e) η| ≤
        |2 * (h - (1 / 2 - h))| * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * 1 * A2 (k - i) := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left e4 (abs_nonneg _)
    have tri : ∀ a b c d : ℝ, |a - b - c + d| ≤ |a| + |b| + |c| + |d| := fun a b c d => by
      have := abs_add_le (a - b - c) d
      have := abs_sub (a - b) c
      have := abs_sub a b
      linarith
    have := tri ((1 - h) * iteratedDeriv k I1 η)
      ((1 / 2 - h) * iteratedDeriv k (fun e => e * deriv I1 e) η)
      (iteratedDeriv k (fun e => (1 - e ^ 2) * deriv I2 e) η)
      (2 * (h - (1 / 2 - h)) * iteratedDeriv k (fun e => e * I2 e) η)
    linarith
  obtain ⟨hNs, hNb⟩ := combine (fun e => profRadInt (fun x y => 2 * x * G x y) X e)
    (fun e => profRadInt (fun x y => U x y * (2 * x * G x y)) X e) hI1s hI2s
    (fun j η h1 h2 => by rw [hA1]; exact hI1b j η h1 h2)
    (fun j η h1 h2 => by rw [hA2]; exact hI2b j η h1 h2)
  exact ⟨hNs, fun k η h1 h2 => hNb k η h1 h2⟩

theorem psLead1_eta_jets : ∀ (h X0 : ℝ) (MF : ℕ → ℝ), 0 < h → h < 1 / 100 → 0 < X0 → ∃ M' : ℕ → ℝ, ∀ (C ε r : ℝ) (F U : ℝ → ℝ → ℝ), 1 ≤ C → 0 < ε → 0 < r → r ≤ 1 → ContDiffOn ℝ ∞ (↿F) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) → ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) → (∀ X η : ℝ, 0 ≤ X → -1 - r < η → η < 1 + r → 0 < F X η) → (∀ (k : ℕ) (X η : ℝ), 0 ≤ X → X ≤ 110 → -1 ≤ η → η ≤ 1 → |iteratedDeriv k (fun e => C * F X e) η| ≤ MF k ∧ |iteratedDeriv k (fun e => U X e) η| ≤ MF k ∧ (0 < X → |iteratedDeriv k (fun e => (C * F X e)⁻¹) η| ≤ MF k)) → ∀ (k : ℕ) (X η : ℝ), X0 ≤ X → X ≤ 110 → -1 ≤ η → η ≤ 1 → |iteratedDeriv k (fun e => psLead1 h F U X e) η| ≤ M' k :=
by
  intro h X0 MF hh0 hh1 hX0

  have leib : ∀ (f g : ℝ → ℝ) (s : Set ℝ) (x : ℝ) (k : ℕ), IsOpen s → x ∈ s →
      ContDiffOn ℝ ∞ f s → ContDiffOn ℝ ∞ g s →
      |iteratedDeriv k (fun e => f e * g e) x| ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |iteratedDeriv i f x| * |iteratedDeriv (k - i) g x| := by
    intro f g s x k hs hx hf hg
    have H := norm_iteratedFDerivWithin_mul_le hf hg hs.uniqueDiffOn hx (n := k)
      (by exact_mod_cast le_top)
    have hw : ∀ (j : ℕ) (φ : ℝ → ℝ), iteratedDerivWithin j φ s x = iteratedDeriv j φ x :=
      fun j φ => iteratedDerivWithin_of_isOpen hs hx
    simp only [norm_iteratedFDerivWithin_eq_norm_iteratedDerivWithin, Real.norm_eq_abs, hw] at H
    exact H

  have summono : ∀ (k : ℕ) (a b A B : ℕ → ℝ), (∀ i, |a i| ≤ A i) → (∀ i, |b i| ≤ B i) →
      ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |a i| * |b (k - i)| ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * A i * B (k - i) := by
    intro k a b A B ha hb
    apply Finset.sum_le_sum
    intro i _
    have hA : 0 ≤ A i := le_trans (abs_nonneg _) (ha i)
    exact mul_le_mul (mul_le_mul_of_nonneg_left (ha i) (Nat.cast_nonneg _)) (hb (k - i))
      (abs_nonneg _) (mul_nonneg (Nat.cast_nonneg _) hA)

  have cpt : ∀ (f : ℝ → ℝ) (s : Set ℝ), IsOpen s → Icc (-1) 1 ⊆ s → ContDiffOn ℝ ∞ f s →
      ∃ B : ℕ → ℝ, ∀ (k : ℕ) (e : ℝ), -1 ≤ e → e ≤ 1 → |iteratedDeriv k f e| ≤ B k := by
    intro f s hs hsub hf
    have hex : ∀ k : ℕ, ∃ b : ℝ, ∀ e ∈ Icc (-1 : ℝ) 1, ‖iteratedDerivWithin k f s e‖ ≤ b := fun k =>
      isCompact_Icc.exists_bound_of_continuousOn
        ((hf.continuousOn_iteratedDerivWithin (by exact_mod_cast le_top) hs.uniqueDiffOn).mono hsub)
    choose B hB using hex
    refine ⟨B, fun k e h1 h2 => ?_⟩
    have he : e ∈ s := hsub ⟨h1, h2⟩
    have hb := hB k e ⟨h1, h2⟩
    rwa [iteratedDerivWithin_of_isOpen hs he, Real.norm_eq_abs] at hb

  obtain ⟨q, hqdef⟩ : ∃ q : ℝ → ℝ, q = fun e => (1 - 2 * h * e ^ 2)⁻¹ := ⟨_, rfl⟩
  have hq : ContDiffOn ℝ ∞ q (Ioo (-2) 2) := by
    have hP : ContDiff ℝ ∞ (fun e : ℝ => 1 - 2 * h * e ^ 2) := by fun_prop
    rw [hqdef]
    exact hP.contDiffOn.inv (fun e he => by
      have h1 := he.1
      have h2 := he.2
      have : e ^ 2 < 4 := by nlinarith
      nlinarith)
  obtain ⟨Bq, hBq⟩ := cpt q (Ioo (-2) 2) isOpen_Ioo
    (fun e he => ⟨by linarith [he.1], by linarith [he.2]⟩) hq
  obtain ⟨BN, hBN⟩ := psNum_eta_jets h MF

  obtain ⟨BW, hBW⟩ : ∃ BW : ℕ → ℝ, BW = fun i =>
      1 + ∑ j ∈ Finset.range (i + 1), (i.choose j : ℝ) * (MF (i - j) + 2 * MF (i - j + 1)) :=
    ⟨_, rfl⟩
  obtain ⟨BNG, hBNG⟩ : ∃ BNG : ℕ → ℝ, BNG = fun i =>
      ∑ j ∈ Finset.range (i + 1), (i.choose j : ℝ) * BN j * MF (i - j) := ⟨_, rfl⟩
  obtain ⟨BT, hBT⟩ : ∃ BT : ℕ → ℝ, BT = fun i => 110 * BW i + (2 * X0)⁻¹ * BNG i := ⟨_, rfl⟩
  refine ⟨fun k => ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * Bq i * BT (k - i), ?_⟩
  intro C ε r F U hC hε hr hr1 hF hU hFpos hJ k X η hX0X hX110 hη1 hη2
  have hXpos : 0 < X := lt_of_lt_of_le hX0 hX0X
  have hCpos : 0 < C := by linarith
  have hSo : IsOpen (Ioo (-1 - r) (1 + r)) := isOpen_Ioo
  have hηS : η ∈ Ioo (-1 - r) (1 + r) := ⟨by linarith, by linarith⟩
  have hS2 : Ioo (-1 - r) (1 + r) ⊆ Ioo (-2) 2 :=
    fun e he => ⟨by linarith [he.1], by linarith [he.2]⟩

  obtain ⟨G, hG⟩ : ∃ G : ℝ → ℝ → ℝ, G = fun x e => C * F x e := ⟨_, rfl⟩
  have hGs : ContDiffOn ℝ ∞ (↿G) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) := by
    rw [hG]; exact contDiffOn_const.mul hF
  have hjetG : ∀ (k' : ℕ) (x η' : ℝ), 0 ≤ x → x ≤ X → -1 ≤ η' → η' ≤ 1 →
      |iteratedDeriv k' (fun e => G x e) η'| ≤ MF k' ∧ |iteratedDeriv k' (fun e => U x e) η'| ≤ MF k' := by
    intro k' x η' h1 h2 h3 h4
    have hj := hJ k' x η' h1 (by linarith) h3 h4
    rw [hG]
    exact ⟨hj.1, hj.2.1⟩
  have hjetU : ∀ (k' : ℕ) (x η' : ℝ), 0 ≤ x → x ≤ X → -1 ≤ η' → η' ≤ 1 →
      |iteratedDeriv k' (fun e => U x e) η'| ≤ MF k' :=
    fun k' x η' h1 h2 h3 h4 => (hjetG k' x η' h1 h2 h3 h4).2

  obtain ⟨hWs, hWb⟩ := leadW_jet h ε r X U MF hh0 hh1 hε hr hXpos hU hjetU
  obtain ⟨hNsm, hNbnd⟩ := hBN ε r X G U hε hr hXpos hX110 hGs hU hjetG
  obtain ⟨N, hN⟩ : ∃ N : ℝ → ℝ, N = fun e => (1 - h) * profRadInt (fun x y => 2 * x * G x y) X e - (1 / 2 - h) * e * profEtaD (profRadInt (fun x y => 2 * x * G x y)) X e - (1 - e ^ 2) * profEtaD (profRadInt (fun x y => U x y * (2 * x * G x y))) X e + 2 * (h - (1 / 2 - h)) * e * profRadInt (fun x y => U x y * (2 * x * G x y)) X e :=
    ⟨_, rfl⟩
  have hNs : ContDiffOn ℝ ∞ N (Ioo (-1 - r) (1 + r)) := by rw [hN]; exact hNsm
  have hNb : ∀ j : ℕ, |iteratedDeriv j N η| ≤ BN j := fun j => by
    rw [hN]; exact hNbnd j η hη1 hη2

  have hFX : ContDiffOn ℝ ∞ (fun e => F X e) (Ioo (-1 - r) (1 + r)) :=
    hF.comp (contDiff_const.prodMk contDiff_id).contDiffOn
      (fun e he => Set.mk_mem_prod (show X ∈ Ioi (-ε) by simp only [mem_Ioi]; linarith) he)
  have hgis : ContDiffOn ℝ ∞ (fun e => (C * F X e)⁻¹) (Ioo (-1 - r) (1 + r)) :=
    (contDiffOn_const.mul hFX).inv
      (fun e he => (mul_pos hCpos (hFpos X e hXpos.le he.1 he.2)).ne')
  have hgib : ∀ j : ℕ, |iteratedDeriv j (fun e => (C * F X e)⁻¹) η| ≤ MF j :=
    fun j => (hJ j X η hXpos.le hX110 hη1 hη2).2.2 hXpos

  have hI1 : ∀ e, profRadInt (fun x y => 2 * x * G x y) X e =
      C * profRadInt (fun x y => 2 * x * F x y) X e := by
    intro e
    simp only [profRadInt, hG]
    rw [← intervalIntegral.integral_const_mul]
    congr 1; ext x; ring
  have hI2 : ∀ e, profRadInt (fun x y => U x y * (2 * x * G x y)) X e =
      C * profRadInt (fun x y => U x y * (2 * x * F x y)) X e := by
    intro e
    simp only [profRadInt, hG]
    rw [← intervalIntegral.integral_const_mul]
    congr 1; ext x; ring
  have hD1 : ∀ e, profEtaD (profRadInt (fun x y => 2 * x * G x y)) X e =
      C * profEtaD (profRadInt (fun x y => 2 * x * F x y)) X e := by
    intro e
    have hfe : (fun e' => profRadInt (fun x y => 2 * x * G x y) X e') =
        fun e' => C * profRadInt (fun x y => 2 * x * F x y) X e' := funext hI1
    show deriv (fun e' => profRadInt (fun x y => 2 * x * G x y) X e') e =
      C * deriv (fun e' => profRadInt (fun x y => 2 * x * F x y) X e') e
    exact (congrArg (fun φ => deriv φ e) hfe).trans (deriv_const_mul_field _)
  have hD2 : ∀ e, profEtaD (profRadInt (fun x y => U x y * (2 * x * G x y))) X e =
      C * profEtaD (profRadInt (fun x y => U x y * (2 * x * F x y))) X e := by
    intro e
    have hfe : (fun e' => profRadInt (fun x y => U x y * (2 * x * G x y)) X e') =
        fun e' => C * profRadInt (fun x y => U x y * (2 * x * F x y)) X e' := funext hI2
    show deriv (fun e' => profRadInt (fun x y => U x y * (2 * x * G x y)) X e') e =
      C * deriv (fun e' => profRadInt (fun x y => U x y * (2 * x * F x y)) X e') e
    exact (congrArg (fun φ => deriv φ e) hfe).trans (deriv_const_mul_field _)

  have alg : ∀ (W a b c d f L e : ℝ),
      X * (-W + ((1 - h) * a - (1 / 2 - h) * e * b - (1 - e ^ 2) * c + 2 * (h - (1 / 2 - h)) * e * d) /
          (X * (2 * X * f))) / L =
        L⁻¹ * ((-X) * W + (2 * X)⁻¹ * (((1 - h) * (C * a) - (1 / 2 - h) * e * (C * b) -
          (1 - e ^ 2) * (C * c) + 2 * (h - (1 / 2 - h)) * e * (C * d)) * (C * f)⁻¹)) := by
    intro W a b c d f L e
    have hXne : X ≠ 0 := hXpos.ne'
    have hCne : C ≠ 0 := hCpos.ne'
    rcases eq_or_ne f 0 with hf | hf
    · subst hf
      simp only [mul_zero, div_zero, add_zero, inv_zero]
      ring
    · rcases eq_or_ne L 0 with hL | hL
      · subst hL; simp
      · field_simp
  obtain ⟨T, hT⟩ : ∃ T : ℝ → ℝ, T = fun e => (-X) * leadW h U X e + (2 * X)⁻¹ * (N e * (C * F X e)⁻¹) :=
    ⟨_, rfl⟩
  have hrep : ∀ e, psLead1 h F U X e = q e * T e := by
    intro e
    simp only [hqdef, hT, hN, psLead1, leadQs]
    rw [hI1 e, hI2 e, hD1 e, hD2 e]
    exact alg _ _ _ _ _ _ _ _

  have hWB : ∀ i : ℕ, |iteratedDeriv i (fun e => leadW h U X e) η| ≤ BW i := fun i => by
    rw [hBW]; exact hWb i η hη1 hη2
  have hNG : ∀ i : ℕ, |iteratedDeriv i (fun e => N e * (C * F X e)⁻¹) η| ≤ BNG i := fun i => by
    rw [hBNG]
    exact le_trans (leib N (fun e => (C * F X e)⁻¹) _ η i hSo hηS hNs hgis)
      (summono i _ _ _ _ hNb hgib)
  have hinv : (2 * X)⁻¹ ≤ (2 * X0)⁻¹ := inv_anti₀ (by linarith) (by linarith)
  have hTS : ContDiffOn ℝ ∞ T (Ioo (-1 - r) (1 + r)) := by
    rw [hT]; exact (contDiffOn_const.mul hWs).add (contDiffOn_const.mul (hNs.mul hgis))
  have hTb : ∀ i : ℕ, |iteratedDeriv i T η| ≤ BT i := by
    intro i
    have hA : ContDiffAt ℝ (i : ℕ) (fun e => (-X) * leadW h U X e) η :=
      ((contDiffOn_const.mul hWs).contDiffAt (hSo.mem_nhds hηS)).of_le (by exact_mod_cast le_top)
    have hB : ContDiffAt ℝ (i : ℕ) (fun e => (2 * X)⁻¹ * (N e * (C * F X e)⁻¹)) η :=
      ((contDiffOn_const.mul (hNs.mul hgis)).contDiffAt (hSo.mem_nhds hηS)).of_le
        (by exact_mod_cast le_top)
    have h1 : |iteratedDeriv i (fun e => (-X) * leadW h U X e) η| ≤ 110 * BW i := by
      rw [iteratedDeriv_const_mul_field, abs_mul, abs_neg, abs_of_pos hXpos]
      exact mul_le_mul hX110 (hWB i) (abs_nonneg _) (by norm_num)
    have h2 : |iteratedDeriv i (fun e => (2 * X)⁻¹ * (N e * (C * F X e)⁻¹)) η| ≤
        (2 * X0)⁻¹ * BNG i := by
      rw [iteratedDeriv_const_mul_field, abs_mul, abs_of_pos (inv_pos.2 (by linarith))]
      exact mul_le_mul hinv (hNG i) (abs_nonneg _) (inv_nonneg.2 (by linarith))
    rw [hT, iteratedDeriv_fun_add hA hB]
    calc _ ≤ |iteratedDeriv i (fun e => (-X) * leadW h U X e) η| +
          |iteratedDeriv i (fun e => (2 * X)⁻¹ * (N e * (C * F X e)⁻¹)) η| := abs_add_le _ _
      _ ≤ 110 * BW i + (2 * X0)⁻¹ * BNG i := add_le_add h1 h2
      _ = BT i := by rw [hBT]
  have hqS : ContDiffOn ℝ ∞ q (Ioo (-1 - r) (1 + r)) := hq.mono hS2
  have hqb : ∀ i : ℕ, |iteratedDeriv i q η| ≤ Bq i := fun i => hBq i η hη1 hη2
  have hfun : (fun e => psLead1 h F U X e) = fun e => q e * T e := funext hrep
  rw [hfun]
  exact le_trans (leib q T _ η k hSo hηS hqS hTS) (summono k _ _ _ _ hqb hTb)

theorem axNs_eta_jets : ∀ (h rP : ℝ) (Pax : ℝ → ℝ) (MF : ℕ → ℝ), 0 < h → h < 1 / 100 → 0 < rP → ContDiffOn ℝ ∞ Pax (Ioo (-1 - rP) (1 + rP)) → ∃ M' : ℕ → ℝ, ∀ (C ε r : ℝ) (F U : ℝ → ℝ → ℝ), 1 ≤ C → 0 < ε → 0 < r → r ≤ 1 → ContDiffOn ℝ ∞ (↿F) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) → ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) → (∀ (k : ℕ) (X η : ℝ), 0 ≤ X → X ≤ 110 → -1 ≤ η → η ≤ 1 → |iteratedDeriv k (fun e => C * F X e) η| ≤ MF k ∧ |iteratedDeriv k (fun e => U X e) η| ≤ MF k) → ∀ (k : ℕ) (X η : ℝ), 0 < X → X ≤ 110 → -1 ≤ η → η ≤ 1 → |iteratedDeriv k (fun e => X * axNs h Pax F U X e / (1 - 2 * h * e ^ 2)) η| ≤ M' k :=
by
  intro h rP Pax MF hh0 hh1 hrP hPax

  have leib : ∀ (f g : ℝ → ℝ) (s : Set ℝ) (x : ℝ) (k : ℕ), IsOpen s → x ∈ s →
      ContDiffOn ℝ ∞ f s → ContDiffOn ℝ ∞ g s →
      |iteratedDeriv k (fun e => f e * g e) x| ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |iteratedDeriv i f x| * |iteratedDeriv (k - i) g x| := by
    intro f g s x k hs hx hf hg
    have H := norm_iteratedFDerivWithin_mul_le hf hg hs.uniqueDiffOn hx (n := k)
      (by exact_mod_cast le_top)
    have hw : ∀ (j : ℕ) (φ : ℝ → ℝ), iteratedDerivWithin j φ s x = iteratedDeriv j φ x :=
      fun j φ => iteratedDerivWithin_of_isOpen hs hx
    simp only [norm_iteratedFDerivWithin_eq_norm_iteratedDerivWithin, Real.norm_eq_abs, hw] at H
    exact H
  have cdaG : ∀ (φ : ℝ → ℝ) (t : Set ℝ) (x : ℝ), IsOpen t → x ∈ t → ContDiffOn ℝ ∞ φ t →
      ∀ j : ℕ, ContDiffAt ℝ (j : ℕ) φ x :=
    fun φ t x ht hx hφ j => (hφ.contDiffAt (ht.mem_nhds hx)).of_le (by exact_mod_cast le_top)
  obtain ⟨L, hL⟩ : ∃ L : (ℕ → ℝ) → (ℕ → ℝ) → ℕ → ℝ, L = fun A B k =>
      ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * A i * B (k - i) := ⟨_, rfl⟩
  have summono : ∀ (k : ℕ) (a b A B : ℕ → ℝ), (∀ i, |a i| ≤ A i) → (∀ i, |b i| ≤ B i) →
      ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |a i| * |b (k - i)| ≤ L A B k := by
    intro k a b A B ha hb
    simp only [hL]
    apply Finset.sum_le_sum
    intro i _
    have hA : 0 ≤ A i := le_trans (abs_nonneg _) (ha i)
    exact mul_le_mul (mul_le_mul_of_nonneg_left (ha i) (Nat.cast_nonneg _)) (hb (k - i))
      (abs_nonneg _) (mul_nonneg (Nat.cast_nonneg _) hA)

  have cpt : ∀ (f : ℝ → ℝ) (s : Set ℝ), IsOpen s → Icc (-1) 1 ⊆ s → ContDiffOn ℝ ∞ f s →
      ∃ B : ℕ → ℝ, ∀ (k : ℕ) (e : ℝ), -1 ≤ e → e ≤ 1 → |iteratedDeriv k f e| ≤ B k := by
    intro f s hs hsub hf
    have hex : ∀ k : ℕ, ∃ b : ℝ, ∀ e ∈ Icc (-1 : ℝ) 1, ‖iteratedDerivWithin k f s e‖ ≤ b := fun k =>
      isCompact_Icc.exists_bound_of_continuousOn
        ((hf.continuousOn_iteratedDerivWithin (by exact_mod_cast le_top) hs.uniqueDiffOn).mono hsub)
    choose B hB using hex
    refine ⟨B, fun k e h1 h2 => ?_⟩
    have he : e ∈ s := hsub ⟨h1, h2⟩
    have hb := hB k e ⟨h1, h2⟩
    rwa [iteratedDerivWithin_of_isOpen hs he, Real.norm_eq_abs] at hb

  have param_int_eta_jet : ∀ (ψ : ℝ → ℝ → ℝ) (a' a b b' c d : ℝ), a' < a → a ≤ b → b < b' → c < d → ContDiffOn ℝ ∞ (↿ψ) (Ioo a' b' ×ˢ Ioo c d) → ContDiffOn ℝ ∞ (fun e => ∫ y in a..b, ψ y e) (Ioo c d) ∧ ∀ (k : ℕ) (η B : ℝ), c < η → η < d → (∀ y : ℝ, a ≤ y → y ≤ b → |iteratedDeriv k (fun e => ψ y e) η| ≤ B) → |iteratedDeriv k (fun e => ∫ y in a..b, ψ y e) η| ≤ (b - a) * B := by
    intro ψ a' a b b' c d ha hab hb hcd hψ
    set W : Set (ℝ × ℝ) := Ioo a' b' ×ˢ Ioo c d with hW
    have hWo : IsOpen W := isOpen_Ioo.prod isOpen_Ioo
    have hIoc : Set.uIoc a b = Ioc a b := Set.uIoc_of_le hab
    have leib : ∀ (φ φ' : ℝ → ℝ → ℝ) (η : ℝ), c < η → η < d →
        ContinuousOn (↿φ) W → ContinuousOn (↿φ') W →
        (∀ y e : ℝ, a' < y → y < b' → c < e → e < d →
          HasDerivAt (fun e' => φ y e') (φ' y e) e) →
        HasDerivAt (fun e => ∫ y in a..b, φ y e) (∫ y in a..b, φ' y η) η := by
      intro φ φ' η hη1 hη2 hφ hφ' hder
      set r := min (η - c) (d - η) / 2 with hr
      have hr0 : 0 < r := by
        have : 0 < min (η - c) (d - η) := lt_min (by linarith) (by linarith)
        linarith
      have hr1 : r ≤ (η - c) / 2 := by
        have := min_le_left (η - c) (d - η); linarith
      have hr2 : r ≤ (d - η) / 2 := by
        have := min_le_right (η - c) (d - η); linarith
      have hKW : Icc a b ×ˢ Icc (η - r) (η + r) ⊆ W := by
        rintro ⟨t, x⟩ ⟨⟨ht1, ht2⟩, hx1, hx2⟩
        exact ⟨⟨by linarith, by linarith⟩, by linarith, by linarith⟩
      obtain ⟨Bd, hBd⟩ :=
        (isCompact_Icc.prod isCompact_Icc).exists_bound_of_continuousOn (hφ'.mono hKW)
      have slice : ∀ (χ : ℝ → ℝ → ℝ), ContinuousOn (↿χ) W → ∀ x, c < x → x < d →
          ContinuousOn (fun t => χ t x) (Icc a b) := by
        intro χ hχ x hx1 hx2
        have : ContinuousOn (↿χ ∘ fun t : ℝ => (t, x)) (Icc a b) :=
          hχ.comp (continuous_id.prodMk continuous_const).continuousOn
            (fun t ht => ⟨⟨by linarith [ht.1], by linarith [ht.2]⟩, hx1, hx2⟩)
        exact this
      have hmeas : ∀ (χ : ℝ → ℝ → ℝ), ContinuousOn (↿χ) W → ∀ x, c < x → x < d →
          AEStronglyMeasurable (fun t => χ t x) (volume.restrict (Set.uIoc a b)) := by
