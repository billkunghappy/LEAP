  have hsig : ∀ y : ℝ, 0 ≤ sigA y ∧ sigA y ≤ 1 := by
    intro y
    unfold sigA
    split_ifs with h1 h2
    · norm_num
    · norm_num
    · have p := Real.exp_pos (-1 / y ^ 2)
      have r := Real.exp_pos (-1 / (1 - y) ^ 2)
      constructor
      · positivity
      · rw [div_le_one (by positivity)]
        linarith
  have hFc : ∀ x η : ℝ, a ≤ x → -1 < η → η < 1 → F x η = F x 0 := by
    intro x η hx h1 h2
    have hs : 0 < Real.sqrt (2 * x) := Real.sqrt_pos.2 (by linarith)
    have e1 := htail x η hx h1 h2
    have e2 := htail x 0 hx (by norm_num) (by norm_num)
    exact mul_left_cancel₀ hs.ne' (e1.trans e2.symm)
  have hFb : ∀ x : ℝ, a ≤ x → |F x 0| ≤ ci * x ^ (-(1 + h)) := by
    intro x hx
    have hx0 : 0 < x := ha.trans_le hx
    have hs : 0 < Real.sqrt (2 * x) := Real.sqrt_pos.2 (by linarith)
    have e2 := htail x 0 hx (by norm_num) (by norm_num)
    obtain ⟨s0, s1⟩ := hsig ((Real.log (x / xb) + 2) / 2)
    have hT0 : 0 ≤ tailFac ρ xb x := by
      unfold tailFac
      nlinarith [mul_nonneg hρ0.le s0]
    have hT1 : tailFac ρ xb x ≤ 1 := by
      unfold tailFac
      nlinarith [mul_nonneg hρ0.le (sub_nonneg.2 s1)]
    have hP0 : 0 < x ^ (-(1 + h)) := Real.rpow_pos_of_pos hx0 _
    have hQ0 : 0 ≤ x ^ (-(1 / 2 + h)) := Real.rpow_nonneg hx0.le _
    have hsplit : x ^ (-(1 / 2 + h)) = x ^ (-(1 + h)) * Real.sqrt x := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_add hx0]
      congr 1
      ring
    have hsq : Real.sqrt x ≤ Real.sqrt (2 * x) := Real.sqrt_le_sqrt (by linarith)
    have habs : |Real.sqrt (2 * x) * F x 0| = ci * x ^ (-(1 / 2 + h)) * tailFac ρ xb x := by
      rw [e2]
      exact abs_of_nonneg (mul_nonneg (mul_nonneg hci.le hQ0) hT0)
    rw [abs_mul, abs_of_pos hs] at habs
    have hcP : 0 ≤ ci * x ^ (-(1 + h)) := mul_nonneg hci.le hP0.le
    have key : Real.sqrt (2 * x) * |F x 0| ≤ Real.sqrt (2 * x) * (ci * x ^ (-(1 + h))) := by
      rw [habs, hsplit]
      calc ci * (x ^ (-(1 + h)) * Real.sqrt x) * tailFac ρ xb x
