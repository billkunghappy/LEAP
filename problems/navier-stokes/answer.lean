theorem good_nphiP5_nb_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C : ℝ, ∀ (l0 : ℕ), l1 ≤ l0 → ∀ (γ : Lab), ActiveL4 B G γ → l0 ≤ γ.1 → ∀ ξ ∈ DomC B.h (qsOf l0), 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 → B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → ∀ i : Fin 3, NB B.h (fun η : Cyl => nPhiP5 B G γ η i) k ξ ≤ C * SC B.h ξ :=
