theorem pulse_frame_scalars5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ lP : ℕ, ∃ M ν : ℝ, 0 < ν ∧ 0 ≤ M ∧ ∀ (γ : Lab) (ξ : Cyl), ActiveL4 B G γ → γ.1 < lP → ξ ∈ DomC B.h B.qB → etaL B.h γ ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → 1 ≤ epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 ∧ epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 ≤ 4 ∧ |Bs5 B G γ| ≤ M ∧ |pzr5 B G γ| ≤ M ∧ |pang5 B G γ| ≤ M ∧ |RC γ.1 ξ| ≤ M ∧ |pang5 B G γ / RC γ.1 ξ| ≤ M ∧ ν ≤ (pang5 B G γ / RC γ.1 ξ) ^ 2 ∧ Lsb B.h G.r0 γ.1 ≤ M ∧ ∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), |lam0_5 B G γ / Real.sqrt (1 + sco B G γ v ^ 2) - epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 * (1 + sco B G γ v ^ 2)| ≤ M :=
by
