  have n2 := mul_nonneg hA0 hx2.le
  have n3 := mul_nonneg hA0 hp12.le
  have hQA : A ≤ Q := by rw [hQ]; linarith
  have hQ1 : A * x1 ^ (-(2 / 5 : ℝ)) ≤ Q := by rw [hQ]; linarith
  have hQ2 : A * x2 ≤ Q := by rw [hQ]; linarith
  have hQ3 : A * x1 ^ (-(1 + 2 * h)) ≤ Q := by rw [hQ]; linarith
  obtain ⟨Ls, hLs⟩ := cone_alg_shear c Q x1 x2 hc hx1 hx12
  obtain ⟨L1, hL1⟩ := cone_alg_ps1 h c Q x1 x2 hh0 hh1 hc hx1 hx12
  obtain ⟨L2, hL2⟩ := cone_alg_ps2 h c Q x1 x2 hh0 hh1 hc hx1 hx12
  refine ⟨(1 + |Ls| + |L1| + |L2|) * Q, ?_⟩
  intro ε F U G V hε0 hε1 hF hU hG hV hH1 hH2 x η hx1x hxx2 hη1 hη2
  have hx0 : 0 < x := lt_of_lt_of_le hx1 hx1x
  obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = ε * Q := ⟨_, rfl⟩
  have hQ0 : 0 ≤ Q := hA0.trans hQA
  have hδ0 : 0 ≤ δ := by rw [hδ]; exact mul_nonneg hε0 hQ0
  have hδQ : δ ≤ Q := by rw [hδ]; exact mul_le_of_le_one_left hQ0 hε1
  have hεQ : ∀ a : ℝ, a ≤ Q → ε * a ≤ δ := fun a ha => by
    rw [hδ]; exact mul_le_mul_of_nonneg_left ha hε0
  have hfin : ∀ L : ℝ, |L| ≤ 1 + |Ls| + |L1| + |L2| →
      L * δ ≤ (1 + |Ls| + |L1| + |L2|) * Q * ε := by
    intro L hL
    have h1 : L * δ ≤ |L| * δ := mul_le_mul_of_nonneg_right (le_abs_self L) hδ0
    have h2 : |L| * δ ≤ (1 + |Ls| + |L1| + |L2|) * δ := mul_le_mul_of_nonneg_right hL hδ0
    have h3 : (1 + |Ls| + |L1| + |L2|) * δ = (1 + |Ls| + |L1| + |L2|) * Q * ε := by
      rw [hδ]; ring
    linarith
  have aLs := abs_nonneg Ls
  have aL1 := abs_nonneg L1
  have aL2 := abs_nonneg L2

  have hΩ : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hdη : ∀ P : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿P) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ∀ y e : ℝ, 0 < y → -1 < e → e < 1 → DifferentiableAt ℝ (fun t => P y t) e := by
    intro P hP y e hy he1 he2
    have h1 : ContDiffAt ℝ ∞ (↿P) (y, e) :=
      hP.contDiffAt (hΩ.mem_nhds (show (y, e) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 from ⟨hy, he1, he2⟩))
    have hg : DifferentiableAt ℝ (fun t : ℝ => (y, t)) e := by fun_prop
    exact (h1.differentiableAt (by simp)).comp e hg
  have hdx : ∀ P : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿P) (Ioi 0 ×ˢ Ioo (-1) 1) →
      DifferentiableAt ℝ (fun Y => P Y η) x := by
    intro P hP
    have h1 : ContDiffAt ℝ ∞ (↿P) (x, η) :=
      hP.contDiffAt (hΩ.mem_nhds (show (x, η) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 from ⟨hx0, hη1, hη2⟩))
    have hg : DifferentiableAt ℝ (fun Y : ℝ => (Y, η)) x := by fun_prop
    exact (h1.differentiableAt (by simp)).comp x hg
  have hW : ∀ y e : ℝ, 0 < y → -1 < e → e < 1 →
      |F y e| ≤ K * (y ^ (-(2 / 5 : ℝ)) * (1 + y) ^ (-(3 / 5 + h))) ∧
      |deriv (fun t => F y t) e| ≤ K * (y ^ (-(2 / 5 : ℝ)) * (1 + y) ^ (-(3 / 5 + h))) ∧
      |U y e| ≤ K ∧ |deriv (fun t => U y t) e| ≤ K ∧
      |G y e - F y e| ≤ ε * (K * (y ^ (-(2 / 5 : ℝ)) * (1 + y) ^ (-(3 / 5 + h)))) ∧
      |deriv (fun t => G y t - F y t) e| ≤
        ε * (K * (y ^ (-(2 / 5 : ℝ)) * (1 + y) ^ (-(3 / 5 + h)))) ∧
      |V y e - U y e| ≤ ε * K ∧ |deriv (fun t => V y t - U y t) e| ≤ ε * K := by
    intro y e hy he1 he2
    obtain ⟨a0, b0, c0, d0⟩ := hH2 0 (Nat.zero_le 1) y e hy he1 he2
    obtain ⟨a1, b1, c1, d1⟩ := hH2 1 le_rfl y e hy he1 he2
    rw [iteratedDeriv_zero] at a0 b0 c0 d0
    rw [iteratedDeriv_one] at a1 b1 c1 d1
    have r1 : K * y ^ (-(2 / 5 : ℝ)) * (1 + y) ^ (-(3 / 5 + h)) =
        K * (y ^ (-(2 / 5 : ℝ)) * (1 + y) ^ (-(3 / 5 + h))) := by ring
    have r2 : ε * K * y ^ (-(2 / 5 : ℝ)) * (1 + y) ^ (-(3 / 5 + h)) =
        ε * (K * (y ^ (-(2 / 5 : ℝ)) * (1 + y) ^ (-(3 / 5 + h)))) := by ring
    exact ⟨a0.trans_eq r1, a1.trans_eq r1, b0, b1, c0.trans_eq r2, c1.trans_eq r2, d0, d1⟩
  have hslice := fun (y e : ℝ) (hy : 0 < y) (he1 : -1 < e) (he2 : e < 1) =>
    slice_integrand_bounds (fun t => F y t) (fun t => U y t) (fun t => G y t) (fun t => V y t) y e K ε
      (y ^ (-(2 / 5 : ℝ)) * (1 + y) ^ (-(3 / 5 + h))) hy hε0 hε1
      (weight_facts h y hh0 hy).1.le (weight_facts h y hh0 hy).2.2.1
      (weight_facts h y hh0 hy).2.2.2.1
      (hdη F hF y e hy he1 he2) (hdη U hU y e hy he1 he2) (hdη G hG y e hy he1 he2)
      (hdη V hV y e hy he1 he2)
      (hW y e hy he1 he2).1 (hW y e hy he1 he2).2.1 (hW y e hy he1 he2).2.2.1
      (hW y e hy he1 he2).2.2.2.1 (hW y e hy he1 he2).2.2.2.2.1 (hW y e hy he1 he2).2.2.2.2.2.1
      (hW y e hy he1 he2).2.2.2.2.2.2.1 (hW y e hy he1 he2).2.2.2.2.2.2.2

  have sm1 : ∀ P : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿P) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿(fun (y e : ℝ) => 2 * y * P y e)) (Ioi 0 ×ˢ Ioo (-1) 1) :=
    fun P hP => (contDiffOn_const.mul contDiffOn_fst).mul hP
  have sm2 : ∀ P R : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿P) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿R) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿(fun (y e : ℝ) => R y e * (2 * y * P y e))) (Ioi 0 ×ˢ Ioo (-1) 1) :=
    fun P R hP hR => hR.mul ((contDiffOn_const.mul contDiffOn_fst).mul hP)
  have sm3 : ∀ P R : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿P) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿R) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿(fun (y e : ℝ) => R y e ^ 2 - y * P y e ^ 2)) (Ioi 0 ×ˢ Ioo (-1) 1) :=
    fun P R hP hR => (hR.pow 2).sub (contDiffOn_fst.mul (hP.pow 2))
  have sm4 : ∀ P : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿P) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿(fun (y e : ℝ) => P y e ^ 2)) (Ioi 0 ×ˢ Ioo (-1) 1) :=
    fun P hP => hP.pow 2
  have smavg : ∀ P : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿P) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿(fun (s e : ℝ) => P (s * x) e)) (Ioi 0 ×ˢ Ioo (-1) 1) := by
    intro P hP
    have hm : ContDiff ℝ ∞ (fun p : ℝ × ℝ => (p.1 * x, p.2)) :=
      (contDiff_fst.mul contDiff_const).prodMk contDiff_snd
    exact hP.comp hm.contDiffOn (fun p hp => ⟨mul_pos hp.1 hx0, hp.2⟩)

  have hK0 : 0 ≤ K := le_trans (abs_nonneg _) (hW x η hx0 hη1 hη2).2.2.1
  have hKA : K ≤ A := by rw [hA]; nlinarith [sq_nonneg K]
  have hKQ : K ≤ Q := hKA.trans hQA
  obtain ⟨hwx0, hwx1, -, -, -⟩ := weight_facts h x hh0 hx0
  have hxp : x ^ (-(2 / 5 : ℝ)) ≤ x1 ^ (-(2 / 5 : ℝ)) :=
    Real.rpow_le_rpow_of_nonpos hx1 hx1x (by norm_num)
  have hKw : K * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))) ≤ Q :=
    calc K * (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))) ≤ K * x1 ^ (-(2 / 5 : ℝ)) :=
          mul_le_mul_of_nonneg_left (hwx1.trans hxp) hK0
      _ ≤ A * x1 ^ (-(2 / 5 : ℝ)) := mul_le_mul_of_nonneg_right hKA hp25.le
      _ ≤ Q := hQ1
  obtain ⟨hcF, hcG, hFx, hUx, hGFx, hVUx⟩ := hH1 x η hx1x hxx2 hη1 hη2
  obtain ⟨-, -, hWU, -, hWGF, -, hWVU, -⟩ := hW x η hx0 hη1 hη2
  have hdf : |G x η - F x η| ≤ δ := hWGF.trans (hεQ _ hKw)
  have hdu : |V x η - U x η| ≤ δ := hWVU.trans (hεQ _ hKQ)
  have hu : |U x η| ≤ Q := hWU.trans hKQ
  have hdfx : |deriv (fun Y => G Y η) x - deriv (fun Y => F Y η) x| ≤ δ := by
    rw [← deriv_fun_sub (hdx G hG) (hdx F hF)]
    exact hGFx.trans (hεQ K hKQ)
  have hdux : |deriv (fun Y => V Y η) x - deriv (fun Y => U Y η) x| ≤ δ := by
    rw [← deriv_fun_sub (hdx V hV) (hdx U hU)]
    exact hVUx.trans (hεQ K hKQ)
  have hA1 : A * 1 ≤ Q := by rw [mul_one]; exact hQA
  have hAx : A * x ≤ Q := (mul_le_mul_of_nonneg_left hxx2 hA0).trans hQ2

  obtain ⟨a1, a2, a3, a4⟩ := radint_pair_bound (fun s e => U (s * x) e) (fun s e => V (s * x) e)
    1 A ε one_pos hA0 hε0 (smavg U hU) (smavg V hV)
    (fun s e hs _ he1 he2 => by
      have := (hslice (s * x) e (mul_pos hs hx0) he1 he2).1
      rw [← hA] at this
      exact this) η hη1 hη2
  have ta : |profRadAvg U x η| ≤ Q := a1.trans hA1
  have tb : |profEtaD (profRadAvg U) x η| ≤ Q := a2.trans hA1
  have da : |profRadAvg V x η - profRadAvg U x η| ≤ δ := a3.trans (hεQ _ hA1)
  have db : |profEtaD (profRadAvg V) x η - profEtaD (profRadAvg U) x η| ≤ δ :=
    a4.trans (hεQ _ hA1)

  obtain ⟨b1, b2, b3, b4⟩ := radint_pair_bound (fun y e => 2 * y * F y e)
    (fun y e => 2 * y * G y e) x A ε hx0 hA0 hε0 (sm1 F hF) (sm1 G hG)
    (fun y e hy _ he1 he2 => by
      have := (hslice y e hy he1 he2).2.1
      rw [← hA] at this
      exact this) η hη1 hη2

  obtain ⟨c1, c2, c3, c4⟩ := radint_pair_bound (fun y e => U y e * (2 * y * F y e))
    (fun y e => V y e * (2 * y * G y e)) x A ε
    hx0 hA0 hε0 (sm2 F U hF hU) (sm2 G V hG hV)
    (fun y e hy _ he1 he2 => by
      have := (hslice y e hy he1 he2).2.2.1
      rw [← hA] at this
      exact this) η hη1 hη2

  obtain ⟨d1, d2, d3, d4⟩ := radint_pair_bound U V x A ε
    hx0 hA0 hε0 hU hV
    (fun y e hy _ he1 he2 => by
      have := (hslice y e hy he1 he2).1
      rw [← hA] at this
      exact this) η hη1 hη2

  obtain ⟨e1, e2, e3, e4⟩ := radint_pair_bound (fun y e => U y e ^ 2 - y * F y e ^ 2)
    (fun y e => V y e ^ 2 - y * G y e ^ 2) x A ε
    hx0 hA0 hε0 (sm3 F U hF hU) (sm3 G V hG hV)
    (fun y e hy _ he1 he2 => by
      have := (hslice y e hy he1 he2).2.2.2.1
      rw [← hA] at this
      exact this) η hη1 hη2

  obtain ⟨p1, p2, p3, p4⟩ := tail_pair_bound (fun y e => F y e ^ 2) (fun y e => G y e ^ 2) x A ε
    (2 + 2 * h) hx0 (by linarith) hA0 hε0 (sm4 F hF) (sm4 G hG)
    (fun y e hy he1 he2 => by
      have hy0 : 0 < y := lt_trans hx0 hy
      have hwy := (weight_facts h y hh0 hy0).2.2.2.2
      have hAw : A * (y ^ (-(2 / 5 : ℝ)) * (1 + y) ^ (-(3 / 5 + h))) ^ 2 ≤
          A * y ^ (-(2 + 2 * h)) :=
        mul_le_mul_of_nonneg_left hwy hA0
      have hεAw := mul_le_mul_of_nonneg_left hAw hε0
      have := (hslice y e hy0 he1 he2).2.2.2.2
      rw [← hA] at this
      obtain ⟨q1, q2, q3, q4⟩ := this
      exact ⟨q1.trans hAw, q2.trans hAw, q3.trans hεAw, q4.trans hεAw⟩) η hη1 hη2
  have hTB : A * x ^ (1 - (2 + 2 * h)) / (2 + 2 * h - 1) ≤ Q := by
    have e0 : (1:ℝ) - (2 + 2 * h) = -(1 + 2 * h) := by ring
    rw [e0]
    have h1 : x ^ (-(1 + 2 * h)) ≤ x1 ^ (-(1 + 2 * h)) :=
      Real.rpow_le_rpow_of_nonpos hx1 hx1x (by linarith)
    have h2 : 0 ≤ A * x ^ (-(1 + 2 * h)) := mul_nonneg hA0 (Real.rpow_nonneg hx0.le _)
    have h3 : A * x ^ (-(1 + 2 * h)) / (2 + 2 * h - 1) ≤ A * x ^ (-(1 + 2 * h)) :=
      div_le_self h2 (by linarith)
    have h4 : A * x ^ (-(1 + 2 * h)) ≤ A * x1 ^ (-(1 + 2 * h)) :=
      mul_le_mul_of_nonneg_left h1 hA0
    linarith
  have tp : |leadPi F x η| ≤ Q := by
    show |-∫ y in Ioi x, F y η ^ 2| ≤ Q
    rw [abs_neg]
    exact p1.trans hTB
  have tq : |profEtaD (leadPi F) x η| ≤ Q := by
    show |deriv (fun e => -∫ y in Ioi x, F y e ^ 2) η| ≤ Q
    rw [deriv.fun_neg, abs_neg]
    exact p2.trans hTB
  have dp : |leadPi G x η - leadPi F x η| ≤ δ := by
    show |(-∫ y in Ioi x, G y η ^ 2) - -∫ y in Ioi x, F y η ^ 2| ≤ δ
    rw [neg_sub_neg, abs_sub_comm]
    exact p3.trans (hεQ _ hTB)
  have dq : |profEtaD (leadPi G) x η - profEtaD (leadPi F) x η| ≤ δ := by
    show |deriv (fun e => -∫ y in Ioi x, G y e ^ 2) η -
      deriv (fun e => -∫ y in Ioi x, F y e ^ 2) η| ≤ δ
    rw [deriv.fun_neg, deriv.fun_neg, neg_sub_neg, abs_sub_comm]
    exact p4.trans (hεQ _ hTB)

  have S1 : |(1:ℝ)| ≤ 1 + |Ls| + |L1| + |L2| := by rw [abs_one]; linarith
  have SLs : |Ls| ≤ 1 + |Ls| + |L1| + |L2| := by linarith
  have SL1 : |L1| ≤ 1 + |Ls| + |L1| + |L2| := by linarith
  have SL2 : |L2| ≤ 1 + |Ls| + |L1| + |L2| := by linarith
  obtain ⟨r1, r2⟩ := hLs x δ (F x η) (deriv (fun Y => F Y η) x) (deriv (fun Y => U Y η) x)
    (G x η) (deriv (fun Y => G Y η) x) (deriv (fun Y => V Y η) x) hx1x hxx2 hδ0 hcF hcG
    (hFx.trans hKQ) (hUx.trans hKQ) hdf hdfx hdux
  have r3 := hL1 x η δ (F x η) (profRadAvg U x η) (profEtaD (profRadAvg U) x η)
    (profRadInt (fun y e => 2 * y * F y e) x η)
    (profEtaD (profRadInt (fun y e => 2 * y * F y e)) x η)
    (profRadInt (fun y e => U y e * (2 * y * F y e)) x η)
    (profEtaD (profRadInt (fun y e => U y e * (2 * y * F y e))) x η)
    (G x η) (profRadAvg V x η) (profEtaD (profRadAvg V) x η)
    (profRadInt (fun y e => 2 * y * G y e) x η)
    (profEtaD (profRadInt (fun y e => 2 * y * G y e)) x η)
    (profRadInt (fun y e => V y e * (2 * y * G y e)) x η)
    (profEtaD (profRadInt (fun y e => V y e * (2 * y * G y e))) x η)
    hx1x hxx2 hη1 hη2 hδ0 hcF hcG (b1.trans hAx) (b2.trans hAx) (c1.trans hAx) (c2.trans hAx)
    hdf da db (b3.trans (hεQ _ hAx)) (b4.trans (hεQ _ hAx)) (c3.trans (hεQ _ hAx))
    (c4.trans (hεQ _ hAx))
  have r4 := hL2 x η δ (F x η) (U x η) (profRadAvg U x η) (profEtaD (profRadAvg U) x η)
    (profRadInt U x η) (profEtaD (profRadInt U) x η)
    (profRadInt (fun y e => U y e ^ 2 - y * F y e ^ 2) x η)
    (profEtaD (profRadInt (fun y e => U y e ^ 2 - y * F y e ^ 2)) x η)
    (leadPi F x η) (profEtaD (leadPi F) x η)
    (G x η) (V x η) (profRadAvg V x η) (profEtaD (profRadAvg V) x η)
    (profRadInt V x η) (profEtaD (profRadInt V) x η)
    (profRadInt (fun y e => V y e ^ 2 - y * G y e ^ 2) x η)
    (profEtaD (profRadInt (fun y e => V y e ^ 2 - y * G y e ^ 2)) x η)
    (leadPi G x η) (profEtaD (leadPi G) x η)
    hx1x hxx2 hη1 hη2 hδ0 hδQ hcF hcG hu ta tb (d1.trans hAx) (d2.trans hAx) (e1.trans hAx)
    (e2.trans hAx) tp tq hdf hdu da db (d3.trans (hεQ _ hAx)) (d4.trans (hεQ _ hAx))
    (e3.trans (hεQ _ hAx)) (e4.trans (hεQ _ hAx)) dp dq
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · have := hfin 1 S1
    linarith
  · exact r1.trans (hfin Ls SLs)
  · exact r2.trans (hfin Ls SLs)
  · exact r3.trans (hfin L1 SL1)
  · exact r4.trans (hfin L2 SL2)

theorem margin_stable : ∀ μ : ℝ, 0 < μ → μ ≤ 1 → ∃ τ : ℝ, 0 < τ ∧ ∀ (adm : Prop) (F a b p1 p2 F' a' b' p1' p2' : ℝ), μ ≤ F → μ ≤ a → a ≤ 1 / μ → |b| ≤ 1 / μ → μ ≤ p1 → |p2| ≤ p1 / μ → μ ≤ a - b * (p2 / p1) → μ ≤ 2 - 2 * b * (p2 / p1) - b ^ 2 / a - (a - 2) * (p2 / p1) ^ 2 → (adm → μ ≤ a * (1 + (b / a) ^ 2) - 2) → |F' - F| ≤ τ → |a' - a| ≤ τ → |b' - b| ≤ τ → |p1' - p1| ≤ τ → |p2' - p2| ≤ τ → μ / 2 ≤ F' ∧ μ / 2 ≤ a' ∧ a' ≤ 1 / (μ / 2) ∧ |b'| ≤ 1 / (μ / 2) ∧ μ / 2 ≤ p1' ∧ |p2'| ≤ p1' / (μ / 2) ∧ μ / 2 ≤ a' - b' * (p2' / p1') ∧ μ / 2 ≤ 2 - 2 * b' * (p2' / p1') - b' ^ 2 / a' - (a' - 2) * (p2' / p1') ^ 2 ∧ (adm → μ / 2 ≤ a' * (1 + (b' / a') ^ 2) - 2) :=
by
  intro μ hμ0 hμ1
  refine ⟨μ ^ 5 / 200, by positivity, ?_⟩
  intro adm F a b p1 p2 F' a' b' p1' p2' hF ha1 ha2 hb hp1 hp2 hE1 hE2 hE3 dF da db dp1 dp2
  have hμne : μ ≠ 0 := hμ0.ne'
  have hK1 : 1 ≤ 1 / μ := one_le_one_div hμ0 hμ1
  have hμK : μ * (1 / μ) = 1 := mul_one_div_cancel hμne
  have hτK4 : μ ^ 5 / 200 * (1 / μ) ^ 4 = μ / 200 := by field_simp
  have hhalf : ∀ x : ℝ, x / (μ / 2) = 2 * (1 / μ) * x := by intro x; field_simp
  have hp1K : p1 / μ = (1 / μ) * p1 := by ring
  have ha0 : 0 < a := by linarith
  have hane : a ≠ 0 := ha0.ne'
  have hp10 : 0 < p1 := by linarith
  have key3 : a * (1 + (b / a) ^ 2) = a + b ^ 2 / a := by field_simp
  rw [hp1K] at hp2
  rw [key3] at hE3
  simp only [hhalf]
  set K := 1 / μ with hKdef
  set τ := μ ^ 5 / 200 with hτdef
  have hK0 : 0 < K := by linarith
  have hτ0 : 0 ≤ τ := by rw [hτdef]; positivity
  have hτK : 0 ≤ τ * K := mul_nonneg hτ0 hK0.le
  have hτK2 : 0 ≤ τ * K ^ 2 := mul_nonneg hτ0 (pow_nonneg hK0.le 2)
  have hτK3 : 0 ≤ τ * K ^ 3 := mul_nonneg hτ0 (pow_nonneg hK0.le 3)
  have e1 : τ * 1 ≤ τ * K := mul_le_mul_of_nonneg_left hK1 hτ0
  have e2 : τ * K * 1 ≤ τ * K * K := mul_le_mul_of_nonneg_left hK1 hτK
  have e3 : τ * K ^ 2 * 1 ≤ τ * K ^ 2 * K := mul_le_mul_of_nonneg_left hK1 hτK2
  have e4 : τ * K ^ 3 * 1 ≤ τ * K ^ 3 * K := mul_le_mul_of_nonneg_left hK1 hτK3
  obtain ⟨dF1, dF2⟩ := abs_le.mp dF
  obtain ⟨da1, da2⟩ := abs_le.mp da
  obtain ⟨db1, db2⟩ := abs_le.mp db
  obtain ⟨dp11, dp12⟩ := abs_le.mp dp1
  obtain ⟨dp21, dp22⟩ := abs_le.mp dp2
  have hp1' : 3 * μ / 4 ≤ p1' := by linarith
  have hp1'0 : 0 < p1' := by linarith
  have ha' : μ / 2 ≤ a' := by linarith
  have ha'0 : 0 < a' := by linarith
  have ha'ne : a' ≠ 0 := ha'0.ne'
  have key3' : a' * (1 + (b' / a') ^ 2) = a' + b' ^ 2 / a' := by field_simp
  rw [key3']
  have hb' : |b'| ≤ 2 * K := by
    have := abs_sub_abs_le_abs_sub b' b
    linarith
  have hp2' : |p2'| ≤ 2 * K * p1' := by
    have h1 := abs_sub_abs_le_abs_sub p2' p2
    have h2 : K * p1 ≤ K * (p1' + τ) := mul_le_mul_of_nonneg_left (by linarith) hK0.le
    have h3 : K * (3 * μ / 4) ≤ K * p1' := mul_le_mul_of_nonneg_left hp1' hK0.le
    linarith
  set q := p2 / p1 with hqdef
  set q' := p2' / p1' with hq'def
  have hqp : q * p1 = p2 := div_mul_cancel₀ p2 hp10.ne'
  have hqp' : q' * p1' = p2' := div_mul_cancel₀ p2' hp1'0.ne'
  have hq : |q| ≤ K := by
    have h : |q| * p1 = |p2| := by rw [← hqp, abs_mul, abs_of_pos hp10]
    exact le_of_mul_le_mul_right (by rw [h]; exact hp2) hp10
  have hq' : |q'| ≤ 2 * K := by
    have h : |q'| * p1' = |p2'| := by rw [← hqp', abs_mul, abs_of_pos hp1'0]
    exact le_of_mul_le_mul_right (by rw [h]; linarith) hp1'0
  have dq : |q' - q| ≤ 4 * (τ * K ^ 2) := by
    have hid : p1' * (q' - q) = (p2' - p2) - q * (p1' - p1) := by linear_combination hqp' - hqp
    have h1 : p1' * |q' - q| ≤ τ + K * τ := by
      have h : p1' * |q' - q| = |(p2' - p2) - q * (p1' - p1)| := by
        rw [← hid, abs_mul, abs_of_pos hp1'0]
      rw [h]
      calc |(p2' - p2) - q * (p1' - p1)| ≤ |p2' - p2| + |q * (p1' - p1)| := abs_sub _ _
        _ = |p2' - p2| + |q| * |p1' - p1| := by rw [abs_mul]
        _ ≤ τ + K * τ := add_le_add dp2 (mul_le_mul hq dp1 (abs_nonneg _) hK0.le)
    have h2 : 3 * μ / 4 * |q' - q| ≤ p1' * |q' - q| :=
      mul_le_mul_of_nonneg_right hp1' (abs_nonneg _)
    have h3 : K * (3 * μ / 4 * |q' - q|) ≤ K * (τ + K * τ) :=
      mul_le_mul_of_nonneg_left (h2.trans h1) hK0.le
    have h4 : K * (3 * μ / 4 * |q' - q|) = 3 / 4 * |q' - q| := by
      linear_combination (3 / 4 * |q' - q|) * hμK
    linarith
  have hbq : |b' * q' - b * q| ≤ τ * (2 * K) + K * (4 * (τ * K ^ 2)) := by
    have h : b' * q' - b * q = (b' - b) * q' + b * (q' - q) := by ring
    rw [h]
    calc |(b' - b) * q' + b * (q' - q)| ≤ |(b' - b) * q'| + |b * (q' - q)| := abs_add_le _ _
      _ = |b' - b| * |q'| + |b| * |q' - q| := by rw [abs_mul, abs_mul]
      _ ≤ τ * (2 * K) + K * (4 * (τ * K ^ 2)) :=
          add_le_add (mul_le_mul db hq' (abs_nonneg _) hτ0) (mul_le_mul hb dq (abs_nonneg _) hK0.le)
  set r := b ^ 2 / a with hrdef
  set r' := b' ^ 2 / a' with hr'def
  have hra : r * a = b ^ 2 := div_mul_cancel₀ _ hane
  have hra' : r' * a' = b' ^ 2 := div_mul_cancel₀ _ ha'ne
  have hbsq : b ^ 2 ≤ K ^ 2 := by
    have h := mul_le_mul hb hb (abs_nonneg b) hK0.le
    have h' := abs_mul_abs_self b
    nlinarith
  have hr0 : 0 ≤ r := div_nonneg (sq_nonneg b) ha0.le
  have hrK : r ≤ K ^ 3 := by
    have h1 : r * μ ≤ r * a := mul_le_mul_of_nonneg_left ha1 hr0
    have h2 : K * (r * μ) ≤ K * K ^ 2 := mul_le_mul_of_nonneg_left (by linarith) hK0.le
    have h3 : K * (r * μ) = r := by linear_combination r * hμK
    nlinarith
  have hbb : |b' + b| ≤ 3 * K := by
    have := abs_add_le b' b
    linarith
  have dr : |r' - r| ≤ 8 * (τ * K ^ 4) := by
    have hid : a' * (r' - r) = (b' + b) * (b' - b) - r * (a' - a) := by
      linear_combination hra' - hra
    have h1 : a' * |r' - r| ≤ 3 * K * τ + K ^ 3 * τ := by
      have h : a' * |r' - r| = |(b' + b) * (b' - b) - r * (a' - a)| := by
        rw [← hid, abs_mul, abs_of_pos ha'0]
      rw [h]
      calc |(b' + b) * (b' - b) - r * (a' - a)| ≤ |(b' + b) * (b' - b)| + |r * (a' - a)| :=
            abs_sub _ _
        _ = |b' + b| * |b' - b| + |r| * |a' - a| := by rw [abs_mul, abs_mul]
        _ ≤ 3 * K * τ + K ^ 3 * τ := by
            rw [abs_of_nonneg hr0]
            exact add_le_add (mul_le_mul hbb db (abs_nonneg _) (by linarith))
              (mul_le_mul hrK da (abs_nonneg _) (pow_nonneg hK0.le 3))
    have h2 : μ / 2 * |r' - r| ≤ a' * |r' - r| := mul_le_mul_of_nonneg_right ha' (abs_nonneg _)
    have h3 : K * (μ / 2 * |r' - r|) ≤ K * (3 * K * τ + K ^ 3 * τ) :=
      mul_le_mul_of_nonneg_left (h2.trans h1) hK0.le
    have h4 : K * (μ / 2 * |r' - r|) = 1 / 2 * |r' - r| := by
      linear_combination (1 / 2 * |r' - r|) * hμK
    linarith
  have dquad : |(a' - 2) * q' ^ 2 - (a - 2) * q ^ 2| ≤ 40 * (τ * K ^ 4) := by
    have hid : (a' - 2) * q' ^ 2 - (a - 2) * q ^ 2
        = (a' - a) * q' ^ 2 + (a - 2) * ((q' + q) * (q' - q)) := by ring
    have hq'sq : q' ^ 2 ≤ 4 * K ^ 2 := by
      have h := mul_le_mul hq' hq' (abs_nonneg q') (by linarith)
      have h' := abs_mul_abs_self q'
      nlinarith
    have ha2' : |a - 2| ≤ 3 * K := abs_le.mpr ⟨by linarith, by linarith⟩
    have hqq : |q' + q| ≤ 3 * K := by
      have := abs_add_le q' q
      linarith
    rw [hid]
    calc |(a' - a) * q' ^ 2 + (a - 2) * ((q' + q) * (q' - q))|
        ≤ |(a' - a) * q' ^ 2| + |(a - 2) * ((q' + q) * (q' - q))| := abs_add_le _ _
      _ = |a' - a| * q' ^ 2 + |a - 2| * (|q' + q| * |q' - q|) := by
          rw [abs_mul, abs_mul, abs_mul, abs_of_nonneg (sq_nonneg q')]
      _ ≤ τ * (4 * K ^ 2) + 3 * K * (3 * K * (4 * (τ * K ^ 2))) :=
          add_le_add (mul_le_mul da hq'sq (sq_nonneg _) hτ0)
            (mul_le_mul ha2' (mul_le_mul hqq dq (abs_nonneg _) (by linarith))
              (mul_nonneg (abs_nonneg _) (abs_nonneg _)) (by linarith))
      _ ≤ 40 * (τ * K ^ 4) := by linarith
  obtain ⟨bq1, bq2⟩ := abs_le.mp hbq
  obtain ⟨dr1, dr2⟩ := abs_le.mp dr
  obtain ⟨dd1, dd2⟩ := abs_le.mp dquad
  refine ⟨by linarith, by linarith, by linarith, by linarith, by linarith, by linarith, ?_, ?_, ?_⟩
  · linarith
  · linarith
  · intro hadm
    have := hE3 hadm
    linarith

theorem cone_data_local : ∀ (h X0 : ℝ) (F U G V : ℝ → ℝ → ℝ), 0 < X0 → (∀ x η : ℝ, 0 < x → x < X0 → -1 < η → η < 1 → G x η = F x η ∧ V x η = U x η) → (∀ η : ℝ, -1 < η → η < 1 → IntegrableOn (fun x => F x η ^ 2) (Ioi 0) ∧ IntegrableOn (fun x => G x η ^ 2) (Ioi 0) ∧ (∫ x in Ioi (0:ℝ), G x η ^ 2) = ∫ x in Ioi (0:ℝ), F x η ^ 2) → ∀ x η : ℝ, 0 < x → x < X0 → -1 < η → η < 1 → G x η = F x η ∧ shearA G x η = shearA F x η ∧ shearB G V x η = shearB F U x η ∧ psLead1 h G V x η = psLead1 h F U x η ∧ psLead2 h G V x η = psLead2 h F U x η :=
by
  intro h X0 F U G V hX0 hloc htot x η hx hxX hη1 hη2
  have hO : Set.Ioo (-1:ℝ) 1 ∈ nhds η := Ioo_mem_nhds hη1 hη2

  have hRI : ∀ f g : ℝ → ℝ → ℝ,
      (∀ y e : ℝ, 0 < y → y < X0 → -1 < e → e < 1 → f y e = g y e) →
      profRadInt f x η = profRadInt g x η ∧
        profEtaD (profRadInt f) x η = profEtaD (profRadInt g) x η := by
    intro f g hfg
    have key : ∀ e : ℝ, -1 < e → e < 1 → profRadInt f x e = profRadInt g x e := by
      intro e he1 he2
      unfold profRadInt
      apply intervalIntegral.integral_congr_ae
      refine MeasureTheory.ae_of_all _ (fun y hy => ?_)
      rw [Set.uIoc_of_le hx.le] at hy
      exact hfg y e hy.1 (lt_of_le_of_lt hy.2 hxX) he1 he2
    refine ⟨key η hη1 hη2, ?_⟩
    unfold profEtaD
    exact Filter.EventuallyEq.deriv_eq
      (Filter.eventuallyEq_of_mem hO (fun e he => key e he.1 he.2))
  have hRA : ∀ f g : ℝ → ℝ → ℝ,
      (∀ y e : ℝ, 0 < y → y < X0 → -1 < e → e < 1 → f y e = g y e) →
      profRadAvg f x η = profRadAvg g x η ∧
        profEtaD (profRadAvg f) x η = profEtaD (profRadAvg g) x η := by
    intro f g hfg
    have key : ∀ e : ℝ, -1 < e → e < 1 → profRadAvg f x e = profRadAvg g x e := by
      intro e he1 he2
      unfold profRadAvg
      apply intervalIntegral.integral_congr_ae
      refine MeasureTheory.ae_of_all _ (fun s hs => ?_)
      rw [Set.uIoc_of_le zero_le_one] at hs
      have h1 : 0 < s * x := mul_pos hs.1 hx
      have h2 : s * x ≤ x := mul_le_of_le_one_left hx.le hs.2
      exact hfg (s * x) e h1 (lt_of_le_of_lt h2 hxX) he1 he2
    refine ⟨key η hη1 hη2, ?_⟩
    unfold profEtaD
    exact Filter.EventuallyEq.deriv_eq
      (Filter.eventuallyEq_of_mem hO (fun e he => key e he.1 he.2))

  have hPkey : ∀ e : ℝ, -1 < e → e < 1 → leadPi G x e = leadPi F x e := by
    intro e he1 he2
    obtain ⟨iF, iG, ht⟩ := htot e he1 he2
    have split : ∀ H : ℝ → ℝ → ℝ, IntegrableOn (fun y => H y e ^ 2) (Ioi 0) →
        (∫ y in Ioi (0:ℝ), H y e ^ 2) =
          (∫ y in Ioc (0:ℝ) x, H y e ^ 2) + ∫ y in Ioi x, H y e ^ 2 := by
      intro H hH
      rw [← Set.Ioc_union_Ioi_eq_Ioi hx.le]
      exact MeasureTheory.setIntegral_union (Set.Ioc_disjoint_Ioi le_rfl) measurableSet_Ioi
        (hH.mono_set Set.Ioc_subset_Ioi_self) (hH.mono_set (Set.Ioi_subset_Ioi hx.le))
    have hc : (∫ y in Ioc (0:ℝ) x, G y e ^ 2) = ∫ y in Ioc (0:ℝ) x, F y e ^ 2 := by
      apply MeasureTheory.setIntegral_congr_fun measurableSet_Ioc
      intro y hy
      simp only
      rw [(hloc y e hy.1 (lt_of_le_of_lt hy.2 hxX) he1 he2).1]
    have s1 := split G iG
    have s2 := split F iF
    unfold leadPi
    linarith
  have hP : leadPi G x η = leadPi F x η := hPkey η hη1 hη2
  have hdP : profEtaD (leadPi G) x η = profEtaD (leadPi F) x η := by
    unfold profEtaD
    exact Filter.EventuallyEq.deriv_eq
      (Filter.eventuallyEq_of_mem hO (fun e he => hPkey e he.1 he.2))

  have hN : Set.Ioo 0 X0 ∈ nhds x := Ioo_mem_nhds hx hxX
  have dG : deriv (fun Y => G Y η) x = deriv (fun Y => F Y η) x :=
    Filter.EventuallyEq.deriv_eq
      (Filter.eventuallyEq_of_mem hN (fun y hy => (hloc y η hy.1 hy.2 hη1 hη2).1))
  have dV : deriv (fun Y => V Y η) x = deriv (fun Y => U Y η) x :=
    Filter.EventuallyEq.deriv_eq
      (Filter.eventuallyEq_of_mem hN (fun y hy => (hloc y η hy.1 hy.2 hη1 hη2).2))
  obtain ⟨hG, hV⟩ := hloc x η hx hxX hη1 hη2

  obtain ⟨P1a, P1b⟩ := hRI (fun x e => 2 * x * G x e) (fun x e => 2 * x * F x e)
    (fun y e h1 h2 h3 h4 => by simp only [(hloc y e h1 h2 h3 h4).1])
  obtain ⟨P2a, P2b⟩ := hRI (fun x e => V x e * (2 * x * G x e)) (fun x e => U x e * (2 * x * F x e))
    (fun y e h1 h2 h3 h4 => by simp only [(hloc y e h1 h2 h3 h4).1, (hloc y e h1 h2 h3 h4).2])
  obtain ⟨P3a, P3b⟩ := hRI V U (fun y e h1 h2 h3 h4 => (hloc y e h1 h2 h3 h4).2)
  obtain ⟨P3c, P3d⟩ := hRA V U (fun y e h1 h2 h3 h4 => (hloc y e h1 h2 h3 h4).2)
  obtain ⟨P4a, P4b⟩ := hRI (fun x e => V x e ^ 2 - x * G x e ^ 2) (fun x e => U x e ^ 2 - x * F x e ^ 2)
    (fun y e h1 h2 h3 h4 => by simp only [(hloc y e h1 h2 h3 h4).1, (hloc y e h1 h2 h3 h4).2])
  have hW : leadW h V x η = leadW h U x η := by
    unfold leadW
    rw [P3c, P3d]

  have hQ : leadQs h G V x η = leadQs h F U x η := by
    unfold leadQs
    rw [hW, P1a, P1b, P2a, P2b, hG]
  have hNs : leadNs h G V x η = leadNs h F U x η := by
    unfold leadNs
    rw [hW, hV, P3a, P3b, P4a, P4b, hP, hdP]
  refine ⟨hG, ?_, ?_, ?_, ?_⟩
  · unfold shearA
    rw [dG, hG]
  · unfold shearB
    rw [dV, hG]
  · unfold psLead1
    rw [hQ]
  · unfold psLead2
    rw [hNs, hG]

theorem ref_heat_family : ∀ (h lam Pst ρ cp ci xg xg2 r1 r2 k1 k2 p1 p2 m1 m2 xv xb eps μ : ℝ) (c ϑ : ℝ → ℝ) (F U : ℝ → ℝ → ℝ), RefProf h lam Pst ρ cp ci xg xg2 r1 r2 k1 k2 p1 p2 m1 m2 xv xb eps μ c ϑ F U → ∃ (e1 μ' : ℝ) (Fh Uh : ℝ → ℝ → ℝ → ℝ), NormFam h lam Pst ρ cp ci xg xg2 r1 r2 p1 p2 m1 m2 xv xb e1 eps μ' c ϑ Fh Uh :=
by
  intro h lam Pst ρ cp ci xg xg2 r1 r2 k1 k2 p1 p2 m1 m2 xv xb eps μ c ϑ F U hRP
  have hRP' := hRP
  obtain ⟨⟨hh0, hh1, hlam, hμ0, hμ1, hcp, hci, hρ0, hρ1, hxg, hxg2, hxr1, hr12, hr2k1, hk12, hk2p1,
    hp12, hp2m1, hm12, hm2v, hvb⟩, hNB, -, -, hMT⟩ := hRP'
  obtain ⟨hFs, hUs, -, -, hin, -, -, hPi, -, -, hNMr, hNMa⟩ := hNB
  have hxb : 0 < xb := by
    by_contra hc
    push_neg at hc
    have := mul_nonpos_of_nonpos_of_nonneg hc (Real.exp_pos (-3)).le
    linarith
  have h35 : xb * Real.exp (-3) < xb * Real.exp (-(5 / 2)) :=
    mul_lt_mul_of_pos_left (Real.exp_lt_exp.2 (by norm_num)) hxb
  have h311 : xb * Real.exp (-3) < xb * Real.exp (-(11 / 4)) :=
    mul_lt_mul_of_pos_left (Real.exp_lt_exp.2 (by norm_num)) hxb
  have hS : xg ≤ xb * Real.exp (-(5 / 2)) := by linarith
  obtain ⟨e2, K, Fh, Uh, he2, he2le, hK, hfam⟩ :=
    heat_repair_family h lam Pst ρ cp ci xg xg2 r1 r2 k1 k2 p1 p2 m1 m2 xv xb eps μ c ϑ F U hRP
  obtain ⟨C6, hC6⟩ := cone_data_lipschitz h K (μ / 2) xg (xb * Real.exp (-(5 / 2))) hh0 hh1
    (by linarith) (by linarith) hS
  obtain ⟨τ, hτ0, hτ⟩ := margin_stable μ hμ0 hμ1
  have hA1 : 0 < |C6| + 1 := by positivity
  have hA2 : 0 < 2 * (K + 1) := by linarith
  refine ⟨min e2 (min (τ / (|C6| + 1)) (μ / (2 * (K + 1)))), μ / 2, Fh, Uh,
    ⟨hh0, hh1, hlam, lt_min he2 (lt_min (div_pos hτ0 hA1) (div_pos hμ0 hA2)),
      (min_le_left _ _).trans he2le, by linarith, by linarith, hcp, hci, hρ0, hρ1, hxg, hxg2, hxr1,
      hr12, by linarith, hp12, hp2m1, hm12, hm2v, by linarith⟩, ?_⟩
  intro e he0 hee1
  have hee2 : e ≤ e2 := hee1.trans (min_le_left _ _)
  have heτ : e ≤ τ / (|C6| + 1) := hee1.trans ((min_le_right _ _).trans (min_le_left _ _))
  have heμ : e ≤ μ / (2 * (K + 1)) := hee1.trans ((min_le_right _ _).trans (min_le_right _ _))
  have he1' : e ≤ 1 := hee2.trans he2le
  have hC6e : C6 * e ≤ τ := by
    have h1 : e * (|C6| + 1) ≤ τ := (le_div_iff₀ hA1).1 heτ
    have h2 : e * (|C6| + 1) = |C6| * e + e := by ring
    have h3 : C6 * e ≤ |C6| * e := mul_le_mul_of_nonneg_right (le_abs_self _) he0.le
    linarith
  have hKe : e * K ≤ μ / 2 := by
    have h1 : e * (2 * (K + 1)) ≤ μ := (le_div_iff₀ hA2).1 heμ
    have h2 : e * (2 * (K + 1)) = 2 * (e * K) + 2 * e := by ring
    linarith
  obtain ⟨hGs, hVs, hGpos, hGbd, hGpatch, hGv, hGPi, hGcol, hGwt, hGtail, hGMT, hloc, hclose,
    hwtd⟩ := hfam e he0 hee2
  have hpt : ∀ x η : ℝ, xg ≤ x → x ≤ xb * Real.exp (-(5 / 2)) → -1 < η → η < 1 →
      μ / 2 ≤ F x η ∧ μ / 2 ≤ Fh e x η ∧ |deriv (fun Y => F Y η) x| ≤ K ∧
      |deriv (fun Y => U Y η) x| ≤ K ∧ |deriv (fun Y => Fh e Y η - F Y η) x| ≤ e * K ∧
      |deriv (fun Y => Uh e Y η - U Y η) x| ≤ e * K := by
    intro x η hx1 hx2 h1 h2
    obtain ⟨n1, -⟩ := hNMa x ⟨hx1, hx2⟩ η h1 h2
    obtain ⟨c1, c2, c3, c4, c5⟩ := hclose x η hx1 hx2 h1 h2
    have := (abs_le.1 c1).1
    exact ⟨by linarith, by linarith, c2, c3, c4, c5⟩
  have hzero : ∀ a b : ℝ, a = b → |a - b| ≤ τ := fun a b hab => by
    rw [hab, sub_self, abs_zero]; exact hτ0.le
  refine ⟨⟨hGs, hVs, hGpos, hGbd, ?_, hGpatch, hGv, ?_, hGcol, hGwt, ?_, ?_⟩, hGtail, hGMT⟩
  · intro x η hx0 hx1 h1 h2
    obtain ⟨l1, l2⟩ := hloc x η hx0 (by linarith) h1 h2
    rw [l1, l2]
    exact hin x η hx0 hx1 h1 h2
  · intro η h1 h2
    rw [hGPi η h1 h2]
    exact hPi η h1 h2
  · intro x hx η h1 h2
    have hx0 : 0 < x := lt_of_lt_of_le (Real.exp_pos _) hx.1
    have hxk : x < k1 := by linarith [hx.2]
    have hint : ∀ η' : ℝ, -1 < η' → η' < 1 →
        IntegrableOn (fun x => F x η' ^ 2) (Ioi 0) ∧ IntegrableOn (fun x => Fh e x η' ^ 2) (Ioi 0) ∧
        (∫ x in Ioi (0:ℝ), Fh e x η' ^ 2) = ∫ x in Ioi (0:ℝ), F x η' ^ 2 := by
      intro η' g1 g2
      obtain ⟨-, -, -, i4, -⟩ := hMT η' g1 g2
      obtain ⟨-, -, -, j4, -⟩ := hGMT η' g1 g2
      have hP := hGPi η' g1 g2
      unfold leadPi at hP
      exact ⟨i4, j4, by linarith⟩
    obtain ⟨n1, n2, n3, n4, n5, n6, n7, n8, n9⟩ := hNMr x hx η h1 h2
    obtain ⟨q1, q2, q3, q4, q5⟩ :=
      cone_data_local h k1 F U (Fh e) (Uh e) (by linarith) hloc hint x η hx0 hxk h1 h2
    exact hτ False _ _ _ _ _ _ _ _ _ _ n1 n2 n3 n4 n5 n6 n7 n8 n9
