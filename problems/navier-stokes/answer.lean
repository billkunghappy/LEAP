    have hU : IsOpen (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
    have hO : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
    have hφc : ContDiff ℝ ∞ (fun z : ℝ × (ℝ × ℝ) => (z.2.1 + Xb * z.1, z.2.2)) :=
      ((contDiff_fst.comp contDiff_snd).add (contDiff_const.mul contDiff_fst)).prodMk
        (contDiff_snd.comp contDiff_snd)
    have hV : IsOpen ((fun z : ℝ × (ℝ × ℝ) => (z.2.1 + Xb * z.1, z.2.2)) ⁻¹'
        (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1)) := hU.preimage hφc.continuous
    have hk : ContDiffOn ℝ ∞ (fun z : ℝ × (ℝ × ℝ) => g (z.2.1 + Xb * z.1) z.2.2)
        ((fun z : ℝ × (ℝ × ℝ) => (z.2.1 + Xb * z.1, z.2.2)) ⁻¹' (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1)) :=
      hg.comp hφc.contDiffOn (mapsTo_preimage _ _)
    have htube : Icc (0:ℝ) 1 ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) ⊆
        (fun z : ℝ × (ℝ × ℝ) => (z.2.1 + Xb * z.1, z.2.2)) ⁻¹' (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
      rintro ⟨s, X, η⟩ ⟨⟨hs0, hs1⟩, hX, hη⟩
      refine ⟨?_, hη⟩
      show -ε < X + Xb * s
      have hX' : 0 < X := hX
      have := mul_nonneg hXb hs0
      linarith
    refine ⟨contDiffOn_infty.mpr (fun n => s2 n _ _ _ hO hV htube hk), ?_⟩
    intro m X η C hX h1 h2 hC
    refine s3 m _ _ _ hO hV htube hk (X, η) C ⟨hX, h1, h2⟩ ?_
    intro s hs
    have e : (fun q : ℝ × ℝ => g ((s, q).2.1 + Xb * (s, q).1) (s, q).2.2) =
        fun q => (↿g) (q + (Xb * s, 0)) := by
      funext q
      show g (q.1 + Xb * s) q.2 = g (q + (Xb * s, 0)).1 (q + (Xb * s, 0)).2
      simp
    rw [e, iteratedFDeriv_comp_add_right]
    have : ((X, η) + (Xb * s, 0) : ℝ × ℝ) = (X + Xb * s, η) := by simp
    rw [this]
    exact hC s hs

  have backrep : ∀ (f : ℝ → ℝ) (ε Xb : ℝ), 0 < ε → 0 < Xb → ContinuousOn f (Ioi (-ε)) →
      (∀ x, Xb < x → f x = 0) → ∫ x in Ioi (0:ℝ), f x = 0 → ∀ X : ℝ, 0 < X →
      ∫ x in (0:ℝ)..X, f x = -(Xb * ∫ s in (0:ℝ)..1, f (X + Xb * s)) := by
    intro f ε Xb hε hXb hf hz hint X hX
    have hII : ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → IntervalIntegrable f volume a b := by
      intro a b ha hb
      apply ContinuousOn.intervalIntegrable
      refine hf.mono (fun y hy => ?_)
      rw [mem_uIcc] at hy
      show -ε < y
      rcases hy with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> linarith
    have h0 : ∫ x in (0:ℝ)..Xb, f x = 0 := by
      have hsplit : Ioi (0:ℝ) = Ioc 0 Xb ∪ Ioi Xb := (Ioc_union_Ioi_eq_Ioi hXb.le).symm
      have hi1 : IntegrableOn f (Ioc 0 Xb) := by
        have : IntegrableOn f (Icc 0 Xb) :=
          (hf.mono (fun y hy => show -ε < y by linarith [hy.1])).integrableOn_Icc
        exact this.mono_set Ioc_subset_Icc_self
      have hi2 : IntegrableOn f (Ioi Xb) :=
        (integrableOn_zero).congr_fun (fun x hx => (hz x hx).symm) measurableSet_Ioi
      rw [hsplit, setIntegral_union (Ioc_disjoint_Ioi le_rfl) measurableSet_Ioi hi1 hi2,
        setIntegral_eq_zero_of_forall_eq_zero (fun x (hx : x ∈ Ioi Xb) => hz x hx), add_zero,
        ← intervalIntegral.integral_of_le hXb.le] at hint
      exact hint
    have h1 : ∫ x in (0:ℝ)..X, f x = -∫ x in X..Xb, f x := by
      have := intervalIntegral.integral_add_adjacent_intervals (hII 0 X le_rfl hX.le)
        (hII X Xb hX.le hXb.le)
      rw [h0] at this
      linarith
    have h2 : ∫ x in X..Xb, f x = ∫ x in X..(X + Xb), f x := by
      have := intervalIntegral.integral_add_adjacent_intervals (hII X Xb hX.le hXb.le)
        (hII Xb (X + Xb) hXb.le (by linarith))
      have h3 : ∫ x in Xb..(X + Xb), f x = 0 := by
        rw [intervalIntegral.integral_of_le (by linarith)]
        exact setIntegral_eq_zero_of_forall_eq_zero (fun x hx => hz x hx.1)
      rw [h3, add_zero] at this
      exact this
    have h4 : Xb * ∫ s in (0:ℝ)..1, f (X + Xb * s) = ∫ x in X..(X + Xb), f x := by
      have := intervalIntegral.smul_integral_comp_mul_add (fun x => f x) Xb X (a := 0) (b := 1)
      simp only [smul_eq_mul, mul_zero, zero_add, mul_one] at this
      rw [show X + Xb = Xb + X by ring, ← this]
      congr 1
      apply intervalIntegral.integral_congr
      intro s _
      simp only
      ring_nf
    rw [h1, h2, h4]

  have mulb : ∀ (a b : ℝ × ℝ → ℝ) (O : Set (ℝ × ℝ)) (p : ℝ × ℝ) (m : ℕ) (A B : ℝ),
      IsOpen O → p ∈ O → ContDiffOn ℝ ∞ a O → ContDiffOn ℝ ∞ b O →
      (∀ j, j ≤ m → ‖iteratedFDeriv ℝ j a p‖ ≤ A) →
      (∀ j, j ≤ m → ‖iteratedFDeriv ℝ j b p‖ ≤ B) →
      ‖iteratedFDeriv ℝ m (fun q => a q * b q) p‖ ≤ 2 ^ m * A * B := by
    intro a b O p m A B hO hp ha hb hA hB
    have hA0 : 0 ≤ A := (norm_nonneg _).trans (hA 0 (Nat.zero_le _))
    have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0 (Nat.zero_le _))
    have h := norm_iteratedFDerivWithin_mul_le ha hb hO.uniqueDiffOn hp (n := m)
      (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen m hO hp] at h
    refine h.trans ?_
    calc ∑ i ∈ Finset.range (m+1), (m.choose i : ℝ) * ‖iteratedFDerivWithin ℝ i a O p‖ *
          ‖iteratedFDerivWithin ℝ (m - i) b O p‖
        ≤ ∑ i ∈ Finset.range (m+1), (m.choose i : ℝ) * A * B := by
          apply Finset.sum_le_sum
          intro i hi
          have hi' : i ≤ m := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [iteratedFDerivWithin_of_isOpen i hO hp,
            iteratedFDerivWithin_of_isOpen (m-i) hO hp]
          exact mul_le_mul (mul_le_mul_of_nonneg_left (hA i hi') (Nat.cast_nonneg _))
            (hB _ (Nat.sub_le _ _)) (norm_nonneg _) (by positivity)
      _ = 2 ^ m * A * B := by
          rw [← Finset.sum_mul, ← Finset.sum_mul]
          congr 2
          exact_mod_cast Nat.sum_range_choose m

  have flat : ∀ (g : ℝ → ℝ → ℝ) (ε Xb : ℝ), 0 < ε → 0 ≤ Xb →
      ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
      (∀ x η : ℝ, Xb < x → -1 < η → η < 1 → g x η = 0) →
      ∀ (k : ℕ) (x η : ℝ), Xb ≤ x → -1 < η → η < 1 → iteratedFDeriv ℝ k (↿g) (x, η) = 0 := by
    intro g ε Xb hε hXb hg hz
    have hO : IsOpen (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
    have hgt : ∀ (k : ℕ) (x η : ℝ), Xb < x → -1 < η → η < 1 →
