    ContDiffOn ℝ ∞ (↿Ui) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧
    (∀ X η : ℝ, 0 ≤ X → -1 < η → η < 1 → 0 < Fi X η) ∧
    (∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿Fi) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿Ui) (X, η)‖ ≤ C)

def AxA3 (Pax : ℝ → ℝ) (Xan : ℝ) (Fi Ui : ℝ → ℝ → ℝ) : Prop :=
  ∃ ρ : ℝ, 0 < ρ ∧ ∃ Fc Uc Pc : ℕ → ℝ → ℂ → ℂ, ∀ k : ℕ, ∃ C : ℝ,
    ContinuousOn (fun p : ℝ × ℂ => Fc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ContinuousOn (fun p : ℝ × ℂ => Uc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ContinuousOn (fun p : ℝ × ℂ => Pc k p.1 p.2)
      (Icc 0 Xan ×ˢ {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ}) ∧
    ∀ X : ℝ, 0 ≤ X → X ≤ Xan →
      DifferentiableOn ℂ (Fc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      DifferentiableOn ℂ (Uc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      DifferentiableOn ℂ (Pc k X) {w : ℂ | |w.im| < ρ ∧ -1 - ρ < w.re ∧ w.re < 1 + ρ} ∧
      (∀ w : ℂ, |w.im| < ρ → -1 - ρ < w.re → w.re < 1 + ρ →
        ‖Fc k X w‖ ≤ C ∧ ‖Uc k X w‖ ≤ C ∧ ‖Pc k X w‖ ≤ C) ∧
      (∀ η : ℝ, -1 < η → η < 1 →
        Fc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Fi Y η) X : ℝ) : ℂ) ∧
        Uc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Ui Y η) X : ℝ) : ℂ) ∧
        Pc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Pax η + profRadInt (fun x e => Fi x e ^ 2) Y η) X : ℝ) : ℂ))

def AxGlue (h Pst : ℝ) (Pax : ℝ → ℝ) (ε Bd C T θ Kb Ks MP s1 s2 : ℝ) (β : Fin 2 → ℝ → ℝ)
    (γ : Fin 3 → ℝ → ℝ) (c : ℝ → Fin 5 → ℝ) (Xa Xan Xa1 Xa2 aa τ : ℝ) (ℓ G : ℝ → ℝ)
    (F U : ℝ → ℝ → ℝ) : Prop :=
  AxDatum h Pst Pax ∧ AxInner h Pax ε Bd C Xa Xan Xa1 Xa2 aa τ ℓ G F U ∧ 0 < ε ∧ ε ≤ 1 / 100 ∧
  AxBumps s1 s2 β γ ∧ (∀ i x, |β i x| ≤ Kb ∧ |x * deriv (β i) x| ≤ Kb) ∧
  (∀ j x, |γ j x| ≤ Kb ∧ |x * deriv (γ j) x| ≤ Kb) ∧
  AxCoef θ c ∧ 0 ≤ θ ∧ ε + 2 * θ * Kb ≤ 1 / 50 ∧ 3 * θ * Kb ≤ Pst / 1000 ∧
  (∀ x, |deriv Real.smoothTransition x| ≤ Ks) ∧ 40 * Ks * (|Bd| + 1) + 1 ≤ T ∧
  (∀ η : ℝ, -1 < η → η < 1 → |Pax η| ≤ MP ∧ |deriv Pax η| ≤ MP) ∧
  (Ks * ε + 2 * θ * Kb) * (200 + 4 * MP + 30 * Pst ^ 2) * 1000000 ≤ Pst ^ 2 ∧
  110 * Real.exp (1 + T) ≤ 110 * (C * Pst) ^ 10 * Real.exp (-9) ∧
  30 * (|Bd| + 2) * Real.exp (2 * |Bd| + 2 + 2 * T) * (1 + 110 * Bd ^ 2) ≤ C * ε
noncomputable def axSer (c : ℕ → ℂ) (y : ℂ) : ℂ := ∑' n : ℕ, c n * y ^ n

noncomputable def axPn (h j0 Λ C : ℝ) (χ ζ ℓ z Ξ : ℂ → ℂ) (n : ℕ) : ℂ → ℂ :=
  (axRecPV h j0 Λ χ ζ ℓ z (axGain Λ C Ξ) n).1

noncomputable def axVn (h j0 Λ C : ℝ) (χ ζ ℓ z Ξ : ℂ → ℂ) (n : ℕ) : ℂ → ℂ :=
  (axRecPV h j0 Λ χ ζ ℓ z (axGain Λ C Ξ) n).2

noncomputable def axQn (h j0 Λ C : ℝ) (χ ζ ℓ z Ξ : ℂ → ℂ) (n : ℕ) (w : ℂ) : ℂ :=
  (if n = 0 then 0 else axGain Λ C Ξ w ^ 2 *
    ∑ i ∈ Finset.range (n - 1 + 1), axPn h j0 Λ C χ ζ ℓ z Ξ i w * axPn h j0 Λ C χ ζ ℓ z Ξ (n - 1 - i) w) /
    (n : ℂ)
def AxHJetK (Xan ρ : ℝ) (φ : ℝ → ℝ → ℝ) (k : ℕ) : Prop :=
  ∃ (Φ : ℝ → ℂ → ℂ) (C : ℝ),
    ContinuousOn (fun p : ℝ × ℂ => Φ p.1 p.2) (Icc 0 Xan ×ˢ axRect ρ) ∧
    ∀ X : ℝ, 0 ≤ X → X ≤ Xan →
      DifferentiableOn ℂ (Φ X) (axRect ρ) ∧
      (∀ w ∈ axRect ρ, ‖Φ X w‖ ≤ C) ∧
      (∀ η : ℝ, -1 < η → η < 1 → Φ X (η : ℂ) = ((iteratedDeriv k (fun Y => φ Y η) X : ℝ) : ℂ))

def AxHJet (Xan ρ : ℝ) (φ : ℝ → ℝ → ℝ) : Prop :=
  (∀ η : ℝ, -1 < η → η < 1 → ∃ ε : ℝ, 0 < ε ∧ ContDiffOn ℝ ∞ (fun Y => φ Y η) (Ioo (-ε) (Xan + ε))) ∧
  ∀ k : ℕ, AxHJetK Xan ρ φ k
noncomputable def axFfModelF (Λ t1 κ0 : ℝ) (Fn : ℝ → ℝ → ℝ) (X η : ℝ) : ℝ :=
