      mul_le_mul hPr hb2 (sq_nonneg b) (by positivity)

    have nb : ∀ ni mi : ℝ, (ni - Bs * mi) ^ 2 ≤ δ ^ 2 → mi ^ 2 ≤ 4 * M ^ 2 → ni ^ 2 ≤ 9 * M ^ 4 := by
      intro ni mi hq hm
      have hBm : Bs ^ 2 * mi ^ 2 ≤ M ^ 2 * (4 * M ^ 2) := mul_le_mul hBs2 hm (sq_nonneg _) (sq_nonneg _)
      have h := two (ni - Bs * mi) (Bs * mi)
      have e : ni - Bs * mi + Bs * mi = ni := by ring
      rw [e, mul_pow] at h
      have e2 : M ^ 2 * (4 * M ^ 2) = 4 * M ^ 4 := by ring
      linarith
    have hn0' : n 0 ^ 2 ≤ 9 * M ^ 4 := nb (n 0) σ q0 hσ2
    have hn1' : n 1 ^ 2 ≤ 9 * M ^ 4 := nb (n 1) (-N2) q1 (by
      have e : (-N2) ^ 2 = N2 ^ 2 := by ring
