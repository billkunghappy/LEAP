        refine (Complex.measurable_ofReal.comp (hc.pow_const 2)).mul ?_
        exact ((Complex.measurable_ofReal.comp (hϑ.const_mul (-2))).mul_const _).cexp
      have hmeas' : ∀ w, AEStronglyMeasurable (Fc' w) volume := by
        intro w
        apply Measurable.aestronglyMeasurable
        refine (Complex.measurable_ofReal.comp (hc.pow_const 2)).mul ?_
        refine (((Complex.measurable_ofReal.comp (hϑ.const_mul (-2))).mul_const _).cexp).mul ?_
        exact (Complex.measurable_ofReal.comp (hϑ.const_mul (-2))).mul_const _
      intro w₀ hw₀
      obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hSo w₀ hw₀
      have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume)
        (F := Fc) (F' := Fc') (x₀ := w₀) (bound := fun y => 20 * c y ^ 2)
