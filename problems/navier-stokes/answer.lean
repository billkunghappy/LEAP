  have hRC' : |pcRC5 γ.1 (ξ.1, ξ.2.1, ξ.2.2.1)| ≤ M := hRC
  have k0 : |(0:ℝ)| ≤ A := by rw [abs_zero]; exact hA0
  have k01 : |-2 * pcFa5 B γ.1 (ξ.1, ξ.2.1, ξ.2.2.1)| ≤ A := by
