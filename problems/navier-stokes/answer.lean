        d 2 • EuclideanSpace.single 2 1 := by
      apply hext <;> simp
    have hGform : ∀ ψ, Gf ψ = d 0 * f 0 ψ + d 1 * f 1 ψ + d 2 * f 2 ψ -
        (thA (f 0) * d 0 + thA (f 1) * d 1 + thA (f 2) * d 2) := by
      intro ψ
      rw [hGapp, hWc ψ, inner_sub_left, hrotinner]
      have hA : (inner ℝ (thA (f 0) • EuclideanSpace.single 0 1 + thA (f 1) • EuclideanSpace.single 1 1 +
          thA (f 2) • EuclideanSpace.single 2 1 : ℝ³) d : ℝ) =
          thA (f 0) * d 0 + thA (f 1) * d 1 + thA (f 2) * d 2 := by
        rw [hinner]; simp
      have hud : (inner ℝ (uX5 B G l0 S (rotPt (rad w) ψ (w 2)) t (Yph B.h (rad w) t + Y0)) (rotZ ψ d) : ℝ) =
          d 0 * f 0 ψ + d 1 * f 1 ψ + d 2 * f 2 ψ := by
        conv_lhs => rw [hd]
        rw [hrotadd, hrotadd, hrotsmul, hrotsmul, hrotsmul, ← hfr ψ 0, ← hfr ψ 1, ← hfr ψ 2,
          inner_add_right, inner_add_right, real_inner_smul_right, real_inner_smul_right,
          real_inner_smul_right]
        simp only [hfa]
      rw [hud, hA]
    have hi : ∀ a, IntervalIntegrable (f a) MeasureTheory.volume 0 (2 * Real.pi) :=
      fun a => (hfc a).intervalIntegrable _ _
    have hGint0 : ∫ ψ in (0:ℝ)..(2 * Real.pi), Gf ψ = 0 := by
      have hGfun : Gf = fun ψ => d 0 * f 0 ψ + d 1 * f 1 ψ + d 2 * f 2 ψ -
          (thA (f 0) * d 0 + thA (f 1) * d 1 + thA (f 2) * d 2) := funext hGform
      rw [hGfun, intervalIntegral.integral_sub, intervalIntegral.integral_add, intervalIntegral.integral_add,
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const]
      · simp only [thA, smul_eq_mul, sub_zero]
        have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
        field_simp
        ring
      all_goals first
        | exact intervalIntegrable_const
        | exact (((hi 0).const_mul _).add ((hi 1).const_mul _)).add ((hi 2).const_mul _)
        | exact ((hi 0).const_mul _).add ((hi 1).const_mul _)
        | exact (hi 0).const_mul _
        | exact (hi 1).const_mul _
        | exact (hi 2).const_mul _
    have hcθ : ∀ θ, rotZ θ c = rotZ (θ + thetaOf w) d := by
      intro θ
      rw [hd_def, hrotcomp]
      congr 1
      ring
    calc ∫ θ in (0:ℝ)..(2 * Real.pi), (inner ℝ (evOff B.h W Y0 (rotZ θ w) t) (rotZ θ c) : ℝ)
        = ∫ θ in (0:ℝ)..(2 * Real.pi), Gf (θ + thetaOf w) := by
          apply intervalIntegral.integral_congr
          intro θ _
          simp only [hGapp, hrw, hcθ]
      _ = ∫ ψ in (0 + thetaOf w)..(2 * Real.pi + thetaOf w), Gf ψ :=
          intervalIntegral.integral_comp_add_right Gf (thetaOf w)
      _ = ∫ ψ in (0:ℝ)..(0 + 2 * Real.pi), Gf ψ := by
          rw [show 2 * Real.pi + thetaOf w = (0 + thetaOf w) + 2 * Real.pi by ring]
          exact hGper.intervalIntegral_add_eq (0 + thetaOf w) 0
      _ = 0 := by rw [zero_add]; exact hGint0



  have key : ∀ (t : ℝ) (Y0 : ℝ × ℝ) (y₀ : ℝ³), corrOn B l0 y₀ t → ∀ c : ℝ³,
      IntervalIntegrable (fun θ => (inner ℝ (fderiv ℝ (fun y => evOff B.h W Y0 y t) (rotZ θ y₀)
          (cyl2cart (rotZ θ y₀) (dU (ptOf (rotZ θ y₀) t (Yph B.h (rad (rotZ θ y₀)) t + Y0))))
        + fderiv ℝ (fun y => cyl2cart y (dU (ptOf y t (Yph B.h (rad y) t + Y0)))) (rotZ θ y₀)
          (evOff B.h W Y0 (rotZ θ y₀) t)) (rotZ θ c) : ℝ)) MeasureTheory.volume 0 (2 * Real.pi) ∧
      ∫ θ in (0:ℝ)..(2 * Real.pi), (inner ℝ (fderiv ℝ (fun y => evOff B.h W Y0 y t) (rotZ θ y₀)
          (cyl2cart (rotZ θ y₀) (dU (ptOf (rotZ θ y₀) t (Yph B.h (rad (rotZ θ y₀)) t + Y0))))
        + fderiv ℝ (fun y => cyl2cart y (dU (ptOf y t (Yph B.h (rad y) t + Y0)))) (rotZ θ y₀)
          (evOff B.h W Y0 (rotZ θ y₀) t)) (rotZ θ c) : ℝ) = 0 := by
    intro t Y0 y₀ hy₀ c
    have hU := hUopen t hy₀.2.1
    have hWfs' := hWfs t Y0
    have hDfs' := hDfs t Y0
    have hy : y₀ ∈ {y : ℝ³ | corrOn B l0 y t} := hy₀
    obtain ⟨c', hc'⟩ := core2 {y : ℝ³ | corrOn B l0 y t}
      (fun y => cyl2cart y (dU (ptOf y t (Yph B.h (rad y) t + Y0)))) y₀ c hU hDfs'
      (fun α w _ => hDeq t Y0 α w) (hUrot t) hy
    obtain ⟨hI1, hZ1⟩ := core1 {y : ℝ³ | corrOn B l0 y t} (fun y => evOff B.h W Y0 y t) y₀
      (cyl2cart y₀ (dU (ptOf y₀ t (Yph B.h (rad y₀) t + Y0)))) c hU (hUrot t) hWfs'
      (fun w hw => hzero t Y0 w hw c) hy
    have hg2c : Continuous (fun θ => (inner ℝ (evOff B.h W Y0 (rotZ θ y₀) t) (rotZ θ c') : ℝ)) := by
      have h1 : Continuous (fun θ => evOff B.h W Y0 (rotZ θ y₀) t) :=
        hWfs'.continuousOn.comp_continuous (hrotc y₀) (fun θ => hUrot t θ y₀ hy)
      exact h1.inner (hrotc c')
    simp only [hDeq, inner_add_left, hc']
    refine ⟨hI1.add (hg2c.intervalIntegrable _ _), ?_⟩
    rw [intervalIntegral.integral_add hI1 (hg2c.intervalIntegrable _ _), hZ1, hzero t Y0 y₀ hy₀ c', add_zero]



  intro x t Y hxt
  have hr : 0 < rad x := hxt.1
  have hy₀ : corrOn B l0 (rotPt (rad x) 0 (x 2)) t := hcirc t (rad x) (x 2) 0 hr hxt.2.1 hxt.2.2
  have hy0rot : ∀ θ, rotZ θ (rotPt (rad x) 0 (x 2)) = rotPt (rad x) θ (x 2) := by
    intro θ; rw [hrotpt, add_zero]
  have hcx : ∀ θ, crossXm B.h W D (rotPt (rad x) θ (x 2)) t Y =
      fderiv ℝ (fun y => evOff B.h W (Y - Yph B.h (rad x) t) y t) (rotPt (rad x) θ (x 2))
          (cyl2cart (rotPt (rad x) θ (x 2)) (dU (ptOf (rotPt (rad x) θ (x 2)) t
            (Yph B.h (rad (rotPt (rad x) θ (x 2))) t + (Y - Yph B.h (rad x) t)))))
        + fderiv ℝ (fun y => cyl2cart y (dU (ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t)))))
            (rotPt (rad x) θ (x 2)) (evOff B.h W (Y - Yph B.h (rad x) t) (rotPt (rad x) θ (x 2)) t) := by
    intro θ
    have hrθ : rad (rotPt (rad x) θ (x 2)) = rad x := hradpt _ _ _ hr
    have hcθ : corrOn B l0 (rotPt (rad x) θ (x 2)) t := hcirc t (rad x) (x 2) θ hr hxt.2.1 hxt.2.2
    have hUn : {y : ℝ³ | corrOn B l0 y t} ∈ nhds (rotPt (rad x) θ (x 2)) :=
      (hUopen t hxt.2.1).mem_nhds hcθ
    have hDev : (fun y => evOff B.h D (Y - Yph B.h (rad x) t) y t) =ᶠ[nhds (rotPt (rad x) θ (x 2))]
        (fun y => cyl2cart y (dU (ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t))))) :=
      Filter.eventuallyEq_of_mem hUn
        (fun y hy => hD y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t)) hy)
    have hDpt : evOff B.h D (Y - Yph B.h (rad x) t) (rotPt (rad x) θ (x 2)) t =
        cyl2cart (rotPt (rad x) θ (x 2)) (dU (ptOf (rotPt (rad x) θ (x 2)) t
          (Yph B.h (rad (rotPt (rad x) θ (x 2))) t + (Y - Yph B.h (rad x) t)))) :=
      hD _ t _ hcθ
    unfold crossXm
    rw [hrθ, hDev.fderiv_eq, hDpt, hrθ]
  have hcoef : ∀ a : Fin 3, IntervalIntegrable (fun θ => (inner ℝ (crossXm B.h W D (rotPt (rad x) θ (x 2)) t Y)
        (frameAt θ (ptOf x t Y) a) : ℝ)) MeasureTheory.volume 0 (2 * Real.pi) ∧
      ∫ θ in (0:ℝ)..(2 * Real.pi), (inner ℝ (crossXm B.h W D (rotPt (rad x) θ (x 2)) t Y)
        (frameAt θ (ptOf x t Y) a) : ℝ) = 0 := by
    intro a
    obtain ⟨hI, hZ⟩ := key t (Y - Yph B.h (rad x) t) (rotPt (rad x) 0 (x 2)) hy₀ (EuclideanSpace.single a 1)
    simp only [hy0rot] at hI hZ
    have hfr : ∀ θ, frameAt θ (ptOf x t Y) a = rotZ θ (EuclideanSpace.single a 1) :=
      fun θ => hframeAt θ _ a hr
    simp only [hcx, hfr]
    exact ⟨hI, hZ⟩
  refine ⟨?_, fun a => (hcoef a).1⟩
  have hz : ∀ a : Fin 3, ∫ θ in (0:ℝ)..(2 * Real.pi), (inner ℝ (crossXm B.h W D (rotPt (rad x) θ (x 2)) t Y)
        (frameAt θ (ptOf x t Y) a) : ℝ) = 0 := fun a => (hcoef a).2
  simp only [thAvgVec, thA, hz, mul_zero]
  simp [cyl2cart]

theorem thp_res_integrable : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState), B.ok → ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => uX5 B G l0 S p.1 p.2.1 p.2.2) {p | corrOn B l0 p.1 p.2.1} → ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => PX5 B G l0 S p.1 p.2.1 p.2.2) {p | corrOn B l0 p.1 p.2.1} → ∀ x t Y, corrOn B l0 x t → ∀ a : Fin 3, IntervalIntegrable (fun θ => inner ℝ (resX B.h (uX5 B G l0 S) (PX5 B G l0 S) (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) MeasureTheory.volume 0 (2 * Real.pi) :=
by
  intro B G l0 S hok huS hpS x t Y hxt a
  generalize uX5 B G l0 S = U at huS ⊢
  generalize PX5 B G l0 S = P at hpS ⊢

  have hNS : ∀ (ν : ℝ) (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (O : Set (ℝ³ × ℝ)), IsOpen O →
      ContDiffOn ℝ ∞ (↿u) O → ContDiffOn ℝ ∞ (↿p) O → ContDiffOn ℝ ∞ (↿(nsResidual ν u p)) O := by
    intro ν u p O hO hu hp
    have s1 : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (x : ℝ³)
        (t : ℝ), DifferentiableAt ℝ f (x, t) →
        deriv (fun s => f (x, s)) t = fderiv ℝ f (x, t) ((0 : ℝ³), (1 : ℝ)) ∧
        fderiv ℝ (fun y => f (y, t)) x =
          (fderiv ℝ f (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := by
      intro F _ _ f x t hf
      constructor
      · have hγ : HasDerivAt (fun s : ℝ => ((x, s) : ℝ³ × ℝ)) ((0 : ℝ³), (1 : ℝ)) t :=
          (hasDerivAt_const t x).prodMk (hasDerivAt_id t)
        exact (hf.hasFDerivAt.comp_hasDerivAt t hγ).deriv
      · exact (hf.hasFDerivAt.comp x (hasFDerivAt_prodMk_left x t)).fderiv
    have s2 : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (x : ℝ³)
        (t : ℝ), ContDiffOn ℝ ∞ f O → (x, t) ∈ O → ∀ a b : ℝ³,
        fderiv ℝ (fderiv ℝ (fun y => f (y, t))) x a b =
          fderiv ℝ (fderiv ℝ f) (x, t) (a, (0 : ℝ)) (b, (0 : ℝ)) := by
      intro F _ _ f x t hf hxt a b
      have hemb : Continuous (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) :=
        continuous_id.prodMk continuous_const
      have hN : {y : ℝ³ | (y, t) ∈ O} ∈ nhds x := (hO.preimage hemb).mem_nhds hxt
      let Φ : (ℝ³ × ℝ →L[ℝ] F) →L[ℝ] (ℝ³ →L[ℝ] F) :=
        (ContinuousLinearMap.compL ℝ ℝ³ (ℝ³ × ℝ) F).flip (ContinuousLinearMap.inl ℝ ℝ³ ℝ)
      have hΦ : ∀ M, Φ M = M.comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := fun M => rfl
      have hev : fderiv ℝ (fun y => f (y, t)) =ᶠ[nhds x] fun y => Φ (fderiv ℝ f (y, t)) := by
        filter_upwards [hN] with y hy
        have hd : DifferentiableAt ℝ f (y, t) :=
          (hf.contDiffAt (hO.mem_nhds hy)).differentiableAt (by simp)
        rw [hΦ]
        exact (s1 f y t hd).2
      have hDf : ContDiffOn ℝ ∞ (fderiv ℝ f) O :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hf).2
      have hD2 : HasFDerivAt (fderiv ℝ f) (fderiv ℝ (fderiv ℝ f) (x, t)) (x, t) :=
        ((hDf.contDiffAt (hO.mem_nhds hxt)).differentiableAt (by simp)).hasFDerivAt
      have hg : HasFDerivAt (fun y => Φ (fderiv ℝ f (y, t)))
          (Φ.comp ((fderiv ℝ (fderiv ℝ f) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ))) x :=
        Φ.hasFDerivAt.comp x (hD2.comp x (hasFDerivAt_prodMk_left x t))
      rw [hev.fderiv_eq, hg.fderiv]
      rfl
    have s3 : ∀ (g : ℝ³ → ℝ) (x : ℝ³), gradient g x = ∑ i : Fin 3,
        fderiv ℝ g x (EuclideanSpace.single i (1 : ℝ)) • EuclideanSpace.single i (1 : ℝ) := by
      intro g x
      have h := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr' (gradient g x)
      rw [← h]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [EuclideanSpace.basisFun_apply]
      congr 1
      rw [real_inner_comm]
      exact InnerProductSpace.toDual_symm_apply
    have s4 : ∀ (g : ℝ³ → ℝ³) (x : ℝ³), Δ g x = ∑ i : Fin 3,
        fderiv ℝ (fderiv ℝ g) x (EuclideanSpace.single i (1 : ℝ)) (EuclideanSpace.single i (1 : ℝ)) := by
      intro g x
      have h := congrFun (InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis g
        (EuclideanSpace.basisFun (Fin 3) ℝ)) x
      rw [h]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [iteratedFDeriv_two_apply]
      simp [EuclideanSpace.basisFun_apply]
    have hDu : ContDiffOn ℝ ∞ (fderiv ℝ (↿u)) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hu).2
    have hD2u : ContDiffOn ℝ ∞ (fderiv ℝ (fderiv ℝ (↿u))) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hDu).2
    have hDp : ContDiffOn ℝ ∞ (fderiv ℝ (↿p)) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hp).2
    have hT3 : ContDiffOn ℝ ∞ (fun z => ∑ i : Fin 3, fderiv ℝ (fderiv ℝ (↿u)) z
        (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) (EuclideanSpace.single i (1 : ℝ), (0 : ℝ))) O :=
      ContDiffOn.sum fun i _ => (hD2u.clm_apply contDiffOn_const).clm_apply contDiffOn_const
    have hT4 : ContDiffOn ℝ ∞ (fun z => ∑ i : Fin 3, fderiv ℝ (↿p) z
        (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) • EuclideanSpace.single i (1 : ℝ)) O :=
      ContDiffOn.sum fun i _ => (hDp.clm_apply contDiffOn_const).smul contDiffOn_const
    have hJ : ContDiffOn ℝ ∞ (nsJet ν u p) O := by
      unfold nsJet
      exact (((hDu.clm_apply contDiffOn_const).add
        (hDu.clm_apply (hu.prodMk contDiffOn_const))).sub (hT3.const_smul ν)).add hT4
    have hid : ∀ z ∈ O, (↿(nsResidual ν u p)) z = nsJet ν u p z := by
      rintro ⟨x, t⟩ hz
      have hu' : DifferentiableAt ℝ (↿u) (x, t) :=
        (hu.contDiffAt (hO.mem_nhds hz)).differentiableAt (by simp)
      have hp' : DifferentiableAt ℝ (↿p) (x, t) :=
        (hp.contDiffAt (hO.mem_nhds hz)).differentiableAt (by simp)
      have e1 : deriv (fun s => u x s) t = fderiv ℝ (↿u) (x, t) ((0 : ℝ³), (1 : ℝ)) :=
        (s1 (↿u) x t hu').1
      have e2 : fderiv ℝ (fun y => u y t) x (u x t) =
          fderiv ℝ (↿u) (x, t) ((↿u) (x, t), (0 : ℝ)) := by
        have h2 : fderiv ℝ (fun y => u y t) x =
            (fderiv ℝ (↿u) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := (s1 (↿u) x t hu').2
        rw [h2]
        rfl
      have e3 : Δ (fun y => u y t) x = ∑ i : Fin 3, fderiv ℝ (fderiv ℝ (↿u)) (x, t)
          (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) := by
        rw [s4]
        exact Finset.sum_congr rfl (fun i _ => s2 (↿u) x t hu hz _ _)
      have e4 : gradient (fun y => p y t) x = ∑ i : Fin 3, fderiv ℝ (↿p) (x, t)
          (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) • EuclideanSpace.single i (1 : ℝ) := by
        have h2 : fderiv ℝ (fun y => p y t) x =
            (fderiv ℝ (↿p) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := (s1 (↿p) x t hp').2
        rw [s3, h2]
        rfl
      show nsResidual ν u p x t = nsJet ν u p (x, t)
      rw [nsResidual, e1, e2, e3, e4]
      rfl
    exact hJ.congr hid

  have hσ : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) := hok.1.2.2.2.1
  have hcc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun x : ℝ³ => x i) := fun i => contDiff_piLp_apply 2
  have hC3 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    have hg : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
      ((hcc 2).comp contDiff_fst).prodMk (contDiff_const.sub contDiff_snd)
    have hmaps : MapsTo (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) {w : ℝ³ × ℝ | w.2 < 1}
        (univ ×ˢ Ioi 0) := by
      intro w hw
      have hw' : w.2 < 1 := hw
      exact ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by linarith⟩
    exact hσ.comp hg.contDiffOn hmaps
  have hf : ContDiff ℝ ∞ (fun x : ℝ³ => x 0 ^ 2 + x 1 ^ 2) := ((hcc 0).pow 2).add ((hcc 1).pow 2)
  have hC4 : ContDiffOn ℝ ∞ rad {x : ℝ³ | 0 < rad x} := by
    have h := hf.contDiffOn.sqrt (s := {x : ℝ³ | 0 < rad x}) (fun x hx => by
      have hx' : 0 < Real.sqrt (x 0 ^ 2 + x 1 ^ 2) := hx
      exact (Real.sqrt_pos.mp hx').ne')
    exact h
  have hradc : Continuous (fun w : ℝ³ × ℝ => rad w.1) :=
    Real.continuous_sqrt.comp (hf.continuous.comp continuous_fst)
  have hC1 : IsOpen {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} := by
    have h1 : IsOpen {w : ℝ³ × ℝ | 0 < rad w.1} := isOpen_lt continuous_const hradc
    have h2 : IsOpen ({w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0)) :=
      hC3.continuousOn.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
    have e : {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} = {w : ℝ³ × ℝ | 0 < rad w.1} ∩
        ({w : ℝ³ × ℝ | w.2 < 1} ∩
          (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0)) := by
      ext w; rfl
    rw [e]; exact h1.inter h2
  have hmapsR : MapsTo (fun w : ℝ³ × ℝ => w.1) {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2}
      {x : ℝ³ | 0 < rad x} := fun w hw => hw.1
  have c1 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => rad w.1) {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} :=
    hC4.comp contDiff_fst.contDiffOn hmapsR
  have c3 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => w.2) {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} :=
    contDiff_snd.contDiffOn

  obtain ⟨Y0, hY0⟩ : ∃ Y0 : ℝ × ℝ, Y0 = Y - Yph B.h (rad x) t := ⟨_, rfl⟩
  have c4 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => Yph B.h (rad w.1) w.2 + Y0)
      {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} := by
    have hp := c1.rpow_const_of_ne (p := drx B.h) (fun w hw => ne_of_gt hw.1)
    exact ((hp.smul contDiffOn_const).add (c3.smul contDiffOn_const)).add contDiffOn_const
  have hψ : ContDiffOn ℝ ∞
      (fun w : ℝ³ × ℝ => ((w.1, w.2, Yph B.h (rad w.1) w.2 + Y0) : ℝ³ × ℝ × (ℝ × ℝ)))
      {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} :=
    contDiffOn_fst.prodMk (contDiffOn_snd.prodMk c4)
  have hmaps : MapsTo
      (fun w : ℝ³ × ℝ => ((w.1, w.2, Yph B.h (rad w.1) w.2 + Y0) : ℝ³ × ℝ × (ℝ × ℝ)))
      {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} {p : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 p.1 p.2.1} :=
    fun w hw => hw
  have hu : ContDiffOn ℝ ∞ (↿(evOff B.h U Y0)) {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} :=
    huS.comp hψ hmaps
  have hp : ContDiffOn ℝ ∞ (↿(evOff B.h P Y0)) {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} :=
    hpS.comp hψ hmaps
  have hN := (hNS 1 _ _ _ hC1 hu hp).continuousOn

  have hcontC : ContinuousOn (fun y => resX B.h U P y t Y)
      {y : ℝ³ | corrOn B l0 y t ∧ rad y = rad x} := by
    have hEq : ∀ y ∈ {y : ℝ³ | corrOn B l0 y t ∧ rad y = rad x},
        resX B.h U P y t Y = nsResidual 1 (evOff B.h U Y0) (evOff B.h P Y0) y t := by
      intro y hy
      show nsResidual 1 (evOff B.h U (Y - Yph B.h (rad y) t))
        (evOff B.h P (Y - Yph B.h (rad y) t)) y t = _
      rw [hy.2, ← hY0]
    generalize nsResidual 1 (evOff B.h U Y0) (evOff B.h P Y0) = R at hN hEq
    have h1 : ContinuousOn (fun y => R y t) {y : ℝ³ | corrOn B l0 y t ∧ rad y = rad x} :=
      hN.comp (continuous_id.prodMk continuous_const).continuousOn (fun y hy => hy.1)
    exact h1.congr hEq

  have hr : 0 < rad x := hxt.1
  have e0 : ∀ θ : ℝ, (rotPt (rad x) θ (x 2)) 0 = rad x * Real.cos θ := fun θ => by simp [rotPt]
  have e1 : ∀ θ : ℝ, (rotPt (rad x) θ (x 2)) 1 = rad x * Real.sin θ := fun θ => by simp [rotPt]
  have e2 : ∀ θ : ℝ, (rotPt (rad x) θ (x 2)) 2 = x 2 := fun θ => by simp [rotPt]
  have hrad : ∀ θ : ℝ, rad (rotPt (rad x) θ (x 2)) = rad x := by
    intro θ
    have hsq : (rad x * Real.cos θ) ^ 2 + (rad x * Real.sin θ) ^ 2 = rad x ^ 2 := by
      have hcs := Real.cos_sq_add_sin_sq θ
      calc (rad x * Real.cos θ) ^ 2 + (rad x * Real.sin θ) ^ 2
          = rad x ^ 2 * (Real.cos θ ^ 2 + Real.sin θ ^ 2) := by ring
        _ = rad x ^ 2 := by rw [hcs, mul_one]
    rw [show rad (rotPt (rad x) θ (x 2)) =
        Real.sqrt ((rotPt (rad x) θ (x 2)) 0 ^ 2 + (rotPt (rad x) θ (x 2)) 1 ^ 2) from rfl, e0, e1, hsq,
      Real.sqrt_sq hr.le]
  have hmem : ∀ θ : ℝ, rotPt (rad x) θ (x 2) ∈ {y : ℝ³ | corrOn B l0 y t ∧ rad y = rad x} := by
    intro θ
    refine ⟨⟨?_, hxt.2.1, ?_⟩, hrad θ⟩
    · rw [hrad θ]; exact hr
    · have h3 : simScale B.h (x 2) (1 - t) < qsOf l0 := hxt.2.2
      rw [e2 θ]; exact h3

  apply Continuous.intervalIntegrable
  have hc : Continuous (fun θ : ℝ => rotPt (rad x) θ (x 2)) := by
    unfold rotPt
    fun_prop
  have hφ : Continuous (fun θ => resX B.h U P (rotPt (rad x) θ (x 2)) t Y) :=
    hcontC.comp_continuous hc hmem
  have hR : Continuous (fun θ : ℝ => eR (rotPt (rad x) θ (x 2))) := by
    have e : (fun θ : ℝ => eR (rotPt (rad x) θ (x 2))) = fun θ : ℝ =>
        (rad x)⁻¹ • ((rad x * Real.cos θ) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
          (rad x * Real.sin θ) • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) := by
      funext θ
      rw [eR, hrad θ, radVec, e0, e1]
    rw [e]
    fun_prop
  have hT : Continuous (fun θ : ℝ => eTh (rotPt (rad x) θ (x 2))) := by
    have e : (fun θ : ℝ => eTh (rotPt (rad x) θ (x 2))) = fun θ : ℝ =>
        (rad x)⁻¹ • (-(rad x * Real.sin θ) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
          (rad x * Real.cos θ) • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) := by
      funext θ
      rw [eTh, hrad θ, azVec, e0, e1]
    rw [e]
    fun_prop
  have hframe : Continuous (fun θ => frameAt θ (ptOf x t Y) a) := by
    fin_cases a
    · exact hR
    · exact hT
    · exact continuous_const
  exact hφ.inner hframe

theorem mwh5_theta_projection : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S S' : CState) (Pi : Cyl → ℝ) (dU : Cyl → Fin 3 → ℝ) (W D : Ext ℝ³), B.ok → ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => uX5 B G l0 S p.1 p.2.1 p.2.2) {p | corrOn B l0 p.1 p.2.1} → ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => PX5 B G l0 S p.1 p.2.1 p.2.2) {p | corrOn B l0 p.1 p.2.1} → ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => W p.1 p.2.1 p.2.2) {p | corrOn B l0 p.1 p.2.1} → ContDiffOn ℝ ∞ dU (DomC B.h (qsOf l0)) → ContDiffOn ℝ ∞ Pi (DomC B.h (qsOf l0)) → (∀ x t Y, corrOn B l0 x t → D x t Y = cyl2cart x (dU (ptOf x t Y))) → (∀ x t Y, corrOn B l0 x t → wX5 B G l0 S x t Y = W x t Y) → (∀ (Y₀ : ℝ × ℝ) (x : ℝ³) (t : ℝ), corrOn B l0 x t → evOff B.h (uX5 B G l0 S') Y₀ x t = evOff B.h (uX5 B G l0 S) Y₀ x t + evOff B.h D Y₀ x t ∧ evOff B.h (PX5 B G l0 S') Y₀ x t = evOff B.h (PX5 B G l0 S) Y₀ x t + Pi (ptOf x t (Yph B.h (rad x) t + Y₀))) → ∀ x t Y, corrOn B l0 x t → resX B.h (uX5 B G l0 S') (PX5 B G l0 S') x t Y - thAvgVec (resX B.h (uX5 B G l0 S') (PX5 B G l0 S')) x t Y = (resX B.h (uX5 B G l0 S) (PX5 B G l0 S) x t Y - thAvgVec (resX B.h (uX5 B G l0 S) (PX5 B G l0 S)) x t Y) + crossXm B.h W D x t Y :=
by
  intro B G l0 S S' Pi dU W D hB huS hpS hW' hdU hPi hD hw hinc x t Y hxt
  have hr : 0 < rad x := hxt.1
  obtain ⟨c0, c1, c2, hcirc, hx⟩ :=
    thp_equiv_split B G l0 S S' Pi dU W D hB huS hpS hW' hdU hPi hD hw hinc x t Y hxt
  set E : Ext ℝ³ := fun y _ _ => c0 • eR y + c1 • eTh y + c2 • eZ with hEdef
  set Z : Ext ℝ³ := fun _ _ _ => (0 : ℝ³) with hZdef
  obtain ⟨hE, hEi⟩ := pws_frame_avg E x t Y c0 c1 c2 hr (fun θ => rfl)
  obtain ⟨hC0, hCi⟩ := thp_cross_avg_zero B G l0 S dU W D hB huS hW' hdU hD hw x t Y hxt
  have hRi := thp_res_integrable B G l0 S hB huS hpS x t Y hxt
  have hZi : ∀ a : Fin 3, IntervalIntegrable
      (fun θ => inner ℝ (Z (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a))
      MeasureTheory.volume 0 (2 * Real.pi) := by
    intro a
    simp only [hZdef, inner_zero_left]
    exact intervalIntegrable_const
  have hZ : thAvgVec Z x t Y = 0 := by
    simp [thAvgVec, thA, cyl2cart, hZdef]
  have hadd := pws_avg_add5 (resX B.h (uX5 B G l0 S') (PX5 B G l0 S'))
    (resX B.h (uX5 B G l0 S) (PX5 B G l0 S)) E (crossXm B.h W D) Z Z x t Y
    (fun θ => by rw [hcirc θ]; simp only [hEdef, hZdef, add_zero]) hRi hEi hCi hZi hZi
  rw [hadd, hE, hC0, hZ, hx]
  abel

theorem twg5_mode_cross_formula : ∀ (h t : ℝ) (Y0 : ℝ × ℝ) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (d : Cyl → (Fin 3 → ℝ)) (x : ℝ³), 0 < rad x → DifferentiableAt ℝ c (ptOf x t (Yph h (rad x) t + Y0)) → DifferentiableAt ℝ d (ptOf x t (Yph h (rad x) t + Y0)) → DifferentiableAt ℝ (fun y : ℝ³ => cyl2cart y (fun i => (c (ptOf y t (Yph h (rad y) t + Y0)) i * Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re)) x ∧ DifferentiableAt ℝ (fun y : ℝ³ => cyl2cart y (d (ptOf y t (Yph h (rad y) t + Y0)))) x ∧ fderiv ℝ (fun y : ℝ³ => cyl2cart y (fun i => (c (ptOf y t (Yph h (rad y) t + Y0)) i * Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re)) x (cyl2cart x (d (ptOf x t (Yph h (rad x) t + Y0)))) + fderiv ℝ (fun y : ℝ³ => cyl2cart y (d (ptOf y t (Yph h (rad y) t + Y0)))) x (cyl2cart x (fun i => (c (ptOf x t (Yph h (rad x) t + Y0)) i * Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re)) = cyl2cart x (fun i => (mcK5 h c d n (ptOf x t (Yph h (rad x) t + Y0)) i * Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re) :=
by
  intro h t Y0 n c d x hr hc hd
  have hcoord : ∀ (i : Fin 3) (y : ℝ³), DifferentiableAt ℝ (fun w : ℝ³ => w i) y := by
    intro i y
    have h0 : DifferentiableAt ℝ (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) i) y :=
      ContinuousLinearMap.differentiableAt _
    rwa [EuclideanSpace.coe_proj] at h0
  have hradpos : 0 < x 0 ^ 2 + x 1 ^ 2 := Real.sqrt_pos.mp hr
  have hr0 : rad x ≠ 0 := hr.ne'
  have hradD : DifferentiableAt ℝ rad x := by
    have h1 : DifferentiableAt ℝ (fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2) x :=
      ((hcoord 0 x).pow 2).add ((hcoord 1 x).pow 2)
    exact h1.sqrt hradpos.ne'
  have hinv : DifferentiableAt ℝ (fun y : ℝ³ => (rad y)⁻¹) x := hradD.inv hr.ne'
  have hP : DifferentiableAt ℝ (fun y : ℝ³ => ptOf y t (Yph h (rad y) t + Y0)) x := by
    have h4 : DifferentiableAt ℝ (fun y : ℝ³ => Yph h (rad y) t + Y0) x := by
      have h5 := ((hradD.rpow_const (p := drx h) (Or.inl hr.ne')).smul_const vrv).add_const (t • vtv)
      exact h5.add_const Y0
    exact hradD.prodMk ((hcoord 2 x).prodMk ((differentiableAt_const t).prodMk h4))
  have hnormAll : ∀ y : ℝ³, ‖(⟨y 0, y 1⟩ : ℂ)‖ = rad y := by
    intro y
    rw [Complex.norm_eq_sqrt_sq_add_sq]
    rfl
  have hE : DifferentiableAt ℝ
      (fun y : ℝ³ => Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))) x := by
    obtain ⟨g, hg⟩ : ∃ g : ℝ³ → ℂ, g = fun y => ((rad y)⁻¹ : ℝ) • (⟨y 0, y 1⟩ : ℂ) := ⟨_, rfl⟩
    have hz : DifferentiableAt ℝ (fun y : ℝ³ => (⟨y 0, y 1⟩ : ℂ)) x := by
      have e1 : (fun y : ℝ³ => (⟨y 0, y 1⟩ : ℂ)) =
          fun y => Complex.ofRealCLM (y 0) + Complex.ofRealCLM (y 1) * Complex.I := by
        funext y
        rw [Complex.mk_eq_add_mul_I]
        simp
      rw [e1]
      exact (Complex.ofRealCLM.differentiableAt.comp x (hcoord 0 x)).add
        ((Complex.ofRealCLM.differentiableAt.comp x (hcoord 1 x)).mul_const Complex.I)
    have hgD : DifferentiableAt ℝ g x := by
      rw [hg]
      exact hinv.smul hz
    have hgx : g x ≠ 0 := by
      rw [hg]
      refine smul_ne_zero (inv_ne_zero hr.ne') ?_
      intro h0
      have h1 := hnormAll x
      rw [h0, norm_zero] at h1
      linarith
    have hpow : DifferentiableAt ℂ (fun u : ℂ => u ^ n) (g x) :=
      differentiableAt_zpow.mpr (Or.inl hgx)
    have hG : DifferentiableAt ℝ (fun y => g y ^ n) x := (hpow.restrictScalars ℝ).comp x hgD
    refine hG.congr_of_eventuallyEq ?_
    filter_upwards [hradD.continuousAt (Ioi_mem_nhds hr)] with y hy
    have hy' : 0 < rad y := hy
    have hne : ((rad y : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hy'.ne'
    have key := Complex.norm_mul_exp_arg_mul_I (⟨y 0, y 1⟩ : ℂ)
    rw [hnormAll y] at key
    have hexp : Complex.exp (((thetaOf y : ℝ) : ℂ) * Complex.I) = g y := by
      rw [hg]
      show _ = ((rad y)⁻¹ : ℝ) • (⟨y 0, y 1⟩ : ℂ)
      rw [Complex.real_smul, Complex.ofReal_inv, eq_inv_mul_iff_mul_eq₀ hne]
      exact key
    calc Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))
        = Complex.exp ((n : ℂ) * ((thetaOf y : ℂ) * Complex.I)) := by
          congr 1
          ring
      _ = Complex.exp ((thetaOf y : ℂ) * Complex.I) ^ n := Complex.exp_int_mul _ _
      _ = g y ^ n := by rw [hexp]
  have heR : DifferentiableAt ℝ eR x := by
    have h1 : DifferentiableAt ℝ radVec x :=
      ((hcoord 0 x).smul_const _).add ((hcoord 1 x).smul_const _)
    exact hinv.smul h1
  have heTh : DifferentiableAt ℝ eTh x := by
    have h1 : DifferentiableAt ℝ azVec x :=
      ((hcoord 1 x).neg.smul_const _).add ((hcoord 0 x).smul_const _)
    exact hinv.smul h1
  have hcP : DifferentiableAt ℝ (fun y : ℝ³ => c (ptOf y t (Yph h (rad y) t + Y0))) x := hc.comp x hP
  have hdP : DifferentiableAt ℝ (fun y : ℝ³ => d (ptOf y t (Yph h (rad y) t + Y0))) x := hd.comp x hP
  have hvF : ∀ i : Fin 3, DifferentiableAt ℝ (fun y : ℝ³ =>
      (c (ptOf y t (Yph h (rad y) t + Y0)) i *
        Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re) x := by
    intro i
    have h1 : DifferentiableAt ℝ (fun y : ℝ³ => c (ptOf y t (Yph h (rad y) t + Y0)) i) x :=
      differentiableAt_pi.1 hcP i
    exact Complex.reCLM.differentiableAt.comp x (h1.mul hE)
  have hvD : ∀ i : Fin 3, DifferentiableAt ℝ (fun y : ℝ³ => d (ptOf y t (Yph h (rad y) t + Y0)) i) x :=
    fun i => differentiableAt_pi.1 hdP i
  have hFd : DifferentiableAt ℝ (fun y : ℝ³ => cyl2cart y (fun i =>
      (c (ptOf y t (Yph h (rad y) t + Y0)) i *
        Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re)) x :=
    (((hvF 0).smul heR).add ((hvF 1).smul heTh)).add ((hvF 2).smul_const eZ)
  have hDd : DifferentiableAt ℝ (fun y : ℝ³ => cyl2cart y (d (ptOf y t (Yph h (rad y) t + Y0)))) x :=
    (((hvD 0).smul heR).add ((hvD 1).smul heTh)).add ((hvD 2).smul_const eZ)
  have hrhsAll : ∀ (y : ℝ³) (w : Fin 3 → ℝ),
      cyl2cart y w 0 = w 0 * ((rad y)⁻¹ * y 0) - w 1 * ((rad y)⁻¹ * y 1) ∧
      cyl2cart y w 1 = w 0 * ((rad y)⁻¹ * y 1) + w 1 * ((rad y)⁻¹ * y 0) ∧ cyl2cart y w 2 = w 2 := by
    intro y w
    refine ⟨?_, ?_, ?_⟩ <;> simp [cyl2cart, eR, eTh, eZ, radVec, azVec] <;> ring
  have hx01 : x 0 ^ 2 + x 1 ^ 2 = rad x ^ 2 :=
    (Real.sq_sqrt (by positivity : (0:ℝ) ≤ x 0 ^ 2 + x 1 ^ 2)).symm
  have hq : (rad x)⁻¹ * rad x = 1 := inv_mul_cancel₀ hr0
  obtain ⟨L, hL⟩ : ∃ L : (Fin 3 → ℝ) → ℝ → ℝ³, ∀ w s, L w s = x + s • cyl2cart x w :=
    ⟨fun w s => x + s • cyl2cart x w, fun _ _ => rfl⟩
  have hL0 : ∀ w, L w 0 = x := by intro w; rw [hL]; simp
  have hLk : ∀ w s (k : Fin 3), L w s k = x k + s * cyl2cart x w k := by
    intro w s k; rw [hL]; simp
  have hLd' : ∀ w (k : Fin 3), HasDerivAt (fun s => L w s k) (cyl2cart x w k) 0 := by
    intro w k
    have e1 : (fun s => L w s k) = fun s => x k + s * cyl2cart x w k := funext fun s => hLk w s k
    rw [e1]
    exact (((hasDerivAt_id' (0:ℝ)).mul_const _).const_add _).congr_deriv (one_mul _)
  have hv0 : ∀ w, cyl2cart x w 0 = w 0 * ((rad x)⁻¹ * x 0) - w 1 * ((rad x)⁻¹ * x 1) :=
    fun w => (hrhsAll x w).1
  have hv1 : ∀ w, cyl2cart x w 1 = w 0 * ((rad x)⁻¹ * x 1) + w 1 * ((rad x)⁻¹ * x 0) :=
    fun w => (hrhsAll x w).2.1
  have hv2 : ∀ w, cyl2cart x w 2 = w 2 := fun w => (hrhsAll x w).2.2
  have hne : ∀ w, rad (L w 0) ≠ 0 := by intro w; rw [hL0]; exact hr0
  have hρ : ∀ w, HasDerivAt (fun s => rad (L w s)) (w 0) 0 := by
    intro w
    have h1 := (((hLd' w 0).mul (hLd' w 0)).add ((hLd' w 1).mul (hLd' w 1))).sqrt
      (by simp only [Pi.add_apply, Pi.mul_apply, hL0]; rw [← pow_two, ← pow_two]; exact hradpos.ne')
    have e1 : (fun s => rad (L w s)) =
        fun s => Real.sqrt (L w s 0 * L w s 0 + L w s 1 * L w s 1) := by
      funext s; simp only [rad, pow_two]
    rw [e1]
    refine h1.congr_deriv ?_
    simp only [Pi.add_apply, Pi.mul_apply, hL0, hv0 w, hv1 w]
    rw [show Real.sqrt (x 0 * x 0 + x 1 * x 1) = rad x by simp only [rad, pow_two]]
    rw [div_eq_iff (mul_pos two_pos hr).ne']
    linear_combination (2 * w 0 * (rad x)⁻¹) * hx01 + (2 * w 0 * rad x) * hq
  have ha : ∀ w, HasDerivAt (fun s => (rad (L w s))⁻¹ * L w s 0) (-(w 1) * x 1 / rad x ^ 2) 0 := by
    intro w
    refine (((hρ w).inv (hne w)).mul (hLd' w 0)).congr_deriv ?_
    simp only [Pi.inv_apply, hL0, hv0 w]
    field_simp
    ring
  have hb : ∀ w, HasDerivAt (fun s => (rad (L w s))⁻¹ * L w s 1) (w 1 * x 0 / rad x ^ 2) 0 := by
    intro w
    refine (((hρ w).inv (hne w)).mul (hLd' w 1)).congr_deriv ?_
    simp only [Pi.inv_apply, hL0, hv1 w]
    field_simp
    ring
  have hPth : ∀ w, HasDerivAt (fun s => ptOf (L w s) t (Yph h (rad (L w s)) t + Y0))
      (w 0 • ((1:ℝ), (0:ℝ), (0:ℝ), (drx h * rad x ^ (drx h - 1)) • vrv) +
        w 2 • ((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ))) 0 := by
    intro w
    have hY := ((((hρ w).rpow_const (p := drx h) (Or.inl (hne w))).smul_const vrv).add_const
      (t • vtv)).add_const Y0
    have h3 := (hρ w).prodMk ((hLd' w 2).prodMk ((hasDerivAt_const (0:ℝ) t).prodMk hY))
    refine h3.congr_deriv ?_
    simp only [hL0, hv2 w]
    refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_)) <;> simp [smul_smul, mul_assoc]
  have hpath : ∀ (w : Fin 3 → ℝ) {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V),
      DifferentiableAt ℝ f (ptOf x t (Yph h (rad x) t + Y0)) →
      HasDerivAt (fun s => f (ptOf (L w s) t (Yph h (rad (L w s)) t + Y0)))
        (w 0 • dR h f (ptOf x t (Yph h (rad x) t + Y0)) + w 2 • dZ f (ptOf x t (Yph h (rad x) t + Y0))) 0 := by
    intro w V _ _ f hf
    have h4 := hf.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) (hPth w) (by simp only [hL0])
    rw [map_add, map_smul, map_smul] at h4
    exact h4
  have hΦ : ∀ w : Fin 3 → ℝ, HasDerivAt (fun s => Complex.exp (Complex.I * (n : ℂ) * (thetaOf (L w s) : ℂ)))
      (Complex.I * (n : ℂ) * ((w 1 / rad x : ℝ) : ℂ) * Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))) 0 := by
    intro w
    obtain ⟨u, hu⟩ : ∃ u : ℝ → ℂ, u = fun s => (((rad (L w s))⁻¹ : ℝ) : ℂ) *
        (((L w s 0 : ℝ) : ℂ) + ((L w s 1 : ℝ) : ℂ) * Complex.I) := ⟨_, rfl⟩
    have hexpG : ∀ s, 0 < rad (L w s) →
        Complex.exp (((thetaOf (L w s) : ℝ) : ℂ) * Complex.I) = u s := by
      intro s hs
      have hne' : ((rad (L w s) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hs.ne'
      have key := Complex.norm_mul_exp_arg_mul_I (⟨L w s 0, L w s 1⟩ : ℂ)
      rw [hnormAll (L w s)] at key
      rw [hu]
      show _ = (((rad (L w s))⁻¹ : ℝ) : ℂ) * (((L w s 0 : ℝ) : ℂ) + ((L w s 1 : ℝ) : ℂ) * Complex.I)
      rw [← Complex.mk_eq_add_mul_I, Complex.ofReal_inv, eq_inv_mul_iff_mul_eq₀ hne']
      exact key
    have hevG : ∀ s, 0 < rad (L w s) →
        Complex.exp (Complex.I * (n : ℂ) * (thetaOf (L w s) : ℂ)) = u s ^ n := by
      intro s hs
      calc Complex.exp (Complex.I * (n : ℂ) * (thetaOf (L w s) : ℂ))
          = Complex.exp ((n : ℂ) * ((thetaOf (L w s) : ℂ) * Complex.I)) := by congr 1; ring
        _ = Complex.exp ((thetaOf (L w s) : ℂ) * Complex.I) ^ n := Complex.exp_int_mul _ _
        _ = u s ^ n := by rw [hexpG s hs]
    have h0pos : 0 < rad (L w 0) := by rw [hL0]; exact hr
    have hu0E : u 0 ^ n = Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ)) := by
      rw [← hevG 0 h0pos, hL0]
    have hu0 : u 0 ≠ 0 := by rw [← hexpG 0 h0pos]; exact Complex.exp_ne_zero _
    have hu0v : u 0 = (((rad x)⁻¹ : ℝ) : ℂ) * (((x 0 : ℝ) : ℂ) + ((x 1 : ℝ) : ℂ) * Complex.I) := by
      rw [hu]; simp only [hL0]
    have hud : HasDerivAt u (Complex.I * ((w 1 / rad x : ℝ) : ℂ) * u 0) 0 := by
      rw [hu0v, hu]
      refine ((((hρ w).inv (hne w)).ofReal_comp).mul (((hLd' w 0).ofReal_comp).add
        (((hLd' w 1).ofReal_comp).mul_const Complex.I))).congr_deriv ?_
      simp only [Pi.inv_apply, Pi.add_apply, hL0, hv0 w, hv1 w]
      push_cast
      linear_combination (-((w 1 : ℂ) * (x 1 : ℂ) * ((rad x : ℂ))⁻¹ ^ 2)) * Complex.I_sq
    have h1 := (hasDerivAt_zpow n (u 0) (Or.inl hu0)).comp (0:ℝ) hud
    have h2 : HasDerivAt (fun s => u s ^ n) (Complex.I * (n : ℂ) * ((w 1 / rad x : ℝ) : ℂ) *
        Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))) 0 := by
      refine h1.congr_deriv ?_
      rw [← hu0E, zpow_sub_one₀ hu0]
      linear_combination (Complex.I * (n : ℂ) * ((w 1 / rad x : ℝ) : ℂ) * u 0 ^ n) * inv_mul_cancel₀ hu0
    refine h2.congr_of_eventuallyEq ?_
    filter_upwards [(hρ w).continuousAt (Ioi_mem_nhds h0pos)] with s hs
    exact hevG s hs
  have hgen : ∀ (g : ℝ³ → Fin 3 → ℝ) (w g' : Fin 3 → ℝ),
      DifferentiableAt ℝ (fun y => cyl2cart y (g y)) x →
      (∀ i, HasDerivAt (fun s => g (L w s) i) (g' i) 0) →
      fderiv ℝ (fun y => cyl2cart y (g y)) x (cyl2cart x w) =
        cyl2cart x (fun i => g' i + w 1 / rad x * ![-(g x 1), g x 0, 0] i) := by
    intro g w g' hMd hg
    have hLl : HasDerivAt (L w) (cyl2cart x w) 0 := by
      have e : L w = fun s => x + s • cyl2cart x w := funext (hL w)
      rw [e]
      exact (((hasDerivAt_id' (0:ℝ)).smul_const (cyl2cart x w)).const_add x).congr_deriv (one_smul ℝ _)
    have hlineF := hMd.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hLl (hL0 w).symm
    have hline : ∀ k : Fin 3, HasDerivAt (fun s => cyl2cart (L w s) (g (L w s)) k)
        (fderiv ℝ (fun y => cyl2cart y (g y)) x (cyl2cart x w) k) 0 := fun k =>
      (EuclideanSpace.proj k : ℝ³ →L[ℝ] ℝ).hasFDerivAt.comp_hasDerivAt (0:ℝ) hlineF
    have e0 : (fun s => cyl2cart (L w s) (g (L w s)) 0) = fun s =>
        g (L w s) 0 * ((rad (L w s))⁻¹ * L w s 0) - g (L w s) 1 * ((rad (L w s))⁻¹ * L w s 1) :=
      funext fun s => (hrhsAll (L w s) (g (L w s))).1
    have e1 : (fun s => cyl2cart (L w s) (g (L w s)) 1) = fun s =>
        g (L w s) 0 * ((rad (L w s))⁻¹ * L w s 1) + g (L w s) 1 * ((rad (L w s))⁻¹ * L w s 0) :=
      funext fun s => (hrhsAll (L w s) (g (L w s))).2.1
    have e2 : (fun s => cyl2cart (L w s) (g (L w s)) 2) = fun s => g (L w s) 2 :=
      funext fun s => (hrhsAll (L w s) (g (L w s))).2.2
    have d0 := ((hg 0).mul (ha w)).sub ((hg 1).mul (hb w))
    have d1 := ((hg 0).mul (hb w)).add ((hg 1).mul (ha w))
    have l0 := hline 0
    rw [e0] at l0
    have l1 := hline 1
    rw [e1] at l1
    have l2 := hline 2
    rw [e2] at l2
    have hw0 := l0.unique d0
    have hw1 := l1.unique d1
    have hw2 := l2.unique (hg 2)
    have hR := hrhsAll x (fun i => g' i + w 1 / rad x * ![-(g x 1), g x 0, 0] i)
    have comp0 : fderiv ℝ (fun y => cyl2cart y (g y)) x (cyl2cart x w) 0 =
        cyl2cart x (fun i => g' i + w 1 / rad x * ![-(g x 1), g x 0, 0] i) 0 := by
      rw [hw0, hR.1]
      simp only [hL0, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      field_simp
      ring
    have comp1 : fderiv ℝ (fun y => cyl2cart y (g y)) x (cyl2cart x w) 1 =
        cyl2cart x (fun i => g' i + w 1 / rad x * ![-(g x 1), g x 0, 0] i) 1 := by
      rw [hw1, hR.2.1]
      simp only [hL0, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      field_simp
      ring
    have comp2 : fderiv ℝ (fun y => cyl2cart y (g y)) x (cyl2cart x w) 2 =
        cyl2cart x (fun i => g' i + w 1 / rad x * ![-(g x 1), g x 0, 0] i) 2 := by
      rw [hw2, hR.2.2]
      simp
    refine PiLp.ext fun k => ?_
    fin_cases k
    · exact comp0
    · exact comp1
    · exact comp2
  have hFl : ∀ (w : Fin 3 → ℝ) (i : Fin 3), HasDerivAt (fun s =>
      (c (ptOf (L w s) t (Yph h (rad (L w s)) t + Y0)) i *
        Complex.exp (Complex.I * (n : ℂ) * (thetaOf (L w s) : ℂ))).re)
      (((w 0 • dR h c (ptOf x t (Yph h (rad x) t + Y0)) + w 2 • dZ c (ptOf x t (Yph h (rad x) t + Y0))) i *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ)) +
        c (ptOf x t (Yph h (rad x) t + Y0)) i * (Complex.I * (n : ℂ) * ((w 1 / rad x : ℝ) : ℂ) *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ)))).re) 0 := by
    intro w i
    have hc0 := hasDerivAt_pi.1 (hpath w c hc) i
    have h1 := Complex.reCLM.hasFDerivAt.comp_hasDerivAt (0:ℝ) (hc0.mul (hΦ w))
    simp only [Complex.reCLM_apply, hL0] at h1
    refine h1.congr_of_eventuallyEq (Filter.Eventually.of_forall fun s => ?_)
    rfl
  have hDl : ∀ (w : Fin 3 → ℝ) (i : Fin 3), HasDerivAt (fun s =>
      d (ptOf (L w s) t (Yph h (rad (L w s)) t + Y0)) i)
      ((w 0 • dR h d (ptOf x t (Yph h (rad x) t + Y0)) + w 2 • dZ d (ptOf x t (Yph h (rad x) t + Y0))) i) 0 :=
    fun w i => hasDerivAt_pi.1 (hpath w d hd) i
  have hadd : ∀ u v : Fin 3 → ℝ, cyl2cart x u + cyl2cart x v = cyl2cart x (u + v) := by
    intro u v
    simp only [cyl2cart, Pi.add_apply, add_smul]
    abel
  have hξ1 : (ptOf x t (Yph h (rad x) t + Y0)).1 = rad x := rfl
  refine ⟨hFd, hDd, ?_⟩
  rw [hgen _ (d (ptOf x t (Yph h (rad x) t + Y0))) _ hFd (hFl _),
    hgen _ (fun i => (c (ptOf x t (Yph h (rad x) t + Y0)) i *
      Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re) _ hDd (hDl _), hadd]
  generalize Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ)) = E
  congr 1
  funext i
  fin_cases i <;>
    simp [mcK5, hξ1, Complex.mul_re, Complex.mul_im, Complex.div_ofReal_re, Complex.div_ofReal_im] <;>
    ring

theorem twg5_coef_match : ∀ (B : BG) (G : CorrGeom) (S : CState) (dPsi dv : Cyl → ℝ) (γ : Lab) (m : ℤ) (ξ : Cyl), 0 < ξ.1 → 0 < qC B.h ξ → DifferentiableAt ℝ (VwT5 B G S γ m) ξ → DifferentiableAt ℝ (phiL5 B G γ) ξ → mcK5 B.h (modeCoef5 B G (VwT5 B G S) γ m) (dUM5 B dPsi dv) (m * pint5 B G γ) ξ = fun i => ((qC B.h ξ ^ (-(2 * Aex B.h + 1/2)) : ℝ) : ℂ) * (crossCoefM5 B G S dPsi dv γ m ξ i * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)))) :=
by
  intro B G S dPsi dv γ m ξ hr hq hW hφ

  have hcalc : ∀ (f : Cyl → ℂ) (φ : Cyl → ℝ) (a b : ℂ), DifferentiableAt ℝ f ξ →
      DifferentiableAt ℝ φ ξ → ∀ v : Cyl,
      fderiv ℝ (fun η => f η * Complex.exp (a * (b * (φ η : ℂ)))) ξ v =
        (fderiv ℝ f ξ v + a * b * ((fderiv ℝ φ ξ v : ℝ) : ℂ) * f ξ) *
          Complex.exp (a * (b * (φ ξ : ℂ))) := by
    intro f φ a b hf hφ' v
    have hcst : HasFDerivAt (fun η => ((φ η : ℝ) : ℂ)) (Complex.ofRealCLM.comp (fderiv ℝ φ ξ)) ξ := by
      have h0 := Complex.ofRealCLM.hasFDerivAt.comp ξ hφ'.hasFDerivAt
      exact h0
    have hL := (hcst.const_mul b).const_mul a
    have hE := hL.cexp
    have hP := hf.hasFDerivAt.mul hE
    rw [show (fun η => f η * Complex.exp (a * (b * (φ η : ℂ)))) =
      (f * fun x => Complex.exp (a * (b * (φ x : ℂ)))) from rfl, hP.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.comp_apply, Complex.ofRealCLM_apply, smul_eq_mul]
    ring

  have hpi : ∀ (F : Cyl → Fin 3 → ℂ), DifferentiableAt ℝ F ξ → ∀ (v : Cyl) (i : Fin 3),
      fderiv ℝ F ξ v i = fderiv ℝ (fun η => F η i) ξ v := by
    intro F hF v i
    rw [(hasFDerivAt_pi'.1 hF.hasFDerivAt i).fderiv]
    rfl

  have h0 : DifferentiableAt ℝ (fun η => ((phiL5 B G γ η : ℝ) : ℂ)) ξ :=
    Complex.ofRealCLM.differentiableAt.comp ξ hφ
  have hEd : DifferentiableAt ℝ (fun η =>
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ)))) ξ :=
    ((h0.const_mul _).const_mul _).cexp
  have hc : DifferentiableAt ℝ (modeCoef5 B G (VwT5 B G S) γ m) ξ :=
    differentiableAt_pi.2 (fun i => (differentiableAt_pi.1 hW i).mul hEd)

  have hrc : ∀ i : Fin 3, dR B.h (modeCoef5 B G (VwT5 B G S) γ m) ξ i =
      (dR B.h (VwT5 B G S γ m) ξ i + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) *
        ((dR B.h (phiL5 B G γ) ξ : ℝ) : ℂ) * VwT5 B G S γ m ξ i) *
        Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) := by
    intro i
    simp only [dR]
    rw [hpi _ hc, hpi _ hW]
    exact hcalc (fun η => VwT5 B G S γ m η i) (phiL5 B G γ) (Complex.I * (m : ℂ)) (kb B.h γ.1 : ℂ)
      (differentiableAt_pi.1 hW i) hφ _
  have hzc : ∀ i : Fin 3, dZ (modeCoef5 B G (VwT5 B G S) γ m) ξ i =
      (dZ (VwT5 B G S γ m) ξ i + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) *
        ((dZ (phiL5 B G γ) ξ : ℝ) : ℂ) * VwT5 B G S γ m ξ i) *
        Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) := by
    intro i
    simp only [dZ]
    rw [hpi _ hc, hpi _ hW]
    exact hcalc (fun η => VwT5 B G S γ m η i) (phiL5 B G γ) (Complex.I * (m : ℂ)) (kb B.h γ.1 : ℂ)
      (differentiableAt_pi.1 hW i) hφ _

  have hQb : 0 < Qb γ.1 := by unfold Qb; positivity
  have hs : Real.sqrt (Qb γ.1) ≠ 0 := Real.sqrt_ne_zero'.mpr hQb
  have hts : Qb γ.1 ^ (-(1/2:ℝ)) = (Real.sqrt (Qb γ.1))⁻¹ := by
    rw [Real.sqrt_eq_rpow, Real.rpow_neg hQb.le]
  have hkb : (kb B.h γ.1 : ℝ) ≠ 0 := by
    have hpos : 0 < kb B.h γ.1 := by
      unfold kb
      apply Nat.ceil_pos.mpr
      unfold epsb
      exact Real.rpow_pos_of_pos (Real.rpow_pos_of_pos hQb _) _
    exact_mod_cast hpos.ne'
  have hr0 : (ξ.1 : ℝ) ≠ 0 := hr.ne'

  have hg0 : ((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))) * nPhi5 B G γ ξ 0 =
      (kb B.h γ.1 : ℝ) * dR B.h (phiL5 B G γ) ξ := by
    simp only [nPhi5, DrC, Matrix.cons_val_zero, smul_eq_mul, hts]
    field_simp
  have hg1 : ((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))) * nPhi5 B G γ ξ 1 =
      (pint5 B G γ : ℝ) / ξ.1 := by
    simp only [nPhi5, pang5, RC, Matrix.cons_val_one, Matrix.cons_val_zero, Matrix.head_cons, hts]
    field_simp
  have hg2 : ((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))) * nPhi5 B G γ ξ 2 =
      (kb B.h γ.1 : ℝ) * dZ (phiL5 B G γ) ξ := by
    simp only [nPhi5, DzC, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons, smul_eq_mul, hts]
    field_simp

  have hQinv : qC B.h ξ ^ (-(2 * Aex B.h + 1/2)) = (qC B.h ξ ^ (2 * Aex B.h + 1/2))⁻¹ :=
    Real.rpow_neg hq.le _
  have hQ : (qC B.h ξ ^ (2 * Aex B.h + 1/2) : ℝ) ≠ 0 := (Real.rpow_pos_of_pos hq _).ne'
  have hrz : (ξ.1 : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr0
  have hkz : (kb B.h γ.1 : ℂ) ≠ 0 := by exact_mod_cast hkb
  funext i
  fin_cases i
  all_goals
    simp only [mcK5, crossCoefM5, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
      Matrix.tail_cons, Pi.smul_apply, smul_eq_mul, hrc, hzc, hg0, hg1, hg2, hQinv]
    simp only [modeCoef5]
    generalize Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) = E
    generalize hQd : qC B.h ξ ^ (2 * Aex B.h + 1/2) = Q at hQ ⊢
    have hQc : (Q : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hQ
    push_cast
    field_simp
    ring

theorem twg5_cross_identity : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (S : CState) (bw ca cm cd α : ℝ) (dPsi dv : Cyl → ℝ), StOrd5 B G l0 S bw ca cm cd → InM B (qsOf l0) α dPsi → InM B (qsOf l0) α dv → (∀ ξ₀ ∈ DomC B.h (qsOf l0), ∃ (U : Set Cyl) (Γ : Finset Lab), IsOpen U ∧ ξ₀ ∈ U ∧ ∀ ξ ∈ U, ∀ γ, γ ∉ Γ → ¬ SuppW B G γ ξ) → ∀ x t Y, corrOn B l0 x t → crossXm B.h (fun x' t' Y' => cyl2cart x' (waveV5 B G (VwT5 B G S) (thetaOf x') (ptOf x' t' Y'))) (DXm5 B l0 dPsi dv) x t Y = (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) • cyl2cart x (waveV5 B G (crossCoefM5 B G S dPsi dv) (thetaOf x) (ptOf x t Y)) :=
by
  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 S bw ca cm cd α dPsi dv hSt hdPsi hdv hLF x t Y hxt => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  have hSt' := hSt
  unfold StOrd5 at hSt'
  obtain ⟨hAw, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hvW, -⟩ := hSt'
  have hT : IsOpen {ξ : Cyl | ξ.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
  have hπq : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
    contDiff_snd.fst.prodMk (contDiff_const.sub contDiff_snd.snd.fst)
  have hqC : ContDiffOn ℝ ∞ (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have h4 := hok.1.2.2.2.1
    exact h4.comp hπq.contDiffOn (fun ξ (hξ : ξ.2.2.1 < 1) =>
      (⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩ : (ξ.2.1, 1 - ξ.2.2.1) ∈ univ ×ˢ Ioi (0:ℝ)))
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have h1 : IsOpen {ξ : Cyl | 0 < ξ.1} := isOpen_lt continuous_const continuous_fst
    have h2 := hqC.continuousOn.isOpen_inter_preimage hT (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Iio (qsOf l0)) := by
      ext ξ; exact Iff.rfl
    rw [e]; exact h1.inter h2
  have hqpos : ∀ ξ : Cyl, ξ.2.2.1 < 1 → 0 < qC B.h ξ := fun ξ hξ =>
    (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hdom : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 :=
    fun ξ hξ => hξ
  have hDT : DomC B.h (qsOf l0) ⊆ {ξ : Cyl | ξ.2.2.1 < 1} := fun ξ hξ => (hdom ξ hξ).2.1
  have ofR : ∀ {f : Cyl → ℝ} {s : Set Cyl}, ContDiffOn ℝ ∞ f s →
      ContDiffOn ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) s := fun hf =>
    (Complex.ofRealCLM.contDiff.comp_contDiffOn hf).congr (fun η _ => by simp)
  have hdRZ : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : Cyl → V) (O : Set Cyl),
      IsOpen O → (∀ η ∈ O, 0 < η.1) → ContDiffOn ℝ ∞ F O →
      ContDiffOn ℝ ∞ (dR B.h F) O ∧ ContDiffOn ℝ ∞ (dZ F) O := by
    intro V _ _ F O hO hpos hF
    have hDf : ContDiffOn ℝ ∞ (fderiv ℝ F) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hF).2
    have hpow : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1 ^ (drx B.h - 1)) O :=
      contDiff_fst.contDiffOn.rpow_const_of_ne (fun ξ hξ => (hpos ξ hξ).ne')
    have hY : ContDiffOn ℝ ∞ (fun ξ : Cyl => (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) O :=
      (contDiffOn_const.mul hpow).smul_const _
    have hvR : ContDiffOn ℝ ∞ (fun ξ : Cyl =>
        ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) O :=
      contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk hY))
    exact ⟨(hDf.clm_apply hvR).congr (fun ξ _ => rfl),
      (hDf.clm_apply contDiffOn_const).congr (fun ξ _ => rfl)⟩
  have hqA : ∀ p : ℝ, ContDiffOn ℝ ∞ (fun η => qC B.h η ^ p) (DomC B.h (qsOf l0)) := fun p =>
