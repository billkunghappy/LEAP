  intro h ρ T1 S1 Kp hh0 hh1 hρ0 hρh hT1 hS0 hS1 hK0 hK1
  have ha0 : 0 < 1 - h := by linarith
  have ha1 : 1 - h ≤ 1 := by linarith
  have ha2 : 1 / 2 ≤ 1 - h := by linarith
  have hρ1 : ρ ≤ 1 / 8000000 := by linarith
  have hr0 : 0 < 1 - ρ := by linarith
  have he1 : Real.exp 1 < 3 := by
    have := Real.exp_one_lt_d9; norm_num at this ⊢; linarith
  have hepos : 0 < Real.exp 1 := Real.exp_pos 1
  have he3 : Real.exp 3 < 21 := by
    have h3 : Real.exp 3 = Real.exp 1 * Real.exp 1 * Real.exp 1 := by
      rw [← Real.exp_add, ← Real.exp_add]; norm_num
