  have slice : ∀ (G : ℝ → ℝ → ℝ → ℝ) (P : ℝ → ℝ → ℝ) (q X η K : ℝ), 0 < q →
      DifferentiableAt ℝ (logLift G) (Real.log q, X, η) →
      DifferentiableAt ℝ (fun w : ℝ × ℝ × ℝ => P w.2.1 w.2.2) (Real.log q, X, η) →
      ‖iteratedFDeriv ℝ 0 (fun w : ℝ × ℝ × ℝ => logLift G w - P w.2.1 w.2.2) (Real.log q, X, η)‖ ≤ K →
      ‖iteratedFDeriv ℝ 1 (fun w : ℝ × ℝ × ℝ => logLift G w - P w.2.1 w.2.2) (Real.log q, X, η)‖ ≤ K →
      DifferentiableAt ℝ (fun Y => G q Y η) X ∧ |G q X η - P X η| ≤ K ∧
      |deriv (fun Y => G q Y η) X - deriv (fun Y => P Y η) X| ≤ K := by
    intro G P q X η K hq hG hP h0 h1
    have hμ : HasDerivAt (fun Y : ℝ => (Real.log q, Y, η)) ((0:ℝ), (1:ℝ), (0:ℝ)) X :=
      (hasDerivAt_const X _).prodMk ((hasDerivAt_id' X).prodMk (hasDerivAt_const X _))
