  have hcover : ∀ ξ₀ ∈ DomC B.h (qsOf l0), ∃ (U : Set Cyl) (Γ : Finset Lab), IsOpen U ∧ ξ₀ ∈ U ∧
      ∀ ξ' ∈ U, ∀ γ, γ ∉ Γ → ¬ SuppW B G γ ξ' := by
    intro ξ₀ hξ₀
    obtain ⟨-, hξ1, -⟩ := hξ₀
    obtain ⟨N, hN, Γ, hΓ⟩ := etaL_local_finite_v5 B.h hok.1 ξ₀ hξ1
    exact ⟨interior N, Γ, isOpen_interior, mem_interior_iff_mem_nhds.mpr hN,
      fun ξ' hξ' γ hγ hsupp => hγ (hΓ γ ξ' (interior_subset hξ') hsupp.2.1)⟩
  have hSD : InWg5 B G (qsOf l0) (min β1 β2) (S.Aw + D) :=
    (mwh5_waveV_add B G hok l0 S.Aw D β1 β2 hcover hS hD).1
  obtain ⟨r, z, t, Y⟩ := ξ
  obtain ⟨hr, ht, hqξ⟩ : 0 < r ∧ t < 1 ∧ qC B.h (r, z, t, Y) < qsOf l0 := id hξ
  have hY : Yph B.h r t + (Y - Yph B.h r t) = Y := by abel
  have hradx0 : rad (rotPt r 0 z) = r := by simp [rad, rotPt, Real.sqrt_sq hr.le]
  have hx02 : (rotPt r 0 z) 2 = z := by simp [rotPt]
  have hPx0 : ptOf (rotPt r 0 z) t (Yph B.h (rad (rotPt r 0 z)) t + (Y - Yph B.h r t)) = (r, z, t, Y) := by
    simp only [ptOf, hradx0, hY, hx02]

  have star : ∀ (T : CState) (α : ℝ), InWg5 B G (qsOf l0) α T.Aw → InM B (qsOf l0) (1/2) T.Psi →
      ucyl5 B G l0 T θ (r, z, t, Y) a = ucyl5 B G l0 (wmoBase T) 0 (r, z, t, Y) a +
        qC B.h (r, z, t, Y) ^ (-Aex B.h) * waveV5 B G (wmoAmp5 B G T.Aw) θ (r, z, t, Y) a := by
    intro T α hT hTP

    obtain ⟨N, hN, Γ, hΓ⟩ := etaL_local_finite_v5 B.h hok.1 (r, z, t, Y) ht
    obtain ⟨H, -, hHv⟩ := hT.1
    have hNO : N ∩ DomC B.h (qsOf l0) ∈ nhds ((r, z, t, Y) : Cyl) :=
      Filter.inter_mem hN (hDopen.mem_nhds hξ)
    have hcov : ∀ η ∈ N ∩ DomC B.h (qsOf l0), ∀ γ m, T.Aw γ m η ≠ 0 → γ ∈ Γ ∧ m ∈ H := by
      rintro η ⟨hηN, hηD⟩ γ m hne
      refine ⟨hΓ γ η hηN (hT.2.2.2.1 γ m η hηD hne).2.1, ?_⟩
      by_contra hm
      exact hne (by simp [hHv γ m hm])

    have hamp0 : ∀ (γ : Lab) (m : ℤ), ¬ (γ ∈ Γ ∧ m ∈ H) → wmoAmp5 B G T.Aw γ m (r, z, t, Y) = 0 := by
      intro γ m hn
      have hev : T.Aw γ m =ᶠ[nhds ((r, z, t, Y) : Cyl)] fun _ => 0 := by
        filter_upwards [hNO] with η hη
        by_contra hne
        exact hn (hcov η hη γ m hne)
      have h0 : T.Aw γ m (r, z, t, Y) = 0 := hev.eq_of_nhds
      have hcomp : ∀ i : Fin 3, fderiv ℝ (fun η => T.Aw γ m η i) ((r, z, t, Y) : Cyl) = 0 := by
        intro i
        have h1 : (fun η => T.Aw γ m η i) =ᶠ[nhds ((r, z, t, Y) : Cyl)] fun _ => (0:ℂ) := by
          filter_upwards [hev] with η hη
          simp [hη]
        rw [h1.fderiv_eq]
        simp
      funext i
      fin_cases i <;> simp [wmoAmp5, velW5, velC5, DrC, DzC, dR, dZ, rotC, h0, hcomp]

    have hwave : waveV5 B G (wmoAmp5 B G T.Aw) θ (r, z, t, Y) a = ∑ γ ∈ Γ, ∑ m ∈ H,
        (wmoAmp5 B G T.Aw γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y)).re := by
      have hin : ∀ γ, ∑ᶠ m : ℤ, wmoAmp5 B G T.Aw γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y) =
          ∑ m ∈ H, wmoAmp5 B G T.Aw γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y) := by
        intro γ
        apply finsum_eq_sum_of_support_subset
        rw [Function.support_subset_iff']
        intro m hm
        rw [hamp0 γ m (fun hh => hm (Finset.mem_coe.mpr hh.2))]
        simp
      have hout : (Function.support fun γ => ∑ m ∈ H,
          wmoAmp5 B G T.Aw γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y)) ⊆ ↑Γ := by
        rw [Function.support_subset_iff']
        intro γ hγ
        apply Finset.sum_eq_zero
        intro m _
        rw [hamp0 γ m (fun hh => hγ (Finset.mem_coe.mpr hh.1))]
        simp
      simp only [waveV5]
      rw [finsum_congr hin, finsum_eq_sum_of_support_subset _ hout, Complex.re_sum]
      refine Finset.sum_congr rfl (fun γ _ => ?_)
      rw [Complex.re_sum]

    have hmode : ∀ (γ : Lab) (m : ℤ), inner ℝ (curl3 (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
        (m * pint5 B G γ) (modeCoef5 B G T.Aw γ m)) (rotPt r θ z)) (frameAt θ (r, z, t, Y) a) =
        qC B.h (r, z, t, Y) ^ (-Aex B.h) *
          (wmoAmp5 B G T.Aw γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y)).re := by
      intro γ m
      have hCd : DifferentiableAt ℝ (modeCoef5 B G T.Aw γ m) ((r, z, t, Y) : Cyl) :=
        modeCoef5_differentiable_v5 B G hok hG (qsOf l0) α T.Aw hqsB hT γ m _ hξ
      have hICd : DifferentiableAt ℝ (fun η i => Complex.I * modeCoef5 B G T.Aw γ m η i)
          ((r, z, t, Y) : Cyl) :=
        differentiableAt_pi.2 (fun i => (differentiableAt_pi.1 hCd i).const_mul Complex.I)
      have hM1 : DifferentiableAt ℝ (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
          (modeCoef5 B G T.Aw γ m)) (rotPt r 0 z) :=
        modeF5_differentiable_v5 _ _ _ _ _ _ _ hok.1 ht (by rw [hradx0]; exact hr) (by rw [hPx0]; exact hCd)
      have hM2 : DifferentiableAt ℝ (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
          (fun η i => Complex.I * modeCoef5 B G T.Aw γ m η i)) (rotPt r 0 z) :=
        modeF5_differentiable_v5 _ _ _ _ _ _ _ hok.1 ht (by rw [hradx0]; exact hr) (by rw [hPx0]; exact hICd)
      obtain ⟨hax1, hax2⟩ := mode_curl_axis_v5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
        (modeCoef5 B G T.Aw γ m) r z hok.1 ht hr (by rw [hY]; exact hCd)
      obtain ⟨hax3, -⟩ := mode_curl_axis_v5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
        (fun η i => Complex.I * modeCoef5 B G T.Aw γ m η i) r z hok.1 ht hr (by rw [hY]; exact hICd)
      rw [hY] at hax1 hax2 hax3
      have hph := fun i => wmo_phase_deriv_v5 B G hok hG (qsOf l0) α T.Aw hqsB hT γ m (r, z, t, Y) hξ i
      have hamp := wmo_mode_amp_v5 B G T.Aw γ m (r, z, t, Y) hok hr ht (fun i => (hph i).1)
        (fun i => (hph i).2) a
      have hZ : ephase5 B G γ m θ (r, z, t, Y) =
          Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (r, z, t, Y) : ℂ))) *
            Complex.exp (((((m * pint5 B G γ : ℤ) : ℝ) * θ : ℝ) : ℂ) * Complex.I) := by
        simp only [ephase5]
        rw [← Complex.exp_add]
        congr 1
        push_cast
        ring
      rw [hrot _ _ _ _ _ _ r z hr hM1 hM2 Y a θ, hax1 a, hax3 a, hax2, hZ]
      exact key _ _ _ _ _ _ hamp

    have hloc := wmo_local_modes_v5 B G hok hG l0 T α Γ H hqsB hT hTP (r, z, t, Y) hξ ⟨N, hN, hcov⟩ θ a
    have hbase := wmo_base_theta_free_v5 B G l0 T hok hqsB hTP (r, z, t, Y) hξ θ a
    have hsum : (∑ γ ∈ Γ, ∑ m ∈ H, inner ℝ (curl3 (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
        (m * pint5 B G γ) (modeCoef5 B G T.Aw γ m)) (rotPt r θ z)) (frameAt θ (r, z, t, Y) a)) =
        qC B.h (r, z, t, Y) ^ (-Aex B.h) * waveV5 B G (wmoAmp5 B G T.Aw) θ (r, z, t, Y) a := by
      calc _ = ∑ γ ∈ Γ, ∑ m ∈ H, qC B.h (r, z, t, Y) ^ (-Aex B.h) *
              (wmoAmp5 B G T.Aw γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y)).re :=
            Finset.sum_congr rfl (fun γ _ => Finset.sum_congr rfl (fun m _ => hmode γ m))
        _ = _ := by
            rw [hwave, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun γ _ => ?_)
            rw [Finset.mul_sum]
    rw [hloc, hbase]
    exact congrArg (fun s => ucyl5 B G l0 (wmoBase T) 0 (r, z, t, Y) a + s) hsum
  have hbaseEq : ucyl5 B G l0 (wmoBase (waveAdd S D E)) 0 (r, z, t, Y) a =
      ucyl5 B G l0 (wmoBase S) 0 (r, z, t, Y) a := rfl
  refine ⟨star S β1 hS hPsi, ?_⟩
  have h2 := star (waveAdd S D E) (min β1 β2) hSD hPsi
  rw [hbaseEq] at h2
  exact h2

theorem wave_theta_pair_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (a b : WC), (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → a γ m = 0 ∧ b γ m = 0) →
    (∀ γ m, ContinuousOn (a γ m) (DomC B.h (qsOf l0)) ∧ ContinuousOn (b γ m) (DomC B.h (qsOf l0))) →
    (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → (a γ m ξ ≠ 0 → SuppW B G γ ξ) ∧ (b γ m ξ ≠ 0 → SuppW B G γ ξ)) →
    ∀ ξ ∈ DomC B.h (qsOf l0), ∀ i j : Fin 3,
      Continuous (fun θ => waveV5 B G a θ ξ i) ∧ thA (fun θ => waveV5 B G a θ ξ i) = 0 ∧
      (∀ θ, waveV5 B G (a + b) θ ξ i = waveV5 B G a θ ξ i + waveV5 B G b θ ξ i) ∧
      thA (fun θ => waveV5 B G a θ ξ i * waveV5 B G b θ ξ j) = wmoPair5 a b i j ξ :=
by
  intro B G hok hG
  have hS : SimScaleProps B.h := hok.1
  obtain ⟨-, -, -, -, -, -, -, hqB0, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, ?_⟩
  rintro l0 hl0 a b ⟨H, hH0, hH⟩ hc hs ξ hξ i j
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]; exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  have hD : ∀ η, η ∈ DomC B.h (qsOf l0) → 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < qsOf l0 :=
    fun η h => h
  have hsq : ∀ (μ : ℝ) (j : ℤ) (s : ℝ), sqPart μ j s ≠ 0 → (s / μ - j) ^ 2 < 1 := by
    intro μ j s hne
    by_contra hcon
    push_neg at hcon
    apply hne
    unfold sqPart bumpR
    rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_div]
  have hsq' : ∀ (μ : ℝ) (j : ℤ) (s : ℝ), (s / μ - j) ^ 2 < 1 → sqPart μ j s ≠ 0 := by
    intro μ j s hlt
    have hpos : 0 < bumpR (s / μ - j) := Real.smoothTransition.pos_of_pos (by linarith)
    have hsum : Summable (fun n : ℤ => bumpR (s / μ - n) ^ 2) := by
      apply summable_of_ne_finset_zero (s := Finset.Icc (⌊s / μ⌋ - 1) (⌊s / μ⌋ + 1))
      intro n hn
      have hn' : n ≤ ⌊s / μ⌋ - 2 ∨ ⌊s / μ⌋ + 2 ≤ n := by
        simp only [Finset.mem_Icc, not_and_or, not_le] at hn; omega
      have h1 : 1 ≤ (s / μ - n) ^ 2 := by
        rcases hn' with h | h
        · have : (n:ℝ) ≤ (⌊s / μ⌋:ℝ) - 2 := by exact_mod_cast h
          nlinarith [Int.floor_le (s / μ)]
        · have : (⌊s / μ⌋:ℝ) + 2 ≤ (n:ℝ) := by exact_mod_cast h
          nlinarith [Int.lt_floor_add_one (s / μ)]
      show bumpR (s / μ - n) ^ 2 = 0
      unfold bumpR
      rw [Real.smoothTransition.zero_of_nonpos (by linarith)]; ring
    have hle : bumpR (s / μ - j) ^ 2 ≤ ∑' n : ℤ, bumpR (s / μ - n) ^ 2 :=
      hsum.le_tsum j (fun k _ => sq_nonneg _)
    unfold sqPart
    exact (div_pos hpos (Real.sqrt_pos.mpr (lt_of_lt_of_le (pow_pos hpos 2) hle))).ne'
  have hqcont : ∀ x : Cyl, x.2.2.1 < 1 → ContinuousAt (qC B.h) x := by
    intro x hx
    have hτ : 0 < 1 - x.2.2.1 := by linarith
    have hU : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
    have hp : ((x.2.1, 1 - x.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := ⟨trivial, hτ⟩
    have hg : ContinuousAt (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (x.2.1, 1 - x.2.2.1) :=
      hS.2.2.2.1.continuousOn.continuousAt (hU.mem_nhds hp)
    have hk : ContinuousAt (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) x := by fun_prop
    have he : qC B.h = (fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by
      funext η; rfl
    rw [he]
    exact ContinuousAt.comp hg hk
  have hΩo : IsOpen (DomC B.h (qsOf l0)) := by
    rw [isOpen_iff_mem_nhds]
    intro x hx
    obtain ⟨hx1, hx2, hx3⟩ := hD x hx
    have e1 : ∀ᶠ η in nhds x, 0 < η.1 :=
      continuousAt_const.eventually_lt (show ContinuousAt (fun η : Cyl => η.1) x by fun_prop) hx1
    have e2 : ∀ᶠ η in nhds x, η.2.2.1 < 1 :=
      (show ContinuousAt (fun η : Cyl => η.2.2.1) x by fun_prop).eventually_lt continuousAt_const hx2
    have e3 : ∀ᶠ η in nhds x, qC B.h η < qsOf l0 :=
      (hqcont x hx2).eventually_lt continuousAt_const hx3
    filter_upwards [e1, e2, e3] with η h1 h2 h3
    exact ⟨h1, h2, h3⟩
  have hopen : ∀ (γ : Lab) (x : Cyl), x.2.2.1 < 1 → etaL B.h γ x ≠ 0 →
      ∀ᶠ η in nhds x, etaL B.h γ η ≠ 0 := by
    intro γ x hx hne
    have hfac : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ x → sqPart μ j (φ x) ≠ 0 →
        ∀ᶠ η in nhds x, sqPart μ j (φ η) ≠ 0 := by
      intro μ j φ hφ h0
      have hlt := hsq μ j (φ x) h0
      have hcφ : ContinuousAt (fun η => (φ η / μ - j) ^ 2) x :=
        ((hφ.div_const μ).sub continuousAt_const).pow 2
      filter_upwards [hcφ.eventually_lt continuousAt_const hlt] with η hη
      exact hsq' μ j (φ η) hη
    have hq0 : 0 < qC B.h x := (hS.1 x.2.1 (1 - x.2.2.1) (by linarith)).1
    unfold etaL at hne
    have e0 := left_ne_zero_of_mul hne
    have r := right_ne_zero_of_mul hne
    have e3 := right_ne_zero_of_mul r
    have r2 := left_ne_zero_of_mul r
    have e1 := left_ne_zero_of_mul r2
    have e2 := right_ne_zero_of_mul r2
    filter_upwards [hfac 1 _ (fun η => Real.logb 2 (qC B.h η)) ((hqcont x hx).logb hq0.ne') e0,
      hfac _ _ (chartR B.h γ.1) (by unfold chartR; fun_prop) e1,
      hfac _ _ (chartZ B.h γ.1) (by unfold chartZ; fun_prop) e2,
      hfac _ _ (chartT B.h γ.1) (by unfold chartT; fun_prop) e3] with η k0 k1 k2 k3
    exact mul_ne_zero k0 (mul_ne_zero (mul_ne_zero k1 k2) k3)
  have hdisj : ∀ (γ γ' : Lab) (m m' : ℤ), γ ≠ γ' → a γ m ξ ≠ 0 → b γ' m' ξ ≠ 0 → False := by
    intro γ γ' m m' hne ha hb
    have hSa := (hs γ m ξ hξ).1 ha
    have hSb := (hs γ' m' ξ hξ).2 hb
    have hPev : ∀ x, (x ∈ DomC B.h (qsOf l0) ∧ a γ m x ≠ 0 ∧ b γ' m' x ≠ 0) →
        ∀ᶠ η in nhds x, η ∈ DomC B.h (qsOf l0) ∧ a γ m η ≠ 0 ∧ b γ' m' η ≠ 0 := by
      rintro x ⟨hx, hax, hbx⟩
      have hn : DomC B.h (qsOf l0) ∈ nhds x := hΩo.mem_nhds hx
      filter_upwards [hn, ((hc γ m).1.continuousAt hn).preimage_mem_nhds (compl_singleton_mem_nhds hax),
        ((hc γ' m').2.continuousAt hn).preimage_mem_nhds (compl_singleton_mem_nhds hbx)]
        with η h1 h2 h3
      exact ⟨h1, h2, h3⟩
    have hfr1 : ∃ᶠ η in nhds ξ, etaL B.h γ η ≠ 0 := mem_closure_iff_frequently.mp hSa.2.1
    obtain ⟨η1, hη1e, hη1P⟩ := (hfr1.and_eventually (hPev ξ ⟨hξ, ha, hb⟩)).exists
    have hSb1 := (hs γ' m' η1 hη1P.1).2 hη1P.2.2
    have hfr2 : ∃ᶠ η in nhds η1, etaL B.h γ' η ≠ 0 := mem_closure_iff_frequently.mp hSb1.2.1
    obtain ⟨η2, hη2e', hη2P, hη2e⟩ := (hfr2.and_eventually ((hPev η1 hη1P).and
      (hopen γ η1 (hD η1 hη1P.1).2.1 hη1e))).exists
    have hlm : G.lmin ≤ γ.1 := hSa.1.1
    have hlm' : G.lmin ≤ γ'.1 := hSb.1.1
    have hη2D : η2 ∈ DomC B.h B.qB :=
      ⟨(hD η2 hη2P.1).1, (hD η2 hη2P.1).2.1, lt_of_lt_of_le (hD η2 hη2P.1).2.2 hqsB⟩
    have hd := hG.2.1 γ γ' hne hlm hlm' ⟨η2, hη2D, hη2e, hη2e'⟩
    have hr0 : 0 < G.r0 := hG.1.1
    have m1 : ξ.2.2.2 ∈ rectAbs B G γ (2 * G.r0) := by
      show |xiG B.h γ (G.ctr γ) ξ.2.2.2| ≤ 2 * G.r0 ∧ |etG B.h γ (G.ctr γ) ξ.2.2.2| ≤ 2 * G.r0
      exact ⟨by linarith [hSa.2.2.1], by linarith [hSa.2.2.2.1]⟩
    have m2 : ξ.2.2.2 ∈ rectAbs B G γ' (2 * G.r0) := by
      show |xiG B.h γ' (G.ctr γ') ξ.2.2.2| ≤ 2 * G.r0 ∧ |etG B.h γ' (G.ctr γ') ξ.2.2.2| ≤ 2 * G.r0
      exact ⟨by linarith [hSb.2.2.1], by linarith [hSb.2.2.2.1]⟩
    exact Set.disjoint_left.mp hd (subset_closure m1) (subset_closure m2)
  have etaLfin : ∀ (h : ℝ), SimScaleProps h → ∀ ξ0 : Cyl, ξ0.2.2.1 < 1 → ∃ N ∈ nhds ξ0,
      ∃ Γ : Finset Lab, ∀ (γ : Lab) (ξ : Cyl), ξ ∈ N → ξ ∈ tsupport (etaL h γ) → γ ∈ Γ := by
    intro h hS ξ0 hξ0
    have hLc : ∀ ξ : Cyl, ξ.2.2.1 < 1 → ContinuousAt (fun η => Real.logb 2 (qC h η)) ξ := by
      intro ξ hξ
      have hτ : 0 < 1 - ξ.2.2.1 := by linarith
      have hqpos : 0 < qC h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
      have hqcont : ContinuousAt (qC h) ξ := by
        have hU : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
        have hp : ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) :=
          ⟨trivial, hτ⟩
        have hg : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (ξ.2.1, 1 - ξ.2.2.1) :=
