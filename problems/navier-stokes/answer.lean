  have hMom2 : ∀ e, profRadInt (fun x' e' => rfpU P x' e' ^ 2 - x' * rfpF P x' e' ^ 2) x e =
      e ^ 2 * K2 + ((1 + e ^ 2)⁻¹) ^ 2 *
        (P.Amp e ^ 2 * S0 + P.c1 e ^ 2 * S1 + P.c2 e ^ 2 * S2 - S00 / 2) := by
    intro e
    have hpt : ∀ y ∈ Iic (Real.log x),
        Real.exp y * (rfpU P (Real.exp y) e ^ 2 - Real.exp y * rfpF P (Real.exp y) e ^ 2) =
        e ^ 2 * (Real.exp y * rfpK P.Md y ^ 2)
        + (((1 + e ^ 2)⁻¹) ^ 2 * P.Amp e ^ 2) *
            (Real.exp (y + 2 * rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam)) ^ 2)
        + (((1 + e ^ 2)⁻¹) ^ 2 * P.c1 e ^ 2) *
            (Real.exp (y + 2 * rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 3) ^ 2)
        + (((1 + e ^ 2)⁻¹) ^ 2 * P.c2 e ^ 2) *
