    intro w h1 h2
    have r1 : w.1 = lamR w + bgc * lamT w := by unfold lamR lamT; field_simp; ring
    have r2 : w.2 = -bgc * lamR w + lamT w := by unfold lamR lamT; field_simp; ring
    obtain ⟨a1, a2⟩ := abs_le.mp h1
    obtain ⟨b1, b2⟩ := abs_le.mp h2
    have p1 := mul_nonneg hb0 (sub_nonneg.2 b2)
    have p2 := mul_nonneg hb0 (show 0 ≤ lamT w + r0 by linarith)
    have p3 := mul_nonneg hb0 (sub_nonneg.2 a2)
    have p4 := mul_nonneg hb0 (show 0 ≤ lamR w + r0 by linarith)
    have p5 := mul_nonneg (sub_nonneg.2 hb1) hr0.le
    constructor
    · rw [abs_lt]; constructor <;> nlinarith
    · rw [abs_lt]; constructor <;> nlinarith

