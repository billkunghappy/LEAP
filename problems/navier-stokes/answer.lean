  have WR : ∀ (r φ : ℝ → ℝ) (A K s y0 Y l : ℝ), (∀ ξ : ℝ, 0 ≤ r ξ) → (∀ ξ : ℝ, ξ ≤ 0 → r ξ = 0) →
