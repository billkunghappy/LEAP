  intro B qs f hok hqs0 hqs1 hfs hfz hper
  obtain ⟨hP, hPk, hM, hMk, -⟩ := path_integral_smooth_v5 B qs f hok hqs0 hqs1 hfs hfz
  obtain ⟨hh0, hh1, hXa, hXm1, hm12, hm2Xb, -⟩ := hok.2.1
  have hXb0 : 0 < B.Xb := by linarith
  set P : ℝ × ℝ × (ℝ × ℝ) → ℝ := fun ζ' : ℝ × ℝ × (ℝ × ℝ) =>
    ∫ r in Set.Ioi (0:ℝ), f (r, ζ'.1, ζ'.2.1, ζ'.2.2 + (r ^ drx B.h) • vrv) with hPdef
