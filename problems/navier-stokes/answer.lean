    rw [zero_mul] at this
    linarith
  have hPle : P ≤ 2 * M := by
    have h1 : F0 * -N1 ≤ M * 1 := mul_le_mul hF2 (by linarith) (by linarith) hM0.le
    have h3 : P = 2 * (F0 * -N1) := by rw [hP]; ring
    linarith
  have hSpos : 0 < S := by
    by_contra h
    have h' : S ≤ 0 := not_lt.mp h
