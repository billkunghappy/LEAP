      rw [hev.deriv_eq]; simpa using hKs0

  obtain ⟨s1, s2, δ, CR, β, γ, Φ, hs1, hs12, hs2, hδ, hβs, hγs, hβ0, hγ0, hΦs, hΦ0, hΦ⟩ :=
    hRep Pst (Real.exp (-6)) (Real.exp (-5)) hPst (Real.exp_pos _) (Real.exp_lt_exp.mpr (by norm_num))
  have hbump : ∀ f : ℝ → ℝ, ContDiff ℝ ∞ f → (∀ x, (x ≤ s1 ∨ s2 ≤ x) → f x = 0) →
      ∃ K : ℝ, 0 ≤ K ∧ ∀ x, |f x| ≤ K ∧ |x * deriv f x| ≤ K := by
    intro f hf hf0
