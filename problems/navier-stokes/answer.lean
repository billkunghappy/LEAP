            (r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * t ^ m := by linarith
        _ = _ := by ring
    · rcases Nat.lt_or_ge m 2 with hm | hm
      · interval_cases m
        · rw [hv0 rfl, norm_zero]
          exact mul_nonneg (by positivity) (pow_nonneg ht0 _)
        · obtain ⟨hV, hz⟩ := hv1 rfl
          have h2 : ‖(2 : ℂ)‖ = 2 := by norm_num
          rw [hV, norm_div, norm_neg, h2]
          calc ‖zw‖ / 2 ≤ M / 2 * t := by nlinarith [norm_nonneg zw]
            _ = _ := by push_cast; field_simp; ring
      · calc ‖Vm‖ ≤ _ := hv2 hm
          _ = (40 * M * G' / r / Λ) * ((r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * t ^ m) := by ring
          _ ≤ (40 * M / r) * ((r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * t ^ m) :=
              mul_le_mul_of_nonneg_right (hbΛ.trans hE') hW
          _ = _ := by ring

  have hBnd : ∀ n : ℕ, (∀ m ≤ n, ∀ s w, 0 ≤ s → s < r → w ∈ axRect s →
      ‖P m w - (-χ w / 2) ^ m / ((m.factorial : ℂ) * ((m + 1).factorial : ℂ))‖ ≤
        2 * (10 * M / r) * G / Λ * μ m * (r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ m ∧
      (2 ≤ m → ‖V m w‖ ≤ 40 * M * G' / r / Λ * (r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ m)) →
      ∀ m ≤ n, ∀ s w, 0 ≤ s → s < r → w ∈ axRect s →
        ‖P m w‖ ≤ (2 * Real.exp (10 * M / r) + 1) * (r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ m ∧
        ‖V m w‖ ≤ (40 * M / r) * (r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ m := by
    intro n hC m hm s w hs0 hsr hw
    obtain ⟨hq, hv⟩ := hC m hm s w hs0 hsr hw
    have hF := hF2 s hsr w hw
    obtain ⟨a1, a2, -⟩ := hA m ((r - s)⁻¹) (P m w) (V m w) _ (z w) (hF1 s hs0 hsr)
      (hebd (χ w) m hF.1) (fun h => by subst h; exact hV0 w)
      (fun h => by subst h; exact ⟨hV1 w, hF.2⟩) hq hv
    exact ⟨a1, a2⟩

  have hC : ∀ n : ℕ, ∀ m ≤ n, ∀ s w, 0 ≤ s → s < r → w ∈ axRect s →
      ‖P m w - (-χ w / 2) ^ m / ((m.factorial : ℂ) * ((m + 1).factorial : ℂ))‖ ≤
        2 * (10 * M / r) * G / Λ * μ m * (r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ m ∧
      (2 ≤ m → ‖V m w‖ ≤ 40 * M * G' / r / Λ * (r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ m) := by
    intro n
    induction n with
    | zero =>
      intro m hm s w hs0 hsr hw
      obtain rfl : m = 0 := by omega
      refine ⟨?_, fun h => absurd h (by norm_num)⟩
      have e0 : P 0 w - (-χ w / 2) ^ 0 / (((0 : ℕ).factorial : ℂ) * (((0 : ℕ) + 1).factorial : ℂ)) = 0 := by
        rw [hP0 w]; simp
      rw [e0, norm_zero, hμ0]
      simp only [pow_zero, mul_one]
      positivity
    | succ n ih =>
      intro m hm s w hs0 hsr hw
      rcases Nat.of_le_succ hm with h | h
      · exact ih m h s w hs0 hsr hw
      · subst h
        have hB := hBnd n ih
        have hF := hF2 s hsr w hw
        have ht1 := hF1 s hs0 hsr
        obtain ⟨hqn, -⟩ := ih n le_rfl s w hs0 hsr hw
        have hcast : ((n + 1 : ℕ) : ℝ) + 1 = (n : ℝ) + 2 := by push_cast; ring
        refine ⟨?_, ?_⟩
        · rw [hμs n, hcast]
          have hXb := hX n hB s w hs0 hsr hw
          have hcn : ‖(2 * ((n : ℂ) + 1) * ((n : ℂ) + 2))‖ = 2 * ((n : ℝ) + 1) * ((n : ℝ) + 2) := by
            have e : (2 * ((n : ℂ) + 1) * ((n : ℂ) + 2)) =
                ((2 * ((n : ℝ) + 1) * ((n : ℝ) + 2) : ℝ) : ℂ) := by push_cast; ring
            rw [e, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
          have hid : 2 * ((n : ℂ) + 1) * ((n : ℂ) + 2) * (P (n + 1) w - (-χ w / 2) ^ (n + 1) /
              (((n + 1).factorial : ℂ) * ((n + 1 + 1).factorial : ℂ))) =
              (2 * ((n : ℂ) + 1) * ((n : ℂ) + 2) * P (n + 1) w + χ w * P n w) -
                χ w * (P n w - (-χ w / 2) ^ n / ((n.factorial : ℂ) * ((n + 1).factorial : ℂ))) := by
            linear_combination (-1 : ℂ) * herec (χ w) n
          have h1 : 2 * ((n : ℝ) + 1) * ((n : ℝ) + 2) * ‖P (n + 1) w - (-χ w / 2) ^ (n + 1) /
              (((n + 1).factorial : ℂ) * ((n + 1 + 1).factorial : ℂ))‖ ≤
              ‖2 * ((n : ℂ) + 1) * ((n : ℂ) + 2) * P (n + 1) w + χ w * P n w‖ +
                ‖χ w * (P n w - (-χ w / 2) ^ n / ((n.factorial : ℂ) * ((n + 1).factorial : ℂ)))‖ := by
            rw [← hcn, ← norm_mul, hid]
            exact norm_sub_le _ _
          have hD : (0 : ℝ) < 2 * ((n : ℝ) + 1) * ((n : ℝ) + 2) := by positivity
          have h2 : ‖P (n + 1) w - (-χ w / 2) ^ (n + 1) /
              (((n + 1).factorial : ℂ) * ((n + 1 + 1).factorial : ℂ))‖ ≤
              (‖2 * ((n : ℂ) + 1) * ((n : ℂ) + 2) * P (n + 1) w + χ w * P n w‖ +
                ‖χ w * (P n w - (-χ w / 2) ^ n / ((n.factorial : ℂ) * ((n + 1).factorial : ℂ)))‖) /
                (2 * ((n : ℝ) + 1) * ((n : ℝ) + 2)) := by
            rw [le_div_iff₀ hD, mul_comm]; exact h1
          refine h2.trans (hgen (10 * M / r) (r / 20) ((r - s)⁻¹) (μ n) _ _ n hx0 hκ0 ht1 (hμb n).1 ?_ ?_)
          · refine hXb.trans (le_of_eq ?_)
            linear_combination (G / Λ * (r / 20) ^ n / ((n : ℝ) + 1) * ((r - s)⁻¹) ^ (n + 1)) * hMx
          · rw [norm_mul]
            calc ‖χ w‖ * ‖P n w - (-χ w / 2) ^ n / ((n.factorial : ℂ) * ((n + 1).factorial : ℂ))‖
                ≤ M * (2 * (10 * M / r) * G / Λ * μ n * (r / 20) ^ n / ((n : ℝ) + 1) ^ 2 *
                    ((r - s)⁻¹) ^ n) := mul_le_mul hF.1 hqn (norm_nonneg _) hM
              _ = _ := by
                linear_combination (2 * (10 * M / r) * G / Λ * μ n * (r / 20) ^ n / ((n : ℝ) + 1) ^ 2 *
                    ((r - s)⁻¹) ^ n) * hMx
        · intro h2n
          have hn1 : 1 ≤ n := by omega
          have hYb := hY n hn1 hB s w hs0 hsr hw
          have hnorm : ‖2 * ((n : ℂ) + 1) ^ 2 * V (n + 1) w‖ = 2 * ((n : ℝ) + 1) ^ 2 * ‖V (n + 1) w‖ := by
            have e : (2 * ((n : ℂ) + 1) ^ 2) = ((2 * ((n : ℝ) + 1) ^ 2 : ℝ) : ℂ) := by push_cast; ring
            rw [norm_mul, e, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
          rw [hnorm] at hYb
          rw [hcast]
          exact hVstep _ _ n (by linarith) hYb
  intro n s w hs0 hsr hw
  obtain ⟨hq, hv⟩ := hC n n le_rfl s w hs0 hsr hw
  have hF := hF2 s hsr w hw
  obtain ⟨a1, a2, a3⟩ := hA n ((r - s)⁻¹) (P n w) (V n w) _ (z w) (hF1 s hs0 hsr)
    (hebd (χ w) n hF.1) (fun h => by subst h; exact hV0 w)
    (fun h => by subst h; exact ⟨hV1 w, hF.2⟩) hq hv
  exact ⟨a1, a2, a3, hv⟩

theorem ax_rec_majorant : ∀ (h j0 r M : ℝ) (χ ζ ℓ z : ℂ → ℂ), 0 < h → h < 1 / 100 → 0 ≤ j0 → j0 ≤ 1 / 20 → 0 < r → r ≤ 1 / 100 → 20 ≤ M → DifferentiableOn ℂ χ (axRect r) → DifferentiableOn ℂ ζ (axRect r) → DifferentiableOn ℂ ℓ (axRect r) → DifferentiableOn ℂ z (axRect r) → (∀ w ∈ axRect r, ‖χ w‖ ≤ M ∧ ‖ζ w‖ ≤ M ∧ ‖ℓ w‖ ≤ M ∧ ‖z w‖ ≤ M) → ∃ Λ0 A : ℝ, AxMajor h j0 r Λ0 A χ ζ ℓ z :=
by
  intro h j0 r M χ ζ ℓ z hh0 hh1 hj0 hj0' hr0 hr1 hM hχd hζd hℓd hzd hbd

  obtain ⟨E, hE⟩ : ∃ E : ℝ, E = 2 * Real.exp (10 * M / r) + 1 := ⟨_, rfl⟩
  obtain ⟨E', hE'⟩ : ∃ E' : ℝ, E' = 40 * M / r := ⟨_, rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : ℝ, G = M * (7 * E + 12 * M * E * E') := ⟨_, rfl⟩
  obtain ⟨G', hG'⟩ : ∃ G' : ℝ, G' = M * (8 * E' + 60 * E' ^ 2 + 40 * E ^ 2 / (r / 20)) :=
    ⟨_, rfl⟩
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = 2 * (10 * M / r) * G * Real.exp (40 * M / r) := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : ℝ, b = 40 * M * G' / r := ⟨_, rfl⟩
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = max (max E E') (max a b) := ⟨_, rfl⟩
  have hM0 : 0 ≤ M := by linarith
  have hEpos : 0 < E := by rw [hE]; positivity
  have hE'1 : 1 ≤ E' := by rw [hE', le_div_iff₀ hr0]; linarith
  have hE'0 : 0 ≤ E' := by linarith
  have hG0 : 0 ≤ G := by
    rw [hG]
    exact mul_nonneg hM0 (add_nonneg (by linarith)
      (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hM0) hEpos.le) hE'0))
  have hG'0 : 0 ≤ G' := by
    rw [hG']
    exact mul_nonneg hM0 (add_nonneg (add_nonneg (by linarith) (by positivity))
      (div_nonneg (by positivity) (by linarith)))
  have ha0 : 0 ≤ a := by
    rw [ha]
    exact mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) (div_nonneg (by linarith) hr0.le)) hG0)
      (Real.exp_pos _).le
  have hb0 : 0 ≤ b := by
    rw [hb]
    exact div_nonneg (mul_nonneg (by linarith) hG'0) hr0.le
  have hEA : E ≤ A := by rw [hA]; exact le_trans (le_max_left _ _) (le_max_left _ _)
  have hE'A : E' ≤ A := by rw [hA]; exact le_trans (le_max_right _ _) (le_max_left _ _)
  have haA : a ≤ A := by rw [hA]; exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hbA : b ≤ A := by rw [hA]; exact le_trans (le_max_right _ _) (le_max_right _ _)
  have hA0 : 0 ≤ A := le_trans hEpos.le hEA
  clear hA
  refine ⟨max 1 (max a b), A, le_max_left _ _, lt_of_lt_of_le hEpos hEA, ?_⟩
  intro Λ hΛ g hgd hgb
  have hΛ1 : 1 ≤ Λ := le_trans (le_max_left _ _) hΛ
  have hΛ0 : 0 < Λ := by linarith
  have haΛ : a ≤ Λ := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hΛ
  have hbΛ : b ≤ Λ := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hΛ
  subst hb ha hG' hG hE' hE

  have hPV0 : axRecPV h j0 Λ χ ζ ℓ z g 0 = ((fun _ => (1 : ℂ)), (fun _ => (0 : ℂ))) := rfl
  have hlist : ∀ n k : ℕ, k ≤ n →
      axRecList h j0 Λ χ ζ ℓ z g n k = axRecPV h j0 Λ χ ζ ℓ z g k := by
    intro n
    induction n with
    | zero =>
      intro k hk
      obtain rfl : k = 0 := by omega
      rfl
    | succ n ih =>
      intro k hk
      by_cases hkn : k ≤ n
      · show (if k ≤ n then axRecList h j0 Λ χ ζ ℓ z g n k
            else axRecStep h j0 Λ χ ζ ℓ z g (axRecList h j0 Λ χ ζ ℓ z g n) n) = _
        rw [if_pos hkn]
        exact ih k hkn
      · obtain rfl : k = n + 1 := by omega
        rfl
  have hsucc : ∀ n : ℕ, axRecPV h j0 Λ χ ζ ℓ z g (n + 1) =
      axRecStep h j0 Λ χ ζ ℓ z g (axRecList h j0 Λ χ ζ ℓ z g n) n := by
    intro n
    show (if n + 1 ≤ n then axRecList h j0 Λ χ ζ ℓ z g n (n + 1)
        else axRecStep h j0 Λ χ ζ ℓ z g (axRecList h j0 Λ χ ζ ℓ z g n) n) = _
    rw [if_neg (by omega)]
  have hV1 : (axRecPV h j0 Λ χ ζ ℓ z g 1).2 = fun w => -z w / 2 := by
    rw [hsucc 0]
    funext w
    simp [axRecStep, axRecList]

  have hholo : ∀ n : ℕ, DifferentiableOn ℂ (axRecPV h j0 Λ χ ζ ℓ z g n).1 (axRect r) ∧
      DifferentiableOn ℂ (axRecPV h j0 Λ χ ζ ℓ z g n).2 (axRect r) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      cases n with
      | zero =>
        rw [hPV0]
        exact ⟨differentiableOn_const _, differentiableOn_const _⟩
      | succ n =>
        rw [hsucc n]
        exact ax_step_holo h j0 Λ r χ ζ ℓ z g (axRecList h j0 Λ χ ζ ℓ z g n) n hr0 hχd hζd hℓd
          hzd hgd (fun m hm => by rw [hlist n m hm]; exact ih m (by omega))

  have hrealall : (∀ η : ℝ, -1 - r < η → η < 1 + r → (χ (η : ℂ)).im = 0 ∧ (ζ (η : ℂ)).im = 0 ∧
        (ℓ (η : ℂ)).im = 0 ∧ (z (η : ℂ)).im = 0 ∧ (g (η : ℂ)).im = 0) →
      ∀ n : ℕ, ∀ η : ℝ, -1 - r < η → η < 1 + r →
        ((axRecPV h j0 Λ χ ζ ℓ z g n).1 (η : ℂ)).im = 0 ∧
        ((axRecPV h j0 Λ χ ζ ℓ z g n).2 (η : ℂ)).im = 0 := by
    intro hreal n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      cases n with
      | zero =>
        intro η _ _
        rw [hPV0]
        simp
      | succ n =>
        rw [hsucc n]
        exact ax_step_real h j0 Λ r χ ζ ℓ z g (axRecList h j0 Λ χ ζ ℓ z g n) n hr0 hgd
          (fun m hm => by rw [hlist n m hm]; exact hholo m) hreal
          (fun m hm => by rw [hlist n m hm]; exact ih m (by omega))

  have hbd9 := ax_rec_induct r M Λ
    (M * (7 * (2 * Real.exp (10 * M / r) + 1) +
      12 * M * (2 * Real.exp (10 * M / r) + 1) * (40 * M / r)))
    (M * (8 * (40 * M / r) + 60 * (40 * M / r) ^ 2 +
        40 * (2 * Real.exp (10 * M / r) + 1) ^ 2 / (r / 20)))
    χ z (fun n => (axRecPV h j0 Λ χ ζ ℓ z g n).1) (fun n => (axRecPV h j0 Λ χ ζ ℓ z g n).2)
    hr0 hr1 hM0 hE'1 hΛ0 hG0 hG'0 haΛ hbΛ (fun w hw => ⟨(hbd w hw).1, (hbd w hw).2.2.2⟩)
    (fun w => rfl) (fun w => rfl) (fun w => congrFun hV1 w)
    (by
      intro n hpre s w hs0 hsr hw
      have key := ax_src_P h j0 r M Λ (2 * Real.exp (10 * M / r) + 1) (40 * M / r) χ ζ ℓ z g
        (axRecList h j0 Λ χ ζ ℓ z g n) n hh0 hh1 hj0 hj0' hr0 hr1 hM hΛ1 hEpos.le hE'0
        (fun w hw => ⟨(hbd w hw).2.1, (hbd w hw).2.2.1⟩)
        (by rw [hlist n 0 (Nat.zero_le _)] <;> rfl)
        (fun m hm => by rw [hlist n m hm]; exact hholo m)
        (fun m hm => by rw [hlist n m hm]; exact hpre m hm) s w hs0 hsr hw
      rw [hlist n n le_rfl, ← hsucc n] at key
      exact key)
    (by
      intro n hn1 hpre s w hs0 hsr hw
      have key := ax_src_V h j0 r M Λ (2 * Real.exp (10 * M / r) + 1) (40 * M / r) χ ζ ℓ z g
        (axRecList h j0 Λ χ ζ ℓ z g n) n hh0 hh1 hj0 hj0' hr0 hr1 hM hΛ1 hEpos.le hE'0 hn1 hgd
        (fun w hw => ⟨(hbd w hw).2.2.1, hgb w hw⟩)
        (by rw [hlist n 0 (Nat.zero_le _)] <;> rfl)
        (fun m hm => by rw [hlist n m hm]; exact hholo m)
        (fun m hm => by rw [hlist n m hm]; exact hpre m hm) s w hs0 hsr hw
      rw [← hsucc n] at key
      exact key)

  have hrne : r ≠ 0 := hr0.ne'
  have hscale : ∀ (c : ℝ) (n : ℕ), 0 ≤ c →
      c * (r / 20) ^ n / ((n : ℝ) + 1) ^ 2 * ((r - r / 2)⁻¹) ^ n ≤ c * (1 / 10) ^ n := by
    intro c n hc
    have h1 : (r / 20) * (r - r / 2)⁻¹ = 1 / 10 := by
      rw [show r - r / 2 = r / 2 by ring]
      field_simp
      ring
    have h2 : c * (r / 20) ^ n / ((n : ℝ) + 1) ^ 2 * ((r - r / 2)⁻¹) ^ n =
        c * (1 / 10) ^ n / ((n : ℝ) + 1) ^ 2 := by
      rw [← h1, mul_pow]
      ring
    rw [h2]
    apply div_le_self (mul_nonneg hc (by positivity))
    have : (1 : ℝ) ≤ (n : ℝ) + 1 := by
      have := Nat.cast_nonneg (α := ℝ) n
      linarith
    nlinarith
  intro n
  refine ⟨(hholo n).1, (hholo n).2, ?_, fun hr => hrealall hr n⟩
  intro w hw
  have hs0 : (0 : ℝ) ≤ r / 2 := by linarith
  have hsr : r / 2 < r := by linarith
  obtain ⟨b1, b2, b3, b4⟩ := hbd9 n (r / 2) w hs0 hsr hw
  have hp10 : (0 : ℝ) ≤ (1 / 10) ^ n := by positivity
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact le_trans b1 (le_trans (hscale _ n hEpos.le) (mul_le_mul_of_nonneg_right hEA hp10))
  · exact le_trans b2 (le_trans (hscale _ n hE'0) (mul_le_mul_of_nonneg_right hE'A hp10))
  · exact le_trans b3 (le_trans (hscale _ n (div_nonneg ha0 hΛ0.le))
      (mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right haA hΛ0.le) hp10))
  · rcases Nat.lt_or_ge n 2 with hn | hn
    · interval_cases n
      · rw [hPV0]
        simp only [zero_ne_one, if_false, sub_zero, norm_zero]
        exact mul_nonneg (div_nonneg hA0 hΛ0.le) (by positivity)
      · rw [hV1]
        simp only [if_true, sub_self, norm_zero]
        exact mul_nonneg (div_nonneg hA0 hΛ0.le) (by positivity)
    · rw [if_neg (by omega), sub_zero]
      exact le_trans (b4 hn) (le_trans (hscale _ n (div_nonneg hb0 hΛ0.le))
        (mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right hbA hΛ0.le) hp10))

theorem ax_series_contDiff : ∀ (s B : ℝ) (c : ℕ → ℂ → ℂ), 0 < s → 0 ≤ B → (∀ n, DifferentiableOn ℂ (c n) (axRect s)) → (∀ n, ∀ w ∈ axRect s, ‖c n w‖ ≤ B * (1 / 10) ^ n) → ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => ∑' n : ℕ, c n (p.2 : ℂ) * (p.1 : ℂ) ^ n) (Ioo (-5) 5 ×ˢ Ioo (-1 - s / 2) (1 + s / 2)) :=
by

  have hopen : ∀ s : ℝ, IsOpen (axRect s) := by
    intro s
    exact (isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).inter
      ((isOpen_lt continuous_const Complex.continuous_re).inter
        (isOpen_lt Complex.continuous_re continuous_const))

  have hcauchy : ∀ (s t K : ℝ) (f : ℂ → ℂ), t < s → DifferentiableOn ℂ f (axRect s) →
      (∀ w ∈ axRect s, ‖f w‖ ≤ K) → ∀ w ∈ axRect t, ‖deriv f w‖ ≤ 2 * K / (s - t) := by
    intro s t K f hts hf hK w hw
    have hR : 0 < (s - t) / 2 := by linarith
    have hball : Metric.closedBall w ((s - t) / 2) ⊆ axRect s := by
      intro z hz
      rw [Metric.mem_closedBall, dist_eq_norm] at hz
      have h1 := Complex.abs_im_le_norm (z - w)
      have h2 := Complex.abs_re_le_norm (z - w)
      rw [Complex.sub_im] at h1
      rw [Complex.sub_re] at h2
      simp only [axRect, mem_setOf_eq] at hw ⊢
      obtain ⟨hw1, hw2, hw3⟩ := hw
      have a1 := abs_le.mp (le_trans h1 hz)
      have a2 := abs_le.mp (le_trans h2 hz)
      have a3 := abs_lt.mp hw1
      refine ⟨abs_lt.mpr ⟨by linarith, by linarith⟩, by linarith, by linarith⟩
    have hd : DiffContOnCl ℂ f (Metric.ball w ((s - t) / 2)) := by
      apply DifferentiableOn.diffContOnCl
      rw [closure_ball w hR.ne']
      exact hf.mono hball
    have hC := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hR hd
      (fun z hz => hK z (hball (Metric.sphere_subset_closedBall hz)))
    calc ‖deriv f w‖ ≤ K / ((s - t) / 2) := hC
      _ = 2 * K / (s - t) := by rw [div_div_eq_mul_div, mul_comm]

  have hsumm : ∀ k : ℕ, Summable (fun n : ℕ => ((n : ℝ) + 1) ^ k * (1 / 2 : ℝ) ^ n) := by
    intro k
    have h1 := summable_pow_mul_geometric_of_norm_lt_one (R := ℝ) k (r := (1 / 2 : ℝ))
      (by norm_num)
    have h2 := (summable_nat_add_iff 1).mpr h1
    refine (h2.mul_left 2).congr (fun n => ?_)
    push_cast
    ring

  have hfd : ∀ (s B D : ℝ) (k : ℕ) (c : ℕ → ℂ → ℂ), 0 < s → 0 ≤ B → 0 ≤ D →
      (∀ n, DifferentiableOn ℂ (c n) (axRect s)) →
      (∀ n, ∀ w ∈ axRect s, ‖c n w‖ ≤ B * ((n : ℝ) + 1) ^ k * (1 / 10) ^ n) →
      (∀ n, ∀ w ∈ axRect s, ‖deriv (c n) w‖ ≤ D * ((n : ℝ) + 1) ^ k * (1 / 10) ^ n) →
      ∀ p ∈ Ioo (-5 : ℝ) 5 ×ˢ Ioo (-1 - s) (1 + s),
      HasFDerivAt (fun q : ℝ × ℝ => ∑' n : ℕ, c n (q.2 : ℂ) * (q.1 : ℂ) ^ n)
        ((ContinuousLinearMap.fst ℝ ℝ ℝ).smulRight
            (∑' n : ℕ, ((n : ℂ) + 1) * c (n + 1) (p.2 : ℂ) * (p.1 : ℂ) ^ n) +
          (ContinuousLinearMap.snd ℝ ℝ ℝ).smulRight
            (∑' n : ℕ, deriv (c n) (p.2 : ℂ) * (p.1 : ℂ) ^ n)) p := by
    intro s B D k c hs hB hD hdiff hbd hdbd p hp
    have hUo : IsOpen (Ioo (-5 : ℝ) 5 ×ˢ Ioo (-1 - s) (1 + s)) := isOpen_Ioo.prod isOpen_Ioo
    have hUc : IsPreconnected (Ioo (-5 : ℝ) 5 ×ˢ Ioo (-1 - s) (1 + s)) :=
      ((convex_Ioo _ _).prod (convex_Ioo _ _)).isPreconnected
    have hmem : ∀ q ∈ Ioo (-5 : ℝ) 5 ×ˢ Ioo (-1 - s) (1 + s),
        ((q.2 : ℝ) : ℂ) ∈ axRect s ∧ |q.1| < 5 := by
      intro q hq
      obtain ⟨⟨h1, h2⟩, h3, h4⟩ := hq
      refine ⟨?_, abs_lt.mpr ⟨h1, h2⟩⟩
      show |((q.2 : ℝ) : ℂ).im| < s ∧ -1 - s < ((q.2 : ℝ) : ℂ).re ∧ ((q.2 : ℝ) : ℂ).re < 1 + s
      rw [Complex.ofReal_im, Complex.ofReal_re, abs_zero]
      exact ⟨hs, h3, h4⟩

    have hgen : ∀ (E x y : ℝ) (n : ℕ), 0 ≤ E → 0 ≤ x →
        x ≤ E * ((n : ℝ) + 1) ^ k * (1 / 10) ^ n → 0 ≤ y → y ≤ 5 →
        x * y ^ n ≤ E * ((n : ℝ) + 1) ^ (k + 1) * (1 / 2) ^ n := by
      intro E x y n hE hx0 hx hy0 hy5
      have hn : (0 : ℝ) ≤ n := n.cast_nonneg
      have h1 : x * y ^ n ≤ E * ((n : ℝ) + 1) ^ k * (1 / 10) ^ n * 5 ^ n :=
        mul_le_mul hx (pow_le_pow_left₀ hy0 hy5 n) (pow_nonneg hy0 n) (by positivity)
      have h2 : E * ((n : ℝ) + 1) ^ k * (1 / 10) ^ n * 5 ^ n =
          E * ((n : ℝ) + 1) ^ k * (1 / 2) ^ n := by
        rw [mul_assoc, ← mul_pow]; norm_num
      have h3 : ((n : ℝ) + 1) ^ k ≤ ((n : ℝ) + 1) ^ (k + 1) :=
        pow_le_pow_right₀ (by linarith) (Nat.le_succ k)
      calc x * y ^ n ≤ _ := h1
        _ = _ := h2
        _ ≤ E * ((n : ℝ) + 1) ^ (k + 1) * (1 / 2) ^ n := by gcongr
    have hgen2 : ∀ (E x y : ℝ) (m : ℕ), 0 ≤ E → 0 ≤ x →
        x ≤ E * (((m + 1 : ℕ) : ℝ) + 1) ^ k * (1 / 10) ^ (m + 1) → 0 ≤ y → y ≤ 5 →
        ((m + 1 : ℕ) : ℝ) * x * y ^ m ≤ E * (((m + 1 : ℕ) : ℝ) + 1) ^ (k + 1) * (1 / 2) ^ (m + 1) := by
      intro E x y m hE hx0 hx hy0 hy5
      push_cast at hx ⊢
      have hm : (0 : ℝ) ≤ m := m.cast_nonneg
      have hy : y ^ m ≤ 5 ^ m := pow_le_pow_left₀ hy0 hy5 m
      have e : (1 / 10 : ℝ) ^ m * 5 ^ m = (1 / 2) ^ m := by rw [← mul_pow]; norm_num
      have hQ : 0 ≤ E * ((m : ℝ) + 1 + 1) ^ k * (1 / 2) ^ m := by positivity
      calc ((m : ℝ) + 1) * x * y ^ m
          ≤ ((m : ℝ) + 1) * (E * ((m : ℝ) + 1 + 1) ^ k * (1 / 10) ^ (m + 1)) * 5 ^ m := by
            gcongr
        _ = E * ((m : ℝ) + 1 + 1) ^ k * ((m : ℝ) + 1) * ((1 / 10) ^ m * 5 ^ m) / 10 := by ring
        _ = E * ((m : ℝ) + 1 + 1) ^ k * (1 / 2) ^ m * ((m : ℝ) + 1) / 10 := by rw [e]; ring
        _ ≤ E * ((m : ℝ) + 1 + 1) ^ k * (1 / 2) ^ m * (((m : ℝ) + 2) / 2) := by
            nlinarith [mul_nonneg hQ hm]
        _ = E * ((m : ℝ) + 1 + 1) ^ (k + 1) * (1 / 2) ^ (m + 1) := by ring

    let a : ℕ → ℝ × ℝ → ℂ := fun n q => (n : ℂ) * c n (q.2 : ℂ) * (q.1 : ℂ) ^ (n - 1)
    let b : ℕ → ℝ × ℝ → ℂ := fun n q => deriv (c n) (q.2 : ℂ) * (q.1 : ℂ) ^ n
    let L1 := ContinuousLinearMap.smulRightL ℝ (ℝ × ℝ) ℂ (ContinuousLinearMap.fst ℝ ℝ ℝ)
    let L2 := ContinuousLinearMap.smulRightL ℝ (ℝ × ℝ) ℂ (ContinuousLinearMap.snd ℝ ℝ ℝ)
    let f' : ℕ → ℝ × ℝ → (ℝ × ℝ →L[ℝ] ℂ) := fun n q =>
      (ContinuousLinearMap.fst ℝ ℝ ℝ).smulRight (a n q) +
        (ContinuousLinearMap.snd ℝ ℝ ℝ).smulRight (b n q)
    have hterm : ∀ n, ∀ q ∈ Ioo (-5 : ℝ) 5 ×ˢ Ioo (-1 - s) (1 + s),
        HasFDerivAt (fun q : ℝ × ℝ => c n (q.2 : ℂ) * (q.1 : ℂ) ^ n) (f' n q) q := by
      intro n q hq
      have hcn : HasDerivAt (fun y : ℝ => c n (y : ℂ)) (deriv (c n) (q.2 : ℂ)) q.2 :=
        (((hdiff n).differentiableAt ((hopen s).mem_nhds (hmem q hq).1)).hasDerivAt).comp_ofReal
      have hpw : HasDerivAt (fun y : ℝ => (y : ℂ) ^ n) ((n : ℂ) * ((q.1 : ℝ) : ℂ) ^ (n - 1)) q.1 :=
        (hasDerivAt_pow n ((q.1 : ℝ) : ℂ)).comp_ofReal
      have h1 := hcn.hasFDerivAt.comp q hasFDerivAt_snd
      have h2 := hpw.hasFDerivAt.comp q hasFDerivAt_fst
      have h3 : HasFDerivAt (fun q : ℝ × ℝ => c n (q.2 : ℂ) * (q.1 : ℂ) ^ n) _ q := h1.mul h2
      refine h3.congr_fderiv ?_
      refine ContinuousLinearMap.ext (fun v => ?_)
      simp only [f', a, b, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.comp_apply, ContinuousLinearMap.smulRight_apply,
        ContinuousLinearMap.toSpanSingleton_apply,
        ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Function.comp_apply,
        smul_eq_mul, Complex.real_smul]
      ring
    have hab : ∀ n, ∀ q ∈ Ioo (-5 : ℝ) 5 ×ˢ Ioo (-1 - s) (1 + s),
        ‖a n q‖ ≤ B * ((n : ℝ) + 1) ^ (k + 1) * (1 / 2) ^ n ∧
        ‖b n q‖ ≤ D * ((n : ℝ) + 1) ^ (k + 1) * (1 / 2) ^ n := by
      intro n q hq
      obtain ⟨hq1, hq2⟩ := hmem q hq
      have hy0 : 0 ≤ ‖((q.1 : ℝ) : ℂ)‖ := norm_nonneg _
      have hy5 : ‖((q.1 : ℝ) : ℂ)‖ ≤ 5 := by
        rw [Complex.norm_real, Real.norm_eq_abs]; exact hq2.le
      constructor
      · cases n with
        | zero =>
          simp only [a, Nat.cast_zero, zero_mul, norm_zero]
          positivity
        | succ m =>
          show ‖((m + 1 : ℕ) : ℂ) * c (m + 1) (q.2 : ℂ) * ((q.1 : ℝ) : ℂ) ^ (m + 1 - 1)‖ ≤ _
          rw [Nat.add_sub_cancel, norm_mul, norm_mul, norm_pow, Complex.norm_natCast]
          exact hgen2 B _ _ m hB (norm_nonneg _) (hbd (m + 1) _ hq1) hy0 hy5
      · show ‖deriv (c n) (q.2 : ℂ) * ((q.1 : ℝ) : ℂ) ^ n‖ ≤ _
        rw [norm_mul, norm_pow]
        exact hgen D _ _ n hD (norm_nonneg _) (hdbd n _ hq1) hy0 hy5
    have hfb : ∀ n, ∀ q ∈ Ioo (-5 : ℝ) 5 ×ˢ Ioo (-1 - s) (1 + s),
        ‖f' n q‖ ≤ (B + D) * ((n : ℝ) + 1) ^ (k + 1) * (1 / 2) ^ n := by
      intro n q hq
      obtain ⟨ha, hb⟩ := hab n q hq
      calc ‖f' n q‖ ≤ ‖(ContinuousLinearMap.fst ℝ ℝ ℝ).smulRight (a n q)‖ +
            ‖(ContinuousLinearMap.snd ℝ ℝ ℝ).smulRight (b n q)‖ := norm_add_le _ _
        _ = ‖a n q‖ + ‖b n q‖ := by
          rw [ContinuousLinearMap.norm_smulRight_apply,
            ContinuousLinearMap.norm_smulRight_apply, ContinuousLinearMap.norm_fst,
            ContinuousLinearMap.norm_snd, one_mul, one_mul]
        _ ≤ (B + D) * ((n : ℝ) + 1) ^ (k + 1) * (1 / 2) ^ n := by linarith
    have hmaj : ∀ E : ℝ, Summable (fun n : ℕ => E * ((n : ℝ) + 1) ^ (k + 1) * (1 / 2 : ℝ) ^ n) :=
      fun E => ((hsumm (k + 1)).mul_left E).congr (fun n => (mul_assoc _ _ _).symm)
    have hsp : Summable (fun n : ℕ => c n (p.2 : ℂ) * (p.1 : ℂ) ^ n) := by
      refine Summable.of_norm_bounded (hmaj B) (fun n => ?_)
      obtain ⟨hq1, hq2⟩ := hmem p hp
      rw [norm_mul, norm_pow]
      refine hgen B _ _ n hB (norm_nonneg _) (hbd n _ hq1) (norm_nonneg _) ?_
      rw [Complex.norm_real, Real.norm_eq_abs]; exact hq2.le
    have hmain := hasFDerivAt_tsum_of_isPreconnected
      (f := fun n q => c n (q.2 : ℂ) * (q.1 : ℂ) ^ n) (f' := f') (hmaj (B + D)) hUo hUc hterm hfb hp
      hsp hp
    refine hmain.congr_fderiv ?_
    have hsa : Summable (fun n => a n p) :=
      Summable.of_norm_bounded (hmaj B) (fun n => (hab n p hp).1)
    have hsb : Summable (fun n => b n p) :=
      Summable.of_norm_bounded (hmaj D) (fun n => (hab n p hp).2)
    have e1 : HasSum (fun n => f' n p) (L1 (∑' n, a n p) + L2 (∑' n, b n p)) :=
      (hsa.hasSum.mapL L1).add (hsb.hasSum.mapL L2)
    have e2 : ∑' n, a n p = ∑' n : ℕ, ((n : ℂ) + 1) * c (n + 1) (p.2 : ℂ) * (p.1 : ℂ) ^ n := by
      rw [hsa.tsum_eq_zero_add]
      simp only [a, Nat.cast_zero, zero_mul, zero_add]
      refine tsum_congr (fun n => ?_)
      rw [Nat.add_sub_cancel]
      push_cast
      ring
    rw [e1.tsum_eq, e2]
    rfl

  have hprep : ∀ (k : ℕ) (s s' B : ℝ) (c : ℕ → ℂ → ℂ), 0 < s' → s' < s → 0 ≤ B →
      (∀ n, DifferentiableOn ℂ (c n) (axRect s)) →
      (∀ n, ∀ w ∈ axRect s, ‖c n w‖ ≤ B * ((n : ℝ) + 1) ^ k * (1 / 10) ^ n) →
      ∃ s'' D : ℝ, s' < s'' ∧ s'' < s ∧ 0 ≤ D ∧
        (∀ n, DifferentiableOn ℂ (deriv (c n)) (axRect s'')) ∧
        (∀ n, ∀ w ∈ axRect s'', ‖deriv (c n) w‖ ≤ D * ((n : ℝ) + 1) ^ k * (1 / 10) ^ n) ∧
        ∀ p ∈ Ioo (-5 : ℝ) 5 ×ˢ Ioo (-1 - s') (1 + s'),
          HasFDerivAt (fun q : ℝ × ℝ => ∑' n : ℕ, c n (q.2 : ℂ) * (q.1 : ℂ) ^ n)
            ((ContinuousLinearMap.fst ℝ ℝ ℝ).smulRight
                (∑' n : ℕ, ((n : ℂ) + 1) * c (n + 1) (p.2 : ℂ) * (p.1 : ℂ) ^ n) +
              (ContinuousLinearMap.snd ℝ ℝ ℝ).smulRight
                (∑' n : ℕ, deriv (c n) (p.2 : ℂ) * (p.1 : ℂ) ^ n)) p := by
    intro k s s' B c hs' hss hB hdiff hbd
    have hsub : axRect ((s + s') / 2) ⊆ axRect s := by
      intro w hw
      simp only [axRect, mem_setOf_eq] at hw ⊢
      exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
    have hD : 0 ≤ 2 * B / (s - (s + s') / 2) := div_nonneg (by linarith) (by linarith)
    have hdb : ∀ n, ∀ w ∈ axRect ((s + s') / 2),
        ‖deriv (c n) w‖ ≤ 2 * B / (s - (s + s') / 2) * ((n : ℝ) + 1) ^ k * (1 / 10) ^ n := by
      intro n w hw
      have h := hcauchy s ((s + s') / 2) (B * ((n : ℝ) + 1) ^ k * (1 / 10) ^ n) (c n)
        (by linarith) (hdiff n) (hbd n) w hw
      calc _ ≤ _ := h
        _ = _ := by ring
    refine ⟨(s + s') / 2, 2 * B / (s - (s + s') / 2), by linarith, by linarith, hD,
      fun n => ((hdiff n).deriv (hopen s)).mono hsub, hdb, ?_⟩
    intro p hp
    exact hfd ((s + s') / 2) B (2 * B / (s - (s + s') / 2)) k c (by linarith) hB hD
      (fun n => (hdiff n).mono hsub) (fun n w hw => hbd n w (hsub hw)) hdb p
      ⟨hp.1, ⟨by linarith [hp.2.1], by linarith [hp.2.2]⟩⟩

  have hQ : ∀ m : ℕ, ∀ (k : ℕ) (s s' B : ℝ) (c : ℕ → ℂ → ℂ), 0 < s' → s' < s → 0 ≤ B →
      (∀ n, DifferentiableOn ℂ (c n) (axRect s)) →
      (∀ n, ∀ w ∈ axRect s, ‖c n w‖ ≤ B * ((n : ℝ) + 1) ^ k * (1 / 10) ^ n) →
      ContDiffOn ℝ m (fun q : ℝ × ℝ => ∑' n : ℕ, c n (q.2 : ℂ) * (q.1 : ℂ) ^ n)
        (Ioo (-5 : ℝ) 5 ×ˢ Ioo (-1 - s') (1 + s')) := by
    intro m
    induction m with
    | zero =>
      intro k s s' B c hs' hss hB hdiff hbd
      obtain ⟨s'', D, -, -, -, -, -, hF⟩ := hprep k s s' B c hs' hss hB hdiff hbd
      rw [Nat.cast_zero, contDiffOn_zero]
      exact fun p hp => (hF p hp).continuousAt.continuousWithinAt
    | succ m ih =>
      intro k s s' B c hs' hss hB hdiff hbd
      obtain ⟨s'', D, h1, h2, hD, hdd, hdb, hF⟩ := hprep k s s' B c hs' hss hB hdiff hbd
      have hBox : IsOpen (Ioo (-5 : ℝ) 5 ×ˢ Ioo (-1 - s') (1 + s')) := isOpen_Ioo.prod isOpen_Ioo
      have hbt : ∀ n : ℕ, ∀ w ∈ axRect s,
          ‖((n : ℂ) + 1) * c (n + 1) w‖ ≤ B * 2 ^ k * ((n : ℝ) + 1) ^ (k + 1) * (1 / 10) ^ n := by
        intro n w hw
        have hc := hbd (n + 1) w hw
        push_cast at hc
        have hn : (0 : ℝ) ≤ n := n.cast_nonneg
        have hnorm : ‖(n : ℂ) + 1‖ = (n : ℝ) + 1 := by
          exact_mod_cast Complex.norm_natCast (n + 1)
        rw [norm_mul, hnorm]
        have h2k : ((n : ℝ) + 1 + 1) ^ k ≤ 2 ^ k * ((n : ℝ) + 1) ^ k := by
          rw [← mul_pow]; exact pow_le_pow_left₀ (by linarith) (by linarith) k
        have h10 : (1 / 10 : ℝ) ^ (n + 1) ≤ (1 / 10) ^ n :=
          pow_le_pow_of_le_one (by norm_num) (by norm_num) (Nat.le_succ n)
        calc ((n : ℝ) + 1) * ‖c (n + 1) w‖
            ≤ ((n : ℝ) + 1) * (B * ((n : ℝ) + 1 + 1) ^ k * (1 / 10) ^ (n + 1)) := by gcongr
          _ ≤ ((n : ℝ) + 1) * (B * (2 ^ k * ((n : ℝ) + 1) ^ k) * (1 / 10) ^ n) := by gcongr
          _ = B * 2 ^ k * ((n : ℝ) + 1) ^ (k + 1) * (1 / 10) ^ n := by ring
      have hct := ih (k + 1) s s' (B * 2 ^ k) (fun n w => ((n : ℂ) + 1) * c (n + 1) w) hs' hss
        (by positivity) (fun n => (hdiff (n + 1)).const_mul _) hbt
      have hcd := ih k s'' s' D (fun n w => deriv (c n) w) hs' h1 hD hdd hdb
      rw [Nat.cast_succ, contDiffOn_succ_iff_fderiv_of_isOpen hBox]
      refine ⟨fun p hp => (hF p hp).differentiableAt.differentiableWithinAt,
        fun h => absurd h (WithTop.natCast_ne_top m), ?_⟩
      have hG := ((contDiffOn_const (c := ContinuousLinearMap.fst ℝ ℝ ℝ)).smulRight hct).add
        ((contDiffOn_const (c := ContinuousLinearMap.snd ℝ ℝ ℝ)).smulRight hcd)
      exact hG.congr (fun p hp => (hF p hp).fderiv)

  intro s B c hs hB hdiff hbd
  refine contDiffOn_infty.mpr (fun m => ?_)
  exact hQ m 0 s (s / 2) B c (by linarith) (by linarith) hB hdiff
    (fun n w hw => by rw [pow_zero, mul_one]; exact hbd n w hw)

theorem ax_f0_ge_fifth : ∀ z : ℝ, 0 ≤ z → z ≤ 23 / 5 → 1 / 5 ≤ axF0 z :=
by

  have leib : ∀ (k M : ℕ) (t : ℝ), 0 ≤ t → t ≤ ((M : ℝ) + 1) * ((M : ℝ) + 1 + (k : ℝ)) →
      0 ≤ (-1) ^ M * ((∑' n : ℕ, (-t) ^ n / ((Nat.factorial n : ℝ) * (Nat.factorial (n + k) : ℝ))) -
        ∑ n ∈ Finset.range M, (-t) ^ n / ((Nat.factorial n : ℝ) * (Nat.factorial (n + k) : ℝ))) := by
    intro k M t ht0 htM
    set a : ℕ → ℝ := fun n => t ^ n / ((Nat.factorial n : ℝ) * (Nat.factorial (n + k) : ℝ)) with ha
    have hterm : ∀ n, (-t) ^ n / ((Nat.factorial n : ℝ) * (Nat.factorial (n + k) : ℝ)) = (-1) ^ n * a n := by
      intro n; simp only [ha]; rw [neg_pow, mul_div_assoc]
    have ha0 : ∀ n, 0 ≤ a n := fun n => by simp only [ha]; positivity
    have hsum_a : Summable a := by
      refine Summable.of_nonneg_of_le ha0 (fun n => ?_) (Real.summable_pow_div_factorial t)
      simp only [ha]
      have h1 : (1:ℝ) ≤ (Nat.factorial (n + k) : ℝ) := by
        exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero _)
      have h2 : (0:ℝ) < (Nat.factorial n : ℝ) := by positivity
      apply div_le_div_of_nonneg_left (by positivity) h2
      nlinarith
    have hsum : Summable (fun n => (-1:ℝ) ^ n * a n) := by
      refine Summable.of_norm_bounded hsum_a (fun n => ?_)
      rw [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul, Real.norm_of_nonneg (ha0 n)]
    simp_rw [hterm]
    rw [← hsum.sum_add_tsum_nat_add M, add_sub_cancel_left, ← tsum_mul_left]
    have hsq : ((-1:ℝ) ^ M) ^ 2 = 1 := by
      rw [← pow_mul, mul_comm, pow_mul]; norm_num
    have e : ∀ i, (-1:ℝ) ^ M * ((-1) ^ (i + M) * a (i + M)) = (-1) ^ i * a (i + M) := by
      intro i; rw [pow_add]; linear_combination ((-1:ℝ) ^ i * a (i + M)) * hsq
    simp_rw [e]
    have hrec : ∀ n, a (n + 1) * (((n:ℝ) + 1) * ((n:ℝ) + 1 + k)) = t * a n := by
      intro n
      simp only [ha]
      rw [show n + 1 + k = (n + k) + 1 by ring, Nat.factorial_succ, Nat.factorial_succ]
      have h1 : (n.factorial : ℝ) ≠ 0 := by positivity
      have h2 : ((n + k).factorial : ℝ) ≠ 0 := by positivity
      push_cast
      field_simp
      ring
    have hanti : Antitone (fun i => a (i + M)) := by
      apply antitone_nat_of_succ_le
      intro i
      have hr := hrec (i + M)
      have hP : (0:ℝ) < (((i + M : ℕ) : ℝ) + 1) * (((i + M : ℕ) : ℝ) + 1 + k) := by positivity
      have hle : t ≤ (((i + M : ℕ) : ℝ) + 1) * (((i + M : ℕ) : ℝ) + 1 + k) := by
        push_cast
        have hi : (0:ℝ) ≤ i := Nat.cast_nonneg i
        have hk : (0:ℝ) ≤ k := Nat.cast_nonneg k
        have hM : (0:ℝ) ≤ M := Nat.cast_nonneg M
        nlinarith
      have h0 := ha0 (i + M)
      show a (i + 1 + M) ≤ a (i + M)
      rw [show i + 1 + M = i + M + 1 by ring]
      by_contra hcon
