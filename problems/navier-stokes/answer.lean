    have p4 := hexp _ _ _ _ (hsh _ _ _ p3) hE2
    rw [ht6]
    exact hmono _ _ _ _ p4 (by norm_num)

  refine ⟨4/5, ?_⟩
  have K1 := hlin _ _ (4/5) _ (-1) (-1) t1 t2 (fun ξ => -t1 ξ - t2 ξ) hT1 hT2 le_rfl le_rfl
    (fun ξ _ => by (try dsimp only); ring)
  have K2 := hlin _ _ (4/5) _ 1 (-1) _ t3 (fun ξ => -t1 ξ - t2 ξ - t3 ξ) K1 hT3 le_rfl le_rfl
    (fun ξ _ => by (try dsimp only); ring)
  have K3 := hlin _ _ (4/5) _ 1 (-1) _ t4 (fun ξ => -t1 ξ - t2 ξ - t3 ξ - t4 ξ) K2 hT4 le_rfl
    le_rfl (fun ξ _ => by (try dsimp only); ring)
  have K4 := hlin _ _ (4/5) _ 1 1 _ t5 (fun ξ => -t1 ξ - t2 ξ - t3 ξ - t4 ξ + t5 ξ) K3 hT5
    le_rfl le_rfl (fun ξ _ => by (try dsimp only); ring)
  have K5 := hlin _ _ (4/5) _ 1 1 _ t6
    (fun ξ => -t1 ξ - t2 ξ - t3 ξ - t4 ξ + t5 ξ + t6 ξ) K4 hT6
    le_rfl le_rfl (fun ξ _ => by (try dsimp only); ring)
  refine hlin _ _ (4/5) _ 1 0 _ _ _ K5 K5 le_rfl le_rfl (fun ξ _ => ?_)
  subst ht1 ht2 ht3 ht4 ht5 ht6
  subst hF1 hF2 hF3
  simp only [grP5]
  ring

theorem wave_increment_mean_orders_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
    l1 ≤ l0 → ∀ (S : CState) (Bo : ℝ) (D : WC) (E : WS), 7/10 ≤ Bo →
    StOrd5 B G l0 S Bo (Bo + 1/2) (Bo + 1/2) (Bo + 1/2) →
    InWg5 B G (qsOf l0) (Bo + 1/2) D → InWg5 B G (qsOf l0) Bo (velW5 B G D) →
    (∀ (a : Fin 3), ∀ ξ ∈ DomC B.h (qsOf l0), mcor5 B G l0 (waveAdd S D E) a ξ = mcor5 B G l0 S a ξ) →
    InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h + 1/2) (EthP5 B G l0 (waveAdd S D E))) ∧
    InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h + 1/2) (EzP5 B G l0 (waveAdd S D E))) ∧
    InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h + 1/2) (yAvg (EthP5 B G l0 (waveAdd S D E)))) ∧
    InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h + 1/2) (yAvg (EzP5 B G l0 (waveAdd S D E)))) ∧
    InS B (qsOf l0) (Bo + 1/2 - kapS) (nrmS B (2 * Aex B.h) (calP5 B G l0 (waveAdd S D E))) ∧
    InS B (qsOf l0) (Bo + 1/2 - kapS) (nrmS B (2 * Aex B.h - 3/2) (calJth5 B G l0 (waveAdd S D E))) ∧
    InS B (qsOf l0) (Bo + 1/2 - kapS) (nrmS B (2 * Aex B.h - 1) (calJz5 B G l0 (waveAdd S D E))) ∧
    InM B (qsOf l0) (Bo + 1/2 - kapS)
      (nrm B (2 * Aex B.h) (fun ξ => pmP5 B G l0 (waveAdd S D E) ξ - pmP5 B G l0 S ξ)) ∧
    ∃ α : ℝ, InM B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) (grP5 B G l0 (waveAdd S D E))) :=
by
  intro B G hok hG
  have hh0 : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  have hSN : SimNorm B.h := simscale_normalized_v4 B.h hh0 hh1 hok.1
  obtain ⟨l2, h2⟩ := wmo_velocity_split_v5 B G hok hG
  obtain ⟨l3, h3⟩ := wave_theta_pair_v5 B G hok hG
  obtain ⟨l4, h4⟩ := wmo_pair_class_v5 B G hok hG
  obtain ⟨l5, h5⟩ := wmo_amp_class_v5 B G hok hG
  obtain ⟨l6, h6⟩ := wmo_radial_calculus_v5 B hok hSN
  obtain ⟨l7, h7⟩ := wmo_change_identities_v5 B G hok
  obtain ⟨l8, h8⟩ := wmo_state_grP_class_v5 B G hok
  obtain ⟨l9, h9⟩ := mom_radial_moment_class_v4 B hok hSN
  obtain ⟨l10, h10⟩ := mom_icut_class_v4 B hok hSN
  refine ⟨l2 + l3 + l4 + l5 + l6 + l7 + l8 + l9 + l10, ?_⟩
  intro l0 hl0 S Bo D E hBo hS hD hDv hMI
  have hS' := hS
  unfold StOrd5 at hS'
  obtain ⟨c1, -, c3, c4, -, -, -, c8, c9, c10, c11, c12, c13, c14, -, c16, -, c18, c19, c20, c21, -, -⟩ :=
    hS'
  have hk : kapS = 1 / 100000 := rfl
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  have hqs0 : 0 < qsOf l0 := by
    show (0:ℝ) < (2:ℝ) ^ (-(l0:ℝ))
    positivity
  obtain ⟨LM, LS⟩ := mom_class_algebra_v4 B (qsOf l0) hok hqs0 hqs1

  have lc3 : ∀ (α1 α2 α3 γ c1' c2' c3' : ℝ) (f1 f2 f3 k : Cyl → ℝ),
      InM B (qsOf l0) α1 f1 → InM B (qsOf l0) α2 f2 → InM B (qsOf l0) α3 f3 →
      γ ≤ α1 → γ ≤ α2 → γ ≤ α3 →
      (∀ ξ ∈ DomC B.h (qsOf l0), k ξ = c1' * f1 ξ + c2' * f2 ξ + c3' * f3 ξ) → InM B (qsOf l0) γ k := by
    intro α1 α2 α3 γ c1' c2' c3' f1 f2 f3 k e1 e2 e3 g1 g2 g3 hk'
    have e12 := LM α1 α2 γ c1' c2' f1 f2 (fun ξ => c1' * f1 ξ + c2' * f2 ξ) e1 e2 g1 g2 (fun _ _ => rfl)
    exact LM γ α3 γ 1 c3' _ f3 k e12 e3 le_rfl g3 (fun ξ hξ => by rw [hk' ξ hξ]; ring)
  have lc4 : ∀ (α1 α2 α3 α4 γ c1' c2' c3' c4' : ℝ) (f1 f2 f3 f4 k : Cyl → ℝ),
      InM B (qsOf l0) α1 f1 → InM B (qsOf l0) α2 f2 → InM B (qsOf l0) α3 f3 → InM B (qsOf l0) α4 f4 →
      γ ≤ α1 → γ ≤ α2 → γ ≤ α3 → γ ≤ α4 →
      (∀ ξ ∈ DomC B.h (qsOf l0), k ξ = c1' * f1 ξ + c2' * f2 ξ + c3' * f3 ξ + c4' * f4 ξ) →
      InM B (qsOf l0) γ k := by
    intro α1 α2 α3 α4 γ c1' c2' c3' c4' f1 f2 f3 f4 k e1 e2 e3 e4 g1 g2 g3 g4 hk'
    have e123 := lc3 α1 α2 α3 γ c1' c2' c3' f1 f2 f3 (fun ξ => c1' * f1 ξ + c2' * f2 ξ + c3' * f3 ξ)
      e1 e2 e3 g1 g2 g3 (fun _ _ => rfl)
    exact LM γ α4 γ 1 c4' _ f4 k e123 e4 le_rfl g4 (fun ξ hξ => by rw [hk' ξ hξ]; ring)

  have thA_cmul : ∀ (K : ℝ) (F : ℝ → ℝ), thA (fun θ => K * F θ) = K * thA F := by
    intro K F; unfold thA; rw [intervalIntegral.integral_const_mul]; ring
  have thA_add : ∀ F1 F2 : ℝ → ℝ, Continuous F1 → Continuous F2 →
      thA (fun θ => F1 θ + F2 θ) = thA F1 + thA F2 := by
    intro F1 F2 e1 e2; unfold thA
    rw [intervalIntegral.integral_add (e1.intervalIntegrable _ _) (e2.intervalIntegrable _ _)]; ring
  have thA_congr : ∀ F1 F2 : ℝ → ℝ, (∀ θ, F1 θ = F2 θ) → thA F1 = thA F2 := by
    intro F1 F2 e; have : F1 = F2 := funext e
    rw [this]
  have thA_aff : ∀ (c K : ℝ) (F : ℝ → ℝ), Continuous F → thA F = 0 → thA (fun θ => c + K * F θ) = c := by
    intro c K F hF h0
    have hpi := Real.pi_pos
    have hI : ∫ θ in (0:ℝ)..2 * Real.pi, F θ = 0 := by
      unfold thA at h0
      rcases mul_eq_zero.mp h0 with e | e
      · exact absurd e (by positivity)
      · exact e
    unfold thA
    rw [intervalIntegral.integral_add intervalIntegrable_const ((hF.const_mul K).intervalIntegrable _ _),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const, hI, smul_eq_mul, sub_zero,
      mul_zero, add_zero]
    field_simp

  obtain ⟨h5a, h5b⟩ := h5 l0 (by omega)
  set A0 := wmoAmp5 B G S.Aw with hA0
  set AD := wmoAmp5 B G D with hAD
  have hA0c : InWg5 B G (qsOf l0) (1/2) A0 := by
    have e : (1/2 : ℝ) + 1/2 = 1 := by norm_num
    exact h5a S.Aw (1/2) (by rw [e]; exact c1) c16
  have hADc : InWg5 B G (qsOf l0) Bo AD := h5a D Bo hD hDv
  have hwv : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ (θ : ℝ) (i : Fin 3),
      waveV5 B G (wmoAmp5 B G (S.Aw + D)) θ ξ i = waveV5 B G (A0 + AD) θ ξ i := by
    intro ξ hξ θ i
    simp only [waveV5]
    congr 1
    refine finsum_congr (fun γ => finsum_congr (fun m => ?_))
    rw [h5b S.Aw D 1 (Bo + 1/2) c1 hD γ m ξ hξ]
    rfl
  have hpairOK : ∀ (a b : WC) (α β : ℝ), InWg5 B G (qsOf l0) α a → InWg5 B G (qsOf l0) β b →
      ∀ ξ ∈ DomC B.h (qsOf l0), ∀ i j : Fin 3,
      Continuous (fun θ => waveV5 B G a θ ξ i) ∧ thA (fun θ => waveV5 B G a θ ξ i) = 0 ∧
      (∀ θ, waveV5 B G (a + b) θ ξ i = waveV5 B G a θ ξ i + waveV5 B G b θ ξ i) ∧
      thA (fun θ => waveV5 B G a θ ξ i * waveV5 B G b θ ξ j) = wmoPair5 a b i j ξ := by
    intro a b α β ha hb
    obtain ⟨Ha, Ha0, Hav⟩ := ha.1
    obtain ⟨Hb, Hb0, Hbv⟩ := hb.1
    refine h3 l0 (by omega) a b ⟨Ha ∪ Hb, by simp [Ha0, Hb0], fun γ m hm =>
      ⟨Hav γ m (fun h => hm (Finset.mem_union_left _ h)), Hbv γ m (fun h => hm (Finset.mem_union_right _ h))⟩⟩
      (fun γ m => ⟨(ha.2.1 γ m).continuousOn, (hb.2.1 γ m).continuousOn⟩)
      (fun γ m ξ hξ => ⟨ha.2.2.2.1 γ m ξ hξ, hb.2.2.2.1 γ m ξ hξ⟩)

  have hcov : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ a b : Fin 3,
      Wcov5 B G l0 S a b ξ = (qC B.h ξ ^ (-Aex B.h)) ^ 2 * wmoPair5 A0 A0 a b ξ ∧
      Wcov5 B G l0 (waveAdd S D E) a b ξ = (qC B.h ξ ^ (-Aex B.h)) ^ 2 *
        (wmoPair5 A0 A0 a b ξ + wmoPair5 A0 AD a b ξ + wmoPair5 AD A0 a b ξ + wmoPair5 AD AD a b ξ) := by
    intro ξ hξ a b
    have P00 := fun i j => hpairOK A0 A0 _ _ hA0c hA0c ξ hξ i j
    have P01 := fun i j => hpairOK A0 AD _ _ hA0c hADc ξ hξ i j
    have P10 := fun i j => hpairOK AD A0 _ _ hADc hA0c ξ hξ i j
    have P11 := fun i j => hpairOK AD AD _ _ hADc hADc ξ hξ i j
    have cf : ∀ i, Continuous (fun θ => waveV5 B G A0 θ ξ i) := fun i => (P00 i i).1
    have cg : ∀ i, Continuous (fun θ => waveV5 B G AD θ ξ i) := fun i => (P11 i i).1
    have mf : ∀ i, thA (fun θ => waveV5 B G A0 θ ξ i) = 0 := fun i => (P00 i i).2.1
    have mg : ∀ i, thA (fun θ => waveV5 B G AD θ ξ i) = 0 := fun i => (P11 i i).2.1
    have sp := fun θ i => h2 l0 (by omega) S D E 1 (Bo + 1/2) c1 hD c3 c4 ξ hξ θ i
    set K := qC B.h ξ ^ (-Aex B.h) with hK
    have uS : ∀ i θ, ucyl5 B G l0 S θ ξ i = ucyl5 B G l0 (wmoBase S) 0 ξ i + K * waveV5 B G A0 θ ξ i :=
      fun i θ => (sp θ i).1
    have uS1 : ∀ i θ, ucyl5 B G l0 (waveAdd S D E) θ ξ i =
        ucyl5 B G l0 (wmoBase S) 0 ξ i + K * (waveV5 B G A0 θ ξ i + waveV5 B G AD θ ξ i) := by
      intro i θ
      rw [(sp θ i).2, hwv ξ hξ θ i, (P01 i i).2.2.1 θ]
    have meanS : ∀ i, thA (fun θ => ucyl5 B G l0 S θ ξ i) = ucyl5 B G l0 (wmoBase S) 0 ξ i := by
      intro i
      rw [thA_congr _ _ (uS i)]
      exact thA_aff _ _ _ (cf i) (mf i)
    have meanS1 : ∀ i, thA (fun θ => ucyl5 B G l0 (waveAdd S D E) θ ξ i) =
        ucyl5 B G l0 (wmoBase S) 0 ξ i := by
      intro i
      rw [thA_congr _ _ (uS1 i)]
      exact thA_aff _ _ (fun θ => waveV5 B G A0 θ ξ i + waveV5 B G AD θ ξ i) ((cf i).add (cg i))
        (by rw [thA_add _ _ (cf i) (cg i), mf i, mg i, add_zero])
    constructor
    · unfold Wcov5
      rw [meanS a, meanS b,
        thA_congr _ (fun θ => K ^ 2 * (waveV5 B G A0 θ ξ a * waveV5 B G A0 θ ξ b))
          (fun θ => by rw [uS a θ, uS b θ]; ring),
        thA_cmul, (P00 a b).2.2.2]
    · unfold Wcov5
      rw [meanS1 a, meanS1 b,
        thA_congr _ (fun θ => K ^ 2 * ((waveV5 B G A0 θ ξ a * waveV5 B G A0 θ ξ b +
            waveV5 B G A0 θ ξ a * waveV5 B G AD θ ξ b) +
            (waveV5 B G AD θ ξ a * waveV5 B G A0 θ ξ b + waveV5 B G AD θ ξ a * waveV5 B G AD θ ξ b)))
          (fun θ => by rw [uS1 a θ, uS1 b θ]; ring),
        thA_cmul,
        thA_add (fun θ => waveV5 B G A0 θ ξ a * waveV5 B G A0 θ ξ b +
            waveV5 B G A0 θ ξ a * waveV5 B G AD θ ξ b)
          (fun θ => waveV5 B G AD θ ξ a * waveV5 B G A0 θ ξ b + waveV5 B G AD θ ξ a * waveV5 B G AD θ ξ b)
          (((cf a).mul (cf b)).add ((cf a).mul (cg b))) (((cg a).mul (cf b)).add ((cg a).mul (cg b))),
        thA_add (fun θ => waveV5 B G A0 θ ξ a * waveV5 B G A0 θ ξ b)
          (fun θ => waveV5 B G A0 θ ξ a * waveV5 B G AD θ ξ b) ((cf a).mul (cf b)) ((cf a).mul (cg b)),
        thA_add (fun θ => waveV5 B G AD θ ξ a * waveV5 B G A0 θ ξ b)
          (fun θ => waveV5 B G AD θ ξ a * waveV5 B G AD θ ξ b) ((cg a).mul (cf b)) ((cg a).mul (cg b)),
        (P00 a b).2.2.2, (P01 a b).2.2.2, (P10 a b).2.2.2, (P11 a b).2.2.2]
      ring
  have hqK : ∀ ξ ∈ DomC B.h (qsOf l0), qC B.h ξ ^ (2 * Aex B.h) * (qC B.h ξ ^ (-Aex B.h)) ^ 2 = 1 := by
    intro ξ hξ
    obtain ⟨-, e2, -⟩ := hξ
    have hq : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    rw [← Real.rpow_natCast, ← Real.rpow_mul hq.le, ← Real.rpow_add hq]
    have e : 2 * Aex B.h + -Aex B.h * ((2:ℕ):ℝ) = 0 := by push_cast; ring
    rw [e, Real.rpow_zero]

  have hP : ∀ (a b : WC) (α β : ℝ), InWg5 B G (qsOf l0) α a → InWg5 B G (qsOf l0) β b →
      ∀ i j : Fin 3, InM B (qsOf l0) (α + β) (wmoPair5 a b i j) := h4 l0 (by omega)
  have hWS : ∀ a b : Fin 3, InM B (qsOf l0) 1 (nrm B (2 * Aex B.h) (Wcov5 B G l0 S a b)) := by
    intro a b
    have e := hP A0 A0 _ _ hA0c hA0c a b
    refine LM _ _ 1 1 0 _ _ _ e e (by norm_num) (by norm_num) (fun ξ hξ => ?_)
    simp only [nrm]
    rw [(hcov ξ hξ a b).1]
    linear_combination (wmoPair5 A0 A0 a b ξ) * hqK ξ hξ
  have hdW : ∀ a b : Fin 3, InM B (qsOf l0) (Bo + 1/2)
      (nrm B (2 * Aex B.h) (fun η => Wcov5 B G l0 (waveAdd S D E) a b η - Wcov5 B G l0 S a b η)) := by
    intro a b
    refine lc3 _ _ _ _ 1 1 1 _ _ _ _ (hP A0 AD _ _ hA0c hADc a b) (hP AD A0 _ _ hADc hA0c a b)
      (hP AD AD _ _ hADc hADc a b) (by linarith) (by linarith) (by linarith) (fun ξ hξ => ?_)
    simp only [nrm]
    rw [(hcov ξ hξ a b).1, (hcov ξ hξ a b).2]
    linear_combination (wmoPair5 A0 AD a b ξ + wmoPair5 AD A0 a b ξ + wmoPair5 AD AD a b ξ) * hqK ξ hξ
  have hWS1 : ∀ a b : Fin 3, InM B (qsOf l0) 1 (nrm B (2 * Aex B.h) (Wcov5 B G l0 (waveAdd S D E) a b)) := by
    intro a b
    refine LM _ _ 1 1 1 _ _ _ (hWS a b) (hdW a b) le_rfl (by linarith) (fun ξ _ => ?_)
    simp only [nrm]; ring

  have hmcor : ∀ a : Fin 3, ∃ α : ℝ, InM B (qsOf l0) α (nrm B (Aex B.h) (mcor5 B G l0 S a)) := by
    intro a
    fin_cases a
    · exact ⟨_, c21⟩
    · exact ⟨_, c18⟩
    · exact ⟨_, c19⟩
  have hch := h7 l0 (by omega) S (waveAdd S D E) hMI hmcor (fun a b => ⟨⟨1, hWS a b⟩, ⟨1, hWS1 a b⟩⟩)
  have R := fun a b => h6 l0 (by omega) _ (2 * Aex B.h) (Bo + 1/2) (hdW a b)

  have hdg : InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h + 1/2)
      (fun η => grP5 B G l0 (waveAdd S D E) η - grP5 B G l0 S η)) := by
    refine lc4 _ _ _ _ _ (-1) (-1) (-1) 1 _ _ _ _ _ (R 0 0).1 (R 0 0).2.2.1 (R 2 0).2.1 (R 1 1).2.2.1
      le_rfl (by linarith) (by rw [hk]; linarith) (by linarith) (fun ξ hξ => ?_)
    simp only [nrm]
    rw [(hch ξ hξ).2.1]
    ring

  have hpm : InM B (qsOf l0) (Bo + 1/2 - kapS)
      (nrm B (2 * Aex B.h) (fun ξ => pmP5 B G l0 (waveAdd S D E) ξ - pmP5 B G l0 S ξ)) := by
    have e := h10 l0 (by omega) _ _ hdg
    refine LM _ _ _ 1 0 _ _ _ e e le_rfl le_rfl (fun ξ hξ => ?_)
    simp only [nrm]
    rw [(hch ξ hξ).2.2.2.2.2.2]
    ring

  have hdEth : InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h + 1/2)
      (fun η => EthP5 B G l0 (waveAdd S D E) η - EthP5 B G l0 S η)) := by
    refine lc3 _ _ _ _ 1 2 1 _ _ _ _ (R 0 1).1 (R 0 1).2.2.1 (R 2 1).2.1
      le_rfl (by rw [hk]; linarith) (by rw [hk]; linarith) (fun ξ hξ => ?_)
    simp only [nrm]
    rw [(hch ξ hξ).1]
    ring
  have hEth : InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h + 1/2) (EthP5 B G l0 (waveAdd S D E))) := by
    refine LM _ _ _ 1 1 _ _ _ c8 hdEth (by rw [hk]; linarith) le_rfl (fun ξ _ => ?_)
    simp only [nrm]; ring

  have hpm1 : ∃ α : ℝ, InM B (qsOf l0) α (nrm B (2 * Aex B.h) (pmP5 B G l0 (waveAdd S D E))) := by
    refine ⟨0.9, LM _ _ _ 1 1 _ _ _ c20 hpm le_rfl (by rw [hk]; norm_num; linarith) (fun ξ _ => ?_)⟩
    simp only [nrm]; ring
  have hZp : InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h)
      (fun η => (Wcov5 B G l0 (waveAdd S D E) 2 2 η - Wcov5 B G l0 S 2 2 η) +
        (pmP5 B G l0 (waveAdd S D E) η - pmP5 B G l0 S η))) := by
    refine LM _ _ _ 1 1 _ _ _ (hdW 2 2) hpm (by rw [hk]; linarith) le_rfl (fun ξ _ => ?_)
    simp only [nrm]; ring
  have RZ := h6 l0 (by omega) _ _ _ hZp
  have hdEz : InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h + 1/2)
      (fun η => EzP5 B G l0 (waveAdd S D E) η - EzP5 B G l0 S η)) := by
    refine lc3 _ _ _ _ 1 1 1 _ _ _ _ (R 0 2).1 (R 0 2).2.2.1 RZ.2.1
      le_rfl (by rw [hk]; linarith) (by rw [hk]; linarith) (fun ξ hξ => ?_)
    simp only [nrm]
    rw [(hch ξ hξ).2.2.1 ⟨0.9, c20⟩ hpm1]
    ring
  have hEz : InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h + 1/2) (EzP5 B G l0 (waveAdd S D E))) := by
    refine LM _ _ _ 1 1 _ _ _ c9 hdEz (by rw [hk]; linarith) le_rfl (fun ξ _ => ?_)
