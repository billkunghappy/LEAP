    · have hx : 2 * F5 * (n⁻¹ * (F5 * -a)) = -(2 * F5 ^ 2 * a) / n := by field_simp
      have hV' : a * (a * (1 + (b / a) ^ 2) - 2) = a ^ 2 + b ^ 2 - 2 * a := by field_simp
