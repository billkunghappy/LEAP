  have e2 : iteratedFDeriv ℝ k (fun ζ' : ℝ × ℝ × (ℝ × ℝ) => M (pr ζ')) ζ v =
      iteratedFDeriv ℝ k M (ζ.1, ζ.2.1) (fun i => ((v i).1, (v i).2.1)) := by
    have hc := ContinuousLinearMap.iteratedFDerivWithin_comp_right (x := ζ) (i := k) pr hM
      hΩ2.uniqueDiffOn hΩ3'.uniqueDiffOn hmem2 (by exact_mod_cast le_top)
    have h1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := M ∘ pr) k hΩ3'
