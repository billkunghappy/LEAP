    have hρ : pang5 B G γ / RC γ.1 η = A / (ξ.1⁻¹ * s.1) := by
      rw [hAdef]
      unfold RC
      rw [hη1]
      field_simp
    rw [hρ, ← hβdef, ← hpdef] at hn
    rw [hLs s]
    funext i
    fin_cases i <;> simp [Bcol5, ntan5, hΦ, hn, hvη, hκdef]

  have hev : (fun s : ℝ × ℝ × ℝ => G.tH γ s 0) =ᶠ[nhds (ξ.1, ξ.2.1, ξ.2.2.1)]
      Penv5 B G γ 0 • (fun s => Φ (aa + L s)) :=
    Filter.eventuallyEq_of_mem (hUo.mem_nhds hs0U) (fun s hs => hident s hs)
  have hz0O : aa + L (ξ.1, ξ.2.1, ξ.2.2.1) ∈ O := by rw [hz0]; exact hKO hz0K
