    intro x hx
    rcases eq_or_lt_of_le hx with h0 | hpos
    · subst h0
      have hne : (-h : ℝ) ≠ 0 := neg_ne_zero.mpr hh0.ne'
      simp [Real.zero_rpow hne]
    · rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2) x, Real.sqrt_eq_rpow x]
      have e : x ^ (-h) = x ^ (1 / 2 : ℝ) * x ^ (-(1 / 2 + h)) := by
        rw [← Real.rpow_add hpos]; congr 1; ring
      rw [e]; ring
  have hEq : Set.EqOn (fun x : ℝ => Real.sqrt 2 * c * x ^ (-h))
      (fun x : ℝ => Real.sqrt (2 * x) * c * x ^ (-(1 / 2 + h))) (Set.uIcc 0 X) := by
    intro x hx
    rw [Set.uIcc_of_le hX] at hx
    exact (hk x hx.1).symm
  have hint : IntervalIntegrable (fun x : ℝ => Real.sqrt 2 * c * x ^ (-h)) volume 0 X :=
