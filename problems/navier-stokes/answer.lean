noncomputable def potW5 (B : BG) (G : CorrGeom) (c : Lab → Cyl → (Fin 3 → ℝ)) : WC := fun γ m ξ =>
  if m = 1 ∨ m = -1 then
    (Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ) * ((dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) : ℝ) : ℂ))) •
      crossC (fun i => (nPhi5 B G γ ξ i : ℂ)) (fun i => (c γ ξ i : ℂ))
  else 0
noncomputable def presW5 (B : BG) (G : CorrGeom) (c : Lab → Cyl → (Fin 3 → ℝ)) : WS := fun γ m ξ =>
  if m = 1 ∨ m = -1 then
    (Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ))) *
      ((((dotProduct (nPhi5 B G γ ξ) ((Kmat B G γ ξ).mulVec (c γ ξ))
         - dotProduct (nPhiP5 B G γ ξ) (c γ ξ)) / dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) : ℝ) : ℂ))
