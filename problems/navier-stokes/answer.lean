          rw [hφ y hy.1 hy.2, Real.exp_add]
          have hp : 0 ≤ A * (Real.exp K * Real.exp (s * (y - y0))) := by positivity
          calc A * (Real.exp K * Real.exp (s * (y - y0))) * r (l * (y - y0))
              ≤ A * (Real.exp K * Real.exp (s * (y - y0))) * 11 :=
                mul_le_mul_of_nonneg_left (hr3 _) hp
            _ = 11 * (A * Real.exp K) * Real.exp (s * (y - y0)) := by ring
      have hcalc : (∫ y in Icc y0 (y0 + 11 / l), 11 * (A * Real.exp K) * Real.exp (s * (y - y0))) =
          11 * (A * Real.exp K) * ((Real.exp (s * (11 / l)) - 1) / s) := by
        rw [integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hu,
          intervalIntegral.integral_const_mul]
        congr 1
        rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (f := fun y => Real.exp (s * (y - y0)) / s)]
        · rw [show y0 + 11 / l - y0 = 11 / l by ring, sub_self, mul_zero, Real.exp_zero]
          ring
        · intro x _
          have := ((((hasDerivAt_id x).sub_const y0).const_mul s).exp).div_const s
          convert this using 1
          · simp [id]
          · simp only [id_eq, mul_one, mul_div_assoc, div_self hs.ne']
        · exact (by fun_prop : Continuous fun y : ℝ => Real.exp (s * (y - y0))).intervalIntegrable _ _
      rw [hcalc] at hmono
      refine le_trans hmono ?_
      have hX : 0 ≤ A * Real.exp K := by positivity
      have hE : Real.exp (s * (11 / l)) ≤ Real.exp (11 / (2 * l)) := by
        apply Real.exp_le_exp.2
        rw [show 11 / (2 * l) = 1 / 2 * (11 / l) by ring]
        exact mul_le_mul_of_nonneg_right hs2 h11l.le
      have h11s : 11 / s ≤ 23 := by rw [div_le_iff₀ hs]; linarith
      have hE0 : 0 ≤ Real.exp (s * (11 / l)) := (Real.exp_pos _).le
      have hd : (Real.exp (s * (11 / l)) - 1) / s ≤ Real.exp (s * (11 / l)) / s :=
        div_le_div_of_nonneg_right (by linarith) hs.le
      calc 11 * (A * Real.exp K) * ((Real.exp (s * (11 / l)) - 1) / s)
          ≤ 11 * (A * Real.exp K) * (Real.exp (s * (11 / l)) / s) :=
            mul_le_mul_of_nonneg_left hd (by positivity)
        _ = (A * Real.exp K * Real.exp (s * (11 / l))) * (11 / s) := by ring
        _ ≤ (A * Real.exp K * Real.exp (s * (11 / l))) * 23 :=
            mul_le_mul_of_nonneg_left h11s (by positivity)
        _ ≤ (A * Real.exp K * Real.exp (11 / (2 * l))) * 23 := by
            apply mul_le_mul_of_nonneg_right _ (by norm_num)
            exact mul_le_mul_of_nonneg_left hE hX
        _ = 23 * (A * Real.exp K) * Real.exp (11 / (2 * l)) := by ring
    · intro y hy
      exact mem_Iic.2 (le_trans hy.2 hY)
    · intro y hy
      obtain ⟨-, hy2⟩ := hy
      simp only [mem_Icc, not_and_or, not_le] at hy2
      rcases hy2 with h | h
      · rw [hr1 _ (by nlinarith), mul_zero]
      · have hl11 : l * (11 / l) = 11 := by field_simp
        rw [hr2 _ (by nlinarith), mul_zero]

  have win3 : ∀ y : ℝ, rfpY4 P.Md P.lam - 3 - 3 / 20 ≤ y → y ≤ rfpY4 P.Md P.lam - 3 + 3 / 20 →
      rfpY2 P.Md + 1 ≤ y ∧ y ≤ rfpY4 P.Md P.lam := by
    intro y h1 h2; constructor <;> [skip; linarith]
    rw [e4] at h1; linarith
  have win1 : ∀ y : ℝ, rfpY4 P.Md P.lam - 1 - 3 / 20 ≤ y → y ≤ rfpY4 P.Md P.lam - 1 + 3 / 20 →
      rfpY2 P.Md + 1 ≤ y ∧ y ≤ rfpY4 P.Md P.lam := by
    intro y h1 h2; constructor <;> [skip; linarith]
    rw [e4] at h1; linarith
  have winR : ∀ y : ℝ, rfpY3 P.Md P.lam ≤ y → y ≤ rfpY3 P.Md P.lam + 11 / P.lam →
      rfpY2 P.Md + 1 ≤ y ∧ y ≤ rfpY4 P.Md P.lam := by
    intro y h1 h2; constructor
    · linarith
    · rw [e4]; linarith
  have d3 : rfpY4 P.Md P.lam - 3 - rfpY3 P.Md P.lam = 13 / P.lam - 3 := by rw [e4]; ring
  have d1 : rfpY4 P.Md P.lam - 1 - rfpY3 P.Md P.lam = 13 / P.lam - 1 := by rw [e4]; ring
  have hYR : rfpY3 P.Md P.lam + 11 / P.lam ≤ rfpY4 P.Md P.lam := by rw [e4]; linarith
  have c1 := WB rfpBmp (fun y => y + rfpLam P y) 1 (rfpY3 P.Md P.lam + rfpLam P (rfpY3 P.Md P.lam))
    (1 / 2 - P.lam) (rfpY3 P.Md P.lam) (rfpY4 P.Md P.lam) 3 B1 B2 (by norm_num)
    (fun y h1 h2 => hW1 y (win3 y h1 h2).1 (win3 y h1 h2).2)
  have c2 := WB rfpBmp (fun y => y + rfpLam P y) 1 (rfpY3 P.Md P.lam + rfpLam P (rfpY3 P.Md P.lam))
    (1 / 2 - P.lam) (rfpY3 P.Md P.lam) (rfpY4 P.Md P.lam) 1 B1 B2 (by norm_num)
    (fun y h1 h2 => hW1 y (win1 y h1 h2).1 (win1 y h1 h2).2)
  have c3 := WB rfpBmp (fun y => 3 / 2 * y + 2 * rfpLam P y) (Real.sqrt 2)
    (3 / 2 * rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam))
    (1 / 2 - 2 * P.lam) (rfpY3 P.Md P.lam) (rfpY4 P.Md P.lam) 3 B1 B2 (by norm_num)
    (fun y h1 h2 => hW2 y (win3 y h1 h2).1 (win3 y h1 h2).2)
  have c4 := WB rfpBmp (fun y => 3 / 2 * y + 2 * rfpLam P y) (Real.sqrt 2)
    (3 / 2 * rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam))
    (1 / 2 - 2 * P.lam) (rfpY3 P.Md P.lam) (rfpY4 P.Md P.lam) 1 B1 B2 (by norm_num)
    (fun y h1 h2 => hW2 y (win1 y h1 h2).1 (win1 y h1 h2).2)
  have c5 := WR rfpR0 (fun y => y + rfpLam P y) 1 (rfpY3 P.Md P.lam + rfpLam P (rfpY3 P.Md P.lam))
    (1 / 2 - P.lam) (rfpY3 P.Md P.lam) (rfpY4 P.Md P.lam) P.lam R0nn R0z R0z' R0le zero_le_one hl0
    (by linarith) (by linarith) (by linarith) hYR
    (fun y h1 h2 => hW1 y (winR y h1 h2).1 (winR y h1 h2).2)
  have c6 := WR rfpR0 (fun y => 3 / 2 * y + 2 * rfpLam P y) (Real.sqrt 2)
    (3 / 2 * rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam))
    (1 / 2 - 2 * P.lam) (rfpY3 P.Md P.lam) (rfpY4 P.Md P.lam) P.lam R0nn R0z R0z' R0le
    (Real.sqrt_nonneg 2) hl0 (by linarith) (by linarith) (by linarith) hYR
    (fun y h1 h2 => hW2 y (winR y h1 h2).1 (winR y h1 h2).2)
  rw [d3] at c1 c3
  rw [d1] at c2 c4
  simp only [one_mul] at c1 c2 c5
  exact ⟨c1, c2, c3, c4, c5.1, c5.2, c6.1, c6.2⟩

theorem rfp_MJ_core : ∀ P : RfpPar, RfpRegime P → 0 ≤ (∫ y in Iic (rfpY4 P.Md P.lam), Real.exp y * rfpK P.Md y) ∧ (∫ y in Iic (rfpY4 P.Md P.lam), Real.exp y * rfpK P.Md y) ≤ Real.exp (rfpY3 P.Md P.lam + rfpLam P (rfpY3 P.Md P.lam)) ∧ 0 ≤ (∫ y in Iic (rfpY4 P.Md P.lam), Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * rfpK P.Md y) ∧ (∫ y in Iic (rfpY4 P.Md P.lam), Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * rfpK P.Md y) ≤ Real.sqrt 2 * Real.exp (3 / 2 * rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam)) :=
by
  intro P hP
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hP

  have sig01 : ∀ t : ℝ, 0 ≤ sigA t ∧ sigA t ≤ 1 := by
    intro t
    unfold sigA
    split_ifs with h1 h2
    · exact ⟨le_rfl, zero_le_one⟩
    · exact ⟨zero_le_one, le_rfl⟩
    · have ha := Real.exp_pos (-1 / t ^ 2)
      have hb := Real.exp_pos (-1 / (1 - t) ^ 2)
      have hpos : (0:ℝ) < Real.exp (-1 / t ^ 2) + Real.exp (-1 / (1 - t) ^ 2) := by linarith
      exact ⟨div_nonneg ha.le hpos.le, (div_le_one hpos).2 (by linarith)⟩
  have sig0 : ∀ t : ℝ, t ≤ 0 → sigA t = 0 := by
    intro t ht
    unfold sigA
    rw [if_pos ht]
  have sig1 : ∀ t : ℝ, 1 ≤ t → sigA t = 1 := by
    intro t ht
    have ht0 : ¬ t ≤ 0 := by linarith
    unfold sigA
    rw [if_neg ht0, if_pos ht]
  have hmeas : Measurable sigA := by
    unfold sigA
    exact Measurable.ite measurableSet_Iic measurable_const
      (Measurable.ite measurableSet_Ici measurable_const (by fun_prop))
  have hII : ∀ u v : ℝ, IntervalIntegrable sigA volume u v := by
    intro u v
    refine IntervalIntegrable.mono_fun' (g := fun _ => (1:ℝ)) intervalIntegrable_const
      hmeas.aestronglyMeasurable (Filter.Eventually.of_forall (fun s => ?_))
    show ‖sigA s‖ ≤ 1
    rw [Real.norm_eq_abs, abs_of_nonneg (sig01 s).1]
    exact (sig01 s).2
  have SI0 : ∀ t : ℝ, t ≤ 0 → rfpSigI t = 0 := by
    intro t ht
    unfold rfpSigI
    have hc : EqOn sigA (fun _ => (0:ℝ)) (uIcc 0 t) := by
      intro s hs
      rw [Set.uIcc_of_ge ht] at hs
      exact sig0 s hs.2
    rw [intervalIntegral.integral_congr hc]
    simp
  have SIb : ∀ t : ℝ, 0 ≤ t → 0 ≤ rfpSigI t ∧ rfpSigI t ≤ t ∧ t - 1 ≤ rfpSigI t := by
    intro t ht
    have hnn : 0 ≤ rfpSigI t := intervalIntegral.integral_nonneg ht (fun s _ => (sig01 s).1)
    refine ⟨hnn, ?_, ?_⟩
    · have hm := intervalIntegral.integral_mono_on ht (hII 0 t)
        (intervalIntegrable_const (c := (1:ℝ))) (fun s _ => (sig01 s).2)
      unfold rfpSigI
      simpa using hm
    · rcases le_total t 1 with h1 | h1
      · linarith
      · have hsplit := intervalIntegral.integral_add_adjacent_intervals (hII 0 1) (hII 1 t)
        have hc : EqOn sigA (fun _ => (1:ℝ)) (uIcc 1 t) := by
          intro s hs
          rw [Set.uIcc_of_le h1] at hs
          exact sig1 s hs.1
        have h2 : (∫ s in (1:ℝ)..t, sigA s) = t - 1 := by
          rw [intervalIntegral.integral_congr hc]
          simp
        have h3 : 0 ≤ ∫ s in (0:ℝ)..1, sigA s :=
          intervalIntegral.integral_nonneg zero_le_one (fun s _ => (sig01 s).1)
        unfold rfpSigI
        linarith

  have hlsq : P.lam ^ 2 ≤ 1 / 10000 := by nlinarith
  have hh1 : P.h < 1 := by linarith
  have hL : 0 ≤ Real.log (1 / P.lam) :=
    Real.log_nonneg ((le_div_iff₀ hl0).2 (by linarith))
  have hlogh : 0 ≤ Real.log (1 / P.h) :=
    Real.log_nonneg ((le_div_iff₀ hh0).2 (by linarith))
  have hT10 : 0 ≤ P.T1 := by linarith
  have hρ1 : P.ρ < 1 := by linarith
  have hPst0 : 0 < P.Pst := lt_trans (Real.exp_pos _) hPst
  have hlP : Real.exp P.Md + 10 < Real.log P.Pst := (Real.lt_log_iff_exp_lt hPst0).2 hPst
  have hY0 : 1 < Real.exp P.Md := by linarith [Real.add_one_le_exp P.Md]
  have hy2 : rfpY2 P.Md = Real.exp P.Md + 11 := rfl
  have hy3 : rfpY3 P.Md P.lam = Real.exp P.Md + 12 + 60 * Real.log (1 / P.lam) := by
    unfold rfpY3 rfpY2; ring
  have hlinv : 0 < 13 / P.lam := by positivity
  have hy4 : rfpY4 P.Md P.lam = rfpY3 P.Md P.lam + 13 / P.lam := rfl

  have Lam : ∀ y : ℝ, y ≤ rfpY4 P.Md P.lam → rfpLam P y =
      Real.log P.Pst + y / 10 - 3 / 5 * rfpSigI y - P.lam * rfpSigI (y - rfpY2 P.Md) := by
    intro y hy
    have e5 : rfpSigI (y - rfpY5 P.Md P.lam) = 0 := SI0 _ (by unfold rfpY5; linarith)
    have e6 : rfpSigI (y - rfpY5 P.Md P.lam - 1 - P.T1) = 0 := SI0 _ (by unfold rfpY5; linarith)
    have e7 : sigA ((y - rfpY4 P.Md P.lam) / 60) = 0 := sig0 _ (by linarith)
    have e9 : sigA ((Real.log (Real.exp y / Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) + 2) / 2) = 0 := by
      rw [← Real.exp_sub, Real.log_exp]
      exact sig0 _ (by unfold rfpYb rfpY5; linarith)
    have e8 : tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) = 1 - P.ρ := by
      unfold tailFac
      rw [e9]
      ring
    unfold rfpLam
    rw [e5, e6, e7, e8, div_self (sub_pos.2 hρ1).ne', Real.log_one]
    ring

  have Kf : ∀ y : ℝ, 0 ≤ rfpK P.Md y ∧ rfpK P.Md y ≤ 4 ∧ (Real.exp P.Md ≤ y → rfpK P.Md y = 0) := by
    intro y
    unfold rfpK
    split_ifs with hy
    · exact ⟨by norm_num, le_rfl, fun h => by exfalso; linarith⟩
    · have hs := sig01 (Real.log y / P.Md)
      refine ⟨by linarith, by linarith, fun h => ?_⟩
      have hlog : P.Md ≤ Real.log y := by
        have := Real.log_le_log (Real.exp_pos _) h
        rwa [Real.log_exp] at this
      have hs1 : sigA (Real.log y / P.Md) = 1 := sig1 _ ((le_div_iff₀ hMd).2 (by linarith))
      rw [hs1]
      ring

  have dom : ∀ (f : ℝ → ℝ) (a b C : ℝ), a ≤ b → (∀ y, 0 ≤ f y) → (∀ y, a < y → y ≤ b → f y = 0) →
      (∀ y, y ≤ a → f y ≤ C * Real.exp y) →
      0 ≤ (∫ y in Iic b, f y) ∧ (∫ y in Iic b, f y) ≤ C * Real.exp a := by
    intro f a b C hab hf hz hd
    refine ⟨setIntegral_nonneg measurableSet_Iic (fun y _ => hf y), ?_⟩
    rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Iic
      (Set.Iic_subset_Iic.2 hab) (fun y hy => by
        simp only [Set.mem_diff, Set.mem_Iic, not_le] at hy
        exact hz y hy.2 hy.1)]
    calc (∫ y in Iic a, f y) ≤ ∫ y in Iic a, C * Real.exp y :=
          integral_mono_of_nonneg (Filter.Eventually.of_forall hf)
            ((integrableOn_exp_Iic a).const_mul C)
            (ae_restrict_of_forall_mem measurableSet_Iic (fun y hy => hd y (Set.mem_Iic.1 hy)))
      _ = C * Real.exp a := by rw [integral_const_mul, integral_exp_Iic]

  have hy34 : rfpY3 P.Md P.lam ≤ rfpY4 P.Md P.lam := by rw [hy4]; linarith
  have hy3pos : 0 ≤ rfpY3 P.Md P.lam := by rw [hy3]; linarith [Real.exp_pos P.Md]
  have hd32 : 0 ≤ rfpY3 P.Md P.lam - rfpY2 P.Md := by rw [hy3, hy2]; linarith
  obtain ⟨-, hS3, -⟩ := SIb _ hy3pos
  obtain ⟨hS32n, hS32, -⟩ := SIb _ hd32
  have hlS : P.lam * rfpSigI (rfpY3 P.Md P.lam - rfpY2 P.Md) ≤
      1 / 100 * (rfpY3 P.Md P.lam - rfpY2 P.Md) :=
    mul_le_mul hl1 hS32 hS32n (by norm_num)
  have LamY3 := Lam _ hy34
  have E1 : Real.log P.Pst ≤ rfpY3 P.Md P.lam + rfpLam P (rfpY3 P.Md P.lam) := by
    rw [LamY3]
    linarith [Real.exp_pos P.Md]
  have E2 : 2 * Real.log P.Pst ≤ 3 / 2 * rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam) := by
    rw [LamY3]
    linarith [Real.exp_pos P.Md]
  have E3 : ∀ y : ℝ, y ≤ Real.exp P.Md → 3 / 2 * y + rfpLam P y ≤ Real.log P.Pst + 1 + y := by
    intro y hy
    rw [Lam y (by rw [hy4, hy3]; linarith)]
    rw [SI0 (y - rfpY2 P.Md) (by rw [hy2]; linarith)]
    rcases le_total y 0 with h0 | h0
    · rw [SI0 y h0]
      linarith
    · obtain ⟨-, -, hS⟩ := SIb y h0
      linarith
  have N1 : 4 * Real.exp (Real.exp P.Md) ≤ P.Pst := by
    have h10 : (4:ℝ) ≤ Real.exp 10 := by linarith [Real.add_one_le_exp 10]
    have he : Real.exp (Real.exp P.Md + 10) = Real.exp (Real.exp P.Md) * Real.exp 10 :=
      Real.exp_add _ _
    have := mul_le_mul_of_nonneg_left h10 (Real.exp_pos (Real.exp P.Md)).le
    linarith
  have N2 : 4 * Real.exp 1 * Real.exp (Real.exp P.Md) ≤ P.Pst := by
    have h9 : (4:ℝ) ≤ Real.exp 9 := by linarith [Real.add_one_le_exp 9]
    have he : Real.exp (Real.exp P.Md + 10) =
        Real.exp 1 * Real.exp (Real.exp P.Md) * Real.exp 9 := by
      rw [show Real.exp P.Md + 10 = 1 + Real.exp P.Md + 9 by ring, Real.exp_add, Real.exp_add]
    have := mul_le_mul_of_nonneg_left h9
      (mul_nonneg (Real.exp_pos 1).le (Real.exp_pos (Real.exp P.Md)).le)
    linarith

  have hY04 : Real.exp P.Md ≤ rfpY4 P.Md P.lam := by rw [hy4, hy3]; linarith
  obtain ⟨m1, m2⟩ := dom (fun y => Real.exp y * rfpK P.Md y) (Real.exp P.Md)
    (rfpY4 P.Md P.lam) 4 hY04
    (fun y => mul_nonneg (Real.exp_pos y).le (Kf y).1)
    (fun y h1 _ => by
      show Real.exp y * rfpK P.Md y = 0
      rw [(Kf y).2.2 h1.le, mul_zero])
    (fun y _ => by
      show Real.exp y * rfpK P.Md y ≤ 4 * Real.exp y
      have := mul_le_mul_of_nonneg_left (Kf y).2.1 (Real.exp_pos y).le
      linarith)
  obtain ⟨j1, j2⟩ := dom (fun y => Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * rfpK P.Md y)
    (Real.exp P.Md) (rfpY4 P.Md P.lam) (4 * Real.sqrt 2 * P.Pst * Real.exp 1) hY04
    (fun y => mul_nonneg (mul_nonneg (Real.sqrt_nonneg 2) (Real.exp_pos _).le) (Kf y).1)
    (fun y h1 _ => by
      show Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * rfpK P.Md y = 0
      rw [(Kf y).2.2 h1.le, mul_zero])
    (fun y hy => by
      show Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * rfpK P.Md y ≤
        4 * Real.sqrt 2 * P.Pst * Real.exp 1 * Real.exp y
      have h1 : Real.exp (3 / 2 * y + rfpLam P y) ≤ P.Pst * Real.exp 1 * Real.exp y := by
        calc Real.exp (3 / 2 * y + rfpLam P y) ≤ Real.exp (Real.log P.Pst + 1 + y) :=
              Real.exp_le_exp.2 (E3 y hy)
          _ = P.Pst * Real.exp 1 * Real.exp y := by
              rw [Real.exp_add, Real.exp_add, Real.exp_log hPst0]
      have hs2 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
      have hk := Kf y
      calc Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * rfpK P.Md y ≤
            Real.sqrt 2 * (P.Pst * Real.exp 1 * Real.exp y) * 4 :=
            mul_le_mul (mul_le_mul_of_nonneg_left h1 hs2) hk.2.1 hk.1
              (mul_nonneg hs2 (mul_nonneg (mul_nonneg hPst0.le (Real.exp_pos 1).le)
                (Real.exp_pos y).le))
        _ = 4 * Real.sqrt 2 * P.Pst * Real.exp 1 * Real.exp y := by ring)
  refine ⟨m1, ?_, j1, ?_⟩
  · calc _ ≤ 4 * Real.exp (Real.exp P.Md) := m2
      _ ≤ P.Pst := N1
      _ = Real.exp (Real.log P.Pst) := (Real.exp_log hPst0).symm
      _ ≤ _ := Real.exp_le_exp.2 E1
  · have hW : P.Pst * P.Pst ≤
        Real.exp (3 / 2 * rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam)) := by
      calc P.Pst * P.Pst = Real.exp (Real.log P.Pst + Real.log P.Pst) := by
            rw [Real.exp_add, Real.exp_log hPst0]
        _ ≤ _ := Real.exp_le_exp.2 (by linarith [E2])
    have hs2 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
    calc _ ≤ 4 * Real.sqrt 2 * P.Pst * Real.exp 1 * Real.exp (Real.exp P.Md) := j2
      _ = Real.sqrt 2 * P.Pst * (4 * Real.exp 1 * Real.exp (Real.exp P.Md)) := by ring
      _ ≤ Real.sqrt 2 * P.Pst * P.Pst :=
          mul_le_mul_of_nonneg_left N2 (mul_nonneg hs2 hPst0.le)
      _ = Real.sqrt 2 * (P.Pst * P.Pst) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hW hs2

theorem rfp_bump_moment_lower : ∀ s : ℝ, 0 ≤ s → s ≤ 1 / 2 → 1 / 28 ≤ ∫ τ in (-(3 / 20) : ℝ)..(3 / 20), Real.exp (s * τ) * rfpBmp τ :=
by
  intro s hs0 hs1
  have hsig : ∀ z : ℝ, 0 ≤ sigA z ∧ sigA z ≤ 1 ∧ (1 / 2 ≤ z → 1 / 2 ≤ sigA z) := by
    intro z
    unfold sigA
    split_ifs with h1 h2
    · exact ⟨le_rfl, by norm_num, fun h => by linarith⟩
    · exact ⟨by norm_num, le_rfl, fun _ => by norm_num⟩
    · push_neg at h1 h2
      have ha := Real.exp_pos (-1 / z ^ 2)
      have hc := Real.exp_pos (-1 / (1 - z) ^ 2)
      refine ⟨by positivity, ?_, ?_⟩
      · rw [div_le_one (by positivity)]
        linarith
      · intro hz
        have hle : Real.exp (-1 / (1 - z) ^ 2) ≤ Real.exp (-1 / z ^ 2) := by
          apply Real.exp_le_exp.2
          have h1z : 0 < 1 - z := by linarith
          have hsq : (1 - z) ^ 2 ≤ z ^ 2 := by nlinarith
          have : 1 / z ^ 2 ≤ 1 / (1 - z) ^ 2 := one_div_le_one_div_of_le (by positivity) hsq
          rw [neg_div, neg_div]
          linarith
        rw [le_div_iff₀ (by positivity)]
        linarith
  have hmeas : Measurable sigA := by
    unfold sigA
    refine Measurable.ite measurableSet_Iic measurable_const
      (Measurable.ite measurableSet_Ici measurable_const ?_)
    fun_prop
  have hgm : Measurable (fun τ : ℝ => Real.exp (s * τ) * rfpBmp τ) := by
    unfold rfpBmp
    exact (Real.measurable_exp.comp (measurable_const.mul measurable_id)).mul
      ((hmeas.comp (measurable_const.add (measurable_id.div_const _))).mul
        (hmeas.comp (measurable_const.sub (measurable_id.div_const _))))
  have hb0 : ∀ τ, 0 ≤ rfpBmp τ := fun τ => mul_nonneg (hsig _).1 (hsig _).1
  have hnn : ∀ τ, 0 ≤ Real.exp (s * τ) * rfpBmp τ := fun τ =>
    mul_nonneg (Real.exp_pos _).le (hb0 τ)
  have hint : IntervalIntegrable (fun τ : ℝ => Real.exp (s * τ) * rfpBmp τ)
      MeasureTheory.volume (-(3 / 20)) (3 / 20) := by
    rw [intervalIntegrable_iff_integrableOn_Ioc_of_le (by norm_num)]
    refine MeasureTheory.Measure.integrableOn_of_bounded (M := Real.exp 1)
      measure_Ioc_lt_top.ne hgm.aestronglyMeasurable ?_
    refine (MeasureTheory.ae_restrict_iff' measurableSet_Ioc).2
      (Filter.Eventually.of_forall ?_)
    intro τ hτ
    obtain ⟨a0, a1, -⟩ := hsig (1 + τ / (3 / 20))
    obtain ⟨b0, b1, -⟩ := hsig (1 - τ / (3 / 20))
    have hst : s * τ ≤ 1 := by nlinarith [hτ.1, hτ.2]
    have he : Real.exp (s * τ) ≤ Real.exp 1 := Real.exp_le_exp.2 hst
    have hb : rfpBmp τ ≤ 1 := by
      unfold rfpBmp
      nlinarith
    rw [Real.norm_eq_abs, abs_of_nonneg (hnn τ)]
    calc Real.exp (s * τ) * rfpBmp τ ≤ Real.exp 1 * 1 :=
          mul_le_mul he hb (hb0 τ) (Real.exp_pos _).le
      _ = Real.exp 1 := mul_one _
  have hsub : IntervalIntegrable (fun τ : ℝ => Real.exp (s * τ) * rfpBmp τ)
      MeasureTheory.volume (-(3 / 40)) (3 / 40) := by
    refine hint.mono_set ?_
    rw [Set.uIcc_of_le (by norm_num), Set.uIcc_of_le (by norm_num)]
    exact Set.Icc_subset_Icc (by norm_num) (by norm_num)
  have hwin : (3 / 20) * (77 / 320) ≤
      ∫ τ in (-(3 / 40) : ℝ)..(3 / 40), Real.exp (s * τ) * rfpBmp τ := by
    have hc : ∫ τ in (-(3 / 40) : ℝ)..(3 / 40), (77 / 320 : ℝ) = (3 / 20) * (77 / 320) := by
      rw [intervalIntegral.integral_const, smul_eq_mul]
      norm_num
    rw [← hc]
    apply intervalIntegral.integral_mono_on (by norm_num) intervalIntegrable_const hsub
    intro τ hτ
    obtain ⟨h1, h2⟩ := hτ
    have hd : τ / (3 / 20) = 20 / 3 * τ := by ring
    have hA := (hsig (1 + τ / (3 / 20))).2.2 (by rw [hd]; linarith)
    have hB := (hsig (1 - τ / (3 / 20))).2.2 (by rw [hd]; linarith)
    have hbump : 1 / 4 ≤ rfpBmp τ := by
      unfold rfpBmp
