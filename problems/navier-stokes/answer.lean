  have hq0 : 0 < qC B.h ξ := by
    obtain ⟨-, e2, -⟩ := hξ
    exact (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hed : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) := by
    have hX0 : 0 < XC B.h ξ := lt_trans hXa h1
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr h1))
      (Real.log_pos ((one_lt_div hX0).mpr h2)))
  have hPpos : ∀ v, 0 < Penv5 B G γ v := fun v => by unfold Penv5; exact Real.exp_pos _
  obtain ⟨X, hX⟩ : ∃ X : ℝ, X = A * SC B.h ξ ^ e := ⟨_, rfl⟩
  have hSe1 : 1 ≤ SC B.h ξ ^ e := Real.one_le_rpow hS1 (by linarith)
  have hSSe : SC B.h ξ ≤ SC B.h ξ ^ e := by
    calc SC B.h ξ = SC B.h ξ ^ (1:ℝ) := (Real.rpow_one _).symm
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hS1 he1
  have hX1 : 1 ≤ X := by rw [hX]; nlinarith
  have hcAX : cA * SC B.h ξ ≤ X := by
    rw [hX]; exact mul_le_mul hcAA hSSe hSpos.le (by linarith)
  have hcPX : cP * SC B.h ξ ^ bP ≤ X := by
    rw [hX]
    exact mul_le_mul hcPA (Real.rpow_le_rpow_of_exponent_le hS1 hbPe) (Real.rpow_nonneg hSpos.le _)
      (by linarith)
  have hm2 : ((m : ℝ)) ^ 2 ≤ M2 := by
    rw [hM2]
    exact Finset.single_le_sum (f := fun i : ℤ => ((i : ℝ)) ^ 2) (fun i _ => sq_nonneg _) hmH
  have hArX : C * (1 + (m : ℝ) ^ 2) * SC B.h ξ ^ b ≤ X := by
    rw [hX]
    apply mul_le_mul _ (Real.rpow_le_rpow_of_exponent_le hS1 hbe) (Real.rpow_nonneg hSpos.le _)
      (by linarith)
    exact le_trans (mul_le_mul_of_nonneg_left (by linarith) hC0) hCA
  obtain ⟨I, hI⟩ : ∃ I : ℝ, I = C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b *
      Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) :=
    ⟨_, rfl⟩
  have hI0 : 0 ≤ I := by
    rw [hI]
    exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hC0 (Real.rpow_nonneg hq0.le _))
      (Real.rpow_nonneg hSpos.le _)) (Real.sqrt_nonneg _)) (Real.rpow_nonneg hed.le _)
  have hvξ := hvco ξ hξO
  have hpos0 : 0 < lam ξ + c0 := by rw [← hvξ]; exact hv0
  have hposL : lam ξ + c0 < Lsb B.h G.r0 γ.1 := by rw [← hvξ]; exact hvL
  have hL : Lsb B.h G.r0 γ.1 ≤ X := le_trans hLb hcAX
  have hpathξ := fun v (hv : v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1)) => hpth ξ hξU v (hIJ hv)
  have key := forced_pulse_jet_v5 U J Z
    (fun pv : Cyl × ℝ => projT5 B G γ (pulsePth5 B G γ pv.1 pv.2) (srcHat B f γ m (pulsePth5 B G γ pv.1 pv.2)))
    (fun pv : Cyl × ℝ => pulseMatC (APhi5 B G γ (pulsePth5 B G γ pv.1 pv.2)) -
      ((m : ℂ) ^ 2 * ((dDamp5 B G γ (pulsePth5 B G γ pv.1 pv.2) : ℝ) : ℂ)) • (1 : Matrix (Fin 3) (Fin 3) ℂ))
    (fun pv : Cyl × ℝ => pulseAr5 B G γ m (pulsePth5 B G γ pv.1 pv.2))
    ξ (Lnorm B.h ξ) lam c0 (Lsb B.h G.r0 γ.1) X I (Penv5 B G γ) k hU hJo hξU hIJ hpos0 hposL hZs hAs hGs
    (fun pv i j => by
      simp only [pulseAr5, pulseMatC, Matrix.sub_apply, Matrix.smul_apply, Matrix.map_apply,
        Matrix.one_apply, smul_eq_mul]
      split_ifs <;> push_cast <;> ring)
    hZ0 hODE hPpos hX1 hL hI0
    (fun w => le_trans (hslope w) (mul_le_mul_of_nonneg_right hcAX (norm_nonneg w)))
    (fun x w hw0 hwL hx v hv => le_trans
      (hP l0 γ m ξ (by omega) hlγ hm0 hAct hξ hEta hw1 hw2 h1 h2 hxi hv0' hvL' x w hw0 hwL hx v hv)
      (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hcPX
        (div_nonneg (hPpos v).le (hPpos w).le)) (norm_nonneg _)))
    (fun j hj v hv => le_trans (hJb γ m ξ hlγ hAct hξ hw1 hw2 h1 h2 hv0' hvL' hpathξ j hj v hv).1 hArX)
    (fun j hj v hv => by rw [hI]; exact (hJb γ m ξ hlγ hAct hξ hw1 hw2 h1 h2 hv0' hvL' hpathξ j hj v hv).2)
  have hVo : IsOpen (U ∩ O ∩ {η : Cyl | |lam η + c0 - Lsb B.h G.r0 γ.1 / 2| < Lsb B.h G.r0 γ.1 / 2}) :=
    (hU.inter hO).inter (isOpen_lt (by fun_prop) continuous_const)
  have hξV : ξ ∈ U ∩ O ∩ {η : Cyl | |lam η + c0 - Lsb B.h G.r0 γ.1 / 2| < Lsb B.h G.r0 γ.1 / 2} := by
    refine ⟨⟨hξU, hξO⟩, ?_⟩
    show |lam ξ + c0 - Lsb B.h G.r0 γ.1 / 2| < Lsb B.h G.r0 γ.1 / 2
    rw [abs_lt]; constructor <;> linarith
  have hev : pulseTw5 B G f γ m =ᶠ[nhds ξ] fun η => Z (η, lam η + c0) :=
    Filter.eventuallyEq_of_mem (hVo.mem_nhds hξV) (fun η hη => by
      have h3 := hvco η hη.1.2
      have h4 : |vco B.h G.r0 γ (G.ctr γ) η.2.2.2 - Lsb B.h G.r0 γ.1 / 2| < Lsb B.h G.r0 γ.1 / 2 := by
        rw [h3]; exact hη.2
      show pulseTw5 B G f γ m η = Z (η, lam η + c0)
      rw [hrep η hη.1.1 h4, h3])
  have hNB : NB B.h (pulseTw5 B G f γ m) k ξ =
      ‖(iteratedFDeriv ℝ k (fun η => Z (η, lam η + c0)) ξ).compContinuousLinearMap
        (fun _ => Lnorm B.h ξ)‖ := by
    unfold NB
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
  rw [hNB]
  refine le_trans key (le_of_eq ?_)
  have hpow : (SC B.h ξ ^ e) ^ (12 * (k + 1)) * SC B.h ξ ^ b =
      SC B.h ξ ^ (e * ((12 * (k + 1) : ℕ) : ℝ) + b) := by
    rw [Real.rpow_add hSpos, Real.rpow_mul hSpos.le, Real.rpow_natCast]
  rw [← hvξ, hX, hI, ← hpow]
  ring

theorem pulse_tw_class_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (α : ℝ) (f : WC), InWg5 B G (qsOf l0) α f →
    InWg5 B G (qsOf l0) α (cutA B G (pulseTw5 B G f)) ∧
    FlatW B (qsOf l0) (fun γ m ξ => ((psiWd B G γ ξ : ℝ) : ℂ) • pulseTw5 B G f γ m ξ) :=
by
  intro B G hok hG
  obtain ⟨hh0, hh1, hXa, hXm1, hm12, hm2Xb, -, hqB0, hqB1, -, -, haa, hab⟩ := hok.2.1
  have hXab : B.Xa < B.Xb := by linarith
  have hr0 : 0 < G.r0 := hG.1.1
  obtain ⟨lS, hS⟩ := pulse_tw_struct_v5 B G hok hG
  obtain ⟨lT, hT⟩ := pulse_tw_star_v5 B G hok hG
  obtain ⟨lG, hGap⟩ := band_coarse_gap_v5 B.h hh0 hh1
  obtain ⟨nq, hnq⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  obtain ⟨cW, hcW, hWin⟩ := plin5_window_env B G hok hG
  choose Mj hMj0 hMj using psiw_jet_v5 B G hok hG
  refine ⟨lS + lT + lG + nq + 8, ?_⟩
  intro l0 hl0 α f hf
  obtain ⟨hH, hDeck, hSupp⟩ := hS l0 (by omega) α f hf
  choose CT bT dT hTb using hT l0 (by omega) α f hf

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]; exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : nq ≤ l0)) hnq.le
  have hqs256 : qsOf l0 ≤ 1/256 := by
    rw [hQb]
    calc (1/2:ℝ) ^ l0 ≤ (1/2) ^ 8 := pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
      _ = 1/256 := by norm_num
  have hq : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1/256 ∧ 1 ≤ SC B.h ξ ∧
      ξ ∈ DomC B.h B.qB := by
    intro ξ hξ
    obtain ⟨e1, e2, e3⟩ := hξ
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    refine ⟨hq0, by linarith, ?_, ⟨e1, e2, by linarith⟩⟩
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hcib : ∀ l : ℕ, 0 < cib B.h l := fun l =>
    mul_pos (zpow_pos (by unfold Tgc; positivity) _) (Real.rpow_pos_of_pos (by unfold Qb; positivity) _)
  have hL0 : ∀ γ : Lab, 0 < Lsb B.h G.r0 γ.1 := fun γ => by
    unfold Lsb; exact div_pos (by linarith) (hcib _)
  have hvwin : ∀ (γ : Lab) (v : ℝ), |v - Lsb B.h G.r0 γ.1 / 2| ≤ Lsb B.h G.r0 γ.1 / 3 →
      0 < v ∧ v < Lsb B.h G.r0 γ.1 := by
    intro γ v hv
    have hL := hL0 γ
    rw [abs_le] at hv
    constructor <;> linarith [hv.1, hv.2]
  have hED : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 < edgeDist B.Xa B.Xb X ∧ edgeDist B.Xa B.Xb X ≤ 1 := by
    intro X e1 e2
    have hX : 0 < X := lt_trans hXa e1
    refine ⟨?_, min_le_left _ _⟩
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr e1))
      (Real.log_pos ((one_lt_div hX).mpr e2)))
  have hPpos : ∀ (γ : Lab) (v : ℝ), 0 ≤ Penv5 B G γ v := fun γ v => by
    unfold Penv5; exact (Real.exp_pos _).le

  have hR := fun γ m ξ (hξ : ξ ∈ DomC B.h (qsOf l0)) (ht : ξ ∈ tsupport (pulseTw5 B G f γ m)) =>
    (hSupp γ m ξ hξ).resolve_left (not_not.mpr ht)
  have hJh : ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (pulseTw5 B G f γ m) →
      1 ≤ γ.1 ∧ ξ ∈ DomC B.h B.qB ∧ qC B.h ξ ≤ 1/256 ∧ coarseIdx B.h (qC B.h ξ) ≤ bandIdx B.h γ.1 ∧
      bandIdx B.h γ.1 ≤ coarseIdx B.h (qC B.h ξ) + 3 ∧ |xiG B.h γ (G.ctr γ) ξ.2.2.2| < G.r0 / 2 ∧
      |etG B.h γ (G.ctr γ) ξ.2.2.2| ≤ G.r0 := by
    intro γ m ξ hξ ht
    obtain ⟨-, -, hl, hw1, hw2, -, -, -, hxi, hv0, hvL, -⟩ := hR γ m ξ hξ ht
    obtain ⟨hq0, hq256, -, hqB⟩ := hq ξ hξ
    have hgap := hGap γ.1 l0 (qC B.h ξ) (by omega) hq0 hξ.2.2 hw1 hw2
    refine ⟨by omega, hqB, hq256, hgap.1, hgap.2, by linarith, ?_⟩
    have hc := hcib γ.1
    have he : etG B.h γ (G.ctr γ) ξ.2.2.2 =
        vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 * cib B.h γ.1 - G.r0 := by
      unfold vco; rw [div_mul_cancel₀ _ hc.ne']; ring
    have hvL' : vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 * cib B.h γ.1 ≤ 2 * G.r0 := by
      have := mul_le_mul_of_nonneg_right hvL hc.le
      unfold Lsb at this; rwa [div_mul_cancel₀ _ hc.ne'] at this
    have hv0' : 0 ≤ vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 * cib B.h γ.1 := mul_nonneg hv0 hc.le
    rw [he, abs_le]; constructor <;> linarith

  have hPsi : ∀ (ψ : Lab → Cyl → ℝ), (ψ = psiW B G ∨ ψ = psiWd B G) → ∀ (j : ℕ) γ m,
      ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (pulseTw5 B G f γ m) →
      (∃ O : Set Cyl, IsOpen O ∧ ξ ∈ O ∧
        ContDiffOn ℝ ∞ (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) O ∧ ContDiffOn ℝ ∞ (ψ γ) O) ∧
      NB B.h (ψ γ) j ξ ≤ Mj j ∧
      (Lsb B.h G.r0 γ.1 / 3 < |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2| →
        ψ γ =ᶠ[nhds ξ] 0) := by
    intro ψ hψ j γ m ξ hξ ht
    obtain ⟨a1, a2, a3, a4, a5, a6, a7⟩ := hJh γ m ξ hξ ht
    obtain ⟨⟨O, hO, hξO, hv, hp, hpd⟩, hM1, hM2, -, hfar⟩ := hMj j γ ξ a1 a2 a3 a4 a5 a6 a7
    rcases hψ with rfl | rfl
    · exact ⟨⟨O, hO, hξO, hv, hp⟩, hM1, fun h => Filter.Eventually.mono (hfar h) fun x hx => hx.1⟩
    · exact ⟨⟨O, hO, hξO, hv, hpd⟩, hM2, fun h => Filter.Eventually.mono (hfar h) fun x hx => hx.2⟩

  have hT6 : ∀ (ψ : Lab → Cyl → ℝ), (ψ = psiW B G ∨ ψ = psiWd B G) → ∀ γ m,
      ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (pulseTw5 B G f γ m) →
      |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2| ≤ Lsb B.h G.r0 γ.1 / 3 →
      ∃ U' : Set Cyl, IsOpen U' ∧ ξ ∈ U' ∧ ContDiffOn ℝ ∞ (ψ γ) U' ∧
        ContDiffOn ℝ ∞ (pulseTw5 B G f γ m) U' := by
    intro ψ hψ γ m ξ hξ ht hv
    obtain ⟨⟨O, hO, hξO, hvO, hψO⟩, -, -⟩ := hPsi ψ hψ 0 γ m ξ hξ ht
    obtain ⟨-, -, -, -, -, -, -, -, -, -, -, U, J, Z, hU, hJ, hξU, -, hIJ, -, hZ, -, -, -, -, hrep⟩ :=
      hR γ m ξ hξ ht
    have hL := hL0 γ
    have hvc : ContinuousOn (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) (U ∩ O) :=
      (hvO.mono Set.inter_subset_right).continuousOn
    refine ⟨(U ∩ O) ∩ (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) ⁻¹' Set.Ioo 0 (Lsb B.h G.r0 γ.1),
      hvc.isOpen_inter_preimage (hU.inter hO) isOpen_Ioo, ⟨⟨hξU, hξO⟩, hvwin γ _ hv⟩,
      hψO.mono (fun x hx => hx.1.2), ?_⟩
    have hmap : Set.MapsTo (fun η : Cyl => (η, vco B.h G.r0 γ (G.ctr γ) η.2.2.2))
        ((U ∩ O) ∩ (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) ⁻¹' Set.Ioo 0 (Lsb B.h G.r0 γ.1))
        (U ×ˢ J) :=
      fun η hη => ⟨hη.1.1, hIJ ⟨hη.2.1.le, hη.2.2.le⟩⟩
    have hphi : ContDiffOn ℝ ∞ (fun η : Cyl => (η, vco B.h G.r0 γ (G.ctr γ) η.2.2.2))
        ((U ∩ O) ∩ (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) ⁻¹' Set.Ioo 0 (Lsb B.h G.r0 γ.1)) :=
      contDiffOn_id.prodMk (hvO.mono fun x hx => hx.1.2)
    refine (hZ.comp hphi hmap).congr ?_
    intro η hη
    have hη2 : 0 < vco B.h G.r0 γ (G.ctr γ) η.2.2.2 ∧ vco B.h G.r0 γ (G.ctr γ) η.2.2.2 < Lsb B.h G.r0 γ.1 :=
      hη.2
    apply hrep η hη.1.1
    rw [abs_lt]; constructor <;> linarith [hη2.1, hη2.2]

  have hNBit : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (g : Cyl → V) (ξ : Cyl) (j : ℕ),
      iteratedFDeriv ℝ j g ξ = 0 → NB B.h g j ξ = 0 := by
    intro V _ _ g ξ j h0
    unfold NB
    rw [h0]
    have e : (0 : ContinuousMultilinearMap ℝ (fun _ : Fin j => Cyl) V).compContinuousLinearMap
        (fun _ => Lnorm B.h ξ) = 0 := by
      ext m; simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e, norm_zero]
  have hNBz : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (g : Cyl → V) (ξ : Cyl) (j : ℕ),
      g =ᶠ[nhds ξ] 0 → NB B.h g j ξ = 0 := by
    intro V _ _ g ξ j hg
    apply hNBit
    rw [(hg.iteratedFDeriv ℝ j).eq_of_nhds]
    have : iteratedFDeriv ℝ j (fun _ : Cyl => (0 : V)) = 0 := iteratedFDeriv_fun_zero
    exact congrFun this ξ
  have hCDz : ∀ (g : Cyl → (Fin 3 → ℂ)) (ξ : Cyl), g =ᶠ[nhds ξ] 0 → ContDiffAt ℝ ∞ g ξ :=
    fun g ξ hg => (contDiffAt_const (c := (0 : Fin 3 → ℂ))).congr_of_eventuallyEq
      (Filter.Eventually.mono hg fun x hx => by simp [hx])

  obtain ⟨Mbar, hMbar⟩ : ∃ F : ℕ → ℝ, ∀ k, F k = ∑ i ∈ Finset.range (k+1), Mj i :=
    ⟨fun k => ∑ i ∈ Finset.range (k+1), Mj i, fun _ => rfl⟩
  obtain ⟨Cbar, hCbar⟩ : ∃ F : ℕ → ℝ, ∀ k, F k = ∑ i ∈ Finset.range (k+1), |CT i| :=
    ⟨fun k => ∑ i ∈ Finset.range (k+1), |CT i|, fun _ => rfl⟩
  obtain ⟨bbar, hbbar⟩ : ∃ F : ℕ → ℝ, ∀ k, F k = ∑ i ∈ Finset.range (k+1), |bT i| :=
    ⟨fun k => ∑ i ∈ Finset.range (k+1), |bT i|, fun _ => rfl⟩
  obtain ⟨dbar, hdbar⟩ : ∃ F : ℕ → ℝ, ∀ k, F k = ∑ i ∈ Finset.range (k+1), |dT i| :=
    ⟨fun k => ∑ i ∈ Finset.range (k+1), |dT i|, fun _ => rfl⟩
  obtain ⟨Wt, hWt⟩ : ∃ F : ℕ → Lab → Cyl → ℝ, ∀ k γ ξ, F k γ ξ = qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bbar k *
      Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dbar k) *
      Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) :=
    ⟨fun k γ ξ => qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bbar k *
      Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dbar k) *
      Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2), fun _ _ _ => rfl⟩
  have hMbar0 : ∀ k, 0 ≤ Mbar k := fun k => by
    rw [hMbar]; exact Finset.sum_nonneg fun i _ => hMj0 i
  have hCbar0 : ∀ k, 0 ≤ Cbar k := fun k => by
    rw [hCbar]; exact Finset.sum_nonneg fun i _ => abs_nonneg _
  have hWt0 : ∀ k γ, ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → 0 ≤ Wt k γ ξ := by
    intro k γ ξ hξ h1 h2
    obtain ⟨hq0, -, hS1, -⟩ := hq ξ hξ
    have hed := (hED _ h1 h2).1
    rw [hWt]
    exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (Real.rpow_nonneg hq0.le _)
      (Real.rpow_nonneg (by linarith) _)) (Real.sqrt_nonneg _)) (Real.rpow_nonneg hed.le _)) (hPpos _ _)
  have hRHS0 : ∀ k γ, ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      0 ≤ 2 ^ k * Mbar k * Cbar k * Wt k γ ξ := fun k γ ξ hξ h1 h2 =>
    mul_nonneg (mul_nonneg (mul_nonneg (pow_nonneg (by norm_num) _) (hMbar0 k)) (hCbar0 k))
      (hWt0 k γ ξ hξ h1 h2)
  have key : ∀ (C C' q S S' sq e e' P N : ℝ), |C| ≤ C' → 0 ≤ q → 0 ≤ S → S ≤ S' → 0 ≤ sq → 0 ≤ e →
      e ≤ e' → 0 ≤ P → N ≤ C * q * S * sq * e * P → N ≤ C' * (q * S' * sq * e' * P) := by
    intro C C' q S S' sq e e' P N hC hq0 hS hSS hsq he hee hP hN
    have hX : 0 ≤ q * S * sq * e * P :=
      mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hq0 hS) hsq) he) hP
    have h1 : C * q * S * sq * e * P ≤ |C| * (q * S * sq * e * P) := by
      rw [show C * q * S * sq * e * P = C * (q * S * sq * e * P) by ring]
      exact mul_le_mul_of_nonneg_right (le_abs_self C) hX
    have ha : q * S * sq ≤ q * S' * sq :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hSS hq0) hsq
    have ha' : 0 ≤ q * S' * sq := mul_nonneg (mul_nonneg hq0 (le_trans hS hSS)) hsq
    have h2 : q * S * sq * e * P ≤ q * S' * sq * e' * P :=
      mul_le_mul_of_nonneg_right (mul_le_mul ha hee he ha') hP
    exact hN.trans (h1.trans (mul_le_mul hC h2 hX (le_trans (abs_nonneg _) hC)))

  have hTW : ∀ k i, i ≤ k → ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (pulseTw5 B G f γ m) →
      B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → 0 < vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 →
      vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 < Lsb B.h G.r0 γ.1 →
      NB B.h (pulseTw5 B G f γ m) i ξ ≤ Cbar k * Wt k γ ξ := by
    intro k i hik γ m ξ hξ ht h1 h2 hv0 hvL
    obtain ⟨hq0, -, hS1, -⟩ := hq ξ hξ
    obtain ⟨hed0, hed1⟩ := hED _ h1 h2
    have hi : i ∈ Finset.range (k+1) := Finset.mem_range.mpr (by omega)
    have hbi : bT i ≤ bbar k := by
      rw [hbbar]
      exact (le_abs_self _).trans (Finset.single_le_sum (f := fun j => |bT j|) (fun j _ => abs_nonneg _) hi)
    have hdi : dT i ≤ dbar k := by
      rw [hdbar]
      exact (le_abs_self _).trans (Finset.single_le_sum (f := fun j => |dT j|) (fun j _ => abs_nonneg _) hi)
    have hCi : |CT i| ≤ Cbar k := by
      rw [hCbar]; exact Finset.single_le_sum (f := fun j => |CT j|) (fun j _ => abs_nonneg _) hi
    rw [hWt]
    exact key _ _ _ _ _ _ _ _ _ _ hCi (Real.rpow_nonneg hq0.le _) (Real.rpow_nonneg (by linarith) _)
      (Real.rpow_le_rpow_of_exponent_le hS1 hbi) (Real.sqrt_nonneg _) (Real.rpow_nonneg hed0.le _)
      (Real.rpow_le_rpow_of_exponent_ge hed0 hed1 (neg_le_neg hdi)) (hPpos _ _)
      (hTb i γ m ξ hξ ht h1 h2 hv0 hvL)

  have hLeib : ∀ (ψ : Lab → Cyl → ℝ), (ψ = psiW B G ∨ ψ = psiWd B G) → ∀ (k : ℕ) γ m,
      ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (pulseTw5 B G f γ m) → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2| ≤ Lsb B.h G.r0 γ.1 / 3 →
      NB B.h (fun η => ((ψ γ η : ℝ) : ℂ) • pulseTw5 B G f γ m η) k ξ ≤
        2 ^ k * Mbar k * Cbar k * Wt k γ ξ := by
    intro ψ hψ k γ m ξ hξ ht h1 h2 hv
    obtain ⟨U', hU', hξU', hψU, htwU⟩ := hT6 ψ hψ γ m ξ hξ ht hv
    have hvv := hvwin γ _ hv
    have e : (fun η => ((ψ γ η : ℝ) : ℂ) • pulseTw5 B G f γ m η) =
        fun η => ψ γ η • pulseTw5 B G f γ m η := funext fun η => Complex.coe_smul _ _
    rw [e]
    refine (nb_smul_leibniz_v5 B.h (ψ γ) (pulseTw5 B G f γ m) U' ξ hU' hξU' hψU htwU k).trans ?_
    have hsum : ∀ i ∈ Finset.range (k+1), (k.choose i : ℝ) * NB B.h (ψ γ) i ξ *
        NB B.h (pulseTw5 B G f γ m) (k - i) ξ ≤ (k.choose i : ℝ) * (Mbar k * (Cbar k * Wt k γ ξ)) := by
      intro i hi
      have hM : NB B.h (ψ γ) i ξ ≤ Mbar k := (hPsi ψ hψ i γ m ξ hξ ht).2.1.trans (by
        rw [hMbar]; exact Finset.single_le_sum (f := Mj) (fun j _ => hMj0 j) hi)
      have hN := hTW k (k - i) (Nat.sub_le k i) γ m ξ hξ ht h1 h2 hvv.1 hvv.2
      have hNB0 : 0 ≤ NB B.h (pulseTw5 B G f γ m) (k - i) ξ := by unfold NB; exact norm_nonneg _
      rw [mul_assoc]
      exact mul_le_mul_of_nonneg_left (mul_le_mul hM hN hNB0 (hMbar0 k)) (Nat.cast_nonneg _)
    refine (Finset.sum_le_sum hsum).trans (le_of_eq ?_)
    rw [← Finset.sum_mul, show (∑ i ∈ Finset.range (k+1), (k.choose i : ℝ)) = 2 ^ k by
      exact_mod_cast Nat.sum_range_choose k]
    ring

  have hClass : ∀ (ψ : Lab → Cyl → ℝ), (ψ = psiW B G ∨ ψ = psiWd B G) →
      (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ∀ c, IsDeck B.h (qC B.h ξ) c →
        ((ψ γ (shY ξ c) : ℝ) : ℂ) • pulseTw5 B G f γ m (shY ξ c) = ((ψ γ ξ : ℝ) : ℂ) • pulseTw5 B G f γ m ξ) →
      InWg5 B G (qsOf l0) α (fun γ m ξ => ((ψ γ ξ : ℝ) : ℂ) • pulseTw5 B G f γ m ξ) := by
    intro ψ hψ hdk
    obtain ⟨H, H0, Hv⟩ := hH
    refine ⟨⟨H, H0, fun γ m hm => ?_⟩, fun γ m => ?_, hdk, fun γ m ξ hξ hne => ?_,
      fun k => ⟨2 ^ k * Mbar k * Cbar k, bbar k, dbar k, fun γ m ξ hξ h1 h2 => ?_⟩⟩
    · funext ξ; simp [Hv γ m hm]
    · intro ξ hξ
      show ContDiffWithinAt ℝ ∞ (fun η => ((ψ γ η : ℝ) : ℂ) • pulseTw5 B G f γ m η) _ ξ
      apply ContDiffAt.contDiffWithinAt
      by_cases ht : ξ ∈ tsupport (pulseTw5 B G f γ m)
      · by_cases hfar : Lsb B.h G.r0 γ.1 / 3 < |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2|
        · have hz := (hPsi ψ hψ 0 γ m ξ hξ ht).2.2 hfar
          exact hCDz _ ξ (Filter.Eventually.mono hz fun x hx => by simp [hx])
        · obtain ⟨U', hU', hξU', hψU, htwU⟩ := hT6 ψ hψ γ m ξ hξ ht (not_lt.mp hfar)
          have e : (fun η => ((ψ γ η : ℝ) : ℂ) • pulseTw5 B G f γ m η) =
              fun η => ψ γ η • pulseTw5 B G f γ m η := funext fun η => Complex.coe_smul _ _
          rw [e]
          exact (hψU.smul htwU).contDiffAt (hU'.mem_nhds hξU')
      · exact hCDz _ ξ (Filter.Eventually.mono (notMem_tsupport_iff_eventuallyEq.mp ht)
          fun x hx => by simp [hx])
    · have hne' : pulseTw5 B G f γ m ξ ≠ 0 := fun h0 => hne (by simp [h0])
      have ht : ξ ∈ tsupport (pulseTw5 B G f γ m) := subset_tsupport _ hne'
      obtain ⟨-, hAct, -, -, -, hX1, hX2, hEta, hxi, -⟩ := hR γ m ξ hξ ht
      obtain ⟨-, -, -, -, -, -, hEt⟩ := hJh γ m ξ hξ ht
      obtain ⟨hl, ξ0, -, h0⟩ := hAct
      exact ⟨⟨hl, ξ0, h0⟩, hEta, hxi, hEt, hX1, hX2⟩
    · have hEq : 2 ^ k * Mbar k * Cbar k * Wt k γ ξ = 2 ^ k * Mbar k * Cbar k * qC B.h ξ ^ (B.h * α) *
          SC B.h ξ ^ bbar k * Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
          edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dbar k) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
        rw [hWt]; ring
      refine le_of_le_of_eq ?_ hEq
      by_cases ht : ξ ∈ tsupport (pulseTw5 B G f γ m)
      · by_cases hfar : Lsb B.h G.r0 γ.1 / 3 < |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2|
        · have hz := (hPsi ψ hψ 0 γ m ξ hξ ht).2.2 hfar
          exact (hNBz (fun η => ((ψ γ η : ℝ) : ℂ) • pulseTw5 B G f γ m η) ξ k
            (Filter.Eventually.mono hz fun x hx => by simp [hx])).trans_le (hRHS0 k γ ξ hξ h1 h2)
        · exact hLeib ψ hψ k γ m ξ hξ ht h1 h2 (not_lt.mp hfar)
      · exact (hNBz (fun η => ((ψ γ η : ℝ) : ℂ) • pulseTw5 B G f γ m η) ξ k
          (Filter.Eventually.mono (notMem_tsupport_iff_eventuallyEq.mp ht) fun x hx => by simp [hx])).trans_le
          (hRHS0 k γ ξ hξ h1 h2)

  have hC1 : InWg5 B G (qsOf l0) α (cutA B G (pulseTw5 B G f)) :=
    hClass (psiW B G) (Or.inl rfl) (fun γ m ξ hξ c hc => (hDeck γ m ξ hξ c hc).1)
  have hgW := hClass (psiWd B G) (Or.inr rfl) (fun γ m ξ hξ c hc => (hDeck γ m ξ hξ c hc).2)

  refine ⟨hC1, fun k N => ?_⟩
  obtain ⟨E, hE0, hE⟩ := edge_factor_bound_v5 B.Xa B.Xb B.aa B.ab (dbar k) hXa hXab haa hab
  obtain ⟨CN, hCN0, hCN⟩ :=
    gauss_poly_absorb_v5 cW (B.h * α) (bbar k) (2 ^ k * Mbar k * Cbar k * E) 0 N hcW
  refine ⟨CN, fun γ m ξ hξ => ?_⟩
  show NB B.h (fun η => ((psiWd B G γ η : ℝ) : ℂ) • pulseTw5 B G f γ m η) k ξ ≤ CN * qC B.h ξ ^ (N:ℝ)
  obtain ⟨hq0, hq256, hS1, -⟩ := hq ξ hξ
  have hRHS : 0 ≤ CN * qC B.h ξ ^ (N:ℝ) := mul_nonneg hCN0 (Real.rpow_nonneg hq0.le _)
  by_cases hsh : XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ
  · have h0 := inWg5_jet_vanish_off_shell_v5 B G (qsOf l0) α _ hok hgW γ m ξ hξ hsh k
    exact (hNBit (fun η => ((psiWd B G γ η : ℝ) : ℂ) • pulseTw5 B G f γ m η) ξ k h0).trans_le hRHS
  push_neg at hsh
  obtain ⟨h1, h2⟩ := hsh
  by_cases ht : ξ ∈ tsupport (pulseTw5 B G f γ m)
  · by_cases hfar : Lsb B.h G.r0 γ.1 / 3 < |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2|
    · have hz := (hPsi (psiWd B G) (Or.inr rfl) 0 γ m ξ hξ ht).2.2 hfar
      exact (hNBz (fun η => ((psiWd B G γ η : ℝ) : ℂ) • pulseTw5 B G f γ m η) ξ k
        (Filter.Eventually.mono hz fun x hx => by simp [hx])).trans_le hRHS
    · by_cases hin : |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2| < Lsb B.h G.r0 γ.1 / 5
      · obtain ⟨U', hU', hξU', hψU, htwU⟩ := hT6 (psiWd B G) (Or.inr rfl) γ m ξ hξ ht (not_lt.mp hfar)
        obtain ⟨a1, a2, a3, a4, a5, a6, a7⟩ := hJh γ m ξ hξ ht
        have hz : ∀ i, NB B.h (psiWd B G γ) i ξ = 0 := fun i =>
          (hMj i γ ξ a1 a2 a3 a4 a5 a6 a7).2.2.2.1 (Or.inl hin)
        have e : (fun η => ((psiWd B G γ η : ℝ) : ℂ) • pulseTw5 B G f γ m η) =
            fun η => psiWd B G γ η • pulseTw5 B G f γ m η := funext fun η => Complex.coe_smul _ _
        rw [e]
        refine (nb_smul_leibniz_v5 B.h (psiWd B G γ) (pulseTw5 B G f γ m) U' ξ hU' hξU' hψU htwU k).trans ?_
        rw [Finset.sum_eq_zero (fun i _ => by rw [hz i, mul_zero, zero_mul])]
        exact hRHS
      · obtain ⟨-, hAct, hl, hw1, hw2, -, -, -, -, hv0, hvL, -⟩ := hR γ m ξ hξ ht
        have hX := hWin γ _ hAct hv0 hvL (not_lt.mp hin)
        have hEe := hE (XC B.h ξ) h1 h2
        have hed0 := (hED _ h1 h2).1
        have hQb0 : 0 < Qb γ.1 := by unfold Qb; positivity
        have hlo : Qb γ.1 / 4 < qC B.h ξ := by
          have := (lt_div_iff₀ hQb0).mp hw1; linarith
        have hhi : qC B.h ξ < 4 * Qb γ.1 := by
          have := (div_lt_iff₀ hQb0).mp hw2; linarith
        have hcn := hCN γ.1 (qC B.h ξ) (by omega) hlo hhi (by linarith)
        have hb := hLeib (psiWd B G) (Or.inr rfl) k γ m ξ hξ ht h1 h2 (not_lt.mp hfar)
        rw [hWt] at hb
        have hA : 0 ≤ 2 ^ k * Mbar k * Cbar k :=
          mul_nonneg (mul_nonneg (pow_nonneg (by norm_num) _) (hMbar0 k)) (hCbar0 k)
        have hQa : 0 ≤ qC B.h ξ ^ (B.h * α) := Real.rpow_nonneg hq0.le _
        have hSb : 0 ≤ SC B.h ξ ^ bbar k := Real.rpow_nonneg (by linarith) _
        have step : Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dbar k) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) ≤
            E * Real.exp (-cW * (γ.1 : ℝ) ^ 2) := mul_le_mul hEe hX (hPpos _ _) hE0
        calc NB B.h (fun η => ((psiWd B G γ η : ℝ) : ℂ) • pulseTw5 B G f γ m η) k ξ
            ≤ 2 ^ k * Mbar k * Cbar k * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bbar k *
              Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
              edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dbar k) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) := hb
          _ = (2 ^ k * Mbar k * Cbar k) * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bbar k) *
              (Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
              edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dbar k) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) := by
            ring
          _ ≤ (2 ^ k * Mbar k * Cbar k) * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bbar k) *
              (E * Real.exp (-cW * (γ.1 : ℝ) ^ 2)) :=
            mul_le_mul_of_nonneg_left step (mul_nonneg hA (mul_nonneg hQa hSb))
          _ = 2 ^ k * Mbar k * Cbar k * E * (4:ℝ) ^ (0 * γ.1) * qC B.h ξ ^ (B.h * α) *
              ((1 + |Real.log (qC B.h ξ)|) ^ 2) ^ bbar k * Real.exp (-cW * (γ.1 : ℝ) ^ 2) := by
            simp only [zero_mul, pow_zero, SC]; ring
          _ ≤ CN * qC B.h ξ ^ (N:ℝ) := hcn
  · exact (hNBz (fun η => ((psiWd B G γ η : ℝ) : ℂ) • pulseTw5 B G f γ m η) ξ k
      (Filter.Eventually.mono (notMem_tsupport_iff_eventuallyEq.mp ht) fun x hx => by simp [hx])).trans_le hRHS

theorem linear_ode_param_C1_gen : ∀ (P E : Type) [NormedAddCommGroup P] [NormedSpace ℝ P] [FiniteDimensional ℝ P] [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] (U : Set P) (A : P × ℝ → E →L[ℝ] E) (b : P × ℝ → E), IsOpen U → ContDiffOn ℝ 1 A (U ×ˢ Set.univ) → ContDiffOn ℝ 1 b (U ×ˢ Set.univ) → ∃ z : P → ℝ → E, (∀ s ∈ U, z s 0 = 0 ∧ ∀ v : ℝ, HasDerivAt (z s) (A (s, v) (z s v) + b (s, v)) v) ∧ ∀ s ∈ U, ∀ v : ℝ, DifferentiableAt ℝ (fun w : P × ℝ => z w.1 w.2) (s, v) :=
by
  intro P E _ _ _ _ _ _ U A b hU hA hb
  have hUo : IsOpen (U ×ˢ (Set.univ : Set ℝ)) := hU.prod isOpen_univ
  have hAc : ContinuousOn A (U ×ˢ Set.univ) := hA.continuousOn
  have hbc : ContinuousOn b (U ×ˢ Set.univ) := hb.continuousOn
  have hdA : ContinuousOn (fderiv ℝ A) (U ×ˢ Set.univ) := hA.continuousOn_fderiv_of_isOpen hUo le_rfl
  have hdb : ContinuousOn (fderiv ℝ b) (U ×ˢ Set.univ) := hb.continuousOn_fderiv_of_isOpen hUo le_rfl
  have hslice : ∀ {G : Type} [TopologicalSpace G] (f : P × ℝ → G), ContinuousOn f (U ×ˢ Set.univ) →
      ∀ s ∈ U, Continuous (fun v : ℝ => f (s, v)) := by
    intro G _ f hf s hs
    exact hf.comp_continuous (continuous_const.prodMk continuous_id) (fun v => ⟨hs, Set.mem_univ v⟩)

  have hex : ∀ s : P, ∃ y : ℝ → E, s ∈ U →
      (y 0 = 0 ∧ ∀ v, HasDerivAt y (A (s, v) (y v) + b (s, v)) v) := by
    intro s
    by_cases hs : s ∈ U
    · obtain ⟨y, hy⟩ := linear_ode_global_exists E (fun v => A (s, v)) (fun v => b (s, v)) 0
        (hslice A hAc s hs) (hslice b hbc s hs)
      exact ⟨y, fun _ => hy⟩
    · exact ⟨0, fun h => absurd h hs⟩
  choose z hz using hex
  refine ⟨z, hz, ?_⟩

  intro s0 hs0 v0
  have hT : (0:ℝ) < |v0| + 1 := by positivity
  have hLip := linear_ode_param_lip P E U A b z hU hA hb hz s0 hs0
  obtain ⟨r, hr, C, hrU, hbd⟩ := hLip (|v0| + 1) hT
  have hz0c : Continuous (z s0) :=
    continuous_iff_continuousAt.2 (fun v => ((hz s0 hs0).2 v).continuousAt)
  have hMc : Continuous (fun v => ContinuousLinearMap.compL ℝ P E E (A (s0, v))) :=
    (ContinuousLinearMap.compL ℝ P E E).continuous.comp (hslice A hAc s0 hs0)
  have hgc : Continuous (fun v => (ContinuousLinearMap.apply ℝ E (z s0 v)).comp
      ((fderiv ℝ A (s0, v)).comp (ContinuousLinearMap.inl ℝ P ℝ)) +
      (fderiv ℝ b (s0, v)).comp (ContinuousLinearMap.inl ℝ P ℝ)) := by
    refine Continuous.add ?_ ?_
    · exact ((ContinuousLinearMap.apply ℝ E).continuous.comp hz0c).clm_comp
        ((hslice _ hdA s0 hs0).clm_comp continuous_const)
    · exact (hslice _ hdb s0 hs0).clm_comp continuous_const
  obtain ⟨W, hW0, hW'⟩ := linear_ode_global_exists (P →L[ℝ] E) _ _ 0 hMc hgc
  have hW'' : ∀ v : ℝ, HasDerivAt W ((A (s0, v)).comp (W v) +
      (ContinuousLinearMap.apply ℝ E (z s0 v)).comp ((fderiv ℝ A (s0, v)).comp
        (ContinuousLinearMap.inl ℝ P ℝ)) +
      (fderiv ℝ b (s0, v)).comp (ContinuousLinearMap.inl ℝ P ℝ)) v := by
    intro v
    have h := hW' v
    simp only [ContinuousLinearMap.compL_apply] at h
    rw [add_assoc]
    exact h
  have hWd := linear_ode_param_fderiv P E U A b z s0 W hU hA hb hz hs0 hLip hW0 hW'' v0

  have hzc : ContinuousAt (fun p : P × ℝ => z p.1 p.2) (s0, v0) := by
    have hc := (hz s0 hs0).2 v0 |>.continuousAt
    rw [Metric.continuousAt_iff] at hc ⊢
    intro ε hε
    obtain ⟨δ₁, hδ₁, h1⟩ := hc (ε / 2) (by linarith)
    have hC : 0 < |C| + 1 := by positivity
    refine ⟨min (min r δ₁) (min 1 (ε / (2 * (|C| + 1)))),
      lt_min (lt_min hr hδ₁) (lt_min one_pos (by positivity)), ?_⟩
    rintro ⟨s, v⟩ hd
    rw [Prod.dist_eq] at hd
    obtain ⟨hs, hv⟩ := max_lt_iff.mp hd
    simp only [lt_min_iff] at hs hv
    obtain ⟨⟨hsr, -⟩, -, hsε⟩ := hs
    obtain ⟨⟨-, hvδ⟩, hv1, -⟩ := hv
    have hvI : v ∈ Set.Icc (-(|v0| + 1)) (|v0| + 1) := by
      rw [Real.dist_eq] at hv1
      exact abs_le.mp (by linarith [abs_sub_abs_le_abs_sub v v0])
    have e1 := hbd s hsr v hvI
    have e2 := h1 hvδ
    show dist (z s v) (z s0 v0) < ε
    rw [dist_eq_norm] at hsε e2 ⊢
    have e3 : C * ‖s - s0‖ ≤ |C| * ‖s - s0‖ :=
      mul_le_mul_of_nonneg_right (le_abs_self C) (norm_nonneg _)
    have e4 : |C| * ‖s - s0‖ ≤ ε / 2 := by
      have h5 : (|C| + 1) * ‖s - s0‖ < (|C| + 1) * (ε / (2 * (|C| + 1))) :=
        mul_lt_mul_of_pos_left hsε hC
      have h6 : (|C| + 1) * (ε / (2 * (|C| + 1))) = ε / 2 := by field_simp
      nlinarith [norm_nonneg (s - s0)]
    calc ‖z s v - z s0 v0‖ = ‖(z s v - z s0 v) + (z s0 v - z s0 v0)‖ := by
          rw [sub_add_sub_cancel]
      _ ≤ ‖z s v - z s0 v‖ + ‖z s0 v - z s0 v0‖ := norm_add_le _ _
      _ < ε := by linarith

  obtain ⟨F, hF⟩ : ∃ F : P × ℝ → E, F = fun p => A p (z p.1 p.2) + b p := ⟨_, rfl⟩
  have hd : ∀ s ∈ Metric.ball s0 r, ∀ τ : ℝ, HasDerivAt (z s) (F (s, τ)) τ := by
    intro s hs τ
    rw [hF]
    exact (hz s (hrU hs)).2 τ
  have hFc : ContinuousAt F (s0, v0) := by
    have hm : (s0, v0) ∈ U ×ˢ (Set.univ : Set ℝ) := ⟨hs0, Set.mem_univ _⟩
    rw [hF]
    exact ((hAc.continuousAt (hUo.mem_nhds hm)).clm_apply hzc).add
      (hbc.continuousAt (hUo.mem_nhds hm))

  have hfd : HasFDerivAt (fun p : P × ℝ => z p.1 p.2)
      ((W v0).comp (ContinuousLinearMap.fst ℝ P ℝ) +
        (ContinuousLinearMap.snd ℝ P ℝ).smulRight (F (s0, v0))) (s0, v0) := by
    have hlo := hWd.isLittleO
    refine HasFDerivAt.of_isLittleO ?_
    rw [Asymptotics.isLittleO_iff]
    intro c hc
    have h1 := (Asymptotics.isLittleO_iff.mp hlo) (c := c / 2) (by linarith)
    rw [Metric.eventually_nhds_iff] at h1
    obtain ⟨ρ₁, hρ₁, h1⟩ := h1
    rw [Metric.continuousAt_iff] at hFc
    obtain ⟨ρ₂, hρ₂, h2⟩ := hFc (c / 2) (by linarith)
    rw [Metric.eventually_nhds_iff]
    refine ⟨min r (min ρ₁ ρ₂), lt_min hr (lt_min hρ₁ hρ₂), ?_⟩
    rintro ⟨s, v⟩ hdist
    rw [Prod.dist_eq] at hdist
    obtain ⟨hs, hv⟩ := max_lt_iff.mp hdist
    simp only [lt_min_iff] at hs hv
    have hA' : ‖z s v0 - z s0 v0 - W v0 (s - s0)‖ ≤ c / 2 * ‖s - s0‖ := h1 hs.2.1
    have hB' : ‖z s v - z s v0 - (v - v0) • F (s0, v0)‖ ≤ c / 2 * ‖v - v0‖ := by
      have key := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
        (f := fun τ => z s τ - τ • F (s0, v0)) (f' := fun τ => F (s, τ) - F (s0, v0))
        (s := Set.uIcc v0 v) (x := v0) (y := v) (C := c / 2) ?_ ?_ (convex_uIcc v0 v)
        Set.left_mem_uIcc Set.right_mem_uIcc
      · have e : z s v - z s v0 - (v - v0) • F (s0, v0) =
            (z s v - v • F (s0, v0)) - (z s v0 - v0 • F (s0, v0)) := by
          rw [sub_smul]; abel
        rw [e]; exact key
      · intro τ _
        have h3 := (hd s hs.1 τ).sub ((hasDerivAt_id' τ).smul_const (F (s0, v0)))
        rw [one_smul] at h3
        exact h3.hasDerivWithinAt
      · intro τ hτ
        have hτ' : |τ - v0| ≤ |v - v0| := Set.abs_sub_left_of_mem_uIcc hτ
        have h4 : dist (s, τ) (s0, v0) < ρ₂ := by
          rw [Prod.dist_eq]
          refine max_lt hs.2.2 ?_
          rw [Real.dist_eq]
          rw [Real.dist_eq] at hv
          linarith [hv.2.2]
        rw [← dist_eq_norm]
        exact (h2 h4).le
    have hn1 : ‖s - s0‖ ≤ ‖(s, v) - (s0, v0)‖ := norm_fst_le ((s, v) - (s0, v0))
    have hn2 : ‖v - v0‖ ≤ ‖(s, v) - (s0, v0)‖ := norm_snd_le ((s, v) - (s0, v0))
    have hrw : z s v - z s0 v0 - ((W v0).comp (ContinuousLinearMap.fst ℝ P ℝ) +
        (ContinuousLinearMap.snd ℝ P ℝ).smulRight (F (s0, v0))) ((s, v) - (s0, v0)) =
        (z s v - z s v0 - (v - v0) • F (s0, v0)) + (z s v0 - z s0 v0 - W v0 (s - s0)) := by
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd',
        ContinuousLinearMap.smulRight_apply, Prod.mk_sub_mk]
      abel
    show ‖z s v - z s0 v0 - ((W v0).comp (ContinuousLinearMap.fst ℝ P ℝ) +
        (ContinuousLinearMap.snd ℝ P ℝ).smulRight (F (s0, v0))) ((s, v) - (s0, v0))‖ ≤
        c * ‖(s, v) - (s0, v0)‖
    rw [hrw]
    calc _ ≤ ‖z s v - z s v0 - (v - v0) • F (s0, v0)‖ + ‖z s v0 - z s0 v0 - W v0 (s - s0)‖ :=
          norm_add_le _ _
      _ ≤ c / 2 * ‖v - v0‖ + c / 2 * ‖s - s0‖ := add_le_add hB' hA'
      _ ≤ c * ‖(s, v) - (s0, v0)‖ := by nlinarith
  exact hfd.differentiableAt

theorem pulse_rhs_family_v5 : ∀ (B : BG) (G : CorrGeom) (f : WC) (γ : Lab) (m : ℤ) (qs : ℝ) (U : Set Cyl), B.ok → IsOpen U → U ⊆ DomC B.h qs → ContDiffOn ℝ ∞ (f γ m) (DomC B.h qs) → (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhi5 B G γ η i) U) → (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhiP5 B G γ η i) U) → (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => Kmat B G γ η i j) U) → ∃ (A : Cyl → (Fin 3 → ℂ) →L[ℝ] (Fin 3 → ℂ)) (b : Cyl → (Fin 3 → ℂ)), ContDiffOn ℝ ∞ A U ∧ ContDiffOn ℝ ∞ b U ∧ ∀ η ∈ U, ∀ Z : Fin 3 → ℂ, A η Z + b η = pulseRhs5 B G f γ m η Z :=
by
  intro B G f γ m qs U hok hUo hUD hf hn hnP hK
  have hQbpos : ∀ l : ℕ, 0 < Qb l := fun l => Real.rpow_pos_of_pos (by norm_num) _

  have hnsq : ∀ η : Cyl, 0 < η.1 → 0 < dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η) := by
    intro η hη
    have hpint : (pint5 B G γ : ℝ) ≠ 0 := by
      unfold pint5
      split_ifs with h
      · norm_num
      · exact_mod_cast h
    have hkb : (0:ℝ) < (kb B.h γ.1 : ℝ) := by
      have : 0 < kb B.h γ.1 :=
        Nat.ceil_pos.mpr (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos (hQbpos _) _) _)
      exact_mod_cast this
    have hRC : 0 < RC γ.1 η := div_pos hη (Real.sqrt_pos.mpr (hQbpos _))
    have h1 : nPhi5 B G γ η 1 ≠ 0 := by
      have e : nPhi5 B G γ η 1 = pang5 B G γ / RC γ.1 η := rfl
      rw [e]
      unfold pang5
      exact div_ne_zero (div_ne_zero hpint hkb.ne') hRC.ne'
    simp only [dotProduct, Fin.sum_univ_three]
    have := mul_self_pos.mpr h1
    linarith [mul_self_nonneg (nPhi5 B G γ η 0), mul_self_nonneg (nPhi5 B G γ η 2)]
  have hN0 : ∀ η ∈ U, dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η) ≠ 0 :=
    fun η hη => (hnsq η (hUD hη).1).ne'

  have hNs : ContDiffOn ℝ ∞ (fun η : Cyl => dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η)) U := by
    have e : (fun η : Cyl => dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η)) =
        fun η => ∑ i : Fin 3, nPhi5 B G γ η i * nPhi5 B G γ η i := by
      funext η; rfl
    rw [e]
    exact ContDiffOn.sum (fun i _ => (hn i).mul (hn i))
  have hNinv : ContDiffOn ℝ ∞ (fun η : Cyl => (dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η))⁻¹) U :=
    hNs.inv hN0
  have hAPhi : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => APhi5 B G γ η i j) U := by
    intro i j
    have e : (fun η : Cyl => APhi5 B G γ η i j) = fun η => -Kmat B G γ η i j +
        (dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η))⁻¹ * (nPhi5 B G γ η i *
          ((∑ k : Fin 3, nPhi5 B G γ η k * Kmat B G γ η k j) - nPhiP5 B G γ η j)) := by
      funext η
      simp only [APhi5, Matrix.add_apply, Matrix.neg_apply, Matrix.smul_apply, smul_eq_mul,
        Matrix.vecMulVec_apply, Pi.sub_apply, Matrix.vecMul, dotProduct]
    rw [e]
    exact (hK i j).neg.add (hNinv.mul ((hn i).mul
      ((ContDiffOn.sum fun k _ => (hn k).mul (hK k j)).sub (hnP j))))
  have hD : ContDiffOn ℝ ∞ (fun η : Cyl => dDamp5 B G γ η) U := by
    have e : (fun η : Cyl => dDamp5 B G γ η) = fun η =>
        epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η) := rfl
    rw [e]; exact contDiffOn_const.mul hNs
  have ha : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => APhi5 B G γ η i j -
      (if i = j then (m:ℝ)^2 else 0) * dDamp5 B G γ η) U :=
    fun i j => (hAPhi i j).sub (contDiffOn_const.mul hD)

  have hqpos : ∀ η ∈ DomC B.h qs, 0 < qC B.h η := fun η hη =>
    (hok.1.1 η.2.1 (1 - η.2.2.1) (by linarith [hη.2.1])).1
  have hq : ContDiffOn ℝ ∞ (qC B.h) U := by
    have h4' : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1
    have hφ : ContDiff ℝ ∞ (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by
      apply ContDiff.prodMk
      · exact contDiff_fst.comp contDiff_snd
      · exact contDiff_const.sub (contDiff_fst.comp (contDiff_snd.comp contDiff_snd))
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) U (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := (hUD hξ).2.1
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    exact h4'.comp hφ.contDiffOn hmaps
  have hcast : ∀ {g : Cyl → ℝ}, ContDiffOn ℝ ∞ g U →
      ContDiffOn ℝ ∞ (fun η => ((g η : ℝ) : ℂ)) U := by
    intro g hg
    have := Complex.ofRealCLM.contDiff.comp_contDiffOn hg
    simpa [Function.comp_def] using this
  have hrho : ContDiffOn ℝ ∞ (fun η => rhoQ B γ η) U := hq.div_const _
  have hrpow : ContDiffOn ℝ ∞ (fun η => rhoQ B γ η ^ (-(Aex B.h + 1))) U :=
    hrho.rpow_const_of_ne (fun η hη => (div_pos (hqpos η (hUD hη)) (hQbpos _)).ne')
  have hsrc : ContDiffOn ℝ ∞ (fun η => srcHat B f γ m η) U :=
    (hcast hrpow).smul (hf.mono hUD)
  have hnC : ContDiffOn ℝ ∞ (fun η => nPhiC5 B G γ η) U :=
    contDiffOn_pi.2 (fun i => hcast (hn i))
  have hdot : ContDiffOn ℝ ∞ (fun η => dotProduct (nPhiC5 B G γ η) (srcHat B f γ m η)) U := by
    show ContDiffOn ℝ ∞ (fun η => ∑ i : Fin 3, nPhiC5 B G γ η i * srcHat B f γ m η i) U
    exact ContDiffOn.sum (fun i _ => ((contDiffOn_pi.1 hnC) i).mul ((contDiffOn_pi.1 hsrc) i))
  have hnsqC : ContDiffOn ℝ ∞ (fun η => nsqC5 B G γ η) U := hcast hNs
  have hnsqinv : ContDiffOn ℝ ∞ (fun η => (nsqC5 B G γ η)⁻¹) U :=
    hnsqC.inv (fun η hη => by unfold nsqC5; exact_mod_cast hN0 η hη)
  have hproj : ContDiffOn ℝ ∞ (fun η => projT5 B G γ η (srcHat B f γ m η)) U := by
    have e : (fun η => projT5 B G γ η (srcHat B f γ m η)) = fun η => srcHat B f γ m η -
        (dotProduct (nPhiC5 B G γ η) (srcHat B f γ m η) * (nsqC5 B G γ η)⁻¹) • nPhiC5 B G γ η := by
      funext η; simp only [projT5, div_eq_mul_inv]
    rw [e]
    exact hsrc.sub ((hdot.mul hnsqinv).smul hnC)

  have hE : ∀ (c : Fin 3 → Fin 3 → ℝ) (Z : Fin 3 → ℂ) (k : Fin 3),
      ((∑ i : Fin 3, ∑ j : Fin 3, c i j • (ContinuousLinearMap.single ℝ (fun _ : Fin 3 => ℂ) i).comp
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) j)) Z) k =
        ∑ j : Fin 3, ((c k j : ℝ) : ℂ) * Z j := by
    intro c Z k
    simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.comp_apply, ContinuousLinearMap.proj_apply,
      ContinuousLinearMap.single_apply, Finset.sum_apply, Pi.smul_apply, Fin.sum_univ_three]
    fin_cases k <;> simp [Pi.single_apply, Complex.real_smul]
  refine ⟨fun η => ∑ i : Fin 3, ∑ j : Fin 3, (APhi5 B G γ η i j -
      (if i = j then (m:ℝ)^2 else 0) * dDamp5 B G γ η) •
        (ContinuousLinearMap.single ℝ (fun _ : Fin 3 => ℂ) i).comp
          (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) j),
    fun η => -projT5 B G γ η (srcHat B f γ m η), ?_, hproj.neg, ?_⟩
  · exact ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun j _ => (ha i j).smul contDiffOn_const))
  · intro η _ Z
    funext k
    rw [Pi.add_apply, hE (fun i j => APhi5 B G γ η i j -
      (if i = j then (m:ℝ)^2 else 0) * dDamp5 B G γ η) Z k]
    simp only [pulseRhs5, Pi.sub_apply, Pi.neg_apply, Matrix.mulVec, dotProduct, pulseMatC,
      Matrix.map_apply, Pi.smul_apply, smul_eq_mul, Fin.sum_univ_three]
    fin_cases k <;> simp <;> push_cast <;> ring

theorem pulse_tube_family_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (f : WC) (γ : Lab) (m : ℤ) (ξ0 : Cyl), B.ok → GeomPrim5 B G → qsOf l0 ≤ B.qB → (∀ (γ' : Lab) (m' : ℤ), ContDiffOn ℝ ∞ (f γ' m') (DomC B.h (qsOf l0))) → ξ0 ∈ DomC B.h (qsOf l0) → |xiG B.h γ (G.ctr γ) ξ0.2.2.2| < G.r0 / 2 → 0 ≤ vco B.h G.r0 γ (G.ctr γ) ξ0.2.2.2 → vco B.h G.r0 γ (G.ctr γ) ξ0.2.2.2 ≤ Lsb B.h G.r0 γ.1 → ∃ (V : Set Cyl) (z : Cyl → ℝ → (Fin 3 → ℂ)), IsOpen V ∧ pulsePth5 B G γ ξ0 0 ∈ V ∧ ∀ β ∈ V, z β 0 = 0 ∧ (∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), HasDerivAt (z β) (pulseRhs5 B G f γ m (β + w • dVdir B.h γ.1) (z β w)) w) ∧ (∀ w : ℝ, DifferentiableAt ℝ (fun p : Cyl × ℝ => z p.1 p.2) (β, w)) ∧ (∃ K : ℝ, 0 ≤ K ∧ ∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), ∀ x y : Fin 3 → ℂ, ‖pulseRhs5 B G f γ m (β + w • dVdir B.h γ.1) x - pulseRhs5 B G f γ m (β + w • dVdir B.h γ.1) y‖ ≤ K * ‖x - y‖) ∧ (∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), pulseZsol5 B G f γ m β w = z β w) :=
by
  intro B G l0 f γ m ξ0 hok hG hqsB hfs hξ0 hx hv0 hvL
  obtain ⟨hr0, hr01, -⟩ := hG.1

  have hQbpos : ∀ l : ℕ, 0 < Qb l := fun l => Real.rpow_pos_of_pos (by norm_num) _
  have hTgc : 0 < Tgc := by unfold Tgc; positivity
  have hcib : ∀ l : ℕ, 0 < cib B.h l := fun l =>
    mul_pos (zpow_pos hTgc _) (Real.rpow_pos_of_pos (hQbpos l) _)
  have hLpos : 0 < Lsb B.h G.r0 γ.1 := div_pos (by linarith) (hcib γ.1)
  have hLc : Lsb B.h G.r0 γ.1 * cib B.h γ.1 = 2 * G.r0 := by
    unfold Lsb; rw [div_mul_cancel₀ _ (hcib γ.1).ne']
  have hvco : ∀ (Y : ℝ × ℝ), etG B.h γ (G.ctr γ) Y =
      vco B.h G.r0 γ (G.ctr γ) Y * cib B.h γ.1 - G.r0 := by
    intro Y; unfold vco; rw [div_mul_cancel₀ _ (hcib γ.1).ne']; ring

  have hshift : ∀ (ξ : Cyl) (s : ℝ) (l : ℕ), ξ + s • dVdir B.h l =
      (ξ.1, ξ.2.1, ξ.2.2.1, ξ.2.2.2 + s • ((cib B.h l * Tgc ^ (-(bandIdx B.h l))) • vtv)) := by
    intro ξ s l
    obtain ⟨a, b, c, d⟩ := ξ
    simp only [dVdir, Prod.smul_mk, Prod.mk_add_mk, smul_zero, add_zero]
  have hpth : ∀ (w : ℝ), pulsePth5 B G γ ξ0 0 + w • dVdir B.h γ.1 =
      ξ0 + (w - vco B.h G.r0 γ (G.ctr γ) ξ0.2.2.2) • dVdir B.h γ.1 := by
    intro w; unfold pulsePth5; rw [add_assoc, ← add_smul]; congr 2; ring
  have hpathD : ∀ w : ℝ, pulsePth5 B G γ ξ0 0 + w • dVdir B.h γ.1 ∈ DomC B.h (qsOf l0) := by
    intro w; rw [hpth, hshift]; exact hξ0
  have hgeo : ∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
      xiG B.h γ (G.ctr γ) (pulsePth5 B G γ ξ0 0 + w • dVdir B.h γ.1).2.2.2 =
        xiG B.h γ (G.ctr γ) ξ0.2.2.2 ∧
      etG B.h γ (G.ctr γ) (pulsePth5 B G γ ξ0 0 + w • dVdir B.h γ.1).2.2.2 =
        w * cib B.h γ.1 - G.r0 := by
    intro w hw
    rw [hpth, hshift]
    have hwc0 : 0 ≤ w * cib B.h γ.1 := mul_nonneg hw.1 (hcib γ.1).le
    have hwc1 : w * cib B.h γ.1 ≤ 2 * G.r0 := by
      rw [← hLc]; exact mul_le_mul_of_nonneg_right hw.2 (hcib γ.1).le
    have he : etG B.h γ (G.ctr γ) ξ0.2.2.2 + (w - vco B.h G.r0 γ (G.ctr γ) ξ0.2.2.2) * cib B.h γ.1 =
        w * cib B.h γ.1 - G.r0 := by rw [hvco]; ring
    have c2 := (pulse_rect_path_v5 B.h G.r0 γ (G.ctr γ) hr0 hr01).1 ξ0.2.2.2
      (w - vco B.h G.r0 γ (G.ctr γ) ξ0.2.2.2) (by linarith)
      (by rw [he]; exact abs_le.mpr ⟨by linarith, by linarith⟩)
    exact ⟨c2.1, by rw [c2.2, he]⟩

  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'

  obtain ⟨S, hS⟩ : ∃ S : Set (Set Cyl), S = {W : Set Cyl | IsOpen W ∧
      (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhi5 B G γ η i) W) ∧
      (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhiP5 B G γ η i) W) ∧
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => Kmat B G γ η i j) W)} := ⟨_, rfl⟩
  have hSmem : ∀ W ∈ S, IsOpen W ∧
      (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhi5 B G γ η i) W) ∧
      (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhiP5 B G γ η i) W) ∧
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => Kmat B G γ η i j) W) := by
    intro W hW; rw [hS, Set.mem_setOf_eq] at hW; exact hW
  obtain ⟨U, hUdef⟩ : ∃ U : Set Cyl, U = DomC B.h (qsOf l0) ∩ ⋃₀ S := ⟨_, rfl⟩
  have hUo : IsOpen U := by
    rw [hUdef]; exact hDopen.inter (isOpen_sUnion (fun W hW => (hSmem W hW).1))
  have hUD : U ⊆ DomC B.h (qsOf l0) := by rw [hUdef]; exact Set.inter_subset_left
  have hloc : ∀ (g : Cyl → ℝ), (∀ W ∈ S, ContDiffOn ℝ ∞ g W) → ContDiffOn ℝ ∞ g U := by
    intro g hg
    have h1 : ContDiffOn ℝ ∞ g (⋃₀ S) := by
      apply contDiffOn_of_locally_contDiffOn
      intro x hxS
      obtain ⟨W, hWS, hxW⟩ := Set.mem_sUnion.1 hxS
      exact ⟨W, (hSmem W hWS).1, hxW, (hg W hWS).mono Set.inter_subset_right⟩
    rw [hUdef]; exact h1.mono Set.inter_subset_right
  have hn : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhi5 B G γ η i) U := fun i =>
    hloc _ (fun W hW => (hSmem W hW).2.1 i)
  have hnP : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhiP5 B G γ η i) U := fun i =>
    hloc _ (fun W hW => (hSmem W hW).2.2.1 i)
  have hK : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => Kmat B G γ η i j) U := fun i j =>
    hloc _ (fun W hW => (hSmem W hW).2.2.2 i j)
  have hpathU : ∀ t ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
      pulsePth5 B G γ ξ0 0 + t • dVdir B.h γ.1 ∈ U := by
    intro t ht
    obtain ⟨g1, g2⟩ := hgeo t ht
    have hD := hpathD t
    have hDB : pulsePth5 B G γ ξ0 0 + t • dVdir B.h γ.1 ∈ DomC B.h B.qB :=
      ⟨hD.1, hD.2.1, lt_of_lt_of_le hD.2.2 hqsB⟩
    have hx8 : |xiG B.h γ (G.ctr γ) (pulsePth5 B G γ ξ0 0 + t • dVdir B.h γ.1).2.2.2| < 1/8 := by
      rw [g1]; linarith
    have hy8 : |etG B.h γ (G.ctr γ) (pulsePth5 B G γ ξ0 0 + t • dVdir B.h γ.1).2.2.2| < 1/8 := by
      rw [g2]
      have hwc0 : 0 ≤ t * cib B.h γ.1 := mul_nonneg ht.1 (hcib γ.1).le
      have hwc1 : t * cib B.h γ.1 ≤ 2 * G.r0 := by
        rw [← hLc]; exact mul_le_mul_of_nonneg_right ht.2 (hcib γ.1).le
      rw [abs_lt]; constructor <;> linarith
    obtain ⟨W, hWo, hW, -, h1, h2, h3⟩ := good_coeff_smooth_v5 B G γ _ hok hDB hx8 hy8
    have hWS : W ∈ S := by rw [hS, Set.mem_setOf_eq]; exact ⟨hWo, h1, h2, h3⟩
    rw [hUdef]
    exact Set.mem_inter hD (Set.mem_sUnion.2 ⟨W, hWS, hW⟩)

  obtain ⟨A, b, hAs, hbs, hAb⟩ :=
    pulse_rhs_family_v5 B G f γ m (qsOf l0) U hok hUo hUD (hfs γ m) hn hnP hK

  have hlc : Continuous (fun t : ℝ => pulsePth5 B G γ ξ0 0 + t • dVdir B.h γ.1) :=
    continuous_const.add (continuous_id.smul continuous_const)
  have hKc : IsCompact ((fun t : ℝ => pulsePth5 B G γ ξ0 0 + t • dVdir B.h γ.1) ''
      Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1)) := isCompact_Icc.image hlc
  have hKU : ((fun t : ℝ => pulsePth5 B G γ ξ0 0 + t • dVdir B.h γ.1) ''
      Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1)) ⊆ U := by
    rintro _ ⟨t, ht, rfl⟩; exact hpathU t ht
  obtain ⟨δ0, hδ0, hthick⟩ := hKc.exists_thickening_subset_open hUo hKU

  have hne : 0 < ‖dVdir B.h γ.1‖ + 1 := by positivity
  obtain ⟨δ, hδdef⟩ : ∃ δ : ℝ, δ = δ0 / 2 / (‖dVdir B.h γ.1‖ + 1) := ⟨_, rfl⟩
  have hδ : 0 < δ := by rw [hδdef]; positivity
  have hδe : δ * (‖dVdir B.h γ.1‖ + 1) = δ0 / 2 := by
    rw [hδdef]; exact div_mul_cancel₀ _ hne.ne'
  have hσ : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff
  obtain ⟨χ, hχdef⟩ : ∃ χ : ℝ → ℝ, χ = fun w => w - (w - Lsb B.h G.r0 γ.1) *
      Real.smoothTransition (2 * (w - Lsb B.h G.r0 γ.1) / δ) - w * Real.smoothTransition (-2 * w / δ) :=
    ⟨_, rfl⟩
  have hχc : ContDiff ℝ ∞ χ := by
    rw [hχdef]
    exact (contDiff_id.sub ((contDiff_id.sub contDiff_const).mul (hσ.comp
      ((contDiff_const.mul (contDiff_id.sub contDiff_const)).div_const δ)))).sub
      (contDiff_id.mul (hσ.comp ((contDiff_const.mul contDiff_id).div_const δ)))
  have hχid : ∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), χ w = w := by
    intro w hw
    have a1 : 2 * (w - Lsb B.h G.r0 γ.1) / δ ≤ 0 :=
      (div_le_iff₀ hδ).2 (by rw [zero_mul]; linarith [hw.2])
    have a2 : -2 * w / δ ≤ 0 := (div_le_iff₀ hδ).2 (by rw [zero_mul]; linarith [hw.1])
    rw [hχdef]; dsimp only
    rw [Real.smoothTransition.zero_of_nonpos a1, Real.smoothTransition.zero_of_nonpos a2]
    ring
  have hχr : ∀ w : ℝ, χ w ∈ Set.Icc (-δ) (Lsb B.h G.r0 γ.1 + δ) := by
    intro w
    rw [hχdef]; dsimp only
    have ha0 := Real.smoothTransition.nonneg (2 * (w - Lsb B.h G.r0 γ.1) / δ)
    have ha1 := Real.smoothTransition.le_one (2 * (w - Lsb B.h G.r0 γ.1) / δ)
    have hb0 := Real.smoothTransition.nonneg (-2 * w / δ)
    have hb1 := Real.smoothTransition.le_one (-2 * w / δ)
    rcases le_total w 0 with hw | hw
    · have a1 : 2 * (w - Lsb B.h G.r0 γ.1) / δ ≤ 0 :=
        (div_le_iff₀ hδ).2 (by rw [zero_mul]; linarith)
      rw [Real.smoothTransition.zero_of_nonpos a1]
      by_cases hb : 1 ≤ -2 * w / δ
      · rw [Real.smoothTransition.one_of_one_le hb]
        constructor <;> nlinarith
      · push_neg at hb
        have hw2 : -2 * w < δ := by
          have := (div_lt_iff₀ hδ).1 hb; linarith
        constructor <;> nlinarith
    · have a2 : -2 * w / δ ≤ 0 := (div_le_iff₀ hδ).2 (by rw [zero_mul]; linarith)
      rw [Real.smoothTransition.zero_of_nonpos a2]
      by_cases ha : 1 ≤ 2 * (w - Lsb B.h G.r0 γ.1) / δ
      · rw [Real.smoothTransition.one_of_one_le ha]
        constructor <;> nlinarith
      · push_neg at ha
        have hw2 : 2 * (w - Lsb B.h G.r0 γ.1) < δ := by
          have := (div_lt_iff₀ hδ).1 ha; linarith
        rcases le_total w (Lsb B.h G.r0 γ.1) with hw' | hw'
        · have a1 : 2 * (w - Lsb B.h G.r0 γ.1) / δ ≤ 0 :=
            (div_le_iff₀ hδ).2 (by rw [zero_mul]; linarith)
          rw [Real.smoothTransition.zero_of_nonpos a1]
          constructor <;> nlinarith
        · constructor <;> nlinarith

  have htube : ∀ β ∈ Metric.ball (pulsePth5 B G γ ξ0 0) (δ0 / 2),
      ∀ t ∈ Set.Icc (-δ) (Lsb B.h G.r0 γ.1 + δ), β + t • dVdir B.h γ.1 ∈ U := by
    intro β hβ t ht
    obtain ⟨t', ht', htt⟩ : ∃ t' ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), |t - t'| ≤ δ := by
      rcases le_total t 0 with h | h
      · exact ⟨0, ⟨le_rfl, hLpos.le⟩, by rw [abs_le]; constructor <;> linarith [ht.1]⟩
      · rcases le_total t (Lsb B.h G.r0 γ.1) with h' | h'
        · exact ⟨t, ⟨h, h'⟩, by rw [sub_self, abs_zero]; exact hδ.le⟩
        · exact ⟨Lsb B.h G.r0 γ.1, ⟨hLpos.le, le_rfl⟩,
            by rw [abs_le]; constructor <;> linarith [ht.2]⟩
    apply hthick
    rw [Metric.mem_thickening_iff]
    refine ⟨pulsePth5 B G γ ξ0 0 + t' • dVdir B.h γ.1, ⟨t', ht', rfl⟩, ?_⟩
    rw [dist_eq_norm]
    have hid : β + t • dVdir B.h γ.1 - (pulsePth5 B G γ ξ0 0 + t' • dVdir B.h γ.1) =
        (β - pulsePth5 B G γ ξ0 0) + (t - t') • dVdir B.h γ.1 := by rw [sub_smul]; abel
    rw [hid]
    have hb : ‖β - pulsePth5 B G γ ξ0 0‖ < δ0 / 2 := by rw [← dist_eq_norm]; exact hβ
    have h2 : ‖(t - t') • dVdir B.h γ.1‖ ≤ δ * ‖dVdir B.h γ.1‖ := by
      rw [norm_smul, Real.norm_eq_abs]; exact mul_le_mul_of_nonneg_right htt (norm_nonneg _)
    have h3 : δ * ‖dVdir B.h γ.1‖ ≤ δ0 / 2 := by rw [← hδe]; nlinarith
    calc ‖(β - pulsePth5 B G γ ξ0 0) + (t - t') • dVdir B.h γ.1‖
        ≤ ‖β - pulsePth5 B G γ ξ0 0‖ + ‖(t - t') • dVdir B.h γ.1‖ := norm_add_le _ _
      _ < δ0 / 2 + δ0 / 2 := by linarith
      _ = δ0 := by ring

  obtain ⟨φ, hφdef⟩ : ∃ φ : Cyl × ℝ → Cyl, φ = fun p => p.1 + χ p.2 • dVdir B.h γ.1 := ⟨_, rfl⟩
  have hφc : ContDiff ℝ ∞ φ := by
    rw [hφdef]; exact contDiff_fst.add ((hχc.comp contDiff_snd).smul contDiff_const)
  have hφm : Set.MapsTo φ (Metric.ball (pulsePth5 B G γ ξ0 0) (δ0 / 2) ×ˢ (Set.univ : Set ℝ)) U := by
    intro p hp; rw [hφdef]; exact htube p.1 hp.1 (χ p.2) (hχr p.2)
  have h1le : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have hAh : ContDiffOn ℝ 1 (A ∘ φ) (Metric.ball (pulsePth5 B G γ ξ0 0) (δ0 / 2) ×ˢ Set.univ) :=
    (hAs.comp hφc.contDiffOn hφm).of_le h1le
  have hbh : ContDiffOn ℝ 1 (b ∘ φ) (Metric.ball (pulsePth5 B G γ ξ0 0) (δ0 / 2) ×ˢ Set.univ) :=
    (hbs.comp hφc.contDiffOn hφm).of_le h1le

  obtain ⟨z, hz1, hz2⟩ := linear_ode_param_C1_gen Cyl (Fin 3 → ℂ) _ (A ∘ φ) (b ∘ φ)
    Metric.isOpen_ball hAh hbh
  refine ⟨Metric.ball (pulsePth5 B G γ ξ0 0) (δ0 / 2), z, Metric.isOpen_ball,
    Metric.mem_ball_self (by linarith), ?_⟩
  intro β hβ
  have hU' : ∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), β + w • dVdir B.h γ.1 ∈ U := fun w hw =>
    htube β hβ w ⟨by linarith [hw.1], by linarith [hw.2]⟩

  have hderT : ∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
      HasDerivAt (z β) (pulseRhs5 B G f γ m (β + w • dVdir B.h γ.1) (z β w)) w := by
    intro w hw
    refine ((hz1 β hβ).2 w).congr_deriv ?_
    have hφw : φ (β, w) = β + w • dVdir B.h γ.1 := by
      rw [hφdef]; dsimp only; rw [hχid w hw]
    show A (φ (β, w)) (z β w) + b (φ (β, w)) = _
    rw [hφw]
    exact hAb _ (hU' w hw) _

  obtain ⟨C, hC⟩ := (isCompact_Icc (a := (0:ℝ)) (b := Lsb B.h G.r0 γ.1)).exists_bound_of_continuousOn
    (f := fun t : ℝ => A (β + t • dVdir B.h γ.1))
    (hAs.continuousOn.comp (continuous_const.add (continuous_id.smul continuous_const)).continuousOn
      (fun t ht => hU' t ht))
  have hK0 : (0:ℝ) ≤ max C 0 := le_max_right _ _
  have hLip : ∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), ∀ x y : Fin 3 → ℂ,
      ‖pulseRhs5 B G f γ m (β + w • dVdir B.h γ.1) x - pulseRhs5 B G f γ m (β + w • dVdir B.h γ.1) y‖
        ≤ max C 0 * ‖x - y‖ := by
    intro w hw x y
    rw [← hAb _ (hU' w hw) x, ← hAb _ (hU' w hw) y, add_sub_add_right_eq_sub, ← map_sub]
    exact ((A _).le_opNorm _).trans
      (mul_le_mul_of_nonneg_right ((hC w hw).trans (le_max_left _ _)) (norm_nonneg _))
  refine ⟨(hz1 β hβ).1, hderT, hz2 β hβ, ⟨max C 0, hK0, hLip⟩, ?_⟩

  obtain ⟨hZ0, hZd⟩ : pulseZsol5 B G f γ m β 0 = 0 ∧ ∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
      HasDerivWithinAt (pulseZsol5 B G f γ m β)
        (pulseRhs5 B G f γ m (β + w • dVdir B.h γ.1) (pulseZsol5 B G f γ m β w))
        (Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1)) w :=
    Classical.epsilon_spec (p := fun Z : ℝ → (Fin 3 → ℂ) => Z 0 = 0 ∧
      ∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
        HasDerivWithinAt Z (pulseRhs5 B G f γ m (β + w • dVdir B.h γ.1) (Z w))
          (Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1)) w)
      ⟨z β, (hz1 β hβ).1, fun w hw => (hderT w hw).hasDerivWithinAt⟩
  have hIci : ∀ t ∈ Set.Ico (0:ℝ) (Lsb B.h G.r0 γ.1),
      Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1) ∈ nhdsWithin t (Set.Ici t) := by
    intro t ht
    exact Filter.mem_of_superset (Icc_mem_nhdsGE ht.2) (Set.Icc_subset_Icc ht.1 le_rfl)
  have heq := ODE_solution_unique_of_mem_Icc_right
    (v := fun t x => pulseRhs5 B G f γ m (β + t • dVdir B.h γ.1) x)
    (s := fun _ => Set.univ) (K := (max C 0).toNNReal)
    (f := pulseZsol5 B G f γ m β) (g := z β) (a := 0) (b := Lsb B.h G.r0 γ.1)
    (fun t ht => LipschitzOnWith.of_dist_le_mul (fun x _ y _ => by
      rw [dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ hK0]
      exact hLip t (Set.Ico_subset_Icc_self ht) x y))
    (fun t ht => (hZd t ht).continuousWithinAt)
    (fun t ht => (hZd t (Set.Ico_subset_Icc_self ht)).mono_of_mem_nhdsWithin (hIci t ht))
    (fun _ _ => Set.mem_univ _)
    (fun t ht => (hderT t ht).continuousAt.continuousWithinAt)
    (fun t ht => (hderT t (Set.Ico_subset_Icc_self ht)).hasDerivWithinAt)
    (fun _ _ => Set.mem_univ _)
    (hZ0.trans (hz1 β hβ).1.symm)
  exact fun w hw => heq hw

theorem pulse_tw_equation_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (α : ℝ) (f : WC), InWg5 B G (qsOf l0) α f →
    (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), dotProduct (nPhiC5 B G γ ξ) (pulseTw5 B G f γ m ξ) = 0) ∧
    (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), psiW B G γ ξ ≠ 0 →
      DifferentiableAt ℝ (pulseTw5 B G f γ m) ξ ∧
      dVc B γ.1 (pulseTw5 B G f γ m) ξ = (pulseMatC (APhi5 B G γ ξ)).mulVec (pulseTw5 B G f γ m ξ)
        - ((m : ℂ) ^ 2 * ((dDamp5 B G γ ξ : ℝ) : ℂ)) • pulseTw5 B G f γ m ξ
        - projT5 B G γ ξ (srcHat B f γ m ξ)) :=
by
  intro B G hok hG
  obtain ⟨lS, hS⟩ := pulse_support_good_v5 B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  have hQbpos : ∀ l : ℕ, 0 < Qb l := fun l => Real.rpow_pos_of_pos (by norm_num) _

  have hnsq : ∀ (γ : Lab) (η : Cyl), 0 < η.1 → 0 < dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η) := by
    intro γ η hη
    have hpint : (pint5 B G γ : ℝ) ≠ 0 := by
      unfold pint5
      split_ifs with h
      · norm_num
      · exact_mod_cast h
    have hkb : (0:ℝ) < (kb B.h γ.1 : ℝ) := by
      have : 0 < kb B.h γ.1 :=
        Nat.ceil_pos.mpr (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos (hQbpos _) _) _)
      exact_mod_cast this
    have hRC : 0 < RC γ.1 η := div_pos hη (Real.sqrt_pos.mpr (hQbpos _))
    have h1 : nPhi5 B G γ η 1 ≠ 0 := by
      have e : nPhi5 B G γ η 1 = pang5 B G γ / RC γ.1 η := rfl
      rw [e]
      unfold pang5
      exact div_ne_zero (div_ne_zero hpint hkb.ne') hRC.ne'
    simp only [dotProduct, Fin.sum_univ_three]
    have := mul_self_pos.mpr h1
    linarith [mul_self_nonneg (nPhi5 B G γ η 0), mul_self_nonneg (nPhi5 B G γ η 2)]

  have halg : ∀ (f0 : WC) (γ : Lab) (m : ℤ) (η : Cyl) (Z : Fin 3 → ℂ),
      dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η) ≠ 0 →
      dotProduct (nPhiC5 B G γ η) (pulseRhs5 B G f0 γ m η Z) =
        -dotProduct (fun i => ((nPhiP5 B G γ η i : ℝ) : ℂ)) Z
          - ((m : ℂ) ^ 2 * ((dDamp5 B G γ η : ℝ) : ℂ)) * dotProduct (nPhiC5 B G γ η) Z := by
    intro f0 γ m η Z hN
    have hnn : dotProduct (nPhiC5 B G γ η) (nPhiC5 B G γ η) = nsqC5 B G γ η := by
      simp only [nPhiC5, nsqC5, dotProduct, Fin.sum_univ_three]
      push_cast
      ring
    have hnsC : nsqC5 B G γ η ≠ 0 := by
      unfold nsqC5
      exact_mod_cast hN
    have hproj : ∀ s : Fin 3 → ℂ, dotProduct (nPhiC5 B G γ η) (projT5 B G γ η s) = 0 := by
      intro s
      unfold projT5
      rw [dotProduct_sub, dotProduct_smul, hnn, smul_eq_mul, div_mul_cancel₀ _ hnsC, sub_self]
    have hvm : Matrix.vecMul (nPhi5 B G γ η) (APhi5 B G γ η) = -nPhiP5 B G γ η := by
      unfold APhi5
      rw [Matrix.vecMul_add, Matrix.vecMul_neg, Matrix.vecMul_smul, Matrix.vecMul_vecMulVec, smul_smul,
        inv_mul_cancel₀ hN, one_smul]
      abel
    have hvmC : Matrix.vecMul (nPhiC5 B G γ η) (pulseMatC (APhi5 B G γ η)) =
        fun j => ((Matrix.vecMul (nPhi5 B G γ η) (APhi5 B G γ η) j : ℝ) : ℂ) := by
      funext j
      simp only [Matrix.vecMul, dotProduct, pulseMatC, nPhiC5, Matrix.map_apply, Fin.sum_univ_three]
      push_cast
      ring
    unfold pulseRhs5
    rw [dotProduct_sub, dotProduct_sub, hproj, dotProduct_smul, Matrix.dotProduct_mulVec, hvmC, hvm,
      smul_eq_mul, sub_zero]
    congr 1
    simp only [dotProduct, Fin.sum_univ_three, Pi.neg_apply]
    push_cast
    ring

  have hdecay : ∀ (L : ℝ) (y : ℝ → ℂ) (c : ℝ → ℝ), (∀ w ∈ Icc 0 L, 0 ≤ c w) →
      (∀ w ∈ Icc 0 L, HasDerivAt y (-((c w : ℝ) : ℂ) * y w) w) → y 0 = 0 → ∀ w ∈ Icc 0 L, y w = 0 := by
    intro L y c hc hy hy0 w hw
    have hg : ∀ u ∈ Icc 0 L, HasDerivAt (fun u => ‖y u‖ ^ 2) (-(2 * c u) * ‖y u‖ ^ 2) u := by
      intro u hu
      have := (hy u hu).norm_sq
      convert this using 1
      have e : -((c u : ℝ) : ℂ) * y u = (-c u : ℝ) • y u := by simp [Complex.real_smul]
      rw [e, real_inner_smul_right, real_inner_self_eq_norm_sq]
      ring
    have hanti : AntitoneOn (fun u => ‖y u‖ ^ 2) (Icc 0 L) := by
      apply antitoneOn_of_hasDerivWithinAt_nonpos (convex_Icc 0 L)
      · intro u hu
        exact (hg u hu).continuousAt.continuousWithinAt
      · intro u hu
        rw [interior_Icc] at hu
        exact (hg u (Ioo_subset_Icc_self hu)).hasDerivWithinAt
