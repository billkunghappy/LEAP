      (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, g γ m ξ i * ephase5 B G γ m θ ξ).re +
      (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, τ γ m ξ i * ephase5 B G γ m θ ξ).re -
      (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, f γ m ξ i * ephase5 B G γ m θ ξ).re
    rw [f1, f2, f3, f4, ← Complex.add_re, ← Complex.sub_re, ← Finset.sum_add_distrib,
