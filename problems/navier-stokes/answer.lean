    InM B (qsOf l0) (0.9 - 2 * kapS) (nrm B (2 * Aex B.h + 1/2) (grP5 B G l0 S)) :=
by
  intro B G hok hSN
  obtain ⟨l3, h3⟩ := wmo_radial_calculus_v5 B hok hSN
  obtain ⟨l4, h4⟩ := inm_ubase_mul_v5 B hok hSN
  obtain ⟨l5, h5⟩ := tdg_ubase0_mul_v5 B hok hSN
  obtain ⟨l7, h7⟩ := tdg_inm_dT_v5 B hok hSN
  refine ⟨l3 + l4 + l5 + l7, ?_⟩
  intro l0 hl0 S hv hγ hβ hW
  have h09 : (0.9:ℝ) = 9/10 := by norm_num
  have h19 : (1.9:ℝ) = 19/10 := by norm_num
  rw [h09] at hv hγ
  rw [h19] at hβ
  rw [h09]
