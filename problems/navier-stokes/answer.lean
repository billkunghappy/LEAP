        have e2 : (fun n => 2 * |Cb n|) n * qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ (bb n) *
            Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(db n)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) =
            2 * (|Cb n| * (qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ (bb n) *
            Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(db n)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2))) := by
          simp only; ring
        show NB B.h (b γ m) n ξ + NB B.h (b γ (-m)) n ξ ≤ _
        rw [e2]
        linarith
      · have hz : a γ m =ᶠ[nhds ξ] 0 := notMem_tsupport_iff_eventuallyEq.mp hts
        have hTz : T γ m =ᶠ[nhds ξ] (fun _ => (0:ℝ)) :=
