      _ = (1 - axEa Λ t1 κ0 X) * shearB Fn Un X η * Fn X η * (X * (1 / X)) := by rw [hsq]; ring
      _ = _ := by rw [hXinv, mul_one]

theorem ax_cone_natural_bounds : ∀ (h Pst : ℝ) (Pax : ℝ → ℝ), AxDatum h Pst Pax → ∀ (j0 σ δ Λ C K ρ1 ts : ℝ) (Kder M : ℕ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 1 ≤ Λ → 0 < ρ1 → 0 < ts → ts ≤ 1 / 100 → AxAxisOut h j0 σ δ Pax Λ C K ρ1 Kder Fn Un → AxRefPI h j0 σ Pax Λ C K ρ1 M (axRefF Λ ts Fn) (axRefU Λ ts Un) → ∃ Cc : ℝ, 1 ≤ Cc ∧ ∀ X η : ℝ, 4 / Λ ≤ X → X ≤ 4 / Λ * Real.exp ts → -1 < η → η < 1 → 1 / Cc ≤ Fn X η ∧ Fn X η ≤ Cc ∧ 1 / Cc ≤ shearA Fn X η ∧ shearA Fn X η ≤ Cc ∧ |shearB Fn Un X η| ≤ Cc ∧ 21 / 10 < shearA Fn X η + shearB Fn Un X η ^ 2 / shearA Fn X η :=
by
  intro h Pst Pax _hD j0 σ δ Λ C K ρ1 ts Kder M Fn Un hΛ hρ1 hts hts' hA hR
  obtain ⟨hA1, hA2, hA3, hA4, -, hA6, -, -⟩ := hA
  obtain ⟨-, -, -, hR4, -, -⟩ := hR
  have hΛ0 : 0 < Λ := by linarith
  have hX0 : 0 < 4 / Λ := div_pos (by norm_num) hΛ0

  have hexp1 : 1 ≤ Real.exp ts := Real.one_le_exp hts.le
  have hexp2 : Real.exp ts < 41 / 40 := by
    have h1 := Real.abs_exp_sub_one_sub_id_le (x := ts)
      (by rw [abs_of_pos hts]; linarith)
    have h2 := (abs_le.mp h1).2
    nlinarith [mul_le_mul_of_nonneg_left hts' hts.le]
  have hX0m : 4 / Λ ≤ 4 / Λ * Real.exp ts := le_mul_of_one_le_right hX0.le hexp1
  have h41 : 41 / (10 * Λ) = 4 / Λ * (41 / 40) := by field_simp; ring
  have hXm41 : 4 / Λ * Real.exp ts < 41 / (10 * Λ) := by
    rw [h41]; exact mul_lt_mul_of_pos_left hexp2 hX0
  have h41_5 : 41 / (10 * Λ) < 5 / Λ := by
    rw [div_lt_div_iff₀ (by linarith) hΛ0]; linarith
  have h41_110 : 41 / (10 * Λ) ≤ 110 := by
    rw [div_le_iff₀ (by linarith)]; linarith
  have hnegΛ : -1 / Λ < 0 := div_neg_of_neg_of_pos (by norm_num) hΛ0
  set Xm := 4 / Λ * Real.exp ts with hXm_def
  set O : Set (ℝ × ℝ) := Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1) with hO_def
  have hO : IsOpen O := isOpen_Ioo.prod isOpen_Ioo
  set Kb : Set (ℝ × ℝ) := Icc (4 / Λ) Xm ×ˢ Icc (-1 : ℝ) 1 with hK_def
  have hKO : Kb ⊆ O := by
    intro z hz
    obtain ⟨⟨hx1, hx2⟩, he1, he2⟩ := hz
    exact ⟨⟨by linarith, by linarith⟩, by linarith, by linarith⟩
  have hKc : IsCompact Kb := isCompact_Icc.prod isCompact_Icc
  have hKne : Kb.Nonempty := ⟨(4 / Λ, 0), ⟨le_rfl, hX0m⟩, by norm_num, by norm_num⟩
  have hKfacts : ∀ z ∈ Kb, 0 < z.1 ∧ z.1 ≤ 41 / (10 * Λ) ∧ -1 - ρ1 < z.2 ∧ z.2 < 1 + ρ1 := by
    intro z hz
    obtain ⟨⟨hx1, hx2⟩, he1, he2⟩ := hz
    exact ⟨by linarith, by linarith, by linarith, by linarith⟩

  have hs1 : ∀ f : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿f) O →
      ContinuousOn (fun z : ℝ × ℝ => fderiv ℝ (↿f) z (1, 0)) O ∧
