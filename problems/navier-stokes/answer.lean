theorem rfp_extA_N_rep : ∀ P : RfpPar, RfpRegime P → RfpClos P → ∀ x η : ℝ, rfpXv P ≤ x → -1 ≤ η → η ≤ 1 → |rfpExtN P x η| ≤ 2 * P.h * (∫ v in Ioi (Real.log x), Real.exp (v - Real.log x) * rfpE P v η ^ 2) + 4 * (∫ v in Ioc (Real.log x) (rfpY5 P.Md P.lam), Real.exp (v - Real.log x) * rfpE P v η ^ 2) + (1 + 2 * P.h) * (∫ v in Ioi (Real.log x), rfpE P v η ^ 2) :=
by
  intro P hReg hClos x η hx hη1 hη2
  have hReg' := hReg
  obtain ⟨-, -, hl0, -, hh0, -, -, -, -, -⟩ := hReg'
  have hClos' := hClos
