  have hQb0' : 0 < Qb γ.1 := hQb0
  have heps0 : 0 < epsb B.h γ.1 := Real.rpow_pos_of_pos hQb0' _
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = epsb B.h γ.1 ^ (-(1/2:ℝ)) := ⟨_, rfl⟩
  have ha0 : 0 ≤ a := by rw [ha]; exact Real.rpow_nonneg heps0.le _
  have hka : a ≤ ((kb B.h γ.1 : ℕ) : ℝ) := by
    show a ≤ ((⌈epsb B.h γ.1 ^ (-(1/2:ℝ))⌉₊ : ℕ) : ℝ)
    rw [← ha]; exact Nat.le_ceil _
  have hea : epsb B.h γ.1 * a ^ 2 = 1 := by
    rw [ha, ← Real.rpow_natCast, ← Real.rpow_mul heps0.le]
    norm_num
    rw [Real.rpow_neg_one, mul_inv_cancel₀ heps0.ne']
  have hek : 1 ≤ epsb B.h γ.1 * ((kb B.h γ.1 : ℝ)) ^ 2 := by
    have h2 := pow_le_pow_left₀ ha0 hka 2
    nlinarith [mul_le_mul_of_nonneg_left h2 heps0.le]
  have hD1 : 1 ≤ epsb B.h γ.1 * ((kb B.h γ.1 : ℝ)) ^ 2 * (1 + G.ustar ^ 2) ^ (3/2:ℝ) := by
    have h2 : 1 ≤ (1 + G.ustar ^ 2) ^ (3/2:ℝ) :=
      Real.one_le_rpow (le_add_of_nonneg_right (sq_nonneg _)) (by norm_num)
    nlinarith
  have hBs : |Bs5 B G γ| ≤ Real.sqrt Cf := by
    unfold Bs5
    rw [abs_of_nonneg (Real.sqrt_nonneg _)]
    apply Real.sqrt_le_sqrt
    calc _ ≤ lam0_5 B G γ := div_le_self (by linarith) hD1
      _ ≤ Cf := hl2
  have hβb : |β| ≤ Real.sqrt Cf * |G.ustar| := by
    rw [hβdef, abs_div, abs_mul, abs_mul, hsgn, one_mul, abs_two]
    have h1 : |Bs5 B G γ| * |G.ustar| ≤ Real.sqrt Cf * |G.ustar| :=
      mul_le_mul_of_nonneg_right hBs (abs_nonneg _)
    have h2 : 0 ≤ |Bs5 B G γ| * |G.ustar| := by positivity
    linarith
  have hsco : |sco B G γ 0| ≤ |G.ustar| := by
    unfold sco
    rw [mul_zero, zero_div, add_zero, abs_mul, hsgn, one_mul, abs_div, abs_two]
    linarith [abs_nonneg G.ustar]
  have hκb : |κ| ≤ |Cf| * (1 + |G.ustar|) := by
    have hc0f : |c0f5 B G γ| ≤ |Cf| :=
      (abs_le.mpr ⟨by linarith, by linarith⟩).trans (le_abs_self Cf)
    have hsq2 : sco B G γ 0 ^ 2 ≤ |G.ustar| ^ 2 := by
      rw [← sq_abs (sco B G γ 0)]
      exact pow_le_pow_left₀ (abs_nonneg _) hsco 2
    have hsq1 : 1 + sco B G γ 0 ^ 2 ≤ (1 + |G.ustar|) ^ 2 := by
      have e : (1 + |G.ustar|) ^ 2 = 1 + 2 * |G.ustar| + |G.ustar| ^ 2 := by ring
      rw [e]
      linarith [abs_nonneg G.ustar]
    have hsq : Real.sqrt (1 + sco B G γ 0 ^ 2) ≤ 1 + |G.ustar| := by
      calc Real.sqrt (1 + sco B G γ 0 ^ 2) ≤ Real.sqrt ((1 + |G.ustar|) ^ 2) := Real.sqrt_le_sqrt hsq1
        _ = 1 + |G.ustar| := Real.sqrt_sq (by positivity)
    rw [hκdef, abs_mul, abs_mul, abs_one, one_mul, abs_of_nonneg (Real.sqrt_nonneg _)]
    exact mul_le_mul hc0f hsq (Real.sqrt_nonneg _) (abs_nonneg _)

  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ℝ, ρ = Real.sqrt (A ^ 2 + p ^ 2) := ⟨_, rfl⟩
  have hsc0 : 0 < Real.sqrt c0 := Real.sqrt_pos.mpr hc0
  have hρge : Real.sqrt c0 ≤ ρ := by rw [hρdef]; exact Real.sqrt_le_sqrt hc'
  have hρpos : 0 < ρ := lt_of_lt_of_le hsc0 hρge
  have hρne : ρ ≠ 0 := hρpos.ne'
  have hρsq : ρ ^ 2 = A ^ 2 + p ^ 2 := by rw [hρdef]; exact Real.sq_sqrt (by positivity)
  obtain ⟨bb, hbb⟩ : ∃ x : ℝ, x = β / ρ := ⟨_, rfl⟩
  obtain ⟨a4, ha4⟩ : ∃ x : ℝ, x = A / ρ := ⟨_, rfl⟩
  obtain ⟨a5, ha5⟩ : ∃ x : ℝ, x = p / ρ := ⟨_, rfl⟩
  have hβe : β = ρ * bb := by rw [hbb, mul_comm, div_mul_cancel₀ β hρne]
  have hAe : A = ρ * a4 := by rw [ha4, mul_comm, div_mul_cancel₀ A hρne]
  have hpe : p = ρ * a5 := by rw [ha5, mul_comm, div_mul_cancel₀ p hρne]
  have hbbb : |bb| ≤ Real.sqrt Cf * |G.ustar| / Real.sqrt c0 := by
    rw [hbb, abs_div, abs_of_pos hρpos]
    calc |β| / ρ ≤ |β| / Real.sqrt c0 := div_le_div_of_nonneg_left (abs_nonneg _) hsc0 hρge
      _ ≤ Real.sqrt Cf * |G.ustar| / Real.sqrt c0 := div_le_div_of_nonneg_right hβb hsc0.le
  have ha4b : |a4| ≤ 1 := by
    rw [ha4, abs_div, abs_of_pos hρpos, div_le_one hρpos, hρdef]
    exact Real.abs_le_sqrt (le_add_of_nonneg_right (sq_nonneg p))
  have ha5b : |a5| ≤ 1 := by
    rw [ha5, abs_div, abs_of_pos hρpos, div_le_one hρpos, hρdef]
    exact Real.abs_le_sqrt (le_add_of_nonneg_left (sq_nonneg A))
  have hsum : a4 ^ 2 + a5 ^ 2 = 1 := by
    rw [ha4, ha5, div_pow, div_pow, ← add_div, ← hρsq, div_self (pow_ne_zero 2 hρne)]
  have hz0K : ((1:ℝ), bb, κ, a4, a5) ∈ K := by
    rw [hKdef]
    refine ⟨?_, rfl, hsum.symm.le⟩
    rw [mem_closedBall_zero_iff]
    refine norm_prod_le_iff.mpr ⟨?_, norm_prod_le_iff.mpr ⟨?_, norm_prod_le_iff.mpr ⟨?_,
      norm_prod_le_iff.mpr ⟨?_, ?_⟩⟩⟩⟩
    · show ‖(1:ℝ)‖ ≤ R
      rw [norm_one]; linarith
    · show ‖bb‖ ≤ R
      rw [Real.norm_eq_abs]; linarith
    · show ‖κ‖ ≤ R
      rw [Real.norm_eq_abs]; linarith
    · show ‖a4‖ ≤ R
      rw [Real.norm_eq_abs]; linarith
    · show ‖a5‖ ≤ R
      rw [Real.norm_eq_abs]; linarith

  obtain ⟨aa, haadef⟩ : ∃ aa : ℝ × ℝ × ℝ × ℝ × ℝ, aa = ((0:ℝ), bb, κ, a4, a5) := ⟨_, rfl⟩
  obtain ⟨L, hLdef⟩ : ∃ L : (ℝ × ℝ × ℝ) →L[ℝ] (ℝ × ℝ × ℝ × ℝ × ℝ),
      L = (ContinuousLinearMap.inl ℝ ℝ (ℝ × ℝ × ℝ × ℝ)).comp
        (ξ.1⁻¹ • ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)) := ⟨_, rfl⟩
  have hLs : ∀ s : ℝ × ℝ × ℝ, aa + L s = (ξ.1⁻¹ * s.1, bb, κ, a4, a5) := by
    intro s; rw [haadef, hLdef]; simp
  have hz0 : aa + L (ξ.1, ξ.2.1, ξ.2.2.1) = ((1:ℝ), bb, κ, a4, a5) := by
    rw [hLs]; simp [hx0.ne']
  have hsQ : Real.sqrt (Qb γ.1) ≠ 0 := (Real.sqrt_pos.mpr hQb0).ne'
  have hident : ∀ s ∈ {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB},
      Bcol5 B G γ (s.1, s.2.1, s.2.2, Y0) 1 = Φ (aa + L s) := by
    intro s hs
    have hs1 : 0 < s.1 := hs.1
    have hs1' : s.1 ≠ 0 := hs1.ne'
    have hx0' : ξ.1 ≠ 0 := hx0.ne'
    have hn := hΩ s hs
    obtain ⟨η, hη⟩ : ∃ η : Cyl, η = (s.1, s.2.1, s.2.2, Y0) := ⟨_, rfl⟩
    have hη1 : η.1 = s.1 := by rw [hη]
    have hvη : vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = 0 := by rw [hη]; exact hvY0
    rw [← hη] at hn
    have hρ' : pang5 B G γ / RC γ.1 η = A / (ξ.1⁻¹ * s.1) := by
      rw [hAdef]
      unfold RC
      rw [hη1]
      field_simp
    rw [hρ'] at hn
    rw [← hη, hLs s, ← hhom (ξ.1⁻¹ * s.1) bb κ a4 a5 ρ hρpos, ← hβe, ← hAe, ← hpe]
    funext i
    fin_cases i <;> simp [Bcol5, ntan5, hΦ, hn, hvη, hκdef]
  have hev : (fun s : ℝ × ℝ × ℝ => Bcol5 B G γ (s.1, s.2.1, s.2.2, Y0) 1) =ᶠ[nhds (ξ.1, ξ.2.1, ξ.2.2.1)]
      (fun s => Φ (aa + L s)) :=
    Filter.eventuallyEq_of_mem (hΩo.mem_nhds hD) (fun s hs => hident s hs)
  have hz0O : aa + L (ξ.1, ξ.2.1, ξ.2.2.1) ∈ O := by rw [hz0]; exact hKO hz0K
  unfold sJet5
  rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, key aa L _ k hz0O]
  have heq : ((iteratedFDeriv ℝ k Φ (aa + L (ξ.1, ξ.2.1, ξ.2.2.1))).compContinuousLinearMap
      (fun _ => L)).compContinuousLinearMap (fun _ => DqS5 B.h ξ) =
      (iteratedFDeriv ℝ k Φ (aa + L (ξ.1, ξ.2.1, ξ.2.2.1))).compContinuousLinearMap
        (fun _ => L.comp (DqS5 B.h ξ)) := by
    ext v; rfl
  rw [heq]
  have hsc : ξ.1⁻¹ * Real.sqrt (qC B.h ξ) ≤ A0 := by
    have hs2 : 0 < Real.sqrt (2 * B.Xa) := Real.sqrt_pos.mpr (by linarith)
    have h1 : Real.sqrt (qC B.h ξ) * Real.sqrt (2 * B.Xa) ≤ ξ.1 := by
      rw [← Real.sqrt_mul hq0.le]
      calc Real.sqrt (qC B.h ξ * (2 * B.Xa)) ≤ Real.sqrt (ξ.1 ^ 2) :=
            Real.sqrt_le_sqrt (by linarith)
        _ = ξ.1 := Real.sqrt_sq hx0.le
    rw [hA0def, inv_mul_eq_div, ← one_div, div_le_div_iff₀ hx0 hs2]
    linarith
  have hLΛ : ‖L.comp (DqS5 B.h ξ)‖ ≤ A0 := by
    refine ContinuousLinearMap.opNorm_le_bound _ hA0 (fun v => ?_)
    have e : (L.comp (DqS5 B.h ξ)) v = (ξ.1⁻¹ * (Real.sqrt (qC B.h ξ) * v.1), (0 : ℝ × ℝ × ℝ × ℝ)) := by
      rw [hLdef]; rfl
    rw [e, Prod.norm_def, norm_zero, max_eq_left (norm_nonneg _), Real.norm_eq_abs, abs_mul, abs_mul,
      abs_of_pos (inv_pos.mpr hx0), abs_of_nonneg (Real.sqrt_nonneg _)]
    have hv : |v.1| ≤ ‖v‖ := by rw [← Real.norm_eq_abs]; exact norm_fst_le v
    calc ξ.1⁻¹ * (Real.sqrt (qC B.h ξ) * |v.1|) = (ξ.1⁻¹ * Real.sqrt (qC B.h ξ)) * |v.1| := by ring
      _ ≤ A0 * ‖v‖ := mul_le_mul hsc hv (abs_nonneg _) hA0
  have hDb : ‖iteratedFDeriv ℝ k Φ (aa + L (ξ.1, ξ.2.1, ξ.2.2.1))‖ ≤ |Mk| := by
    rw [hz0, ← iteratedFDerivWithin_of_isOpen (f := Φ) k hOo (hKO hz0K)]
    exact (hMk _ hz0K).trans (le_abs_self _)
  calc _ ≤ ‖iteratedFDeriv ℝ k Φ (aa + L (ξ.1, ξ.2.1, ξ.2.2.1))‖ * ∏ _i : Fin k, ‖L.comp (DqS5 B.h ξ)‖ :=
        ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ = ‖iteratedFDeriv ℝ k Φ (aa + L (ξ.1, ξ.2.1, ξ.2.2.1))‖ * ‖L.comp (DqS5 B.h ξ)‖ ^ k := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    _ ≤ |Mk| * A0 ^ k :=
        mul_le_mul hDb (pow_le_pow_left₀ (norm_nonneg _) hLΛ k) (by positivity) (abs_nonneg _)

theorem pulse5_coeff_sjet : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (ξ : Cyl), ActiveL4 B G γ → ξ ∈ DomC B.h B.qB → etaL B.h γ ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → (∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), sJet5 (fun s : ℝ × ℝ × ℝ => fun i j : Fin 3 => (APhi5 B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) - dDamp5 B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) • (1 : Matrix (Fin 3) (Fin 3) ℝ)) i j) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) k ≤ C * SC B.h ξ ^ b) ∧ sJet5 (fun s : ℝ × ℝ × ℝ => Bcol5 B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + ((0:ℝ) * cib B.h γ.1 - G.r0) • vtv)) 1) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) k ≤ C * SC B.h ξ ^ b :=
by
  intro B G hB hG k
  have hr0 : 0 < G.r0 := hG.1.1
  have hr1 : G.r0 ≤ 1/100 := hG.1.2.1
  have hh : 0 < B.h := hB.2.1.1
  obtain ⟨hΩo, -⟩ := geom_slow_base_smooth_v5 B hB
  obtain ⟨c, hc, hlow⟩ := pulse5_nsq_lower_v5 B G hB hG
  obtain ⟨D, hD0, hDb⟩ := pulse5_slow_entries_nb_v5 B G hB hG k
  obtain ⟨C', hC'0, hC'⟩ := nb_aphi_entry_poly_v5 k c D hc
  obtain ⟨Cb, hCb0, hCb⟩ := pulse5_bcol_sjet_v5 B G hB hG c hc k
  refine ⟨max (max C' Cb) 0, ((2 * k + 3 : ℕ) : ℝ), ?_⟩
  intro γ ξ hact hdom hη hXa hXb

  let π : Cyl →L[ℝ] (ℝ × ℝ × ℝ) :=
    (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))).prod
      (((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))).prod
        ((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp
          ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
            (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))))))
  let ι : (ℝ × ℝ × ℝ) →L[ℝ] Cyl :=
    (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).prod
      (((ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))).prod
        (((ContinuousLinearMap.snd ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))).prod
          (0 : (ℝ × ℝ × ℝ) →L[ℝ] (ℝ × ℝ))))
  have hι : ∀ x : ℝ × ℝ × ℝ, ι x = (x.1, x.2.1, x.2.2, ((0:ℝ), (0:ℝ))) := fun x => rfl
  have hιn : ∀ x : ℝ × ℝ × ℝ, ‖ι x‖ ≤ ‖x‖ := by
    intro x
    rw [hι]
    have h1 : ‖x.1‖ ≤ ‖x‖ := norm_fst_le x
    have h2 : ‖x.2.1‖ ≤ ‖x‖ := (norm_fst_le x.2).trans (norm_snd_le x)
    have h3 : ‖x.2.2‖ ≤ ‖x‖ := (norm_snd_le x.2).trans (norm_snd_le x)
    have h4 : ‖((0:ℝ), (0:ℝ))‖ = 0 := by simp
    rw [Prod.norm_def, Prod.norm_def, Prod.norm_def, h4]
    exact max_le h1 (max_le h2 (max_le h3 (norm_nonneg _)))

  have hS6 : ∀ (f : ℝ × ℝ × ℝ → Fin 3 → Fin 3 → ℝ) (A : ℝ), 0 ≤ A →
      ContDiffAt ℝ ∞ f (ξ.1, ξ.2.1, ξ.2.2.1) →
      (∀ a b : Fin 3, NB B.h (fun η : Cyl => f (η.1, η.2.1, η.2.2.1) a b) k ξ ≤ A) →
      ‖(iteratedFDeriv ℝ k f (ξ.1, ξ.2.1, ξ.2.2.1)).compContinuousLinearMap
        (fun _ : Fin k => DqS5 B.h ξ)‖ ≤ A := by
    intro f A hA hf hNB
    apply ContinuousMultilinearMap.opNorm_le_bound hA
    intro m
    have hprod : 0 ≤ ∏ i, ‖m i‖ := Finset.prod_nonneg (fun i _ => norm_nonneg _)
    simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [pi_norm_le_iff_of_nonneg (mul_nonneg hA hprod)]
    intro a
    rw [pi_norm_le_iff_of_nonneg (mul_nonneg hA hprod)]
    intro b
    let P : (Fin 3 → Fin 3 → ℝ) →L[ℝ] ℝ :=
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℝ) b).comp
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => Fin 3 → ℝ) a)
    have hg : ContDiffAt ℝ ∞ (P ∘ f) (ξ.1, ξ.2.1, ξ.2.2.1) :=
      P.contDiff.contDiffAt.comp _ hf
    have h1 : iteratedFDeriv ℝ k (P ∘ f) (ξ.1, ξ.2.1, ξ.2.2.1) =
        P.compContinuousMultilinearMap (iteratedFDeriv ℝ k f (ξ.1, ξ.2.1, ξ.2.2.1)) :=
      P.iteratedFDeriv_comp_left hf (by exact_mod_cast le_top)
    have h1' : (iteratedFDeriv ℝ k f (ξ.1, ξ.2.1, ξ.2.2.1) (fun i => DqS5 B.h ξ (m i))) a b =
        iteratedFDeriv ℝ k (P ∘ f) (ξ.1, ξ.2.1, ξ.2.2.1) (fun i => DqS5 B.h ξ (m i)) := by
      rw [h1]; rfl
    rw [h1']

    obtain ⟨u, hu, hfu⟩ := hg.contDiffOn (m := (k : ℕ∞ω)) (by exact_mod_cast le_top) (by simp)
    obtain ⟨t, htu, ht_open, hs0t⟩ := mem_nhds_iff.mp hu
    have hft : ContDiffOn ℝ k (P ∘ f) t := hfu.mono htu
    have hpre_open : IsOpen (π ⁻¹' t) := ht_open.preimage π.continuous
    have hξt : ξ ∈ π ⁻¹' t := hs0t
    have hchain := π.iteratedFDerivWithin_comp_right hft ht_open.uniqueDiffOn
      hpre_open.uniqueDiffOn hξt le_rfl
    have e1 : iteratedFDerivWithin ℝ k ((P ∘ f) ∘ ⇑π) (π ⁻¹' t) ξ =
        iteratedFDeriv ℝ k ((P ∘ f) ∘ ⇑π) ξ :=
      iteratedFDerivWithin_of_isOpen k hpre_open hξt
    have e2 : iteratedFDerivWithin ℝ k (P ∘ f) t (π ξ) =
        iteratedFDeriv ℝ k (P ∘ f) (ξ.1, ξ.2.1, ξ.2.2.1) :=
      iteratedFDerivWithin_of_isOpen k ht_open hs0t
    rw [e1, e2] at hchain
    have hfeq : (fun η : Cyl => f (η.1, η.2.1, η.2.2.1) a b) = (P ∘ f) ∘ ⇑π := rfl
    have key : iteratedFDeriv ℝ k (P ∘ f) (ξ.1, ξ.2.1, ξ.2.2.1) (fun i => DqS5 B.h ξ (m i)) =
        ((iteratedFDeriv ℝ k ((P ∘ f) ∘ ⇑π) ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ))
          (fun i => ι (m i)) := by
      rw [hchain]; rfl
    rw [key]
    refine (ContinuousMultilinearMap.le_opNorm _ _).trans ?_
    have hpm : ∏ i, ‖ι (m i)‖ ≤ ∏ i, ‖m i‖ := by
      gcongr with i
      exact hιn (m i)
    apply mul_le_mul _ hpm (Finset.prod_nonneg (fun i _ => norm_nonneg _)) hA
    have := hNB a b
    rw [hfeq] at this
    exact this

  have hSC1 : 1 ≤ SC B.h ξ := by
    show 1 ≤ (1 + |Real.log (qC B.h ξ)|) ^ 2
    exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h ξ))])
  have hSCb : SC B.h ξ ^ (((2 * k + 3 : ℕ) : ℝ)) = SC B.h ξ ^ (2 * k + 3) := Real.rpow_natCast _ _
  have hSCp1 : 1 ≤ SC B.h ξ ^ (2 * k + 3) := one_le_pow₀ hSC1
  have hCmax : 0 ≤ max (max C' Cb) 0 := le_max_right _ _
  have hQb0 : 0 < Qb γ.1 := Real.rpow_pos_of_pos two_pos _
  have hQb1 : Qb γ.1 ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos one_le_two (by simp)
  have heps0 : 0 < epsb B.h γ.1 := Real.rpow_pos_of_pos hQb0 _
  have heps1 : epsb B.h γ.1 ≤ 1 := Real.rpow_le_one hQb0.le hQb1 hh.le
  have he : |epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2| ≤ 4 := by
    obtain ⟨a, ha⟩ : ∃ a : ℝ, a = epsb B.h γ.1 ^ (-(1/2:ℝ)) := ⟨_, rfl⟩
    have ha1 : 1 ≤ a := by
      rw [ha]; exact Real.one_le_rpow_of_pos_of_le_one_of_nonpos heps0 heps1 (by norm_num)
    have hka : ((kb B.h γ.1 : ℕ) : ℝ) < a + 1 := by
      show ((⌈epsb B.h γ.1 ^ (-(1/2:ℝ))⌉₊ : ℕ) : ℝ) < a + 1
      rw [← ha]; exact Nat.ceil_lt_add_one (by linarith)
    have hk0 : (0:ℝ) ≤ ((kb B.h γ.1 : ℕ) : ℝ) := Nat.cast_nonneg _
    have hea : epsb B.h γ.1 * a ^ 2 = 1 := by
      rw [ha, ← Real.rpow_natCast, ← Real.rpow_mul heps0.le]
      norm_num
      rw [Real.rpow_neg_one, mul_inv_cancel₀ heps0.ne']
    have hk2 : ((kb B.h γ.1 : ℕ) : ℝ) ^ 2 ≤ 4 * a ^ 2 := by nlinarith
    have hpos : 0 ≤ epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 := by positivity
    rw [abs_of_nonneg hpos]
    nlinarith [mul_le_mul_of_nonneg_left hk2 heps0.le]
  have hTgc : 0 < Tgc := by unfold Tgc; positivity
  have hcib : 0 < cib B.h γ.1 := by
    unfold cib; exact mul_pos (zpow_pos hTgc _) (Real.rpow_pos_of_pos hQb0 _)
  have hL0 : 0 ≤ Lsb B.h G.r0 γ.1 := by
    unfold Lsb; exact div_nonneg (by linarith) hcib.le

  have hUo : IsOpen (DomC B.h B.qB) := hΩo.preimage π.continuous
  have hmaps : Set.MapsTo π (DomC B.h B.qB)
      {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} :=
    fun η hη => hη
  obtain ⟨hAs, hPsis, hKms, hMs⟩ := pulse5_slow_smooth_v5 B G γ hB
  refine ⟨fun v hv => ?_, ?_⟩
  ·
    have hEv : (fun s : ℝ × ℝ × ℝ => fun i j : Fin 3 => (APhi5 B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) - dDamp5 B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) • (1 : Matrix (Fin 3) (Fin 3) ℝ)) i j) =ᶠ[nhds (ξ.1, ξ.2.1, ξ.2.2.1)]
        (fun s : ℝ × ℝ × ℝ => fun i j : Fin 3 => pcM5 B G γ s v i j) := by
      refine Filter.eventuallyEq_of_mem (hΩo.mem_nhds hdom) (fun s hs => ?_)
      have hm := (pulse5_slice_model_v5 B G γ v hB hr0 hr1 hv s hs).2.2.2.1
      show (fun i j : Fin 3 => _) = fun i j : Fin 3 => _
      rw [hm]
    unfold sJet5
    rw [(hEv.iteratedFDeriv ℝ k).eq_of_nhds]
    have hMv : ContDiffAt ℝ ∞ (fun s : ℝ × ℝ × ℝ => fun i j : Fin 3 => pcM5 B G γ s v i j)
        (ξ.1, ξ.2.1, ξ.2.2.1) := (hMs v).contDiffAt (hΩo.mem_nhds hdom)
    have hAnn : 0 ≤ C' * SC B.h ξ ^ (2 * k + 3) := mul_nonneg hC'0 (by linarith)
    refine (hS6 _ (C' * SC B.h ξ ^ (2 * k + 3)) hAnn hMv (fun a b => ?_)).trans ?_
    · have hNs : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => pcN5 B G γ (η.1, η.2.1, η.2.2.1) v i)
          (DomC B.h B.qB) := fun i =>
        ((hAs i).sub (contDiffOn_const.mul (hPsis i))).comp π.contDiff.contDiffOn hmaps
      have hPs : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => pcPsi5 B G γ (η.1, η.2.1, η.2.2.1) i)
          (DomC B.h B.qB) := fun i => (hPsis i).comp π.contDiff.contDiffOn hmaps
      have hKs : ∀ i j : Fin 3, ContDiffOn ℝ ∞
          (fun η : Cyl => pcKm5 B γ.1 (η.1, η.2.1, η.2.2.1) i j) (DomC B.h B.qB) := fun i j =>
        (hKms i j).comp π.contDiff.contDiffOn hmaps
      have hl := hlow γ ξ hact hdom hη hXa hXb v hv
      have hcn : c ≤ pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 * pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 +
          pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 1 * pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 1 +
          pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 2 * pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 2 := by
        nlinarith [mul_self_nonneg (pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0)]
      have hq := hC' B.h (SC B.h ξ) (epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2) (DomC B.h B.qB) ξ
        (fun i η => pcN5 B G γ (η.1, η.2.1, η.2.2.1) v i)
        (fun i η => pcPsi5 B G γ (η.1, η.2.1, η.2.2.1) i)
        (fun i j η => pcKm5 B γ.1 (η.1, η.2.1, η.2.2.1) i j) hUo hdom hSC1 he hNs hPs hKs hcn
        (fun j hj => hDb γ ξ hact hdom hη hXa hXb v hv j hj) a b
      convert hq using 2
      funext η
      simp only [pcM5, Matrix.sub_apply, Matrix.add_apply, Matrix.neg_apply, Matrix.smul_apply,
        Matrix.vecMulVec_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_three, Matrix.one_apply,
        Pi.sub_apply, Pi.neg_apply, smul_eq_mul]
      ring
    · rw [hSCb]
      exact mul_le_mul_of_nonneg_right (le_trans (le_max_left _ _) (le_max_left _ _)) (by linarith)
  ·
    have h0L : (0:ℝ) ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1) := ⟨le_rfl, hL0⟩
    have hl0 := hlow γ ξ hact hdom hη hXa hXb 0 h0L
    have hbc := hCb γ ξ hact hdom hη hXa hl0
    calc _ ≤ Cb := hbc
      _ ≤ max (max C' Cb) 0 := le_trans (le_max_right _ _) (le_max_left _ _)
      _ ≤ max (max C' Cb) 0 * SC B.h ξ ^ (((2 * k + 3 : ℕ) : ℝ)) := by
          rw [hSCb]; exact le_mul_of_one_le_right hCmax hSCp1

theorem jet_ode_forcing : ∀ (U : Set (ℝ × ℝ × ℝ)) (T : (ℝ × ℝ × ℝ) × ℝ → Fin 3 → ℝ) (M : (ℝ × ℝ × ℝ) × ℝ → Fin 3 → Fin 3 → ℝ) (s0 : ℝ × ℝ × ℝ) (a b : ℝ) (Λ : (ℝ × ℝ × ℝ) →L[ℝ] (ℝ × ℝ × ℝ)) (k : ℕ) (m : Fin k → ℝ × ℝ × ℝ), IsOpen U → s0 ∈ U → ContDiffOn ℝ ∞ T (U ×ˢ Set.univ) → ContDiffOn ℝ ∞ M (U ×ˢ Set.univ) → (∀ s ∈ U, ∀ v ∈ Set.Icc a b, HasDerivAt (fun w => T (s, w)) (Matrix.mulVec (M (s, v)) (T (s, v))) v) → ∃ f : ℝ → Fin 3 → ℝ, ∀ v ∈ Set.Icc a b, HasDerivAt (fun w => (iteratedFDeriv ℝ k (fun s => T (s, w)) s0) (fun i => Λ (m i))) (Matrix.mulVec (M (s0, v)) ((iteratedFDeriv ℝ k (fun s => T (s, v)) s0) (fun i => Λ (m i))) + f v) v ∧ ‖f v‖ ≤ 3 * (∑ i ∈ Finset.range k, (k.choose (i + 1) : ℝ) * sJet5 (fun s => M (s, v)) s0 Λ (i + 1) * sJet5 (fun s => T (s, v)) s0 Λ (k - (i + 1))) * ∏ i, ‖m i‖ :=
by
  intro U T M s0 a b Λ k m hU hs0 hT hM hode

  have vcomm : ∀ (U : Set (ℝ × ℝ × ℝ)) (g : (ℝ × ℝ × ℝ) × ℝ → (Fin 3 → ℝ)) (s0 : ℝ × ℝ × ℝ) (j : ℕ) (v : ℝ), IsOpen U → s0 ∈ U → ContDiffOn ℝ ∞ g (U ×ˢ Set.univ) → HasDerivAt (fun v' => iteratedFDeriv ℝ j (fun s => g (s, v')) s0) (iteratedFDeriv ℝ j (fun s => deriv (fun v'' => g (s, v'')) v) s0) v := by
    intro U g s0 j v hU hs0 hg
    have symmG : ∀ {E V : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup V]
        [NormedSpace ℝ V] (U : Set E) (f : E → V), IsOpen U → ContDiffOn ℝ ∞ f U → ∀ z ∈ U,
        ∀ (m : ℕ) (w : Fin m → E) (σ : Equiv.Perm (Fin m)),
        iteratedFDeriv ℝ m f z (w ∘ σ) = iteratedFDeriv ℝ m f z w := by
      intro E V _ _ _ _ U f hU hf z hz m w σ
      have hperm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (n : ℕ)
          (A : ContinuousMultilinearMap ℝ (fun _ : Fin (n + 1) => E) W),
          (∀ (i : Fin n) (w : Fin (n + 1) → E), A (w ∘ Equiv.swap i.castSucc i.succ) = A w) →
          ∀ (w : Fin (n + 1) → E) (σ : Equiv.Perm (Fin (n + 1))), A (w ∘ σ) = A w := by
        intro W _ _ n A hA w σ
        have hσ : σ ∈ Submonoid.closure (Set.range fun i : Fin n => Equiv.swap i.castSucc i.succ) := by
          rw [Equiv.Perm.mclosure_swap_castSucc_succ]; exact Submonoid.mem_top σ
        induction hσ using Submonoid.closure_induction generalizing w with
        | mem x hx => obtain ⟨i, rfl⟩ := hx; exact hA i w
        | one => rfl
        | mul x y _ _ hx hy =>
          rw [Equiv.Perm.coe_mul, ← Function.comp_assoc, hy, hx]
      have Q : ∀ k : ℕ, ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (g : E → W),
          ContDiffOn ℝ ∞ g U → ∀ y ∈ U, ∀ (u : Fin (k + 2) → E) (τ : Equiv.Perm (Fin (k + 2))),
          iteratedFDeriv ℝ (k + 2) g y (u ∘ τ) = iteratedFDeriv ℝ (k + 2) g y u := by
        intro k
        induction k with
        | zero =>
          intro W _ _ g hg y hy u τ
          refine hperm 1 (iteratedFDeriv ℝ 2 g y) ?_ u τ
          intro i v
          have hi : i = 0 := Subsingleton.elim _ _
          subst hi
          have hS : IsSymmSndFDerivAt ℝ g y :=
            (hg.contDiffAt (hU.mem_nhds hy)).isSymmSndFDerivAt
              (by rw [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.mpr le_top)
          rw [iteratedFDeriv_two_apply, iteratedFDeriv_two_apply]
          simp only [Function.comp_apply]
          have h0 : Equiv.swap (0 : Fin 1).castSucc (0 : Fin 1).succ 0 = 1 := by decide
          have h1 : Equiv.swap (0 : Fin 1).castSucc (0 : Fin 1).succ 1 = 0 := by decide
          rw [h0, h1]
          exact hS.eq _ _
        | succ k ih =>
          intro W _ _ g hg y hy u τ
          have hgy : ContDiffAt ℝ ∞ g y := hg.contDiffAt (hU.mem_nhds hy)
          have hzero : ∀ v : Fin (k + 2 + 1) → E,
              iteratedFDeriv ℝ (k + 2 + 1) g y
                (v ∘ Equiv.swap (0 : Fin (k + 2)).castSucc (0 : Fin (k + 2)).succ) =
              iteratedFDeriv ℝ (k + 2 + 1) g y v := by
            intro v
            have hg' : ContDiffOn ℝ ∞ (fderiv ℝ g) U :=
              ((contDiffOn_infty_iff_fderiv_of_isOpen hU).mp hg).2
            rw [iteratedFDeriv_succ_apply_right (n := k + 2), iteratedFDeriv_succ_apply_right (n := k + 2)]
            have hlast : (v ∘ Equiv.swap (0 : Fin (k + 2)).castSucc (0 : Fin (k + 2)).succ)
                (Fin.last (k + 2)) = v (Fin.last (k + 2)) := by
              simp only [Function.comp_apply]
              rw [Equiv.swap_apply_of_ne_of_ne]
              · apply Fin.ne_of_val_ne; simp
              · apply Fin.ne_of_val_ne; simp
            have hinit : Fin.init (v ∘ Equiv.swap (0 : Fin (k + 2)).castSucc (0 : Fin (k + 2)).succ) =
                Fin.init v ∘ Equiv.swap (0 : Fin (k + 1)).castSucc (0 : Fin (k + 1)).succ := by
              funext l
              simp only [Fin.init, Function.comp_apply]
              congr 1
              rw [Function.Injective.map_swap (Fin.castSucc_injective _)]
              congr 1
            rw [hlast, hinit]
            exact congrArg (fun A => A (v (Fin.last (k + 2))))
              (ih (fderiv ℝ g) hg' y hy (Fin.init v)
                (Equiv.swap (0 : Fin (k + 1)).castSucc (0 : Fin (k + 1)).succ))
          have hsucc : ∀ (j : Fin (k + 1)) (v : Fin (k + 2 + 1) → E),
              iteratedFDeriv ℝ (k + 2 + 1) g y (v ∘ Equiv.swap j.succ.castSucc j.succ.succ) =
              iteratedFDeriv ℝ (k + 2 + 1) g y v := by
            intro j v
            rw [iteratedFDeriv_succ_apply_left (n := k + 2), iteratedFDeriv_succ_apply_left (n := k + 2)]
            have h0 : (v ∘ Equiv.swap j.succ.castSucc j.succ.succ) 0 = v 0 := by
              simp only [Function.comp_apply]
              rw [Equiv.swap_apply_of_ne_of_ne]
              · rw [← Fin.succ_castSucc]; exact (Fin.succ_ne_zero _).symm
              · exact (Fin.succ_ne_zero _).symm
            have htail : Fin.tail (v ∘ Equiv.swap j.succ.castSucc j.succ.succ) =
                Fin.tail v ∘ Equiv.swap j.castSucc j.succ := by
              funext l
              simp only [Fin.tail, Function.comp_apply]
              rw [Function.Injective.map_swap (Fin.succ_injective _), Fin.succ_castSucc]
            rw [h0, htail]
            have hd : DifferentiableAt ℝ (iteratedFDeriv ℝ (k + 2) g) y :=
              hgy.differentiableAt_iteratedFDeriv
                (WithTop.coe_lt_coe.mpr (ENat.natCast_lt_top (k + 2)))
            rw [← fderiv_continuousMultilinear_apply_const_apply hd
                  (Fin.tail v ∘ Equiv.swap j.castSucc j.succ) (v 0),
                ← fderiv_continuousMultilinear_apply_const_apply hd (Fin.tail v) (v 0)]
            congr 1
            apply Filter.EventuallyEq.fderiv_eq
            filter_upwards [hU.mem_nhds hy] with y' hy'
            exact ih g hg y' hy' _ _
          show iteratedFDeriv ℝ (k + 2 + 1) g y (u ∘ τ) = iteratedFDeriv ℝ (k + 2 + 1) g y u
          refine hperm (k + 2) (iteratedFDeriv ℝ (k + 2 + 1) g y) ?_ u τ
          intro i v
          refine Fin.cases ?_ (fun j => ?_) i
          · exact hzero v
          · exact hsucc j v
      rcases m with _ | _ | k
      · congr 1; funext i; exact Fin.elim0 i
      · congr 1; funext i; simp only [Function.comp_apply]; congr 1
        exact Fin.ext (by have := (σ i).isLt; have := i.isLt; omega)
      · exact Q k f hf z hz w σ
    have pbG : ∀ {E E' V : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup E']
        [NormedSpace ℝ E'] [NormedAddCommGroup V] [NormedSpace ℝ V] (O : Set E) (h : E → V) (c : E)
        (M : E' →L[ℝ] E) (y0 : E') (n : ℕ), IsOpen O → ContDiffOn ℝ ∞ h O → c + M y0 ∈ O →
        iteratedFDeriv ℝ n (fun y => h (c + M y)) y0 =
          (iteratedFDeriv ℝ n h (c + M y0)).compContinuousLinearMap (fun _ => M) := by
      intro E E' V _ _ _ _ _ _ O h c M y0 n hO hh hc
      have hO1o : IsOpen {z : E | c + z ∈ O} := hO.preimage (continuous_const.add continuous_id)
      have hh1 : ContDiffOn ℝ ∞ (fun z => h (c + z)) {z : E | c + z ∈ O} :=
        hh.comp (contDiff_const.add contDiff_id).contDiffOn (fun z hz => hz)
      have hO2o : IsOpen (M ⁻¹' {z : E | c + z ∈ O}) := hO1o.preimage M.continuous
      have hy0 : y0 ∈ M ⁻¹' {z : E | c + z ∈ O} := hc
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := (fun z => h (c + z)) ∘ M) n hO2o hy0
      have e2 := M.iteratedFDerivWithin_comp_right hh1 hO1o.uniqueDiffOn hO2o.uniqueDiffOn hy0 (i := n)
        (by exact_mod_cast le_top)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => h (c + z)) n hO1o
        (show M y0 ∈ {z : E | c + z ∈ O} from hc)
      rw [iteratedFDeriv_comp_add_left] at e3
      show iteratedFDeriv ℝ n ((fun z => h (c + z)) ∘ M) y0 = _
      rw [← e1, e2, e3]
    obtain ⟨O, hOdef⟩ : ∃ O : Set ((ℝ × ℝ × ℝ) × ℝ), O = U ×ˢ Set.univ := ⟨_, rfl⟩
    rw [← hOdef] at hg
    have hO : IsOpen O := by rw [hOdef]; exact hU.prod isOpen_univ
    have hmem : ∀ s ∈ U, ∀ r : ℝ, ((s, r) : (ℝ × ℝ × ℝ) × ℝ) ∈ O := by
      intro s hs r; rw [hOdef]; exact ⟨hs, trivial⟩
    obtain ⟨ι, hι⟩ : ∃ M : (ℝ × ℝ × ℝ) →L[ℝ] (ℝ × ℝ × ℝ) × ℝ,
        M = ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ := ⟨_, rfl⟩
    have star : ∀ (h : (ℝ × ℝ × ℝ) × ℝ → (Fin 3 → ℝ)), ContDiffOn ℝ ∞ h O → ∀ s ∈ U, ∀ r : ℝ,
        ∀ n : ℕ, iteratedFDeriv ℝ n (fun s' => h (s', r)) s =
          (iteratedFDeriv ℝ n h (s, r)).compContinuousLinearMap (fun _ => ι) := by
      intro h hh s hs r n
      have hcy : ∀ y : ℝ × ℝ × ℝ, (((0 : ℝ × ℝ × ℝ), r) : (ℝ × ℝ × ℝ) × ℝ) + ι y = (y, r) := by
        intro y; rw [hι]; simp
      have := pbG O h ((0 : ℝ × ℝ × ℝ), r) ι s n hO hh (by rw [hcy]; exact hmem s hs r)
      simp only [hcy] at this
      exact this
    have p0O : ((s0, v) : (ℝ × ℝ × ℝ) × ℝ) ∈ O := hmem s0 hs0 v
    have hgp : ContDiffAt ℝ ∞ g (s0, v) := hg.contDiffAt (hO.mem_nhds p0O)
    have hΦd : DifferentiableAt ℝ (iteratedFDeriv ℝ j g) (s0, v) :=
      hgp.differentiableAt_iteratedFDeriv (WithTop.coe_lt_coe.mpr (ENat.natCast_lt_top j))
    obtain ⟨e, he⟩ : ∃ e : (ℝ × ℝ × ℝ) × ℝ, e = ((0 : ℝ × ℝ × ℝ), (1 : ℝ)) := ⟨_, rfl⟩
    have hγ : ∀ s : ℝ × ℝ × ℝ, HasDerivAt (fun r : ℝ => ((s, r) : (ℝ × ℝ × ℝ) × ℝ)) e v := by
      intro s; rw [he]; exact (hasDerivAt_const v s).prodMk (hasDerivAt_id v)
    have h1 : HasDerivAt (fun r => iteratedFDeriv ℝ j g (s0, r))
        (fderiv ℝ (iteratedFDeriv ℝ j g) (s0, v) e) v :=
      hΦd.hasFDerivAt.comp_hasDerivAt v (hγ s0)
    obtain ⟨Cι, hCι⟩ : ∃ C : ContinuousMultilinearMap ℝ (fun _ : Fin j => (ℝ × ℝ × ℝ) × ℝ) (Fin 3 → ℝ)
        →L[ℝ] ContinuousMultilinearMap ℝ (fun _ : Fin j => ℝ × ℝ × ℝ) (Fin 3 → ℝ),
        C = ContinuousMultilinearMap.compContinuousLinearMapL (fun _ => ι) := ⟨_, rfl⟩
    have h2 : HasDerivAt (fun v' => iteratedFDeriv ℝ j (fun s => g (s, v')) s0)
        (Cι (fderiv ℝ (iteratedFDeriv ℝ j g) (s0, v) e)) v := by
      have h := Cι.hasFDerivAt.comp_hasDerivAt v h1
      convert h using 1
      funext r
      simp only [Function.comp_apply, hCι, ContinuousMultilinearMap.compContinuousLinearMapL_apply]
      exact star g hg s0 hs0 r j
    refine h2.congr_deriv ?_
    have hfd' : ContDiffOn ℝ ∞ (fderiv ℝ g) O := ((contDiffOn_infty_iff_fderiv_of_isOpen hO).mp hg).2
    obtain ⟨g1, hg1⟩ : ∃ g1 : (ℝ × ℝ × ℝ) × ℝ → (Fin 3 → ℝ), g1 = fun y => fderiv ℝ g y e :=
      ⟨_, rfl⟩
    have hg1s : ContDiffOn ℝ ∞ g1 O := by rw [hg1]; exact hfd'.clm_apply contDiffOn_const
    have hg1comp : iteratedFDeriv ℝ j g1 (s0, v) =
        (ContinuousLinearMap.apply ℝ (Fin 3 → ℝ) e).compContinuousMultilinearMap
          (iteratedFDeriv ℝ j (fun y => fderiv ℝ g y) (s0, v)) := by
      rw [hg1]
      exact (ContinuousLinearMap.apply ℝ (Fin 3 → ℝ) e).iteratedFDeriv_comp_left
        (hfd'.contDiffAt (hO.mem_nhds p0O)) (i := j) (by exact_mod_cast le_top)
    have hderiv_eq : (fun s => g1 (s, v)) =ᶠ[nhds s0] (fun s => deriv (fun v'' => g (s, v'')) v) := by
      filter_upwards [hU.mem_nhds hs0] with s hs
      have hfd : DifferentiableAt ℝ g (s, v) :=
        (hg.contDiffAt (hO.mem_nhds (hmem s hs v))).differentiableAt (by simp)
      have h3 : HasDerivAt (fun v'' => g (s, v'')) (fderiv ℝ g (s, v) e) v :=
        hfd.hasFDerivAt.comp_hasDerivAt v (hγ s)
      rw [h3.deriv, hg1]
    rw [← (hderiv_eq.iteratedFDeriv ℝ j).eq_of_nhds, star g1 hg1s s0 hs0 v j, hCι]
    ext m
    simp only [ContinuousMultilinearMap.compContinuousLinearMapL_apply,
      ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [hg1comp, ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      ContinuousLinearMap.apply_apply]
    have hL : iteratedFDeriv ℝ (j + 1) g (s0, v)
        (Fin.cons e (fun i => ι (m i)) : Fin (j + 1) → (ℝ × ℝ × ℝ) × ℝ) =
        fderiv ℝ (iteratedFDeriv ℝ j g) (s0, v) e (fun i => ι (m i)) := by
      rw [iteratedFDeriv_succ_apply_left, Fin.cons_zero, Fin.tail_cons]
    have hR : iteratedFDeriv ℝ (j + 1) g (s0, v)
        (Fin.snoc (fun i => ι (m i)) e : Fin (j + 1) → (ℝ × ℝ × ℝ) × ℝ) =
        iteratedFDeriv ℝ j (fun y => fderiv ℝ g y) (s0, v) (fun i => ι (m i)) e := by
      rw [iteratedFDeriv_succ_apply_right, Fin.init_snoc, Fin.snoc_last]
    have hrot : (Fin.cons e (fun i => ι (m i)) : Fin (j + 1) → (ℝ × ℝ × ℝ) × ℝ) ∘ finRotate (j + 1) =
        (Fin.snoc (fun i => ι (m i)) e : Fin (j + 1) → (ℝ × ℝ × ℝ) × ℝ) := by
      funext i
      exact (congrFun (Fin.snoc_eq_cons_rotate (fun i => ι (m i)) e) i).symm
    have hsymm := symmG O g hO hg (s0, v) p0O (j + 1)
      (Fin.cons e (fun i => ι (m i)) : Fin (j + 1) → (ℝ × ℝ × ℝ) × ℝ) (finRotate (j + 1))
    rw [← hL, ← hR, ← hrot]
    exact congrFun hsymm.symm _

  obtain ⟨Bil, hBn, hBap⟩ : ∃ B : (Fin 3 → Fin 3 → ℝ) →L[ℝ] (Fin 3 → ℝ) →L[ℝ] (Fin 3 → ℝ),
      ‖B‖ ≤ 3 ∧ ∀ (A : Fin 3 → Fin 3 → ℝ) (z : Fin 3 → ℝ), B A z = Matrix.mulVec A z := by
    let B0 : (Fin 3 → Fin 3 → ℝ) →ₗ[ℝ] (Fin 3 → ℝ) →ₗ[ℝ] (Fin 3 → ℝ) :=
      LinearMap.mk₂ ℝ (fun A z => Matrix.mulVec A z)
        (fun M1 M2 z => Matrix.add_mulVec M1 M2 z)
        (fun c A z => by ext i; simp [Matrix.mulVec, dotProduct, Finset.mul_sum, mul_assoc])
        (fun A z1 z2 => Matrix.mulVec_add A z1 z2)
        (fun c A z => by
          ext i
          simp [Matrix.mulVec, dotProduct, Finset.mul_sum]
          exact Finset.sum_congr rfl (fun x _ => by ring))
    have hb : ∀ A z, ‖B0 A z‖ ≤ 3 * ‖A‖ * ‖z‖ := by
      intro A z
      refine (pi_norm_le_iff_of_nonneg (by positivity)).2 (fun i => ?_)
      show ‖∑ j, A i j * z j‖ ≤ _
      calc ‖∑ j, A i j * z j‖ ≤ ∑ j, ‖A i j * z j‖ := norm_sum_le _ _
        _ ≤ ∑ j : Fin 3, ‖A‖ * ‖z‖ := Finset.sum_le_sum (fun j _ => by
            rw [norm_mul]
            exact mul_le_mul ((norm_le_pi_norm (A i) j).trans (norm_le_pi_norm A i))
              (norm_le_pi_norm z j) (norm_nonneg _) (norm_nonneg _))
        _ = 3 * ‖A‖ * ‖z‖ := by simp; ring
    exact ⟨B0.mkContinuous₂ 3 hb, LinearMap.mkContinuous₂_norm_le _ (by norm_num) hb, fun A z => rfl⟩

  refine ⟨fun v => (iteratedFDeriv ℝ k (fun s => Matrix.mulVec (M (s, v)) (T (s, v))) s0)
      (fun i => Λ (m i)) - Matrix.mulVec (M (s0, v))
        ((iteratedFDeriv ℝ k (fun s => T (s, v)) s0) (fun i => Λ (m i))), fun v hv => ?_⟩

  have hW : IsOpen (U ×ˢ (Set.univ : Set ℝ)) := hU.prod isOpen_univ
  have hTv : ContDiffAt ℝ ∞ (fun s => T (s, v)) s0 :=
    (hT.contDiffAt (hW.mem_nhds ⟨hs0, Set.mem_univ v⟩)).comp s0
      ((contDiff_id.prodMk contDiff_const).contDiffAt)
  have hMv : ContDiffAt ℝ ∞ (fun s => M (s, v)) s0 :=
    (hM.contDiffAt (hW.mem_nhds ⟨hs0, Set.mem_univ v⟩)).comp s0
      ((contDiff_id.prodMk contDiff_const).contDiffAt)
  constructor
  ·
    have h1 := vcomm U T s0 k v hU hs0 hT
    have hev : (fun s => deriv (fun v'' => T (s, v'')) v) =ᶠ[nhds s0]
        (fun s => Matrix.mulVec (M (s, v)) (T (s, v))) :=
      Filter.eventuallyEq_of_mem (hU.mem_nhds hs0) (fun s hs => (hode s hs v hv).deriv)
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds] at h1
    have h2 := (ContinuousMultilinearMap.apply ℝ (fun _ : Fin k => ℝ × ℝ × ℝ) (Fin 3 → ℝ)
      (fun i => Λ (m i))).hasFDerivAt.comp_hasDerivAt v h1
    have h3 : HasDerivAt (fun w => (iteratedFDeriv ℝ k (fun s => T (s, w)) s0) (fun i => Λ (m i)))
        ((iteratedFDeriv ℝ k (fun s => Matrix.mulVec (M (s, v)) (T (s, v))) s0) (fun i => Λ (m i))) v :=
      h2
    refine h3.congr_deriv ?_
    exact (add_sub_cancel _ _).symm
  ·
    have hφ : ContDiffAt ℝ ∞ (fun s => M (s, v) - M (s0, v)) s0 := hMv.sub contDiffAt_const
    have hg : ContDiffAt ℝ ∞ (fun s => Bil (M (s, v) - M (s0, v)) (T (s, v))) s0 :=
      (show ContDiffAt ℝ ∞ (fun s => Bil (M (s, v) - M (s0, v))) s0 from
        Bil.contDiff.contDiffAt.comp s0 hφ).clm_apply hTv
    have hT2 : ContDiffAt ℝ ∞ (fun s => Bil (M (s0, v)) (T (s, v))) s0 :=
      (Bil (M (s0, v))).contDiff.contDiffAt.comp s0 hTv
    have hfun : (fun s => Matrix.mulVec (M (s, v)) (T (s, v))) =
        (fun s => Bil (M (s, v) - M (s0, v)) (T (s, v))) + (fun s => Bil (M (s0, v)) (T (s, v))) := by
      funext s
      rw [Pi.add_apply, ← ContinuousLinearMap.add_apply, ← map_add, sub_add_cancel, hBap]
    have hD : iteratedFDeriv ℝ k (fun s => Matrix.mulVec (M (s, v)) (T (s, v))) s0 (fun i => Λ (m i)) -
        Matrix.mulVec (M (s0, v)) (iteratedFDeriv ℝ k (fun s => T (s, v)) s0 (fun i => Λ (m i))) =
        iteratedFDeriv ℝ k (fun s => Bil (M (s, v) - M (s0, v)) (T (s, v))) s0 (fun i => Λ (m i)) := by
      rw [hfun, iteratedFDeriv_add_apply (hg.of_le (by exact_mod_cast le_top))
        (hT2.of_le (by exact_mod_cast le_top))]
      have e := (Bil (M (s0, v))).iteratedFDeriv_comp_left hTv (i := k) (by exact_mod_cast le_top)
      have e' : iteratedFDeriv ℝ k (fun s => Bil (M (s0, v)) (T (s, v))) s0 =
          (Bil (M (s0, v))).compContinuousMultilinearMap (iteratedFDeriv ℝ k (fun s => T (s, v)) s0) := e
      rw [e', ContinuousMultilinearMap.add_apply,
        ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply, hBap,
        add_sub_cancel_right]
    have hle : ‖iteratedFDeriv ℝ k (fun s => Bil (M (s, v) - M (s0, v)) (T (s, v))) s0
        (fun i => Λ (m i))‖ ≤
        sJet5 (fun s => Bil (M (s, v) - M (s0, v)) (T (s, v))) s0 Λ k * ∏ i, ‖m i‖ := by
      have h := ((iteratedFDeriv ℝ k (fun s => Bil (M (s, v) - M (s0, v)) (T (s, v))) s0).compContinuousLinearMap
        (fun _ => Λ)).le_opNorm m
      simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply] at h
      exact h
    have h0 : sJet5 (fun s => M (s, v) - M (s0, v)) s0 Λ 0 = 0 := by
      unfold sJet5
      apply le_antisymm _ (norm_nonneg _)
      refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
      rw [norm_iteratedFDeriv_zero, sub_self, norm_zero, zero_mul]
    have hφi : ∀ i : ℕ, i ≠ 0 →
        sJet5 (fun s => M (s, v) - M (s0, v)) s0 Λ i = sJet5 (fun s => M (s, v)) s0 Λ i := by
      intro i hi
      have e := iteratedFDeriv_sub_apply (hMv.of_le (by exact_mod_cast le_top))
        (contDiffAt_const : ContDiffAt ℝ i (fun _ => M (s0, v)) s0)
      rw [iteratedFDeriv_const_of_ne hi, Pi.zero_apply, sub_zero] at e
      have e' : iteratedFDeriv ℝ i (fun s => M (s, v) - M (s0, v)) s0 =
          iteratedFDeriv ℝ i (fun s => M (s, v)) s0 := e
      unfold sJet5
      rw [e']
    have hS0 : 0 ≤ ∑ i ∈ Finset.range k, (k.choose (i + 1) : ℝ) * sJet5 (fun s => M (s, v)) s0 Λ (i + 1) *
        sJet5 (fun s => T (s, v)) s0 Λ (k - (i + 1)) :=
      Finset.sum_nonneg (fun i _ => mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (norm_nonneg _))
        (norm_nonneg _))
    have hsum : ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) *
        sJet5 (fun s => M (s, v) - M (s0, v)) s0 Λ i * sJet5 (fun s => T (s, v)) s0 Λ (k - i) =
        ∑ i ∈ Finset.range k, (k.choose (i + 1) : ℝ) * sJet5 (fun s => M (s, v)) s0 Λ (i + 1) *
          sJet5 (fun s => T (s, v)) s0 Λ (k - (i + 1)) := by
      rw [Finset.sum_range_succ', h0, mul_zero, zero_mul, add_zero]
      exact Finset.sum_congr rfl (fun i _ => by rw [hφi (i + 1) (Nat.succ_ne_zero i)])

    have lb : ∀ (f : (ℝ × ℝ × ℝ) → (Fin 3 → Fin 3 → ℝ)) (g : (ℝ × ℝ × ℝ) → (Fin 3 → ℝ)),
        ContDiffAt ℝ ∞ f s0 → ContDiffAt ℝ ∞ g s0 →
        ‖(iteratedFDeriv ℝ k (fun x => Bil (f x) (g x)) s0).compContinuousLinearMap (fun _ => Λ)‖ ≤
          ‖Bil‖ * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) *
            ‖(iteratedFDeriv ℝ i f s0).compContinuousLinearMap (fun _ => Λ)‖ *
            ‖(iteratedFDeriv ℝ (k - i) g s0).compContinuousLinearMap (fun _ => Λ)‖ := by
      intro f g hf hg
      have hf' : ContDiffAt ℝ k f s0 := hf.of_le (by exact_mod_cast le_top)
      have hg' : ContDiffAt ℝ k g s0 := hg.of_le (by exact_mod_cast le_top)
      obtain ⟨uf, huf, hfu⟩ := hf'.contDiffOn le_rfl (by simp)
      obtain ⟨ug, hug, hgu⟩ := hg'.contDiffOn le_rfl (by simp)
      obtain ⟨O, hOsub, hOopen, hxO⟩ := mem_nhds_iff.mp (Filter.inter_mem huf hug)
      have hfO : ContDiffOn ℝ k f O := hfu.mono (fun x hx => (hOsub hx).1)
      have hgO : ContDiffOn ℝ k g O := hgu.mono (fun x hx => (hOsub hx).2)
      have hBO : ContDiffOn ℝ k (fun x => Bil (f x) (g x)) O :=
        (Bil.contDiff.comp_contDiffOn hfO).clm_apply hgO
      obtain ⟨s, hs_def⟩ : ∃ s : Set (ℝ × ℝ × ℝ), s = (fun z : (ℝ × ℝ × ℝ) => s0 + z) ⁻¹' O :=
        ⟨_, rfl⟩
      have hs : IsOpen s := by
        rw [hs_def]; exact hOopen.preimage (continuous_const.add continuous_id)
      have hO : IsOpen (⇑Λ ⁻¹' s) := hs.preimage Λ.continuous
      have h0s : (0 : ℝ × ℝ × ℝ) ∈ s := by
        rw [hs_def]; show s0 + 0 ∈ O; rw [add_zero]; exact hxO
      have hL0s : Λ 0 ∈ s := by rw [map_zero]; exact h0s
      have h0O : (0 : ℝ × ℝ × ℝ) ∈ ⇑Λ ⁻¹' s := hL0s
      have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : (ℝ × ℝ × ℝ) → W),
          ContDiffOn ℝ k F O → ContDiffOn ℝ k (fun z => F (s0 + z)) s := by
        intro W _ _ F hF
        exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
          (fun z hz => by rw [hs_def] at hz; exact hz)
      have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : (ℝ × ℝ × ℝ) → W),
          ContDiffOn ℝ k F O → ContDiffOn ℝ k (fun z => F (s0 + Λ z)) (⇑Λ ⁻¹' s) := by
        intro W _ _ F hF
        exact (hsm F hF).comp Λ.contDiff.contDiffOn (fun z hz => hz)
      have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : (ℝ × ℝ × ℝ) → W),
          ContDiffOn ℝ k F O → ∀ i : ℕ, i ≤ k →
          iteratedFDeriv ℝ i (fun z => F (s0 + Λ z)) 0 =
            (iteratedFDeriv ℝ i F s0).compContinuousLinearMap (fun _ => Λ) := by
        intro W _ _ F hF i hi
        have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (s0 + Λ z)) i hO h0O
        have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right Λ (hsm F hF) hs.uniqueDiffOn
          hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
        have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (s0 + z)) i hs h0s
        have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i s0 0
        calc iteratedFDeriv ℝ i (fun z => F (s0 + Λ z)) 0
            = iteratedFDerivWithin ℝ i ((fun z => F (s0 + z)) ∘ ⇑Λ) (⇑Λ ⁻¹' s) 0 := e1.symm
          _ = (iteratedFDerivWithin ℝ i (fun z => F (s0 + z)) s (Λ 0)).compContinuousLinearMap
                (fun _ => Λ) := e2
          _ = (iteratedFDerivWithin ℝ i (fun z => F (s0 + z)) s 0).compContinuousLinearMap
                (fun _ => Λ) := by rw [map_zero]
          _ = (iteratedFDeriv ℝ i (fun z => F (s0 + z)) 0).compContinuousLinearMap
                (fun _ => Λ) := by rw [e3]
          _ = (iteratedFDeriv ℝ i F s0).compContinuousLinearMap (fun _ => Λ) := by rw [e4, add_zero]
      have hl := ContinuousLinearMap.norm_iteratedFDerivWithin_le_of_bilinear Bil (hsmO f hfO)
        (hsmO g hgO) hO.uniqueDiffOn h0O (n := k) le_rfl
      rw [iteratedFDerivWithin_of_isOpen (f := fun y => Bil (f (s0 + Λ y)) (g (s0 + Λ y))) k hO h0O]
        at hl
      rw [← key _ hBO k le_rfl]
      calc ‖iteratedFDeriv ℝ k (fun z => (fun x => Bil (f x) (g x)) (s0 + Λ z)) 0‖
          = ‖iteratedFDeriv ℝ k (fun y => Bil (f (s0 + Λ y)) (g (s0 + Λ y))) 0‖ := rfl
        _ ≤ _ := hl
        _ = _ := by
          congr 1
          apply Finset.sum_congr rfl
          intro i hi
          have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (s0 + Λ z)) i hO h0O,
            iteratedFDerivWithin_of_isOpen (f := fun z => g (s0 + Λ z)) (k - i) hO h0O,
            key f hfO i hik, key g hgO (k - i) (Nat.sub_le k i)]
    have hN : sJet5 (fun s => Bil (M (s, v) - M (s0, v)) (T (s, v))) s0 Λ k ≤
        ‖Bil‖ * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) *
          sJet5 (fun s => M (s, v) - M (s0, v)) s0 Λ i * sJet5 (fun s => T (s, v)) s0 Λ (k - i) :=
      lb (fun s => M (s, v) - M (s0, v)) (fun s => T (s, v)) hφ hTv
    rw [hsum] at hN
    have hμ : 0 ≤ ∏ i, ‖m i‖ := Finset.prod_nonneg (fun i _ => norm_nonneg _)
    show ‖iteratedFDeriv ℝ k (fun s => Matrix.mulVec (M (s, v)) (T (s, v))) s0 (fun i => Λ (m i)) -
        Matrix.mulVec (M (s0, v)) (iteratedFDeriv ℝ k (fun s => T (s, v)) s0 (fun i => Λ (m i)))‖ ≤ _
    rw [hD]
    refine hle.trans (mul_le_mul_of_nonneg_right ?_ hμ)
    exact hN.trans (mul_le_mul_of_nonneg_right hBn hS0)

theorem tH_sjet_bound : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → PulsePropBound5 B G →
    THJetBound5 B G :=
by
  intro B G hB hG hPP
  have hG' := hG
  obtain ⟨hGP1, -, -, -, -, hGP5b, hGP5c⟩ := hG
  have hr0 : 0 < G.r0 := hGP1.1
  have hr1 : G.r0 ≤ 1/100 := hGP1.2.1
  have hsm := geom_slow_base_smooth_v5 B hB
  have hshY := (etaL_class_v5 B hB).2.2.1
  have hSC1 : ∀ ξ : Cyl, 1 ≤ SC B.h ξ := fun ξ => by
    show 1 ≤ (1 + |Real.log (qC B.h ξ)|) ^ 2
    exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h ξ))])
  have hPpos : ∀ (γ : Lab) (v : ℝ), 0 < Penv5 B G γ v := fun γ v => by
    unfold Penv5; exact Real.exp_pos _
  have hmono : ∀ (ξ : Cyl) (x C C' b b' : ℝ), x ≤ C * SC B.h ξ ^ b → C ≤ C' → b ≤ b' → 0 ≤ C' →
      x ≤ C' * SC B.h ξ ^ b' := by
    intro ξ x C C' b b' hx hC hb hC'
    have h1 := Real.rpow_le_rpow_of_exponent_le (hSC1 ξ) hb
    have h0 : 0 ≤ SC B.h ξ ^ b := Real.rpow_nonneg (by linarith [hSC1 ξ]) _
    calc x ≤ C * SC B.h ξ ^ b := hx
      _ ≤ C' * SC B.h ξ ^ b := mul_le_mul_of_nonneg_right hC h0
      _ ≤ C' * SC B.h ξ ^ b' := mul_le_mul_of_nonneg_left h1 hC'
  have hcol : ∀ (N : Matrix (Fin 3) (Fin 3) ℝ) (i j : Fin 3), (Matrix.mulVec N (Pi.single j 1)) i = N i j :=
    fun N i j => by rw [Matrix.mulVec_single_one]; rfl
  have hcolEq : ∀ (N A : Matrix (Fin 3) (Fin 3) ℝ) (d : ℝ), (∀ z : Fin 3 → ℝ, Matrix.mulVec N z = A.mulVec z - d • z) →
      (fun a b : Fin 3 => N a b) = fun a b : Fin 3 => (A - d • (1 : Matrix (Fin 3) (Fin 3) ℝ)) a b := by
    intro N A d h
    funext a b
    rw [← hcol N a b, h, ← hcol (A - d • (1 : Matrix (Fin 3) (Fin 3) ℝ)) a b, Matrix.sub_mulVec,
      Matrix.smul_mulVec, Matrix.one_mulVec]
  have hcomb : ∀ (P : ℕ → ℝ → ℝ → Prop), (∀ j C C' b b', C ≤ C' → b ≤ b' → 0 ≤ C' → P j C b → P j C' b') →
      (∀ j, ∃ C b, P j C b) → ∀ n, ∃ C b, 0 ≤ C ∧ 0 ≤ b ∧ ∀ j ≤ n, P j C b := by
    intro P hP hex n
    induction n with
    | zero =>
      obtain ⟨C, b, h⟩ := hex 0
      refine ⟨max C 0, max b 0, le_max_right _ _, le_max_right _ _, fun j hj => ?_⟩
      have : j = 0 := by omega
      subst this
      exact hP 0 C _ b _ (le_max_left _ _) (le_max_left _ _) (le_max_right _ _) h
    | succ n ih =>
      obtain ⟨C, b, hC, hb, h⟩ := ih
      obtain ⟨C', b', h'⟩ := hex (n+1)
      refine ⟨max C C', max b b', le_trans hC (le_max_left _ _), le_trans hb (le_max_left _ _), fun j hj => ?_⟩
      rcases Nat.lt_or_ge j (n+1) with hlt | hge
      · exact hP j C _ b _ (le_max_left _ _) (le_max_left _ _) (le_trans hC (le_max_left _ _)) (h j (by omega))
      · have : j = n + 1 := by omega
        subst this
        exact hP _ C' _ b' _ (le_max_right _ _) (le_max_right _ _) (le_trans hC (le_max_left _ _)) h'
  have hcoefC := hcomb (fun (j : ℕ) (C b : ℝ) => ∀ (γ : Lab) (ξ : Cyl), ActiveL4 B G γ → ξ ∈ DomC B.h B.qB →
      etaL B.h γ ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      (∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), sJet5 (fun s : ℝ × ℝ × ℝ => fun i j : Fin 3 =>
        (APhi5 B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) -
          dDamp5 B G γ (s.1, s.2.1, s.2.2, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) •
            (1 : Matrix (Fin 3) (Fin 3) ℝ)) i j) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) j ≤ C * SC B.h ξ ^ b) ∧
      sJet5 (fun s : ℝ × ℝ × ℝ => Bcol5 B G γ (s.1, s.2.1, s.2.2,
        Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + ((0:ℝ) * cib B.h γ.1 - G.r0) • vtv)) 1)
        (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) j ≤ C * SC B.h ξ ^ b)
    (fun j C C' b b' hC hb hC' h γ ξ h1 h2 h3 h4 h5 =>
      ⟨fun v hv => hmono ξ _ C C' b b' ((h γ ξ h1 h2 h3 h4 h5).1 v hv) hC hb hC',
        hmono ξ _ C C' b b' (h γ ξ h1 h2 h3 h4 h5).2 hC hb hC'⟩)
    (pulse5_coeff_sjet B G hB hG')
  obtain ⟨Cp, bp, hbp, hPPB⟩ := hPP
  have step : ∀ (n : ℕ) (CI bI : ℝ), 0 ≤ CI → 0 ≤ bI →
      (∀ j < n, ∀ (γ : Lab) (ξ : Cyl), ActiveL4 B G γ → ξ ∈ DomC B.h B.qB → etaL B.h γ ξ ≠ 0 →
        B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
