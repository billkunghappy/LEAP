    rw [e2, e3] at hsub
    have e4 : W ^ ((9:ℝ)/8) = W ^ ((5:ℝ)/8) * W ^ ((1:ℝ)/2) := by
      rw [← Real.rpow_add' hW (by norm_num)]; norm_num
    have hW98 : W ^ ((9:ℝ)/8) ≤ C₀ ^ ((9:ℝ)/8) := Real.rpow_le_rpow hW hWC (by norm_num)
    have hW12 : W ^ ((1:ℝ)/2) ≤ C₀ ^ ((1:ℝ)/2) := Real.rpow_le_rpow hW hWC (by norm_num)
