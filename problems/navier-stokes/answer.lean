  have hs0 : 0 ≤ Real.log (1 + η ^ 2) := Real.log_nonneg (by nlinarith [sq_nonneg η])
  refine ⟨?_, ?_, ?_⟩
  · rw [hVpt η]
    apply intervalIntegral.integral_nonneg hab
    intro y _
