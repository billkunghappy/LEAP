theorem ax_rec_induct : ∀ (r M Λ G G' : ℝ) (χ z : ℂ → ℂ) (P V : ℕ → ℂ → ℂ), 0 < r → r ≤ 1 / 100 → 0 ≤ M → 1 ≤ 40 * M / r → 0 < Λ → 0 ≤ G → 0 ≤ G' → 2 * (10 * M / r) * G * Real.exp (40 * M / r) ≤ Λ → 40 * M * G' / r ≤ Λ → (∀ w ∈ axRect r, ‖χ w‖ ≤ M ∧ ‖z w‖ ≤ M) → (∀ w, P 0 w = 1) → (∀ w, V 0 w = 0) → (∀ w, V 1 w = -z w / 2) → (∀ n : ℕ, (∀ m ≤ n, ∀ s w, 0 ≤ s → s < r → w ∈ axRect s → ‖P m w‖ ≤ (2 * Real.exp (10 * M / r) + 1) * (r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ m ∧ ‖V m w‖ ≤ (40 * M / r) * (r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ m) → ∀ s w, 0 ≤ s → s < r → w ∈ axRect s → ‖2 * ((n : ℂ) + 1) * ((n : ℂ) + 2) * P (n + 1) w + χ w * P n w‖ ≤ M * G / Λ * (r / 20) ^ n / ((n : ℝ) + 1) * ((r - s)⁻¹) ^ (n + 1)) → (∀ n : ℕ, 1 ≤ n → (∀ m ≤ n, ∀ s w, 0 ≤ s → s < r → w ∈ axRect s → ‖P m w‖ ≤ (2 * Real.exp (10 * M / r) + 1) * (r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ m ∧ ‖V m w‖ ≤ (40 * M / r) * (r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ m) → ∀ s w, 0 ≤ s → s < r → w ∈ axRect s → ‖2 * ((n : ℂ) + 1) ^ 2 * V (n + 1) w‖ ≤ M * G' / Λ * (r / 20) ^ n / ((n : ℝ) + 1) * ((r - s)⁻¹) ^ (n + 1)) → ∀ n : ℕ, ∀ s w, 0 ≤ s → s < r → w ∈ axRect s → ‖P n w‖ ≤ (2 * Real.exp (10 * M / r) + 1) * (r / 20) ^ n / ((n : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ n ∧ ‖V n w‖ ≤ (40 * M / r) * (r / 20) ^ n / ((n : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ n ∧ ‖P n w - (-χ w / 2) ^ n / ((n.factorial : ℂ) * ((n + 1).factorial : ℂ))‖ ≤ 2 * (10 * M / r) * G * Real.exp (40 * M / r) / Λ * (r / 20) ^ n / ((n : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ n ∧ (2 ≤ n → ‖V n w‖ ≤ 40 * M * G' / r / Λ * (r / 20) ^ n / ((n : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ n) :=
by
  intro r M Λ G G' χ z P V hr0 hr1 hM hE' hΛ hG hG' ha hb hbd hP0 hV0 hV1 hX hY
  have hrne : r ≠ 0 := hr0.ne'
  have hx0 : 0 ≤ 10 * M / r := by positivity
  have hκ0 : 0 < r / 20 := by positivity
  have hK0 : 0 ≤ 2 * (10 * M / r) * G / Λ := by positivity
