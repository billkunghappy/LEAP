      (Real.sqrt 2 * cinf * x ^ (-h) * deriv (heatProfile h) (2 * (1 - η ^ 2) / x) * (-(4 * η) / x))) *
        (tailFac ρ Xb x - 1) =
      (1 - h) * (∫ x in X..Xb, tailHt h cinf x η * (tailFac ρ Xb x - 1)) -
        (1 / 2 - h) * η * (∫ x in X..Xb, Real.sqrt 2 * cinf * x ^ (-h) *
          deriv (heatProfile h) (2 * (1 - η ^ 2) / x) * (-(4 * η) / x) * (tailFac ρ Xb x - 1)) := by
    rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_const_mul,
      ← intervalIntegral.integral_sub (hJci.const_mul (1 - h)) (hJdi.const_mul ((1 / 2 - h) * η))]
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    ring

  have halg := alg cinf (X ^ (-h)) (heatProfile h (2 * (1 - η ^ 2) / X))
    (deriv (heatProfile h) (2 * (1 - η ^ 2) / X)) (tailFac ρ Xb X) (deriv (tailFac ρ Xb) X)
    (∫ x in X..Xb, tailHt h cinf x η * (tailFac ρ Xb x - 1))
    (∫ x in X..Xb, Real.sqrt 2 * cinf * x ^ (-h) * deriv (heatProfile h) (2 * (1 - η ^ 2) / x) *
      (-(4 * η) / x) * (tailFac ρ Xb x - 1))
    (F X η) (deriv (fun Y => F Y η) X) (profRadInt (fun x e => 2 * x * F x e) X η)
