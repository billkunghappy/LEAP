  have hT1 : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ × ℝ) × ℝ =>
      ts w.1 + s w.1 * Dn w.1 (θ w.1 w.2)) (U ×ˢ univ) := hts1.add (hs1.mul hDθ)
  have hnum : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ × ℝ) × ℝ =>
      w.1.1 * (1 + ts w.1 ^ 2 + s w.1 ^ 2)) (U ×ˢ univ) :=
    (by fun_prop : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ × ℝ) × ℝ => w.1.1) (U ×ˢ univ)).mul
      ((contDiffOn_const.add (hts1.pow 2)).add (hs1.pow 2))
  have hdenom : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ × ℝ) × ℝ =>
      1 + (ts w.1 + s w.1 * Dn w.1 (θ w.1 w.2)) ^ 2) (U ×ˢ univ) :=
    contDiffOn_const.add (hT1.pow 2)
  have hFa_s : ContDiffOn ℝ ∞ Fa (U ×ˢ univ) := by
