theorem slow_profile_dir_nb_v5 : ∀ B : BG, B.ok → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C : ℝ, ∀ (l l0 : ℕ), l1 ≤ l0 → l0 ≤ l → ∀ ξ ∈ DomC B.h (qsOf l0), 1/4 < qC B.h ξ / Qb l → qC B.h ξ / Qb l < 4 → B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → ∀ F : ℝ × ℝ × ℝ → ℝ, (F = pcFa5 B l ∨ F = pcB5 B l 2) → NB B.h (fun η : Cyl => Real.sqrt (Qb l) * fderiv ℝ F (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))) k ξ ≤ C ∧ NB B.h (fun η : Cyl => Real.sqrt (Qb l) * fderiv ℝ F (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))) k ξ ≤ C * qC B.h ξ ^ B.h :=
by
  intro B hB

  have nbdir : ∀ (h : ℝ) (U : Set Cyl) (ξ : Cyl) (F : Cyl → ℝ) (w : Cyl), IsOpen U → ξ ∈ U →
