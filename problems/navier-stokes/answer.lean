    intro x x' M C δ hx hx' hM hM' hd
    have e1 : x * x⁻¹ = 1 := mul_inv_cancel₀ hx.ne'
    have e2 : x' * x'⁻¹ = 1 := mul_inv_cancel₀ hx'.ne'
    have e : x⁻¹ - x'⁻¹ = x⁻¹ * x'⁻¹ * (x' - x) := by linear_combination x'⁻¹ * e1 - x⁻¹ * e2
    have hi : 0 < x⁻¹ := inv_pos.mpr hx
    have hi' : 0 < x'⁻¹ := inv_pos.mpr hx'
    rw [e, abs_mul, abs_mul, abs_of_pos hi, abs_of_pos hi', abs_sub_comm]
    have h1 : x⁻¹ * x'⁻¹ ≤ M * M := mul_le_mul hM hM' hi'.le (le_trans hi.le hM)
