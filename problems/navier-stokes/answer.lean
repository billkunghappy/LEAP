  have band_coarse_gap_v5 : ∀ h : ℝ, 0 < h → h < 1/100 → ∃ l1 : ℕ, ∀ (l l0 : ℕ) (q : ℝ), l1 ≤ l0 → 0 < q → q < qsOf l0 → 1/4 < q / Qb l → q / Qb l < 4 → coarseIdx h q ≤ bandIdx h l ∧ bandIdx h l ≤ coarseIdx h q + 3 := by
