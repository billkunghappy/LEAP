    rw [hBrη, e1, e2, e3, e4, hvco η hη, hK0]
    linear_combination (ubase B η 0 * (sgn γ.2.2 * Bs5 B G γ * G.ustar / 2)) * hdv +
      (va η * ubase B η 0 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))) * hss +
      (va η * ubase B η 2 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))) * hκ3
  have germ : ∀ (f g : Cyl → ℝ) (j : ℕ), (∀ η ∈ U, f η = g η) → NB B.h f j ξ = NB B.h g j ξ := by
    intro f g j hfg
    have hev : f =ᶠ[nhds ξ] g := Filter.eventuallyEq_of_mem hUn hfg
    unfold NB
    rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds]

  have hRc := hR γ hA (by omega)
  have hpa : |pang5 B G γ| ≤ |Cr| := hRc.2.2.1.trans (le_abs_self _)
  have hpz : |pzr5 B G γ| ≤ |Cr| := hRc.2.1.trans (le_abs_self _)
  have hbs : |Bs5 B G γ| ≤ |Cr| := hRc.2.2.2.trans (le_abs_self _)
  have hK0b : |K0| ≤ |Cr| * (G.ustar / 2) := by
    have hsg : |sgn γ.2.2| = 1 := by unfold sgn; split_ifs <;> simp
    rw [hK0, abs_div, abs_mul, abs_mul, hsg, abs_of_pos hus, abs_of_pos (by norm_num : (0:ℝ) < 2)]
    calc 1 * |Bs5 B G γ| * G.ustar / 2 = |Bs5 B G γ| * (G.ustar / 2) := by ring
      _ ≤ |Cr| * (G.ustar / 2) := mul_le_mul_of_nonneg_right hbs (by linarith)
  have hNB0 : ∀ (f : Cyl → ℝ) (j : ℕ), 0 ≤ NB B.h f j ξ := fun f j => norm_nonneg _
  have hvaB : ∀ j, NB B.h va j ξ ≤ 4 * |C5| * SC B.h ξ := by
    intro j
    rw [← germ (fun η => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) va j hvco]
    refine (hV γ G.r0 (G.ctr γ) l0 hr0.le hr01 (by omega) hlγ ξ hξ hq1 hq2 hxi het j).trans ?_
    have hl0 : (0:ℝ) ≤ (γ.1:ℝ) ^ 2 := by positivity
    calc C5 * (γ.1:ℝ) ^ 2 ≤ |C5| * (γ.1:ℝ) ^ 2 := mul_le_mul_of_nonneg_right (le_abs_self _) hl0
      _ ≤ |C5| * (4 * SC B.h ξ) := mul_le_mul_of_nonneg_left hl2 (abs_nonneg _)
      _ = 4 * |C5| * SC B.h ξ := by ring

  have hUt0b : ∀ j, j ≤ k → NB B.h Ut0 j ξ ≤ M := by
    intro j hj; rw [hUt0]
    exact (hC0 j γ.1 ξ hξB hq1 hX1 hX2).trans ((le_abs_self _).trans (hC0M j hj))
  have hUt2b : ∀ j, j ≤ k → NB B.h Ut2 j ξ ≤ M := by
    intro j hj; rw [hUt2]
    exact (hC3 j γ.1 l0 (by omega) hlγ ξ hξ hq1 hq2 hX1 hX2).2.trans ((le_abs_self _).trans (hC3M j hj))
  have hTFb : ∀ j, j ≤ k → NB B.h TF j ξ ≤ M := by
    intro j hj; rw [hTF]; exact (hTd j _ (Or.inl rfl)).trans (hC3sM j hj)
  have hTBb : ∀ j, j ≤ k → NB B.h TB j ξ ≤ M := by
    intro j hj; rw [hTB]; exact (hTd j _ (Or.inr rfl)).trans (hC3sM j hj)
  have hPF : ∀ j, j ≤ k → ∀ F : ℝ × ℝ × ℝ → ℝ, (F = pcFa5 B γ.1 ∨ F = pcB5 B γ.1 2) →
      NB B.h (fun η : Cyl => Real.sqrt (Qb γ.1) * fderiv ℝ F (η.1, η.2.1, η.2.2.1)
        ((1:ℝ), (0:ℝ), (0:ℝ))) j ξ ≤ M ∧
      NB B.h (fun η : Cyl => Real.sqrt (Qb γ.1) * fderiv ℝ F (η.1, η.2.1, η.2.2.1)
        ((0:ℝ), (1:ℝ), (0:ℝ))) j ξ ≤ M * qC B.h ξ ^ B.h := by
    intro j hj F hF
    obtain ⟨a1, a2⟩ := hC12 j γ.1 l0 (by omega) hlγ ξ hξ hq1 hq2 hX1 hX2 F hF
    refine ⟨a1.trans ((le_abs_self _).trans (hC12M j hj)), a2.trans ?_⟩
    exact mul_le_mul_of_nonneg_right ((le_abs_self _).trans (hC12M j hj)) hqh0
  have hRFb : ∀ j, j ≤ k → NB B.h RF j ξ ≤ M := by
    intro j hj; rw [hRF]; exact (hPF j hj _ (Or.inl rfl)).1
  have hRBb : ∀ j, j ≤ k → NB B.h RB j ξ ≤ M := by
    intro j hj; rw [hRB]; exact (hPF j hj _ (Or.inr rfl)).1
  have hZFb : ∀ j, j ≤ k → NB B.h ZF j ξ ≤ M * qC B.h ξ ^ B.h := by
    intro j hj; rw [hZF]; exact (hPF j hj _ (Or.inl rfl)).2
  have hZBb : ∀ j, j ≤ k → NB B.h ZB j ξ ≤ M * qC B.h ξ ^ B.h := by
    intro j hj; rw [hZB]; exact (hPF j hj _ (Or.inr rfl)).2
  have hΨb : ∀ (f g : Cyl → ℝ) (E : ℝ), ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ g U →
      (∀ j, j ≤ k → NB B.h f j ξ ≤ E) → (∀ j, j ≤ k → NB B.h g j ξ ≤ E) →
      ∀ j, j ≤ k → NB B.h (fun η => pang5 B G γ * f η + pzr5 B G γ * g η) j ξ ≤ 2 * |Cr| * E := by
    intro f g E hf hg hfb hgb j hj
    have hlin := (nb_real_algebra_v5 B.h U ξ hUo hξU f g hf hg j).2.1 (pang5 B G γ) (pzr5 B G γ)
    refine hlin.trans ?_
    have m1 : |pang5 B G γ| * NB B.h f j ξ ≤ |Cr| * E :=
      mul_le_mul hpa (hfb j hj) (hNB0 _ _) (abs_nonneg _)
    have m2 : |pzr5 B G γ| * NB B.h g j ξ ≤ |Cr| * E :=
      mul_le_mul hpz (hgb j hj) (hNB0 _ _) (abs_nonneg _)
    linarith
  have hTtb : ∀ j, j ≤ k → NB B.h Tt j ξ ≤ 2 * |Cr| * M := by
    intro j hj; rw [hTt]; exact hΨb TF TB M hTFs hTBs hTFb hTBb j hj
  have hRtb : ∀ j, j ≤ k → NB B.h Rt j ξ ≤ 2 * |Cr| * M := by
    intro j hj; rw [hRt]; exact hΨb RF RB M hRFs hRBs hRFb hRBb j hj
  have hZtb : ∀ j, j ≤ k → NB B.h Zt j ξ ≤ 2 * |Cr| * (M * qC B.h ξ ^ B.h) := by
    intro j hj; rw [hZt]; exact hΨb ZF ZB _ hZFs hZBs hZFb hZBb j hj
  have hmulk : ∀ (f g : Cyl → ℝ) (A E : ℝ), ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ g U →
      (∀ j, j ≤ k → NB B.h f j ξ ≤ A) → (∀ j, j ≤ k → NB B.h g j ξ ≤ E) →
      ∀ j, j ≤ k → NB B.h (fun η => f η * g η) j ξ ≤ 2 ^ k * A * E := by
    intro f g A E hf hg hfb hgb j hj
    have hA0 : 0 ≤ A := (hNB0 f 0).trans (hfb 0 (Nat.zero_le _))
    have hE0 : 0 ≤ E := (hNB0 g 0).trans (hgb 0 (Nat.zero_le _))
    have h1 := nb_real_mul_le_v5 B.h ξ f g j A E (hf.contDiffAt hUn) (hg.contDiffAt hUn)
      (fun i hi => hfb i (hi.trans hj)) (fun i hi => hgb i (hi.trans hj))
    have h2 : (2:ℝ) ^ j ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hj
    calc _ ≤ 2 ^ j * A * E := h1
      _ ≤ 2 ^ k * A * E := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right h2 hA0) hE0
  have hP1b : ∀ j, j ≤ k → NB B.h P1 j ξ ≤ K1 := by
    intro j hj
    rw [hP1, hK1]
    exact hmulk Ut0 Rt M (2 * |Cr| * M) hUt0s hRts hUt0b hRtb j hj
  have hP2b : ∀ j, j ≤ k → NB B.h P2 j ξ ≤ 2 ^ k * M * (2 * |Cr| * (M * qC B.h ξ ^ B.h)) := by
    intro j hj
    rw [hP2]
    exact hmulk Ut2 Zt M _ hUt2s hZts hUt2b hZtb j hj
  have hYb : ∀ j, j ≤ k → NB B.h Y j ξ ≤ 5 * K1 := by
    intro j hj
    have hlin := (nb_real_algebra_v5 B.h U ξ hUo hξU P1 P2 hP1s hP2s j).2.1 1 (Qb γ.1 ^ (-B.h))
    rw [hY]
    refine hlin.trans ?_
    rw [abs_one, one_mul, abs_of_pos hκpos]
    have e2 := hP2b j hj
    have h4 : Qb γ.1 ^ (-B.h) * NB B.h P2 j ξ ≤ 4 * K1 := by
      calc Qb γ.1 ^ (-B.h) * NB B.h P2 j ξ ≤
            Qb γ.1 ^ (-B.h) * (2 ^ k * M * (2 * |Cr| * (M * qC B.h ξ ^ B.h))) :=
            mul_le_mul_of_nonneg_left e2 hκpos.le
        _ = (Qb γ.1 ^ (-B.h) * qC B.h ξ ^ B.h) * K1 := by rw [hK1]; ring
        _ ≤ 4 * K1 := mul_le_mul_of_nonneg_right hκq hK10
    linarith [hP1b j hj]
  have hXb : ∀ j, j ≤ k → NB B.h X j ξ ≤ MX := by
    intro j hj
    have hlin := (nb_real_algebra_v5 B.h U ξ hUo hξU Tt Y hTts hYs j).2.1 1 1
    rw [hX]
    refine hlin.trans ?_
    rw [abs_one, one_mul, one_mul, hMX]
    linarith [hTtb j hj, hYb j hj]
  have hWb : NB B.h W k ξ ≤ 2 ^ k * (4 * |C5| * SC B.h ξ) * MX := by
    rw [hW]
    exact nb_real_mul_le_v5 B.h ξ va X k (4 * |C5| * SC B.h ξ) MX hvaS.contDiffAt
      (hXs.contDiffAt hUn) (fun j _ => hvaB j) hXb
  have hBrb : NB B.h Br k ξ ≤ C * SC B.h ξ := by
    have hlin := (nb_real_algebra_v5 B.h U ξ hUo hξU Ut0 W hUt0s hWs k).2.1 K0 (-1)
    rw [hBr]
    refine hlin.trans ?_
    rw [abs_neg, abs_one, one_mul]
    have hc0 : 0 ≤ |Cr| * (G.ustar / 2) := mul_nonneg (abs_nonneg _) (by linarith)
    have m1 : |K0| * NB B.h Ut0 k ξ ≤ |Cr| * (G.ustar / 2) * M :=
      mul_le_mul hK0b (hUt0b k le_rfl) (hNB0 _ _) hc0
    have hA1 : |Cr| * (G.ustar / 2) * M ≤ |Cr| * (G.ustar / 2) * M * SC B.h ξ :=
      le_mul_of_one_le_right (mul_nonneg hc0 hM0) hS1
    have hCS : C * SC B.h ξ = |Cr| * (G.ustar / 2) * M * SC B.h ξ +
        2 ^ k * (4 * |C5| * SC B.h ξ) * MX := by
      rw [hC]; ring
    linarith
  refine ⟨hBrs.congr hid, ?_⟩
  rw [germ _ Br k hid]
  exact hBrb

theorem phMult5_nb_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C b : ℝ, ∀ (l0 : ℕ) (γ : Lab) (ξ : Cyl), l1 ≤ l0 → ActiveL4 B G γ → l0 ≤ γ.1 → ξ ∈ DomC B.h (qsOf l0) → 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 → B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → ContDiffAt ℝ ∞ (phMult5 B G γ) ξ ∧ NB B.h (phMult5 B G γ) k ξ ≤ C * qC B.h ξ ^ (B.h * (1/2 - 3 * kapS)) * SC B.h ξ ^ b :=
by
  intro B G hok hG
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  have hS : SimScaleProps B.h := hok.1

  have hpk : ∀ (l : ℕ) (x : ℝ), 0 < x → x / Qb l < 4 →
      (kb B.h l : ℝ) / Qb l * x ^ (1 + B.h) ≤ 32 * x ^ (B.h / 2) := by
    intro l x hx hr2
    have hQ0 : 0 < Qb l := by unfold Qb; exact Real.rpow_pos_of_pos (by norm_num) _
    have hQ1 : Qb l ≤ 1 := by
      show (2:ℝ) ^ (-(l:ℝ)) ≤ 1
      exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
    have ht0 : 0 < Qb l ^ (B.h / 2) := Real.rpow_pos_of_pos hQ0 _
    have hs0 : 0 < x ^ (B.h / 2) := Real.rpow_pos_of_pos hx _
    have hxQ : x < 4 * Qb l := by
      have := (div_lt_iff₀ hQ0).mp hr2
      linarith
    have hst : x ^ (B.h / 2) ≤ 4 * Qb l ^ (B.h / 2) := by
      have h1 : x ^ (B.h / 2) ≤ (4 * Qb l) ^ (B.h / 2) :=
        Real.rpow_le_rpow hx.le hxQ.le (by linarith)
      rw [Real.mul_rpow (by norm_num) hQ0.le] at h1
      have h2 : (4:ℝ) ^ (B.h / 2) ≤ 4 := by
        calc (4:ℝ) ^ (B.h / 2) ≤ (4:ℝ) ^ (1:ℝ) :=
              Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
          _ = 4 := Real.rpow_one 4
      exact h1.trans (mul_le_mul_of_nonneg_right h2 ht0.le)
    have he : epsb B.h l ^ (-(1/2:ℝ)) = (Qb l ^ (B.h / 2))⁻¹ := by
      unfold epsb
      rw [← Real.rpow_mul hQ0.le, ← Real.rpow_neg hQ0.le]
      congr 1
      ring
    have ht1 : Qb l ^ (B.h / 2) ≤ 1 := Real.rpow_le_one hQ0.le hQ1 (by linarith)
    have he1 : 1 ≤ (Qb l ^ (B.h / 2))⁻¹ := (one_le_inv₀ ht0).mpr ht1
    have hkb : (kb B.h l : ℝ) ≤ 2 * (Qb l ^ (B.h / 2))⁻¹ := by
      have h0 : 0 ≤ epsb B.h l ^ (-(1/2:ℝ)) := by rw [he]; linarith
      have hc := Nat.ceil_lt_add_one h0
      unfold kb
      rw [he] at hc ⊢
      linarith
    have hx1 : x ^ (1 + B.h) = x * (x ^ (B.h / 2)) ^ 2 := by
      rw [Real.rpow_add hx, Real.rpow_one, ← Real.rpow_natCast (x ^ (B.h / 2)) 2,
        ← Real.rpow_mul hx.le, show B.h / 2 * ((2:ℕ):ℝ) = B.h by push_cast; ring]
    have hxQ' : x / Qb l ≤ 4 := hr2.le
    have hxQ0 : 0 ≤ x / Qb l := div_nonneg hx.le hQ0.le
    have hts : (Qb l ^ (B.h / 2))⁻¹ * x ^ (B.h / 2) ≤ 4 :=
      (inv_mul_le_iff₀ ht0).mpr (by linarith)
    have hinv0 : 0 ≤ 2 * (Qb l ^ (B.h / 2))⁻¹ := by
      have := inv_pos.mpr ht0
      linarith
    calc (kb B.h l : ℝ) / Qb l * x ^ (1 + B.h)
        = ((kb B.h l : ℝ) * (x / Qb l)) * (x ^ (B.h / 2)) ^ 2 := by rw [hx1]; ring
      _ ≤ (2 * (Qb l ^ (B.h / 2))⁻¹ * 4) * (x ^ (B.h / 2)) ^ 2 := by
          apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
          exact mul_le_mul hkb hxQ' hxQ0 hinv0
      _ = 8 * ((Qb l ^ (B.h / 2))⁻¹ * x ^ (B.h / 2)) * x ^ (B.h / 2) := by ring
      _ ≤ 8 * 4 * x ^ (B.h / 2) := by
          apply mul_le_mul_of_nonneg_right _ hs0.le
          linarith
      _ = 32 * x ^ (B.h / 2) := by ring

  have hNBc : ∀ (c : ℝ) (f : Cyl → ℝ) (i : ℕ) (x : Cyl), ContDiffAt ℝ i f x →
      NB B.h (fun η => c * f η) i x = |c| * NB B.h f i x := by
    intro c f i x hf
    unfold NB
    have e : (iteratedFDeriv ℝ i (fun η => c * f η) x).compContinuousLinearMap (fun _ => Lnorm B.h x) =
        c • ((iteratedFDeriv ℝ i f x).compContinuousLinearMap (fun _ => Lnorm B.h x)) := by
      rw [show (fun η => c * f η) = c • f from rfl, iteratedFDeriv_const_smul_apply hf]
      ext v
      simp
    rw [e, norm_smul, Real.norm_eq_abs]

  obtain ⟨lb, hb⟩ := phase_bracket_nb_v5 B G hok hG
  choose CB hCB using hb
  choose C0 hC0 using fun i : ℕ => tn_qpow_normalized_v5 B.h hh0 hh1 hS (1 + B.h) i
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨lb + n0, fun k => ?_⟩
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = ∑ j ∈ Finset.range (k + 1), 32 * |C0 j| := ⟨_, rfl⟩
  obtain ⟨E, hEdef⟩ : ∃ E : ℝ, E = ∑ j ∈ Finset.range (k + 1), |CB j| := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by rw [hAdef]; exact Finset.sum_nonneg (fun j _ => by positivity)
  have hE0 : 0 ≤ E := by rw [hEdef]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
  refine ⟨2 ^ k * A * E, 1, fun l0 γ ξ hl0 hAct hl hξ hr1 hr2 hX1 hX2 hxi het => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 < B.qB := by
    rw [hQb]
    exact lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0
  have hqs1 : qsOf l0 ≤ 1 := by rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  have hξB : ξ ∈ DomC B.h B.qB := ⟨hξ'.1, hξ'.2.1, hξ'.2.2.trans hqsB⟩
  obtain ⟨hDo, hqC, hqpos, -, -, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
  have hq1 : qC B.h ξ ≤ 1 := (hξ'.2.2.trans_le hqs1).le
  have hQ0 : 0 < Qb γ.1 := by unfold Qb; exact Real.rpow_pos_of_pos (by norm_num) _
  have hQne : Qb γ.1 ≠ 0 := hQ0.ne'

  obtain ⟨U, c0, hUo, hξU, -, hUeq⟩ := eikP5_local_form_v5 B G γ ξ hok hξB hxi het
  have hU'o : IsOpen (U ∩ DomC B.h (qsOf l0)) := hUo.inter hDo
  have hξU' : ξ ∈ U ∩ DomC B.h (qsOf l0) := ⟨hξU, hξ⟩
  have hU'n : U ∩ DomC B.h (qsOf l0) ∈ nhds ξ := hU'o.mem_nhds hξU'

  obtain ⟨Br, hBr⟩ : ∃ Br : Cyl → ℝ, Br = fun η : Cyl => Qb γ.1 * (ubase B η 0 * (sgn γ.2.2 * Bs5 B G γ * G.ustar / 2) / Real.sqrt (Qb γ.1) - vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * (fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (0:ℝ), (1:ℝ)) + ubase B η 0 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) + ubase B η 2 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)))) := ⟨_, rfl⟩
  obtain ⟨pre, hpre⟩ : ∃ pre : Cyl → ℝ, pre = fun η : Cyl => (kb B.h γ.1 : ℝ) * qC B.h η ^ (1 + B.h) / Qb γ.1 := ⟨_, rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : Cyl → ℝ, F = fun η : Cyl => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) * (kb B.h γ.1 : ℝ) * eikP5 B G γ η := ⟨_, rfl⟩

  have hBrS : ∀ i : ℕ, ContDiffOn ℝ ∞ Br (U ∩ DomC B.h (qsOf l0)) ∧ NB B.h Br i ξ ≤ CB i * SC B.h ξ := by
    intro i
    rw [hBr]
    exact hCB i l0 γ ξ (U ∩ DomC B.h (qsOf l0)) (Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1) c0 (by omega)
      hAct hl hξ hr1 hr2 hX1 hX2 hxi het hU'o hξU' inter_subset_right (fun η hη => (hUeq η hη.1).1)
  have hBrAt : ContDiffAt ℝ ∞ Br ξ := ((hBrS 0).1).contDiffAt hU'n

  have hqpowOn : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (1 + B.h)) (DomC B.h (qsOf l0)) :=
    hqC.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
  have hqpowAt : ContDiffAt ℝ ∞ (fun η => qC B.h η ^ (1 + B.h)) ξ := hqpowOn.contDiffAt (hDo.mem_nhds hξ)
  have hpre_eq : pre = fun η => ((kb B.h γ.1 : ℝ) / Qb γ.1) * qC B.h η ^ (1 + B.h) := by
    rw [hpre]; funext η; ring
  have hpreAt : ContDiffAt ℝ ∞ pre ξ := by
    rw [hpre_eq]; exact contDiffAt_const.mul hqpowAt
  have hc0 : 0 ≤ (kb B.h γ.1 : ℝ) / Qb γ.1 := div_nonneg (Nat.cast_nonneg _) hQ0.le
  have hpreB : ∀ i : ℕ, i ≤ k → NB B.h pre i ξ ≤ A * qC B.h ξ ^ (B.h / 2) := by
    intro i hi
    rw [hpre_eq, hNBc _ _ i ξ (hqpowAt.of_le (by exact_mod_cast le_top)), abs_of_nonneg hc0]
    have h1 := hC0 i ξ hξ'.2.1 hq1
    have h2 := hpk γ.1 (qC B.h ξ) hq0 hr2
    have h3 : 32 * |C0 i| ≤ A := by
      rw [hAdef]
      exact Finset.single_le_sum (f := fun j => 32 * |C0 j|) (fun j _ => by positivity)
        (Finset.mem_range.mpr (by omega))
    have hp0 : 0 ≤ qC B.h ξ ^ (1 + B.h) := Real.rpow_nonneg hq0.le _
    have hs0 : 0 ≤ qC B.h ξ ^ (B.h / 2) := Real.rpow_nonneg hq0.le _
    calc (kb B.h γ.1 : ℝ) / Qb γ.1 * NB B.h (fun η => qC B.h η ^ (1 + B.h)) i ξ
        ≤ (kb B.h γ.1 : ℝ) / Qb γ.1 * (|C0 i| * qC B.h ξ ^ (1 + B.h)) :=
          mul_le_mul_of_nonneg_left (h1.trans (mul_le_mul_of_nonneg_right (le_abs_self _) hp0)) hc0
      _ = |C0 i| * ((kb B.h γ.1 : ℝ) / Qb γ.1 * qC B.h ξ ^ (1 + B.h)) := by ring
      _ ≤ |C0 i| * (32 * qC B.h ξ ^ (B.h / 2)) := mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
      _ = (32 * |C0 i|) * qC B.h ξ ^ (B.h / 2) := by ring
      _ ≤ A * qC B.h ξ ^ (B.h / 2) := mul_le_mul_of_nonneg_right h3 hs0
  have hSC0 : 0 ≤ SC B.h ξ := by unfold SC; positivity
  have hBrB : ∀ i : ℕ, i ≤ k → NB B.h Br i ξ ≤ E * SC B.h ξ := by
    intro i hi
    have h3 : |CB i| ≤ E := by
      rw [hEdef]
      exact Finset.single_le_sum (f := fun j => |CB j|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.mpr (by omega))
    exact (hBrS i).2.trans (mul_le_mul_of_nonneg_right ((le_abs_self _).trans h3) hSC0)

  have key : ∀ (a b R Q : ℝ), Q ≠ 0 → a * b * R = b * a / Q * (Q * R) := by
    intro a b R Q hQ
    rw [div_mul_eq_mul_div, eq_div_iff hQ]
    ring
  have hid : ∀ η ∈ U ∩ DomC B.h (qsOf l0), F η = pre η * Br η := by
    intro η hη
    have hqη : 0 < qC B.h η := hqpos η hη.2
    simp only [hF, hpre, hBr]
    rw [(hUeq η hη.1).2, ← Real.rpow_add hqη,
      show 2 * Aex B.h + 1/2 + -Aex B.h = 1 + B.h by unfold Aex; ring]
    exact key _ _ _ _ hQne
  have hev : F =ᶠ[nhds ξ] fun η => pre η * Br η := Filter.eventuallyEq_of_mem hU'n hid
  have hFAt : ContDiffAt ℝ ∞ F ξ := (hpreAt.mul hBrAt).congr_of_eventuallyEq hev
  have hNBF : NB B.h F k ξ ≤ 2 ^ k * (A * qC B.h ξ ^ (B.h / 2)) * (E * SC B.h ξ) := by
    have e : NB B.h F k ξ = NB B.h (fun η => pre η * Br η) k ξ := by
      unfold NB
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    rw [e]
    exact nb_real_mul_le_v5 B.h ξ pre Br k _ _ hpreAt hBrAt hpreB hBrB

  obtain ⟨L, hL⟩ : ∃ L : ℝ →L[ℝ] ℂ, L = (ContinuousLinearMap.id ℝ ℝ).smulRight Complex.I := ⟨_, rfl⟩
  have hLx : ∀ x : ℝ, L x = (x : ℂ) * Complex.I := by
    intro x
    rw [hL, ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.id_apply, Complex.real_smul]
  have hL1 : ‖L‖ ≤ 1 := ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => by
    rw [hLx, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, one_mul])
  have hph : phMult5 B G γ = ⇑L ∘ F := by
    funext η
    rw [Function.comp_apply, hLx, hF]
    rfl
  have hNBL : NB B.h (⇑L ∘ F) k ξ ≤ NB B.h F k ξ := by
    have e1 : iteratedFDeriv ℝ k (⇑L ∘ F) ξ = L.compContinuousMultilinearMap (iteratedFDeriv ℝ k F ξ) :=
      ContinuousLinearMap.iteratedFDeriv_comp_left L hFAt (i := k) (by exact_mod_cast le_top)
    unfold NB
    rw [e1]
    have e2 : (L.compContinuousMultilinearMap (iteratedFDeriv ℝ k F ξ)).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) =
        L.compContinuousMultilinearMap
          ((iteratedFDeriv ℝ k F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext v
      rfl
    rw [e2]
    calc _ ≤ ‖L‖ * ‖(iteratedFDeriv ℝ k F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ _ := mul_le_of_le_one_left (norm_nonneg _) hL1

  have hkap : B.h * (1/2 - 3 * kapS) ≤ B.h / 2 := by
    have hk : kapS = 1 / 100000 := rfl
    rw [hk]
    linarith
  have hexp : qC B.h ξ ^ (B.h / 2) ≤ qC B.h ξ ^ (B.h * (1/2 - 3 * kapS)) :=
    Real.rpow_le_rpow_of_exponent_ge hq0 hq1 hkap
  have hCk : 0 ≤ 2 ^ k * A * E := by positivity
  refine ⟨by rw [hph]; exact L.contDiff.comp_contDiffAt ξ hFAt, ?_⟩
  rw [hph, Real.rpow_one]
  calc NB B.h (⇑L ∘ F) k ξ ≤ NB B.h F k ξ := hNBL
    _ ≤ 2 ^ k * (A * qC B.h ξ ^ (B.h / 2)) * (E * SC B.h ξ) := hNBF
    _ = 2 ^ k * A * E * qC B.h ξ ^ (B.h / 2) * SC B.h ξ := by ring
    _ ≤ 2 ^ k * A * E * qC B.h ξ ^ (B.h * (1/2 - 3 * kapS)) * SC B.h ξ :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hexp hCk) hSC0

theorem plin5_phase_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (β : ℝ) (w : WC), InWg5 B G (qsOf l0) β w → InWg5 B G (qsOf l0) (β + 1/2 - 3 * kapS) (remPhase5 B G (fun γ m η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • w γ m η)) :=
by
  intro B G hok hG
  obtain ⟨lp, hp⟩ := pulse_support_good_v5 B G hok hG
  obtain ⟨lg, hg⟩ := band_coarse_gap_v5 B.h hok.2.1.1 hok.2.1.2.1
  obtain ⟨lc, hc⟩ := phMult5_nb_v5 B G hok hG

  have hdeck : ∀ (γ : Lab) (n0 : ℤ) (c : ℝ × ℝ), n0 ≤ bandIdx B.h γ.1 →
      (∃ a b : ℤ, Jpow n0 c = ((a : ℝ), (b : ℝ))) → ∀ ξ : Cyl, eikP5 B G γ (shY ξ c) = eikP5 B G γ ξ := by
    intro γ n0 c hn0 hlat ξ
    have hs : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    have hs2 : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
    have hL : Lgc ≠ 0 := by unfold Lgc; intro h0; linarith
    have hT : Tgc ≠ 0 := by unfold Tgc; intro h0; linarith [Real.sqrt_nonneg 2]
    have hN : (1 + bgc ^ 2) ≠ 0 := by positivity
    have c1 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).1 = Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) +
        Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) * bgc := by
      intro n Y
      simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
      ring
    have c2 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).2 = -(Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) * bgc) +
        Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) := by
      intro n Y
      simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
      ring
    have hcomp : ∀ (m n : ℤ) (Y : ℝ × ℝ), Jpow m (Jpow n Y) = Jpow (m + n) Y := by
      intro m n Y
      refine Prod.ext ?_ ?_
      · rw [c1 m, c1 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
        field_simp
        ring
      · rw [c2 m, c2 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
        field_simp
        ring
    have hid0 : ∀ Y : ℝ × ℝ, Jpow 0 Y = Y := by
      intro Y
      refine Prod.ext ?_ ?_
      · rw [c1, zpow_zero, zpow_zero]
        field_simp
        ring
      · rw [c2, zpow_zero, zpow_zero]
        field_simp
        ring
    have hNinv : ∀ x : ℝ, x / (1 + bgc ^ 2) = x * (2 + Real.sqrt 2) / 4 := by
      intro x
      rw [div_eq_div_iff hN (by norm_num)]
      unfold bgc
      linear_combination (-x * Real.sqrt 2) * hs
    have hJ1 : ∀ Y : ℝ × ℝ, Jpow 1 Y = (3 * Y.1 + Y.2, Y.1 + 5 * Y.2) := by
      intro Y
      refine Prod.ext ?_ ?_
      · rw [c1, zpow_one, zpow_one, hNinv, hNinv]
        unfold Lgc Tgc bgc
        linear_combination ((Real.sqrt 2 ^ 2 + 4 * Real.sqrt 2 - 2) * Y.1 + 2 * (Real.sqrt 2 + 1) * Y.2) / 4 * hs
      · rw [c2, zpow_one, zpow_one, hNinv, hNinv]
        unfold Lgc Tgc bgc
        linear_combination (2 * (Real.sqrt 2 + 1) * Y.1 - (Real.sqrt 2 ^ 2 - 4 * Real.sqrt 2 - 2) * Y.2) / 4 * hs
    have hint : ∀ k : ℕ, ∀ i j : ℤ, ∃ i' j' : ℤ,
        Jpow (k : ℤ) ((i : ℝ), (j : ℝ)) = ((i' : ℝ), (j' : ℝ)) := by
      intro k
      induction k with
      | zero => intro i j; exact ⟨i, j, by rw [Nat.cast_zero, hid0]⟩
      | succ k ih =>
        intro i j
        obtain ⟨i', j', h'⟩ := ih i j
        refine ⟨3 * i' + j', i' + 5 * j', ?_⟩
        have e : ((k + 1 : ℕ) : ℤ) = 1 + (k : ℤ) := by push_cast; ring
        rw [e, ← hcomp 1 k, h', hJ1]
        push_cast
        rfl
    obtain ⟨a0, b0, hab⟩ := hlat
    obtain ⟨k, hk⟩ := Int.le.dest hn0
    have hJk : Jpow (bandIdx B.h γ.1) c = Jpow (k : ℤ) (Jpow n0 c) := by
      rw [hcomp, ← hk, add_comm]
    obtain ⟨a1, b1, hJk'⟩ := hint k a0 b0
    have hJc : Jpow (bandIdx B.h γ.1) c = ((a1 : ℝ), (b1 : ℝ)) := by
      rw [hJk, hab, hJk']
    have hadd : ∀ (n : ℤ) (Y W : ℝ × ℝ), Jpow n (Y + W) = Jpow n Y + Jpow n W := by
      intro n Y W
      refine Prod.ext ?_ ?_
      · rw [Prod.fst_add, c1 n (Y + W), c1 n Y, c1 n W, Prod.fst_add, Prod.snd_add]
        ring
      · rw [Prod.snd_add, c2 n (Y + W), c2 n Y, c2 n W, Prod.fst_add, Prod.snd_add]
        ring
    have hfr : ∀ (y : ℝ × ℝ) (a b : ℤ), frac0 (y + ((a : ℝ), (b : ℝ))) = frac0 y := by
      intro y a b
      have e1 : (y + ((a : ℝ), (b : ℝ))).1 = y.1 + (a : ℝ) := rfl
      have e2 : (y + ((a : ℝ), (b : ℝ))).2 = y.2 + (b : ℝ) := rfl
      unfold frac0
      rw [e1, e2, round_add_intCast, round_add_intCast]
      refine Prod.ext ?_ ?_
      · show y.1 + (a : ℝ) - (((round y.1 + a : ℤ)) : ℝ) = y.1 - ((round y.1 : ℤ) : ℝ)
        push_cast
        ring
      · show y.2 + (b : ℝ) - (((round y.2 + b : ℤ)) : ℝ) = y.2 - ((round y.2 : ℤ) : ℝ)
        push_cast
        ring
    have hrect : ∀ Y : ℝ × ℝ, rectW B.h γ (G.ctr γ) (Y + c) = rectW B.h γ (G.ctr γ) Y := by
      intro Y
      unfold rectW
      rw [hadd, hJc]
      have e : Jpow (bandIdx B.h γ.1) Y + ((a1 : ℝ), (b1 : ℝ)) - G.ctr γ =
          (Jpow (bandIdx B.h γ.1) Y - G.ctr γ) + ((a1 : ℝ), (b1 : ℝ)) := by abel
      rw [e, hfr]
    have hvco : ∀ Y : ℝ × ℝ, vco B.h G.r0 γ (G.ctr γ) (Y + c) = vco B.h G.r0 γ (G.ctr γ) Y := by
      intro Y
      unfold vco etG
      rw [hrect]
    have hphi : ∀ x : Cyl, phiL5 B G γ (shY x c) = phiL5 B G γ x := by
      intro x
      unfold phiL5
      have e : (shY x c).2.2.2 = x.2.2.2 + c := rfl
      rw [e, hvco]
      rfl
    obtain ⟨e, he⟩ : ∃ e : Cyl, e = ((0:ℝ), (0:ℝ), (0:ℝ), c) := ⟨_, rfl⟩
    have hsh : ∀ η : Cyl, shY η c = η + e := by
      intro η
      rw [he]
      simp only [shY]
      ext <;> simp
    have hF : (fun x => phiL5 B G γ (x + e)) = phiL5 B G γ := by
      funext x
      rw [← hsh x, hphi x]
    have hfd : fderiv ℝ (phiL5 B G γ) (shY ξ c) = fderiv ℝ (phiL5 B G γ) ξ := by
      rw [hsh ξ, ← fderiv_comp_add_right]
      exact congrArg (fun g => fderiv ℝ g ξ) hF
    unfold eikP5 dT dR dZ
    rw [hfd]
    rfl
  refine ⟨lp + lg + lc, fun l0 hl0 β w hw => ?_⟩
  have hDo : IsOpen (DomC B.h (qsOf l0)) := (domc_open_calculus B (qsOf l0) hok).1
  have hqpos : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ := (domc_open_calculus B (qsOf l0) hok).2.2.1

  have hmul : ∀ (α : ℝ) (b : WC), InWg5 B G (qsOf l0) α b →
      InWg5 B G (qsOf l0) α (fun γ m ξ => (m : ℂ) • b γ m ξ) := by
    intro α b hb
    obtain ⟨⟨H, hH0, hH⟩, hb2, hb3, hb4, hb5⟩ := hb
    refine ⟨⟨H, hH0, fun γ m hm => ?_⟩, fun γ m => ?_, fun γ m ξ hξ c hc => ?_,
      fun γ m ξ hξ hne => ?_, fun k => ?_⟩
    · funext ξ
      simp [hH γ m hm]
    · exact (hb2 γ m).const_smul (m : ℂ)
    · show (m : ℂ) • b γ m (shY ξ c) = (m : ℂ) • b γ m ξ
      rw [hb3 γ m ξ hξ c hc]
    · apply hb4 γ m ξ hξ
      intro h0
      apply hne
      show (m : ℂ) • b γ m ξ = 0
      rw [h0, smul_zero]
    · obtain ⟨C, b', d, hC⟩ := hb5 k
      obtain ⟨m0, hm0⟩ : ∃ m0 : ℤ, m0 ∉ H := ⟨∑ i ∈ H, |i| + 1, fun hmem => by
        have h1 := Finset.single_le_sum (f := fun i : ℤ => |i|) (fun i _ => abs_nonneg i) hmem
        have h2 : (0 : ℤ) ≤ ∑ i ∈ H, |i| := Finset.sum_nonneg (fun i _ => abs_nonneg i)
        have h3 : |∑ i ∈ H, |i| + 1| = ∑ i ∈ H, |i| + 1 := abs_of_nonneg (by omega)
        simp only at h1
        rw [h3] at h1
        omega⟩
      refine ⟨(1 + ∑ i ∈ H, |(i : ℝ)|) * C, b', d, fun γ m ξ hξ hX1 hX2 => ?_⟩
      have hNB0 : ∀ m', m' ∉ H → NB B.h (b γ m') k ξ = 0 := by
        intro m' hm'
        rw [hH γ m' hm']
        unfold NB
        have hz : iteratedFDeriv ℝ k (0 : Cyl → (Fin 3 → ℂ)) ξ = 0 := by
          have h := (iteratedFDeriv_fun_zero : iteratedFDeriv ℝ k (fun _ : Cyl => (0 : Fin 3 → ℂ)) = 0)
          exact congrFun h ξ
        rw [hz]
        have h0 : ((0 : ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) (Fin 3 → ℂ)).compContinuousLinearMap
            fun _ => Lnorm B.h ξ) = 0 := by
          ext v
          simp
        rw [h0, norm_zero]
      have hR0 := hC γ m0 ξ hξ hX1 hX2
      rw [hNB0 m0 hm0] at hR0
      have hcd : ContDiffAt ℝ k (b γ m) ξ :=
        ((hb2 γ m).contDiffAt (hDo.mem_nhds hξ)).of_le (by exact_mod_cast le_top)
      have hEq : NB B.h (fun η => (m : ℂ) • b γ m η) k ξ = |(m : ℝ)| * NB B.h (b γ m) k ξ := by
        unfold NB
        have e : (iteratedFDeriv ℝ k (fun η => (m : ℂ) • b γ m η) ξ).compContinuousLinearMap
            (fun _ => Lnorm B.h ξ) =
            (m : ℂ) • ((iteratedFDeriv ℝ k (b γ m) ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
          rw [show (fun η => (m : ℂ) • b γ m η) = (m : ℂ) • b γ m from rfl,
            iteratedFDeriv_const_smul_apply hcd]
          ext v
          simp
        rw [e, norm_smul, Complex.norm_intCast]
      have hM0 : (0 : ℝ) ≤ ∑ i ∈ H, |(i : ℝ)| := Finset.sum_nonneg (fun i _ => abs_nonneg _)
      have hfin : NB B.h (fun η => (m : ℂ) • b γ m η) k ξ ≤ (1 + ∑ i ∈ H, |(i : ℝ)|) *
          (C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b' *
            Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) *
            Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) := by
        rw [hEq]
        by_cases hm : m ∈ H
        · have hmle : |(m : ℝ)| ≤ 1 + ∑ i ∈ H, |(i : ℝ)| := by
            have := Finset.single_le_sum (f := fun i : ℤ => |(i : ℝ)|) (fun i _ => abs_nonneg _) hm
            linarith
          calc |(m : ℝ)| * NB B.h (b γ m) k ξ ≤ |(m : ℝ)| * (C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b' *
                Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) *
                Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) :=
                mul_le_mul_of_nonneg_left (hC γ m ξ hξ hX1 hX2) (abs_nonneg _)
            _ ≤ _ := mul_le_mul_of_nonneg_right hmle hR0
        · rw [hNB0 m hm, mul_zero]
          exact mul_nonneg (by linarith) hR0
      refine le_trans hfin (le_of_eq ?_)
      ring

  have hid : remPhase5 B G (fun γ m η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • w γ m η) =
      fun (γ : Lab) (m : ℤ) (ξ : Cyl) => (m : ℂ) • (phMult5 B G γ ξ • w γ m ξ) := by
    funext γ m ξ
    simp only [remPhase5, phMult5, smul_smul]
    congr 1
    push_cast
    ring
  rw [hid]
  have e : β + 1/2 - 3 * kapS = β + (1/2 - 3 * kapS) := by ring
  rw [e]
  refine hmul _ (fun γ m ξ => phMult5 B G γ ξ • w γ m ξ) ?_
  refine inWg5_smul_mult B G l0 hok β (1/2 - 3 * kapS) w (phMult5 B G) hw ?_ ?_ ?_
  · intro γ m ξ hξ hts
    obtain ⟨-, hA, hl, hr1, hr2, hX1, hX2, hxi, het⟩ := hp l0 (by omega) β w hw γ m ξ hξ hts
    obtain ⟨C, b, hcb⟩ := hc 0
    exact (hcb l0 γ ξ (by omega) hA hl hξ hr1 hr2 hX1 hX2 hxi het).1
  · intro γ m ξ hξ hne c hdc
    have hts : ξ ∈ tsupport (w γ m) := subset_tsupport _ hne
    obtain ⟨-, -, -, hr1, hr2, -, -, -, -⟩ := hp l0 (by omega) β w hw γ m ξ hξ hts
    have hq0 := hqpos ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    obtain ⟨hcb, -⟩ := hg γ.1 l0 (qC B.h ξ) (by omega) hq0 hξ'.2.2 hr1 hr2
    have he := hdeck γ (coarseIdx B.h (qC B.h ξ)) c hcb hdc ξ
    unfold phMult5
    rw [he]
    rfl
  · intro k
    obtain ⟨C, b, hcb⟩ := hc k
    refine ⟨C, b, fun γ m ξ hξ hts _ _ => ?_⟩
    obtain ⟨-, hA, hl, hr1, hr2, hX1, hX2, hxi, het⟩ := hp l0 (by omega) β w hw γ m ξ hξ hts
    exact (hcb l0 γ ξ (by omega) hA hl hξ hr1 hr2 hX1 hX2 hxi het).2

theorem inWg5_dR_class_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (β : ℝ) (a : WC), InWg5 B G (qsOf l0) β a → InWg5 B G (qsOf l0) (β - 1 / (2 * B.h) - kapS) (fun γ m ξ => dR B.h (a γ m) ξ) :=
by
  intro B G hok hG
  obtain ⟨ls, hS⟩ := slow_deriv_struct_v5 B G hok hG
  refine ⟨ls, fun l0 hl0 β a ha => ?_⟩
  have hSP : SimScaleProps B.h := hok.1
  have hh : 0 < B.h := hok.2.1.1
  have hh0 : B.h ≠ 0 := hh.ne'
  have hu : B.h * (1 / (2 * B.h)) = 1 / 2 := by field_simp
  have hexp : B.h * (-(1 / (2 * B.h)) - kapS) = -(1/2 + B.h * kapS) := by
    linear_combination (-1:ℝ) * hu
  have hq1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hq0 : 0 < qsOf l0 := by
    show (0:ℝ) < (2:ℝ) ^ (-(l0:ℝ))
    exact Real.rpow_pos_of_pos (by norm_num) _
  have hDo : IsOpen (DomC B.h (qsOf l0)) := by
    have h4c := hSP.2.2.2.1.continuousOn
    have hm : MapsTo (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1} (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have hξ' : ξ.2.2.1 < 1 := hξ
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hcont : ContinuousOn (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1} :=
      h4c.comp (f := fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) (Continuous.continuousOn (by fun_prop)) hm
    have e : DomC B.h (qsOf l0) = {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩
        (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) ⁻¹' Iio (qsOf l0)) := by
      ext ξ
      exact Iff.rfl
    rw [e]
    exact (isOpen_lt continuous_const continuous_fst).inter
      (hcont.isOpen_inter_preimage (isOpen_lt (by fun_prop) continuous_const) isOpen_Iio)

  have he1 : ContDiffOn ℝ ∞ (fun η : Cyl => ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv))
      {η : Cyl | 0 < η.1} := by
    have hfst : ContDiffOn ℝ ∞ (fun η : Cyl => η.1) {η : Cyl | 0 < η.1} := contDiffOn_fst
    have hpow : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ (drx B.h - 1)) {η : Cyl | 0 < η.1} :=
      hfst.rpow_const_of_ne (fun η hη => ne_of_gt hη)
    have hs : ContDiffOn ℝ ∞ (fun η : Cyl => (drx B.h * η.1 ^ (drx B.h - 1)) • vrv) {η : Cyl | 0 < η.1} :=
      (contDiffOn_const.mul hpow).smul contDiffOn_const
    exact contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk hs))
  obtain ⟨_S1, S2, S3, S4⟩ := hS l0 hl0 β a
    (fun η : Cyl => ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv)) ha he1 (fun ξ c => rfl)

  have BR : ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      dR B.h (a γ m) ξ = (fun i => dR B.h (fun η => a γ m η i) ξ) := by
    intro γ m ξ hξ
    have hd : DifferentiableAt ℝ (a γ m) ξ :=
      ((ha.2.1 γ m).contDiffAt (hDo.mem_nhds hξ)).differentiableAt (by simp)
    funext i
    have h1 := (hasFDerivAt_pi'.1 hd.hasFDerivAt) i
    show fderiv ℝ (a γ m) ξ _ i = fderiv ℝ (fun η => a γ m η i) ξ _
    rw [h1.fderiv]
    rfl
  have C1 : ∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → (fun γ m ξ => dR B.h (a γ m) ξ) γ m = 0 := by
    obtain ⟨H, hH0, hHa⟩ := ha.1
    refine ⟨H, hH0, fun γ m hm => ?_⟩
    funext ξ
    show dR B.h (a γ m) ξ = 0
    rw [hHa γ m hm]
    simp [dR]
  have C2 : ∀ γ m, ContDiffOn ℝ ∞ ((fun γ m ξ => dR B.h (a γ m) ξ) γ m) (DomC B.h (qsOf l0)) :=
    fun γ m => (S2 γ m).congr (fun ξ hξ => BR γ m ξ hξ)
  have C3 : ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ∀ c, IsDeck B.h (qC B.h ξ) c →
      (fun γ m ξ => dR B.h (a γ m) ξ) γ m (shY ξ c) = (fun γ m ξ => dR B.h (a γ m) ξ) γ m ξ := by
    intro γ m ξ hξ c hc
    have hsh : shY ξ c ∈ DomC B.h (qsOf l0) := hξ
    show dR B.h (a γ m) (shY ξ c) = dR B.h (a γ m) ξ
    rw [BR γ m _ hsh, BR γ m ξ hξ]
    exact S3 γ m ξ hξ c hc
  have C4 : ∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → (fun γ m ξ => dR B.h (a γ m) ξ) γ m ξ ≠ 0 →
      SuppW B G γ ξ := by
    intro γ m ξ hξ hne
    apply S4 γ m ξ hξ
    intro h0
    apply hne
    show dR B.h (a γ m) ξ = 0
    rw [BR γ m ξ hξ]
    exact h0
  have C5 : ∀ k : ℕ, ∃ M : ℝ, ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      NB B.h ((fun γ m ξ => dR B.h (a γ m) ξ) γ m) k ξ ≤
        M * qC B.h ξ ^ (B.h * (-(1 / (2 * B.h)) - kapS)) * ∑ i ∈ Finset.range (k + 2), NB B.h (a γ m) i ξ := by
    intro k
    obtain ⟨M, hM⟩ := slow_deriv_nb_v5 B hok k
    refine ⟨M, fun γ m ξ hξ hX1 hX2 => ?_⟩
    have hev : (fun η => dR B.h (a γ m) η) =ᶠ[nhds ξ] (fun η i => dR B.h (fun η' => a γ m η' i) η) :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => BR γ m η hη)
    have hb := (hM (qsOf l0) (a γ m) ξ hq0 hq1 (ha.2.1 γ m) hξ hX1 hX2).2.1
    have e1 : NB B.h (fun η => dR B.h (a γ m) η) k ξ =
        NB B.h (fun η i => dR B.h (fun η' => a γ m η' i) η) k ξ := by
      unfold NB
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    show NB B.h (fun η => dR B.h (a γ m) η) k ξ ≤
        M * qC B.h ξ ^ (B.h * (-(1 / (2 * B.h)) - kapS)) * ∑ i ∈ Finset.range (k + 2), NB B.h (a γ m) i ξ
    rw [e1, hexp]
    exact hb
  have hfin := inWg5_of_nb_dom_v5 B G (qsOf l0) β (-(1 / (2 * B.h)) - kapS) a
    (fun γ m ξ => dR B.h (a γ m) ξ) hok ha C1 C2 C3 C4 C5
  have e2 : β + (-(1 / (2 * B.h)) - kapS) = β - 1 / (2 * B.h) - kapS := by ring
  rw [e2] at hfin
  exact hfin

theorem inWg5_dZ_class_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (β : ℝ) (a : WC), InWg5 B G (qsOf l0) β a → InWg5 B G (qsOf l0) (β - 1 / (2 * B.h)) (fun γ m ξ => dZ (a γ m) ξ) :=
by
  intro B G hok hG
  obtain ⟨lp, Hp⟩ := pulse_support_good_v5 B G hok hG
  refine ⟨lp + 7, fun l0 hl0 β a ha => ?_⟩
  have hh : 0 < B.h := hok.2.1.1
  have hh0 : B.h ≠ 0 := hh.ne'
  have hu : B.h * (1 / (2 * B.h)) = 1 / 2 := by field_simp
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hq1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  obtain ⟨hDo, hqpos⟩ : IsOpen (DomC B.h (qsOf l0)) ∧ ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ := by
    refine ⟨?_, fun ξ hξ => (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).1⟩
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'

  have hframe : ∀ ξ : Cyl, 0 < qC B.h ξ → qC B.h ξ ≤ 1 →
      ∃ w : Cyl, Lnorm B.h ξ w = ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) ∧ ‖w‖ ≤ qC B.h ξ ^ (-(1/2:ℝ)) := by
    intro ξ hq hq1'
    have hs0 : 0 ≤ qC B.h ξ ^ (-(1/2 - B.h)) := Real.rpow_nonneg hq.le _
    have hsle : qC B.h ξ ^ (-(1/2 - B.h)) ≤ qC B.h ξ ^ (-(1/2:ℝ)) :=
      Real.rpow_le_rpow_of_exponent_ge hq hq1' (by linarith)
    have hT : 0 ≤ qC B.h ξ ^ (-(1/2:ℝ)) := Real.rpow_nonneg hq.le _
    refine ⟨((0:ℝ), qC B.h ξ ^ (-(1/2 - B.h)), (0:ℝ), (0:ℝ × ℝ)), ?_, ?_⟩
    · have e0 : ∀ v : Cyl, (Lnorm B.h ξ v).1 = Real.sqrt (qC B.h ξ) * v.1 := by
        intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have e1 : ∀ v : Cyl, (Lnorm B.h ξ v).2.1 = qC B.h ξ ^ (1/2 - B.h) * v.2.1 := by
        intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have e2 : ∀ v : Cyl, (Lnorm B.h ξ v).2.2.1 = qC B.h ξ * v.2.2.1 := by
        intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have e3 : ∀ v : Cyl, (Lnorm B.h ξ v).2.2.2 = JpowL (-coarseIdx B.h (qC B.h ξ)) v.2.2.2 := by
        intro v; rfl
      refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
      · rw [e0]; simp
      · rw [e1]
        show qC B.h ξ ^ (1/2 - B.h) * qC B.h ξ ^ (-(1/2 - B.h)) = 1
        rw [← Real.rpow_add hq, add_neg_cancel, Real.rpow_zero]
      · rw [e2]; simp
      · rw [e3]
        exact map_zero _
    · simp only [Prod.norm_mk, norm_zero, Real.norm_eq_abs, abs_of_nonneg hs0]
      exact max_le hT (max_le hsle (max_le hT hT))

  have nbdir : ∀ (ξ : Cyl) (F : Cyl → (Fin 3 → ℂ)) (w : Cyl), ξ ∈ DomC B.h (qsOf l0) →
      ContDiffOn ℝ ∞ F (DomC B.h (qsOf l0)) → ∀ k : ℕ,
      NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ w)) k ξ ≤ ‖w‖ * NB B.h F (k + 1) ξ := by
    intro ξ F w hξ hF k
    have hFd : ContDiffAt ℝ ∞ (fderiv ℝ F) ξ :=
      (hF.fderiv_of_isOpen hDo (by exact_mod_cast le_top)).contDiffAt (hDo.mem_nhds hξ)
    have hcomp : (fun η => fderiv ℝ F η (Lnorm B.h ξ w)) =
        (ContinuousLinearMap.apply ℝ (Fin 3 → ℂ) (Lnorm B.h ξ w)) ∘ (fderiv ℝ F) := by
      funext η; rfl
    have hit : iteratedFDeriv ℝ k (fun η => fderiv ℝ F η (Lnorm B.h ξ w)) ξ =
        (ContinuousLinearMap.apply ℝ (Fin 3 → ℂ) (Lnorm B.h ξ w)).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fderiv ℝ F) ξ) := by
      rw [hcomp]
      exact ContinuousLinearMap.iteratedFDeriv_comp_left _ hFd (by exact_mod_cast le_top)
    have hNB0 : 0 ≤ NB B.h F (k + 1) ξ := norm_nonneg _
    unfold NB
    rw [hit]
    apply ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg (norm_nonneg _) hNB0)
    intro m
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      ContinuousLinearMap.apply_apply]
    have key : (iteratedFDeriv ℝ k (fderiv ℝ F) ξ (fun i => Lnorm B.h ξ (m i))) (Lnorm B.h ξ w) =
        ((iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ))
          (Fin.snoc (α := fun _ => Cyl) m w) := by
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_succ_apply_right]
      have e1 : Fin.init (fun i : Fin (k+1) => Lnorm B.h ξ (Fin.snoc (α := fun _ => Cyl) m w i)) =
          fun i => Lnorm B.h ξ (m i) := by
        funext i
        simp [Fin.init, Fin.snoc_castSucc]
      rw [e1]
      simp only [Fin.snoc_last]
    rw [key]
    have hprod : ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ =
        (∏ i : Fin k, ‖m i‖) * ‖w‖ := by
      rw [Fin.prod_univ_castSucc]
      simp [Fin.snoc_castSucc, Fin.snoc_last]
    calc _ ≤ ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ *
          ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ :=
          ContinuousMultilinearMap.le_opNorm _ _
      _ = ‖w‖ * ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ *
          ∏ i : Fin k, ‖m i‖ := by rw [hprod]; ring

  have Gm : ∀ (γ : Lab) (m : ℤ) (ξ : Cyl), ξ ∉ tsupport (a γ m) →
      (fun η => dZ (a γ m) η) =ᶠ[nhds ξ] fun _ => (0 : Fin 3 → ℂ) := by
    intro γ m ξ hts
    have h0 : a γ m =ᶠ[nhds ξ] 0 := notMem_tsupport_iff_eventuallyEq.mp hts
    filter_upwards [h0.eventuallyEq_nhds] with η hη
    show fderiv ℝ (a γ m) η ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) = 0
    rw [hη.fderiv_eq]
    simp
  obtain ⟨H, hH0, hHz⟩ := ha.1
  refine ⟨⟨H, hH0, fun γ m hm => ?_⟩, fun γ m => ?_, fun γ m ξ hξ c hc => ?_, fun γ m ξ hξ hne => ?_,
    fun k => ?_⟩
  ·
    funext ξ
    show fderiv ℝ (a γ m) ξ ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) = 0
    rw [hHz γ m hm]
    simp
  ·
    show ContDiffOn ℝ ∞ (fun ξ => fderiv ℝ (a γ m) ξ ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)))
      (DomC B.h (qsOf l0))
    exact ((ha.2.1 γ m).fderiv_of_isOpen hDo (by exact_mod_cast le_top)).clm_apply contDiffOn_const
  ·
    show fderiv ℝ (a γ m) (shY ξ c) ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) =
      fderiv ℝ (a γ m) ξ ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ))
    have hloc : ∀ᶠ η in nhds ξ, a γ m (shY η c) = a γ m η := by
      filter_upwards [hDo.mem_nhds hξ, deck_locally_stable_v5 B l0 hok (by omega) ξ hξ c hc]
        with η hη hdη
      exact ha.2.2.1 γ m η hη c hdη
    obtain ⟨e, he⟩ : ∃ e : Cyl, e = ((0:ℝ), (0:ℝ), (0:ℝ), c) := ⟨_, rfl⟩
    have hsh : ∀ η : Cyl, shY η c = η + e := by
      intro η
      rw [he]
      simp only [shY]
      ext <;> simp
    have hfd : fderiv ℝ (a γ m) (shY ξ c) = fderiv ℝ (a γ m) ξ := by
      have hev : (fun x => a γ m (x + e)) =ᶠ[nhds ξ] a γ m :=
        hloc.mono (fun η hη => by
          show a γ m (η + e) = a γ m η
          rw [← hsh η, hη])
      rw [hsh ξ, ← fderiv_comp_add_right]
      exact hev.fderiv_eq
    rw [hfd]
  ·
    by_cases hts : ξ ∈ tsupport (a γ m)
    · exact (Hp l0 (by omega) β a ha γ m ξ hξ hts).1
    · exact absurd (Gm γ m ξ hts).eq_of_nhds hne
  ·
    obtain ⟨C, b, dd, hC⟩ := ha.2.2.2.2 (k + 1)
    refine ⟨C, b, dd, fun γ m ξ hξ hX1 hX2 => ?_⟩
    have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
    have hq1' : qC B.h ξ ≤ 1 := le_trans hξ.2.2.le hq1
    obtain ⟨w, hw, hwn⟩ := hframe ξ hq0 hq1'
    have h1 := nbdir ξ (a γ m) w hξ (ha.2.1 γ m) k
    rw [hw] at h1
    have hb := hC γ m ξ hξ hX1 hX2
    have hNB0 : 0 ≤ NB B.h (a γ m) (k + 1) ξ := norm_nonneg _
    show NB B.h (fun η => fderiv ℝ (a γ m) η ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ))) k ξ ≤ _
    rw [show B.h * (β - 1 / (2 * B.h)) = -(1/2:ℝ) + B.h * β by linear_combination (-1:ℝ) * hu,
      Real.rpow_add hq0]
    calc _ ≤ ‖w‖ * NB B.h (a γ m) (k + 1) ξ := h1
      _ ≤ qC B.h ξ ^ (-(1/2:ℝ)) * NB B.h (a γ m) (k + 1) ξ := mul_le_mul_of_nonneg_right hwn hNB0
      _ ≤ qC B.h ξ ^ (-(1/2:ℝ)) * _ := mul_le_mul_of_nonneg_left hb (Real.rpow_nonneg hq0.le _)
      _ = _ := by ring

theorem visc5_split_v5 : ∀ (B : BG) (G : CorrGeom) (qs : ℝ) (w : WC), B.ok → (∀ (γ : Lab) (m : ℤ), ContDiffOn ℝ ∞ (w γ m) (DomC B.h qs)) → ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h qs, remVisc5 B G (viscA5 B w) γ m ξ = visc5Terms B G w γ m ξ :=
by
  intro B G qs w hok hw γ m ξ hξ
  have hS : SimScaleProps B.h := hok.1
  have hm : MapsTo (fun η : Cyl => (η.2.1, 1 - η.2.2.1)) {η : Cyl | η.2.2.1 < 1} (univ ×ˢ Ioi 0) := by
    intro η hη
    have hη' : η.2.2.1 < 1 := hη
    exact ⟨mem_univ _, show (0:ℝ) < 1 - η.2.2.1 by linarith⟩
  have hqC1 : ContDiffOn ℝ ∞ (fun η : Cyl => simScale B.h η.2.1 (1 - η.2.2.1)) {η : Cyl | η.2.2.1 < 1} :=
    hS.2.2.2.1.comp (f := fun η : Cyl => (η.2.1, 1 - η.2.2.1)) (by fun_prop) hm
  have hDo : IsOpen (DomC B.h qs) := by
    have hcont := hqC1.continuousOn
    have e : DomC B.h qs = {η : Cyl | 0 < η.1} ∩ ({η : Cyl | η.2.2.1 < 1} ∩
        (fun η : Cyl => simScale B.h η.2.1 (1 - η.2.2.1)) ⁻¹' Iio qs) := by
      ext η
      exact Iff.rfl
    rw [e]
    exact (isOpen_lt continuous_const continuous_fst).inter
      (hcont.isOpen_inter_preimage (isOpen_lt (by fun_prop) continuous_const) isOpen_Iio)
  have hqC : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h qs) :=
    hqC1.mono (fun η hη => hη.2.1)
  have hqpos : ∀ η ∈ DomC B.h qs, 0 < qC B.h η := fun η hη =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith [hη.2.1])).1
  have hr : 0 < ξ.1 := hξ.1
  have haD : ContDiffOn ℝ ∞ (viscA5 B w γ m) (DomC B.h qs) := by
    have h1 : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-Aex B.h)) (DomC B.h qs) :=
      hqC.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
    have h2 : ContDiffOn ℝ ∞ (fun η => ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ)) (DomC B.h qs) :=
      Complex.ofRealCLM.contDiff.comp_contDiffOn h1
    exact h2.smul (hw γ m)
  have hdiff : ∀ η ∈ DomC B.h qs, DifferentiableAt ℝ (viscA5 B w γ m) η := fun η hη =>
    (haD.contDiffAt (hDo.mem_nhds hη)).differentiableAt (by simp)
  have swap1 : ∀ (F : Cyl → Fin 3 → ℂ) (η : Cyl), DifferentiableAt ℝ F η → ∀ i : Fin 3,
      dR B.h (fun x => F x i) η = dR B.h F η i ∧ dZ (fun x => F x i) η = dZ F η i := by
    intro F η hF i
    unfold dR dZ
    rw [fderiv_apply hF i]
    exact ⟨rfl, rfl⟩
  have haξ : ContDiffAt ℝ ∞ (viscA5 B w γ m) ξ := haD.contDiffAt (hDo.mem_nhds hξ)
  have hfd : DifferentiableAt ℝ (fderiv ℝ (viscA5 B w γ m)) ξ := by
    have h2 : ContDiffAt ℝ 2 (viscA5 B w γ m) ξ := haξ.of_le (WithTop.coe_le_coe.mpr le_top)
    exact (h2.fderiv_right (m := 1) (by norm_num)).differentiableAt one_ne_zero
  have hdir : DifferentiableAt ℝ
      (fun η : Cyl => ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv)) ξ := by
    have h1 : DifferentiableAt ℝ (fun η : Cyl => η.1 ^ (drx B.h - 1)) ξ :=
      differentiableAt_fst.rpow_const (Or.inl hr.ne')
    exact (differentiableAt_const _).prodMk ((differentiableAt_const _).prodMk
      ((differentiableAt_const _).prodMk ((h1.const_mul _).smul_const vrv)))
  have hdRa : DifferentiableAt ℝ (fun η => dR B.h (viscA5 B w γ m) η) ξ := hfd.clm_apply hdir
  have hdZa : DifferentiableAt ℝ (fun η => dZ (viscA5 B w γ m) η) ξ :=
    hfd.clm_apply (differentiableAt_const _)
  have E1 : ∀ i : Fin 3, dR B.h (fun η => viscA5 B w γ m η i) ξ = dR B.h (viscA5 B w γ m) ξ i :=
    fun i => (swap1 _ ξ (hdiff ξ hξ) i).1
  have E2 : ∀ i : Fin 3, dZ (fun η => viscA5 B w γ m η i) ξ = dZ (viscA5 B w γ m) ξ i :=
    fun i => (swap1 _ ξ (hdiff ξ hξ) i).2
  have dRc : ∀ (f g : Cyl → ℂ), f =ᶠ[nhds ξ] g → dR B.h f ξ = dR B.h g ξ := by
    intro f g h
    unfold dR
    rw [h.fderiv_eq]
  have dZc : ∀ (f g : Cyl → ℂ), f =ᶠ[nhds ξ] g → dZ f ξ = dZ g ξ := by
    intro f g h
    unfold dZ
    rw [h.fderiv_eq]
  have E3 : ∀ i : Fin 3, dR B.h (fun η => dR B.h (fun η' => viscA5 B w γ m η' i) η) ξ =
      dR B.h (fun η => dR B.h (viscA5 B w γ m) η) ξ i := by
    intro i
    have hev : (fun η => dR B.h (fun η' => viscA5 B w γ m η' i) η) =ᶠ[nhds ξ]
        (fun η => dR B.h (viscA5 B w γ m) η i) :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => (swap1 _ η (hdiff η hη) i).1)
    rw [dRc _ _ hev]
    exact (swap1 _ ξ hdRa i).1
  have E4 : ∀ i : Fin 3, dZ (fun η => dZ (fun η' => viscA5 B w γ m η' i) η) ξ =
      dZ (fun η => dZ (viscA5 B w γ m) η) ξ i := by
    intro i
    have hev : (fun η => dZ (fun η' => viscA5 B w γ m η' i) η) =ᶠ[nhds ξ]
        (fun η => dZ (viscA5 B w γ m) η i) :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => (swap1 _ η (hdiff η hη) i).2)
    rw [dZc _ _ hev]
    exact (swap1 _ ξ hdZa i).2

  have hQpos : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr (Real.rpow_pos_of_pos two_pos _)
  have hKpos : 0 < kb B.h γ.1 := by
    unfold kb epsb
    exact Nat.ceil_pos.mpr (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos
      (Real.rpow_pos_of_pos two_pos _) _) _)
  have hr0 : (ξ.1 : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr.ne'
  have hQ0 : ((Real.sqrt (Qb γ.1) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hQpos.ne'
  have hK0 : ((kb B.h γ.1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hKpos.ne'
  have hv1 : vDR5 B (viscA5 B w) γ m = fun η => dR B.h (viscA5 B w γ m) η := rfl
  have hv2 : vDZ5 (viscA5 B w) γ m = fun η => dZ (viscA5 B w γ m) η := rfl
  funext i
  simp only [remVisc5, visc5Terms, Pi.add_apply, Pi.smul_apply, vSm5, vC5, vS5, vR5, vQ5, vK5, vN5,
    vD5, vInt5, vCr5, hv1, hv2, smul_eq_mul, E1, E2, E3, E4]
  simp only [vDR5, vDZ5]
  simp only [hv1, hv2]
  fin_cases i
  all_goals
    simp only [crossC, nPhi5, DrC, DzC, pang5, RC, dvF5, smul_eq_mul, Fin.zero_eta, Fin.mk_one,
      Fin.reduceFinMk, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Pi.smul_apply, Matrix.vecHead, Matrix.vecTail, Function.comp_apply,
      Fin.succ_zero_eq_one, Fin.succ_one_eq_two]
    push_cast
    field_simp
    ring

theorem visc5_scalar_factors_v5 : ∀ (B : BG), B.ok → ∀ (c : ℝ) (k : ℕ), ∃ C : ℝ, ∀ (l : ℕ) (ξ : Cyl), ξ ∈ DomC B.h 1 → 1/4 < qC B.h ξ / Qb l → qC B.h ξ / Qb l < 4 → B.Xa / 2 < XC B.h ξ → (ContDiffAt ℝ ∞ (fun η : Cyl => ((qC B.h η ^ c : ℝ) : ℂ)) ξ ∧ NB B.h (fun η : Cyl => ((qC B.h η ^ c : ℝ) : ℂ)) k ξ ≤ C * qC B.h ξ ^ c) ∧ (ContDiffAt ℝ ∞ (fun η : Cyl => ((Real.sqrt (Qb l) / η.1 : ℝ) : ℂ)) ξ ∧ NB B.h (fun η : Cyl => ((Real.sqrt (Qb l) / η.1 : ℝ) : ℂ)) k ξ ≤ C) ∧ NB B.h (fun _ : Cyl => (((Real.sqrt (Qb l))⁻¹ : ℝ) : ℂ)) k ξ ≤ 2 * qC B.h ξ ^ (-(1/2 : ℝ)) ∧ NB B.h (fun _ : Cyl => ((((kb B.h l : ℕ) : ℝ)) : ℂ)) k ξ ≤ 4 * qC B.h ξ ^ (-(B.h / 2)) :=
by
  intro B hok c k
  have hh0 : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  have hS : SimScaleProps B.h := hok.1
  obtain ⟨hDo, hqC, hqpos, -, -, -⟩ := domc_open_calculus B 1 hok
  obtain ⟨C1, hC1⟩ := tn_qpow_normalized_v5 B.h hh0 hh1 hS c k
  obtain ⟨C2, hC2⟩ := inv_r_nb_v5 B hok k
  refine ⟨max C1 C2, fun l ξ hξ hlo hhi hX => ?_⟩
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < 1 := hξ
  have hq : 0 < qC B.h ξ := hqpos ξ hξ
  have hQ : 0 < Qb l := by unfold Qb; exact Real.rpow_pos_of_pos (by norm_num) _
  have hQ1 : Qb l ≤ 1 := by
    unfold Qb; exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hq4 : qC B.h ξ < 4 * Qb l := (div_lt_iff₀ hQ).1 hhi
  have hg1 : ‖(Complex.ofRealCLM : ℝ →L[ℝ] ℂ)‖ ≤ 1 :=
    ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => by
      rw [Complex.ofRealCLM_apply, Complex.norm_real, one_mul])
  have hcast : ∀ (f : Cyl → ℝ), ContDiffAt ℝ ∞ f ξ →
      ContDiffAt ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) ξ ∧
      NB B.h (fun η => ((f η : ℝ) : ℂ)) k ξ ≤ NB B.h f k ξ := by
    intro f hf
    have hcomp : (fun η => ((f η : ℝ) : ℂ)) = ⇑(Complex.ofRealCLM) ∘ f := by
      funext η; simp [Complex.ofRealCLM_apply]
    rw [hcomp]
    refine ⟨(Complex.ofRealCLM : ℝ →L[ℝ] ℂ).contDiff.comp_contDiffAt ξ hf, ?_⟩
    have e1 : iteratedFDeriv ℝ k (⇑(Complex.ofRealCLM) ∘ f) ξ =
        (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).compContinuousMultilinearMap (iteratedFDeriv ℝ k f ξ) :=
      ContinuousLinearMap.iteratedFDeriv_comp_left Complex.ofRealCLM hf
        (i := k) (by exact_mod_cast le_top)
    unfold NB
    rw [e1]
    have e2 : ((Complex.ofRealCLM : ℝ →L[ℝ] ℂ).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k f ξ)).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
        (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).compContinuousMultilinearMap
          ((iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext v
      rfl
    rw [e2]
    calc _ ≤ ‖(Complex.ofRealCLM : ℝ →L[ℝ] ℂ)‖ *
          ‖(iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ _ := mul_le_of_le_one_left (norm_nonneg _) hg1
  have hNBc : ∀ (z : ℂ), NB B.h (fun _ : Cyl => z) k ξ ≤ ‖z‖ := by
    intro z
    unfold NB
    refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
    rcases Nat.eq_zero_or_pos k with hk0 | hk'
    · subst hk0; simp
    · rw [iteratedFDeriv_const_of_ne hk'.ne']; simp

  have hf1 : ContDiffAt ℝ ∞ (fun η => qC B.h η ^ c) ξ :=
    (hqC.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')).contDiffAt (hDo.mem_nhds hξ)
  obtain ⟨hcd1, hnb1⟩ := hcast _ hf1
  have cl1 : NB B.h (fun η : Cyl => ((qC B.h η ^ c : ℝ) : ℂ)) k ξ ≤ max C1 C2 * qC B.h ξ ^ c :=
    hnb1.trans ((hC1 ξ hξ'.2.1 hξ'.2.2.le).trans
      (mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.rpow_nonneg hq.le _)))

  have hf2 : ContDiffAt ℝ ∞ (fun η : Cyl => Real.sqrt (Qb l) / η.1) ξ :=
    contDiffAt_const.div contDiffAt_fst hξ'.1.ne'
  obtain ⟨hcd2, hnb2⟩ := hcast _ hf2
  have cl2 : NB B.h (fun η : Cyl => ((Real.sqrt (Qb l) / η.1 : ℝ) : ℂ)) k ξ ≤ max C1 C2 :=
    hnb2.trans ((hC2 l ξ hξ'.1 hξ'.2.1 hlo hX).trans (le_max_right _ _))

  have cl3 : NB B.h (fun _ : Cyl => (((Real.sqrt (Qb l))⁻¹ : ℝ) : ℂ)) k ξ ≤
      2 * qC B.h ξ ^ (-(1/2 : ℝ)) := by
    refine (hNBc _).trans ?_
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (inv_nonneg.2 (Real.sqrt_nonneg _))]
    have hsq : 0 < Real.sqrt (qC B.h ξ) := Real.sqrt_pos.2 hq
    have h4 : Real.sqrt (qC B.h ξ) ≤ 2 * Real.sqrt (Qb l) := by
      have e4 : Real.sqrt (4 * Qb l) = 2 * Real.sqrt (Qb l) := by
        rw [Real.sqrt_mul (by norm_num), show (4:ℝ) = 2 * 2 by norm_num,
          Real.sqrt_mul_self (by norm_num)]
      rw [← e4]
      exact Real.sqrt_le_sqrt hq4.le
    have e : qC B.h ξ ^ (-(1/2 : ℝ)) = (Real.sqrt (qC B.h ξ))⁻¹ := by
      rw [Real.rpow_neg hq.le, Real.sqrt_eq_rpow]
    rw [e]
    calc (Real.sqrt (Qb l))⁻¹ = 2 * (2 * Real.sqrt (Qb l))⁻¹ := by
          rw [mul_inv, ← mul_assoc, mul_inv_cancel₀ two_ne_zero, one_mul]
      _ ≤ 2 * (Real.sqrt (qC B.h ξ))⁻¹ :=
          mul_le_mul_of_nonneg_left (inv_anti₀ hsq h4) (by norm_num)

  have cl4 : NB B.h (fun _ : Cyl => ((((kb B.h l : ℕ) : ℝ)) : ℂ)) k ξ ≤
      4 * qC B.h ξ ^ (-(B.h / 2)) := by
    refine (hNBc _).trans ?_
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Nat.cast_nonneg _)]
    have hkx : (kb B.h l : ℝ) = (⌈Qb l ^ (-(B.h / 2))⌉₊ : ℝ) := by
      unfold kb epsb
      rw [← Real.rpow_mul hQ.le]
      congr 3
      ring
    have hx1 : 1 ≤ Qb l ^ (-(B.h / 2)) :=
      Real.one_le_rpow_of_pos_of_le_one_of_nonpos hQ hQ1 (by linarith)
    have hceil : (⌈Qb l ^ (-(B.h / 2))⌉₊ : ℝ) < Qb l ^ (-(B.h / 2)) + 1 :=
      Nat.ceil_lt_add_one (by linarith)
    have hq4' : qC B.h ξ / 4 ≤ Qb l := by linarith
    have hmono : Qb l ^ (-(B.h / 2)) ≤ (qC B.h ξ / 4) ^ (-(B.h / 2)) :=
      Real.rpow_le_rpow_of_nonpos (by positivity) hq4' (by linarith)
    have hsplit : (qC B.h ξ / 4) ^ (-(B.h / 2)) = qC B.h ξ ^ (-(B.h / 2)) * (4:ℝ) ^ (B.h / 2) := by
      rw [Real.div_rpow hq.le (by norm_num), Real.rpow_neg (by norm_num : (0:ℝ) ≤ 4), div_inv_eq_mul]
    have h42 : (4:ℝ) ^ (B.h / 2) ≤ 2 := by
      have h1 := Real.rpow_le_rpow_of_exponent_le (by norm_num : (1:ℝ) ≤ 4) (by linarith : B.h / 2 ≤ 1/2)
      have e : (4:ℝ) ^ (1/2 : ℝ) = 2 := by
        rw [← Real.sqrt_eq_rpow, show (4:ℝ) = 2 * 2 by norm_num, Real.sqrt_mul_self (by norm_num)]
      linarith
    have hqp : 0 ≤ qC B.h ξ ^ (-(B.h / 2)) := Real.rpow_nonneg hq.le _
    have hm2 : qC B.h ξ ^ (-(B.h / 2)) * (4:ℝ) ^ (B.h / 2) ≤ qC B.h ξ ^ (-(B.h / 2)) * 2 :=
      mul_le_mul_of_nonneg_left h42 hqp
    rw [hkx]
    linarith
  exact ⟨⟨hcd1, cl1⟩, ⟨hcd2, cl2⟩, cl3, cl4⟩

theorem visc5_nphi_factors_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C : ℝ, ∀ (l0 : ℕ), l1 ≤ l0 → ∀ (γ : Lab) (ξ : Cyl), viscGood5 B G l0 γ ξ → ∀ i : Fin 3, ContDiffAt ℝ ∞ (fun η => ((nPhi5 B G γ η i : ℝ) : ℂ)) ξ ∧ (∀ c : ℝ × ℝ, IsDeck B.h (qC B.h ξ) c → nPhi5 B G γ (shY ξ c) = nPhi5 B G γ ξ) ∧ NB B.h (fun η => ((nPhi5 B G γ η i : ℝ) : ℂ)) k ξ ≤ C * SC B.h ξ :=
by
  intro B G hok hG
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨lN, HN⟩ := good_nphi5_nb_v5 B G hok hG
  obtain ⟨lg, Hg⟩ := band_coarse_gap_v5 B.h hh0 hh1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨lN + lg + n0, fun k => ?_⟩
  obtain ⟨C, hC⟩ := HN k
  refine ⟨C, ?_⟩
  intro l0 hl0 γ ξ hg i
  obtain ⟨hA, hlγ, hξ, hq1, hq2, hX1, hX2, hxi, het⟩ := hg
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hξB : ξ ∈ DomC B.h B.qB := ⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqsB⟩
  obtain ⟨-, -, hqpos, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
  have hgap : coarseIdx B.h (qC B.h ξ) ≤ bandIdx B.h γ.1 :=
    (Hg γ.1 l0 (qC B.h ξ) (by omega) hq0 hξ.2.2 hq1 hq2).1
  obtain ⟨U, hUo, hξU, -, hn, -, -⟩ := good_coeff_smooth_v5 B G γ ξ hok hξB hxi het
  set f : Cyl → ℝ := fun η => nPhi5 B G γ η i with hf
  have hfR : ContDiffAt ℝ ∞ f ξ := (hn i).contDiffAt (hUo.mem_nhds hξU)
  have hcomp : (fun η : Cyl => ((nPhi5 B G γ η i : ℝ) : ℂ)) = ⇑(Complex.ofRealCLM) ∘ f := by
    funext η
    simp [hf, Complex.ofRealCLM_apply]
  have hg1 : ‖(Complex.ofRealCLM : ℝ →L[ℝ] ℂ)‖ ≤ 1 :=
    ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => by
      rw [Complex.ofRealCLM_apply, Complex.norm_real, one_mul])
  refine ⟨?_, ?_, ?_⟩
  · rw [hcomp]
    exact (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).contDiff.comp_contDiffAt ξ hfR
  · intro c hc
    exact nPhi5_deck_v5 B G γ (coarseIdx B.h (qC B.h ξ)) c hgap hc ξ
  · have hNB : NB B.h (fun η : Cyl => ((nPhi5 B G γ η i : ℝ) : ℂ)) k ξ ≤ NB B.h f k ξ := by
      have e1 : iteratedFDeriv ℝ k (⇑(Complex.ofRealCLM) ∘ f) ξ =
          (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).compContinuousMultilinearMap (iteratedFDeriv ℝ k f ξ) :=
        ContinuousLinearMap.iteratedFDeriv_comp_left Complex.ofRealCLM hfR
          (i := k) (by exact_mod_cast le_top)
      rw [hcomp]
      unfold NB
      rw [e1]
      have e2 : ((Complex.ofRealCLM : ℝ →L[ℝ] ℂ).compContinuousMultilinearMap
            (iteratedFDeriv ℝ k f ξ)).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
          (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).compContinuousMultilinearMap
            ((iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
        ext v
        rfl
      rw [e2]
      calc _ ≤ ‖(Complex.ofRealCLM : ℝ →L[ℝ] ℂ)‖ *
            ‖(iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ :=
            ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
        _ ≤ _ := mul_le_of_le_one_left (norm_nonneg _) hg1
    exact hNB.trans (hC l0 (by omega) γ hA hlγ ξ hξ hq1 hq2 hX1 hX2 hxi het i)

theorem visc5_dv_mult_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C : ℝ, ∀ (l0 : ℕ), l1 ≤ l0 → ∀ (γ : Lab) (ξ : Cyl), viscGood5 B G l0 γ ξ → ContDiffAt ℝ ∞ (fun η => ((dvF5 B G γ η : ℝ) : ℂ)) ξ ∧ (∀ c : ℝ × ℝ, IsDeck B.h (qC B.h ξ) c → dvF5 B G γ (shY ξ c) = dvF5 B G γ ξ) ∧ NB B.h (fun η => ((dvF5 B G γ η : ℝ) : ℂ)) k ξ ≤ C * qC B.h ξ ^ (-(1 + B.h * kapS)) * SC B.h ξ :=
by

  have nbdirR : ∀ (h : ℝ) (U : Set Cyl) (ξ : Cyl) (F : Cyl → ℝ) (w : Cyl), IsOpen U → ξ ∈ U →
      ContDiffOn ℝ ∞ F U → ∀ k : ℕ,
      NB h (fun η => fderiv ℝ F η (Lnorm h ξ w)) k ξ ≤ ‖w‖ * NB h F (k + 1) ξ := by
    intro h U ξ F w hU hξ hF k
    have hFd : ContDiffAt ℝ ∞ (fderiv ℝ F) ξ :=
      (hF.fderiv_of_isOpen hU (by exact_mod_cast le_top)).contDiffAt (hU.mem_nhds hξ)
    have hcomp : (fun η => fderiv ℝ F η (Lnorm h ξ w)) =
        (ContinuousLinearMap.apply ℝ ℝ (Lnorm h ξ w)) ∘ (fderiv ℝ F) := by
      funext η; rfl
    have hit : iteratedFDeriv ℝ k (fun η => fderiv ℝ F η (Lnorm h ξ w)) ξ =
        (ContinuousLinearMap.apply ℝ ℝ (Lnorm h ξ w)).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fderiv ℝ F) ξ) := by
      rw [hcomp]
      exact ContinuousLinearMap.iteratedFDeriv_comp_left _ hFd (by exact_mod_cast le_top)
    have hNB0 : 0 ≤ NB h F (k + 1) ξ := norm_nonneg _
    unfold NB
    rw [hit]
    apply ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg (norm_nonneg _) hNB0)
    intro m
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      ContinuousLinearMap.apply_apply]
    have key : (iteratedFDeriv ℝ k (fderiv ℝ F) ξ (fun i => Lnorm h ξ (m i))) (Lnorm h ξ w) =
        ((iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ))
          (Fin.snoc (α := fun _ => Cyl) m w) := by
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_succ_apply_right]
      have e1 : Fin.init (fun i : Fin (k+1) => Lnorm h ξ (Fin.snoc (α := fun _ => Cyl) m w i)) =
          fun i => Lnorm h ξ (m i) := by
        funext i
        simp [Fin.init, Fin.snoc_castSucc]
      rw [e1]
      simp only [Fin.snoc_last]
    rw [key]
    have hprod : ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ =
        (∏ i : Fin k, ‖m i‖) * ‖w‖ := by
      rw [Fin.prod_univ_castSucc]
      simp [Fin.snoc_castSucc, Fin.snoc_last]
    calc _ ≤ ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ *
          ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ :=
          ContinuousMultilinearMap.le_opNorm _ _
      _ = ‖w‖ * ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ *
          ∏ i : Fin k, ‖m i‖ := by rw [hprod]; ring

