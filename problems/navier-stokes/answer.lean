    simp only [hz0, hg0, smul_zero]
  · intro d η hd h1 h2
    obtain ⟨k, hk⟩ : ∃ t : ℝ, t = cpatch * (1 + η ^ 2)⁻¹ := ⟨_, rfl⟩
    obtain ⟨κ, hκ⟩ : ∃ t : ℝ, t = (1 + η ^ 2) / cpatch := ⟨_, rfl⟩
    have hPne : cpatch ≠ 0 := hcp.ne'
    have h1e : 1 + η ^ 2 ≠ 0 := by positivity
    have hkκ : k * κ = 1 := by rw [hk, hκ]; field_simp
    have hk0 : 0 ≤ k := by rw [hk]; exact mul_nonneg hcp.le (inv_nonneg.2 (by positivity))
    have hkP : k ≤ cpatch := by
      rw [hk]
      calc cpatch * (1 + η ^ 2)⁻¹ ≤ cpatch * 1 :=
            mul_le_mul_of_nonneg_left (inv_le_one_of_one_le₀ (by nlinarith [sq_nonneg η])) hcp.le
