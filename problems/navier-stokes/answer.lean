    have e : P * -S * M ^ 2 = -(P * S * M ^ 2) := by ring
    linarith
  have hS3 : 1 ≤ 2 * M ^ 3 * S := by
    have h := mul_le_mul_of_nonneg_right hPle (by positivity : 0 ≤ S * M ^ 2)
    have e1 : P * (S * M ^ 2) = P * S * M ^ 2 := by ring
    have e2 : 2 * M * (S * M ^ 2) = 2 * M ^ 3 * S := by ring
    linarith
  have hSle : S ≤ M := by
    have : S = G0 - P := by rw [hS, hP]; ring
    linarith
  have hr1 : 1 ≤ 1 + σ ^ 2 := by linarith [sq_nonneg σ]
  have hr2 : 1 + σ ^ 2 ≤ 5 * M ^ 2 := by linarith
  have hX0 : 0 ≤ X := by rw [hX]; positivity

  have hSa0 : 0 ≤ S * a ^ 2 := mul_nonneg hSpos.le (sq_nonneg a)
  have hPb0 : 0 ≤ P * (1 + σ ^ 2) * b ^ 2 :=
    mul_nonneg (mul_nonneg hPpos.le (by linarith)) (sq_nonneg b)
  have hQ0 : 0 ≤ Q := by rw [hQ]; linarith
  refine ⟨hQ0, ?_, ?_, ?_⟩
  ·
    have hle : ‖x‖ ≤ Real.sqrt X := by
      refine (pi_norm_le_iff_of_nonneg (Real.sqrt_nonneg X)).mpr (fun i => ?_)
      rw [Real.norm_eq_abs]
      exact Real.abs_le_sqrt (hxX i)
    have h := pow_le_pow_left₀ (norm_nonneg _) hle 2
    rw [Real.sq_sqrt hX0] at h
    exact h
  ·
    obtain ⟨c, hc⟩ : ∃ c : ℝ, c = σ * x 0 - N2 * x 1 + N1 * x 2 := ⟨_, rfl⟩
    obtain ⟨w, hw⟩ : ∃ w : ℝ, w = N2 * x 1 - N1 * x 2 := ⟨_, rfl⟩
    have hac : a ^ 2 + c ^ 2 = (1 + σ ^ 2) * (x 0 ^ 2 + w ^ 2) := by
      rw [ha, hc, hw]; ring
    have hbw : b ^ 2 + w ^ 2 = x 1 ^ 2 + x 2 ^ 2 := by
      rw [hb, hw]; linear_combination (x 1 ^ 2 + x 2 ^ 2) * hN
    have hXabc : X ≤ a ^ 2 + b ^ 2 + c ^ 2 := by
      have h0 := mul_nonneg (sq_nonneg σ) (add_nonneg (sq_nonneg (x 0)) (sq_nonneg w))
