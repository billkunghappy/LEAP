      have hsqrpow : (Real.sqrt (qC B.h ξ))⁻¹ = qC B.h ξ ^ (-(1/2:ℝ)) := by
        rw [Real.sqrt_eq_rpow, Real.rpow_neg hq0.le]
      have hexp : (Real.sqrt (qC B.h ξ))⁻¹ * qC B.h ξ ^ (-(1/2 - B.h)) ≤ E := by
        rw [hsqrpow, ← Real.rpow_add hq0, hE]
        exact Real.rpow_le_rpow_of_exponent_ge hq0 hqle (by linarith)
      have hCS : 0 ≤ 2 * CNm * SC B.h ξ := mul_nonneg (mul_nonneg (by norm_num) hCNm0) hSC0
      have hsi : 0 ≤ 2 * (Real.sqrt (qC B.h ξ))⁻¹ := by positivity
      calc s * NB B.h (dZ (fun η' : Cyl => nPhi5 B G γ η' 2)) k ξ
          ≤ 2 * (Real.sqrt (qC B.h ξ))⁻¹ * NB B.h (dZ (fun η' : Cyl => nPhi5 B G γ η' 2)) k ξ :=
            mul_le_mul_of_nonneg_right hs_le (norm_nonneg _)
        _ ≤ 2 * (Real.sqrt (qC B.h ξ))⁻¹ * (qC B.h ξ ^ (-(1/2 - B.h)) * (CNm * SC B.h ξ)) :=
            mul_le_mul_of_nonneg_left (h1.trans (mul_le_mul_of_nonneg_left h2 hp)) hsi
        _ = 2 * CNm * SC B.h ξ * ((Real.sqrt (qC B.h ξ))⁻¹ * qC B.h ξ ^ (-(1/2 - B.h))) := by ring
        _ ≤ 2 * CNm * SC B.h ξ * E := mul_le_mul_of_nonneg_left hexp hCS
        _ = 2 * CNm * (E * SC B.h ξ) := by ring

    rw [← hE]
    calc NB B.h (fun η : Cyl => ((dvF5 B G γ η : ℝ) : ℂ)) k ξ
        ≤ NB B.h g k ξ := hgerm ▸ hNBc
      _ ≤ (s * NB B.h (dR B.h (fun η' : Cyl => nPhi5 B G γ η' 0)) k ξ +
            s ^ 2 * NB B.h (fun η : Cyl => nPhi5 B G γ η 0 * (Real.sqrt (Qb γ.1) / η.1)) k ξ) +
          s * NB B.h (dZ (fun η' : Cyl => nPhi5 B G γ η' 2)) k ξ := by
          rw [hgeq]
          exact hlin1.trans (add_le_add hlin2 le_rfl)
      _ ≤ 2 * M * ((k:ℝ) + 2) * CNm * (E * SC B.h ξ) + 4 * Bc * (E * SC B.h ξ) +
          2 * CNm * (E * SC B.h ξ) := add_le_add (add_le_add hTA hTB) hTC
      _ = (2 * M * ((k:ℝ) + 2) * CNm + 4 * Bc + 2 * CNm) * E * SC B.h ξ := by ring

theorem plin5_visc_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (β : ℝ) (w : WC), InWg5 B G (qsOf l0) β w → InWg5 B G (qsOf l0) (β + 1/2 - 3 * kapS) (remVisc5 B G (fun γ m η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • w γ m η)) :=
by
  intro B G hok hG
  obtain ⟨ls, hls⟩ := pulse_support_good_v5 B G hok hG
  obtain ⟨l₁, hR⟩ := inWg5_dR_class_v5 B G hok hG
  obtain ⟨l₂, hZ⟩ := inWg5_dZ_class_v5 B G hok hG
  obtain ⟨l₇, hN⟩ := visc5_nphi_factors_v5 B G hok hG
  obtain ⟨l₈, hD⟩ := visc5_dv_mult_v5 B G hok hG
  have hF6 := visc5_scalar_factors_v5 B hok
  refine ⟨ls + l₁ + l₂ + l₇ + l₈, fun l0 hl0 β w hw => ?_⟩
  show InWg5 B G (qsOf l0) (β + 1/2 - 3 * kapS) (remVisc5 B G (viscA5 B w))
  have hk : kapS = 1 / 100000 := rfl
  have hκ : 0 < kapS := by rw [hk]; norm_num
  have hS : SimScaleProps B.h := hok.1
  have hh : 0 < B.h := hok.2.1.1
  have hh0 : B.h ≠ 0 := hh.ne'
  have hu : B.h * (1 / (2 * B.h)) = 1 / 2 := by field_simp
  have hq1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hpos : ∀ z t : ℝ, t < 1 → 0 < simScale B.h z (1 - t) := fun z t ht =>
    (hok.1.1 z (1 - t) (by linarith)).1
  have key0 : ∀ (C q a a' : ℝ), 0 < q → q ≤ 1 → a' ≤ a →
      C * q ^ (B.h * a) ≤ |C| * q ^ (B.h * a') := by
    intro C q a a' hq0 hq1' haa
    calc C * q ^ (B.h * a) ≤ |C| * q ^ (B.h * a) :=
          mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0.le _)
      _ ≤ |C| * q ^ (B.h * a') :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0 hq1'
            (mul_le_mul_of_nonneg_left haa hh.le)) (abs_nonneg C)
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hED : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 < edgeDist B.Xa B.Xb X := by
    intro X h1 h2
    have hX0 : 0 < X := lt_trans hXa h1
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr h1))
      (Real.log_pos ((one_lt_div hX0).mpr h2)))
  have hSC : ∀ (ξ : Cyl) (b : ℝ), 0 ≤ SC B.h ξ ^ b := by
    intro ξ b
    exact Real.rpow_nonneg (by unfold SC; positivity) b
  have hW : ∀ (a : WC) (α α' : ℝ),
      α' ≤ α → InWg5 B G (qsOf l0) α a → InWg5 B G (qsOf l0) α' a := by
    intro a α α' hαα ha
    obtain ⟨c1, c2, c3, c4, c5⟩ := ha
    refine ⟨c1, c2, c3, c4, fun k => ?_⟩
    obtain ⟨C, b, d, hC⟩ := c5 k
    refine ⟨|C|, b, d, fun γ m ξ hξ hX1 hX2 => ?_⟩
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hq0 : 0 < qC B.h ξ := hpos ξ.2.1 ξ.2.2.1 hξ'.2.1
    have hq1' : qC B.h ξ ≤ 1 := le_trans hξ'.2.2.le hq1
    refine le_trans (hC γ m ξ hξ hX1 hX2) ?_
    apply mul_le_mul_of_nonneg_right _ (by unfold Penv5; exact (Real.exp_pos _).le)
    apply mul_le_mul_of_nonneg_right _ (Real.rpow_pos_of_pos (hED _ hX1 hX2) _).le
    apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
    exact mul_le_mul_of_nonneg_right (key0 C _ α α' hq0 hq1' hαα) (hSC ξ b)
  have hDo : IsOpen (DomC B.h (qsOf l0)) := by
    have h4c := hS.2.2.2.1.continuousOn
    have hm : MapsTo (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1} (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have hξ' : ξ.2.2.1 < 1 := hξ
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hcont : ContinuousOn (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1} :=
      h4c.comp (f := fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) (Continuous.continuousOn (by fun_prop)) hm
    have e : DomC B.h (qsOf l0) = {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩
        (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) ⁻¹' Iio (qsOf l0)) := by
      ext ξ
      exact Iff.rfl
    rw [e]
    exact (isOpen_lt continuous_const continuous_fst).inter
      (hcont.isOpen_inter_preimage (isOpen_lt (by fun_prop) continuous_const) isOpen_Iio)

  have hNBc : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (z : V) (k : ℕ) (ξ : Cyl),
      NB B.h (fun _ : Cyl => z) k ξ ≤ ‖z‖ := by
    intro V _ _ z k ξ
    unfold NB
    refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
    rcases Nat.eq_zero_or_pos k with rfl | hk'
    · simp
    · rw [iteratedFDeriv_const_of_ne hk'.ne']; simp
  have hsimp0 : ∀ (C : ℝ) (ξ : Cyl), C * qC B.h ξ ^ (B.h * 0) * SC B.h ξ ^ (0:ℝ) = C := by
    intro C ξ; simp

  have hgood : ∀ (α : ℝ) (a : WC), InWg5 B G (qsOf l0) α a → ∀ (γ : Lab) (m : ℤ),
      ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (a γ m) → viscGood5 B G l0 γ ξ := by
    intro α a ha γ m ξ hξ hts
    obtain ⟨-, h1, h2, h3, h4, h5, h6, h7, h8⟩ := hls l0 (by omega) α a ha γ m ξ hξ hts
    exact ⟨h1, h2, hξ, h3, h4, h5, h6, h7, h8⟩

  have SM : ∀ (α β' : ℝ) (a : WC) (μ : Lab → Cyl → ℂ), InWg5 B G (qsOf l0) α a →
      viscFacOK5 B G l0 μ β' → InWg5 B G (qsOf l0) (α + β') (vSm5 μ a) := by
    intro α β' a μ ha hμ
    obtain ⟨hμ1, hμ2⟩ := hμ
    exact inWg5_smul_mult B G l0 hok α β' a μ ha
      (fun γ m ξ hξ hts => (hμ1 γ ξ (hgood α a ha γ m ξ hξ hts)).1)
      (fun γ m ξ hξ hne c hc => (hμ1 γ ξ (hgood α a ha γ m ξ hξ
        (subset_tsupport _ (Function.mem_support.mpr hne)))).2 c hc)
      (fun k => by
        obtain ⟨C, b, hC⟩ := hμ2 k
        exact ⟨C, b, fun γ m ξ hξ hts _ _ => hC γ ξ (hgood α a ha γ m ξ hξ hts)⟩)

  have hInt : ∀ (α : ℝ) (a : WC), InWg5 B G (qsOf l0) α a → InWg5 B G (qsOf l0) α (vInt5 a) := by
    intro α a ha
    obtain ⟨⟨H, hH0, hHa⟩, c2, c3, c4, c5⟩ := ha
    refine ⟨⟨H, hH0, fun γ m hm => ?_⟩, fun γ m => ?_, fun γ m ξ hξ c hc => ?_,
      fun γ m ξ hξ hne => ?_, fun k => ?_⟩
    · funext ξ
      show (m : ℂ) • a γ m ξ = 0
      rw [hHa γ m hm]; simp
    · exact (c2 γ m).const_smul (m : ℂ)
    · show (m : ℂ) • a γ m (shY ξ c) = (m : ℂ) • a γ m ξ
      rw [c3 γ m ξ hξ c hc]
    · apply c4 γ m ξ hξ
      intro h0
      apply hne
      show (m : ℂ) • a γ m ξ = 0
      rw [h0, smul_zero]
    · obtain ⟨C, b, d, hC⟩ := c5 k
      refine ⟨(∑ n ∈ H, ‖(n : ℂ)‖ + 1) * C, b, d, fun γ m ξ hξ hX1 hX2 => ?_⟩
      have hb := hC γ m ξ hξ hX1 hX2
      obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b *
          Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) *
          Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := ⟨_, rfl⟩
      rw [← hRdef] at hb
      have hNB0 : 0 ≤ NB B.h (a γ m) k ξ := norm_nonneg _
      have hR0 : 0 ≤ R := le_trans hNB0 hb
      have hS0 : 0 ≤ ∑ n ∈ H, ‖(n : ℂ)‖ := Finset.sum_nonneg (fun n _ => norm_nonneg _)
      have hgoal : NB B.h (vInt5 a γ m) k ξ ≤ (∑ n ∈ H, ‖(n : ℂ)‖ + 1) * R := by
        by_cases hm : m ∈ H
        · have hcd : ContDiffAt ℝ k (a γ m) ξ :=
            ((c2 γ m).contDiffAt (hDo.mem_nhds hξ)).of_le (by exact_mod_cast le_top)
          have e : NB B.h (vInt5 a γ m) k ξ = ‖(m : ℂ)‖ * NB B.h (a γ m) k ξ := by
            unfold NB
            rw [show vInt5 a γ m = fun η => (m : ℂ) • a γ m η from rfl,
              iteratedFDeriv_const_smul_apply' hcd]
            rw [show ((m : ℂ) • iteratedFDeriv ℝ k (a γ m) ξ).compContinuousLinearMap
                (fun _ => Lnorm B.h ξ) = (m : ℂ) • (iteratedFDeriv ℝ k (a γ m) ξ).compContinuousLinearMap
                (fun _ => Lnorm B.h ξ) by ext v; simp]
            rw [norm_smul]
          rw [e]
          have hm1 : ‖(m : ℂ)‖ ≤ ∑ n ∈ H, ‖(n : ℂ)‖ :=
            Finset.single_le_sum (f := fun n : ℤ => ‖(n : ℂ)‖) (fun n _ => norm_nonneg _) hm
          exact mul_le_mul (by linarith) hb hNB0 (by linarith)
        · have e : vInt5 a γ m = a γ m := by
            funext η
            show (m : ℂ) • a γ m η = a γ m η
            rw [hHa γ m hm]; simp
          rw [e]
          nlinarith
      calc _ ≤ _ := hgoal
        _ = _ := by rw [hRdef]; ring

  have hCr : ∀ (α : ℝ) (a : WC) (N0 : Fin 3 → ℂ), InWg5 B G (qsOf l0) α a →
      InWg5 B G (qsOf l0) (α + 0) (vCr5 N0 a) := by
    intro α a N0 ha
    exact inWg5_cross_mult B G l0 hok α 0 a (fun _ _ _ => N0) ha
      (fun _ _ _ _ _ => contDiffAt_const) (fun _ _ _ _ _ _ _ => rfl)
      (fun k => ⟨‖N0‖, 0, fun γ m ξ _ _ _ _ => by rw [hsimp0]; exact hNBc N0 k ξ⟩)

  have hD1 : ∀ (γ : Lab) (ξ : Cyl), viscGood5 B G l0 γ ξ → ξ ∈ DomC B.h 1 := by
    intro γ ξ hg
    have h3 : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hg.2.2.1
    show 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < 1
    exact ⟨h3.1, h3.2.1, lt_of_lt_of_le h3.2.2 hq1⟩
  have hC5 : ∀ z : ℂ, viscFacOK5 B G l0 (vC5 z) 0 := by
    intro z
    refine ⟨fun γ ξ _ => ⟨?_, fun _ _ => rfl⟩, fun k => ⟨‖z‖, 0, fun γ ξ _ => ?_⟩⟩
    · show ContDiffAt ℝ ∞ (fun _ : Cyl => z) ξ
      exact contDiffAt_const
    · rw [hsimp0]; exact hNBc z k ξ
  have hQpow : ∀ (c β' : ℝ), B.h * β' = c →
      viscFacOK5 B G l0 (fun _ η => ((qC B.h η ^ c : ℝ) : ℂ)) β' := by
    intro c β' hc
    refine ⟨fun γ ξ hg => ⟨?_, fun c' _ => rfl⟩, fun k => ?_⟩
    · obtain ⟨C, hC⟩ := hF6 c 0
      exact (hC γ.1 ξ (hD1 γ ξ hg) hg.2.2.2.1 hg.2.2.2.2.1 hg.2.2.2.2.2.1).1.1
    · obtain ⟨C, hC⟩ := hF6 c k
      refine ⟨C, 0, fun γ ξ hg => ?_⟩
      have := (hC γ.1 ξ (hD1 γ ξ hg) hg.2.2.2.1 hg.2.2.2.2.1 hg.2.2.2.2.2.1).1.2
      rw [hc, Real.rpow_zero, mul_one]
      exact this
  have hS5 : viscFacOK5 B G l0 (vS5 B) (3 * (1 / (2 * B.h)) + 2) :=
    hQpow (2 * Aex B.h + 1/2) _ (by unfold Aex; linear_combination 3 * hu)
  have hqA : viscFacOK5 B G l0 (fun _ η => ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ)) (-(1 / (2 * B.h)) - 1) :=
    hQpow (-Aex B.h) _ (by unfold Aex; linear_combination (-1:ℝ) * hu)
  have hR5 : viscFacOK5 B G l0 vR5 0 := by
    refine ⟨fun γ ξ hg => ⟨?_, fun c' _ => rfl⟩, fun k => ?_⟩
    · obtain ⟨C, hC⟩ := hF6 0 0
      exact (hC γ.1 ξ (hD1 γ ξ hg) hg.2.2.2.1 hg.2.2.2.2.1 hg.2.2.2.2.2.1).2.1.1
    · obtain ⟨C, hC⟩ := hF6 0 k
      refine ⟨C, 0, fun γ ξ hg => ?_⟩
      rw [hsimp0]
      exact (hC γ.1 ξ (hD1 γ ξ hg) hg.2.2.2.1 hg.2.2.2.2.1 hg.2.2.2.2.2.1).2.1.2
  have hQ5 : viscFacOK5 B G l0 vQ5 (-(1 / (2 * B.h))) := by
    refine ⟨fun γ ξ hg => ⟨?_, fun c' _ => rfl⟩, fun k => ?_⟩
    · show ContDiffAt ℝ ∞ (fun _ : Cyl => (((Real.sqrt (Qb γ.1))⁻¹ : ℝ) : ℂ)) ξ
      exact contDiffAt_const
    · obtain ⟨C, hC⟩ := hF6 0 k
      refine ⟨2, 0, fun γ ξ hg => ?_⟩
      rw [show B.h * -(1 / (2 * B.h)) = -(1/2 : ℝ) by linear_combination (-1:ℝ) * hu,
        Real.rpow_zero, mul_one]
      exact (hC γ.1 ξ (hD1 γ ξ hg) hg.2.2.2.1 hg.2.2.2.2.1 hg.2.2.2.2.2.1).2.2.1
  have hK5 : viscFacOK5 B G l0 (vK5 B) (-(1/2)) := by
    refine ⟨fun γ ξ hg => ⟨?_, fun c' _ => rfl⟩, fun k => ?_⟩
    · show ContDiffAt ℝ ∞ (fun _ : Cyl => ((((kb B.h γ.1 : ℕ) : ℝ)) : ℂ)) ξ
      exact contDiffAt_const
    · obtain ⟨C, hC⟩ := hF6 0 k
      refine ⟨4, 0, fun γ ξ hg => ?_⟩
      rw [show B.h * -(1/2 : ℝ) = -(B.h / 2) by ring, Real.rpow_zero, mul_one]
      exact (hC γ.1 ξ (hD1 γ ξ hg) hg.2.2.2.1 hg.2.2.2.2.1 hg.2.2.2.2.2.1).2.2.2
  have hN5 : ∀ i : Fin 3, viscFacOK5 B G l0 (vN5 B G i) 0 := by
    intro i
    refine ⟨fun γ ξ hg => ⟨?_, fun c' hc' => ?_⟩, fun k => ?_⟩
    · obtain ⟨C, hC⟩ := hN 0
      exact (hC l0 (by omega) γ ξ hg i).1
    · obtain ⟨C, hC⟩ := hN 0
      show ((nPhi5 B G γ (shY ξ c') i : ℝ) : ℂ) = ((nPhi5 B G γ ξ i : ℝ) : ℂ)
      rw [(hC l0 (by omega) γ ξ hg i).2.1 c' hc']
    · obtain ⟨C, hC⟩ := hN k
      refine ⟨C, 1, fun γ ξ hg => ?_⟩
      rw [mul_zero, Real.rpow_zero, mul_one, Real.rpow_one]
      exact (hC l0 (by omega) γ ξ hg i).2.2
  have hD5 : viscFacOK5 B G l0 (vD5 B G) (-(2 * (1 / (2 * B.h))) - kapS) := by
    refine ⟨fun γ ξ hg => ⟨?_, fun c' hc' => ?_⟩, fun k => ?_⟩
    · obtain ⟨C, hC⟩ := hD 0
      exact (hC l0 (by omega) γ ξ hg).1
    · obtain ⟨C, hC⟩ := hD 0
      show ((dvF5 B G γ (shY ξ c') : ℝ) : ℂ) = ((dvF5 B G γ ξ : ℝ) : ℂ)
      rw [(hC l0 (by omega) γ ξ hg).2.1 c' hc']
    · obtain ⟨C, hC⟩ := hD k
      refine ⟨C, 1, fun γ ξ hg => ?_⟩
      rw [show B.h * (-(2 * (1 / (2 * B.h))) - kapS) = -(1 + B.h * kapS) by
        linear_combination (-2:ℝ) * hu, Real.rpow_one]
      exact (hC l0 (by omega) γ ξ hg).2.2

  have ha : InWg5 B G (qsOf l0) (β + (-(1 / (2 * B.h)) - 1)) (viscA5 B w) := SM _ _ w _ hw hqA
  have hRa : InWg5 B G (qsOf l0) (β + (-(1 / (2 * B.h)) - 1) - 1 / (2 * B.h) - kapS)
      (vDR5 B (viscA5 B w)) := hR l0 (by omega) _ _ ha
  have hRRa : InWg5 B G (qsOf l0) (β + (-(1 / (2 * B.h)) - 1) - 1 / (2 * B.h) - kapS - 1 / (2 * B.h) - kapS)
      (vDR5 B (vDR5 B (viscA5 B w))) := hR l0 (by omega) _ _ hRa
  have hZa : InWg5 B G (qsOf l0) (β + (-(1 / (2 * B.h)) - 1) - 1 / (2 * B.h))
      (vDZ5 (viscA5 B w)) := hZ l0 (by omega) _ _ ha
  have hZZa : InWg5 B G (qsOf l0) (β + (-(1 / (2 * B.h)) - 1) - 1 / (2 * B.h) - 1 / (2 * B.h))
      (vDZ5 (vDZ5 (viscA5 B w))) := hZ l0 (by omega) _ _ hZa
  have T1 := hW _ _ (β + 1/2 - 3 * kapS) (by linarith) (SM _ _ _ _ (SM _ _ _ _ hRRa hS5) (hC5 (-1)))
  have T2 := hW _ _ (β + 1/2 - 3 * kapS) (by linarith)
    (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ hRa hQ5) hR5) hS5) (hC5 (-1)))
  have T3 := hW _ _ (β + 1/2 - 3 * kapS) (by linarith) (SM _ _ _ _ (SM _ _ _ _ hZZa hS5) (hC5 (-1)))
  have T4 := hW _ _ (β + 1/2 - 3 * kapS) (by linarith)
    (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (hInt _ _ hRa) hQ5) (hN5 0)) hK5) hS5)
      (hC5 (-2 * Complex.I)))
  have T5 := hW _ _ (β + 1/2 - 3 * kapS) (by linarith)
    (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (hInt _ _ hZa) hQ5) (hN5 2)) hK5) hS5)
      (hC5 (-2 * Complex.I)))
  have T6 := hW _ _ (β + 1/2 - 3 * kapS) (by linarith)
    (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (hInt _ _ ha) hD5) hK5) hS5) (hC5 (-Complex.I)))
  have T7 := hW _ _ (β + 1/2 - 3 * kapS) (by linarith)
    (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _
      (hCr _ _ ![0, 0, 1] (hCr _ _ ![0, 0, 1] ha)) hQ5) hQ5) hR5) hR5) hS5) (hC5 (-1)))
  have T8 := hW _ _ (β + 1/2 - 3 * kapS) (by linarith)
    (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _ (SM _ _ _ _
      (hCr _ _ ![0, 0, -1] (hInt _ _ ha)) hQ5) hQ5) hR5) (hN5 1)) hK5) hS5) (hC5 (2 * Complex.I)))

  have addc : ∀ f g : WC, InWg5 B G (qsOf l0) (β + 1/2 - 3 * kapS) f →
      InWg5 B G (qsOf l0) (β + 1/2 - 3 * kapS) g → InWg5 B G (qsOf l0) (β + 1/2 - 3 * kapS) (f + g) := by
    intro f g hf hg
    have := (pwr5_waveV_add B G hok (qsOf l0) hq1 f g _ _ hf hg).1
    rwa [min_self] at this
  have hSum : InWg5 B G (qsOf l0) (β + 1/2 - 3 * kapS) (visc5Terms B G w) :=
    addc _ _ (addc _ _ (addc _ _ (addc _ _ (addc _ _ (addc _ _ (addc _ _ T1 T2) T3) T4) T5) T6) T7) T8
  have hsplit := visc5_split_v5 B G (qsOf l0) w hok hw.2.1
  have hdR0 : dR B.h (fun _ : Cyl => (0 : ℂ)) = fun _ => 0 := by
    funext ξ; simp [dR]
  have hdZ0 : dZ (fun _ : Cyl => (0 : ℂ)) = fun _ => 0 := by
    funext ξ; simp [dZ]
  obtain ⟨c1, c2, c3, c4, c5⟩ := hSum
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · obtain ⟨H, hH0, hHw⟩ := hw.1
    refine ⟨H, hH0, fun γ m hm => ?_⟩
    have h0 : viscA5 B w γ m = fun _ => 0 := by
      funext η
      simp [viscA5, hHw γ m hm]
    funext ξ
    ext i
    fin_cases i <;> simp [remVisc5, h0, hdR0, hdZ0]
  · intro γ m
    exact (c2 γ m).congr (fun ξ hξ => hsplit γ m ξ hξ)
  · intro γ m ξ hξ c hc
    have hsh : shY ξ c ∈ DomC B.h (qsOf l0) := hξ
    rw [hsplit γ m _ hsh, hsplit γ m ξ hξ]
    exact c3 γ m ξ hξ c hc
  · intro γ m ξ hξ hne
    apply c4 γ m ξ hξ
    rwa [← hsplit γ m ξ hξ]
  · intro k
    obtain ⟨C, b, d, hC⟩ := c5 k
    refine ⟨C, b, d, fun γ m ξ hξ hX1 hX2 => ?_⟩
    have hev : remVisc5 B G (viscA5 B w) γ m =ᶠ[nhds ξ] visc5Terms B G w γ m :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => hsplit γ m η hη)
    have hb := hC γ m ξ hξ hX1 hX2
    unfold NB at hb ⊢
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    exact hb

theorem inWg5_mat_mult_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ), B.ok → ∀ (α β : ℝ) (a : WC) (M : Lab → ℤ → Cyl → Matrix (Fin 3) (Fin 3) ℝ), InWg5 B G (qsOf l0) α a → (∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (a γ m) → ∀ i j : Fin 3, ContDiffAt ℝ ∞ (fun η => M γ m η i j) ξ) → (∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), a γ m ξ ≠ 0 → ∀ c : ℝ × ℝ, IsDeck B.h (qC B.h ξ) c → M γ m (shY ξ c) = M γ m ξ) → (∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (a γ m) → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ i j : Fin 3, NB B.h (fun η => M γ m η i j) k ξ ≤ C * qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ b) → InWg5 B G (qsOf l0) (α + β) (fun γ m ξ => (pulseMatC (M γ m ξ)).mulVec (a γ m ξ)) :=
by
  intro B G l0 hok α β a M ha hsm hdeck hbd

  obtain ⟨Bl, hBl⟩ : ∃ Bl : Fin 3 × Fin 3 → ℝ →L[ℝ] (Fin 3 → ℂ) →L[ℝ] (Fin 3 → ℂ),
      ∀ p s v, Bl p s v = fun t => if t = p.1 then (s : ℂ) * v p.2 else 0 := by
    refine ⟨fun p => LinearMap.toContinuousLinearMap
      ((LinearMap.toContinuousLinearMap : ((Fin 3 → ℂ) →ₗ[ℝ] (Fin 3 → ℂ)) ≃ₗ[ℝ]
        ((Fin 3 → ℂ) →L[ℝ] (Fin 3 → ℂ))).toLinearMap ∘ₗ
        LinearMap.mk₂ ℝ (fun (s : ℝ) (v : Fin 3 → ℂ) => fun t => if t = p.1 then (s : ℂ) * v p.2 else 0)
          (fun s1 s2 v => by
            funext t; by_cases ht : t = p.1 <;> simp [ht] <;> ring)
          (fun c s v => by
            funext t; by_cases ht : t = p.1 <;> simp [ht, Complex.real_smul] <;> ring)
          (fun s v1 v2 => by
            funext t; by_cases ht : t = p.1 <;> simp [ht] <;> ring)
          (fun c s v => by
            funext t; by_cases ht : t = p.1 <;> simp [ht, Complex.real_smul] <;> ring)),
      fun p s v => rfl⟩
  have hmv : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (v : Fin 3 → ℂ),
      (pulseMatC A).mulVec v = ∑ p, Bl p (A p.1 p.2) v := by
    intro A v
    funext t
    rw [Finset.sum_apply]
    simp only [hBl]
    fin_cases t <;>
      simp [Matrix.mulVec, dotProduct, pulseMatC, Fintype.sum_prod_type, Fin.sum_univ_three]
  have hz : ∀ A : Matrix (Fin 3) (Fin 3) ℝ, (pulseMatC A).mulVec (0 : Fin 3 → ℂ) = 0 :=
    fun A => Matrix.mulVec_zero _
  have hP : ∀ (γ : Lab) (m : ℤ), (fun ξ => (pulseMatC (M γ m ξ)).mulVec (a γ m ξ)) =
      fun η => ∑ p, Bl p (M γ m η p.1 p.2) (a γ m η) := by
    intro γ m; funext ξ; exact hmv _ _

  have hLeib : ∀ (f : Fin 3 × Fin 3 → Cyl → ℝ) (g : Cyl → (Fin 3 → ℂ)) (U : Set Cyl) (ξ : Cyl) (k : ℕ),
      IsOpen U → ξ ∈ U → (∀ p, ContDiffOn ℝ k (f p) U) → ContDiffOn ℝ k g U →
      NB B.h (fun η => ∑ p, Bl p (f p η) (g η)) k ξ ≤
        ∑ p, ‖Bl p‖ * ∑ i ∈ Finset.range (k + 1),
          (k.choose i : ℝ) * NB B.h (f p) i ξ * NB B.h g (k - i) ξ := by
    intro f g U ξ k hU hξ hf hg
    unfold NB
    generalize Lnorm B.h ξ = L
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
    have hsm' : ∀ {Y : Type} [NormedAddCommGroup Y] [NormedSpace ℝ Y] (F : Cyl → Y),
        ContDiffOn ℝ k F U → ContDiffOn ℝ k (fun z => F (ξ + z)) s := by
      intro Y _ _ F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ {Y : Type} [NormedAddCommGroup Y] [NormedSpace ℝ Y] (F : Cyl → Y),
        ContDiffOn ℝ k F U → ContDiffOn ℝ k (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
      intro Y _ _ F hF
      exact (hsm' F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
    have key : ∀ {Y : Type} [NormedAddCommGroup Y] [NormedSpace ℝ Y] (F : Cyl → Y),
        ContDiffOn ℝ k F U → ∀ i : ℕ, i ≤ k →
        iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
          (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
      intro Y _ _ F hF i hi
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm' F hF) hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
      calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
              (fun _ => L) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
              (fun _ => L) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
              (fun _ => L) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
    have hfg : ContDiffOn ℝ k (fun η => ∑ p, Bl p (f p η) (g η)) U :=
      ContDiffOn.sum (fun p _ => (contDiffOn_const.clm_apply (hf p)).clm_apply hg)
    have hT : ∀ p, ContDiffOn ℝ k (fun z => Bl p (f p (ξ + L z)) (g (ξ + L z))) (⇑L ⁻¹' s) :=
      fun p => (contDiffOn_const.clm_apply (hsmO _ (hf p))).clm_apply (hsmO _ hg)
    have hsumeq : (fun z => (fun η => ∑ p, Bl p (f p η) (g η)) (ξ + L z)) =
        ∑ p, (fun z => Bl p (f p (ξ + L z)) (g (ξ + L z))) := by
      funext z; simp only [Finset.sum_apply]
    have hdist : iteratedFDerivWithin ℝ k (∑ p, (fun z => Bl p (f p (ξ + L z)) (g (ξ + L z))))
        (⇑L ⁻¹' s) 0 =
        ∑ p, iteratedFDerivWithin ℝ k (fun z => Bl p (f p (ξ + L z)) (g (ξ + L z))) (⇑L ⁻¹' s) 0 :=
      iteratedFDerivWithin_sum_apply hO.uniqueDiffOn h0O (fun p _ => (hT p) 0 h0O)
    have hper : ∀ p, ‖iteratedFDerivWithin ℝ k (fun z => Bl p (f p (ξ + L z)) (g (ξ + L z)))
        (⇑L ⁻¹' s) 0‖ ≤ ‖Bl p‖ * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) *
          ‖(iteratedFDeriv ℝ i (f p) ξ).compContinuousLinearMap (fun _ => L)‖ *
          ‖(iteratedFDeriv ℝ (k - i) g ξ).compContinuousLinearMap (fun _ => L)‖ := by
      intro p
      have leib := (Bl p).norm_iteratedFDerivWithin_le_of_bilinear (hsmO _ (hf p)) (hsmO _ hg)
        hO.uniqueDiffOn h0O (n := k) le_rfl
      refine le_trans leib (le_of_eq ?_)
      congr 1
      apply Finset.sum_congr rfl
      intro i hi
      have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      rw [iteratedFDerivWithin_of_isOpen (f := fun z => f p (ξ + L z)) i hO h0O,
        iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (k - i) hO h0O,
        key (f p) (hf p) i hik, key g hg (k - i) (Nat.sub_le k i)]
    rw [← key _ hfg k le_rfl, hsumeq, ← iteratedFDerivWithin_of_isOpen k hO h0O, hdist]
    exact le_trans (norm_sum_le _ _) (Finset.sum_le_sum (fun p _ => hper p))

  have hh0 : 0 ≤ B.h := hok.2.1.1.le
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hDq : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 ∧ 1 ≤ SC B.h ξ := by
    have hqs1 : qsOf l0 ≤ 1 := by
      show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
      exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
    intro ξ hξ
    obtain ⟨-, e2, e3⟩ := hξ
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    refine ⟨hq0, by linarith, ?_⟩
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hEdge : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X ∧
      0 < edgeDist B.Xa B.Xb X ∧ edgeDist B.Xa B.Xb X ≤ 1 := by
    intro X e1 e2
    refine ⟨?_, ?_, min_le_left _ _⟩
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · have hX : 0 < X := lt_trans hXa e1
      have l1 : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr e1)
      have l2 : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX).mpr e2)
      exact lt_min one_pos (lt_min l1 l2)
  obtain ⟨⟨H, H0, Hv⟩, sa, da, pa, ba⟩ := ha
  choose CN bN hN using hbd
  choose Ca bA dA hA using ba

  have comb : ∀ (k : ℕ) (q S E e P K : ℝ) (nN na : ℕ → ℝ), 0 < q → 1 ≤ S → 0 ≤ E → 0 < e →
      e ≤ 1 → 0 ≤ P → 0 ≤ K → (∀ i, 0 ≤ nN i) → (∀ j, 0 ≤ na j) →
      (∀ i, i ≤ k → nN i ≤ CN i * q ^ (B.h * β) * S ^ (bN i)) →
      (∀ j, j ≤ k → na j ≤ Ca j * q ^ (B.h * α) * S ^ (bA j) * E * e ^ (-(dA j)) * P) →
      K * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * nN i * na (k - i) ≤
        (K * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |CN i| * |Ca (k - i)|) *
          q ^ (B.h * (α + β)) *
          S ^ ((∑ j ∈ Finset.range (k + 1), |bN j|) + ∑ j ∈ Finset.range (k + 1), |bA j|) * E *
          e ^ (-(∑ j ∈ Finset.range (k + 1), |dA j|)) * P := by
    intro k q S E e P K nN na hq hS hE he0 he1 hP0 hK hnN hna hbN hba
    have hS0 : 0 < S := by linarith
    obtain ⟨X, hXdef⟩ : ∃ X : ℝ, X = q ^ (B.h * (α + β)) *
        S ^ ((∑ j ∈ Finset.range (k + 1), |bN j|) + ∑ j ∈ Finset.range (k + 1), |bA j|) * E *
        e ^ (-(∑ j ∈ Finset.range (k + 1), |dA j|)) * P := ⟨_, rfl⟩
    have hterm : ∀ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * nN i * na (k - i) ≤
        (k.choose i : ℝ) * |CN i| * |Ca (k - i)| * X := by
      intro i hi
      have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hjk : k - i ≤ k := Nat.sub_le k i
      have hj : k - i ∈ Finset.range (k + 1) := Finset.mem_range.mpr (by omega)
      have pq1 : 0 ≤ q ^ (B.h * β) := Real.rpow_nonneg hq.le _
      have pq2 : 0 ≤ q ^ (B.h * α) := Real.rpow_nonneg hq.le _
      have pS1 : 0 ≤ S ^ (bN i) := Real.rpow_nonneg hS0.le _
      have pS2 : 0 ≤ S ^ (bA (k - i)) := Real.rpow_nonneg hS0.le _
      have pe : 0 ≤ e ^ (-(dA (k - i))) := Real.rpow_nonneg he0.le _
      have hA1 : 0 ≤ q ^ (B.h * β) * S ^ (bN i) := mul_nonneg pq1 pS1
      have hA2 : 0 ≤ q ^ (B.h * α) * S ^ (bA (k - i)) * E * e ^ (-(dA (k - i))) * P :=
        mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg pq2 pS2) hE) pe) hP0
      have a1 : nN i ≤ |CN i| * (q ^ (B.h * β) * S ^ (bN i)) := by
        refine le_trans (hbN i hik) ?_
        rw [mul_assoc]
        exact mul_le_mul_of_nonneg_right (le_abs_self _) hA1
      have a2 : na (k - i) ≤
          |Ca (k - i)| * (q ^ (B.h * α) * S ^ (bA (k - i)) * E * e ^ (-(dA (k - i))) * P) := by
        refine le_trans (hba (k - i) hjk) ?_
        have : Ca (k - i) * q ^ (B.h * α) * S ^ (bA (k - i)) * E * e ^ (-(dA (k - i))) * P =
            Ca (k - i) * (q ^ (B.h * α) * S ^ (bA (k - i)) * E * e ^ (-(dA (k - i))) * P) := by
          ring
        rw [this]
        exact mul_le_mul_of_nonneg_right (le_abs_self _) hA2
      have a3 : nN i * na (k - i) ≤ (|CN i| * (q ^ (B.h * β) * S ^ (bN i))) *
          (|Ca (k - i)| * (q ^ (B.h * α) * S ^ (bA (k - i)) * E * e ^ (-(dA (k - i))) * P)) :=
        mul_le_mul a1 a2 (hna _) (mul_nonneg (abs_nonneg _) hA1)
      have hbsum : bN i + bA (k - i) ≤
          (∑ j ∈ Finset.range (k + 1), |bN j|) + ∑ j ∈ Finset.range (k + 1), |bA j| := by
        have s1 : |bN i| ≤ ∑ j ∈ Finset.range (k + 1), |bN j| :=
          Finset.single_le_sum (f := fun j => |bN j|) (fun j _ => abs_nonneg _) hi
        have s2 : |bA (k - i)| ≤ ∑ j ∈ Finset.range (k + 1), |bA j| :=
          Finset.single_le_sum (f := fun j => |bA j|) (fun j _ => abs_nonneg _) hj
        linarith [le_abs_self (bN i), le_abs_self (bA (k - i))]
      have hdsum : dA (k - i) ≤ ∑ j ∈ Finset.range (k + 1), |dA j| := by
        have s3 : |dA (k - i)| ≤ ∑ j ∈ Finset.range (k + 1), |dA j| :=
          Finset.single_le_sum (f := fun j => |dA j|) (fun j _ => abs_nonneg _) hj
        linarith [le_abs_self (dA (k - i))]
      have f1 : S ^ (bN i + bA (k - i)) ≤
          S ^ ((∑ j ∈ Finset.range (k + 1), |bN j|) + ∑ j ∈ Finset.range (k + 1), |bA j|) :=
        Real.rpow_le_rpow_of_exponent_le hS hbsum
      have f2 : e ^ (-(dA (k - i))) ≤ e ^ (-(∑ j ∈ Finset.range (k + 1), |dA j|)) :=
        Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hdsum)
      have eq1 : q ^ (B.h * β) * q ^ (B.h * α) = q ^ (B.h * (α + β)) := by
        rw [← Real.rpow_add hq]; congr 1; ring
      have pQ : 0 ≤ q ^ (B.h * (α + β)) := Real.rpow_nonneg hq.le _
      have a4 : (q ^ (B.h * β) * S ^ (bN i)) *
          (q ^ (B.h * α) * S ^ (bA (k - i)) * E * e ^ (-(dA (k - i))) * P) ≤ X := by
        calc (q ^ (B.h * β) * S ^ (bN i)) *
              (q ^ (B.h * α) * S ^ (bA (k - i)) * E * e ^ (-(dA (k - i))) * P)
            = (q ^ (B.h * β) * q ^ (B.h * α)) * (S ^ (bN i) * S ^ (bA (k - i))) * E *
                e ^ (-(dA (k - i))) * P := by ring
          _ = q ^ (B.h * (α + β)) * S ^ (bN i + bA (k - i)) * E * e ^ (-(dA (k - i))) * P := by
              rw [eq1, ← Real.rpow_add hS0]
          _ ≤ X := by
              rw [hXdef]
              apply mul_le_mul_of_nonneg_right _ hP0
              apply mul_le_mul _ f2 pe
                (mul_nonneg (mul_nonneg pQ (Real.rpow_nonneg hS0.le _)) hE)
              apply mul_le_mul_of_nonneg_right _ hE
              exact mul_le_mul_of_nonneg_left f1 pQ
      have hc : (0 : ℝ) ≤ (k.choose i : ℝ) := Nat.cast_nonneg _
      calc (k.choose i : ℝ) * nN i * na (k - i) = (k.choose i : ℝ) * (nN i * na (k - i)) := by ring
        _ ≤ (k.choose i : ℝ) * ((|CN i| * (q ^ (B.h * β) * S ^ (bN i))) *
            (|Ca (k - i)| * (q ^ (B.h * α) * S ^ (bA (k - i)) * E * e ^ (-(dA (k - i))) * P))) :=
            mul_le_mul_of_nonneg_left a3 hc
        _ = (k.choose i : ℝ) * |CN i| * |Ca (k - i)| * ((q ^ (B.h * β) * S ^ (bN i)) *
            (q ^ (B.h * α) * S ^ (bA (k - i)) * E * e ^ (-(dA (k - i))) * P)) := by ring
        _ ≤ (k.choose i : ℝ) * |CN i| * |Ca (k - i)| * X :=
            mul_le_mul_of_nonneg_left a4
              (mul_nonneg (mul_nonneg hc (abs_nonneg _)) (abs_nonneg _))
    calc K * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * nN i * na (k - i)
        ≤ K * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |CN i| * |Ca (k - i)| * X :=
          mul_le_mul_of_nonneg_left (Finset.sum_le_sum hterm) hK
      _ = _ := by rw [← Finset.sum_mul, hXdef]; ring

  have hV : ∀ (γ : Lab) (m : ℤ) (ξ : Cyl), ξ ∉ tsupport (a γ m) →
      (fun η => (pulseMatC (M γ m η)).mulVec (a γ m η)) =ᶠ[nhds ξ] fun _ => (0 : Fin 3 → ℂ) := by
    intro γ m ξ hξ
    have h1 := (notMem_tsupport_iff_eventuallyEq).1 hξ
    exact h1.mono (fun η hη => by
      show (pulseMatC (M γ m η)).mulVec (a γ m η) = 0
      rw [hη]
      exact hz _)
  have hKn : 0 ≤ ∑ p, ‖Bl p‖ := Finset.sum_nonneg (fun p _ => ContinuousLinearMap.opNorm_nonneg _)
  refine ⟨⟨H, H0, fun γ m hm => ?_⟩, fun γ m => ?_, fun γ m ξ hξ c hc => ?_,
    fun γ m ξ hξ hne => ?_, fun k => ?_⟩
  · funext ξ
    show (pulseMatC (M γ m ξ)).mulVec (a γ m ξ) = 0
    rw [Hv γ m hm]
    exact hz _
  · intro ξ hξ
    apply ContDiffAt.contDiffWithinAt
    by_cases hts : ξ ∈ tsupport (a γ m)
    · have ha' := (sa γ m).contDiffAt (hDopen.mem_nhds hξ)
      show ContDiffAt ℝ ∞ (fun η => (pulseMatC (M γ m η)).mulVec (a γ m η)) ξ
      rw [hP γ m]
      exact ContDiffAt.sum (fun p _ =>
        (contDiffAt_const.clm_apply (hsm γ m ξ hξ hts p.1 p.2)).clm_apply ha')
    · exact contDiffAt_const.congr_of_eventuallyEq (hV γ m ξ hts)
  · show (pulseMatC (M γ m (shY ξ c))).mulVec (a γ m (shY ξ c)) =
      (pulseMatC (M γ m ξ)).mulVec (a γ m ξ)
    rw [da γ m ξ hξ c hc]
    by_cases h0 : a γ m ξ = 0
    · rw [h0, hz, hz]
    · rw [hdeck γ m ξ hξ h0 c hc]
  · apply pa γ m ξ hξ
    intro h0
    apply hne
    show (pulseMatC (M γ m ξ)).mulVec (a γ m ξ) = 0
    rw [h0]
    exact hz _
  · refine ⟨(∑ p, ‖Bl p‖) * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |CN i| * |Ca (k - i)|,
      (∑ j ∈ Finset.range (k + 1), |bN j|) + ∑ j ∈ Finset.range (k + 1), |bA j|,
      ∑ j ∈ Finset.range (k + 1), |dA j|, fun γ m ξ hξ hX1 hX2 => ?_⟩
    obtain ⟨hq0, hq1, hS1⟩ := hDq ξ hξ
    obtain ⟨hE, he0, he1⟩ := hEdge _ hX1 hX2
    have hPv : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
      unfold Penv5
      exact (Real.exp_pos _).le
    show NB B.h (fun η => (pulseMatC (M γ m η)).mulVec (a γ m η)) k ξ ≤ _
    by_cases hts : ξ ∈ tsupport (a γ m)
    · have hMk : ∀ p : Fin 3 × Fin 3, ∀ᶠ y in nhds ξ, ContDiffAt ℝ k (fun η => M γ m η p.1 p.2) y :=
        fun p => ((hsm γ m ξ hξ hts p.1 p.2).of_le (by exact_mod_cast le_top)).eventually (by simp)
      have hall : ∀ᶠ y in nhds ξ, ∀ p : Fin 3 × Fin 3, ContDiffAt ℝ k (fun η => M γ m η p.1 p.2) y :=
        Filter.eventually_all.2 hMk
      obtain ⟨O, hOsub, hOopen, hξO⟩ := mem_nhds_iff.mp (Filter.inter_mem hall (hDopen.mem_nhds hξ))
      have hMO : ∀ p : Fin 3 × Fin 3, ContDiffOn ℝ k (fun η => M γ m η p.1 p.2) O :=
        fun p y hy => ((hOsub hy).1 p).contDiffWithinAt
      have haO : ContDiffOn ℝ k (a γ m) O :=
        ((sa γ m).of_le (by exact_mod_cast le_top)).mono (fun x hx => (hOsub hx).2)
      have hL := hLeib (fun p η => M γ m η p.1 p.2) (a γ m) O ξ k hOopen hξO hMO haO
      rw [hP γ m]
      refine le_trans hL ?_
      obtain ⟨Wt, hWt⟩ : ∃ Wt : ℝ, Wt = qC B.h ξ ^ (B.h * (α + β)) *
          SC B.h ξ ^ ((∑ j ∈ Finset.range (k + 1), |bN j|) + ∑ j ∈ Finset.range (k + 1), |bA j|) *
          Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
          edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(∑ j ∈ Finset.range (k + 1), |dA j|)) *
          Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := ⟨_, rfl⟩
      obtain ⟨Sg, hSg⟩ : ∃ Sg : ℝ,
          Sg = ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |CN i| * |Ca (k - i)| := ⟨_, rfl⟩
      have hcomb : ∀ p : Fin 3 × Fin 3, ‖Bl p‖ * ∑ i ∈ Finset.range (k + 1),
          (k.choose i : ℝ) * NB B.h (fun η => M γ m η p.1 p.2) i ξ * NB B.h (a γ m) (k - i) ξ ≤
          ‖Bl p‖ * (Sg * Wt) := by
        intro p
        refine le_trans (comb k (qC B.h ξ) (SC B.h ξ)
          (Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)))
          (edgeDist B.Xa B.Xb (XC B.h ξ)) (Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) ‖Bl p‖
          (fun i => NB B.h (fun η => M γ m η p.1 p.2) i ξ) (fun j => NB B.h (a γ m) j ξ) hq0 hS1
          (Real.sqrt_nonneg _) he0 he1 hPv (ContinuousLinearMap.opNorm_nonneg _)
          (fun i => norm_nonneg _) (fun j => norm_nonneg _)
          (fun i _ => hN i γ m ξ hξ hts hX1 hX2 p.1 p.2) (fun j _ => hA j γ m ξ hξ hX1 hX2))
          (le_of_eq ?_)
        rw [hWt, hSg]; ring
      calc _ ≤ ∑ p : Fin 3 × Fin 3, ‖Bl p‖ * (Sg * Wt) := Finset.sum_le_sum (fun p _ => hcomb p)
        _ = (∑ p : Fin 3 × Fin 3, ‖Bl p‖) * (Sg * Wt) := (Finset.sum_mul _ _ _).symm
        _ = _ := by rw [hWt, hSg]; ring
    · have hev := hV γ m ξ hts
      have h0 : NB B.h (fun η => (pulseMatC (M γ m η)).mulVec (a γ m η)) k ξ = 0 := by
        unfold NB
        rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_zero]
        have e : ((0 : Cyl → ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) (Fin 3 → ℂ)) ξ
            ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) = 0 := by
          ext m
          simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
        rw [e, norm_zero]
      rw [h0]
      have hC0 : 0 ≤ (∑ p, ‖Bl p‖) *
          ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |CN i| * |Ca (k - i)| :=
        mul_nonneg hKn (Finset.sum_nonneg (fun i _ =>
          mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (abs_nonneg _)) (abs_nonneg _)))
      exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hC0
        (Real.rpow_nonneg hq0.le _)) (Real.rpow_nonneg (by linarith) _)) (Real.sqrt_nonneg _))
        (Real.rpow_nonneg he0.le _)) hPv

theorem ubase_nb_v5 : ∀ (B : BG), B.ok → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => ubase B η i) (DomC B.h (qsOf l0))) ∧ ∀ k : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ j : ℕ, j ≤ k → NB B.h (fun η => ubase B η 0) j ξ ≤ C * qC B.h ξ ^ (-(1/2 : ℝ)) ∧ NB B.h (fun η => ubase B η 1) j ξ ≤ C * qC B.h ξ ^ (-Aex B.h) ∧ NB B.h (fun η => ubase B η 2) j ξ ≤ C * qC B.h ξ ^ (-Aex B.h) :=
by
  intro B hok
  have hh0 : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -, hqB0, -⟩ := hok.2.1
  have hXb : 0 < B.Xb := by linarith
  have hSN : SimNorm B.h := simscale_normalized_v4 B.h hh0 hh1 hok.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs0 : 0 < qsOf l0 := by rw [hQb]; positivity
  have hqs1 : qsOf l0 ≤ 1 := by rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  obtain ⟨hDo, -, hqpos, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hDsub : DomC B.h (qsOf l0) ⊆ DomC B.h B.qB :=
    fun ξ hξ => ⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqsB⟩

  have hrep : ∀ ξ ∈ DomC B.h B.qB,
      ubase B ξ 0 = qC B.h ξ ^ (-(1/2:ℝ)) * (2 * XC B.h ξ) ^ (-(1/2:ℝ)) *
          logLift B.Vb (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) ∧
      ubase B ξ 1 = qC B.h ξ ^ (-Aex B.h) * 1 *
          logLift B.Eb (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) ∧
      ubase B ξ 2 = qC B.h ξ ^ (-Aex B.h) * 1 *
          logLift B.Ub (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) := by
    intro ξ hξ
    obtain ⟨hr, ht, hqB⟩ := hξ
    obtain ⟨hS1, -⟩ := hok.1
    obtain ⟨-, -, -, -, -, hVel, -⟩ := hok.2
    have hτ : 0 < 1 - ξ.2.2.1 := by linarith
    have hq : 0 < qC B.h ξ := (hS1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
    have hx0 : (rotPt ξ.1 0 ξ.2.1) 0 = ξ.1 := by simp [rotPt]
    have hx1 : (rotPt ξ.1 0 ξ.2.1) 1 = 0 := by simp [rotPt]
    have hx2 : (rotPt ξ.1 0 ξ.2.1) 2 = ξ.2.1 := by simp [rotPt]
    set x := rotPt ξ.1 0 ξ.2.1 with hx
    have hsc : simScale B.h (x 2) (1 - ξ.2.2.1) = qC B.h ξ := by rw [hx2]; rfl
    have hrr : x 0 ^ 2 + x 1 ^ 2 = ξ.1 ^ 2 := by rw [hx0, hx1]; ring
    have hpos : 0 < x 0 ^ 2 + x 1 ^ 2 := by rw [hrr]; positivity
    have hsqrt : Real.sqrt (x 0 ^ 2 + x 1 ^ 2) = ξ.1 := by rw [hrr, Real.sqrt_sq hr.le]
    have hsimX : simX B.h x ξ.2.2.1 = XC B.h ξ := by
      unfold simX XC
      rw [hsc, hrr]
    have hsimEta : simEta B.h x ξ.2.2.1 = etaC B.h ξ := by
      unfold simEta etaC
      rw [hsc, hx2]
    have hmem : (x, ξ.2.2.1) ∈ simDomain B.h B.qB := by
      show ξ.2.2.1 < 1 ∧ simScale B.h (x 2) (1 - ξ.2.2.1) < B.qB
      rw [hsc]
      exact ⟨ht, hqB⟩
    obtain ⟨hE, hU, hV⟩ := hVel x ξ.2.2.1 hmem hpos
    rw [hsimX, hsimEta, hsc] at hV
    rw [hsimX, hsimEta, hsc] at hU
    rw [hsqrt, hsimX, hsimEta, hsc] at hE
    have hrad : rad x = ξ.1 := hsqrt
    have hb : ubase B ξ 0 = ξ.1⁻¹ * B.Vb (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) := by
      show inner ℝ (uB B x ξ.2.2.1) (frameAt 0 ξ 0) = _
      have hf : frameAt 0 ξ 0 = (rad x)⁻¹ • radVec x := rfl
      rw [hf, real_inner_smul_right, hrad]
      show ξ.1⁻¹ * inner ℝ (curl3 (fun w => B.AB w ξ.2.2.1) x + B.BvB x ξ.2.2.1) (radVec x) = _
      rw [hV]
    have hu1 : ubase B ξ 1 = qC B.h ξ ^ (-(1/2 + B.h)) * B.Eb (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) := by
      show inner ℝ (uB B x ξ.2.2.1) (frameAt 0 ξ 1) = _
      have hf : frameAt 0 ξ 1 = (rad x)⁻¹ • azVec x := rfl
      rw [hf, real_inner_smul_right, hrad]
      show ξ.1⁻¹ * inner ℝ (curl3 (fun w => B.AB w ξ.2.2.1) x + B.BvB x ξ.2.2.1) (azVec x) = _
      rw [hE, mul_assoc, inv_mul_cancel_left₀ hr.ne']
    have hu2 : ubase B ξ 2 = qC B.h ξ ^ (-(1/2 + B.h)) * B.Ub (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) := by
      have hz : ∀ v : ℝ³, inner ℝ v eZ = v 2 := by
        intro v; simp [eZ, EuclideanSpace.inner_single_right]
      show inner ℝ (uB B x ξ.2.2.1) (frameAt 0 ξ 2) = _
      have hf : frameAt 0 ξ 2 = eZ := rfl
      rw [hf, hz]
      show (curl3 (fun w => B.AB w ξ.2.2.1) x + B.BvB x ξ.2.2.1) 2 = _
      rw [hU]
    have hl : ∀ g : ℝ → ℝ → ℝ → ℝ, logLift g (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) =
        g (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) := by
      intro g; unfold logLift; rw [Real.exp_log hq]
    have h2X : 2 * XC B.h ξ = ξ.1 ^ 2 * (qC B.h ξ)⁻¹ := by
      unfold XC
      field_simp
    have hphi : (2 * XC B.h ξ) ^ (-(1/2:ℝ)) = ξ.1⁻¹ * qC B.h ξ ^ (1/2:ℝ) := by
      rw [h2X, Real.mul_rpow (by positivity) (by positivity), Real.inv_rpow hq.le,
        Real.rpow_neg (sq_nonneg _), Real.rpow_neg hq.le, inv_inv]
      have h12 : (ξ.1 ^ 2) ^ (1/2:ℝ) = ξ.1 := by rw [← Real.sqrt_eq_rpow, Real.sqrt_sq hr.le]
      rw [h12]
    have hhalf : qC B.h ξ ^ (-(1/2:ℝ)) * qC B.h ξ ^ (1/2:ℝ) = 1 := by
      rw [← Real.rpow_add hq]
      norm_num
    have hAx : Aex B.h = 1/2 + B.h := rfl
    refine ⟨?_, ?_, ?_⟩
    · rw [hb, hl, hphi]
      calc ξ.1⁻¹ * B.Vb (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ)
          = (qC B.h ξ ^ (-(1/2:ℝ)) * qC B.h ξ ^ (1/2:ℝ)) * ξ.1⁻¹ *
              B.Vb (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) := by rw [hhalf, one_mul]
        _ = _ := by ring
    · rw [hu1, hl, mul_one, hAx]
    · rw [hu2, hl, mul_one, hAx]

  have hφ : ContDiffOn ℝ ∞ (fun X : ℝ => (2 * X) ^ (-(1/2:ℝ))) (Set.Ioi 0) := by
    have h2 : ContDiffOn ℝ ∞ (fun X : ℝ => 2 * X) (Set.Ioi 0) :=
      contDiffOn_const.mul contDiffOn_id
    exact h2.rpow_const_of_ne (fun X hX => (mul_pos two_pos (Set.mem_Ioi.mp hX)).ne')
  have hφ1 : ContDiffOn ℝ ∞ (fun _ : ℝ => (1:ℝ)) (Set.Ioi 0) := contDiffOn_const
  have hP0 := qpow_profile_nb_v4 B (qsOf l0) hok hSN hqs0 hqs1 (fun X : ℝ => (2 * X) ^ (-(1/2:ℝ)))
    (-(1/2:ℝ)) hφ
  have hP1 := qpow_profile_nb_v4 B (qsOf l0) hok hSN hqs0 hqs1 (fun _ : ℝ => (1:ℝ))
    (-Aex B.h) hφ1
  obtain ⟨-, -, -, -, -, -, ⟨hEbS, hUbS, hVbS, hbd⟩, -⟩ := hok.2
  have hVbB : ∀ m : ℕ, ∃ C : ℝ, ∀ q X η : ℝ, 0 < q → q < B.qB → B.Xa ≤ X → X ≤ B.Xb →
      -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (logLift B.Vb) (Real.log q, X, η)‖ ≤ C := by
    intro m
    obtain ⟨C, hC⟩ := hbd B.Xa B.Xb hXa m
    exact ⟨C, fun q X η h1 h2 h3 h4 h5 h6 => (hC q X η h1 h2 h3 h4 h5 h6).2.2⟩
  have hUbB : ∀ m : ℕ, ∃ C : ℝ, ∀ q X η : ℝ, 0 < q → q < B.qB → B.Xa ≤ X → X ≤ B.Xb →
      -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (logLift B.Ub) (Real.log q, X, η)‖ ≤ C := by
    intro m
    obtain ⟨C, hC⟩ := outer_profile_bounds_v5 B hok m
    exact ⟨C, fun q X η h1 h2 h3 h4 h5 h6 =>
      (hC q X η h1 h2 (by linarith) (by linarith) h5 h6).2⟩
  have hEbB : ∀ m : ℕ, ∃ C : ℝ, ∀ q X η : ℝ, 0 < q → q < B.qB → B.Xa ≤ X → X ≤ B.Xb →
      -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (logLift B.Eb) (Real.log q, X, η)‖ ≤ C := by
    intro m
    obtain ⟨C, hC⟩ := outer_profile_bounds_v5 B hok m
    exact ⟨C, fun q X η h1 h2 h3 h4 h5 h6 =>
      (hC q X η h1 h2 (by linarith) (by linarith) h5 h6).1⟩
  have hΛV := bg_chart_nb_v5 B (logLift B.Vb) hok hVbS hVbB
  have hΛE := bg_chart_nb_v5 B (logLift B.Eb) hok hEbS hEbB
  have hΛU := bg_chart_nb_v5 B (logLift B.Ub) hok hUbS hUbB

  have hprod : ∀ (P L : Cyl → ℝ) (c : ℝ), ContDiffOn ℝ ∞ P (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ L (DomC B.h B.qB) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h P k ξ ≤ C * qC B.h ξ ^ c) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h B.qB, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h L k ξ ≤ C) →
      ∀ k : ℕ, ∃ K : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h (fun η => P η * L η) k ξ ≤ K * qC B.h ξ ^ c := by
    intro P L c hPs hLs hPb hLb k
    choose CP hCP using hPb
    choose CL hCL using hLb
    refine ⟨∑ j ∈ Finset.range (k + 1), (k.choose j : ℝ) * |CP j| * |CL (k - j)|,
      fun ξ hξ hX1 hX2 => ?_⟩
    have hq0 := hqpos ξ hξ
    have hQ : 0 ≤ qC B.h ξ ^ c := Real.rpow_nonneg hq0.le _
    have hLe := nb_mul_le_v4 B.h (DomC B.h (qsOf l0)) P L hDo hPs (hLs.mono hDsub) ξ hξ k
    refine le_trans hLe ?_
    rw [Finset.sum_mul]
    apply Finset.sum_le_sum
    intro j _
    have h1 : NB B.h P j ξ ≤ |CP j| * qC B.h ξ ^ c :=
      le_trans (hCP j ξ hξ hX1 hX2) (mul_le_mul_of_nonneg_right (le_abs_self _) hQ)
    have h2 : NB B.h L (k - j) ξ ≤ |CL (k - j)| :=
      le_trans (hCL (k - j) ξ (hDsub hξ) hX1 hX2) (le_abs_self _)
    have h0' : 0 ≤ NB B.h L (k - j) ξ := norm_nonneg _
    calc (k.choose j : ℝ) * NB B.h P j ξ * NB B.h L (k - j) ξ
        ≤ (k.choose j : ℝ) * (|CP j| * qC B.h ξ ^ c) * |CL (k - j)| := by
          apply mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) h2 h0'
            (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (abs_nonneg _) hQ))
      _ = (k.choose j : ℝ) * |CP j| * |CL (k - j)| * qC B.h ξ ^ c := by ring

  have hs0 : ContDiffOn ℝ ∞ (fun η => ubase B η 0) (DomC B.h (qsOf l0)) :=
    (hP0.1.mul (hΛV.1.mono hDsub)).congr (fun η hη => (hrep η (hDsub hη)).1)
  have hs1 : ContDiffOn ℝ ∞ (fun η => ubase B η 1) (DomC B.h (qsOf l0)) :=
    (hP1.1.mul (hΛE.1.mono hDsub)).congr (fun η hη => (hrep η (hDsub hη)).2.1)
  have hs2 : ContDiffOn ℝ ∞ (fun η => ubase B η 2) (DomC B.h (qsOf l0)) :=
    (hP1.1.mul (hΛU.1.mono hDsub)).congr (fun η hη => (hrep η (hDsub hη)).2.2)
  refine ⟨?_, fun k => ?_⟩
  · intro i
    fin_cases i
    · exact hs0
    · exact hs1
    · exact hs2

  choose K0 hK0 using hprod _ _ _ hP0.1 hΛV.1 hP0.2 hΛV.2
  choose K1 hK1 using hprod _ _ _ hP1.1 hΛE.1 hP1.2 hΛE.2
  choose K2 hK2 using hprod _ _ _ hP1.1 hΛU.1 hP1.2 hΛU.2
  have hC0 : 0 ≤ ∑ j ∈ Finset.range (k + 1), (|K0 j| + |K1 j| + |K2 j|) :=
    Finset.sum_nonneg (fun j _ => by positivity)
  have hCj : ∀ j : ℕ, j ≤ k → |K0 j| + |K1 j| + |K2 j| ≤
      ∑ j ∈ Finset.range (k + 1), (|K0 j| + |K1 j| + |K2 j|) := fun j hj =>
    Finset.single_le_sum (f := fun j => |K0 j| + |K1 j| + |K2 j|) (fun i _ => by positivity)
      (Finset.mem_range.2 (by omega))
  refine ⟨∑ j ∈ Finset.range (k + 1), (|K0 j| + |K1 j| + |K2 j|), hC0,
    fun ξ hξ hX1 hX2 j hj => ⟨?_, ?_, ?_⟩⟩
  · have hq0 := hqpos ξ hξ
    have hQ : 0 ≤ qC B.h ξ ^ (-(1/2:ℝ)) := Real.rpow_nonneg hq0.le _
    have hgerm : (fun η => ubase B η 0) =ᶠ[nhds ξ]
        (fun η => (qC B.h η ^ (-(1/2:ℝ)) * (2 * XC B.h η) ^ (-(1/2:ℝ))) *
          logLift B.Vb (Real.log (qC B.h η), XC B.h η, etaC B.h η)) :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => (hrep η (hDsub hη)).1)
    have hNBeq : NB B.h (fun η => ubase B η 0) j ξ =
        NB B.h (fun η => (qC B.h η ^ (-(1/2:ℝ)) * (2 * XC B.h η) ^ (-(1/2:ℝ))) *
          logLift B.Vb (Real.log (qC B.h η), XC B.h η, etaC B.h η)) j ξ := by
      unfold NB
      rw [(hgerm.iteratedFDeriv ℝ j).eq_of_nhds]
    have hK : K0 j ≤ ∑ j ∈ Finset.range (k + 1), (|K0 j| + |K1 j| + |K2 j|) := by
      have := hCj j hj
      linarith [le_abs_self (K0 j), abs_nonneg (K1 j), abs_nonneg (K2 j)]
    rw [hNBeq]
    exact le_trans (hK0 j ξ hξ hX1 hX2) (mul_le_mul_of_nonneg_right hK hQ)
  · have hq0 := hqpos ξ hξ
    have hQ : 0 ≤ qC B.h ξ ^ (-Aex B.h) := Real.rpow_nonneg hq0.le _
    have hgerm : (fun η => ubase B η 1) =ᶠ[nhds ξ]
        (fun η => (qC B.h η ^ (-Aex B.h) * 1) *
          logLift B.Eb (Real.log (qC B.h η), XC B.h η, etaC B.h η)) :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => (hrep η (hDsub hη)).2.1)
    have hNBeq : NB B.h (fun η => ubase B η 1) j ξ =
        NB B.h (fun η => (qC B.h η ^ (-Aex B.h) * 1) *
          logLift B.Eb (Real.log (qC B.h η), XC B.h η, etaC B.h η)) j ξ := by
      unfold NB
      rw [(hgerm.iteratedFDeriv ℝ j).eq_of_nhds]
    have hK : K1 j ≤ ∑ j ∈ Finset.range (k + 1), (|K0 j| + |K1 j| + |K2 j|) := by
      have := hCj j hj
      linarith [le_abs_self (K1 j), abs_nonneg (K0 j), abs_nonneg (K2 j)]
    rw [hNBeq]
    exact le_trans (hK1 j ξ hξ hX1 hX2) (mul_le_mul_of_nonneg_right hK hQ)
  · have hq0 := hqpos ξ hξ
    have hQ : 0 ≤ qC B.h ξ ^ (-Aex B.h) := Real.rpow_nonneg hq0.le _
    have hgerm : (fun η => ubase B η 2) =ᶠ[nhds ξ]
        (fun η => (qC B.h η ^ (-Aex B.h) * 1) *
          logLift B.Ub (Real.log (qC B.h η), XC B.h η, etaC B.h η)) :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => (hrep η (hDsub hη)).2.2)
    have hNBeq : NB B.h (fun η => ubase B η 2) j ξ =
        NB B.h (fun η => (qC B.h η ^ (-Aex B.h) * 1) *
          logLift B.Ub (Real.log (qC B.h η), XC B.h η, etaC B.h η)) j ξ := by
      unfold NB
      rw [(hgerm.iteratedFDeriv ℝ j).eq_of_nhds]
    have hK : K2 j ≤ ∑ j ∈ Finset.range (k + 1), (|K0 j| + |K1 j| + |K2 j|) := by
      have := hCj j hj
      linarith [le_abs_self (K2 j), abs_nonneg (K0 j), abs_nonneg (K1 j)]
    rw [hNBeq]
    exact le_trans (hK2 j ξ hξ hX1 hX2) (mul_le_mul_of_nonneg_right hK hQ)

theorem nb_dRdZ_yind_v5 : ∀ (h : ℝ) (U : Set Cyl) (F : Cyl → ℝ), IsOpen U → ContDiffOn ℝ ∞ F U → (∀ η : Cyl, F η = F (η.1, η.2.1, η.2.2.1, ((0:ℝ), (0:ℝ)))) → ∀ ξ ∈ U, 0 < qC h ξ → ∀ k : ℕ, NB h (dR h F) k ξ ≤ qC h ξ ^ (-(1/2 : ℝ)) * NB h F (k + 1) ξ ∧ NB h (dZ F) k ξ ≤ qC h ξ ^ (-(1/2 - h)) * NB h F (k + 1) ξ :=
by
  intro h U F hU hF hY ξ hξ hq k

  have yzero : ∀ (η : Cyl) (y : ℝ × ℝ), fderiv ℝ F η ((0:ℝ), (0:ℝ), (0:ℝ), y) = 0 := by
    intro η y
    by_cases hd : DifferentiableAt ℝ F η
    · rw [← hd.lineDeriv_eq_fderiv]
      have hc : (fun t : ℝ => F (η + t • ((0:ℝ), (0:ℝ), (0:ℝ), y))) = fun _ => F η := by
        funext t
        rw [hY (η + t • ((0:ℝ), (0:ℝ), (0:ℝ), y)), hY η]
        simp
      unfold lineDeriv
      rw [hc]
      exact deriv_const _ _
    · rw [fderiv_zero_of_not_differentiableAt hd]
      rfl

  have dReq : dR h F = fun η => fderiv ℝ F η ((1:ℝ), (0:ℝ), (0:ℝ), (0:ℝ × ℝ)) := by
    funext η
    unfold dR
    have e : ((1:ℝ), (0:ℝ), (0:ℝ), (drx h * η.1 ^ (drx h - 1)) • vrv) =
        ((1:ℝ), (0:ℝ), (0:ℝ), (0:ℝ × ℝ)) + ((0:ℝ), (0:ℝ), (0:ℝ), (drx h * η.1 ^ (drx h - 1)) • vrv) := by
      ext <;> simp
    rw [e, map_add, yzero, add_zero]
  have dZeq : dZ F = fun η => fderiv ℝ F η ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) := rfl

  have e0 : ∀ v : Cyl, (Lnorm h ξ v).1 = Real.sqrt (qC h ξ) * v.1 := by
    intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
  have e1 : ∀ v : Cyl, (Lnorm h ξ v).2.1 = qC h ξ ^ (1/2 - h) * v.2.1 := by
    intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
  have e2 : ∀ v : Cyl, (Lnorm h ξ v).2.2.1 = qC h ξ * v.2.2.1 := by
    intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
  have e3 : ∀ v : Cyl, (Lnorm h ξ v).2.2.2 = JpowL (-coarseIdx h (qC h ξ)) v.2.2.2 := by
    intro v; rfl
  have sR0 : 0 ≤ qC h ξ ^ (-(1/2 : ℝ)) := Real.rpow_nonneg hq.le _
  have sZ0 : 0 ≤ qC h ξ ^ (-(1/2 - h)) := Real.rpow_nonneg hq.le _
  have hwR : Lnorm h ξ (qC h ξ ^ (-(1/2 : ℝ)), (0:ℝ), (0:ℝ), (0:ℝ × ℝ)) =
      ((1:ℝ), (0:ℝ), (0:ℝ), (0:ℝ × ℝ)) := by
    refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
    · rw [e0]
      show Real.sqrt (qC h ξ) * qC h ξ ^ (-(1/2 : ℝ)) = 1
      rw [Real.sqrt_eq_rpow, ← Real.rpow_add hq, add_neg_cancel, Real.rpow_zero]
    · rw [e1]; simp
    · rw [e2]; simp
    · rw [e3]
      exact map_zero _
  have hwZ : Lnorm h ξ ((0:ℝ), qC h ξ ^ (-(1/2 - h)), (0:ℝ), (0:ℝ × ℝ)) =
      ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) := by
    refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
    · rw [e0]; simp
    · rw [e1]
      show qC h ξ ^ (1/2 - h) * qC h ξ ^ (-(1/2 - h)) = 1
      rw [← Real.rpow_add hq, add_neg_cancel, Real.rpow_zero]
    · rw [e2]; simp
    · rw [e3]
      exact map_zero _
  have nR : ‖((qC h ξ ^ (-(1/2 : ℝ)), (0:ℝ), (0:ℝ), (0:ℝ × ℝ)) : Cyl)‖ ≤ qC h ξ ^ (-(1/2 : ℝ)) := by
    simp only [Prod.norm_mk, norm_zero, Real.norm_eq_abs, abs_of_nonneg sR0]
    exact max_le le_rfl (max_le sR0 (max_le sR0 sR0))
  have nZ : ‖(((0:ℝ), qC h ξ ^ (-(1/2 - h)), (0:ℝ), (0:ℝ × ℝ)) : Cyl)‖ ≤ qC h ξ ^ (-(1/2 - h)) := by
    simp only [Prod.norm_mk, norm_zero, Real.norm_eq_abs, abs_of_nonneg sZ0]
    exact max_le sZ0 (max_le le_rfl (max_le sZ0 sZ0))

  have hFd : ContDiffAt ℝ ∞ (fderiv ℝ F) ξ :=
    (hF.fderiv_of_isOpen hU (by exact_mod_cast le_top)).contDiffAt (hU.mem_nhds hξ)
  have nbdir : ∀ (w : Cyl),
      NB h (fun η => fderiv ℝ F η (Lnorm h ξ w)) k ξ ≤ ‖w‖ * NB h F (k + 1) ξ := by
    intro w
    have hcomp : (fun η => fderiv ℝ F η (Lnorm h ξ w)) =
        (ContinuousLinearMap.apply ℝ ℝ (Lnorm h ξ w)) ∘ (fderiv ℝ F) := by
      funext η; rfl
    have hit : iteratedFDeriv ℝ k (fun η => fderiv ℝ F η (Lnorm h ξ w)) ξ =
        (ContinuousLinearMap.apply ℝ ℝ (Lnorm h ξ w)).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fderiv ℝ F) ξ) := by
      rw [hcomp]
      exact ContinuousLinearMap.iteratedFDeriv_comp_left _ hFd (by exact_mod_cast le_top)
    have hNB0 : 0 ≤ NB h F (k + 1) ξ := norm_nonneg _
    unfold NB
    rw [hit]
    apply ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg (norm_nonneg _) hNB0)
    intro m
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      ContinuousLinearMap.apply_apply]
    have key : (iteratedFDeriv ℝ k (fderiv ℝ F) ξ (fun i => Lnorm h ξ (m i))) (Lnorm h ξ w) =
        ((iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ))
          (Fin.snoc (α := fun _ => Cyl) m w) := by
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_succ_apply_right]
      have e1' : Fin.init (fun i : Fin (k+1) => Lnorm h ξ (Fin.snoc (α := fun _ => Cyl) m w i)) =
          fun i => Lnorm h ξ (m i) := by
        funext i
        simp [Fin.init, Fin.snoc_castSucc]
      rw [e1']
      simp only [Fin.snoc_last]
    rw [key]
    have hprod : ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ =
        (∏ i : Fin k, ‖m i‖) * ‖w‖ := by
      rw [Fin.prod_univ_castSucc]
      simp [Fin.snoc_castSucc, Fin.snoc_last]
    calc _ ≤ ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ *
          ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ :=
          ContinuousMultilinearMap.le_opNorm _ _
      _ = ‖w‖ * ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ *
          ∏ i : Fin k, ‖m i‖ := by rw [hprod]; ring
  have hNB0 : 0 ≤ NB h F (k + 1) ξ := norm_nonneg _

  constructor
  · have h1 := nbdir (qC h ξ ^ (-(1/2 : ℝ)), (0:ℝ), (0:ℝ), (0:ℝ × ℝ))
    rw [hwR] at h1
    rw [dReq]
    exact le_trans h1 (mul_le_mul_of_nonneg_right nR hNB0)
  · have h1 := nbdir ((0:ℝ), qC h ξ ^ (-(1/2 - h)), (0:ℝ), (0:ℝ × ℝ))
    rw [hwZ] at h1
    rw [dZeq]
    exact le_trans h1 (mul_le_mul_of_nonneg_right nZ hNB0)

theorem inv_r_qnb_v5 : ∀ (B : BG), B.ok → ∀ (qs : ℝ), 0 < qs → qs ≤ 1 → ∀ k : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ j : ℕ, j ≤ k → NB B.h (fun η : Cyl => (η.1)⁻¹) j ξ ≤ C * qC B.h ξ ^ (-(1/2 : ℝ)) :=
by
  intro B hB qs hqs0 hqs1 k
  have hXa : 0 < B.Xa := hB.2.1.2.2.1

  have key : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (F : E → G) (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]
  obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = (Real.sqrt (2 * B.Xa))⁻¹ := ⟨_, rfl⟩
  have hρ0 : 0 ≤ ρ := by rw [hρ]; exact inv_nonneg.mpr (Real.sqrt_nonneg _)
  refine ⟨(k.factorial : ℝ) * (ρ + 1) ^ (k + 1), by positivity, ?_⟩
  intro ξ hξ hX1 hXb j hj
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
  have hr : 0 < ξ.1 := hξ'.1
  have hq : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = Real.sqrt (qC B.h ξ) := ⟨_, rfl⟩
  have hspos : 0 < s := by rw [hs]; exact Real.sqrt_pos.mpr hq
  have hs0 : 0 ≤ s := hspos.le

  have hX0 : B.Xa < ξ.1 ^ 2 / (2 * qC B.h ξ) := hX1
  have hX' : B.Xa * (2 * qC B.h ξ) < ξ.1 ^ 2 := (lt_div_iff₀ (by linarith)).mp hX0
  have h2Xa : 0 < 2 * B.Xa := by linarith
  have hX2 : 0 < Real.sqrt (2 * B.Xa) := Real.sqrt_pos.mpr h2Xa
  have hkey : Real.sqrt (2 * B.Xa) * s ≤ ξ.1 := by
    rw [hs, ← Real.sqrt_mul h2Xa.le]
    calc Real.sqrt (2 * B.Xa * qC B.h ξ) ≤ Real.sqrt (ξ.1 ^ 2) := Real.sqrt_le_sqrt (by
          rw [show 2 * B.Xa * qC B.h ξ = B.Xa * (2 * qC B.h ξ) by ring]; exact hX'.le)
      _ = ξ.1 := Real.sqrt_sq hr.le
  have hsr : s * ξ.1⁻¹ ≤ ρ := by
    rw [hρ]
    calc s * ξ.1⁻¹ = (Real.sqrt (2 * B.Xa))⁻¹ * (Real.sqrt (2 * B.Xa) * s) * ξ.1⁻¹ := by
          rw [← mul_assoc, inv_mul_cancel₀ hX2.ne', one_mul]
      _ ≤ (Real.sqrt (2 * B.Xa))⁻¹ * ξ.1 * ξ.1⁻¹ :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hkey (inv_nonneg.mpr hX2.le))
            (inv_nonneg.mpr hr.le)
      _ = (Real.sqrt (2 * B.Xa))⁻¹ := by rw [mul_assoc, mul_inv_cancel₀ hr.ne', mul_one]

  have hV : IsOpen {η : Cyl | 0 < η.1} := isOpen_lt continuous_const continuous_fst
  have hFV : ContDiffOn ℝ ∞ (fun η : Cyl => (η.1)⁻¹) {η : Cyl | 0 < η.1} :=
    contDiff_fst.contDiffOn.inv (fun η (hη : 0 < η.1) => hη.ne')
  obtain ⟨π, hπ⟩ : ∃ π : Cyl →L[ℝ] ℝ, π = ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)) := ⟨_, rfl⟩
  have hfun : ∀ z : Cyl, (fun η : Cyl => (η.1)⁻¹) (ξ + Lnorm B.h ξ z) =
      (fun x : ℝ => x⁻¹) (ξ.1 + (s • π) z) := by
    intro z
    show (ξ + Lnorm B.h ξ z).1⁻¹ = (ξ.1 + (s • π) z)⁻¹
    congr 1
    rw [hπ, hs]; simp [Lnorm]
  have hfunEq : (fun z : Cyl => (fun η : Cyl => (η.1)⁻¹) (ξ + Lnorm B.h ξ z)) =
      (fun z : Cyl => (fun x : ℝ => x⁻¹) (ξ.1 + (s • π) z)) := funext hfun
  have hinvS : ContDiffOn ℝ ∞ (fun x : ℝ => x⁻¹) (Set.Ioi 0) :=
    (contDiffOn_id (s := Set.Ioi (0:ℝ))).inv (fun x (hx : (0:ℝ) < x) => hx.ne')
  have e1 := key (fun η : Cyl => (η.1)⁻¹) {η : Cyl | 0 < η.1} ξ (Lnorm B.h ξ) hV hFV hr j
  have e2 := key (fun x : ℝ => x⁻¹) (Set.Ioi 0) ξ.1 (s • π) isOpen_Ioi hinvS hr j
  have hNBeq : NB B.h (fun η : Cyl => (η.1)⁻¹) j ξ =
      ‖(iteratedFDeriv ℝ j (fun x : ℝ => x⁻¹) ξ.1).compContinuousLinearMap
        (fun _ => s • π)‖ := by
    unfold NB
    rw [← e1, hfunEq, e2]
  have hπ1 : ‖π‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
    rw [hπ]
    show ‖η.1‖ ≤ 1 * ‖η‖
    rw [one_mul]
    exact norm_fst_le η
  have hn : ‖s • π‖ ≤ s := by
    rw [norm_smul, Real.norm_of_nonneg hs0]
    exact mul_le_of_le_one_right hs0 hπ1
  have hprod : ∏ _i : Fin j, ‖s • π‖ ≤ s ^ j := by
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    exact pow_le_pow_left₀ (norm_nonneg _) hn j
  have hz : ξ.1 ^ ((-1 : ℤ) - (j : ℤ)) = ξ.1⁻¹ ^ (j + 1) := by
    rw [show ((-1 : ℤ) - (j : ℤ)) = -((j + 1 : ℕ) : ℤ) by push_cast; ring, zpow_neg, zpow_natCast,
      inv_pow]
  have hd : ‖iteratedFDeriv ℝ j (fun x : ℝ => x⁻¹) ξ.1‖ =
      (j.factorial : ℝ) * ξ.1⁻¹ ^ (j + 1) := by
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate]
    show ‖deriv^[j] (Inv.inv : ℝ → ℝ) ξ.1‖ = _
    rw [iter_deriv_inv, hz, Real.norm_eq_abs, abs_mul, abs_mul, abs_pow, abs_neg, abs_one, one_pow,
      one_mul, Nat.abs_cast, abs_of_pos (pow_pos (inv_pos.mpr hr) _)]
  have hbound : NB B.h (fun η : Cyl => (η.1)⁻¹) j ξ ≤
      (j.factorial : ℝ) * ξ.1⁻¹ ^ (j + 1) * s ^ j := by
    rw [hNBeq]
    refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
    rw [hd]
    exact mul_le_mul_of_nonneg_left hprod
      (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg (inv_nonneg.mpr hr.le) _))

  have hqs : qC B.h ξ ^ (-(1/2 : ℝ)) = s⁻¹ := by
    rw [Real.rpow_neg hq.le, ← Real.sqrt_eq_rpow, ← hs]
  have hu0 : 0 ≤ s * ξ.1⁻¹ := mul_nonneg hs0 (inv_nonneg.mpr hr.le)
  have hu : (s * ξ.1⁻¹) ^ (j + 1) ≤ (ρ + 1) ^ (k + 1) :=
    (pow_le_pow_left₀ hu0 (hsr.trans (by linarith)) _).trans
      (pow_le_pow_right₀ (by linarith) (by omega))
  have hfac : (j.factorial : ℝ) ≤ (k.factorial : ℝ) := Nat.cast_le.mpr (Nat.factorial_le hj)
  have hmain : (j.factorial : ℝ) * (s * ξ.1⁻¹) ^ (j + 1) ≤ (k.factorial : ℝ) * (ρ + 1) ^ (k + 1) :=
    mul_le_mul hfac hu (pow_nonneg hu0 _) (Nat.cast_nonneg _)
  rw [hqs]
  calc NB B.h (fun η : Cyl => (η.1)⁻¹) j ξ
      ≤ (j.factorial : ℝ) * ξ.1⁻¹ ^ (j + 1) * s ^ j := hbound
    _ = (j.factorial : ℝ) * ξ.1⁻¹ ^ (j + 1) * s ^ j * (s * s⁻¹) := by
        rw [mul_inv_cancel₀ hspos.ne', mul_one]
    _ = (j.factorial : ℝ) * (s * ξ.1⁻¹) ^ (j + 1) * s⁻¹ := by ring
    _ ≤ (k.factorial : ℝ) * (ρ + 1) ^ (k + 1) * s⁻¹ :=
        mul_le_mul_of_nonneg_right hmain (inv_nonneg.mpr hs0)

theorem base_mat_nb_v5 : ∀ (B : BG), B.ok → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun η => baseMat5 B η i j) (DomC B.h (qsOf l0))) ∧ ∀ k : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ i j : Fin 3, NB B.h (fun η => baseMat5 B η i j) k ξ ≤ C * qC B.h ξ ^ B.h :=
by
  intro B hok
  obtain ⟨la, hla⟩ := ubase_nb_v5 B hok
  refine ⟨la, fun l0 hl0 => ?_⟩
  have hh0 : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  have hA : Aex B.h = 1/2 + B.h := rfl
  have hSN : SimNorm B.h := simscale_normalized_v4 B.h hh0 hh1 hok.1
  have hqs0 : 0 < qsOf l0 := by
    show (0:ℝ) < (2:ℝ) ^ (-(l0:ℝ))
    exact Real.rpow_pos_of_pos (by norm_num) _
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  obtain ⟨hDo, hqC, hqpos, -, hder, -⟩ := domc_open_calculus B (qsOf l0) hok
  obtain ⟨hsm, hub⟩ := hla l0 hl0
  have hqne : ∀ η ∈ DomC B.h (qsOf l0), qC B.h η ≠ 0 := fun η hη => (hqpos η hη).ne'
  have hpow : ∀ c : ℝ, ContDiffOn ℝ ∞ (fun η => qC B.h η ^ c) (DomC B.h (qsOf l0)) :=
    fun c => hqC.rpow_const_of_ne hqne
  have hP : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h))
      (DomC B.h (qsOf l0)) := (hpow _).mul (hpow _)
  have hdiv : ContDiffOn ℝ ∞ (fun η : Cyl => ubase B η 0 / η.1) (DomC B.h (qsOf l0)) :=
    (hsm 0).div contDiffOn_fst (fun η hη => hη.1.ne')
  refine ⟨?_, ?_⟩
  · intro i j
    fin_cases i <;> fin_cases j
    · show ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) *
        dR B.h (fun η => ubase B η 0) η) _
      exact hP.mul (hder _ (hsm 0)).1
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) _
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) *
        dZ (fun η => ubase B η 0) η) _
      exact hP.mul (hder _ (hsm 0)).2.1
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) _
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) *
        (ubase B η 0 / η.1)) _
      exact hP.mul hdiv
    · show ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) *
        dZ (fun η => ubase B η 1) η) _
      exact hP.mul (hder _ (hsm 1)).2.1
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) _
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) _
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) *
        dZ (fun η => ubase B η 2) η) _
      exact hP.mul (hder _ (hsm 2)).2.1
  · intro k
    obtain ⟨Cu, hCu0, hCu⟩ := hub (k + 1)
    obtain ⟨Cr, hCr0, hCr⟩ := inv_r_qnb_v5 B hok (qsOf l0) hqs0 hqs1 k
    choose Cq hCq using fun i : ℕ => nb_qpow_v4 B (qsOf l0) (Aex B.h + 1/2) hok hSN hqs0 hqs1 i
    obtain ⟨Kq, hKq⟩ : ∃ Kq : ℝ, Kq = ∑ i ∈ Finset.range (k + 1), |Cq i| := ⟨_, rfl⟩
    have hKq0 : 0 ≤ Kq := by
      rw [hKq]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
    have hCqK : ∀ i : ℕ, i ≤ k → |Cq i| ≤ Kq := by
      intro i hi
      rw [hKq]
      exact Finset.single_le_sum (f := fun i => |Cq i|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.2 (by omega))
    have key : ∀ (g : Cyl → ℝ) (M e : ℝ), 0 ≤ M → B.h ≤ Aex B.h + 1/2 + e →
        ContDiffOn ℝ ∞ g (DomC B.h (qsOf l0)) → ∀ ξ ∈ DomC B.h (qsOf l0),
        (∀ i : ℕ, i ≤ k → NB B.h g i ξ ≤ M * qC B.h ξ ^ e) →
        NB B.h (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) * g η) k ξ ≤
          2 ^ k * Kq * M * qC B.h ξ ^ B.h := by
      intro g M e hM he hg ξ hξ hgb
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
      have hq1 : qC B.h ξ ≤ 1 := le_trans hξ'.2.2.le hqs1
      have hev : (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) * g η) =ᶠ[nhds ξ]
          (fun η => qC B.h η ^ (Aex B.h + 1/2) * g η) :=
        Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => by
          show qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) * g η =
            qC B.h η ^ (Aex B.h + 1/2) * g η
          rw [← Real.rpow_add (hqpos η hη)]
          rw [show 2 * Aex B.h + 1/2 + -Aex B.h = Aex B.h + 1/2 by ring])
      have hNBeq : NB B.h (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) * g η) k ξ =
          NB B.h (fun η => qC B.h η ^ (Aex B.h + 1/2) * g η) k ξ := by
        unfold NB
        rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      rw [hNBeq]
      have hmul := nb_real_mul_le_v5 B.h ξ (fun η => qC B.h η ^ (Aex B.h + 1/2)) g k
        (Kq * qC B.h ξ ^ (Aex B.h + 1/2)) (M * qC B.h ξ ^ e)
        ((hpow _).contDiffAt (hDo.mem_nhds hξ)) (hg.contDiffAt (hDo.mem_nhds hξ))
        (fun i hi => le_trans (hCq i ξ hξ)
          (mul_le_mul_of_nonneg_right ((le_abs_self _).trans (hCqK i hi)) (Real.rpow_nonneg hq0.le _)))
        hgb
      have hexp : qC B.h ξ ^ (Aex B.h + 1/2 + e) ≤ qC B.h ξ ^ B.h :=
        Real.rpow_le_rpow_of_exponent_ge hq0 hq1 he
      have hc : 0 ≤ 2 ^ k * Kq * M := by positivity
      calc _ ≤ 2 ^ k * (Kq * qC B.h ξ ^ (Aex B.h + 1/2)) * (M * qC B.h ξ ^ e) := hmul
        _ = 2 ^ k * Kq * M * qC B.h ξ ^ (Aex B.h + 1/2 + e) := by
            rw [Real.rpow_add hq0 (Aex B.h + 1/2) e]; ring
        _ ≤ _ := mul_le_mul_of_nonneg_left hexp hc
    have hcomb : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ (x y c1 c2 Cc : ℝ), x ≤ qC B.h ξ ^ c1 * y →
        y ≤ Cc * qC B.h ξ ^ c2 → x ≤ Cc * qC B.h ξ ^ (c1 + c2) := by
      intro ξ hξ x y c1 c2 Cc h1 h2
      have hq0 := hqpos ξ hξ
      calc x ≤ qC B.h ξ ^ c1 * y := h1
        _ ≤ qC B.h ξ ^ c1 * (Cc * qC B.h ξ ^ c2) :=
            mul_le_mul_of_nonneg_left h2 (Real.rpow_nonneg hq0.le _)
        _ = Cc * qC B.h ξ ^ (c1 + c2) := by rw [Real.rpow_add hq0 c1 c2]; ring
    refine ⟨2 ^ k * Kq * Cu + 2 ^ k * Kq * (2 ^ k * Cu * Cr), by positivity,
      fun ξ hξ hX1 hX2 i j => ?_⟩
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hq0 := hqpos ξ hξ
    have hqh : 0 ≤ qC B.h ξ ^ B.h := Real.rpow_nonneg hq0.le _
    have t1 : 0 ≤ 2 ^ k * Kq * Cu := by positivity
    have t2 : 0 ≤ 2 ^ k * Kq * (2 ^ k * Cu * Cr) := by positivity
    have up1 : 2 ^ k * Kq * Cu * qC B.h ξ ^ B.h ≤
        (2 ^ k * Kq * Cu + 2 ^ k * Kq * (2 ^ k * Cu * Cr)) * qC B.h ξ ^ B.h :=
      mul_le_mul_of_nonneg_right (by linarith) hqh
    have up2 : 2 ^ k * Kq * (2 ^ k * Cu * Cr) * qC B.h ξ ^ B.h ≤
        (2 ^ k * Kq * Cu + 2 ^ k * Kq * (2 ^ k * Cu * Cr)) * qC B.h ξ ^ B.h :=
      mul_le_mul_of_nonneg_right (by linarith) hqh
    have hdir : ∀ (a : Fin 3) (i : ℕ),
        NB B.h (dR B.h (fun η => ubase B η a)) i ξ ≤
          qC B.h ξ ^ (-(1/2 : ℝ)) * NB B.h (fun η => ubase B η a) (i + 1) ξ ∧
        NB B.h (dZ (fun η => ubase B η a)) i ξ ≤
          qC B.h ξ ^ (-(1/2 - B.h)) * NB B.h (fun η => ubase B η a) (i + 1) ξ :=
      fun a i => nb_dRdZ_yind_v5 B.h _ _ hDo (hsm a) (fun η => rfl) ξ hξ hq0 i
    have hz : NB B.h (fun _ : Cyl => (0:ℝ)) k ξ ≤
        (2 ^ k * Kq * Cu + 2 ^ k * Kq * (2 ^ k * Cu * Cr)) * qC B.h ξ ^ B.h := by
      have hz0 : iteratedFDeriv ℝ k (fun _ : Cyl => (0:ℝ)) ξ = 0 := by
        have h := (iteratedFDeriv_fun_zero : iteratedFDeriv ℝ k (fun _ : Cyl => (0:ℝ)) = 0)
        exact congrFun h ξ
      unfold NB
      rw [hz0]
      have h0 : ((0 : ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) ℝ).compContinuousLinearMap
          fun _ => Lnorm B.h ξ) = 0 := by
        ext v
        simp
      rw [h0, norm_zero]
      positivity
    fin_cases i <;> fin_cases j
    · show NB B.h (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) *
        dR B.h (fun η => ubase B η 0) η) k ξ ≤ _
      refine le_trans (key (dR B.h (fun η => ubase B η 0)) Cu (-(1/2 : ℝ) + -(1/2 : ℝ)) hCu0
        (by rw [hA]; linarith) (hder _ (hsm 0)).1 ξ hξ (fun i hi => hcomb ξ hξ _ _ _ _ _ (hdir 0 i).1
          (hCu ξ hξ hX1 hX2 (i + 1) (by omega)).1)) up1
    · exact hz
    · show NB B.h (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) *
        dZ (fun η => ubase B η 0) η) k ξ ≤ _
      refine le_trans (key (dZ (fun η => ubase B η 0)) Cu (-(1/2 - B.h) + -(1/2 : ℝ)) hCu0
        (by rw [hA]; linarith) (hder _ (hsm 0)).2.1 ξ hξ (fun i hi => hcomb ξ hξ _ _ _ _ _ (hdir 0 i).2
          (hCu ξ hξ hX1 hX2 (i + 1) (by omega)).1)) up1
    · exact hz
    · show NB B.h (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) *
        (ubase B η 0 / η.1)) k ξ ≤ _
      have hgb : ∀ i : ℕ, i ≤ k → NB B.h (fun η : Cyl => ubase B η 0 / η.1) i ξ ≤
          (2 ^ k * Cu * Cr) * qC B.h ξ ^ (-(1/2 : ℝ) + -(1/2 : ℝ)) := by
        intro i hi
        have e : (fun η : Cyl => ubase B η 0 / η.1) = fun η : Cyl => ubase B η 0 * (η.1)⁻¹ :=
          funext fun η => div_eq_mul_inv _ _
        rw [e]
        have hx : 0 ≤ qC B.h ξ ^ (-(1/2 : ℝ)) := Real.rpow_nonneg hq0.le _
        have h2 : (2:ℝ) ^ i ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hi
        have hm := nb_real_mul_le_v5 B.h ξ (fun η => ubase B η 0) (fun η : Cyl => (η.1)⁻¹) i
          (Cu * qC B.h ξ ^ (-(1/2 : ℝ))) (Cr * qC B.h ξ ^ (-(1/2 : ℝ)))
          ((hsm 0).contDiffAt (hDo.mem_nhds hξ)) (contDiffAt_fst.inv hξ'.1.ne')
          (fun i' hi' => (hCu ξ hξ hX1 hX2 i' (by omega)).1)
          (fun i' hi' => hCr ξ hξ hX1 hX2 i' (by omega))
        calc _ ≤ 2 ^ i * (Cu * qC B.h ξ ^ (-(1/2 : ℝ))) * (Cr * qC B.h ξ ^ (-(1/2 : ℝ))) := hm
          _ ≤ 2 ^ k * (Cu * qC B.h ξ ^ (-(1/2 : ℝ))) * (Cr * qC B.h ξ ^ (-(1/2 : ℝ))) :=
              mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right h2 (mul_nonneg hCu0 hx))
                (mul_nonneg hCr0 hx)
          _ = (2 ^ k * Cu * Cr) * qC B.h ξ ^ (-(1/2 : ℝ) + -(1/2 : ℝ)) := by
              rw [Real.rpow_add hq0 (-(1/2 : ℝ)) (-(1/2 : ℝ))]; ring
      refine le_trans (key (fun η : Cyl => ubase B η 0 / η.1) (2 ^ k * Cu * Cr)
        (-(1/2 : ℝ) + -(1/2 : ℝ)) (by positivity) (by rw [hA]; linarith) hdiv ξ hξ hgb) up2
    · show NB B.h (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) *
        dZ (fun η => ubase B η 1) η) k ξ ≤ _
      refine le_trans (key (dZ (fun η => ubase B η 1)) Cu (-(1/2 - B.h) + -Aex B.h) hCu0
        (by rw [hA]; linarith) (hder _ (hsm 1)).2.1 ξ hξ (fun i hi => hcomb ξ hξ _ _ _ _ _ (hdir 1 i).2
          (hCu ξ hξ hX1 hX2 (i + 1) (by omega)).2.1)) up1
    · exact hz
    · exact hz
    · show NB B.h (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * qC B.h η ^ (-Aex B.h) *
        dZ (fun η => ubase B η 2) η) k ξ ≤ _
      refine le_trans (key (dZ (fun η => ubase B η 2)) Cu (-(1/2 - B.h) + -Aex B.h) hCu0
        (by rw [hA]; linarith) (hder _ (hsm 2)).2.1 ξ hξ (fun i hi => hcomb ξ hξ _ _ _ _ _ (hdir 2 i).2
          (hCu ξ hξ hX1 hX2 (i + 1) (by omega)).2.2)) up1

theorem plin5_base_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (β : ℝ) (w : WC), InWg5 B G (qsOf l0) β w → InWg5 B G (qsOf l0) (β + 1/2 - 3 * kapS) (remBase5 B (fun γ m η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • w γ m η)) :=
by
  intro B G hok _hG
  obtain ⟨lb, hb⟩ := base_mat_nb_v5 B hok
  refine ⟨lb, fun l0 hl0 β w hw => ?_⟩
  have hk : kapS = 1 / 100000 := rfl
  have hh : 0 < B.h := hok.2.1.1
  have hq1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hS : SimScaleProps B.h := hok.1
  have hDo : IsOpen (DomC B.h (qsOf l0)) := by
    have h4c := hS.2.2.2.1.continuousOn
    have hm : MapsTo (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1} (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have hξ' : ξ.2.2.1 < 1 := hξ
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hcont : ContinuousOn (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1} :=
      h4c.comp (f := fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) (Continuous.continuousOn (by fun_prop)) hm
    have e : DomC B.h (qsOf l0) = {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩
        (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) ⁻¹' Iio (qsOf l0)) := by
      ext ξ
      exact Iff.rfl
    rw [e]
    exact (isOpen_lt continuous_const continuous_fst).inter
      (hcont.isOpen_inter_preimage (isOpen_lt (by fun_prop) continuous_const) isOpen_Iio)
  have hqpos : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ := by
    intro ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    exact (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  obtain ⟨hsm, hbd⟩ := hb l0 hl0

  have hid : remBase5 B (fun γ m η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • w γ m η) =
      fun γ m ξ => (pulseMatC (baseMat5 B ξ)).mulVec (w γ m ξ) := by
    funext γ m ξ
    funext i
    fin_cases i <;>
      simp [remBase5, baseMat5, pulseMatC, Matrix.mulVec, dotProduct, Fin.sum_univ_three] <;>
      push_cast <;> ring

  have hfd : ∀ (f : Cyl → ℝ), (∀ (η : Cyl) (c : ℝ × ℝ), f (shY η c) = f η) →
      ∀ (ξ : Cyl) (c : ℝ × ℝ), fderiv ℝ f (shY ξ c) = fderiv ℝ f ξ := by
    intro f hf ξ c
    have e0 : ∀ η : Cyl, η + ((0:ℝ), (0:ℝ), (0:ℝ), c) = shY η c := by
      intro η
      show (η.1 + 0, η.2.1 + 0, η.2.2.1 + 0, η.2.2.2 + c) = (η.1, η.2.1, η.2.2.1, η.2.2.2 + c)
      rw [add_zero, add_zero, add_zero]
    have e2 : (fun η => f (η + ((0:ℝ), (0:ℝ), (0:ℝ), c))) = f := by
      funext η
      rw [e0 η, hf]
    rw [← e0 ξ, ← fderiv_comp_add_right, e2]
  have hdeck : ∀ (ξ : Cyl) (c : ℝ × ℝ), baseMat5 B (shY ξ c) = baseMat5 B ξ := by
    intro ξ c
    have hu : ∀ i : Fin 3, ∀ (η : Cyl) (c : ℝ × ℝ),
        (fun η => ubase B η i) (shY η c) = (fun η => ubase B η i) η := fun _ _ _ => rfl
    unfold baseMat5 dR dZ
    rw [hfd _ (hu 0) ξ c, hfd _ (hu 1) ξ c, hfd _ (hu 2) ξ c]
    rfl

  have hcl := inWg5_mat_mult_v5 B G l0 hok β (1/2 - 3 * kapS) w (fun _ _ η => baseMat5 B η) hw
    (fun γ m ξ hξ _ i j => (hsm i j).contDiffAt (hDo.mem_nhds hξ))
    (fun γ m ξ _ _ c _ => hdeck ξ c)
    (fun k => by
      obtain ⟨C, hC0, hC⟩ := hbd k
      refine ⟨C, 0, fun γ m ξ hξ _ hX1 hX2 i j => ?_⟩
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
      have hq1' : qC B.h ξ ≤ 1 := le_trans hξ'.2.2.le hq1
      have hexp : B.h * (1/2 - 3 * kapS) ≤ B.h := by rw [hk]; linarith
      calc _ ≤ C * qC B.h ξ ^ B.h := hC ξ hξ hX1 hX2 i j
        _ ≤ C * qC B.h ξ ^ (B.h * (1/2 - 3 * kapS)) :=
            mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0 hq1' hexp) hC0
        _ = C * qC B.h ξ ^ (B.h * (1/2 - 3 * kapS)) * SC B.h ξ ^ (0:ℝ) := by
            rw [Real.rpow_zero, mul_one])
  rw [hid]
  have e : β + 1/2 - 3 * kapS = β + (1/2 - 3 * kapS) := by ring
  rw [e]
  exact hcl

theorem prin_small_pointwise_v5 : ∀ (B : BG) (G : CorrGeom) (d : WC) (γ : Lab) (m : ℤ) (ξ : Cyl), B.ok → ξ.2.2.1 < 1 → DifferentiableAt ℝ (d γ m) ξ → primOp5 B G (fun γ' m' η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • d γ' m' η) γ m ξ = (((rhoQ B γ ξ ^ (1 + B.h)) : ℝ) : ℂ) • dVc B γ.1 (d γ m) ξ + (pulseMatC (prinMat5 B G γ m ξ)).mulVec (d γ m ξ) :=
by
  intro B G d γ m ξ hok hξ hdiff
  have hτ : (0:ℝ) < 1 - ξ.2.2.1 := by linarith
  have hq : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
  have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _

  have hqd : DifferentiableAt ℝ (qC B.h) ξ := by
    have hS : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (ξ.2.1, 1 - ξ.2.2.1) :=
      hok.1.2.2.2.1.contDiffAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds ⟨trivial, hτ⟩)
    have hS' : DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (ξ.2.1, 1 - ξ.2.2.1) :=
      hS.differentiableAt (by simp)
    have hπ : DifferentiableAt ℝ (fun η : Cyl => (η.2.1, 1 - η.2.2.1)) ξ := by fun_prop
    have h : DifferentiableAt ℝ ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun η : Cyl => (η.2.1, 1 - η.2.2.1))) ξ := hS'.comp ξ hπ
    exact h
  have hc : DifferentiableAt ℝ (fun η : Cyl => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ)) ξ :=
    Complex.ofRealCLM.differentiableAt.comp ξ (hqd.rpow_const (Or.inl hq.ne'))

  have hcv : fderiv ℝ (fun η : Cyl => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ)) ξ (dVdir B.h γ.1) = 0 := by
    have hl : HasDerivAt (fun t : ℝ => ξ + t • dVdir B.h γ.1) (dVdir B.h γ.1) 0 := by
      simpa using ((hasDerivAt_id (0:ℝ)).smul_const (dVdir B.h γ.1)).const_add ξ
    have h1 := hc.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hl (by simp)
    have hconst : ((fun η : Cyl => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ)) ∘
        fun t : ℝ => ξ + t • dVdir B.h γ.1) =
        fun _ => (((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) := by
      funext t
      simp [dVdir, qC, Function.comp]
    rw [hconst] at h1
    exact h1.unique (hasDerivAt_const _ _)

  have hD : dVc B γ.1 (fun η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • d γ m η) ξ =
      (((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) • dVc B γ.1 (d γ m) ξ := by
    unfold dVc
    have e : (fun η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • d γ m η) =
        (fun η : Cyl => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ)) • d γ m := rfl
    rw [e, fderiv_smul hc hdiff]
    simp [hcv]

  have hM : pulseMatC (prinMat5 B G γ m ξ) =
      (((rhoQ B γ ξ ^ (1 + B.h)) : ℝ) : ℂ) • (pulseMatC (Kmat B G γ ξ) +
        ((((m : ℝ) ^ 2 * dDamp5 B G γ ξ) : ℝ) : ℂ) • (1 : Matrix (Fin 3) (Fin 3) ℂ)) := by
    ext i j
    simp only [pulseMatC, prinMat5, Matrix.map_apply, Matrix.smul_apply, Matrix.add_apply,
      Matrix.one_apply, smul_eq_mul]
    split_ifs <;> simp only [mul_one, mul_zero, add_zero, Complex.ofReal_mul, Complex.ofReal_add]

  have hY : 0 < Qb γ.1 ^ B.h := Real.rpow_pos_of_pos hQ _
  have hX : 0 < qC B.h ξ ^ (1 + B.h) := Real.rpow_pos_of_pos hq _
  have hZ : 0 < qC B.h ξ ^ Aex B.h := Real.rpow_pos_of_pos hq _
  have R1 : qC B.h ξ ^ (2 * Aex B.h + 1/2) = qC B.h ξ ^ (1 + B.h) * qC B.h ξ ^ Aex B.h := by
    rw [show 2 * Aex B.h + 1/2 = (1 + B.h) + Aex B.h by unfold Aex; ring, Real.rpow_add hq]
  have R2 : qC B.h ξ ^ (-Aex B.h) = (qC B.h ξ ^ Aex B.h)⁻¹ := Real.rpow_neg hq.le _
  have R3 : Qb γ.1 ^ (1 + B.h) = Qb γ.1 * Qb γ.1 ^ B.h := by
    rw [Real.rpow_add hQ, Real.rpow_one]
  have R4 : Qb γ.1 ^ (-(1 + B.h)) = (Qb γ.1 * Qb γ.1 ^ B.h)⁻¹ := by
    rw [Real.rpow_neg hQ.le, R3]
  have R5 : Qb γ.1 ^ (-(Aex B.h + 1/2)) = (Qb γ.1 * Qb γ.1 ^ B.h)⁻¹ := by
    rw [show Aex B.h + 1/2 = 1 + B.h by unfold Aex; ring, R4]
  have R6 : rhoQ B γ ξ ^ (1 + B.h) = qC B.h ξ ^ (1 + B.h) / (Qb γ.1 * Qb γ.1 ^ B.h) := by
    unfold rhoQ
    rw [Real.div_rpow hq.le hQ.le, R3]
  have R7 : dDamp5 B G γ ξ = Qb γ.1 ^ B.h * ((kb B.h γ.1 : ℝ)) ^ 2 *
      dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) := rfl
  have E1r : qC B.h ξ ^ (2 * Aex B.h + 1/2) * Qb γ.1 ^ (-(1 + B.h)) * qC B.h ξ ^ (-Aex B.h) =
      rhoQ B γ ξ ^ (1 + B.h) := by
    rw [R1, R4, R2, R6]
    generalize qC B.h ξ ^ (1 + B.h) = X at hX ⊢
    generalize qC B.h ξ ^ Aex B.h = Z at hZ ⊢
    generalize Qb γ.1 ^ B.h = Y at hY ⊢
    field_simp
  have E2r : qC B.h ξ ^ (2 * Aex B.h + 1/2) * Qb γ.1 ^ (-(Aex B.h + 1/2)) * qC B.h ξ ^ (-Aex B.h) =
      rhoQ B γ ξ ^ (1 + B.h) := by
    rw [R5, ← R4]
    exact E1r
  have E3r : ((m : ℝ) ^ 2 * (((kb B.h γ.1 : ℝ) ^ 2 * dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) /
      Qb γ.1 : ℝ))) * qC B.h ξ ^ (2 * Aex B.h + 1/2) * qC B.h ξ ^ (-Aex B.h) =
      rhoQ B γ ξ ^ (1 + B.h) * ((m : ℝ) ^ 2 * dDamp5 B G γ ξ) := by
    rw [R1, R2, R6, R7]
    generalize qC B.h ξ ^ (1 + B.h) = X at hX ⊢
    generalize qC B.h ξ ^ Aex B.h = Z at hZ ⊢
    generalize Qb γ.1 ^ B.h = Y at hY ⊢
    field_simp
  have E1c : (((qC B.h ξ ^ (2 * Aex B.h + 1/2)) : ℝ) : ℂ) * (((Qb γ.1 ^ (-(1 + B.h))) : ℝ) : ℂ) *
      (((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) = (((rhoQ B γ ξ ^ (1 + B.h)) : ℝ) : ℂ) := by
    rw [← Complex.ofReal_mul, ← Complex.ofReal_mul, E1r]
  have E2c : (((qC B.h ξ ^ (2 * Aex B.h + 1/2)) : ℝ) : ℂ) * (((Qb γ.1 ^ (-(Aex B.h + 1/2))) : ℝ) : ℂ) *
      (((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) = (((rhoQ B γ ξ ^ (1 + B.h)) : ℝ) : ℂ) := by
    rw [← Complex.ofReal_mul, ← Complex.ofReal_mul, E2r]
  have E3c : ((m : ℂ) ^ 2 * (((kb B.h γ.1 : ℝ) ^ 2 * dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) /
      Qb γ.1 : ℝ) : ℂ)) * (((qC B.h ξ ^ (2 * Aex B.h + 1/2)) : ℝ) : ℂ) *
      (((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) =
      (((rhoQ B γ ξ ^ (1 + B.h)) : ℝ) : ℂ) * ((((m : ℝ) ^ 2 * dDamp5 B G γ ξ) : ℝ) : ℂ) := by
    rw [← Complex.ofReal_intCast, ← Complex.ofReal_pow, ← Complex.ofReal_mul, ← Complex.ofReal_mul,
      ← Complex.ofReal_mul, ← Complex.ofReal_mul, E3r]

  simp only [primOp5]
  rw [hD, Matrix.mulVec_smul, hM]
  simp only [Matrix.smul_mulVec, Matrix.add_mulVec, Matrix.one_mulVec]
  funext i
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  linear_combination (dVc B γ.1 (d γ m) ξ i) * E1c +
    ((pulseMatC (Kmat B G γ ξ)).mulVec (d γ m ξ) i) * E2c + (d γ m ξ i) * E3c

theorem inWg5_dVc_class_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (β : ℝ) (d : WC), InWg5 B G (qsOf l0) β d → InWg5 B G (qsOf l0) β (fun γ m ξ => dVc B γ.1 (d γ m) ξ) :=
by
  intro B G hok hG
  obtain ⟨lp, Hp⟩ := pulse_support_good_v5 B G hok hG
  refine ⟨lp + 7, fun l0 hl0 β d hd => ?_⟩
  have hh : 0 < B.h := hok.2.1.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  obtain ⟨hDo, hqpos⟩ : IsOpen (DomC B.h (qsOf l0)) ∧ ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ := by
    refine ⟨?_, fun ξ hξ => (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).1⟩
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'

  have hs2a : (1:ℝ) < Real.sqrt 2 := by
    have h := Real.sqrt_lt_sqrt (show (0:ℝ) ≤ 1 by norm_num) (show (1:ℝ) < 2 by norm_num)
    rwa [Real.sqrt_one] at h
  have hs2b : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
  have hT1 : 1 < Tgc := by unfold Tgc; linarith
  have hT0 : 0 < Tgc := by linarith
  have hbgc0 : 0 < bgc := by unfold bgc; linarith
  have hbgc1 : bgc < 1 := by unfold bgc; linarith

  have hJ : ∀ (n : ℤ) (t : ℝ), JpowL n (t • vtv) = (Tgc ^ n * t) • vtv := by
    intro n t
    have hD : (1 + bgc ^ 2) ≠ 0 := by positivity
    simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
      ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Jpow, vrv, vtv]
    refine Prod.ext ?_ ?_
    · simp only [Prod.smul_fst, Prod.smul_snd, Prod.fst_add, smul_eq_mul]
      field_simp
      ring
    · simp only [Prod.smul_fst, Prod.smul_snd, Prod.snd_add, smul_eq_mul]
      field_simp
      ring

  have hframe : ∀ (l : ℕ) (ξ : Cyl), 1/4 < qC B.h ξ / Qb l →
      ∃ w : Cyl, Lnorm B.h ξ w = dVdir B.h l ∧ ‖w‖ ≤ 1 := by
    intro l ξ hwin
    have hQ : 0 < Qb l := Real.rpow_pos_of_pos two_pos _
    have hq : 0 < qC B.h ξ := by
      have h1 := mul_pos (show (0:ℝ) < qC B.h ξ / Qb l by linarith) hQ
      rwa [div_mul_cancel₀ _ hQ.ne'] at h1
    obtain ⟨j, hj⟩ : ∃ j : ℕ, j = bandOf (qC B.h ξ) - 4 := ⟨_, rfl⟩
    have hc : coarseIdx B.h (qC B.h ξ) = bandIdx B.h j := by rw [hj]; rfl
    obtain ⟨s, hs⟩ : ∃ s : ℝ, s = Qb l ^ (1 + B.h) * Tgc ^ (bandIdx B.h j) := ⟨_, rfl⟩

    have hP : 0 < (2:ℝ) ^ (l:ℝ) := Real.rpow_pos_of_pos two_pos _
    have hQP : Qb l = ((2:ℝ) ^ (l:ℝ))⁻¹ := by unfold Qb; exact Real.rpow_neg (by norm_num) _
    have hwin' : 1/4 < qC B.h ξ * (2:ℝ) ^ (l:ℝ) := by
      rw [hQP, div_inv_eq_mul] at hwin; exact hwin
    have hband : bandOf (qC B.h ξ) ≤ l + 2 := by
      unfold bandOf
      rw [Nat.ceil_le, Real.logb_le_iff_le_rpow one_lt_two (by positivity)]
      have e : (2:ℝ) ^ (((l + 2 : ℕ) : ℝ)) = 4 * (2:ℝ) ^ (l:ℝ) := by
        rw [Nat.cast_add, Real.rpow_add two_pos, Real.rpow_natCast]; ring
      rw [e, div_le_iff₀ hq]
      have e2 : 4 * (2:ℝ) ^ (l:ℝ) * qC B.h ξ = 4 * (qC B.h ξ * (2:ℝ) ^ (l:ℝ)) := by ring
      rw [e2]
      linarith
    have hjl : j ≤ l := by omega

    have hTj : Tgc ^ (bandIdx B.h j) ≤ (2:ℝ) ^ ((1 + B.h) * (j:ℝ)) := by
      unfold bandIdx
      rcases Nat.eq_zero_or_pos j with h0 | hpos
      · have e : Real.logb Tgc ((2:ℝ) ^ ((1 + B.h) * (j:ℝ)) / ((j:ℝ) ^ 2)) = 0 := by
          rw [h0]; simp
        rw [e, Int.floor_zero, zpow_zero, h0]
        simp
      · obtain ⟨A, hA⟩ : ∃ A : ℝ, A = (2:ℝ) ^ ((1 + B.h) * (j:ℝ)) := ⟨_, rfl⟩
        rw [← hA]
        have hl1 : (1:ℝ) ≤ (j:ℝ) ^ 2 := one_le_pow₀ (by exact_mod_cast hpos)
        have hA0 : 0 < A := by rw [hA]; exact Real.rpow_pos_of_pos two_pos _
        have hAl : 0 < A / (j:ℝ) ^ 2 := div_pos hA0 (by linarith)
        have h1 := Int.floor_le (Real.logb Tgc (A / (j:ℝ) ^ 2))
        calc Tgc ^ ⌊Real.logb Tgc (A / (j:ℝ) ^ 2)⌋
            = Tgc ^ ((⌊Real.logb Tgc (A / (j:ℝ) ^ 2)⌋ : ℤ) : ℝ) := (Real.rpow_intCast _ _).symm
          _ ≤ Tgc ^ (Real.logb Tgc (A / (j:ℝ) ^ 2)) := Real.rpow_le_rpow_of_exponent_le hT1.le h1
          _ = A / (j:ℝ) ^ 2 := Real.rpow_logb hT0 hT1.ne' hAl
          _ ≤ A := div_le_self hA0.le hl1

    have hs0 : 0 ≤ s := by
      rw [hs]; exact mul_nonneg (Real.rpow_nonneg hQ.le _) (zpow_pos hT0 _).le
    have hQr : Qb l ^ (1 + B.h) = (2:ℝ) ^ (-(l:ℝ) * (1 + B.h)) := by
      unfold Qb; rw [← Real.rpow_mul (by norm_num)]
    have hs1 : s ≤ 1 := by
      have hjl' : (j:ℝ) ≤ (l:ℝ) := by exact_mod_cast hjl
      have hex : -(l:ℝ) * (1 + B.h) + (1 + B.h) * (j:ℝ) = (1 + B.h) * ((j:ℝ) - l) := by ring
      calc s = (2:ℝ) ^ (-(l:ℝ) * (1 + B.h)) * Tgc ^ (bandIdx B.h j) := by rw [hs, hQr]
        _ ≤ (2:ℝ) ^ (-(l:ℝ) * (1 + B.h)) * (2:ℝ) ^ ((1 + B.h) * (j:ℝ)) :=
            mul_le_mul_of_nonneg_left hTj (Real.rpow_nonneg (by norm_num) _)
        _ = (2:ℝ) ^ (-(l:ℝ) * (1 + B.h) + (1 + B.h) * (j:ℝ)) := (Real.rpow_add two_pos _ _).symm
        _ ≤ 1 := by
            rw [hex]
            exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num)
              (mul_nonpos_of_nonneg_of_nonpos (by linarith) (by linarith))
    refine ⟨((0:ℝ), (0:ℝ), (0:ℝ), s • vtv), ?_, ?_⟩
    · have e0 : ∀ v : Cyl, (Lnorm B.h ξ v).1 = Real.sqrt (qC B.h ξ) * v.1 := by
        intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have e1 : ∀ v : Cyl, (Lnorm B.h ξ v).2.1 = qC B.h ξ ^ (1/2 - B.h) * v.2.1 := by
        intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have e2 : ∀ v : Cyl, (Lnorm B.h ξ v).2.2.1 = qC B.h ξ * v.2.2.1 := by
        intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have e3 : ∀ v : Cyl, (Lnorm B.h ξ v).2.2.2 = JpowL (-coarseIdx B.h (qC B.h ξ)) v.2.2.2 := by
        intro v; rfl
      have h1 : Tgc ^ (bandIdx B.h j) ≠ 0 := (zpow_pos hT0 _).ne'
      have h2 : Tgc ^ (bandIdx B.h l) ≠ 0 := (zpow_pos hT0 _).ne'
      refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
      · rw [e0]; simp [dVdir]
      · rw [e1]; simp [dVdir]
      · rw [e2]; simp [dVdir]
      · rw [e3]
        show JpowL (-coarseIdx B.h (qC B.h ξ)) (s • vtv) = (cib B.h l * Tgc ^ (-(bandIdx B.h l))) • vtv
        rw [hJ, hc, hs]
        congr 1
        unfold cib
        rw [zpow_neg, zpow_neg, mul_comm (Qb l ^ (1 + B.h)), ← mul_assoc, inv_mul_cancel₀ h1, one_mul,
          mul_comm (Tgc ^ bandIdx B.h l), mul_assoc, mul_inv_cancel₀ h2, mul_one]
    · have hv : ‖vtv‖ = 1 := by
        unfold vtv
        rw [Prod.norm_mk, Real.norm_eq_abs, norm_one, abs_of_pos hbgc0, max_eq_right hbgc1.le]
      rw [Prod.norm_mk, Prod.norm_mk, Prod.norm_mk]
      simp only [norm_zero, norm_nonneg, max_eq_right]
      rw [norm_smul, Real.norm_eq_abs, hv, mul_one, abs_of_nonneg hs0]
      exact hs1

  have nbdir : ∀ (ξ : Cyl) (F : Cyl → (Fin 3 → ℂ)) (w : Cyl), ξ ∈ DomC B.h (qsOf l0) →
      ContDiffOn ℝ ∞ F (DomC B.h (qsOf l0)) → ∀ k : ℕ,
      NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ w)) k ξ ≤ ‖w‖ * NB B.h F (k + 1) ξ := by
    intro ξ F w hξ hF k
    have hFd : ContDiffAt ℝ ∞ (fderiv ℝ F) ξ :=
      (hF.fderiv_of_isOpen hDo (by exact_mod_cast le_top)).contDiffAt (hDo.mem_nhds hξ)
    have hcomp : (fun η => fderiv ℝ F η (Lnorm B.h ξ w)) =
        (ContinuousLinearMap.apply ℝ (Fin 3 → ℂ) (Lnorm B.h ξ w)) ∘ (fderiv ℝ F) := by
      funext η; rfl
    have hit : iteratedFDeriv ℝ k (fun η => fderiv ℝ F η (Lnorm B.h ξ w)) ξ =
        (ContinuousLinearMap.apply ℝ (Fin 3 → ℂ) (Lnorm B.h ξ w)).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fderiv ℝ F) ξ) := by
      rw [hcomp]
      exact ContinuousLinearMap.iteratedFDeriv_comp_left _ hFd (by exact_mod_cast le_top)
    have hNB0 : 0 ≤ NB B.h F (k + 1) ξ := norm_nonneg _
    unfold NB
    rw [hit]
    apply ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg (norm_nonneg _) hNB0)
    intro m
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      ContinuousLinearMap.apply_apply]
    have key : (iteratedFDeriv ℝ k (fderiv ℝ F) ξ (fun i => Lnorm B.h ξ (m i))) (Lnorm B.h ξ w) =
        ((iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ))
          (Fin.snoc (α := fun _ => Cyl) m w) := by
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_succ_apply_right]
      have e1 : Fin.init (fun i : Fin (k+1) => Lnorm B.h ξ (Fin.snoc (α := fun _ => Cyl) m w i)) =
          fun i => Lnorm B.h ξ (m i) := by
        funext i
        simp [Fin.init, Fin.snoc_castSucc]
      rw [e1]
      simp only [Fin.snoc_last]
    rw [key]
    have hprod : ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ =
        (∏ i : Fin k, ‖m i‖) * ‖w‖ := by
      rw [Fin.prod_univ_castSucc]
      simp [Fin.snoc_castSucc, Fin.snoc_last]
    calc _ ≤ ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ *
          ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ :=
          ContinuousMultilinearMap.le_opNorm _ _
      _ = ‖w‖ * ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ *
          ∏ i : Fin k, ‖m i‖ := by rw [hprod]; ring

  have Gm : ∀ (γ : Lab) (m : ℤ) (ξ : Cyl), ξ ∉ tsupport (d γ m) →
      (fun η => fderiv ℝ (d γ m) η (dVdir B.h γ.1)) =ᶠ[nhds ξ] fun _ => (0 : Fin 3 → ℂ) := by
    intro γ m ξ hts
    have h0 : d γ m =ᶠ[nhds ξ] 0 := notMem_tsupport_iff_eventuallyEq.mp hts
    filter_upwards [h0.eventuallyEq_nhds] with η hη
    show fderiv ℝ (d γ m) η (dVdir B.h γ.1) = 0
    rw [hη.fderiv_eq]
    simp

  have hED : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 < edgeDist B.Xa B.Xb X := by
    intro X h1 h2
    have hX0 : 0 < X := lt_trans hXa h1
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr h1))
      (Real.log_pos ((one_lt_div hX0).mpr h2)))
  have key6 : ∀ (C x1 x2 x3 x4 x5 : ℝ), 0 ≤ x1 → 0 ≤ x2 → 0 ≤ x3 → 0 ≤ x4 → 0 ≤ x5 →
      C * x1 * x2 * x3 * x4 * x5 ≤ |C| * x1 * x2 * x3 * x4 * x5 ∧
        0 ≤ |C| * x1 * x2 * x3 * x4 * x5 := by
    intro C x1 x2 x3 x4 x5 h1 h2 h3 h4 h5
    have hx := mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg h1 h2) h3) h4) h5
    constructor
    · calc C * x1 * x2 * x3 * x4 * x5 = C * (x1 * x2 * x3 * x4 * x5) := by ring
        _ ≤ |C| * (x1 * x2 * x3 * x4 * x5) := mul_le_mul_of_nonneg_right (le_abs_self C) hx
        _ = |C| * x1 * x2 * x3 * x4 * x5 := by ring
    · calc (0:ℝ) ≤ |C| * (x1 * x2 * x3 * x4 * x5) := mul_nonneg (abs_nonneg C) hx
        _ = |C| * x1 * x2 * x3 * x4 * x5 := by ring
  obtain ⟨H, hH0, hHz⟩ := hd.1
  refine ⟨⟨H, hH0, fun γ m hm => ?_⟩, fun γ m => ?_, fun γ m ξ hξ c hc => ?_, fun γ m ξ hξ hne => ?_,
    fun k => ?_⟩
  ·
    funext ξ
    show fderiv ℝ (d γ m) ξ (dVdir B.h γ.1) = 0
    rw [hHz γ m hm]
    simp
  ·
    show ContDiffOn ℝ ∞ (fun ξ => fderiv ℝ (d γ m) ξ (dVdir B.h γ.1)) (DomC B.h (qsOf l0))
    exact ((hd.2.1 γ m).fderiv_of_isOpen hDo (by exact_mod_cast le_top)).clm_apply contDiffOn_const
  ·
    show fderiv ℝ (d γ m) (shY ξ c) (dVdir B.h γ.1) = fderiv ℝ (d γ m) ξ (dVdir B.h γ.1)
    have hloc : ∀ᶠ η in nhds ξ, d γ m (shY η c) = d γ m η := by
      filter_upwards [hDo.mem_nhds hξ, deck_locally_stable_v5 B l0 hok (by omega) ξ hξ c hc]
        with η hη hdη
      exact hd.2.2.1 γ m η hη c hdη
    obtain ⟨e, he⟩ : ∃ e : Cyl, e = ((0:ℝ), (0:ℝ), (0:ℝ), c) := ⟨_, rfl⟩
    have hsh : ∀ η : Cyl, shY η c = η + e := by
      intro η
      rw [he]
      simp only [shY]
      ext <;> simp
    have hfd : fderiv ℝ (d γ m) (shY ξ c) = fderiv ℝ (d γ m) ξ := by
      have hev : (fun x => d γ m (x + e)) =ᶠ[nhds ξ] d γ m :=
        hloc.mono (fun η hη => by
          show d γ m (η + e) = d γ m η
          rw [← hsh η, hη])
      rw [hsh ξ, ← fderiv_comp_add_right]
      exact hev.fderiv_eq
    rw [hfd]
  ·
    by_cases hts : ξ ∈ tsupport (d γ m)
    · exact (Hp l0 (by omega) β d hd γ m ξ hξ hts).1
    · exact absurd (Gm γ m ξ hts).eq_of_nhds hne
  ·
    obtain ⟨C, b, dd, hC⟩ := hd.2.2.2.2 (k + 1)
    refine ⟨|C|, b, dd, fun γ m ξ hξ hX1 hX2 => ?_⟩
    have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
    have hk := key6 C (qC B.h ξ ^ (B.h * β)) (SC B.h ξ ^ b)
      (Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)))
      (edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd)) (Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2))
      (Real.rpow_nonneg hq0.le _) (Real.rpow_nonneg (by unfold SC; positivity) _)
      (Real.sqrt_nonneg _) (Real.rpow_nonneg (hED _ hX1 hX2).le _)
      (by unfold Penv5; exact (Real.exp_pos _).le)
    show NB B.h (fun η => fderiv ℝ (d γ m) η (dVdir B.h γ.1)) k ξ ≤ _
    by_cases hts : ξ ∈ tsupport (d γ m)
    · obtain ⟨w, hw, hwn⟩ := hframe γ.1 ξ (Hp l0 (by omega) β d hd γ m ξ hξ hts).2.2.2.1
      have h1 := nbdir ξ (d γ m) w hξ (hd.2.1 γ m) k
      rw [hw] at h1
      calc NB B.h (fun η => fderiv ℝ (d γ m) η (dVdir B.h γ.1)) k ξ
          ≤ ‖w‖ * NB B.h (d γ m) (k + 1) ξ := h1
        _ ≤ NB B.h (d γ m) (k + 1) ξ := mul_le_of_le_one_left (norm_nonneg _) hwn
        _ ≤ _ := hC γ m ξ hξ hX1 hX2
        _ ≤ _ := hk.1
    · have hev := Gm γ m ξ hts
      have hz : NB B.h (fun η => fderiv ℝ (d γ m) η (dVdir B.h γ.1)) k ξ = 0 := by
        unfold NB
        rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_zero, Pi.zero_apply]
        have h0 : ((0 : ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) (Fin 3 → ℂ)).compContinuousLinearMap
            fun _ => Lnorm B.h ξ) = 0 := by
          ext v
          simp
        rw [h0, norm_zero]
      rw [hz]
      exact hk.2

theorem prin_mat_coeffs_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C b : ℝ, ∀ (l0 : ℕ), l1 ≤ l0 → ∀ (γ : Lab) (m : ℤ), ActiveL4 B G γ → l0 ≤ γ.1 → ∀ ξ ∈ DomC B.h (qsOf l0), 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 → B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → ∀ i j : Fin 3, ContDiffAt ℝ ∞ (fun η => prinMat5 B G γ m η i j) ξ ∧ NB B.h (fun η => prinMat5 B G γ m η i j) k ξ ≤ C * (1 + (m : ℝ) ^ 2) * SC B.h ξ ^ b ∧ ∀ c : ℝ × ℝ, IsDeck B.h (qC B.h ξ) c → prinMat5 B G γ m (shY ξ c) i j = prinMat5 B G γ m ξ i j :=
by
  intro B G hok hG
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  have hSN : SimNorm B.h := simscale_normalized_v4 B.h hh0 hh1 hok.1
  obtain ⟨lK, HK⟩ := good_kmat_nb_v5 B G hok hG
  obtain ⟨lN, HN⟩ := good_nphi5_nb_v5 B G hok hG
  obtain ⟨lg, Hg⟩ := band_coarse_gap_v5 B.h hh0 hh1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  obtain ⟨hD1o, hq1sm, hq1pos, -⟩ := domc_open_calculus B 1 hok

  have hrho : ∀ k : ℕ, ∃ K : ℝ, 0 ≤ K ∧ ∀ (Q : ℝ), 0 < Q → ∀ ξ ∈ DomC B.h 1,
      NB B.h (fun η : Cyl => (qC B.h η / Q) ^ (1 + B.h)) k ξ ≤ K * (qC B.h ξ / Q) ^ (1 + B.h) := by
    intro k
    obtain ⟨C0, hC0⟩ := nb_qpow_v4 B 1 (1 + B.h) hok hSN one_pos le_rfl k
    refine ⟨|C0|, abs_nonneg _, fun Q hQ ξ hξ => ?_⟩
    have hg : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (1 + B.h)) (DomC B.h 1) :=
      hq1sm.rpow_const_of_ne (fun η hη => (hq1pos η hη).ne')
    obtain ⟨a, ha⟩ : ∃ a : ℝ, a = (Q ^ (1 + B.h))⁻¹ := ⟨_, rfl⟩
    have ha0 : 0 ≤ a := by rw [ha]; exact inv_nonneg.mpr (Real.rpow_nonneg hQ.le _)
    have hev : (fun η : Cyl => (qC B.h η / Q) ^ (1 + B.h)) =ᶠ[nhds ξ]
        (fun η => a * qC B.h η ^ (1 + B.h) + 0 * qC B.h η ^ (1 + B.h)) := by
      filter_upwards [hD1o.mem_nhds hξ] with η hη
      rw [Real.div_rpow (hq1pos η hη).le hQ.le, ha]
      ring
    have hNBeq : NB B.h (fun η : Cyl => (qC B.h η / Q) ^ (1 + B.h)) k ξ =
        NB B.h (fun η => a * qC B.h η ^ (1 + B.h) + 0 * qC B.h η ^ (1 + B.h)) k ξ := by
      unfold NB
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    have hlin := (nb_real_algebra_v5 B.h (DomC B.h 1) ξ hD1o hξ _ _ hg hg k).2.1 a 0
    rw [abs_zero, zero_mul, add_zero, abs_of_nonneg ha0] at hlin
    rw [hNBeq]
    refine le_trans hlin ?_
    have hq0 := hq1pos ξ hξ
    calc a * NB B.h (fun η => qC B.h η ^ (1 + B.h)) k ξ ≤ a * (|C0| * qC B.h ξ ^ (1 + B.h)) := by
          apply mul_le_mul_of_nonneg_left _ ha0
          exact le_trans (hC0 ξ hξ)
            (mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hq0.le _))
      _ = |C0| * (qC B.h ξ / Q) ^ (1 + B.h) := by
          rw [Real.div_rpow hq0.le hQ.le, ha]; ring

  have hdot : ∀ (U : Set Cyl) (ξ : Cyl) (N : Cyl → (Fin 3 → ℝ)) (e A : ℝ) (k : ℕ), IsOpen U → ξ ∈ U →
      (∀ t : Fin 3, ContDiffOn ℝ ∞ (fun η => N η t) U) →
      (∀ t : Fin 3, ∀ i : ℕ, i ≤ k → NB B.h (fun η => N η t) i ξ ≤ A) →
      NB B.h (fun η => e * dotProduct (N η) (N η)) k ξ ≤ |e| * (3 * (2 ^ k * A * A)) := by
    intro U ξ N e A k hU hξ hN hA
    obtain ⟨F, hFdef⟩ : ∃ F : Fin 3 → Cyl → ℝ, F = fun t η => N η t * N η t := ⟨_, rfl⟩
    have hF : ∀ t, ContDiffOn ℝ ∞ (F t) U := by
      intro t; rw [hFdef]; exact (hN t).mul (hN t)
    have hFb : ∀ t, NB B.h (F t) k ξ ≤ 2 ^ k * A * A := by
      intro t; rw [hFdef]
      exact nb_real_mul_le_v5 B.h ξ (fun η => N η t) (fun η => N η t) k A A
        ((hN t).contDiffAt (hU.mem_nhds hξ)) ((hN t).contDiffAt (hU.mem_nhds hξ)) (hA t) (hA t)
    obtain ⟨S1, hS1⟩ : ∃ S1 : Cyl → ℝ, S1 = fun η => 1 * F 0 η + 1 * F 1 η := ⟨_, rfl⟩
    have hS1c : ContDiffOn ℝ ∞ S1 U := by
      rw [hS1]; exact (contDiffOn_const.mul (hF 0)).add (contDiffOn_const.mul (hF 1))
    have hS1b : NB B.h S1 k ξ ≤ 2 * (2 ^ k * A * A) := by
      have h := (nb_real_algebra_v5 B.h U ξ hU hξ (F 0) (F 1) (hF 0) (hF 1) k).2.1 1 1
      rw [abs_one, one_mul, one_mul] at h
      rw [hS1]; linarith [hFb 0, hFb 1]
    obtain ⟨S, hS⟩ : ∃ S : Cyl → ℝ, S = fun η => 1 * S1 η + 1 * F 2 η := ⟨_, rfl⟩
    have hSc : ContDiffOn ℝ ∞ S U := by
      rw [hS]; exact (contDiffOn_const.mul hS1c).add (contDiffOn_const.mul (hF 2))
    have hSb : NB B.h S k ξ ≤ 3 * (2 ^ k * A * A) := by
      have h := (nb_real_algebra_v5 B.h U ξ hU hξ S1 (F 2) hS1c (hF 2) k).2.1 1 1
      rw [abs_one, one_mul, one_mul] at h
      rw [hS]; linarith [hFb 2]
    have hE := (nb_real_algebra_v5 B.h U ξ hU hξ S S hSc hSc k).2.1 e 0
    rw [abs_zero, zero_mul, add_zero] at hE
    have hfun : (fun η => e * dotProduct (N η) (N η)) = fun η => e * S η + 0 * S η := by
      funext η
      rw [hS, hS1, hFdef]
      simp only [dotProduct, Fin.sum_univ_three]
      ring
    rw [hfun]
    exact le_trans hE (mul_le_mul_of_nonneg_left hSb (abs_nonneg e))

  have hekb : ∀ l : ℕ, |epsb B.h l * ((kb B.h l : ℕ) : ℝ) ^ 2| ≤ 4 := by
    intro l
    have hQl : 0 < Qb l := Real.rpow_pos_of_pos (by norm_num) _
    have hQl1 : Qb l ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
    have hε0 : 0 < epsb B.h l := Real.rpow_pos_of_pos hQl _
    have hε1 : epsb B.h l ≤ 1 := Real.rpow_le_one hQl.le hQl1 hh0.le
    obtain ⟨x, hx⟩ : ∃ x : ℝ, x = epsb B.h l ^ (-(1/2:ℝ)) := ⟨_, rfl⟩
    have hx1 : 1 ≤ x := by
      rw [hx]; exact Real.one_le_rpow_of_pos_of_le_one_of_nonpos hε0 hε1 (by norm_num)
    have hx2 : epsb B.h l * x ^ 2 = 1 := by
      rw [hx, ← Real.rpow_natCast, ← Real.rpow_mul hε0.le]
      have e2 : (-(1/2:ℝ)) * ((2:ℕ):ℝ) = -1 := by norm_num
      rw [e2, Real.rpow_neg_one, mul_inv_cancel₀ hε0.ne']
    have hk2 : ((kb B.h l : ℕ) : ℝ) < x + 1 := by
      rw [hx]; exact Nat.ceil_lt_add_one (Real.rpow_nonneg hε0.le _)
    have hkk : ((kb B.h l : ℕ) : ℝ) ^ 2 ≤ (2 * x) ^ 2 :=
      pow_le_pow_left₀ (Nat.cast_nonneg _) (by linarith) 2
    have hpos : 0 ≤ epsb B.h l * ((kb B.h l : ℕ) : ℝ) ^ 2 := mul_nonneg hε0.le (sq_nonneg _)
    rw [abs_of_nonneg hpos]
    calc epsb B.h l * ((kb B.h l : ℕ) : ℝ) ^ 2 ≤ epsb B.h l * (2 * x) ^ 2 :=
          mul_le_mul_of_nonneg_left hkk hε0.le
      _ = 4 * (epsb B.h l * x ^ 2) := by ring
      _ = 4 := by rw [hx2]; ring

  refine ⟨lK + lN + lg + n0, fun k => ?_⟩
  choose CKf hCK using HK
  choose CNf hCN using HN
  choose Krf hKr0 hKr using hrho
  obtain ⟨AKc, hAKc⟩ : ∃ x : ℝ, x = ∑ i ∈ Finset.range (k + 1), |CKf i| := ⟨_, rfl⟩
  obtain ⟨ANc, hANc⟩ : ∃ x : ℝ, x = ∑ i ∈ Finset.range (k + 1), |CNf i| := ⟨_, rfl⟩
  obtain ⟨Arc, hArc⟩ : ∃ x : ℝ, x = 16 * ∑ i ∈ Finset.range (k + 1), Krf i := ⟨_, rfl⟩
  obtain ⟨ADc, hADc⟩ : ∃ x : ℝ, x = 12 * 2 ^ k * ANc ^ 2 := ⟨_, rfl⟩
  have hAK0 : 0 ≤ AKc := by rw [hAKc]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have hAN0 : 0 ≤ ANc := by rw [hANc]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
