    obtain ⟨S1, hS1, hI1⟩ := ha l0 (by omega) S Bo hBo hSt
    obtain ⟨S2, hS2, hI2⟩ := hb l0 (by omega) S1 Bo hBo hS1
    obtain ⟨S3, hS3, hI3⟩ := hc l0 (by omega) S2 Bo hBo hS2
    obtain ⟨S4, hS4, hI4⟩ := hd l0 (by omega) S3 Bo hBo hS3
    refine ⟨S4, anti4 S4 _ _ _ _ _ _ _ _ hS4 (by linarith [hk]) (by linarith [hk])
