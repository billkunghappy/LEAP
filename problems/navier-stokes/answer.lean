    · intro γ m ξ hξ hne c hc
      have hts : ξ ∈ tsupport (d γ m) := subset_tsupport _ hne
      obtain ⟨-, hA, hl, h1, h2, h3, h4, h5, h6⟩ := Hp l0 (by omega) β d hd γ m ξ hξ hts
      obtain ⟨C, b, hCb⟩ := H4 0
      ext i j
      exact (hCb l0 (by omega) γ m hA hl ξ hξ h1 h2 h3 h4 h5 h6 i j).2.2 c hc
    · intro k
      obtain ⟨C, b, hCb⟩ := H4 k
      refine ⟨|C| * (1 + ∑ m' ∈ H, ((m' : ℝ)) ^ 2), b, fun γ m ξ hξ hts _ _ i j => ?_⟩
      obtain ⟨-, hA, hl, h1, h2, h3, h4, h5, h6⟩ := Hp l0 (by omega) β d hd γ m ξ hξ hts
      have hb := (hCb l0 (by omega) γ m hA hl ξ hξ h1 h2 h3 h4 h5 h6 i j).2.1
      have hmH : m ∈ H := by
        by_contra hm
        rw [hHz γ m hm] at hts
        simp at hts
      have hm2 : ((m : ℝ)) ^ 2 ≤ ∑ m' ∈ H, ((m' : ℝ)) ^ 2 :=
        Finset.single_le_sum (f := fun m' : ℤ => ((m' : ℝ)) ^ 2) (fun _ _ => sq_nonneg _) hmH
      have hSC : 0 ≤ SC B.h ξ ^ b := Real.rpow_nonneg (by unfold SC; positivity) b
      have e : qC B.h ξ ^ (B.h * 0) = 1 := by simp
      rw [e, mul_one]
      calc NB B.h (fun η => prinMat5 B G γ m η i j) k ξ ≤ C * (1 + (m : ℝ) ^ 2) * SC B.h ξ ^ b := hb
        _ ≤ |C| * (1 + ∑ m' ∈ H, ((m' : ℝ)) ^ 2) * SC B.h ξ ^ b := by
          apply mul_le_mul_of_nonneg_right _ hSC
          exact le_trans (mul_le_mul_of_nonneg_right (le_abs_self C) (by positivity))
            (mul_le_mul_of_nonneg_left (by linarith) (abs_nonneg C))

  have hsum := (pwr5_waveV_add B G hok (qsOf l0) hq1 _ _ (β + 0) (β + 0) hT1 hT2).1
  rw [min_self, add_zero] at hsum

  have hpt : ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      primOp5 B G (fun γ m η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • d γ m η) γ m ξ =
        ((fun γ m ξ => μ γ ξ • dVc B γ.1 (d γ m) ξ) +
          (fun γ m ξ => (pulseMatC (prinMat5 B G γ m ξ)).mulVec (d γ m ξ)) : WC) γ m ξ := by
    intro γ m ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hdiff : DifferentiableAt ℝ (d γ m) ξ :=
      ((hd.2.1 γ m).contDiffAt (hDo.mem_nhds hξ)).differentiableAt (by norm_num)
    rw [prin_small_pointwise_v5 B G d γ m ξ hok hξ'.2.1 hdiff, hμ]
    rfl
  obtain ⟨c1, c2, c3, c4, c5⟩ := hsum
  have hP : InWg5 B G (qsOf l0) β
      (primOp5 B G (fun γ m η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • d γ m η)) := by
    refine ⟨⟨H, hH0, fun γ m hm => ?_⟩, ?_, ?_, ?_, ?_⟩
    · funext ξ
      have h0 : d γ m = 0 := hHz γ m hm
      simp [primOp5, dVc, h0]
    · intro γ m
      exact (c2 γ m).congr (fun ξ hξ => hpt γ m ξ hξ)
    · intro γ m ξ hξ c hc
      have hsh : shY ξ c ∈ DomC B.h (qsOf l0) := hξ
      rw [hpt γ m _ hsh, hpt γ m ξ hξ]
      exact c3 γ m ξ hξ c hc
    · intro γ m ξ hξ hne
      apply c4 γ m ξ hξ
      rwa [← hpt γ m ξ hξ]
    · intro k
      obtain ⟨C, b, dd, hC⟩ := c5 k
      refine ⟨C, b, dd, fun γ m ξ hξ hX1 hX2 => ?_⟩
      have hev : primOp5 B G (fun γ m η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • d γ m η) γ m =ᶠ[nhds ξ]
          ((fun γ m ξ => μ γ ξ • dVc B γ.1 (d γ m) ξ) +
            (fun γ m ξ => (pulseMatC (prinMat5 B G γ m ξ)).mulVec (d γ m ξ)) : WC) γ m :=
        Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => hpt γ m η hη)
      have hb := hC γ m ξ hξ hX1 hX2
      unfold NB at hb ⊢
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      exact hb

  have hpos : ∀ z t : ℝ, t < 1 → 0 < simScale B.h z (1 - t) := fun z t ht =>
    (hok.1.1 z (1 - t) (by linarith)).1
  have key0 : ∀ (C q a a' : ℝ), 0 < q → q ≤ 1 → a' ≤ a →
      C * q ^ (B.h * a) ≤ |C| * q ^ (B.h * a') := by
    intro C q a a' hq0 hq1' haa
    calc C * q ^ (B.h * a) ≤ |C| * q ^ (B.h * a) :=
          mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0.le _)
      _ ≤ |C| * q ^ (B.h * a') :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0 hq1'
            (mul_le_mul_of_nonneg_left haa hh.le)) (abs_nonneg C)
  have hED : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 < edgeDist B.Xa B.Xb X := by
    intro X h1 h2
    have hX0 : 0 < X := lt_trans hXa h1
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr h1))
      (Real.log_pos ((one_lt_div hX0).mpr h2)))
  have hSC : ∀ (ξ : Cyl) (b : ℝ), 0 ≤ SC B.h ξ ^ b := by
    intro ξ b
    exact Real.rpow_nonneg (by unfold SC; positivity) b
  have hW : ∀ (a : WC) (α α' : ℝ),
      α' ≤ α → InWg5 B G (qsOf l0) α a → InWg5 B G (qsOf l0) α' a := by
    intro a α α' hαα ha
    obtain ⟨e1, e2, e3, e4, e5⟩ := ha
    refine ⟨e1, e2, e3, e4, fun k => ?_⟩
    obtain ⟨C, b, dd, hC⟩ := e5 k
    refine ⟨|C|, b, dd, fun γ m ξ hξ hX1 hX2 => ?_⟩
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hq0 : 0 < qC B.h ξ := hpos ξ.2.1 ξ.2.2.1 hξ'.2.1
    have hq1' : qC B.h ξ ≤ 1 := le_trans hξ'.2.2.le hq1
    refine le_trans (hC γ m ξ hξ hX1 hX2) ?_
    apply mul_le_mul_of_nonneg_right _ (by unfold Penv5; exact (Real.exp_pos _).le)
    apply mul_le_mul_of_nonneg_right _ (Real.rpow_pos_of_pos (hED _ hX1 hX2) _).le
    apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
    exact mul_le_mul_of_nonneg_right (key0 C _ α α' hq0 hq1' hαα) (hSC ξ b)
  have hκ : (0:ℝ) < kapS := by rw [hk]; norm_num
  exact hW _ β (β - 2 * kapS) (by linarith) hP

theorem plin5_remainder_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → InWg5 B G (qsOf l0) (1/2) (W0h4 B G) → (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), dotProduct (nPhi5 B G γ ξ) (W0c4 B G γ ξ) = 0) → InWg5 B G (qsOf l0) 1 (primState5 B G).Aw → InWg5 B G (qsOf l0) 1 (primState5 B G).pw → InWg5 B G (qsOf l0) (1/2) (velW5 B G (primState5 B G).Aw) → InWg5 B G (qsOf l0) (1 - kapS) (velW5 B G (primState5 B G).Aw - W0h4 B G) → InWg5 B G (qsOf l0) (1 - 3 * kapS) (linC5 B G - princC5 B G) :=
by
  intro B G hok hG
  obtain ⟨l1, h1⟩ := plin5_rem_split B G hok hG
  obtain ⟨l2, h2⟩ := wmo_amp_class_v5 B G hok hG
  obtain ⟨l3, h3⟩ := plin5_ampD_class B G hok hG
  obtain ⟨l4, h4⟩ := plin5_slow_class B G hok hG
  obtain ⟨l5, h5⟩ := plin5_pres_class B G hok hG
  obtain ⟨l6, h6⟩ := plin5_phase_class B G hok hG
  obtain ⟨l7, h7⟩ := plin5_visc_class B G hok hG
  obtain ⟨l8, h8⟩ := plin5_base_class B G hok hG
  obtain ⟨l9, h9⟩ := plin5_prin_small_class B G hok hG
  refine ⟨l1 + l2 + l3 + l4 + l5 + l6 + l7 + l8 + l9, fun l0 hl0 hW0 _htr hAw hpw hvel hdiff => ?_⟩
  have hS : SimScaleProps B.h := hok.1
  have hq1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have eh : (1/2 : ℝ) + 1/2 = 1 := by norm_num
  have e1 : (1/2 : ℝ) + 1/2 - 3 * kapS = 1 - 3 * kapS := by norm_num
  have e2 : (1 : ℝ) - kapS - 2 * kapS = 1 - 3 * kapS := by ring
  have hAw' : InWg5 B G (qsOf l0) (1/2 + 1/2) (primState5 B G).Aw := by rw [eh]; exact hAw
  have hpw' : InWg5 B G (qsOf l0) (1/2 + 1/2) (primState5 B G).pw := by rw [eh]; exact hpw

  have hw : InWg5 B G (qsOf l0) (1/2) (wmoAmp5 B G (primState5 B G).Aw) :=
    (h2 l0 (by omega)).1 _ (1/2) hAw' hvel

  have P1 : InWg5 B G (qsOf l0) (1 - 3 * kapS) (remSlow5 B (ampA5 B G)) := by
    have := h4 l0 (by omega) (1/2) _ hw
    rw [e1] at this
    exact this
  have P2 : InWg5 B G (qsOf l0) (1 - 3 * kapS) (remPhase5 B G (ampA5 B G)) := by
    have := h6 l0 (by omega) (1/2) _ hw
    rw [e1] at this
    exact this
  have P3 : InWg5 B G (qsOf l0) (1 - 3 * kapS) (remPres5 B (presP5 B G)) := by
    have := h5 l0 (by omega) (1/2) _ hpw'
    rw [e1] at this
    exact this
  have P4 : InWg5 B G (qsOf l0) (1 - 3 * kapS) (remVisc5 B G (ampA5 B G)) := by
    have := h7 l0 (by omega) (1/2) _ hw
    rw [e1] at this
    exact this
  have P5 : InWg5 B G (qsOf l0) (1 - 3 * kapS) (remBase5 B (ampA5 B G)) := by
    have := h8 l0 (by omega) (1/2) _ hw
    rw [e1] at this
    exact this
  have hD : InWg5 B G (qsOf l0) (1 - kapS) (ampD5 B G) := h3 l0 (by omega) hAw hW0 hdiff
  have P6 : InWg5 B G (qsOf l0) (1 - 3 * kapS)
      (primOp5 B G (fun γ' m' η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • ampD5 B G γ' m' η)) := by
    have := h9 l0 (by omega) (1 - kapS) _ hD
    rw [e2] at this
    exact this

  have addc : ∀ f g : WC, InWg5 B G (qsOf l0) (1 - 3 * kapS) f → InWg5 B G (qsOf l0) (1 - 3 * kapS) g →
      InWg5 B G (qsOf l0) (1 - 3 * kapS) (f + g) := by
    intro f g hf hg
    have := (pwr5_waveV_add B G hok (qsOf l0) hq1 f g _ _ hf hg).1
    rwa [min_self] at this
  have hSum := addc _ _ (addc _ _ (addc _ _ (addc _ _ (addc _ _ P1 P2) P3) P4) P5) P6
  have hsplit := h1 l0 (by omega) hAw hpw hW0

  have hDo : IsOpen (DomC B.h (qsOf l0)) := by
    have h4c := hS.2.2.2.1.continuousOn
    have hm : MapsTo (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1} (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have hξ' : ξ.2.2.1 < 1 := hξ
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hcont : ContinuousOn (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1} :=
      h4c.comp (f := fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) (Continuous.continuousOn (by fun_prop)) hm
    have e : DomC B.h (qsOf l0) = {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩
        (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) ⁻¹' Iio (qsOf l0)) := by
      ext ξ
      exact Iff.rfl
    rw [e]
    exact (isOpen_lt continuous_const continuous_fst).inter
      (hcont.isOpen_inter_preimage (isOpen_lt (by fun_prop) continuous_const) isOpen_Iio)

  have hcurl0 : ∀ n : ℤ, mcurlC B.h n (fun _ => (0 : Fin 3 → ℂ)) = fun _ => 0 := by
    intro n
    funext ξ
    ext i
    fin_cases i <;> simp [mcurlC, dZ, dR]
  have hdZ0 : dZ (fun _ : Cyl => (0 : ℂ)) = fun _ => 0 := by
    funext ξ; simp [dZ]
  have hdR0 : dR B.h (fun _ : Cyl => (0 : ℂ)) = fun _ => 0 := by
    funext ξ; simp [dR]
  have hdT0 : dT (fun _ : Cyl => (0 : ℂ)) = fun _ => 0 := by
    funext ξ; simp [dT]
  have hres0 : ∀ (n : ℤ) (ξ : Cyl), mresC B n (fun _ => (0 : Fin 3 → ℂ)) (fun _ => (0 : ℂ)) ξ = 0 := by
    intro n ξ
    ext i
    fin_cases i <;> simp [mresC, mlapC, hdZ0, hdR0, hdT0]
  have hcl1 : ∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → (linC5 B G - princC5 B G) γ m = 0 := by
    refine ⟨{1, -1}, by simp, fun γ m hm => ?_⟩
