    exact mul_le_mul (mul_le_mul hR hBs hBs0 (Real.sqrt_nonneg _)) hbr (abs_nonneg _)
      (mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))

  have hy : |(kb B.h γ.1 : ℝ) * ptil5 B G γ| * q ≤ 3 * Cp := by
    rw [abs_mul, Nat.abs_cast]
    have hkq : (kb B.h γ.1 : ℝ) * q ≤ 3 := by
      have h1 : (kb B.h γ.1 : ℝ) * q ≤ (2 / q + 1) * q := mul_le_mul_of_nonneg_right hkbq hq0.le
      rw [add_mul, div_mul_cancel₀ _ hq0.ne', one_mul] at h1
      linarith
    calc (kb B.h γ.1 : ℝ) * |ptil5 B G γ| * q = ((kb B.h γ.1 : ℝ) * q) * |ptil5 B G γ| := by ring
      _ ≤ 3 * Cp := mul_le_mul hkq hptil (abs_nonneg _) (by norm_num)
  unfold pint5
  rw [le_div_iff₀ hq0]
  split_ifs with h0
  · rw [Int.cast_one, abs_one, one_mul]
    linarith
  · have hr := abs_sub_round ((kb B.h γ.1 : ℝ) * ptil5 B G γ)
    have htri : |((round ((kb B.h γ.1 : ℝ) * ptil5 B G γ) : ℤ) : ℝ)| ≤
        |(kb B.h γ.1 : ℝ) * ptil5 B G γ| + 1/2 := by
      have h1 := abs_sub_abs_le_abs_sub ((round ((kb B.h γ.1 : ℝ) * ptil5 B G γ) : ℤ) : ℝ)
        ((kb B.h γ.1 : ℝ) * ptil5 B G γ)
      rw [abs_sub_comm] at h1
