      exact mul_nonneg (mul_nonneg (mul_nonneg hCP0 (Real.rpow_nonneg hσ0 _)) hζ0) (Real.rpow_nonneg hδ0.le _)
    have hyb : ∀ i : ℕ, 1 ≤ i → i ≤ k → NB B.h (yAmp4 B G γ) i ξ ≤ A := by
      intro i _ hi
      have := hm (CN i) (bN i) (dN i) CP bP dP 1 (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ))
        (by rw [hCP]; exact hsum CN i hi) (by rw [hbP]; exact hsum bN i hi)
        (by rw [hdP]; exact hsum dN i hi) zero_le_one hζ0
      simp only [mul_one] at this
      rw [hAdef]; exact le_trans (hNi i).2.2.1 this
    have h0 := hK2 B.h V (yAmp4 B G γ) ξ A hVo hyV (fun η hη => (hVmem η hη).2.2) hξV hA0 hyb j hj
    refine le_trans h0 ?_
    have r1 : yAmp4 B G γ ξ ^ (-(1/2:ℝ)) ≤ (c * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) ^ (-(1/2:ℝ)) :=
      Real.rpow_le_rpow_of_nonpos hcz hy0 (by norm_num)
    have r2 : A / yAmp4 B G γ ξ ≤ A / (c * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) :=
      div_le_div_of_nonneg_left hA0 hcz hy0
    have r3gen : ∀ (Cp s d z : ℝ), z ≠ 0 → Cp * s * z * d / (c * z) = Cp / c * (s * d) := by
      intro Cp s d z hz
      have hcne : c ≠ 0 := hc.ne'
