      ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ => (C * Fn z.1 z.2)⁻¹) (X, η)‖ ≤ Kder m ∧
      ‖iteratedFDeriv ℝ m (↿Un) (X, η)‖ ≤ Kder m :=
by
  intro h Pst Pax j0 σ δ ρ Pc r M Λ0 A χc ζc ℓc zc Ξ hD hj0 hj0' hAD hCD hMaj
  have hσ : 0 < σ := hAD.1
