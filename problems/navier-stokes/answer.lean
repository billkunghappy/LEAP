      exact (s3L (fun x => U x η * (2 * x * F x η)) (fun x => U' x η * (2 * x * F' x η)) s2 hs20
        (fun x hx => by
          have hq := hag x η (Or.inr hx.le)
          simp only [hq.1, hq.2]) (pk'.2.2.1.sub pk.2.2.1) j1).trans z1
    · have j1 : (∫ x in (0:ℝ)..s2, ((U' x η ^ 2 - x * F' x η ^ 2) - (U x η ^ 2 - x * F x η ^ 2))) = 0 := by
        rw [intervalIntegral.integral_sub pk'.2.2.2.1 pk.2.2.2.1]
        linarith
      exact (s3L (fun x => U x η ^ 2 - x * F x η ^ 2) (fun x => U' x η ^ 2 - x * F' x η ^ 2) s2 hs20
        (fun x hx => by
          have hq := hag x η (Or.inr hx.le)
          simp only [hq.1, hq.2]) (pk'.2.2.2.1.sub pk.2.2.2.1) j1).trans z2
    · have e : (fun x : ℝ => (2 * x * F' x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h))) -
          (2 * x * F x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h)))) =
          fun x : ℝ => 2 * x * F' x η - 2 * x * F x η := by
        funext x; ring
      have ii : IntervalIntegrable (fun x : ℝ => (2 * x * F' x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h))) -
          (2 * x * F x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h)))) volume 0 s2 := by
        rw [e]; exact pk'.2.1.sub pk.2.1
      have j1 : (∫ x in (0:ℝ)..s2, ((2 * x * F' x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h))) -
          (2 * x * F x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h))))) = 0 := by
        rw [e, intervalIntegral.integral_sub pk'.2.1 pk.2.1]
        linarith
      exact (s3L (fun x => 2 * x * F x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h)))
        (fun x => 2 * x * F' x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h))) s2 hs20
        (fun x hx => by
          have hq := hag x η (Or.inr hx.le)
          simp only [hq.1]) ii j1).trans z3
  case LP10 =>
    intro m
    obtain ⟨C, N, hC⟩ := J13 m
    refine ⟨C, N, fun X η h1 h2 e1 e2 => ?_⟩
    have hev : (fun w : ℝ × ℝ => Real.sqrt (2 * w.1) * F' w.1 w.2 -
          cinf * w.1 ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - w.2 ^ 2) / w.1))
        =ᶠ[nhds ((X, η) : ℝ × ℝ)] (fun w : ℝ × ℝ => Real.sqrt (2 * w.1) * F w.1 w.2 -
          cinf * w.1 ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - w.2 ^ 2) / w.1)) :=
      Filter.eventuallyEq_of_mem ((isOpen_Ioi.prod isOpen_univ).mem_nhds
          (show ((X, η) : ℝ × ℝ) ∈ Ioi s2 ×ˢ (univ : Set ℝ) from ⟨show s2 < X by linarith, mem_univ _⟩))
        (fun w hw => by simp only [(hag w.1 w.2 (Or.inr (le_of_lt hw.1))).1])
    rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
    exact hC X η h1 h2 e1 e2

theorem repair_assembly : RepairProperty → LeadPsRegularity → PsPerturbation → ConeGapQuadratic → ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xan Xm Xm2 Xp2 Xp r1 r2 : ℝ) (F U : ℝ → ℝ → ℝ) (FN UN : ℕ → ℝ → ℝ → ℝ), JoinProf h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xan Xm Xm2 Xp2 Xp r1 r2 F U → ModulatedFamily h Xm Xp F U FN UN → ∃ F' U' : ℝ → ℝ → ℝ, LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F' U' (fun X η => if -1 < η ∧ η < 1 then leadStressTh h F' U' X η else 0) (fun X η => if -1 < η ∧ η < 1 then leadStressTz h F' U' X η else 0) :=
by
  intro hRep hLPR hPP hCG h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xan Xm Xm2 Xp2 Xp r1 r2 F U FN UN hJ hM

  obtain ⟨ε, κ, Xm', s2, hε, hκ, hXm', hXm'p, hs2a, hs2b, hPR, hfam⟩ :=
    repair_construct hRep h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xan Xm Xm2 Xp2 Xp r1 r2 F U FN UN hJ hM

  obtain ⟨τ, hτ, hmid⟩ := middle_admblk hLPR hPP hCG h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xan Xm
    Xm2 Xp2 Xp r1 r2 ε κ F U hJ hε hPR hκ

  obtain ⟨F', U', hagree, hPR', hmom, hclose, hmarg, hshear⟩ := hfam τ hτ
  have hJ' := hJ
  obtain ⟨⟨hh0, hh1, hlam, hcinf, hcp, haa, hab, hXa, hXap1, hp12, hp2m1, hm12, hm2Xv, hXvXc, hXcXb,
    hXaXan, hXanXm, hXmXm2, hXm2Xp2, hXp2Xp, hXpr1, hr1r2, hr2p1⟩, -, -, hJadm, -, hJint, -, -, -, -, -, -, -,
    -⟩ := hJ'

  have hPi : ∀ η : ℝ, -1 < η → η < 1 → leadPi F' 0 η = leadPi F 0 η := by
    intro η e1 e2
    unfold leadPi
    rw [(hmom η e1 e2).1]

  have hMid := hmid F' U' hPR' hPi hclose hmarg hshear

  have hThE : ∀ (G V : ℝ → ℝ → ℝ) (X η : ℝ),
      leadStressTh h G V X η = G X η * (psLead1 h G V X η - shearA G X η) := fun _ _ _ _ => rfl
  have hTzE : ∀ (G V : ℝ → ℝ → ℝ) (X η : ℝ),
      leadStressTz h G V X η = G X η * (psLead2 h G V X η + shearB G V X η) := fun _ _ _ _ => rfl
  have hXm'0 : 0 < Xm' := by linarith
  have hs20 : 0 < s2 := by linarith
  have hstressL : ∀ X η : ℝ, 0 < X → X < Xm' → -1 < η → η < 1 →
      F' X η = F X η ∧ U' X η = U X η ∧ leadStressTh h F' U' X η = leadStressTh h F U X η ∧
        leadStressTz h F' U' X η = leadStressTz h F U X η := by
    intro X η hX0 hX e1 e2
    have hag := hagree X η (Or.inl hX.le)
    obtain ⟨c1, c2, c3, c4, c5⟩ := cone_data_local h Xm' F U F' U' hXm'0
      (fun x e _ hx _ _ => hagree x e (Or.inl hx.le))
      (fun e he1 he2 => ⟨(hJint e he1 he2).1, hPR'.2.2.2.2.1 e he1 he2, (hmom e he1 he2).1⟩)
      X η hX0 hX e1 e2
    refine ⟨hag.1, hag.2, ?_, ?_⟩
    · rw [hThE F' U', hThE F U, c1, c2, c4]
    · rw [hTzE F' U', hTzE F U, c1, c3, c5]
  have hstressR : ∀ X η : ℝ, s2 < X → -1 < η → η < 1 →
      F' X η = F X η ∧ U' X η = U X η ∧ leadStressTh h F' U' X η = leadStressTh h F U X η ∧
        leadStressTz h F' U' X η = leadStressTz h F U X η := by
    intro X η hX e1 e2
    have hag := hagree X η (Or.inr hX.le)
    obtain ⟨-, -, c3, c4⟩ := lead_stress_local h s2 F' U' F U hs20
      (fun x e hx _ _ => hagree x e (Or.inr hx.le))
      (fun e he1 he2 Y hY => by
        obtain ⟨i1, i2, i3, i4, -⟩ := (hmom e he1 he2).2.2.2.2.2 Y hY
        obtain ⟨j1, j2, j3, j4, -⟩ := (hJint e he1 he2).2 Y hY
        exact ⟨i1, j1, i2, j2, i3, j3, i4, j4⟩)
      (fun e he1 he2 => ⟨(hmom e he1 he2).2.1, (hmom e he1 he2).2.2.1, (hmom e he1 he2).2.2.2.1,
        (hmom e he1 he2).2.2.2.2.1⟩)
      X η hX e1 e2
    exact ⟨hag.1, hag.2, c3, c4⟩

  have hmono : ∀ (S T : Set ℝ) (G V : ℝ → ℝ → ℝ), T ⊆ S →
      AdmBlk h (edgeWeight Xa Xb aa ab) (edgeDist Xa Xb) S G V →
      AdmBlk h (edgeWeight Xa Xb aa ab) (edgeDist Xa Xb) T G V := by
    intro S T G V hTS hA
    obtain ⟨⟨c₀, hc₀, hlow⟩, hder, ⟨κ', hκ0, hκ2, hcone⟩⟩ := hA
    refine ⟨⟨c₀, hc₀, fun X hX => hlow X (hTS hX)⟩, fun m => ?_,
      ⟨κ', hκ0, hκ2, fun X hX => hcone X (hTS hX)⟩⟩
    obtain ⟨C, N, hb⟩ := hder m
    exact ⟨C, N, fun X hX => hb X (hTS hX)⟩

  have hcongr : ∀ (a b : ℝ) (S : Set ℝ), S ⊆ Ioo a b →
      (∀ X η : ℝ, a < X → X < b → -1 < η → η < 1 → F' X η = F X η ∧ U' X η = U X η ∧
        leadStressTh h F' U' X η = leadStressTh h F U X η ∧
        leadStressTz h F' U' X η = leadStressTz h F U X η) →
      AdmBlk h (edgeWeight Xa Xb aa ab) (edgeDist Xa Xb) S F U →
      AdmBlk h (edgeWeight Xa Xb aa ab) (edgeDist Xa Xb) S F' U' := by
    intro a b S hS hEq hA
    obtain ⟨⟨c₀, hc₀, hlow⟩, hder, ⟨κ', hκ0, hκ2, hcone⟩⟩ := hA
    have hO : IsOpen (Ioo a b ×ˢ Ioo (-1 : ℝ) 1) := isOpen_Ioo.prod isOpen_Ioo
    have hpt : ∀ X ∈ S, ∀ η : ℝ, -1 < η → η < 1 →
        F' X η = F X η ∧ U' X η = U X η ∧
        leadStressTh h F' U' X η = leadStressTh h F U X η ∧
        leadStressTz h F' U' X η = leadStressTz h F U X η :=
      fun X hX η e1 e2 => hEq X η (hS hX).1 (hS hX).2 e1 e2
    have hsh : ∀ X ∈ S, ∀ η : ℝ, -1 < η → η < 1 →
        shearA F' X η = shearA F X η ∧ shearB F' U' X η = shearB F U X η := by
      intro X hX η e1 e2
      have hXab := hS hX
      have hevF : (fun Y => F' Y η) =ᶠ[nhds X] (fun Y => F Y η) :=
        Filter.eventuallyEq_of_mem (isOpen_Ioo.mem_nhds hXab)
          (fun Y hY => (hEq Y η hY.1 hY.2 e1 e2).1)
      have hevU : (fun Y => U' Y η) =ᶠ[nhds X] (fun Y => U Y η) :=
        Filter.eventuallyEq_of_mem (isOpen_Ioo.mem_nhds hXab)
          (fun Y hY => (hEq Y η hY.1 hY.2 e1 e2).2.1)
      have e := hEq X η hXab.1 hXab.2 e1 e2
      constructor
      · unfold shearA
        rw [hevF.deriv_eq, e.1]
      · unfold shearB
        rw [hevU.deriv_eq, e.1]
    have hit : ∀ X ∈ S, ∀ η : ℝ, -1 < η → η < 1 → ∀ m : ℕ,
        iteratedFDeriv ℝ m (↿(leadStressTh h F' U')) (X, η) =
          iteratedFDeriv ℝ m (↿(leadStressTh h F U)) (X, η) ∧
        iteratedFDeriv ℝ m (↿(leadStressTz h F' U')) (X, η) =
          iteratedFDeriv ℝ m (↿(leadStressTz h F U)) (X, η) ∧
        iteratedFDeriv ℝ m (fun z : ℝ × ℝ => leadStressTh h F' U' z.1 z.2 /
            Real.sqrt (leadStressTh h F' U' z.1 z.2 ^ 2 + leadStressTz h F' U' z.1 z.2 ^ 2)) (X, η) =
          iteratedFDeriv ℝ m (fun z : ℝ × ℝ => leadStressTh h F U z.1 z.2 /
            Real.sqrt (leadStressTh h F U z.1 z.2 ^ 2 + leadStressTz h F U z.1 z.2 ^ 2)) (X, η) ∧
        iteratedFDeriv ℝ m (fun z : ℝ × ℝ => leadStressTz h F' U' z.1 z.2 /
            Real.sqrt (leadStressTh h F' U' z.1 z.2 ^ 2 + leadStressTz h F' U' z.1 z.2 ^ 2)) (X, η) =
          iteratedFDeriv ℝ m (fun z : ℝ × ℝ => leadStressTz h F U z.1 z.2 /
            Real.sqrt (leadStressTh h F U z.1 z.2 ^ 2 + leadStressTz h F U z.1 z.2 ^ 2)) (X, η) := by
      intro X hX η e1 e2 m
      have hXab := hS hX
      have hmem : Ioo a b ×ˢ Ioo (-1 : ℝ) 1 ∈ nhds ((X, η) : ℝ × ℝ) :=
        hO.mem_nhds ⟨hXab, e1, e2⟩
      have ev1 : (↿(leadStressTh h F' U')) =ᶠ[nhds ((X, η) : ℝ × ℝ)] (↿(leadStressTh h F U)) :=
        Filter.eventuallyEq_of_mem hmem
          (fun z hz => (hEq z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).2.2.1)
      have ev2 : (↿(leadStressTz h F' U')) =ᶠ[nhds ((X, η) : ℝ × ℝ)] (↿(leadStressTz h F U)) :=
        Filter.eventuallyEq_of_mem hmem
          (fun z hz => (hEq z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).2.2.2)
      have ev3 : (fun z : ℝ × ℝ => leadStressTh h F' U' z.1 z.2 /
            Real.sqrt (leadStressTh h F' U' z.1 z.2 ^ 2 + leadStressTz h F' U' z.1 z.2 ^ 2))
          =ᶠ[nhds ((X, η) : ℝ × ℝ)] (fun z : ℝ × ℝ => leadStressTh h F U z.1 z.2 /
            Real.sqrt (leadStressTh h F U z.1 z.2 ^ 2 + leadStressTz h F U z.1 z.2 ^ 2)) :=
        Filter.eventuallyEq_of_mem hmem (fun z hz => by
          have e := hEq z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2
          simp only [e.2.2.1, e.2.2.2])
      have ev4 : (fun z : ℝ × ℝ => leadStressTz h F' U' z.1 z.2 /
            Real.sqrt (leadStressTh h F' U' z.1 z.2 ^ 2 + leadStressTz h F' U' z.1 z.2 ^ 2))
          =ᶠ[nhds ((X, η) : ℝ × ℝ)] (fun z : ℝ × ℝ => leadStressTz h F U z.1 z.2 /
            Real.sqrt (leadStressTh h F U z.1 z.2 ^ 2 + leadStressTz h F U z.1 z.2 ^ 2)) :=
        Filter.eventuallyEq_of_mem hmem (fun z hz => by
          have e := hEq z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2
          simp only [e.2.2.1, e.2.2.2])
      exact ⟨(ev1.iteratedFDeriv ℝ m).eq_of_nhds, (ev2.iteratedFDeriv ℝ m).eq_of_nhds,
        (ev3.iteratedFDeriv ℝ m).eq_of_nhds, (ev4.iteratedFDeriv ℝ m).eq_of_nhds⟩
    refine ⟨⟨c₀, hc₀, fun X hX η e1 e2 => ?_⟩, fun m => ?_, ⟨κ', hκ0, hκ2, fun X hX η e1 e2 => ?_⟩⟩
    · obtain ⟨-, -, q3, q4⟩ := hpt X hX η e1 e2
      rw [q3, q4]
      exact hlow X hX η e1 e2
    · obtain ⟨C, N, hb⟩ := hder m
      refine ⟨C, N, fun X hX η e1 e2 => ?_⟩
      obtain ⟨i1, i2, i3, i4⟩ := hit X hX η e1 e2 m
      rw [i1, i2, i3, i4]
      exact hb X hX η e1 e2
    · obtain ⟨q1, -, q3, q4⟩ := hpt X hX η e1 e2
      obtain ⟨sA, sB⟩ := hsh X hX η e1 e2
      rw [sA, sB, q1, q3, q4]
      exact hcone X hX η e1 e2

  have hLeft : AdmBlk h (edgeWeight Xa Xb aa ab) (edgeDist Xa Xb) (Ioc Xa Xm) F' U' := by
    refine hcongr 0 Xm' (Ioc Xa Xm) ?_ ?_ ?_
    · intro X hX
      exact ⟨by linarith [hX.1], by linarith [hX.2]⟩
    · intro X η hX0 hX e1 e2
      exact hstressL X η hX0 hX e1 e2
    · exact hmono _ _ F U (fun X hX => Or.inl ⟨hX.1, by linarith [hX.2]⟩) hJadm

  have hRight : AdmBlk h (edgeWeight Xa Xb aa ab) (edgeDist Xa Xb) (Ico r2 Xb) F' U' := by
    refine jp_adm_congr h s2 _ _ (Ico r2 Xb) F' U' F U ?_ ?_ ?_
    · intro X hX
      exact show s2 < X by linarith [hX.1]
    · intro X η hX e1 e2
      exact hstressR X η hX e1 e2
    · exact hmono _ _ F U (fun X hX => Or.inr ⟨by linarith [hX.1], hX.2⟩) hJadm

  have hW : ∀ X : ℝ, Xa < X → X < Xb →
      0 ≤ edgeWeight Xa Xb aa ab X ∧ 0 < edgeDist Xa Xb X ∧ edgeDist Xa Xb X ≤ 1 := by
    intro X hX1 hX2
    have hXpos : 0 < X := by linarith
    refine ⟨?_, ?_, min_le_left _ _⟩
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · unfold edgeDist
      have l1 : 0 < Real.log (X / Xa) := Real.log_pos ((one_lt_div hXa).mpr hX1)
      have l2 : 0 < Real.log (Xb / X) := Real.log_pos ((one_lt_div hXpos).mpr hX2)
      exact lt_min one_pos (lt_min l1 l2)
  have hU1 : AdmBlk h (edgeWeight Xa Xb aa ab) (edgeDist Xa Xb) (Ioc Xa Xm ∪ Icc Xm r2) F' U' := by
    refine jp_adm_union h _ _ _ _ F' U' (fun X hX => ?_) hLeft hMid
    rcases hX with hX | hX
    · exact hW X hX.1 (by linarith [hX.2])
    · exact hW X (by linarith [hX.1]) (by linarith [hX.2])
  have hU2 : AdmBlk h (edgeWeight Xa Xb aa ab) (edgeDist Xa Xb)
      ((Ioc Xa Xm ∪ Icc Xm r2) ∪ Ico r2 Xb) F' U' := by
    refine jp_adm_union h _ _ _ _ F' U' (fun X hX => ?_) hU1 hRight
    rcases hX with (hX | hX) | hX
    · exact hW X hX.1 (by linarith [hX.2])
    · exact hW X (by linarith [hX.1]) (by linarith [hX.2])
    · exact hW X (by linarith [hX.1]) hX.2
  have hAll : AdmBlk h (edgeWeight Xa Xb aa ab) (edgeDist Xa Xb) (Ioo Xa Xb) F' U' := by
    refine hmono _ _ F' U' (fun X hX => ?_) hU2
    by_cases hc1 : X ≤ Xm
    · exact Or.inl (Or.inl ⟨hX.1, hc1⟩)
    · by_cases hc2 : X ≤ r2
      · exact Or.inl (Or.inr ⟨by linarith, hc2⟩)
      · exact Or.inr ⟨by linarith, hX.2⟩

  have hXb0 : 0 < Xb := by linarith
  obtain ⟨⟨-, -, hTh, hTz⟩, -⟩ := hLPR h cinf Xb ε F' U' hh0 hh1 hXb0 hε hPR'

  refine ⟨F', U', leading_from_repaired h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xan Xm Xm2 Xp2 Xp
    r1 r2 ε Xm' s2 F U F' U' hJ hXm' (by linarith) hs2b hagree hε hPR' hmom ?_ hTh hTz hAll⟩
  intro X η e1 e2 hX
  rcases hX with ⟨hX0, hX⟩ | hX
  · exact (hstressL X η hX0 hX e1 e2).2.2
  · exact (hstressR X η hX e1 e2).2.2

theorem leading_profile_exists : ∃ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ), LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z :=
by
  obtain ⟨h, lam, Pst, ab, Rst, Pax, hD, hlam, _hab, _hR, hO⟩ := outer_axis_datum
  obtain ⟨R0, hA⟩ := axis_profile_exists h Pst Pax hD
  obtain ⟨cpatch, cinf, Xg, Xg2, r1, r2, p1, p2, m1, m2, Xv, Xc, Xb, Fo, Uo, hOP⟩ :=
    hO (max Rst R0) (le_max_left _ _)
  obtain ⟨Xa, Xan, Xa1, Xa2, Xh1, aa, Fi, Ui, hAP⟩ := hA (max Rst R0) (le_max_right _ _)
  have hJ := join_profiles h lam Pst (max Rst R0) cpatch cinf ab Xg Xg2 r1 r2 p1 p2 m1 m2 Xv Xc Xb
    Xa Xan Xa1 Xa2 Xh1 aa Pax Fo Uo Fi Ui hD hlam hOP hAP
  obtain ⟨FN, UN, hM⟩ := modulation_family shear_loop_exists lead_ps_regularity
    _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hJ
  obtain ⟨F', U', hL⟩ := repair_assembly moment_patch_repair lead_ps_regularity ps_perturbation
    cone_gap_quadratic _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ FN UN hJ hM
  exact ⟨h, lam, cinf, cpatch, Xa, Xb, Xv, Xc, p1, p2, m1, m2, aa, ab, F', U', _, _, hL⟩

theorem leadPi_smooth_bounds : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ), LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → ∃ ε : ℝ, 0 < ε ∧ ContDiffOn ℝ ∞ (↿(leadPi F)) (Ioi (-ε) ×ˢ Ioo (-1) 1) ∧ ∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿(leadPi F)) (X, η)‖ ≤ C :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hL
  obtain ⟨⟨h0, -, -, -, -, -, -, hXa, hXap1, hp12, hp2m1, hm12, hm2Xv, hXvXc, hXcXb⟩, -, -, -,
    ⟨ε, hε, hFε, -, -, hbd⟩, -, hL6, -, -, -, -⟩ := hL
  have hXb : 0 < Xb := by linarith
  have hle : ∀ k : ℕ, (k : WithTop ℕ∞) ≤ ∞ := fun k => WithTop.coe_le_coe.mpr le_top
  have hO : IsOpen (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hSO : ∀ X₁ : ℝ, Icc 0 X₁ ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 :=
    fun X₁ z hz => ⟨show -ε < z.1 by linarith [hz.1.1], hz.2⟩

  have hcpt : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (φ : ℝ × ℝ → E),
      ContDiff ℝ ∞ φ → ∀ X₁ : ℝ, ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X₁ ×ˢ Ioo (-1:ℝ) 1,
        ‖iteratedFDeriv ℝ k φ z‖ ≤ C := by
    intro E _ _ φ hφ X₁ k
    have hK : IsCompact (Icc 0 X₁ ×ˢ Icc (-1:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn
      (ContDiff.continuous_iteratedFDeriv (m := k) (hle k) hφ).continuousOn
    exact ⟨C, fun z hz => hC z ⟨hz.1, Ioo_subset_Icc_self hz.2⟩⟩

  have hcomp : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (G : E → ℝ) (t : Set E)
      (φ : ℝ × ℝ → E), IsOpen t → ContDiffOn ℝ ∞ G t → ContDiff ℝ ∞ φ →
      MapsTo φ (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) t → ∀ X₁ : ℝ,
      (∀ i : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X₁ ×ˢ Ioo (-1:ℝ) 1, ‖iteratedFDeriv ℝ i G (φ z)‖ ≤ C) →
      ∀ m : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X₁ ×ˢ Ioo (-1:ℝ) 1, ‖iteratedFDeriv ℝ m (G ∘ φ) z‖ ≤ C := by
    intro E _ _ G t φ ht hG hφ hmap X₁ hGb m
    choose Cg hCg using hGb
    choose Dφ hDφ using hcpt φ hφ X₁
    refine ⟨(m.factorial : ℝ) * (∑ i ∈ Finset.range (m + 1), |Cg i|) *
      (1 + ∑ i ∈ Finset.range (m + 1), |Dφ i|) ^ m, fun z hz => ?_⟩
    have hzO := hSO X₁ hz
    rw [← iteratedFDerivWithin_of_isOpen (f := G ∘ φ) m hO hzO]
    refine norm_iteratedFDerivWithin_comp_le hG hφ.contDiffOn (hle m) ht.uniqueDiffOn
      hO.uniqueDiffOn hmap hzO ?_ ?_
    · intro i hi
      rw [iteratedFDerivWithin_of_isOpen i ht (hmap hzO)]
      calc ‖iteratedFDeriv ℝ i G (φ z)‖ ≤ Cg i := hCg i z hz
        _ ≤ |Cg i| := le_abs_self _
        _ ≤ ∑ j ∈ Finset.range (m + 1), |Cg j| :=
            Finset.single_le_sum (f := fun j => |Cg j|) (fun j _ => abs_nonneg _)
              (Finset.mem_range.mpr (by omega))
    · intro i hi1 him
      rw [iteratedFDerivWithin_of_isOpen i hO hzO]
      have hsum : 0 ≤ ∑ j ∈ Finset.range (m + 1), |Dφ j| :=
        Finset.sum_nonneg (fun j _ => abs_nonneg _)
      have hD1 : 1 ≤ 1 + ∑ j ∈ Finset.range (m + 1), |Dφ j| := by linarith
      calc ‖iteratedFDeriv ℝ i φ z‖ ≤ Dφ i := hDφ i z hz
        _ ≤ |Dφ i| := le_abs_self _
        _ ≤ ∑ j ∈ Finset.range (m + 1), |Dφ j| :=
            Finset.single_le_sum (f := fun j => |Dφ j|) (fun j _ => abs_nonneg _)
              (Finset.mem_range.mpr (by omega))
        _ ≤ 1 + ∑ j ∈ Finset.range (m + 1), |Dφ j| := by linarith
        _ ≤ (1 + ∑ j ∈ Finset.range (m + 1), |Dφ j|) ^ i := le_self_pow₀ hD1 (by omega)

  obtain ⟨g, hg⟩ : ∃ g : ℝ → ℝ → ℝ, g = fun x e => F x e ^ 2 := ⟨_, rfl⟩
  have hgs : ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
    rw [hg]; exact hFε.pow 2
  have hgbd : ∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿g) (X, η)‖ ≤ C := by
    intro X₁ m
    have hbF : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X₁ ×ˢ Ioo (-1:ℝ) 1,
        ‖iteratedFDeriv ℝ k (↿F) z‖ ≤ C := fun k =>
      (hbd X₁ k).imp fun C hC z hz => (hC z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).1
    obtain ⟨C, hC⟩ := iteratedFDeriv_bilinear_bounded_on (ContinuousLinearMap.mul ℝ ℝ) (↿F) (↿F)
      (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) _ hO (hSO X₁) hFε hFε hbF hbF m
    have he : (↿g) = fun z : ℝ × ℝ => ContinuousLinearMap.mul ℝ ℝ ((↿F) z) ((↿F) z) := by
      funext z
      rw [ContinuousLinearMap.mul_apply', hg]
      show F z.1 z.2 ^ 2 = F z.1 z.2 * F z.1 z.2
      ring
    refine ⟨C, fun X η h1 h2 h3 h4 => ?_⟩
    rw [he]
    exact hC (X, η) ⟨⟨h1, h2⟩, h3, h4⟩
  obtain ⟨hSsm, hSbd, hSid⟩ := profRadAvg_props g ε hε hgs

  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ℝ × ℝ → ℝ, Ψ = fun p => p.1 * profRadAvg g p.1 p.2 := ⟨_, rfl⟩
  have hΨsm : ContDiffOn ℝ ∞ Ψ (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
    rw [hΨ]; exact contDiffOn_fst.mul hSsm
  have hΨbd : ∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X₁ ×ˢ Ioo (-1:ℝ) 1,
      ‖iteratedFDeriv ℝ m Ψ z‖ ≤ C := by
    intro X₁ m
    have hb1 := hcpt (Prod.fst : ℝ × ℝ → ℝ) contDiff_fst X₁
    have hb2 : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X₁ ×ˢ Ioo (-1:ℝ) 1,
        ‖iteratedFDeriv ℝ k (↿(profRadAvg g)) z‖ ≤ C := fun k =>
      (hSbd X₁ k (hgbd X₁ k)).imp fun C hC z hz => hC z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2
    obtain ⟨C, hC⟩ := iteratedFDeriv_bilinear_bounded_on (ContinuousLinearMap.mul ℝ ℝ)
      (Prod.fst : ℝ × ℝ → ℝ) (↿(profRadAvg g)) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) _ hO (hSO X₁)
      contDiffOn_fst hSsm hb1 hb2 m
    have he : Ψ = fun z : ℝ × ℝ => ContinuousLinearMap.mul ℝ ℝ z.1 ((↿(profRadAvg g)) z) := by
      rw [hΨ]; funext z; rw [ContinuousLinearMap.mul_apply']; rfl
    refine ⟨C, fun z hz => ?_⟩
    rw [he]
    exact hC z hz

  obtain ⟨A, hAdef⟩ : ∃ A : ℝ × ℝ → ℝ × ℝ, A = fun p => (Xb, p.2) := ⟨_, rfl⟩
  have hA : ContDiff ℝ ∞ A := by rw [hAdef]; fun_prop
  have hmapA : MapsTo A (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
    intro p hp
    rw [hAdef]
    exact ⟨show -ε < Xb by linarith, hp.2⟩
  have hΦsm : ContDiffOn ℝ ∞ (Ψ ∘ A) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) :=
    hΨsm.comp hA.contDiffOn hmapA
  have hΦbd : ∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X₁ ×ˢ Ioo (-1:ℝ) 1,
      ‖iteratedFDeriv ℝ m (Ψ ∘ A) z‖ ≤ C := by
    intro X₁
    refine hcomp Ψ _ A hO hΨsm hA hmapA X₁ (fun i => ?_)
    refine (hΨbd Xb i).imp fun C hC z hz => hC (A z) ?_
    rw [hAdef]
    exact ⟨⟨hXb.le, le_rfl⟩, hz.2⟩

  obtain ⟨hHsm, hHbd, -⟩ := heatProfile_props h h0
    (fun β Z hβ hZ => heatK_deriv_bound β Z hβ hZ) (fun Z hZ => heatK_ode h Z h0 hZ)
  obtain ⟨hQsm', hQbd', -⟩ := heatQ_props h h0 hHsm hHbd
  obtain ⟨ι, hιdef⟩ : ∃ ι : ℝ × ℝ → ℝ, ι = fun p => 2 * (1 - p.2 ^ 2) / Xb := ⟨_, rfl⟩
  have hι : ContDiff ℝ ∞ ι := by rw [hιdef]; fun_prop
  have hmapι : MapsTo ι (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) (Ioi 0) := by
    intro p hp
    have h1 : -1 < p.2 := hp.2.1
    have h2 : p.2 < 1 := hp.2.2
    rw [hιdef]
    show 0 < 2 * (1 - p.2 ^ 2) / Xb
    apply div_pos _ hXb
    nlinarith
  have hQsm : ContDiffOn ℝ ∞ (heatQ h ∘ ι) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) :=
    hQsm'.comp hι.contDiffOn hmapι
  have hQbd : ∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X₁ ×ˢ Ioo (-1:ℝ) 1,
      ‖iteratedFDeriv ℝ m (heatQ h ∘ ι) z‖ ≤ C := by
    intro X₁
    refine hcomp (heatQ h) (Ioi 0) ι isOpen_Ioi hQsm' hι hmapι X₁ (fun i => ?_)
    refine (hQbd' i).imp fun C hC z hz => ?_
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs]
    exact hC _ (hmapι (hSO X₁ hz))

  obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, κ = -(cinf ^ 2 / 2) * Xb ^ (-(1 + 2 * h)) := ⟨_, rfl⟩
  have hH1 : ∀ Z : ℝ, 0 < Z → heatProfile h Z ^ 2 ≤ 1 := by
    intro Z hZ
    have hK := (heatK_deriv_bound h Z h0.le hZ).2
    have hG : 0 < Real.Gamma (1 + h) := Real.Gamma_pos_of_pos (by linarith)
    have hK' : |heatK h Z| ≤ Real.Gamma (1 + h) := by rw [add_comm 1 h]; exact hK
    have e : heatProfile h Z = (Real.Gamma (1 + h))⁻¹ * heatK h Z := rfl
    have habs : |heatProfile h Z| ≤ 1 := by
      rw [e, abs_mul, abs_inv, abs_of_pos hG, inv_mul_le_iff₀ hG, mul_one]
      exact hK'
    rw [sq_le_one_iff_abs_le_one]
    exact habs
  have hcore : ∀ X η : ℝ, -ε < X → -1 < η → η < 1 →
      leadPi F X η = X * profRadAvg g X η - Xb * profRadAvg g Xb η +
        κ * heatQ h (2 * (1 - η ^ 2) / Xb) := by
    intro X η hX hη1 hη2
    have hfc : ContinuousOn (fun x => F x η ^ 2) (Ioi (-ε)) := by
      have h1 : ContinuousOn (fun x => F x η) (Ioi (-ε)) :=
        hFε.continuousOn.comp (Continuous.continuousOn (by fun_prop : Continuous fun x : ℝ => (x, η)))
          (fun x hx => ⟨hx, hη1, hη2⟩)
      exact h1.pow 2
    have hpt : ∀ s : ℝ, Xb ≤ s → F s η ^ 2 =
        cinf ^ 2 / 2 * (s ^ (-(2 + 2 * h)) * heatProfile h (2 * (1 - η ^ 2) / s) ^ 2) := by
      intro s hs
      have hs0 : 0 < s := by linarith
      have hFs := (hL6 s η hs hη1 hη2).2
      have hsq : Real.sqrt (2 * s) ^ 2 = 2 * s := Real.sq_sqrt (by linarith)
      have hpw : s ^ (-(1 / 2 + h)) * s ^ (-(1 / 2 + h)) = s ^ (-(2 + 2 * h)) * s := by
        rw [← Real.rpow_add hs0, ← Real.rpow_add_one hs0.ne']; congr 1; ring
      have h2s : (2:ℝ) * s ≠ 0 := by positivity
      apply mul_left_cancel₀ h2s
      linear_combination (Real.sqrt (2 * s) * F s η +
          cinf * s ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - η ^ 2) / s)) * hFs -
        F s η ^ 2 * hsq + cinf ^ 2 * heatProfile h (2 * (1 - η ^ 2) / s) ^ 2 * hpw
    have hIb : IntegrableOn (fun x => F x η ^ 2) (Ioi Xb) := by
      have hmaj : IntegrableOn (fun s : ℝ => cinf ^ 2 / 2 * s ^ (-(2 + 2 * h))) (Ioi Xb) :=
        Integrable.const_mul (integrableOn_Ioi_rpow_of_lt (by linarith) hXb) _
      refine Integrable.mono' hmaj
        ((hfc.mono (Ioi_subset_Ioi (by linarith))).aestronglyMeasurable measurableSet_Ioi) ?_
      refine ae_restrict_of_forall_mem measurableSet_Ioi (fun s hs => ?_)
      have hs' : Xb < s := hs
      have hs0 : 0 < s := by linarith
      have hsr : 0 ≤ s ^ (-(2 + 2 * h)) := Real.rpow_nonneg hs0.le _
      have hZ : 0 < 2 * (1 - η ^ 2) / s := by
        apply div_pos _ hs0
        nlinarith
      have hH := hH1 _ hZ
      have hc : 0 ≤ cinf ^ 2 / 2 := by positivity
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _), hpt s hs'.le]
      calc cinf ^ 2 / 2 * (s ^ (-(2 + 2 * h)) * heatProfile h (2 * (1 - η ^ 2) / s) ^ 2)
          ≤ cinf ^ 2 / 2 * (s ^ (-(2 + 2 * h)) * 1) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hH hsr) hc
        _ = cinf ^ 2 / 2 * s ^ (-(2 + 2 * h)) := by ring
    have hTb : ∫ x in Ioi Xb, F x η ^ 2 =
        cinf ^ 2 / 2 * (Xb ^ (-(1 + 2 * h)) * heatQ h (2 * (1 - η ^ 2) / Xb)) := by
      have e1 : ∫ x in Ioi Xb, F x η ^ 2 = ∫ x in Ioi Xb,
          cinf ^ 2 / 2 * (x ^ (-(2 + 2 * h)) * heatProfile h (2 * (1 - η ^ 2) / x) ^ 2) :=
        setIntegral_congr_fun measurableSet_Ioi (fun s hs => hpt s (le_of_lt hs))
      rw [e1, integral_const_mul, heatPressure_integral_eq h (2 * (1 - η ^ 2)) Xb hXb]
    have hIX : IntegrableOn (fun x => F x η ^ 2) (Ioi X) := by
      rcases le_or_gt Xb X with hle' | hlt
      · exact hIb.mono_set (Ioi_subset_Ioi hle')
      · rw [← Ioc_union_Ioi_eq_Ioi hlt.le]
        refine IntegrableOn.union ?_ hIb
        have hc2 : ContinuousOn (fun x => F x η ^ 2) (Icc X Xb) :=
          hfc.mono (fun x hx => show -ε < x by linarith [hx.1])
        exact hc2.integrableOn_Icc.mono_set Ioc_subset_Icc_self
    have hII : ∀ Y : ℝ, -ε < Y → IntervalIntegrable (fun x => F x η ^ 2) volume 0 Y := by
      intro Y hY
      apply ContinuousOn.intervalIntegrable
      apply hfc.mono
      intro x hx
      rw [mem_uIcc] at hx
      show -ε < x
      rcases hx with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> linarith
    have e2 := intervalIntegral.integral_interval_add_Ioi hIX hIb
    have e3 := intervalIntegral.integral_interval_sub_left (hII Xb (by linarith)) (hII X hX)
    have e4 := (hSid X η hX hη1 hη2).1
    have e5 := (hSid Xb η (by linarith) hη1 hη2).1
    have e4' : profRadInt g X η = ∫ x in (0:ℝ)..X, F x η ^ 2 := by rw [hg]; rfl
    have e5' : profRadInt g Xb η = ∫ x in (0:ℝ)..Xb, F x η ^ 2 := by rw [hg]; rfl
    show -∫ x in Ioi X, F x η ^ 2 = X * profRadAvg g X η - Xb * profRadAvg g Xb η +
        κ * heatQ h (2 * (1 - η ^ 2) / Xb)
    rw [hκ]
    linarith
  obtain ⟨G, hGdef⟩ : ∃ G : ℝ × ℝ → ℝ, G = (Ψ - Ψ ∘ A) + κ • (heatQ h ∘ ι) := ⟨_, rfl⟩
  have hGsm : ContDiffOn ℝ ∞ G (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
    rw [hGdef]; exact (hΨsm.sub hΦsm).add (hQsm.const_smul κ)
  have hid : ∀ p ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1, (↿(leadPi F)) p = G p := by
    intro p hp
    have hp1 : -ε < p.1 := hp.1
    have hp2 : -1 < p.2 := hp.2.1
    have hp3 : p.2 < 1 := hp.2.2
    rw [hGdef]
    show leadPi F p.1 p.2 = Ψ p - Ψ (A p) + κ • heatQ h (ι p)
    simp only [hΨ, hAdef, hιdef, smul_eq_mul]
    exact hcore p.1 p.2 hp1 hp2 hp3

  refine ⟨ε, hε, hGsm.congr hid, ?_⟩
  intro X₁ m
  obtain ⟨C1, hC1⟩ := hΨbd X₁ m
  obtain ⟨C2, hC2⟩ := hΦbd X₁ m
  obtain ⟨C3, hC3⟩ := hQbd X₁ m
  refine ⟨C1 + C2 + |κ| * C3, fun X η hX0 hXX1 hη1 hη2 => ?_⟩
  have hz : ((X, η) : ℝ × ℝ) ∈ Icc 0 X₁ ×ˢ Ioo (-1:ℝ) 1 := ⟨⟨hX0, hXX1⟩, hη1, hη2⟩
  have hzO := hSO X₁ hz
  have hnhds : Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 ∈ nhds ((X, η) : ℝ × ℝ) := hO.mem_nhds hzO
  have hev : (↿(leadPi F)) =ᶠ[nhds ((X, η) : ℝ × ℝ)] G := Filter.eventuallyEq_of_mem hnhds hid
  rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
  have h1 : ContDiffAt ℝ m Ψ (X, η) := (hΨsm.contDiffAt hnhds).of_le (hle m)
  have h2 : ContDiffAt ℝ m (Ψ ∘ A) (X, η) := (hΦsm.contDiffAt hnhds).of_le (hle m)
  have h3 : ContDiffAt ℝ m (heatQ h ∘ ι) (X, η) := (hQsm.contDiffAt hnhds).of_le (hle m)
  have h12 : ContDiffAt ℝ m (Ψ - Ψ ∘ A) (X, η) := h1.sub h2
  have h3' : ContDiffAt ℝ m (κ • (heatQ h ∘ ι)) (X, η) := h3.const_smul κ
  rw [hGdef, iteratedFDeriv_add_apply h12 h3', iteratedFDeriv_sub_apply h1 h2,
    iteratedFDeriv_const_smul_apply h3]
  have b1 := hC1 _ hz
  have b2 := hC2 _ hz
  have b3 := hC3 _ hz
  calc ‖iteratedFDeriv ℝ m Ψ (X, η) - iteratedFDeriv ℝ m (Ψ ∘ A) (X, η) +
        κ • iteratedFDeriv ℝ m (heatQ h ∘ ι) (X, η)‖
      ≤ ‖iteratedFDeriv ℝ m Ψ (X, η) - iteratedFDeriv ℝ m (Ψ ∘ A) (X, η)‖ +
        ‖κ • iteratedFDeriv ℝ m (heatQ h ∘ ι) (X, η)‖ := norm_add_le _ _
    _ ≤ (‖iteratedFDeriv ℝ m Ψ (X, η)‖ + ‖iteratedFDeriv ℝ m (Ψ ∘ A) (X, η)‖) +
        |κ| * ‖iteratedFDeriv ℝ m (heatQ h ∘ ι) (X, η)‖ := by
          rw [norm_smul, Real.norm_eq_abs]
          linarith [norm_sub_le (iteratedFDeriv ℝ m Ψ (X, η)) (iteratedFDeriv ℝ m (Ψ ∘ A) (X, η))]
    _ ≤ C1 + C2 + |κ| * C3 :=
          add_le_add (add_le_add b1 b2) (mul_le_mul_of_nonneg_left b3 (abs_nonneg κ))

theorem bg_field_smooth_div : ∀ (h : ℝ) (n : ℕ) (g : ℝ → ℝ → ℝ), SimScaleProps h → ContDiffOn ℝ ∞ (↿g) (Ici 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿(bgAn h n g)) {w : ℝ³ × ℝ | w.2 < 1} ∧ ContDiffOn ℝ ∞ (↿(bgBn h n g)) {w : ℝ³ × ℝ | w.2 < 1} ∧ ContDiffOn ℝ ∞ (↿(bgPn h n g)) {w : ℝ³ × ℝ | w.2 < 1} ∧ ∀ (x : ℝ³) (t : ℝ), t < 1 → divergence (fun y => bgBn h n g y t) x = 0 :=
by
  intro h n g hS hg
  obtain ⟨SP1, SP2, -, SP4, -⟩ := hS
  have hΩo : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  have p0 : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => w.1 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).contDiff.comp contDiff_fst
  have p1 : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => w.1 1) :=
    (EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ).contDiff.comp contDiff_fst
  have p2 : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => w.1 2) :=
    (EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).contDiff.comp contDiff_fst
  have hα : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => ((w.1 2 : ℝ), 1 - w.2)) :=
    p2.prodMk (contDiff_const.sub contDiff_snd)
  have hQ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    have := SP4.comp hα.contDiffOn (fun w (hw : w.2 < 1) =>
      (⟨mem_univ _, show (0:ℝ) < 1 - w.2 by linarith⟩ : ((w.1 2 : ℝ), 1 - w.2) ∈ univ ×ˢ Ioi (0:ℝ)))
    exact this
  have hQpos : ∀ w ∈ {w : ℝ³ × ℝ | w.2 < 1}, 0 < simScale h (w.1 2) (1 - w.2) := by
    intro w hw
    have hw' : w.2 < 1 := hw
    exact (SP1 (w.1 2) (1 - w.2) (by linarith)).1
  have hprof : ∀ b : ℝ, ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ =>
      simScale h (w.1 2) (1 - w.2) ^ b * g (simX h w.1 w.2) (simEta h w.1 w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    intro b
    have hQb : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2) ^ b)
        {w : ℝ³ × ℝ | w.2 < 1} := hQ.rpow_const_of_ne (fun w hw => (hQpos w hw).ne')
    have hX : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simX h w.1 w.2) {w : ℝ³ × ℝ | w.2 < 1} := by
      have hnum : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => w.1 0 ^ 2 + w.1 1 ^ 2) :=
        (p0.pow 2).add (p1.pow 2)
      have := hnum.contDiffOn.div (contDiffOn_const.mul hQ)
        (fun w hw => mul_ne_zero two_ne_zero (hQpos w hw).ne')
      exact this
    have hE : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simEta h w.1 w.2) {w : ℝ³ × ℝ | w.2 < 1} := by
      have := p2.contDiffOn.mul (hQ.rpow_const_of_ne (p := -(1 / 2 - h))
        (fun w hw => (hQpos w hw).ne'))
      exact this
    have hmaps : MapsTo (fun w : ℝ³ × ℝ => (simX h w.1 w.2, simEta h w.1 w.2))
        {w : ℝ³ × ℝ | w.2 < 1} (Ici 0 ×ˢ Ioo (-1) 1) := by
      intro w hw
      have hw' : w.2 < 1 := hw
      have hq := hQpos w hw
      have hz := (SP2 (w.1 2) (1 - w.2) (by linarith)).2
      refine ⟨?_, ?_⟩
      · show 0 ≤ simX h w.1 w.2
        unfold simX
        exact div_nonneg (by positivity) (by positivity)
      · show simEta h w.1 w.2 ∈ Ioo (-1) 1
        unfold simEta
        have hr : 0 < simScale h (w.1 2) (1 - w.2) ^ (-(1 / 2 - h)) := Real.rpow_pos_of_pos hq _
        have hr2 : simScale h (w.1 2) (1 - w.2) ^ (-(1 / 2 - h)) *
            simScale h (w.1 2) (1 - w.2) ^ (-(1 / 2 - h)) *
            simScale h (w.1 2) (1 - w.2) ^ (1 - 2 * h) = 1 := by
          rw [← Real.rpow_add hq, ← Real.rpow_add hq]
          have e : -(1 / 2 - h) + -(1 / 2 - h) + (1 - 2 * h) = (0:ℝ) := by ring
          rw [e, Real.rpow_zero]
        have key : (w.1 2 * simScale h (w.1 2) (1 - w.2) ^ (-(1 / 2 - h))) ^ 2 < 1 := by
          have := mul_lt_mul_of_pos_right hz (mul_pos hr hr)
          calc (w.1 2 * simScale h (w.1 2) (1 - w.2) ^ (-(1 / 2 - h))) ^ 2
              = w.1 2 ^ 2 * (simScale h (w.1 2) (1 - w.2) ^ (-(1 / 2 - h)) *
                  simScale h (w.1 2) (1 - w.2) ^ (-(1 / 2 - h))) := by ring
            _ < simScale h (w.1 2) (1 - w.2) ^ (1 - 2 * h) *
                (simScale h (w.1 2) (1 - w.2) ^ (-(1 / 2 - h)) *
                  simScale h (w.1 2) (1 - w.2) ^ (-(1 / 2 - h))) := this
            _ = 1 := by rw [mul_comm]; exact hr2
        exact abs_lt.mp ((sq_lt_one_iff_abs_lt_one _).mp key)
    have hcomp := hg.comp (hX.prodMk hE) hmaps
    exact hQb.mul hcomp
  have hJ : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ =>
      -(w.1 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        w.1 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) :=
    (p1.neg.smul contDiff_const).add (p0.smul contDiff_const)
  refine ⟨?_, ?_, ?_, ?_⟩
  · refine (((contDiffOn_const (c := (1 / 2 : ℝ))).mul
      (hprof (-(1 / 2 + h) + 2 * (n : ℝ) * h))).smul hJ.contDiffOn).congr (fun w _ => ?_)
    show ((1 / 2) * simScale h (w.1 2) (1 - w.2) ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h) *
      g (simX h w.1 w.2) (simEta h w.1 w.2)) • azVec w.1 = _
    rw [mul_assoc]
    rfl
  · exact ((hprof (-(1 + h) + 2 * (n : ℝ) * h)).smul hJ.contDiffOn).congr (fun w _ => rfl)
  · exact (hprof (-(1 + 2 * h) + 2 * (n : ℝ) * h)).congr (fun w _ => rfl)
  · intro x t ht
    obtain ⟨φ, hφ⟩ : ∃ φ : ℝ³ → ℝ, φ = fun y =>
        simScale h (y 2) (1 - t) ^ (-(1 + h) + 2 * (n : ℝ) * h) * g (simX h y t) (simEta h y t) :=
      ⟨_, rfl⟩
    have hfun : (fun y => bgBn h n g y t) = fun y => φ y •
        (-(y 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
          y 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) := by
      rw [hφ]; rfl
    have hmem : ((x, t) : ℝ³ × ℝ) ∈ {w : ℝ³ × ℝ | w.2 < 1} := ht
    have hca := ((hprof (-(1 + h) + 2 * (n : ℝ) * h)).contDiffAt (hΩo.mem_nhds hmem)).comp x
      ((contDiff_id.prodMk (contDiff_const (c := t))).contDiffAt)
    have hφd : DifferentiableAt ℝ φ x := by
      rw [hφ]
      exact hca.differentiableAt (by norm_num)
    have hinv : ∀ y : ℝ³, y 0 ^ 2 + y 1 ^ 2 = x 0 ^ 2 + x 1 ^ 2 → y 2 = x 2 → φ y = φ x := by
      intro y hy hy2
      rw [hφ]
      simp only [simX, simEta]
      rw [hy, hy2]
    have hsmul : ∀ (ψ : ℝ³ → ℝ) (V : ℝ³ → ℝ³) (x : ℝ³), DifferentiableAt ℝ ψ x →
        DifferentiableAt ℝ V x →
        divergence (fun y => ψ y • V y) x = ψ x * divergence V x + fderiv ℝ ψ x (V x) := by
      intro ψ V x hψ hV
      rw [divergence, fderiv_fun_smul hψ hV, ContinuousLinearMap.toLinearMap_add,
        ContinuousLinearMap.toLinearMap_smul, map_add, map_smul, divergence, smul_eq_mul]
      congr 1
      have h : ((fderiv ℝ ψ x).smulRight (V x) : ℝ³ →ₗ[ℝ] ℝ³) =
          (fderiv ℝ ψ x : ℝ³ →ₗ[ℝ] ℝ).smulRight (V x) := rfl
      rw [h, LinearMap.trace_smulRight]
      rfl
    rw [hfun]
    have c00 : (EuclideanSpace.single (0 : Fin 3) (1:ℝ)) 0 = 1 := by simp
    have c01 : (EuclideanSpace.single (0 : Fin 3) (1:ℝ)) 1 = 0 := by simp
    have c02 : (EuclideanSpace.single (0 : Fin 3) (1:ℝ)) 2 = 0 := by simp
    have c10 : (EuclideanSpace.single (1 : Fin 3) (1:ℝ)) 0 = 0 := by simp
    have c11 : (EuclideanSpace.single (1 : Fin 3) (1:ℝ)) 1 = 1 := by simp
    have c12 : (EuclideanSpace.single (1 : Fin 3) (1:ℝ)) 2 = 0 := by simp
    generalize EuclideanSpace.single (0 : Fin 3) (1:ℝ) = e0 at c00 c01 c02 ⊢
    generalize EuclideanSpace.single (1 : Fin 3) (1:ℝ) = e1 at c10 c11 c12 ⊢
    have h0 : HasFDerivAt (fun y : ℝ³ => y 0) (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ) x :=
      (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).hasFDerivAt
    have h1 : HasFDerivAt (fun y : ℝ³ => y 1) (EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ) x :=
      (EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ).hasFDerivAt
    have hn1 : HasFDerivAt (fun y : ℝ³ => -(y 1))
        (-(EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ)) x := h1.neg
    have hJd0 : HasFDerivAt (fun y : ℝ³ => -(y 1) • e0)
        ((-(EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ)).smulRight e0) x :=
      hn1.smul_const e0
    have hJd1 : HasFDerivAt (fun y : ℝ³ => y 0 • e1)
        ((EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).smulRight e1) x :=
      h0.smul_const e1
    have hJx : DifferentiableAt ℝ (fun y : ℝ³ => -(y 1) • e0 + y 0 • e1) x :=
      (hJd0.add hJd1).differentiableAt
    have hdivJ : divergence (fun y : ℝ³ => -(y 1) • e0 + y 0 • e1) x = 0 := by
      rw [divergence_add hJd0.differentiableAt hJd1.differentiableAt]
      have k1 := hsmul (fun y : ℝ³ => -(y 1)) (fun _ => e0) x hn1.differentiableAt
        (differentiableAt_const _)
      have k2 := hsmul (fun y : ℝ³ => y 0) (fun _ => e1) x h0.differentiableAt
        (differentiableAt_const _)
      rw [k1, k2, hn1.fderiv, h0.fderiv]
      simp [c01, c10]

    have hγ : HasDerivAt (fun θ : ℝ => x + ((Real.cos θ - 1) • (x 0 • e0 + x 1 • e1) +
        Real.sin θ • (-(x 1) • e0 + x 0 • e1))) (-(x 1) • e0 + x 0 • e1) 0 := by
      have k1 := ((Real.hasDerivAt_cos 0).sub_const 1).smul_const (x 0 • e0 + x 1 • e1)
      have k2 := (Real.hasDerivAt_sin 0).smul_const (-(x 1) • e0 + x 0 • e1)
      have k3 := (k1.add k2).const_add x
      convert k3 using 1
      simp
    have hγ0 : (fun θ : ℝ => x + ((Real.cos θ - 1) • (x 0 • e0 + x 1 • e1) +
        Real.sin θ • (-(x 1) • e0 + x 0 • e1))) 0 = x := by
      simp
    have hl : HasFDerivAt φ (fderiv ℝ φ x)
        ((fun θ : ℝ => x + ((Real.cos θ - 1) • (x 0 • e0 + x 1 • e1) +
          Real.sin θ • (-(x 1) • e0 + x 0 • e1))) 0) := by
      rw [hγ0]; exact hφd.hasFDerivAt
    have hc := hl.comp_hasDerivAt (0:ℝ) hγ
    have hconst : (φ ∘ fun θ : ℝ => x + ((Real.cos θ - 1) • (x 0 • e0 + x 1 • e1) +
        Real.sin θ • (-(x 1) • e0 + x 0 • e1))) = fun _ => φ x := by
      funext θ
      simp only [Function.comp]
      apply hinv
      · have a0 : (x + ((Real.cos θ - 1) • (x 0 • e0 + x 1 • e1) +
            Real.sin θ • (-(x 1) • e0 + x 0 • e1))) 0 =
            Real.cos θ * x 0 - Real.sin θ * x 1 := by
          simp [c00, c10]; ring
        have a1 : (x + ((Real.cos θ - 1) • (x 0 • e0 + x 1 • e1) +
            Real.sin θ • (-(x 1) • e0 + x 0 • e1))) 1 =
            Real.cos θ * x 1 + Real.sin θ * x 0 := by
          simp [c01, c11]; ring
        rw [a0, a1]
        have hsc := Real.sin_sq_add_cos_sq θ
        calc (Real.cos θ * x 0 - Real.sin θ * x 1) ^ 2 + (Real.cos θ * x 1 + Real.sin θ * x 0) ^ 2
            = (Real.sin θ ^ 2 + Real.cos θ ^ 2) * (x 0 ^ 2 + x 1 ^ 2) := by ring
          _ = x 0 ^ 2 + x 1 ^ 2 := by rw [hsc, one_mul]
      · simp [c02, c12]
    rw [hconst] at hc
    have hzero : fderiv ℝ φ x (-(x 1) • e0 + x 0 • e1) = 0 :=
      hc.unique (hasDerivAt_const (0:ℝ) (φ x))
    rw [hsmul _ _ x hφd hJx, hdivJ, hzero]
    simp

theorem bg_curl_order_zero : ∀ (h ε : ℝ) (U : ℝ → ℝ → ℝ), SimScaleProps h → 0 < h → h < 1 / 2 → 0 < ε → ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1) 1) → ∀ (x : ℝ³) (t : ℝ), t < 1 → 0 < x 0 ^ 2 + x 1 ^ 2 → (curl3 (fun w => bgAn h 0 (profRadAvg U) w t) x) 2 = simScale h (x 2) (1 - t) ^ (-(1 / 2 + h)) * U (simX h x t) (simEta h x t) ∧ inner ℝ (curl3 (fun w => bgAn h 0 (profRadAvg U) w t) x) (radVec x) = leadV h U (simX h x t) (simEta h x t) ∧ inner ℝ (curl3 (fun w => bgAn h 0 (profRadAvg U) w t) x) (azVec x) = (0 : ℝ) :=
by
  intro h ε U hS h0 hh hε hU x t ht hr
  obtain ⟨hSsm, -, hSder⟩ := profRadAvg_props U ε hε hU
  have hτ : (0:ℝ) < 1 - t := by linarith

  have hP : ∀ i : Fin 3, HasFDerivAt (fun y : ℝ³ => y i) (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ) x := by
    intro i
    have := (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).hasFDerivAt (x := x)
    exact this

  have s3 : ∀ (σ : ℝ³ → ℝ) (σ' : ℝ³ →L[ℝ] ℝ), HasFDerivAt σ σ' x →
      curl3 (fun y => σ y • azVec y) x =
        (-(x 0) * σ' (EuclideanSpace.single 2 1)) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
        (-(x 1) * σ' (EuclideanSpace.single 2 1)) • EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
        (2 * σ x + x 0 * σ' (EuclideanSpace.single 0 1) + x 1 * σ' (EuclideanSpace.single 1 1)) •
          EuclideanSpace.single (2 : Fin 3) (1 : ℝ) := by
    intro σ σ' hσ
    have h1 := ((hP 1).neg).smul_const (EuclideanSpace.single (0 : Fin 3) (1:ℝ))
    have h0 := (hP 0).smul_const (EuclideanSpace.single (1 : Fin 3) (1:ℝ))
    have hA := (h1.add h0).congr_of_eventuallyEq (f₁ := azVec)
      (Filter.Eventually.of_forall fun y => by simp [azVec])
    have hF := hσ.fun_smul hA
    unfold curl3
    rw [hF.fderiv]
    ext i
    fin_cases i <;> simp [azVec] <;> ring

  have hQpos : 0 < simScale h (x 2) (1 - t) := (hS.1 (x 2) (1 - t) hτ).1
  have hQne : simScale h (x 2) (1 - t) ≠ 0 := hQpos.ne'
  have hQd : DifferentiableAt ℝ (fun z => simScale h z (1 - t)) (x 2) := by
    have h1 : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale h w.1 w.2) (x 2, 1 - t) :=
      hS.2.2.2.1.contDiffAt (prod_mem_nhds Filter.univ_mem (Ioi_mem_nhds hτ))
    have h2 : ContDiffAt ℝ ∞ (fun z : ℝ => ((z, 1 - t) : ℝ × ℝ)) (x 2) :=
      (contDiff_id.prodMk contDiff_const).contDiffAt
    exact (h1.comp (x 2) h2).differentiableAt (by norm_num)
  obtain ⟨Q', hQh⟩ : ∃ Q', HasDerivAt (fun z => simScale h z (1 - t)) Q' (x 2) :=
    ⟨_, hQd.hasDerivAt⟩
  have hphi := hQh.sub ((hasDerivAt_pow 2 (x 2)).mul (hQh.rpow_const (p := 2 * h) (Or.inl hQne)))
  have hconst : ((fun z => simScale h z (1 - t)) - (fun z : ℝ => z ^ 2) *
      fun z => simScale h z (1 - t) ^ (2 * h)) = fun _ => 1 - t := by
    funext z; simp only [Pi.sub_apply, Pi.mul_apply]; exact (hS.1 z (1 - t) hτ).2
  rw [hconst] at hphi
  have hrel := hphi.unique (hasDerivAt_const (x 2) (1 - t))
  have hz2 := (hS.2.1 (x 2) (1 - t) hτ).2

  have hpos_p : 0 < simScale h (x 2) (1 - t) ^ (-(1 / 2 - h)) := Real.rpow_pos_of_pos hQpos _
  have hR4 : simScale h (x 2) (1 - t) ^ (2 * h - 1) = (simScale h (x 2) (1 - t) ^ (-(1 / 2 - h))) ^ 2 := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hQpos.le]
    congr 1; push_cast; ring
  have hR5 : simScale h (x 2) (1 - t) ^ (2 * h) =
      simScale h (x 2) (1 - t) * (simScale h (x 2) (1 - t) ^ (-(1 / 2 - h))) ^ 2 := by
    have e : simScale h (x 2) (1 - t) ^ (2 * h) =
        simScale h (x 2) (1 - t) ^ (1:ℝ) * simScale h (x 2) (1 - t) ^ (2 * h - 1) := by
      rw [← Real.rpow_add hQpos]; congr 1; ring
    rw [e, Real.rpow_one, hR4]
  have hprod : simScale h (x 2) (1 - t) ^ (1 - 2 * h) * simScale h (x 2) (1 - t) ^ (2 * h - 1) = 1 := by
    rw [← Real.rpow_add hQpos, show 1 - 2 * h + (2 * h - 1) = (0:ℝ) by ring, Real.rpow_zero]
  have hmp : simScale h (x 2) (1 - t) ^ (-(1 / 2 + h)) *
      (simScale h (x 2) (1 - t) * simScale h (x 2) (1 - t) ^ (-(1 / 2 - h))) = 1 := by
    have e1 : simScale h (x 2) (1 - t) ^ (-(1 / 2 + h)) * simScale h (x 2) (1 - t) =
        simScale h (x 2) (1 - t) ^ (-(1 / 2 + h) + 1) := by
      rw [Real.rpow_add hQpos, Real.rpow_one]
    rw [← mul_assoc, e1, ← Real.rpow_add hQpos,
      show -(1 / 2 + h) + 1 + -(1 / 2 - h) = (0:ℝ) by ring, Real.rpow_zero]

  have heta2 : (simEta h x t) ^ 2 < 1 := by
    have : (simEta h x t) ^ 2 = x 2 ^ 2 * simScale h (x 2) (1 - t) ^ (2 * h - 1) := by
      rw [hR4]; unfold simEta; ring
    rw [this]
    calc x 2 ^ 2 * simScale h (x 2) (1 - t) ^ (2 * h - 1)
        < simScale h (x 2) (1 - t) ^ (1 - 2 * h) * simScale h (x 2) (1 - t) ^ (2 * h - 1) :=
          mul_lt_mul_of_pos_right hz2 (Real.rpow_pos_of_pos hQpos _)
      _ = 1 := hprod
  have heta_abs : |simEta h x t| < 1 := (sq_lt_one_iff_abs_lt_one _).mp heta2
  have hX0 : 0 < simX h x t := by unfold simX; positivity
  have hmem : (simX h x t, simEta h x t) ∈ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 :=
    ⟨show -ε < simX h x t by linarith, (abs_lt.mp heta_abs).1, (abs_lt.mp heta_abs).2⟩
  have hGd : DifferentiableAt ℝ (↿(profRadAvg U)) (simX h x t, simEta h x t) :=
    (hSsm.contDiffAt ((isOpen_Ioi.prod isOpen_Ioo).mem_nhds hmem)).differentiableAt (by norm_num)
  obtain ⟨G', hG⟩ : ∃ G', HasFDerivAt (↿(profRadAvg U)) G' (simX h x t, simEta h x t) :=
    ⟨_, hGd.hasFDerivAt⟩
  have hGab : ∀ a b : ℝ, G' (a, b) = a * G' (1, 0) + b * G' (0, 1) := by
    intro a b
    have : ((a, b) : ℝ × ℝ) = a • ((1, 0) : ℝ × ℝ) + b • ((0, 1) : ℝ × ℝ) := by
      ext <;> simp
    rw [this, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
  have hgX : HasDerivAt (fun Y => profRadAvg U Y (simEta h x t)) (G' (1, 0)) (simX h x t) := by
    have hl : HasDerivAt (fun Y : ℝ => (Y, simEta h x t)) ((1:ℝ), (0:ℝ)) (simX h x t) :=
      (hasDerivAt_id' _).prodMk (hasDerivAt_const _ _)
    have := hG.comp_hasDerivAt (simX h x t) hl
    exact this
  have hgE : HasDerivAt (fun e => profRadAvg U (simX h x t) e) (G' (0, 1)) (simEta h x t) := by
    have hl : HasDerivAt (fun e : ℝ => (simX h x t, e)) ((0:ℝ), (1:ℝ)) (simEta h x t) :=
      (hasDerivAt_const _ _).prodMk (hasDerivAt_id' _)
    have := hG.comp_hasDerivAt (simEta h x t) hl
    exact this
  have hEtaD : profEtaD (profRadAvg U) (simX h x t) (simEta h x t) = G' (0, 1) := by
    unfold profEtaD; exact hgE.deriv

  have hUid : U (simX h x t) (simEta h x t) =
      profRadAvg U (simX h x t) (simEta h x t) + simX h x t * G' (1, 0) := by
    have h1 := (hSder (simX h x t) (simEta h x t) (by linarith) (abs_lt.mp heta_abs).1
      (abs_lt.mp heta_abs).2).2
    have h2 := (hasDerivAt_id' (simX h x t)).mul hgX
    have := h1.unique h2
    rw [this]; ring

  have hQf : HasFDerivAt (fun y : ℝ³ => simScale h (y 2) (1 - t))
      (Q' • (EuclideanSpace.proj 2 : ℝ³ →L[ℝ] ℝ)) x := by
    have := HasDerivAt.comp_hasFDerivAt (h₂ := fun z => simScale h z (1 - t)) x hQh (hP 2)
    exact this
  have hm := hQf.rpow_const (p := -(1 / 2 + h)) (Or.inl hQne)
  have hp := hQf.rpow_const (p := -(1 / 2 - h)) (Or.inl hQne)
  have hr2 := ((hP 0).pow 2).add ((hP 1).pow 2)
  have hinv := HasDerivAt.comp_hasFDerivAt (h₂ := fun y : ℝ => y⁻¹) x
    (hasDerivAt_inv (by positivity : (2 * simScale h (x 2) (1 - t)) ≠ 0)) (hQf.const_mul 2)
  have hX := (hr2.mul hinv).congr_of_eventuallyEq (f₁ := fun y : ℝ³ => simX h y t)
    (Filter.Eventually.of_forall fun y => by simp [simX, div_eq_mul_inv])
  have hEta := ((hP 2).mul hp).congr_of_eventuallyEq (f₁ := fun y : ℝ³ => simEta h y t)
    (Filter.Eventually.of_forall fun y => by simp [simEta])
  have hSc := hG.comp x (hX.prodMk hEta)
  have hσ := (hm.const_mul (1 / 2)).mul hSc
  have hfun : (fun w => bgAn h 0 (profRadAvg U) w t) =
      fun w => (((fun y : ℝ³ => 1 / 2 * simScale h (y 2) (1 - t) ^ (-(1 / 2 + h))) *
        (↿(profRadAvg U) ∘ fun y : ℝ³ => (simX h y t, simEta h y t))) w) • azVec w := by
    funext w
    simp only [bgAn, Nat.cast_zero, mul_zero, zero_mul, add_zero]
    rfl
  rw [hfun]
  obtain ⟨g1, hg1⟩ : ∃ g, G' (1, 0) = g := ⟨_, rfl⟩
  obtain ⟨g2, hg2⟩ : ∃ g, G' (0, 1) = g := ⟨_, rfl⟩
  have hGe : G' = g1 • ContinuousLinearMap.fst ℝ ℝ ℝ + g2 • ContinuousLinearMap.snd ℝ ℝ ℝ := by
    ext <;> simp [← hg1, ← hg2]
  rw [hg1] at hUid
  rw [hg2] at hEtaD
  have hm1 : simScale h (x 2) (1 - t) ^ (-(1 / 2 + h) - 1) =
      simScale h (x 2) (1 - t) ^ (-(1 / 2 + h)) / simScale h (x 2) (1 - t) := Real.rpow_sub_one hQne _
  have hp1 : simScale h (x 2) (1 - t) ^ (-(1 / 2 - h) - 1) =
      simScale h (x 2) (1 - t) ^ (-(1 / 2 - h)) / simScale h (x 2) (1 - t) := Real.rpow_sub_one hQne _
  have hinvx : ((fun y : ℝ => y⁻¹) ∘ fun y : ℝ³ => 2 * simScale h (y 2) (1 - t)) x =
      (2 * simScale h (x 2) (1 - t))⁻¹ := rfl
  have hr2x : ((fun y : ℝ³ => y 0 ^ 2) + fun y : ℝ³ => y 1 ^ 2) x = x 0 ^ 2 + x 1 ^ 2 := rfl
  have hSx : (↿(profRadAvg U) ∘ fun y : ℝ³ => (simX h y t, simEta h y t)) x =
      profRadAvg U (simX h x t) (simEta h x t) := rfl
  rw [hm1, hp1, hinvx, hr2x, hSx, hGe] at hσ
  have hσx : ((fun y : ℝ³ => 1 / 2 * simScale h (y 2) (1 - t) ^ (-(1 / 2 + h))) *
        (↿(profRadAvg U) ∘ fun y : ℝ³ => (simX h y t, simEta h y t))) x =
      1 / 2 * simScale h (x 2) (1 - t) ^ (-(1 / 2 + h)) * profRadAvg U (simX h x t) (simEta h x t) := rfl
  have hXdef : simX h x t = (x 0 ^ 2 + x 1 ^ 2) / (2 * simScale h (x 2) (1 - t)) := rfl
  have hEdef : simEta h x t = x 2 * simScale h (x 2) (1 - t) ^ (-(1 / 2 - h)) := rfl
  have hL : 0 < 1 - 2 * h * (x 2 * simScale h (x 2) (1 - t) ^ (-(1 / 2 - h))) ^ 2 := by
    have h1 := heta2
    rw [hEdef] at h1
    have h2 : 0 ≤ (1 - 2 * h) * (x 2 * simScale h (x 2) (1 - t) ^ (-(1 / 2 - h))) ^ 2 :=
      mul_nonneg (by linarith) (sq_nonneg _)
    nlinarith

  rw [s3 _ _ hσ]
  simp only [PiLp.inner_apply, Fin.sum_univ_three, radVec, azVec, leadV, hEtaD, hUid, hσx]
  rw [hR4, hR5] at hrel
  generalize profRadAvg U (simX h x t) (simEta h x t) = S at *
  simp only [hXdef, hEdef]
  generalize simScale h (x 2) (1 - t) ^ (-(1 / 2 + h)) = m at hmp ⊢
  generalize simScale h (x 2) (1 - t) ^ (-(1 / 2 - h)) = p at hmp hrel hL hpos_p ⊢
  generalize simScale h (x 2) (1 - t) = Q at hmp hrel hL hQpos hQne ⊢
  have hpne : p ≠ 0 := hpos_p.ne'
  have hLne : 1 - 2 * h * (x 2 * p) ^ 2 ≠ 0 := hL.ne'
  have hm' : m = (Q * p)⁻¹ := eq_inv_of_mul_eq_one_left hmp
  have hQ' : Q' = 2 * x 2 * Q * p ^ 2 / (1 - 2 * h * (x 2 * p) ^ 2) := by
    rw [eq_div_iff hLne]
    simp only [Nat.cast_ofNat] at hrel
    norm_num at hrel
    linear_combination hrel
  subst hm' hQ'
  simp
  refine ⟨?_, ?_, ?_⟩
  · field_simp
    ring
  · have hL2 : 1 - p ^ 2 * x 2 ^ 2 * h * 2 ≠ 0 := by
      intro hc; apply hLne; linear_combination hc
    field_simp
    ring_nf
    field_simp
    ring
  · ring

theorem bg_exterior_order_zero : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ), SimScaleProps h → LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → ∀ (x : ℝ³) (t : ℝ), t < 1 → 2 * Xb * simScale h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2 → bgAn h 0 (profRadAvg U) x t = 0 ∧ bgBn h 0 F x t = heatSwirl h (2 ^ (1 / 2 + h) * cinf) x t ∧ bgPn h 0 (leadPi F) x t = heatPressure h (2 ^ (1 / 2 + h) * cinf) x t :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hS hL x t ht hext
  obtain ⟨⟨h0, -, -, hcinf, -, -, -, hXa, hXap1, hp12, hp2m1, hm12, hm2Xv, hXvXc, hXcXb⟩,
    -, -, -, -, -, hL6, hL7, -, -, -⟩ := hL
  have hXb0 : 0 < Xb := by linarith
  have hXvXb : Xv < Xb := by linarith
  have hτ : 0 < 1 - t := by linarith
  obtain ⟨hq, hSP1⟩ := hS.1 (x 2) (1 - t) hτ
  obtain ⟨-, hSP2⟩ := hS.2.1 (x 2) (1 - t) hτ
  have hXv : simX h x t = (x 0 ^ 2 + x 1 ^ 2) / (2 * simScale h (x 2) (1 - t)) := rfl
  have hηv : simEta h x t = x 2 * simScale h (x 2) (1 - t) ^ (-(1 / 2 - h)) := rfl
  simp only [bgAn, bgBn, bgPn, heatSwirl, heatPressure, Nat.cast_zero, mul_zero, zero_mul, add_zero]
  set q := simScale h (x 2) (1 - t) with hqd
  set X := simX h x t with hXd
  set η := simEta h x t with hηd
  set r2 := x 0 ^ 2 + x 1 ^ 2 with hr2d
  have hqne : q ≠ 0 := hq.ne'

  have hr2pos : 0 < r2 := by
    have := mul_pos (mul_pos (by norm_num : (0:ℝ) < 2) hXb0) hq
    linarith
  have h2q : 0 < 2 * q := by linarith
  have h2qX : 2 * q * X = r2 := by rw [hXv]; field_simp
  have hXgt : Xb < X := by
    rw [hXv, lt_div_iff₀ h2q]
    linarith
  have hX0 : 0 < X := by linarith
  have hee : q ^ (-(1 / 2 - h)) * q ^ (-(1 / 2 - h)) = q ^ (2 * h - 1) := by
    rw [← Real.rpow_add hq, show -(1 / 2 - h) + -(1 / 2 - h) = 2 * h - 1 by ring]
  have hq2h : q ^ (2 * h) = q ^ (2 * h - 1) * q := by
    rw [← Real.rpow_add_one hqne, show 2 * h - 1 + 1 = 2 * h by ring]
  have hinv : q ^ (1 - 2 * h) * q ^ (2 * h - 1) = 1 := by
    rw [← Real.rpow_add hq, show 1 - 2 * h + (2 * h - 1) = 0 by ring, Real.rpow_zero]
  have hη2 : η ^ 2 = x 2 ^ 2 * q ^ (2 * h - 1) := by rw [hηv, ← hee]; ring
  have hqdd : q * (1 - η ^ 2) = 1 - t := by
    rw [hη2]; linear_combination hSP1 + x 2 ^ 2 * hq2h
  have hηsq : η ^ 2 < 1 := by
    rw [hη2]
    have hP : 0 < q ^ (2 * h - 1) := Real.rpow_pos_of_pos hq _
    have := mul_lt_mul_of_pos_right hSP2 hP
    linarith [hinv]
  have hη1 : -1 < η := by nlinarith
  have hη1' : η < 1 := by nlinarith
  have hPI : ∀ A S : ℝ, 0 < S → ∫ s in Ioi S, s ^ (-(2 + 2 * h)) * heatProfile h (A / s) ^ 2 =
      S ^ (-(1 + 2 * h)) * heatQ h (A / S) := by
    intro A S hS
    have hSne : S ≠ 0 := hS.ne'
    have hc : ∫ w in Ioi (1:ℝ), (S * w) ^ (-(2 + 2 * h)) * heatProfile h (A / (S * w)) ^ 2 =
        S⁻¹ * ∫ s in Ioi S, s ^ (-(2 + 2 * h)) * heatProfile h (A / s) ^ 2 := by
      have := MeasureTheory.integral_comp_mul_left_Ioi
        (fun s => s ^ (-(2 + 2 * h)) * heatProfile h (A / s) ^ 2) 1 hS
      rw [mul_one, smul_eq_mul] at this
      exact this
    have hc2 : ∫ w in Ioi (1:ℝ), (S * w) ^ (-(2 + 2 * h)) * heatProfile h (A / (S * w)) ^ 2 =
        ∫ w in Ioi (1:ℝ), S ^ (-(2 + 2 * h)) * (w ^ (-(2 + 2 * h)) * heatProfile h (A / S / w) ^ 2) := by
      refine setIntegral_congr_fun measurableSet_Ioi (fun w hw => ?_)
      have hw0 : (0:ℝ) < w := lt_trans one_pos hw
      rw [Real.mul_rpow hS.le hw0.le, div_div]
      ring
    rw [hc2, integral_const_mul] at hc
    have hSS : S ^ (-(1 + 2 * h)) = S * S ^ (-(2 + 2 * h)) := by
      rw [show -(1 + 2 * h) = 1 + -(2 + 2 * h) by ring, Real.rpow_add hS, Real.rpow_one]
    rw [hSS, show heatQ h (A / S) =
      ∫ w in Ioi (1:ℝ), w ^ (-(2 + 2 * h)) * heatProfile h (A / S / w) ^ 2 from rfl]
    have hSi : S * S⁻¹ = 1 := mul_inv_cancel₀ hSne
    linear_combination (-S) * hc -
      (∫ s in Ioi S, s ^ (-(2 + 2 * h)) * heatProfile h (A / s) ^ 2) * hSi
  have harg : 2 * (1 - η ^ 2) / X = 4 * (1 - t) / r2 := by
    rw [div_eq_div_iff hX0.ne' hr2pos.ne']
    linear_combination (-2 * (1 - η ^ 2)) * h2qX + 4 * X * hqdd
  refine ⟨?_, ?_, ?_⟩
  ·
    have hS0 : profRadAvg U X η = 0 := by
      have h7 := (hL7 X η (by linarith) hη1 hη1').2
      have hc := intervalIntegral.integral_comp_mul_right (fun y => U y η) hX0.ne' (a := 0) (b := 1)
      simp only [zero_mul, one_mul] at hc
      show (∫ s in (0:ℝ)..1, U (s * X) η) = 0
      rw [hc]
      show X⁻¹ • profRadInt U X η = 0
      rw [h7, smul_zero]
    rw [hS0, mul_zero, zero_smul]
  ·
    rw [show (-(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) = azVec x from rfl]
    congr 1
    have hF := (hL6 X η hXgt.le hη1 hη1').2
    rw [harg] at hF
    have hs : Real.sqrt (2 * X) = (2:ℝ) ^ (1 / 2 : ℝ) * X ^ (1 / 2 : ℝ) := by
      rw [Real.sqrt_eq_rpow, Real.mul_rpow (by norm_num) hX0.le]
    have hXs : X ^ (-(1 / 2 + h)) = X ^ (1 / 2 : ℝ) * X ^ (-(1 + h)) := by
      rw [← Real.rpow_add hX0]; congr 1; ring
    have hr2p : r2 ^ (-(1 + h)) = (2:ℝ) ^ (-(1 + h)) * q ^ (-(1 + h)) * X ^ (-(1 + h)) := by
      rw [← h2qX, Real.mul_rpow (by positivity) hX0.le, Real.mul_rpow (by norm_num) hq.le]
    have hpow2 : (2:ℝ) ^ (1 / 2 + h) * (2:ℝ) ^ (-(1 + h)) * (2:ℝ) ^ (1 / 2 : ℝ) = 1 := by
      rw [← Real.rpow_add (by norm_num : (0:ℝ) < 2), ← Real.rpow_add (by norm_num : (0:ℝ) < 2),
        show 1 / 2 + h + -(1 + h) + 1 / 2 = (0:ℝ) by ring, Real.rpow_zero]
    rw [hs, hXs] at hF
    rw [hr2p]
    have hne : (2:ℝ) ^ (1 / 2 : ℝ) * X ^ (1 / 2 : ℝ) ≠ 0 := by positivity
    apply mul_left_cancel₀ hne
    linear_combination q ^ (-(1 + h)) * hF -
      (cinf * q ^ (-(1 + h)) * X ^ (1 / 2 : ℝ) * X ^ (-(1 + h)) *
        heatProfile h (4 * (1 - t) / r2)) * hpow2
  ·
    have hint : ∫ s in Ioi X, F s η ^ 2 = ∫ s in Ioi X,
        cinf ^ 2 / 2 * (s ^ (-(2 + 2 * h)) * heatProfile h (2 * (1 - η ^ 2) / s) ^ 2) := by
      refine setIntegral_congr_fun measurableSet_Ioi (fun s hs => ?_)
      have hs' : X < s := hs
      have hs0 : 0 < s := lt_trans hX0 hs'
      have hFs := (hL6 s η (by linarith) hη1 hη1').2
      have hsq : Real.sqrt (2 * s) ^ 2 = 2 * s := Real.sq_sqrt (by linarith)
      have hpw : s ^ (-(1 / 2 + h)) * s ^ (-(1 / 2 + h)) = s ^ (-(2 + 2 * h)) * s := by
        rw [← Real.rpow_add hs0, ← Real.rpow_add_one hs0.ne']; congr 1; ring
      have h2s : (2:ℝ) * s ≠ 0 := by positivity
      apply mul_left_cancel₀ h2s
      linear_combination (Real.sqrt (2 * s) * F s η +
          cinf * s ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - η ^ 2) / s)) * hFs -
        F s η ^ 2 * hsq + cinf ^ 2 * heatProfile h (2 * (1 - η ^ 2) / s) ^ 2 * hpw
    rw [integral_const_mul, hPI (2 * (1 - η ^ 2)) X hX0, harg] at hint
    rw [hPI (4 * (1 - t)) r2 hr2pos]
    rw [show leadPi F X η = -∫ s in Ioi X, F s η ^ 2 from rfl, hint]
    have hr2p : r2 ^ (-(1 + 2 * h)) =
        (2:ℝ) ^ (-(1 + 2 * h)) * q ^ (-(1 + 2 * h)) * X ^ (-(1 + 2 * h)) := by
      rw [← h2qX, Real.mul_rpow (by positivity) hX0.le, Real.mul_rpow (by norm_num) hq.le]
    have hpow3 : (2:ℝ) ^ (1 / 2 + h) * (2:ℝ) ^ (1 / 2 + h) * (2:ℝ) ^ (-(1 + 2 * h)) = 1 := by
      rw [← Real.rpow_add (by norm_num : (0:ℝ) < 2), ← Real.rpow_add (by norm_num : (0:ℝ) < 2),
        show 1 / 2 + h + (1 / 2 + h) + -(1 + 2 * h) = (0:ℝ) by ring, Real.rpow_zero]
    rw [hr2p]
    linear_combination (cinf ^ 2 / 2 * q ^ (-(1 + 2 * h)) * X ^ (-(1 + 2 * h)) *
      heatQ h (4 * (1 - t) / r2)) * hpow3

theorem wt_bilinear_bound : ∀ {E F G H : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G] [NormedSpace ℝ G] [NormedAddCommGroup H] [NormedSpace ℝ H] (B : F →L[ℝ] G →L[ℝ] H) (f : E → F) (g : E → G) (ρ : E → ℝ) (Ω S : Set E), IsOpen Ω → S ⊆ Ω → (∀ w ∈ S, 0 < ρ w ∧ ρ w ≤ 1) → ContDiffOn ℝ ∞ f Ω → ContDiffOn ℝ ∞ g Ω → (∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k f w‖ ≤ C * ρ w ^ (-K)) → (∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k g w‖ ≤ C * ρ w ^ (-K)) → ContDiffOn ℝ ∞ (fun z => B (f z) (g z)) Ω ∧ ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k (fun z => B (f z) (g z)) w‖ ≤ C * ρ w ^ (-K) :=
by
  intro E F G H _ _ _ _ _ _ _ _ B f g ρ Ω S hΩ hSΩ hρ hf hg hbf hbg
  refine ⟨(B.contDiff.comp_contDiffOn hf).clm_apply hg, ?_⟩
  intro k
  choose Cf Kf hCf using hbf
  choose Cg Kg hCg using hbg
  obtain ⟨Af, hAf⟩ : ∃ Af : ℝ, Af = ∑ i ∈ Finset.range (k + 1), max (Kf i) 0 := ⟨_, rfl⟩
  obtain ⟨Ag, hAg⟩ : ∃ Ag : ℝ, Ag = ∑ i ∈ Finset.range (k + 1), max (Kg i) 0 := ⟨_, rfl⟩
  refine ⟨‖B‖ * ∑ i ∈ Finset.range (k + 1),
      (k.choose i : ℝ) * max (Cf i) 0 * max (Cg (k - i)) 0, Af + Ag, fun w hw => ?_⟩
  obtain ⟨hr0, hr1⟩ := hρ w hw
  have hwΩ : w ∈ Ω := hSΩ hw
  have hU : UniqueDiffOn ℝ Ω := hΩ.uniqueDiffOn
  have key := ContinuousLinearMap.norm_iteratedFDerivWithin_le_of_bilinear B hf hg hU hwΩ
    (n := k) (by exact_mod_cast le_top)
  rw [iteratedFDerivWithin_of_isOpen k hΩ hwΩ] at key
  refine key.trans ?_
  have hmono : ∀ a A : ℝ, a ≤ A → ρ w ^ (-a) ≤ ρ w ^ (-A) := fun a A h =>
    Real.rpow_le_rpow_of_exponent_ge hr0 hr1 (by linarith)
  have hsplit : ρ w ^ (-(Af + Ag)) = ρ w ^ (-Af) * ρ w ^ (-Ag) := by
    rw [neg_add, Real.rpow_add hr0]
  rw [hsplit, show ∀ a b : ℝ, ‖B‖ * a * b = ‖B‖ * (a * b) from fun a b => mul_assoc _ _ _,
    Finset.sum_mul]
  refine mul_le_mul_of_nonneg_left ?_ (ContinuousLinearMap.opNorm_nonneg B)
  refine Finset.sum_le_sum fun i hi => ?_
  have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
  rw [iteratedFDerivWithin_of_isOpen i hΩ hwΩ, iteratedFDerivWithin_of_isOpen (k - i) hΩ hwΩ]
  have hKf : Kf i ≤ Af := by
    rw [hAf]
    exact (le_max_left _ _).trans
      (Finset.single_le_sum (f := fun j => max (Kf j) 0) (fun j _ => le_max_right _ _) hi)
  have hKg : Kg (k - i) ≤ Ag := by
    rw [hAg]
    exact (le_max_left _ _).trans
      (Finset.single_le_sum (f := fun j => max (Kg j) 0) (fun j _ => le_max_right _ _)
        (Finset.mem_range.mpr (by omega)))
  have hp1 : 0 < ρ w ^ (-Kf i) := Real.rpow_pos_of_pos hr0 _
  have hp2 : 0 < ρ w ^ (-Kg (k - i)) := Real.rpow_pos_of_pos hr0 _
  have hpA : 0 < ρ w ^ (-Af) := Real.rpow_pos_of_pos hr0 _
  have h1 : ‖iteratedFDeriv ℝ i f w‖ ≤ max (Cf i) 0 * ρ w ^ (-Af) :=
    (hCf i w hw).trans ((mul_le_mul_of_nonneg_right (le_max_left _ _) hp1.le).trans
      (mul_le_mul_of_nonneg_left (hmono _ _ hKf) (le_max_right _ _)))
  have h2 : ‖iteratedFDeriv ℝ (k - i) g w‖ ≤ max (Cg (k - i)) 0 * ρ w ^ (-Ag) :=
    (hCg (k - i) w hw).trans ((mul_le_mul_of_nonneg_right (le_max_left _ _) hp2.le).trans
      (mul_le_mul_of_nonneg_left (hmono _ _ hKg) (le_max_right _ _)))
  have h0 : (0 : ℝ) ≤ k.choose i := Nat.cast_nonneg _
  calc (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i f w‖ * ‖iteratedFDeriv ℝ (k - i) g w‖
      ≤ (k.choose i : ℝ) * (max (Cf i) 0 * ρ w ^ (-Af)) *
          (max (Cg (k - i)) 0 * ρ w ^ (-Ag)) :=
        mul_le_mul (mul_le_mul_of_nonneg_left h1 h0) h2 (norm_nonneg _)
          (mul_nonneg h0 (mul_nonneg (le_max_right _ _) hpA.le))
    _ = (k.choose i : ℝ) * max (Cf i) 0 * max (Cg (k - i)) 0 *
          (ρ w ^ (-Af) * ρ w ^ (-Ag)) := by ring

theorem ball_iteratedFDeriv_bound : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (p : ℝ³ × ℝ → F), ContDiff ℝ ∞ p → ∀ (B : ℝ) (k : ℕ), ∃ C : ℝ, ∀ w : ℝ³ × ℝ, ‖w‖ ≤ B → ‖iteratedFDeriv ℝ k p w‖ ≤ C :=
by
  intro F _ _ p hp B k
  have hk : ((k : ℕ∞) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have hc : Continuous (fun w => iteratedFDeriv ℝ k p w) := hp.continuous_iteratedFDeriv hk
  obtain ⟨C, hC⟩ := (isCompact_closedBall (0 : ℝ³ × ℝ) B).exists_bound_of_continuousOn
    hc.continuousOn
  refine ⟨C, fun w hw => hC w ?_⟩
  rw [Metric.mem_closedBall, dist_zero_right]
  exact hw

theorem bg_interior_region_facts : ∀ (h M : ℝ), SimScaleProps h → 0 < h → h < 1 / 2 → 0 < M → ∀ w : ℝ³ × ℝ, w.2 < 1 → (0 < simScale h (w.1 2) (1 - w.2) ∧ 0 ≤ simX h w.1 w.2 ∧ -1 < simEta h w.1 w.2 ∧ simEta h w.1 w.2 < 1) ∧ (simScale h (w.1 2) (1 - w.2) ≤ 1 → w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M * simScale h (w.1 2) (1 - w.2) → ‖w‖ ≤ M + 1 ∧ simX h w.1 w.2 ≤ M / 2) :=
by
  intro h M hS h0 hh hM w hw
  have hτ : 0 < 1 - w.2 := by linarith
  obtain ⟨hq, -⟩ := hS.1 (w.1 2) (1 - w.2) hτ
  obtain ⟨hτq, hz⟩ := hS.2.1 (w.1 2) (1 - w.2) hτ
  have hXdef : simX h w.1 w.2 =
      (w.1 0 ^ 2 + w.1 1 ^ 2) / (2 * simScale h (w.1 2) (1 - w.2)) := rfl
  have hEdef : simEta h w.1 w.2 =
      w.1 2 * simScale h (w.1 2) (1 - w.2) ^ (-(1 / 2 - h)) := rfl
  have hb : 0 < simScale h (w.1 2) (1 - w.2) ^ (1 / 2 - h) := Real.rpow_pos_of_pos hq _
  have hb2 : (simScale h (w.1 2) (1 - w.2) ^ (1 / 2 - h)) ^ 2 =
      simScale h (w.1 2) (1 - w.2) ^ (1 - 2 * h) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hq.le]
    congr 1
    push_cast
    ring
  have hzb := abs_lt_of_sq_lt_sq' (hz.trans_eq hb2.symm) hb.le
  have hE : simEta h w.1 w.2 = w.1 2 / simScale h (w.1 2) (1 - w.2) ^ (1 / 2 - h) := by
    rw [hEdef, Real.rpow_neg hq.le, ← div_eq_mul_inv]
  have hη1 : -1 < simEta h w.1 w.2 := by
    rw [hE, lt_div_iff₀ hb]
    linarith [hzb.1]
  have hη2 : simEta h w.1 w.2 < 1 := by
    rw [hE, div_lt_one hb]
    exact hzb.2
  have h2q : 0 < 2 * simScale h (w.1 2) (1 - w.2) := by linarith
  have hX0 : 0 ≤ simX h w.1 w.2 := by
    rw [hXdef]
    exact div_nonneg (by positivity) h2q.le
  refine ⟨⟨hq, hX0, hη1, hη2⟩, fun hq1 hr => ⟨?_, ?_⟩⟩
  · have ht0 : 0 ≤ w.2 := by linarith
    have hq12 : simScale h (w.1 2) (1 - w.2) ^ (1 - 2 * h) ≤ 1 :=
      Real.rpow_le_one hq.le hq1 (by linarith)
    have hMq : M * simScale h (w.1 2) (1 - w.2) ≤ M * 1 :=
      mul_le_mul_of_nonneg_left hq1 hM.le
    have hrM : w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M := by linarith
    have hn2 : ‖w.1‖ ^ 2 = w.1 0 ^ 2 + w.1 1 ^ 2 + w.1 2 ^ 2 := by
      rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_three]
    have hsq : ‖w.1‖ ^ 2 ≤ (M + 1) ^ 2 := by nlinarith
    have hn : ‖w.1‖ ≤ M + 1 := by
      have := abs_le_of_sq_le_sq' hsq (by linarith)
      exact this.2
    rw [Prod.norm_def]
    refine max_le hn ?_
    rw [Real.norm_eq_abs, abs_of_nonneg ht0]
    linarith
  · rw [hXdef, div_le_iff₀ h2q]
    linarith

theorem simScale_rpow_wt_bound : ∀ (h p : ℝ), SimScaleProps h → 0 < h → h < 1 / 2 → ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => simScale h (z.1 2) (1 - z.2) ^ p) {w : ℝ³ × ℝ | w.2 < 1} ∧ ∀ k : ℕ, ∃ C K : ℝ, ∀ w : ℝ³ × ℝ, w.2 < 1 → simScale h (w.1 2) (1 - w.2) ≤ 1 → ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => simScale h (z.1 2) (1 - z.2) ^ p) w‖ ≤ C * simScale h (w.1 2) (1 - w.2) ^ (-K) :=
by
  intro h p hS hh0 hh1

  have simQ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} ∧ (∀ w : ℝ³ × ℝ, w.2 < 1 → 0 < simScale h (w.1 2) (1 - w.2)) ∧ (∀ k : ℕ, 1 ≤ k → ∃ C : ℝ, ∀ w : ℝ³ × ℝ, w.2 < 1 → simScale h (w.1 2) (1 - w.2) ≤ 1 → ‖iteratedFDeriv ℝ k (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) w‖ ≤ C * simScale h (w.1 2) (1 - w.2) ^ (1 - (k : ℝ))) := by
    obtain ⟨hS1, -, -, hS4, hS5⟩ := hS
    obtain ⟨L₀, hL₀def⟩ : ∃ L : (EuclideanSpace ℝ (Fin 3)) × ℝ →L[ℝ] ℝ × ℝ,
        L = ((EuclideanSpace.proj (2 : Fin 3) : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ).comp
          (ContinuousLinearMap.fst ℝ (EuclideanSpace ℝ (Fin 3)) ℝ)).prod
          (-(ContinuousLinearMap.snd ℝ (EuclideanSpace ℝ (Fin 3)) ℝ)) := ⟨_, rfl⟩
    have hL₀ : ∀ v : ℝ³ × ℝ, L₀ v = (v.1 2, -v.2) := by
      intro v; rw [hL₀def]; rfl
    have hΦ : ∀ v : ℝ³ × ℝ, L₀ v + ((0:ℝ), (1:ℝ)) = (v.1 2, 1 - v.2) := by
      intro v
      rw [hL₀, Prod.mk_add_mk, add_zero]
      congr 1
      ring
    have hfun : (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) =
        (fun y : ℝ × ℝ => (fun p : ℝ × ℝ => simScale h p.1 p.2) (y + ((0:ℝ), (1:ℝ)))) ∘ L₀ := by
      funext v
      simp only [Function.comp]
      rw [hΦ v]
    have hT : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
    have ha : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2))
        {w : ℝ³ × ℝ | w.2 < 1} := by
      rw [hfun]
      refine hS4.comp ((contDiff_id.add contDiff_const).comp L₀.contDiff).contDiffOn ?_
      intro w hw
      show L₀ w + ((0:ℝ), (1:ℝ)) ∈ _
      rw [hΦ w]
      exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
    have hc : ∀ w : ℝ³ × ℝ, w.2 < 1 → 0 < simScale h (w.1 2) (1 - w.2) :=
      fun w hw => (hS1 (w.1 2) (1 - w.2) (sub_pos.mpr hw)).1
    have hLn : ‖L₀‖ ≤ 1 := by
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => ?_)
      rw [hL₀, one_mul, Prod.norm_def, Prod.norm_def]
      simp only [norm_neg]
      exact max_le_max (PiLp.norm_apply_le x.1 2) le_rfl
    refine ⟨ha, hc, ?_⟩
    intro k hk
    obtain ⟨C, hC⟩ := hS5 k hk
    refine ⟨C, fun w hw hq1 => ?_⟩
    have hso : IsOpen ((fun y : ℝ × ℝ => y + ((0:ℝ), (1:ℝ))) ⁻¹' (univ ×ˢ Ioi (0:ℝ))) :=
      hT.preimage (continuous_id.add continuous_const)
    have hg₁ : ContDiffOn ℝ ∞
        (fun y : ℝ × ℝ => (fun p : ℝ × ℝ => simScale h p.1 p.2) (y + ((0:ℝ), (1:ℝ))))
        ((fun y : ℝ × ℝ => y + ((0:ℝ), (1:ℝ))) ⁻¹' (univ ×ˢ Ioi (0:ℝ))) :=
      hS4.comp (contDiff_id.add contDiff_const).contDiffOn (fun y hy => hy)
    have hLw : L₀ w ∈ (fun y : ℝ × ℝ => y + ((0:ℝ), (1:ℝ))) ⁻¹' (univ ×ˢ Ioi (0:ℝ)) := by
      rw [Set.mem_preimage, hΦ w]
      exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
    have hLso : IsOpen (L₀ ⁻¹' ((fun y : ℝ × ℝ => y + ((0:ℝ), (1:ℝ))) ⁻¹' (univ ×ˢ Ioi (0:ℝ)))) :=
      hso.preimage L₀.continuous
    have key := ContinuousLinearMap.iteratedFDerivWithin_comp_right L₀ hg₁ hso.uniqueDiffOn
      hLso.uniqueDiffOn hLw (i := k) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen k hLso (show w ∈ L₀ ⁻¹' _ from hLw),
      iteratedFDerivWithin_of_isOpen k hso hLw] at key
    have htr := iteratedFDeriv_comp_add_right (𝕜 := ℝ) (f := fun p : ℝ × ℝ => simScale h p.1 p.2)
      k ((0:ℝ), (1:ℝ)) (L₀ w)
    calc ‖iteratedFDeriv ℝ k (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) w‖
        = ‖(iteratedFDeriv ℝ k (fun p : ℝ × ℝ => simScale h p.1 p.2)
            (L₀ w + ((0:ℝ), (1:ℝ)))).compContinuousLinearMap fun _ => L₀‖ := by
          rw [hfun, key, htr]
      _ ≤ ‖iteratedFDeriv ℝ k (fun p : ℝ × ℝ => simScale h p.1 p.2) (L₀ w + ((0:ℝ), (1:ℝ)))‖ *
            ∏ _i : Fin k, ‖L₀‖ :=
          ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
      _ ≤ ‖iteratedFDeriv ℝ k (fun p : ℝ × ℝ => simScale h p.1 p.2) (L₀ w + ((0:ℝ), (1:ℝ)))‖ := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
          exact mul_le_of_le_one_right (norm_nonneg _) (pow_le_one₀ (norm_nonneg _) hLn)
      _ ≤ C * simScale h (w.1 2) (1 - w.2) ^ (1 - (k : ℝ)) := by
          rw [hΦ w]
          exact hC _ _ (sub_pos.mpr hw) hq1
  obtain ⟨hQa, hQpos, hQd⟩ := simQ
  have hUo : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  have hgs : ContDiffOn ℝ ∞ (fun y : ℝ => y ^ p) (Ioi 0) := fun y hy =>
    (Real.contDiffAt_rpow_const_of_ne (ne_of_gt hy)).contDiffWithinAt
  have hmaps : MapsTo (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1}
      (Ioi 0) := fun w hw => hQpos w hw
  refine ⟨hgs.comp hQa hmaps, ?_⟩
  intro k
  have hQd' : ∀ i : ℕ, ∃ C : ℝ, 1 ≤ i → ∀ w : ℝ³ × ℝ, w.2 < 1 →
      simScale h (w.1 2) (1 - w.2) ≤ 1 →
      ‖iteratedFDeriv ℝ i (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) w‖ ≤
        C * simScale h (w.1 2) (1 - w.2) ^ (1 - (i : ℝ)) := by
    intro i
    by_cases hi1 : 1 ≤ i
    · obtain ⟨C, hC⟩ := hQd i hi1
      exact ⟨C, fun _ => hC⟩
    · exact ⟨0, fun h1 => absurd h1 hi1⟩
  choose Cq hCq using hQd'
  obtain ⟨C', hC'⟩ : ∃ C' : ℝ, C' = 1 + ∑ i ∈ Finset.range (k + 1), |Cq i| := ⟨_, rfl⟩
  obtain ⟨Cg, hCg⟩ : ∃ Cg : ℝ,
      Cg = ∑ i ∈ Finset.range (k + 1), |Polynomial.eval p (descPochhammer ℝ i)| := ⟨_, rfl⟩
  have hC'1 : 1 ≤ C' := by
    have := Finset.sum_nonneg (fun i (_ : i ∈ Finset.range (k + 1)) => abs_nonneg (Cq i))
    linarith
  have hCqle : ∀ i ≤ k, |Cq i| ≤ C' := by
    intro i hi
    have := Finset.single_le_sum (f := fun i => |Cq i|) (fun j _ => abs_nonneg _)
      (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    linarith
  have hCgle : ∀ i ≤ k, |Polynomial.eval p (descPochhammer ℝ i)| ≤ Cg := by
    intro i hi
    have := Finset.single_le_sum (f := fun i => |Polynomial.eval p (descPochhammer ℝ i)|)
      (fun j _ => abs_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    rw [hCg]
    exact this
  refine ⟨(k.factorial : ℝ) * Cg * C' ^ k, |p| + 2 * (k : ℝ), ?_⟩
  intro w hw hq1
  set q := simScale h (w.1 2) (1 - w.2) with hqdef
  have hq0 : 0 < q := hQpos w hw

  have hg : ∀ i ≤ k, ‖iteratedFDerivWithin ℝ i (fun y : ℝ => y ^ p) (Ioi 0) q‖ ≤
      Cg * q ^ (-(|p| + (k : ℝ))) := by
    intro i hi
    rw [iteratedFDerivWithin_of_isOpen i isOpen_Ioi (show q ∈ Ioi (0:ℝ) from hq0),
      norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
      Real.iter_deriv_rpow_const, Real.norm_eq_abs, abs_mul,
      abs_of_pos (Real.rpow_pos_of_pos hq0 _)]
    have hik : (i : ℝ) ≤ k := by exact_mod_cast hi
    have hnp := neg_abs_le p
    have he : q ^ (p - (i : ℝ)) ≤ q ^ (-(|p| + (k : ℝ))) :=
      Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (by linarith)
    calc |Polynomial.eval p (descPochhammer ℝ i)| * q ^ (p - (i : ℝ))
        ≤ |Polynomial.eval p (descPochhammer ℝ i)| * q ^ (-(|p| + (k : ℝ))) :=
          mul_le_mul_of_nonneg_left he (abs_nonneg _)
      _ ≤ Cg * q ^ (-(|p| + (k : ℝ))) :=
          mul_le_mul_of_nonneg_right (hCgle i hi) (Real.rpow_nonneg hq0.le _)

  have hf : ∀ i : ℕ, 1 ≤ i → i ≤ k → ‖iteratedFDerivWithin ℝ i
      (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} w‖ ≤
      (C' * q⁻¹) ^ i := by
    intro i hi1 hik
    rw [iteratedFDerivWithin_of_isOpen i hUo hw]
    have hQb : ‖iteratedFDeriv ℝ i (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) w‖
        ≤ Cq i * q ^ (1 - (i : ℝ)) := hCq i hi1 w hw hq1
    have e1 : q ^ (1 - (i : ℝ)) = q * q⁻¹ ^ i := by
      rw [Real.rpow_sub hq0, Real.rpow_one, Real.rpow_natCast, div_eq_mul_inv, inv_pow]
    rw [e1] at hQb
    have hP0 : 0 < q⁻¹ ^ i := by positivity
    have hCqi := hCqle i hik
    have hC'i : C' ≤ C' ^ i := le_self_pow₀ hC'1 (by omega)
    rw [mul_pow]
    calc _ ≤ Cq i * (q * q⁻¹ ^ i) := hQb
      _ ≤ |Cq i| * (q * q⁻¹ ^ i) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (by positivity)
      _ = |Cq i| * q * q⁻¹ ^ i := by ring
      _ ≤ |Cq i| * 1 * q⁻¹ ^ i := by
          apply mul_le_mul_of_nonneg_right _ hP0.le
          exact mul_le_mul_of_nonneg_left hq1 (abs_nonneg _)
      _ ≤ C' ^ i * q⁻¹ ^ i := by
          apply mul_le_mul_of_nonneg_right _ hP0.le
          linarith
  have key := norm_iteratedFDerivWithin_comp_le hgs hQa (by exact_mod_cast le_top)
    isOpen_Ioi.uniqueDiffOn hUo.uniqueDiffOn hmaps hw hg hf
  rw [iteratedFDerivWithin_of_isOpen k hUo hw] at key
  have e2 : q ^ (-(|p| + 2 * (k : ℝ))) = q ^ (-(|p| + (k : ℝ))) * q⁻¹ ^ k := by
    rw [show -(|p| + 2 * (k : ℝ)) = -(|p| + (k : ℝ)) + -(k : ℝ) by ring, Real.rpow_add hq0,
      Real.rpow_neg hq0.le (k : ℝ), Real.rpow_natCast, inv_pow]
  rw [e2]
  calc ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => simScale h (z.1 2) (1 - z.2) ^ p) w‖
      = ‖iteratedFDeriv ℝ k ((fun y : ℝ => y ^ p) ∘
          (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2))) w‖ := rfl
    _ ≤ _ := key
    _ = _ := by rw [mul_pow]; ring

theorem simXEta_wt_bound : ∀ (h M : ℝ), SimScaleProps h → 0 < h → h < 1 / 2 → 0 < M → ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2)) {w : ℝ³ × ℝ | w.2 < 1} ∧ ∀ k : ℕ, ∃ C K : ℝ, ∀ w : ℝ³ × ℝ, w.2 < 1 → simScale h (w.1 2) (1 - w.2) ≤ 1 → w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M * simScale h (w.1 2) (1 - w.2) → ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => (simX h z.1 z.2, simEta h z.1 z.2)) w‖ ≤ C * simScale h (w.1 2) (1 - w.2) ^ (-K) :=
by
  intro h M hS h0 hh2 hM
  obtain ⟨Ω, hΩ⟩ : ∃ Ω : Set (ℝ³ × ℝ), Ω = {w : ℝ³ × ℝ | w.2 < 1} := ⟨_, rfl⟩
  obtain ⟨S, hSd⟩ : ∃ S : Set (ℝ³ × ℝ), S = {w : ℝ³ × ℝ | w.2 < 1 ∧
      simScale h (w.1 2) (1 - w.2) ≤ 1 ∧
      w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M * simScale h (w.1 2) (1 - w.2)} := ⟨_, rfl⟩
  have hΩo : IsOpen Ω := by rw [hΩ]; exact isOpen_lt continuous_snd continuous_const
  have hSΩ : S ⊆ Ω := by
    intro w hw
    rw [hSd] at hw
    rw [hΩ]
    exact hw.1
  have hreg := bg_interior_region_facts h M hS h0 hh2 hM
  have hρ : ∀ w ∈ S, 0 < simScale h (w.1 2) (1 - w.2) ∧ simScale h (w.1 2) (1 - w.2) ≤ 1 := by
    intro w hw
    rw [hSd] at hw
    exact ⟨(hreg w hw.1).1.1, hw.2.1⟩
  have hball : ∀ w ∈ S, ‖w‖ ≤ M + 1 := by
    intro w hw
    rw [hSd] at hw
    exact ((hreg w hw.1).2 hw.2.1 hw.2.2).1
  have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => z.1 i) := fun i =>
    ((EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).comp (ContinuousLinearMap.fst ℝ ℝ³ ℝ)).contDiff
  have hpoly : ∀ p : ℝ³ × ℝ → ℝ, ContDiff ℝ ∞ p → ContDiffOn ℝ ∞ p Ω ∧
      ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S,
        ‖iteratedFDeriv ℝ k p w‖ ≤ C * simScale h (w.1 2) (1 - w.2) ^ (-K) := by
    intro p hp
    refine ⟨hp.contDiffOn, fun k => ?_⟩
    obtain ⟨C, hC⟩ := ball_iteratedFDeriv_bound p hp (M + 1) k
    refine ⟨C, 0, fun w hw => ?_⟩
    rw [neg_zero, Real.rpow_zero, mul_one]
    exact hC w (hball w hw)
  have hpow : ∀ p : ℝ,
      ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => simScale h (z.1 2) (1 - z.2) ^ p) Ω ∧
      ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S,
        ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => simScale h (z.1 2) (1 - z.2) ^ p) w‖ ≤
          C * simScale h (w.1 2) (1 - w.2) ^ (-K) := by
    intro p
    obtain ⟨hs, hb⟩ := simScale_rpow_wt_bound h p hS h0 hh2
    refine ⟨by rw [hΩ]; exact hs, fun k => ?_⟩
    obtain ⟨C, K, hCK⟩ := hb k
    refine ⟨C, K, fun w hw => ?_⟩
    rw [hSd] at hw
    exact hCK w hw.1 hw.2.1
  have hP1 : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => (z.1 0 ^ 2 + z.1 1 ^ 2) / 2) :=
    (((hc 0).pow 2).add ((hc 1).pow 2)).div_const 2
  obtain ⟨hXs, hXb⟩ := wt_bilinear_bound (ContinuousLinearMap.mul ℝ ℝ)
    (fun z : ℝ³ × ℝ => (z.1 0 ^ 2 + z.1 1 ^ 2) / 2)
    (fun z : ℝ³ × ℝ => simScale h (z.1 2) (1 - z.2) ^ (-1 : ℝ))
    (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) Ω S hΩo hSΩ hρ
    (hpoly _ hP1).1 (hpow _).1 (hpoly _ hP1).2 (hpow _).2
  obtain ⟨hEs, hEb⟩ := wt_bilinear_bound (ContinuousLinearMap.mul ℝ ℝ)
    (fun z : ℝ³ × ℝ => z.1 2)
    (fun z : ℝ³ × ℝ => simScale h (z.1 2) (1 - z.2) ^ (-(1 / 2 - h)))
    (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) Ω S hΩo hSΩ hρ
    (hpoly _ (hc 2)).1 (hpow _).1 (hpoly _ (hc 2)).2 (hpow _).2
  have eX : (fun z : ℝ³ × ℝ => simX h z.1 z.2) = fun z => ContinuousLinearMap.mul ℝ ℝ
      ((z.1 0 ^ 2 + z.1 1 ^ 2) / 2) (simScale h (z.1 2) (1 - z.2) ^ (-1 : ℝ)) := by
    funext z
    rw [ContinuousLinearMap.mul_apply', Real.rpow_neg_one]
    unfold simX
    ring
  have eE : (fun z : ℝ³ × ℝ => simEta h z.1 z.2) = fun z => ContinuousLinearMap.mul ℝ ℝ
      (z.1 2) (simScale h (z.1 2) (1 - z.2) ^ (-(1 / 2 - h))) := by
    funext z
    rw [ContinuousLinearMap.mul_apply']
    rfl
  have hXs' : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => simX h z.1 z.2) Ω := by
    rw [eX]; exact hXs
  have hEs' : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => simEta h z.1 z.2) Ω := by
    rw [eE]; exact hEs
  have hXb' : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S,
      ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => simX h z.1 z.2) w‖ ≤
        C * simScale h (w.1 2) (1 - w.2) ^ (-K) := by
    rw [eX]; exact hXb
  have hEb' : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S,
      ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => simEta h z.1 z.2) w‖ ≤
        C * simScale h (w.1 2) (1 - w.2) ^ (-K) := by
    rw [eE]; exact hEb
  refine ⟨?_, ?_⟩
  · have hpr := hXs'.prodMk hEs'
    rw [hΩ] at hpr
    exact hpr
  · intro k
    obtain ⟨CX, KX, hX⟩ := hXb' k
    obtain ⟨CE, KE, hE⟩ := hEb' k
    refine ⟨|CX| + |CE|, max KX KE, fun w h1 h2 h3 => ?_⟩
    have hw : w ∈ S := by rw [hSd]; exact ⟨h1, h2, h3⟩
    have hwΩ : Ω ∈ nhds w := hΩo.mem_nhds (hSΩ hw)
    obtain ⟨hq0, hq1⟩ := hρ w hw
    rw [iteratedFDeriv_prodMk (hXs'.contDiffAt hwΩ) (hEs'.contDiffAt hwΩ)
      (by exact_mod_cast le_top), ContinuousMultilinearMap.opNorm_prod]
    have hqK0 : 0 ≤ simScale h (w.1 2) (1 - w.2) ^ (-max KX KE) :=
      (Real.rpow_pos_of_pos hq0 _).le
    have hgen : ∀ Ci Ki : ℝ, Ki ≤ max KX KE → |Ci| ≤ |CX| + |CE| →
        Ci * simScale h (w.1 2) (1 - w.2) ^ (-Ki) ≤
          (|CX| + |CE|) * simScale h (w.1 2) (1 - w.2) ^ (-max KX KE) := by
      intro Ci Ki hKi hCi
      calc Ci * simScale h (w.1 2) (1 - w.2) ^ (-Ki)
          ≤ |Ci| * simScale h (w.1 2) (1 - w.2) ^ (-Ki) :=
            mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_pos_of_pos hq0 _).le
        _ ≤ |Ci| * simScale h (w.1 2) (1 - w.2) ^ (-max KX KE) :=
            mul_le_mul_of_nonneg_left
              (Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (by linarith)) (abs_nonneg _)
        _ ≤ (|CX| + |CE|) * simScale h (w.1 2) (1 - w.2) ^ (-max KX KE) :=
            mul_le_mul_of_nonneg_right hCi hqK0
    exact max_le
      ((hX w hw).trans (hgen CX KX (le_max_left _ _) (by linarith [abs_nonneg CE])))
      ((hE w hw).trans (hgen CE KE (le_max_right _ _) (by linarith [abs_nonneg CX])))

theorem bg_field_interior_bounds : ∀ (h ε M : ℝ) (n : ℕ) (g : ℝ → ℝ → ℝ), SimScaleProps h → 0 < h → h < 1 / 2 → 0 < ε → 0 < M → ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1) 1) → (∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿g) (X, η)‖ ≤ C) → ∀ m : ℕ, ∃ C K : ℝ, ∀ (x : ℝ³) (t : ℝ), t < 1 → simScale h (x 2) (1 - t) ≤ 1 → x 0 ^ 2 + x 1 ^ 2 ≤ M * simScale h (x 2) (1 - t) → ‖iteratedFDeriv ℝ m (↿(bgAn h n g)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧ ‖iteratedFDeriv ℝ m (↿(bgBn h n g)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) ∧ ‖iteratedFDeriv ℝ m (↿(bgPn h n g)) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (-K) :=
by
  intro h ε M n g hS h0 hh2 hε hM hg hgb m

  obtain ⟨Ω, hΩ⟩ : ∃ Ω : Set (ℝ³ × ℝ), Ω = {w : ℝ³ × ℝ | w.2 < 1} := ⟨_, rfl⟩
  obtain ⟨S, hSd⟩ : ∃ S : Set (ℝ³ × ℝ), S = {w : ℝ³ × ℝ | w.2 < 1 ∧
      simScale h (w.1 2) (1 - w.2) ≤ 1 ∧
      w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M * simScale h (w.1 2) (1 - w.2)} := ⟨_, rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : ℝ³ × ℝ → ℝ, Q = fun w => simScale h (w.1 2) (1 - w.2) := ⟨_, rfl⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ³ × ℝ → ℝ × ℝ, Φ = fun z => (simX h z.1 z.2, simEta h z.1 z.2) :=
    ⟨_, rfl⟩
  obtain ⟨Jf, hJf⟩ : ∃ Jf : ℝ³ × ℝ → ℝ³, Jf = fun z : ℝ³ × ℝ =>
      -(z.1 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        z.1 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ) := ⟨_, rfl⟩
  have hΩo : IsOpen Ω := by rw [hΩ]; exact isOpen_lt continuous_snd continuous_const
  have hTo : IsOpen (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hmemS : ∀ w : ℝ³ × ℝ, w ∈ S ↔ (w.2 < 1 ∧ simScale h (w.1 2) (1 - w.2) ≤ 1 ∧
      w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M * simScale h (w.1 2) (1 - w.2)) := by
    intro w; rw [hSd]; rfl
  have hSΩ : S ⊆ Ω := by
    intro w hw; rw [hΩ]; exact ((hmemS w).1 hw).1
  have hreg := bg_interior_region_facts h M hS h0 hh2 hM
  have hρ : ∀ w ∈ S, 0 < Q w ∧ Q w ≤ 1 := by
    intro w hw
    obtain ⟨h1, h2, -⟩ := (hmemS w).1 hw
    rw [hQ]
    exact ⟨(hreg w h1).1.1, h2⟩
  have hmaps : MapsTo Φ Ω (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) := by
    intro w hw
    rw [hΩ] at hw
    obtain ⟨⟨-, hX, he1, he2⟩, -⟩ := hreg w hw
    rw [hΦ]
    exact ⟨mem_Ioi.mpr (by linarith), he1, he2⟩

  have hconv : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F),
      (∀ k : ℕ, ∃ C K : ℝ, ∀ w : ℝ³ × ℝ, w.2 < 1 → simScale h (w.1 2) (1 - w.2) ≤ 1 →
        w.1 0 ^ 2 + w.1 1 ^ 2 ≤ M * simScale h (w.1 2) (1 - w.2) →
        ‖iteratedFDeriv ℝ k f w‖ ≤ C * simScale h (w.1 2) (1 - w.2) ^ (-K)) →
      ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k f w‖ ≤ C * Q w ^ (-K) := by
    intro F _ _ f hf k
    obtain ⟨C, K, hCK⟩ := hf k
    refine ⟨C, K, fun w hw => ?_⟩
    obtain ⟨h1, h2, h3⟩ := (hmemS w).1 hw
    rw [hQ]
    exact hCK w h1 h2 h3

  obtain ⟨hΦs, hΦb⟩ := simXEta_wt_bound h M hS h0 hh2 hM
  have hΦs' : ContDiffOn ℝ ∞ Φ Ω := by rw [hΦ, hΩ]; exact hΦs
  have hΦb' : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k Φ w‖ ≤ C * Q w ^ (-K) := by
    rw [hΦ]; exact hconv _ hΦb
  have houter : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S,
      ‖iteratedFDeriv ℝ k (↿g) (Φ w)‖ ≤ C * Q w ^ (-K) := by
    intro k
    obtain ⟨C, hC⟩ := hgb (M / 2) k
    refine ⟨C, 0, fun w hw => ?_⟩
    obtain ⟨h1, h2, h3⟩ := (hmemS w).1 hw
    obtain ⟨⟨-, hX0, he1, he2⟩, hsec⟩ := hreg w h1
    obtain ⟨-, hXM⟩ := hsec h2 h3
    rw [neg_zero, Real.rpow_zero, mul_one, hΦ]
    exact hC _ _ hX0 hXM he1 he2
  obtain ⟨hGs, hGb⟩ := wt_comp_bound (↿g) Φ Q Ω S (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) hΩo hTo hSΩ
    hmaps hρ hg hΦs' houter hΦb'

  have hpow : ∀ p : ℝ, ContDiffOn ℝ ∞ (fun z => Q z ^ p) Ω ∧
      ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k (fun z => Q z ^ p) w‖ ≤ C * Q w ^ (-K) := by
    intro p
    obtain ⟨hs, hb⟩ := simScale_rpow_wt_bound h p hS h0 hh2
    refine ⟨by rw [hQ, hΩ]; exact hs, fun k => ?_⟩
    obtain ⟨C, K, hCK⟩ := hb k
    refine ⟨C, K, fun w hw => ?_⟩
    obtain ⟨h1, h2, -⟩ := (hmemS w).1 hw
    rw [hQ]
    exact hCK w h1 h2

  have hJs : ContDiff ℝ ∞ Jf := by
    have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => z.1 i) := fun i =>
      ((EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).comp (ContinuousLinearMap.fst ℝ ℝ³ ℝ)).contDiff
    rw [hJf]
    exact ((hc 1).neg.smul contDiff_const).add ((hc 0).smul contDiff_const)
  have hJb : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k Jf w‖ ≤ C * Q w ^ (-K) := by
    intro k
    obtain ⟨C, hC⟩ := ball_iteratedFDeriv_bound Jf hJs (M + 1) k
    refine ⟨C, 0, fun w hw => ?_⟩
    obtain ⟨h1, h2, h3⟩ := (hmemS w).1 hw
    obtain ⟨hn, -⟩ := (hreg w h1).2 h2 h3
    rw [neg_zero, Real.rpow_zero, mul_one]
    exact hC w hn

  obtain ⟨hPs, hPb⟩ := wt_bilinear_bound (ContinuousLinearMap.mul ℝ ℝ)
    (fun z => Q z ^ (-(1 + 2 * h) + 2 * (n : ℝ) * h)) (↿g ∘ Φ) Q Ω S hΩo hSΩ hρ
    (hpow _).1 hGs (hpow _).2 hGb
  obtain ⟨hsBs, hsBb⟩ := wt_bilinear_bound (ContinuousLinearMap.mul ℝ ℝ)
    (fun z => Q z ^ (-(1 + h) + 2 * (n : ℝ) * h)) (↿g ∘ Φ) Q Ω S hΩo hSΩ hρ
    (hpow _).1 hGs (hpow _).2 hGb
  obtain ⟨-, hBb⟩ := wt_bilinear_bound (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
    _ Jf Q Ω S hΩo hSΩ hρ hsBs hJs.contDiffOn hsBb hJb
  obtain ⟨hsAs, hsAb⟩ := wt_bilinear_bound ((1 / 2 : ℝ) • ContinuousLinearMap.mul ℝ ℝ)
    (fun z => Q z ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h)) (↿g ∘ Φ) Q Ω S hΩo hSΩ hρ
    (hpow _).1 hGs (hpow _).2 hGb
  obtain ⟨-, hAb⟩ := wt_bilinear_bound (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
    _ Jf Q Ω S hΩo hSΩ hρ hsAs hJs.contDiffOn hsAb hJb

  have eP : (↿(bgPn h n g)) = fun z => ContinuousLinearMap.mul ℝ ℝ
      (Q z ^ (-(1 + 2 * h) + 2 * (n : ℝ) * h)) ((↿g ∘ Φ) z) := by
    funext z
    rw [ContinuousLinearMap.mul_apply', hQ, hΦ]
    rfl
  have eB : (↿(bgBn h n g)) = fun z => (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
      (ContinuousLinearMap.mul ℝ ℝ (Q z ^ (-(1 + h) + 2 * (n : ℝ) * h)) ((↿g ∘ Φ) z)) (Jf z) := by
    funext z
    rw [ContinuousLinearMap.lsmul_apply, ContinuousLinearMap.mul_apply', hQ, hΦ, hJf]
    rfl
  have eA : (↿(bgAn h n g)) = fun z => (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³)
      (((1 / 2 : ℝ) • ContinuousLinearMap.mul ℝ ℝ) (Q z ^ (-(1 / 2 + h) + 2 * (n : ℝ) * h))
        ((↿g ∘ Φ) z)) (Jf z) := by
    funext z
    rw [ContinuousLinearMap.lsmul_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smul_apply, ContinuousLinearMap.mul_apply', smul_eq_mul, hQ, hΦ, hJf,
      ← mul_assoc]
    rfl

  obtain ⟨CA, KA, hA⟩ := hAb m
  obtain ⟨CB, KB, hB⟩ := hBb m
  obtain ⟨CP, KP, hP⟩ := hPb m
  refine ⟨|CA| + |CB| + |CP|, max (max KA KB) KP, ?_⟩
  intro x t ht hq1 hr
  have hw : ((x, t) : ℝ³ × ℝ) ∈ S := (hmemS (x, t)).2 ⟨ht, hq1, hr⟩
  have hQw : Q (x, t) = simScale h (x 2) (1 - t) := by rw [hQ]
  have hq0 : 0 < simScale h (x 2) (1 - t) := by rw [← hQw]; exact (hρ _ hw).1
  have hqK0 : 0 ≤ simScale h (x 2) (1 - t) ^ (-max (max KA KB) KP) :=
    (Real.rpow_pos_of_pos hq0 _).le
  have hgen : ∀ Ci Ki : ℝ, Ki ≤ max (max KA KB) KP → |Ci| ≤ |CA| + |CB| + |CP| →
      Ci * Q (x, t) ^ (-Ki) ≤
        (|CA| + |CB| + |CP|) * simScale h (x 2) (1 - t) ^ (-max (max KA KB) KP) := by
    intro Ci Ki hKi hCi
    rw [hQw]
    calc Ci * simScale h (x 2) (1 - t) ^ (-Ki)
        ≤ |Ci| * simScale h (x 2) (1 - t) ^ (-Ki) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_pos_of_pos hq0 _).le
      _ ≤ |Ci| * simScale h (x 2) (1 - t) ^ (-max (max KA KB) KP) :=
          mul_le_mul_of_nonneg_left
            (Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (by linarith)) (abs_nonneg _)
      _ ≤ (|CA| + |CB| + |CP|) * simScale h (x 2) (1 - t) ^ (-max (max KA KB) KP) :=
          mul_le_mul_of_nonneg_right hCi hqK0
  have hKA : KA ≤ max (max KA KB) KP := (le_max_left KA KB).trans (le_max_left _ _)
  have hKB : KB ≤ max (max KA KB) KP := (le_max_right KA KB).trans (le_max_left _ _)
  have hKP : KP ≤ max (max KA KB) KP := le_max_right _ _
  refine ⟨?_, ?_, ?_⟩
  · rw [eA]
    exact (hA _ hw).trans (hgen CA KA hKA (by linarith [abs_nonneg CB, abs_nonneg CP]))
  · rw [eB]
    exact (hB _ hw).trans (hgen CB KB hKB (by linarith [abs_nonneg CA, abs_nonneg CP]))
  · rw [eP]
    exact (hP _ hw).trans (hgen CP KP hKP (by linarith [abs_nonneg CA, abs_nonneg CB]))

theorem heat_field_scaled_bounds : ∀ (h c M : ℝ), 0 < h → h < 1 / 2 → 0 < M → HeatExteriorProps h c → ∀ m : ℕ, ∃ C K : ℝ, 0 ≤ K ∧ ∀ (x : ℝ³) (t : ℝ), t < 1 → M * (1 - t) < x 0 ^ 2 + x 1 ^ 2 → ‖iteratedFDeriv ℝ m (↿(heatSwirl h c)) (x, t)‖ ≤ C * (1 + (x 0 ^ 2 + x 1 ^ 2) ^ (-K)) ∧ ‖iteratedFDeriv ℝ m (↿(heatPressure h c)) (x, t)‖ ≤ C * (1 + (x 0 ^ 2 + x 1 ^ 2) ^ (-K)) :=
by
  intro h c M hh0 hh1 hM hH m

  have hsw : ∀ (lam : ℝ) (x : ℝ³) (t : ℝ), 0 < lam → 0 < x 0 ^ 2 + x 1 ^ 2 →
      heatSwirl h c (lam • x) (1 - lam ^ 2 * (1 - t)) = lam ^ (-(1 + 2 * h)) • heatSwirl h c x t := by
    intro lam x t hlam hR
    have e0 : (lam • x) 0 = lam * x 0 := by simp
    have e1 : (lam • x) 1 = lam * x 1 := by simp
    have hrad : (lam * x 0) ^ 2 + (lam * x 1) ^ 2 = lam ^ 2 * (x 0 ^ 2 + x 1 ^ 2) := by ring
    have harg : 4 * (1 - (1 - lam ^ 2 * (1 - t))) / (lam ^ 2 * (x 0 ^ 2 + x 1 ^ 2)) =
        4 * (1 - t) / (x 0 ^ 2 + x 1 ^ 2) := by
      rw [div_eq_div_iff (by positivity) hR.ne']; ring
    have hpow : (lam ^ 2 * (x 0 ^ 2 + x 1 ^ 2)) ^ (-(1 + h)) =
        lam ^ (-(2 + 2 * h)) * (x 0 ^ 2 + x 1 ^ 2) ^ (-(1 + h)) := by
      rw [Real.mul_rpow (by positivity) hR.le]
      congr 1
      rw [← Real.rpow_natCast, ← Real.rpow_mul hlam.le]
      congr 1; push_cast; ring
    have hlp : lam ^ (-(2 + 2 * h)) * lam = lam ^ (-(1 + 2 * h)) := by
      rw [← Real.rpow_add_one hlam.ne']; congr 1; ring
    unfold heatSwirl
    rw [e0, e1, hrad, harg, hpow, ← hlp]
    module

  have hpr : ∀ (lam : ℝ) (x : ℝ³) (t : ℝ), 0 < lam → 0 < x 0 ^ 2 + x 1 ^ 2 →
      heatPressure h c (lam • x) (1 - lam ^ 2 * (1 - t)) = lam ^ (-(2 + 4 * h)) * heatPressure h c x t := by
    intro lam x t hlam hR
    have e0 : (lam • x) 0 = lam * x 0 := by simp
    have e1 : (lam • x) 1 = lam * x 1 := by simp
    have hrad : (lam * x 0) ^ 2 + (lam * x 1) ^ 2 = lam ^ 2 * (x 0 ^ 2 + x 1 ^ 2) := by ring
    have hl2 : 0 < lam ^ 2 := by positivity
    have hsub : ∫ u in Ioi (x 0 ^ 2 + x 1 ^ 2), (lam ^ 2 * u) ^ (-(2 + 2 * h)) *
          heatProfile h (4 * (1 - (1 - lam ^ 2 * (1 - t))) / (lam ^ 2 * u)) ^ 2
        = (lam ^ 2)⁻¹ • ∫ s in Ioi (lam ^ 2 * (x 0 ^ 2 + x 1 ^ 2)), s ^ (-(2 + 2 * h)) *
          heatProfile h (4 * (1 - (1 - lam ^ 2 * (1 - t))) / s) ^ 2 :=
      MeasureTheory.integral_comp_mul_left_Ioi (fun s => s ^ (-(2 + 2 * h)) *
          heatProfile h (4 * (1 - (1 - lam ^ 2 * (1 - t))) / s) ^ 2) _ hl2
    have hcongr : ∫ u in Ioi (x 0 ^ 2 + x 1 ^ 2), (lam ^ 2 * u) ^ (-(2 + 2 * h)) *
          heatProfile h (4 * (1 - (1 - lam ^ 2 * (1 - t))) / (lam ^ 2 * u)) ^ 2
        = ∫ u in Ioi (x 0 ^ 2 + x 1 ^ 2), lam ^ (-(4 + 4 * h)) *
          (u ^ (-(2 + 2 * h)) * heatProfile h (4 * (1 - t) / u) ^ 2) := by
      apply MeasureTheory.setIntegral_congr_fun measurableSet_Ioi
      intro u hu
      have hu0 : 0 < u := lt_trans hR hu
      try dsimp only
      rw [Real.mul_rpow hl2.le hu0.le]
      have ea : 4 * (1 - (1 - lam ^ 2 * (1 - t))) / (lam ^ 2 * u) = 4 * (1 - t) / u := by
        rw [div_eq_div_iff (by positivity) hu0.ne']; ring
      have eb : (lam ^ 2) ^ (-(2 + 2 * h)) = lam ^ (-(4 + 4 * h)) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul hlam.le]; congr 1; push_cast; ring
      rw [ea, eb]; ring
    rw [hcongr, MeasureTheory.integral_const_mul, smul_eq_mul,
      eq_inv_mul_iff_mul_eq₀ hl2.ne'] at hsub
    have ec : lam ^ 2 * lam ^ (-(4 + 4 * h)) = lam ^ (-(2 + 4 * h)) := by
      rw [← Real.rpow_natCast, ← Real.rpow_add hlam]; congr 1; push_cast; ring
    unfold heatPressure
    rw [e0, e1, hrad, ← hsub, ← ec]
    ring

  have htr : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (lam a : ℝ)
      (z : ℝ³ × ℝ), 0 < lam → ContDiffAt ℝ m f z →
      (fun w : ℝ³ × ℝ => f (lam • w.1, 1 - lam ^ 2 * (1 - w.2))) =ᶠ[nhds z]
        (fun w => lam ^ (-a) • f w) →
      ‖iteratedFDeriv ℝ m f z‖ ≤
        lam ^ a * (max lam (lam ^ 2)) ^ m * ‖iteratedFDeriv ℝ m f (lam • z.1, 1 - lam ^ 2 * (1 - z.2))‖ := by
    intro F _ _ f lam a z hlam hf hev
    have hl2 : (lam ^ 2 : ℝ) ≠ 0 := by positivity
    obtain ⟨L, hL⟩ : ∃ L : (ℝ³ × ℝ) ≃L[ℝ] (ℝ³ × ℝ), ∀ w, L w = (lam • w.1, lam ^ 2 * w.2) :=
      ⟨(LinearEquiv.smulOfNeZero ℝ ℝ³ lam hlam.ne').toContinuousLinearEquiv.prodCongr
        (LinearEquiv.smulOfNeZero ℝ ℝ (lam ^ 2) hl2).toContinuousLinearEquiv, fun w => rfl⟩
    obtain ⟨b, hb⟩ : ∃ b : ℝ³ × ℝ, b = ((0 : ℝ³), 1 - lam ^ 2) := ⟨_, rfl⟩
    have hΦ : ∀ w : ℝ³ × ℝ, ((lam • w.1, 1 - lam ^ 2 * (1 - w.2)) : ℝ³ × ℝ) = L w + b := by
      intro w
      rw [hL, hb]
      refine Prod.ext ?_ ?_ <;> simp <;> ring
    have hcomp : iteratedFDeriv ℝ m (fun w : ℝ³ × ℝ => f (lam • w.1, 1 - lam ^ 2 * (1 - w.2))) z =
        (iteratedFDeriv ℝ m f (L z + b)).compContinuousLinearMap
          (fun _ => (L : (ℝ³ × ℝ) →L[ℝ] (ℝ³ × ℝ))) := by
      have e1 : (fun w : ℝ³ × ℝ => f (lam • w.1, 1 - lam ^ 2 * (1 - w.2))) =
          (fun y => f (y + b)) ∘ L := by
        funext w
        show f (lam • w.1, 1 - lam ^ 2 * (1 - w.2)) = f (L w + b)
        rw [hΦ]
      rw [e1]
      have := L.iteratedFDerivWithin_comp_right (fun y => f (y + b)) uniqueDiffOn_univ (mem_univ (L z)) m
      rw [Set.preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at this
      rw [this, iteratedFDeriv_comp_add_right]
    have hsm : iteratedFDeriv ℝ m (fun w : ℝ³ × ℝ => f (lam • w.1, 1 - lam ^ 2 * (1 - w.2))) z =
        lam ^ (-a) • iteratedFDeriv ℝ m f z := by
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
      exact iteratedFDeriv_const_smul_apply' hf
    have hLn : ‖(L : (ℝ³ × ℝ) →L[ℝ] (ℝ³ × ℝ))‖ ≤ max lam (lam ^ 2) := by
      apply ContinuousLinearMap.opNorm_le_bound _ (le_max_of_le_left hlam.le)
      intro w
      have h1 : ‖w.1‖ ≤ ‖w‖ := norm_fst_le w
      have h2 : ‖w.2‖ ≤ ‖w‖ := norm_snd_le w
      have hw : (L : (ℝ³ × ℝ) →L[ℝ] (ℝ³ × ℝ)) w = (lam • w.1, lam ^ 2 * w.2) := hL w
      rw [hw, Prod.norm_def]
      show max ‖lam • w.1‖ ‖lam ^ 2 * w.2‖ ≤ _
      apply max_le
      · rw [norm_smul, Real.norm_eq_abs, abs_of_pos hlam]
        exact mul_le_mul (le_max_left _ _) h1 (norm_nonneg _) (le_max_of_le_left hlam.le)
      · rw [norm_mul, Real.norm_eq_abs, abs_of_pos (by positivity : (0:ℝ) < lam ^ 2)]
        exact mul_le_mul (le_max_right _ _) h2 (norm_nonneg _) (le_max_of_le_left hlam.le)
    have key : lam ^ (-a) * ‖iteratedFDeriv ℝ m f z‖ ≤
        ‖iteratedFDeriv ℝ m f (L z + b)‖ * (max lam (lam ^ 2)) ^ m := by
      have e := hsm.symm.trans hcomp
      have hn := congrArg norm e
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (Real.rpow_pos_of_pos hlam _)] at hn
      rw [hn]
      refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
      simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) hLn m) (norm_nonneg _)
    rw [hΦ z]
    have hpa : 0 < lam ^ a := Real.rpow_pos_of_pos hlam a
    have hinv : lam ^ a * lam ^ (-a) = 1 := by rw [← Real.rpow_add hlam]; simp
    calc ‖iteratedFDeriv ℝ m f z‖ = lam ^ a * (lam ^ (-a) * ‖iteratedFDeriv ℝ m f z‖) := by
          rw [← mul_assoc, hinv, one_mul]
      _ ≤ lam ^ a * (‖iteratedFDeriv ℝ m f (L z + b)‖ * (max lam (lam ^ 2)) ^ m) :=
          mul_le_mul_of_nonneg_left key hpa.le
      _ = _ := by ring

  have hwt : ∀ (a K R ρ lam : ℝ), 0 < a → a + 2 * (m : ℝ) ≤ 2 * K → 0 < R → 0 < ρ → ρ ≤ 1 →
      0 < lam → lam ^ 2 = ρ / R → lam ^ a * (max lam (lam ^ 2)) ^ m ≤ 1 + R ^ (-K) := by
    intro a K R ρ lam ha haK hR hρ hρ1 hlam hl2
    have hRK : 0 ≤ R ^ (-K) := Real.rpow_nonneg hR.le _
    rcases le_or_gt lam 1 with hl | hl
    · have hmax : max lam (lam ^ 2) = lam := max_eq_left (by nlinarith)
      rw [hmax]
      have h1 : lam ^ a ≤ 1 := Real.rpow_le_one hlam.le hl ha.le
      have h2 : lam ^ m ≤ 1 := pow_le_one₀ hlam.le hl
      have h3 : lam ^ a * lam ^ m ≤ 1 := by
        calc lam ^ a * lam ^ m ≤ 1 * 1 :=
              mul_le_mul h1 h2 (pow_nonneg hlam.le m) zero_le_one
          _ = 1 := by ring
      linarith
    · have hmax : max lam (lam ^ 2) = lam ^ 2 := max_eq_right (by nlinarith)
      rw [hmax]
      have hK : 0 < K := by have : (0:ℝ) ≤ m := Nat.cast_nonneg m; linarith
      have e1 : (lam ^ 2) ^ m = lam ^ (2 * (m : ℝ)) := by
        rw [← pow_mul, ← Real.rpow_natCast]; norm_num
      rw [e1, ← Real.rpow_add hlam]
      have e2 : lam ^ (a + 2 * (m:ℝ)) ≤ lam ^ (2 * K) := Real.rpow_le_rpow_of_exponent_le hl.le haK
      have e3 : lam ^ (2 * K) = ρ ^ K * R ^ (-K) := by
        rw [Real.rpow_mul hlam.le, show lam ^ (2:ℝ) = ρ / R by rw [Real.rpow_two]; exact hl2,
          Real.div_rpow hρ.le hR.le, Real.rpow_neg hR.le, div_eq_mul_inv]
      have e4 : ρ ^ K ≤ 1 := Real.rpow_le_one hρ.le hρ1 hK.le
      have e5 : ρ ^ K * R ^ (-K) ≤ R ^ (-K) := by
        calc ρ ^ K * R ^ (-K) ≤ 1 * R ^ (-K) := mul_le_mul_of_nonneg_right e4 hRK
          _ = R ^ (-K) := one_mul _
      linarith

  obtain ⟨hSs, hPs, -, hBox⟩ := hH
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ℝ, ρ = min 1 M := ⟨_, rfl⟩
  have hρ0 : 0 < ρ := by rw [hρdef]; exact lt_min one_pos hM
  have hρ1 : ρ ≤ 1 := by rw [hρdef]; exact min_le_left _ _
  have hρM : ρ ≤ M := by rw [hρdef]; exact min_le_right _ _
  have hr0 : 0 < Real.sqrt ρ := Real.sqrt_pos.mpr hρ0
  have hr0sq : Real.sqrt ρ ^ 2 = ρ := Real.sq_sqrt hρ0.le
  obtain ⟨C₀, hC₀⟩ := hBox (Real.sqrt ρ) hr0 m
  have hcR : Continuous (fun w : ℝ³ × ℝ => w.1 0 ^ 2 + w.1 1 ^ 2) := by fun_prop
  have hV : IsOpen {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2} :=
    isOpen_lt continuous_const hcR
  have hU : IsOpen {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2 ∧ w.2 < 1} :=
    hV.inter (isOpen_lt continuous_snd continuous_const)
  refine ⟨max C₀ 0, 1 + 2 * h + m, by have : (0:ℝ) ≤ m := Nat.cast_nonneg m; linarith, ?_⟩
  intro x t ht hR
  have hτ : 0 < 1 - t := by linarith
  have hRpos : 0 < x 0 ^ 2 + x 1 ^ 2 := lt_trans (mul_pos hM hτ) hR
  obtain ⟨lam, hlamdef⟩ : ∃ lam : ℝ, lam = Real.sqrt (ρ / (x 0 ^ 2 + x 1 ^ 2)) := ⟨_, rfl⟩
  have hlam : 0 < lam := by rw [hlamdef]; exact Real.sqrt_pos.mpr (div_pos hρ0 hRpos)
  have hl2 : lam ^ 2 = ρ / (x 0 ^ 2 + x 1 ^ 2) := by
    rw [hlamdef]; exact Real.sq_sqrt (div_pos hρ0 hRpos).le
  have hrad : (lam • x) 0 ^ 2 + (lam • x) 1 ^ 2 = ρ := by
    have e0 : (lam • x) 0 = lam * x 0 := by simp
    have e1 : (lam • x) 1 = lam * x 1 := by simp
    rw [e0, e1, show (lam * x 0) ^ 2 + (lam * x 1) ^ 2 = lam ^ 2 * (x 0 ^ 2 + x 1 ^ 2) by ring, hl2]
    exact div_mul_cancel₀ _ hRpos.ne'
  have ht1 : 0 < 1 - lam ^ 2 * (1 - t) := by
    rw [hl2]
    have : ρ * (1 - t) < x 0 ^ 2 + x 1 ^ 2 :=
      lt_of_le_of_lt (mul_le_mul_of_nonneg_right hρM hτ.le) hR
    rw [div_mul_eq_mul_div, sub_pos, div_lt_one hRpos]
    exact this
  have ht2 : 1 - lam ^ 2 * (1 - t) < 1 := by
    have : 0 < lam ^ 2 * (1 - t) := by positivity
    linarith
  obtain ⟨b1, b2⟩ := hC₀ (lam • x) (1 - lam ^ 2 * (1 - t)) (le_of_eq (by rw [hrad, hr0sq]))
    (by rw [hrad]; exact hρ1) ht1 ht2
  have hz : ((x, t) : ℝ³ × ℝ) ∈ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2 ∧ w.2 < 1} := ⟨hRpos, ht⟩
  have hmle : ((m : ℕ∞) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have hcdS : ContDiffAt ℝ m (↿(heatSwirl h c)) (x, t) :=
    (hSs.contDiffAt (hU.mem_nhds hz)).of_le hmle
  have hcdP : ContDiffAt ℝ m (↿(heatPressure h c)) (x, t) :=
    (hPs.contDiffAt (hU.mem_nhds hz)).of_le hmle
  have hevS : (fun w : ℝ³ × ℝ => (↿(heatSwirl h c)) (lam • w.1, 1 - lam ^ 2 * (1 - w.2))) =ᶠ[nhds (x, t)]
      (fun w => lam ^ (-(1 + 2 * h)) • (↿(heatSwirl h c)) w) :=
    Filter.eventuallyEq_of_mem (hV.mem_nhds hRpos) (fun w hw => hsw lam w.1 w.2 hlam hw)
  have hevP : (fun w : ℝ³ × ℝ => (↿(heatPressure h c)) (lam • w.1, 1 - lam ^ 2 * (1 - w.2))) =ᶠ[nhds (x, t)]
      (fun w => lam ^ (-(2 + 4 * h)) • (↿(heatPressure h c)) w) :=
    Filter.eventuallyEq_of_mem (hV.mem_nhds hRpos) (fun w hw => hpr lam w.1 w.2 hlam hw)
  have hS3 := htr (↿(heatSwirl h c)) lam (1 + 2 * h) (x, t) hlam hcdS hevS
  have hP3 := htr (↿(heatPressure h c)) lam (2 + 4 * h) (x, t) hlam hcdP hevP
  have hW1 := hwt (1 + 2 * h) (1 + 2 * h + m) (x 0 ^ 2 + x 1 ^ 2) ρ lam (by linarith) (by linarith)
    hRpos hρ0 hρ1 hlam hl2
  have hW2 := hwt (2 + 4 * h) (1 + 2 * h + m) (x 0 ^ 2 + x 1 ^ 2) ρ lam (by linarith) (by linarith)
    hRpos hρ0 hρ1 hlam hl2
  have hC0 : 0 ≤ max C₀ 0 := le_max_right _ _
  have hfac : ∀ a : ℝ, 0 ≤ lam ^ a * (max lam (lam ^ 2)) ^ m := fun a =>
    mul_nonneg (Real.rpow_pos_of_pos hlam a).le (pow_nonneg (le_max_of_le_left hlam.le) m)
  constructor
  · exact hS3.trans ((mul_le_mul_of_nonneg_left (b1.trans (le_max_left _ _)) (hfac _)).trans
      ((mul_le_mul_of_nonneg_right hW1 hC0).trans (le_of_eq (mul_comm _ _))))
  · exact hP3.trans ((mul_le_mul_of_nonneg_left (b2.trans (le_max_left _ _)) (hfac _)).trans
      ((mul_le_mul_of_nonneg_right hW2 hC0).trans (le_of_eq (mul_comm _ _))))

theorem leadV_smooth_bounds : ∀ (h ε : ℝ) (U : ℝ → ℝ → ℝ), 0 < h → h < 1 / 2 → 0 < ε → ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1) 1) → (∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿U) (X, η)‖ ≤ C) → ContDiffOn ℝ ∞ (↿(leadV h U)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 < X → X ≤ X₁ → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿(leadV h U)) (X, η)‖ ≤ C :=
by
  intro h ε U hh0 hh1 hε hU hbdU
  have hOo : IsOpen (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hO'o : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hO'O : Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi (-ε) ×ˢ Ioo (-1) 1 :=
    fun p hp => ⟨lt_trans (neg_lt_zero.mpr hε) hp.1, hp.2⟩
  obtain ⟨hSsm, hSbd, -⟩ := profRadAvg_props U ε hε hU

  obtain ⟨v, hv⟩ : ∃ v : ℝ × ℝ, v = ((0:ℝ), (1:ℝ)) := ⟨_, rfl⟩
  have hfd : ContDiffOn ℝ ∞ (fderiv ℝ (↿(profRadAvg U))) (Ioi (-ε) ×ˢ Ioo (-1) 1) :=
    hSsm.fderiv_of_isOpen hOo (by simp)
  have hTeq : ∀ p ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1, (↿(profEtaD (profRadAvg U))) p =
      ((ContinuousLinearMap.apply ℝ ℝ v) ∘ fderiv ℝ (↿(profRadAvg U))) p := by
    rintro ⟨X, η⟩ hp
    have hd : DifferentiableAt ℝ (↿(profRadAvg U)) (X, η) :=
      (hSsm.contDiffAt (hOo.mem_nhds hp)).differentiableAt (by simp)
    have hγ : HasDerivAt (fun e : ℝ => ((X, e) : ℝ × ℝ)) v η := by
      rw [hv]; exact (hasDerivAt_const η X).prodMk (hasDerivAt_id η)
    have hc := HasFDerivAt.comp_hasDerivAt η hd.hasFDerivAt hγ
    rw [Function.comp_apply, ContinuousLinearMap.apply_apply]
    exact hc.deriv
  have hTsm : ContDiffOn ℝ ∞ (↿(profEtaD (profRadAvg U))) (Ioi (-ε) ×ˢ Ioo (-1) 1) :=
    ((ContinuousLinearMap.apply ℝ ℝ v).contDiff.comp_contDiffOn hfd).congr hTeq
  have hTbd : ∀ (k : ℕ) (p : ℝ × ℝ), p ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 →
      ‖iteratedFDeriv ℝ k (↿(profEtaD (profRadAvg U))) p‖ ≤
        ‖ContinuousLinearMap.apply ℝ ℝ v‖ * ‖iteratedFDeriv ℝ (k + 1) (↿(profRadAvg U)) p‖ := by
    intro k p hp
    have hev : (↿(profEtaD (profRadAvg U))) =ᶠ[nhds p]
        ((ContinuousLinearMap.apply ℝ ℝ v) ∘ fderiv ℝ (↿(profRadAvg U))) :=
      Filter.eventuallyEq_of_mem (hOo.mem_nhds hp) hTeq
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, ← norm_iteratedFDeriv_fderiv]
    exact ContinuousLinearMap.norm_iteratedFDeriv_comp_left _ (hfd.contDiffAt (hOo.mem_nhds hp))
      (by exact_mod_cast le_top)

  have hKW : ∀ p : ℝ × ℝ, -1 ≤ p.2 → p.2 ≤ 1 → 0 < 1 - 2 * h * p.2 ^ 2 := by
    intro p h1 h2
    have h3 : p.2 ^ 2 ≤ 1 := by nlinarith
    nlinarith
  have hWo : IsOpen {p : ℝ × ℝ | 0 < 1 - 2 * h * p.2 ^ 2} :=
    isOpen_lt continuous_const (show Continuous (fun p : ℝ × ℝ => 1 - 2 * h * p.2 ^ 2) by fun_prop)
  have hcoef : ∀ P : ℝ → ℝ, ContDiff ℝ ∞ P → ∀ c : ℝ × ℝ → ℝ,
      c = (fun p : ℝ × ℝ => p.1 * P p.2 / (1 - 2 * h * p.2 ^ 2)) →
      ContDiffOn ℝ ∞ c (Ioi 0 ×ˢ Ioo (-1) 1) ∧
      ∀ X₁ : ℝ, ∀ k : ℕ, ∃ C : ℝ, ∀ p : ℝ × ℝ, 0 ≤ p.1 → p.1 ≤ X₁ → -1 ≤ p.2 → p.2 ≤ 1 →
        ‖iteratedFDeriv ℝ k c p‖ ≤ C := by
    intro P hP c hc
    subst hc
    have hsm : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 * P p.2 / (1 - 2 * h * p.2 ^ 2))
        {p : ℝ × ℝ | 0 < 1 - 2 * h * p.2 ^ 2} :=
      ContDiffOn.div (f := fun p : ℝ × ℝ => p.1 * P p.2) (g := fun p : ℝ × ℝ => 1 - 2 * h * p.2 ^ 2)
        (contDiff_fst.mul (hP.comp contDiff_snd)).contDiffOn
        (contDiff_const.sub (contDiff_const.mul (contDiff_snd.pow 2))).contDiffOn
        (fun p hp => ne_of_gt hp)
    refine ⟨hsm.mono (fun p hp => hKW p hp.2.1.le hp.2.2.le), fun X₁ k => ?_⟩
    have hcont : ContinuousOn
        (iteratedFDeriv ℝ k (fun p : ℝ × ℝ => p.1 * P p.2 / (1 - 2 * h * p.2 ^ 2)))
        {p : ℝ × ℝ | 0 < 1 - 2 * h * p.2 ^ 2} :=
      (hsm.continuousOn_iteratedFDerivWithin (by exact_mod_cast le_top) hWo.uniqueDiffOn).congr
        (fun p hp => (iteratedFDerivWithin_of_isOpen k hWo hp).symm)
    obtain ⟨C, hC⟩ := (isCompact_Icc.prod isCompact_Icc).exists_bound_of_continuousOn
      (hcont.mono (fun p (hp : p ∈ Icc 0 X₁ ×ˢ Icc (-1:ℝ) 1) => hKW p hp.2.1 hp.2.2))
    exact ⟨C, fun p h1 h2 h3 h4 => hC p ⟨⟨h1, h2⟩, h3, h4⟩⟩
  obtain ⟨cA, hcA⟩ : ∃ c : ℝ × ℝ → ℝ,
      c = fun p => p.1 * (2 * p.2) / (1 - 2 * h * p.2 ^ 2) := ⟨_, rfl⟩
  obtain ⟨cB, hcB⟩ : ∃ c : ℝ × ℝ → ℝ,
      c = fun p => p.1 * (-(2 * (1 / 2 - h) * p.2)) / (1 - 2 * h * p.2 ^ 2) := ⟨_, rfl⟩
  obtain ⟨cC, hcC⟩ : ∃ c : ℝ × ℝ → ℝ,
      c = fun p => p.1 * (-(1 - p.2 ^ 2)) / (1 - 2 * h * p.2 ^ 2) := ⟨_, rfl⟩
  obtain ⟨hAs, hAb⟩ := hcoef (fun e => 2 * e) (by fun_prop) cA hcA
  obtain ⟨hBs, hBb⟩ := hcoef (fun e => -(2 * (1 / 2 - h) * e)) (by fun_prop) cB hcB
  obtain ⟨hCs, hCb⟩ := hcoef (fun e => -(1 - e ^ 2)) (by fun_prop) cC hcC

  have hid : (↿(leadV h U)) = fun p => (cA p * (↿U) p + cB p * (↿(profRadAvg U)) p) +
      cC p * (↿(profEtaD (profRadAvg U))) p := by
    funext p
    rw [hcA, hcB, hcC]
    show leadV h U p.1 p.2 = (p.1 * (2 * p.2) / (1 - 2 * h * p.2 ^ 2) * U p.1 p.2 +
      p.1 * (-(2 * (1 / 2 - h) * p.2)) / (1 - 2 * h * p.2 ^ 2) * profRadAvg U p.1 p.2) +
      p.1 * (-(1 - p.2 ^ 2)) / (1 - 2 * h * p.2 ^ 2) * profEtaD (profRadAvg U) p.1 p.2
    unfold leadV
    ring
  have hUO' := hU.mono hO'O
  have hSO' := hSsm.mono hO'O
  have hTO' := hTsm.mono hO'O
  have hpA : ContDiffOn ℝ ∞ (fun p => cA p * (↿U) p) (Ioi 0 ×ˢ Ioo (-1) 1) := hAs.mul hUO'
  have hpB : ContDiffOn ℝ ∞ (fun p => cB p * (↿(profRadAvg U)) p) (Ioi 0 ×ˢ Ioo (-1) 1) :=
    hBs.mul hSO'
  have hpC : ContDiffOn ℝ ∞ (fun p => cC p * (↿(profEtaD (profRadAvg U))) p)
      (Ioi 0 ×ˢ Ioo (-1) 1) := hCs.mul hTO'
  refine ⟨?_, ?_⟩
  · rw [hid]; exact (hpA.add hpB).add hpC
  · intro X₁ m
    have hBsub : {p : ℝ × ℝ | p ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ∧ p.1 ≤ X₁} ⊆
        Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := fun p hp => hp.1
    have bcoef : ∀ c : ℝ × ℝ → ℝ, (∀ X₁ : ℝ, ∀ k : ℕ, ∃ C : ℝ, ∀ p : ℝ × ℝ, 0 ≤ p.1 → p.1 ≤ X₁ →
        -1 ≤ p.2 → p.2 ≤ 1 → ‖iteratedFDeriv ℝ k c p‖ ≤ C) → ∀ k : ℕ, ∃ C : ℝ,
        ∀ z ∈ {p : ℝ × ℝ | p ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ∧ p.1 ≤ X₁},
          ‖iteratedFDeriv ℝ k c z‖ ≤ C := by
      intro c hc k
      obtain ⟨C, hC⟩ := hc X₁ k
      exact ⟨C, fun z hz => hC z (le_of_lt hz.1.1) hz.2 hz.1.2.1.le hz.1.2.2.le⟩
    have bU : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ {p : ℝ × ℝ | p ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ∧ p.1 ≤ X₁},
        ‖iteratedFDeriv ℝ k (↿U) z‖ ≤ C := by
      intro k
      obtain ⟨C, hC⟩ := hbdU X₁ k
      exact ⟨C, fun z hz => hC z.1 z.2 (le_of_lt hz.1.1) hz.2 hz.1.2.1 hz.1.2.2⟩
    have bS : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ {p : ℝ × ℝ | p ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ∧ p.1 ≤ X₁},
        ‖iteratedFDeriv ℝ k (↿(profRadAvg U)) z‖ ≤ C := by
      intro k
      obtain ⟨C, hC⟩ := hSbd X₁ k (hbdU X₁ k)
      exact ⟨C, fun z hz => hC z.1 z.2 (le_of_lt hz.1.1) hz.2 hz.1.2.1 hz.1.2.2⟩
    have bT : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ {p : ℝ × ℝ | p ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ∧ p.1 ≤ X₁},
        ‖iteratedFDeriv ℝ k (↿(profEtaD (profRadAvg U))) z‖ ≤ C := by
      intro k
      obtain ⟨C, hC⟩ := hSbd X₁ (k + 1) (hbdU X₁ (k + 1))
      refine ⟨‖ContinuousLinearMap.apply ℝ ℝ v‖ * C, fun z hz => ?_⟩
      exact (hTbd k z (hO'O hz.1)).trans (mul_le_mul_of_nonneg_left
        (hC z.1 z.2 (le_of_lt hz.1.1) hz.2 hz.1.2.1 hz.1.2.2) (ContinuousLinearMap.opNorm_nonneg _))
    obtain ⟨C1, h1⟩ := iteratedFDeriv_bilinear_bounded_on (ContinuousLinearMap.mul ℝ ℝ) cA (↿U)
      _ _ hO'o hBsub hAs hUO' (bcoef cA hAb) bU m
    obtain ⟨C2, h2⟩ := iteratedFDeriv_bilinear_bounded_on (ContinuousLinearMap.mul ℝ ℝ) cB
      (↿(profRadAvg U)) _ _ hO'o hBsub hBs hSO' (bcoef cB hBb) bS m
    obtain ⟨C3, h3⟩ := iteratedFDeriv_bilinear_bounded_on (ContinuousLinearMap.mul ℝ ℝ) cC
      (↿(profEtaD (profRadAvg U))) _ _ hO'o hBsub hCs hTO' (bcoef cC hCb) bT m
    simp only [ContinuousLinearMap.mul_apply'] at h1 h2 h3
    refine ⟨C1 + C2 + C3, fun X η hX hX1 hη1 hη2 => ?_⟩
    have hzB : ((X, η) : ℝ × ℝ) ∈ {p : ℝ × ℝ | p ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ∧ p.1 ≤ X₁} :=
      ⟨⟨hX, hη1, hη2⟩, hX1⟩
    have hn : Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ∈ nhds ((X, η) : ℝ × ℝ) := hO'o.mem_nhds hzB.1
    have hm : ((m : ℕ) : ℕ∞ω) ≤ ∞ := by exact_mod_cast le_top
    have dA := (hpA.contDiffAt hn).of_le hm
    have dB := (hpB.contDiffAt hn).of_le hm
    have dC := (hpC.contDiffAt hn).of_le hm
    rw [hid]
    have e1 : iteratedFDeriv ℝ m (fun p => (cA p * (↿U) p + cB p * (↿(profRadAvg U)) p) +
        cC p * (↿(profEtaD (profRadAvg U))) p) (X, η) =
        (iteratedFDeriv ℝ m (fun p => cA p * (↿U) p) (X, η) +
          iteratedFDeriv ℝ m (fun p => cB p * (↿(profRadAvg U)) p) (X, η)) +
          iteratedFDeriv ℝ m (fun p => cC p * (↿(profEtaD (profRadAvg U))) p) (X, η) := by
      rw [← iteratedFDeriv_add_apply dA dB]
      exact iteratedFDeriv_add_apply (dA.add dB) dC
    rw [e1]
    have t1 := h1 _ hzB
    have t2 := h2 _ hzB
    have t3 := h3 _ hzB
    have n1 := norm_add_le (iteratedFDeriv ℝ m (fun p => cA p * (↿U) p) (X, η) +
          iteratedFDeriv ℝ m (fun p => cB p * (↿(profRadAvg U)) p) (X, η))
        (iteratedFDeriv ℝ m (fun p => cC p * (↿(profEtaD (profRadAvg U))) p) (X, η))
    have n2 := norm_add_le (iteratedFDeriv ℝ m (fun p => cA p * (↿U) p) (X, η))
        (iteratedFDeriv ℝ m (fun p => cB p * (↿(profRadAvg U)) p) (X, η))
    linarith

theorem bg_order_zero : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ), SimScaleProps h → LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → BgOrderZero h Xb cinf F U :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hS hL
  have hL' := hL
  unfold LeadingProfile at hL'
  obtain ⟨⟨h0, h1, -, -, -, -, -, hXa, hXap1, hp12, hp2m1, hm12, hm2Xv, hXvXc, hXcXb⟩, -, -, -,
    ⟨ε, hε, hFε, hUε, -, hbd⟩, -, -, -, -, -, -⟩ := hL'
  have hh2 : h < 1 / 2 := by linarith
  have hXb : 0 < Xb := by linarith
  have hbdF : ∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿F) (X, η)‖ ≤ C := fun X₁ m =>
    (hbd X₁ m).imp fun C hC X η a b c d => (hC X η a b c d).1
  have hbdU : ∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿U) (X, η)‖ ≤ C := fun X₁ m =>
    (hbd X₁ m).imp fun C hC X η a b c d => (hC X η a b c d).2
  obtain ⟨hSsm, hSbd, -⟩ := profRadAvg_props U ε hε hUε
  have hSbd' : ∀ X₁ : ℝ, ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿(profRadAvg U)) (X, η)‖ ≤ C := fun X₁ m => hSbd X₁ m (hbdU X₁ m)
  obtain ⟨ε', hε', hPsm, hPbd⟩ :=
    leadPi_smooth_bounds h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hL
  have hIci : ∀ e : ℝ, 0 < e → Ici (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi (-e) ×ˢ Ioo (-1) 1 := by
    intro e he z hz
    exact ⟨show -e < z.1 from lt_of_lt_of_le (neg_lt_zero.mpr he) hz.1, hz.2⟩
  obtain ⟨hA1, -, -, -⟩ := bg_field_smooth_div h 0 (profRadAvg U) hS (hSsm.mono (hIci ε hε))
  obtain ⟨-, hB1, -, hdiv⟩ := bg_field_smooth_div h 0 F hS (hFε.mono (hIci ε hε))
  obtain ⟨-, -, hP1, -⟩ := bg_field_smooth_div h 0 (leadPi F) hS (hPsm.mono (hIci ε' hε'))
  have hH := heat_exterior_field h (2 ^ (1 / 2 + h) * cinf) h0 hh2
  have hext := bg_exterior_order_zero h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hS hL
  refine ⟨⟨hA1, hB1, hP1⟩, hdiv, bg_curl_order_zero h ε U hS h0 hh2 hε hUε, hext, ?_,
    leadV_smooth_bounds h ε U h0 hh2 hε hUε hbdU⟩

  intro m
  have h4Xb : 0 < 4 * Xb := by linarith
  obtain ⟨C₁, K₁, hb1⟩ :=
    bg_field_interior_bounds h ε (4 * Xb) 0 (profRadAvg U) hS h0 hh2 hε h4Xb hSsm hSbd' m
  obtain ⟨C₂, K₂, hb2⟩ := bg_field_interior_bounds h ε (4 * Xb) 0 F hS h0 hh2 hε h4Xb hFε hbdF m
  obtain ⟨C₃, K₃, hb3⟩ :=
    bg_field_interior_bounds h ε' (4 * Xb) 0 (leadPi F) hS h0 hh2 hε' h4Xb hPsm hPbd m
  obtain ⟨C₄, K₄, hK₄, hb4⟩ :=
    heat_field_scaled_bounds h (2 ^ (1 / 2 + h) * cinf) (2 * Xb) h0 hh2 (by linarith) hH m
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = max (max K₁ K₂) (max K₃ K₄) := ⟨_, rfl⟩
  obtain ⟨Ct, hCt⟩ : ∃ Ct : ℝ, Ct = |C₁| + |C₂| + |C₃| + |C₄| * (1 + (4 * Xb) ^ (-K₄)) := ⟨_, rfl⟩
  have hK1 : K₁ ≤ K := by rw [hK]; exact (le_max_left K₁ K₂).trans (le_max_left _ _)
  have hK2 : K₂ ≤ K := by rw [hK]; exact (le_max_right K₁ K₂).trans (le_max_left _ _)
  have hK3 : K₃ ≤ K := by rw [hK]; exact (le_max_left K₃ K₄).trans (le_max_right _ _)
  have hK4 : K₄ ≤ K := by rw [hK]; exact (le_max_right K₃ K₄).trans (le_max_right _ _)
  have hpow4 : 0 ≤ (4 * Xb) ^ (-K₄) := Real.rpow_nonneg h4Xb.le _
  have hc4 : 0 ≤ |C₄| * (1 + (4 * Xb) ^ (-K₄)) := mul_nonneg (abs_nonneg _) (by linarith)
  have hCt0 : 0 ≤ Ct := by
    rw [hCt]; linarith [abs_nonneg C₁, abs_nonneg C₂, abs_nonneg C₃]
  refine ⟨Ct, K, ?_⟩
  intro x t ht hq1
  have hτ : 0 < 1 - t := by linarith
  have hq0 : 0 < simScale h (x 2) (1 - t) := (hS.1 (x 2) (1 - t) hτ).1
  have hτq : 1 - t ≤ simScale h (x 2) (1 - t) := (hS.2.1 (x 2) (1 - t) hτ).1
  have hmono : ∀ K' : ℝ, K' ≤ K →
      simScale h (x 2) (1 - t) ^ (-K') ≤ simScale h (x 2) (1 - t) ^ (-K) := fun K' hK' =>
    Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (by linarith)
  have hqK0 : 0 ≤ simScale h (x 2) (1 - t) ^ (-K) := (Real.rpow_pos_of_pos hq0 _).le
  have hgen : ∀ Ci Ki : ℝ, Ki ≤ K → |Ci| ≤ Ct →
      Ci * simScale h (x 2) (1 - t) ^ (-Ki) ≤ Ct * simScale h (x 2) (1 - t) ^ (-K) := by
    intro Ci Ki hKi hCi
    calc Ci * simScale h (x 2) (1 - t) ^ (-Ki)
        ≤ |Ci| * simScale h (x 2) (1 - t) ^ (-Ki) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_pos_of_pos hq0 _).le
      _ ≤ |Ci| * simScale h (x 2) (1 - t) ^ (-K) :=
          mul_le_mul_of_nonneg_left (hmono Ki hKi) (abs_nonneg _)
      _ ≤ Ct * simScale h (x 2) (1 - t) ^ (-K) := mul_le_mul_of_nonneg_right hCi hqK0
  by_cases hr : x 0 ^ 2 + x 1 ^ 2 ≤ 4 * Xb * simScale h (x 2) (1 - t)
  · obtain ⟨a1, -, -⟩ := hb1 x t ht hq1 hr
    obtain ⟨-, a2, -⟩ := hb2 x t ht hq1 hr
    obtain ⟨-, -, a3⟩ := hb3 x t ht hq1 hr
    refine ⟨a1.trans (hgen C₁ K₁ hK1 ?_), a2.trans (hgen C₂ K₂ hK2 ?_),
      a3.trans (hgen C₃ K₃ hK3 ?_)⟩
    · rw [hCt]; linarith [abs_nonneg C₂, abs_nonneg C₃]
    · rw [hCt]; linarith [abs_nonneg C₁, abs_nonneg C₃]
    · rw [hCt]; linarith [abs_nonneg C₁, abs_nonneg C₂]
  · push_neg at hr
    have hXbq : 0 < Xb * simScale h (x 2) (1 - t) := mul_pos hXb hq0
    have hr2 : 2 * Xb * simScale h (x 2) (1 - t) < x 0 ^ 2 + x 1 ^ 2 := by linarith
    have hcont : ContinuousAt (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) (x, t) := by
      have hc1 : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (x 2, 1 - t) :=
        hS.2.2.2.1.continuousOn.continuousAt (prod_mem_nhds Filter.univ_mem (Ioi_mem_nhds hτ))
      have hc2 : ContinuousAt (fun w : ℝ³ × ℝ => ((w.1 2 : ℝ), 1 - w.2)) (x, t) :=
        (by fun_prop : Continuous (fun w : ℝ³ × ℝ => ((w.1 2 : ℝ), 1 - w.2))).continuousAt
      exact ContinuousAt.comp (f := fun w : ℝ³ × ℝ => ((w.1 2 : ℝ), 1 - w.2))
        (g := fun w : ℝ × ℝ => simScale h w.1 w.2) (x := (x, t)) hc1 hc2
    have hcont2 : ContinuousAt (fun w : ℝ³ × ℝ => 2 * Xb * simScale h (w.1 2) (1 - w.2)) (x, t) :=
      continuousAt_const.mul hcont
    have hcont3 : ContinuousAt (fun w : ℝ³ × ℝ => w.1 0 ^ 2 + w.1 1 ^ 2) (x, t) := by fun_prop
    have hev : ∀ᶠ w in nhds (x, t), w.2 < 1 ∧
        2 * Xb * simScale h (w.1 2) (1 - w.2) < w.1 0 ^ 2 + w.1 1 ^ 2 := by
      refine Filter.Eventually.and ?_ ?_
      · exact continuous_snd.continuousAt.eventually_lt continuousAt_const ht
      · exact hcont2.eventually_lt hcont3 hr2
    have eA : (↿(bgAn h 0 (profRadAvg U))) =ᶠ[nhds (x, t)] fun _ => (0 : ℝ³) :=
      hev.mono fun w hw => (hext w.1 w.2 hw.1 hw.2).1
    have eB : (↿(bgBn h 0 F)) =ᶠ[nhds (x, t)] ↿(heatSwirl h (2 ^ (1 / 2 + h) * cinf)) :=
      hev.mono fun w hw => (hext w.1 w.2 hw.1 hw.2).2.1
    have eP : (↿(bgPn h 0 (leadPi F))) =ᶠ[nhds (x, t)] ↿(heatPressure h (2 ^ (1 / 2 + h) * cinf)) :=
      hev.mono fun w hw => (hext w.1 w.2 hw.1 hw.2).2.2
    rw [(eA.iteratedFDeriv ℝ m).eq_of_nhds, (eB.iteratedFDeriv ℝ m).eq_of_nhds,
      (eP.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
    have hτr : 2 * Xb * (1 - t) < x 0 ^ 2 + x 1 ^ 2 := by
      have := mul_le_mul_of_nonneg_left hτq (by linarith : (0:ℝ) ≤ 2 * Xb)
      linarith
    obtain ⟨b4B, b4P⟩ := hb4 x t ht hτr
    have hrpos : 0 < 4 * Xb * simScale h (x 2) (1 - t) := mul_pos h4Xb hq0
    have hrK : (x 0 ^ 2 + x 1 ^ 2) ^ (-K₄) ≤
        (4 * Xb) ^ (-K₄) * simScale h (x 2) (1 - t) ^ (-K₄) := by
      rw [← Real.mul_rpow h4Xb.le hq0.le]
      exact Real.rpow_le_rpow_of_nonpos hrpos hr.le (by linarith)
    have h1q : 1 ≤ simScale h (x 2) (1 - t) ^ (-K₄) :=
      Real.one_le_rpow_of_pos_of_le_one_of_nonpos hq0 hq1 (by linarith)
    have hRnn : 0 ≤ (x 0 ^ 2 + x 1 ^ 2) ^ (-K₄) := Real.rpow_nonneg (by positivity) _
    have hfin : C₄ * (1 + (x 0 ^ 2 + x 1 ^ 2) ^ (-K₄)) ≤ Ct * simScale h (x 2) (1 - t) ^ (-K) := by
      calc C₄ * (1 + (x 0 ^ 2 + x 1 ^ 2) ^ (-K₄))
          ≤ |C₄| * (1 + (x 0 ^ 2 + x 1 ^ 2) ^ (-K₄)) :=
            mul_le_mul_of_nonneg_right (le_abs_self _) (by linarith)
        _ ≤ |C₄| * ((1 + (4 * Xb) ^ (-K₄)) * simScale h (x 2) (1 - t) ^ (-K₄)) := by
            apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
            nlinarith
        _ ≤ |C₄| * ((1 + (4 * Xb) ^ (-K₄)) * simScale h (x 2) (1 - t) ^ (-K)) :=
            mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_left (hmono K₄ hK4) (by linarith)) (abs_nonneg _)
        _ = (|C₄| * (1 + (4 * Xb) ^ (-K₄))) * simScale h (x 2) (1 - t) ^ (-K) := by ring
        _ ≤ Ct * simScale h (x 2) (1 - t) ^ (-K) := by
            apply mul_le_mul_of_nonneg_right _ hqK0
            rw [hCt]; linarith [abs_nonneg C₁, abs_nonneg C₂, abs_nonneg C₃]
    refine ⟨?_, b4B.trans hfin, b4P.trans hfin⟩
    simp only [Pi.zero_apply, norm_zero]
    exact mul_nonneg hCt0 hqK0

theorem bgRes_local : ∀ (h : ℝ) (S G W S' G' W' : ℕ → ℝ → ℝ → ℝ) (n : ℕ) (O : Set (ℝ × ℝ)), IsOpen O → (∀ i : ℕ, i ≤ n → ∀ p ∈ O, S i p.1 p.2 = S' i p.1 p.2 ∧ G i p.1 p.2 = G' i p.1 p.2 ∧ W i p.1 p.2 = W' i p.1 p.2) → ∀ p ∈ O, bgResTh h S G W n p.1 p.2 = bgResTh h S' G' W' n p.1 p.2 ∧ bgResZ h S G W n p.1 p.2 = bgResZ h S' G' W' n p.1 p.2 ∧ bgResRad h S G W n p.1 p.2 = bgResRad h S' G' W' n p.1 p.2 :=
by
  intro h S G W S' G' W' n O hO hEq p0 hp0
  have hX : ∀ f f' : ℝ → ℝ → ℝ, (∀ p ∈ O, f p.1 p.2 = f' p.1 p.2) →
      ∀ p ∈ O, pdX f p.1 p.2 = pdX f' p.1 p.2 := by
    intro f f' hf p hp
    have hs : IsOpen ((fun Y : ℝ => (Y, p.2)) ⁻¹' O) :=
      hO.preimage (continuous_id.prodMk continuous_const)
    have hmem : p.1 ∈ (fun Y : ℝ => (Y, p.2)) ⁻¹' O := by
      show (p.1, p.2) ∈ O
      exact hp
    have hev : (fun Y => f Y p.2) =ᶠ[nhds p.1] (fun Y => f' Y p.2) :=
      Filter.eventuallyEq_of_mem (hs.mem_nhds hmem) (fun Y hY => hf (Y, p.2) hY)
    unfold pdX
    exact hev.deriv_eq
  have hE : ∀ f f' : ℝ → ℝ → ℝ, (∀ p ∈ O, f p.1 p.2 = f' p.1 p.2) →
      ∀ p ∈ O, pdE f p.1 p.2 = pdE f' p.1 p.2 := by
    intro f f' hf p hp
    have hs : IsOpen ((fun e : ℝ => (p.1, e)) ⁻¹' O) :=
      hO.preimage (continuous_const.prodMk continuous_id)
    have hmem : p.2 ∈ (fun e : ℝ => (p.1, e)) ⁻¹' O := by
      show (p.1, p.2) ∈ O
      exact hp
    have hev : (fun e => f p.1 e) =ᶠ[nhds p.2] (fun e => f' p.1 e) :=
      Filter.eventuallyEq_of_mem (hs.mem_nhds hmem) (fun e he => hf (p.1, e) he)
    unfold pdE
    exact hev.deriv_eq
  have hUz : ∀ f f' : ℝ → ℝ → ℝ, (∀ p ∈ O, f p.1 p.2 = f' p.1 p.2) →
      ∀ p ∈ O, bgUz f p.1 p.2 = bgUz f' p.1 p.2 := by
    intro f f' hf p hp
    simp only [bgUz, hf p hp, hX f f' hf p hp]
  have hTop : ∀ (b : ℝ) (f f' : ℝ → ℝ → ℝ), (∀ p ∈ O, f p.1 p.2 = f' p.1 p.2) →
      ∀ p ∈ O, simTop h b f p.1 p.2 = simTop h b f' p.1 p.2 := by
    intro b f f' hf p hp
    simp only [simTop, hf p hp, hX f f' hf p hp, hE f f' hf p hp]
  have hZop : ∀ (b : ℝ) (f f' : ℝ → ℝ → ℝ), (∀ p ∈ O, f p.1 p.2 = f' p.1 p.2) →
      ∀ p ∈ O, simZop h b f p.1 p.2 = simZop h b f' p.1 p.2 := by
    intro b f f' hf p hp
    simp only [simZop, hf p hp, hX f f' hf p hp, hE f f' hf p hp]
  have hVx : ∀ (m : ℕ) (f f' : ℝ → ℝ → ℝ), (∀ p ∈ O, f p.1 p.2 = f' p.1 p.2) →
      ∀ p ∈ O, bgVx h m f p.1 p.2 = bgVx h m f' p.1 p.2 := by
    intro m f f' hf p hp
    simp only [bgVx, hf p hp, hE f f' hf p hp, hUz f f' hf p hp]
  have hS : ∀ i : ℕ, i ≤ n → ∀ p ∈ O, S i p.1 p.2 = S' i p.1 p.2 :=
    fun i hi p hp => (hEq i hi p hp).1
  have hG : ∀ i : ℕ, i ≤ n → ∀ p ∈ O, G i p.1 p.2 = G' i p.1 p.2 :=
    fun i hi p hp => (hEq i hi p hp).2.1
  have hW : ∀ i : ℕ, i ≤ n → ∀ p ∈ O, W i p.1 p.2 = W' i p.1 p.2 :=
    fun i hi p hp => (hEq i hi p hp).2.2
  have hOm : ∀ k : ℕ, k ≤ n → bgOm h S k p0.1 p0.2 = bgOm h S' k p0.1 p0.2 := by
    intro k hk
    unfold bgOm
    congr 1
    · congr 1
      · congr 1
        · exact hTop _ _ _ (hVx k _ _ (hS k hk)) p0 hp0
        · rw [hX _ _ (hX _ _ (hVx k _ _ (hS k hk))) p0 hp0, hX _ _ (hVx k _ _ (hS k hk)) p0 hp0]
      · refine Finset.sum_congr rfl (fun i hi => ?_)
        have hi' : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        have h1 := hS i (by omega)
        have h2 := hS (k - i) (by omega)
        rw [hVx i _ _ h1 p0 hp0, hVx (k - i) _ _ h2 p0 hp0, hX _ _ (hVx (k - i) _ _ h2) p0 hp0,
          hUz _ _ h1 p0 hp0, hZop _ _ _ (hVx (k - i) _ _ h2) p0 hp0]
    · split_ifs with hk1
      · exact hZop _ _ _ (hZop _ _ _ (hVx (k - 1) _ _ (hS (k - 1) (by omega)))) p0 hp0
      · rfl
  refine ⟨?_, ?_, ?_⟩
  · unfold bgResTh
    congr 1
    · congr 1
      · congr 1
        · exact hTop _ _ _ (hG n le_rfl) p0 hp0
        · rw [hX _ _ (hX _ _ (hG n le_rfl)) p0 hp0, hX _ _ (hG n le_rfl) p0 hp0]
      · refine Finset.sum_congr rfl (fun i hi => ?_)
        have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        have h1 := hS i hi'
        have h2 := hG (n - i) (by omega)
        rw [hVx i _ _ h1 p0 hp0, h2 p0 hp0, hX _ _ h2 p0 hp0,
          hUz _ _ h1 p0 hp0, hZop _ _ _ h2 p0 hp0]
    · split_ifs with hn1
      · exact hZop _ _ _ (hZop _ _ _ (hG (n - 1) (by omega))) p0 hp0
      · rfl
  · unfold bgResZ
    congr 1
    · congr 1
      · congr 1
        · congr 1
          · exact hTop _ _ _ (hUz _ _ (hS n le_rfl)) p0 hp0
          · exact hZop _ _ _ (hW n le_rfl) p0 hp0
        · rw [hX _ _ (hX _ _ (hUz _ _ (hS n le_rfl))) p0 hp0,
            hX _ _ (hUz _ _ (hS n le_rfl)) p0 hp0]
      · refine Finset.sum_congr rfl (fun i hi => ?_)
        have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        have h1 := hS i hi'
        have h2 := hUz _ _ (hS (n - i) (by omega))
        rw [hVx i _ _ h1 p0 hp0, hX _ _ h2 p0 hp0,
          hUz _ _ h1 p0 hp0, hZop _ _ _ h2 p0 hp0]
    · split_ifs with hn1
      · exact hZop _ _ _ (hZop _ _ _ (hUz _ _ (hS (n - 1) (by omega)))) p0 hp0
      · rfl
  · unfold bgResRad
    congr 1
    · congr 1
      · exact hX _ _ (hW n le_rfl) p0 hp0
      · refine Finset.sum_congr rfl (fun i hi => ?_)
        have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [hG i hi' p0 hp0, hG (n - i) (by omega) p0 hp0]
    · split_ifs with hn1
      · rw [hOm (n - 1) (by omega)]
      · rfl

theorem bg_res_linear_split : ∀ (h : ℝ) (S G W : ℕ → ℝ → ℝ → ℝ) (n : ℕ) (Sn Gn Wn : ℝ → ℝ → ℝ) (X η : ℝ), 1 ≤ n → bgResTh h (Function.update S n Sn) (Function.update G n Gn) (Function.update W n Wn) n X η = -2 * (X * pdX (pdX Gn) X η + 2 * pdX Gn X η) + bgCoefA h n (G 0) (S 0) 0 X η * Gn X η + bgCoefA h n (G 0) (S 0) 1 X η * (X * pdX Gn X η) + bgCoefA h n (G 0) (S 0) 2 X η * pdE Gn X η + bgCoefA h n (G 0) (S 0) 3 X η * bgUz Sn X η + bgCoefA h n (G 0) (S 0) 4 X η * Sn X η + bgCoefA h n (G 0) (S 0) 5 X η * pdE Sn X η + bgKTh h S G n X η ∧ bgResZ h (Function.update S n Sn) (Function.update G n Gn) (Function.update W n Wn) n X η = -2 * (X * pdX (pdX (bgUz Sn)) X η + pdX (bgUz Sn) X η) + bgCoefB h n (S 0) 0 X η * bgUz Sn X η + bgCoefB h n (S 0) 1 X η * (X * pdX (bgUz Sn) X η) + bgCoefB h n (S 0) 2 X η * pdE (bgUz Sn) X η + bgCoefB h n (S 0) 3 X η * Sn X η + bgCoefB h n (S 0) 4 X η * pdE Sn X η + bgCoefB h n (S 0) 5 X η * Wn X η + bgCoefB h n (S 0) 6 X η * pdE Wn X η + bgCoefB h n (S 0) 7 X η * (X * pdX Wn X η) + bgKZ h S n X η ∧ bgResRad h (Function.update S n Sn) (Function.update G n Gn) (Function.update W n Wn) n X η = pdX Wn X η - 2 * (G 0 X η * Gn X η) - bgKRad h S G n X η :=
by
  intro h S G W n Sn Gn Wn X η hn
  have hsplit : ∀ f : ℕ → ℝ, ∑ i ∈ Finset.range (n + 1), f i =
      f 0 + ∑ i ∈ Finset.Ioo 0 n, f i + f n := by
    intro f
    rw [Finset.sum_range_succ, Finset.range_eq_Ico,
      Finset.sum_eq_sum_Ico_succ_bot (by omega : 0 < n), Finset.Ico_add_one_left_eq_Ioo]
  have hSlt : ∀ i, i < n → Function.update S n Sn i = S i :=
    fun i hi => Function.update_of_ne (by omega) _ _
  have hGlt : ∀ i, i < n → Function.update G n Gn i = G i :=
    fun i hi => Function.update_of_ne (by omega) _ _
  have hS0 : Function.update S n Sn 0 = S 0 := hSlt 0 (by omega)
  have hG0 : Function.update G n Gn 0 = G 0 := hGlt 0 (by omega)
  have hSn : Function.update S n Sn n = Sn := Function.update_self _ _ _
  have hGn : Function.update G n Gn n = Gn := Function.update_self _ _ _
  have hWn : Function.update W n Wn n = Wn := Function.update_self _ _ _
  have hGm : Function.update G n Gn (n - 1) = G (n - 1) := hGlt _ (by omega)
  have hSm : Function.update S n Sn (n - 1) = S (n - 1) := hSlt _ (by omega)
  have hOm : bgOm h (Function.update S n Sn) (n - 1) X η = bgOm h S (n - 1) X η := by
    have hle : ∀ i, i ≤ n - 1 → Function.update S n Sn i = S i := fun i hi => hSlt i (by omega)
    unfold bgOm
    rw [hle (n - 1) le_rfl, hle (n - 1 - 1) (by omega)]
    congr 2
    apply Finset.sum_congr rfl
    intro i hi
    have hi' := Finset.mem_range.mp hi
    rw [hle i (by omega), hle (n - 1 - i) (by omega)]
  have hmidTh : ∑ i ∈ Finset.Ioo 0 n, (bgVx h i (Function.update S n Sn i) X η *
        (Function.update G n Gn (n - i) X η + X * pdX (Function.update G n Gn (n - i)) X η)
        + bgUz (Function.update S n Sn i) X η *
          simZop h (-(1 + h) + 2 * ((n - i : ℕ) : ℝ) * h) (Function.update G n Gn (n - i)) X η) =
      ∑ i ∈ Finset.Ioo 0 n, (bgVx h i (S i) X η * (G (n - i) X η + X * pdX (G (n - i)) X η)
        + bgUz (S i) X η * simZop h (-(1 + h) + 2 * ((n - i : ℕ) : ℝ) * h) (G (n - i)) X η) := by
    apply Finset.sum_congr rfl
    intro i hi
    obtain ⟨h1, h2⟩ := Finset.mem_Ioo.mp hi
    rw [hSlt i h2, hGlt (n - i) (by omega)]
  have hmidZ : ∑ i ∈ Finset.Ioo 0 n, (X * bgVx h i (Function.update S n Sn i) X η *
        pdX (bgUz (Function.update S n Sn (n - i))) X η
        + bgUz (Function.update S n Sn i) X η * simZop h (-(1 / 2 + h) + 2 * ((n - i : ℕ) : ℝ) * h)
          (bgUz (Function.update S n Sn (n - i))) X η) =
      ∑ i ∈ Finset.Ioo 0 n, (X * bgVx h i (S i) X η * pdX (bgUz (S (n - i))) X η
        + bgUz (S i) X η * simZop h (-(1 / 2 + h) + 2 * ((n - i : ℕ) : ℝ) * h)
          (bgUz (S (n - i))) X η) := by
    apply Finset.sum_congr rfl
    intro i hi
    obtain ⟨h1, h2⟩ := Finset.mem_Ioo.mp hi
    rw [hSlt i h2, hSlt (n - i) (by omega)]
  have hmidR : ∑ i ∈ Finset.Ioo 0 n, Function.update G n Gn i X η * Function.update G n Gn (n - i) X η =
      ∑ i ∈ Finset.Ioo 0 n, G i X η * G (n - i) X η := by
    apply Finset.sum_congr rfl
    intro i hi
    obtain ⟨h1, h2⟩ := Finset.mem_Ioo.mp hi
    rw [hGlt i h2, hGlt (n - i) (by omega)]
  refine ⟨?_, ?_, ?_⟩
  · unfold bgResTh
    rw [if_pos hn, hsplit, hmidTh]
    simp only [Nat.sub_zero, Nat.sub_self, hS0, hG0, hSn, hGn, hGm]
    simp only [bgKTh, bgCoefA, Matrix.cons_val, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons]
    simp only [simTop, simZop, bgVx, Nat.cast_zero]
    ring
  · unfold bgResZ
    rw [if_pos hn, hsplit, hmidZ]
    simp only [Nat.sub_zero, Nat.sub_self, hS0, hSn, hWn, hSm]
    simp only [bgKZ, bgCoefB, Matrix.cons_val, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons]
    simp only [simTop, simZop, bgVx, Nat.cast_zero]
    ring
  · unfold bgResRad
    rw [if_pos hn, hsplit, hmidR, hOm]
    simp only [Nat.sub_zero, Nat.sub_self, hG0, hGn, hWn]
    unfold bgKRad
    ring

theorem bgHolo_of_analytic : ∀ (Xi : ℝ) (f : ℝ → ℝ → ℝ), 0 < Xi → BgAnalytic Xi f → ContDiffOn ℝ ∞ (↿f) (Ioo 0 Xi ×ˢ Ioo (-1) 1) → BgHolo Xi f :=
by
  intro Xi f _ hA hf

  have csOpen : ∀ r : ℝ, IsOpen (cStrip r) := by
    intro r
    have h1 : IsOpen {w : ℂ | |w.im| < r} :=
      isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have h2 : IsOpen {w : ℂ | -1 - r < w.re} := isOpen_lt continuous_const Complex.continuous_re
    have h3 : IsOpen {w : ℂ | w.re < 1 + r} := isOpen_lt Complex.continuous_re continuous_const
    exact h1.inter (h2.inter h3)
  have csConv : ∀ r : ℝ, Convex ℝ (cStrip r) := by
    intro r
    rw [convex_iff_forall_pos]
    intro w hw z hz a b ha hb hab
    obtain ⟨hw1, hw2, hw3⟩ := hw
    obtain ⟨hz1, hz2, hz3⟩ := hz
    have hre : (a • w + b • z).re = a * w.re + b * z.re := by simp
    have him : (a • w + b • z).im = a * w.im + b * z.im := by simp
    rw [abs_lt] at hw1 hz1
    have hr : a * r + b * r = r := by rw [← add_mul, hab, one_mul]
    have e1 := mul_lt_mul_of_pos_left hw1.2 ha
    have e2 := mul_lt_mul_of_pos_left hz1.2 hb
    have e3 := mul_lt_mul_of_pos_left hw1.1 ha
    have e4 := mul_lt_mul_of_pos_left hz1.1 hb
    have e5 := mul_lt_mul_of_pos_left hw2 ha
    have e6 := mul_lt_mul_of_pos_left hz2 hb
    have e7 := mul_lt_mul_of_pos_left hw3 ha
    have e8 := mul_lt_mul_of_pos_left hz3 hb
    refine ⟨?_, ?_, ?_⟩
    · rw [him, abs_lt]
      constructor <;> nlinarith
    · rw [hre]; nlinarith
    · rw [hre]; nlinarith
  have csReal : ∀ r : ℝ, 0 < r → ∀ η : ℝ, -1 < η → η < 1 → ((η : ℝ) : ℂ) ∈ cStrip r := by
    intro r hr η e1 e2
    refine ⟨?_, ?_, ?_⟩
    · simpa using hr
    · simp only [Complex.ofReal_re]; linarith
    · simp only [Complex.ofReal_re]; linarith
  have csMono : ∀ r r' : ℝ, r ≤ r' → cStrip r ⊆ cStrip r' := by
    intro r r' hrr w hw
    obtain ⟨a, b, c⟩ := hw
    exact ⟨by linarith, by linarith, by linarith⟩

  have holoParam : ∀ (g : ℝ → ℂ → ℂ) (a b C : ℝ) (U : Set ℂ), IsOpen U →
      ContinuousOn (fun p : ℝ × ℂ => g p.1 p.2) (Set.uIcc a b ×ˢ U) →
      (∀ x ∈ Set.uIcc a b, DifferentiableOn ℂ (g x) U) →
      (∀ x ∈ Set.uIcc a b, ∀ w ∈ U, ‖g x w‖ ≤ C) →
      DifferentiableOn ℂ (fun w => ∫ x in a..b, g x w) U := by
    intro g a b C U hU hc hd hb w₀ hw₀
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU w₀ hw₀
    have hslice : ∀ w ∈ U, ContinuousOn (fun x => g x w) (Set.uIcc a b) := by
      intro w hw
      exact hc.comp (Continuous.prodMk continuous_id continuous_const).continuousOn
        (fun x hx => ⟨hx, hw⟩)
    have hderiv_bd : ∀ x ∈ Set.uIcc a b, ∀ w ∈ Metric.ball w₀ (ε / 2),
        ‖deriv (g x) w‖ ≤ C / (ε / 4) := by
      intro x hx w hw
      have hsub : Metric.closedBall w (ε / 4) ⊆ U := by
        intro z hz
        apply hball
        rw [Metric.mem_ball] at hw ⊢
        rw [Metric.mem_closedBall] at hz
        calc dist z w₀ ≤ dist z w + dist w w₀ := dist_triangle _ _ _
          _ < ε := by linarith
      apply Complex.norm_deriv_le_of_forall_mem_sphere_norm_le (by linarith)
      · apply DifferentiableOn.diffContOnCl
        rw [closure_ball w (by positivity)]
        exact (hd x hx).mono hsub
      · intro z hz
        exact hb x hx z (hsub (Metric.sphere_subset_closedBall hz))
    have hmeas_deriv : AEStronglyMeasurable (fun x => deriv (g x) w₀)
        (volume.restrict (Set.uIoc a b)) := by
      obtain ⟨t, ht⟩ : ∃ t : ℕ → ℂ, t = fun n : ℕ => (((ε / 2) * (1 / ((n : ℝ) + 1)) : ℝ) : ℂ) :=
        ⟨_, rfl⟩
      have hpos : ∀ n : ℕ, 0 < (ε / 2) * (1 / ((n : ℝ) + 1)) := fun n => by positivity
      have hle : ∀ n : ℕ, (ε / 2) * (1 / ((n : ℝ) + 1)) ≤ ε / 2 := by
        intro n
        have : 1 / ((n : ℝ) + 1) ≤ 1 := by
          rw [div_le_one (by positivity)]
          linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
        nlinarith
      have ht_ne : ∀ n, t n ≠ 0 := by
        intro n
        rw [ht]
        dsimp only
        exact_mod_cast (hpos n).ne'
      have ht_mem : ∀ n, w₀ + t n ∈ U := by
        intro n
        apply hball
        rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, ht]
        simp only [Complex.norm_real, Real.norm_eq_abs]
        rw [abs_of_pos (hpos n)]
        linarith [hle n]
      have ht_tend : Filter.Tendsto t Filter.atTop (nhdsWithin 0 {0}ᶜ) := by
        apply tendsto_nhdsWithin_iff.2
        refine ⟨?_, Filter.Eventually.of_forall (fun n => ht_ne n)⟩
        have h1 := (tendsto_one_div_add_atTop_nhds_zero_nat).const_mul (ε / 2)
        rw [mul_zero] at h1
        have h2 := (Complex.continuous_ofReal.tendsto 0).comp h1
        rw [Complex.ofReal_zero] at h2
        rw [ht]
        exact h2
      apply aestronglyMeasurable_of_tendsto_ae Filter.atTop
        (f := fun n x => (t n)⁻¹ • (g x (w₀ + t n) - g x w₀))
      · intro n
        have hcn : ContinuousOn (fun x => (t n)⁻¹ • (g x (w₀ + t n) - g x w₀)) (Set.uIcc a b) := by
          have h1 := (hslice _ (ht_mem n)).sub (hslice _ hw₀)
          have h2 := h1.const_smul (t n)⁻¹
          exact h2
        exact (hcn.mono Set.uIoc_subset_uIcc).aestronglyMeasurable measurableSet_uIoc
      · rw [ae_restrict_iff' measurableSet_uIoc]
        refine Filter.Eventually.of_forall (fun x hx => ?_)
        have hx' := Set.uIoc_subset_uIcc hx
        have hda : HasDerivAt (g x) (deriv (g x) w₀) w₀ :=
          ((hd x hx').differentiableAt (hU.mem_nhds hw₀)).hasDerivAt
        exact hda.tendsto_slope_zero.comp ht_tend
    have hF_meas : ∀ᶠ w in nhds w₀, AEStronglyMeasurable (fun x => g x w)
        (volume.restrict (Set.uIoc a b)) := by
      filter_upwards [hU.mem_nhds hw₀] with w hw
      exact ((hslice w hw).mono Set.uIoc_subset_uIcc).aestronglyMeasurable measurableSet_uIoc
    have hF_int : IntervalIntegrable (fun x => g x w₀) volume a b :=
      (hslice w₀ hw₀).intervalIntegrable
    obtain ⟨-, hD⟩ := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (F := fun w x => g x w) (F' := fun w x => deriv (g x) w) (bound := fun _ => C / (ε / 4))
      (Metric.ball_mem_nhds w₀ (by linarith : (0 : ℝ) < ε / 2)) hF_meas hF_int hmeas_deriv
      (Filter.Eventually.of_forall
        (fun x hx w hw => hderiv_bd x (Set.uIoc_subset_uIcc hx) w hw))
      intervalIntegrable_const
      (Filter.Eventually.of_forall (fun x hx w hw =>
        ((hd x (Set.uIoc_subset_uIcc hx)).differentiableAt
          (hU.mem_nhds (hball (Metric.ball_subset_ball (by linarith) hw)))).hasDerivAt))
    exact hD.differentiableAt.differentiableWithinAt

  have holoId : ∀ (U : Set ℂ) (φ : ℂ → ℂ), IsOpen U → Convex ℝ U →
      (∀ η : ℝ, -1 < η → η < 1 → ((η : ℝ) : ℂ) ∈ U) → DifferentiableOn ℂ φ U →
      (∀ η : ℝ, -1 < η → η < 1 → φ (η : ℂ) = 0) → ∀ w ∈ U, φ w = 0 := by
    intro U φ hU hc hR hd hz w hw
    have h0 : (0 : ℂ) ∈ U := by simpa using hR 0 (by norm_num) (by norm_num)
    obtain ⟨u, hu⟩ : ∃ u : ℕ → ℂ, u = fun n : ℕ => (((1 : ℝ) / 2 * (1 / ((n : ℝ) + 1)) : ℝ) : ℂ) :=
      ⟨_, rfl⟩
    have hpos : ∀ n : ℕ, 0 < (1 : ℝ) / 2 * (1 / ((n : ℝ) + 1)) := fun n => by positivity
    have hle : ∀ n : ℕ, (1 : ℝ) / 2 * (1 / ((n : ℝ) + 1)) ≤ 1 / 2 := by
      intro n
      have : 1 / ((n : ℝ) + 1) ≤ 1 := by
        rw [div_le_one (by positivity)]
        linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
      nlinarith
    have hu_tend : Filter.Tendsto u Filter.atTop (nhdsWithin 0 {0}ᶜ) := by
      apply tendsto_nhdsWithin_iff.2
      refine ⟨?_, Filter.Eventually.of_forall (fun n => ?_)⟩
      · have h1 := (tendsto_one_div_add_atTop_nhds_zero_nat).const_mul ((1 : ℝ) / 2)
        rw [mul_zero] at h1
        have h2 := (Complex.continuous_ofReal.tendsto 0).comp h1
        rw [Complex.ofReal_zero] at h2
        rw [hu]
        exact h2
      · rw [hu]
        simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
        exact_mod_cast (hpos n).ne'
    have hfreq : ∃ᶠ z in nhdsWithin (0 : ℂ) {0}ᶜ, φ z = 0 := by
      apply hu_tend.frequently
      refine (Filter.Eventually.of_forall (fun n => ?_)).frequently
      rw [hu]
      exact hz _ (by linarith [hpos n]) (by linarith [hle n])
    exact (hd.analyticOnNhd hU).eqOn_zero_of_preconnected_of_frequently_eq_zero
      hc.isPreconnected h0 hfreq hw

  have slice : ∀ η : ℝ, -1 < η → η < 1 →
      (∀ k : ℕ, ∀ X : ℝ, 0 < X → X < Xi →
        HasDerivAt (iteratedDeriv k (fun Y => f Y η)) (iteratedDeriv (k + 1) (fun Y => f Y η) X) X) ∧
      (∀ k : ℕ, ContinuousOn (iteratedDeriv k (fun Y => f Y η)) (Ioo 0 Xi)) := by
    intro η e1 e2
    have hgs : ContDiffOn ℝ ∞ (fun Y => f Y η) (Ioo 0 Xi) :=
      hf.comp ((contDiff_id.prodMk contDiff_const).contDiffOn) (fun Y hY => ⟨hY, e1, e2⟩)
    have hEq : ∀ m : ℕ, EqOn (iteratedDerivWithin m (fun Y => f Y η) (Ioo 0 Xi))
        (iteratedDeriv m (fun Y => f Y η)) (Ioo 0 Xi) :=
      fun m => iteratedDerivWithin_of_isOpen isOpen_Ioo
    have hU : UniqueDiffOn ℝ (Ioo (0 : ℝ) Xi) := isOpen_Ioo.uniqueDiffOn
    refine ⟨fun k X hX0 hX1 => ?_, fun k => ?_⟩
    · have hdo := hgs.differentiableOn_iteratedDerivWithin (m := k)
        (by exact_mod_cast ENat.natCast_lt_top k) hU
      have hda : DifferentiableAt ℝ (iteratedDerivWithin k (fun Y => f Y η) (Ioo 0 Xi)) X :=
        (hdo X ⟨hX0, hX1⟩).differentiableAt (Ioo_mem_nhds hX0 hX1)
      have hev : iteratedDerivWithin k (fun Y => f Y η) (Ioo 0 Xi) =ᶠ[nhds X]
          iteratedDeriv k (fun Y => f Y η) :=
        Filter.eventuallyEq_of_mem (Ioo_mem_nhds hX0 hX1) (hEq k)
      have hda' : DifferentiableAt ℝ (iteratedDeriv k (fun Y => f Y η)) X :=
        hev.differentiableAt_iff.1 hda
      rw [iteratedDeriv_succ]
      exact hda'.hasDerivAt
    · exact (hgs.continuousOn_iteratedDerivWithin (m := k) (by exact_mod_cast le_top) hU).congr
        (fun x hx => (hEq k hx).symm)

  unfold BgAnalytic at hA
  choose ρ₀ C fc hρ₀ hcont hX using hA

  obtain ⟨ρ, hρ0, hρs⟩ : ∃ ρ : ℕ → ℝ, ρ 0 = ρ₀ 0 ∧ ∀ k, ρ (k + 1) = min (ρ k) (ρ₀ (k + 1)) :=
    ⟨fun n => Nat.rec (motive := fun _ => ℝ) (ρ₀ 0) (fun j r => min r (ρ₀ (j + 1))) n, rfl,
      fun _ => rfl⟩
  have hρpos : ∀ k, 0 < ρ k := by
    intro k
    induction k with
    | zero => rw [hρ0]; exact hρ₀ 0
    | succ j ih => rw [hρs]; exact lt_min ih (hρ₀ _)
  have hρle : ∀ k, ρ k ≤ ρ₀ k := by
    intro k
    cases k with
    | zero => rw [hρ0]
    | succ j => rw [hρs]; exact min_le_right _ _
  have hρmono : ∀ k, ρ (k + 1) ≤ ρ k := fun k => by rw [hρs]; exact min_le_left _ _

  refine ⟨fc, ρ, C, fun k => ⟨hρpos k, hρmono k⟩,
    fun k => (hcont k).mono (Set.prod_mono subset_rfl (csMono _ _ (hρle k))),
    fun k X h0 h1 => ⟨(hX k X h0 h1).1.mono (csMono _ _ (hρle k)),
      fun w hw => (hX k X h0 h1).2.1 w (csMono _ _ (hρle k) hw)⟩, ?_, ?_⟩
  ·
    intro k X w h0 h1 hw
    have hUk : cStrip (ρ (k + 1)) ⊆ cStrip (ρ₀ k) := csMono _ _ ((hρmono k).trans (hρle k))
    have hUk1 : cStrip (ρ (k + 1)) ⊆ cStrip (ρ₀ (k + 1)) := csMono _ _ (hρle (k + 1))
    have hI : ∀ Y : ℝ, 0 < Y → Y < Xi → uIcc X Y ⊆ Ioo 0 Xi :=
      fun Y a b => Set.ordConnected_Ioo.uIcc_subset ⟨h0, h1⟩ ⟨a, b⟩
    have key : ∀ Y : ℝ, 0 < Y → Y < Xi → fc k Y w = fc k X w + ∫ x in X..Y, fc (k + 1) x w := by
      intro Y hY0 hY1
      have hdiff : DifferentiableOn ℂ
          (fun z => fc k Y z - fc k X z - ∫ x in X..Y, fc (k + 1) x z) (cStrip (ρ (k + 1))) := by
        refine (((hX k Y hY0 hY1).1.mono hUk).sub ((hX k X h0 h1).1.mono hUk)).sub ?_
        apply holoParam (fc (k + 1)) X Y (C (k + 1)) _ (csOpen _)
        · exact (hcont (k + 1)).mono (Set.prod_mono (hI Y hY0 hY1) hUk1)
        · intro x hx
          obtain ⟨a, b⟩ := hI Y hY0 hY1 hx
          exact (hX (k + 1) x a b).1.mono hUk1
        · intro x hx z hz
          obtain ⟨a, b⟩ := hI Y hY0 hY1 hx
          exact (hX (k + 1) x a b).2.1 z (hUk1 hz)
      have hreal : ∀ η : ℝ, -1 < η → η < 1 →
          fc k Y (η : ℂ) - fc k X (η : ℂ) - ∫ x in X..Y, fc (k + 1) x (η : ℂ) = 0 := by
        intro η e1 e2
        obtain ⟨hd, hcon⟩ := slice η e1 e2
        have hint : ∫ x in X..Y, fc (k + 1) x (η : ℂ) =
            ((iteratedDeriv k (fun Y => f Y η) Y - iteratedDeriv k (fun Y => f Y η) X : ℝ) : ℂ) := by
          rw [intervalIntegral.integral_congr
            (g := fun x => ((iteratedDeriv (k + 1) (fun Y => f Y η) x : ℝ) : ℂ))]
          · rw [intervalIntegral.integral_ofReal]
            congr 1
            apply intervalIntegral.integral_eq_sub_of_hasDerivAt
            · intro x hx
              obtain ⟨a, b⟩ := hI Y hY0 hY1 hx
              exact hd k x a b
            · exact ((hcon (k + 1)).mono (hI Y hY0 hY1)).intervalIntegrable
          · intro x hx
            obtain ⟨a, b⟩ := hI Y hY0 hY1 hx
            exact (hX (k + 1) x a b).2.2 η e1 e2
        rw [hint, (hX k Y hY0 hY1).2.2 η e1 e2, (hX k X h0 h1).2.2 η e1 e2]
        push_cast
        ring
      have hΦ := holoId (cStrip (ρ (k + 1)))
        (fun z => fc k Y z - fc k X z - ∫ x in X..Y, fc (k + 1) x z) (csOpen _) (csConv _)
        (csReal _ (hρpos _)) hdiff hreal w hw
      linear_combination hΦ
    have hq : ContinuousOn (fun x => fc (k + 1) x w) (Ioo 0 Xi) :=
      (hcont (k + 1)).comp (Continuous.prodMk continuous_id continuous_const).continuousOn
        (fun x hx => ⟨hx, hUk1 hw⟩)
    have hderiv : HasDerivAt (fun Y => ∫ x in X..Y, fc (k + 1) x w) (fc (k + 1) X w) X :=
      intervalIntegral.integral_hasDerivAt_right IntervalIntegrable.refl
        (hq.stronglyMeasurableAtFilter isOpen_Ioo X ⟨h0, h1⟩)
        (hq.continuousAt (Ioo_mem_nhds h0 h1))
    have hev : (fun Y => fc k Y w) =ᶠ[nhds X] (fun Y => fc k X w + ∫ x in X..Y, fc (k + 1) x w) :=
      Filter.eventuallyEq_of_mem (Ioo_mem_nhds h0 h1) (fun Y hY => key Y hY.1 hY.2)
    exact (hderiv.const_add (fc k X w)).congr_of_eventuallyEq hev
  · intro X η h0 h1 e1 e2
    rw [(hX 0 X h0 h1).2.2 η e1 e2, iteratedDeriv_zero]

theorem bgHolo_add_mul : ∀ (Xi : ℝ) (f g : ℝ → ℝ → ℝ), BgHolo Xi f → BgHolo Xi g → BgHolo Xi (fun X η => f X η + g X η) ∧ BgHolo Xi (fun X η => f X η * g X η) :=
by
  intro Xi f g hf hg
  obtain ⟨ff, ρf, Cf, hAf, hBf, hCf, hDf, hEf⟩ := hf
  obtain ⟨fg, ρg, Cg, hAg, hBg, hCg, hDg, hEg⟩ := hg
  have hmono : ∀ r r' : ℝ, r ≤ r' → cStrip r ⊆ cStrip r' := by
    intro r r' hr w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
  have hantf : Antitone ρf := antitone_nat_of_succ_le (fun n => (hAf n).2)
  have hantg : Antitone ρg := antitone_nat_of_succ_le (fun n => (hAg n).2)
  have I1 : ∀ j k : ℕ, j ≤ k → cStrip (min (ρf k) (ρg k)) ⊆ cStrip (ρf j) :=
    fun j k hjk => hmono _ _ ((min_le_left _ _).trans (hantf hjk))
  have I2 : ∀ j k : ℕ, j ≤ k → cStrip (min (ρf k) (ρg k)) ⊆ cStrip (ρg j) :=
    fun j k hjk => hmono _ _ ((min_le_right _ _).trans (hantg hjk))
  have hA : ∀ k, 0 < min (ρf k) (ρg k) ∧ min (ρf (k + 1)) (ρg (k + 1)) ≤ min (ρf k) (ρg k) :=
    fun k => ⟨lt_min (hAf k).1 (hAg k).1, min_le_min (hAf k).2 (hAg k).2⟩
  constructor
  · refine ⟨fun k X w => ff k X w + fg k X w, fun k => min (ρf k) (ρg k), fun k => Cf k + Cg k,
      hA, ?_, ?_, ?_, ?_⟩
    · intro k
      exact ((hBf k).mono (Set.prod_mono subset_rfl (I1 k k le_rfl))).add
        ((hBg k).mono (Set.prod_mono subset_rfl (I2 k k le_rfl)))
    · intro k X h0 h1
      refine ⟨((hCf k X h0 h1).1.mono (I1 k k le_rfl)).add
        ((hCg k X h0 h1).1.mono (I2 k k le_rfl)), ?_⟩
      intro w hw
      exact (norm_add_le _ _).trans (add_le_add ((hCf k X h0 h1).2 w (I1 k k le_rfl hw))
        ((hCg k X h0 h1).2 w (I2 k k le_rfl hw)))
    · intro k X w h0 h1 hw
      exact (hDf k X w h0 h1 (I1 (k + 1) (k + 1) le_rfl hw)).add
        (hDg k X w h0 h1 (I2 (k + 1) (k + 1) le_rfl hw))
    · intro X η h0 h1 e1 e2
      simp only [hEf X η h0 h1 e1 e2, hEg X η h0 h1 e1 e2, Complex.ofReal_add]
  · refine ⟨fun k X w => ∑ j ∈ Finset.range (k + 1), ((k.choose j : ℕ) : ℂ) * ff j X w * fg (k - j) X w,
      fun k => min (ρf k) (ρg k),
      fun k => ∑ j ∈ Finset.range (k + 1), ((k.choose j : ℕ) : ℝ) * Cf j * Cg (k - j),
      hA, ?_, ?_, ?_, ?_⟩
    · intro k
      apply continuousOn_finsetSum
      intro j hj
      have hjk : j ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
      exact (continuousOn_const.mul ((hBf j).mono (Set.prod_mono subset_rfl (I1 j k hjk)))).mul
        ((hBg (k - j)).mono (Set.prod_mono subset_rfl (I2 (k - j) k (Nat.sub_le _ _))))
    · intro k X h0 h1
      refine ⟨?_, ?_⟩
      · apply DifferentiableOn.fun_sum
        intro j hj
        have hjk : j ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
        exact (((hCf j X h0 h1).1.mono (I1 j k hjk)).const_mul _).mul
          ((hCg (k - j) X h0 h1).1.mono (I2 (k - j) k (Nat.sub_le _ _)))
      · intro w hw
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum ?_)
        intro j hj
        have hjk : j ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
        have ha := (hCf j X h0 h1).2 w (I1 j k hjk hw)
        have hb := (hCg (k - j) X h0 h1).2 w (I2 (k - j) k (Nat.sub_le _ _) hw)
        rw [norm_mul, norm_mul, Complex.norm_natCast, mul_assoc, mul_assoc]
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul ha hb (norm_nonneg _) ((norm_nonneg _).trans ha)) (Nat.cast_nonneg _)
    · intro k X w h0 h1 hw
      have hder : ∀ j ∈ Finset.range (k + 1),
          HasDerivAt (fun Y => ((k.choose j : ℕ) : ℂ) * ff j Y w * fg (k - j) Y w)
            (((k.choose j : ℕ) : ℂ) * ff (j + 1) X w * fg (k - j) X w +
              ((k.choose j : ℕ) : ℂ) * ff j X w * fg (k - j + 1) X w) X := by
        intro j hj
        have hjk : j ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
        have da := hDf j X w h0 h1 (I1 (j + 1) (k + 1) (by omega) hw)
        have db := hDg (k - j) X w h0 h1 (I2 (k - j + 1) (k + 1) (by omega) hw)
        exact (da.const_mul _).fun_mul db
      have hsum := HasDerivAt.fun_sum hder
      refine hsum.congr_deriv ?_
      beta_reduce
      have key := Finset.sum_choose_succ_mul (fun i l => ff i X w * fg l X w) k
      have e1 : ∑ j ∈ Finset.range (k + 1 + 1),
            (((k + 1).choose j : ℕ) : ℂ) * ff j X w * fg (k + 1 - j) X w
          = ∑ i ∈ Finset.range (k + 2),
            (((k + 1).choose i : ℕ) : ℂ) * (ff i X w * fg (k + 1 - i) X w) :=
        Finset.sum_congr (by rfl) (fun i _ => mul_assoc _ _ _)
      rw [e1, key, Finset.sum_add_distrib]
      refine (add_comm _ _).trans ?_
      congr 1
      · apply Finset.sum_congr rfl
        intro i hi
        have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        have e : k + 1 - i = k - i + 1 := by omega
        rw [e]
        ring
      · apply Finset.sum_congr rfl
        intro i _
        ring
    · intro X η h0 h1 e1 e2
      simp only [zero_add, Finset.sum_range_one, Nat.choose_zero_right, Nat.cast_one, one_mul,
        Nat.sub_self, hEf X η h0 h1 e1 e2, hEg X η h0 h1 e1 e2, Complex.ofReal_mul]

theorem bgHolo_pdX_pdE : ∀ (Xi : ℝ) (f : ℝ → ℝ → ℝ), BgHolo Xi f → BgHolo Xi (pdX f) ∧ BgHolo Xi (pdE f) :=
by

  have L1open : ∀ ρ : ℝ, IsOpen (cStrip ρ) := by
    intro ρ
    have h1 : IsOpen {w : ℂ | |w.im| < ρ} := isOpen_lt Complex.continuous_im.abs continuous_const
    have h2 : IsOpen {w : ℂ | -1 - ρ < w.re} := isOpen_lt continuous_const Complex.continuous_re
    have h3 : IsOpen {w : ℂ | w.re < 1 + ρ} := isOpen_lt Complex.continuous_re continuous_const
    have e : cStrip ρ = {w : ℂ | |w.im| < ρ} ∩ ({w : ℂ | -1 - ρ < w.re} ∩ {w : ℂ | w.re < 1 + ρ}) := by
      ext w
      simp only [cStrip, Set.mem_setOf_eq, Set.mem_inter_iff]
    rw [e]
    exact h1.inter (h2.inter h3)
  have L1mono : ∀ a ρ : ℝ, a ≤ ρ → cStrip a ⊆ cStrip ρ := by
    intro a ρ h w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    obtain ⟨h1, h2, h3⟩ := hw
    exact ⟨by linarith, by linarith, by linarith⟩
  have L1real : ∀ ρ : ℝ, 0 < ρ → ∀ η : ℝ, -1 < η → η < 1 → ((η : ℝ) : ℂ) ∈ cStrip ρ := by
    intro ρ hρ η h1 h2
    simp only [cStrip, Set.mem_setOf_eq, Complex.ofReal_im, Complex.ofReal_re, abs_zero]
    exact ⟨hρ, by linarith, by linarith⟩
  have L1ball : ∀ (a r ρ : ℝ) (w : ℂ), w ∈ cStrip a → 0 ≤ r → a + r ≤ ρ →
      Metric.closedBall w r ⊆ cStrip ρ := by
    intro a r ρ w hw hr har z hz
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    rw [Metric.mem_closedBall, dist_eq_norm] at hz
    have hre := Complex.abs_re_le_norm (z - w)
    have him := Complex.abs_im_le_norm (z - w)
    rw [Complex.sub_re] at hre
    rw [Complex.sub_im] at him
    obtain ⟨h1, h2, h3⟩ := hw
    have e1 := abs_le.mp (hre.trans hz)
    have e2 := abs_le.mp (him.trans hz)
    have e3 := abs_lt.mp h1
    exact ⟨abs_lt.mpr ⟨by linarith, by linarith⟩, by linarith, by linarith⟩

  have L3 : ∀ (g : ℝ → ℝ) (φ : ℝ → ℂ) (z : ℂ) (x : ℝ), HasDerivAt φ z x →
      (∀ᶠ y in nhds x, φ y = ((g y : ℝ) : ℂ)) → z = ((deriv g x : ℝ) : ℂ) := by
    intro g φ z x hφ hev
    have hψ : HasDerivAt (fun y => ((g y : ℝ) : ℂ)) z x :=
      hφ.congr_of_eventuallyEq (hev.mono fun y hy => hy.symm)
    have hre0 : HasDerivAt (fun y => Complex.reCLM ((g y : ℝ) : ℂ)) (Complex.reCLM z) x :=
      (Complex.reCLM.hasFDerivAt).comp_hasDerivAt x hψ
    have him0 : HasDerivAt (fun y => Complex.imCLM ((g y : ℝ) : ℂ)) (Complex.imCLM z) x :=
      (Complex.imCLM.hasFDerivAt).comp_hasDerivAt x hψ
    have hre : HasDerivAt g z.re x := by simpa using hre0
    have him : HasDerivAt (fun _ : ℝ => (0:ℝ)) z.im x := by simpa using him0
    have h0 : z.im = 0 := him.unique (hasDerivAt_const x 0)
    apply Complex.ext
    · rw [hre.deriv]; simp
    · simp [h0]

  have L4 : ∀ (I : Set ℝ) (Ω Ω' : Set ℂ) (s : ℝ) (F : ℝ → ℂ → ℂ), IsOpen I → 0 < s →
      (∀ w ∈ Ω', Metric.closedBall w s ⊆ Ω) →
      ContinuousOn (fun p : ℝ × ℂ => F p.1 p.2) (I ×ˢ Ω) →
      (∀ X ∈ I, DifferentiableOn ℂ (F X) Ω) →
      ContinuousOn (fun p : ℝ × ℂ => deriv (F p.1) p.2) (I ×ˢ Ω') := by
    intro I Ω Ω' s F hI hs hball hcont hdiff
    rintro ⟨X₀, w₀⟩ ⟨hX₀, hw₀⟩
    rw [Metric.continuousWithinAt_iff]
    intro ε hε
    obtain ⟨e, he, heI⟩ := Metric.isOpen_iff.mp hI X₀ hX₀
    have hJI : Icc (X₀ - e / 2) (X₀ + e / 2) ⊆ I := by
      intro t ht
      apply heI
      rw [Metric.mem_ball, Real.dist_eq, abs_lt]
      constructor <;> linarith [ht.1, ht.2]
    have hKΩ : Metric.closedBall w₀ s ⊆ Ω := hball w₀ hw₀
    have hcomp : IsCompact (Icc (X₀ - e / 2) (X₀ + e / 2) ×ˢ Metric.closedBall w₀ s) :=
      isCompact_Icc.prod (isCompact_closedBall _ _)
    have huc := hcomp.uniformContinuousOn_of_continuous (hcont.mono (prod_mono hJI hKΩ))
    rw [Metric.uniformContinuousOn_iff] at huc
    obtain ⟨δ₁, hδ₁, hu⟩ := huc (ε * s / 4) (div_pos (mul_pos hε hs) (by norm_num))
    have hballΩ : Metric.ball w₀ s ⊆ Ω := Metric.ball_subset_closedBall.trans hKΩ
    have hdd : DifferentiableOn ℂ (deriv (F X₀)) (Metric.ball w₀ s) :=
      ((hdiff X₀ hX₀).mono hballΩ).deriv Metric.isOpen_ball
    have hca : ContinuousAt (deriv (F X₀)) w₀ :=
      hdd.continuousOn.continuousAt (Metric.ball_mem_nhds w₀ hs)
    rw [Metric.continuousAt_iff] at hca
    obtain ⟨δ₂, hδ₂, hc2⟩ := hca (ε / 2) (half_pos hε)
    refine ⟨min (min (e / 2) δ₁) (min δ₂ (s / 2)),
      lt_min (lt_min (half_pos he) hδ₁) (lt_min hδ₂ (half_pos hs)), ?_⟩
    rintro ⟨X, w⟩ ⟨hX, hw⟩ hdist
    rw [Prod.dist_eq] at hdist
    have hd1 : dist X X₀ < min (min (e / 2) δ₁) (min δ₂ (s / 2)) :=
      lt_of_le_of_lt (le_max_left _ _) hdist
    have hd2 : dist w w₀ < min (min (e / 2) δ₁) (min δ₂ (s / 2)) :=
      lt_of_le_of_lt (le_max_right _ _) hdist
    have hXe : dist X X₀ < e / 2 := lt_of_lt_of_le hd1 ((min_le_left _ _).trans (min_le_left _ _))
    have hXδ : dist X X₀ < δ₁ := lt_of_lt_of_le hd1 ((min_le_left _ _).trans (min_le_right _ _))
    have hwδ : dist w w₀ < δ₂ := lt_of_lt_of_le hd2 ((min_le_right _ _).trans (min_le_left _ _))
    have hws : dist w w₀ < s / 2 :=
      lt_of_lt_of_le hd2 ((min_le_right _ _).trans (min_le_right _ _))
    have hXJ : X ∈ Icc (X₀ - e / 2) (X₀ + e / 2) := by
      rw [Real.dist_eq, abs_lt] at hXe
      constructor <;> linarith [hXe.1, hXe.2]
    have hX₀J : X₀ ∈ Icc (X₀ - e / 2) (X₀ + e / 2) := by constructor <;> linarith
    have hsub : Metric.closedBall w (s / 2) ⊆ Metric.closedBall w₀ s := by
      intro z hz
      rw [Metric.mem_closedBall] at hz ⊢
      linarith [dist_triangle z w w₀]
    have hgd : DifferentiableOn ℂ (fun z => F X z - F X₀ z) (Metric.closedBall w (s / 2)) :=
      ((hdiff X hX).sub (hdiff X₀ hX₀)).mono (hsub.trans hKΩ)
    have hgc : DiffContOnCl ℂ (fun z => F X z - F X₀ z) (Metric.ball w (s / 2)) := by
      apply DifferentiableOn.diffContOnCl
      rw [closure_ball w (half_pos hs).ne']
      exact hgd
    have hgb : ∀ z ∈ Metric.sphere w (s / 2), ‖F X z - F X₀ z‖ ≤ ε * s / 4 := by
      intro z hz
      have hzK : z ∈ Metric.closedBall w₀ s := hsub (Metric.sphere_subset_closedBall hz)
      have hdz : dist ((X, z) : ℝ × ℂ) (X₀, z) < δ₁ := by
        simp only [Prod.dist_eq, dist_self]
        rw [max_eq_left dist_nonneg]
        exact hXδ
      have := hu (X, z) ⟨hXJ, hzK⟩ (X₀, z) ⟨hX₀J, hzK⟩ hdz
      rw [dist_eq_norm] at this
      exact this.le
    have hcauchy := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le (half_pos hs) hgc hgb
    have hwΩ : Ω ∈ nhds w :=
      Filter.mem_of_superset (Metric.ball_mem_nhds w (half_pos hs))
        (Metric.ball_subset_closedBall.trans (hsub.trans hKΩ))
    have hderiv : deriv (fun z => F X z - F X₀ z) w = deriv (F X) w - deriv (F X₀) w :=
      (((hdiff X hX).differentiableAt hwΩ).hasDerivAt.sub
        ((hdiff X₀ hX₀).differentiableAt hwΩ).hasDerivAt).deriv
    show dist (deriv (F X) w) (deriv (F X₀) w₀) < ε
    have h2 := hc2 hwδ
    rw [dist_eq_norm] at h2 ⊢
    have hsplit : deriv (F X) w - deriv (F X₀) w₀ =
        deriv (fun z => F X z - F X₀ z) w + (deriv (F X₀) w - deriv (F X₀) w₀) := by
      rw [hderiv]; ring
    rw [hsplit]
    have hq : ε * s / 4 / (s / 2) = ε / 2 := by
      rw [div_div_eq_mul_div]
      field_simp
      ring
    calc ‖deriv (fun z => F X z - F X₀ z) w + (deriv (F X₀) w - deriv (F X₀) w₀)‖
        ≤ ‖deriv (fun z => F X z - F X₀ z) w‖ + ‖deriv (F X₀) w - deriv (F X₀) w₀‖ :=
          norm_add_le _ _
      _ < ε / 2 + ε / 2 := by linarith
      _ = ε := by ring

  have L5 : ∀ (I : Set ℝ) (Ω Ω' : Set ℂ) (s : ℝ) (F F' : ℝ → ℂ → ℂ), IsOpen I → 0 < s →
      (∀ w ∈ Ω', Metric.closedBall w s ⊆ Ω) →
      ContinuousOn (fun p : ℝ × ℂ => F' p.1 p.2) (I ×ˢ Ω) →
      (∀ X ∈ I, DifferentiableOn ℂ (F X) Ω ∧ DifferentiableOn ℂ (F' X) Ω) →
      (∀ X ∈ I, ∀ z ∈ Ω, HasDerivAt (fun Y : ℝ => F Y z) (F' X z) X) →
      ∀ X ∈ I, ∀ w ∈ Ω', HasDerivAt (fun Y : ℝ => deriv (F Y) w) (deriv (F' X) w) X := by
    intro I Ω Ω' s F F' hI hs hball hcont hdiff hder X hX w hw
    rw [hasDerivAt_iff_isLittleO, Asymptotics.isLittleO_iff]
    intro c hc
    obtain ⟨e, he, heI⟩ := Metric.isOpen_iff.mp hI X hX
    have hJI : Icc (X - e / 2) (X + e / 2) ⊆ I := by
      intro t ht
      apply heI
      rw [Metric.mem_ball, Real.dist_eq, abs_lt]
      constructor <;> linarith [ht.1, ht.2]
    have hKΩ : Metric.closedBall w s ⊆ Ω := hball w hw
    have hcomp : IsCompact (Icc (X - e / 2) (X + e / 2) ×ˢ Metric.closedBall w s) :=
      isCompact_Icc.prod (isCompact_closedBall _ _)
    have huc := hcomp.uniformContinuousOn_of_continuous (hcont.mono (prod_mono hJI hKΩ))
    rw [Metric.uniformContinuousOn_iff] at huc
    obtain ⟨δ₁, hδ₁, hu⟩ := huc (c * s) (mul_pos hc hs)
    filter_upwards [Metric.ball_mem_nhds X (lt_min (half_pos he) hδ₁)] with Y hY
    rw [Metric.mem_ball, Real.dist_eq] at hY
    have hYe : |Y - X| < e / 2 := lt_of_lt_of_le hY (min_le_left _ _)
    have hYδ : |Y - X| < δ₁ := lt_of_lt_of_le hY (min_le_right _ _)
    have hXJ : X ∈ Icc (X - e / 2) (X + e / 2) := by constructor <;> linarith
    have htJ : ∀ t ∈ uIcc X Y, t ∈ Icc (X - e / 2) (X + e / 2) ∧ |t - X| ≤ |Y - X| := by
      intro t ht
      rw [mem_uIcc] at ht
      have hYe' := abs_lt.mp hYe
      rcases ht with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · refine ⟨⟨by linarith, by linarith⟩, ?_⟩
        rw [abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]
        linarith
      · refine ⟨⟨by linarith, by linarith⟩, ?_⟩
        rw [abs_of_nonpos (by linarith), abs_of_nonpos (by linarith)]
        linarith
    have hYI : Y ∈ I := hJI (htJ Y right_mem_uIcc).1
    have hR : ∀ z ∈ Metric.closedBall w s,
        ‖F Y z - F X z - ((Y - X : ℝ) : ℂ) * F' X z‖ ≤ c * s * ‖Y - X‖ := by
      intro z hz
      have hzΩ := hKΩ hz
      have hdR : ∀ t ∈ uIcc X Y, HasDerivWithinAt
          (fun t : ℝ => F t z - F X z - ((t - X : ℝ) : ℂ) * F' X z) (F' t z - F' X z) (uIcc X Y) t := by
        intro t ht
        have h1 := hder t (hJI (htJ t ht).1) z hzΩ
        have h2 : HasDerivAt (fun t : ℝ => ((t - X : ℝ) : ℂ) * F' X z) (F' X z) t := by
          have := ((hasDerivAt_id t).sub_const X).ofReal_comp.mul_const (F' X z)
          simpa using this
        exact ((h1.sub_const (F X z)).sub h2).hasDerivWithinAt
      have hbd : ∀ t ∈ uIcc X Y, ‖F' t z - F' X z‖ ≤ c * s := by
        intro t ht
        obtain ⟨htJ', hle⟩ := htJ t ht
        have hdz : dist ((t, z) : ℝ × ℂ) (X, z) < δ₁ := by
          simp only [Prod.dist_eq, dist_self]
          rw [max_eq_left dist_nonneg, Real.dist_eq]
          linarith
        have := hu (t, z) ⟨htJ', hz⟩ (X, z) ⟨hXJ, hz⟩ hdz
        rw [dist_eq_norm] at this
        exact this.le
      have := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le hdR hbd (convex_uIcc X Y)
        left_mem_uIcc right_mem_uIcc
      simpa using this
    have hgd : DifferentiableOn ℂ (fun z => F Y z - F X z - ((Y - X : ℝ) : ℂ) * F' X z) Ω :=
      ((hdiff Y hYI).1.sub (hdiff X hX).1).sub ((hdiff X hX).2.const_mul _)
    have hgc : DiffContOnCl ℂ (fun z => F Y z - F X z - ((Y - X : ℝ) : ℂ) * F' X z)
        (Metric.ball w s) := by
      apply DifferentiableOn.diffContOnCl
      rw [closure_ball w hs.ne']
      exact hgd.mono hKΩ
    have hcauchy := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hs hgc
      (fun z hz => hR z (Metric.sphere_subset_closedBall hz))
    have hwΩ : Ω ∈ nhds w :=
      Filter.mem_of_superset (Metric.ball_mem_nhds w hs) (Metric.ball_subset_closedBall.trans hKΩ)
    have hd1 := (hdiff Y hYI).1.differentiableAt hwΩ
    have hd2 := (hdiff X hX).1.differentiableAt hwΩ
    have hd3 := (hdiff X hX).2.differentiableAt hwΩ
    have hderiv : deriv (fun z => F Y z - F X z - ((Y - X : ℝ) : ℂ) * F' X z) w =
        deriv (F Y) w - deriv (F X) w - ((Y - X : ℝ) : ℂ) * deriv (F' X) w :=
      ((hd1.hasDerivAt.sub hd2.hasDerivAt).sub (hd3.hasDerivAt.const_mul _)).deriv
    show ‖deriv (F Y) w - deriv (F X) w - (Y - X) • deriv (F' X) w‖ ≤ c * ‖Y - X‖
    rw [Complex.real_smul, ← hderiv]
    have hq : c * s * ‖Y - X‖ / s = c * ‖Y - X‖ := by
      field_simp
    rw [← hq]
    exact hcauchy

  intro Xi f hf
  unfold BgHolo at hf
  obtain ⟨fc, ρ, C, H1, H2, H3, H4, H5⟩ := hf
  refine ⟨?_, ?_⟩
  ·
    unfold BgHolo
    refine ⟨fun k => fc (k + 1), fun k => ρ (k + 1), fun k => C (k + 1), fun k => H1 (k + 1),
      fun k => H2 (k + 1), fun k X h0 h1 => H3 (k + 1) X h0 h1,
      fun k X w h0 h1 hw => H4 (k + 1) X w h0 h1 hw, ?_⟩
    intro X η h0 h1 e1 e2
    have hmem : ((η : ℝ) : ℂ) ∈ cStrip (ρ (0 + 1)) := L1real _ (H1 1).1 η e1 e2
    have hd := H4 0 X (η : ℂ) h0 h1 hmem
    have hev : ∀ᶠ Y in nhds X, fc 0 Y (η : ℂ) = ((f Y η : ℝ) : ℂ) := by
      filter_upwards [Ioo_mem_nhds h0 h1] with Y hY
      exact H5 Y η hY.1 hY.2 e1 e2
    exact L3 (fun Y => f Y η) (fun Y => fc 0 Y (η : ℂ)) _ X hd hev
  ·
    unfold BgHolo
    refine ⟨fun k X w => deriv (fc k X) w, fun k => ρ k / 2, fun k => 2 * C k / ρ k,
      ?_, ?_, ?_, ?_, ?_⟩
    · intro k
      have a := (H1 k).1
      have b := (H1 k).2
      exact ⟨by linarith, by linarith⟩
    · intro k
      have hρ := (H1 k).1
      exact L4 (Ioo 0 Xi) (cStrip (ρ k)) (cStrip (ρ k / 2)) (ρ k / 2) (fc k) isOpen_Ioo
        (half_pos hρ)
        (fun w hw => L1ball (ρ k / 2) (ρ k / 2) (ρ k) w hw (by linarith) (by linarith))
        (H2 k) (fun X hX => (H3 k X hX.1 hX.2).1)
    · intro k X h0 h1
      have hρ := (H1 k).1
      obtain ⟨hdk, hbk⟩ := H3 k X h0 h1
      refine ⟨(hdk.deriv (L1open _)).mono (L1mono _ _ (by linarith)), ?_⟩
      intro w hw
      have hcb : Metric.closedBall w (ρ k / 2) ⊆ cStrip (ρ k) :=
        L1ball (ρ k / 2) (ρ k / 2) (ρ k) w hw (by linarith) (by linarith)
      have hgc : DiffContOnCl ℂ (fc k X) (Metric.ball w (ρ k / 2)) := by
        apply DifferentiableOn.diffContOnCl
        rw [closure_ball w (half_pos hρ).ne']
        exact hdk.mono hcb
      have hc := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le (half_pos hρ) hgc
        (fun z hz => hbk z (hcb (Metric.sphere_subset_closedBall hz)))
      calc ‖deriv (fc k X) w‖ ≤ C k / (ρ k / 2) := hc
        _ = 2 * C k / ρ k := by rw [div_div_eq_mul_div, mul_comm (C k) 2]
    · intro k X w h0 h1 hw
      have hρ1 := (H1 (k + 1)).1
      have hle := (H1 k).2
      exact L5 (Ioo 0 Xi) (cStrip (ρ (k + 1))) (cStrip (ρ (k + 1) / 2)) (ρ (k + 1) / 2) (fc k)
        (fc (k + 1)) isOpen_Ioo (half_pos hρ1)
        (fun w hw => L1ball _ _ _ w hw (by linarith) (by linarith)) (H2 (k + 1))
        (fun Y hY => ⟨(H3 k Y hY.1 hY.2).1.mono (L1mono _ _ hle), (H3 (k + 1) Y hY.1 hY.2).1⟩)
        (fun Y hY z hz => H4 k Y z hY.1 hY.2 hz) X ⟨h0, h1⟩ w hw
    · intro X η h0 h1 e1 e2
      have hmem := L1real (ρ 0) (H1 0).1 η e1 e2
      have hda : DifferentiableAt ℂ (fc 0 X) (η : ℂ) :=
        (H3 0 X h0 h1).1.differentiableAt ((L1open _).mem_nhds hmem)
      have hd : HasDerivAt (fun y : ℝ => fc 0 X (y : ℂ)) (deriv (fc 0 X) (η : ℂ)) η :=
        hda.hasDerivAt.comp_ofReal
      have hev : ∀ᶠ y : ℝ in nhds η, fc 0 X (y : ℂ) = ((f X y : ℝ) : ℂ) := by
        filter_upwards [Ioo_mem_nhds e1 e2] with y hy
        exact H5 X y h0 h1 hy.1 hy.2
      exact L3 (fun e => f X e) (fun y : ℝ => fc 0 X (y : ℂ)) _ η hd hev

theorem bgHolo_X_const : ∀ (Xi c : ℝ) (f : ℝ → ℝ → ℝ), BgHolo Xi f → BgHolo Xi (fun X η => X * f X η) ∧ BgHolo Xi (fun X η => c * f X η) :=
by
  intro Xi c f hf
  obtain ⟨fc, ρ, C, H1, H2, H3, H4, H5⟩ := hf
  have hmono : ∀ a b : ℝ, a ≤ b → cStrip a ⊆ cStrip b := by
    intro a b hab w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
  have hanti : Antitone ρ := antitone_nat_of_succ_le (fun k => (H1 k).2)
  have hsub : ∀ k : ℕ, cStrip (ρ k) ⊆ cStrip (ρ (k - 1)) :=
    fun k => hmono _ _ (hanti (Nat.sub_le k 1))
  refine ⟨⟨fun k X w => (X : ℂ) * fc k X w + (k : ℂ) * fc (k - 1) X w, ρ,
      fun k => Xi * |C k| + k * |C (k - 1)|, H1, ?_, ?_, ?_, ?_⟩,
    ⟨fun k X w => (c : ℂ) * fc k X w, ρ, fun k => |c| * |C k|, H1, ?_, ?_, ?_, ?_⟩⟩
  · intro k
    beta_reduce
    have h1 : ContinuousOn (fun p : ℝ × ℂ => ((p.1 : ℝ) : ℂ)) (Ioo 0 Xi ×ˢ cStrip (ρ k)) :=
      (Complex.continuous_ofReal.comp continuous_fst).continuousOn
    have h2 := (H2 (k - 1)).mono (Set.prod_mono subset_rfl (hsub k))
    exact (h1.mul (H2 k)).add (continuousOn_const.mul h2)
  · intro k X hX0 hXi
    beta_reduce
    refine ⟨?_, ?_⟩
    · exact ((H3 k X hX0 hXi).1.const_mul _).add
        (((H3 (k - 1) X hX0 hXi).1.mono (hsub k)).const_mul _)
    · intro w hw
      have b1 := (H3 k X hX0 hXi).2 w hw
      have b2 := (H3 (k - 1) X hX0 hXi).2 w (hsub k hw)
      have a1 : C k ≤ |C k| := le_abs_self _
      have a2 : C (k - 1) ≤ |C (k - 1)| := le_abs_self _
      have n1 := norm_nonneg (fc k X w)
      have hk : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
      calc ‖(X : ℂ) * fc k X w + (k : ℂ) * fc (k - 1) X w‖
          ≤ ‖(X : ℂ) * fc k X w‖ + ‖(k : ℂ) * fc (k - 1) X w‖ := norm_add_le _ _
        _ = X * ‖fc k X w‖ + (k : ℝ) * ‖fc (k - 1) X w‖ := by
            rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_natCast, Real.norm_eq_abs,
              abs_of_pos hX0]
        _ ≤ Xi * |C k| + (k : ℝ) * |C (k - 1)| :=
            add_le_add (mul_le_mul hXi.le (b1.trans a1) n1 (by linarith))
              (mul_le_mul_of_nonneg_left (b2.trans a2) hk)
  · intro k X w hX0 hXi hw
    beta_reduce
    have hid : HasDerivAt (fun Y : ℝ => (Y : ℂ)) 1 X := by
      simpa using (hasDerivAt_id X).ofReal_comp
    have hA := hid.mul (H4 k X w hX0 hXi hw)
    have hw' : w ∈ cStrip (ρ (k - 1 + 1)) := hmono _ _ (hanti (by omega)) hw
    have hB := (H4 (k - 1) X w hX0 hXi hw').const_mul (k : ℂ)
    have hS := hA.add hB
    convert hS using 1
    cases k with
    | zero => simp; ring
    | succ j => simp; push_cast; ring
  · intro X η hX0 hXi h1 h2
    beta_reduce
    rw [H5 X η hX0 hXi h1 h2]
    push_cast
    ring
  · intro k
    beta_reduce
    exact continuousOn_const.mul (H2 k)
  · intro k X hX0 hXi
    beta_reduce
    refine ⟨(H3 k X hX0 hXi).1.const_mul _, fun w hw => ?_⟩
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_left (((H3 k X hX0 hXi).2 w hw).trans (le_abs_self _))
      (abs_nonneg _)
  · intro k X w hX0 hXi hw
    beta_reduce
    exact (H4 k X w hX0 hXi hw).const_mul (c : ℂ)
  · intro X η hX0 hXi h1 h2
    beta_reduce
    rw [H5 X η hX0 hXi h1 h2]
    push_cast
    ring

theorem bgHolo_profRadAvg : ∀ (Xi : ℝ) (g : ℝ → ℝ → ℝ), 0 < Xi → BgHolo Xi g → BgHolo Xi (profRadAvg g) :=
by
  have hIoc : Set.uIoc (0:ℝ) 1 = Ioc 0 1 := Set.uIoc_of_le zero_le_one
  have hmem : ∀ s : ℝ, s ∈ Set.uIoc (0:ℝ) 1 → s ∈ Ioc (0:ℝ) 1 := fun s hs => by
    rwa [hIoc] at hs

  have s1 : ∀ (G : ℝ → ℂ → ℂ) (U : Set ℂ) (C : ℝ), IsOpen U →
      (∀ w ∈ U, ContinuousOn (fun s => G s w) (Ioc (0:ℝ) 1)) →
      (∀ s ∈ Ioc (0:ℝ) 1, DifferentiableOn ℂ (G s) U) →
      (∀ s ∈ Ioc (0:ℝ) 1, ∀ w ∈ U, ‖G s w‖ ≤ C) →
      DifferentiableOn ℂ (fun w => ∫ s in (0:ℝ)..1, G s w) U := by
    intro G U C hU hc hd hb w₀ hw₀
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hU w₀ hw₀
    obtain ⟨R, hR⟩ : ∃ R : ℝ, R = ε / 3 := ⟨_, rfl⟩
    have hR0 : 0 < R := by rw [hR]; positivity
    have hBU : Metric.ball w₀ R ⊆ U := fun z hz =>
      hball (Metric.ball_subset_ball (by rw [hR]; linarith) hz)
    have hcl : ∀ w ∈ Metric.ball w₀ R, Metric.closedBall w R ⊆ U := by
      intro w hw z hz
      apply hball
      rw [Metric.mem_ball] at hw ⊢
      rw [Metric.mem_closedBall] at hz
      calc dist z w₀ ≤ dist z w + dist w w₀ := dist_triangle _ _ _
        _ < ε := by rw [hR] at hz hw; linarith
    have hcauchy : ∀ s ∈ Ioc (0:ℝ) 1, ∀ w ∈ Metric.ball w₀ R, ‖deriv (G s) w‖ ≤ C / R := by
      intro s hs w hw
      apply Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hR0
      · apply DifferentiableOn.diffContOnCl
        rw [closure_ball w hR0.ne']
        exact (hd s hs).mono (hcl w hw)
      · intro z hz
        exact hb s hs z (hcl w hw (Metric.sphere_subset_closedBall hz))
    have hder : ∀ s ∈ Ioc (0:ℝ) 1, ∀ w ∈ U, HasDerivAt (G s) (deriv (G s) w) w := by
      intro s hs w hw
      exact ((hd s hs).differentiableAt (hU.mem_nhds hw)).hasDerivAt
    have hmeas : AEStronglyMeasurable (fun s => deriv (G s) w₀)
        (volume.restrict (Set.uIoc (0:ℝ) 1)) := by
      rw [hIoc]
      obtain ⟨d, hd⟩ : ∃ d : ℕ → ℝ, d = fun n : ℕ => ε / ((n:ℝ) + 2) := ⟨_, rfl⟩
      obtain ⟨z, hz⟩ : ∃ z : ℕ → ℂ, z = fun n : ℕ => w₀ + ((d n : ℝ) : ℂ) := ⟨_, rfl⟩
      have hpos : ∀ n : ℕ, 0 < d n := fun n => by rw [hd]; positivity
      have hzU : ∀ n, z n ∈ U := by
        intro n
        apply hball
        rw [Metric.mem_ball, dist_eq_norm, hz]
        simp only [add_sub_cancel_left, Complex.norm_real, Real.norm_eq_abs]
        rw [abs_of_pos (hpos n), hd]
        dsimp only
        rw [div_lt_iff₀ (by positivity)]
        have : (0:ℝ) ≤ n := Nat.cast_nonneg n
        nlinarith
      have hzne : ∀ n, z n ≠ w₀ := by
        intro n h
        have h1 : z n = w₀ + ((d n : ℝ) : ℂ) := by rw [hz]
        have h2 : ((d n : ℝ) : ℂ) = 0 := by linear_combination h - h1
        have h3 : d n = 0 := Complex.ofReal_eq_zero.mp h2
        linarith [hpos n]
      have hzt : Filter.Tendsto z Filter.atTop (nhdsWithin w₀ {w₀}ᶜ) := by
        apply tendsto_nhdsWithin_iff.mpr
        refine ⟨?_, Filter.Eventually.of_forall hzne⟩
        have h1 : Filter.Tendsto d Filter.atTop (nhds 0) := by
          have := (tendsto_const_div_atTop_nhds_zero_nat ε).comp (Filter.tendsto_add_atTop_nat 2)
          refine this.congr (fun n => ?_)
          rw [hd]
          simp [Function.comp, Nat.cast_add]
        have h2 : Filter.Tendsto (fun n : ℕ => ((d n : ℝ) : ℂ)) Filter.atTop (nhds 0) := by
          have := (Complex.continuous_ofReal.tendsto 0).comp h1
          rw [Complex.ofReal_zero] at this
          exact this
        have h3 := (tendsto_const_nhds (x := w₀)).add h2
        rw [add_zero] at h3
        rw [hz]
        exact h3
      apply aestronglyMeasurable_of_tendsto_ae Filter.atTop
        (f := fun n s => slope (G s) w₀ (z n))
      · intro n
        apply ContinuousOn.aestronglyMeasurable _ measurableSet_Ioc
        have e : (fun s => slope (G s) w₀ (z n)) =
            fun s => (z n - w₀)⁻¹ * (G s (z n) - G s w₀) := by
          funext s
          rw [slope_def_module, smul_eq_mul]
        rw [e]
        exact (continuousOn_const (c := (z n - w₀)⁻¹)).mul ((hc _ (hzU n)).sub (hc _ hw₀))
      · apply ae_restrict_of_forall_mem measurableSet_Ioc
        intro s hs
        exact (hasDerivAt_iff_tendsto_slope.mp (hder s hs w₀ hw₀)).comp hzt
    have hmain := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (𝕜 := ℂ) (μ := volume) (a := 0) (b := 1) (F := fun w s => G s w)
      (F' := fun w s => deriv (G s) w) (x₀ := w₀) (bound := fun _ => C / R)
      (Metric.ball_mem_nhds w₀ hR0) ?_ ?_ hmeas ?_ intervalIntegrable_const ?_
    · exact hmain.2.differentiableAt.differentiableWithinAt
    · filter_upwards [hU.mem_nhds hw₀] with w hw
      rw [hIoc]
      exact (hc w hw).aestronglyMeasurable measurableSet_Ioc
    · apply IntervalIntegrable.mono_fun' (g := fun _ => C) intervalIntegrable_const
      · rw [hIoc]
        exact (hc w₀ hw₀).aestronglyMeasurable measurableSet_Ioc
      · rw [hIoc]
        exact ae_restrict_of_forall_mem measurableSet_Ioc (fun s hs => hb s hs w₀ hw₀)
    · exact ae_of_all _ (fun s hs w hw => hcauchy s (hmem s hs) w hw)
    · exact ae_of_all _ (fun s hs w hw => hder s (hmem s hs) w (hBU hw))

  have s2 : ∀ (H : ℝ → ℝ × ℂ → ℂ) (T : Set (ℝ × ℂ)) (C : ℝ),
      (∀ s ∈ Ioc (0:ℝ) 1, ContinuousOn (H s) T) →
      (∀ p ∈ T, ContinuousOn (fun s => H s p) (Ioc (0:ℝ) 1)) →
      (∀ s ∈ Ioc (0:ℝ) 1, ∀ p ∈ T, ‖H s p‖ ≤ C) →
      ContinuousOn (fun p => ∫ s in (0:ℝ)..1, H s p) T := by
    intro H T C hc1 hc2 hb p₀ hp₀
    apply intervalIntegral.continuousWithinAt_of_dominated_interval (bound := fun _ => C)
    · filter_upwards [self_mem_nhdsWithin] with p hp
      rw [hIoc]
      exact (hc2 p hp).aestronglyMeasurable measurableSet_Ioc
    · filter_upwards [self_mem_nhdsWithin] with p hp
      exact ae_of_all _ (fun s hs => hb s (hmem s hs) p hp)
    · exact intervalIntegrable_const
    · exact ae_of_all _ (fun s hs => hc1 s (hmem s hs) p₀ hp₀)

  have s3 : ∀ (A B : ℝ → ℝ → ℂ) (V : Set ℝ) (X C : ℝ), IsOpen V → X ∈ V →
      (∀ Y ∈ V, ContinuousOn (fun s => A s Y) (Ioc (0:ℝ) 1)) →
      ContinuousOn (fun s => B s X) (Ioc (0:ℝ) 1) →
      (∀ s ∈ Ioc (0:ℝ) 1, ∀ Y ∈ V, ‖B s Y‖ ≤ C) →
      (∀ s ∈ Ioc (0:ℝ) 1, ‖A s X‖ ≤ C) →
      (∀ s ∈ Ioc (0:ℝ) 1, ∀ Y ∈ V, HasDerivAt (A s) (B s Y) Y) →
      HasDerivAt (fun Y => ∫ s in (0:ℝ)..1, A s Y) (∫ s in (0:ℝ)..1, B s X) X := by
    intro A B V X C hV hX hcA hcB hbB hbA hd
    have hmain := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (𝕜 := ℝ) (μ := volume) (a := 0) (b := 1) (F := fun Y s => A s Y)
      (F' := fun Y s => B s Y) (x₀ := X) (bound := fun _ => C)
      (hV.mem_nhds hX) ?_ ?_ ?_ ?_ intervalIntegrable_const ?_
    · exact hmain.2
    · filter_upwards [hV.mem_nhds hX] with Y hY
      rw [hIoc]
      exact (hcA Y hY).aestronglyMeasurable measurableSet_Ioc
    · apply IntervalIntegrable.mono_fun' (g := fun _ => C) intervalIntegrable_const
      · rw [hIoc]
        exact (hcA X hX).aestronglyMeasurable measurableSet_Ioc
      · rw [hIoc]
        exact ae_restrict_of_forall_mem measurableSet_Ioc (fun s hs => hbA s hs)
    · rw [hIoc]
      exact hcB.aestronglyMeasurable measurableSet_Ioc
    · exact ae_of_all _ (fun s hs Y hY => hbB s (hmem s hs) Y hY)
    · exact ae_of_all _ (fun s hs Y hY => hd s (hmem s hs) Y hY)

  intro Xi g hXi hg
  obtain ⟨gc, ρ, C, hρ, hcont, hhol, hcoh, hreal⟩ := hg
  have F1 : ∀ r, IsOpen (cStrip r) := by
    intro r
    have e : cStrip r = ({w : ℂ | |w.im| < r} ∩ {w : ℂ | -1 - r < w.re}) ∩
        {w : ℂ | w.re < 1 + r} := by
      ext w
      simp [cStrip, and_assoc]
    rw [e]
    exact ((isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).inter
      (isOpen_lt continuous_const Complex.continuous_re)).inter
      (isOpen_lt Complex.continuous_re continuous_const)
  have F2 : ∀ k, cStrip (ρ (k + 1)) ⊆ cStrip (ρ k) := by
    intro k w hw
    simp only [cStrip, mem_setOf_eq] at hw ⊢
    have := (hρ k).2
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
  have F3 : ∀ s ∈ Ioc (0:ℝ) 1, ∀ X : ℝ, 0 < X → X < Xi → 0 < s * X ∧ s * X < Xi :=
    fun s hs X h0 h1 => ⟨mul_pos hs.1 h0, lt_of_le_of_lt (mul_le_of_le_one_left h0.le hs.2) h1⟩
  have F4 : ∀ s ∈ Ioc (0:ℝ) 1, ∀ m : ℕ, ‖(s:ℂ) ^ m‖ ≤ 1 := by
    intro s hs m
    rw [norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hs.1]
    exact pow_le_one₀ hs.1.le hs.2
  have F5 : ∀ (j m : ℕ) (X : ℝ) (w : ℂ), 0 < X → X < Xi → w ∈ cStrip (ρ j) →
      ContinuousOn (fun s : ℝ => (s:ℂ) ^ m * gc j (s * X) w) (Ioc (0:ℝ) 1) := by
    intro j m X w h0 h1 hw
    apply ((Complex.continuous_ofReal.pow m).continuousOn).mul
    have hmap : MapsTo (fun s : ℝ => (s * X, w)) (Ioc (0:ℝ) 1) (Ioo 0 Xi ×ˢ cStrip (ρ j)) :=
      fun s hs => ⟨F3 s hs X h0 h1, hw⟩
    exact (hcont j).comp ((continuous_id.mul continuous_const).prodMk continuous_const).continuousOn
      hmap
  have F6 : ∀ (j m : ℕ) (s Y : ℝ) (w : ℂ), s ∈ Ioc (0:ℝ) 1 → 0 < Y → Y < Xi →
      w ∈ cStrip (ρ j) → ‖(s:ℂ) ^ m * gc j (s * Y) w‖ ≤ C j := by
    intro j m s Y w hs h0 h1 hw
    rw [norm_mul]
    calc ‖(s:ℂ) ^ m‖ * ‖gc j (s * Y) w‖ ≤ 1 * ‖gc j (s * Y) w‖ :=
          mul_le_mul_of_nonneg_right (F4 s hs m) (norm_nonneg _)
      _ ≤ C j := by
          rw [one_mul]
          exact (hhol j (s * Y) (F3 s hs Y h0 h1).1 (F3 s hs Y h0 h1).2).2 w hw
  refine ⟨fun k X w => ∫ s in (0:ℝ)..1, (s:ℂ) ^ k * gc k (s * X) w, ρ, C, hρ, ?_, ?_, ?_, ?_⟩
  ·
    intro k
    refine s2 (fun s p => (s:ℂ) ^ k * gc k (s * p.1) p.2) (Ioo 0 Xi ×ˢ cStrip (ρ k)) (C k)
      (fun s hs => ?_) (fun p hp => F5 k k p.1 p.2 hp.1.1 hp.1.2 hp.2)
      (fun s hs p hp => F6 k k s p.1 p.2 hs hp.1.1 hp.1.2 hp.2)
    apply continuousOn_const.mul
    have hmap : MapsTo (fun p : ℝ × ℂ => (s * p.1, p.2)) (Ioo 0 Xi ×ˢ cStrip (ρ k))
        (Ioo 0 Xi ×ˢ cStrip (ρ k)) :=
      fun p hp => ⟨F3 s hs p.1 hp.1.1 hp.1.2, hp.2⟩
    exact (hcont k).comp ((continuous_const.mul continuous_fst).prodMk continuous_snd).continuousOn
      hmap
  ·
    intro k X h0 h1
    refine ⟨s1 (fun s w => (s:ℂ) ^ k * gc k (s * X) w) (cStrip (ρ k)) (C k) (F1 _)
      (fun w hw => F5 k k X w h0 h1 hw)
      (fun s hs => ((hhol k (s * X) (F3 s hs X h0 h1).1 (F3 s hs X h0 h1).2).1.const_mul _))
      (fun s hs w hw => F6 k k s X w hs h0 h1 hw), fun w hw => ?_⟩
    have := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := 1) (C := C k)
      (f := fun s => (s:ℂ) ^ k * gc k (s * X) w)
      (fun s hs => F6 k k s X w (hmem s hs) h0 h1 hw)
    simpa using this
  ·
    intro k X w h0 h1 hw
    have hwk := F2 k hw
    refine s3 (fun s Y => (s:ℂ) ^ k * gc k (s * Y) w)
      (fun s Y => (s:ℂ) ^ (k + 1) * gc (k + 1) (s * Y) w) (Ioo 0 Xi) X (max (C k) (C (k + 1)))
      isOpen_Ioo ⟨h0, h1⟩ (fun Y hY => F5 k k Y w hY.1 hY.2 hwk) (F5 (k + 1) (k + 1) X w h0 h1 hw)
      (fun s hs Y hY => (F6 (k + 1) (k + 1) s Y w hs hY.1 hY.2 hw).trans (le_max_right _ _))
      (fun s hs => (F6 k k s X w hs h0 h1 hwk).trans (le_max_left _ _)) (fun s hs Y hY => ?_)
    have e1 := hcoh k (s * Y) w (F3 s hs Y hY.1 hY.2).1 (F3 s hs Y hY.1 hY.2).2 hw
    have e2 : HasDerivAt (fun Y : ℝ => s * Y) s Y := by
      simpa using (hasDerivAt_id Y).const_mul s
    have e3 : HasDerivAt (fun Y => (s:ℂ) ^ k * gc k (s * Y) w)
        ((s:ℂ) ^ k * ((s:ℂ) * gc (k + 1) (s * Y) w)) Y := by
      have := (e1.scomp Y e2).const_mul ((s:ℂ) ^ k)
      rw [Complex.real_smul] at this
      exact this
    show HasDerivAt (fun Y => (s:ℂ) ^ k * gc k (s * Y) w)
      ((s:ℂ) ^ (k + 1) * gc (k + 1) (s * Y) w) Y
    have e4 : (s:ℂ) ^ (k + 1) * gc (k + 1) (s * Y) w =
        (s:ℂ) ^ k * ((s:ℂ) * gc (k + 1) (s * Y) w) := by ring
    rw [e4]
    exact e3
  ·
    intro X η h0 h1 e1 e2
    show ∫ s in (0:ℝ)..1, (s:ℂ) ^ 0 * gc 0 (s * X) (η:ℂ) = ((profRadAvg g X η : ℝ) : ℂ)
    rw [intervalIntegral.integral_congr_ae (g := fun s => ((g (s * X) η : ℝ) : ℂ))
      (ae_of_all _ (fun s hs => by
        have := F3 s (hmem s hs) X h0 h1
        simp only [pow_zero, one_mul]
        exact hreal (s * X) η this.1 this.2 e1 e2))]
    rw [intervalIntegral.integral_ofReal]
    rfl

theorem bgHolo_complexify : ∀ (Xi : ℝ) (f : ℝ → ℝ → ℝ), 0 < Xi → BgHolo Xi f → ∃ (φ : ℝ → ℂ → ℂ) (ρ C : ℝ), 0 < ρ ∧ CB Xi ρ C φ ∧ (∀ j : ℕ, BgHoloC Xi j φ) ∧ ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 → φ X (η : ℂ) = ((f X η : ℝ) : ℂ) :=
by
  intro Xi f _ hH
  obtain ⟨fc, ρ, C, hB1, hB2, hB3, hB4, hB5⟩ := hH
  have hstrip : ∀ s t : ℝ, s ≤ t → cStrip s ⊆ cStrip t := by
    intro s t hst w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
  have hanti : Antitone ρ := antitone_nat_of_succ_le (fun k => (hB1 k).2)
  have hS : ∀ k j : ℕ, k ≤ j → cStrip (ρ j) ⊆ cStrip (ρ k) := fun k j hkj =>
    hstrip _ _ (hanti hkj)
  have KEY : ∀ k : ℕ, ∀ X : ℝ, ∀ w : ℂ, 0 < X → X < Xi → w ∈ cStrip (ρ k) →
      iteratedDeriv k (fun Y => fc 0 Y w) X = fc k X w := by
    intro k
    induction k with
    | zero =>
      intro X w _ _ _
      simp only [iteratedDeriv_zero]
    | succ k ih =>
      intro X w h0 h1 hw
      have hwk : w ∈ cStrip (ρ k) := hS k (k + 1) (Nat.le_succ k) hw
      have hev : iteratedDeriv k (fun Y => fc 0 Y w) =ᶠ[nhds X] fun Y => fc k Y w :=
        Filter.eventuallyEq_of_mem (Ioo_mem_nhds h0 h1) (fun Y hY => ih Y w hY.1 hY.2 hwk)
      rw [iteratedDeriv_succ, hev.deriv_eq]
      exact (hB4 k X w h0 h1 hw).deriv
  refine ⟨fc 0, ρ 0, C 0, (hB1 0).1,
    ⟨hB2 0, fun X h0 h1 => (hB3 0 X h0 h1).1, fun X w h0 h1 hw => (hB3 0 X h0 h1).2 w hw⟩,
    fun j => ?_, hB5⟩
  refine ⟨ρ j, ∑ i ∈ Finset.range (j + 1), |C i|, (hB1 j).1, fun k hkj => ?_⟩
  have hjk := hS k j hkj
  refine ⟨?_, fun X h0 h1 => ⟨?_, fun w hw => ?_⟩, fun hlt X w h0 h1 hw => ?_⟩
  · refine ((hB2 k).mono (Set.prod_mono subset_rfl hjk)).congr ?_
    intro p hp
    exact KEY k p.1 p.2 hp.1.1 hp.1.2 (hjk hp.2)
  · refine ((hB3 k X h0 h1).1.mono hjk).congr ?_
    intro w hw
    exact KEY k X w h0 h1 (hjk hw)
  · rw [KEY k X w h0 h1 (hjk hw)]
    calc ‖fc k X w‖ ≤ C k := (hB3 k X h0 h1).2 w (hjk hw)
      _ ≤ |C k| := le_abs_self _
      _ ≤ ∑ i ∈ Finset.range (j + 1), |C i| :=
        Finset.single_le_sum (fun i _ => abs_nonneg (C i))
          (Finset.mem_range.2 (Nat.lt_succ_of_le hkj))
  · have hw1 : w ∈ cStrip (ρ (k + 1)) := hS (k + 1) j hlt hw
    have hwk : w ∈ cStrip (ρ k) := hjk hw
    rw [KEY (k + 1) X w h0 h1 hw1]
    exact (hB4 k X w h0 h1 hw1).congr_of_eventuallyEq
      (Filter.eventuallyEq_of_mem (Ioo_mem_nhds h0 h1) (fun Y hY => KEY k Y w hY.1 hY.2 hwk))

theorem strip_cauchy_nagumo : ∀ (f : ℂ → ℂ) (σ₀ : ℝ), (∀ (s s' K : ℝ), s < s' → DifferentiableOn ℂ f (cStrip s') → (∀ z ∈ cStrip s', ‖f z‖ ≤ K) → ∀ w ∈ cStrip s, ‖deriv f w‖ ≤ K / (s' - s)) ∧ (∀ (K : ℝ) (m : ℕ), 0 < σ₀ → 0 ≤ K → DifferentiableOn ℂ f (cStrip σ₀) → (∀ (s : ℝ) (z : ℂ), 0 < s → s < σ₀ → z ∈ cStrip s → ‖f z‖ ≤ K / (σ₀ - s) ^ m) → ∀ (s : ℝ) (w : ℂ), 0 < s → s < σ₀ → w ∈ cStrip s → ‖deriv f w‖ ≤ 3 * ((m : ℝ) + 2) * K / (σ₀ - s) ^ (m + 1)) :=
by
  intro f σ₀
  have P1 : ∀ (s s' K : ℝ), s < s' → DifferentiableOn ℂ f (cStrip s') →
      (∀ z ∈ cStrip s', ‖f z‖ ≤ K) → ∀ w ∈ cStrip s, ‖deriv f w‖ ≤ K / (s' - s) := by
    intro s s' K hss' hd hb w hw
    have hr : 0 < s' - s := sub_pos.mpr hss'
    have hsub : Metric.closedBall w (s' - s) ⊆ cStrip s' := by
      intro z hz
      rw [Metric.mem_closedBall, dist_eq_norm] at hz
      have h1 := Complex.abs_im_le_norm (z - w)
      have h2 := Complex.abs_re_le_norm (z - w)
      rw [Complex.sub_im] at h1
      rw [Complex.sub_re] at h2
      simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
      obtain ⟨hw1, hw2, hw3⟩ := hw
      rw [abs_lt] at hw1 ⊢
      obtain ⟨h1a, h1b⟩ := abs_le.mp (h1.trans hz)
      obtain ⟨h2a, h2b⟩ := abs_le.mp (h2.trans hz)
      obtain ⟨hw1a, hw1b⟩ := hw1
      refine ⟨⟨by linarith, by linarith⟩, by linarith, by linarith⟩
    have hdc : DiffContOnCl ℂ f (Metric.ball w (s' - s)) := by
      apply DifferentiableOn.diffContOnCl
      rw [closure_ball w hr.ne']
      exact hd.mono hsub
    exact Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr hdc
      (fun z hz => hb z (hsub (Metric.sphere_subset_closedBall hz)))
  have hq3 : ∀ m : ℕ, (((m:ℝ) + 2) / ((m:ℝ) + 1)) ^ m ≤ 3 := by
    intro m
    have hm1 : (0:ℝ) < (m:ℝ) + 1 := by positivity
    have hqx : ((m:ℝ) + 2) / ((m:ℝ) + 1) = 1 / ((m:ℝ) + 1) + 1 := by
      field_simp; ring
    have hq0 : 0 ≤ ((m:ℝ) + 2) / ((m:ℝ) + 1) := by positivity
    have h1 : (((m:ℝ) + 2) / ((m:ℝ) + 1)) ^ m ≤ (Real.exp (1 / ((m:ℝ) + 1))) ^ m := by
      apply pow_le_pow_left₀ hq0
      rw [hqx]; exact Real.add_one_le_exp _
    rw [← Real.exp_nat_mul] at h1
    have h2 : (m:ℝ) * (1 / ((m:ℝ) + 1)) ≤ 1 := by
      rw [mul_one_div, div_le_one hm1]; linarith
    have h3 : Real.exp ((m:ℝ) * (1 / ((m:ℝ) + 1))) ≤ Real.exp 1 := Real.exp_le_exp.mpr h2
    have h4 := Real.exp_one_lt_d9
    have h5 : Real.exp 1 < 3 := lt_trans h4 (by norm_num)
    linarith
  refine ⟨P1, ?_⟩
  intro K m hσ₀ hK hd hyp s w hs0 hsσ hw
  have hD : 0 < σ₀ - s := sub_pos.mpr hsσ
  have hDne : σ₀ - s ≠ 0 := hD.ne'
  have hm2 : (0:ℝ) < (m:ℝ) + 2 := by positivity
  have hm1 : (0:ℝ) < (m:ℝ) + 1 := by positivity
  have hm2ne : (m:ℝ) + 2 ≠ 0 := hm2.ne'
  have hm1ne : (m:ℝ) + 1 ≠ 0 := hm1.ne'
  have hδ : 0 < (σ₀ - s) / ((m:ℝ) + 2) := div_pos hD hm2
  have hδlt : (σ₀ - s) / ((m:ℝ) + 2) < σ₀ - s := by
    rw [div_lt_iff₀ hm2]; nlinarith [mul_pos hD hm1]
  obtain ⟨s', hs'⟩ : ∃ s' : ℝ, s' = s + (σ₀ - s) / ((m:ℝ) + 2) := ⟨_, rfl⟩
  have hss' : s < s' := by rw [hs']; linarith
  have hs'σ : s' < σ₀ := by rw [hs']; linarith
  have hs'0 : 0 < s' := by linarith
  have hsub : cStrip s' ⊆ cStrip σ₀ := by
    intro z hz
    simp only [cStrip, Set.mem_setOf_eq] at hz ⊢
    obtain ⟨a, b, c⟩ := hz
    exact ⟨by linarith, by linarith, by linarith⟩
  have key := P1 s s' (K / (σ₀ - s') ^ m) hss' (hd.mono hsub)
    (fun z hz => hyp s' z hs'0 hs'σ hz) w hw
  have e1 : σ₀ - s' = (σ₀ - s) * ((m:ℝ) + 1) / ((m:ℝ) + 2) := by
    rw [hs']; field_simp; ring
  have e2 : s' - s = (σ₀ - s) / ((m:ℝ) + 2) := by rw [hs']; ring
  rw [e1, e2] at key
  have eq : K / ((σ₀ - s) * ((m:ℝ) + 1) / ((m:ℝ) + 2)) ^ m / ((σ₀ - s) / ((m:ℝ) + 2)) =
      (((m:ℝ) + 2) / ((m:ℝ) + 1)) ^ m * (((m:ℝ) + 2) * K / (σ₀ - s) ^ (m + 1)) := by
    have gen : ∀ D a b : ℝ, D ≠ 0 → a ≠ 0 → b ≠ 0 →
        K / (D * a / b) ^ m / (D / b) = (b / a) ^ m * (b * K / D ^ (m + 1)) := by
      intro D a b hD0 ha0 hb0
      have hDm : D ^ m ≠ 0 := pow_ne_zero _ hD0
      have ham : a ^ m ≠ 0 := pow_ne_zero _ ha0
      have hbm : b ^ m ≠ 0 := pow_ne_zero _ hb0
      rw [div_pow, mul_pow, div_pow, pow_succ]
      field_simp <;> ring
    exact gen _ _ _ hDne hm1ne hm2ne
  rw [eq] at key
  have hE : 0 ≤ ((m:ℝ) + 2) * K / (σ₀ - s) ^ (m + 1) :=
    div_nonneg (mul_nonneg hm2.le hK) (pow_pos hD _).le
  calc ‖deriv f w‖ ≤ _ := key
    _ ≤ 3 * (((m:ℝ) + 2) * K / (σ₀ - s) ^ (m + 1)) := mul_le_mul_of_nonneg_right (hq3 m) hE
    _ = 3 * ((m : ℝ) + 2) * K / (σ₀ - s) ^ (m + 1) := by ring

theorem creg_algebra : ∀ (Xi σ σ' A : ℝ) (φ χ : ℝ → ℂ → ℂ), (CB Xi σ A φ → CReg Xi σ φ) ∧ (CReg Xi σ φ → σ' ≤ σ → CReg Xi σ' φ) ∧ (CReg Xi σ φ → CReg Xi σ χ → CReg Xi σ (fun X w => φ X w + χ X w) ∧ CReg Xi σ (fun X w => φ X w * χ X w)) ∧ CReg Xi σ (fun X _ => ((X : ℝ) : ℂ)) :=
by
  intro Xi σ σ' A φ χ
  have hstrip : ∀ s t : ℝ, s ≤ t → cStrip s ⊆ cStrip t := by
    intro s t hst w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
  refine ⟨?_, ?_, ?_, ?_⟩
  · rintro ⟨h1, h2, h3⟩
    exact ⟨h1, h2, fun s hs => ⟨A, fun X w h0 h1' hw => h3 X w h0 h1' (hstrip s σ hs.le hw)⟩⟩
  · rintro ⟨h1, h2, h3⟩ hle
    exact ⟨h1.mono (Set.prod_mono subset_rfl (hstrip σ' σ hle)),
      fun X a b => (h2 X a b).mono (hstrip σ' σ hle),
      fun s hs => h3 s (lt_of_lt_of_le hs hle)⟩
  · rintro ⟨a1, a2, a3⟩ ⟨b1, b2, b3⟩
    refine ⟨⟨a1.add b1, fun X h0 h1 => (a2 X h0 h1).add (b2 X h0 h1), ?_⟩,
      ⟨a1.mul b1, fun X h0 h1 => (a2 X h0 h1).mul (b2 X h0 h1), ?_⟩⟩
    · intro s hs
      obtain ⟨C1, hC1⟩ := a3 s hs
      obtain ⟨C2, hC2⟩ := b3 s hs
      refine ⟨C1 + C2, fun X w h0 h1 hw => ?_⟩
      exact (norm_add_le _ _).trans (add_le_add (hC1 X w h0 h1 hw) (hC2 X w h0 h1 hw))
    · intro s hs
      obtain ⟨C1, hC1⟩ := a3 s hs
      obtain ⟨C2, hC2⟩ := b3 s hs
      refine ⟨|C1| * |C2|, fun X w h0 h1 hw => ?_⟩
      rw [norm_mul]
      exact mul_le_mul ((hC1 X w h0 h1 hw).trans (le_abs_self C1))
        ((hC2 X w h0 h1 hw).trans (le_abs_self C2)) (norm_nonneg _) (abs_nonneg C1)
  · refine ⟨(Complex.continuous_ofReal.comp continuous_fst).continuousOn,
      fun X _ _ => differentiableOn_const _, fun s _ => ⟨Xi, fun X w h0 h1 _ => ?_⟩⟩
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos h0]
    exact h1.le

theorem bg_creg_ops : ∀ (Xi σ : ℝ) (φ : ℝ → ℂ → ℂ), 0 < Xi → 0 < σ → CReg Xi σ φ → CReg Xi σ (cDw φ) ∧ CReg Xi σ (cRad φ) ∧ ∀ kk : ℝ → ℝ, (kk = bgkG ∨ kk = bgkGp ∨ kk = bgkU ∨ kk = bgkUp ∨ kk = bgkS) → CReg Xi σ (cKer kk φ) :=
by
  intro Xi σ φ hXi hσ hφ

  have hopen : ∀ ρ : ℝ, IsOpen (cStrip ρ) := by
    intro ρ
    have e : cStrip ρ = ({w : ℂ | |w.im| < ρ} ∩ {w : ℂ | -1 - ρ < w.re}) ∩ {w : ℂ | w.re < 1 + ρ} := by
      ext w
      simp only [cStrip, mem_inter_iff, mem_setOf_eq, and_assoc]
    rw [e]
    exact ((isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).inter
      (isOpen_lt continuous_const Complex.continuous_re)).inter
      (isOpen_lt Complex.continuous_re continuous_const)
  have hmono : ∀ s t : ℝ, s ≤ t → cStrip s ⊆ cStrip t := by
    intro s t hst w hw
    simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
    exact ⟨by linarith [hw.1], by linarith [hw.2.1], by linarith [hw.2.2]⟩
  have hball : ∀ (s r : ℝ) (w z : ℂ), w ∈ cStrip s → dist z w ≤ r → z ∈ cStrip (s + r) := by
    intro s r w z hw hd
    simp only [cStrip, mem_setOf_eq] at hw ⊢
    rw [Complex.dist_eq] at hd
    have h1 := Complex.abs_re_le_norm (z - w)
    have h2 := Complex.abs_im_le_norm (z - w)
    rw [Complex.sub_re] at h1
    rw [Complex.sub_im] at h2
    have a1 := abs_le.mp (h1.trans hd)
    have a2 := abs_le.mp (h2.trans hd)
    obtain ⟨hw1, hw2, hw3⟩ := hw
    have a3 := abs_lt.mp hw1
    exact ⟨abs_lt.mpr ⟨by linarith, by linarith⟩, by linarith, by linarith⟩
  have hloc : ∀ (s : ℝ) (w : ℂ), w ∈ cStrip s → ∃ t : ℝ, t < s ∧ w ∈ cStrip t := by
    intro s w hw
    simp only [cStrip, mem_setOf_eq] at hw
    obtain ⟨h1, h2, h3⟩ := hw
    have hre : |w.re| < 1 + s := abs_lt.mpr ⟨by linarith, by linarith⟩
    have hm : max |w.im| (|w.re| - 1) < s := max_lt h1 (by linarith)
    have hm1 := le_max_left |w.im| (|w.re| - 1)
    have hm2 := le_max_right |w.im| (|w.re| - 1)
    refine ⟨(max |w.im| (|w.re| - 1) + s) / 2, by linarith, ?_⟩
    have hre' := abs_lt.mp (show |w.re| < 1 + (max |w.im| (|w.re| - 1) + s) / 2 by linarith)
    simp only [cStrip, mem_setOf_eq]
    exact ⟨by linarith, by linarith, by linarith⟩

  have hcauchy : ∀ (f : ℂ → ℂ) (U : Set ℂ) (w : ℂ) (r M : ℝ), 0 < r → DifferentiableOn ℂ f U →
      Metric.closedBall w r ⊆ U → (∀ z ∈ Metric.sphere w r, ‖f z‖ ≤ M) → ‖deriv f w‖ ≤ M / r := by
    intro f U w r M hr hf hsub hb
    refine Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr ?_ hb
    apply DifferentiableOn.diffContOnCl
    rw [closure_ball w hr.ne']
    exact hf.mono hsub
  obtain ⟨R1, R2, R3⟩ := hφ

  have hD : CReg Xi σ (cDw φ) := by
    refine ⟨?_, fun X h0 h1 => (R2 X h0 h1).deriv (hopen σ), ?_⟩
    · intro p hp
      apply ContinuousAt.continuousWithinAt
      obtain ⟨X₀, w₀⟩ := p
      obtain ⟨⟨hX0, hX1⟩, hw₀⟩ := hp
      obtain ⟨t₀, ht₀, hwt₀⟩ := hloc σ w₀ hw₀
      obtain ⟨r, hr_def⟩ : ∃ r : ℝ, r = (σ - t₀) / 3 := ⟨_, rfl⟩
      have hr : 0 < r := by rw [hr_def]; linarith
      have hr2 : t₀ + 2 * r ≤ σ := by rw [hr_def]; linarith
      obtain ⟨δ₀, hδ₀_def⟩ : ∃ δ₀ : ℝ, δ₀ = min X₀ (Xi - X₀) / 2 := ⟨_, rfl⟩
      have hδ₀ : 0 < δ₀ := by rw [hδ₀_def]; exact half_pos (lt_min hX0 (by linarith))
      have hδ₀1 : δ₀ ≤ X₀ / 2 := by
        rw [hδ₀_def]; linarith [min_le_left X₀ (Xi - X₀)]
      have hδ₀2 : δ₀ ≤ (Xi - X₀) / 2 := by
        rw [hδ₀_def]; linarith [min_le_right X₀ (Xi - X₀)]
      have hBU : Metric.closedBall w₀ (2 * r) ⊆ cStrip σ := fun z hz =>
        hmono _ _ hr2 (hball t₀ (2 * r) w₀ z hwt₀ (Metric.mem_closedBall.mp hz))
      have hKc : IsCompact (Icc (X₀ - δ₀) (X₀ + δ₀) ×ˢ Metric.closedBall w₀ (2 * r)) :=
        isCompact_Icc.prod (isCompact_closedBall _ _)
      have hKsub : Icc (X₀ - δ₀) (X₀ + δ₀) ×ˢ Metric.closedBall w₀ (2 * r) ⊆ Ioo 0 Xi ×ˢ cStrip σ := by
        rintro ⟨X, z⟩ ⟨⟨h1, h2⟩, hz⟩
        exact ⟨⟨by linarith, by linarith⟩, hBU hz⟩
      have hUC := hKc.uniformContinuousOn_of_continuous (R1.mono hKsub)
      rw [Metric.uniformContinuousOn_iff] at hUC
      have hg : ContinuousAt (deriv (φ X₀)) w₀ :=
        ((R2 X₀ hX0 hX1).deriv (hopen σ)).continuousOn.continuousAt ((hopen σ).mem_nhds hw₀)
      rw [Metric.continuousAt_iff]
      intro ε hε
      obtain ⟨δ₁, hδ₁, hg'⟩ := Metric.continuousAt_iff.mp hg (ε / 2) (by linarith)
      obtain ⟨δ₂, hδ₂, hu⟩ := hUC (ε * r / 2) (by positivity)
      refine ⟨min (min δ₀ δ₁) (min δ₂ r), lt_min (lt_min hδ₀ hδ₁) (lt_min hδ₂ hr), ?_⟩
      rintro ⟨X, w⟩ hd
      rw [Prod.dist_eq, max_lt_iff] at hd
      obtain ⟨hdX, hdw⟩ := hd
      simp only at hdX hdw
      have hdX0 : dist X X₀ < δ₀ := lt_of_lt_of_le hdX ((min_le_left _ _).trans (min_le_left _ _))
      have hdX2 : dist X X₀ < δ₂ := lt_of_lt_of_le hdX ((min_le_right _ _).trans (min_le_left _ _))
      have hdw1 : dist w w₀ < δ₁ := lt_of_lt_of_le hdw ((min_le_left _ _).trans (min_le_right _ _))
      have hdwr : dist w w₀ < r := lt_of_lt_of_le hdw ((min_le_right _ _).trans (min_le_right _ _))
      rw [Real.dist_eq] at hdX0
      have hXa := abs_lt.mp hdX0
      have hX0' : 0 < X := by linarith
      have hX1' : X < Xi := by linarith
      have hwU : w ∈ cStrip σ := hBU (Metric.mem_closedBall.mpr (by linarith))
      have hsub : Metric.closedBall w r ⊆ Metric.closedBall w₀ (2 * r) := by
        intro z hz
        rw [Metric.mem_closedBall] at hz ⊢
        linarith [dist_triangle z w w₀]
      have hdiff : DifferentiableOn ℂ (fun z => φ X z - φ X₀ z) (cStrip σ) :=
        (R2 X hX0' hX1').sub (R2 X₀ hX0 hX1)
      have hsph : ∀ z ∈ Metric.sphere w r, ‖φ X z - φ X₀ z‖ ≤ ε * r / 2 := by
        intro z hz
        have hz' : z ∈ Metric.closedBall w₀ (2 * r) := hsub (Metric.sphere_subset_closedBall hz)
        have hm1 : ((X, z) : ℝ × ℂ) ∈ Icc (X₀ - δ₀) (X₀ + δ₀) ×ˢ Metric.closedBall w₀ (2 * r) :=
          ⟨⟨by linarith, by linarith⟩, hz'⟩
        have hm2 : ((X₀, z) : ℝ × ℂ) ∈ Icc (X₀ - δ₀) (X₀ + δ₀) ×ˢ Metric.closedBall w₀ (2 * r) :=
          ⟨⟨by linarith, by linarith⟩, hz'⟩
        have hdd : dist ((X, z) : ℝ × ℂ) (X₀, z) < δ₂ := by
          rw [Prod.dist_eq, dist_self]
          simp only
          rw [max_eq_left dist_nonneg]
          exact hdX2
        have := hu _ hm1 _ hm2 hdd
        simp only at this
        rw [dist_eq_norm] at this
        exact this.le
      have hcd := hcauchy (fun z => φ X z - φ X₀ z) (cStrip σ) w r (ε * r / 2) hr hdiff
        (hsub.trans hBU) hsph
      have hda : DifferentiableAt ℂ (φ X) w := (R2 X hX0' hX1').differentiableAt ((hopen σ).mem_nhds hwU)
      have hdb : DifferentiableAt ℂ (φ X₀) w := (R2 X₀ hX0 hX1).differentiableAt ((hopen σ).mem_nhds hwU)
      rw [deriv_fun_sub hda hdb] at hcd
      have e : ε * r / 2 / r = ε / 2 := by field_simp
      rw [e] at hcd
      have hg2 := hg' hdw1
      rw [dist_eq_norm] at hg2
      show dist (deriv (φ X) w) (deriv (φ X₀) w₀) < ε
      rw [dist_eq_norm]
      have := norm_sub_le_norm_sub_add_norm_sub (deriv (φ X) w) (deriv (φ X₀) w) (deriv (φ X₀) w₀)
      linarith
    · intro s hs
      obtain ⟨C, hC⟩ := R3 ((s + σ) / 2) (by linarith)
      refine ⟨C / ((σ - s) / 2), fun X w h0 h1 hw => ?_⟩
      show ‖deriv (φ X) w‖ ≤ _
      refine hcauchy (φ X) (cStrip σ) w ((σ - s) / 2) C (by linarith) (R2 X h0 h1) ?_ ?_
      · intro z hz
        exact hmono _ _ (by linarith) (hball s _ w z hw (Metric.mem_closedBall.mp hz))
      · intro z hz
        have h := hball s ((σ - s) / 2) w z hw (le_of_eq (Metric.mem_sphere.mp hz))
        rw [show s + (σ - s) / 2 = (s + σ) / 2 by ring] at h
        exact hC X z h0 h1 h

  have huIoc : uIoc (0:ℝ) 1 = Ioc 0 1 := uIoc_of_le zero_le_one
  have htX : ∀ X t : ℝ, 0 < X → X < Xi → t ∈ Ioc (0:ℝ) 1 → 0 < t * X ∧ t * X < Xi :=
    fun X t h0 h1 ht => ⟨mul_pos ht.1 h0, lt_of_le_of_lt (mul_le_of_le_one_left h0.le ht.2) h1⟩
  have hker : ∀ (kk : ℝ → ℝ) (ψ : ℝ → ℂ → ℂ), ContinuousOn kk (Ioc 0 1) →
      IntervalIntegrable kk volume 0 1 → CReg Xi σ ψ → CReg Xi σ (cDw ψ) → CReg Xi σ (cKer kk ψ) := by
    intro kk ψ hkc hki hψ hDψ
    obtain ⟨P1, P2, P3⟩ := hψ
    obtain ⟨D1, D2, D3⟩ := hDψ
    have hmeas : ∀ χ : ℝ → ℂ → ℂ, ContinuousOn (fun p : ℝ × ℂ => χ p.1 p.2) (Ioo 0 Xi ×ˢ cStrip σ) →
        ∀ X w, 0 < X → X < Xi → w ∈ cStrip σ →
        AEStronglyMeasurable (fun t : ℝ => ((kk t : ℝ) : ℂ) * χ (t * X) w) (volume.restrict (uIoc 0 1)) := by
      intro χ hχ X w h0 h1 hw
      rw [huIoc]
      have hmap : MapsTo (fun t : ℝ => ((t * X, w) : ℝ × ℂ)) (Ioc 0 1) (Ioo 0 Xi ×ˢ cStrip σ) :=
        fun t ht => ⟨⟨(htX X t h0 h1 ht).1, (htX X t h0 h1 ht).2⟩, hw⟩
      have hc : ContinuousOn (fun t : ℝ => ((kk t : ℝ) : ℂ) * χ (t * X) w) (Ioc 0 1) :=
        (Complex.continuous_ofReal.comp_continuousOn hkc).mul
          (hχ.comp ((continuous_id.mul continuous_const).prodMk continuous_const).continuousOn hmap)
      exact hc.aestronglyMeasurable measurableSet_Ioc
    have hbound : ∀ (χ : ℝ → ℂ → ℂ) (s C : ℝ),
        (∀ X w, 0 < X → X < Xi → w ∈ cStrip s → ‖χ X w‖ ≤ C) →
        ∀ X w t, 0 < X → X < Xi → w ∈ cStrip s → t ∈ Ioc (0:ℝ) 1 →
        ‖((kk t : ℝ) : ℂ) * χ (t * X) w‖ ≤ ‖kk t‖ * max C 0 := by
      intro χ s C hC X w t h0 h1 hw ht
      rw [norm_mul, Complex.norm_real]
      exact mul_le_mul_of_nonneg_left
        ((hC _ w (htX X t h0 h1 ht).1 (htX X t h0 h1 ht).2 hw).trans (le_max_left _ _)) (norm_nonneg _)
    have hbi : ∀ C : ℝ, IntervalIntegrable (fun t => ‖kk t‖ * max C 0) volume 0 1 :=
      fun C => hki.norm.mul_const _
    refine ⟨?_, ?_, ?_⟩
    · intro p hp
      apply ContinuousAt.continuousWithinAt
      obtain ⟨X₀, w₀⟩ := p
      obtain ⟨⟨hX0, hX1⟩, hw₀⟩ := hp
      obtain ⟨t₀, ht₀, hwt₀⟩ := hloc σ w₀ hw₀
      obtain ⟨C, hC⟩ := P3 (t₀ + (σ - t₀) / 2) (by linarith)
      have hballS : ∀ z ∈ Metric.ball w₀ ((σ - t₀) / 2), z ∈ cStrip (t₀ + (σ - t₀) / 2) :=
        fun z hz => hball t₀ _ w₀ z hwt₀ (Metric.mem_ball.mp hz).le
      have hSU : cStrip (t₀ + (σ - t₀) / 2) ⊆ cStrip σ := hmono _ _ (by linarith)
      have hN : Ioo 0 Xi ×ˢ Metric.ball w₀ ((σ - t₀) / 2) ∈ nhds ((X₀, w₀) : ℝ × ℂ) :=
        (isOpen_Ioo.prod Metric.isOpen_ball).mem_nhds ⟨⟨hX0, hX1⟩, Metric.mem_ball_self (by linarith)⟩
      have a1 : ∀ᶠ q in nhds ((X₀, w₀) : ℝ × ℂ), AEStronglyMeasurable
          (fun t : ℝ => ((kk t : ℝ) : ℂ) * ψ (t * q.1) q.2) (volume.restrict (uIoc 0 1)) := by
        filter_upwards [hN] with q hq
        exact hmeas ψ P1 q.1 q.2 hq.1.1 hq.1.2 (hSU (hballS q.2 hq.2))
      have a2 : ∀ᶠ q in nhds ((X₀, w₀) : ℝ × ℂ), ∀ᵐ t ∂volume, t ∈ uIoc (0:ℝ) 1 →
          ‖((kk t : ℝ) : ℂ) * ψ (t * q.1) q.2‖ ≤ ‖kk t‖ * max C 0 := by
        filter_upwards [hN] with q hq
        refine ae_of_all _ fun t ht => ?_
        rw [huIoc] at ht
        exact hbound ψ _ C hC q.1 q.2 t hq.1.1 hq.1.2 (hballS q.2 hq.2) ht
      have a4 : ∀ᵐ t ∂volume, t ∈ uIoc (0:ℝ) 1 →
          ContinuousAt (fun q : ℝ × ℂ => ((kk t : ℝ) : ℂ) * ψ (t * q.1) q.2) (X₀, w₀) := by
        refine ae_of_all _ fun t ht => ?_
        rw [huIoc] at ht
        have hpt : ((t * X₀, w₀) : ℝ × ℂ) ∈ Ioo 0 Xi ×ˢ cStrip σ :=
          ⟨⟨(htX X₀ t hX0 hX1 ht).1, (htX X₀ t hX0 hX1 ht).2⟩, hw₀⟩
        have hca : ContinuousAt (fun p : ℝ × ℂ => ψ p.1 p.2) (t * X₀, w₀) :=
          P1.continuousAt ((isOpen_Ioo.prod (hopen σ)).mem_nhds hpt)
        have hin : ContinuousAt (fun q : ℝ × ℂ => ((t * q.1, q.2) : ℝ × ℂ)) (X₀, w₀) :=
          ((continuous_const.mul continuous_fst).prodMk continuous_snd).continuousAt
        exact continuousAt_const.mul (ContinuousAt.comp_of_eq hca hin rfl)
      have hI := intervalIntegral.continuousAt_of_dominated_interval a1 a2 (hbi C) a4
      have hX : ContinuousAt (fun q : ℝ × ℂ => ((q.1 : ℝ) : ℂ)) (X₀, w₀) :=
        (Complex.continuous_ofReal.comp continuous_fst).continuousAt
      exact hX.mul hI
    · intro X h0 h1 w₀ hw₀
      apply DifferentiableAt.differentiableWithinAt
      obtain ⟨t₀, ht₀, hwt₀⟩ := hloc σ w₀ hw₀
      obtain ⟨C, hC⟩ := P3 (t₀ + (σ - t₀) / 2) (by linarith)
      obtain ⟨D, hD'⟩ := D3 (t₀ + (σ - t₀) / 2) (by linarith)
      have hballS : ∀ z ∈ Metric.ball w₀ ((σ - t₀) / 2), z ∈ cStrip (t₀ + (σ - t₀) / 2) :=
        fun z hz => hball t₀ _ w₀ z hwt₀ (Metric.mem_ball.mp hz).le
      have hSU : cStrip (t₀ + (σ - t₀) / 2) ⊆ cStrip σ := hmono _ _ (by linarith)
      have hs : Metric.ball w₀ ((σ - t₀) / 2) ∈ nhds w₀ := Metric.ball_mem_nhds _ (by linarith)
      have b1 : ∀ᶠ w in nhds w₀, AEStronglyMeasurable
          (fun t : ℝ => ((kk t : ℝ) : ℂ) * ψ (t * X) w) (volume.restrict (uIoc 0 1)) := by
        filter_upwards [hs] with w hw
        exact hmeas ψ P1 X w h0 h1 (hSU (hballS w hw))
      have b2 : IntervalIntegrable (fun t : ℝ => ((kk t : ℝ) : ℂ) * ψ (t * X) w₀) volume 0 1 := by
        refine (hbi C).mono_fun' (hmeas ψ P1 X w₀ h0 h1 hw₀) ?_
        rw [huIoc]
        refine (ae_restrict_iff' measurableSet_Ioc).mpr (ae_of_all _ fun t ht => ?_)
        exact hbound ψ _ C hC X w₀ t h0 h1 (hballS w₀ (Metric.mem_ball_self (by linarith))) ht
      have b3 : AEStronglyMeasurable (fun t : ℝ => ((kk t : ℝ) : ℂ) * cDw ψ (t * X) w₀)
          (volume.restrict (uIoc 0 1)) := hmeas (cDw ψ) D1 X w₀ h0 h1 hw₀
      have b4 : ∀ᵐ t ∂volume, t ∈ uIoc (0:ℝ) 1 → ∀ w ∈ Metric.ball w₀ ((σ - t₀) / 2),
          ‖((kk t : ℝ) : ℂ) * cDw ψ (t * X) w‖ ≤ ‖kk t‖ * max D 0 := by
        refine ae_of_all _ fun t ht w hw => ?_
        rw [huIoc] at ht
        exact hbound (cDw ψ) _ D hD' X w t h0 h1 (hballS w hw) ht
      have b6 : ∀ᵐ t ∂volume, t ∈ uIoc (0:ℝ) 1 → ∀ w ∈ Metric.ball w₀ ((σ - t₀) / 2),
          HasDerivAt (fun w => ((kk t : ℝ) : ℂ) * ψ (t * X) w) (((kk t : ℝ) : ℂ) * cDw ψ (t * X) w) w := by
        refine ae_of_all _ fun t ht w hw => ?_
        rw [huIoc] at ht
        have htX' := htX X t h0 h1 ht
        have hd : DifferentiableAt ℂ (ψ (t * X)) w :=
          (P2 (t * X) htX'.1 htX'.2).differentiableAt ((hopen σ).mem_nhds (hSU (hballS w hw)))
        exact hd.hasDerivAt.const_mul _
      have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
        (𝕜 := ℂ) (μ := volume) hs b1 b2 b3 b4 (hbi D) b6
      exact key.2.differentiableAt.const_mul ((X : ℝ) : ℂ)
    · intro s hs
      obtain ⟨C, hC⟩ := P3 s hs
      refine ⟨Xi * ∫ t in (0:ℝ)..1, ‖kk t‖ * max C 0, fun X w h0 h1 hw => ?_⟩
      have hI : ‖∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * ψ (t * X) w‖ ≤ ∫ t in (0:ℝ)..1, ‖kk t‖ * max C 0 :=
        intervalIntegral.norm_integral_le_of_norm_le zero_le_one
          (ae_of_all _ fun t ht => hbound ψ s C hC X w t h0 h1 hw ht) (hbi C)
      have hnn : 0 ≤ ∫ t in (0:ℝ)..1, ‖kk t‖ * max C 0 :=
        intervalIntegral.integral_nonneg zero_le_one
          (fun t _ => mul_nonneg (norm_nonneg _) (le_max_right _ _))
      show ‖((X : ℝ) : ℂ) * ∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * ψ (t * X) w‖ ≤ _
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg h0.le]
      exact mul_le_mul h1.le hI (norm_nonneg _) (by linarith)

  have hlogc : ContinuousOn Real.log (Ioc (0:ℝ) 1) :=
    Real.continuousOn_log.mono (fun t ht => by
      simp only [mem_compl_iff, mem_singleton_iff]; exact ht.1.ne')
  have hkern : ∀ kk : ℝ → ℝ, (kk = bgkG ∨ kk = bgkGp ∨ kk = bgkU ∨ kk = bgkUp ∨ kk = bgkS ∨
      kk = fun _ => (1:ℝ)) → ContinuousOn kk (Ioc 0 1) ∧ IntervalIntegrable kk volume 0 1 := by
    intro kk hk
    rcases hk with rfl | rfl | rfl | rfl | rfl | rfl
    · have hc : Continuous bgkG := by
        show Continuous (fun t : ℝ => (1 - t) / 2)
        fun_prop
      exact ⟨hc.continuousOn, hc.intervalIntegrable 0 1⟩
    · have hc : Continuous bgkGp := by
        show Continuous (fun t : ℝ => t / 2)
        fun_prop
      exact ⟨hc.continuousOn, hc.intervalIntegrable 0 1⟩
    · refine ⟨?_, ?_⟩
      · show ContinuousOn (fun t : ℝ => -Real.log t / 2) (Ioc 0 1)
        exact hlogc.neg.div_const 2
      · show IntervalIntegrable (fun t : ℝ => -Real.log t / 2) volume 0 1
        exact intervalIntegral.intervalIntegrable_log'.neg.div_const 2
    · have hc : Continuous bgkUp := by
        show Continuous (fun _ : ℝ => (1:ℝ) / 2)
        fun_prop
      exact ⟨hc.continuousOn, hc.intervalIntegrable 0 1⟩
    · refine ⟨?_, ?_⟩
      · show ContinuousOn (fun t : ℝ => (t - 1 - Real.log t) / 2) (Ioc 0 1)
        exact ((continuousOn_id.sub continuousOn_const).sub hlogc).div_const 2
      · show IntervalIntegrable (fun t : ℝ => (t - 1 - Real.log t) / 2) volume 0 1
        exact (((continuous_id.sub continuous_const).intervalIntegrable 0 1).sub
          intervalIntegral.intervalIntegrable_log').div_const 2
    · exact ⟨continuousOn_const, intervalIntegrable_const⟩

  have hradeq : ∀ (X : ℝ) (w : ℂ), 0 < X → cRad φ X w = cKer (fun _ => (1:ℝ)) φ X w := by
    intro X w hX
    simp only [cRad, cKer, Complex.ofReal_one, one_mul]
    have h := intervalIntegral.integral_comp_mul_right (fun x => φ x w) hX.ne' (a := 0) (b := 1)
    simp only [zero_mul, one_mul] at h
    rw [h, Complex.real_smul, Complex.ofReal_inv, ← mul_assoc,
      mul_inv_cancel₀ (Complex.ofReal_ne_zero.mpr hX.ne'), one_mul]

  have hφ : CReg Xi σ φ := ⟨R1, R2, R3⟩
  refine ⟨hD, ?_, ?_⟩
  · obtain ⟨hc1, hi1⟩ := hkern (fun _ => (1:ℝ)) (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl)))))
    obtain ⟨H1, H2, H3⟩ := hker _ φ hc1 hi1 hφ hD
    refine ⟨H1.congr (fun p hp => hradeq p.1 p.2 hp.1.1), fun X h0 h1 => ?_, fun s hs => ?_⟩
    · have e : cRad φ X = cKer (fun _ => (1:ℝ)) φ X := funext fun w => hradeq X w h0
      rw [e]
      exact H2 X h0 h1
    · obtain ⟨C, hC⟩ := H3 s hs
      exact ⟨C, fun X w h0 h1 hw => by rw [hradeq X w h0]; exact hC X w h0 h1 hw⟩
  · intro kk hk
    have hk' : kk = bgkG ∨ kk = bgkGp ∨ kk = bgkU ∨ kk = bgkUp ∨ kk = bgkS ∨ kk = fun _ => (1:ℝ) := by
      rcases hk with h | h | h | h | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (Or.inl h))
      · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
      · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))
    obtain ⟨hc, hi⟩ := hkern kk hk'
    exact hker kk φ hc hi hφ hD

theorem bgT_creg : ∀ (Xi σ : ℝ) (ac : Fin 6 → ℝ → ℂ → ℂ) (bc : Fin 8 → ℝ → ℂ → ℂ) (gc ψ1 ψ2 : ℝ → ℂ → ℂ), 0 < Xi → 0 < σ → (∀ i, CReg Xi σ (ac i)) → (∀ i, CReg Xi σ (bc i)) → CReg Xi σ gc → CReg Xi σ ψ1 → CReg Xi σ ψ2 → CReg Xi σ (bgT1 ac ψ1 ψ2) ∧ CReg Xi σ (bgT2 bc gc ψ1 ψ2) :=
by
  intro Xi σ ac bc gc ψ1 ψ2 hXi hσ hac hbc hgc hψ1 hψ2
  have hadd : ∀ φ χ : ℝ → ℂ → ℂ, CReg Xi σ φ → CReg Xi σ χ →
      CReg Xi σ (fun X w => φ X w + χ X w) :=
    fun φ χ h1 h2 => ((creg_algebra Xi σ σ 0 φ χ).2.2.1 h1 h2).1
  have hmul : ∀ φ χ : ℝ → ℂ → ℂ, CReg Xi σ φ → CReg Xi σ χ →
      CReg Xi σ (fun X w => φ X w * χ X w) :=
    fun φ χ h1 h2 => ((creg_algebra Xi σ σ 0 φ χ).2.2.1 h1 h2).2
  have hX : CReg Xi σ (fun X (_ : ℂ) => ((X : ℝ) : ℂ)) :=
    (creg_algebra Xi σ σ 0 (fun _ _ => 0) (fun _ _ => 0)).2.2.2
  have hops : ∀ φ : ℝ → ℂ → ℂ, CReg Xi σ φ → CReg Xi σ (cDw φ) ∧ CReg Xi σ (cRad φ) ∧
      ∀ kk : ℝ → ℝ, (kk = bgkG ∨ kk = bgkGp ∨ kk = bgkU ∨ kk = bgkUp ∨ kk = bgkS) →
        CReg Xi σ (cKer kk φ) :=
    fun φ hφ => bg_creg_ops Xi σ φ hXi hσ hφ
  have d1 : CReg Xi σ (cDw ψ1) := (hops ψ1 hψ1).1
  have d2 : CReg Xi σ (cDw ψ2) := (hops ψ2 hψ2).1
  have dg : CReg Xi σ (cDw gc) := (hops gc hgc).1
  have k1 : CReg Xi σ (cKer bgkG ψ1) := (hops ψ1 hψ1).2.2 bgkG (Or.inl rfl)
  have k2 : CReg Xi σ (cKer bgkGp ψ1) := (hops ψ1 hψ1).2.2 bgkGp (Or.inr (Or.inl rfl))
  have k3 : CReg Xi σ (cKer bgkG (cDw ψ1)) := (hops _ d1).2.2 bgkG (Or.inl rfl)
  have k4 : CReg Xi σ (cKer bgkU ψ2) := (hops ψ2 hψ2).2.2 bgkU (Or.inr (Or.inr (Or.inl rfl)))
  have k5 : CReg Xi σ (cKer bgkS ψ2) :=
    (hops ψ2 hψ2).2.2 bgkS (Or.inr (Or.inr (Or.inr (Or.inr rfl))))
  have k6 : CReg Xi σ (cKer bgkS (cDw ψ2)) :=
    (hops _ d2).2.2 bgkS (Or.inr (Or.inr (Or.inr (Or.inr rfl))))
  have k7 : CReg Xi σ (cKer bgkUp ψ2) :=
    (hops ψ2 hψ2).2.2 bgkUp (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
  have k8 : CReg Xi σ (cKer bgkU (cDw ψ2)) := (hops _ d2).2.2 bgkU (Or.inr (Or.inr (Or.inl rfl)))
  refine ⟨?_, ?_⟩
  · have p0 := hmul _ _ (hac 0) k1
    have p1 := hmul _ _ (hac 1) k2
    have p2 := hmul _ _ (hac 2) k3
    have p3 := hmul _ _ (hac 3) k4
    have p4 := hmul _ _ (hac 4) k5
    have p5 := hmul _ _ (hac 5) k6
    have h := hadd _ _ (hadd _ _ (hadd _ _ (hadd _ _ (hadd _ _ p0 p1) p2) p3) p4) p5
    exact h
  · have I5 := hmul _ _ hgc k1
    have I6 := hadd _ _ (hmul _ _ dg k1) (hmul _ _ hgc k3)
    have R5 := (hops _ I5).2.1
    have R6 := (hops _ I6).2.1
    have T7 := hmul _ _ hX I5
    have q0 := hmul _ _ (hbc 0) k4
    have q1 := hmul _ _ (hbc 1) k7
    have q2 := hmul _ _ (hbc 2) k8
    have q3 := hmul _ _ (hbc 3) k5
    have q4 := hmul _ _ (hbc 4) k6
    have q5 := hmul _ _ (hbc 5) R5
    have q6 := hmul _ _ (hbc 6) R6
    have q7 := hmul _ _ (hbc 7) T7
    have h := hadd _ _ (hadd _ _ (hadd _ _ (hadd _ _ (hadd _ _ (hadd _ _ (hadd _ _ q0 q1) q2) q3)
      q4) q5) q6) q7
    exact h

theorem bg_one_step : ∀ (Xi σ₀ A₁ K : ℝ) (m : ℕ) (ac : Fin 6 → ℝ → ℂ → ℂ) (bc : Fin 8 → ℝ → ℂ → ℂ) (gc ψ1 ψ2 : ℝ → ℂ → ℂ), 0 < Xi → 0 < σ₀ → σ₀ ≤ 1 → 0 ≤ A₁ → 0 ≤ K → (∀ i X w, 0 < X → X < Xi → w ∈ cStrip σ₀ → ‖ac i X w‖ ≤ A₁) → (∀ i X w, 0 < X → X < Xi → w ∈ cStrip σ₀ → ‖bc i X w‖ ≤ A₁) → (∀ X w, 0 < X → X < Xi → w ∈ cStrip σ₀ → ‖gc X w‖ ≤ A₁ ∧ ‖cDw gc X w‖ ≤ A₁) → (∀ X, 0 < X → X < Xi → DifferentiableOn ℂ (ψ1 X) (cStrip σ₀) ∧ DifferentiableOn ℂ (ψ2 X) (cStrip σ₀)) → (∀ (s X : ℝ) (w : ℂ), 0 < s → s < σ₀ → 0 < X → X < Xi → w ∈ cStrip s → ‖ψ1 X w‖ ≤ K * X ^ m / (σ₀ - s) ^ m ∧ ‖ψ2 X w‖ ≤ K * X ^ m / (σ₀ - s) ^ m) → ∀ (s X : ℝ) (w : ℂ), 0 < s → s < σ₀ → 0 < X → X < Xi → w ∈ cStrip s → ‖bgT1 ac ψ1 ψ2 X w‖ ≤ 8 * (1 + A₁) ^ 2 * (1 + Xi) * K * X ^ (m + 1) / (((m : ℝ) + 1) * (σ₀ - s) ^ (m + 1)) ∧ ‖bgT2 bc gc ψ1 ψ2 X w‖ ≤ 8 * (1 + A₁) ^ 2 * (1 + Xi) * K * X ^ (m + 1) / (((m : ℝ) + 1) * (σ₀ - s) ^ (m + 1)) :=
by
  have strip_cauchy_nagumo : ∀ (f : ℂ → ℂ) (σ₀ : ℝ), (∀ (s s' K : ℝ), s < s' → DifferentiableOn ℂ f (cStrip s') → (∀ z ∈ cStrip s', ‖f z‖ ≤ K) → ∀ w ∈ cStrip s, ‖deriv f w‖ ≤ K / (s' - s)) ∧ (∀ (K : ℝ) (m : ℕ), 0 < σ₀ → 0 ≤ K → DifferentiableOn ℂ f (cStrip σ₀) → (∀ (s : ℝ) (z : ℂ), 0 < s → s < σ₀ → z ∈ cStrip s → ‖f z‖ ≤ K / (σ₀ - s) ^ m) → ∀ (s : ℝ) (w : ℂ), 0 < s → s < σ₀ → w ∈ cStrip s → ‖deriv f w‖ ≤ 3 * ((m : ℝ) + 2) * K / (σ₀ - s) ^ (m + 1)) := by
    intro f σ₀
    have P1 : ∀ (s s' K : ℝ), s < s' → DifferentiableOn ℂ f (cStrip s') →
        (∀ z ∈ cStrip s', ‖f z‖ ≤ K) → ∀ w ∈ cStrip s, ‖deriv f w‖ ≤ K / (s' - s) := by
      intro s s' K hss' hd hb w hw
      have hr : 0 < s' - s := sub_pos.mpr hss'
      have hsub : Metric.closedBall w (s' - s) ⊆ cStrip s' := by
        intro z hz
        rw [Metric.mem_closedBall, dist_eq_norm] at hz
        have h1 := Complex.abs_im_le_norm (z - w)
        have h2 := Complex.abs_re_le_norm (z - w)
        rw [Complex.sub_im] at h1
        rw [Complex.sub_re] at h2
        simp only [cStrip, Set.mem_setOf_eq] at hw ⊢
        obtain ⟨hw1, hw2, hw3⟩ := hw
        rw [abs_lt] at hw1 ⊢
        obtain ⟨h1a, h1b⟩ := abs_le.mp (h1.trans hz)
        obtain ⟨h2a, h2b⟩ := abs_le.mp (h2.trans hz)
        obtain ⟨hw1a, hw1b⟩ := hw1
        refine ⟨⟨by linarith, by linarith⟩, by linarith, by linarith⟩
      have hdc : DiffContOnCl ℂ f (Metric.ball w (s' - s)) := by
        apply DifferentiableOn.diffContOnCl
        rw [closure_ball w hr.ne']
        exact hd.mono hsub
      exact Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr hdc
        (fun z hz => hb z (hsub (Metric.sphere_subset_closedBall hz)))
    have hq3 : ∀ m : ℕ, (((m:ℝ) + 2) / ((m:ℝ) + 1)) ^ m ≤ 3 := by
      intro m
      have hm1 : (0:ℝ) < (m:ℝ) + 1 := by positivity
      have hqx : ((m:ℝ) + 2) / ((m:ℝ) + 1) = 1 / ((m:ℝ) + 1) + 1 := by
        field_simp; ring
      have hq0 : 0 ≤ ((m:ℝ) + 2) / ((m:ℝ) + 1) := by positivity
      have h1 : (((m:ℝ) + 2) / ((m:ℝ) + 1)) ^ m ≤ (Real.exp (1 / ((m:ℝ) + 1))) ^ m := by
        apply pow_le_pow_left₀ hq0
        rw [hqx]; exact Real.add_one_le_exp _
      rw [← Real.exp_nat_mul] at h1
      have h2 : (m:ℝ) * (1 / ((m:ℝ) + 1)) ≤ 1 := by
        rw [mul_one_div, div_le_one hm1]; linarith
      have h3 : Real.exp ((m:ℝ) * (1 / ((m:ℝ) + 1))) ≤ Real.exp 1 := Real.exp_le_exp.mpr h2
      have h4 := Real.exp_one_lt_d9
      have h5 : Real.exp 1 < 3 := lt_trans h4 (by norm_num)
      linarith
    refine ⟨P1, ?_⟩
    intro K m hσ₀ hK hd hyp s w hs0 hsσ hw
    have hD : 0 < σ₀ - s := sub_pos.mpr hsσ
    have hDne : σ₀ - s ≠ 0 := hD.ne'
    have hm2 : (0:ℝ) < (m:ℝ) + 2 := by positivity
    have hm1 : (0:ℝ) < (m:ℝ) + 1 := by positivity
    have hm2ne : (m:ℝ) + 2 ≠ 0 := hm2.ne'
    have hm1ne : (m:ℝ) + 1 ≠ 0 := hm1.ne'
    have hδ : 0 < (σ₀ - s) / ((m:ℝ) + 2) := div_pos hD hm2
    have hδlt : (σ₀ - s) / ((m:ℝ) + 2) < σ₀ - s := by
      rw [div_lt_iff₀ hm2]; nlinarith [mul_pos hD hm1]
    obtain ⟨s', hs'⟩ : ∃ s' : ℝ, s' = s + (σ₀ - s) / ((m:ℝ) + 2) := ⟨_, rfl⟩
    have hss' : s < s' := by rw [hs']; linarith
    have hs'σ : s' < σ₀ := by rw [hs']; linarith
    have hs'0 : 0 < s' := by linarith
    have hsub : cStrip s' ⊆ cStrip σ₀ := by
      intro z hz
      simp only [cStrip, Set.mem_setOf_eq] at hz ⊢
      obtain ⟨a, b, c⟩ := hz
      exact ⟨by linarith, by linarith, by linarith⟩
    have key := P1 s s' (K / (σ₀ - s') ^ m) hss' (hd.mono hsub)
      (fun z hz => hyp s' z hs'0 hs'σ hz) w hw
    have e1 : σ₀ - s' = (σ₀ - s) * ((m:ℝ) + 1) / ((m:ℝ) + 2) := by
      rw [hs']; field_simp; ring
    have e2 : s' - s = (σ₀ - s) / ((m:ℝ) + 2) := by rw [hs']; ring
    rw [e1, e2] at key
    have eq : K / ((σ₀ - s) * ((m:ℝ) + 1) / ((m:ℝ) + 2)) ^ m / ((σ₀ - s) / ((m:ℝ) + 2)) =
        (((m:ℝ) + 2) / ((m:ℝ) + 1)) ^ m * (((m:ℝ) + 2) * K / (σ₀ - s) ^ (m + 1)) := by
      have gen : ∀ D a b : ℝ, D ≠ 0 → a ≠ 0 → b ≠ 0 →
          K / (D * a / b) ^ m / (D / b) = (b / a) ^ m * (b * K / D ^ (m + 1)) := by
        intro D a b hD0 ha0 hb0
        have hDm : D ^ m ≠ 0 := pow_ne_zero _ hD0
        have ham : a ^ m ≠ 0 := pow_ne_zero _ ha0
        have hbm : b ^ m ≠ 0 := pow_ne_zero _ hb0
        rw [div_pow, mul_pow, div_pow, pow_succ]
        field_simp <;> ring
      exact gen _ _ _ hDne hm1ne hm2ne
    rw [eq] at key
    have hE : 0 ≤ ((m:ℝ) + 2) * K / (σ₀ - s) ^ (m + 1) :=
      div_nonneg (mul_nonneg hm2.le hK) (pow_pos hD _).le
    calc ‖deriv f w‖ ≤ _ := key
      _ ≤ 3 * (((m:ℝ) + 2) * K / (σ₀ - s) ^ (m + 1)) := mul_le_mul_of_nonneg_right (hq3 m) hE
      _ = 3 * ((m : ℝ) + 2) * K / (σ₀ - s) ^ (m + 1) := by ring
  intro Xi σ₀ A₁ K m ac bc gc ψ1 ψ2 hXi hσ₀ hσ₀1 hA₁ hK hac hbc hgc hdiff hψ s X w hs0 hsσ hX0 hXXi hw
  have hn0 : (0:ℝ) < (m:ℝ) + 1 := by positivity
  have hn1 : (1:ℝ) ≤ (m:ℝ) + 1 := by have := (Nat.cast_nonneg m : (0:ℝ) ≤ m); linarith

  have hmom : IntervalIntegrable (fun t : ℝ => -Real.log t * t ^ m) MeasureTheory.volume 0 1 ∧
      ∫ t in (0:ℝ)..1, -Real.log t * t ^ m = 1 / ((m : ℝ) + 1) ^ 2 := by
    have hint : IntervalIntegrable (fun t : ℝ => -Real.log t * t ^ m) MeasureTheory.volume 0 1 :=
      (intervalIntegral.intervalIntegrable_log'.neg).mul_continuousOn (continuous_pow m).continuousOn
    refine ⟨hint, ?_⟩
    have hcont : ContinuousOn (fun t : ℝ => t ^ (m + 1) / ((m:ℝ) + 1) ^ 2 -
        t ^ m * (t * Real.log t) / ((m:ℝ) + 1)) (Set.Icc 0 1) :=
      (((continuous_pow _).div_const _).sub
        (((continuous_pow m).mul Real.continuous_mul_log).div_const _)).continuousOn
    have hderiv : ∀ x ∈ Set.Ioo (0:ℝ) 1, HasDerivAt (fun t : ℝ => t ^ (m + 1) / ((m:ℝ) + 1) ^ 2 -
        t ^ m * (t * Real.log t) / ((m:ℝ) + 1)) (-Real.log x * x ^ m) x := by
      intro x hx
      have hx0 : x ≠ 0 := hx.1.ne'
      have h1 := (hasDerivAt_pow (m + 1) x).div_const (((m:ℝ) + 1) ^ 2)
      have h2 : HasDerivAt (fun t : ℝ => t * Real.log t) (Real.log x + 1) x := by
        rw [show Real.log x + 1 = 1 * Real.log x + x * x⁻¹ by rw [mul_inv_cancel₀ hx0]; ring]
        exact (hasDerivAt_id' x).mul (Real.hasDerivAt_log hx0)
      have h3 := ((hasDerivAt_pow m x).mul h2).div_const ((m:ℝ) + 1)
      have h4 := h1.sub h3
      convert h4 using 1
      rcases Nat.eq_zero_or_pos m with hm | hm
      · subst hm
        simp
      · obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
        simp only [Nat.add_sub_cancel]
        push_cast
        field_simp
        ring
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le zero_le_one hcont hderiv hint]
    simp

  have hker : ∀ (c μ Y : ℝ) (kk L : ℝ → ℝ) (g : ℝ → ℂ → ℂ), 0 < Y → Y < Xi →
      (∀ t : ℝ, 0 < t → t ≤ 1 → |kk t| ≤ L t) →
      IntervalIntegrable (fun t : ℝ => L t * t ^ m) MeasureTheory.volume 0 1 →
      ∫ t in (0:ℝ)..1, L t * t ^ m = μ →
      (∀ y : ℝ, 0 < y → y < Xi → ‖g y w‖ ≤ c * y ^ m) →
      ‖cKer kk g Y w‖ ≤ c * Y ^ (m + 1) * μ := by
    intro c μ Y kk L g hY hYXi hL hLi hLμ hg
    unfold cKer
    have hb : ‖∫ t in (0:ℝ)..1, ((kk t : ℝ) : ℂ) * g (t * Y) w‖ ≤
        ∫ t in (0:ℝ)..1, (c * Y ^ m) * (L t * t ^ m) := by
      apply intervalIntegral.norm_integral_le_of_norm_le zero_le_one
      · refine MeasureTheory.ae_of_all _ (fun t ht => ?_)
        obtain ⟨ht0, ht1⟩ := ht
        have hy0 : 0 < t * Y := mul_pos ht0 hY
        have hyX : t * Y < Xi := lt_of_le_of_lt (by nlinarith) hYXi
        have hk := hL t ht0 ht1
        have hL0 : 0 ≤ L t := le_trans (abs_nonneg _) hk
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
