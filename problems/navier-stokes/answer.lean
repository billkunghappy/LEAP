    rw [Real.mul_rpow (pow_nonneg hb 4) (mul_nonneg (Real.rpow_nonneg hW _) (Real.rpow_nonneg hS _)),
      Real.mul_rpow (Real.rpow_nonneg hW _) (Real.rpow_nonneg hS _), ← Real.rpow_mul hW,
      ← Real.rpow_mul hS]
    congr 1
    · rw [← Real.rpow_natCast, ← Real.rpow_mul hb]; norm_num
