    have d2 : DifferentiableAt ℝ (pcB5 B γ.1 2) (η.1, η.2.1, η.2.2.1) :=
      (hB2.contDiffAt hn).differentiableAt (by norm_num)
    have hd := (d1.hasFDerivAt.const_mul (pang5 B G γ)).add (d2.hasFDerivAt.const_mul (pzr5 B G γ))
    rw [show pcPhi2_5 B G γ = (fun y => pang5 B G γ * pcFa5 B γ.1 y) + (fun y => pzr5 B G γ * pcB5 B γ.1 2 y)
      from rfl, hd.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring

  let sl : Cyl →L[ℝ] ℝ × ℝ × ℝ :=
    (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))).prod
      (((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))).prod
        ((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))))))
  have hslA : ∀ η : Cyl, HasFDerivAt (fun x : Cyl => (x.1, x.2.1, x.2.2.1)) sl η := fun η => sl.hasFDerivAt
  obtain ⟨wT, hwT⟩ : ∃ w : Cyl, w = (0, 0, Qb γ.1 / qC B.h ξ, 0) := ⟨_, rfl⟩
  have hvT : (((Lnorm B.h ξ wT).1, (Lnorm B.h ξ wT).2.1, (Lnorm B.h ξ wT).2.2.1) : ℝ × ℝ × ℝ) =
      Qb γ.1 • ((0:ℝ), (0:ℝ), (1:ℝ)) := by
    rw [hwT]
    simp only [Lnorm, ContinuousLinearMap.coe_prodMap', Prod.map_apply, ContinuousLinearMap.smul_apply,
