theorem ax_ref_continuation_unit : ∀ (h Pst : ℝ) (Pax : ℝ → ℝ), AxDatum h Pst Pax → ∀ (j0 σ δ ρ : ℝ) (Pc : ℂ → ℂ), 0 < j0 → j0 ≤ 1 / 20 → AxData h j0 σ δ ρ Pc Pax → ∀ K ρ1 : ℝ, 0 < K → 0 < ρ1 → ∃ Λ1 : ℝ, ∀ Λ : ℝ, Λ1 ≤ Λ → ∀ Kder : ℕ → ℝ, ∃ (C2 : ℝ) (M : ℕ → ℝ), ∀ C : ℝ, C2 ≤ C → ∀ Fn Un : ℝ → ℝ → ℝ, AxAxisOut h j0 σ δ Pax Λ C K ρ1 Kder Fn Un → ∃ ts : ℝ, 0 < ts ∧ ts ≤ 1 / 100 ∧ ∀ t1 : ℝ, 0 < t1 → t1 ≤ ts → AxRefPI h j0 σ Pax Λ C K ρ1 M (axRefF Λ t1 Fn) (axRefU Λ t1 Un) :=
