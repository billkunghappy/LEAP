    intro x hx t h1 h2
    have hφ : ContDiffOn ℝ ∞ (fun η' => q e x η') (Ioo (-1) 1) := by
      have := (hqs e he he1).comp (contDiffOn_const.prodMk contDiffOn_id)
        (fun s hs => (⟨hx, hs⟩ : ((x, s) : ℝ × ℝ) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1))
