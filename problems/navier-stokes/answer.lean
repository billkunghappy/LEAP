    rw [Real.rpow_one] at h2
    linarith
  have hκ3 : Qb γ.1 ^ (-B.h) * Qb γ.1 ^ (1/2 + B.h) * Real.sqrt (Qb γ.1) = Qb γ.1 := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_add hQ, ← Real.rpow_add hQ]
    have e : -B.h + (1/2 + B.h) + 1/2 = (1:ℝ) := by ring
    rw [e, Real.rpow_one]
  have hss : Real.sqrt (Qb γ.1) * Real.sqrt (Qb γ.1) = Qb γ.1 := Real.mul_self_sqrt hQ.le
  have hdv : Qb γ.1 / Real.sqrt (Qb γ.1) = Real.sqrt (Qb γ.1) := Real.div_sqrt

  have hB2 : ContDiffOn ℝ ∞ (pcB5 B γ.1 2) Ω := hBsm γ.1 2
  have hB1 : ContDiffOn ℝ ∞ (pcB5 B γ.1 1) Ω := hBsm γ.1 1
  have hRC : ContDiffOn ℝ ∞ (pcRC5 γ.1) Ω := by
    have : ContDiff ℝ ∞ (pcRC5 γ.1) := by unfold pcRC5; fun_prop
    exact this.contDiffOn
  have hFa : ContDiffOn ℝ ∞ (pcFa5 B γ.1) Ω := by
