    have hW : sw5W B G l0 D x t Y = ∑ p ∈ Γ ×ˢ H, curl3 (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
        (p.2 * pint5 B G p.1) (modeCoef5 B G D p.1 p.2)) x := by
      have hev : (fun y => sw5A B G l0 D y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) =ᶠ[nhds x]
          (fun y => ∑ p ∈ Γ ×ˢ H, modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
            (p.2 * pint5 B G p.1) (modeCoef5 B G D p.1 p.2) y) := by
        filter_upwards [hloc] with y hy
        rw [hy, Finset.sum_product]
      have hc3 := hcurl _ (Γ ×ˢ H) (fun p => modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
        (p.2 * pint5 B G p.1) (modeCoef5 B G D p.1 p.2)) x hev (fun p _ => hMS p.1 p.2)
      show curl3 (fun y => sw5A B G l0 D y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t))) x = _
      rw [hrad]
      exact hc3

    have hY : Yph B.h r t + (Y - Yph B.h r t) = Y := by abel
    have hradx0 : rad (rotPt r 0 z) = r := by simp [rad, rotPt, Real.sqrt_sq hr.le]
    have hx02 : (rotPt r 0 z) 2 = z := by simp [rotPt]
    have hPx0 : ptOf (rotPt r 0 z) t (Yph B.h (rad (rotPt r 0 z)) t + (Y - Yph B.h r t)) = (r, z, t, Y) := by
      simp only [ptOf, hradx0, hY, hx02]
    have hmode : ∀ (θ : ℝ) (a : Fin 3) (γ : Lab) (m : ℤ), inner ℝ (curl3 (modeF5 B.h (1/2 - Aex B.h) t
        (Y - Yph B.h r t) (m * pint5 B G γ) (modeCoef5 B G D γ m)) (rotPt r θ z))
        (frameAt θ (r, z, t, Y) a) =
        qC B.h (r, z, t, Y) ^ (-Aex B.h) *
          (wmoAmp5 B G D γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y)).re := by
      intro θ a γ m
      have hCd : DifferentiableAt ℝ (modeCoef5 B G D γ m) ((r, z, t, Y) : Cyl) :=
        modeCoef5_differentiable_v5 B G hok hG (qsOf l0) β2 D hqsB hD γ m _ hξ'
      have hICd : DifferentiableAt ℝ (fun η i => Complex.I * modeCoef5 B G D γ m η i)
          ((r, z, t, Y) : Cyl) :=
        differentiableAt_pi.2 (fun i => (differentiableAt_pi.1 hCd i).const_mul Complex.I)
      have hM1 : DifferentiableAt ℝ (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
          (modeCoef5 B G D γ m)) (rotPt r 0 z) :=
        modeF5_differentiable_v5 _ _ _ _ _ _ _ hok.1 ht (by rw [hradx0]; exact hr) (by rw [hPx0]; exact hCd)
      have hM2 : DifferentiableAt ℝ (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
          (fun η i => Complex.I * modeCoef5 B G D γ m η i)) (rotPt r 0 z) :=
        modeF5_differentiable_v5 _ _ _ _ _ _ _ hok.1 ht (by rw [hradx0]; exact hr) (by rw [hPx0]; exact hICd)
      obtain ⟨hax1, hax2⟩ := mode_curl_axis_v5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
        (modeCoef5 B G D γ m) r z hok.1 ht hr (by rw [hY]; exact hCd)
      obtain ⟨hax3, -⟩ := mode_curl_axis_v5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
        (fun η i => Complex.I * modeCoef5 B G D γ m η i) r z hok.1 ht hr (by rw [hY]; exact hICd)
      rw [hY] at hax1 hax2 hax3
      have hph := fun i => wmo_phase_deriv_v5 B G hok hG (qsOf l0) β2 D hqsB hD γ m
        (r, z, t, Y) hξ' i
      have hamp := wmo_mode_amp_v5 B G D γ m (r, z, t, Y) hok hr ht (fun i => (hph i).1)
        (fun i => (hph i).2) a
      have hZ : ephase5 B G γ m θ (r, z, t, Y) =
          Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (r, z, t, Y) : ℂ))) *
            Complex.exp (((((m * pint5 B G γ : ℤ) : ℝ) * θ : ℝ) : ℂ) * Complex.I) := by
        simp only [ephase5]
        rw [← Complex.exp_add]
        congr 1
        push_cast
        ring
      rw [hrot _ _ _ _ _ _ r z hr hM1 hM2 Y a θ, hax1 a, hax3 a, hax2, hZ]
      exact key _ _ _ _ _ _ hamp

    have hcoef : ∀ (γ : Lab) (m : ℤ) (i : Fin 3),
        ((qC B.h (r, z, t, Y) ^ (-Aex B.h) : ℝ) : ℂ) * wmoAmp5 B G D γ m (r, z, t, Y) i =
          cr5Vel B G D γ m (r, z, t, Y) i := fun γ m i => rfl

    have hP0 : ∀ (γ : Lab) (m : ℤ), ¬ (γ ∈ Γ ∧ m ∈ H) → cr5Vel B G D γ m (r, z, t, Y) = 0 := by
      intro γ m hn
      have hev : D γ m =ᶠ[nhds ((r, z, t, Y) : Cyl)] fun _ => 0 := by
        filter_upwards [hNO] with η hη
        by_contra hne
        exact hn (hcov η hη γ m hne)
      have h0 : D γ m (r, z, t, Y) = 0 := hev.eq_of_nhds
      have hcomp : ∀ i : Fin 3, fderiv ℝ (fun η => D γ m η i) ((r, z, t, Y) : Cyl) = 0 := by
        intro i
        have h1 : (fun η => D γ m η i) =ᶠ[nhds ((r, z, t, Y) : Cyl)] fun _ => (0:ℂ) := by
          filter_upwards [hev] with η hη
          simp [hη]
        rw [h1.fderiv_eq]
        simp
      funext i
      fin_cases i <;> simp [cr5Vel, wmoAmp5, velW5, velC5, DrC, DzC, dR, dZ, rotC, h0, hcomp]

    have hwaveP : ∀ (θ : ℝ) (a : Fin 3), waveV5 B G (cr5Vel B G D) θ (r, z, t, Y) a = ∑ γ ∈ Γ, ∑ m ∈ H,
        (cr5Vel B G D γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y)).re := by
      intro θ a
      have hin : ∀ γ, ∑ᶠ m : ℤ, cr5Vel B G D γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y) =
          ∑ m ∈ H, cr5Vel B G D γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y) := by
        intro γ
        apply finsum_eq_sum_of_support_subset
        rw [Function.support_subset_iff']
        intro m hm
        rw [hP0 γ m (fun hh => hm (Finset.mem_coe.mpr hh.2))]
        simp
      have hout : (Function.support fun γ => ∑ m ∈ H,
          cr5Vel B G D γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y)) ⊆ ↑Γ := by
        rw [Function.support_subset_iff']
        intro γ hγ
        apply Finset.sum_eq_zero
        intro m _
        rw [hP0 γ m (fun hh => hγ (Finset.mem_coe.mpr hh.1))]
        simp
      simp only [waveV5]
      rw [finsum_congr hin, finsum_eq_sum_of_support_subset _ hout, Complex.re_sum]
      refine Finset.sum_congr rfl (fun γ _ => ?_)
      rw [Complex.re_sum]
    have hrotx : rotPt r (thetaOf x) z = x := by
      rw [← hrad, ← hx2]
      exact hrotx0
    have hframe : (![eR x, eTh x, eZ] : Fin 3 → ℝ³) = frameAt (thetaOf x) ((r, z, t, Y) : Cyl) := by
      show _ = ![eR (rotPt r (thetaOf x) z), eTh (rotPt r (thetaOf x) z), eZ]
      rw [hrotx]

    have hcomp : ∀ a : Fin 3, inner ℝ (sw5W B G l0 D x t Y) (frameAt (thetaOf x) ((r, z, t, Y) : Cyl) a) =
        waveV5 B G (cr5Vel B G D) (thetaOf x) (r, z, t, Y) a := by
      intro a
      rw [hW, sum_inner, hwaveP (thetaOf x) a, Finset.sum_product]
      refine Finset.sum_congr rfl (fun γ _ => Finset.sum_congr rfl (fun m _ => ?_))
      dsimp only
      have hm := hmode (thetaOf x) a γ m
      rw [hrotx] at hm
      rw [hm, ← hcoef γ m a, mul_assoc, Complex.re_ofReal_mul]
    conv_lhs => rw [← hrec (sw5W B G l0 D x t Y)]
    rw [hframe, hPξ]
    congr 1
    funext a
    exact hcomp a

theorem cr5_transport_rep : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (S : CState) (D Vo Vn : WC) (H : Finset ℤ), (∀ γ m, ContDiffOn ℝ ∞ (Vo γ m) (DomC B.h (qsOf l0)) ∧ ContDiffOn ℝ ∞ (Vn γ m) (DomC B.h (qsOf l0))) → (∀ γ m, m ∉ H → Vo γ m = 0 ∧ Vn γ m = 0) → (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → (Vo γ m ξ ≠ 0 → SuppW B G γ ξ) ∧ (Vn γ m ξ ≠ 0 → SuppW B G γ ξ)) → (∀ (γ γ' : Lab) (m m' : ℤ), γ ≠ γ' → ∀ ξ ∈ DomC B.h (qsOf l0), (Vo γ m ξ ≠ 0 → ξ ∉ tsupport (Vn γ' m')) ∧ (Vn γ m ξ ≠ 0 → ξ ∉ tsupport (Vo γ' m'))) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 S a) (DomC B.h (qsOf l0))) → (∀ x t Y, corrOn B l0 x t → uX5 B G l0 S x t Y - pwrUB B x t Y = cyl2cart x (fun a => mcor5 B G l0 S a (ptOf x t Y)) + cyl2cart x (waveV5 B G Vo (thetaOf x) (ptOf x t Y)) ∧ sw5W B G l0 D x t Y = cyl2cart x (waveV5 B G Vn (thetaOf x) (ptOf x t Y))) → (∀ ξ ∈ DomC B.h (qsOf l0), ∃ T : Finset Lab, ∀ γ M, γ ∉ T → cr5Q B G l0 S H Vo Vn γ M ξ = 0) ∧ ∀ x t Y, corrOn B l0 x t → sw5Cr B G l0 S D x t Y = (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) • cyl2cart x (waveV5 B G (cr5Q B G l0 S H Vo Vn) (thetaOf x) (ptOf x t Y)) :=
by
  intro B G hok hG

  obtain ⟨hh0, -, -, -, -, -, -, hqB0, hqB1, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 S D Vo Vn H h1 h2 h3 h4 h5 h6 => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  have hVoS : ∀ γ m, ContDiffOn ℝ ∞ (Vo γ m) (DomC B.h (qsOf l0)) := fun γ m => (h1 γ m).1
  have hVnS : ∀ γ m, ContDiffOn ℝ ∞ (Vn γ m) (DomC B.h (qsOf l0)) := fun γ m => (h1 γ m).2
  have hVoSupp : ∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → Vo γ m ξ ≠ 0 → SuppW B G γ ξ :=
    fun γ m ξ hξ => (h3 γ m ξ hξ).1
  have hVnSupp : ∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → Vn γ m ξ ≠ 0 → SuppW B G γ ξ :=
    fun γ m ξ hξ => (h3 γ m ξ hξ).2
  obtain ⟨hDo, hCoD⟩ := pq5_coef_diff B G l0 Vo hok hG hqB hVoS hVoSupp
  obtain ⟨-, hCnD⟩ := pq5_coef_diff B G l0 Vn hok hG hqB hVnS hVnSupp

  have hTrU : ∀ (n : ℤ) (U : Fin 3 → ℂ) (c : Cyl → (Fin 3 → ℂ)) (ξ : Cyl), (∀ a, U a = 0) →
      pq5TrM B.h n U c ξ = 0 ∧ pq5TrM B.h n (fun a => starRingEnd ℂ (U a)) c ξ = 0 := by
    intro n U c ξ hU
    constructor
    · funext i
      fin_cases i <;> simp [pq5TrM, hU]
    · funext i
      fin_cases i <;> simp [pq5TrM, hU]
  have hTrC : ∀ (n : ℤ) (U : Fin 3 → ℂ) (c : Cyl → (Fin 3 → ℂ)) (ξ : Cyl), (∀ a, c ξ a = 0) →
      (∀ a, dR B.h c ξ a = 0) → (∀ a, dZ c ξ a = 0) → pq5TrM B.h n U c ξ = 0 := by
    intro n U c ξ hc hr hz
    funext i
    fin_cases i <;> simp [pq5TrM, hc, hr, hz]
  have hev0 : ∀ (c : Cyl → (Fin 3 → ℂ)) (ξ : Cyl), c =ᶠ[nhds ξ] 0 →
      (∀ a, c ξ a = 0) ∧ (∀ a, dR B.h c ξ a = 0) ∧ (∀ a, dZ c ξ a = 0) := by
    intro c ξ h
    have hf : fderiv ℝ c ξ = 0 := by rw [h.fderiv_eq]; simp
    refine ⟨fun a => by rw [h.eq_of_nhds]; rfl, fun a => by simp [dR, hf], fun a => by simp [dZ, hf]⟩
  have hCev : ∀ (V : WC) γ m (ξ : Cyl), V γ m =ᶠ[nhds ξ] 0 → modeCoef5 B G V γ m =ᶠ[nhds ξ] 0 := by
    intro V γ m ξ h
    filter_upwards [h] with η hη
    funext i
    simp [modeCoef5, hη]
  have hCnz : ∀ γ M, M ∉ H → ∀ ξ, (∀ a, modeCoef5 B G Vn γ M ξ a = 0) ∧
      (∀ a, dR B.h (modeCoef5 B G Vn γ M) ξ a = 0) ∧ (∀ a, dZ (modeCoef5 B G Vn γ M) ξ a = 0) := by
    intro γ M hM ξ
    have hz : modeCoef5 B G Vn γ M = 0 := by
      funext η a
      simp [modeCoef5, (h2 γ M hM).2]
    exact hev0 _ ξ (by rw [hz])

  have hlab : ∀ (ξ : Cyl) (γ : Lab), (∀ m, Vo γ m =ᶠ[nhds ξ] 0) → (∀ m, Vn γ m =ᶠ[nhds ξ] 0) →
      ∀ M, cr5Q B G l0 S H Vo Vn γ M ξ = 0 := by
    intro ξ γ ho hn M
    have hCo : ∀ m, ∀ a, modeCoef5 B G Vo γ m ξ a = 0 := fun m => (hev0 _ ξ (hCev Vo γ m ξ (ho m))).1
    have hCn := fun m => hev0 _ ξ (hCev Vn γ m ξ (hn m))
    have e1 : ∀ (V V' : WC), (∀ m a, modeCoef5 B G V γ m ξ a = 0) → cr5WW B G H V V' γ M ξ = 0 := by
      intro V V' hV
      unfold cr5WW
      rw [Finset.sum_eq_zero, smul_zero]
      intro m _
      apply Finset.sum_eq_zero
      intro m' _
      rw [(hTrU _ _ _ _ (hV m)).1, (hTrU _ _ _ _ (hV m)).2]
      simp
    have e3 : cr5MW B G l0 S Vn γ M ξ = 0 := by
      unfold cr5MW
      rw [hTrC _ _ _ _ (hCn M).1 (hCn M).2.1 (hCn M).2.2, (hTrU _ _ _ _ (hCn M).1).1, add_zero, smul_zero]
    simp only [cr5Q, Pi.add_apply]
    rw [e1 Vo Vn hCo, e1 Vn Vo (fun m => (hCn m).1), e3, add_zero, add_zero]

  obtain ⟨Hq, hHq1, hHq2, hHq3⟩ : ∃ Hq : Finset ℤ, (∀ m ∈ H, ∀ m' ∈ H, m + m' ∈ Hq) ∧
      (∀ m ∈ H, ∀ m' ∈ H, m' - m ∈ Hq) ∧ H ⊆ Hq :=
    ⟨(H ×ˢ H).image (fun p : ℤ × ℤ => p.1 + p.2) ∪ (H ×ˢ H).image (fun p : ℤ × ℤ => p.2 - p.1) ∪ H,
      fun m hm m' hm' => Finset.mem_union_left _ (Finset.mem_union_left _
        (Finset.mem_image.2 ⟨(m, m'), Finset.mem_product.2 ⟨hm, hm'⟩, rfl⟩)),
      fun m hm m' hm' => Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_image.2 ⟨(m, m'), Finset.mem_product.2 ⟨hm, hm'⟩, rfl⟩)),
      Finset.subset_union_right⟩
  have hQz : ∀ (ξ : Cyl) γ M, M ∉ Hq → cr5Q B G l0 S H Vo Vn γ M ξ = 0 := by
    intro ξ γ M hM
    have hMH : M ∉ H := fun h => hM (hHq3 h)
    have hWWz : ∀ V V' : WC, cr5WW B G H V V' γ M ξ = 0 := by
      intro V V'
      unfold cr5WW
      rw [Finset.sum_eq_zero, smul_zero]
      intro m hm
      apply Finset.sum_eq_zero
      intro m' hm'
      rw [if_neg (fun h => hM (by rw [← h]; exact hHq1 m hm m' hm')),
        if_neg (fun h => hM (by rw [← h]; exact hHq2 m hm m' hm')), add_zero]
    have hMWz : cr5MW B G l0 S Vn γ M ξ = 0 := by
      obtain ⟨c1, c2, c3⟩ := hCnz γ M hMH ξ
      unfold cr5MW
      rw [hTrC _ _ _ _ c1 c2 c3, (hTrU _ _ _ _ c1).1, add_zero, smul_zero]
    simp only [cr5Q, Pi.add_apply, hWWz, hMWz, add_zero]
  have hphase : ∀ (γ : Lab) (m : ℤ) (θ : ℝ) (η : Cyl), ephase5 B G γ m θ η =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) *
        Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) := by
    intro γ m θ η
    simp only [ephase5]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring

  have hregroup : ∀ (ξ : Cyl) (θ : ℝ) (Γ : Finset Lab), 0 < qC B.h ξ →
      (∀ γ M, γ ∉ Γ → cr5Q B G l0 S H Vo Vn γ M ξ = 0) →
      (qC B.h ξ ^ (-(2 * Aex B.h + 1/2))) • waveV5 B G (cr5Q B G l0 S H Vo Vn) θ ξ = fun i => ∑ γ ∈ Γ, ∑ m ∈ H, ∑ m' ∈ H, ((1/2 : ℂ) * (pq5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G Vo γ m ξ) (modeCoef5 B G Vn γ m') ξ i * Complex.exp (Complex.I * ((m * pint5 B G γ + m' * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) + pq5TrM B.h (m' * pint5 B G γ) (fun a => starRingEnd ℂ (modeCoef5 B G Vo γ m ξ a)) (modeCoef5 B G Vn γ m') ξ i * Complex.exp (Complex.I * ((m' * pint5 B G γ - m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)))).re + ∑ γ ∈ Γ, ∑ m ∈ H, ∑ m' ∈ H, ((1/2 : ℂ) * (pq5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G Vn γ m ξ) (modeCoef5 B G Vo γ m') ξ i * Complex.exp (Complex.I * ((m * pint5 B G γ + m' * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) + pq5TrM B.h (m' * pint5 B G γ) (fun a => starRingEnd ℂ (modeCoef5 B G Vn γ m ξ a)) (modeCoef5 B G Vo γ m') ξ i * Complex.exp (Complex.I * ((m' * pint5 B G γ - m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)))).re + ∑ γ ∈ Γ, ∑ m ∈ H, (pq5TrM B.h (m * pint5 B G γ) (cr5Mc B G l0 S ξ) (modeCoef5 B G Vn γ m) ξ i * Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ))).re + ∑ γ ∈ Γ, ∑ m ∈ H, (pq5TrM B.h 0 (modeCoef5 B G Vn γ m ξ) (cr5Mc B G l0 S) ξ i * Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ))).re := by
    intro ξ θ Γ hq hΓ
    funext i
    have hPh : ∀ γ M, cr5Ph B G γ M ξ * ephase5 B G γ M θ ξ =
        ((qC B.h ξ ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) *
          Complex.exp (Complex.I * ((M * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) := by
      intro γ M
      have he := Complex.exp_ne_zero (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)))
      rw [hphase]
      unfold cr5Ph
      rw [mul_assoc, inv_mul_cancel_left₀ he]
    have alg : ∀ (P e Sx q E : ℂ), P * e = q * E → (1/2 * P) * Sx * e = q * (1/2 * (Sx * E)) := by
      intro P e Sx q E h
      linear_combination (1/2 * Sx) * h
    have hWWs : ∀ (V V' : WC) (γ : Lab), ∑ M ∈ Hq, cr5WW B G H V V' γ M ξ i * ephase5 B G γ M θ ξ =
        ((qC B.h ξ ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) * ((1/2 : ℂ) * ∑ m ∈ H, ∑ m' ∈ H,
          (pq5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G V γ m ξ) (modeCoef5 B G V' γ m') ξ i *
              Complex.exp (Complex.I * ((m * pint5 B G γ + m' * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) +
            pq5TrM B.h (m' * pint5 B G γ) (fun a => starRingEnd ℂ (modeCoef5 B G V γ m ξ a))
              (modeCoef5 B G V' γ m') ξ i *
              Complex.exp (Complex.I * ((m' * pint5 B G γ - m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)))) := by
      intro V V' γ
      have hM1 : ∀ M, cr5WW B G H V V' γ M ξ i * ephase5 B G γ M θ ξ =
