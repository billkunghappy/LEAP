theorem phase_bracket_nb_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C : ℝ, ∀ (l0 : ℕ) (γ : Lab) (ξ : Cyl) (U : Set Cyl) (a c : ℝ), l1 ≤ l0 → ActiveL4 B G γ → l0 ≤ γ.1 → ξ ∈ DomC B.h (qsOf l0) → 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 → B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → IsOpen U → ξ ∈ U → U ⊆ DomC B.h (qsOf l0) → (∀ η ∈ U, vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = a * lamT η.2.2.2 + c) → ContDiffOn ℝ ∞ (fun η : Cyl => Qb γ.1 * (ubase B η 0 * (sgn γ.2.2 * Bs5 B G γ * G.ustar / 2) / Real.sqrt (Qb γ.1) - vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * (fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (0:ℝ), (1:ℝ)) + ubase B η 0 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) + ubase B η 2 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))))) U ∧ NB B.h (fun η : Cyl => Qb γ.1 * (ubase B η 0 * (sgn γ.2.2 * Bs5 B G γ * G.ustar / 2) / Real.sqrt (Qb γ.1) - vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * (fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (0:ℝ), (1:ℝ)) + ubase B η 0 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) + ubase B η 2 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))))) k ξ ≤ C * SC B.h ξ :=
by
