    have hgerm : (fun η : Cyl => Qb γ.1 * fderiv ℝ F (η.1, η.2.1, η.2.2.1) ((0:ℝ), (0:ℝ), (1:ℝ)))
        =ᶠ[nhds ξ] fun η => fderiv ℝ (fun η' : Cyl => F (η'.1, η'.2.1, η'.2.2.1)) η (Lnorm B.h ξ wT) := by
      refine Filter.eventuallyEq_of_mem (hD.mem_nhds hξB) (fun η hη => ?_)
      rw [hcomp η hη, hvT, ContinuousLinearMap.map_smul, smul_eq_mul]
    have hNk1 : NB B.h (fun η : Cyl => F (η.1, η.2.1, η.2.2.1)) (j + 1) ξ ≤ |C3 (j + 1)| := by
      have hc := hC3 (j + 1) γ.1 l0 (by omega) hlγ ξ hξ hq1 hq2 hX1 hX2
      rcases hF with rfl | rfl
      · exact hc.1.trans (le_abs_self _)
      · exact hc.2.trans (le_abs_self _)
    have hN0 : 0 ≤ NB B.h (fun η : Cyl => F (η.1, η.2.1, η.2.2.1)) (j + 1) ξ := by
      unfold NB; exact norm_nonneg _
    have e : NB B.h (fun η : Cyl => Qb γ.1 * fderiv ℝ F (η.1, η.2.1, η.2.2.1) ((0:ℝ), (0:ℝ), (1:ℝ))) j ξ =
        NB B.h (fun η => fderiv ℝ (fun η' : Cyl => F (η'.1, η'.2.1, η'.2.2.1)) η (Lnorm B.h ξ wT)) j ξ := by
      unfold NB
      rw [(hgerm.iteratedFDeriv ℝ j).eq_of_nhds]
    rw [e]
    calc _ ≤ ‖wT‖ * NB B.h (fun η : Cyl => F (η.1, η.2.1, η.2.2.1)) (j + 1) ξ :=
          nbdir B.h _ ξ _ wT hD hξB hGs j
      _ ≤ 4 * |C3 (j + 1)| := mul_le_mul hnT hNk1 hN0 (by norm_num)

  obtain ⟨va, hva⟩ : ∃ va : Cyl → ℝ, va = fun η => a * lamT η.2.2.2 + c := ⟨_, rfl⟩
  obtain ⟨Ut0, hUt0⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl => Real.sqrt (Qb γ.1) * ubase B η 0 := ⟨_, rfl⟩
  obtain ⟨Ut2, hUt2⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl => pcB5 B γ.1 2 (η.1, η.2.1, η.2.2.1) := ⟨_, rfl⟩
  obtain ⟨TF, hTF⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl =>
      Qb γ.1 * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (0:ℝ), (1:ℝ)) := ⟨_, rfl⟩
  obtain ⟨TB, hTB⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl =>
      Qb γ.1 * fderiv ℝ (pcB5 B γ.1 2) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (0:ℝ), (1:ℝ)) := ⟨_, rfl⟩
  obtain ⟨RF, hRF⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl =>
      Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) := ⟨_, rfl⟩
  obtain ⟨RB, hRB⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl =>
      Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) := ⟨_, rfl⟩
  obtain ⟨ZF, hZF⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl =>
      Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)) := ⟨_, rfl⟩
  obtain ⟨ZB, hZB⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl =>
      Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)) := ⟨_, rfl⟩
  obtain ⟨Tt, hTt⟩ : ∃ f : Cyl → ℝ, f = fun η => pang5 B G γ * TF η + pzr5 B G γ * TB η := ⟨_, rfl⟩
  obtain ⟨Rt, hRt⟩ : ∃ f : Cyl → ℝ, f = fun η => pang5 B G γ * RF η + pzr5 B G γ * RB η := ⟨_, rfl⟩
