    obtain ⟨s1, d1, z1, b1⟩ := e1
    obtain ⟨s2, d2, z2, b2⟩ := e2
    refine ⟨(s1.add s2).congr heq, ?_, ?_, ?_⟩
    · intro ξ hξ a ha
