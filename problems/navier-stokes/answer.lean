  have hΛX0 : 0 ≤ Λ * X := mul_nonneg hΛpos.le hX0
  have hxO : ((X, η) : ℝ × ℝ) ∈ {X : ℝ | |Λ * X| < 5} ×ˢ Ioo (-1 - r / 2 / 2) (1 + r / 2 / 2) := by
