    have t4 : tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp z) = 1 - P.ρ := by
      unfold tailFac; rw [hs]; ring
    have t5 : Real.log (tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp z) / (1 - P.ρ)) = 0 := by
      rw [t4, div_self (by linarith), Real.log_one]
    rw [rfpLam, t1, t2, t3, t5]
    ring
  have h13 : 1300 ≤ 13 / P.lam := by rw [le_div_iff₀ hl0]; linarith
  have h1113 : 11 / P.lam ≤ 13 / P.lam := div_le_div_of_nonneg_right (by norm_num) hl0.le
  have hy3lo : rfpY2 P.Md + 1 ≤ rfpY3 P.Md P.lam := by rw [e3]; linarith
  have hy34 : rfpY3 P.Md P.lam ≤ rfpY4 P.Md P.lam := by rw [e4]; linarith
  have hAff : ∀ y, rfpY2 P.Md + 1 ≤ y → y ≤ rfpY4 P.Md P.lam →
      rfpLam P y = rfpLam P (rfpY3 P.Md P.lam) - (1 / 2 + P.lam) * (y - rfpY3 P.Md P.lam) := by
    intro y hy1 hy2
    rw [hLam y hy1 hy2, hLam _ hy3lo hy34]
    have a1 := Sig1 (rfpY3 P.Md P.lam) y (by linarith) (by linarith)
    have a2 := Sig1 (rfpY3 P.Md P.lam - rfpY2 P.Md) (y - rfpY2 P.Md) (by linarith) (by linarith)
    linear_combination (-(3 / 5 : ℝ)) * a1 - P.lam * a2
  have hW1 : ∀ y, rfpY2 P.Md + 1 ≤ y → y ≤ rfpY4 P.Md P.lam →
      y + rfpLam P y = (rfpY3 P.Md P.lam + rfpLam P (rfpY3 P.Md P.lam)) +
        (1 / 2 - P.lam) * (y - rfpY3 P.Md P.lam) := by
    intro y hy1 hy2; rw [hAff y hy1 hy2]; ring
  have hW2 : ∀ y, rfpY2 P.Md + 1 ≤ y → y ≤ rfpY4 P.Md P.lam →
      3 / 2 * y + 2 * rfpLam P y = (3 / 2 * rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam)) +
        (1 / 2 - 2 * P.lam) * (y - rfpY3 P.Md P.lam) := by
