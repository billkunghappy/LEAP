    have hfun : (fun x' => G x' u) = (u ^ e) • gu u := by
      funext x'
      simp only [hGd, Pi.smul_apply, smul_eq_mul]
    have hgc : ContDiffOn ℝ ∞ (gu u) {a : ℝ × ℝ × ℝ | sgc5ch B.h ξ0 a ∈ DomC B.h qs} := by
      rw [hgu]
      exact hFs.comp (hΦ.comp (contDiff_id.prodMk (contDiff_const (c := u)))).contDiffOn
