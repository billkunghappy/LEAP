  have hFb' : ∀ (p : ℝ × ℝ × ℝ × ℝ) (φ : ℝ), Fb (p, φ) =
      -(ts p + s p * Dn p (θ p φ)) * Fa (p, φ) := fun p φ => hFb _
  have hθ2 : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ × ℝ) × ℝ => ((w.1, θ w.1 w.2) :
      (ℝ × ℝ × ℝ × ℝ) × ℝ)) (U ×ˢ univ) := contDiffOn_fst.prodMk hθs
  have hDθ : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ × ℝ) × ℝ => Dn w.1 (θ w.1 w.2)) (U ×ˢ univ) :=
    hDn_s.comp hθ2 (fun w hw => ⟨hw.1, mem_univ _⟩)
  have hts1 : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ × ℝ) × ℝ => ts w.1) (U ×ˢ univ) :=
