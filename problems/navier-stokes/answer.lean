    have hv1 : |b * R⁻¹| ≤ 1 := by
      rw [abs_mul, abs_of_pos hRi]
      calc |b| * R⁻¹ ≤ R * R⁻¹ := mul_le_mul_of_nonneg_right hbR hRi.le
