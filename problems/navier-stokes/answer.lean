  have hb1' : |bgc * lamT w| ≤ 1/16 := by rw [abs_mul, abs_of_nonneg hbgc.1]; exact hb1
  have hb2' : |bgc * lamR w| ≤ 1/16 := by rw [abs_mul, abs_of_nonneg hbgc.1]; exact hb2
  have hw1 : |w.1| < 1/2 := by
    rw [hinv1]
    obtain ⟨a1, a2⟩ := abs_lt.mp hxiw
    obtain ⟨c1, c2⟩ := abs_le.mp hb1'
    exact abs_lt.mpr ⟨by linarith, by linarith⟩
  have hw2 : |w.2| < 1/2 := by
    rw [hinv2]
    obtain ⟨a1, a2⟩ := abs_lt.mp hetw
    obtain ⟨c1, c2⟩ := abs_le.mp hb2'
    exact abs_lt.mpr ⟨by linarith, by linarith⟩
  obtain ⟨K1, hK1⟩ : ∃ K : ℤ, K = round ((Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).1) := ⟨_, rfl⟩
  obtain ⟨K2, hK2⟩ : ∃ K : ℤ, K = round ((Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).2) := ⟨_, rfl⟩
  have hw1e : w.1 = (Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).1 - (K1 : ℝ) := by
    rw [hw, hK1]; rfl
  have hw2e : w.2 = (Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).2 - (K2 : ℝ) := by
    rw [hw, hK2]; rfl
  have hround : ∀ (x : ℝ) (K : ℤ), |x - (K : ℝ)| < 1/2 → round x = K := by
    intro x K hx
    rw [round_eq, Int.floor_eq_iff]
    obtain ⟨a, b⟩ := abs_lt.mp hx
    constructor <;> linarith
  have hJc : Continuous (fun Y' : ℝ × ℝ => Jpow (bandIdx B.h γ.1) Y' - G.ctr γ) := by
    unfold Jpow; fun_prop
  obtain ⟨V, hV⟩ : ∃ V : Set (ℝ × ℝ), V =
      {Y' : ℝ × ℝ | |(Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).1 - (K1 : ℝ)| < 1/2} ∩
      {Y' : ℝ × ℝ | |(Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).2 - (K2 : ℝ)| < 1/2} := ⟨_, rfl⟩
  have hVo : IsOpen V := by
    rw [hV]
    exact (isOpen_lt ((hJc.fst).sub continuous_const).abs continuous_const).inter
      (isOpen_lt ((hJc.snd).sub continuous_const).abs continuous_const)
  have hYV : ξ.2.2.2 ∈ V := by
    rw [hV]
    refine ⟨?_, ?_⟩
    · show |(Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).1 - (K1 : ℝ)| < 1/2
      rw [← hw1e]; exact hw1
    · show |(Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).2 - (K2 : ℝ)| < 1/2
      rw [← hw2e]; exact hw2
  have hfr : ∀ Y' ∈ V, rectW B.h γ (G.ctr γ) Y' =
      Jpow (bandIdx B.h γ.1) Y' - G.ctr γ - ((K1 : ℝ), (K2 : ℝ)) := by
    intro Y' hY'
    rw [hV] at hY'
    have r1 : round ((Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).1) = K1 := hround _ _ hY'.1
    have r2 : round ((Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).2) = K2 := hround _ _ hY'.2
    unfold rectW frac0
    rw [r1, r2]
    ext <;> simp

  obtain ⟨U, hU⟩ : ∃ U : Set Cyl, U = DomC B.h B.qB ∩ (fun η : Cyl => η.2.2.2) ⁻¹' V := ⟨_, rfl⟩
  have hUo : IsOpen U := by
    rw [hU]
    exact hDo.inter (hVo.preimage (by fun_prop))
  have hξU : ξ ∈ U := by rw [hU]; exact ⟨hξ, hYV⟩
  have hUsub : U ⊆ DomC B.h B.qB := by rw [hU]; exact Set.inter_subset_left
  have hUV : ∀ η ∈ U, η.2.2.2 ∈ V := by
    intro η hη
    rw [hU] at hη
    exact hη.2

  have hlamT_lin : ∀ a b : ℝ × ℝ, lamT (a - b) = lamT a - lamT b := by
    intro a b
    simp only [lamT, Prod.fst_sub, Prod.snd_sub]
    ring
  have hlamJ : ∀ Y' : ℝ × ℝ, lamT (Jpow (bandIdx B.h γ.1) Y') = Tgc ^ bandIdx B.h γ.1 * lamT Y' := by
    intro Y'
    simp only [lamT, Jpow, vrv, vtv, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    field_simp
    ring
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1 := ⟨_, rfl⟩
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = (G.r0 - lamT (G.ctr γ) - lamT ((K1 : ℝ), (K2 : ℝ))) / cib B.h γ.1 :=
    ⟨_, rfl⟩
  have hAff : ∀ η ∈ U, vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = A * lamT η.2.2.2 + c := by
    intro η hη
    simp only [vco, etG]
    rw [hfr _ (hUV η hη), hlamT_lin, hlamT_lin, hlamJ, hA, hc]
    ring

  set Ω := {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} with hΩe
  have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have hsQ : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr hQ
  have hRC : ∀ s ∈ Ω, pcRC5 γ.1 s ≠ 0 := fun s hs => div_ne_zero (ne_of_gt hs.1) hsQ.ne'
  have hRCs : ContDiff ℝ ∞ (pcRC5 γ.1) := by unfold pcRC5; fun_prop
  have hb : ∀ i, ContDiffOn ℝ ∞ (pcB5 B γ.1 i) Ω := fun i => hslowS γ.1 i
  have hFa : ContDiffOn ℝ ∞ (pcFa5 B γ.1) Ω := (hb 1).div hRCs.contDiffOn hRC
  have hP2 : ContDiffOn ℝ ∞ (pcPhi2_5 B G γ) Ω := by
    have := ((contDiffOn_const (c := pang5 B G γ)).mul hFa).add
      ((contDiffOn_const (c := pzr5 B G γ)).mul (hb 2))
    exact this

  obtain ⟨sl, hsl⟩ : ∃ sl : Cyl →L[ℝ] ℝ × ℝ × ℝ, sl =
    (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))).prod
      (((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))).prod
        ((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))))) := ⟨_, rfl⟩
  have hsld : ∀ d : Cyl, sl d = (d.1, d.2.1, d.2.2.1) := by
    intro d; rw [hsl]; rfl
  have hslA : ∀ η : Cyl, HasFDerivAt (fun x : Cyl => (x.1, x.2.1, x.2.2.1)) sl η := by
    intro η
    have e : (fun x : Cyl => (x.1, x.2.1, x.2.2.1)) = ⇑sl := funext fun x => (hsld x).symm
    rw [e]
    exact sl.hasFDerivAt
  obtain ⟨pY, hpY⟩ : ∃ pY : Cyl →L[ℝ] ℝ × ℝ, pY =
    (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
      (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))) := ⟨_, rfl⟩
  obtain ⟨ℓ, hℓdef⟩ : ∃ ℓ : Cyl →L[ℝ] ℝ, ℓ =
    (bgc / (1 + bgc ^ 2)) • ((ContinuousLinearMap.fst ℝ ℝ ℝ).comp pY) +
      (1 / (1 + bgc ^ 2)) • ((ContinuousLinearMap.snd ℝ ℝ ℝ).comp pY) := ⟨_, rfl⟩
  have hℓ : ∀ w : Cyl, ℓ w = lamT w.2.2.2 := by
    intro w
    rw [hℓdef, hpY]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.comp_apply, ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd',
      smul_eq_mul, lamT]
    ring
  have hl0 : lamT (0 : ℝ × ℝ) = 0 := by simp [lamT]
  have hlv : ∀ s : ℝ, lamT (s • vrv) = 0 := by
    intro s
    simp only [lamT, vrv, Prod.smul_mk, smul_eq_mul]
    ring
  have hlt : lamT vtv = 1 := by
    have e : lamT vtv = (bgc * bgc + 1) / (1 + bgc ^ 2) := rfl
    rw [e, div_eq_one_iff_eq hDen]
    ring

  obtain ⟨C1, hC1⟩ : ∃ C : ℝ, C = pzr5 B G γ / Qb γ.1 ^ (1/2 - B.h) / epsb B.h γ.1 := ⟨_, rfl⟩
  obtain ⟨C2, hC2⟩ : ∃ C : ℝ, C = sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 / Real.sqrt (Qb γ.1) := ⟨_, rfl⟩
  have hQa : 0 < Qb γ.1 ^ (1/2 - B.h) := Real.rpow_pos_of_pos hQ _
  have heps : 0 < epsb B.h γ.1 := by unfold epsb; exact Real.rpow_pos_of_pos hQ _
  have hsq : Real.sqrt (Qb γ.1) = Qb γ.1 ^ (1/2 - B.h) * epsb B.h γ.1 := by
    unfold epsb
    rw [Real.sqrt_eq_rpow, ← Real.rpow_add hQ]
    congr 1
    ring
  have hC1' : Real.sqrt (Qb γ.1) * C1 = pzr5 B G γ := by
    rw [hC1, hsq]
    field_simp

  have hT0 : (0:ℝ) < Tgc ^ bandIdx B.h γ.1 := by
    have : (0:ℝ) < Tgc := by unfold Tgc; positivity
    exact zpow_pos this _
  have hQA : 0 < Qb γ.1 ^ (1/2 + B.h) := Real.rpow_pos_of_pos hQ _
  have hsplit : Qb γ.1 ^ (1 + B.h) = Qb γ.1 ^ (1/2 + B.h) * Real.sqrt (Qb γ.1) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_add hQ]
    congr 1
    ring
  have hK : A * (Qb γ.1 ^ (1/2 + B.h) * Real.sqrt (Qb γ.1)) = 1 := by
    have hcib : cib B.h γ.1 = Tgc ^ bandIdx B.h γ.1 * (Qb γ.1 ^ (1/2 + B.h) * Real.sqrt (Qb γ.1)) := by
      unfold cib
      rw [hsplit]
    have hne : Tgc ^ bandIdx B.h γ.1 * (Qb γ.1 ^ (1/2 + B.h) * Real.sqrt (Qb γ.1)) ≠ 0 :=
      mul_ne_zero hT0.ne' (mul_ne_zero hQA.ne' hsQ.ne')
    rw [hA, hcib, div_mul_eq_mul_div, div_eq_one_iff_eq hne]

  have hmain : ∀ η ∈ U, eikP5 B G γ η = ubase B η 0 * (sgn γ.2.2 * Bs5 B G γ * G.ustar / 2) / Real.sqrt (Qb γ.1) - vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * (fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (0:ℝ), (1:ℝ)) + ubase B η 0 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) + ubase B η 2 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))) := by
    intro η hη
    have hs : (η.1, η.2.1, η.2.2.1) ∈ Ω := hUsub hη
    have d1 := ((hP2.contDiffAt (hΩ.mem_nhds hs)).differentiableAt (by simp)).hasFDerivAt
    have hPd : HasFDerivAt (fun y : Cyl => pcPhi2_5 B G γ (y.1, y.2.1, y.2.2.1))
        ((fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1)).comp sl) η :=
      HasFDerivAt.comp (g := pcPhi2_5 B G γ) (f := fun x : Cyl => (x.1, x.2.1, x.2.2.1)) η d1 (hslA η)
    have hY1 : HasFDerivAt (fun y : Cyl => y.2.1)
        ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))) η :=
      hasFDerivAt_snd.fst
    have hX : HasFDerivAt (fun y : Cyl => y.1) (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) η :=
      hasFDerivAt_fst
    have hv : HasFDerivAt (fun y : Cyl => A * ℓ y + c) (A • ℓ) η :=
      (ℓ.hasFDerivAt.const_mul A).add_const c
    have hF := ((hY1.const_mul C1).add (hX.const_mul C2)).sub (hv.mul hPd)
    have hev : phiL5 B G γ =ᶠ[nhds η] ((fun y : Cyl => C1 * y.2.1) + (fun y : Cyl => C2 * y.1) -
        ((fun y : Cyl => A * ℓ y + c) * (fun y : Cyl => pcPhi2_5 B G γ (y.1, y.2.1, y.2.2.1)))) := by
      refine Filter.eventuallyEq_of_mem (hUo.mem_nhds hη) (fun y hy => ?_)
      show phiL5 B G γ y = C1 * y.2.1 + C2 * y.1 - (A * ℓ y + c) * pcPhi2_5 B G γ (y.1, y.2.1, y.2.2.1)
      have hP : pang5 B G γ * Fang B γ.1 y + pzr5 B G γ * baseC B γ.1 y 2 =
          pcPhi2_5 B G γ (y.1, y.2.1, y.2.2.1) := rfl
      rw [hℓ y]
      simp only [phiL5]
      rw [hP, hAff y hy, hC1, hC2]
      unfold chartZ RC
      ring
    have hfd := (hev.fderiv_eq (𝕜 := ℝ)).trans hF.fderiv
    have key : ∀ d : Cyl, fderiv ℝ (phiL5 B G γ) η d = C1 * d.2.1 + C2 * d.1 -
        (vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) (d.1, d.2.1, d.2.2.1) +
          pcPhi2_5 B G γ (η.1, η.2.1, η.2.2.1) * (A * lamT d.2.2.2)) := by
      intro d
      rw [hfd, hAff η hη]
      simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.comp_apply, ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd',
        smul_eq_mul, hsld, hℓ]
    have hdT : dT (phiL5 B G γ) η = C1 * (0:ℝ) + C2 * (0:ℝ) -
        (vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (0:ℝ), (1:ℝ)) +
          pcPhi2_5 B G γ (η.1, η.2.1, η.2.2.1) * (A * lamT vtv)) :=
      key ((0:ℝ), (0:ℝ), (1:ℝ), vtv)
    have hdR : dR B.h (phiL5 B G γ) η = C1 * (0:ℝ) + C2 * (1:ℝ) -
        (vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) +
          pcPhi2_5 B G γ (η.1, η.2.1, η.2.2.1) * (A * lamT ((drx B.h * η.1 ^ (drx B.h - 1)) • vrv))) :=
      key ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv)
    have hdZ : dZ (phiL5 B G γ) η = C1 * (1:ℝ) + C2 * (0:ℝ) -
        (vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)) +
          pcPhi2_5 B G γ (η.1, η.2.1, η.2.2.1) * (A * lamT (0 : ℝ × ℝ))) :=
      key ((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ))
    have hΦ0 : pcPhi2_5 B G γ (η.1, η.2.1, η.2.2.1) =
        (pint5 B G γ : ℝ) / (kb B.h γ.1 : ℝ) *
          (Qb γ.1 ^ (1/2 + B.h) * ubase B η 1 / (η.1 / Real.sqrt (Qb γ.1))) +
        pzr5 B G γ * (Qb γ.1 ^ (1/2 + B.h) * ubase B η 2) := rfl
    have hΦ : pcPhi2_5 B G γ (η.1, η.2.1, η.2.2.1) =
        (pint5 B G γ : ℝ) / (kb B.h γ.1 : ℝ) *
          (Qb γ.1 ^ (1/2 + B.h) * ubase B η 1 * Real.sqrt (Qb γ.1) / η.1) +
        pzr5 B G γ * (Qb γ.1 ^ (1/2 + B.h) * ubase B η 2) := by
      rw [hΦ0, div_div_eq_mul_div]
    unfold eikP5
    rw [hdT, hdR, hdZ, hlt, hlv, hl0, hΦ]
    linear_combination
      (-(ubase B η 1 * (pint5 B G γ : ℝ) / ((kb B.h γ.1 : ℝ) * η.1) + ubase B η 2 * C1)) * hK +
      (ubase B η 2 * Qb γ.1 ^ (1/2 + B.h) * A) * hC1' + ubase B η 0 * hC2
  refine ⟨U, c, hUo, hξU, hUsub, fun η hη => ⟨?_, hmain η hη⟩⟩
  rw [← hA]
  exact hAff η hη

theorem chart_radial_nb_v5 : ∀ B : BG, B.ok → ContDiffOn ℝ ∞ (fun η : Cyl => ubase B η 0) (DomC B.h B.qB) ∧ ∀ k : ℕ, ∃ C : ℝ, ∀ (l : ℕ) (ξ : Cyl), ξ ∈ DomC B.h B.qB → 1/4 < qC B.h ξ / Qb l → B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → NB B.h (fun η : Cyl => Real.sqrt (Qb l) * ubase B η 0) k ξ ≤ C :=
by
  intro B hB
  obtain ⟨hh0, hh1, hXa, -, -, -, -, hqB0, hqB1, -, -, -, -⟩ := hB.2.1
  obtain ⟨-, -, -, -, -, hc6, ⟨-, -, hGV, hGVb⟩, -⟩ := hB.2
  have hS : SimScaleProps B.h := hB.1

  have hqpos : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hqC' : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) (DomC B.h B.qB) :=
    hqC'.mono (fun η hη => hη.2.1)
  have hDo : IsOpen (DomC B.h B.qB) := by
    have hT : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
    have h1 : IsOpen ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Iio B.qB) :=
      hqC'.continuousOn.isOpen_inter_preimage hT isOpen_Iio
    have h2 : IsOpen {η : Cyl | 0 < η.1} := isOpen_lt continuous_const continuous_fst
    have e : DomC B.h B.qB = {η : Cyl | 0 < η.1} ∩
        ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Iio B.qB) := by
      ext η
      exact ⟨fun h => ⟨h.1, h.2.1, h.2.2⟩, fun h => ⟨h.1, h.2.1, h.2.2⟩⟩
    rw [e]; exact h2.inter h1
  have hne : ∀ η ∈ DomC B.h B.qB, qC B.h η ≠ 0 := fun η hη => (hqpos η hη.2.1).ne'
  have hφ1 : ContDiffOn ℝ ∞ (fun η : Cyl => Real.log (qC B.h η)) (DomC B.h B.qB) := hqC.log hne
  have hφ2 : ContDiffOn ℝ ∞ (XC B.h) (DomC B.h B.qB) := by
    have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ 2) (DomC B.h B.qB) :=
      (contDiff_fst.pow 2).contDiffOn
    have h2 : ContDiffOn ℝ ∞ (fun η : Cyl => 2 * qC B.h η) (DomC B.h B.qB) :=
      contDiffOn_const.mul hqC
    exact (h1.div h2 (fun η hη => mul_ne_zero two_ne_zero (hne η hη))).congr (fun η _ => rfl)
  have hφ3 : ContDiffOn ℝ ∞ (etaC B.h) (DomC B.h B.qB) := by
    have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => η.2.1) (DomC B.h B.qB) := contDiff_snd.fst.contDiffOn
    exact (h1.mul (hqC.rpow_const_of_ne (p := -(1/2 - B.h)) hne)).congr (fun η _ => rfl)
  have hWo : IsOpen (Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) :=
    isOpen_Iio.prod (isOpen_Ioi.prod isOpen_Ioo)
  have hmaps : ∀ η ∈ DomC B.h B.qB, (Real.log (qC B.h η), XC B.h η, etaC B.h η) ∈
      Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := by
    intro η hη
    have hqη := hqpos η hη.2.1
    have hs : 0 < qC B.h η ^ (1/2 - B.h) := Real.rpow_pos_of_pos hqη _
    have hs2 : (qC B.h η ^ (1/2 - B.h)) ^ 2 = qC B.h η ^ (1 - 2 * B.h) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hqη.le]; congr 1; push_cast; ring
    have hz : η.2.1 ^ 2 < (qC B.h η ^ (1/2 - B.h)) ^ 2 := by
