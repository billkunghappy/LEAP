  have hcY : Continuous (fun η : Cyl => η.2.2.2) := by fun_prop

  have hc2 : ∀ t ∈ Set.Ioo (-(Lsb B.h G.r0 γ.1) / 2) (3 * Lsb B.h G.r0 γ.1 / 2),
      vco B.h G.r0 γ (G.ctr γ) (pulsePth5 B G γ ξ t).2.2.2 = t ∧
      ∃ κ : ℝ, ∀ᶠ η in nhds (pulsePth5 B G γ ξ t), vco B.h G.r0 γ (G.ctr γ) η.2.2.2 =
        Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1 * lamT η.2.2.2 + κ := by
    intro t ht
    have h1 : -(Lsb B.h G.r0 γ.1) / 2 * cib B.h γ.1 < t * cib B.h γ.1 :=
      mul_lt_mul_of_pos_right ht.1 hcb
    have h2 : t * cib B.h γ.1 < 3 * Lsb B.h G.r0 γ.1 / 2 * cib B.h γ.1 :=
      mul_lt_mul_of_pos_right ht.2 hcb
    have hab : |etG B.h γ (G.ctr γ) ξ.2.2.2 + (t - vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) * cib B.h γ.1| <
        2 * G.r0 := by
      rw [hetv, abs_lt]
      constructor <;> nlinarith
    obtain ⟨hv, κ, hκ⟩ := pzs_line_vco5 B.h G.r0 γ (G.ctr γ) ξ.2.2.2
      (t - vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) hr0 hr01 hxi hab
    rw [hP2 t]
    refine ⟨?_, κ, ?_⟩
    · show vco B.h G.r0 γ (G.ctr γ) (ξ.2.2.2 + (t - vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) •
        ((cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) • vtv)) = t
      rw [hv]; ring
    · exact (hcY.tendsto (shY ξ ((t - vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) •
        ((cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) • vtv)))).eventually hκ

  have hdich := pzs_nphi_line5 B G γ ξ
    (Set.Ioo (-(Lsb B.h G.r0 γ.1) / 2) (3 * Lsb B.h G.r0 γ.1 / 2))
    (Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1) (fun t ht => (hc2 t ht).1) (fun t ht => (hc2 t ht).2)

  obtain ⟨Pb, hPb⟩ := pzs_nphiP_bound5 B G γ ξ hL hdich

  have hn1 : ∀ t ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
      nPhi5 B G γ (pulsePth5 B G γ ξ t) 1 = pang5 B G γ / RC γ.1 ξ := by
    intro t _
    rw [hP2 t]
    simp only [nPhi5, Matrix.cons_val_one, Matrix.head_cons]
    rfl
  have hdichI : (∃ a0 b0 a2 b2 : ℝ, ∀ t ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
      nPhi5 B G γ (pulsePth5 B G γ ξ t) 0 = a0 - t * b0 ∧
        nPhi5 B G γ (pulsePth5 B G γ ξ t) 2 = a2 - t * b2) ∨
      (∀ t ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), t ≠ 0 →
        nPhi5 B G γ (pulsePth5 B G γ ξ t) 0 = 0 ∧ nPhi5 B G γ (pulsePth5 B G γ ξ t) 2 = 0) := by
    rcases hdich with ⟨a0, b0, a2, b2, h⟩ | h
    · exact Or.inl ⟨a0, b0, a2, b2, fun t ht => h t (hIccJ t ht)⟩
    · exact Or.inr fun t ht => h t (hIccJ t ht)
  obtain ⟨c, N, hc0, hcN⟩ := pzs_nsq_lower5 (Lsb B.h G.r0 γ.1) (pang5 B G γ / RC γ.1 ξ)
    (fun t => nPhi5 B G γ (pulsePth5 B G γ ξ t)) hL hn1 hdichI hnsq

  have hK : ∀ t : ℝ, Kmat B G γ (pulsePth5 B G γ ξ t) = Kmat B G γ ξ := fun t => by
    rw [hP2 t]; exact pzs_kmat_shift5 B G γ ξ _

  obtain ⟨C, hC⟩ := pzs_aphi_bound5 (Lsb B.h G.r0 γ.1) c N Pb
    (epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2) ((m : ℂ) ^ 2) (Kmat B G γ ξ)
    (fun t => nPhi5 B G γ (pulsePth5 B G γ ξ t)) (fun t => nPhiP5 B G γ (pulsePth5 B G γ ξ t)) hc0
    (fun t ht => ⟨(hcN t ht).1, (hcN t ht).2, hPb t ht⟩)
  have hMb : ∀ t ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), ∀ i j : Fin 3,
      ‖(pulseMatC (APhi5 B G γ (pulsePth5 B G γ ξ t)) -
        ((m : ℂ) ^ 2 * ((dDamp5 B G γ (pulsePth5 B G γ ξ t) : ℝ) : ℂ)) •
          (1 : Matrix (Fin 3) (Fin 3) ℂ)) i j‖ ≤ C := by
    intro t ht i j
    have h := hC t ht i j
    simp only [APhi5, dDamp5, hK t]
    exact h

  have hproj0 : ∀ η : Cyl, projT5 B G γ η 0 = 0 := by
    intro η; simp [projT5]
  have hlin : ∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), ∀ Z : Fin 3 → ℂ,
      pulseRhs5 B G f γ m (pulsePth5 B G γ ξ 0 + w • dVdir B.h γ.1) Z =
        (pulseMatC (APhi5 B G γ (pulsePth5 B G γ ξ w)) -
          ((m : ℂ) ^ 2 * ((dDamp5 B G γ (pulsePth5 B G γ ξ w) : ℝ) : ℂ)) •
            (1 : Matrix (Fin 3) (Fin 3) ℂ)).mulVec Z := by
    intro w hw Z
    rw [hP1 w]
    simp only [pulseRhs5, hsrc w hw, hproj0, sub_zero]
    rw [Matrix.sub_mulVec]
    congr 1
    rw [Matrix.smul_mulVec, Matrix.one_mulVec]
  have hex : ∃ Z : ℝ → (Fin 3 → ℂ), Z 0 = 0 ∧ ∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
      HasDerivWithinAt Z (pulseRhs5 B G f γ m (pulsePth5 B G γ ξ 0 + w • dVdir B.h γ.1) (Z w))
        (Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1)) w := by
    refine ⟨fun _ => 0, rfl, fun w hw => ?_⟩
    show HasDerivWithinAt (fun _ => (0 : Fin 3 → ℂ))
      (pulseRhs5 B G f γ m (pulsePth5 B G γ ξ 0 + w • dVdir B.h γ.1) 0)
      (Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1)) w
    rw [hlin w hw, Matrix.mulVec_zero]
    exact hasDerivWithinAt_const _ _ _
  have hspec := Classical.epsilon_spec hex
  have hZ0 : pulseZsol5 B G f γ m (pulsePth5 B G γ ξ 0) 0 = 0 := hspec.1
  have hZd : ∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
      HasDerivWithinAt (pulseZsol5 B G f γ m (pulsePth5 B G γ ξ 0))
        ((pulseMatC (APhi5 B G γ (pulsePth5 B G γ ξ w)) -
          ((m : ℂ) ^ 2 * ((dDamp5 B G γ (pulsePth5 B G γ ξ w) : ℝ) : ℂ)) •
            (1 : Matrix (Fin 3) (Fin 3) ℂ)).mulVec (pulseZsol5 B G f γ m (pulsePth5 B G γ ξ 0) w))
        (Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1)) w := by
    intro w hw
    have h := hspec.2 w hw
    rw [hlin w hw] at h
    exact h

  exact pzs_lin_ode_zero5 (Lsb B.h G.r0 γ.1) C
    (fun t => pulseMatC (APhi5 B G γ (pulsePth5 B G γ ξ t)) -
      ((m : ℂ) ^ 2 * ((dDamp5 B G γ (pulsePth5 B G γ ξ t) : ℝ) : ℂ)) • (1 : Matrix (Fin 3) (Fin 3) ℂ))
    (pulseZsol5 B G f γ m (pulsePth5 B G γ ξ 0)) hMb hZ0 hZd
    (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) ⟨hv0, hvL⟩

theorem pulse_rect_path_v5 : ∀ (h r0 : ℝ) (γ : Lab) (c : ℝ × ℝ), 0 < r0 → r0 ≤ 1/100 → (∀ (Y : ℝ × ℝ) (s : ℝ), |xiG h γ c Y| ≤ 4 * r0 → |etG h γ c Y + s * cib h γ.1| ≤ 4 * r0 → xiG h γ c (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) = xiG h γ c Y ∧ etG h γ c (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) = etG h γ c Y + s * cib h γ.1) ∧ (∀ a b : ℝ, 0 ≤ a → a ≤ 2 * r0 → 0 ≤ b → b ≤ 2 * r0 → IsClosed {Y : ℝ × ℝ | |xiG h γ c Y| ≤ a ∧ |etG h γ c Y| ≤ b}) ∧ (∀ Y0 : ℝ × ℝ, |xiG h γ c Y0| < 2 * r0 → |etG h γ c Y0| < 2 * r0 → ∃ U : Set (ℝ × ℝ), IsOpen U ∧ Y0 ∈ U ∧ ∃ k : ℝ × ℝ, ∀ Y ∈ U, rectW h γ c Y = Jpow (bandIdx h γ.1) Y - c - k) ∧ (∀ (Y k : ℝ × ℝ) (s : ℝ), lamR (Jpow (bandIdx h γ.1) (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) - c - k) = lamR (Jpow (bandIdx h γ.1) Y - c - k) ∧ lamT (Jpow (bandIdx h γ.1) (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) - c - k) = lamT (Jpow (bandIdx h γ.1) Y - c - k) + s * cib h γ.1) :=
by
  intro h r0 γ c hr0 hr01

  have hs1 : 1 < Real.sqrt 2 := Real.one_lt_sqrt_two
  have hs2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hbgc0 : 0 < bgc := by unfold bgc; linarith
  have hbgc1 : bgc < 1 := by unfold bgc; nlinarith
  have hD : (0:ℝ) < 1 + bgc ^ 2 := by positivity
  have hD' : (1:ℝ) + bgc ^ 2 ≠ 0 := hD.ne'
  have hTgc : Tgc ≠ 0 := by unfold Tgc; positivity

  have hlamR : ∀ (w : ℝ × ℝ) (t : ℝ), lamR (w + t • vtv) = lamR w := by
    intro w t
    simp only [lamR, vtv, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    congr 1; ring
  have hlamT : ∀ (w : ℝ × ℝ) (t : ℝ), lamT (w + t • vtv) = lamT w + t := by
    intro w t
    simp only [lamT, vtv, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    field_simp
    ring

  have hshift : ∀ (n : ℤ) (a s : ℝ) (Y : ℝ × ℝ),
      Jpow n (Y + s • ((a * Tgc ^ (-n)) • vtv)) = Jpow n Y + (s * a) • vtv := by
    intro n a s Y
    have e : s • ((a * Tgc ^ (-n)) • vtv) = (s * a * Tgc ^ (-n)) • vtv := by
      rw [smul_smul]; ring_nf
    rw [e]
    have h1 := hlamR Y (s * a * Tgc ^ (-n))
    have h2 := hlamT Y (s * a * Tgc ^ (-n))
    unfold lamR at h1
    unfold lamT at h2
    have hTn : Tgc ^ n ≠ 0 := zpow_ne_zero n hTgc
    have hk : Tgc ^ n * (s * a * Tgc ^ (-n)) = s * a := by
      rw [zpow_neg]; field_simp
    unfold Jpow
    rw [h1, h2, mul_add, add_smul, hk, add_assoc]

  have hcoord : ∀ w : ℝ × ℝ, |w.1| ≤ |lamR w| + |lamT w| ∧ |w.2| ≤ |lamR w| + |lamT w| := by
    intro w
    have e1 : w.1 = lamR w + bgc * lamT w := by unfold lamR lamT; field_simp; ring
    have e2 : w.2 = -bgc * lamR w + lamT w := by unfold lamR lamT; field_simp; ring
    have hb : |bgc| ≤ 1 := by rw [abs_of_pos hbgc0]; exact hbgc1.le
    have hm1 : |bgc * lamT w| ≤ |lamT w| := by
      rw [abs_mul]; exact mul_le_of_le_one_left (abs_nonneg _) hb
    have hm2 : |-bgc * lamR w| ≤ |lamR w| := by
      rw [abs_mul, abs_neg]; exact mul_le_of_le_one_left (abs_nonneg _) hb
    constructor
    · calc |w.1| = |lamR w + bgc * lamT w| := by rw [← e1]
        _ ≤ |lamR w| + |bgc * lamT w| := abs_add_le _ _
        _ ≤ |lamR w| + |lamT w| := by linarith
    · calc |w.2| = |-bgc * lamR w + lamT w| := by rw [← e2]
        _ ≤ |-bgc * lamR w| + |lamT w| := abs_add_le _ _
        _ ≤ |lamR w| + |lamT w| := by linarith

  have hround : ∀ (x : ℝ) (k : ℤ), |x - k| < 1/2 → round x = k := by
    intro x k hx
    have h0 : round (x - k) = 0 := by
      rw [round_eq_zero_iff]
      rw [abs_lt] at hx
      exact ⟨by linarith, by linarith⟩
    have := round_add_intCast (x - k) k
    rw [sub_add_cancel, h0, zero_add] at this
    exact this
  have hfr : ∀ Y : ℝ × ℝ, rectW h γ c Y = Jpow (bandIdx h γ.1) Y - c -
      ((((round (Jpow (bandIdx h γ.1) Y - c).1 : ℤ) : ℝ)), (((round (Jpow (bandIdx h γ.1) Y - c).2 : ℤ) : ℝ))) := by
    intro Y
    rfl
  have hnear : ∀ (Y : ℝ × ℝ) (k1 k2 : ℤ),
      |(Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ))).1| < 1/2 →
      |(Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ))).2| < 1/2 →
      rectW h γ c Y = Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ)) := by
    intro Y k1 k2 h1 h2
    rw [hfr, hround _ _ h1, hround _ _ h2]
  have hFc : Continuous (fun Y : ℝ × ℝ => Jpow (bandIdx h γ.1) Y - c) := by
    unfold Jpow; fun_prop
  have hlRc : Continuous lamR := by unfold lamR; fun_prop
  have hlTc : Continuous lamT := by unfold lamT; fun_prop
  refine ⟨?_, ?_, ?_, ?_⟩
  ·
    intro Y s hx hy
    obtain ⟨k1, hk1⟩ : ∃ k : ℤ, k = round (Jpow (bandIdx h γ.1) Y - c).1 := ⟨_, rfl⟩
    obtain ⟨k2, hk2⟩ : ∃ k : ℤ, k = round (Jpow (bandIdx h γ.1) Y - c).2 := ⟨_, rfl⟩
    have hf : rectW h γ c Y = Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ)) := by
      rw [hfr, hk1, hk2]
    have hgeq : Jpow (bandIdx h γ.1) (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) - c -
        ((k1 : ℝ), (k2 : ℝ)) =
        (Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ))) + (s * cib h γ.1) • vtv := by
      rw [hshift]; abel
    have hgR : lamR (Jpow (bandIdx h γ.1) (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) - c -
        ((k1 : ℝ), (k2 : ℝ))) = xiG h γ c Y := by
      rw [hgeq, hlamR]; unfold xiG; rw [hf]
    have hgT : lamT (Jpow (bandIdx h γ.1) (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) - c -
        ((k1 : ℝ), (k2 : ℝ))) = etG h γ c Y + s * cib h γ.1 := by
      rw [hgeq, hlamT]; unfold etG; rw [hf]
    have hb := hcoord (Jpow (bandIdx h γ.1) (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) - c -
        ((k1 : ℝ), (k2 : ℝ)))
    rw [hgR, hgT] at hb
    have hnr := hnear (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) k1 k2
      (by linarith [hb.1]) (by linarith [hb.2])
    constructor
    · unfold xiG; rw [hnr]; exact hgR
    · unfold etG; rw [hnr]; exact hgT
  ·
    intro a b _ ha _ hb
    apply isClosed_of_closure_subset
    intro Y0 hY0
    obtain ⟨U, hU⟩ : ∃ U : Set (ℝ × ℝ),
        U = (fun Y : ℝ × ℝ => Jpow (bandIdx h γ.1) Y - c) ⁻¹' Metric.ball (Jpow (bandIdx h γ.1) Y0 - c) (1/10) :=
      ⟨_, rfl⟩
    have hUo : IsOpen U := by rw [hU]; exact Metric.isOpen_ball.preimage hFc
    have hY0U : Y0 ∈ U := by
      rw [hU]; show Jpow (bandIdx h γ.1) Y0 - c ∈ Metric.ball (Jpow (bandIdx h γ.1) Y0 - c) (1/10)
      exact Metric.mem_ball_self (by norm_num)
    have hUd : ∀ Y ∈ U, dist (Jpow (bandIdx h γ.1) Y - c) (Jpow (bandIdx h γ.1) Y0 - c) < 1/10 := by
      intro Y hY
      rw [hU] at hY
      exact Metric.mem_ball.1 hY
    obtain ⟨Y1, hY1U, hY1S⟩ := _root_.mem_closure_iff.1 hY0 U hUo hY0U
    obtain ⟨k1, hk1⟩ : ∃ k : ℤ, k = round (Jpow (bandIdx h γ.1) Y1 - c).1 := ⟨_, rfl⟩
    obtain ⟨k2, hk2⟩ : ∃ k : ℤ, k = round (Jpow (bandIdx h γ.1) Y1 - c).2 := ⟨_, rfl⟩
    have hf1 : rectW h γ c Y1 = Jpow (bandIdx h γ.1) Y1 - c - ((k1 : ℝ), (k2 : ℝ)) := by
      rw [hfr, hk1, hk2]
    have hS1 : |xiG h γ c Y1| ≤ a ∧ |etG h γ c Y1| ≤ b := hY1S
    unfold xiG etG at hS1
    rw [hf1] at hS1
    have hc1 := hcoord (Jpow (bandIdx h γ.1) Y1 - c - ((k1 : ℝ), (k2 : ℝ)))
    have hd1 : ∀ p q : ℝ × ℝ, |p.1 - q.1| ≤ dist p q := fun p q => by
      rw [Prod.dist_eq, ← Real.dist_eq]; exact le_max_left _ _
    have hd2 : ∀ p q : ℝ × ℝ, |p.2 - q.2| ≤ dist p q := fun p q => by
      rw [Prod.dist_eq, ← Real.dist_eq]; exact le_max_right _ _
    have hUeq : ∀ Y ∈ U, rectW h γ c Y = Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ)) := by
      intro Y hY
      have hdY := hUd Y hY
      have hdY1 := hUd Y1 hY1U
      apply hnear Y k1 k2
      · have e : (Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ))).1 =
            ((Jpow (bandIdx h γ.1) Y - c).1 - (Jpow (bandIdx h γ.1) Y0 - c).1)
            - ((Jpow (bandIdx h γ.1) Y1 - c).1 - (Jpow (bandIdx h γ.1) Y0 - c).1)
            + (Jpow (bandIdx h γ.1) Y1 - c - ((k1 : ℝ), (k2 : ℝ))).1 := by
          show _ - (k1 : ℝ) = _ + (_ - (k1 : ℝ)); ring
        rw [e]
        have t1 := (hd1 (Jpow (bandIdx h γ.1) Y - c) (Jpow (bandIdx h γ.1) Y0 - c)).trans_lt hdY
        have t2 := (hd1 (Jpow (bandIdx h γ.1) Y1 - c) (Jpow (bandIdx h γ.1) Y0 - c)).trans_lt hdY1
        have t3 := hc1.1
        rw [abs_lt] at t1 t2 ⊢
        rw [abs_le] at t3
        have u1 := abs_le.1 hS1.1
        have u2 := abs_le.1 hS1.2
        constructor <;> linarith [t1.1, t1.2, t2.1, t2.2, t3.1, t3.2, u1.1, u1.2, u2.1, u2.2,
          abs_nonneg (lamR (Jpow (bandIdx h γ.1) Y1 - c - ((k1 : ℝ), (k2 : ℝ)))),
          abs_nonneg (lamT (Jpow (bandIdx h γ.1) Y1 - c - ((k1 : ℝ), (k2 : ℝ))))]
      · have e : (Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ))).2 =
            ((Jpow (bandIdx h γ.1) Y - c).2 - (Jpow (bandIdx h γ.1) Y0 - c).2)
            - ((Jpow (bandIdx h γ.1) Y1 - c).2 - (Jpow (bandIdx h γ.1) Y0 - c).2)
            + (Jpow (bandIdx h γ.1) Y1 - c - ((k1 : ℝ), (k2 : ℝ))).2 := by
          show _ - (k2 : ℝ) = _ + (_ - (k2 : ℝ)); ring
        rw [e]
        have t1 := (hd2 (Jpow (bandIdx h γ.1) Y - c) (Jpow (bandIdx h γ.1) Y0 - c)).trans_lt hdY
        have t2 := (hd2 (Jpow (bandIdx h γ.1) Y1 - c) (Jpow (bandIdx h γ.1) Y0 - c)).trans_lt hdY1
        have t3 := hc1.2
        rw [abs_lt] at t1 t2 ⊢
        rw [abs_le] at t3
        have u1 := abs_le.1 hS1.1
        have u2 := abs_le.1 hS1.2
        constructor <;> linarith [t1.1, t1.2, t2.1, t2.2, t3.1, t3.2, u1.1, u1.2, u2.1, u2.2,
          abs_nonneg (lamR (Jpow (bandIdx h γ.1) Y1 - c - ((k1 : ℝ), (k2 : ℝ)))),
          abs_nonneg (lamT (Jpow (bandIdx h γ.1) Y1 - c - ((k1 : ℝ), (k2 : ℝ))))]
    have hT : IsClosed {Y : ℝ × ℝ | |lamR (Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ)))| ≤ a ∧
        |lamT (Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ)))| ≤ b} :=
      (isClosed_le (hlRc.comp (hFc.sub continuous_const)).abs continuous_const).inter
        (isClosed_le (hlTc.comp (hFc.sub continuous_const)).abs continuous_const)
    have hsub : U ∩ {Y : ℝ × ℝ | |xiG h γ c Y| ≤ a ∧ |etG h γ c Y| ≤ b} ⊆
        {Y : ℝ × ℝ | |lamR (Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ)))| ≤ a ∧
          |lamT (Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ)))| ≤ b} := by
      rintro Y ⟨hYU, hYS⟩
      have hYS' : |xiG h γ c Y| ≤ a ∧ |etG h γ c Y| ≤ b := hYS
      unfold xiG etG at hYS'
      rw [hUeq Y hYU] at hYS'
      exact hYS'
    have hY0T := closure_minimal hsub hT (hUo.inter_closure ⟨hY0U, hY0⟩)
    show |xiG h γ c Y0| ≤ a ∧ |etG h γ c Y0| ≤ b
    unfold xiG etG
    rw [hUeq Y0 hY0U]
    exact hY0T
  ·
    intro Y0 hx hy
    obtain ⟨k1, hk1⟩ : ∃ k : ℤ, k = round (Jpow (bandIdx h γ.1) Y0 - c).1 := ⟨_, rfl⟩
    obtain ⟨k2, hk2⟩ : ∃ k : ℤ, k = round (Jpow (bandIdx h γ.1) Y0 - c).2 := ⟨_, rfl⟩
    have hf : rectW h γ c Y0 = Jpow (bandIdx h γ.1) Y0 - c - ((k1 : ℝ), (k2 : ℝ)) := by
      rw [hfr, hk1, hk2]
    unfold xiG at hx
    unfold etG at hy
    rw [hf] at hx hy
    have hb := hcoord (Jpow (bandIdx h γ.1) Y0 - c - ((k1 : ℝ), (k2 : ℝ)))
    refine ⟨{Y : ℝ × ℝ | |(Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ))).1| < 1/2} ∩
      {Y : ℝ × ℝ | |(Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ))).2| < 1/2}, ?_, ?_,
      ((k1 : ℝ), (k2 : ℝ)), ?_⟩
    · exact (isOpen_lt ((hFc.sub continuous_const).fst.abs) continuous_const).inter
        (isOpen_lt ((hFc.sub continuous_const).snd.abs) continuous_const)
    · refine ⟨?_, ?_⟩
      · rw [Set.mem_setOf_eq]; linarith [hb.1]
      · rw [Set.mem_setOf_eq]; linarith [hb.2]
    · rintro Y ⟨h1, h2⟩
      exact hnear Y k1 k2 h1 h2
  ·
    intro Y k s
    rw [hshift]
    have e : Jpow (bandIdx h γ.1) Y + (s * cib h γ.1) • vtv - c - k =
        (Jpow (bandIdx h γ.1) Y - c - k) + (s * cib h γ.1) • vtv := by abel
    rw [e, hlamR, hlamT]
    exact ⟨rfl, rfl⟩

theorem pulse_tw_supp_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (α : ℝ) (f : WC), InWg5 B G (qsOf l0) α f → ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (pulseTw5 B G f γ m) → m ≠ 0 ∧ ActiveL4 B G γ ∧ l0 ≤ γ.1 ∧ 1/4 < qC B.h ξ / Qb γ.1 ∧ qC B.h ξ / Qb γ.1 < 4 ∧ B.Xa ≤ XC B.h ξ ∧ XC B.h ξ ≤ B.Xb ∧ ξ ∈ tsupport (etaL B.h γ) ∧ |xiG B.h γ (G.ctr γ) ξ.2.2.2| ≤ G.r0 / 4 ∧ 0 ≤ vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 ∧ vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 ≤ Lsb B.h G.r0 γ.1 :=
by
  intro B G hok hG
  obtain ⟨lS, hS⟩ := pulse_support_good_v5 B G hok hG
  refine ⟨lS, ?_⟩
  intro l0 hl0 α f hf γ m ξ hξ ht
  have hr0 : 0 < G.r0 := hG.1.1
  have hr1 : G.r0 ≤ 1/100 := hG.1.2.1
  obtain ⟨hDo, hqCd, hq0, hXc, -, -⟩ := domc_open_calculus B (qsOf l0) hok
  obtain ⟨hRa, hRb, -, -⟩ := pulse_rect_path_v5 B.h G.r0 γ (G.ctr γ) hr0 hr1
  have hcib : 0 < cib B.h γ.1 := by
    unfold cib
    exact mul_pos (zpow_pos (by unfold Tgc; positivity) _)
      (Real.rpow_pos_of_pos (by unfold Qb; positivity) _)

  have hsl : ∀ (η : Cyl) (s : ℝ), (η + s • dVdir B.h γ.1).1 = η.1 ∧
      (η + s • dVdir B.h γ.1).2.1 = η.2.1 ∧ (η + s • dVdir B.h γ.1).2.2.1 = η.2.2.1 ∧
      (η + s • dVdir B.h γ.1).2.2.2 =
        η.2.2.2 + s • ((cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) • vtv) := by
    intro η s
    simp [dVdir]
  have hqT : ∀ (η : Cyl) (s : ℝ), qC B.h (η + s • dVdir B.h γ.1) = qC B.h η := by
    intro η s
    obtain ⟨-, h2, h3, -⟩ := hsl η s
    unfold qC
    rw [h2, h3]
  have hXT : ∀ (η : Cyl) (s : ℝ), XC B.h (η + s • dVdir B.h γ.1) = XC B.h η := by
    intro η s
    obtain ⟨h1, -, -, -⟩ := hsl η s
    unfold XC
    rw [hqT, h1]
  have hDT : ∀ (η : Cyl) (s : ℝ), η ∈ DomC B.h (qsOf l0) →
      η + s • dVdir B.h γ.1 ∈ DomC B.h (qsOf l0) := by
    intro η s hη
    obtain ⟨h1, -, h3, -⟩ := hsl η s
    obtain ⟨e1, e2, e3⟩ := hη
    show 0 < (η + s • dVdir B.h γ.1).1 ∧ (η + s • dVdir B.h γ.1).2.2.1 < 1 ∧
      qC B.h (η + s • dVdir B.h γ.1) < qsOf l0
    rw [h1, h3, hqT]
    exact ⟨e1, e2, e3⟩
  have hEtaT : ∀ (η : Cyl) (s : ℝ), etaL B.h γ (η + s • dVdir B.h γ.1) = etaL B.h γ η := by
    intro η s
    obtain ⟨h1, h2, h3, -⟩ := hsl η s
    unfold etaL chartR chartZ chartT
    rw [hqT, h1, h2, h3]
  have hTsT : ∀ (η : Cyl) (s : ℝ), η + s • dVdir B.h γ.1 ∈ tsupport (etaL B.h γ) →
      η ∈ tsupport (etaL B.h γ) := by
    intro η s h
    have hc : etaL B.h γ ∘ ⇑(Homeomorph.addRight (s • dVdir B.h γ.1)) = etaL B.h γ := by
      funext x
      rw [Function.comp_apply, Homeomorph.coe_addRight]
      exact hEtaT x s
    have e := tsupport_comp_eq_preimage (etaL B.h γ) (Homeomorph.addRight (s • dVdir B.h γ.1))
    rw [hc] at e
    rw [e, Set.mem_preimage, Homeomorph.coe_addRight]
    exact h

  have hP : ∀ η ∈ DomC B.h (qsOf l0), pulseTw5 B G f γ m η ≠ 0 →
      m ≠ 0 ∧ ActiveL4 B G γ ∧ l0 ≤ γ.1 ∧ B.Xa ≤ XC B.h η ∧ XC B.h η ≤ B.Xb ∧
      η ∈ tsupport (etaL B.h γ) ∧ |xiG B.h γ (G.ctr γ) η.2.2.2| ≤ G.r0 / 4 ∧
      |etG B.h γ (G.ctr γ) η.2.2.2| ≤ G.r0 := by
    intro η hη hne
    have hgood : pulseGood5 B G γ m η := by
      by_contra hng
      exact hne (by simp only [pulseTw5, if_neg hng])
    obtain ⟨hm, hAct, hxi, hv0, hvL, -⟩ := hgood
    have hsrc : ∃ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
        srcHat B f γ m (pulsePth5 B G γ η w) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hne (pulse_zero_src_v5 B G f γ m η hok hG hcon)
    obtain ⟨w, hw, hsw⟩ := hsrc
    obtain ⟨s, hs⟩ : ∃ s : ℝ, s = w - vco B.h G.r0 γ (G.ctr γ) η.2.2.2 := ⟨_, rfl⟩
    have hζ : pulsePth5 B G γ η w = η + s • dVdir B.h γ.1 := by
      rw [hs]; rfl
    have hfne : f γ m (η + s • dVdir B.h γ.1) ≠ 0 := by
      intro h0
      apply hsw
      rw [hζ]
      simp only [srcHat, h0, smul_zero]
    have hζD := hDT η s hη
    have hζt : η + s • dVdir B.h γ.1 ∈ tsupport (f γ m) := subset_tsupport _ hfne
    obtain ⟨hSW, -, hl, -⟩ := hS l0 hl0 α f hf γ m _ hζD hζt
    obtain ⟨-, hEtζ, hxiζ, -, hX1, hX2⟩ := hSW
    rw [hXT] at hX1 hX2
    obtain ⟨-, -, -, h4⟩ := hsl η s
    have hetaη : etG B.h γ (G.ctr γ) η.2.2.2 =
        vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * cib B.h γ.1 - G.r0 := by
      unfold vco
      rw [div_mul_cancel₀ _ hcib.ne']
      ring
    have hwc : w * cib B.h γ.1 ≤ 2 * G.r0 := by
      have := mul_le_mul_of_nonneg_right hw.2 hcib.le
      unfold Lsb at this
      rwa [div_mul_cancel₀ _ hcib.ne'] at this
    have hwc0 : 0 ≤ w * cib B.h γ.1 := mul_nonneg hw.1 hcib.le
    have hbox : |etG B.h γ (G.ctr γ) η.2.2.2 + s * cib B.h γ.1| ≤ 4 * G.r0 := by
      have e : etG B.h γ (G.ctr γ) η.2.2.2 + s * cib B.h γ.1 = w * cib B.h γ.1 - G.r0 := by
        rw [hetaη, hs]; ring
      rw [e, abs_le]
      constructor <;> linarith
    have hxi4 : |xiG B.h γ (G.ctr γ) η.2.2.2| ≤ 4 * G.r0 := by linarith
    have hxe := (hRa η.2.2.2 s hxi4 hbox).1
    rw [h4, hxe] at hxiζ
    have hvc0 : 0 ≤ vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * cib B.h γ.1 := mul_nonneg hv0 hcib.le
    have hvcL : vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * cib B.h γ.1 ≤ 2 * G.r0 := by
      have := mul_le_mul_of_nonneg_right hvL hcib.le
      unfold Lsb at this
      rwa [div_mul_cancel₀ _ hcib.ne'] at this
    have het : |etG B.h γ (G.ctr γ) η.2.2.2| ≤ G.r0 := by
      rw [hetaη, abs_le]
      constructor <;> linarith
    exact ⟨hm, hAct, hl, hX1, hX2, hTsT η s hEtζ, hxiζ, het⟩

  obtain ⟨S, hSdef⟩ : ∃ S : Set Cyl,
      S = DomC B.h (qsOf l0) ∩ Function.support (pulseTw5 B G f γ m) := ⟨_, rfl⟩
  have hSD : ∀ η ∈ S, η ∈ DomC B.h (qsOf l0) := by
    intro η hη; rw [hSdef] at hη; exact hη.1
  have hSne : ∀ η ∈ S, pulseTw5 B G f γ m η ≠ 0 := by
    intro η hη; rw [hSdef] at hη; exact hη.2
  have hξcl : ξ ∈ closure S := by
    rw [hSdef]
    exact hDo.inter_closure (t := Function.support (pulseTw5 B G f γ m)) ⟨hξ, ht⟩
  obtain ⟨η0, hη0⟩ : S.Nonempty := closure_nonempty_iff.mp ⟨ξ, hξcl⟩
  obtain ⟨hm, hAct, hl, -⟩ := hP η0 (hSD η0 hη0) (hSne η0 hη0)
  have hSEt : S ⊆ tsupport (etaL B.h γ) := by
    intro η hη
    exact (hP η (hSD η hη) (hSne η hη)).2.2.2.2.2.1
  have hEt : ξ ∈ tsupport (etaL B.h γ) :=
    closure_minimal hSEt (isClosed_tsupport (etaL B.h γ)) hξcl
  obtain ⟨K, hKdef⟩ : ∃ K : Set (ℝ × ℝ),
      K = {Y : ℝ × ℝ | |xiG B.h γ (G.ctr γ) Y| ≤ G.r0 / 4 ∧ |etG B.h γ (G.ctr γ) Y| ≤ G.r0} :=
    ⟨_, rfl⟩
  have hKc : IsClosed K := by
    rw [hKdef]
    exact hRb (G.r0 / 4) G.r0 (by linarith) (by linarith) hr0.le (by linarith)
  have hpc : Continuous (fun x : Cyl => x.2.2.2) :=
    continuous_snd.comp (continuous_snd.comp continuous_snd)
  have hSK : S ⊆ (fun x : Cyl => x.2.2.2) ⁻¹' K := by
    intro η hη
    rw [Set.mem_preimage, hKdef]
    have h := hP η (hSD η hη) (hSne η hη)
    exact ⟨h.2.2.2.2.2.2.1, h.2.2.2.2.2.2.2⟩
  have hξK : ξ ∈ (fun x : Cyl => x.2.2.2) ⁻¹' K :=
    closure_minimal hSK (hKc.preimage hpc) hξcl
  rw [Set.mem_preimage, hKdef] at hξK
  obtain ⟨hxiξ, hetξ⟩ := hξK
  have hvξ0 : 0 ≤ vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 := by
    unfold vco
    exact div_nonneg (by linarith [(abs_le.mp hetξ).1]) hcib.le
  have hvξL : vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 ≤ Lsb B.h G.r0 γ.1 := by
    unfold vco Lsb
    rw [div_le_div_iff_of_pos_right hcib]
    linarith [(abs_le.mp hetξ).2]
  have hXcw : ContinuousWithinAt (XC B.h) S ξ :=
    (hXc.continuousWithinAt hξ).mono (fun η hη => hSD η hη)
  have hSX : Set.MapsTo (XC B.h) S (Set.Icc B.Xa B.Xb) := by
    intro η hη
    have h := hP η (hSD η hη) (hSne η hη)
    exact ⟨h.2.2.2.1, h.2.2.2.2.1⟩
  have hXI : XC B.h ξ ∈ closure (Set.Icc B.Xa B.Xb) := hXcw.mem_closure hξcl hSX
  rw [isClosed_Icc.closure_eq] at hXI
  have hqw : 1/2 ≤ qC B.h ξ / Qb γ.1 ∧ qC B.h ξ / Qb γ.1 ≤ 2 := by
    obtain ⟨T, hTdef⟩ : ∃ T : Set Cyl,
        T = DomC B.h (qsOf l0) ∩ Function.support (etaL B.h γ) := ⟨_, rfl⟩
    have hTD : ∀ x ∈ T, x ∈ DomC B.h (qsOf l0) := by
      intro x hx; rw [hTdef] at hx; exact hx.1
    have hTne : ∀ x ∈ T, etaL B.h γ x ≠ 0 := by
      intro x hx; rw [hTdef] at hx; exact hx.2
    have hcl2 : ξ ∈ closure T := by
      rw [hTdef]
      exact hDo.inter_closure (t := Function.support (etaL B.h γ)) ⟨hξ, hEt⟩
    have hgo : ContinuousOn (fun x => qC B.h x / Qb γ.1) (DomC B.h (qsOf l0)) :=
      hqCd.continuousOn.div_const (Qb γ.1)
    have hgc : ContinuousWithinAt (fun x => qC B.h x / Qb γ.1) T ξ :=
      (hgo.continuousWithinAt hξ).mono (fun x hx => hTD x hx)
    have hTm : Set.MapsTo (fun x => qC B.h x / Qb γ.1) T (Set.Icc (1/2 : ℝ) 2) := by
      intro x hx
      have h := etaL_band_window_v5 B.h γ x (hq0 x (hTD x hx)) (hTne x hx)
      exact ⟨h.1.le, h.2.le⟩
    have hmem : qC B.h ξ / Qb γ.1 ∈ closure (Set.Icc (1/2 : ℝ) 2) := hgc.mem_closure hcl2 hTm
    rw [isClosed_Icc.closure_eq] at hmem
    exact hmem
  exact ⟨hm, hAct, hl, by linarith [hqw.1], by linarith [hqw.2], hXI.1, hXI.2, hEt, hxiξ,
    hvξ0, hvξL⟩

theorem pulse_tw_deck_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (α : ℝ) (f : WC), InWg5 B G (qsOf l0) α f → ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ∀ c, IsDeck B.h (qC B.h ξ) c → 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 → pulseTw5 B G f γ m (shY ξ c) = pulseTw5 B G f γ m ξ ∧ psiW B G γ (shY ξ c) = psiW B G γ ξ ∧ psiWd B G γ (shY ξ c) = psiWd B G γ ξ :=
by
  intro B G hok hG
  obtain ⟨hh0, hh1, -⟩ := hok.2.1

  have hGapG : ∀ h : ℝ, 0 < h → h < 1/100 → ∀ (l l0 : ℕ) (q : ℝ), 11 ≤ l0 → 0 < q → q < qsOf l0 →
      1/4 < q / Qb l → q / Qb l < 4 → coarseIdx h q ≤ bandIdx h l ∧ bandIdx h l ≤ coarseIdx h q + 3 := by
    intro h hh0 hh1 l l0 q hl0 hq hqs hr1 hr2
    have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have hs0 : 0 < Real.sqrt 2 := Real.sqrt_pos.mpr (by norm_num)
    have hT4 : (4:ℝ) < Tgc := by unfold Tgc; linarith
    have hT1 : 1 < Tgc := by linarith
    have hlT0 : 0 < Real.log Tgc := Real.log_pos hT1
    have hlog4 : Real.log 4 = 2 * Real.log 2 := by
      rw [show (4:ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; norm_num
    have hlT4 : 2 * Real.log 2 < Real.log Tgc := by
      rw [← hlog4]; exact Real.log_lt_log (by norm_num) hT4
    have hln2 := Real.log_two_gt_d9
    have hbof : bandOf q = ⌈-Real.log q / Real.log 2⌉₊ := by
      unfold bandOf Real.logb
      rw [one_div, Real.log_inv]
    have hqsv : qsOf l0 = (2:ℝ) ^ (-(l0:ℝ)) := rfl
    have hQbv : Qb l = (2:ℝ) ^ (-(l:ℝ)) := rfl
    have hP : 0 < Qb l := by rw [hQbv]; exact Real.rpow_pos_of_pos two_pos _
    have h1 : Real.log q < -(l0:ℝ) * Real.log 2 := by
      have := Real.log_lt_log hq hqs
      rwa [hqsv, Real.log_rpow two_pos] at this
    have hlogr : Real.log (q / Qb l) = Real.log q + (l:ℝ) * Real.log 2 := by
      rw [Real.log_div hq.ne' hP.ne', hQbv, Real.log_rpow two_pos]; ring
    have hr0 : 0 < q / Qb l := div_pos hq hP
    have h2 : -(2 * Real.log 2) < Real.log q + (l:ℝ) * Real.log 2 := by
      have := Real.log_lt_log (by norm_num) hr1
      rwa [hlogr, one_div, Real.log_inv, hlog4] at this
    have h3 : Real.log q + (l:ℝ) * Real.log 2 < 2 * Real.log 2 := by
      have := Real.log_lt_log hr0 hr2
      rwa [hlogr, hlog4] at this
    obtain ⟨b, hb⟩ : ∃ b : ℕ, b = bandOf q := ⟨_, rfl⟩
    have hl0R : (11:ℝ) ≤ l0 := by exact_mod_cast hl0
    have hx0 : (l0:ℝ) < -Real.log q / Real.log 2 := by rw [lt_div_iff₀ hl2]; linarith
    have hxl1 : -Real.log q / Real.log 2 < (l:ℝ) + 2 := by rw [div_lt_iff₀ hl2]; linarith
    have hxl2 : (l:ℝ) - 2 < -Real.log q / Real.log 2 := by rw [lt_div_iff₀ hl2]; linarith
    have hle : -Real.log q / Real.log 2 ≤ b := by rw [hb, hbof]; exact Nat.le_ceil _
    have hlt : (b:ℝ) < -Real.log q / Real.log 2 + 1 := by
      rw [hb, hbof]; exact Nat.ceil_lt_add_one (by linarith)
    have hb12 : 12 ≤ b := by
      have h' : (11:ℝ) < b := by linarith
      have h'' : 11 < b := by exact_mod_cast h'
      omega
    have hbl : b ≤ l + 2 := by
      have h' : (b:ℝ) < (l:ℝ) + 3 := by linarith
      have h'' : b < l + 3 := by exact_mod_cast h'
      omega
    have hlb : l ≤ b + 1 := by
      have h' : (l:ℝ) < (b:ℝ) + 2 := by linarith
      have h'' : l < b + 2 := by exact_mod_cast h'
      omega
    obtain ⟨a, ha⟩ : ∃ a : ℕ, a = b - 4 := ⟨_, rfl⟩
    have hcI : coarseIdx h q = bandIdx h a := by
      unfold coarseIdx; rw [← hb, ← ha]
    have ha5 : 5 ≤ a := by omega
    have hal : a ≤ l := by omega
    have hla : l ≤ a + 5 := by omega
    obtain ⟨φ, hφ⟩ : ∃ φ : ℕ → ℝ, φ = fun m : ℕ => (1 + h) * (m:ℝ) * Real.log 2 - 2 * Real.log (m:ℝ) :=
      ⟨_, rfl⟩
    have hφv : ∀ m : ℕ, φ m = (1 + h) * (m:ℝ) * Real.log 2 - 2 * Real.log (m:ℝ) := fun m => by rw [hφ]
    have hφdef : ∀ m : ℕ, 1 ≤ m → bandIdx h m = ⌊φ m / Real.log Tgc⌋ := by
      intro m hm
      have hm0 : (0:ℝ) < m := by exact_mod_cast hm
      unfold bandIdx
      congr 1
      unfold Real.logb
      rw [hφv, Real.log_div (Real.rpow_pos_of_pos two_pos _).ne' (pow_pos hm0 2).ne',
        Real.log_rpow two_pos, Real.log_pow]
      push_cast; ring
    have haR : (5:ℝ) ≤ a := by exact_mod_cast ha5
    have halR : (a:ℝ) ≤ l := by exact_mod_cast hal
    have hlaR : (l:ℝ) ≤ a + 5 := by exact_mod_cast hla
    have ha0 : (0:ℝ) < a := by linarith
    have hlpos : (0:ℝ) < l := by linarith
    have hg0 : 0 ≤ Real.log (l:ℝ) - Real.log (a:ℝ) := by
      have := Real.log_le_log ha0 halR; linarith
    have hg1 : (a:ℝ) * (Real.log (l:ℝ) - Real.log (a:ℝ)) ≤ (l:ℝ) - a := by
