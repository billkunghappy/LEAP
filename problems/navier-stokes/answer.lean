  rw [hsub, setIntegral_congr_fun measurableSet_Iic hpt]
  have iA : Integrable (fun y => (η * (1 + η ^ 2)⁻¹) *
      (Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * rfpK P.Md y))
      (volume.restrict (Iic (rfpY4 P.Md P.lam))) := hI0.const_mul _
  have iR : Integrable (fun y => (((1 + η ^ 2)⁻¹) ^ 2 * P.Amp η) *
