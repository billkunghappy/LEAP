    have h2 := hvD Dr hDrb
    have h3 := abs_add_le (sgn γ.2.2 * Bs5 B G γ * G.ustar / 2) (v * -Dr)
    rw [hN]; linarith
  have b1 : |(a + v • p) 1| ≤ N := by
    rw [e1, hN]; linarith
  have b2 : |(a + v • p) 2| ≤ N := by
    rw [e2]
    have h2 := hvD Dz hDzb
    have h3 := abs_add_le (pzr5 B G γ) (v * -Dz)
    rw [hN]; linarith
  have hnb : ∀ i, |(a + v • p) i| ≤ N := by
    intro i; fin_cases i
    · exact b0
    · exact b1
    · exact b2
  have hp0 : p 0 = -Dr := by rw [hpD]; rfl
  have hp1 : p 1 = 0 := by rw [hpD]; rfl
  have hp2 : p 2 = -Dz := by rw [hpD]; rfl
  have hpb : ∀ i, |p i| ≤ CD := by
    intro i; fin_cases i
    · show |p 0| ≤ CD
      rw [hp0, abs_neg]; exact hDrb
    · show |p 1| ≤ CD
      rw [hp1, abs_zero]; exact hCD0
    · show |p 2| ≤ CD
      rw [hp2, abs_neg]; exact hDzb
  have hν1' : ν ≤ (a + v • p) 1 ^ 2 := by rw [e1]; exact hν1

  obtain ⟨hrect, hline⟩ := pulse_line_base5 B.h G.r0 γ (G.ctr γ) hr0 hr01
  obtain ⟨hvco, hin, -⟩ := pulse_line_rect5 B.h G.r0 γ (G.ctr γ)
