    have hP0' := hP0.trans (le_abs_self (M 0))
    have hN0' := hN0.trans (le_abs_self (M 0))
    have hP1' := hP1.trans (le_abs_self (M 1))
    have hN1' := hN1.trans (le_abs_self (M 1))
    obtain ⟨θ, hθ⟩ : ∃ θ : ℝ, θ = axTheta Λ om y := ⟨_, rfl⟩
    obtain ⟨β, hβ⟩ : ∃ β : ℝ, β = axBeta Λ om y := ⟨_, rfl⟩
    obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, κ = axKap κ0 t1 y := ⟨_, rfl⟩
