  · rw [hLSh, if_neg]
    simpa using hm
  · intro γ m
    rw [hLSh]
    split_ifs
    · exact ι.toContinuousLinearMap.contDiff.comp_contDiffOn (hLS γ).1
    · exact contDiffOn_const
  · intro γ m ξ hξ a ha
    rw [hLSh]
    split_ifs
    · simp only [Function.comp_apply]
      rw [hdeck γ ξ hξ a ha]
    · rfl
  · intro γ m ξ hξ hne
    rw [hLSh] at hne
    split_ifs at hne
    · have h0 : LSc5 B G l0 S γ ξ ≠ 0 := by
        intro h0
        apply hne
