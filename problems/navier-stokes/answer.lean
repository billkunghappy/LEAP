      rw [haQ, haP, haS, haR, ← E1, ← E2, ← E3]
      linear_combination (2 * qC B.h ξ ^ (1 - B.h / 2) / 4 * 4 ^ k * K1 * qC B.h ξ ^ (-1:ℝ) * (1 + Cq) ^ k *
        CP * SC B.h ξ ^ bP * (2 * CS) * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bS *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dS) * K2 *
        ((1 + CP / c) ^ k * ((SC B.h ξ ^ bP) ^ k * (edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dP)) ^ k))) * E4

theorem lsh5_class_from_bounds_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (l5 : ℕ) (c : ℝ), 0 < c → PrimNondegAt4 B G l5 c → ∀ lP : ℕ, (∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (ξ : Cyl), lP ≤ γ.1 → ActiveL4 B G γ → etaL B.h γ ξ ≠ 0 → ξ ∈ DomC B.h B.qB → B.Xa ≤ XC B.h ξ → XC B.h ξ ≤ B.Xb → NB B.h (fun η : Cyl => (chig G.r0 (xiG B.h γ (G.ctr γ) η.2.2.2) * psiT (Lsb B.h G.r0 γ.1) (vco B.h G.r0 γ (G.ctr γ) η.2.2.2)) • G.tH γ (η.1, η.2.1, η.2.2.1) (vco B.h G.r0 γ (G.ctr γ) η.2.2.2)) k ξ ≤ C * SC B.h ξ ^ b * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (S : CState) (α β : ℝ), (∀ e : ℕ, (e = 1 ∨ e = 2) → InM B (qsOf l0) β (nrm B (2 * Aex B.h) (sigE5 B G l0 S e))) → (∀ e : ℕ, (e = 1 ∨ e = 2) → ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → sigE5 B G l0 S e ξ = 0) → (∀ k : ℕ, ∃ C b d : ℝ, ∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), ActiveL4 B G γ → etaL B.h γ ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → NB B.h (fun η : Cyl => Real.sqrt (epsb B.h γ.1) / 2 * sigAmp5 B G l0 S γ η) k ξ ≤ C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b * Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d)) → InWg5 B G (qsOf l0) α (LSh5 B G l0 S) :=
by
  intro B G hok hG l5 c hc hND lP hP
  have hS := hok.1
  obtain ⟨hh0, hh1, hXa, hXam1, hm12, hm2Xb, -, hqB0, hqB1, -, -, haa, hab⟩ := hok.2.1
  have hXab : B.Xa < B.Xb := by linarith
  have hr0 : 0 < G.r0 := hG.1.1
  obtain ⟨hEsm, hEfl, -, hEb⟩ := etaL_class_v5 B hok
  have hYsm := yAmp4_smooth_v5 B G hok hG
  choose CP bP hPi using hP
  choose CE bE hEi using hEb
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨l5 + lP + n0 + 1, fun l0 hl0 S α β HM H0 HA => ?_⟩
  choose CA bA dA hAi using HA
  have hQb : ∀ n : ℕ, Qb n = (1/2:ℝ) ^ n := by
    intro n
    show (2:ℝ) ^ (-(n:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 < B.qB := by
    show Qb l0 < _
    rw [hQb]
    exact lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0
  have hDom : ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ DomC B.h B.qB :=
