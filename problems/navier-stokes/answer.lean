      exact (key.2.const_mul (-(1 / 2 : ℂ))).differentiableAt.differentiableWithinAt
    · intro η
      have hpos : (0 : ℝ) < 1 + η ^ 2 := by positivity
      have hpt : ∀ y, Fc (η : ℂ) y = ((c y ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * ϑ y) : ℝ) : ℂ) := by
        intro y
