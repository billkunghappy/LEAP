    have hopen : ∀ s : ℝ, IsOpen (cStrip s) := by
      intro s
      exact (isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).and
        ((isOpen_lt continuous_const Complex.continuous_re).and
          (isOpen_lt Complex.continuous_re continuous_const))
