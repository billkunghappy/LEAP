theorem pch5_dU_frame : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (S : CState) (bw ca cm cd : ℝ), StOrd5 B G l0 S bw ca cm cd → ∀ (Y₀ : ℝ × ℝ) (x : ℝ³) (t : ℝ), corrOn B l0 x t → evOff B.h (dUX5 B G l0 S) Y₀ x t = cyl2cart x (fun a => mcor5 B G l0 S a (ptOf x t (Yph B.h (rad x) t + Y₀)) + qC B.h (ptOf x t (Yph B.h (rad x) t + Y₀)) ^ (-Aex B.h) * waveV5 B G (wmoAmp5 B G S.Aw) (thetaOf x) (ptOf x t (Yph B.h (rad x) t + Y₀)) a) :=
by
  intro B G hok hG
  obtain ⟨ls, hsplit⟩ := wmo_velocity_split_v5 B G hok hG
  obtain ⟨lp, hpair⟩ := wave_theta_pair_v5 B G hok hG
  obtain ⟨lw, hw⟩ := wmo_amp_class_v5 B G hok hG
  have hB1 := hok.2.1
  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hB1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨ls + lp + lw + n0, ?_⟩
  intro l0 hl0 S bw ca cm cd hSt Y₀ x t hxt
  have hSt' := hSt
  unfold StOrd5 at hSt'
  obtain ⟨c1, -, c3, c4, -, -, -, -, -, -, -, -, -, -, -, c16, -⟩ := hSt'

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  set Y := Yph B.h (rad x) t + Y₀ with hY
  have hξ : ptOf x t Y ∈ DomC B.h (qsOf l0) := ⟨hxt.1, hxt.2.1, hxt.2.2⟩

  have hc1' : InWg5 B G (qsOf l0) (1/2 + 1/2) S.Aw := by
    have e : (1/2 + 1/2 : ℝ) = 1 := by norm_num
    rw [e]
    exact c1
  have hP := (hw l0 (by omega)).1 S.Aw (1/2) hc1' c16
  obtain ⟨H, H0, hH⟩ := hP.1

  have hpr := hpair l0 (by omega) (wmoAmp5 B G S.Aw) (wmoAmp5 B G S.Aw)
    ⟨H, H0, fun γ m hm => ⟨hH γ m hm, hH γ m hm⟩⟩
    (fun γ m => ⟨(hP.2.1 γ m).continuousOn, (hP.2.1 γ m).continuousOn⟩)
    (fun γ m ξ hξ' => ⟨hP.2.2.2.1 γ m ξ hξ', hP.2.2.2.1 γ m ξ hξ'⟩)
    (ptOf x t Y) hξ

  have hUB : uB B x t = cyl2cart x (fun i => ubase B (ptOf x t Y) i) :=
    (ubase5_axisym B hok).1 x t Y ⟨hxt.2.1, lt_of_lt_of_le hxt.2.2 hqsB⟩ hxt.1

  have hrep : ∀ (θ : ℝ) (a : Fin 3), ucyl5 B G l0 S θ (ptOf x t Y) a =
      ucyl5 B G l0 (wmoBase S) 0 (ptOf x t Y) a +
        qC B.h (ptOf x t Y) ^ (-Aex B.h) * waveV5 B G (wmoAmp5 B G S.Aw) θ (ptOf x t Y) a :=
    fun θ a => (hsplit l0 (by omega) S S.Aw S.pw 1 1 c1 c1 c3 c4 (ptOf x t Y) hξ θ a).1
  have hmean : ∀ a : Fin 3, thA (fun θ => ucyl5 B G l0 S θ (ptOf x t Y) a) =
      ucyl5 B G l0 (wmoBase S) 0 (ptOf x t Y) a := by
    intro a
    have hfe : (fun θ => ucyl5 B G l0 S θ (ptOf x t Y) a) = fun θ =>
        ucyl5 B G l0 (wmoBase S) 0 (ptOf x t Y) a +
          qC B.h (ptOf x t Y) ^ (-Aex B.h) * waveV5 B G (wmoAmp5 B G S.Aw) θ (ptOf x t Y) a :=
      funext (fun θ => hrep θ a)
    have hpi : (2 * Real.pi) ≠ 0 := by positivity
    have hz := (hpr a a).2.1
    unfold thA at hz
    have hI : ∫ θ in (0:ℝ)..(2 * Real.pi), waveV5 B G (wmoAmp5 B G S.Aw) θ (ptOf x t Y) a = 0 := by
      rcases mul_eq_zero.mp hz with h | h
      · exact absurd h (inv_ne_zero hpi)
      · exact h
    have hkc : Continuous (fun θ : ℝ => qC B.h (ptOf x t Y) ^ (-Aex B.h) *
        waveV5 B G (wmoAmp5 B G S.Aw) θ (ptOf x t Y) a) :=
      continuous_const.mul (hpr a a).1
    unfold thA
    rw [hfe, intervalIntegral.integral_add (continuous_const.intervalIntegrable _ _)
      (hkc.intervalIntegrable _ _), intervalIntegral.integral_const,
      intervalIntegral.integral_const_mul, hI, mul_zero, add_zero,
      smul_eq_mul, sub_zero, ← mul_assoc, inv_mul_cancel₀ hpi, one_mul]

  have hn : ‖(⟨x 0, x 1⟩ : ℂ)‖ = rad x := by
    rw [Complex.norm_def, Complex.normSq_apply]
    show Real.sqrt (x 0 * x 0 + x 1 * x 1) = Real.sqrt (x 0 ^ 2 + x 1 ^ 2)
    ring_nf
  have hc : rad x * Real.cos (thetaOf x) = x 0 := by
    have h := Complex.norm_mul_cos_arg (⟨x 0, x 1⟩ : ℂ)
    rw [hn] at h
    exact h
  have hs : rad x * Real.sin (thetaOf x) = x 1 := by
    have h := Complex.norm_mul_sin_arg (⟨x 0, x 1⟩ : ℂ)
    rw [hn] at h
    exact h
  have hrot : rotPt (rad x) (thetaOf x) (x 2) = x := by
    ext j
    fin_cases j <;> simp [rotPt, hc, hs]
  have hr2 : rad x ^ 2 = x 0 ^ 2 + x 1 ^ 2 := Real.sq_sqrt (by positivity)
  have hr : 0 < rad x := hxt.1
  have hinv : (rad x)⁻¹ ^ 2 * (x 0 ^ 2 + x 1 ^ 2) = 1 := by
    rw [← hr2]
    field_simp
  have hrec : ∀ v : ℝ³, cyl2cart x (fun a => inner ℝ v ((![eR x, eTh x, eZ] : Fin 3 → ℝ³) a)) = v := by
    intro v
    ext j
    fin_cases j
    · simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three]
      linear_combination (v 0) * hinv
    · simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three]
      linear_combination (v 1) * hinv
    · simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three]
  have hu : uX5 B G l0 S x t Y = cyl2cart x (fun a => ucyl5 B G l0 S (thetaOf x) (ptOf x t Y) a) := by
    have hfe : (fun a => ucyl5 B G l0 S (thetaOf x) (ptOf x t Y) a) =
        fun a => inner ℝ (uX5 B G l0 S x t Y) ((![eR x, eTh x, eZ] : Fin 3 → ℝ³) a) := by
      funext a
      show inner ℝ (uX5 B G l0 S (rotPt (rad x) (thetaOf x) (x 2)) t Y)
        ((![eR (rotPt (rad x) (thetaOf x) (x 2)), eTh (rotPt (rad x) (thetaOf x) (x 2)), eZ] :
          Fin 3 → ℝ³) a) = _
      rw [hrot]
    rw [hfe, hrec]

  have hL : evOff B.h (dUX5 B G l0 S) Y₀ x t = uX5 B G l0 S x t Y - uB B x t := rfl
  have hcmp : ∀ a : Fin 3, ucyl5 B G l0 S (thetaOf x) (ptOf x t Y) a =
      (mcor5 B G l0 S a (ptOf x t Y) + ubase B (ptOf x t Y) a) +
        qC B.h (ptOf x t Y) ^ (-Aex B.h) * waveV5 B G (wmoAmp5 B G S.Aw) (thetaOf x) (ptOf x t Y) a := by
    intro a
    rw [hrep]
    unfold mcor5
    rw [hmean a]
    ring
  rw [hL, hu, hUB]
  simp only [hcmp]
  simp only [cyl2cart, add_smul]
  abel

theorem ssh5_vel_rep : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (α β : ℝ) (D : WC), InWg5 B G (qsOf l0) α D → InWg5 B G (qsOf l0) β (velW5 B G D) → (∀ γ m, ContDiffOn ℝ ∞ (ssh5Vw B G D γ m) (DomC B.h (qsOf l0))) ∧ (∀ γ m, D γ m = 0 → ssh5Vw B G D γ m = 0) ∧ (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → ssh5Vw B G D γ m ξ ≠ 0 → SuppW B G γ ξ) ∧ ∀ x t Y, corrOn B l0 x t → sw5W B G l0 D x t Y = cyl2cart x (waveV5 B G (ssh5Vw B G D) (thetaOf x) (ptOf x t Y)) :=
by

  have hrot : ∀ (h e t : ℝ) (Y0 : ℝ × ℝ) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (r z : ℝ), 0 < r →
      DifferentiableAt ℝ (modeF5 h e t Y0 n c) (rotPt r 0 z) →
      DifferentiableAt ℝ (modeF5 h e t Y0 n (fun η i => Complex.I * c η i)) (rotPt r 0 z) →
      ∀ (Y : ℝ × ℝ) (a : Fin 3) (θ : ℝ),
      inner ℝ (curl3 (modeF5 h e t Y0 n c) (rotPt r θ z)) (frameAt θ (r, z, t, Y) a) =
        Real.cos (n * θ) * inner ℝ (curl3 (modeF5 h e t Y0 n c) (rotPt r 0 z)) (frameAt 0 (r, z, t, Y) a) +
        Real.sin (n * θ) * inner ℝ (curl3 (modeF5 h e t Y0 n (fun η i => Complex.I * c η i)) (rotPt r 0 z))
          (frameAt 0 (r, z, t, Y) a) := by
    have hc : ∀ (φ : ℝ) (y : ℝ³), rotZ5 φ y 0 = Real.cos φ * y 0 - Real.sin φ * y 1 ∧
        rotZ5 φ y 1 = Real.sin φ * y 0 + Real.cos φ * y 1 ∧ rotZ5 φ y 2 = y 2 := by
      intro φ y
      simp [rotZ5]
    have ext3 : ∀ u v : ℝ³, u 0 = v 0 → u 1 = v 1 → u 2 = v 2 → u = v := by
      intro u v h0 h1 h2
      ext i
      fin_cases i
      · exact h0
      · exact h1
      · exact h2
    have hinv : ∀ (φ : ℝ) (y : ℝ³), rotZ5 φ (rotZ5 (-φ) y) = y := by
      intro φ y
      obtain ⟨a0, a1, a2⟩ := hc φ (rotZ5 (-φ) y)
      obtain ⟨b0, b1, b2⟩ := hc (-φ) y
      apply ext3
      · rw [a0, b0, b1, Real.cos_neg, Real.sin_neg]
        linear_combination y 0 * Real.cos_sq_add_sin_sq φ
      · rw [a1, b0, b1, Real.cos_neg, Real.sin_neg]
        linear_combination y 1 * Real.cos_sq_add_sin_sq φ
      · rw [a2, b2]
    have hrad : ∀ (φ : ℝ) (y : ℝ³), rad (rotZ5 φ y) = rad y := by
      intro φ y
      obtain ⟨a0, a1, -⟩ := hc φ y
      unfold rad
      rw [a0, a1]
      congr 1
      linear_combination (y 0 ^ 2 + y 1 ^ 2) * Real.cos_sq_add_sin_sq φ
    have hlin : ∀ φ : ℝ, ∃ L : ℝ³ →L[ℝ] ℝ³, ∀ v : ℝ³, L v = rotZ5 φ v := by
      intro φ
      let f : ℝ³ →ₗ[ℝ] ℝ³ :=
        { toFun := rotZ5 φ
          map_add' := fun u v => by
            apply ext3 <;> simp [hc] <;> ring
          map_smul' := fun a u => by
            apply ext3 <;> simp [hc] <;> ring }
      exact ⟨⟨f, f.continuous_of_finiteDimensional⟩, fun v => rfl⟩
    have hinner : ∀ (φ : ℝ) (u v : ℝ³), inner ℝ (rotZ5 φ u) (rotZ5 φ v) = inner ℝ u v := by
      intro φ u v
      have e : ∀ a b : ℝ³, inner ℝ a b = a 0 * b 0 + a 1 * b 1 + a 2 * b 2 := by
        intro a b
        simp [PiLp.inner_apply, Fin.sum_univ_three]
        ring
      rw [e, e]
      obtain ⟨a0, a1, a2⟩ := hc φ u
      obtain ⟨b0, b1, b2⟩ := hc φ v
      rw [a0, a1, a2, b0, b1, b2]
      linear_combination (u 0 * v 0 + u 1 * v 1) * Real.cos_sq_add_sin_sq φ
    have hpt : ∀ r φ z : ℝ, rotPt r φ z = rotZ5 φ (rotPt r 0 z) := by
      intro r φ z
      apply ext3 <;> simp [rotPt, hc] <;> ring
    have hframe : ∀ (φ : ℝ) (y : ℝ³), eR (rotZ5 φ y) = rotZ5 φ (eR y) ∧
        eTh (rotZ5 φ y) = rotZ5 φ (eTh y) ∧ rotZ5 φ eZ = eZ := by
      intro φ y
      refine ⟨?_, ?_, ?_⟩
      · apply ext3 <;> simp [eR, radVec, hc, hrad] <;> ring
      · apply ext3 <;> simp [eTh, azVec, hc, hrad] <;> ring
      · apply ext3 <;> simp [eZ, hc]
    have hphase : ∀ (φ : ℝ) (y : ℝ³) (n : ℤ), 0 < rad y →
        Complex.exp (Complex.I * (n : ℂ) * (thetaOf (rotZ5 φ y) : ℂ)) =
          Complex.exp (Complex.I * (n : ℂ) * (φ : ℂ)) *
            Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ)) := by
      intro φ y n hy
      obtain ⟨w, hw⟩ : ∃ w : ℂ, w = ⟨y 0, y 1⟩ := ⟨_, rfl⟩
      obtain ⟨w', hw'⟩ : ∃ w' : ℂ, w' = ⟨rotZ5 φ y 0, rotZ5 φ y 1⟩ := ⟨_, rfl⟩
      have hth : thetaOf y = w.arg := by rw [hw]; rfl
      have hth' : thetaOf (rotZ5 φ y) = w'.arg := by rw [hw']; rfl
      have hww : w' = Complex.exp ((φ : ℂ) * Complex.I) * w := by
        obtain ⟨a0, a1, -⟩ := hc φ y
        apply Complex.ext
        · rw [Complex.mul_re, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im, hw, hw', a0]
        · rw [Complex.mul_im, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im, hw, hw', a1]
          simp only
          ring
      have hnorm : ‖w‖ = rad y := by
        rw [Complex.norm_eq_sqrt_sq_add_sq, hw]
        rfl
      have hw0 : ((‖w‖ : ℝ) : ℂ) ≠ 0 := by
        rw [hnorm]
        exact_mod_cast hy.ne'
      have hnorm' : ‖w'‖ = ‖w‖ := by
        rw [hww, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
      have key : Complex.exp ((w'.arg : ℂ) * Complex.I) =
          Complex.exp ((φ : ℂ) * Complex.I) * Complex.exp ((w.arg : ℂ) * Complex.I) := by
        apply mul_left_cancel₀ hw0
        have h1 := Complex.norm_mul_exp_arg_mul_I w'
        have h2 := Complex.norm_mul_exp_arg_mul_I w
        rw [hnorm'] at h1
        calc ((‖w‖ : ℝ) : ℂ) * Complex.exp ((w'.arg : ℂ) * Complex.I) = w' := h1
          _ = Complex.exp ((φ : ℂ) * Complex.I) * w := hww
          _ = Complex.exp ((φ : ℂ) * Complex.I) * (((‖w‖ : ℝ) : ℂ) * Complex.exp ((w.arg : ℂ) * Complex.I)) := by
              rw [h2]
          _ = _ := by ring
      have hpow : ∀ α : ℝ, Complex.exp (Complex.I * (n : ℂ) * (α : ℂ)) =
          Complex.exp ((α : ℂ) * Complex.I) ^ n := by
        intro α
        rw [← Complex.exp_int_mul]
        congr 1
        ring
      rw [hpow, hpow, hpow, hth, hth', key, mul_zpow]
    have hmode : ∀ (h e t : ℝ) (Y0 : ℝ × ℝ) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (φ : ℝ) (y : ℝ³),
        0 < rad y → modeF5 h e t Y0 n c (rotZ5 φ y) =
          rotZ5 φ (Real.cos (n * φ) • modeF5 h e t Y0 n c y +
            Real.sin (n * φ) • modeF5 h e t Y0 n (fun η i => Complex.I * c η i) y) := by
      intro h e t Y0 n c φ y hy
      have hP : ptOf (rotZ5 φ y) t (Yph h (rad (rotZ5 φ y)) t + Y0) =
          ptOf y t (Yph h (rad y) t + Y0) := by
        simp only [ptOf, hrad, (hc φ y).2.2]
      have hco : ∀ κ E : ℂ, (κ * (Complex.exp (Complex.I * (n : ℂ) * (φ : ℂ)) * E)).re =
          Real.cos (n * φ) * (κ * E).re + Real.sin (n * φ) * (Complex.I * κ * E).re := by
        intro κ E
        have hx : Complex.exp (Complex.I * (n : ℂ) * (φ : ℂ)) =
            Complex.exp (((n * φ : ℝ) : ℂ) * Complex.I) := by
          congr 1
          push_cast
          ring
        rw [hx, show κ * (Complex.exp (((n * φ : ℝ) : ℂ) * Complex.I) * E) =
            Complex.exp (((n * φ : ℝ) : ℂ) * Complex.I) * (κ * E) by ring,
          Complex.mul_re, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im,
          mul_assoc Complex.I, Complex.I_mul_re]
        ring
      obtain ⟨L, hL⟩ := hlin φ
      obtain ⟨f1, f2, f3⟩ := hframe φ y
      simp only [modeF5, cyl2cart]
      rw [hP, hphase φ y n hy, f1, f2]
      conv_lhs => rw [← f3]
      simp only [← hL, map_add, map_smul, hco]
      module
    have hcurl : ∀ (φ : ℝ) (F G : ℝ³ → ℝ³) (x : ℝ³), DifferentiableAt ℝ G x →
        F =ᶠ[nhds (rotZ5 φ x)] (fun y => rotZ5 φ (G (rotZ5 (-φ) y))) →
        curl3 F (rotZ5 φ x) = rotZ5 φ (curl3 G x) := by
      intro φ F G x hG hF
      obtain ⟨L, hL⟩ := hlin φ
      obtain ⟨L', hL'⟩ := hlin (-φ)
      have hx : L' (L x) = x := by
        rw [hL, hL']
        have := hinv (-φ) x
        rwa [neg_neg] at this
      have hfun : (fun y => rotZ5 φ (G (rotZ5 (-φ) y))) = ⇑L ∘ G ∘ ⇑L' := by
        funext y
        simp only [Function.comp, hL, hL']
      have hD : HasFDerivAt (⇑L ∘ G ∘ ⇑L') (L.comp ((fderiv ℝ G x).comp L')) (L x) := by
        have h1 : HasFDerivAt G (fderiv ℝ G x) (L' (L x)) := by
          rw [hx]
          exact hG.hasFDerivAt
        exact L.hasFDerivAt.comp (L x) (h1.comp (L x) L'.hasFDerivAt)
      have hDF : fderiv ℝ F (rotZ5 φ x) = L.comp ((fderiv ℝ G x).comp L') := by
        rw [hF.fderiv_eq, hfun, ← hL x]
        exact hD.fderiv
      have e0 : L' (EuclideanSpace.single 0 1) =
          Real.cos φ • EuclideanSpace.single 0 1 - Real.sin φ • EuclideanSpace.single 1 1 := by
        rw [hL']
        apply ext3 <;> simp [hc]
      have e1 : L' (EuclideanSpace.single 1 1) =
          Real.sin φ • EuclideanSpace.single 0 1 + Real.cos φ • EuclideanSpace.single 1 1 := by
        rw [hL']
        apply ext3 <;> simp [hc]
      have e2 : L' (EuclideanSpace.single 2 1) = EuclideanSpace.single 2 1 := by
        rw [hL']
        apply ext3 <;> simp [hc]
      apply ext3
      · simp only [curl3, hDF, ContinuousLinearMap.comp_apply, e0, e1, e2, map_add, map_sub, map_smul, hL]
        simp [hc]
        ring
      · simp only [curl3, hDF, ContinuousLinearMap.comp_apply, e0, e1, e2, map_add, map_sub, map_smul, hL]
        simp [hc]
        ring
      · simp only [curl3, hDF, ContinuousLinearMap.comp_apply, e0, e1, e2, map_add, map_sub, map_smul, hL]
        simp [hc]
        linear_combination (fderiv ℝ G x (EuclideanSpace.single 0 1) 1 -
          fderiv ℝ G x (EuclideanSpace.single 1 1) 0) * Real.cos_sq_add_sin_sq φ
    have hcl : ∀ (F1 F2 : ℝ³ → ℝ³) (a b : ℝ) (x : ℝ³), DifferentiableAt ℝ F1 x →
        DifferentiableAt ℝ F2 x →
        curl3 (fun y => a • F1 y + b • F2 y) x = a • curl3 F1 x + b • curl3 F2 x := by
      intro F1 F2 a b x h1 h2
      have h1' : DifferentiableAt ℝ (fun y => a • F1 y) x := h1.const_smul a
      have h2' : DifferentiableAt ℝ (fun y => b • F2 y) x := h2.const_smul b
      have hD : fderiv ℝ (fun y => a • F1 y + b • F2 y) x = a • fderiv ℝ F1 x + b • fderiv ℝ F2 x := by
        rw [fderiv_fun_add h1' h2', fderiv_fun_const_smul h1, fderiv_fun_const_smul h2]
      apply ext3 <;> simp [curl3, hD] <;> ring
    intro h e t Y0 n c r z hr hd1 hd2 Y a θ
    have hradx0 : rad (rotPt r 0 z) = r := by
      simp [rad, rotPt, Real.sqrt_sq hr.le]
    have hU : IsOpen {y : ℝ³ | 0 < rad y} := by
      apply isOpen_lt continuous_const
      unfold rad
      fun_prop
    have hmem : rotZ5 θ (rotPt r 0 z) ∈ {y : ℝ³ | 0 < rad y} := by
      show 0 < rad (rotZ5 θ (rotPt r 0 z))
      rw [hrad, hradx0]
      exact hr
    have hev : modeF5 h e t Y0 n c =ᶠ[nhds (rotZ5 θ (rotPt r 0 z))]
        (fun y => rotZ5 θ ((fun y' => Real.cos (n * θ) • modeF5 h e t Y0 n c y' +
          Real.sin (n * θ) • modeF5 h e t Y0 n (fun η i => Complex.I * c η i) y') (rotZ5 (-θ) y))) := by
      apply Filter.eventuallyEq_of_mem (hU.mem_nhds hmem)
      intro y hy
      have hy' : 0 < rad (rotZ5 (-θ) y) := by
        rw [hrad]
        exact hy
      have := hmode h e t Y0 n c θ (rotZ5 (-θ) y) hy'
      rw [hinv θ y] at this
      exact this
    have hGd : DifferentiableAt ℝ (fun y' => Real.cos (n * θ) • modeF5 h e t Y0 n c y' +
        Real.sin (n * θ) • modeF5 h e t Y0 n (fun η i => Complex.I * c η i) y') (rotPt r 0 z) := by
      have := (hd1.const_smul (Real.cos (n * θ))).add (hd2.const_smul (Real.sin (n * θ)))
      exact this
    have h1 := hcurl θ _ _ (rotPt r 0 z) hGd hev
    rw [hcl _ _ _ _ _ hd1 hd2] at h1
    have hfr : frameAt θ (r, z, t, Y) a = rotZ5 θ (frameAt 0 (r, z, t, Y) a) := by
      fin_cases a
      · show eR (rotPt r θ z) = rotZ5 θ (eR (rotPt r 0 z))
        rw [hpt r θ z]
        exact (hframe θ _).1
      · show eTh (rotPt r θ z) = rotZ5 θ (eTh (rotPt r 0 z))
        rw [hpt r θ z]
        exact (hframe θ _).2.1
      · show eZ = rotZ5 θ eZ
        exact (hframe θ eZ).2.2.symm
    rw [hpt r θ z, h1, hfr, hinner, inner_add_left, real_inner_smul_left, real_inner_smul_left]

  have key : ∀ (qe qA : ℝ) (V W P : ℂ) (φ : ℝ), (qe : ℂ) * V = (qA : ℂ) * (W * P) →
      Real.cos φ * (qe * V.re) + Real.sin φ * (qe * (Complex.I * V).re) =
        qA * (W * (P * Complex.exp ((φ : ℂ) * Complex.I))).re := by
    intro qe qA V W P φ hh
    have h2 : ((qe : ℂ) * V * Complex.exp ((φ : ℂ) * Complex.I)).re =
        ((qA : ℂ) * (W * (P * Complex.exp ((φ : ℂ) * Complex.I)))).re := by
      rw [hh]; congr 1; ring
    simp only [Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
      Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im, Complex.I_re, Complex.I_im] at h2 ⊢
    linear_combination h2

  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, ?_⟩
  intro l0 hl0 α β D hD hvD
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  obtain ⟨hDopen, hqCs, hqpos, -, hdcal, -⟩ := domc_open_calculus B (qsOf l0) hok

  have hi : ∀ γ m, ContDiffOn ℝ ∞ (ssh5Vw B G D γ m) (DomC B.h (qsOf l0)) := by
    intro γ m
    have hq1 : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-B.h)) (DomC B.h (qsOf l0)) :=
      hqCs.rpow_const_of_ne (fun ξ hξ => (hqpos ξ hξ).ne')
    have hq2 : ContDiffOn ℝ ∞ (dZ (fun η => qC B.h η ^ (-B.h))) (DomC B.h (qsOf l0)) :=
      (hdcal _ hq1).2.1
    have hs1 : ContDiffOn ℝ ∞ (fun η => ((qC B.h η ^ (-B.h) * Qb γ.1 ^ (-(1/2:ℝ)) : ℝ) : ℂ))
        (DomC B.h (qsOf l0)) :=
      (Complex.ofRealCLM.contDiff.comp_contDiffOn (hq1.mul contDiffOn_const)).congr
        (fun η _ => (Complex.ofRealCLM_apply _).symm)
    have hs2 : ContDiffOn ℝ ∞ (fun η => ((dZ (fun η => qC B.h η ^ (-B.h)) η : ℝ) : ℂ))
        (DomC B.h (qsOf l0)) :=
      (Complex.ofRealCLM.contDiff.comp_contDiffOn hq2).congr
        (fun η _ => (Complex.ofRealCLM_apply _).symm)
    have hv : ContDiffOn ℝ ∞ (velW5 B G D γ m) (DomC B.h (qsOf l0)) := hvD.2.1 γ m
    have ha' := contDiffOn_pi.1 (hD.2.1 γ m)
    have hrv : ContDiffOn ℝ ∞ (fun η => (![-(D γ m η 1), D γ m η 0, 0] :
        Fin 3 → ℂ)) (DomC B.h (qsOf l0)) := by
      refine contDiffOn_pi.2 (fun i => ?_)
      fin_cases i
      · first
        | exact (ha' 1).neg
        | simpa using (ha' 1).neg
      · first
        | exact ha' 0
        | simpa using ha' 0
      · first
        | exact contDiffOn_const
        | simpa using (contDiffOn_const : ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℂ)) (DomC B.h (qsOf l0)))
    exact (hs1.smul hv).add (hs2.smul hrv)

  have hii : ∀ γ m, D γ m = 0 → ssh5Vw B G D γ m = 0 := by
    intro γ m h0
    have hA' : ∀ η, D γ m η = 0 := fun η => congrFun h0 η
    funext ξ i
    have hcomp : ∀ j : Fin 3, fderiv ℝ (fun η => D γ m η j) ξ = 0 := by
      intro j
      have hf : (fun η => D γ m η j) = fun _ => (0:ℂ) := by
        funext η
        rw [hA' η]
        rfl
      rw [hf]
      simp
    fin_cases i <;> simp [ssh5Vw, velW5, velC5, DrC, DzC, dR, dZ, hA', hcomp]

  have hiii : ∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → ssh5Vw B G D γ m ξ ≠ 0 → SuppW B G γ ξ := by
    intro γ m ξ hξ hne
    by_cases hv : velW5 B G D γ m ξ = 0
    · by_cases ha : D γ m ξ = 0
      · exfalso
        apply hne
        funext i
        fin_cases i <;> simp [ssh5Vw, hv, ha]
      · exact hD.2.2.2.1 γ m ξ hξ ha
    · exact hvD.2.2.2.1 γ m ξ hξ hv
  refine ⟨hi, hii, hiii, ?_⟩

  intro x t Y hxt
  have hξ : ptOf x t Y ∈ DomC B.h (qsOf l0) := hxt
  obtain ⟨hrx, ht, hqx⟩ : 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
  obtain ⟨r, hrad⟩ : ∃ r, rad x = r := ⟨_, rfl⟩
  obtain ⟨z, hx2⟩ : ∃ z, x 2 = z := ⟨_, rfl⟩
  have hr : 0 < r := by rw [← hrad]; exact hrx
  have hPξ : ptOf x t Y = ((r, z, t, Y) : Cyl) := by
    show ((rad x, x 2, t, Y) : Cyl) = _
    rw [hrad, hx2]
  have hξ' : ((r, z, t, Y) : Cyl) ∈ DomC B.h (qsOf l0) := by rw [← hPξ]; exact hξ
  have hopen : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi

  obtain ⟨N, hN, Γ, hΓ⟩ := etaL_local_finite_v5 B.h hok.1 (r, z, t, Y) ht
  obtain ⟨H, -, hHv⟩ := hD.1
  have hNO : N ∩ DomC B.h (qsOf l0) ∈ nhds ((r, z, t, Y) : Cyl) :=
    Filter.inter_mem hN (hDopen.mem_nhds hξ')
  have hcov : ∀ η ∈ N ∩ DomC B.h (qsOf l0), ∀ γ m, D γ m η ≠ 0 → γ ∈ Γ ∧ m ∈ H := by
    rintro η ⟨hηN, hηD⟩ γ m hne
    refine ⟨hΓ γ η hηN (hD.2.2.2.1 γ m η hηD hne).2.1, ?_⟩
    by_contra hm
    exact hne (by simp [hHv γ m hm])

  have hexp : ∀ (A : WC) (θ' : ℝ) (η : Cyl), (∀ γ m, A γ m η ≠ 0 → γ ∈ Γ ∧ m ∈ H) →
      waveV5 B G A θ' η = ∑ γ ∈ Γ, ∑ m ∈ H, (fun i => (modeCoef5 B G A γ m η i *
        Complex.exp (Complex.I * (((m * pint5 B G γ : ℤ)) : ℂ) * (θ' : ℂ))).re) := by
    intro A θ' η hA
    funext i
    have hph : ∀ γ m, A γ m η i * ephase5 B G γ m θ' η = modeCoef5 B G A γ m η i *
        Complex.exp (Complex.I * (((m * pint5 B G γ : ℤ)) : ℂ) * (θ' : ℂ)) := by
      intro γ m
      simp only [ephase5, modeCoef5]
      rw [mul_assoc (A γ m η i), ← Complex.exp_add]
      congr 2
      push_cast
      ring
    have hin : ∀ γ, ∑ᶠ m : ℤ, A γ m η i * ephase5 B G γ m θ' η =
        ∑ m ∈ H, A γ m η i * ephase5 B G γ m θ' η := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      rw [Function.support_subset_iff']
      intro m hm
      by_contra hne
      have hA0 : A γ m η ≠ 0 := fun h0 => hne (by simp [h0])
      exact hm (Finset.mem_coe.mpr (hA γ m hA0).2)
    have hout : (Function.support fun γ => ∑ m ∈ H, A γ m η i * ephase5 B G γ m θ' η) ⊆ ↑Γ := by
      rw [Function.support_subset_iff']
      intro γ hγ
      apply Finset.sum_eq_zero
      intro m _
      by_contra hne
      have hA0 : A γ m η ≠ 0 := fun h0 => hne (by simp [h0])
      exact hγ (Finset.mem_coe.mpr (hA γ m hA0).1)
    simp only [waveV5, Finset.sum_apply]
    rw [finsum_congr hin, finsum_eq_sum_of_support_subset _ hout, Complex.re_sum]
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [Complex.re_sum]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    rw [hph]

  have hcyl_sum : ∀ (y : ℝ³) {ι : Type} (s : Finset ι) (v : ι → Fin 3 → ℝ),
      cyl2cart y (∑ j ∈ s, v j) = ∑ j ∈ s, cyl2cart y (v j) := by
    intro y ι s v
    let L : (Fin 3 → ℝ) →+ ℝ³ := AddMonoidHom.mk' (cyl2cart y) (fun c d => by
      simp only [cyl2cart, Pi.add_apply, add_smul]; abel)
    exact map_sum L v s

  have hcurl : ∀ (F' : ℝ³ → ℝ³) {ι : Type} (s : Finset ι) (g : ι → ℝ³ → ℝ³) (x : ℝ³),
      F' =ᶠ[nhds x] (fun y => ∑ i ∈ s, g i y) →
      (∀ i ∈ s, DifferentiableAt ℝ (g i) x) → curl3 F' x = ∑ i ∈ s, curl3 (g i) x := by
    intro F' ι s g x hev hg
    have hfd : fderiv ℝ F' x = ∑ i ∈ s, fderiv ℝ (g i) x := by
      rw [hev.fderiv_eq, fderiv_fun_sum hg]
    let cH : (ℝ³ →L[ℝ] ℝ³) →+ ℝ³ := AddMonoidHom.mk' (fun L =>
      (L (EuclideanSpace.single 1 1) 2 - L (EuclideanSpace.single 2 1) 1) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
      (L (EuclideanSpace.single 2 1) 0 - L (EuclideanSpace.single 0 1) 2) • EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
      (L (EuclideanSpace.single 0 1) 1 - L (EuclideanSpace.single 1 1) 0) • EuclideanSpace.single (2 : Fin 3) (1 : ℝ))
      (by
        intro L1 L2
        simp only [ContinuousLinearMap.add_apply, PiLp.add_apply, add_smul, sub_smul]
        abel)
    have e1 : ∀ G' : ℝ³ → ℝ³, curl3 G' x = cH (fderiv ℝ G' x) := fun G' => rfl
    have e2 : ∑ i ∈ s, curl3 (g i) x = ∑ i ∈ s, cH (fderiv ℝ (g i) x) :=
      Finset.sum_congr rfl (fun i _ => e1 (g i))
    rw [e2, e1 F', hfd, map_sum]

  have hne0 : x 0 ^ 2 + x 1 ^ 2 ≠ 0 := by
    intro h0
    have : rad x = 0 := by unfold rad; rw [h0, Real.sqrt_zero]
    linarith
  have hradd : DifferentiableAt ℝ rad x := by
    have h1 : DifferentiableAt ℝ (fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2) x := by fun_prop
    exact h1.sqrt hne0
  have hPx : ptOf x t (Yph B.h (rad x) t + (Y - Yph B.h r t)) = (r, z, t, Y) := by
    simp [ptOf, hrad, hx2]
  have hPd : DifferentiableAt ℝ (fun y : ℝ³ => ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) x := by
    have hr1 : DifferentiableAt ℝ (fun y : ℝ³ => rad y ^ drx B.h) x :=
      hradd.rpow_const (Or.inl (by rw [hrad]; exact hr.ne'))
    have h2 : DifferentiableAt ℝ (fun y : ℝ³ => y 2) x := by fun_prop
    have h4 : DifferentiableAt ℝ (fun y : ℝ³ => Yph B.h (rad y) t + (Y - Yph B.h r t)) x :=
      ((hr1.smul_const vrv).add_const (t • vtv)).add_const _
    exact hradd.prodMk (h2.prodMk ((differentiableAt_const t).prodMk h4))
  have hq_d : DifferentiableAt ℝ (fun y : ℝ³ => simScale B.h (y 2) (1 - t)) x := by
    have hmem : ((x 2, 1 - t) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ)) :=
      ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩
    have h1 : DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (x 2, 1 - t) :=
      (hok.1.2.2.2.1.contDiffAt (hopen.mem_nhds hmem)).differentiableAt (by norm_num)
    have h2 : DifferentiableAt ℝ (fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ)) x := by fun_prop
    exact DifferentiableAt.comp (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2) x h1 h2
  have hNx : N ∩ DomC B.h (qsOf l0) ∈ nhds (ptOf x t (Yph B.h (rad x) t + (Y - Yph B.h r t))) := by
    rw [hPx]; exact hNO
  have hO : ∀ᶠ y in nhds x, 0 < rad y ∧ simScale B.h (y 2) (1 - t) < qsOf l0 ∧
      ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t)) ∈ N ∩ DomC B.h (qsOf l0) := by
    have e1 : ∀ᶠ y in nhds x, (0:ℝ) < rad y :=
      continuousAt_const.eventually_lt hradd.continuousAt hrx
    have e2 : ∀ᶠ y in nhds x, simScale B.h (y 2) (1 - t) < qsOf l0 :=
      hq_d.continuousAt.eventually_lt continuousAt_const hqx
    have e3 : ∀ᶠ y in nhds x, ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t)) ∈ N ∩ DomC B.h (qsOf l0) :=
      hPd.continuousAt.preimage_mem_nhds hNx
    exact e1.and (e2.and e3)

  have hloc : (fun y => sw5A B G l0 D y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) =ᶠ[nhds x]
      (fun y => ∑ γ ∈ Γ, ∑ m ∈ H, modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
          (m * pint5 B G γ) (modeCoef5 B G D γ m) y) := by
    filter_upwards [hO] with y hy
    obtain ⟨hy1, hy2, hy3⟩ := hy
    have hcorr : corrOn B l0 y t := ⟨hy1, ht, hy2⟩
    simp only [sw5A]
    rw [if_pos hcorr, hexp D (thetaOf y) _ (hcov _ hy3), hcyl_sum, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [hcyl_sum, Finset.smul_sum]
    rfl
  have hMS : ∀ γ m, DifferentiableAt ℝ (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
      (m * pint5 B G γ) (modeCoef5 B G D γ m)) x := by
    intro γ m
    refine modeF5_differentiable_v5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
      (modeCoef5 B G D γ m) x hok.1 ht hrx ?_
    rw [hPx]
    exact modeCoef5_differentiable_v5 B G hok hG (qsOf l0) α D hqsB hD γ m _ hξ'
  have hW : sw5W B G l0 D x t Y = ∑ p ∈ Γ ×ˢ H, curl3 (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
      (p.2 * pint5 B G p.1) (modeCoef5 B G D p.1 p.2)) x := by
    have hev : (fun y => sw5A B G l0 D y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) =ᶠ[nhds x]
        (fun y => ∑ p ∈ Γ ×ˢ H, modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
          (p.2 * pint5 B G p.1) (modeCoef5 B G D p.1 p.2) y) := by
      filter_upwards [hloc] with y hy
      rw [hy, Finset.sum_product]
    have hc3 := hcurl _ (Γ ×ˢ H) (fun p => modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
      (p.2 * pint5 B G p.1) (modeCoef5 B G D p.1 p.2)) x hev (fun p _ => hMS p.1 p.2)
    show curl3 (fun y => sw5A B G l0 D y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t))) x = _
    rw [hrad]
    exact hc3

  have hY : Yph B.h r t + (Y - Yph B.h r t) = Y := by abel
  have hradx0 : rad (rotPt r 0 z) = r := by simp [rad, rotPt, Real.sqrt_sq hr.le]
  have hx02 : (rotPt r 0 z) 2 = z := by simp [rotPt]
  have hPx0 : ptOf (rotPt r 0 z) t (Yph B.h (rad (rotPt r 0 z)) t + (Y - Yph B.h r t)) = (r, z, t, Y) := by
    simp only [ptOf, hradx0, hY, hx02]
  have hmode : ∀ (θ : ℝ) (a : Fin 3) (γ : Lab) (m : ℤ), inner ℝ (curl3 (modeF5 B.h (1/2 - Aex B.h) t
      (Y - Yph B.h r t) (m * pint5 B G γ) (modeCoef5 B G D γ m)) (rotPt r θ z))
      (frameAt θ (r, z, t, Y) a) =
      qC B.h (r, z, t, Y) ^ (-Aex B.h) *
        (wmoAmp5 B G D γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y)).re := by
    intro θ a γ m
    have hCd : DifferentiableAt ℝ (modeCoef5 B G D γ m) ((r, z, t, Y) : Cyl) :=
      modeCoef5_differentiable_v5 B G hok hG (qsOf l0) α D hqsB hD γ m _ hξ'
    have hICd : DifferentiableAt ℝ (fun η i => Complex.I * modeCoef5 B G D γ m η i)
        ((r, z, t, Y) : Cyl) :=
      differentiableAt_pi.2 (fun i => (differentiableAt_pi.1 hCd i).const_mul Complex.I)
    have hM1 : DifferentiableAt ℝ (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
        (modeCoef5 B G D γ m)) (rotPt r 0 z) :=
      modeF5_differentiable_v5 _ _ _ _ _ _ _ hok.1 ht (by rw [hradx0]; exact hr) (by rw [hPx0]; exact hCd)
    have hM2 : DifferentiableAt ℝ (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
        (fun η i => Complex.I * modeCoef5 B G D γ m η i)) (rotPt r 0 z) :=
      modeF5_differentiable_v5 _ _ _ _ _ _ _ hok.1 ht (by rw [hradx0]; exact hr) (by rw [hPx0]; exact hICd)
    obtain ⟨hax1, hax2⟩ := mode_curl_axis_v5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
      (modeCoef5 B G D γ m) r z hok.1 ht hr (by rw [hY]; exact hCd)
    obtain ⟨hax3, -⟩ := mode_curl_axis_v5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
      (fun η i => Complex.I * modeCoef5 B G D γ m η i) r z hok.1 ht hr (by rw [hY]; exact hICd)
    rw [hY] at hax1 hax2 hax3
    have hph := fun i => wmo_phase_deriv_v5 B G hok hG (qsOf l0) α D hqsB hD γ m
      (r, z, t, Y) hξ' i
    have hamp := wmo_mode_amp_v5 B G D γ m (r, z, t, Y) hok hr ht (fun i => (hph i).1)
      (fun i => (hph i).2) a
    have hZ : ephase5 B G γ m θ (r, z, t, Y) =
        Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (r, z, t, Y) : ℂ))) *
          Complex.exp (((((m * pint5 B G γ : ℤ) : ℝ) * θ : ℝ) : ℂ) * Complex.I) := by
      simp only [ephase5]
      rw [← Complex.exp_add]
      congr 1
      push_cast
      ring
    rw [hrot _ _ _ _ _ _ r z hr hM1 hM2 Y a θ, hax1 a, hax3 a, hax2, hZ]
    exact key _ _ _ _ _ _ hamp

  have hq : 0 < qC B.h (r, z, t, Y) := hqpos _ hξ'
  have hqd : DifferentiableAt ℝ (qC B.h) ((r, z, t, Y) : Cyl) :=
    (hqCs.contDiffAt (hDopen.mem_nhds hξ')).differentiableAt (by norm_num)
  have hF := hqd.hasFDerivAt
  have hd1 : dZ (fun η => qC B.h η ^ (-B.h)) ((r, z, t, Y) : Cyl) =
      (-B.h * qC B.h (r, z, t, Y) ^ (-B.h - 1)) * dZ (qC B.h) ((r, z, t, Y) : Cyl) := by
    unfold dZ
    rw [(hF.rpow_const (p := -B.h) (Or.inl hq.ne')).fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hd2 : dZ (fun η => Real.log (qC B.h η)) ((r, z, t, Y) : Cyl) =
      (qC B.h (r, z, t, Y))⁻¹ * dZ (qC B.h) ((r, z, t, Y) : Cyl) := by
    unfold dZ
    rw [(hF.log hq.ne').fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hA : qC B.h (r, z, t, Y) ^ (-Aex B.h) * qC B.h (r, z, t, Y) ^ (1/2:ℝ) =
      qC B.h (r, z, t, Y) ^ (-B.h) := by
    rw [← Real.rpow_add hq]
    congr 1
    unfold Aex
    ring
  have hcoef : ∀ (γ : Lab) (m : ℤ) (i : Fin 3),
      ((qC B.h (r, z, t, Y) ^ (-Aex B.h) : ℝ) : ℂ) * wmoAmp5 B G D γ m (r, z, t, Y) i =
        ssh5Vw B G D γ m (r, z, t, Y) i := by
    intro γ m i
    have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
    have e1 : ((qC B.h (r, z, t, Y) ^ (-Aex B.h) : ℝ) : ℂ) *
        (((qC B.h (r, z, t, Y) / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ) =
        ((qC B.h (r, z, t, Y) ^ (-B.h) * Qb γ.1 ^ (-(1/2:ℝ)) : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul]
      congr 1
      rw [Real.div_rpow hq.le hQ.le, Real.rpow_neg hQ.le, div_eq_mul_inv, ← mul_assoc, hA]
    have e2 : ((qC B.h (r, z, t, Y) ^ (-Aex B.h) : ℝ) : ℂ) *
        ((B.h * qC B.h (r, z, t, Y) ^ (1/2:ℝ) * dZ (fun η => Real.log (qC B.h η)) ((r, z, t, Y) : Cyl) : ℝ) : ℂ) =
        -((dZ (fun η => qC B.h η ^ (-B.h)) ((r, z, t, Y) : Cyl) : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul, ← Complex.ofReal_neg]
      congr 1
      rw [hd1, hd2, Real.rpow_sub_one hq.ne']
      calc qC B.h (r, z, t, Y) ^ (-Aex B.h) *
            (B.h * qC B.h (r, z, t, Y) ^ (1/2:ℝ) * ((qC B.h (r, z, t, Y))⁻¹ * dZ (qC B.h) ((r, z, t, Y) : Cyl)))
          = B.h * (qC B.h (r, z, t, Y) ^ (-Aex B.h) * qC B.h (r, z, t, Y) ^ (1/2:ℝ)) *
              (qC B.h (r, z, t, Y))⁻¹ * dZ (qC B.h) ((r, z, t, Y) : Cyl) := by ring
        _ = _ := by rw [hA]; ring
    have hw : ∀ c : Fin 3 → ℂ, (![-(c 1), c 0, 0] : Fin 3 → ℂ) i = -(rotC c i) := by
      intro c
      fin_cases i <;> simp [rotC]
    simp only [wmoAmp5, ssh5Vw, velW5, Pi.add_apply, Pi.smul_apply, smul_eq_mul, hw]
    linear_combination (velC5 B G D γ m (r, z, t, Y) i) * e1 +
      (rotC (D γ m (r, z, t, Y)) i) * e2

  have hP0 : ∀ (γ : Lab) (m : ℤ), ¬ (γ ∈ Γ ∧ m ∈ H) → ssh5Vw B G D γ m (r, z, t, Y) = 0 := by
    intro γ m hn
    have hev : D γ m =ᶠ[nhds ((r, z, t, Y) : Cyl)] fun _ => 0 := by
      filter_upwards [hNO] with η hη
      by_contra hne
      exact hn (hcov η hη γ m hne)
    have h0 : D γ m (r, z, t, Y) = 0 := hev.eq_of_nhds
    have hcomp : ∀ i : Fin 3, fderiv ℝ (fun η => D γ m η i) ((r, z, t, Y) : Cyl) = 0 := by
      intro i
      have h1 : (fun η => D γ m η i) =ᶠ[nhds ((r, z, t, Y) : Cyl)] fun _ => (0:ℂ) := by
        filter_upwards [hev] with η hη
        simp [hη]
      rw [h1.fderiv_eq]
      simp
    funext i
    fin_cases i <;> simp [ssh5Vw, velW5, velC5, DrC, DzC, dR, dZ, h0, hcomp]

  have hwaveP : ∀ (θ : ℝ) (a : Fin 3), waveV5 B G (ssh5Vw B G D) θ (r, z, t, Y) a = ∑ γ ∈ Γ, ∑ m ∈ H,
      (ssh5Vw B G D γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y)).re := by
    intro θ a
    have hin : ∀ γ, ∑ᶠ m : ℤ, ssh5Vw B G D γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y) =
        ∑ m ∈ H, ssh5Vw B G D γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y) := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      rw [Function.support_subset_iff']
      intro m hm
      rw [hP0 γ m (fun hh => hm (Finset.mem_coe.mpr hh.2))]
      simp
    have hout : (Function.support fun γ => ∑ m ∈ H,
        ssh5Vw B G D γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y)) ⊆ ↑Γ := by
      rw [Function.support_subset_iff']
      intro γ hγ
      apply Finset.sum_eq_zero
      intro m _
      rw [hP0 γ m (fun hh => hγ (Finset.mem_coe.mpr hh.1))]
      simp
    simp only [waveV5]
    rw [finsum_congr hin, finsum_eq_sum_of_support_subset _ hout, Complex.re_sum]
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [Complex.re_sum]

  have hn : ‖(⟨x 0, x 1⟩ : ℂ)‖ = rad x := by
    rw [Complex.norm_def, Complex.normSq_apply]
    show Real.sqrt (x 0 * x 0 + x 1 * x 1) = Real.sqrt (x 0 ^ 2 + x 1 ^ 2)
    ring_nf
  have hcs : rad x * Real.cos (thetaOf x) = x 0 := by
    have h := Complex.norm_mul_cos_arg (⟨x 0, x 1⟩ : ℂ)
    rw [hn] at h
    exact h
  have hsn : rad x * Real.sin (thetaOf x) = x 1 := by
    have h := Complex.norm_mul_sin_arg (⟨x 0, x 1⟩ : ℂ)
    rw [hn] at h
    exact h
  have hrotx0 : rotPt (rad x) (thetaOf x) (x 2) = x := by
    ext j
    fin_cases j <;> simp [rotPt, hcs, hsn]
  have hrotx : rotPt r (thetaOf x) z = x := by
    rw [← hrad, ← hx2]
    exact hrotx0
  have hr2 : rad x ^ 2 = x 0 ^ 2 + x 1 ^ 2 := Real.sq_sqrt (by positivity)
  have hinv : (rad x)⁻¹ ^ 2 * (x 0 ^ 2 + x 1 ^ 2) = 1 := by
    rw [← hr2]
    field_simp
  have hrec : ∀ v : ℝ³, cyl2cart x (fun a => inner ℝ v ((![eR x, eTh x, eZ] : Fin 3 → ℝ³) a)) = v := by
    intro v
    ext j
    fin_cases j
    · simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three]
      linear_combination (v 0) * hinv
    · simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three]
      linear_combination (v 1) * hinv
    · simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three]
  have hframe : (![eR x, eTh x, eZ] : Fin 3 → ℝ³) = frameAt (thetaOf x) ((r, z, t, Y) : Cyl) := by
    show _ = ![eR (rotPt r (thetaOf x) z), eTh (rotPt r (thetaOf x) z), eZ]
    rw [hrotx]

  have hcomp : ∀ a : Fin 3, inner ℝ (sw5W B G l0 D x t Y) (frameAt (thetaOf x) ((r, z, t, Y) : Cyl) a) =
      waveV5 B G (ssh5Vw B G D) (thetaOf x) (r, z, t, Y) a := by
    intro a
    rw [hW, sum_inner, hwaveP (thetaOf x) a, Finset.sum_product]
    refine Finset.sum_congr rfl (fun γ _ => Finset.sum_congr rfl (fun m _ => ?_))
    dsimp only
    have hm := hmode (thetaOf x) a γ m
    rw [hrotx] at hm
    rw [hm, ← hcoef γ m a, mul_assoc, Complex.re_ofReal_mul]
  conv_lhs => rw [← hrec (sw5W B G l0 D x t Y)]
  rw [hframe, hPξ]
  congr 1
  funext a
  exact hcomp a

theorem pch5_inc_frame : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (D : WC) (β : ℝ), InWg5 B G (qsOf l0) (β + 1/2) D → InWg5 B G (qsOf l0) β (velW5 B G D) → ∀ (Y₀ : ℝ × ℝ) (x : ℝ³) (t : ℝ), corrOn B l0 x t → evOff B.h (wIncX5 B G l0 D) Y₀ x t = cyl2cart x (fun a => qC B.h (ptOf x t (Yph B.h (rad x) t + Y₀)) ^ (-Aex B.h) * waveV5 B G (wmoAmp5 B G D) (thetaOf x) (ptOf x t (Yph B.h (rad x) t + Y₀)) a) :=
by
  intro B G hok hG
  obtain ⟨l1, hrep⟩ := ssh5_vel_rep B G hok hG
  refine ⟨l1, fun l0 hl0 D β hD hDv Y₀ x t hxt => ?_⟩
  have hsw := (hrep l0 hl0 (β + 1/2) β D hD hDv).2.2.2
  set Y : ℝ × ℝ := Yph B.h (rad x) t + Y₀ with hYdef
  have hξ : ptOf x t Y ∈ DomC B.h (qsOf l0) := ⟨hxt.1, hxt.2.1, hxt.2.2⟩
  have hq : 0 < qC B.h (ptOf x t Y) :=
    (hok.1.1 (ptOf x t Y).2.1 (1 - (ptOf x t Y).2.2.1) (by linarith [hξ.2.1])).1
  have hFc : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2)
      ((ptOf x t Y).2.1, 1 - (ptOf x t Y).2.2.1) :=
    hok.1.2.2.2.1.contDiffAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds
      ⟨Set.mem_univ _, show (0:ℝ) < 1 - (ptOf x t Y).2.2.1 by linarith [hξ.2.1]⟩)
  have hqd : DifferentiableAt ℝ (qC B.h) (ptOf x t Y) := by
    have hg : DifferentiableAt ℝ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) (ptOf x t Y) := by
      fun_prop
    have hcomp : DifferentiableAt ℝ ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ))) (ptOf x t Y) :=
      DifferentiableAt.comp (ptOf x t Y) (hFc.differentiableAt (by simp)) hg
    exact hcomp
  have hF := hqd.hasFDerivAt
  have hd1 : dZ (fun η => qC B.h η ^ (-B.h)) (ptOf x t Y) =
      (-B.h * qC B.h (ptOf x t Y) ^ (-B.h - 1)) * dZ (qC B.h) (ptOf x t Y) := by
    unfold dZ
    rw [(hF.rpow_const (p := -B.h) (Or.inl hq.ne')).fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hd2 : dZ (fun η => Real.log (qC B.h η)) (ptOf x t Y) =
      (qC B.h (ptOf x t Y))⁻¹ * dZ (qC B.h) (ptOf x t Y) := by
    unfold dZ
    rw [(hF.log hq.ne').fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hA : qC B.h (ptOf x t Y) ^ (-Aex B.h) * qC B.h (ptOf x t Y) ^ (1/2:ℝ) =
      qC B.h (ptOf x t Y) ^ (-B.h) := by
    rw [← Real.rpow_add hq]
    congr 1
    unfold Aex
    ring
  have hcoef : ∀ (γ : Lab) (m : ℤ) (i : Fin 3),
      ((qC B.h (ptOf x t Y) ^ (-Aex B.h) : ℝ) : ℂ) * wmoAmp5 B G D γ m (ptOf x t Y) i =
        ssh5Vw B G D γ m (ptOf x t Y) i := by
    intro γ m i
    have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
    have e1 : ((qC B.h (ptOf x t Y) ^ (-Aex B.h) : ℝ) : ℂ) *
        (((qC B.h (ptOf x t Y) / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ) =
        ((qC B.h (ptOf x t Y) ^ (-B.h) * Qb γ.1 ^ (-(1/2:ℝ)) : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul]
      congr 1
      rw [Real.div_rpow hq.le hQ.le, Real.rpow_neg hQ.le, div_eq_mul_inv, ← mul_assoc, hA]
    have e2 : ((qC B.h (ptOf x t Y) ^ (-Aex B.h) : ℝ) : ℂ) *
        ((B.h * qC B.h (ptOf x t Y) ^ (1/2:ℝ) * dZ (fun η => Real.log (qC B.h η)) (ptOf x t Y) : ℝ) : ℂ) =
        -((dZ (fun η => qC B.h η ^ (-B.h)) (ptOf x t Y) : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul, ← Complex.ofReal_neg]
      congr 1
      rw [hd1, hd2, Real.rpow_sub_one hq.ne']
      calc qC B.h (ptOf x t Y) ^ (-Aex B.h) *
            (B.h * qC B.h (ptOf x t Y) ^ (1/2:ℝ) * ((qC B.h (ptOf x t Y))⁻¹ * dZ (qC B.h) (ptOf x t Y)))
          = B.h * (qC B.h (ptOf x t Y) ^ (-Aex B.h) * qC B.h (ptOf x t Y) ^ (1/2:ℝ)) *
              (qC B.h (ptOf x t Y))⁻¹ * dZ (qC B.h) (ptOf x t Y) := by ring
        _ = _ := by rw [hA]; ring
    have hw : ∀ c : Fin 3 → ℂ, (![-(c 1), c 0, 0] : Fin 3 → ℂ) i = -(rotC c i) := by
      intro c
      fin_cases i <;> simp [rotC]
    simp only [wmoAmp5, ssh5Vw, Pi.add_apply, Pi.smul_apply, smul_eq_mul, hw]
    linear_combination (velW5 B G D γ m (ptOf x t Y) i) * e1 + (rotC (D γ m (ptOf x t Y)) i) * e2
  have hwave : ∀ (θ : ℝ) (i : Fin 3),
      qC B.h (ptOf x t Y) ^ (-Aex B.h) * waveV5 B G (wmoAmp5 B G D) θ (ptOf x t Y) i =
        waveV5 B G (ssh5Vw B G D) θ (ptOf x t Y) i := by
    intro θ i
    simp only [waveV5]
    rw [← Complex.re_ofReal_mul, mul_finsum]
    congr 1
    refine finsum_congr (fun γ => ?_)
    rw [mul_finsum]
    refine finsum_congr (fun m => ?_)
    rw [← mul_assoc, hcoef γ m i]
  have hdef : wIncX5 B G l0 D = sw5W B G l0 D := rfl
  show wIncX5 B G l0 D x t Y = _
  rw [hdef, hsw x t Y hxt]
  congr 1
  funext a
  exact (hwave (thetaOf x) a).symm

theorem pch5_tr_phase : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (qs α : ℝ) (a : WC), qs ≤ B.qB → InWg5 B G qs α a → ∀ (γ : Lab) (n : ℤ) (al : Fin 3 → ℂ), ∀ ξ ∈ DomC B.h qs, DifferentiableAt ℝ (modeCoef5 B G (pchAmp5 B a) γ n) ξ ∧ pq5TrM B.h (n * pint5 B G γ) al (modeCoef5 B G (pchAmp5 B a) γ n) ξ = fun i => pchTr5 B G γ n al (pchAmp5 B a γ n) ξ i * Complex.exp (Complex.I * (n : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) :=
by
  intro B G hok hG qs α a hqs ha γ n al ξ hξ
  obtain ⟨hDopen, hqsm, hqpos, -⟩ := domc_open_calculus B qs hok
  have hDn : DomC B.h qs ∈ nhds ξ := hDopen.mem_nhds hξ
  have hqd : DifferentiableAt ℝ (qC B.h) ξ := (hqsm.contDiffAt hDn).differentiableAt (by norm_num)
  have hsR : DifferentiableAt ℝ (fun η => qC B.h η ^ (-Aex B.h)) ξ :=
    hqd.rpow_const (Or.inl (hqpos ξ hξ).ne')
  obtain ⟨sC, hsCdef⟩ : ∃ s : Cyl → ℂ, s = fun η => ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ) := ⟨_, rfl⟩
  have hsC : DifferentiableAt ℝ sC ξ := by
    rw [hsCdef]
    have h0 := Complex.ofRealCLM.differentiableAt.comp ξ hsR
    exact h0
  have hamp : DifferentiableAt ℝ (a γ n) ξ :=
    ((ha.2.1 γ n).contDiffAt hDn).differentiableAt (by norm_num)
  have hmc : DifferentiableAt ℝ (modeCoef5 B G a γ n) ξ :=
    modeCoef5_differentiable_v5 B G hok hG qs α a hqs ha γ n ξ hξ
  have e1 : ∀ i : Fin 3, (fun η => modeCoef5 B G (pchAmp5 B a) γ n η i) =
      fun η => sC η * modeCoef5 B G a γ n η i := by
    intro i; funext η; rw [hsCdef]
    simp only [modeCoef5, pchAmp5, Pi.smul_apply, smul_eq_mul]
    ring
  have e2 : ∀ i : Fin 3, (fun η => pchAmp5 B a γ n η i) = fun η => sC η * a γ n η i := by
    intro i; funext η; rw [hsCdef]
    simp only [pchAmp5, Pi.smul_apply, smul_eq_mul]
  have hmc' : DifferentiableAt ℝ (modeCoef5 B G (pchAmp5 B a) γ n) ξ := by
    refine differentiableAt_pi.2 (fun i => ?_)
    rw [e1 i]
    exact hsC.mul (differentiableAt_pi.1 hmc i)
  have hb : DifferentiableAt ℝ (pchAmp5 B a γ n) ξ := by
    refine differentiableAt_pi.2 (fun i => ?_)
    rw [e2 i]
    exact hsC.mul (differentiableAt_pi.1 hamp i)
  have hcomp : ∀ (c : Cyl → Fin 3 → ℂ) (v : Cyl) (i : Fin 3), DifferentiableAt ℝ c ξ →
      fderiv ℝ c ξ v i = fderiv ℝ (fun η => c η i) ξ v := by
    intro c v i hc
    rw [fderiv_apply hc i]
    rfl
  have hprod : ∀ (f : Cyl → ℂ) (v : Cyl), DifferentiableAt ℝ f ξ →
      fderiv ℝ (fun η => sC η * f η) ξ v = sC ξ * fderiv ℝ f ξ v + fderiv ℝ sC ξ v * f ξ := by
    intro f v hf
    have hP := hsC.hasFDerivAt.mul hf.hasFDerivAt
    rw [show (fun η => sC η * f η) = sC * f from rfl, hP.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have key : ∀ (v : Cyl) (i : Fin 3), fderiv ℝ (modeCoef5 B G (pchAmp5 B a) γ n) ξ v i =
      sC ξ * fderiv ℝ (fun η => modeCoef5 B G a γ n η i) ξ v +
        fderiv ℝ sC ξ v * modeCoef5 B G a γ n ξ i := by
    intro v i
    rw [hcomp _ v i hmc', e1 i, hprod _ v (differentiableAt_pi.1 hmc i)]
  have keyb : ∀ (v : Cyl) (i : Fin 3), fderiv ℝ (pchAmp5 B a γ n) ξ v i =
      sC ξ * fderiv ℝ (fun η => a γ n η i) ξ v + fderiv ℝ sC ξ v * a γ n ξ i := by
    intro v i
    rw [hcomp _ v i hb, e2 i, hprod _ v (differentiableAt_pi.1 hamp i)]
  have hbξ : ∀ i : Fin 3, pchAmp5 B a γ n ξ i = sC ξ * a γ n ξ i := fun i => by
    rw [hsCdef]; rfl
  have hR : ∀ i : Fin 3, dR B.h (modeCoef5 B G (pchAmp5 B a) γ n) ξ i =
      (dR B.h (pchAmp5 B a γ n) ξ i + Complex.I * (n : ℂ) * (kb B.h γ.1 : ℂ) *
        ((dR B.h (phiL5 B G γ) ξ : ℝ) : ℂ) * pchAmp5 B a γ n ξ i) *
        Complex.exp (Complex.I * (n : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) := by
    intro i
    have w := (wmo_phase_deriv_v5 B G hok hG qs α a hqs ha γ n ξ hξ i).1
    simp only [dR] at w ⊢
    rw [key, keyb, w, hbξ]
    simp only [modeCoef5]
    ring
  have hZ : ∀ i : Fin 3, dZ (modeCoef5 B G (pchAmp5 B a) γ n) ξ i =
      (dZ (pchAmp5 B a γ n) ξ i + Complex.I * (n : ℂ) * (kb B.h γ.1 : ℂ) *
        ((dZ (phiL5 B G γ) ξ : ℝ) : ℂ) * pchAmp5 B a γ n ξ i) *
        Complex.exp (Complex.I * (n : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) := by
    intro i
    have w := (wmo_phase_deriv_v5 B G hok hG qs α a hqs ha γ n ξ hξ i).2
    simp only [dZ] at w ⊢
    rw [key, keyb, w, hbξ]
    simp only [modeCoef5]
    ring
  have hval : ∀ j : Fin 3, modeCoef5 B G (pchAmp5 B a) γ n ξ j = pchAmp5 B a γ n ξ j *
      Complex.exp (Complex.I * (n : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) := fun j => rfl

  have hQpos : 0 < Qb γ.1 := by unfold Qb; exact Real.rpow_pos_of_pos two_pos _
  have hKpos : 0 < kb B.h γ.1 := by
    unfold kb epsb
    exact Nat.ceil_pos.2 (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos hQpos _) _)
  have hK0 : (kb B.h γ.1 : ℝ) ≠ 0 := by exact_mod_cast hKpos.ne'
  have hsq : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.2 hQpos
  have hr : 0 < ξ.1 := hξ.1
  have hQ : Qb γ.1 ^ (-(1/2:ℝ)) * Real.sqrt (Qb γ.1) = 1 := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_add hQpos]; norm_num
  have hn0 : nPhi5 B G γ ξ 0 = Real.sqrt (Qb γ.1) * dR B.h (phiL5 B G γ) ξ := rfl
  have hn1 : nPhi5 B G γ ξ 1 =
      ((pint5 B G γ : ℝ) / (kb B.h γ.1 : ℝ)) / (ξ.1 / Real.sqrt (Qb γ.1)) := rfl
  have hn2 : nPhi5 B G γ ξ 2 = Real.sqrt (Qb γ.1) * dZ (phiL5 B G γ) ξ := rfl
  have hgv : ((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))) • nPhi5 B G γ ξ =
      ![(kb B.h γ.1 : ℝ) * dR B.h (phiL5 B G γ) ξ, (pint5 B G γ : ℝ) / ξ.1,
        (kb B.h γ.1 : ℝ) * dZ (phiL5 B G γ) ξ] := by
    funext j
    fin_cases j
    · show ((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))) * nPhi5 B G γ ξ 0 =
        (kb B.h γ.1 : ℝ) * dR B.h (phiL5 B G γ) ξ
      rw [hn0]
      linear_combination ((kb B.h γ.1 : ℝ) * dR B.h (phiL5 B G γ) ξ) * hQ
    · show ((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))) * nPhi5 B G γ ξ 1 = (pint5 B G γ : ℝ) / ξ.1
      rw [hn1]
      calc ((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))) *
            (((pint5 B G γ : ℝ) / (kb B.h γ.1 : ℝ)) / (ξ.1 / Real.sqrt (Qb γ.1)))
          = (Qb γ.1 ^ (-(1/2:ℝ)) * Real.sqrt (Qb γ.1)) * ((pint5 B G γ : ℝ) / ξ.1) *
              ((kb B.h γ.1 : ℝ) / (kb B.h γ.1 : ℝ)) := by
            simp only [div_eq_mul_inv, mul_inv, inv_inv]; ring
        _ = (pint5 B G γ : ℝ) / ξ.1 := by rw [hQ, div_self hK0]; ring
    · show ((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ))) * nPhi5 B G γ ξ 2 =
        (kb B.h γ.1 : ℝ) * dZ (phiL5 B G γ) ξ
      rw [hn2]
      linear_combination ((kb B.h γ.1 : ℝ) * dZ (phiL5 B G γ) ξ) * hQ
  refine ⟨hmc', ?_⟩
  funext i
  simp only [pq5TrM, pchTr5, hgv]
  fin_cases i <;>
    simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue, Fin.reduceFinMk, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two, Matrix.tail_cons, hval, hR, hZ] <;>
    push_cast <;> ring

theorem pch5_local_modes : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (a : WC) (α : ℝ) (H : Finset ℤ), B.ok → InWg5 B G (qsOf l0) α a → (∀ γ m, m ∉ H → a γ m = 0) → ∀ (x : ℝ³) (t : ℝ) (Y₀ : ℝ × ℝ), corrOn B l0 x t → ∃ (O : Set ℝ³) (Γ : Finset Lab), IsOpen O ∧ x ∈ O ∧ (∀ y ∈ O, corrOn B l0 y t) ∧ (∀ γ, γ ∉ Γ → ∀ m, a γ m =ᶠ[nhds (ptOf x t (Yph B.h (rad x) t + Y₀))] 0) ∧ ∀ Γ' : Finset Lab, Γ ⊆ Γ' → ∀ y ∈ O, cyl2cart y (fun i => qC B.h (ptOf y t (Yph B.h (rad y) t + Y₀)) ^ (-Aex B.h) * waveV5 B G a (thetaOf y) (ptOf y t (Yph B.h (rad y) t + Y₀)) i) = ∑ γ ∈ Γ', ∑ m ∈ H, modeF5 B.h 0 t Y₀ (m * pint5 B G γ) (modeCoef5 B G (pchAmp5 B a) γ m) y :=
by
  intro B G l0 a α H hok ha hH x t Y₀ hc
  have hxt' : 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hc
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hξ0D : ptOf x t (Yph B.h (rad x) t + Y₀) ∈ DomC B.h (qsOf l0) := hc

  have hEta : ∀ (h : ℝ), SimScaleProps h → ∀ ξ0 : Cyl, ξ0.2.2.1 < 1 → ∃ N ∈ nhds ξ0, ∃ Γ : Finset Lab,
      ∀ (γ : Lab) (ξ : Cyl), ξ ∈ N → ξ ∈ tsupport (etaL h γ) → γ ∈ Γ := by
    intro h hS ξ0 hξ0
    have hLc : ∀ ξ : Cyl, ξ.2.2.1 < 1 → ContinuousAt (fun η => Real.logb 2 (qC h η)) ξ := by
      intro ξ hξ
      have hτ : 0 < 1 - ξ.2.2.1 := by linarith
      have hqpos : 0 < qC h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
      have hqcont : ContinuousAt (qC h) ξ := by
        have hU : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
        have hp : ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) :=
          ⟨trivial, hτ⟩
        have hg : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (ξ.2.1, 1 - ξ.2.2.1) :=
          hS.2.2.2.1.continuousOn.continuousAt (hU.mem_nhds hp)
        have hk : ContinuousAt (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) ξ := by fun_prop
        have he : qC h = (fun w : ℝ × ℝ => simScale h w.1 w.2) ∘
            (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by
          funext η; rfl
        rw [he]
        exact ContinuousAt.comp hg hk
      exact hqcont.logb hqpos.ne'
    have hwin : ∀ (ξ : Cyl) (γ : Lab), ξ.2.2.1 < 1 → ξ ∈ tsupport (etaL h γ) →
        |Real.logb 2 (qC h ξ) + (γ.1:ℝ)| ≤ 1 ∧
        |chartR h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1:ℝ)| ≤ 1 ∧
        |chartZ h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.1:ℝ)| ≤ 1 ∧
        |chartT h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2:ℝ)| ≤ 1 := by
      intro ξ γ hξ hγ
      have s1 : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ → 1 < |φ ξ / μ - (j : ℝ)| →
          ∀ᶠ η in nhds ξ, sqPart μ j (φ η) = 0 := by
        intro μ j φ hφ h1
        have hψ : ContinuousAt (fun η => |φ η / μ - (j : ℝ)|) ξ :=
          ((hφ.div_const μ).sub continuousAt_const).abs
        have hev := (continuousAt_const : ContinuousAt (fun _ : Cyl => (1:ℝ)) ξ).eventually_lt hψ h1
        filter_upwards [hev] with η hη
        have hsq : 1 < (φ η / μ - (j : ℝ)) ^ 2 := (one_lt_sq_iff_one_lt_abs _).mpr hη
        unfold sqPart bumpR
        rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_div]
      have key : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ →
          (∀ η, sqPart μ j (φ η) = 0 → etaL h γ η = 0) → |φ ξ / μ - (j:ℝ)| ≤ 1 := by
        intro μ j φ hφ himp
        by_contra hc
        push_neg at hc
        have hev := s1 μ j φ hφ hc
        apply (notMem_tsupport_iff_eventuallyEq.mpr _) hγ
        filter_upwards [hev] with η hη
        exact himp η hη
      refine ⟨?_, ?_, ?_, ?_⟩
      · have := key 1 (-(γ.1:ℤ)) (fun η => Real.logb 2 (qC h η)) (hLc ξ hξ)
          (fun η hη => by simp only [etaL, hη, zero_mul])
        simpa [div_one, sub_neg_eq_add] using this
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.1 (chartR h γ.1) (by unfold chartR; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.1 (chartZ h γ.1) (by unfold chartZ; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.2 (chartT h γ.1) (by unfold chartT; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
    obtain ⟨L0, hL0⟩ : ∃ L0 : ℝ, L0 = Real.logb 2 (qC h ξ0) := ⟨_, rfl⟩
    have hfin : (⋃ n ∈ Set.Iic ⌊2 - L0⌋₊, ({n} : Set ℕ) ×ˢ
        ((Set.Icc ⌈chartR h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartR h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋ ×ˢ
          Set.Icc ⌈chartZ h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartZ h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋ ×ˢ
          Set.Icc ⌈chartT h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartT h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋) ×ˢ
          (Set.univ : Set Bool))).Finite := by
      refine Set.Finite.biUnion (Set.finite_Iic _) (fun n _ => ?_)
      exact (Set.finite_singleton n).prod (((Set.finite_Icc _ _).prod
        ((Set.finite_Icc _ _).prod (Set.finite_Icc _ _))).prod Set.finite_univ)
    have hI : ∀ (x c : ℝ) (j : ℤ), |x - (j:ℝ)| ≤ 1 → |x - c| < 1 → j ∈ Set.Icc ⌈c - 2⌉ ⌊c + 2⌋ := by
      intro x c j hj hc
      rw [abs_le] at hj
      rw [abs_lt] at hc
      exact ⟨Int.ceil_le.mpr (by linarith [hj.2, hc.1]), Int.le_floor.mpr (by linarith [hj.1, hc.2])⟩
    have hcR : ∀ n : ℕ, ContinuousAt (chartR h n) ξ0 := fun n => by unfold chartR; fun_prop
    have hcZ : ∀ n : ℕ, ContinuousAt (chartZ h n) ξ0 := fun n => by unfold chartZ; fun_prop
    have hcT : ∀ n : ℕ, ContinuousAt (chartT h n) ξ0 := fun n => by unfold chartT; fun_prop
    have hch : ∀ (φ : Cyl → ℝ) (μ : ℝ), ContinuousAt φ ξ0 →
        ∀ᶠ ξ in nhds ξ0, |φ ξ / μ - φ ξ0 / μ| < 1 := by
      intro φ μ hφ
      exact (((hφ.div_const μ).sub continuousAt_const).abs).eventually_lt continuousAt_const
        (by simp)
    have e1 : ∀ᶠ ξ in nhds ξ0, ξ.2.2.1 < 1 :=
      (show ContinuousAt (fun ξ : Cyl => ξ.2.2.1) ξ0 by fun_prop).eventually_lt
        continuousAt_const hξ0
    have e2 : ∀ᶠ ξ in nhds ξ0, |Real.logb 2 (qC h ξ) - L0| < 1 :=
      (((hLc ξ0 hξ0).sub continuousAt_const).abs).eventually_lt continuousAt_const
        (by simp [hL0])
    have e3 : ∀ᶠ ξ in nhds ξ0, ∀ n ∈ Finset.range (⌊2 - L0⌋₊ + 1),
        |chartR h n ξ / Sb n ^ (-3:ℤ) - chartR h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartZ h n ξ / Sb n ^ (-3:ℤ) - chartZ h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartT h n ξ / Sb n ^ (-3:ℤ) - chartT h n ξ0 / Sb n ^ (-3:ℤ)| < 1 := by
      rw [Filter.eventually_all_finset]
      intro n _
      exact (hch _ _ (hcR n)).and ((hch _ _ (hcZ n)).and (hch _ _ (hcT n)))
    refine ⟨{ξ | ξ.2.2.1 < 1 ∧ |Real.logb 2 (qC h ξ) - L0| < 1 ∧
        ∀ n ∈ Finset.range (⌊2 - L0⌋₊ + 1),
        |chartR h n ξ / Sb n ^ (-3:ℤ) - chartR h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartZ h n ξ / Sb n ^ (-3:ℤ) - chartZ h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartT h n ξ / Sb n ^ (-3:ℤ) - chartT h n ξ0 / Sb n ^ (-3:ℤ)| < 1}, ?_,
      hfin.toFinset, ?_⟩
    · filter_upwards [e1, e2, e3] with ξ h1 h2 h3
      exact ⟨h1, h2, h3⟩
    rintro ⟨n, ⟨a, b, c⟩, σ⟩ ξ ⟨ht, hL, hC⟩ hγ
    obtain ⟨w0, wR, wZ, wT⟩ := hwin ξ _ ht hγ
    simp only at w0 wR wZ wT
    rw [abs_le] at w0
    rw [abs_lt] at hL
    have hn : n ≤ ⌊2 - L0⌋₊ := Nat.le_floor (by linarith [w0.2, hL.1])
    obtain ⟨cR, cZ, cT⟩ := hC n (Finset.mem_range.mpr (Nat.lt_succ_of_le hn))
    rw [Set.Finite.mem_toFinset]
    refine Set.mem_iUnion₂.mpr ⟨n, hn, ?_⟩
    exact ⟨rfl, ⟨hI _ _ _ wR cR, hI _ _ _ wZ cZ, hI _ _ _ wT cT⟩, trivial⟩
  obtain ⟨N, hN, Γ, hΓ⟩ := hEta B.h hok.1 (ptOf x t (Yph B.h (rad x) t + Y₀)) hxt'.2.1

  have hoff : ∀ η ∈ N, η ∈ DomC B.h (qsOf l0) → ∀ (γ : Lab) (m : ℤ), γ ∉ Γ → a γ m η = 0 := by
    intro η hηN hηD γ m hγ
    by_contra hne
    exact hγ (hΓ γ η hηN (ha.2.2.2.1 γ m η hηD hne).2.1)

  have hsum : ∀ (Γ' : Finset Lab) (F : Lab → ℤ → ℂ), (∀ γ m, (γ ∉ Γ' ∨ m ∉ H) → F γ m = 0) →
      ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, F γ m = ∑ γ ∈ Γ', ∑ m ∈ H, F γ m := by
    intro Γ' F hF
    have hin : ∀ γ, ∑ᶠ m : ℤ, F γ m = ∑ m ∈ H, F γ m := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      rw [Function.mem_support] at hm
      by_contra h
      exact hm (hF γ m (Or.inr (by simpa using h)))
    simp_rw [hin]
    apply finsum_eq_sum_of_support_subset
    intro γ hγ
    rw [Function.mem_support] at hγ
    by_contra h
    exact hγ (Finset.sum_eq_zero (fun m _ => hF γ m (Or.inl (by simpa using h))))
  have hphase : ∀ (γ : Lab) (m : ℤ) (θ : ℝ) (η : Cyl), ephase5 B G γ m θ η =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) *
        Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) := by
    intro γ m θ η
    simp only [ephase5]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  have hcyl_sum : ∀ (y : ℝ³) {ι : Type} (s : Finset ι) (v : ι → Fin 3 → ℝ),
      cyl2cart y (∑ j ∈ s, v j) = ∑ j ∈ s, cyl2cart y (v j) := by
    intro y ι s v
    let L : (Fin 3 → ℝ) →+ ℝ³ := AddMonoidHom.mk' (cyl2cart y) (fun c d => by
      simp only [cyl2cart, Pi.add_apply, add_smul]; abel)
    exact map_sum L v s

  have hexpand : ∀ (y : ℝ³) (Γ' : Finset Lab),
      (∀ (γ : Lab) (m : ℤ), (γ ∉ Γ' ∨ m ∉ H) → a γ m (ptOf y t (Yph B.h (rad y) t + Y₀)) = 0) →
      cyl2cart y (fun i => qC B.h (ptOf y t (Yph B.h (rad y) t + Y₀)) ^ (-Aex B.h) *
          waveV5 B G a (thetaOf y) (ptOf y t (Yph B.h (rad y) t + Y₀)) i) =
        ∑ γ ∈ Γ', ∑ m ∈ H, modeF5 B.h 0 t Y₀ (m * pint5 B G γ) (modeCoef5 B G (pchAmp5 B a) γ m) y := by
    intro y Γ' hz
    have hF : ∀ (n : ℤ) (c : Cyl → (Fin 3 → ℂ)), modeF5 B.h 0 t Y₀ n c y =
        cyl2cart y (fun i => (c (ptOf y t (Yph B.h (rad y) t + Y₀)) i *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re) := by
      intro n c
      simp only [modeF5, Real.rpow_zero, one_smul]
    trans cyl2cart y (∑ γ ∈ Γ', ∑ m ∈ H, fun i =>
      (modeCoef5 B G (pchAmp5 B a) γ m (ptOf y t (Yph B.h (rad y) t + Y₀)) i *
        Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf y : ℂ))).re)
    · congr 1
      funext i
      simp only [waveV5, Finset.sum_apply]
      rw [hsum Γ' (fun γ m => a γ m (ptOf y t (Yph B.h (rad y) t + Y₀)) i *
          ephase5 B G γ m (thetaOf y) (ptOf y t (Yph B.h (rad y) t + Y₀)))
        (fun γ m h => by simp only [hz γ m h, Pi.zero_apply, zero_mul]),
        ← Complex.re_ofReal_mul, Finset.mul_sum, Complex.re_sum]
      refine Finset.sum_congr rfl (fun γ _ => ?_)
      rw [Finset.mul_sum, Complex.re_sum]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      rw [hphase]
      simp only [modeCoef5, pchAmp5, Pi.smul_apply, smul_eq_mul]
      congr 1
      ring
    · rw [hcyl_sum]
      refine Finset.sum_congr rfl (fun γ _ => ?_)
      rw [hcyl_sum]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      exact (hF _ _).symm

  have hradc : Continuous rad := by
    unfold rad
    fun_prop
  have hOopen : IsOpen {y : ℝ³ | corrOn B l0 y t ∧
      ptOf y t (Yph B.h (rad y) t + Y₀) ∈ interior N} := by
    rw [isOpen_iff_mem_nhds]
    intro y0 hy0
    have h1 : 0 < rad y0 := hy0.1.1
    have h2 : t < 1 := hy0.1.2.1
    have h3 : simScale B.h (y0 2) (1 - t) < qsOf l0 := hy0.1.2.2
    have h4 : ptOf y0 t (Yph B.h (rad y0) t + Y₀) ∈ interior N := hy0.2
    have e1 : ∀ᶠ y in nhds y0, (0:ℝ) < rad y :=
      continuousAt_const.eventually_lt hradc.continuousAt h1
    have hmem2 : ((y0 2, 1 - t) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ)) :=
      ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩
    have hc1 : ContinuousAt (fun y : ℝ³ => simScale B.h (y 2) (1 - t)) y0 := by
      have h1' : ContinuousAt (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (y0 2, 1 - t) :=
        (hok.1.2.2.2.1.contDiffAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds hmem2)).continuousAt
      have h2' : ContinuousAt (fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ)) y0 := by fun_prop
      exact ContinuousAt.comp (x := y0) (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2)
        (f := fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ)) h1' h2'
    have e3 : ∀ᶠ y in nhds y0, simScale B.h (y 2) (1 - t) < qsOf l0 :=
      hc1.eventually_lt continuousAt_const h3
    have hPc : ContinuousAt (fun y : ℝ³ => ptOf y t (Yph B.h (rad y) t + Y₀)) y0 := by
      have hr1 : ContinuousAt (fun y : ℝ³ => rad y ^ drx B.h) y0 :=
        hradc.continuousAt.rpow_const (Or.inl h1.ne')
      have h4' : ContinuousAt (fun y : ℝ³ => Yph B.h (rad y) t + Y₀) y0 :=
        ((hr1.smul continuousAt_const).add continuousAt_const).add continuousAt_const
      have h2'' : ContinuousAt (fun y : ℝ³ => y 2) y0 := by fun_prop
      exact hradc.continuousAt.prodMk (h2''.prodMk (continuousAt_const.prodMk h4'))
    have e4 : ∀ᶠ y in nhds y0, ptOf y t (Yph B.h (rad y) t + Y₀) ∈ interior N :=
      hPc.preimage_mem_nhds (isOpen_interior.mem_nhds h4)
    filter_upwards [e1, e3, e4] with y a1 a3 a4
    exact ⟨⟨a1, h2, a3⟩, a4⟩
  refine ⟨{y : ℝ³ | corrOn B l0 y t ∧ ptOf y t (Yph B.h (rad y) t + Y₀) ∈ interior N},
    Γ, hOopen, ⟨hc, mem_interior_iff_mem_nhds.mpr hN⟩, fun y hy => hy.1, ?_, ?_⟩
  · intro γ hγ m
    filter_upwards [hN, hDopen.mem_nhds hξ0D] with η hηN hηD
    exact hoff η hηN hηD γ m hγ
  · intro Γ' hΓ' y hy
    have hc' : corrOn B l0 y t := hy.1
    have hi : ptOf y t (Yph B.h (rad y) t + Y₀) ∈ interior N := hy.2
    have hyD : ptOf y t (Yph B.h (rad y) t + Y₀) ∈ DomC B.h (qsOf l0) := hc'
    refine hexpand y Γ' (fun γ m h => ?_)
    rcases h with h | h
    · exact hoff _ (interior_subset hi) hyD γ m (fun hg => h (hΓ' hg))
    · rw [hH γ m h]
      rfl

theorem pch5_pair_regroup : ∀ (B : BG) (G : CorrGeom) (ξ : Cyl) (θ : ℝ) (Mv : Fin 3 → ℝ) (A Bw : WC) (Γ : Finset Lab) (HA HB HN : Finset ℤ), (∀ γ m, m ∉ HA → A γ m ξ = 0) → (∀ γ n, n ∉ HB → Bw γ n =ᶠ[nhds ξ] 0) → (∀ (γ γ' : Lab) (m n : ℤ), γ ≠ γ' → A γ' m ξ ≠ 0 → Bw γ n =ᶠ[nhds ξ] 0) → (∀ n ∈ HB, n ∈ HN) → (∀ n ∈ HB, ∀ m ∈ HA, n + m ∈ HN ∧ n - m ∈ HN) → ∀ i : Fin 3, ∑ γ ∈ Γ, ∑ n ∈ HB, pchTr5 B G γ n (fun j => ((Mv j + (∑ γ' ∈ Γ, ∑ m ∈ HA, A γ' m ξ j * ephase5 B G γ' m θ ξ).re : ℝ) : ℂ)) (Bw γ n) ξ i * ephase5 B G γ n θ ξ = ∑ γ ∈ Γ, ∑ N ∈ HN, (pchTr5 B G γ N (fun j => ((Mv j : ℝ) : ℂ)) (Bw γ N) ξ i + pchPair5 B G A Bw N γ ξ i) * ephase5 B G γ N θ ξ :=
by
  intro B G ξ θ Mv A Bw Γ HA HB HN H1 H2 H3 H4 H5 i

  have hZ : ∀ (γ : Lab) (k : ℤ) (al : Fin 3 → ℂ) (bt : Cyl → Fin 3 → ℂ),
      (al = 0 ∨ bt =ᶠ[nhds ξ] 0) → pchTr5 B G γ k al bt ξ = 0 := by
    intro γ k al bt h
    rcases h with h | h
    · subst h
      funext j
      fin_cases j <;> simp [pchTr5]
    · have h0 : bt ξ = 0 := h.eq_of_nhds
      have hd : fderiv ℝ bt ξ = 0 := by
        rw [h.fderiv_eq]
        exact congrFun fderiv_zero ξ
      have hr : dR B.h bt ξ = 0 := by simp only [dR, hd, ContinuousLinearMap.zero_apply]
      have hz : dZ bt ξ = 0 := by simp only [dZ, hd, ContinuousLinearMap.zero_apply]
      funext j
      fin_cases j <;> simp [pchTr5, h0, hr, hz]

  have hadd : ∀ (γ : Lab) (k : ℤ) (bt : Cyl → Fin 3 → ℂ) (u v : Fin 3 → ℂ),
      pchTr5 B G γ k (u + v) bt ξ = pchTr5 B G γ k u bt ξ + pchTr5 B G γ k v bt ξ := by
    intro γ k bt u v
    funext j
    fin_cases j <;> simp [pchTr5] <;> ring
  have hsmul : ∀ (γ : Lab) (k : ℤ) (bt : Cyl → Fin 3 → ℂ) (c : ℂ) (u : Fin 3 → ℂ),
      pchTr5 B G γ k (c • u) bt ξ = c • pchTr5 B G γ k u bt ξ := by
    intro γ k bt c u
    funext j
    fin_cases j <;> simp [pchTr5] <;> ring
  have hsum : ∀ {ι : Type} (γ : Lab) (k : ℤ) (bt : Cyl → Fin 3 → ℂ) (s : Finset ι)
      (f : ι → Fin 3 → ℂ), pchTr5 B G γ k (∑ x ∈ s, f x) bt ξ = ∑ x ∈ s, pchTr5 B G γ k (f x) bt ξ := by
    intro ι γ k bt s f
    classical
    refine Finset.induction_on s ?_ ?_
    · rw [Finset.sum_empty, Finset.sum_empty]
      exact hZ γ k 0 bt (Or.inl rfl)
    · intro a s ha ih
      rw [Finset.sum_insert ha, Finset.sum_insert ha, hadd, ih]

  have hph : ∀ (γ : Lab) (m n : ℤ), ephase5 B G γ m θ ξ * ephase5 B G γ n θ ξ = ephase5 B G γ (n + m) θ ξ ∧
      star (ephase5 B G γ m θ ξ) * ephase5 B G γ n θ ξ = ephase5 B G γ (n - m) θ ξ := by
    intro γ m n
    have e : ∀ k : ℤ, ephase5 B G γ k θ ξ = Complex.exp (Complex.I * (k : ℂ) *
        (((pint5 B G γ : ℝ) * θ + (kb B.h γ.1 : ℝ) * phiL5 B G γ ξ : ℝ) : ℂ)) := by
      intro k
      simp only [ephase5, Complex.ofReal_add, Complex.ofReal_mul, Complex.ofReal_intCast,
        Complex.ofReal_natCast]
    simp only [e]
    constructor
    · rw [← Complex.exp_add]
      congr 1
      push_cast
      ring
    · rw [← starRingEnd_apply, ← Complex.exp_conj, ← Complex.exp_add]
      congr 1
      simp only [map_mul, Complex.conj_I, map_intCast, Complex.conj_ofReal]
      push_cast
      ring

  have hA : (fun j => ((Mv j + (∑ γ' ∈ Γ, ∑ m ∈ HA, A γ' m ξ j * ephase5 B G γ' m θ ξ).re : ℝ) : ℂ)) =
      (fun j => ((Mv j : ℝ) : ℂ)) + ∑ γ' ∈ Γ, ∑ m ∈ HA,
        (((1/2 : ℂ) * ephase5 B G γ' m θ ξ) • A γ' m ξ +
          ((1/2 : ℂ) * star (ephase5 B G γ' m θ ξ)) • (fun j => star (A γ' m ξ j))) := by
    funext j
    simp only [Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    rw [Complex.ofReal_add, Complex.re_eq_add_conj]
    congr 1
    simp only [map_sum, map_mul, starRingEnd_apply, star_sum, star_mul']
    rw [← Finset.sum_add_distrib, Finset.sum_div]
    refine Finset.sum_congr rfl (fun γ' _ => ?_)
    rw [← Finset.sum_add_distrib, Finset.sum_div]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    ring

  have hshift : ∀ (d : ℤ) (F : ℤ → ℤ → ℂ), (∀ n ∈ HB, n + d ∈ HN) →
      (∀ N ∈ HN, N - d ∉ HB → F (N - d) N = 0) →
      ∑ N ∈ HN, F (N - d) N = ∑ n ∈ HB, F n (n + d) := by
    intro d F h1 h2
    have himg : HB.image (fun x => x + d) ⊆ HN := by
      intro N hN
      rw [Finset.mem_image] at hN
      obtain ⟨n, hn, rfl⟩ := hN
      exact h1 n hn
    have hz : ∀ N ∈ HN, N ∉ HB.image (fun x => x + d) → F (N - d) N = 0 := by
      intro N hN hN'
      apply h2 N hN
      intro hc
      apply hN'
      rw [Finset.mem_image]
      exact ⟨N - d, hc, sub_add_cancel N d⟩
    have hinj : Set.InjOn (fun x => x + d) (HB : Set ℤ) := by
      intro x _ y _ hxy
      simpa using hxy
    rw [← Finset.sum_subset himg hz, Finset.sum_image hinj]
    simp only [add_sub_cancel_right]
  have hsub : HB ⊆ HN := by
    intro n hn
    exact H4 n hn
  refine Finset.sum_congr rfl (fun γ hγ => ?_)

  have hB : ∀ n : ℤ, pchTr5 B G γ n (fun j => ((Mv j + (∑ γ' ∈ Γ, ∑ m ∈ HA, A γ' m ξ j * ephase5 B G γ' m θ ξ).re : ℝ) : ℂ)) (Bw γ n) ξ i * ephase5 B G γ n θ ξ =
      pchTr5 B G γ n (fun j => ((Mv j : ℝ) : ℂ)) (Bw γ n) ξ i * ephase5 B G γ n θ ξ +
      ∑ m ∈ HA, ((1/2 : ℂ) * pchTr5 B G γ n (A γ m ξ) (Bw γ n) ξ i * ephase5 B G γ (n + m) θ ξ +
        (1/2 : ℂ) * pchTr5 B G γ n (fun j => star (A γ m ξ j)) (Bw γ n) ξ i * ephase5 B G γ (n - m) θ ξ) := by
    intro n
    rw [hA, hadd, hsum, Finset.sum_eq_single_of_mem γ hγ]
    · rw [hsum]
      simp only [hadd, hsmul, Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, add_mul,
        Finset.sum_mul]
      congr 1
      refine Finset.sum_congr rfl (fun m _ => ?_)
      rw [← (hph γ m n).1, ← (hph γ m n).2]
      ring
    · intro γ' _ hne
      beta_reduce
      rw [hsum]
      refine Finset.sum_eq_zero (fun m _ => ?_)
      rw [hadd, hsmul, hsmul]
      by_cases ha : A γ' m ξ = 0
      · have hab : (fun j => star (A γ' m ξ j)) = 0 := by
          funext j
          simp [ha]
        rw [hZ γ n _ _ (Or.inl ha), hZ γ n _ _ (Or.inl hab)]
        simp
      · have hb := H3 γ γ' m n (Ne.symm hne) ha
        rw [hZ γ n _ _ (Or.inr hb), hZ γ n _ _ (Or.inr hb)]
        simp

  have hP : ∀ N : ℤ, pchPair5 B G A Bw N γ ξ i = ∑ m ∈ HA,
      ((1/2 : ℂ) * pchTr5 B G γ (N - m) (A γ m ξ) (Bw γ (N - m)) ξ i +
        (1/2 : ℂ) * pchTr5 B G γ (N + m) (fun j => star (A γ m ξ j)) (Bw γ (N + m)) ξ i) := by
    intro N
    unfold pchPair5
    rw [finsum_eq_sum_of_support_subset (s := HA) _ ?_]
    · simp only [Finset.sum_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    · intro m hm
      simp only [Function.mem_support, ne_eq] at hm
      rw [Finset.mem_coe]
      by_contra hn
      apply hm
      have h0 : A γ m ξ = 0 := H1 γ m hn
      have h0' : (fun j => star (A γ m ξ j)) = 0 := by
        funext j
        simp [h0]
      rw [h0', hZ _ _ _ _ (Or.inl h0), hZ _ _ _ _ (Or.inl rfl)]
      simp
  rw [Finset.sum_congr rfl (fun n _ => hB n)]
  simp only [hP, add_mul, Finset.sum_mul, Finset.sum_add_distrib]
  congr 1
  ·
    refine Finset.sum_subset hsub (fun N _ hN => ?_)
    beta_reduce
    rw [hZ γ _ _ _ (Or.inr (H2 γ N hN))]
    simp
  · congr 1
    · rw [Finset.sum_comm (s := HB), Finset.sum_comm (s := HN)]
      refine Finset.sum_congr rfl (fun m hm => ?_)
      refine (hshift m (fun k N => (1/2 : ℂ) * pchTr5 B G γ k (A γ m ξ) (Bw γ k) ξ i *
        ephase5 B G γ N θ ξ) (fun n hn => (H5 n hn m hm).1) (fun N _ hN => ?_)).symm
      beta_reduce
      rw [hZ γ _ _ _ (Or.inr (H2 γ _ hN))]
      simp
    · rw [Finset.sum_comm (s := HB), Finset.sum_comm (s := HN)]
      refine Finset.sum_congr rfl (fun m hm => ?_)
      have h1 : ∀ n ∈ HB, n + -m ∈ HN := by
        intro n hn
        rw [← sub_eq_add_neg]
        exact (H5 n hn m hm).2
      have h2 : ∀ N ∈ HN, N - -m ∉ HB → (fun k N => (1/2 : ℂ) *
          pchTr5 B G γ k (fun j => star (A γ m ξ j)) (Bw γ k) ξ i * ephase5 B G γ N θ ξ) (N - -m) N = 0 := by
        intro N _ hN
        beta_reduce
        rw [hZ γ _ _ _ (Or.inr (H2 γ _ hN))]
        simp
      have := hshift (-m) (fun k N => (1/2 : ℂ) *
          pchTr5 B G γ k (fun j => star (A γ m ξ j)) (Bw γ k) ξ i * ephase5 B G γ N θ ξ) h1 h2
      simp only [sub_neg_eq_add, ← sub_eq_add_neg] at this
      exact this.symm

theorem pch5_mean_regroup : ∀ (B : BG) (G : CorrGeom) (Mn : Cyl → Fin 3 → ℝ) (Bw : WC) (ξ : Cyl) (θ : ℝ) (Γ : Finset Lab) (H : Finset ℤ), DifferentiableAt ℝ Mn ξ → ∀ i : Fin 3, (pq5TrM B.h 0 (fun j => (((∑ γ ∈ Γ, ∑ n ∈ H, Bw γ n ξ j * ephase5 B G γ n θ ξ).re : ℝ) : ℂ)) (pchMnC5 Mn) ξ i).re = (∑ γ ∈ Γ, ∑ n ∈ H, pchTr5 B G γ 0 (Bw γ n ξ) (pchMnC5 Mn) ξ i * ephase5 B G γ n θ ξ).re :=
by
  intro B G Mn Bw ξ θ Γ H hMn i
  let Lc : (Fin 3 → ℝ) →L[ℝ] (Fin 3 → ℂ) :=
    ContinuousLinearMap.pi (fun j : Fin 3 => Complex.ofRealCLM.comp (ContinuousLinearMap.proj j))
  have hLc : ∀ v : Fin 3 → ℝ, Lc v = fun j => ((v j : ℝ) : ℂ) := by
    intro v; funext j; simp [Lc]
  have hfun : pchMnC5 Mn = ⇑Lc ∘ Mn := by
    funext η j; simp [pchMnC5, Lc]
  have hder : ∀ v : Cyl, fderiv ℝ (pchMnC5 Mn) ξ v = Lc (fderiv ℝ Mn ξ v) := by
    intro v
    rw [hfun, fderiv_comp ξ Lc.differentiableAt hMn, ContinuousLinearMap.fderiv]
    rfl
  have hdR : ∀ j, dR B.h (pchMnC5 Mn) ξ j = ((dR B.h Mn ξ j : ℝ) : ℂ) := by
    intro j; unfold dR; rw [hder, hLc]
  have hdZ : ∀ j, dZ (pchMnC5 Mn) ξ j = ((dZ Mn ξ j : ℝ) : ℂ) := by
    intro j; unfold dZ; rw [hder, hLc]
  have hrowPQ : ∀ U : Fin 3 → ℂ, pq5TrM B.h 0 U (pchMnC5 Mn) ξ i =
      U 0 * ((dR B.h Mn ξ i : ℝ) : ℂ) +
        U 1 * (((![-(Mn ξ 1) / ξ.1, Mn ξ 0 / ξ.1, 0] : Fin 3 → ℝ) i : ℝ) : ℂ) +
        U 2 * ((dZ Mn ξ i : ℝ) : ℂ) := by
    intro U
    fin_cases i <;> simp [pq5TrM, hdR, hdZ, pchMnC5] <;> ring
  have hrowTr : ∀ (γ : Lab) (al : Fin 3 → ℂ), pchTr5 B G γ 0 al (pchMnC5 Mn) ξ i =
      al 0 * ((dR B.h Mn ξ i : ℝ) : ℂ) +
        al 1 * (((![-(Mn ξ 1) / ξ.1, Mn ξ 0 / ξ.1, 0] : Fin 3 → ℝ) i : ℝ) : ℂ) +
        al 2 * ((dZ Mn ξ i : ℝ) : ℂ) := by
    intro γ al
    fin_cases i <;> simp [pchTr5, hdR, hdZ, pchMnC5] <;> ring
  rw [hrowPQ]
  have hsum : ∑ γ ∈ Γ, ∑ n ∈ H, pchTr5 B G γ 0 (Bw γ n ξ) (pchMnC5 Mn) ξ i * ephase5 B G γ n θ ξ =
      (∑ γ ∈ Γ, ∑ n ∈ H, Bw γ n ξ 0 * ephase5 B G γ n θ ξ) * ((dR B.h Mn ξ i : ℝ) : ℂ) +
        (∑ γ ∈ Γ, ∑ n ∈ H, Bw γ n ξ 1 * ephase5 B G γ n θ ξ) *
          (((![-(Mn ξ 1) / ξ.1, Mn ξ 0 / ξ.1, 0] : Fin 3 → ℝ) i : ℝ) : ℂ) +
        (∑ γ ∈ Γ, ∑ n ∈ H, Bw γ n ξ 2 * ephase5 B G γ n θ ξ) * ((dZ Mn ξ i : ℝ) : ℂ) := by
    simp only [hrowTr, Finset.sum_mul, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun γ _ => Finset.sum_congr rfl (fun n _ => by ring))
  rw [hsum]
  simp only [Complex.add_re, Complex.re_mul_ofReal, Complex.ofReal_re]

theorem pch5_har_assemble : ∀ (B : BG) (G : CorrGeom) (Mn : Cyl → Fin 3 → ℝ) (P Q : WC) (ξ : Cyl) (θ : ℝ) (Γ : Finset Lab) (HP HQ HN : Finset ℤ), 0 < qC B.h ξ → (∀ γ m, m ∉ HP → P γ m = 0) → (∀ γ m, m ∉ HQ → Q γ m = 0) → (∀ γ, γ ∉ Γ → ∀ m, P γ m =ᶠ[nhds ξ] 0 ∧ Q γ m =ᶠ[nhds ξ] 0) → (∀ n ∈ HQ, n ∈ HN) → (∀ n ∈ HQ, ∀ m ∈ HP, n + m ∈ HN ∧ n - m ∈ HN) → (∀ n ∈ HP, ∀ m ∈ HQ, n + m ∈ HN ∧ n - m ∈ HN) → ∀ i : Fin 3, (∑ γ ∈ Γ, ∑ N ∈ HN, pchHar5 B G Mn P Q γ N ξ i * ephase5 B G γ N θ ξ).re = qC B.h ξ ^ (-(2 * Aex B.h + 1/2)) * waveV5 B G (pchG5 B G Mn P Q) θ ξ i + pchZ5 B G Mn P Q ξ i :=
by
  intro B G Mn P Q ξ θ Γ HP HQ HN hq hP hQ hΓ h1 h2 h3 i

  have tr0 : ∀ (γ : Lab) (k : ℤ) (al : Fin 3 → ℂ) (bt : Cyl → Fin 3 → ℂ),
      (al = 0 ∨ bt =ᶠ[nhds ξ] 0) → pchTr5 B G γ k al bt ξ = 0 := by
    intro γ k al bt h
    rcases h with h | h
    · subst h
      funext j
      fin_cases j <;> simp [pchTr5]
    · have hv : bt ξ = 0 := h.eq_of_nhds
      have hd : fderiv ℝ bt ξ = 0 := by
        rw [h.fderiv_eq]
        first
          | simp
          | exact fderiv_const_apply 0
      have hR : dR B.h bt ξ = 0 := by simp [dR, hd]
      have hZ : dZ bt ξ = 0 := by simp [dZ, hd]
      funext j
      fin_cases j <;> simp [pchTr5, hv, hR, hZ]

  have pair0 : ∀ (A Bw : WC) (N : ℤ) (γ : Lab),
      (∀ m : ℤ, A γ m ξ = 0 ∨ (Bw γ (N - m) =ᶠ[nhds ξ] 0 ∧ Bw γ (N + m) =ᶠ[nhds ξ] 0)) →
      pchPair5 B G A Bw N γ ξ = 0 := by
    intro A Bw N γ h
    unfold pchPair5
    apply finsum_eq_zero_of_forall_eq_zero
    intro m
    rcases h m with hm | ⟨ha, hb⟩
    · have hs : (fun j => star (A γ m ξ j)) = 0 := by
        funext j; simp [hm]
      rw [tr0 γ (N - m) (A γ m ξ) (Bw γ (N - m)) (Or.inl hm),
        tr0 γ (N + m) (fun j => star (A γ m ξ j)) (Bw γ (N + m)) (Or.inl hs)]
      simp
    · rw [tr0 γ (N - m) (A γ m ξ) (Bw γ (N - m)) (Or.inr ha),
        tr0 γ (N + m) (fun j => star (A γ m ξ j)) (Bw γ (N + m)) (Or.inr hb)]
      simp

  have amp1 : ∀ (W : WC) (γ : Lab) (m : ℤ), W γ m = 0 → pchAmp5 B W γ m = 0 := by
    intro W γ m h; funext η; simp [pchAmp5, h]
  have amp1e : ∀ (W : WC) (γ : Lab) (m : ℤ), W γ m = 0 → pchAmp5 B W γ m =ᶠ[nhds ξ] 0 :=
    fun W γ m h => Filter.Eventually.of_forall (fun η => congrFun (amp1 W γ m h) η)
  have amp1v : ∀ (W : WC) (γ : Lab) (m : ℤ), W γ m = 0 → pchAmp5 B W γ m ξ = 0 :=
    fun W γ m h => congrFun (amp1 W γ m h) ξ
  have amp2 : ∀ (W : WC) (γ : Lab) (m : ℤ), W γ m =ᶠ[nhds ξ] 0 → pchAmp5 B W γ m =ᶠ[nhds ξ] 0 := by
    intro W γ m h
    filter_upwards [h] with η hη
    simp [pchAmp5, hη]

  have hV : ∀ (γ : Lab) (N : ℤ), (γ ∉ Γ ∨ N ∉ HN) → pchHar5 B G Mn P Q γ N ξ = 0 := by
    intro γ N hγN
    have key : pchAmp5 B Q γ N =ᶠ[nhds ξ] 0 ∧
        pchPair5 B G (pchAmp5 B P) (pchAmp5 B Q) N γ ξ = 0 ∧
        pchPair5 B G (pchAmp5 B Q) (pchAmp5 B P) N γ ξ = 0 := by
      rcases hγN with hγ | hN
      · refine ⟨amp2 Q γ N (hΓ γ hγ N).2, pair0 _ _ N γ (fun m => Or.inl ?_),
          pair0 _ _ N γ (fun m => Or.inl ?_)⟩
        · exact (amp2 P γ m (hΓ γ hγ m).1).eq_of_nhds
        · exact (amp2 Q γ m (hΓ γ hγ m).2).eq_of_nhds
      · have hNQ : N ∉ HQ := fun h => hN (h1 N h)
        refine ⟨amp1e Q γ N (hQ γ N hNQ), pair0 _ _ N γ (fun m => ?_), pair0 _ _ N γ (fun m => ?_)⟩
        · by_cases hm : m ∈ HP
          · right
            have a1 : N - m ∉ HQ := fun h => hN (by simpa using (h2 (N - m) h m hm).1)
            have a2 : N + m ∉ HQ := fun h => hN (by simpa using (h2 (N + m) h m hm).2)
            exact ⟨amp1e Q γ _ (hQ γ _ a1), amp1e Q γ _ (hQ γ _ a2)⟩
          · left
            exact amp1v P γ m (hP γ m hm)
        · by_cases hm : m ∈ HQ
          · right
            have a1 : N - m ∉ HP := fun h => hN (by simpa using (h3 (N - m) h m hm).1)
            have a2 : N + m ∉ HP := fun h => hN (by simpa using (h3 (N + m) h m hm).2)
            exact ⟨amp1e P γ _ (hP γ _ a1), amp1e P γ _ (hP γ _ a2)⟩
          · left
            exact amp1v Q γ m (hQ γ m hm)
    obtain ⟨k1, k2, k3⟩ := key
    unfold pchHar5
    rw [tr0 γ N (pchMnC5 Mn ξ) (pchAmp5 B Q γ N) (Or.inr k1),
      tr0 γ 0 (pchAmp5 B Q γ N ξ) (pchMnC5 Mn) (Or.inl k1.eq_of_nhds), k2, k3]
    simp

  have hG : ∀ (γ : Lab) (N : ℤ), pchG5 B G Mn P Q γ N ξ i =
      if N = 0 then 0 else ((qC B.h ξ ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) * pchHar5 B G Mn P Q γ N ξ i := by
    intro γ N
    simp only [pchG5]
    split_ifs <;> simp
  have hW : waveV5 B G (pchG5 B G Mn P Q) θ ξ i =
      (∑ γ ∈ Γ, ∑ N ∈ HN, pchG5 B G Mn P Q γ N ξ i * ephase5 B G γ N θ ξ).re := by
    simp only [waveV5]
    congr 1
    have hin : ∀ γ, ∑ᶠ N : ℤ, pchG5 B G Mn P Q γ N ξ i * ephase5 B G γ N θ ξ =
        ∑ N ∈ HN, pchG5 B G Mn P Q γ N ξ i * ephase5 B G γ N θ ξ := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro N hN
      by_contra hNH
      apply hN
      beta_reduce
      rw [hG, hV γ N (Or.inr (fun h => hNH (Finset.mem_coe.mpr h)))]
      simp
    simp only [hin]
    apply finsum_eq_sum_of_support_subset
    intro γ hγ
    by_contra hγΓ
    apply hγ
    beta_reduce
    apply Finset.sum_eq_zero
    intro N _
    rw [hG, hV γ N (Or.inl (fun h => hγΓ (Finset.mem_coe.mpr h)))]
    simp
  have hZ : pchZ5 B G Mn P Q ξ i = (∑ γ ∈ Γ, pchHar5 B G Mn P Q γ 0 ξ i).re := by
    simp only [pchZ5]
    congr 1
    apply finsum_eq_sum_of_support_subset
    intro γ hγ
    by_contra hγΓ
    apply hγ
    simp [hV γ 0 (Or.inl (fun h => hγΓ (Finset.mem_coe.mpr h)))]
  have hce : qC B.h ξ ^ (-(2 * Aex B.h + 1/2)) * qC B.h ξ ^ (2 * Aex B.h + 1/2) = 1 := by
    rw [Real.rpow_neg hq.le]
    exact inv_mul_cancel₀ (ne_of_gt (Real.rpow_pos_of_pos hq _))
  have hce' : ((qC B.h ξ ^ (-(2 * Aex B.h + 1/2)) : ℝ) : ℂ) * ((qC B.h ξ ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) = 1 := by
    rw [← Complex.ofReal_mul, hce, Complex.ofReal_one]
  have hsplitN : ∀ γ, ∑ N ∈ HN, pchHar5 B G Mn P Q γ N ξ i * ephase5 B G γ N θ ξ =
      ∑ N ∈ HN, (if N = 0 then 0 else pchHar5 B G Mn P Q γ N ξ i) * ephase5 B G γ N θ ξ +
      pchHar5 B G Mn P Q γ 0 ξ i := by
    intro γ
    have e1 : ∀ N : ℤ, pchHar5 B G Mn P Q γ N ξ i * ephase5 B G γ N θ ξ =
        (if N = 0 then 0 else pchHar5 B G Mn P Q γ N ξ i) * ephase5 B G γ N θ ξ +
        (if N = 0 then pchHar5 B G Mn P Q γ N ξ i * ephase5 B G γ N θ ξ else 0) := by
      intro N; split_ifs <;> simp
    rw [Finset.sum_congr rfl (fun N _ => e1 N), Finset.sum_add_distrib]
    congr 1
    simp only [Finset.sum_ite_eq']
    split_ifs with h0
    · simp [ephase5]
    · simp [hV γ 0 (Or.inr h0)]
  rw [hW, hZ, ← Complex.re_ofReal_mul, Finset.mul_sum,
    Finset.sum_congr rfl (fun γ _ => hsplitN γ), Finset.sum_add_distrib, Complex.add_re]
  congr 1
  congr 1
  refine Finset.sum_congr rfl (fun γ _ => ?_)
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl (fun N _ => ?_)
  rw [hG]
  split_ifs
  · simp
  · linear_combination (-(pchHar5 B G Mn P Q γ N ξ i * ephase5 B G γ N θ ξ)) * hce'

theorem pch5_transport_identity : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (Mn : Cyl → Fin 3 → ℝ) (P Q : WC) (α β : ℝ) (U V : Ext ℝ³), ContDiffOn ℝ ∞ Mn (DomC B.h (qsOf l0)) → InWg5 B G (qsOf l0) α P → InWg5 B G (qsOf l0) β Q → (∀ (Y₀ : ℝ × ℝ) (x : ℝ³) (t : ℝ), corrOn B l0 x t → evOff B.h U Y₀ x t = cyl2cart x (fun a => Mn (ptOf x t (Yph B.h (rad x) t + Y₀)) a + qC B.h (ptOf x t (Yph B.h (rad x) t + Y₀)) ^ (-Aex B.h) * waveV5 B G P (thetaOf x) (ptOf x t (Yph B.h (rad x) t + Y₀)) a)) → (∀ (Y₀ : ℝ × ℝ) (x : ℝ³) (t : ℝ), corrOn B l0 x t → evOff B.h V Y₀ x t = cyl2cart x (fun a => qC B.h (ptOf x t (Yph B.h (rad x) t + Y₀)) ^ (-Aex B.h) * waveV5 B G Q (thetaOf x) (ptOf x t (Yph B.h (rad x) t + Y₀)) a)) → ∀ x t Y, corrOn B l0 x t → pwrTr B.h U V x t Y + pwrTr B.h V U x t Y = cyl2cart x (fun a => qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2)) * waveV5 B G (pchG5 B G Mn P Q) (thetaOf x) (ptOf x t Y) a + pchZ5 B G Mn P Q (ptOf x t Y) a) :=
by
  intro B G hok hG
  obtain ⟨lD, hLD⟩ := pq5_label_disjoint B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨lD + n0, fun l0 hl0 Mn P Q α β U V hMn hP hQ hU hV x t Y hc => ?_⟩

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le

  have hc' : 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hc
  obtain ⟨hDopen, -, hqpos, -⟩ := domc_open_calculus B (qsOf l0) hok
  obtain ⟨Y0, hY0⟩ : ∃ Y0 : ℝ × ℝ, Y0 = Y - Yph B.h (rad x) t := ⟨_, rfl⟩
  obtain ⟨ξ, hξ⟩ : ∃ ξ : Cyl, ξ = ptOf x t Y := ⟨_, rfl⟩
  have hζx : ptOf x t (Yph B.h (rad x) t + Y0) = ξ := by rw [hξ, hY0]; simp
  have hξD : ξ ∈ DomC B.h (qsOf l0) := by rw [hξ]; exact hc
  have hq : 0 < qC B.h ξ := hqpos ξ hξD
  have hDn : DomC B.h (qsOf l0) ∈ nhds ξ := hDopen.mem_nhds hξD
  have hMnd : DifferentiableAt ℝ Mn ξ := (hMn.contDiffAt hDn).differentiableAt (by norm_num)
  have hMnCd : DifferentiableAt ℝ (pchMnC5 Mn) ξ :=
    differentiableAt_pi.2 (fun i => Complex.ofRealCLM.differentiableAt.comp ξ (differentiableAt_pi.1 hMnd i))
  have hMnCd' : DifferentiableAt ℝ (pchMnC5 Mn) (ptOf x t (Yph B.h (rad x) t + Y0)) := by
    rw [hζx]; exact hMnCd
  obtain ⟨HP, -, hHP⟩ := hP.1
  obtain ⟨HQ, -, hHQ⟩ := hQ.1
  have hHP' : ∀ γ m, m ∉ HP → P γ m = 0 := fun γ m hm => hHP γ m hm
  have hHQ' : ∀ γ m, m ∉ HQ → Q γ m = 0 := fun γ m hm => hHQ γ m hm

  have hTr0 : ∀ (γ : Lab) (k : ℤ) (bt : Cyl → Fin 3 → ℂ) (η : Cyl), pchTr5 B G γ k 0 bt η = 0 := by
    intro γ k bt η
    funext i
    fin_cases i <;> simp [pchTr5]
  have hfs : ∀ (a : WC) (θ : ℝ) (η : Cyl) (Γ : Finset Lab) (H : Finset ℤ),
      (∀ γ m, γ ∉ Γ → a γ m η = 0) → (∀ γ m, m ∉ H → a γ m η = 0) →
      ∀ i, waveV5 B G a θ η i = (∑ γ ∈ Γ, ∑ m ∈ H, a γ m η i * ephase5 B G γ m θ η).re := by
    intro a θ η Γ H hΓ hH i
    unfold waveV5
    congr 1
    have hin : ∀ γ, ∑ᶠ m : ℤ, a γ m η i * ephase5 B G γ m θ η =
        ∑ m ∈ H, a γ m η i * ephase5 B G γ m θ η := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      by_contra hmH
      apply hm
      have h0 : a γ m η = 0 := hH γ m (fun h => hmH (Finset.mem_coe.mpr h))
      simp [h0]
    simp only [hin]
    apply finsum_eq_sum_of_support_subset
    intro γ hγ
    by_contra hγΓ
    apply hγ
    have h0 : ∀ m, a γ m η = 0 := fun m => hΓ γ m (fun h => hγΓ (Finset.mem_coe.mpr h))
    simp [h0]
  have hsplit : ∀ (γ : Lab) (m : ℤ) (θ : ℝ) (η : Cyl), ephase5 B G γ m θ η =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) *
        Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) := by
    intro γ m θ η
    unfold ephase5
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  have hcadd : ∀ (y : ℝ³) (u v : Fin 3 → ℝ), cyl2cart y u + cyl2cart y v = cyl2cart y (fun i => u i + v i) := by
    intro y u v
    simp only [cyl2cart, add_smul]
    abel

  have hlin : ∀ (a b d : Fin 3 → ℝ) (s1 s2 s3 : ℝ),
      s1 • cyl2cart x a + s2 • cyl2cart x b + s3 • cyl2cart x d =
        cyl2cart x (fun i => s1 * a i + s2 * b i + s3 * d i) := by
    intro a b d s1 s2 s3
    simp only [cyl2cart, add_smul, smul_add, smul_smul]
    abel
  have hjet : ∀ (n' : ℤ) (c : Cyl → (Fin 3 → ℂ)) (v : Fin 3 → ℝ),
      DifferentiableAt ℝ c (ptOf x t (Yph B.h (rad x) t + Y0)) →
      fderiv ℝ (modeF5 B.h 0 t Y0 n' c) x (cyl2cart x v) =
        cyl2cart x (fun i => (pq5TrM B.h n' (fun a => ((v a : ℝ) : ℂ)) c ξ i *
          Complex.exp (Complex.I * (n' : ℂ) * (thetaOf x : ℂ))).re) := by
    intro n' c v hcd
    have hR := pq5_jet_R B.h t Y0 n' c x hok.1 hc'.2.1 hc'.1 hcd
    have hZ := pq5_jet_Z B.h t Y0 n' c x hok.1 hc'.2.1 hc'.1 hcd
    have hT := pq5_jet_Th B.h t Y0 n' c x hok.1 hc'.2.1 hc'.1 hcd
    rw [hζx] at hR hZ hT
    have e1 : cyl2cart x v = v 0 • eR x + v 1 • eTh x + v 2 • eZ := rfl
    rw [e1, map_add, map_add, map_smul, map_smul, map_smul, hR, hZ, hT, hlin]
    congr 1
    funext i
    rw [← Complex.re_ofReal_mul, ← Complex.re_ofReal_mul, ← Complex.re_ofReal_mul,
      ← Complex.add_re, ← Complex.add_re]
    congr 1
    rw [hξ]
    fin_cases i <;> simp [pq5TrM, ptOf] <;> ring

  have hTr : ∀ (W : WC) (αW : ℝ), InWg5 B G (qsOf l0) αW W → ∀ (γ : Lab) (n : ℤ) (v : Fin 3 → ℝ),
      fderiv ℝ (modeF5 B.h 0 t Y0 (n * pint5 B G γ) (modeCoef5 B G (pchAmp5 B W) γ n)) x (cyl2cart x v) =
        cyl2cart x (fun i => (pchTr5 B G γ n (fun a => ((v a : ℝ) : ℂ)) (pchAmp5 B W γ n) ξ i *
          ephase5 B G γ n (thetaOf x) ξ).re) := by
    intro W αW hW γ n v
    obtain ⟨hd, he⟩ := pch5_tr_phase B G hok hG (qsOf l0) αW W hqsB hW γ n (fun a => ((v a : ℝ) : ℂ)) ξ hξD
    rw [hjet _ _ v (by rw [hζx]; exact hd), he]
    congr 1
    funext i
    beta_reduce
    rw [hsplit]
    congr 1
    ring
  have hcd : ∀ (W : WC) (αW : ℝ), InWg5 B G (qsOf l0) αW W → ∀ (γ : Lab) (n : ℤ),
      DifferentiableAt ℝ (modeF5 B.h 0 t Y0 (n * pint5 B G γ) (modeCoef5 B G (pchAmp5 B W) γ n)) x := by
    intro W αW hW γ n
    refine modeF5_differentiable_v5 B.h 0 t Y0 _ _ x hok.1 hc'.2.1 hc'.1 ?_
    rw [hζx]
    exact (pch5_tr_phase B G hok hG (qsOf l0) αW W hqsB hW γ n 0 ξ hξD).1
  have hF0d : DifferentiableAt ℝ (modeF5 B.h 0 t Y0 0 (pchMnC5 Mn)) x :=
    modeF5_differentiable_v5 B.h 0 t Y0 0 _ x hok.1 hc'.2.1 hc'.1 hMnCd'
  have hF0 : ∀ y, modeF5 B.h 0 t Y0 0 (pchMnC5 Mn) y = cyl2cart y (Mn (ptOf y t (Yph B.h (rad y) t + Y0))) := by
    intro y
    simp [modeF5, pchMnC5]

  obtain ⟨OP, ΓP, hOPo, hxOP, hOPc, hΓP, hexpP⟩ := pch5_local_modes B G l0 P α HP hok hP hHP' x t Y0 hc
  obtain ⟨OQ, ΓQ, hOQo, hxOQ, hOQc, hΓQ, hexpQ⟩ := pch5_local_modes B G l0 Q β HQ hok hQ hHQ' x t Y0 hc
  obtain ⟨Γ, hΓ⟩ : ∃ Γ : Finset Lab, Γ = ΓP ∪ ΓQ := ⟨_, rfl⟩
  have hPΓ : ΓP ⊆ Γ := by rw [hΓ]; exact Finset.subset_union_left
  have hQΓ : ΓQ ⊆ Γ := by rw [hΓ]; exact Finset.subset_union_right
  have hON : OP ∩ OQ ∈ nhds x := (hOPo.inter hOQo).mem_nhds ⟨hxOP, hxOQ⟩
  have hVslice : (fun y => evOff B.h V Y0 y t) =ᶠ[nhds x] fun y => ∑ γ ∈ Γ, ∑ n ∈ HQ,
      modeF5 B.h 0 t Y0 (n * pint5 B G γ) (modeCoef5 B G (pchAmp5 B Q) γ n) y := by
    filter_upwards [hON] with y hy
    rw [hV Y0 y t (hOQc y hy.2), hexpQ Γ hQΓ y hy.2]
  have hUslice : (fun y => evOff B.h U Y0 y t) =ᶠ[nhds x] fun y => modeF5 B.h 0 t Y0 0 (pchMnC5 Mn) y +
      ∑ γ ∈ Γ, ∑ m ∈ HP, modeF5 B.h 0 t Y0 (m * pint5 B G γ) (modeCoef5 B G (pchAmp5 B P) γ m) y := by
    filter_upwards [hON] with y hy
    rw [hU Y0 y t (hOPc y hy.1), ← hexpP Γ hPΓ y hy.1, hF0, hcadd]

  have hDV : fderiv ℝ (fun y => evOff B.h V Y0 y t) x = ∑ γ ∈ Γ, ∑ n ∈ HQ,
      fderiv ℝ (modeF5 B.h 0 t Y0 (n * pint5 B G γ) (modeCoef5 B G (pchAmp5 B Q) γ n)) x := by
    rw [hVslice.fderiv_eq, fderiv_fun_sum (fun γ _ => DifferentiableAt.fun_sum (fun n _ => hcd Q β hQ γ n))]
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    exact fderiv_fun_sum (fun n _ => hcd Q β hQ γ n)
  have hDU : fderiv ℝ (fun y => evOff B.h U Y0 y t) x = fderiv ℝ (modeF5 B.h 0 t Y0 0 (pchMnC5 Mn)) x +
      ∑ γ ∈ Γ, ∑ m ∈ HP, fderiv ℝ (modeF5 B.h 0 t Y0 (m * pint5 B G γ) (modeCoef5 B G (pchAmp5 B P) γ m)) x := by
    rw [hUslice.fderiv_eq, fderiv_fun_add hF0d
      (DifferentiableAt.fun_sum (fun γ _ => DifferentiableAt.fun_sum (fun m _ => hcd P α hP γ m))),
      fderiv_fun_sum (fun γ _ => DifferentiableAt.fun_sum (fun m _ => hcd P α hP γ m))]
    congr 1
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    exact fderiv_fun_sum (fun m _ => hcd P α hP γ m)

  have hΓPz : ∀ γ m, γ ∉ Γ → P γ m ξ = 0 := by
    intro γ m hγ
    have h := hΓP γ (fun h => hγ (hPΓ h)) m
    rw [hζx] at h
    exact h.eq_of_nhds
  have hΓQz : ∀ γ m, γ ∉ Γ → Q γ m ξ = 0 := by
    intro γ m hγ
    have h := hΓQ γ (fun h => hγ (hQΓ h)) m
    rw [hζx] at h
    exact h.eq_of_nhds
  have hwv : ∀ (W : WC) (H : Finset ℤ), (∀ γ m, γ ∉ Γ → W γ m ξ = 0) → (∀ γ m, m ∉ H → W γ m = 0) →
      ∀ j, qC B.h ξ ^ (-Aex B.h) * waveV5 B G W (thetaOf x) ξ j =
        (∑ γ ∈ Γ, ∑ m ∈ H, pchAmp5 B W γ m ξ j * ephase5 B G γ m (thetaOf x) ξ).re := by
    intro W H hWΓ hWH j
    rw [hfs W (thetaOf x) ξ Γ H hWΓ (fun γ m hm => by rw [hWH γ m hm]; rfl) j, ← Complex.re_ofReal_mul,
      Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    simp only [pchAmp5, Pi.smul_apply, smul_eq_mul]
    ring
  obtain ⟨αU, hαUdef⟩ : ∃ v : Fin 3 → ℝ, v = fun a => Mn ξ a + qC B.h ξ ^ (-Aex B.h) * waveV5 B G P (thetaOf x) ξ a :=
    ⟨_, rfl⟩
  obtain ⟨αV, hαVdef⟩ : ∃ v : Fin 3 → ℝ, v = fun a => qC B.h ξ ^ (-Aex B.h) * waveV5 B G Q (thetaOf x) ξ a :=
    ⟨_, rfl⟩
  have hUx : evOff B.h U Y0 x t = cyl2cart x αU := by rw [hU Y0 x t hc, hζx, hαUdef]
  have hVx : evOff B.h V Y0 x t = cyl2cart x αV := by rw [hV Y0 x t hc, hζx, hαVdef]
  have hαU : (fun a => ((αU a : ℝ) : ℂ)) = fun j => ((Mn ξ j +
      (∑ γ ∈ Γ, ∑ m ∈ HP, pchAmp5 B P γ m ξ j * ephase5 B G γ m (thetaOf x) ξ).re : ℝ) : ℂ) := by
    funext j
    simp only [hαUdef]
    rw [hwv P HP hΓPz hHP' j]
  have hαV : (fun a => ((αV a : ℝ) : ℂ)) = fun j => (((0 : Fin 3 → ℝ) j +
      (∑ γ ∈ Γ, ∑ m ∈ HQ, pchAmp5 B Q γ m ξ j * ephase5 B G γ m (thetaOf x) ξ).re : ℝ) : ℂ) := by
    funext j
    simp only [hαVdef]
    rw [hwv Q HQ hΓQz hHQ' j, Pi.zero_apply, zero_add]
  have hαV0 : (fun a => ((αV a : ℝ) : ℂ)) = fun j =>
      (((∑ γ ∈ Γ, ∑ m ∈ HQ, pchAmp5 B Q γ m ξ j * ephase5 B G γ m (thetaOf x) ξ).re : ℝ) : ℂ) := by
    funext j
    simp only [hαVdef]
    rw [hwv Q HQ hΓQz hHQ' j]

  obtain ⟨Vint, hVint⟩ : ∃ W : WC, W = fun γ k => if Even k then P γ (k / 2) else Q γ (k / 2) := ⟨_, rfl⟩
  have hVP : ∀ γ m, Vint γ (2 * m) = P γ m := by
    intro γ m
    have e1 : Even (2 * m) := even_two_mul m
    have e2 : 2 * m / 2 = m := by omega
    rw [hVint]
    simp only [e1, ↓reduceIte, e2]
  have hVQ : ∀ γ n, Vint γ (2 * n + 1) = Q γ n := by
    intro γ n
    have o1 : ¬ Even (2 * n + 1) := by
      rintro ⟨k, hk⟩
      omega
    have o2 : (2 * n + 1) / 2 = n := by omega
    rw [hVint]
    simp only [o1, ↓reduceIte, o2]
  have hVc : ∀ γ m, ContinuousOn (Vint γ m) (DomC B.h (qsOf l0)) := by
    intro γ k
    rw [hVint]
    dsimp only
    split_ifs
    · exact (hP.2.1 γ _).continuousOn
    · exact (hQ.2.1 γ _).continuousOn
  have hVs : ∀ γ m η, η ∈ DomC B.h (qsOf l0) → Vint γ m η ≠ 0 → SuppW B G γ η := by
    intro γ k η hη hne
    rw [hVint] at hne
    dsimp only at hne
    split_ifs at hne
    · exact hP.2.2.2.1 γ _ η hη hne
    · exact hQ.2.2.2.1 γ _ η hη hne
  have hsep := hLD l0 (by omega) Vint hVc hVs
  have hsepUV : ∀ (γ γ' : Lab) (m n : ℤ), γ ≠ γ' → pchAmp5 B P γ' m ξ ≠ 0 →
      pchAmp5 B Q γ n =ᶠ[nhds ξ] 0 := by
    intro γ γ' m n hne hA
    have hP0 : P γ' m ξ ≠ 0 := fun h => hA (by simp [pchAmp5, h])
    have h1 := hsep γ' γ (2 * m) (2 * n + 1) (Ne.symm hne) ξ hξD (by rw [hVP]; exact hP0)
    rw [hVQ] at h1
    filter_upwards [notMem_tsupport_iff_eventuallyEq.mp h1] with η hη
    simp [pchAmp5, hη]
  have hsepVU : ∀ (γ γ' : Lab) (m n : ℤ), γ ≠ γ' → pchAmp5 B Q γ' m ξ ≠ 0 →
      pchAmp5 B P γ n =ᶠ[nhds ξ] 0 := by
    intro γ γ' m n hne hA
    have hQ0 : Q γ' m ξ ≠ 0 := fun h => hA (by simp [pchAmp5, h])
    have h1 := hsep γ' γ (2 * m + 1) (2 * n) (Ne.symm hne) ξ hξD (by rw [hVQ]; exact hQ0)
    rw [hVP] at h1
    filter_upwards [notMem_tsupport_iff_eventuallyEq.mp h1] with η hη
    simp [pchAmp5, hη]

  obtain ⟨HN, hHN⟩ : ∃ HN : Finset ℤ, HN = HQ ∪ HP ∪ (HQ ×ˢ HP).image (fun p => p.1 + p.2) ∪
      (HQ ×ˢ HP).image (fun p => p.1 - p.2) ∪ (HP ×ˢ HQ).image (fun p => p.1 - p.2) := ⟨_, rfl⟩
  have hN1 : ∀ n ∈ HQ, n ∈ HN := by
    intro n hn; rw [hHN]
    exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
      (Finset.mem_union_left _ hn)))
  have hN2 : ∀ n ∈ HP, n ∈ HN := by
    intro n hn; rw [hHN]
    exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
      (Finset.mem_union_right _ hn)))
  have hcl1 : ∀ n ∈ HQ, ∀ m ∈ HP, n + m ∈ HN ∧ n - m ∈ HN := by
    intro n hn m hm
    rw [hHN]
    exact ⟨Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_image.2 ⟨(n, m), Finset.mem_product.2 ⟨hn, hm⟩, rfl⟩))),
      Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_image.2 ⟨(n, m), Finset.mem_product.2 ⟨hn, hm⟩, rfl⟩))⟩
  have hcl2 : ∀ n ∈ HP, ∀ m ∈ HQ, n + m ∈ HN ∧ n - m ∈ HN := by
    intro n hn m hm
    rw [hHN]
    exact ⟨Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_image.2 ⟨(m, n), Finset.mem_product.2 ⟨hm, hn⟩, add_comm m n⟩))),
      Finset.mem_union_right _
        (Finset.mem_image.2 ⟨(n, m), Finset.mem_product.2 ⟨hn, hm⟩, rfl⟩)⟩
  have hAzP : ∀ γ m, m ∉ HP → pchAmp5 B P γ m ξ = 0 := by
    intro γ m hm; simp [pchAmp5, hHP γ m hm]
  have hAzQ : ∀ γ m, m ∉ HQ → pchAmp5 B Q γ m ξ = 0 := by
    intro γ m hm; simp [pchAmp5, hHQ γ m hm]
  have hBzP : ∀ γ n, n ∉ HP → pchAmp5 B P γ n =ᶠ[nhds ξ] 0 := by
    intro γ n hn
    exact Filter.Eventually.of_forall (fun η => by simp [pchAmp5, hHP γ n hn])
  have hBzQ : ∀ γ n, n ∉ HQ → pchAmp5 B Q γ n =ᶠ[nhds ξ] 0 := by
    intro γ n hn
    exact Filter.Eventually.of_forall (fun η => by simp [pchAmp5, hHQ γ n hn])

  obtain ⟨Lc, hLc⟩ : ∃ Lc : (Fin 3 → ℝ) →+ ℝ³, ∀ u, Lc u = cyl2cart x u :=
    ⟨{ toFun := cyl2cart x
       map_zero' := by simp [cyl2cart]
       map_add' := fun u v => by simp only [cyl2cart, Pi.add_apply, add_smul]; abel },
      fun u => rfl⟩
  have hcoll : ∀ (H : Finset ℤ) (f : Lab → ℤ → Fin 3 → ℂ),
      ∑ γ ∈ Γ, ∑ n ∈ H, cyl2cart x (fun i => (f γ n i).re) =
        cyl2cart x (fun i => (∑ γ ∈ Γ, ∑ n ∈ H, f γ n i).re) := by
    intro H f
    simp only [← hLc, ← map_sum]
    congr 1
    funext i
    simp only [Finset.sum_apply, Complex.re_sum]

  have hUV : pwrTr B.h U V x t Y = cyl2cart x (fun i => (∑ γ ∈ Γ, ∑ N ∈ HN,
      (pchTr5 B G γ N (fun j => ((Mn ξ j : ℝ) : ℂ)) (pchAmp5 B Q γ N) ξ i +
        pchPair5 B G (pchAmp5 B P) (pchAmp5 B Q) N γ ξ i) * ephase5 B G γ N (thetaOf x) ξ).re) := by
    have e0 : pwrTr B.h U V x t Y = fderiv ℝ (fun y => evOff B.h V Y0 y t) x (evOff B.h U Y0 x t) := by
      rw [hY0]; rfl
    rw [e0, hDV, hUx]
    simp only [ContinuousLinearMap.sum_apply, hTr Q β hQ]
    rw [hcoll HQ (fun γ n i => pchTr5 B G γ n (fun a => ((αU a : ℝ) : ℂ)) (pchAmp5 B Q γ n) ξ i *
      ephase5 B G γ n (thetaOf x) ξ), hαU]
    congr 1
    funext i
    congr 1
    exact pch5_pair_regroup B G ξ (thetaOf x) (Mn ξ) (pchAmp5 B P) (pchAmp5 B Q) Γ HP HQ HN hAzP hBzQ
      hsepUV hN1 hcl1 i

  have hVU : pwrTr B.h V U x t Y = cyl2cart x (fun i => (∑ γ ∈ Γ, ∑ N ∈ HN,
      pchTr5 B G γ 0 (pchAmp5 B Q γ N ξ) (pchMnC5 Mn) ξ i * ephase5 B G γ N (thetaOf x) ξ).re) +
      cyl2cart x (fun i => (∑ γ ∈ Γ, ∑ N ∈ HN,
      (pchTr5 B G γ N (fun j => (((0 : Fin 3 → ℝ) j : ℝ) : ℂ)) (pchAmp5 B P γ N) ξ i +
        pchPair5 B G (pchAmp5 B Q) (pchAmp5 B P) N γ ξ i) * ephase5 B G γ N (thetaOf x) ξ).re) := by
    have e0 : pwrTr B.h V U x t Y = fderiv ℝ (fun y => evOff B.h U Y0 y t) x (evOff B.h V Y0 x t) := by
      rw [hY0]; rfl
    rw [e0, hDU, hVx, ContinuousLinearMap.add_apply]
    congr 1
    · rw [hjet 0 (pchMnC5 Mn) αV hMnCd']
      congr 1
      funext i
      simp only [Int.cast_zero, mul_zero, zero_mul, Complex.exp_zero, mul_one]
      rw [hαV0, pch5_mean_regroup B G Mn (pchAmp5 B Q) ξ (thetaOf x) Γ HQ hMnd i]
      congr 1
      refine Finset.sum_congr rfl (fun γ _ => Finset.sum_subset (fun n hn => hN1 n hn) (fun n _ hn => ?_))
      rw [hAzQ γ n hn, hTr0]
      simp
    · simp only [ContinuousLinearMap.sum_apply, hTr P α hP]
      rw [hcoll HP (fun γ n i => pchTr5 B G γ n (fun a => ((αV a : ℝ) : ℂ)) (pchAmp5 B P γ n) ξ i *
        ephase5 B G γ n (thetaOf x) ξ), hαV]
      congr 1
      funext i
      congr 1
      exact pch5_pair_regroup B G ξ (thetaOf x) 0 (pchAmp5 B Q) (pchAmp5 B P) Γ HQ HP HN hAzQ hBzP
        hsepVU hN2 hcl2 i

  have hΓPQ : ∀ γ, γ ∉ Γ → ∀ m, P γ m =ᶠ[nhds ξ] 0 ∧ Q γ m =ᶠ[nhds ξ] 0 := by
    intro γ hγ m
    have h1 := hΓP γ (fun h => hγ (hPΓ h)) m
    have h2 := hΓQ γ (fun h => hγ (hQΓ h)) m
    rw [hζx] at h1 h2
    exact ⟨h1, h2⟩
  have h6 := pch5_har_assemble B G Mn P Q ξ (thetaOf x) Γ HP HQ HN hq hHP' hHQ' hΓPQ hN1 hcl1 hcl2
  have hRHS : (fun a => qC B.h ξ ^ (-(2 * Aex B.h + 1/2)) * waveV5 B G (pchG5 B G Mn P Q) (thetaOf x) ξ a +
      pchZ5 B G Mn P Q ξ a) = fun i =>
      (∑ γ ∈ Γ, ∑ N ∈ HN, pchHar5 B G Mn P Q γ N ξ i * ephase5 B G γ N (thetaOf x) ξ).re :=
    funext fun i => (h6 i).symm
  have hz0 : ∀ (γ : Lab) (N : ℤ), pchTr5 B G γ N (fun j => (((0 : Fin 3 → ℝ) j : ℝ) : ℂ)) (pchAmp5 B P γ N) ξ = 0 := by
    intro γ N
    funext i
    fin_cases i <;> simp [pchTr5]
  rw [← hξ]
  refine Eq.trans ?_ (congrArg (cyl2cart x) hRHS.symm)
  rw [hUV, hVU, hcadd, hcadd]
  congr 1
  funext i
  beta_reduce
  simp only [← Complex.add_re, ← Finset.sum_add_distrib]
  congr 1
