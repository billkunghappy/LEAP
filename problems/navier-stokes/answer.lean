  have hlogPF : Real.log (axProfF h Λ t1 κ0 om Fn Un X e) = Real.log (Fn (4 / Λ) e) +
      -(1 / 2) * ∫ z in (0:ℝ)..axLogY Λ X, axShearA h Λ t1 κ0 om Fn Un z e := by
    rw [hPF, Real.log_mul hF4.ne' (Real.exp_pos _).ne', Real.log_exp]
