    funext j
    fin_cases j <;> simp [velW5, velC5, DrC, DzC, dR, dZ, hD] <;> ring
  refine ⟨fun c β hc hv => ?_, fun c d β1 β2 hc hd γ m ξ hξ => ?_⟩
  · have T1 := hRS β 0 (velW5 B G c)
      (fun γ _ η => (Real.sqrt (Qb γ.1))⁻¹ * Real.sqrt (qC B.h η)) hv
      (fun γ m ξ hξ _ => contDiffAt_const.mul (hM.1 ξ hξ).1)
      (fun γ m ξ hξ _ c' _ => rfl)
      (fun k => by
        obtain ⟨C, hC⟩ := hM.2 k
        refine ⟨2 * |C|, 0, fun γ m ξ hξ ht hX1 hX2 => ?_⟩
        have hqQ := (hpsg l0 hl0 β (velW5 B G c) hv γ m ξ hξ ht).2.2.2.2.1
        have hsq : (Real.sqrt (Qb γ.1))⁻¹ * Real.sqrt (qC B.h ξ) ≤ 2 := by
