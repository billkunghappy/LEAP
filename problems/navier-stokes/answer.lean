  have hsig : ContDiff ℝ ∞ sigA := sigA_collar_facts.1
  have sig01 : ∀ y, 0 ≤ sigA y ∧ sigA y ≤ 1 := by
    intro y
    unfold sigA
    split_ifs with h1 h2
    · norm_num
    · norm_num
    · have ha := Real.exp_pos (-1 / y ^ 2)
      have hb := Real.exp_pos (-1 / (1 - y) ^ 2)
      exact ⟨div_nonneg ha.le (by linarith), (div_le_one (by linarith)).mpr (by linarith)⟩
  have hEaF : ∀ X : ℝ, 0 < X → axEa Λ t1 κ0 X = (1 - κ0) * sigA (Real.log (X * Λ / 4) / t1) := by
    intro X hX
    unfold axEa axLogY
    split_ifs with hc
    · have hXΛ : 0 < X * Λ := mul_pos hX hΛ0
      have h1 : X * Λ / 4 ≤ 1 := by
