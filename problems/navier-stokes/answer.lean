  have hVo : IsOpen {a : ℝ × ℝ × ℝ | sgc5ch B.h ξ0 a ∈ DomC B.h qs} := hΩo.preimage hchc.continuous
  have h0V : (0 : ℝ × ℝ × ℝ) ∈ {a : ℝ × ℝ × ℝ | sgc5ch B.h ξ0 a ∈ DomC B.h qs} := by
