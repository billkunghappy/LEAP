theorem ax_shear_F_outer : ∀ (h Pst : ℝ) (Pax : ℝ → ℝ) (ε Bd C T θ Kb Ks MP s1 s2 : ℝ) (β : Fin 2 → ℝ → ℝ) (γ : Fin 3 → ℝ → ℝ) (c : ℝ → Fin 5 → ℝ) (Xa Xan Xa1 Xa2 aa τ : ℝ) (ℓ G : ℝ → ℝ) (F U : ℝ → ℝ → ℝ), AxGlue h Pst Pax ε Bd C T θ Kb Ks MP s1 s2 β γ c Xa Xan Xa1 Xa2 aa τ ℓ G F U → (∀ X η : ℝ, 110 * Real.exp (1 + T) ≤ X → -1 < η → η < 1 → |axFm Pst C T ℓ F γ c X η| ≤ 201 / 200 * refFin Pst (110 * (C * Pst) ^ 10) X η ∧ |deriv (fun e => axFm Pst C T ℓ F γ c X e) η| ≤ 201 / 200 * refFin Pst (110 * (C * Pst) ^ 10) X η) ∧ (∀ X η : ℝ, 110 * (C * Pst) ^ 10 * Real.exp (-8) ≤ X → -1 < η → η < 1 → Pst / 5 ≤ Real.sqrt (2 * X) * axFm Pst C T ℓ F γ c X η) :=
by
  intro h Pst Pax ε Bd C T θ Kb Ks MP s1 s2 β γ c Xa Xan Xa1 Xa2 aa τ ℓ G F U hG
  obtain ⟨hD, hIn, hε0, hε1, hBump, hKbβ, hKbγ, hCoef, hθ0, hk, h3θ, hKs, hT, hMP, hE2, hXR, hKc⟩ := hG
  have hPst : 0 < Pst := hD.2.2.1
  have hC1 : 1 ≤ C := hIn.1.2.2.2.2.2.2.2
  have hC0 : 0 < C := by linarith
  have hCne : C ≠ 0 := hC0.ne'
  have hPne : Pst ≠ 0 := hPst.ne'
  have hKs0 : 0 ≤ Ks := le_trans (abs_nonneg _) (hKs 0)
  have hT0 : 0 < T := by
