theorem cutoff_weight_bounds : ∀ (s : ℝ → ℝ) (h : ℝ), 0 < h → h ≤ 1 / 2 → (∀ y : ℝ, 0 ≤ s y ∧ s y ≤ 1) → 0 ≤ (∫ u in Real.exp (-2)..1, u ^ (-h) * (1 - s ((Real.log u + 2) / 2))) ∧ (∫ u in Real.exp (-2)..1, u ^ (-h) * (1 - s ((Real.log u + 2) / 2))) ≤ 3 :=
by
  intro s h h0 h1 hs
