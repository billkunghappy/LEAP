    rw [hf.deriv, ← this]

  have G2 : ∀ (c : ℕ → ℂ → ℂ) (s B : ℝ) (y w0 : ℂ), 0 ≤ B → ‖y‖ < 5 →
      (∀ n, DifferentiableOn ℂ (c n) (axRect s)) →
      (∀ n, ∀ w ∈ axRect s, ‖c n w‖ ≤ B * (1 / 10) ^ n) → w0 ∈ axRect s →
      HasDerivAt (fun w => ∑' n : ℕ, c n w * y ^ n) (∑' n : ℕ, deriv (c n) w0 * y ^ n) w0 := by
    intro c s B y w0 hB hy hd hb hw0
    have hU : IsOpen (axRect s) := hRopen s
    have hu : Summable (fun n : ℕ => B * (1 / 2 : ℝ) ^ n) := summable_geometric_two.mul_left B
    have hFb : ∀ n, ∀ w ∈ axRect s, ‖c n w * y ^ n‖ ≤ B * (1 / 2) ^ n := by
      intro n w hw
      rw [norm_mul, norm_pow]
