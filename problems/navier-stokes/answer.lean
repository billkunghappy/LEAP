    have t3 : 0 ≤ (m : ℝ) ^ 2 * (AKc * SC B.h ξ ^ 2) :=
      mul_nonneg (sq_nonneg _) (mul_nonneg hAK0 (sq_nonneg _))
    have hfin : AKc * SC B.h ξ + |μ| * (ADc * SC B.h ξ ^ 2) ≤
        (1 + (m : ℝ) ^ 2) * (AKc + ADc) * SC B.h ξ ^ 2 := by
