  have hab' := abs_le.mp hab
  have ha : (43 : ℝ) / 200 ≤ a := by linarith [hab'.1]
  have ha0 : 0 < a := by linarith
  have hb0 : 0 < b := by linarith
  have hprod : (2279 : ℝ) / 40000 ≤ a * b := by nlinarith
  have hab0 : 0 < a * b := by positivity
  have hid : p / a - p0 / b = (p - p0) / a + p0 * (b - a) / (a * b) := by
    field_simp
    ring
  have h1 : |(p - p0) / a| ≤ 5 * |p - p0| := by
    rw [abs_div, abs_of_pos ha0, div_le_iff₀ ha0]
    nlinarith [abs_nonneg (p - p0)]
