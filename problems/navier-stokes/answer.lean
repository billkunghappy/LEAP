def NormFam (h lam Pst ρ cp ci xg xg2 r1 r2 p1 p2 m1 m2 xv xb e1 eps μ : ℝ) (c ϑ : ℝ → ℝ)
    (Fh Uh : ℝ → ℝ → ℝ → ℝ) : Prop :=
  (0 < h ∧ h < 1 / 100 ∧ 0 < lam ∧ 0 < e1 ∧ e1 ≤ 1 ∧ 0 < μ ∧ μ ≤ 1 ∧ 0 < cp ∧ 0 < ci ∧
    0 < ρ ∧ ρ < 1 ∧ 1 < xg ∧ xg < xg2 ∧ xg2 < r1 ∧ r1 < r2 ∧ r2 < p1 ∧ p1 < p2 ∧ p2 < m1 ∧
    m1 < m2 ∧ m2 < xv ∧ xv < xb * Real.exp (-(11 / 4))) ∧
  ∀ e : ℝ, 0 < e → e ≤ e1 →
    NormBase h lam Pst cp xg xg2 r1 r2 p1 p2 m1 m2 xv xb eps μ c ϑ (Fh e) (Uh e) ∧
    (∀ x η : ℝ, xb * Real.exp (-(11 / 4)) ≤ x → -1 < η → η < 1 →
       Real.sqrt (2 * x) * Fh e x η =
         ci * x ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - η ^ 2) * e / x) * tailFac ρ xb x) ∧
