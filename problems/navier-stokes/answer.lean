theorem slow_deriv_struct_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (α : ℝ) (a : WC) (e : Cyl → Cyl), InWg5 B G (qsOf l0) α a → ContDiffOn ℝ ∞ e {η : Cyl | 0 < η.1} → (∀ (ξ : Cyl) (c : ℝ × ℝ), e (shY ξ c) = e ξ) → (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → ∀ (ξ : Cyl) (i : Fin 3), fderiv ℝ (fun η => a γ m η i) ξ (e ξ) = 0) ∧ (∀ γ m, ContDiffOn ℝ ∞ (fun ξ i => fderiv ℝ (fun η => a γ m η i) ξ (e ξ)) (DomC B.h (qsOf l0))) ∧ (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ∀ c, IsDeck B.h (qC B.h ξ) c → (fun i => fderiv ℝ (fun η => a γ m η i) (shY ξ c) (e (shY ξ c))) = (fun i => fderiv ℝ (fun η => a γ m η i) ξ (e ξ))) ∧ (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → (fun i => fderiv ℝ (fun η => a γ m η i) ξ (e ξ)) ≠ 0 → SuppW B G γ ξ) :=
