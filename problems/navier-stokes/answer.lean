  obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, ∑ i ∈ Finset.range (m + 3 + 1), (|K i| + |ℓ i|) = κ := ⟨_, rfl⟩
  have hκ0 : 0 ≤ κ := by
