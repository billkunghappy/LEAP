          primOp5 B G (fun γ' m' η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • ampD5 B G γ' m' η)) γ m :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => hsplit γ m η hη)
    have hb := hC γ m ξ hξ hX1 hX2
    unfold NB at hb ⊢
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
