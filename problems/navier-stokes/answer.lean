    exact (hpre (s * X) e (mul_le_of_le_one_left hXpos.le hs.2)).2
  have hm1 := hint (fun x e => 2 * x * Fn x e) (fun x e => 2 * x * axRefF Λ t1 Fn x e)
    (fun x e hx => by simp only [(hpre x e hx).1])
  have hm2 := hint (fun x e => Un x e * (2 * x * Fn x e))
    (fun x e => axRefU Λ t1 Un x e * (2 * x * axRefF Λ t1 Fn x e))
    (fun x e hx => by simp only [(hpre x e hx).1, (hpre x e hx).2])
  have hm3 := hint Un (axRefU Λ t1 Un) (fun x e hx => (hpre x e hx).2)
  have hm4 := hint (fun x e => Un x e ^ 2 - x * Fn x e ^ 2)
    (fun x e => axRefU Λ t1 Un x e ^ 2 - x * axRefF Λ t1 Fn x e ^ 2)
    (fun x e hx => by simp only [(hpre x e hx).1, (hpre x e hx).2])
  have hm5 := hint (fun x e => Fn x e ^ 2) (fun x e => axRefF Λ t1 Fn x e ^ 2)
    (fun x e hx => by simp only [(hpre x e hx).1])
  have hFX := (hpre X η le_rfl).1
  have hUX := (hpre X η le_rfl).2
  have hQs : leadQs h (axRefF Λ t1 Fn) (axRefU Λ t1 Un) X η = leadQs h Fn Un X η := by
    simp only [leadQs, leadW, profEtaD]
    rw [hm1, hm2, havg, hFX]
  have hNs : axNs h Pax (axRefF Λ t1 Fn) (axRefU Λ t1 Un) X η = axNs h Pax Fn Un X η := by
    simp only [axNs, leadW, axPi, profEtaD]
    rw [hm3, hm4, hm5, havg, hUX]
  have hP1 : psLead1 h (axRefF Λ t1 Fn) (axRefU Λ t1 Un) X η = psLead1 h Fn Un X η := by
    unfold psLead1; rw [hQs]

  have hf : 0 < Fn X η := hA.2.2.1 X η hXpos.le hXle (by linarith) (by linarith)
  have hst := hA.2.2.2.1 X η hXpos hXle hη1 hη2
  have hP1n : psLead1 h Fn Un X η = shearA Fn X η := by
    have h1 := hst.1
    unfold leadStressTh at h1
