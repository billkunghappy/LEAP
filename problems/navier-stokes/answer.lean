  intro W hW0 hW i hi
  have hD0 : 0 ≤ max 1 D := le_trans zero_le_one (le_max_left _ _)
  have hQ0 : 0 ≤ qC B.h ξ0 ^ (B.h * α) := Real.rpow_nonneg hq0.le _
  have hS0 : 0 ≤ SC B.h ξ0 ^ b := Real.rpow_nonneg (by unfold SC; positivity) _
  have hCQ : 0 ≤ C0 * qC B.h ξ0 ^ (B.h * α) * SC B.h ξ0 ^ b := mul_nonneg (mul_nonneg hC0 hQ0) hS0
  have hM0 : 0 ≤ max 1 D ^ (k + e) * C0 * qC B.h ξ0 ^ (B.h * α) * SC B.h ξ0 ^ b * W :=
    mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (pow_nonneg hD0 _) hC0) hQ0) hS0) hW0
  have hpt : ∀ u ∈ Icc c c', ‖iteratedFDeriv ℝ i (fun x' => G x' u) 0‖ ≤
      max 1 D ^ (k + e) * C0 * qC B.h ξ0 ^ (B.h * α) * SC B.h ξ0 ^ b * W := by
    intro u hu
