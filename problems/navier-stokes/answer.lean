      exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ h0 h3 2) (Real.exp_pos _).le
    rw [hFTC] at hmono
    have e1 : -(2 * (1 / 50 : ℝ)) + 1 ≤ Real.exp (-(2 * (1 / 50 : ℝ))) := Real.add_one_le_exp _
    have e2 : Real.exp (-(2 * (10:ℝ))) ≤ 1 / (4 * 10 ^ 8) := by
