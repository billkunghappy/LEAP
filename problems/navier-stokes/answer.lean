      inter_subset_left
      (fun z _ => rfl)
      (by
        rintro ⟨X, η⟩ ⟨-, ⟨hX, hη⟩⟩
        exact (hEQ X η (mem_Ioi.mp hX) hη.1 hη.2).2.2.2)

  have hW1 : ∀ X : ℝ, Xa < X → X ≤ Xa2 → 0 < edgeWeight Xa Xb aa ab X ∧
      edgeWeight Xa Xb aa ab X ≤ Real.exp (-(aa / Real.log (X / Xa) ^ 2)) ∧
      Real.exp (-(aa / Real.log (X / Xa) ^ 2)) ≤
        Real.exp (ab / Real.log (Xb / Xa2) ^ 2) * edgeWeight Xa Xb aa ab X ∧
      0 < edgeDist Xa Xb X ∧ edgeDist Xa Xb X ≤ min 1 (Real.log (X / Xa)) := by
    intro X hX1 hX2
    have hXpos : 0 < X := lt_trans hXa hX1
    have hXb : X < Xb := by linarith
    have hL1 : 0 < Real.log (X / Xa) := Real.log_pos ((one_lt_div hXa).mpr hX1)
    have hL2 : 0 < Real.log (Xb / X) := Real.log_pos ((one_lt_div hXpos).mpr hXb)
    have hM : 0 < Real.log (Xb / Xa2) := Real.log_pos ((one_lt_div (by linarith)).mpr (by linarith))
    have hML : Real.log (Xb / Xa2) ≤ Real.log (Xb / X) :=
      Real.log_le_log (div_pos (by linarith) (by linarith))
        (div_le_div_of_nonneg_left (by linarith) hXpos hX2)
    have hM2 : Real.log (Xb / Xa2) ^ 2 ≤ Real.log (Xb / X) ^ 2 := pow_le_pow_left₀ hM.le hML 2
    have hdiv : ab / Real.log (Xb / X) ^ 2 ≤ ab / Real.log (Xb / Xa2) ^ 2 :=
      div_le_div_of_nonneg_left hab.le (by positivity) hM2
    have hnn : 0 ≤ ab / Real.log (Xb / X) ^ 2 := by positivity
    have hEW : edgeWeight Xa Xb aa ab X =
        Real.exp (-(aa / Real.log (X / Xa) ^ 2) - ab / Real.log (Xb / X) ^ 2) := by
      unfold edgeWeight; rw [if_pos ⟨hX1, hXb⟩]
    rw [hEW]
    refine ⟨Real.exp_pos _, Real.exp_le_exp.mpr (by linarith), ?_, ?_, ?_⟩
    · rw [← Real.exp_add]; exact Real.exp_le_exp.mpr (by linarith)
    · unfold edgeDist; exact lt_min one_pos (lt_min hL1 hL2)
    · unfold edgeDist; exact min_le_min le_rfl (min_le_left _ _)
  have hW2 : ∀ X : ℝ, Xg ≤ X → X < Xb → 0 < edgeWeight Xa Xb aa ab X ∧
      edgeWeight Xa Xb aa ab X ≤ Real.exp (-(ab / Real.log (Xb / X) ^ 2)) ∧
      Real.exp (-(ab / Real.log (Xb / X) ^ 2)) ≤
        Real.exp (aa / Real.log (Xg / Xa) ^ 2) * edgeWeight Xa Xb aa ab X ∧
      0 < edgeDist Xa Xb X ∧ edgeDist Xa Xb X ≤ min 1 (Real.log (Xb / X)) := by
    intro X hX1 hX2
    have hXa' : Xa < X := by linarith
    have hXpos : 0 < X := lt_trans hXa hXa'
    have hL1 : 0 < Real.log (X / Xa) := Real.log_pos ((one_lt_div hXa).mpr hXa')
    have hL2 : 0 < Real.log (Xb / X) := Real.log_pos ((one_lt_div hXpos).mpr hX2)
    have hM : 0 < Real.log (Xg / Xa) := Real.log_pos ((one_lt_div hXa).mpr (by linarith))
    have hML : Real.log (Xg / Xa) ≤ Real.log (X / Xa) :=
      Real.log_le_log (div_pos (by linarith) hXa) (div_le_div_of_nonneg_right hX1 hXa.le)
    have hM2 : Real.log (Xg / Xa) ^ 2 ≤ Real.log (X / Xa) ^ 2 := pow_le_pow_left₀ hM.le hML 2
    have hdiv : aa / Real.log (X / Xa) ^ 2 ≤ aa / Real.log (Xg / Xa) ^ 2 :=
      div_le_div_of_nonneg_left haa.le (by positivity) hM2
    have hnn : 0 ≤ aa / Real.log (X / Xa) ^ 2 := by positivity
    have hEW : edgeWeight Xa Xb aa ab X =
        Real.exp (-(aa / Real.log (X / Xa) ^ 2) - ab / Real.log (Xb / X) ^ 2) := by
      unfold edgeWeight; rw [if_pos ⟨hXa', hX2⟩]
    rw [hEW]
    refine ⟨Real.exp_pos _, Real.exp_le_exp.mpr (by linarith), ?_, ?_, ?_⟩
    · rw [← Real.exp_add]; exact Real.exp_le_exp.mpr (by linarith)
    · unfold edgeDist; exact lt_min one_pos (lt_min hL1 hL2)
    · unfold edgeDist; exact min_le_min le_rfl (min_le_right _ _)
  unfold JoinProf
  refine ⟨?J0, ?J1, ?J2, ?J3, ?J4, ?J5, ?J6, ?J7, ?J8, ?J9, ?J10, ?J11, ?J12, ?J13⟩
  case J0 =>
    exact ⟨hh0, hh1, hlam, hci, hcp, haa, hab, hXa, by linarith, hp12, hp2m1, hm12, hm2v, hvc, hcb,
      hXan, hXan1, hXa12, by linarith, hgg2, hg2r1, hr12, hr2p1⟩
  case J1 =>
    intro X η hX1 hX2 h1 h2
    have hX : XR ≤ X := by linarith
    rw [hFout X η hX, hUout X η hX]
    exact hO3 X η (Or.inl ⟨hX1, hX2⟩) h1 h2
  case J2 =>
    refine ⟨?_, hThS, hTzS⟩
    intro X η hX0 hX h1 h2
    rcases hX with hX | hX
    · exact hA5z X η hX0 hX h1 h2
    · have e := hEQ X η (by linarith) h1 h2
      rw [e.2.2.1, e.2.2.2]
      exact hO9z X η hX h1 h2
  case J3 =>
    have adm1 : AdmBlk h (edgeWeight Xa Xb aa ab) (edgeDist Xa Xb) (Ioc Xa Xa2) F U :=
      jp_adm_weight_mono h (Real.exp (ab / Real.log (Xb / Xa2) ^ 2))
        (fun X => Real.exp (-(aa / Real.log (X / Xa) ^ 2))) (edgeWeight Xa Xb aa ab)
        (fun X => min 1 (Real.log (X / Xa))) (edgeDist Xa Xb) (Ioc Xa Xa2) F U (Real.exp_pos _)
        (fun X hX => by
          obtain ⟨w1, w2, w3, w4, w5⟩ := hW1 X hX.1 hX.2
          exact ⟨w1.le, w2, w3, w4, w5, min_le_left _ _⟩)
        hA5adm
    have adm2o : AdmBlk h (fun X => Real.exp (-(ab / Real.log (Xb / X) ^ 2)))
        (fun X => min 1 (Real.log (Xb / X))) (Ico Xg Xb) F U :=
      jp_adm_congr h Xh1 _ _ (Ico Xg Xb) F U Fo Uo
        (fun X hX => mem_Ioi.mpr (by linarith [hX.1]))
        (fun X η hX h1 h2 => ⟨(hagree X η hX h1 h2).1, (hagree X η hX h1 h2).2,
          (hEQ X η hX h1 h2).2.2.1, (hEQ X η hX h1 h2).2.2.2⟩)
        hO9adm
    have adm2 : AdmBlk h (edgeWeight Xa Xb aa ab) (edgeDist Xa Xb) (Ico Xg Xb) F U :=
      jp_adm_weight_mono h (Real.exp (aa / Real.log (Xg / Xa) ^ 2))
        (fun X => Real.exp (-(ab / Real.log (Xb / X) ^ 2))) (edgeWeight Xa Xb aa ab)
        (fun X => min 1 (Real.log (Xb / X))) (edgeDist Xa Xb) (Ico Xg Xb) F U (Real.exp_pos _)
        (fun X hX => by
          obtain ⟨w1, w2, w3, w4, w5⟩ := hW2 X hX.1 hX.2
          exact ⟨w1.le, w2, w3, w4, w5, min_le_left _ _⟩)
        adm2o
    refine jp_adm_union h _ _ (Ioc Xa Xa2) (Ico Xg Xb) F U ?_ adm1 adm2
    rintro X (hX | hX)
    · obtain ⟨w1, -, -, w4, -⟩ := hW1 X hX.1 hX.2
      exact ⟨w1.le, w4, by unfold edgeDist; exact min_le_left _ _⟩
    · obtain ⟨w1, -, -, w4, -⟩ := hW2 X hX.1 hX.2
      exact ⟨w1.le, w4, by unfold edgeDist; exact min_le_left _ _⟩
  case J4 =>
    exact jp_relax_cone_glue h μ1 μ2 Xa1 (XR * Real.exp (-5)) Xh1 Xg2 F U Fo Uo hμ1 hμ2 hXh1h
      (fun X η hX h1 h2 => ⟨(hagree X η hX h1 h2).1, (hagree X η hX h1 h2).2,
        (hEQ X η hX h1 h2).1, (hEQ X η hX h1 h2).2.1⟩)
      hA5rc hO9rc
  case J5 =>
    exact fun η h1 h2 => ⟨(hJ η h1 h2).2.2.2.1, (hJ η h1 h2).2.2.1⟩
  case J6 =>
    refine ⟨hFSε.mono hsubε, hUSε.mono hsubε, ?_, ?_⟩
    · intro X η hX h1 h2
      by_cases hXR' : X < XR
      · rw [hFin X η hXR']; exact hFipos X η hX.le h1 h2
      · rw [hFout X η (not_lt.mp hXR')]; exact hFopos X η hX h1 h2
    · intro X₀ X₁ hX₀ m
      obtain ⟨C1, hC1⟩ := hFibd X₁ m
      obtain ⟨C2, hC2⟩ := hFobd X₀ X₁ hX₀ m
      refine ⟨max C1 C2, fun X η hX0 hX1 h1 h2 => ?_⟩
      by_cases hXR' : X < XR
      · rw [(hS1 m X η hXR' h1 h2).1, (hS1 m X η hXR' h1 h2).2]
        have b := hC1 X η (by linarith) hX1 h1 h2
        exact ⟨b.1.trans (le_max_left _ _), b.2.trans (le_max_left _ _)⟩
      · have hX' : Xh1 < X := lt_of_lt_of_le hXh1R (not_lt.mp hXR')
        rw [(hS2 m X η hX' h1 h2).1, (hS2 m X η hX' h1 h2).2]
        have b := hC2 X η hX0 hX1 h1 h2
        exact ⟨b.1.trans (le_max_right _ _), b.2.trans (le_max_right _ _)⟩
  case J7 =>
    refine ⟨ε, hε, hFSε, hUSε, fun η h1 h2 => ?_, ?_⟩
    · rw [hFin 0 η hXR]; exact hFipos 0 η le_rfl h1 h2
    · intro X₁ m
      obtain ⟨C1, hC1⟩ := hFibd X₁ m
      obtain ⟨C2, hC2⟩ := hFobd Xh1 X₁ hXh1pos m
      refine ⟨max C1 C2, fun X η hX0 hX1 h1 h2 => ?_⟩
      by_cases hXR' : X < XR
      · rw [(hS1 m X η hXR' h1 h2).1, (hS1 m X η hXR' h1 h2).2]
        have b := hC1 X η hX0 hX1 h1 h2
        exact ⟨b.1.trans (le_max_left _ _), b.2.trans (le_max_left _ _)⟩
      · have hX' : Xh1 < X := lt_of_lt_of_le hXh1R (not_lt.mp hXR')
        rw [(hS2 m X η hX' h1 h2).1, (hS2 m X η hX' h1 h2).2]
        have b := hC2 X η hX'.le hX1 h1 h2
        exact ⟨b.1.trans (le_max_right _ _), b.2.trans (le_max_right _ _)⟩
  case J8 =>
    obtain ⟨ρ, hρ, Fc, Uc, Pc, hk⟩ := hA3
    refine ⟨ρ, hρ, Fc, Uc, Pc, fun k => ?_⟩
    obtain ⟨C, c1, c2, c3, hX⟩ := hk k
    refine ⟨C, c1, c2, c3, fun X hX0 hXan' => ?_⟩
    obtain ⟨d1, d2, d3, hb, hval⟩ := hX X hX0 hXan'
    refine ⟨d1, d2, d3, hb, fun η e1 e2 => ?_⟩
    obtain ⟨v1, v2, v3⟩ := hval η e1 e2
    have hXR' : X < XR := by linarith
    have hevF : (fun Y => F Y η) =ᶠ[nhds X] (fun Y => Fi Y η) :=
      Filter.eventuallyEq_of_mem (isOpen_Iio.mem_nhds hXR') (fun Y hY => hFin Y η (mem_Iio.mp hY))
    have hevU : (fun Y => U Y η) =ᶠ[nhds X] (fun Y => Ui Y η) :=
      Filter.eventuallyEq_of_mem (isOpen_Iio.mem_nhds hXR') (fun Y hY => hUin Y η (mem_Iio.mp hY))
    have hcontFi : ContinuousOn (fun x => Fi x η) (Ioi (-ε)) :=
      hFiS.continuousOn.comp (Continuous.continuousOn (continuous_id.prodMk continuous_const))
        (fun x hx => (⟨hx, e1, e2⟩ : ((x, η) : ℝ × ℝ) ∈ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1))
    have hevP : (fun Y => leadPi F Y η) =ᶠ[nhds X]
        (fun Y => Pax η + profRadInt (fun x e => Fi x e ^ 2) Y η) :=
      Filter.eventuallyEq_of_mem (isOpen_Ioo.mem_nhds (⟨by linarith, hXR'⟩ : X ∈ Ioo (-ε) XR))
        (fun Y hY => by
          rw [jp_leadPi_axis_identity XR ε η F Fi hXR hε (fun X' hX' => hFin X' η hX') hcontFi
            (hJ η e1 e2).2.2.2.1 Y hY.1 hY.2, (hJ η e1 e2).2.2.2.2.1])
    refine ⟨?_, ?_, ?_⟩
    · rw [v1, (hevF.iteratedDeriv k).eq_of_nhds]
    · rw [v2, (hevU.iteratedDeriv k).eq_of_nhds]
    · rw [v3, (hevP.iteratedDeriv k).eq_of_nhds]
  case J9 =>
    intro X η hX h1 h2
    have hX' : XR ≤ X := by linarith
    rw [hFout X η hX', hUout X η hX']
    exact hO4 X η hX h1 h2
  case J10 =>
    intro X η hX h1 h2
    have hX' : XR ≤ X := by linarith
    refine ⟨?_, (hJ η h1 h2).2.2.2.2.2.2.2.2 X hX⟩
    rw [hUout X η hX']
    exact (hO5 X η hX h1 h2).1
  case J11 =>
    intro X η hX h1 h2
    have hX' : XR ≤ X := by
      rcases hX with ⟨a, _⟩ | ⟨a, _⟩ <;> linarith
    rw [hFout X η hX', hUout X η hX']
    exact hO3 X η (Or.inr hX) h1 h2
  case J12 =>
    exact fun η h1 h2 => ⟨(hJ η h1 h2).2.2.2.2.2.1, (hJ η h1 h2).2.2.2.2.2.2.1,
      (hJ η h1 h2).2.2.2.2.2.2.2.1⟩
  case J13 =>
    intro m
    obtain ⟨C, N, hC⟩ := hO8 m
    refine ⟨max C 0 * Real.exp (aa / Real.log (Xg / Xa) ^ 2), max N 0,
      fun X η hX1 hX2 h1 h2 => ?_⟩
    have hmem : Ioi XR ×ˢ (univ : Set ℝ) ∈ nhds ((X, η) : ℝ × ℝ) :=
      (isOpen_Ioi.prod isOpen_univ).mem_nhds ⟨mem_Ioi.mpr (by linarith), mem_univ _⟩
    have hev : (fun w : ℝ × ℝ => Real.sqrt (2 * w.1) * F w.1 w.2 -
          cinf * w.1 ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - w.2 ^ 2) / w.1)) =ᶠ[nhds (X, η)]
        (fun w : ℝ × ℝ => Real.sqrt (2 * w.1) * Fo w.1 w.2 -
          cinf * w.1 ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - w.2 ^ 2) / w.1)) :=
      Filter.eventuallyEq_of_mem hmem (fun w hw => by
        simp only [hFout w.1 w.2 (mem_Ioi.mp hw.1).le])
    rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
    have hb := hC X η hX1 hX2 h1 h2
    obtain ⟨w1, -, w3, w4, w5⟩ := hW2 X (by linarith) hX2
    exact weight_bound C N (Real.exp (aa / Real.log (Xg / Xa) ^ 2))
      (Real.exp (-(ab / Real.log (Xb / X) ^ 2))) (edgeWeight Xa Xb aa ab X)
      (min 1 (Real.log (Xb / X))) (edgeDist Xa Xb X) _ (Real.exp_pos _) w1.le w3 w4 w5
      (min_le_left _ _) (Real.exp_pos _).le hb

theorem spike_profile : ∀ K : ℝ, ∃ (h : ℝ → ℝ) (H : ℝ), ContDiff ℝ ∞ h ∧ Function.Periodic h 1 ∧ (∀ u, -1 ≤ h u) ∧ (∀ u, |h u| ≤ H) ∧ (∫ u in (0:ℝ)..1, h u) = 0 ∧ (∫ u in (0:ℝ)..1, Real.sin (2 * Real.pi * u) * h u) = 0 ∧ K ≤ ∫ u in (0:ℝ)..1, h u ^ 2 :=
by

  have s1 : ∀ k : ℕ, (∫ u in (0:ℝ)..1, Real.sin (Real.pi * u) ^ (2 * k)) =
      ∏ i ∈ Finset.range k, (2 * (i:ℝ) + 1) / (2 * (i:ℝ) + 2) := by
    intro k
    have := intervalIntegral.integral_comp_mul_left (fun x => Real.sin x ^ (2 * k))
      (a := 0) (b := 1) Real.pi_pos.ne'
    simp only [mul_zero, mul_one] at this
    rw [this, integral_sin_pow_even, smul_eq_mul, inv_mul_cancel_left₀ Real.pi_pos.ne']

  have s2 : ∀ k : ℕ, 0 < (∏ i ∈ Finset.range k, (2 * (i:ℝ) + 1) / (2 * (i:ℝ) + 2)) ∧
      (∏ i ∈ Finset.range k, (2 * (i:ℝ) + 1) / (2 * (i:ℝ) + 2)) ^ 2 * (2 * (k:ℝ) + 1) ≤ 1 ∧
      1 ≤ (∏ i ∈ Finset.range k, (2 * (i:ℝ) + 1) / (2 * (i:ℝ) + 2)) ^ 2 * (4 * (k:ℝ) + 1) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      obtain ⟨hp, hu, hl⟩ := ih
      rw [Finset.prod_range_succ]
      set W := ∏ i ∈ Finset.range k, (2 * (i:ℝ) + 1) / (2 * (i:ℝ) + 2)
      have hk : (0:ℝ) ≤ k := Nat.cast_nonneg k
      have hd : (0:ℝ) < 2 * k + 2 := by linarith
      push_cast
      rw [mul_pow, div_pow]
      refine ⟨mul_pos hp (div_pos (by linarith) hd), ?_, ?_⟩
      · rw [show W ^ 2 * ((2 * (k:ℝ) + 1) ^ 2 / (2 * k + 2) ^ 2) * (2 * (k + 1) + 1) =
            (W ^ 2 * (2 * k + 1)) * ((2 * k + 1) * (2 * k + 3)) / (2 * k + 2) ^ 2 by
              field_simp; ring]
        rw [div_le_one (by positivity)]
        have h1 : 0 ≤ (2 * (k:ℝ) + 1) * (2 * k + 3) := by positivity
        nlinarith [mul_le_mul_of_nonneg_right hu h1]
      · rw [show W ^ 2 * ((2 * (k:ℝ) + 1) ^ 2 / (2 * k + 2) ^ 2) * (4 * (k + 1) + 1) =
            W ^ 2 * ((2 * k + 1) ^ 2 * (4 * k + 5)) / (2 * k + 2) ^ 2 by
              field_simp; ring]
        rw [le_div_iff₀ (by positivity)]
        have e : (2 * (k:ℝ) + 1) ^ 2 * (4 * k + 5) = (2 * k + 2) ^ 2 * (4 * k + 1) + 1 := by ring
        rw [e]
        nlinarith [mul_le_mul_of_nonneg_right hl (sq_nonneg (2 * (k:ℝ) + 2)), sq_nonneg W]

  have s3 : ∀ (n : ℕ) (c : ℝ), (∫ u in (0:ℝ)..1, Real.sin (2 * Real.pi * u) *
      (Real.sin (Real.pi * u) ^ (2 * n) / c - 1)) = 0 := by
    intro n c
    let g : ℝ → ℝ := fun u => Real.sin (2 * Real.pi * u) * (Real.sin (Real.pi * u) ^ (2 * n) / c - 1)
    have hsym : ∀ u, g (1 - u) = - g u := by
      intro u
      simp only [g]
      rw [show Real.pi * (1 - u) = Real.pi - Real.pi * u by ring, Real.sin_pi_sub,
        show 2 * Real.pi * (1 - u) = 2 * Real.pi - 2 * Real.pi * u by ring, Real.sin_two_pi_sub]
      ring
    have h1 := intervalIntegral.integral_comp_sub_left g (1:ℝ) (a := 0) (b := 1)
    simp only [sub_zero, sub_self] at h1
    have h2 : (∫ x in (0:ℝ)..1, g (1 - x)) = - ∫ x in (0:ℝ)..1, g x := by
      simp only [hsym, intervalIntegral.integral_neg]
    show (∫ u in (0:ℝ)..1, g u) = 0
    linarith

  intro K
  obtain ⟨n, hn⟩ : ∃ n : ℕ, n = ⌈2 * (|K| + 1) ^ 2⌉₊ := ⟨_, rfl⟩
  have hnK : 2 * (|K| + 1) ^ 2 ≤ (n:ℝ) := by rw [hn]; exact Nat.le_ceil _
  obtain ⟨W, hW⟩ : ∃ W : ℝ, W = ∏ i ∈ Finset.range n, (2 * (i:ℝ) + 1) / (2 * (i:ℝ) + 2) :=
    ⟨_, rfl⟩
  obtain ⟨W2, hW2⟩ : ∃ W2 : ℝ,
      W2 = ∏ i ∈ Finset.range (2 * n), (2 * (i:ℝ) + 1) / (2 * (i:ℝ) + 2) := ⟨_, rfl⟩
  obtain ⟨hWp, hWu, -⟩ := s2 n
  obtain ⟨hW2p, -, hW2l⟩ := s2 (2 * n)
  rw [← hW] at hWp hWu
  rw [← hW2] at hW2p hW2l
  have hI1 : (∫ u in (0:ℝ)..1, Real.sin (Real.pi * u) ^ (2 * n)) = W := by rw [hW]; exact s1 n
  have hI2 : (∫ u in (0:ℝ)..1, Real.sin (Real.pi * u) ^ (2 * (2 * n))) = W2 := by
    rw [hW2]; exact s1 (2 * n)
  have hc1 : Continuous (fun u : ℝ => Real.sin (Real.pi * u) ^ (2 * n)) := by fun_prop
  have hc2 : Continuous (fun u : ℝ => Real.sin (Real.pi * u) ^ (2 * (2 * n))) := by fun_prop
  refine ⟨fun u => Real.sin (Real.pi * u) ^ (2 * n) / W - 1, 1 / W + 1, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · fun_prop
  · intro u
    simp only
    rw [show Real.pi * (u + 1) = Real.pi * u + Real.pi by ring, Real.sin_add_pi, pow_mul, pow_mul,
      neg_sq]
  · intro u
    have h0 : 0 ≤ Real.sin (Real.pi * u) ^ (2 * n) := by rw [pow_mul]; positivity
    have : 0 ≤ Real.sin (Real.pi * u) ^ (2 * n) / W := div_nonneg h0 hWp.le
    simp only
    linarith
  · intro u
    have h0 : 0 ≤ Real.sin (Real.pi * u) ^ (2 * n) := by rw [pow_mul]; positivity
    have h1 : Real.sin (Real.pi * u) ^ (2 * n) ≤ 1 := by
      rw [pow_mul]
      apply pow_le_one₀ (sq_nonneg _)
      rw [sq_le_one_iff_abs_le_one]
      exact Real.abs_sin_le_one _
    have h2 : Real.sin (Real.pi * u) ^ (2 * n) / W ≤ 1 / W := div_le_div_of_nonneg_right h1 hWp.le
    have h3 : 0 ≤ Real.sin (Real.pi * u) ^ (2 * n) / W := div_nonneg h0 hWp.le
    have h4 : 0 < 1 / W := by positivity
    simp only
    rw [abs_le]
    constructor <;> linarith
  · rw [intervalIntegral.integral_sub ((hc1.div_const W).intervalIntegrable _ _)
      intervalIntegrable_const,
      intervalIntegral.integral_div, hI1]
    simp [hWp.ne']
  · exact s3 n W
  · have hpt : ∀ u : ℝ, (Real.sin (Real.pi * u) ^ (2 * n) / W - 1) ^ 2 =
        Real.sin (Real.pi * u) ^ (2 * (2 * n)) * (1 / W ^ 2) -
          (2 / W) * Real.sin (Real.pi * u) ^ (2 * n) + 1 := by
      intro u
      rw [show 2 * (2 * n) = (2 * n) * 2 by ring, pow_mul]
      field_simp
      ring
    simp only [hpt]
    have i1 : IntervalIntegrable (fun u : ℝ => Real.sin (Real.pi * u) ^ (2 * (2 * n)) * (1 / W ^ 2))
        volume 0 1 := (hc2.mul continuous_const).intervalIntegrable _ _
    have i2 : IntervalIntegrable (fun u : ℝ => 2 / W * Real.sin (Real.pi * u) ^ (2 * n))
        volume 0 1 := (continuous_const.mul hc1).intervalIntegrable _ _
    rw [intervalIntegral.integral_add (i1.sub i2) intervalIntegrable_const,
      intervalIntegral.integral_sub i1 i2,
      intervalIntegral.integral_mul_const, intervalIntegral.integral_const_mul, hI1, hI2]
    simp only [intervalIntegral.integral_const, sub_zero, smul_eq_mul, one_mul]
    have hx : 0 < W ^ 2 := by positivity
    have e : W2 * (1 / W ^ 2) - 2 / W * W + 1 = W2 / W ^ 2 - 1 := by field_simp; ring
    rw [e]
    have hcast : ((2 * n : ℕ) : ℝ) = 2 * (n:ℝ) := by push_cast; ring
    rw [hcast] at hW2l
    have hn0 : (0:ℝ) ≤ n := Nat.cast_nonneg n
    have ha : 0 < |K| + 1 := by positivity
    have hA : (|K| + 1) ^ 2 ≤ n / 2 := by linarith
    have hB : (W ^ 2) ^ 2 * (2 * n + 1) ^ 2 ≤ 1 := by
      have := mul_le_mul hWu hWu (by positivity) zero_le_one
      nlinarith
    have hC : (n / 2) * (8 * n + 1) ≤ (2 * (n:ℝ) + 1) ^ 2 := by nlinarith
    have h1 : (|K| + 1) ^ 2 * (W ^ 2) ^ 2 * (8 * n + 1) ≤ W2 ^ 2 * (8 * n + 1) := by
      calc (|K| + 1) ^ 2 * (W ^ 2) ^ 2 * (8 * n + 1)
          ≤ (n / 2) * (W ^ 2) ^ 2 * (8 * n + 1) := by gcongr
        _ = (W ^ 2) ^ 2 * ((n / 2) * (8 * n + 1)) := by ring
        _ ≤ (W ^ 2) ^ 2 * (2 * n + 1) ^ 2 := by gcongr
        _ ≤ 1 := hB
        _ ≤ W2 ^ 2 * (4 * (2 * n) + 1) := hW2l
        _ = W2 ^ 2 * (8 * n + 1) := by ring
    have h2 : ((|K| + 1) * W ^ 2) ^ 2 ≤ W2 ^ 2 := by
      have h8 : (0:ℝ) < 8 * n + 1 := by linarith
      have : ((|K| + 1) * W ^ 2) ^ 2 * (8 * n + 1) ≤ W2 ^ 2 * (8 * n + 1) := by
        calc ((|K| + 1) * W ^ 2) ^ 2 * (8 * n + 1) = (|K| + 1) ^ 2 * (W ^ 2) ^ 2 * (8 * n + 1) := by
              ring
          _ ≤ _ := h1
      exact le_of_mul_le_mul_right this h8
    have key : (|K| + 1) * W ^ 2 ≤ W2 :=
      (pow_le_pow_iff_left₀ (by positivity) hW2p.le two_ne_zero).mp h2
    have : |K| + 1 ≤ W2 / W ^ 2 := by rw [le_div_iff₀ hx]; exact key
    linarith [le_abs_self K]

theorem loop_reparam : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] (U : Set E) (h : ℝ → ℝ) (Q : ℝ) (al ts s c : E → ℝ), IsOpen U → ContDiff ℝ ∞ h → Function.Periodic h 1 → (∫ u in (0:ℝ)..1, h u) = 0 → (∫ u in (0:ℝ)..1, Real.sin (2 * Real.pi * u) * h u) = 0 → (∫ u in (0:ℝ)..1, h u ^ 2) = Q → 0 ≤ Q → ContDiffOn ℝ ∞ al U → ContDiffOn ℝ ∞ ts U → ContDiffOn ℝ ∞ s U → ContDiffOn ℝ ∞ c U → (∀ p ∈ U, 0 < al p) → ∃ θ : E → ℝ → ℝ, ContDiffOn ℝ ∞ (fun z : E × ℝ => θ z.1 z.2) (U ×ˢ Set.univ) ∧ ∀ p ∈ U, (∀ φ : ℝ, θ p (φ + 1) = θ p φ + 1) ∧ (∫ φ in (0:ℝ)..1, al p * (1 + ts p ^ 2 + s p ^ 2) / (1 + (ts p + s p * ((Real.sqrt 2 * Real.sin (2 * Real.pi * θ p φ) + c p * h (θ p φ)) / Real.sqrt (1 + c p ^ 2 * Q))) ^ 2)) = al p ∧ (∫ φ in (0:ℝ)..1, -(ts p + s p * ((Real.sqrt 2 * Real.sin (2 * Real.pi * θ p φ) + c p * h (θ p φ)) / Real.sqrt (1 + c p ^ 2 * Q))) * (al p * (1 + ts p ^ 2 + s p ^ 2) / (1 + (ts p + s p * ((Real.sqrt 2 * Real.sin (2 * Real.pi * θ p φ) + c p * h (θ p φ)) / Real.sqrt (1 + c p ^ 2 * Q))) ^ 2))) = -(al p * ts p) :=
by
  intro E _ _ _ U h Q al ts s c hU hhs hhp hh0 hhsin hQ hQ0 _hal hts hs hc _hal0
  have hhc : Continuous h := hhs.continuous

  have prim : ∀ g : ℝ → ℝ, ContDiff ℝ ∞ g → Function.Periodic g 1 →
      ∃ G : ℝ → ℝ, ContDiff ℝ ∞ G ∧ (∀ u, HasDerivAt G (g u) u) ∧
        (∀ u, G (u + 1) = G u + ∫ v in (0:ℝ)..1, g v) ∧ G 0 = 0 := by
    intro g hg hper
    have hgc : Continuous g := hg.continuous
    have hd : ∀ u : ℝ, HasDerivAt (fun u => ∫ v in (0:ℝ)..u, g v) (g u) u :=
      fun u => (hgc.integral_hasStrictDerivAt 0 u).hasDerivAt
    refine ⟨fun u => ∫ v in (0:ℝ)..u, g v, ?_, hd, ?_, intervalIntegral.integral_same⟩
    · rw [contDiff_infty_iff_deriv]
      refine ⟨fun u => (hd u).differentiableAt, ?_⟩
      have e : deriv (fun u => ∫ v in (0:ℝ)..u, g v) = g := funext fun u => (hd u).deriv
      rw [e]; exact hg
    · intro u
      have := hper.intervalIntegral_add_eq_add 0 u (fun t₁ t₂ => hgc.intervalIntegrable t₁ t₂)
      rw [zero_add] at this
      exact this

  have h2p : (2 * Real.pi) ≠ 0 := by positivity
  have hsin_int : (∫ u in (0:ℝ)..1, Real.sin (2 * Real.pi * u)) = 0 := by
    rw [intervalIntegral.integral_comp_mul_left Real.sin h2p, integral_sin]
    simp
  have hsin2_int : (∫ u in (0:ℝ)..1, Real.sin (2 * Real.pi * u) ^ 2) = 1 / 2 := by
    have e : (∫ x in (0:ℝ)..1, Real.sin (2 * Real.pi * x) ^ 2) =
        (2 * Real.pi)⁻¹ • ∫ x in (2 * Real.pi * 0)..(2 * Real.pi * 1), Real.sin x ^ 2 :=
      intervalIntegral.integral_comp_mul_left (fun x => Real.sin x ^ 2) h2p
    rw [e, integral_sin_sq]
    simp only [mul_zero, mul_one, Real.sin_zero, Real.sin_two_pi, zero_mul, sub_zero, smul_eq_mul,
      zero_add]
    field_simp
  have hsper : ∀ u : ℝ, Real.sin (2 * Real.pi * (u + 1)) = Real.sin (2 * Real.pi * u) := by
    intro u; rw [mul_add, mul_one, Real.sin_add_two_pi]

  obtain ⟨S1, hS1s, hS1d, hS1p, hS10⟩ := prim (fun v => Real.sin (2 * Real.pi * v)) (by fun_prop)
    (fun u => hsper u)
  obtain ⟨H1, hH1s, hH1d, hH1p, hH10⟩ := prim h hhs hhp
  obtain ⟨S2, hS2s, hS2d, hS2p, hS20⟩ := prim (fun v => Real.sin (2 * Real.pi * v) ^ 2) (by fun_prop)
    (fun u => by simp only [hsper])
  obtain ⟨M, hMs, hMd, hMp, hM0⟩ := prim (fun v => Real.sin (2 * Real.pi * v) * h v) (by fun_prop)
    (fun u => by simp only [hsper, hhp u])
  obtain ⟨H2, hH2s, hH2d, hH2p, hH20⟩ := prim (fun v => h v ^ 2) (by fun_prop)
    (fun u => by simp only [hhp u])
  beta_reduce at hS1d hS2d hMd hH2d hS1p hS2p hMp hH2p
  simp only [hsin_int, add_zero] at hS1p
  simp only [hh0, add_zero] at hH1p
  simp only [hsin2_int] at hS2p
  simp only [hhsin, add_zero] at hMp
  simp only [hQ] at hH2p

  have hR : ∀ p, 0 < 1 + c p ^ 2 * Q := fun p =>
    add_pos_of_pos_of_nonneg one_pos (mul_nonneg (sq_nonneg _) hQ0)
  have hN : ∀ p, 0 < 1 + ts p ^ 2 + s p ^ 2 := fun p => by positivity
  obtain ⟨ρ, hρ⟩ : ∃ ρ : E → ℝ, ∀ p, ρ p = Real.sqrt (1 + c p ^ 2 * Q) := ⟨_, fun _ => rfl⟩
  have hρpos : ∀ p, 0 < ρ p := fun p => by rw [hρ]; exact Real.sqrt_pos.mpr (hR p)
  have hρ2 : ∀ p, ρ p ^ 2 = 1 + c p ^ 2 * Q := fun p => by rw [hρ]; exact Real.sq_sqrt (hR p).le
  have hs2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  obtain ⟨T, hT⟩ : ∃ T : E → ℝ → ℝ, ∀ p u, T p u =
      ts p + s p * ((Real.sqrt 2 * Real.sin (2 * Real.pi * u) + c p * h u) / ρ p) :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨w, hw⟩ : ∃ w : E → ℝ → ℝ, ∀ p u, w p u = (1 + T p u ^ 2) / (1 + ts p ^ 2 + s p ^ 2) :=
    ⟨_, fun _ _ => rfl⟩
  have hwpos : ∀ p u, 0 < w p u := fun p u => by rw [hw]; exact div_pos (by positivity) (hN p)
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : E → ℝ → ℝ, ∀ p u, Ψ p u =
      ((1 + ts p ^ 2) * u + 2 * ts p * s p / ρ p * (Real.sqrt 2 * S1 u + c p * H1 u) +
        s p ^ 2 / ρ p ^ 2 * (2 * S2 u + 2 * Real.sqrt 2 * c p * M u + c p ^ 2 * H2 u)) /
        (1 + ts p ^ 2 + s p ^ 2) := ⟨_, fun _ _ => rfl⟩
  have hΨd : ∀ p u, HasDerivAt (Ψ p) (w p u) u := by
    intro p u
    have e : Ψ p = fun y => ((1 + ts p ^ 2) * y + 2 * ts p * s p / ρ p * (Real.sqrt 2 * S1 y + c p * H1 y) +
        s p ^ 2 / ρ p ^ 2 * (2 * S2 y + 2 * Real.sqrt 2 * c p * M y + c p ^ 2 * H2 y)) /
        (1 + ts p ^ 2 + s p ^ 2) := funext fun y => hΨ p y
    rw [e]
    refine (((((hasDerivAt_id' u).const_mul (1 + ts p ^ 2)).add
      ((((hS1d u).const_mul (Real.sqrt 2)).add ((hH1d u).const_mul (c p))).const_mul
        (2 * ts p * s p / ρ p))).add
      (((((hS2d u).const_mul 2).add ((hMd u).const_mul (2 * Real.sqrt 2 * c p))).add
        ((hH2d u).const_mul (c p ^ 2))).const_mul (s p ^ 2 / ρ p ^ 2))).div_const
        (1 + ts p ^ 2 + s p ^ 2)).congr_deriv ?_
    rw [hw, hT]
    congr 1
    linear_combination (-(s p ^ 2 / ρ p ^ 2 * Real.sin (2 * Real.pi * u) ^ 2)) * hs2
  have hΨper : ∀ p u, Ψ p (u + 1) = Ψ p u + 1 := by
    intro p u
    have k1 : s p ^ 2 / ρ p ^ 2 * (2 * (1 / 2) + c p ^ 2 * Q) = s p ^ 2 := by
      rw [hρ2 p, show (2:ℝ) * (1 / 2) + c p ^ 2 * Q = 1 + c p ^ 2 * Q by ring,
        div_mul_cancel₀ _ (hR p).ne']
    calc Ψ p (u + 1) = Ψ p u + ((1 + ts p ^ 2) + s p ^ 2 / ρ p ^ 2 * (2 * (1 / 2) + c p ^ 2 * Q)) /
          (1 + ts p ^ 2 + s p ^ 2) := by
          rw [hΨ, hΨ, hS1p, hH1p, hS2p, hMp, hH2p]; ring
      _ = Ψ p u + 1 := by rw [k1, div_self (hN p).ne']
  have hΨ0 : ∀ p, Ψ p 0 = 0 := fun p => by
    rw [hΨ, hS10, hH10, hS20, hM0, hH20]; simp
  have hΨ1 : ∀ p, Ψ p 1 = 1 := fun p => by
    have := hΨper p 0; rwa [zero_add, hΨ0 p, zero_add] at this
  have hΨs : ContDiffOn ℝ ∞ (fun z : E × ℝ => Ψ z.1 z.2) (U ×ˢ univ) := by
    have e : (fun z : E × ℝ => Ψ z.1 z.2) = fun z => ((1 + ts z.1 ^ 2) * z.2 +
        2 * ts z.1 * s z.1 / ρ z.1 * (Real.sqrt 2 * S1 z.2 + c z.1 * H1 z.2) +
        s z.1 ^ 2 / ρ z.1 ^ 2 * (2 * S2 z.2 + 2 * Real.sqrt 2 * c z.1 * M z.2 + c z.1 ^ 2 * H2 z.2)) /
        (1 + ts z.1 ^ 2 + s z.1 ^ 2) := funext fun z => hΨ _ _
    rw [e]
    have hρs : ContDiffOn ℝ ∞ ρ U := by
      rw [show ρ = fun p => Real.sqrt (1 + c p ^ 2 * Q) from funext hρ]
      exact (contDiffOn_const.add ((hc.pow 2).mul contDiffOn_const)).sqrt (fun p _ => (hR p).ne')
    have hfst : MapsTo (Prod.fst : E × ℝ → E) (U ×ˢ univ) U := fun z hz => hz.1
    have A1 : ContDiffOn ℝ ∞ (fun z : E × ℝ => ts z.1) (U ×ˢ univ) := hts.comp contDiffOn_fst hfst
    have A2 : ContDiffOn ℝ ∞ (fun z : E × ℝ => s z.1) (U ×ˢ univ) := hs.comp contDiffOn_fst hfst
    have A3 : ContDiffOn ℝ ∞ (fun z : E × ℝ => c z.1) (U ×ˢ univ) := hc.comp contDiffOn_fst hfst
    have A4 : ContDiffOn ℝ ∞ (fun z : E × ℝ => ρ z.1) (U ×ˢ univ) := hρs.comp contDiffOn_fst hfst
    have B0 : ContDiffOn ℝ ∞ (fun z : E × ℝ => z.2) (U ×ˢ univ) := contDiffOn_snd
    have B1 : ContDiffOn ℝ ∞ (fun z : E × ℝ => S1 z.2) (U ×ˢ univ) :=
      (hS1s.comp contDiff_snd).contDiffOn
    have B2 : ContDiffOn ℝ ∞ (fun z : E × ℝ => H1 z.2) (U ×ˢ univ) :=
      (hH1s.comp contDiff_snd).contDiffOn
    have B3 : ContDiffOn ℝ ∞ (fun z : E × ℝ => S2 z.2) (U ×ˢ univ) :=
      (hS2s.comp contDiff_snd).contDiffOn
    have B4 : ContDiffOn ℝ ∞ (fun z : E × ℝ => M z.2) (U ×ˢ univ) :=
      (hMs.comp contDiff_snd).contDiffOn
    have B5 : ContDiffOn ℝ ∞ (fun z : E × ℝ => H2 z.2) (U ×ˢ univ) :=
      (hH2s.comp contDiff_snd).contDiffOn
    exact ((((contDiffOn_const.add (A1.pow 2)).mul B0).add
      ((((contDiffOn_const.mul A1).mul A2).div A4 (fun z _ => (hρpos z.1).ne')).mul
        ((contDiffOn_const.mul B1).add (A3.mul B2)))).add
      (((A2.pow 2).div (A4.pow 2) (fun z _ => pow_ne_zero 2 (hρpos z.1).ne')).mul
        (((contDiffOn_const.mul B3).add ((contDiffOn_const.mul A3).mul B4)).add
          ((A3.pow 2).mul B5)))).div
      ((contDiffOn_const.add (A1.pow 2)).add (A2.pow 2)) (fun z _ => (hN z.1).ne')

  have hmono : ∀ p, StrictMono (Ψ p) := fun p => strictMono_of_hasDerivAt_pos (hΨd p) (hwpos p)
  have hsurj : ∀ p, Function.Surjective (Ψ p) := by
    intro p
    have hcont : Continuous (Ψ p) :=
      continuous_iff_continuousAt.2 fun u => (hΨd p u).continuousAt
    have hshift : ∀ (n : ℕ) (u : ℝ), Ψ p (u + n) = Ψ p u + n := by
      intro n
      induction n with
      | zero => intro u; simp
      | succ k ih => intro u; rw [Nat.cast_succ, ← add_assoc, hΨper, ih]; ring
    intro φ
    obtain ⟨n, hn⟩ := exists_nat_gt |φ - Ψ p 0|
    have h1 : Ψ p (-n) = Ψ p 0 - n := by
      have := hshift n (-n); rw [neg_add_cancel] at this; linarith
    have h2 : Ψ p n = Ψ p 0 + n := by
      have := hshift n 0; rwa [zero_add] at this
    have hab := abs_lt.mp hn
    obtain ⟨u, -, hu⟩ := intermediate_value_Icc (show (-(n:ℝ)) ≤ n by linarith)
      hcont.continuousOn ⟨by linarith, by linarith⟩
    exact ⟨u, hu⟩
  obtain ⟨θ, hθ⟩ : ∃ θ : E → ℝ → ℝ, θ = fun p => Function.invFun (Ψ p) := ⟨_, rfl⟩
  have hΨθ : ∀ p φ, Ψ p (θ p φ) = φ := fun p φ => by
    rw [hθ]; exact Function.invFun_eq (hsurj p φ)
  have hθΨ : ∀ p u, θ p (Ψ p u) = u := fun p u => by
    rw [hθ]; exact Function.leftInverse_invFun (hmono p).injective u

  have hθs : ContDiffOn ℝ ∞ (fun z : E × ℝ => θ z.1 z.2) (U ×ˢ univ) := by
    rintro ⟨p, φ⟩ ⟨hp, -⟩
    apply ContDiffAt.contDiffWithinAt
    obtain ⟨F, hF⟩ : ∃ F : E × ℝ → E × ℝ, F = fun z => (z.1, Ψ z.1 z.2) := ⟨_, rfl⟩
    have hFapp : ∀ z, F z = (z.1, Ψ z.1 z.2) := fun z => by rw [hF]
    have hopen : IsOpen (U ×ˢ (univ : Set ℝ)) := hU.prod isOpen_univ
    have hmem : ((p, θ p φ) : E × ℝ) ∈ U ×ˢ (univ : Set ℝ) := ⟨hp, mem_univ _⟩
    have hΨa : ContDiffAt ℝ ∞ (fun z : E × ℝ => Ψ z.1 z.2) (p, θ p φ) :=
      hΨs.contDiffAt (hopen.mem_nhds hmem)
    have hFa : ContDiffAt ℝ ∞ F (p, θ p φ) := by rw [hF]; exact contDiffAt_fst.prodMk hΨa
    obtain ⟨L, hLdef⟩ : ∃ L : (E × ℝ) →L[ℝ] ℝ,
        L = fderiv ℝ (fun z : E × ℝ => Ψ z.1 z.2) (p, θ p φ) := ⟨_, rfl⟩
    have hL : HasFDerivAt (fun z : E × ℝ => Ψ z.1 z.2) L (p, θ p φ) := by
      rw [hLdef]; exact (hΨa.differentiableAt (by simp)).hasFDerivAt
    obtain ⟨w₀, hw₀⟩ : ∃ w₀ : ℝ, w₀ = w p (θ p φ) := ⟨_, rfl⟩
    have hw0 : 0 < w₀ := by rw [hw₀]; exact hwpos _ _
    have hL01 : L (0, 1) = w₀ := by
      have hγ : HasDerivAt (fun t : ℝ => ((p, t) : E × ℝ)) ((0, 1) : E × ℝ) (θ p φ) :=
        (hasDerivAt_const (θ p φ) p).prodMk (hasDerivAt_id' (θ p φ))
      have h1 : HasDerivAt (Ψ p) (L (0, 1)) (θ p φ) := hL.comp_hasDerivAt (θ p φ) hγ
      rw [hw₀]
      exact h1.unique (hΨd p (θ p φ))
    have hLab : ∀ (a : E) (b : ℝ), L (a, b) = L (a, 0) + b * w₀ := by
      intro a b
      have e : ((a, b) : E × ℝ) = (a, 0) + b • ((0, 1) : E × ℝ) := by ext <;> simp
      rw [e, map_add, map_smul, hL01, smul_eq_mul]
    let f₁ : (E × ℝ) →L[ℝ] (E × ℝ) := (ContinuousLinearMap.fst ℝ E ℝ).prod L
    let f₂ : (E × ℝ) →L[ℝ] (E × ℝ) := (ContinuousLinearMap.fst ℝ E ℝ).prod
      (w₀⁻¹ • (ContinuousLinearMap.snd ℝ E ℝ -
        (L.comp (ContinuousLinearMap.inl ℝ E ℝ)).comp (ContinuousLinearMap.fst ℝ E ℝ)))
    have hf₁ : ∀ x : E × ℝ, f₁ x = (x.1, L x) := fun x => rfl
    have hf₂ : ∀ x : E × ℝ, f₂ x = (x.1, w₀⁻¹ * (x.2 - L (x.1, 0))) := fun x => rfl
    have h₁ : Function.LeftInverse f₂ f₁ := by
      rintro ⟨a, b⟩
      rw [hf₁, hf₂]
      show (a, w₀⁻¹ * (L (a, b) - L (a, 0))) = (a, b)
      rw [hLab a b, add_sub_cancel_left]
      congr 1
      field_simp
    have h₂ : Function.RightInverse f₂ f₁ := by
      rintro ⟨a, b⟩
      rw [hf₂, hf₁]
      show (a, L (a, w₀⁻¹ * (b - L (a, 0)))) = (a, b)
      rw [hLab a (w₀⁻¹ * (b - L (a, 0)))]
      congr 1
      field_simp
      ring
    let Φ : (E × ℝ) ≃L[ℝ] (E × ℝ) := ContinuousLinearEquiv.equivOfInverse f₁ f₂ h₁ h₂
    have hF' : HasFDerivAt F (Φ : (E × ℝ) →L[ℝ] (E × ℝ)) (p, θ p φ) := by
      have e : (Φ : (E × ℝ) →L[ℝ] (E × ℝ)) = f₁ := ContinuousLinearMap.ext fun x => rfl
      rw [e, hF]
      exact hasFDerivAt_fst.prodMk hL
    have hstrict := hFa.hasStrictFDerivAt' hF' (by simp)
    have hG : ContDiffAt ℝ ∞ (HasStrictFDerivAt.localInverse F Φ (p, θ p φ) hstrict)
        (F (p, θ p φ)) := hFa.to_localInverse hF' (by simp)
    have hrinv := hstrict.eventually_right_inverse
    have hFx : F (p, θ p φ) = (p, φ) := by
      rw [hFapp]; show (p, Ψ p (θ p φ)) = (p, φ); rw [hΨθ]
    rw [hFx] at hG hrinv
    obtain ⟨G, hGdef⟩ : ∃ G : E × ℝ → E × ℝ,
        G = HasStrictFDerivAt.localInverse F Φ (p, θ p φ) hstrict := ⟨_, rfl⟩
    rw [← hGdef] at hG hrinv
    have heq : (fun z : E × ℝ => θ z.1 z.2) =ᶠ[nhds (p, φ)] fun y => (G y).2 := by
      filter_upwards [hrinv] with y hy
      rw [hFapp] at hy
      have e1 : (G y).1 = y.1 := (Prod.ext_iff.mp hy).1
      have e2 : Ψ (G y).1 (G y).2 = y.2 := (Prod.ext_iff.mp hy).2
      rw [e1] at e2
      apply (hmono y.1).injective
      rw [hΨθ, e2]
    exact (contDiffAt_snd.comp (p, φ) hG).congr_of_eventuallyEq heq

  have hθper : ∀ p φ, θ p (φ + 1) = θ p φ + 1 := fun p φ =>
    (hmono p).injective (by rw [hΨper, hΨθ, hΨθ])

  refine ⟨θ, hθs, fun p hp => ⟨fun φ => hθper p φ, ?_, ?_⟩⟩
  · have hθc : Continuous (θ p) := hθs.continuousOn.comp_continuous
      (continuous_const.prodMk continuous_id) (fun φ => ⟨hp, mem_univ _⟩)
    have hTc : Continuous (T p) := by
      rw [show T p = fun u => ts p + s p * ((Real.sqrt 2 * Real.sin (2 * Real.pi * u) + c p * h u) / ρ p)
        from funext (hT p)]
      fun_prop
    have hwc : Continuous (w p) := by
      rw [show w p = fun u => (1 + T p u ^ 2) / (1 + ts p ^ 2 + s p ^ 2) from funext (hw p)]
      exact (continuous_const.add (hTc.pow 2)).div_const _
    simp only [← hρ, ← hT]
    have key := intervalIntegral.integral_comp_mul_deriv (a := 0) (b := 1) (f := Ψ p) (f' := w p)
      (g := fun φ => al p * (1 + ts p ^ 2 + s p ^ 2) / (1 + T p (θ p φ) ^ 2))
      (fun x _ => hΨd p x) hwc.continuousOn
      (continuous_const.div (continuous_const.add ((hTc.comp hθc).pow 2))
        (fun x => (add_pos_of_pos_of_nonneg one_pos (sq_nonneg _)).ne'))
    rw [hΨ0 p, hΨ1 p] at key
    rw [← key]
    have e : ∀ x, ((fun φ => al p * (1 + ts p ^ 2 + s p ^ 2) / (1 + T p (θ p φ) ^ 2)) ∘ Ψ p) x *
        w p x = al p := by
      intro x
      simp only [Function.comp, hθΨ]
      rw [hw]
      field_simp
    rw [intervalIntegral.integral_congr (g := fun _ => al p) (fun x _ => e x)]
    simp
  · have hθc : Continuous (θ p) := hθs.continuousOn.comp_continuous
      (continuous_const.prodMk continuous_id) (fun φ => ⟨hp, mem_univ _⟩)
    have hTc : Continuous (T p) := by
      rw [show T p = fun u => ts p + s p * ((Real.sqrt 2 * Real.sin (2 * Real.pi * u) + c p * h u) / ρ p)
        from funext (hT p)]
      fun_prop
    have hwc : Continuous (w p) := by
      rw [show w p = fun u => (1 + T p u ^ 2) / (1 + ts p ^ 2 + s p ^ 2) from funext (hw p)]
      exact (continuous_const.add (hTc.pow 2)).div_const _
    simp only [← hρ, ← hT]
    have key := intervalIntegral.integral_comp_mul_deriv (a := 0) (b := 1) (f := Ψ p) (f' := w p)
      (g := fun φ => -T p (θ p φ) * (al p * (1 + ts p ^ 2 + s p ^ 2) / (1 + T p (θ p φ) ^ 2)))
      (fun x _ => hΨd p x) hwc.continuousOn
      ((hTc.comp hθc).neg.mul (continuous_const.div (continuous_const.add ((hTc.comp hθc).pow 2))
        (fun x => (add_pos_of_pos_of_nonneg one_pos (sq_nonneg _)).ne')))
    rw [hΨ0 p, hΨ1 p] at key
    rw [← key]
    have e : ∀ x, ((fun φ => -T p (θ p φ) * (al p * (1 + ts p ^ 2 + s p ^ 2) /
        (1 + T p (θ p φ) ^ 2))) ∘ Ψ p) x * w p x = -T p x * al p := by
      intro x
      simp only [Function.comp, hθΨ]
      rw [hw]
      have h1 : (0:ℝ) < 1 + T p x ^ 2 := by positivity
      have h2 := hN p
      field_simp
    rw [intervalIntegral.integral_congr (g := fun x => -T p x * al p) (fun x _ => e x)]
    have hF : ∀ x ∈ uIcc (0:ℝ) 1, HasDerivAt
        (fun x => -al p * (ts p * x + s p * ((Real.sqrt 2 * S1 x + c p * H1 x) / ρ p)))
        (-T p x * al p) x := by
      intro x _
      refine ((((hasDerivAt_id' x).const_mul (ts p)).add
        (((((hS1d x).const_mul (Real.sqrt 2)).add ((hH1d x).const_mul (c p))).div_const
          (ρ p)).const_mul (s p))).const_mul (-al p)).congr_deriv ?_
      rw [hT]; ring
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hF
      ((hTc.neg.mul continuous_const).intervalIntegrable 0 1)]
    have hS11 : S1 1 = 0 := by have := hS1p 0; rwa [zero_add, hS10] at this
    have hH11 : H1 1 = 0 := by have := hH1p 0; rwa [zero_add, hH10] at this
    simp only [hS11, hH11, hS10, hH10]
    ring

theorem shear_loop_exists : LoopProperty :=
by
  intro μ A δ0 hμ hA hδ0

  have cone_low : ∀ P J : ℝ, 2 < P →
      2 * (P - 2) ^ 2 / (J ^ 2 + 4 * (P - 2)) ≤ coneUp P J - 2 := by
    intro P J hP
    unfold coneUp
    have hj0 := abs_nonneg J
    rw [← sq_abs J]
    generalize |J| = j at *
    have harg : 0 < (P - 2) / 2 + j ^ 2 / 16 := by positivity
    have hS2 : Real.sqrt ((P - 2) / 2 + j ^ 2 / 16) ^ 2 = (P - 2) / 2 + j ^ 2 / 16 :=
      Real.sq_sqrt harg.le
    have hSp : 0 < Real.sqrt ((P - 2) / 2 + j ^ 2 / 16) := Real.sqrt_pos.mpr harg
    generalize Real.sqrt ((P - 2) / 2 + j ^ 2 / 16) = S at *
    have hrel : 16 * S ^ 2 = 8 * (P - 2) + j ^ 2 := by rw [hS2]; ring
    have hKid : (P + j ^ 2 / 4 - j * S - 2) * (4 * S + j) ^ 2 = 8 * (P - 2) ^ 2 := by
      linear_combination ((P - 2) - j / 4 * (4 * S + j)) * hrel
    have hpos : 0 < 4 * S + j := by linarith
    have hsq : (4 * S + j) ^ 2 ≤ 4 * (j ^ 2 + 4 * (P - 2)) := by nlinarith [sq_nonneg (4 * S - j)]
    have hK0 : 0 ≤ P + j ^ 2 / 4 - j * S - 2 := by
      by_contra hK
      push_neg at hK
      have := mul_neg_of_neg_of_pos hK (pow_pos hpos 2)
      nlinarith
    rw [div_le_iff₀ (by nlinarith)]
    nlinarith [mul_le_mul_of_nonneg_left hsq hK0]

  have Dbd : ∀ (Q H c x y : ℝ), 0 < Q → |x| ≤ 2 → -1 ≤ y → |y| ≤ H →
      |(x + c * y) / Real.sqrt (1 + c ^ 2 * Q)| ≤ 2 + H / Real.sqrt Q ∧
      ((|c| + 2) ^ 2 ≤ Q → -1 ≤ c * ((x + c * y) / Real.sqrt (1 + c ^ 2 * Q))) := by
    intro Q H c x y hQ hx hy hyH
    have hH0 : 0 ≤ H := (abs_nonneg y).trans hyH
    have harg : 0 < 1 + c ^ 2 * Q := by positivity
    have hr : 0 < Real.sqrt (1 + c ^ 2 * Q) := Real.sqrt_pos.mpr harg
    have hr1 : 1 ≤ Real.sqrt (1 + c ^ 2 * Q) := by
      have h1 := Real.sqrt_le_sqrt (show (1:ℝ) ≤ 1 + c ^ 2 * Q by nlinarith [sq_nonneg c])
      rwa [Real.sqrt_one] at h1
    have hsQ : 0 < Real.sqrt Q := Real.sqrt_pos.mpr hQ
    have hrc : |c| * Real.sqrt Q ≤ Real.sqrt (1 + c ^ 2 * Q) := by
      rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_mul (sq_nonneg c)]
      exact Real.sqrt_le_sqrt (by linarith)
    generalize Real.sqrt (1 + c ^ 2 * Q) = r at *
    constructor
    · rw [abs_div, abs_of_pos hr]
      have h1 : |x + c * y| ≤ |x| + |c| * |y| := by
        rw [← abs_mul]; exact abs_add_le _ _
      have h2 : |x| / r ≤ 2 := (div_le_self (abs_nonneg x) hr1).trans hx
      have h3 : |c| * |y| / r ≤ H / Real.sqrt Q := by
        rw [div_le_div_iff₀ hr hsQ]
        have := mul_le_mul hyH hrc (by positivity) hH0
        nlinarith
      calc |x + c * y| / r ≤ (|x| + |c| * |y|) / r := div_le_div_of_nonneg_right h1 hr.le
        _ = |x| / r + |c| * |y| / r := add_div _ _ _
        _ ≤ 2 + H / Real.sqrt Q := by linarith
    · intro hcQ
      have hsq : |c| + 2 ≤ Real.sqrt Q := by
        rw [← Real.sqrt_sq (by positivity : (0:ℝ) ≤ |c| + 2)]
        exact Real.sqrt_le_sqrt hcQ
      have hrr : c ^ 2 + 2 * |c| ≤ r := by
        have := mul_le_mul_of_nonneg_left hsq (abs_nonneg c)
        have hcc : |c| * |c| = c ^ 2 := by rw [abs_mul_abs_self]; ring
        nlinarith
      have hcx : -(2 * |c|) ≤ c * x := by
        have : |c * x| ≤ |c| * 2 := by
          rw [abs_mul]; exact mul_le_mul_of_nonneg_left hx (abs_nonneg c)
        linarith [neg_abs_le (c * x)]
      have hcy : -c ^ 2 ≤ c ^ 2 * y := by nlinarith [sq_nonneg c]
      rw [← mul_div_assoc, le_div_iff₀ hr]
      nlinarith

  have marg : ∀ (μ τ δL a b p1 p2 T v aL bL : ℝ), 0 < μ → 0 < δL →
      μ ≤ p1 - b / a * p2 - 2 →
      μ ≤ coneUp (p1 - b / a * p2) (p2 + b / a * p1) - a * (1 + (b / a) ^ 2) →
      |T| ≤ τ → p1 - b / a * p2 - μ / 2 ≤ p1 + T * p2 → 2 + δL / 8 ≤ v →
      ((T = -(b / a) ∧ v = a * (1 + (b / a) ^ 2)) ∨
        (v ≤ 2 + δL / 2 ∧ 2 + δL ≤ coneUp (p1 + T * p2) (p2 - T * p1))) →
      aL = v / (1 + T ^ 2) → bL = -T * aL →
      min (min (2 / (1 + τ ^ 2)) (δL / 8)) (μ / 2) ≤ aL ∧
      min (min (2 / (1 + τ ^ 2)) (δL / 8)) (μ / 2) ≤ aL * (1 + (bL / aL) ^ 2) - 2 ∧
      min (min (2 / (1 + τ ^ 2)) (δL / 8)) (μ / 2) ≤ p1 - bL / aL * p2 - 2 ∧
      min (min (2 / (1 + τ ^ 2)) (δL / 8)) (μ / 2) ≤
        coneUp (p1 - bL / aL * p2) (p2 + bL / aL * p1) - aL * (1 + (bL / aL) ^ 2) := by
    intro μ τ δL a b p1 p2 T v aL bL hμ hδ hm1 hm2 hT hP hv halt haL hbL
    have hT2 : T ^ 2 ≤ τ ^ 2 := sq_le_sq' (abs_le.mp hT).1 (abs_le.mp hT).2
    have hden : 0 < 1 + T ^ 2 := by positivity
    have hv2 : 2 ≤ v := by linarith
    have haLpos : 0 < aL := by rw [haL]; exact div_pos (by linarith) hden
    have hratio : bL / aL = -T := by rw [hbL, mul_div_assoc, div_self haLpos.ne', mul_one]
    have hgap : aL * (1 + (bL / aL) ^ 2) = v := by
      rw [hratio, neg_sq, haL, div_mul_cancel₀ _ hden.ne']
    have e1 : p1 - -T * p2 = p1 + T * p2 := by ring
    have e2 : p2 + -T * p1 = p2 - T * p1 := by ring
    rw [hgap, hratio, e1, e2]
    have k1 : min (min (2 / (1 + τ ^ 2)) (δL / 8)) (μ / 2) ≤ 2 / (1 + τ ^ 2) :=
      (min_le_left _ _).trans (min_le_left _ _)
    have k2 : min (min (2 / (1 + τ ^ 2)) (δL / 8)) (μ / 2) ≤ δL / 8 :=
      (min_le_left _ _).trans (min_le_right _ _)
    have k3 : min (min (2 / (1 + τ ^ 2)) (δL / 8)) (μ / 2) ≤ μ / 2 := min_le_right _ _
    refine ⟨?_, by linarith, by linarith, ?_⟩
    · refine k1.trans ?_
      rw [haL]
      calc 2 / (1 + τ ^ 2) ≤ 2 / (1 + T ^ 2) :=
            div_le_div_of_nonneg_left (by norm_num) hden (by linarith)
        _ ≤ v / (1 + T ^ 2) := div_le_div_of_nonneg_right hv2 hden.le
    · rcases halt with ⟨hT', hv'⟩ | ⟨hv', hc'⟩
      · have f1 : p1 + T * p2 = p1 - b / a * p2 := by rw [hT']; ring
        have f2 : p2 - T * p1 = p2 + b / a * p1 := by rw [hT']; ring
        rw [f1, f2, hv']
        linarith
      · linarith

  obtain ⟨S, hSdef⟩ : ∃ S : ℝ, S = Real.sqrt (3 / μ) := ⟨_, rfl⟩
  have hS0 : 0 ≤ S := by rw [hSdef]; exact Real.sqrt_nonneg _
  obtain ⟨cM, hcMdef⟩ : ∃ cM : ℝ, cM = 2 * A * S / μ := ⟨_, rfl⟩
  have hcM0 : 0 ≤ cM := by rw [hcMdef]; positivity
  obtain ⟨h, H, hhs, hhp, hhlow, hhH, hh0, hhsin, hhK⟩ := spike_profile ((cM + 2) ^ 2)
  obtain ⟨Q, hQdef⟩ : ∃ Q : ℝ, Q = ∫ u in (0:ℝ)..1, h u ^ 2 := ⟨_, rfl⟩
  have hQK : (cM + 2) ^ 2 ≤ Q := by rw [hQdef]; exact hhK
  have hQpos : 0 < Q := by nlinarith
  have hH0 : 0 ≤ H := (abs_nonneg _).trans (hhH 0)
  have hsQ : 0 < Real.sqrt Q := Real.sqrt_pos.mpr hQpos
  obtain ⟨τ, hτdef⟩ : ∃ τ : ℝ, τ = A / μ + S * (2 + H / Real.sqrt Q) := ⟨_, rfl⟩
  have hτ0 : 0 ≤ τ := by
    rw [hτdef]
    exact add_nonneg (div_nonneg hA.le hμ.le)
      (mul_nonneg hS0 (by have := div_nonneg hH0 hsQ.le; linarith))
  obtain ⟨JM, hJMdef⟩ : ∃ JM : ℝ, JM = A + τ * A := ⟨_, rfl⟩
  have hJM0 : 0 ≤ JM := by rw [hJMdef]; positivity
  obtain ⟨δL, hδLdef⟩ : ∃ δL : ℝ, δL = min (min 1 δ0) (μ ^ 2 / (2 * (JM ^ 2 + 2 * μ))) :=
    ⟨_, rfl⟩
  have hδL : 0 < δL := by
    rw [hδLdef]; exact lt_min (lt_min one_pos hδ0) (by positivity)
  have hδL1 : δL ≤ 1 := by rw [hδLdef]; exact (min_le_left _ _).trans (min_le_left _ _)
  have hδLd : δL ≤ δ0 := by rw [hδLdef]; exact (min_le_left _ _).trans (min_le_right _ _)
  have hδLc : δL ≤ μ ^ 2 / (2 * (JM ^ 2 + 2 * μ)) := by rw [hδLdef]; exact min_le_right _ _
  obtain ⟨vst, hvstdef⟩ : ∃ v : ℝ, v = 2 + δL / 2 := ⟨_, rfl⟩
  obtain ⟨κ, hκdef⟩ : ∃ κ : ℝ, κ = min (min (2 / (1 + τ ^ 2)) (δL / 8)) (μ / 2) := ⟨_, rfl⟩
  have hκ : 0 < κ := by
    rw [hκdef]; exact lt_min (lt_min (by positivity) (by positivity)) (by positivity)

  obtain ⟨U, hUdef⟩ : ∃ U : Set (ℝ × ℝ × ℝ × ℝ), U = {p | 0 < p.1} := ⟨_, rfl⟩
  have hUo : IsOpen U := by rw [hUdef]; exact isOpen_lt continuous_const continuous_fst
  have hU1 : ∀ p ∈ U, 0 < p.1 := by intro p hp; rw [hUdef] at hp; exact hp
  obtain ⟨ts, hts⟩ : ∃ f : ℝ × ℝ × ℝ × ℝ → ℝ, ∀ p, f p = -(p.2.1 / p.1) := ⟨_, fun _ => rfl⟩
  obtain ⟨vs, hvs⟩ : ∃ f : ℝ × ℝ × ℝ × ℝ → ℝ, ∀ p, f p = p.1 * (1 + (p.2.1 / p.1) ^ 2) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨ζ, hζ⟩ : ∃ f : ℝ × ℝ × ℝ × ℝ → ℝ, ∀ p,
      f p = 1 - Real.smoothTransition ((vs p - 2 - δL / 8) / (δL / 8)) := ⟨_, fun _ => rfl⟩
  obtain ⟨ζ2, hζ2⟩ : ∃ f : ℝ × ℝ × ℝ × ℝ → ℝ, ∀ p,
      f p = 1 - Real.smoothTransition ((vs p - 2 - δL / 4) / (δL / 8)) := ⟨_, fun _ => rfl⟩
  obtain ⟨g, hg⟩ : ∃ f : ℝ × ℝ × ℝ × ℝ → ℝ, ∀ p,
      f p = ζ2 p * (vst - vs p) + (1 - ζ2 p) * (δL / 8) := ⟨_, fun _ => rfl⟩
  obtain ⟨s, hs⟩ : ∃ f : ℝ × ℝ × ℝ × ℝ → ℝ, ∀ p, f p = ζ p * Real.sqrt (g p / p.1) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨c, hc⟩ : ∃ f : ℝ × ℝ × ℝ × ℝ → ℝ, ∀ p, f p = 2 * p.2.2.2 * s p / μ :=
    ⟨_, fun _ => rfl⟩

  have hζ01 : ∀ p, 0 ≤ ζ p ∧ ζ p ≤ 1 := by
    intro p; rw [hζ]
    constructor
    · linarith [Real.smoothTransition.le_one ((vs p - 2 - δL / 8) / (δL / 8))]
    · linarith [Real.smoothTransition.nonneg ((vs p - 2 - δL / 8) / (δL / 8))]
  have hζ201 : ∀ p, 0 ≤ ζ2 p ∧ ζ2 p ≤ 1 := by
    intro p; rw [hζ2]
    constructor
    · linarith [Real.smoothTransition.le_one ((vs p - 2 - δL / 4) / (δL / 8))]
    · linarith [Real.smoothTransition.nonneg ((vs p - 2 - δL / 4) / (δL / 8))]
  have hδ8 : 0 < δL / 8 := by positivity
  have hζ0 : ∀ p, 2 + δL / 4 ≤ vs p → ζ p = 0 := by
    intro p hp
    rw [hζ, Real.smoothTransition.one_of_one_le, sub_self]
    rw [le_div_iff₀ hδ8]; linarith
  have hζ1 : ∀ p, vs p ≤ 2 + δL / 8 → ζ p = 1 := by
    intro p hp
    rw [hζ, Real.smoothTransition.zero_of_nonpos, sub_zero]
    exact div_nonpos_iff.mpr (Or.inr ⟨by linarith, hδ8.le⟩)
  have hζ2one : ∀ p, vs p ≤ 2 + δL / 4 → ζ2 p = 1 := by
    intro p hp
    rw [hζ2, Real.smoothTransition.zero_of_nonpos, sub_zero]
    exact div_nonpos_iff.mpr (Or.inr ⟨by linarith, hδ8.le⟩)
  have hglow : ∀ p, δL / 8 ≤ g p := by
    intro p
    by_cases hp : vs p ≤ 2 + 3 * δL / 8
    · rw [hg]
      have := mul_nonneg (hζ201 p).1 (show 0 ≤ vst - vs p - δL / 8 by rw [hvstdef]; linarith)
      nlinarith
    · have h0 : ζ2 p = 0 := by
        rw [hζ2, Real.smoothTransition.one_of_one_le, sub_self]
        rw [le_div_iff₀ hδ8]; linarith
      rw [hg, h0]; linarith
  have hvs0 : ∀ p ∈ U, 0 < vs p := by
    intro p hp; rw [hvs]; have := hU1 p hp; positivity
  have hg3 : ∀ p ∈ U, g p ≤ 3 := by
    intro p hp
    have h1 := mul_nonneg (hζ201 p).1 (hvs0 p hp).le
    have h2 := mul_nonneg (show 0 ≤ 1 - ζ2 p by linarith [(hζ201 p).2])
      (show 0 ≤ 2 + δL / 2 - δL / 8 by linarith)
    rw [hg, hvstdef]; nlinarith
  have hgpos : ∀ p, 0 < g p := fun p => lt_of_lt_of_le hδ8 (hglow p)

  have hq1 : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ × ℝ × ℝ => p.2.1 / p.1) U :=
    (by fun_prop : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ × ℝ × ℝ => p.2.1) U).div contDiffOn_fst
      (fun p hp => (hU1 p hp).ne')
  have hts_s : ContDiffOn ℝ ∞ ts U := by
    rw [show ts = fun p => -(p.2.1 / p.1) from funext hts]; exact hq1.neg
  have hvs_s : ContDiffOn ℝ ∞ vs U := by
    rw [show vs = fun p => p.1 * (1 + (p.2.1 / p.1) ^ 2) from funext hvs]
    exact contDiffOn_fst.mul (contDiffOn_const.add (hq1.pow 2))
  have hζ_s : ContDiffOn ℝ ∞ ζ U := by
    rw [show ζ = _ from funext hζ]
    exact contDiffOn_const.sub (Real.smoothTransition.contDiff.comp_contDiffOn
      (((hvs_s.sub contDiffOn_const).sub contDiffOn_const).div_const _))
  have hζ2_s : ContDiffOn ℝ ∞ ζ2 U := by
    rw [show ζ2 = _ from funext hζ2]
    exact contDiffOn_const.sub (Real.smoothTransition.contDiff.comp_contDiffOn
      (((hvs_s.sub contDiffOn_const).sub contDiffOn_const).div_const _))
  have hg_s : ContDiffOn ℝ ∞ g U := by
    rw [show g = _ from funext hg]
    exact (hζ2_s.mul (contDiffOn_const.sub hvs_s)).add
      ((contDiffOn_const.sub hζ2_s).mul contDiffOn_const)
  have hs_s : ContDiffOn ℝ ∞ s U := by
    rw [show s = _ from funext hs]
    exact hζ_s.mul ((hg_s.div contDiffOn_fst (fun p hp => (hU1 p hp).ne')).sqrt
      (fun p hp => (div_pos (hgpos p) (hU1 p hp)).ne'))
  have hc_s : ContDiffOn ℝ ∞ c U := by
    rw [show c = _ from funext hc]
    exact ((contDiffOn_const.mul
      (by fun_prop : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ × ℝ × ℝ => p.2.2.2) U)).mul hs_s).div_const μ

  obtain ⟨θ, hθs, hθ⟩ := loop_reparam U h Q (fun p => p.1) ts s c hUo hhs hhp hh0 hhsin
    hQdef.symm hQpos.le contDiffOn_fst hts_s hs_s hc_s hU1
  obtain ⟨Dn, hDn⟩ : ∃ D : ℝ × ℝ × ℝ × ℝ → ℝ → ℝ, ∀ p u,
      D p u = (Real.sqrt 2 * Real.sin (2 * Real.pi * u) + c p * h u) /
        Real.sqrt (1 + c p ^ 2 * Q) := ⟨_, fun _ _ => rfl⟩
  have hrpos : ∀ p, 0 < 1 + c p ^ 2 * Q := fun p =>
    add_pos_of_pos_of_nonneg one_pos (mul_nonneg (sq_nonneg _) hQpos.le)
  have hDn_s : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => Dn z.1 z.2) (U ×ˢ univ) := by
    rw [show (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => Dn z.1 z.2) = fun z =>
      (Real.sqrt 2 * Real.sin (2 * Real.pi * z.2) + c z.1 * h z.2) /
        Real.sqrt (1 + c z.1 ^ 2 * Q) from funext fun z => hDn _ _]
    have hc1 : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => c z.1) (U ×ˢ univ) :=
      hc_s.comp contDiffOn_fst (fun z hz => hz.1)
    have hA1 : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ =>
        Real.sqrt 2 * Real.sin (2 * Real.pi * z.2) + c z.1 * h z.2) (U ×ˢ univ) :=
      (contDiffOn_const.mul ((Real.contDiff_sin.comp
        (contDiff_const.mul contDiff_snd)).contDiffOn)).add
        (hc1.mul (hhs.comp contDiff_snd).contDiffOn)
    have hB1 : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ =>
        Real.sqrt (1 + c z.1 ^ 2 * Q)) (U ×ˢ univ) :=
      (contDiffOn_const.add ((hc1.pow 2).mul contDiffOn_const)).sqrt
        (fun z _ => (hrpos z.1).ne')
    exact hA1.div hB1 (fun z _ => (Real.sqrt_pos.mpr (hrpos z.1)).ne')
  have hDnper : ∀ p u, Dn p (u + 1) = Dn p u := by
    intro p u
    rw [hDn, hDn, hhp u, show 2 * Real.pi * (u + 1) = 2 * Real.pi * u + 2 * Real.pi by ring,
      Real.sin_add_two_pi]
  have hmean1 : ∀ p ∈ U, (∫ φ in (0:ℝ)..1, p.1 * (1 + ts p ^ 2 + s p ^ 2) /
      (1 + (ts p + s p * Dn p (θ p φ)) ^ 2)) = p.1 := by
    intro p hp
    simp only [hDn]
    exact (hθ p hp).2.1
  have hmean2 : ∀ p ∈ U, (∫ φ in (0:ℝ)..1, -(ts p + s p * Dn p (θ p φ)) *
      (p.1 * (1 + ts p ^ 2 + s p ^ 2) / (1 + (ts p + s p * Dn p (θ p φ)) ^ 2))) =
