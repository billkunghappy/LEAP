  have hGd := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume) (a := rfpXv P) (b := x)
    (F := fun e s => 2 * s * rfpF P s e)
    (F' := fun e s => 2 * s * (Dx (Real.log s) e / Real.sqrt (2 * s)))
    (x₀ := η) (bound := fun _ => Real.sqrt (2 * x) * (2 * M))
