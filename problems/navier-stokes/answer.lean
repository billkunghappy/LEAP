    have hint0 : IntegrableOn (fun v => w v * rfpE P v 0 ^ 2) (Ioi Y) := by
      refine Integrable.mono'
        (Integrable.const_mul (exp_neg_integrableOn_Ioi Y (show 0 < 2 * P.h by linarith))
          (Real.exp (2 * B)))
        hf0c.aestronglyMeasurable ?_
