        (((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) • ampDG5 B G D Lh γ m ξ +
        ((((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) * (((rhoQ B γ ξ ^ (1/2:ℝ)) : ℝ) : ℂ)) • Lh γ m ξ :=
      congrFun hfun ξ
    have hdA : dVc B γ.1 (fun η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • wmoAmp5 B G D γ m η) ξ =
        (((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) • dVc B γ.1 (ampDG5 B G D Lh γ m) ξ +
        ((((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) * (((rhoQ B γ ξ ^ (1/2:ℝ)) : ℝ) : ℂ)) •
          dVc B γ.1 (Lh γ m) ξ := by
      rw [hfun]
      unfold dVc
      have hs1 : DifferentiableAt ℝ (fun η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) •
          ampDG5 B G D Lh γ m η) ξ := hc1.smul hDdiff
      have hs2 : DifferentiableAt ℝ (fun η => ((((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) *
          (((rhoQ B γ η ^ (1/2:ℝ)) : ℝ) : ℂ)) • Lh γ m η) ξ := hc2.smul hWdiff
      rw [fderiv_fun_add hs1 hs2, fderiv_fun_smul hc1 hDdiff, fderiv_fun_smul hc2 hWdiff]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.smulRight_apply, hz1, hz2, zero_smul, add_zero]
    have hdD : dVc B γ.1 (fun η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • ampDG5 B G D Lh γ m η) ξ =
        (((qC B.h ξ ^ (-Aex B.h)) : ℝ) : ℂ) • dVc B γ.1 (ampDG5 B G D Lh γ m) ξ := by
      unfold dVc
      rw [fderiv_fun_smul hc1 hDdiff]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.smulRight_apply, hz1, zero_smul, add_zero]
    have key : ∀ (h q Q : ℝ), 0 < q → 0 < Q →
        q ^ (2 * Aex h + 1/2) * Q ^ (-(1 + h)) * (q ^ (-Aex h) * (q / Q) ^ (1/2 : ℝ)) =
          (q / Q) ^ (Aex h + 1) ∧
        q ^ (2 * Aex h + 1/2) * Q ^ (-(Aex h + 1/2)) * (q ^ (-Aex h) * (q / Q) ^ (1/2 : ℝ)) =
          (q / Q) ^ (Aex h + 1) ∧
        q ^ (2 * Aex h + 1/2) * Q⁻¹ * (q ^ (-Aex h) * (q / Q) ^ (1/2 : ℝ)) =
          (q / Q) ^ (Aex h + 1) * Q ^ h ∧
        q ^ (2 * Aex h + 1/2) * Q ^ (-(1/2 : ℝ)) * q ^ (-2 * Aex h) = (q / Q) ^ (1/2 : ℝ) := by
      intro h q Q hq hQ
      have hqQ : 0 < q / Q := div_pos hq hQ
      have hinv : Q⁻¹ = Real.exp (-Real.log Q) := by rw [Real.exp_neg, Real.exp_log hQ]
      simp only [Real.rpow_def_of_pos hq, Real.rpow_def_of_pos hQ, Real.rpow_def_of_pos hqQ, hinv,
        Real.log_div hq.ne' hQ.ne', ← Real.exp_add, Aex]
      refine ⟨?_, ?_, ?_, ?_⟩ <;> congr 1 <;> ring
    obtain ⟨R1, R2, R3, R4⟩ := key B.h (qC B.h ξ) (Qb γ.1) hq0 hQ0
    rw [← hρ] at R1 R2 R3 R4
    have C1 := congrArg (fun x : ℝ => (x : ℂ)) R1
    have C2 := congrArg (fun x : ℝ => (x : ℂ)) R2
    have C3 := congrArg (fun x : ℝ => (x : ℂ)) R3
    have C4 := congrArg (fun x : ℝ => (x : ℂ)) R4
    simp only [Complex.ofReal_mul, Complex.ofReal_inv] at C1 C2 C3 C4
    simp only [primOp5, princG5, dDamp5, epsb, hA, hdA, hdD]
    ext i
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Matrix.mulVec_add, Matrix.mulVec_smul,
      Complex.ofReal_mul, Complex.ofReal_div, Complex.ofReal_pow, Complex.ofReal_natCast]
    linear_combination (dVc B γ.1 (Lh γ m) ξ i) * C1
      + ((pulseMatC (Kmat B G γ ξ)).mulVec (Lh γ m ξ) i) * C2
      + (Lh γ m ξ i * (m : ℂ) ^ 2 * (kb B.h γ.1 : ℂ) ^ 2 *
          ((dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) : ℝ) : ℂ)) * C3
      + (nPhiC5 B G γ ξ i * E γ m ξ * Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ)) * C4

  simp only [Pi.sub_apply, Pi.add_apply]
  rw [e7, e8]
  simp only [Pi.add_apply]
  rw [eq_sub_of_add_eq e9]
  abel

theorem slin5_princ_smooth : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (c : WC) (E : WS) (α β : ℝ), InWg5 B G (qsOf l0) α c → InWg5 B G (qsOf l0) β E → ∀ (γ : Lab) (m : ℤ), ContDiffOn ℝ ∞ (princG5 B G c E γ m) (DomC B.h (qsOf l0)) :=
by
  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 c E α β hc hE γ m => ?_⟩
  have hr1 : G.r0 ≤ 1/100 := hG.1.2.1
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 < B.qB := by
    rw [hQb]
    exact lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0
  have hSP : SimScaleProps B.h := hok.1
  have hqcont : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h4 := hSP.2.2.2.1
    have hm : MapsTo (fun η : Cyl => (η.2.1, 1 - η.2.2.1)) {η : Cyl | η.2.2.1 < 1} (univ ×ˢ Ioi 0) := by
      intro η hη
      have hη' : η.2.2.1 < 1 := hη
      exact ⟨mem_univ _, show (0:ℝ) < 1 - η.2.2.1 by linarith⟩
    exact (h4.comp (f := fun η : Cyl => (η.2.1, 1 - η.2.2.1)) (ContDiff.contDiffOn (by fun_prop)) hm).congr
      (fun η _ => rfl)
  have hT1o : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt (by fun_prop) continuous_const
  have hDo : IsOpen (DomC B.h (qsOf l0)) := by
    have e : DomC B.h (qsOf l0) = {η : Cyl | 0 < η.1} ∩
        ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Iio (qsOf l0)) := by
      ext η
      simp only [DomC, mem_setOf_eq, mem_inter_iff, mem_preimage, mem_Iio]
    rw [e]
    exact (isOpen_lt continuous_const continuous_fst).inter
      (hqcont.continuousOn.isOpen_inter_preimage hT1o isOpen_Iio)
  have hqD : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h (qsOf l0)) :=
    hqcont.mono (fun η hη => hη.2.1)
  have hq0D : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ :=
    fun ξ hξ => (hSP.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).1
  have hDsub : ∀ η ∈ DomC B.h (qsOf l0), η ∈ DomC B.h B.qB :=
    fun η hη => ⟨hη.1, hη.2.1, lt_trans hη.2.2 hqsB⟩
  have hWs : ContDiffOn ℝ ∞ (c γ m) (DomC B.h (qsOf l0)) := hc.2.1 γ m
  have hPs : ContDiffOn ℝ ∞ (E γ m) (DomC B.h (qsOf l0)) := hE.2.1 γ m

  have hcast : ∀ (f : Cyl → ℝ) (s : Set Cyl), ContDiffOn ℝ ∞ f s →
      ContDiffOn ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) s := by
    intro f s hf
    exact (Complex.ofRealCLM.contDiff.comp_contDiffOn hf).congr (fun η _ => by simp)
  have transfer : ∀ (O : Set Cyl), IsOpen O → ∀ (f g : Cyl → ℝ) (d : Cyl → Cyl), (∀ η ∈ O, f η = g η) →
      ContDiffOn ℝ ∞ g O → ContDiffOn ℝ ∞ d O → ContDiffOn ℝ ∞ (fun η => fderiv ℝ f η (d η)) O := by
    intro O hO f g d hfg hg hd
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ g) O := ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hg).2
    refine (h1.clm_apply hd).congr ?_
    intro η hη
    have hev : f =ᶠ[nhds η] g := Filter.eventuallyEq_of_mem (hO.mem_nhds hη) hfg
    show fderiv ℝ f η (d η) = fderiv ℝ g η (d η)
    rw [hev.fderiv_eq]

  have hQ : 0 < Qb γ.1 := by unfold Qb; positivity
  have hρs : ∀ e : ℝ, ContDiffOn ℝ ∞ (fun η : Cyl => (((rhoQ B γ η ^ e) : ℝ) : ℂ)) (DomC B.h (qsOf l0)) := by
    intro e
    have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => rhoQ B γ η) (DomC B.h (qsOf l0)) :=
      (hqD.div_const (Qb γ.1)).congr (fun η _ => rfl)
    have h2 : ContDiffOn ℝ ∞ (fun η : Cyl => rhoQ B γ η ^ e) (DomC B.h (qsOf l0)) :=
      h1.rpow_const_of_ne (fun η hη => (div_pos (hq0D η hη) hQ).ne')
    exact hcast _ _ h2
  have hdV : ContDiffOn ℝ ∞ (fun η => dVc B γ.1 (c γ m) η) (DomC B.h (qsOf l0)) := by
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ (c γ m)) (DomC B.h (qsOf l0)) :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hDo).1 hWs).2
    exact (h1.clm_apply contDiffOn_const).congr (fun η _ => rfl)

  have hbase0 : IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} ∧
      ∀ (l : ℕ) (i : Fin 3), ContDiffOn ℝ ∞ (fun s : ℝ × ℝ × ℝ => baseC B l (s.1, s.2.1, s.2.2, ((0:ℝ), (0:ℝ))) i)
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
    obtain ⟨hS, hBP⟩ := hok
    have hsc : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hS.2.2.2.1.continuousOn
    have hA : IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
      have hm : Continuous (fun s : ℝ × ℝ × ℝ => (s.2.1, 1 - s.2.2)) := by fun_prop
      have hc' : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun s : ℝ × ℝ × ℝ => (s.2.1, 1 - s.2.2)))
          {s : ℝ × ℝ × ℝ | s.2.2 < 1} := by
        refine hsc.comp hm.continuousOn ?_
        intro s hs
        have hs' : s.2.2 < 1 := hs
        exact ⟨mem_univ _, show (0:ℝ) < 1 - s.2.2 by linarith⟩
      have hU : IsOpen {s : ℝ × ℝ × ℝ | s.2.2 < 1} := isOpen_lt (by fun_prop) continuous_const
      have h1 := hc'.isOpen_inter_preimage hU (isOpen_Iio (a := B.qB))
      have h2 : IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1} := isOpen_lt continuous_const continuous_fst
      have e : {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} =
          {s : ℝ × ℝ × ℝ | 0 < s.1} ∩ ({s : ℝ × ℝ × ℝ | s.2.2 < 1} ∩
            ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun s : ℝ × ℝ × ℝ => (s.2.1, 1 - s.2.2))) ⁻¹'
              Iio B.qB) := by
        ext s
        simp only [mem_setOf_eq, mem_inter_iff, mem_preimage, mem_Iio, Function.comp]
      rw [e]
      exact h2.inter h1
    have hD : IsOpen (simDomain B.h B.qB) := by
      have hm : Continuous (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)) := by fun_prop
      have hc' : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)))
          {w : ℝ³ × ℝ | w.2 < 1} := by
        refine hsc.comp hm.continuousOn ?_
        intro w hw
        have hw' : w.2 < 1 := hw
        exact ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by linarith⟩
      have hU : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
      have h1 := hc'.isOpen_inter_preimage hU (isOpen_Iio (a := B.qB))
      have e : simDomain B.h B.qB = {w : ℝ³ × ℝ | w.2 < 1} ∩
          ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2))) ⁻¹' Iio B.qB := by
        ext w
        simp only [simDomain, mem_setOf_eq, mem_inter_iff, mem_preimage, mem_Iio, Function.comp]
      rw [e]
      exact h1
    have hu : ContDiffOn ℝ ∞ (↿(uB B)) (simDomain B.h B.qB) := by
      have hAB : ContDiffOn ℝ ∞ (↿B.AB) (simDomain B.h B.qB) := hBP.2.2.2.1.1
      have hBv : ContDiffOn ℝ ∞ (↿B.BvB) (simDomain B.h B.qB) := hBP.2.2.2.1.2.1
      have hDA : ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z) (simDomain B.h B.qB) :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hAB).2
      have hcc : ∀ (v : ℝ³) (j : Fin 3),
          ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z (v, (0:ℝ)) j) (simDomain B.h B.qB) := by
        intro v j
        have h1 : ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z (v, (0:ℝ))) (simDomain B.h B.qB) :=
          hDA.clm_apply contDiffOn_const
        exact (EuclideanSpace.proj j : ℝ³ →L[ℝ] ℝ).contDiff.comp_contDiffOn h1
      let e0 : ℝ³ := EuclideanSpace.single 0 1
      let e1 : ℝ³ := EuclideanSpace.single 1 1
      let e2 : ℝ³ := EuclideanSpace.single 2 1
      have hg : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ =>
          (fderiv ℝ (↿B.AB) z (e1, (0:ℝ)) 2 - fderiv ℝ (↿B.AB) z (e2, (0:ℝ)) 1) •
              EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
          (fderiv ℝ (↿B.AB) z (e2, (0:ℝ)) 0 - fderiv ℝ (↿B.AB) z (e0, (0:ℝ)) 2) •
              EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
          (fderiv ℝ (↿B.AB) z (e0, (0:ℝ)) 1 - fderiv ℝ (↿B.AB) z (e1, (0:ℝ)) 0) •
              EuclideanSpace.single (2 : Fin 3) (1 : ℝ) + (↿B.BvB) z) (simDomain B.h B.qB) := by
        refine ((((hcc e1 2).sub (hcc e2 1)).smul contDiffOn_const).add
          (((hcc e2 0).sub (hcc e0 2)).smul contDiffOn_const)).add
          (((hcc e0 1).sub (hcc e1 0)).smul contDiffOn_const) |>.add hBv
      refine hg.congr ?_
      rintro ⟨y, s⟩ hz
      have hdiff : DifferentiableAt ℝ (↿B.AB) (y, s) :=
        (hAB.contDiffAt (hD.mem_nhds hz)).differentiableAt (by norm_num)
      have hpart : fderiv ℝ (fun w => B.AB w s) y =
          (fderiv ℝ (↿B.AB) (y, s)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := by
        have h1 : HasFDerivAt (fun w : ℝ³ => (w, s)) (ContinuousLinearMap.inl ℝ ℝ³ ℝ) y :=
          hasFDerivAt_prodMk_left y s
        have h2 : HasFDerivAt ((↿B.AB) ∘ (fun w : ℝ³ => (w, s)))
            ((fderiv ℝ (↿B.AB) (y, s)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ)) y :=
          HasFDerivAt.comp (g := ↿B.AB) y hdiff.hasFDerivAt h1
        exact h2.fderiv
      show curl3 (fun w => B.AB w s) y + B.BvB y s = _
      unfold curl3
      rw [hpart]
      simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.inl_apply]
      rfl
    have frame : ∀ r z : ℝ, 0 < r → (rotPt r 0 z) 2 = z ∧
        eR (rotPt r 0 z) = EuclideanSpace.single (0 : Fin 3) (1 : ℝ) ∧
        eTh (rotPt r 0 z) = EuclideanSpace.single (1 : Fin 3) (1 : ℝ) := by
      intro r z hr
      have h0 : (rotPt r 0 z) 0 = r := by simp [rotPt]
      have h1 : (rotPt r 0 z) 1 = 0 := by simp [rotPt]
      have h2 : (rotPt r 0 z) 2 = z := by simp [rotPt]
      have hrad : rad (rotPt r 0 z) = r := by
        unfold rad
        rw [h0, h1]
        simp [Real.sqrt_sq hr.le]
      refine ⟨h2, ?_, ?_⟩
      · unfold eR radVec
        rw [hrad, h0, h1, zero_smul, add_zero, smul_smul, inv_mul_cancel₀ hr.ne', one_smul]
      · unfold eTh azVec
        rw [hrad, h0, h1, neg_zero, zero_smul, zero_add, smul_smul, inv_mul_cancel₀ hr.ne', one_smul]
    let ψ : ℝ × ℝ × ℝ → ℝ³ × ℝ := fun s => (rotPt s.1 0 s.2.1, s.2.2)
    have hψ : ContDiff ℝ ∞ ψ := by
      have hr : ContDiff ℝ ∞ (fun s : ℝ × ℝ × ℝ => rotPt s.1 0 s.2.1) := by
        unfold rotPt
        fun_prop
      exact hr.prodMk (contDiff_snd.comp contDiff_snd)
    have hmaps : MapsTo ψ {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}
        (simDomain B.h B.qB) := by
      intro s hs
      obtain ⟨h1, h2, h3⟩ := hs
      show s.2.2 < 1 ∧ simScale B.h ((rotPt s.1 0 s.2.1) 2) (1 - s.2.2) < B.qB
      rw [(frame s.1 s.2.1 h1).1]
      exact ⟨h2, h3⟩
    refine ⟨hA, fun l i => ?_⟩
    have hcomp : ContDiffOn ℝ ∞ ((↿(uB B)) ∘ ψ)
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} :=
      hu.comp hψ.contDiffOn hmaps
    have hg : ContDiffOn ℝ ∞ (fun s => Qb l ^ (1/2 + B.h) * inner ℝ (((↿(uB B)) ∘ ψ) s)
        ((![EuclideanSpace.single (0 : Fin 3) (1 : ℝ), EuclideanSpace.single (1 : Fin 3) (1 : ℝ), eZ] :
          Fin 3 → ℝ³) i))
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} :=
      contDiffOn_const.mul (ContDiffOn.inner ℝ hcomp contDiffOn_const)
    refine hg.congr ?_
    intro s hs
    obtain ⟨_, f2, f3⟩ := frame s.1 s.2.1 hs.1
    show Qb l ^ (1/2 + B.h) * inner ℝ (uB B (rotPt s.1 0 s.2.1) s.2.2)
        (![eR (rotPt s.1 0 s.2.1), eTh (rotPt s.1 0 s.2.1), eZ] i) = _
    rw [f2, f3]
    rfl
  obtain ⟨_hΩ, hslowS⟩ := hbase0
  have hp : ContDiff ℝ ∞ (fun η : Cyl => ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ)) := by fun_prop
  have hbase : ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => baseC B γ.1 η j) (DomC B.h (qsOf l0)) := by
    intro j
    exact ((hslowS γ.1 j).comp hp.contDiffOn (fun η hη => hDsub η hη)).congr (fun η _ => rfl)
  have hsQ : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr hQ
  have hRC : ContDiff ℝ ∞ (fun η : Cyl => RC γ.1 η) := by
    unfold RC; fun_prop
  have hRCne : ∀ η ∈ DomC B.h (qsOf l0), RC γ.1 η ≠ 0 := by
    intro η hη
    unfold RC
    exact (div_pos hη.1 hsQ).ne'
  have hchartZ : ContDiff ℝ ∞ (fun η : Cyl => chartZ B.h γ.1 η) := by
    unfold chartZ; fun_prop
  have hFang : ContDiffOn ℝ ∞ (fun η : Cyl => Fang B γ.1 η) (DomC B.h (qsOf l0)) :=
    ((hbase 1).div hRC.contDiffOn hRCne).congr (fun η _ => rfl)
  have hdR : ContDiffOn ℝ ∞ (fun η : Cyl =>
      (((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv) : Cyl)) (DomC B.h (qsOf l0)) := by
    have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ (drx B.h - 1)) (DomC B.h (qsOf l0)) :=
      contDiffOn_fst.rpow_const_of_ne (fun η hη => hη.1.ne')
    exact contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk
      ((contDiffOn_const.mul h1).smul contDiffOn_const)))
  have hK : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => Kmat B G γ η i j) (DomC B.h (qsOf l0)) := by
    intro i j
    fin_cases i <;> fin_cases j
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) (DomC B.h (qsOf l0))
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun η : Cyl => -2 * Fang B γ.1 η) (DomC B.h (qsOf l0))
      exact contDiffOn_const.mul hFang
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) (DomC B.h (qsOf l0))
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun η : Cyl => 2 * Fang B γ.1 η + RC γ.1 η * (Real.sqrt (Qb γ.1) *
        fderiv ℝ (Fang B γ.1) η ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv)))
        (DomC B.h (qsOf l0))
      exact (contDiffOn_const.mul hFang).add (hRC.contDiffOn.mul (contDiffOn_const.mul
        (transfer _ hDo (Fang B γ.1) (Fang B γ.1) _ (fun _ _ => rfl) hFang hdR)))
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) (DomC B.h (qsOf l0))
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) (DomC B.h (qsOf l0))
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun η : Cyl => Real.sqrt (Qb γ.1) *
        fderiv ℝ (fun η => baseC B γ.1 η 2) η ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv))
        (DomC B.h (qsOf l0))
      exact contDiffOn_const.mul (transfer _ hDo _ _ _ (fun _ _ => rfl) (hbase 2) hdR)
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) (DomC B.h (qsOf l0))
      exact contDiffOn_const
    · show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) (DomC B.h (qsOf l0))
      exact contDiffOn_const

  have hbgc : 0 ≤ bgc ∧ bgc < 1/2 := by
    have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
    have hs2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    unfold bgc
    constructor <;> nlinarith
  have hDen : (1 + bgc ^ 2) ≠ 0 := by positivity
  have hinv : ∀ w : ℝ × ℝ, w.1 = lamR w + bgc * lamT w ∧ w.2 = lamT w - bgc * lamR w := by
    intro w
    constructor
    · have e : lamR w + bgc * lamT w = (w.1 - bgc * w.2 + bgc * (bgc * w.1 + w.2)) / (1 + bgc ^ 2) := by
        unfold lamR lamT; ring
      rw [e, eq_div_iff hDen]; ring
    · have e : lamT w - bgc * lamR w = (bgc * w.1 + w.2 - bgc * (w.1 - bgc * w.2)) / (1 + bgc ^ 2) := by
        unfold lamR lamT; ring
      rw [e, eq_div_iff hDen]; ring
  have hsmall : ∀ Y : ℝ × ℝ, inRect B.h γ (G.ctr γ) (2 * G.r0) Y →
      |(rectW B.h γ (G.ctr γ) Y).1| ≤ 3/100 ∧ |(rectW B.h γ (G.ctr γ) Y).2| ≤ 3/100 := by
    intro Y hR
    obtain ⟨w, hw⟩ : ∃ w : ℝ × ℝ, w = rectW B.h γ (G.ctr γ) Y := ⟨_, rfl⟩
    rw [← hw]
    have hx : |lamR w| ≤ 2 * G.r0 := by rw [hw]; exact hR.1
    have he : |lamT w| ≤ 2 * G.r0 := by rw [hw]; exact hR.2
    obtain ⟨i1, i2⟩ := hinv w
    have hb1 : |bgc * lamT w| ≤ 1/2 * (2 * G.r0) := by
      rw [abs_mul, abs_of_nonneg hbgc.1]
      exact mul_le_mul hbgc.2.le he (abs_nonneg _) (by norm_num)
    have hb2 : |bgc * lamR w| ≤ 1/2 * (2 * G.r0) := by
      rw [abs_mul, abs_of_nonneg hbgc.1]
      exact mul_le_mul hbgc.2.le hx (abs_nonneg _) (by norm_num)
    obtain ⟨a1, a2⟩ := abs_le.mp hx
    obtain ⟨b1, b2⟩ := abs_le.mp he
    obtain ⟨c1, c2⟩ := abs_le.mp hb1
    obtain ⟨d1, d2⟩ := abs_le.mp hb2
    constructor
    · rw [i1]; exact abs_le.mpr ⟨by linarith, by linarith⟩
    · rw [i2]; exact abs_le.mpr ⟨by linarith, by linarith⟩
  have hfar : ∀ (a b : ℝ), 1/12 ≤ |a - ((round a : ℤ) : ℝ)| → |b - a| < 1/24 →
      1/24 < |b - ((round b : ℤ) : ℝ)| := by
    intro a b ha hb
    have h1 : |a - ((round a : ℤ) : ℝ)| ≤ |a - ((round b : ℤ) : ℝ)| := round_le a (round b)
    have h2 : |a - ((round b : ℤ) : ℝ)| ≤ |a - b| + |b - ((round b : ℤ) : ℝ)| := abs_sub_le a b _
    have h3 : |a - b| = |b - a| := abs_sub_comm a b
    linarith
  have hJc : Continuous (fun Y' : ℝ × ℝ => Jpow (bandIdx B.h γ.1) Y' - G.ctr γ) := by
    unfold Jpow; fun_prop
  have hJη : Continuous (fun η : Cyl => Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ) :=
    hJc.comp (by fun_prop)

  apply contDiffOn_of_locally_contDiffOn
  intro ξ0 hξ0
  by_cases hgood : |(rectW B.h γ (G.ctr γ) ξ0.2.2.2).1| < 1/12 ∧ |(rectW B.h γ (G.ctr γ) ξ0.2.2.2).2| < 1/12
  ·
    obtain ⟨K1, hK1⟩ : ∃ K : ℤ, K = round ((Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).1) := ⟨_, rfl⟩
    obtain ⟨K2, hK2⟩ : ∃ K : ℤ, K = round ((Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).2) := ⟨_, rfl⟩
    have hw1e : (rectW B.h γ (G.ctr γ) ξ0.2.2.2).1 = (Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).1 - (K1 : ℝ) := by
      rw [hK1]; rfl
    have hw2e : (rectW B.h γ (G.ctr γ) ξ0.2.2.2).2 = (Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).2 - (K2 : ℝ) := by
      rw [hK2]; rfl
    have hround : ∀ (x : ℝ) (K : ℤ), |x - (K : ℝ)| < 1/2 → round x = K := by
      intro x K hx
      rw [round_eq, Int.floor_eq_iff]
      obtain ⟨a, b⟩ := abs_lt.mp hx
      constructor <;> linarith
    obtain ⟨V, hV⟩ : ∃ V : Set (ℝ × ℝ), V =
        {Y' : ℝ × ℝ | |(Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).1 - (K1 : ℝ)| < 1/2} ∩
        {Y' : ℝ × ℝ | |(Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).2 - (K2 : ℝ)| < 1/2} := ⟨_, rfl⟩
    have hVo : IsOpen V := by
      rw [hV]
      exact (isOpen_lt ((hJc.fst).sub continuous_const).abs continuous_const).inter
        (isOpen_lt ((hJc.snd).sub continuous_const).abs continuous_const)
    have hYV : ξ0.2.2.2 ∈ V := by
      rw [hV]
      refine ⟨?_, ?_⟩
      · show |(Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).1 - (K1 : ℝ)| < 1/2
        rw [← hw1e]; exact lt_trans hgood.1 (by norm_num)
      · show |(Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).2 - (K2 : ℝ)| < 1/2
        rw [← hw2e]; exact lt_trans hgood.2 (by norm_num)
    have hfr : ∀ Y' ∈ V, rectW B.h γ (G.ctr γ) Y' =
        Jpow (bandIdx B.h γ.1) Y' - G.ctr γ - ((K1 : ℝ), (K2 : ℝ)) := by
      intro Y' hY'
      rw [hV] at hY'
      have r1 : round ((Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).1) = K1 := hround _ _ hY'.1
      have r2 : round ((Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).2) = K2 := hround _ _ hY'.2
      unfold rectW frac0
      rw [r1, r2]
      ext <;> simp
    obtain ⟨U, hU⟩ : ∃ U : Set Cyl, U = (fun η : Cyl => η.2.2.2) ⁻¹' V := ⟨_, rfl⟩
    have hUo : IsOpen U := by
      rw [hU]
      exact hVo.preimage (by fun_prop)
    have hξU : ξ0 ∈ U := by rw [hU]; exact hYV
    have hUV : ∀ η ∈ U, η.2.2.2 ∈ V := by
      intro η hη
      rw [hU] at hη
      exact hη
    have hTo : IsOpen (DomC B.h (qsOf l0) ∩ U) := hDo.inter hUo

    have hv : ContDiff ℝ ∞ (fun η : Cyl =>
        (lamT (Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ - ((K1 : ℝ), (K2 : ℝ))) + G.r0) / cib B.h γ.1) := by
      unfold lamT Jpow; fun_prop
    obtain ⟨φt, hφt⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl => pzr5 B G γ * chartZ B.h γ.1 η / epsb B.h γ.1 +
        sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 * RC γ.1 η -
        ((lamT (Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ - ((K1 : ℝ), (K2 : ℝ))) + G.r0) / cib B.h γ.1) *
          (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2) := ⟨_, rfl⟩
    have hφ : ContDiffOn ℝ ∞ φt (DomC B.h (qsOf l0)) := by
      rw [hφt]
      exact (((contDiffOn_const.mul hchartZ.contDiffOn).div_const _).add
        (contDiffOn_const.mul hRC.contDiffOn)).sub
        (hv.contDiffOn.mul ((contDiffOn_const.mul hFang).add (contDiffOn_const.mul (hbase 2))))
    have hEq : ∀ η ∈ U, phiL5 B G γ η = φt η := by
      intro η hη
      rw [hφt]
      simp only [phiL5, vco, etG, hfr _ (hUV η hη)]
    have hN : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhi5 B G γ η i) (DomC B.h (qsOf l0) ∩ U) := by
      intro i
      fin_cases i
      · show ContDiffOn ℝ ∞ (fun η : Cyl => Real.sqrt (Qb γ.1) *
          fderiv ℝ (phiL5 B G γ) η ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv))
          (DomC B.h (qsOf l0) ∩ U)
        exact contDiffOn_const.mul (transfer _ hTo _ φt _ (fun η hη => hEq η hη.2)
          (hφ.mono Set.inter_subset_left) (hdR.mono Set.inter_subset_left))
      · show ContDiffOn ℝ ∞ (fun η : Cyl => pang5 B G γ / RC γ.1 η) (DomC B.h (qsOf l0) ∩ U)
        exact contDiffOn_const.div hRC.contDiffOn (fun η hη => hRCne η hη.1)
      · show ContDiffOn ℝ ∞ (fun η : Cyl => Real.sqrt (Qb γ.1) *
          fderiv ℝ (phiL5 B G γ) η (((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ)) : Cyl)) (DomC B.h (qsOf l0) ∩ U)
        exact contDiffOn_const.mul (transfer _ hTo _ φt (fun _ => (((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ)) : Cyl))
          (fun η hη => hEq η hη.2) (hφ.mono Set.inter_subset_left) contDiffOn_const)

    have hWT : ContDiffOn ℝ ∞ (c γ m) (DomC B.h (qsOf l0) ∩ U) := hWs.mono Set.inter_subset_left
    have hPT : ContDiffOn ℝ ∞ (E γ m) (DomC B.h (qsOf l0) ∩ U) :=
      hPs.mono Set.inter_subset_left
    have hρT : ∀ e : ℝ, ContDiffOn ℝ ∞ (fun η : Cyl => (((rhoQ B γ η ^ e) : ℝ) : ℂ)) (DomC B.h (qsOf l0) ∩ U) :=
      fun e => (hρs e).mono Set.inter_subset_left
    have hdVT : ContDiffOn ℝ ∞ (fun η => dVc B γ.1 (c γ m) η) (DomC B.h (qsOf l0) ∩ U) :=
      hdV.mono Set.inter_subset_left
    have hKT : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => Kmat B G γ η i j) (DomC B.h (qsOf l0) ∩ U) :=
      fun i j => (hK i j).mono Set.inter_subset_left
    have hmv : ContDiffOn ℝ ∞ (fun η => (pulseMatC (Kmat B G γ η)).mulVec (c γ m η))
        (DomC B.h (qsOf l0) ∩ U) := by
      apply contDiffOn_pi.2
      intro i
      have h1 : ContDiffOn ℝ ∞ (fun η => ∑ j : Fin 3, ((Kmat B G γ η i j : ℝ) : ℂ) * c γ m η j)
          (DomC B.h (qsOf l0) ∩ U) :=
        ContDiffOn.sum (fun j _ => (hcast _ _ (hKT i j)).mul (contDiffOn_pi.1 hWT j))
      exact h1.congr (fun η _ => rfl)
    have hdd : ContDiffOn ℝ ∞ (fun η => dDamp5 B G γ η) (DomC B.h (qsOf l0) ∩ U) := by
      have h1 : ContDiffOn ℝ ∞ (fun η => epsb B.h γ.1 * ((kb B.h γ.1 : ℝ)) ^ 2 *
          ∑ i : Fin 3, nPhi5 B G γ η i * nPhi5 B G γ η i) (DomC B.h (qsOf l0) ∩ U) :=
        contDiffOn_const.mul (ContDiffOn.sum (fun i _ => (hN i).mul (hN i)))
      exact h1.congr (fun η _ => rfl)
    have hnc : ContDiffOn ℝ ∞ (fun η => nPhiC5 B G γ η) (DomC B.h (qsOf l0) ∩ U) :=
      contDiffOn_pi.2 (fun i => hcast _ _ (hN i))
    have hfin : ContDiffOn ℝ ∞ (fun η => (((rhoQ B γ η ^ (Aex B.h + 1)) : ℝ) : ℂ) •
        (dVc B γ.1 (c γ m) η + (pulseMatC (Kmat B G γ η)).mulVec (c γ m η)
          + ((m : ℂ) ^ 2 * ((dDamp5 B G γ η : ℝ) : ℂ)) • c γ m η)
        + ((((rhoQ B γ η ^ (1/2 : ℝ)) : ℝ) : ℂ) * (Complex.I * (kb B.h γ.1 : ℂ) * (m : ℂ))
          * E γ m η) • nPhiC5 B G γ η) (DomC B.h (qsOf l0) ∩ U) :=
      ((hρT _).smul ((hdVT.add hmv).add ((contDiffOn_const.mul (hcast _ _ hdd)).smul hWT))).add
        ((((hρT _).mul contDiffOn_const).mul hPT).smul hnc)
    exact ⟨U, hUo, hξU, hfin.congr (fun η _ => rfl)⟩
  ·
    have hfarN : ∃ N : Set Cyl, IsOpen N ∧ ξ0 ∈ N ∧
        ∀ η ∈ N, ¬ inRect B.h γ (G.ctr γ) (2 * G.r0) η.2.2.2 := by
      rw [not_and_or, not_lt, not_lt] at hgood
      rcases hgood with h1 | h1
      · refine ⟨{η : Cyl | |(Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ).1 -
            (Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).1| < 1/24},
          isOpen_lt (hJη.fst.sub continuous_const).abs continuous_const, by simp, ?_⟩
        intro η hη hR
        have e1 : 1/12 ≤ |(Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).1 -
            ((round (Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).1 : ℤ) : ℝ)| := h1
        have e2 : |(Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ).1 -
            ((round (Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ).1 : ℤ) : ℝ)| ≤ 3/100 := (hsmall _ hR).1
        have e3 := hfar _ _ e1 hη
        linarith
      · refine ⟨{η : Cyl | |(Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ).2 -
            (Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).2| < 1/24},
          isOpen_lt (hJη.snd.sub continuous_const).abs continuous_const, by simp, ?_⟩
        intro η hη hR
        have e1 : 1/12 ≤ |(Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).2 -
            ((round (Jpow (bandIdx B.h γ.1) ξ0.2.2.2 - G.ctr γ).2 : ℤ) : ℝ)| := h1
        have e2 : |(Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ).2 -
            ((round (Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ).2 : ℤ) : ℝ)| ≤ 3/100 := (hsmall _ hR).2
        have e3 := hfar _ _ e1 hη
        linarith
    obtain ⟨N, hNo, hξ0N, hNR⟩ := hfarN
    have hr0 : 0 < G.r0 := hG.1.1
    have hSR : ∀ η : Cyl, SuppW B G γ η → inRect B.h γ (G.ctr γ) (2 * G.r0) η.2.2.2 := by
      intro η hS
      have hx : |xiG B.h γ (G.ctr γ) η.2.2.2| ≤ G.r0 / 4 := hS.2.2.1
      have he : |etG B.h γ (G.ctr γ) η.2.2.2| ≤ G.r0 := hS.2.2.2.1
      exact ⟨le_trans hx (by linarith), le_trans he (by linarith)⟩
    have hO : IsOpen (DomC B.h (qsOf l0) ∩ N) := hDo.inter hNo
    have hcz : ∀ η ∈ DomC B.h (qsOf l0) ∩ N, c γ m η = 0 := by
      intro η hη
      by_contra hne
      exact hNR η hη.2 (hSR η (hc.2.2.2.1 γ m η hη.1 hne))
    have hEz : ∀ η ∈ DomC B.h (qsOf l0) ∩ N, E γ m η = 0 := by
      intro η hη
      by_contra hne
      exact hNR η hη.2 (hSR η (hE.2.2.2.1 γ m η hη.1 hne))
    have hd0 : ∀ η ∈ DomC B.h (qsOf l0) ∩ N, dVc B γ.1 (c γ m) η = 0 := by
      intro η hη
      have hev : c γ m =ᶠ[nhds η] fun _ => (0 : Fin 3 → ℂ) :=
        Filter.eventuallyEq_of_mem (hO.mem_nhds hη) hcz
      unfold dVc
      rw [hev.fderiv_eq]
      simp
    have hz : ∀ η ∈ DomC B.h (qsOf l0) ∩ N, princG5 B G c E γ m η = 0 := by
      intro η hη
      unfold princG5
      rw [hd0 η hη, hcz η hη, hEz η hη]
      simp
    exact ⟨N, hNo, hξ0N, (contDiffOn_const (c := (0 : Fin 3 → ℂ))).congr (fun η hη => hz η hη)⟩

theorem pulse_princ_cancel_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (α : ℝ) (f tw : WC) (pr : WS), B.ok → InWg5 B G (qsOf l0) α f → PulseSol5 B G l0 α f tw pr → ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), princG5 B G (cutA B G tw) (cutS B G pr) γ m ξ + f γ m ξ = (((rhoQ B γ ξ ^ (Aex B.h + 1)) : ℝ) : ℂ) • (dVc B γ.1 (cutA B G tw γ m) ξ - (pulseMatC (APhi5 B G γ ξ)).mulVec (cutA B G tw γ m ξ) + ((m : ℂ) ^ 2 * ((dDamp5 B G γ ξ : ℝ) : ℂ)) • cutA B G tw γ m ξ + ((psiW B G γ ξ : ℝ) : ℂ) • projT5 B G γ ξ (srcHat B f γ m ξ) + ((1 - psiW B G γ ξ : ℝ) : ℂ) • srcHat B f γ m ξ) :=
by
  intro B G l0 α f tw pr hok hf hP γ m ξ hξ
  obtain ⟨-, -, hP3, -, -, hP6, -, -⟩ := hP
  have hq : 0 < qC B.h ξ := by
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hpos : ∀ z t : ℝ, t < 1 → 0 < simScale B.h z (1 - t) := fun z t ht =>
      (hok.1.1 z (1 - t) (by linarith)).1
    exact hpos ξ.2.1 ξ.2.2.1 hξ'.2.1
  have hQ : 0 < Qb γ.1 := by unfold Qb; positivity
  have hρ : 0 < rhoQ B γ ξ := div_pos hq hQ
  have hag : (((rhoQ B γ ξ ^ (Aex B.h + 1)) : ℝ) : ℂ) *
      (((rhoQ B γ ξ ^ (-(Aex B.h + 1))) : ℝ) : ℂ) = 1 := by
    rw [← Complex.ofReal_mul, ← Real.rpow_add hρ]; simp
  have hbe : (((rhoQ B γ ξ ^ (1/2:ℝ)) : ℝ) : ℂ) * (((rhoQ B γ ξ ^ (Aex B.h + 1/2)) : ℝ) : ℂ) =
      (((rhoQ B γ ξ ^ (Aex B.h + 1)) : ℝ) : ℂ) := by
    rw [← Complex.ofReal_mul, ← Real.rpow_add hρ]; congr 2; ring
  have hkb : (kb B.h γ.1 : ℂ) ≠ 0 := by
    rw [Nat.cast_ne_zero]
    apply Nat.pos_iff_ne_zero.mp
    unfold kb epsb
    exact Nat.ceil_pos.mpr (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos hQ _) _)
  have hMat : ∀ (nr np : Fin 3 → ℝ) (Km : Matrix (Fin 3) (Fin 3) ℝ) (d : ℝ) (v : Fin 3 → ℂ),
      (pulseMatC (-Km + d • Matrix.vecMulVec nr (Matrix.vecMul nr Km - np))).mulVec v =
      -((pulseMatC Km).mulVec v) +
        ((dotProduct (Matrix.vecMul (fun i => (nr i : ℂ)) (pulseMatC Km)) v
          - dotProduct (fun i => (np i : ℂ)) v) * (d : ℂ)) • (fun i => (nr i : ℂ)) := by
    intro nr np Km d v
    ext i
    simp only [pulseMatC, Matrix.mulVec, dotProduct, Matrix.map_apply, Matrix.add_apply,
      Matrix.neg_apply, Matrix.smul_apply, Matrix.vecMulVec_apply, Matrix.vecMul, Pi.sub_apply,
      Pi.add_apply, Pi.neg_apply, Pi.smul_apply, smul_eq_mul, Fin.sum_univ_three]
    push_cast
    ring
  have hA : ∀ v, (pulseMatC (APhi5 B G γ ξ)).mulVec v =
      -((pulseMatC (Kmat B G γ ξ)).mulVec v) +
        ((dotProduct (Matrix.vecMul (nPhiC5 B G γ ξ) (pulseMatC (Kmat B G γ ξ))) v
          - dotProduct (fun i => ((nPhiP5 B G γ ξ i : ℝ) : ℂ)) v) * (nsqC5 B G γ ξ)⁻¹) •
          nPhiC5 B G γ ξ := by
    intro v
    have h := hMat (nPhi5 B G γ ξ) (nPhiP5 B G γ ξ) (Kmat B G γ ξ)
      (dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ))⁻¹ v
    rw [Complex.ofReal_inv] at h
    exact h
  have key : ∀ (a b e g ψ μ N k M I' : ℂ) (n n' t F V : Fin 3 → ℂ)
      (K : Matrix (Fin 3) (Fin 3) ℂ),
      a * g = 1 → b * e = a → I' * I' = -1 → (k * M) * (k * M)⁻¹ = 1 →
      a • (V + K.mulVec (ψ • t) + μ • (ψ • t)) +
        (b * (I' * k * M) * (ψ * (e * (I' / (k * M)) *
          ((dotProduct n (K.mulVec t) - dotProduct n' t + dotProduct n (g • F)) / N)))) • n + F
      = a • (V - (-(K.mulVec (ψ • t)) +
          ((dotProduct (Matrix.vecMul n K) (ψ • t) - dotProduct n' (ψ • t)) * N⁻¹) • n)
        + μ • (ψ • t) + ψ • ((g • F) - (dotProduct n (g • F) / N) • n) + (1 - ψ) • (g • F)) := by
    intro a b e g ψ μ N k M I' n n' t F V K hag hbe hI hκ
    simp only [Matrix.mulVec_smul, dotProduct_smul, smul_eq_mul]
    rw [← Matrix.dotProduct_mulVec]
    ext i
    simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, Pi.neg_apply, smul_eq_mul]
    linear_combination
      (ψ * (dotProduct n (K.mulVec t) - dotProduct n' t + g * dotProduct n F) / N * n i * I' * I' *
        ((k * M) * (k * M)⁻¹)) * hbe
      + (ψ * (dotProduct n (K.mulVec t) - dotProduct n' t + g * dotProduct n F) / N * n i * a *
        ((k * M) * (k * M)⁻¹)) * hI
      - (ψ * (dotProduct n (K.mulVec t) - dotProduct n' t + g * dotProduct n F) / N * n i * a) * hκ
      - F i * hag
  simp only [princG5]
  generalize dVc B γ.1 (cutA B G tw γ m) ξ = V
  by_cases hm : m = 0
  · subst hm
    obtain ⟨ht0, hp0⟩ := hP3 γ 0 rfl
    obtain ⟨H, hH0, hH⟩ := hf.1
    have hf0 : f γ 0 = 0 := hH γ 0 hH0
    simp [cutA, cutS, srcHat, projT5, ht0, hp0, hf0]
  · rw [hA]
    have hp := hP6 γ m hm ξ hξ
    simp only [cutS]
    rw [hp]
    simp only [cutA, srcHat, projT5]
    rw [Complex.ofReal_sub, Complex.ofReal_one]
    exact key _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hag hbe Complex.I_mul_I
      (mul_inv_cancel₀ (mul_ne_zero hkb (Int.cast_ne_zero.mpr hm)))

theorem pulse_tau_flat_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (Bo : ℝ) (f tw : WC) (pr : WS) (τ : WC), InWg5 B G (qsOf l0) Bo f → PulseSol5 B G l0 Bo f tw pr → (∀ γ m, ContDiffOn ℝ ∞ (τ γ m) (DomC B.h (qsOf l0))) → (∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), τ γ m ξ = (((rhoQ B γ ξ ^ (Aex B.h + 1)) : ℝ) : ℂ) • (dVc B γ.1 (cutA B G tw γ m) ξ - (pulseMatC (APhi5 B G γ ξ)).mulVec (cutA B G tw γ m ξ) + ((m : ℂ) ^ 2 * ((dDamp5 B G γ ξ : ℝ) : ℂ)) • cutA B G tw γ m ξ + ((psiW B G γ ξ : ℝ) : ℂ) • projT5 B G γ ξ (srcHat B f γ m ξ) + ((1 - psiW B G γ ξ : ℝ) : ℂ) • srcHat B f γ m ξ)) → ∀ k N : ℕ, ∃ C : ℝ, ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ‖iteratedFDeriv ℝ k (τ γ m) ξ‖ ≤ C * qC B.h ξ ^ (N : ℝ) :=
by
  intro B G hok hG
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨⟨hr0, -, -, -, hlmin⟩, -⟩ := id hG
  obtain ⟨lp, hp⟩ := pulse_support_good_v5 B G hok hG
  obtain ⟨lg, hg⟩ := band_coarse_gap_v5 B.h hh0 hh1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  obtain ⟨Mj, -, hMj⟩ := psiw_jet_v5 B G hok hG 0
  obtain ⟨hrsm, hrnb⟩ := rhoQ_rpow_nb_v5 B hok (Aex B.h + 1)
  choose Kf hKf using hrnb
  obtain ⟨C0, hC01, hpl0⟩ := nbg5_plain_le_nb B.h hh0 hh1
  refine ⟨lp + lg + n0 + 8, ?_⟩
  intro l0 hl0 Bo f tw pr τ hf hPS hτs hτid k N

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 < B.qB := by
    rw [hQb]
    exact lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0
  have hqs256 : qsOf l0 ≤ 1/256 := by
    rw [hQb]
    calc (1/2:ℝ) ^ l0 ≤ (1/2) ^ 8 := pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
      _ = 1/256 := by norm_num
  obtain ⟨hDo, hqsm, hqpos, -⟩ := domc_open_calculus B (qsOf l0) hok

  have hFa : ∀ j M : ℕ, ∃ Cc : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      NB B.h (fun η => ((psiWd B G γ η : ℝ) : ℂ) • tw γ m η) j ξ ≤ Cc * qC B.h ξ ^ (M : ℝ) :=
    hPS.2.2.2.2.2.2.1
  have hFb : ∀ j M : ℕ, ∃ Cc : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      NB B.h (fun η => ((1 - psiW B G γ η : ℝ) : ℂ) • srcHat B f γ m η) j ξ ≤ Cc * qC B.h ξ ^ (M : ℝ) :=
    hPS.2.2.2.2.2.2.2
  choose Ca hCa using hFa
  choose Cb hCb using hFb
  obtain ⟨K, hKdef⟩ : ∃ K : ℝ, K = ∑ i ∈ Finset.range (k + 1), |Kf i| := ⟨_, rfl⟩
  obtain ⟨A0, hA0def⟩ : ∃ A0 : ℝ, A0 = ∑ j ∈ Finset.range (k + 1), (|Ca j (N + 3 * k)| + |Cb j (N + 3 * k)|) :=
    ⟨_, rfl⟩
  have hK0 : 0 ≤ K := by rw [hKdef]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have hA00 : 0 ≤ A0 := by rw [hA0def]; exact Finset.sum_nonneg (fun i _ => by positivity)
  obtain ⟨C, hCdef⟩ : ∃ C : ℝ, C = C0 ^ k * 2 ^ k * K * A0 := ⟨_, rfl⟩
  have hCnn : 0 ≤ C := by
    rw [hCdef]
    have : 0 ≤ C0 ^ k := pow_nonneg (by linarith) _
    positivity
  have hchoose : (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ)) = 2 ^ k := by
    exact_mod_cast Nat.sum_range_choose k

  have key : ∀ (γ : Lab) (F Fa Fb : Cyl → (Fin 3 → ℂ)) (ζ : Cyl) (V : Set Cyl), IsOpen V → ζ ∈ V →
      V ⊆ DomC B.h (qsOf l0) → 1/4 < qC B.h ζ / Qb γ.1 → qC B.h ζ / Qb γ.1 < 4 →
      ContDiffOn ℝ ∞ Fa V → ContDiffOn ℝ ∞ Fb V →
      (∀ j, NB B.h Fa j ζ ≤ Ca j (N + 3 * k) * qC B.h ζ ^ ((N + 3 * k : ℕ) : ℝ)) →
      (∀ j, NB B.h Fb j ζ ≤ Cb j (N + 3 * k) * qC B.h ζ ^ ((N + 3 * k : ℕ) : ℝ)) →
      (∀ y ∈ V, F y = (((rhoQ B γ y ^ (Aex B.h + 1)) : ℝ) : ℂ) • (Fa y + Fb y)) →
      ‖iteratedFDeriv ℝ k F ζ‖ ≤ C * qC B.h ζ ^ (N : ℝ) := by
    intro γ F Fa Fb ζ V hV hζ hVD hw1 hw2 hFaS hFbS hFaB hFbB hgerm
    have hζD : 0 < ζ.1 ∧ ζ.2.2.1 < 1 ∧ qC B.h ζ < qsOf l0 := hVD hζ
    have hq0 : 0 < qC B.h ζ := hqpos ζ (hVD hζ)
    have hq1 : qC B.h ζ < 1 := by linarith [hζD.2.2]
    have hn : V ∈ nhds ζ := hV.mem_nhds hζ
    have hrV : ContDiffOn ℝ ∞ (fun y => rhoQ B γ y ^ (Aex B.h + 1)) V := fun y hy =>
      (hrsm γ y (show 0 < y.1 ∧ y.2.2.1 < 1 ∧ qC B.h y < qsOf l0 from hVD hy).2.1).contDiffWithinAt
    have hev : F =ᶠ[nhds ζ] (fun y => rhoQ B γ y ^ (Aex B.h + 1) • (Fa + Fb) y) :=
      Filter.eventuallyEq_of_mem hn (fun y hy => (hgerm y hy).trans (Complex.coe_smul _ _))
    have hNBeq : NB B.h F k ζ = NB B.h (fun y => rhoQ B γ y ^ (Aex B.h + 1) • (Fa + Fb) y) k ζ := by
      unfold NB
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    have hleib := nb_smul_leibniz_v5 B.h (fun y => rhoQ B γ y ^ (Aex B.h + 1)) (Fa + Fb) V ζ hV hζ hrV
      (hFaS.add hFbS) k
    have hΦ : ∀ j, NB B.h (Fa + Fb) j ζ ≤ NB B.h Fa j ζ + NB B.h Fb j ζ := by
      intro j
      unfold NB
      rw [iteratedFDeriv_add_apply ((hFaS.contDiffAt hn).of_le (by exact_mod_cast le_top))
        ((hFbS.contDiffAt hn).of_le (by exact_mod_cast le_top))]
      have e2 : (iteratedFDeriv ℝ j Fa ζ + iteratedFDeriv ℝ j Fb ζ).compContinuousLinearMap
            (fun _ => Lnorm B.h ζ) =
          (iteratedFDeriv ℝ j Fa ζ).compContinuousLinearMap (fun _ => Lnorm B.h ζ) +
          (iteratedFDeriv ℝ j Fb ζ).compContinuousLinearMap (fun _ => Lnorm B.h ζ) := by
        ext v
        simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      rw [e2]
      exact norm_add_le _ _
    have hqN : 0 ≤ qC B.h ζ ^ ((N + 3 * k : ℕ) : ℝ) := Real.rpow_nonneg hq0.le _
    have hA : ∀ j ≤ k, NB B.h (Fa + Fb) j ζ ≤ A0 * qC B.h ζ ^ ((N + 3 * k : ℕ) : ℝ) := by
      intro j hj
      have h1 := mul_le_mul_of_nonneg_right (le_abs_self (Ca j (N + 3 * k))) hqN
      have h2 := mul_le_mul_of_nonneg_right (le_abs_self (Cb j (N + 3 * k))) hqN
      have hs : |Ca j (N + 3 * k)| + |Cb j (N + 3 * k)| ≤ A0 := by
        rw [hA0def]
        exact Finset.single_le_sum (f := fun j => |Ca j (N + 3 * k)| + |Cb j (N + 3 * k)|)
          (fun i _ => by positivity) (Finset.mem_range.mpr (by omega))
      have h3 := mul_le_mul_of_nonneg_right hs hqN
      have h4 := hΦ j
      have h5 := hFaB j
      have h6 := hFbB j
      nlinarith
    have hKb : ∀ i ≤ k, NB B.h (fun y => rhoQ B γ y ^ (Aex B.h + 1)) i ζ ≤ K := by
      intro i hi
      refine le_trans (hKf i γ ζ hζD.2.1 hq1.le hw1 hw2) (le_trans (le_abs_self _) ?_)
      rw [hKdef]
      exact Finset.single_le_sum (f := fun i => |Kf i|) (fun i _ => abs_nonneg _)
        (Finset.mem_range.mpr (by omega))
    have hS : ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB B.h (fun y => rhoQ B γ y ^ (Aex B.h + 1)) i ζ *
        NB B.h (Fa + Fb) (k - i) ζ ≤ 2 ^ k * K * A0 * qC B.h ζ ^ ((N + 3 * k : ℕ) : ℝ) := by
      calc _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (K * (A0 * qC B.h ζ ^ ((N + 3 * k : ℕ) : ℝ))) := by
            refine Finset.sum_le_sum (fun i hi => ?_)
            have hi' := Finset.mem_range.mp hi
            rw [mul_assoc]
            refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
            exact mul_le_mul (hKb i (by omega)) (hA (k - i) (by omega))
              (by unfold NB; exact norm_nonneg _) hK0
        _ = 2 ^ k * K * A0 * qC B.h ζ ^ ((N + 3 * k : ℕ) : ℝ) := by
            rw [← Finset.sum_mul, hchoose]
            ring
    have hfac : 0 ≤ (C0 * qC B.h ζ ^ (-3:ℝ)) ^ k :=
      pow_nonneg (mul_nonneg (by linarith) (Real.rpow_nonneg hq0.le _)) _
    have e3 : (qC B.h ζ ^ (-3:ℝ)) ^ k * qC B.h ζ ^ ((N + 3 * k : ℕ) : ℝ) = qC B.h ζ ^ (N : ℝ) := by
      rw [← Real.rpow_natCast (qC B.h ζ ^ (-3:ℝ)) k, ← Real.rpow_mul hq0.le, ← Real.rpow_add hq0]
      congr 1
      push_cast
      ring
    calc ‖iteratedFDeriv ℝ k F ζ‖ ≤ (C0 * qC B.h ζ ^ (-3:ℝ)) ^ k * NB B.h F k ζ := hpl0 ζ hq0 hq1 F k
      _ ≤ (C0 * qC B.h ζ ^ (-3:ℝ)) ^ k * (2 ^ k * K * A0 * qC B.h ζ ^ ((N + 3 * k : ℕ) : ℝ)) :=
          mul_le_mul_of_nonneg_left (by rw [hNBeq]; exact le_trans hleib hS) hfac
      _ = C * qC B.h ζ ^ (N : ℝ) := by
          rw [hCdef, mul_pow]
          linear_combination (C0 ^ k * 2 ^ k * K * A0) * e3

  have hloc : ∀ (α : ℝ) (a : WC), InWg5 B G (qsOf l0) α a → ∀ (γ : Lab) (m : ℤ), ∀ η ∈ DomC B.h (qsOf l0),
      η ∈ tsupport (a γ m) → 1/4 < qC B.h η / Qb γ.1 ∧ qC B.h η / Qb γ.1 < 4 ∧
        ∃ O : Set Cyl, IsOpen O ∧ η ∈ O ∧ ContDiffOn ℝ ∞ (psiW B G γ) O ∧ ContDiffOn ℝ ∞ (psiWd B G γ) O := by
    intro α a ha γ m η hη hts
    obtain ⟨hS, hA4, -, hw1, hw2, -, -, -, -⟩ := hp l0 (by omega) α a ha γ m η hη hts
    obtain ⟨-, -, hxi, het, -, -⟩ := hS
    have hη' : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < qsOf l0 := hη
    have hq0 : 0 < qC B.h η := hqpos η hη
    obtain ⟨hc1, hc2⟩ := hg γ.1 l0 (qC B.h η) (by omega) hq0 hη'.2.2 hw1 hw2
    have hγ1 : 1 ≤ γ.1 := by have := hA4.1; omega
    have hDB : η ∈ DomC B.h B.qB :=
      (⟨hη'.1, hη'.2.1, lt_trans hη'.2.2 hqsB⟩ : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < B.qB)
    obtain ⟨O, hO, hηO, -, hψO, hψdO⟩ :=
      (hMj γ η hγ1 hDB (by linarith [hη'.2.2]) hc1 hc2 (by linarith) het).1
    exact ⟨hw1, hw2, O, hO, hηO, hψO, hψdO⟩
  refine ⟨C, fun γ m ξ hξ => ?_⟩

  have hzg : ∀ η ∈ DomC B.h (qsOf l0), τ γ m η ≠ 0 →
      η ∈ tsupport (cutA B G tw γ m) ∨ η ∈ tsupport (f γ m) := by
    intro η hη hne
    by_contra hcon
    push_neg at hcon
    obtain ⟨h1, h2⟩ := hcon
    have e1 := notMem_tsupport_iff_eventuallyEq.mp h1
    have e2 := notMem_tsupport_iff_eventuallyEq.mp h2
    have hd : dVc B γ.1 (cutA B G tw γ m) η = 0 := by
      unfold dVc
      rw [e1.fderiv_eq]
      simp
    have hc0 : cutA B G tw γ m η = 0 := e1.eq_of_nhds
    have hf0 : f γ m η = 0 := e2.eq_of_nhds
    apply hne
    rw [hτid γ m η hη, hd, hc0]
    simp [srcHat, hf0, projT5]

  obtain ⟨W, hWo, hWmem⟩ : ∃ W : Set Cyl, IsOpen W ∧ ∀ η, η ∈ W ↔ η ∈ DomC B.h (qsOf l0) ∧ τ γ m η ≠ 0 :=
    ⟨DomC B.h (qsOf l0) ∩ τ γ m ⁻¹' {0}ᶜ,
      (hτs γ m).continuousOn.isOpen_inter_preimage hDo isOpen_compl_singleton, fun η => Iff.rfl⟩
  have hsmW : ∀ η ∈ W, 1/4 < qC B.h η / Qb γ.1 ∧ qC B.h η / Qb γ.1 < 4 ∧
      ∃ O : Set Cyl, IsOpen O ∧ η ∈ O ∧ ContDiffOn ℝ ∞ (psiW B G γ) O ∧ ContDiffOn ℝ ∞ (psiWd B G γ) O := by
    intro η hη
    obtain ⟨hηD, hne⟩ := (hWmem η).1 hη
    rcases hzg η hηD hne with h | h
    · exact hloc Bo (cutA B G tw) hPS.1 γ m η hηD h
    · exact hloc Bo f hf γ m η hηD h

  have hgid : ∀ y ∈ DomC B.h (qsOf l0),
      ((psiW B G γ y ≠ 0 ∧ DifferentiableAt ℝ (psiW B G γ) y) ∨ psiW B G γ =ᶠ[nhds y] (fun _ => (0:ℝ))) →
      τ γ m y = (((rhoQ B γ y ^ (Aex B.h + 1)) : ℝ) : ℂ) •
        ((fun η => ((psiWd B G γ η : ℝ) : ℂ) • tw γ m η) y +
          (fun η => ((1 - psiW B G γ η : ℝ) : ℂ) • srcHat B f γ m η) y) := by
    intro y hy hcase
    rw [hτid γ m y hy]
    congr 1
    rcases hcase with ⟨hne, hd⟩ | h0
    · obtain ⟨htwd, hP5⟩ := hPS.2.2.2.2.1 γ m y hy hne
      have hHF : HasFDerivAt (fun z => ((psiW B G γ z : ℝ) : ℂ))
          (Complex.ofRealCLM.comp (fderiv ℝ (psiW B G γ) y)) y :=
        Complex.ofRealCLM.hasFDerivAt.comp y hd.hasFDerivAt
      have hdc : dVc B γ.1 (cutA B G tw γ m) y =
          ((psiW B G γ y : ℝ) : ℂ) • dVc B γ.1 (tw γ m) y + ((psiWd B G γ y : ℝ) : ℂ) • tw γ m y := by
        have hcut : cutA B G tw γ m = (fun z => ((psiW B G γ z : ℝ) : ℂ)) • tw γ m := by
          funext z
          rfl
        unfold dVc psiWd
        rw [hcut, fderiv_smul hHF.differentiableAt htwd, hHF.fderiv]
        simp
      rw [hdc, hP5, show cutA B G tw γ m y = ((psiW B G γ y : ℝ) : ℂ) • tw γ m y from rfl,
        Matrix.mulVec_smul]
      funext i
      simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
      ring
    · have e1 : cutA B G tw γ m =ᶠ[nhds y] (fun _ => (0 : Fin 3 → ℂ)) :=
        h0.mono (fun z hz => by simp [cutA, hz])
      have hd0 : dVc B γ.1 (cutA B G tw γ m) y = 0 := by
        unfold dVc
        rw [e1.fderiv_eq]
        simp
      have hψ0 : psiW B G γ y = 0 := h0.eq_of_nhds
      have hψd0 : psiWd B G γ y = 0 := by
        unfold psiWd
        rw [h0.fderiv_eq]
        simp
      rw [hd0, show cutA B G tw γ m y = ((psiW B G γ y : ℝ) : ℂ) • tw γ m y from rfl]
      simp [hψ0, hψd0]

  have hsrc : ContDiffOn ℝ ∞ (srcHat B f γ m) (DomC B.h (qsOf l0)) := by
    have h1 : ContDiffOn ℝ ∞ (fun z => rhoQ B γ z ^ (-(Aex B.h + 1))) (DomC B.h (qsOf l0)) := fun z hz =>
      ((rhoQ_rpow_nb_v5 B hok (-(Aex B.h + 1))).1 γ z
        (show 0 < z.1 ∧ z.2.2.1 < 1 ∧ qC B.h z < qsOf l0 from hz).2.1).contDiffWithinAt
    refine (h1.smul (hf.2.1 γ m)).congr (fun z _ => ?_)
    simp only [srcHat, Pi.smul_apply', Complex.coe_smul]
  have hab : ∀ V : Set Cyl, IsOpen V → V ⊆ DomC B.h (qsOf l0) →
      (((∀ y ∈ V, psiW B G γ y ≠ 0) ∧ ContDiffOn ℝ ∞ (psiW B G γ) V ∧ ContDiffOn ℝ ∞ (psiWd B G γ) V) ∨
        ∀ y ∈ V, psiW B G γ y = 0) →
      ContDiffOn ℝ ∞ (fun η => ((psiWd B G γ η : ℝ) : ℂ) • tw γ m η) V ∧
        ContDiffOn ℝ ∞ (fun η => ((1 - psiW B G γ η : ℝ) : ℂ) • srcHat B f γ m η) V := by
    intro V hV hVD htype
    rcases htype with ⟨hne, hψV, hψdV⟩ | h0
    · refine ⟨((hψdV.div hψV hne).smul ((hPS.1.2.1 γ m).mono hVD)).congr (fun z hz => ?_),
        (((contDiffOn_const (c := (1:ℝ))).sub hψV).smul (hsrc.mono hVD)).congr (fun z _ => ?_)⟩
      · simp only [Pi.smul_apply', Pi.div_apply, cutA, Complex.coe_smul, smul_smul]
        rw [div_mul_cancel₀ _ (hne z hz)]
      · simp only [Pi.smul_apply', Complex.coe_smul]
    · have hψd0 : ∀ z ∈ V, psiWd B G γ z = 0 := by
        intro z hz
        have hev : psiW B G γ =ᶠ[nhds z] fun _ => (0:ℝ) :=
          Filter.eventuallyEq_of_mem (hV.mem_nhds hz) (fun w hw => h0 w hw)
        unfold psiWd
        rw [hev.fderiv_eq]
        simp
      refine ⟨(contDiffOn_const (c := (0 : Fin 3 → ℂ))).congr (fun z hz => ?_),
        (hsrc.mono hVD).congr (fun z hz => ?_)⟩
      · simp [hψd0 z hz]
      · simp [h0 z hz]

  obtain ⟨Good, hGood⟩ : ∃ Good : Set Cyl, ∀ ζ, ζ ∈ Good ↔ ∃ V : Set Cyl, IsOpen V ∧ ζ ∈ V ∧ V ⊆ W ∧
      (((∀ y ∈ V, psiW B G γ y ≠ 0) ∧ ContDiffOn ℝ ∞ (psiW B G γ) V ∧ ContDiffOn ℝ ∞ (psiWd B G γ) V) ∨
        ∀ y ∈ V, psiW B G γ y = 0) := ⟨_, fun ζ => Iff.rfl⟩
  have hdense : ∀ η ∈ W, η ∈ closure Good := by
    intro η hη
    obtain ⟨-, -, O, hO, hηO, hψO, hψdO⟩ := hsmW η hη
    rw [mem_closure_iff_nhds]
    intro t ht
    obtain ⟨U, hUt, hU, hηU⟩ := mem_nhds_iff.mp ht
    by_cases hex : ∃ η' ∈ U ∩ W ∩ O, psiW B G γ η' ≠ 0
    · obtain ⟨η', hη'V, hne⟩ := hex
      have hVo : IsOpen ((U ∩ W ∩ O) ∩ (O ∩ psiW B G γ ⁻¹' {0}ᶜ)) :=
        ((hU.inter hWo).inter hO).inter
          (hψO.continuousOn.isOpen_inter_preimage hO isOpen_compl_singleton)
      refine ⟨η', hUt hη'V.1.1, (hGood η').2 ⟨_, hVo, ⟨hη'V, hη'V.2, hne⟩, fun y hy => hy.1.1.2,
        Or.inl ⟨fun y hy => hy.2.2, hψO.mono (fun y hy => hy.2.1), hψdO.mono (fun y hy => hy.2.1)⟩⟩⟩
    · push_neg at hex
      exact ⟨η, hUt hηU, (hGood η).2 ⟨U ∩ W ∩ O, (hU.inter hWo).inter hO, ⟨⟨hηU, hη⟩, hηO⟩,
        fun y hy => hy.1.2, Or.inr hex⟩⟩

  have hgood : ∀ ζ ∈ Good, ‖iteratedFDeriv ℝ k (τ γ m) ζ‖ ≤ C * qC B.h ζ ^ (N : ℝ) := by
    intro ζ hζ
    obtain ⟨V, hV, hζV, hVW, htype⟩ := (hGood ζ).1 hζ
    have hVD : V ⊆ DomC B.h (qsOf l0) := fun y hy => ((hWmem y).1 (hVW hy)).1
    obtain ⟨hw1, hw2, -⟩ := hsmW ζ (hVW hζV)
    obtain ⟨hAs, hBs⟩ := hab V hV hVD htype
    refine key γ (τ γ m) _ _ ζ V hV hζV hVD hw1 hw2 hAs hBs
      (fun j => hCa j (N + 3 * k) γ m ζ (hVD hζV)) (fun j => hCb j (N + 3 * k) γ m ζ (hVD hζV))
      (fun y hy => hgid y (hVD hy) ?_)
    rcases htype with ⟨hne, hψV, -⟩ | h0
    · exact Or.inl ⟨hne y hy, (hψV.contDiffAt (hV.mem_nhds hy)).differentiableAt (by norm_num)⟩
    · exact Or.inr (Filter.eventuallyEq_of_mem (hV.mem_nhds hy) (fun z hz => h0 z hz))

  have hφ : ContinuousOn (fun η => ‖iteratedFDeriv ℝ k (τ γ m) η‖) (DomC B.h (qsOf l0)) := by
    have h1 := (hτs γ m).continuousOn_iteratedFDerivWithin (m := k) (by exact_mod_cast le_top)
      hDo.uniqueDiffOn
    exact (h1.congr (fun η hη => (iteratedFDerivWithin_of_isOpen k hDo hη).symm)).norm
  have hgc : ContinuousOn (fun η => C * qC B.h η ^ (N : ℝ)) (DomC B.h (qsOf l0)) :=
    continuousOn_const.mul (hqsm.continuousOn.rpow_const (fun _ _ => Or.inr (Nat.cast_nonneg N)))
  by_cases hcl : ξ ∈ closure Good
  · exact ContinuousWithinAt.closure_le (f := fun η => ‖iteratedFDeriv ℝ k (τ γ m) η‖)
      (g := fun η => C * qC B.h η ^ (N : ℝ)) hcl
      ((hφ.continuousAt (hDo.mem_nhds hξ)).continuousWithinAt)
      ((hgc.continuousAt (hDo.mem_nhds hξ)).continuousWithinAt) hgood
  · have hUo : IsOpen (DomC B.h (qsOf l0) ∩ (closure Good)ᶜ) := hDo.inter isClosed_closure.isOpen_compl
    have hev : τ γ m =ᶠ[nhds ξ] fun _ => (0 : Fin 3 → ℂ) :=
      Filter.eventuallyEq_of_mem (hUo.mem_nhds ⟨hξ, hcl⟩) (fun η hη => by
        by_contra hne
        exact hη.2 (hdense η ((hWmem η).2 ⟨hη.1, hne⟩)))
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_zero]
    simp only [Pi.zero_apply, norm_zero]
    exact mul_nonneg hCnn (Real.rpow_nonneg (hqpos ξ hξ).le _)

theorem phase_flat_supp_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (a : WC) (H : Finset ℤ), (∀ γ m, m ∉ H → ∀ ξ ∈ DomC B.h (qsOf l0), a γ m ξ = 0) → (∀ γ m, ContDiffOn ℝ ∞ (a γ m) (DomC B.h (qsOf l0))) → (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → a γ m ξ ≠ 0 → SuppW B G γ ξ) → (∀ k N : ℕ, ∃ C : ℝ, ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ‖iteratedFDeriv ℝ k (a γ m) ξ‖ ≤ C * qC B.h ξ ^ (N : ℝ)) → ∀ (i : Fin 3), (∀ γ m, ContDiffOn ℝ ∞ (fun η => a γ m η i * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ)))) (DomC B.h (qsOf l0))) ∧ ∀ k N : ℕ, ∃ C : ℝ, ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ‖iteratedFDeriv ℝ k (fun η => a γ m η i * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ)))) ξ‖ ≤ C * qC B.h ξ ^ (N : ℝ) :=
by
  intro B G hok hG

  have core : ∀ (D U : Set Cyl) (ξ : Cyl) (f : Cyl → ℂ) (φ : Cyl → ℝ) (c A Cp P : ℝ) (k : ℕ),
      IsOpen D → IsOpen U → ξ ∈ D → ξ ∈ U → ContDiffOn ℝ ∞ f D → ContDiffOn ℝ ∞ φ U → 1 ≤ A →
      (∀ j : ℕ, 1 ≤ j → j ≤ k → |c| * ‖iteratedFDeriv ℝ j φ ξ‖ ≤ A) →
      (∀ j : ℕ, j ≤ k → ‖iteratedFDeriv ℝ j f ξ‖ ≤ Cp * P) →
      ‖iteratedFDeriv ℝ k (fun η => f η * Complex.exp (Complex.I * ((c * φ η : ℝ) : ℂ))) ξ‖ ≤
        2 ^ k * (k.factorial : ℝ) * (Cp * P) * A ^ k := by
    intro D U ξ f φ c A Cp P k hD hU hξD hξU hf hφ hA hφb hfb
    have hg : ContDiff ℝ ∞ (fun s : ℝ => Complex.exp (Complex.I * (s : ℂ))) :=
      Complex.contDiff_exp.comp (contDiff_const.mul Complex.ofRealCLM.contDiff)
    have hgd : ∀ (n : ℕ) (s : ℝ), iteratedDeriv n (fun s : ℝ => Complex.exp (Complex.I * (s : ℂ))) s =
        Complex.I ^ n * Complex.exp (Complex.I * (s : ℂ)) := by
      intro n
      induction n with
      | zero => intro s; simp
      | succ n ih =>
        intro s
        rw [iteratedDeriv_succ]
        have e : iteratedDeriv n (fun s : ℝ => Complex.exp (Complex.I * (s : ℂ))) =
            fun s : ℝ => Complex.I ^ n * Complex.exp (Complex.I * (s : ℂ)) := funext ih
        rw [e]
        have h : HasDerivAt (fun s : ℝ => Complex.I ^ n * Complex.exp (Complex.I * (s : ℂ)))
            (Complex.I ^ n * (Complex.exp (Complex.I * (s : ℂ)) * (Complex.I * 1))) s := by
          apply HasDerivAt.const_mul
          apply HasDerivAt.cexp
          apply HasDerivAt.const_mul
          exact (hasDerivAt_id s).ofReal_comp
        rw [h.deriv]
        ring
    have hgn : ∀ (n : ℕ) (s : ℝ),
        ‖iteratedFDeriv ℝ n (fun s : ℝ => Complex.exp (Complex.I * (s : ℂ))) s‖ = 1 := by
      intro n s
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, hgd, norm_mul, norm_pow, Complex.norm_I, one_pow,
        one_mul, mul_comm]
      exact Complex.norm_exp_ofReal_mul_I s
    have hcφ : ContDiffOn ℝ ∞ (fun η => c * φ η) U := contDiffOn_const.mul hφ
    have hE : ContDiffOn ℝ ∞ (fun η => Complex.exp (Complex.I * ((c * φ η : ℝ) : ℂ))) U :=
      hg.comp_contDiffOn hcφ
    have hEb : ∀ j : ℕ, j ≤ k →
        ‖iteratedFDeriv ℝ j (fun η => Complex.exp (Complex.I * ((c * φ η : ℝ) : ℂ))) ξ‖ ≤
          (k.factorial : ℝ) * A ^ k := by
      intro j hj
      have hcomp := norm_iteratedFDerivWithin_comp_le (n := j) (s := U) (t := Set.univ) (x := ξ)
        (C := 1) (D := A) hg.contDiffOn hcφ (by exact_mod_cast le_top) uniqueDiffOn_univ hU.uniqueDiffOn
        (Set.mapsTo_univ _ _) hξU
        (fun i _ => by rw [iteratedFDerivWithin_univ, hgn])
        (fun i hi1 hij => by
          rw [iteratedFDerivWithin_of_isOpen i hU hξU]
          have e : (fun η => c * φ η) = c • φ := by funext η; simp [smul_eq_mul]
          rw [e, iteratedFDeriv_const_smul_apply ((hφ.contDiffAt (hU.mem_nhds hξU)).of_le
            (by exact_mod_cast le_top)), norm_smul, Real.norm_eq_abs]
          exact le_trans (hφb i hi1 (le_trans hij hj)) (le_self_pow₀ hA (by omega)))
      rw [iteratedFDerivWithin_of_isOpen j hU hξU] at hcomp
      have e2 : ((fun s : ℝ => Complex.exp (Complex.I * (s : ℂ))) ∘ fun η => c * φ η) =
          fun η => Complex.exp (Complex.I * ((c * φ η : ℝ) : ℂ)) := rfl
      rw [e2] at hcomp
      calc _ ≤ (j.factorial : ℝ) * 1 * A ^ j := hcomp
        _ ≤ (k.factorial : ℝ) * A ^ k := by
          rw [mul_one]
          apply mul_le_mul (by exact_mod_cast Nat.factorial_le hj) (pow_le_pow_right₀ hA hj)
            (by positivity) (by positivity)
    have hW : IsOpen (U ∩ D) := hU.inter hD
    have hξW : ξ ∈ U ∩ D := ⟨hξU, hξD⟩
    have hL := norm_iteratedFDerivWithin_mul_le (n := k) (hf.mono Set.inter_subset_right)
      (hE.mono Set.inter_subset_left) hW.uniqueDiffOn hξW (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen k hW hξW] at hL
    refine le_trans hL ?_
    have hP0 : ∀ j ≤ k, 0 ≤ Cp * P := fun j hj => le_trans (norm_nonneg _) (hfb j hj)
    calc ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * ‖iteratedFDerivWithin ℝ i f (U ∩ D) ξ‖ *
          ‖iteratedFDerivWithin ℝ (k - i) (fun η => Complex.exp (Complex.I * ((c * φ η : ℝ) : ℂ)))
            (U ∩ D) ξ‖
        ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (Cp * P) * ((k.factorial : ℝ) * A ^ k) := by
          apply Finset.sum_le_sum
          intro i hi
          have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [iteratedFDerivWithin_of_isOpen i hW hξW, iteratedFDerivWithin_of_isOpen (k - i) hW hξW]
          apply mul_le_mul (mul_le_mul_of_nonneg_left (hfb i hik) (by positivity))
            (hEb (k - i) (Nat.sub_le k i)) (norm_nonneg _)
            (mul_nonneg (by positivity) (hP0 i hik))
      _ = 2 ^ k * (k.factorial : ℝ) * (Cp * P) * A ^ k := by
          rw [← Finset.sum_mul, ← Finset.sum_mul]
          have hs : ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) = 2 ^ k := by
            exact_mod_cast Nat.sum_range_choose k
          rw [hs]
          ring

  obtain ⟨l3, h3⟩ := phiL5_jet_poly_v5 B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨l3 + n0, fun l0 hl0 a H hH hsm hsupp hflat i => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hqs1 : qsOf l0 ≤ 1 := by rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  obtain ⟨hDo, hqCs, hqCpos, -, -, -⟩ := domc_open_calculus B (qsOf l0) hok

  have hbase : ∀ (l : ℕ) (j : Fin 3), ContDiffOn ℝ ∞ (fun ξ => baseC B l ξ j) (DomC B.h (qsOf l0)) := by
    intro l j
    obtain ⟨-, hgs⟩ := geom_slow_base_smooth_v5 B hok
    have hπ : ContDiff ℝ ∞ (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) (DomC B.h (qsOf l0))
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
      intro ξ hξ
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      exact ⟨hξ'.1, hξ'.2.1, lt_of_lt_of_le hξ'.2.2 hqs⟩
    exact ((hgs l j).comp hπ.contDiffOn hmaps).congr (fun ξ _ => rfl)
  have hsm' : ∀ γ m, ContDiffOn ℝ ∞ (fun η => a γ m η i) (DomC B.h (qsOf l0)) := by
    intro γ m
    exact (contDiffOn_pi.mp (hsm γ m)) i
  have hconj1 : ∀ γ m, ContDiffOn ℝ ∞ (fun η => a γ m η i * Complex.exp (Complex.I * (m : ℂ) *
      ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ)))) (DomC B.h (qsOf l0)) :=
    wave_coef_phase_smooth_v5 B G (qsOf l0) (fun γ m η => a γ m η i) hG hbase hsm'
      (fun γ m ξ hξ hne => hsupp γ m ξ hξ (fun h => hne (by simp [h])))
  refine ⟨hconj1, fun k N => ?_⟩

  have hext : ∀ (F : Cyl → ℂ) (g : Cyl → ℝ) (T : Set Cyl),
      ContDiffOn ℝ ∞ F (DomC B.h (qsOf l0)) → ContinuousOn g (DomC B.h (qsOf l0)) →
      (∀ ξ ∈ DomC B.h (qsOf l0), 0 ≤ g ξ) → (∀ η ∈ DomC B.h (qsOf l0), F η ≠ 0 → η ∈ closure T) →
      (∀ y ∈ T, ‖iteratedFDeriv ℝ k F y‖ ≤ g y) →
      ∀ ξ ∈ DomC B.h (qsOf l0), ‖iteratedFDeriv ℝ k F ξ‖ ≤ g ξ := by
    intro F g T hF hg hg0 hFT hS ξ hξ
    have hFc : ContinuousOn (fun η => ‖iteratedFDeriv ℝ k F η‖) (DomC B.h (qsOf l0)) :=
      ((hF.continuousOn_iteratedFDerivWithin (m := k) (by exact_mod_cast le_top) hDo.uniqueDiffOn).congr
        (fun x hx => (iteratedFDerivWithin_of_isOpen k hDo hx).symm)).norm
    by_cases hA : ∀ᶠ η in nhds ξ, F η = 0
    · have h0 : iteratedFDeriv ℝ k F ξ = 0 := by
        have hE : F =ᶠ[nhds ξ] fun _ => (0:ℂ) := hA
        rw [(hE.iteratedFDeriv ℝ k).eq_of_nhds]
        have h := (iteratedFDeriv_fun_zero : iteratedFDeriv ℝ k (fun _ : Cyl => (0:ℂ)) = 0)
        exact congrFun h ξ
      rw [h0, norm_zero]
      exact hg0 ξ hξ
    · have hfr : ∃ᶠ η in nhds ξ, ¬ F η = 0 := Filter.not_eventually.mp hA
      have hfr2 : ∃ᶠ η in nhds ξ, η ∈ DomC B.h (qsOf l0) ∩ {η | F η ≠ 0} :=
        (hfr.and_eventually (hDo.mem_nhds hξ)).mono (fun η h => ⟨h.2, h.1⟩)
      have hcl : ξ ∈ closure (DomC B.h (qsOf l0) ∩ {η | F η ≠ 0}) :=
        mem_closure_iff_frequently.mpr hfr2
      have hsub : closure (DomC B.h (qsOf l0) ∩ {η | F η ≠ 0}) ⊆ closure T :=
        closure_minimal (fun y hy => hFT y hy.1 hy.2) isClosed_closure
      exact ContinuousWithinAt.closure_le (hsub hcl)
        ((hFc.continuousAt (hDo.mem_nhds hξ)).continuousWithinAt)
        ((hg.continuousAt (hDo.mem_nhds hξ)).continuousWithinAt)
        (fun y hy => hS y hy)

  have hdens : ∀ γ m, ∀ η ∈ DomC B.h (qsOf l0), a γ m η ≠ 0 →
      η ∈ closure {y | y ∈ DomC B.h (qsOf l0) ∧ a γ m y ≠ 0 ∧ etaL B.h γ y ≠ 0} := by
    intro γ m η hη hne
    have hU' : IsOpen (DomC B.h (qsOf l0) ∩ a γ m ⁻¹' {0}ᶜ) :=
      (hsm γ m).continuousOn.isOpen_inter_preimage hDo isOpen_compl_singleton
    have hts : η ∈ closure (Function.support (etaL B.h γ)) := (hsupp γ m η hη hne).2.1
    have hmem := hU'.inter_closure ⟨⟨hη, hne⟩, hts⟩
    refine closure_mono ?_ hmem
    intro y hy
    exact ⟨hy.1.1, hy.1.2, hy.2⟩

  obtain ⟨Mx, hMx1, hMx⟩ : ∃ Mx : ℝ, 1 ≤ Mx ∧ ∀ m ∈ H, |(m : ℝ)| ≤ Mx := by
    refine ⟨1 + ∑ n ∈ H, |(n : ℝ)|, ?_, fun m hm => ?_⟩
    · have := Finset.sum_nonneg (fun n (_ : n ∈ H) => abs_nonneg (n : ℝ))
      linarith
    · have := Finset.single_le_sum (f := fun n : ℤ => |(n : ℝ)|)
        (fun n (_ : n ∈ H) => abs_nonneg (n : ℝ)) hm
      linarith

  choose Cf Mf hMf hCf using h3
  obtain ⟨Cs, hCs1, hCs⟩ : ∃ Cs : ℝ, 1 ≤ Cs ∧ ∀ j ≤ k, |Cf j| ≤ Cs := by
    refine ⟨1 + ∑ j ∈ Finset.range (k + 1), |Cf j|, ?_, fun j hj => ?_⟩
    · have := Finset.sum_nonneg (fun j (_ : j ∈ Finset.range (k + 1)) => abs_nonneg (Cf j))
      linarith
    · have := Finset.single_le_sum (f := fun j => |Cf j|)
        (fun j (_ : j ∈ Finset.range (k + 1)) => abs_nonneg (Cf j))
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hj))
      have h0 := Finset.sum_nonneg (fun j (_ : j ∈ Finset.range (k + 1)) => abs_nonneg (Cf j))
      linarith
  obtain ⟨Ms, hMs0, hMs⟩ : ∃ Ms : ℝ, 0 ≤ Ms ∧ ∀ j ≤ k, Mf j ≤ Ms := by
    refine ⟨∑ j ∈ Finset.range (k + 1), Mf j, Finset.sum_nonneg (fun j _ => hMf j), fun j hj => ?_⟩
    exact Finset.single_le_sum (f := fun j => Mf j) (fun j _ => hMf j)
      (Finset.mem_range.mpr (Nat.lt_succ_of_le hj))
  obtain ⟨N', hN'⟩ : ∃ N' : ℕ, N' = N + ⌈(k : ℝ) * Ms⌉₊ := ⟨_, rfl⟩
  choose Ca hCa using fun j => hflat j N'
  obtain ⟨C', hC'0, hC'⟩ : ∃ C' : ℝ, 0 ≤ C' ∧ ∀ j ≤ k, |Ca j| ≤ C' := by
    refine ⟨∑ j ∈ Finset.range (k + 1), |Ca j|,
      Finset.sum_nonneg (fun j _ => abs_nonneg (Ca j)), fun j hj => ?_⟩
    exact Finset.single_le_sum (f := fun j => |Ca j|) (fun j _ => abs_nonneg (Ca j))
      (Finset.mem_range.mpr (Nat.lt_succ_of_le hj))
  have hMC0 : 0 ≤ Mx * Cs := mul_nonneg (by linarith) (by linarith)
  have hK0 : 0 ≤ 2 ^ k * (k.factorial : ℝ) * C' * (Mx * Cs) ^ k :=
    mul_nonneg (mul_nonneg (by positivity) hC'0) (pow_nonneg hMC0 k)
  refine ⟨2 ^ k * (k.factorial : ℝ) * C' * (Mx * Cs) ^ k, fun γ m ξ hξ => ?_⟩
  have hgc : ContinuousOn (fun η => 2 ^ k * (k.factorial : ℝ) * C' * (Mx * Cs) ^ k * qC B.h η ^ (N : ℝ))
      (DomC B.h (qsOf l0)) :=
    continuousOn_const.mul (hqCs.continuousOn.rpow_const (fun x _ => Or.inr (Nat.cast_nonneg N)))
  have hg0 : ∀ η ∈ DomC B.h (qsOf l0),
      0 ≤ 2 ^ k * (k.factorial : ℝ) * C' * (Mx * Cs) ^ k * qC B.h η ^ (N : ℝ) :=
    fun η hη => mul_nonneg hK0 (Real.rpow_nonneg (hqCpos η hη).le _)
  refine hext _ (fun η => 2 ^ k * (k.factorial : ℝ) * C' * (Mx * Cs) ^ k * qC B.h η ^ (N : ℝ))
    {y | y ∈ DomC B.h (qsOf l0) ∧ a γ m y ≠ 0 ∧ etaL B.h γ y ≠ 0} (hconj1 γ m) hgc hg0 ?_ ?_ ξ hξ
  · intro η hη hne
    apply hdens γ m η hη
    intro h
    exact hne (by simp [h])
  ·
    intro y hy
    obtain ⟨hyD, hne, het⟩ := hy
    have hm : m ∈ H := by
      by_contra hm
      exact hne (hH γ m hm y hyD)
    have hS := hsupp γ m y hyD hne
    have hy' : 0 < y.1 ∧ y.2.2.1 < 1 ∧ qC B.h y < qsOf l0 := hyD
    have hq0 : 0 < qC B.h y := hqCpos y hyD
    have hq1 : qC B.h y ≤ 1 := le_trans hy'.2.2.le hqs1
    obtain ⟨⟨U, hUo, hyU, hφU⟩, -⟩ := hCf 0 l0 γ y (by omega) hyD hS het
    have hpowM : 1 ≤ qC B.h y ^ (-Ms) :=
      Real.one_le_rpow_of_pos_of_le_one_of_nonpos hq0 hq1 (by linarith)
    have hA : 1 ≤ Mx * Cs * qC B.h y ^ (-Ms) :=
      one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le hMx1 hCs1) hpowM
    have habs : |(m : ℝ) * (kb B.h γ.1 : ℝ)| ≤ Mx * (kb B.h γ.1 : ℝ) := by
      rw [abs_mul, Nat.abs_cast]
      exact mul_le_mul_of_nonneg_right (hMx m hm) (Nat.cast_nonneg _)
    have hφb : ∀ j : ℕ, 1 ≤ j → j ≤ k →
        |(m : ℝ) * (kb B.h γ.1 : ℝ)| * ‖iteratedFDeriv ℝ j (phiL5 B G γ) y‖ ≤
          Mx * Cs * qC B.h y ^ (-Ms) := by
      intro j hj1 hjk
      have h1 := (hCf j l0 γ y (by omega) hyD hS het).2 hj1
      have h2 : qC B.h y ^ (-Mf j) ≤ qC B.h y ^ (-Ms) :=
        Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (by linarith [hMs j hjk])
      have h3 : Cf j ≤ Cs := le_trans (le_abs_self _) (hCs j hjk)
      have h4 : (kb B.h γ.1 : ℝ) * ‖iteratedFDeriv ℝ j (phiL5 B G γ) y‖ ≤ Cs * qC B.h y ^ (-Ms) :=
        le_trans h1 (mul_le_mul h3 h2 (Real.rpow_nonneg hq0.le _) (by linarith))
      calc |(m : ℝ) * (kb B.h γ.1 : ℝ)| * ‖iteratedFDeriv ℝ j (phiL5 B G γ) y‖
          ≤ Mx * (kb B.h γ.1 : ℝ) * ‖iteratedFDeriv ℝ j (phiL5 B G γ) y‖ :=
            mul_le_mul_of_nonneg_right habs (norm_nonneg _)
        _ = Mx * ((kb B.h γ.1 : ℝ) * ‖iteratedFDeriv ℝ j (phiL5 B G γ) y‖) := by ring
        _ ≤ Mx * (Cs * qC B.h y ^ (-Ms)) := mul_le_mul_of_nonneg_left h4 (by linarith)
        _ = Mx * Cs * qC B.h y ^ (-Ms) := by ring
    have hfb : ∀ j : ℕ, j ≤ k →
        ‖iteratedFDeriv ℝ j (fun η => a γ m η i) y‖ ≤ C' * qC B.h y ^ (N' : ℝ) := by
      intro j hj
      have hL : ‖iteratedFDeriv ℝ j
          (⇑(ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i) ∘ a γ m) y‖ ≤
          ‖(ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i)‖ *
            ‖iteratedFDeriv ℝ j (a γ m) y‖ :=
        ContinuousLinearMap.norm_iteratedFDeriv_comp_left _
          ((hsm γ m).contDiffAt (hDo.mem_nhds hyD)) (by exact_mod_cast le_top)
      have hP : ‖(ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i)‖ ≤ 1 :=
        ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => by simpa using norm_le_pi_norm x i)
      have hpN : 0 ≤ qC B.h y ^ (N' : ℝ) := Real.rpow_nonneg hq0.le _
      have hb := hCa j γ m y hyD
      calc ‖iteratedFDeriv ℝ j (fun η => a γ m η i) y‖ =
            ‖iteratedFDeriv ℝ j
              (⇑(ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i) ∘ a γ m) y‖ := rfl
        _ ≤ 1 * ‖iteratedFDeriv ℝ j (a γ m) y‖ :=
            le_trans hL (mul_le_mul_of_nonneg_right hP (norm_nonneg _))
        _ ≤ Ca j * qC B.h y ^ (N' : ℝ) := by rw [one_mul]; exact hb
        _ ≤ C' * qC B.h y ^ (N' : ℝ) :=
            mul_le_mul_of_nonneg_right (le_trans (le_abs_self _) (hC' j hj)) hpN
    have hcore := core (DomC B.h (qsOf l0)) U y (fun η => a γ m η i) (phiL5 B G γ)
      ((m : ℝ) * (kb B.h γ.1 : ℝ)) (Mx * Cs * qC B.h y ^ (-Ms)) C' (qC B.h y ^ (N' : ℝ)) k
      hDo hUo hyD hyU (hsm' γ m) hφU hA hφb hfb
    have hfun : (fun η => a γ m η i * Complex.exp (Complex.I * (m : ℂ) *
        ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ)))) =
        (fun η => a γ m η i * Complex.exp (Complex.I *
          ((((m : ℝ) * (kb B.h γ.1 : ℝ)) * phiL5 B G γ η : ℝ) : ℂ))) := by
      funext η
      rw [show (Complex.I * ((((m : ℝ) * (kb B.h γ.1 : ℝ)) * phiL5 B G γ η : ℝ) : ℂ)) =
        Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ)) by push_cast; ring]
    rw [hfun]
    refine le_trans hcore ?_
    show _ ≤ 2 ^ k * (k.factorial : ℝ) * C' * (Mx * Cs) ^ k * qC B.h y ^ (N : ℝ)
    have hqe : (qC B.h y ^ (-Ms)) ^ k = qC B.h y ^ (-Ms * k) :=
      (Real.rpow_mul_natCast hq0.le _ _).symm
    have hqa : qC B.h y ^ (N' : ℝ) * qC B.h y ^ (-Ms * k) = qC B.h y ^ ((N' : ℝ) + -Ms * k) :=
      (Real.rpow_add hq0 _ _).symm
    have hexp : (N : ℝ) ≤ (N' : ℝ) + -Ms * k := by
      rw [hN']
      push_cast
      have := Nat.le_ceil ((k : ℝ) * Ms)
      linarith
    have hqN : qC B.h y ^ ((N' : ℝ) + -Ms * k) ≤ qC B.h y ^ (N : ℝ) :=
      Real.rpow_le_rpow_of_exponent_ge hq0 hq1 hexp
    calc 2 ^ k * (k.factorial : ℝ) * (C' * qC B.h y ^ (N' : ℝ)) * (Mx * Cs * qC B.h y ^ (-Ms)) ^ k
        = 2 ^ k * (k.factorial : ℝ) * C' * (Mx * Cs) ^ k *
            (qC B.h y ^ (N' : ℝ) * (qC B.h y ^ (-Ms)) ^ k) := by ring
      _ = 2 ^ k * (k.factorial : ℝ) * C' * (Mx * Cs) ^ k * qC B.h y ^ ((N' : ℝ) + -Ms * k) := by
          rw [hqe, hqa]
      _ ≤ _ := mul_le_mul_of_nonneg_left hqN hK0

theorem wave_phys_flat_supp_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (a : WC) (e : ℝ) (F : Ext ℝ³), (∃ H : Finset ℤ, ∀ γ m, m ∉ H → ∀ ξ ∈ DomC B.h (qsOf l0), a γ m ξ = 0) → (∀ γ m, ContDiffOn ℝ ∞ (a γ m) (DomC B.h (qsOf l0))) → (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → a γ m ξ ≠ 0 → SuppW B G γ ξ) → (∀ (i : Fin 3) γ m, ContDiffOn ℝ ∞ (fun η => a γ m η i * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ)))) (DomC B.h (qsOf l0))) → (∀ (i : Fin 3) (k N : ℕ), ∃ C : ℝ, ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ‖iteratedFDeriv ℝ k (fun η => a γ m η i * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ)))) ξ‖ ≤ C * qC B.h ξ ^ (N : ℝ)) → (∀ x t Y, corrOn B l0 x t → F x t Y = qC B.h (ptOf x t Y) ^ (-e) • cyl2cart x (waveV5 B G a (thetaOf x) (ptOf x t Y))) → (∀ x t Y, ¬ corrOn B l0 x t → F x t Y = 0) → FlatS5 B l0 F :=
by
  intro B G hok hG
  obtain ⟨-, -, hXa, hXm1, hm12, hm2Xb, -, hqB0, hqB1, -, -, -, -⟩ := hok.2.1
  have hXb : 0 < B.Xb := by linarith
  obtain ⟨K4, hK40, hK4⟩ := wpf_pint_bound B G hok hG
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 a e F hfin hsmA hsupp hsm hbd hF1 hF0 => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  have hqs1 : qsOf l0 ≤ 1 := le_trans hqs hqB1
  obtain ⟨H, hH⟩ := hfin


  have hDo : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hlab : ∀ ξ0 ∈ DomC B.h (qsOf l0), ∃ (T : Finset (Lab × ℤ)) (U : Set Cyl), IsOpen U ∧
      ξ0 ∈ U ∧ T.card ≤ 162 * H.card ∧
      (∀ t ∈ T, t.2 ∈ H ∧ ActiveL4 B G t.1 ∧ |Real.logb 2 (qC B.h ξ0) + (t.1.1 : ℝ)| ≤ 1) ∧
      ∀ γ m, (γ, m) ∉ T → ∀ ξ ∈ U ∩ DomC B.h (qsOf l0), a γ m ξ = 0 := by
    classical
    intro ξ0 hξ0
    let a' : WC := fun γ m ξ => if etaL B.h γ ξ = 0 then 0 else a γ m ξ
    have ha'H : ∀ γ m, m ∉ H → ∀ ξ ∈ DomC B.h (qsOf l0), a' γ m ξ = 0 := by
      intro γ m hm ξ hξ
      show (if etaL B.h γ ξ = 0 then 0 else a γ m ξ) = 0
      split_ifs
      · rfl
      · exact hH γ m hm ξ hξ
    have ha'S : ∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → a' γ m ξ ≠ 0 →
        SuppW B G γ ξ ∧ etaL B.h γ ξ ≠ 0 := by
      intro γ m ξ hξ hne
      have hne' : (if etaL B.h γ ξ = 0 then 0 else a γ m ξ) ≠ 0 := hne
      by_cases he : etaL B.h γ ξ = 0
      · rw [if_pos he] at hne'
        exact absurd rfl hne'
      · rw [if_neg he] at hne'
        exact ⟨hsupp γ m ξ hξ hne', he⟩
    obtain ⟨T, U, hUo, hξU, hcard, hTprop, hvan'⟩ :=
      wpf_local_labels B G hok l0 hqs a' H ha'H ha'S ξ0 hξ0
    refine ⟨T, U, hUo, hξU, hcard, hTprop, ?_⟩
    intro γ m hT ξ hξ
    by_contra hne
    have hO : IsOpen ((U ∩ DomC B.h (qsOf l0)) ∩ (a γ m) ⁻¹' {0}ᶜ) :=
      ((hsmA γ m).continuousOn.mono Set.inter_subset_right).isOpen_inter_preimage
        (hUo.inter hDo) isOpen_compl_singleton
    have hξO : ξ ∈ (U ∩ DomC B.h (qsOf l0)) ∩ (a γ m) ⁻¹' {0}ᶜ := ⟨hξ, hne⟩
    have hts : ξ ∈ closure (Function.support (etaL B.h γ)) := (hsupp γ m ξ hξ.2 hne).2.1
    obtain ⟨ξ', ⟨⟨hU', hD'⟩, ha'⟩, he'⟩ := mem_closure_iff.mp hts _ hO hξO
    have h0 := hvan' γ m hT ξ' ⟨hU', hD'⟩
    have h1 : (if etaL B.h γ ξ' = 0 then 0 else a γ m ξ') = 0 := h0
    rw [if_neg (Function.mem_support.mp he')] at h1
    exact ha' h1

  have hQpos : ∀ p : ℝ³ × ℝ, p.2 < 1 → 0 < simScale B.h (p.1 2) (1 - p.2) := fun p hp =>
    (hok.1.1 (p.1 2) (1 - p.2) (by linarith)).1
  obtain ⟨-, -, hQsm, -⟩ := corr_domain_v5 B l0 0 hok
  have hQc0 : ContinuousOn (fun p : ℝ³ × ℝ => simScale B.h (p.1 2) (1 - p.2)) {w : ℝ³ × ℝ | w.2 < 1} :=
    hQsm.continuousOn
  have hsimO : IsOpen (simDomain B.h (qsOf l0)) := by
    have e0 : simDomain B.h (qsOf l0) = {z : ℝ³ × ℝ | z.2 < 1} ∩
        (fun z : ℝ³ × ℝ => simScale B.h (z.1 2) (1 - z.2)) ⁻¹' Iio (qsOf l0) := by
      ext z
      exact Iff.rfl
    rw [e0]
    exact hQc0.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  have hQc : ContinuousOn (fun p : ℝ³ × ℝ => simScale B.h (p.1 2) (1 - p.2)) (simDomain B.h (qsOf l0)) :=
    hQc0.mono (fun p hp => hp.1)
  have hradc : Continuous (fun p : ℝ³ × ℝ => rad p.1) := by
    unfold rad
    fun_prop

  have hzero : ∀ x t Y, (x, t) ∈ simDomain B.h (qsOf l0) →
      (rad x ^ 2 < 2 * B.Xa * simScale B.h (x 2) (1 - t) ∨
        2 * B.Xb * simScale B.h (x 2) (1 - t) < rad x ^ 2) → F x t Y = 0 := by
    intro x t Y hxt hor
    by_cases hc : corrOn B l0 x t
    · rw [hF1 x t Y hc]
      have hξ : ptOf x t Y ∈ DomC B.h (qsOf l0) := hc
      have hq0 : 0 < simScale B.h (x 2) (1 - t) := hQpos (x, t) hxt.1
      have hq2 : 0 < 2 * simScale B.h (x 2) (1 - t) := by linarith
      have hXC : XC B.h (ptOf x t Y) = rad x ^ 2 / (2 * simScale B.h (x 2) (1 - t)) := rfl
      have ha0 : ∀ γ m, a γ m (ptOf x t Y) = 0 := by
        intro γ m
        by_contra hne
        have hS := hsupp γ m _ hξ hne
        obtain ⟨-, -, -, -, h5, h6⟩ := hS
        rw [hXC] at h5 h6
        rw [le_div_iff₀ hq2] at h5
        rw [div_le_iff₀ hq2] at h6
        rcases hor with h | h <;> linarith
      have hw : waveV5 B G a (thetaOf x) (ptOf x t Y) = 0 := by
        funext i
        simp [waveV5, ha0]
      rw [hw]
      simp [cyl2cart]
    · exact hF0 x t Y hc

  have hexp : ∀ (ξ : Cyl) (x : ℝ³) (T : Finset (Lab × ℤ)), 0 < rad x →
      (∀ γ m, (γ, m) ∉ T → a γ m ξ = 0) → ∀ i : Fin 3,
      waveV5 B G a (thetaOf x) ξ i = (∑ t ∈ T, a t.1 t.2 ξ i *
        Complex.exp (Complex.I * (t.2 : ℂ) * ((kb B.h t.1.1 : ℂ) * (phiL5 B G t.1 ξ : ℂ))) *
        ((⟨x 0, x 1⟩ : ℂ) / (rad x : ℂ)) ^ (t.2 * pint5 B G t.1)).re := by
    intro ξ x T hr hT i
    set z : ℂ := ⟨x 0, x 1⟩ with hz
    have hnorm : ‖z‖ = rad x := by
      rw [Complex.norm_eq_sqrt_sq_add_sq]
      rfl
    have hr' : (rad x : ℂ) ≠ 0 := by exact_mod_cast hr.ne'
    have hexpθ : Complex.exp ((thetaOf x : ℂ) * Complex.I) = z / (rad x : ℂ) := by
      have h : (rad x : ℂ) * Complex.exp ((thetaOf x : ℂ) * Complex.I) = z := by
        have h0 := Complex.norm_mul_exp_arg_mul_I z
        rw [hnorm] at h0
        exact h0
      rw [eq_div_iff hr', mul_comm (Complex.exp _), h]
    have hterm : ∀ (γ : Lab) (m : ℤ), a γ m ξ i * ephase5 B G γ m (thetaOf x) ξ =
        a γ m ξ i * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
          (z / (rad x : ℂ)) ^ (m * pint5 B G γ) := by
      intro γ m
      have h1 : ephase5 B G γ m (thetaOf x) ξ =
          Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
            Complex.exp ((thetaOf x : ℂ) * Complex.I) ^ (m * pint5 B G γ) := by
        rw [← Complex.exp_int_mul, ← Complex.exp_add]
        unfold ephase5
        congr 1
        push_cast
        ring
      rw [h1, hexpθ]
      ring
    have hin : ∀ γ : Lab, ∑ᶠ m : ℤ, a γ m ξ i * ephase5 B G γ m (thetaOf x) ξ =
        ∑ m ∈ T.image Prod.snd, a γ m ξ i * ephase5 B G γ m (thetaOf x) ξ := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      rw [Function.mem_support] at hm
      by_contra h
      apply hm
      have hγm : (γ, m) ∉ T := fun hmem =>
        h (Finset.mem_coe.2 (Finset.mem_image_of_mem Prod.snd hmem))
      rw [hT γ m hγm]
      simp
    have hsup : Function.support (fun γ : Lab => ∑ m ∈ T.image Prod.snd,
        a γ m ξ i * ephase5 B G γ m (thetaOf x) ξ) ⊆ ↑(T.image Prod.fst) := by
      intro γ hγ
      rw [Function.mem_support] at hγ
      by_contra h
      apply hγ
      apply Finset.sum_eq_zero
      intro m _
      have hγm : (γ, m) ∉ T := fun hmem =>
        h (Finset.mem_coe.2 (Finset.mem_image_of_mem Prod.fst hmem))
      rw [hT γ m hγm]
      simp
    have hsumT : (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, a γ m ξ i * ephase5 B G γ m (thetaOf x) ξ) =
        ∑ t ∈ T, a t.1 t.2 ξ i * ephase5 B G t.1 t.2 (thetaOf x) ξ := by
      simp_rw [hin]
      rw [finsum_eq_sum_of_support_subset _ hsup, ← Finset.sum_product']
      symm
      apply Finset.sum_subset
      · intro t ht
        exact Finset.mem_product.2 ⟨Finset.mem_image_of_mem _ ht, Finset.mem_image_of_mem _ ht⟩
      · intro t _ htT
        rw [hT t.1 t.2 htT]
        simp
    show (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, a γ m ξ i * ephase5 B G γ m (thetaOf x) ξ).re = _
    rw [hsumT]
    congr 1
    exact Finset.sum_congr rfl (fun t _ => hterm t.1 t.2)

  set β : Lab × ℤ → Fin 3 → Cyl → ℂ := fun t i η => a t.1 t.2 η i *
    Complex.exp (Complex.I * (t.2 : ℂ) * ((kb B.h t.1.1 : ℂ) * (phiL5 B G t.1 η : ℂ))) with hβ
  set n : Lab × ℤ → ℤ := fun t => t.2 * pint5 B G t.1 with hn
  have hβsm : ∀ t i, ContDiffOn ℝ ∞ (β t i) (DomC B.h (qsOf l0)) := fun t i => hsm i t.1 t.2

  have hloc : ∀ (Y₀ : ℝ × ℝ) (p0 : ℝ³ × ℝ), corrOn B l0 p0.1 p0.2 →
      ∃ (T : Finset (Lab × ℤ)) (V : Set (ℝ³ × ℝ)), IsOpen V ∧ p0 ∈ V ∧
        V ⊆ {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} ∧ T.card ≤ 162 * H.card ∧
        (∀ t ∈ T, t.2 ∈ H ∧ ActiveL4 B G t.1 ∧
          |Real.logb 2 (simScale B.h (p0.1 2) (1 - p0.2)) + (t.1.1 : ℝ)| ≤ 1) ∧
        ∀ w ∈ V, (↿(evOff B.h F Y₀)) w = wpfPsi B e T β n Y₀ w := by
    intro Y₀ p0 hp0
    obtain ⟨hOo, hΦ, -⟩ := corr_domain_v5 B l0 Y₀ hok
    have hξ0 : ptOf p0.1 p0.2 (Yph B.h (rad p0.1) p0.2 + Y₀) ∈ DomC B.h (qsOf l0) := hp0
    obtain ⟨T, U, hUo, hξU, hcard, hTprop, hvan⟩ := hlab _ hξ0
    refine ⟨T, {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} ∩
      (fun w : ℝ³ × ℝ => ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y₀)) ⁻¹' U,
      hΦ.continuousOn.isOpen_inter_preimage hOo hUo, ⟨hp0, hξU⟩, Set.inter_subset_left, hcard,
      fun t ht => hTprop t ht, ?_⟩
    rintro ⟨x, s⟩ ⟨hc, hU⟩
    have hc' : corrOn B l0 x s := hc
    have hU' : ptOf x s (Yph B.h (rad x) s + Y₀) ∈ U := hU
    have hξ : ptOf x s (Yph B.h (rad x) s + Y₀) ∈ DomC B.h (qsOf l0) := hc
    have hvan' : ∀ γ m, (γ, m) ∉ T → a γ m (ptOf x s (Yph B.h (rad x) s + Y₀)) = 0 :=
      fun γ m h => hvan γ m h _ ⟨hU', hξ⟩
    show F x s (Yph B.h (rad x) s + Y₀) = wpfPsi B e T β n Y₀ (x, s)
    rw [hF1 x s _ hc']
    unfold wpfPsi
    refine congrArg₂ (· • ·) rfl ?_
    have hcyl : ∀ c : Fin 3 → ℝ, cyl2cart x c = ∑ i : Fin 3, c i • (![eR x, eTh x, eZ] i) := by
      intro c
      simp [cyl2cart, Fin.sum_univ_three]
    rw [hcyl, Finset.sum_comm]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hexp _ x T hc'.1 hvan' i, Complex.re_sum, Finset.sum_smul]

  obtain ⟨U0, hU0⟩ : ∃ U : Set (ℝ³ × ℝ), U = simDomain B.h (qsOf l0) ∩
      (fun p : ℝ³ × ℝ => 2 * B.Xa * simScale B.h (p.1 2) (1 - p.2) - rad p.1 ^ 2) ⁻¹' Ioi 0 :=
    ⟨_, rfl⟩
  obtain ⟨U2, hU2⟩ : ∃ U : Set (ℝ³ × ℝ), U = simDomain B.h (qsOf l0) ∩
      (fun p : ℝ³ × ℝ => rad p.1 ^ 2 - 2 * B.Xb * simScale B.h (p.1 2) (1 - p.2)) ⁻¹' Ioi 0 :=
    ⟨_, rfl⟩
  have hU0o : IsOpen U0 := by
    rw [hU0]
    exact ((continuousOn_const.mul hQc).sub (hradc.pow 2).continuousOn).isOpen_inter_preimage
      hsimO isOpen_Ioi
  have hU2o : IsOpen U2 := by
    rw [hU2]
    exact ((hradc.pow 2).continuousOn.sub (continuousOn_const.mul hQc)).isOpen_inter_preimage
      hsimO isOpen_Ioi
  have hZ0 : ∀ (Y₀ : ℝ × ℝ) (p : ℝ³ × ℝ), p ∈ U0 ∪ U2 → (↿(evOff B.h F Y₀)) p = 0 := by
    intro Y₀ p hp
    have hp' : p ∈ simDomain B.h (qsOf l0) ∧
        (0 < 2 * B.Xa * simScale B.h (p.1 2) (1 - p.2) - rad p.1 ^ 2 ∨
          0 < rad p.1 ^ 2 - 2 * B.Xb * simScale B.h (p.1 2) (1 - p.2)) := by
      rw [hU0, hU2] at hp
      rcases hp with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · exact ⟨h1, Or.inl h2⟩
      · exact ⟨h1, Or.inr h2⟩
    show F p.1 p.2 (Yph B.h (rad p.1) p.2 + Y₀) = 0
    apply hzero p.1 p.2 _ hp'.1
    rcases hp'.2 with h | h
    · left; linarith
    · right; linarith

  have hF2 : ∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (↿(evOff B.h F Y₀)) (simDomain B.h (qsOf l0)) := by
    intro Y₀
    obtain ⟨K, M, -, hcrux⟩ := wpf_sum_bound B hok l0 hqs1 e 0
    apply contDiffOn_of_locally_contDiffOn
    intro p hp
    by_cases hr : 0 < rad p.1
    · obtain ⟨T, V, hVo, hpV, hVsub, -, -, hrep⟩ := hloc Y₀ p ⟨hr, hp.1, hp.2⟩
      refine ⟨V, hVo, hpV, ?_⟩
      exact ((hcrux T β n Y₀ hβsm).1.mono (fun w hw => hVsub hw.2)).congr
        (fun w hw => hrep w hw.2)
    · have hr0 : rad p.1 = 0 := le_antisymm (not_lt.mp hr) (Real.sqrt_nonneg _)
      have hpU : p ∈ U0 ∪ U2 := by
        left
        rw [hU0]
        refine ⟨hp, ?_⟩
        show 0 < 2 * B.Xa * simScale B.h (p.1 2) (1 - p.2) - rad p.1 ^ 2
        have h0 : (0:ℝ) ^ 2 = 0 := by norm_num
        rw [hr0, h0, sub_zero]
        exact mul_pos (mul_pos two_pos hXa) (hQpos p hp.1)
      refine ⟨U0 ∪ U2, hU0o.union hU2o, hpU, ?_⟩
      exact (contDiffOn_const (c := (0 : ℝ³))).congr (fun w hw => hZ0 Y₀ w hw.2)

  have hF1' : FlatX B (qsOf l0) F := by
    intro m N
    obtain ⟨K, M, hK, hcrux⟩ := wpf_sum_bound B hok l0 hqs1 e m
    obtain ⟨N', hN'⟩ : ∃ N' : ℕ, N' = N + m + ⌈M⌉₊ := ⟨_, rfl⟩
    choose Cb hCb using fun (i : Fin 3) (j : ℕ) => hbd i j N'
    obtain ⟨A0, hA0def⟩ : ∃ A0 : ℝ, A0 = ∑ i : Fin 3, ∑ j ∈ Finset.range (m + 1), |Cb i j| :=
      ⟨_, rfl⟩
    obtain ⟨MH, hMHdef⟩ : ∃ MH : ℝ, MH = ∑ m' ∈ H, |(m' : ℝ)| := ⟨_, rfl⟩
    have hA00 : 0 ≤ A0 := by
      rw [hA0def]
      exact Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => abs_nonneg _))
    have hMH0 : 0 ≤ MH := by
      rw [hMHdef]
      exact Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have hCbA : ∀ (i : Fin 3) (j : ℕ), j ≤ m → Cb i j ≤ A0 := by
      intro i j hj
      rw [hA0def]
      calc Cb i j ≤ |Cb i j| := le_abs_self _
        _ ≤ ∑ j' ∈ Finset.range (m + 1), |Cb i j'| :=
            Finset.single_le_sum (f := fun j' => |Cb i j'|) (fun _ _ => abs_nonneg _)
              (Finset.mem_range.2 (by omega))
        _ ≤ ∑ i' : Fin 3, ∑ j' ∈ Finset.range (m + 1), |Cb i' j'| :=
            Finset.single_le_sum (f := fun i' => ∑ j' ∈ Finset.range (m + 1), |Cb i' j'|)
              (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _)) (Finset.mem_univ i)
    have hMHb : ∀ m' ∈ H, |(m' : ℝ)| ≤ MH := by
      intro m' hm'
      rw [hMHdef]
      exact Finset.single_le_sum (f := fun m'' : ℤ => |(m'' : ℝ)|) (fun _ _ => abs_nonneg _) hm'
    have hMK1 : 0 ≤ MH * K4 + 1 := by
      have := mul_nonneg hMH0 hK40
      linarith
    have hc'0 : (0:ℝ) ≤ 162 * (H.card : ℝ) := by positivity
    have hC0 : 0 ≤ K * (162 * (H.card : ℝ)) * (MH * K4 + 1) ^ m * A0 :=
      mul_nonneg (mul_nonneg (mul_nonneg hK hc'0) (pow_nonneg hMK1 m)) hA00
    refine ⟨K * (162 * (H.card : ℝ)) * (MH * K4 + 1) ^ m * A0, fun Y₀ x s hxs => ?_⟩
    have hq0 : 0 < simScale B.h (x 2) (1 - s) := hQpos (x, s) hxs.1
    have hq1 : simScale B.h (x 2) (1 - s) ≤ 1 := le_trans hxs.2.le hqs1
    set Q := simScale B.h (x 2) (1 - s) with hQ
    by_cases hsh : 2 * B.Xa * Q ≤ rad x ^ 2 ∧ rad x ^ 2 ≤ 2 * B.Xb * Q
    · obtain ⟨hsh1, hsh2⟩ := hsh
      have hXQ : 0 < B.Xa * Q := mul_pos hXa hq0
      have hXbQ : 0 < B.Xb * Q := mul_pos hXb hq0
      have hr : 0 < rad x := by
        rcases (Real.sqrt_nonneg (x 0 ^ 2 + x 1 ^ 2)).lt_or_eq with h | h
        · exact h
        · exfalso
          have h0 : rad x = 0 := h.symm
          have h00 : (0:ℝ) ^ 2 = 0 := by norm_num
          rw [h0, h00] at hsh1
          linarith
      have hc : corrOn B l0 x s := ⟨hr, hxs.1, hxs.2⟩
      obtain ⟨T, V, hVo, hpV, -, hcard, hTprop, hrep⟩ := hloc Y₀ (x, s) hc
      have hev : (↿(evOff B.h F Y₀)) =ᶠ[nhds (x, s)] wpfPsi B e T β n Y₀ :=
        Filter.eventuallyEq_of_mem (hVo.mem_nhds hpV) hrep
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
      have hξ : ptOf x s (Yph B.h (rad x) s + Y₀) ∈ DomC B.h (qsOf l0) := hc
      obtain ⟨ν, hνdef⟩ : ∃ ν : ℝ, ν = MH * K4 / Q := ⟨_, rfl⟩
      obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = A0 * Q ^ (N' : ℝ) := ⟨_, rfl⟩
      have hν0 : 0 ≤ ν := by
        rw [hνdef]
        exact div_nonneg (mul_nonneg hMH0 hK40) hq0.le
      have hA0 : 0 ≤ A := by
        rw [hAdef]
        exact mul_nonneg hA00 (Real.rpow_nonneg hq0.le _)
      have hνb : ∀ t ∈ T, |(n t : ℝ)| ≤ ν := by
        intro t ht
        obtain ⟨htH, hAct, hlog⟩ := hTprop t ht
        have hp : |(pint5 B G t.1 : ℝ)| ≤ K4 / Q := hK4 t.1 Q hAct hq0 hq1 hlog
        have hm := hMHb t.2 htH
        have e1 : ((n t : ℤ) : ℝ) = (t.2 : ℝ) * (pint5 B G t.1 : ℝ) := by
          simp only [hn]
          push_cast
          ring
        rw [e1, abs_mul, hνdef, mul_div_assoc]
        exact mul_le_mul hm hp (abs_nonneg _) hMH0
      have hAb : ∀ t ∈ T, ∀ i : Fin 3, ∀ j ≤ m, ‖iteratedFDeriv ℝ j (β t i)
          (ptOf (x, s).1 (x, s).2 (Yph B.h (rad (x, s).1) (x, s).2 + Y₀))‖ ≤ A := by
        intro t _ i j hj
        rw [hAdef]
        exact le_trans (hCb i j t.1 t.2 _ hξ)
          (mul_le_mul_of_nonneg_right (hCbA i j hj) (Real.rpow_nonneg hq0.le _))
      have hfinal : ‖iteratedFDeriv ℝ m (wpfPsi B e T β n Y₀) (x, s)‖ ≤
          K * (T.card : ℝ) * (ν + 1) ^ m * Q ^ (-M) * A :=
        (hcrux T β n Y₀ hβsm).2 (x, s) ν A hc (by show B.Xa * Q < rad x ^ 2; linarith)
          (by show rad x ^ 2 < 4 * B.Xb * Q; linarith) hν0 hA0 hνb hAb
      refine le_trans hfinal ?_
      have hcardR : (T.card : ℝ) ≤ 162 * (H.card : ℝ) := by exact_mod_cast hcard
      have h1Q : 1 ≤ 1 / Q := by
        rw [le_div_iff₀ hq0]
        linarith
      have hν1 : ν + 1 ≤ (MH * K4 + 1) / Q := by
        rw [add_div, hνdef]
        linarith
      have hu : (ν + 1) ^ m ≤ (MH * K4 + 1) ^ m / Q ^ m := by
        rw [← div_pow]
        exact pow_le_pow_left₀ (by linarith) hν1 m
      have hP : Q ^ (-M) * Q ^ (N' : ℝ) / Q ^ m ≤ Q ^ (N : ℝ) := by
        have e1 : Q ^ (-M) * Q ^ (N' : ℝ) / Q ^ m = Q ^ (-M + (N' : ℝ) + (-(m : ℝ))) := by
          rw [Real.rpow_add hq0, Real.rpow_add hq0, Real.rpow_neg hq0.le (m : ℝ),
            Real.rpow_natCast Q m, div_eq_mul_inv]
        rw [e1]
        apply Real.rpow_le_rpow_of_exponent_ge hq0 hq1
        have hcM : M ≤ (⌈M⌉₊ : ℝ) := Nat.le_ceil M
        rw [hN']
        push_cast
        linarith
      have hw0 : 0 ≤ Q ^ (-M) * A := mul_nonneg (Real.rpow_nonneg hq0.le _) hA0
      calc K * (T.card : ℝ) * (ν + 1) ^ m * Q ^ (-M) * A
          = (K * (T.card : ℝ) * (ν + 1) ^ m) * (Q ^ (-M) * A) := by ring
        _ ≤ (K * (162 * (H.card : ℝ)) * ((MH * K4 + 1) ^ m / Q ^ m)) * (Q ^ (-M) * A) := by
            apply mul_le_mul_of_nonneg_right _ hw0
            exact mul_le_mul (mul_le_mul_of_nonneg_left hcardR hK) hu
              (pow_nonneg (by linarith) m) (mul_nonneg hK hc'0)
        _ = K * (162 * (H.card : ℝ)) * (MH * K4 + 1) ^ m * A0 *
              (Q ^ (-M) * Q ^ (N' : ℝ) / Q ^ m) := by
            rw [hAdef]
            ring
        _ ≤ K * (162 * (H.card : ℝ)) * (MH * K4 + 1) ^ m * A0 * Q ^ (N : ℝ) :=
            mul_le_mul_of_nonneg_left hP hC0
    · have hpU : (x, s) ∈ U0 ∪ U2 := by
        rw [hU0, hU2]
        rcases not_and_or.mp hsh with h | h
        · left
          refine ⟨hxs, ?_⟩
          show 0 < 2 * B.Xa * Q - rad x ^ 2
          linarith [not_le.mp h]
        · right
          refine ⟨hxs, ?_⟩
          show 0 < rad x ^ 2 - 2 * B.Xb * Q
          linarith [not_le.mp h]
      have hev : (↿(evOff B.h F Y₀)) =ᶠ[nhds (x, s)] fun _ => (0 : ℝ³) :=
        Filter.eventuallyEq_of_mem ((hU0o.union hU2o).mem_nhds hpU) (fun w hw => hZ0 Y₀ w hw)
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
      simp only [Pi.zero_apply, norm_zero]
      exact mul_nonneg hC0 (Real.rpow_nonneg hq0.le _)
  exact ⟨hF1', hF2, fun x t Y hxt hr => hzero x t Y hxt (Or.inl hr)⟩

theorem pulse_vel_defect_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (α : ℝ) (f tw : WC) (pr : WS), PulseSol5 B G l0 α f tw pr → InWg5 B G (qsOf l0) (α + 1/2) (potOf5 B G tw) → InWg5 B G (qsOf l0) (α + 1/2 - kapS) (velW5 B G (potOf5 B G tw) - cutA B G tw) :=
by
  intro B G hok hG
  obtain ⟨lv, hv⟩ := velRem5_class B G hok hG
  obtain ⟨lm, hm⟩ := pulse_mult_coeffs_v5 B G hok hG
  obtain ⟨C0, b0, hcb⟩ := hm 0
  obtain ⟨ls, hs⟩ := pulse_support_good_v5 B G hok hG
  refine ⟨lv + lm + ls, fun l0 hl0 α f tw pr hPS hD => ?_⟩
  have hq1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hc : InWg5 B G (qsOf l0) α (cutA B G tw) := hPS.1
  have hP3 := hPS.2.2.1
  have hP4 := hPS.2.2.2.1

  have hcross : ∀ (n v : Fin 3 → ℂ) (a b N : ℂ), a ≠ 0 → b ≠ 0 →
      N = n 0 * n 0 + n 1 * n 1 + n 2 * n 2 → N ≠ 0 → n 0 * v 0 + n 1 * v 1 + n 2 * v 2 = 0 →
      (Complex.I * a * b) • crossC n ((Complex.I / (a * b * N)) • crossC n v) = v := by
    intro n v a b N ha hb hN hN0 hv
    have hk : Complex.I * a * b * (Complex.I / (a * b * N)) * N = -1 := by
      have habN : a * b * N ≠ 0 := mul_ne_zero (mul_ne_zero ha hb) hN0
      have e : Complex.I * a * b * (Complex.I / (a * b * N)) * N =
          (Complex.I * Complex.I) * ((a * b * N) / (a * b * N)) := by ring
      rw [e, div_self habN, Complex.I_mul_I]
      ring
    funext i
    fin_cases i
    · show Complex.I * a * b * (n 1 * (Complex.I / (a * b * N) * (n 0 * v 1 - n 1 * v 0))
          - n 2 * (Complex.I / (a * b * N) * (n 2 * v 0 - n 0 * v 2))) = v 0
      linear_combination (Complex.I * a * b * (Complex.I / (a * b * N)) * n 0) * hv
        + (Complex.I * a * b * (Complex.I / (a * b * N)) * v 0) * hN - v 0 * hk
    · show Complex.I * a * b * (n 2 * (Complex.I / (a * b * N) * (n 1 * v 2 - n 2 * v 1))
          - n 0 * (Complex.I / (a * b * N) * (n 0 * v 1 - n 1 * v 0))) = v 1
      linear_combination (Complex.I * a * b * (Complex.I / (a * b * N)) * n 1) * hv
        + (Complex.I * a * b * (Complex.I / (a * b * N)) * v 1) * hN - v 1 * hk
    · show Complex.I * a * b * (n 0 * (Complex.I / (a * b * N) * (n 2 * v 0 - n 0 * v 2))
          - n 1 * (Complex.I / (a * b * N) * (n 1 * v 2 - n 2 * v 1))) = v 2
      linear_combination (Complex.I * a * b * (Complex.I / (a * b * N)) * n 2) * hv
        + (Complex.I * a * b * (Complex.I / (a * b * N)) * v 2) * hN - v 2 * hk
  have hcz : ∀ n : Fin 3 → ℂ, crossC n 0 = 0 := by
    intro n
    funext i
    fin_cases i <;> simp [crossC]
  have hkb : ∀ l : ℕ, (kb B.h l : ℂ) ≠ 0 := by
    intro l
    have h0 : 0 < kb B.h l := by
      unfold kb epsb Qb
      exact Nat.ceil_pos.mpr (Real.rpow_pos_of_pos
        (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos (by norm_num) _) _) _)
    exact_mod_cast h0.ne'

  have hsplit : ∀ (a : WC) (γ : Lab) (m : ℤ) (ξ : Cyl), velW5 B G a γ m ξ =
      (Complex.I * (kb B.h γ.1 : ℂ) * (m : ℂ)) • crossC (nPhiC5 B G γ ξ) (a γ m ξ)
        + velRem5 B a γ m ξ := by
    intro a γ m ξ
    funext j
    fin_cases j <;> simp [velW5, velC5, velRem5, crossC, nPhiC5] <;> ring

  have hcr : ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      (Complex.I * (kb B.h γ.1 : ℂ) * (m : ℂ)) • crossC (nPhiC5 B G γ ξ) (potOf5 B G tw γ m ξ)
        = cutA B G tw γ m ξ := by
    intro γ m ξ hξ
    by_cases hm0 : m = 0
    · subst hm0
      have h0 : tw γ 0 = 0 := (hP3 γ 0 rfl).1
      simp [cutA, h0]
    · have hpot : potOf5 B G tw γ m ξ = (Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ) * nsqC5 B G γ ξ)) •
          crossC (nPhiC5 B G γ ξ) (cutA B G tw γ m ξ) := by
        simp only [potOf5, if_neg hm0, cutA]
      by_cases hc0 : cutA B G tw γ m ξ = 0
      · rw [hpot, hc0, hcz, smul_zero, hcz, smul_zero]
      · have hts : ξ ∈ tsupport (cutA B G tw γ m) := subset_tsupport _ hc0
        obtain ⟨-, hA, hl, h1, h2, h3, h4, h5, h6⟩ :=
          hs l0 (by omega) α (cutA B G tw) hc γ m ξ hξ hts
        have hN0 := (hcb l0 (by omega) γ m hA hl ξ hξ h1 h2 h3 h4 h5 h6).1
        have hNdef : nsqC5 B G γ ξ = nPhiC5 B G γ ξ 0 * nPhiC5 B G γ ξ 0
            + nPhiC5 B G γ ξ 1 * nPhiC5 B G γ ξ 1 + nPhiC5 B G γ ξ 2 * nPhiC5 B G γ ξ 2 := by
          simp [nsqC5, nPhiC5, dotProduct, Fin.sum_univ_three]
        have hNne : nsqC5 B G γ ξ ≠ 0 := by
          unfold nsqC5
          exact Complex.ofReal_ne_zero.mpr hN0
        have hdot : nPhiC5 B G γ ξ 0 * cutA B G tw γ m ξ 0 + nPhiC5 B G γ ξ 1 * cutA B G tw γ m ξ 1
            + nPhiC5 B G γ ξ 2 * cutA B G tw γ m ξ 2 = 0 := by
          have h4' := hP4 γ m ξ hξ
          simp only [dotProduct, Fin.sum_univ_three] at h4'
          simp only [cutA, Pi.smul_apply, smul_eq_mul]
