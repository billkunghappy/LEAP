          (P.Amp η ^ 2 * S0 + P.c1 η ^ 2 * S1 + P.c2 η ^ 2 * S2 - S00 / 2)
        + ((1 + η ^ 2)⁻¹) ^ 2 * (2 * P.Amp η * deriv P.Amp η * S0 + 2 * P.c1 η * deriv P.c1 η * S1
          + 2 * P.c2 η * deriv P.c2 η * S2) := by
    unfold profEtaD
    rw [show (fun e => profRadInt (fun x' e' => rfpU P x' e' ^ 2 - x' * rfpF P x' e' ^ 2) x e) =
