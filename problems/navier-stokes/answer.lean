  have hPst0 : 0 < P.Pst := lt_trans (Real.exp_pos _) hPst
  have hL : 0 ≤ Real.log (1 / P.lam) := Real.log_nonneg (by rw [le_div_iff₀ hl0]; linarith)
  have h34 : rfpY3 P.Md P.lam ≤ rfpY4 P.Md P.lam := by
    unfold rfpY4
    have : 0 < 13 / P.lam := by positivity
    linarith
  have hy4 : y ≤ rfpY4 P.Md P.lam := le_trans hy h34
  have h45 : rfpY4 P.Md P.lam + 60 ≤ rfpY5 P.Md P.lam := by
    unfold rfpY5; linarith
  have h5b : rfpY5 P.Md P.lam + 5 ≤ rfpYb P.Md P.lam P.T1 P.Lh := by
    unfold rfpYb; linarith
  have e1 : rfpSigI (y - rfpY5 P.Md P.lam) = 0 := hsI0 _ (by linarith)
  have e2 : rfpSigI (y - rfpY5 P.Md P.lam - 1 - P.T1) = 0 := hsI0 _ (by linarith)
  have e3 : sigA ((y - rfpY4 P.Md P.lam) / 60) = 0 := hs0 _ (by
    have : y - rfpY4 P.Md P.lam ≤ 0 := by linarith
    linarith)
  have hz : (Real.log (Real.exp y / Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) + 2) / 2 ≤ 0 := by
    rw [← Real.exp_sub, Real.log_exp]
