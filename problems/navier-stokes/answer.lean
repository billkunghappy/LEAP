    choose A hA using hb
    refine ⟨∑ j ∈ Finset.range (m + 1), |A j|, Finset.sum_nonneg (fun j _ => abs_nonneg _), ?_⟩
    intro j hj q hq
    calc ‖iteratedFDeriv ℝ j a q‖ ≤ A j := hA j q hq
      _ ≤ |A j| := le_abs_self _
      _ ≤ _ := Finset.single_le_sum (f := fun i => |A i|) (fun i _ => abs_nonneg _)
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hj))
  have ha2 : ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => Xb / q.1) (Ioi 0 ×ˢ univ) :=
    ((contDiffOn_const (c := Xb)).div contDiffOn_fst
      (fun q hq => (show (0:ℝ) < q.1 from hq.1).ne')).congr (fun q _ => rfl)
  have hsq : ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => Real.sqrt (2 * q.1)) (Ioi 0 ×ˢ univ) :=
    ((contDiff_const.mul contDiff_fst).contDiffOn :
      ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => 2 * q.1) (Ioi 0 ×ˢ univ)).sqrt
      (fun q hq => by have : (0:ℝ) < q.1 := hq.1; positivity)
  have ha3 : ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => Xb / Real.sqrt (2 * q.1)) (Ioi 0 ×ˢ univ) :=
    ((contDiffOn_const (c := Xb)).div hsq
      (fun q hq => by have : (0:ℝ) < q.1 := hq.1; positivity)).congr (fun q _ => rfl)
  obtain ⟨A1, hA10, hA1⟩ := cbound (fun q => q.1) contDiff_fst.contDiffOn
  obtain ⟨A2, hA20, hA2⟩ := cbound _ ha2
  obtain ⟨A3, hA30, hA3⟩ := cbound _ ha3
  obtain ⟨Cc, hCc⟩ : ∃ Cc : ℝ,
