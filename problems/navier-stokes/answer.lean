        _ = ((n.choose i : ℝ) * Kf i * (|drx B.h| * ‖vrv‖) * T) *
            (Real.sqrt (qC B.h ξ) * (Λ * Real.sqrt (qC B.h ξ) ^ i * ξ.1 ^ (drx B.h - 1 - (i:ℝ)))) := by
            ring
        _ ≤ ((n.choose i : ℝ) * Kf i * (|drx B.h| * ‖vrv‖) * T) * (Ef i * Q) :=
            mul_le_mul_of_nonneg_left b3 hP0
        _ = (n.choose i : ℝ) * (Kf i * (|drx B.h| * ‖vrv‖)) * Ef i * (Q * T) := by ring
    have hLb : Real.sqrt (qC B.h ξ) *
        NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) n ξ ≤
        S * (Q * T) := by
      calc Real.sqrt (qC B.h ξ) *
            NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) n ξ
          ≤ Real.sqrt (qC B.h ξ) * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
            NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1)) i ξ *
            NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u2)) (n - i) ξ :=
            mul_le_mul_of_nonneg_left hl hs0.le
        _ = ∑ i ∈ Finset.range (n + 1), Real.sqrt (qC B.h ξ) * ((n.choose i : ℝ) *
            NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1)) i ξ *
            NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u2)) (n - i) ξ) := by rw [Finset.mul_sum]
        _ ≤ ∑ i ∈ Finset.range (n + 1),
            (n.choose i : ℝ) * (Kf i * (|drx B.h| * ‖vrv‖)) * Ef i * (Q * T) :=
