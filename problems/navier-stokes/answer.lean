    have hM0 : 0 ≤ max (max C1 C2) (max C3 0) := le_trans (le_max_right C3 0) (le_max_right _ _)
    have key : ∀ C' N' : ℝ, C' ≤ max (max C1 C2) (max C3 0) → N' ≤ max (max N1 N2) 0 →
