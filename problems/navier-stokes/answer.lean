    · rw [hP0, ← Real.norm_eq_abs]; exact (hB0 η ⟨h1, h2⟩).trans (le_max_left _ _)
    · rw [hP1, ← Real.norm_eq_abs]; exact (hB1 η ⟨h1, h2⟩).trans (le_max_left _ _)
    · exact ((hPax.contDiffAt (Ioo_mem_nhds (by linarith) (by linarith))).differentiableAt
