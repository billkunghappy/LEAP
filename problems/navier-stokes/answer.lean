    have e3 : Zt η = Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)) := by
      rw [hZt, hZF, hZB]; exact (hsplit η hηB _ _).symm
    have e4 : Ut2 η = Qb γ.1 ^ (1/2 + B.h) * ubase B η 2 := by rw [hUt2]; rfl
    have hBrη : Br η = K0 * (Real.sqrt (Qb γ.1) * ubase B η 0) + (-1) * (va η * (1 * Tt η +
