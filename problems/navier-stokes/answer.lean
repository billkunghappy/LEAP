      | (push_cast; ring)
      | push_cast
    have hge : |(κ'.1 : ℝ) * e.1 + (κ'.2 : ℝ) * e.2| ≤ ‖c‖ := by
      rw [hc', norm_mul, Complex.norm_I, Complex.norm_real, Real.norm_eq_abs, mul_one, abs_mul,
        abs_of_pos (by positivity : (0:ℝ) < 2 * Real.pi)]
      exact le_mul_of_one_le_left (abs_nonneg _) (by linarith [Real.pi_gt_three])
    have e5 : c * (c * (c * (c * (c * G)))) = c ^ 5 * G := by ring
    rw [e5, norm_mul, norm_pow] at hsup
    calc _ ≤ ‖c‖ ^ 5 * ‖G‖ :=
          mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (abs_nonneg _) hge 5) (norm_nonneg _)
      _ ≤ _ := hsup
  have f1 := fast (1, 0) (by
    rw [Prod.norm_def, norm_one, norm_zero]; exact max_eq_left (zero_le_one : (0:ℝ) ≤ 1))
  have f2 := fast (0, 1) (by
    rw [Prod.norm_def, norm_one, norm_zero]; exact max_eq_right (zero_le_one : (0:ℝ) ≤ 1))
  simp only [mul_one, mul_zero, add_zero, zero_add] at f1 f2
  have hfin := pow5 |(κ'.1 : ℝ)| |(κ'.2 : ℝ)| _ _ (abs_nonneg _) (abs_nonneg _) (norm_nonneg _) G0 f1 f2
  exact hfin.trans_eq (by ring)

theorem tn_descent_support_v5 : ∀ (B : BG), B.ok → ∀ l0 : ℕ, 8 ≤ l0 → ∀ (α : ℝ) (g : Cyl → ℝ),
    InM B (qsOf l0) α g → ∀ (k : ℕ) (w : Fin k → Cyl) (ξ : Cyl) (κ : ℤ × ℤ), ξ ∈ DomC B.h (qsOf l0) →
    fourY (fun η => iteratedFDeriv ℝ k g η w) ξ κ ≠ 0 →
    ∃ κ' : ℤ × ℤ, Jpow (coarseIdx B.h (qC B.h ξ)) ((κ'.1 : ℝ), (κ'.2 : ℝ)) = ((κ.1 : ℝ), (κ.2 : ℝ)) :=
by
  intro B hok l0 hl0 α g hg k w ξ κ hξ hκ
  have hl07 : 7 ≤ l0 := by omega
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ

  have hs : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
  have hs2 : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
  have hL : Lgc ≠ 0 := by unfold Lgc; intro h0; linarith
  have hT : Tgc ≠ 0 := by unfold Tgc; intro h0; linarith
  have hN : (1 + bgc ^ 2) ≠ 0 := by positivity
  have c1 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).1 = Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) * bgc := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have c2 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).2 = -(Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) * bgc) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have hcomp : ∀ (m n : ℤ) (Y : ℝ × ℝ), Jpow m (Jpow n Y) = Jpow (m + n) Y := by
    intro m n Y
    refine Prod.ext ?_ ?_
    · rw [c1 m, c1 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
      field_simp
      ring
    · rw [c2 m, c2 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
      field_simp
      ring
  have hid : ∀ Y : ℝ × ℝ, Jpow 0 Y = Y := by
    intro Y
    refine Prod.ext ?_ ?_
    · rw [c1, zpow_zero, zpow_zero]
      field_simp
      ring
    · rw [c2, zpow_zero, zpow_zero]
      field_simp
      ring
  have hsym : ∀ (n : ℤ) (Y W : ℝ × ℝ), (Jpow n Y).1 * W.1 + (Jpow n Y).2 * W.2 =
      Y.1 * (Jpow n W).1 + Y.2 * (Jpow n W).2 := by
    intro n Y W
    rw [c1 n Y, c2 n Y, c1 n W, c2 n W]
    field_simp
    ring
  have hNinv : ∀ x : ℝ, x / (1 + bgc ^ 2) = x * (2 + Real.sqrt 2) / 4 := by
    intro x
    rw [div_eq_div_iff hN (by norm_num)]
    unfold bgc
    linear_combination (-x * Real.sqrt 2) * hs
  have hJ1 : ∀ Y : ℝ × ℝ, Jpow 1 Y = (3 * Y.1 + Y.2, Y.1 + 5 * Y.2) := by
    intro Y
    refine Prod.ext ?_ ?_
    · rw [c1, zpow_one, zpow_one, hNinv, hNinv]
      unfold Lgc Tgc bgc
      linear_combination ((Real.sqrt 2 ^ 2 + 4 * Real.sqrt 2 - 2) * Y.1 + 2 * (Real.sqrt 2 + 1) * Y.2) / 4 * hs
    · rw [c2, zpow_one, zpow_one, hNinv, hNinv]
      unfold Lgc Tgc bgc
      linear_combination (2 * (Real.sqrt 2 + 1) * Y.1 - (Real.sqrt 2 ^ 2 - 4 * Real.sqrt 2 - 2) * Y.2) / 4 * hs
  have hint : ∀ k : ℕ, ∀ i j : ℤ, ∃ i' j' : ℤ,
      Jpow (k : ℤ) ((i : ℝ), (j : ℝ)) = ((i' : ℝ), (j' : ℝ)) := by
    intro k
    induction k with
    | zero => intro i j; exact ⟨i, j, by rw [Nat.cast_zero, hid]⟩
    | succ k ih =>
      intro i j
      obtain ⟨i', j', h'⟩ := ih i j
      refine ⟨3 * i' + j', i' + 5 * j', ?_⟩
      have e : ((k + 1 : ℕ) : ℤ) = 1 + (k : ℤ) := by push_cast; ring
      rw [e, ← hcomp 1 k, h', hJ1]
      push_cast
      rfl
  have hup : ∀ (a : ℝ × ℝ) (c d : ℤ), c ≤ d → (∃ n m : ℤ, Jpow c a = ((n:ℝ), (m:ℝ))) →
      ∃ n m : ℤ, Jpow d a = ((n:ℝ), (m:ℝ)) := by
    intro a c d hcd hc
    obtain ⟨a0, b0, hab⟩ := hc
    obtain ⟨k, hk⟩ := Int.le.dest hcd
    obtain ⟨a1, b1, hJk'⟩ := hint k a0 b0
    refine ⟨a1, b1, ?_⟩
    have hJk : Jpow d a = Jpow (k : ℤ) (Jpow c a) := by
      rw [hcomp, ← hk, add_comm]
    rw [hJk, hab, hJk']

  have hh0 : 0 < B.h := hok.2.1.1
  have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hT1 : 1 < Tgc := by unfold Tgc; nlinarith
  have hlT0 : 0 < Real.log Tgc := Real.log_pos hT1
  obtain ⟨φ, hφ⟩ : ∃ φ : ℕ → ℝ, φ = fun l : ℕ => (1 + B.h) * (l:ℝ) * Real.log 2 - 2 * Real.log (l:ℝ) :=
    ⟨_, rfl⟩
  have hφv : ∀ l : ℕ, φ l = (1 + B.h) * (l:ℝ) * Real.log 2 - 2 * Real.log (l:ℝ) := fun l => by rw [hφ]
  have hφdef : ∀ l : ℕ, 1 ≤ l → bandIdx B.h l = ⌊φ l / Real.log Tgc⌋ := by
    intro l hl
    have hl0 : (0:ℝ) < l := by exact_mod_cast hl
    unfold bandIdx
    congr 1
    unfold Real.logb
    rw [hφv, Real.log_div (Real.rpow_pos_of_pos two_pos _).ne' (pow_pos hl0 2).ne',
      Real.log_rpow two_pos, Real.log_pow]
    push_cast; ring
  have hstep : ∀ m : ℕ, 3 ≤ m → φ m ≤ φ (m+1) := by
    intro m hm
    have hm3 : (3:ℝ) ≤ m := by exact_mod_cast hm
    have hm0 : (0:ℝ) < m := by linarith
    have hsq : ((m:ℝ) + 1) ^ 2 ≤ 2 * (m:ℝ) ^ 2 := by nlinarith
    have hlog := Real.log_le_log (by positivity) hsq
    rw [Real.log_mul (by norm_num) (by positivity), Real.log_pow, Real.log_pow] at hlog
    rw [hφv, hφv]
    push_cast at hlog ⊢
    nlinarith [mul_pos hh0 hl2]
  have hmono : ∀ a b : ℕ, 3 ≤ a → a ≤ b → φ a ≤ φ b := by
    intro a b ha hab
    induction b, hab using Nat.le_induction with
    | base => exact le_rfl
    | succ n hn ih => exact ih.trans (hstep n (le_trans ha hn))
  have hbmono : ∀ a b : ℕ, 3 ≤ a → a ≤ b → bandIdx B.h a ≤ bandIdx B.h b := by
    intro a b ha hab
    rw [hφdef a (by omega), hφdef b (by omega)]
    exact Int.floor_mono (div_le_div_of_nonneg_right (hmono a b ha hab) hlT0.le)
  have hbof : ∀ p : ℝ, 0 < p → bandOf p = ⌈-Real.log p / Real.log 2⌉₊ := by
    intro p hp
    unfold bandOf Real.logb
    rw [one_div, Real.log_inv]

  have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have hq7 : qC B.h ξ < (2:ℝ) ^ (-(7:ℝ)) := by
    have e : qsOf l0 = (2:ℝ) ^ (-(l0:ℝ)) := rfl
    have h7 : (7:ℝ) ≤ l0 := by exact_mod_cast hl07
    have : (2:ℝ) ^ (-(l0:ℝ)) ≤ (2:ℝ) ^ (-(7:ℝ)) :=
      Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
    have h3 := hξ'.2.2
    rw [e] at h3
    linarith
  have hlq7 : Real.log (qC B.h ξ) < -7 * Real.log 2 := by
    have := Real.log_lt_log hq0 hq7
    rw [Real.log_rpow two_pos] at this; linarith
  obtain ⟨l', hl'⟩ : ∃ l' : ℕ, l' = bandOf (qC B.h ξ) := ⟨_, rfl⟩
  have hx7 : 7 < -Real.log (qC B.h ξ) / Real.log 2 := by rw [lt_div_iff₀ hl2]; linarith
  have hle : -Real.log (qC B.h ξ) / Real.log 2 ≤ l' := by
    rw [hl', hbof _ hq0]; exact Nat.le_ceil _
  have hlt : (l':ℝ) < -Real.log (qC B.h ξ) / Real.log 2 + 1 := by
    rw [hl', hbof _ hq0]; exact Nat.ceil_lt_add_one (by linarith)
  have hu2 : ((l':ℝ) - 1) * Real.log 2 < -Real.log (qC B.h ξ) := by
    have : (l':ℝ) - 1 < -Real.log (qC B.h ξ) / Real.log 2 := by linarith
    exact (lt_div_iff₀ hl2).mp this
  have hl'8 : 8 ≤ l' := by
    have h7 : (7:ℝ) < l' := lt_of_lt_of_le hx7 hle
    have h7' : 7 < l' := by exact_mod_cast h7
    omega
  have hpow : 0 < (2:ℝ) ^ (-((l':ℝ) - 1)) := Real.rpow_pos_of_pos two_pos _
  have hqlt : qC B.h ξ < (2:ℝ) ^ (-((l':ℝ) - 1)) := by
    rw [← Real.log_lt_log_iff hq0 hpow, Real.log_rpow two_pos]; linarith
  have hloc : ∀ q' : ℝ, 0 < q' → q' < (2:ℝ) ^ (-((l':ℝ) - 1)) →
      coarseIdx B.h (qC B.h ξ) ≤ coarseIdx B.h q' := by
    intro q' hq'0 hq'lt
    have hlog' : Real.log q' < -((l':ℝ) - 1) * Real.log 2 := by
      have := Real.log_lt_log hq'0 hq'lt
      rwa [Real.log_rpow two_pos] at this
    have hx' : ((l' - 1 : ℕ) : ℝ) < -Real.log q' / Real.log 2 := by
      rw [Nat.cast_sub (by omega), lt_div_iff₀ hl2]; push_cast; linarith
    have hb' : l' ≤ bandOf q' := by
      have := Nat.lt_ceil.mpr hx'
      rw [← hbof q' hq'0] at this; omega
    have e1 : coarseIdx B.h (qC B.h ξ) = bandIdx B.h (l' - 4) := by unfold coarseIdx; rw [← hl']
    have e2 : coarseIdx B.h q' = bandIdx B.h (bandOf q' - 4) := rfl
    rw [e1, e2]
    exact hbmono (l' - 4) (bandOf q' - 4) (by omega) (by omega)

  have hb4 : 0 ≤ bandIdx B.h 4 := by
    rw [hφdef 4 (by norm_num)]
    apply Int.floor_nonneg.mpr
    apply div_nonneg _ hlT0.le
    rw [hφv]
    have e4 : Real.log ((4:ℕ):ℝ) = 2 * Real.log 2 := by
      rw [show ((4:ℕ):ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; norm_num
    rw [e4]
    push_cast
    nlinarith [mul_pos hh0 hl2]
  have hi0nn : 0 ≤ coarseIdx B.h (qC B.h ξ) := by
    have e1 : coarseIdx B.h (qC B.h ξ) = bandIdx B.h (l' - 4) := by unfold coarseIdx; rw [← hl']
    rw [e1]
    exact le_trans hb4 (hbmono 4 (l' - 4) (by norm_num) (by omega))

  have hO : IsOpen ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) :=
    (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
  have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
    hok.1.2.2.2.1.continuousOn
  have hφc : Continuous (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by fun_prop
  have hmaps : Set.MapsTo (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ))
      ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
    intro η hη
    have h' : η.2.2.1 < 1 := hη.2
    exact ⟨mem_univ _, show (0:ℝ) < 1 - η.2.2.1 by linarith⟩
  have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
      (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)))
      ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) := h4'.comp hφc.continuousOn hmaps
  have hqcont : ContinuousOn (qC B.h) ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) := hc
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have h3' := hqcont.isOpen_inter_preimage hO (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'

  have hstab : ∀ ζ : Cyl, qC B.h ζ = qC B.h ξ → ζ ∈ ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) →
      ∀ a : ℝ × ℝ, IsDeck B.h (qC B.h ξ) a → ∀ᶠ η in nhds ζ, IsDeck B.h (qC B.h η) a := by
    intro ζ hζq hζO a ha
    have hcA : ContinuousAt (qC B.h) ζ := hqcont.continuousAt (hO.mem_nhds hζO)
    have hqltζ : qC B.h ζ < (2:ℝ) ^ (-((l':ℝ) - 1)) := by rw [hζq]; exact hqlt
    have E1 : ∀ᶠ η in nhds ζ, qC B.h η < (2:ℝ) ^ (-((l':ℝ) - 1)) :=
      hcA.eventually (gt_mem_nhds hqltζ)
    have E2 : ∀ᶠ η in nhds ζ, η ∈ ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) :=
      hO.mem_nhds hζO
    filter_upwards [E1, E2] with η h1 h2
    have h2' : η.2.2.1 < 1 := h2.2
    have hqη : 0 < qC B.h η := (hok.1.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
    exact hup a _ _ (hloc _ hqη h1) ha

  have hD1 : ∀ n m : ℤ, IsDeck B.h (qC B.h ξ) ((n:ℝ), (m:ℝ)) := by
    intro n m
    obtain ⟨k', hk'⟩ := Int.eq_ofNat_of_zero_le hi0nn
    unfold IsDeck
    rw [hk']
    exact hint k' n m
  have hD2a : IsDeck B.h (qC B.h ξ) (Jpow (-(coarseIdx B.h (qC B.h ξ))) ((1:ℝ), (0:ℝ))) := by
    refine ⟨1, 0, ?_⟩
    rw [hcomp, add_neg_cancel, hid]
    simp
  have hD2b : IsDeck B.h (qC B.h ξ) (Jpow (-(coarseIdx B.h (qC B.h ξ))) ((0:ℝ), (1:ℝ))) := by
    refine ⟨0, 1, ?_⟩
    rw [hcomp, add_neg_cancel, hid]
    simp

  have hinvD : ∀ a : ℝ × ℝ, IsDeck B.h (qC B.h ξ) a → ∀ Y : ℝ × ℝ,
      iteratedFDeriv ℝ k g (ξ.1, ξ.2.1, ξ.2.2.1, Y + a) w =
        iteratedFDeriv ℝ k g (ξ.1, ξ.2.1, ξ.2.2.1, Y) w := by
    intro a ha Y
    have hζD : ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) ∈ DomC B.h (qsOf l0) := hξ
    have hζO : ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) ∈ ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) :=
      ⟨hξ'.1, hξ'.2.1⟩
    have hev : (fun z : Cyl => g (z + ((0:ℝ), (0:ℝ), (0:ℝ), a))) =ᶠ[nhds ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl)] g := by
      filter_upwards [hstab ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) rfl hζO a ha, hDopen.mem_nhds hζD] with η h1 h2
      have e : η + ((0:ℝ), (0:ℝ), (0:ℝ), a) = shY η a := by
        ext <;> simp [shY]
      rw [e]
      exact hg.2.1 η h2 a h1
    have e2 : ((ξ.1, ξ.2.1, ξ.2.2.1, Y + a) : Cyl) =
        ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) + ((0:ℝ), (0:ℝ), (0:ℝ), a) := by
      ext <;> simp
    rw [e2, ← iteratedFDeriv_comp_add_right, (hev.iteratedFDeriv ℝ k).eq_of_nhds]

  have hcont : Continuous (fun Y : ℝ × ℝ => iteratedFDeriv ℝ k g (ξ.1, ξ.2.1, ξ.2.2.1, Y) w) := by
    rw [continuous_iff_continuousAt]
    intro Y
    have hζD : ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) ∈ DomC B.h (qsOf l0) := hξ
    have hcd : ContDiffAt ℝ ∞ g ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) := hg.1.contDiffAt (hDopen.mem_nhds hζD)
    have h1 : ContinuousAt (iteratedFDeriv ℝ k g) ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) :=
      hcd.continuousAt_iteratedFDeriv (by exact_mod_cast le_top)
    have hP : Continuous (fun Y : ℝ × ℝ => ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl)) := by fun_prop
    have hPc : ContinuousAt (fun Y : ℝ × ℝ => ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl)) Y := hP.continuousAt
    have h2 : ContinuousAt (fun Y : ℝ × ℝ => iteratedFDeriv ℝ k g ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl)) Y :=
      ContinuousAt.comp (g := iteratedFDeriv ℝ k g) h1 hPc
    exact (continuous_eval_const w).continuousAt.comp h2
  have hper : ∀ (n m : ℤ) (Y : ℝ × ℝ),
      iteratedFDeriv ℝ k g (ξ.1, ξ.2.1, ξ.2.2.1, Y + ((n:ℝ), (m:ℝ))) w =
        iteratedFDeriv ℝ k g (ξ.1, ξ.2.1, ξ.2.2.1, Y) w :=
    fun n m Y => hinvD _ (hD1 n m) Y

  have per1 : ∀ (ψ : ℝ → ℂ), Function.Periodic ψ 1 → ∀ b : ℝ,
      ∫ y in Icc (0:ℝ) 1, ψ (y + b) = ∫ y in Icc (0:ℝ) 1, ψ y := by
    intro ψ hψ b
    rw [integral_Icc_eq_integral_Ioc, integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le zero_le_one, ← intervalIntegral.integral_of_le zero_le_one,
      intervalIntegral.integral_comp_add_right, zero_add, add_comm 1 b,
      hψ.intervalIntegral_add_eq b 0, zero_add]

  have cell : ∀ (Φ : ℝ × ℝ → ℂ), Continuous Φ →
      (∀ (n m : ℤ) (Y : ℝ × ℝ), Φ (Y + ((n : ℝ), (m : ℝ))) = Φ Y) →
      ∀ b : ℝ × ℝ, ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Φ (Z + b) =
        ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Φ Z := by
    intro Φ hΦ hp b
    have fub : ∀ Ψ : ℝ × ℝ → ℂ, Continuous Ψ →
        ∫ Z in (Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1), Ψ Z =
          ∫ x in Icc (0:ℝ) 1, ∫ y in Icc (0:ℝ) 1, Ψ (x, y) := by
      intro Ψ hΨ
      rw [Measure.volume_eq_prod]
      exact setIntegral_prod Ψ
        ((hΨ.continuousOn).integrableOn_compact (isCompact_Icc.prod isCompact_Icc))
    rw [fub (fun Z => Φ (Z + b)) (hΦ.comp (continuous_id.add continuous_const)), fub _ hΦ]
    have h1 : ∀ x : ℝ, ∫ y in Icc (0:ℝ) 1, Φ ((x, y) + b) =
        ∫ y in Icc (0:ℝ) 1, Φ (x + b.1, y) := by
      intro x
      have hper1 : Function.Periodic (fun y => Φ (x + b.1, y)) 1 := by
        intro y
        have := hp 0 1 (x + b.1, y)
        simpa using this
      exact per1 _ hper1 b.2
    have hχ : Function.Periodic (fun u => ∫ y in Icc (0:ℝ) 1, Φ (u, y)) 1 := by
      intro u
      show ∫ y in Icc (0:ℝ) 1, Φ (u + 1, y) = ∫ y in Icc (0:ℝ) 1, Φ (u, y)
      congr 1
      funext y
      have := hp 1 0 (u, y)
      simpa using this
    rw [show (fun x => ∫ y in Icc (0:ℝ) 1, Φ ((x, y) + b)) =
        fun x => (fun u => ∫ y in Icc (0:ℝ) 1, Φ (u, y)) (x + b.1) from funext h1]
    exact per1 _ hχ b.1

  have hann : ∀ a : ℝ × ℝ, (∀ Y : ℝ × ℝ, iteratedFDeriv ℝ k g (ξ.1, ξ.2.1, ξ.2.2.1, Y + a) w =
      iteratedFDeriv ℝ k g (ξ.1, ξ.2.1, ξ.2.2.1, Y) w) →
      ∃ n : ℤ, (κ.1 : ℝ) * a.1 + (κ.2 : ℝ) * a.2 = (n : ℝ) := by
    intro a hinv
    obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ × ℝ → ℂ, Φ = fun Z => (iteratedFDeriv ℝ k g (ξ.1, ξ.2.1, ξ.2.2.1, Z) w : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (Z.1 : ℂ) + (κ.2 : ℂ) * (Z.2 : ℂ))) :=
      ⟨_, rfl⟩
    have hfour : fourY (fun η => iteratedFDeriv ℝ k g η w) ξ κ =
        ∫ Z in (Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1), Φ Z := by
      rw [hΦ]; rfl
    have hΦc : Continuous Φ := by
      rw [hΦ]
      refine (Complex.continuous_ofReal.comp hcont).mul (Complex.continuous_exp.comp ?_)
      fun_prop
    have hΦp : ∀ (n m : ℤ) (Y : ℝ × ℝ), Φ (Y + ((n : ℝ), (m : ℝ))) = Φ Y := by
      intro n m Y
      rw [hΦ]
      dsimp only
      rw [hper n m Y]
      congr 1
      rw [Complex.exp_eq_exp_iff_exists_int]
      refine ⟨-(κ.1 * n + κ.2 * m), ?_⟩
      simp only [Prod.fst_add, Prod.snd_add]
      push_cast
      ring
    have hsh : ∀ Z : ℝ × ℝ, Φ (Z + a) = Φ Z *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (a.1 : ℂ) + (κ.2 : ℂ) * (a.2 : ℂ))) := by
      intro Z
      rw [hΦ]
      dsimp only
      rw [hinv Z, mul_assoc _ (Complex.exp _) (Complex.exp _), ← Complex.exp_add]
      congr 2
      simp only [Prod.fst_add, Prod.snd_add]
      push_cast
      ring
    have htr := cell Φ hΦc hΦp a
    rw [show (fun Z => Φ (Z + a)) = fun Z => Φ Z *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (a.1 : ℂ) + (κ.2 : ℂ) * (a.2 : ℂ)))
        from funext hsh, integral_mul_const, ← hfour] at htr
    have hc1 := (mul_eq_left₀ hκ).mp htr
    obtain ⟨n, hn⟩ := Complex.exp_eq_one_iff.mp hc1
    refine ⟨-n, ?_⟩
    have hne : (2 * (Real.pi : ℂ) * Complex.I) ≠ 0 := Complex.two_pi_I_ne_zero
    have h2 : ((κ.1 : ℂ) * (a.1 : ℂ) + (κ.2 : ℂ) * (a.2 : ℂ)) = -(n : ℂ) := by
      apply mul_right_cancel₀ hne
      linear_combination -hn
    apply Complex.ofReal_injective
    push_cast
    linear_combination h2

  obtain ⟨n1, hn1⟩ := hann _ (hinvD _ hD2a)
  obtain ⟨n2, hn2⟩ := hann _ (hinvD _ hD2b)
  have s1 := hsym (-(coarseIdx B.h (qC B.h ξ))) ((κ.1 : ℝ), (κ.2 : ℝ)) ((1:ℝ), (0:ℝ))
  have s2 := hsym (-(coarseIdx B.h (qC B.h ξ))) ((κ.1 : ℝ), (κ.2 : ℝ)) ((0:ℝ), (1:ℝ))
  simp only [mul_one, mul_zero, add_zero, zero_add] at s1 s2
  have hV : Jpow (-(coarseIdx B.h (qC B.h ξ))) ((κ.1 : ℝ), (κ.2 : ℝ)) = ((n1 : ℝ), (n2 : ℝ)) :=
    Prod.ext (by linarith [s1, hn1]) (by linarith [s2, hn2])
  refine ⟨(n1, n2), ?_⟩
  show Jpow (coarseIdx B.h (qC B.h ξ)) ((n1 : ℝ), (n2 : ℝ)) = _
  rw [← hV, hcomp, add_neg_cancel, hid]

theorem tn_series_bound_v5 : ∀ (G : Cyl → ℝ) (ξ : Cyl) (n0 : ℤ) (A : ℝ), 0 ≤ n0 →
    (∀ κ : ℤ × ℤ, fourY G ξ κ ≠ 0 →
      ∃ κ' : ℤ × ℤ, Jpow n0 ((κ'.1 : ℝ), (κ'.2 : ℝ)) = ((κ.1 : ℝ), (κ.2 : ℝ))) →
    (∀ κ κ' : ℤ × ℤ, Jpow n0 ((κ'.1 : ℝ), (κ'.2 : ℝ)) = ((κ.1 : ℝ), (κ.2 : ℝ)) →
      ‖fourY G ξ κ‖ * (1 + |(κ'.1 : ℝ)| + |(κ'.2 : ℝ)|) ^ 5 ≤ A) →
    |TN G ξ| ≤ 3 * A * Tgc ^ (-n0) * ∑' κ : ℤ × ℤ, 1 / (1 + |(κ.1 : ℝ)| + |(κ.2 : ℝ)|) ^ 4 :=
by
  intro G ξ n0 A hn0 hsupp hdec
  obtain ⟨-, LF2, LF3, LF4, -, LF6, -, -, -⟩ := tn_lattice_facts_v5 (1/8) (by norm_num) (by norm_num)

  have dio : ∀ k1 k2 : ℤ, (k1, k2) ≠ (0, 0) →
      1 ≤ 3 * (1 + |(k1:ℝ)| + |(k2:ℝ)|) * |bgc * (k1:ℝ) + (k2:ℝ)| := by
    intro k1 k2 hk
    have hs2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
    have hs15 : Real.sqrt 2 < 1.5 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
    have hxy : (bgc * (k1:ℝ) + (k2:ℝ)) * ((Real.sqrt 2 + 1) * (k1:ℝ) - (k2:ℝ)) =
        ((2 * k1 ^ 2 - (k2 - k1) ^ 2 : ℤ) : ℝ) := by
      push_cast
      have e : (bgc * (k1:ℝ) + (k2:ℝ)) * ((Real.sqrt 2 + 1) * (k1:ℝ) - (k2:ℝ)) =
          Real.sqrt 2 ^ 2 * (k1:ℝ) ^ 2 - ((k2:ℝ) - k1) ^ 2 := by unfold bgc; ring
      rw [e, hs2]
    have hz : (2 * k1 ^ 2 - (k2 - k1) ^ 2 : ℤ) ≠ 0 := by
      intro h0
      by_cases hk1 : k1 = 0
      · subst hk1
        have h3 : k2 ^ 2 = 0 := by nlinarith [h0]
        have hk2 : k2 = 0 := (pow_eq_zero_iff two_ne_zero).mp h3
        exact hk (by rw [hk2])
      · have hirr := (irrational_iff_ne_rational _).mp irrational_sqrt_two |(k2 - k1)| |k1|
          (abs_ne_zero.mpr hk1)
        apply hirr
        have h2 : (2:ℝ) * (k1:ℝ) ^ 2 = ((k2:ℝ) - k1) ^ 2 := by
          have := congrArg (fun z : ℤ => (z : ℝ)) h0
          push_cast at this
          linarith
        have hk1r : (k1:ℝ) ≠ 0 := by exact_mod_cast hk1
        rw [Int.cast_abs, Int.cast_abs, Int.cast_sub, eq_div_iff (abs_ne_zero.mpr hk1r)]
        have hA : 0 ≤ Real.sqrt 2 * |(k1:ℝ)| := by positivity
        have hB : 0 ≤ |(k2:ℝ) - k1| := abs_nonneg _
        have hsq : (Real.sqrt 2 * |(k1:ℝ)|) ^ 2 = |(k2:ℝ) - k1| ^ 2 := by
          rw [mul_pow, hs2, sq_abs, sq_abs]; exact h2
        exact (pow_left_inj₀ hA hB two_ne_zero).mp hsq
    have hyb : |(Real.sqrt 2 + 1) * (k1:ℝ) - (k2:ℝ)| ≤ 3 * (1 + |(k1:ℝ)| + |(k2:ℝ)|) := by
      have a1 := le_abs_self (k1:ℝ)
      have a2 := neg_abs_le (k1:ℝ)
      have b1 := le_abs_self (k2:ℝ)
      have b2 := neg_abs_le (k2:ℝ)
      have hs1 : Real.sqrt 2 + 1 ≤ 3 := by linarith
      have hp : 0 < Real.sqrt 2 + 1 := by positivity
      rw [abs_le]
      constructor <;> nlinarith [mul_le_mul_of_nonneg_left a1 hp.le, mul_le_mul_of_nonneg_left a2 hp.le,
        mul_le_mul_of_nonneg_right hs1 (abs_nonneg (k1:ℝ))]
    have h1 : (1:ℝ) ≤ |bgc * (k1:ℝ) + (k2:ℝ)| * |(Real.sqrt 2 + 1) * (k1:ℝ) - (k2:ℝ)| := by
      rw [← abs_mul, hxy]
      exact_mod_cast Int.one_le_abs hz
    nlinarith [mul_le_mul_of_nonneg_left hyb (abs_nonneg (bgc * (k1:ℝ) + (k2:ℝ)))]

  have hsum : Summable (fun κ : ℤ × ℤ => 1 / (1 + |(κ.1 : ℝ)| + |(κ.2 : ℝ)|) ^ 4) := by
    have hf : Summable (fun n : ℤ => 1 / (1 + |(n:ℝ)|) ^ 2) := by
      have h := (Real.summable_one_div_int_add_rpow (1/2) 2).mpr (by norm_num)
      refine Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_) h
      rw [Real.rpow_two]
      have hne : (n:ℝ) + 1/2 ≠ 0 := by
        intro h0
        have h3 : (2:ℝ) * n = -1 := by linarith
        have h4 : (2 * n : ℤ) = -1 := by exact_mod_cast h3
        omega
      apply one_div_le_one_div_of_le
      · have := abs_pos.mpr hne
        positivity
      · have h5 : |(n:ℝ) + 1/2| ≤ 1 + |(n:ℝ)| := by
          rw [abs_le]
          constructor <;> linarith [le_abs_self (n:ℝ), neg_abs_le (n:ℝ)]
        exact pow_le_pow_left₀ (abs_nonneg _) h5 2
    have hprod := hf.mul_of_nonneg hf (fun n => by positivity) (fun n => by positivity)
    refine Summable.of_nonneg_of_le (fun κ => by positivity) (fun κ => ?_) hprod
    have ha := abs_nonneg (κ.1:ℝ)
    have hb := abs_nonneg (κ.2:ℝ)
    show 1 / (1 + |(κ.1 : ℝ)| + |(κ.2 : ℝ)|) ^ 4 ≤ 1 / (1 + |(κ.1:ℝ)|) ^ 2 * (1 / (1 + |(κ.2:ℝ)|) ^ 2)
    rw [div_mul_div_comm, one_mul]
    apply one_div_le_one_div_of_le (by positivity)
    have hL : (1 + |(κ.1:ℝ)|) * (1 + |(κ.2:ℝ)|) ≤ (1 + |(κ.1:ℝ)| + |(κ.2:ℝ)|) ^ 2 := by nlinarith
    calc (1 + |(κ.1:ℝ)|) ^ 2 * (1 + |(κ.2:ℝ)|) ^ 2 = ((1 + |(κ.1:ℝ)|) * (1 + |(κ.2:ℝ)|)) ^ 2 := by ring
      _ ≤ ((1 + |(κ.1:ℝ)| + |(κ.2:ℝ)|) ^ 2) ^ 2 := pow_le_pow_left₀ (by positivity) hL 2
      _ = _ := by ring

  have hT : 0 < Tgc := by unfold Tgc; positivity
  have hTn : 0 < Tgc ^ n0 := zpow_pos hT n0
  have hTm : 0 < Tgc ^ (-n0) := zpow_pos hT _
  have hTinv : Tgc ^ (-n0) * Tgc ^ n0 = 1 := by
    rw [zpow_neg]; exact inv_mul_cancel₀ hTn.ne'
  have hJ0 : Jpow n0 ((0:ℝ), (0:ℝ)) = ((0:ℝ), (0:ℝ)) := by
    ext <;> simp [Jpow]
  have h00 : Jpow n0 ((((0:ℤ × ℤ).1 : ℤ) : ℝ), (((0:ℤ × ℤ).2 : ℤ) : ℝ)) =
      ((((0:ℤ × ℤ).1 : ℤ) : ℝ), (((0:ℤ × ℤ).2 : ℤ) : ℝ)) := by
    show Jpow n0 (((0:ℤ) : ℝ), ((0:ℤ) : ℝ)) = (((0:ℤ) : ℝ), ((0:ℤ) : ℝ))
    rw [Int.cast_zero]
    exact hJ0
  have hA : 0 ≤ A := by
    have h := hdec 0 0 h00
    have : 0 ≤ ‖fourY G ξ 0‖ * (1 + |(((0:ℤ × ℤ).1 : ℤ) : ℝ)| + |(((0:ℤ × ℤ).2 : ℤ) : ℝ)|) ^ 5 := by
      positivity
    linarith

  have hex : ∀ κ' : ℤ × ℤ, ∃ κ : ℤ × ℤ,
      Jpow n0 ((κ'.1 : ℝ), (κ'.2 : ℝ)) = ((κ.1 : ℝ), (κ.2 : ℝ)) := by
    intro κ'
    obtain ⟨i, j, hij⟩ := LF2 n0 κ'.1 κ'.2 hn0
    exact ⟨(i, j), hij⟩
  choose φ hφ using hex
  have hcast : ∀ x y : ℤ × ℤ, ((x.1 : ℝ), (x.2 : ℝ)) = ((y.1 : ℝ), (y.2 : ℝ)) → x = y := by
    intro x y h
    have h1 : (x.1 : ℝ) = y.1 := congrArg Prod.fst h
    have h2 : (x.2 : ℝ) = y.2 := congrArg Prod.snd h
    exact Prod.ext (by exact_mod_cast h1) (by exact_mod_cast h2)
  have hinj : Function.Injective φ := by
    intro x y hxy
    apply hcast
    have h1 : Jpow n0 ((x.1 : ℝ), (x.2 : ℝ)) = Jpow n0 ((y.1 : ℝ), (y.2 : ℝ)) := by
      rw [hφ x, hφ y, hxy]
    have h2 := congrArg (Jpow (-n0)) h1
    rwa [LF3, LF3, neg_add_cancel, LF4, LF4] at h2
  have hhit : ∀ κ κ' : ℤ × ℤ, Jpow n0 ((κ'.1 : ℝ), (κ'.2 : ℝ)) = ((κ.1 : ℝ), (κ.2 : ℝ)) →
      φ κ' = κ := by
    intro κ κ' h
    apply hcast
    rw [← hφ κ', h]
  have hφ0 : φ 0 = 0 := hhit 0 0 h00

  obtain ⟨t, ht⟩ : ∃ t : ℤ × ℤ → ℂ, t = fun k => if k = 0 then (0:ℂ) else
      fourY G ξ k / (2 * Real.pi * Complex.I * ((bgc * (k.1 : ℝ) + (k.2 : ℝ) : ℝ) : ℂ)) *
        Complex.exp ((2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (ξ.2.2.2.1 : ℂ) + (k.2 : ℂ) * (ξ.2.2.2.2 : ℂ))) :=
    ⟨_, rfl⟩
  have hTN : TN G ξ = (∑' k, t k).re := by rw [ht]; rfl

  have hsup : Function.support t ⊆ Set.range φ := by
    intro κ hκ
    rw [Function.mem_support] at hκ
    have hk0 : κ ≠ 0 := by
      intro h0; apply hκ; rw [ht]; dsimp only; rw [if_pos h0]
    have hF : fourY G ξ κ ≠ 0 := by
      intro h0; apply hκ; rw [ht]; dsimp only; rw [if_neg hk0, h0, zero_div, zero_mul]
    obtain ⟨κ', hκ'⟩ := hsupp κ hF
    exact ⟨κ', hhit κ κ' hκ'⟩
  have hre : ∑' κ', t (φ κ') = ∑' κ, t κ := hinj.tsum_eq hsup

  have hterm : ∀ κ' : ℤ × ℤ, ‖t (φ κ')‖ ≤
      3 * A * Tgc ^ (-n0) * (1 / (1 + |(κ'.1 : ℝ)| + |(κ'.2 : ℝ)|) ^ 4) := by
    intro κ'
    have hX0 : 0 < 1 + |(κ'.1 : ℝ)| + |(κ'.2 : ℝ)| := by
      linarith [abs_nonneg (κ'.1:ℝ), abs_nonneg (κ'.2:ℝ)]
    have hβ0 : 0 ≤ 3 * A * Tgc ^ (-n0) * (1 / (1 + |(κ'.1 : ℝ)| + |(κ'.2 : ℝ)|) ^ 4) :=
      mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hA) hTm.le) (by positivity)
    obtain ⟨κ, hκ⟩ : ∃ κ, φ κ' = κ := ⟨_, rfl⟩
    have hJκ : Jpow n0 ((κ'.1 : ℝ), (κ'.2 : ℝ)) = ((κ.1 : ℝ), (κ.2 : ℝ)) := by rw [hφ κ', hκ]
    rw [hκ]
    by_cases hk0 : κ = 0
    · rw [ht]; dsimp only; rw [if_pos hk0, norm_zero]; exact hβ0
    · have hk'0 : κ' ≠ 0 := by
        intro h; apply hk0; rw [← hκ, h]; exact hφ0
      have hne : (κ'.1, κ'.2) ≠ ((0:ℤ), (0:ℤ)) := by
        intro h; exact hk'0 (Prod.ext (congrArg Prod.fst h) (congrArg Prod.snd h))
      have hd := dio κ'.1 κ'.2 hne
      obtain ⟨e, he⟩ : ∃ e : ℝ, e = bgc * (κ'.1:ℝ) + (κ'.2:ℝ) := ⟨_, rfl⟩
      rw [← he] at hd
      have hepos : 0 < |e| := by
        by_contra hneg
        rw [not_lt] at hneg
        have h00' : |e| = 0 := le_antisymm hneg (abs_nonneg _)
        rw [h00', mul_zero] at hd
        linarith
      have hdrel : bgc * (κ.1:ℝ) + (κ.2:ℝ) = Tgc ^ n0 * e := by
        have h6 := LF6 n0 ((κ'.1:ℝ), (κ'.2:ℝ))
        rw [hJκ] at h6
        rw [he]; exact h6
      rw [ht]; dsimp only; rw [if_neg hk0]
      rw [norm_mul, norm_div]
      have hE : ‖Complex.exp ((2 * Real.pi * Complex.I) *
          ((κ.1 : ℂ) * (ξ.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (ξ.2.2.2.2 : ℂ)))‖ = 1 := by
        have h' : (2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (ξ.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (ξ.2.2.2.2 : ℂ)) =
            ((2 * Real.pi * ((κ.1:ℝ) * ξ.2.2.2.1 + (κ.2:ℝ) * ξ.2.2.2.2) : ℝ) : ℂ) * Complex.I := by
          push_cast; ring
        rw [h', Complex.norm_exp_ofReal_mul_I]
      have hnorm : ‖(2 * Real.pi * Complex.I * (((bgc * (κ.1:ℝ) + (κ.2:ℝ)) : ℝ) : ℂ))‖ =
          2 * Real.pi * |bgc * (κ.1:ℝ) + (κ.2:ℝ)| := by
        simp only [norm_mul, Complex.norm_two, Complex.norm_real, Complex.norm_I, Real.norm_eq_abs,
          abs_of_pos Real.pi_pos, mul_one]
      rw [hE, hnorm, mul_one, hdrel, abs_mul, abs_of_pos hTn]
      have hdk := hdec κ κ' hJκ
      obtain ⟨X, hX⟩ : ∃ X : ℝ, X = 1 + |(κ'.1 : ℝ)| + |(κ'.2 : ℝ)| := ⟨_, rfl⟩
      rw [← hX] at hdk hd hX0 ⊢
      obtain ⟨u, hu⟩ : ∃ u : ℝ, u = ‖fourY G ξ κ‖ := ⟨_, rfl⟩
      rw [← hu] at hdk ⊢
      have hu0 : 0 ≤ u := by rw [hu]; exact norm_nonneg _
      have hX4 : 0 < X ^ 4 := by positivity
      have h1 : u * X ≤ A / X ^ 4 := by
        rw [le_div_iff₀ hX4]
        calc u * X * X ^ 4 = u * X ^ 5 := by ring
          _ ≤ A := hdk
      have hAX : 0 ≤ A / X ^ 4 := div_nonneg hA hX4.le
      have h2 : u ≤ 3 * |e| * (A / X ^ 4) := by
        calc u = u * 1 := by ring
          _ ≤ u * (3 * X * |e|) := mul_le_mul_of_nonneg_left hd hu0
          _ = 3 * |e| * (u * X) := by ring
          _ ≤ 3 * |e| * (A / X ^ 4) := mul_le_mul_of_nonneg_left h1 (by positivity)
      have hD : 0 < 2 * Real.pi * (Tgc ^ n0 * |e|) := by positivity
      rw [div_le_iff₀ hD]
      have hpi : (1:ℝ) ≤ 2 * Real.pi := by linarith [Real.pi_gt_three]
      calc u ≤ 3 * |e| * (A / X ^ 4) := h2
        _ ≤ 3 * |e| * (A / X ^ 4) * (2 * Real.pi) :=
            le_mul_of_one_le_right (mul_nonneg (by positivity) hAX) hpi
        _ = 3 * A * Tgc ^ (-n0) * (1 / X ^ 4) * (2 * Real.pi * (Tgc ^ n0 * |e|)) := by
            linear_combination (-(3 * |e| * (A / X ^ 4) * (2 * Real.pi))) * hTinv

  have hβ := hsum.hasSum.mul_left (3 * A * Tgc ^ (-n0))
  have hbd := tsum_of_norm_bounded (f := fun κ' => t (φ κ')) hβ hterm

  rw [hTN, ← hre]
  exact (Complex.abs_re_le_norm _).trans hbd

theorem tn_descent_bound_v5 : ∀ (B : BG), B.ok → ∀ l0 : ℕ, 8 ≤ l0 → ∀ (α : ℝ) (g : Cyl → ℝ),
    InM B (qsOf l0) α g → ∀ k : ℕ, ∃ C b d : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0),
    B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
    NB B.h (TN g) k ξ ≤ C * Tgc ^ (-(coarseIdx B.h (qC B.h ξ))) * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b *
      edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) :=
by
  intro B hok l0 hl0 α g hg k
  have hh : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
