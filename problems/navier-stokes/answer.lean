theorem slice_s3_hypotheses_v5 : ∀ (B : BG) (qs α : ℝ) (f : Cyl → ℝ), B.ok → 0 < qs → qs ≤ (2:ℝ) ^ (-(10:ℝ)) → InM B qs α f → ∀ k K : ℕ, ∃ C b : ℝ, 0 ≤ C ∧ ∀ (z t : ℝ) (v : Fin k → Cyl) (F : ℝ × (ℝ × ℝ) → ℝ), t < 1 → simScale B.h z (1 - t) < qs → (∀ x : ℝ × (ℝ × ℝ), F x = if 0 < x.1 then iteratedFDeriv ℝ k f (Real.sqrt (simScale B.h z (1 - t)) * x.1, z, t, x.2) v else 0) → ContDiff ℝ ∞ F ∧ (∀ (s : ℝ) (Y c : ℝ × ℝ), (∃ i j : ℤ, Jpow (coarseIdx B.h (simScale B.h z (1 - t))) c = ((i:ℝ), (j:ℝ))) → F (s, Y + c) = F (s, Y)) ∧ (∀ (s : ℝ) (Y : ℝ × ℝ), (s ≤ Real.sqrt (2 * B.Xa) ∨ Real.sqrt (2 * B.Xb) ≤ s) → F (s, Y) = 0) ∧ (∀ j : ℕ, j ≤ K → ∀ (s : ℝ) (Y : ℝ × ℝ), ‖(iteratedFDeriv ℝ j F (s, Y)).compContinuousLinearMap (fun _ => (ContinuousLinearMap.id ℝ ℝ).prodMap (JpowL (-(coarseIdx B.h (simScale B.h z (1 - t))))))‖ ≤ C * simScale B.h z (1 - t) ^ (B.h * α - 2 * (k:ℝ)) * (1 + |Real.log (simScale B.h z (1 - t))|) ^ b * ∏ i, ‖v i‖) :=
by
