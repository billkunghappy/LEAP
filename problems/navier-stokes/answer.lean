theorem ipb5_field_split : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S S' : CState) (α β : ℝ), B.ok → InWg5 B G (qsOf l0) α S.Aw → InWg5 B G (qsOf l0) β S'.Aw → InWg5 B G (qsOf l0) α S.pw → InWg5 B G (qsOf l0) β S'.pw → (↿(fA5 B G l0 S' - fA5 B G l0 S) = fun z => ipb5WV B G l0 (1/2 - Aex B.h) (S'.Aw - S.Aw) z + ipb5MV B l0 (1/2 - Aex B.h) (S'.Psi - S.Psi) z) ∧ (↿(fB B G l0 S' - fB B G l0 S) = ipb5MV B l0 (-Aex B.h) (S'.bdir - S.bdir)) ∧ (↿(fP5 B G l0 S' - fP5 B G l0 S) = fun z => ipb5MS B l0 (-2 * Aex B.h) (nrm B (2 * Aex B.h) (fun ξ => pmP5 B G l0 S' ξ - pmP5 B G l0 S ξ)) z + ipb5WS B G l0 (-2 * Aex B.h) (S'.pw - S.pw) z) :=
by
  intro B G l0 S S' α β hok hSA hS'A hSp hS'p

  have hΓfin : ∀ (h : ℝ) (ξ : Cyl), SimScaleProps h → ξ.2.2.1 < 1 →
      {γ : Lab | ξ ∈ tsupport (etaL h γ)}.Finite := by
    intro h ξ hS hξ
    have s1 : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ → 1 < |φ ξ / μ - (j : ℝ)| →
        ∀ᶠ η in nhds ξ, sqPart μ j (φ η) = 0 := by
      intro μ j φ hφ h1
      have hψ : ContinuousAt (fun η => |φ η / μ - (j : ℝ)|) ξ :=
        ((hφ.div_const μ).sub continuousAt_const).abs
      have hev := (continuousAt_const : ContinuousAt (fun _ : Cyl => (1:ℝ)) ξ).eventually_lt hψ h1
      filter_upwards [hev] with η hη
      have hsq : 1 < (φ η / μ - (j : ℝ)) ^ 2 := (one_lt_sq_iff_one_lt_abs _).mpr hη
      unfold sqPart bumpR
      rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_div]
    have hτ : 0 < 1 - ξ.2.2.1 := by linarith
    have hqpos : 0 < qC h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
    have hqcont : ContinuousAt (qC h) ξ := by
      have hU : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
      have hp : ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) :=
        ⟨trivial, hτ⟩
      have hg : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (ξ.2.1, 1 - ξ.2.2.1) :=
        hS.2.2.2.1.continuousOn.continuousAt (hU.mem_nhds hp)
      have hk : ContinuousAt (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) ξ := by fun_prop
      have he : qC h = (fun w : ℝ × ℝ => simScale h w.1 w.2) ∘
          (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by
        funext η; rfl
      rw [he]
      exact ContinuousAt.comp hg hk
    have hLc : ContinuousAt (fun η => Real.logb 2 (qC h η)) ξ := hqcont.logb hqpos.ne'
    have hwin : ∀ γ : Lab, ξ ∈ tsupport (etaL h γ) →
        |Real.logb 2 (qC h ξ) + (γ.1:ℝ)| ≤ 1 ∧
        |chartR h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1:ℝ)| ≤ 1 ∧
        |chartZ h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.1:ℝ)| ≤ 1 ∧
        |chartT h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2:ℝ)| ≤ 1 := by
      intro γ hγ
      have key : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ →
          (∀ η, sqPart μ j (φ η) = 0 → etaL h γ η = 0) → |φ ξ / μ - (j:ℝ)| ≤ 1 := by
        intro μ j φ hφ himp
        by_contra hc
        push_neg at hc
        have hev := s1 μ j φ hφ hc
        apply (notMem_tsupport_iff_eventuallyEq.mpr _) hγ
        filter_upwards [hev] with η hη
        exact himp η hη
      refine ⟨?_, ?_, ?_, ?_⟩
      · have := key 1 (-(γ.1:ℤ)) (fun η => Real.logb 2 (qC h η)) hLc
          (fun η hη => by simp only [etaL, hη, zero_mul])
        simpa [div_one, sub_neg_eq_add] using this
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.1 (chartR h γ.1) (by unfold chartR; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.1 (chartZ h γ.1) (by unfold chartZ; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.2 (chartT h γ.1) (by unfold chartT; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
    have hI : ∀ (c : ℝ) (j : ℤ), |c - (j:ℝ)| ≤ 1 → j ∈ Set.Icc ⌈c - 1⌉ ⌊c + 1⌋ := by
      intro c j hj
      rw [abs_le] at hj
      exact ⟨Int.ceil_le.mpr (by linarith [hj.2]), Int.le_floor.mpr (by linarith [hj.1])⟩
    have hfin : (⋃ n ∈ Set.Iic ⌊1 - Real.logb 2 (qC h ξ)⌋₊, ({n} : Set ℕ) ×ˢ
        ((Set.Icc ⌈chartR h n ξ / Sb n ^ (-3:ℤ) - 1⌉ ⌊chartR h n ξ / Sb n ^ (-3:ℤ) + 1⌋ ×ˢ
          Set.Icc ⌈chartZ h n ξ / Sb n ^ (-3:ℤ) - 1⌉ ⌊chartZ h n ξ / Sb n ^ (-3:ℤ) + 1⌋ ×ˢ
          Set.Icc ⌈chartT h n ξ / Sb n ^ (-3:ℤ) - 1⌉ ⌊chartT h n ξ / Sb n ^ (-3:ℤ) + 1⌋) ×ˢ
          (Set.univ : Set Bool))).Finite := by
      refine Set.Finite.biUnion (Set.finite_Iic _) (fun n _ => ?_)
      exact (Set.finite_singleton n).prod (((Set.finite_Icc _ _).prod
        ((Set.finite_Icc _ _).prod (Set.finite_Icc _ _))).prod Set.finite_univ)
    refine hfin.subset ?_
    rintro ⟨n, ⟨a, b, c⟩, σ⟩ hγ
    obtain ⟨h1, h2, h3, h4⟩ := hwin _ hγ
    rw [abs_le] at h1
    refine Set.mem_iUnion₂.mpr ⟨n, Nat.le_floor (by simp only at h1; linarith [h1.2]), ?_⟩
    exact ⟨rfl, ⟨hI _ _ h2, hI _ _ h3, hI _ _ h4⟩, trivial⟩

  have hsubV : ∀ (f g : WC) (a b : ℝ), InWg5 B G (qsOf l0) a f → InWg5 B G (qsOf l0) b g →
      ∀ (θ : ℝ) (ξ : Cyl), ξ ∈ DomC B.h (qsOf l0) →
        waveV5 B G (g - f) θ ξ = waveV5 B G g θ ξ - waveV5 B G f θ ξ := by
    intro f g a b hf hg θ ξ hξ
    obtain ⟨⟨Hf, -, hHf⟩, -, -, uf, -⟩ := hf
    obtain ⟨⟨Hg, -, hHg⟩, -, -, ug, -⟩ := hg
    have hξ1 : ξ.2.2.1 < 1 := hξ.2.1
    have hΓ := hΓfin B.h ξ hok.1 hξ1
    funext i
    simp only [waveV5, Pi.sub_apply]
    rw [← Complex.sub_re]
    congr 1
    have hin : ∀ γ : Lab, ∑ᶠ m : ℤ, (g γ m ξ i - f γ m ξ i) * ephase5 B G γ m θ ξ =
        ∑ᶠ m : ℤ, g γ m ξ i * ephase5 B G γ m θ ξ - ∑ᶠ m : ℤ, f γ m ξ i * ephase5 B G γ m θ ξ := by
      intro γ
      simp_rw [sub_mul]
      apply finsum_sub_distrib
      · refine Set.Finite.subset (Finset.finite_toSet Hg) ?_
        intro m hm
        by_contra hc
        rw [Function.mem_support] at hm
        apply hm
        rw [hHg γ m hc]
        simp
      · refine Set.Finite.subset (Finset.finite_toSet Hf) ?_
        intro m hm
        by_contra hc
        rw [Function.mem_support] at hm
        apply hm
        rw [hHf γ m hc]
        simp
    rw [finsum_congr hin]
    apply finsum_sub_distrib
    · refine Set.Finite.subset hΓ ?_
      intro γ hγ
      by_contra hc
      rw [Function.mem_support] at hγ
      apply hγ
      apply finsum_eq_zero_of_forall_eq_zero
      intro m
      have h0 : g γ m ξ = 0 := by
        by_contra hne
        exact hc (ug γ m ξ hξ hne).2.1
      rw [h0]
      simp
    · refine Set.Finite.subset hΓ ?_
      intro γ hγ
      by_contra hc
      rw [Function.mem_support] at hγ
      apply hγ
      apply finsum_eq_zero_of_forall_eq_zero
      intro m
      have h0 : f γ m ξ = 0 := by
        by_contra hne
        exact hc (uf γ m ξ hξ hne).2.1
      rw [h0]
      simp

  have hsubS : ∀ (f g : WS) (a b : ℝ), InWg5 B G (qsOf l0) a f → InWg5 B G (qsOf l0) b g →
      ∀ (θ : ℝ) (ξ : Cyl), ξ ∈ DomC B.h (qsOf l0) →
        waveS5 B G (g - f) θ ξ = waveS5 B G g θ ξ - waveS5 B G f θ ξ := by
    intro f g a b hf hg θ ξ hξ
    obtain ⟨⟨Hf, -, hHf⟩, -, -, uf, -⟩ := hf
    obtain ⟨⟨Hg, -, hHg⟩, -, -, ug, -⟩ := hg
    have hξ1 : ξ.2.2.1 < 1 := hξ.2.1
    have hΓ := hΓfin B.h ξ hok.1 hξ1
    simp only [waveS5, Pi.sub_apply]
    rw [← Complex.sub_re]
    congr 1
    have hin : ∀ γ : Lab, ∑ᶠ m : ℤ, (g γ m ξ - f γ m ξ) * ephase5 B G γ m θ ξ =
        ∑ᶠ m : ℤ, g γ m ξ * ephase5 B G γ m θ ξ - ∑ᶠ m : ℤ, f γ m ξ * ephase5 B G γ m θ ξ := by
      intro γ
      simp_rw [sub_mul]
      apply finsum_sub_distrib
      · refine Set.Finite.subset (Finset.finite_toSet Hg) ?_
        intro m hm
        by_contra hc
        rw [Function.mem_support] at hm
        apply hm
        rw [hHg γ m hc]
        simp
      · refine Set.Finite.subset (Finset.finite_toSet Hf) ?_
        intro m hm
        by_contra hc
        rw [Function.mem_support] at hm
        apply hm
        rw [hHf γ m hc]
        simp
    rw [finsum_congr hin]
    apply finsum_sub_distrib
    · refine Set.Finite.subset hΓ ?_
      intro γ hγ
      by_contra hc
      rw [Function.mem_support] at hγ
      apply hγ
      apply finsum_eq_zero_of_forall_eq_zero
      intro m
      have h0 : g γ m ξ = 0 := by
        by_contra hne
        exact hc (ug γ m ξ hξ hne).2.1
      rw [h0]
      simp
    · refine Set.Finite.subset hΓ ?_
      intro γ hγ
      by_contra hc
      rw [Function.mem_support] at hγ
      apply hγ
      apply finsum_eq_zero_of_forall_eq_zero
      intro m
      have h0 : f γ m ξ = 0 := by
        by_contra hne
        exact hc (uf γ m ξ hξ hne).2.1
      rw [h0]
      simp
  have hqpos : ∀ x t, corrOn B l0 x t → 0 < qC B.h (ptOf x t (Yph B.h (rad x) t + 0)) := by
    intro x t hc
    have ht : t < 1 := hc.2.1
    exact (hok.1.1 (x 2) (1 - t) (by linarith)).1
  refine ⟨funext fun z => ?_, funext fun z => ?_, funext fun z => ?_⟩
  · obtain ⟨x, t⟩ := z
    show AX5 B G l0 S' x t (Yph B.h (rad x) t + 0) - AX5 B G l0 S x t (Yph B.h (rad x) t + 0) =
      ipb5WV B G l0 (1/2 - Aex B.h) (S'.Aw - S.Aw) (x, t) + ipb5MV B l0 (1/2 - Aex B.h) (S'.Psi - S.Psi) (x, t)
    by_cases hc : corrOn B l0 x t
    · have hW := hsubV S.Aw S'.Aw α β hSA hS'A (thetaOf x) (ptOf x t (Yph B.h (rad x) t + 0)) hc
      simp only [add_zero] at hW
      simp only [AX5, ipb5WV, ipb5MV, if_pos hc, add_zero, hW]
      simp only [cyl2cart, Pi.sub_apply, sub_smul, smul_add, smul_sub, mul_sub, mul_smul]
      abel
    · simp only [AX5, ipb5WV, ipb5MV, if_neg hc, add_zero, sub_self]
  · obtain ⟨x, t⟩ := z
    show BX B G l0 S' x t (Yph B.h (rad x) t + 0) - BX B G l0 S x t (Yph B.h (rad x) t + 0) =
      ipb5MV B l0 (-Aex B.h) (S'.bdir - S.bdir) (x, t)
    by_cases hc : corrOn B l0 x t
    · simp only [BX, ipb5MV, if_pos hc, add_zero, Pi.sub_apply, mul_sub, sub_smul]
      abel
    · simp only [BX, ipb5MV, if_neg hc, add_zero, sub_self]
  · obtain ⟨x, t⟩ := z
    show PX5 B G l0 S' x t (Yph B.h (rad x) t + 0) - PX5 B G l0 S x t (Yph B.h (rad x) t + 0) =
      ipb5MS B l0 (-2 * Aex B.h) (nrm B (2 * Aex B.h) (fun ξ => pmP5 B G l0 S' ξ - pmP5 B G l0 S ξ)) (x, t) +
        ipb5WS B G l0 (-2 * Aex B.h) (S'.pw - S.pw) (x, t)
    by_cases hc : corrOn B l0 x t
    · have hW := hsubS S.pw S'.pw α β hSp hS'p (thetaOf x) (ptOf x t (Yph B.h (rad x) t + 0)) hc
      have hq0 := hqpos x t hc
      have hqq : qC B.h (ptOf x t (Yph B.h (rad x) t + 0)) ^ (-2 * Aex B.h) *
          qC B.h (ptOf x t (Yph B.h (rad x) t + 0)) ^ (2 * Aex B.h) = 1 := by
        rw [← Real.rpow_add hq0, show -2 * Aex B.h + 2 * Aex B.h = 0 by ring, Real.rpow_zero]
      simp only [add_zero] at hW hqq
      simp only [PX5, ipb5MS, ipb5WS, nrm, if_pos hc, add_zero, hW]
      linear_combination (pmP5 B G l0 S (ptOf x t (Yph B.h (rad x) t)) -
        pmP5 B G l0 S' (ptOf x t (Yph B.h (rad x) t))) * hqq
    · simp only [PX5, ipb5MS, ipb5WS, if_neg hc, add_zero, sub_self]

theorem increment_physical_bounds_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
    l1 ≤ l0 → ∃ L : ℕ → ℝ, (∀ m, 0 ≤ L m) ∧ ∀ (S S' : CState) (bw ca cm cd bw' ca' cm' cd' o : ℝ),
    StOrd5 B G l0 S bw ca cm cd → StOrd5 B G l0 S' bw' ca' cm' cd' → Incr5 B G l0 S S' o →
    (∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) →
      divergence (fun y => (fB B G l0 S' - fB B G l0 S) y t) x = 0 ∧
      inner ℝ x ((fB B G l0 S' - fB B G l0 S) x t) = (0:ℝ) ∧ (fB B G l0 S' - fB B G l0 S) x t 2 = 0) ∧
    ∀ m : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) →
      ‖iteratedFDeriv ℝ m (↿(fA5 B G l0 S' - fA5 B G l0 S)) (x, t)‖ ≤
        C * simScale B.h (x 2) (1 - t) ^ (B.h * o - L m) ∧
      ‖iteratedFDeriv ℝ m (↿(fB B G l0 S' - fB B G l0 S)) (x, t)‖ ≤
        C * simScale B.h (x 2) (1 - t) ^ (B.h * o - L m) ∧
      ‖iteratedFDeriv ℝ m (↿(fP5 B G l0 S' - fP5 B G l0 S)) (x, t)‖ ≤
        C * simScale B.h (x 2) (1 - t) ^ (B.h * o - L m) :=
by
  intro B G hok hG
  have hSim : SimScaleProps B.h := hok.1
  obtain ⟨la, ha⟩ := ipb5_wave_vec_conversion B G hok hG
  obtain ⟨lb, hb⟩ := ipb5_wave_scal_conversion B G hok hG
  obtain ⟨lc, hc⟩ := ipb5_mean_conversion B G hok hG
  refine ⟨la + lb + lc, fun l0 hl0 => ?_⟩
  obtain ⟨L1, hL1, H1⟩ := ha l0 (by omega) (1/2 - Aex B.h)
  obtain ⟨L2, hL2, H2⟩ := hb l0 (by omega) (-2 * Aex B.h)
  obtain ⟨L3, hL3, H3⟩ := hc l0 (by omega) (1/2 - Aex B.h)
  obtain ⟨L4, hL4, H4⟩ := hc l0 (by omega) (-Aex B.h)
  obtain ⟨L5, hL5, H5⟩ := hc l0 (by omega) (-2 * Aex B.h)
  obtain ⟨L, hLdef⟩ : ∃ L : ℕ → ℝ,
      L = fun m => max (max (L1 m) (L2 m)) (max (L3 m) (max (L4 m) (L5 m))) := ⟨_, rfl⟩
  have hLm : ∀ m, L m = max (max (L1 m) (L2 m)) (max (L3 m) (max (L4 m) (L5 m))) := by
    intro m; rw [hLdef]
  have hL1le : ∀ m, L1 m ≤ L m := fun m => by
    rw [hLm m]; exact le_max_of_le_left (le_max_left _ _)
  have hL2le : ∀ m, L2 m ≤ L m := fun m => by
    rw [hLm m]; exact le_max_of_le_left (le_max_right _ _)
  have hL3le : ∀ m, L3 m ≤ L m := fun m => by
    rw [hLm m]; exact le_max_of_le_right (le_max_left _ _)
  have hL4le : ∀ m, L4 m ≤ L m := fun m => by
    rw [hLm m]; exact le_max_of_le_right (le_max_of_le_right (le_max_left _ _))
  have hL5le : ∀ m, L5 m ≤ L m := fun m => by
    rw [hLm m]; exact le_max_of_le_right (le_max_of_le_right (le_max_right _ _))
  refine ⟨L, fun m => le_trans (hL1 m) (hL1le m), ?_⟩
  intro S S' bw ca cm cd bw' ca' cm' cd' o hS hS' hI
  have hSA : InWg5 B G (qsOf l0) 1 S.Aw := hS.1
  have hSp : InWg5 B G (qsOf l0) 1 S.pw := hS.2.1
  have hS'A : InWg5 B G (qsOf l0) 1 S'.Aw := hS'.1
  have hS'p : InWg5 B G (qsOf l0) 1 S'.pw := hS'.2.1
  obtain ⟨hIA, -, hIp, hIPsi, hIb, hIpm, -, -⟩ := hI
  obtain ⟨eA, eB, eP⟩ := ipb5_field_split B G l0 S S' 1 1 hok hSA hS'A hSp hS'p

  have hT1 : ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) →
      divergence (fun y => (fB B G l0 S' - fB B G l0 S) y t) x = 0 ∧
      inner ℝ x ((fB B G l0 S' - fB B G l0 S) x t) = (0:ℝ) ∧
      (fB B G l0 S' - fB B G l0 S) x t 2 = 0 := by
    intro x t hxt
    have hpt : ∀ y s, (fB B G l0 S' - fB B G l0 S) y s =
        ipb5MV B l0 (-Aex B.h) (S'.bdir - S.bdir) (y, s) := fun y s => congrFun eB (y, s)
    have hfun : (fun y => (fB B G l0 S' - fB B G l0 S) y t) =
        fun y => ipb5MV B l0 (-Aex B.h) (S'.bdir - S.bdir) (y, t) := funext fun y => hpt y t
    rw [hfun, hpt x t]
    exact ipb5_azimuthal_div B l0 (-Aex B.h) (S'.bdir - S.bdir) hok hIb.1
      (fun ξ hξ hX => hIb.2.2.1 ξ hξ (Or.inl hX)) x t hxt

  have hqcont : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    have hmap : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
      (((EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst).prodMk
        (continuous_const.sub continuous_snd))
    refine hSim.2.2.2.1.continuousOn.comp hmap.continuousOn ?_
    intro w hw
    exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
  have hΩ : IsOpen (simDomain B.h (qsOf l0)) := by
    have e : simDomain B.h (qsOf l0) = {w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0) := rfl
    rw [e]
    exact hqcont.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have key2 : ∀ (C a b q : ℝ), 0 < q → q ≤ 1 → b ≤ a → C * q ^ a ≤ |C| * q ^ b := by
    intro C a b q hq0 hq1 hba
    calc C * q ^ a ≤ |C| * q ^ a :=
          mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0.le _)
      _ ≤ |C| * q ^ b :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0 hq1 hba) (abs_nonneg C)
  refine ⟨hT1, fun m => ?_⟩

  obtain ⟨sWV, bWV⟩ := H1 o (S'.Aw - S.Aw) hIA
  obtain ⟨sWS, bWS⟩ := H2 o (S'.pw - S.pw) hIp
  obtain ⟨sMV3, -, bM3⟩ := H3 o (S'.Psi - S.Psi) hIPsi
  obtain ⟨-, -, bM4⟩ := H4 o (S'.bdir - S.bdir) hIb
  obtain ⟨-, sMS5, bM5⟩ := H5 o _ hIpm
  obtain ⟨C1, hC1⟩ := bWV m
  obtain ⟨C2, hC2⟩ := bWS m
  obtain ⟨C3, hC3⟩ := bM3 m
  obtain ⟨C4, hC4⟩ := bM4 m
  obtain ⟨C5, hC5⟩ := bM5 m
  refine ⟨|C1| + |C2| + |C3| + |C4| + |C5|, fun x t hxt => ?_⟩
  have hxt' : t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
  have hq0 : 0 < simScale B.h (x 2) (1 - t) := (hSim.1 (x 2) (1 - t) (by linarith [hxt'.1])).1
  have hq1 : simScale B.h (x 2) (1 - t) ≤ 1 := le_trans hxt'.2.le hqs1
  have hP : 0 ≤ simScale B.h (x 2) (1 - t) ^ (B.h * o - L m) := Real.rpow_nonneg hq0.le _
  have hnhds : simDomain B.h (qsOf l0) ∈ nhds (x, t) := hΩ.mem_nhds hxt
  have a1 := mul_nonneg (abs_nonneg C1) hP
  have a2 := mul_nonneg (abs_nonneg C2) hP
  have a3 := mul_nonneg (abs_nonneg C3) hP
  have a4 := mul_nonneg (abs_nonneg C4) hP
  have a5 := mul_nonneg (abs_nonneg C5) hP
  have f1 := le_trans (hC1 x t hxt)
    (key2 C1 _ _ _ hq0 hq1 (show B.h * o - L m ≤ B.h * o - L1 m by linarith [hL1le m]))
  have f2 := le_trans (hC2 x t hxt)
    (key2 C2 _ _ _ hq0 hq1 (show B.h * o - L m ≤ B.h * o - L2 m by linarith [hL2le m]))
  have f3 := le_trans (hC3 x t hxt).1
    (key2 C3 _ _ _ hq0 hq1 (show B.h * o - L m ≤ B.h * o - L3 m by linarith [hL3le m]))
  have f4 := le_trans (hC4 x t hxt).1
    (key2 C4 _ _ _ hq0 hq1 (show B.h * o - L m ≤ B.h * o - L4 m by linarith [hL4le m]))
  have f5 := le_trans (hC5 x t hxt).2
    (key2 C5 _ _ _ hq0 hq1 (show B.h * o - L m ≤ B.h * o - L5 m by linarith [hL5le m]))
  have hmle : ((m : ℕ) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  refine ⟨?_, ?_, ?_⟩
  · rw [eA]
    have hsum : iteratedFDeriv ℝ m (fun z => ipb5WV B G l0 (1/2 - Aex B.h) (S'.Aw - S.Aw) z +
          ipb5MV B l0 (1/2 - Aex B.h) (S'.Psi - S.Psi) z) (x, t) =
        iteratedFDeriv ℝ m (ipb5WV B G l0 (1/2 - Aex B.h) (S'.Aw - S.Aw)) (x, t) +
          iteratedFDeriv ℝ m (ipb5MV B l0 (1/2 - Aex B.h) (S'.Psi - S.Psi)) (x, t) :=
      iteratedFDeriv_add_apply ((sWV.contDiffAt hnhds).of_le hmle)
        ((sMV3.contDiffAt hnhds).of_le hmle)
    rw [hsum]
    calc _ ≤ ‖iteratedFDeriv ℝ m (ipb5WV B G l0 (1/2 - Aex B.h) (S'.Aw - S.Aw)) (x, t)‖ +
          ‖iteratedFDeriv ℝ m (ipb5MV B l0 (1/2 - Aex B.h) (S'.Psi - S.Psi)) (x, t)‖ :=
          norm_add_le _ _
      _ ≤ _ := by nlinarith
  · rw [eB]
    calc _ ≤ _ := f4
      _ ≤ _ := by nlinarith
  · rw [eP]
    have hsum : iteratedFDeriv ℝ m (fun z => ipb5MS B l0 (-2 * Aex B.h)
          (nrm B (2 * Aex B.h) (fun ξ => pmP5 B G l0 S' ξ - pmP5 B G l0 S ξ)) z +
          ipb5WS B G l0 (-2 * Aex B.h) (S'.pw - S.pw) z) (x, t) =
        iteratedFDeriv ℝ m (ipb5MS B l0 (-2 * Aex B.h)
          (nrm B (2 * Aex B.h) (fun ξ => pmP5 B G l0 S' ξ - pmP5 B G l0 S ξ))) (x, t) +
          iteratedFDeriv ℝ m (ipb5WS B G l0 (-2 * Aex B.h) (S'.pw - S.pw)) (x, t) :=
      iteratedFDeriv_add_apply ((sMS5.contDiffAt hnhds).of_le hmle)
        ((sWS.contDiffAt hnhds).of_le hmle)
    rw [hsum]
    calc _ ≤ ‖iteratedFDeriv ℝ m (ipb5MS B l0 (-2 * Aex B.h)
            (nrm B (2 * Aex B.h) (fun ξ => pmP5 B G l0 S' ξ - pmP5 B G l0 S ξ))) (x, t)‖ +
          ‖iteratedFDeriv ℝ m (ipb5WS B G l0 (-2 * Aex B.h) (S'.pw - S.pw)) (x, t)‖ :=
          norm_add_le _ _
      _ ≤ _ := by nlinarith

theorem ns_correction_family : ∀ (h Xa Xb Xext m1 m2 lam cpatch qB c aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) (AB BvB : ℝ³ → ℝ → ℝ³) (PB : ℝ³ → ℝ → ℝ) (Eb Ub Vb Tth Tz : ℝ → ℝ → ℝ → ℝ), SimScaleProps h → BackgroundProps h Xa Xb Xext m1 m2 lam cpatch qB c aa ab F U T0th T0z AB BvB PB Eb Ub Vb Tth Tz → ∃ (qs γ : ℝ) (ℓ K : ℕ → ℝ) (A Bv : ℕ → ℝ³ → ℝ → ℝ³) (P : ℕ → ℝ³ → ℝ → ℝ), CorrectionFamily h Xa Xb qB AB BvB PB qs γ ℓ K A Bv P :=
by
  intro h Xa Xb Xext m1 m2 lam cpatch qB c aa ab F U T0th T0z AB BvB PB Eb Ub Vb Tth Tz hS hB
  have hB1 := hB.1
  obtain ⟨hh0, -, -, -, -, -, -, hqB0, hqB1, -, -, -, -⟩ := hB1
  let B : BG := ⟨h, Xa, Xb, Xext, m1, m2, lam, cpatch, qB, c, aa, ab, F, U, T0th, T0z, AB, BvB, PB, Eb, Ub,
    Vb, Tth, Tz⟩
  have hok : B.ok := ⟨hS, hB⟩
  obtain ⟨G, hG⟩ := correction_geometry_v5 B hok
  obtain ⟨l7, h7⟩ := mean_residual_identity_v5 B G hok hG
  obtain ⟨l2, h2⟩ := correction_initial_state_v5 B G hok hG
  obtain ⟨la, ha⟩ := cycle_step_pulse_v5 B G hok hG
  obtain ⟨lb, hb⟩ := cycle_step_stress_v5 B G hok hG
  obtain ⟨lc, hc⟩ := cycle_step_temporal_v5 B G hok hG
  obtain ⟨ld, hd⟩ := cycle_step_moment_v5 B G hok hG
  obtain ⟨l4, h4⟩ := state_physical_bounds_v5 B G hok hG
  obtain ⟨l5, h5⟩ := increment_physical_bounds_v5 B G hok hG
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  obtain ⟨l0, hl0⟩ : ∃ l0 : ℕ, l0 = n0 + l7 + l2 + la + lb + lc + ld + l4 + l5 := ⟨_, rfl⟩
  obtain ⟨S0, hS0⟩ := h2 l0 (by omega)
  obtain ⟨L4, hL4, H4⟩ := h4 l0 (by omega)
  obtain ⟨L5, hL5, H5⟩ := h5 l0 (by omega)
  have hk : kapS = 1 / 100000 := rfl

  have anti4 : ∀ (S : CState) (bw ca cm cd bw' ca' cm' cd' : ℝ),
      StOrd5 B G l0 S bw ca cm cd → bw' ≤ bw → ca' ≤ ca → cm' ≤ cm → cd' ≤ cd →
      StOrd5 B G l0 S bw' ca' cm' cd' := by
    intro S bw ca cm cd bw' ca' cm' cd' hSt hbw hca hcm hcd
    have hh : 0 < B.h := hok.2.1.1
    have hXa : 0 < B.Xa := hok.2.1.2.2.1
    have hq1 : qsOf l0 ≤ 1 := by
      show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
      exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
    have hpos : ∀ z t : ℝ, t < 1 → 0 < simScale B.h z (1 - t) := fun z t ht =>
      (hok.1.1 z (1 - t) (by linarith)).1
    have key0 : ∀ (C q a a' : ℝ), 0 < q → q ≤ 1 → a' ≤ a →
        C * q ^ (B.h * a) ≤ |C| * q ^ (B.h * a') := by
      intro C q a a' hq0 hq1' haa
      calc C * q ^ (B.h * a) ≤ |C| * q ^ (B.h * a) :=
            mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0.le _)
        _ ≤ |C| * q ^ (B.h * a') :=
            mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0 hq1'
              (mul_le_mul_of_nonneg_left haa hh.le)) (abs_nonneg C)
    have hEW : ∀ X : ℝ, 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X := by
      intro X
      unfold edgeWeight
      split_ifs
      · positivity
      · exact le_rfl
    have hED : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 < edgeDist B.Xa B.Xb X := by
      intro X h1 h2
      have hX0 : 0 < X := lt_trans hXa h1
      unfold edgeDist
      exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr h1))
        (Real.log_pos ((one_lt_div hX0).mpr h2)))
    have hSC : ∀ (ξ : Cyl) (b : ℝ), 0 ≤ SC B.h ξ ^ b := by
      intro ξ b
      exact Real.rpow_nonneg (by unfold SC; positivity) b
    have hM : ∀ (f : Cyl → ℝ) (α α' : ℝ),
        α' ≤ α → InM B (qsOf l0) α f → InM B (qsOf l0) α' f := by
      intro f α α' hαα hf
      obtain ⟨c1, c2, c3, c4⟩ := hf
      refine ⟨c1, c2, c3, fun k => ?_⟩
      obtain ⟨C, b, d, hC⟩ := c4 k
      refine ⟨|C|, b, d, fun ξ hξ hX1 hX2 => ?_⟩
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      have hq0 : 0 < qC B.h ξ := hpos ξ.2.1 ξ.2.2.1 hξ'.2.1
      have hq1' : qC B.h ξ ≤ 1 := le_trans hξ'.2.2.le hq1
      refine le_trans (hC ξ hξ hX1 hX2) ?_
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_pos_of_pos (hED _ hX1 hX2) _).le
      apply mul_le_mul_of_nonneg_right _ (hEW _)
      exact mul_le_mul_of_nonneg_right (key0 C _ α α' hq0 hq1' hαα) (hSC ξ b)
    have hW : ∀ (a : WC) (α α' : ℝ),
        α' ≤ α → InWg5 B G (qsOf l0) α a → InWg5 B G (qsOf l0) α' a := by
      intro a α α' hαα ha
      obtain ⟨c1, c2, c3, c4, c5⟩ := ha
      refine ⟨c1, c2, c3, c4, fun k => ?_⟩
      obtain ⟨C, b, d, hC⟩ := c5 k
      refine ⟨|C|, b, d, fun γ m ξ hξ hX1 hX2 => ?_⟩
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      have hq0 : 0 < qC B.h ξ := hpos ξ.2.1 ξ.2.2.1 hξ'.2.1
      have hq1' : qC B.h ξ ≤ 1 := le_trans hξ'.2.2.le hq1
      refine le_trans (hC γ m ξ hξ hX1 hX2) ?_
      apply mul_le_mul_of_nonneg_right _ (by unfold Penv5; exact (Real.exp_pos _).le)
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_pos_of_pos (hED _ hX1 hX2) _).le
      apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
      exact mul_le_mul_of_nonneg_right (key0 C _ α α' hq0 hq1' hαα) (hSC ξ b)
    have hSS : ∀ (F : ℝ × ℝ → ℝ) (α α' : ℝ), α' ≤ α → InS B (qsOf l0) α F → InS B (qsOf l0) α' F := by
      intro F α α' hαα hF
      obtain ⟨c1, c2⟩ := hF
      refine ⟨c1, fun k => ?_⟩
      obtain ⟨C, b, hC⟩ := c2 k
      refine ⟨|C|, b, fun w hw1 hw2 => ?_⟩
      have hq0 := hpos w.1 w.2 hw1
      refine le_trans (hC w hw1 hw2) ?_
      exact mul_le_mul_of_nonneg_right (key0 C _ α α' hq0 (le_trans hw2.le hq1) hαα)
        (Real.rpow_nonneg (by positivity) _)
    unfold StOrd5 at hSt ⊢
    obtain ⟨c1, c2, c3, c4, c5, c6, ⟨f, Fl, hf, hFl, hEq⟩, c8, c9, c10, c11, c12, c13, c14, c15, c16,
      c17, c18, c19, c20, c21, c22, c23⟩ := hSt
    exact ⟨c1, c2, c3, c4, c5, c6, ⟨f, Fl, hW f bw bw' hbw hf, hFl, hEq⟩,
      hM _ cm cm' hcm c8, hM _ cm cm' hcm c9, hM _ ca ca' hca c10, hM _ ca ca' hca c11,
      hSS _ cd cd' hcd c12, hSS _ cd cd' hcd c13, hSS _ cd cd' hcd c14,
      c15, c16, c17, c18, c19, c20, c21, c22, c23⟩

  have cyc : ∀ (S : CState) (Bo : ℝ), 7/10 ≤ Bo → StOrd5 B G l0 S Bo (Bo + 1/2) (Bo + 1/2) (Bo + 1/2) →
      ∃ S' : CState, StOrd5 B G l0 S' (Bo + 1/10) (Bo + 1/10 + 1/2) (Bo + 1/10 + 1/2) (Bo + 1/10 + 1/2) ∧
        Incr5 B G l0 S S' (Bo - kapS) := by
