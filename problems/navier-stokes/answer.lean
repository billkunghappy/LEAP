  have hcalP : InS B (qsOf l0) (Bo + 1/2 - kapS) (nrmS B (2 * Aex B.h) (calP5 B G l0 (waveAdd S D E))) := by
    refine LS _ _ _ 1 1 _ _ _ c12 m0 (by rw [hk]; linarith) le_rfl (fun w e1 e2 => ?_)
    have e := (hch _ (hmem w e1 e2)).2.2.2.1
