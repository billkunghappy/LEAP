  have hG2 : InM B (qsOf l0) (3/2 - 2 * kapS) (nrm B (2 * Aex B.h + 1/2) (fun ξ =>
      (dR B.h (pmrTh B B.T0z) ξ + pmrTh B B.T0z ξ / ξ.1 + sBase B 2 ξ) +
        dR B.h (yAvg (Dv 0 2)) ξ + yAvg (Dv 0 2) ξ / ξ.1 +
        dZ (yAvg (fun η => Wcov5 B G l0 S 2 2 η + pmP5 B G l0 S η)) ξ)) := by
    refine lc4 _ _ _ _ _ 1 1 1 1 _ _ _ _ _ hDel2 RyD2.1 RyD2.2.2.1 RyZ.2.1
      (by rw [hk]; norm_num) (by rw [hk]; norm_num) (by rw [hk]; norm_num) (by rw [hk]; norm_num)
      (fun ξ _ => ?_)
    simp only [nrm]; ring
  have hyEz' : InM B (qsOf l0) (149/100) (nrm B (2 * Aex B.h + 1/2) (yAvg (EzP5 B G l0 S))) := by
    have up := hgermM _ _ _ _ hyEz hG2 (fun ξ hξ hX1 hX2 => by simp only [nrm]; rw [hshell2 ξ hξ hX1 hX2])
    exact LM _ _ _ 1 0 _ _ _ up up (by rw [hk]; norm_num) (by rw [hk]; norm_num) (fun ξ _ => by ring)
  exact ⟨hEth, hEz, hyEth, hyEz', hcalP, hcalJth, hcalJz, hpm9, hgr⟩

theorem dR_Icut_formula_v5 : ∀ (B : BG) (g : Cyl → ℝ) (ξ : Cyl), B.ok → 0 < ξ.1 → ξ.2.2.1 < 1 → DifferentiableAt ℝ (fun ζ : ℝ × ℝ × (ℝ × ℝ) => ∫ r in Set.Ioi (0:ℝ), g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv)) (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) → DifferentiableAt ℝ (fun pζ : ℝ × (ℝ × ℝ × (ℝ × ℝ)) => ∫ r in (0:ℝ)..pζ.1, g (r, pζ.2.1, pζ.2.2.1, pζ.2.2.2 + (r ^ drx B.h) • vrv)) (ξ.1, (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv)) → HasDerivAt (fun p : ℝ => ∫ r in (0:ℝ)..p, g (r, ξ.2.1, ξ.2.2.1, (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv)) (g ξ) ξ.1 → dR B.h (Icut B g) ξ = g ξ - deriv (chiM B) (XC B.h ξ) * (ξ.1 / qC B.h ξ) * ∫ r in Set.Ioi (0:ℝ), g (pathPt B.h ξ r) :=
by
  intro B g ξ hok hr ht H1 H2 H3

  have hpath : ∀ (η : Cyl) (r : ℝ), pathPt B.h η r =
      (r, η.2.1, η.2.2.1, (η.2.2.2 - (η.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv) := by
    intro η r
    have e : η.2.2.2 + (r ^ drx B.h - η.1 ^ drx B.h) • vrv =
        (η.2.2.2 - (η.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv := by
      rw [sub_smul]; abel
    show (r, η.2.1, η.2.2.1, η.2.2.2 + (r ^ drx B.h - η.1 ^ drx B.h) • vrv) = _
    rw [e]

  obtain ⟨v, hv⟩ : ∃ v : Cyl, v = (1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) := ⟨_, rfl⟩
  have hv1 : v.1 = 1 := by subst hv; rfl
  have hv21 : v.2.1 = 0 := by subst hv; rfl
  have hv221 : v.2.2.1 = 0 := by subst hv; rfl
  have hv222 : v.2.2.2 = (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv := by subst hv; rfl
  obtain ⟨π, hπ⟩ : ∃ π : Cyl → ℝ × ℝ × (ℝ × ℝ),
      π = fun η => (η.2.1, η.2.2.1, η.2.2.2 - (η.1 ^ drx B.h) • vrv) := ⟨_, rfl⟩
  obtain ⟨P, hP⟩ : ∃ P : ℝ × ℝ × (ℝ × ℝ) → ℝ, P = fun ζ : ℝ × ℝ × (ℝ × ℝ) =>
      ∫ r in Set.Ioi (0:ℝ), g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv) := ⟨_, rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : ℝ × (ℝ × ℝ × (ℝ × ℝ)) → ℝ, Q = fun pζ : ℝ × (ℝ × ℝ × (ℝ × ℝ)) =>
      ∫ r in (0:ℝ)..pζ.1, g (r, pζ.2.1, pζ.2.2.1, pζ.2.2.2 + (r ^ drx B.h) • vrv) := ⟨_, rfl⟩
  have hIcut : Icut B g = fun η => Q (η.1, π η) - chiM B (XC B.h η) * P (π η) := by
    funext η
    rw [hQ, hP, hπ]
    simp only [Icut, hpath]
  have hPξ : P (π ξ) = ∫ r in Set.Ioi (0:ℝ), g (pathPt B.h ξ r) := by
    rw [hP, hπ]
    simp only [hpath]

  have hrpow : HasDerivAt (fun x : ℝ => x ^ drx B.h) (drx B.h * ξ.1 ^ (drx B.h - 1)) ξ.1 :=
    Real.hasDerivAt_rpow_const (Or.inl hr.ne')
  have hfst : HasFDerivAt (fun η : Cyl => η.1) (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) ξ :=
    hasFDerivAt_fst
  have hsnd : HasFDerivAt (fun η : Cyl => η.2) (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) ξ :=
    hasFDerivAt_snd
  have h1 := hrpow.comp_hasFDerivAt ξ hfst
  have h2 := h1.smul_const vrv
  obtain ⟨π', hπ', hπ'v⟩ : ∃ π' : Cyl →L[ℝ] ℝ × ℝ × (ℝ × ℝ), HasFDerivAt π π' ξ ∧ π' v = 0 := by
    subst hπ
    exact ⟨_, hsnd.fst.prodMk (hsnd.snd.fst.prodMk (hsnd.snd.snd.sub h2)),
      by simp [hv1, hv21, hv221, hv222]⟩

  have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hmem : ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ) ∈ (Set.univ ×ˢ Set.Ioi (0:ℝ)) :=
    ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
  have hSc := hok.1.2.2.2.1.contDiffAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds hmem)
  have hSd := (hSc.differentiableAt (by norm_num)).hasFDerivAt
  have hφ := hsnd.fst.prodMk (hsnd.snd.fst.const_sub (1:ℝ))
  have hqc := hSd.comp ξ hφ
  obtain ⟨q', hq', hq'v⟩ : ∃ q' : Cyl →L[ℝ] ℝ, HasFDerivAt (qC B.h) q' ξ ∧ q' v = 0 := by
    refine ⟨_, hqc, ?_⟩
    simp [hv21, hv221, Prod.mk_zero_zero]
  have hr2 := (hasDerivAt_pow 2 ξ.1).comp_hasFDerivAt ξ hfst
  have hinv : HasDerivAt (fun y : ℝ => y⁻¹) (-((2 * qC B.h ξ) ^ 2)⁻¹) (2 * qC B.h ξ) :=
    hasDerivAt_inv (mul_pos two_pos hq0).ne'
  obtain ⟨X', hX', hX'v⟩ : ∃ X' : Cyl →L[ℝ] ℝ, HasFDerivAt (XC B.h) X' ξ ∧
      X' v = ξ.1 / qC B.h ξ := by
    have hXeq : XC B.h = fun η => η.1 ^ 2 * (2 * qC B.h η)⁻¹ := by
      funext η; simp only [XC, div_eq_mul_inv]
    rw [hXeq]
    refine ⟨_, hr2.mul (hinv.comp_hasFDerivAt ξ (hq'.const_mul (2:ℝ))), ?_⟩
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_fst', hv1, hq'v, smul_eq_mul, Function.comp_apply, mul_zero,
      zero_add, smul_zero]
    have hq0' : qC B.h ξ ≠ 0 := hq0.ne'
    field_simp
    ring

  have hχd : DifferentiableAt ℝ (chiM B) (XC B.h ξ) := by
    have e1 : Differentiable ℝ Real.smoothTransition :=
      (Real.smoothTransition.contDiff (n := 1)).differentiable (by norm_num)
    have e2 : DifferentiableAt ℝ (fun X : ℝ => (X - B.m1) / (B.m2 - B.m1)) (XC B.h ξ) :=
      (differentiableAt_id.sub_const _).div_const _
    exact (e1 _).comp _ e2
  have hχX := hχd.hasDerivAt.comp_hasFDerivAt ξ hX'

  have hPd : DifferentiableAt ℝ P (π ξ) := by rw [hP, hπ]; exact H1
  have hQd : DifferentiableAt ℝ Q (ξ.1, π ξ) := by rw [hQ, hπ]; exact H2
  have hι : HasDerivAt (fun p : ℝ => (p, π ξ)) ((1:ℝ), (0 : ℝ × ℝ × (ℝ × ℝ))) ξ.1 :=
    (hasDerivAt_id ξ.1).prodMk (hasDerivAt_const ξ.1 (π ξ))
  have hcomp := hQd.hasFDerivAt.comp_hasDerivAt ξ.1 hι
  have hH3 : HasDerivAt (Q ∘ fun p : ℝ => (p, π ξ)) (g ξ) ξ.1 := by
    rw [hQ, hπ]; exact H3
  have hQv : fderiv ℝ Q (ξ.1, π ξ) ((1:ℝ), (0 : ℝ × ℝ × (ℝ × ℝ))) = g ξ := hcomp.unique hH3

  have hσ := hfst.prodMk hπ'
  have hF := (hQd.hasFDerivAt.comp ξ hσ).sub (hχX.mul (hPd.hasFDerivAt.comp ξ hπ'))
  have hev : Icut B g =ᶠ[nhds ξ] (fun η => Q (η.1, π η) - chiM B (XC B.h η) * P (π η)) :=
    Filter.Eventually.of_forall (fun η => congrFun hIcut η)
  have hF2 := hF.congr_of_eventuallyEq hev
  unfold dR
  rw [← hv, hF2.fderiv]
  simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply,
    ContinuousLinearMap.smul_apply, ContinuousLinearMap.comp_apply, ContinuousLinearMap.prod_apply,
    ContinuousLinearMap.coe_fst', hπ'v, hX'v, hv1, map_zero, smul_eq_mul, mul_zero, zero_add,
    Function.comp_apply, hQv]
  rw [hPξ]
  ring

theorem rhoP_integral_one_v5 : ∀ (B : BG) (z t : ℝ) (W : ℝ × ℝ), B.ok → t < 1 → ∫ r in Set.Ioi (0:ℝ), rhoP B (r, z, t, W) = 1 :=
by
  intro B z t W hok ht
  have hq : 0 < simScale B.h z (1 - t) := (hok.1.1 z (1 - t) (by linarith)).1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hXm : B.Xa < B.m1 := hok.2.1.2.2.2.1
  have hm12 : B.m1 < B.m2 := hok.2.1.2.2.2.2.1
  have hσ : 0 < Real.sqrt (simScale B.h z (1 - t)) := Real.sqrt_pos.mpr hq
  have ha0 : 0 < Real.sqrt (2 * B.m1) := Real.sqrt_pos.mpr (by linarith)
  have hab : Real.sqrt (2 * B.m1) < Real.sqrt (2 * B.m2) :=
    Real.sqrt_lt_sqrt (by linarith) (by linarith)

  have hpt : ∀ r : ℝ, rhoP B (r, z, t, W) =
      (Real.sqrt (simScale B.h z (1 - t)))⁻¹ *
        rhoHat B ((Real.sqrt (simScale B.h z (1 - t)))⁻¹ * r) := by
    intro r
    show simScale B.h z (1 - t) ^ (-(1/2:ℝ)) * rhoHat B (r / Real.sqrt (simScale B.h z (1 - t))) = _
    rw [Real.rpow_neg hq.le, ← Real.sqrt_eq_rpow, div_eq_inv_mul]
  have hI : ∫ r in Set.Ioi (0:ℝ), rhoP B (r, z, t, W) = ∫ x in Set.Ioi (0:ℝ), rhoHat B x := by
    simp_rw [hpt]
    rw [MeasureTheory.integral_const_mul,
      MeasureTheory.integral_comp_mul_left_Ioi (rhoHat B) 0 (inv_pos.mpr hσ), mul_zero, inv_inv,
      smul_eq_mul, ← mul_assoc, inv_mul_cancel₀ hσ.ne', one_mul]

  have hvan : ∀ s : ℝ, (s ≤ Real.sqrt (2 * B.m1) ∨ Real.sqrt (2 * B.m2) < s) → rhoHat B s = 0 := by
    intro s hs
    have hw : 0 < (Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2 := by linarith
    have hu : 1 ≤ ((s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) ^ 2 := by
      rcases hs with hs | hs
      · have h1 : (s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
            ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2) ≤ -1 := by
          rw [div_le_iff₀ hw]; linarith
        nlinarith
      · have h1 : 1 < (s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
            ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2) := by
          rw [lt_div_iff₀ hw]; linarith
        nlinarith
    have hnum : bumpR ((s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) = 0 :=
      Real.smoothTransition.zero_of_nonpos (by linarith)
    unfold rhoHat
    rw [hnum, zero_div]

  have hZpos : 0 < ∫ u in (Real.sqrt (2 * B.m1))..(Real.sqrt (2 * B.m2)),
      bumpR ((u - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) := by
    have hw : 0 < (Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2 := by linarith
    apply intervalIntegral.intervalIntegral_pos_of_pos_on
    · apply Continuous.intervalIntegrable
      unfold bumpR
      exact Real.smoothTransition.continuous.comp (by fun_prop)
    · intro x hx
      have h1 : -1 < (x - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
          ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2) := by
        rw [lt_div_iff₀ hw]; linarith [hx.1]
      have h2 : (x - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
          ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2) < 1 := by
        rw [div_lt_iff₀ hw]; linarith [hx.2]
      unfold bumpR
      exact Real.smoothTransition.pos_of_pos (by nlinarith)
    · exact hab

  have hsub : Set.Ioc (Real.sqrt (2 * B.m1)) (Real.sqrt (2 * B.m2)) ⊆ Set.Ioi (0:ℝ) :=
    fun x hx => lt_trans ha0 hx.1
  have hdiff : ∀ x ∈ Set.Ioi (0:ℝ) \ Set.Ioc (Real.sqrt (2 * B.m1)) (Real.sqrt (2 * B.m2)),
      rhoHat B x = 0 := by
    intro x hx
    apply hvan
    rcases hx with ⟨-, hx1⟩
    simp only [Set.mem_Ioc, not_and_or, not_lt, not_le] at hx1
    exact hx1
  rw [hI, MeasureTheory.setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi hsub hdiff,
    ← intervalIntegral.integral_of_le hab.le]
  unfold rhoHat
  rw [intervalIntegral.integral_div]
  exact div_self hZpos.ne'

theorem path_integrable_v5 : ∀ (B : BG) (qs : ℝ) (g : Cyl → ℝ), B.ok → 0 < qs → qs ≤ 1 → ContDiffOn ℝ ∞ g (DomC B.h qs) → (∀ ξ ∈ DomC B.h qs, (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → g ξ = 0) → ∀ ζ : ℝ × ℝ × (ℝ × ℝ), ζ.2.1 < 1 → simScale B.h ζ.1 (1 - ζ.2.1) < qs → MeasureTheory.IntegrableOn (fun r : ℝ => g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv)) (Set.Ioi (0:ℝ)) :=
by
  intro B qs g hok hqs0 hqs1 hgs hgz ζ ht hq
  obtain ⟨z, t, Y⟩ := ζ
  simp only at ht hq ⊢
  have hq0 : 0 < simScale B.h z (1 - t) := (hok.1.1 z (1 - t) (by linarith)).1
  have hq1 : simScale B.h z (1 - t) ≤ 1 := by linarith
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hXam1 : B.Xa < B.m1 := hok.2.1.2.2.2.1
  have hm12 : B.m1 < B.m2 := hok.2.1.2.2.2.2.1
  have hm2Xb : B.m2 < B.Xb := hok.2.1.2.2.2.2.2.1
  have hXb : 0 < B.Xb := by linarith
  have hε0 : 0 < min 1 (B.Xa * simScale B.h z (1 - t)) := lt_min one_pos (mul_pos hXa hq0)
  have hε1 : min 1 (B.Xa * simScale B.h z (1 - t)) ≤ 1 := min_le_left _ _
  have hε2 : min 1 (B.Xa * simScale B.h z (1 - t)) ≤ B.Xa * simScale B.h z (1 - t) :=
    min_le_right _ _
  have hmem : ∀ r : ℝ, 0 < r → ((r, z, t, Y + (r ^ drx B.h) • vrv) : Cyl) ∈ DomC B.h qs :=
    fun r hr => ⟨hr, ht, hq⟩
  have hXC : ∀ r : ℝ, XC B.h ((r, z, t, Y + (r ^ drx B.h) • vrv) : Cyl) =
      r ^ 2 / (2 * simScale B.h z (1 - t)) := by
    intro r
    rfl
  have hzero : ∀ r ∈ Set.Ioi (0:ℝ) \ Set.Icc (min 1 (B.Xa * simScale B.h z (1 - t))) (2 * B.Xb + 1),
      g (r, z, t, Y + (r ^ drx B.h) • vrv) = 0 := by
    rintro r ⟨hr0, hrI⟩
    have hr0' : (0:ℝ) < r := hr0
    apply hgz _ (hmem r hr0')
    rw [hXC r]
    rcases not_and_or.mp hrI with h | h
    · left
      have h' : r < min 1 (B.Xa * simScale B.h z (1 - t)) := not_le.mp h
      rw [div_le_iff₀ (by positivity)]
      nlinarith
    · right
      have h' : 2 * B.Xb + 1 < r := not_le.mp h
      rw [le_div_iff₀ (by positivity)]
      nlinarith [mul_le_mul_of_nonneg_left hq1 hXb.le]
  have hcont : ContinuousOn (fun r : ℝ => g (r, z, t, Y + (r ^ drx B.h) • vrv))
      (Set.Icc (min 1 (B.Xa * simScale B.h z (1 - t))) (2 * B.Xb + 1)) := by
    have hγ : ContinuousOn (fun r : ℝ => ((r, z, t, Y + (r ^ drx B.h) • vrv) : Cyl))
        (Set.Icc (min 1 (B.Xa * simScale B.h z (1 - t))) (2 * B.Xb + 1)) := by
      have hp : ContinuousOn (fun r : ℝ => r ^ drx B.h)
          (Set.Icc (min 1 (B.Xa * simScale B.h z (1 - t))) (2 * B.Xb + 1)) :=
        ContinuousOn.rpow_const continuousOn_id
          (fun x hx => Or.inl (ne_of_gt (lt_of_lt_of_le hε0 hx.1)))
      exact continuousOn_id.prodMk (continuousOn_const.prodMk (continuousOn_const.prodMk
        (continuousOn_const.add (hp.smul continuousOn_const))))
    exact hgs.continuousOn.comp hγ (fun r hr => hmem r (lt_of_lt_of_le hε0 hr.1))
  exact (hcont.integrableOn_Icc).of_forall_sdiff_eq_zero measurableSet_Ioi hzero

theorem radRem_path_form_v5 : ∀ (B : BG) (l0 : ℕ) (g : Cyl → ℝ) (α : ℝ), B.ok → InM B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) g) → ∀ ξ ∈ DomC B.h (qsOf l0), dR B.h (Icut B (fun η => g η - rhoP B η * radMom g 0 η.2.1 η.2.2.1)) ξ - g ξ + rhoP B ξ * radMom g 0 ξ.2.1 ξ.2.2.1 = -(deriv (chiM B) (XC B.h ξ) * (ξ.1 / qC B.h ξ)) * ((∫ r in Set.Ioi (0:ℝ), g (r, ξ.2.1, ξ.2.2.1, (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv)) - radMom g 0 ξ.2.1 ξ.2.2.1) :=
by
  intro B l0 g α hok hg ξ hξ

  have hqs0 : 0 < qsOf l0 := by
    show (0:ℝ) < (2:ℝ) ^ (-(l0:ℝ))
    positivity
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  obtain ⟨hξ1, hξ2, hξ3⟩ := hξ
  obtain ⟨g', hg'⟩ : ∃ g' : Cyl → ℝ, g' = fun η => g η - rhoP B η * radMom g 0 η.2.1 η.2.2.1 :=
    ⟨_, rfl⟩
  rw [← hg']

  obtain ⟨hgs, hgz⟩ := g_regular_of_nrm_InM_v5 B (qsOf l0) (2 * Aex B.h + 1/2) α g hok hg
  obtain ⟨hrs, hrz⟩ := rhoP_regular_v5 B (qsOf l0) hok
  have hP2 := path_integral_smooth_v5 B (qsOf l0) g hok hqs0 hqs1 hgs hgz
  have hMeq : (fun w : ℝ × ℝ => radMom g 0 w.1 w.2) = (fun w : ℝ × ℝ =>
      ∫ r in Set.Ioi (0:ℝ), ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (r, w.1, w.2, Y)) := by
    funext w
    simp only [radMom, yAvg, pow_zero, one_mul]
  have hM2 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => radMom g 0 w.1 w.2)
      {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qsOf l0} := by
    rw [hMeq]
    exact hP2.2.2.1
  have hMs : ContDiffOn ℝ ∞ (fun η : Cyl => radMom g 0 η.2.1 η.2.2.1) (DomC B.h (qsOf l0)) := by
    have hlin : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, η.2.2.1) : ℝ × ℝ)) := by fun_prop
    exact hM2.comp hlin.contDiffOn (fun η hη => ⟨hη.2.1, hη.2.2⟩)
  have hg's : ContDiffOn ℝ ∞ g' (DomC B.h (qsOf l0)) := by
    rw [hg']
    exact hgs.sub (hrs.mul hMs)
  have hg'z : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η ≤ B.Xa ∨ B.Xb ≤ XC B.h η) → g' η = 0 := by
    intro η hη hX
    rw [hg']
    simp only [hgz η hη hX, hrz η hη hX, zero_mul, sub_zero]
  have hP2' := path_integral_smooth_v5 B (qsOf l0) g' hok hqs0 hqs1 hg's hg'z

  have hΩ3 : IsOpen {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qsOf l0} := by
    have hU : IsOpen {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1} := isOpen_lt (by fun_prop) continuous_const
    have h4 : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ζ : ℝ × ℝ × (ℝ × ℝ) => ((ζ.1, 1 - ζ.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ζ : ℝ × ℝ × (ℝ × ℝ) => ((ζ.1, 1 - ζ.2.1) : ℝ × ℝ))
        {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1} (univ ×ˢ Ioi 0) := by
      intro ζ hζ
      have h' : ζ.2.1 < 1 := hζ
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ζ.2.1 by linarith⟩
    have hc := (h4.comp hφ.continuousOn hmaps).isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    exact hc
  have hπ : (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) ∈
      {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qsOf l0} := ⟨hξ2, hξ3⟩
  have H1 : DifferentiableAt ℝ (fun ζ : ℝ × ℝ × (ℝ × ℝ) =>
      ∫ r in Set.Ioi (0:ℝ), g' (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv))
      (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) :=
    (hP2'.1.contDiffAt (hΩ3.mem_nhds hπ)).differentiableAt (by norm_num)
  obtain ⟨H2, H3⟩ := hP2'.2.2.2.2 (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) ξ.1 hξ2 hξ3 hξ1
  have hval : g' (ξ.1, ξ.2.1, ξ.2.2.1, (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (ξ.1 ^ drx B.h) • vrv)
      = g' ξ := by
    rw [sub_add_cancel]
  have H3' : HasDerivAt (fun p : ℝ => ∫ r in (0:ℝ)..p,
      g' (r, ξ.2.1, ξ.2.2.1, (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv)) (g' ξ) ξ.1 := by
    rw [← hval]
    exact H3

  have hs1 := dR_Icut_formula_v5 B g' ξ hok hξ1 hξ2 H1 H2 H3'
  have hpath : ∀ r : ℝ, pathPt B.h ξ r =
      (r, ξ.2.1, ξ.2.2.1, (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv) := by
    intro r
    have e : ξ.2.2.2 + (r ^ drx B.h - ξ.1 ^ drx B.h) • vrv =
        (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv := by
      rw [sub_smul]
      abel
    show (r, ξ.2.1, ξ.2.2.1, ξ.2.2.2 + (r ^ drx B.h - ξ.1 ^ drx B.h) • vrv) = _
    rw [e]
  have hfun : (fun r : ℝ => g (pathPt B.h ξ r)) =
      fun r => g (r, ξ.2.1, ξ.2.2.1, (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv) :=
    funext fun r => by rw [hpath r]
  have hrho : ∀ r : ℝ, rhoP B (pathPt B.h ξ r) = rhoP B (r, ξ.2.1, ξ.2.2.1, 0) := fun r => rfl
  have hg'path : ∀ r : ℝ, g' (pathPt B.h ξ r) =
      g (pathPt B.h ξ r) - rhoP B (r, ξ.2.1, ξ.2.2.1, 0) * radMom g 0 ξ.2.1 ξ.2.2.1 := by
    intro r
    rw [hg', ← hrho r]
    rfl
  have hI1 : MeasureTheory.IntegrableOn (fun r : ℝ => g (pathPt B.h ξ r)) (Set.Ioi (0:ℝ)) := by
    have := path_integrable_v5 B (qsOf l0) g hok hqs0 hqs1 hgs hgz
      (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) hξ2 hξ3
    rw [hfun]
    exact this
  have hint1 := rhoP_integral_one_v5 B ξ.2.1 ξ.2.2.1 0 hok hξ2
  have hI2 : MeasureTheory.Integrable (fun r : ℝ => rhoP B (r, ξ.2.1, ξ.2.2.1, 0))
      (MeasureTheory.volume.restrict (Set.Ioi (0:ℝ))) :=
    MeasureTheory.Integrable.of_integral_ne_zero (by rw [hint1]; norm_num)
  have hsplit : ∫ r in Set.Ioi (0:ℝ), g' (pathPt B.h ξ r) =
      (∫ r in Set.Ioi (0:ℝ), g (pathPt B.h ξ r)) - radMom g 0 ξ.2.1 ξ.2.2.1 := by
    simp_rw [hg'path]
    rw [MeasureTheory.integral_sub hI1 (hI2.mul_const _), MeasureTheory.integral_mul_const, hint1,
      one_mul]
  have hI : ∫ r in Set.Ioi (0:ℝ), g (pathPt B.h ξ r) =
      ∫ r in Set.Ioi (0:ℝ), g (r, ξ.2.1, ξ.2.2.1, (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv) := by
    rw [hfun]

  have hg'ξ : g' ξ = g ξ - rhoP B ξ * radMom g 0 ξ.2.1 ξ.2.2.1 := by rw [hg']
  rw [hs1, hsplit, hI, hg'ξ]
  ring

theorem torus_mean_jpow_invariant_v5 : ∀ (n : ℕ) (g : ℝ × ℝ → ℝ), Continuous g → (∀ (Z : ℝ × ℝ) (i j : ℤ), g (Z + ((i:ℝ), (j:ℝ))) = g Z) → ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (Jpow (n:ℤ) Y) = ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g Z :=
by

  have per1 : ∀ (φ : ℝ → ℝ) (a : ℤ) (c : ℝ), Continuous φ → (∀ x : ℝ, φ (x + 1) = φ x) → a ≠ 0 →
      ∫ y in Set.Icc (0:ℝ) 1, φ ((a:ℝ) * y + c) = ∫ y in Set.Icc (0:ℝ) 1, φ y := by
    intro φ a c hφ hper ha
    have ha' : (a:ℝ) ≠ 0 := Int.cast_ne_zero.mpr ha
    have hP : Function.Periodic φ 1 := hper
    rw [integral_Icc_eq_integral_Ioc, integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le zero_le_one, ← intervalIntegral.integral_of_le zero_le_one,
      intervalIntegral.integral_comp_mul_add φ ha' c, mul_zero, zero_add, mul_one]
    have e : (a:ℝ) + c = c + a • (1:ℝ) := by rw [zsmul_eq_mul]; ring
    rw [e, hP.intervalIntegral_add_zsmul_eq a c (fun t₁ t₂ => hφ.intervalIntegrable t₁ t₂),
      hP.intervalIntegral_add_eq c 0, zero_add, zsmul_eq_mul, smul_eq_mul, inv_mul_cancel_left₀ ha']

  have fub : ∀ Ψ : ℝ × ℝ → ℝ, Continuous Ψ →
      ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, Ψ Z =
        ∫ x in Set.Icc (0:ℝ) 1, ∫ y in Set.Icc (0:ℝ) 1, Ψ (x, y) := by
    intro Ψ hΨ
    rw [Measure.volume_eq_prod]
    exact setIntegral_prod Ψ
      ((hΨ.continuousOn).integrableOn_compact (isCompact_Icc.prod isCompact_Icc))

  have shear : ∀ (h : ℝ × ℝ → ℝ), Continuous h → (∀ Z : ℝ × ℝ, h (Z + ((0:ℝ), (1:ℝ))) = h Z) →
      ∀ (a : ℤ) (k : ℝ), a ≠ 0 →
      ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, h (Y.1, (a:ℝ) * Y.2 + k * Y.1) =
        ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, h Z := by
    intro h hc hp a k ha
    have hc' : Continuous (fun Y : ℝ × ℝ => h (Y.1, (a:ℝ) * Y.2 + k * Y.1)) :=
      hc.comp (continuous_fst.prodMk
        ((continuous_const.mul continuous_snd).add (continuous_const.mul continuous_fst)))
    rw [fub _ hc', fub h hc]
    congr 1
    funext x
    exact per1 (fun y => h (x, y)) a (k * x) (hc.comp (continuous_const.prodMk continuous_id))
      (fun y => by
        have := hp (x, y)
        simpa using this) ha

  have swp : ∀ f : ℝ × ℝ → ℝ,
      ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, f (Y.2, Y.1) =
        ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, f Z := by
    intro f
    rw [Measure.volume_eq_prod]
    exact setIntegral_prod_swap (Set.Icc (0:ℝ) 1) (Set.Icc (0:ℝ) 1) f

  have Ainv : ∀ g : ℝ × ℝ → ℝ, Continuous g →
      (∀ (Z : ℝ × ℝ) (i j : ℤ), g (Z + ((i:ℝ), (j:ℝ))) = g Z) →
      ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (3 * Y.1 + Y.2, Y.1 + 5 * Y.2) =
        ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g Z := by
    intro g hg hp
    have h1c : Continuous (fun Z : ℝ × ℝ => g (Z.2, ((-14:ℤ):ℝ) * Z.1 + 5 * Z.2)) :=
      hg.comp (continuous_snd.prodMk
        ((continuous_const.mul continuous_fst).add (continuous_const.mul continuous_snd)))
    have h1p : ∀ Z : ℝ × ℝ, (fun Z : ℝ × ℝ => g (Z.2, ((-14:ℤ):ℝ) * Z.1 + 5 * Z.2))
        (Z + ((0:ℝ), (1:ℝ))) = (fun Z : ℝ × ℝ => g (Z.2, ((-14:ℤ):ℝ) * Z.1 + 5 * Z.2)) Z := by
      intro Z
      calc g ((Z + ((0:ℝ), (1:ℝ))).2, ((-14:ℤ):ℝ) * (Z + ((0:ℝ), (1:ℝ))).1 + 5 * (Z + ((0:ℝ), (1:ℝ))).2)
          = g ((Z.2, ((-14:ℤ):ℝ) * Z.1 + 5 * Z.2) + (((1:ℤ):ℝ), ((5:ℤ):ℝ))) := by
            congr 1
            ext <;> push_cast [Prod.fst_add, Prod.snd_add] <;> ring
        _ = g (Z.2, ((-14:ℤ):ℝ) * Z.1 + 5 * Z.2) := hp _ 1 5
    have s1 := shear (fun Z : ℝ × ℝ => g (Z.2, ((-14:ℤ):ℝ) * Z.1 + 5 * Z.2)) h1c h1p 1 3 one_ne_zero
    have s2 := swp (fun W : ℝ × ℝ => g (W.1, ((-14:ℤ):ℝ) * W.2 + 5 * W.1))
    have hgp : ∀ Z : ℝ × ℝ, g (Z + ((0:ℝ), (1:ℝ))) = g Z := by
      intro Z
      have := hp Z 0 1
      simpa using this
    have s3 := shear g hg hgp (-14) 5 (by norm_num)
    calc ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (3 * Y.1 + Y.2, Y.1 + 5 * Y.2)
        = ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
            g ((Y.1, ((1:ℤ):ℝ) * Y.2 + 3 * Y.1).2,
              ((-14:ℤ):ℝ) * (Y.1, ((1:ℤ):ℝ) * Y.2 + 3 * Y.1).1 + 5 * (Y.1, ((1:ℤ):ℝ) * Y.2 + 3 * Y.1).2) := by
          congr 1
          funext Y
          congr 1
          ext <;> push_cast <;> ring
      _ = ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (Z.2, ((-14:ℤ):ℝ) * Z.1 + 5 * Z.2) := s1
      _ = ∫ W in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (W.1, ((-14:ℤ):ℝ) * W.2 + 5 * W.1) := s2
      _ = ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g Z := s3

  have hsq2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hsq0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
  have hsqlt : Real.sqrt 2 < 2 := by nlinarith
  have hL : Lgc ≠ 0 := by unfold Lgc; intro h0; linarith
  have hT : Tgc ≠ 0 := by unfold Tgc; intro h0; linarith
  have hJ : ∀ (k : ℤ) (Y : ℝ × ℝ), Jpow (k + 1) Y =
      (3 * (Jpow k Y).1 + (Jpow k Y).2, (Jpow k Y).1 + 5 * (Jpow k Y).2) := by
    intro k Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, Prod.mk_add_mk, smul_eq_mul, zpow_add_one₀ hL,
      zpow_add_one₀ hT]
    have hb : bgc = Real.sqrt 2 - 1 := rfl
    have hLd : Lgc = 4 - Real.sqrt 2 := rfl
    have hTd : Tgc = 4 + Real.sqrt 2 := rfl
    rw [hLd, hTd, hb, Prod.mk.injEq]
    constructor
    · linear_combination ((4 + Real.sqrt 2) ^ k * ((((Real.sqrt 2 - 1)) * Y.1 + Y.2) /
        (1 + (Real.sqrt 2 - 1) ^ 2))) * hsq2
    · linear_combination ((4 - Real.sqrt 2) ^ k * ((Y.1 - (Real.sqrt 2 - 1) * Y.2) /
        (1 + (Real.sqrt 2 - 1) ^ 2))) * hsq2
  have hJ0 : ∀ Y : ℝ × ℝ, Jpow 0 Y = Y := by
    intro Y
    ext <;> simp only [Jpow, vrv, vtv, Prod.smul_mk, Prod.mk_add_mk, smul_eq_mul, zpow_zero, one_mul] <;>
      field_simp <;> ring

  intro n
  induction n with
  | zero =>
    intro g _ _
    simp [hJ0]
  | succ n ih =>
    intro g hg hp
    have hg' : Continuous (fun Z : ℝ × ℝ => g (3 * Z.1 + Z.2, Z.1 + 5 * Z.2)) :=
      hg.comp (((continuous_const.mul continuous_fst).add continuous_snd).prodMk
        (continuous_fst.add (continuous_const.mul continuous_snd)))
    have hp' : ∀ (Z : ℝ × ℝ) (i j : ℤ), (fun Z : ℝ × ℝ => g (3 * Z.1 + Z.2, Z.1 + 5 * Z.2))
        (Z + ((i:ℝ), (j:ℝ))) = (fun Z : ℝ × ℝ => g (3 * Z.1 + Z.2, Z.1 + 5 * Z.2)) Z := by
      intro Z i j
      calc g (3 * (Z + ((i:ℝ), (j:ℝ))).1 + (Z + ((i:ℝ), (j:ℝ))).2,
            (Z + ((i:ℝ), (j:ℝ))).1 + 5 * (Z + ((i:ℝ), (j:ℝ))).2)
          = g ((3 * Z.1 + Z.2, Z.1 + 5 * Z.2) + (((3 * i + j : ℤ):ℝ), ((i + 5 * j : ℤ):ℝ))) := by
            congr 1
            ext <;> push_cast [Prod.fst_add, Prod.snd_add] <;> ring
        _ = g (3 * Z.1 + Z.2, Z.1 + 5 * Z.2) := hp _ _ _
    have hih := ih _ hg' hp'
    calc ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (Jpow ((n + 1 : ℕ) : ℤ) Y)
        = ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
            g (3 * (Jpow (n:ℤ) Y).1 + (Jpow (n:ℤ) Y).2, (Jpow (n:ℤ) Y).1 + 5 * (Jpow (n:ℤ) Y).2) := by
          congr 1
          funext Y
          rw [Nat.cast_succ, hJ]
      _ = ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (3 * Z.1 + Z.2, Z.1 + 5 * Z.2) := hih
      _ = ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g Z := Ainv g hg hp

theorem tn_cell_coef_deriv_v5 : ∀ (φ : ℝ × ℝ → ℝ), ContDiff ℝ 1 φ →
    (∀ (n m : ℤ) (Y : ℝ × ℝ), φ (Y + ((n:ℝ), (m:ℝ))) = φ Y) →
    ∀ (w : ℝ × ℝ) (k : ℤ × ℤ),
      ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), ((fderiv ℝ φ Y w : ℝ) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) =
        (2 * Real.pi * Complex.I * ((k.1 : ℂ) * (w.1 : ℂ) + (k.2 : ℂ) * (w.2 : ℂ))) *
        ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (φ Y : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) :=
by
  intro φ hφ hper w k
  set E : ℝ × ℝ → ℂ := fun Y =>
    Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) with hE
  have hd : Differentiable ℝ φ := hφ.differentiable (by norm_num)
  have hc' : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv (by norm_num)
  have hEc : Continuous E := by
    rw [hE]
    exact Complex.continuous_exp.comp (by fun_prop)
  have hPc : ∀ v : ℝ × ℝ, Continuous (fun Y => ((fderiv ℝ φ Y v : ℝ) : ℂ) * E Y) := fun v =>
    (Complex.continuous_ofReal.comp (hc'.clm_apply continuous_const)).mul hEc
  have hFc : Continuous (fun Y => (φ Y : ℂ) * E Y) :=
    (Complex.continuous_ofReal.comp hφ.continuous).mul hEc

  have hderφ : ∀ (γ : ℝ → ℝ × ℝ) (v : ℝ × ℝ) (t : ℝ), HasDerivAt γ v t →
      HasDerivAt (fun s => (φ (γ s) : ℂ)) ((fderiv ℝ φ (γ t) v : ℝ) : ℂ) t := by
    intro γ v t hγ
    exact ((hd (γ t)).hasFDerivAt.comp_hasDerivAt t hγ).ofReal_comp

  have ibp : ∀ (γ : ℝ → ℝ × ℝ) (v : ℝ × ℝ) (κ : ℂ), (∀ t, HasDerivAt γ v t) →
      (∀ t, HasDerivAt (fun s => E (γ s)) (E (γ t) * (-(2 * Real.pi * Complex.I) * κ)) t) →
      φ (γ 1) = φ (γ 0) → E (γ 1) = E (γ 0) →
      ∫ t in (0:ℝ)..1, ((fderiv ℝ φ (γ t) v : ℝ) : ℂ) * E (γ t) =
        (2 * Real.pi * Complex.I * κ) * ∫ t in (0:ℝ)..1, (φ (γ t) : ℂ) * E (γ t) := by
    intro γ v κ hγ hEγ hφ1 hE1
    have hγc : Continuous γ := continuous_iff_continuousAt.mpr fun t => (hγ t).continuousAt
    have hA : Continuous (fun t => ((fderiv ℝ φ (γ t) v : ℝ) : ℂ) * E (γ t)) := (hPc v).comp hγc
    have hF : Continuous (fun t => (φ (γ t) : ℂ) * E (γ t)) := hFc.comp hγc
    have hCF : Continuous (fun t => (2 * Real.pi * Complex.I * κ) * ((φ (γ t) : ℂ) * E (γ t))) :=
      continuous_const.mul hF
    have hder : ∀ t, HasDerivAt (fun s => (φ (γ s) : ℂ) * E (γ s))
        (((fderiv ℝ φ (γ t) v : ℝ) : ℂ) * E (γ t) -
          (2 * Real.pi * Complex.I * κ) * ((φ (γ t) : ℂ) * E (γ t))) t := by
      intro t
      exact ((hderφ γ v t (hγ t)).mul (hEγ t)).congr_deriv (by ring)
    have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hder t)
      ((hA.sub hCF).intervalIntegrable 0 1)
    rw [intervalIntegral.integral_sub (hA.intervalIntegrable 0 1) (hCF.intervalIntegrable 0 1),
      intervalIntegral.integral_const_mul, hφ1, hE1, sub_self] at hftc
    exact sub_eq_zero.mp hftc

  have hEx : ∀ y t : ℝ, HasDerivAt (fun s : ℝ => E (s, y))
      (E (t, y) * (-(2 * Real.pi * Complex.I) * (k.1 : ℂ))) t := by
    intro y t
    have h1 : HasDerivAt (fun s : ℝ => -(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (s : ℂ) + (k.2 : ℂ) * (y : ℂ)))
        (-(2 * Real.pi * Complex.I) * (k.1 : ℂ)) t := by
      have := ((((hasDerivAt_id t).ofReal_comp).const_mul (k.1 : ℂ)).add_const
        ((k.2 : ℂ) * (y : ℂ))).const_mul (-(2 * Real.pi * Complex.I))
      exact this.congr_deriv (by simp)
    rw [hE]
    exact h1.cexp
  have hEy : ∀ x t : ℝ, HasDerivAt (fun s : ℝ => E (x, s))
      (E (x, t) * (-(2 * Real.pi * Complex.I) * (k.2 : ℂ))) t := by
    intro x t
    have h1 : HasDerivAt (fun s : ℝ => -(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (x : ℂ) + (k.2 : ℂ) * (s : ℂ)))
        (-(2 * Real.pi * Complex.I) * (k.2 : ℂ)) t := by
      have := ((((hasDerivAt_id t).ofReal_comp).const_mul (k.2 : ℂ)).const_add
        ((k.1 : ℂ) * (x : ℂ))).const_mul (-(2 * Real.pi * Complex.I))
      exact this.congr_deriv (by simp)
    rw [hE]
    exact h1.cexp

  have hφx : ∀ y : ℝ, φ (1, y) = φ (0, y) := by
    intro y
    have := hper 1 0 (0, y)
    simpa using this
  have hφy : ∀ x : ℝ, φ (x, 1) = φ (x, 0) := by
    intro x
    have := hper 0 1 (x, 0)
    simpa using this
  have hEx1 : ∀ y : ℝ, E (1, y) = E (0, y) := by
    intro y
    rw [hE]
    dsimp only
    rw [Complex.exp_eq_exp_iff_exists_int]
    refine ⟨-k.1, ?_⟩
    push_cast
    ring
  have hEy1 : ∀ x : ℝ, E (x, 1) = E (x, 0) := by
    intro x
    rw [hE]
    dsimp only
    rw [Complex.exp_eq_exp_iff_exists_int]
    refine ⟨-k.2, ?_⟩
    push_cast
    ring

  have lineX : ∀ y : ℝ, ∫ x in Set.Icc (0:ℝ) 1, ((fderiv ℝ φ (x, y) ((1:ℝ), (0:ℝ)) : ℝ) : ℂ) * E (x, y) =
      (2 * Real.pi * Complex.I * (k.1 : ℂ)) * ∫ x in Set.Icc (0:ℝ) 1, (φ (x, y) : ℂ) * E (x, y) := by
    intro y
    rw [MeasureTheory.integral_Icc_eq_integral_Ioc, MeasureTheory.integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le zero_le_one, ← intervalIntegral.integral_of_le zero_le_one]
    exact ibp (fun x => (x, y)) ((1:ℝ), (0:ℝ)) (k.1 : ℂ)
      (fun t => (hasDerivAt_id' t).prodMk (hasDerivAt_const t y)) (hEx y) (hφx y) (hEx1 y)
  have lineY : ∀ x : ℝ, ∫ y in Set.Icc (0:ℝ) 1, ((fderiv ℝ φ (x, y) ((0:ℝ), (1:ℝ)) : ℝ) : ℂ) * E (x, y) =
      (2 * Real.pi * Complex.I * (k.2 : ℂ)) * ∫ y in Set.Icc (0:ℝ) 1, (φ (x, y) : ℂ) * E (x, y) := by
    intro x
    rw [MeasureTheory.integral_Icc_eq_integral_Ioc, MeasureTheory.integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le zero_le_one, ← intervalIntegral.integral_of_le zero_le_one]
    exact ibp (fun y => (x, y)) ((0:ℝ), (1:ℝ)) (k.2 : ℂ)
      (fun t => (hasDerivAt_const t x).prodMk (hasDerivAt_id' t)) (hEy x) (hφy x) (hEy1 x)

  have fub : ∀ Ψ : ℝ × ℝ → ℂ, Continuous Ψ →
      ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Ψ Z =
        ∫ x in Set.Icc (0:ℝ) 1, ∫ y in Set.Icc (0:ℝ) 1, Ψ (x, y) := by
    intro Ψ hΨ
    rw [MeasureTheory.Measure.volume_eq_prod]
    exact MeasureTheory.setIntegral_prod Ψ
      ((hΨ.continuousOn).integrableOn_compact (isCompact_Icc.prod isCompact_Icc))
  have fub2 : ∀ Ψ : ℝ × ℝ → ℂ, Continuous Ψ →
      ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Ψ Z =
        ∫ y in Set.Icc (0:ℝ) 1, ∫ x in Set.Icc (0:ℝ) 1, Ψ (x, y) := by
    intro Ψ hΨ
    have h1 := fub (fun Z => Ψ Z.swap) (hΨ.comp continuous_swap)
    have h2 : ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Ψ Z.swap =
        ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Ψ Z := by
      rw [MeasureTheory.Measure.volume_eq_prod]
      exact MeasureTheory.setIntegral_prod_swap _ _ Ψ
    rw [← h2, h1]
    rfl

  have I1 : ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), ((fderiv ℝ φ Y ((1:ℝ), (0:ℝ)) : ℝ) : ℂ) * E Y =
      (2 * Real.pi * Complex.I * (k.1 : ℂ)) *
        ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (φ Y : ℂ) * E Y := by
    rw [fub2 _ (hPc _), fub2 _ hFc, ← MeasureTheory.integral_const_mul]
    congr 1
    funext y
    exact lineX y
  have I2 : ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), ((fderiv ℝ φ Y ((0:ℝ), (1:ℝ)) : ℝ) : ℂ) * E Y =
      (2 * Real.pi * Complex.I * (k.2 : ℂ)) *
        ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (φ Y : ℂ) * E Y := by
    rw [fub _ (hPc _), fub _ hFc, ← MeasureTheory.integral_const_mul]
    congr 1
    funext x
    exact lineY x

  have hlin : ∀ Y, fderiv ℝ φ Y w =
      w.1 * fderiv ℝ φ Y ((1:ℝ), (0:ℝ)) + w.2 * fderiv ℝ φ Y ((0:ℝ), (1:ℝ)) := by
    intro Y
    have e : w = w.1 • ((1:ℝ), (0:ℝ)) + w.2 • ((0:ℝ), (1:ℝ)) := by ext <;> simp
    calc fderiv ℝ φ Y w = fderiv ℝ φ Y (w.1 • ((1:ℝ), (0:ℝ)) + w.2 • ((0:ℝ), (1:ℝ))) := by rw [← e]
      _ = _ := by rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
  have hlinC : ∀ Y, ((fderiv ℝ φ Y w : ℝ) : ℂ) * E Y =
      (w.1 : ℂ) * (((fderiv ℝ φ Y ((1:ℝ), (0:ℝ)) : ℝ) : ℂ) * E Y) +
        (w.2 : ℂ) * (((fderiv ℝ φ Y ((0:ℝ), (1:ℝ)) : ℝ) : ℂ) * E Y) := by
    intro Y
    rw [hlin Y]
    push_cast
    ring
  have hint : ∀ v : ℝ × ℝ, MeasureTheory.IntegrableOn (fun Y => ((fderiv ℝ φ Y v : ℝ) : ℂ) * E Y)
      (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := fun v =>
    (hPc v).continuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
  rw [show (fun Y => ((fderiv ℝ φ Y w : ℝ) : ℂ) * E Y) = fun Y =>
      (w.1 : ℂ) * (((fderiv ℝ φ Y ((1:ℝ), (0:ℝ)) : ℝ) : ℂ) * E Y) +
        (w.2 : ℂ) * (((fderiv ℝ φ Y ((0:ℝ), (1:ℝ)) : ℝ) : ℂ) * E Y) from funext hlinC]
  rw [MeasureTheory.integral_add ((hint _).const_mul _) ((hint _).const_mul _),
    MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul, I1, I2]
  ring

theorem box_coef_decay_v5 : ∀ (P J : ℕ) (M : ℝ) (G : ℝ × (ℝ × ℝ) → ℝ), ContDiff ℝ ∞ G → (∀ (s : ℝ) (Z : ℝ × ℝ) (i j : ℤ), G (s, Z + ((i:ℝ), (j:ℝ))) = G (s, Z)) → (∀ k : ℕ, k ≤ J + 2 * P → ∀ x : ℝ × (ℝ × ℝ), ‖iteratedFDeriv ℝ k G x‖ ≤ M) → ∀ m : ℤ × ℤ, ContDiff ℝ ∞ (fun s : ℝ => ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, (G (s, Z) : ℂ) * Complex.exp (-(2 * ↑Real.pi * Complex.I * ((m.1 : ℂ) * (Z.1 : ℂ) + (m.2 : ℂ) * (Z.2 : ℂ))))) ∧ ∀ j : ℕ, j ≤ J → ∀ s : ℝ, ‖iteratedDeriv j (fun s : ℝ => ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, (G (s, Z) : ℂ) * Complex.exp (-(2 * ↑Real.pi * Complex.I * ((m.1 : ℂ) * (Z.1 : ℂ) + (m.2 : ℂ) * (Z.2 : ℂ))))) s‖ ≤ 4 ^ P * M / ((1 + |(m.1:ℝ)|) ^ P * (1 + |(m.2:ℝ)|) ^ P) :=
by
  intro P J M G hG hper hM m

  obtain ⟨ex, hex⟩ : ∃ ex : ℝ × ℝ → ℂ, ∀ Z : ℝ × ℝ, ex Z = Complex.exp (-(2 * ↑Real.pi * Complex.I *
      ((m.1 : ℂ) * (Z.1 : ℂ) + (m.2 : ℂ) * (Z.2 : ℂ)))) := ⟨_, fun _ => rfl⟩
  have hexc : Continuous ex := by
    have e : ex = fun Z : ℝ × ℝ => Complex.exp (-(2 * ↑Real.pi * Complex.I *
        ((m.1 : ℂ) * (Z.1 : ℂ) + (m.2 : ℂ) * (Z.2 : ℂ)))) := funext hex
    rw [e]
    exact Complex.continuous_exp.comp ((continuous_const.mul
      ((continuous_const.mul (Complex.continuous_ofReal.comp continuous_fst)).add
        (continuous_const.mul (Complex.continuous_ofReal.comp continuous_snd)))).neg)
  have hexn : ∀ Z : ℝ × ℝ, ‖ex Z‖ = 1 := by
    intro Z
    rw [hex]
    have e : -(2 * ↑Real.pi * Complex.I * ((m.1 : ℂ) * (Z.1 : ℂ) + (m.2 : ℂ) * (Z.2 : ℂ))) =
        ((-(2 * Real.pi * ((m.1:ℝ) * Z.1 + (m.2:ℝ) * Z.2)) : ℝ) : ℂ) * Complex.I := by
      push_cast; ring
    rw [e, Complex.norm_exp_ofReal_mul_I]

  obtain ⟨cf, hcf⟩ : ∃ cf : (ℝ × (ℝ × ℝ) → ℝ) → ℝ → ℂ, ∀ (F : ℝ × (ℝ × ℝ) → ℝ) (s : ℝ),
      cf F s = ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, (F (s, Z) : ℂ) * Complex.exp (-(2 * ↑Real.pi *
        Complex.I * ((m.1 : ℂ) * (Z.1 : ℂ) + (m.2 : ℂ) * (Z.2 : ℂ)))) := ⟨_, fun _ _ => rfl⟩
  have hcf' : ∀ (F : ℝ × (ℝ × ℝ) → ℝ) (s : ℝ),
      cf F s = ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, (F (s, Z) : ℂ) * ex Z := by
    intro F s
    rw [hcf]
    simp only [hex]
  have hfeq : (fun s : ℝ => ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, (G (s, Z) : ℂ) * Complex.exp (-(2 * ↑Real.pi * Complex.I * ((m.1 : ℂ) * (Z.1 : ℂ) + (m.2 : ℂ) * (Z.2 : ℂ))))) = cf G :=
    funext fun s => (hcf G s).symm
  have hSq : IsCompact (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
  have hSqm : MeasurableSet (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) :=
    measurableSet_Icc.prod measurableSet_Icc
  have hvol : MeasureTheory.volume.real (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) = 1 := by
    rw [MeasureTheory.measureReal_def, MeasureTheory.Measure.volume_eq_prod,
      MeasureTheory.Measure.prod_prod, Real.volume_Icc]
    simp

  have cfb : ∀ (F : ℝ × (ℝ × ℝ) → ℝ) (C s : ℝ), (∀ Z : ℝ × ℝ, ‖F (s, Z)‖ ≤ C) → ‖cf F s‖ ≤ C := by
    intro F C s hF
    rw [hcf']
    have h := MeasureTheory.norm_setIntegral_le_of_norm_le_const (μ := MeasureTheory.volume)
      (s := Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) (C := C) (f := fun Z => (F (s, Z) : ℂ) * ex Z)
      hSq.measure_lt_top (fun Z _ => by rw [norm_mul, hexn, mul_one, Complex.norm_real]; exact hF Z)
    rwa [hvol, mul_one] at h

  obtain ⟨Tv, hT⟩ : ∃ Tv : (ℝ × (ℝ × ℝ)) → (ℝ × (ℝ × ℝ) → ℝ) → (ℝ × (ℝ × ℝ) → ℝ),
      ∀ v g y, Tv v g y = fderiv ℝ g y v := ⟨fun v g y => fderiv ℝ g y v, fun _ _ _ => rfl⟩

  have step : ∀ (v : ℝ × (ℝ × ℝ)) (g : ℝ × (ℝ × ℝ) → ℝ), ‖v‖ ≤ 1 → ContDiff ℝ ∞ g →
      ContDiff ℝ ∞ (Tv v g) ∧
      (∀ (k : ℕ) (x : ℝ × (ℝ × ℝ)), ‖iteratedFDeriv ℝ k (Tv v g) x‖ ≤ ‖iteratedFDeriv ℝ (k + 1) g x‖) ∧
      ((∀ (s : ℝ) (Z : ℝ × ℝ) (i j : ℤ), g (s, Z + ((i:ℝ), (j:ℝ))) = g (s, Z)) →
        ∀ (s : ℝ) (Z : ℝ × ℝ) (i j : ℤ), Tv v g (s, Z + ((i:ℝ), (j:ℝ))) = Tv v g (s, Z)) := by
    intro v g hv hg
    have hTe : Tv v g = ⇑(ContinuousLinearMap.apply ℝ ℝ v) ∘ fderiv ℝ g := by
      funext y
      rw [hT, Function.comp_apply, ContinuousLinearMap.apply_apply]
    have hd : ContDiff ℝ ∞ (fderiv ℝ g) := (contDiff_infty_iff_fderiv.mp hg).2
    have hL : ‖ContinuousLinearMap.apply ℝ ℝ v‖ ≤ 1 := by
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun A => ?_)
      rw [ContinuousLinearMap.apply_apply, one_mul]
      exact (A.le_opNorm v).trans (mul_le_of_le_one_right (norm_nonneg _) hv)
    refine ⟨?_, ?_, ?_⟩
    · rw [hTe]
      exact (ContinuousLinearMap.contDiff _).comp hd
    · intro k x
      rw [hTe]
      calc ‖iteratedFDeriv ℝ k (⇑(ContinuousLinearMap.apply ℝ ℝ v) ∘ fderiv ℝ g) x‖
          ≤ ‖ContinuousLinearMap.apply ℝ ℝ v‖ * ‖iteratedFDeriv ℝ k (fderiv ℝ g) x‖ :=
            ContinuousLinearMap.norm_iteratedFDeriv_comp_left _ hd.contDiffAt
              (by exact_mod_cast le_top)
        _ ≤ 1 * ‖iteratedFDeriv ℝ k (fderiv ℝ g) x‖ :=
            mul_le_mul_of_nonneg_right hL (norm_nonneg _)
        _ = ‖iteratedFDeriv ℝ (k + 1) g x‖ := by rw [one_mul, norm_iteratedFDeriv_fderiv]
    · intro hp s Z i j
      rw [hT, hT]
      have hc : (fun y : ℝ × (ℝ × ℝ) => g (y + ((0:ℝ), ((i:ℝ), (j:ℝ))))) = g := by
        funext y
        rcases y with ⟨a, b⟩
        show g ((a, b) + ((0:ℝ), ((i:ℝ), (j:ℝ)))) = g (a, b)
        rw [Prod.mk_add_mk, add_zero]
        exact hp a b i j
      have h2 := fderiv_comp_add_right (𝕜 := ℝ) (f := g) (x := (s, Z)) ((0:ℝ), ((i:ℝ), (j:ℝ)))
      rw [hc, Prod.mk_add_mk, add_zero] at h2
      rw [← h2]

  have iter : ∀ (v : ℝ × (ℝ × ℝ)) (n : ℕ) (g : ℝ × (ℝ × ℝ) → ℝ), ‖v‖ ≤ 1 → ContDiff ℝ ∞ g →
      ContDiff ℝ ∞ ((Tv v)^[n] g) ∧
      (∀ (k : ℕ) (x : ℝ × (ℝ × ℝ)), ‖iteratedFDeriv ℝ k ((Tv v)^[n] g) x‖ ≤ ‖iteratedFDeriv ℝ (k + n) g x‖) ∧
      ((∀ (s : ℝ) (Z : ℝ × ℝ) (i j : ℤ), g (s, Z + ((i:ℝ), (j:ℝ))) = g (s, Z)) →
        ∀ (s : ℝ) (Z : ℝ × ℝ) (i j : ℤ), (Tv v)^[n] g (s, Z + ((i:ℝ), (j:ℝ))) = (Tv v)^[n] g (s, Z)) := by
    intro v n
    induction n with
    | zero =>
      intro g _ hg
      exact ⟨hg, fun k x => le_rfl, fun hp => hp⟩
    | succ n ih =>
      intro g hv hg
      obtain ⟨h1, h2, h3⟩ := ih g hv hg
      obtain ⟨k1, k2, k3⟩ := step v _ hv h1
      rw [Function.iterate_succ_apply']
      refine ⟨k1, fun k x => (k2 k x).trans ?_, fun hp => k3 (h3 hp)⟩
      have h4 := h2 (k + 1) x
      rwa [show k + 1 + n = k + (n + 1) by omega] at h4

  have hasD : ∀ (f : ℝ × (ℝ × ℝ) → ℝ), ContDiff ℝ ∞ f → ∀ s₀ : ℝ,
      HasDerivAt (cf f) (cf (Tv ((1:ℝ), ((0:ℝ), (0:ℝ))) f) s₀) s₀ := by
    intro f hf s₀
    have hfc : Continuous f := hf.continuous
    have hdf : Differentiable ℝ f := (contDiff_infty_iff_fderiv.mp hf).1
    have hdc : Continuous (fderiv ℝ f) := (contDiff_infty_iff_fderiv.mp hf).2.continuous
    have hslice : ∀ s : ℝ, Continuous (fun Z : ℝ × ℝ => (s, Z)) := fun s =>
      continuous_const.prodMk continuous_id
    obtain ⟨B, hB⟩ := ((isCompact_closedBall s₀ 1).prod hSq).exists_bound_of_continuousOn
      hdc.continuousOn
    have hFc : ∀ s : ℝ, Continuous (fun Z : ℝ × ℝ => (f (s, Z) : ℂ) * ex Z) := fun s =>
      (Complex.continuous_ofReal.comp (hfc.comp (hslice s))).mul hexc
    have hF'c : ∀ s : ℝ, Continuous (fun Z : ℝ × ℝ =>
        ((fderiv ℝ f (s, Z) ((1:ℝ), ((0:ℝ), (0:ℝ))) : ℝ) : ℂ) * ex Z) := fun s =>
      (Complex.continuous_ofReal.comp ((hdc.comp (hslice s)).clm_apply continuous_const)).mul hexc
    have hbd : ∀ Z ∈ Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, ∀ s ∈ Metric.ball s₀ 1,
        ‖((fderiv ℝ f (s, Z) ((1:ℝ), ((0:ℝ), (0:ℝ))) : ℝ) : ℂ) * ex Z‖ ≤ B := by
