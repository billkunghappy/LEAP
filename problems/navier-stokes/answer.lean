          f (ξ.1, ξ.2.1, ξ.2.2.1, Y) := by
        intro Y
        have h := PER f e α hF _ (hsl ξ hξ Y) 0 1
        simp only [Int.cast_one, Int.cast_zero] at h
        exact h
      have hY := YZ f hf ξ hξ hp1 hp2 vrv
      have hsplit : (fun η => fderiv ℝ f η ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) =
          fun η => 1 * fderiv ℝ f η ((1:ℝ), (0:ℝ), (0:ℝ), (0 : ℝ × ℝ)) +
            (drx B.h * ξ.1 ^ (drx B.h - 1)) * fderiv ℝ f η ((0:ℝ), (0:ℝ), (0:ℝ), vrv) := by
        funext η
        have e : ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) =
