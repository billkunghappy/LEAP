theorem leadW_jet : ∀ (h ε r X : ℝ) (U : ℝ → ℝ → ℝ) (B : ℕ → ℝ), 0 < h → h < 1 / 100 → 0 < ε → 0 < r → 0 < X → ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) → (∀ (k : ℕ) (x η : ℝ), 0 ≤ x → x ≤ X → -1 ≤ η → η ≤ 1 → |iteratedDeriv k (fun e => U x e) η| ≤ B k) → ContDiffOn ℝ ∞ (fun e => leadW h U X e) (Ioo (-1 - r) (1 + r)) ∧ ∀ (k : ℕ) (η : ℝ), -1 ≤ η → η ≤ 1 → |iteratedDeriv k (fun e => leadW h U X e) η| ≤ 1 + ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (B (k - i) + 2 * B (k - i + 1)) :=
