  have hq : HasDerivAt (fun e : ℝ => 1 + e ^ 2) (2 * η) η := by
    simpa using (hasDerivAt_pow 2 η).const_add 1
  have hne : (1 + η ^ 2) ≠ 0 := by positivity
  have hinv : HasDerivAt (fun e : ℝ => (1 + e ^ 2)⁻¹) (-(2 * η) * ((1 + η ^ 2)⁻¹) ^ 2) η := by
    convert hq.inv hne using 1
