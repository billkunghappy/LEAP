  have hpreal : ∀ η : ℝ, -1 - r < η → η < 1 + r → ((if n = 0 then 0 else g (η : ℂ) ^ 2 *
      ∑ i ∈ Finset.range (n - 1 + 1), (pv i).1 (η : ℂ) * (pv (n - 1 - i)).1 (η : ℂ)) /
        (n : ℂ)).im = 0 := by
    intro η h1 h2
    rw [← Complex.conj_eq_iff_im]
    by_cases hn : n = 0
    · subst hn; simp
    · simp only [hn, ↓reduceIte, map_div₀, map_mul, map_pow, map_sum, map_natCast,
        hc _ (hreal η h1 h2).2.2.2.2]
      congr 2
      apply Finset.sum_congr rfl
      intro i hi
      have hi' := Finset.mem_range.mp hi
      rw [hc _ (hpvreal i (by omega) η h1 h2).1, hc _ (hpvreal (n - 1 - i) (by omega) η h1 h2).1]
  intro η h1 h2
  obtain ⟨hχ, hζ, hℓ, hz, hgη⟩ := hreal η h1 h2
  have hP : ∀ m, m ≤ n → (starRingEnd ℂ) ((pv m).1 (η : ℂ)) = (pv m).1 (η : ℂ) :=
    fun m hm => hc _ (hpvreal m hm η h1 h2).1
  have hV : ∀ m, m ≤ n → (starRingEnd ℂ) ((pv m).2 (η : ℂ)) = (pv m).2 (η : ℂ) :=
    fun m hm => hc _ (hpvreal m hm η h1 h2).2
