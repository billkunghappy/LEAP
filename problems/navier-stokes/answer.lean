      unfold bandIdx
      rcases Nat.eq_zero_or_pos l with h0 | hpos
      · have e : Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l:ℝ) ^ 2)) = 0 := by
          rw [h0]; simp
        rw [e, Int.floor_zero, Int.cast_zero]
        exact hR
      · have hl1 : (1:ℝ) ≤ (l:ℝ) ^ 2 := one_le_pow₀ (by exact_mod_cast hpos)
        have hA : 0 < (2:ℝ) ^ ((1 + h) * (l:ℝ)) := Real.rpow_pos_of_pos two_pos _
        have hAl : 0 < (2:ℝ) ^ ((1 + h) * (l:ℝ)) / (l:ℝ) ^ 2 := div_pos hA (by linarith)
        have h1 := Int.floor_le (Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / (l:ℝ) ^ 2))
        have h2 := Real.logb_le_logb_of_le hT1 hAl (div_le_self hA.le hl1)
        have h3 : Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ))) =
            (1 + h) * l * Real.log 2 / Real.log Tgc := by
          rw [Real.logb_rpow_eq_mul_logb_of_pos two_pos, ← Real.log_div_log]
          ring
        have hlx : (l:ℝ) ≤ x := by
          have e1 : l + 4 = bandOf q := by omega
          have e2 : ((⌈x⌉₊ : ℕ) : ℝ) < x + 1 := Nat.ceil_lt_add_one hx0
          have e3 : ((l:ℝ) + 4) = ((⌈x⌉₊ : ℕ) : ℝ) := by rw [← hb]; exact_mod_cast e1
          linarith
        have h4 : (1 + h) * l * Real.log 2 / Real.log Tgc ≤
            (1 + h) * x * Real.log 2 / Real.log Tgc := by
          rw [div_eq_mul_inv, div_eq_mul_inv]
          apply mul_le_mul_of_nonneg_right _ (inv_nonneg.mpr hTl.le)
          apply mul_le_mul_of_nonneg_right _ hl2.le
          exact mul_le_mul_of_nonneg_left hlx (by linarith)
        linarith
    have hd : drx h / 2 + h * kapS = (1 + h) * (Real.log Lgc / Real.log Tgc) := by
      unfold drx; ring
    have hlq : Real.log q = -(x * Real.log 2) := by rw [hx]; ring
    rw [← Real.rpow_intCast, Real.rpow_def_of_pos hL0, Real.rpow_def_of_pos q0, Real.exp_le_exp,
      hd, hlq]
    calc Real.log Lgc * ((coarseIdx h q : ℤ) : ℝ)
        ≤ Real.log Lgc * ((1 + h) * x * Real.log 2 / Real.log Tgc) :=
          mul_le_mul_of_nonneg_left hstar hLl.le
      _ = -(x * Real.log 2) * -((1 + h) * (Real.log Lgc / Real.log Tgc)) := by ring

  have hshell : ∀ (d e q r X L Xa Xb a : ℝ) (j : ℕ), a = d - 1 - (j:ℝ) → 0 < q → 0 < Xa → Xa < X →
      X < Xb → 0 < r → r ^ 2 = 2 * q * X → 0 ≤ L → L ≤ q ^ (-(d / 2 + e)) →
      Real.sqrt q * (L * Real.sqrt q ^ j * r ^ a) ≤
        ((2 * Xa) ^ (a / 2) + (2 * Xb) ^ (a / 2)) * q ^ (-e) := by
    intro d e q r X L Xa Xb a j ha hq0 hXa' hX1 hX2 hr0 hr2 hL0 hL
    have hr : r ^ a = (2 * X) ^ (a / 2) * q ^ (a / 2) := by
      calc r ^ a = r ^ ((2:ℝ) * (a / 2)) := by congr 1; ring
        _ = (r ^ (2:ℝ)) ^ (a / 2) := Real.rpow_mul hr0.le _ _
        _ = (2 * X * q) ^ (a / 2) := by
            congr 1
            rw [Real.rpow_two, hr2]
            ring
        _ = (2 * X) ^ (a / 2) * q ^ (a / 2) := Real.mul_rpow (by linarith) hq0.le
    have hsq : Real.sqrt q = q ^ (1/2:ℝ) := Real.sqrt_eq_rpow q
    have hsqj : Real.sqrt q ^ j = q ^ ((j:ℝ) / 2) := by
      rw [hsq, ← Real.rpow_natCast, ← Real.rpow_mul hq0.le]
      congr 1
      ring
    have e1 : q ^ (1/2:ℝ) * q ^ ((j:ℝ) / 2) * q ^ (a / 2) = q ^ (d / 2) := by
      rw [← Real.rpow_add hq0, ← Real.rpow_add hq0]
      congr 1
      rw [ha]
      ring
    have key : Real.sqrt q * (L * Real.sqrt q ^ j * r ^ a) =
        (2 * X) ^ (a / 2) * (L * q ^ (d / 2)) := by
      rw [hr, hsqj, hsq, ← e1]
      ring
    have hLq : L * q ^ (d / 2) ≤ q ^ (-e) := by
      calc L * q ^ (d / 2) ≤ q ^ (-(d / 2 + e)) * q ^ (d / 2) :=
            mul_le_mul_of_nonneg_right hL (Real.rpow_nonneg hq0.le _)
        _ = q ^ (-e) := by
            rw [← Real.rpow_add hq0]
            congr 1
            ring
    have hE : (2 * X) ^ (a / 2) ≤ (2 * Xa) ^ (a / 2) + (2 * Xb) ^ (a / 2) := by
      rcases le_or_gt 0 (a / 2) with hs | hs
      · have h1 := Real.rpow_le_rpow (by linarith : (0:ℝ) ≤ 2 * X) (by linarith : 2 * X ≤ 2 * Xb) hs
        have h2 := Real.rpow_nonneg (by linarith : (0:ℝ) ≤ 2 * Xa) (a / 2)
        linarith
      · have h1 := Real.rpow_le_rpow_of_nonpos (by linarith : (0:ℝ) < 2 * Xa)
          (by linarith : 2 * Xa ≤ 2 * X) hs.le
        have h2 := Real.rpow_nonneg (by linarith : (0:ℝ) ≤ 2 * Xb) (a / 2)
        linarith
    rw [key]
    calc (2 * X) ^ (a / 2) * (L * q ^ (d / 2)) ≤ (2 * X) ^ (a / 2) * q ^ (-e) :=
          mul_le_mul_of_nonneg_left hLq (Real.rpow_nonneg (by linarith) _)
      _ ≤ ((2 * Xa) ^ (a / 2) + (2 * Xb) ^ (a / 2)) * q ^ (-e) :=
          mul_le_mul_of_nonneg_right hE (Real.rpow_nonneg hq0.le _)

  have hphi : ∀ (p : ℝ) (j : ℕ) (ξ : Cyl), 0 < ξ.1 →
      NB B.h (fun η : Cyl => η.1 ^ p) j ξ ≤
        |Polynomial.eval p (descPochhammer ℝ j)| * Real.sqrt (qC B.h ξ) ^ j * ξ.1 ^ (p - (j:ℝ)) := by
    intro p j ξ hr
    obtain ⟨P, hP⟩ : ∃ P : Cyl →L[ℝ] ℝ, P = ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)) :=
      ⟨_, rfl⟩
    have hPapp : ∀ η : Cyl, P η = η.1 := by intro η; rw [hP]; rfl
    have hg : ContDiffOn ℝ ∞ (fun x : ℝ => x ^ p) (Set.Ioi 0) :=
      (contDiffOn_id (s := Set.Ioi (0:ℝ))).rpow_const_of_ne (fun x hx => ne_of_gt hx)
    have hU : IsOpen (⇑P ⁻¹' Set.Ioi (0:ℝ)) := isOpen_Ioi.preimage P.continuous
    have hPξ : P ξ ∈ Set.Ioi (0:ℝ) := by rw [hPapp]; exact hr
    have hξU : ξ ∈ ⇑P ⁻¹' Set.Ioi (0:ℝ) := hPξ
    have hfeq : (fun η : Cyl => η.1 ^ p) = (fun x : ℝ => x ^ p) ∘ ⇑P := by
      funext η; simp only [Function.comp, hPapp]
    have e1 : iteratedFDeriv ℝ j (fun η : Cyl => η.1 ^ p) ξ =
        (iteratedFDeriv ℝ j (fun x : ℝ => x ^ p) ξ.1).compContinuousLinearMap (fun _ => P) := by
      rw [← iteratedFDerivWithin_of_isOpen (f := fun η : Cyl => η.1 ^ p) j hU hξU, hfeq,
        ContinuousLinearMap.iteratedFDerivWithin_comp_right P hg (uniqueDiffOn_Ioi 0) hU.uniqueDiffOn
          hPξ (i := j) (by exact_mod_cast le_top),
        iteratedFDerivWithin_of_isOpen j isOpen_Ioi hPξ, hPapp]
    have e0 : ∀ v : Cyl, (Lnorm B.h ξ v).1 = Real.sqrt (qC B.h ξ) * v.1 := by
      intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have hPL : ‖P.comp (Lnorm B.h ξ)‖ ≤ Real.sqrt (qC B.h ξ) := by
      refine ContinuousLinearMap.opNorm_le_bound _ (Real.sqrt_nonneg _) (fun v => ?_)
      rw [ContinuousLinearMap.comp_apply, hPapp, e0 v, norm_mul,
        Real.norm_of_nonneg (Real.sqrt_nonneg _)]
      exact mul_le_mul_of_nonneg_left (norm_fst_le v) (Real.sqrt_nonneg _)
    have hD : ‖iteratedFDeriv ℝ j (fun x : ℝ => x ^ p) ξ.1‖ =
        |Polynomial.eval p (descPochhammer ℝ j)| * ξ.1 ^ (p - (j:ℝ)) := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
        Real.iter_deriv_rpow_const, Real.norm_eq_abs, abs_mul, abs_of_pos (Real.rpow_pos_of_pos hr _)]
    unfold NB
    rw [e1]
    have hcomp : ((iteratedFDeriv ℝ j (fun x : ℝ => x ^ p) ξ.1).compContinuousLinearMap
        (fun _ => P)).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
        (iteratedFDeriv ℝ j (fun x : ℝ => x ^ p) ξ.1).compContinuousLinearMap
          (fun _ => P.comp (Lnorm B.h ξ)) := by
      ext m; rfl
    rw [hcomp]
    have hprod : ∏ _i : Fin j, ‖P.comp (Lnorm B.h ξ)‖ ≤ Real.sqrt (qC B.h ξ) ^ j := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_pow_left₀ (norm_nonneg _) hPL j
    calc _ ≤ ‖iteratedFDeriv ℝ j (fun x : ℝ => x ^ p) ξ.1‖ * ∏ _i : Fin j, ‖P.comp (Lnorm B.h ξ)‖ :=
          ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
      _ ≤ ‖iteratedFDeriv ℝ j (fun x : ℝ => x ^ p) ξ.1‖ * Real.sqrt (qC B.h ξ) ^ j :=
          mul_le_mul_of_nonneg_left hprod (norm_nonneg _)
      _ = _ := by rw [hD]; ring

  have nbdir : ∀ (h : ℝ) (U : Set Cyl) (ξ : Cyl) (F : Cyl → (Fin 3 → ℂ)) (w : Cyl), IsOpen U → ξ ∈ U →
      ContDiffOn ℝ ∞ F U → ∀ k : ℕ,
      NB h (fun η => fderiv ℝ F η (Lnorm h ξ w)) k ξ ≤ ‖w‖ * NB h F (k + 1) ξ := by
    intro h U ξ F w hU hξ hF k
    have hFd : ContDiffAt ℝ ∞ (fderiv ℝ F) ξ :=
      (hF.fderiv_of_isOpen hU (by exact_mod_cast le_top)).contDiffAt (hU.mem_nhds hξ)
    have hcomp : (fun η => fderiv ℝ F η (Lnorm h ξ w)) =
        (ContinuousLinearMap.apply ℝ (Fin 3 → ℂ) (Lnorm h ξ w)) ∘ (fderiv ℝ F) := by
      funext η; rfl
    have hit : iteratedFDeriv ℝ k (fun η => fderiv ℝ F η (Lnorm h ξ w)) ξ =
        (ContinuousLinearMap.apply ℝ (Fin 3 → ℂ) (Lnorm h ξ w)).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fderiv ℝ F) ξ) := by
      rw [hcomp]
      exact ContinuousLinearMap.iteratedFDeriv_comp_left _ hFd (by exact_mod_cast le_top)
    have hNB0 : 0 ≤ NB h F (k + 1) ξ := norm_nonneg _
    unfold NB
    rw [hit]
    apply ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg (norm_nonneg _) hNB0)
    intro m
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      ContinuousLinearMap.apply_apply]
    have key : (iteratedFDeriv ℝ k (fderiv ℝ F) ξ (fun i => Lnorm h ξ (m i))) (Lnorm h ξ w) =
        ((iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ))
          (Fin.snoc (α := fun _ => Cyl) m w) := by
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_succ_apply_right]
      have e1 : Fin.init (fun i : Fin (k+1) => Lnorm h ξ (Fin.snoc (α := fun _ => Cyl) m w i)) =
          fun i => Lnorm h ξ (m i) := by
        funext i
        simp [Fin.init, Fin.snoc_castSucc]
      rw [e1]
      simp only [Fin.snoc_last]
    rw [key]
    have hprod : ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ =
        (∏ i : Fin k, ‖m i‖) * ‖w‖ := by
      rw [Fin.prod_univ_castSucc]
      simp [Fin.snoc_castSucc, Fin.snoc_last]
    calc _ ≤ ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ *
          ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ :=
          ContinuousMultilinearMap.le_opNorm _ _
      _ = ‖w‖ * ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ *
          ∏ i : Fin k, ‖m i‖ := by rw [hprod]; ring

  have leib : ∀ (ξ : Cyl) {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (U : Set Cyl) (n : ℕ),
      IsOpen U → ξ ∈ U → ∀ (f : Cyl → ℝ) (g : Cyl → V), ContDiffOn ℝ n f U → ContDiffOn ℝ n g U →
      NB B.h (fun η => f η • g η) n ξ ≤
        ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * NB B.h f i ξ * NB B.h g (n - i) ξ := by
    intro ξ V _ _ U n hU hξ f g hf hg
    unfold NB
    generalize Lnorm B.h ξ = L
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
    have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + z)) s := by
      intro W _ _ F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
      intro W _ _ F hF
      exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
    have key' : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ∀ i : ℕ, i ≤ n →
        iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
          (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
      intro W _ _ F hF i hi
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
      calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
              (fun _ => L) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
              (fun _ => L) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
              (fun _ => L) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
    have hfg : ContDiffOn ℝ n (fun η => f η • g η) U := hf.smul hg
    have hl := norm_iteratedFDerivWithin_smul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
      (n := n) le_rfl
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) • g (ξ + L y)) n hO h0O] at hl
    rw [← key' _ hfg n le_rfl]
    calc ‖iteratedFDeriv ℝ n (fun z => (fun η => f η • g η) (ξ + L z)) 0‖
        = ‖iteratedFDeriv ℝ n (fun y => f (ξ + L y) • g (ξ + L y)) 0‖ := rfl
      _ ≤ _ := hl
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (n - i) hO h0O,
          key' f hf i hik, key' g hg (n - i) (Nat.sub_le n i)]

  obtain ⟨Kf, hKf⟩ : ∃ Kf : ℕ → ℝ,
      Kf = fun i => |Polynomial.eval (drx B.h - 1) (descPochhammer ℝ i)| := ⟨_, rfl⟩
  obtain ⟨Ef, hEf⟩ : ∃ Ef : ℕ → ℝ, Ef = fun i : ℕ => |(2 * B.Xa) ^ ((drx B.h - 1 - (i:ℝ)) / 2)| +
      |(2 * B.Xb) ^ ((drx B.h - 1 - (i:ℝ)) / 2)| := ⟨_, rfl⟩
  have hK0 : ∀ i, 0 ≤ Kf i := fun i => by rw [hKf]; exact abs_nonneg _
  have hE0 : ∀ i, 0 ≤ Ef i := fun i => by rw [hEf]; exact add_nonneg (abs_nonneg _) (abs_nonneg _)
  obtain ⟨S, hS⟩ : ∃ S : ℝ, S = ∑ i ∈ Finset.range (k + 1),
      (k.choose i : ℝ) * (Kf i * (|drx B.h| * ‖vrv‖)) * Ef i := ⟨_, rfl⟩
  have hS0 : 0 ≤ S := by
    rw [hS]
    exact Finset.sum_nonneg (fun i _ => mul_nonneg (mul_nonneg (Nat.cast_nonneg _)
      (mul_nonneg (hK0 i) (mul_nonneg (abs_nonneg _) (norm_nonneg _)))) (hE0 i))
  refine ⟨1 + S, ?_⟩
  intro qs a ξ hqs0 hqs1 ha hξ hX1 hX2
  have hΩo : IsOpen (DomC B.h qs) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio qs := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hqpos : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ := fun ξ hξ =>
    (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).1

  have htr : ∀ (F1 F2 : Cyl → (Fin 3 → ℂ)) (j : ℕ), (∀ η ∈ DomC B.h qs, F1 η = F2 η) →
      NB B.h F1 j ξ = NB B.h F2 j ξ := by
    intro F1 F2 j hE
    have hev : F1 =ᶠ[nhds ξ] F2 := Filter.eventuallyEq_of_mem (hΩo.mem_nhds hξ) hE
    unfold NB
    rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds]

  have hcv : ∀ η ∈ DomC B.h qs, ∀ v : Cyl,
      (fun i : Fin 3 => fderiv ℝ (fun η' => a η' i) η v) = fderiv ℝ a η v := by
    intro η hη v
    have hda : DifferentiableAt ℝ a η :=
      (ha.contDiffAt (hΩo.mem_nhds hη)).differentiableAt (by simp)
    have e : fderiv ℝ a η = ContinuousLinearMap.pi (fun i => fderiv ℝ (fun η' => a η' i) η) :=
      fderiv_pi (fun i => differentiableAt_pi.1 hda i)
    rw [e]
    rfl
  have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
  have hq1 : qC B.h ξ ≤ 1 := le_trans hξ.2.2.le hqs1
  have hr : 0 < ξ.1 := hξ.1
  have hs0 : 0 < Real.sqrt (qC B.h ξ) := Real.sqrt_pos.mpr hq0
  have hsL : 0 < Lgc := by
    have : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
    unfold Lgc; linarith
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : ℝ, Λ = Lgc ^ coarseIdx B.h (qC B.h ξ) := ⟨_, rfl⟩
  have hΛ0 : 0 < Λ := by rw [hΛ]; exact zpow_pos hsL _
  obtain ⟨Q, hQ⟩ : ∃ Q : ℝ, Q = qC B.h ξ ^ (-(B.h * kapS)) := ⟨_, rfl⟩
  have hQ1 : 1 ≤ Q := by
    rw [hQ]
    exact Real.one_le_rpow_of_pos_of_le_one_of_nonpos hq0 hq1
      (neg_nonpos.mpr (mul_nonneg hh.le (by unfold kapS; norm_num)))
  obtain ⟨T, hT⟩ : ∃ T : ℝ, T = ∑ i ∈ Finset.range (k + 2), NB B.h a i ξ := ⟨_, rfl⟩
  have hT0 : 0 ≤ T := by rw [hT]; exact Finset.sum_nonneg (fun i _ => norm_nonneg _)
  have hNT : ∀ j, j ≤ k + 1 → NB B.h a j ξ ≤ T := fun j hj => by
    rw [hT]
    exact Finset.single_le_sum (f := fun i => NB B.h a i ξ) (fun i _ => norm_nonneg _)
      (Finset.mem_range.mpr (Nat.lt_succ_of_le hj))

  obtain ⟨u1, hu1⟩ : ∃ u1 : Cyl,
      u1 = ((Real.sqrt (qC B.h ξ))⁻¹, (0:ℝ), (0:ℝ), (0 : ℝ × ℝ)) := ⟨_, rfl⟩
  obtain ⟨u2, hu2⟩ : ∃ u2 : Cyl, u2 = ((0:ℝ), (0:ℝ), (0:ℝ), (Λ * drx B.h) • vrv) := ⟨_, rfl⟩
  obtain ⟨ut, hut⟩ : ∃ ut : Cyl,
      ut = ((0:ℝ), (0:ℝ), (qC B.h ξ)⁻¹, (0 : ℝ × ℝ)) := ⟨_, rfl⟩
  obtain ⟨uz, huz⟩ : ∃ uz : Cyl,
      uz = ((0:ℝ), qC B.h ξ ^ (-(1/2 - B.h)), (0:ℝ), (0 : ℝ × ℝ)) := ⟨_, rfl⟩
  have e0 : ∀ v : Cyl, (Lnorm B.h ξ v).1 = Real.sqrt (qC B.h ξ) * v.1 := by
    intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
  have e1 : ∀ v : Cyl, (Lnorm B.h ξ v).2.1 = qC B.h ξ ^ (1/2 - B.h) * v.2.1 := by
    intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
  have e2 : ∀ v : Cyl, (Lnorm B.h ξ v).2.2.1 = qC B.h ξ * v.2.2.1 := by
    intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
  have e3 : ∀ v : Cyl, (Lnorm B.h ξ v).2.2.2 = JpowL (-coarseIdx B.h (qC B.h ξ)) v.2.2.2 := by
    intro v; rfl
  have hLu1 : Lnorm B.h ξ u1 = ((1, 0, 0, 0) : Cyl) := by
    refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
    · rw [e0, hu1]
      show Real.sqrt (qC B.h ξ) * (Real.sqrt (qC B.h ξ))⁻¹ = 1
      exact mul_inv_cancel₀ hs0.ne'
    · rw [e1, hu1]; simp
    · rw [e2, hu1]; simp
    · rw [e3, hu1]
      exact map_zero _
  have hLu2 : Lnorm B.h ξ u2 = ((0, 0, 0, drx B.h • vrv) : Cyl) := by
    refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
    · rw [e0, hu2]; simp
    · rw [e1, hu2]; simp
    · rw [e2, hu2]; simp
    · rw [e3, hu2]
      show JpowL (-coarseIdx B.h (qC B.h ξ)) ((Λ * drx B.h) • vrv) = drx B.h • vrv
      rw [hJ, hΛ]
      congr 1
      rw [zpow_neg, ← mul_assoc, inv_mul_cancel₀ (zpow_pos hsL _).ne', one_mul]
  have hLut : Lnorm B.h ξ ut = ((0, 0, 1, ((0:ℝ), (0:ℝ))) : Cyl) := by
    refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
    · rw [e0, hut]; simp
    · rw [e1, hut]; simp
    · rw [e2, hut]
      show qC B.h ξ * (qC B.h ξ)⁻¹ = 1
      exact mul_inv_cancel₀ hq0.ne'
    · rw [e3, hut]
      exact map_zero _
  have hLuz : Lnorm B.h ξ uz = ((0, 1, 0, 0) : Cyl) := by
    refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
    · rw [e0, huz]; simp
    · rw [e1, huz]
      show qC B.h ξ ^ (1/2 - B.h) * qC B.h ξ ^ (-(1/2 - B.h)) = 1
      rw [Real.rpow_neg hq0.le, mul_inv_cancel₀ (Real.rpow_pos_of_pos hq0 _).ne']
    · rw [e2, huz]; simp
    · rw [e3, huz]
      exact map_zero _
  have hnu1 : ‖u1‖ = (Real.sqrt (qC B.h ξ))⁻¹ := by
    have hsi : 0 < (Real.sqrt (qC B.h ξ))⁻¹ := inv_pos.mpr hs0
    rw [hu1]
    simp only [Prod.norm_def, norm_zero, Real.norm_eq_abs, abs_of_pos hsi, max_self]
    rw [max_eq_left hsi.le]
  have hnu2 : ‖u2‖ = Λ * (|drx B.h| * ‖vrv‖) := by
    rw [hu2, Prod.norm_mk, Prod.norm_mk, Prod.norm_mk]
    simp only [norm_zero, norm_nonneg, max_eq_right]
    rw [norm_smul, Real.norm_eq_abs, abs_mul, abs_of_pos hΛ0]
    ring
  have hnut : ‖ut‖ = (qC B.h ξ)⁻¹ := by
    have hqi : 0 < (qC B.h ξ)⁻¹ := inv_pos.mpr hq0
    rw [hut, Prod.norm_mk, Prod.norm_mk, Prod.norm_mk]
    simp only [norm_zero, norm_nonneg, max_eq_right, max_eq_left]
    rw [Real.norm_eq_abs, abs_of_pos hqi]
  have hnuz : ‖uz‖ = qC B.h ξ ^ (-(1/2 - B.h)) := by
    have hzp : 0 < qC B.h ξ ^ (-(1/2 - B.h)) := Real.rpow_pos_of_pos hq0 _
    rw [huz, Prod.norm_mk, Prod.norm_mk, Prod.norm_mk]
    simp only [norm_zero, norm_nonneg, max_eq_right, max_eq_left]
    rw [Real.norm_eq_abs, abs_of_pos hzp]
    simp only [max_self]
    rw [max_eq_left hzp.le, max_eq_right hzp.le]

  have hTb : NB B.h (fun η i => dTsV (fun η' => a η' i) η) k ξ ≤
      (1 + S) * qC B.h ξ ^ (-1 : ℝ) * T := by
    have e : NB B.h (fun η i => dTsV (fun η' => a η' i) η) k ξ =
        NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ ut)) k ξ := by
      apply htr
      intro η hη
      rw [hLut]
      exact hcv η hη _
    rw [e, Real.rpow_neg_one]
    have h1 := nbdir B.h (DomC B.h qs) ξ a ut hΩo hξ ha k
    rw [hnut] at h1
    have hqi : 0 ≤ (qC B.h ξ)⁻¹ := inv_nonneg.mpr hq0.le
    calc _ ≤ (qC B.h ξ)⁻¹ * NB B.h a (k + 1) ξ := h1
      _ ≤ (qC B.h ξ)⁻¹ * T := mul_le_mul_of_nonneg_left (hNT (k + 1) le_rfl) hqi
      _ ≤ (1 + S) * ((qC B.h ξ)⁻¹ * T) := le_mul_of_one_le_left (mul_nonneg hqi hT0) (by linarith)
      _ = (1 + S) * (qC B.h ξ)⁻¹ * T := by ring

  have hZb : NB B.h (fun η i => dZ (fun η' => a η' i) η) k ξ ≤
      (1 + S) * qC B.h ξ ^ (-(1/2 - B.h)) * T := by
    have e : NB B.h (fun η i => dZ (fun η' => a η' i) η) k ξ =
        NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ uz)) k ξ := by
      apply htr
      intro η hη
      rw [hLuz]
      exact hcv η hη _
    rw [e]
    have h1 := nbdir B.h (DomC B.h qs) ξ a uz hΩo hξ ha k
    rw [hnuz] at h1
    have hqi : 0 ≤ qC B.h ξ ^ (-(1/2 - B.h)) := (Real.rpow_pos_of_pos hq0 _).le
    calc _ ≤ qC B.h ξ ^ (-(1/2 - B.h)) * NB B.h a (k + 1) ξ := h1
      _ ≤ qC B.h ξ ^ (-(1/2 - B.h)) * T := mul_le_mul_of_nonneg_left (hNT (k + 1) le_rfl) hqi
      _ ≤ (1 + S) * (qC B.h ξ ^ (-(1/2 - B.h)) * T) :=
          le_mul_of_one_le_left (mul_nonneg hqi hT0) (by linarith)
      _ = (1 + S) * qC B.h ξ ^ (-(1/2 - B.h)) * T := by ring

  have hv : ∀ η : Cyl, ((1, 0, 0, (drx B.h * η.1 ^ (drx B.h - 1)) • vrv) : Cyl) =
      Lnorm B.h ξ u1 + η.1 ^ (drx B.h - 1) • Lnorm B.h ξ u2 := by
    intro η
    rw [hLu1, hLu2]
    refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
    · simp
    · simp
    · simp
    · simp [smul_smul, mul_comm]
  have hRe : ∀ η ∈ DomC B.h qs, (fun i => dR B.h (fun η' => a η' i) η) =
      fderiv ℝ a η (Lnorm B.h ξ u1) + η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2) := by
    intro η hη
    have h1 : (fun i => dR B.h (fun η' => a η' i) η) =
        fderiv ℝ a η ((1, 0, 0, (drx B.h * η.1 ^ (drx B.h - 1)) • vrv) : Cyl) := hcv η hη _
    rw [h1, hv η, map_add, map_smul]
  have hRt : NB B.h (fun η i => dR B.h (fun η' => a η' i) η) k ξ =
      NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ u1) +
        η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2)) k ξ :=
    htr _ _ k hRe

  have hFd : ContDiffOn ℝ ∞ (fderiv ℝ a) (DomC B.h qs) :=
    ha.fderiv_of_isOpen hΩo (by exact_mod_cast le_top)
  have hG1 : ContDiffOn ℝ ∞ (fun η => fderiv ℝ a η (Lnorm B.h ξ u1)) (DomC B.h qs) :=
    hFd.clm_apply contDiffOn_const
  have hG2 : ContDiffOn ℝ ∞ (fun η => fderiv ℝ a η (Lnorm B.h ξ u2)) (DomC B.h qs) :=
    hFd.clm_apply contDiffOn_const
  have hfst : ContDiffOn ℝ ∞ (fun η : Cyl => η.1) (DomC B.h qs) := contDiff_fst.contDiffOn
  have hφ : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ (drx B.h - 1)) (DomC B.h qs) :=
    hfst.rpow_const_of_ne (fun η hη => ne_of_gt hη.1)
  have hφG : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2))
      (DomC B.h qs) := hφ.smul hG2

  have hsub : NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ u1) +
        η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2)) k ξ ≤
      NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ u1)) k ξ +
      NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2)) k ξ := by
    have hn : DomC B.h qs ∈ nhds ξ := hΩo.mem_nhds hξ
    have hfun : (fun η => fderiv ℝ a η (Lnorm B.h ξ u1) +
        η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2)) =
        (fun η => fderiv ℝ a η (Lnorm B.h ξ u1)) +
        (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2)) := by
      funext η; rfl
    have ea : iteratedFDeriv ℝ k (fun η => fderiv ℝ a η (Lnorm B.h ξ u1) +
        η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2)) ξ =
        iteratedFDeriv ℝ k (fun η => fderiv ℝ a η (Lnorm B.h ξ u1)) ξ +
        iteratedFDeriv ℝ k (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2)) ξ := by
      rw [hfun]
      exact iteratedFDeriv_add_apply ((hG1.contDiffAt hn).of_le (by exact_mod_cast le_top))
        ((hφG.contDiffAt hn).of_le (by exact_mod_cast le_top))
    unfold NB
    rw [ea]
    have eb : (iteratedFDeriv ℝ k (fun η => fderiv ℝ a η (Lnorm B.h ξ u1)) ξ +
        iteratedFDeriv ℝ k (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2)) ξ
          ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
        (iteratedFDeriv ℝ k (fun η => fderiv ℝ a η (Lnorm B.h ξ u1)) ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) +
        (iteratedFDeriv ℝ k (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2))
          ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [eb]
    exact norm_add_le _ _

  have hG1b : Real.sqrt (qC B.h ξ) * NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ u1)) k ξ ≤ Q * T := by
    have h1 := nbdir B.h (DomC B.h qs) ξ a u1 hΩo hξ ha k
    rw [hnu1] at h1
    calc Real.sqrt (qC B.h ξ) * NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ u1)) k ξ
        ≤ Real.sqrt (qC B.h ξ) * ((Real.sqrt (qC B.h ξ))⁻¹ * NB B.h a (k + 1) ξ) :=
          mul_le_mul_of_nonneg_left h1 hs0.le
      _ = NB B.h a (k + 1) ξ := by rw [← mul_assoc, mul_inv_cancel₀ hs0.ne', one_mul]
      _ ≤ T := hNT (k + 1) le_rfl
      _ ≤ Q * T := le_mul_of_one_le_left hT0 hQ1

  have hl := leib ξ (DomC B.h qs) k hΩo hξ (fun η : Cyl => η.1 ^ (drx B.h - 1))
    (fun η => fderiv ℝ a η (Lnorm B.h ξ u2)) (hφ.of_le (by exact_mod_cast le_top))
    (hG2.of_le (by exact_mod_cast le_top))
  have hX : ξ.1 ^ 2 = 2 * qC B.h ξ * XC B.h ξ := by
    have : XC B.h ξ = ξ.1 ^ 2 / (2 * qC B.h ξ) := rfl
    rw [this]
    field_simp
  have hterm : ∀ i ∈ Finset.range (k + 1), Real.sqrt (qC B.h ξ) * ((k.choose i : ℝ) *
      NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1)) i ξ *
      NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ u2)) (k - i) ξ) ≤
      (k.choose i : ℝ) * (Kf i * (|drx B.h| * ‖vrv‖)) * Ef i * (Q * T) := by
    intro i hi
    have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    have hC0 : (0:ℝ) ≤ (k.choose i : ℝ) := Nat.cast_nonneg _
    have hKi : Kf i = |Polynomial.eval (drx B.h - 1) (descPochhammer ℝ i)| := by rw [hKf]
    have hEi : (2 * B.Xa) ^ ((drx B.h - 1 - (i:ℝ)) / 2) + (2 * B.Xb) ^ ((drx B.h - 1 - (i:ℝ)) / 2)
        ≤ Ef i := by
      rw [hEf]; exact add_le_add (le_abs_self _) (le_abs_self _)
    have b1 : NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1)) i ξ ≤
        Kf i * Real.sqrt (qC B.h ξ) ^ i * ξ.1 ^ (drx B.h - 1 - (i:ℝ)) := by
      rw [hKi]; exact hphi (drx B.h - 1) i ξ hr
    have hA0 : 0 ≤ Kf i * Real.sqrt (qC B.h ξ) ^ i * ξ.1 ^ (drx B.h - 1 - (i:ℝ)) :=
      mul_nonneg (mul_nonneg (hK0 i) (pow_nonneg hs0.le _)) (Real.rpow_nonneg hr.le _)
    have b2 : NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ u2)) (k - i) ξ ≤
        Λ * (|drx B.h| * ‖vrv‖) * T := by
      have h2 := nbdir B.h (DomC B.h qs) ξ a u2 hΩo hξ ha (k - i)
      rw [hnu2] at h2
      exact h2.trans (mul_le_mul_of_nonneg_left (hNT (k - i + 1) (by omega))
        (mul_nonneg hΛ0.le (mul_nonneg (abs_nonneg _) (norm_nonneg _))))
    have b3 : Real.sqrt (qC B.h ξ) * (Λ * Real.sqrt (qC B.h ξ) ^ i * ξ.1 ^ (drx B.h - 1 - (i:ℝ))) ≤
        Ef i * Q := by
      have hsh := hshell (drx B.h) (B.h * kapS) (qC B.h ξ) ξ.1 (XC B.h ξ) Λ B.Xa B.Xb
        (drx B.h - 1 - (i:ℝ)) i rfl hq0 hXa hX1 hX2 hr hX hΛ0.le
        (by rw [hΛ]; exact hcoarse B.h (qC B.h ξ) hh.le hq0 hq1)
      rw [← hQ] at hsh
      exact hsh.trans (mul_le_mul_of_nonneg_right hEi (by linarith))
    have hP0 : 0 ≤ (k.choose i : ℝ) * Kf i * (|drx B.h| * ‖vrv‖) * T :=
      mul_nonneg (mul_nonneg (mul_nonneg hC0 (hK0 i)) (mul_nonneg (abs_nonneg _) (norm_nonneg _))) hT0
    calc Real.sqrt (qC B.h ξ) * ((k.choose i : ℝ) *
          NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1)) i ξ *
          NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ u2)) (k - i) ξ)
        ≤ Real.sqrt (qC B.h ξ) * ((k.choose i : ℝ) *
          (Kf i * Real.sqrt (qC B.h ξ) ^ i * ξ.1 ^ (drx B.h - 1 - (i:ℝ))) *
          (Λ * (|drx B.h| * ‖vrv‖) * T)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul (mul_le_mul_of_nonneg_left b1 hC0) b2
            (norm_nonneg _) (mul_nonneg hC0 hA0)) hs0.le
      _ = ((k.choose i : ℝ) * Kf i * (|drx B.h| * ‖vrv‖) * T) *
          (Real.sqrt (qC B.h ξ) * (Λ * Real.sqrt (qC B.h ξ) ^ i * ξ.1 ^ (drx B.h - 1 - (i:ℝ)))) := by
          ring
      _ ≤ ((k.choose i : ℝ) * Kf i * (|drx B.h| * ‖vrv‖) * T) * (Ef i * Q) :=
          mul_le_mul_of_nonneg_left b3 hP0
      _ = (k.choose i : ℝ) * (Kf i * (|drx B.h| * ‖vrv‖)) * Ef i * (Q * T) := by ring
  have hLb : Real.sqrt (qC B.h ξ) *
      NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2)) k ξ ≤
      S * (Q * T) := by
    calc Real.sqrt (qC B.h ξ) *
          NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2)) k ξ
        ≤ Real.sqrt (qC B.h ξ) * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) *
          NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1)) i ξ *
          NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ u2)) (k - i) ξ :=
          mul_le_mul_of_nonneg_left hl hs0.le
      _ = ∑ i ∈ Finset.range (k + 1), Real.sqrt (qC B.h ξ) * ((k.choose i : ℝ) *
          NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1)) i ξ *
          NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ u2)) (k - i) ξ) := by rw [Finset.mul_sum]
      _ ≤ ∑ i ∈ Finset.range (k + 1),
          (k.choose i : ℝ) * (Kf i * (|drx B.h| * ‖vrv‖)) * Ef i * (Q * T) :=
          Finset.sum_le_sum hterm
      _ = S * (Q * T) := by rw [hS, Finset.sum_mul]
  have hfin : Real.sqrt (qC B.h ξ) * NB B.h (fun η i => dR B.h (fun η' => a η' i) η) k ξ ≤
      (1 + S) * Q * T := by
    rw [hRt]
    calc Real.sqrt (qC B.h ξ) * NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ u1) +
          η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2)) k ξ
        ≤ Real.sqrt (qC B.h ξ) * (NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ u1)) k ξ +
          NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2)) k ξ) :=
          mul_le_mul_of_nonneg_left hsub hs0.le
      _ = Real.sqrt (qC B.h ξ) * NB B.h (fun η => fderiv ℝ a η (Lnorm B.h ξ u1)) k ξ +
          Real.sqrt (qC B.h ξ) *
            NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ a η (Lnorm B.h ξ u2)) k ξ :=
          mul_add _ _ _
      _ ≤ Q * T + S * (Q * T) := add_le_add hG1b hLb
      _ = (1 + S) * Q * T := by ring

  have hpow : qC B.h ξ ^ (-(1/2 + B.h * kapS)) = Q * (Real.sqrt (qC B.h ξ))⁻¹ := by
    rw [hQ, Real.sqrt_eq_rpow, ← Real.rpow_neg hq0.le, ← Real.rpow_add hq0]
    congr 1
    ring
  have hRb : NB B.h (fun η i => dR B.h (fun η' => a η' i) η) k ξ ≤
      (1 + S) * qC B.h ξ ^ (-(1/2 + B.h * kapS)) * T := by
    rw [hpow]
    have hsi : 0 ≤ (Real.sqrt (qC B.h ξ))⁻¹ := inv_nonneg.mpr hs0.le
    calc NB B.h (fun η i => dR B.h (fun η' => a η' i) η) k ξ
        = (Real.sqrt (qC B.h ξ))⁻¹ *
          (Real.sqrt (qC B.h ξ) * NB B.h (fun η i => dR B.h (fun η' => a η' i) η) k ξ) :=
          (inv_mul_cancel_left₀ hs0.ne' _).symm
      _ ≤ (Real.sqrt (qC B.h ξ))⁻¹ * ((1 + S) * Q * T) := mul_le_mul_of_nonneg_left hfin hsi
      _ = (1 + S) * (Q * (Real.sqrt (qC B.h ξ))⁻¹) * T := by ring
  rw [← hT]
  exact ⟨hTb, hRb, hZb⟩

theorem inWg5_of_nb_dom_v5 : ∀ (B : BG) (G : CorrGeom) (qs α δ : ℝ) (a F : WC), B.ok → InWg5 B G qs α a → (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → F γ m = 0) → (∀ γ m, ContDiffOn ℝ ∞ (F γ m) (DomC B.h qs)) → (∀ γ m, ∀ ξ ∈ DomC B.h qs, ∀ c, IsDeck B.h (qC B.h ξ) c → F γ m (shY ξ c) = F γ m ξ) → (∀ γ m ξ, ξ ∈ DomC B.h qs → F γ m ξ ≠ 0 → SuppW B G γ ξ) → (∀ k : ℕ, ∃ M : ℝ, ∀ γ m, ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → NB B.h (F γ m) k ξ ≤ M * qC B.h ξ ^ (B.h * δ) * ∑ i ∈ Finset.range (k + 2), NB B.h (a γ m) i ξ) → InWg5 B G qs (α + δ) F :=
by
  intro B G qs α δ a F hok ha hF1 hF2 hF3 hF4 hdom
  obtain ⟨-, -, -, -, ha5⟩ := ha
  refine ⟨hF1, hF2, hF3, hF4, fun k => ?_⟩
  choose Ca ba da hCa using ha5
  obtain ⟨M, hM⟩ := hdom k
  refine ⟨|M| * ∑ i ∈ Finset.range (k + 2), |Ca i|, ∑ i ∈ Finset.range (k + 2), |ba i|,
    ∑ i ∈ Finset.range (k + 2), |da i|, fun γ m ξ hξ hX1 hX2 => ?_⟩
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
  have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have hS1 : 1 ≤ SC B.h ξ := by
    unfold SC
    exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h ξ))])
  have hED : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) := by
    have hX0 : 0 < XC B.h ξ := lt_trans hXa hX1
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
      (Real.log_pos ((one_lt_div hX0).mpr hX2)))
  have hED1 : edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := by
    unfold edgeDist
    exact min_le_left _ _
  have hP : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
    unfold Penv5
    exact (Real.exp_pos _).le
  have hew0 : 0 ≤ Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) := Real.sqrt_nonneg _
  set q := qC B.h ξ with hq
  set S := SC B.h ξ with hS
  set ew := Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) with hew
  set ed := edgeDist B.Xa B.Xb (XC B.h ξ) with hed
  set P := Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) with hPdef
  set R := Finset.range (k + 2) with hR
  set b' := ∑ i ∈ R, |ba i| with hb'
  set d' := ∑ i ∈ R, |da i| with hd'
  have hqa : 0 ≤ q ^ (B.h * α) := Real.rpow_nonneg hq0.le _
  have hqd : 0 ≤ q ^ (B.h * δ) := Real.rpow_nonneg hq0.le _
  have hSb' : 0 ≤ S ^ b' := Real.rpow_nonneg (by linarith) _
  have hedd' : 0 ≤ ed ^ (-d') := Real.rpow_nonneg hED.le _
  set W := q ^ (B.h * α) * S ^ b' * ew * ed ^ (-d') * P with hW
  have hW0 : 0 ≤ W :=
    mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hqa hSb') hew0) hedd') hP
  have hord : ∀ i ∈ R, NB B.h (a γ m) i ξ ≤ |Ca i| * W := by
    intro i hi
    have hb : ba i ≤ b' := le_trans (le_abs_self _)
      (Finset.single_le_sum (f := fun j => |ba j|) (fun j _ => abs_nonneg _) hi)
    have hd : da i ≤ d' := le_trans (le_abs_self _)
      (Finset.single_le_sum (f := fun j => |da j|) (fun j _ => abs_nonneg _) hi)
    have h1 : S ^ ba i ≤ S ^ b' := Real.rpow_le_rpow_of_exponent_le hS1 hb
    have h2 : ed ^ (-da i) ≤ ed ^ (-d') :=
      Real.rpow_le_rpow_of_exponent_ge hED hED1 (by linarith)
    have hSb : 0 ≤ S ^ ba i := Real.rpow_nonneg (by linarith) _
    have hedd : 0 ≤ ed ^ (-da i) := Real.rpow_nonneg hED.le _
    have h6 : Ca i * q ^ (B.h * α) ≤ |Ca i| * q ^ (B.h * α) :=
      mul_le_mul_of_nonneg_right (le_abs_self _) hqa
    have h5 : Ca i * q ^ (B.h * α) * S ^ ba i ≤ |Ca i| * q ^ (B.h * α) * S ^ b' :=
      mul_le_mul h6 h1 hSb (mul_nonneg (abs_nonneg _) hqa)
    have h4 : Ca i * q ^ (B.h * α) * S ^ ba i * ew ≤ |Ca i| * q ^ (B.h * α) * S ^ b' * ew :=
      mul_le_mul_of_nonneg_right h5 hew0
    have h3 : Ca i * q ^ (B.h * α) * S ^ ba i * ew * ed ^ (-da i) ≤
        |Ca i| * q ^ (B.h * α) * S ^ b' * ew * ed ^ (-d') :=
      mul_le_mul h4 h2 hedd (mul_nonneg (mul_nonneg (mul_nonneg (abs_nonneg _) hqa) hSb') hew0)
    have h7 : Ca i * q ^ (B.h * α) * S ^ ba i * ew * ed ^ (-da i) * P ≤
        |Ca i| * q ^ (B.h * α) * S ^ b' * ew * ed ^ (-d') * P :=
      mul_le_mul_of_nonneg_right h3 hP
    refine le_trans (hCa i γ m ξ hξ hX1 hX2) (le_trans h7 (le_of_eq ?_))
    rw [hW]
    ring
  have hsum : ∑ i ∈ R, NB B.h (a γ m) i ξ ≤ (∑ i ∈ R, |Ca i|) * W := by
    rw [Finset.sum_mul]
    exact Finset.sum_le_sum hord
  have hsum0 : 0 ≤ ∑ i ∈ R, NB B.h (a γ m) i ξ :=
    Finset.sum_nonneg (fun i _ => norm_nonneg _)
  have hFb := hM γ m ξ hξ hX1 hX2
  have hrp : q ^ (B.h * (α + δ)) = q ^ (B.h * α) * q ^ (B.h * δ) := by
    rw [mul_add, Real.rpow_add hq0]
  calc NB B.h (F γ m) k ξ ≤ M * q ^ (B.h * δ) * ∑ i ∈ R, NB B.h (a γ m) i ξ := hFb
    _ ≤ |M| * q ^ (B.h * δ) * ∑ i ∈ R, NB B.h (a γ m) i ξ :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_abs_self _) hqd) hsum0
    _ ≤ |M| * q ^ (B.h * δ) * ((∑ i ∈ R, |Ca i|) * W) :=
        mul_le_mul_of_nonneg_left hsum (mul_nonneg (abs_nonneg _) hqd)
    _ = |M| * (∑ i ∈ R, |Ca i|) * q ^ (B.h * (α + δ)) * S ^ b' * ew * ed ^ (-d') * P := by
        rw [hrp, hW]
        ring

theorem bg_chart_nb_v5 : ∀ (B : BG) (G : ℝ × ℝ × ℝ → ℝ), B.ok → ContDiffOn ℝ ∞ G (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1)) → (∀ m : ℕ, ∃ C : ℝ, ∀ q X η : ℝ, 0 < q → q < B.qB → B.Xa ≤ X → X ≤ B.Xb → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m G (Real.log q, X, η)‖ ≤ C) → ContDiffOn ℝ ∞ (fun η : Cyl => G (Real.log (qC B.h η), XC B.h η, etaC B.h η)) (DomC B.h B.qB) ∧ ∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h B.qB, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → NB B.h (fun η : Cyl => G (Real.log (qC B.h η), XC B.h η, etaC B.h η)) k ξ ≤ C :=
by
  intro B G hB hG hGB
  have hS : SimScaleProps B.h := hB.1
  have hqpos : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hqC' : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) (DomC B.h B.qB) :=
    hqC'.mono (fun η hη => hη.2.1)
  have hDo : IsOpen (DomC B.h B.qB) := by
    have hT : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
    have h1 : IsOpen ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Set.Iio B.qB) :=
      hqC'.continuousOn.isOpen_inter_preimage hT isOpen_Iio
    have h2 : IsOpen {η : Cyl | 0 < η.1} := isOpen_lt continuous_const continuous_fst
    have e : DomC B.h B.qB = {η : Cyl | 0 < η.1} ∩
        ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Set.Iio B.qB) := by
      ext η
      exact ⟨fun h => ⟨h.1, h.2.1, h.2.2⟩, fun h => ⟨h.1, h.2.1, h.2.2⟩⟩
    rw [e]; exact h2.inter h1
  have hne : ∀ η ∈ DomC B.h B.qB, qC B.h η ≠ 0 := fun η hη => (hqpos η hη.2.1).ne'
  have hφ1 : ContDiffOn ℝ ∞ (fun η : Cyl => Real.log (qC B.h η)) (DomC B.h B.qB) := hqC.log hne
  have hφ2 : ContDiffOn ℝ ∞ (XC B.h) (DomC B.h B.qB) := by
    have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ 2) (DomC B.h B.qB) :=
      (contDiff_fst.pow 2).contDiffOn
    have h2 : ContDiffOn ℝ ∞ (fun η : Cyl => 2 * qC B.h η) (DomC B.h B.qB) :=
      contDiffOn_const.mul hqC
    exact (h1.div h2 (fun η hη => mul_ne_zero two_ne_zero (hne η hη))).congr (fun η _ => rfl)
  have hφ3 : ContDiffOn ℝ ∞ (etaC B.h) (DomC B.h B.qB) := by
    have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => η.2.1) (DomC B.h B.qB) := contDiff_snd.fst.contDiffOn
    exact (h1.mul (hqC.rpow_const_of_ne (p := -(1/2 - B.h)) hne)).congr (fun η _ => rfl)
  have hWo : IsOpen (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) :=
    isOpen_Iio.prod (isOpen_Ioi.prod isOpen_Ioo)
  have hmaps : ∀ η ∈ DomC B.h B.qB, (Real.log (qC B.h η), XC B.h η, etaC B.h η) ∈
      Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) := by
    intro η hη
    have hqη := hqpos η hη.2.1
    have hs : 0 < qC B.h η ^ (1/2 - B.h) := Real.rpow_pos_of_pos hqη _
    have hs2 : (qC B.h η ^ (1/2 - B.h)) ^ 2 = qC B.h η ^ (1 - 2 * B.h) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hqη.le]; congr 1; push_cast; ring
    have hz : η.2.1 ^ 2 < (qC B.h η ^ (1/2 - B.h)) ^ 2 := by
      rw [hs2]; exact (hS.2.1 η.2.1 (1 - η.2.2.1) (by linarith [hη.2.1])).2
    have habs := abs_lt.mp (abs_lt_of_sq_lt_sq hz hs.le)
    have he : etaC B.h η = η.2.1 / qC B.h η ^ (1/2 - B.h) := by
      unfold etaC; rw [Real.rpow_neg hqη.le]; exact (div_eq_mul_inv _ _).symm
    refine Set.mk_mem_prod (Set.mem_Iio.mpr (Real.log_lt_log hqη hη.2.2))
      (Set.mk_mem_prod (Set.mem_Ioi.mpr ?_) (Set.mem_Ioo.mpr ⟨?_, ?_⟩))
    · exact div_pos (pow_pos hη.1 2) (mul_pos two_pos hqη)
    · rw [he, lt_div_iff₀ hs]; linarith
    · rw [he, div_lt_iff₀ hs]; linarith
  refine ⟨hG.comp (hφ1.prodMk (hφ2.prodMk hφ3)) hmaps, ?_⟩
  choose C3 hC3 using hGB
  have h4 : ∀ i : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h B.qB, 1 ≤ i →
      NB B.h (fun η : Cyl => Real.log (qC B.h η)) i ξ ≤ C := by
    intro i
    rcases Nat.eq_zero_or_pos i with hi | hi
    · exact ⟨0, fun ξ _ h => absurd h (by omega)⟩
    · obtain ⟨C, hC⟩ := logqC_nb_v5 B hB i hi
      exact ⟨C, fun ξ hξ _ => hC ξ hξ⟩
  choose C4 hC4 using h4
  choose C5 hC5 using xc_etac_nb_v5 B hB
  intro k
  have hsum : ∀ (g : ℕ → ℝ) (j : ℕ), j ≤ k → |g j| ≤ ∑ i ∈ Finset.range (k + 1), |g i| :=
    fun g j hj => Finset.single_le_sum (f := fun i => |g i|) (fun i _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  have hs0 : ∀ g : ℕ → ℝ, 0 ≤ ∑ i ∈ Finset.range (k + 1), |g i| :=
    fun g => Finset.sum_nonneg (fun i _ => abs_nonneg _)
  obtain ⟨SG, hSG⟩ : ∃ A : ℝ, A = ∑ i ∈ Finset.range (k + 1), |C3 i| := ⟨_, rfl⟩
  obtain ⟨D, hD⟩ : ∃ A : ℝ, A = 1 + ∑ i ∈ Finset.range (k + 1), |C4 i| +
      ∑ i ∈ Finset.range (k + 1), |C5 i| := ⟨_, rfl⟩
  have hD1 : 1 ≤ D := by rw [hD]; linarith [hs0 C4, hs0 C5]
  refine ⟨(k.factorial : ℝ) * SG * (3 * D) ^ k, fun ξ hξU hX1 hX2 => ?_⟩
  have hm := hmaps ξ hξU
  have hX0 : 0 < XC B.h ξ := hm.2.1
  have hX2' : XC B.h ξ < 2 * B.Xb := by linarith
  have hGb : ∀ i : ℕ, i ≤ k →
      ‖iteratedFDeriv ℝ i G (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ)‖ ≤ SG := by
    intro i hi
    have h := hC3 i (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) (hqpos ξ hξU.2.1) hξU.2.2 hX1.le hX2.le
      hm.2.2.1 hm.2.2.2
    exact h.trans ((le_abs_self _).trans (by rw [hSG]; exact hsum C3 i hi))
  exact nb_comp3_v5 B.h (DomC B.h B.qB) _ ξ G (fun η => Real.log (qC B.h η)) (XC B.h) (etaC B.h)
    k SG D hDo hWo hξU hG hφ1 hφ2 hφ3 hmaps hD1 hGb
    (fun j hj1 hjk => ⟨(hC4 j ξ hξU hj1).trans ((le_abs_self _).trans
        (by rw [hD]; linarith [hsum C4 j hjk, hs0 C5])),
      ((hC5 j ξ hξU hX2').1).trans ((le_abs_self _).trans
        (by rw [hD]; linarith [hsum C5 j hjk, hs0 C4])),
      ((hC5 j ξ hξU hX2').2).trans ((le_abs_self _).trans
        (by rw [hD]; linarith [hsum C5 j hjk, hs0 C4]))⟩)

theorem qpow_profile_nb_v4 : ∀ (B : BG) (qs : ℝ), B.ok → SimNorm B.h → 0 < qs → qs ≤ 1 →
    ∀ (φ : ℝ → ℝ) (c : ℝ), ContDiffOn ℝ ∞ φ (Set.Ioi 0) →
    ContDiffOn ℝ ∞ (fun η => qC B.h η ^ c * φ (XC B.h η)) (DomC B.h qs) ∧
    ∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      NB B.h (fun η => qC B.h η ^ c * φ (XC B.h η)) k ξ ≤ C * qC B.h ξ ^ c :=
by
  intro B qs hok hSN hqs0 hqs1 φ c hφ
  have hS : SimScaleProps B.h := hok.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1

  have key : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (F : E → G) (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  have hU : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
  have hqCU : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqposU : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hDsub : DomC B.h qs ⊆ {η : Cyl | η.2.2.1 < 1} := fun η hη => hη.2.1
  have hDo : IsOpen (DomC B.h qs) := by
    have h1 : IsOpen ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Set.Iio qs) :=
      hqCU.continuousOn.isOpen_inter_preimage hU isOpen_Iio
    have h2 : IsOpen {η : Cyl | 0 < η.1} := isOpen_lt continuous_const continuous_fst
    have e : DomC B.h qs =
        {η : Cyl | 0 < η.1} ∩ ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Set.Iio qs) := by
      ext η
      simp only [DomC, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iio]
    rw [e]; exact h2.inter h1
  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) (DomC B.h qs) := hqCU.mono hDsub
  have hqpos : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ := fun ξ hξ => hqposU ξ (hDsub hξ)

  have hmul : ∀ (U : Set Cyl) (f g : Cyl → ℝ), IsOpen U → ContDiffOn ℝ ∞ f U →
      ContDiffOn ℝ ∞ g U → ∀ ξ ∈ U, ∀ k : ℕ,
        NB B.h (fun η => f η * g η) k ξ ≤
          ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB B.h f i ξ * NB B.h g (k - i) ξ := by
    intro U f g hU' hf hg ξ hξ k
    have hfg : ContDiffOn ℝ ∞ (fun η => f η * g η) U := hf.mul hg
    have kf := key f U ξ (Lnorm B.h ξ) hU' hf hξ
    have kg := key g U ξ (Lnorm B.h ξ) hU' hg hξ
    have kfg := key (fun η => f η * g η) U ξ (Lnorm B.h ξ) hU' hfg hξ k
    unfold NB
    obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = (fun v => ξ + Lnorm B.h ξ v) ⁻¹' U := ⟨_, rfl⟩
    have hO : IsOpen O := by
      rw [hOdef]; exact hU'.preimage (continuous_const.add (Lnorm B.h ξ).continuous)
    have h0O : (0 : Cyl) ∈ O := by
      rw [hOdef]; show ξ + Lnorm B.h ξ 0 ∈ U; rw [map_zero, add_zero]; exact hξ
    have hsmO : ∀ F : Cyl → ℝ, ContDiffOn ℝ ∞ F U →
        ContDiffOn ℝ ∞ (fun z => F (ξ + Lnorm B.h ξ z)) O := by
      intro F hF
      exact hF.comp (contDiff_const.add (Lnorm B.h ξ).contDiff).contDiffOn
        (fun z hz => by rw [hOdef] at hz; exact hz)
    have leib := norm_iteratedFDerivWithin_mul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
      (n := k) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen
      (f := fun y => f (ξ + Lnorm B.h ξ y) * g (ξ + Lnorm B.h ξ y)) k hO h0O] at leib
    rw [← kfg]
    calc ‖iteratedFDeriv ℝ k (fun z => (fun η => f η * g η) (ξ + Lnorm B.h ξ z)) 0‖
        = ‖iteratedFDeriv ℝ k (fun y => f (ξ + Lnorm B.h ξ y) * g (ξ + Lnorm B.h ξ y)) 0‖ := rfl
      _ ≤ _ := leib
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i _
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + Lnorm B.h ξ z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + Lnorm B.h ξ z)) (k - i) hO h0O,
          kf i, kg (k - i)]

  have hqpow : ∀ (c : ℝ) (j : ℕ), ∃ C : ℝ, ∀ ξ ∈ DomC B.h qs,
      NB B.h (fun η => qC B.h η ^ c) j ξ ≤ C * qC B.h ξ ^ c := by
    intro c j
    have hN := hSN
    unfold SimNorm at hN
    choose C hC using hN
    obtain ⟨A, hAdef⟩ : ∃ A : ℝ,
        A = ∑ i ∈ Finset.range (j + 1), |Polynomial.eval c (descPochhammer ℝ i)| := ⟨_, rfl⟩
    obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = 1 + ∑ i ∈ Finset.range (j + 1), |C i| := ⟨_, rfl⟩
    have hD1 : 1 ≤ D := by
      have := Finset.sum_nonneg (fun k (_ : k ∈ Finset.range (j + 1)) => abs_nonneg (C k))
      rw [hDdef]; linarith
    refine ⟨(j.factorial : ℝ) * A * D ^ j, ?_⟩
    intro ξ hξD
    have hξD' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξD
    have hξ : ξ.2.2.1 < 1 := hξD'.2.1
    have hq1 : qC B.h ξ ≤ 1 := le_trans hξD'.2.2.le hqs1
    have hq0 : 0 < qC B.h ξ := hqposU ξ hξ
    obtain ⟨F, hFdef⟩ : ∃ F : Cyl → ℝ, F = fun η : Cyl => qC B.h η ^ c := ⟨_, rfl⟩
    obtain ⟨a, hadef⟩ : ∃ a : ℝ, a = qC B.h ξ ^ c := ⟨_, rfl⟩
    suffices hmain : NB B.h F j ξ ≤ (j.factorial : ℝ) * A * D ^ j * a by
      rw [hFdef, hadef] at hmain; exact hmain
    have ha0 : 0 ≤ a := by rw [hadef]; exact Real.rpow_nonneg hq0.le _
    have hFU : ContDiffOn ℝ ∞ F {η : Cyl | η.2.2.1 < 1} := by
      rw [hFdef]
      exact hqCU.rpow_const_of_ne (fun η hη => (hqposU η hη).ne')
    obtain ⟨Pm, hPmdef⟩ : ∃ Pm : Cyl →L[ℝ] ℝ × ℝ,
        Pm = ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))).prod
          (-((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
            (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))))) := ⟨_, rfl⟩
    have hPapp : ∀ η : Cyl, Pm η = (η.2.1, -η.2.2.1) := by
      intro η; rw [hPmdef]; simp
    have hP1 : ‖Pm‖ ≤ 1 := by
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
      rw [hPapp η, one_mul, Prod.norm_def (η.2.1, -η.2.2.1)]
      refine max_le ?_ ?_
      · exact (norm_fst_le η.2).trans (norm_snd_le η)
      · exact (norm_neg η.2.2.1).trans_le
          (((norm_fst_le η.2.2).trans (norm_snd_le η.2)).trans (norm_snd_le η))
    obtain ⟨Mq, hMqdef⟩ : ∃ Mq : ℝ × ℝ →L[ℝ] ℝ × ℝ,
        Mq = (qC B.h ξ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
          (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ) := ⟨_, rfl⟩
    obtain ⟨T, hTdef⟩ : ∃ T : Cyl →L[ℝ] ℝ × ℝ, T = Mq.comp Pm := ⟨_, rfl⟩
    obtain ⟨w0, hw0def⟩ : ∃ w0 : ℝ × ℝ, w0 = (ξ.2.1, 1 - ξ.2.2.1) := ⟨_, rfl⟩
    have hW : IsOpen (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
    have hw0 : w0 ∈ (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := by
      rw [hw0def]; exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hid : ∀ v : Cyl, qC B.h (ξ + Lnorm B.h ξ v) = simScale B.h (w0 + T v).1 (w0 + T v).2 := by
      intro v
      have e1 : (Lnorm B.h ξ v).2.1 = qC B.h ξ ^ (1/2 - B.h) * v.2.1 := by
        simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have e2 : (Lnorm B.h ξ v).2.2.1 = qC B.h ξ * v.2.2.1 := by
        simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have e3 : T v = (qC B.h ξ ^ (1/2 - B.h) * v.2.1, qC B.h ξ * (-v.2.2.1)) := by
        rw [hTdef, ContinuousLinearMap.comp_apply, hPapp v, hMqdef]
        simp [ContinuousLinearMap.coe_prodMap']
      rw [e3, hw0def]
      show simScale B.h (ξ.2.1 + (Lnorm B.h ξ v).2.1) (1 - (ξ.2.2.1 + (Lnorm B.h ξ v).2.2.1)) =
        simScale B.h (ξ.2.1 + qC B.h ξ ^ (1/2 - B.h) * v.2.1) ((1 - ξ.2.2.1) + qC B.h ξ * (-v.2.2.1))
      rw [e1, e2]
      congr 1
      ring
    obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = {v : Cyl | (ξ + Lnorm B.h ξ v).2.2.1 < 1} := ⟨_, rfl⟩
    have hOmem : ∀ v, v ∈ O ↔ (ξ + Lnorm B.h ξ v).2.2.1 < 1 := by
      intro v; rw [hOdef]; rfl
    have hcontO : Continuous (fun v : Cyl => (ξ + Lnorm B.h ξ v).2.2.1) :=
      ((continuous_const.add (Lnorm B.h ξ).continuous).snd.snd.fst)
    have hO : IsOpen O := by rw [hOdef]; exact isOpen_lt hcontO continuous_const
    have h0O : (0 : Cyl) ∈ O := by
      rw [hOmem, map_zero, add_zero]; exact hξ
    obtain ⟨ψ, hψdef⟩ : ∃ ψ : Cyl → ℝ, ψ = fun v => qC B.h (ξ + Lnorm B.h ξ v) / qC B.h ξ :=
      ⟨_, rfl⟩
    have hψ : ContDiffOn ℝ ∞ ψ O := by
      rw [hψdef]
      exact (hqCU.comp (contDiff_const.add (Lnorm B.h ξ).contDiff).contDiffOn
        (fun v hv => (hOmem v).1 hv)).div_const _
    have hψpos : ∀ v ∈ O, 0 < ψ v := by
      intro v hv; rw [hψdef]; exact div_pos (hqposU _ ((hOmem v).1 hv)) hq0
    have hψ0 : ψ 0 = 1 := by
      rw [hψdef]
      show qC B.h (ξ + Lnorm B.h ξ 0) / qC B.h ξ = 1
      rw [map_zero, add_zero]; exact div_self hq0.ne'
    have hψeq : ψ = (qC B.h ξ)⁻¹ • (fun z : Cyl => simScale B.h (w0 + T z).1 (w0 + T z).2) := by
      rw [hψdef]; funext v
      show qC B.h (ξ + Lnorm B.h ξ v) / qC B.h ξ =
        (qC B.h ξ)⁻¹ * simScale B.h (w0 + T v).1 (w0 + T v).2
      rw [hid v, div_eq_inv_mul]
    have hΦ : ContDiffAt ℝ ∞ (fun z : Cyl => simScale B.h (w0 + T z).1 (w0 + T z).2) 0 := by
      have h1 : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (w0 + T 0) := by
        rw [map_zero, add_zero]; exact hS.2.2.2.1.contDiffAt (hW.mem_nhds hw0)
      exact ContDiffAt.comp (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2) (f := fun z : Cyl => w0 + T z)
        (0 : Cyl) h1 (contDiff_const.add T.contDiff).contDiffAt
    have hDψ : ∀ i : ℕ, 1 ≤ i → i ≤ j → ‖iteratedFDerivWithin ℝ i ψ O 0‖ ≤ D ^ i := by
      intro i hi1 hij
      have hcomp : (iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq.comp Pm) =
          ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
            (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm) := by
        ext m; rfl
      have hCi : ‖(iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)‖ ≤ C i * qC B.h ξ := by
        rw [hMqdef, hw0def]; exact hC i ξ.2.1 (1 - ξ.2.2.1) (by linarith) hq1
      have hprod : ∏ k : Fin i, ‖Pm‖ ≤ 1 := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        exact pow_le_one₀ (norm_nonneg _) hP1
      have hb1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
        ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)) (fun _ : Fin i => Pm)
      have hb2 := hb1.trans ((mul_le_of_le_one_right (norm_nonneg _) hprod).trans hCi)
      have hCiD : C i ≤ D := by
        have h2 : |C i| ≤ ∑ k ∈ Finset.range (j + 1), |C k| :=
          Finset.single_le_sum (f := fun k => |C k|) (fun k _ => abs_nonneg _)
            (Finset.mem_range.mpr (Nat.lt_succ_of_le hij))
        have h3 := le_abs_self (C i)
        rw [hDdef]; linarith
      rw [iteratedFDerivWithin_of_isOpen i hO h0O, hψeq,
        iteratedFDeriv_const_smul_apply (hΦ.of_le (by exact_mod_cast le_top)),
        key (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) w0 T hW hS.2.2.2.1 hw0 i,
        norm_smul, hTdef, hcomp, Real.norm_of_nonneg (inv_nonneg.mpr hq0.le)]
      calc (qC B.h ξ)⁻¹ * ‖((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
            (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm)‖
          ≤ (qC B.h ξ)⁻¹ * (C i * qC B.h ξ) :=
            mul_le_mul_of_nonneg_left hb2 (inv_nonneg.mpr hq0.le)
        _ = C i := by rw [mul_comm (C i), ← mul_assoc, inv_mul_cancel₀ hq0.ne', one_mul]
        _ ≤ D := hCiD
        _ ≤ D ^ i := le_self_pow₀ hD1 (by omega)
    have hg : ContDiffOn ℝ ∞ (fun x : ℝ => x ^ c) (Set.Ioi 0) :=
      (contDiffOn_id (s := Set.Ioi (0:ℝ))).rpow_const_of_ne (fun x hx => ne_of_gt hx)
    have hψmaps : Set.MapsTo ψ O (Set.Ioi 0) := fun v hv => hψpos v hv
    have hCg : ∀ i ≤ j, ‖iteratedFDerivWithin ℝ i (fun x : ℝ => x ^ c) (Set.Ioi 0) (ψ 0)‖ ≤ A := by
      intro i hi
      rw [hψ0, iteratedFDerivWithin_of_isOpen i isOpen_Ioi (Set.mem_Ioi.mpr (zero_lt_one' ℝ)),
        norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
        Real.iter_deriv_rpow_const, Real.one_rpow, mul_one, Real.norm_eq_abs, hAdef]
      exact Finset.single_le_sum (f := fun i => |Polynomial.eval c (descPochhammer ℝ i)|)
        (fun i _ => abs_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    have hFdB := norm_iteratedFDerivWithin_comp_le hg hψ (by exact_mod_cast le_top)
      isOpen_Ioi.uniqueDiffOn hO.uniqueDiffOn hψmaps h0O (C := A) (D := D) hCg hDψ
    obtain ⟨gl, hgldef⟩ : ∃ gl : ℝ →L[ℝ] ℝ, gl = a • ContinuousLinearMap.id ℝ ℝ := ⟨_, rfl⟩
    have hgl : ‖gl‖ ≤ a := ContinuousLinearMap.opNorm_le_bound _ ha0 (fun x => le_of_eq (by
      rw [hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, norm_smul,
        Real.norm_of_nonneg ha0]))
    have hEq : Set.EqOn (fun z => F (ξ + Lnorm B.h ξ z)) (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O := by
      intro z hz
      have hψz := hψpos z hz
      have e : qC B.h (ξ + Lnorm B.h ξ z) = qC B.h ξ * ψ z := by
        rw [hψdef]
        show _ = qC B.h ξ * (qC B.h (ξ + Lnorm B.h ξ z) / qC B.h ξ)
        field_simp
      show F (ξ + Lnorm B.h ξ z) = gl (ψ z ^ c)
      rw [hFdef, hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, smul_eq_mul]
      show qC B.h (ξ + Lnorm B.h ξ z) ^ c = a * ψ z ^ c
      rw [e, Real.mul_rpow hq0.le hψz.le, ← hadef]
    have hgψ : ContDiffOn ℝ ∞ ((fun x : ℝ => x ^ c) ∘ ψ) O := hg.comp hψ hψmaps
    have hNB : NB B.h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := by
      unfold NB
      rw [key F {η : Cyl | η.2.2.1 < 1} ξ (Lnorm B.h ξ) hU hFU hξ j]
    calc NB B.h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := hNB
      _ = ‖iteratedFDerivWithin ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) O 0‖ := by
          rw [iteratedFDerivWithin_of_isOpen j hO h0O]
      _ = ‖iteratedFDerivWithin ℝ j (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O 0‖ := by
          rw [iteratedFDerivWithin_congr hEq h0O j]
      _ = ‖gl.compContinuousMultilinearMap
            (iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0)‖ := by
          rw [ContinuousLinearMap.iteratedFDerivWithin_comp_left gl (hgψ.contDiffWithinAt h0O)
            hO.uniqueDiffOn h0O (i := j) (by exact_mod_cast le_top)]
      _ ≤ ‖gl‖ * ‖iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ a * ((j.factorial : ℝ) * A * D ^ j) := mul_le_mul hgl hFdB (norm_nonneg _) ha0
      _ = (j.factorial : ℝ) * A * D ^ j * a := by ring

  have hf0 : ContDiff ℝ ∞ (fun η : Cyl => η.1 ^ 2 / 2) := (contDiff_fst.pow 2).div_const 2
  have hqm1 : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-1:ℝ)) (DomC B.h qs) :=
    hqC.rpow_const_of_ne (fun x hx => (hqpos x hx).ne')
  have hXCdef : XC B.h = fun η => η.1 ^ 2 / 2 * qC B.h η ^ (-1:ℝ) := by
    funext η
    show η.1 ^ 2 / (2 * qC B.h η) = η.1 ^ 2 / 2 * qC B.h η ^ (-1:ℝ)
    rw [Real.rpow_neg_one]
    ring
  have hXCs : ContDiffOn ℝ ∞ (XC B.h) (DomC B.h qs) := by
    rw [hXCdef]; exact hf0.contDiffOn.mul hqm1
  have hXCpos : ∀ η ∈ DomC B.h qs, 0 < XC B.h η := by
    intro η hη
    have hη' : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < qs := hη
    exact div_pos (pow_pos hη'.1 2) (by linarith [hqpos η hη])
  have hqcs : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ c) (DomC B.h qs) :=
    hqC.rpow_const_of_ne (fun x hx => (hqpos x hx).ne')
  have hgs : ContDiffOn ℝ ∞ (fun η => φ (XC B.h η)) (DomC B.h qs) :=
    hφ.comp hXCs (fun η hη => hXCpos η hη)

  have hfsq : ∀ ξ : Cyl, 0 < qC B.h ξ → ∀ a : ℕ,
      NB B.h (fun η : Cyl => η.1 ^ 2 / 2) a ξ ≤ ξ.1 ^ 2 + qC B.h ξ := by
    intro ξ hq a
    obtain ⟨q, hqd⟩ : ∃ q : ℝ, q = qC B.h ξ := ⟨_, rfl⟩
    obtain ⟨s, hsd⟩ : ∃ s : ℝ, s = Real.sqrt q := ⟨_, rfl⟩
    have hq' : 0 < q := by rw [hqd]; exact hq
    have hs2 : s ^ 2 = q := by rw [hsd]; exact Real.sq_sqrt hq'.le
    obtain ⟨p, hpdef⟩ : ∃ p : ℝ → ℝ, p = fun x => ξ.1 ^ 2 / 2 + ξ.1 * s * x + q / 2 * (x * x) :=
      ⟨_, rfl⟩
    have hp : ContDiff ℝ ∞ p := by
      rw [hpdef]
      exact (contDiff_const.add (contDiff_const.mul contDiff_id)).add
        (contDiff_const.mul (contDiff_id.mul contDiff_id))
    have hcomp : (fun v : Cyl => (ξ + Lnorm B.h ξ v).1 ^ 2 / 2) =
        p ∘ ⇑(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) := by
      funext v
      have e1 : (Lnorm B.h ξ v).1 = s * v.1 := by
        rw [hsd, hqd]; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      rw [hpdef]
      simp only [Function.comp_apply, ContinuousLinearMap.coe_fst', Prod.fst_add, e1]
      linear_combination (v.1 ^ 2 / 2) * hs2
    have e : iteratedFDeriv ℝ a (p ∘ ⇑(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))) 0 =
        (iteratedFDeriv ℝ a (fun η : Cyl => η.1 ^ 2 / 2) ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) := by
      rw [← hcomp]
      exact key (fun η : Cyl => η.1 ^ 2 / 2) Set.univ ξ (Lnorm B.h ξ) isOpen_univ hf0.contDiffOn
        (Set.mem_univ _) a
    unfold NB
    rw [← e, ContinuousLinearMap.iteratedFDeriv_comp_right
      (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) hp (0 : Cyl) (i := a)
      (by exact_mod_cast le_top), map_zero]
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    have hprod : ∏ _i : Fin a, ‖ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))‖ ≤ 1 := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_fst_le _ _ _)
    refine (mul_le_of_le_one_right (norm_nonneg _) hprod).trans ?_
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, ← hqd]
    have hd1 : deriv p = fun x => ξ.1 * s + q * x := by
      funext x
      rw [hpdef]
      have h := (((hasDerivAt_id' x).const_mul (ξ.1 * s)).const_add (ξ.1 ^ 2 / 2)).add
        (((hasDerivAt_id' x).mul (hasDerivAt_id' x)).const_mul (q / 2))
      have h' : HasDerivAt (fun x => ξ.1 ^ 2 / 2 + ξ.1 * s * x + q / 2 * (x * x))
          (ξ.1 * s + q * x) x := by
        convert h using 1; ring
      exact h'.deriv
    have hd2 : deriv (fun x : ℝ => ξ.1 * s + q * x) = fun _ => q := by
      funext x
      have h := ((hasDerivAt_id' x).const_mul q).const_add (ξ.1 * s)
      have h' : HasDerivAt (fun x : ℝ => ξ.1 * s + q * x) q x := by
        convert h using 1; ring
      exact h'.deriv
    have hd3 : deriv (fun _ : ℝ => q) = fun _ => (0:ℝ) := by
      funext x; exact deriv_const x q
    rcases a with _ | _ | _ | n
    · rw [iteratedDeriv_zero, hpdef]
      show |ξ.1 ^ 2 / 2 + ξ.1 * s * 0 + q / 2 * (0 * 0)| ≤ ξ.1 ^ 2 + q
      rw [abs_le]; constructor <;> nlinarith [sq_nonneg ξ.1]
    · rw [iteratedDeriv_succ', iteratedDeriv_zero, hd1]
      show |ξ.1 * s + q * 0| ≤ ξ.1 ^ 2 + q
      rw [abs_le]; constructor <;> nlinarith [sq_nonneg (ξ.1 - s), sq_nonneg (ξ.1 + s), sq_nonneg ξ.1]
    · rw [iteratedDeriv_succ', iteratedDeriv_succ', iteratedDeriv_zero, hd1, hd2]
      show |q| ≤ ξ.1 ^ 2 + q
      rw [abs_of_pos hq']; nlinarith [sq_nonneg ξ.1]
    · rw [iteratedDeriv_succ', iteratedDeriv_succ', iteratedDeriv_succ', hd1, hd2, hd3,
        iteratedDeriv_const]
      simp only [ite_self, abs_zero]
      exact add_nonneg (sq_nonneg _) hq'.le

  choose Ci hCi using hqpow (-1)
  have hXCnb : ∀ i : ℕ, ∀ ξ ∈ DomC B.h qs, XC B.h ξ < B.Xb →
      NB B.h (XC B.h) i ξ ≤
        (2 * B.Xb + 1) * ∑ a ∈ Finset.range (i + 1), (i.choose a : ℝ) * |Ci (i - a)| := by
    intro i ξ hξ hX
    have hq := hqpos ξ hξ
    have hprod := hmul (DomC B.h qs) (fun η : Cyl => η.1 ^ 2 / 2)
      (fun η => qC B.h η ^ (-1:ℝ)) hDo hf0.contDiffOn hqm1 ξ hξ i
    have hr2 : ξ.1 ^ 2 + qC B.h ξ ≤ (2 * B.Xb + 1) * qC B.h ξ := by
      have h' : ξ.1 ^ 2 / (2 * qC B.h ξ) < B.Xb := hX
      rw [div_lt_iff₀ (by linarith)] at h'
      linarith
    rw [hXCdef]
    refine hprod.trans ?_
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum (fun a _ => ?_)
    have h1 := hfsq ξ hq a
    have h2 : NB B.h (fun η => qC B.h η ^ (-1:ℝ)) (i - a) ξ ≤ |Ci (i - a)| * (qC B.h ξ)⁻¹ := by
      refine (hCi (i - a) ξ hξ).trans ?_
      rw [Real.rpow_neg_one]
      exact mul_le_mul_of_nonneg_right (le_abs_self _) (inv_nonneg.mpr hq.le)
    calc (i.choose a : ℝ) * NB B.h (fun η : Cyl => η.1 ^ 2 / 2) a ξ *
          NB B.h (fun η => qC B.h η ^ (-1:ℝ)) (i - a) ξ
        ≤ (i.choose a : ℝ) * (ξ.1 ^ 2 + qC B.h ξ) * (|Ci (i - a)| * (qC B.h ξ)⁻¹) :=
          mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) h2 (norm_nonneg _)
            (mul_nonneg (Nat.cast_nonneg _) (add_nonneg (sq_nonneg _) hq.le))
      _ ≤ (i.choose a : ℝ) * ((2 * B.Xb + 1) * qC B.h ξ) * (|Ci (i - a)| * (qC B.h ξ)⁻¹) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hr2 (Nat.cast_nonneg _))
            (mul_nonneg (abs_nonneg _) (inv_nonneg.mpr hq.le))
      _ = (2 * B.Xb + 1) * ((i.choose a : ℝ) * |Ci (i - a)|) * (qC B.h ξ * (qC B.h ξ)⁻¹) := by
          ring
      _ = (2 * B.Xb + 1) * ((i.choose a : ℝ) * |Ci (i - a)|) := by
          rw [mul_inv_cancel₀ hq.ne', mul_one]
  obtain ⟨E, hEdef⟩ : ∃ E : ℕ → ℝ, E = fun i =>
      (2 * B.Xb + 1) * ∑ a ∈ Finset.range (i + 1), (i.choose a : ℝ) * |Ci (i - a)| := ⟨_, rfl⟩
  have hXCE : ∀ i : ℕ, ∀ ξ ∈ DomC B.h qs, XC B.h ξ < B.Xb → NB B.h (XC B.h) i ξ ≤ E i := by
    intro i ξ hξ hX
    rw [hEdef]
    exact hXCnb i ξ hξ hX

  have hφb : ∀ i : ℕ, ∃ M : ℝ, ∀ x ∈ Set.Icc B.Xa B.Xb,
      ‖iteratedFDerivWithin ℝ i φ (Set.Ioi 0) x‖ ≤ M := by
    intro i
    have hc := hφ.continuousOn_iteratedFDerivWithin (m := i) (by exact_mod_cast le_top)
      (uniqueDiffOn_Ioi 0)
    exact isCompact_Icc.exists_bound_of_continuousOn
      (hc.mono (fun x hx => show (0:ℝ) < x from lt_of_lt_of_le hXa hx.1))
  choose M hM using hφb

  have hchain : ∀ ξ ∈ DomC B.h qs, ∀ (m : ℕ) (A D : ℝ),
      (∀ i ≤ m, ‖iteratedFDerivWithin ℝ i φ (Set.Ioi 0) (XC B.h ξ)‖ ≤ A) →
      (∀ i : ℕ, 1 ≤ i → i ≤ m → NB B.h (XC B.h) i ξ ≤ D ^ i) →
      NB B.h (fun η => φ (XC B.h η)) m ξ ≤ (m.factorial : ℝ) * A * D ^ m := by
    intro ξ hξ m A D hA hD
    obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = (fun v => ξ + Lnorm B.h ξ v) ⁻¹' DomC B.h qs :=
      ⟨_, rfl⟩
    have hO : IsOpen O := by
      rw [hOdef]; exact hDo.preimage (continuous_const.add (Lnorm B.h ξ).continuous)
    have h0O : (0 : Cyl) ∈ O := by
      rw [hOdef]; show ξ + Lnorm B.h ξ 0 ∈ DomC B.h qs; rw [map_zero, add_zero]; exact hξ
    obtain ⟨χ, hχdef⟩ : ∃ χ : Cyl → ℝ, χ = fun v => XC B.h (ξ + Lnorm B.h ξ v) := ⟨_, rfl⟩
    have hχ : ContDiffOn ℝ ∞ χ O := by
      rw [hχdef]
      exact hXCs.comp (contDiff_const.add (Lnorm B.h ξ).contDiff).contDiffOn
        (fun v hv => by rw [hOdef] at hv; exact hv)
    have hχmaps : Set.MapsTo χ O (Set.Ioi 0) := by
      intro v hv
      rw [hOdef] at hv
      rw [hχdef]
      exact hXCpos _ hv
    have hχ0 : χ 0 = XC B.h ξ := by
      rw [hχdef]; show XC B.h (ξ + Lnorm B.h ξ 0) = _; rw [map_zero, add_zero]
    have hDχ : ∀ i : ℕ, 1 ≤ i → i ≤ m → ‖iteratedFDerivWithin ℝ i χ O 0‖ ≤ D ^ i := by
      intro i h1 h2
      rw [iteratedFDerivWithin_of_isOpen i hO h0O, hχdef,
        key (XC B.h) (DomC B.h qs) ξ (Lnorm B.h ξ) hDo hXCs hξ i]
      exact hD i h1 h2
    have hAχ : ∀ i ≤ m, ‖iteratedFDerivWithin ℝ i φ (Set.Ioi 0) (χ 0)‖ ≤ A := by
      intro i hi; rw [hχ0]; exact hA i hi
    have hFdB := norm_iteratedFDerivWithin_comp_le hφ hχ (by exact_mod_cast le_top)
      (uniqueDiffOn_Ioi 0) hO.uniqueDiffOn hχmaps h0O (C := A) (D := D) hAχ hDχ
    have hNBeq : NB B.h (fun η => φ (XC B.h η)) m ξ = ‖iteratedFDerivWithin ℝ m (φ ∘ χ) O 0‖ := by
      rw [iteratedFDerivWithin_of_isOpen m hO h0O, hχdef]
      unfold NB
      exact congrArg norm
        (key (fun η => φ (XC B.h η)) (DomC B.h qs) ξ (Lnorm B.h ξ) hDo hgs hξ m).symm
    rw [hNBeq]
    exact hFdB
  refine ⟨hqcs.mul hgs, fun k => ?_⟩
  choose Cq hCq using hqpow c
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = ∑ i ∈ Finset.range (k + 1), |M i| := ⟨_, rfl⟩
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = 1 + ∑ i ∈ Finset.range (k + 1), |E i| := ⟨_, rfl⟩
  have hD1 : 1 ≤ D := by
    have := Finset.sum_nonneg (fun i (_ : i ∈ Finset.range (k + 1)) => abs_nonneg (E i))
    rw [hDdef]; linarith
  have hMA : ∀ i ≤ k, M i ≤ A := by
    intro i hi
    have h2 : |M i| ≤ ∑ j ∈ Finset.range (k + 1), |M j| :=
      Finset.single_le_sum (f := fun j => |M j|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    rw [hAdef]; exact (le_abs_self _).trans h2
  have hED : ∀ i ≤ k, E i ≤ D := by
    intro i hi
    have h2 : |E i| ≤ ∑ j ∈ Finset.range (k + 1), |E j| :=
      Finset.single_le_sum (f := fun j => |E j|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    have h3 := le_abs_self (E i)
    rw [hDdef]; linarith
  refine ⟨∑ j ∈ Finset.range (k + 1),
    (k.choose j : ℝ) * |Cq j| * (((k - j).factorial : ℝ) * A * D ^ (k - j)), ?_⟩
  intro ξ hξ h1 h2
  have hq := hqpos ξ hξ
  have hpc : 0 ≤ qC B.h ξ ^ c := Real.rpow_nonneg hq.le _
  have hφm : ∀ m ≤ k, NB B.h (fun η => φ (XC B.h η)) m ξ ≤ (m.factorial : ℝ) * A * D ^ m := by
    intro m hm
    refine hchain ξ hξ m A D
      (fun i hi => (hM i (XC B.h ξ) ⟨h1.le, h2.le⟩).trans (hMA i (hi.trans hm)))
      (fun i hi1 hi2 => ?_)
    calc NB B.h (XC B.h) i ξ ≤ E i := hXCE i ξ hξ h2
      _ ≤ D := hED i (hi2.trans hm)
      _ ≤ D ^ i := le_self_pow₀ hD1 (by omega)
  have hprod := hmul (DomC B.h qs) (fun η => qC B.h η ^ c)
    (fun η => φ (XC B.h η)) hDo hqcs hgs ξ hξ k
  refine hprod.trans ?_
  rw [Finset.sum_mul]
  refine Finset.sum_le_sum (fun j _ => ?_)
  have e1 : NB B.h (fun η => qC B.h η ^ c) j ξ ≤ |Cq j| * qC B.h ξ ^ c :=
    (hCq j ξ hξ).trans (mul_le_mul_of_nonneg_right (le_abs_self _) hpc)
  have e2 := hφm (k - j) (Nat.sub_le k j)
  calc (k.choose j : ℝ) * NB B.h (fun η => qC B.h η ^ c) j ξ *
        NB B.h (fun η => φ (XC B.h η)) (k - j) ξ
      ≤ (k.choose j : ℝ) * (|Cq j| * qC B.h ξ ^ c) *
          (((k - j).factorial : ℝ) * A * D ^ (k - j)) :=
        mul_le_mul (mul_le_mul_of_nonneg_left e1 (Nat.cast_nonneg _)) e2 (norm_nonneg _)
          (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (abs_nonneg _) hpc))
    _ = (k.choose j : ℝ) * |Cq j| * (((k - j).factorial : ℝ) * A * D ^ (k - j)) *
          qC B.h ξ ^ c := by ring

theorem nb_mul_le_v4 : ∀ (h : ℝ) (U : Set Cyl) (f g : Cyl → ℝ), IsOpen U → ContDiffOn ℝ ∞ f U →
    ContDiffOn ℝ ∞ g U → ∀ ξ ∈ U, ∀ k : ℕ,
      NB h (fun η => f η * g η) k ξ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB h f i ξ * NB h g (k - i) ξ :=
by
  intro h U f g hU hf hg ξ hξ k
  unfold NB
  generalize Lnorm h ξ = L
  obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
  have hs : IsOpen s := by
    rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
  have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
  have h0s : (0 : Cyl) ∈ s := by
    rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
  have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
  have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
  have hsm : ∀ F : Cyl → ℝ, ContDiffOn ℝ ∞ F U → ContDiffOn ℝ ∞ (fun z => F (ξ + z)) s := by
    intro F hF
    exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
      (fun z hz => by rw [hs_def] at hz; exact hz)
  have hsmO : ∀ F : Cyl → ℝ, ContDiffOn ℝ ∞ F U →
      ContDiffOn ℝ ∞ (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
    intro F hF
    exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
  have key : ∀ F : Cyl → ℝ, ContDiffOn ℝ ∞ F U → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
        (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
    intro F hF i
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
      hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
    calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
            (fun _ => L) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
            (fun _ => L) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
            (fun _ => L) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
  have hfg : ContDiffOn ℝ ∞ (fun η => f η * g η) U := hf.mul hg
  have leib := norm_iteratedFDerivWithin_mul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
    (n := k) (by exact_mod_cast le_top)
  rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) * g (ξ + L y)) k hO h0O] at leib
  rw [← key _ hfg k]
  calc ‖iteratedFDeriv ℝ k (fun z => (fun η => f η * g η) (ξ + L z)) 0‖
      = ‖iteratedFDeriv ℝ k (fun y => f (ξ + L y) * g (ξ + L y)) 0‖ := rfl
    _ ≤ _ := leib
    _ = _ := by
      apply Finset.sum_congr rfl
      intro i _
      rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
        iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (k - i) hO h0O,
        key f hf i, key g hg (k - i)]

theorem ubase_mult_nb_v5 : ∀ (B : BG), B.ok → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → (∀ ξ ∈ DomC B.h (qsOf l0), ContDiffAt ℝ ∞ (fun η : Cyl => (((qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 0 : ℝ)) : ℂ)) ξ ∧ ContDiffAt ℝ ∞ (fun η : Cyl => (((qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 2 : ℝ)) : ℂ)) ξ) ∧ ∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → NB B.h (fun η : Cyl => (((qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 0 : ℝ)) : ℂ)) k ξ ≤ C * qC B.h ξ ^ (2 * Aex B.h) ∧ NB B.h (fun η : Cyl => (((qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 2 : ℝ)) : ℂ)) k ξ ≤ C * qC B.h ξ ^ (Aex B.h + 1/2) :=
by
  intro B hok
  have hh0 : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -, hqB0, -⟩ := hok.2.1
  have hXb : 0 < B.Xb := by linarith
  have hSN : SimNorm B.h := simscale_normalized_v4 B.h hh0 hh1 hok.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs0 : 0 < qsOf l0 := by rw [hQb]; positivity
  have hqs1 : qsOf l0 ≤ 1 := by rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  obtain ⟨hDo, -, hqpos, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hDsub : DomC B.h (qsOf l0) ⊆ DomC B.h B.qB :=
    fun ξ hξ => ⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqsB⟩

  have hrep : ∀ ξ ∈ DomC B.h B.qB,
      qC B.h ξ ^ (2 * Aex B.h + 1/2) * ubase B ξ 0 =
        qC B.h ξ ^ (2 * Aex B.h) * (2 * XC B.h ξ) ^ (-(1/2:ℝ)) *
          logLift B.Vb (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) ∧
      qC B.h ξ ^ (2 * Aex B.h + 1/2) * ubase B ξ 2 =
        qC B.h ξ ^ (Aex B.h + 1/2) * 1 *
          logLift B.Ub (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) := by
    intro ξ hξ
    obtain ⟨hr, ht, hqB⟩ := hξ
    obtain ⟨hS1, -⟩ := hok.1
    obtain ⟨-, -, -, -, -, hVel, -⟩ := hok.2
    have hτ : 0 < 1 - ξ.2.2.1 := by linarith
    have hq : 0 < qC B.h ξ := (hS1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
    have hx0 : (rotPt ξ.1 0 ξ.2.1) 0 = ξ.1 := by simp [rotPt]
    have hx1 : (rotPt ξ.1 0 ξ.2.1) 1 = 0 := by simp [rotPt]
    have hx2 : (rotPt ξ.1 0 ξ.2.1) 2 = ξ.2.1 := by simp [rotPt]
    set x := rotPt ξ.1 0 ξ.2.1 with hx
    have hsc : simScale B.h (x 2) (1 - ξ.2.2.1) = qC B.h ξ := by rw [hx2]; rfl
    have hrr : x 0 ^ 2 + x 1 ^ 2 = ξ.1 ^ 2 := by rw [hx0, hx1]; ring
    have hpos : 0 < x 0 ^ 2 + x 1 ^ 2 := by rw [hrr]; positivity
    have hsqrt : Real.sqrt (x 0 ^ 2 + x 1 ^ 2) = ξ.1 := by rw [hrr, Real.sqrt_sq hr.le]
    have hsimX : simX B.h x ξ.2.2.1 = XC B.h ξ := by
      unfold simX XC
      rw [hsc, hrr]
    have hsimEta : simEta B.h x ξ.2.2.1 = etaC B.h ξ := by
      unfold simEta etaC
      rw [hsc, hx2]
    have hmem : (x, ξ.2.2.1) ∈ simDomain B.h B.qB := by
      show ξ.2.2.1 < 1 ∧ simScale B.h (x 2) (1 - ξ.2.2.1) < B.qB
      rw [hsc]
      exact ⟨ht, hqB⟩
    obtain ⟨-, hU, hV⟩ := hVel x ξ.2.2.1 hmem hpos
    rw [hsimX, hsimEta, hsc] at hV
    rw [hsimX, hsimEta, hsc] at hU
    have hrad : rad x = ξ.1 := hsqrt
    have hb : ubase B ξ 0 = ξ.1⁻¹ * B.Vb (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) := by
      show inner ℝ (uB B x ξ.2.2.1) (frameAt 0 ξ 0) = _
      have hf : frameAt 0 ξ 0 = (rad x)⁻¹ • radVec x := rfl
      rw [hf, real_inner_smul_right, hrad]
      show ξ.1⁻¹ * inner ℝ (curl3 (fun w => B.AB w ξ.2.2.1) x + B.BvB x ξ.2.2.1) (radVec x) = _
      rw [hV]
    have hu2 : ubase B ξ 2 = qC B.h ξ ^ (-(1/2 + B.h)) * B.Ub (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) := by
      have hz : ∀ v : ℝ³, inner ℝ v eZ = v 2 := by
        intro v; simp [eZ, EuclideanSpace.inner_single_right]
      show inner ℝ (uB B x ξ.2.2.1) (frameAt 0 ξ 2) = _
      have hf : frameAt 0 ξ 2 = eZ := rfl
      rw [hf, hz]
      show (curl3 (fun w => B.AB w ξ.2.2.1) x + B.BvB x ξ.2.2.1) 2 = _
      rw [hU]
    have hl : ∀ g : ℝ → ℝ → ℝ → ℝ, logLift g (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) =
        g (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) := by
      intro g; unfold logLift; rw [Real.exp_log hq]
    have hqne : qC B.h ξ ≠ 0 := hq.ne'
    have h2X : 2 * XC B.h ξ = ξ.1 ^ 2 * (qC B.h ξ)⁻¹ := by
      unfold XC
      field_simp
    have hphi : (2 * XC B.h ξ) ^ (-(1/2:ℝ)) = ξ.1⁻¹ * qC B.h ξ ^ (1/2:ℝ) := by
      rw [h2X, Real.mul_rpow (by positivity) (by positivity), Real.inv_rpow hq.le,
        Real.rpow_neg (sq_nonneg _), Real.rpow_neg hq.le, inv_inv]
      have h12 : (ξ.1 ^ 2) ^ (1/2:ℝ) = ξ.1 := by rw [← Real.sqrt_eq_rpow, Real.sqrt_sq hr.le]
      rw [h12]
    have hA : qC B.h ξ ^ (2 * Aex B.h + 1/2) = qC B.h ξ ^ (2 * Aex B.h) * qC B.h ξ ^ (1/2:ℝ) :=
      Real.rpow_add hq _ _
    have hE : qC B.h ξ ^ (2 * Aex B.h + 1/2) * qC B.h ξ ^ (-(1/2 + B.h)) = qC B.h ξ ^ (Aex B.h + 1/2) := by
      rw [← Real.rpow_add hq]
      congr 1
      unfold Aex
      ring
    refine ⟨?_, ?_⟩
    · rw [hb, hl, hphi, hA]
      ring
    · rw [hu2, hl, ← mul_assoc, hE, mul_one]

  have hφ : ContDiffOn ℝ ∞ (fun X : ℝ => (2 * X) ^ (-(1/2:ℝ))) (Set.Ioi 0) := by
    have h2 : ContDiffOn ℝ ∞ (fun X : ℝ => 2 * X) (Set.Ioi 0) :=
      contDiffOn_const.mul contDiffOn_id
    exact h2.rpow_const_of_ne (fun X hX => (mul_pos two_pos (Set.mem_Ioi.mp hX)).ne')
  have hφ1 : ContDiffOn ℝ ∞ (fun _ : ℝ => (1:ℝ)) (Set.Ioi 0) := contDiffOn_const
  have hPR := qpow_profile_nb_v4 B (qsOf l0) hok hSN hqs0 hqs1 (fun X : ℝ => (2 * X) ^ (-(1/2:ℝ)))
    (2 * Aex B.h) hφ
  have hPZ := qpow_profile_nb_v4 B (qsOf l0) hok hSN hqs0 hqs1 (fun _ : ℝ => (1:ℝ))
    (Aex B.h + 1/2) hφ1
  obtain ⟨-, -, -, -, -, -, ⟨-, hUbS, hVbS, hbd⟩, -⟩ := hok.2
  have hVbB : ∀ m : ℕ, ∃ C : ℝ, ∀ q X η : ℝ, 0 < q → q < B.qB → B.Xa ≤ X → X ≤ B.Xb →
      -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (logLift B.Vb) (Real.log q, X, η)‖ ≤ C := by
    intro m
    obtain ⟨C, hC⟩ := hbd B.Xa B.Xb hXa m
    exact ⟨C, fun q X η h1 h2 h3 h4 h5 h6 => (hC q X η h1 h2 h3 h4 h5 h6).2.2⟩
  have hUbB : ∀ m : ℕ, ∃ C : ℝ, ∀ q X η : ℝ, 0 < q → q < B.qB → B.Xa ≤ X → X ≤ B.Xb →
      -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (logLift B.Ub) (Real.log q, X, η)‖ ≤ C := by
    intro m
    obtain ⟨C, hC⟩ := outer_profile_bounds_v5 B hok m
    exact ⟨C, fun q X η h1 h2 h3 h4 h5 h6 =>
      (hC q X η h1 h2 (by linarith) (by linarith) h5 h6).2⟩
  have hΛV := bg_chart_nb_v5 B (logLift B.Vb) hok hVbS hVbB
  have hΛU := bg_chart_nb_v5 B (logLift B.Ub) hok hUbS hUbB

  have hprod : ∀ (P L : Cyl → ℝ) (c : ℝ), ContDiffOn ℝ ∞ P (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ L (DomC B.h B.qB) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h P k ξ ≤ C * qC B.h ξ ^ c) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h B.qB, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h L k ξ ≤ C) →
      ∀ k : ℕ, ∃ K : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h (fun η => P η * L η) k ξ ≤ K * qC B.h ξ ^ c := by
    intro P L c hPs hLs hPb hLb k
    choose CP hCP using hPb
    choose CL hCL using hLb
    refine ⟨∑ j ∈ Finset.range (k + 1), (k.choose j : ℝ) * |CP j| * |CL (k - j)|,
      fun ξ hξ hX1 hX2 => ?_⟩
    have hq0 := hqpos ξ hξ
    have hQ : 0 ≤ qC B.h ξ ^ c := Real.rpow_nonneg hq0.le _
    have hLe := nb_mul_le_v4 B.h (DomC B.h (qsOf l0)) P L hDo hPs (hLs.mono hDsub) ξ hξ k
    refine le_trans hLe ?_
    rw [Finset.sum_mul]
    apply Finset.sum_le_sum
    intro j _
    have h1 : NB B.h P j ξ ≤ |CP j| * qC B.h ξ ^ c :=
      le_trans (hCP j ξ hξ hX1 hX2) (mul_le_mul_of_nonneg_right (le_abs_self _) hQ)
    have h2 : NB B.h L (k - j) ξ ≤ |CL (k - j)| :=
      le_trans (hCL (k - j) ξ (hDsub hξ) hX1 hX2) (le_abs_self _)
    have h0' : 0 ≤ NB B.h L (k - j) ξ := norm_nonneg _
    calc (k.choose j : ℝ) * NB B.h P j ξ * NB B.h L (k - j) ξ
        ≤ (k.choose j : ℝ) * (|CP j| * qC B.h ξ ^ c) * |CL (k - j)| := by
          apply mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) h2 h0'
            (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (abs_nonneg _) hQ))
      _ = (k.choose j : ℝ) * |CP j| * |CL (k - j)| * qC B.h ξ ^ c := by ring

  have hcast : ∀ (f : Cyl → ℝ) (ξ : Cyl) (k : ℕ), ContDiffAt ℝ ∞ f ξ →
      NB B.h (fun η => ((f η : ℝ) : ℂ)) k ξ ≤ NB B.h f k ξ := by
    intro f ξ k hf
    have he : (fun η => ((f η : ℝ) : ℂ)) = ⇑Complex.ofRealCLM ∘ f := by
      funext η; exact (Complex.ofRealCLM_apply (f η)).symm
    have hcomp : iteratedFDeriv ℝ k (⇑Complex.ofRealCLM ∘ f) ξ =
        Complex.ofRealCLM.compContinuousMultilinearMap (iteratedFDeriv ℝ k f ξ) :=
      ContinuousLinearMap.iteratedFDeriv_comp_left Complex.ofRealCLM hf (i := k)
        (by exact_mod_cast le_top)
    unfold NB
    rw [he, hcomp]
    refine ContinuousMultilinearMap.opNorm_le_bound (norm_nonneg _) (fun v => ?_)
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      Complex.ofRealCLM_apply, Complex.norm_real]
    have hb := ContinuousMultilinearMap.le_opNorm
      ((iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) v
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply] at hb
    exact hb
  have hcastS : ∀ (f : Cyl → ℝ) (ξ : Cyl), ContDiffAt ℝ ∞ f ξ →
      ContDiffAt ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) ξ := by
    intro f ξ hf
    have he : (fun η => ((f η : ℝ) : ℂ)) = ⇑Complex.ofRealCLM ∘ f := by
      funext η; exact (Complex.ofRealCLM_apply (f η)).symm
    rw [he]
    exact (Complex.ofRealCLM.contDiff (n := ∞)).contDiffAt.comp ξ hf

  have hmRs : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 0)
      (DomC B.h (qsOf l0)) :=
    (hPR.1.mul (hΛV.1.mono hDsub)).congr (fun η hη => (hrep η (hDsub hη)).1)
  have hmZs : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 2)
      (DomC B.h (qsOf l0)) :=
    (hPZ.1.mul (hΛU.1.mono hDsub)).congr (fun η hη => (hrep η (hDsub hη)).2)
  refine ⟨fun ξ hξ => ⟨hcastS _ ξ (hmRs.contDiffAt (hDo.mem_nhds hξ)),
    hcastS _ ξ (hmZs.contDiffAt (hDo.mem_nhds hξ))⟩, fun k => ?_⟩

  obtain ⟨KR, hKR⟩ := hprod _ _ _ hPR.1 hΛV.1 hPR.2 hΛV.2 k
  obtain ⟨KZ, hKZ⟩ := hprod _ _ _ hPZ.1 hΛU.1 hPZ.2 hΛU.2 k
  refine ⟨|KR| + |KZ|, fun ξ hξ hX1 hX2 => ⟨?_, ?_⟩⟩
  · have hq0 := hqpos ξ hξ
    have hQ : 0 ≤ qC B.h ξ ^ (2 * Aex B.h) := Real.rpow_nonneg hq0.le _
    have hgerm : (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 0) =ᶠ[nhds ξ]
        (fun η => (qC B.h η ^ (2 * Aex B.h) * (2 * XC B.h η) ^ (-(1/2:ℝ))) *
          logLift B.Vb (Real.log (qC B.h η), XC B.h η, etaC B.h η)) :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => (hrep η (hDsub hη)).1)
    have hNBeq : NB B.h (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 0) k ξ =
        NB B.h (fun η => (qC B.h η ^ (2 * Aex B.h) * (2 * XC B.h η) ^ (-(1/2:ℝ))) *
          logLift B.Vb (Real.log (qC B.h η), XC B.h η, etaC B.h η)) k ξ := by
      unfold NB
      rw [(hgerm.iteratedFDeriv ℝ k).eq_of_nhds]
    have hK : KR ≤ |KR| + |KZ| := by linarith [le_abs_self KR, abs_nonneg KZ]
    calc NB B.h (fun η : Cyl => (((qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 0 : ℝ)) : ℂ)) k ξ
        ≤ NB B.h (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 0) k ξ :=
          hcast _ ξ k (hmRs.contDiffAt (hDo.mem_nhds hξ))
      _ = NB B.h (fun η => (qC B.h η ^ (2 * Aex B.h) * (2 * XC B.h η) ^ (-(1/2:ℝ))) *
          logLift B.Vb (Real.log (qC B.h η), XC B.h η, etaC B.h η)) k ξ := hNBeq
      _ ≤ KR * qC B.h ξ ^ (2 * Aex B.h) := hKR ξ hξ hX1 hX2
      _ ≤ (|KR| + |KZ|) * qC B.h ξ ^ (2 * Aex B.h) := mul_le_mul_of_nonneg_right hK hQ
  · have hq0 := hqpos ξ hξ
    have hQ : 0 ≤ qC B.h ξ ^ (Aex B.h + 1/2) := Real.rpow_nonneg hq0.le _
    have hgerm : (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 2) =ᶠ[nhds ξ]
        (fun η => (qC B.h η ^ (Aex B.h + 1/2) * 1) *
          logLift B.Ub (Real.log (qC B.h η), XC B.h η, etaC B.h η)) :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => (hrep η (hDsub hη)).2)
    have hNBeq : NB B.h (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 2) k ξ =
        NB B.h (fun η => (qC B.h η ^ (Aex B.h + 1/2) * 1) *
          logLift B.Ub (Real.log (qC B.h η), XC B.h η, etaC B.h η)) k ξ := by
      unfold NB
      rw [(hgerm.iteratedFDeriv ℝ k).eq_of_nhds]
    have hK : KZ ≤ |KR| + |KZ| := by linarith [le_abs_self KZ, abs_nonneg KR]
    calc NB B.h (fun η : Cyl => (((qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 2 : ℝ)) : ℂ)) k ξ
        ≤ NB B.h (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 2) k ξ :=
          hcast _ ξ k (hmZs.contDiffAt (hDo.mem_nhds hξ))
      _ = NB B.h (fun η => (qC B.h η ^ (Aex B.h + 1/2) * 1) *
          logLift B.Ub (Real.log (qC B.h η), XC B.h η, etaC B.h η)) k ξ := hNBeq
      _ ≤ KZ * qC B.h ξ ^ (Aex B.h + 1/2) := hKZ ξ hξ hX1 hX2
      _ ≤ (|KR| + |KZ|) * qC B.h ξ ^ (Aex B.h + 1/2) := mul_le_mul_of_nonneg_right hK hQ

theorem tn_qpow_normalized_v5 : ∀ h : ℝ, 0 < h → h < 1/100 → SimScaleProps h → ∀ (p : ℝ) (k : ℕ), ∃ C : ℝ,
    ∀ ξ : Cyl, ξ.2.2.1 < 1 → qC h ξ ≤ 1 → NB h (fun η => qC h η ^ p) k ξ ≤ C * qC h ξ ^ p :=
by
  intro h _ _ hS

  have hN : SimNorm h := by
    obtain ⟨hS1, -, -, -, hS5⟩ := hS
    open Pointwise in
    have hom : ∀ μ z τ : ℝ, 0 < μ →
        simScale h (μ ^ (1/2 - h) * z) (μ * τ) = μ * simScale h z τ := by
      intro μ z τ hμ
      have key : ∀ p : ℝ, 0 < p → μ * p - (μ ^ (1/2 - h) * z) ^ 2 * (μ * p) ^ (2 * h) =
          μ * (p - z ^ 2 * p ^ (2 * h)) := by
        intro p hp
        have sq : (μ ^ (1/2 - h)) ^ 2 = μ ^ (1 - 2 * h) := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul hμ.le]
          congr 1
          push_cast
          ring
        have split : μ ^ (1 - 2 * h) * μ ^ (2 * h) = μ := by
          rw [← Real.rpow_add hμ]
          have e : 1 - 2 * h + 2 * h = 1 := by ring
          rw [e, Real.rpow_one]
        rw [mul_pow, sq, Real.mul_rpow hμ.le hp.le]
        linear_combination (-(z ^ 2 * p ^ (2 * h))) * split
      have hset : {q : ℝ | 0 < q ∧ μ * τ ≤ q - (μ ^ (1/2 - h) * z) ^ 2 * q ^ (2 * h)} =
          μ • {p : ℝ | 0 < p ∧ τ ≤ p - z ^ 2 * p ^ (2 * h)} := by
        ext q
        rw [Set.mem_smul_set_iff_inv_smul_mem₀ hμ.ne', smul_eq_mul]
        simp only [Set.mem_setOf_eq]
        have hq : q = μ * (μ⁻¹ * q) := by field_simp
        constructor
        · rintro ⟨hq0, hle⟩
          have hp : 0 < μ⁻¹ * q := mul_pos (inv_pos.mpr hμ) hq0
          refine ⟨hp, ?_⟩
          rw [hq, key _ hp] at hle
          exact le_of_mul_le_mul_left hle hμ
        · rintro ⟨hp, hle⟩
          refine ⟨by rw [hq]; exact mul_pos hμ hp, ?_⟩
          rw [hq, key _ hp]
          exact mul_le_mul_of_nonneg_left hle hμ.le
      unfold simScale
      rw [hset, Real.sInf_smul_of_nonneg hμ.le, smul_eq_mul]
    intro k
    obtain ⟨C, hC⟩ : ∃ C : ℝ, ∀ Z T : ℝ, 0 < T → simScale h Z T = 1 →
        ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (Z, T)‖ ≤ C := by
      rcases Nat.eq_zero_or_pos k with hk | hk
      · subst hk
        refine ⟨1, fun Z T _ h1 => ?_⟩
        rw [norm_iteratedFDeriv_zero]
        show ‖simScale h Z T‖ ≤ 1
        rw [h1, norm_one]
      · obtain ⟨C, hC⟩ := hS5 k hk
        refine ⟨C, fun Z T hT h1 => ?_⟩
        have := hC Z T hT h1.le
        rwa [h1, Real.one_rpow, mul_one] at this
    refine ⟨C, fun z τ hτ _ => ?_⟩
    obtain ⟨hQ0, -⟩ := hS1 z τ hτ
    obtain ⟨Q, hQd⟩ : ∃ Q, Q = simScale h z τ := ⟨_, rfl⟩
    rw [← hQd] at hQ0 ⊢
    obtain ⟨Z, hZ⟩ : ∃ Z : ℝ, Z = Q ^ (-(1/2 - h)) * z := ⟨_, rfl⟩
    obtain ⟨T, hT⟩ : ∃ T : ℝ, T = Q⁻¹ * τ := ⟨_, rfl⟩
    have hT0 : 0 < T := by rw [hT]; exact mul_pos (inv_pos.mpr hQ0) hτ
    have hZT : simScale h Z T = 1 := by
      have := hom Q⁻¹ z τ (inv_pos.mpr hQ0)
      rw [Real.inv_rpow hQ0.le, ← Real.rpow_neg hQ0.le, ← hQd, inv_mul_cancel₀ hQ0.ne'] at this
      rw [hZ, hT]
      exact this
    have hzb : Q ^ (1/2 - h) * Z = z := by
      rw [hZ, ← mul_assoc, ← Real.rpow_add hQ0]
      simp
    have hτb : Q * T = τ := by
      rw [hT]
      exact mul_inv_cancel_left₀ hQ0.ne' τ
    have hpa : 0 < Q ^ (1/2 - h) := Real.rpow_pos_of_pos hQ0 _
    let e₁ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 (Q ^ (1/2 - h)) hpa.ne')
    let e₂ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 Q hQ0.ne')
    let L : (ℝ × ℝ) ≃L[ℝ] (ℝ × ℝ) := e₁.prodCongr e₂
    let M : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 Q hQ0.ne')
    have hL : ∀ x : ℝ × ℝ, L x = (Q ^ (1/2 - h) * x.1, Q * x.2) := by
      intro x
      simp [L, e₁, e₂, mul_comm]
    have hM : ∀ y : ℝ, M y = Q * y := by
      intro y
      simp [M, mul_comm]
    have hfun : (fun w : ℝ × ℝ => simScale h w.1 w.2) ∘ L =
        M ∘ (fun w : ℝ × ℝ => simScale h w.1 w.2) := by
      funext w
      simp only [Function.comp, hL, hM]
      exact hom Q w.1 w.2 hQ0
    have hLclm : (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)) =
        (Q ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap (Q • ContinuousLinearMap.id ℝ ℝ) := by
      apply ContinuousLinearMap.ext
      intro x
      apply Prod.ext
      · simp [hL]
      · simp [hL]
    have hLv : L (Z, T) = (z, τ) := by
      rw [hL]
      exact Prod.ext hzb hτb
    have hcomp : iteratedFDeriv ℝ k ((fun w : ℝ × ℝ => simScale h w.1 w.2) ∘ L) (Z, T) =
        (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (L (Z, T))).compContinuousLinearMap
          (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) := by
      have := L.iteratedFDerivWithin_comp_right (fun w : ℝ × ℝ => simScale h w.1 w.2)
        uniqueDiffOn_univ (mem_univ (L (Z, T))) k
      rwa [preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at this
    have key : (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, τ)).compContinuousLinearMap
          (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) =
        (M : ℝ →L[ℝ] ℝ).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (Z, T)) := by
      rw [← hLv, ← hcomp, hfun, M.iteratedFDeriv_comp_left]
    have hMn : ‖(M : ℝ →L[ℝ] ℝ)‖ ≤ Q := by
      refine ContinuousLinearMap.opNorm_le_bound _ hQ0.le fun y => ?_
      show ‖M y‖ ≤ Q * ‖y‖
      rw [hM, norm_mul, Real.norm_eq_abs Q, abs_of_pos hQ0]
    rw [← hLclm, key]
    calc _ ≤ ‖(M : ℝ →L[ℝ] ℝ)‖ *
            ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (Z, T)‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ Q * C := mul_le_mul hMn (hC Z T hT0 hZT) (norm_nonneg _) hQ0.le
      _ = C * Q := mul_comm _ _

  intro c j
  unfold SimNorm at hN
  choose C hC using hN
  have key : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (F : E → G) (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ,
      A = ∑ i ∈ Finset.range (j + 1), |Polynomial.eval c (descPochhammer ℝ i)| := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by rw [hAdef]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = 1 + ∑ i ∈ Finset.range (j + 1), |C i| := ⟨_, rfl⟩
  have hD1 : 1 ≤ D := by
    have := Finset.sum_nonneg (fun k (_ : k ∈ Finset.range (j + 1)) => abs_nonneg (C k))
    rw [hDdef]; linarith
  refine ⟨(j.factorial : ℝ) * A * D ^ j, ?_⟩
  intro ξ hξ hq1
  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqpos : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC h η := fun η h' =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hq0 : 0 < qC h ξ := hqpos ξ hξ
  have hU : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
  obtain ⟨F, hFdef⟩ : ∃ F : Cyl → ℝ, F = fun η : Cyl => qC h η ^ c := ⟨_, rfl⟩
  obtain ⟨a, hadef⟩ : ∃ a : ℝ, a = qC h ξ ^ c := ⟨_, rfl⟩
  suffices hmain : NB h F j ξ ≤ (j.factorial : ℝ) * A * D ^ j * a by
    rw [hFdef, hadef] at hmain; exact hmain
  have ha0 : 0 ≤ a := by rw [hadef]; exact Real.rpow_nonneg hq0.le _
  have hFU : ContDiffOn ℝ ∞ F {η : Cyl | η.2.2.1 < 1} := by
    rw [hFdef]
    exact hqC.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
  obtain ⟨Pm, hPmdef⟩ : ∃ Pm : Cyl →L[ℝ] ℝ × ℝ,
      Pm = ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
        (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))).prod
        (-((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))))) := ⟨_, rfl⟩
  have hPapp : ∀ η : Cyl, Pm η = (η.2.1, -η.2.2.1) := by
    intro η; rw [hPmdef]; simp
  have hP1 : ‖Pm‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
    rw [hPapp η, one_mul, Prod.norm_def (η.2.1, -η.2.2.1)]
    refine max_le ?_ ?_
    · exact (norm_fst_le η.2).trans (norm_snd_le η)
    · exact (norm_neg η.2.2.1).trans_le
        (((norm_fst_le η.2.2).trans (norm_snd_le η.2)).trans (norm_snd_le η))
  obtain ⟨Mq, hMqdef⟩ : ∃ Mq : ℝ × ℝ →L[ℝ] ℝ × ℝ,
      Mq = (qC h ξ ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap
        (qC h ξ • ContinuousLinearMap.id ℝ ℝ) := ⟨_, rfl⟩
  obtain ⟨T, hTdef⟩ : ∃ T : Cyl →L[ℝ] ℝ × ℝ, T = Mq.comp Pm := ⟨_, rfl⟩
  obtain ⟨w0, hw0def⟩ : ∃ w0 : ℝ × ℝ, w0 = (ξ.2.1, 1 - ξ.2.2.1) := ⟨_, rfl⟩
  have hW : IsOpen (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
  have hw0 : w0 ∈ (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := by
    rw [hw0def]; exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
  have hid : ∀ v : Cyl, qC h (ξ + Lnorm h ξ v) = simScale h (w0 + T v).1 (w0 + T v).2 := by
    intro v
    have e1 : (Lnorm h ξ v).2.1 = qC h ξ ^ (1/2 - h) * v.2.1 := by
      simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e2 : (Lnorm h ξ v).2.2.1 = qC h ξ * v.2.2.1 := by
      simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e3 : T v = (qC h ξ ^ (1/2 - h) * v.2.1, qC h ξ * (-v.2.2.1)) := by
      rw [hTdef, ContinuousLinearMap.comp_apply, hPapp v, hMqdef]
      simp [ContinuousLinearMap.coe_prodMap']
    rw [e3, hw0def]
    show simScale h (ξ.2.1 + (Lnorm h ξ v).2.1) (1 - (ξ.2.2.1 + (Lnorm h ξ v).2.2.1)) =
      simScale h (ξ.2.1 + qC h ξ ^ (1/2 - h) * v.2.1) ((1 - ξ.2.2.1) + qC h ξ * (-v.2.2.1))
    rw [e1, e2]
    congr 1
    ring
  obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = {v : Cyl | (ξ + Lnorm h ξ v).2.2.1 < 1} := ⟨_, rfl⟩
  have hOmem : ∀ v, v ∈ O ↔ (ξ + Lnorm h ξ v).2.2.1 < 1 := by
    intro v; rw [hOdef]; rfl
  have hcontO : Continuous (fun v : Cyl => (ξ + Lnorm h ξ v).2.2.1) :=
    ((continuous_const.add (Lnorm h ξ).continuous).snd.snd.fst)
  have hO : IsOpen O := by rw [hOdef]; exact isOpen_lt hcontO continuous_const
  have h0O : (0 : Cyl) ∈ O := by
    rw [hOmem, map_zero, add_zero]; exact hξ
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : Cyl → ℝ, ψ = fun v => qC h (ξ + Lnorm h ξ v) / qC h ξ :=
    ⟨_, rfl⟩
  have hψ : ContDiffOn ℝ ∞ ψ O := by
    rw [hψdef]
    exact (hqC.comp (contDiff_const.add (Lnorm h ξ).contDiff).contDiffOn
      (fun v hv => (hOmem v).1 hv)).div_const _
  have hψpos : ∀ v ∈ O, 0 < ψ v := by
    intro v hv; rw [hψdef]; exact div_pos (hqpos _ ((hOmem v).1 hv)) hq0
  have hψ0 : ψ 0 = 1 := by
    rw [hψdef]
    show qC h (ξ + Lnorm h ξ 0) / qC h ξ = 1
    rw [map_zero, add_zero]; exact div_self hq0.ne'
  have hψeq : ψ = (qC h ξ)⁻¹ • (fun z : Cyl => simScale h (w0 + T z).1 (w0 + T z).2) := by
    rw [hψdef]; funext v
    show qC h (ξ + Lnorm h ξ v) / qC h ξ =
      (qC h ξ)⁻¹ * simScale h (w0 + T v).1 (w0 + T v).2
    rw [hid v, div_eq_inv_mul]
  have hΦ : ContDiffAt ℝ ∞ (fun z : Cyl => simScale h (w0 + T z).1 (w0 + T z).2) 0 := by
    have h1 : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale h w.1 w.2) (w0 + T 0) := by
      rw [map_zero, add_zero]; exact hS.2.2.2.1.contDiffAt (hW.mem_nhds hw0)
    exact ContDiffAt.comp (g := fun w : ℝ × ℝ => simScale h w.1 w.2) (f := fun z : Cyl => w0 + T z)
      (0 : Cyl) h1 (contDiff_const.add T.contDiff).contDiffAt
  have hDψ : ∀ i : ℕ, 1 ≤ i → i ≤ j → ‖iteratedFDerivWithin ℝ i ψ O 0‖ ≤ D ^ i := by
    intro i hi1 hij
    have hcomp : (iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq.comp Pm) =
        ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm) := by
      ext m; rfl
    have hCi : ‖(iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq)‖ ≤ C i * qC h ξ := by
      rw [hMqdef, hw0def]; exact hC i ξ.2.1 (1 - ξ.2.2.1) (by linarith) hq1
    have hprod : ∏ k : Fin i, ‖Pm‖ ≤ 1 := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_one₀ (norm_nonneg _) hP1
    have hb1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
      ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq)) (fun _ : Fin i => Pm)
    have hb2 := hb1.trans ((mul_le_of_le_one_right (norm_nonneg _) hprod).trans hCi)
    have hCiD : C i ≤ D := by
      have h2 : |C i| ≤ ∑ k ∈ Finset.range (j + 1), |C k| :=
        Finset.single_le_sum (f := fun k => |C k|) (fun k _ => abs_nonneg _)
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hij))
      have h3 := le_abs_self (C i)
      rw [hDdef]; linarith
    rw [iteratedFDerivWithin_of_isOpen i hO h0O, hψeq,
      iteratedFDeriv_const_smul_apply (hΦ.of_le (by exact_mod_cast le_top)),
      key (fun w : ℝ × ℝ => simScale h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) w0 T hW hS.2.2.2.1 hw0 i,
      norm_smul, hTdef, hcomp, Real.norm_of_nonneg (inv_nonneg.mpr hq0.le)]
    calc (qC h ξ)⁻¹ * ‖((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm)‖
        ≤ (qC h ξ)⁻¹ * (C i * qC h ξ) :=
          mul_le_mul_of_nonneg_left hb2 (inv_nonneg.mpr hq0.le)
      _ = C i := by rw [mul_comm (C i), ← mul_assoc, inv_mul_cancel₀ hq0.ne', one_mul]
      _ ≤ D := hCiD
      _ ≤ D ^ i := le_self_pow₀ hD1 (by omega)
  have hg : ContDiffOn ℝ ∞ (fun x : ℝ => x ^ c) (Set.Ioi 0) :=
    (contDiffOn_id (s := Set.Ioi (0:ℝ))).rpow_const_of_ne (fun x hx => ne_of_gt hx)
  have hψmaps : Set.MapsTo ψ O (Set.Ioi 0) := fun v hv => hψpos v hv
  have hCg : ∀ i ≤ j, ‖iteratedFDerivWithin ℝ i (fun x : ℝ => x ^ c) (Set.Ioi 0) (ψ 0)‖ ≤ A := by
    intro i hi
    rw [hψ0, iteratedFDerivWithin_of_isOpen i isOpen_Ioi (Set.mem_Ioi.mpr (zero_lt_one' ℝ)),
      norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
      Real.iter_deriv_rpow_const, Real.one_rpow, mul_one, Real.norm_eq_abs, hAdef]
    exact Finset.single_le_sum (f := fun i => |Polynomial.eval c (descPochhammer ℝ i)|)
      (fun i _ => abs_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  have hFdB := norm_iteratedFDerivWithin_comp_le hg hψ (by exact_mod_cast le_top)
    isOpen_Ioi.uniqueDiffOn hO.uniqueDiffOn hψmaps h0O (C := A) (D := D) hCg hDψ
  obtain ⟨gl, hgldef⟩ : ∃ gl : ℝ →L[ℝ] ℝ, gl = a • ContinuousLinearMap.id ℝ ℝ := ⟨_, rfl⟩
  have hgl : ‖gl‖ ≤ a := ContinuousLinearMap.opNorm_le_bound _ ha0 (fun x => le_of_eq (by
    rw [hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, norm_smul,
      Real.norm_of_nonneg ha0]))
  have hEq : Set.EqOn (fun z => F (ξ + Lnorm h ξ z)) (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O := by
    intro z hz
    have hψz := hψpos z hz
    have e : qC h (ξ + Lnorm h ξ z) = qC h ξ * ψ z := by
      rw [hψdef]
      show _ = qC h ξ * (qC h (ξ + Lnorm h ξ z) / qC h ξ)
      field_simp
    show F (ξ + Lnorm h ξ z) = gl (ψ z ^ c)
    rw [hFdef, hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, smul_eq_mul]
    show qC h (ξ + Lnorm h ξ z) ^ c = a * ψ z ^ c
    rw [e, Real.mul_rpow hq0.le hψz.le, ← hadef]
  have hgψ : ContDiffOn ℝ ∞ ((fun x : ℝ => x ^ c) ∘ ψ) O := hg.comp hψ hψmaps
  have hNB : NB h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm h ξ z)) 0‖ := by
    unfold NB
    rw [key F {η : Cyl | η.2.2.1 < 1} ξ (Lnorm h ξ) hU hFU hξ j]
  calc NB h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm h ξ z)) 0‖ := hNB
    _ = ‖iteratedFDerivWithin ℝ j (fun z => F (ξ + Lnorm h ξ z)) O 0‖ := by
        rw [iteratedFDerivWithin_of_isOpen j hO h0O]
    _ = ‖iteratedFDerivWithin ℝ j (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O 0‖ := by
        rw [iteratedFDerivWithin_congr hEq h0O j]
    _ = ‖gl.compContinuousMultilinearMap
          (iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0)‖ := by
        rw [ContinuousLinearMap.iteratedFDerivWithin_comp_left gl (hgψ.contDiffWithinAt h0O)
          hO.uniqueDiffOn h0O (i := j) (by exact_mod_cast le_top)]
    _ ≤ ‖gl‖ * ‖iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0‖ :=
        ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
    _ ≤ a * ((j.factorial : ℝ) * A * D ^ j) := mul_le_mul hgl hFdB (norm_nonneg _) ha0
    _ = (j.factorial : ℝ) * A * D ^ j * a := by ring

theorem qpow_cmult_nb_v5 : ∀ (B : BG), B.ok → ∀ (qs c : ℝ), 0 < qs → qs ≤ 1 → (∀ ξ ∈ DomC B.h qs, ContDiffAt ℝ ∞ (fun η : Cyl => (((qC B.h η ^ c : ℝ)) : ℂ)) ξ) ∧ ∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h qs, NB B.h (fun η : Cyl => (((qC B.h η ^ c : ℝ)) : ℂ)) k ξ ≤ C * qC B.h ξ ^ c :=
by
  intro B hok qs c _hqs0 hqs1
  have hh0 : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  have hS : SimScaleProps B.h := hok.1
  obtain ⟨hDo, hqC, hqpos, -, -, -⟩ := domc_open_calculus B qs hok
  set f : Cyl → ℝ := fun η => qC B.h η ^ c with hf
  have hfOn : ContDiffOn ℝ ∞ f (DomC B.h qs) :=
    hqC.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
  have hfAt : ∀ ξ ∈ DomC B.h qs, ContDiffAt ℝ ∞ f ξ := fun ξ hξ =>
    hfOn.contDiffAt (hDo.mem_nhds hξ)
  have hcomp : (fun η : Cyl => (((qC B.h η ^ c : ℝ)) : ℂ)) = ⇑(Complex.ofRealCLM) ∘ f := by
    funext η
    simp [hf, Complex.ofRealCLM_apply]
  have hg1 : ‖(Complex.ofRealCLM : ℝ →L[ℝ] ℂ)‖ ≤ 1 :=
    ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => by
      rw [Complex.ofRealCLM_apply, Complex.norm_real, one_mul])
  have hNB : ∀ (k : ℕ), ∀ ξ ∈ DomC B.h qs,
      NB B.h (fun η : Cyl => (((qC B.h η ^ c : ℝ)) : ℂ)) k ξ ≤ NB B.h f k ξ := by
    intro k ξ hξ
    have e1 : iteratedFDeriv ℝ k (⇑(Complex.ofRealCLM) ∘ f) ξ =
        (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).compContinuousMultilinearMap (iteratedFDeriv ℝ k f ξ) :=
      ContinuousLinearMap.iteratedFDeriv_comp_left Complex.ofRealCLM (hfAt ξ hξ)
        (i := k) (by exact_mod_cast le_top)
    rw [hcomp]
    unfold NB
    rw [e1]
    have e2 : ((Complex.ofRealCLM : ℝ →L[ℝ] ℂ).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k f ξ)).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
        (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).compContinuousMultilinearMap
          ((iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext v
      rfl
    rw [e2]
    calc _ ≤ ‖(Complex.ofRealCLM : ℝ →L[ℝ] ℂ)‖ *
          ‖(iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ _ := mul_le_of_le_one_left (norm_nonneg _) hg1
  refine ⟨fun ξ hξ => ?_, fun k => ?_⟩
  · rw [hcomp]
    exact (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).contDiff.comp_contDiffAt ξ (hfAt ξ hξ)
  · obtain ⟨C, hC⟩ := tn_qpow_normalized_v5 B.h hh0 hh1 hS c k
    refine ⟨C, fun ξ hξ => ?_⟩
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    exact (hNB k ξ hξ).trans (hC ξ hξ'.2.1 (hξ'.2.2.trans_le hqs1).le)

theorem plin5_slow_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (β : ℝ) (w : WC), InWg5 B G (qsOf l0) β w → InWg5 B G (qsOf l0) (β + 1/2 - 3 * kapS) (remSlow5 B (fun γ m η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • w γ m η)) :=
by
  intro B G hok hG
  obtain ⟨la, hla⟩ := slow_deriv_struct_v5 B G hok hG
  obtain ⟨lb, hlb⟩ := ubase_mult_nb_v5 B hok
  refine ⟨la + lb, fun l0 hl0 β w hw => ?_⟩
  have hk : kapS = 1 / 100000 := rfl
  have hk0 : 0 < kapS := by rw [hk]; norm_num
  have hA : Aex B.h = 1/2 + B.h := rfl
  have hh : 0 < B.h := hok.2.1.1
  have hhne : B.h ≠ 0 := hh.ne'
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hq1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hq0 : 0 < qsOf l0 := by
    show (0:ℝ) < (2:ℝ) ^ (-(l0:ℝ))
    exact Real.rpow_pos_of_pos (by norm_num) _
  have hcan : ∀ c : ℝ, B.h * (c / B.h) = c := fun c => by field_simp

  have hpos : ∀ z t : ℝ, t < 1 → 0 < simScale B.h z (1 - t) := fun z t ht =>
    (hok.1.1 z (1 - t) (by linarith)).1
  have key0 : ∀ (C q a a' : ℝ), 0 < q → q ≤ 1 → a' ≤ a →
      C * q ^ (B.h * a) ≤ |C| * q ^ (B.h * a') := by
    intro C q a a' hq0' hq1' haa
    calc C * q ^ (B.h * a) ≤ |C| * q ^ (B.h * a) :=
          mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0'.le _)
      _ ≤ |C| * q ^ (B.h * a') :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0' hq1'
            (mul_le_mul_of_nonneg_left haa hh.le)) (abs_nonneg C)
  have hED : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 < edgeDist B.Xa B.Xb X := by
    intro X h1 h2
    have hX0 : 0 < X := lt_trans hXa h1
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr h1))
      (Real.log_pos ((one_lt_div hX0).mpr h2)))
  have hSC : ∀ (ξ : Cyl) (b : ℝ), 0 ≤ SC B.h ξ ^ b := by
    intro ξ b
    exact Real.rpow_nonneg (by unfold SC; positivity) b
  have hW : ∀ (x : WC) (α α' : ℝ),
      α' ≤ α → InWg5 B G (qsOf l0) α x → InWg5 B G (qsOf l0) α' x := by
    intro x α α' hαα hx
    obtain ⟨c1, c2, c3, c4, c5⟩ := hx
    refine ⟨c1, c2, c3, c4, fun k => ?_⟩
    obtain ⟨C, b, d, hC⟩ := c5 k
    refine ⟨|C|, b, d, fun γ m ξ hξ hX1 hX2 => ?_⟩
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hq0' : 0 < qC B.h ξ := hpos ξ.2.1 ξ.2.2.1 hξ'.2.1
    have hq1' : qC B.h ξ ≤ 1 := le_trans hξ'.2.2.le hq1
    refine le_trans (hC γ m ξ hξ hX1 hX2) ?_
    apply mul_le_mul_of_nonneg_right _ (by unfold Penv5; exact (Real.exp_pos _).le)
    apply mul_le_mul_of_nonneg_right _ (Real.rpow_pos_of_pos (hED _ hX1 hX2) _).le
    apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
    exact mul_le_mul_of_nonneg_right (key0 C _ α α' hq0' hq1' hαα) (hSC ξ b)

  have hmul : ∀ (α βm : ℝ) (x : WC) (f : Cyl → ℝ),
      InWg5 B G (qsOf l0) α x →
      (∀ ξ ∈ DomC B.h (qsOf l0), ContDiffAt ℝ ∞ (fun η : Cyl => ((f η : ℝ) : ℂ)) ξ) →
      (∀ (ξ : Cyl) (c : ℝ × ℝ), f (shY ξ c) = f ξ) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h (fun η : Cyl => ((f η : ℝ) : ℂ)) k ξ ≤ C * qC B.h ξ ^ (B.h * βm)) →
      InWg5 B G (qsOf l0) (α + βm) (fun γ m ξ => ((f ξ : ℝ) : ℂ) • x γ m ξ) := by
    intro α βm x f hx hs hd hb
    refine inWg5_smul_mult B G l0 hok α βm x (fun _ η => ((f η : ℝ) : ℂ)) hx
      (fun γ m ξ hξ _ => hs ξ hξ) (fun γ m ξ hξ _ c _ => ?_) (fun k => ?_)
    · show ((f (shY ξ c) : ℝ) : ℂ) = ((f ξ : ℝ) : ℂ)
      rw [hd]
    · obtain ⟨C, hC⟩ := hb k
      refine ⟨C, 0, fun γ m ξ hξ _ h1 h2 => ?_⟩
      rw [Real.rpow_zero, mul_one]
      exact hC ξ hξ h1 h2

  set a : WC := fun γ m η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • w γ m η with ha_def
  obtain ⟨hAs, hAb⟩ := qpow_cmult_nb_v5 B hok (qsOf l0) (-Aex B.h) hq0 hq1
  have hcA : InWg5 B G (qsOf l0) (β + -Aex B.h / B.h) a := by
    refine hmul β _ w (fun η => qC B.h η ^ (-Aex B.h)) hw hAs (fun ξ c => rfl) (fun k => ?_)
    obtain ⟨C, hC⟩ := hAb k
    refine ⟨C, fun ξ hξ _ _ => ?_⟩
    rw [hcan]
    exact hC ξ hξ

  have hD : ∀ (e : Cyl → Cyl) (c : ℝ), ContDiffOn ℝ ∞ e {η : Cyl | 0 < η.1} →
      (∀ (ξ : Cyl) (c' : ℝ × ℝ), e (shY ξ c') = e ξ) →
      (∀ k : ℕ, ∃ M : ℝ, ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h (fun ξ i => fderiv ℝ (fun η => a γ m η i) ξ (e ξ)) k ξ ≤
          M * qC B.h ξ ^ (B.h * c) * ∑ i ∈ Finset.range (k + 2), NB B.h (a γ m) i ξ) →
      InWg5 B G (qsOf l0) (β + -Aex B.h / B.h + c)
        (fun γ m ξ i => fderiv ℝ (fun η => a γ m η i) ξ (e ξ)) := by
    intro e c he hey hb
    obtain ⟨s1, s2, s3, s4⟩ := hla l0 (by omega) _ a e hcA he hey
    obtain ⟨H, hH0, hH⟩ := s1
    refine inWg5_of_nb_dom_v5 B G (qsOf l0) _ c a _ hok hcA ⟨H, hH0, fun γ m hm => ?_⟩ s2 s3 s4 hb
    funext ξ i
    exact hH γ m hm ξ i

  have hFT := hD (fun _ => ((0:ℝ), (0:ℝ), (1:ℝ), ((0:ℝ), (0:ℝ)))) (-1 / B.h) contDiffOn_const
    (fun _ _ => rfl) (fun k => by
      obtain ⟨M, hM⟩ := slow_deriv_nb_v5 B hok k
      refine ⟨M, fun γ m ξ hξ h1 h2 => ?_⟩
      rw [hcan]
      exact (hM (qsOf l0) (a γ m) ξ hq0 hq1 (hcA.2.1 γ m) hξ h1 h2).1)
  have heR : ContDiffOn ℝ ∞ (fun ξ : Cyl => ((1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) : Cyl))
      {η : Cyl | 0 < η.1} := by
    refine contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk ?_))
    refine (contDiffOn_const.mul (contDiffOn_fst.rpow_const_of_ne ?_)).smul contDiffOn_const
    intro x hx
    exact (show (0:ℝ) < x.1 from hx).ne'
  have hFR := hD (fun ξ : Cyl => ((1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) : Cyl))
    (-(1/2 + B.h * kapS) / B.h) heR (fun _ _ => rfl) (fun k => by
      obtain ⟨M, hM⟩ := slow_deriv_nb_v5 B hok k
      refine ⟨M, fun γ m ξ hξ h1 h2 => ?_⟩
      rw [hcan]
      exact (hM (qsOf l0) (a γ m) ξ hq0 hq1 (hcA.2.1 γ m) hξ h1 h2).2.1)
  have hFZ := hD (fun _ => ((0, 1, 0, 0) : Cyl)) (-(1/2 - B.h) / B.h) contDiffOn_const
    (fun _ _ => rfl) (fun k => by
      obtain ⟨M, hM⟩ := slow_deriv_nb_v5 B hok k
      refine ⟨M, fun γ m ξ hξ h1 h2 => ?_⟩
      rw [hcan]
      exact (hM (qsOf l0) (a γ m) ξ hq0 hq1 (hcA.2.1 γ m) hξ h1 h2).2.2)

  obtain ⟨hTs, hTb⟩ := qpow_cmult_nb_v5 B hok (qsOf l0) (2 * Aex B.h + 1/2) hq0 hq1
  obtain ⟨hUs, hUb⟩ := hlb l0 (by omega)
  have hPT := hmul _ ((2 * Aex B.h + 1/2) / B.h) _ (fun η => qC B.h η ^ (2 * Aex B.h + 1/2)) hFT hTs
    (fun _ _ => rfl) (fun k => by
      obtain ⟨C, hC⟩ := hTb k
      refine ⟨C, fun ξ hξ _ _ => ?_⟩
      rw [hcan]
      exact hC ξ hξ)
  have hPR := hmul _ (2 * Aex B.h / B.h) _ (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 0) hFR
    (fun ξ hξ => (hUs ξ hξ).1) (fun _ _ => rfl) (fun k => by
      obtain ⟨C, hC⟩ := hUb k
      refine ⟨C, fun ξ hξ h1 h2 => ?_⟩
      rw [hcan]
      exact (hC ξ hξ h1 h2).1)
  have hPZ := hmul _ ((Aex B.h + 1/2) / B.h) _ (fun η => qC B.h η ^ (2 * Aex B.h + 1/2) * ubase B η 2) hFZ
    (fun ξ hξ => (hUs ξ hξ).2) (fun _ _ => rfl) (fun k => by
      obtain ⟨C, hC⟩ := hUb k
      refine ⟨C, fun ξ hξ h1 h2 => ?_⟩
      rw [hcan]
      exact (hC ξ hξ h1 h2).2)

  have eT : β + -Aex B.h / B.h + -1 / B.h + (2 * Aex B.h + 1/2) / B.h = β + 1 := by
    rw [hA]; field_simp; ring
  have eR : β + -Aex B.h / B.h + -(1/2 + B.h * kapS) / B.h + 2 * Aex B.h / B.h = β + 1 - kapS := by
    rw [hA]; field_simp; ring
  have eZ : β + -Aex B.h / B.h + -(1/2 - B.h) / B.h + (Aex B.h + 1/2) / B.h = β + 1 := by
    rw [hA]; field_simp; ring

  have h12 := (pwr5_waveV_add B G hok (qsOf l0) hq1 _ _ _ _ hPT hPR).1
  have h123 := (pwr5_waveV_add B G hok (qsOf l0) hq1 _ _ _ _ h12 hPZ).1
  have hfin := hW _ _ (β + 1/2 - 3 * kapS)
    (by refine le_min (le_min ?_ ?_) ?_ <;> linarith) h123
  convert hfin using 1
  funext γ m ξ i
  simp only [remSlow5, Pi.add_apply, Pi.smul_apply, smul_eq_mul, dTsV, dR, dZ, Complex.ofReal_mul]
  ring

theorem pres_nb_pointwise_v5 : ∀ (B : BG), B.ok → ∀ k : ℕ, ∃ K : ℝ, 0 ≤ K ∧ ∀ (qs : ℝ) (f : Cyl → ℂ) (ξ : Cyl), qs ≤ 1 → ContDiffOn ℝ ∞ f (DomC B.h qs) → ξ ∈ DomC B.h qs → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → NB B.h (fun ξ : Cyl => (((qC B.h ξ ^ (2 * Aex B.h + 1/2)) : ℝ) : ℂ) • ![dR B.h (fun η => (((qC B.h η ^ (-2 * Aex B.h)) : ℝ) : ℂ) * f η) ξ, 0, dZ (fun η => (((qC B.h η ^ (-2 * Aex B.h)) : ℝ) : ℂ) * f η) ξ]) k ξ ≤ K * qC B.h ξ ^ (-(B.h * kapS)) * ∑ i ∈ Finset.range (k + 2), NB B.h f i ξ :=
by
  intro B hok k
  have hh : 0 < B.h := hok.2.1.1
  have hS : SimScaleProps B.h := hok.1

  have nbdir : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (h : ℝ) (U : Set Cyl) (ξ : Cyl)
      (F : Cyl → V) (w : Cyl), IsOpen U → ξ ∈ U → ContDiffOn ℝ ∞ F U → ∀ k : ℕ,
      NB h (fun η => fderiv ℝ F η (Lnorm h ξ w)) k ξ ≤ ‖w‖ * NB h F (k + 1) ξ := by
    intro V _ _ h U ξ F w hU hξ hF k
    have hFd : ContDiffAt ℝ ∞ (fderiv ℝ F) ξ :=
      (hF.fderiv_of_isOpen hU (by exact_mod_cast le_top)).contDiffAt (hU.mem_nhds hξ)
    have hcomp : (fun η => fderiv ℝ F η (Lnorm h ξ w)) =
        (ContinuousLinearMap.apply ℝ V (Lnorm h ξ w)) ∘ (fderiv ℝ F) := by
      funext η; rfl
    have hit : iteratedFDeriv ℝ k (fun η => fderiv ℝ F η (Lnorm h ξ w)) ξ =
        (ContinuousLinearMap.apply ℝ V (Lnorm h ξ w)).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fderiv ℝ F) ξ) := by
      rw [hcomp]
      exact ContinuousLinearMap.iteratedFDeriv_comp_left _ hFd (by exact_mod_cast le_top)
    have hNB0 : 0 ≤ NB h F (k + 1) ξ := norm_nonneg _
    unfold NB
    rw [hit]
    apply ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg (norm_nonneg _) hNB0)
    intro m
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      ContinuousLinearMap.apply_apply]
    have key : (iteratedFDeriv ℝ k (fderiv ℝ F) ξ (fun i => Lnorm h ξ (m i))) (Lnorm h ξ w) =
        ((iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ))
          (Fin.snoc (α := fun _ => Cyl) m w) := by
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_succ_apply_right]
      have e1 : Fin.init (fun i : Fin (k+1) => Lnorm h ξ (Fin.snoc (α := fun _ => Cyl) m w i)) =
          fun i => Lnorm h ξ (m i) := by
        funext i
        simp [Fin.init, Fin.snoc_castSucc]
      rw [e1]
      simp only [Fin.snoc_last]
    rw [key]
    have hprod : ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ =
        (∏ i : Fin k, ‖m i‖) * ‖w‖ := by
      rw [Fin.prod_univ_castSucc]
      simp [Fin.snoc_castSucc, Fin.snoc_last]
    calc _ ≤ ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ *
          ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ :=
          ContinuousMultilinearMap.le_opNorm _ _
      _ = ‖w‖ * ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ *
          ∏ i : Fin k, ‖m i‖ := by rw [hprod]; ring

  have leib : ∀ (ξ : Cyl) {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (U : Set Cyl) (n : ℕ),
      IsOpen U → ξ ∈ U → ∀ (f : Cyl → ℝ) (g : Cyl → V), ContDiffOn ℝ n f U → ContDiffOn ℝ n g U →
      NB B.h (fun η => f η • g η) n ξ ≤
        ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * NB B.h f i ξ * NB B.h g (n - i) ξ := by
    intro ξ V _ _ U n hU hξ f g hf hg
    unfold NB
    generalize Lnorm B.h ξ = L
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
    have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + z)) s := by
      intro W _ _ F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
      intro W _ _ F hF
      exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
    have key' : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ∀ i : ℕ, i ≤ n →
        iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
          (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
      intro W _ _ F hF i hi
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
      calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
              (fun _ => L) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
              (fun _ => L) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
              (fun _ => L) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
    have hfg : ContDiffOn ℝ n (fun η => f η • g η) U := hf.smul hg
    have hl := norm_iteratedFDerivWithin_smul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
      (n := n) le_rfl
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) • g (ξ + L y)) n hO h0O] at hl
    rw [← key' _ hfg n le_rfl]
    calc ‖iteratedFDeriv ℝ n (fun z => (fun η => f η • g η) (ξ + L z)) 0‖
        = ‖iteratedFDeriv ℝ n (fun y => f (ξ + L y) • g (ξ + L y)) 0‖ := rfl
      _ ≤ _ := hl
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (n - i) hO h0O,
          key' f hf i hik, key' g hg (n - i) (Nat.sub_le n i)]

  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hΩg : ∀ qs : ℝ, IsOpen (DomC B.h qs) := by
    intro qs
    have h4c := hS.2.2.2.1.continuousOn
    have hm : MapsTo (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1} (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have hξ' : ξ.2.2.1 < 1 := hξ
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hcont : ContinuousOn (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1} :=
      h4c.comp (f := fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) (Continuous.continuousOn (by fun_prop)) hm
    have e : DomC B.h qs = {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩
        (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) ⁻¹' Iio qs) := by
      ext ξ
      exact Iff.rfl
    rw [e]
    exact (isOpen_lt continuous_const continuous_fst).inter
      (hcont.isOpen_inter_preimage (isOpen_lt (by fun_prop) continuous_const) isOpen_Iio)
  have hqpg : ∀ qs : ℝ, ∀ η ∈ DomC B.h qs, 0 < qC B.h η := by
    intro qs η hη
    have hη' : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < qs := hη
    exact (hS.1 η.2.1 (1 - η.2.2.1) (by linarith [hη'.2.1])).1
  have hJ : ∀ (n : ℤ) (t : ℝ), JpowL n (t • vrv) = (Lgc ^ n * t) • vrv := by
    intro n t
    have hD : (1 + bgc ^ 2) ≠ 0 := by positivity
    simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
      ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Jpow, vrv, vtv]
    refine Prod.ext ?_ ?_
    · simp only [Prod.smul_fst, Prod.smul_snd, Prod.fst_add, smul_eq_mul]
      field_simp
      ring
    · simp only [Prod.smul_fst, Prod.smul_snd, Prod.snd_add, smul_eq_mul]
      field_simp
      ring
  have hcoarse : ∀ h q : ℝ, 0 ≤ h → 0 < q → q ≤ 1 →
      Lgc ^ (coarseIdx h q) ≤ q ^ (-(drx h / 2 + h * kapS)) := by
    intro h q hh q0 hq1
    have hs2a : (1:ℝ) ≤ Real.sqrt 2 := by
      have := Real.sqrt_le_sqrt (show (1:ℝ) ≤ 2 by norm_num)
      rwa [Real.sqrt_one] at this
    have hs2b : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
    have hL1 : 1 < Lgc := by unfold Lgc; linarith
    have hT1 : 1 < Tgc := by unfold Tgc; linarith
    have hL0 : 0 < Lgc := by linarith
    have hLl : 0 < Real.log Lgc := Real.log_pos hL1
    have hTl : 0 < Real.log Tgc := Real.log_pos hT1
    have hl2 : 0 < Real.log 2 := Real.log_pos one_lt_two
    obtain ⟨x, hxdef⟩ : ∃ x : ℝ, x = Real.logb 2 (1 / q) := ⟨_, rfl⟩
    have hx0 : 0 ≤ x := by
      rw [hxdef]; exact Real.logb_nonneg one_lt_two (one_le_one_div q0 hq1)
    have hx : x * Real.log 2 = -Real.log q := by
      rw [hxdef, Real.logb, div_mul_cancel₀ _ hl2.ne', one_div, Real.log_inv]
    have hb : bandOf q = ⌈x⌉₊ := by rw [hxdef]; rfl
    have hR : 0 ≤ (1 + h) * x * Real.log 2 / Real.log Tgc :=
      div_nonneg (mul_nonneg (mul_nonneg (by linarith) hx0) hl2.le) hTl.le
    have hstar : ((coarseIdx h q : ℤ) : ℝ) ≤ (1 + h) * x * Real.log 2 / Real.log Tgc := by
      obtain ⟨l, hl⟩ : ∃ l : ℕ, l = bandOf q - 4 := ⟨_, rfl⟩
      have hc : coarseIdx h q = bandIdx h l := by rw [hl]; rfl
      rw [hc]
      unfold bandIdx
      rcases Nat.eq_zero_or_pos l with h0 | hpos
      · have e : Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l:ℝ) ^ 2)) = 0 := by
          rw [h0]; simp
        rw [e, Int.floor_zero, Int.cast_zero]
        exact hR
      · have hl1 : (1:ℝ) ≤ (l:ℝ) ^ 2 := one_le_pow₀ (by exact_mod_cast hpos)
        have hA : 0 < (2:ℝ) ^ ((1 + h) * (l:ℝ)) := Real.rpow_pos_of_pos two_pos _
        have hAl : 0 < (2:ℝ) ^ ((1 + h) * (l:ℝ)) / (l:ℝ) ^ 2 := div_pos hA (by linarith)
        have h1 := Int.floor_le (Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / (l:ℝ) ^ 2))
        have h2 := Real.logb_le_logb_of_le hT1 hAl (div_le_self hA.le hl1)
        have h3 : Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ))) =
            (1 + h) * l * Real.log 2 / Real.log Tgc := by
          rw [Real.logb_rpow_eq_mul_logb_of_pos two_pos, ← Real.log_div_log]
          ring
        have hlx : (l:ℝ) ≤ x := by
