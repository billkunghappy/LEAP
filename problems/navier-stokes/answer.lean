    · push_neg at hcase
      have hgq : g q = vst - vs q := by rw [hg, hζ2one q hcase.le]; ring
      have hvst : 0 < vst - vs q := by rw [hvstdef]; linarith
      have hsq2 : a * s q ^ 2 = ζ q ^ 2 * (vst - vs q) := by
        rw [hsq, mul_pow, Real.sq_sqrt (div_pos (hgpos q) ha).le, hgq]; field_simp
      have hz2 : ζ q ^ 2 ≤ 1 := by nlinarith [hζ01 q]
      have hvle : a * (1 + ts q ^ 2 + s q ^ 2) ≤ 2 + δL / 2 := by
        rw [hv_eq, hsq2, ← hvstdef]
        nlinarith [mul_le_mul_of_nonneg_right hz2 hvst.le]
      have hvge : 2 + δL / 8 ≤ a * (1 + ts q ^ 2 + s q ^ 2) := by
        rw [hv_eq, hsq2]
        by_cases hlow : vs q ≤ 2 + δL / 8
        · rw [hζ1 q hlow, hvstdef]; nlinarith
        · push_neg at hlow
          nlinarith [mul_nonneg (sq_nonneg (ζ q)) hvst.le]

      have hP2 : 2 + μ / 2 ≤ p1 + (ts q + s q * Dn q u) * p2 := by linarith
      have hJ : (p2 - (ts q + s q * Dn q u) * p1) ^ 2 ≤ JM ^ 2 := by
        have h1 : |p2 - (ts q + s q * Dn q u) * p1| ≤ JM := by
          rw [hJMdef]
