  have hcq : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2)) {w : ℝ × ℝ | w.2 < 1} := by
    have h4 : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
