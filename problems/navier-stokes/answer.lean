        curl3 F (rotZ5 φ x) = rotZ5 φ (curl3 G x) := by
      intro φ F G x hG hF
      obtain ⟨L, hL⟩ := hlin φ
      obtain ⟨L', hL'⟩ := hlin (-φ)
