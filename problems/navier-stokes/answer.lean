        exact (h2 j).comp hc
          (fun t ht => ⟨⟨(hmapT t ht X hX hXi').1, (hmapT t ht X hX hXi').2⟩, hw⟩)
    have hdiff : ∀ j : ℕ, ∀ X, 0 < X → X < Xi → DifferentiableOn ℂ (I j X) (cStrip (ρ j)) :=
      fun j X a b w hw => ((hlev1 j X a b w hw).2.differentiableAt).differentiableWithinAt
    have hderI : ∀ j : ℕ, ∀ X (w : ℂ), 0 < X → X < Xi → w ∈ cStrip (ρ (j + 1)) →
