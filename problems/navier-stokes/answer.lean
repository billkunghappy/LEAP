      · refine (ae_restrict_iff' measurableSet_Ioc).2 (Filter.Eventually.of_forall fun t ht => ?_)
        exact ((hda t ht w₀ hw₀).tendsto_slope_zero).comp htend
    have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le (𝕜 := ℂ)
      (μ := volume) (a := 0) (b := 1)
      (F := fun z t => g t z) (F' := fun z t => deriv (g t) z)
      (x₀ := w₀) (s := Metric.ball w₀ (ε / 2)) (bound := fun t => B t / (ε / 4))
