            (mul_nonneg hT3 (mul_nonneg hT0.le (by linarith)))
      _ = 8 * Tgc ^ 4 * SC B.h ξ * ‖w‖ := by ring

theorem ode_damp_reduce5 : ∀ (A : ℝ → Matrix (Fin 3) (Fin 3) ℝ) (d : ℝ → ℝ) (μ w L : ℝ) (x : ℝ → (Fin 3 → ℝ)), w ≤ L → 1 ≤ μ → ContinuousOn d (Set.Icc w L) → (∀ v ∈ Set.Icc w L, 0 ≤ d v) → (∀ v ∈ Set.Icc w L, HasDerivAt x ((A v - (μ * d v) • (1 : Matrix (Fin 3) (Fin 3) ℝ)).mulVec (x v)) v) → ∃ y : ℝ → (Fin 3 → ℝ), y w = x w ∧ (∀ v ∈ Set.Icc w L, HasDerivAt y ((A v).mulVec (y v) - d v • y v) v) ∧ ∀ v ∈ Set.Icc w L, ‖x v‖ ≤ ‖y v‖ :=
