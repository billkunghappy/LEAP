    have hE : ∀ p ∈ O, HasDerivAt (fun e => F p.1 e)
        (fderiv ℝ (fun p : ℝ × ℝ => F p.1 p.2) p ((0 : ℝ), (1 : ℝ))) p.2 := by
      rintro ⟨X, η⟩ hp
      have h1 : HasDerivAt (fun e : ℝ => (X, e)) ((0 : ℝ), (1 : ℝ)) η :=
        (hasDerivAt_const η X).prodMk (hasDerivAt_id η)
      exact (hfd (X, η) hp).comp_hasDerivAt η h1
    refine ⟨?_, ?_, fun p hp => (hE p hp).differentiableAt⟩
    · exact (hd.clm_apply (contDiffOn_const (c := ((1 : ℝ), (0 : ℝ))))).congr
        (fun p hp => (hX p hp).deriv)
    · exact (hd.clm_apply (contDiffOn_const (c := ((0 : ℝ), (1 : ℝ))))).congr
        (fun p hp => (hE p hp).deriv)

  have s3 : ∀ g : ℝ → ℝ → ℝ,
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => g p.1 p.2) (Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) →
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => profRadInt g p.1 p.2)
        (Ioo (-1 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1 - ρ1 / 2) (1 + ρ1 / 2)) := by
    intro g hg
    obtain ⟨lam, hlam⟩ : ∃ l : ℝ, l = 1 + ρ1 / 2 := ⟨_, rfl⟩
    have hlam0 : 0 < lam := by rw [hlam]; linarith
    obtain ⟨χ, hχ⟩ : ∃ χ : ℝ → ℝ, χ = fun x => Real.smoothTransition (2 * (23 / 5 - Λ * x)) :=
      ⟨_, rfl⟩
    have hχs : ContDiff ℝ ∞ χ := by
      rw [hχ]
      exact Real.smoothTransition.contDiff.comp
        (by fun_prop : ContDiff ℝ ∞ (fun x : ℝ => 2 * (23 / 5 - Λ * x)))
    have χ1 : ∀ x, Λ * x ≤ 41 / 10 → χ x = 1 := by
      intro x hx
      rw [hχ]
      exact Real.smoothTransition.one_of_one_le (by linarith)
    have χ0 : ∀ x, 23 / 5 ≤ Λ * x → χ x = 0 := by
      intro x hx
      rw [hχ]
      exact Real.smoothTransition.zero_of_nonpos (by linarith)
    obtain ⟨gh, hgh⟩ : ∃ gh : ℝ → ℝ → ℝ, gh = fun x e => χ x * g x (lam * e) := ⟨_, rfl⟩
    have hghs : ContDiffOn ℝ ∞ (↿gh) (Ioi (-(1 / Λ)) ×ˢ Ioo (-1) 1) := by
      rw [hgh]
      show ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => χ q.1 * g q.1 (lam * q.2)) _
      apply contDiffOn_of_locally_contDiffOn
      intro p hp
      by_cases hx : p.1 < 5 / Λ
      · refine ⟨Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1) 1, isOpen_Ioo.prod isOpen_Ioo,
          ⟨⟨?_, hx⟩, hp.2⟩, ?_⟩
        · have h0 : -(1 / Λ) < p.1 := hp.1
          rw [neg_div]; exact h0
        · have hf : ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => (q.1, lam * q.2))
              ((Ioi (-(1 / Λ)) ×ˢ Ioo (-1) 1) ∩ (Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1) 1)) := by
            fun_prop
          have hmaps : MapsTo (fun q : ℝ × ℝ => (q.1, lam * q.2))
              ((Ioi (-(1 / Λ)) ×ˢ Ioo (-1) 1) ∩ (Ioo (-1 / Λ) (5 / Λ) ×ˢ Ioo (-1) 1))
