theorem rfp_inner_moments : ∀ Md Pst lam : ℝ, 1 ≤ Md → Real.exp (rfpY2 Md - 1) < Pst → 0 < lam → lam ≤ 1 / 100 → (∀ X, 0 < X → 0 ≤ rinMom (fun x => rfpK Md (Real.log x)) X ∧ rinMom (fun x => rfpK Md (Real.log x)) X ≤ 4 * X ∧ 0 ≤ rinMom (fun x => rfpK Md (Real.log x) ^ 2) X ∧ rinMom (fun x => rfpK Md (Real.log x) ^ 2) X ≤ 16 * X ∧ 0 ≤ rinMom (fun x => rinC Md Pst lam (Real.log x) ^ 2 / 2) X) ∧ (∀ X, Real.exp 1 ≤ X → X ≤ Real.exp (rfpY2 Md) → rinMom (fun x => rinC Md Pst lam (Real.log x) ^ 2 / 2) X ≤ (Real.log X + 2) * rinC Md Pst lam (Real.log X) ^ 2 * X / 2 ∧ Pst ^ 2 / X ≤ rinC Md Pst lam (Real.log X) ^ 2) ∧ (∀ X, Real.exp (rfpY2 Md) ≤ X → X ≤ Real.exp (rfpY2 Md + 2) → rinMom (fun x => rinC Md Pst lam (Real.log x) ^ 2 / 2) X ≤ (rfpY2 Md + 3) * rinC Md Pst lam (rfpY2 Md) ^ 2 * X / 2 ∧ rinC Md Pst lam (rfpY2 Md) * Real.exp (-(51 / 50)) ≤ rinC Md Pst lam (Real.log X) ∧ rinC Md Pst lam (Real.log X) ≤ rinC Md Pst lam (rfpY2 Md)) ∧ 1 ≤ rinC Md Pst lam (rfpY2 Md) ∧ rinC Md Pst lam (rfpY2 Md) ≤ 6 / 5 * Pst :=
