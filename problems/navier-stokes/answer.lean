    · exact hMc 0.9 H 0.9 1 1 _ _ _ c19 hP.2.1 le_rfl hH9'
        (fun ξ hξ => by simp only [nrm]; rw [(hMn ξ hξ).2.1]; ring)
    · exact hMc 0.9 H 0.9 1 1 _ _ _ c20 hR.1 le_rfl hH9'
        (fun ξ _ => by simp only [nrm]; ring)
    · exact hMc 1.9 (H + 1) 1.9 1 1 _ _ _ c21 hP.2.2.1 le_rfl hH19
        (fun ξ hξ => by simp only [nrm]; rw [(hMn ξ hξ).2.2.1]; ring)

  have hmom : ∀ S1 : CState, StOrd5 B G l0 S1 bw ca ca H →
      ∃ S' : CState, StOrd5 B G l0 S' bw ca ca (H + 9/10 - 2 * kapS) := by
    intro S1 hS1
    have hS1' := hS1
    unfold StOrd5 at hS1'
    obtain ⟨hAw, hpw, hPsi, hbd, hShP, hShb, -, hEth, hEz, hyEth, hyEz, hcP, hcJ, hcJz, -, hvW, hvW0,
      hm1, hm2, hpm, hm0, -, -⟩ := hS1'
