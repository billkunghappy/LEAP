theorem pa5_norm_equiv : ∀ M : ℝ, 1 ≤ M → ∃ C : ℝ, 0 < C ∧ ∀ (F0 G0 N1 N2 Bs δ σ : ℝ) (n x : Fin 3 → ℝ), 1 / M ≤ F0 → F0 ≤ M → 0 ≤ G0 → G0 ≤ M → N1 ^ 2 + N2 ^ 2 = 1 → N1 ≤ -1 / M → 1 / M ^ 2 ≤ -(2 * F0 * N1) * (2 * F0 * N1 + G0) → 1 / M ≤ Bs → Bs ≤ M → |σ| ≤ 2 * M → 0 < δ → δ ≤ 1 / (8 * M) → (∀ i : Fin 3, |n i - Bs * ![σ, -N2, N1] i| ≤ δ) → 0 ≤ (2 * F0 * N1 + G0) * (x 0 + σ * N2 * x 1 - σ * N1 * x 2) ^ 2 + (-(2 * F0 * N1)) * (1 + σ ^ 2) * (N1 * x 1 + N2 * x 2) ^ 2 ∧ ‖x‖ ^ 2 ≤ dotProduct x x ∧ dotProduct x x ≤ C * ((2 * F0 * N1 + G0) * (x 0 + σ * N2 * x 1 - σ * N1 * x 2) ^ 2 + (-(2 * F0 * N1)) * (1 + σ ^ 2) * (N1 * x 1 + N2 * x 2) ^ 2 + (dotProduct n x) ^ 2) ∧ (2 * F0 * N1 + G0) * (x 0 + σ * N2 * x 1 - σ * N1 * x 2) ^ 2 + (-(2 * F0 * N1)) * (1 + σ ^ 2) * (N1 * x 1 + N2 * x 2) ^ 2 + (dotProduct n x) ^ 2 ≤ C * ‖x‖ ^ 2 :=
by
  intro M hM
  refine ⟨150 * M ^ 4, by positivity, ?_⟩
  intro F0 G0 N1 N2 Bs δ σ n x hF1 hF2 hG1 hG2 hN hN1 hPS hB1 hB2 hσ hδ hδ0 hn
  have hM0 : 0 < M := by linarith
  have hM2 : 1 ≤ M ^ 2 := one_le_pow₀ hM
  have hM4 : 1 ≤ M ^ 4 := one_le_pow₀ hM
  have hM34 : M ^ 3 ≤ M ^ 4 := pow_le_pow_right₀ hM (by norm_num)
  have hM24 : M ^ 2 ≤ M ^ 4 := pow_le_pow_right₀ hM (by norm_num)

  have two : ∀ u v : ℝ, (u + v) ^ 2 ≤ 2 * (u ^ 2 + v ^ 2) := fun u v => by
    nlinarith [sq_nonneg (u - v)]
  have three : ∀ u v w : ℝ, (u + v + w) ^ 2 ≤ 3 * (u ^ 2 + v ^ 2 + w ^ 2) := fun u v w => by
    nlinarith [sq_nonneg (u - v), sq_nonneg (v - w), sq_nonneg (u - w)]

  have hF1' : 1 ≤ F0 * M := by rw [div_le_iff₀ hM0] at hF1; linarith
  have hN1' : N1 * M ≤ -1 := by rw [le_div_iff₀ hM0] at hN1; linarith
  have hPS' : 1 ≤ -(2 * F0 * N1) * (2 * F0 * N1 + G0) * M ^ 2 := by
    rw [div_le_iff₀ (by positivity)] at hPS; linarith
  have hB1' : 1 ≤ Bs * M := by rw [div_le_iff₀ hM0] at hB1; linarith
  have hδ0' : δ * (8 * M) ≤ 1 := by rw [le_div_iff₀ (by positivity)] at hδ0; linarith
  have hF0pos : 0 < F0 := lt_of_lt_of_le (by positivity) hF1
  have hBspos : 0 < Bs := lt_of_lt_of_le (by positivity) hB1
  have hN1neg : N1 < 0 := lt_of_le_of_lt hN1 (div_neg_of_neg_of_pos (by norm_num) hM0)
  have hN1sq : N1 ^ 2 ≤ 1 := by linarith [sq_nonneg N2]
  have hN2sq : N2 ^ 2 ≤ 1 := by linarith [sq_nonneg N1]
  have hN1ge : -1 ≤ N1 := by
    have h := Real.abs_le_sqrt hN1sq
    rw [Real.sqrt_one] at h
    exact (abs_le.mp h).1
  have hσ2 : σ ^ 2 ≤ 4 * M ^ 2 := by
    have h := sq_le_sq' (abs_le.mp hσ).1 (abs_le.mp hσ).2
    have e : (2 * M) ^ 2 = 4 * M ^ 2 := by ring
    linarith
  have hBs2 : Bs ^ 2 ≤ M ^ 2 := sq_le_sq' (by linarith) hB2
  have hMδ : M ^ 2 * δ ^ 2 ≤ 1 / 64 := by
    have h1 : M * δ ≤ 1 / 8 := by linarith
    have h2 : 0 ≤ M * δ := by positivity
    have h3 : (M * δ) ^ 2 ≤ (1 / 8) ^ 2 := pow_le_pow_left₀ h2 h1 2
    have e : (M * δ) ^ 2 = M ^ 2 * δ ^ 2 := by ring
    linarith
  have hδ2 : δ ^ 2 ≤ 1 / 64 := by
    have := le_mul_of_one_le_left (sq_nonneg δ) hM2
    linarith

  have e1 : (![σ, -N2, N1] : Fin 3 → ℝ) 1 = -N2 := rfl
  have e2 : (![σ, -N2, N1] : Fin 3 → ℝ) 2 = N1 := rfl
  have e0 : (![σ, -N2, N1] : Fin 3 → ℝ) 0 = σ := rfl
  have hn0 := hn 0
  have hn1 := hn 1
  have hn2 := hn 2
