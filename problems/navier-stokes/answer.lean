    have hK := t3 (Km i 0 * y 0) (Km i 1 * y 1) (Km i 2 * y 2)
    have k1 := mb _ _ _ _ (hA i 0) (hy 0)
    have k2 := mb _ _ _ _ (hA i 1) (hy 1)
