    · rw [Real.norm_eq_abs, abs_mul, abs_neg, abs_of_nonneg hΘ0, abs_of_nonneg hp0]
      exact mul_le_mul hΘ2 hp1 hp0 (by norm_num)

  have hVpt : ∀ η : ℝ, (∫ y in (rfpY4 P.Md P.lam)..(rfpY4 P.Md P.lam + 60),
      Real.exp (y + 2 * rfpLam P y) * ((1 + η ^ 2)⁻¹) ^ (2 * rfpTh P y)) =
