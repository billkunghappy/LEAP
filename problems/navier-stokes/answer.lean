    have hi := integral_add (hrad _ (Aex B.h) _ c19 z t ht hq 1) (hrad _ (Aex B.h) _ hP2 z t ht hq 1)
    show (∫ r in Set.Ioi (0:ℝ), r ^ 1 * yAvg (mcor5 B G l0 (tempState5 B G l0 S) 2) (r, z, t, 0)) = 0
    refine ((setIntegral_congr_fun measurableSet_Ioi hpt).trans hi).trans ?_
    show radMom (mcor5 B G l0 S 2) 1 z t +
      radMom (fun ξ => dR B.h (PsiT5 B G l0 S) ξ + PsiT5 B G l0 S ξ / ξ.1) 1 z t = 0
    rw [c23 z t ht hq, hP7 z t ht hq, add_zero]

theorem mom_inc_profiles_v4 : ∀ (a b lam : ℝ), 0 < a → a < b → 0 < lam → ∃ ΦP ΦJ Ψ Ψt : ℝ → ℝ,
    ContDiff ℝ ∞ ΦP ∧ ContDiff ℝ ∞ ΦJ ∧ ContDiff ℝ ∞ Ψ ∧ ContDiff ℝ ∞ Ψt ∧
    (∀ x, ΦP x ≠ 0 → a < x ∧ x < b) ∧ (∀ x, ΦJ x ≠ 0 → a < x ∧ x < b) ∧ (∀ x, Ψ x ≠ 0 → a < x ∧ x < b) ∧
    (∀ x, Ψt x ≠ 0 → a < x ∧ x < b) ∧ (∀ x, 0 < x → Ψt x = deriv Ψ x + Ψ x / x) ∧
    (∫ x in Set.Ioi (0:ℝ), x ^ 2 * ΦP x) = 0 ∧ (∫ x in Set.Ioi (0:ℝ), x ^ 2 * ΦJ x) = 0 ∧
    (∫ x in Set.Ioi (0:ℝ), 2 * (x ^ 2 / 2) ^ (-(1/2 + lam)) / x * ΦP x) = 1 ∧
    (∫ x in Set.Ioi (0:ℝ), 2 * (x ^ 2 / 2) ^ (-(1/2 + lam)) / x * ΦJ x) = 0 ∧
    (∫ x in Set.Ioi (0:ℝ), x * (x ^ 2 / 2) ^ (-(1/2 + lam)) * ΦP x) = 0 ∧
    (∫ x in Set.Ioi (0:ℝ), x * (x ^ 2 / 2) ^ (-(1/2 + lam)) * ΦJ x) = 1 ∧
    (∫ x in Set.Ioi (0:ℝ), x * Ψt x) = 0 ∧
    (∫ x in Set.Ioi (0:ℝ), x ^ 2 * (x ^ 2 / 2) ^ (-(1/2 + lam)) * Ψt x) = 1 :=
by
  intro a b lam ha hab hlam
  obtain ⟨p, hp⟩ : ∃ p : ℝ, p = (3 * a + b) / 4 := ⟨_, rfl⟩
  obtain ⟨q, hq⟩ : ∃ q : ℝ, q = (a + 3 * b) / 4 := ⟨_, rfl⟩
  have hap : a < p := by rw [hp]; linarith
  have hpq : p < q := by rw [hp, hq]; linarith
  have hqb : q < b := by rw [hq]; linarith
  have hp0 : 0 < p := by linarith

  obtain ⟨k, hkC, hks, hkpos⟩ : ∃ k : ℝ → ℝ, ContDiff ℝ ∞ k ∧ (∀ x, k x ≠ 0 → p < x ∧ x < q) ∧
      (∀ x, p < x → x < q → 0 < k x) := by
    let kb : ContDiffBump ((a + b) / 2 : ℝ) := ⟨(b - a) / 8, (b - a) / 4, by linarith, by linarith⟩
    have hball : Metric.ball ((a + b) / 2 : ℝ) kb.rOut = Ioo p q := by
      rw [Real.ball_eq_Ioo, hp, hq]
      show Ioo ((a + b) / 2 - (b - a) / 4) ((a + b) / 2 + (b - a) / 4) = _
      congr 1 <;> ring
    refine ⟨kb, kb.contDiff, fun x hx => ?_,
      fun x h1 h2 => kb.pos_of_mem_ball (by rw [hball]; exact ⟨h1, h2⟩)⟩
    have hx' : x ∈ Function.support kb := hx
    rw [kb.support_eq, hball] at hx'
    exact hx'
  have hkD : Differentiable ℝ k := (contDiff_infty_iff_deriv.mp hkC).1
  have hk1C : ContDiff ℝ ∞ (deriv k) := (contDiff_infty_iff_deriv.mp hkC).2
  have hk1D : Differentiable ℝ (deriv k) := (contDiff_infty_iff_deriv.mp hk1C).1
  have hk2C : ContDiff ℝ ∞ (deriv (deriv k)) := (contDiff_infty_iff_deriv.mp hk1C).2
  have hkc : Continuous k := hkC.continuous
  have hk1c : Continuous (deriv k) := hk1C.continuous
  have hk2c : Continuous (deriv (deriv k)) := hk2C.continuous
  have hkd : ∀ x, HasDerivAt k (deriv k x) x := fun x => (hkD x).hasDerivAt
  have hk1d : ∀ x, HasDerivAt (deriv k) (deriv (deriv k) x) x := fun x => (hk1D x).hasDerivAt
  have hO : IsOpen {x : ℝ | x < p ∨ q < x} :=
    (isOpen_lt continuous_id continuous_const).union (isOpen_lt continuous_const continuous_id)
  have hk0 : ∀ x, (x < p ∨ q < x) → k x = 0 := by
    intro x hx
    by_contra h
    have := hks x h
    rcases hx with hx | hx <;> linarith [this.1, this.2]
  have hk10 : ∀ x, (x < p ∨ q < x) → deriv k x = 0 := by
    intro x hx
    have hev : k =ᶠ[nhds x] fun _ => (0:ℝ) :=
      Filter.eventuallyEq_of_mem (hO.mem_nhds hx) (fun y hy => hk0 y hy)
    rw [hev.deriv_eq]; simp
  have hk20 : ∀ x, (x < p ∨ q < x) → deriv (deriv k) x = 0 := by
    intro x hx
    have hev : deriv k =ᶠ[nhds x] fun _ => (0:ℝ) :=
      Filter.eventuallyEq_of_mem (hO.mem_nhds hx) (fun y hy => hk10 y hy)
    rw [hev.deriv_eq]; simp
  have hout : ∀ x, ¬ (a < x ∧ x < b) → (x < p ∨ q < x) := by
    intro x hx
    by_cases h1 : a < x
    · right
      by_contra h2
      exact hx ⟨h1, by linarith⟩
    · left; linarith

  have hp2 : ∀ x : ℝ, HasDerivAt (fun y : ℝ => y ^ 2) (2 * x) x := fun x => by
    simpa using hasDerivAt_pow 2 x
  have hp3 : ∀ x : ℝ, HasDerivAt (fun y : ℝ => y ^ 3) (3 * x ^ 2) x := fun x => by
    simpa using hasDerivAt_pow 3 x
  have hp4 : ∀ x : ℝ, HasDerivAt (fun y : ℝ => y ^ 4) (4 * x ^ 3) x := fun x => by
    simpa using hasDerivAt_pow 4 x
  have hwd : ∀ s x : ℝ, 0 < x →
      HasDerivAt (fun y : ℝ => (y ^ 2 / 2) ^ s) (2 * s * (x ^ 2 / 2) ^ s / x) x := by
    intro s x hx
    have hx' : x ≠ 0 := hx.ne'
    have h1 : HasDerivAt (fun y : ℝ => y ^ 2 / 2) x x := by
      have := (hp2 x).div_const 2
      convert this using 1; ring
    have h2 := h1.rpow_const (p := s) (Or.inl (by positivity))
    convert h2 using 1
    rw [Real.rpow_sub_one (by positivity)]
    field_simp
  have hrp : ∀ s x : ℝ, 0 < x → ContDiffAt ℝ ∞ (fun y : ℝ => (y ^ 2 / 2) ^ s) x := fun s x hx =>
    (show ContDiffAt ℝ ∞ (fun y : ℝ => y ^ 2 / 2) x by fun_prop).rpow_const_of_ne (by positivity)
  have smul0 : ∀ (h g : ℝ → ℝ), ContDiff ℝ ∞ g → (∀ x, x < p → g x = 0) →
      (∀ x, 0 < x → ContDiffAt ℝ ∞ h x) → ContDiff ℝ ∞ (fun x => h x * g x) := by
    intro h g hg hg0 hh
    rw [contDiff_iff_contDiffAt]
    intro x
    rcases lt_or_ge 0 x with hx | hx
    · exact (hh x hx).mul hg.contDiffAt
    · apply (contDiffAt_const (c := (0:ℝ))).congr_of_eventuallyEq
      filter_upwards [Iio_mem_nhds (show x < p by linarith)] with y hy
      rw [hg0 y hy, mul_zero]
  have master : ∀ (I G F : ℝ → ℝ), (∀ x, I x ≠ 0 → a < x ∧ x < b) →
      (∀ x ∈ Icc a b, HasDerivAt F (I x - G x) x) → ContinuousOn I (Icc a b) →
      ContinuousOn G (Icc a b) → F a = 0 → F b = 0 →
      ∫ x in Ioi (0:ℝ), I x = ∫ x in a..b, G x := by
    intro I G F hs hF hI hG hFa hFb
    have h1 : ∫ x in Ioi (0:ℝ), I x = ∫ x, I x :=
      setIntegral_eq_integral_of_forall_compl_eq_zero (fun x hx => by
        by_contra h
        exact hx (show (0:ℝ) < x by linarith [(hs x h).1]))
    have h2 : ∫ x in a..b, I x = ∫ x, I x :=
      intervalIntegral.integral_eq_integral_of_support_subset
        (fun x hx => ⟨(hs x hx).1, (hs x hx).2.le⟩)
    have hIi : IntervalIntegrable I volume a b := hI.intervalIntegrable_of_Icc hab.le
    have hGi : IntervalIntegrable G volume a b := hG.intervalIntegrable_of_Icc hab.le
    have h3 : ∫ x in a..b, (I x - G x) = F b - F a :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt (by rwa [uIcc_of_le hab.le]) (hIi.sub hGi)
    rw [intervalIntegral.integral_sub hIi hGi, hFa, hFb] at h3
    rw [h1, ← h2]
    linarith
  have pos : ∀ f : ℝ → ℝ, ContinuousOn f (Icc p q) → (∀ x, f x ≠ 0 → p < x ∧ x < q) →
      (∀ x, p < x → x < q → 0 < f x) → 0 < ∫ x in a..b, f x := by
    intro f hc hs hpos
    have e1 : ∫ x in a..b, f x = ∫ x, f x :=
      intervalIntegral.integral_eq_integral_of_support_subset
        (fun x hx => ⟨by linarith [(hs x hx).1], by linarith [(hs x hx).2]⟩)
    have e2 : ∫ x in p..q, f x = ∫ x, f x :=
      intervalIntegral.integral_eq_integral_of_support_subset
        (fun x hx => ⟨(hs x hx).1, (hs x hx).2.le⟩)
    rw [e1, ← e2]
    exact intervalIntegral.intervalIntegral_pos_of_pos_on (hc.intervalIntegrable_of_Icc hpq.le)
      (fun x hx => hpos x hx.1 hx.2) hpq

  obtain ⟨DP, hDPdef⟩ : ∃ D : ℝ, D = ∫ x in a..b, 4 * (4 + 2 * lam) * k x / x ^ 3 := ⟨_, rfl⟩
  obtain ⟨DJ, hDJdef⟩ : ∃ D : ℝ, D = ∫ x in a..b, x * k x := ⟨_, rfl⟩
  obtain ⟨DT, hDTdef⟩ : ∃ D : ℝ,
      D = ∫ x in a..b, 2 * lam * (x * (x ^ 2 / 2) ^ (-(1/2 + lam)) * k x) := ⟨_, rfl⟩
  have hDP : 0 < DP := by
    rw [hDPdef]
    refine pos (fun x => 4 * (4 + 2 * lam) * k x / x ^ 3) ?_ ?_ ?_
    · exact continuousOn_of_forall_continuousAt fun x hx => by
        have hx0 : 0 < x := by linarith [hx.1]
        fun_prop (disch := first | assumption | positivity | exact Or.inl (by positivity))
    · intro x hx
      exact hks x (fun h => hx (by rw [h]; ring))
    · intro x h1 h2
      have := hkpos x h1 h2
      have hx0 : 0 < x := by linarith
      positivity
  have hDJ : 0 < DJ := by
    rw [hDJdef]
    refine pos (fun x => x * k x) (by fun_prop) ?_ ?_
    · intro x hx
      exact hks x (right_ne_zero_of_mul hx)
    · intro x h1 h2
      have := hkpos x h1 h2
      have hx0 : 0 < x := by linarith
      positivity
  have hDT : 0 < DT := by
    rw [hDTdef]
    refine pos (fun x => 2 * lam * (x * (x ^ 2 / 2) ^ (-(1/2 + lam)) * k x)) ?_ ?_ ?_
    · exact continuousOn_of_forall_continuousAt fun x hx => by
        have hx0 : 0 < x := by linarith [hx.1]
        fun_prop (disch := first | assumption | positivity | exact Or.inl (by positivity))
    · intro x hx
      exact hks x (right_ne_zero_of_mul (right_ne_zero_of_mul hx))
    · intro x h1 h2
      have := hkpos x h1 h2
      have hx0 : 0 < x := by linarith
      positivity
  have hDP' : DP ≠ 0 := hDP.ne'
  have hDT' : DT ≠ 0 := hDT.ne'
  obtain ⟨CJ, hCJdef⟩ : ∃ C : ℝ, C = -(2 * (2 + 2 * lam)) * DJ := ⟨_, rfl⟩
  have hCJ : CJ ≠ 0 := by
    rw [hCJdef]
    exact mul_ne_zero (neg_ne_zero.mpr (by positivity)) hDJ.ne'

  obtain ⟨ΦP, hΦP⟩ : ∃ f : ℝ → ℝ, f = fun x => (x ^ 2 / 2) ^ (1/2 + lam) / (x * DP) *
      ((3 + 2 * lam) * deriv k x + x * deriv (deriv k) x) := ⟨_, rfl⟩
  obtain ⟨ΦJ, hΦJ⟩ : ∃ f : ℝ → ℝ, f = fun x => x * (x ^ 2 / 2) ^ (1/2 + lam) / CJ *
      ((5 + 2 * lam) * deriv k x + x * deriv (deriv k) x) := ⟨_, rfl⟩
  obtain ⟨Ψ, hΨ⟩ : ∃ f : ℝ → ℝ, f = fun x => k x / DT := ⟨_, rfl⟩
  obtain ⟨Ψt, hΨt⟩ : ∃ f : ℝ → ℝ, f = fun x => deriv Ψ x + Ψ x / x := ⟨_, rfl⟩
  have hΨv : ∀ x, Ψ x = k x / DT := fun x => by rw [hΨ]
  have hΨd : ∀ x, deriv Ψ x = deriv k x / DT := fun x => by rw [hΨ]; exact deriv_div_const _

  have hΦPC : ContDiff ℝ ∞ ΦP := by
    rw [hΦP]
    exact smul0 (fun x => (x ^ 2 / 2) ^ (1/2 + lam) / (x * DP))
      (fun x => (3 + 2 * lam) * deriv k x + x * deriv (deriv k) x) (by fun_prop)
      (fun x hx => by simp [hk10 x (Or.inl hx), hk20 x (Or.inl hx)])
      (fun x hx => (hrp _ x hx).div (by fun_prop) (by positivity))
  have hΦJC : ContDiff ℝ ∞ ΦJ := by
    rw [hΦJ]
    exact smul0 (fun x => x * (x ^ 2 / 2) ^ (1/2 + lam) / CJ)
      (fun x => (5 + 2 * lam) * deriv k x + x * deriv (deriv k) x) (by fun_prop)
      (fun x hx => by simp [hk10 x (Or.inl hx), hk20 x (Or.inl hx)])
      (fun x hx => (contDiffAt_id.mul (hrp _ x hx)).div_const CJ)
  have hΨC : ContDiff ℝ ∞ Ψ := by rw [hΨ]; exact hkC.div_const DT
  have hΨtC : ContDiff ℝ ∞ Ψt := by
    have h1 : ContDiff ℝ ∞ (deriv Ψ) := (contDiff_infty_iff_deriv.mp hΨC).2
    have h2 := smul0 (fun x => x⁻¹) Ψ hΨC (fun x hx => by rw [hΨv, hk0 x (Or.inl hx), zero_div])
      (fun x hx => contDiffAt_inv ℝ hx.ne')
    rw [hΨt]
    convert h1.add h2 using 1
    funext x
    simp only [div_eq_inv_mul]

  have hsP : ∀ x, ΦP x ≠ 0 → a < x ∧ x < b := by
    intro x hx
    by_contra hc
    apply hx
    have ho := hout x hc
    rw [hΦP]
    simp [hk10 x ho, hk20 x ho]
  have hsJ : ∀ x, ΦJ x ≠ 0 → a < x ∧ x < b := by
    intro x hx
    by_contra hc
    apply hx
    have ho := hout x hc
    rw [hΦJ]
    simp [hk10 x ho, hk20 x ho]
  have hsΨ : ∀ x, Ψ x ≠ 0 → a < x ∧ x < b := by
    intro x hx
    by_contra hc
    apply hx
    have ho := hout x hc
    rw [hΨv, hk0 x ho, zero_div]
  have hsΨt : ∀ x, Ψt x ≠ 0 → a < x ∧ x < b := by
    intro x hx
    by_contra hc
    apply hx
    have ho := hout x hc
    rw [hΨt]
    simp [hΨd, hΨv, hk0 x ho, hk10 x ho]
  refine ⟨ΦP, ΦJ, Ψ, Ψt, hΦPC, hΦJC, hΨC, hΨtC, hsP, hsJ, hsΨ, hsΨt, fun x _ => by rw [hΨt],
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩

  · refine (master (fun x => x ^ 2 * ΦP x) (fun _ => 0)
      (fun x => x ^ 2 * (x ^ 2 / 2) ^ (1/2 + lam) * deriv k x / DP) ?_ ?_ ?_ ?_ ?_ ?_).trans
      (by simp)
    · intro x h; beta_reduce at h; exact hsP x (right_ne_zero_of_mul h)
    · intro x hx
      have hx0 : 0 < x := by linarith [hx.1]
      have hx' : x ≠ 0 := hx0.ne'
      refine ((((hp2 x).mul (hwd (1/2 + lam) x hx0)).mul (hk1d x)).div_const DP).congr_deriv ?_
      simp only [hΦP, Pi.mul_apply]
      have hV : 0 < (x ^ 2 / 2) ^ (1/2 + lam) := by positivity
      set V := (x ^ 2 / 2) ^ (1/2 + lam)
      field_simp
      ring
    · exact continuousOn_of_forall_continuousAt fun x hx => by
        have hx0 : 0 < x := by linarith [hx.1]
        simp only [hΦP]
        fun_prop (disch := first | assumption | positivity | exact Or.inl (by positivity))
    · fun_prop
    · simp [hk10 a (Or.inl hap)]
    · simp [hk10 b (Or.inr hqb)]

  · refine (master (fun x => x ^ 2 * ΦJ x) (fun _ => 0)
      (fun x => x ^ 4 * (x ^ 2 / 2) ^ (1/2 + lam) * deriv k x / CJ) ?_ ?_ ?_ ?_ ?_ ?_).trans
      (by simp)
    · intro x h; beta_reduce at h; exact hsJ x (right_ne_zero_of_mul h)
    · intro x hx
      have hx0 : 0 < x := by linarith [hx.1]
      have hx' : x ≠ 0 := hx0.ne'
      refine ((((hp4 x).mul (hwd (1/2 + lam) x hx0)).mul (hk1d x)).div_const CJ).congr_deriv ?_
      simp only [hΦJ, Pi.mul_apply]
      have hV : 0 < (x ^ 2 / 2) ^ (1/2 + lam) := by positivity
