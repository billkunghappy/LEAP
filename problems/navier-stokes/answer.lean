    rw [hQ, hT] at hfin
    exact hfin

  have hLB : ∀ (ξ : Cyl) {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (U : Set Cyl) (n : ℕ),
      IsOpen U → ξ ∈ U → ∀ (s : Cyl → ℝ) (g : Cyl → V) (Bs Bg : ℝ), ContDiffOn ℝ ∞ s U →
      ContDiffOn ℝ ∞ g U → (∀ i, i ≤ n → NB B.h s i ξ ≤ Bs) → (∀ i, i ≤ n → NB B.h g i ξ ≤ Bg) →
      NB B.h (fun η => s η • g η) n ξ ≤ 2 ^ n * Bs * Bg := by
    intro ξ V _ _ U n hU hξ s g Bs Bg hs hg hBs hBg
    have hl := leib ξ U n hU hξ s g (hs.of_le (by exact_mod_cast le_top))
      (hg.of_le (by exact_mod_cast le_top))
    have hBs0 : 0 ≤ Bs := by
      have h1 := hBs 0 (Nat.zero_le _)
      have h2 : 0 ≤ NB B.h s 0 ξ := norm_nonneg _
      linarith
    have hBg0 : 0 ≤ Bg := by
      have h1 := hBg 0 (Nat.zero_le _)
      have h2 : 0 ≤ NB B.h g 0 ξ := norm_nonneg _
      linarith
    refine hl.trans ?_
    have hc : (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ)) = 2 ^ n := by
      exact_mod_cast Nat.sum_range_choose n
    calc ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * NB B.h s i ξ * NB B.h g (n - i) ξ
        ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * Bs * Bg := by
          apply Finset.sum_le_sum
          intro i hi
          have hin : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          exact mul_le_mul (mul_le_mul_of_nonneg_left (hBs i hin) (Nat.cast_nonneg _))
            (hBg (n - i) (Nat.sub_le n i)) (norm_nonneg _) (mul_nonneg (Nat.cast_nonneg _) hBs0)
      _ = 2 ^ n * Bs * Bg := by
          rw [← Finset.sum_mul, ← Finset.sum_mul, hc]

  have hvec : ∀ (a c : Cyl → ℂ) (ξ : Cyl) (n : ℕ), ContDiffAt ℝ ∞ a ξ → ContDiffAt ℝ ∞ c ξ →
      NB B.h (fun η => ![a η, (0:ℂ), c η]) n ξ ≤ NB B.h a n ξ + NB B.h c n ξ := by
    intro a c ξ n ha hc
    obtain ⟨L0, hL0⟩ : ∃ L0 : ℂ →L[ℝ] (Fin 3 → ℂ),
        L0 = ContinuousLinearMap.single ℝ (fun _ : Fin 3 => ℂ) 0 := ⟨_, rfl⟩
    obtain ⟨L2, hL2⟩ : ∃ L2 : ℂ →L[ℝ] (Fin 3 → ℂ),
        L2 = ContinuousLinearMap.single ℝ (fun _ : Fin 3 => ℂ) 2 := ⟨_, rfl⟩
    have hfun : (fun η => ![a η, (0:ℂ), c η]) = (⇑L0 ∘ a) + (⇑L2 ∘ c) := by
      funext η i
      fin_cases i <;> simp [hL0, hL2, Pi.single_apply]
    have hLn : ∀ i : Fin 3, ‖ContinuousLinearMap.single ℝ (fun _ : Fin 3 => ℂ) i‖ ≤ 1 := by
      intro i
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun y => ?_)
      rw [ContinuousLinearMap.single_apply, Pi.norm_single, one_mul]
    have hA : ContDiffAt ℝ ∞ (⇑L0 ∘ a) ξ := L0.contDiff.contDiffAt.comp ξ ha
    have hC : ContDiffAt ℝ ∞ (⇑L2 ∘ c) ξ := L2.contDiff.contDiffAt.comp ξ hc
    have eA : iteratedFDeriv ℝ n (⇑L0 ∘ a) ξ =
        L0.compContinuousMultilinearMap (iteratedFDeriv ℝ n a ξ) :=
      L0.iteratedFDeriv_comp_left ha (by exact_mod_cast le_top)
    have eC : iteratedFDeriv ℝ n (⇑L2 ∘ c) ξ =
        L2.compContinuousMultilinearMap (iteratedFDeriv ℝ n c ξ) :=
      L2.iteratedFDeriv_comp_left hc (by exact_mod_cast le_top)
    have hsplit : iteratedFDeriv ℝ n (fun η => ![a η, (0:ℂ), c η]) ξ =
        L0.compContinuousMultilinearMap (iteratedFDeriv ℝ n a ξ) +
          L2.compContinuousMultilinearMap (iteratedFDeriv ℝ n c ξ) := by
      rw [hfun, iteratedFDeriv_add_apply (hA.of_le (by exact_mod_cast le_top))
        (hC.of_le (by exact_mod_cast le_top)), eA, eC]
    unfold NB
    rw [hsplit]
    have e2 : (L0.compContinuousMultilinearMap (iteratedFDeriv ℝ n a ξ) +
          L2.compContinuousMultilinearMap (iteratedFDeriv ℝ n c ξ)).compContinuousLinearMap
            (fun _ => Lnorm B.h ξ) =
        L0.compContinuousMultilinearMap
            ((iteratedFDeriv ℝ n a ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) +
          L2.compContinuousMultilinearMap
            ((iteratedFDeriv ℝ n c ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
    · refine (ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _).trans ?_
      rw [hL0]
      exact mul_le_of_le_one_left (norm_nonneg _) (hLn 0)
    · refine (ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _).trans ?_
      rw [hL2]
      exact mul_le_of_le_one_left (norm_nonneg _) (hLn 2)
  have tnq : ∀ h : ℝ, 0 < h → h < 1/100 → SimScaleProps h → ∀ (p : ℝ) (k : ℕ), ∃ C : ℝ,
      ∀ ξ : Cyl, ξ.2.2.1 < 1 → qC h ξ ≤ 1 → NB h (fun η => qC h η ^ p) k ξ ≤ C * qC h ξ ^ p := by
    intro h _ _ hS
    have hN : SimNorm h := by
      obtain ⟨hS1, -, -, -, hS5⟩ := hS
      open Pointwise in
      have hom : ∀ μ z τ : ℝ, 0 < μ →
          simScale h (μ ^ (1/2 - h) * z) (μ * τ) = μ * simScale h z τ := by
        intro μ z τ hμ
        have key : ∀ p : ℝ, 0 < p → μ * p - (μ ^ (1/2 - h) * z) ^ 2 * (μ * p) ^ (2 * h) =
            μ * (p - z ^ 2 * p ^ (2 * h)) := by
          intro p hp
          have sq : (μ ^ (1/2 - h)) ^ 2 = μ ^ (1 - 2 * h) := by
            rw [← Real.rpow_natCast, ← Real.rpow_mul hμ.le]
            congr 1
            push_cast
            ring
