theorem cr5_meanwave_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (S : CState) (bw ca cm cd β : ℝ) (D : WC), StOrd5 B G l0 S bw ca cm cd → InWg5 B G (qsOf l0) (β + 1/2) D → InWg5 B G (qsOf l0) β (velW5 B G D) → InWg5 B G (qsOf l0) (β + 2/5) (cr5MW B G l0 S (cr5Vel B G D)) :=
