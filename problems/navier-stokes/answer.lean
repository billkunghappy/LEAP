  obtain ⟨aa, haadef⟩ : ∃ aa : ℝ × ℝ × ℝ × ℝ × ℝ, aa = ((0:ℝ), β, κ, A, p) := ⟨_, rfl⟩
  obtain ⟨L, hLdef⟩ : ∃ L : (ℝ × ℝ × ℝ) →L[ℝ] (ℝ × ℝ × ℝ × ℝ × ℝ),
      L = (ContinuousLinearMap.inl ℝ ℝ (ℝ × ℝ × ℝ × ℝ)).comp
        (ξ.1⁻¹ • ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)) := ⟨_, rfl⟩
  have hLs : ∀ s : ℝ × ℝ × ℝ, aa + L s = (ξ.1⁻¹ * s.1, β, κ, A, p) := by
    intro s; rw [haadef, hLdef]; simp
  have hz0 : aa + L (ξ.1, ξ.2.1, ξ.2.2.1) = ((1:ℝ), β, κ, A, p) := by
    rw [hLs]; simp [hx0.ne']

  have hTg0 : (0:ℝ) < Tgc := by unfold Tgc; positivity
  have hci : 0 < cib B.h γ.1 := by
    unfold cib
    exact mul_pos (zpow_pos hTg0 _) (Real.rpow_pos_of_pos hQb0 _)
  have hL0 : (0:ℝ) ≤ Lsb B.h G.r0 γ.1 := by
    show 0 ≤ 2 * G.r0 / cib B.h γ.1
    exact div_nonneg (by linarith) hci.le
  obtain ⟨Y0, hvY0, hRY0⟩ : ∃ Y0 : ℝ × ℝ, vco B.h G.r0 γ (G.ctr γ) Y0 = 0 ∧
      inRect B.h γ (G.ctr γ) G.r0 Y0 :=
    ⟨_, (pulse_line_rect5 B.h G.r0 γ (G.ctr γ) ξ.2.2.2 hr0 hr0' hR 0 le_rfl hL0).1,
      (pulse_line_rect5 B.h G.r0 γ (G.ctr γ) ξ.2.2.2 hr0 hr0' hR 0 le_rfl hL0).2.1⟩
  obtain ⟨U, hUo, hs0U, hUprop⟩ := tHjet_eta_open_v5 B hB γ ξ hD heta

  have hident : ∀ s ∈ U, G.tH γ s 0 = Penv5 B G γ 0 • Φ (aa + L s) := by
    intro s hs
