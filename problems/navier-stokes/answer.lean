    intro k e he
    rw [hP k e he, ← Real.norm_eq_abs]
    refine (ContinuousMultilinearMap.le_opNorm _ _).trans ?_
    have hv : ‖((0:ℝ), (1:ℝ))‖ = 1 := by simp [Prod.norm_def]
    simp [hv]

  have CV : ∀ (ψ : ℝ → ℝ → ℝ) (a' a b b' B : ℝ), a' < a → a ≤ b → b < b' → ContDiffOn ℝ ∞ (↿ψ) (Ioo a' b' ×ˢ Ioo (-1) 1) → (∀ m : ℕ, ∃ K : ℝ, ∀ y η : ℝ, a ≤ y → y ≤ b → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿ψ) (y, η)‖ ≤ K) → (∀ y η : ℝ, a ≤ y → y ≤ b → -1 < η → η < 1 → |ψ y η| ≤ B ∧ |deriv (fun e => ψ y e) η| ≤ B) → EtaJet ((b - a) * B) (fun e => ∫ y in a..b, ψ y e) := by
    intro ψ a' a b b' B ha hab hb hψ hK hB
    have hPI := PI ψ a' a b b' (-1) 1 ha hab hb (by norm_num) hψ
    refine ⟨hPI.1, ?_, ?_⟩
    · intro m
      obtain ⟨K, hK'⟩ := hK m
      refine ⟨(b - a) * K, fun η h1 h2 => hPI.2 m η K h1 h2 (fun y hy1 hy2 => ?_)⟩
      have hmem : (y, η) ∈ Ioo a' b' ×ˢ Ioo (-1:ℝ) 1 := ⟨⟨by linarith, by linarith⟩, h1, h2⟩
      exact (L1 (↿ψ) _ y (isOpen_Ioo.prod isOpen_Ioo) hψ m η hmem).trans (hK' y η hy1 hy2 h1 h2)
    · intro η h1 h2
      constructor
      · have := hPI.2 0 η B h1 h2 (fun y hy1 hy2 => by
          rw [iteratedDeriv_zero]; exact (hB y η hy1 hy2 h1 h2).1)
        rw [iteratedDeriv_zero] at this
        exact this
      · have := hPI.2 1 η B h1 h2 (fun y hy1 hy2 => by
          rw [iteratedDeriv_one]; exact (hB y η hy1 hy2 h1 h2).2)
        rw [iteratedDeriv_one] at this
        exact this

  have CB : ∀ (g : ℝ × ℝ → ℝ) (O K : Set (ℝ × ℝ)), IsOpen O → IsCompact K → K ⊆ O → ContDiffOn ℝ ∞ g O → ∀ m : ℕ, ∃ C : ℝ, ∀ z ∈ K, ‖iteratedFDeriv ℝ m g z‖ ≤ C := by
    intro g O K hO hK hKO hg m
    apply hK.exists_bound_of_continuousOn
    intro z hz
    exact ((hg.contDiffAt (hO.mem_nhds (hKO hz))).continuousAt_iteratedFDeriv
      (by exact_mod_cast le_top)).continuousWithinAt

  have SUB : ∀ (f g : ℝ × ℝ → ℝ) (O S : Set (ℝ × ℝ)), IsOpen O → S ⊆ O → ContDiffOn ℝ ∞ f O → ContDiffOn ℝ ∞ g O → (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k f z‖ ≤ C) → (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k g z‖ ≤ C) → ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (fun z => f z - g z) z‖ ≤ C := by
    intro f g O S hO hS hf hg hfK hgK k
    obtain ⟨C1, h1⟩ := hfK k
    obtain ⟨C2, h2⟩ := hgK k
    refine ⟨C1 + C2, fun z hz => ?_⟩
    have hfz : ContDiffAt ℝ k f z :=
      (hf.contDiffAt (hO.mem_nhds (hS hz))).of_le (by exact_mod_cast le_top)
    have hgz : ContDiffAt ℝ k g z :=
      (hg.contDiffAt (hO.mem_nhds (hS hz))).of_le (by exact_mod_cast le_top)
    have e : (fun z => f z - g z) = f - g := rfl
    rw [e, iteratedFDeriv_sub_apply hfz hgz]
    exact (norm_sub_le _ _).trans (add_le_add (h1 z hz) (h2 z hz))
  have PROD : ∀ (f g : ℝ × ℝ → ℝ) (O S : Set (ℝ × ℝ)), IsOpen O → S ⊆ O → ContDiffOn ℝ ∞ f O → ContDiffOn ℝ ∞ g O → (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k f z‖ ≤ C) → (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k g z‖ ≤ C) → ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (fun z => f z * g z) z‖ ≤ C := by
    intro f g O S hO hS hf hg hfK hgK n
    choose Cf hCf using hfK
    choose Cg hCg using hgK
    refine ⟨∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * (max (Cf i) 0 * max (Cg (n - i)) 0),
      fun z hz => ?_⟩
    have hzO := hS hz
    have hL := norm_iteratedFDerivWithin_mul_le hf hg hO.uniqueDiffOn hzO (n := n)
      (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => f y * g y) n hO hzO] at hL
    refine hL.trans (Finset.sum_le_sum (fun i _ => ?_))
    rw [iteratedFDerivWithin_of_isOpen (f := f) i hO hzO,
      iteratedFDerivWithin_of_isOpen (f := g) (n - i) hO hzO]
    have a1 : ‖iteratedFDeriv ℝ i f z‖ ≤ max (Cf i) 0 := (hCf i z hz).trans (le_max_left _ _)
    have a2 : ‖iteratedFDeriv ℝ (n - i) g z‖ ≤ max (Cg (n - i)) 0 :=
      (hCg (n - i) z hz).trans (le_max_left _ _)
    have c0 : (0:ℝ) ≤ (n.choose i : ℝ) := Nat.cast_nonneg _
    have hm := mul_le_mul a1 a2 (norm_nonneg _) (le_max_right _ _)
    calc (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i f z‖ * ‖iteratedFDeriv ℝ (n - i) g z‖
        = (n.choose i : ℝ) * (‖iteratedFDeriv ℝ i f z‖ * ‖iteratedFDeriv ℝ (n - i) g z‖) := by ring
      _ ≤ (n.choose i : ℝ) * (max (Cf i) 0 * max (Cg (n - i)) 0) := mul_le_mul_of_nonneg_left hm c0

  have hwk : ∀ (B B' : ℝ) (r : ℝ → ℝ), EtaJet B r → B ≤ B' → EtaJet B' r := by
    intro B B' r hr hB
