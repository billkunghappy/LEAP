          rw [ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, norm_smul,
            Real.norm_of_nonneg (inv_nonneg.mpr (Real.sqrt_nonneg _))]
        have e : (fun η => ((Real.sqrt (Qb γ.1))⁻¹ • ContinuousLinearMap.id ℝ ℝ) (Real.sqrt (qC B.h η))) =
            fun η => (Real.sqrt (Qb γ.1))⁻¹ * Real.sqrt (qC B.h η) := by
          funext η
          simp
        have h1 : NB B.h (fun η => (Real.sqrt (Qb γ.1))⁻¹ * Real.sqrt (qC B.h η)) k ξ ≤
            ‖(Real.sqrt (Qb γ.1))⁻¹ • ContinuousLinearMap.id ℝ ℝ‖ *
              NB B.h (fun η => Real.sqrt (qC B.h η)) k ξ := by
          rw [← e]
          exact hNBc _ (fun η => Real.sqrt (qC B.h η)) ξ k (hM.1 ξ hξ).1
        show NB B.h (fun η => (Real.sqrt (Qb γ.1))⁻¹ * Real.sqrt (qC B.h η)) k ξ ≤
          2 * |C| * qC B.h ξ ^ (B.h * 0) * SC B.h ξ ^ (0:ℝ)
        simp only [mul_zero, Real.rpow_zero, mul_one]
        calc NB B.h (fun η => (Real.sqrt (Qb γ.1))⁻¹ * Real.sqrt (qC B.h η)) k ξ
            ≤ ‖(Real.sqrt (Qb γ.1))⁻¹ • ContinuousLinearMap.id ℝ ℝ‖ *
                NB B.h (fun η => Real.sqrt (qC B.h η)) k ξ := h1
          _ ≤ (Real.sqrt (Qb γ.1))⁻¹ * (|C| * Real.sqrt (qC B.h ξ)) :=
              mul_le_mul hg ((hC ξ hξ).1.trans
                (mul_le_mul_of_nonneg_right (le_abs_self C) (Real.sqrt_nonneg _)))
                (hNB0 _ k ξ) (inv_nonneg.mpr (Real.sqrt_nonneg _))
          _ = |C| * ((Real.sqrt (Qb γ.1))⁻¹ * Real.sqrt (qC B.h ξ)) := by ring
          _ ≤ |C| * 2 := mul_le_mul_of_nonneg_left hsq (abs_nonneg C)
          _ = 2 * |C| := by ring)
    obtain ⟨gZ, hgZ⟩ : ∃ g : ℝ →L[ℝ] (Fin 3 → ℂ), ∀ x : ℝ, g x = ![0, 0, -(x:ℂ)] :=
      ⟨(ContinuousLinearMap.id ℝ ℝ).smulRight ![0, 0, (-1 : ℂ)], fun x => by
        funext i; fin_cases i <;> simp [Complex.real_smul]⟩
    have T2 := inWg5_cross_mult B G l0 hok (β + 1/2) (-1/2) c
      (fun _ _ ξ => gZ (B.h * qC B.h ξ ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) ξ)) hc
      (fun γ m ξ hξ _ => contDiffAt_const.clm_apply (hM.1 ξ hξ).2)
      (fun γ m ξ hξ _ c' _ => by
        show gZ (B.h * qC B.h (shY ξ c') ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) (shY ξ c')) =
          gZ (B.h * qC B.h ξ ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) ξ)
        have hq : qC B.h (shY ξ c') = qC B.h ξ := rfl
        rw [hdZinv ξ c', hq])
      (fun k => by
        obtain ⟨C, hC⟩ := hM.2 k
        refine ⟨‖gZ‖ * |C|, 0, fun γ m ξ hξ _ _ _ => ?_⟩
        show NB B.h (fun η => gZ (B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) η)) k ξ ≤
          ‖gZ‖ * |C| * qC B.h ξ ^ (B.h * (-1/2)) * SC B.h ξ ^ (0:ℝ)
        rw [Real.rpow_zero, mul_one]
        have hp : 1 ≤ qC B.h ξ ^ (B.h * (-1/2)) :=
          Real.one_le_rpow_of_pos_of_le_one_of_nonpos (hDq ξ hξ).1 (hDq ξ hξ).2 (by linarith)
        have hK : 0 ≤ ‖gZ‖ * |C| := mul_nonneg (norm_nonneg _) (abs_nonneg _)
        calc NB B.h (fun η => gZ (B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) η)) k ξ
            ≤ ‖gZ‖ * NB B.h (fun η => B.h * qC B.h η ^ (1/2:ℝ) *
                dZ (fun η' => Real.log (qC B.h η')) η) k ξ :=
              hNBc gZ _ ξ k (hM.1 ξ hξ).2
          _ ≤ ‖gZ‖ * |C| := mul_le_mul_of_nonneg_left ((hC ξ hξ).2.trans (le_abs_self _)) (norm_nonneg _)
          _ ≤ ‖gZ‖ * |C| * qC B.h ξ ^ (B.h * (-1/2)) := le_mul_of_one_le_right hK hp)
    have P := (pwr5_waveV_add B G hok (qsOf l0) hqs1 _ _ _ _ T1 T2).1
    have e1 : min (β + 0) (β + 1/2 + -1/2) = β := by
      rw [show β + 1/2 + -1/2 = β by ring, add_zero, min_self]
    rw [e1] at P
    convert P using 1
    funext γ m ξ i
    simp only [Pi.add_apply, wmoAmp5, hgZ]
    rw [hs1eq γ ξ]
    fin_cases i <;> simp [crossC, rotC] <;> ring
  · have hdc : DifferentiableAt ℝ (c γ m) ξ :=
      ((hc.2.1 γ m).contDiffAt (hDopen.mem_nhds hξ)).differentiableAt (by norm_num)
    have hdd : DifferentiableAt ℝ (d γ m) ξ :=
      ((hd.2.1 γ m).contDiffAt (hDopen.mem_nhds hξ)).differentiableAt (by norm_num)
    have hv := hvadd c d γ m ξ hdc hdd
    funext i
    simp only [wmoAmp5, Pi.add_apply]
