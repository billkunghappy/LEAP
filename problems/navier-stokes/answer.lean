  refine ⟨Cc, Ns, ?_⟩
  intro X η hX1 hX2 hη1 hη2
  have hWX := hW_nn Ns X hX1 hX2
  have hT1 : 0 ≤ 2 ^ m * A2 * (2 ^ m * A1 * Cs * K) := by positivity
  have hT2 : 0 ≤ 2 ^ m * A3 * (Cs * K) := by positivity
  have hCc0 : 0 ≤ Cc := by rw [hCc]; linarith
  rw [mul_assoc Cc (edgeWeight Xa Xb aa ab X)]
  rcases lt_or_ge X Xm with hXm | hXm
  ·
    have hnb : Ioo (0:ℝ) Xm ×ˢ Ioo (-1:ℝ) 1 ∈ nhds (X, η) :=
      (isOpen_Ioo.prod isOpen_Ioo).mem_nhds ⟨⟨by linarith, hXm⟩, hη1, hη2⟩
    have hz1 : (↿(stressPrimTh r1)) =ᶠ[nhds (X, η)] fun _ => (0:ℝ) := by
      filter_upwards [hnb] with q hq
      obtain ⟨⟨hq0, hqm⟩, hq1, hq2⟩ := hq
      show stressPrimTh r1 q.1 q.2 = 0
      unfold stressPrimTh
      rw [if_pos ⟨hq0, hq1, hq2⟩, intervalIntegral.integral_of_le hq0.le,
        setIntegral_eq_zero_of_forall_eq_zero (fun x (hx : x ∈ Ioc 0 q.1) => by
          rw [(hin x q.2 hx.1 (hx.2.trans hqm.le) hq1 hq2).1, mul_zero]), mul_zero]
    have hz2 : (↿(stressPrimZ r2)) =ᶠ[nhds (X, η)] fun _ => (0:ℝ) := by
      filter_upwards [hnb] with q hq
      obtain ⟨⟨hq0, hqm⟩, hq1, hq2⟩ := hq
      show stressPrimZ r2 q.1 q.2 = 0
      unfold stressPrimZ
      rw [if_pos ⟨hq0, hq1, hq2⟩, intervalIntegral.integral_of_le hq0.le,
        setIntegral_eq_zero_of_forall_eq_zero (fun x (hx : x ∈ Ioc 0 q.1) =>
