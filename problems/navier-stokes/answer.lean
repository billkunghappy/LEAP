      have hcomp : (iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq.comp Pm) =
          ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
            (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm) := by
        ext m; rfl
      have hCi : ‖(iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)‖ ≤ C i * qC B.h ξ := by
        rw [hMqdef, hw0def]; exact hC i ξ.2.1 (1 - ξ.2.2.1) (by linarith) hq1
      have hprod : ∏ k : Fin i, ‖Pm‖ ≤ 1 := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        exact pow_le_one₀ (norm_nonneg _) hP1
      have hb1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
        ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)) (fun _ : Fin i => Pm)
      have hb2 := hb1.trans ((mul_le_of_le_one_right (norm_nonneg _) hprod).trans hCi)
      have hCiD : C i ≤ D := by
        have h2 : |C i| ≤ ∑ k ∈ Finset.range (j + 1), |C k| :=
          Finset.single_le_sum (f := fun k => |C k|) (fun k _ => abs_nonneg _)
            (Finset.mem_range.mpr (Nat.lt_succ_of_le hij))
        have h3 := le_abs_self (C i)
        rw [hDdef]; linarith
      rw [iteratedFDerivWithin_of_isOpen i hO h0O, hψeq,
        iteratedFDeriv_const_smul_apply (hΦ.of_le (by exact_mod_cast le_top)),
        key (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) w0 T hW hS.2.2.2.1 hw0 i,
        norm_smul, hTdef, hcomp, Real.norm_of_nonneg (inv_nonneg.mpr hq0.le)]
      calc (qC B.h ξ)⁻¹ * ‖((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
            (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm)‖
          ≤ (qC B.h ξ)⁻¹ * (C i * qC B.h ξ) :=
            mul_le_mul_of_nonneg_left hb2 (inv_nonneg.mpr hq0.le)
        _ = C i := by rw [mul_comm (C i), ← mul_assoc, inv_mul_cancel₀ hq0.ne', one_mul]
        _ ≤ D := hCiD
        _ ≤ D ^ i := le_self_pow₀ hD1 (by omega)
    have hg : ContDiffOn ℝ ∞ (fun x : ℝ => x ^ c) (Set.Ioi 0) :=
      (contDiffOn_id (s := Set.Ioi (0:ℝ))).rpow_const_of_ne (fun x hx => ne_of_gt hx)
    have hψmaps : Set.MapsTo ψ O (Set.Ioi 0) := fun v hv => hψpos v hv
    have hCg : ∀ i ≤ j, ‖iteratedFDerivWithin ℝ i (fun x : ℝ => x ^ c) (Set.Ioi 0) (ψ 0)‖ ≤ A := by
      intro i hi
      rw [hψ0, iteratedFDerivWithin_of_isOpen i isOpen_Ioi (Set.mem_Ioi.mpr (zero_lt_one' ℝ)),
        norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
        Real.iter_deriv_rpow_const, Real.one_rpow, mul_one, Real.norm_eq_abs, hAdef]
      exact Finset.single_le_sum (f := fun i => |Polynomial.eval c (descPochhammer ℝ i)|)
        (fun i _ => abs_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    have hFdB := norm_iteratedFDerivWithin_comp_le hg hψ (by exact_mod_cast le_top)
      isOpen_Ioi.uniqueDiffOn hO.uniqueDiffOn hψmaps h0O (C := A) (D := D) hCg hDψ
    obtain ⟨gl, hgldef⟩ : ∃ gl : ℝ →L[ℝ] ℝ, gl = a • ContinuousLinearMap.id ℝ ℝ := ⟨_, rfl⟩
    have hgl : ‖gl‖ ≤ a := ContinuousLinearMap.opNorm_le_bound _ ha0 (fun x => le_of_eq (by
      rw [hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, norm_smul,
        Real.norm_of_nonneg ha0]))
    have hEq : Set.EqOn (fun z => F (ξ + Lnorm B.h ξ z)) (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O := by
      intro z hz
      have hψz := hψpos z hz
      have e : qC B.h (ξ + Lnorm B.h ξ z) = qC B.h ξ * ψ z := by
        rw [hψdef]
        show _ = qC B.h ξ * (qC B.h (ξ + Lnorm B.h ξ z) / qC B.h ξ)
        field_simp
      show F (ξ + Lnorm B.h ξ z) = gl (ψ z ^ c)
      rw [hFdef, hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, smul_eq_mul]
      show qC B.h (ξ + Lnorm B.h ξ z) ^ c = a * ψ z ^ c
      rw [e, Real.mul_rpow hq0.le hψz.le, ← hadef]
    have hgψ : ContDiffOn ℝ ∞ ((fun x : ℝ => x ^ c) ∘ ψ) O := hg.comp hψ hψmaps
    have hNB : NB B.h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := by
      unfold NB
      rw [key F {η : Cyl | η.2.2.1 < 1} ξ (Lnorm B.h ξ) hU hFU hξ j]
    calc NB B.h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := hNB
      _ = ‖iteratedFDerivWithin ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) O 0‖ := by
          rw [iteratedFDerivWithin_of_isOpen j hO h0O]
      _ = ‖iteratedFDerivWithin ℝ j (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O 0‖ := by
          rw [iteratedFDerivWithin_congr hEq h0O j]
      _ = ‖gl.compContinuousMultilinearMap
            (iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0)‖ := by
          rw [ContinuousLinearMap.iteratedFDerivWithin_comp_left gl (hgψ.contDiffWithinAt h0O)
            hO.uniqueDiffOn h0O (i := j) (by exact_mod_cast le_top)]
      _ ≤ ‖gl‖ * ‖iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ a * ((j.factorial : ℝ) * A * D ^ j) := mul_le_mul hgl hFdB (norm_nonneg _) ha0
      _ = (j.factorial : ℝ) * A * D ^ j * a := by ring

  have hUo : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqpos : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hsU : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η ^ (1/2:ℝ)) {η : Cyl | η.2.2.1 < 1} :=
    hqC.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
  have hlogU : ContDiffOn ℝ ∞ (fun η : Cyl => Real.log (qC B.h η)) {η : Cyl | η.2.2.1 < 1} :=
    hqC.log (fun η hη => (hqpos η hη).ne')
  have hdZU : ∀ f : Cyl → ℝ, ContDiffOn ℝ ∞ f {η : Cyl | η.2.2.1 < 1} →
      ContDiffOn ℝ ∞ (dZ f) {η : Cyl | η.2.2.1 < 1} := by
    intro f hf
    have h1 := ((contDiffOn_infty_iff_fderiv_of_isOpen hUo).1 hf).2
    have e : dZ f = fun x => fderiv ℝ f x (0, 1, 0, 0) := rfl
    rw [e]
    exact h1.clm_apply contDiffOn_const

  have hid : ∀ η : Cyl, η.2.2.1 < 1 →
      B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) η =
        2 * B.h * dZ (fun ζ => qC B.h ζ ^ (1/2:ℝ)) η := by
    intro η hη
    have hq := hqpos η hη
    have hd : HasFDerivAt (qC B.h) (fderiv ℝ (qC B.h) η) η :=
      ((hqC.contDiffAt (hUo.mem_nhds hη)).differentiableAt (by norm_num)).hasFDerivAt
    have h1 := (hd.log hq.ne').fderiv
    have h2 := (hd.rpow_const (p := (1/2:ℝ)) (Or.inl hq.ne')).fderiv
    unfold dZ
    rw [h1, h2]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [Real.rpow_sub_one hq.ne', div_eq_mul_inv]
    ring

  have hshift : ∀ (f : Cyl → ℝ) (ξ : Cyl) (k : ℕ), 0 < qC B.h ξ → ContDiffAt ℝ ∞ f ξ →
      NB B.h (dZ f) k ξ ≤ qC B.h ξ ^ (B.h - 1/2) * NB B.h f (k + 1) ξ := by
    intro f ξ k hq hf
    obtain ⟨a, ha⟩ : ∃ a : ℝ, a = qC B.h ξ ^ (B.h - 1/2) := ⟨_, rfl⟩
    have ha0 : 0 < a := by rw [ha]; exact Real.rpow_pos_of_pos hq _
    obtain ⟨w, hw⟩ : ∃ w : Cyl, w = (0, a, 0, 0) := ⟨_, rfl⟩
    have e0 : ∀ v : Cyl, (Lnorm B.h ξ v).1 = Real.sqrt (qC B.h ξ) * v.1 := by
      intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e1 : ∀ v : Cyl, (Lnorm B.h ξ v).2.1 = qC B.h ξ ^ (1/2 - B.h) * v.2.1 := by
      intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e2 : ∀ v : Cyl, (Lnorm B.h ξ v).2.2.1 = qC B.h ξ * v.2.2.1 := by
      intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e3 : ∀ v : Cyl, (Lnorm B.h ξ v).2.2.2 = JpowL (-(coarseIdx B.h (qC B.h ξ))) v.2.2.2 := by
      intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have hexp : qC B.h ξ ^ (1/2 - B.h) * a = 1 := by
      rw [ha, ← Real.rpow_add hq, show (1/2 - B.h) + (B.h - 1/2) = (0:ℝ) by ring, Real.rpow_zero]
    have hLw : Lnorm B.h ξ w = ((0, 1, 0, 0) : Cyl) := by
      refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
      · rw [e0, hw]; simp
      · rw [e1, hw]; exact hexp
      · rw [e2, hw]; simp
      · rw [e3, hw]; simp
    have hwn : ‖w‖ ≤ a := by
      rw [hw]
      simp only [Prod.norm_def, norm_zero, Real.norm_eq_abs, abs_of_pos ha0]
      simp [ha0.le]
    have hf' : ContDiffAt ℝ k (fderiv ℝ f) ξ := hf.fderiv_right (by exact_mod_cast le_top)
    have hdZf : dZ f = ⇑(ContinuousLinearMap.apply ℝ ℝ ((0, 1, 0, 0) : Cyl)) ∘ fderiv ℝ f := by
      funext η; rfl
    have hD : iteratedFDeriv ℝ k (dZ f) ξ =
        (ContinuousLinearMap.apply ℝ ℝ ((0, 1, 0, 0) : Cyl)).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fderiv ℝ f) ξ) := by
      rw [hdZf]
      exact (ContinuousLinearMap.apply ℝ ℝ ((0, 1, 0, 0) : Cyl)).iteratedFDeriv_comp_left hf' le_rfl
    unfold NB
    rw [← ha]
    refine ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg ha0.le (norm_nonneg _)) (fun v => ?_)
    have key : (iteratedFDeriv ℝ k (dZ f) ξ) (fun i => Lnorm B.h ξ (v i)) =
        (iteratedFDeriv ℝ (k + 1) f ξ) (fun i => Lnorm B.h ξ (Fin.snoc (α := fun _ => Cyl) v w i)) := by
      have hc : (fun i => Lnorm B.h ξ (Fin.snoc (α := fun _ => Cyl) v w i)) =
          Fin.snoc (α := fun _ => Cyl) (fun i => Lnorm B.h ξ (v i)) ((0, 1, 0, 0) : Cyl) := by
        rw [← hLw]
        exact Fin.comp_snoc (⇑(Lnorm B.h ξ)) v w
      rw [hc, iteratedFDeriv_succ_apply_right, Fin.init_snoc, Fin.snoc_last, hD]
      rfl
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, key]
    have h1 := ContinuousMultilinearMap.le_opNorm
      ((iteratedFDeriv ℝ (k + 1) f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ))
      (Fin.snoc (α := fun _ => Cyl) v w)
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, Fin.prod_univ_castSucc] at h1
    simp only [Fin.snoc_castSucc, Fin.snoc_last] at h1
    calc _ ≤ ‖(iteratedFDeriv ℝ (k + 1) f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ *
            ((∏ i, ‖v i‖) * ‖w‖) := h1
      _ ≤ ‖(iteratedFDeriv ℝ (k + 1) f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ *
            ((∏ i, ‖v i‖) * a) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left hwn (Finset.prod_nonneg (fun i _ => norm_nonneg _)))
            (norm_nonneg _)
      _ = a * ‖(iteratedFDeriv ℝ (k + 1) f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ *
            ∏ i, ‖v i‖ := by ring

  have hNBc : ∀ (g : ℝ →L[ℝ] ℝ) (f : Cyl → ℝ) (ξ : Cyl) (k : ℕ), ContDiffAt ℝ ∞ f ξ →
      NB B.h (fun η => g (f η)) k ξ ≤ ‖g‖ * NB B.h f k ξ := by
    intro g f ξ k hf
    unfold NB
    have e1 : iteratedFDeriv ℝ k (fun η => g (f η)) ξ =
        g.compContinuousMultilinearMap (iteratedFDeriv ℝ k f ξ) :=
      g.iteratedFDeriv_comp_left hf (by exact_mod_cast le_top)
    rw [e1]
    have e2 : (g.compContinuousMultilinearMap (iteratedFDeriv ℝ k f ξ)).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) =
        g.compContinuousMultilinearMap
          ((iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    exact g.norm_compContinuousMultilinearMap_le _
  have hfun : (fun η => Real.sqrt (qC B.h η)) = fun η => qC B.h η ^ (1/2:ℝ) :=
    funext (fun η => Real.sqrt_eq_rpow _)
  refine ⟨fun ξ hξ => ?_, fun k => ?_⟩
  · have hξU : ξ ∈ {η : Cyl | η.2.2.1 < 1} := hξ.2.1
    have hn := hUo.mem_nhds hξU
    refine ⟨?_, ?_⟩
    · rw [hfun]; exact hsU.contDiffAt hn
    · exact ((contDiffOn_const.mul hsU).mul (hdZU _ hlogU)).contDiffAt hn
  · obtain ⟨C1, hC1⟩ := hqpow B 1 (1/2) hok hSN one_pos le_rfl k
    obtain ⟨C2, hC2⟩ := hqpow B 1 (1/2) hok hSN one_pos le_rfl (k + 1)
    obtain ⟨g, hgdef⟩ : ∃ g : ℝ →L[ℝ] ℝ, g = (2 * B.h) • ContinuousLinearMap.id ℝ ℝ := ⟨_, rfl⟩
    refine ⟨max |C1| (‖g‖ * |C2|), fun ξ hξ => ?_⟩
    have hξU : ξ.2.2.1 < 1 := hξ.2.1
    have hn := hUo.mem_nhds (show ξ ∈ {η : Cyl | η.2.2.1 < 1} from hξU)
    have hξ1 : ξ ∈ DomC B.h 1 := ⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqs⟩
    have hq := hqpos ξ hξU
    have hq1 : qC B.h ξ ≤ 1 := (lt_of_lt_of_le hξ.2.2 hqs).le
    refine ⟨?_, ?_⟩
    · rw [hfun, Real.sqrt_eq_rpow]
      calc NB B.h (fun η => qC B.h η ^ (1/2:ℝ)) k ξ ≤ C1 * qC B.h ξ ^ (1/2:ℝ) := hC1 ξ hξ1
        _ ≤ |C1| * qC B.h ξ ^ (1/2:ℝ) :=
            mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hq.le _)
        _ ≤ max |C1| (‖g‖ * |C2|) * qC B.h ξ ^ (1/2:ℝ) :=
            mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.rpow_nonneg hq.le _)
    · have hev : (fun η => B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) η) =ᶠ[nhds ξ]
          (fun η => g (dZ (fun ζ => qC B.h ζ ^ (1/2:ℝ)) η)) :=
        Filter.eventuallyEq_of_mem hn (fun η hη => by
          rw [hid η hη, hgdef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply,
            smul_eq_mul])
      have hNBeq : NB B.h (fun η => B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) η) k ξ =
          NB B.h (fun η => g (dZ (fun ζ => qC B.h ζ ^ (1/2:ℝ)) η)) k ξ := by
        unfold NB
        rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      have hA := hshift (fun ζ => qC B.h ζ ^ (1/2:ℝ)) ξ k hq (hsU.contDiffAt hn)
      have hB := hC2 ξ hξ1
      have hgN := norm_nonneg g
      have hap : 0 ≤ qC B.h ξ ^ (B.h - 1/2) := Real.rpow_nonneg hq.le _
      have hqh : qC B.h ξ ^ (B.h - 1/2) * qC B.h ξ ^ (1/2:ℝ) = qC B.h ξ ^ B.h := by
        rw [← Real.rpow_add hq]; congr 1; ring
      have hqh1 : qC B.h ξ ^ B.h ≤ 1 := Real.rpow_le_one hq.le hq1 hh0.le
      have hqh0 : 0 ≤ qC B.h ξ ^ B.h := Real.rpow_nonneg hq.le _
      rw [hNBeq]
      calc NB B.h (fun η => g (dZ (fun ζ => qC B.h ζ ^ (1/2:ℝ)) η)) k ξ
          ≤ ‖g‖ * NB B.h (dZ (fun ζ => qC B.h ζ ^ (1/2:ℝ))) k ξ :=
            hNBc g _ ξ k ((hdZU _ hsU).contDiffAt hn)
        _ ≤ ‖g‖ * (qC B.h ξ ^ (B.h - 1/2) * (C2 * qC B.h ξ ^ (1/2:ℝ))) :=
            mul_le_mul_of_nonneg_left (hA.trans (mul_le_mul_of_nonneg_left hB hap)) hgN
        _ = ‖g‖ * C2 * qC B.h ξ ^ B.h := by rw [← hqh]; ring
        _ ≤ ‖g‖ * |C2| * 1 :=
            mul_le_mul (mul_le_mul_of_nonneg_left (le_abs_self C2) hgN) hqh1 hqh0
              (mul_nonneg hgN (abs_nonneg _))
        _ ≤ max |C1| (‖g‖ * |C2|) := by rw [mul_one]; exact le_max_right _ _

theorem wmo_amp_class_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    (∀ (c : WC) (β : ℝ), InWg5 B G (qsOf l0) (β + 1/2) c → InWg5 B G (qsOf l0) β (velW5 B G c) →
      InWg5 B G (qsOf l0) β (wmoAmp5 B G c)) ∧
    (∀ (c d : WC) (β1 β2 : ℝ), InWg5 B G (qsOf l0) β1 c → InWg5 B G (qsOf l0) β2 d →
      ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), wmoAmp5 B G (c + d) γ m ξ = wmoAmp5 B G c γ m ξ + wmoAmp5 B G d γ m ξ) :=
by
  intro B G hok hG
  obtain ⟨lp, hpsg⟩ := pulse_support_good_v5 B G hok hG
  refine ⟨lp, fun l0 hl0 => ?_⟩
  have hh0 : 0 < B.h := hok.2.1.1
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
