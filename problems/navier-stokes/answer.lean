      have hpos : ∀ n : ℕ, 0 < ε / 4 * (1 / ((n : ℝ) + 1)) := fun n => by positivity
      have hne : ∀ n : ℕ, ((ε / 4 * (1 / ((n : ℝ) + 1)) : ℝ) : ℂ) ≠ 0 := fun n =>
