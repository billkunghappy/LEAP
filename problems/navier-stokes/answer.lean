    refine ⟨hgi.congr_fun hpt.symm measurableSet_Ioi, ?_⟩
    rw [setIntegral_congr_fun measurableSet_Ioi hpt, integral_Ioi_rpow_of_lt (by norm_num) hc]
    rw [show (-2:ℝ) + 1 = -1 by norm_num, Real.rpow_neg_one, inv_inv]
    ring
  obtain ⟨hN, vN⟩ := near
  obtain ⟨hF, vF⟩ := far

  have hU : Ioc (0:ℝ) a⁻¹ ∪ Ioi a⁻¹ = Ioi 0 := Set.Ioc_union_Ioi_eq_Ioi (inv_nonneg.2 ha.le)
  have hI : IntegrableOn (fun y : ℝ => y ^ 2 * ((y⁻¹) ^ 3 * min 1 (a * y)) ^ ((4:ℝ)/3)) (Ioi 0) := by
    rw [← hU]; exact hN.union hF
  have hJ : ∫ y in Ioi (0:ℝ), y ^ 2 * ((y⁻¹) ^ 3 * min 1 (a * y)) ^ ((4:ℝ)/3) = 4 * a := by
    rw [← hU, setIntegral_union Set.Ioc_disjoint_Ioi_same measurableSet_Ioi hN hF, vN, vF]
