  have hnW : ∀ t : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhi5 B G γ η t) (U ∩ DomC B.h (qsOf l0)) :=
    fun t => (hn t).mono Set.inter_subset_left
  have hDW : ContDiffOn ℝ ∞ (fun η => dDamp5 B G γ η) (U ∩ DomC B.h (qsOf l0)) := by
    have e : (fun η => dDamp5 B G γ η) = fun η => (epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2) *
        (nPhi5 B G γ η 0 * nPhi5 B G γ η 0 + nPhi5 B G γ η 1 * nPhi5 B G γ η 1 +
          nPhi5 B G γ η 2 * nPhi5 B G γ η 2) := by
      funext η; simp only [dDamp5, dotProduct, Fin.sum_univ_three]
    rw [e]
    exact contDiffOn_const.mul ((((hnW 0).mul (hnW 0)).add ((hnW 1).mul (hnW 1))).add
      ((hnW 2).mul (hnW 2)))

  obtain ⟨μ, hμdef⟩ : ∃ μ : ℝ, μ = (m : ℝ) ^ 2 * (if i = j then (1:ℝ) else 0) := ⟨_, rfl⟩
  have hfe : ∀ η, prinMat5 B G γ m η i j =
      (qC B.h η / Qb γ.1) ^ (1 + B.h) * (1 * Kmat B G γ η i j + μ * dDamp5 B G γ η) := by
    intro η
    rw [hμdef]
    simp only [prinMat5, rhoQ, Matrix.smul_apply, Matrix.add_apply, Matrix.one_apply, smul_eq_mul]
    ring
  have hf : (fun η => prinMat5 B G γ m η i j) =
