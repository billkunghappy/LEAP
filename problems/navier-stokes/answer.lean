    have p1 := hlin _ _ (4/5) _ 1 1 _ _
      (fun ξ => dR B.h (dR B.h (mcor5 B G l0 S 0)) ξ + dR B.h (mcor5 B G l0 S 0) ξ / ξ.1)
      d1.1 d1.2.2.1 (by norm_num [hk]) (by norm_num [hk]) (fun ξ _ => by (try dsimp only); ring)
    have p2 := hlin _ _ (4/5) _ 1 1 _ _ (lap0 B.h (mcor5 B G l0 S 0))
      p1 d2.2.1 le_rfl (by norm_num [hk]) (fun ξ _ => by simp only [lap0]; ring)
    have p3 := hlin _ _ (4/5) _ 1 (-1) _ _
      (fun ξ => lap0 B.h (mcor5 B G l0 S 0) ξ - mcor5 B G l0 S 0 ξ / ξ.1 ^ 2)
