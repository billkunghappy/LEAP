      have e2 : (7/10 + ((0:ℕ):ℝ)/10 : ℝ) = 7/10 := by norm_num
      rw [e1, e2]
      exact hS0
    | succ j ih =>
      have e : (7/10 + ((j+1:ℕ):ℝ)/10 : ℝ) = 7/10 + (j:ℝ)/10 + 1/10 := by push_cast; ring
      rw [e]
      exact (hnxt (st j) (7/10 + (j:ℝ)/10) (by have := (Nat.cast_nonneg j : (0:ℝ) ≤ j); linarith) ih).1
  have hinc : ∀ i : ℕ, Incr5 B G l0 (st i) (st (i+1)) (7/10 + (i:ℝ)/10 - kapS) := fun i =>
    (hnxt (st i) (7/10 + (i:ℝ)/10) (by have := (Nat.cast_nonneg i : (0:ℝ) ≤ i); linarith) (hst i)).2
  have hM : ∀ j, MeanId5 B G l0 (st j) := fun j => h7 l0 (by omega) (st j) _ _ _ _ (hst j)
  have hP := fun j => H4 (st j) _ _ _ _ (hst j) (hM j)

  have htel : ∀ {X : Type} [AddCommGroup X] (f : ℕ → X) (J : ℕ),
