    obtain ⟨hax3, -⟩ := mode_curl_axis_v5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
      (fun η i => Complex.I * modeCoef5 B G (primState5 B G).Aw γ m η i) r z hok.1 ht hr (by rw [hY]; exact hICd)
    rw [hY] at hax1 hax2 hax3
    have hph := fun i => wmo_phase_deriv_v5 B G hok hG (qsOf l0) 1 (primState5 B G).Aw hqsB hAw γ m
      (r, z, t, Y) hξ' i
    have hamp := wmo_mode_amp_v5 B G (primState5 B G).Aw γ m (r, z, t, Y) hok hr ht (fun i => (hph i).1)
      (fun i => (hph i).2) a
    have hZ : ephase5 B G γ m θ (r, z, t, Y) =
        Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (r, z, t, Y) : ℂ))) *
          Complex.exp (((((m * pint5 B G γ : ℤ) : ℝ) * θ : ℝ) : ℂ) * Complex.I) := by
      simp only [ephase5]
      rw [← Complex.exp_add]
      congr 1
      push_cast
      ring
    rw [hrot _ _ _ _ _ _ r z hr hM1 hM2 Y a θ, hax1 a, hax3 a, hax2, hZ]
    exact key _ _ _ _ _ _ hamp

  have hq : 0 < qC B.h (r, z, t, Y) := hqpos _ hξ'
  have hqd : DifferentiableAt ℝ (qC B.h) ((r, z, t, Y) : Cyl) :=
    (hqCs.contDiffAt (hDopen.mem_nhds hξ')).differentiableAt (by norm_num)
  have hF := hqd.hasFDerivAt
  have hd1 : dZ (fun η => qC B.h η ^ (-B.h)) ((r, z, t, Y) : Cyl) =
      (-B.h * qC B.h (r, z, t, Y) ^ (-B.h - 1)) * dZ (qC B.h) ((r, z, t, Y) : Cyl) := by
    unfold dZ
    rw [(hF.rpow_const (p := -B.h) (Or.inl hq.ne')).fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hd2 : dZ (fun η => Real.log (qC B.h η)) ((r, z, t, Y) : Cyl) =
      (qC B.h (r, z, t, Y))⁻¹ * dZ (qC B.h) ((r, z, t, Y) : Cyl) := by
    unfold dZ
    rw [(hF.log hq.ne').fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hA : qC B.h (r, z, t, Y) ^ (-Aex B.h) * qC B.h (r, z, t, Y) ^ (1/2:ℝ) =
      qC B.h (r, z, t, Y) ^ (-B.h) := by
    rw [← Real.rpow_add hq]
    congr 1
    unfold Aex
    ring
  have hcoef : ∀ (γ : Lab) (m : ℤ) (i : Fin 3),
      ((qC B.h (r, z, t, Y) ^ (-Aex B.h) : ℝ) : ℂ) * wmoAmp5 B G (primState5 B G).Aw γ m (r, z, t, Y) i =
        pq5Vw B G γ m (r, z, t, Y) i := by
    intro γ m i
    have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
    have e1 : ((qC B.h (r, z, t, Y) ^ (-Aex B.h) : ℝ) : ℂ) *
        (((qC B.h (r, z, t, Y) / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ) =
        ((qC B.h (r, z, t, Y) ^ (-B.h) * Qb γ.1 ^ (-(1/2:ℝ)) : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul]
      congr 1
      rw [Real.div_rpow hq.le hQ.le, Real.rpow_neg hQ.le, div_eq_mul_inv, ← mul_assoc, hA]
    have e2 : ((qC B.h (r, z, t, Y) ^ (-Aex B.h) : ℝ) : ℂ) *
        ((B.h * qC B.h (r, z, t, Y) ^ (1/2:ℝ) * dZ (fun η => Real.log (qC B.h η)) ((r, z, t, Y) : Cyl) : ℝ) : ℂ) =
        -((dZ (fun η => qC B.h η ^ (-B.h)) ((r, z, t, Y) : Cyl) : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul, ← Complex.ofReal_neg]
      congr 1
      rw [hd1, hd2, Real.rpow_sub_one hq.ne']
      calc qC B.h (r, z, t, Y) ^ (-Aex B.h) *
            (B.h * qC B.h (r, z, t, Y) ^ (1/2:ℝ) * ((qC B.h (r, z, t, Y))⁻¹ * dZ (qC B.h) ((r, z, t, Y) : Cyl)))
          = B.h * (qC B.h (r, z, t, Y) ^ (-Aex B.h) * qC B.h (r, z, t, Y) ^ (1/2:ℝ)) *
              (qC B.h (r, z, t, Y))⁻¹ * dZ (qC B.h) ((r, z, t, Y) : Cyl) := by ring
        _ = _ := by rw [hA]; ring
    have hw : ∀ c : Fin 3 → ℂ, (![-(c 1), c 0, 0] : Fin 3 → ℂ) i = -(rotC c i) := by
      intro c
      fin_cases i <;> simp [rotC]
    simp only [wmoAmp5, pq5Vw, velW5, Pi.add_apply, Pi.smul_apply, smul_eq_mul, hw]
    linear_combination (velC5 B G (primState5 B G).Aw γ m (r, z, t, Y) i) * e1 +
      (rotC ((primState5 B G).Aw γ m (r, z, t, Y)) i) * e2

  have hP0 : ∀ (γ : Lab) (m : ℤ), ¬ (γ ∈ Γ ∧ m ∈ H) → pq5Vw B G γ m (r, z, t, Y) = 0 := by
    intro γ m hn
    have hev : (primState5 B G).Aw γ m =ᶠ[nhds ((r, z, t, Y) : Cyl)] fun _ => 0 := by
      filter_upwards [hNO] with η hη
      by_contra hne
      exact hn (hcov η hη γ m hne)
    have h0 : (primState5 B G).Aw γ m (r, z, t, Y) = 0 := hev.eq_of_nhds
    have hcomp : ∀ i : Fin 3, fderiv ℝ (fun η => (primState5 B G).Aw γ m η i) ((r, z, t, Y) : Cyl) = 0 := by
      intro i
      have h1 : (fun η => (primState5 B G).Aw γ m η i) =ᶠ[nhds ((r, z, t, Y) : Cyl)] fun _ => (0:ℂ) := by
        filter_upwards [hev] with η hη
        simp [hη]
      rw [h1.fderiv_eq]
      simp
    funext i
    fin_cases i <;> simp [pq5Vw, velW5, velC5, DrC, DzC, dR, dZ, h0, hcomp]

  have hwaveP : ∀ (θ : ℝ) (a : Fin 3), waveV5 B G (pq5Vw B G) θ (r, z, t, Y) a = ∑ γ ∈ Γ, ∑ m ∈ H,
      (pq5Vw B G γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y)).re := by
    intro θ a
    have hin : ∀ γ, ∑ᶠ m : ℤ, pq5Vw B G γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y) =
        ∑ m ∈ H, pq5Vw B G γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y) := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      rw [Function.support_subset_iff']
      intro m hm
      rw [hP0 γ m (fun hh => hm (Finset.mem_coe.mpr hh.2))]
      simp
    have hout : (Function.support fun γ => ∑ m ∈ H,
        pq5Vw B G γ m (r, z, t, Y) a * ephase5 B G γ m θ (r, z, t, Y)) ⊆ ↑Γ := by
      rw [Function.support_subset_iff']
      intro γ hγ
      apply Finset.sum_eq_zero
      intro m _
      rw [hP0 γ m (fun hh => hγ (Finset.mem_coe.mpr hh.1))]
      simp
    simp only [waveV5]
    rw [finsum_congr hin, finsum_eq_sum_of_support_subset _ hout, Complex.re_sum]
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [Complex.re_sum]

  have hn : ‖(⟨x 0, x 1⟩ : ℂ)‖ = rad x := by
    rw [Complex.norm_def, Complex.normSq_apply]
    show Real.sqrt (x 0 * x 0 + x 1 * x 1) = Real.sqrt (x 0 ^ 2 + x 1 ^ 2)
    ring_nf
  have hcs : rad x * Real.cos (thetaOf x) = x 0 := by
    have h := Complex.norm_mul_cos_arg (⟨x 0, x 1⟩ : ℂ)
    rw [hn] at h
    exact h
  have hsn : rad x * Real.sin (thetaOf x) = x 1 := by
    have h := Complex.norm_mul_sin_arg (⟨x 0, x 1⟩ : ℂ)
    rw [hn] at h
    exact h
  have hrotx0 : rotPt (rad x) (thetaOf x) (x 2) = x := by
    ext j
    fin_cases j <;> simp [rotPt, hcs, hsn]
  have hrotx : rotPt r (thetaOf x) z = x := by
    rw [← hrad, ← hx2]
    exact hrotx0
  have hr2 : rad x ^ 2 = x 0 ^ 2 + x 1 ^ 2 := Real.sq_sqrt (by positivity)
  have hinv : (rad x)⁻¹ ^ 2 * (x 0 ^ 2 + x 1 ^ 2) = 1 := by
    rw [← hr2]
    field_simp
  have hrec : ∀ v : ℝ³, cyl2cart x (fun a => inner ℝ v ((![eR x, eTh x, eZ] : Fin 3 → ℝ³) a)) = v := by
    intro v
    ext j
    fin_cases j
    · simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three]
      linear_combination (v 0) * hinv
    · simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three]
      linear_combination (v 1) * hinv
    · simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three]
  have hframe : (![eR x, eTh x, eZ] : Fin 3 → ℝ³) = frameAt (thetaOf x) ((r, z, t, Y) : Cyl) := by
    show _ = ![eR (rotPt r (thetaOf x) z), eTh (rotPt r (thetaOf x) z), eZ]
    rw [hrotx]

  have hcomp : ∀ a : Fin 3, inner ℝ (pwrW5 B G l0 x t Y) (frameAt (thetaOf x) ((r, z, t, Y) : Cyl) a) =
      waveV5 B G (pq5Vw B G) (thetaOf x) (r, z, t, Y) a := by
    intro a
    rw [hW, sum_inner, hwaveP (thetaOf x) a, Finset.sum_product]
    refine Finset.sum_congr rfl (fun γ _ => Finset.sum_congr rfl (fun m _ => ?_))
    dsimp only
    have hm := hmode (thetaOf x) a γ m
    rw [hrotx] at hm
    rw [hm, ← hcoef γ m a, mul_assoc, Complex.re_ofReal_mul]
  conv_lhs => rw [← hrec (pwrW5 B G l0 x t Y)]
  rw [hframe, hPξ]
  congr 1
  funext a
  exact hcomp a

theorem pq5_jet_R : ∀ (h t : ℝ) (Y0 : ℝ × ℝ) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (x : ℝ³), SimScaleProps h → t < 1 → 0 < rad x → DifferentiableAt ℝ c (ptOf x t (Yph h (rad x) t + Y0)) → fderiv ℝ (modeF5 h 0 t Y0 n c) x (eR x) = cyl2cart x (fun i => (dR h c (ptOf x t (Yph h (rad x) t + Y0)) i * Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re) :=
by
  intro h t Y0 n c x hS ht hr hc

  have hMd : DifferentiableAt ℝ (modeF5 h 0 t Y0 n c) x := by
    have hcoord : ∀ (i : Fin 3) (y : ℝ³), DifferentiableAt ℝ (fun w : ℝ³ => w i) y := by
      intro i y
      have h0 : DifferentiableAt ℝ (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) i) y :=
        ContinuousLinearMap.differentiableAt _
      rwa [EuclideanSpace.coe_proj] at h0
    have hradpos : 0 < x 0 ^ 2 + x 1 ^ 2 := Real.sqrt_pos.mp hr
    have hradD : DifferentiableAt ℝ rad x := by
      have h1 : DifferentiableAt ℝ (fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2) x :=
        ((hcoord 0 x).pow 2).add ((hcoord 1 x).pow 2)
      exact h1.sqrt hradpos.ne'
    have hinv : DifferentiableAt ℝ (fun y : ℝ³ => (rad y)⁻¹) x := hradD.inv hr.ne'
    have hq : DifferentiableAt ℝ (fun y : ℝ³ => qC h (ptOf y t (Yph h (rad y) t + Y0)) ^ (0:ℝ)) x := by
      have hSo' : (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) ∈ nhds (x 2, 1 - t) :=
        (isOpen_univ.prod isOpen_Ioi).mem_nhds ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩
      have hSd' : DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale h w.1 w.2) (x 2, 1 - t) :=
        (hS.2.2.2.1.contDiffAt hSo').differentiableAt (by simp)
      have hgd : DifferentiableAt ℝ (fun y : ℝ³ => (y 2, 1 - t)) x :=
        (hcoord 2 x).prodMk (differentiableAt_const _)
      have hcomp : DifferentiableAt ℝ (fun y : ℝ³ => simScale h (y 2) (1 - t)) x :=
        DifferentiableAt.comp (g := fun w : ℝ × ℝ => simScale h w.1 w.2)
          (f := fun y : ℝ³ => (y 2, 1 - t)) x hSd' hgd
      have hpos : simScale h (x 2) (1 - t) ≠ 0 := (hS.1 (x 2) (1 - t) (by linarith)).1.ne'
      exact hcomp.rpow_const (Or.inl hpos)
    have hP : DifferentiableAt ℝ (fun y : ℝ³ => ptOf y t (Yph h (rad y) t + Y0)) x := by
      have h4 : DifferentiableAt ℝ (fun y : ℝ³ => Yph h (rad y) t + Y0) x := by
        have h5 := ((hradD.rpow_const (p := drx h) (Or.inl hr.ne')).smul_const vrv).add_const (t • vtv)
        exact h5.add_const Y0
      exact hradD.prodMk ((hcoord 2 x).prodMk ((differentiableAt_const t).prodMk h4))
    have hnormAll : ∀ y : ℝ³, ‖(⟨y 0, y 1⟩ : ℂ)‖ = rad y := by
      intro y
      rw [Complex.norm_eq_sqrt_sq_add_sq]
      rfl
    have hE : DifferentiableAt ℝ
        (fun y : ℝ³ => Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))) x := by
      obtain ⟨g, hg⟩ : ∃ g : ℝ³ → ℂ, g = fun y => ((rad y)⁻¹ : ℝ) • (⟨y 0, y 1⟩ : ℂ) := ⟨_, rfl⟩
      have hz : DifferentiableAt ℝ (fun y : ℝ³ => (⟨y 0, y 1⟩ : ℂ)) x := by
        have e1 : (fun y : ℝ³ => (⟨y 0, y 1⟩ : ℂ)) =
            fun y => Complex.ofRealCLM (y 0) + Complex.ofRealCLM (y 1) * Complex.I := by
          funext y
          rw [Complex.mk_eq_add_mul_I]
          simp
        rw [e1]
        exact (Complex.ofRealCLM.differentiableAt.comp x (hcoord 0 x)).add
          ((Complex.ofRealCLM.differentiableAt.comp x (hcoord 1 x)).mul_const Complex.I)
      have hgD : DifferentiableAt ℝ g x := by
        rw [hg]
        exact hinv.smul hz
      have hgx : g x ≠ 0 := by
        rw [hg]
        refine smul_ne_zero (inv_ne_zero hr.ne') ?_
        intro h0
        have h1 := hnormAll x
        rw [h0, norm_zero] at h1
        linarith
      have hpow : DifferentiableAt ℂ (fun u : ℂ => u ^ n) (g x) :=
        differentiableAt_zpow.mpr (Or.inl hgx)
      have hG : DifferentiableAt ℝ (fun y => g y ^ n) x := (hpow.restrictScalars ℝ).comp x hgD
      refine hG.congr_of_eventuallyEq ?_
      filter_upwards [hradD.continuousAt (Ioi_mem_nhds hr)] with y hy
      have hy' : 0 < rad y := hy
      have hne : ((rad y : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hy'.ne'
      have key := Complex.norm_mul_exp_arg_mul_I (⟨y 0, y 1⟩ : ℂ)
      rw [hnormAll y] at key
      have hexp : Complex.exp (((thetaOf y : ℝ) : ℂ) * Complex.I) = g y := by
        rw [hg]
        show _ = ((rad y)⁻¹ : ℝ) • (⟨y 0, y 1⟩ : ℂ)
        rw [Complex.real_smul, Complex.ofReal_inv, eq_inv_mul_iff_mul_eq₀ hne]
        exact key
      calc Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))
          = Complex.exp ((n : ℂ) * ((thetaOf y : ℂ) * Complex.I)) := by
            congr 1
            ring
        _ = Complex.exp ((thetaOf y : ℂ) * Complex.I) ^ n := Complex.exp_int_mul _ _
        _ = g y ^ n := by rw [hexp]
    have hcP : DifferentiableAt ℝ (fun y : ℝ³ => c (ptOf y t (Yph h (rad y) t + Y0))) x :=
      hc.comp x hP
    have hv : ∀ i : Fin 3, DifferentiableAt ℝ (fun y : ℝ³ =>
        (c (ptOf y t (Yph h (rad y) t + Y0)) i *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re) x := by
      intro i
      have h1 : DifferentiableAt ℝ (fun y : ℝ³ => c (ptOf y t (Yph h (rad y) t + Y0)) i) x :=
        differentiableAt_pi.1 hcP i
      have h2 := h1.mul hE
      exact Complex.reCLM.differentiableAt.comp x h2
    have heR : DifferentiableAt ℝ eR x := by
      have h1 : DifferentiableAt ℝ radVec x :=
        ((hcoord 0 x).smul_const _).add ((hcoord 1 x).smul_const _)
      exact hinv.smul h1
    have heTh : DifferentiableAt ℝ eTh x := by
      have h1 : DifferentiableAt ℝ azVec x :=
        ((hcoord 1 x).neg.smul_const _).add ((hcoord 0 x).smul_const _)
      exact hinv.smul h1
    have hcyl : DifferentiableAt ℝ (fun y : ℝ³ => cyl2cart y (fun i =>
        (c (ptOf y t (Yph h (rad y) t + Y0)) i *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re)) x :=
      (((hv 0).smul heR).add ((hv 1).smul heTh)).add ((hv 2).smul_const eZ)
    exact hq.smul hcyl

  obtain ⟨ξ0, hξ0⟩ : ∃ ξ0 : Cyl, ξ0 = ptOf x t (Yph h (rad x) t + Y0) := ⟨_, rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : ℂ, E = Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ)) := ⟨_, rfl⟩
  rw [← hξ0] at hc ⊢
  rw [← hE]

  obtain ⟨γ, hγ⟩ : ∃ γ : ℝ → ℝ³, γ = fun s => x + s • eR x := ⟨_, rfl⟩
  have hγk : ∀ (s : ℝ) (k : Fin 3), γ s k = x k + s * eR x k := by
    intro s k; rw [hγ]; simp
  have heR0 : eR x 0 = (rad x)⁻¹ * x 0 := by simp [eR, radVec]
  have heR1 : eR x 1 = (rad x)⁻¹ * x 1 := by simp [eR, radVec]
  have heR2 : eR x 2 = 0 := by simp [eR, radVec]
  obtain ⟨lam, hlam⟩ : ∃ lam : ℝ → ℝ, ∀ s, lam s = 1 + s * (rad x)⁻¹ := ⟨_, fun _ => rfl⟩
  have hlam' : ∀ s, lam s = (rad x + s) * (rad x)⁻¹ := by
    intro s; rw [hlam, add_mul, mul_inv_cancel₀ hr.ne']
  have hlpos : ∀ s, -rad x < s → 0 < lam s := by
    intro s hs; rw [hlam']; exact mul_pos (by linarith) (inv_pos.mpr hr)
  have hlr : ∀ s, lam s * rad x = rad x + s := by
    intro s; rw [hlam', mul_assoc, inv_mul_cancel₀ hr.ne', mul_one]
  have hγ0 : ∀ s, γ s 0 = lam s * x 0 := by intro s; rw [hγk, heR0, hlam]; ring
  have hγ1 : ∀ s, γ s 1 = lam s * x 1 := by intro s; rw [hγk, heR1, hlam]; ring
  have hγ2 : ∀ s, γ s 2 = x 2 := by intro s; rw [hγk, heR2]; ring
  have hx01 : x 0 ^ 2 + x 1 ^ 2 = rad x ^ 2 :=
    (Real.sq_sqrt (by positivity : (0:ℝ) ≤ x 0 ^ 2 + x 1 ^ 2)).symm

  have hrad_s : ∀ s, -rad x < s → rad (γ s) = rad x + s := by
    intro s hs
    have e : γ s 0 ^ 2 + γ s 1 ^ 2 = (rad x + s) ^ 2 := by
      rw [hγ0, hγ1, ← hlr s]
      linear_combination (lam s) ^ 2 * hx01
    show Real.sqrt (γ s 0 ^ 2 + γ s 1 ^ 2) = rad x + s
    rw [e, Real.sqrt_sq (by linarith)]
  have hth_s : ∀ s, -rad x < s → thetaOf (γ s) = thetaOf x := by
    intro s hs
    have e : (⟨γ s 0, γ s 1⟩ : ℂ) = ((lam s : ℝ) : ℂ) * ⟨x 0, x 1⟩ := by
      apply Complex.ext <;> simp [hγ0, hγ1]
    show Complex.arg (⟨γ s 0, γ s 1⟩ : ℂ) = Complex.arg (⟨x 0, x 1⟩ : ℂ)
    rw [e, Complex.arg_real_mul _ (hlpos s hs)]
  have hcyl_s : ∀ s, -rad x < s → ∀ w : Fin 3 → ℝ, cyl2cart (γ s) w = cyl2cart x w := by
    intro s hs w
    have hk : (rad x + s)⁻¹ * lam s = (rad x)⁻¹ := by
      rw [hlam' s, inv_mul_cancel_left₀ (show (0:ℝ) < rad x + s by linarith).ne']
    have hrv : radVec (γ s) = lam s • radVec x := by
      simp only [radVec, hγ0, hγ1, smul_add, smul_smul]
    have hav : azVec (γ s) = lam s • azVec x := by
      simp only [azVec, hγ0, hγ1, smul_add, smul_smul, mul_neg]
    have heRs : eR (γ s) = eR x := by
      show (rad (γ s))⁻¹ • radVec (γ s) = (rad x)⁻¹ • radVec x
      rw [hrad_s s hs, hrv, smul_smul, hk]
    have heThs : eTh (γ s) = eTh x := by
      show (rad (γ s))⁻¹ • azVec (γ s) = (rad x)⁻¹ • azVec x
      rw [hrad_s s hs, hav, smul_smul, hk]
    simp only [cyl2cart, heRs, heThs]

  obtain ⟨g, hg⟩ : ∃ g : ℝ → Cyl, g = fun s => (rad x + s, x 2, t, Yph h (rad x + s) t + Y0) :=
    ⟨_, rfl⟩
  have hpt : ∀ s, -rad x < s → ptOf (γ s) t (Yph h (rad (γ s)) t + Y0) = g s := by
    intro s hs
    rw [hg]
    simp only [ptOf, hrad_s s hs, hγ2]
  have hg0 : ξ0 = g 0 := by
    rw [hξ0, hg]
    simp only [ptOf, add_zero]

  have hEq : ∀ s, -rad x < s → modeF5 h 0 t Y0 n c (γ s) =
      cyl2cart x (fun i => (c (g s) i * E).re) := by
    intro s hs
    unfold modeF5
    rw [hpt s hs, hth_s s hs, ← hE, hcyl_s s hs, Real.rpow_zero, one_smul]

  have hρ : HasDerivAt (fun s : ℝ => rad x + s) 1 0 := (hasDerivAt_id' (0:ℝ)).const_add (rad x)
  have hρp := hρ.rpow_const (p := drx h) (Or.inl (by rw [add_zero]; exact hr.ne'))
  have hY := ((hρp.smul_const vrv).add_const (t • vtv)).add_const Y0
  have hgd := hρ.prodMk ((hasDerivAt_const (0:ℝ) (x 2)).prodMk ((hasDerivAt_const (0:ℝ) t).prodMk hY))
  have hgw : HasDerivAt g ((1:ℝ), (0:ℝ), (0:ℝ), (drx h * ξ0.1 ^ (drx h - 1)) • vrv) 0 := by
    rw [hg]
    refine hgd.congr_deriv ?_
    rw [hξ0]
    simp [ptOf]
  have hcg := hc.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hgw hg0
  have ha : ∀ i : Fin 3, HasDerivAt (fun s => (c (g s) i * E).re) ((dR h c ξ0 i * E).re) 0 := by
    intro i
    have h1 := Complex.reCLM.hasFDerivAt.comp_hasDerivAt (0:ℝ) ((hasDerivAt_pi.1 hcg i).mul_const E)
    rw [Complex.reCLM_apply] at h1
    refine h1.congr_of_eventuallyEq (Filter.Eventually.of_forall fun s => ?_)
    simp only [Function.comp_apply, Complex.reCLM_apply]
  have hR : HasDerivAt (fun s => cyl2cart x (fun i => (c (g s) i * E).re))
      (cyl2cart x (fun i => (dR h c ξ0 i * E).re)) 0 :=
    (((ha 0).smul_const (eR x)).add ((ha 1).smul_const (eTh x))).add ((ha 2).smul_const eZ)

  have hγl : HasDerivAt γ (eR x) 0 := by
    rw [hγ]
    exact (((hasDerivAt_id' (0:ℝ)).smul_const (eR x)).const_add x).congr_deriv (one_smul ℝ _)
  have hγ0x : x = γ 0 := by rw [hγ]; simp
  have hline := hMd.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hγl hγ0x
  have hR' : HasDerivAt ((modeF5 h 0 t Y0 n c) ∘ γ) (cyl2cart x (fun i => (dR h c ξ0 i * E).re)) 0 := by
    refine hR.congr_of_eventuallyEq ?_
    filter_upwards [Ioi_mem_nhds (show -rad x < (0:ℝ) by linarith)] with s hs
    exact hEq s hs
  exact hline.unique hR'

theorem pq5_jet_Z : ∀ (h t : ℝ) (Y0 : ℝ × ℝ) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (x : ℝ³), SimScaleProps h → t < 1 → 0 < rad x → DifferentiableAt ℝ c (ptOf x t (Yph h (rad x) t + Y0)) → fderiv ℝ (modeF5 h 0 t Y0 n c) x eZ = cyl2cart x (fun i => (dZ c (ptOf x t (Yph h (rad x) t + Y0)) i * Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re) :=
by
  intro h t Y0 n c x hS ht hr hc
  have hFd : DifferentiableAt ℝ (modeF5 h 0 t Y0 n c) x := by
    have hcoord : ∀ (i : Fin 3) (y : ℝ³), DifferentiableAt ℝ (fun w : ℝ³ => w i) y := by
      intro i y
      have h0 : DifferentiableAt ℝ (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) i) y :=
        ContinuousLinearMap.differentiableAt _
      rwa [EuclideanSpace.coe_proj] at h0
    have hradpos : 0 < x 0 ^ 2 + x 1 ^ 2 := Real.sqrt_pos.mp hr
    have hradD : DifferentiableAt ℝ rad x := by
      have h1 : DifferentiableAt ℝ (fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2) x :=
        ((hcoord 0 x).pow 2).add ((hcoord 1 x).pow 2)
      exact h1.sqrt hradpos.ne'
    have hinv : DifferentiableAt ℝ (fun y : ℝ³ => (rad y)⁻¹) x := hradD.inv hr.ne'
    have hq : DifferentiableAt ℝ (fun y : ℝ³ => qC h (ptOf y t (Yph h (rad y) t + Y0)) ^ (0:ℝ)) x := by
      simp only [Real.rpow_zero]
      exact differentiableAt_const _
    have hP : DifferentiableAt ℝ (fun y : ℝ³ => ptOf y t (Yph h (rad y) t + Y0)) x := by
      have h4 : DifferentiableAt ℝ (fun y : ℝ³ => Yph h (rad y) t + Y0) x := by
        have h5 := ((hradD.rpow_const (p := drx h) (Or.inl hr.ne')).smul_const vrv).add_const (t • vtv)
        exact h5.add_const Y0
      exact hradD.prodMk ((hcoord 2 x).prodMk ((differentiableAt_const t).prodMk h4))
    have hnormAll : ∀ y : ℝ³, ‖(⟨y 0, y 1⟩ : ℂ)‖ = rad y := by
      intro y
      rw [Complex.norm_eq_sqrt_sq_add_sq]
      rfl
    have hE : DifferentiableAt ℝ
        (fun y : ℝ³ => Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))) x := by
      obtain ⟨g, hg⟩ : ∃ g : ℝ³ → ℂ, g = fun y => ((rad y)⁻¹ : ℝ) • (⟨y 0, y 1⟩ : ℂ) := ⟨_, rfl⟩
      have hz : DifferentiableAt ℝ (fun y : ℝ³ => (⟨y 0, y 1⟩ : ℂ)) x := by
        have e1 : (fun y : ℝ³ => (⟨y 0, y 1⟩ : ℂ)) =
            fun y => Complex.ofRealCLM (y 0) + Complex.ofRealCLM (y 1) * Complex.I := by
          funext y
          rw [Complex.mk_eq_add_mul_I]
          simp
        rw [e1]
        exact (Complex.ofRealCLM.differentiableAt.comp x (hcoord 0 x)).add
          ((Complex.ofRealCLM.differentiableAt.comp x (hcoord 1 x)).mul_const Complex.I)
      have hgD : DifferentiableAt ℝ g x := by
        rw [hg]
        exact hinv.smul hz
      have hgx : g x ≠ 0 := by
        rw [hg]
        refine smul_ne_zero (inv_ne_zero hr.ne') ?_
        intro h0
        have h1 := hnormAll x
        rw [h0, norm_zero] at h1
        linarith
      have hpow : DifferentiableAt ℂ (fun u : ℂ => u ^ n) (g x) :=
        differentiableAt_zpow.mpr (Or.inl hgx)
      have hG : DifferentiableAt ℝ (fun y => g y ^ n) x := (hpow.restrictScalars ℝ).comp x hgD
      refine hG.congr_of_eventuallyEq ?_
      filter_upwards [hradD.continuousAt (Ioi_mem_nhds hr)] with y hy
      have hy' : 0 < rad y := hy
      have hne : ((rad y : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hy'.ne'
      have key := Complex.norm_mul_exp_arg_mul_I (⟨y 0, y 1⟩ : ℂ)
      rw [hnormAll y] at key
      have hexp : Complex.exp (((thetaOf y : ℝ) : ℂ) * Complex.I) = g y := by
        rw [hg]
        show _ = ((rad y)⁻¹ : ℝ) • (⟨y 0, y 1⟩ : ℂ)
        rw [Complex.real_smul, Complex.ofReal_inv, eq_inv_mul_iff_mul_eq₀ hne]
        exact key
      calc Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))
          = Complex.exp ((n : ℂ) * ((thetaOf y : ℂ) * Complex.I)) := by
            congr 1
            ring
        _ = Complex.exp ((thetaOf y : ℂ) * Complex.I) ^ n := Complex.exp_int_mul _ _
        _ = g y ^ n := by rw [hexp]
    have hcP : DifferentiableAt ℝ (fun y : ℝ³ => c (ptOf y t (Yph h (rad y) t + Y0))) x :=
      hc.comp x hP
    have hv : ∀ i : Fin 3, DifferentiableAt ℝ (fun y : ℝ³ =>
        (c (ptOf y t (Yph h (rad y) t + Y0)) i *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re) x := by
      intro i
      have h1 : DifferentiableAt ℝ (fun y : ℝ³ => c (ptOf y t (Yph h (rad y) t + Y0)) i) x :=
        differentiableAt_pi.1 hcP i
      have h2 := h1.mul hE
      exact Complex.reCLM.differentiableAt.comp x h2
    have heR : DifferentiableAt ℝ eR x := by
      have h1 : DifferentiableAt ℝ radVec x :=
        ((hcoord 0 x).smul_const _).add ((hcoord 1 x).smul_const _)
      exact hinv.smul h1
    have heTh : DifferentiableAt ℝ eTh x := by
      have h1 : DifferentiableAt ℝ azVec x :=
        ((hcoord 1 x).neg.smul_const _).add ((hcoord 0 x).smul_const _)
      exact hinv.smul h1
    have hcyl : DifferentiableAt ℝ (fun y : ℝ³ => cyl2cart y (fun i =>
        (c (ptOf y t (Yph h (rad y) t + Y0)) i *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re)) x :=
      (((hv 0).smul heR).add ((hv 1).smul heTh)).add ((hv 2).smul_const eZ)
    exact hq.smul hcyl
  have hγk : ∀ (s : ℝ) (k : Fin 3), (x + s • eZ) k = x k + s * eZ k := by
    intro s k; simp
  have hz0 : eZ 0 = 0 := by simp [eZ]
  have hz1 : eZ 1 = 0 := by simp [eZ]
  have hz2 : eZ 2 = 1 := by simp [eZ]
  have hγ0 : ∀ s : ℝ, (x + s • eZ) 0 = x 0 := by intro s; rw [hγk, hz0]; ring
  have hγ1 : ∀ s : ℝ, (x + s • eZ) 1 = x 1 := by intro s; rw [hγk, hz1]; ring
  have hγ2 : ∀ s : ℝ, (x + s • eZ) 2 = x 2 + s := by intro s; rw [hγk, hz2]; ring
  have hrad : ∀ s : ℝ, rad (x + s • eZ) = rad x := by
    intro s; simp only [rad, hγ0, hγ1]
  have hth : ∀ s : ℝ, thetaOf (x + s • eZ) = thetaOf x := by
    intro s; simp only [thetaOf, hγ0, hγ1]
  have heR : ∀ s : ℝ, eR (x + s • eZ) = eR x := by
    intro s; simp only [eR, radVec, hrad, hγ0, hγ1]
  have heTh : ∀ s : ℝ, eTh (x + s • eZ) = eTh x := by
    intro s; simp only [eTh, azVec, hrad, hγ0, hγ1]
  have hpt : ∀ s : ℝ, ptOf (x + s • eZ) t (Yph h (rad x) t + Y0) =
      ptOf x t (Yph h (rad x) t + Y0) + s • ((0:ℝ), (1:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ))) := by
    intro s
    simp only [ptOf, hrad, hγ2]
    simp
  have hFγ : ∀ s : ℝ, modeF5 h 0 t Y0 n c (x + s • eZ) =
      (c (ptOf x t (Yph h (rad x) t + Y0) + s • ((0:ℝ), (1:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ)))) 0 *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re • eR x +
      (c (ptOf x t (Yph h (rad x) t + Y0) + s • ((0:ℝ), (1:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ)))) 1 *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re • eTh x +
      (c (ptOf x t (Yph h (rad x) t + Y0) + s • ((0:ℝ), (1:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ)))) 2 *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re • eZ := by
    intro s
    simp only [modeF5]
    rw [hrad, hpt, hth, Real.rpow_zero, one_smul]
    simp only [cyl2cart, heR, heTh]
  have hl : HasDerivAt (fun s : ℝ => ptOf x t (Yph h (rad x) t + Y0) +
      s • ((0:ℝ), (1:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ)))) ((0:ℝ), (1:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ))) 0 :=
    (((hasDerivAt_id' (0:ℝ)).smul_const _).const_add _).congr_deriv (one_smul ℝ _)
  have hcl := hc.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hl (by simp)
  have hgi : ∀ i : Fin 3, HasDerivAt (fun s : ℝ =>
      (c (ptOf x t (Yph h (rad x) t + Y0) + s • ((0:ℝ), (1:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ)))) i *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re)
      ((dZ c (ptOf x t (Yph h (rad x) t + Y0)) i *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re) 0 := by
    intro i
    have h1 : HasDerivAt (fun s : ℝ =>
        c (ptOf x t (Yph h (rad x) t + Y0) + s • ((0:ℝ), (1:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ)))) i)
        (dZ c (ptOf x t (Yph h (rad x) t + Y0)) i) 0 := hasDerivAt_pi.1 hcl i
    have h2 := Complex.reCLM.hasFDerivAt.comp_hasDerivAt (0:ℝ)
      (h1.mul_const (Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))))
    simp only [Complex.reCLM_apply, Function.comp_def] at h2
    exact h2
  have hγl : HasDerivAt (fun s : ℝ => x + s • eZ) eZ 0 :=
    (((hasDerivAt_id' (0:ℝ)).smul_const eZ).const_add x).congr_deriv (one_smul ℝ eZ)
  have hF1 := hFd.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hγl (by simp)
  have hF2 : HasDerivAt (fun s : ℝ => modeF5 h 0 t Y0 n c (x + s • eZ))
      (cyl2cart x (fun i => (dZ c (ptOf x t (Yph h (rad x) t + Y0)) i *
        Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re)) 0 := by
    rw [funext hFγ]
    exact (((hgi 0).smul_const (eR x)).add ((hgi 1).smul_const (eTh x))).add ((hgi 2).smul_const eZ)
  exact hF1.unique hF2

theorem pq5_jet_Th : ∀ (h t : ℝ) (Y0 : ℝ × ℝ) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (x : ℝ³), SimScaleProps h → t < 1 → 0 < rad x → DifferentiableAt ℝ c (ptOf x t (Yph h (rad x) t + Y0)) → fderiv ℝ (modeF5 h 0 t Y0 n c) x (eTh x) = cyl2cart x (fun i => (![Complex.I * (n : ℂ) / ((rad x : ℝ) : ℂ) * c (ptOf x t (Yph h (rad x) t + Y0)) 0 - c (ptOf x t (Yph h (rad x) t + Y0)) 1 / ((rad x : ℝ) : ℂ), Complex.I * (n : ℂ) / ((rad x : ℝ) : ℂ) * c (ptOf x t (Yph h (rad x) t + Y0)) 1 + c (ptOf x t (Yph h (rad x) t + Y0)) 0 / ((rad x : ℝ) : ℂ), Complex.I * (n : ℂ) / ((rad x : ℝ) : ℂ) * c (ptOf x t (Yph h (rad x) t + Y0)) 2] i * Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re) :=
by
  intro h t Y0 n c x hS ht hr hc

  have hMd : DifferentiableAt ℝ (modeF5 h 0 t Y0 n c) x := by
    have hcoord : ∀ (i : Fin 3) (y : ℝ³), DifferentiableAt ℝ (fun w : ℝ³ => w i) y := by
      intro i y
      have h0 : DifferentiableAt ℝ (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) i) y :=
        ContinuousLinearMap.differentiableAt _
      rwa [EuclideanSpace.coe_proj] at h0
    have hradpos : 0 < x 0 ^ 2 + x 1 ^ 2 := Real.sqrt_pos.mp hr
    have hradD : DifferentiableAt ℝ rad x := by
      have h1 : DifferentiableAt ℝ (fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2) x :=
        ((hcoord 0 x).pow 2).add ((hcoord 1 x).pow 2)
      exact h1.sqrt hradpos.ne'
    have hinv : DifferentiableAt ℝ (fun y : ℝ³ => (rad y)⁻¹) x := hradD.inv hr.ne'
    have hq : DifferentiableAt ℝ (fun y : ℝ³ => qC h (ptOf y t (Yph h (rad y) t + Y0)) ^ (0:ℝ)) x := by
      have hSo' : (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) ∈ nhds (x 2, 1 - t) :=
        (isOpen_univ.prod isOpen_Ioi).mem_nhds ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩
      have hSd' : DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale h w.1 w.2) (x 2, 1 - t) :=
        (hS.2.2.2.1.contDiffAt hSo').differentiableAt (by simp)
      have hgd : DifferentiableAt ℝ (fun y : ℝ³ => (y 2, 1 - t)) x :=
        (hcoord 2 x).prodMk (differentiableAt_const _)
      have hcomp : DifferentiableAt ℝ (fun y : ℝ³ => simScale h (y 2) (1 - t)) x :=
        DifferentiableAt.comp (g := fun w : ℝ × ℝ => simScale h w.1 w.2)
          (f := fun y : ℝ³ => (y 2, 1 - t)) x hSd' hgd
      have hpos : simScale h (x 2) (1 - t) ≠ 0 := (hS.1 (x 2) (1 - t) (by linarith)).1.ne'
      exact hcomp.rpow_const (Or.inl hpos)
    have hP : DifferentiableAt ℝ (fun y : ℝ³ => ptOf y t (Yph h (rad y) t + Y0)) x := by
      have h4 : DifferentiableAt ℝ (fun y : ℝ³ => Yph h (rad y) t + Y0) x := by
        have h5 := ((hradD.rpow_const (p := drx h) (Or.inl hr.ne')).smul_const vrv).add_const (t • vtv)
        exact h5.add_const Y0
      exact hradD.prodMk ((hcoord 2 x).prodMk ((differentiableAt_const t).prodMk h4))
    have hnormAll : ∀ y : ℝ³, ‖(⟨y 0, y 1⟩ : ℂ)‖ = rad y := by
      intro y
      rw [Complex.norm_eq_sqrt_sq_add_sq]
      rfl
    have hE : DifferentiableAt ℝ
        (fun y : ℝ³ => Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))) x := by
      obtain ⟨g, hg⟩ : ∃ g : ℝ³ → ℂ, g = fun y => ((rad y)⁻¹ : ℝ) • (⟨y 0, y 1⟩ : ℂ) := ⟨_, rfl⟩
      have hz : DifferentiableAt ℝ (fun y : ℝ³ => (⟨y 0, y 1⟩ : ℂ)) x := by
        have e1 : (fun y : ℝ³ => (⟨y 0, y 1⟩ : ℂ)) =
            fun y => Complex.ofRealCLM (y 0) + Complex.ofRealCLM (y 1) * Complex.I := by
          funext y
          rw [Complex.mk_eq_add_mul_I]
          simp
        rw [e1]
        exact (Complex.ofRealCLM.differentiableAt.comp x (hcoord 0 x)).add
          ((Complex.ofRealCLM.differentiableAt.comp x (hcoord 1 x)).mul_const Complex.I)
      have hgD : DifferentiableAt ℝ g x := by
        rw [hg]
        exact hinv.smul hz
      have hgx : g x ≠ 0 := by
        rw [hg]
        refine smul_ne_zero (inv_ne_zero hr.ne') ?_
        intro h0
        have h1 := hnormAll x
        rw [h0, norm_zero] at h1
        linarith
      have hpow : DifferentiableAt ℂ (fun u : ℂ => u ^ n) (g x) :=
        differentiableAt_zpow.mpr (Or.inl hgx)
      have hG : DifferentiableAt ℝ (fun y => g y ^ n) x := (hpow.restrictScalars ℝ).comp x hgD
      refine hG.congr_of_eventuallyEq ?_
      filter_upwards [hradD.continuousAt (Ioi_mem_nhds hr)] with y hy
      have hy' : 0 < rad y := hy
      have hne : ((rad y : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hy'.ne'
      have key := Complex.norm_mul_exp_arg_mul_I (⟨y 0, y 1⟩ : ℂ)
      rw [hnormAll y] at key
      have hexp : Complex.exp (((thetaOf y : ℝ) : ℂ) * Complex.I) = g y := by
        rw [hg]
        show _ = ((rad y)⁻¹ : ℝ) • (⟨y 0, y 1⟩ : ℂ)
        rw [Complex.real_smul, Complex.ofReal_inv, eq_inv_mul_iff_mul_eq₀ hne]
        exact key
      calc Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))
          = Complex.exp ((n : ℂ) * ((thetaOf y : ℂ) * Complex.I)) := by
            congr 1
            ring
        _ = Complex.exp ((thetaOf y : ℂ) * Complex.I) ^ n := Complex.exp_int_mul _ _
        _ = g y ^ n := by rw [hexp]
    have hcP : DifferentiableAt ℝ (fun y : ℝ³ => c (ptOf y t (Yph h (rad y) t + Y0))) x :=
      hc.comp x hP
    have hv : ∀ i : Fin 3, DifferentiableAt ℝ (fun y : ℝ³ =>
        (c (ptOf y t (Yph h (rad y) t + Y0)) i *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re) x := by
      intro i
      have h1 : DifferentiableAt ℝ (fun y : ℝ³ => c (ptOf y t (Yph h (rad y) t + Y0)) i) x :=
        differentiableAt_pi.1 hcP i
      have h2 := h1.mul hE
      exact Complex.reCLM.differentiableAt.comp x h2
    have heR : DifferentiableAt ℝ eR x := by
      have h1 : DifferentiableAt ℝ radVec x :=
        ((hcoord 0 x).smul_const _).add ((hcoord 1 x).smul_const _)
      exact hinv.smul h1
    have heTh : DifferentiableAt ℝ eTh x := by
      have h1 : DifferentiableAt ℝ azVec x :=
        ((hcoord 1 x).neg.smul_const _).add ((hcoord 0 x).smul_const _)
      exact hinv.smul h1
    have hcyl : DifferentiableAt ℝ (fun y : ℝ³ => cyl2cart y (fun i =>
        (c (ptOf y t (Yph h (rad y) t + Y0)) i *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re)) x :=
      (((hv 0).smul heR).add ((hv 1).smul heTh)).add ((hv 2).smul_const eZ)
    exact hq.smul hcyl
  have hr0 : rad x ≠ 0 := hr.ne'

  obtain ⟨ξ0, hξ0⟩ : ∃ ξ0 : Cyl, ξ0 = ptOf x t (Yph h (rad x) t + Y0) := ⟨_, rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : ℂ, E = Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ)) := ⟨_, rfl⟩
  obtain ⟨K, hK⟩ : ∃ K : ℂ, K = Complex.I * (n : ℂ) / ((rad x : ℝ) : ℂ) := ⟨_, rfl⟩
  rw [← hξ0] at hc ⊢
  rw [← hE, ← hK]

  obtain ⟨γ, hγ⟩ : ∃ γ : ℝ → ℝ³, γ = fun s => x + s • eTh x := ⟨_, rfl⟩
  have hγk : ∀ (s : ℝ) (k : Fin 3), γ s k = x k + s * eTh x k := by
    intro s k; rw [hγ]; simp
  have heT0 : eTh x 0 = (rad x)⁻¹ * -(x 1) := by simp [eTh, azVec]
  have heT1 : eTh x 1 = (rad x)⁻¹ * x 0 := by simp [eTh, azVec]
  have heT2 : eTh x 2 = 0 := by simp [eTh, azVec]
  have hγ0 : ∀ s, γ s 0 = x 0 - s * (rad x)⁻¹ * x 1 := by intro s; rw [hγk, heT0]; ring
  have hγ1 : ∀ s, γ s 1 = x 1 + s * (rad x)⁻¹ * x 0 := by intro s; rw [hγk, heT1]; ring
  have hγ00 : γ 0 = x := by rw [hγ]; simp
  have hx01 : x 0 ^ 2 + x 1 ^ 2 = rad x ^ 2 :=
    (Real.sq_sqrt (by positivity : (0:ℝ) ≤ x 0 ^ 2 + x 1 ^ 2)).symm
  have hsq : ∀ s, γ s 0 ^ 2 + γ s 1 ^ 2 = rad x ^ 2 + s ^ 2 := by
    intro s
    rw [hγ0, hγ1]
    have hi : (rad x)⁻¹ * rad x = 1 := inv_mul_cancel₀ hr0
    linear_combination (1 + s ^ 2 * (rad x)⁻¹ ^ 2) * hx01 + s ^ 2 * ((rad x)⁻¹ * rad x + 1) * hi
  have hρform : ∀ s, rad (γ s) = Real.sqrt (rad x ^ 2 + s ^ 2) := by
    intro s
    show Real.sqrt (γ s 0 ^ 2 + γ s 1 ^ 2) = _
    rw [hsq]
  have hρpos : ∀ s, 0 < rad (γ s) := by
    intro s
    rw [hρform]
    exact Real.sqrt_pos.mpr (add_pos_of_pos_of_nonneg (pow_pos hr 2) (sq_nonneg s))
  have hρ0 : rad (γ 0) = rad x := by rw [hγ00]
  have hγd : ∀ k : Fin 3, HasDerivAt (fun s => γ s k) (eTh x k) 0 := by
    intro k
    have e1 : (fun s => γ s k) = fun s => x k + s * eTh x k := funext fun s => hγk s k
    rw [e1]
    exact (((hasDerivAt_id' (0:ℝ)).mul_const (eTh x k)).const_add _).congr_deriv (one_mul _)
  have hρ : HasDerivAt (fun s => rad (γ s)) 0 0 := by
    have e1 : (fun s => rad (γ s)) = fun s => Real.sqrt (rad x ^ 2 + s * s) := by
      funext s; rw [hρform, pow_two s]
    rw [e1]
    have h1 := (((hasDerivAt_id' (0:ℝ)).mul (hasDerivAt_id' (0:ℝ))).const_add (rad x ^ 2)).sqrt
      (by simp [hr0])
    refine h1.congr_deriv ?_
    simp
  have hρi : HasDerivAt (fun s => (rad (γ s))⁻¹) 0 0 := by
    have h1 := hρ.inv (hρpos 0).ne'
    refine h1.congr_deriv ?_
    simp
  have ha : HasDerivAt (fun s => (rad (γ s))⁻¹ * γ s 0) (-(x 1) / rad x ^ 2) 0 := by
    refine (hρi.mul (hγd 0)).congr_deriv ?_
    rw [hρ0, heT0]; ring
  have hb : HasDerivAt (fun s => (rad (γ s))⁻¹ * γ s 1) (x 0 / rad x ^ 2) 0 := by
    refine (hρi.mul (hγd 1)).congr_deriv ?_
    rw [hρ0, heT1]; ring

  have hP0 : ptOf (γ 0) t (Yph h (rad (γ 0)) t + Y0) = ξ0 := by rw [hγ00, hξ0]
  have hP : HasDerivAt (fun s => ptOf (γ s) t (Yph h (rad (γ s)) t + Y0)) 0 0 := by
    have hY := (((hρ.rpow_const (p := drx h) (Or.inl (hρpos 0).ne')).smul_const vrv).add_const
      (t • vtv)).add_const Y0
    have h3 := hρ.prodMk ((hγd 2).prodMk ((hasDerivAt_const (0:ℝ) t).prodMk hY))
    refine h3.congr_deriv ?_
    simp [heT2]
  have hc0 : ∀ i : Fin 3, HasDerivAt (fun s => c (ptOf (γ s) t (Yph h (rad (γ s)) t + Y0)) i) 0 0 := by
    intro i
    have h1 := hc.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hP hP0.symm
    rw [map_zero] at h1
    exact hasDerivAt_pi.1 h1 i

  have hnormAll : ∀ y : ℝ³, ‖(⟨y 0, y 1⟩ : ℂ)‖ = rad y := by
    intro y; rw [Complex.norm_eq_sqrt_sq_add_sq]; rfl
  obtain ⟨u, hu⟩ : ∃ u : ℝ → ℂ, u = fun s => (((rad (γ s))⁻¹ : ℝ) : ℂ) *
      (((γ s 0 : ℝ) : ℂ) + ((γ s 1 : ℝ) : ℂ) * Complex.I) := ⟨_, rfl⟩
  have hexp : ∀ s, Complex.exp (((thetaOf (γ s) : ℝ) : ℂ) * Complex.I) = u s := by
    intro s
    have hne : ((rad (γ s) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (hρpos s).ne'
    have key := Complex.norm_mul_exp_arg_mul_I (⟨γ s 0, γ s 1⟩ : ℂ)
    rw [hnormAll (γ s)] at key
    rw [hu]
    show _ = (((rad (γ s))⁻¹ : ℝ) : ℂ) * (((γ s 0 : ℝ) : ℂ) + ((γ s 1 : ℝ) : ℂ) * Complex.I)
    rw [← Complex.mk_eq_add_mul_I, Complex.ofReal_inv, eq_inv_mul_iff_mul_eq₀ hne]
    exact key
  have hev : ∀ s, Complex.exp (Complex.I * (n : ℂ) * (thetaOf (γ s) : ℂ)) = u s ^ n := by
    intro s
    calc Complex.exp (Complex.I * (n : ℂ) * (thetaOf (γ s) : ℂ))
        = Complex.exp ((n : ℂ) * ((thetaOf (γ s) : ℂ) * Complex.I)) := by congr 1; ring
      _ = Complex.exp ((thetaOf (γ s) : ℂ) * Complex.I) ^ n := Complex.exp_int_mul _ _
      _ = u s ^ n := by rw [hexp]
  have hu0E : u 0 ^ n = E := by rw [← hev 0, hγ00, hE]
  have hu0 : u 0 ≠ 0 := by rw [← hexp 0]; exact Complex.exp_ne_zero _
  have hu0v : u 0 = (((rad x)⁻¹ : ℝ) : ℂ) * (((x 0 : ℝ) : ℂ) + ((x 1 : ℝ) : ℂ) * Complex.I) := by
    rw [hu]; simp only [hγ00]
  have hud : HasDerivAt u (Complex.I / ((rad x : ℝ) : ℂ) * u 0) 0 := by
    rw [hu0v, hu]
    refine (hρi.ofReal_comp.mul ((hγd 0).ofReal_comp.add
      ((hγd 1).ofReal_comp.mul_const Complex.I))).congr_deriv ?_
    simp only [hγ00, heT0, heT1]
    push_cast
    linear_combination (-(((x 1 : ℝ) : ℂ)) * (((rad x : ℝ) : ℂ))⁻¹ ^ 2) * Complex.I_sq
  have hΦ : HasDerivAt (fun s => Complex.exp (Complex.I * (n : ℂ) * (thetaOf (γ s) : ℂ)))
      (K * E) 0 := by
    have h1 := (hasDerivAt_zpow n (u 0) (Or.inl hu0)).comp (0:ℝ) hud
    have e2 : (fun s => Complex.exp (Complex.I * (n : ℂ) * (thetaOf (γ s) : ℂ))) =
        fun s => u s ^ n := funext hev
    rw [e2]
    refine h1.congr_deriv ?_
    rw [hK, ← hu0E, zpow_sub_one₀ hu0]
    linear_combination ((n : ℂ) * Complex.I / ((rad x : ℝ) : ℂ) * u 0 ^ n) * (inv_mul_cancel₀ hu0)

  obtain ⟨G, hG⟩ : ∃ G : ℝ³ → Fin 3 → ℝ, ∀ y i, G y i = (c (ptOf y t (Yph h (rad y) t + Y0)) i *
      Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re := ⟨_, fun _ _ => rfl⟩
  have hGv : ∀ i, G x i = (c ξ0 i * E).re := by
    intro i; rw [hG, hξ0, hE]
  have hGd : ∀ i : Fin 3, HasDerivAt (fun s => G (γ s) i) (c ξ0 i * (K * E)).re 0 := by
    intro i
    have h1 := Complex.reCLM.hasFDerivAt.comp_hasDerivAt (0:ℝ) ((hc0 i).mul hΦ)
    rw [Complex.reCLM_apply, hP0, zero_mul, zero_add] at h1
    refine h1.congr_of_eventuallyEq (Filter.Eventually.of_forall fun s => ?_)
    simp only [hG, Function.comp_apply, Complex.reCLM_apply, Pi.mul_apply]
  have hMc : ∀ y : ℝ³, modeF5 h 0 t Y0 n c y 0 =
        G y 0 * ((rad y)⁻¹ * y 0) - G y 1 * ((rad y)⁻¹ * y 1) ∧
      modeF5 h 0 t Y0 n c y 1 = G y 0 * ((rad y)⁻¹ * y 1) + G y 1 * ((rad y)⁻¹ * y 0) ∧
      modeF5 h 0 t Y0 n c y 2 = G y 2 := by
    intro y
    simp only [hG]
    refine ⟨?_, ?_, ?_⟩ <;> simp [modeF5, cyl2cart, eR, eTh, eZ, radVec, azVec] <;> ring
  have hrhs : ∀ w : Fin 3 → ℝ, cyl2cart x w 0 = w 0 * ((rad x)⁻¹ * x 0) - w 1 * ((rad x)⁻¹ * x 1) ∧
      cyl2cart x w 1 = w 0 * ((rad x)⁻¹ * x 1) + w 1 * ((rad x)⁻¹ * x 0) ∧ cyl2cart x w 2 = w 2 := by
    intro w
    refine ⟨?_, ?_, ?_⟩ <;> simp [cyl2cart, eR, eTh, eZ, radVec, azVec] <;> ring

  have hγl : HasDerivAt γ (eTh x) 0 := by
    rw [hγ]
    exact (((hasDerivAt_id' (0:ℝ)).smul_const (eTh x)).const_add x).congr_deriv (one_smul ℝ _)
  have hlineF := hMd.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hγl hγ00.symm
  have hline : ∀ k : Fin 3, HasDerivAt (fun s => modeF5 h 0 t Y0 n c (γ s) k)
      (fderiv ℝ (modeF5 h 0 t Y0 n c) x (eTh x) k) 0 := fun k =>
    (EuclideanSpace.proj k : ℝ³ →L[ℝ] ℝ).hasFDerivAt.comp_hasDerivAt (0:ℝ) hlineF
  have e0 : (fun s => modeF5 h 0 t Y0 n c (γ s) 0) = fun s =>
      G (γ s) 0 * ((rad (γ s))⁻¹ * γ s 0) - G (γ s) 1 * ((rad (γ s))⁻¹ * γ s 1) :=
    funext fun s => (hMc (γ s)).1
  have e1 : (fun s => modeF5 h 0 t Y0 n c (γ s) 1) = fun s =>
      G (γ s) 0 * ((rad (γ s))⁻¹ * γ s 1) + G (γ s) 1 * ((rad (γ s))⁻¹ * γ s 0) :=
    funext fun s => (hMc (γ s)).2.1
  have e2 : (fun s => modeF5 h 0 t Y0 n c (γ s) 2) = fun s => G (γ s) 2 :=
    funext fun s => (hMc (γ s)).2.2
  have d0 := ((hGd 0).mul ha).sub ((hGd 1).mul hb)
  have d1 := ((hGd 0).mul hb).add ((hGd 1).mul ha)
  have l0 := hline 0
  rw [e0] at l0
  have l1 := hline 1
  rw [e1] at l1
  have l2 := hline 2
  rw [e2] at l2
  have hv0 := l0.unique d0
  have hv1 := l1.unique d1
  have hv2 := l2.unique (hGd 2)

  have hT0 : ((K * c ξ0 0 - c ξ0 1 / ((rad x : ℝ) : ℂ)) * E).re =
      (c ξ0 0 * (K * E)).re - (c ξ0 1 * E).re / rad x := by
    rw [← Complex.div_ofReal_re, ← Complex.sub_re]; congr 1; ring
  have hT1 : ((K * c ξ0 1 + c ξ0 0 / ((rad x : ℝ) : ℂ)) * E).re =
      (c ξ0 1 * (K * E)).re + (c ξ0 0 * E).re / rad x := by
    rw [← Complex.div_ofReal_re, ← Complex.add_re]; congr 1; ring
  have hT2 : ((K * c ξ0 2) * E).re = (c ξ0 2 * (K * E)).re := by
    congr 1; ring
  have comp0 : fderiv ℝ (modeF5 h 0 t Y0 n c) x (eTh x) 0 =
      ((K * c ξ0 0 - c ξ0 1 / ((rad x : ℝ) : ℂ)) * E).re * ((rad x)⁻¹ * x 0) -
        ((K * c ξ0 1 + c ξ0 0 / ((rad x : ℝ) : ℂ)) * E).re * ((rad x)⁻¹ * x 1) := by
    rw [hv0, hT0, hT1]
    simp only [Pi.mul_apply, Pi.sub_apply, Pi.add_apply, hγ00, hGv, hρ0]
    field_simp
    ring
  have comp1 : fderiv ℝ (modeF5 h 0 t Y0 n c) x (eTh x) 1 =
      ((K * c ξ0 0 - c ξ0 1 / ((rad x : ℝ) : ℂ)) * E).re * ((rad x)⁻¹ * x 1) +
        ((K * c ξ0 1 + c ξ0 0 / ((rad x : ℝ) : ℂ)) * E).re * ((rad x)⁻¹ * x 0) := by
    rw [hv1, hT0, hT1]
    simp only [Pi.mul_apply, Pi.sub_apply, Pi.add_apply, hγ00, hGv, hρ0]
    field_simp
    ring
  have comp2 : fderiv ℝ (modeF5 h 0 t Y0 n c) x (eTh x) 2 = ((K * c ξ0 2) * E).re := by
    rw [hv2, hT2]
  have hR := hrhs (fun i => (![K * c ξ0 0 - c ξ0 1 / ((rad x : ℝ) : ℂ),
    K * c ξ0 1 + c ξ0 0 / ((rad x : ℝ) : ℂ), K * c ξ0 2] i * E).re)
  refine PiLp.ext fun k => ?_
  fin_cases k
  · exact comp0.trans hR.1.symm
  · exact comp1.trans hR.2.1.symm
  · exact comp2.trans hR.2.2.symm

theorem pq5_local_modes : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (V : WC), B.ok → (∀ γ m, m ≠ 1 → m ≠ -1 → V γ m = 0) → (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → V γ m ξ ≠ 0 → SuppW B G γ ξ) → ∀ x t Y, corrOn B l0 x t → ∃ (O : Set ℝ³) (Γ : Finset Lab), IsOpen O ∧ x ∈ O ∧ (∀ γ m, γ ∉ Γ → V γ m (ptOf x t Y) = 0) ∧ ∀ y ∈ O, corrOn B l0 y t ∧ cyl2cart y (waveV5 B G V (thetaOf y) (ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t)))) = ∑ γ ∈ Γ, ∑ m ∈ ({1, -1} : Finset ℤ), modeF5 B.h 0 t (Y - Yph B.h (rad x) t) (m * pint5 B G γ) (modeCoef5 B G V γ m) y :=
by
  intro B G l0 V hok hVm hVsupp x t Y hxt
  obtain ⟨Y', hY'⟩ : ∃ Y' : ℝ × ℝ, Y' = Y - Yph B.h (rad x) t := ⟨_, rfl⟩
  rw [← hY']
  have hxt' : 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt

  have hEta : ∀ (h : ℝ), SimScaleProps h → ∀ ξ0 : Cyl, ξ0.2.2.1 < 1 → ∃ N ∈ nhds ξ0, ∃ Γ : Finset Lab,
      ∀ (γ : Lab) (ξ : Cyl), ξ ∈ N → ξ ∈ tsupport (etaL h γ) → γ ∈ Γ := by
    intro h hS ξ0 hξ0
    have hLc : ∀ ξ : Cyl, ξ.2.2.1 < 1 → ContinuousAt (fun η => Real.logb 2 (qC h η)) ξ := by
      intro ξ hξ
      have hτ : 0 < 1 - ξ.2.2.1 := by linarith
      have hqpos : 0 < qC h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
      have hqcont : ContinuousAt (qC h) ξ := by
        have hU : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
        have hp : ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) :=
          ⟨trivial, hτ⟩
        have hg : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (ξ.2.1, 1 - ξ.2.2.1) :=
          hS.2.2.2.1.continuousOn.continuousAt (hU.mem_nhds hp)
        have hk : ContinuousAt (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) ξ := by fun_prop
        have he : qC h = (fun w : ℝ × ℝ => simScale h w.1 w.2) ∘
            (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by
          funext η; rfl
        rw [he]
        exact ContinuousAt.comp hg hk
      exact hqcont.logb hqpos.ne'
    have hwin : ∀ (ξ : Cyl) (γ : Lab), ξ.2.2.1 < 1 → ξ ∈ tsupport (etaL h γ) →
        |Real.logb 2 (qC h ξ) + (γ.1:ℝ)| ≤ 1 ∧
        |chartR h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1:ℝ)| ≤ 1 ∧
        |chartZ h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.1:ℝ)| ≤ 1 ∧
        |chartT h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2:ℝ)| ≤ 1 := by
      intro ξ γ hξ hγ
      have s1 : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ → 1 < |φ ξ / μ - (j : ℝ)| →
          ∀ᶠ η in nhds ξ, sqPart μ j (φ η) = 0 := by
        intro μ j φ hφ h1
        have hψ : ContinuousAt (fun η => |φ η / μ - (j : ℝ)|) ξ :=
          ((hφ.div_const μ).sub continuousAt_const).abs
        have hev := (continuousAt_const : ContinuousAt (fun _ : Cyl => (1:ℝ)) ξ).eventually_lt hψ h1
        filter_upwards [hev] with η hη
        have hsq : 1 < (φ η / μ - (j : ℝ)) ^ 2 := (one_lt_sq_iff_one_lt_abs _).mpr hη
        unfold sqPart bumpR
        rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_div]
      have key : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ →
          (∀ η, sqPart μ j (φ η) = 0 → etaL h γ η = 0) → |φ ξ / μ - (j:ℝ)| ≤ 1 := by
        intro μ j φ hφ himp
        by_contra hc
        push_neg at hc
        have hev := s1 μ j φ hφ hc
        apply (notMem_tsupport_iff_eventuallyEq.mpr _) hγ
        filter_upwards [hev] with η hη
        exact himp η hη
      refine ⟨?_, ?_, ?_, ?_⟩
      · have := key 1 (-(γ.1:ℤ)) (fun η => Real.logb 2 (qC h η)) (hLc ξ hξ)
          (fun η hη => by simp only [etaL, hη, zero_mul])
        simpa [div_one, sub_neg_eq_add] using this
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.1 (chartR h γ.1) (by unfold chartR; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.1 (chartZ h γ.1) (by unfold chartZ; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.2 (chartT h γ.1) (by unfold chartT; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
    obtain ⟨L0, hL0⟩ : ∃ L0 : ℝ, L0 = Real.logb 2 (qC h ξ0) := ⟨_, rfl⟩
    have hfin : (⋃ n ∈ Set.Iic ⌊2 - L0⌋₊, ({n} : Set ℕ) ×ˢ
        ((Set.Icc ⌈chartR h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartR h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋ ×ˢ
          Set.Icc ⌈chartZ h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartZ h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋ ×ˢ
          Set.Icc ⌈chartT h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartT h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋) ×ˢ
          (Set.univ : Set Bool))).Finite := by
      refine Set.Finite.biUnion (Set.finite_Iic _) (fun n _ => ?_)
      exact (Set.finite_singleton n).prod (((Set.finite_Icc _ _).prod
        ((Set.finite_Icc _ _).prod (Set.finite_Icc _ _))).prod Set.finite_univ)
    have hI : ∀ (x c : ℝ) (j : ℤ), |x - (j:ℝ)| ≤ 1 → |x - c| < 1 → j ∈ Set.Icc ⌈c - 2⌉ ⌊c + 2⌋ := by
      intro x c j hj hc
      rw [abs_le] at hj
      rw [abs_lt] at hc
      exact ⟨Int.ceil_le.mpr (by linarith [hj.2, hc.1]), Int.le_floor.mpr (by linarith [hj.1, hc.2])⟩
    have hcR : ∀ n : ℕ, ContinuousAt (chartR h n) ξ0 := fun n => by unfold chartR; fun_prop
    have hcZ : ∀ n : ℕ, ContinuousAt (chartZ h n) ξ0 := fun n => by unfold chartZ; fun_prop
    have hcT : ∀ n : ℕ, ContinuousAt (chartT h n) ξ0 := fun n => by unfold chartT; fun_prop
    have hch : ∀ (φ : Cyl → ℝ) (μ : ℝ), ContinuousAt φ ξ0 →
        ∀ᶠ ξ in nhds ξ0, |φ ξ / μ - φ ξ0 / μ| < 1 := by
      intro φ μ hφ
      exact (((hφ.div_const μ).sub continuousAt_const).abs).eventually_lt continuousAt_const
        (by simp)
    have e1 : ∀ᶠ ξ in nhds ξ0, ξ.2.2.1 < 1 :=
      (show ContinuousAt (fun ξ : Cyl => ξ.2.2.1) ξ0 by fun_prop).eventually_lt
        continuousAt_const hξ0
    have e2 : ∀ᶠ ξ in nhds ξ0, |Real.logb 2 (qC h ξ) - L0| < 1 :=
      (((hLc ξ0 hξ0).sub continuousAt_const).abs).eventually_lt continuousAt_const
        (by simp [hL0])
    have e3 : ∀ᶠ ξ in nhds ξ0, ∀ n ∈ Finset.range (⌊2 - L0⌋₊ + 1),
        |chartR h n ξ / Sb n ^ (-3:ℤ) - chartR h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartZ h n ξ / Sb n ^ (-3:ℤ) - chartZ h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartT h n ξ / Sb n ^ (-3:ℤ) - chartT h n ξ0 / Sb n ^ (-3:ℤ)| < 1 := by
      rw [Filter.eventually_all_finset]
      intro n _
      exact (hch _ _ (hcR n)).and ((hch _ _ (hcZ n)).and (hch _ _ (hcT n)))
    refine ⟨{ξ | ξ.2.2.1 < 1 ∧ |Real.logb 2 (qC h ξ) - L0| < 1 ∧
        ∀ n ∈ Finset.range (⌊2 - L0⌋₊ + 1),
        |chartR h n ξ / Sb n ^ (-3:ℤ) - chartR h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartZ h n ξ / Sb n ^ (-3:ℤ) - chartZ h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartT h n ξ / Sb n ^ (-3:ℤ) - chartT h n ξ0 / Sb n ^ (-3:ℤ)| < 1}, ?_,
      hfin.toFinset, ?_⟩
    · filter_upwards [e1, e2, e3] with ξ h1 h2 h3
      exact ⟨h1, h2, h3⟩
    rintro ⟨n, ⟨a, b, c⟩, σ⟩ ξ ⟨ht, hL, hC⟩ hγ
    obtain ⟨w0, wR, wZ, wT⟩ := hwin ξ _ ht hγ
    simp only at w0 wR wZ wT
    rw [abs_le] at w0
    rw [abs_lt] at hL
    have hn : n ≤ ⌊2 - L0⌋₊ := Nat.le_floor (by linarith [w0.2, hL.1])
    obtain ⟨cR, cZ, cT⟩ := hC n (Finset.mem_range.mpr (Nat.lt_succ_of_le hn))
    rw [Set.Finite.mem_toFinset]
    refine Set.mem_iUnion₂.mpr ⟨n, hn, ?_⟩
    exact ⟨rfl, ⟨hI _ _ _ wR cR, hI _ _ _ wZ cZ, hI _ _ _ wT cT⟩, trivial⟩
  obtain ⟨N, hN, Γ, hΓ⟩ := hEta B.h hok.1 (ptOf x t Y) hxt'.2.1

  have hoff : ∀ η ∈ N, η ∈ DomC B.h (qsOf l0) → ∀ (γ : Lab) (m : ℤ),
      (γ ∉ Γ ∨ m ∉ ({1, -1} : Finset ℤ)) → V γ m η = 0 := by
    intro η hηN hηD γ m hγm
    by_contra hne
    rcases hγm with hγ | hm
    · exact hγ (hΓ γ η hηN (hVsupp γ m η hηD hne).2.1)
    · simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hm
      exact hne (congrFun (hVm γ m hm.1 hm.2) η)

  have hsum : ∀ (F : Lab → ℤ → ℂ), (∀ γ m, (γ ∉ Γ ∨ m ∉ ({1, -1} : Finset ℤ)) → F γ m = 0) →
      ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, F γ m = ∑ γ ∈ Γ, ∑ m ∈ ({1, -1} : Finset ℤ), F γ m := by
    intro F hF
    have hin : ∀ γ, ∑ᶠ m : ℤ, F γ m = ∑ m ∈ ({1, -1} : Finset ℤ), F γ m := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      rw [Function.mem_support] at hm
      by_contra h
      exact hm (hF γ m (Or.inr (by simpa using h)))
    simp_rw [hin]
    apply finsum_eq_sum_of_support_subset
    intro γ hγ
    rw [Function.mem_support] at hγ
    by_contra h
    exact hγ (Finset.sum_eq_zero (fun m _ => hF γ m (Or.inl (by simpa using h))))
  have hphase : ∀ (γ : Lab) (m : ℤ) (θ : ℝ) (η : Cyl), ephase5 B G γ m θ η =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) *
        Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) := by
    intro γ m θ η
    simp only [ephase5]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  have hcyl_sum : ∀ (y : ℝ³) {ι : Type} (s : Finset ι) (v : ι → Fin 3 → ℝ),
      cyl2cart y (∑ j ∈ s, v j) = ∑ j ∈ s, cyl2cart y (v j) := by
    intro y ι s v
    let L : (Fin 3 → ℝ) →+ ℝ³ := AddMonoidHom.mk' (cyl2cart y) (fun c d => by
      simp only [cyl2cart, Pi.add_apply, add_smul]; abel)
    exact map_sum L v s

  have hexpand : ∀ (y : ℝ³), corrOn B l0 y t →
      (∀ (γ : Lab) (m : ℤ), (γ ∉ Γ ∨ m ∉ ({1, -1} : Finset ℤ)) →
        V γ m (ptOf y t (Yph B.h (rad y) t + Y')) = 0) →
      cyl2cart y (waveV5 B G V (thetaOf y) (ptOf y t (Yph B.h (rad y) t + Y'))) =
        ∑ γ ∈ Γ, ∑ m ∈ ({1, -1} : Finset ℤ),
          modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m) y := by
    intro y hc hz
    have hF : ∀ (n : ℤ) (c : Cyl → (Fin 3 → ℂ)), modeF5 B.h 0 t Y' n c y =
        cyl2cart y (fun i => (c (ptOf y t (Yph B.h (rad y) t + Y')) i *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re) := by
      intro n c
      simp only [modeF5, Real.rpow_zero, one_smul]
    trans cyl2cart y (∑ γ ∈ Γ, ∑ m ∈ ({1, -1} : Finset ℤ), fun i =>
      (modeCoef5 B G V γ m (ptOf y t (Yph B.h (rad y) t + Y')) i *
        Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf y : ℂ))).re)
    · congr 1
      funext i
      simp only [waveV5, Finset.sum_apply]
      rw [hsum (fun γ m => V γ m (ptOf y t (Yph B.h (rad y) t + Y')) i *
          ephase5 B G γ m (thetaOf y) (ptOf y t (Yph B.h (rad y) t + Y')))
        (fun γ m h => by simp only [hz γ m h, Pi.zero_apply, zero_mul]), Complex.re_sum]
      refine Finset.sum_congr rfl (fun γ _ => ?_)
      rw [Complex.re_sum]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      rw [hphase]
      simp only [modeCoef5]
      congr 1
      ring
    · rw [hcyl_sum]
      refine Finset.sum_congr rfl (fun γ _ => ?_)
      rw [hcyl_sum]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      exact (hF _ _).symm

  have hradc : Continuous rad := by
    unfold rad
    fun_prop
  have hOopen : IsOpen {y : ℝ³ | corrOn B l0 y t ∧
      ptOf y t (Yph B.h (rad y) t + Y') ∈ interior N} := by
    rw [isOpen_iff_mem_nhds]
    intro y0 hy0
    have h1 : 0 < rad y0 := hy0.1.1
    have h2 : t < 1 := hy0.1.2.1
    have h3 : simScale B.h (y0 2) (1 - t) < qsOf l0 := hy0.1.2.2
    have h4 : ptOf y0 t (Yph B.h (rad y0) t + Y') ∈ interior N := hy0.2
    have e1 : ∀ᶠ y in nhds y0, (0:ℝ) < rad y :=
      continuousAt_const.eventually_lt hradc.continuousAt h1
    have hmem2 : ((y0 2, 1 - t) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ)) :=
      ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩
    have hc1 : ContinuousAt (fun y : ℝ³ => simScale B.h (y 2) (1 - t)) y0 := by
      have h1' : ContinuousAt (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (y0 2, 1 - t) :=
        (hok.1.2.2.2.1.contDiffAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds hmem2)).continuousAt
      have h2' : ContinuousAt (fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ)) y0 := by fun_prop
      exact ContinuousAt.comp (x := y0) (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2)
        (f := fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ)) h1' h2'
    have e3 : ∀ᶠ y in nhds y0, simScale B.h (y 2) (1 - t) < qsOf l0 :=
      hc1.eventually_lt continuousAt_const h3
    have hPc : ContinuousAt (fun y : ℝ³ => ptOf y t (Yph B.h (rad y) t + Y')) y0 := by
      have hr1 : ContinuousAt (fun y : ℝ³ => rad y ^ drx B.h) y0 :=
        hradc.continuousAt.rpow_const (Or.inl h1.ne')
      have h4' : ContinuousAt (fun y : ℝ³ => Yph B.h (rad y) t + Y') y0 :=
        ((hr1.smul continuousAt_const).add continuousAt_const).add continuousAt_const
      have h2'' : ContinuousAt (fun y : ℝ³ => y 2) y0 := by fun_prop
      exact hradc.continuousAt.prodMk (h2''.prodMk (continuousAt_const.prodMk h4'))
    have e4 : ∀ᶠ y in nhds y0, ptOf y t (Yph B.h (rad y) t + Y') ∈ interior N :=
      hPc.preimage_mem_nhds (isOpen_interior.mem_nhds h4)
    filter_upwards [e1, e3, e4] with y a1 a3 a4
    exact ⟨⟨a1, h2, a3⟩, a4⟩
  have hpx : ptOf x t (Yph B.h (rad x) t + Y') = ptOf x t Y := by
    rw [hY']
    congr 1
    abel
  refine ⟨{y : ℝ³ | corrOn B l0 y t ∧ ptOf y t (Yph B.h (rad y) t + Y') ∈ interior N},
    Γ, hOopen, ?_, ?_, ?_⟩
  · refine ⟨hxt, ?_⟩
    show ptOf x t (Yph B.h (rad x) t + Y') ∈ interior N
    rw [hpx]
    exact mem_interior_iff_mem_nhds.mpr hN
  · intro γ m hγ
    exact hoff _ (mem_of_mem_nhds hN) hxt γ m (Or.inl hγ)
  · intro y hy
    have hc : corrOn B l0 y t := hy.1
    have hi : ptOf y t (Yph B.h (rad y) t + Y') ∈ interior N := hy.2
    exact ⟨hc, hexpand y hc (fun γ m h => hoff _ (interior_subset hi) hc γ m h)⟩

theorem pq5_trm_split : ∀ (h : ℝ) (n n' : ℤ) (U : Fin 3 → ℂ) (c : Cyl → (Fin 3 → ℂ)) (ξ : Cyl) (θ : ℝ) (i : Fin 3), (pq5TrM h n' (fun a => (((U a * Complex.exp (Complex.I * (n : ℂ) * (θ : ℂ))).re : ℝ) : ℂ)) c ξ i * Complex.exp (Complex.I * (n' : ℂ) * (θ : ℂ))).re = ((1/2 : ℂ) * (pq5TrM h n' U c ξ i * Complex.exp (Complex.I * ((n + n' : ℤ) : ℂ) * (θ : ℂ)) + pq5TrM h n' (fun a => starRingEnd ℂ (U a)) c ξ i * Complex.exp (Complex.I * ((n' - n : ℤ) : ℂ) * (θ : ℂ)))).re :=
by
  intro h n n' U c ξ θ i
  have F1 : Complex.exp (Complex.I * ((n + n' : ℤ) : ℂ) * (θ : ℂ)) =
      Complex.exp (Complex.I * (n : ℂ) * (θ : ℂ)) * Complex.exp (Complex.I * (n' : ℂ) * (θ : ℂ)) := by
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  have F2 : Complex.exp (Complex.I * ((n' - n : ℤ) : ℂ) * (θ : ℂ)) =
      starRingEnd ℂ (Complex.exp (Complex.I * (n : ℂ) * (θ : ℂ))) *
        Complex.exp (Complex.I * (n' : ℂ) * (θ : ℂ)) := by
    rw [← Complex.exp_conj, ← Complex.exp_add]
    congr 1
    rw [map_mul, map_mul, Complex.conj_I, map_intCast, Complex.conj_ofReal]
    push_cast
    ring
  have F3 : ∀ a, (((U a * Complex.exp (Complex.I * (n : ℂ) * (θ : ℂ))).re : ℝ) : ℂ) =
      (U a * Complex.exp (Complex.I * (n : ℂ) * (θ : ℂ)) +
        starRingEnd ℂ (U a) * starRingEnd ℂ (Complex.exp (Complex.I * (n : ℂ) * (θ : ℂ)))) / 2 := by
    intro a
    rw [Complex.re_eq_add_conj, map_mul]
  congr 1
  rw [F1, F2]
  simp only [F3]
  generalize Complex.exp (Complex.I * (n : ℂ) * (θ : ℂ)) = E
  generalize Complex.exp (Complex.I * (n' : ℂ) * (θ : ℂ)) = E'
  fin_cases i <;> simp [pq5TrM] <;> ring

theorem pq5_offdiag : ∀ (h t : ℝ) (Y0 : ℝ × ℝ) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (x : ℝ³), 0 < rad x → c =ᶠ[nhds (ptOf x t (Yph h (rad x) t + Y0))] 0 → fderiv ℝ (modeF5 h 0 t Y0 n c) x = 0 :=
by
  intro h t Y0 n c x hr hc
  have hrad : Continuous (fun y : ℝ³ => rad y) := by
    unfold rad
    have h0 : Continuous (fun y : ℝ³ => y 0) := by fun_prop
    have h1 : Continuous (fun y : ℝ³ => y 1) := by fun_prop
    exact Real.continuous_sqrt.comp ((h0.pow 2).add (h1.pow 2))
  have hz : Continuous (fun y : ℝ³ => y 2) := by fun_prop
  have hpow : ContinuousAt (fun y : ℝ³ => rad y ^ drx h) x :=
    hrad.continuousAt.rpow_const (Or.inl hr.ne')
  have hY : ContinuousAt (fun y : ℝ³ => Yph h (rad y) t + Y0) x := by
    unfold Yph
    exact ((hpow.smul continuousAt_const).add continuousAt_const).add continuousAt_const
  have hζ : ContinuousAt (fun y : ℝ³ => ptOf y t (Yph h (rad y) t + Y0)) x := by
    unfold ptOf
    exact hrad.continuousAt.prodMk (hz.continuousAt.prodMk (continuousAt_const.prodMk hY))
  have hpull : ∀ᶠ y in nhds x, c (ptOf y t (Yph h (rad y) t + Y0)) = 0 :=
    hζ.tendsto.eventually hc
  have hloc : modeF5 h 0 t Y0 n c =ᶠ[nhds x] fun _ => (0 : ℝ³) := by
    filter_upwards [hpull] with y hy
    simp [modeF5, cyl2cart, hy]
  rw [hloc.fderiv_eq]
  exact fderiv_const_apply _

theorem pq5_regroup : ∀ (B : BG) (G : CorrGeom) (V : WC) (ξ : Cyl) (θ : ℝ) (Γ : Finset Lab), 0 < qC B.h ξ → (∀ γ m, γ ∉ Γ → V γ m ξ = 0) → (qC B.h ξ ^ (-(2 * Aex B.h + 1/2))) • waveV5 B G (pq5QOf B G V) θ ξ = fun i => ∑ γ ∈ Γ, ∑ m ∈ ({1, -1} : Finset ℤ), ∑ m' ∈ ({1, -1} : Finset ℤ), ((1/2 : ℂ) * (pq5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G V γ m ξ) (modeCoef5 B G V γ m') ξ i * Complex.exp (Complex.I * ((m * pint5 B G γ + m' * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) + pq5TrM B.h (m' * pint5 B G γ) (fun a => starRingEnd ℂ (modeCoef5 B G V γ m ξ a)) (modeCoef5 B G V γ m') ξ i * Complex.exp (Complex.I * ((m' * pint5 B G γ - m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)))).re :=
by
  intro B G V ξ θ Γ hq hΓ
  funext i

  have hE : ∀ (γ : Lab) (M : ℤ), pq5QOf B G V γ M ξ i * ephase5 B G γ M θ ξ =
      (((qC B.h ξ ^ (2 * Aex B.h + 1/2) / 2 : ℝ)) : ℂ) *
        ∑ m ∈ ({1, -1} : Finset ℤ), ∑ m' ∈ ({1, -1} : Finset ℤ),
          ((if m + m' = M then pq5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G V γ m ξ)
              (modeCoef5 B G V γ m') ξ i *
              Complex.exp (Complex.I * ((M * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) else 0) +
           (if m' - m = M then pq5TrM B.h (m' * pint5 B G γ)
              (fun a => starRingEnd ℂ (modeCoef5 B G V γ m ξ a)) (modeCoef5 B G V γ m') ξ i *
              Complex.exp (Complex.I * ((M * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) else 0)) := by
    intro γ M
    have he : Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) ≠ 0 :=
      Complex.exp_ne_zero _
    have hph : ephase5 B G γ M θ ξ =
        Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
          Complex.exp (Complex.I * ((M * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) := by
      unfold ephase5
      rw [← Complex.exp_add]
      congr 1
      push_cast
      ring
    have key : ∀ (c S F : ℂ),
        c * (Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))⁻¹ * S *
          (Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) * F) =
        c * (S * F) := by
      intro c S F
      rw [show c * (Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))⁻¹ * S *
          (Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) * F) =
          c * (S * F) * ((Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))⁻¹ *
            Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)))) by ring,
        inv_mul_cancel₀ he, mul_one]
    rw [hph]
    unfold pq5QOf
    simp only [Pi.smul_apply, smul_eq_mul, Finset.sum_apply, Pi.add_apply, ite_apply, Pi.zero_apply]
    rw [key]
    congr 1
    simp only [Finset.sum_mul, add_mul, ite_mul, zero_mul]

  have hsupp : ∀ γ : Lab, (Function.support fun M : ℤ => pq5QOf B G V γ M ξ i * ephase5 B G γ M θ ξ) ⊆
      ((({2, 0, -2} : Finset ℤ)) : Set ℤ) := by
    intro γ M hM
    by_contra hn
    apply hM
    simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff, Set.mem_singleton_iff,
      not_or] at hn
    show pq5QOf B G V γ M ξ i * ephase5 B G γ M θ ξ = 0
    rw [hE, Finset.sum_eq_zero, mul_zero]
    intro m hm
    apply Finset.sum_eq_zero
    intro m' hm'
    simp only [Finset.mem_insert, Finset.mem_singleton] at hm hm'
    have h1 : m + m' ≠ M := by omega
    have h2 : m' - m ≠ M := by omega
    rw [if_neg h1, if_neg h2, add_zero]

  have hinner : ∀ γ : Lab, ∑ᶠ M : ℤ, pq5QOf B G V γ M ξ i * ephase5 B G γ M θ ξ =
      (((qC B.h ξ ^ (2 * Aex B.h + 1/2) / 2 : ℝ)) : ℂ) *
        ∑ m ∈ ({1, -1} : Finset ℤ), ∑ m' ∈ ({1, -1} : Finset ℤ),
          (pq5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G V γ m ξ) (modeCoef5 B G V γ m') ξ i *
              Complex.exp (Complex.I * ((m * pint5 B G γ + m' * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) +
            pq5TrM B.h (m' * pint5 B G γ) (fun a => starRingEnd ℂ (modeCoef5 B G V γ m ξ a))
              (modeCoef5 B G V γ m') ξ i *
              Complex.exp (Complex.I * ((m' * pint5 B G γ - m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ))) := by
    intro γ
    rw [finsum_eq_sum_of_support_subset _ (hsupp γ), Finset.sum_congr rfl (fun M _ => hE γ M),
      ← Finset.mul_sum]
    congr 1
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun m hm => ?_)
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun m' hm' => ?_)
    rw [Finset.sum_add_distrib, Finset.sum_ite_eq, Finset.sum_ite_eq]
    simp only [Finset.mem_insert, Finset.mem_singleton] at hm hm'
    have hm1 : m + m' ∈ ({2, 0, -2} : Finset ℤ) := by
      simp only [Finset.mem_insert, Finset.mem_singleton]; omega
    have hm2 : m' - m ∈ ({2, 0, -2} : Finset ℤ) := by
      simp only [Finset.mem_insert, Finset.mem_singleton]; omega
    rw [if_pos hm1, if_pos hm2, add_mul, sub_mul]

  have hTr0 : ∀ (n : ℤ) (U : Fin 3 → ℂ) (c : Cyl → (Fin 3 → ℂ)), (∀ a, U a = 0) →
      pq5TrM B.h n U c ξ = 0 := by
    intro n U c hU
    funext j
    fin_cases j <;> simp [pq5TrM, hU]
  have hQ0 : ∀ γ, γ ∉ Γ → ∀ M, pq5QOf B G V γ M ξ = 0 := by
    intro γ hγ M
    unfold pq5QOf
    rw [Finset.sum_eq_zero, smul_zero]
    intro m _
    apply Finset.sum_eq_zero
    intro m' _
    have hU : ∀ a, modeCoef5 B G V γ m ξ a = 0 := fun a => by simp [modeCoef5, hΓ γ m hγ]
    have hU' : ∀ a, (fun i => starRingEnd ℂ (modeCoef5 B G V γ m ξ i)) a = 0 := fun a => by
      simp [hU a]
    rw [hTr0 _ _ _ hU, hTr0 _ _ _ hU']
    simp
  have hsuppΓ : (Function.support fun γ : Lab =>
      ∑ᶠ M : ℤ, pq5QOf B G V γ M ξ i * ephase5 B G γ M θ ξ) ⊆ (Γ : Set Lab) := by
    intro γ hγ
    by_contra hn
    apply hγ
    simp [hQ0 γ hn]

  have hc : qC B.h ξ ^ (-(2 * Aex B.h + 1/2)) * (qC B.h ξ ^ (2 * Aex B.h + 1/2) / 2) = 1/2 := by
    rw [Real.rpow_neg hq.le]
    field_simp [(Real.rpow_pos_of_pos hq (2 * Aex B.h + 1/2)).ne']
  simp only [Pi.smul_apply, smul_eq_mul, waveV5]
  rw [finsum_eq_sum_of_support_subset _ hsuppΓ, Finset.sum_congr rfl (fun γ _ => hinner γ),
    Complex.re_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun γ _ => ?_)
  rw [Complex.re_ofReal_mul, ← mul_assoc, hc, Complex.re_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun m _ => ?_)
  rw [Complex.re_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun m' _ => ?_)
  rw [show (1/2 : ℂ) = ((1/2 : ℝ) : ℂ) by push_cast; ring, Complex.re_ofReal_mul]

theorem pq5_coef_diff : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (V : WC), B.ok → GeomPrim5 B G → qsOf l0 ≤ B.qB → (∀ γ m, ContDiffOn ℝ ∞ (V γ m) (DomC B.h (qsOf l0))) → (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → V γ m ξ ≠ 0 → SuppW B G γ ξ) → IsOpen (DomC B.h (qsOf l0)) ∧ ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), DifferentiableAt ℝ (modeCoef5 B G V γ m) ξ :=
by
  intro B G l0 V hok hG hqs hVs hVsupp

  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  refine ⟨hDopen, ?_⟩
  intro γ m ξ hξ
  have hDn : DomC B.h (qsOf l0) ∈ nhds ξ := hDopen.mem_nhds hξ
  obtain ⟨hr, ht, hqξ⟩ := id hξ

  have hamp : DifferentiableAt ℝ (V γ m) ξ :=
    ((hVs γ m).contDiffAt hDn).differentiableAt (by norm_num)
  have hai : ∀ i, DifferentiableAt ℝ (fun η => V γ m η i) ξ := differentiableAt_pi.1 hamp

  set v : Cyl → ℝ × ℝ := fun η => Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ with hv
  have hvc : Continuous v := by
    rw [hv]
    unfold Jpow
    fun_prop
  set U : Set Cyl := DomC B.h (qsOf l0) ∩ {η | |(v η).1 - (v ξ).1| < 1/8} ∩
    {η | |(v η).2 - (v ξ).2| < 1/8} with hU
  have hUo : IsOpen U :=
    (hDopen.inter (isOpen_lt ((hvc.fst.sub continuous_const).abs) continuous_const)).inter
      (isOpen_lt ((hvc.snd.sub continuous_const).abs) continuous_const)
  have hξU : ξ ∈ U := by
    refine ⟨⟨hξ, ?_⟩, ?_⟩
    · show |(v ξ).1 - (v ξ).1| < 1/8
      rw [sub_self, abs_zero]; norm_num
    · show |(v ξ).2 - (v ξ).2| < 1/8
      rw [sub_self, abs_zero]; norm_num
  have hUn : U ∈ nhds ξ := hUo.mem_nhds hξU
  by_cases hA : ∀ η ∈ U, V γ m η = 0
  ·
    have hev : modeCoef5 B G V γ m =ᶠ[nhds ξ] fun _ => (0 : Fin 3 → ℂ) :=
      Filter.eventuallyEq_of_mem hUn (fun η hη => by
        funext i
        simp [modeCoef5, hA η hη])
    exact (differentiableAt_const _).congr_of_eventuallyEq hev
  ·
    push_neg at hA
    obtain ⟨η1, hη1U, hη1⟩ := hA
    have hη1D : η1 ∈ DomC B.h (qsOf l0) := hη1U.1.1
    obtain ⟨-, -, hxi, het, -, -⟩ := hVsupp γ m η1 hη1D hη1
    have hr0 : G.r0 ≤ 1/100 := hG.1.2.1

    have hb0 : 0 ≤ bgc := by unfold bgc; linarith [Real.one_lt_sqrt_two]
    have hb1 : bgc ≤ 1 := by
      unfold bgc
      nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
    have hden : (1 + bgc ^ 2) * (1 + bgc ^ 2)⁻¹ = 1 := mul_inv_cancel₀ (by positivity)
    have id1 : ∀ w : ℝ × ℝ, w.1 = lamR w + bgc * lamT w := by
      intro w
      simp only [lamR, lamT, div_eq_mul_inv]
      linear_combination (-w.1) * hden
    have id2 : ∀ w : ℝ × ℝ, w.2 = -(bgc * lamR w) + lamT w := by
      intro w
      simp only [lamR, lamT, div_eq_mul_inv]
      linear_combination (-w.2) * hden
    have key : ∀ (R T : ℝ), |R| ≤ G.r0 / 4 → |T| ≤ G.r0 →
        |R + bgc * T| ≤ 1/80 ∧ |-(bgc * R) + T| ≤ 1/80 := by
      intro R T hR hT
      obtain ⟨hR1, hR2⟩ := abs_le.mp hR
      obtain ⟨hT1, hT2⟩ := abs_le.mp hT
      have hr0n : 0 ≤ G.r0 := le_trans (abs_nonneg _) hT
      have e1 : bgc * T ≤ G.r0 := by
        nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hT2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
      have e2 : -G.r0 ≤ bgc * T := by
        nlinarith [mul_nonneg hb0 (show 0 ≤ T + G.r0 by linarith),
          mul_nonneg (sub_nonneg.mpr hb1) hr0n]
      have e3 : bgc * R ≤ G.r0 / 4 := by
        nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hR2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
      have e4 : -(G.r0 / 4) ≤ bgc * R := by
        nlinarith [mul_nonneg hb0 (show 0 ≤ R + G.r0 / 4 by linarith),
          mul_nonneg (sub_nonneg.mpr hb1) hr0n]
      exact ⟨abs_le.mpr ⟨by linarith, by linarith⟩, abs_le.mpr ⟨by linarith, by linarith⟩⟩
    have hround : ∀ (x : ℝ) (k : ℤ), |x - k| < 1/2 → round x = k := by
      intro x k hk
      rw [round_eq, Int.floor_eq_iff]
      obtain ⟨h1, h2⟩ := abs_lt.mp hk
      constructor <;> linarith
    have hw1 : |lamR (frac0 (v η1))| ≤ G.r0 / 4 := hxi
    have hw2 : |lamT (frac0 (v η1))| ≤ G.r0 := het
    have hw := key _ _ hw1 hw2
    have ex1 : (v η1).1 - ((round (v η1).1 : ℤ) : ℝ) =
        lamR (frac0 (v η1)) + bgc * lamT (frac0 (v η1)) := id1 (frac0 (v η1))
    have ex2 : (v η1).2 - ((round (v η1).2 : ℤ) : ℝ) =
        -(bgc * lamR (frac0 (v η1))) + lamT (frac0 (v η1)) := id2 (frac0 (v η1))
    have hx1 : |(v η1).1 - ((round (v η1).1 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex1]; exact hw.1
    have hx2 : |(v η1).2 - ((round (v η1).2 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex2]; exact hw.2
    obtain ⟨kk, hkk⟩ : ∃ kk : ℝ × ℝ,
        kk = (((round (v η1).1 : ℤ) : ℝ), ((round (v η1).2 : ℤ) : ℝ)) := ⟨_, rfl⟩
    have hfr : ∀ η ∈ U, frac0 (v η) = v η - kk := by
      intro η hη
      have h1 : |(v η).1 - (v ξ).1| < 1/8 := hη.1.2
      have h2 : |(v η).2 - (v ξ).2| < 1/8 := hη.2
      have g1 : |(v η1).1 - (v ξ).1| < 1/8 := hη1U.1.2
      have g2 : |(v η1).2 - (v ξ).2| < 1/8 := hη1U.2
      obtain ⟨a1, a2⟩ := abs_lt.mp h1
      obtain ⟨a3, a4⟩ := abs_lt.mp h2
      obtain ⟨b1, b2⟩ := abs_lt.mp g1
      obtain ⟨b3, b4⟩ := abs_lt.mp g2
      obtain ⟨c1, c2⟩ := abs_le.mp hx1
      obtain ⟨c3, c4⟩ := abs_le.mp hx2
      have r1 : round (v η).1 = round (v η1).1 :=
        hround _ _ (abs_lt.mpr ⟨by linarith, by linarith⟩)
      have r2 : round (v η).2 = round (v η1).2 :=
        hround _ _ (abs_lt.mpr ⟨by linarith, by linarith⟩)
      rw [hkk]
      unfold frac0
      rw [r1, r2]
      rfl

    have hbase : ∀ i : Fin 3, DifferentiableAt ℝ (fun η : Cyl => baseC B γ.1 η i) ξ := by
      intro i
      obtain ⟨hO, hsm⟩ := geom_slow_base_smooth_v5 B hok
      have hmem : ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ) ∈
          {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
        show 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ simScale B.h ξ.2.1 (1 - ξ.2.2.1) < B.qB
        exact ⟨hr, ht, lt_of_lt_of_le hqξ hqs⟩
      have hg := ((hsm γ.1 i).contDiffAt (hO.mem_nhds hmem)).differentiableAt (by norm_num)
      have hπ : DifferentiableAt ℝ (fun η : Cyl => ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ)) ξ := by
        fun_prop
      have h2 := hg.comp ξ hπ
      exact h2

    have hZ : DifferentiableAt ℝ (fun η : Cyl => chartZ B.h γ.1 η) ξ := by
      simp only [chartZ, div_eq_mul_inv]
      fun_prop
    have hRC : DifferentiableAt ℝ (fun η : Cyl => RC γ.1 η) ξ := by
      simp only [RC, div_eq_mul_inv]
      fun_prop
    have hRC0 : RC γ.1 ξ ≠ 0 := by
      have : 0 < RC γ.1 ξ :=
        div_pos hr (Real.sqrt_pos.mpr (Real.rpow_pos_of_pos (by norm_num) _))
      exact this.ne'
    have hFang : DifferentiableAt ℝ (fun η : Cyl => Fang B γ.1 η) ξ := by
      simp only [Fang, div_eq_mul_inv]
      exact (hbase 1).mul (hRC.inv hRC0)
    have hT : DifferentiableAt ℝ (fun η : Cyl => lamT (v η - kk)) ξ := by
      simp only [hv, lamT, Jpow, div_eq_mul_inv]
      fun_prop
    have hmd : DifferentiableAt ℝ (fun η : Cyl =>
        pzr5 B G γ * chartZ B.h γ.1 η / epsb B.h γ.1 + sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 * RC γ.1 η
        - (lamT (v η - kk) + G.r0) / cib B.h γ.1 *
          (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2)) ξ := by
      simp only [div_eq_mul_inv]
      exact (((hZ.const_mul (pzr5 B G γ)).mul_const (epsb B.h γ.1)⁻¹).add
        (hRC.const_mul (sgn γ.2.2 * Bs5 B G γ * G.ustar * 2⁻¹))).sub
        (((hT.add_const G.r0).mul_const (cib B.h γ.1)⁻¹).mul
          ((hFang.const_mul (pang5 B G γ)).add ((hbase 2).const_mul (pzr5 B G γ))))

    have hev : phiL5 B G γ =ᶠ[nhds ξ] fun η : Cyl =>
        pzr5 B G γ * chartZ B.h γ.1 η / epsb B.h γ.1 + sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 * RC γ.1 η
        - (lamT (v η - kk) + G.r0) / cib B.h γ.1 *
          (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2) := by
      refine Filter.eventuallyEq_of_mem hUn (fun η hη => ?_)
      have hvco : vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = (lamT (v η - kk) + G.r0) / cib B.h γ.1 := by
        show (lamT (frac0 (v η)) + G.r0) / cib B.h γ.1 = _
        rw [hfr η hη]
      show phiL5 B G γ η = _
      unfold phiL5
      rw [hvco]
    have hp : DifferentiableAt ℝ (phiL5 B G γ) ξ := hmd.congr_of_eventuallyEq hev

    have hc : DifferentiableAt ℝ (fun η : Cyl => ((phiL5 B G γ η : ℝ) : ℂ)) ξ :=
      Complex.ofRealCLM.differentiableAt.comp ξ hp
    have hE : DifferentiableAt ℝ (fun η : Cyl =>
        Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ)))) ξ :=
      ((hc.const_mul ((kb B.h γ.1 : ℂ))).const_mul (Complex.I * (m : ℂ))).cexp
    rw [differentiableAt_pi]
    intro i
    exact (hai i).mul hE

theorem pq5_transport_rep : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (V : WC), (∀ γ m, ContDiffOn ℝ ∞ (V γ m) (DomC B.h (qsOf l0))) → (∀ γ m, m ≠ 1 → m ≠ -1 → V γ m = 0) → (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → V γ m ξ ≠ 0 → SuppW B G γ ξ) → (∀ (γ γ' : Lab) (m m' : ℤ), γ ≠ γ' → ∀ ξ ∈ DomC B.h (qsOf l0), V γ m ξ ≠ 0 → ξ ∉ tsupport (V γ' m')) → (∀ x t Y, corrOn B l0 x t → pwrW5 B G l0 x t Y = cyl2cart x (waveV5 B G V (thetaOf x) (ptOf x t Y))) → (∀ ξ ∈ DomC B.h (qsOf l0), ∃ T : Finset Lab, ∀ γ M, γ ∉ T → pq5QOf B G V γ M ξ = 0) ∧ ∀ x t Y, corrOn B l0 x t → pwrQ B G l0 x t Y = (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) • cyl2cart x (waveV5 B G (pq5QOf B G V) (thetaOf x) (ptOf x t Y)) :=
by
  intro B G hok hG

  obtain ⟨hh0, -, -, -, -, -, -, hqB0, hqB1, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 V hVs hVm hVsupp hdisj hrep => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le

  have hTr0 : ∀ (n : ℤ) (U : Fin 3 → ℂ) (c : Cyl → (Fin 3 → ℂ)) (ξ : Cyl), (∀ a, U a = 0) →
      pq5TrM B.h n U c ξ = 0 := by
    intro n U c ξ hU
    funext i
    fin_cases i <;> simp [pq5TrM, hU]
  have hQ0 : ∀ γ M ξ, (∀ m, V γ m ξ = 0) → pq5QOf B G V γ M ξ = 0 := by
    intro γ M ξ h
    unfold pq5QOf
    rw [Finset.sum_eq_zero, smul_zero]
    intro m _
    apply Finset.sum_eq_zero
    intro m' _
    have hU : ∀ a, modeCoef5 B G V γ m ξ a = 0 := fun a => by simp [modeCoef5, h m]
    have hU' : ∀ a, (fun i => starRingEnd ℂ (modeCoef5 B G V γ m ξ i)) a = 0 := fun a => by
      simp [hU a]
    rw [hTr0 _ _ _ _ hU, hTr0 _ _ _ _ hU']
    simp
  refine ⟨fun ξ hξ => ?_, fun x t Y hxt => ?_⟩
  ·
    have hfin := etaL_tsupport_finite B.h ξ hok.1 hξ.2.1
    refine ⟨hfin.toFinset, fun γ M hγ => hQ0 γ M ξ (fun m => ?_)⟩
    by_contra hne
    exact hγ ((Set.Finite.mem_toFinset hfin).mpr (hVsupp γ m ξ hξ hne).2.1)
  ·
    have hxt' : 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
    have hξD : ptOf x t Y ∈ DomC B.h (qsOf l0) := hxt
    have hq : 0 < qC B.h (ptOf x t Y) := (hok.1.1 (x 2) (1 - t) (by linarith [hxt'.2.1])).1
    obtain ⟨Y', hY'⟩ : ∃ Y' : ℝ × ℝ, Y' = Y - Yph B.h (rad x) t := ⟨_, rfl⟩
    have hζx : ptOf x t (Yph B.h (rad x) t + Y') = ptOf x t Y := by
      rw [hY']; simp
    obtain ⟨-, hCd⟩ := pq5_coef_diff B G l0 V hok hG hqB hVs hVsupp
    have hCdx : ∀ γ m, DifferentiableAt ℝ (modeCoef5 B G V γ m) (ptOf x t (Yph B.h (rad x) t + Y')) := by
      intro γ m
      rw [hζx]
      exact hCd γ m _ hξD

    obtain ⟨O, Γ, hO, hxO, hΓ, hexp⟩ := pq5_local_modes B G l0 V hok hVm hVsupp x t Y hxt
    rw [← hY'] at hexp
    have hFx : ∀ (n : ℤ) (c : Cyl → (Fin 3 → ℂ)), modeF5 B.h 0 t Y' n c x =
        cyl2cart x (fun i => (c (ptOf x t Y) i * Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re) := by
      intro n c
      simp only [modeF5, Real.rpow_zero, one_smul, hζx]
    have hFd : ∀ γ (m : ℤ), DifferentiableAt ℝ (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m)) x :=
      fun γ m => modeF5_differentiable_v5 B.h 0 t Y' _ _ x hok.1 hxt'.2.1 hxt'.1 (hCdx γ m)

    have hQdef : pwrQ B G l0 x t Y = fderiv ℝ (fun y => pwrW5 B G l0 y t (Yph B.h (rad y) t + Y')) x
        (pwrW5 B G l0 x t (Yph B.h (rad x) t + Y')) := by
      rw [hY']; rfl

    have hslice : (fun y => pwrW5 B G l0 y t (Yph B.h (rad y) t + Y')) =ᶠ[nhds x]
        (fun y => ∑ γ ∈ Γ, ∑ m ∈ ({1, -1} : Finset ℤ),
          modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m) y) := by
      filter_upwards [hO.mem_nhds hxO] with y hy
      obtain ⟨hcy, hey⟩ := hexp y hy
      rw [hrep y t _ hcy, hey]

    have hD : fderiv ℝ (fun y => pwrW5 B G l0 y t (Yph B.h (rad y) t + Y')) x =
        ∑ γ ∈ Γ, ∑ m ∈ ({1, -1} : Finset ℤ),
          fderiv ℝ (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m)) x := by
      rw [hslice.fderiv_eq, fderiv_fun_sum (fun γ _ => DifferentiableAt.fun_sum (fun m _ => hFd γ m))]
      refine Finset.sum_congr rfl (fun γ _ => ?_)
      exact fderiv_fun_sum (fun m _ => hFd γ m)

    have hu : pwrW5 B G l0 x t (Yph B.h (rad x) t + Y') =
        ∑ γ ∈ Γ, ∑ m ∈ ({1, -1} : Finset ℤ),
          modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m) x :=
      hslice.eq_of_nhds

    have hoff : ∀ γ' γ (m' m : ℤ), γ ≠ γ' →
        fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ') (modeCoef5 B G V γ' m')) x
          (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m) x) = 0 := by
      intro γ' γ m' m hne
      by_cases hV : V γ m (ptOf x t Y) = 0
      · have h0 : ∀ i, modeCoef5 B G V γ m (ptOf x t Y) i = 0 := fun i => by simp [modeCoef5, hV]
        rw [hFx]
        simp [cyl2cart, h0]
      · have hts := hdisj γ γ' m m' hne _ hξD hV
        have hev : modeCoef5 B G V γ' m' =ᶠ[nhds (ptOf x t (Yph B.h (rad x) t + Y'))] 0 := by
          rw [hζx]
          filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hts] with η hη
          funext i
          simp [modeCoef5, hη]
        rw [pq5_offdiag B.h t Y' _ _ x hxt'.1 hev]
        simp

    have hlin : ∀ (a b d : Fin 3 → ℝ) (s1 s2 s3 : ℝ),
        s1 • cyl2cart x a + s2 • cyl2cart x b + s3 • cyl2cart x d =
          cyl2cart x (fun i => s1 * a i + s2 * b i + s3 * d i) := by
      intro a b d s1 s2 s3
      simp only [cyl2cart, add_smul, smul_add, smul_smul]
      abel
    have hjet : ∀ (n' : ℤ) (c : Cyl → (Fin 3 → ℂ)) (v : Fin 3 → ℝ),
        DifferentiableAt ℝ c (ptOf x t (Yph B.h (rad x) t + Y')) →
        fderiv ℝ (modeF5 B.h 0 t Y' n' c) x (cyl2cart x v) =
          cyl2cart x (fun i => (pq5TrM B.h n' (fun a => ((v a : ℝ) : ℂ)) c (ptOf x t Y) i *
            Complex.exp (Complex.I * (n' : ℂ) * (thetaOf x : ℂ))).re) := by
      intro n' c v hc
      have hR := pq5_jet_R B.h t Y' n' c x hok.1 hxt'.2.1 hxt'.1 hc
      have hZ := pq5_jet_Z B.h t Y' n' c x hok.1 hxt'.2.1 hxt'.1 hc
      have hT := pq5_jet_Th B.h t Y' n' c x hok.1 hxt'.2.1 hxt'.1 hc
      rw [hζx] at hR hZ hT
      have e1 : cyl2cart x v = v 0 • eR x + v 1 • eTh x + v 2 • eZ := rfl
      rw [e1, map_add, map_add, map_smul, map_smul, map_smul, hR, hZ, hT, hlin]
      congr 1
      funext i
      rw [← Complex.re_ofReal_mul, ← Complex.re_ofReal_mul, ← Complex.re_ofReal_mul,
        ← Complex.add_re, ← Complex.add_re]
      congr 1
      fin_cases i <;> simp [pq5TrM, ptOf] <;> ring

    obtain ⟨X, hX⟩ : ∃ X : Lab → ℤ → ℤ → Fin 3 → ℝ, ∀ γ m m' i, X γ m m' i =
        ((1/2 : ℂ) * (pq5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G V γ m (ptOf x t Y)) (modeCoef5 B G V γ m') (ptOf x t Y) i * Complex.exp (Complex.I * ((m * pint5 B G γ + m' * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ)) + pq5TrM B.h (m' * pint5 B G γ) (fun a => starRingEnd ℂ (modeCoef5 B G V γ m (ptOf x t Y) a)) (modeCoef5 B G V γ m') (ptOf x t Y) i * Complex.exp (Complex.I * ((m' * pint5 B G γ - m * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ)))).re :=
      ⟨fun γ m m' i => ((1/2 : ℂ) * (pq5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G V γ m (ptOf x t Y)) (modeCoef5 B G V γ m') (ptOf x t Y) i * Complex.exp (Complex.I * ((m * pint5 B G γ + m' * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ)) + pq5TrM B.h (m' * pint5 B G γ) (fun a => starRingEnd ℂ (modeCoef5 B G V γ m (ptOf x t Y) a)) (modeCoef5 B G V γ m') (ptOf x t Y) i * Complex.exp (Complex.I * ((m' * pint5 B G γ - m * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ)))).re,
        fun _ _ _ _ => rfl⟩
    have hdiag : ∀ γ (m m' : ℤ),
        fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ) (modeCoef5 B G V γ m')) x
          (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m) x) = cyl2cart x (X γ m m') := by
      intro γ m m'
      rw [hFx (m * pint5 B G γ), hjet (m' * pint5 B G γ) (modeCoef5 B G V γ m') _ (hCdx γ m')]
      congr 1
      funext i
      rw [hX]
      exact pq5_trm_split B.h (m * pint5 B G γ) (m' * pint5 B G γ) (modeCoef5 B G V γ m (ptOf x t Y))
        (modeCoef5 B G V γ m') (ptOf x t Y) (thetaOf x) i

    have hRHS : (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) •
        cyl2cart x (waveV5 B G (pq5QOf B G V) (thetaOf x) (ptOf x t Y)) =
          cyl2cart x (fun i => ∑ γ ∈ Γ, ∑ m ∈ ({1, -1} : Finset ℤ), ∑ m' ∈ ({1, -1} : Finset ℤ),
            X γ m m' i) := by
      have hsm : ∀ (c : ℝ) (u : Fin 3 → ℝ), c • cyl2cart x u = cyl2cart x (c • u) := by
        intro c u
        simp only [cyl2cart, Pi.smul_apply, smul_eq_mul, smul_add, smul_smul]
      rw [hsm, pq5_regroup B G V (ptOf x t Y) (thetaOf x) Γ hq hΓ]
      simp only [hX]
    obtain ⟨Lc, hLc⟩ : ∃ Lc : (Fin 3 → ℝ) →+ ℝ³, ∀ u, Lc u = cyl2cart x u :=
      ⟨{ toFun := cyl2cart x
         map_zero' := by simp [cyl2cart]
         map_add' := fun u v => by simp only [cyl2cart, Pi.add_apply, add_smul]; abel },
        fun u => rfl⟩

    rw [hQdef, hD, hu, hRHS]
    simp only [sum_apply, map_sum]
    calc _ = ∑ γ' ∈ Γ, ∑ m' ∈ ({1, -1} : Finset ℤ), ∑ m ∈ ({1, -1} : Finset ℤ),
          cyl2cart x (X γ' m' m) := by
          refine Finset.sum_congr rfl (fun γ' hγ' => Finset.sum_congr rfl (fun m' _ => ?_))
          rw [Finset.sum_eq_single_of_mem γ' hγ' ?_]
          · exact Finset.sum_congr rfl (fun m _ => hdiag γ' m' m)
          · intro γ _ hne
            exact Finset.sum_eq_zero (fun m _ => hoff γ γ' m m' (Ne.symm hne))
      _ = _ := by
          simp only [← hLc, ← map_sum]
          congr 1
          funext i
          simp only [Finset.sum_apply]

theorem pq5_label_disjoint : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (V : WC), (∀ γ m, ContinuousOn (V γ m) (DomC B.h (qsOf l0))) → (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → V γ m ξ ≠ 0 → SuppW B G γ ξ) → ∀ (γ γ' : Lab) (m m' : ℤ), γ ≠ γ' → ∀ ξ ∈ DomC B.h (qsOf l0), V γ m ξ ≠ 0 → ξ ∉ tsupport (V γ' m') :=
by
  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 V hC hS γ γ' m m' hγγ' ξ hξD hV hξ => ?_⟩

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hle : qsOf l0 < B.qB := by
    rw [hQb]
    exact lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0
  have hDsub : DomC B.h (qsOf l0) ⊆ DomC B.h B.qB :=
    fun η hη => ⟨hη.1, hη.2.1, lt_trans hη.2.2 hle⟩

  have hcont : ContinuousOn (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h4c := hok.1.2.2.2.1.continuousOn
    have hm : MapsTo (fun η : Cyl => (η.2.1, 1 - η.2.2.1)) {η : Cyl | η.2.2.1 < 1} (univ ×ˢ Ioi 0) := by
      intro η hη
      have hη' : η.2.2.1 < 1 := hη
      exact ⟨mem_univ _, show (0:ℝ) < 1 - η.2.2.1 by linarith⟩
    exact h4c.comp (f := fun η : Cyl => (η.2.1, 1 - η.2.2.1)) (Continuous.continuousOn (by fun_prop)) hm
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have e : DomC B.h (qsOf l0) = ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) ∩
        (fun η : Cyl => qC B.h η) ⁻¹' Iio (qsOf l0) := by
      ext η
      simp only [DomC, mem_inter_iff, mem_setOf_eq, mem_preimage, mem_Iio]
      tauto
    rw [e]
    exact (hcont.mono inter_subset_right).isOpen_inter_preimage
      ((isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)) isOpen_Iio

  have hη : ∀ γ : Lab, ContinuousOn (etaL B.h γ) (DomC B.h B.qB) :=
    fun γ => ((etaL_class_v5 B hok).1 γ).continuousOn

  have hξc : ξ ∈ closure (Function.support (V γ' m')) := hξ
  have hN : IsOpen (DomC B.h (qsOf l0) ∩ (V γ m) ⁻¹' {0}ᶜ) :=
    (hC γ m).isOpen_inter_preimage hDopen isOpen_compl_singleton
  obtain ⟨ξ1, hξ1N, hξ1V'⟩ := mem_closure_iff.mp hξc _ hN ⟨hξD, hV⟩
  have hN1 : IsOpen ((DomC B.h (qsOf l0) ∩ (V γ m) ⁻¹' {0}ᶜ) ∩ (V γ' m') ⁻¹' {0}ᶜ) :=
    ((hC γ' m').mono inter_subset_left).isOpen_inter_preimage hN isOpen_compl_singleton
  have key : ∀ η ∈ (DomC B.h (qsOf l0) ∩ (V γ m) ⁻¹' {0}ᶜ) ∩ (V γ' m') ⁻¹' {0}ᶜ,
      SuppW B G γ η ∧ SuppW B G γ' η :=
    fun η hη => ⟨hS γ m η hη.1.1 hη.1.2, hS γ' m' η hη.1.1 hη.2⟩
  have hξ1N1 : ξ1 ∈ (DomC B.h (qsOf l0) ∩ (V γ m) ⁻¹' {0}ᶜ) ∩ (V γ' m') ⁻¹' {0}ᶜ :=
    ⟨hξ1N, Function.mem_support.mp hξ1V'⟩

  have hc1 : ξ1 ∈ closure (Function.support (etaL B.h γ)) := (key ξ1 hξ1N1).1.2.1
  obtain ⟨ξ2, hξ2N1, hξ2e⟩ := mem_closure_iff.mp hc1 _ hN1 hξ1N1
  have hN2 : IsOpen (((DomC B.h (qsOf l0) ∩ (V γ m) ⁻¹' {0}ᶜ) ∩ (V γ' m') ⁻¹' {0}ᶜ) ∩
      (etaL B.h γ) ⁻¹' {0}ᶜ) :=
    ((hη γ).mono (fun η hη' => hDsub hη'.1.1)).isOpen_inter_preimage hN1 isOpen_compl_singleton

  have hc2 : ξ2 ∈ closure (Function.support (etaL B.h γ')) := (key ξ2 hξ2N1).2.2.1
  obtain ⟨ξ3, ⟨hξ3N1, hξ3e⟩, hξ3e'⟩ :=
    mem_closure_iff.mp hc2 _ hN2 ⟨hξ2N1, Function.mem_support.mp hξ2e⟩
  obtain ⟨hs, hs'⟩ := key ξ3 hξ3N1

  have he : etaL B.h γ ξ3 ≠ 0 := hξ3e
  have he' : etaL B.h γ' ξ3 ≠ 0 := Function.mem_support.mp hξ3e'
  have hdisj := hG.2.1 γ γ' hγγ' hs.1.1 hs'.1.1 ⟨ξ3, hDsub hξ3N1.1.1, he, he'⟩

  have hr0 : 0 < G.r0 := hG.1.1
  have hY : ξ3.2.2.2 ∈ closure (rectAbs B G γ (2 * G.r0)) :=
    subset_closure (show inRect B.h γ (G.ctr γ) (2 * G.r0) ξ3.2.2.2 from
      ⟨by linarith [hs.2.2.1], by linarith [hs.2.2.2.1]⟩)
  have hY' : ξ3.2.2.2 ∈ closure (rectAbs B G γ' (2 * G.r0)) :=
    subset_closure (show inRect B.h γ' (G.ctr γ') (2 * G.r0) ξ3.2.2.2 from
      ⟨by linarith [hs'.2.2.1], by linarith [hs'.2.2.2.1]⟩)
  exact Set.disjoint_left.mp hdisj hY hY'

theorem pq5_phase_free : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G →
  (∀ (γ : Lab) (M : ℤ) (ξ : Cyl), M ≠ 2 → M ≠ -2 → pq5Osc (pq5QOf B G (pq5Vw B G)) γ M ξ = 0) ∧
  ∀ (l0 : ℕ), qsOf l0 ≤ B.qB → InWg5 B G (qsOf l0) (1/2) (wmoAmp5 B G (primState5 B G).Aw) →
  ∀ (γ : Lab) (s : ℤ), (s = 1 ∨ s = -1) → ∀ ξ ∈ DomC B.h (qsOf l0),
    pq5Osc (pq5QOf B G (pq5Vw B G)) γ (2 * s) ξ =
      (1/2 : ℂ) • (pq5T B G γ s (wmoAmp5 B G (primState5 B G).Aw γ s ξ) (wmoAmp5 B G (primState5 B G).Aw γ s) ξ
        + pq5T B G γ s (fun i => starRingEnd ℂ (wmoAmp5 B G (primState5 B G).Aw γ (-s) ξ i))
            (wmoAmp5 B G (primState5 B G).Aw γ s) ξ) :=
by
  intro B G hok hG
  refine ⟨?_, ?_⟩
  · intro γ M ξ h2 hm2
    unfold pq5Osc
    split_ifs with h0
    · rfl
    · unfold pq5QOf
      rw [Finset.sum_eq_zero, smul_zero]
      intro m hm
      rw [Finset.sum_eq_zero]
      intro m' hm'
      simp only [Finset.mem_insert, Finset.mem_singleton] at hm hm'
      rw [if_neg (show ¬ (m + m' = M) by omega), if_neg (show ¬ (m' - m = M) by omega), add_zero]
  · intro l0 hqs hW γ s hs ξ hξ
    obtain ⟨hΩo, hqCs, hqpos, -, -, -⟩ := domc_open_calculus B (qsOf l0) hok
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
    have hQb : 0 < Qb γ.1 := by unfold Qb; positivity
    have hkb : 0 < kb B.h γ.1 := by
      unfold kb
      exact Nat.ceil_pos.mpr (Real.rpow_pos_of_pos (by unfold epsb; exact Real.rpow_pos_of_pos hQb _) _)

    have hqd : ∀ η ∈ DomC B.h (qsOf l0), HasFDerivAt (qC B.h) (fderiv ℝ (qC B.h) η) η := fun η hη =>
      ((hqCs.differentiableOn (by norm_num)).differentiableAt (hΩo.mem_nhds hη)).hasFDerivAt
    have hchain : ∀ η ∈ DomC B.h (qsOf l0), ∀ p : ℝ, HasFDerivAt (fun x => qC B.h x ^ p)
        ((p * qC B.h η ^ (p - 1)) • fderiv ℝ (qC B.h) η) η :=
      fun η hη p => (hqd η hη).rpow_const (Or.inl (hqpos η hη).ne')
    have hdzp : ∀ η ∈ DomC B.h (qsOf l0), ∀ p : ℝ,
        dZ (fun x => qC B.h x ^ p) η = p * qC B.h η ^ (p - 1) * dZ (qC B.h) η := by
      intro η hη p
      unfold dZ
      rw [(hchain η hη p).fderiv]
      rfl
    have hlog : ∀ η ∈ DomC B.h (qsOf l0),
        dZ (fun x => Real.log (qC B.h x)) η = (qC B.h η)⁻¹ * dZ (qC B.h) η := by
      intro η hη
      unfold dZ
      rw [((hqd η hη).log (hqpos η hη).ne').fderiv]
      rfl
    have hqR : fderiv ℝ (qC B.h) ξ (1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) = 0 := by
      have hl : HasDerivAt (fun t : ℝ => ξ + t • ((1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) : Cyl))
          ((1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) : Cyl) 0 := by
        simpa using ((hasDerivAt_id (0:ℝ)).smul_const
          ((1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) : Cyl)).const_add ξ
      have h1 := (hqd ξ hξ).comp_hasDerivAt_of_eq (0:ℝ) hl (by simp)
      have hc : (qC B.h ∘ fun t : ℝ => ξ + t • ((1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) : Cyl))
          = fun _ => qC B.h ξ := by
        funext t
        simp [qC]
      rw [hc] at h1
      exact h1.unique (hasDerivAt_const 0 _)

    have hfac : ∀ (m : ℤ), ∀ η ∈ DomC B.h (qsOf l0), pq5Vw B G γ m η =
        ((qC B.h η ^ (-(Aex B.h)) : ℝ) : ℂ) • wmoAmp5 B G (primState5 B G).Aw γ m η := by
      intro m η hη
      have hq := hqpos η hη
      have haq : qC B.h η ^ (-(Aex B.h)) * qC B.h η ^ (1/2:ℝ) = qC B.h η ^ (-B.h) := by
        rw [← Real.rpow_add hq]; congr 1; unfold Aex; ring
      have E1 : qC B.h η ^ (-B.h) * Qb γ.1 ^ (-(1/2:ℝ)) =
          qC B.h η ^ (-(Aex B.h)) * (qC B.h η / Qb γ.1) ^ (1/2:ℝ) := by
        rw [Real.div_rpow hq.le hQb.le, Real.rpow_neg hQb.le, ← haq]; ring
      have E2 : dZ (fun x => qC B.h x ^ (-B.h)) η =
          -(qC B.h η ^ (-(Aex B.h)) * (B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun x => Real.log (qC B.h x)) η)) := by
        rw [hdzp η hη, hlog η hη, Real.rpow_sub_one hq.ne', ← haq]; ring
      funext i
      simp only [pq5Vw, Pi.add_apply, Pi.smul_apply, smul_eq_mul, E1, E2, wmoAmp5, rotC]
      fin_cases i <;> simp [Complex.ofReal_mul, Complex.ofReal_neg] <;> ring

    have hD : ∀ (m : ℤ) (i : Fin 3),
        modeCoef5 B G (pq5Vw B G) γ m ξ i = ((qC B.h ξ ^ (-(Aex B.h)) : ℝ) : ℂ) *
          wmoAmp5 B G (primState5 B G).Aw γ m ξ i *
          Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) ∧
        dR B.h (modeCoef5 B G (pq5Vw B G) γ m) ξ i = ((qC B.h ξ ^ (-(Aex B.h)) : ℝ) : ℂ) *
          (dR B.h (fun η => wmoAmp5 B G (primState5 B G).Aw γ m η i) ξ + Complex.I * (m : ℂ) *
            (kb B.h γ.1 : ℂ) * ((dR B.h (phiL5 B G γ) ξ : ℝ) : ℂ) * wmoAmp5 B G (primState5 B G).Aw γ m ξ i) *
          Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) ∧
        dZ (modeCoef5 B G (pq5Vw B G) γ m) ξ i = ((qC B.h ξ ^ (-(Aex B.h)) : ℝ) : ℂ) *
          (dZ (fun η => wmoAmp5 B G (primState5 B G).Aw γ m η i) ξ + Complex.I * (m : ℂ) *
            (kb B.h γ.1 : ℂ) * ((dZ (phiL5 B G γ) ξ : ℝ) : ℂ) * wmoAmp5 B G (primState5 B G).Aw γ m ξ i
            - ((Aex B.h * dZ (fun η => Real.log (qC B.h η)) ξ : ℝ) : ℂ) * wmoAmp5 B G (primState5 B G).Aw γ m ξ i) *
          Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) := by
      intro m i
      have hK := modeCoef5_differentiable_v5 B G hok hG (qsOf l0) (1/2) _ hqs hW γ m ξ hξ
      have hph := wmo_phase_deriv_v5 B G hok hG (qsOf l0) (1/2) _ hqs hW γ m ξ hξ i
      have hF := (hchain ξ hξ (-(Aex B.h))).smul hK.hasFDerivAt
      have hev : modeCoef5 B G (pq5Vw B G) γ m =ᶠ[nhds ξ]
          (fun x => qC B.h x ^ (-(Aex B.h))) • modeCoef5 B G (wmoAmp5 B G (primState5 B G).Aw) γ m := by
        filter_upwards [hΩo.mem_nhds hξ] with η hη
        funext j
        show modeCoef5 B G (pq5Vw B G) γ m η j = (qC B.h η ^ (-(Aex B.h))) •
          (modeCoef5 B G (wmoAmp5 B G (primState5 B G).Aw) γ m η j)
        simp only [modeCoef5, hfac m η hη, Pi.smul_apply, smul_eq_mul, Complex.real_smul]
        ring
      have hfd := hev.fderiv_eq.trans hF.fderiv
      have hbr : ∀ v : Cyl, (fderiv ℝ (modeCoef5 B G (wmoAmp5 B G (primState5 B G).Aw) γ m) ξ v) i =
          fderiv ℝ (fun η => modeCoef5 B G (wmoAmp5 B G (primState5 B G).Aw) γ m η i) ξ v := by
        intro v
        rw [(hasFDerivAt_pi'.1 hK.hasFDerivAt i).fderiv]
        rfl
      refine ⟨?_, ?_, ?_⟩
      · simp only [modeCoef5, hfac m ξ hξ, Pi.smul_apply, smul_eq_mul]
      · have h1 : dR B.h (modeCoef5 B G (pq5Vw B G) γ m) ξ i = qC B.h ξ ^ (-(Aex B.h)) •
            dR B.h (fun η => modeCoef5 B G (wmoAmp5 B G (primState5 B G).Aw) γ m η i) ξ := by
          unfold dR
          rw [hfd]
          simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
            ContinuousLinearMap.smulRight_apply, hqR, smul_zero, zero_smul, add_zero, Pi.smul_apply]
          rw [hbr]
        rw [h1, hph.1, Complex.real_smul]
        ring
      · have h1 : dZ (modeCoef5 B G (pq5Vw B G) γ m) ξ i = qC B.h ξ ^ (-(Aex B.h)) •
            dZ (fun η => modeCoef5 B G (wmoAmp5 B G (primState5 B G).Aw) γ m η i) ξ +
            ((-(Aex B.h)) * qC B.h ξ ^ (-(Aex B.h) - 1) * dZ (qC B.h) ξ) •
              modeCoef5 B G (wmoAmp5 B G (primState5 B G).Aw) γ m ξ i := by
          unfold dZ
          rw [hfd]
          simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
            ContinuousLinearMap.smulRight_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
          rw [hbr]
        rw [h1, hph.2, hlog ξ hξ, Real.rpow_sub_one hq0.ne']
        simp only [modeCoef5, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_neg,
          Complex.ofReal_div, Complex.ofReal_inv]
        ring
    have hv : ∀ i, modeCoef5 B G (pq5Vw B G) γ s ξ i = ((qC B.h ξ ^ (-(Aex B.h)) : ℝ) : ℂ) *
          wmoAmp5 B G (primState5 B G).Aw γ s ξ i *
          Complex.exp (Complex.I * (s : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) := fun i => (hD s i).1
    have hr := fun i => (hD s i).2.1
    have hz := fun i => (hD s i).2.2

    have ha0 : 0 < qC B.h ξ ^ (-(Aex B.h)) := Real.rpow_pos_of_pos hq0 _
    have hP : qC B.h ξ ^ (2 * Aex B.h + 1/2) / 2 =
        Real.sqrt (qC B.h ξ) / 2 / (qC B.h ξ ^ (-(Aex B.h)) * qC B.h ξ ^ (-(Aex B.h))) := by
      have h3 : qC B.h ξ ^ (2 * Aex B.h + 1/2) * (qC B.h ξ ^ (-(Aex B.h)) * qC B.h ξ ^ (-(Aex B.h))) =
          Real.sqrt (qC B.h ξ) := by
        rw [← Real.rpow_add hq0, ← Real.rpow_add hq0, Real.sqrt_eq_rpow]; congr 1; ring
      rw [← h3]
      field_simp
    have hQm : Qb γ.1 ^ (-(1/2:ℝ)) = (Real.sqrt (Qb γ.1))⁻¹ := by
      rw [Real.sqrt_eq_rpow, Real.rpow_neg hQb.le]
    have hac : ((qC B.h ξ ^ (-(Aex B.h)) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ha0.ne'
    have hsQ : ((Real.sqrt (Qb γ.1) : ℝ) : ℂ) ≠ 0 :=
      Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr hQb).ne'
    have hkc : ((kb B.h γ.1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hkb.ne'
    have hrc : ((ξ.1 : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hξ'.1.ne'
    have hcore : ∀ (u U : Fin 3 → ℂ), (∀ j, U j = ((qC B.h ξ ^ (-(Aex B.h)) : ℝ) : ℂ) * u j *
          Complex.exp (Complex.I * (s : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)))) →
        ((qC B.h ξ ^ (2 * Aex B.h + 1/2) / 2 : ℝ) : ℂ) •
          pq5TrM B.h (s * pint5 B G γ) U (modeCoef5 B G (pq5Vw B G) γ s) ξ
        = ((1/2 : ℂ) * (Complex.exp (Complex.I * (s : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
            Complex.exp (Complex.I * (s : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))) •
          pq5T B G γ s u (wmoAmp5 B G (primState5 B G).Aw γ s) ξ := by
      intro u U hU
      rw [hP]
      funext i
      fin_cases i <;>
        simp only [pq5TrM, pq5T, Pi.smul_apply, smul_eq_mul, hU, hv, hr, hz, crossC, dotProduct,
          Fin.sum_univ_three, nPhi5, DrC, DzC, pang5, RC, hQm, Matrix.cons_val_zero, Matrix.cons_val_one,
          Matrix.head_cons, Matrix.cons_val_two, Matrix.tail_cons, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk,
          Fin.isValue, Complex.ofReal_mul, Complex.ofReal_div, Complex.ofReal_inv, Complex.ofReal_neg,
          Complex.ofReal_natCast, Complex.ofReal_intCast, Int.cast_mul] <;>
        field_simp <;>
        push_cast <;>
        ring

    have h2s : 2 * s ≠ 0 := by rcases hs with rfl | rfl <;> norm_num
    have hpair : ∀ (f g : ℤ → ℤ → (Fin 3 → ℂ)),
        (∑ m ∈ ({1, -1} : Finset ℤ), ∑ m' ∈ ({1, -1} : Finset ℤ),
          ((if m + m' = 2 * s then f m m' else 0) + (if m' - m = 2 * s then g m m' else 0))) =
        f s s + g (-s) s := by
      intro f g
      rw [Finset.sum_pair (by norm_num), Finset.sum_pair (by norm_num), Finset.sum_pair (by norm_num)]
      rcases hs with rfl | rfl <;> norm_num <;> abel
    have hp := hpair
      (fun m m' => pq5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G (pq5Vw B G) γ m ξ)
        (modeCoef5 B G (pq5Vw B G) γ m') ξ)
      (fun m m' => pq5TrM B.h (m' * pint5 B G γ) (fun i => starRingEnd ℂ (modeCoef5 B G (pq5Vw B G) γ m ξ i))
        (modeCoef5 B G (pq5Vw B G) γ m') ξ)
    have hconjE : starRingEnd ℂ (Complex.exp (Complex.I * ((-s : ℤ) : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))
        = Complex.exp (Complex.I * (s : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) := by
      rw [← Complex.exp_conj]
      congr 1
      simp only [map_mul, Complex.conj_I, map_intCast, map_natCast, Complex.conj_ofReal]
      push_cast
      ring
    have hU2 : ∀ j, (fun i => starRingEnd ℂ (modeCoef5 B G (pq5Vw B G) γ (-s) ξ i)) j =
        ((qC B.h ξ ^ (-(Aex B.h)) : ℝ) : ℂ) * (fun i => starRingEnd ℂ (wmoAmp5 B G (primState5 B G).Aw γ (-s) ξ i)) j *
          Complex.exp (Complex.I * (s : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) := by
      intro j
      simp only []
      rw [(hD (-s) j).1, map_mul, map_mul, Complex.conj_ofReal, hconjE]
    have hEE : Complex.exp (Complex.I * (s : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
        Complex.exp (Complex.I * (s : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) =
        Complex.exp (Complex.I * ((2 * s : ℤ) : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) := by
      rw [← Complex.exp_add]
      congr 1
      push_cast
      ring
    have hsm : ∀ (x y : ℂ) (v : Fin 3 → ℂ), (x * y) • v = y • (x • v) := fun x y v => by
      rw [mul_comm, mul_smul]
    show (if 2 * s = 0 then 0 else pq5QOf B G (pq5Vw B G) γ (2 * s) ξ) = _
    rw [if_neg h2s]
    unfold pq5QOf
    rw [hp, hsm, smul_add, hcore _ _ hv, hcore _ _ hU2, ← smul_add, smul_smul, hEE]
    congr 1
    rw [mul_left_comm, inv_mul_cancel₀ (Complex.exp_ne_zero _), mul_one]

theorem penv5_le_one_v5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (v : ℝ), 0 < G.r0 → 0 ≤ v → Penv5 B G γ v ≤ 1 :=
by
  intro B G γ v hr0 hv

  have hQb : 0 < Qb γ.1 := by unfold Qb; exact Real.rpow_pos_of_pos (by norm_num) _
  have hep : 0 < epsb B.h γ.1 := by unfold epsb; exact Real.rpow_pos_of_pos hQb _
  have hkb : (0:ℝ) < (kb B.h γ.1 : ℝ) := by
    unfold kb
    exact Nat.cast_pos.mpr (Nat.ceil_pos.mpr (Real.rpow_pos_of_pos hep _))
  have hc : 0 < epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 := mul_pos hep (pow_pos hkb 2)
  have hTgc : (0:ℝ) < Tgc := by unfold Tgc; positivity
  have hcib : 0 < cib B.h γ.1 := by
    unfold cib; exact mul_pos (zpow_pos hTgc _) (Real.rpow_pos_of_pos hQb _)
  have hL : 0 < Lsb B.h G.r0 γ.1 := by unfold Lsb; exact div_pos (by linarith) hcib
  have hlam : 0 ≤ lam0_5 B G γ := by unfold lam0_5; exact Real.sqrt_nonneg _
  have hsg : sgn γ.2.2 ^ 2 = 1 := by unfold sgn; split_ifs <;> norm_num
  have hU1 : (1:ℝ) ≤ 1 + G.ustar ^ 2 := by linarith [sq_nonneg G.ustar]
  have hP : 0 < (1 + G.ustar ^ 2) ^ (3/2:ℝ) := Real.rpow_pos_of_pos (by linarith) _
  have hBs : Bs5 B G γ ^ 2 = lam0_5 B G γ /
      (epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * (1 + G.ustar ^ 2) ^ (3/2:ℝ)) := by
    unfold Bs5
    rw [Real.sq_sqrt (div_nonneg hlam (mul_pos hc hP).le)]

  have key : ∀ (lam c P A : ℝ), 0 ≤ lam → 0 < c → 0 < P → 1 ≤ A →
      (A * Real.sqrt A ≤ P → 0 ≤ lam / Real.sqrt A - c * (lam / (c * P)) * A) ∧
      (P ≤ A * Real.sqrt A → lam / Real.sqrt A - c * (lam / (c * P)) * A ≤ 0) := by
    intro lam c P A hlam hc hP hA
    have hsA : 0 < Real.sqrt A := Real.sqrt_pos.mpr (by linarith)
    have hsq : Real.sqrt A * Real.sqrt A = A := Real.mul_self_sqrt (by linarith)
    have e : c * (lam / (c * P)) * A = lam * A / P := by field_simp
    rw [e]
    constructor
    · intro h
      rw [sub_nonneg, div_le_div_iff₀ hP hsA]
      have := mul_le_mul_of_nonneg_left h hlam
      calc lam * A * Real.sqrt A = lam * (A * Real.sqrt A) := by ring
        _ ≤ lam * P := this
    · intro h
      rw [sub_nonpos, div_le_div_iff₀ hsA hP]
      have := mul_le_mul_of_nonneg_left h hlam
      calc lam * P ≤ lam * (A * Real.sqrt A) := this
        _ = lam * A * Real.sqrt A := by ring

  have r32 : ∀ x : ℝ, 0 < x → x ^ (3/2:ℝ) = x * Real.sqrt x := by
    intro x hx
    rw [Real.sqrt_eq_rpow, show (3/2:ℝ) = 1 + 1/2 by norm_num, Real.rpow_add hx, Real.rpow_one]
  have mono : ∀ x y : ℝ, 0 < x → x ≤ y → x * Real.sqrt x ≤ y * Real.sqrt y := by
    intro x y hx hxy
    rw [← r32 x hx, ← r32 y (lt_of_lt_of_le hx hxy)]
    exact Real.rpow_le_rpow hx.le hxy (by norm_num)
  have hsco : ∀ w, sco B G γ w ^ 2 = G.ustar ^ 2 * (1/2 + w / Lsb B.h G.r0 γ.1) ^ 2 := by
    intro w
    unfold sco
    have : G.ustar / 2 + G.ustar * w / Lsb B.h G.r0 γ.1 = G.ustar * (1/2 + w / Lsb B.h G.r0 γ.1) := by
      ring
    rw [this, mul_pow, hsg, one_mul, mul_pow]

  have s2 : ∀ (g : ℝ → ℝ) (m : ℝ), (∀ w, 0 ≤ w → w ≤ m → 0 ≤ g w) → (∀ w, m ≤ w → g w ≤ 0) →
      ∫ w in m..v, g w ≤ 0 := by
    intro g m h1 h2
    rcases le_or_gt m v with hle | hlt
    · have h3 : 0 ≤ ∫ w in m..v, -g w :=
        intervalIntegral.integral_nonneg hle (fun w hw => neg_nonneg.mpr (h2 w hw.1))
      rw [intervalIntegral.integral_neg] at h3
      linarith
    · rw [intervalIntegral.integral_symm]
      have h3 : 0 ≤ ∫ w in v..m, g w :=
        intervalIntegral.integral_nonneg hlt.le (fun w hw => h1 w (le_trans hv hw.1) hw.2)
      linarith
  have hUr := r32 (1 + G.ustar ^ 2) (by linarith)
  unfold Penv5
  rw [Real.exp_le_one_iff]
  apply s2
  · intro w h0 h1
    have hA : (1:ℝ) ≤ 1 + sco B G γ w ^ 2 := by linarith [sq_nonneg (sco B G γ w)]
    have ht0 : 0 ≤ w / Lsb B.h G.r0 γ.1 := div_nonneg h0 hL.le
    have ht1 : w / Lsb B.h G.r0 γ.1 ≤ 1/2 := by
      rw [div_le_iff₀ hL]; linarith
    have ht2 : (1/2 + w / Lsb B.h G.r0 γ.1) ^ 2 ≤ 1 := by
      have a1 : 0 ≤ 1/2 + w / Lsb B.h G.r0 γ.1 := by linarith
      have a2 : 1/2 + w / Lsb B.h G.r0 γ.1 ≤ 1 := by linarith
      exact pow_le_one₀ a1 a2
    have hAU : 1 + sco B G γ w ^ 2 ≤ 1 + G.ustar ^ 2 := by
      rw [hsco w]
      have := mul_le_of_le_one_right (sq_nonneg G.ustar) ht2
      linarith
    have hm := mono _ _ (by linarith) hAU
    rw [← hUr] at hm
    show 0 ≤ lam0_5 B G γ / Real.sqrt (1 + sco B G γ w ^ 2)
      - epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 * (1 + sco B G γ w ^ 2)
    rw [hBs]
    exact (key _ _ _ _ hlam hc hP hA).1 hm
  · intro w h1
    have hA : (1:ℝ) ≤ 1 + sco B G γ w ^ 2 := by linarith [sq_nonneg (sco B G γ w)]
    have ht1 : 1/2 ≤ w / Lsb B.h G.r0 γ.1 := by
      rw [le_div_iff₀ hL]; linarith
    have ht2 : 1 ≤ (1/2 + w / Lsb B.h G.r0 γ.1) ^ 2 := by
      have a2 : 1 ≤ 1/2 + w / Lsb B.h G.r0 γ.1 := by linarith
      exact one_le_pow₀ a2
    have hAU : 1 + G.ustar ^ 2 ≤ 1 + sco B G γ w ^ 2 := by
      rw [hsco w]
      have := le_mul_of_one_le_right (sq_nonneg G.ustar) ht2
      linarith
    have hm := mono _ _ (by linarith) hAU
    rw [← hUr] at hm
    show lam0_5 B G γ / Real.sqrt (1 + sco B G γ w ^ 2)
      - epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 * (1 + sco B G γ w ^ 2) ≤ 0
    rw [hBs]
    exact (key _ _ _ _ hlam hc hP hA).2 hm

theorem pq5_prod_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
  ∀ (α β : ℝ) (c : ℂ) (a : Lab → ℤ → Cyl → ℂ) (b : WC) (H' : Finset ℤ) (σ τ : ℤ → ℤ), (0 : ℤ) ∉ H' →
  InWg5 B G (qsOf l0) α a → InWg5 B G (qsOf l0) β b →
  InWg5 B G (qsOf l0) (α + β) (fun γ M ξ => if M ∈ H' then c • (a γ (σ M) ξ • b γ (τ M) ξ) else 0) :=
by
  intro B G hok hG
  obtain ⟨lP, hPs⟩ := pulse_support_good_v5 B G hok hG
  refine ⟨lP, fun l0 hl0 α β c a b H' σ τ hH0 ha hb => ?_⟩
  have hSupp := hPs l0 hl0 α a ha

  obtain ⟨Bl, hBl⟩ : ∃ Bl : ℂ →L[ℝ] (Fin 3 → ℂ) →L[ℝ] (Fin 3 → ℂ),
      ∀ u v, Bl u v = c • (u • v) :=
    ⟨(ContinuousLinearMap.lsmul ℝ ℂ).comp (ContinuousLinearMap.mul ℝ ℂ c), fun u v => by
      rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.lsmul_apply,
        ContinuousLinearMap.mul_apply', mul_smul]⟩
  have hP : ∀ (γ : Lab) (M : ℤ), M ∈ H' →
      (fun ξ => if M ∈ H' then c • (a γ (σ M) ξ • b γ (τ M) ξ) else 0) =
        fun η => Bl (a γ (σ M) η) (b γ (τ M) η) := by
    intro γ M hM; funext ξ; rw [if_pos hM, hBl]

  have hLeib : ∀ (f : Cyl → ℂ) (g : Cyl → (Fin 3 → ℂ)) (U : Set Cyl) (ξ : Cyl) (k : ℕ), IsOpen U → ξ ∈ U →
      ContDiffOn ℝ k f U → ContDiffOn ℝ k g U →
      NB B.h (fun η => Bl (f η) (g η)) k ξ ≤
        ‖Bl‖ * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB B.h f i ξ * NB B.h g (k - i) ξ := by
    intro f g U ξ k hU hξ hf hg
    unfold NB
    generalize Lnorm B.h ξ = L
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
    have hsm' : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : Cyl → V),
        ContDiffOn ℝ k F U → ContDiffOn ℝ k (fun z => F (ξ + z)) s := by
      intro V _ _ F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : Cyl → V),
        ContDiffOn ℝ k F U → ContDiffOn ℝ k (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
      intro V _ _ F hF
      exact (hsm' F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
    have key : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : Cyl → V),
        ContDiffOn ℝ k F U → ∀ i : ℕ, i ≤ k →
        iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
          (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
      intro V _ _ F hF i hi
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm' F hF) hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
      calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
              (fun _ => L) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
              (fun _ => L) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
              (fun _ => L) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
    have hfg : ContDiffOn ℝ k (fun η => Bl (f η) (g η)) U :=
      (contDiffOn_const.clm_apply hf).clm_apply hg
    have leib := Bl.norm_iteratedFDerivWithin_le_of_bilinear (hsmO f hf) (hsmO g hg)
      hO.uniqueDiffOn h0O (n := k) le_rfl
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => Bl (f (ξ + L y)) (g (ξ + L y))) k hO h0O]
      at leib
    rw [← key _ hfg k le_rfl]
    calc ‖iteratedFDeriv ℝ k (fun z => (fun η => Bl (f η) (g η)) (ξ + L z)) 0‖
        = ‖iteratedFDeriv ℝ k (fun y => Bl (f (ξ + L y)) (g (ξ + L y))) 0‖ := rfl
      _ ≤ _ := leib
      _ = _ := by
        congr 1
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (k - i) hO h0O,
          key f hf i hik, key g hg (k - i) (Nat.sub_le k i)]

  have hNB0 : ∀ (f : Cyl → (Fin 3 → ℂ)) (ξ : Cyl) (k : ℕ),
      f =ᶠ[nhds ξ] (fun _ => (0 : Fin 3 → ℂ)) → NB B.h f k ξ = 0 := by
    intro f ξ k hev
    unfold NB
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_zero]
    have e : ((0 : Cyl → ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) (Fin 3 → ℂ)) ξ
        ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) = 0 := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e, norm_zero]

  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, haa, hab⟩ := hok.2.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hDq : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ ∧ 1 ≤ SC B.h ξ := by
    intro ξ hξ
    obtain ⟨-, e2, -⟩ := hξ
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    refine ⟨hq0, ?_⟩
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hEdge : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X ∧
      0 < edgeDist B.Xa B.Xb X ∧ edgeDist B.Xa B.Xb X ≤ 1 := by
    intro X e1 e2
    refine ⟨?_, ?_, min_le_left _ _⟩
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · have hX : 0 < X := lt_trans hXa e1
      have l1 : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr e1)
      have l2 : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX).mpr e2)
      exact lt_min one_pos (lt_min l1 l2)
  have hE1 : ∀ X : ℝ, Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab X) ≤ 1 := by
    intro X
    have hew : edgeWeight B.Xa B.Xb B.aa B.ab X ≤ 1 := by
      unfold edgeWeight
      split_ifs
      · apply Real.exp_le_one_iff.mpr
        have t1 := div_nonneg haa.le (sq_nonneg (Real.log (X / B.Xa)))
        have t2 := div_nonneg hab.le (sq_nonneg (Real.log (B.Xb / X)))
        linarith
      · norm_num
    calc Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab X) ≤ Real.sqrt 1 := Real.sqrt_le_sqrt hew
      _ = 1 := Real.sqrt_one
  obtain ⟨-, sa, dka, pa, a5⟩ := ha
  obtain ⟨-, sb, dkb, -, b5⟩ := hb
  choose Ca ba da hA using a5
  choose Cb bb db hB using b5

  have comb : ∀ (k : ℕ) (q S E e P K : ℝ) (nA nB : ℕ → ℝ), 0 < q → 1 ≤ S → 0 ≤ E → E ≤ 1 →
      0 < e → e ≤ 1 → 0 ≤ P → P ≤ 1 → 0 ≤ K → (∀ i, 0 ≤ nA i) → (∀ j, 0 ≤ nB j) →
      (∀ i, i ≤ k → nA i ≤ Ca i * q ^ (B.h * α) * S ^ (ba i) * E * e ^ (-(da i)) * P) →
      (∀ j, j ≤ k → nB j ≤ Cb j * q ^ (B.h * β) * S ^ (bb j) * E * e ^ (-(db j)) * P) →
      K * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * nA i * nB (k - i) ≤
        (K * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |Ca i| * |Cb (k - i)|) *
          q ^ (B.h * (α + β)) *
          S ^ ((∑ j ∈ Finset.range (k + 1), |ba j|) + ∑ j ∈ Finset.range (k + 1), |bb j|) * E *
          e ^ (-((∑ j ∈ Finset.range (k + 1), |da j|) + ∑ j ∈ Finset.range (k + 1), |db j|)) * P := by
    intro k q S E e P K nA nB hq hS hE hE1' he0 he1 hP0 hP1 hK hnA hnB hbA hbB
    have hS0 : 0 < S := by linarith
    obtain ⟨Bs, hBs⟩ : ∃ Bs : ℝ,
        Bs = (∑ j ∈ Finset.range (k + 1), |ba j|) + ∑ j ∈ Finset.range (k + 1), |bb j| := ⟨_, rfl⟩
    obtain ⟨Ds, hDs⟩ : ∃ Ds : ℝ,
        Ds = (∑ j ∈ Finset.range (k + 1), |da j|) + ∑ j ∈ Finset.range (k + 1), |db j| := ⟨_, rfl⟩
    rw [← hBs, ← hDs]
    obtain ⟨X, hXdef⟩ : ∃ X : ℝ, X = q ^ (B.h * (α + β)) * S ^ Bs * E * e ^ (-Ds) * P := ⟨_, rfl⟩
    have hEE : E * E ≤ E := mul_le_of_le_one_left hE hE1'
    have hPP : P * P ≤ P := mul_le_of_le_one_left hP0 hP1
    have hterm : ∀ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * nA i * nB (k - i) ≤
        (k.choose i : ℝ) * |Ca i| * |Cb (k - i)| * X := by
      intro i hi
      have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hjk : k - i ≤ k := Nat.sub_le k i
      have hj : k - i ∈ Finset.range (k + 1) := Finset.mem_range.mpr (by omega)
      obtain ⟨Wa, hWa⟩ : ∃ Wa : ℝ,
          Wa = q ^ (B.h * α) * S ^ (ba i) * E * e ^ (-(da i)) * P := ⟨_, rfl⟩
      obtain ⟨Wb, hWb⟩ : ∃ Wb : ℝ,
          Wb = q ^ (B.h * β) * S ^ (bb (k - i)) * E * e ^ (-(db (k - i))) * P := ⟨_, rfl⟩
      have pq1 : 0 ≤ q ^ (B.h * α) := Real.rpow_nonneg hq.le _
      have pq2 : 0 ≤ q ^ (B.h * β) := Real.rpow_nonneg hq.le _
      have hWa0 : 0 ≤ Wa := by
        rw [hWa]
        exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg pq1 (Real.rpow_nonneg hS0.le _)) hE)
          (Real.rpow_nonneg he0.le _)) hP0
      have hWb0 : 0 ≤ Wb := by
        rw [hWb]
        exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg pq2 (Real.rpow_nonneg hS0.le _)) hE)
          (Real.rpow_nonneg he0.le _)) hP0
      have a1 : nA i ≤ |Ca i| * Wa := by
        refine le_trans (hbA i hik) ?_
        have e' : Ca i * q ^ (B.h * α) * S ^ (ba i) * E * e ^ (-(da i)) * P = Ca i * Wa := by
          rw [hWa]; ring
        rw [e']
        exact mul_le_mul_of_nonneg_right (le_abs_self _) hWa0
      have a2 : nB (k - i) ≤ |Cb (k - i)| * Wb := by
        refine le_trans (hbB (k - i) hjk) ?_
        have e' : Cb (k - i) * q ^ (B.h * β) * S ^ (bb (k - i)) * E * e ^ (-(db (k - i))) * P =
            Cb (k - i) * Wb := by
          rw [hWb]; ring
        rw [e']
        exact mul_le_mul_of_nonneg_right (le_abs_self _) hWb0
      have a3 : nA i * nB (k - i) ≤ (|Ca i| * Wa) * (|Cb (k - i)| * Wb) :=
        mul_le_mul a1 a2 (hnB _) (mul_nonneg (abs_nonneg _) hWa0)
      have hbsum : ba i + bb (k - i) ≤ Bs := by
        have s1 : |ba i| ≤ ∑ j ∈ Finset.range (k + 1), |ba j| :=
          Finset.single_le_sum (f := fun j => |ba j|) (fun j _ => abs_nonneg _) hi
        have s2 : |bb (k - i)| ≤ ∑ j ∈ Finset.range (k + 1), |bb j| :=
          Finset.single_le_sum (f := fun j => |bb j|) (fun j _ => abs_nonneg _) hj
        rw [hBs]
        linarith [le_abs_self (ba i), le_abs_self (bb (k - i))]
      have hdsum : da i + db (k - i) ≤ Ds := by
        have s1 : |da i| ≤ ∑ j ∈ Finset.range (k + 1), |da j| :=
          Finset.single_le_sum (f := fun j => |da j|) (fun j _ => abs_nonneg _) hi
        have s2 : |db (k - i)| ≤ ∑ j ∈ Finset.range (k + 1), |db j| :=
          Finset.single_le_sum (f := fun j => |db j|) (fun j _ => abs_nonneg _) hj
        rw [hDs]
        linarith [le_abs_self (da i), le_abs_self (db (k - i))]
      have f1 : S ^ (ba i + bb (k - i)) ≤ S ^ Bs := Real.rpow_le_rpow_of_exponent_le hS hbsum
      have f2 : e ^ (-(da i) + -(db (k - i))) ≤ e ^ (-Ds) :=
        Real.rpow_le_rpow_of_exponent_ge he0 he1 (by linarith)
      have eq1 : q ^ (B.h * α) * q ^ (B.h * β) = q ^ (B.h * (α + β)) := by
        rw [← Real.rpow_add hq]; congr 1; ring
      have pQ : 0 ≤ q ^ (B.h * (α + β)) := Real.rpow_nonneg hq.le _
      have pS : 0 ≤ S ^ Bs := Real.rpow_nonneg hS0.le _
      have s1 : q ^ (B.h * (α + β)) * S ^ (ba i + bb (k - i)) ≤ q ^ (B.h * (α + β)) * S ^ Bs :=
        mul_le_mul_of_nonneg_left f1 pQ
      have s2 : q ^ (B.h * (α + β)) * S ^ (ba i + bb (k - i)) * (E * E) ≤
          q ^ (B.h * (α + β)) * S ^ Bs * E :=
        mul_le_mul s1 hEE (mul_nonneg hE hE) (mul_nonneg pQ pS)
      have s3 : q ^ (B.h * (α + β)) * S ^ (ba i + bb (k - i)) * (E * E) * e ^ (-(da i) + -(db (k - i))) ≤
          q ^ (B.h * (α + β)) * S ^ Bs * E * e ^ (-Ds) :=
        mul_le_mul s2 f2 (Real.rpow_nonneg he0.le _) (mul_nonneg (mul_nonneg pQ pS) hE)
      have s4 : q ^ (B.h * (α + β)) * S ^ (ba i + bb (k - i)) * (E * E) * e ^ (-(da i) + -(db (k - i))) *
          (P * P) ≤ q ^ (B.h * (α + β)) * S ^ Bs * E * e ^ (-Ds) * P :=
        mul_le_mul s3 hPP (mul_nonneg hP0 hP0)
          (mul_nonneg (mul_nonneg (mul_nonneg pQ pS) hE) (Real.rpow_nonneg he0.le _))
      have a4 : Wa * Wb ≤ X := by
        calc Wa * Wb = (q ^ (B.h * α) * q ^ (B.h * β)) * (S ^ (ba i) * S ^ (bb (k - i))) * (E * E) *
              (e ^ (-(da i)) * e ^ (-(db (k - i)))) * (P * P) := by rw [hWa, hWb]; ring
          _ = q ^ (B.h * (α + β)) * S ^ (ba i + bb (k - i)) * (E * E) *
              e ^ (-(da i) + -(db (k - i))) * (P * P) := by
              rw [eq1, ← Real.rpow_add hS0, ← Real.rpow_add he0]
          _ ≤ X := by rw [hXdef]; exact s4
      have hc : (0 : ℝ) ≤ (k.choose i : ℝ) := Nat.cast_nonneg _
      calc (k.choose i : ℝ) * nA i * nB (k - i) = (k.choose i : ℝ) * (nA i * nB (k - i)) := by ring
        _ ≤ (k.choose i : ℝ) * ((|Ca i| * Wa) * (|Cb (k - i)| * Wb)) :=
            mul_le_mul_of_nonneg_left a3 hc
        _ = (k.choose i : ℝ) * |Ca i| * |Cb (k - i)| * (Wa * Wb) := by ring
        _ ≤ (k.choose i : ℝ) * |Ca i| * |Cb (k - i)| * X :=
            mul_le_mul_of_nonneg_left a4
              (mul_nonneg (mul_nonneg hc (abs_nonneg _)) (abs_nonneg _))
    calc K * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * nA i * nB (k - i)
        ≤ K * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |Ca i| * |Cb (k - i)| * X :=
          mul_le_mul_of_nonneg_left (Finset.sum_le_sum hterm) hK
      _ = _ := by rw [← Finset.sum_mul, hXdef]; ring

  have hV : ∀ (γ : Lab) (M : ℤ) (ξ : Cyl), (M ∉ H' ∨ ξ ∉ tsupport (a γ (σ M))) →
      (fun η => if M ∈ H' then c • (a γ (σ M) η • b γ (τ M) η) else 0) =ᶠ[nhds ξ]
        fun _ => (0 : Fin 3 → ℂ) := by
    intro γ M ξ h
    by_cases hM : M ∈ H'
    · have hts : ξ ∉ tsupport (a γ (σ M)) := h.resolve_left (fun h' => h' hM)
      have h1 := (notMem_tsupport_iff_eventuallyEq).1 hts
      exact h1.mono (fun η hη => by
        show (if M ∈ H' then c • (a γ (σ M) η • b γ (τ M) η) else 0) = 0
        rw [if_pos hM, hη]
        simp)
    · exact Filter.Eventually.of_forall (fun η => by
        show (if M ∈ H' then c • (a γ (σ M) η • b γ (τ M) η) else 0) = 0
        rw [if_neg hM])
  refine ⟨⟨H', hH0, fun γ m hm => ?_⟩, fun γ m => ?_, fun γ m ξ hξ e he => ?_,
    fun γ m ξ hξ hne => ?_, fun k => ?_⟩
  · funext ξ
    show (if m ∈ H' then c • (a γ (σ m) ξ • b γ (τ m) ξ) else 0) = 0
    rw [if_neg hm]
  · show ContDiffOn ℝ ∞ (fun ξ => if m ∈ H' then c • (a γ (σ m) ξ • b γ (τ m) ξ) else 0) _
    by_cases hm : m ∈ H'
    · rw [hP γ m hm]
      exact (contDiffOn_const.clm_apply (sa γ (σ m))).clm_apply (sb γ (τ m))
    · refine (contDiffOn_const (c := (0 : Fin 3 → ℂ))).congr (fun ξ _ => ?_)
      show (if m ∈ H' then c • (a γ (σ m) ξ • b γ (τ m) ξ) else 0) = 0
      rw [if_neg hm]
  · show (if m ∈ H' then c • (a γ (σ m) (shY ξ e) • b γ (τ m) (shY ξ e)) else 0) =
      (if m ∈ H' then c • (a γ (σ m) ξ • b γ (τ m) ξ) else 0)
    rw [dka γ (σ m) ξ hξ e he, dkb γ (τ m) ξ hξ e he]
  · by_cases hm : m ∈ H'
    · apply pa γ (σ m) ξ hξ
      intro h0
      apply hne
      show (if m ∈ H' then c • (a γ (σ m) ξ • b γ (τ m) ξ) else 0) = 0
      rw [if_pos hm, h0]
      simp
    · exfalso
      apply hne
      show (if m ∈ H' then c • (a γ (σ m) ξ • b γ (τ m) ξ) else 0) = 0
      rw [if_neg hm]
  · refine ⟨‖Bl‖ * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |Ca i| * |Cb (k - i)|,
      (∑ j ∈ Finset.range (k + 1), |ba j|) + ∑ j ∈ Finset.range (k + 1), |bb j|,
      (∑ j ∈ Finset.range (k + 1), |da j|) + ∑ j ∈ Finset.range (k + 1), |db j|,
      fun γ M ξ hξ hX1 hX2 => ?_⟩
    obtain ⟨hq0, hS1⟩ := hDq ξ hξ
    obtain ⟨hE, he0, he1⟩ := hEdge _ hX1 hX2
    have hPv : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
      unfold Penv5
      exact (Real.exp_pos _).le
    show NB B.h (fun ξ => if M ∈ H' then c • (a γ (σ M) ξ • b γ (τ M) ξ) else 0) k ξ ≤ _
    by_cases hcase : M ∈ H' ∧ ξ ∈ tsupport (a γ (σ M))
    · obtain ⟨hM, hts⟩ := hcase
      obtain ⟨hSW, -⟩ := hSupp γ (σ M) ξ hξ hts
      have hTgc : (0:ℝ) < Tgc := by unfold Tgc; positivity
      have hQb : 0 < Qb γ.1 := by unfold Qb; exact Real.rpow_pos_of_pos (by norm_num) _
      have hcib : 0 < cib B.h γ.1 := by
        unfold cib; exact mul_pos (zpow_pos hTgc _) (Real.rpow_pos_of_pos hQb _)
      have hv : 0 ≤ vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 := by
        unfold vco
        apply div_nonneg _ hcib.le
        have h1 := hSW.2.2.2.1
        linarith [neg_abs_le (etG B.h γ (G.ctr γ) ξ.2.2.2)]
      have hP1 : Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) ≤ 1 :=
        penv5_le_one_v5 B G γ _ hG.1.1 hv
      have haO : ContDiffOn ℝ k (a γ (σ M)) (DomC B.h (qsOf l0)) :=
        (sa γ (σ M)).of_le (by exact_mod_cast le_top)
      have hbO : ContDiffOn ℝ k (b γ (τ M)) (DomC B.h (qsOf l0)) :=
        (sb γ (τ M)).of_le (by exact_mod_cast le_top)
      have hL := hLeib (a γ (σ M)) (b γ (τ M)) (DomC B.h (qsOf l0)) ξ k hDopen hξ haO hbO
      rw [hP γ M hM]
      refine le_trans hL ?_
      exact comb k (qC B.h ξ) (SC B.h ξ) (Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)))
        (edgeDist B.Xa B.Xb (XC B.h ξ)) (Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) ‖Bl‖
        (fun i => NB B.h (a γ (σ M)) i ξ) (fun j => NB B.h (b γ (τ M)) j ξ) hq0 hS1
        (Real.sqrt_nonneg _) (hE1 _) he0 he1 hPv hP1 (ContinuousLinearMap.opNorm_nonneg Bl)
        (fun i => norm_nonneg _) (fun j => norm_nonneg _)
        (fun i _ => hA i γ (σ M) ξ hξ hX1 hX2) (fun j _ => hB j γ (τ M) ξ hξ hX1 hX2)
    · have hev := hV γ M ξ (by
        by_cases hM : M ∈ H'
        · exact Or.inr (fun h => hcase ⟨hM, h⟩)
        · exact Or.inl hM)
      rw [hNB0 _ ξ k hev]
      have hC0 : 0 ≤ ‖Bl‖ * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |Ca i| * |Cb (k - i)| :=
        mul_nonneg (ContinuousLinearMap.opNorm_nonneg Bl) (Finset.sum_nonneg (fun i _ =>
          mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (abs_nonneg _)) (abs_nonneg _)))
      exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hC0
        (Real.rpow_nonneg hq0.le _)) (Real.rpow_nonneg (by linarith) _)) (Real.sqrt_nonneg _))
        (Real.rpow_nonneg he0.le _)) hPv

theorem pq5_comp_conj_class : ∀ (B : BG) (G : CorrGeom) (qs α : ℝ), B.ok →
  (∀ (W : WC) (j : Fin 3), InWg5 B G qs α W → InWg5 B G qs α (fun γ m ξ => W γ m ξ j)) ∧
  (∀ (a : Lab → ℤ → Cyl → ℂ), InWg5 B G qs α a → InWg5 B G qs α (fun γ m ξ => starRingEnd ℂ (a γ (-m) ξ))) :=
by
  intro B G qs α hok
  have hU : IsOpen (DomC B.h qs) := by
    have h4c := hok.1.2.2.2.1.continuousOn
    have hm : Set.MapsTo (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1}
        (Set.univ ×ˢ Set.Ioi 0) := by
      intro ξ hξ
      have hξ' : ξ.2.2.1 < 1 := hξ
      exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1} :=
      h4c.comp (f := fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) (Continuous.continuousOn (by fun_prop)) hm
    have e : DomC B.h qs = {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩
        (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) ⁻¹' Set.Iio qs) := by
      ext ξ
      exact Iff.rfl
    rw [e]
    exact (isOpen_lt continuous_const continuous_fst).inter
      (hc.isOpen_inter_preimage (isOpen_lt (by fun_prop) continuous_const) isOpen_Iio)
  have hNB : ∀ {V V' : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedAddCommGroup V']
      [NormedSpace ℝ V'] (L : V →L[ℝ] V') (f : Cyl → V) (k : ℕ) (ξ : Cyl), ‖L‖ ≤ 1 →
      iteratedFDeriv ℝ k (L ∘ f) ξ = L.compContinuousMultilinearMap (iteratedFDeriv ℝ k f ξ) →
      NB B.h (L ∘ f) k ξ ≤ NB B.h f k ξ := by
    intro V V' _ _ _ _ L f k ξ hL he
    unfold NB
    rw [he]
    have e2 : (L.compContinuousMultilinearMap (iteratedFDeriv ℝ k f ξ)).compContinuousLinearMap
        (fun _ => Lnorm B.h ξ) = L.compContinuousMultilinearMap
          ((iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext v
      rfl
    rw [e2]
    calc _ ≤ ‖L‖ * _ := L.norm_compContinuousMultilinearMap_le _
      _ ≤ 1 * _ := mul_le_mul_of_nonneg_right hL (norm_nonneg _)
      _ = _ := one_mul _
  refine ⟨fun W j hW => ?_, fun a ha => ?_⟩
  · obtain ⟨⟨H, h0H, hH⟩, h2, h3, h4, h5⟩ := hW
    let p : (Fin 3 → ℂ) →L[ℝ] ℂ := ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) j
    have hpn : ‖p‖ ≤ 1 := ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => by
      rw [one_mul]; exact norm_le_pi_norm x j)
    refine ⟨⟨H, h0H, fun γ m hm => ?_⟩, fun γ m => ?_, fun γ m ξ hξ c hc => ?_,
      fun γ m ξ hξ hne => ?_, fun k => ?_⟩
    · funext ξ
      show W γ m ξ j = 0
      rw [hH γ m hm]
      rfl
    · show ContDiffOn ℝ ∞ (p ∘ W γ m) _
      exact p.contDiff.comp_contDiffOn (h2 γ m)
    · exact congrArg (fun v => v j) (h3 γ m ξ hξ c hc)
    · apply h4 γ m ξ hξ
      intro h0
      apply hne
      show W γ m ξ j = 0
      rw [h0]
      rfl
    · obtain ⟨C, b, d, hC⟩ := h5 k
      refine ⟨C, b, d, fun γ m ξ hξ hX1 hX2 => ?_⟩
      refine le_trans ?_ (hC γ m ξ hξ hX1 hX2)
      show NB B.h (p ∘ W γ m) k ξ ≤ _
      exact hNB p (W γ m) k ξ hpn (p.iteratedFDeriv_comp_left
        ((h2 γ m).contDiffAt (hU.mem_nhds hξ)) (by exact_mod_cast le_top))
  · obtain ⟨⟨H, h0H, hH⟩, h2, h3, h4, h5⟩ := ha
    have hcf : ∀ γ m, (fun ξ => starRingEnd ℂ (a γ (-m) ξ)) =
        (Complex.conjCLE : ℂ →L[ℝ] ℂ) ∘ a γ (-m) := by
      intro γ m
      funext ξ
      simp
    refine ⟨⟨H.image (fun x : ℤ => -x), ?_, fun γ m hm => ?_⟩, fun γ m => ?_,
      fun γ m ξ hξ c hc => ?_, fun γ m ξ hξ hne => ?_, fun k => ?_⟩
    · intro h0
      obtain ⟨x, hx, hx0⟩ := Finset.mem_image.mp h0
      have hx' : x = 0 := neg_eq_zero.mp hx0
      exact h0H (hx' ▸ hx)
    · have hm' : -m ∉ H := by
        intro h
        apply hm
        exact Finset.mem_image.mpr ⟨-m, h, neg_neg m⟩
      funext ξ
      show starRingEnd ℂ (a γ (-m) ξ) = 0
      rw [hH γ (-m) hm']
      simp
    · show ContDiffOn ℝ ∞ (fun ξ => starRingEnd ℂ (a γ (-m) ξ)) _
      rw [hcf]
      exact (Complex.conjCLE : ℂ →L[ℝ] ℂ).contDiff.comp_contDiffOn (h2 γ (-m))
    · show starRingEnd ℂ (a γ (-m) (shY ξ c)) = starRingEnd ℂ (a γ (-m) ξ)
      rw [h3 γ (-m) ξ hξ c hc]
    · apply h4 γ (-m) ξ hξ
      intro h0
      apply hne
      show starRingEnd ℂ (a γ (-m) ξ) = 0
      rw [h0, map_zero]
    · obtain ⟨C, b, d, hC⟩ := h5 k
      refine ⟨C, b, d, fun γ m ξ hξ hX1 hX2 => ?_⟩
      refine le_trans ?_ (hC γ (-m) ξ hξ hX1 hX2)
      show NB B.h (fun ξ => starRingEnd ℂ (a γ (-m) ξ)) k ξ ≤ _
      rw [hcf]
      exact hNB _ (a γ (-m)) k ξ (le_of_eq Complex.conjCLE_norm)
        Complex.conjCLE.iteratedFDeriv_comp_left

theorem pq5_add_congr_class : ∀ (B : BG) (G : CorrGeom) (qs : ℝ), B.ok → qs ≤ 1 →
  ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V],
  (∀ (α β : ℝ) (f g : Lab → ℤ → Cyl → V), InWg5 B G qs α f → InWg5 B G qs β g →
     InWg5 B G qs (min α β) (fun γ m ξ => f γ m ξ + g γ m ξ)) ∧
  (∀ (α : ℝ) (f g : Lab → ℤ → Cyl → V), InWg5 B G qs α f →
     (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → g γ m = 0) →
     (∀ γ m, ∀ ξ ∈ DomC B.h qs, g γ m ξ = f γ m ξ) → InWg5 B G qs α g) :=
by
  intro B G qs hok hqs1 V _ _
  have hh0 : 0 ≤ B.h := hok.2.1.1.le
  have hXa : 0 < B.Xa := hok.2.1.2.2.1

  have hDopen : IsOpen (DomC B.h qs) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4 : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3 := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio qs := by
      ext ξ
      constructor
      · rintro ⟨h1, h2, h3⟩
        exact ⟨⟨h1, h2⟩, h3⟩
      · rintro ⟨⟨h1, h2⟩, h3⟩
        exact ⟨h1, h2, h3⟩
    rw [e]
    exact h3
  have hDq : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 ∧ 1 ≤ SC B.h ξ := by
    intro ξ hξ
    obtain ⟨-, h2, h3⟩ := hξ
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    refine ⟨hq0, by linarith, ?_⟩
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hEdge : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X ∧
      0 < edgeDist B.Xa B.Xb X ∧ edgeDist B.Xa B.Xb X ≤ 1 := by
    intro X h1 h2
    refine ⟨?_, ?_, min_le_left _ _⟩
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · have hX : 0 < X := lt_trans hXa h1
      have l1 : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr h1)
      have l2 : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX).mpr h2)
      exact lt_min one_pos (lt_min l1 l2)

  have hW : ∀ (q Sv E e P C1 C2 b1 b2 d1 d2 a a1 a2 N1 N2 : ℝ), 0 < q → q ≤ 1 → 1 ≤ Sv → 0 ≤ E →
      0 < e → e ≤ 1 → 0 ≤ P → a ≤ a1 → a ≤ a2 →
      N1 ≤ C1 * q ^ (B.h * a1) * Sv ^ b1 * E * e ^ (-d1) * P →
      N2 ≤ C2 * q ^ (B.h * a2) * Sv ^ b2 * E * e ^ (-d2) * P →
      N1 + N2 ≤ (|C1| + |C2|) * q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P := by
    intro q Sv E e P C1 C2 b1 b2 d1 d2 a a1 a2 N1 N2 hq0 hq1 hS1 hE he0 he1 hP ha1 ha2 hN1 hN2
    have key : ∀ (C b d ai N : ℝ), a ≤ ai → N ≤ C * q ^ (B.h * ai) * Sv ^ b * E * e ^ (-d) * P →
        b ≤ max b1 b2 → d ≤ max d1 d2 →
        N ≤ |C| * (q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by
      intro C b d ai N hα hN hb hd
      have f1 : q ^ (B.h * ai) ≤ q ^ (B.h * a) :=
        Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (mul_le_mul_of_nonneg_left hα hh0)
      have f2 : Sv ^ b ≤ Sv ^ (max b1 b2) := Real.rpow_le_rpow_of_exponent_le hS1 hb
      have f3 : e ^ (-d) ≤ e ^ (-(max d1 d2)) :=
        Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hd)
      have p1 : 0 ≤ q ^ (B.h * ai) := Real.rpow_nonneg hq0.le _
      have p2 : 0 ≤ Sv ^ b := Real.rpow_nonneg (by linarith) _
      have p3 : 0 ≤ e ^ (-d) := Real.rpow_nonneg he0.le _
      have p1' : 0 ≤ q ^ (B.h * a) := Real.rpow_nonneg hq0.le _
      have p2' : 0 ≤ Sv ^ (max b1 b2) := Real.rpow_nonneg (by linarith) _
      have m1 : q ^ (B.h * ai) * Sv ^ b ≤ q ^ (B.h * a) * Sv ^ (max b1 b2) := mul_le_mul f1 f2 p2 p1'
      have m2 : q ^ (B.h * ai) * Sv ^ b * E ≤ q ^ (B.h * a) * Sv ^ (max b1 b2) * E :=
        mul_le_mul_of_nonneg_right m1 hE
      have m3 : q ^ (B.h * ai) * Sv ^ b * E * e ^ (-d) ≤
          q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) :=
        mul_le_mul m2 f3 p3 (mul_nonneg (mul_nonneg p1' p2') hE)
      have hWi := mul_le_mul_of_nonneg_right m3 hP
      have hWi0 : 0 ≤ q ^ (B.h * ai) * Sv ^ b * E * e ^ (-d) * P :=
        mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg p1 p2) hE) p3) hP
      calc N ≤ C * q ^ (B.h * ai) * Sv ^ b * E * e ^ (-d) * P := hN
        _ = C * (q ^ (B.h * ai) * Sv ^ b * E * e ^ (-d) * P) := by ring
        _ ≤ |C| * (q ^ (B.h * ai) * Sv ^ b * E * e ^ (-d) * P) :=
            mul_le_mul_of_nonneg_right (le_abs_self C) hWi0
        _ ≤ |C| * (q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) :=
            mul_le_mul_of_nonneg_left hWi (abs_nonneg C)
    have k1 := key C1 b1 d1 a1 N1 ha1 hN1 (le_max_left _ _) (le_max_left _ _)
    have k2 := key C2 b2 d2 a2 N2 ha2 hN2 (le_max_right _ _) (le_max_right _ _)
    have e : (|C1| + |C2|) * q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P =
        |C1| * (q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) +
        |C2| * (q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by ring
    rw [e]
    linarith

  have hNB : ∀ (f1 f2 g0 : Cyl → V) (k : ℕ) (ξ : Cyl),
      ξ ∈ DomC B.h qs → ContDiffOn ℝ ∞ f1 (DomC B.h qs) →
      ContDiffOn ℝ ∞ f2 (DomC B.h qs) →
      (∀ η ∈ DomC B.h qs, g0 η = f1 η + f2 η) → NB B.h g0 k ξ ≤ NB B.h f1 k ξ + NB B.h f2 k ξ := by
    intro f1 f2 g0 k ξ hξ hf1 hf2 heq
    have hn : DomC B.h qs ∈ nhds ξ := hDopen.mem_nhds hξ
    have hev : g0 =ᶠ[nhds ξ] f1 + f2 := Filter.eventuallyEq_of_mem hn (fun η hη => heq η hη)
    have e1 : iteratedFDeriv ℝ k g0 ξ = iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ := by
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      exact iteratedFDeriv_add_apply ((hf1.contDiffAt hn).of_le (by exact_mod_cast le_top))
        ((hf2.contDiffAt hn).of_le (by exact_mod_cast le_top))
    unfold NB
    rw [e1]
    have e2 : (iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) =
        (iteratedFDeriv ℝ k f1 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) +
        (iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    exact norm_add_le _ _
  refine ⟨?_, ?_⟩
  ·
    intro α β f g hf hg
    obtain ⟨⟨Hf, h0f, hHf⟩, sf, df, uf, bf⟩ := hf
    obtain ⟨⟨Hg, h0g, hHg⟩, sg, dg, ug, bg⟩ := hg
    refine ⟨⟨Hf ∪ Hg, ?_, ?_⟩, fun γ m => (sf γ m).add (sg γ m), ?_, ?_, ?_⟩
    · rw [Finset.mem_union, not_or]
      exact ⟨h0f, h0g⟩
    · intro γ m hm
      rw [Finset.mem_union, not_or] at hm
      funext ξ
      simp only [hHf γ m hm.1, hHg γ m hm.2, Pi.zero_apply, add_zero]
    · intro γ m ξ hξ c hc
      show f γ m (shY ξ c) + g γ m (shY ξ c) = f γ m ξ + g γ m ξ
      rw [df γ m ξ hξ c hc, dg γ m ξ hξ c hc]
    · intro γ m ξ hξ hne
      change f γ m ξ + g γ m ξ ≠ 0 at hne
      by_cases h : f γ m ξ = 0
      · rw [h, zero_add] at hne
        exact ug γ m ξ hξ hne
      · exact uf γ m ξ hξ h
    · intro k
      obtain ⟨C1, c1, e1, hb1⟩ := bf k
      obtain ⟨C2, c2, e2, hb2⟩ := bg k
      refine ⟨|C1| + |C2|, max c1 c2, max e1 e2, fun γ m ξ hξ hX1 hX2 => ?_⟩
      obtain ⟨hq0, hq1, hS1⟩ := hDq ξ hξ
      obtain ⟨hE, he0, he1⟩ := hEdge _ hX1 hX2
      have hn := hNB (f γ m) (g γ m) (fun η => f γ m η + g γ m η) k ξ hξ (sf γ m) (sg γ m)
        (fun _ _ => rfl)
      have hP : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
        unfold Penv5
        exact (Real.exp_pos _).le
      have := hW (qC B.h ξ) (SC B.h ξ) (Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)))
        (edgeDist B.Xa B.Xb (XC B.h ξ)) (Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2))
        C1 C2 c1 c2 e1 e2 (min α β) α β _ _ hq0 hq1 hS1 (Real.sqrt_nonneg _) he0 he1 hP
        (min_le_left α β) (min_le_right α β)
        (hb1 γ m ξ hξ hX1 hX2) (hb2 γ m ξ hξ hX1 hX2)
      exact le_trans hn this
  ·
    intro α f g hf hH heq
    obtain ⟨_, sf, df, uf, bf⟩ := hf
    refine ⟨hH, fun γ m => (sf γ m).congr (fun ξ hξ => heq γ m ξ hξ), ?_, ?_, ?_⟩
    · intro γ m ξ hξ c hc
      have hξ' : shY ξ c ∈ DomC B.h qs := hξ
      rw [heq γ m _ hξ', df γ m ξ hξ c hc, heq γ m ξ hξ]
    · intro γ m ξ hξ hne
      rw [heq γ m ξ hξ] at hne
      exact uf γ m ξ hξ hne
    · intro k
      obtain ⟨C, b, d, hb⟩ := bf k
      refine ⟨C, b, d, fun γ m ξ hξ hX1 hX2 => ?_⟩
      have hn : DomC B.h qs ∈ nhds ξ := hDopen.mem_nhds hξ
      have hev : g γ m =ᶠ[nhds ξ] f γ m := Filter.eventuallyEq_of_mem hn (fun η hη => heq γ m η hη)
      have e1 : iteratedFDeriv ℝ k (g γ m) ξ = iteratedFDeriv ℝ k (f γ m) ξ :=
        (hev.iteratedFDeriv ℝ k).eq_of_nhds
      have e2 : NB B.h (g γ m) k ξ = NB B.h (f γ m) k ξ := by
        unfold NB
        rw [e1]
      rw [e2]
      exact hb γ m ξ hξ hX1 hX2

theorem pq5_dR_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
  ∀ (α : ℝ) (w : WC), InWg5 B G (qsOf l0) α w →
  InWg5 B G (qsOf l0) (α - kapS) (fun γ m ξ => ((Real.sqrt (qC B.h ξ) : ℝ) : ℂ) • (fun i => dR B.h (fun η => w γ m η i) ξ)) :=
by
  intro B G hok hG
  obtain ⟨l1, hR⟩ := inWg5_dR_class_v5 B G hok hG
  refine ⟨l1, fun l0 hl0 α w hw => ?_⟩
  have hh : 0 < B.h := hok.2.1.1
  have hq1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hO : IsOpen (DomC B.h (qsOf l0)) := (domc_open_calculus B (qsOf l0) hok).1
  obtain ⟨hmult1, hmult2⟩ := wmo_amp_multipliers_v5 B hok (qsOf l0) hq1
  have ha' := hR l0 hl0 α w hw
  obtain ⟨μ, hμdef⟩ : ∃ μ : Lab → Cyl → ℂ, μ = fun _ η => ((Real.sqrt (qC B.h η) : ℝ) : ℂ) :=
    ⟨_, rfl⟩
  have hμ : ∀ γ, μ γ = (Complex.ofRealCLM : ℝ →L[ℝ] ℂ) ∘ (fun η => Real.sqrt (qC B.h η)) := by
    intro γ
    rw [hμdef]
    funext η
    rfl
  have hμd : ∀ γ, ∀ ξ ∈ DomC B.h (qsOf l0), ContDiffAt ℝ ∞ (μ γ) ξ := by
    intro γ ξ hξ
    rw [hμ γ]
    exact Complex.ofRealCLM.contDiff.contDiffAt.comp ξ (hmult1 ξ hξ).1
  have hNBμ : ∀ γ k, ∀ ξ ∈ DomC B.h (qsOf l0),
      NB B.h (μ γ) k ξ ≤ NB B.h (fun η => Real.sqrt (qC B.h η)) k ξ := by
    intro γ k ξ hξ
    unfold NB
    rw [hμ γ, ContinuousLinearMap.iteratedFDeriv_comp_left _ (hmult1 ξ hξ).1
      (by exact_mod_cast le_top)]
    have e : (Complex.ofRealCLM.compContinuousMultilinearMap
        (iteratedFDeriv ℝ k (fun η => Real.sqrt (qC B.h η)) ξ)).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) =
        Complex.ofRealCLM.compContinuousMultilinearMap
          ((iteratedFDeriv ℝ k (fun η => Real.sqrt (qC B.h η)) ξ).compContinuousLinearMap
            (fun _ => Lnorm B.h ξ)) := by
      ext v
      rfl
    rw [e]
    refine le_trans (ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _) ?_
    rw [Complex.ofRealCLM_norm, one_mul]
  have hNBc : ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      ξ ∈ tsupport (fun ξ => dR B.h (w γ m) ξ) → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      NB B.h (μ γ) k ξ ≤ C * qC B.h ξ ^ (B.h * (1 / (2 * B.h))) * SC B.h ξ ^ b := by
    intro k
    obtain ⟨C, hC⟩ := hmult2 k
    refine ⟨C, 0, fun γ m ξ hξ _ _ _ => ?_⟩
    have e1 : B.h * (1 / (2 * B.h)) = 1 / 2 := by
      rw [mul_one_div, div_eq_iff (mul_pos two_pos hh).ne']
      ring
    rw [e1, Real.rpow_zero, mul_one, ← Real.sqrt_eq_rpow]
    exact le_trans (hNBμ γ k ξ hξ) (hC ξ hξ).1
  have hf := inWg5_smul_mult B G l0 hok (α - 1 / (2 * B.h) - kapS) (1 / (2 * B.h))
    (fun γ m ξ => dR B.h (w γ m) ξ) μ ha' (fun γ m ξ hξ _ => hμd γ ξ hξ)
    (fun γ m ξ hξ _ c _ => by rw [hμdef]; rfl) hNBc
  have hexp : α - 1 / (2 * B.h) - kapS + 1 / (2 * B.h) = α - kapS := by ring
  rw [hexp] at hf

  have hbr : ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0),
      (fun i => dR B.h (fun η => w γ m η i) ξ) = dR B.h (w γ m) ξ := by
    intro γ m ξ hξ
    have hd : DifferentiableAt ℝ (w γ m) ξ :=
      ((hw.2.1 γ m).contDiffAt (hO.mem_nhds hξ)).differentiableAt (by norm_num)
    funext i
    have hc : HasFDerivAt (fun η => w γ m η i)
        ((ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i).comp
          (fderiv ℝ (w γ m) ξ)) ξ :=
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i).hasFDerivAt.comp ξ
        hd.hasFDerivAt
    unfold dR
    rw [hc.fderiv]
    rfl
  have heq : ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0),
      ((Real.sqrt (qC B.h ξ) : ℝ) : ℂ) • (fun i => dR B.h (fun η => w γ m η i) ξ) =
        μ γ ξ • dR B.h (w γ m) ξ := by
    intro γ m ξ hξ
    rw [hbr γ m ξ hξ, hμdef]
  obtain ⟨f1, f2, f3, f4, f5⟩ := hf
  obtain ⟨⟨H, H0, hH⟩, -, -, -, -⟩ := hw
  refine ⟨⟨H, H0, fun γ m hm => ?_⟩, fun γ m => ?_, fun γ m ξ hξ c hc => ?_,
    fun γ m ξ hξ hne => ?_, fun k => ?_⟩
  · funext ξ
    have h0 : ∀ i : Fin 3, (fun η => w γ m η i) = fun _ => (0:ℂ) := by
      intro i
      funext η
      rw [hH γ m hm]
      rfl
    show ((Real.sqrt (qC B.h ξ) : ℝ) : ℂ) • (fun i => dR B.h (fun η => w γ m η i) ξ) = 0
    funext i
    simp only [Pi.smul_apply, Pi.zero_apply]
    rw [h0 i]
    simp [dR]
  · exact (f2 γ m).congr (fun ξ hξ => heq γ m ξ hξ)
  · have hξ' : shY ξ c ∈ DomC B.h (qsOf l0) := hξ
    exact (heq γ m _ hξ').trans ((f3 γ m ξ hξ c hc).trans (heq γ m ξ hξ).symm)
  · exact f4 γ m ξ hξ (fun h0 => hne ((heq γ m ξ hξ).trans h0))
  · obtain ⟨C, b, d, hC⟩ := f5 k
    refine ⟨C, b, d, fun γ m ξ hξ hX1 hX2 => ?_⟩
    have hev : (fun η => ((Real.sqrt (qC B.h η) : ℝ) : ℂ) •
        (fun i => dR B.h (fun η' => w γ m η' i) η)) =ᶠ[nhds ξ]
        (fun η => μ γ η • dR B.h (w γ m) η) :=
      Filter.eventuallyEq_of_mem (hO.mem_nhds hξ) (fun η hη => heq γ m η hη)
    have hk := hC γ m ξ hξ hX1 hX2
    show NB B.h (fun η => ((Real.sqrt (qC B.h η) : ℝ) : ℂ) •
        (fun i => dR B.h (fun η' => w γ m η' i) η)) k ξ ≤ _
    unfold NB at hk ⊢
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    exact hk

theorem pq5_dZ_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
  ∀ (α : ℝ) (w : WC), InWg5 B G (qsOf l0) α w →
  InWg5 B G (qsOf l0) (α + 1) (fun γ m ξ => ((Real.sqrt (qC B.h ξ) : ℝ) : ℂ) • (fun i => dZ (fun η => w γ m η i) ξ)) :=
by
  intro B G hok hG
  obtain ⟨lp, Hp⟩ := pulse_support_good_v5 B G hok hG
  refine ⟨lp + 7, fun l0 hl0 α w hw => ?_⟩
  have hh : 0 < B.h := hok.2.1.1
  have hh0 : B.h ≠ 0 := hh.ne'
  have hu : B.h * (1 / (2 * B.h)) = 1 / 2 := by field_simp
  have hq1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hDo : IsOpen (DomC B.h (qsOf l0)) := (domc_open_calculus B (qsOf l0) hok).1
  have hqpos : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ := (domc_open_calculus B (qsOf l0) hok).2.2.1

  have hframe : ∀ ξ : Cyl, 0 < qC B.h ξ →
      ∃ v : Cyl, Lnorm B.h ξ v = ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) ∧
        ‖v‖ ≤ qC B.h ξ ^ (-(1/2 - B.h)) := by
    intro ξ hq
    have hs0 : 0 ≤ qC B.h ξ ^ (-(1/2 - B.h)) := Real.rpow_nonneg hq.le _
    refine ⟨((0:ℝ), qC B.h ξ ^ (-(1/2 - B.h)), (0:ℝ), (0:ℝ × ℝ)), ?_, ?_⟩
    · have e0 : ∀ v : Cyl, (Lnorm B.h ξ v).1 = Real.sqrt (qC B.h ξ) * v.1 := by
        intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have e1 : ∀ v : Cyl, (Lnorm B.h ξ v).2.1 = qC B.h ξ ^ (1/2 - B.h) * v.2.1 := by
        intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have e2 : ∀ v : Cyl, (Lnorm B.h ξ v).2.2.1 = qC B.h ξ * v.2.2.1 := by
        intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have e3 : ∀ v : Cyl, (Lnorm B.h ξ v).2.2.2 = JpowL (-coarseIdx B.h (qC B.h ξ)) v.2.2.2 := by
        intro v; rfl
      refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
      · rw [e0]; simp
      · rw [e1]
        show qC B.h ξ ^ (1/2 - B.h) * qC B.h ξ ^ (-(1/2 - B.h)) = 1
        rw [← Real.rpow_add hq, add_neg_cancel, Real.rpow_zero]
      · rw [e2]; simp
      · rw [e3]
        exact map_zero _
    · simp only [Prod.norm_mk, norm_zero, Real.norm_eq_abs, abs_of_nonneg hs0]
      exact max_le hs0 (max_le le_rfl (max_le hs0 hs0))

  have nbdir : ∀ (ξ : Cyl) (F : Cyl → (Fin 3 → ℂ)) (v : Cyl), ξ ∈ DomC B.h (qsOf l0) →
      ContDiffOn ℝ ∞ F (DomC B.h (qsOf l0)) → ∀ k : ℕ,
      NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ v)) k ξ ≤ ‖v‖ * NB B.h F (k + 1) ξ := by
    intro ξ F w hξ hF k
    have hFd : ContDiffAt ℝ ∞ (fderiv ℝ F) ξ :=
      (hF.fderiv_of_isOpen hDo (by exact_mod_cast le_top)).contDiffAt (hDo.mem_nhds hξ)
    have hcomp : (fun η => fderiv ℝ F η (Lnorm B.h ξ w)) =
        (ContinuousLinearMap.apply ℝ (Fin 3 → ℂ) (Lnorm B.h ξ w)) ∘ (fderiv ℝ F) := by
      funext η; rfl
    have hit : iteratedFDeriv ℝ k (fun η => fderiv ℝ F η (Lnorm B.h ξ w)) ξ =
        (ContinuousLinearMap.apply ℝ (Fin 3 → ℂ) (Lnorm B.h ξ w)).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fderiv ℝ F) ξ) := by
      rw [hcomp]
      exact ContinuousLinearMap.iteratedFDeriv_comp_left _ hFd (by exact_mod_cast le_top)
    have hNB0 : 0 ≤ NB B.h F (k + 1) ξ := norm_nonneg _
    unfold NB
    rw [hit]
    apply ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg (norm_nonneg _) hNB0)
    intro m
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      ContinuousLinearMap.apply_apply]
    have key : (iteratedFDeriv ℝ k (fderiv ℝ F) ξ (fun i => Lnorm B.h ξ (m i))) (Lnorm B.h ξ w) =
        ((iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ))
          (Fin.snoc (α := fun _ => Cyl) m w) := by
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_succ_apply_right]
      have e1 : Fin.init (fun i : Fin (k+1) => Lnorm B.h ξ (Fin.snoc (α := fun _ => Cyl) m w i)) =
          fun i => Lnorm B.h ξ (m i) := by
        funext i
        simp [Fin.init, Fin.snoc_castSucc]
      rw [e1]
      simp only [Fin.snoc_last]
    rw [key]
    have hprod : ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ =
        (∏ i : Fin k, ‖m i‖) * ‖w‖ := by
      rw [Fin.prod_univ_castSucc]
      simp [Fin.snoc_castSucc, Fin.snoc_last]
    calc _ ≤ ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ *
          ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ :=
          ContinuousMultilinearMap.le_opNorm _ _
      _ = ‖w‖ * ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ *
          ∏ i : Fin k, ‖m i‖ := by rw [hprod]; ring

  have Gm : ∀ (γ : Lab) (m : ℤ) (ξ : Cyl), ξ ∉ tsupport (w γ m) →
      (fun η => dZ (w γ m) η) =ᶠ[nhds ξ] fun _ => (0 : Fin 3 → ℂ) := by
    intro γ m ξ hts
    have h0 : w γ m =ᶠ[nhds ξ] 0 := notMem_tsupport_iff_eventuallyEq.mp hts
    filter_upwards [h0.eventuallyEq_nhds] with η hη
    show fderiv ℝ (w γ m) η ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) = 0
    rw [hη.fderiv_eq]
    simp

  have hZv : InWg5 B G (qsOf l0) (α + 1 - 1 / (2 * B.h)) (fun γ m ξ => dZ (w γ m) ξ) := by
    obtain ⟨H, hH0, hHz⟩ := hw.1
    refine ⟨⟨H, hH0, fun γ m hm => ?_⟩, fun γ m => ?_, fun γ m ξ hξ c hc => ?_,
      fun γ m ξ hξ hne => ?_, fun k => ?_⟩
    · funext ξ
      show fderiv ℝ (w γ m) ξ ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) = 0
      rw [hHz γ m hm]
      simp
    · show ContDiffOn ℝ ∞ (fun ξ => fderiv ℝ (w γ m) ξ ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)))
        (DomC B.h (qsOf l0))
      exact ((hw.2.1 γ m).fderiv_of_isOpen hDo (by exact_mod_cast le_top)).clm_apply contDiffOn_const
    · show fderiv ℝ (w γ m) (shY ξ c) ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) =
        fderiv ℝ (w γ m) ξ ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ))
      have hloc : ∀ᶠ η in nhds ξ, w γ m (shY η c) = w γ m η := by
        filter_upwards [hDo.mem_nhds hξ, deck_locally_stable_v5 B l0 hok (by omega) ξ hξ c hc]
          with η hη hdη
        exact hw.2.2.1 γ m η hη c hdη
      obtain ⟨e, he⟩ : ∃ e : Cyl, e = ((0:ℝ), (0:ℝ), (0:ℝ), c) := ⟨_, rfl⟩
      have hsh : ∀ η : Cyl, shY η c = η + e := by
        intro η
        rw [he]
        simp only [shY]
        ext <;> simp
      have hfd : fderiv ℝ (w γ m) (shY ξ c) = fderiv ℝ (w γ m) ξ := by
        have hev : (fun x => w γ m (x + e)) =ᶠ[nhds ξ] w γ m :=
          hloc.mono (fun η hη => by
            show w γ m (η + e) = w γ m η
            rw [← hsh η, hη])
        rw [hsh ξ, ← fderiv_comp_add_right]
        exact hev.fderiv_eq
      rw [hfd]
    · by_cases hts : ξ ∈ tsupport (w γ m)
      · exact (Hp l0 (by omega) α w hw γ m ξ hξ hts).1
      · exact absurd (Gm γ m ξ hts).eq_of_nhds hne
    · obtain ⟨C, b, dd, hC⟩ := hw.2.2.2.2 (k + 1)
      refine ⟨C, b, dd, fun γ m ξ hξ hX1 hX2 => ?_⟩
      have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
      obtain ⟨v, hv, hvn⟩ := hframe ξ hq0
      have h1 := nbdir ξ (w γ m) v hξ (hw.2.1 γ m) k
      rw [hv] at h1
      have hb := hC γ m ξ hξ hX1 hX2
      have hNB0 : 0 ≤ NB B.h (w γ m) (k + 1) ξ := norm_nonneg _
      show NB B.h (fun η => fderiv ℝ (w γ m) η ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ))) k ξ ≤ _
      rw [show B.h * (α + 1 - 1 / (2 * B.h)) = -(1/2 - B.h) + B.h * α by
          linear_combination (-1:ℝ) * hu,
        Real.rpow_add hq0]
      calc _ ≤ ‖v‖ * NB B.h (w γ m) (k + 1) ξ := h1
        _ ≤ qC B.h ξ ^ (-(1/2 - B.h)) * NB B.h (w γ m) (k + 1) ξ :=
            mul_le_mul_of_nonneg_right hvn hNB0
        _ ≤ qC B.h ξ ^ (-(1/2 - B.h)) * _ := mul_le_mul_of_nonneg_left hb (Real.rpow_nonneg hq0.le _)
        _ = _ := by ring

  obtain ⟨hmult1, hmult2⟩ := wmo_amp_multipliers_v5 B hok (qsOf l0) hq1
  obtain ⟨μ, hμdef⟩ : ∃ μ : Lab → Cyl → ℂ, μ = fun _ η => ((Real.sqrt (qC B.h η) : ℝ) : ℂ) :=
    ⟨_, rfl⟩
  have hμ : ∀ γ, μ γ = (Complex.ofRealCLM : ℝ →L[ℝ] ℂ) ∘ (fun η => Real.sqrt (qC B.h η)) := by
    intro γ
    rw [hμdef]
    funext η
    rfl
  have hμd : ∀ γ, ∀ ξ ∈ DomC B.h (qsOf l0), ContDiffAt ℝ ∞ (μ γ) ξ := by
    intro γ ξ hξ
    rw [hμ γ]
    exact Complex.ofRealCLM.contDiff.contDiffAt.comp ξ (hmult1 ξ hξ).1
  have hNBμ : ∀ γ k, ∀ ξ ∈ DomC B.h (qsOf l0),
      NB B.h (μ γ) k ξ ≤ NB B.h (fun η => Real.sqrt (qC B.h η)) k ξ := by
    intro γ k ξ hξ
    unfold NB
    rw [hμ γ, ContinuousLinearMap.iteratedFDeriv_comp_left _ (hmult1 ξ hξ).1
      (by exact_mod_cast le_top)]
    have e : (Complex.ofRealCLM.compContinuousMultilinearMap
        (iteratedFDeriv ℝ k (fun η => Real.sqrt (qC B.h η)) ξ)).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) =
        Complex.ofRealCLM.compContinuousMultilinearMap
          ((iteratedFDeriv ℝ k (fun η => Real.sqrt (qC B.h η)) ξ).compContinuousLinearMap
            (fun _ => Lnorm B.h ξ)) := by
      ext v
      rfl
    rw [e]
    refine le_trans (ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _) ?_
    rw [Complex.ofRealCLM_norm, one_mul]
  have hNBc : ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      ξ ∈ tsupport (fun ξ => dZ (w γ m) ξ) → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      NB B.h (μ γ) k ξ ≤ C * qC B.h ξ ^ (B.h * (1 / (2 * B.h))) * SC B.h ξ ^ b := by
    intro k
    obtain ⟨C, hC⟩ := hmult2 k
    refine ⟨C, 0, fun γ m ξ hξ _ _ _ => ?_⟩
    rw [hu, Real.rpow_zero, mul_one, ← Real.sqrt_eq_rpow]
    exact le_trans (hNBμ γ k ξ hξ) (hC ξ hξ).1
  have hf := inWg5_smul_mult B G l0 hok (α + 1 - 1 / (2 * B.h)) (1 / (2 * B.h))
    (fun γ m ξ => dZ (w γ m) ξ) μ hZv (fun γ m ξ hξ _ => hμd γ ξ hξ)
    (fun γ m ξ hξ _ c _ => by rw [hμdef]; rfl) hNBc
  have hexp : α + 1 - 1 / (2 * B.h) + 1 / (2 * B.h) = α + 1 := by ring
  rw [hexp] at hf

  have hbr : ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0),
      (fun i => dZ (fun η => w γ m η i) ξ) = dZ (w γ m) ξ := by
    intro γ m ξ hξ
    have hd : DifferentiableAt ℝ (w γ m) ξ :=
      ((hw.2.1 γ m).contDiffAt (hDo.mem_nhds hξ)).differentiableAt (by norm_num)
    funext i
    have hc : HasFDerivAt (fun η => w γ m η i)
        ((ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i).comp
          (fderiv ℝ (w γ m) ξ)) ξ :=
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i).hasFDerivAt.comp ξ
        hd.hasFDerivAt
    unfold dZ
    rw [hc.fderiv]
    rfl
  have heq : ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0),
      ((Real.sqrt (qC B.h ξ) : ℝ) : ℂ) • (fun i => dZ (fun η => w γ m η i) ξ) =
        μ γ ξ • dZ (w γ m) ξ := by
    intro γ m ξ hξ
    rw [hbr γ m ξ hξ, hμdef]
  obtain ⟨f1, f2, f3, f4, f5⟩ := hf
  obtain ⟨⟨H, H0, hH⟩, -, -, -, -⟩ := hw
  refine ⟨⟨H, H0, fun γ m hm => ?_⟩, fun γ m => ?_, fun γ m ξ hξ c hc => ?_,
    fun γ m ξ hξ hne => ?_, fun k => ?_⟩
  · funext ξ
    have h0 : ∀ i : Fin 3, (fun η => w γ m η i) = fun _ => (0:ℂ) := by
      intro i
      funext η
      rw [hH γ m hm]
      rfl
    show ((Real.sqrt (qC B.h ξ) : ℝ) : ℂ) • (fun i => dZ (fun η => w γ m η i) ξ) = 0
    funext i
    simp only [Pi.smul_apply, Pi.zero_apply]
    rw [h0 i]
    simp [dZ]
  · exact (f2 γ m).congr (fun ξ hξ => heq γ m ξ hξ)
  · have hξ' : shY ξ c ∈ DomC B.h (qsOf l0) := hξ
    exact (heq γ m _ hξ').trans ((f3 γ m ξ hξ c hc).trans (heq γ m ξ hξ).symm)
  · exact f4 γ m ξ hξ (fun h0 => hne ((heq γ m ξ hξ).trans h0))
  · obtain ⟨C, b, d, hC⟩ := f5 k
    refine ⟨C, b, d, fun γ m ξ hξ hX1 hX2 => ?_⟩
    have hev : (fun η => ((Real.sqrt (qC B.h η) : ℝ) : ℂ) •
        (fun i => dZ (fun η' => w γ m η' i) η)) =ᶠ[nhds ξ]
        (fun η => μ γ η • dZ (w γ m) η) :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => heq γ m η hη)
    have hk := hC γ m ξ hξ hX1 hX2
    show NB B.h (fun η => ((Real.sqrt (qC B.h η) : ℝ) : ℂ) •
        (fun i => dZ (fun η' => w γ m η' i) η)) k ξ ≤ _
    unfold NB at hk ⊢
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    exact hk

theorem pq5_mult_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
  ∀ (α : ℝ) (w : WC), InWg5 B G (qsOf l0) α w →
  InWg5 B G (qsOf l0) α (fun γ m ξ => ((Real.sqrt (qC B.h ξ) / ξ.1 : ℝ) : ℂ) • crossC ![0, 0, 1] (w γ m ξ)) ∧
  InWg5 B G (qsOf l0) α (fun γ m ξ =>
    ((-(Aex B.h) * Real.sqrt (qC B.h ξ) * dZ (fun η => Real.log (qC B.h η)) ξ : ℝ) : ℂ) • w γ m ξ) ∧
  InWg5 B G (qsOf l0) (α - 1/2) (fun γ m ξ =>
    (Complex.I * (m : ℂ) * (((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) * Real.sqrt (qC B.h ξ) : ℝ) : ℂ)) • w γ m ξ) :=
by
  intro B G hok hG
  obtain ⟨lP, hP⟩ := pulse_support_good_v5 B G hok hG
  refine ⟨lP, fun l0 hl0 α w hw => ?_⟩
  have hh : 0 < B.h := hok.2.1.1



  have hNB0 : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (i : ℕ) (ξ : Cyl),
      0 ≤ NB B.h f i ξ := by
    intro V _ _ f i ξ
    unfold NB
    exact norm_nonneg _
  have hconst : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (c : V) (i : ℕ) (ξ : Cyl),
      NB B.h (fun _ : Cyl => c) i ξ ≤ ‖c‖ := by
    intro V _ _ c i ξ
    unfold NB
    rcases Nat.eq_zero_or_pos i with hi | hi
    · subst hi
      refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
      simp [norm_iteratedFDeriv_zero]
    · rw [iteratedFDeriv_const_of_ne hi.ne' c]
      have e : ((0 : Cyl → ContinuousMultilinearMap ℝ (fun _ : Fin i => Cyl) V) ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) = 0 := by
        ext v
        simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      rw [e, norm_zero]
      exact norm_nonneg _
  have hsmul : ∀ (c : ℂ) (f : Cyl → (Fin 3 → ℂ)) (ξ : Cyl) (i : ℕ), ContDiffAt ℝ ∞ f ξ →
      NB B.h (fun η => c • f η) i ξ ≤ ‖c‖ * NB B.h f i ξ := by
    intro c f ξ i hf
    unfold NB
    have e : (fun η => c • f η) = c • f := rfl
    rw [e, iteratedFDeriv_const_smul_apply (hf.of_le (by exact_mod_cast le_top))]
    have e2 : (c • iteratedFDeriv ℝ i f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
        c • ((iteratedFDeriv ℝ i f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext v
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    exact norm_smul_le (α := ℂ) c ((iteratedFDeriv ℝ i f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ))
  have hcoe : ∀ (g : Cyl → ℝ) (ξ : Cyl) (i : ℕ), ContDiffAt ℝ ∞ g ξ →
      NB B.h (fun η => ((g η : ℝ) : ℂ)) i ξ ≤ NB B.h g i ξ := by
    intro g ξ i hg
    unfold NB
    have e : (fun η => ((g η : ℝ) : ℂ)) = ⇑Complex.ofRealCLM ∘ g := by
      funext η
      simp
