    have heq : (3 * A + 3 * N * (3 * N * A + P) / ν + 3 * Eb * N ^ 2) * ‖y‖ =
        3 * A * ‖y‖ + ν⁻¹ * (N * (3 * (3 * N * A + P) * ‖y‖)) + Eb * (3 * N ^ 2) * ‖y‖ := by
