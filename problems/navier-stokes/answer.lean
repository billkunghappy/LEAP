            rw [e5, sq_abs, sq_abs]; linarith)
      _ = |w.1| + |w.2| := Real.sqrt_sq (by positivity)
  have hH : Hcol B G (γ.1, γ.2.1, σ) (ξ.1, ξ.2.1, ξ.2.2.1) =
      (P * cb) • ∫ v in (0:ℝ)..L, (psiT L v ^ 2 * T v 0) • (T v 1, T v 2) := by
    rw [hP, hcb, hLd, hT]; rfl
  refine ⟨P * cb * I, (A1 / I, A2 / I) - W, ?_, ?_, ?_, ?_⟩
  · calc P * k1 * Real.sqrt (2 * G.r0 / Tgc) / ℓ = P * k1 * (Real.sqrt (2 * G.r0 / Tgc) / ℓ) := by ring
      _ ≤ P * k1 * (cb * Real.sqrt L) := mul_le_mul_of_nonneg_left hcbLlo (mul_pos hP0 hk1p).le
      _ = P * cb * (k1 * Real.sqrt L) := by ring
      _ ≤ P * cb * I := mul_le_mul_of_nonneg_left hI1 (mul_pos hP0 hcb0).le
  · calc P * cb * I ≤ P * cb * (k2 * Real.sqrt L) := mul_le_mul_of_nonneg_left hI2 (mul_pos hP0 hcb0).le
      _ = P * k2 * (cb * Real.sqrt L) := by ring
      _ ≤ P * k2 * (Real.sqrt (2 * G.r0) / ℓ) :=
          mul_le_mul_of_nonneg_left hcbLhi (mul_nonneg hP0.le hk2p)
      _ = P * k2 * Real.sqrt (2 * G.r0) / ℓ := by ring
      _ ≤ _ := div_le_div_of_nonneg_right (le_max_left _ _) hℓ0.le
  · calc eN ((A1 / I, A2 / I) - W) ≤ |((A1 / I, A2 / I) - W).1| + |((A1 / I, A2 / I) - W).2| := heN _
      _ ≤ 2 * (Ct / ℓ + Ke / (Real.sqrt (2 * G.r0) * ℓ) + Df / ℓ) := by linarith
      _ = (2 * Ct + 2 * Ke / Real.sqrt (2 * G.r0) + 2 * Df) / ℓ := by
          have := hr2.ne'
          have := hℓ0.ne'
          field_simp
      _ ≤ _ := div_le_div_of_nonneg_right (le_max_right _ _) hℓ0.le
  · rw [← hc0, ← hSu, ← hN, ← hWd]
    have hadd : ∀ a b : ℝ × ℝ, a + (b - a) = b := fun a b => by abel
    rw [hadd, hH]
    have hg : IntervalIntegrable (fun v => (psiT L v ^ 2 * T v 0) • (T v 1, T v 2))
        MeasureTheory.volume 0 L :=
      (hw.smul ((hTj 1).prodMk (hTj 2))).intervalIntegrable_of_Icc hL0.le
    have h1 := (ContinuousLinearMap.fst ℝ ℝ ℝ).intervalIntegral_comp_comm hg
    have h2 := (ContinuousLinearMap.snd ℝ ℝ ℝ).intervalIntegral_comp_comm hg
    simp only [ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Prod.smul_fst,
      Prod.smul_snd, smul_eq_mul] at h1 h2
    have hIne := hI0.ne'
    refine Prod.ext ?_ ?_
    · show P * cb * (∫ v in (0:ℝ)..L, (psiT L v ^ 2 * T v 0) • (T v 1, T v 2)).1 = P * cb * I * (A1 / I)
      rw [← h1, ← hA1d]; field_simp
    · show P * cb * (∫ v in (0:ℝ)..L, (psiT L v ^ 2 * T v 0) • (T v 1, T v 2)).2 = P * cb * I * (A2 / I)
      rw [← h2, ← hA2d]; field_simp

theorem etaL_partition : ∀ (h : ℝ) (ξ : Cyl), 0 < qC h ξ → qC h ξ < 1 →
    {γ : Lab | etaL h γ ξ ≠ 0}.Finite ∧
    (∀ γ : Lab, etaL h γ ξ ≠ 0 → -Real.logb 2 (qC h ξ) - 1 < (γ.1 : ℝ)) ∧
    ∑ᶠ p : ℕ × (ℤ × ℤ × ℤ), etaL h (p.1, p.2, true) ξ ^ 2 = 1 :=
by
  classical
  intro h ξ hq0 hq1

  have hbump0 : ∀ u : ℝ, bumpR u ≠ 0 → |u| < 1 := by
    intro u hu
    by_contra hc
    push_neg at hc
    apply hu
    unfold bumpR
    apply Real.smoothTransition.zero_of_nonpos
    have : 1 ≤ u ^ 2 := (one_le_sq_iff_one_le_abs u).mpr hc
    linarith
  have hwin : ∀ (x : ℝ) (j : ℤ), bumpR (x - j) ≠ 0 → ⌊x⌋ ≤ j ∧ j ≤ ⌊x⌋ + 1 := by
    intro x j hj
    have h1 := abs_lt.mp (hbump0 _ hj)
    have h2 := Int.floor_le x
    have h3 := Int.lt_floor_add_one x
    constructor
    · have h4 : (⌊x⌋ : ℝ) < (j : ℝ) + 1 := by linarith
      have h5 : ⌊x⌋ < j + 1 := by exact_mod_cast h4
      omega
    · have h4 : (j : ℝ) < (⌊x⌋ : ℝ) + 2 := by linarith
      have h5 : j < ⌊x⌋ + 2 := by exact_mod_cast h4
      omega
  have hvan : ∀ (x : ℝ) (n : ℤ), n ∉ ({⌊x⌋, ⌊x⌋ + 1} : Finset ℤ) → bumpR (x - n) = 0 := by
    intro x n hn
    by_contra hc
    obtain ⟨a1, a2⟩ := hwin x n hc
    apply hn
    rw [Finset.mem_insert, Finset.mem_singleton]
    omega
  have hD : ∀ x : ℝ, (∑' n : ℤ, bumpR (x - n) ^ 2) =
      bumpR (x - ⌊x⌋) ^ 2 + bumpR (x - ((⌊x⌋ + 1 : ℤ) : ℝ)) ^ 2 := by
    intro x
    rw [tsum_eq_sum (s := ({⌊x⌋, ⌊x⌋ + 1} : Finset ℤ))]
    · rw [Finset.sum_pair (by omega)]
    · intro n hn
      rw [hvan x n hn]
      ring
  have hDpos : ∀ x : ℝ, 0 < bumpR (x - ⌊x⌋) ^ 2 + bumpR (x - ((⌊x⌋ + 1 : ℤ) : ℝ)) ^ 2 := by
    intro x
    have h2 := Int.floor_le x
    have h3 := Int.lt_floor_add_one x
    by_cases ht : x - ⌊x⌋ ≤ 1/2
    · have hp : 0 < bumpR (x - ⌊x⌋) := by
        unfold bumpR
        apply Real.smoothTransition.pos_of_pos
        nlinarith
      have := sq_nonneg (bumpR (x - ((⌊x⌋ + 1 : ℤ) : ℝ)))
      have := pow_pos hp 2
      linarith
    · have hp : 0 < bumpR (x - ((⌊x⌋ + 1 : ℤ) : ℝ)) := by
        unfold bumpR
        apply Real.smoothTransition.pos_of_pos
        push_cast
        push_neg at ht
        nlinarith
      have := sq_nonneg (bumpR (x - ⌊x⌋))
      have := pow_pos hp 2
      linarith
  have hsum : ∀ (μ s : ℝ) (U : Finset ℤ), ⌊s / μ⌋ ∈ U → ⌊s / μ⌋ + 1 ∈ U →
      ∑ j ∈ U, sqPart μ j s ^ 2 = 1 := by
    intro μ s U h1 h2
    have hDp := hDpos (s / μ)
    have hsq : ∀ j : ℤ, sqPart μ j s ^ 2 = bumpR (s / μ - j) ^ 2 /
        (bumpR (s / μ - ⌊s / μ⌋) ^ 2 + bumpR (s / μ - ((⌊s / μ⌋ + 1 : ℤ) : ℝ)) ^ 2) := by
      intro j
      unfold sqPart
      rw [hD (s / μ), div_pow, Real.sq_sqrt hDp.le]
    simp only [hsq]
    rw [← Finset.sum_div]
    rw [← Finset.sum_subset (s₁ := ({⌊s / μ⌋, ⌊s / μ⌋ + 1} : Finset ℤ))]
    · rw [Finset.sum_pair (by omega)]
      exact div_self hDp.ne'
    · intro j hj
      rw [Finset.mem_insert, Finset.mem_singleton] at hj
      rcases hj with rfl | rfl
      · exact h1
      · exact h2
    · intro j _ hj
      rw [hvan (s / μ) j hj]
      ring
  have hsqwin : ∀ (μ s : ℝ) (j : ℤ), sqPart μ j s ≠ 0 →
      |s / μ - j| < 1 ∧ ⌊s / μ⌋ ≤ j ∧ j ≤ ⌊s / μ⌋ + 1 := by
    intro μ s j hne
    have hb : bumpR (s / μ - j) ≠ 0 := by
      intro h0
      apply hne
      unfold sqPart
      rw [h0, zero_div]
    exact ⟨hbump0 _ hb, hwin _ _ hb⟩

  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = Real.logb 2 (qC h ξ) := ⟨_, rfl⟩
  have hsneg : s < 0 := by rw [hs]; exact Real.logb_neg (by norm_num) hq0 hq1
  obtain ⟨a, ha⟩ : ∃ a : ℤ, a = ⌊s⌋ := ⟨_, rfl⟩
  have hale : a ≤ -1 := by
    have h1 : (a : ℝ) ≤ s := by rw [ha]; exact Int.floor_le s
    have h2 : (a : ℝ) < 0 := by linarith
    have h3 : a < 0 := by exact_mod_cast h2
    omega
  obtain ⟨m, hm⟩ : ∃ m : ℕ, (m : ℤ) = -a - 1 := ⟨(-a - 1).toNat, Int.toNat_of_nonneg (by omega)⟩
  obtain ⟨L, hL⟩ : ∃ L : Finset ℕ, L = {m, m + 1} := ⟨_, rfl⟩
  obtain ⟨μ, hμ⟩ : ∃ μ : ℕ → ℝ, μ = fun l => Sb l ^ (-3:ℤ) := ⟨_, rfl⟩
  obtain ⟨W, hW⟩ : ∃ W : ℕ → Finset (ℤ × ℤ × ℤ), W = fun l =>
      ({⌊chartR h l ξ / μ l⌋, ⌊chartR h l ξ / μ l⌋ + 1} : Finset ℤ) ×ˢ
      (({⌊chartZ h l ξ / μ l⌋, ⌊chartZ h l ξ / μ l⌋ + 1} : Finset ℤ) ×ˢ
       ({⌊chartT h l ξ / μ l⌋, ⌊chartT h l ξ / μ l⌋ + 1} : Finset ℤ)) := ⟨_, rfl⟩
  have hfac : ∀ (l : ℕ) (k : ℤ × ℤ × ℤ) (σ : Bool), etaL h (l, k, σ) ξ =
      sqPart 1 (-(l:ℤ)) s * (sqPart (μ l) k.1 (chartR h l ξ) * sqPart (μ l) k.2.1 (chartZ h l ξ) *
        sqPart (μ l) k.2.2 (chartT h l ξ)) := by
    intro l k σ
    rw [hs, hμ]
    rfl
  have hnz : ∀ (l : ℕ) (k : ℤ × ℤ × ℤ) (σ : Bool), etaL h (l, k, σ) ξ ≠ 0 →
      (-s - 1 < (l:ℝ)) ∧ l ∈ L ∧ k ∈ W l := by
    intro l k σ hne
    rw [hfac] at hne
    obtain ⟨hA, hB⟩ := mul_ne_zero_iff.mp hne
    obtain ⟨hB12, hB3⟩ := mul_ne_zero_iff.mp hB
    obtain ⟨hB1, hB2⟩ := mul_ne_zero_iff.mp hB12
    obtain ⟨wA, wA1, wA2⟩ := hsqwin _ _ _ hA
    rw [div_one, ← ha] at wA1 wA2
    rw [div_one] at wA
    push_cast at wA
    obtain ⟨-, w1a, w1b⟩ := hsqwin _ _ _ hB1
    obtain ⟨-, w2a, w2b⟩ := hsqwin _ _ _ hB2
    obtain ⟨-, w3a, w3b⟩ := hsqwin _ _ _ hB3
    refine ⟨?_, ?_, ?_⟩
    · have := (abs_lt.mp wA).1
      linarith
    · rw [hL, Finset.mem_insert, Finset.mem_singleton]
      omega
    · rw [hW]
      simp only [Finset.mem_product, Finset.mem_insert, Finset.mem_singleton]
      omega
  refine ⟨?_, ?_, ?_⟩
  ·
    apply Set.Finite.subset (Finset.finite_toSet
      (L.biUnion (fun l => ({l} : Finset ℕ) ×ˢ (W l ×ˢ (Finset.univ : Finset Bool)))))
    intro γ hγ
    obtain ⟨l, k, σ⟩ := γ
    obtain ⟨-, h1, h2⟩ := hnz l k σ hγ
    rw [Finset.mem_coe, Finset.mem_biUnion]
    exact ⟨l, h1, Finset.mem_product.mpr ⟨Finset.mem_singleton_self _,
      Finset.mem_product.mpr ⟨h2, Finset.mem_univ _⟩⟩⟩
  ·
    intro γ hγ
    obtain ⟨l, k, σ⟩ := γ
    obtain ⟨h1, -, -⟩ := hnz l k σ hγ
    rw [← hs]
    exact h1
  ·
    obtain ⟨P, hPdef⟩ : ∃ P : Finset (ℕ × (ℤ × ℤ × ℤ)),
        P = L.biUnion (fun l => ({l} : Finset ℕ) ×ˢ W l) := ⟨_, rfl⟩
    have hP : ∀ p : ℕ × (ℤ × ℤ × ℤ), p ∈ P ↔ p.1 ∈ L ∧ p.2 ∈ W p.1 := by
      intro p
      rw [hPdef, Finset.mem_biUnion]
      constructor
      · rintro ⟨l, hl, hp⟩
        rw [Finset.mem_product, Finset.mem_singleton] at hp
        rw [hp.1]
        exact ⟨hl, hp.1 ▸ hp.2⟩
      · rintro ⟨h1, h2⟩
        exact ⟨p.1, h1, Finset.mem_product.mpr ⟨Finset.mem_singleton_self _, h2⟩⟩
    have hsupp : Function.support (fun p : ℕ × (ℤ × ℤ × ℤ) => etaL h (p.1, p.2, true) ξ ^ 2) ⊆ ↑P := by
      intro p hp
      rw [Function.mem_support] at hp
      have hne : etaL h (p.1, p.2, true) ξ ≠ 0 := fun h0 => hp (by rw [h0]; ring)
      obtain ⟨-, h1, h2⟩ := hnz p.1 p.2 true hne
      exact Finset.mem_coe.mpr ((hP p).mpr ⟨h1, h2⟩)
    have hinner : ∀ l : ℕ, ∑ k ∈ W l, etaL h (l, k, true) ξ ^ 2 = sqPart 1 (-(l:ℤ)) s ^ 2 := by
      intro l
      have e1 := hsum (μ l) (chartR h l ξ) ({⌊chartR h l ξ / μ l⌋, ⌊chartR h l ξ / μ l⌋ + 1} : Finset ℤ)
        (Finset.mem_insert_self _ _) (Finset.mem_insert_of_mem (Finset.mem_singleton_self _))
      have e2 := hsum (μ l) (chartZ h l ξ) ({⌊chartZ h l ξ / μ l⌋, ⌊chartZ h l ξ / μ l⌋ + 1} : Finset ℤ)
        (Finset.mem_insert_self _ _) (Finset.mem_insert_of_mem (Finset.mem_singleton_self _))
      have e3 := hsum (μ l) (chartT h l ξ) ({⌊chartT h l ξ / μ l⌋, ⌊chartT h l ξ / μ l⌋ + 1} : Finset ℤ)
        (Finset.mem_insert_self _ _) (Finset.mem_insert_of_mem (Finset.mem_singleton_self _))
      have hWl : W l = ({⌊chartR h l ξ / μ l⌋, ⌊chartR h l ξ / μ l⌋ + 1} : Finset ℤ) ×ˢ
          (({⌊chartZ h l ξ / μ l⌋, ⌊chartZ h l ξ / μ l⌋ + 1} : Finset ℤ) ×ˢ
           ({⌊chartT h l ξ / μ l⌋, ⌊chartT h l ξ / μ l⌋ + 1} : Finset ℤ)) := by rw [hW]
      rw [hWl]
      calc _ = ∑ k1 ∈ ({⌊chartR h l ξ / μ l⌋, ⌊chartR h l ξ / μ l⌋ + 1} : Finset ℤ),
              ∑ k2 ∈ ({⌊chartZ h l ξ / μ l⌋, ⌊chartZ h l ξ / μ l⌋ + 1} : Finset ℤ),
              ∑ k3 ∈ ({⌊chartT h l ξ / μ l⌋, ⌊chartT h l ξ / μ l⌋ + 1} : Finset ℤ),
                sqPart 1 (-(l:ℤ)) s ^ 2 * (sqPart (μ l) k1 (chartR h l ξ) ^ 2 *
                  (sqPart (μ l) k2 (chartZ h l ξ) ^ 2 * sqPart (μ l) k3 (chartT h l ξ) ^ 2)) := by
            rw [Finset.sum_product]
            apply Finset.sum_congr rfl
            intro k1 _
            rw [Finset.sum_product]
            apply Finset.sum_congr rfl
            intro k2 _
            apply Finset.sum_congr rfl
            intro k3 _
            rw [hfac]
            ring
        _ = sqPart 1 (-(l:ℤ)) s ^ 2 *
            ((∑ j ∈ ({⌊chartR h l ξ / μ l⌋, ⌊chartR h l ξ / μ l⌋ + 1} : Finset ℤ),
                sqPart (μ l) j (chartR h l ξ) ^ 2) *
             ((∑ j ∈ ({⌊chartZ h l ξ / μ l⌋, ⌊chartZ h l ξ / μ l⌋ + 1} : Finset ℤ),
                sqPart (μ l) j (chartZ h l ξ) ^ 2) *
              (∑ j ∈ ({⌊chartT h l ξ / μ l⌋, ⌊chartT h l ξ / μ l⌋ + 1} : Finset ℤ),
                sqPart (μ l) j (chartT h l ξ) ^ 2))) := by
            rw [Finset.sum_mul_sum, Finset.sum_mul, Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro k1 _
            simp only [Finset.mul_sum]
        _ = sqPart 1 (-(l:ℤ)) s ^ 2 := by rw [e1, e2, e3]; ring
    have hout : ∑ l ∈ L, sqPart 1 (-(l:ℤ)) s ^ 2 = 1 := by
      have hpair := hsum 1 s ({a, a + 1} : Finset ℤ)
        (by rw [div_one, ← ha]; exact Finset.mem_insert_self _ _)
        (by rw [div_one, ← ha]; exact Finset.mem_insert_of_mem (Finset.mem_singleton_self _))
      rw [Finset.sum_pair (by omega)] at hpair
      have e1 : -((m : ℕ) : ℤ) = a + 1 := by omega
      have e2 : -(((m + 1 : ℕ)) : ℤ) = a := by push_cast; omega
      rw [hL, Finset.sum_pair (by omega), e1, e2]
      linarith
    rw [finsum_eq_sum_of_support_subset _ hsupp, Finset.sum_finset_product P L W hP, ← hout]
    exact Finset.sum_congr rfl (fun l _ => hinner l)

theorem nb_of_proj {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (h : ℝ) (f : ℝ × ℝ × ℝ → V)
    (ξ : Cyl) (k : ℕ) (hf : ContDiffAt ℝ ∞ f (ξ.1, ξ.2.1, ξ.2.2.1)) :
    NB h (fun η : Cyl => f (η.1, η.2.1, η.2.2.1)) k ξ ≤ sJet5 f (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) k :=
by
  let π : Cyl →L[ℝ] (ℝ × ℝ × ℝ) :=
    (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))).prod
      (((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))).prod
        ((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp
          ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
            (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))))))
  have hπ : ∀ η : Cyl, π η = (η.1, η.2.1, η.2.2.1) := fun η => rfl
  have hfun : (fun η : Cyl => f (η.1, η.2.1, η.2.2.1)) = f ∘ ⇑π := rfl

  have hπn : ‖π‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun w => ?_)
    rw [hπ, one_mul]
    have h1 : ‖w.1‖ ≤ ‖w‖ := norm_fst_le w
    have h2 : ‖w.2.1‖ ≤ ‖w‖ := (norm_fst_le w.2).trans (norm_snd_le w)
    have h3 : ‖w.2.2.1‖ ≤ ‖w‖ :=
      ((norm_fst_le w.2.2).trans (norm_snd_le w.2)).trans (norm_snd_le w)
    rw [Prod.norm_def, Prod.norm_def]
    exact max_le h1 (max_le h2 h3)

  obtain ⟨u, hu, hfu⟩ := hf.contDiffOn (m := (k : ℕ∞ω)) (by exact_mod_cast le_top) (by simp)
  obtain ⟨t, htu, ht_open, hs0t⟩ := mem_nhds_iff.mp hu
  have hft : ContDiffOn ℝ k f t := hfu.mono htu
  have hpre_open : IsOpen (π ⁻¹' t) := ht_open.preimage π.continuous
  have hξt : ξ ∈ π ⁻¹' t := hs0t
  have hchain := π.iteratedFDerivWithin_comp_right hft ht_open.uniqueDiffOn
    hpre_open.uniqueDiffOn hξt le_rfl
  have e1 : iteratedFDerivWithin ℝ k (f ∘ ⇑π) (π ⁻¹' t) ξ = iteratedFDeriv ℝ k (f ∘ ⇑π) ξ :=
    iteratedFDerivWithin_of_isOpen k hpre_open hξt
  have e2 : iteratedFDerivWithin ℝ k f t (π ξ) = iteratedFDeriv ℝ k f (ξ.1, ξ.2.1, ξ.2.2.1) :=
    iteratedFDerivWithin_of_isOpen k ht_open hs0t
  rw [e1, e2] at hchain
  have hmain : iteratedFDeriv ℝ k (fun η : Cyl => f (η.1, η.2.1, η.2.2.1)) ξ =
      (iteratedFDeriv ℝ k f (ξ.1, ξ.2.1, ξ.2.2.1)).compContinuousLinearMap (fun _ => π) := by
    rw [hfun]; exact hchain
  have e : ((iteratedFDeriv ℝ k f (ξ.1, ξ.2.1, ξ.2.2.1)).compContinuousLinearMap
      (fun _ => π)).compContinuousLinearMap (fun _ => Lnorm h ξ) =
      ((iteratedFDeriv ℝ k f (ξ.1, ξ.2.1, ξ.2.2.1)).compContinuousLinearMap
        (fun _ : Fin k => DqS5 h ξ)).compContinuousLinearMap (fun _ => π) := by
    ext v
    rfl
  unfold NB sJet5
  rw [hmain, e]
  refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
  rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  exact mul_le_of_le_one_right (norm_nonneg _) (pow_le_one₀ (norm_nonneg _) hπn)

theorem njet_bilinear {E F₁ F₂ F₃ : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F₁]
    [NormedSpace ℝ F₁] [NormedAddCommGroup F₂] [NormedSpace ℝ F₂] [NormedAddCommGroup F₃] [NormedSpace ℝ F₃]
    (Bil : F₁ →L[ℝ] F₂ →L[ℝ] F₃) (f : E → F₁) (g : E → F₂) (x0 : E) (Λ : E →L[ℝ] E) (k : ℕ)
    (hf : ContDiffAt ℝ ∞ f x0) (hg : ContDiffAt ℝ ∞ g x0) :
    ContDiffAt ℝ ∞ (fun x => Bil (f x) (g x)) x0 ∧
      sJet5 (fun x => Bil (f x) (g x)) x0 Λ k ≤
        ‖Bil‖ * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * sJet5 f x0 Λ i * sJet5 g x0 Λ (k - i) :=
by
  have hBf : ContDiffAt ℝ ∞ (fun x => Bil (f x)) x0 := Bil.contDiff.contDiffAt.comp x0 hf
  refine ⟨hBf.clm_apply hg, ?_⟩
  have hf' : ContDiffAt ℝ k f x0 := hf.of_le (by exact_mod_cast le_top)
  have hg' : ContDiffAt ℝ k g x0 := hg.of_le (by exact_mod_cast le_top)
  obtain ⟨uf, huf, hfu⟩ := hf'.contDiffOn le_rfl (by simp)
  obtain ⟨ug, hug, hgu⟩ := hg'.contDiffOn le_rfl (by simp)
  obtain ⟨O, hOsub, hOopen, hxO⟩ := mem_nhds_iff.mp (Filter.inter_mem huf hug)
  have hfO : ContDiffOn ℝ k f O := hfu.mono (fun x hx => (hOsub hx).1)
  have hgO : ContDiffOn ℝ k g O := hgu.mono (fun x hx => (hOsub hx).2)
  have hBO : ContDiffOn ℝ k (fun x => Bil (f x) (g x)) O :=
    (Bil.contDiff.comp_contDiffOn hfO).clm_apply hgO
  obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => x0 + z) ⁻¹' O := ⟨_, rfl⟩
  have hs : IsOpen s := by
    rw [hs_def]; exact hOopen.preimage (continuous_const.add continuous_id)
  have hO : IsOpen (⇑Λ ⁻¹' s) := hs.preimage Λ.continuous
  have h0s : (0 : E) ∈ s := by
    rw [hs_def]; show x0 + 0 ∈ O; rw [add_zero]; exact hxO
  have hL0s : Λ 0 ∈ s := by rw [map_zero]; exact h0s
  have h0O : (0 : E) ∈ ⇑Λ ⁻¹' s := hL0s
  have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : E → W),
      ContDiffOn ℝ k F O → ContDiffOn ℝ k (fun z => F (x0 + z)) s := by
    intro W _ _ F hF
    exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
      (fun z hz => by rw [hs_def] at hz; exact hz)
  have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : E → W),
      ContDiffOn ℝ k F O → ContDiffOn ℝ k (fun z => F (x0 + Λ z)) (⇑Λ ⁻¹' s) := by
    intro W _ _ F hF
    exact (hsm F hF).comp Λ.contDiff.contDiffOn (fun z hz => hz)
  have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : E → W),
      ContDiffOn ℝ k F O → ∀ i : ℕ, i ≤ k →
      iteratedFDeriv ℝ i (fun z => F (x0 + Λ z)) 0 =
        (iteratedFDeriv ℝ i F x0).compContinuousLinearMap (fun _ => Λ) := by
    intro W _ _ F hF i hi
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (x0 + Λ z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right Λ (hsm F hF) hs.uniqueDiffOn
      hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (x0 + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i x0 0
    calc iteratedFDeriv ℝ i (fun z => F (x0 + Λ z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (x0 + z)) ∘ ⇑Λ) (⇑Λ ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (x0 + z)) s (Λ 0)).compContinuousLinearMap
            (fun _ => Λ) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (x0 + z)) s 0).compContinuousLinearMap
            (fun _ => Λ) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (x0 + z)) 0).compContinuousLinearMap
            (fun _ => Λ) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F x0).compContinuousLinearMap (fun _ => Λ) := by rw [e4, add_zero]
  have hl := ContinuousLinearMap.norm_iteratedFDerivWithin_le_of_bilinear Bil (hsmO f hfO)
    (hsmO g hgO) hO.uniqueDiffOn h0O (n := k) le_rfl
  rw [iteratedFDerivWithin_of_isOpen (f := fun y => Bil (f (x0 + Λ y)) (g (x0 + Λ y))) k hO h0O]
    at hl
  unfold sJet5
  rw [← key _ hBO k le_rfl]
  calc ‖iteratedFDeriv ℝ k (fun z => (fun x => Bil (f x) (g x)) (x0 + Λ z)) 0‖
      = ‖iteratedFDeriv ℝ k (fun y => Bil (f (x0 + Λ y)) (g (x0 + Λ y))) 0‖ := rfl
    _ ≤ _ := hl
    _ = _ := by
      congr 1
      apply Finset.sum_congr rfl
      intro i hi
      have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (x0 + Λ z)) i hO h0O,
        iteratedFDerivWithin_of_isOpen (f := fun z => g (x0 + Λ z)) (k - i) hO h0O,
        key f hfO i hik, key g hgO (k - i) (Nat.sub_le k i)]

theorem njet_inv {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (g : E → ℝ) (x0 : E) (Λ : E →L[ℝ] E)
    (k : ℕ) (δ A : ℝ) (hg : ContDiffAt ℝ ∞ g x0) (hδ : 0 < δ) (hδg : δ ≤ |g x0|) (hA : 0 ≤ A)
    (hbd : ∀ i : ℕ, 1 ≤ i → i ≤ k → sJet5 g x0 Λ i ≤ A) :
    ContDiffAt ℝ ∞ (fun x => (g x)⁻¹) x0 ∧
      sJet5 (fun x => (g x)⁻¹) x0 Λ k ≤ (k.factorial : ℝ) ^ 2 * (1 + δ⁻¹) ^ (k + 1) * (1 + A) ^ k :=
by
  have hne : g x0 ≠ 0 := abs_pos.mp (lt_of_lt_of_le hδ hδg)
  refine ⟨hg.inv hne, ?_⟩

  have hgk : ContDiffAt ℝ k g x0 := hg.of_le (by exact_mod_cast le_top)
  obtain ⟨u, hu, hgu⟩ := hgk.contDiffOn le_rfl (by simp)
  obtain ⟨t, htu, ht, hxt⟩ := mem_nhds_iff.mp hu
  have hgt : ContDiffOn ℝ k g t := hgu.mono htu
  obtain ⟨U, hUdef⟩ : ∃ U : Set E, U = t ∩ g ⁻¹' {(0:ℝ)}ᶜ := ⟨_, rfl⟩
  have hU : IsOpen U := by
    rw [hUdef]; exact hgt.continuousOn.isOpen_inter_preimage ht isOpen_compl_singleton
  have hxU : x0 ∈ U := by rw [hUdef]; exact ⟨hxt, hne⟩
  have hgU : ContDiffOn ℝ k g U := by rw [hUdef]; exact hgt.mono Set.inter_subset_left
  have hgne : ∀ η ∈ U, g η ∈ ({(0:ℝ)}ᶜ : Set ℝ) := by
    intro η hη; rw [hUdef] at hη; exact hη.2
  have hinvs : ContDiffOn ℝ k (fun x : ℝ => x⁻¹) ({(0:ℝ)}ᶜ) := contDiffOn_inv ℝ

  have key : ∀ (F : E → ℝ) (V : Set E) (a : E) (T : E →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ k F V → a ∈ V → ∀ i : ℕ, i ≤ k →
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro F V a T hV hF ha i hi
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : E) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ k (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast hi)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  have hinvb : ∀ (j : ℕ) (y : ℝ), δ ≤ |y| →
      ‖iteratedFDeriv ℝ j (fun x : ℝ => x⁻¹) y‖ ≤ (j.factorial : ℝ) * (δ⁻¹) ^ (j + 1) := by
    intro j y hy
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate]
    have e : (fun x : ℝ => x⁻¹) = Inv.inv := rfl
    rw [e, iter_deriv_inv]
    have e2 : (-1 - (j:ℤ)) = -((j + 1 : ℕ) : ℤ) := by push_cast; ring
    rw [e2, zpow_neg, zpow_natCast, norm_mul, norm_mul, norm_pow, norm_neg, norm_one, one_pow,
      one_mul, norm_inv, norm_pow, Real.norm_eq_abs y, Real.norm_natCast]
    apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
    rw [inv_pow]
    exact inv_anti₀ (pow_pos hδ _) (pow_le_pow_left₀ hδ.le hy _)
  obtain ⟨Cg, hCg⟩ : ∃ Cg : ℝ, Cg = (k.factorial : ℝ) * (1 + δ⁻¹) ^ (k + 1) := ⟨_, rfl⟩
  have hCgb : ∀ j : ℕ, j ≤ k → ‖iteratedFDeriv ℝ j (fun x : ℝ => x⁻¹) (g x0)‖ ≤ Cg := by
    intro j hj
    refine le_trans (hinvb j (g x0) hδg) ?_
    rw [hCg]
    have hi0 : (0:ℝ) ≤ δ⁻¹ := inv_nonneg.mpr hδ.le
    have m1 : (1:ℝ) ≤ 1 + δ⁻¹ := by linarith
    have b1 : (δ⁻¹) ^ (j + 1) ≤ (1 + δ⁻¹) ^ (j + 1) :=
      pow_le_pow_left₀ hi0 (by linarith) _
    have b2 : (1 + δ⁻¹) ^ (j + 1) ≤ (1 + δ⁻¹) ^ (k + 1) :=
      pow_le_pow_right₀ m1 (by omega)
    have b3 : (j.factorial : ℝ) ≤ k.factorial := by exact_mod_cast Nat.factorial_le hj
    exact mul_le_mul b3 (b1.trans b2) (by positivity) (by positivity)

  obtain ⟨O, hOdef⟩ : ∃ O : Set E, O = (fun z => x0 + Λ z) ⁻¹' U := ⟨_, rfl⟩
  have hO : IsOpen O := by
    rw [hOdef]; exact hU.preimage (continuous_const.add Λ.continuous)
  have h0O : (0 : E) ∈ O := by
    rw [hOdef]; show x0 + Λ 0 ∈ U; rw [map_zero, add_zero]; exact hxU
  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : E → ℝ, Φ = fun z => g (x0 + Λ z) := ⟨_, rfl⟩
  have hΦ : ContDiffOn ℝ k Φ O := by
    rw [hΦdef]
    exact hgU.comp (contDiff_const.add Λ.contDiff).contDiffOn
      (fun z hz => by rw [hOdef] at hz; exact hz)
  have hΦmaps : Set.MapsTo Φ O ({(0:ℝ)}ᶜ) := by
    intro z hz; rw [hΦdef]; rw [hOdef] at hz; exact hgne _ hz
  have hΦ0 : Φ 0 = g x0 := by
    rw [hΦdef]; show g (x0 + Λ 0) = g x0; rw [map_zero, add_zero]
  have hCw : ∀ j ≤ k, ‖iteratedFDerivWithin ℝ j (fun x : ℝ => x⁻¹) ({(0:ℝ)}ᶜ) (Φ 0)‖ ≤ Cg := by
    intro j hj
    rw [hΦ0, iteratedFDerivWithin_of_isOpen j isOpen_compl_singleton
      (show g x0 ∈ ({(0:ℝ)}ᶜ : Set ℝ) from hne)]
    exact hCgb j hj
  have hDw : ∀ j, 1 ≤ j → j ≤ k → ‖iteratedFDerivWithin ℝ j Φ O 0‖ ≤ (1 + A) ^ j := by
    intro j hj1 hjk
    rw [iteratedFDerivWithin_of_isOpen j hO h0O, hΦdef, key g U x0 Λ hU hgU hxU j hjk]
    have h1 : sJet5 g x0 Λ j ≤ A := hbd j hj1 hjk
    unfold sJet5 at h1
    calc _ ≤ A := h1
      _ ≤ 1 + A := by linarith
      _ ≤ (1 + A) ^ j := le_self_pow₀ (by linarith) (by omega)
  have hFdB := norm_iteratedFDerivWithin_comp_le hinvs hΦ le_rfl
    isOpen_compl_singleton.uniqueDiffOn hO.uniqueDiffOn hΦmaps h0O (C := Cg) (D := 1 + A) hCw hDw
  have hG : ContDiffOn ℝ k (fun η => (g η)⁻¹) U := hinvs.comp hgU (fun η hη => hgne η hη)
  have hEq : (fun z => (g (x0 + Λ z))⁻¹) = (fun x : ℝ => x⁻¹) ∘ Φ := by
    rw [hΦdef]; rfl
  have hJeq : sJet5 (fun x => (g x)⁻¹) x0 Λ k =
      ‖iteratedFDeriv ℝ k (fun z => (g (x0 + Λ z))⁻¹) 0‖ := by
    have := key (fun η => (g η)⁻¹) U x0 Λ hU hG hxU k le_rfl
    unfold sJet5
    rw [← this]
  calc sJet5 (fun x => (g x)⁻¹) x0 Λ k
      = ‖iteratedFDeriv ℝ k ((fun x : ℝ => x⁻¹) ∘ Φ) 0‖ := by rw [hJeq, hEq]
    _ = ‖iteratedFDerivWithin ℝ k ((fun x : ℝ => x⁻¹) ∘ Φ) O 0‖ := by
        rw [iteratedFDerivWithin_of_isOpen k hO h0O]
    _ ≤ (k.factorial : ℝ) * Cg * (1 + A) ^ k := hFdB
    _ = (k.factorial : ℝ) ^ 2 * (1 + δ⁻¹) ^ (k + 1) * (1 + A) ^ k := by rw [hCg]; ring

theorem sjet_comp_le : ∀ {E F G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G] [NormedSpace ℝ G] (g : F → G) (f : E → F) (x0 : E) (Λ : E →L[ℝ] E) (n : ℕ) (C D : ℝ), ContDiffAt ℝ ∞ f x0 → ContDiffAt ℝ ∞ g (f x0) → (∀ i : ℕ, i ≤ n → ‖iteratedFDeriv ℝ i g (f x0)‖ ≤ C) → (∀ i : ℕ, 1 ≤ i → i ≤ n → sJet5 f x0 Λ i ≤ D ^ i) → ContDiffAt ℝ ∞ (g ∘ f) x0 ∧ sJet5 (g ∘ f) x0 Λ n ≤ (n.factorial : ℝ) * C * D ^ n :=
by
  intro E F G _ _ _ _ _ _ g f x0 Λ n C D hf hg hC hD
  refine ⟨hg.comp x0 hf, ?_⟩

  have hgn : ContDiffAt ℝ n g (f x0) := hg.of_le (by exact_mod_cast le_top)
  obtain ⟨v, hv, hgv⟩ := hgn.contDiffOn le_rfl (by simp)
  obtain ⟨V, hVv, hV, hfxV⟩ := mem_nhds_iff.mp hv
  have hgV : ContDiffOn ℝ n g V := hgv.mono hVv

  have hfn : ContDiffAt ℝ n f x0 := hf.of_le (by exact_mod_cast le_top)
  obtain ⟨u, hu, hfu⟩ := hfn.contDiffOn le_rfl (by simp)
  obtain ⟨t, htu, ht, hxt⟩ := mem_nhds_iff.mp hu
  have hft : ContDiffOn ℝ n f t := hfu.mono htu
  obtain ⟨U, hUdef⟩ : ∃ U : Set E, U = t ∩ f ⁻¹' V := ⟨_, rfl⟩
  have hU : IsOpen U := by
    rw [hUdef]; exact hft.continuousOn.isOpen_inter_preimage ht hV
  have hxU : x0 ∈ U := by rw [hUdef]; exact ⟨hxt, hfxV⟩
  have hfU : ContDiffOn ℝ n f U := by rw [hUdef]; exact hft.mono Set.inter_subset_left
  have hmapU : ∀ y ∈ U, f y ∈ V := by
    intro y hy; rw [hUdef] at hy; exact hy.2
  have hgfU : ContDiffOn ℝ n (g ∘ f) U := hgV.comp hfU hmapU

  have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F' : E → W) (V' : Set E) (a : E)
      (T : E →L[ℝ] E), IsOpen V' → ContDiffOn ℝ n F' V' → a ∈ V' → ∀ i : ℕ, i ≤ n →
      iteratedFDeriv ℝ i (fun z => F' (a + T z)) 0 =
        (iteratedFDeriv ℝ i F' a).compContinuousLinearMap (fun _ => T) := by
    intro W _ _ F' V' a T hV' hF ha i hi
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V' := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV'.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V'; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : E) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ n (fun z => F' (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F' (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast hi)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F' (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F') i a 0
    calc iteratedFDeriv ℝ i (fun z => F' (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F' (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F' (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F' (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F' (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F' a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  obtain ⟨O, hOdef⟩ : ∃ O : Set E, O = (fun z => x0 + Λ z) ⁻¹' U := ⟨_, rfl⟩
  have hO : IsOpen O := by
    rw [hOdef]; exact hU.preimage (continuous_const.add Λ.continuous)
  have h0O : (0 : E) ∈ O := by
    rw [hOdef]; show x0 + Λ 0 ∈ U; rw [map_zero, add_zero]; exact hxU
  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : E → F, Φ = fun z => f (x0 + Λ z) := ⟨_, rfl⟩
  have hΦ : ContDiffOn ℝ n Φ O := by
    rw [hΦdef]
    exact hfU.comp (contDiff_const.add Λ.contDiff).contDiffOn
      (fun z hz => by rw [hOdef] at hz; exact hz)
  have hΦmaps : Set.MapsTo Φ O V := by
    intro z hz; rw [hΦdef]; rw [hOdef] at hz; exact hmapU _ hz
  have hΦ0 : Φ 0 = f x0 := by
    rw [hΦdef]; show f (x0 + Λ 0) = f x0; rw [map_zero, add_zero]
  have hCw : ∀ j ≤ n, ‖iteratedFDerivWithin ℝ j g V (Φ 0)‖ ≤ C := by
    intro j hj
    rw [hΦ0, iteratedFDerivWithin_of_isOpen j hV hfxV]
    exact hC j hj
  have hDw : ∀ j, 1 ≤ j → j ≤ n → ‖iteratedFDerivWithin ℝ j Φ O 0‖ ≤ D ^ j := by
    intro j hj1 hjn
    rw [iteratedFDerivWithin_of_isOpen j hO h0O, hΦdef, key f U x0 Λ hU hfU hxU j hjn]
    have h1 : sJet5 f x0 Λ j ≤ D ^ j := hD j hj1 hjn
    unfold sJet5 at h1
    exact h1
  have hFdB := norm_iteratedFDerivWithin_comp_le hgV hΦ le_rfl
    hV.uniqueDiffOn hO.uniqueDiffOn hΦmaps h0O (C := C) (D := D) hCw hDw
  have hEq : (fun z => (g ∘ f) (x0 + Λ z)) = g ∘ Φ := by
    rw [hΦdef]; rfl
  have hJeq : sJet5 (g ∘ f) x0 Λ n =
      ‖iteratedFDeriv ℝ n (fun z => (g ∘ f) (x0 + Λ z)) 0‖ := by
    have := key (g ∘ f) U x0 Λ hU hgfU hxU n le_rfl
    unfold sJet5
    rw [← this]
  calc sJet5 (g ∘ f) x0 Λ n
      = ‖iteratedFDeriv ℝ n (g ∘ Φ) 0‖ := by rw [hJeq, hEq]
    _ = ‖iteratedFDerivWithin ℝ n (g ∘ Φ) O 0‖ := by
        rw [iteratedFDerivWithin_of_isOpen n hO h0O]
    _ ≤ (n.factorial : ℝ) * C * D ^ n := hFdB

theorem simscale_rpow_sjet : ∀ (h p : ℝ), SimScaleProps h → (∀ i : ℕ, ∃ C : ℝ, ∀ z τ : ℝ, 0 < τ → simScale h z τ ≤ 1 → ‖(iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale h w.1 w.2 ^ p) (z, τ)).compContinuousLinearMap (fun _ => (simScale h z τ ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap (simScale h z τ • ContinuousLinearMap.id ℝ ℝ))‖ ≤ C * simScale h z τ ^ p) → ∀ k : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ ξ : Cyl, ξ.2.2.1 < 1 → qC h ξ ≤ 1 → ContDiffAt ℝ ∞ (fun s : ℝ × ℝ × ℝ => simScale h s.2.1 (1 - s.2.2) ^ p) (ξ.1, ξ.2.1, ξ.2.2.1) ∧ ∀ i : ℕ, i ≤ k → sJet5 (fun s : ℝ × ℝ × ℝ => simScale h s.2.1 (1 - s.2.2) ^ p) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) i ≤ C * qC h ξ ^ p :=
by
  intro h p hS hC k
  choose Cf hCf using hC
  refine ⟨∑ j ∈ Finset.range (k + 1), |Cf j|, Finset.sum_nonneg (fun j _ => abs_nonneg _), ?_⟩
  intro ξ hξ hq1
  have hτ : 0 < 1 - ξ.2.2.1 := by linarith
  have hq0 : 0 < qC h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
  set G : ℝ × ℝ → ℝ := fun w => simScale h w.1 w.2 ^ p with hGdef
  have hU : IsOpen ((Set.univ : Set ℝ) ×ˢ Set.Ioi (0:ℝ)) := isOpen_univ.prod isOpen_Ioi
  have hG : ContDiffOn ℝ ∞ G ((Set.univ : Set ℝ) ×ˢ Set.Ioi (0:ℝ)) :=
    hS.2.2.2.1.rpow_const_of_ne (fun w hw => ((hS.1 w.1 w.2 hw.2).1).ne')
  set A : ℝ × ℝ × ℝ →L[ℝ] ℝ × ℝ :=
    ((ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))).prod
      (-((ContinuousLinearMap.snd ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)))) with hAdef
  have hAapp : ∀ s : ℝ × ℝ × ℝ, A s = (s.2.1, -s.2.2) := fun s => rfl
  have hFeq : (fun s : ℝ × ℝ × ℝ => simScale h s.2.1 (1 - s.2.2) ^ p) =
      fun s => G (((0:ℝ), (1:ℝ)) + A s) := by
    funext s
    rw [hAapp]
    show simScale h s.2.1 (1 - s.2.2) ^ p = simScale h (0 + s.2.1) (1 + -s.2.2) ^ p
    rw [zero_add, ← sub_eq_add_neg]
  have hw0 : ((0:ℝ), (1:ℝ)) + A (ξ.1, ξ.2.1, ξ.2.2.1) = (ξ.2.1, 1 - ξ.2.2.1) := by
    rw [hAapp]
    exact Prod.ext (show (0:ℝ) + ξ.2.1 = ξ.2.1 by ring)
      (show (1:ℝ) + -ξ.2.2.1 = 1 - ξ.2.2.1 by ring)
  have hw0mem : ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ) ∈ (Set.univ : Set ℝ) ×ˢ Set.Ioi (0:ℝ) :=
    ⟨Set.mem_univ _, hτ⟩
  have hGat : ContDiffAt ℝ ∞ G (((0:ℝ), (1:ℝ)) + A (ξ.1, ξ.2.1, ξ.2.2.1)) := by
    rw [hw0]; exact hG.contDiffAt (hU.mem_nhds hw0mem)
  have hsm : ContDiffAt ℝ ∞ (fun s => G (((0:ℝ), (1:ℝ)) + A s)) (ξ.1, ξ.2.1, ξ.2.2.1) :=
    hGat.comp (ξ.1, ξ.2.1, ξ.2.2.1) ((contDiff_const.add A.contDiff).contDiffAt)

  have key : ∀ (i : ℕ) (a : ℝ × ℝ) (x0 : ℝ × ℝ × ℝ) (V' : Set (ℝ × ℝ)), IsOpen V' →
      ContDiffOn ℝ i G V' → a + A x0 ∈ V' →
      iteratedFDeriv ℝ i (fun z => G (a + A z)) x0 =
        (iteratedFDeriv ℝ i G (a + A x0)).compContinuousLinearMap (fun _ => A) := by
    intro i a x0 V' hV' hF ha
    obtain ⟨s, hs_def⟩ : ∃ s : Set (ℝ × ℝ), s = (fun z => a + z) ⁻¹' V' := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV'.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑A ⁻¹' s) := hs.preimage A.continuous
    have hAs : A x0 ∈ s := by rw [hs_def]; exact ha
    have hxO : x0 ∈ ⇑A ⁻¹' s := hAs
    have hsm' : ContDiffOn ℝ i (fun z => G (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => G (a + A z)) i hO hxO
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right A hsm' hs.uniqueDiffOn
      hO.uniqueDiffOn hAs (i := i) le_rfl
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => G (a + z)) i hs hAs
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := G) i a (A x0)
    calc iteratedFDeriv ℝ i (fun z => G (a + A z)) x0
        = iteratedFDerivWithin ℝ i ((fun z => G (a + z)) ∘ ⇑A) (⇑A ⁻¹' s) x0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => G (a + z)) s (A x0)).compContinuousLinearMap
            (fun _ => A) := e2
      _ = (iteratedFDeriv ℝ i (fun z => G (a + z)) (A x0)).compContinuousLinearMap
            (fun _ => A) := by rw [e3]
      _ = (iteratedFDeriv ℝ i G (a + A x0)).compContinuousLinearMap (fun _ => A) := by rw [e4]

  have hpt : ∀ v : ℝ × ℝ × ℝ, A (DqS5 h ξ v) =
      ((simScale h ξ.2.1 (1 - ξ.2.2.1) ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap
        (simScale h ξ.2.1 (1 - ξ.2.2.1) • ContinuousLinearMap.id ℝ ℝ)) (A v) := by
    intro v
    obtain ⟨v1, v2, v3⟩ := v
    simp only [hAapp, DqS5, ContinuousLinearMap.coe_prodMap', Prod.map_apply,
      ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, smul_eq_mul, qC]
    exact Prod.ext rfl (by ring)
  have hAn : ‖A‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound A zero_le_one (fun s => ?_)
    rw [hAapp, one_mul, Prod.norm_def]
    refine max_le ?_ ?_
    · exact (norm_fst_le s.2).trans (norm_snd_le s)
    · show ‖-s.2.2‖ ≤ ‖s‖
      rw [norm_neg]; exact (norm_snd_le s.2).trans (norm_snd_le s)
  rw [hFeq]
  refine ⟨hsm, ?_⟩
  intro i hi
  unfold sJet5
  rw [key i ((0:ℝ), (1:ℝ)) (ξ.1, ξ.2.1, ξ.2.2.1) _ hU (hG.of_le (by exact_mod_cast le_top))
    (by rw [hw0]; exact hw0mem), hw0]
  have hfac : ∀ M : ContinuousMultilinearMap ℝ (fun _ : Fin i => ℝ × ℝ) ℝ,
      (M.compContinuousLinearMap (fun _ => A)).compContinuousLinearMap (fun _ => DqS5 h ξ) =
        (M.compContinuousLinearMap (fun _ =>
          (simScale h ξ.2.1 (1 - ξ.2.2.1) ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap
            (simScale h ξ.2.1 (1 - ξ.2.2.1) • ContinuousLinearMap.id ℝ ℝ))).compContinuousLinearMap
          (fun _ => A) := by
    intro M
    ext m
    simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    congr 1
    funext j
    exact hpt (m j)
  have hnorm : ∀ N : ContinuousMultilinearMap ℝ (fun _ : Fin i => ℝ × ℝ) ℝ,
      ‖N.compContinuousLinearMap (fun _ => A)‖ ≤ ‖N‖ := by
    intro N
    calc ‖N.compContinuousLinearMap (fun _ => A)‖ ≤ ‖N‖ * ∏ _j : Fin i, ‖A‖ :=
          ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
      _ = ‖N‖ * ‖A‖ ^ i := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      _ ≤ ‖N‖ * 1 := mul_le_mul_of_nonneg_left (pow_le_one₀ (norm_nonneg _) hAn) (norm_nonneg _)
      _ = ‖N‖ := mul_one _
  have hqp : 0 ≤ qC h ξ ^ p := Real.rpow_nonneg hq0.le p
  rw [hfac]
  refine (hnorm _).trans ?_
  refine (hCf i ξ.2.1 (1 - ξ.2.2.1) hτ hq1).trans ?_
  calc Cf i * simScale h ξ.2.1 (1 - ξ.2.2.1) ^ p ≤ |Cf i| * qC h ξ ^ p :=
        mul_le_mul_of_nonneg_right (le_abs_self _) hqp
    _ ≤ (∑ j ∈ Finset.range (k + 1), |Cf j|) * qC h ξ ^ p :=
        mul_le_mul_of_nonneg_right
          (Finset.single_le_sum (fun j _ => abs_nonneg (Cf j))
            (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))) hqp

theorem xc_etac_sjet : ∀ (h : ℝ), SimScaleProps h → (∀ (p : ℝ) (k : ℕ), ∃ C : ℝ, 0 ≤ C ∧ ∀ ξ : Cyl, ξ.2.2.1 < 1 → qC h ξ ≤ 1 → ContDiffAt ℝ ∞ (fun s : ℝ × ℝ × ℝ => simScale h s.2.1 (1 - s.2.2) ^ p) (ξ.1, ξ.2.1, ξ.2.2.1) ∧ ∀ i : ℕ, i ≤ k → sJet5 (fun s : ℝ × ℝ × ℝ => simScale h s.2.1 (1 - s.2.2) ^ p) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) i ≤ C * qC h ξ ^ p) → ∀ (Xb : ℝ) (k : ℕ), ∃ D : ℝ, 1 ≤ D ∧ ∀ ξ : Cyl, 0 < ξ.1 → ξ.2.2.1 < 1 → qC h ξ ≤ 1 → XC h ξ < Xb → ContDiffAt ℝ ∞ (fun s : ℝ × ℝ × ℝ => (s.1 ^ 2 / (2 * simScale h s.2.1 (1 - s.2.2)), s.2.1 * simScale h s.2.1 (1 - s.2.2) ^ (-(1/2 - h)))) (ξ.1, ξ.2.1, ξ.2.2.1) ∧ ∀ i : ℕ, 1 ≤ i → i ≤ k → sJet5 (fun s : ℝ × ℝ × ℝ => (s.1 ^ 2 / (2 * simScale h s.2.1 (1 - s.2.2)), s.2.1 * simScale h s.2.1 (1 - s.2.2) ^ (-(1/2 - h)))) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) i ≤ D ^ i :=
by
  intro h hS H2 Xb k

  have key : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : ℝ × ℝ × ℝ → V)
      (a : ℝ × ℝ × ℝ) (T : (ℝ × ℝ × ℝ) →L[ℝ] (ℝ × ℝ × ℝ)), ContDiff ℝ ∞ F → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro V _ _ F a T hF i
    have hF' : ContDiff ℝ ∞ (fun z => F (a + z)) := hF.comp (contDiff_const.add contDiff_id)
    have e2 := ContinuousLinearMap.iteratedFDeriv_comp_right T hF' (0 : ℝ × ℝ × ℝ) (i := i)
      (by exact_mod_cast le_top)
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDeriv ℝ i ((fun z => F (a + z)) ∘ ⇑T) 0 := rfl
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]
  have hf0 : ContDiff ℝ ∞ (fun s : ℝ × ℝ × ℝ => s.1 ^ 2 / 2) := (contDiff_fst.pow 2).div_const 2
  have hf2 : ContDiff ℝ ∞ (fun s : ℝ × ℝ × ℝ => s.2.1) := contDiff_snd.fst

  have hfsq : ∀ ξ : Cyl, 0 < qC h ξ → ∀ a : ℕ,
      sJet5 (fun s : ℝ × ℝ × ℝ => s.1 ^ 2 / 2) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) a ≤
        ξ.1 ^ 2 + qC h ξ := by
    intro ξ hq a
    obtain ⟨q, hqd⟩ : ∃ q : ℝ, q = qC h ξ := ⟨_, rfl⟩
    obtain ⟨s, hsd⟩ : ∃ s : ℝ, s = Real.sqrt q := ⟨_, rfl⟩
    have hq' : 0 < q := by rw [hqd]; exact hq
    have hs2 : s ^ 2 = q := by rw [hsd]; exact Real.sq_sqrt hq'.le
    obtain ⟨p, hpdef⟩ : ∃ p : ℝ → ℝ, p = fun x => ξ.1 ^ 2 / 2 + ξ.1 * s * x + q / 2 * (x * x) :=
      ⟨_, rfl⟩
    have hp : ContDiff ℝ ∞ p := by
      rw [hpdef]
      exact (contDiff_const.add (contDiff_const.mul contDiff_id)).add
        (contDiff_const.mul (contDiff_id.mul contDiff_id))
    have hcomp : (fun v : ℝ × ℝ × ℝ => ((ξ.1, ξ.2.1, ξ.2.2.1) + DqS5 h ξ v).1 ^ 2 / 2) =
        p ∘ ⇑(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)) := by
      funext v
      have e1 : (DqS5 h ξ v).1 = s * v.1 := by
        rw [hsd, hqd]; simp [DqS5, ContinuousLinearMap.coe_prodMap']
      rw [hpdef]
      simp only [Function.comp_apply, ContinuousLinearMap.coe_fst', Prod.fst_add, e1]
      linear_combination (v.1 ^ 2 / 2) * hs2
    have e : iteratedFDeriv ℝ a (p ∘ ⇑(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ))) 0 =
        (iteratedFDeriv ℝ a (fun s : ℝ × ℝ × ℝ => s.1 ^ 2 / 2) (ξ.1, ξ.2.1, ξ.2.2.1)).compContinuousLinearMap
          (fun _ => DqS5 h ξ) := by
      rw [← hcomp]
      exact key (fun s : ℝ × ℝ × ℝ => s.1 ^ 2 / 2) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) hf0 a
    unfold sJet5
    rw [← e, ContinuousLinearMap.iteratedFDeriv_comp_right
      (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)) hp (0 : ℝ × ℝ × ℝ) (i := a)
      (by exact_mod_cast le_top), map_zero]
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    have hprod : ∏ _i : Fin a, ‖ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)‖ ≤ 1 := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_fst_le _ _ _)
    refine (mul_le_of_le_one_right (norm_nonneg _) hprod).trans ?_
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, ← hqd]
    have hd1 : deriv p = fun x => ξ.1 * s + q * x := by
      funext x
      rw [hpdef]
      have h := (((hasDerivAt_id' x).const_mul (ξ.1 * s)).const_add (ξ.1 ^ 2 / 2)).add
        (((hasDerivAt_id' x).mul (hasDerivAt_id' x)).const_mul (q / 2))
      have h' : HasDerivAt (fun x => ξ.1 ^ 2 / 2 + ξ.1 * s * x + q / 2 * (x * x))
          (ξ.1 * s + q * x) x := by
        convert h using 1; ring
      exact h'.deriv
    have hd2 : deriv (fun x : ℝ => ξ.1 * s + q * x) = fun _ => q := by
      funext x
      have h := ((hasDerivAt_id' x).const_mul q).const_add (ξ.1 * s)
      have h' : HasDerivAt (fun x : ℝ => ξ.1 * s + q * x) q x := by
        convert h using 1; ring
      exact h'.deriv
    have hd3 : deriv (fun _ : ℝ => q) = fun _ => (0:ℝ) := by
      funext x; exact deriv_const x q
    rcases a with _ | _ | _ | n
    · rw [iteratedDeriv_zero, hpdef]
      show |ξ.1 ^ 2 / 2 + ξ.1 * s * 0 + q / 2 * (0 * 0)| ≤ ξ.1 ^ 2 + q
      rw [abs_le]; constructor <;> nlinarith [sq_nonneg ξ.1]
    · rw [iteratedDeriv_succ', iteratedDeriv_zero, hd1]
      show |ξ.1 * s + q * 0| ≤ ξ.1 ^ 2 + q
      rw [abs_le]; constructor <;> nlinarith [sq_nonneg (ξ.1 - s), sq_nonneg (ξ.1 + s), sq_nonneg ξ.1]
    · rw [iteratedDeriv_succ', iteratedDeriv_succ', iteratedDeriv_zero, hd1, hd2]
      show |q| ≤ ξ.1 ^ 2 + q
      rw [abs_of_pos hq']; nlinarith [sq_nonneg ξ.1]
    · rw [iteratedDeriv_succ', iteratedDeriv_succ', iteratedDeriv_succ', hd1, hd2, hd3,
        iteratedDeriv_const]
      simp only [ite_self, abs_zero]
      exact add_nonneg (sq_nonneg _) hq'.le

  have hsnd : ∀ ξ : Cyl, 0 < qC h ξ → ∀ a : ℕ,
      sJet5 (fun s : ℝ × ℝ × ℝ => s.2.1) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) a ≤
        |ξ.2.1| + qC h ξ ^ (1/2 - h) := by
    intro ξ hq a
    have hc0 : 0 ≤ qC h ξ ^ (1/2 - h) := Real.rpow_nonneg hq.le _
    obtain ⟨p2, hp2def⟩ : ∃ p2 : ℝ → ℝ, p2 = fun x => ξ.2.1 + qC h ξ ^ (1/2 - h) * x := ⟨_, rfl⟩
    have hp2 : ContDiff ℝ ∞ p2 := by
      rw [hp2def]
      exact contDiff_const.add (contDiff_const.mul contDiff_id)
    have hcomp2 : (fun v : ℝ × ℝ × ℝ => ((ξ.1, ξ.2.1, ξ.2.2.1) + DqS5 h ξ v).2.1) =
        p2 ∘ ⇑((ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))) := by
      funext v
      have e1 : (DqS5 h ξ v).2.1 = qC h ξ ^ (1/2 - h) * v.2.1 := by
        simp [DqS5, ContinuousLinearMap.coe_prodMap']
      simp only [Function.comp_apply, ContinuousLinearMap.coe_comp', ContinuousLinearMap.coe_fst',
        ContinuousLinearMap.coe_snd', Prod.snd_add, Prod.fst_add, e1, hp2def]
    have e : iteratedFDeriv ℝ a
        (p2 ∘ ⇑((ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)))) 0 =
        (iteratedFDeriv ℝ a (fun s : ℝ × ℝ × ℝ => s.2.1) (ξ.1, ξ.2.1, ξ.2.2.1)).compContinuousLinearMap
          (fun _ => DqS5 h ξ) := by
      rw [← hcomp2]
      exact key (fun s : ℝ × ℝ × ℝ => s.2.1) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) hf2 a
    unfold sJet5
    rw [← e, ContinuousLinearMap.iteratedFDeriv_comp_right
      ((ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))) hp2
      (0 : ℝ × ℝ × ℝ) (i := a) (by exact_mod_cast le_top), map_zero]
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    have hπ1 : ‖(ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))‖ ≤ 1 := by
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun v => ?_)
      rw [one_mul]
      simp only [ContinuousLinearMap.coe_comp', Function.comp_apply, ContinuousLinearMap.coe_fst',
        ContinuousLinearMap.coe_snd']
      exact (norm_fst_le v.2).trans (norm_snd_le v)
    have hprod : ∏ _i : Fin a,
        ‖(ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))‖ ≤ 1 := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_one₀ (norm_nonneg _) hπ1
    refine (mul_le_of_le_one_right (norm_nonneg _) hprod).trans ?_
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs]
    have hd1 : deriv p2 = fun _ => qC h ξ ^ (1/2 - h) := by
      funext x
      rw [hp2def]
      have h1 := ((hasDerivAt_id' x).const_mul (qC h ξ ^ (1/2 - h))).const_add ξ.2.1
      have h' : HasDerivAt (fun x : ℝ => ξ.2.1 + qC h ξ ^ (1/2 - h) * x) (qC h ξ ^ (1/2 - h)) x := by
        convert h1 using 1; ring
      exact h'.deriv
    have hd2 : deriv (fun _ : ℝ => qC h ξ ^ (1/2 - h)) = fun _ => (0:ℝ) := by
      funext x; exact deriv_const x _
    rcases a with _ | _ | n
    · rw [iteratedDeriv_zero, hp2def]
      show |ξ.2.1 + qC h ξ ^ (1/2 - h) * 0| ≤ |ξ.2.1| + qC h ξ ^ (1/2 - h)
      rw [mul_zero, add_zero]; linarith [hc0]
    · rw [iteratedDeriv_succ', iteratedDeriv_zero, hd1]
      show |qC h ξ ^ (1/2 - h)| ≤ |ξ.2.1| + qC h ξ ^ (1/2 - h)
      rw [abs_of_nonneg hc0]; linarith [abs_nonneg ξ.2.1]
    · rw [iteratedDeriv_succ', iteratedDeriv_succ', hd1, hd2, iteratedDeriv_const]
      simp only [ite_self, abs_zero]
      exact add_nonneg (abs_nonneg _) hc0

  have hpair : ∀ (f g : ℝ × ℝ × ℝ → ℝ) (x0 : ℝ × ℝ × ℝ) (Λ : (ℝ × ℝ × ℝ) →L[ℝ] (ℝ × ℝ × ℝ))
      (i : ℕ), ContDiffAt ℝ ∞ f x0 → ContDiffAt ℝ ∞ g x0 →
      sJet5 (fun x => (f x, g x)) x0 Λ i = max (sJet5 f x0 Λ i) (sJet5 g x0 Λ i) := by
    intro f g x0 Λ i hf hg
    unfold sJet5
    rw [iteratedFDeriv_prodMk hf hg (by exact_mod_cast le_top)]
    have e : ((iteratedFDeriv ℝ i f x0).prod (iteratedFDeriv ℝ i g x0)).compContinuousLinearMap
        (fun _ => Λ) =
        ((iteratedFDeriv ℝ i f x0).compContinuousLinearMap (fun _ => Λ)).prod
          ((iteratedFDeriv ℝ i g x0).compContinuousLinearMap (fun _ => Λ)) := by
      ext m <;> rfl
    rw [e, ContinuousMultilinearMap.opNorm_prod]

  have hmul : ∀ (f g : ℝ × ℝ × ℝ → ℝ) (x0 : ℝ × ℝ × ℝ) (Λ : (ℝ × ℝ × ℝ) →L[ℝ] (ℝ × ℝ × ℝ))
      (i : ℕ) (P Q : ℝ), ContDiffAt ℝ ∞ f x0 → ContDiffAt ℝ ∞ g x0 →
      (∀ t : ℕ, t ≤ i → sJet5 f x0 Λ t ≤ P) → (∀ t : ℕ, t ≤ i → sJet5 g x0 Λ t ≤ Q) →
      sJet5 (fun x => f x * g x) x0 Λ i ≤ 2 ^ i * P * Q := by
    intro f g x0 Λ i P Q hf hg hP hQ
    have hsJ0 : ∀ (F : ℝ × ℝ × ℝ → ℝ) (t : ℕ), 0 ≤ sJet5 F x0 Λ t := by
      intro F t; unfold sJet5; exact norm_nonneg _
    have hP0 : 0 ≤ P := le_trans (hsJ0 f 0) (hP 0 (Nat.zero_le _))

    have hfn : ContDiffAt ℝ i f x0 := hf.of_le (by exact_mod_cast le_top)
    have hgn : ContDiffAt ℝ i g x0 := hg.of_le (by exact_mod_cast le_top)
    obtain ⟨u1, hu1, hfu1⟩ := hfn.contDiffOn le_rfl (by simp)
    obtain ⟨u2, hu2, hgu2⟩ := hgn.contDiffOn le_rfl (by simp)
    obtain ⟨U, hUsub, hU, hxU⟩ := mem_nhds_iff.mp (Filter.inter_mem hu1 hu2)
    have hfU : ContDiffOn ℝ i f U := hfu1.mono (fun y hy => (hUsub hy).1)
    have hgU : ContDiffOn ℝ i g U := hgu2.mono (fun y hy => (hUsub hy).2)
    have hfgU : ContDiffOn ℝ i (fun x => f x * g x) U := hfU.mul hgU

    have keyW : ∀ (F' : ℝ × ℝ × ℝ → ℝ), ContDiffOn ℝ i F' U → ∀ j : ℕ, j ≤ i →
        iteratedFDeriv ℝ j (fun z => F' (x0 + Λ z)) 0 =
          (iteratedFDeriv ℝ j F' x0).compContinuousLinearMap (fun _ => Λ) := by
      intro F' hF j hj
      obtain ⟨s, hs_def⟩ : ∃ s : Set (ℝ × ℝ × ℝ), s = (fun z : ℝ × ℝ × ℝ => x0 + z) ⁻¹' U :=
        ⟨_, rfl⟩
      have hs : IsOpen s := by
        rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
      have hO : IsOpen (⇑Λ ⁻¹' s) := hs.preimage Λ.continuous
      have h0s : (0 : ℝ × ℝ × ℝ) ∈ s := by
        rw [hs_def]; show x0 + 0 ∈ U; rw [add_zero]; exact hxU
      have hT0s : Λ 0 ∈ s := by rw [map_zero]; exact h0s
      have h0O : (0 : ℝ × ℝ × ℝ) ∈ ⇑Λ ⁻¹' s := hT0s
      have hsm : ContDiffOn ℝ i (fun z => F' (x0 + z)) s :=
        hF.comp (contDiff_const.add contDiff_id).contDiffOn
          (fun z hz => by rw [hs_def] at hz; exact hz)
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F' (x0 + Λ z)) j hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right Λ hsm hs.uniqueDiffOn
        hO.uniqueDiffOn hT0s (i := j) (by exact_mod_cast hj)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F' (x0 + z)) j hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F') j x0 0
      calc iteratedFDeriv ℝ j (fun z => F' (x0 + Λ z)) 0
          = iteratedFDerivWithin ℝ j ((fun z => F' (x0 + z)) ∘ ⇑Λ) (⇑Λ ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ j (fun z => F' (x0 + z)) s (Λ 0)).compContinuousLinearMap
              (fun _ => Λ) := e2
        _ = (iteratedFDerivWithin ℝ j (fun z => F' (x0 + z)) s 0).compContinuousLinearMap
              (fun _ => Λ) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ j (fun z => F' (x0 + z)) 0).compContinuousLinearMap
              (fun _ => Λ) := by rw [e3]
        _ = (iteratedFDeriv ℝ j F' x0).compContinuousLinearMap (fun _ => Λ) := by rw [e4, add_zero]

    obtain ⟨O, hOdef⟩ : ∃ O : Set (ℝ × ℝ × ℝ), O = (fun z => x0 + Λ z) ⁻¹' U := ⟨_, rfl⟩
    have hO : IsOpen O := by
      rw [hOdef]; exact hU.preimage (continuous_const.add Λ.continuous)
    have h0O : (0 : ℝ × ℝ × ℝ) ∈ O := by
      rw [hOdef]; show x0 + Λ 0 ∈ U; rw [map_zero, add_zero]; exact hxU
    have hsmO : ∀ F' : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ i F' U →
        ContDiffOn ℝ i (fun z => F' (x0 + Λ z)) O := by
      intro F' hF
      exact hF.comp (contDiff_const.add Λ.contDiff).contDiffOn
        (fun z hz => by rw [hOdef] at hz; exact hz)
    have leib := norm_iteratedFDerivWithin_mul_le (hsmO f hfU) (hsmO g hgU) hO.uniqueDiffOn h0O
      (n := i) le_rfl
    rw [iteratedFDerivWithin_of_isOpen
      (f := fun y => f (x0 + Λ y) * g (x0 + Λ y)) i hO h0O] at leib
    have hJ : sJet5 (fun x => f x * g x) x0 Λ i =
        ‖iteratedFDeriv ℝ i (fun y => f (x0 + Λ y) * g (x0 + Λ y)) 0‖ := by
      unfold sJet5
      rw [← keyW _ hfgU i le_rfl]
    have hsum_eq : ∑ t ∈ Finset.range (i + 1), (i.choose t : ℝ) *
        ‖iteratedFDerivWithin ℝ t (fun z => f (x0 + Λ z)) O 0‖ *
        ‖iteratedFDerivWithin ℝ (i - t) (fun z => g (x0 + Λ z)) O 0‖ =
        ∑ t ∈ Finset.range (i + 1), (i.choose t : ℝ) * sJet5 f x0 Λ t * sJet5 g x0 Λ (i - t) := by
      apply Finset.sum_congr rfl
      intro t ht
      have ht' : t ≤ i := Nat.lt_succ_iff.mp (Finset.mem_range.mp ht)
      rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (x0 + Λ z)) t hO h0O,
        iteratedFDerivWithin_of_isOpen (f := fun z => g (x0 + Λ z)) (i - t) hO h0O,
        keyW f hfU t ht', keyW g hgU (i - t) (Nat.sub_le i t)]
      rfl
    have hsum : ∑ t ∈ Finset.range (i + 1), (i.choose t : ℝ) * sJet5 f x0 Λ t * sJet5 g x0 Λ (i - t) ≤
        2 ^ i * P * Q := by
      calc ∑ t ∈ Finset.range (i + 1), (i.choose t : ℝ) * sJet5 f x0 Λ t * sJet5 g x0 Λ (i - t)
          ≤ ∑ t ∈ Finset.range (i + 1), (i.choose t : ℝ) * P * Q := by
            apply Finset.sum_le_sum
            intro t ht
            have ht' : t ≤ i := Nat.lt_succ_iff.mp (Finset.mem_range.mp ht)
            have hc : (0:ℝ) ≤ i.choose t := Nat.cast_nonneg _
            exact mul_le_mul (mul_le_mul_of_nonneg_left (hP t ht') hc) (hQ (i - t) (Nat.sub_le i t))
              (hsJ0 g _) (mul_nonneg hc hP0)
        _ = (∑ t ∈ Finset.range (i + 1), (i.choose t : ℝ)) * P * Q := by
            rw [Finset.sum_mul, Finset.sum_mul]
        _ = 2 ^ i * P * Q := by
            congr 2
            exact_mod_cast Nat.sum_range_choose i
    rw [hJ]
    exact (leib.trans (le_of_eq hsum_eq)).trans hsum

  obtain ⟨C₁, hC₁0, hC₁⟩ := H2 (-1) k
  obtain ⟨C₂, hC₂0, hC₂⟩ := H2 (-(1/2 - h)) k
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = 2 * |Xb| + 1 := ⟨_, rfl⟩
  have hM0 : 0 < M := by rw [hMdef]; positivity
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = 1 + 2 ^ k * M * C₁ + 2 ^ k * (2 * C₂) := ⟨_, rfl⟩
  have h2k : (0:ℝ) ≤ 2 ^ k := by positivity
  have hA0 : 0 ≤ 2 ^ k * M * C₁ := mul_nonneg (mul_nonneg h2k hM0.le) hC₁0
  have hB0 : 0 ≤ 2 ^ k * (2 * C₂) := mul_nonneg h2k (by linarith)
  have hD1 : 1 ≤ D := by rw [hDdef]; linarith
  refine ⟨D, hD1, ?_⟩
  intro ξ _hξ0 hξ1 hq1 hX
  have hτ : 0 < 1 - ξ.2.2.1 := by linarith
  have hq : 0 < qC h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
  have hcpos : 0 < qC h ξ ^ (1/2 - h) := Real.rpow_pos_of_pos hq _
  have hb : |ξ.2.1| < qC h ξ ^ (1/2 - h) := by
    have hz := (hS.2.1 ξ.2.1 (1 - ξ.2.2.1) hτ).2
    have hp2 : (qC h ξ ^ (1/2 - h)) ^ 2 = qC h ξ ^ (1 - 2 * h) := by
      rw [sq, ← Real.rpow_add hq]; congr 1; ring
    have hz' : ξ.2.1 ^ 2 < (qC h ξ ^ (1/2 - h)) ^ 2 := by rw [hp2]; exact hz
    exact abs_lt_of_sq_lt_sq hz' hcpos.le
  have hα : ξ.1 ^ 2 + qC h ξ ≤ M * qC h ξ := by
    have h' : ξ.1 ^ 2 / (2 * qC h ξ) < Xb := hX
    rw [div_lt_iff₀ (by linarith)] at h'
    have h3 : Xb * (2 * qC h ξ) ≤ |Xb| * (2 * qC h ξ) :=
      mul_le_mul_of_nonneg_right (le_abs_self Xb) (by linarith)
    rw [hMdef]; linarith
  obtain ⟨hg1s, hg1b⟩ := hC₁ ξ hξ1 hq1
  obtain ⟨hg2s, hg2b⟩ := hC₂ ξ hξ1 hq1
  have hfun : (fun s : ℝ × ℝ × ℝ => (s.1 ^ 2 / (2 * simScale h s.2.1 (1 - s.2.2)), s.2.1 * simScale h s.2.1 (1 - s.2.2) ^ (-(1/2 - h)))) =
      fun s : ℝ × ℝ × ℝ => (s.1 ^ 2 / 2 * simScale h s.2.1 (1 - s.2.2) ^ (-1:ℝ),
        s.2.1 * simScale h s.2.1 (1 - s.2.2) ^ (-(1/2 - h))) := by
    funext s
    refine Prod.ext ?_ rfl
    show s.1 ^ 2 / (2 * simScale h s.2.1 (1 - s.2.2)) =
      s.1 ^ 2 / 2 * simScale h s.2.1 (1 - s.2.2) ^ (-1:ℝ)
    rw [Real.rpow_neg_one]
    ring
  have hXs : ContDiffAt ℝ ∞ (fun s : ℝ × ℝ × ℝ => s.1 ^ 2 / 2 * simScale h s.2.1 (1 - s.2.2) ^ (-1:ℝ))
      (ξ.1, ξ.2.1, ξ.2.2.1) := hf0.contDiffAt.mul hg1s
  have hEs : ContDiffAt ℝ ∞ (fun s : ℝ × ℝ × ℝ => s.2.1 * simScale h s.2.1 (1 - s.2.2) ^ (-(1/2 - h)))
      (ξ.1, ξ.2.1, ξ.2.2.1) := hf2.contDiffAt.mul hg2s
  rw [hfun]
  refine ⟨hXs.prodMk hEs, ?_⟩
  intro i hi1 hik
  have h2i : (2:ℝ) ^ i ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hik
  have hXb : sJet5 (fun s : ℝ × ℝ × ℝ => s.1 ^ 2 / 2 * simScale h s.2.1 (1 - s.2.2) ^ (-1:ℝ))
      (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) i ≤ 2 ^ k * M * C₁ := by
    have h1 := hmul (fun s : ℝ × ℝ × ℝ => s.1 ^ 2 / 2)
      (fun s : ℝ × ℝ × ℝ => simScale h s.2.1 (1 - s.2.2) ^ (-1:ℝ))
      (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) i (M * qC h ξ) (C₁ * (qC h ξ)⁻¹) hf0.contDiffAt hg1s
      (fun t _ => (hfsq ξ hq t).trans hα)
      (fun t ht => (hg1b t (le_trans ht hik)).trans (le_of_eq (by rw [Real.rpow_neg_one])))
    have e : 2 ^ i * (M * qC h ξ) * (C₁ * (qC h ξ)⁻¹) = 2 ^ i * M * C₁ := by
      rw [show 2 ^ i * (M * qC h ξ) * (C₁ * (qC h ξ)⁻¹) = 2 ^ i * M * C₁ * (qC h ξ * (qC h ξ)⁻¹) by ring,
        mul_inv_cancel₀ hq.ne', mul_one]
    rw [e] at h1
    exact h1.trans (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right h2i hM0.le) hC₁0)
  have hEb : sJet5 (fun s : ℝ × ℝ × ℝ => s.2.1 * simScale h s.2.1 (1 - s.2.2) ^ (-(1/2 - h)))
      (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) i ≤ 2 ^ k * (2 * C₂) := by
    have h1 := hmul (fun s : ℝ × ℝ × ℝ => s.2.1)
      (fun s : ℝ × ℝ × ℝ => simScale h s.2.1 (1 - s.2.2) ^ (-(1/2 - h)))
      (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) i (2 * qC h ξ ^ (1/2 - h)) (C₂ * qC h ξ ^ (-(1/2 - h)))
      hf2.contDiffAt hg2s
      (fun t _ => (hsnd ξ hq t).trans (by linarith [hb]))
      (fun t ht => hg2b t (le_trans ht hik))
    have e : 2 ^ i * (2 * qC h ξ ^ (1/2 - h)) * (C₂ * qC h ξ ^ (-(1/2 - h))) = 2 ^ i * (2 * C₂) := by
      rw [Real.rpow_neg hq.le,
        show 2 ^ i * (2 * qC h ξ ^ (1/2 - h)) * (C₂ * (qC h ξ ^ (1/2 - h))⁻¹) =
          2 ^ i * (2 * C₂) * (qC h ξ ^ (1/2 - h) * (qC h ξ ^ (1/2 - h))⁻¹) by ring,
        mul_inv_cancel₀ hcpos.ne', mul_one]
    rw [e] at h1
    exact h1.trans (mul_le_mul_of_nonneg_right h2i (by linarith))
  rw [hpair _ _ _ _ i hXs hEs]
  have hmax : max (sJet5 (fun s : ℝ × ℝ × ℝ => s.1 ^ 2 / 2 * simScale h s.2.1 (1 - s.2.2) ^ (-1:ℝ))
      (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) i)
      (sJet5 (fun s : ℝ × ℝ × ℝ => s.2.1 * simScale h s.2.1 (1 - s.2.2) ^ (-(1/2 - h)))
      (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 h ξ) i) ≤ D := by
    rw [hDdef]
    exact max_le (by linarith) (by linarith)
  exact hmax.trans (le_self_pow₀ hD1 (by omega))

theorem t0pair_outer_bound : ∀ (B : BG), B.ok → ∀ k : ℕ, ∃ C N : ℝ, 0 ≤ C ∧ 0 ≤ N ∧ ∀ X η : ℝ, B.Xa < X → X < B.Xb → -1 < η → η < 1 → ContDiffAt ℝ ∞ (fun p : ℝ × ℝ => (B.T0th p.1 p.2, B.T0z p.1 p.2)) (X, η) ∧ ∀ i : ℕ, i ≤ k → ‖iteratedFDeriv ℝ i (fun p : ℝ × ℝ => (B.T0th p.1 p.2, B.T0z p.1 p.2)) (X, η)‖ ≤ C * edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-N) :=
by
  intro B hok k
  obtain ⟨⟨-, -, hXa, -, -, -, -, -, -, -, -, -, -⟩, -, ⟨hT0s, hT0zs, -, -, hT0b, -, -⟩, -, -, -, -, -,
    -, -, -, -⟩ := hok.2
  have hV0o : IsOpen (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  choose Cf Nf hCN using hT0b
  refine ⟨∑ m ∈ Finset.range (k + 1), |Cf m|, ∑ m ∈ Finset.range (k + 1), |Nf m|,
    Finset.sum_nonneg (fun m _ => abs_nonneg (Cf m)),
    Finset.sum_nonneg (fun m _ => abs_nonneg (Nf m)), ?_⟩
  intro X η h1 h2 h3 h4
  set C := ∑ m ∈ Finset.range (k + 1), |Cf m| with hCdef
  set N := ∑ m ∈ Finset.range (k + 1), |Nf m| with hNdef
  have hX0 : 0 < X := lt_trans hXa h1
  have hmem : ((X, η) : ℝ × ℝ) ∈ Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1 := ⟨hX0, h3, h4⟩
  have hnhds := hV0o.mem_nhds hmem
  have hth : ContDiffAt ℝ ∞ (↿B.T0th) (X, η) := hT0s.contDiffAt hnhds
  have hz : ContDiffAt ℝ ∞ (↿B.T0z) (X, η) := hT0zs.contDiffAt hnhds
  have hpair : ContDiffAt ℝ ∞ (fun p : ℝ × ℝ => ((↿B.T0th) p, (↿B.T0z) p)) (X, η) := hth.prodMk hz
  have hd0 : 0 < edgeDist B.Xa B.Xb X := by
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr h1))
      (Real.log_pos ((one_lt_div hX0).mpr h2)))
  have hd1 : edgeDist B.Xa B.Xb X ≤ 1 := by
    unfold edgeDist
    exact min_le_left _ _
  have hE : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X := by
    unfold edgeWeight
    split_ifs
    · positivity
    · exact le_rfl
  refine ⟨hpair, ?_⟩
  intro i hi
  have himem : i ∈ Finset.range (k + 1) := Finset.mem_range.mpr (Nat.lt_succ_of_le hi)
  have hCi : |Cf i| ≤ C :=
    Finset.single_le_sum (f := fun m => |Cf m|) (fun m _ => abs_nonneg (Cf m)) himem
  have hNi : |Nf i| ≤ N :=
    Finset.single_le_sum (f := fun m => |Nf m|) (fun m _ => abs_nonneg (Nf m)) himem
  have hC0 : 0 ≤ C := le_trans (abs_nonneg _) hCi
  have hdN : edgeDist B.Xa B.Xb X ^ (-Nf i) ≤ edgeDist B.Xa B.Xb X ^ (-N) :=
    Real.rpow_le_rpow_of_exponent_ge hd0 hd1 (neg_le_neg (le_trans (le_abs_self _) hNi))
  have hdi : 0 ≤ edgeDist B.Xa B.Xb X ^ (-Nf i) := Real.rpow_nonneg hd0.le _
  have key : Cf i * edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-Nf i) ≤
      C * edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-N) := by
    calc Cf i * edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-Nf i)
        ≤ C * edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-Nf i) :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right (le_trans (le_abs_self _) hCi) hE) hdi
      _ ≤ C * edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-N) :=
          mul_le_mul_of_nonneg_left hdN (mul_nonneg hC0 hE)
  obtain ⟨b1, b2⟩ := hCN i X η h1 h2 h3 h4
  have e : (fun p : ℝ × ℝ => (B.T0th p.1 p.2, B.T0z p.1 p.2)) =
      (fun p : ℝ × ℝ => ((↿B.T0th) p, (↿B.T0z) p)) := rfl
  rw [e, iteratedFDeriv_prodMk hth hz (by exact_mod_cast le_top),
    ContinuousMultilinearMap.opNorm_prod]
  exact max_le (b1.trans key) (b2.trans key)

theorem simscale_normalized_v4 : ∀ h : ℝ, 0 < h → h < 1/100 → SimScaleProps h → SimNorm h :=
by
  intro h _ _ hS
  obtain ⟨hS1, -, -, -, hS5⟩ := hS

  open Pointwise in
  have hom : ∀ μ z τ : ℝ, 0 < μ →
      simScale h (μ ^ (1/2 - h) * z) (μ * τ) = μ * simScale h z τ := by
    intro μ z τ hμ
    have key : ∀ p : ℝ, 0 < p → μ * p - (μ ^ (1/2 - h) * z) ^ 2 * (μ * p) ^ (2 * h) =
        μ * (p - z ^ 2 * p ^ (2 * h)) := by
      intro p hp
      have sq : (μ ^ (1/2 - h)) ^ 2 = μ ^ (1 - 2 * h) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul hμ.le]
        congr 1
        push_cast
        ring
      have split : μ ^ (1 - 2 * h) * μ ^ (2 * h) = μ := by
        rw [← Real.rpow_add hμ]
        have e : 1 - 2 * h + 2 * h = 1 := by ring
        rw [e, Real.rpow_one]
      rw [mul_pow, sq, Real.mul_rpow hμ.le hp.le]
      linear_combination (-(z ^ 2 * p ^ (2 * h))) * split
    have hset : {q : ℝ | 0 < q ∧ μ * τ ≤ q - (μ ^ (1/2 - h) * z) ^ 2 * q ^ (2 * h)} =
        μ • {p : ℝ | 0 < p ∧ τ ≤ p - z ^ 2 * p ^ (2 * h)} := by
      ext q
      rw [Set.mem_smul_set_iff_inv_smul_mem₀ hμ.ne', smul_eq_mul]
      simp only [Set.mem_setOf_eq]
      have hq : q = μ * (μ⁻¹ * q) := by field_simp
      constructor
      · rintro ⟨hq0, hle⟩
        have hp : 0 < μ⁻¹ * q := mul_pos (inv_pos.mpr hμ) hq0
        refine ⟨hp, ?_⟩
        rw [hq, key _ hp] at hle
        exact le_of_mul_le_mul_left hle hμ
      · rintro ⟨hp, hle⟩
        refine ⟨by rw [hq]; exact mul_pos hμ hp, ?_⟩
        rw [hq, key _ hp]
        exact mul_le_mul_of_nonneg_left hle hμ.le
    unfold simScale
    rw [hset, Real.sInf_smul_of_nonneg hμ.le, smul_eq_mul]
  intro k

  obtain ⟨C, hC⟩ : ∃ C : ℝ, ∀ Z T : ℝ, 0 < T → simScale h Z T = 1 →
      ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (Z, T)‖ ≤ C := by
    rcases Nat.eq_zero_or_pos k with hk | hk
    · subst hk
      refine ⟨1, fun Z T _ h1 => ?_⟩
      rw [norm_iteratedFDeriv_zero]
      show ‖simScale h Z T‖ ≤ 1
      rw [h1, norm_one]
    · obtain ⟨C, hC⟩ := hS5 k hk
      refine ⟨C, fun Z T hT h1 => ?_⟩
      have := hC Z T hT h1.le
      rwa [h1, Real.one_rpow, mul_one] at this
  refine ⟨C, fun z τ hτ _ => ?_⟩
  obtain ⟨hQ0, -⟩ := hS1 z τ hτ
  obtain ⟨Q, hQd⟩ : ∃ Q, Q = simScale h z τ := ⟨_, rfl⟩
  rw [← hQd] at hQ0 ⊢
  obtain ⟨Z, hZ⟩ : ∃ Z : ℝ, Z = Q ^ (-(1/2 - h)) * z := ⟨_, rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : ℝ, T = Q⁻¹ * τ := ⟨_, rfl⟩
  have hT0 : 0 < T := by rw [hT]; exact mul_pos (inv_pos.mpr hQ0) hτ
  have hZT : simScale h Z T = 1 := by
    have := hom Q⁻¹ z τ (inv_pos.mpr hQ0)
    rw [Real.inv_rpow hQ0.le, ← Real.rpow_neg hQ0.le, ← hQd, inv_mul_cancel₀ hQ0.ne'] at this
    rw [hZ, hT]
    exact this
  have hzb : Q ^ (1/2 - h) * Z = z := by
    rw [hZ, ← mul_assoc, ← Real.rpow_add hQ0]
    simp
  have hτb : Q * T = τ := by
    rw [hT]
    exact mul_inv_cancel_left₀ hQ0.ne' τ
  have hpa : 0 < Q ^ (1/2 - h) := Real.rpow_pos_of_pos hQ0 _
  let e₁ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 (Q ^ (1/2 - h)) hpa.ne')
  let e₂ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 Q hQ0.ne')
  let L : (ℝ × ℝ) ≃L[ℝ] (ℝ × ℝ) := e₁.prodCongr e₂
  let M : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 Q hQ0.ne')
  have hL : ∀ x : ℝ × ℝ, L x = (Q ^ (1/2 - h) * x.1, Q * x.2) := by
    intro x
    simp [L, e₁, e₂, mul_comm]
  have hM : ∀ y : ℝ, M y = Q * y := by
    intro y
    simp [M, mul_comm]
  have hfun : (fun w : ℝ × ℝ => simScale h w.1 w.2) ∘ L =
      M ∘ (fun w : ℝ × ℝ => simScale h w.1 w.2) := by
    funext w
    simp only [Function.comp, hL, hM]
    exact hom Q w.1 w.2 hQ0
  have hLclm : (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)) =
      (Q ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap (Q • ContinuousLinearMap.id ℝ ℝ) := by
    apply ContinuousLinearMap.ext
    intro x
    apply Prod.ext
    · simp [hL]
    · simp [hL]
  have hLv : L (Z, T) = (z, τ) := by
    rw [hL]
    exact Prod.ext hzb hτb
  have hcomp : iteratedFDeriv ℝ k ((fun w : ℝ × ℝ => simScale h w.1 w.2) ∘ L) (Z, T) =
      (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (L (Z, T))).compContinuousLinearMap
        (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) := by
    have := L.iteratedFDerivWithin_comp_right (fun w : ℝ × ℝ => simScale h w.1 w.2)
      uniqueDiffOn_univ (mem_univ (L (Z, T))) k
    rwa [preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at this
  have key : (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, τ)).compContinuousLinearMap
        (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) =
      (M : ℝ →L[ℝ] ℝ).compContinuousMultilinearMap
        (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (Z, T)) := by
    rw [← hLv, ← hcomp, hfun, M.iteratedFDeriv_comp_left]
  have hMn : ‖(M : ℝ →L[ℝ] ℝ)‖ ≤ Q := by
    refine ContinuousLinearMap.opNorm_le_bound _ hQ0.le fun y => ?_
    show ‖M y‖ ≤ Q * ‖y‖
    rw [hM, norm_mul, Real.norm_eq_abs Q, abs_of_pos hQ0]
  rw [← hLclm, key]
  calc _ ≤ ‖(M : ℝ →L[ℝ] ℝ)‖ *
          ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (Z, T)‖ :=
        ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
    _ ≤ Q * C := mul_le_mul hMn (hC Z T hT0 hZT) (norm_nonneg _) hQ0.le
    _ = C * Q := mul_comm _ _

theorem stp5_simscale_rpow_norm : ∀ h : ℝ, 0 < h → h < 1/100 → SimScaleProps h → SimNorm h → ∀ (p : ℝ) (k : ℕ), ∃ C : ℝ, ∀ z τ : ℝ, 0 < τ → simScale h z τ ≤ 1 → ‖(iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2 ^ p) (z, τ)).compContinuousLinearMap (fun _ => (simScale h z τ ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap (simScale h z τ • ContinuousLinearMap.id ℝ ℝ))‖ ≤ C * simScale h z τ ^ p :=
by
  intro h _ _ hS _ p k
  obtain ⟨hS1, -, -, hS4, hS5⟩ := hS

  open Pointwise in
  have hom : ∀ μ z τ : ℝ, 0 < μ →
      simScale h (μ ^ (1/2 - h) * z) (μ * τ) = μ * simScale h z τ := by
    intro μ z τ hμ
    have key : ∀ p : ℝ, 0 < p → μ * p - (μ ^ (1/2 - h) * z) ^ 2 * (μ * p) ^ (2 * h) =
        μ * (p - z ^ 2 * p ^ (2 * h)) := by
      intro p hp
      have sq : (μ ^ (1/2 - h)) ^ 2 = μ ^ (1 - 2 * h) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul hμ.le]
        congr 1
        push_cast
        ring
      have split : μ ^ (1 - 2 * h) * μ ^ (2 * h) = μ := by
        rw [← Real.rpow_add hμ]
        have e : 1 - 2 * h + 2 * h = 1 := by ring
        rw [e, Real.rpow_one]
      rw [mul_pow, sq, Real.mul_rpow hμ.le hp.le]
      linear_combination (-(z ^ 2 * p ^ (2 * h))) * split
    have hset : {q : ℝ | 0 < q ∧ μ * τ ≤ q - (μ ^ (1/2 - h) * z) ^ 2 * q ^ (2 * h)} =
        μ • {p : ℝ | 0 < p ∧ τ ≤ p - z ^ 2 * p ^ (2 * h)} := by
      ext q
      rw [Set.mem_smul_set_iff_inv_smul_mem₀ hμ.ne', smul_eq_mul]
      simp only [Set.mem_setOf_eq]
      have hq : q = μ * (μ⁻¹ * q) := by field_simp
      constructor
      · rintro ⟨hq0, hle⟩
        have hp : 0 < μ⁻¹ * q := mul_pos (inv_pos.mpr hμ) hq0
        refine ⟨hp, ?_⟩
        rw [hq, key _ hp] at hle
        exact le_of_mul_le_mul_left hle hμ
      · rintro ⟨hp, hle⟩
        refine ⟨by rw [hq]; exact mul_pos hμ hp, ?_⟩
        rw [hq, key _ hp]
        exact mul_le_mul_of_nonneg_left hle hμ.le
    unfold simScale
    rw [hset, Real.sInf_smul_of_nonneg hμ.le, smul_eq_mul]

  have hnn : ∀ z τ : ℝ, 0 ≤ simScale h z τ := by
    intro z τ
    unfold simScale
    exact Real.sInf_nonneg (fun x hx => hx.1.le)

  obtain ⟨C, hC⟩ : ∃ C : ℝ, ∀ Z T : ℝ, 0 < T → simScale h Z T = 1 →
      ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2 ^ p) (Z, T)‖ ≤ C := by
    set A : ℝ := ∑ i ∈ Finset.range (k + 1), |Polynomial.eval p (descPochhammer ℝ i)| with hAdef
    have hA : ∀ i : ℕ, i ≤ k →
        ‖iteratedFDerivWithin ℝ i (fun x : ℝ => x ^ p) (Set.Ioi (0:ℝ)) 1‖ ≤ A := by
      intro i hi
      rw [iteratedFDerivWithin_of_isOpen i isOpen_Ioi (show (1:ℝ) ∈ Set.Ioi (0:ℝ) from Set.mem_Ioi.mpr one_pos),
        norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
        Real.iter_deriv_rpow_const, Real.one_rpow, mul_one, Real.norm_eq_abs]
      exact Finset.single_le_sum (f := fun i => |Polynomial.eval p (descPochhammer ℝ i)|)
        (fun i _ => abs_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    have hS5' : ∀ i : ℕ, ∃ C : ℝ, 1 ≤ i → ∀ z τ : ℝ, 0 < τ → simScale h z τ ≤ 1 →
        ‖iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, τ)‖ ≤
          C * simScale h z τ ^ (1 - (i : ℝ)) := by
      intro i
      by_cases hi : 1 ≤ i
      · obtain ⟨C, hC⟩ := hS5 i hi
        exact ⟨C, fun _ => hC⟩
      · exact ⟨0, fun h => absurd h hi⟩
    choose C' hC' using hS5'
    set K : ℝ := 1 + ∑ i ∈ Finset.range (k + 1), |C' i| with hKdef
    have hK1 : 1 ≤ K := by
      have := Finset.sum_nonneg (fun i (_ : i ∈ Finset.range (k + 1)) => abs_nonneg (C' i))
      linarith
    have hOopen : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
    refine ⟨(k.factorial : ℝ) * A * K ^ k, fun Z T hT h1 => ?_⟩
    have hmem : ((Z, T) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := ⟨mem_univ _, hT⟩
    have hg : ContDiffOn ℝ ∞ (fun x : ℝ => x ^ p) (Set.Ioi 0) :=
      (contDiffOn_id (s := Set.Ioi (0:ℝ))).rpow_const_of_ne (fun x hx => ne_of_gt hx)
    have hmaps : Set.MapsTo (fun w : ℝ × ℝ => simScale h w.1 w.2) (univ ×ˢ Ioi (0:ℝ))
        (Set.Ioi 0) :=
      fun w hw => (hS1 w.1 w.2 hw.2).1
    have hK : ∀ i : ℕ, 1 ≤ i → i ≤ k →
        ‖iteratedFDerivWithin ℝ i (fun w : ℝ × ℝ => simScale h w.1 w.2) (univ ×ˢ Ioi (0:ℝ))
          (Z, T)‖ ≤ K ^ i := by
      intro i hi1 hik
      rw [iteratedFDerivWithin_of_isOpen i hOopen hmem]
      have h2 := hC' i hi1 Z T hT h1.le
      rw [h1, Real.one_rpow, mul_one] at h2
      have hCi : |C' i| ≤ K := by
        have := Finset.single_le_sum (f := fun i => |C' i|) (fun i _ => abs_nonneg _)
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hik))
        linarith
      exact h2.trans ((le_abs_self _).trans (hCi.trans (le_self_pow₀ hK1 (by omega))))
    have hA' : ∀ i : ℕ, i ≤ k →
        ‖iteratedFDerivWithin ℝ i (fun x : ℝ => x ^ p) (Set.Ioi (0:ℝ))
          ((fun w : ℝ × ℝ => simScale h w.1 w.2) (Z, T))‖ ≤ A := by
      intro i hi
      show ‖iteratedFDerivWithin ℝ i (fun x : ℝ => x ^ p) (Set.Ioi (0:ℝ)) (simScale h Z T)‖ ≤ A
      rw [h1]
      exact hA i hi
    have key := norm_iteratedFDerivWithin_comp_le hg hS4 (by exact_mod_cast le_top)
      isOpen_Ioi.uniqueDiffOn hOopen.uniqueDiffOn hmaps hmem (C := A) (D := K) hA' hK
    rw [iteratedFDerivWithin_of_isOpen k hOopen hmem] at key
    exact key

  refine ⟨C, fun z τ hτ _ => ?_⟩
  obtain ⟨hQ0, -⟩ := hS1 z τ hτ
  obtain ⟨Q, hQd⟩ : ∃ Q, Q = simScale h z τ := ⟨_, rfl⟩
  rw [← hQd] at hQ0 ⊢
  obtain ⟨Z, hZ⟩ : ∃ Z : ℝ, Z = Q ^ (-(1/2 - h)) * z := ⟨_, rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : ℝ, T = Q⁻¹ * τ := ⟨_, rfl⟩
  have hT0 : 0 < T := by rw [hT]; exact mul_pos (inv_pos.mpr hQ0) hτ
  have hZT : simScale h Z T = 1 := by
    have := hom Q⁻¹ z τ (inv_pos.mpr hQ0)
    rw [Real.inv_rpow hQ0.le, ← Real.rpow_neg hQ0.le, ← hQd, inv_mul_cancel₀ hQ0.ne'] at this
    rw [hZ, hT]
    exact this
  have hzb : Q ^ (1/2 - h) * Z = z := by
    rw [hZ, ← mul_assoc, ← Real.rpow_add hQ0]
    simp
  have hτb : Q * T = τ := by
    rw [hT]
    exact mul_inv_cancel_left₀ hQ0.ne' τ

  have hpa : 0 < Q ^ (1/2 - h) := Real.rpow_pos_of_pos hQ0 _
  have hQp : 0 < Q ^ p := Real.rpow_pos_of_pos hQ0 _
  let e₁ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 (Q ^ (1/2 - h)) hpa.ne')
  let e₂ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 Q hQ0.ne')
  let L : (ℝ × ℝ) ≃L[ℝ] (ℝ × ℝ) := e₁.prodCongr e₂
  let M : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 (Q ^ p) hQp.ne')
  have hL : ∀ x : ℝ × ℝ, L x = (Q ^ (1/2 - h) * x.1, Q * x.2) := by
    intro x
    simp [L, e₁, e₂, mul_comm]
  have hM : ∀ y : ℝ, M y = Q ^ p * y := by
    intro y
    simp [M, mul_comm]
  have hfun : (fun w : ℝ × ℝ => simScale h w.1 w.2 ^ p) ∘ L =
      M ∘ (fun w : ℝ × ℝ => simScale h w.1 w.2 ^ p) := by
    funext w
    simp only [Function.comp, hL, hM]
    rw [hom Q w.1 w.2 hQ0, Real.mul_rpow hQ0.le (hnn w.1 w.2)]
  have hLclm : (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)) =
      (Q ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap (Q • ContinuousLinearMap.id ℝ ℝ) := by
    apply ContinuousLinearMap.ext
    intro x
    apply Prod.ext
    · simp [hL]
    · simp [hL]
  have hLv : L (Z, T) = (z, τ) := by
    rw [hL]
    exact Prod.ext hzb hτb
  have hcomp : iteratedFDeriv ℝ k ((fun w : ℝ × ℝ => simScale h w.1 w.2 ^ p) ∘ L) (Z, T) =
      (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2 ^ p) (L (Z, T))).compContinuousLinearMap
        (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) := by
    have := L.iteratedFDerivWithin_comp_right (fun w : ℝ × ℝ => simScale h w.1 w.2 ^ p)
      uniqueDiffOn_univ (mem_univ (L (Z, T))) k
    rwa [preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at this
  have key : (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2 ^ p) (z, τ)).compContinuousLinearMap
        (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) =
      (M : ℝ →L[ℝ] ℝ).compContinuousMultilinearMap
        (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2 ^ p) (Z, T)) := by
    rw [← hLv, ← hcomp, hfun, M.iteratedFDeriv_comp_left]
  have hMn : ‖(M : ℝ →L[ℝ] ℝ)‖ ≤ Q ^ p := by
    refine ContinuousLinearMap.opNorm_le_bound _ hQp.le fun y => ?_
    show ‖M y‖ ≤ Q ^ p * ‖y‖
    rw [hM, norm_mul, Real.norm_eq_abs (Q ^ p), abs_of_pos hQp]

  rw [← hLclm, key]
  calc _ ≤ ‖(M : ℝ →L[ℝ] ℝ)‖ *
          ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2 ^ p) (Z, T)‖ :=
        ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
    _ ≤ Q ^ p * C := mul_le_mul hMn (hC Z T hT0 hZT) (norm_nonneg _) hQp.le
    _ = C * Q ^ p := mul_comm _ _

theorem t0star4_njet : ∀ (B : BG), B.ok → ∀ (R : ℝ), 1 ≤ R → ∀ k : ℕ, ∃ C N : ℝ, 0 ≤ N ∧
    ∀ (l : ℕ) (ξ : Cyl), ξ ∈ DomC B.h B.qB → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
    1 / R ≤ qC B.h ξ / Qb l → qC B.h ξ / Qb l ≤ R →
    ContDiffAt ℝ ∞ (fun s : ℝ × ℝ × ℝ => T0star4 B l (s.1, s.2.1, s.2.2, 0)) (ξ.1, ξ.2.1, ξ.2.2.1) ∧
    ∀ i : ℕ, i ≤ k → sJet5 (fun s : ℝ × ℝ × ℝ => T0star4 B l (s.1, s.2.1, s.2.2, 0)) (ξ.1, ξ.2.1, ξ.2.2.1)
      (DqS5 B.h ξ) i ≤ C * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-N) :=
by
  intro B hB R hR k
  have hS : SimScaleProps B.h := hB.1
  obtain ⟨hh0, hh1, hXa, -, -, -, -, hqB0, hqB1, -, -, -, -⟩ := hB.2.1
  have hNm := simscale_normalized_v4 B.h hh0 hh1 hS
  have H2 := fun (p : ℝ) (k : ℕ) =>
    simscale_rpow_sjet B.h p hS (fun i => stp5_simscale_rpow_norm B.h hh0 hh1 hS hNm p i) k
  obtain ⟨C₂, hC₂0, hC₂⟩ := H2 (-(1 - B.h)) k
  obtain ⟨D, hD1, hD⟩ := xc_etac_sjet B.h hS H2 B.Xb k
  obtain ⟨C₄, N, hC₄0, hN0, hC₄⟩ := t0pair_outer_bound B hB k
  refine ⟨2 ^ k * C₂ * R * ((k.factorial : ℝ) * C₄ * D ^ k), N, hN0, ?_⟩
  intro l ξ hdom hX1 hX2 hR1 hR2

  have hτ : 0 < 1 - ξ.2.2.1 := by linarith [hdom.2.1]
  have hq0 : 0 < qC B.h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
  have hq1 : qC B.h ξ ≤ 1 := le_trans hdom.2.2.le hqB1
  have hQb : 0 < Qb l := Real.rpow_pos_of_pos (by norm_num) _
  have hetaC : -1 < etaC B.h ξ ∧ etaC B.h ξ < 1 := by
    have hz := (hS.2.1 ξ.2.1 (1 - ξ.2.2.1) hτ).2
    have hp : 0 < qC B.h ξ ^ (1/2 - B.h) := Real.rpow_pos_of_pos hq0 _
    have hp2 : (qC B.h ξ ^ (1/2 - B.h)) ^ 2 = qC B.h ξ ^ (1 - 2 * B.h) := by
      rw [sq, ← Real.rpow_add hq0]; congr 1; ring
    have hz' : ξ.2.1 ^ 2 < (qC B.h ξ ^ (1/2 - B.h)) ^ 2 := by rw [hp2]; exact hz
    have habs := abs_lt_of_sq_lt_sq hz' hp.le
    have he : etaC B.h ξ = ξ.2.1 / qC B.h ξ ^ (1/2 - B.h) := by
      rw [etaC, Real.rpow_neg hq0.le, div_eq_mul_inv ξ.2.1]
    rw [he]
    constructor
    · rw [lt_div_iff₀ hp]; linarith [neg_abs_le ξ.2.1]
    · rw [div_lt_iff₀ hp]; linarith [le_abs_self ξ.2.1]
  have hratio : Qb l / qC B.h ξ ≤ R := by
    have h1 := one_div_le_one_div_of_le (div_pos one_pos (by linarith) : (0:ℝ) < 1 / R) hR1
    rwa [one_div_div, one_div_one_div] at h1
  have hew : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
    unfold edgeWeight; split_ifs <;> positivity
  have hed : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) := by
    have hX0 : 0 < XC B.h ξ := lt_trans hXa hX1
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
      (Real.log_pos ((one_lt_div hX0).mpr hX2)))
  obtain ⟨P, hPdef⟩ : ∃ x : ℝ, x = C₄ * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
      edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-N) := ⟨_, rfl⟩
  have hP0 : 0 ≤ P := by rw [hPdef]; exact mul_nonneg (mul_nonneg hC₄0 hew) (Real.rpow_nonneg hed.le _)
  have hsJ0 : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : ℝ × ℝ × ℝ → V) (i : ℕ),
      0 ≤ sJet5 f (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) i := by
    intro V _ _ f i; unfold sJet5; exact norm_nonneg _
  have hsum : ∀ (n : ℕ) (a b : ℕ → ℝ) (P Q : ℝ), (∀ i, i ≤ n → 0 ≤ a i ∧ a i ≤ P) →
      (∀ i, i ≤ n → 0 ≤ b i ∧ b i ≤ Q) →
      ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * a i * b (n - i) ≤ 2 ^ n * P * Q := by
    intro n a b P Q ha hb
    have hP : 0 ≤ P := le_trans (ha 0 (Nat.zero_le _)).1 (ha 0 (Nat.zero_le _)).2
    calc ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * a i * b (n - i)
        ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * P * Q := by
          apply Finset.sum_le_sum
          intro i hi
          have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have h1 := ha i hi'
          have h2 := hb (n - i) (Nat.sub_le n i)
          have hc : (0:ℝ) ≤ n.choose i := Nat.cast_nonneg _
          exact mul_le_mul (mul_le_mul_of_nonneg_left h1.2 hc) h2.2 h2.1 (mul_nonneg hc hP)
      _ = (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ)) * P * Q := by
          rw [Finset.sum_mul, Finset.sum_mul]
      _ = 2 ^ n * P * Q := by
          congr 2
          exact_mod_cast Nat.sum_range_choose n

  set Qp : ℝ × ℝ × ℝ → ℝ := fun s => simScale B.h s.2.1 (1 - s.2.2) ^ (-(1 - B.h)) with hQpdef
  set w : ℝ × ℝ × ℝ → ℝ × ℝ := fun s => (s.1 ^ 2 / (2 * simScale B.h s.2.1 (1 - s.2.2)),
    s.2.1 * simScale B.h s.2.1 (1 - s.2.2) ^ (-(1/2 - B.h))) with hwdef
  set T0p : ℝ × ℝ → ℝ × ℝ := fun p => (B.T0th p.1 p.2, B.T0z p.1 p.2) with hT0pdef
  obtain ⟨Bil, hBil⟩ : ∃ Bil : ℝ →L[ℝ] (ℝ × ℝ) →L[ℝ] (ℝ × ℝ),
      Bil = (Qb l ^ (1 - B.h)) • ContinuousLinearMap.lsmul ℝ ℝ := ⟨_, rfl⟩
  have hfun : (fun s : ℝ × ℝ × ℝ => T0star4 B l (s.1, s.2.1, s.2.2, 0)) =
      fun x => Bil (Qp x) ((T0p ∘ w) x) := by
    funext s
    have hQ0 : 0 ≤ simScale B.h s.2.1 (1 - s.2.2) := Real.sInf_nonneg (fun x hx => le_of_lt hx.1)
    have e : (Qb l / simScale B.h s.2.1 (1 - s.2.2)) ^ (1 - B.h) =
        Qb l ^ (1 - B.h) * simScale B.h s.2.1 (1 - s.2.2) ^ (-(1 - B.h)) := by
      rw [Real.div_rpow hQb.le hQ0, div_eq_mul_inv, Real.rpow_neg hQ0]
    rw [hBil]
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.lsmul_apply, Function.comp_apply,
      smul_smul, hQpdef, hwdef, hT0pdef]
    show (Qb l / simScale B.h s.2.1 (1 - s.2.2)) ^ (1 - B.h) •
      (B.T0th (s.1 ^ 2 / (2 * simScale B.h s.2.1 (1 - s.2.2))) (s.2.1 * simScale B.h s.2.1 (1 - s.2.2) ^ (-(1/2 - B.h))),
       B.T0z (s.1 ^ 2 / (2 * simScale B.h s.2.1 (1 - s.2.2))) (s.2.1 * simScale B.h s.2.1 (1 - s.2.2) ^ (-(1/2 - B.h)))) = _
    rw [e]
  have hBn : ‖Bil‖ ≤ Qb l ^ (1 - B.h) := by
    rw [hBil]
    have h1 := norm_smul_le (Qb l ^ (1 - B.h))
      (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))
    rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg hQb.le _)] at h1
    exact h1.trans (mul_le_of_le_one_right (Real.rpow_nonneg hQb.le _) (ContinuousLinearMap.opNorm_lsmul_le))

  obtain ⟨hQps, hQpb⟩ := hC₂ ξ hdom.2.1 hq1
  obtain ⟨hws, hwb⟩ := hD ξ hdom.1 hdom.2.1 hq1 hX2
  obtain ⟨hTs, hTb⟩ := hC₄ (XC B.h ξ) (etaC B.h ξ) hX1 hX2 hetaC.1 hetaC.2
  have hcomp : ∀ i, i ≤ k → ContDiffAt ℝ ∞ (T0p ∘ w) (ξ.1, ξ.2.1, ξ.2.2.1) ∧
      sJet5 (T0p ∘ w) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) i ≤ (k.factorial : ℝ) * P * D ^ k := by
    intro i hi
    obtain ⟨h1, h2⟩ := sjet_comp_le T0p w (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) i P D hws hTs
      (fun j hj => by rw [hPdef]; exact hTb j (le_trans hj hi))
      (fun j hj1 hj2 => hwb j hj1 (le_trans hj2 hi))
    refine ⟨h1, le_trans h2 ?_⟩
    have hf : (i.factorial : ℝ) ≤ k.factorial := by exact_mod_cast Nat.factorial_le hi
    have hDp : D ^ i ≤ D ^ k := pow_le_pow_right₀ hD1 hi
    exact mul_le_mul (mul_le_mul_of_nonneg_right hf hP0) hDp (pow_nonneg (by linarith) _)
      (mul_nonneg (Nat.cast_nonneg _) hP0)
  have hcs := (hcomp 0 (Nat.zero_le _)).1
  rw [hfun]
  refine ⟨(njet_bilinear Bil Qp (T0p ∘ w) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) 0 hQps hcs).1, ?_⟩
  intro i hi
  have hb := (njet_bilinear Bil Qp (T0p ∘ w) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) i hQps hcs).2
  have hs := hsum i (fun j => sJet5 Qp (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) j)
    (fun j => sJet5 (T0p ∘ w) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) j)
    (C₂ * qC B.h ξ ^ (-(1 - B.h))) ((k.factorial : ℝ) * P * D ^ k)
    (fun j hj => ⟨hsJ0 _ j, hQpb j (le_trans hj hi)⟩)
    (fun j hj => ⟨hsJ0 _ j, (hcomp j (le_trans hj hi)).2⟩)
  have hS0 : 0 ≤ ∑ j ∈ Finset.range (i + 1), (i.choose j : ℝ) * sJet5 Qp (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) j *
      sJet5 (T0p ∘ w) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) (i - j) :=
    Finset.sum_nonneg (fun j _ => mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (hsJ0 _ _)) (hsJ0 _ _))
  have hX0 : 0 ≤ (k.factorial : ℝ) * P * D ^ k :=
    mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hP0) (pow_nonneg (by linarith) _)
  have hqp0 : 0 ≤ qC B.h ξ ^ (-(1 - B.h)) := Real.rpow_nonneg hq0.le _
  have hQR : Qb l ^ (1 - B.h) * qC B.h ξ ^ (-(1 - B.h)) ≤ R := by
