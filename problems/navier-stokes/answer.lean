        exact h'.deriv
      have hd2 : deriv (fun x : ℝ => ξ.1 * s + q * x) = fun _ => q := by
        funext x
        have h := ((hasDerivAt_id' x).const_mul q).const_add (ξ.1 * s)
        have h' : HasDerivAt (fun x : ℝ => ξ.1 * s + q * x) q x := by
          convert h using 1; ring
        exact h'.deriv
      have hd3 : deriv (fun _ : ℝ => q) = fun _ => (0:ℝ) := by
        funext x; exact deriv_const x q
      rcases a with _ | _ | _ | n
      · rw [iteratedDeriv_zero, hpdef]
        show |ξ.1 ^ 2 / 2 + ξ.1 * s * 0 + q / 2 * (0 * 0)| ≤ ξ.1 ^ 2 + q
        rw [abs_le]; constructor <;> nlinarith [sq_nonneg ξ.1]
      · rw [iteratedDeriv_succ', iteratedDeriv_zero, hd1]
        show |ξ.1 * s + q * 0| ≤ ξ.1 ^ 2 + q
        rw [abs_le]; constructor <;> nlinarith [sq_nonneg (ξ.1 - s), sq_nonneg (ξ.1 + s), sq_nonneg ξ.1]
      · rw [iteratedDeriv_succ', iteratedDeriv_succ', iteratedDeriv_zero, hd1, hd2]
        show |q| ≤ ξ.1 ^ 2 + q
        rw [abs_of_pos hq']; nlinarith [sq_nonneg ξ.1]
      · rw [iteratedDeriv_succ', iteratedDeriv_succ', iteratedDeriv_succ', hd1, hd2, hd3,
          iteratedDeriv_const]
        simp only [ite_self, abs_zero]
        exact add_nonneg (sq_nonneg _) hq'.le

    choose Ci hCi using hqpow (-1)
    have hXCnb : ∀ i : ℕ, ∀ ξ ∈ DomC B.h qs, XC B.h ξ < B.Xb →
        NB B.h (XC B.h) i ξ ≤
          (2 * B.Xb + 1) * ∑ a ∈ Finset.range (i + 1), (i.choose a : ℝ) * |Ci (i - a)| := by
      intro i ξ hξ hX
      have hq := hqpos ξ hξ
