  have hE1 : |Real.sqrt (1 + (sgn γ.2.2 * (G.ustar / 2 + G.ustar * v / Lsb B.h G.r0 γ.1)) ^ 2) -
      Real.sqrt (1 + G.ustar ^ 2)| ≤ 5 * G.ustar ^ 2 / 2 * (|v - Lsb B.h G.r0 γ.1 / 2| / Lsb B.h G.r0 γ.1) := by
    refine (hsqrt _ _).trans ?_
    rw [mul_pow, hsg2, one_mul, hp, hea,
      show (G.ustar * (1 + e)) ^ 2 - G.ustar ^ 2 = G.ustar ^ 2 * (e * (2 + e)) by ring,
      abs_mul, abs_of_nonneg (sq_nonneg _), abs_mul]
    have h2e : |2 + e| ≤ 5 / 2 := by
      rw [abs_le] at heb ⊢; constructor <;> linarith
    calc G.ustar ^ 2 * (|e| * |2 + e|) ≤ G.ustar ^ 2 * (|e| * (5 / 2)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h2e (abs_nonneg e)) (sq_nonneg _)
      _ = 5 * G.ustar ^ 2 / 2 * |e| := by ring
  have hE2 : |sgn γ.2.2 * (G.ustar / 2 + G.ustar * v / Lsb B.h G.r0 γ.1) - sgn γ.2.2 * G.ustar| ≤
      G.ustar * (|v - Lsb B.h G.r0 γ.1 / 2| / Lsb B.h G.r0 γ.1) := by
    rw [← mul_sub, abs_mul, hsga, one_mul, hp, hea,
      show G.ustar * (1 + e) - G.ustar = G.ustar * e by ring, abs_mul, abs_of_pos hu]
  have hE2' : |-(sgn γ.2.2 * (G.ustar / 2 + G.ustar * v / Lsb B.h G.r0 γ.1)) - -(sgn γ.2.2 * G.ustar)| ≤
      G.ustar * (|v - Lsb B.h G.r0 γ.1 / 2| / Lsb B.h G.r0 γ.1) := by
    rw [show ∀ x y : ℝ, -x - -y = -(x - y) from fun x y => by ring, abs_neg]; exact hE2
  change |G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 1 - G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 *
      (c0f5 B G γ * Real.sqrt (1 + (sgn γ.2.2 * (G.ustar / 2 + G.ustar * v / Lsb B.h G.r0 γ.1)) ^ 2) *
        (Nfr5 B G γ).1 + sgn γ.2.2 * (G.ustar / 2 + G.ustar * v / Lsb B.h G.r0 γ.1) * (Nfr5 B G γ).2)| ≤
      G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 * Ct0 / Lsb B.h G.r0 γ.1 at hT1
  change |G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 2 - G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 *
      (c0f5 B G γ * Real.sqrt (1 + (sgn γ.2.2 * (G.ustar / 2 + G.ustar * v / Lsb B.h G.r0 γ.1)) ^ 2) *
        (Nfr5 B G γ).2 - sgn γ.2.2 * (G.ustar / 2 + G.ustar * v / Lsb B.h G.r0 γ.1) * (Nfr5 B G γ).1)| ≤
      G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 * Ct0 / Lsb B.h G.r0 γ.1 at hT2
  have tg1 := tang _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ rfl rfl hx.le hc0 hNb1 hNb2 hE1 hE2 hT1
  have tg2 := tang _ _ (c0f5 B G γ) (Nfr5 B G γ).2 (Nfr5 B G γ).1 _ (Real.sqrt (1 + G.ustar ^ 2))
    (-(sgn γ.2.2 * G.ustar)) (-(sgn γ.2.2 * (G.ustar / 2 + G.ustar * v / Lsb B.h G.r0 γ.1))) _ _ _ _
    (c0f5 B G γ * Real.sqrt (1 + G.ustar ^ 2) * (Nfr5 B G γ).2 - sgn γ.2.2 * G.ustar * (Nfr5 B G γ).1)
    _ (by ring) (by ring) hx.le hc0 hNb2 hNb1 hE1 hE2' hT2
  have hCtL : Ct0 / Lsb B.h G.r0 γ.1 ≤ Ct0 / (2 * G.r0) / Sb γ.1 := by
    rw [div_div]
    exact div_le_div_of_nonneg_left hCt0 (mul_pos (by linarith) (by unfold Sb; positivity))
      (by unfold Sb; linarith [hLlo])
  have hfin : Ct0 / Lsb B.h G.r0 γ.1 + (Cm * (5 * G.ustar ^ 2 / 2 * (|v - Lsb B.h G.r0 γ.1 / 2| /
      Lsb B.h G.r0 γ.1)) + G.ustar * (|v - Lsb B.h G.r0 γ.1 / 2| / Lsb B.h G.r0 γ.1)) ≤
      Ct0 / (2 * G.r0) / Sb γ.1 + (Cm * (5 * G.ustar ^ 2 / 2) + G.ustar) * |v - Lsb B.h G.r0 γ.1 / 2| /
        Lsb B.h G.r0 γ.1 := by
    have : Cm * (5 * G.ustar ^ 2 / 2 * (|v - Lsb B.h G.r0 γ.1 / 2| / Lsb B.h G.r0 γ.1)) +
        G.ustar * (|v - Lsb B.h G.r0 γ.1 / 2| / Lsb B.h G.r0 γ.1) =
        (Cm * (5 * G.ustar ^ 2 / 2) + G.ustar) * |v - Lsb B.h G.r0 γ.1 / 2| / Lsb B.h G.r0 γ.1 := by ring
    linarith
  have hsq : 0 ≤ (v - Lsb B.h G.r0 γ.1 / 2) ^ 2 := sq_nonneg _
  refine ⟨?_, ?_, tg1.trans (mul_le_mul_of_nonneg_left hfin hx.le),
    tg2.trans (mul_le_mul_of_nonneg_left hfin hx.le)⟩
  · rw [← Real.exp_add, ← Real.exp_log hx]
    apply Real.exp_le_exp.mpr
    have : -(Cm * (9 * G.ustar ^ 2 / 4)) * (v - Lsb B.h G.r0 γ.1 / 2) ^ 2 / Lsb B.h G.r0 γ.1 ≤
        -(lam0_5 B G γ * (9 * G.ustar ^ 2 / 4)) * (v - Lsb B.h G.r0 γ.1 / 2) ^ 2 / Lsb B.h G.r0 γ.1 :=
      div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right (neg_le_neg
        (mul_le_mul_of_nonneg_right (hlamu.trans hCfm) (by positivity))) hsq) hL0.le
    linarith
  · rw [← Real.exp_add, ← Real.exp_log hx]
    apply Real.exp_le_exp.mpr
    have : -(lam0_5 B G γ * G.ustar ^ 2 / (2 * W)) * (v - Lsb B.h G.r0 γ.1 / 2) ^ 2 / Lsb B.h G.r0 γ.1 ≤
        -(cf * G.ustar ^ 2 / (2 * W)) * (v - Lsb B.h G.r0 γ.1 / 2) ^ 2 / Lsb B.h G.r0 γ.1 :=
      div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right (neg_le_neg
        (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hlaml (sq_nonneg _)) (by linarith))) hsq)
        hL0.le
    linarith

theorem pulse_gauss_moments : ∀ (L a1 a2 c1 C1 : ℝ) (x : ℝ → ℝ), 25 ≤ L → 0 < a2 → a2 ≤ a1 → 0 < c1 → c1 ≤ C1 →
    ContinuousOn x (Set.Icc 0 L) →
    (∀ v ∈ Set.Icc 0 L, c1 * Real.exp (-a1 * (v - L/2)^2 / L) ≤ x v ∧ x v ≤ C1 * Real.exp (-a2 * (v - L/2)^2 / L)) →
    2 * c1 ^ 2 * Real.exp (-2 * a1) * Real.sqrt L ≤ ∫ v in (0:ℝ)..L, psiT L v ^ 2 * x v ^ 2 ∧
    ∫ v in (0:ℝ)..L, psiT L v ^ 2 * x v ^ 2 ≤ C1 ^ 2 * Real.sqrt (Real.pi / (2 * a2)) * Real.sqrt L ∧
    ∫ v in (0:ℝ)..L, psiT L v ^ 2 * x v ^ 2 * |v - L/2| ≤ C1 ^ 2 / (2 * a2) * L :=
by
  intro L a1 a2 c1 C1 x hL ha2 ha12 hc1 hc1C hx henv

  have gA : ∀ (b m p q : ℝ), 0 < b → p ≤ q →
      ∫ v in p..q, Real.exp (-b * (v - m) ^ 2) ≤ Real.sqrt (Real.pi / b) := by
    intro b m p q hb hpq
    have hint : MeasureTheory.Integrable (fun v : ℝ => Real.exp (-b * (v - m) ^ 2)) :=
      (integrable_exp_neg_mul_sq hb).comp_sub_right m
    rw [intervalIntegral.integral_of_le hpq]
    calc ∫ v in Set.Ioc p q, Real.exp (-b * (v - m) ^ 2)
        ≤ ∫ v, Real.exp (-b * (v - m) ^ 2) :=
          MeasureTheory.setIntegral_le_integral hint
            (Filter.Eventually.of_forall fun v => (Real.exp_pos _).le)
      _ = ∫ v, Real.exp (-b * v ^ 2) :=
          MeasureTheory.integral_sub_right_eq_self (fun v => Real.exp (-b * v ^ 2)) m
      _ = Real.sqrt (Real.pi / b) := integral_gaussian b

  have gB : ∀ (b m p q : ℝ), 0 < b → p ≤ m → m ≤ q →
      ∫ v in p..q, |v - m| * Real.exp (-b * (v - m) ^ 2) ≤ 1 / b := by
    intro b m p q hb hpm hmq
    have hderiv : ∀ v, HasDerivAt (fun v => Real.exp (-b * (v - m) ^ 2) / (2 * b))
        ((m - v) * Real.exp (-b * (v - m) ^ 2)) v := by
      intro v
      have h1 : HasDerivAt (fun v => -b * (v - m) ^ 2) (-b * (2 * (v - m))) v := by
        have hl : HasDerivAt (fun v : ℝ => v - m) 1 v := (hasDerivAt_id' v).sub_const m
        have h0 := (hl.mul hl).const_mul (-b)
        convert h0 using 1
        · funext y; simp only [Pi.mul_apply]; ring
        · ring
      have h2 := (h1.exp).div_const (2 * b)
      convert h2 using 1
      field_simp
      ring
    have hcont : Continuous (fun v => |v - m| * Real.exp (-b * (v - m) ^ 2)) := by fun_prop
    have hc2 : Continuous (fun v => (m - v) * Real.exp (-b * (v - m) ^ 2)) := by fun_prop
    rw [← intervalIntegral.integral_add_adjacent_intervals (hcont.intervalIntegrable p m)
      (hcont.intervalIntegrable m q)]
    have e1 : ∫ v in p..m, |v - m| * Real.exp (-b * (v - m) ^ 2) =
        ∫ v in p..m, (m - v) * Real.exp (-b * (v - m) ^ 2) := by
      apply intervalIntegral.integral_congr
      intro v hv
      rw [Set.uIcc_of_le hpm] at hv
      show |v - m| * Real.exp (-b * (v - m) ^ 2) = (m - v) * Real.exp (-b * (v - m) ^ 2)
      rw [abs_of_nonpos (by linarith [hv.2]), neg_sub]
    have e2 : ∫ v in m..q, |v - m| * Real.exp (-b * (v - m) ^ 2) =
        -∫ v in m..q, (m - v) * Real.exp (-b * (v - m) ^ 2) := by
      rw [← intervalIntegral.integral_neg]
      apply intervalIntegral.integral_congr
      intro v hv
      rw [Set.uIcc_of_le hmq] at hv
      show |v - m| * Real.exp (-b * (v - m) ^ 2) = -((m - v) * Real.exp (-b * (v - m) ^ 2))
      rw [abs_of_nonneg (by linarith [hv.1])]
      ring
    rw [e1, e2, intervalIntegral.integral_eq_sub_of_hasDerivAt (fun v _ => hderiv v) (hc2.intervalIntegrable _ _),
      intervalIntegral.integral_eq_sub_of_hasDerivAt (fun v _ => hderiv v) (hc2.intervalIntegrable _ _)]
    have hGm : Real.exp (-b * (m - m) ^ 2) / (2 * b) = 1 / (2 * b) := by simp
    have hGp : 0 ≤ Real.exp (-b * (p - m) ^ 2) / (2 * b) := by positivity
    have hGq : 0 ≤ Real.exp (-b * (q - m) ^ 2) / (2 * b) := by positivity
    have h2 : 1 / (2 * b) + 1 / (2 * b) = 1 / b := by field_simp; ring
    linarith

  have hL0 : 0 < L := by linarith
  have ha1 : 0 < a1 := by linarith
  have h25 : Real.sqrt 25 = 5 := by
    rw [show (25:ℝ) = 5 ^ 2 by norm_num]
    exact Real.sqrt_sq (by norm_num)
  set sL := Real.sqrt L with hsL
  have hsL5 : 5 ≤ sL := by
    rw [← h25]
    exact Real.sqrt_le_sqrt hL
  have hsLsq : sL ^ 2 = L := Real.sq_sqrt hL0.le
  have hsLL : sL ≤ L / 5 := by
    have h := mul_le_mul_of_nonneg_left hsL5 (by linarith : (0:ℝ) ≤ sL)
    have e : sL * sL = L := by rw [← sq]; exact hsLsq
    linarith

  have hψ01 : ∀ v, 0 ≤ psiT L v ∧ psiT L v ≤ 1 := fun v =>
    ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩
  have hψ1 : ∀ v, |v - L/2| ≤ L/5 → psiT L v = 1 := by
    intro v hv
    unfold psiT
    apply Real.smoothTransition.one_of_one_le
    rw [le_div_iff₀ (by linarith)]
    linarith

  have hψc : Continuous (fun v => psiT L v) := by
    unfold psiT; exact Real.smoothTransition.continuous.comp (by fun_prop)
  have cf : ContinuousOn (fun v => psiT L v ^ 2 * x v ^ 2) (Set.Icc 0 L) :=
    (hψc.continuousOn.pow 2).mul (hx.pow 2)
  have cg : ContinuousOn (fun v => psiT L v ^ 2 * x v ^ 2 * |v - L/2|) (Set.Icc 0 L) :=
    cf.mul (continuous_abs.comp (continuous_id.sub continuous_const)).continuousOn
  have If : IntervalIntegrable (fun v => psiT L v ^ 2 * x v ^ 2) MeasureTheory.volume 0 L :=
    cf.intervalIntegrable_of_Icc hL0.le
  have Ig : IntervalIntegrable (fun v => psiT L v ^ 2 * x v ^ 2 * |v - L/2|) MeasureTheory.volume 0 L :=
    cg.intervalIntegrable_of_Icc hL0.le

  set b := 2 * a2 / L with hb
  have hbpos : 0 < b := by rw [hb]; positivity
  have hpt : ∀ v ∈ Set.Icc 0 L, psiT L v ^ 2 * x v ^ 2 ≤ C1 ^ 2 * Real.exp (-b * (v - L/2) ^ 2) := by
    intro v hv
    obtain ⟨h1, h2⟩ := henv v hv
    have hx0 : 0 ≤ x v := le_trans (mul_pos hc1 (Real.exp_pos _)).le h1
    have hsq : x v ^ 2 ≤ (C1 * Real.exp (-a2 * (v - L/2)^2 / L)) ^ 2 := pow_le_pow_left₀ hx0 h2 2
    have he : (C1 * Real.exp (-a2 * (v - L/2)^2 / L)) ^ 2 = C1 ^ 2 * Real.exp (-b * (v - L/2) ^ 2) := by
      rw [mul_pow, sq (Real.exp _), ← Real.exp_add]
      congr 2
      rw [hb]; ring
    have hψ2 : psiT L v ^ 2 ≤ 1 := pow_le_one₀ (hψ01 v).1 (hψ01 v).2
    calc psiT L v ^ 2 * x v ^ 2 ≤ 1 * x v ^ 2 := mul_le_mul_of_nonneg_right hψ2 (sq_nonneg _)
      _ = x v ^ 2 := one_mul _
      _ ≤ _ := hsq.trans he.le

  have hII : ∫ v in (0:ℝ)..L, psiT L v ^ 2 * x v ^ 2 ≤
      C1 ^ 2 * Real.sqrt (Real.pi / (2 * a2)) * sL := by
    have h1 : ∫ v in (0:ℝ)..L, psiT L v ^ 2 * x v ^ 2 ≤
        ∫ v in (0:ℝ)..L, C1 ^ 2 * Real.exp (-b * (v - L/2) ^ 2) :=
      intervalIntegral.integral_mono_on hL0.le If (by apply Continuous.intervalIntegrable; fun_prop) hpt
    rw [intervalIntegral.integral_const_mul] at h1
    have h2 := gA b (L/2) 0 L hbpos hL0.le
    have h3 : Real.sqrt (Real.pi / b) = Real.sqrt (Real.pi / (2 * a2)) * sL := by
      rw [hsL, ← Real.sqrt_mul (by positivity)]
      congr 1
      rw [hb]; field_simp
    calc _ ≤ _ := h1
      _ ≤ C1 ^ 2 * Real.sqrt (Real.pi / b) := mul_le_mul_of_nonneg_left h2 (sq_nonneg _)
      _ = _ := by rw [h3]; ring

  have hIII : ∫ v in (0:ℝ)..L, psiT L v ^ 2 * x v ^ 2 * |v - L/2| ≤ C1 ^ 2 / (2 * a2) * L := by
    have h1 : ∫ v in (0:ℝ)..L, psiT L v ^ 2 * x v ^ 2 * |v - L/2| ≤
        ∫ v in (0:ℝ)..L, C1 ^ 2 * (|v - L/2| * Real.exp (-b * (v - L/2) ^ 2)) := by
      apply intervalIntegral.integral_mono_on hL0.le Ig (by apply Continuous.intervalIntegrable; fun_prop)
      intro v hv
      have := mul_le_mul_of_nonneg_right (hpt v hv) (abs_nonneg (v - L/2))
      calc _ ≤ _ := this
        _ = _ := by ring
    rw [intervalIntegral.integral_const_mul] at h1
    have h2 := gB b (L/2) 0 L hbpos (by linarith) (by linarith)
    have h3 : C1 ^ 2 * (1 / b) = C1 ^ 2 / (2 * a2) * L := by
      rw [hb]; field_simp
    calc _ ≤ _ := h1
      _ ≤ C1 ^ 2 * (1 / b) := mul_le_mul_of_nonneg_left h2 (sq_nonneg _)
      _ = _ := h3

  have hI : 2 * c1 ^ 2 * Real.exp (-2 * a1) * sL ≤ ∫ v in (0:ℝ)..L, psiT L v ^ 2 * x v ^ 2 := by
    have hα : 0 ≤ L/2 - sL := by linarith
    have hαβ : L/2 - sL ≤ L/2 + sL := by linarith
    have hβ : L/2 + sL ≤ L := by linarith
    have hmono : ∫ v in (L/2 - sL)..(L/2 + sL), psiT L v ^ 2 * x v ^ 2 ≤
        ∫ v in (0:ℝ)..L, psiT L v ^ 2 * x v ^ 2 :=
      intervalIntegral.integral_mono_interval hα hαβ hβ
        (Filter.Eventually.of_forall fun v => by
          show (0:ℝ) ≤ psiT L v ^ 2 * x v ^ 2
          positivity) If
    have hlow : ∀ v ∈ Set.Icc (L/2 - sL) (L/2 + sL),
        c1 ^ 2 * Real.exp (-2 * a1) ≤ psiT L v ^ 2 * x v ^ 2 := by
      intro v hv
      have hv0 : v ∈ Set.Icc 0 L := ⟨by linarith [hv.1], by linarith [hv.2]⟩
      have habs : |v - L/2| ≤ sL := abs_le.mpr ⟨by linarith [hv.1], by linarith [hv.2]⟩
      rw [hψ1 v (habs.trans hsLL)]
      have hsq : (v - L/2) ^ 2 ≤ L := by
        have h := pow_le_pow_left₀ (abs_nonneg _) habs 2
        rw [sq_abs] at h
        linarith
      have hexp : -a1 ≤ -a1 * (v - L/2) ^ 2 / L := by
        rw [le_div_iff₀ hL0]
        have := mul_le_mul_of_nonneg_left hsq ha1.le
        linarith
      have hxl : c1 * Real.exp (-a1) ≤ x v :=
        le_trans (mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hexp) hc1.le) (henv v hv0).1
      have h0 : 0 ≤ c1 * Real.exp (-a1) := by positivity
      have hsq2 := pow_le_pow_left₀ h0 hxl 2
      have he : (c1 * Real.exp (-a1)) ^ 2 = c1 ^ 2 * Real.exp (-2 * a1) := by
        rw [mul_pow, sq (Real.exp _), ← Real.exp_add, show -a1 + -a1 = -2 * a1 by ring]
      rw [one_pow, one_mul, ← he]
      exact hsq2
    have hwin : ∫ v in (L/2 - sL)..(L/2 + sL), c1 ^ 2 * Real.exp (-2 * a1) ≤
        ∫ v in (L/2 - sL)..(L/2 + sL), psiT L v ^ 2 * x v ^ 2 :=
      intervalIntegral.integral_mono_on hαβ
        (intervalIntegrable_const (μ := MeasureTheory.volume))
        ((cf.mono (Set.Icc_subset_Icc hα hβ)).intervalIntegrable_of_Icc hαβ) hlow
    rw [intervalIntegral.integral_const, smul_eq_mul] at hwin
    have e : (L/2 + sL - (L/2 - sL)) * (c1 ^ 2 * Real.exp (-2 * a1)) =
        2 * c1 ^ 2 * Real.exp (-2 * a1) * sL := by ring
    linarith
  exact ⟨hI, hII, hIII⟩

theorem pulse5_columns : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ (l : ℕ) (c C : ℝ), 0 < c ∧
    ∀ (γ : Lab) (ξ : Cyl), l ≤ γ.1 → ActiveL4 B G γ → ξ ∈ DomC B.h B.qB → etaL B.h γ ξ ≠ 0 →
      ∀ σ : Bool, ∃ (hσ : ℝ) (e : ℝ × ℝ), c / Real.sqrt (Sb γ.1) ≤ hσ ∧ hσ ≤ C / Real.sqrt (Sb γ.1) ∧
        eN e ≤ C / Real.sqrt (Sb γ.1) ∧
        Hcol B G (γ.1, γ.2.1, σ) (ξ.1, ξ.2.1, ξ.2.2.1) =
          hσ • ((c0f5 B G γ * Real.sqrt (1 + G.ustar ^ 2)) • Nfr5 B G γ - (sgn σ * G.ustar) • Kfr5 B G γ + e) :=
by
  intro B G hB hG
  obtain ⟨cf, Cf, hcf, hFr⟩ := frame5_consts B G hB hG
  obtain ⟨l1, a1, a2, c1, C1, Ct, Cw, ha2, ha12, hc1, hc1C, hCt, hCw, hPT⟩ :=
    pulse5_profile_track B G hB hG
  have hr0 : 0 < G.r0 := hG.1.1
  have hu : 0 < G.ustar := hG.1.2.2.1
  have hh0 : 0 < B.h := hB.2.1.1
  have hh1 : B.h < 1 / 100 := hB.2.1.2.1
  obtain ⟨-, -, hJ0, -⟩ := pulse5_scale_consts B.h G.r0 1 hh0 hh1 hr0 le_rfl
  have hTgc : 0 < Tgc := by unfold Tgc; positivity
  obtain ⟨P, hP⟩ : ∃ P, P = (1 + bgc ^ 2) / 2 * ∫ u in (-G.r0)..G.r0, chig G.r0 u ^ 2 := ⟨_, rfl⟩
  have hP0 : 0 < P := by rw [hP]; exact mul_pos (by positivity) hJ0
  obtain ⟨k1, hk1⟩ : ∃ k, k = 2 * c1 ^ 2 * Real.exp (-2 * a1) := ⟨_, rfl⟩
  obtain ⟨k2, hk2⟩ : ∃ k, k = C1 ^ 2 * Real.sqrt (Real.pi / (2 * a2)) := ⟨_, rfl⟩
  obtain ⟨k3, hk3⟩ : ∃ k, k = C1 ^ 2 / (2 * a2) := ⟨_, rfl⟩
  have hk1p : 0 < k1 := by rw [hk1]; exact mul_pos (mul_pos two_pos (pow_pos hc1 2)) (Real.exp_pos _)
  have hk2p : 0 ≤ k2 := by rw [hk2]; exact mul_nonneg (sq_nonneg _) (Real.sqrt_nonneg _)
  have hk3p : 0 ≤ k3 := by rw [hk3]; exact div_nonneg (sq_nonneg _) (by linarith)
  obtain ⟨Ke, hKe⟩ : ∃ k, k = Cw * k3 / k1 := ⟨_, rfl⟩
