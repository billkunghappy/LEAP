  have hLv : Lnorm B.h ξ wv = ((0:ℝ), (0:ℝ), (0:ℝ), vrv) := by
    rw [hwvdef, hLapp]
    simp only [mul_zero]
    rw [hJr, ← zpow_add₀ hL0.ne', add_neg_cancel, zpow_zero, one_smul]
  have hwz : ‖wz‖ ≤ 2 := by
    have hq12 : q ^ (1/2:ℝ) ≤ q ^ (1/2 - B.h) :=
      (Real.rpow_le_rpow_left_iff_of_base_lt_one hq0 hq1).2 (by linarith)
    have hx0 : 0 ≤ (q ^ (1/2 - B.h))⁻¹ * sQ := mul_nonneg (inv_nonneg.2 hqe.le) hsQ0
    have hx : (q ^ (1/2 - B.h))⁻¹ * sQ ≤ 2 := by
      rw [inv_mul_le_iff₀ hqe]; linarith
    rw [hwzdef]
    simp only [norm_prod_le_iff, norm_zero, Real.norm_eq_abs, abs_of_nonneg hx0]
    exact ⟨by norm_num, hx, by norm_num, by norm_num⟩
  have hwr : ‖wr‖ ≤ 2 := by
    have hx0 : 0 ≤ (Real.sqrt q)⁻¹ * sQ := mul_nonneg (inv_nonneg.2 hsqpos.le) hsQ0
    have hx : (Real.sqrt q)⁻¹ * sQ ≤ 2 := by
      rw [inv_mul_le_iff₀ hsqpos]; linarith
    rw [hwrdef]
    simp only [norm_prod_le_iff, norm_zero, Real.norm_eq_abs, abs_of_nonneg hx0]
    exact ⟨hx, by norm_num, by norm_num, by norm_num⟩
  have hwv : ‖wv‖ ≤ Lgc ^ (coarseIdx B.h q) := by
    rw [hwvdef]
    simp only [norm_prod_le_iff, norm_zero, Real.norm_eq_abs, vrv, Prod.smul_mk, smul_eq_mul,
      mul_one, mul_neg, abs_neg, abs_mul, abs_of_pos hLc0, abs_of_pos hb0]
    refine ⟨hLc0.le, hLc0.le, hLc0.le, le_rfl, ?_⟩
    nlinarith

  have hdZ : ∀ (f : Cyl → ℂ) (η : Cyl), DzC B γ.1 f η = fderiv ℝ f η (Lnorm B.h ξ wz) := by
    intro f η
    simp only [DzC, dZ]
    rw [← hsQ, hLz, map_smul]
  have hdR : ∀ (f : Cyl → ℂ) (η : Cyl), DrC B γ.1 f η = fderiv ℝ f η (Lnorm B.h ξ wr) +
      ((sQ * drx B.h) * η.1 ^ (drx B.h - 1)) • fderiv ℝ f η (Lnorm B.h ξ wv) := by
    intro f η
    have hsplit : ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * η.1 ^ (drx B.h - 1)) • vrv) =
        ((1:ℝ), (0:ℝ), (0:ℝ), (0 : ℝ × ℝ)) +
          (drx B.h * η.1 ^ (drx B.h - 1)) • ((0:ℝ), (0:ℝ), (0:ℝ), vrv) := by
      simp only [Prod.smul_mk, smul_zero, Prod.mk_add_mk, add_zero, zero_add]
    simp only [DrC, dR]
    rw [← hsQ, hsplit, hLr, hLv]
    (simp only [map_add, map_smul, smul_add, smul_smul, mul_assoc]) <;> rfl
  have e0 : (fun η => velRem5 B D γ m η 0) =
      fun η => -(fderiv ℝ (fun η => D γ m η 1) η (Lnorm B.h ξ wz)) := by
    funext η
    show -(DzC B γ.1 (fun η => D γ m η 1) η) = _
    rw [hdZ]
  have e1 : (fun η => velRem5 B D γ m η 1) =
      fun η => fderiv ℝ (fun η => D γ m η 0) η (Lnorm B.h ξ wz) +
        (-(fderiv ℝ (fun η => D γ m η 2) η (Lnorm B.h ξ wr)) +
          (-(sQ * drx B.h) * η.1 ^ (drx B.h - 1)) •
            fderiv ℝ (fun η => D γ m η 2) η (Lnorm B.h ξ wv)) := by
    funext η
    show DzC B γ.1 (fun η => D γ m η 0) η - DrC B γ.1 (fun η => D γ m η 2) η = _
    rw [hdZ, hdR, neg_mul, neg_smul]
    abel
  have e2 : (fun η => velRem5 B D γ m η 2) =
      fun η => (fderiv ℝ (fun η => D γ m η 1) η (Lnorm B.h ξ wr) +
          ((sQ * drx B.h) * η.1 ^ (drx B.h - 1)) •
            fderiv ℝ (fun η => D γ m η 1) η (Lnorm B.h ξ wv)) +
        (sQ * η.1 ^ (-1:ℝ)) • D γ m η 1 := by
    funext η
    show DrC B γ.1 (fun η => D γ m η 1) η + D γ m η 1 / ((RC γ.1 η : ℝ) : ℂ) = _
    rw [hdR]
    congr 1
    rw [Complex.real_smul, Real.rpow_neg_one]
    simp only [RC]
    rw [← hsQ]
    push_cast
    rw [div_div_eq_mul_div]
    ring

  have hdir2 : ∀ (i : Fin 3) (w : Cyl), ‖w‖ ≤ 2 →
      NB B.h (fun η => fderiv ℝ (fun η => D γ m η i) η (Lnorm B.h ξ w)) k ξ ≤ 2 * S := by
    intro i w hw
    exact (nbdir _ ξ _ w hU hξU (hfi i) k).trans
      (mul_le_mul hw (hNBf i (k + 1) le_rfl) (nbnn _ _ _) (by norm_num))
  have hVel : ∀ (c : ℝ) (i : Fin 3), |c| = sQ * |drx B.h| →
      NB B.h (fun η => (c * η.1 ^ (drx B.h - 1)) •
        fderiv ℝ (fun η => D γ m η i) η (Lnorm B.h ξ wv)) k ξ ≤ Kv * E * S := by
    intro c i hc
    refine le_trans (leibS _ hU (fun η => c * η.1 ^ (drx B.h - 1))
      (fun η => fderiv ℝ (fun η => D γ m η i) η (Lnorm B.h ξ wv)) (hradS _ _) (hdirS i _)
      ξ hξU k) ?_
    rw [hKv, Finset.sum_mul, Finset.sum_mul]
    apply Finset.sum_le_sum
    intro j hj
    have hjk : j ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
    have hA := radial c (drx B.h - 1) ξ j hr
    rw [hc] at hA
    have hG : NB B.h (fun η => fderiv ℝ (fun η => D γ m η i) η (Lnorm B.h ξ wv)) (k - j) ξ ≤
        Lgc ^ (coarseIdx B.h q) * S :=
      (nbdir _ ξ _ wv hU hξU (hfi i) (k - j)).trans
        (mul_le_mul hwv (hNBf i (k - j + 1) (by omega)) (nbnn _ _ _) hLc0.le)
    have hsc' := hsc (drx B.h - 1) j
    rw [show (drx B.h - 1 + 1) / 2 = drx B.h / 2 by ring] at hsc'
    have hco := hcoarse q hq0 hq1.le
    rw [← hEdef] at hco
    have hC0 : (0:ℝ) ≤ (k.choose j : ℝ) := by positivity
    have hP0 : 0 ≤ (k.choose j : ℝ) * |drx B.h| *
        |Polynomial.eval (drx B.h - 1) (descPochhammer ℝ j)| := by positivity
    have hM0 := hMnn ((drx B.h - 1 - (j:ℝ)) / 2)
    calc (k.choose j : ℝ) * NB B.h (fun η : Cyl => c * η.1 ^ (drx B.h - 1)) j ξ *
          NB B.h (fun η => fderiv ℝ (fun η => D γ m η i) η (Lnorm B.h ξ wv)) (k - j) ξ
        ≤ (k.choose j : ℝ) * (sQ * |drx B.h| *
            |Polynomial.eval (drx B.h - 1) (descPochhammer ℝ j)| *
            ξ.1 ^ (drx B.h - 1 - (j:ℝ)) * Real.sqrt (qC B.h ξ) ^ j) *
            (Lgc ^ (coarseIdx B.h q) * S) :=
          mul_le_mul (mul_le_mul_of_nonneg_left hA hC0) hG (nbnn _ _ _)
            (mul_nonneg hC0 (le_trans (nbnn _ _ _) hA))
      _ = (k.choose j : ℝ) * |drx B.h| * |Polynomial.eval (drx B.h - 1) (descPochhammer ℝ j)| *
            (sQ * ξ.1 ^ (drx B.h - 1 - (j:ℝ)) * Real.sqrt q ^ j) *
            Lgc ^ (coarseIdx B.h q) * S := by rw [← hqdef]; ring
      _ ≤ (k.choose j : ℝ) * |drx B.h| * |Polynomial.eval (drx B.h - 1) (descPochhammer ℝ j)| *
            (2 * ((2 * B.Xa) ^ ((drx B.h - 1 - (j:ℝ)) / 2) +
              (2 * B.Xb) ^ ((drx B.h - 1 - (j:ℝ)) / 2)) * q ^ (drx B.h / 2)) *
            Lgc ^ (coarseIdx B.h q) * S :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hsc' hP0) hLc0.le) hS0
      _ = (k.choose j : ℝ) * |drx B.h| * |Polynomial.eval (drx B.h - 1) (descPochhammer ℝ j)| *
            2 * ((2 * B.Xa) ^ ((drx B.h - 1 - (j:ℝ)) / 2) +
              (2 * B.Xb) ^ ((drx B.h - 1 - (j:ℝ)) / 2)) *
            (q ^ (drx B.h / 2) * Lgc ^ (coarseIdx B.h q)) * S := by ring
      _ ≤ (k.choose j : ℝ) * |drx B.h| * |Polynomial.eval (drx B.h - 1) (descPochhammer ℝ j)| *
            2 * ((2 * B.Xa) ^ ((drx B.h - 1 - (j:ℝ)) / 2) +
              (2 * B.Xb) ^ ((drx B.h - 1 - (j:ℝ)) / 2)) * E * S :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hco
            (mul_nonneg (mul_nonneg hP0 zero_le_two) hM0)) hS0
      _ = _ := by ring
  have hPot : NB B.h (fun η => (sQ * η.1 ^ (-1:ℝ)) • D γ m η 1) k ξ ≤ Kp * S := by
    refine le_trans (leibS _ hU (fun η => sQ * η.1 ^ (-1:ℝ)) (fun η => D γ m η 1) (hradS _ _)
      (hfi 1) ξ hξU k) ?_
    rw [hKp, Finset.sum_mul]
    apply Finset.sum_le_sum
    intro j hj
    have hjk : j ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
    have hA := radial sQ (-1) ξ j hr
    rw [abs_of_nonneg hsQ0] at hA
    have hsc' := hsc (-1) j
    rw [show ((-1:ℝ) + 1) / 2 = 0 by norm_num, Real.rpow_zero, mul_one] at hsc'
    have hC0 : (0:ℝ) ≤ (k.choose j : ℝ) := by positivity
    have hP0 : 0 ≤ (k.choose j : ℝ) * |Polynomial.eval (-1) (descPochhammer ℝ j)| := by positivity
    calc (k.choose j : ℝ) * NB B.h (fun η : Cyl => sQ * η.1 ^ (-1:ℝ)) j ξ *
          NB B.h (fun η => D γ m η 1) (k - j) ξ
        ≤ (k.choose j : ℝ) * (sQ * |Polynomial.eval (-1) (descPochhammer ℝ j)| *
            ξ.1 ^ ((-1:ℝ) - (j:ℝ)) * Real.sqrt (qC B.h ξ) ^ j) * S :=
          mul_le_mul (mul_le_mul_of_nonneg_left hA hC0) (hNBf 1 (k - j) (by omega)) (nbnn _ _ _)
            (mul_nonneg hC0 (le_trans (nbnn _ _ _) hA))
      _ = (k.choose j : ℝ) * |Polynomial.eval (-1) (descPochhammer ℝ j)| *
            (sQ * ξ.1 ^ ((-1:ℝ) - (j:ℝ)) * Real.sqrt q ^ j) * S := by rw [← hqdef]; ring
      _ ≤ (k.choose j : ℝ) * |Polynomial.eval (-1) (descPochhammer ℝ j)| *
            (2 * ((2 * B.Xa) ^ (((-1:ℝ) - (j:ℝ)) / 2) + (2 * B.Xb) ^ (((-1:ℝ) - (j:ℝ)) / 2))) * S :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hsc' hP0) hS0
      _ = _ := by ring

  have hVat : ContDiffAt ℝ ∞ (velRem5 B D γ m) ξ := hV.contDiffAt hUn
  have hc := comp (velRem5 B D γ m) ξ k hVat
  simp only [Fin.sum_univ_three] at hc
  rw [e0, e1, e2] at hc
  have cA : ∀ (i : Fin 3) (w : Cyl),
      ContDiffAt ℝ ∞ (fun η => fderiv ℝ (fun η => D γ m η i) η w) ξ :=
    fun i w => (hdirS i w).contDiffAt hUn
  have cN : ∀ (i : Fin 3) (w : Cyl),
      ContDiffAt ℝ ∞ (fun η => -(fderiv ℝ (fun η => D γ m η i) η w)) ξ :=
    fun i w => ((hdirS i w).neg).contDiffAt hUn
  have cS : ∀ (c p : ℝ) (i : Fin 3) (w : Cyl),
      ContDiffAt ℝ ∞ (fun η => (c * η.1 ^ p) • fderiv ℝ (fun η => D γ m η i) η w) ξ :=
    fun c p i w => ((hradS c p).smul (hdirS i w)).contDiffAt hUn
  have cP : ContDiffAt ℝ ∞ (fun η => (sQ * η.1 ^ (-1:ℝ)) • D γ m η 1) ξ :=
    ((hradS _ _).smul (hfi 1)).contDiffAt hUn
  have habs1 : |-(sQ * drx B.h)| = sQ * |drx B.h| := by
    rw [abs_neg, abs_mul, abs_of_nonneg hsQ0]
  have habs2 : |sQ * drx B.h| = sQ * |drx B.h| := by
    rw [abs_mul, abs_of_nonneg hsQ0]
  have b0 : NB B.h (fun η => -(fderiv ℝ (fun η => D γ m η 1) η (Lnorm B.h ξ wz))) k ξ ≤ 2 * S :=
    (nbneg (fun η => fderiv ℝ (fun η => D γ m η 1) η (Lnorm B.h ξ wz)) ξ k).le.trans
      (hdir2 1 wz hwz)
  have b1 : NB B.h (fun η => fderiv ℝ (fun η => D γ m η 0) η (Lnorm B.h ξ wz) +
        (-(fderiv ℝ (fun η => D γ m η 2) η (Lnorm B.h ξ wr)) +
          (-(sQ * drx B.h) * η.1 ^ (drx B.h - 1)) •
            fderiv ℝ (fun η => D γ m η 2) η (Lnorm B.h ξ wv))) k ξ ≤
      2 * S + (2 * S + Kv * E * S) := by
    refine le_trans (nbadd _ _ ξ k (cA 0 _) ((cN 2 _).add (cS _ _ 2 _))) ?_
    refine add_le_add (hdir2 0 wz hwz) ?_
    refine le_trans (nbadd _ _ ξ k (cN 2 _) (cS _ _ 2 _)) ?_
    refine add_le_add ?_ (hVel _ 2 habs1)
    exact (nbneg (fun η => fderiv ℝ (fun η => D γ m η 2) η (Lnorm B.h ξ wr)) ξ k).le.trans
      (hdir2 2 wr hwr)
  have b2 : NB B.h (fun η => (fderiv ℝ (fun η => D γ m η 1) η (Lnorm B.h ξ wr) +
          ((sQ * drx B.h) * η.1 ^ (drx B.h - 1)) •
            fderiv ℝ (fun η => D γ m η 1) η (Lnorm B.h ξ wv)) +
        (sQ * η.1 ^ (-1:ℝ)) • D γ m η 1) k ξ ≤
      (2 * S + Kv * E * S) + Kp * S := by
    refine le_trans (nbadd _ _ ξ k ((cA 1 _).add (cS _ _ 1 _)) cP) ?_
    refine add_le_add ?_ hPot
    refine le_trans (nbadd _ _ ξ k (cA 1 _) (cS _ _ 1 _)) ?_
    exact add_le_add (hdir2 1 wr hwr) (hVel _ 1 habs2)
  rw [← hqdef, ← hEdef, ← hSdef]
  have hfin : NB B.h (velRem5 B D γ m) k ξ ≤ 8 * S + 2 * (Kv * E * S) + Kp * S := by
    linarith
  nlinarith [mul_nonneg hS0 (sub_nonneg.2 hE1), mul_nonneg (mul_nonneg hKp0 hS0) (sub_nonneg.2 hE1)]

theorem velRem5_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (β : ℝ) (D : WC), InWg5 B G (qsOf l0) β D → InWg5 B G (qsOf l0) (β - kapS) (velRem5 B D) :=
by
  intro B G hok hG
  obtain ⟨ls, hls⟩ := pulse_support_good_v5 B G hok hG
  refine ⟨ls + 7, ?_⟩
  intro l0 hl0 β D hD

  have hq128 : qsOf l0 ≤ 1/128 := by
    have h7 : (7:ℝ) ≤ (l0:ℝ) := by exact_mod_cast (by omega : 7 ≤ l0)
    have h1 : (2:ℝ) ^ (-(l0:ℝ)) ≤ (2:ℝ) ^ (-(7:ℝ)) :=
      Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
    have h2 : (2:ℝ) ^ (-(7:ℝ)) = 1/128 := by
      rw [Real.rpow_neg (by norm_num), show (7:ℝ) = ((7:ℕ):ℝ) by norm_num, Real.rpow_natCast]
      norm_num
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1/128
    exact h1.trans h2.le

  have germ : ∀ (γ : Lab) (m : ℤ) (ξ : Cyl), ξ ∉ tsupport (D γ m) →
      velRem5 B D γ m =ᶠ[nhds ξ] fun _ => (0 : Fin 3 → ℂ) := by
    intro γ m ξ hξ
    have h0 : D γ m =ᶠ[nhds ξ] 0 := notMem_tsupport_iff_eventuallyEq.mp hξ
    filter_upwards [h0.eventuallyEq_nhds] with η hη
    have hi : ∀ i : Fin 3, (fun η' => D γ m η' i) =ᶠ[nhds η] fun _ => (0:ℂ) :=
      fun i => hη.mono (fun x hx => by simp [hx])
    have hD0 : D γ m η = 0 := hη.eq_of_nhds
    have hf : ∀ i : Fin 3, fderiv ℝ (fun η' => D γ m η' i) η = 0 := fun i => by
      rw [(hi i).fderiv_eq]; simp
    funext j
    fin_cases j <;> simp [velRem5, DzC, DrC, dZ, dR, hf, hD0]
  have hDopenξ : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 ∧ 1 ≤ SC B.h ξ := by
    intro ξ hξ
    obtain ⟨-, e2, e3⟩ := hξ
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    refine ⟨hq0, by linarith, ?_⟩
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hEdge : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 < edgeDist B.Xa B.Xb X ∧ edgeDist B.Xa B.Xb X ≤ 1 := by
    intro X e1 e2
    refine ⟨?_, min_le_left _ _⟩
    have hX : 0 < X := lt_trans hXa e1
    have l1 : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr e1)
    have l2 : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX).mpr e2)
    exact lt_min one_pos (lt_min l1 l2)
  obtain ⟨H, H0, Hv⟩ := hD.1
  refine ⟨⟨H, H0, fun γ m hm => ?_⟩, fun γ m => velRem5_contDiffOn_v5 B (qsOf l0) D γ m hok (hD.2.1 γ m),
    velRem5_deck_invariant_v5 B l0 D hok (by omega) hD.2.2.1, ?_, ?_⟩
  ·
    funext ξ
    have hξ : ξ ∉ tsupport (D γ m) := by simp [Hv γ m hm]
    exact (germ γ m ξ hξ).eq_of_nhds
  ·
    intro γ m ξ hξ hne
    have hts : ξ ∈ tsupport (D γ m) := by
      by_contra hc
      exact hne ((germ γ m ξ hc).eq_of_nhds)
    exact (hls l0 (by omega) β D hD γ m ξ hξ hts).1
  ·
    intro k
    obtain ⟨K, hK⟩ := velRem5_nb_pointwise_v5 B hok k
    choose Cf bf df hCf using hD.2.2.2.2
    refine ⟨|K| * ∑ i ∈ Finset.range (k + 2), |Cf i|, ∑ i ∈ Finset.range (k + 2), |bf i|,
      ∑ i ∈ Finset.range (k + 2), |df i|, fun γ m ξ hξ hX1 hX2 => ?_⟩
    obtain ⟨hq0, hq1, hS1⟩ := hDopenξ ξ hξ
    obtain ⟨he0, he1⟩ := hEdge _ hX1 hX2
    obtain ⟨W, hW⟩ : ∃ W : ℝ, W = qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ (∑ i ∈ Finset.range (k + 2), |bf i|) *
        Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(∑ i ∈ Finset.range (k + 2), |df i|)) *
        Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := ⟨_, rfl⟩
    have hP : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
      unfold Penv5; exact (Real.exp_pos _).le
    have hqa : 0 ≤ qC B.h ξ ^ (B.h * β) := Real.rpow_nonneg hq0.le _
    have hsq : 0 ≤ Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) := Real.sqrt_nonneg _
    have hSb : 0 ≤ SC B.h ξ ^ (∑ i ∈ Finset.range (k + 2), |bf i|) := Real.rpow_nonneg (by linarith) _
    have hed : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(∑ i ∈ Finset.range (k + 2), |df i|)) :=
      Real.rpow_nonneg he0.le _
    have hW0 : 0 ≤ W := by
      rw [hW]
      exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hqa hSb) hsq) hed) hP
    have hNi : ∀ i ∈ Finset.range (k + 2), NB B.h (D γ m) i ξ ≤ |Cf i| * W := by
      intro i hi
      have hb : bf i ≤ ∑ j ∈ Finset.range (k + 2), |bf j| :=
        le_trans (le_abs_self _) (Finset.single_le_sum (fun j _ => abs_nonneg (bf j)) hi)
      have hd : df i ≤ ∑ j ∈ Finset.range (k + 2), |df j| :=
        le_trans (le_abs_self _) (Finset.single_le_sum (fun j _ => abs_nonneg (df j)) hi)
      have f2 : SC B.h ξ ^ bf i ≤ SC B.h ξ ^ (∑ j ∈ Finset.range (k + 2), |bf j|) :=
        Real.rpow_le_rpow_of_exponent_le hS1 hb
      have f3 : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df i) ≤
          edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(∑ j ∈ Finset.range (k + 2), |df j|)) :=
        Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hd)
      have p2 : 0 ≤ SC B.h ξ ^ bf i := Real.rpow_nonneg (by linarith) _
      have p3 : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df i) := Real.rpow_nonneg he0.le _
      have m1 := mul_le_mul_of_nonneg_left f2 hqa
      have m2 := mul_le_mul_of_nonneg_right m1 hsq
      have m3 := mul_le_mul m2 f3 p3 (mul_nonneg (mul_nonneg hqa hSb) hsq)
      have m4 := mul_le_mul_of_nonneg_right m3 hP
      have hnn : 0 ≤ qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ bf i *
          Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
          edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df i) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) :=
        mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hqa p2) hsq) p3) hP
      calc NB B.h (D γ m) i ξ
          ≤ Cf i * qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ bf i *
            Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df i) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) :=
            hCf i γ m ξ hξ hX1 hX2
        _ = Cf i * (qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ bf i *
            Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df i) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) := by
            ring
        _ ≤ |Cf i| * (qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ bf i *
            Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df i) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) :=
            mul_le_mul_of_nonneg_right (le_abs_self _) hnn
        _ ≤ |Cf i| * W := by
            rw [hW]
            exact mul_le_mul_of_nonneg_left m4 (abs_nonneg _)
    have hqk : 0 ≤ qC B.h ξ ^ (-(B.h * kapS)) := Real.rpow_nonneg hq0.le _
    have hpow : qC B.h ξ ^ (B.h * (β - kapS)) = qC B.h ξ ^ (-(B.h * kapS)) * qC B.h ξ ^ (B.h * β) := by
      rw [← Real.rpow_add hq0]; congr 1; ring
    have hRHS : (|K| * ∑ i ∈ Finset.range (k + 2), |Cf i|) * qC B.h ξ ^ (B.h * (β - kapS)) *
        SC B.h ξ ^ (∑ i ∈ Finset.range (k + 2), |bf i|) *
        Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(∑ i ∈ Finset.range (k + 2), |df i|)) *
        Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) =
        |K| * qC B.h ξ ^ (-(B.h * kapS)) * ((∑ i ∈ Finset.range (k + 2), |Cf i|) * W) := by
      rw [hpow, hW]; ring
    rw [hRHS]
    have hCs : 0 ≤ ∑ i ∈ Finset.range (k + 2), |Cf i| := Finset.sum_nonneg (fun i _ => abs_nonneg _)
    by_cases hts : ξ ∈ tsupport (D γ m)
    · obtain ⟨-, -, -, hr1, hr2, -⟩ := hls l0 (by omega) β D hD γ m ξ hξ hts
      have hmain := hK (qsOf l0) D γ m ξ hq128 (hD.2.1 γ m)
        (velRem5_contDiffOn_v5 B (qsOf l0) D γ m hok (hD.2.1 γ m)) hξ hr1 hr2 hX1 hX2
      have hsum : ∑ i ∈ Finset.range (k + 2), NB B.h (D γ m) i ξ ≤
          (∑ i ∈ Finset.range (k + 2), |Cf i|) * W := by
        rw [Finset.sum_mul]; exact Finset.sum_le_sum hNi
      have hsum0 : 0 ≤ ∑ i ∈ Finset.range (k + 2), NB B.h (D γ m) i ξ :=
        Finset.sum_nonneg (fun i _ => by unfold NB; exact norm_nonneg _)
      calc NB B.h (velRem5 B D γ m) k ξ
          ≤ K * qC B.h ξ ^ (-(B.h * kapS)) * ∑ i ∈ Finset.range (k + 2), NB B.h (D γ m) i ξ := hmain
        _ ≤ |K| * qC B.h ξ ^ (-(B.h * kapS)) * ∑ i ∈ Finset.range (k + 2), NB B.h (D γ m) i ξ :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_abs_self K) hqk) hsum0
        _ ≤ |K| * qC B.h ξ ^ (-(B.h * kapS)) * ((∑ i ∈ Finset.range (k + 2), |Cf i|) * W) :=
            mul_le_mul_of_nonneg_left hsum (mul_nonneg (abs_nonneg K) hqk)
    · have hev := germ γ m ξ hts
      have hz : NB B.h (velRem5 B D γ m) k ξ = 0 := by
        unfold NB
        rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_zero]
        have e : ((0 : Cyl → ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) (Fin 3 → ℂ)) ξ).compContinuousLinearMap
            (fun _ => Lnorm B.h ξ) = 0 := by
          ext v
          simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
        rw [e, norm_zero]
      rw [hz]
      exact mul_nonneg (mul_nonneg (abs_nonneg K) hqk) (mul_nonneg hCs hW0)

theorem wave_potential_transfer_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (lG : ℕ) (cG b0 : ℝ), 0 < cG → (∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (ξ : Cyl), lG ≤ γ.1 → ActiveL4 B G γ → etaL B.h γ ξ ≠ 0 → ξ ∈ DomC B.h B.qB → inRect B.h γ (G.ctr γ) G.r0 ξ.2.2.2 → B.Xa ≤ XC B.h ξ → XC B.h ξ ≤ B.Xb → cG * SC B.h ξ ^ (-b0) ≤ dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) ∧ (∀ i : Fin 3, NB B.h (fun η : Cyl => nPhi5 B G γ η i) k ξ ≤ C * SC B.h ξ ^ b ∧ NB B.h (fun η : Cyl => nPhiP5 B G γ η i) k ξ ≤ C * SC B.h ξ ^ b) ∧ (∀ i j : Fin 3, NB B.h (fun η : Cyl => Kmat B G γ η i j) k ξ ≤ C * SC B.h ξ ^ b) ∧ NB B.h (fun η : Cyl => (RC γ.1 η)⁻¹) k ξ ≤ C * SC B.h ξ ^ b ∧ NB B.h (fun η : Cyl => RC γ.1 η) k ξ ≤ C * SC B.h ξ ^ b) → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (c : Lab → Cyl → (Fin 3 → ℝ)) (α : ℝ), (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), c γ ξ ≠ 0 → ActiveL4 B G γ ∧ etaL B.h γ ξ ≠ 0 ∧ |xiG B.h γ (G.ctr γ) ξ.2.2.2| ≤ G.r0 / 4 ∧ |etG B.h γ (G.ctr γ) ξ.2.2.2| ≤ 2 * G.r0 / 3) → (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), dotProduct (nPhi5 B G γ ξ) (c γ ξ) = 0) → InWg5 B G (qsOf l0) α (fun γ m ξ => if m = 1 ∨ m = -1 then (fun i => ((c γ ξ i : ℝ) : ℂ)) else 0) → InWg5 B G (qsOf l0) (α + 1/2) (potW5 B G c) ∧ InWg5 B G (qsOf l0) α (velW5 B G (potW5 B G c)) ∧ InWg5 B G (qsOf l0) (α + 1/2 - kapS) (velW5 B G (potW5 B G c) - (fun γ m ξ => if m = 1 ∨ m = -1 then (fun i => ((c γ ξ i : ℝ) : ℂ)) else 0)) ∧ InWg5 B G (qsOf l0) (α + 1/2) (presW5 B G c) :=
by
  intro B G hok hG lG cG b0 hcG hGeo
  obtain ⟨l2, h2⟩ := pulse_support_good_v5 B G hok hG
  obtain ⟨l3, h3⟩ := pulse_mult_coeffs_v5 B G hok hG
  obtain ⟨l3', h3'⟩ := pres_mult_coeffs_v5 B G hok hG
  obtain ⟨l4, h4⟩ := velRem5_class B G hok hG
  refine ⟨l2 + l3 + l3' + l4, ?_⟩
  intro l0 hl0 c α hsupp htr hL
  have hL' : InWg5 B G (qsOf l0) α (liftH5 c) := hL
  have hk : kapS = 1 / 100000 := rfl

  have hgood : ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (liftH5 c γ m) →
      SuppW B G γ ξ ∧ ActiveL4 B G γ ∧ l0 ≤ γ.1 ∧ 1/4 < qC B.h ξ / Qb γ.1 ∧ qC B.h ξ / Qb γ.1 < 4 ∧
      B.Xa / 2 < XC B.h ξ ∧ XC B.h ξ < 2 * B.Xb ∧ |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 ∧
      |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 :=
    fun γ m ξ hξ hts => h2 l0 (by omega) α (liftH5 c) hL' γ m ξ hξ hts
  have hcoef : ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      ξ ∈ tsupport (liftH5 c γ m) →
      dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) ≠ 0 ∧ ContDiffAt ℝ ∞ (pulseMult5 B G γ m) ξ ∧
      NB B.h (pulseMult5 B G γ m) k ξ ≤ C * qC B.h ξ ^ (B.h * (1/2)) * SC B.h ξ ^ b ∧
      ∀ c' : ℝ × ℝ, IsDeck B.h (qC B.h ξ) c' → pulseMult5 B G γ m (shY ξ c') = pulseMult5 B G γ m ξ := by
    intro k
    obtain ⟨C, b, hC⟩ := h3 k
    refine ⟨C, b, fun γ m ξ hξ hts => ?_⟩
    obtain ⟨-, hA, hl, q1, q2, x1, x2, e1, e2⟩ := hgood γ m ξ hξ hts
    exact hC l0 (by omega) γ m hA hl ξ hξ q1 q2 x1 x2 e1 e2
  have hcoefP : ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      ξ ∈ tsupport (liftH5 c γ m) →
      ContDiffAt ℝ ∞ (presMult5 B G γ m) ξ ∧
      NB B.h (presMult5 B G γ m) k ξ ≤ C * qC B.h ξ ^ (B.h * (1/2)) * SC B.h ξ ^ b ∧
      ∀ c' : ℝ × ℝ, IsDeck B.h (qC B.h ξ) c' → presMult5 B G γ m (shY ξ c') = presMult5 B G γ m ξ := by
    intro k
    obtain ⟨C, b, hC⟩ := h3' k
    refine ⟨C, b, fun γ m ξ hξ hts => ?_⟩
    obtain ⟨-, hA, hl, q1, q2, x1, x2, e1, e2⟩ := hgood γ m ξ hξ hts
    exact hC l0 (by omega) γ m hA hl ξ hξ q1 q2 x1 x2 e1 e2

  have hpot0 : ∀ (γ : Lab) (m : ℤ), ¬(m = 1 ∨ m = -1) → potW5 B G c γ m = 0 := by
    intro γ m hm
    funext ξ
    simp only [potW5, if_neg hm]
    rfl
  have hlift0 : ∀ (γ : Lab) (m : ℤ), ¬(m = 1 ∨ m = -1) → liftH5 c γ m = 0 := by
    intro γ m hm
    funext ξ
    simp only [liftH5, if_neg hm]
    rfl
  have hliftv : ∀ (γ : Lab) (m : ℤ) (ξ : Cyl), (m = 1 ∨ m = -1) →
      liftH5 c γ m ξ = fun i => ((c γ ξ i : ℝ) : ℂ) := by
    intro γ m ξ hm
    simp only [liftH5, if_pos hm]
  have hm0 : ∀ m : ℤ, (m = 1 ∨ m = -1) → m ≠ 0 := by
    intro m hm
    rcases hm with h | h <;> rw [h] <;> norm_num

  have hrep : potW5 B G c = fun γ m ξ => crossC (pulseMult5 B G γ m ξ) (liftH5 c γ m ξ) := by
    funext γ m ξ
    by_cases hm : m = 1 ∨ m = -1
    · rw [hliftv γ m ξ hm]
      simp only [potW5, pulseMult5, if_pos hm, if_neg (hm0 m hm)]
      funext i
      fin_cases i <;> simp [crossC, nsqC5, nPhiC5] <;> ring
    · rw [hpot0 γ m hm, hlift0 γ m hm]
      funext i
      fin_cases i <;> simp [crossC]

  have algP : ∀ (z : ℂ) (n p cc : Fin 3 → ℝ) (K : Matrix (Fin 3) (Fin 3) ℝ),
      z * (((dotProduct n (K.mulVec cc) - dotProduct p cc) / dotProduct n n : ℝ) : ℂ) =
        dotProduct (z • fun j => ((((dotProduct n n)⁻¹ • (Matrix.vecMul n K - p)) j : ℝ) : ℂ))
          (fun i => ((cc i : ℝ) : ℂ)) := by
    intro z n p cc K
    simp only [dotProduct, Matrix.mulVec, Matrix.vecMul, Fin.sum_univ_three, Pi.smul_apply, Pi.sub_apply,
      smul_eq_mul]
    push_cast
    ring
  have hrepP : presW5 B G c = fun γ m ξ => dotProduct (presMult5 B G γ m ξ) (liftH5 c γ m ξ) := by
    funext γ m ξ
    by_cases hm : m = 1 ∨ m = -1
    · rw [hliftv γ m ξ hm]
      simp only [presW5, presMult5, if_pos hm, if_neg (hm0 m hm)]
      exact algP _ _ _ _ _
    · rw [hlift0 γ m hm]
      simp only [presW5, if_neg hm]
      simp

  have hF1 : InWg5 B G (qsOf l0) (α + 1/2) (potW5 B G c) := by
    rw [hrep]
    refine inWg5_cross_mult B G l0 hok α (1/2) (liftH5 c) (pulseMult5 B G) hL' ?_ ?_ ?_
    · intro γ m ξ hξ hts
      obtain ⟨C, b, hC⟩ := hcoef 0
      exact (hC γ m ξ hξ hts).2.1
    · intro γ m ξ hξ hne c' hc
      obtain ⟨C, b, hC⟩ := hcoef 0
      exact (hC γ m ξ hξ (subset_tsupport _ hne)).2.2.2 c' hc
    · intro k
      obtain ⟨C, b, hC⟩ := hcoef k
      exact ⟨C, b, fun γ m ξ hξ hts _ _ => (hC γ m ξ hξ hts).2.2.1⟩

  have hF4 : InWg5 B G (qsOf l0) (α + 1/2) (presW5 B G c) := by
    rw [hrepP]
    refine inWg5_dot_mult B G l0 hok α (1/2) (liftH5 c) (presMult5 B G) hL' ?_ ?_ ?_
    · intro γ m ξ hξ hts
      obtain ⟨C, b, hC⟩ := hcoefP 0
      exact (hC γ m ξ hξ hts).1
    · intro γ m ξ hξ hne c' hc
      obtain ⟨C, b, hC⟩ := hcoefP 0
      exact (hC γ m ξ hξ (subset_tsupport _ hne)).2.2 c' hc
    · intro k
      obtain ⟨C, b, hC⟩ := hcoefP k
      exact ⟨C, b, fun γ m ξ hξ hts _ _ => (hC γ m ξ hξ hts).2.1⟩

  have hR : InWg5 B G (qsOf l0) (α + 1/2 - kapS) (velRem5 B (potW5 B G c)) :=
    h4 l0 (by omega) (α + 1/2) (potW5 B G c) hF1

  have hstruct : ∀ (D : WC) (γ : Lab) (m : ℤ) (ξ : Cyl), velW5 B G D γ m ξ =
      (Complex.I * ((kb B.h γ.1 : ℂ) * (m : ℂ))) • crossC (nPhiC5 B G γ ξ) (D γ m ξ) + velRem5 B D γ m ξ := by
    intro D γ m ξ
    funext i
    fin_cases i <;> simp [velW5, velC5, velRem5, crossC, nPhiC5] <;> ring

  have alg : ∀ (K s c0 : ℂ) (n a : Fin 3 → ℂ), c0 * (K * s) = Complex.I →
      s = n 0 * n 0 + n 1 * n 1 + n 2 * n 2 → n 0 * a 0 + n 1 * a 1 + n 2 * a 2 = 0 →
      (Complex.I * K) • crossC n (c0 • crossC n a) = a := by
    intro K s c0 n a hc hs hd
    have e0 : ((Complex.I * K) • crossC n (c0 • crossC n a)) 0 = a 0 := by
      simp [crossC]
      linear_combination (Complex.I * K * c0 * n 0) * hd + (-Complex.I * a 0) * hc +
        (Complex.I * K * c0 * a 0) * hs - a 0 * Complex.I_mul_I
    have e1 : ((Complex.I * K) • crossC n (c0 • crossC n a)) 1 = a 1 := by
      simp [crossC]
      linear_combination (Complex.I * K * c0 * n 1) * hd + (-Complex.I * a 1) * hc +
        (Complex.I * K * c0 * a 1) * hs - a 1 * Complex.I_mul_I
    have e2 : ((Complex.I * K) • crossC n (c0 • crossC n a)) 2 = a 2 := by
      simp [crossC]
      linear_combination (Complex.I * K * c0 * n 2) * hd + (-Complex.I * a 2) * hc +
        (Complex.I * K * c0 * a 2) * hs - a 2 * Complex.I_mul_I
    funext i
    fin_cases i
    · exact e0
    · exact e1
    · exact e2

  have hprin : ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      velW5 B G (potW5 B G c) γ m ξ = liftH5 c γ m ξ + velRem5 B (potW5 B G c) γ m ξ := by
    intro γ m ξ hξ
    rw [hstruct]
    congr 1
    by_cases ha0 : liftH5 c γ m ξ = 0
    · have hD0 : potW5 B G c γ m ξ = 0 := by
        rw [hrep]
        show crossC (pulseMult5 B G γ m ξ) (liftH5 c γ m ξ) = 0
        rw [ha0]
        funext i
        fin_cases i <;> simp [crossC]
      rw [hD0, ha0]
      funext i
      fin_cases i <;> simp [crossC]
    · have hm : m = 1 ∨ m = -1 := by
        by_contra hm
        exact ha0 (by rw [hlift0 γ m hm]; rfl)
      obtain ⟨C, b, hC⟩ := hcoef 0
      have hns : dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) ≠ 0 :=
        (hC γ m ξ hξ (subset_tsupport _ ha0)).1
      have hnsC : nsqC5 B G γ ξ ≠ 0 := by
        simp only [nsqC5]
        exact_mod_cast hns
      have hkb : (kb B.h γ.1 : ℂ) ≠ 0 := by
        have : 0 < kb B.h γ.1 := by
          unfold kb epsb Qb
          exact Nat.ceil_pos.mpr
            (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos two_pos _) _) _)
        exact_mod_cast this.ne'
      have hmC : (m : ℂ) ≠ 0 := Int.cast_ne_zero.mpr (hm0 m hm)
      have hK : (kb B.h γ.1 : ℂ) * (m : ℂ) * nsqC5 B G γ ξ ≠ 0 :=
        mul_ne_zero (mul_ne_zero hkb hmC) hnsC
      have hc : Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ) * nsqC5 B G γ ξ) *
          ((kb B.h γ.1 : ℂ) * (m : ℂ) * nsqC5 B G γ ξ) = Complex.I := div_mul_cancel₀ _ hK
      have hpot : potW5 B G c γ m ξ = (Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ) * nsqC5 B G γ ξ)) •
          crossC (nPhiC5 B G γ ξ) (liftH5 c γ m ξ) := by
        rw [hliftv γ m ξ hm]
        simp only [potW5, if_pos hm]
        rfl
      have hs : nsqC5 B G γ ξ = nPhiC5 B G γ ξ 0 * nPhiC5 B G γ ξ 0 + nPhiC5 B G γ ξ 1 * nPhiC5 B G γ ξ 1 +
          nPhiC5 B G γ ξ 2 * nPhiC5 B G γ ξ 2 := by
        simp only [nsqC5, nPhiC5, dotProduct, Fin.sum_univ_three]
        push_cast
        ring
      have hd : nPhiC5 B G γ ξ 0 * liftH5 c γ m ξ 0 + nPhiC5 B G γ ξ 1 * liftH5 c γ m ξ 1 +
          nPhiC5 B G γ ξ 2 * liftH5 c γ m ξ 2 = 0 := by
        have h0 := htr γ ξ hξ
        simp only [dotProduct, Fin.sum_univ_three] at h0
        rw [hliftv γ m ξ hm]
        simp only [nPhiC5]
        exact_mod_cast h0
      rw [hpot]
      exact alg ((kb B.h γ.1 : ℂ) * (m : ℂ)) (nsqC5 B G γ ξ) _ (nPhiC5 B G γ ξ) (liftH5 c γ m ξ) hc hs hd

  have hh0 : 0 ≤ B.h := hok.2.1.1.le
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3'' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3''
  have hDq : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 ∧ 1 ≤ SC B.h ξ := by
    have hqs1 : qsOf l0 ≤ 1 := by
      show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
      exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
    intro ξ hξ
    obtain ⟨-, e2, e3⟩ := hξ
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    refine ⟨hq0, by linarith, ?_⟩
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hDsh : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ a, shY ξ a ∈ DomC B.h (qsOf l0) := fun ξ hξ _ => hξ
  have hEdge : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X ∧
      0 < edgeDist B.Xa B.Xb X ∧ edgeDist B.Xa B.Xb X ≤ 1 := by
    intro X e1 e2
    refine ⟨?_, ?_, min_le_left _ _⟩
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · have hX : 0 < X := lt_trans hXa e1
      have l1 : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr e1)
      have l2 : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX).mpr e2)
      exact lt_min one_pos (lt_min l1 l2)
  have hW : ∀ (q Sv E e P C1 C2 b1 b2 d1 d2 α α1 α2 N1 N2 : ℝ), 0 < q → q ≤ 1 → 1 ≤ Sv → 0 ≤ E →
      0 < e → e ≤ 1 → 0 ≤ P → α ≤ α1 → α ≤ α2 →
      N1 ≤ C1 * q ^ (B.h * α1) * Sv ^ b1 * E * e ^ (-d1) * P →
      N2 ≤ C2 * q ^ (B.h * α2) * Sv ^ b2 * E * e ^ (-d2) * P →
      N1 + N2 ≤ (|C1| + |C2|) * q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P := by
    intro q Sv E e P C1 C2 b1 b2 d1 d2 α α1 α2 N1 N2 hq0 hq1 hS1 hE he0 he1 hP0 ha1 ha2 hN1 hN2
    have key : ∀ (C b d αi N : ℝ), α ≤ αi → N ≤ C * q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P →
        b ≤ max b1 b2 → d ≤ max d1 d2 →
        N ≤ |C| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by
      intro C b d αi N hα hN hb hd
      have f1 : q ^ (B.h * αi) ≤ q ^ (B.h * α) :=
        Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (mul_le_mul_of_nonneg_left hα hh0)
      have f2 : Sv ^ b ≤ Sv ^ (max b1 b2) := Real.rpow_le_rpow_of_exponent_le hS1 hb
      have f3 : e ^ (-d) ≤ e ^ (-(max d1 d2)) :=
        Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hd)
      have p1 : 0 ≤ q ^ (B.h * αi) := Real.rpow_nonneg hq0.le _
      have p2 : 0 ≤ Sv ^ b := Real.rpow_nonneg (by linarith) _
      have p3 : 0 ≤ e ^ (-d) := Real.rpow_nonneg he0.le _
      have p1' : 0 ≤ q ^ (B.h * α) := Real.rpow_nonneg hq0.le _
      have p2' : 0 ≤ Sv ^ (max b1 b2) := Real.rpow_nonneg (by linarith) _
      have m1 : q ^ (B.h * αi) * Sv ^ b ≤ q ^ (B.h * α) * Sv ^ (max b1 b2) := mul_le_mul f1 f2 p2 p1'
      have m2 : q ^ (B.h * αi) * Sv ^ b * E ≤ q ^ (B.h * α) * Sv ^ (max b1 b2) * E :=
        mul_le_mul_of_nonneg_right m1 hE
      have m3 : q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) ≤
          q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) :=
        mul_le_mul m2 f3 p3 (mul_nonneg (mul_nonneg p1' p2') hE)
      have hWi := mul_le_mul_of_nonneg_right m3 hP0
      have hWi0 : 0 ≤ q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P :=
        mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg p1 p2) hE) p3) hP0
      calc N ≤ C * q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P := hN
        _ = C * (q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P) := by ring
        _ ≤ |C| * (q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P) :=
            mul_le_mul_of_nonneg_right (le_abs_self C) hWi0
        _ ≤ |C| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) :=
            mul_le_mul_of_nonneg_left hWi (abs_nonneg C)
    have k1 := key C1 b1 d1 α1 N1 ha1 hN1 (le_max_left _ _) (le_max_left _ _)
    have k2 := key C2 b2 d2 α2 N2 ha2 hN2 (le_max_right _ _) (le_max_right _ _)
    have e : (|C1| + |C2|) * q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P =
        |C1| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) +
        |C2| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by ring
    rw [e]
    linarith
  have hNB : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f1 f2 g : Cyl → V) (k : ℕ) (ξ : Cyl),
      ξ ∈ DomC B.h (qsOf l0) → ContDiffOn ℝ ∞ f1 (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ f2 (DomC B.h (qsOf l0)) →
      (∀ η ∈ DomC B.h (qsOf l0), g η = f1 η + f2 η) → NB B.h g k ξ ≤ NB B.h f1 k ξ + NB B.h f2 k ξ := by
    intro V _ _ f1 f2 g k ξ hξ hf1 hf2 heq
    have hn : DomC B.h (qsOf l0) ∈ nhds ξ := hDopen.mem_nhds hξ
    have hev : g =ᶠ[nhds ξ] f1 + f2 := Filter.eventuallyEq_of_mem hn (fun η hη => heq η hη)
    have e1 : iteratedFDeriv ℝ k g ξ = iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ := by
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      exact iteratedFDeriv_add_apply ((hf1.contDiffAt hn).of_le (by exact_mod_cast le_top))
        ((hf2.contDiffAt hn).of_le (by exact_mod_cast le_top))
    unfold NB
    rw [e1]
    have e2 : (iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) =
        (iteratedFDeriv ℝ k f1 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) +
        (iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    exact norm_add_le _ _
  have hInWg : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (α α1 α2 : ℝ)
      (a b c : Lab → ℤ → Cyl → V),
      InWg5 B G (qsOf l0) α1 a → InWg5 B G (qsOf l0) α2 b → α ≤ α1 → α ≤ α2 →
      (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → c γ m = 0) →
      (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), c γ m ξ = a γ m ξ + b γ m ξ) → InWg5 B G (qsOf l0) α c := by
    intro V _ _ α α1 α2 a b c ea eb ha1 ha2 hHc heq
    obtain ⟨-, sa, da, pa, ba⟩ := ea
    obtain ⟨-, sb, db, pb, bb⟩ := eb
    refine ⟨hHc, fun γ m => ((sa γ m).add (sb γ m)).congr (heq γ m), ?_, ?_, ?_⟩
    · intro γ m ξ hξ c' hc
      rw [heq γ m _ (hDsh ξ hξ c'), heq γ m ξ hξ, da γ m ξ hξ c' hc, db γ m ξ hξ c' hc]
    · intro γ m ξ hξ hne
      rw [heq γ m ξ hξ] at hne
      by_cases hA : a γ m ξ = 0
      · rw [hA, zero_add] at hne
        exact pb γ m ξ hξ hne
      · exact pa γ m ξ hξ hA
    · intro k
      obtain ⟨C1, c1, e1, hb1⟩ := ba k
      obtain ⟨C2, c2, e2, hb2⟩ := bb k
      refine ⟨|C1| + |C2|, max c1 c2, max e1 e2, fun γ m ξ hξ hX1 hX2 => ?_⟩
      obtain ⟨hq0, hq1, hS1⟩ := hDq ξ hξ
      obtain ⟨hE, he0, he1⟩ := hEdge _ hX1 hX2
      have hn := hNB (a γ m) (b γ m) (c γ m) k ξ hξ (sa γ m) (sb γ m) (heq γ m)
      have hP0 : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
        unfold Penv5
        exact (Real.exp_pos _).le
      exact le_trans hn (hW _ _ _ _ _ C1 C2 c1 c2 e1 e2 α α1 α2 _ _ hq0 hq1 hS1 (Real.sqrt_nonneg _)
        he0 he1 hP0 ha1 ha2 (hb1 γ m ξ hξ hX1 hX2) (hb2 γ m ξ hξ hX1 hX2))
  have hCongr : ∀ (α : ℝ) (a b : WC), InWg5 B G (qsOf l0) α a →
      (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → b γ m = 0) →
      (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), b γ m ξ = a γ m ξ) → InWg5 B G (qsOf l0) α b := by
    intro α a b ea hHb heq
    obtain ⟨-, sa, da, pa, ba⟩ := ea
    refine ⟨hHb, fun γ m => (sa γ m).congr (heq γ m), ?_, ?_, ?_⟩
    · intro γ m ξ hξ c' hc
      rw [heq γ m _ (hDsh ξ hξ c'), heq γ m ξ hξ, da γ m ξ hξ c' hc]
    · intro γ m ξ hξ hne
      rw [heq γ m ξ hξ] at hne
      exact pa γ m ξ hξ hne
    · intro k
      obtain ⟨C1, c1, e1, hb1⟩ := ba k
      refine ⟨C1, c1, e1, fun γ m ξ hξ hX1 hX2 => ?_⟩
      have hev : b γ m =ᶠ[nhds ξ] a γ m :=
        Filter.eventuallyEq_of_mem (hDopen.mem_nhds hξ) (fun η hη => heq γ m η hη)
      have e : NB B.h (b γ m) k ξ = NB B.h (a γ m) k ξ := by
        unfold NB
        rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      rw [e]
      exact hb1 γ m ξ hξ hX1 hX2
  have hvz : ∀ (a : WC) (γ : Lab) (m : ℤ), a γ m = 0 → velW5 B G a γ m = 0 := by
    intro a γ m h
    funext ξ j
    fin_cases j <;> simp [velW5, velC5, DrC, DzC, dR, dZ, h]
  have hH0 : (0 : ℤ) ∉ ({1, -1} : Finset ℤ) := by decide
  have hHm : ∀ m : ℤ, m ∉ ({1, -1} : Finset ℤ) → ¬(m = 1 ∨ m = -1) := by
    intro m hm
    simpa using hm

  have hF2 : InWg5 B G (qsOf l0) α (velW5 B G (potW5 B G c)) :=
    hInWg α α (α + 1/2 - kapS) (liftH5 c) (velRem5 B (potW5 B G c)) (velW5 B G (potW5 B G c))
      hL' hR le_rfl (by rw [hk]; linarith)
      ⟨{1, -1}, hH0, fun γ m hm => hvz _ γ m (hpot0 γ m (hHm m hm))⟩ hprin

  have hF3 : InWg5 B G (qsOf l0) (α + 1/2 - kapS) (velW5 B G (potW5 B G c) - liftH5 c) := by
    refine hCongr (α + 1/2 - kapS) (velRem5 B (potW5 B G c)) _ hR
      ⟨{1, -1}, hH0, fun γ m hm => ?_⟩ ?_
    · have e1 := hvz _ γ m (hpot0 γ m (hHm m hm))
      have e2 := hlift0 γ m (hHm m hm)
      funext ξ
      show velW5 B G (potW5 B G c) γ m ξ - liftH5 c γ m ξ = 0
      rw [e1, e2]
      simp
    · intro γ m ξ hξ
      show velW5 B G (potW5 B G c) γ m ξ - liftH5 c γ m ξ = _
      rw [hprin γ m ξ hξ]
      abel
  exact ⟨hF1, hF2, hF3, hF4⟩

theorem nb_mul_le_open : ∀ (h : ℝ) (U : Set Cyl), IsOpen U → ∀ (f g : Cyl → ℂ), ContDiffOn ℝ ∞ f U →
    ContDiffOn ℝ ∞ g U → ∀ ξ ∈ U, ∀ k : ℕ, NB h (fun η => f η * g η) k ξ ≤
      ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB h f i ξ * NB h g (k - i) ξ :=
by
  intro h U hU f g hf hg ξ hξ k
  unfold NB
  generalize Lnorm h ξ = L
  obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
  have hs : IsOpen s := by
    rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
  have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
  have h0s : (0 : Cyl) ∈ s := by
    rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
  have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
  have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
  have hsm : ∀ F : Cyl → ℂ, ContDiffOn ℝ ∞ F U → ContDiffOn ℝ ∞ (fun z => F (ξ + z)) s := by
    intro F hF
    exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
      (fun z hz => by rw [hs_def] at hz; exact hz)
  have hsmO : ∀ F : Cyl → ℂ, ContDiffOn ℝ ∞ F U →
      ContDiffOn ℝ ∞ (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
    intro F hF
    exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
  have key : ∀ F : Cyl → ℂ, ContDiffOn ℝ ∞ F U → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
        (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
    intro F hF i
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
      hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
    calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
            (fun _ => L) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
            (fun _ => L) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
            (fun _ => L) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
  have hfg : ContDiffOn ℝ ∞ (fun η => f η * g η) U := hf.mul hg
  have leib := norm_iteratedFDerivWithin_mul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
    (n := k) (by exact_mod_cast le_top)
  rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) * g (ξ + L y)) k hO h0O] at leib
  rw [← key _ hfg k]
  calc ‖iteratedFDeriv ℝ k (fun z => (fun η => f η * g η) (ξ + L z)) 0‖
      = ‖iteratedFDeriv ℝ k (fun y => f (ξ + L y) * g (ξ + L y)) 0‖ := rfl
    _ ≤ _ := leib
    _ = _ := by
      apply Finset.sum_congr rfl
      intro i _
      rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
        iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (k - i) hO h0O,
        key f hf i, key g hg (k - i)]

theorem qC_ratio_rpow_nb : ∀ (B : BG), B.ok → ∀ (p : ℝ), 0 < p → p ≤ 2 → ∀ j : ℕ, ∃ K : ℝ,
    ∀ c : ℝ, 0 < c → ∀ ξ : Cyl, ξ.2.2.1 < 1 → qC B.h ξ ≤ 1 →
      NB B.h (fun η : Cyl => (((qC B.h η / c) ^ p : ℝ) : ℂ)) j ξ ≤ K * (qC B.h ξ / c) ^ p :=
by
  intro B hB p _ _ j
  have hS : SimScaleProps B.h := hB.1
  have h0 : 0 < B.h := hB.2.1.1
  have h1 : B.h < 1/100 := hB.2.1.2.1
  have hN : SimNorm B.h := by
    clear h0 h1
    have hS' := hS
    obtain ⟨hS1, -, -, -, hS5⟩ := hS'
    open Pointwise in
    have hom : ∀ μ z τ : ℝ, 0 < μ →
        simScale B.h (μ ^ (1/2 - B.h) * z) (μ * τ) = μ * simScale B.h z τ := by
      intro μ z τ hμ
      have key : ∀ p : ℝ, 0 < p → μ * p - (μ ^ (1/2 - B.h) * z) ^ 2 * (μ * p) ^ (2 * B.h) =
          μ * (p - z ^ 2 * p ^ (2 * B.h)) := by
        intro p hp
        have sq : (μ ^ (1/2 - B.h)) ^ 2 = μ ^ (1 - 2 * B.h) := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul hμ.le]
          congr 1
          push_cast
          ring
        have split : μ ^ (1 - 2 * B.h) * μ ^ (2 * B.h) = μ := by
          rw [← Real.rpow_add hμ]
          have e : 1 - 2 * B.h + 2 * B.h = 1 := by ring
          rw [e, Real.rpow_one]
        rw [mul_pow, sq, Real.mul_rpow hμ.le hp.le]
        linear_combination (-(z ^ 2 * p ^ (2 * B.h))) * split
      have hset : {q : ℝ | 0 < q ∧ μ * τ ≤ q - (μ ^ (1/2 - B.h) * z) ^ 2 * q ^ (2 * B.h)} =
          μ • {p : ℝ | 0 < p ∧ τ ≤ p - z ^ 2 * p ^ (2 * B.h)} := by
        ext q
        rw [Set.mem_smul_set_iff_inv_smul_mem₀ hμ.ne', smul_eq_mul]
        simp only [Set.mem_setOf_eq]
        have hq : q = μ * (μ⁻¹ * q) := by field_simp
        constructor
        · rintro ⟨hq0, hle⟩
          have hp : 0 < μ⁻¹ * q := mul_pos (inv_pos.mpr hμ) hq0
          refine ⟨hp, ?_⟩
          rw [hq, key _ hp] at hle
          exact le_of_mul_le_mul_left hle hμ
        · rintro ⟨hp, hle⟩
          refine ⟨by rw [hq]; exact mul_pos hμ hp, ?_⟩
          rw [hq, key _ hp]
          exact mul_le_mul_of_nonneg_left hle hμ.le
      unfold simScale
      rw [hset, Real.sInf_smul_of_nonneg hμ.le, smul_eq_mul]
    intro k
    obtain ⟨C, hC⟩ : ∃ C : ℝ, ∀ Z T : ℝ, 0 < T → simScale B.h Z T = 1 →
        ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Z, T)‖ ≤ C := by
      rcases Nat.eq_zero_or_pos k with hk | hk
      · subst hk
        refine ⟨1, fun Z T _ h1 => ?_⟩
        rw [norm_iteratedFDeriv_zero]
        show ‖simScale B.h Z T‖ ≤ 1
        rw [h1, norm_one]
      · obtain ⟨C, hC⟩ := hS5 k hk
        refine ⟨C, fun Z T hT h1 => ?_⟩
        have := hC Z T hT h1.le
        rwa [h1, Real.one_rpow, mul_one] at this
    refine ⟨C, fun z τ hτ _ => ?_⟩
    obtain ⟨hQ0, -⟩ := hS1 z τ hτ
    obtain ⟨Q, hQd⟩ : ∃ Q, Q = simScale B.h z τ := ⟨_, rfl⟩
    rw [← hQd] at hQ0 ⊢
    obtain ⟨Z, hZ⟩ : ∃ Z : ℝ, Z = Q ^ (-(1/2 - B.h)) * z := ⟨_, rfl⟩
    obtain ⟨T, hT⟩ : ∃ T : ℝ, T = Q⁻¹ * τ := ⟨_, rfl⟩
    have hT0 : 0 < T := by rw [hT]; exact mul_pos (inv_pos.mpr hQ0) hτ
    have hZT : simScale B.h Z T = 1 := by
      have := hom Q⁻¹ z τ (inv_pos.mpr hQ0)
      rw [Real.inv_rpow hQ0.le, ← Real.rpow_neg hQ0.le, ← hQd, inv_mul_cancel₀ hQ0.ne'] at this
      rw [hZ, hT]
      exact this
    have hzb : Q ^ (1/2 - B.h) * Z = z := by
      rw [hZ, ← mul_assoc, ← Real.rpow_add hQ0]
      simp
    have hτb : Q * T = τ := by
      rw [hT]
      exact mul_inv_cancel_left₀ hQ0.ne' τ
    have hpa : 0 < Q ^ (1/2 - B.h) := Real.rpow_pos_of_pos hQ0 _
    let e₁ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 (Q ^ (1/2 - B.h)) hpa.ne')
    let e₂ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 Q hQ0.ne')
    let L : (ℝ × ℝ) ≃L[ℝ] (ℝ × ℝ) := e₁.prodCongr e₂
    let M : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 Q hQ0.ne')
    have hL : ∀ x : ℝ × ℝ, L x = (Q ^ (1/2 - B.h) * x.1, Q * x.2) := by
      intro x
      simp [L, e₁, e₂, mul_comm]
    have hM : ∀ y : ℝ, M y = Q * y := by
      intro y
      simp [M, mul_comm]
    have hfun : (fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ L =
        M ∘ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) := by
      funext w
      simp only [Function.comp, hL, hM]
      exact hom Q w.1 w.2 hQ0
    have hLclm : (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)) =
        (Q ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap (Q • ContinuousLinearMap.id ℝ ℝ) := by
      apply ContinuousLinearMap.ext
      intro x
      apply Prod.ext
      · simp [hL]
      · simp [hL]
    have hLv : L (Z, T) = (z, τ) := by
      rw [hL]
      exact Prod.ext hzb hτb
    have hcomp : iteratedFDeriv ℝ k ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ L) (Z, T) =
        (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (L (Z, T))).compContinuousLinearMap
          (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) := by
      have := L.iteratedFDerivWithin_comp_right (fun w : ℝ × ℝ => simScale B.h w.1 w.2)
        uniqueDiffOn_univ (Set.mem_univ (L (Z, T))) k
      rwa [Set.preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at this
    have key : (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (z, τ)).compContinuousLinearMap
          (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) =
        (M : ℝ →L[ℝ] ℝ).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Z, T)) := by
      rw [← hLv, ← hcomp, hfun, M.iteratedFDeriv_comp_left]
    have hMn : ‖(M : ℝ →L[ℝ] ℝ)‖ ≤ Q := by
      refine ContinuousLinearMap.opNorm_le_bound _ hQ0.le fun y => ?_
      show ‖M y‖ ≤ Q * ‖y‖
      rw [hM, norm_mul, Real.norm_eq_abs Q, abs_of_pos hQ0]
    rw [← hLclm, key]
    calc _ ≤ ‖(M : ℝ →L[ℝ] ℝ)‖ *
            ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Z, T)‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ Q * C := mul_le_mul hMn (hC Z T hT0 hZT) (norm_nonneg _) hQ0.le
      _ = C * Q := mul_comm _ _
  unfold SimNorm at hN
  choose C hC using hN

  have key : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (F : E → G) (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  obtain ⟨A, hAdef⟩ : ∃ A : ℝ,
      A = ∑ i ∈ Finset.range (j + 1), |Polynomial.eval p (descPochhammer ℝ i)| := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by rw [hAdef]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = 1 + ∑ i ∈ Finset.range (j + 1), |C i| := ⟨_, rfl⟩
  have hD1 : 1 ≤ D := by
    have := Finset.sum_nonneg (fun k (_ : k ∈ Finset.range (j + 1)) => abs_nonneg (C k))
    rw [hDdef]; linarith
  refine ⟨(j.factorial : ℝ) * A * D ^ j, ?_⟩
  intro c hc ξ hξ hq1

  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqpos : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
  have hU : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const

  obtain ⟨F, hFdef⟩ : ∃ F : Cyl → ℂ, F = fun η : Cyl => (((qC B.h η / c) ^ p : ℝ) : ℂ) := ⟨_, rfl⟩
  obtain ⟨a, hadef⟩ : ∃ a : ℝ, a = (qC B.h ξ / c) ^ p := ⟨_, rfl⟩
  suffices hmain : NB B.h F j ξ ≤ (j.factorial : ℝ) * A * D ^ j * a by
    rw [hFdef, hadef] at hmain; exact hmain
  have ha0 : 0 ≤ a := by rw [hadef]; exact Real.rpow_nonneg (div_nonneg hq0.le hc.le) _
  have hFU : ContDiffOn ℝ ∞ F {η : Cyl | η.2.2.1 < 1} := by
    have h3 : ContDiffOn ℝ ∞ (fun η : Cyl => (qC B.h η / c) ^ p) {η : Cyl | η.2.2.1 < 1} :=
      (hqC.div_const c).rpow_const_of_ne (fun η hη => (div_pos (hqpos η hη) hc).ne')
    rw [hFdef]
    exact Complex.ofRealCLM.contDiff.comp_contDiffOn h3

  obtain ⟨Pm, hPmdef⟩ : ∃ Pm : Cyl →L[ℝ] ℝ × ℝ,
      Pm = ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
        (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))).prod
        (-((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))))) := ⟨_, rfl⟩
  have hPapp : ∀ η : Cyl, Pm η = (η.2.1, -η.2.2.1) := by
    intro η; rw [hPmdef]; simp
  have hP1 : ‖Pm‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
    rw [hPapp η, one_mul, Prod.norm_def (η.2.1, -η.2.2.1)]
    refine max_le ?_ ?_
    · exact (norm_fst_le η.2).trans (norm_snd_le η)
    · exact (norm_neg η.2.2.1).trans_le
        (((norm_fst_le η.2.2).trans (norm_snd_le η.2)).trans (norm_snd_le η))
  obtain ⟨Mq, hMqdef⟩ : ∃ Mq : ℝ × ℝ →L[ℝ] ℝ × ℝ,
      Mq = (qC B.h ξ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
        (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ) := ⟨_, rfl⟩
  obtain ⟨T, hTdef⟩ : ∃ T : Cyl →L[ℝ] ℝ × ℝ, T = Mq.comp Pm := ⟨_, rfl⟩
  obtain ⟨w0, hw0def⟩ : ∃ w0 : ℝ × ℝ, w0 = (ξ.2.1, 1 - ξ.2.2.1) := ⟨_, rfl⟩
  have hW : IsOpen (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
  have hw0 : w0 ∈ (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := by
    rw [hw0def]; exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩

  have hid : ∀ v : Cyl, qC B.h (ξ + Lnorm B.h ξ v) = simScale B.h (w0 + T v).1 (w0 + T v).2 := by
    intro v
    have e1 : (Lnorm B.h ξ v).2.1 = qC B.h ξ ^ (1/2 - B.h) * v.2.1 := by
      simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e2 : (Lnorm B.h ξ v).2.2.1 = qC B.h ξ * v.2.2.1 := by
      simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e3 : T v = (qC B.h ξ ^ (1/2 - B.h) * v.2.1, qC B.h ξ * (-v.2.2.1)) := by
      rw [hTdef, ContinuousLinearMap.comp_apply, hPapp v, hMqdef]
      simp [ContinuousLinearMap.coe_prodMap']
    rw [e3, hw0def]
    show simScale B.h (ξ.2.1 + (Lnorm B.h ξ v).2.1) (1 - (ξ.2.2.1 + (Lnorm B.h ξ v).2.2.1)) =
      simScale B.h (ξ.2.1 + qC B.h ξ ^ (1/2 - B.h) * v.2.1) ((1 - ξ.2.2.1) + qC B.h ξ * (-v.2.2.1))
    rw [e1, e2]
    congr 1
    ring

  obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = {v : Cyl | (ξ + Lnorm B.h ξ v).2.2.1 < 1} := ⟨_, rfl⟩
  have hOmem : ∀ v, v ∈ O ↔ (ξ + Lnorm B.h ξ v).2.2.1 < 1 := by
    intro v; rw [hOdef]; rfl
  have hcontO : Continuous (fun v : Cyl => (ξ + Lnorm B.h ξ v).2.2.1) :=
    ((continuous_const.add (Lnorm B.h ξ).continuous).snd.snd.fst)
  have hO : IsOpen O := by rw [hOdef]; exact isOpen_lt hcontO continuous_const
  have h0O : (0 : Cyl) ∈ O := by
    rw [hOmem, map_zero, add_zero]; exact hξ
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : Cyl → ℝ, ψ = fun v => qC B.h (ξ + Lnorm B.h ξ v) / qC B.h ξ :=
    ⟨_, rfl⟩
  have hψ : ContDiffOn ℝ ∞ ψ O := by
    rw [hψdef]
    exact (hqC.comp (contDiff_const.add (Lnorm B.h ξ).contDiff).contDiffOn
      (fun v hv => (hOmem v).1 hv)).div_const _
  have hψpos : ∀ v ∈ O, 0 < ψ v := by
    intro v hv; rw [hψdef]; exact div_pos (hqpos _ ((hOmem v).1 hv)) hq0
  have hψ0 : ψ 0 = 1 := by
    rw [hψdef]
    show qC B.h (ξ + Lnorm B.h ξ 0) / qC B.h ξ = 1
    rw [map_zero, add_zero]; exact div_self hq0.ne'
  have hψeq : ψ = (qC B.h ξ)⁻¹ • (fun z : Cyl => simScale B.h (w0 + T z).1 (w0 + T z).2) := by
    rw [hψdef]; funext v
    show qC B.h (ξ + Lnorm B.h ξ v) / qC B.h ξ =
      (qC B.h ξ)⁻¹ * simScale B.h (w0 + T v).1 (w0 + T v).2
    rw [hid v, div_eq_inv_mul]
  have hΦ : ContDiffAt ℝ ∞ (fun z : Cyl => simScale B.h (w0 + T z).1 (w0 + T z).2) 0 := by
    have h1 : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (w0 + T 0) := by
      rw [map_zero, add_zero]; exact hS.2.2.2.1.contDiffAt (hW.mem_nhds hw0)
    exact ContDiffAt.comp (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2) (f := fun z : Cyl => w0 + T z)
      (0 : Cyl) h1 (contDiff_const.add T.contDiff).contDiffAt

  have hDψ : ∀ i : ℕ, 1 ≤ i → i ≤ j → ‖iteratedFDerivWithin ℝ i ψ O 0‖ ≤ D ^ i := by
    intro i hi1 hij
    have hcomp : (iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq.comp Pm) =
        ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm) := by
      ext m; rfl
    have hCi : ‖(iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq)‖ ≤ C i * qC B.h ξ := by
      rw [hMqdef, hw0def]; exact hC i ξ.2.1 (1 - ξ.2.2.1) (by linarith) hq1
    have hprod : ∏ k : Fin i, ‖Pm‖ ≤ 1 := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_one₀ (norm_nonneg _) hP1
    have hb1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
      ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq)) (fun _ : Fin i => Pm)
    have hb2 := hb1.trans ((mul_le_of_le_one_right (norm_nonneg _) hprod).trans hCi)
    have hCiD : C i ≤ D := by
      have h2 : |C i| ≤ ∑ k ∈ Finset.range (j + 1), |C k| :=
        Finset.single_le_sum (f := fun k => |C k|) (fun k _ => abs_nonneg _)
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hij))
      have h3 := le_abs_self (C i)
      rw [hDdef]; linarith
    rw [iteratedFDerivWithin_of_isOpen i hO h0O, hψeq,
      iteratedFDeriv_const_smul_apply (hΦ.of_le (by exact_mod_cast le_top)),
      key (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) w0 T hW hS.2.2.2.1 hw0 i,
      norm_smul, hTdef, hcomp, Real.norm_of_nonneg (inv_nonneg.mpr hq0.le)]
    calc (qC B.h ξ)⁻¹ * ‖((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm)‖
        ≤ (qC B.h ξ)⁻¹ * (C i * qC B.h ξ) :=
          mul_le_mul_of_nonneg_left hb2 (inv_nonneg.mpr hq0.le)
      _ = C i := by rw [mul_comm (C i), ← mul_assoc, inv_mul_cancel₀ hq0.ne', one_mul]
      _ ≤ D := hCiD
      _ ≤ D ^ i := le_self_pow₀ hD1 (by omega)

  have hg : ContDiffOn ℝ ∞ (fun x : ℝ => x ^ p) (Set.Ioi 0) :=
    (contDiffOn_id (s := Set.Ioi (0:ℝ))).rpow_const_of_ne (fun x hx => ne_of_gt hx)
  have hψmaps : Set.MapsTo ψ O (Set.Ioi 0) := fun v hv => hψpos v hv
  have hCg : ∀ i ≤ j, ‖iteratedFDerivWithin ℝ i (fun x : ℝ => x ^ p) (Set.Ioi 0) (ψ 0)‖ ≤ A := by
    intro i hi
    rw [hψ0, iteratedFDerivWithin_of_isOpen i isOpen_Ioi (Set.mem_Ioi.mpr (zero_lt_one' ℝ)),
      norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
      Real.iter_deriv_rpow_const, Real.one_rpow, mul_one, Real.norm_eq_abs, hAdef]
    exact Finset.single_le_sum (f := fun i => |Polynomial.eval p (descPochhammer ℝ i)|)
      (fun i _ => abs_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  have hFdB := norm_iteratedFDerivWithin_comp_le hg hψ (by exact_mod_cast le_top)
    isOpen_Ioi.uniqueDiffOn hO.uniqueDiffOn hψmaps h0O (C := A) (D := D) hCg hDψ

  obtain ⟨gl, hgldef⟩ : ∃ gl : ℝ →L[ℝ] ℂ, gl = a • Complex.ofRealCLM := ⟨_, rfl⟩
  have hgl : ‖gl‖ ≤ a := ContinuousLinearMap.opNorm_le_bound _ ha0 (fun x => le_of_eq (by
    rw [hgldef, ContinuousLinearMap.smul_apply, Complex.ofRealCLM_apply, norm_smul, Complex.norm_real,
      Real.norm_of_nonneg ha0]))
  have hEq : Set.EqOn (fun z => F (ξ + Lnorm B.h ξ z)) (⇑gl ∘ ((fun x : ℝ => x ^ p) ∘ ψ)) O := by
    intro z hz
    have hψz := hψpos z hz
    have e : qC B.h (ξ + Lnorm B.h ξ z) / c = (qC B.h ξ / c) * ψ z := by
      rw [hψdef]
      show _ = qC B.h ξ / c * (qC B.h (ξ + Lnorm B.h ξ z) / qC B.h ξ)
      rw [div_mul_div_comm, mul_comm (qC B.h ξ), mul_div_mul_right _ _ hq0.ne']
    show F (ξ + Lnorm B.h ξ z) = gl (ψ z ^ p)
    rw [hFdef, hgldef, ContinuousLinearMap.smul_apply, Complex.ofRealCLM_apply]
    show (((qC B.h (ξ + Lnorm B.h ξ z) / c) ^ p : ℝ) : ℂ) = a • ((ψ z ^ p : ℝ) : ℂ)
    rw [e, Real.mul_rpow (div_nonneg hq0.le hc.le) hψz.le, ← hadef, Complex.real_smul,
      Complex.ofReal_mul]
  have hgψ : ContDiffOn ℝ ∞ ((fun x : ℝ => x ^ p) ∘ ψ) O := hg.comp hψ hψmaps
  have hNB : NB B.h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := by
    unfold NB
    rw [key F {η : Cyl | η.2.2.1 < 1} ξ (Lnorm B.h ξ) hU hFU hξ j]
  calc NB B.h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := hNB
    _ = ‖iteratedFDerivWithin ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) O 0‖ := by
        rw [iteratedFDerivWithin_of_isOpen j hO h0O]
    _ = ‖iteratedFDerivWithin ℝ j (⇑gl ∘ ((fun x : ℝ => x ^ p) ∘ ψ)) O 0‖ := by
        rw [iteratedFDerivWithin_congr hEq h0O j]
    _ = ‖gl.compContinuousMultilinearMap
          (iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ p) ∘ ψ) O 0)‖ := by
        rw [ContinuousLinearMap.iteratedFDerivWithin_comp_left gl (hgψ.contDiffWithinAt h0O)
          hO.uniqueDiffOn h0O (i := j) (by exact_mod_cast le_top)]
    _ ≤ ‖gl‖ * ‖iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ p) ∘ ψ) O 0‖ :=
        ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
    _ ≤ a * ((j.factorial : ℝ) * A * D ^ j) := mul_le_mul hgl hFdB (norm_nonneg _) ha0
    _ = (j.factorial : ℝ) * A * D ^ j * a := by ring

theorem stress5_pwScale_class : ∀ (B : BG) (G : CorrGeom), B.ok → ∀ (l0 : ℕ) (α : ℝ) (a : WS),
    InWg5 B G (qsOf l0) α a → InWg5 B G (qsOf l0) α (pwScale B a) :=
by
  intro B G hB l0 α a ha
  obtain ⟨⟨H, h0H, hH⟩, hsm, hdeck, hsupp, hbd⟩ := ha
  have hS : SimScaleProps B.h := hB.1
  have hXa : 0 < B.Xa := hB.2.1.2.2.1
  set p : ℝ := Aex B.h + 1/2 with hp
  have hp0 : 0 < p := by rw [hp]; unfold Aex; linarith [hB.2.1.1]
  have hp2 : p ≤ 2 := by rw [hp]; unfold Aex; linarith [hB.2.1.2.1]
  have hq1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hQb : ∀ l : ℕ, 0 < Qb l := fun l => Real.rpow_pos_of_pos two_pos _
  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) := hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqpos : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hm : ∀ c : ℝ, 0 < c →
      ContDiffOn ℝ ∞ (fun η : Cyl => (((qC B.h η / c) ^ p : ℝ) : ℂ)) {η : Cyl | η.2.2.1 < 1} := by
    intro c hc
    have h3 : ContDiffOn ℝ ∞ (fun η : Cyl => (qC B.h η / c) ^ p) {η : Cyl | η.2.2.1 < 1} :=
      (hqC.div_const c).rpow_const_of_ne (fun η hη => (div_pos (hqpos η hη) hc).ne')
    exact Complex.ofRealCLM.contDiff.comp_contDiffOn h3
  have hΩsub : DomC B.h (qsOf l0) ⊆ {η : Cyl | η.2.2.1 < 1} := fun η hη =>
    (show 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < qsOf l0 from hη).2.1
  have hΩopen : IsOpen (DomC B.h (qsOf l0)) := by
    have e : DomC B.h (qsOf l0) =
        {η : Cyl | 0 < η.1 ∧ η.2.2.1 < 1} ∩ (fun η => qC B.h η) ⁻¹' Iio (qsOf l0) := by
      ext η; simp only [DomC, mem_inter_iff, mem_setOf_eq, mem_preimage, mem_Iio]; tauto
    rw [e]
    have ho : IsOpen {η : Cyl | 0 < η.1 ∧ η.2.2.1 < 1} :=
      (isOpen_lt continuous_const continuous_fst).inter
        (isOpen_lt continuous_snd.snd.fst continuous_const)
    exact (hqC.continuousOn.mono (fun η hη => hη.2)).isOpen_inter_preimage ho isOpen_Iio
  have mono6 : ∀ (c A S1 S2 s E1 E2 P : ℝ), 0 ≤ A → 0 ≤ S1 → S1 ≤ S2 → 0 ≤ s → 0 ≤ E1 → E1 ≤ E2 →
      0 ≤ P → c * A * S1 * s * E1 * P ≤ |c| * (A * S2 * s * E2 * P) := by
    intro c A S1 S2 s E1 E2 P hA hS1 hS12 hs hE1 hE12 hP
    have h1 := mul_le_mul_of_nonneg_right (le_abs_self c)
      (mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hA hS1) hs) hE1) hP)
    have hc := abs_nonneg c
    have a1 : |c| * A * S1 ≤ |c| * A * S2 := mul_le_mul_of_nonneg_left hS12 (mul_nonneg hc hA)
    have a2 : |c| * A * S1 * s ≤ |c| * A * S2 * s := mul_le_mul_of_nonneg_right a1 hs
    have a3 : |c| * A * S1 * s * E1 ≤ |c| * A * S2 * s * E2 :=
      mul_le_mul a2 hE12 hE1 (mul_nonneg (mul_nonneg (mul_nonneg hc hA) (le_trans hS1 hS12)) hs)
    have a4 := mul_le_mul_of_nonneg_right a3 hP
    have e1 : c * A * S1 * s * E1 * P = c * (A * S1 * s * E1 * P) := by ring
    have e2 : |c| * (A * S2 * s * E2 * P) = |c| * A * S2 * s * E2 * P := by ring
    have e3 : |c| * (A * S1 * s * E1 * P) = |c| * A * S1 * s * E1 * P := by ring
    rw [e1, e2]; rw [e3] at h1; linarith
  refine ⟨⟨H, h0H, fun γ m hm' => by funext η; simp [pwScale, hH γ m hm']⟩, ?_, ?_, ?_, ?_⟩
  · intro γ m
    exact ((hm _ (hQb γ.1)).mono hΩsub).mul (hsm γ m)
  · intro γ m ξ hξ c hc
    show (((qC B.h (shY ξ c) / Qb γ.1) ^ p : ℝ) : ℂ) * a γ m (shY ξ c) =
      (((qC B.h ξ / Qb γ.1) ^ p : ℝ) : ℂ) * a γ m ξ
    rw [hdeck γ m ξ hξ c hc]
    rfl
  · intro γ m ξ hξ hne
    exact hsupp γ m ξ hξ (right_ne_zero_of_mul
      (show (((qC B.h ξ / Qb γ.1) ^ p : ℝ) : ℂ) * a γ m ξ ≠ 0 from hne))
  choose C b d hC using hbd
  choose K hK using qC_ratio_rpow_nb B hB p hp0 hp2
  intro k
  obtain ⟨C', hC'⟩ : ∃ C' : ℝ,
      C' = ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (4 * |K i|) * |C (k - i)| := ⟨_, rfl⟩
  obtain ⟨b', hb'⟩ : ∃ b' : ℝ, b' = ∑ i ∈ Finset.range (k + 1), |b i| := ⟨_, rfl⟩
  obtain ⟨d', hd'⟩ : ∃ d' : ℝ, d' = ∑ i ∈ Finset.range (k + 1), |d i| := ⟨_, rfl⟩
  refine ⟨C', b', d', ?_⟩
  intro γ m ξ hξ hX1 hX2
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  have hq0 : 0 < qC B.h ξ := hqpos ξ hξ'.2.1
  have hqle1 : qC B.h ξ ≤ 1 := le_trans hξ'.2.2.le hq1
  have hSC1 : 1 ≤ SC B.h ξ := by
    unfold SC; exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h ξ))])
  have hed0 : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) := by
    have hX0 : 0 < XC B.h ξ := lt_trans hXa hX1
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
      (Real.log_pos ((one_lt_div hX0).mpr hX2)))
  have hed1 : edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := by unfold edgeDist; exact min_le_left _ _
  have hP0 : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
    unfold Penv5; exact (Real.exp_pos _).le
  have hA0 : 0 ≤ qC B.h ξ ^ (B.h * α) := (Real.rpow_pos_of_pos hq0 _).le
  obtain ⟨R, hR⟩ : ∃ R : ℝ, R = qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b' *
      Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d') *
      Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := ⟨_, rfl⟩
  have hR0 : 0 ≤ R := by
    rw [hR]
    exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hA0 (Real.rpow_nonneg (by linarith) _))
      (Real.sqrt_nonneg _)) (Real.rpow_pos_of_pos hed0 _).le) hP0
  have hC'0 : 0 ≤ C' := by rw [hC']; exact Finset.sum_nonneg (fun i _ => by positivity)
  have hunif : ∀ j ∈ Finset.range (k + 1), NB B.h (a γ m) j ξ ≤ |C j| * R := by
    intro j hj
    have hbj : b j ≤ b' := by
      rw [hb']
      exact le_trans (le_abs_self _)
        (Finset.single_le_sum (f := fun i => |b i|) (fun i _ => abs_nonneg _) hj)
    have hdj : d j ≤ d' := by
      rw [hd']
      exact le_trans (le_abs_self _)
        (Finset.single_le_sum (f := fun i => |d i|) (fun i _ => abs_nonneg _) hj)
    have e1 : SC B.h ξ ^ b j ≤ SC B.h ξ ^ b' := Real.rpow_le_rpow_of_exponent_le hSC1 hbj
    have e2 : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d j) ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d') :=
      Real.rpow_le_rpow_of_exponent_ge hed0 hed1 (neg_le_neg hdj)
    rw [hR]
    exact (hC j γ m ξ hξ hX1 hX2).trans (mono6 _ _ _ _ _ _ _ _ hA0
      (Real.rpow_nonneg (by linarith) _) e1 (Real.sqrt_nonneg _) (Real.rpow_pos_of_pos hed0 _).le e2 hP0)
  suffices hs : NB B.h (pwScale B a γ m) k ξ ≤ C' * R by
    exact hs.trans (le_of_eq (by rw [hR]; ring))
  by_cases hts : ξ ∈ tsupport (etaL B.h γ)
  · obtain ⟨φ, hφ⟩ : ∃ φ : Cyl → ℝ, φ = fun η => Real.logb 2 (qC B.h η) + (γ.1 : ℝ) := ⟨_, rfl⟩
    have hsupp' : ∀ η, etaL B.h γ η ≠ 0 → φ η ^ 2 < 1 := by
      intro η hη
      have h1 : sqPart 1 (-(γ.1:ℤ)) (Real.logb 2 (qC B.h η)) ≠ 0 := left_ne_zero_of_mul hη
      have h2 : bumpR (Real.logb 2 (qC B.h η) / 1 - ((-(γ.1:ℤ) : ℤ) : ℝ)) ≠ 0 := by
        intro h0; apply h1; unfold sqPart; rw [h0, zero_div]
      unfold bumpR at h2
      have h3 : 0 < 1 - (Real.logb 2 (qC B.h η) / 1 - ((-(γ.1:ℤ) : ℤ) : ℝ)) ^ 2 := by
        by_contra hc; exact h2 (Real.smoothTransition.zero_of_nonpos (not_lt.mp hc))
      have e : Real.logb 2 (qC B.h η) / 1 - ((-(γ.1:ℤ) : ℤ) : ℝ) = φ η := by
        rw [hφ]; push_cast; ring
      rw [e] at h3; linarith
    have hcont : ContinuousAt φ ξ := by
      rw [hφ]
      have hqc : ContinuousAt (fun η : Cyl => qC B.h η) ξ :=
        hqC.continuousOn.continuousAt
          ((isOpen_lt continuous_snd.snd.fst continuous_const).mem_nhds hξ'.2.1)
      exact (hqc.logb (hqpos ξ hξ'.2.1).ne').add continuousAt_const
    have hle : φ ξ ^ 2 ≤ 1 := by
      by_contra hc
      push_neg at hc
      have hV : {η | 1 < φ η ^ 2} ∈ nhds ξ := (hcont.pow 2).preimage_mem_nhds (lt_mem_nhds hc)
      obtain ⟨η, hη1, hη2⟩ := (mem_closure_iff_nhds.mp hts) _ hV
      exact lt_asymm hη1 (hsupp' η hη2)
    have hφξ : φ ξ = Real.logb 2 (qC B.h ξ) + (γ.1 : ℝ) := by rw [hφ]
    have hlo : -1 ≤ φ ξ := by nlinarith
    have hhi : φ ξ ≤ 1 := by nlinarith
    have hρ : qC B.h ξ / Qb γ.1 = (2:ℝ) ^ (Real.logb 2 (qC B.h ξ) + (γ.1 : ℝ)) := by
      show qC B.h ξ / (2:ℝ) ^ (-(γ.1:ℝ)) = _
      rw [show Real.logb 2 (qC B.h ξ) + (γ.1:ℝ) = Real.logb 2 (qC B.h ξ) - (-(γ.1:ℝ)) by ring,
        Real.rpow_sub two_pos, Real.rpow_logb two_pos (by norm_num) hq0]
    have hband : 1/2 ≤ qC B.h ξ / Qb γ.1 ∧ qC B.h ξ / Qb γ.1 ≤ 2 := by
      rw [hρ]
      constructor
      · calc (1/2:ℝ) = (2:ℝ) ^ (-1:ℝ) := by rw [Real.rpow_neg_one]; norm_num
          _ ≤ _ := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
      · calc (2:ℝ) ^ (Real.logb 2 (qC B.h ξ) + (γ.1 : ℝ)) ≤ (2:ℝ) ^ (1:ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
          _ = 2 := Real.rpow_one 2
    have hρp : (qC B.h ξ / Qb γ.1) ^ p ≤ 4 := by
      calc (qC B.h ξ / Qb γ.1) ^ p ≤ (2:ℝ) ^ p :=
            Real.rpow_le_rpow (by linarith [hband.1]) hband.2 hp0.le
        _ ≤ (2:ℝ) ^ (2:ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) hp2
        _ = 4 := by rw [Real.rpow_two]; norm_num
    have hKi : ∀ i, NB B.h (fun η : Cyl => (((qC B.h η / Qb γ.1) ^ p : ℝ) : ℂ)) i ξ ≤ 4 * |K i| := by
      intro i
      have h1 := hK i (Qb γ.1) (hQb _) ξ hξ'.2.1 hqle1
      have h2 : 0 ≤ (qC B.h ξ / Qb γ.1) ^ p := Real.rpow_nonneg (div_nonneg hq0.le (hQb _).le) _
      have h3 : K i * (qC B.h ξ / Qb γ.1) ^ p ≤ |K i| * (qC B.h ξ / Qb γ.1) ^ p :=
        mul_le_mul_of_nonneg_right (le_abs_self _) h2
      have h4 : |K i| * (qC B.h ξ / Qb γ.1) ^ p ≤ |K i| * 4 :=
        mul_le_mul_of_nonneg_left hρp (abs_nonneg _)
      linarith
    have e : pwScale B a γ m = fun η => (((qC B.h η / Qb γ.1) ^ p : ℝ) : ℂ) * a γ m η := rfl
    rw [e]
    have hL := nb_mul_le_open B.h (DomC B.h (qsOf l0)) hΩopen
      (fun η : Cyl => (((qC B.h η / Qb γ.1) ^ p : ℝ) : ℂ)) (a γ m)
      ((hm _ (hQb γ.1)).mono hΩsub) (hsm γ m) ξ hξ k
    have hsum : ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) *
          NB B.h (fun η : Cyl => (((qC B.h η / Qb γ.1) ^ p : ℝ) : ℂ)) i ξ * NB B.h (a γ m) (k - i) ξ ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (4 * |K i|) * (|C (k - i)| * R) := by
      apply Finset.sum_le_sum
      intro i hi
      have hki : k - i ∈ Finset.range (k + 1) := Finset.mem_range.mpr (by omega)
      exact mul_le_mul (mul_le_mul_of_nonneg_left (hKi i) (Nat.cast_nonneg _)) (hunif (k - i) hki)
        (norm_nonneg _) (mul_nonneg (Nat.cast_nonneg _) (by positivity))
    refine hL.trans (hsum.trans (le_of_eq ?_))
    rw [hC', Finset.sum_mul]
    exact Finset.sum_congr rfl (fun i _ => by ring)
  · have hU : IsOpen (DomC B.h (qsOf l0) ∩ (tsupport (etaL B.h γ))ᶜ) :=
      hΩopen.inter (isClosed_tsupport _).isOpen_compl
    have hev : (pwScale B a γ m) =ᶠ[nhds ξ] (fun _ => (0:ℂ)) := by
      filter_upwards [hU.mem_nhds ⟨hξ, hts⟩] with η hη
      have h0 : a γ m η = 0 := by
        by_contra hne
        exact hη.2 (hsupp γ m η hη.1 hne).2.1
      simp [pwScale, h0]
    have hNB0 : NB B.h (pwScale B a γ m) k ξ = 0 := by
      unfold NB
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_zero]
      apply le_antisymm _ (norm_nonneg _)
      refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
      simp
    rw [hNB0]
    exact mul_nonneg hC'0 hR0

theorem prim_potential_classes_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
    l1 ≤ l0 → InWg5 B G (qsOf l0) (1/2) (W0h4 B G) →
    (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), dotProduct (nPhi5 B G γ ξ) (W0c4 B G γ ξ) = 0) →
    InWg5 B G (qsOf l0) 1 (primState5 B G).Aw ∧ InWg5 B G (qsOf l0) 1 (primState5 B G).pw ∧
    InWg5 B G (qsOf l0) (1/2) (velW5 B G (primState5 B G).Aw) ∧
    InWg5 B G (qsOf l0) (1 - kapS) (velW5 B G (primState5 B G).Aw - W0h4 B G) :=
by
  intro B G hok hG
  obtain ⟨lG, cG, b0, hcG, hGeo⟩ := nphi5_geometry_v5 B G hok hG
  obtain ⟨lF, hF⟩ := wave_potential_transfer_v5 B G hok hG lG cG b0 hcG hGeo
  refine ⟨lF, fun l0 hl0 hW0 htr => ?_⟩
  have hr0 : 0 < G.r0 := hG.1.1

  have hcib : ∀ l : ℕ, 0 < cib B.h l := by
    intro l
    unfold cib
    have hTg : (0:ℝ) < Tgc := by unfold Tgc; positivity
    have hQ : (0:ℝ) < Qb l := by unfold Qb; positivity
    exact mul_pos (zpow_pos hTg _) (Real.rpow_pos_of_pos hQ _)

  have hchig : ∀ s : ℝ, chig G.r0 s ≠ 0 → |s| < G.r0 / 4 := by
    intro s hs
    unfold chig bumpR at hs
    by_contra hcon
    apply hs
    apply Real.smoothTransition.zero_of_nonpos
    push_neg at hcon
    have h1 : G.r0 ≤ |4 * s| := by
      rw [abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 4)]; linarith
    have h2 : 1 ≤ (4 * s / G.r0) ^ 2 := by
      rw [div_pow, le_div_iff₀ (by positivity), one_mul, ← sq_abs (4 * s)]
      nlinarith [abs_nonneg (4 * s)]
    linarith

  have hpsi : ∀ (γ : Lab) (Y : ℝ × ℝ), psiT (Lsb B.h G.r0 γ.1) (vco B.h G.r0 γ (G.ctr γ) Y) ≠ 0 →
      |etG B.h γ (G.ctr γ) Y| < 2 * G.r0 / 3 := by
    intro γ Y hs
    have hc := hcib γ.1
    unfold psiT at hs
    by_contra hcon
    apply hs
    apply Real.smoothTransition.zero_of_nonpos
    push_neg at hcon
    have hv : vco B.h G.r0 γ (G.ctr γ) Y - Lsb B.h G.r0 γ.1 / 2 = etG B.h γ (G.ctr γ) Y / cib B.h γ.1 := by
      unfold vco Lsb; ring
    rw [hv]
    have hL : 0 < 2 * G.r0 / cib B.h γ.1 := div_pos (by linarith) hc
    apply div_nonpos_of_nonpos_of_nonneg
    · unfold Lsb
      rw [abs_div, abs_of_pos hc]
      have e : 2 * G.r0 / cib B.h γ.1 / 3 = (2 * G.r0 / 3) / cib B.h γ.1 := by ring
      rw [e, sub_nonpos]
      gcongr
    · unfold Lsb
      linarith

  have hsupp : ∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), W0c4 B G γ ξ ≠ 0 →
      ActiveL4 B G γ ∧ etaL B.h γ ξ ≠ 0 ∧ |xiG B.h γ (G.ctr γ) ξ.2.2.2| ≤ G.r0 / 4 ∧
        |etG B.h γ (G.ctr γ) ξ.2.2.2| ≤ 2 * G.r0 / 3 := by
    intro γ ξ _hξ hne
    unfold W0c4 at hne
    split_ifs at hne with hg
    · have h1 : (Real.sqrt (epsb B.h γ.1) / 2 * etaL B.h γ ξ * Real.sqrt (max (yAmp4 B G γ ξ) 0) *
          chig G.r0 (xiG B.h γ (G.ctr γ) ξ.2.2.2) *
          psiT (Lsb B.h G.r0 γ.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) ≠ 0 := by
        intro h0; apply hne; rw [h0, zero_smul]
      obtain ⟨h2, hps⟩ := mul_ne_zero_iff.mp h1
      obtain ⟨h3, hch⟩ := mul_ne_zero_iff.mp h2
      obtain ⟨h4, -⟩ := mul_ne_zero_iff.mp h3
      obtain ⟨-, heta⟩ := mul_ne_zero_iff.mp h4
      exact ⟨hg.1, heta, (hchig _ hch).le, (hpsi γ _ hps).le⟩
    · exact absurd rfl hne

  obtain ⟨F1, F2, F3, F4⟩ := hF l0 hl0 (W0c4 B G) (1/2) hsupp htr hW0
  have e1 : (1/2 : ℝ) + 1/2 = 1 := by norm_num
  have e3 : (1/2 : ℝ) + 1/2 - kapS = 1 - kapS := by ring
  rw [e1] at F1 F4
  rw [e3] at F3
  exact ⟨F1, stress5_pwScale_class B G hok l0 1 (presW5 B G (W0c4 B G)) F4, F2, F3⟩

theorem modeCoef5_differentiable_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (qs α : ℝ) (a : WC), qs ≤ B.qB → InWg5 B G qs α a → ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h qs, DifferentiableAt ℝ (modeCoef5 B G a γ m) ξ :=
by
  intro B G hok hG qs α a hqs ha γ m ξ hξ

  have hDopen : IsOpen (DomC B.h qs) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio qs := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hDn : DomC B.h qs ∈ nhds ξ := hDopen.mem_nhds hξ
  obtain ⟨hr, ht, hqξ⟩ := id hξ

  have hamp : DifferentiableAt ℝ (a γ m) ξ :=
    ((ha.2.1 γ m).contDiffAt hDn).differentiableAt (by norm_num)
  have hai : ∀ i, DifferentiableAt ℝ (fun η => a γ m η i) ξ := differentiableAt_pi.1 hamp

  set v : Cyl → ℝ × ℝ := fun η => Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ with hv
  have hvc : Continuous v := by
    rw [hv]
    unfold Jpow
    fun_prop
  set U : Set Cyl := DomC B.h qs ∩ {η | |(v η).1 - (v ξ).1| < 1/8} ∩
    {η | |(v η).2 - (v ξ).2| < 1/8} with hU
  have hUo : IsOpen U :=
    (hDopen.inter (isOpen_lt ((hvc.fst.sub continuous_const).abs) continuous_const)).inter
      (isOpen_lt ((hvc.snd.sub continuous_const).abs) continuous_const)
  have hξU : ξ ∈ U := by
    refine ⟨⟨hξ, ?_⟩, ?_⟩
    · show |(v ξ).1 - (v ξ).1| < 1/8
      rw [sub_self, abs_zero]; norm_num
    · show |(v ξ).2 - (v ξ).2| < 1/8
      rw [sub_self, abs_zero]; norm_num
  have hUn : U ∈ nhds ξ := hUo.mem_nhds hξU
  by_cases hA : ∀ η ∈ U, a γ m η = 0
  ·
    have hev : modeCoef5 B G a γ m =ᶠ[nhds ξ] fun _ => (0 : Fin 3 → ℂ) :=
      Filter.eventuallyEq_of_mem hUn (fun η hη => by
        funext i
        simp [modeCoef5, hA η hη])
    exact (differentiableAt_const _).congr_of_eventuallyEq hev
  ·
    push_neg at hA
    obtain ⟨η1, hη1U, hη1⟩ := hA
    have hη1D : η1 ∈ DomC B.h qs := hη1U.1.1
    obtain ⟨-, -, hxi, het, -, -⟩ := ha.2.2.2.1 γ m η1 hη1D hη1
    have hr0 : G.r0 ≤ 1/100 := hG.1.2.1

    have hb0 : 0 ≤ bgc := by unfold bgc; linarith [Real.one_lt_sqrt_two]
    have hb1 : bgc ≤ 1 := by
      unfold bgc
      nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
    have hden : (1 + bgc ^ 2) * (1 + bgc ^ 2)⁻¹ = 1 := mul_inv_cancel₀ (by positivity)
    have id1 : ∀ w : ℝ × ℝ, w.1 = lamR w + bgc * lamT w := by
      intro w
      simp only [lamR, lamT, div_eq_mul_inv]
      linear_combination (-w.1) * hden
    have id2 : ∀ w : ℝ × ℝ, w.2 = -(bgc * lamR w) + lamT w := by
      intro w
      simp only [lamR, lamT, div_eq_mul_inv]
      linear_combination (-w.2) * hden
    have key : ∀ (R T : ℝ), |R| ≤ G.r0 / 4 → |T| ≤ G.r0 →
        |R + bgc * T| ≤ 1/80 ∧ |-(bgc * R) + T| ≤ 1/80 := by
      intro R T hR hT
      obtain ⟨hR1, hR2⟩ := abs_le.mp hR
      obtain ⟨hT1, hT2⟩ := abs_le.mp hT
      have hr0n : 0 ≤ G.r0 := le_trans (abs_nonneg _) hT
      have e1 : bgc * T ≤ G.r0 := by
        nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hT2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
      have e2 : -G.r0 ≤ bgc * T := by
        nlinarith [mul_nonneg hb0 (show 0 ≤ T + G.r0 by linarith),
          mul_nonneg (sub_nonneg.mpr hb1) hr0n]
      have e3 : bgc * R ≤ G.r0 / 4 := by
        nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hR2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
      have e4 : -(G.r0 / 4) ≤ bgc * R := by
        nlinarith [mul_nonneg hb0 (show 0 ≤ R + G.r0 / 4 by linarith),
          mul_nonneg (sub_nonneg.mpr hb1) hr0n]
      exact ⟨abs_le.mpr ⟨by linarith, by linarith⟩, abs_le.mpr ⟨by linarith, by linarith⟩⟩
    have hround : ∀ (x : ℝ) (k : ℤ), |x - k| < 1/2 → round x = k := by
      intro x k hk
      rw [round_eq, Int.floor_eq_iff]
      obtain ⟨h1, h2⟩ := abs_lt.mp hk
      constructor <;> linarith
    have hw1 : |lamR (frac0 (v η1))| ≤ G.r0 / 4 := hxi
    have hw2 : |lamT (frac0 (v η1))| ≤ G.r0 := het
    have hw := key _ _ hw1 hw2
    have ex1 : (v η1).1 - ((round (v η1).1 : ℤ) : ℝ) =
        lamR (frac0 (v η1)) + bgc * lamT (frac0 (v η1)) := id1 (frac0 (v η1))
    have ex2 : (v η1).2 - ((round (v η1).2 : ℤ) : ℝ) =
        -(bgc * lamR (frac0 (v η1))) + lamT (frac0 (v η1)) := id2 (frac0 (v η1))
    have hx1 : |(v η1).1 - ((round (v η1).1 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex1]; exact hw.1
    have hx2 : |(v η1).2 - ((round (v η1).2 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex2]; exact hw.2
    obtain ⟨kk, hkk⟩ : ∃ kk : ℝ × ℝ,
        kk = (((round (v η1).1 : ℤ) : ℝ), ((round (v η1).2 : ℤ) : ℝ)) := ⟨_, rfl⟩
    have hfr : ∀ η ∈ U, frac0 (v η) = v η - kk := by
      intro η hη
      have h1 : |(v η).1 - (v ξ).1| < 1/8 := hη.1.2
      have h2 : |(v η).2 - (v ξ).2| < 1/8 := hη.2
      have g1 : |(v η1).1 - (v ξ).1| < 1/8 := hη1U.1.2
      have g2 : |(v η1).2 - (v ξ).2| < 1/8 := hη1U.2
      obtain ⟨a1, a2⟩ := abs_lt.mp h1
      obtain ⟨a3, a4⟩ := abs_lt.mp h2
      obtain ⟨b1, b2⟩ := abs_lt.mp g1
      obtain ⟨b3, b4⟩ := abs_lt.mp g2
      obtain ⟨c1, c2⟩ := abs_le.mp hx1
      obtain ⟨c3, c4⟩ := abs_le.mp hx2
      have r1 : round (v η).1 = round (v η1).1 :=
        hround _ _ (abs_lt.mpr ⟨by linarith, by linarith⟩)
      have r2 : round (v η).2 = round (v η1).2 :=
        hround _ _ (abs_lt.mpr ⟨by linarith, by linarith⟩)
      rw [hkk]
      unfold frac0
      rw [r1, r2]
      rfl

    have hbase : ∀ i : Fin 3, DifferentiableAt ℝ (fun η : Cyl => baseC B γ.1 η i) ξ := by
      intro i
      obtain ⟨hO, hsm⟩ := geom_slow_base_smooth_v5 B hok
      have hmem : ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ) ∈
          {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
        show 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ simScale B.h ξ.2.1 (1 - ξ.2.2.1) < B.qB
        exact ⟨hr, ht, lt_of_lt_of_le hqξ hqs⟩
      have hg := ((hsm γ.1 i).contDiffAt (hO.mem_nhds hmem)).differentiableAt (by norm_num)
      have hπ : DifferentiableAt ℝ (fun η : Cyl => ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ)) ξ := by
        fun_prop
      have h2 := hg.comp ξ hπ
      exact h2

    have hZ : DifferentiableAt ℝ (fun η : Cyl => chartZ B.h γ.1 η) ξ := by
      simp only [chartZ, div_eq_mul_inv]
      fun_prop
    have hRC : DifferentiableAt ℝ (fun η : Cyl => RC γ.1 η) ξ := by
      simp only [RC, div_eq_mul_inv]
      fun_prop
    have hRC0 : RC γ.1 ξ ≠ 0 := by
      have : 0 < RC γ.1 ξ :=
        div_pos hr (Real.sqrt_pos.mpr (Real.rpow_pos_of_pos (by norm_num) _))
      exact this.ne'
    have hFang : DifferentiableAt ℝ (fun η : Cyl => Fang B γ.1 η) ξ := by
      simp only [Fang, div_eq_mul_inv]
      exact (hbase 1).mul (hRC.inv hRC0)
    have hT : DifferentiableAt ℝ (fun η : Cyl => lamT (v η - kk)) ξ := by
      simp only [hv, lamT, Jpow, div_eq_mul_inv]
      fun_prop
    have hmd : DifferentiableAt ℝ (fun η : Cyl =>
        pzr5 B G γ * chartZ B.h γ.1 η / epsb B.h γ.1 + sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 * RC γ.1 η
        - (lamT (v η - kk) + G.r0) / cib B.h γ.1 *
          (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2)) ξ := by
      simp only [div_eq_mul_inv]
      exact (((hZ.const_mul (pzr5 B G γ)).mul_const (epsb B.h γ.1)⁻¹).add
        (hRC.const_mul (sgn γ.2.2 * Bs5 B G γ * G.ustar * 2⁻¹))).sub
        (((hT.add_const G.r0).mul_const (cib B.h γ.1)⁻¹).mul
          ((hFang.const_mul (pang5 B G γ)).add ((hbase 2).const_mul (pzr5 B G γ))))

    have hev : phiL5 B G γ =ᶠ[nhds ξ] fun η : Cyl =>
        pzr5 B G γ * chartZ B.h γ.1 η / epsb B.h γ.1 + sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 * RC γ.1 η
        - (lamT (v η - kk) + G.r0) / cib B.h γ.1 *
          (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2) := by
      refine Filter.eventuallyEq_of_mem hUn (fun η hη => ?_)
      have hvco : vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = (lamT (v η - kk) + G.r0) / cib B.h γ.1 := by
        show (lamT (frac0 (v η)) + G.r0) / cib B.h γ.1 = _
        rw [hfr η hη]
      show phiL5 B G γ η = _
      unfold phiL5
      rw [hvco]
    have hp : DifferentiableAt ℝ (phiL5 B G γ) ξ := hmd.congr_of_eventuallyEq hev

    have hc : DifferentiableAt ℝ (fun η : Cyl => ((phiL5 B G γ η : ℝ) : ℂ)) ξ :=
      Complex.ofRealCLM.differentiableAt.comp ξ hp
    have hE : DifferentiableAt ℝ (fun η : Cyl =>
        Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ)))) ξ :=
      ((hc.const_mul ((kb B.h γ.1 : ℂ))).const_mul (Complex.I * (m : ℂ))).cexp
    rw [differentiableAt_pi]
    intro i
    exact (hai i).mul hE

theorem modeF5_differentiable_v5 : ∀ (h e t : ℝ) (Y0 : ℝ × ℝ) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (x : ℝ³), SimScaleProps h → t < 1 → 0 < rad x → DifferentiableAt ℝ c (ptOf x t (Yph h (rad x) t + Y0)) → DifferentiableAt ℝ (modeF5 h e t Y0 n c) x :=
by
  intro h e t Y0 n c x hS ht hrad hc

  have hcoord : ∀ (i : Fin 3) (y : ℝ³), DifferentiableAt ℝ (fun w : ℝ³ => w i) y := by
    intro i y
    have h0 : DifferentiableAt ℝ (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) i) y :=
      ContinuousLinearMap.differentiableAt _
    rwa [EuclideanSpace.coe_proj] at h0

  have hradpos : 0 < x 0 ^ 2 + x 1 ^ 2 := Real.sqrt_pos.mp hrad
  have hradD : DifferentiableAt ℝ rad x := by
    have h1 : DifferentiableAt ℝ (fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2) x :=
      ((hcoord 0 x).pow 2).add ((hcoord 1 x).pow 2)
    exact h1.sqrt hradpos.ne'
  have hinv : DifferentiableAt ℝ (fun y : ℝ³ => (rad y)⁻¹) x := hradD.inv hrad.ne'

  have hq : DifferentiableAt ℝ (fun y : ℝ³ => qC h (ptOf y t (Yph h (rad y) t + Y0)) ^ e) x := by
    have hSo : (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) ∈ nhds (x 2, 1 - t) :=
      (isOpen_univ.prod isOpen_Ioi).mem_nhds ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩
    have hSd : DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale h w.1 w.2) (x 2, 1 - t) :=
      (hS.2.2.2.1.contDiffAt hSo).differentiableAt (by simp)
    have hgd : DifferentiableAt ℝ (fun y : ℝ³ => (y 2, 1 - t)) x :=
      (hcoord 2 x).prodMk (differentiableAt_const _)
    have hcomp : DifferentiableAt ℝ (fun y : ℝ³ => simScale h (y 2) (1 - t)) x :=
      DifferentiableAt.comp (g := fun w : ℝ × ℝ => simScale h w.1 w.2)
        (f := fun y : ℝ³ => (y 2, 1 - t)) x hSd hgd
    have hpos : simScale h (x 2) (1 - t) ≠ 0 := (hS.1 (x 2) (1 - t) (by linarith)).1.ne'
    exact hcomp.rpow_const (Or.inl hpos)

  have hP : DifferentiableAt ℝ (fun y : ℝ³ => ptOf y t (Yph h (rad y) t + Y0)) x := by
    have h4 : DifferentiableAt ℝ (fun y : ℝ³ => Yph h (rad y) t + Y0) x := by
      have h5 := ((hradD.rpow_const (p := drx h) (Or.inl hrad.ne')).smul_const vrv).add_const (t • vtv)
      exact h5.add_const Y0
    exact hradD.prodMk ((hcoord 2 x).prodMk ((differentiableAt_const t).prodMk h4))

  have hnormAll : ∀ y : ℝ³, ‖(⟨y 0, y 1⟩ : ℂ)‖ = rad y := by
    intro y
    rw [Complex.norm_eq_sqrt_sq_add_sq]
    rfl
  have hE : DifferentiableAt ℝ
      (fun y : ℝ³ => Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))) x := by
    obtain ⟨g, hg⟩ : ∃ g : ℝ³ → ℂ, g = fun y => ((rad y)⁻¹ : ℝ) • (⟨y 0, y 1⟩ : ℂ) := ⟨_, rfl⟩
    have hz : DifferentiableAt ℝ (fun y : ℝ³ => (⟨y 0, y 1⟩ : ℂ)) x := by
      have e1 : (fun y : ℝ³ => (⟨y 0, y 1⟩ : ℂ)) =
          fun y => Complex.ofRealCLM (y 0) + Complex.ofRealCLM (y 1) * Complex.I := by
        funext y
        rw [Complex.mk_eq_add_mul_I]
        simp
      rw [e1]
      exact (Complex.ofRealCLM.differentiableAt.comp x (hcoord 0 x)).add
        ((Complex.ofRealCLM.differentiableAt.comp x (hcoord 1 x)).mul_const Complex.I)
    have hgD : DifferentiableAt ℝ g x := by
      rw [hg]
      exact hinv.smul hz
    have hgx : g x ≠ 0 := by
      rw [hg]
      refine smul_ne_zero (inv_ne_zero hrad.ne') ?_
      intro h0
      have h1 := hnormAll x
      rw [h0, norm_zero] at h1
      linarith
    have hpow : DifferentiableAt ℂ (fun u : ℂ => u ^ n) (g x) :=
      differentiableAt_zpow.mpr (Or.inl hgx)
    have hG : DifferentiableAt ℝ (fun y => g y ^ n) x := (hpow.restrictScalars ℝ).comp x hgD
    refine hG.congr_of_eventuallyEq ?_
    filter_upwards [hradD.continuousAt (Ioi_mem_nhds hrad)] with y hy
    have hy' : 0 < rad y := hy
    have hne : ((rad y : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hy'.ne'
    have key := Complex.norm_mul_exp_arg_mul_I (⟨y 0, y 1⟩ : ℂ)
    rw [hnormAll y] at key
    have hexp : Complex.exp (((thetaOf y : ℝ) : ℂ) * Complex.I) = g y := by
      rw [hg]
      show _ = ((rad y)⁻¹ : ℝ) • (⟨y 0, y 1⟩ : ℂ)
      rw [Complex.real_smul, Complex.ofReal_inv, eq_inv_mul_iff_mul_eq₀ hne]
      exact key
    calc Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))
        = Complex.exp ((n : ℂ) * ((thetaOf y : ℂ) * Complex.I)) := by
          congr 1
          ring
      _ = Complex.exp ((thetaOf y : ℂ) * Complex.I) ^ n := Complex.exp_int_mul _ _
      _ = g y ^ n := by rw [hexp]

  have hcP : DifferentiableAt ℝ (fun y : ℝ³ => c (ptOf y t (Yph h (rad y) t + Y0))) x :=
    hc.comp x hP
  have hv : ∀ i : Fin 3, DifferentiableAt ℝ (fun y : ℝ³ =>
      (c (ptOf y t (Yph h (rad y) t + Y0)) i *
        Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re) x := by
    intro i
    have h1 : DifferentiableAt ℝ (fun y : ℝ³ => c (ptOf y t (Yph h (rad y) t + Y0)) i) x :=
      differentiableAt_pi.1 hcP i
    have h2 := h1.mul hE
    exact Complex.reCLM.differentiableAt.comp x h2

  have heR : DifferentiableAt ℝ eR x := by
    have h1 : DifferentiableAt ℝ radVec x :=
      ((hcoord 0 x).smul_const _).add ((hcoord 1 x).smul_const _)
    exact hinv.smul h1
  have heTh : DifferentiableAt ℝ eTh x := by
    have h1 : DifferentiableAt ℝ azVec x :=
      ((hcoord 1 x).neg.smul_const _).add ((hcoord 0 x).smul_const _)
    exact hinv.smul h1

  have hcyl : DifferentiableAt ℝ (fun y : ℝ³ => cyl2cart y (fun i =>
      (c (ptOf y t (Yph h (rad y) t + Y0)) i *
        Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re)) x :=
    (((hv 0).smul heR).add ((hv 1).smul heTh)).add ((hv 2).smul_const eZ)
  exact hq.smul hcyl

theorem etaL_local_finite_v5 : ∀ (h : ℝ), SimScaleProps h → ∀ ξ0 : Cyl, ξ0.2.2.1 < 1 → ∃ N ∈ nhds ξ0, ∃ Γ : Finset Lab, ∀ (γ : Lab) (ξ : Cyl), ξ ∈ N → ξ ∈ tsupport (etaL h γ) → γ ∈ Γ :=
by
  intro h hS ξ0 hξ0

  have hLc : ∀ ξ : Cyl, ξ.2.2.1 < 1 → ContinuousAt (fun η => Real.logb 2 (qC h η)) ξ := by
    intro ξ hξ
    have hτ : 0 < 1 - ξ.2.2.1 := by linarith
    have hqpos : 0 < qC h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
    have hqcont : ContinuousAt (qC h) ξ := by
      have hU : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
      have hp : ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) :=
        ⟨trivial, hτ⟩
      have hg : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (ξ.2.1, 1 - ξ.2.2.1) :=
        hS.2.2.2.1.continuousOn.continuousAt (hU.mem_nhds hp)
      have hk : ContinuousAt (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) ξ := by fun_prop
      have he : qC h = (fun w : ℝ × ℝ => simScale h w.1 w.2) ∘
          (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by
        funext η; rfl
      rw [he]
      exact ContinuousAt.comp hg hk
    exact hqcont.logb hqpos.ne'

  have hwin : ∀ (ξ : Cyl) (γ : Lab), ξ.2.2.1 < 1 → ξ ∈ tsupport (etaL h γ) →
      |Real.logb 2 (qC h ξ) + (γ.1:ℝ)| ≤ 1 ∧
      |chartR h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1:ℝ)| ≤ 1 ∧
      |chartZ h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.1:ℝ)| ≤ 1 ∧
      |chartT h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2:ℝ)| ≤ 1 := by
    intro ξ γ hξ hγ
    have s1 : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ → 1 < |φ ξ / μ - (j : ℝ)| →
        ∀ᶠ η in nhds ξ, sqPart μ j (φ η) = 0 := by
      intro μ j φ hφ h1
      have hψ : ContinuousAt (fun η => |φ η / μ - (j : ℝ)|) ξ :=
        ((hφ.div_const μ).sub continuousAt_const).abs
      have hev := (continuousAt_const : ContinuousAt (fun _ : Cyl => (1:ℝ)) ξ).eventually_lt hψ h1
      filter_upwards [hev] with η hη
      have hsq : 1 < (φ η / μ - (j : ℝ)) ^ 2 := (one_lt_sq_iff_one_lt_abs _).mpr hη
      unfold sqPart bumpR
      rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_div]
    have key : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ →
        (∀ η, sqPart μ j (φ η) = 0 → etaL h γ η = 0) → |φ ξ / μ - (j:ℝ)| ≤ 1 := by
      intro μ j φ hφ himp
      by_contra hc
      push_neg at hc
      have hev := s1 μ j φ hφ hc
      apply (notMem_tsupport_iff_eventuallyEq.mpr _) hγ
      filter_upwards [hev] with η hη
      exact himp η hη
    refine ⟨?_, ?_, ?_, ?_⟩
    · have := key 1 (-(γ.1:ℤ)) (fun η => Real.logb 2 (qC h η)) (hLc ξ hξ)
        (fun η hη => by simp only [etaL, hη, zero_mul])
      simpa [div_one, sub_neg_eq_add] using this
    · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.1 (chartR h γ.1) (by unfold chartR; fun_prop)
        (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
    · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.1 (chartZ h γ.1) (by unfold chartZ; fun_prop)
        (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
    · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.2 (chartT h γ.1) (by unfold chartT; fun_prop)
        (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])

  obtain ⟨L0, hL0⟩ : ∃ L0 : ℝ, L0 = Real.logb 2 (qC h ξ0) := ⟨_, rfl⟩
  have hfin : (⋃ n ∈ Set.Iic ⌊2 - L0⌋₊, ({n} : Set ℕ) ×ˢ
      ((Set.Icc ⌈chartR h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartR h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋ ×ˢ
        Set.Icc ⌈chartZ h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartZ h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋ ×ˢ
        Set.Icc ⌈chartT h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartT h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋) ×ˢ
        (Set.univ : Set Bool))).Finite := by
    refine Set.Finite.biUnion (Set.finite_Iic _) (fun n _ => ?_)
    exact (Set.finite_singleton n).prod (((Set.finite_Icc _ _).prod
      ((Set.finite_Icc _ _).prod (Set.finite_Icc _ _))).prod Set.finite_univ)
  have hI : ∀ (x c : ℝ) (j : ℤ), |x - (j:ℝ)| ≤ 1 → |x - c| < 1 → j ∈ Set.Icc ⌈c - 2⌉ ⌊c + 2⌋ := by
    intro x c j hj hc
    rw [abs_le] at hj
    rw [abs_lt] at hc
    exact ⟨Int.ceil_le.mpr (by linarith [hj.2, hc.1]), Int.le_floor.mpr (by linarith [hj.1, hc.2])⟩

  have hcR : ∀ n : ℕ, ContinuousAt (chartR h n) ξ0 := fun n => by unfold chartR; fun_prop
  have hcZ : ∀ n : ℕ, ContinuousAt (chartZ h n) ξ0 := fun n => by unfold chartZ; fun_prop
  have hcT : ∀ n : ℕ, ContinuousAt (chartT h n) ξ0 := fun n => by unfold chartT; fun_prop
  have hch : ∀ (φ : Cyl → ℝ) (μ : ℝ), ContinuousAt φ ξ0 →
      ∀ᶠ ξ in nhds ξ0, |φ ξ / μ - φ ξ0 / μ| < 1 := by
    intro φ μ hφ
    exact (((hφ.div_const μ).sub continuousAt_const).abs).eventually_lt continuousAt_const
      (by simp)
  have e1 : ∀ᶠ ξ in nhds ξ0, ξ.2.2.1 < 1 :=
    (show ContinuousAt (fun ξ : Cyl => ξ.2.2.1) ξ0 by fun_prop).eventually_lt
      continuousAt_const hξ0
  have e2 : ∀ᶠ ξ in nhds ξ0, |Real.logb 2 (qC h ξ) - L0| < 1 :=
    (((hLc ξ0 hξ0).sub continuousAt_const).abs).eventually_lt continuousAt_const
      (by simp [hL0])
  have e3 : ∀ᶠ ξ in nhds ξ0, ∀ n ∈ Finset.range (⌊2 - L0⌋₊ + 1),
      |chartR h n ξ / Sb n ^ (-3:ℤ) - chartR h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
      |chartZ h n ξ / Sb n ^ (-3:ℤ) - chartZ h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
      |chartT h n ξ / Sb n ^ (-3:ℤ) - chartT h n ξ0 / Sb n ^ (-3:ℤ)| < 1 := by
    rw [Filter.eventually_all_finset]
    intro n _
    exact (hch _ _ (hcR n)).and ((hch _ _ (hcZ n)).and (hch _ _ (hcT n)))
  refine ⟨{ξ | ξ.2.2.1 < 1 ∧ |Real.logb 2 (qC h ξ) - L0| < 1 ∧
      ∀ n ∈ Finset.range (⌊2 - L0⌋₊ + 1),
      |chartR h n ξ / Sb n ^ (-3:ℤ) - chartR h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
      |chartZ h n ξ / Sb n ^ (-3:ℤ) - chartZ h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
      |chartT h n ξ / Sb n ^ (-3:ℤ) - chartT h n ξ0 / Sb n ^ (-3:ℤ)| < 1}, ?_,
    hfin.toFinset, ?_⟩
  · filter_upwards [e1, e2, e3] with ξ h1 h2 h3
    exact ⟨h1, h2, h3⟩

  rintro ⟨n, ⟨a, b, c⟩, σ⟩ ξ ⟨ht, hL, hC⟩ hγ
  obtain ⟨w0, wR, wZ, wT⟩ := hwin ξ _ ht hγ
  simp only at w0 wR wZ wT
  rw [abs_le] at w0
  rw [abs_lt] at hL
  have hn : n ≤ ⌊2 - L0⌋₊ := Nat.le_floor (by linarith [w0.2, hL.1])
  obtain ⟨cR, cZ, cT⟩ := hC n (Finset.mem_range.mpr (Nat.lt_succ_of_le hn))
  rw [Set.Finite.mem_toFinset]
  refine Set.mem_iUnion₂.mpr ⟨n, hn, ?_⟩
  exact ⟨rfl, ⟨hI _ _ _ wR cR, hI _ _ _ wZ cZ, hI _ _ _ wT cT⟩, trivial⟩

theorem wave_ucyl5_split_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (l0 : ℕ) (S : CState) (D : WC) (E : WS) (β : ℝ), qsOf l0 ≤ B.qB → InWg5 B G (qsOf l0) 1 S.Aw → InM B (qsOf l0) (1/2) S.Psi → InWg5 B G (qsOf l0) β D → ∀ ξ ∈ DomC B.h (qsOf l0), ∃ (Γ : Finset Lab) (H : Finset ℤ), (0 : ℤ) ∉ H ∧ ∀ (θ : ℝ) (a : Fin 3), ucyl5 B G l0 (waveAdd S D E) θ ξ a = ucyl5 B G l0 S θ ξ a + ∑ γ ∈ Γ, ∑ m ∈ H, inner ℝ (curl3 (modeF5 B.h (1/2 - Aex B.h) ξ.2.2.1 (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1) (m * pint5 B G γ) (modeCoef5 B G D γ m)) (rotPt ξ.1 θ ξ.2.1)) (frameAt θ ξ a) :=
by
  intro B G hok hG l0 S D E β hqB hS hP hD ξ hξ
  rcases ξ with ⟨r, z, t, Y⟩
  obtain ⟨hr, ht, hqξ⟩ : 0 < r ∧ t < 1 ∧ simScale B.h z (1 - t) < qsOf l0 := id hξ
  have hopen : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi

  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'

  obtain ⟨N, hN, Γ, hΓ⟩ := etaL_local_finite_v5 B.h hok.1 (r, z, t, Y) ht
  obtain ⟨H, hH0, hHv⟩ : ∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → S.Aw γ m = 0 ∧ D γ m = 0 := by
    obtain ⟨HS, HS0, HSv⟩ := hS.1
    obtain ⟨HD, HD0, HDv⟩ := hD.1
    exact ⟨HS ∪ HD, by simp [HS0, HD0], fun γ m hm =>
      ⟨HSv γ m (fun h => hm (Finset.mem_union_left _ h)),
        HDv γ m (fun h => hm (Finset.mem_union_right _ h))⟩⟩
  have hcov : ∀ η ∈ N ∩ DomC B.h (qsOf l0), ∀ γ m, (S.Aw γ m η ≠ 0 ∨ D γ m η ≠ 0) →
      γ ∈ Γ ∧ m ∈ H := by
    rintro η ⟨hηN, hηD⟩ γ m hne
    have hmH : m ∈ H := by
      by_contra hm
      obtain ⟨h1, h2⟩ := hHv γ m hm
      rcases hne with hne | hne
      · exact hne (by simp [h1])
      · exact hne (by simp [h2])
    refine ⟨?_, hmH⟩
    rcases hne with hne | hne
    · exact hΓ γ η hηN (hS.2.2.2.1 γ m η hηD hne).2.1
    · exact hΓ γ η hηN (hD.2.2.2.1 γ m η hηD hne).2.1
  have hsuppS : ∀ η ∈ N ∩ DomC B.h (qsOf l0), ∀ γ m, S.Aw γ m η ≠ 0 → γ ∈ Γ ∧ m ∈ H :=
    fun η hη γ m hne => hcov η hη γ m (Or.inl hne)
  have hsuppN : ∀ η ∈ N ∩ DomC B.h (qsOf l0), ∀ γ m, (S.Aw + D) γ m η ≠ 0 → γ ∈ Γ ∧ m ∈ H := by
    intro η hη γ m hne
    apply hcov η hη γ m
    by_contra hc
    push_neg at hc
    apply hne
    show S.Aw γ m η + D γ m η = 0
    rw [hc.1, hc.2, add_zero]

  have hexp : ∀ (A : WC) (θ' : ℝ) (η : Cyl), (∀ γ m, A γ m η ≠ 0 → γ ∈ Γ ∧ m ∈ H) →
      waveV5 B G A θ' η = ∑ γ ∈ Γ, ∑ m ∈ H, (fun i => (modeCoef5 B G A γ m η i *
        Complex.exp (Complex.I * (((m * pint5 B G γ : ℤ)) : ℂ) * (θ' : ℂ))).re) := by
    intro A θ' η hA
    funext i
    have hph : ∀ γ m, A γ m η i * ephase5 B G γ m θ' η = modeCoef5 B G A γ m η i *
        Complex.exp (Complex.I * (((m * pint5 B G γ : ℤ)) : ℂ) * (θ' : ℂ)) := by
      intro γ m
      simp only [ephase5, modeCoef5]
      rw [mul_assoc (A γ m η i), ← Complex.exp_add]
      congr 2
      push_cast
      ring
    have hin : ∀ γ, ∑ᶠ m : ℤ, A γ m η i * ephase5 B G γ m θ' η =
        ∑ m ∈ H, A γ m η i * ephase5 B G γ m θ' η := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      rw [Function.support_subset_iff']
      intro m hm
      by_contra hne
      have hA0 : A γ m η ≠ 0 := fun h0 => hne (by simp [h0])
      exact hm (Finset.mem_coe.mpr (hA γ m hA0).2)
    have hout : (Function.support fun γ => ∑ m ∈ H, A γ m η i * ephase5 B G γ m θ' η) ⊆ ↑Γ := by
      rw [Function.support_subset_iff']
      intro γ hγ
      apply Finset.sum_eq_zero
      intro m _
      by_contra hne
      have hA0 : A γ m η ≠ 0 := fun h0 => hne (by simp [h0])
      exact hγ (Finset.mem_coe.mpr (hA γ m hA0).1)
    simp only [waveV5, Finset.sum_apply]
    rw [finsum_congr hin, finsum_eq_sum_of_support_subset _ hout, Complex.re_sum]
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [Complex.re_sum]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    rw [hph]

  have hcyl_sum : ∀ (y : ℝ³) {ι : Type} (s : Finset ι) (v : ι → Fin 3 → ℝ),
      cyl2cart y (∑ j ∈ s, v j) = ∑ j ∈ s, cyl2cart y (v j) := by
    intro y ι s v
    let L : (Fin 3 → ℝ) →+ ℝ³ := AddMonoidHom.mk' (cyl2cart y) (fun c d => by
      simp only [cyl2cart, Pi.add_apply, add_smul]; abel)
    exact map_sum L v s

  have hcurl : ∀ (F F' : ℝ³ → ℝ³) {ι : Type} (s : Finset ι) (g : ι → ℝ³ → ℝ³) (x : ℝ³),
      F' =ᶠ[nhds x] (fun y => F y + ∑ i ∈ s, g i y) → DifferentiableAt ℝ F x →
      (∀ i ∈ s, DifferentiableAt ℝ (g i) x) → curl3 F' x = curl3 F x + ∑ i ∈ s, curl3 (g i) x := by
    intro F F' ι s g x hev hF hg
    have hfd : fderiv ℝ F' x = fderiv ℝ F x + ∑ i ∈ s, fderiv ℝ (g i) x := by
      rw [hev.fderiv_eq, fderiv_fun_add hF (DifferentiableAt.fun_sum hg), fderiv_fun_sum hg]
    let cH : (ℝ³ →L[ℝ] ℝ³) →+ ℝ³ := AddMonoidHom.mk' (fun L =>
      (L (EuclideanSpace.single 1 1) 2 - L (EuclideanSpace.single 2 1) 1) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
      (L (EuclideanSpace.single 2 1) 0 - L (EuclideanSpace.single 0 1) 2) • EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
      (L (EuclideanSpace.single 0 1) 1 - L (EuclideanSpace.single 1 1) 0) • EuclideanSpace.single (2 : Fin 3) (1 : ℝ))
      (by
        intro L1 L2
        simp only [ContinuousLinearMap.add_apply, PiLp.add_apply, add_smul, sub_smul]
        abel)
    have e1 : ∀ G' : ℝ³ → ℝ³, curl3 G' x = cH (fderiv ℝ G' x) := fun G' => rfl
    have e2 : ∑ i ∈ s, curl3 (g i) x = ∑ i ∈ s, cH (fderiv ℝ (g i) x) :=
      Finset.sum_congr rfl (fun i _ => e1 (g i))
    rw [e2, e1 F', e1 F, hfd, map_add, map_sum]
  refine ⟨Γ, H, hH0, fun θ a => ?_⟩
  dsimp only

  obtain ⟨x, hxdef⟩ : ∃ x : ℝ³, x = rotPt r θ z := ⟨_, rfl⟩
  have hx0 : x 0 = r * Real.cos θ := by rw [hxdef]; simp [rotPt]
  have hx1 : x 1 = r * Real.sin θ := by rw [hxdef]; simp [rotPt]
  have hx2 : x 2 = z := by rw [hxdef]; simp [rotPt]
  have hsq : x 0 ^ 2 + x 1 ^ 2 = r ^ 2 := by
    rw [hx0, hx1]; linear_combination r ^ 2 * Real.sin_sq_add_cos_sq θ
  have hrad : rad x = r := by
    show Real.sqrt (x 0 ^ 2 + x 1 ^ 2) = r
    rw [hsq, Real.sqrt_sq hr.le]
  have hradd : DifferentiableAt ℝ rad x := by
    have h1 : DifferentiableAt ℝ (fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2) x := by fun_prop
    exact h1.sqrt (by rw [hsq]; exact (pow_pos hr 2).ne')
  have hPx : ptOf x t (Yph B.h (rad x) t + (Y - Yph B.h r t)) = (r, z, t, Y) := by
    simp [ptOf, hrad, hx2]
  have hPd : DifferentiableAt ℝ (fun y : ℝ³ => ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) x := by
    have hr1 : DifferentiableAt ℝ (fun y : ℝ³ => rad y ^ drx B.h) x :=
      hradd.rpow_const (Or.inl (by rw [hrad]; exact hr.ne'))
    have h2 : DifferentiableAt ℝ (fun y : ℝ³ => y 2) x := by fun_prop
    have h4 : DifferentiableAt ℝ (fun y : ℝ³ => Yph B.h (rad y) t + (Y - Yph B.h r t)) x :=
      ((hr1.smul_const vrv).add_const (t • vtv)).add_const _
    exact hradd.prodMk (h2.prodMk ((differentiableAt_const t).prodMk h4))
  have hq_d : DifferentiableAt ℝ (fun y : ℝ³ => simScale B.h (y 2) (1 - t)) x := by
    have hmem : ((x 2, 1 - t) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ)) :=
      ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩
    have h1 : DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (x 2, 1 - t) :=
      (hok.1.2.2.2.1.contDiffAt (hopen.mem_nhds hmem)).differentiableAt (by norm_num)
    have h2 : DifferentiableAt ℝ (fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ)) x := by fun_prop
    exact DifferentiableAt.comp (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2) x h1 h2
  have hNx : N ∩ DomC B.h (qsOf l0) ∈ nhds (ptOf x t (Yph B.h (rad x) t + (Y - Yph B.h r t))) := by
    rw [hPx]; exact Filter.inter_mem hN (hDopen.mem_nhds hξ)
  have hO : ∀ᶠ y in nhds x, 0 < rad y ∧ simScale B.h (y 2) (1 - t) < qsOf l0 ∧
      ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t)) ∈ N ∩ DomC B.h (qsOf l0) := by
    have e1 : ∀ᶠ y in nhds x, (0:ℝ) < rad y :=
      continuousAt_const.eventually_lt hradd.continuousAt (by rw [hrad]; exact hr)
    have e2 : ∀ᶠ y in nhds x, simScale B.h (y 2) (1 - t) < qsOf l0 :=
      hq_d.continuousAt.eventually_lt continuousAt_const (by rw [hx2]; exact hqξ)
    have e3 : ∀ᶠ y in nhds x, ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t)) ∈ N ∩ DomC B.h (qsOf l0) :=
      hPd.continuousAt.preimage_mem_nhds hNx
    exact e1.and (e2.and e3)

  have hloc : ∀ (S' : CState) (A : WC) (Ψ : Cyl → ℝ), S'.Aw = A → S'.Psi = Ψ →
      (∀ η ∈ N ∩ DomC B.h (qsOf l0), ∀ γ m, A γ m η ≠ 0 → γ ∈ Γ ∧ m ∈ H) →
      (fun y => AX5 B G l0 S' y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) =ᶠ[nhds x]
      (fun y => B.AB y t + ((∑ γ ∈ Γ, ∑ m ∈ H, modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
          (m * pint5 B G γ) (modeCoef5 B G A γ m) y) +
        qC B.h (ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) ^ (1/2 - Aex B.h) •
          (Ψ (ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) • eTh y))) := by
    intro S' A Ψ hA hΨ hsupp
    subst hA hΨ
    filter_upwards [hO] with y hy
    obtain ⟨hy1, hy2, hy3⟩ := hy
    have hcorr : corrOn B l0 y t := ⟨hy1, ht, hy2⟩
    simp only [AX5]
    rw [if_pos hcorr, smul_add, hexp S'.Aw (thetaOf y) _ (hsupp _ hy3), hcyl_sum, Finset.smul_sum]
    congr 2
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [hcyl_sum, Finset.smul_sum]
    all_goals rfl
  have hNl := hloc (waveAdd S D E) (S.Aw + D) S.Psi rfl rfl hsuppN
  have hSl := hloc S S.Aw S.Psi rfl rfl hsuppS

  have hcoef : ∀ γ m, modeCoef5 B G (S.Aw + D) γ m =
      fun η i => modeCoef5 B G S.Aw γ m η i + modeCoef5 B G D γ m η i := by
    intro γ m; funext η i; simp only [modeCoef5, Pi.add_apply, add_mul]
  have hmadd : ∀ (n : ℤ) (c d : Cyl → (Fin 3 → ℂ)) (y : ℝ³),
      modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) n (fun η i => c η i + d η i) y =
        modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) n c y +
          modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) n d y := by
    intro n c d y
    simp only [modeF5]
    rw [← smul_add]
    congr 1
    simp only [cyl2cart, add_mul, Complex.add_re, add_smul]
    abel
  have hev : (fun y => AX5 B G l0 (waveAdd S D E) y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) =ᶠ[nhds x]
      (fun y => AX5 B G l0 S y t (Yph B.h (rad y) t + (Y - Yph B.h r t)) +
        ∑ p ∈ Γ ×ˢ H, modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (p.2 * pint5 B G p.1)
          (modeCoef5 B G D p.1 p.2) y) := by
    filter_upwards [hNl, hSl] with y h1 h2
    rw [h1, h2]
    simp only [hcoef, hmadd, Finset.sum_add_distrib, Finset.sum_product]
    abel

  have hPxr : 0 < rad x := by rw [hrad]; exact hr
  have hMS : ∀ γ m, DifferentiableAt ℝ (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
      (m * pint5 B G γ) (modeCoef5 B G S.Aw γ m)) x := by
    intro γ m
    refine modeF5_differentiable_v5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
      (modeCoef5 B G S.Aw γ m) x hok.1 ht hPxr ?_
    rw [hPx]
    exact modeCoef5_differentiable_v5 B G hok hG (qsOf l0) 1 S.Aw hqB hS γ m _ hξ
  have hMD : ∀ γ m, DifferentiableAt ℝ (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
      (m * pint5 B G γ) (modeCoef5 B G D γ m)) x := by
    intro γ m
    refine modeF5_differentiable_v5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
      (modeCoef5 B G D γ m) x hok.1 ht hPxr ?_
    rw [hPx]
    exact modeCoef5_differentiable_v5 B G hok hG (qsOf l0) β D hqB hD γ m _ hξ
  have hAB : DifferentiableAt ℝ (fun y => B.AB y t) x := by
    have hmem2 : ((x 2, 1 - t) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ)) :=
      ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩
    have hc1 : ContinuousAt (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) (x, t) := by
      have h1 : ContinuousAt (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (x 2, 1 - t) :=
        (hok.1.2.2.2.1.contDiffAt (hopen.mem_nhds hmem2)).continuousAt
      have h2 : ContinuousAt (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) (x, t) := by fun_prop
      exact ContinuousAt.comp (x := ((x, t) : ℝ³ × ℝ)) (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2)
        (f := fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) h1 h2
    have hmemN : simDomain B.h B.qB ∈ nhds ((x, t) : ℝ³ × ℝ) := by
      have e1 : ∀ᶠ w in nhds ((x, t) : ℝ³ × ℝ), w.2 < 1 :=
        continuousAt_snd.eventually_lt continuousAt_const ht
      have e2 : ∀ᶠ w in nhds ((x, t) : ℝ³ × ℝ), simScale B.h (w.1 2) (1 - w.2) < B.qB :=
        hc1.eventually_lt continuousAt_const (by
          show simScale B.h (x 2) (1 - t) < B.qB
          rw [hx2]; exact lt_of_lt_of_le hqξ hqB)
      filter_upwards [e1, e2] with w h1 h2
      exact ⟨h1, h2⟩
    have hcd : DifferentiableAt ℝ (↿B.AB) ((x, t) : ℝ³ × ℝ) :=
      (hok.2.2.2.2.1.1.contDiffAt hmemN).differentiableAt (by norm_num)
    have hpm : DifferentiableAt ℝ (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) x :=
      differentiableAt_id.prodMk (differentiableAt_const t)
    exact DifferentiableAt.comp (g := ↿B.AB) x hcd hpm
  have hΨ : DifferentiableAt ℝ (fun y => qC B.h (ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) ^
      (1/2 - Aex B.h) • (S.Psi (ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) • eTh y)) x := by
    have hqpos : 0 < simScale B.h (x 2) (1 - t) := (hok.1.1 _ (1 - t) (by linarith)).1
    have h1 : DifferentiableAt ℝ (fun y : ℝ³ => simScale B.h (y 2) (1 - t) ^ (1/2 - Aex B.h)) x :=
      hq_d.rpow_const (Or.inl hqpos.ne')
    have hPsi0 : DifferentiableAt ℝ S.Psi (ptOf x t (Yph B.h (rad x) t + (Y - Yph B.h r t))) := by
      rw [hPx]; exact (hP.1.contDiffAt (hDopen.mem_nhds hξ)).differentiableAt (by norm_num)
    have h2 := hPsi0.comp x hPd
    have h3 : DifferentiableAt ℝ (fun y => eTh y) x := by
      have hi := hradd.inv (by rw [hrad]; exact hr.ne')
      have ha : DifferentiableAt ℝ (fun y : ℝ³ => azVec y) x := by unfold azVec; fun_prop
      exact hi.smul ha
    exact h1.smul (h2.smul h3)
  have hFSd : DifferentiableAt ℝ (fun y => AX5 B G l0 S y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) x := by
    rw [hSl.differentiableAt_iff]
    exact hAB.add ((DifferentiableAt.fun_sum (fun γ _ => DifferentiableAt.fun_sum
      (fun m _ => hMS γ m))).add hΨ)
  have hcurlEq := hcurl (fun y => AX5 B G l0 S y t (Yph B.h (rad y) t + (Y - Yph B.h r t)))
    (fun y => AX5 B G l0 (waveAdd S D E) y t (Yph B.h (rad y) t + (Y - Yph B.h r t)))
    (Γ ×ˢ H) (fun p => modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (p.2 * pint5 B G p.1)
      (modeCoef5 B G D p.1 p.2)) x hev hFSd (fun p _ => hMD p.1 p.2)

  have hu : ∀ S' : CState, ucyl5 B G l0 S' θ (r, z, t, Y) a =
      inner ℝ (curl3 (fun y => AX5 B G l0 S' y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) x +
        BX B G l0 S' x t Y) (frameAt θ (r, z, t, Y) a) := by
    intro S'
    subst hxdef
    simp only [ucyl5, uX5, curlX, evOff, hrad]
  have hBX : BX B G l0 (waveAdd S D E) x t Y = BX B G l0 S x t Y := rfl
  rw [hu (waveAdd S D E), hu S, hcurlEq, hBX, ← hxdef]
  simp only [inner_add_left, sum_inner, Finset.sum_product]
  exact add_right_comm _ _ _

theorem mode_curl_trig_v5 : ∀ (h e t : ℝ) (Y0 : ℝ × ℝ) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (r z : ℝ), 0 < r → DifferentiableAt ℝ (modeF5 h e t Y0 n c) (rotPt r 0 z) → DifferentiableAt ℝ (modeF5 h e t Y0 n (fun η i => Complex.I * c η i)) (rotPt r 0 z) → ∀ (Y : ℝ × ℝ) (a : Fin 3), ∃ A1 A2 : ℝ, ∀ θ : ℝ, inner ℝ (curl3 (modeF5 h e t Y0 n c) (rotPt r θ z)) (frameAt θ (r, z, t, Y) a) = Real.cos (n * θ) * A1 + Real.sin (n * θ) * A2 :=
by

  have hc : ∀ (φ : ℝ) (y : ℝ³), rotZ5 φ y 0 = Real.cos φ * y 0 - Real.sin φ * y 1 ∧
      rotZ5 φ y 1 = Real.sin φ * y 0 + Real.cos φ * y 1 ∧ rotZ5 φ y 2 = y 2 := by
    intro φ y
    simp [rotZ5]
  have ext3 : ∀ u v : ℝ³, u 0 = v 0 → u 1 = v 1 → u 2 = v 2 → u = v := by
    intro u v h0 h1 h2
    ext i
    fin_cases i
    · exact h0
    · exact h1
    · exact h2
  have hinv : ∀ (φ : ℝ) (y : ℝ³), rotZ5 φ (rotZ5 (-φ) y) = y := by
    intro φ y
    obtain ⟨a0, a1, a2⟩ := hc φ (rotZ5 (-φ) y)
    obtain ⟨b0, b1, b2⟩ := hc (-φ) y
    apply ext3
    · rw [a0, b0, b1, Real.cos_neg, Real.sin_neg]
      linear_combination y 0 * Real.cos_sq_add_sin_sq φ
    · rw [a1, b0, b1, Real.cos_neg, Real.sin_neg]
      linear_combination y 1 * Real.cos_sq_add_sin_sq φ
    · rw [a2, b2]
  have hrad : ∀ (φ : ℝ) (y : ℝ³), rad (rotZ5 φ y) = rad y := by
    intro φ y
    obtain ⟨a0, a1, -⟩ := hc φ y
    unfold rad
    rw [a0, a1]
    congr 1
    linear_combination (y 0 ^ 2 + y 1 ^ 2) * Real.cos_sq_add_sin_sq φ

  have hlin : ∀ φ : ℝ, ∃ L : ℝ³ →L[ℝ] ℝ³, ∀ v : ℝ³, L v = rotZ5 φ v := by
    intro φ
    let f : ℝ³ →ₗ[ℝ] ℝ³ :=
      { toFun := rotZ5 φ
        map_add' := fun u v => by
          apply ext3 <;> simp [hc] <;> ring
        map_smul' := fun a u => by
          apply ext3 <;> simp [hc] <;> ring }
    exact ⟨⟨f, f.continuous_of_finiteDimensional⟩, fun v => rfl⟩

  have hinner : ∀ (φ : ℝ) (u v : ℝ³), inner ℝ (rotZ5 φ u) (rotZ5 φ v) = inner ℝ u v := by
    intro φ u v
    have e : ∀ a b : ℝ³, inner ℝ a b = a 0 * b 0 + a 1 * b 1 + a 2 * b 2 := by
      intro a b
      simp [PiLp.inner_apply, Fin.sum_univ_three]
      ring
    rw [e, e]
    obtain ⟨a0, a1, a2⟩ := hc φ u
    obtain ⟨b0, b1, b2⟩ := hc φ v
    rw [a0, a1, a2, b0, b1, b2]
    linear_combination (u 0 * v 0 + u 1 * v 1) * Real.cos_sq_add_sin_sq φ

  have hpt : ∀ r φ z : ℝ, rotPt r φ z = rotZ5 φ (rotPt r 0 z) := by
    intro r φ z
    apply ext3 <;> simp [rotPt, hc] <;> ring

  have hframe : ∀ (φ : ℝ) (y : ℝ³), eR (rotZ5 φ y) = rotZ5 φ (eR y) ∧
      eTh (rotZ5 φ y) = rotZ5 φ (eTh y) ∧ rotZ5 φ eZ = eZ := by
    intro φ y
    refine ⟨?_, ?_, ?_⟩
    · apply ext3 <;> simp [eR, radVec, hc, hrad] <;> ring
    · apply ext3 <;> simp [eTh, azVec, hc, hrad] <;> ring
    · apply ext3 <;> simp [eZ, hc]

  have hphase : ∀ (φ : ℝ) (y : ℝ³) (n : ℤ), 0 < rad y →
      Complex.exp (Complex.I * (n : ℂ) * (thetaOf (rotZ5 φ y) : ℂ)) =
        Complex.exp (Complex.I * (n : ℂ) * (φ : ℂ)) *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ)) := by
    intro φ y n hy
    obtain ⟨w, hw⟩ : ∃ w : ℂ, w = ⟨y 0, y 1⟩ := ⟨_, rfl⟩
    obtain ⟨w', hw'⟩ : ∃ w' : ℂ, w' = ⟨rotZ5 φ y 0, rotZ5 φ y 1⟩ := ⟨_, rfl⟩
    have hth : thetaOf y = w.arg := by rw [hw]; rfl
    have hth' : thetaOf (rotZ5 φ y) = w'.arg := by rw [hw']; rfl
    have hww : w' = Complex.exp ((φ : ℂ) * Complex.I) * w := by
      obtain ⟨a0, a1, -⟩ := hc φ y
      apply Complex.ext
      · rw [Complex.mul_re, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im, hw, hw', a0]
      · rw [Complex.mul_im, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im, hw, hw', a1]
        simp only
        ring
    have hnorm : ‖w‖ = rad y := by
      rw [Complex.norm_eq_sqrt_sq_add_sq, hw]
      rfl
    have hw0 : ((‖w‖ : ℝ) : ℂ) ≠ 0 := by
      rw [hnorm]
      exact_mod_cast hy.ne'
    have hnorm' : ‖w'‖ = ‖w‖ := by
      rw [hww, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
    have key : Complex.exp ((w'.arg : ℂ) * Complex.I) =
        Complex.exp ((φ : ℂ) * Complex.I) * Complex.exp ((w.arg : ℂ) * Complex.I) := by
      apply mul_left_cancel₀ hw0
      have h1 := Complex.norm_mul_exp_arg_mul_I w'
      have h2 := Complex.norm_mul_exp_arg_mul_I w
      rw [hnorm'] at h1
      calc ((‖w‖ : ℝ) : ℂ) * Complex.exp ((w'.arg : ℂ) * Complex.I) = w' := h1
        _ = Complex.exp ((φ : ℂ) * Complex.I) * w := hww
        _ = Complex.exp ((φ : ℂ) * Complex.I) * (((‖w‖ : ℝ) : ℂ) * Complex.exp ((w.arg : ℂ) * Complex.I)) := by
            rw [h2]
        _ = _ := by ring
    have hpow : ∀ α : ℝ, Complex.exp (Complex.I * (n : ℂ) * (α : ℂ)) =
        Complex.exp ((α : ℂ) * Complex.I) ^ n := by
      intro α
      rw [← Complex.exp_int_mul]
      congr 1
      ring
    rw [hpow, hpow, hpow, hth, hth', key, mul_zpow]

  have hmode : ∀ (h e t : ℝ) (Y0 : ℝ × ℝ) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (φ : ℝ) (y : ℝ³),
      0 < rad y → modeF5 h e t Y0 n c (rotZ5 φ y) =
        rotZ5 φ (Real.cos (n * φ) • modeF5 h e t Y0 n c y +
          Real.sin (n * φ) • modeF5 h e t Y0 n (fun η i => Complex.I * c η i) y) := by
    intro h e t Y0 n c φ y hy
    have hP : ptOf (rotZ5 φ y) t (Yph h (rad (rotZ5 φ y)) t + Y0) =
        ptOf y t (Yph h (rad y) t + Y0) := by
      simp only [ptOf, hrad, (hc φ y).2.2]
    have hco : ∀ κ E : ℂ, (κ * (Complex.exp (Complex.I * (n : ℂ) * (φ : ℂ)) * E)).re =
        Real.cos (n * φ) * (κ * E).re + Real.sin (n * φ) * (Complex.I * κ * E).re := by
      intro κ E
      have hx : Complex.exp (Complex.I * (n : ℂ) * (φ : ℂ)) =
          Complex.exp (((n * φ : ℝ) : ℂ) * Complex.I) := by
        congr 1
        push_cast
        ring
      rw [hx, show κ * (Complex.exp (((n * φ : ℝ) : ℂ) * Complex.I) * E) =
          Complex.exp (((n * φ : ℝ) : ℂ) * Complex.I) * (κ * E) by ring,
        Complex.mul_re, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im,
        mul_assoc Complex.I, Complex.I_mul_re]
      ring
    obtain ⟨L, hL⟩ := hlin φ
    obtain ⟨f1, f2, f3⟩ := hframe φ y
    simp only [modeF5, cyl2cart]
    rw [hP, hphase φ y n hy, f1, f2]
    conv_lhs => rw [← f3]
    simp only [← hL, map_add, map_smul, hco]
    module

  have hcurl : ∀ (φ : ℝ) (F G : ℝ³ → ℝ³) (x : ℝ³), DifferentiableAt ℝ G x →
      F =ᶠ[nhds (rotZ5 φ x)] (fun y => rotZ5 φ (G (rotZ5 (-φ) y))) →
      curl3 F (rotZ5 φ x) = rotZ5 φ (curl3 G x) := by
    intro φ F G x hG hF
    obtain ⟨L, hL⟩ := hlin φ
    obtain ⟨L', hL'⟩ := hlin (-φ)
    have hx : L' (L x) = x := by
      rw [hL, hL']
      have := hinv (-φ) x
      rwa [neg_neg] at this
    have hfun : (fun y => rotZ5 φ (G (rotZ5 (-φ) y))) = ⇑L ∘ G ∘ ⇑L' := by
      funext y
      simp only [Function.comp, hL, hL']
    have hD : HasFDerivAt (⇑L ∘ G ∘ ⇑L') (L.comp ((fderiv ℝ G x).comp L')) (L x) := by
      have h1 : HasFDerivAt G (fderiv ℝ G x) (L' (L x)) := by
        rw [hx]
        exact hG.hasFDerivAt
      exact L.hasFDerivAt.comp (L x) (h1.comp (L x) L'.hasFDerivAt)
    have hDF : fderiv ℝ F (rotZ5 φ x) = L.comp ((fderiv ℝ G x).comp L') := by
      rw [hF.fderiv_eq, hfun, ← hL x]
      exact hD.fderiv
    have e0 : L' (EuclideanSpace.single 0 1) =
        Real.cos φ • EuclideanSpace.single 0 1 - Real.sin φ • EuclideanSpace.single 1 1 := by
      rw [hL']
      apply ext3 <;> simp [hc]
    have e1 : L' (EuclideanSpace.single 1 1) =
        Real.sin φ • EuclideanSpace.single 0 1 + Real.cos φ • EuclideanSpace.single 1 1 := by
      rw [hL']
      apply ext3 <;> simp [hc]
    have e2 : L' (EuclideanSpace.single 2 1) = EuclideanSpace.single 2 1 := by
      rw [hL']
      apply ext3 <;> simp [hc]
    apply ext3
    · simp only [curl3, hDF, ContinuousLinearMap.comp_apply, e0, e1, e2, map_add, map_sub, map_smul, hL]
      simp [hc]
      ring
    · simp only [curl3, hDF, ContinuousLinearMap.comp_apply, e0, e1, e2, map_add, map_sub, map_smul, hL]
      simp [hc]
      ring
    · simp only [curl3, hDF, ContinuousLinearMap.comp_apply, e0, e1, e2, map_add, map_sub, map_smul, hL]
      simp [hc]
      linear_combination (fderiv ℝ G x (EuclideanSpace.single 0 1) 1 -
        fderiv ℝ G x (EuclideanSpace.single 1 1) 0) * Real.cos_sq_add_sin_sq φ

  have hcl : ∀ (F1 F2 : ℝ³ → ℝ³) (a b : ℝ) (x : ℝ³), DifferentiableAt ℝ F1 x →
      DifferentiableAt ℝ F2 x →
      curl3 (fun y => a • F1 y + b • F2 y) x = a • curl3 F1 x + b • curl3 F2 x := by
    intro F1 F2 a b x h1 h2
    have h1' : DifferentiableAt ℝ (fun y => a • F1 y) x := h1.const_smul a
    have h2' : DifferentiableAt ℝ (fun y => b • F2 y) x := h2.const_smul b
    have hD : fderiv ℝ (fun y => a • F1 y + b • F2 y) x = a • fderiv ℝ F1 x + b • fderiv ℝ F2 x := by
      rw [fderiv_fun_add h1' h2', fderiv_fun_const_smul h1, fderiv_fun_const_smul h2]
    apply ext3 <;> simp [curl3, hD] <;> ring

  intro h e t Y0 n c r z hr hd1 hd2 Y a
  refine ⟨inner ℝ (curl3 (modeF5 h e t Y0 n c) (rotPt r 0 z)) (frameAt 0 (r, z, t, Y) a),
    inner ℝ (curl3 (modeF5 h e t Y0 n (fun η i => Complex.I * c η i)) (rotPt r 0 z))
      (frameAt 0 (r, z, t, Y) a), fun θ => ?_⟩
  have hradx0 : rad (rotPt r 0 z) = r := by
    simp [rad, rotPt, Real.sqrt_sq hr.le]
  have hU : IsOpen {y : ℝ³ | 0 < rad y} := by
    apply isOpen_lt continuous_const
    unfold rad
    fun_prop
  have hmem : rotZ5 θ (rotPt r 0 z) ∈ {y : ℝ³ | 0 < rad y} := by
    show 0 < rad (rotZ5 θ (rotPt r 0 z))
    rw [hrad, hradx0]
    exact hr
  have hev : modeF5 h e t Y0 n c =ᶠ[nhds (rotZ5 θ (rotPt r 0 z))]
      (fun y => rotZ5 θ ((fun y' => Real.cos (n * θ) • modeF5 h e t Y0 n c y' +
        Real.sin (n * θ) • modeF5 h e t Y0 n (fun η i => Complex.I * c η i) y') (rotZ5 (-θ) y))) := by
    apply Filter.eventuallyEq_of_mem (hU.mem_nhds hmem)
    intro y hy
    have hy' : 0 < rad (rotZ5 (-θ) y) := by
      rw [hrad]
      exact hy
    have := hmode h e t Y0 n c θ (rotZ5 (-θ) y) hy'
    rw [hinv θ y] at this
    exact this
  have hGd : DifferentiableAt ℝ (fun y' => Real.cos (n * θ) • modeF5 h e t Y0 n c y' +
      Real.sin (n * θ) • modeF5 h e t Y0 n (fun η i => Complex.I * c η i) y') (rotPt r 0 z) := by
    have := (hd1.const_smul (Real.cos (n * θ))).add (hd2.const_smul (Real.sin (n * θ)))
    exact this
  have h1 := hcurl θ _ _ (rotPt r 0 z) hGd hev
  rw [hcl _ _ _ _ _ hd1 hd2] at h1
  have hfr : frameAt θ (r, z, t, Y) a = rotZ5 θ (frameAt 0 (r, z, t, Y) a) := by
    fin_cases a
    · show eR (rotPt r θ z) = rotZ5 θ (eR (rotPt r 0 z))
      rw [hpt r θ z]
      exact (hframe θ _).1
    · show eTh (rotPt r θ z) = rotZ5 θ (eTh (rotPt r 0 z))
      rw [hpt r θ z]
      exact (hframe θ _).2.1
    · show eZ = rotZ5 θ eZ
      exact (hframe θ eZ).2.2.symm
  rw [hpt r θ z, h1, hfr, hinner, inner_add_left, real_inner_smul_left, real_inner_smul_left]

theorem wave_increment_mean_invariance_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ,
    ∀ l0 : ℕ, l1 ≤ l0 → ∀ (S : CState) (D : WC) (E : WS) (β : ℝ),
    InWg5 B G (qsOf l0) 1 S.Aw → InM B (qsOf l0) (1/2) S.Psi → InM B (qsOf l0) (1/2) S.bdir →
    InWg5 B G (qsOf l0) β D →
    ∀ (a : Fin 3), ∀ ξ ∈ DomC B.h (qsOf l0), mcor5 B G l0 (waveAdd S D E) a ξ = mcor5 B G l0 S a ξ :=
by
  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, ?_⟩
  intro l0 hl0 S D E β hS hP _ hD a ξ hξ

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hq : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  have hξ' := hξ
  obtain ⟨hr, ht, -⟩ := hξ'

  obtain ⟨Γ, H, hH0, hsplit⟩ := wave_ucyl5_split_v5 B G hok hG l0 S D E β hq hS hP hD ξ hξ

  have e0 : (rotPt ξ.1 0 ξ.2.1) 0 = ξ.1 := by simp [rotPt]
  have e1 : (rotPt ξ.1 0 ξ.2.1) 1 = 0 := by simp [rotPt]
  have e2 : (rotPt ξ.1 0 ξ.2.1) 2 = ξ.2.1 := by simp [rotPt]
  have hrad : rad (rotPt ξ.1 0 ξ.2.1) = ξ.1 := by
    rw [rad, e0, e1]
    simp [Real.sqrt_sq hr.le]
  have hpt : ptOf (rotPt ξ.1 0 ξ.2.1) ξ.2.2.1
      (Yph B.h (rad (rotPt ξ.1 0 ξ.2.1)) ξ.2.2.1 + (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1)) = ξ := by
    simp [ptOf, hrad, e2]

  have htrig : ∀ γ ∈ Γ, ∀ m ∈ H, ∃ A1 A2 : ℝ, ∀ θ : ℝ,
      inner ℝ (curl3 (modeF5 B.h (1/2 - Aex B.h) ξ.2.2.1 (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1)
        (m * pint5 B G γ) (modeCoef5 B G D γ m)) (rotPt ξ.1 θ ξ.2.1)) (frameAt θ ξ a) =
        Real.cos (((m * pint5 B G γ : ℤ) : ℝ) * θ) * A1 +
          Real.sin (((m * pint5 B G γ : ℤ) : ℝ) * θ) * A2 := by
    intro γ _ m _
    have hc : DifferentiableAt ℝ (modeCoef5 B G D γ m) ξ :=
      modeCoef5_differentiable_v5 B G hok hG (qsOf l0) β D hq hD γ m ξ hξ
    have hc' : DifferentiableAt ℝ (fun η i => Complex.I * modeCoef5 B G D γ m η i) ξ := by
      rw [differentiableAt_pi] at hc ⊢
      intro i
      exact (hc i).const_mul Complex.I
    have hrad0 : 0 < rad (rotPt ξ.1 0 ξ.2.1) := by rw [hrad]; exact hr
    have h1 := modeF5_differentiable_v5 B.h (1/2 - Aex B.h) ξ.2.2.1 (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1)
      (m * pint5 B G γ) (modeCoef5 B G D γ m) (rotPt ξ.1 0 ξ.2.1) hok.1 ht hrad0
      (by rw [hpt]; exact hc)
    have h2 := modeF5_differentiable_v5 B.h (1/2 - Aex B.h) ξ.2.2.1 (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1)
      (m * pint5 B G γ) (fun η i => Complex.I * modeCoef5 B G D γ m η i) (rotPt ξ.1 0 ξ.2.1) hok.1 ht
      hrad0 (by rw [hpt]; exact hc')
    obtain ⟨A1, A2, hA⟩ := mode_curl_trig_v5 B.h (1/2 - Aex B.h) ξ.2.2.1
      (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1) (m * pint5 B G γ) (modeCoef5 B G D γ m) ξ.1 ξ.2.1 hr h1 h2
      ξ.2.2.2 a
    exact ⟨A1, A2, fun θ => hA θ⟩
  choose! A1 A2 hA using htrig
  have hfun : (fun θ => ucyl5 B G l0 (waveAdd S D E) θ ξ a) =
      fun θ => ucyl5 B G l0 S θ ξ a + ∑ γ ∈ Γ, ∑ m ∈ H,
        (Real.cos (((m * pint5 B G γ : ℤ) : ℝ) * θ) * A1 γ m +
          Real.sin (((m * pint5 B G γ : ℤ) : ℝ) * θ) * A2 γ m) := by
    funext θ
    rw [hsplit θ a]
    congr 1
    exact Finset.sum_congr rfl (fun γ hγ => Finset.sum_congr rfl (fun m hm => hA γ hγ m hm θ))

  have hcos : ∀ k : ℤ, k ≠ 0 → ∫ θ in (0:ℝ)..(2 * Real.pi), Real.cos ((k:ℝ) * θ) = 0 := by
    intro k hk
    have hk' : (k:ℝ) ≠ 0 := Int.cast_ne_zero.mpr hk
    rw [intervalIntegral.integral_comp_mul_left Real.cos hk', integral_cos]
    have hs : Real.sin ((k:ℝ) * (2 * Real.pi)) = 0 := by
      have := Real.sin_int_mul_pi (2 * k)
      rw [← this]
      congr 1
      push_cast
      ring
    simp [hs]
  have hsin : ∀ k : ℤ, k ≠ 0 → ∫ θ in (0:ℝ)..(2 * Real.pi), Real.sin ((k:ℝ) * θ) = 0 := by
    intro k hk
    have hk' : (k:ℝ) ≠ 0 := Int.cast_ne_zero.mpr hk
    rw [intervalIntegral.integral_comp_mul_left Real.sin hk', integral_sin]
    have hc : Real.cos ((k:ℝ) * (2 * Real.pi)) = 1 := Real.cos_int_mul_two_pi k
    simp [hc]
  have hpint : ∀ γ, pint5 B G γ ≠ 0 := by
    intro γ
    unfold pint5
    split_ifs with h
    · exact one_ne_zero
    · exact h
  have hgI : IntervalIntegrable (fun θ : ℝ => ∑ γ ∈ Γ, ∑ m ∈ H,
      (Real.cos (((m * pint5 B G γ : ℤ) : ℝ) * θ) * A1 γ m +
        Real.sin (((m * pint5 B G γ : ℤ) : ℝ) * θ) * A2 γ m)) MeasureTheory.volume 0 (2 * Real.pi) :=
    (continuous_finset_sum _ fun γ _ => continuous_finset_sum _ fun m _ => by fun_prop).intervalIntegrable _ _
  have hg0 : ∫ θ in (0:ℝ)..(2 * Real.pi), ∑ γ ∈ Γ, ∑ m ∈ H,
      (Real.cos (((m * pint5 B G γ : ℤ) : ℝ) * θ) * A1 γ m +
        Real.sin (((m * pint5 B G γ : ℤ) : ℝ) * θ) * A2 γ m) = 0 := by
    rw [intervalIntegral.integral_finsetSum]
    · apply Finset.sum_eq_zero
      intro γ _
      rw [intervalIntegral.integral_finsetSum]
      · apply Finset.sum_eq_zero
        intro m hm
        have hm0 : m ≠ 0 := by
          intro h
          subst h
          exact hH0 hm
        have hmn : m * pint5 B G γ ≠ 0 := mul_ne_zero hm0 (hpint γ)
        rw [intervalIntegral.integral_add, intervalIntegral.integral_mul_const,
          intervalIntegral.integral_mul_const, hcos _ hmn, hsin _ hmn]
        · ring
        · exact (by fun_prop : Continuous fun θ : ℝ =>
            Real.cos (((m * pint5 B G γ : ℤ) : ℝ) * θ) * A1 γ m).intervalIntegrable _ _
        · exact (by fun_prop : Continuous fun θ : ℝ =>
            Real.sin (((m * pint5 B G γ : ℤ) : ℝ) * θ) * A2 γ m).intervalIntegrable _ _
      · intro m _
        exact (by fun_prop : Continuous fun θ : ℝ =>
          Real.cos (((m * pint5 B G γ : ℤ) : ℝ) * θ) * A1 γ m +
            Real.sin (((m * pint5 B G γ : ℤ) : ℝ) * θ) * A2 γ m).intervalIntegrable _ _
    · intro γ _
      exact (continuous_finset_sum _ fun m _ => by fun_prop).intervalIntegrable _ _

  unfold mcor5
  rw [hfun]
  congr 1
  unfold thA
  congr 1
  by_cases hf : IntervalIntegrable (fun θ => ucyl5 B G l0 S θ ξ a) MeasureTheory.volume 0 (2 * Real.pi)
  · rw [intervalIntegral.integral_add hf hgI, hg0, add_zero]
  · rw [intervalIntegral.integral_undef hf, intervalIntegral.integral_undef]
    intro hfg
    apply hf
    have := hfg.sub hgI
    simpa using this

theorem prim_means_background_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
    l1 ≤ l0 → InWg5 B G (qsOf l0) 1 (primState5 B G).Aw →
    (∀ (a : Fin 3), ∀ ξ ∈ DomC B.h (qsOf l0), mcor5 B G l0 (primState5 B G) a ξ = 0) ∧
    (∀ (α e : ℝ) (a : Fin 3), InM B (qsOf l0) α (nrm B e (mcor5 B G l0 (primState5 B G) a))) ∧
    (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 →
      radMom (mcor5 B G l0 (primState5 B G) 1) 2 z t = 0) ∧
    (∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 →
      radMom (mcor5 B G l0 (primState5 B G) 2) 1 z t = 0) :=
by
  intro B G hok hG
  obtain ⟨lw, hw⟩ := wave_increment_mean_invariance_v5 B G hok hG
  obtain ⟨⟨-, -, -, -, -, -, -, hqB0, -⟩, -, -, -, -, hB6, -⟩ := hok.2
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨lw + n0, fun l0 hl0 hAw => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 < B.qB := by
    rw [hQb]
    exact lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0

  have hopen : ∀ qs : ℝ, IsOpen (DomC B.h qs) := by
    intro qs
    have hcont : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) := by fun_prop
    have hU : IsOpen {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} :=
      (isOpen_lt continuous_const continuous_fst).inter
        (isOpen_lt (continuous_fst.comp (continuous_snd.comp continuous_snd)) continuous_const)
    have hcomp : ContinuousOn (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1))
        {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} :=
      hcont.comp hφ.continuousOn (fun ξ hξ => ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith [hξ.2]⟩)
    have h2 := hcomp.isOpen_inter_preimage hU (isOpen_Iio (a := qs))
    convert h2 using 1
    ext ξ
    simp only [DomC, qC, mem_setOf_eq, mem_inter_iff, mem_preimage, mem_Iio]
    tauto

  have hzero : ∀ (qs : ℝ) (f : Cyl → ℝ), (∀ ξ ∈ DomC B.h qs, f ξ = 0) →
      (∀ α : ℝ, InM B qs α f) ∧
      (∀ (e : ℕ) (z t : ℝ), t < 1 → simScale B.h z (1 - t) < qs → radMom f e z t = 0) := by
    intro qs f hf
    refine ⟨fun α => ⟨?_, ?_, ?_, fun k => ⟨0, 0, 0, fun ξ hξ _ _ => ?_⟩⟩, ?_⟩
    · exact (contDiffOn_const (c := (0:ℝ))).congr hf
    · intro ξ hξ a _
      have hmem : shY ξ a ∈ DomC B.h qs := hξ
      rw [hf _ hmem, hf _ hξ]
    · intro ξ hξ _
      exact hf ξ hξ
    · have hev : f =ᶠ[nhds ξ] fun _ => (0:ℝ) :=
        Filter.eventuallyEq_of_mem ((hopen qs).mem_nhds hξ) hf
      have hz : iteratedFDeriv ℝ k f ξ = 0 := by
        rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
        have h := (iteratedFDeriv_fun_zero : iteratedFDeriv ℝ k (fun _ : Cyl => (0:ℝ)) = 0)
        exact congrFun h ξ
      unfold NB
      rw [hz]
      have h0 : ((0 : ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) ℝ).compContinuousLinearMap
          fun _ => Lnorm B.h ξ) = 0 := by
        ext v
        simp
      rw [h0]
      simp
    · intro e z t ht hq
      have hEq : Set.EqOn (fun r : ℝ => r ^ e * yAvg f (r, z, t, 0)) (fun _ => (0:ℝ)) (Ioi 0) := by
        intro r hr
        have hy : yAvg f (r, z, t, 0) = 0 := by
          have hfun : (fun Y : ℝ × ℝ => f (r, z, t, Y)) = fun _ => (0:ℝ) := by
            funext Y
            exact hf _ (show 0 < r ∧ t < 1 ∧ qC B.h (r, z, t, Y) < qs from ⟨hr, ht, hq⟩)
          calc yAvg f (r, z, t, 0) = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (fun Y : ℝ × ℝ => f (r, z, t, Y)) Y :=
                rfl
            _ = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (fun _ : ℝ × ℝ => (0:ℝ)) Y := by rw [hfun]
            _ = 0 := integral_zero _ _
        show r ^ e * yAvg f (r, z, t, 0) = 0
        rw [hy, mul_zero]
      unfold radMom
      rw [setIntegral_congr_fun measurableSet_Ioi hEq]
      exact integral_zero _ _

  obtain ⟨Z, hZ⟩ : ∃ Z : CState, Z = ⟨0, 0, fun _ => 0, fun _ => 0⟩ := ⟨_, rfl⟩
  have hW0 : InWg5 B G (qsOf l0) 1 (0 : WC) := by
    refine ⟨⟨∅, by simp, fun _ _ _ => rfl⟩, fun _ _ => contDiffOn_const, fun _ _ _ _ _ _ => rfl,
      fun _ _ _ _ h => (h rfl).elim, fun k => ⟨0, 0, 0, fun γ m ξ _ _ _ => ?_⟩⟩
    have hz : iteratedFDeriv ℝ k ((0 : WC) γ m) ξ = 0 := by
      have h := (iteratedFDeriv_fun_zero : iteratedFDeriv ℝ k (fun _ : Cyl => (0 : Fin 3 → ℂ)) = 0)
      exact congrFun h ξ
    unfold NB
    rw [hz]
    have h0 : ((0 : ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) (Fin 3 → ℂ)).compContinuousLinearMap
        fun _ => Lnorm B.h ξ) = 0 := by
      ext v
      simp
    rw [h0]
    simp
  have hWZ : InWg5 B G (qsOf l0) 1 Z.Aw := by rw [hZ]; exact hW0
  have hMZ0 : InM B (qsOf l0) (1/2) (fun _ : Cyl => (0:ℝ)) := (hzero _ _ (fun _ _ => rfl)).1 _
  have hMZ1 : InM B (qsOf l0) (1/2) Z.Psi := by rw [hZ]; exact hMZ0
  have hMZ2 : InM B (qsOf l0) (1/2) Z.bdir := by rw [hZ]; exact hMZ0
  have hstate : waveAdd Z (primState5 B G).Aw (primState5 B G).pw = primState5 B G := by
    rw [hZ]
    show (⟨0 + (primState5 B G).Aw, 0 + (primState5 B G).pw, fun _ => 0, fun _ => 0⟩ : CState) = _
    rw [zero_add, zero_add] <;> rfl

  have hAX : ∀ y s Y, AX5 B G l0 Z y s Y = B.AB y s := by
    intro y s Y
    rw [hZ]
    simp [AX5, waveV5, cyl2cart]
  have hBX : ∀ x t Y, BX B G l0 Z x t Y = B.BvB x t := by
    intro x t Y
    rw [hZ]
    simp [BX]
  have hcurl : ∀ x t Y, curlX B.h (AX5 B G l0 Z) x t Y = curl3 (fun w => B.AB w t) x := by
    intro x t Y
    show curl3 (fun y => AX5 B G l0 Z y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t))) x = _
    simp only [hAX]
  have huX : ∀ x t Y, uX5 B G l0 Z x t Y = uB B x t := by
    intro x t Y
    show curlX B.h (AX5 B G l0 Z) x t Y + BX B G l0 Z x t Y = _
    rw [hcurl, hBX]
    rfl

  have hframe : ∀ (ξ : Cyl) (θ : ℝ) (a : Fin 3), 0 < ξ.1 → ξ.2.2.1 < 1 → qC B.h ξ < B.qB →
      inner ℝ (uB B (rotPt ξ.1 θ ξ.2.1) ξ.2.2.1) (frameAt θ ξ a) = ubase B ξ a := by
    intro ξ θ a hr ht hq
    have hco : ∀ φ : ℝ, rotPt ξ.1 φ ξ.2.1 0 = ξ.1 * Real.cos φ ∧
        rotPt ξ.1 φ ξ.2.1 1 = ξ.1 * Real.sin φ ∧ rotPt ξ.1 φ ξ.2.1 2 = ξ.2.1 := by
      intro φ
      simp [rotPt]
    have hsq : ∀ φ : ℝ, rotPt ξ.1 φ ξ.2.1 0 ^ 2 + rotPt ξ.1 φ ξ.2.1 1 ^ 2 = ξ.1 ^ 2 := by
      intro φ
      obtain ⟨h0, h1, -⟩ := hco φ
      rw [h0, h1]
      have := Real.cos_sq_add_sin_sq φ
      linear_combination ξ.1 ^ 2 * this
    have hrad : ∀ φ : ℝ, rad (rotPt ξ.1 φ ξ.2.1) = ξ.1 := by
      intro φ
      unfold rad
      rw [hsq φ, Real.sqrt_sq hr.le]
    have hdom : ∀ φ : ℝ, (rotPt ξ.1 φ ξ.2.1, ξ.2.2.1) ∈ simDomain B.h B.qB := by
      intro φ
      exact show ξ.2.2.1 < 1 ∧ simScale B.h (rotPt ξ.1 φ ξ.2.1 2) (1 - ξ.2.2.1) < B.qB from
        ⟨ht, by rw [(hco φ).2.2]; exact hq⟩
    have hpos2 : ∀ φ : ℝ, 0 < rotPt ξ.1 φ ξ.2.1 0 ^ 2 + rotPt ξ.1 φ ξ.2.1 1 ^ 2 := by
      intro φ
      rw [hsq φ]
      positivity
    obtain ⟨Q, hQ⟩ : ∃ Q : ℝ, Q = simScale B.h ξ.2.1 (1 - ξ.2.2.1) := ⟨_, rfl⟩
    obtain ⟨X, hX⟩ : ∃ X : ℝ, X = ξ.1 ^ 2 / (2 * Q) := ⟨_, rfl⟩
    obtain ⟨E, hE⟩ : ∃ E : ℝ, E = ξ.2.1 * Q ^ (-(1 / 2 - B.h)) := ⟨_, rfl⟩
    have key : ∀ φ : ℝ, inner ℝ (uB B (rotPt ξ.1 φ ξ.2.1) ξ.2.2.1) (frameAt φ ξ a) =
        ![ξ.1⁻¹ * B.Vb Q X E, ξ.1⁻¹ * (ξ.1 * Q ^ (-(1 / 2 + B.h)) * B.Eb Q X E),
          Q ^ (-(1 / 2 + B.h)) * B.Ub Q X E] a := by
      intro φ
      obtain ⟨h0, h1, h2⟩ := hco φ
      have hS : simScale B.h (rotPt ξ.1 φ ξ.2.1 2) (1 - ξ.2.2.1) = Q := by rw [h2, hQ]
      have hsimX : simX B.h (rotPt ξ.1 φ ξ.2.1) ξ.2.2.1 = X := by
        unfold simX
        rw [hsq φ, hS, hX]
      have hsimE : simEta B.h (rotPt ξ.1 φ ξ.2.1) ξ.2.2.1 = E := by
        unfold simEta
        rw [hS, h2, hE]
      obtain ⟨e1, e2, e3⟩ := hB6 _ _ (hdom φ) (hpos2 φ)
      rw [hsimX, hsimE, hS] at e1 e2 e3
      rw [hsq φ, Real.sqrt_sq hr.le] at e1
      fin_cases a
      · show inner ℝ (uB B (rotPt ξ.1 φ ξ.2.1) ξ.2.2.1) (eR (rotPt ξ.1 φ ξ.2.1)) = ξ.1⁻¹ * B.Vb Q X E
        unfold eR
        rw [real_inner_smul_right, hrad φ]
        exact congrArg (fun s => ξ.1⁻¹ * s) e3
      · show inner ℝ (uB B (rotPt ξ.1 φ ξ.2.1) ξ.2.2.1) (eTh (rotPt ξ.1 φ ξ.2.1)) =
          ξ.1⁻¹ * (ξ.1 * Q ^ (-(1 / 2 + B.h)) * B.Eb Q X E)
        unfold eTh
        rw [real_inner_smul_right, hrad φ]
        exact congrArg (fun s => ξ.1⁻¹ * s) e1
      · show inner ℝ (uB B (rotPt ξ.1 φ ξ.2.1) ξ.2.2.1) eZ = Q ^ (-(1 / 2 + B.h)) * B.Ub Q X E
        unfold eZ
        rw [EuclideanSpace.inner_single_right, conj_trivial, one_mul]
        exact e2
    exact (key θ).trans (key 0).symm

  have hC1 : ∀ (a : Fin 3), ∀ ξ ∈ DomC B.h (qsOf l0), mcor5 B G l0 (primState5 B G) a ξ = 0 := by
    intro a ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have h1 := hw l0 (by omega) Z (primState5 B G).Aw (primState5 B G).pw 1 hWZ hMZ1 hMZ2 hAw a ξ hξ
    rw [hstate] at h1
    rw [h1]
    have hconst : (fun θ => ucyl5 B G l0 Z θ ξ a) = fun _ => ubase B ξ a := by
      funext θ
      unfold ucyl5
      rw [huX]
      exact hframe ξ θ a hξ'.1 hξ'.2.1 (hξ'.2.2.trans hqsB)
    unfold mcor5
    rw [hconst]
    unfold thA
    rw [intervalIntegral.integral_const, smul_eq_mul, sub_zero, ← mul_assoc,
      inv_mul_cancel₀ (by positivity), one_mul, sub_self]
  refine ⟨hC1, fun α e a => ?_, fun z t ht hq => ?_, fun z t ht hq => ?_⟩
  · refine (hzero _ _ (fun ξ hξ => ?_)).1 α
    show qC B.h ξ ^ e * mcor5 B G l0 (primState5 B G) a ξ = 0
    rw [hC1 a ξ hξ, mul_zero]
  · exact (hzero _ _ (hC1 1)).2 2 z t ht hq
  · exact (hzero _ _ (hC1 2)).2 1 z t ht hq

theorem pws_fields_smooth : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → InWg5 B G (qsOf l0) 1 (primState5 B G).Aw → InWg5 B G (qsOf l0) 1 (primState5 B G).pw → ∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (↿(evOff B.h (pwrA5 B G l0) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} ∧ ContDiffOn ℝ ∞ (↿(evOff B.h (pwrW5 B G l0) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} ∧ ContDiffOn ℝ ∞ (↿(evOff B.h (pwrP5 B G l0) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} ∧ (∀ t : ℝ, ContinuousOn (fun y => evOff B.h (pwrLin B G l0) Y₀ y t) {y : ℝ³ | corrOn B l0 y t}) ∧ (∀ t : ℝ, ContinuousOn (fun y => evOff B.h (pwrQ B G l0) Y₀ y t) {y : ℝ³ | corrOn B l0 y t}) :=
by
  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 hAw hpw Y₀ => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  obtain ⟨hΩo, hΨ, hQs, -, heR, heTh⟩ := corr_domain_v5 B l0 Y₀ hok
  set Ω : Set (ℝ³ × ℝ) := {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} with hΩdef
  set Ψ : ℝ³ × ℝ → Cyl := fun w => ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y₀) with hΨdef
  have hSP : SimScaleProps B.h := hok.1
  have hBP := hok.2
  unfold BackgroundProps at hBP
  obtain ⟨-, -, -, ⟨hABs, hBvBs, -⟩, -⟩ := hBP
  have hΩmem : ∀ w ∈ Ω, corrOn B l0 w.1 w.2 := fun w hw => hw
  have hΩsub : Ω ⊆ simDomain B.h B.qB := fun w hw =>
    ⟨(hΩmem w hw).2.1, lt_of_lt_of_le (hΩmem w hw).2.2 hqsB⟩
  have hΨmaps : MapsTo Ψ Ω (DomC B.h (qsOf l0)) := fun w hw => hw
  have hQpos : ∀ w ∈ Ω, 0 < simScale B.h (w.1 2) (1 - w.2) := fun w hw =>
    (hSP.1 (w.1 2) (1 - w.2) (by linarith [(hΩmem w hw).2.1])).1
  have hQΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) Ω :=
    hQs.mono (fun w hw => (hΩmem w hw).2.1)
  have hQp : ∀ p : ℝ, ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2) ^ p) Ω :=
    fun p => hQΩ.rpow_const_of_ne (fun w hw => (hQpos w hw).ne')
  have heRΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => eR w.1) Ω :=
    heR.comp contDiff_fst.contDiffOn (fun w hw => (hΩmem w hw).1)
  have heThΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => eTh w.1) Ω :=
    heTh.comp contDiff_fst.contDiffOn (fun w hw => (hΩmem w hw).1)
  have hbase : ∀ (l : ℕ) (i : Fin 3), ContDiffOn ℝ ∞ (fun ξ => baseC B l ξ i) (DomC B.h (qsOf l0)) := by
    intro l i
    have h1 := (geom_slow_base_smooth_v5 B hok).2 l i
    have hp : ContDiff ℝ ∞ (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) :=
      contDiff_fst.prodMk ((contDiff_fst.comp contDiff_snd).prodMk
        (contDiff_fst.comp (contDiff_snd.comp contDiff_snd)))
    have hmaps : MapsTo (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) (DomC B.h (qsOf l0))
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
      intro ξ hξ
