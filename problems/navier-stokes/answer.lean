    have h1 : HasDerivAt (fun s => u (rotPt r θ z) s)
        (fderiv ℝ (↿u) (rotPt r θ z, t) ((0 : ℝ³), (1 : ℝ))) t :=
      hdu.hasFDerivAt.comp_hasDerivAt t hκ
    have hlam : HasDerivAt (fun s : ℝ => ((r, θ, z, s) : ℝ × ℝ × ℝ × ℝ)) ((0 : ℝ), (0 : ℝ), (0 : ℝ), (1 : ℝ)) t :=
      (hasDerivAt_const t r).prodMk ((hasDerivAt_const t θ).prodMk
        ((hasDerivAt_const t z).prodMk (hasDerivAt_id' t)))
    have h2 : HasDerivAt (fun s => crU u a (r, θ, z, s)) (cpS (crU u a) (r, θ, z, t)) t := by
      have h := (hdU a).hasFDerivAt.comp_hasDerivAt t hlam
      exact h
    have h3 : HasDerivAt (fun s => crU u a (r, θ, z, s))
        (inner ℝ (u (rotPt r θ z) t) (0 : ℝ³) +
          inner ℝ (fderiv ℝ (↿u) (rotPt r θ z, t) ((0 : ℝ³), (1 : ℝ))) (frameAt θ (r, z, t, 0) a)) t :=
      h1.inner ℝ (hasDerivAt_const t (frameAt θ (r, z, t, 0) a))
    rw [h1.deriv, h2.unique h3, inner_zero_right, zero_add]

  have hg : DifferentiableAt ℝ (fun y => p y t) (rotPt r θ z) := by
    have hf : DifferentiableAt ℝ (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) (rotPt r θ z) := by fun_prop
    have h := hdp.comp (rotPt r θ z) hf
    exact h
  have hgF := hg.hasFDerivAt
  have hG : ∀ w : ℝ³, inner ℝ (gradient (fun y => p y t) (rotPt r θ z)) w =
      fderiv ℝ (fun y => p y t) (rotPt r θ z) w := fun w => inner_gradient_left
  have hmR : HasDerivAt (fun ρ : ℝ => rotPt ρ θ z)
      (Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)) r := by
    unfold rotPt
    exact ((((hasDerivAt_mul_const (Real.cos θ)).smul_const
      (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³)).add
      ((hasDerivAt_mul_const (Real.sin θ)).smul_const
      (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))).add
      (hasDerivAt_const r (z • (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³)))).congr_deriv
      (add_zero _)
  have hmTh : HasDerivAt (fun φ : ℝ => rotPt r φ z)
      (r • ((-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))) θ := by
    unfold rotPt
    exact (((((Real.hasDerivAt_cos θ).const_mul r).smul_const
      (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³)).add
      (((Real.hasDerivAt_sin θ).const_mul r).smul_const
      (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))).add
      (hasDerivAt_const θ (z • (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³)))).congr_deriv
      (by rw [add_zero, smul_add, smul_smul, smul_smul])
  have hmZ : HasDerivAt (fun ζ : ℝ => rotPt r θ ζ)
      (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³) z := by
    unfold rotPt
    exact ((hasDerivAt_const z ((r * Real.cos θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
      (r * Real.sin θ) • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))).add
      ((hasDerivAt_id' z).smul_const (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³))).congr_deriv
      (by rw [zero_add, one_smul])
  have cR1 : HasDerivAt (fun ρ => crP p (ρ, θ, z, t))
      (fderiv ℝ (fun y => p y t) (rotPt r θ z) (Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))) r := by
    have h := hgF.comp_hasDerivAt r hmR
    exact h
  have cR2 : HasDerivAt (fun ρ => crP p (ρ, θ, z, t)) (cpR (crP p) (r, θ, z, t)) r := by
    have h := hdP.hasFDerivAt.comp_hasDerivAt r ((hasDerivAt_id' r).prodMk ((hasDerivAt_const r θ).prodMk
      ((hasDerivAt_const r z).prodMk (hasDerivAt_const r t))))
    exact h
  have cTh1 : HasDerivAt (fun φ => crP p (r, φ, z, t))
      (fderiv ℝ (fun y => p y t) (rotPt r θ z) (r • ((-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)))) θ := by
    have h := hgF.comp_hasDerivAt θ hmTh
    exact h
  have cTh2 : HasDerivAt (fun φ => crP p (r, φ, z, t)) (cpTh (crP p) (r, θ, z, t)) θ := by
    have h := hdP.hasFDerivAt.comp_hasDerivAt θ ((hasDerivAt_const θ r).prodMk ((hasDerivAt_id' θ).prodMk
      ((hasDerivAt_const θ z).prodMk (hasDerivAt_const θ t))))
    exact h
  have cZ1 : HasDerivAt (fun ζ => crP p (r, θ, ζ, t))
      (fderiv ℝ (fun y => p y t) (rotPt r θ z) (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³)) z := by
    have h := hgF.comp_hasDerivAt z hmZ
    exact h
  have cZ2 : HasDerivAt (fun ζ => crP p (r, θ, ζ, t)) (cpZ (crP p) (r, θ, z, t)) z := by
    have h := hdP.hasFDerivAt.comp_hasDerivAt z ((hasDerivAt_const z r).prodMk ((hasDerivAt_const z θ).prodMk
      ((hasDerivAt_id' z).prodMk (hasDerivAt_const z t))))
    exact h
  obtain ⟨f0, f1, f2⟩ := hframe
  refine ⟨hT, ?_, ?_, ?_⟩
  · rw [f0, hG]
    exact (cR2.unique cR1).symm
  · rw [f1, hG, cTh2.unique cTh1, map_smul, smul_eq_mul]
    field_simp
  · rw [f2, hG]
    exact (cZ2.unique cZ1).symm

theorem cyl_frame_conv : ∀ (u : ℝ³ → ℝ → ℝ³) (O : Set (ℝ³ × ℝ)) (r θ z t : ℝ), IsOpen O →
    ContDiffOn ℝ ∞ (↿u) O → 0 < r → (rotPt r θ z, t) ∈ O →
    (inner ℝ (fderiv ℝ (fun y => u y t) (rotPt r θ z) (u (rotPt r θ z) t)) (frameAt θ (r, z, t, 0) 0) +
        crU u 0 (r, θ, z, t) * divergence (fun y => u y t) (rotPt r θ z) =
      cpR (fun η => crU u 0 η * crU u 0 η) (r, θ, z, t) + crU u 0 (r, θ, z, t) * crU u 0 (r, θ, z, t) / r +
        cpZ (fun η => crU u 2 η * crU u 0 η) (r, θ, z, t) + cpTh (fun η => crU u 1 η * crU u 0 η) (r, θ, z, t) / r -
        crU u 1 (r, θ, z, t) * crU u 1 (r, θ, z, t) / r) ∧
    (inner ℝ (fderiv ℝ (fun y => u y t) (rotPt r θ z) (u (rotPt r θ z) t)) (frameAt θ (r, z, t, 0) 1) +
        crU u 1 (r, θ, z, t) * divergence (fun y => u y t) (rotPt r θ z) =
      cpR (fun η => crU u 0 η * crU u 1 η) (r, θ, z, t) + crU u 0 (r, θ, z, t) * crU u 1 (r, θ, z, t) / r +
        cpZ (fun η => crU u 2 η * crU u 1 η) (r, θ, z, t) + cpTh (fun η => crU u 1 η * crU u 1 η) (r, θ, z, t) / r +
        crU u 0 (r, θ, z, t) * crU u 1 (r, θ, z, t) / r) ∧
    (inner ℝ (fderiv ℝ (fun y => u y t) (rotPt r θ z) (u (rotPt r θ z) t)) (frameAt θ (r, z, t, 0) 2) +
        crU u 2 (r, θ, z, t) * divergence (fun y => u y t) (rotPt r θ z) =
      cpR (fun η => crU u 0 η * crU u 2 η) (r, θ, z, t) + crU u 0 (r, θ, z, t) * crU u 2 (r, θ, z, t) / r +
        cpZ (fun η => crU u 2 η * crU u 2 η) (r, θ, z, t) + cpTh (fun η => crU u 1 η * crU u 2 η) (r, θ, z, t) / r) :=
by
  intro u O r θ z t hO hu hr hmem
  have hL : ContDiff ℝ ∞ (fun v : ℝ × ℝ × ℝ × ℝ => ((rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) : ℝ³ × ℝ)) := by
    unfold rotPt
    fun_prop
  have hSo : IsOpen {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} := by
    have h := (isOpen_lt (continuous_const : Continuous fun _ : ℝ × ℝ × ℝ × ℝ => (0 : ℝ))
      continuous_fst).inter (hO.preimage hL.continuous)
    exact h
  have hmaps : Set.MapsTo (fun v : ℝ × ℝ × ℝ × ℝ => ((rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) : ℝ³ × ℝ))
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} O :=
    fun v hv => hv.2
  have hgU : ContDiffOn ℝ ∞ (fun v : ℝ × ℝ × ℝ × ℝ => u (rotPt v.1 v.2.1 v.2.2.1) v.2.2.2)
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} :=
    (hu.comp hL.contDiffOn hmaps).congr (fun v _ => rfl)
  have hframeG : ∀ (r θ z s : ℝ), 0 < r →
      frameAt θ (r, z, s, 0) 0 = Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) ∧
      frameAt θ (r, z, s, 0) 1 = (-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) ∧
      frameAt θ (r, z, s, 0) 2 = (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³) := by
    intro r θ z s hr
    have e0 : rotPt r θ z 0 = r * Real.cos θ := by simp [rotPt]
    have e1 : rotPt r θ z 1 = r * Real.sin θ := by simp [rotPt]
    have hrad : rad (rotPt r θ z) = r := by
      have e : (r * Real.cos θ) ^ 2 + (r * Real.sin θ) ^ 2 = r ^ 2 := by
        linear_combination r ^ 2 * Real.cos_sq_add_sin_sq θ
      show Real.sqrt ((rotPt r θ z) 0 ^ 2 + (rotPt r θ z) 1 ^ 2) = r
      rw [e0, e1, e, Real.sqrt_sq hr.le]
    have hr0 : r ≠ 0 := hr.ne'
    refine ⟨?_, ?_, ?_⟩
    · show eR (rotPt r θ z) = _
      rw [eR, hrad, radVec, e0, e1, smul_add, smul_smul, smul_smul,
        inv_mul_cancel_left₀ hr0, inv_mul_cancel_left₀ hr0]
    · show eTh (rotPt r θ z) = _
      rw [eTh, hrad, azVec, e0, e1, smul_add, smul_smul, smul_smul, mul_neg,
        inv_mul_cancel_left₀ hr0, inv_mul_cancel_left₀ hr0]
    · rfl
  have hUs : ∀ a : Fin 3, ContDiffOn ℝ ∞ (crU u a)
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} := by
    intro a
    obtain ⟨F, hFs, hFe⟩ : ∃ F : ℝ × ℝ × ℝ × ℝ → ℝ³, ContDiff ℝ ∞ F ∧
        ∀ v ∈ {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O},
          frameAt v.2.1 (v.1, v.2.2.1, v.2.2.2, 0) a = F v := by
      fin_cases a
      · exact ⟨fun v => Real.cos v.2.1 • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.sin v.2.1 • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³), by fun_prop,
          fun v hv => (hframeG v.1 v.2.1 v.2.2.1 v.2.2.2 hv.1).1⟩
      · exact ⟨fun v => (-Real.sin v.2.1) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.cos v.2.1 • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³), by fun_prop,
          fun v hv => (hframeG v.1 v.2.1 v.2.2.1 v.2.2.2 hv.1).2.1⟩
      · exact ⟨fun _ => (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³), contDiff_const,
          fun v hv => (hframeG v.1 v.2.1 v.2.2.1 v.2.2.2 hv.1).2.2⟩
    refine (hgU.inner ℝ hFs.contDiffOn).congr (fun v hv => ?_)
    simp only [crU, hFe v hv]
  have hv : ((r, θ, z, t) : ℝ × ℝ × ℝ × ℝ) ∈
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} := ⟨hr, hmem⟩
  have hdU : ∀ a : Fin 3, DifferentiableAt ℝ (crU u a) (r, θ, z, t) := fun a =>
    ((hUs a).contDiffAt (hSo.mem_nhds hv)).differentiableAt (by simp)
  have hdu : DifferentiableAt ℝ (↿u) (rotPt r θ z, t) :=
    (hu.contDiffAt (hO.mem_nhds hmem)).differentiableAt (by simp)
  have hg : DifferentiableAt ℝ (fun y => u y t) (rotPt r θ z) := by
    have hf : DifferentiableAt ℝ (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) (rotPt r θ z) := by fun_prop
    have h := hdu.comp (rotPt r θ z) hf
    exact h
  obtain ⟨D, hD⟩ : ∃ D : ℝ³ →L[ℝ] ℝ³, D = fderiv ℝ (fun y => u y t) (rotPt r θ z) := ⟨_, rfl⟩
  have hgF : HasFDerivAt (fun y => u y t) D (rotPt r θ z) := by
    rw [hD]; exact hg.hasFDerivAt
  have hframe := hframeG r θ z t hr
  obtain ⟨f0, f1, f2⟩ := hframe

  have hmR : HasDerivAt (fun ρ : ℝ => rotPt ρ θ z)
      (Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)) r := by
    unfold rotPt
    exact ((((hasDerivAt_mul_const (Real.cos θ)).smul_const
      (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³)).add
      ((hasDerivAt_mul_const (Real.sin θ)).smul_const
      (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))).add
      (hasDerivAt_const r (z • (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³)))).congr_deriv
      (add_zero _)
  have hmTh : HasDerivAt (fun φ : ℝ => rotPt r φ z)
      (r • ((-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))) θ := by
    unfold rotPt
    exact (((((Real.hasDerivAt_cos θ).const_mul r).smul_const
      (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³)).add
      (((Real.hasDerivAt_sin θ).const_mul r).smul_const
      (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))).add
      (hasDerivAt_const θ (z • (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³)))).congr_deriv
      (by rw [add_zero, smul_add, smul_smul, smul_smul])
  have hmZ : HasDerivAt (fun ζ : ℝ => rotPt r θ ζ)
      (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³) z := by
    unfold rotPt
    exact ((hasDerivAt_const z ((r * Real.cos θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
      (r * Real.sin θ) • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))).add
      ((hasDerivAt_id' z).smul_const (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³))).congr_deriv
      (by rw [zero_add, one_smul])

  have hfr : ∀ (a : Fin 3) (ρ ζ : ℝ), 0 < ρ → frameAt θ (ρ, ζ, t, 0) a = frameAt θ (r, z, t, 0) a := by
    intro a ρ ζ hρ
    obtain ⟨g0, g1, g2⟩ := hframeG ρ θ ζ t hρ
    fin_cases a
    · exact g0.trans f0.symm
    · exact g1.trans f1.symm
    · exact g2.trans f2.symm

  have hR : ∀ a : Fin 3, cpR (crU u a) (r, θ, z, t) =
      inner ℝ (D (frameAt θ (r, z, t, 0) 0)) (frameAt θ (r, z, t, 0) a) := by
    intro a
    have hc : HasDerivAt (fun ρ => u (rotPt ρ θ z) t) (D (frameAt θ (r, z, t, 0) 0)) r := by
      rw [f0]; have h := hgF.comp_hasDerivAt r hmR; exact h
    have h1 := hc.inner ℝ (hasDerivAt_const r (frameAt θ (r, z, t, 0) a))
    have h3 : (fun ρ => crU u a (ρ, θ, z, t)) =ᶠ[nhds r]
        (fun ρ => inner ℝ (u (rotPt ρ θ z) t) (frameAt θ (r, z, t, 0) a)) := by
      filter_upwards [Ioi_mem_nhds hr] with ρ hρ
      show inner ℝ (u (rotPt ρ θ z) t) (frameAt θ (ρ, z, t, 0) a) = _
      rw [hfr a ρ z hρ]
    have h2 : HasDerivAt (fun ρ => crU u a (ρ, θ, z, t)) (cpR (crU u a) (r, θ, z, t)) r := by
      have h := (hdU a).hasFDerivAt.comp_hasDerivAt r ((hasDerivAt_id' r).prodMk
        ((hasDerivAt_const r θ).prodMk ((hasDerivAt_const r z).prodMk (hasDerivAt_const r t))))
      exact h
    rw [h2.unique (h1.congr_of_eventuallyEq h3), inner_zero_right, zero_add]

  have hZ : ∀ a : Fin 3, cpZ (crU u a) (r, θ, z, t) =
      inner ℝ (D (frameAt θ (r, z, t, 0) 2)) (frameAt θ (r, z, t, 0) a) := by
    intro a
    have hc : HasDerivAt (fun ζ => u (rotPt r θ ζ) t) (D (frameAt θ (r, z, t, 0) 2)) z := by
      rw [f2]; have h := hgF.comp_hasDerivAt z hmZ; exact h
    have h1 := hc.inner ℝ (hasDerivAt_const z (frameAt θ (r, z, t, 0) a))
    have h3 : (fun ζ => crU u a (r, θ, ζ, t)) =ᶠ[nhds z]
        (fun ζ => inner ℝ (u (rotPt r θ ζ) t) (frameAt θ (r, z, t, 0) a)) := by
      filter_upwards with ζ
      show inner ℝ (u (rotPt r θ ζ) t) (frameAt θ (r, ζ, t, 0) a) = _
      rw [hfr a r ζ hr]
    have h2 : HasDerivAt (fun ζ => crU u a (r, θ, ζ, t)) (cpZ (crU u a) (r, θ, z, t)) z := by
      have h := (hdU a).hasFDerivAt.comp_hasDerivAt z ((hasDerivAt_const z r).prodMk
        ((hasDerivAt_const z θ).prodMk ((hasDerivAt_id' z).prodMk (hasDerivAt_const z t))))
      exact h
    rw [h2.unique (h1.congr_of_eventuallyEq h3), inner_zero_right, zero_add]

  have hcTh : HasDerivAt (fun φ => u (rotPt r φ z) t) (D (r • frameAt θ (r, z, t, 0) 1)) θ := by
    rw [f1]; have h := hgF.comp_hasDerivAt θ hmTh; exact h
  have h2Th : ∀ a : Fin 3, HasDerivAt (fun φ => crU u a (r, φ, z, t)) (cpTh (crU u a) (r, θ, z, t)) θ := by
    intro a
    have h := (hdU a).hasFDerivAt.comp_hasDerivAt θ ((hasDerivAt_const θ r).prodMk
      ((hasDerivAt_id' θ).prodMk ((hasDerivAt_const θ z).prodMk (hasDerivAt_const θ t))))
    exact h
  have hTh0 : cpTh (crU u 0) (r, θ, z, t) =
      r * inner ℝ (D (frameAt θ (r, z, t, 0) 1)) (frameAt θ (r, z, t, 0) 0) + crU u 1 (r, θ, z, t) := by
    have hF : HasDerivAt (fun φ : ℝ => Real.cos φ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.sin φ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))
        ((-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)) θ :=
      ((Real.hasDerivAt_cos θ).smul_const _).add ((Real.hasDerivAt_sin θ).smul_const _)
    have h1 := hcTh.inner ℝ hF
    have h3 : (fun φ => crU u 0 (r, φ, z, t)) = fun φ => inner ℝ (u (rotPt r φ z) t)
        (Real.cos φ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.sin φ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)) := by
      funext φ
      exact congrArg (inner ℝ (u (rotPt r φ z) t)) (hframeG r φ z t hr).1
    have h2 := h2Th 0
    rw [h3] at h2
    rw [h2.unique h1, map_smul, real_inner_smul_left, ← f0, ← f1]
    show _ = _ + inner ℝ (u (rotPt r θ z) t) (frameAt θ (r, z, t, 0) 1)
    ring
  have hTh1 : cpTh (crU u 1) (r, θ, z, t) =
      r * inner ℝ (D (frameAt θ (r, z, t, 0) 1)) (frameAt θ (r, z, t, 0) 1) - crU u 0 (r, θ, z, t) := by
    have hF : HasDerivAt (fun φ : ℝ => (-Real.sin φ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.cos φ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))
        (-(Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))) θ :=
      (((Real.hasDerivAt_sin θ).neg.smul_const _).add ((Real.hasDerivAt_cos θ).smul_const _)).congr_deriv
        (by rw [neg_add, neg_smul, neg_smul])
    have h1 := hcTh.inner ℝ hF
    have h3 : (fun φ => crU u 1 (r, φ, z, t)) = fun φ => inner ℝ (u (rotPt r φ z) t)
        ((-Real.sin φ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.cos φ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)) := by
      funext φ
      exact congrArg (inner ℝ (u (rotPt r φ z) t)) (hframeG r φ z t hr).2.1
    have h2 := h2Th 1
    rw [h3] at h2
    rw [h2.unique h1, map_smul, real_inner_smul_left, inner_neg_right, ← f0, ← f1]
    show _ = _ - inner ℝ (u (rotPt r θ z) t) (frameAt θ (r, z, t, 0) 0)
    ring
  have hTh2 : cpTh (crU u 2) (r, θ, z, t) =
      r * inner ℝ (D (frameAt θ (r, z, t, 0) 1)) (frameAt θ (r, z, t, 0) 2) := by
    have h1 := hcTh.inner ℝ (hasDerivAt_const θ (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³))
    have h3 : (fun φ => crU u 2 (r, φ, z, t)) = fun φ => inner ℝ (u (rotPt r φ z) t)
        (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³) := by
      funext φ
      exact congrArg (inner ℝ (u (rotPt r φ z) t)) (hframeG r φ z t hr).2.2
    have h2 := h2Th 2
    rw [h3] at h2
    rw [h2.unique h1, inner_zero_right, zero_add, map_smul, real_inner_smul_left, ← f2]

  have hprod : ∀ (b a : Fin 3) (e : ℝ × ℝ × ℝ × ℝ),
      fderiv ℝ (fun η => crU u b η * crU u a η) (r, θ, z, t) e =
        crU u b (r, θ, z, t) * fderiv ℝ (crU u a) (r, θ, z, t) e +
          crU u a (r, θ, z, t) * fderiv ℝ (crU u b) (r, θ, z, t) e := by
    intro b a e
    rw [fderiv_fun_mul (hdU b) (hdU a)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hpR : ∀ b a : Fin 3, cpR (fun η => crU u b η * crU u a η) (r, θ, z, t) =
      crU u b (r, θ, z, t) * cpR (crU u a) (r, θ, z, t) + crU u a (r, θ, z, t) * cpR (crU u b) (r, θ, z, t) :=
    fun b a => hprod b a _
  have hpZ : ∀ b a : Fin 3, cpZ (fun η => crU u b η * crU u a η) (r, θ, z, t) =
      crU u b (r, θ, z, t) * cpZ (crU u a) (r, θ, z, t) + crU u a (r, θ, z, t) * cpZ (crU u b) (r, θ, z, t) :=
    fun b a => hprod b a _
  have hpTh : ∀ b a : Fin 3, cpTh (fun η => crU u b η * crU u a η) (r, θ, z, t) =
      crU u b (r, θ, z, t) * cpTh (crU u a) (r, θ, z, t) +
        crU u a (r, θ, z, t) * cpTh (crU u b) (r, θ, z, t) :=
    fun b a => hprod b a _

  have htrace : ∀ T : ℝ³ →L[ℝ] ℝ³, LinearMap.trace ℝ ℝ³ (T : ℝ³ →ₗ[ℝ] ℝ³) =
      inner ℝ (T (Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)))
        (Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)) +
      inner ℝ (T ((-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)))
        ((-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)) +
      inner ℝ (T (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³))
        (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³) := by
    intro T
    rw [LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin 3) ℝ), Fin.sum_univ_three]
    simp only [EuclideanSpace.basisFun_apply, ContinuousLinearMap.coe_coe]
    rw [real_inner_comm (T (EuclideanSpace.single (0 : Fin 3) (1 : ℝ))),
      real_inner_comm (T (EuclideanSpace.single (1 : Fin 3) (1 : ℝ))),
      real_inner_comm (T (EuclideanSpace.single (2 : Fin 3) (1 : ℝ)))]
    simp only [map_add, map_smul, inner_add_left, inner_add_right, real_inner_smul_left,
      real_inner_smul_right]
    linear_combination (-(inner ℝ (T (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³))
      (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
      inner ℝ (T (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))
      (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))) * Real.cos_sq_add_sin_sq θ
  have hdiv : divergence (fun y => u y t) (rotPt r θ z) =
      inner ℝ (D (frameAt θ (r, z, t, 0) 0)) (frameAt θ (r, z, t, 0) 0) +
      inner ℝ (D (frameAt θ (r, z, t, 0) 1)) (frameAt θ (r, z, t, 0) 1) +
      inner ℝ (D (frameAt θ (r, z, t, 0) 2)) (frameAt θ (r, z, t, 0) 2) := by
    unfold divergence
    rw [← hD, f0, f1, f2]
    exact htrace D

  have hexp : ∀ w : ℝ³, w = inner ℝ w (Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)) •
        (Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)) +
      inner ℝ w ((-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)) •
        ((-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)) +
      inner ℝ w (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³) •
        (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³) := by
    intro w
    have h := Real.cos_sq_add_sin_sq θ
    simp only [inner_add_right, real_inner_smul_right, EuclideanSpace.inner_single_right,
      conj_trivial, one_mul]
    ext i
    fin_cases i
    · simp
      linear_combination (-(w.ofLp 0)) * h
    · simp
      linear_combination (-(w.ofLp 1)) * h
    · simp
  have hw : u (rotPt r θ z) t = crU u 0 (r, θ, z, t) • frameAt θ (r, z, t, 0) 0 +
      crU u 1 (r, θ, z, t) • frameAt θ (r, z, t, 0) 1 + crU u 2 (r, θ, z, t) • frameAt θ (r, z, t, 0) 2 := by
    show _ = inner ℝ (u (rotPt r θ z) t) (frameAt θ (r, z, t, 0) 0) • frameAt θ (r, z, t, 0) 0 +
      inner ℝ (u (rotPt r θ z) t) (frameAt θ (r, z, t, 0) 1) • frameAt θ (r, z, t, 0) 1 +
      inner ℝ (u (rotPt r θ z) t) (frameAt θ (r, z, t, 0) 2) • frameAt θ (r, z, t, 0) 2
    rw [f0, f1, f2]
    exact hexp _
  have hDw : ∀ a : Fin 3, inner ℝ (D (u (rotPt r θ z) t)) (frameAt θ (r, z, t, 0) a) =
      crU u 0 (r, θ, z, t) * inner ℝ (D (frameAt θ (r, z, t, 0) 0)) (frameAt θ (r, z, t, 0) a) +
      crU u 1 (r, θ, z, t) * inner ℝ (D (frameAt θ (r, z, t, 0) 1)) (frameAt θ (r, z, t, 0) a) +
      crU u 2 (r, θ, z, t) * inner ℝ (D (frameAt θ (r, z, t, 0) 2)) (frameAt θ (r, z, t, 0) a) := by
    intro a
    have e : D (u (rotPt r θ z) t) = D (crU u 0 (r, θ, z, t) • frameAt θ (r, z, t, 0) 0 +
        crU u 1 (r, θ, z, t) • frameAt θ (r, z, t, 0) 1 +
        crU u 2 (r, θ, z, t) • frameAt θ (r, z, t, 0) 2) := congrArg D hw
    rw [e]
    simp only [map_add, map_smul, inner_add_left, real_inner_smul_left]
  have hr0 : r ≠ 0 := hr.ne'
  rw [← hD]
  refine ⟨?_, ?_, ?_⟩
  · rw [hDw 0, hdiv]
    simp only [hpR, hpZ, hpTh, hR, hZ, hTh0, hTh1]
    field_simp
    ring
  · rw [hDw 1, hdiv]
    simp only [hpR, hpZ, hpTh, hR, hZ, hTh1]
    field_simp
    ring
  · rw [hDw 2, hdiv]
    simp only [hpR, hpZ, hpTh, hR, hZ, hTh1, hTh2]
    field_simp
    ring

theorem cyl_frame_lap : ∀ (u : ℝ³ → ℝ → ℝ³) (O : Set (ℝ³ × ℝ)) (r θ z t : ℝ), IsOpen O →
    ContDiffOn ℝ ∞ (↿u) O → 0 < r → (rotPt r θ z, t) ∈ O →
    inner ℝ (Δ (fun y => u y t) (rotPt r θ z)) (frameAt θ (r, z, t, 0) 0) =
      cpR (cpR (crU u 0)) (r, θ, z, t) + cpR (crU u 0) (r, θ, z, t) / r + cpZ (cpZ (crU u 0)) (r, θ, z, t) +
        (cpTh (cpTh (crU u 0)) (r, θ, z, t) - 2 * cpTh (crU u 1) (r, θ, z, t) - crU u 0 (r, θ, z, t)) / r ^ 2 ∧
    inner ℝ (Δ (fun y => u y t) (rotPt r θ z)) (frameAt θ (r, z, t, 0) 1) =
      cpR (cpR (crU u 1)) (r, θ, z, t) + cpR (crU u 1) (r, θ, z, t) / r + cpZ (cpZ (crU u 1)) (r, θ, z, t) +
        (cpTh (cpTh (crU u 1)) (r, θ, z, t) + 2 * cpTh (crU u 0) (r, θ, z, t) - crU u 1 (r, θ, z, t)) / r ^ 2 ∧
    inner ℝ (Δ (fun y => u y t) (rotPt r θ z)) (frameAt θ (r, z, t, 0) 2) =
      cpR (cpR (crU u 2)) (r, θ, z, t) + cpR (crU u 2) (r, θ, z, t) / r + cpZ (cpZ (crU u 2)) (r, θ, z, t) +
        cpTh (cpTh (crU u 2)) (r, θ, z, t) / r ^ 2 :=
by
  intro u O r θ z t hO hu hr hmem
  have hL : ContDiff ℝ ∞ (fun v : ℝ × ℝ × ℝ × ℝ =>
      ((rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) : ℝ³ × ℝ)) := by
    unfold rotPt
    fun_prop
  have hSo : IsOpen {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} := by
    have h := (isOpen_lt (continuous_const : Continuous fun _ : ℝ × ℝ × ℝ × ℝ => (0 : ℝ))
      continuous_fst).inter (hO.preimage hL.continuous)
    exact h
  have hmaps : Set.MapsTo (fun v : ℝ × ℝ × ℝ × ℝ => ((rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) : ℝ³ × ℝ))
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} O :=
    fun v hv => hv.2
  have hgU : ContDiffOn ℝ ∞ (fun v : ℝ × ℝ × ℝ × ℝ => u (rotPt v.1 v.2.1 v.2.2.1) v.2.2.2)
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} :=
    (hu.comp hL.contDiffOn hmaps).congr (fun v _ => rfl)
  have hframeG : ∀ (r θ z s : ℝ), 0 < r →
      frameAt θ (r, z, s, 0) 0 = Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) ∧
      frameAt θ (r, z, s, 0) 1 = (-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) ∧
      frameAt θ (r, z, s, 0) 2 = (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³) := by
    intro r θ z s hr
    have e0 : rotPt r θ z 0 = r * Real.cos θ := by simp [rotPt]
    have e1 : rotPt r θ z 1 = r * Real.sin θ := by simp [rotPt]
    have hrad : rad (rotPt r θ z) = r := by
      have e : (r * Real.cos θ) ^ 2 + (r * Real.sin θ) ^ 2 = r ^ 2 := by
        linear_combination r ^ 2 * Real.cos_sq_add_sin_sq θ
      show Real.sqrt ((rotPt r θ z) 0 ^ 2 + (rotPt r θ z) 1 ^ 2) = r
      rw [e0, e1, e, Real.sqrt_sq hr.le]
    have hr0 : r ≠ 0 := hr.ne'
    refine ⟨?_, ?_, ?_⟩
    · show eR (rotPt r θ z) = _
      rw [eR, hrad, radVec, e0, e1, smul_add, smul_smul, smul_smul,
        inv_mul_cancel_left₀ hr0, inv_mul_cancel_left₀ hr0]
    · show eTh (rotPt r θ z) = _
      rw [eTh, hrad, azVec, e0, e1, smul_add, smul_smul, smul_smul, mul_neg,
        inv_mul_cancel_left₀ hr0, inv_mul_cancel_left₀ hr0]
    · rfl
  have hUs : ∀ a : Fin 3, ContDiffOn ℝ ∞ (crU u a)
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} := by
    intro a
    obtain ⟨F, hFs, hFe⟩ : ∃ F : ℝ × ℝ × ℝ × ℝ → ℝ³, ContDiff ℝ ∞ F ∧
        ∀ v ∈ {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O},
          frameAt v.2.1 (v.1, v.2.2.1, v.2.2.2, 0) a = F v := by
      fin_cases a
      · exact ⟨fun v => Real.cos v.2.1 • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.sin v.2.1 • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³), by fun_prop,
          fun v hv => (hframeG v.1 v.2.1 v.2.2.1 v.2.2.2 hv.1).1⟩
      · exact ⟨fun v => (-Real.sin v.2.1) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.cos v.2.1 • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³), by fun_prop,
          fun v hv => (hframeG v.1 v.2.1 v.2.2.1 v.2.2.2 hv.1).2.1⟩
      · exact ⟨fun _ => (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³), contDiff_const,
          fun v hv => (hframeG v.1 v.2.1 v.2.2.1 v.2.2.2 hv.1).2.2⟩
    refine (hgU.inner ℝ hFs.contDiffOn).congr (fun v hv => ?_)
    simp only [crU, hFe v hv]
  have hv : ((r, θ, z, t) : ℝ × ℝ × ℝ × ℝ) ∈
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} := ⟨hr, hmem⟩
  have hUC : ∀ (a : Fin 3) (ρ φ ζ : ℝ), 0 < ρ → (rotPt ρ φ ζ, t) ∈ O →
      ContDiffAt ℝ ∞ (crU u a) (ρ, φ, ζ, t) :=
    fun a ρ φ ζ hρ hO' => (hUs a).contDiffAt (hSo.mem_nhds ⟨hρ, hO'⟩)
  have hUd : ∀ (a : Fin 3) (ρ φ ζ : ℝ), 0 < ρ → (rotPt ρ φ ζ, t) ∈ O →
      DifferentiableAt ℝ (crU u a) (ρ, φ, ζ, t) :=
    fun a ρ φ ζ hρ hO' => (hUC a ρ φ ζ hρ hO').differentiableAt (by simp)

  obtain ⟨g, hg⟩ : ∃ g : ℝ³ → ℝ³, g = fun y => u y t := ⟨_, rfl⟩
  obtain ⟨F0, hF0⟩ : ∃ F0 : ℝ → ℝ³, F0 = fun φ =>
      Real.cos φ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.sin φ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) := ⟨_, rfl⟩
  obtain ⟨F1, hF1⟩ : ∃ F1 : ℝ → ℝ³, F1 = fun φ =>
      (-Real.sin φ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.cos φ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) := ⟨_, rfl⟩
  obtain ⟨E2, hE2⟩ : ∃ E2 : ℝ³, E2 = (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³) := ⟨_, rfl⟩
  have hfr : ∀ ρ φ ζ : ℝ, 0 < ρ → frameAt φ (ρ, ζ, t, 0) 0 = F0 φ ∧
      frameAt φ (ρ, ζ, t, 0) 1 = F1 φ ∧ frameAt φ (ρ, ζ, t, 0) 2 = E2 := by
    intro ρ φ ζ hρ
    rw [hF0, hF1, hE2]
    exact hframeG ρ φ ζ t hρ
  have hcrU : ∀ (a : Fin 3) (ρ φ ζ : ℝ),
      crU u a (ρ, φ, ζ, t) = inner ℝ (g (rotPt ρ φ ζ)) (frameAt φ (ρ, ζ, t, 0) a) := by
    intro a ρ φ ζ
    rw [hg]
    rfl
  have hF0d : ∀ φ : ℝ, HasDerivAt F0 (F1 φ) φ := by
    intro φ
    simp only [hF0, hF1]
    exact ((Real.hasDerivAt_cos φ).smul_const _).add ((Real.hasDerivAt_sin φ).smul_const _)
  have hF1d : ∀ φ : ℝ, HasDerivAt F1 (-(F0 φ)) φ := by
    intro φ
    simp only [hF0, hF1]
    exact (((Real.hasDerivAt_sin φ).neg.smul_const _).add ((Real.hasDerivAt_cos φ).smul_const _)).congr_deriv
      (by rw [neg_add, neg_smul, neg_smul])

  have hmR : ∀ ρ φ ζ : ℝ, HasDerivAt (fun σ : ℝ => rotPt σ φ ζ) (F0 φ) ρ := by
    intro ρ φ ζ
    simp only [hF0]
    unfold rotPt
    exact ((((hasDerivAt_mul_const (Real.cos φ)).smul_const
      (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³)).add
      ((hasDerivAt_mul_const (Real.sin φ)).smul_const
      (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))).add
      (hasDerivAt_const ρ (ζ • (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³)))).congr_deriv
      (add_zero _)
  have hmTh : ∀ ρ φ ζ : ℝ, HasDerivAt (fun σ : ℝ => rotPt ρ σ ζ) (ρ • F1 φ) φ := by
    intro ρ φ ζ
    simp only [hF1]
    unfold rotPt
    exact (((((Real.hasDerivAt_cos φ).const_mul ρ).smul_const
      (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³)).add
      (((Real.hasDerivAt_sin φ).const_mul ρ).smul_const
      (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))).add
      (hasDerivAt_const φ (ζ • (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³)))).congr_deriv
      (by rw [add_zero, smul_add, smul_smul, smul_smul])
  have hmZ : ∀ ρ φ ζ : ℝ, HasDerivAt (fun σ : ℝ => rotPt ρ φ σ) E2 ζ := by
    intro ρ φ ζ
    rw [hE2]
    unfold rotPt
    exact ((hasDerivAt_const ζ ((ρ * Real.cos φ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
      (ρ * Real.sin φ) • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³))).add
      ((hasDerivAt_id' ζ).smul_const (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³))).congr_deriv
      (by rw [zero_add, one_smul])

  have hgC : ∀ y : ℝ³, (y, t) ∈ O → ContDiffAt ℝ ∞ g y := by
    intro y hy
    rw [hg]
    exact (hu.contDiffAt (hO.mem_nhds hy)).comp y
      ((contDiff_id.prodMk contDiff_const).contDiffAt)
  have hgd : ∀ y : ℝ³, (y, t) ∈ O → DifferentiableAt ℝ g y :=
    fun y hy => (hgC y hy).differentiableAt (by simp)
  have hBd : HasFDerivAt (fderiv ℝ g) (fderiv ℝ (fderiv ℝ g) (rotPt r θ z)) (rotPt r θ z) :=
    (((hgC _ hmem).fderiv_right (m := 1) (by simp)).differentiableAt (by simp)).hasFDerivAt

  have hLR : ∀ (F : ℝ × ℝ × ℝ × ℝ → ℝ) (ρ φ ζ : ℝ), DifferentiableAt ℝ F (ρ, φ, ζ, t) →
      HasDerivAt (fun σ => F (σ, φ, ζ, t)) (cpR F (ρ, φ, ζ, t)) ρ := by
    intro F ρ φ ζ hF
    have h := hF.hasFDerivAt.comp_hasDerivAt ρ ((hasDerivAt_id' ρ).prodMk
      ((hasDerivAt_const ρ φ).prodMk ((hasDerivAt_const ρ ζ).prodMk (hasDerivAt_const ρ t))))
    exact h
  have hLTh : ∀ (F : ℝ × ℝ × ℝ × ℝ → ℝ) (ρ φ ζ : ℝ), DifferentiableAt ℝ F (ρ, φ, ζ, t) →
      HasDerivAt (fun σ => F (ρ, σ, ζ, t)) (cpTh F (ρ, φ, ζ, t)) φ := by
    intro F ρ φ ζ hF
    have h := hF.hasFDerivAt.comp_hasDerivAt φ ((hasDerivAt_const φ ρ).prodMk
      ((hasDerivAt_id' φ).prodMk ((hasDerivAt_const φ ζ).prodMk (hasDerivAt_const φ t))))
    exact h
  have hLZ : ∀ (F : ℝ × ℝ × ℝ × ℝ → ℝ) (ρ φ ζ : ℝ), DifferentiableAt ℝ F (ρ, φ, ζ, t) →
      HasDerivAt (fun σ => F (ρ, φ, σ, t)) (cpZ F (ρ, φ, ζ, t)) ζ := by
    intro F ρ φ ζ hF
    have h := hF.hasFDerivAt.comp_hasDerivAt ζ ((hasDerivAt_const ζ ρ).prodMk
      ((hasDerivAt_const ζ φ).prodMk ((hasDerivAt_id' ζ).prodMk (hasDerivAt_const ζ t))))
    exact h

  have hevR : ∀ᶠ σ in nhds r, 0 < σ ∧ (rotPt σ θ z, t) ∈ O := by
    have hc : Continuous (fun σ : ℝ => ((σ, θ, z, t) : ℝ × ℝ × ℝ × ℝ)) := by fun_prop
    exact hc.continuousAt.preimage_mem_nhds (hSo.mem_nhds hv)
  have hevTh : ∀ᶠ φ in nhds θ, 0 < r ∧ (rotPt r φ z, t) ∈ O := by
    have hc : Continuous (fun φ : ℝ => ((r, φ, z, t) : ℝ × ℝ × ℝ × ℝ)) := by fun_prop
    exact hc.continuousAt.preimage_mem_nhds (hSo.mem_nhds hv)
  have hevZ : ∀ᶠ ζ in nhds z, 0 < r ∧ (rotPt r θ ζ, t) ∈ O := by
    have hc : Continuous (fun ζ : ℝ => ((r, θ, ζ, t) : ℝ × ℝ × ℝ × ℝ)) := by fun_prop
    exact hc.continuousAt.preimage_mem_nhds (hSo.mem_nhds hv)

  have key : ∀ (a : Fin 3) (W Wd Wdd : ℝ → ℝ³),
      (∀ ρ φ ζ : ℝ, 0 < ρ → frameAt φ (ρ, ζ, t, 0) a = W φ) →
      (∀ φ, HasDerivAt W (Wd φ) φ) → (∀ φ, HasDerivAt Wd (Wdd φ) φ) →
      crU u a (r, θ, z, t) = inner ℝ (g (rotPt r θ z)) (W θ) ∧
      cpR (crU u a) (r, θ, z, t) = inner ℝ (fderiv ℝ g (rotPt r θ z) (F0 θ)) (W θ) ∧
      cpR (cpR (crU u a)) (r, θ, z, t) =
        inner ℝ (fderiv ℝ (fderiv ℝ g) (rotPt r θ z) (F0 θ) (F0 θ)) (W θ) ∧
      cpZ (cpZ (crU u a)) (r, θ, z, t) =
        inner ℝ (fderiv ℝ (fderiv ℝ g) (rotPt r θ z) E2 E2) (W θ) ∧
      cpTh (crU u a) (r, θ, z, t) =
        r * inner ℝ (fderiv ℝ g (rotPt r θ z) (F1 θ)) (W θ) + inner ℝ (g (rotPt r θ z)) (Wd θ) ∧
      cpTh (cpTh (crU u a)) (r, θ, z, t) =
        r ^ 2 * inner ℝ (fderiv ℝ (fderiv ℝ g) (rotPt r θ z) (F1 θ) (F1 θ)) (W θ)
          - r * inner ℝ (fderiv ℝ g (rotPt r θ z) (F0 θ)) (W θ)
          + 2 * r * inner ℝ (fderiv ℝ g (rotPt r θ z) (F1 θ)) (Wd θ)
          + inner ℝ (g (rotPt r θ z)) (Wdd θ) := by
    intro a W Wd Wdd hW hWd hWdd
    have hU' : ∀ ρ φ ζ : ℝ, 0 < ρ → crU u a (ρ, φ, ζ, t) = inner ℝ (g (rotPt ρ φ ζ)) (W φ) := by
      intro ρ φ ζ hρ
      rw [hcrU, hW ρ φ ζ hρ]
    have hFR : ∀ ρ φ ζ : ℝ, 0 < ρ → (rotPt ρ φ ζ, t) ∈ O →
        cpR (crU u a) (ρ, φ, ζ, t) = inner ℝ (fderiv ℝ g (rotPt ρ φ ζ) (F0 φ)) (W φ) := by
      intro ρ φ ζ hρ hO'
      have h2 := hLR (crU u a) ρ φ ζ (hUd a ρ φ ζ hρ hO')
      have hc := (hgd _ hO').hasFDerivAt.comp_hasDerivAt ρ (hmR ρ φ ζ)
      have h1 := hc.inner ℝ (hasDerivAt_const ρ (W φ))
      have h3 : (fun σ => crU u a (σ, φ, ζ, t)) =ᶠ[nhds ρ]
          (fun σ => inner ℝ (g (rotPt σ φ ζ)) (W φ)) := by
        filter_upwards [Ioi_mem_nhds hρ] with σ hσ
        exact hU' σ φ ζ hσ
      rw [h2.unique (h1.congr_of_eventuallyEq h3), inner_zero_right, zero_add]
    have hFZ : ∀ ρ φ ζ : ℝ, 0 < ρ → (rotPt ρ φ ζ, t) ∈ O →
        cpZ (crU u a) (ρ, φ, ζ, t) = inner ℝ (fderiv ℝ g (rotPt ρ φ ζ) E2) (W φ) := by
      intro ρ φ ζ hρ hO'
      have h2 := hLZ (crU u a) ρ φ ζ (hUd a ρ φ ζ hρ hO')
      have hc := (hgd _ hO').hasFDerivAt.comp_hasDerivAt ζ (hmZ ρ φ ζ)
      have h1 := hc.inner ℝ (hasDerivAt_const ζ (W φ))
      have h3 : (fun σ => crU u a (ρ, φ, σ, t)) =ᶠ[nhds ζ]
          (fun σ => inner ℝ (g (rotPt ρ φ σ)) (W φ)) := by
        filter_upwards with σ
        exact hU' ρ φ σ hρ
      rw [h2.unique (h1.congr_of_eventuallyEq h3), inner_zero_right, zero_add]
    have hFTh : ∀ ρ φ ζ : ℝ, 0 < ρ → (rotPt ρ φ ζ, t) ∈ O →
        cpTh (crU u a) (ρ, φ, ζ, t) =
          ρ * inner ℝ (fderiv ℝ g (rotPt ρ φ ζ) (F1 φ)) (W φ) + inner ℝ (g (rotPt ρ φ ζ)) (Wd φ) := by
      intro ρ φ ζ hρ hO'
      have h2 := hLTh (crU u a) ρ φ ζ (hUd a ρ φ ζ hρ hO')
      have hc := (hgd _ hO').hasFDerivAt.comp_hasDerivAt φ (hmTh ρ φ ζ)
      have h1 := hc.inner ℝ (hWd φ)
      have h3 : (fun σ => crU u a (ρ, σ, ζ, t)) =ᶠ[nhds φ]
          (fun σ => inner ℝ (g (rotPt ρ σ ζ)) (W σ)) := by
        filter_upwards with σ
        exact hU' ρ σ ζ hρ
      rw [h2.unique (h1.congr_of_eventuallyEq h3)]
      simp only [Function.comp_apply, map_smul, real_inner_smul_left]
      ring
    have hD2 : ∀ e : ℝ × ℝ × ℝ × ℝ,
        DifferentiableAt ℝ (fun w => fderiv ℝ (crU u a) w e) (r, θ, z, t) := fun e =>
      (((hUC a r θ z hr hmem).fderiv_right (m := 1) (by simp)).differentiableAt (by simp)).clm_apply
        (differentiableAt_const e)
    have hRR : cpR (cpR (crU u a)) (r, θ, z, t) =
        inner ℝ (fderiv ℝ (fderiv ℝ g) (rotPt r θ z) (F0 θ) (F0 θ)) (W θ) := by
      have h2 := hLR (cpR (crU u a)) r θ z (hD2 (1, 0, 0, 0))
      have hcB := hBd.comp_hasDerivAt r (hmR r θ z)
      have h1 := (hcB.clm_apply (hasDerivAt_const r (F0 θ))).inner ℝ (hasDerivAt_const r (W θ))
      have h3 : (fun σ => cpR (crU u a) (σ, θ, z, t)) =ᶠ[nhds r]
          (fun σ => inner ℝ (fderiv ℝ g (rotPt σ θ z) (F0 θ)) (W θ)) := by
        filter_upwards [hevR] with σ hσ
        exact hFR σ θ z hσ.1 hσ.2
      rw [h2.unique (h1.congr_of_eventuallyEq h3)]
      simp only [inner_zero_right, zero_add, map_zero, add_zero, Function.comp_apply]
    have hZZ : cpZ (cpZ (crU u a)) (r, θ, z, t) =
        inner ℝ (fderiv ℝ (fderiv ℝ g) (rotPt r θ z) E2 E2) (W θ) := by
      have h2 := hLZ (cpZ (crU u a)) r θ z (hD2 (0, 0, 1, 0))
      have hcB := hBd.comp_hasDerivAt z (hmZ r θ z)
      have h1 := (hcB.clm_apply (hasDerivAt_const z E2)).inner ℝ (hasDerivAt_const z (W θ))
      have h3 : (fun σ => cpZ (crU u a) (r, θ, σ, t)) =ᶠ[nhds z]
          (fun σ => inner ℝ (fderiv ℝ g (rotPt r θ σ) E2) (W θ)) := by
        filter_upwards [hevZ] with σ hσ
        exact hFZ r θ σ hσ.1 hσ.2
      rw [h2.unique (h1.congr_of_eventuallyEq h3)]
      simp only [inner_zero_right, zero_add, map_zero, add_zero, Function.comp_apply]
    have hThTh : cpTh (cpTh (crU u a)) (r, θ, z, t) =
        r ^ 2 * inner ℝ (fderiv ℝ (fderiv ℝ g) (rotPt r θ z) (F1 θ) (F1 θ)) (W θ)
          - r * inner ℝ (fderiv ℝ g (rotPt r θ z) (F0 θ)) (W θ)
          + 2 * r * inner ℝ (fderiv ℝ g (rotPt r θ z) (F1 θ)) (Wd θ)
          + inner ℝ (g (rotPt r θ z)) (Wdd θ) := by
      have h2 := hLTh (cpTh (crU u a)) r θ z (hD2 (0, 1, 0, 0))
      have hcB := hBd.comp_hasDerivAt θ (hmTh r θ z)
      have hA := (hcB.clm_apply (hF1d θ)).inner ℝ (hWd θ)
      have hc := (hgd _ hmem).hasFDerivAt.comp_hasDerivAt θ (hmTh r θ z)
      have h1 := (hA.const_mul r).add (hc.inner ℝ (hWdd θ))
      have h3 : (fun φ => cpTh (crU u a) (r, φ, z, t)) =ᶠ[nhds θ]
          (fun φ => r * inner ℝ (fderiv ℝ g (rotPt r φ z) (F1 φ)) (W φ) +
            inner ℝ (g (rotPt r φ z)) (Wd φ)) := by
        filter_upwards [hevTh] with φ hφ
        exact hFTh r φ z hr hφ.2
      rw [h2.unique (h1.congr_of_eventuallyEq h3)]
      simp only [Function.comp_apply, map_smul, map_neg, ContinuousLinearMap.smul_apply,
        inner_add_left, inner_neg_left, real_inner_smul_left, smul_eq_mul]
      ring
    exact ⟨hU' r θ z hr, hFR r θ z hr hmem, hRR, hZZ, hFTh r θ z hr hmem, hThTh⟩

  have hLap : ∀ w : ℝ³, inner ℝ (Δ g (rotPt r θ z)) w =
      inner ℝ (fderiv ℝ (fderiv ℝ g) (rotPt r θ z) (F0 θ) (F0 θ)) w +
      inner ℝ (fderiv ℝ (fderiv ℝ g) (rotPt r θ z) (F1 θ) (F1 θ)) w +
      inner ℝ (fderiv ℝ (fderiv ℝ g) (rotPt r θ z) E2 E2) w := by
    intro w
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis g
      (EuclideanSpace.basisFun (Fin 3) ℝ)]
    simp only [Fin.sum_univ_three, EuclideanSpace.basisFun_apply, iteratedFDeriv_two_apply,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    rw [hF0, hF1, hE2]
    simp only [map_add, map_smul, map_neg, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, ContinuousLinearMap.neg_apply, inner_add_left,
      inner_neg_left, real_inner_smul_left, neg_smul, smul_eq_mul]
    linear_combination (-(inner ℝ (fderiv ℝ (fderiv ℝ g) (rotPt r θ z)
      (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³)) w +
      inner ℝ (fderiv ℝ (fderiv ℝ g) (rotPt r θ z)
      (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³)) w)) *
      Real.cos_sq_add_sin_sq θ

  obtain ⟨V0, A0, P0, Z0, T0, TT0⟩ := key 0 F0 F1 (fun φ => -(F0 φ))
    (fun ρ φ ζ hρ => (hfr ρ φ ζ hρ).1) hF0d hF1d
  obtain ⟨V1, A1, P1, Z1, T1, TT1⟩ := key 1 F1 (fun φ => -(F0 φ)) (fun φ => -(F1 φ))
    (fun ρ φ ζ hρ => (hfr ρ φ ζ hρ).2.1) hF1d (fun φ => (hF0d φ).neg)
  obtain ⟨V2, A2, P2, Z2, T2, TT2⟩ := key 2 (fun _ => E2) (fun _ => 0) (fun _ => 0)
    (fun ρ φ ζ hρ => (hfr ρ φ ζ hρ).2.2) (fun φ => hasDerivAt_const φ E2)
    (fun φ => hasDerivAt_const φ (0 : ℝ³))
  have hΔ : Δ (fun y => u y t) (rotPt r θ z) = Δ g (rotPt r θ z) := by rw [hg]
  obtain ⟨f0, f1, f2⟩ := hfr r θ z hr
  have hr0 : r ≠ 0 := hr.ne'
  rw [hΔ, f0, f1, f2]
  refine ⟨?_, ?_, ?_⟩
  · rw [hLap, P0, A0, Z0, TT0, T1, V0]
    simp only [inner_neg_right, inner_zero_right]
    field_simp
    ring
  · rw [hLap, P1, A1, Z1, TT1, T0, V1]
    simp only [inner_neg_right, inner_zero_right]
    field_simp
    ring
  · rw [hLap, P2, A2, Z2, TT2]
    simp only [inner_neg_right, inner_zero_right, mul_zero, add_zero]
    field_simp
    ring

theorem cyl_avg_rows : ∀ (U : Fin 3 → ℝ × ℝ × ℝ × ℝ → ℝ) (P : ℝ × ℝ × ℝ × ℝ → ℝ) (W : Set (ℝ × ℝ × ℝ))
    (w : ℝ × ℝ × ℝ), IsOpen W → w ∈ W →
    (∀ a : Fin 3, ContDiffOn ℝ ∞ (U a) {v : ℝ × ℝ × ℝ × ℝ | (v.1, v.2.2.1, v.2.2.2) ∈ W}) →
    ContDiffOn ℝ ∞ P {v : ℝ × ℝ × ℝ × ℝ | (v.1, v.2.2.1, v.2.2.2) ∈ W} →
    (∀ (a : Fin 3) (v : ℝ × ℝ × ℝ × ℝ), U a (v.1, v.2.1 + 2 * Real.pi, v.2.2.1, v.2.2.2) = U a v) →
    (∀ v : ℝ × ℝ × ℝ × ℝ, P (v.1, v.2.1 + 2 * Real.pi, v.2.2.1, v.2.2.2) = P v) →
    (∀ a : Fin 3, ContDiffOn ℝ ∞ (crAv (U a)) W) ∧
    (∀ a b : Fin 3, ContDiffOn ℝ ∞ (crAv (fun η => U a η * U b η)) W) ∧
    ContDiffOn ℝ ∞ (crAv P) W ∧
    thA (fun θ => crRow0 U P (w.1, θ, w.2.1, w.2.2)) =
      wDt (crAv (U 0)) w + wDr (crAv (fun η => U 0 η * U 0 η)) w + crAv (fun η => U 0 η * U 0 η) w / w.1 +
        wDz (crAv (fun η => U 2 η * U 0 η)) w - crAv (fun η => U 1 η * U 1 η) w / w.1 -
        (wLap (crAv (U 0)) w - crAv (U 0) w / w.1 ^ 2) + wDr (crAv P) w ∧
    thA (fun θ => crRow1 U P (w.1, θ, w.2.1, w.2.2)) =
      wDt (crAv (U 1)) w + wDr (crAv (fun η => U 0 η * U 1 η)) w + 2 * crAv (fun η => U 0 η * U 1 η) w / w.1 +
        wDz (crAv (fun η => U 2 η * U 1 η)) w - (wLap (crAv (U 1)) w - crAv (U 1) w / w.1 ^ 2) ∧
    thA (fun θ => crRow2 U P (w.1, θ, w.2.1, w.2.2)) =
      wDt (crAv (U 2)) w + wDr (crAv (fun η => U 0 η * U 2 η)) w + crAv (fun η => U 0 η * U 2 η) w / w.1 +
        wDz (crAv (fun η => U 2 η * U 2 η)) w - wLap (crAv (U 2)) w + wDz (crAv P) w :=
by
  intro U P W w hW hw hU hP hUper hPper
  set S : Set (ℝ × ℝ × ℝ × ℝ) := {v : ℝ × ℝ × ℝ × ℝ | (v.1, v.2.2.1, v.2.2.2) ∈ W} with hSdef
  have hS : IsOpen S :=
    hW.preimage (f := fun v : ℝ × ℝ × ℝ × ℝ => (v.1, v.2.2.1, v.2.2.2)) (by fun_prop)

  have hcp : ∀ G : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ G S → ∀ e : ℝ × ℝ × ℝ × ℝ,
      ContDiffOn ℝ ∞ (fun v => fderiv ℝ G v e) S :=
    fun G hG e => (hG.fderiv_of_isOpen hS (le_of_eq ENat.coe_top_add_one)).clm_apply contDiffOn_const
  have hcpR : ∀ G : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ G S → ContDiffOn ℝ ∞ (cpR G) S :=
    fun G hG => hcp G hG (1, 0, 0, 0)
  have hcpTh : ∀ G : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ G S → ContDiffOn ℝ ∞ (cpTh G) S :=
    fun G hG => hcp G hG (0, 1, 0, 0)
  have hcpZ : ∀ G : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ G S → ContDiffOn ℝ ∞ (cpZ G) S :=
    fun G hG => hcp G hG (0, 0, 1, 0)
  have hcpS : ∀ G : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ G S → ContDiffOn ℝ ∞ (cpS G) S :=
    fun G hG => hcp G hG (0, 0, 0, 1)
  have hper : ∀ G : ℝ × ℝ × ℝ × ℝ → ℝ,
      (∀ v : ℝ × ℝ × ℝ × ℝ, G (v.1, v.2.1 + 2 * Real.pi, v.2.2.1, v.2.2.2) = G v) →
      ∀ v : ℝ × ℝ × ℝ × ℝ, cpTh G (v.1, v.2.1 + 2 * Real.pi, v.2.2.1, v.2.2.2) = cpTh G v := by
    intro G hG v
    have hadd : ∀ x : ℝ × ℝ × ℝ × ℝ, x + ((0:ℝ), 2 * Real.pi, (0:ℝ), (0:ℝ)) =
        (x.1, x.2.1 + 2 * Real.pi, x.2.2.1, x.2.2.2) := by
      intro x
      refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_)) <;> simp
    have hfun : (fun x : ℝ × ℝ × ℝ × ℝ => G (x + ((0:ℝ), 2 * Real.pi, (0:ℝ), (0:ℝ)))) = G := by
      funext x
      rw [hadd, hG]
    have h1 : fderiv ℝ G (v + ((0:ℝ), 2 * Real.pi, (0:ℝ), (0:ℝ))) = fderiv ℝ G v := by
      rw [← fderiv_comp_add_right (f := G) (x := v) ((0:ℝ), 2 * Real.pi, (0:ℝ), (0:ℝ)), hfun]
    show fderiv ℝ G (v.1, v.2.1 + 2 * Real.pi, v.2.2.1, v.2.2.2) (0, 1, 0, 0) = fderiv ℝ G v (0, 1, 0, 0)
    rw [← hadd v, h1]

  have hcc : ∀ G : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ G S →
      Continuous (fun θ : ℝ => G (w.1, θ, w.2.1, w.2.2)) := by
    intro G hG
    exact hG.continuousOn.comp_continuous
      (f := fun θ : ℝ => ((w.1, θ, w.2.1, w.2.2) : ℝ × ℝ × ℝ × ℝ)) (by fun_prop) (fun θ => hw)

  have hzero : ∀ G : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ G S →
      (∀ v : ℝ × ℝ × ℝ × ℝ, G (v.1, v.2.1 + 2 * Real.pi, v.2.2.1, v.2.2.2) = G v) →
      crAv (cpTh G) w = 0 := by
    intro G hG hGp
    have hderiv : ∀ θ : ℝ, HasDerivAt (fun θ : ℝ => G (w.1, θ, w.2.1, w.2.2))
        (cpTh G (w.1, θ, w.2.1, w.2.2)) θ := by
      intro θ
      have hGd : DifferentiableAt ℝ G (w.1, θ, w.2.1, w.2.2) :=
        (hG.contDiffAt (hS.mem_nhds
          (show ((w.1, θ, w.2.1, w.2.2) : ℝ × ℝ × ℝ × ℝ) ∈ S from hw))).differentiableAt (by simp)
      have hcd : HasDerivAt (fun θ : ℝ => ((w.1, θ, w.2.1, w.2.2) : ℝ × ℝ × ℝ × ℝ))
          ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ)) θ :=
        (hasDerivAt_const θ w.1).prodMk ((hasDerivAt_id θ).prodMk
          ((hasDerivAt_const θ w.2.1).prodMk (hasDerivAt_const θ w.2.2)))
      exact hGd.hasFDerivAt.comp_hasDerivAt θ hcd
    have hint : ∫ θ in (0:ℝ)..(2 * Real.pi), cpTh G (w.1, θ, w.2.1, w.2.2) =
        G (w.1, 2 * Real.pi, w.2.1, w.2.2) - G (w.1, 0, w.2.1, w.2.2) :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt (fun θ _ => hderiv θ)
        ((hcc _ (hcpTh G hG)).intervalIntegrable _ _)
    have hp : G (w.1, 2 * Real.pi, w.2.1, w.2.2) = G (w.1, 0, w.2.1, w.2.2) := by
      have := hGp (w.1, 0, w.2.1, w.2.2)
      simpa only [zero_add] using this
    show (2 * Real.pi)⁻¹ * ∫ θ in (0:ℝ)..(2 * Real.pi), cpTh G (w.1, θ, w.2.1, w.2.2) = 0
    rw [hint, hp, sub_self, mul_zero]

  have hO : IsOpen ((univ : Set ℝ) ×ˢ W) := isOpen_univ.prod hW
  have param_fderiv : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
      (H : ℝ × (ℝ × ℝ × ℝ) → F), ContDiffOn ℝ ∞ H (univ ×ˢ W) →
      ContDiffOn ℝ ∞ (fun p : ℝ × (ℝ × ℝ × ℝ) => fderiv ℝ (fun w' => H (p.1, w')) p.2)
        (univ ×ˢ W) := by
    intro F _ _ H hH p hp
    have hHa : ContDiffAt ℝ ∞ H p := hH.contDiffAt (hO.mem_nhds hp)
    apply ContDiffAt.contDiffWithinAt
    have h1 : ContDiffAt ℝ ∞
        (Function.uncurry (fun (q : ℝ × (ℝ × ℝ × ℝ)) (w' : ℝ × ℝ × ℝ) => H (q.1, w'))) (p, p.2) := by
      have e : Function.uncurry (fun (q : ℝ × (ℝ × ℝ × ℝ)) (w' : ℝ × ℝ × ℝ) => H (q.1, w')) =
          H ∘ (fun z : (ℝ × (ℝ × ℝ × ℝ)) × (ℝ × ℝ × ℝ) => (z.1.1, z.2)) := rfl
      rw [e]
      apply ContDiffAt.comp (g := H) (p, p.2)
      · simpa using hHa
      · fun_prop
    exact ContDiffAt.fderiv (f := fun (q : ℝ × (ℝ × ℝ × ℝ)) (w' : ℝ × ℝ × ℝ) => H (q.1, w'))
      (g := Prod.snd) h1 contDiffAt_snd (le_of_eq ENat.coe_top_add_one)
  have param_cont : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
      (H : ℝ × (ℝ × ℝ × ℝ) → F), ContDiffOn ℝ ∞ H (univ ×ˢ W) → ∀ x ∈ W,
      Continuous (fun φ : ℝ => fderiv ℝ (fun w' => H (φ, w')) x) := by
    intro F _ _ H hH x hx
    exact (param_fderiv H hH).continuousOn.comp_continuous
      (f := fun φ : ℝ => ((φ, x) : ℝ × (ℝ × ℝ × ℝ))) (by fun_prop) (fun φ => ⟨mem_univ _, hx⟩)
  have param_hasFDeriv : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (H : ℝ × (ℝ × ℝ × ℝ) → F), ContDiffOn ℝ ∞ H (univ ×ˢ W) → ∀ y ∈ W,
      HasFDerivAt (fun w' => ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w'))
        (∫ φ in (0:ℝ)..(2 * Real.pi), fderiv ℝ (fun w' => H (φ, w')) y) y := by
    intro F _ _ _ H hH y hy
    have hHs := param_fderiv H hH
    obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hW y hy
    set s := Metric.closedBall y (δ / 2) with hs
    have hsU : s ⊆ W := (Metric.closedBall_subset_ball (by linarith)).trans hball
    have hsn : s ∈ nhds y := Metric.closedBall_mem_nhds y (by linarith)
    have hK : IsCompact (Icc (0:ℝ) (2 * Real.pi) ×ˢ s) := isCompact_Icc.prod (isCompact_closedBall _ _)
    have hKsub : Icc (0:ℝ) (2 * Real.pi) ×ˢ s ⊆ univ ×ˢ W := fun z hz => ⟨mem_univ _, hsU hz.2⟩
    obtain ⟨Bd, hB⟩ := hK.exists_bound_of_continuousOn (hHs.continuousOn.mono hKsub)
    have hcontφ : ∀ x ∈ W, Continuous (fun φ : ℝ => H (φ, x)) := by
      intro x hx
      exact hH.continuousOn.comp_continuous (by fun_prop) (fun φ => ⟨mem_univ _, hx⟩)
    have hpi : (0:ℝ) ≤ 2 * Real.pi := by positivity
    refine intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := volume)
      (F := fun x φ => H (φ, x)) (F' := fun x φ => fderiv ℝ (fun w' => H (φ, w')) x)
      (bound := fun _ => Bd) hsn ?_ ?_ ?_ ?_ ?_ ?_
    · filter_upwards [hW.mem_nhds hy] with x hx
      exact (hcontφ x hx).aestronglyMeasurable
    · exact (hcontφ y hy).intervalIntegrable _ _
    · exact (param_cont H hH y hy).aestronglyMeasurable
    · refine ae_of_all _ (fun φ hφ x hx => ?_)
      rw [Set.uIoc_of_le hpi] at hφ
      exact hB (φ, x) ⟨Set.Ioc_subset_Icc_self hφ, hx⟩
    · exact intervalIntegrable_const
    · refine ae_of_all _ (fun φ _ x hx => ?_)
      have hxU : x ∈ W := hsU hx
      have hHa : ContDiffAt ℝ ∞ H (φ, x) := hH.contDiffAt (hO.mem_nhds ⟨mem_univ _, hxU⟩)
      have : ContDiffAt ℝ ∞ (fun w' => H (φ, w')) x :=
        hHa.comp x (by fun_prop : ContDiffAt ℝ ∞ (fun w' : ℝ × ℝ × ℝ => ((φ, w') : ℝ × (ℝ × ℝ × ℝ))) x)
      exact (this.differentiableAt (by simp)).hasFDerivAt

  have param_nat : ∀ (k : ℕ) {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
      [CompleteSpace F] (H : ℝ × (ℝ × ℝ × ℝ) → F), ContDiffOn ℝ ∞ H (univ ×ˢ W) →
      ContDiffOn ℝ k (fun w' => ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w')) W := by
    intro k
    induction k with
    | zero =>
      intro F _ _ _ H hH
      have hD : DifferentiableOn ℝ (fun w' => ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w')) W :=
        fun y hy => (param_hasFDeriv H hH y hy).differentiableAt.differentiableWithinAt
      rw [Nat.cast_zero]
      exact contDiffOn_zero.mpr hD.continuousOn
    | succ k ih =>
      intro F _ _ _ H hH
      have hD : DifferentiableOn ℝ (fun w' => ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w')) W :=
        fun y hy => (param_hasFDeriv H hH y hy).differentiableAt.differentiableWithinAt
      have hCS : CompleteSpace ((ℝ × ℝ × ℝ) →L[ℝ] F) :=
        ContinuousLinearMap.instCompleteSpace (E := ℝ × ℝ × ℝ)
      have hIH := @ih ((ℝ × ℝ × ℝ) →L[ℝ] F) _ _ hCS
        (fun p : ℝ × (ℝ × ℝ × ℝ) => fderiv ℝ (fun w' => H (p.1, w')) p.2) (param_fderiv H hH)
      rw [Nat.cast_succ]
      refine (contDiffOn_succ_iff_fderiv_of_isOpen hW).mpr ⟨hD, fun h => ?_, ?_⟩
      · exact absurd h (by simp)
      · refine hIH.congr (fun y hy => ?_)
        exact (param_hasFDeriv H hH y hy).fderiv

  have hs3 : ∀ F : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F S → ∀ y ∈ W, ∀ e : ℝ × ℝ × ℝ,
      fderiv ℝ (crAv F) y e = crAv (fun v => fderiv ℝ F v (e.1, 0, e.2.1, e.2.2)) y := by
    intro F hF y hy e
    have hH : ContDiffOn ℝ ∞ (fun p : ℝ × (ℝ × ℝ × ℝ) => F (p.2.1, p.1, p.2.2.1, p.2.2.2))
        (univ ×ˢ W) :=
      hF.comp (by fun_prop : ContDiff ℝ ∞ (fun p : ℝ × (ℝ × ℝ × ℝ) =>
        ((p.2.1, p.1, p.2.2.1, p.2.2.2) : ℝ × ℝ × ℝ × ℝ))).contDiffOn (fun p hp => hp.2)
    have hD : HasFDerivAt
        (fun y' : ℝ × ℝ × ℝ => ∫ φ in (0:ℝ)..(2 * Real.pi), F (y'.1, φ, y'.2.1, y'.2.2))
        (∫ φ in (0:ℝ)..(2 * Real.pi),
          fderiv ℝ (fun y' : ℝ × ℝ × ℝ => F (y'.1, φ, y'.2.1, y'.2.2)) y) y :=
      param_hasFDeriv (fun p : ℝ × (ℝ × ℝ × ℝ) => F (p.2.1, p.1, p.2.2.1, p.2.2.2)) hH y hy
    have hcD : Continuous
        (fun φ : ℝ => fderiv ℝ (fun y' : ℝ × ℝ × ℝ => F (y'.1, φ, y'.2.1, y'.2.2)) y) :=
      param_cont (fun p : ℝ × (ℝ × ℝ × ℝ) => F (p.2.1, p.1, p.2.2.1, p.2.2.2)) hH y hy
    have hD2 : HasFDerivAt (crAv F) ((2 * Real.pi)⁻¹ • ∫ φ in (0:ℝ)..(2 * Real.pi),
        fderiv ℝ (fun y' : ℝ × ℝ × ℝ => F (y'.1, φ, y'.2.1, y'.2.2)) y) y :=
      hD.const_mul ((2 * Real.pi)⁻¹)
    have hDθ : ∀ θ : ℝ, fderiv ℝ (fun y' : ℝ × ℝ × ℝ => F (y'.1, θ, y'.2.1, y'.2.2)) y e =
        fderiv ℝ F (y.1, θ, y.2.1, y.2.2) (e.1, 0, e.2.1, e.2.2) := by
      intro θ
      have hι : HasFDerivAt (fun y' : ℝ × ℝ × ℝ => ((y'.1, θ, y'.2.1, y'.2.2) : ℝ × ℝ × ℝ × ℝ))
          ((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).prod
            ((0 : (ℝ × ℝ × ℝ) →L[ℝ] ℝ).prod (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)))) y :=
        hasFDerivAt_fst.prodMk ((hasFDerivAt_const θ y).prodMk hasFDerivAt_snd)
      have hFd : DifferentiableAt ℝ F (y.1, θ, y.2.1, y.2.2) :=
        (hF.contDiffAt (hS.mem_nhds
          (show ((y.1, θ, y.2.1, y.2.2) : ℝ × ℝ × ℝ × ℝ) ∈ S from hy))).differentiableAt (by simp)
      have h2 : fderiv ℝ (fun y' : ℝ × ℝ × ℝ => F (y'.1, θ, y'.2.1, y'.2.2)) y =
          (fderiv ℝ F (y.1, θ, y.2.1, y.2.2)).comp ((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).prod
            ((0 : (ℝ × ℝ × ℝ) →L[ℝ] ℝ).prod (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)))) :=
        (hFd.hasFDerivAt.comp y hι).fderiv
      rw [h2]
      first
        | rfl
        | simp
    rw [hD2.fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul,
      ContinuousLinearMap.intervalIntegral_apply (hcD.intervalIntegrable _ _) e]
    show _ = (2 * Real.pi)⁻¹ * ∫ θ in (0:ℝ)..(2 * Real.pi),
      fderiv ℝ F (y.1, θ, y.2.1, y.2.2) (e.1, 0, e.2.1, e.2.2)
    congr 1
    exact intervalIntegral.integral_congr (fun θ _ => hDθ θ)
  have hR : ∀ F : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F S → ∀ y ∈ W,
      wDr (crAv F) y = crAv (cpR F) y := fun F hF y hy => hs3 F hF y hy (1, 0, 0)
  have hZ : ∀ F : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F S → ∀ y ∈ W,
      wDz (crAv F) y = crAv (cpZ F) y := fun F hF y hy => hs3 F hF y hy (0, 1, 0)
  have hT : ∀ F : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F S → ∀ y ∈ W,
      wDt (crAv F) y = crAv (cpS F) y := fun F hF y hy => hs3 F hF y hy (0, 0, 1)

  have h2R : ∀ F : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F S →
      crAv (cpR (cpR F)) w = wDr (wDr (crAv F)) w := by
    intro F hF
    have hev : crAv (cpR F) =ᶠ[nhds w] wDr (crAv F) :=
      Filter.eventuallyEq_of_mem (hW.mem_nhds hw) (fun y hy => (hR F hF y hy).symm)
    have h1 : fderiv ℝ (crAv (cpR F)) w = fderiv ℝ (wDr (crAv F)) w := hev.fderiv_eq
    calc crAv (cpR (cpR F)) w = wDr (crAv (cpR F)) w := (hR (cpR F) (hcpR F hF) w hw).symm
      _ = fderiv ℝ (crAv (cpR F)) w (1, 0, 0) := rfl
      _ = fderiv ℝ (wDr (crAv F)) w (1, 0, 0) := by rw [h1]
      _ = wDr (wDr (crAv F)) w := rfl
  have h2Z : ∀ F : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F S →
      crAv (cpZ (cpZ F)) w = wDz (wDz (crAv F)) w := by
    intro F hF
    have hev : crAv (cpZ F) =ᶠ[nhds w] wDz (crAv F) :=
      Filter.eventuallyEq_of_mem (hW.mem_nhds hw) (fun y hy => (hZ F hF y hy).symm)
    have h1 : fderiv ℝ (crAv (cpZ F)) w = fderiv ℝ (wDz (crAv F)) w := hev.fderiv_eq
    calc crAv (cpZ (cpZ F)) w = wDz (crAv (cpZ F)) w := (hZ (cpZ F) (hcpZ F hF) w hw).symm
      _ = fderiv ℝ (crAv (cpZ F)) w (0, 1, 0) := rfl
      _ = fderiv ℝ (wDz (crAv F)) w (0, 1, 0) := by rw [h1]
      _ = wDz (wDz (crAv F)) w := rfl

  have hsm : ∀ G : ℝ × ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ G S → ContDiffOn ℝ ∞ (crAv G) W := by
    intro G hG
    have hg : ContDiffOn ℝ ∞ (fun p : ℝ × (ℝ × ℝ × ℝ) => G (p.2.1, p.1, p.2.2.1, p.2.2.2))
        (univ ×ˢ W) :=
      hG.comp (by fun_prop : ContDiff ℝ ∞ (fun p : ℝ × (ℝ × ℝ × ℝ) =>
        ((p.2.1, p.1, p.2.2.1, p.2.2.2) : ℝ × ℝ × ℝ × ℝ))).contDiffOn (fun p hp => hp.2)
    have hJ2 : ContDiffOn ℝ ∞
        (fun y : ℝ × ℝ × ℝ => ∫ θ in (0:ℝ)..(2 * Real.pi), G (y.1, θ, y.2.1, y.2.2)) W :=
      contDiffOn_infty.mpr (fun k => param_nat k _ hg)
    have := (contDiffOn_const (c := (2 * Real.pi)⁻¹)).mul hJ2
    exact this

  have hUab : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun η => U a η * U b η) S :=
    fun a b => (hU a).mul (hU b)
  have hUabp : ∀ (a b : Fin 3) (v : ℝ × ℝ × ℝ × ℝ),
      (fun η => U a η * U b η) (v.1, v.2.1 + 2 * Real.pi, v.2.2.1, v.2.2.2) =
        (fun η => U a η * U b η) v := by
    intro a b v
    show U a _ * U b _ = U a v * U b v
    rw [hUper a v, hUper b v]

  have lin0 : ∀ (t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 : ℝ → ℝ) (r : ℝ),
      Continuous t1 → Continuous t2 → Continuous t3 → Continuous t4 → Continuous t5 →
      Continuous t6 → Continuous t7 → Continuous t8 → Continuous t9 → Continuous t10 →
      Continuous t11 → Continuous t12 → Continuous t13 →
      thA (fun θ => t1 θ + t2 θ + t3 θ / r + t4 θ + t5 θ / r - t6 θ / r
        - (t7 θ + t8 θ / r + t9 θ + (t10 θ - 2 * t11 θ - t12 θ) / r ^ 2) + t13 θ) =
      thA t1 + thA t2 + thA t3 / r + thA t4 + thA t5 / r - thA t6 / r
        - (thA t7 + thA t8 / r + thA t9 + (thA t10 - 2 * thA t11 - thA t12) / r ^ 2) + thA t13 := by
    intro t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 r h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13
    unfold thA
    simp (disch := (apply Continuous.intervalIntegrable; fun_prop)) only
      [intervalIntegral.integral_add, intervalIntegral.integral_sub, intervalIntegral.integral_div,
        intervalIntegral.integral_const_mul]
    ring
  have lin1 : ∀ (t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 : ℝ → ℝ) (r : ℝ),
      Continuous t1 → Continuous t2 → Continuous t3 → Continuous t4 → Continuous t5 →
      Continuous t6 → Continuous t7 → Continuous t8 → Continuous t9 → Continuous t10 →
      Continuous t11 → Continuous t12 →
      thA (fun θ => t1 θ + t2 θ + 2 * t3 θ / r + t4 θ + t5 θ / r
        - (t6 θ + t7 θ / r + t8 θ + (t9 θ + 2 * t10 θ - t11 θ) / r ^ 2) + t12 θ / r) =
      thA t1 + thA t2 + 2 * thA t3 / r + thA t4 + thA t5 / r
        - (thA t6 + thA t7 / r + thA t8 + (thA t9 + 2 * thA t10 - thA t11) / r ^ 2) + thA t12 / r := by
    intro t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 r h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12
    unfold thA
    simp (disch := (apply Continuous.intervalIntegrable; fun_prop)) only
      [intervalIntegral.integral_add, intervalIntegral.integral_sub, intervalIntegral.integral_div,
        intervalIntegral.integral_const_mul]
    ring
  have lin2 : ∀ (t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 : ℝ → ℝ) (r : ℝ),
      Continuous t1 → Continuous t2 → Continuous t3 → Continuous t4 → Continuous t5 →
      Continuous t6 → Continuous t7 → Continuous t8 → Continuous t9 → Continuous t10 →
      thA (fun θ => t1 θ + t2 θ + t3 θ / r + t4 θ + t5 θ / r
        - (t6 θ + t7 θ / r + t8 θ + t9 θ / r ^ 2) + t10 θ) =
      thA t1 + thA t2 + thA t3 / r + thA t4 + thA t5 / r
        - (thA t6 + thA t7 / r + thA t8 + thA t9 / r ^ 2) + thA t10 := by
    intro t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 r h1 h2 h3 h4 h5 h6 h7 h8 h9 h10
    unfold thA
    simp (disch := (apply Continuous.intervalIntegrable; fun_prop)) only
      [intervalIntegral.integral_add, intervalIntegral.integral_sub, intervalIntegral.integral_div,
        intervalIntegral.integral_const_mul]
    ring
  refine ⟨fun a => hsm _ (hU a), fun a b => hsm _ (hUab a b), hsm _ hP, ?_, ?_, ?_⟩
  ·
    have L0 := lin0 _ _ _ _ _ _ _ _ _ _ _ _ _ w.1
      (hcc _ (hcpS _ (hU 0))) (hcc _ (hcpR _ (hUab 0 0))) (hcc _ (hUab 0 0))
      (hcc _ (hcpZ _ (hUab 2 0))) (hcc _ (hcpTh _ (hUab 1 0))) (hcc _ (hUab 1 1))
      (hcc _ (hcpR _ (hcpR _ (hU 0)))) (hcc _ (hcpR _ (hU 0))) (hcc _ (hcpZ _ (hcpZ _ (hU 0))))
      (hcc _ (hcpTh _ (hcpTh _ (hU 0)))) (hcc _ (hcpTh _ (hU 1))) (hcc _ (hU 0))
      (hcc _ (hcpR _ hP))
    have L0' : thA (fun θ => crRow0 U P (w.1, θ, w.2.1, w.2.2)) =
        crAv (cpS (U 0)) w + crAv (cpR (fun η => U 0 η * U 0 η)) w
          + crAv (fun η => U 0 η * U 0 η) w / w.1 + crAv (cpZ (fun η => U 2 η * U 0 η)) w
          + crAv (cpTh (fun η => U 1 η * U 0 η)) w / w.1 - crAv (fun η => U 1 η * U 1 η) w / w.1
          - (crAv (cpR (cpR (U 0))) w + crAv (cpR (U 0)) w / w.1 + crAv (cpZ (cpZ (U 0))) w
            + (crAv (cpTh (cpTh (U 0))) w - 2 * crAv (cpTh (U 1)) w - crAv (U 0) w) / w.1 ^ 2)
          + crAv (cpR P) w := L0
    have f1 := (hT _ (hU 0) w hw).symm
    have f2 := (hR _ (hUab 0 0) w hw).symm
    have f4 := (hZ _ (hUab 2 0) w hw).symm
    have f5 := hzero _ (hUab 1 0) (hUabp 1 0)
    have f7 := h2R _ (hU 0)
    have f8 := (hR _ (hU 0) w hw).symm
    have f9 := h2Z _ (hU 0)
    have f10 := hzero _ (hcpTh _ (hU 0)) (hper _ (hUper 0))
    have f11 := hzero _ (hU 1) (hUper 1)
    have f13 := (hR _ hP w hw).symm
    simp only [wLap]
    linear_combination L0' + f1 + f2 + f4 + f5 / w.1 - f7 - f8 / w.1 - f9 - f10 / w.1 ^ 2
      + 2 * f11 / w.1 ^ 2 + f13
  ·
    have L1 := lin1 _ _ _ _ _ _ _ _ _ _ _ _ w.1
      (hcc _ (hcpS _ (hU 1))) (hcc _ (hcpR _ (hUab 0 1))) (hcc _ (hUab 0 1))
      (hcc _ (hcpZ _ (hUab 2 1))) (hcc _ (hcpTh _ (hUab 1 1)))
      (hcc _ (hcpR _ (hcpR _ (hU 1)))) (hcc _ (hcpR _ (hU 1))) (hcc _ (hcpZ _ (hcpZ _ (hU 1))))
      (hcc _ (hcpTh _ (hcpTh _ (hU 1)))) (hcc _ (hcpTh _ (hU 0))) (hcc _ (hU 1))
      (hcc _ (hcpTh _ hP))
    have L1' : thA (fun θ => crRow1 U P (w.1, θ, w.2.1, w.2.2)) =
        crAv (cpS (U 1)) w + crAv (cpR (fun η => U 0 η * U 1 η)) w
          + 2 * crAv (fun η => U 0 η * U 1 η) w / w.1 + crAv (cpZ (fun η => U 2 η * U 1 η)) w
          + crAv (cpTh (fun η => U 1 η * U 1 η)) w / w.1
          - (crAv (cpR (cpR (U 1))) w + crAv (cpR (U 1)) w / w.1 + crAv (cpZ (cpZ (U 1))) w
            + (crAv (cpTh (cpTh (U 1))) w + 2 * crAv (cpTh (U 0)) w - crAv (U 1) w) / w.1 ^ 2)
          + crAv (cpTh P) w / w.1 := L1
    have f1 := (hT _ (hU 1) w hw).symm
    have f2 := (hR _ (hUab 0 1) w hw).symm
    have f4 := (hZ _ (hUab 2 1) w hw).symm
    have f5 := hzero _ (hUab 1 1) (hUabp 1 1)
    have f6 := h2R _ (hU 1)
    have f7 := (hR _ (hU 1) w hw).symm
    have f8 := h2Z _ (hU 1)
    have f9 := hzero _ (hcpTh _ (hU 1)) (hper _ (hUper 1))
    have f10 := hzero _ (hU 0) (hUper 0)
    have f12 := hzero _ hP hPper
    simp only [wLap]
    linear_combination L1' + f1 + f2 + f4 + f5 / w.1 - f6 - f7 / w.1 - f8 - f9 / w.1 ^ 2
      - 2 * f10 / w.1 ^ 2 + f12 / w.1
  ·
    have L2 := lin2 _ _ _ _ _ _ _ _ _ _ w.1
      (hcc _ (hcpS _ (hU 2))) (hcc _ (hcpR _ (hUab 0 2))) (hcc _ (hUab 0 2))
      (hcc _ (hcpZ _ (hUab 2 2))) (hcc _ (hcpTh _ (hUab 1 2)))
      (hcc _ (hcpR _ (hcpR _ (hU 2)))) (hcc _ (hcpR _ (hU 2))) (hcc _ (hcpZ _ (hcpZ _ (hU 2))))
      (hcc _ (hcpTh _ (hcpTh _ (hU 2)))) (hcc _ (hcpZ _ hP))
    have L2' : thA (fun θ => crRow2 U P (w.1, θ, w.2.1, w.2.2)) =
        crAv (cpS (U 2)) w + crAv (cpR (fun η => U 0 η * U 2 η)) w
          + crAv (fun η => U 0 η * U 2 η) w / w.1 + crAv (cpZ (fun η => U 2 η * U 2 η)) w
          + crAv (cpTh (fun η => U 1 η * U 2 η)) w / w.1
          - (crAv (cpR (cpR (U 2))) w + crAv (cpR (U 2)) w / w.1 + crAv (cpZ (cpZ (U 2))) w
            + crAv (cpTh (cpTh (U 2))) w / w.1 ^ 2)
          + crAv (cpZ P) w := L2
    have f1 := (hT _ (hU 2) w hw).symm
    have f2 := (hR _ (hUab 0 2) w hw).symm
    have f4 := (hZ _ (hUab 2 2) w hw).symm
    have f5 := hzero _ (hUab 1 2) (hUabp 1 2)
    have f6 := h2R _ (hU 2)
    have f7 := (hR _ (hU 2) w hw).symm
    have f8 := h2Z _ (hU 2)
    have f9 := hzero _ (hcpTh _ (hU 2)) (hper _ (hUper 2))
    have f10 := (hZ _ hP w hw).symm
    simp only [wLap]
    linear_combination L2' + f1 + f2 + f4 + f5 / w.1 - f6 - f7 / w.1 - f8 - f9 / w.1 ^ 2 + f10

theorem cyl_path_transfer : ∀ (h : ℝ) (Y₀ : ℝ × ℝ) (F₁ F₂ : ℝ × ℝ × ℝ → ℝ) (G : Cyl → ℝ) (W : Set (ℝ × ℝ × ℝ))
    (U : Set Cyl) (w : ℝ × ℝ × ℝ), IsOpen W → w ∈ W → ContDiffOn ℝ ∞ F₁ W → ContDiffOn ℝ ∞ F₂ W →
    IsOpen U → ContDiffOn ℝ ∞ G U → 0 < w.1 → mriPath h Y₀ w ∈ U →
    (∀ w' : ℝ × ℝ × ℝ, mriPath h Y₀ w' ∈ U → F₁ w' - F₂ w' = G (mriPath h Y₀ w')) →
    F₁ w - F₂ w = G (mriPath h Y₀ w) ∧ wDr F₁ w - wDr F₂ w = dR h G (mriPath h Y₀ w) ∧
    wDz F₁ w - wDz F₂ w = dZ G (mriPath h Y₀ w) ∧ wDt F₁ w - wDt F₂ w = dT G (mriPath h Y₀ w) ∧
    wLap F₁ w - wLap F₂ w = lap0 h G (mriPath h Y₀ w) :=
by
  intro h Y₀ F₁ F₂ G W U w hW hwW hF₁ hF₂ hU hG hw hwU hEq

  have hγ : ∀ x : ℝ × ℝ × ℝ, 0 < x.1 → DifferentiableAt ℝ (mriPath h Y₀) x ∧
      fderiv ℝ (mriPath h Y₀) x (1, 0, 0) =
        ((1 : ℝ), (0 : ℝ), (0 : ℝ), (drx h * x.1 ^ (drx h - 1)) • vrv) ∧
      fderiv ℝ (mriPath h Y₀) x (0, 1, 0) = ((0 : ℝ), (1 : ℝ), (0 : ℝ), (0 : ℝ × ℝ)) ∧
      fderiv ℝ (mriPath h Y₀) x (0, 0, 1) = ((0 : ℝ), (0 : ℝ), (1 : ℝ), vtv) := by
    intro x hx
    have h1 := (Real.hasDerivAt_rpow_const (x := x.1) (p := drx h) (Or.inl hx.ne')).comp_hasFDerivAt x
      (hasFDerivAt_fst (𝕜 := ℝ) (p := x))
    have h2 := h1.smul_const vrv
    have h3 := (hasFDerivAt_snd (𝕜 := ℝ) (p := x)).snd
    have h4 := h3.smul_const vtv
    have h5 := (h2.add h4).add_const Y₀
    have h6 := (hasFDerivAt_snd (𝕜 := ℝ) (p := x)).fst
    have h7 := (hasFDerivAt_fst (𝕜 := ℝ) (p := x)).prodMk (h6.prodMk (h3.prodMk h5))
    have h8 : HasFDerivAt (mriPath h Y₀) _ x := h7
    refine ⟨h8.differentiableAt, ?_, ?_, ?_⟩ <;> rw [h8.fderiv] <;> simp

  have chain : ∀ (K : ℝ × ℝ × ℝ → ℝ) (H : Cyl → ℝ) (x : ℝ × ℝ × ℝ), 0 < x.1 →
      DifferentiableAt ℝ H (mriPath h Y₀ x) → K =ᶠ[nhds x] (fun y => H (mriPath h Y₀ y)) →
      wDr K x = dR h H (mriPath h Y₀ x) ∧ wDz K x = dZ H (mriPath h Y₀ x) ∧
        wDt K x = dT H (mriPath h Y₀ x) := by
    intro K H x hx hH hK
    obtain ⟨hd, e1, e2, e3⟩ := hγ x hx
    have hf : fderiv ℝ K x = (fderiv ℝ H (mriPath h Y₀ x)).comp (fderiv ℝ (mriPath h Y₀) x) := by
      rw [hK.fderiv_eq]
      exact fderiv_comp x hH hd
    refine ⟨?_, ?_, ?_⟩
    · show fderiv ℝ K x (1, 0, 0) =
        fderiv ℝ H (mriPath h Y₀ x) (1, 0, 0, (drx h * x.1 ^ (drx h - 1)) • vrv)
      rw [hf, ContinuousLinearMap.comp_apply, e1]
    · show fderiv ℝ K x (0, 1, 0) = fderiv ℝ H (mriPath h Y₀ x) (0, 1, 0, 0)
      rw [hf, ContinuousLinearMap.comp_apply, e2]
    · show fderiv ℝ K x (0, 0, 1) = fderiv ℝ H (mriPath h Y₀ x) (0, 0, 1, vtv)
      rw [hf, ContinuousLinearMap.comp_apply, e3]

  have hdF : ∀ (F : ℝ × ℝ × ℝ → ℝ), ContDiffOn ℝ ∞ F W → ∀ x ∈ W,
      DifferentiableAt ℝ F x ∧ DifferentiableAt ℝ (wDr F) x ∧ DifferentiableAt ℝ (wDz F) x := by
    intro F hF x hx
    have hF' : ContDiffOn ℝ ∞ (fderiv ℝ F) W := ((contDiffOn_infty_iff_fderiv_of_isOpen hW).1 hF).2
    have hr : ContDiffOn ℝ ∞ (fun y => fderiv ℝ F y ((1 : ℝ), (0 : ℝ), (0 : ℝ))) W :=
      hF'.clm_apply contDiffOn_const
    have hz : ContDiffOn ℝ ∞ (fun y => fderiv ℝ F y ((0 : ℝ), (1 : ℝ), (0 : ℝ))) W :=
      hF'.clm_apply contDiffOn_const
    exact ⟨(hF.contDiffAt (hW.mem_nhds hx)).differentiableAt (by simp),
      (hr.contDiffAt (hW.mem_nhds hx)).differentiableAt (by simp),
      (hz.contDiffAt (hW.mem_nhds hx)).differentiableAt (by simp)⟩

  have hPo : IsOpen (W ∩ {x : ℝ × ℝ × ℝ | 0 < x.1}) :=
    hW.inter (isOpen_lt continuous_const continuous_fst)
  have hγc : ContinuousOn (mriPath h Y₀) (W ∩ {x : ℝ × ℝ × ℝ | 0 < x.1}) :=
    fun x hx => ((hγ x hx.2).1.continuousAt).continuousWithinAt
  obtain ⟨D, hD⟩ : ∃ D : Set (ℝ × ℝ × ℝ), D = (W ∩ {x : ℝ × ℝ × ℝ | 0 < x.1}) ∩ mriPath h Y₀ ⁻¹' U :=
    ⟨_, rfl⟩
  have hDo : IsOpen D := by rw [hD]; exact hγc.isOpen_inter_preimage hPo hU

  have first : ∀ x ∈ D, wDr F₁ x - wDr F₂ x = dR h G (mriPath h Y₀ x) ∧
      wDz F₁ x - wDz F₂ x = dZ G (mriPath h Y₀ x) ∧ wDt F₁ x - wDt F₂ x = dT G (mriPath h Y₀ x) := by
    intro x hx
    have hxD := hx
    rw [hD] at hx
    obtain ⟨⟨hxW, hx0⟩, hxU⟩ := hx
    have hK : (fun y => F₁ y - F₂ y) =ᶠ[nhds x] (fun y => G (mriPath h Y₀ y)) :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hxD) (fun y hy => by
        rw [hD] at hy
        exact hEq y hy.2)
    have hGd : DifferentiableAt ℝ G (mriPath h Y₀ x) :=
      (hG.contDiffAt (hU.mem_nhds hxU)).differentiableAt (by simp)
    obtain ⟨c1, c2, c3⟩ := chain _ G x hx0 hGd hK
    have hs : fderiv ℝ (fun y => F₁ y - F₂ y) x = fderiv ℝ F₁ x - fderiv ℝ F₂ x :=
      fderiv_fun_sub (hdF F₁ hF₁ x hxW).1 (hdF F₂ hF₂ x hxW).1
    refine ⟨?_, ?_, ?_⟩
    · rw [← c1]
      show fderiv ℝ F₁ x (1, 0, 0) - fderiv ℝ F₂ x (1, 0, 0) =
        fderiv ℝ (fun y => F₁ y - F₂ y) x (1, 0, 0)
      rw [hs, ContinuousLinearMap.sub_apply]
    · rw [← c2]
      show fderiv ℝ F₁ x (0, 1, 0) - fderiv ℝ F₂ x (0, 1, 0) =
        fderiv ℝ (fun y => F₁ y - F₂ y) x (0, 1, 0)
      rw [hs, ContinuousLinearMap.sub_apply]
    · rw [← c3]
      show fderiv ℝ F₁ x (0, 0, 1) - fderiv ℝ F₂ x (0, 0, 1) =
        fderiv ℝ (fun y => F₁ y - F₂ y) x (0, 0, 1)
      rw [hs, ContinuousLinearMap.sub_apply]
  have hwD : w ∈ D := by rw [hD]; exact ⟨⟨hwW, hw⟩, hwU⟩
  have hDn : D ∈ nhds w := hDo.mem_nhds hwD

  have hG' : ContDiffOn ℝ ∞ (fderiv ℝ G) U := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hG).2
  have hγwpos : 0 < (mriPath h Y₀ w).1 := hw
  have hdRd : DifferentiableAt ℝ (dR h G) (mriPath h Y₀ w) := by
    have hm : ContDiffAt ℝ ∞ (fun η : Cyl => drx h * η.1 ^ (drx h - 1)) (mriPath h Y₀ w) :=
      contDiffAt_const.mul (contDiffAt_fst.rpow_const_of_ne hγwpos.ne')
    have hs : ContDiffAt ℝ ∞ (fun η : Cyl => (drx h * η.1 ^ (drx h - 1)) • vrv) (mriPath h Y₀ w) :=
      hm.smul contDiffAt_const
    have hdir : ContDiffAt ℝ ∞
        (fun η : Cyl => ((1 : ℝ), (0 : ℝ), (0 : ℝ), (drx h * η.1 ^ (drx h - 1)) • vrv))
        (mriPath h Y₀ w) :=
      contDiffAt_const.prodMk (contDiffAt_const.prodMk (contDiffAt_const.prodMk hs))
    have := (hG'.contDiffAt (hU.mem_nhds hwU)).clm_apply hdir
    exact this.differentiableAt (by simp)
  have hdZd : DifferentiableAt ℝ (dZ G) (mriPath h Y₀ w) := by
    have := (hG'.contDiffAt (hU.mem_nhds hwU)).clm_apply
      (contDiffAt_const (c := ((0 : ℝ), (1 : ℝ), (0 : ℝ), (0 : ℝ × ℝ))))
    exact this.differentiableAt (by simp)

  have hKr : (fun y => wDr F₁ y - wDr F₂ y) =ᶠ[nhds w] (fun y => dR h G (mriPath h Y₀ y)) :=
    Filter.eventuallyEq_of_mem hDn (fun y hy => (first y hy).1)
  have hKz : (fun y => wDz F₁ y - wDz F₂ y) =ᶠ[nhds w] (fun y => dZ G (mriPath h Y₀ y)) :=
    Filter.eventuallyEq_of_mem hDn (fun y hy => (first y hy).2.1)
  have R2 := (chain _ (dR h G) w hw hdRd hKr).1
  have Z2 := (chain _ (dZ G) w hw hdZd hKz).2.1
  have hsr : fderiv ℝ (fun y => wDr F₁ y - wDr F₂ y) w = fderiv ℝ (wDr F₁) w - fderiv ℝ (wDr F₂) w :=
    fderiv_fun_sub (hdF F₁ hF₁ w hwW).2.1 (hdF F₂ hF₂ w hwW).2.1
  have hsz : fderiv ℝ (fun y => wDz F₁ y - wDz F₂ y) w = fderiv ℝ (wDz F₁) w - fderiv ℝ (wDz F₂) w :=
    fderiv_fun_sub (hdF F₁ hF₁ w hwW).2.2 (hdF F₂ hF₂ w hwW).2.2
  have R2' : wDr (wDr F₁) w - wDr (wDr F₂) w = dR h (dR h G) (mriPath h Y₀ w) := by
    rw [← R2]
    show fderiv ℝ (wDr F₁) w (1, 0, 0) - fderiv ℝ (wDr F₂) w (1, 0, 0) =
      fderiv ℝ (fun y => wDr F₁ y - wDr F₂ y) w (1, 0, 0)
    rw [hsr, ContinuousLinearMap.sub_apply]
  have Z2' : wDz (wDz F₁) w - wDz (wDz F₂) w = dZ (dZ G) (mriPath h Y₀ w) := by
    rw [← Z2]
    show fderiv ℝ (wDz F₁) w (0, 1, 0) - fderiv ℝ (wDz F₂) w (0, 1, 0) =
      fderiv ℝ (fun y => wDz F₁ y - wDz F₂ y) w (0, 1, 0)
    rw [hsz, ContinuousLinearMap.sub_apply]

  obtain ⟨E1, E2, E3⟩ := first w hwD
  refine ⟨hEq w hwU, E1, E2, E3, ?_⟩
  have e : (mriPath h Y₀ w).1 = w.1 := rfl
  show (wDr (wDr F₁) w + wDr F₁ w / w.1 + wDz (wDz F₁) w) -
      (wDr (wDr F₂) w + wDr F₂ w / w.1 + wDz (wDz F₂) w) =
    dR h (dR h G) (mriPath h Y₀ w) + dR h G (mriPath h Y₀ w) / (mriPath h Y₀ w).1 +
      dZ (dZ G) (mriPath h Y₀ w)
  rw [e]
  linear_combination R2' + E1 / w.1 + Z2'

theorem cyl_reynolds_diff : ∀ (h : ℝ) (Y₀ : ℝ × ℝ) (u₁ u₂ : ℝ³ → ℝ → ℝ³) (p₁ p₂ : ℝ³ → ℝ → ℝ)
    (O₁ O₂ : Set (ℝ³ × ℝ)) (U : Set Cyl) (dm : Fin 3 → Cyl → ℝ) (dq : Fin 3 → Fin 3 → Cyl → ℝ)
    (dp : Cyl → ℝ) (r z t : ℝ) (ξ : Cyl),
    IsOpen O₁ → ContDiffOn ℝ ∞ (↿u₁) O₁ → ContDiffOn ℝ ∞ (↿p₁) O₁ →
    (∀ x s, (x, s) ∈ O₁ → divergence (fun y => u₁ y s) x = 0) →
    IsOpen O₂ → ContDiffOn ℝ ∞ (↿u₂) O₂ → ContDiffOn ℝ ∞ (↿p₂) O₂ →
    (∀ x s, (x, s) ∈ O₂ → divergence (fun y => u₂ y s) x = 0) →
    0 < r → (∀ θ : ℝ, (rotPt r θ z, t) ∈ O₁) → (∀ θ : ℝ, (rotPt r θ z, t) ∈ O₂) →
    IsOpen U → (∀ a : Fin 3, ContDiffOn ℝ ∞ (dm a) U) → (∀ a b : Fin 3, ContDiffOn ℝ ∞ (dq a b) U) →
    ContDiffOn ℝ ∞ dp U → ξ = mriPath h Y₀ (r, z, t) → ξ ∈ U →
    (∀ w : ℝ × ℝ × ℝ, mriPath h Y₀ w ∈ U → ∀ a : Fin 3,
      mriM u₁ a w - mriM u₂ a w = dm a (mriPath h Y₀ w)) →
    (∀ w : ℝ × ℝ × ℝ, mriPath h Y₀ w ∈ U → ∀ a b : Fin 3,
      mriQ u₁ a b w - mriQ u₂ a b w = dq a b (mriPath h Y₀ w)) →
    (∀ w : ℝ × ℝ × ℝ, mriPath h Y₀ w ∈ U → mriPm p₁ w - mriPm p₂ w = dp (mriPath h Y₀ w)) →
    (mriRes u₁ p₁ 0 (r, z, t) - mriRes u₂ p₂ 0 (r, z, t) =
      dT (dm 0) ξ + dR h (dq 0 0) ξ + dq 0 0 ξ / ξ.1 + dZ (dq 2 0) ξ - dq 1 1 ξ / ξ.1
        - (lap0 h (dm 0) ξ - dm 0 ξ / ξ.1 ^ 2) + dR h dp ξ) ∧
    (mriRes u₁ p₁ 1 (r, z, t) - mriRes u₂ p₂ 1 (r, z, t) =
      dT (dm 1) ξ + dR h (dq 0 1) ξ + 2 * dq 0 1 ξ / ξ.1 + dZ (dq 2 1) ξ
        - (lap0 h (dm 1) ξ - dm 1 ξ / ξ.1 ^ 2)) ∧
    (mriRes u₁ p₁ 2 (r, z, t) - mriRes u₂ p₂ 2 (r, z, t) =
      dT (dm 2) ξ + dR h (dq 0 2) ξ + dq 0 2 ξ / ξ.1 + dZ (fun η => dq 2 2 η + dp η) ξ
        - lap0 h (dm 2) ξ) :=
by
  intro h Y₀ u₁ u₂ p₁ p₂ O₁ O₂ U dm dq dp r z t ξ hO₁ hu₁ hp₁ hd₁ hO₂ hu₂ hp₂ hd₂ hr hc₁ hc₂ hU hdm hdq hdp
    hξ hξU hM hQ hP
  subst hξ

  have rows : ∀ (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (O : Set (ℝ³ × ℝ)), IsOpen O →
      ContDiffOn ℝ ∞ (↿u) O → ContDiffOn ℝ ∞ (↿p) O →
      (∀ x s, (x, s) ∈ O → divergence (fun y => u y s) x = 0) → (∀ θ : ℝ, (rotPt r θ z, t) ∈ O) →
      mriRes u p 0 (r, z, t) = thA (fun θ => crRow0 (crU u) (crP p) (r, θ, z, t)) ∧
      mriRes u p 1 (r, z, t) = thA (fun θ => crRow1 (crU u) (crP p) (r, θ, z, t)) ∧
      mriRes u p 2 (r, z, t) = thA (fun θ => crRow2 (crU u) (crP p) (r, θ, z, t)) := by
    intro u p O hO hu hp hd hc
    have key : ∀ (θ : ℝ) (a : Fin 3),
        inner ℝ (nsResidual 1 u p (rotPt r θ z) t) (frameAt θ (r, z, t, 0) a) =
          inner ℝ (deriv (fun s => u (rotPt r θ z) s) t) (frameAt θ (r, z, t, 0) a) +
          inner ℝ (fderiv ℝ (fun y => u y t) (rotPt r θ z) (u (rotPt r θ z) t)) (frameAt θ (r, z, t, 0) a) -
          inner ℝ (Δ (fun y => u y t) (rotPt r θ z)) (frameAt θ (r, z, t, 0) a) +
          inner ℝ (gradient (fun y => p y t) (rotPt r θ z)) (frameAt θ (r, z, t, 0) a) := by
      intro θ a
      simp only [nsResidual, one_smul, inner_add_left, inner_sub_left]
    refine ⟨?_, ?_, ?_⟩
    · show thA (fun θ => inner ℝ (nsResidual 1 u p (rotPt r θ z) t) (frameAt θ (r, z, t, 0) 0)) = _
      congr 1
      funext θ
      obtain ⟨hT, hP0, hP1, hP2⟩ := cyl_frame_tp u p O r θ z t hO hu hp hr (hc θ)
      obtain ⟨hC0, hC1, hC2⟩ := cyl_frame_conv u O r θ z t hO hu hr (hc θ)
      obtain ⟨hL0, hL1, hL2⟩ := cyl_frame_lap u O r θ z t hO hu hr (hc θ)
      have hdv := hd _ _ (hc θ)
      rw [key θ 0]
      dsimp only [crRow0]
      linear_combination hT 0 + hC0 - hL0 + hP0 - crU u 0 (r, θ, z, t) * hdv
    · show thA (fun θ => inner ℝ (nsResidual 1 u p (rotPt r θ z) t) (frameAt θ (r, z, t, 0) 1)) = _
      congr 1
      funext θ
      obtain ⟨hT, hP0, hP1, hP2⟩ := cyl_frame_tp u p O r θ z t hO hu hp hr (hc θ)
      obtain ⟨hC0, hC1, hC2⟩ := cyl_frame_conv u O r θ z t hO hu hr (hc θ)
      obtain ⟨hL0, hL1, hL2⟩ := cyl_frame_lap u O r θ z t hO hu hr (hc θ)
      have hdv := hd _ _ (hc θ)
      rw [key θ 1]
      dsimp only [crRow1]
      linear_combination hT 1 + hC1 - hL1 + hP1 - crU u 1 (r, θ, z, t) * hdv
    · show thA (fun θ => inner ℝ (nsResidual 1 u p (rotPt r θ z) t) (frameAt θ (r, z, t, 0) 2)) = _
      congr 1
      funext θ
      obtain ⟨hT, hP0, hP1, hP2⟩ := cyl_frame_tp u p O r θ z t hO hu hp hr (hc θ)
      obtain ⟨hC0, hC1, hC2⟩ := cyl_frame_conv u O r θ z t hO hu hr (hc θ)
      obtain ⟨hL0, hL1, hL2⟩ := cyl_frame_lap u O r θ z t hO hu hr (hc θ)
      have hdv := hd _ _ (hc θ)
      rw [key θ 2]
      dsimp only [crRow2]
      linear_combination hT 2 + hC2 - hL2 + hP2 - crU u 2 (r, θ, z, t) * hdv
  have R₁ := rows u₁ p₁ O₁ hO₁ hu₁ hp₁ hd₁ hc₁
  have R₂ := rows u₂ p₂ O₂ hO₂ hu₂ hp₂ hd₂ hc₂

  obtain ⟨W₁, hW₁o, hw₁, hpos₁, hcirc₁⟩ := cyl_tube O₁ r z t hO₁ hr hc₁
  obtain ⟨W₂, hW₂o, hw₂, hpos₂, hcirc₂⟩ := cyl_tube O₂ r z t hO₂ hr hc₂
  have hWo : IsOpen (W₁ ∩ W₂) := hW₁o.inter hW₂o
  have hwW : ((r, z, t) : ℝ × ℝ × ℝ) ∈ W₁ ∩ W₂ := ⟨hw₁, hw₂⟩

  have hsub : ∀ (O : Set (ℝ³ × ℝ)), (∀ w ∈ W₁ ∩ W₂, ∀ θ : ℝ, (rotPt w.1 θ w.2.1, w.2.2) ∈ O) →
      {v : ℝ × ℝ × ℝ × ℝ | (v.1, v.2.2.1, v.2.2.2) ∈ W₁ ∩ W₂} ⊆
        {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} := by
    intro O hcirc v hv
    exact ⟨hpos₁ _ hv.1, hcirc _ hv v.2.1⟩
  obtain ⟨-, hsU₁, hsP₁, hpU₁, hpP₁⟩ := cyl_lift_smooth u₁ p₁ O₁ hO₁ hu₁ hp₁
  obtain ⟨-, hsU₂, hsP₂, hpU₂, hpP₂⟩ := cyl_lift_smooth u₂ p₂ O₂ hO₂ hu₂ hp₂
  have hs₁ := hsub O₁ (fun w hw => hcirc₁ w hw.1)
  have hs₂ := hsub O₂ (fun w hw => hcirc₂ w hw.2)

  obtain ⟨hMs₁, hQs₁, hPs₁, hA₁0, hA₁1, hA₁2⟩ := cyl_avg_rows (crU u₁) (crP p₁) (W₁ ∩ W₂) (r, z, t) hWo hwW
    (fun a => (hsU₁ a).mono hs₁) (hsP₁.mono hs₁) hpU₁ hpP₁
  obtain ⟨hMs₂, hQs₂, hPs₂, hA₂0, hA₂1, hA₂2⟩ := cyl_avg_rows (crU u₂) (crP p₂) (W₁ ∩ W₂) (r, z, t) hWo hwW
    (fun a => (hsU₂ a).mono hs₂) (hsP₂.mono hs₂) hpU₂ hpP₂
  dsimp only at hA₁0 hA₁1 hA₁2 hA₂0 hA₂1 hA₂2

  have TM := fun a => cyl_path_transfer h Y₀ (crAv (crU u₁ a)) (crAv (crU u₂ a)) (dm a) (W₁ ∩ W₂) U (r, z, t)
    hWo hwW (hMs₁ a) (hMs₂ a) hU (hdm a) hr hξU (fun w' hw' => hM w' hw' a)
  have TQ := fun a b => cyl_path_transfer h Y₀ (crAv (fun η => crU u₁ a η * crU u₁ b η))
    (crAv (fun η => crU u₂ a η * crU u₂ b η)) (dq a b) (W₁ ∩ W₂) U (r, z, t)
    hWo hwW (hQs₁ a b) (hQs₂ a b) hU (hdq a b) hr hξU (fun w' hw' => hQ w' hw' a b)
  have TP := cyl_path_transfer h Y₀ (crAv (crP p₁)) (crAv (crP p₂)) dp (W₁ ∩ W₂) U (r, z, t)
    hWo hwW hPs₁ hPs₂ hU hdp hr hξU (fun w' hw' => hP w' hw')
  have hZadd : dZ (fun η => dq 2 2 η + dp η) (mriPath h Y₀ (r, z, t)) =
      dZ (dq 2 2) (mriPath h Y₀ (r, z, t)) + dZ dp (mriPath h Y₀ (r, z, t)) := by
    have h1 : DifferentiableAt ℝ (dq 2 2) (mriPath h Y₀ (r, z, t)) :=
      ((hdq 2 2).contDiffAt (hU.mem_nhds hξU)).differentiableAt (by norm_num)
    have h2 : DifferentiableAt ℝ dp (mriPath h Y₀ (r, z, t)) :=
      (hdp.contDiffAt (hU.mem_nhds hξU)).differentiableAt (by norm_num)
    simp only [dZ]
    rw [fderiv_fun_add h1 h2, ContinuousLinearMap.add_apply]
  have e1 : (mriPath h Y₀ (r, z, t)).1 = r := rfl
  rw [e1]

  refine ⟨?_, ?_, ?_⟩
  · linear_combination R₁.1 - R₂.1 + hA₁0 - hA₂0 + (TM 0).2.2.2.1 + (TQ 0 0).2.1 + (TQ 0 0).1 / r
      + (TQ 2 0).2.2.1 - (TQ 1 1).1 / r - (TM 0).2.2.2.2 + (TM 0).1 / r ^ 2 + TP.2.1
  · linear_combination R₁.2.1 - R₂.2.1 + hA₁1 - hA₂1 + (TM 1).2.2.2.1 + (TQ 0 1).2.1 + 2 * (TQ 0 1).1 / r
      + (TQ 2 1).2.2.1 - (TM 1).2.2.2.2 + (TM 1).1 / r ^ 2
  · linear_combination R₁.2.2 - R₂.2.2 + hA₁2 - hA₂2 + (TM 2).2.2.2.1 + (TQ 0 2).2.1 + (TQ 0 2).1 / r
      + (TQ 2 2).2.2.1 - (TM 2).2.2.2.2 + TP.2.2.1 - hZadd

theorem mean_residual_identity_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
    l1 ≤ l0 → ∀ (S : CState) (bw ca cm cd : ℝ), StOrd5 B G l0 S bw ca cm cd → MeanId5 B G l0 S :=
by
  intro B G hok hG
  have hqB0 : 0 < B.qB := hok.2.1.2.2.2.2.2.2.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 S bw ca cm cd hSt => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs0 : 0 < qsOf l0 := by rw [hQb]; positivity
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  have hsub : simDomain B.h (qsOf l0) ⊆ simDomain B.h B.qB :=
    fun w hw => ⟨hw.1, lt_of_lt_of_le hw.2 hqsB⟩

  obtain ⟨hO₂, hu₂, hp₂, hd₂, hEs⟩ := bg_flow_props B hok
  obtain ⟨hsB0, hK3⟩ := bg_mean_residual B hok
  have hBP := hok.2
  unfold BackgroundProps at hBP
  obtain ⟨-, -, -, -, -, -, -, -, -, hB10, -, -⟩ := hBP
  have hflat : ∀ m N : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) →
      ‖iteratedFDeriv ℝ m (↿(mriE B)) (x, t)‖ ≤ C * simScale B.h (x 2) (1 - t) ^ (N : ℝ) := by
    intro m N
    obtain ⟨C, hC⟩ := hB10 m N
    exact ⟨C, fun x t hxt => hC x t (hsub hxt)⟩
  have hK1 := rotavg_flat B.h (qsOf l0) (mriE B) hok.1 hqs0 (hEs.mono hsub) hflat

  obtain ⟨hU, hub, hmc, hW, hpm⟩ := state_cyl_smooth_v5 B G l0 S bw ca cm cd hok hG hqsB hSt
  have hdq : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (mriDq5 B G l0 S a b) (DomC B.h (qsOf l0)) := by
    intro a b
    exact ((((hub a).mul (hmc b)).add ((hmc a).mul (hub b))).add ((hmc a).mul (hmc b))).add (hW a b)

  have hq00 : mriDq5 B G l0 S 0 0 = fun η => 2 * ubase B η 0 * mcor5 B G l0 S 0 η + mcor5 B G l0 S 0 η ^ 2 +
      Wcov5 B G l0 S 0 0 η := by
    funext η; simp only [mriDq5]; ring
  have hq20 : mriDq5 B G l0 S 2 0 = fun η => ubase B η 0 * mcor5 B G l0 S 2 η + ubase B η 2 * mcor5 B G l0 S 0 η +
      mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 2 0 η := by
    funext η; simp only [mriDq5]; ring
  have hq11 : mriDq5 B G l0 S 1 1 = fun η => 2 * ubase B η 1 * mcor5 B G l0 S 1 η + mcor5 B G l0 S 1 η ^ 2 +
      Wcov5 B G l0 S 1 1 η := by
    funext η; simp only [mriDq5]; ring
  have hq01 : mriDq5 B G l0 S 0 1 = fun η => ubase B η 0 * mcor5 B G l0 S 1 η + mcor5 B G l0 S 0 η * ubase B η 1 +
      mcor5 B G l0 S 0 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 0 1 η := by
    funext η; rfl
  have hq21 : mriDq5 B G l0 S 2 1 = fun η => ubase B η 2 * mcor5 B G l0 S 1 η + ubase B η 1 * mcor5 B G l0 S 2 η +
      mcor5 B G l0 S 2 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 2 1 η := by
    funext η; simp only [mriDq5]; ring
  have hq02 : mriDq5 B G l0 S 0 2 = fun η => ubase B η 0 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 0 η * ubase B η 2 +
      mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 0 2 η := by
    funext η; rfl
  have hq22 : mriDq5 B G l0 S 2 2 = fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η ^ 2 +
      Wcov5 B G l0 S 2 2 η := by
    funext η; simp only [mriDq5]; ring
  refine ⟨fun x t _ => thAvgVec (fun x' t' _ => mriE B x' t') x t 0, ?_, ?_⟩
  · intro m N
    obtain ⟨C, hC⟩ := hK1 m N
    exact ⟨C, fun Y₀ x t hxt => hC x t hxt⟩
  · intro x t Y hc
    have hr0 : 0 < rad x := hc.1
    have hrot2 : ∀ θ : ℝ, rotPt (rad x) θ (x 2) 2 = x 2 := by
      intro θ; simp [rotPt]
    have hradx : ∀ θ : ℝ, rad (rotPt (rad x) θ (x 2)) = rad x := by
      intro θ
      have e0 : rotPt (rad x) θ (x 2) 0 = rad x * Real.cos θ := by simp [rotPt]
      have e1 : rotPt (rad x) θ (x 2) 1 = rad x * Real.sin θ := by simp [rotPt]
      have e : (rad x * Real.cos θ) ^ 2 + (rad x * Real.sin θ) ^ 2 = rad x ^ 2 := by
        linear_combination (rad x) ^ 2 * Real.cos_sq_add_sin_sq θ
      show Real.sqrt ((rotPt (rad x) θ (x 2)) 0 ^ 2 + (rotPt (rad x) θ (x 2)) 1 ^ 2) = rad x
      rw [e0, e1, e, Real.sqrt_sq hr0.le]
    obtain ⟨Y₀, hY₀⟩ : ∃ Y₀ : ℝ × ℝ, Y₀ = Y - Yph B.h (rad x) t := ⟨_, rfl⟩
    have hpath : mriPath B.h Y₀ (rad x, x 2, t) = ptOf x t Y := by
      rw [hY₀]; simp [mriPath, ptOf]
    have hξU : ptOf x t Y ∈ DomC B.h (qsOf l0) := hc
    obtain ⟨hO₁, hu₁, hp₁, hd₁⟩ := state_flow_props_v5 B G l0 S bw ca cm cd hok hG hqsB hSt Y₀
    have hK6 := state_mean_moments_v5 B G l0 S bw ca cm cd hok hG hqsB hSt Y₀
    have hc₁ : ∀ θ : ℝ, (rotPt (rad x) θ (x 2), t) ∈ {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} := by
      intro θ
      show 0 < rad (rotPt (rad x) θ (x 2)) ∧ t < 1 ∧
        simScale B.h ((rotPt (rad x) θ (x 2)) 2) (1 - t) < qsOf l0
      rw [hradx θ, hrot2 θ]
      exact hc
    have hc₂ : ∀ θ : ℝ, (rotPt (rad x) θ (x 2), t) ∈ simDomain B.h B.qB := by
      intro θ
      show t < 1 ∧ simScale B.h ((rotPt (rad x) θ (x 2)) 2) (1 - t) < B.qB
      rw [hrot2 θ]
      exact ⟨hc.2.1, lt_of_lt_of_le hc.2.2 hqsB⟩
    obtain ⟨hrow0, hrow1, hrow2⟩ := cyl_reynolds_diff B.h Y₀ (evOff B.h (uX5 B G l0 S) Y₀) (uB B)
      (evOff B.h (PX5 B G l0 S) Y₀) B.PB {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} (simDomain B.h B.qB)
      (DomC B.h (qsOf l0)) (mcor5 B G l0 S) (mriDq5 B G l0 S) (pmP5 B G l0 S) (rad x) (x 2) t (ptOf x t Y)
      hO₁ hu₁ hp₁ hd₁ hO₂ hu₂ hp₂ hd₂ hr0 hc₁ hc₂ hU hmc hdq hpm hpath.symm hξU
      (fun w hw => (hK6 w hw).1) (fun w hw => (hK6 w hw).2.1) (fun w hw => (hK6 w hw).2.2)
    rw [hq00, hq20, hq11] at hrow0
    rw [hq01, hq21] at hrow1
    rw [hq02, hq22] at hrow2
    beta_reduce at hrow0 hrow1 hrow2

    have hB : ∀ a : Fin 3, mriRes (uB B) B.PB a (rad x, x 2, t) = sBase B a (ptOf x t Y) +
        thA (fun θ => inner ℝ (mriE B (rotPt (rad x) θ (x 2)) t) (frameAt θ (ptOf x t 0) a)) :=
      fun a => hK3 (ptOf x t Y) a hr0 hc.2.1 (lt_of_lt_of_le hc.2.2 hqsB)

    have hL : ∀ a : Fin 3, thA (fun θ => inner ℝ (resX B.h (uX5 B G l0 S) (PX5 B G l0 S) (rotPt (rad x) θ (x 2)) t Y)
        (frameAt θ (ptOf x t Y) a)) =
        mriRes (evOff B.h (uX5 B G l0 S) Y₀) (evOff B.h (PX5 B G l0 S) Y₀) a (rad x, x 2, t) := by
      intro a
      unfold mriRes
      congr 1
      funext θ
      simp only [resX, hradx θ, ← hY₀] <;> rfl
    have h0 : thA (fun θ => inner ℝ (resX B.h (uX5 B G l0 S) (PX5 B G l0 S) (rotPt (rad x) θ (x 2)) t Y)
        (frameAt θ (ptOf x t Y) 0)) = meanResP5 B G l0 S (ptOf x t Y) 0 +
        thA (fun θ => inner ℝ (mriE B (rotPt (rad x) θ (x 2)) t) (frameAt θ (ptOf x t 0) 0)) := by
      rw [hL 0]
      have e := hB 0
      have hs := hsB0 (ptOf x t Y)
      have hm : meanResP5 B G l0 S (ptOf x t Y) 0 = dR B.h (pmP5 B G l0 S) (ptOf x t Y) -
          grP5 B G l0 S (ptOf x t Y) := rfl
      rw [hm]
      simp only [grP5]
      linear_combination hrow0 + e + hs
    have h1 : thA (fun θ => inner ℝ (resX B.h (uX5 B G l0 S) (PX5 B G l0 S) (rotPt (rad x) θ (x 2)) t Y)
        (frameAt θ (ptOf x t Y) 1)) = meanResP5 B G l0 S (ptOf x t Y) 1 +
        thA (fun θ => inner ℝ (mriE B (rotPt (rad x) θ (x 2)) t) (frameAt θ (ptOf x t 0) 1)) := by
      rw [hL 1]
      have e := hB 1
      have hm : meanResP5 B G l0 S (ptOf x t Y) 1 = EthP5 B G l0 S (ptOf x t Y) := rfl
      rw [hm]
      simp only [EthP5]
      linear_combination hrow1 + e
    have h2 : thA (fun θ => inner ℝ (resX B.h (uX5 B G l0 S) (PX5 B G l0 S) (rotPt (rad x) θ (x 2)) t Y)
        (frameAt θ (ptOf x t Y) 2)) = meanResP5 B G l0 S (ptOf x t Y) 2 +
        thA (fun θ => inner ℝ (mriE B (rotPt (rad x) θ (x 2)) t) (frameAt θ (ptOf x t 0) 2)) := by
      rw [hL 2]
      have e := hB 2
      have hm : meanResP5 B G l0 S (ptOf x t Y) 2 = EzP5 B G l0 S (ptOf x t Y) := rfl
      rw [hm]
      simp only [EzP5]
      linear_combination hrow2 + e
    have hcyl : ∀ (c d : Fin 3 → ℝ), cyl2cart x c + cyl2cart x d = cyl2cart x (fun a => c a + d a) := by
      intro c d
      simp only [cyl2cart, add_smul]
      abel
    simp only [thAvgVec]
    rw [hcyl]
    congr 1
    funext a
    fin_cases a
    · exact h0
    · exact h1
    · exact h2

theorem profile_tuple_bounds : ∀ B : BG, B.ok → ∃ (κ D : ℝ), 0 < κ ∧ κ < 2 ∧ κ ≤ D ∧
    ∀ X η : ℝ, B.Xa ≤ X → X ≤ B.Xb → -1 < η → η < 1 →
      κ ≤ B.F X η ∧ B.F X η ≤ D ∧ κ ≤ shearA B.F X η ∧ shearA B.F X η ≤ D ∧
      |shearB B.F B.U X η| ≤ D ∧
      (2 + κ) * shearA B.F X η ≤ shearA B.F X η ^ 2 + shearB B.F B.U X η ^ 2 :=
by
  intro B hB
  have hBP := hB.2
  unfold BackgroundProps at hBP
  obtain ⟨⟨-, -, hXa, hXm1, hm12, hm2Xb, -⟩, ⟨hFs, hUs, hFpos, hbd⟩,
    ⟨-, -, -, -, -, -, ⟨κ, hκ0, hκ2, hK⟩⟩, -⟩ := hBP
  have hXab : B.Xa < B.Xb := by linarith
  have hopen : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo

  have slice : ∀ (f : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿f) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ∀ η : ℝ, -1 < η → η < 1 → ContDiffOn ℝ ∞ (fun Y => f Y η) (Ioi 0) := by
    intro f hf η h1 h2
    have hg : ContDiff ℝ ∞ (fun Y : ℝ => (Y, η)) := contDiff_id.prodMk contDiff_const
    exact hf.comp hg.contDiffOn (fun Y hY => ⟨hY, h1, h2⟩)

  have hderiv : ∀ (f : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿f) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ∀ X η : ℝ, 0 < X → -1 < η → η < 1 →
      |deriv (fun Y => f Y η) X| ≤ ‖iteratedFDeriv ℝ 1 (↿f) (X, η)‖ := by
    intro f hf X η hX h1 h2
    have hmem : (X, η) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := ⟨hX, h1, h2⟩
    have hdiff : DifferentiableAt ℝ (↿f) (X, η) :=
      (hf.contDiffAt (hopen.mem_nhds hmem)).differentiableAt (by simp)
    have hcurve : HasDerivAt (fun Y : ℝ => (Y, η)) ((1:ℝ), (0:ℝ)) X :=
      (hasDerivAt_id' X).prodMk (hasDerivAt_const X η)
    have hcomp := hdiff.hasFDerivAt.comp_hasDerivAt X hcurve
    have heq : deriv (fun Y => f Y η) X = fderiv ℝ (↿f) (X, η) ((1:ℝ), (0:ℝ)) := hcomp.deriv
    rw [heq, norm_iteratedFDeriv_one, ← Real.norm_eq_abs]
    calc ‖fderiv ℝ (↿f) (X, η) ((1:ℝ), (0:ℝ))‖
        ≤ ‖fderiv ℝ (↿f) (X, η)‖ * ‖((1:ℝ), (0:ℝ))‖ := (fderiv ℝ (↿f) (X, η)).le_opNorm _
      _ = ‖fderiv ℝ (↿f) (X, η)‖ := by simp [Prod.norm_def]

  have cont : ∀ η : ℝ, -1 < η → η < 1 →
      ContinuousOn (fun X => B.F X η) (Ioi 0) ∧ ContinuousOn (fun X => shearA B.F X η) (Ioi 0) ∧
      ContinuousOn (fun X => shearB B.F B.U X η) (Ioi 0) := by
    intro η h1 h2
    have sF := slice B.F hFs η h1 h2
    have sU := slice B.U hUs η h1 h2
    have cF : ContinuousOn (fun X => B.F X η) (Ioi 0) := sF.continuousOn
    have dF : ContinuousOn (deriv fun Y => B.F Y η) (Ioi 0) :=
      sF.continuousOn_deriv_of_isOpen isOpen_Ioi (by simp)
    have dU : ContinuousOn (deriv fun Y => B.U Y η) (Ioi 0) :=
      sU.continuousOn_deriv_of_isOpen isOpen_Ioi (by simp)
    have hne : ∀ X ∈ Ioi (0:ℝ), B.F X η ≠ 0 := fun X hX => (hFpos X η hX h1 h2).ne'
    refine ⟨cF, ?_, ?_⟩
    · unfold shearA
      exact ((continuousOn_const.mul continuousOn_id).mul dF).div cF hne
    · unfold shearB
      exact (((Real.continuous_sqrt.comp (continuous_const.mul continuous_id)).continuousOn).mul
        dU).div cF hne

  have clos : ∀ (f g : ℝ → ℝ), ContinuousOn f (Ioi 0) → ContinuousOn g (Ioi 0) →
      (∀ X, B.Xa < X → X < B.Xb → f X ≤ g X) → ∀ X, B.Xa ≤ X → X ≤ B.Xb → f X ≤ g X := by
    intro f g hf hg hle X h1 h2
    have hX0 : X ∈ Ioi (0:ℝ) := show (0:ℝ) < X by linarith
    have hcl : X ∈ closure (Ioo B.Xa B.Xb) := by rw [closure_Ioo hXab.ne]; exact ⟨h1, h2⟩
    exact ContinuousWithinAt.closure_le hcl
      ((hf.continuousAt (isOpen_Ioi.mem_nhds hX0)).continuousWithinAt)
      ((hg.continuousAt (isOpen_Ioi.mem_nhds hX0)).continuousWithinAt)
      (fun y hy => hle y hy.1 hy.2)

  have alg : ∀ a b k : ℝ, 0 < a → k ≤ a * (1 + (b / a) ^ 2) - 2 → (2 + k) * a ≤ a ^ 2 + b ^ 2 := by
    intro a b k ha h
    have h1 : a * (b / a) = b := by field_simp [ha.ne']
    have hid : a * (a * (1 + (b / a) ^ 2)) = a ^ 2 + (a * (b / a)) ^ 2 := by ring
    rw [h1] at hid
    have hm := mul_le_mul_of_nonneg_left (show 2 + k ≤ a * (1 + (b / a) ^ 2) by linarith) ha.le
    nlinarith

  obtain ⟨C0, hC0⟩ := hbd B.Xa B.Xb hXa 0
  obtain ⟨C1', hC1'⟩ := hbd B.Xa B.Xb hXa 1
  obtain ⟨C1, hC1def⟩ : ∃ C : ℝ, C = max C0 C1' := ⟨_, rfl⟩
  have hC0le : C0 ≤ C1 := by rw [hC1def]; exact le_max_left _ _
  have hC1le : C1' ≤ C1 := by rw [hC1def]; exact le_max_right _ _
  refine ⟨κ, max κ (max C1 (max (2 * B.Xb * C1 / κ) (Real.sqrt (2 * B.Xb) * C1 / κ))),
    hκ0, hκ2, le_max_left _ _, ?_⟩
  intro X η h1 h2 h3 h4
  obtain ⟨cF, cA, cB⟩ := cont η h3 h4
  have hX0 : 0 < X := by linarith
  have L1 : κ ≤ B.F X η := clos (fun _ => κ) (fun X => B.F X η) continuousOn_const cF
    (fun X' a b => (hK X' η a b h3 h4).1) X h1 h2
  have L2 : κ ≤ shearA B.F X η := clos (fun _ => κ) (fun X => shearA B.F X η) continuousOn_const cA
    (fun X' a b => (hK X' η a b h3 h4).2.1) X h1 h2
  have L3 : (2 + κ) * shearA B.F X η ≤ shearA B.F X η ^ 2 + shearB B.F B.U X η ^ 2 :=
    clos (fun X => (2 + κ) * shearA B.F X η)
      (fun X => shearA B.F X η ^ 2 + shearB B.F B.U X η ^ 2)
      (continuousOn_const.mul cA) ((cA.pow 2).add (cB.pow 2))
      (fun X' a b => by
        obtain ⟨k1, k2, k3, -⟩ := hK X' η a b h3 h4
        exact alg _ _ κ (by linarith) k3) X h1 h2
  obtain ⟨b0F, -⟩ := hC0 X η h1 h2 h3 h4
  obtain ⟨b1F, b1U⟩ := hC1' X η h1 h2 h3 h4
  rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at b0F
  have dFb : |deriv (fun Y => B.F Y η) X| ≤ C1 :=
    ((hderiv B.F hFs X η hX0 h3 h4).trans b1F).trans hC1le
  have dUb : |deriv (fun Y => B.U Y η) X| ≤ C1 :=
    ((hderiv B.U hUs X η hX0 h3 h4).trans b1U).trans hC1le
  have Fb : |B.F X η| ≤ C1 := b0F.trans hC0le
  have hC1nn : 0 ≤ C1 := (abs_nonneg _).trans Fb
  have hFp : 0 < B.F X η := by linarith
  have hXb0 : 0 ≤ B.Xb := by linarith
  have U2 : shearA B.F X η ≤ 2 * B.Xb * C1 / κ := by
    unfold shearA
    have hd := abs_le.mp dFb
    have e1 : -2 * X * deriv (fun Y => B.F Y η) X ≤ 2 * B.Xb * C1 := by
      nlinarith [mul_nonneg hX0.le (show 0 ≤ deriv (fun Y => B.F Y η) X + C1 by linarith),
        mul_nonneg (show 0 ≤ B.Xb - X by linarith) hC1nn]
    calc -2 * X * deriv (fun Y => B.F Y η) X / B.F X η ≤ 2 * B.Xb * C1 / B.F X η :=
          div_le_div_of_nonneg_right e1 hFp.le
      _ ≤ 2 * B.Xb * C1 / κ :=
          div_le_div_of_nonneg_left (mul_nonneg (mul_nonneg (by norm_num) hXb0) hC1nn) hκ0 L1
  have U3 : |shearB B.F B.U X η| ≤ Real.sqrt (2 * B.Xb) * C1 / κ := by
    unfold shearB
    rw [abs_div, abs_mul, abs_of_nonneg (Real.sqrt_nonneg _), abs_of_pos hFp]
    have e2 : Real.sqrt (2 * X) * |deriv (fun Y => B.U Y η) X| ≤ Real.sqrt (2 * B.Xb) * C1 :=
      mul_le_mul (Real.sqrt_le_sqrt (by linarith)) dUb (abs_nonneg _) (Real.sqrt_nonneg _)
    calc Real.sqrt (2 * X) * |deriv (fun Y => B.U Y η) X| / B.F X η
        ≤ Real.sqrt (2 * B.Xb) * C1 / B.F X η := div_le_div_of_nonneg_right e2 hFp.le
      _ ≤ Real.sqrt (2 * B.Xb) * C1 / κ :=
          div_le_div_of_nonneg_left (mul_nonneg (Real.sqrt_nonneg _) hC1nn) hκ0 L1
  refine ⟨L1, ?_, L2, ?_, ?_, L3⟩
  · exact (((le_abs_self _).trans Fb).trans (le_max_left _ _)).trans (le_max_right _ _)
  · exact U2.trans ((le_max_left _ _).trans ((le_max_right _ _).trans (le_max_right _ _)))
  · exact U3.trans ((le_max_right _ _).trans ((le_max_right _ _).trans (le_max_right _ _)))

theorem profile_tuple_lip : ∀ B : BG, B.ok → ∀ κ : ℝ, 0 < κ →
    (∀ X η : ℝ, B.Xa ≤ X → X ≤ B.Xb → -1 < η → η < 1 → κ ≤ B.F X η) →
    ∃ Lp : ℝ, 0 ≤ Lp ∧ ∀ X X' η η' : ℝ, B.Xa ≤ X → X ≤ B.Xb → B.Xa ≤ X' → X' ≤ B.Xb →
      -1 < η → η < 1 → -1 < η' → η' < 1 →
      |B.F X η - B.F X' η'| + |shearA B.F X η - shearA B.F X' η'| +
        |shearB B.F B.U X η - shearB B.F B.U X' η'| ≤ Lp * (|X - X'| + |η - η'|) :=
by
  intro B hB κ hκ hκF
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -⟩ := hB.2.1
  obtain ⟨hFs, hUs, -, hbd⟩ := hB.2.2.1
  have hXab : B.Xa < B.Xb := by linarith
  have core : ∀ (F U : ℝ → ℝ → ℝ) (Xa Xb : ℝ), 0 < Xa → Xa < Xb →
      ContDiffOn ℝ ∞ (Function.uncurry F) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (Function.uncurry U) (Ioi 0 ×ˢ Ioo (-1) 1) →
      (∀ X₀ X₁ : ℝ, 0 < X₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, X₀ ≤ X → X ≤ X₁ → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ m (Function.uncurry F) (X, η)‖ ≤ C ∧
          ‖iteratedFDeriv ℝ m (Function.uncurry U) (X, η)‖ ≤ C) →
      (∀ X η : ℝ, Xa ≤ X → X ≤ Xb → -1 < η → η < 1 → κ ≤ F X η) →
      ∃ Lp : ℝ, 0 ≤ Lp ∧ ∀ X X' η η' : ℝ, Xa ≤ X → X ≤ Xb → Xa ≤ X' → X' ≤ Xb →
        -1 < η → η < 1 → -1 < η' → η' < 1 →
        |F X η - F X' η'| + |shearA F X η - shearA F X' η'| +
          |shearB F U X η - shearB F U X' η'| ≤ Lp * (|X - X'| + |η - η'|) := by
    intro F U Xa Xb hXa hXab hFs hUs hbd hκF
    obtain ⟨Ca, hCa⟩ := hbd Xa Xb hXa 1
    obtain ⟨Cb, hCb⟩ := hbd Xa Xb hXa 2
    have hO : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
    have hSc : Convex ℝ (Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1) := (convex_Icc Xa Xb).prod (convex_Ioo (-1) 1)
    have hSO : ∀ z ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1, z ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := fun z hz =>
      ⟨lt_of_lt_of_le hXa hz.1.1, hz.2⟩
    have e1 : ‖((1:ℝ), (0:ℝ))‖ = 1 := by simp [Prod.norm_def]

    have mvt : ∀ f : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (Function.uncurry f) (Ioi 0 ×ˢ Ioo (-1) 1) →
        (∀ X η : ℝ, Xa ≤ X → X ≤ Xb → -1 < η → η < 1 →
          ‖iteratedFDeriv ℝ 1 (Function.uncurry f) (X, η)‖ ≤ max Ca 0 ∧
          ‖iteratedFDeriv ℝ 2 (Function.uncurry f) (X, η)‖ ≤ max Cb 0) →
        ∀ X X' η η' : ℝ, Xa ≤ X → X ≤ Xb → Xa ≤ X' → X' ≤ Xb → -1 < η → η < 1 → -1 < η' → η' < 1 →
        |f X η - f X' η'| ≤ max Ca 0 * (|X - X'| + |η - η'|) ∧
        deriv (fun Y => f Y η) X = fderiv ℝ (Function.uncurry f) (X, η) (1, 0) ∧
        |fderiv ℝ (Function.uncurry f) (X, η) (1, 0)| ≤ max Ca 0 ∧
        |fderiv ℝ (Function.uncurry f) (X, η) (1, 0) -
            fderiv ℝ (Function.uncurry f) (X', η') (1, 0)| ≤ max Cb 0 * (|X - X'| + |η - η'|) := by
      intro f hs hb X X' η η' h1 h2 h3 h4 h5 h6 h7 h8
      have hca : ∀ z ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1, ContDiffAt ℝ ∞ (Function.uncurry f) z :=
        fun z hz => hs.contDiffAt (hO.mem_nhds (hSO z hz))
      have hd1 : ∀ z ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1, DifferentiableAt ℝ (Function.uncurry f) z :=
        fun z hz => (hca z hz).differentiableAt (by simp)
      have hd2 : ∀ z ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1,
          DifferentiableAt ℝ (fderiv ℝ (Function.uncurry f)) z := fun z hz =>
        ((hca z hz).fderiv_right (m := 1) (by simp)).differentiableAt (by norm_num)
      have hb1 : ∀ z ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1, ‖fderiv ℝ (Function.uncurry f) z‖ ≤ max Ca 0 :=
        fun z hz => by
          rw [← norm_iteratedFDeriv_one]
          exact (hb z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).1
      have hb2 : ∀ z ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1,
          ‖fderiv ℝ (fderiv ℝ (Function.uncurry f)) z‖ ≤ max Cb 0 := fun z hz => by
        rw [← norm_iteratedFDeriv_one, norm_iteratedFDeriv_fderiv]
        exact (hb z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).2
      have hz : ((X, η) : ℝ × ℝ) ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1 := ⟨⟨h1, h2⟩, h5, h6⟩
      have hz' : ((X', η') : ℝ × ℝ) ∈ Icc Xa Xb ×ˢ Ioo (-1:ℝ) 1 := ⟨⟨h3, h4⟩, h7, h8⟩
      have hnorm : ‖((X, η) : ℝ × ℝ) - (X', η')‖ ≤ |X - X'| + |η - η'| := by
        rw [Prod.mk_sub_mk, Prod.norm_def, Real.norm_eq_abs, Real.norm_eq_abs]
        exact max_le (le_add_of_nonneg_right (abs_nonneg _)) (le_add_of_nonneg_left (abs_nonneg _))
      have hC1 : 0 ≤ max Ca 0 := le_max_right _ _
      have hC2 : 0 ≤ max Cb 0 := le_max_right _ _
      refine ⟨?_, ?_, ?_, ?_⟩
      · have := hSc.norm_image_sub_le_of_norm_fderiv_le hd1 hb1 hz' hz
        rw [Real.norm_eq_abs] at this
        exact this.trans (mul_le_mul_of_nonneg_left hnorm hC1)
      · have hF := (hd1 _ hz).hasFDerivAt
        have hc : HasDerivAt (fun Y : ℝ => (id Y, η)) ((1:ℝ), (0:ℝ)) X :=
          (hasDerivAt_id X).prodMk (hasDerivAt_const X η)
        exact (hF.comp_hasDerivAt X hc).deriv
      · calc |fderiv ℝ (Function.uncurry f) (X, η) (1, 0)|
            = ‖fderiv ℝ (Function.uncurry f) (X, η) (1, 0)‖ := (Real.norm_eq_abs _).symm
          _ ≤ ‖fderiv ℝ (Function.uncurry f) (X, η)‖ * ‖((1:ℝ), (0:ℝ))‖ :=
              ContinuousLinearMap.le_opNorm _ _
          _ ≤ max Ca 0 := by rw [e1, mul_one]; exact hb1 _ hz
      · have := hSc.norm_image_sub_le_of_norm_fderiv_le hd2 hb2 hz' hz
        calc |fderiv ℝ (Function.uncurry f) (X, η) (1, 0) -
              fderiv ℝ (Function.uncurry f) (X', η') (1, 0)|
            = ‖(fderiv ℝ (Function.uncurry f) (X, η) -
                fderiv ℝ (Function.uncurry f) (X', η')) (1, 0)‖ := by
              rw [Real.norm_eq_abs, ContinuousLinearMap.sub_apply]
          _ ≤ ‖fderiv ℝ (Function.uncurry f) (X, η) - fderiv ℝ (Function.uncurry f) (X', η')‖ *
                ‖((1:ℝ), (0:ℝ))‖ := ContinuousLinearMap.le_opNorm _ _
          _ ≤ max Cb 0 * (|X - X'| + |η - η'|) := by
              rw [e1, mul_one]; exact this.trans (mul_le_mul_of_nonneg_left hnorm hC2)
    have hbF : ∀ X η : ℝ, Xa ≤ X → X ≤ Xb → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ 1 (Function.uncurry F) (X, η)‖ ≤ max Ca 0 ∧
        ‖iteratedFDeriv ℝ 2 (Function.uncurry F) (X, η)‖ ≤ max Cb 0 := fun X η a b c d =>
      ⟨(hCa X η a b c d).1.trans (le_max_left _ _), (hCb X η a b c d).1.trans (le_max_left _ _)⟩
    have hbU : ∀ X η : ℝ, Xa ≤ X → X ≤ Xb → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ 1 (Function.uncurry U) (X, η)‖ ≤ max Ca 0 ∧
        ‖iteratedFDeriv ℝ 2 (Function.uncurry U) (X, η)‖ ≤ max Cb 0 := fun X η a b c d =>
      ⟨(hCa X η a b c d).2.trans (le_max_left _ _), (hCb X η a b c d).2.trans (le_max_left _ _)⟩

    have quot : ∀ n n' p p' : ℝ, κ ≤ p → κ ≤ p' →
        |n / p - n' / p'| ≤ |n - n'| / κ + |n'| * |p - p'| / κ ^ 2 := by
      intro n n' p p' hp hp'
      have hp0 : 0 < p := lt_of_lt_of_le hκ hp
      have hp0' : 0 < p' := lt_of_lt_of_le hκ hp'
      have e : n / p - n' / p' = (n - n') / p + n' * (p' - p) / (p * p') := by
        field_simp; ring
      rw [e]
      refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
      · rw [abs_div, abs_of_pos hp0]
        exact div_le_div_of_nonneg_left (abs_nonneg _) hκ hp
      · rw [abs_div, abs_mul, abs_of_pos (mul_pos hp0 hp0'), abs_sub_comm p' p]
        exact div_le_div_of_nonneg_left (by positivity) (by positivity) (by nlinarith)
    set C1 := max Ca 0 with hC1def
    set C2 := max Cb 0 with hC2def
    have hC1 : 0 ≤ C1 := le_max_right _ _
    have hC2 : 0 ≤ C2 := le_max_right _ _
    have hXb0 : 0 < Xb := lt_trans hXa hXab
    have hr : 0 < Real.sqrt (2 * Xa) := Real.sqrt_pos.mpr (by linarith)
    set r := Real.sqrt (2 * Xa) with hrdef
    set sb := Real.sqrt (2 * Xb) with hsbdef
    have hsb0 : 0 ≤ sb := Real.sqrt_nonneg _
    refine ⟨C1 + (2 * (C1 + Xb * C2) / κ + 2 * Xb * C1 * C1 / κ ^ 2) +
        ((2 * C1 / r + sb * C2) / κ + sb * C1 * C1 / κ ^ 2), by positivity, ?_⟩
    intro X X' η η' h1 h2 h3 h4 h5 h6 h7 h8
    obtain ⟨F1, F2, F3, F4⟩ := mvt F hFs hbF X X' η η' h1 h2 h3 h4 h5 h6 h7 h8
    obtain ⟨-, F2', F3', -⟩ := mvt F hFs hbF X' X η' η h3 h4 h1 h2 h7 h8 h5 h6
    obtain ⟨-, U2, U3, U4⟩ := mvt U hUs hbU X X' η η' h1 h2 h3 h4 h5 h6 h7 h8
    obtain ⟨-, U2', U3', -⟩ := mvt U hUs hbU X' X η' η h3 h4 h1 h2 h7 h8 h5 h6
    unfold shearA shearB
    rw [F2, F2', U2, U2']
    set δ := |X - X'| + |η - η'| with hδdef
    set φ := fderiv ℝ (Function.uncurry F) (X, η) (1, 0) with hφ
    set φ' := fderiv ℝ (Function.uncurry F) (X', η') (1, 0) with hφ'
    set ψ := fderiv ℝ (Function.uncurry U) (X, η) (1, 0) with hψ
    set ψ' := fderiv ℝ (Function.uncurry U) (X', η') (1, 0) with hψ'
    have hδ0 : 0 ≤ δ := by positivity
    have hXδ : |X - X'| ≤ δ := le_add_of_nonneg_right (abs_nonneg _)
    have hp := hκF X η h1 h2 h5 h6
    have hp' := hκF X' η' h3 h4 h7 h8
    have hX0 : 0 < X := lt_of_lt_of_le hXa h1
    have hX0' : 0 < X' := lt_of_lt_of_le hXa h3
    have hκ2 : 0 < κ ^ 2 := by positivity

    have hA : |-2 * X * φ / F X η - -2 * X' * φ' / F X' η'| ≤
        (2 * (C1 + Xb * C2) / κ + 2 * Xb * C1 * C1 / κ ^ 2) * δ := by
      refine (quot _ _ _ _ hp hp').trans ?_
      have k1 : |(X - X') * φ| ≤ δ * C1 := by
        rw [abs_mul]; exact mul_le_mul hXδ F3 (abs_nonneg _) hδ0
      have k2 : |X' * (φ - φ')| ≤ Xb * (C2 * δ) := by
        rw [abs_mul, abs_of_pos hX0']; exact mul_le_mul h4 F4 (abs_nonneg _) hXb0.le
      have k3 : |-2 * X * φ - -2 * X' * φ'| ≤ 2 * (C1 + Xb * C2) * δ := by
        have e : -2 * X * φ - -2 * X' * φ' = -2 * ((X - X') * φ + X' * (φ - φ')) := by ring
        rw [e, abs_mul, show |(-2:ℝ)| = 2 by norm_num]
        have := abs_add_le ((X - X') * φ) (X' * (φ - φ'))
        linarith
      have k4 : |-2 * X' * φ'| ≤ 2 * Xb * C1 := by
        rw [abs_mul, abs_mul, abs_of_pos hX0', show |(-2:ℝ)| = 2 by norm_num]
        have := mul_le_mul h4 F3' (abs_nonneg _) hXb0.le
        linarith
      have k5 : |F X η - F X' η'| ≤ C1 * δ := F1
      have q1 : |-2 * X * φ - -2 * X' * φ'| / κ ≤ 2 * (C1 + Xb * C2) * δ / κ :=
        div_le_div_of_nonneg_right k3 hκ.le
      have q2 : |-2 * X' * φ'| * |F X η - F X' η'| / κ ^ 2 ≤ 2 * Xb * C1 * (C1 * δ) / κ ^ 2 :=
        div_le_div_of_nonneg_right (mul_le_mul k4 k5 (abs_nonneg _) (by positivity)) hκ2.le
      have e2 : (2 * (C1 + Xb * C2) / κ + 2 * Xb * C1 * C1 / κ ^ 2) * δ =
          2 * (C1 + Xb * C2) * δ / κ + 2 * Xb * C1 * (C1 * δ) / κ ^ 2 := by ring
      linarith

    have hB : |Real.sqrt (2 * X) * ψ / F X η - Real.sqrt (2 * X') * ψ' / F X' η'| ≤
        ((2 * C1 / r + sb * C2) / κ + sb * C1 * C1 / κ ^ 2) * δ := by
      refine (quot _ _ _ _ hp hp').trans ?_
      have hs : r ≤ Real.sqrt (2 * X) := Real.sqrt_le_sqrt (by linarith)
      have hs0' : 0 ≤ Real.sqrt (2 * X') := Real.sqrt_nonneg _
      have hsb' : Real.sqrt (2 * X') ≤ sb := Real.sqrt_le_sqrt (by linarith)
      have hsum : 0 < Real.sqrt (2 * X) + Real.sqrt (2 * X') := by linarith
      have hsd : Real.sqrt (2 * X) - Real.sqrt (2 * X') =
          2 * (X - X') / (Real.sqrt (2 * X) + Real.sqrt (2 * X')) := by
        rw [eq_div_iff hsum.ne']
        linear_combination (Real.sq_sqrt (show (0:ℝ) ≤ 2 * X by linarith)) -
          (Real.sq_sqrt (show (0:ℝ) ≤ 2 * X' by linarith))
      have hsdb : |Real.sqrt (2 * X) - Real.sqrt (2 * X')| ≤ 2 * δ / r := by
        rw [hsd, abs_div, abs_of_pos hsum, abs_mul, abs_two]
        exact div_le_div₀ (by positivity) (by linarith) hr (by linarith)
      have k1 : |(Real.sqrt (2 * X) - Real.sqrt (2 * X')) * ψ| ≤ 2 * δ / r * C1 := by
        rw [abs_mul]; exact mul_le_mul hsdb U3 (abs_nonneg _) (by positivity)
      have k2 : |Real.sqrt (2 * X') * (ψ - ψ')| ≤ sb * (C2 * δ) := by
        rw [abs_mul, abs_of_nonneg hs0']; exact mul_le_mul hsb' U4 (abs_nonneg _) hsb0
      have k3 : |Real.sqrt (2 * X) * ψ - Real.sqrt (2 * X') * ψ'| ≤
          2 * δ / r * C1 + sb * (C2 * δ) := by
        have e : Real.sqrt (2 * X) * ψ - Real.sqrt (2 * X') * ψ' =
            (Real.sqrt (2 * X) - Real.sqrt (2 * X')) * ψ + Real.sqrt (2 * X') * (ψ - ψ') := by ring
        rw [e]
        exact (abs_add_le _ _).trans (add_le_add k1 k2)
      have k4 : |Real.sqrt (2 * X') * ψ'| ≤ sb * C1 := by
        rw [abs_mul, abs_of_nonneg hs0']; exact mul_le_mul hsb' U3' (abs_nonneg _) hsb0
      have k5 : |F X η - F X' η'| ≤ C1 * δ := F1
      have q1 : |Real.sqrt (2 * X) * ψ - Real.sqrt (2 * X') * ψ'| / κ ≤
          (2 * δ / r * C1 + sb * (C2 * δ)) / κ := div_le_div_of_nonneg_right k3 hκ.le
      have q2 : |Real.sqrt (2 * X') * ψ'| * |F X η - F X' η'| / κ ^ 2 ≤
          sb * C1 * (C1 * δ) / κ ^ 2 :=
        div_le_div_of_nonneg_right (mul_le_mul k4 k5 (abs_nonneg _) (by positivity)) hκ2.le
      have e2 : ((2 * C1 / r + sb * C2) / κ + sb * C1 * C1 / κ ^ 2) * δ =
          (2 * δ / r * C1 + sb * (C2 * δ)) / κ + sb * C1 * (C1 * δ) / κ ^ 2 := by ring
      linarith
    have hF1 : |F X η - F X' η'| ≤ C1 * δ := F1
    have e3 : (C1 + (2 * (C1 + Xb * C2) / κ + 2 * Xb * C1 * C1 / κ ^ 2) +
        ((2 * C1 / r + sb * C2) / κ + sb * C1 * C1 / κ ^ 2)) * δ =
        C1 * δ + (2 * (C1 + Xb * C2) / κ + 2 * Xb * C1 * C1 / κ ^ 2) * δ +
        ((2 * C1 / r + sb * C2) / κ + sb * C1 * C1 / κ ^ 2) * δ := by ring
    linarith
  exact core B.F B.U B.Xa B.Xb hXa hXab hFs hUs hbd hκF

theorem frame5_alg_bounds : ∀ (κ D : ℝ), 0 < κ → κ < 2 → κ ≤ D → ∃ (c C : ℝ), 0 < c ∧
    ∀ (s p a b F0 lam : ℝ) (g N : ℝ × ℝ), 1/4 ≤ s → s ≤ 4 → κ ≤ p → p ≤ D → κ ≤ a → a ≤ D →
      |b| ≤ D → (2 + κ) * a ≤ a ^ 2 + b ^ 2 → F0 = s * p → g = F0 • (-a, b) →
      N = (eN g)⁻¹ • g → lam = Real.sqrt (-(2 * F0 * N.1) * (2 * F0 * N.1 + eN g)) →
