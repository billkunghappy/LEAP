theorem pulse_path_jets_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (α : ℝ) (f : WC), InWg5 B G (qsOf l0) α f → ∀ k : ℕ, ∃ C b d : ℝ, 0 ≤ C ∧ ∀ (γ : Lab) (m : ℤ) (ξ : Cyl), l0 ≤ γ.1 → ActiveL4 B G γ → ξ ∈ DomC B.h (qsOf l0) → 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → 0 ≤ vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 → vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 ≤ Lsb B.h G.r0 γ.1 → (∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), pulsePth5 B G γ ξ v ∈ DomC B.h (qsOf l0) ∧ |xiG B.h γ (G.ctr γ) (pulsePth5 B G γ ξ v).2.2.2| < 1/8 ∧ |etG B.h γ (G.ctr γ) (pulsePth5 B G γ ξ v).2.2.2| < 1/8 ∧ vco B.h G.r0 γ (G.ctr γ) (pulsePth5 B G γ ξ v).2.2.2 = v) → ∀ j : ℕ, j ≤ k → ∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), ‖(iteratedFDeriv ℝ j (fun pv : Cyl × ℝ => fun i j' : Fin 3 => pulseAr5 B G γ m (pulsePth5 B G γ pv.1 pv.2) i j') (ξ, v)).compContinuousLinearMap (fun _ => (Lnorm B.h ξ).prodMap (ContinuousLinearMap.id ℝ ℝ))‖ ≤ C * (1 + (m : ℝ) ^ 2) * SC B.h ξ ^ b ∧ ‖(iteratedFDeriv ℝ j (fun pv : Cyl × ℝ => projT5 B G γ (pulsePth5 B G γ pv.1 pv.2) (srcHat B f γ m (pulsePth5 B G γ pv.1 pv.2))) (ξ, v)).compContinuousLinearMap (fun _ => (Lnorm B.h ξ).prodMap (ContinuousLinearMap.id ℝ ℝ))‖ ≤ C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b * Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) * Penv5 B G γ v :=
