theorem pulse5_slow_entries_nb_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ k : ℕ, ∃ D : ℝ, 0 ≤ D ∧ ∀ (γ : Lab) (ξ : Cyl), ActiveL4 B G γ → ξ ∈ DomC B.h B.qB → etaL B.h γ ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), ∀ j : ℕ, j ≤ k → (∀ i : Fin 3, NB B.h (fun η : Cyl => pcN5 B G γ (η.1, η.2.1, η.2.2.1) v i) j ξ ≤ D * SC B.h ξ) ∧ (∀ i : Fin 3, NB B.h (fun η : Cyl => pcPsi5 B G γ (η.1, η.2.1, η.2.2.1) i) j ξ ≤ D * SC B.h ξ) ∧ (∀ i i' : Fin 3, NB B.h (fun η : Cyl => pcKm5 B γ.1 (η.1, η.2.1, η.2.2.1) i i') j ξ ≤ D * SC B.h ξ) :=
by
