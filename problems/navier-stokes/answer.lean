    obtain ⟨A1, -, A3⟩ := profRadAvg_props gh (1 / Λ) (by positivity) hghs
    have hfV : ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => (q.1, q.2 / lam))
        (Ioo (-1 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1 - ρ1 / 2) (1 + ρ1 / 2)) := by
      fun_prop
    have hmV : MapsTo (fun q : ℝ × ℝ => (q.1, q.2 / lam))
        (Ioo (-1 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1 - ρ1 / 2) (1 + ρ1 / 2))
        (Ioi (-(1 / Λ)) ×ˢ Ioo (-1) 1) := by
      intro q hq
      obtain ⟨⟨a, -⟩, ⟨c, d⟩⟩ := hq
      refine ⟨?_, ?_, ?_⟩
      · show -(1 / Λ) < q.1
        rw [← neg_div]; exact a
      · show -1 < q.2 / lam
        rw [lt_div_iff₀ hlam0]; linarith
      · show q.2 / lam < 1
        rw [div_lt_one hlam0]; linarith
    have hc := A1.comp hfV hmV
    have hH : ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => q.1 * profRadAvg gh q.1 (q.2 / lam))
        (Ioo (-1 / Λ) (41 / (10 * Λ)) ×ˢ Ioo (-1 - ρ1 / 2) (1 + ρ1 / 2)) :=
      (contDiffOn_fst.mul hc).congr (fun q _ => rfl)
    refine hH.congr ?_
    intro q hq
    obtain ⟨⟨hX1, hX2⟩, ⟨hη1, hη2⟩⟩ := hq
    have he1 : -1 < q.2 / lam := by rw [lt_div_iff₀ hlam0]; linarith
    have he2 : q.2 / lam < 1 := by rw [div_lt_one hlam0]; linarith
    have hXe : -(1 / Λ) < q.1 := by rw [← neg_div]; exact hX1
    rw [(A3 q.1 (q.2 / lam) hXe he1 he2).1]
    have e : lam * (q.2 / lam) = q.2 := by field_simp
