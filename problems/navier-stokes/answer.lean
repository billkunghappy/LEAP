      ‖deriv f (e : ℂ)‖ ≤ 2 * K / s := by
    intro f s K e hs hf hK h1 h2
    have hR : (0 : ℝ) < s / 2 := by linarith
    have hsub : Metric.closedBall (e : ℂ) (s / 2) ⊆ axRect s := by
      intro w hw
      rw [Metric.mem_closedBall, dist_eq_norm] at hw
      have him := Complex.abs_im_le_norm (w - e)
      have hre' := Complex.abs_re_le_norm (w - e)
