  have haQ0 : 0 ≤ aQ := by
    rw [haQ]; exact mul_nonneg (mul_nonneg hK10 (Real.rpow_nonneg hq0.le _)) (pow_nonneg (by linarith) _)
  have haP0 : 0 ≤ aP := by rw [haP]; exact mul_nonneg hCP0 (Real.rpow_nonneg hσ0 _)
  have haS0 : 0 ≤ aS := by
    rw [haS]
    exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hCS0 (Real.rpow_nonneg hq0.le _))
      (Real.rpow_nonneg hσ0 _)) hζ0) (Real.rpow_nonneg hδ0.le _)
  have haR0 : 0 ≤ aR := by
    rw [haR]
    have hCPc : 0 ≤ CP / c := div_nonneg hCP0 hc.le
    exact mul_nonneg (mul_nonneg hK20 (Real.rpow_nonneg hcz.le _))
      (mul_nonneg (pow_nonneg (by linarith) _)
        (mul_nonneg (pow_nonneg (Real.rpow_nonneg hσ0 _) _) (pow_nonneg (Real.rpow_nonneg hδ0.le _) _)))
  have hX0 : 0 ≤ 4 ^ k * aQ * aP * (aS + aS) * aR :=
    mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by positivity) haQ0) haP0) (add_nonneg haS0 haS0)) haR0
  have hKle : |Qb γ.1 ^ (1 - B.h / 2) / 4| ≤ 2 * qC B.h ξ ^ (1 - B.h / 2) / 4 := by
    have hQb0 : 0 ≤ Qb γ.1 := by unfold Qb; positivity
    have he0 : 0 ≤ 1 - B.h / 2 := by linarith
    have k1 : Qb γ.1 ^ (1 - B.h / 2) ≤ (2 * qC B.h ξ) ^ (1 - B.h / 2) := Real.rpow_le_rpow hQb0 hQ2.le he0
    have k2 : (2 * qC B.h ξ) ^ (1 - B.h / 2) = (2:ℝ) ^ (1 - B.h / 2) * qC B.h ξ ^ (1 - B.h / 2) :=
      Real.mul_rpow (by norm_num) hq0.le
    have k3 : (2:ℝ) ^ (1 - B.h / 2) ≤ 2 := by
      have := Real.rpow_le_rpow_of_exponent_le (by norm_num : (1:ℝ) ≤ 2) (by linarith : 1 - B.h / 2 ≤ 1)
      rwa [Real.rpow_one] at this
    have k4 : (2:ℝ) ^ (1 - B.h / 2) * qC B.h ξ ^ (1 - B.h / 2) ≤ 2 * qC B.h ξ ^ (1 - B.h / 2) :=
      mul_le_mul_of_nonneg_right k3 (Real.rpow_nonneg hq0.le _)
    rw [abs_of_nonneg (div_nonneg (Real.rpow_nonneg hQb0 _) (by norm_num))]
    linarith
  have E1 : qC B.h ξ ^ (1 - B.h / 2) * qC B.h ξ ^ (-1:ℝ) * qC B.h ξ ^ (B.h * α) =
      qC B.h ξ ^ (B.h * (α - 1/2)) := by
    rw [← Real.rpow_add hq0, ← Real.rpow_add hq0]; congr 1; ring
  have E2 : SC B.h ξ ^ bP * SC B.h ξ ^ bS * (SC B.h ξ ^ bP) ^ k = SC B.h ξ ^ (bP + bS + bP * (k:ℝ)) := by
    rw [← Real.rpow_natCast (SC B.h ξ ^ bP) k, ← Real.rpow_mul hσ0, ← Real.rpow_add hσp,
