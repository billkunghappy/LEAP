    congr 2
    field_simp
  have hT4 : Qb γ.1 / qC B.h ξ ≤ 4 := by
    rw [div_le_iff₀ hq0]
    have := (lt_div_iff₀ hQ).1 hq1
    linarith
  have haT : 0 ≤ Qb γ.1 / qC B.h ξ := div_nonneg hQ.le hq0.le
  have hnT : ‖wT‖ ≤ 4 := by
    rw [hwT]
    simp only [Prod.norm_def, norm_zero, max_self, Prod.fst_zero, Prod.snd_zero, Real.norm_eq_abs,
      abs_of_nonneg haT, abs_zero]
    repeat' apply max_le
    all_goals first | exact hT4 | norm_num
  have hTd : ∀ j : ℕ, ∀ F : ℝ × ℝ × ℝ → ℝ, (F = pcFa5 B γ.1 ∨ F = pcB5 B γ.1 2) →
      NB B.h (fun η : Cyl => Qb γ.1 * fderiv ℝ F (η.1, η.2.1, η.2.2.1) ((0:ℝ), (0:ℝ), (1:ℝ))) j ξ ≤
        4 * |C3 (j + 1)| := by
    intro j F hF
    have hFs : ContDiffOn ℝ ∞ F Ω := by
