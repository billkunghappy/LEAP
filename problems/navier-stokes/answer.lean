  have hradD : DifferentiableAt ℝ rad x := by
    have h1 : DifferentiableAt ℝ (fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2) x :=
      ((hcoord 0 x).pow 2).add ((hcoord 1 x).pow 2)
    exact h1.sqrt hradpos.ne'
  have hζd : DifferentiableAt ℝ (fun y : ℝ³ => ptOf y t (Yph B.h (rad y) t + Y0)) x := by
    have h4 : DifferentiableAt ℝ (fun y : ℝ³ => Yph B.h (rad y) t + Y0) x := by
      have h5 := ((hradD.rpow_const (p := drx B.h) (Or.inl hrad.ne')).smul_const vrv).add_const (t • vtv)
      exact h5.add_const Y0
    exact hradD.prodMk ((hcoord 2 x).prodMk ((differentiableAt_const t).prodMk h4))
  obtain ⟨N, hNdef⟩ : ∃ N : Set ℝ³, N = (fun y : ℝ³ => ptOf y t (Yph B.h (rad y) t + Y0)) ⁻¹'
      (DomC B.h (qsOf l0) ∩ U) := ⟨_, rfl⟩
  have hN : N ∈ nhds x := by
    rw [hNdef]
    refine hζd.continuousAt.preimage_mem_nhds ((hDopen.inter hUo).mem_nhds ?_)
    show ptOf x t (Yph B.h (rad x) t + Y0) ∈ _
    rw [hζx]; exact ⟨hξD, hξU⟩
  have hNmem : ∀ y ∈ N, ptOf y t (Yph B.h (rad y) t + Y0) ∈ DomC B.h (qsOf l0) ∧
      ptOf y t (Yph B.h (rad y) t + Y0) ∈ U := by
    intro y hy; rw [hNdef] at hy; exact hy
  have hcd : ∀ γ m, DifferentiableAt ℝ (modeCoef5 B G (VwT5 B G S) γ m)
      (ptOf x t (Yph B.h (rad x) t + Y0)) := by
    intro γ m; rw [hζx]; exact (hmode γ m).1
  have hdd : DifferentiableAt ℝ (dUM5 B dPsi dv) (ptOf x t (Yph B.h (rad x) t + Y0)) := by
    rw [hζx]; exact hdD
  set F : Lab → ℤ → ℝ³ → ℝ³ := fun γ m y => cyl2cart y (fun i =>
    (modeCoef5 B G (VwT5 B G S) γ m (ptOf y t (Yph B.h (rad y) t + Y0)) i *
      Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf y : ℂ))).re) with hF
  have hWloc : ∀ y ∈ N, cyl2cart y (waveV5 B G (VwT5 B G S) (thetaOf y)
      (ptOf y t (Yph B.h (rad y) t + Y0))) = ∑ γ ∈ Γ, ∑ m ∈ H1 ∪ H2, F γ m y := by
    intro y hy
    obtain ⟨hyD, hyU⟩ := hNmem y hy
    have e : waveV5 B G (VwT5 B G S) (thetaOf y) (ptOf y t (Yph B.h (rad y) t + Y0)) =
        fun i => ∑ γ ∈ Γ, ∑ m ∈ H1 ∪ H2,
          (modeCoef5 B G (VwT5 B G S) γ m (ptOf y t (Yph B.h (rad y) t + Y0)) i *
            Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf y : ℂ))).re := by
      funext i
      rw [hfs _ _ _ Γ (H1 ∪ H2) (fun γ m hγ => hWoff γ m _ hyD (hΓU _ hyU γ hγ))
        (fun γ m hm => hHz γ m hm _) i, Complex.re_sum]
      refine Finset.sum_congr rfl (fun γ _ => ?_)
      rw [Complex.re_sum]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      rw [hsplit]
      simp only [modeCoef5]
      congr 1
      ring
    rw [e, hcs]
  have hFd : ∀ γ m, DifferentiableAt ℝ (F γ m) x := fun γ m =>
    (twg5_mode_cross_formula B.h t Y0 (m * pint5 B G γ) (modeCoef5 B G (VwT5 B G S) γ m)
      (dUM5 B dPsi dv) x hrad (hcd γ m) hdd).1
  have hFsum : fderiv ℝ (fun y => ∑ γ ∈ Γ, ∑ m ∈ H1 ∪ H2, F γ m y) x =
      ∑ γ ∈ Γ, ∑ m ∈ H1 ∪ H2, fderiv ℝ (F γ m) x := by
    rw [fderiv_fun_sum (fun γ _ => DifferentiableAt.fun_sum (fun m _ => hFd γ m))]
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    exact fderiv_fun_sum (fun m _ => hFd γ m)
  have hccΓ : ∀ γ m, γ ∉ Γ → crossCoefM5 B G S dPsi dv γ m ξ = 0 := fun γ m hγ =>
    hccz γ m ξ (Filter.eventuallyEq_of_mem ((hDopen.inter hUo).mem_nhds ⟨hξD, hξU⟩)
      (fun η hη => hWoff γ m η hη.1 (hΓU η hη.2 γ hγ)))
  have hccH : ∀ γ m, m ∉ H1 ∪ H2 → crossCoefM5 B G S dPsi dv γ m ξ = 0 := fun γ m hm =>
    hccz γ m ξ (Filter.Eventually.of_forall (fun η => hHz γ m hm η))
  have hRHS : (qC B.h ξ ^ (-(2 * Aex B.h + 1/2))) •
      cyl2cart x (waveV5 B G (crossCoefM5 B G S dPsi dv) (thetaOf x) ξ) =
      ∑ γ ∈ Γ, ∑ m ∈ H1 ∪ H2, (qC B.h ξ ^ (-(2 * Aex B.h + 1/2))) •
        cyl2cart x (fun i => (crossCoefM5 B G S dPsi dv γ m ξ i * ephase5 B G γ m (thetaOf x) ξ).re) := by
    have e : waveV5 B G (crossCoefM5 B G S dPsi dv) (thetaOf x) ξ = fun i => ∑ γ ∈ Γ, ∑ m ∈ H1 ∪ H2,
        (crossCoefM5 B G S dPsi dv γ m ξ i * ephase5 B G γ m (thetaOf x) ξ).re := by
      funext i
      rw [hfs _ _ _ Γ (H1 ∪ H2) hccΓ hccH i]
      simp only [Complex.re_sum]
    rw [e, hcs, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [Finset.smul_sum]

  simp only [crossXm]
  rw [← hY0, ← hξ]
  set Wf : Ext ℝ³ := fun x' t' Y' => cyl2cart x' (waveV5 B G (VwT5 B G S) (thetaOf x') (ptOf x' t' Y'))
    with hWf
  have hWev : (fun y => evOff B.h Wf Y0 y t) =ᶠ[nhds x] fun y => ∑ γ ∈ Γ, ∑ m ∈ H1 ∪ H2, F γ m y :=
    Filter.eventuallyEq_of_mem hN (fun y hy => hWloc y hy)
  have hDev : (fun y => evOff B.h (DXm5 B l0 dPsi dv) Y0 y t) =ᶠ[nhds x]
      fun y => cyl2cart y (dUM5 B dPsi dv (ptOf y t (Yph B.h (rad y) t + Y0))) := by
    refine Filter.eventuallyEq_of_mem hN (fun y hy => ?_)
    have hc : corrOn B l0 y t := (hNmem y hy).1
    show evOff B.h (DXm5 B l0 dPsi dv) Y0 y t = _
    simp only [evOff, DXm5]
    rw [if_pos hc]
  have hW0 : evOff B.h Wf Y0 x t = ∑ γ ∈ Γ, ∑ m ∈ H1 ∪ H2, F γ m x := hWev.eq_of_nhds
  have hD0 : evOff B.h (DXm5 B l0 dPsi dv) Y0 x t =
      cyl2cart x (dUM5 B dPsi dv (ptOf x t (Yph B.h (rad x) t + Y0))) := hDev.eq_of_nhds
  rw [hWev.fderiv_eq, hDev.fderiv_eq, hW0, hD0, hFsum, hRHS]
  simp only [sum_apply, map_sum]
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl (fun γ _ => ?_)
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl (fun m _ => ?_)
  have h4 := (twg5_mode_cross_formula B.h t Y0 (m * pint5 B G γ) (modeCoef5 B G (VwT5 B G S) γ m)
    (dUM5 B dPsi dv) x hrad (hcd γ m) hdd).2.2
  refine Eq.trans h4 ?_
  rw [hζx, (hmode γ m).2, hsm]
  congr 1
  funext i
  simp only [Pi.smul_apply, smul_eq_mul]
  rw [hsplit, ← Complex.re_ofReal_mul]
  congr 1
  ring

theorem twg5_cross_coeff_struct : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (S : CState) (bw ca cm cd : ℝ) (dPsi dv : Cyl → ℝ) (Hx : ℝ), StOrd5 B G l0 S bw ca cm cd → InM B (qsOf l0) Hx dPsi → InM B (qsOf l0) Hx dv → InM B (qsOf l0) Hx (nrm B (Aex B.h) (momDvP B dv)) → InM B (qsOf l0) Hx (nrm B (Aex B.h) (momDgP B dPsi)) → InM B (qsOf l0) (Hx + 1) (nrm B (Aex B.h) (momDbP B dPsi)) → (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → crossCoefM5 B G S dPsi dv γ m = 0) ∧ (∀ γ m, ContDiffOn ℝ ∞ (crossCoefM5 B G S dPsi dv γ m) (DomC B.h (qsOf l0))) ∧ (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), ∀ c, IsDeck B.h (qC B.h ξ) c → crossCoefM5 B G S dPsi dv γ m (shY ξ c) = crossCoefM5 B G S dPsi dv γ m ξ) ∧ (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → crossCoefM5 B G S dPsi dv γ m ξ ≠ 0 → SuppW B G γ ξ) :=
by
  intro B G hok hG
  obtain ⟨lP, hP⟩ := pulse_support_good_v5 B G hok hG
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -⟩ := hok.2.1
  obtain ⟨lB, hB⟩ := band_coarse_gap_v5 B.h hh0 hh1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨lP + lB + n0 + 7, ?_⟩
  intro l0 hl0 S bw ca cm cd dPsi dv Hx hSt _ _ hdw hdg hdb

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  unfold StOrd5 at hSt
  obtain ⟨hAw, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hvW, -⟩ := hSt

  have hT : IsOpen {ξ : Cyl | ξ.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
  have hπq : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
    contDiff_snd.fst.prodMk (contDiff_const.sub contDiff_snd.snd.fst)
  have hqC : ContDiffOn ℝ ∞ (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have h4 := hok.1.2.2.2.1
    exact h4.comp hπq.contDiffOn (fun ξ (hξ : ξ.2.2.1 < 1) =>
      (⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩ : (ξ.2.1, 1 - ξ.2.2.1) ∈ univ ×ˢ Ioi (0:ℝ)))
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have h1 : IsOpen {ξ : Cyl | 0 < ξ.1} := isOpen_lt continuous_const continuous_fst
    have h2 := hqC.continuousOn.isOpen_inter_preimage hT (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Iio (qsOf l0)) := by
      ext ξ; exact Iff.rfl
    rw [e]; exact h1.inter h2
  have hqpos : ∀ ξ : Cyl, ξ.2.2.1 < 1 → 0 < qC B.h ξ := fun ξ hξ =>
    (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hdom : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 :=
    fun ξ hξ => hξ
  have hDT : DomC B.h (qsOf l0) ⊆ {ξ : Cyl | ξ.2.2.1 < 1} := fun ξ hξ => (hdom ξ hξ).2.1
  have ofR : ∀ {f : Cyl → ℝ} {s : Set Cyl}, ContDiffOn ℝ ∞ f s →
      ContDiffOn ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) s := fun hf =>
    (Complex.ofRealCLM.contDiff.comp_contDiffOn hf).congr (fun η _ => by simp)
  have hdRZ : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : Cyl → V) (O : Set Cyl),
      IsOpen O → (∀ η ∈ O, 0 < η.1) → ContDiffOn ℝ ∞ F O →
      ContDiffOn ℝ ∞ (dR B.h F) O ∧ ContDiffOn ℝ ∞ (dZ F) O := by
    intro V _ _ F O hO hpos hF
    have hDf : ContDiffOn ℝ ∞ (fderiv ℝ F) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hF).2
    have hpow : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1 ^ (drx B.h - 1)) O :=
      contDiff_fst.contDiffOn.rpow_const_of_ne (fun ξ hξ => (hpos ξ hξ).ne')
    have hY : ContDiffOn ℝ ∞ (fun ξ : Cyl => (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) O :=
      (contDiffOn_const.mul hpow).smul_const _
    have hvR : ContDiffOn ℝ ∞ (fun ξ : Cyl =>
        ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) O :=
      contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk hY))
    exact ⟨(hDf.clm_apply hvR).congr (fun ξ _ => rfl),
      (hDf.clm_apply contDiffOn_const).congr (fun ξ _ => rfl)⟩

  have hgr : ∀ (g : Cyl → ℝ) (α : ℝ), InM B (qsOf l0) α (nrm B (Aex B.h) g) →
      ContDiffOn ℝ ∞ g (DomC B.h (qsOf l0)) := by
    intro g α hg
    have hqa : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-Aex B.h)) (DomC B.h (qsOf l0)) :=
      (hqC.rpow_const_of_ne (p := -Aex B.h) (fun ξ hξ => (hqpos ξ hξ).ne')).mono hDT
    refine (hqa.mul hg.1).congr (fun η hη => ?_)
    have hq := hqpos η (hDT hη)
    show g η = qC B.h η ^ (-Aex B.h) * (qC B.h η ^ Aex B.h * g η)
    rw [← mul_assoc, ← Real.rpow_add hq, neg_add_cancel, Real.rpow_zero, one_mul]
  have hgd : ∀ (g : Cyl → ℝ) (α : ℝ), InM B (qsOf l0) α (nrm B (Aex B.h) g) →
      ∀ η ∈ DomC B.h (qsOf l0), ∀ c, IsDeck B.h (qC B.h η) c → g (shY η c) = g η := by
    intro g α hg η hη c hc
    have h := hg.2.1 η hη c hc
    have hq := hqpos η (hDT hη)
    have h' : qC B.h η ^ Aex B.h * g (shY η c) = qC B.h η ^ Aex B.h * g η := h
    exact mul_left_cancel₀ (Real.rpow_pos_of_pos hq _).ne' h'
  have hDU : ContDiffOn ℝ ∞ (dUM5 B dPsi dv) (DomC B.h (qsOf l0)) := by
    have e1 := hgr _ _ hdb
    have e2 := hgr _ _ hdw
    have e3 := hgr _ _ hdg
    refine contDiffOn_pi.mpr (fun i => ?_)
    fin_cases i
    · exact e1
    · exact e2
    · exact e3

  have hqh : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-B.h)) {ξ : Cyl | ξ.2.2.1 < 1} :=
    hqC.rpow_const_of_ne (p := -B.h) (fun ξ hξ => (hqpos ξ hξ).ne')
  have hvec : ∀ (γ : Lab) (m : ℤ), ContDiffOn ℝ ∞
      (fun η => (![-(S.Aw γ m η 1), S.Aw γ m η 0, 0] : Fin 3 → ℂ)) (DomC B.h (qsOf l0)) := by
    intro γ m
    have hA := hAw.2.1 γ m
    refine contDiffOn_pi.mpr fun i => ?_
    fin_cases i
    · simpa using (contDiffOn_pi.mp hA 1).neg
    · simpa using (contDiffOn_pi.mp hA 0)
    · simpa using (contDiffOn_const : ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℂ)) (DomC B.h (qsOf l0)))
  have hWs : ∀ (γ : Lab) (m : ℤ), ContDiffOn ℝ ∞ (VwT5 B G S γ m) (DomC B.h (qsOf l0)) := by
    intro γ m
    have h1 : ContDiffOn ℝ ∞ (fun η => ((qC B.h η ^ (-B.h) * Qb γ.1 ^ (-(1/2:ℝ)) : ℝ) : ℂ))
        (DomC B.h (qsOf l0)) := ofR ((hqh.mono hDT).mul contDiffOn_const)
    have h2 : ContDiffOn ℝ ∞ (fun η => ((dZ (fun η => qC B.h η ^ (-B.h)) η : ℝ) : ℂ))
        (DomC B.h (qsOf l0)) :=
      ofR (hdRZ _ _ hDopen (fun η hη => (hdom η hη).1) (hqh.mono hDT)).2
    exact ((h1.smul (hvW.2.1 γ m)).add (h2.smul (hvec γ m))).congr (fun η _ => rfl)

  have hWz : ∀ γ m η, S.Aw γ m η = 0 → velW5 B G S.Aw γ m η = 0 → VwT5 B G S γ m η = 0 := by
    intro γ m η h1 h2
    have h2' : velC5 B G S.Aw γ m η = 0 := h2
    funext i
    fin_cases i <;> simp [VwT5, h1, h2']
  have hLz : ∀ γ m ξ, S.Aw γ m =ᶠ[nhds ξ] 0 → velW5 B G S.Aw γ m =ᶠ[nhds ξ] 0 →
      crossCoefM5 B G S dPsi dv γ m ξ = 0 := by
    intro γ m ξ h1 h2
    have hev : VwT5 B G S γ m =ᶠ[nhds ξ] (fun _ => (0 : Fin 3 → ℂ)) := by
      filter_upwards [h1, h2] with η e1 e2
      exact hWz γ m η e1 e2
    have hW0 : VwT5 B G S γ m ξ = 0 := hev.eq_of_nhds
    have hfd : fderiv ℝ (VwT5 B G S γ m) ξ = 0 := by
      rw [hev.fderiv_eq]; exact fderiv_const_apply _
    have hr : dR B.h (VwT5 B G S γ m) ξ = 0 := by
      unfold dR; rw [hfd, ContinuousLinearMap.zero_apply]
    have hz : dZ (VwT5 B G S γ m) ξ = 0 := by
      unfold dZ; rw [hfd, ContinuousLinearMap.zero_apply]
    funext i
    fin_cases i <;> simp [crossCoefM5, hW0, hr, hz]

  have hgen : ∀ (γ : Lab) (m : ℤ) (O : Set Cyl), IsOpen O → O ⊆ DomC B.h (qsOf l0) →
      (∀ i, ContDiffOn ℝ ∞ (fun η => nPhi5 B G γ η i) O) →
      ContDiffOn ℝ ∞ (crossCoefM5 B G S dPsi dv γ m) O := by
    intro γ m O hO hOD hnO
    have hpos : ∀ η ∈ O, 0 < η.1 := fun η hη => (hdom η (hOD hη)).1
    have hWO := (hWs γ m).mono hOD
    have hDO := hDU.mono hOD
    obtain ⟨hrWO, hzWO⟩ := hdRZ _ O hO hpos hWO
    obtain ⟨hrDO, hzDO⟩ := hdRZ _ O hO hpos hDO
    have hW : ∀ i, ContDiffOn ℝ ∞ (fun η => VwT5 B G S γ m η i) O :=
      fun i => contDiffOn_pi.mp hWO i
    have hrW : ∀ i, ContDiffOn ℝ ∞ (fun η => dR B.h (VwT5 B G S γ m) η i) O :=
      fun i => contDiffOn_pi.mp hrWO i
    have hzW : ∀ i, ContDiffOn ℝ ∞ (fun η => dZ (VwT5 B G S γ m) η i) O :=
      fun i => contDiffOn_pi.mp hzWO i
    have hD : ∀ i, ContDiffOn ℝ ∞ (fun η => ((dUM5 B dPsi dv η i : ℝ) : ℂ)) O :=
      fun i => ofR (contDiffOn_pi.mp hDO i)
    have hrD : ∀ i, ContDiffOn ℝ ∞ (fun η => ((dR B.h (dUM5 B dPsi dv) η i : ℝ) : ℂ)) O :=
      fun i => ofR (contDiffOn_pi.mp hrDO i)
    have hzD : ∀ i, ContDiffOn ℝ ∞ (fun η => ((dZ (dUM5 B dPsi dv) η i : ℝ) : ℂ)) O :=
      fun i => ofR (contDiffOn_pi.mp hzDO i)
    have hn : ∀ i, ContDiffOn ℝ ∞ (fun η => ((nPhi5 B G γ η i : ℝ) : ℂ)) O :=
      fun i => ofR (hnO i)
    have hq : ContDiffOn ℝ ∞ (fun η => ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ)) O :=
      ofR ((hqC.rpow_const_of_ne (p := 2 * Aex B.h + 1/2) (fun ξ hξ => (hqpos ξ hξ).ne')).mono
        (fun η hη => hDT (hOD hη)))
    have hinv : ContDiffOn ℝ ∞ (fun η : Cyl => ((η.1 : ℝ) : ℂ)⁻¹) O := by
      have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => η.1⁻¹) O :=
        contDiff_fst.contDiffOn.inv (fun η hη => (hpos η hη).ne')
      exact (Complex.ofRealCLM.contDiff.comp_contDiffOn h1).congr (fun η _ => by simp)
    have hW0 := hW 0; have hW1 := hW 1; have hW2 := hW 2
    have hrW0 := hrW 0; have hrW1 := hrW 1; have hrW2 := hrW 2
    have hzW0 := hzW 0; have hzW1 := hzW 1; have hzW2 := hzW 2
    have hD0 := hD 0; have hD1 := hD 1; have hD2 := hD 2
    have hrD0 := hrD 0; have hrD1 := hrD 1; have hrD2 := hrD 2
    have hzD0 := hzD 0; have hzD1 := hzD 1; have hzD2 := hzD 2
    have hn0 := hn 0; have hn1 := hn 1; have hn2 := hn 2
    have e0 : ContDiffOn ℝ ∞ (fun η => crossCoefM5 B G S dPsi dv γ m η 0) O := by
      simp only [crossCoefM5, Pi.smul_apply, smul_eq_mul, Complex.ofReal_add, Complex.ofReal_mul,
        div_eq_mul_inv, Matrix.cons_val_zero]
      fun_prop
    have e1 : ContDiffOn ℝ ∞ (fun η => crossCoefM5 B G S dPsi dv γ m η 1) O := by
      simp only [crossCoefM5, Pi.smul_apply, smul_eq_mul, Complex.ofReal_add, Complex.ofReal_mul,
        div_eq_mul_inv, Matrix.cons_val_one, Matrix.cons_val_zero]
      fun_prop
    have e2 : ContDiffOn ℝ ∞ (fun η => crossCoefM5 B G S dPsi dv γ m η 2) O := by
      simp only [crossCoefM5, Pi.smul_apply, smul_eq_mul, Complex.ofReal_add, Complex.ofReal_mul,
        div_eq_mul_inv, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
      fun_prop
    refine contDiffOn_pi.mpr fun i => ?_
    fin_cases i
    · exact e0
    · exact e1
    · exact e2
  obtain ⟨H1, h01, hH1⟩ := hAw.1
  obtain ⟨H2, h02, hH2⟩ := hvW.1
  refine ⟨⟨H1 ∪ H2, ?_, ?_⟩, ?_, ?_, ?_⟩
  ·
    simp only [Finset.mem_union, not_or]
    exact ⟨h01, h02⟩
  ·
    intro γ m hm
    simp only [Finset.mem_union, not_or] at hm
    funext ξ
    show crossCoefM5 B G S dPsi dv γ m ξ = 0
    apply hLz γ m ξ
    · exact Filter.Eventually.of_forall (fun η => by rw [hH1 γ m hm.1])
    · exact Filter.Eventually.of_forall (fun η => by rw [hH2 γ m hm.2])
  ·
    intro γ m
    apply contDiffOn_of_locally_contDiffOn
    intro ξ hξ
    by_cases hsup : ξ ∈ tsupport (S.Aw γ m) ∨ ξ ∈ tsupport (velW5 B G S.Aw γ m)
    · have hgood : |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 ∧ |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 := by
        rcases hsup with h | h
        · have := hP l0 (by omega) 1 S.Aw hAw γ m ξ hξ h
          exact ⟨this.2.2.2.2.2.2.2.1, this.2.2.2.2.2.2.2.2⟩
        · have := hP l0 (by omega) (1/2) (velW5 B G S.Aw) hvW γ m ξ hξ h
          exact ⟨this.2.2.2.2.2.2.2.1, this.2.2.2.2.2.2.2.2⟩
      have hξB : ξ ∈ DomC B.h B.qB :=
        ⟨(hdom ξ hξ).1, (hdom ξ hξ).2.1, lt_of_lt_of_le (hdom ξ hξ).2.2 hqsB⟩
      obtain ⟨U, hUo, hξU, -, hnU, -, -⟩ := good_coeff_smooth_v5 B G γ ξ hok hξB hgood.1 hgood.2
      refine ⟨U, hUo, hξU, ?_⟩
      exact hgen γ m _ (hDopen.inter hUo) inter_subset_left
        (fun i => (hnU i).mono inter_subset_right)
    · obtain ⟨hs1, hs2⟩ := not_or.mp hsup
      refine ⟨(tsupport (S.Aw γ m))ᶜ ∩ (tsupport (velW5 B G S.Aw γ m))ᶜ,
        (isClosed_tsupport _).isOpen_compl.inter (isClosed_tsupport _).isOpen_compl, ⟨hs1, hs2⟩, ?_⟩
      refine (contDiffOn_const (c := (0 : Fin 3 → ℂ))).congr (fun η hη => ?_)
      exact hLz γ m η (notMem_tsupport_iff_eventuallyEq.mp hη.2.1)
        (notMem_tsupport_iff_eventuallyEq.mp hη.2.2)
  ·
    intro γ m ξ hξ c hc
    have hloc : ∀ᶠ η in nhds ξ, η ∈ DomC B.h (qsOf l0) ∧ IsDeck B.h (qC B.h η) c := by
      filter_upwards [hDopen.mem_nhds hξ, deck_locally_stable_v5 B l0 hok (by omega) ξ hξ c hc]
        with η h1 h2
      exact ⟨h1, h2⟩
    obtain ⟨e, he⟩ : ∃ e : Cyl, e = ((0:ℝ), (0:ℝ), (0:ℝ), c) := ⟨_, rfl⟩
    have hsh : ∀ η : Cyl, shY η c = η + e := by
      intro η
      rw [he]
      simp only [shY]
      ext <;> simp
    have htr : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : Cyl → V) (x : Cyl),
        (∀ᶠ η in nhds x, F (shY η c) = F η) →
        F (shY x c) = F x ∧ dR B.h F (shY x c) = dR B.h F x ∧ dZ F (shY x c) = dZ F x := by
      intro V _ _ F x hF
      have hfd : fderiv ℝ F (shY x c) = fderiv ℝ F x := by
        have hev : (fun y => F (y + e)) =ᶠ[nhds x] F := hF.mono (fun η hη => by
          show F (η + e) = F η
          rw [← hsh η, hη])
        rw [hsh x, ← fderiv_comp_add_right]
        exact hev.fderiv_eq
      refine ⟨hF.self_of_nhds, ?_, ?_⟩
      · unfold dR
        rw [hfd]
        try rfl
      · unfold dZ
        rw [hfd]
    have hqsh : ∀ η : Cyl, qC B.h (shY η c) = qC B.h η := fun _ => rfl
    have hWl : ∀ᶠ η in nhds ξ, VwT5 B G S γ m (shY η c) = VwT5 B G S γ m η := by
      filter_upwards [hloc] with η hη
      obtain ⟨hηD, hηc⟩ := hη
      have e1 : S.Aw γ m (shY η c) = S.Aw γ m η := hAw.2.2.1 γ m η hηD c hηc
      have e2 : velC5 B G S.Aw γ m (shY η c) = velC5 B G S.Aw γ m η := hvW.2.2.1 γ m η hηD c hηc
      have e3 : dZ (fun η => qC B.h η ^ (-B.h)) (shY η c) = dZ (fun η => qC B.h η ^ (-B.h)) η :=
        (htr (fun η => qC B.h η ^ (-B.h)) η (Filter.Eventually.of_forall (fun _ => rfl))).2.2
      simp only [VwT5, e1, e2, e3, hqsh]
    have hDl : ∀ᶠ η in nhds ξ, dUM5 B dPsi dv (shY η c) = dUM5 B dPsi dv η := by
      filter_upwards [hloc] with η hη
      obtain ⟨hηD, hηc⟩ := hη
      have e1 := hgd _ _ hdb η hηD c hηc
      have e2 := hgd _ _ hdw η hηD c hηc
      have e3 := hgd _ _ hdg η hηD c hηc
      funext i
      fin_cases i
      · exact e1
      · exact e2
      · exact e3
    obtain ⟨hW1, hW2, hW3⟩ := htr (VwT5 B G S γ m) ξ hWl
    obtain ⟨hD1, hD2, hD3⟩ := htr (dUM5 B dPsi dv) ξ hDl
    have hq' : qC B.h (shY ξ c) = qC B.h ξ := rfl
    have h1' : (shY ξ c).1 = ξ.1 := rfl
    by_cases hz : S.Aw γ m ξ = 0 ∧ velW5 B G S.Aw γ m ξ = 0
    · have hW0 : VwT5 B G S γ m ξ = 0 := hWz γ m ξ hz.1 hz.2
      funext i
      fin_cases i <;> simp [crossCoefM5, hW1, hW2, hW3, hD1, hD2, hD3, hq', h1', hW0]
    · have hts : ξ ∈ tsupport (S.Aw γ m) ∨ ξ ∈ tsupport (velW5 B G S.Aw γ m) := by
        by_cases h1 : S.Aw γ m ξ = 0
        · exact Or.inr (subset_tsupport _ (fun h2 => hz ⟨h1, h2⟩))
        · exact Or.inl (subset_tsupport _ h1)
      have hband : 1/4 < qC B.h ξ / Qb γ.1 ∧ qC B.h ξ / Qb γ.1 < 4 := by
        rcases hts with h | h
        · have := hP l0 (by omega) 1 S.Aw hAw γ m ξ hξ h
          exact ⟨this.2.2.2.1, this.2.2.2.2.1⟩
        · have := hP l0 (by omega) (1/2) (velW5 B G S.Aw) hvW γ m ξ hξ h
          exact ⟨this.2.2.2.1, this.2.2.2.2.1⟩
      have hcb := (hB γ.1 l0 (qC B.h ξ) (by omega) (hqpos ξ (hdom ξ hξ).2.1) (hdom ξ hξ).2.2
        hband.1 hband.2).1
      have hn : nPhi5 B G γ (shY ξ c) = nPhi5 B G γ ξ := nPhi5_deck_v5 B G γ _ c hcb hc ξ
      simp only [crossCoefM5, hW1, hW2, hW3, hD1, hD2, hD3, hq', h1', hn]
  ·
    intro γ m ξ hξ hne
    by_contra hS
    apply hne
    by_cases h1 : ξ ∈ tsupport (S.Aw γ m)
    · exact absurd (hP l0 (by omega) 1 S.Aw hAw γ m ξ hξ h1).1 hS
    by_cases h2 : ξ ∈ tsupport (velW5 B G S.Aw γ m)
    · exact absurd (hP l0 (by omega) (1/2) (velW5 B G S.Aw) hvW γ m ξ hξ h2).1 hS
    exact hLz γ m ξ (notMem_tsupport_iff_eventuallyEq.mp h1) (notMem_tsupport_iff_eventuallyEq.mp h2)

theorem cub5_algebra : ∀ (B : BG) (P : Lab → ℤ → Cyl → Prop) (k : ℕ),
    (∀ γ m ξ, P γ m ξ → 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1) →
    (∀ (f g : Lab → ℤ → Cyl → ℂ) (e1 e2 : ℝ) (w1 w2 : Lab → Cyl → ℝ), CUB5 B P k f e1 w1 → CUB5 B P k g e2 w2 →
      CUB5 B P k (cxMul5 f g) (e1 + e2) (fun γ ξ => w1 γ ξ * w2 γ ξ)) ∧
    (∀ (f g : Lab → ℤ → Cyl → ℂ) (e : ℝ) (w : Lab → Cyl → ℝ), CUB5 B P k f e w → CUB5 B P k g e w →
      CUB5 B P k (cxAdd5 f g) e w ∧ CUB5 B P k (cxSub5 f g) e w) ∧
    (∀ (c : ℂ) (f : Lab → ℤ → Cyl → ℂ) (e : ℝ) (w : Lab → Cyl → ℝ), CUB5 B P k f e w →
      CUB5 B P k (cxSmul5 c f) e w) ∧
    (∀ (f : Lab → ℤ → Cyl → ℂ) (e e' : ℝ) (w w' : Lab → Cyl → ℝ), CUB5 B P k f e w → e' ≤ e →
      (∀ γ m ξ, P γ m ξ → w γ ξ ≤ w' γ ξ) → CUB5 B P k f e' w') ∧
    (∀ (h : ℝ) (F : Cyl → (Fin 3 → ℂ)) (ξ : Cyl) (j : ℕ), (∀ i, ContDiffAt ℝ ∞ (fun η => F η i) ξ) →
      NB h F j ξ ≤ ∑ i : Fin 3, NB h (fun η => F η i) j ξ) :=
by
  intro B P k hPq

  have leib : ∀ (h : ℝ) (ξ : Cyl) (U : Set Cyl) (n : ℕ),
      IsOpen U → ξ ∈ U → ∀ (f g : Cyl → ℂ), ContDiffOn ℝ n f U → ContDiffOn ℝ n g U →
      NB h (fun η => f η * g η) n ξ ≤
        ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * NB h f i ξ * NB h g (n - i) ξ := by
    intro h ξ U n hU hξ f g hf hg
    unfold NB
    generalize Lnorm h ξ = L
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
    have hsm : ∀ (F : Cyl → ℂ),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + z)) s := by
      intro F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ (F : Cyl → ℂ),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
      intro F hF
      exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
    have key : ∀ (F : Cyl → ℂ),
        ContDiffOn ℝ n F U → ∀ i : ℕ, i ≤ n →
        iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
          (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
      intro F hF i hi
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
      calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
              (fun _ => L) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
              (fun _ => L) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
              (fun _ => L) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
    have hfg : ContDiffOn ℝ n (fun η => f η * g η) U := hf.mul hg
    have hl := norm_iteratedFDerivWithin_mul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
      (n := n) le_rfl
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) * g (ξ + L y)) n hO h0O] at hl
    rw [← key _ hfg n le_rfl]
    calc ‖iteratedFDeriv ℝ n (fun z => (fun η => f η * g η) (ξ + L z)) 0‖
        = ‖iteratedFDeriv ℝ n (fun y => f (ξ + L y) * g (ξ + L y)) 0‖ := rfl
      _ ≤ _ := hl
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (n - i) hO h0O,
          key f hf i hik, key g hg (n - i) (Nat.sub_le n i)]

  have R1 : ∀ (f g : Lab → ℤ → Cyl → ℂ) (e1 e2 : ℝ) (w1 w2 : Lab → Cyl → ℝ),
      CUB5 B P k f e1 w1 → CUB5 B P k g e2 w2 →
      CUB5 B P k (cxMul5 f g) (e1 + e2) (fun γ ξ => w1 γ ξ * w2 γ ξ) := by
    intro f g e1 e2 w1 w2 hF hG
    obtain ⟨c1, hc1, H1⟩ := hF
    obtain ⟨c2, hc2, H2⟩ := hG
    refine ⟨2 ^ k * c1 * c2, by positivity, fun γ m ξ hP => ?_⟩
    obtain ⟨hq0, hq1⟩ := hPq γ m ξ hP
    obtain ⟨hw1, ⟨U1, hU1o, hU1ξ, hU1s⟩, B1⟩ := H1 γ m ξ hP
    obtain ⟨hw2, ⟨U2, hU2o, hU2ξ, hU2s⟩, B2⟩ := H2 γ m ξ hP
    have hUo : IsOpen (U1 ∩ U2) := hU1o.inter hU2o
    have hUξ : ξ ∈ U1 ∩ U2 := ⟨hU1ξ, hU2ξ⟩
    have hfs : ContDiffOn ℝ ∞ (f γ m) (U1 ∩ U2) := hU1s.mono Set.inter_subset_left
    have hgs : ContDiffOn ℝ ∞ (g γ m) (U1 ∩ U2) := hU2s.mono Set.inter_subset_right
    refine ⟨mul_nonneg hw1 hw2, ⟨U1 ∩ U2, hUo, hUξ, hfs.mul hgs⟩, fun j hj => ?_⟩
    obtain ⟨A, hA⟩ : ∃ A : ℝ, A = c1 * qC B.h ξ ^ e1 * w1 γ ξ := ⟨_, rfl⟩
    obtain ⟨E, hE⟩ : ∃ E : ℝ, E = c2 * qC B.h ξ ^ e2 * w2 γ ξ := ⟨_, rfl⟩
    have hA0 : 0 ≤ A := by rw [hA]; exact mul_nonneg (mul_nonneg hc1 (Real.rpow_nonneg hq0.le _)) hw1
    have hE0 : 0 ≤ E := by rw [hE]; exact mul_nonneg (mul_nonneg hc2 (Real.rpow_nonneg hq0.le _)) hw2
    have l := leib B.h ξ (U1 ∩ U2) j hUo hUξ (f γ m) (g γ m)
      (hfs.of_le (by exact_mod_cast le_top)) (hgs.of_le (by exact_mod_cast le_top))
    have hsum : ∑ i ∈ Finset.range (j + 1),
        (j.choose i : ℝ) * NB B.h (f γ m) i ξ * NB B.h (g γ m) (j - i) ξ ≤
        ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * A * E := by
      apply Finset.sum_le_sum
      intro i hi
      have hij : i ≤ j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have b1 : NB B.h (f γ m) i ξ ≤ A := by rw [hA]; exact B1 i (hij.trans hj)
      have b2 : NB B.h (g γ m) (j - i) ξ ≤ E := by rw [hE]; exact B2 (j - i) ((Nat.sub_le j i).trans hj)
      have n2 : 0 ≤ NB B.h (g γ m) (j - i) ξ := norm_nonneg _
      have hc : (0:ℝ) ≤ (j.choose i : ℝ) := Nat.cast_nonneg _
      rw [mul_assoc, mul_assoc]
      exact mul_le_mul_of_nonneg_left (mul_le_mul b1 b2 n2 hA0) hc
    have hch : (∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ)) = 2 ^ j := by
      exact_mod_cast Nat.sum_range_choose j
    have hsum2 : ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * A * E = 2 ^ j * A * E := by
      rw [← Finset.sum_mul, ← Finset.sum_mul, hch]
    have h2 : (2:ℝ) ^ j ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hj
    have hAE : 0 ≤ A * E := mul_nonneg hA0 hE0
    have hrp : qC B.h ξ ^ (e1 + e2) = qC B.h ξ ^ e1 * qC B.h ξ ^ e2 := Real.rpow_add hq0 e1 e2
    show NB B.h (fun η => f γ m η * g γ m η) j ξ ≤
      2 ^ k * c1 * c2 * qC B.h ξ ^ (e1 + e2) * (w1 γ ξ * w2 γ ξ)
    rw [hrp]
    calc NB B.h (fun η => f γ m η * g γ m η) j ξ ≤ 2 ^ j * A * E := l.trans (hsum.trans hsum2.le)
      _ = 2 ^ j * (A * E) := by ring
      _ ≤ 2 ^ k * (A * E) := mul_le_mul_of_nonneg_right h2 hAE
      _ = _ := by rw [hA, hE]; ring

  have R2 : ∀ (f g : Lab → ℤ → Cyl → ℂ) (e : ℝ) (w : Lab → Cyl → ℝ), CUB5 B P k f e w → CUB5 B P k g e w →
      CUB5 B P k (cxAdd5 f g) e w ∧ CUB5 B P k (cxSub5 f g) e w := by
    intro f g e w hF hG
    obtain ⟨c1, hc1, H1⟩ := hF
    obtain ⟨c2, hc2, H2⟩ := hG
    have lin : ∀ (γ : Lab) (m : ℤ) (ξ : Cyl) (j : ℕ) (U : Set Cyl), IsOpen U → ξ ∈ U →
        ContDiffOn ℝ ∞ (f γ m) U → ContDiffOn ℝ ∞ (g γ m) U →
        NB B.h (fun η => f γ m η + g γ m η) j ξ ≤ NB B.h (f γ m) j ξ + NB B.h (g γ m) j ξ ∧
        NB B.h (fun η => f γ m η - g γ m η) j ξ ≤ NB B.h (f γ m) j ξ + NB B.h (g γ m) j ξ := by
      intro γ m ξ j U hU hξ hf hg
      have hfa : ContDiffAt ℝ j (f γ m) ξ :=
        (hf.of_le (by exact_mod_cast le_top)).contDiffAt (hU.mem_nhds hξ)
      have hga : ContDiffAt ℝ j (g γ m) ξ :=
        (hg.of_le (by exact_mod_cast le_top)).contDiffAt (hU.mem_nhds hξ)
      unfold NB
      constructor
      · have e0 : iteratedFDeriv ℝ j (fun η => f γ m η + g γ m η) ξ =
            iteratedFDeriv ℝ j (f γ m) ξ + iteratedFDeriv ℝ j (g γ m) ξ :=
          iteratedFDeriv_add_apply hfa hga
        rw [e0]
        have e2 : (iteratedFDeriv ℝ j (f γ m) ξ + iteratedFDeriv ℝ j (g γ m) ξ).compContinuousLinearMap
            (fun _ => Lnorm B.h ξ) =
            (iteratedFDeriv ℝ j (f γ m) ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) +
            (iteratedFDeriv ℝ j (g γ m) ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
          ext v; simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
        rw [e2]; exact norm_add_le _ _
      · have e0 : iteratedFDeriv ℝ j (fun η => f γ m η - g γ m η) ξ =
            iteratedFDeriv ℝ j (f γ m) ξ - iteratedFDeriv ℝ j (g γ m) ξ :=
          iteratedFDeriv_sub_apply hfa hga
        rw [e0]
        have e2 : (iteratedFDeriv ℝ j (f γ m) ξ - iteratedFDeriv ℝ j (g γ m) ξ).compContinuousLinearMap
            (fun _ => Lnorm B.h ξ) =
            (iteratedFDeriv ℝ j (f γ m) ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) -
            (iteratedFDeriv ℝ j (g γ m) ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
          ext v; simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
        rw [e2]; exact norm_sub_le _ _
    refine ⟨⟨c1 + c2, by linarith, fun γ m ξ hP => ?_⟩, ⟨c1 + c2, by linarith, fun γ m ξ hP => ?_⟩⟩
    · obtain ⟨hw1, ⟨U1, hU1o, hU1ξ, hU1s⟩, B1⟩ := H1 γ m ξ hP
      obtain ⟨_, ⟨U2, hU2o, hU2ξ, hU2s⟩, B2⟩ := H2 γ m ξ hP
      have hUo : IsOpen (U1 ∩ U2) := hU1o.inter hU2o
      have hUξ : ξ ∈ U1 ∩ U2 := ⟨hU1ξ, hU2ξ⟩
      have hfs : ContDiffOn ℝ ∞ (f γ m) (U1 ∩ U2) := hU1s.mono Set.inter_subset_left
      have hgs : ContDiffOn ℝ ∞ (g γ m) (U1 ∩ U2) := hU2s.mono Set.inter_subset_right
      refine ⟨hw1, ⟨U1 ∩ U2, hUo, hUξ, hfs.add hgs⟩, fun j hj => ?_⟩
      have hl := (lin γ m ξ j _ hUo hUξ hfs hgs).1
      have b1 := B1 j hj
      have b2 := B2 j hj
      show NB B.h (fun η => f γ m η + g γ m η) j ξ ≤ (c1 + c2) * qC B.h ξ ^ e * w γ ξ
      calc NB B.h (fun η => f γ m η + g γ m η) j ξ ≤ NB B.h (f γ m) j ξ + NB B.h (g γ m) j ξ := hl
        _ ≤ c1 * qC B.h ξ ^ e * w γ ξ + c2 * qC B.h ξ ^ e * w γ ξ := add_le_add b1 b2
        _ = (c1 + c2) * qC B.h ξ ^ e * w γ ξ := by ring
    · obtain ⟨hw1, ⟨U1, hU1o, hU1ξ, hU1s⟩, B1⟩ := H1 γ m ξ hP
      obtain ⟨_, ⟨U2, hU2o, hU2ξ, hU2s⟩, B2⟩ := H2 γ m ξ hP
      have hUo : IsOpen (U1 ∩ U2) := hU1o.inter hU2o
      have hUξ : ξ ∈ U1 ∩ U2 := ⟨hU1ξ, hU2ξ⟩
      have hfs : ContDiffOn ℝ ∞ (f γ m) (U1 ∩ U2) := hU1s.mono Set.inter_subset_left
      have hgs : ContDiffOn ℝ ∞ (g γ m) (U1 ∩ U2) := hU2s.mono Set.inter_subset_right
      refine ⟨hw1, ⟨U1 ∩ U2, hUo, hUξ, hfs.sub hgs⟩, fun j hj => ?_⟩
      have hl := (lin γ m ξ j _ hUo hUξ hfs hgs).2
      have b1 := B1 j hj
      have b2 := B2 j hj
      show NB B.h (fun η => f γ m η - g γ m η) j ξ ≤ (c1 + c2) * qC B.h ξ ^ e * w γ ξ
      calc NB B.h (fun η => f γ m η - g γ m η) j ξ ≤ NB B.h (f γ m) j ξ + NB B.h (g γ m) j ξ := hl
        _ ≤ c1 * qC B.h ξ ^ e * w γ ξ + c2 * qC B.h ξ ^ e * w γ ξ := add_le_add b1 b2
        _ = (c1 + c2) * qC B.h ξ ^ e * w γ ξ := by ring

  have R3 : ∀ (c : ℂ) (f : Lab → ℤ → Cyl → ℂ) (e : ℝ) (w : Lab → Cyl → ℝ), CUB5 B P k f e w →
      CUB5 B P k (cxSmul5 c f) e w := by
    intro c f e w hF
    obtain ⟨c1, hc1, H1⟩ := hF
    refine ⟨‖c‖ * c1, mul_nonneg (norm_nonneg _) hc1, fun γ m ξ hP => ?_⟩
    obtain ⟨hw, ⟨U, hUo, hUξ, hUs⟩, B1⟩ := H1 γ m ξ hP
    refine ⟨hw, ⟨U, hUo, hUξ, contDiffOn_const.mul hUs⟩, fun j hj => ?_⟩
    have hfa : ContDiffAt ℝ j (f γ m) ξ :=
      (hUs.of_le (by exact_mod_cast le_top)).contDiffAt (hUo.mem_nhds hUξ)
    have e0 : iteratedFDeriv ℝ j (cxSmul5 c f γ m) ξ = c • iteratedFDeriv ℝ j (f γ m) ξ := by
      have := iteratedFDeriv_const_smul_apply (a := c) hfa
      exact this
    unfold NB
    rw [e0]
    have e2 : (c • iteratedFDeriv ℝ j (f γ m) ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
        c • (iteratedFDeriv ℝ j (f γ m) ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
      ext v; simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    have b1 := B1 j hj
    unfold NB at b1
    calc ‖c • (iteratedFDeriv ℝ j (f γ m) ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖
        ≤ ‖c‖ * ‖(iteratedFDeriv ℝ j (f γ m) ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ := by
          apply ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg (norm_nonneg _) (norm_nonneg _))
          intro v
          rw [ContinuousMultilinearMap.smul_apply, norm_smul, mul_assoc]
          exact mul_le_mul_of_nonneg_left (ContinuousMultilinearMap.le_opNorm _ v) (norm_nonneg _)
      _ ≤ ‖c‖ * (c1 * qC B.h ξ ^ e * w γ ξ) := mul_le_mul_of_nonneg_left b1 (norm_nonneg _)
      _ = ‖c‖ * c1 * qC B.h ξ ^ e * w γ ξ := by ring

  have R4 : ∀ (f : Lab → ℤ → Cyl → ℂ) (e e' : ℝ) (w w' : Lab → Cyl → ℝ), CUB5 B P k f e w → e' ≤ e →
      (∀ γ m ξ, P γ m ξ → w γ ξ ≤ w' γ ξ) → CUB5 B P k f e' w' := by
    intro f e e' w w' hF hee hww
    obtain ⟨c, hc, H⟩ := hF
    refine ⟨c, hc, fun γ m ξ hP => ?_⟩
    obtain ⟨hq0, hq1⟩ := hPq γ m ξ hP
    obtain ⟨hw, hU, Bd⟩ := H γ m ξ hP
    refine ⟨hw.trans (hww γ m ξ hP), hU, fun j hj => ?_⟩
    have h1 : qC B.h ξ ^ e ≤ qC B.h ξ ^ e' := Real.rpow_le_rpow_of_exponent_ge hq0 hq1 hee
    calc NB B.h (f γ m) j ξ ≤ c * qC B.h ξ ^ e * w γ ξ := Bd j hj
      _ ≤ c * qC B.h ξ ^ e' * w γ ξ :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left h1 hc) hw
      _ ≤ c * qC B.h ξ ^ e' * w' γ ξ :=
          mul_le_mul_of_nonneg_left (hww γ m ξ hP) (mul_nonneg hc (Real.rpow_nonneg hq0.le _))

  have R5 : ∀ (h : ℝ) (F : Cyl → (Fin 3 → ℂ)) (ξ : Cyl) (j : ℕ), (∀ i, ContDiffAt ℝ ∞ (fun η => F η i) ξ) →
      NB h F j ξ ≤ ∑ i : Fin 3, NB h (fun η => F η i) j ξ := by
    intro h F ξ j hF
    have hFa : ContDiffAt ℝ ∞ F ξ := contDiffAt_pi.mpr hF
    have comp : ∀ i : Fin 3, iteratedFDeriv ℝ j (fun η => F η i) ξ =
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i).compContinuousMultilinearMap
          (iteratedFDeriv ℝ j F ξ) := by
      intro i
      exact ContinuousLinearMap.iteratedFDeriv_comp_left
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i) hFa (i := j)
        (by exact_mod_cast le_top)
    unfold NB
    have hT : 0 ≤ ∑ i : Fin 3,
        ‖(iteratedFDeriv ℝ j (fun η => F η i) ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ :=
      Finset.sum_nonneg (fun i _ => norm_nonneg _)
    apply ContinuousMultilinearMap.opNorm_le_bound hT
    intro v
    have hp : 0 ≤ ∏ t, ‖v t‖ := Finset.prod_nonneg (fun t _ => norm_nonneg _)
    rw [pi_norm_le_iff_of_nonneg (mul_nonneg hT hp)]
    intro i
    have e1 : ((iteratedFDeriv ℝ j F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)) v i =
        ((iteratedFDeriv ℝ j (fun η => F η i) ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)) v := by
      rw [comp i]
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e1]
    calc ‖((iteratedFDeriv ℝ j (fun η => F η i) ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)) v‖
        ≤ ‖(iteratedFDeriv ℝ j (fun η => F η i) ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ *
            ∏ t, ‖v t‖ := ContinuousMultilinearMap.le_opNorm _ _
      _ ≤ (∑ i : Fin 3,
            ‖(iteratedFDeriv ℝ j (fun η => F η i) ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖) *
            ∏ t, ‖v t‖ :=
          mul_le_mul_of_nonneg_right
            (Finset.single_le_sum
              (f := fun i => ‖(iteratedFDeriv ℝ j (fun η => F η i) ξ).compContinuousLinearMap
                (fun _ => Lnorm h ξ)‖)
              (fun i _ => norm_nonneg _) (Finset.mem_univ i)) hp
  exact ⟨R1, R2, R3, R4, R5⟩

theorem twg5_D_cub : ∀ (B : BG), B.ok → SimNorm B.h → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (S : CState) (dPsi dv : Cyl → ℝ) (Hx : ℝ),
    InM B (qsOf l0) Hx (nrm B (Aex B.h) (momDvP B dv)) → InM B (qsOf l0) Hx (nrm B (Aex B.h) (momDgP B dPsi)) →
    InM B (qsOf l0) (Hx + 1) (nrm B (Aex B.h) (momDbP B dPsi)) → ∀ k : ℕ, ∃ b d : ℝ, ∀ i : Fin 3,
      CUB5 B (goodX5 B l0 S) k (fun _ _ η => ((dUM5 B dPsi dv η i : ℝ) : ℂ)) (-Aex B.h + B.h * Hx) (wtD5 B b d) ∧
      CUB5 B (goodX5 B l0 S) k (fun _ _ η => ((dR B.h (dUM5 B dPsi dv) η i : ℝ) : ℂ))
        (-Aex B.h + B.h * Hx - 1/2 - B.h * kapS) (wtD5 B b d) ∧
      CUB5 B (goodX5 B l0 S) k (fun _ _ η => ((dZ (dUM5 B dPsi dv) η i : ℝ) : ℂ))
        (-Aex B.h + B.h * Hx - 1/2 + B.h) (wtD5 B b d) :=
by
  intro B hok hSN
  refine ⟨0, ?_⟩
  intro l0 _ S dPsi dv Hx hw hg hb k
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hqs0 : 0 < qsOf l0 := by unfold qsOf Qb; positivity
  have hqs1 : qsOf l0 ≤ 1 := by
    unfold qsOf Qb
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  obtain ⟨hUo, hqC, hqpos, -, hcalc, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hb' : InM B (qsOf l0) Hx (nrm B (Aex B.h) (momDbP B dPsi)) :=
    (mom_class_algebra_v4 B (qsOf l0) hok hqs0 hqs1).1 (Hx + 1) (Hx + 1) Hx 1 0 _ _ _ hb hb
      (by linarith) (by linarith) (fun ξ _ => by ring)

  have hdom : ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 ∧ 1 ≤ SC B.h ξ ∧ 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) ∧
      0 < edgeDist B.Xa B.Xb (XC B.h ξ) ∧ edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := by
    intro ξ hξ hX1 hX2
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    refine ⟨hqpos ξ hξ, by linarith [hξ'.2.2], ?_, ?_, ?_, min_le_left _ _⟩
    · unfold SC
      exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h ξ))])
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · have hX : 0 < XC B.h ξ := lt_trans hXa hX1
      unfold edgeDist
      exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
        (Real.log_pos ((one_lt_div hX).mpr hX2)))

  have unnorm : ∀ (g : Cyl → ℝ), InM B (qsOf l0) Hx (nrm B (Aex B.h) g) →
      ∃ C b d : ℝ, 0 ≤ C ∧ ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        ∀ j : ℕ, j ≤ k + 1 → NB B.h g j ξ ≤ C * qC B.h ξ ^ (-Aex B.h + B.h * Hx) *
          (SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d)) := by
    intro g hF
    have hFs : ContDiffOn ℝ ∞ (nrm B (Aex B.h) g) (DomC B.h (qsOf l0)) := hF.1
    have hps : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-Aex B.h)) (DomC B.h (qsOf l0)) :=
      hqC.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
    choose Cf bf df hCf using hF.2.2.2
    choose Kq hKq using nb_qpow_v4 B (qsOf l0) (-Aex B.h) hok hSN hqs0 hqs1
    obtain ⟨Cs, hCs⟩ : ∃ Cs : ℝ, Cs = ∑ j ∈ Finset.range (k + 2), |Cf j| := ⟨_, rfl⟩
    obtain ⟨bs, hbs⟩ : ∃ bs : ℝ, bs = ∑ j ∈ Finset.range (k + 2), |bf j| := ⟨_, rfl⟩
    obtain ⟨ds, hds⟩ : ∃ ds : ℝ, ds = ∑ j ∈ Finset.range (k + 2), |df j| := ⟨_, rfl⟩
    obtain ⟨Ks, hKs⟩ : ∃ Ks : ℝ, Ks = ∑ j ∈ Finset.range (k + 2), |Kq j| := ⟨_, rfl⟩
    have hCs0 : 0 ≤ Cs := by rw [hCs]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
    have hKs0 : 0 ≤ Ks := by rw [hKs]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
    have mem : ∀ j, j ≤ k + 1 → j ∈ Finset.range (k + 2) :=
      fun j hj => Finset.mem_range.mpr (Nat.lt_succ_of_le hj)
    have hCj : ∀ j, j ≤ k + 1 → Cf j ≤ Cs := fun j hj => (le_abs_self _).trans (by
      rw [hCs]; exact Finset.single_le_sum (f := fun j => |Cf j|) (fun j _ => abs_nonneg _) (mem j hj))
    have hbj : ∀ j, j ≤ k + 1 → bf j ≤ bs := fun j hj => (le_abs_self _).trans (by
      rw [hbs]; exact Finset.single_le_sum (f := fun j => |bf j|) (fun j _ => abs_nonneg _) (mem j hj))
    have hdj : ∀ j, j ≤ k + 1 → df j ≤ ds := fun j hj => (le_abs_self _).trans (by
      rw [hds]; exact Finset.single_le_sum (f := fun j => |df j|) (fun j _ => abs_nonneg _) (mem j hj))
    have hKj : ∀ j, j ≤ k + 1 → Kq j ≤ Ks := fun j hj => (le_abs_self _).trans (by
      rw [hKs]; exact Finset.single_le_sum (f := fun j => |Kq j|) (fun j _ => abs_nonneg _) (mem j hj))
    refine ⟨2 ^ (k + 1) * Ks * Cs, bs, ds, mul_nonneg (mul_nonneg (by positivity) hKs0) hCs0,
      fun ξ hξ hX1 hX2 j hj => ?_⟩
    obtain ⟨hq, -, hS1, hE, hδ0, hδ1⟩ := hdom ξ hξ hX1 hX2
    have hqa : 0 ≤ qC B.h ξ ^ (B.h * Hx) := Real.rpow_nonneg hq.le _
    have hqA : 0 ≤ qC B.h ξ ^ (-Aex B.h) := Real.rpow_nonneg hq.le _
    obtain ⟨wv, hwv⟩ : ∃ wv : ℝ, wv = SC B.h ξ ^ bs * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-ds) := ⟨_, rfl⟩
    have p3 : 0 ≤ SC B.h ξ ^ bs := Real.rpow_nonneg (by linarith) _
    have hwv0 : 0 ≤ wv := by
      rw [hwv]; exact mul_nonneg (mul_nonneg p3 hE) (Real.rpow_nonneg hδ0.le _)
    have hFb : ∀ m, m ≤ k + 1 → NB B.h (nrm B (Aex B.h) g) m ξ ≤ Cs * (qC B.h ξ ^ (B.h * Hx) * wv) := by
      intro m hm
      have h1 := hCf m ξ hξ hX1 hX2
      have hbm : SC B.h ξ ^ (bf m) ≤ SC B.h ξ ^ bs := Real.rpow_le_rpow_of_exponent_le hS1 (hbj m hm)
      have hdm : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df m) ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-ds) :=
        Real.rpow_le_rpow_of_exponent_ge hδ0 hδ1 (neg_le_neg (hdj m hm))
      have p1 : 0 ≤ SC B.h ξ ^ (bf m) := Real.rpow_nonneg (by linarith) _
      have p2 : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df m) := Real.rpow_nonneg hδ0.le _
      calc NB B.h (nrm B (Aex B.h) g) m ξ
          ≤ Cf m * qC B.h ξ ^ (B.h * Hx) * SC B.h ξ ^ (bf m) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
              edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df m) := h1
        _ = Cf m * (qC B.h ξ ^ (B.h * Hx) * (SC B.h ξ ^ (bf m) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
              edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df m))) := by ring
        _ ≤ Cs * (qC B.h ξ ^ (B.h * Hx) * (SC B.h ξ ^ (bf m) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
              edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-df m))) :=
            mul_le_mul_of_nonneg_right (hCj m hm) (mul_nonneg hqa (mul_nonneg (mul_nonneg p1 hE) p2))
        _ ≤ Cs * (qC B.h ξ ^ (B.h * Hx) * wv) := by
            rw [hwv]
            refine mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left ?_ hqa) hCs0
            exact mul_le_mul (mul_le_mul_of_nonneg_right hbm hE) hdm p2 (mul_nonneg p3 hE)
    have hev : g =ᶠ[nhds ξ] (fun η => qC B.h η ^ (-Aex B.h) * nrm B (Aex B.h) g η) :=
      Filter.eventuallyEq_of_mem (hUo.mem_nhds hξ) (fun η hη => by
        simp only [nrm]
        rw [← mul_assoc, ← Real.rpow_add (hqpos η hη), neg_add_cancel, Real.rpow_zero, one_mul])
    have hNBe : NB B.h g j ξ = NB B.h (fun η => qC B.h η ^ (-Aex B.h) * nrm B (Aex B.h) g η) j ξ := by
      unfold NB; rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds]
    have hl := nb_mul_le_v4 B.h (DomC B.h (qsOf l0)) (fun η => qC B.h η ^ (-Aex B.h))
      (nrm B (Aex B.h) g) hUo hps hFs ξ hξ j
    have hchoose : ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) = 2 ^ j := by
      exact_mod_cast Nat.sum_range_choose j
    have h2 : (2:ℝ) ^ j ≤ 2 ^ (k + 1) := pow_le_pow_right₀ (by norm_num) hj
    obtain ⟨X, hX⟩ : ∃ X : ℝ, X = Ks * qC B.h ξ ^ (-Aex B.h) * (Cs * (qC B.h ξ ^ (B.h * Hx) * wv)) :=
      ⟨_, rfl⟩
    have hX0 : 0 ≤ X := by
      rw [hX]; exact mul_nonneg (mul_nonneg hKs0 hqA) (mul_nonneg hCs0 (mul_nonneg hqa hwv0))
    have hexp : qC B.h ξ ^ (-Aex B.h) * qC B.h ξ ^ (B.h * Hx) = qC B.h ξ ^ (-Aex B.h + B.h * Hx) :=
      (Real.rpow_add hq _ _).symm
    rw [hNBe]
    calc NB B.h (fun η => qC B.h η ^ (-Aex B.h) * nrm B (Aex B.h) g η) j ξ
        ≤ ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * NB B.h (fun η => qC B.h η ^ (-Aex B.h)) i ξ *
            NB B.h (nrm B (Aex B.h) g) (j - i) ξ := hl
      _ ≤ ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * X := by
          apply Finset.sum_le_sum
          intro i hi
          have hij : i ≤ j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have b1 : NB B.h (fun η => qC B.h η ^ (-Aex B.h)) i ξ ≤ Ks * qC B.h ξ ^ (-Aex B.h) :=
            (hKq i ξ hξ).trans (mul_le_mul_of_nonneg_right (hKj i (by omega)) hqA)
          have b2 := hFb (j - i) (by omega)
          refine le_trans (mul_le_mul (mul_le_mul_of_nonneg_left b1 (Nat.cast_nonneg _)) b2 (norm_nonneg _)
            (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg hKs0 hqA))) (le_of_eq ?_)
          rw [hX]; ring
      _ = (∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ)) * X := by rw [Finset.sum_mul]
      _ = 2 ^ j * X := by rw [hchoose]
      _ ≤ 2 ^ (k + 1) * X := mul_le_mul_of_nonneg_right h2 hX0
      _ = _ := by rw [hX, hwv, ← hexp]; ring

  have hsm0 := (g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) Hx _ hok hb').1
  have hsm1 := (g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) Hx _ hok hw).1
  have hsm2 := (g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) Hx _ hok hg).1
  have hsm : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun ζ => dUM5 B dPsi dv ζ i) (DomC B.h (qsOf l0)) := by
    intro i
    fin_cases i
    · exact hsm0
    · exact hsm1
    · exact hsm2

  obtain ⟨C0, b0, d0, hC00, H0⟩ := unnorm _ hb'
