def StressTargetOK5 (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (Bo : ℝ) : Prop :=
  (∀ e : ℕ, (e = 1 ∨ e = 2) → ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) →
      sigE5 B G l0 S e ξ = 0) ∧
  (∀ e : ℕ, (e = 1 ∨ e = 2) → ∀ ξ ∈ DomC B.h (qsOf l0),
      dR B.h (sigE5 B G l0 S e) ξ + (e : ℝ) / ξ.1 * sigE5 B G l0 S e ξ =
        -FE5 B G l0 S e ξ + bE B e ξ * ME5 B G l0 S e ξ.2.1 ξ.2.2.1) ∧
  (∀ e : ℕ, (e = 1 ∨ e = 2) →
      InM B (qsOf l0) (Bo + 1/2 - kapS) (nrm B (2 * Aex B.h) (sigE5 B G l0 S e))) ∧
  (∀ e : ℕ, (e = 1 ∨ e = 2) → InM B (qsOf l0) (Bo + 3/2 - kapS)
      (nrm B (2 * Aex B.h + 1/2) (fun ξ => bE B e ξ * ME5 B G l0 S e ξ.2.1 ξ.2.2.1)))
noncomputable def sigAmp5 (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (γ : Lab) (ξ : Cyl) : ℝ :=
  let s : ℝ × ℝ × ℝ := (ξ.1, ξ.2.1, ξ.2.2.1)
  let Hp := Hcol B G (γ.1, γ.2.1, true) s
  let Hm := Hcol B G (γ.1, γ.2.1, false) s
  let T := (qC B.h ξ ^ (2 * B.h) * Qb γ.1 / epsb B.h γ.1) • sigPair5 B G l0 S ξ
  let det := Hp.1 * Hm.2 - Hm.1 * Hp.2
  (if γ.2.2 then (Hm.2 * T.1 - Hm.1 * T.2) / det else (Hp.1 * T.2 - Hp.2 * T.1) / det) /
    (2 * Real.sqrt (yAmp4 B G γ ξ))
