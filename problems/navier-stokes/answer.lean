  have fin : ∀ (K AA AE AP SC BA BE BP q sw ed DA P : ℝ), 0 < SC →
      K * (AA * SC ^ BA * (q * sw) * ed ^ (-DA)) * (AE * SC ^ BE) * (AP * SC ^ BP * P) =
