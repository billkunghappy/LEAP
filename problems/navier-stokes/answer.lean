theorem nb_smul_leibniz_v5 : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (h : ℝ) (c : Cyl → ℝ) (g : Cyl → V) (O : Set Cyl) (ξ : Cyl), IsOpen O → ξ ∈ O → ContDiffOn ℝ ∞ c O → ContDiffOn ℝ ∞ g O → ∀ k : ℕ, NB h (fun η => c η • g η) k ξ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB h c i ξ * NB h g (k - i) ξ :=
by
  intro V _ _ h c g O ξ hO hξ hc hg k
  have hck : ContDiffOn ℝ k c O := hc.of_le (by exact_mod_cast le_top)
  have hgk : ContDiffOn ℝ k g O := hg.of_le (by exact_mod_cast le_top)
  have leib : ∀ {W' : Type} [NormedAddCommGroup W'] [NormedSpace ℝ W'] (U : Set Cyl) (n : ℕ),
      IsOpen U → ξ ∈ U → ∀ (f : Cyl → ℝ) (G' : Cyl → W'), ContDiffOn ℝ n f U → ContDiffOn ℝ n G' U →
      NB h (fun η => f η • G' η) n ξ ≤
        ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * NB h f i ξ * NB h G' (n - i) ξ := by
    intro W' _ _ U n hU hξ f G' hf hG'
    unfold NB
    generalize Lnorm h ξ = L
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO' : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
    have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + z)) s := by
      intro W _ _ F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
      intro W _ _ F hF
      exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
    have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ∀ i : ℕ, i ≤ n →
        iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
          (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
      intro W _ _ F hF i hi
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO' h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
        hO'.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
      calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
              (fun _ => L) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
              (fun _ => L) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
              (fun _ => L) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
    have hfg : ContDiffOn ℝ n (fun η => f η • G' η) U := hf.smul hG'
    have hl := norm_iteratedFDerivWithin_smul_le (hsmO f hf) (hsmO G' hG') hO'.uniqueDiffOn h0O
      (n := n) le_rfl
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) • G' (ξ + L y)) n hO' h0O] at hl
    rw [← key _ hfg n le_rfl]
    calc ‖iteratedFDeriv ℝ n (fun z => (fun η => f η • G' η) (ξ + L z)) 0‖
        = ‖iteratedFDeriv ℝ n (fun y => f (ξ + L y) • G' (ξ + L y)) 0‖ := rfl
      _ ≤ _ := hl
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO' h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => G' (ξ + L z)) (n - i) hO' h0O,
          key f hf i hik, key G' hG' (n - i) (Nat.sub_le n i)]
  exact leib O k hO hξ c g hck hgk

theorem edge_factor_bound_v5 : ∀ (Xa Xb aa ab d : ℝ), 0 < Xa → Xa < Xb → 0 < aa → 0 < ab → ∃ E : ℝ, 0 ≤ E ∧ ∀ X : ℝ, Xa < X → X < Xb → Real.sqrt (edgeWeight Xa Xb aa ab X) * edgeDist Xa Xb X ^ (-d) ≤ E :=
by
  intro Xa Xb aa ab d hXa hXab haa hab
  obtain ⟨c, hc_def⟩ : ∃ c : ℝ, c = min aa ab := ⟨_, rfl⟩
  have hc0 : 0 < c := by rw [hc_def]; exact lt_min haa hab
  have hca : c ≤ aa := by rw [hc_def]; exact min_le_left _ _
  have hcb : c ≤ ab := by rw [hc_def]; exact min_le_right _ _
  obtain ⟨n, hdn⟩ : ∃ n : ℕ, d ≤ (n : ℝ) := ⟨⌈d⌉₊, Nat.le_ceil d⟩
  have hfac : (0:ℝ) < (n.factorial : ℝ) := Nat.cast_pos.mpr (Nat.factorial_pos n)
  refine ⟨(n.factorial : ℝ) * (2 / c) ^ n * Real.exp (c / 2), by positivity, ?_⟩
  intro X h1 h2
  have hX0 : 0 < X := lt_trans hXa h1
  obtain ⟨u, hu_def⟩ : ∃ u : ℝ, u = Real.log (X / Xa) := ⟨_, rfl⟩
  obtain ⟨v, hv_def⟩ : ∃ v : ℝ, v = Real.log (Xb / X) := ⟨_, rfl⟩
  have hu : 0 < u := by rw [hu_def]; exact Real.log_pos ((one_lt_div hXa).mpr h1)
  have hv : 0 < v := by rw [hv_def]; exact Real.log_pos ((one_lt_div hX0).mpr h2)
  obtain ⟨e, he_def⟩ : ∃ e : ℝ, e = edgeDist Xa Xb X := ⟨_, rfl⟩
  have hED : e = min 1 (min u v) := by
    rw [he_def, hu_def, hv_def]
    rfl
  have he0 : 0 < e := by rw [hED]; exact lt_min one_pos (lt_min hu hv)
  have he1 : e ≤ 1 := by rw [hED]; exact min_le_left _ _
  obtain ⟨T, hT⟩ : ∃ T : ℝ, T = aa / u ^ 2 + ab / v ^ 2 := ⟨_, rfl⟩
  have hT1 : 0 ≤ aa / u ^ 2 := by positivity
  have hT2 : 0 ≤ ab / v ^ 2 := by positivity
  have hT0 : 0 ≤ T := by rw [hT]; linarith

  have hWe : edgeWeight Xa Xb aa ab X = Real.exp (-T) := by
    unfold edgeWeight
    rw [if_pos ⟨h1, h2⟩, ← hu_def, ← hv_def, hT]
    congr 1
    ring
  have hW : Real.sqrt (edgeWeight Xa Xb aa ab X) = Real.exp (-T / 2) := by
    rw [hWe, ← Real.exp_half]

  have hcmp : c / e ^ 2 ≤ T + c := by
    rcases min_choice 1 (min u v) with h | h
    · rw [hED, h, one_pow, div_one]
      linarith
    · rcases min_choice u v with h' | h'
      · rw [hED, h, h']
        have : c / u ^ 2 ≤ aa / u ^ 2 := by gcongr
        rw [hT]
        linarith
      · rw [hED, h, h']
        have : c / v ^ 2 ≤ ab / v ^ 2 := by gcongr
        rw [hT]
        linarith

  have hpow1 : e ^ (-d) ≤ (e⁻¹) ^ n := by
    have h := Real.rpow_le_rpow_of_exponent_ge he0 he1 (show -(n:ℝ) ≤ -d by linarith)
    rw [Real.rpow_neg he0.le (n:ℝ), Real.rpow_natCast, ← inv_pow] at h
    exact h

  obtain ⟨x, hx_def⟩ : ∃ x : ℝ, x = c / (2 * e ^ 2) := ⟨_, rfl⟩
  have hx0 : 0 ≤ x := by rw [hx_def]; positivity
  have hxe : x ^ n / (n.factorial : ℝ) ≤ Real.exp x := Real.pow_div_factorial_le_exp (x := x) hx0 n
  have hxn : x ^ n ≤ Real.exp x * (n.factorial : ℝ) := (div_le_iff₀ hfac).mp hxe
  have he2 : 0 < e ^ 2 := by positivity
  have hbase : (2 / c) * x = (e ^ 2)⁻¹ := by
    rw [hx_def]
    field_simp
  have hee : e ^ 2 ≤ e := by
    calc e ^ 2 = e * e := sq e
      _ ≤ 1 * e := mul_le_mul_of_nonneg_right he1 he0.le
      _ = e := one_mul e
  have hinv : e⁻¹ ≤ (e ^ 2)⁻¹ := inv_anti₀ he2 hee
  have hpow2 : (e⁻¹) ^ n ≤ (n.factorial : ℝ) * (2 / c) ^ n * Real.exp x := by
    calc (e⁻¹) ^ n ≤ ((e ^ 2)⁻¹) ^ n := pow_le_pow_left₀ (by positivity) hinv n
      _ = (2 / c) ^ n * x ^ n := by rw [← mul_pow, hbase]
      _ ≤ (2 / c) ^ n * (Real.exp x * (n.factorial : ℝ)) :=
          mul_le_mul_of_nonneg_left hxn (by positivity)
      _ = (n.factorial : ℝ) * (2 / c) ^ n * Real.exp x := by ring
  have hexp : Real.exp x ≤ Real.exp ((T + c) / 2) := by
    apply Real.exp_le_exp.mpr
    have hx2 : x = (c / e ^ 2) / 2 := by rw [hx_def, div_div, mul_comm]
    rw [hx2]
    linarith

  rw [hW, ← he_def]
  have hE0 : 0 < Real.exp (-T / 2) := Real.exp_pos _
  have hK0 : 0 ≤ (n.factorial : ℝ) * (2 / c) ^ n := by positivity
  calc Real.exp (-T / 2) * e ^ (-d)
      ≤ Real.exp (-T / 2) * ((n.factorial : ℝ) * (2 / c) ^ n * Real.exp ((T + c) / 2)) := by
        apply mul_le_mul_of_nonneg_left _ hE0.le
        calc e ^ (-d) ≤ (e⁻¹) ^ n := hpow1
          _ ≤ (n.factorial : ℝ) * (2 / c) ^ n * Real.exp x := hpow2
          _ ≤ (n.factorial : ℝ) * (2 / c) ^ n * Real.exp ((T + c) / 2) :=
              mul_le_mul_of_nonneg_left hexp hK0
    _ = (n.factorial : ℝ) * (2 / c) ^ n * (Real.exp (-T / 2) * Real.exp ((T + c) / 2)) := by ring
    _ = (n.factorial : ℝ) * (2 / c) ^ n * Real.exp (c / 2) := by
        rw [← Real.exp_add]
        have hs : -T / 2 + (T + c) / 2 = c / 2 := by ring
        rw [hs]

theorem gauss_poly_absorb_v5 : ∀ (c₀ a b K : ℝ) (k N : ℕ), 0 < c₀ → ∃ C : ℝ, 0 ≤ C ∧ ∀ (l : ℕ) (q : ℝ), 1 ≤ l → Qb l / 4 < q → q < 4 * Qb l → q ≤ 1 → K * (4:ℝ) ^ (k * l) * q ^ a * ((1 + |Real.log q|) ^ 2) ^ b * Real.exp (-c₀ * (l:ℝ) ^ 2) ≤ C * q ^ (N:ℝ) :=
by
  intro c₀ a b K k N hc₀
  obtain ⟨M, hM⟩ : ∃ M : ℝ, M = 2 * (k:ℝ) + |a| + 2 * |b| + (N:ℝ) := ⟨_, rfl⟩
  obtain ⟨Z, hZ⟩ : ∃ Z : ℝ, Z = 2 * (|a| + 2 * |b| + (N:ℝ)) + M ^ 2 / (4 * c₀) := ⟨_, rfl⟩
  refine ⟨max K 0 * Real.exp Z, mul_nonneg (le_max_right _ _) (Real.exp_pos _).le, ?_⟩
  intro l q hl h1 h2 h3
  have hQb : Qb l = (2:ℝ) ^ (-(l:ℝ)) := rfl
  have hQ0 : 0 < Qb l := by rw [hQb]; exact Real.rpow_pos_of_pos (by norm_num) _
  have hq0 : 0 < q := lt_trans (div_pos hQ0 (by norm_num)) h1
  have hlogq : Real.log q ≤ 0 := Real.log_nonpos hq0.le h3
  have hL0 : (0:ℝ) ≤ (l:ℝ) := Nat.cast_nonneg l
  have hlog2 : Real.log 2 ≤ 1 := by
    have := Real.log_le_sub_one_of_pos (by norm_num : (0:ℝ) < 2)
    linarith
  have hlog4 : Real.log 4 = 2 * Real.log 2 := by
    rw [show (4:ℝ) = 2 ^ 2 by norm_num, Real.log_pow]
    push_cast
    ring
  have hlogQ : Real.log (Qb l / 4) = -((l:ℝ) + 2) * Real.log 2 := by
    rw [Real.log_div hQ0.ne' (by norm_num), hQb, Real.log_rpow (by norm_num), hlog4]
    ring
  have hlam : -Real.log q ≤ (l:ℝ) + 2 := by
    have hlt := Real.log_lt_log (div_pos hQ0 (by norm_num)) h1
    rw [hlogQ] at hlt
    have := mul_le_mul_of_nonneg_left hlog2 (by linarith : (0:ℝ) ≤ (l:ℝ) + 2)
    linarith

  have F1 : (4:ℝ) ^ (k * l) ≤ Real.exp (2 * (k:ℝ) * (l:ℝ)) := by
    rw [← Real.exp_log (by positivity : (0:ℝ) < 4 ^ (k * l)), Real.log_pow, hlog4]
    apply Real.exp_le_exp.mpr
    push_cast
    have hkl : (0:ℝ) ≤ (k:ℝ) * (l:ℝ) := by positivity
    have := mul_le_mul_of_nonneg_left hlog2 hkl
    nlinarith
  have F2 : q ^ a ≤ Real.exp (|a| * ((l:ℝ) + 2)) := by
    rw [Real.rpow_def_of_pos hq0]
    apply Real.exp_le_exp.mpr
    have e1 : 0 ≤ (-Real.log q) * (a + |a|) :=
      mul_nonneg (by linarith) (by linarith [neg_abs_le a])
    have e2 := mul_le_mul_of_nonneg_right hlam (abs_nonneg a)
    nlinarith
  have habs : |Real.log q| = -Real.log q := abs_of_nonpos hlogq
  have F3 : ((1 + |Real.log q|) ^ 2) ^ b ≤ Real.exp (2 * |b| * ((l:ℝ) + 2)) := by
    rw [habs]
    have hS : 0 < 1 + -Real.log q := by linarith
    rw [Real.rpow_def_of_pos (pow_pos hS 2), Real.log_pow]
    apply Real.exp_le_exp.mpr
    have hl1 : 0 ≤ Real.log (1 + -Real.log q) := Real.log_nonneg (by linarith)
    have hl2 : Real.log (1 + -Real.log q) ≤ -Real.log q := by
      have := Real.log_le_sub_one_of_pos hS
      linarith
    have e1 : Real.log (1 + -Real.log q) * b ≤ Real.log (1 + -Real.log q) * |b| :=
      mul_le_mul_of_nonneg_left (le_abs_self b) hl1
    have e2 : Real.log (1 + -Real.log q) * |b| ≤ ((l:ℝ) + 2) * |b| :=
      mul_le_mul_of_nonneg_right (by linarith) (abs_nonneg b)
    push_cast
    nlinarith
  have F4 : Real.exp (-(N:ℝ) * ((l:ℝ) + 2)) ≤ q ^ (N:ℝ) := by
    rw [Real.rpow_def_of_pos hq0]
    apply Real.exp_le_exp.mpr
    have := mul_le_mul_of_nonneg_right hlam (Nat.cast_nonneg N : (0:ℝ) ≤ (N:ℝ))
    nlinarith

  have hsq : M * (l:ℝ) - c₀ * (l:ℝ) ^ 2 ≤ M ^ 2 / (4 * c₀) := by
    rw [le_div_iff₀ (by positivity)]
    nlinarith [sq_nonneg (2 * c₀ * (l:ℝ) - M)]
  have hML : M * (l:ℝ) = (2 * (k:ℝ) + |a| + 2 * |b| + (N:ℝ)) * (l:ℝ) := by rw [hM]
  have hexp : 2 * (k:ℝ) * (l:ℝ) + |a| * ((l:ℝ) + 2) + 2 * |b| * ((l:ℝ) + 2) - c₀ * (l:ℝ) ^ 2 - Z
      ≤ -(N:ℝ) * ((l:ℝ) + 2) := by
    rw [hZ]
    nlinarith

  have p1 : (0:ℝ) ≤ (4:ℝ) ^ (k * l) := by positivity
  have p2 : 0 ≤ q ^ a := Real.rpow_nonneg hq0.le a
  have p3 : 0 ≤ ((1 + |Real.log q|) ^ 2) ^ b := Real.rpow_nonneg (by positivity) b
  have hP0 : 0 ≤ (4:ℝ) ^ (k * l) * q ^ a * ((1 + |Real.log q|) ^ 2) ^ b *
      Real.exp (-c₀ * (l:ℝ) ^ 2) := by
    exact mul_nonneg (mul_nonneg (mul_nonneg p1 p2) p3) (Real.exp_pos _).le
  have hP : (4:ℝ) ^ (k * l) * q ^ a * ((1 + |Real.log q|) ^ 2) ^ b *
      Real.exp (-c₀ * (l:ℝ) ^ 2) ≤ Real.exp Z * q ^ (N:ℝ) := by
    calc (4:ℝ) ^ (k * l) * q ^ a * ((1 + |Real.log q|) ^ 2) ^ b * Real.exp (-c₀ * (l:ℝ) ^ 2)
        ≤ Real.exp (2 * (k:ℝ) * (l:ℝ)) * Real.exp (|a| * ((l:ℝ) + 2)) *
            Real.exp (2 * |b| * ((l:ℝ) + 2)) * Real.exp (-c₀ * (l:ℝ) ^ 2) :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul (mul_le_mul F1 F2 p2 (Real.exp_pos _).le) F3 p3 (by positivity))
            (Real.exp_pos _).le
      _ = Real.exp Z * Real.exp (2 * (k:ℝ) * (l:ℝ) + |a| * ((l:ℝ) + 2) +
            2 * |b| * ((l:ℝ) + 2) - c₀ * (l:ℝ) ^ 2 - Z) := by
          rw [← Real.exp_add, ← Real.exp_add, ← Real.exp_add, ← Real.exp_add]
          congr 1
          ring
      _ ≤ Real.exp Z * Real.exp (-(N:ℝ) * ((l:ℝ) + 2)) :=
          mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hexp) (Real.exp_pos _).le
      _ ≤ Real.exp Z * q ^ (N:ℝ) := mul_le_mul_of_nonneg_left F4 (Real.exp_pos _).le
  calc K * (4:ℝ) ^ (k * l) * q ^ a * ((1 + |Real.log q|) ^ 2) ^ b * Real.exp (-c₀ * (l:ℝ) ^ 2)
      = K * ((4:ℝ) ^ (k * l) * q ^ a * ((1 + |Real.log q|) ^ 2) ^ b *
          Real.exp (-c₀ * (l:ℝ) ^ 2)) := by ring
    _ ≤ max K 0 * ((4:ℝ) ^ (k * l) * q ^ a * ((1 + |Real.log q|) ^ 2) ^ b *
          Real.exp (-c₀ * (l:ℝ) ^ 2)) := mul_le_mul_of_nonneg_right (le_max_left _ _) hP0
    _ ≤ max K 0 * (Real.exp Z * q ^ (N:ℝ)) := mul_le_mul_of_nonneg_left hP (le_max_right _ _)
    _ = max K 0 * Real.exp Z * q ^ (N:ℝ) := by ring

theorem inWg5_jet_vanish_off_shell_v5 : ∀ (B : BG) (G : CorrGeom) (qs α : ℝ) {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (a : Lab → ℤ → Cyl → V), B.ok → InWg5 B G qs α a → ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h qs, (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → ∀ j : ℕ, iteratedFDeriv ℝ j (a γ m) ξ = 0 :=
by
  intro B G qs α V _ _ a hok hf γ m ξ hξ hoff j
  have hS0o : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
    (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
  have hcq : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := by
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (Set.univ ×ˢ Set.Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    exact h4'.comp hφ.continuousOn hmaps
  have hq0' : ∀ ξ ∈ ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}), 0 < qC B.h ξ := by
    intro ξ hξ
    have h' : ξ.2.2.1 < 1 := hξ.2
    exact (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hDS : DomC B.h qs ⊆ {ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1} :=
    fun ξ hξ => ⟨hξ.1, hξ.2.1⟩
  have hq0 : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ := fun ξ hξ => hq0' ξ (hDS hξ)
  have hDo : IsOpen (DomC B.h qs) := by
    have h3' := hcq.isOpen_inter_preimage hS0o (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Set.Iio qs := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hXCc : ContinuousOn (XC B.h) (DomC B.h qs) := by
    have hc2 : ContinuousOn (fun ξ : Cyl => 2 * qC B.h ξ) (DomC B.h qs) :=
      continuousOn_const.mul (hcq.mono hDS)
    have hn : ContinuousOn (fun ξ : Cyl => ξ.1 ^ 2) (DomC B.h qs) :=
      (continuous_fst.pow 2).continuousOn
    exact hn.div hc2 (fun ξ hξ => by have := hq0 ξ hξ; positivity)
  have hUo : IsOpen (DomC B.h qs ∩ XC B.h ⁻¹' (Set.Iio B.Xa ∪ Set.Ioi B.Xb)) :=
    hXCc.isOpen_inter_preimage hDo (isOpen_Iio.union isOpen_Ioi)
  have hvan : ∀ η ∈ DomC B.h qs ∩ XC B.h ⁻¹' (Set.Iio B.Xa ∪ Set.Ioi B.Xb), a γ m η = 0 := by
    intro η hη
    by_contra hne
    have hS := hf.2.2.2.1 γ m η hη.1 hne
    have h1 : B.Xa ≤ XC B.h η := hS.2.2.2.2.1
    have h2 : XC B.h η ≤ B.Xb := hS.2.2.2.2.2
    rcases hη.2 with h | h
    · exact absurd (show XC B.h η < B.Xa from h) (not_lt.mpr h1)
    · exact absurd (show B.Xb < XC B.h η from h) (not_lt.mpr h2)
  have hjU : ∀ η ∈ DomC B.h qs ∩ XC B.h ⁻¹' (Set.Iio B.Xa ∪ Set.Ioi B.Xb),
      iteratedFDeriv ℝ j (a γ m) η = 0 := by
    intro η hη
    have hev : a γ m =ᶠ[nhds η] (fun _ => (0:V)) :=
      Filter.eventuallyEq_of_mem (hUo.mem_nhds hη) (fun y hy => hvan y hy)
    rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds]
    exact congrFun iteratedFDeriv_fun_zero η
  have hcont : ContinuousAt (iteratedFDeriv ℝ j (a γ m)) ξ :=
    ((hf.2.1 γ m).contDiffAt (hDo.mem_nhds hξ)).continuousAt_iteratedFDeriv
      (by exact_mod_cast le_top)
  have hφc : Continuous (fun s : ℝ => ((s * ξ.1, ξ.2) : Cyl)) := by fun_prop
  have hT : Filter.Tendsto (fun s : ℝ => iteratedFDeriv ℝ j (a γ m) ((s * ξ.1, ξ.2) : Cyl)) (nhds 1)
      (nhds (iteratedFDeriv ℝ j (a γ m) ξ)) := by
    have h1 : Filter.Tendsto (fun s : ℝ => ((s * ξ.1, ξ.2) : Cyl)) (nhds 1) (nhds ξ) := by
      have := hφc.tendsto 1
      simpa using this
    exact hcont.tendsto.comp h1
  have hXpos : 0 < XC B.h ξ := div_pos (pow_pos hξ.1 2) (by linarith [hq0 ξ hξ])
  have hφX : ∀ s : ℝ, XC B.h ((s * ξ.1, ξ.2) : Cyl) = s ^ 2 * XC B.h ξ := by
    intro s
    show (s * ξ.1) ^ 2 / (2 * qC B.h ξ) = s ^ 2 * (ξ.1 ^ 2 / (2 * qC B.h ξ))
    ring
  have hφD : ∀ s : ℝ, 0 < s → ((s * ξ.1, ξ.2) : Cyl) ∈ DomC B.h qs :=
    fun s hs => ⟨mul_pos hs hξ.1, hξ.2.1, hξ.2.2⟩
  rcases hoff with h | h
  · have hev : (fun s : ℝ => iteratedFDeriv ℝ j (a γ m) ((s * ξ.1, ξ.2) : Cyl))
        =ᶠ[nhdsWithin 1 (Set.Iio 1)] (fun _ => 0) := by
      filter_upwards [Ioo_mem_nhdsLT (by norm_num : (0:ℝ) < 1)] with s hs
      apply hjU
      refine ⟨hφD s hs.1, Or.inl ?_⟩
      show XC B.h ((s * ξ.1, ξ.2) : Cyl) < B.Xa
      rw [hφX]
      have hs2 : s ^ 2 < 1 := pow_lt_one₀ hs.1.le hs.2 two_ne_zero
      calc s ^ 2 * XC B.h ξ < 1 * XC B.h ξ := mul_lt_mul_of_pos_right hs2 hXpos
        _ ≤ B.Xa := by rw [one_mul]; exact h
    have hT1 := hT.mono_left (nhdsWithin_le_nhds (s := Set.Iio 1))
    exact tendsto_nhds_unique hT1 (tendsto_const_nhds.congr' hev.symm)
  · have hev : (fun s : ℝ => iteratedFDeriv ℝ j (a γ m) ((s * ξ.1, ξ.2) : Cyl))
        =ᶠ[nhdsWithin 1 (Set.Ioi 1)] (fun _ => 0) := by
      filter_upwards [Ioo_mem_nhdsGT (by norm_num : (1:ℝ) < 2)] with s hs
      apply hjU
      refine ⟨hφD s (by linarith [hs.1]), Or.inr ?_⟩
      show B.Xb < XC B.h ((s * ξ.1, ξ.2) : Cyl)
      rw [hφX]
      have hs2 : 1 < s ^ 2 := one_lt_pow₀ hs.1 two_ne_zero
      calc B.Xb ≤ 1 * XC B.h ξ := by rw [one_mul]; exact h
        _ < s ^ 2 * XC B.h ξ := mul_lt_mul_of_pos_right hs2 hXpos
    have hT1 := hT.mono_left (nhdsWithin_le_nhds (s := Set.Ioi 1))
    exact tendsto_nhds_unique hT1 (tendsto_const_nhds.congr' hev.symm)

theorem pzs_kmat_shift5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (η : Cyl) (y : ℝ × ℝ), Kmat B G γ (shY η y) = Kmat B G γ η :=
by
  intro B G γ η y
  have hs : ∀ x : Cyl, shY x y = x + ((0:ℝ), (0:ℝ), (0:ℝ), y) := fun x => by
    simp [shY, Prod.ext_iff]
  have hfd : ∀ f : Cyl → ℝ, (∀ x, f (shY x y) = f x) → fderiv ℝ f (shY η y) = fderiv ℝ f η := by
    intro f hf
    rw [hs η, ← fderiv_comp_add_right]
    congr 1
    funext x
    rw [← hs x, hf x]
  have hD : ∀ f : Cyl → ℝ, (∀ x, f (shY x y) = f x) → DrC B γ.1 f (shY η y) = DrC B γ.1 f η := by
    intro f hf
    unfold DrC dR
    rw [hfd f hf]
    rfl
  have h1 := hD (Fang B γ.1) (fun x => rfl)
  have h2 := hD (fun η => baseC B γ.1 η 2) (fun x => rfl)
  unfold Kmat
  rw [h1, h2]
  rfl

theorem pzs_line_vco5 : ∀ (h r0 : ℝ) (γ : Lab) (c Y : ℝ × ℝ) (s : ℝ), 0 < r0 → r0 ≤ 1/100 → |xiG h γ c Y| < r0 / 2 → |etG h γ c Y + s * cib h γ.1| < 2 * r0 → vco h r0 γ c (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) = vco h r0 γ c Y + s ∧ ∃ κ : ℝ, ∀ᶠ Y' in nhds (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)), vco h r0 γ c Y' = Tgc ^ bandIdx h γ.1 / cib h γ.1 * lamT Y' + κ :=
by
  intro h r0 γ c Y s hr0 hr01 hxi het
  have hcb : 0 < cib h γ.1 :=
    mul_pos (zpow_pos (by unfold Tgc; positivity) _) (Real.rpow_pos_of_pos (by unfold Qb; positivity) _)
  have hne : cib h γ.1 ≠ 0 := hcb.ne'
  have hs1 : 1 < Real.sqrt 2 := Real.one_lt_sqrt_two
  have hs2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hbgc0 : 0 < bgc := by unfold bgc; linarith
  have hbgc1 : bgc < 1 := by unfold bgc; nlinarith
  have hD : (0:ℝ) < 1 + bgc ^ 2 := by positivity
  have hD' : (1:ℝ) + bgc ^ 2 ≠ 0 := hD.ne'
  have hTgc : Tgc ≠ 0 := by unfold Tgc; positivity

  have hlamR : ∀ (w : ℝ × ℝ) (t : ℝ), lamR (w + t • vtv) = lamR w := by
    intro w t
    simp only [lamR, vtv, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    congr 1; ring
  have hlamT : ∀ (w : ℝ × ℝ) (t : ℝ), lamT (w + t • vtv) = lamT w + t := by
    intro w t
    simp only [lamT, vtv, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    field_simp
    ring
  have hshift : ∀ (n : ℤ) (a s : ℝ) (Y : ℝ × ℝ),
      Jpow n (Y + s • ((a * Tgc ^ (-n)) • vtv)) = Jpow n Y + (s * a) • vtv := by
    intro n a s Y
    have e : s • ((a * Tgc ^ (-n)) • vtv) = (s * a * Tgc ^ (-n)) • vtv := by
      rw [smul_smul]; ring_nf
    rw [e]
    have h1 := hlamR Y (s * a * Tgc ^ (-n))
    have h2 := hlamT Y (s * a * Tgc ^ (-n))
    unfold lamR at h1
    unfold lamT at h2
    have hTn : Tgc ^ n ≠ 0 := zpow_ne_zero n hTgc
    have hk : Tgc ^ n * (s * a * Tgc ^ (-n)) = s * a := by
      rw [zpow_neg]; field_simp
    unfold Jpow
    rw [h1, h2, mul_add, add_smul, hk, add_assoc]
  have hcoord : ∀ w : ℝ × ℝ, |w.1| ≤ |lamR w| + |lamT w| ∧ |w.2| ≤ |lamR w| + |lamT w| := by
    intro w
    have e1 : w.1 = lamR w + bgc * lamT w := by unfold lamR lamT; field_simp; ring
    have e2 : w.2 = -bgc * lamR w + lamT w := by unfold lamR lamT; field_simp; ring
    have hb : |bgc| ≤ 1 := by rw [abs_of_pos hbgc0]; exact hbgc1.le
    have hm1 : |bgc * lamT w| ≤ |lamT w| := by
      rw [abs_mul]; exact mul_le_of_le_one_left (abs_nonneg _) hb
    have hm2 : |-bgc * lamR w| ≤ |lamR w| := by
      rw [abs_mul, abs_neg]; exact mul_le_of_le_one_left (abs_nonneg _) hb
    constructor
    · calc |w.1| = |lamR w + bgc * lamT w| := by rw [← e1]
        _ ≤ |lamR w| + |bgc * lamT w| := abs_add_le _ _
        _ ≤ |lamR w| + |lamT w| := by linarith
    · calc |w.2| = |-bgc * lamR w + lamT w| := by rw [← e2]
        _ ≤ |-bgc * lamR w| + |lamT w| := abs_add_le _ _
        _ ≤ |lamR w| + |lamT w| := by linarith

  have hround : ∀ (x : ℝ) (k : ℤ), |x - k| < 1/2 → round x = k := by
    intro x k hx
    have h0 : round (x - k) = 0 := by
      rw [round_eq_zero_iff]
      rw [abs_lt] at hx
      exact ⟨by linarith, by linarith⟩
    have := round_add_intCast (x - k) k
    rw [sub_add_cancel, h0, zero_add] at this
    exact this
  have hfr : ∀ Y : ℝ × ℝ, rectW h γ c Y = Jpow (bandIdx h γ.1) Y - c -
      ((((round (Jpow (bandIdx h γ.1) Y - c).1 : ℤ) : ℝ)), (((round (Jpow (bandIdx h γ.1) Y - c).2 : ℤ) : ℝ))) := by
    intro Y
    rfl
  have hnear : ∀ (Y : ℝ × ℝ) (k1 k2 : ℤ),
      |(Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ))).1| < 1/2 →
      |(Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ))).2| < 1/2 →
      rectW h γ c Y = Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ)) := by
    intro Y k1 k2 h1 h2
    rw [hfr, hround _ _ h1, hround _ _ h2]
  have hFc : Continuous (fun Y : ℝ × ℝ => Jpow (bandIdx h γ.1) Y - c) := by
    unfold Jpow; fun_prop

  have hsubT : ∀ p q : ℝ × ℝ, lamT (p - q) = lamT p - lamT q := by
    intro p q
    simp only [lamT, Prod.fst_sub, Prod.snd_sub]
    field_simp
    ring
  have hJ : ∀ (n : ℤ) (Y' : ℝ × ℝ), lamT (Jpow n Y') = Tgc ^ n * lamT Y' := by
    intro n Y'
    simp only [Jpow, lamT, vrv, vtv, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd,
      smul_eq_mul]
    field_simp
    ring

  obtain ⟨k1, hk1⟩ : ∃ k : ℤ, k = round (Jpow (bandIdx h γ.1) Y - c).1 := ⟨_, rfl⟩
  obtain ⟨k2, hk2⟩ : ∃ k : ℤ, k = round (Jpow (bandIdx h γ.1) Y - c).2 := ⟨_, rfl⟩
  have hf : rectW h γ c Y = Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ)) := by
    rw [hfr, hk1, hk2]
  have hgeq : Jpow (bandIdx h γ.1) (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) - c -
      ((k1 : ℝ), (k2 : ℝ)) =
      (Jpow (bandIdx h γ.1) Y - c - ((k1 : ℝ), (k2 : ℝ))) + (s * cib h γ.1) • vtv := by
    rw [hshift]; abel
  have hgR : lamR (Jpow (bandIdx h γ.1) (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) - c -
      ((k1 : ℝ), (k2 : ℝ))) = xiG h γ c Y := by
    rw [hgeq, hlamR]; unfold xiG; rw [hf]
  have hgT : lamT (Jpow (bandIdx h γ.1) (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) - c -
      ((k1 : ℝ), (k2 : ℝ))) = etG h γ c Y + s * cib h γ.1 := by
    rw [hgeq, hlamT]; unfold etG; rw [hf]
  have hb := hcoord (Jpow (bandIdx h γ.1) (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) - c -
      ((k1 : ℝ), (k2 : ℝ)))
  rw [hgR, hgT] at hb
  have hh1 : |(Jpow (bandIdx h γ.1) (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) - c -
      ((k1 : ℝ), (k2 : ℝ))).1| < 1/2 := by linarith [hb.1]
  have hh2 : |(Jpow (bandIdx h γ.1) (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) - c -
      ((k1 : ℝ), (k2 : ℝ))).2| < 1/2 := by linarith [hb.2]
  have hY0 : rectW h γ c (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) =
      Jpow (bandIdx h γ.1) (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) - c -
        ((k1 : ℝ), (k2 : ℝ)) := hnear _ k1 k2 hh1 hh2
  have het0 : etG h γ c (Y + s • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) =
      etG h γ c Y + s * cib h γ.1 := by
    unfold etG; rw [hY0]; exact hgT
  refine ⟨?_, ?_⟩
  · unfold vco
    rw [het0]
    field_simp
    ring
  · have hUo : IsOpen ({Y' : ℝ × ℝ | |(Jpow (bandIdx h γ.1) Y' - c - ((k1 : ℝ), (k2 : ℝ))).1| < 1/2} ∩
        {Y' : ℝ × ℝ | |(Jpow (bandIdx h γ.1) Y' - c - ((k1 : ℝ), (k2 : ℝ))).2| < 1/2}) :=
      (isOpen_lt ((hFc.sub continuous_const).fst.abs) continuous_const).inter
        (isOpen_lt ((hFc.sub continuous_const).snd.abs) continuous_const)
    refine ⟨(r0 - lamT c - lamT ((k1 : ℝ), (k2 : ℝ))) / cib h γ.1,
      Filter.eventually_of_mem (hUo.mem_nhds ⟨hh1, hh2⟩) ?_⟩
    rintro Y' ⟨hY1, hY2⟩
    unfold vco etG
    rw [hnear Y' k1 k2 hY1 hY2, hsubT, hsubT, hJ]
    field_simp
    ring

theorem pzs_nphi_line5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl) (J : Set ℝ) (lam : ℝ), (∀ t ∈ J, vco B.h G.r0 γ (G.ctr γ) (pulsePth5 B G γ ξ t).2.2.2 = t) → (∀ t ∈ J, ∃ κ : ℝ, ∀ᶠ η in nhds (pulsePth5 B G γ ξ t), vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = lam * lamT η.2.2.2 + κ) → (∃ a0 b0 a2 b2 : ℝ, ∀ t ∈ J, nPhi5 B G γ (pulsePth5 B G γ ξ t) 0 = a0 - t * b0 ∧ nPhi5 B G γ (pulsePth5 B G γ ξ t) 2 = a2 - t * b2) ∨ (∀ t ∈ J, t ≠ 0 → nPhi5 B G γ (pulsePth5 B G γ ξ t) 0 = 0 ∧ nPhi5 B G γ (pulsePth5 B G γ ξ t) 2 = 0) :=
by
  intro B G γ ξ J lam hv hk

  obtain ⟨S1, hS1⟩ : ∃ S1 : Cyl → ℝ, S1 = fun η => pzr5 B G γ * chartZ B.h γ.1 η / epsb B.h γ.1 +
      sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 * RC γ.1 η := ⟨_, rfl⟩
  obtain ⟨H, hH⟩ : ∃ H : Cyl → ℝ, H = fun η => pang5 B G γ * Fang B γ.1 η +
      pzr5 B G γ * baseC B γ.1 η 2 := ⟨_, rfl⟩
  have hsplit : ∀ η : Cyl, phiL5 B G γ η = S1 η - vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * H η := by
    intro η
    rw [hS1, hH] <;> rfl
  have hxy : ∀ (x : Cyl) (y : ℝ × ℝ), x + ((0, 0, 0, y) : Cyl) = (x.1, x.2.1, x.2.2.1, x.2.2.2 + y) := by
    intro x y
    ext <;> simp
  have hS1sh : ∀ (x : Cyl) (y : ℝ × ℝ), S1 (x + ((0, 0, 0, y) : Cyl)) = S1 x := by
    intro x y
    rw [hxy x y, hS1] <;> rfl
  have hHsh : ∀ (x : Cyl) (y : ℝ × ℝ), H (x + ((0, 0, 0, y) : Cyl)) = H x := by
    intro x y
    rw [hxy x y, hH] <;> rfl
  have hS1diff : ∀ x : Cyl, DifferentiableAt ℝ S1 x := by
    intro x
    rw [hS1]
    simp only [chartZ, RC]
    fun_prop

  have hshift : ∀ (F : Cyl → ℝ), (∀ (x : Cyl) (y : ℝ × ℝ), F (x + ((0, 0, 0, y) : Cyl)) = F x) →
      ∀ y : ℝ × ℝ, fderiv ℝ F (ξ + ((0, 0, 0, y) : Cyl)) = fderiv ℝ F ξ ∧
        (DifferentiableAt ℝ F (ξ + ((0, 0, 0, y) : Cyl)) ↔ DifferentiableAt ℝ F ξ) := by
    intro F hF y
    have e : (fun x => F (x + ((0, 0, 0, y) : Cyl))) = F := funext fun x => hF x y
    have h1 := fderiv_comp_add_right (𝕜 := ℝ) (f := F) (x := ξ) ((0, 0, 0, y) : Cyl)
    have h2 := differentiableAt_comp_add_right (𝕜 := ℝ) (f := F) (x := ξ) ((0, 0, 0, y) : Cyl)
    rw [e] at h1 h2
    exact ⟨h1.symm, h2.symm⟩

  obtain ⟨yt, hyt⟩ : ∃ yt : ℝ → ℝ × ℝ, yt = fun t => (t - vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) •
      ((cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) • vtv) := ⟨_, rfl⟩
  have hpath : ∀ t : ℝ, pulsePth5 B G γ ξ t = ξ + ((0, 0, 0, yt t) : Cyl) := by
    intro t
    rw [hyt]
    simp only [pulsePth5, dVdir, Prod.smul_mk, smul_zero]
  have hfst : ∀ t : ℝ, (pulsePth5 B G γ ξ t).1 = ξ.1 := by
    intro t
    rw [hpath t]
    simp

  have hn0 : ∀ η : Cyl, nPhi5 B G γ η 0 = Real.sqrt (Qb γ.1) *
      fderiv ℝ (phiL5 B G γ) η (1, 0, 0, (drx B.h * η.1 ^ (drx B.h - 1)) • vrv) := by
    intro η
    simp only [nPhi5, Matrix.cons_val_zero, DrC, dR, smul_eq_mul]
  have hn2 : ∀ η : Cyl, nPhi5 B G γ η 2 = Real.sqrt (Qb γ.1) *
      fderiv ℝ (phiL5 B G γ) η (0, 1, 0, 0) := by
    intro η
    simp only [nPhi5, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons, DzC, dZ, smul_eq_mul]

  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : Cyl →L[ℝ] ℝ, ∀ w : Cyl, ℓ w = lam * lamT w.2.2.2 := by
    refine ⟨(lam / (1 + bgc ^ 2)) • (bgc • ((ContinuousLinearMap.fst ℝ ℝ ℝ).comp
      ((ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
        (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))))) +
      (ContinuousLinearMap.snd ℝ ℝ ℝ).comp
      ((ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
        (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))))), fun w => ?_⟩
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.coe_comp', Function.comp_apply, ContinuousLinearMap.coe_fst',
      ContinuousLinearMap.coe_snd', smul_eq_mul, lamT]
    ring
  have hV : ∀ (κ : ℝ) (x : Cyl), HasFDerivAt (fun η : Cyl => lam * lamT η.2.2.2 + κ) ℓ x := by
    intro κ x
    have e : (fun η : Cyl => lam * lamT η.2.2.2 + κ) = fun η => ℓ η + κ :=
      funext fun η => by rw [hℓ η]
    rw [e]
    exact ℓ.hasFDerivAt.add_const κ
  have hlr : ∀ c : ℝ, lamT (c • vrv) = 0 := by
    intro c
    unfold lamT vrv
    simp only [Prod.smul_mk, smul_eq_mul]
    ring
  have hℓr : ℓ ((1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) : Cyl) = 0 := by
    rw [hℓ]
    show lam * lamT ((drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) = 0
    rw [hlr, mul_zero]
  have hℓz : ℓ ((0, 1, 0, 0) : Cyl) = 0 := by
    rw [hℓ]
    simp [lamT]

  have hloc : ∀ t ∈ J, ∃ κ : ℝ, lam * lamT (pulsePth5 B G γ ξ t).2.2.2 + κ = t ∧
      phiL5 B G γ =ᶠ[nhds (pulsePth5 B G γ ξ t)]
        fun η => S1 η - (lam * lamT η.2.2.2 + κ) * H η := by
    intro t ht
    obtain ⟨κ, hκ⟩ := hk t ht
    refine ⟨κ, ?_, ?_⟩
    · rw [← hκ.self_of_nhds]
      exact hv t ht
    · exact hκ.mono fun η hη => by rw [hsplit η, hη]
  by_cases hD : DifferentiableAt ℝ H ξ
  · left
    refine ⟨Real.sqrt (Qb γ.1) * fderiv ℝ S1 ξ (1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv),
      Real.sqrt (Qb γ.1) * fderiv ℝ H ξ (1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv),
      Real.sqrt (Qb γ.1) * fderiv ℝ S1 ξ (0, 1, 0, 0),
      Real.sqrt (Qb γ.1) * fderiv ℝ H ξ (0, 1, 0, 0), ?_⟩
    intro t ht
    obtain ⟨κ, hVt, hev⟩ := hloc t ht
    have hHd : DifferentiableAt ℝ H (pulsePth5 B G γ ξ t) := by
      rw [hpath t]
      exact ((hshift H hHsh (yt t)).2).mpr hD
    have hder : HasFDerivAt (fun η => S1 η - (lam * lamT η.2.2.2 + κ) * H η)
        (fderiv ℝ S1 (pulsePth5 B G γ ξ t) -
          ((lam * lamT (pulsePth5 B G γ ξ t).2.2.2 + κ) • fderiv ℝ H (pulsePth5 B G γ ξ t) +
            H (pulsePth5 B G γ ξ t) • ℓ)) (pulsePth5 B G γ ξ t) :=
      (hS1diff _).hasFDerivAt.fun_sub ((hV κ _).fun_mul hHd.hasFDerivAt)
    have key : fderiv ℝ (phiL5 B G γ) (pulsePth5 B G γ ξ t) =
        fderiv ℝ S1 ξ - (t • fderiv ℝ H ξ + H ξ • ℓ) := by
      rw [(hder.congr_of_eventuallyEq hev).fderiv, hVt, hpath t, (hshift S1 hS1sh (yt t)).1,
        (hshift H hHsh (yt t)).1, hHsh]
    rw [hn0, hn2, key, hfst t]
    simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul, hℓr, hℓz]
    constructor <;> ring
  · right
    intro t ht ht0
    obtain ⟨κ, hVt, hev⟩ := hloc t ht
    have hz : fderiv ℝ (phiL5 B G γ) (pulsePth5 B G γ ξ t) = 0 := by
      apply fderiv_zero_of_not_differentiableAt
      intro hφ
      apply hD
      have hVd : DifferentiableAt ℝ (fun η : Cyl => lam * lamT η.2.2.2 + κ) (pulsePth5 B G γ ξ t) :=
        (hV κ _).differentiableAt
      have hVne : lam * lamT (pulsePth5 B G γ ξ t).2.2.2 + κ ≠ 0 := by rw [hVt]; exact ht0
      have hne : ∀ᶠ η in nhds (pulsePth5 B G γ ξ t), lam * lamT η.2.2.2 + κ ≠ 0 :=
        hVd.continuousAt.eventually_ne hVne
      have hq : DifferentiableAt ℝ (fun η => (S1 η - phiL5 B G γ η) * (lam * lamT η.2.2.2 + κ)⁻¹)
          (pulsePth5 B G γ ξ t) :=
        ((hS1diff _).fun_sub hφ).fun_mul (hVd.fun_inv hVne)
      have hHd : DifferentiableAt ℝ H (pulsePth5 B G γ ξ t) := by
        refine hq.congr_of_eventuallyEq ?_
        filter_upwards [hev, hne] with η h1 h2
        have h1' : phiL5 B G γ η = S1 η - (lam * lamT η.2.2.2 + κ) * H η := h1
        rw [h1', sub_sub_cancel, mul_comm (lam * lamT η.2.2.2 + κ) (H η), mul_inv_cancel_right₀ h2]
      rw [hpath t] at hHd
      exact (hshift H hHsh (yt t)).2.mp hHd
    rw [hn0, hn2, hz]
    simp

theorem pzs_lin_ode_zero5 : ∀ (L C : ℝ) (A : ℝ → Matrix (Fin 3) (Fin 3) ℂ) (Z : ℝ → (Fin 3 → ℂ)), (∀ t ∈ Set.Icc (0:ℝ) L, ∀ i j : Fin 3, ‖A t i j‖ ≤ C) → Z 0 = 0 → (∀ t ∈ Set.Icc (0:ℝ) L, HasDerivWithinAt Z ((A t).mulVec (Z t)) (Set.Icc (0:ℝ) L) t) → ∀ t ∈ Set.Icc (0:ℝ) L, Z t = 0 :=
by
  intro L C A Z hA hZ0 hD t ht
  have hcont : ContinuousOn Z (Set.Icc (0:ℝ) L) := fun s hs => (hD s hs).continuousWithinAt
  have hderiv : ∀ x ∈ Set.Ico (0:ℝ) L,
      HasDerivWithinAt Z ((A x).mulVec (Z x)) (Set.Ici x) x := by
    intro x hx
    exact (hD x (Set.Ico_subset_Icc_self hx)).mono_of_mem_nhdsWithin (Icc_mem_nhdsGE_of_mem hx)
  have hbound : ∀ x ∈ Set.Ico (0:ℝ) L, ‖(A x).mulVec (Z x)‖ ≤ (3 * C) * ‖Z x‖ + 0 := by
    intro x hx
    have hxI : x ∈ Set.Icc (0:ℝ) L := Set.Ico_subset_Icc_self hx
    have hC0 : 0 ≤ C := le_trans (norm_nonneg _) (hA x hxI 0 0)
    rw [add_zero]
    refine (pi_norm_le_iff_of_nonneg (by positivity)).2 ?_
    intro i
    have e : (A x).mulVec (Z x) i = ∑ j, A x i j * Z x j := rfl
    rw [e]
    calc ‖∑ j, A x i j * Z x j‖ ≤ ∑ j, ‖A x i j * Z x j‖ := norm_sum_le _ _
      _ ≤ ∑ _j : Fin 3, C * ‖Z x‖ := by
          apply Finset.sum_le_sum
          intro j _
          rw [norm_mul]
          exact mul_le_mul (hA x hxI i j) (norm_le_pi_norm (Z x) j) (norm_nonneg _) hC0
      _ = 3 * C * ‖Z x‖ := by
          simp only [Fin.sum_univ_three]; ring
  have h0 : ‖Z 0‖ ≤ 0 := by rw [hZ0, norm_zero]
  have hg := norm_le_gronwallBound_of_norm_deriv_right_le hcont hderiv h0 hbound t ht
  rw [gronwallBound_ε0_δ0] at hg
  exact norm_le_zero_iff.mp hg

theorem pzs_aphi_bound5 : ∀ (L c N P κ : ℝ) (μ : ℂ) (Km : Matrix (Fin 3) (Fin 3) ℝ) (n nP : ℝ → Fin 3 → ℝ), 0 < c → (∀ t ∈ Set.Icc (0:ℝ) L, c ≤ dotProduct (n t) (n t) ∧ (∀ i : Fin 3, |n t i| ≤ N) ∧ ∀ i : Fin 3, |nP t i| ≤ P) → ∃ C : ℝ, ∀ t ∈ Set.Icc (0:ℝ) L, ∀ i j : Fin 3, ‖(pulseMatC (-Km + (dotProduct (n t) (n t))⁻¹ • Matrix.vecMulVec (n t) (Matrix.vecMul (n t) Km - nP t)) - (μ * ((κ * dotProduct (n t) (n t) : ℝ) : ℂ)) • (1 : Matrix (Fin 3) (Fin 3) ℂ)) i j‖ ≤ C :=
by
  intro L c N P κ μ Km n nP hc hyp
  set Kb : ℝ := ∑ a : Fin 3, ∑ b : Fin 3, |Km a b| with hKb
  set N' : ℝ := max N 0 with hN'
  have hKm : ∀ a b : Fin 3, |Km a b| ≤ Kb := by
    intro a b
    calc |Km a b| ≤ ∑ b' : Fin 3, |Km a b'| :=
          Finset.single_le_sum (f := fun b' => |Km a b'|) (fun _ _ => abs_nonneg _)
            (Finset.mem_univ b)
      _ ≤ Kb := Finset.single_le_sum (f := fun a' => ∑ b' : Fin 3, |Km a' b'|)
          (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _)) (Finset.mem_univ a)
  have hKb0 : 0 ≤ Kb := le_trans (abs_nonneg _) (hKm 0 0)
  have hN0 : 0 ≤ N' := le_max_right _ _
  refine ⟨Kb + N' * (3 * N' * Kb + |P|) / c + ‖μ‖ * |κ| * (3 * N' ^ 2), fun t ht i j => ?_⟩
  obtain ⟨hcs, hn, hp⟩ := hyp t ht
  set s := dotProduct (n t) (n t) with hs
  have hn' : ∀ k, |n t k| ≤ N' := fun k => le_trans (hn k) (le_max_left _ _)
  have hp' : ∀ k, |nP t k| ≤ |P| := fun k => le_trans (hp k) (le_abs_self _)
  have hs0 : 0 < s := lt_of_lt_of_le hc hcs
  have hsinv : s⁻¹ ≤ c⁻¹ := inv_anti₀ hc hcs
  have hsq : ∀ k, n t k * n t k ≤ N' * N' := by
    intro k
    rw [← abs_mul_abs_self]
    exact mul_le_mul (hn' k) (hn' k) (abs_nonneg _) hN0
  have hsle : s ≤ 3 * N' ^ 2 := by
    have : s = n t 0 * n t 0 + n t 1 * n t 1 + n t 2 * n t 2 := by
      simp [hs, dotProduct, Fin.sum_univ_three]
    rw [this]; nlinarith [hsq 0, hsq 1, hsq 2]
  set w := Matrix.vecMul (n t) Km - nP t with hw
  have hwj : |w j| ≤ 3 * N' * Kb + |P| := by
    have e : w j = n t 0 * Km 0 j + n t 1 * Km 1 j + n t 2 * Km 2 j - nP t j := by
      simp [hw, Matrix.vecMul, dotProduct, Fin.sum_univ_three]
    have hk : ∀ k, |n t k * Km k j| ≤ N' * Kb := fun k => by
      rw [abs_mul]; exact mul_le_mul (hn' k) (hKm k j) (abs_nonneg _) hN0
    rw [e]
    calc _ ≤ |n t 0 * Km 0 j + n t 1 * Km 1 j + n t 2 * Km 2 j| + |nP t j| := abs_sub _ _
      _ ≤ |n t 0 * Km 0 j| + |n t 1 * Km 1 j| + |n t 2 * Km 2 j| + |nP t j| := by
          gcongr; exact abs_add_three _ _ _
      _ ≤ _ := by linarith [hk 0, hk 1, hk 2, hp' j]
  set A := -Km + s⁻¹ • Matrix.vecMulVec (n t) w with hA
  have hAij : |A i j| ≤ Kb + N' * (3 * N' * Kb + |P|) / c := by
    have e : A i j = -Km i j + s⁻¹ * (n t i * w j) := by
      simp [hA, Matrix.vecMulVec_apply]
    rw [e]
    have h1 : |s⁻¹ * (n t i * w j)| ≤ c⁻¹ * (N' * (3 * N' * Kb + |P|)) := by
      rw [abs_mul, abs_mul, abs_of_pos (inv_pos.mpr hs0)]
      apply mul_le_mul hsinv _ (by positivity) (inv_pos.mpr hc).le
      exact mul_le_mul (hn' i) hwj (abs_nonneg _) hN0
    calc _ ≤ |-Km i j| + |s⁻¹ * (n t i * w j)| := abs_add_le _ _
      _ ≤ Kb + c⁻¹ * (N' * (3 * N' * Kb + |P|)) := by rw [abs_neg]; linarith [hKm i j]
      _ = _ := by rw [div_eq_inv_mul]
  have hM1 : ‖pulseMatC A i j‖ = |A i j| := by
    simp [pulseMatC, Matrix.map_apply, Complex.norm_real]
  have hM2 : ‖((μ * ((κ * s : ℝ) : ℂ)) • (1 : Matrix (Fin 3) (Fin 3) ℂ)) i j‖ ≤
      ‖μ‖ * |κ| * (3 * N' ^ 2) := by
    rw [Matrix.smul_apply, smul_eq_mul, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_mul, abs_of_pos hs0]
    have h1 : ‖(1 : Matrix (Fin 3) (Fin 3) ℂ) i j‖ ≤ 1 := by
      rw [Matrix.one_apply]; split_ifs <;> simp
    have h2 : |κ| * s ≤ |κ| * (3 * N' ^ 2) := mul_le_mul_of_nonneg_left hsle (abs_nonneg _)
    calc ‖μ‖ * (|κ| * s) * ‖(1 : Matrix (Fin 3) (Fin 3) ℂ) i j‖ ≤
          ‖μ‖ * (|κ| * (3 * N' ^ 2)) * 1 := by
          apply mul_le_mul (mul_le_mul_of_nonneg_left h2 (norm_nonneg _)) h1 (norm_nonneg _)
            (by positivity)
      _ = _ := by ring
  rw [Matrix.sub_apply]
  calc _ ≤ ‖pulseMatC A i j‖ +
        ‖((μ * ((κ * s : ℝ) : ℂ)) • (1 : Matrix (Fin 3) (Fin 3) ℂ)) i j‖ := norm_sub_le _ _
    _ ≤ _ := by rw [hM1]; linarith

theorem pzs_nsq_lower5 : ∀ (L n1 : ℝ) (n : ℝ → Fin 3 → ℝ), 0 < L → (∀ t ∈ Set.Icc (0:ℝ) L, n t 1 = n1) → ((∃ a0 b0 a2 b2 : ℝ, ∀ t ∈ Set.Icc (0:ℝ) L, n t 0 = a0 - t * b0 ∧ n t 2 = a2 - t * b2) ∨ (∀ t ∈ Set.Icc (0:ℝ) L, t ≠ 0 → n t 0 = 0 ∧ n t 2 = 0)) → (∀ t ∈ Set.Icc (0:ℝ) L, dotProduct (n t) (n t) ≠ 0) → ∃ c N : ℝ, 0 < c ∧ ∀ t ∈ Set.Icc (0:ℝ) L, c ≤ dotProduct (n t) (n t) ∧ ∀ i : Fin 3, |n t i| ≤ N :=
by
  intro L n1 n hL H1 H2 H3
  have hexp : ∀ v : Fin 3 → ℝ, dotProduct v v = v 0 * v 0 + v 1 * v 1 + v 2 * v 2 := by
    intro v
    simp only [dotProduct, Fin.sum_univ_three]
  have hpos : ∀ t ∈ Set.Icc (0:ℝ) L, 0 < dotProduct (n t) (n t) := by
    intro t ht
    have h0 : 0 ≤ dotProduct (n t) (n t) := by
      rw [hexp]
      nlinarith [mul_self_nonneg (n t 0), mul_self_nonneg (n t 1), mul_self_nonneg (n t 2)]
    exact lt_of_le_of_ne h0 (Ne.symm (H3 t ht))
  rcases H2 with ⟨a0, b0, a2, b2, hA⟩ | hB
  · obtain ⟨f, hf⟩ : ∃ f : ℝ → ℝ,
        f = fun t => (a0 - t * b0) * (a0 - t * b0) + n1 * n1 + (a2 - t * b2) * (a2 - t * b2) :=
      ⟨_, rfl⟩
    have hfc : Continuous f := by rw [hf]; fun_prop
    have hdot : ∀ t ∈ Set.Icc (0:ℝ) L, dotProduct (n t) (n t) = f t := by
      intro t ht
      rw [hexp, H1 t ht, (hA t ht).1, (hA t ht).2, hf]
    obtain ⟨ts, hts, hmin⟩ := (isCompact_Icc : IsCompact (Set.Icc (0:ℝ) L)).exists_isMinOn
      (Set.nonempty_Icc.mpr hL.le) hfc.continuousOn
    refine ⟨f ts, |a0| + L * |b0| + |n1| + |a2| + L * |b2|, ?_, ?_⟩
    · rw [← hdot ts hts]; exact hpos ts hts
    · intro t ht
      refine ⟨?_, ?_⟩
      · rw [hdot t ht]; exact hmin ht
      · have ht0 : 0 ≤ t := ht.1
        have htL : t ≤ L := ht.2
        have hb0 : |t * b0| ≤ L * |b0| := by
          rw [abs_mul, abs_of_nonneg ht0]; exact mul_le_mul_of_nonneg_right htL (abs_nonneg _)
        have hb2 : |t * b2| ≤ L * |b2| := by
          rw [abs_mul, abs_of_nonneg ht0]; exact mul_le_mul_of_nonneg_right htL (abs_nonneg _)
        have q1 := abs_nonneg a0
        have q2 := abs_nonneg a2
        have q3 := abs_nonneg n1
        have q4 : 0 ≤ L * |b0| := mul_nonneg hL.le (abs_nonneg _)
        have q5 : 0 ≤ L * |b2| := mul_nonneg hL.le (abs_nonneg _)
        have r1 := neg_abs_le a0
        have r2 := le_abs_self a0
        have r3 := neg_abs_le (t * b0)
        have r4 := le_abs_self (t * b0)
        have r5 := neg_abs_le a2
        have r6 := le_abs_self a2
        have r7 := neg_abs_le (t * b2)
        have r8 := le_abs_self (t * b2)
        have c0 : |n t 0| ≤ |a0| + L * |b0| + |n1| + |a2| + L * |b2| := by
          rw [(hA t ht).1]
          exact abs_le.mpr ⟨by linarith, by linarith⟩
        have c1 : |n t 1| ≤ |a0| + L * |b0| + |n1| + |a2| + L * |b2| := by
          rw [H1 t ht]; linarith
        have c2 : |n t 2| ≤ |a0| + L * |b0| + |n1| + |a2| + L * |b2| := by
          rw [(hA t ht).2]
          exact abs_le.mpr ⟨by linarith, by linarith⟩
        intro i
        fin_cases i
        · exact c0
        · exact c1
        · exact c2
  · have hL0 : (0:ℝ) ∈ Set.Icc (0:ℝ) L := Set.left_mem_Icc.mpr hL.le
    have hLL : L ∈ Set.Icc (0:ℝ) L := Set.right_mem_Icc.mpr hL.le
    have hd0 := hpos 0 hL0
    have hn1 : 0 < n1 * n1 := by
      have h := hpos L hLL
      rw [hexp, (hB L hLL hL.ne').1, (hB L hLL hL.ne').2, H1 L hLL] at h
      nlinarith
    refine ⟨min (n1 * n1) (dotProduct (n 0) (n 0)), |n 0 0| + |n 0 2| + |n1|, lt_min hn1 hd0, ?_⟩
    intro t ht
    have a1 := abs_nonneg (n 0 0)
    have a2 := abs_nonneg (n 0 2)
    have a3 := abs_nonneg n1
    by_cases ht0 : t = 0
    · subst ht0
      refine ⟨min_le_right _ _, ?_⟩
      have c0 : |n 0 0| ≤ |n 0 0| + |n 0 2| + |n1| := by linarith
      have c1 : |n 0 1| ≤ |n 0 0| + |n 0 2| + |n1| := by rw [H1 0 hL0]; linarith
      have c2 : |n 0 2| ≤ |n 0 0| + |n 0 2| + |n1| := by linarith
      intro i
      fin_cases i
      · exact c0
      · exact c1
      · exact c2
    · obtain ⟨e0, e2⟩ := hB t ht ht0
      refine ⟨?_, ?_⟩
      · rw [hexp (n t), e0, e2, H1 t ht]
        have := min_le_left (n1 * n1) (dotProduct (n 0) (n 0))
        nlinarith
      · have c0 : |n t 0| ≤ |n 0 0| + |n 0 2| + |n1| := by rw [e0, abs_zero]; linarith
        have c1 : |n t 1| ≤ |n 0 0| + |n 0 2| + |n1| := by rw [H1 t ht]; linarith
        have c2 : |n t 2| ≤ |n 0 0| + |n 0 2| + |n1| := by rw [e2, abs_zero]; linarith
        intro i
        fin_cases i
        · exact c0
        · exact c1
        · exact c2

theorem pzs_nphiP_bound5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl), 0 < Lsb B.h G.r0 γ.1 → ((∃ a0 b0 a2 b2 : ℝ, ∀ t ∈ Set.Ioo (-(Lsb B.h G.r0 γ.1) / 2) (3 * Lsb B.h G.r0 γ.1 / 2), nPhi5 B G γ (pulsePth5 B G γ ξ t) 0 = a0 - t * b0 ∧ nPhi5 B G γ (pulsePth5 B G γ ξ t) 2 = a2 - t * b2) ∨ (∀ t ∈ Set.Ioo (-(Lsb B.h G.r0 γ.1) / 2) (3 * Lsb B.h G.r0 γ.1 / 2), t ≠ 0 → nPhi5 B G γ (pulsePth5 B G γ ξ t) 0 = 0 ∧ nPhi5 B G γ (pulsePth5 B G γ ξ t) 2 = 0)) → ∃ P : ℝ, ∀ t ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), ∀ i : Fin 3, |nPhiP5 B G γ (pulsePth5 B G γ ξ t) i| ≤ P :=
by
  intro B G γ ξ hL hdich
  set L := Lsb B.h G.r0 γ.1 with hLdef

  have DD : ∀ (F : Cyl → ℝ) (η e : Cyl) (a b : ℝ),
      (∀ᶠ s in nhds (0:ℝ), F (η + s • e) = a - s * b) → |fderiv ℝ F η e| ≤ |b| := by
    intro F η e a b hF
    by_cases hd : DifferentiableAt ℝ F η
    · have hℓ : HasDerivAt (fun s : ℝ => η + s • e) e 0 := by
        simpa using ((hasDerivAt_id (0:ℝ)).smul_const e).const_add η
      have h1 : HasDerivAt (F ∘ fun s : ℝ => η + s • e) (fderiv ℝ F η e) 0 :=
        hd.hasFDerivAt.comp_hasDerivAt_of_eq 0 hℓ (by simp)
      have hg : HasDerivAt (fun s : ℝ => a - s * b) (-b) 0 := by
        simpa using ((hasDerivAt_id (0:ℝ)).mul_const b).const_sub a
      have h2 : HasDerivAt (F ∘ fun s : ℝ => η + s • e) (-b) 0 :=
        hg.congr_of_eventuallyEq hF
      rw [h1.unique h2, abs_neg]
    · rw [fderiv_zero_of_not_differentiableAt hd]
      simp
  have hpath : ∀ t s : ℝ, pulsePth5 B G γ ξ t + s • dVdir B.h γ.1 = pulsePth5 B G γ ξ (t + s) := by
    intro t s
    simp only [pulsePth5]
    rw [add_assoc, ← add_smul]
    congr 2
    ring
  have hnP : ∀ (η : Cyl) (i : Fin 3), nPhiP5 B G γ η i =
      fderiv ℝ (fun η' => nPhi5 B G γ η' i) η (dVdir B.h γ.1) := fun _ _ => rfl
  have hF1 : ∀ w : ℝ, nPhi5 B G γ (pulsePth5 B G γ ξ w) 1 = pang5 B G γ / RC γ.1 ξ := by
    intro w
    show pang5 B G γ / RC γ.1 (pulsePth5 B G γ ξ w) = pang5 B G γ / RC γ.1 ξ
    simp [RC, pulsePth5, dVdir]
  have hbd : ∀ (t : ℝ) (i : Fin 3) (a b : ℝ) (U : Set ℝ), U ∈ nhds (0:ℝ) →
      (∀ s ∈ U, nPhi5 B G γ (pulsePth5 B G γ ξ (t + s)) i = a - s * b) →
      |nPhiP5 B G γ (pulsePth5 B G γ ξ t) i| ≤ |b| := by
    intro t i a b U hU h
    rw [hnP]
    apply DD _ _ _ a b
    filter_upwards [hU] with s hs
    show nPhi5 B G γ (pulsePth5 B G γ ξ t + s • dVdir B.h γ.1) i = a - s * b
    rw [hpath]
    exact h s hs
  have hb1 : ∀ t : ℝ, |nPhiP5 B G γ (pulsePth5 B G γ ξ t) 1| ≤ 0 := by
    intro t
    have := hbd t 1 (pang5 B G γ / RC γ.1 ξ) 0 Set.univ Filter.univ_mem
      (fun s _ => by rw [hF1]; ring)
    rw [abs_zero] at this
    exact this
  rcases hdich with ⟨a0, b0, a2, b2, hD⟩ | hN
  · refine ⟨|b0| + |b2|, fun t ht i => ?_⟩
    have hU : Set.Ioo (-L / 2 - t) (3 * L / 2 - t) ∈ nhds (0:ℝ) :=
      Ioo_mem_nhds (by linarith [ht.1]) (by linarith [ht.2])
    have hJ : ∀ s ∈ Set.Ioo (-L / 2 - t) (3 * L / 2 - t), t + s ∈ Set.Ioo (-L / 2) (3 * L / 2) := by
      intro s hs
      exact ⟨by linarith [hs.1], by linarith [hs.2]⟩
    have hB0 := abs_nonneg b0
    have hB2 := abs_nonneg b2
    fin_cases i
    · show |nPhiP5 B G γ (pulsePth5 B G γ ξ t) 0| ≤ _
      have := hbd t 0 (a0 - t * b0) b0 _ hU (fun s hs => by rw [(hD _ (hJ s hs)).1]; ring)
      linarith
    · show |nPhiP5 B G γ (pulsePth5 B G γ ξ t) 1| ≤ _
      have := hb1 t
      linarith
    · show |nPhiP5 B G γ (pulsePth5 B G γ ξ t) 2| ≤ _
      have := hbd t 2 (a2 - t * b2) b2 _ hU (fun s hs => by rw [(hD _ (hJ s hs)).2]; ring)
      linarith
  · refine ⟨∑ k : Fin 3, |nPhiP5 B G γ (pulsePth5 B G γ ξ 0) k|, fun t ht i => ?_⟩
    have hP0 : 0 ≤ ∑ k : Fin 3, |nPhiP5 B G γ (pulsePth5 B G γ ξ 0) k| :=
      Finset.sum_nonneg (fun k _ => abs_nonneg _)
    rcases eq_or_lt_of_le ht.1 with h0 | hpos
    · subst h0
      exact Finset.single_le_sum (f := fun k => |nPhiP5 B G γ (pulsePth5 B G γ ξ 0) k|)
        (fun k _ => abs_nonneg _) (Finset.mem_univ i)
    · have hV : Set.Ioo (-t) (3 * L / 2 - t) ∈ nhds (0:ℝ) :=
        Ioo_mem_nhds (by linarith) (by linarith [ht.2])
