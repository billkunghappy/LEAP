        (((hkd x).const_mul (4 + 2 * lam)).div (hp2 x) (pow_ne_zero 2 hx'))).const_mul 2).div_const
          DP).congr_deriv ?_
      simp only [hΦP]
      rw [Real.rpow_neg (by positivity : (0:ℝ) ≤ x ^ 2 / 2)]
      have hV : 0 < (x ^ 2 / 2) ^ (1/2 + lam) := by positivity
      have hV' : (x ^ 2 / 2) ^ (1/2 + lam) ≠ 0 := hV.ne'
      set V := (x ^ 2 / 2) ^ (1/2 + lam)
      field_simp
      ring
    · exact continuousOn_of_forall_continuousAt fun x hx => by
        have hx0 : 0 < x := by linarith [hx.1]
        simp only [hΦP]
        fun_prop (disch := first | assumption | positivity | exact Or.inl (by positivity))
    · exact continuousOn_of_forall_continuousAt fun x hx => by
        have hx0 : 0 < x := by linarith [hx.1]
        fun_prop (disch := first | assumption | positivity | exact Or.inl (by positivity))
    · simp [hk0 a (Or.inl hap), hk10 a (Or.inl hap)]
    · simp [hk0 b (Or.inr hqb), hk10 b (Or.inr hqb)]
    · show ∫ x in a..b, 4 * (4 + 2 * lam) * k x / x ^ 3 / DP = 1
      rw [intervalIntegral.integral_div, ← hDPdef, div_self hDP']

  · refine (master (fun x => 2 * (x ^ 2 / 2) ^ (-(1/2 + lam)) / x * ΦJ x) (fun _ => 0)
      (fun x => 2 * (x * deriv k x + (4 + 2 * lam) * k x) / CJ) ?_ ?_ ?_ ?_ ?_ ?_).trans (by simp)
    · intro x h; beta_reduce at h; exact hsJ x (right_ne_zero_of_mul h)
    · intro x hx
      have hx0 : 0 < x := by linarith [hx.1]
      have hx' : x ≠ 0 := hx0.ne'
      refine (((((hasDerivAt_id' x).mul (hk1d x)).add
        ((hkd x).const_mul (4 + 2 * lam))).const_mul 2).div_const CJ).congr_deriv ?_
      simp only [hΦJ]
      rw [Real.rpow_neg (by positivity : (0:ℝ) ≤ x ^ 2 / 2)]
      have hV : 0 < (x ^ 2 / 2) ^ (1/2 + lam) := by positivity
      have hV' : (x ^ 2 / 2) ^ (1/2 + lam) ≠ 0 := hV.ne'
      set V := (x ^ 2 / 2) ^ (1/2 + lam)
      field_simp
      ring
    · exact continuousOn_of_forall_continuousAt fun x hx => by
        have hx0 : 0 < x := by linarith [hx.1]
        simp only [hΦJ]
        fun_prop (disch := first | assumption | positivity | exact Or.inl (by positivity))
    · fun_prop
    · simp [hk0 a (Or.inl hap), hk10 a (Or.inl hap)]
    · simp [hk0 b (Or.inr hqb), hk10 b (Or.inr hqb)]

  · refine (master (fun x => x * (x ^ 2 / 2) ^ (-(1/2 + lam)) * ΦP x) (fun _ => 0)
      (fun x => (x * deriv k x + (2 + 2 * lam) * k x) / DP) ?_ ?_ ?_ ?_ ?_ ?_).trans (by simp)
    · intro x h; beta_reduce at h; exact hsP x (right_ne_zero_of_mul h)
    · intro x hx
      have hx0 : 0 < x := by linarith [hx.1]
      have hx' : x ≠ 0 := hx0.ne'
      refine ((((hasDerivAt_id' x).mul (hk1d x)).add
        ((hkd x).const_mul (2 + 2 * lam))).div_const DP).congr_deriv ?_
      simp only [hΦP]
      rw [Real.rpow_neg (by positivity : (0:ℝ) ≤ x ^ 2 / 2)]
      have hV : 0 < (x ^ 2 / 2) ^ (1/2 + lam) := by positivity
      have hV' : (x ^ 2 / 2) ^ (1/2 + lam) ≠ 0 := hV.ne'
      set V := (x ^ 2 / 2) ^ (1/2 + lam)
      field_simp
      ring
    · exact continuousOn_of_forall_continuousAt fun x hx => by
        have hx0 : 0 < x := by linarith [hx.1]
        simp only [hΦP]
        fun_prop (disch := first | assumption | positivity | exact Or.inl (by positivity))
    · fun_prop
    · simp [hk0 a (Or.inl hap), hk10 a (Or.inl hap)]
    · simp [hk0 b (Or.inr hqb), hk10 b (Or.inr hqb)]

  · refine (master (fun x => x * (x ^ 2 / 2) ^ (-(1/2 + lam)) * ΦJ x)
      (fun x => -(2 * (2 + 2 * lam)) * (x * k x) / CJ)
      (fun x => (x ^ 3 * deriv k x + (2 + 2 * lam) * (x ^ 2 * k x)) / CJ) ?_ ?_ ?_ ?_ ?_ ?_).trans ?_
    · intro x h; beta_reduce at h; exact hsJ x (right_ne_zero_of_mul h)
    · intro x hx
      have hx0 : 0 < x := by linarith [hx.1]
      have hx' : x ≠ 0 := hx0.ne'
      refine ((((hp3 x).mul (hk1d x)).add
        (((hp2 x).mul (hkd x)).const_mul (2 + 2 * lam))).div_const CJ).congr_deriv ?_
      simp only [hΦJ]
      rw [Real.rpow_neg (by positivity : (0:ℝ) ≤ x ^ 2 / 2)]
      have hV : 0 < (x ^ 2 / 2) ^ (1/2 + lam) := by positivity
      have hV' : (x ^ 2 / 2) ^ (1/2 + lam) ≠ 0 := hV.ne'
      set V := (x ^ 2 / 2) ^ (1/2 + lam)
      field_simp
      ring
    · exact continuousOn_of_forall_continuousAt fun x hx => by
        have hx0 : 0 < x := by linarith [hx.1]
        simp only [hΦJ]
        fun_prop (disch := first | assumption | positivity | exact Or.inl (by positivity))
    · fun_prop
    · simp [hk0 a (Or.inl hap), hk10 a (Or.inl hap)]
    · simp [hk0 b (Or.inr hqb), hk10 b (Or.inr hqb)]
    · show ∫ x in a..b, -(2 * (2 + 2 * lam)) * (x * k x) / CJ = 1
      rw [intervalIntegral.integral_div, intervalIntegral.integral_const_mul, ← hDJdef, ← hCJdef,
        div_self hCJ]

  · refine (master (fun x => x * Ψt x) (fun _ => 0)
      (fun x => x * k x / DT) ?_ ?_ ?_ ?_ ?_ ?_).trans (by simp)
    · intro x h; beta_reduce at h; exact hsΨt x (right_ne_zero_of_mul h)
    · intro x hx
      have hx0 : 0 < x := by linarith [hx.1]
      have hx' : x ≠ 0 := hx0.ne'
      refine (((hasDerivAt_id' x).mul (hkd x)).div_const DT).congr_deriv ?_
      simp only [hΨt, hΨd, hΨv]
      field_simp
      ring
    · exact continuousOn_of_forall_continuousAt fun x hx => by
        have hx0 : 0 < x := by linarith [hx.1]
        simp only [hΨt, hΨd, hΨv]
        fun_prop (disch := first | assumption | positivity | exact Or.inl (by positivity))
    · fun_prop
    · simp [hk0 a (Or.inl hap)]
    · simp [hk0 b (Or.inr hqb)]

  · refine (master (fun x => x ^ 2 * (x ^ 2 / 2) ^ (-(1/2 + lam)) * Ψt x)
      (fun x => 2 * lam * (x * (x ^ 2 / 2) ^ (-(1/2 + lam)) * k x) / DT)
      (fun x => x ^ 2 * (x ^ 2 / 2) ^ (-(1/2 + lam)) * k x / DT) ?_ ?_ ?_ ?_ ?_ ?_).trans ?_
    · intro x h; beta_reduce at h; exact hsΨt x (right_ne_zero_of_mul h)
    · intro x hx
      have hx0 : 0 < x := by linarith [hx.1]
      have hx' : x ≠ 0 := hx0.ne'
      refine ((((hp2 x).mul (hwd (-(1/2 + lam)) x hx0)).mul (hkd x)).div_const DT).congr_deriv ?_
      simp only [hΨt, hΨd, hΨv, Pi.mul_apply]
      set W := (x ^ 2 / 2) ^ (-(1/2 + lam))
      field_simp
      ring
    · exact continuousOn_of_forall_continuousAt fun x hx => by
        have hx0 : 0 < x := by linarith [hx.1]
        simp only [hΨt, hΨd, hΨv]
