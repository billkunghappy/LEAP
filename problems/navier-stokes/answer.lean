    intro X _ f J
    induction J with
    | zero => simp [telD]
    | succ J ih =>
      rw [Finset.sum_range_succ, ih]
      show f J + (f (J + 1) - f J) = f (J + 1)
      abel

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs0 : 0 < qsOf l0 := by rw [hQb]; positivity
  have hqsB : qsOf l0 ≤ qB := by
    rw [hQb]
