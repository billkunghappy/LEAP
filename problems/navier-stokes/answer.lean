  have hexpT : 3 ≤ Real.exp (1 + T) := by have := Real.add_one_le_exp (1 + T); linarith
  have h89 : 110 * (C * Pst) ^ 10 * Real.exp (-9) ≤ 110 * (C * Pst) ^ 10 * Real.exp (-8) :=
    mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by norm_num)) hXRpos.le
  have h5R : 110 * (C * Pst) ^ 10 * Real.exp (-5) ≤ 110 * (C * Pst) ^ 10 := by
