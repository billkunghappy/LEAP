    have hF0 : F' 0 = fun θ : ℝ => (inner ℝ (fderiv ℝ Wf (rotZ θ y) (rotZ θ v)) (rotZ θ c) : ℝ) := by
      funext θ; simp [hF']
    rw [hF0] at hint huniq
