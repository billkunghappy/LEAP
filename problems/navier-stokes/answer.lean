        intro Y
        have h := hsh x hx (Y - x.2.2.2)
        have e : ((x.1, x.2.1, x.2.2.1, Y) : Cyl) = shY x (Y - x.2.2.2) := by simp [shY]
        rw [e]; exact h
      have hφc : Continuous (fun Y : ℝ × ℝ => f (x.1, x.2.1, x.2.2.1, Y)) :=
