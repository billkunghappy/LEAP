theorem newton_commutator_pointwise : ∀ (χ b : ℝ³ → ℝ), ContDiff ℝ ∞ χ → ContDiff ℝ ∞ b → HasCompactSupport b → ∀ (i j : Fin 3) (x : ℝ³), ‖pd i (pd j (newtonPot (fun y => χ y * b y))) x - χ x * pd i (pd j (newtonPot b)) x‖ₑ ≤ ∫⁻ y, ENNReal.ofReal (Real.pi⁻¹ * (‖x - y‖⁻¹) ^ 3 * |χ y - χ x| * |b y|) :=
by



  have s1a : LocallyIntegrable newtonKernel volume := by
