  have ex0 : 2 * Aex B.h + 1/2 - (((0:ℕ):ℝ) + 1) / 2 = 2 * Aex B.h := by push_cast; ring
  have ex21 : 2 * Aex B.h - (((2:ℕ):ℝ) + 1) / 2 = 2 * Aex B.h - 3/2 := by push_cast; ring
  have ex22 : 2 * Aex B.h - (((1:ℕ):ℝ) + 1) / 2 = 2 * Aex B.h - 1 := by push_cast; ring
  have ex2g : 2 * Aex B.h + 1/2 - (((2:ℕ):ℝ) + 1) / 2 = 2 * Aex B.h - 1 := by push_cast; ring
  rw [ex0] at m0
