        show grP5 B G l0 S' η - grP5 B G l0 S η = 0
        rw [gvS' η hη hX, gvS η hη hX, sub_zero]
      · intro η _
        show grP5 B G l0 S' η = grP5 B G l0 S η + (grP5 B G l0 S' η - grP5 B G l0 S η)
        ring
    unfold calJz5
    rw [e1, e2]
    ring
  exact ⟨C1, C2, C3, C4, C5, C6, C7⟩

theorem wmo_state_grP_class_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (S : CState), InM B (qsOf l0) (9/10) (nrm B (Aex B.h) (mcor5 B G l0 S 1)) →
    InM B (qsOf l0) (9/10) (nrm B (Aex B.h) (mcor5 B G l0 S 2)) →
    InM B (qsOf l0) (19/10) (nrm B (Aex B.h) (mcor5 B G l0 S 0)) →
    (∀ a b : Fin 3, InM B (qsOf l0) 1 (nrm B (2 * Aex B.h) (Wcov5 B G l0 S a b))) →
    ∃ α : ℝ, InM B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) (grP5 B G l0 S)) :=
by
  intro B G hok
  have hh0 : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  have hSN : SimNorm B.h := simscale_normalized_v4 B.h hh0 hh1 hok.1
