    have hex1 : h / 10 * (J:ℝ) - L4 m ≤
        h * min (7/10 + (J:ℝ)/10) (min (7/10 + (J:ℝ)/10 + 1/2) (7/10 + (J:ℝ)/10 + 1/2)) - L4 m := by
      rw [hmin]; nlinarith
    have hex2 : h / 10 * (J:ℝ) - L4 m ≤ ((⌈h / 10 * (J:ℝ)⌉₊ : ℕ) : ℝ) := by
      have := Nat.le_ceil (h / 10 * (J:ℝ)); linarith [hL4 m]
    calc _ ≤ _ := hbd
      _ ≤ |C| * simScale h (x 2) (1 - t) ^ (h / 10 * (J:ℝ) - L4 m) +
            |C| * simScale h (x 2) (1 - t) ^ (h / 10 * (J:ℝ) - L4 m) :=
