  rw [heq]
  calc NB B.h (fun η => fderiv ℝ (fun η => nPhi5 B G γ η i) η (Lnorm B.h ξ w)) k ξ
      ≤ ‖w‖ * NB B.h (fun η => nPhi5 B G γ η i) (k + 1) ξ := nbdir B.h U ξ _ w hUo hξU (hn i) k
    _ ≤ NB B.h (fun η => nPhi5 B G γ η i) (k + 1) ξ := mul_le_of_le_one_left (norm_nonneg _) hw1
    _ ≤ C22 * SC B.h ξ := hC22 l0 (by omega) γ hA hlγ ξ hξ hq1 hq2 hX1 hX2 hxi het i
    _ ≤ |C22| * SC B.h ξ := mul_le_mul_of_nonneg_right (le_abs_self _) (by linarith)

theorem good_kmat_nb_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C : ℝ, ∀ (l0 : ℕ), l1 ≤ l0 → ∀ (γ : Lab), ActiveL4 B G γ → l0 ≤ γ.1 → ∀ ξ ∈ DomC B.h (qsOf l0), 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 → B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → ∀ i j : Fin 3, NB B.h (fun η : Cyl => Kmat B G γ η i j) k ξ ≤ C * SC B.h ξ :=
by
  intro B G hB hG
  obtain ⟨hΩo, hbase⟩ := geom_slow_base_smooth_v5 B hB
  obtain ⟨l12, h12⟩ := slow_profile_dir_nb_v5 B hB
  obtain ⟨l3, h3⟩ := chart_profile_nb_v5 B hB
  choose C12 hC12 using h12
  choose C3 hC3 using h3
  obtain ⟨-, -, -, -, -, -, -, hqB0, -⟩ := hB.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨l3 + l12 + n0, fun k => ?_⟩
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = ∑ j ∈ Finset.range (k + 1), (|C12 j| + |C3 j|) := ⟨_, rfl⟩
  have hA : ∀ j, j ≤ k → |C12 j| ≤ A ∧ |C3 j| ≤ A := by
    intro j hj
    have h := Finset.single_le_sum (s := Finset.range (k + 1)) (f := fun j => |C12 j| + |C3 j|)
      (fun i _ => by positivity) (Finset.mem_range.2 (by omega : j < k + 1))
    have h' : |C12 j| + |C3 j| ≤ A := by rw [hAdef]; exact h
    refine ⟨?_, ?_⟩ <;> linarith [abs_nonneg (C12 j), abs_nonneg (C3 j)]
  have hA0 : 0 ≤ A := by rw [hAdef]; exact Finset.sum_nonneg (fun i _ => by positivity)
  set W : ℝ := 4 * Real.sqrt B.Xb + 2 with hWdef
  have hW0 : 0 ≤ W := by positivity
  set Cf : ℝ := 3 * A + 2 ^ k * (W * A) with hCf
  have hWA : 0 ≤ 2 ^ k * (W * A) := by positivity
  refine ⟨Cf, ?_⟩
  intro l0 hl0 γ _hAct hlγ ξ hξl hwin1 hwin2 hX1 hX2 _hxi _het

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hξ : ξ ∈ DomC B.h B.qB := ⟨hξl.1, hξl.2.1, lt_of_lt_of_le hξl.2.2 hqsB⟩
  have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have hS1 : 1 ≤ SC B.h ξ := by
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hNBn : ∀ (f : Cyl → ℝ) (j : ℕ), 0 ≤ NB B.h f j ξ := fun f j => norm_nonneg _
  have hgerm : ∀ (f g : Cyl → ℝ) (U : Set Cyl), IsOpen U → ξ ∈ U → (∀ η ∈ U, f η = g η) →
      ∀ j, NB B.h f j ξ = NB B.h g j ξ := by
    intro f g U hU hξU hfg j
    unfold NB
    rw [((Filter.eventuallyEq_of_mem (hU.mem_nhds hξU) hfg).iteratedFDeriv ℝ j).eq_of_nhds]

  set Ω := {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} with hΩe
  have hsQ : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr hQ
  have hsl : ContDiff ℝ ∞ (fun η : Cyl => (η.1, η.2.1, η.2.2.1)) := by fun_prop
  have hDo : IsOpen (DomC B.h B.qB) := hΩo.preimage hsl.continuous
  have hcs : ∀ f : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ f Ω →
      ContDiffOn ℝ ∞ (fun η : Cyl => f (η.1, η.2.1, η.2.2.1)) (DomC B.h B.qB) :=
    fun f hf => hf.comp hsl.contDiffOn (fun η hη => hη)
  have hRC : ∀ s ∈ Ω, pcRC5 γ.1 s ≠ 0 := fun s hs => div_ne_zero (ne_of_gt hs.1) hsQ.ne'
  have hRCs : ContDiff ℝ ∞ (pcRC5 γ.1) := by unfold pcRC5; fun_prop
  have hb : ∀ i, ContDiffOn ℝ ∞ (pcB5 B γ.1 i) Ω := fun i => hbase γ.1 i
  have hFa : ContDiffOn ℝ ∞ (pcFa5 B γ.1) Ω := (hb 1).div hRCs.contDiffOn hRC
  have hD : ∀ f : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ f Ω → ∀ e : ℝ × ℝ × ℝ,
      ContDiffOn ℝ ∞ (fun s => fderiv ℝ f s e) Ω := by
    intro f hf e
    first
    | exact ((contDiffOn_infty_iff_fderiv_of_isOpen hΩo).1 hf).2.clm_apply contDiffOn_const
    | exact (hf.fderiv_of_isOpen hΩo (by simp)).clm_apply contDiffOn_const
  have hsmF : ∀ F : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F Ω → ∀ e : ℝ × ℝ × ℝ,
      ContDiffOn ℝ ∞ (fun η : Cyl => Real.sqrt (Qb γ.1) * fderiv ℝ F (η.1, η.2.1, η.2.2.1) e)
        (DomC B.h B.qB) :=
    fun F hF e => contDiffOn_const.mul (hcs _ (hD F hF e))

  have hlin : ∀ (U : Set Cyl) (f g : Cyl → ℝ), IsOpen U → ξ ∈ U → ContDiffOn ℝ ∞ f U →
      ContDiffOn ℝ ∞ g U → ∀ (a b : ℝ) (j : ℕ),
      NB B.h (fun η => a * f η + b * g η) j ξ ≤ |a| * NB B.h f j ξ + |b| * NB B.h g j ξ :=
    fun U f g hU hξU hf hg a b j => (nb_real_algebra_v5 B.h U ξ hU hξU f g hf hg j).2.1 a b
  have hconst : ∀ (a : ℝ) (j : ℕ), NB B.h (fun _ : Cyl => a) j ξ ≤ |a| := by
    intro a j
    have := (nb_real_algebra_v5 B.h _ ξ hDo hξ (fun _ => a) (fun _ => a) contDiffOn_const
      contDiffOn_const j).2.2 a
    split_ifs at this <;> linarith [abs_nonneg a]
  have hprod : ∀ (U : Set Cyl) (f g : Cyl → ℝ), IsOpen U → ξ ∈ U → ContDiffOn ℝ ∞ f U →
      ContDiffOn ℝ ∞ g U → ∀ X Y : ℝ, 0 ≤ X → (∀ j, j ≤ k → NB B.h f j ξ ≤ X) →
      (∀ j, j ≤ k → NB B.h g j ξ ≤ Y) → NB B.h (fun η => f η * g η) k ξ ≤ 2 ^ k * (X * Y) := by
    intro U f g hU hξU hf hg X Y hX hfX hgY
    refine ((nb_real_algebra_v5 B.h U ξ hU hξU f g hf hg k).1).trans ?_
    calc ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB B.h f i ξ * NB B.h g (k - i) ξ
        ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * X * Y := by
          apply Finset.sum_le_sum
          intro i hi
          have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have hc : (0:ℝ) ≤ (k.choose i : ℝ) := Nat.cast_nonneg _
          exact mul_le_mul (mul_le_mul_of_nonneg_left (hfX i hik) hc) (hgY (k - i) (by omega))
            (hNBn _ _) (mul_nonneg hc hX)
      _ = 2 ^ k * (X * Y) := by
          rw [← Finset.sum_mul, ← Finset.sum_mul]
          have : (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ)) = 2 ^ k := by
            exact_mod_cast Nat.sum_range_choose k
          rw [this]; ring

  have hl12 : l12 ≤ l0 := by omega
  have hl3 : l3 ≤ l0 := by omega
  have hFb : ∀ F : ℝ × ℝ × ℝ → ℝ, (F = pcFa5 B γ.1 ∨ F = pcB5 B γ.1 2) → ∀ j,
      NB B.h (fun η : Cyl => Real.sqrt (Qb γ.1) * fderiv ℝ F (η.1, η.2.1, η.2.2.1)
        ((1:ℝ), (0:ℝ), (0:ℝ))) j ξ ≤ |C12 j| := by
    intro F hF j
    exact (hC12 j γ.1 l0 hl12 hlγ ξ hξl hwin1 hwin2 hX1 hX2 F hF).1.trans (le_abs_self _)
  have hT : ∀ X : ℝ, 0 ≤ X → X ≤ Cf → X ≤ Cf * SC B.h ξ := by
    intro X hX0 hX; nlinarith

  have hKe : ∀ i j : Fin 3, NB B.h (fun η => Kmat B G γ η i j) k ξ =
      NB B.h (fun η : Cyl => pcKm5 B γ.1 (η.1, η.2.1, η.2.2.1) i j) k ξ :=
    fun i j => hgerm _ _ _ hDo hξ (fun η hη => by rw [kmat_slow_form_v5 B G γ hB η hη]) k
  have hFaS := hcs _ hFa
  have hFa0 : NB B.h (fun η : Cyl => pcFa5 B γ.1 (η.1, η.2.1, η.2.2.1)) k ξ ≤ A :=
    ((hC3 k γ.1 l0 hl3 hlγ ξ hξl hwin1 hwin2 hX1 hX2).1).trans
      ((le_abs_self _).trans (hA k le_rfl).2)
  have hDB := (hFb _ (Or.inr rfl) k).trans (hA k le_rfl).1
  have hRCS : ContDiffOn ℝ ∞ (fun η : Cyl => RC γ.1 η) (DomC B.h B.qB) := by unfold RC; fun_prop
  intro i j
  rw [hKe]
  fin_cases i <;> fin_cases j
  all_goals first
    | (show NB B.h (fun _ : Cyl => (0:ℝ)) k ξ ≤ _
       exact hT _ (hNBn _ _) ((hconst 0 k).trans (by rw [abs_zero]; positivity)))
    | (show NB B.h (fun η : Cyl => -2 * pcFa5 B γ.1 (η.1, η.2.1, η.2.2.1)) k ξ ≤ _
       rw [hgerm _ (fun η : Cyl => -2 * pcFa5 B γ.1 (η.1, η.2.1, η.2.2.1) + 0 * pcFa5 B γ.1 (η.1, η.2.1, η.2.2.1))
         _ hDo hξ (fun η _ => by ring) k]
       refine (hlin _ _ _ hDo hξ hFaS hFaS _ _ k).trans ?_
       rw [abs_zero, zero_mul, add_zero]
       refine hT _ (mul_nonneg (abs_nonneg _) (hNBn _ _)) ?_
       calc |(-2:ℝ)| * NB B.h (fun η : Cyl => pcFa5 B γ.1 (η.1, η.2.1, η.2.2.1)) k ξ ≤ 2 * A := by
             rw [abs_neg, abs_two]; linarith
         _ ≤ Cf := by rw [hCf]; linarith)
    | (show NB B.h (fun η : Cyl => Real.sqrt (Qb γ.1) *
          fderiv ℝ (pcB5 B γ.1 2) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))) k ξ ≤ _
       exact hT _ (hNBn _ _) (hDB.trans (by rw [hCf]; linarith)))
    | (show NB B.h (fun η : Cyl => 2 * pcFa5 B γ.1 (η.1, η.2.1, η.2.2.1) + pcRC5 γ.1 (η.1, η.2.1, η.2.2.1) *
          (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)))) k ξ ≤ _
       have hprd := hprod _ (fun η : Cyl => RC γ.1 η) (fun η : Cyl => Real.sqrt (Qb γ.1) *
           fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))) hDo hξ hRCS (hsmF _ hFa _)
         W A hW0 (fun j _ => rc_nb_v5 B hB γ.1 ξ hξl.1 hξl.2.1 hwin2 hX2 j)
         (fun j hj => (hFb _ (Or.inl rfl) j).trans (hA j hj).1)
       rw [hgerm _ (fun η : Cyl => 2 * pcFa5 B γ.1 (η.1, η.2.1, η.2.2.1) + 1 * (RC γ.1 η *
           (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)))))
         _ hDo hξ (fun η _ => by unfold pcRC5 RC; ring) k]
       refine (hlin _ _ _ hDo hξ hFaS (hRCS.mul (hsmF _ hFa _)) _ _ k).trans ?_
       rw [abs_two, abs_one, one_mul]
       refine hT _ (add_nonneg (mul_nonneg zero_le_two (hNBn _ _)) (hNBn _ _)) ?_
       rw [hCf]; nlinarith)

theorem pres_mult_coeffs_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ,
    ∃ C b : ℝ, ∀ (l0 : ℕ), l1 ≤ l0 → ∀ (γ : Lab) (m : ℤ), ActiveL4 B G γ → l0 ≤ γ.1 →
    ∀ ξ ∈ DomC B.h (qsOf l0), 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 →
    B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 →
    |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 →
    ContDiffAt ℝ ∞ (presMult5 B G γ m) ξ ∧
    NB B.h (presMult5 B G γ m) k ξ ≤ C * qC B.h ξ ^ (B.h * (1/2)) * SC B.h ξ ^ b ∧
    ∀ c : ℝ × ℝ, IsDeck B.h (qC B.h ξ) c → presMult5 B G γ m (shY ξ c) = presMult5 B G γ m ξ :=
by
  intro B G hB hG
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hB.2.1
  obtain ⟨l21, c0, hc0, H21⟩ := good_nsq_lower_v5 B G hB hG
  obtain ⟨l22, H22⟩ := good_nphi5_nb_v5 B G hB hG
  obtain ⟨l23, H23⟩ := good_nphiP5_nb_v5 B G hB hG
  obtain ⟨l24, H24⟩ := good_kmat_nb_v5 B G hB hG
  obtain ⟨l7, H7⟩ := band_coarse_gap_v5 B.h hh0 hh1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  choose C22 hC22 using H22
  choose C23 hC23 using H23
  choose C24 hC24 using H24
  refine ⟨l21 + l22 + l23 + l24 + l7 + n0, fun k => ?_⟩
  obtain ⟨D, hD⟩ : ∃ D : ℝ, D = ∑ j ∈ Finset.range (k + 1), (|C22 j| + |C23 j| + |C24 j|) := ⟨_, rfl⟩
  obtain ⟨C', hC'⟩ := nb_pres_quot_v5 k c0 D hc0
  refine ⟨12 * |C'|, ((2 * k + 2 : ℕ) : ℝ), ?_⟩
  intro l0 hl0 γ m hA hlγ ξ hξ hq1 hq2 hX1 hX2 hxi het

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hξB : ξ ∈ DomC B.h B.qB := ⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqsB⟩
  have hq0 : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).1
  have hS1 : 1 ≤ SC B.h ξ := by
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hQbpos : 0 < Qb γ.1 := by unfold Qb; positivity
  have hkb : 0 < kb B.h γ.1 := by
    unfold kb epsb Qb
    exact Nat.ceil_pos.mpr
      (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos two_pos _) _) _)
  have hkbR : (0:ℝ) < (kb B.h γ.1 : ℝ) := by exact_mod_cast hkb

  have hdeck : ∀ c : ℝ × ℝ, IsDeck B.h (qC B.h ξ) c →
      presMult5 B G γ m (shY ξ c) = presMult5 B G γ m ξ := by
    intro c' hc'
    have hgap := (H7 γ.1 l0 (qC B.h ξ) (by omega) hq0 hξ.2.2 hq1 hq2).1
    have hN := nPhi5_deck_v5 B G γ (coarseIdx B.h (qC B.h ξ)) c' hgap hc'
    obtain ⟨e, he⟩ : ∃ e : Cyl, e = ((0:ℝ), (0:ℝ), (0:ℝ), c') := ⟨_, rfl⟩
    have hsh : ∀ η : Cyl, shY η c' = η + e := by
      intro η
      rw [he]
      simp only [shY]
      ext <;> simp
    have hP : nPhiP5 B G γ (shY ξ c') = nPhiP5 B G γ ξ := by
      funext i
      simp only [nPhiP5, dV]
      have hF : (fun x => nPhi5 B G γ (x + e) i) = (fun x => nPhi5 B G γ x i) := by
        funext x
        rw [← hsh x, hN x]
      rw [hsh ξ, ← fderiv_comp_add_right]
      exact congrArg (fun g => fderiv ℝ g ξ (dVdir B.h γ.1)) hF
    have hK : Kmat B G γ (shY ξ c') = Kmat B G γ ξ := by
      rw [kmat_slow_form_v5 B G γ hB (shY ξ c') hξB, kmat_slow_form_v5 B G γ hB ξ hξB]
      rfl
    unfold presMult5
    rw [hN ξ, hK, hP]
  by_cases hm : m = 0
  ·
    have h0 : presMult5 B G γ m = fun _ => 0 := by
      funext η
      simp [presMult5, hm]
    have hz : NB B.h (fun _ : Cyl => (0 : Fin 3 → ℂ)) k ξ = 0 := by
      unfold NB
      rw [iteratedFDeriv_fun_zero]
      simp only [Pi.zero_apply]
      rw [show (ContinuousMultilinearMap.compContinuousLinearMap (0 : ContinuousMultilinearMap ℝ
          (fun _ : Fin k => Cyl) (Fin 3 → ℂ)) fun _ => Lnorm B.h ξ) = 0 from by ext; simp]
      exact norm_zero
    refine ⟨by rw [h0]; exact contDiffAt_const, ?_, hdeck⟩
    rw [h0, hz]
    exact mul_nonneg (mul_nonneg (by positivity) (Real.rpow_nonneg hq0.le _))
      (Real.rpow_nonneg (by linarith) _)

  obtain ⟨U, hUo, hξU, hUsub, hn, hp, hK⟩ := good_coeff_smooth_v5 B G γ ξ hB hξB hxi het
  have hpint : ((pint5 B G γ : ℤ) : ℝ) ≠ 0 := by
    have : pint5 B G γ ≠ 0 := by
      unfold pint5
      split_ifs with hr
      · norm_num
      · exact hr
    exact_mod_cast this
  have hn1 : ∀ η : Cyl, 0 < η.1 → nPhi5 B G γ η 1 ≠ 0 := by
    intro η hη
    show pang5 B G γ / RC γ.1 η ≠ 0
    exact div_ne_zero (div_ne_zero hpint hkbR.ne')
      (div_pos hη (Real.sqrt_pos.mpr hQbpos)).ne'
  have hnsq : ∀ η ∈ U, nPhi5 B G γ η 0 * nPhi5 B G γ η 0 + nPhi5 B G γ η 1 * nPhi5 B G γ η 1 +
      nPhi5 B G γ η 2 * nPhi5 B G γ η 2 ≠ 0 := by
    intro η hη
    have h1 := hn1 η (hUsub hη).1
    have h2 : 0 < nPhi5 B G γ η 1 * nPhi5 B G γ η 1 := mul_self_pos.mpr h1
    have h3 : 0 < nPhi5 B G γ η 0 * nPhi5 B G γ η 0 + nPhi5 B G γ η 1 * nPhi5 B G γ η 1 +
        nPhi5 B G γ η 2 * nPhi5 B G γ η 2 := by
      nlinarith [mul_self_nonneg (nPhi5 B G γ η 0), mul_self_nonneg (nPhi5 B G γ η 2)]
    exact h3.ne'
  obtain ⟨f, hf⟩ : ∃ f : Fin 3 → Cyl → ℝ, f = fun j η =>
      (nPhi5 B G γ η 0 * nPhi5 B G γ η 0 + nPhi5 B G γ η 1 * nPhi5 B G γ η 1 +
        nPhi5 B G γ η 2 * nPhi5 B G γ η 2)⁻¹ *
      (nPhi5 B G γ η 0 * Kmat B G γ η 0 j + nPhi5 B G γ η 1 * Kmat B G γ η 1 j +
        nPhi5 B G γ η 2 * Kmat B G γ η 2 j - nPhiP5 B G γ η j) := ⟨_, rfl⟩
  have hfs : ∀ j, ContDiffOn ℝ ∞ (f j) U := by
    intro j
    rw [hf]
    apply ContDiffOn.mul
    · exact ContDiffOn.inv ((((hn 0).mul (hn 0)).add ((hn 1).mul (hn 1))).add ((hn 2).mul (hn 2)))
        (fun η hη => hnsq η hη)
    · exact ((((hn 0).mul (hK 0 j)).add ((hn 1).mul (hK 1 j))).add ((hn 2).mul (hK 2 j))).sub (hp j)
  have hid : ∀ η, presMult5 B G γ m η =
      fun j => Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ)) * ((f j η : ℝ) : ℂ) := by
    intro η
    funext j
    rw [hf]
    simp only [presMult5, if_neg hm, Pi.smul_apply, smul_eq_mul, Pi.sub_apply, Matrix.vecMul,
      dotProduct, Fin.sum_univ_three]

  have hsmooth : ContDiffAt ℝ ∞ (presMult5 B G γ m) ξ := by
    rw [show presMult5 B G γ m = fun η j => Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ)) *
      ((f j η : ℝ) : ℂ) from funext hid]
    refine contDiffAt_pi.mpr (fun j => ?_)
    have hfj : ContDiffAt ℝ ∞ (f j) ξ := (hfs j).contDiffAt (hUo.mem_nhds hξU)
    have hof : ContDiffAt ℝ ∞ (fun η => ((f j η : ℝ) : ℂ)) ξ :=
      (Complex.ofRealCLM.contDiff.contDiffAt).comp ξ hfj
    exact contDiffAt_const.mul hof

  have hCD : ∀ j, j ≤ k → |C22 j| ≤ D ∧ |C23 j| ≤ D ∧ |C24 j| ≤ D := by
    intro j hj
    have hle : |C22 j| + |C23 j| + |C24 j| ≤ D := by
      rw [hD]
      exact Finset.single_le_sum (f := fun j => |C22 j| + |C23 j| + |C24 j|)
        (fun i _ => by positivity) (Finset.mem_range.mpr (by omega))
    refine ⟨?_, ?_, ?_⟩ <;>
      linarith [abs_nonneg (C22 j), abs_nonneg (C23 j), abs_nonneg (C24 j)]
  have hS0 : 0 ≤ SC B.h ξ := by linarith
  have hbd : ∀ j : ℕ, j ≤ k →
      (∀ i, NB B.h (fun η : Cyl => nPhi5 B G γ η i) j ξ ≤ D * SC B.h ξ) ∧
      (∀ i, NB B.h (fun η : Cyl => nPhiP5 B G γ η i) j ξ ≤ D * SC B.h ξ) ∧
      ∀ i i', NB B.h (fun η : Cyl => Kmat B G γ η i i') j ξ ≤ D * SC B.h ξ := by
    intro j hj
    refine ⟨fun i => ?_, fun i => ?_, fun i i' => ?_⟩
    · exact (hC22 j l0 (by omega) γ hA hlγ ξ hξ hq1 hq2 hX1 hX2 hxi het i).trans
        (mul_le_mul_of_nonneg_right ((le_abs_self _).trans (hCD j hj).1) hS0)
    · exact (hC23 j l0 (by omega) γ hA hlγ ξ hξ hq1 hq2 hX1 hX2 hxi het i).trans
        (mul_le_mul_of_nonneg_right ((le_abs_self _).trans (hCD j hj).2.1) hS0)
    · exact (hC24 j l0 (by omega) γ hA hlγ ξ hξ hq1 hq2 hX1 hX2 hxi het i i').trans
        (mul_le_mul_of_nonneg_right ((le_abs_self _).trans (hCD j hj).2.2) hS0)
  have hc0' : c0 ≤ nPhi5 B G γ ξ 0 * nPhi5 B G γ ξ 0 + nPhi5 B G γ ξ 1 * nPhi5 B G γ ξ 1 +
      nPhi5 B G γ ξ 2 * nPhi5 B G γ ξ 2 := by
    have := H21 l0 (by omega) γ hA hlγ ξ hξ hq1 hq2 hX1 hX2 hxi het
    simpa only [dotProduct, Fin.sum_univ_three] using this
  have hQ := hC' B.h (SC B.h ξ) U ξ (fun i η => nPhi5 B G γ η i) (fun i η => nPhiP5 B G γ η i)
    (fun i j η => Kmat B G γ η i j) hUo hξU hS1 hn hp hK hc0' hbd
  have hfj : ∀ j : Fin 3, NB B.h (f j) k ξ ≤ |C'| * SC B.h ξ ^ (2 * k + 2) := by
    intro j
    rw [hf]
    exact (hQ j).trans (mul_le_mul_of_nonneg_right (le_abs_self _) (pow_nonneg hS0 _))
  have hNBnn : ∀ j : Fin 3, 0 ≤ NB B.h (f j) k ξ := fun j => norm_nonneg _
  have hNBv := nb_vec_complex_v5 B.h U ξ (Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ))) f
    (presMult5 B G γ m) hUo hξU hfs (fun η _ => hid η) k
  rw [Fin.sum_univ_three] at hNBv
  have hcn : ‖Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ))‖ ≤ 4 * qC B.h ξ ^ (B.h * (1/2)) := by
    rw [norm_div, norm_mul, Complex.norm_I, Complex.norm_natCast, Complex.norm_intCast]
    have hm1 : (1:ℝ) ≤ |(m:ℝ)| := by
      rw [← Int.cast_abs]
      exact_mod_cast Int.one_le_abs hm
    have h1 : 1 / ((kb B.h γ.1 : ℝ) * |(m:ℝ)|) ≤ 1 / (kb B.h γ.1 : ℝ) :=
      one_div_le_one_div_of_le hkbR (by nlinarith)
    have hceil : (Qb γ.1 ^ B.h) ^ (-(1/2:ℝ)) ≤ (kb B.h γ.1 : ℝ) := Nat.le_ceil _
    have hε : 0 < Qb γ.1 ^ B.h := Real.rpow_pos_of_pos hQbpos _
    have h2 : 1 / (kb B.h γ.1 : ℝ) ≤ Qb γ.1 ^ (B.h * (1/2)) := by
      rw [Real.rpow_neg hε.le] at hceil
      rw [Real.rpow_mul hQbpos.le]
      have hp0 : 0 < (Qb γ.1 ^ B.h) ^ (1/2:ℝ) := Real.rpow_pos_of_pos hε _
      rw [div_le_iff₀ hkbR]
      calc (1:ℝ) = (Qb γ.1 ^ B.h) ^ (1/2:ℝ) * ((Qb γ.1 ^ B.h) ^ (1/2:ℝ))⁻¹ :=
            (mul_inv_cancel₀ hp0.ne').symm
        _ ≤ (Qb γ.1 ^ B.h) ^ (1/2:ℝ) * (kb B.h γ.1 : ℝ) := mul_le_mul_of_nonneg_left hceil hp0.le
    have hQ4 : Qb γ.1 < 4 * qC B.h ξ := by
      have := (lt_div_iff₀ hQbpos).mp hq1
      linarith
    have hexp0 : 0 ≤ B.h * (1/2) := mul_nonneg hh0.le (by norm_num)
    have h3 : Qb γ.1 ^ (B.h * (1/2)) ≤ (4 * qC B.h ξ) ^ (B.h * (1/2)) :=
      Real.rpow_le_rpow hQbpos.le hQ4.le hexp0
    have h4 : (4 * qC B.h ξ) ^ (B.h * (1/2)) = (4:ℝ) ^ (B.h * (1/2)) * qC B.h ξ ^ (B.h * (1/2)) :=
      Real.mul_rpow (by norm_num) hq0.le
    have h5 : (4:ℝ) ^ (B.h * (1/2)) ≤ 4 := by
      calc (4:ℝ) ^ (B.h * (1/2)) ≤ (4:ℝ) ^ (1:ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
        _ = 4 := Real.rpow_one 4
    have h6 : 0 ≤ qC B.h ξ ^ (B.h * (1/2)) := Real.rpow_nonneg hq0.le _
    calc 1 / ((kb B.h γ.1 : ℝ) * |(m:ℝ)|) ≤ 1 / (kb B.h γ.1 : ℝ) := h1
      _ ≤ Qb γ.1 ^ (B.h * (1/2)) := h2
      _ ≤ (4:ℝ) ^ (B.h * (1/2)) * qC B.h ξ ^ (B.h * (1/2)) := h4 ▸ h3
      _ ≤ 4 * qC B.h ξ ^ (B.h * (1/2)) := mul_le_mul_of_nonneg_right h5 h6
  have hsum : NB B.h (f 0) k ξ + NB B.h (f 1) k ξ + NB B.h (f 2) k ξ ≤
      3 * (|C'| * SC B.h ξ ^ (2 * k + 2)) := by
    linarith [hfj 0, hfj 1, hfj 2]
  have h4q : 0 ≤ 4 * qC B.h ξ ^ (B.h * (1/2)) := by
    have := Real.rpow_nonneg hq0.le (B.h * (1/2))
    linarith
  refine ⟨hsmooth, ?_, hdeck⟩
  calc NB B.h (presMult5 B G γ m) k ξ
      ≤ ‖Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ))‖ *
          (NB B.h (f 0) k ξ + NB B.h (f 1) k ξ + NB B.h (f 2) k ξ) := hNBv
    _ ≤ (4 * qC B.h ξ ^ (B.h * (1/2))) * (3 * (|C'| * SC B.h ξ ^ (2 * k + 2))) :=
        mul_le_mul hcn hsum (by linarith [hNBnn 0, hNBnn 1, hNBnn 2]) h4q
    _ = 12 * |C'| * qC B.h ξ ^ (B.h * (1/2)) * SC B.h ξ ^ (((2 * k + 2 : ℕ)) : ℝ) := by
        rw [Real.rpow_natCast]
        ring

theorem velRem5_contDiffOn_v5 : ∀ (B : BG) (qs : ℝ) (D : WC) (γ : Lab) (m : ℤ), B.ok →
    ContDiffOn ℝ ∞ (D γ m) (DomC B.h qs) → ContDiffOn ℝ ∞ (velRem5 B D γ m) (DomC B.h qs) :=
by
  intro B qs D γ m hok hD

  have hU : IsOpen (DomC B.h qs) := by
    have hO : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hO (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio qs := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hpos : ∀ η ∈ DomC B.h qs, 0 < η.1 := fun η hη => hη.1

  have hdir : ∀ (f : Cyl → ℂ) (v : Cyl → Cyl), ContDiffOn ℝ ∞ f (DomC B.h qs) →
      ContDiffOn ℝ ∞ v (DomC B.h qs) →
      ContDiffOn ℝ ∞ (fun η => fderiv ℝ f η (v η)) (DomC B.h qs) := by
    intro f v hf hv
    have hf' : ContDiffOn ℝ ∞ (fderiv ℝ f) (DomC B.h qs) :=
      hf.fderiv_of_isOpen hU (by exact_mod_cast le_top)
    exact hf'.clm_apply hv

  have hvR : ContDiffOn ℝ ∞ (fun η : Cyl => ((1 : ℝ), (0 : ℝ), (0 : ℝ),
      (drx B.h * η.1 ^ (drx B.h - 1)) • vrv)) (DomC B.h qs) := by
    have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ (drx B.h - 1)) (DomC B.h qs) :=
      (contDiffOn_fst (s := DomC B.h qs)).rpow_const_of_ne (fun η hη => (hpos η hη).ne')
    have h2 : ContDiffOn ℝ ∞ (fun η : Cyl => drx B.h * η.1 ^ (drx B.h - 1)) (DomC B.h qs) :=
      contDiffOn_const.mul h1
    have h3 : ContDiffOn ℝ ∞ (fun η : Cyl => (drx B.h * η.1 ^ (drx B.h - 1)) • vrv) (DomC B.h qs) :=
      h2.smul contDiffOn_const
    exact contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk h3))
  have hf : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => D γ m η i) (DomC B.h qs) :=
    fun i => contDiffOn_pi.1 hD i
  have hZ : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => dZ (fun η' => D γ m η' i) η) (DomC B.h qs) :=
    fun i => hdir _ (fun _ => ((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ))) (hf i) contDiffOn_const
  have hR : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => dR B.h (fun η' => D γ m η' i) η) (DomC B.h qs) :=
    fun i => hdir _ _ (hf i) hvR

  have hQ : 0 < Real.sqrt (Qb γ.1) :=
    Real.sqrt_pos.2 (Real.rpow_pos_of_pos (by norm_num) _)
  have hRCr : ContDiffOn ℝ ∞ (fun η : Cyl => RC γ.1 η) (DomC B.h qs) :=
    (contDiffOn_fst (s := DomC B.h qs)).div_const (Real.sqrt (Qb γ.1))
  have hRCc : ContDiffOn ℝ ∞ (fun η : Cyl => ((RC γ.1 η : ℝ) : ℂ)) (DomC B.h qs) := by
    have := Complex.ofRealCLM.contDiff.comp_contDiffOn hRCr
    exact this.congr (fun η _ => by simp)
  have hRCne : ∀ η ∈ DomC B.h qs, ((RC γ.1 η : ℝ) : ℂ) ≠ 0 := by
    intro η hη
    exact Complex.ofReal_ne_zero.2 (ne_of_gt (div_pos (hpos η hη) hQ))
  have hdiv : ContDiffOn ℝ ∞ (fun η => D γ m η 1 / ((RC γ.1 η : ℝ) : ℂ)) (DomC B.h qs) := by
    have := (hf 1).mul (hRCc.inv hRCne)
    exact this.congr (fun η _ => by simp [div_eq_mul_inv])

  have c0 : ContDiffOn ℝ ∞ (fun ξ => velRem5 B D γ m ξ 0) (DomC B.h qs) := by
    have := ((hZ 1).const_smul (Real.sqrt (Qb γ.1))).neg
    exact this.congr (fun ξ _ => by simp [velRem5, DzC])
  have c1 : ContDiffOn ℝ ∞ (fun ξ => velRem5 B D γ m ξ 1) (DomC B.h qs) := by
    have := ((hZ 0).const_smul (Real.sqrt (Qb γ.1))).sub ((hR 2).const_smul (Real.sqrt (Qb γ.1)))
    exact this.congr (fun ξ _ => by simp [velRem5, DzC, DrC])
  have c2 : ContDiffOn ℝ ∞ (fun ξ => velRem5 B D γ m ξ 2) (DomC B.h qs) := by
    have := ((hR 1).const_smul (Real.sqrt (Qb γ.1))).add hdiv
    exact this.congr (fun ξ _ => by simp [velRem5, DrC])
  refine contDiffOn_pi.2 (fun i => ?_)
  fin_cases i
  · exact c0
  · exact c1
  · exact c2

theorem deck_locally_stable_v5 : ∀ (B : BG) (l0 : ℕ), B.ok → 7 ≤ l0 → ∀ ξ ∈ DomC B.h (qsOf l0), ∀ a : ℝ × ℝ, IsDeck B.h (qC B.h ξ) a → ∀ᶠ η in nhds ξ, IsDeck B.h (qC B.h η) a :=
by
  intro B l0 hok hl0 ξ hξ a ha

  have hs : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
  have hs2 : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
  have hL : Lgc ≠ 0 := by unfold Lgc; intro h0; linarith
  have hT : Tgc ≠ 0 := by unfold Tgc; intro h0; linarith
  have hN : (1 + bgc ^ 2) ≠ 0 := by positivity
  have c1 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).1 = Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) * bgc := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have c2 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).2 = -(Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) * bgc) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have hcomp : ∀ (m n : ℤ) (Y : ℝ × ℝ), Jpow m (Jpow n Y) = Jpow (m + n) Y := by
    intro m n Y
    refine Prod.ext ?_ ?_
    · rw [c1 m, c1 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
      field_simp
      ring
    · rw [c2 m, c2 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
      field_simp
      ring
  have hid : ∀ Y : ℝ × ℝ, Jpow 0 Y = Y := by
    intro Y
    refine Prod.ext ?_ ?_
    · rw [c1, zpow_zero, zpow_zero]
      field_simp
      ring
    · rw [c2, zpow_zero, zpow_zero]
      field_simp
      ring
  have hNinv : ∀ x : ℝ, x / (1 + bgc ^ 2) = x * (2 + Real.sqrt 2) / 4 := by
    intro x
    rw [div_eq_div_iff hN (by norm_num)]
    unfold bgc
    linear_combination (-x * Real.sqrt 2) * hs
  have hJ1 : ∀ Y : ℝ × ℝ, Jpow 1 Y = (3 * Y.1 + Y.2, Y.1 + 5 * Y.2) := by
    intro Y
    refine Prod.ext ?_ ?_
    · rw [c1, zpow_one, zpow_one, hNinv, hNinv]
      unfold Lgc Tgc bgc
      linear_combination ((Real.sqrt 2 ^ 2 + 4 * Real.sqrt 2 - 2) * Y.1 + 2 * (Real.sqrt 2 + 1) * Y.2) / 4 * hs
    · rw [c2, zpow_one, zpow_one, hNinv, hNinv]
      unfold Lgc Tgc bgc
      linear_combination (2 * (Real.sqrt 2 + 1) * Y.1 - (Real.sqrt 2 ^ 2 - 4 * Real.sqrt 2 - 2) * Y.2) / 4 * hs
  have hint : ∀ k : ℕ, ∀ i j : ℤ, ∃ i' j' : ℤ,
      Jpow (k : ℤ) ((i : ℝ), (j : ℝ)) = ((i' : ℝ), (j' : ℝ)) := by
    intro k
    induction k with
    | zero => intro i j; exact ⟨i, j, by rw [Nat.cast_zero, hid]⟩
    | succ k ih =>
      intro i j
      obtain ⟨i', j', h'⟩ := ih i j
      refine ⟨3 * i' + j', i' + 5 * j', ?_⟩
      have e : ((k + 1 : ℕ) : ℤ) = 1 + (k : ℤ) := by push_cast; ring
      rw [e, ← hcomp 1 k, h', hJ1]
      push_cast
      rfl
  have hup : ∀ (c d : ℤ), c ≤ d → (∃ n m : ℤ, Jpow c a = ((n:ℝ), (m:ℝ))) →
      ∃ n m : ℤ, Jpow d a = ((n:ℝ), (m:ℝ)) := by
    intro c d hcd hc
    obtain ⟨a0, b0, hab⟩ := hc
    obtain ⟨k, hk⟩ := Int.le.dest hcd
    obtain ⟨a1, b1, hJk'⟩ := hint k a0 b0
    refine ⟨a1, b1, ?_⟩
    have hJk : Jpow d a = Jpow (k : ℤ) (Jpow c a) := by
      rw [hcomp, ← hk, add_comm]
    rw [hJk, hab, hJk']

  have hh0 : 0 < B.h := hok.2.1.1
  have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hT1 : 1 < Tgc := by unfold Tgc; nlinarith
  have hlT0 : 0 < Real.log Tgc := Real.log_pos hT1
  obtain ⟨φ, hφ⟩ : ∃ φ : ℕ → ℝ, φ = fun l : ℕ => (1 + B.h) * (l:ℝ) * Real.log 2 - 2 * Real.log (l:ℝ) :=
    ⟨_, rfl⟩
  have hφv : ∀ l : ℕ, φ l = (1 + B.h) * (l:ℝ) * Real.log 2 - 2 * Real.log (l:ℝ) := fun l => by rw [hφ]
  have hφdef : ∀ l : ℕ, 1 ≤ l → bandIdx B.h l = ⌊φ l / Real.log Tgc⌋ := by
    intro l hl
    have hl0 : (0:ℝ) < l := by exact_mod_cast hl
    unfold bandIdx
    congr 1
    unfold Real.logb
    rw [hφv, Real.log_div (Real.rpow_pos_of_pos two_pos _).ne' (pow_pos hl0 2).ne',
      Real.log_rpow two_pos, Real.log_pow]
    push_cast; ring
  have hstep : ∀ m : ℕ, 3 ≤ m → φ m ≤ φ (m+1) := by
    intro m hm
    have hm3 : (3:ℝ) ≤ m := by exact_mod_cast hm
    have hm0 : (0:ℝ) < m := by linarith
    have hsq : ((m:ℝ) + 1) ^ 2 ≤ 2 * (m:ℝ) ^ 2 := by nlinarith
    have hlog := Real.log_le_log (by positivity) hsq
    rw [Real.log_mul (by norm_num) (by positivity), Real.log_pow, Real.log_pow] at hlog
    rw [hφv, hφv]
    push_cast at hlog ⊢
    nlinarith [mul_pos hh0 hl2]
  have hmono : ∀ a b : ℕ, 3 ≤ a → a ≤ b → φ a ≤ φ b := by
    intro a b ha hab
    induction b, hab using Nat.le_induction with
    | base => exact le_rfl
    | succ n hn ih => exact ih.trans (hstep n (le_trans ha hn))
  have hbmono : ∀ a b : ℕ, 3 ≤ a → a ≤ b → bandIdx B.h a ≤ bandIdx B.h b := by
    intro a b ha hab
    rw [hφdef a (by omega), hφdef b (by omega)]
    exact Int.floor_mono (div_le_div_of_nonneg_right (hmono a b ha hab) hlT0.le)
  have hbof : ∀ p : ℝ, 0 < p → bandOf p = ⌈-Real.log p / Real.log 2⌉₊ := by
    intro p hp
    unfold bandOf Real.logb
    rw [one_div, Real.log_inv]

  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have hq7 : qC B.h ξ < (2:ℝ) ^ (-(7:ℝ)) := by
    have e : qsOf l0 = (2:ℝ) ^ (-(l0:ℝ)) := rfl
    have h7 : (7:ℝ) ≤ l0 := by exact_mod_cast hl0
    have : (2:ℝ) ^ (-(l0:ℝ)) ≤ (2:ℝ) ^ (-(7:ℝ)) :=
      Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
    rw [e] at hξ'
    linarith [hξ'.2.2]
  have hlq7 : Real.log (qC B.h ξ) < -7 * Real.log 2 := by
    have := Real.log_lt_log hq0 hq7
    rw [Real.log_rpow two_pos] at this; linarith
  obtain ⟨l', hl'⟩ : ∃ l' : ℕ, l' = bandOf (qC B.h ξ) := ⟨_, rfl⟩
  have hx7 : 7 < -Real.log (qC B.h ξ) / Real.log 2 := by rw [lt_div_iff₀ hl2]; linarith
  have hle : -Real.log (qC B.h ξ) / Real.log 2 ≤ l' := by
    rw [hl', hbof _ hq0]; exact Nat.le_ceil _
  have hlt : (l':ℝ) < -Real.log (qC B.h ξ) / Real.log 2 + 1 := by
    rw [hl', hbof _ hq0]; exact Nat.ceil_lt_add_one (by linarith)
  have hu2 : ((l':ℝ) - 1) * Real.log 2 < -Real.log (qC B.h ξ) := by
    have : (l':ℝ) - 1 < -Real.log (qC B.h ξ) / Real.log 2 := by linarith
    exact (lt_div_iff₀ hl2).mp this
  have hl'8 : 8 ≤ l' := by
    have h7 : (7:ℝ) < l' := lt_of_lt_of_le hx7 hle
    have h7' : 7 < l' := by exact_mod_cast h7
    omega
  have hpow : 0 < (2:ℝ) ^ (-((l':ℝ) - 1)) := Real.rpow_pos_of_pos two_pos _
  have hqlt : qC B.h ξ < (2:ℝ) ^ (-((l':ℝ) - 1)) := by
    rw [← Real.log_lt_log_iff hq0 hpow, Real.log_rpow two_pos]; linarith
  have hloc : ∀ q' : ℝ, 0 < q' → q' < (2:ℝ) ^ (-((l':ℝ) - 1)) →
      coarseIdx B.h (qC B.h ξ) ≤ coarseIdx B.h q' := by
    intro q' hq'0 hq'lt
    have hlog' : Real.log q' < -((l':ℝ) - 1) * Real.log 2 := by
      have := Real.log_lt_log hq'0 hq'lt
      rwa [Real.log_rpow two_pos] at this
    have hx' : ((l' - 1 : ℕ) : ℝ) < -Real.log q' / Real.log 2 := by
      rw [Nat.cast_sub (by omega), lt_div_iff₀ hl2]; push_cast; linarith
    have hb' : l' ≤ bandOf q' := by
      have := Nat.lt_ceil.mpr hx'
      rw [← hbof q' hq'0] at this; omega
    have e1 : coarseIdx B.h (qC B.h ξ) = bandIdx B.h (l' - 4) := by unfold coarseIdx; rw [← hl']
    have e2 : coarseIdx B.h q' = bandIdx B.h (bandOf q' - 4) := rfl
    rw [e1, e2]
    exact hbmono (l' - 4) (bandOf q' - 4) (by omega) (by omega)

  have hO : IsOpen ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) :=
    (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
  have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
    hok.1.2.2.2.1.continuousOn
  have hφc : Continuous (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by fun_prop
  have hmaps : Set.MapsTo (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ))
      ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
    intro η hη
    have h' : η.2.2.1 < 1 := hη.2
    exact ⟨mem_univ _, show (0:ℝ) < 1 - η.2.2.1 by linarith⟩
  have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
      (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)))
      ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) := h4'.comp hφc.continuousOn hmaps
  have hcont : ContinuousOn (qC B.h) ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) := hc
  have hξO : ξ ∈ ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) := ⟨hξ'.1, hξ'.2.1⟩
  have hcA : ContinuousAt (qC B.h) ξ := hcont.continuousAt (hO.mem_nhds hξO)
  have E1 : ∀ᶠ η in nhds ξ, qC B.h η < (2:ℝ) ^ (-((l':ℝ) - 1)) :=
    hcA.eventually (gt_mem_nhds hqlt)
  have E2 : ∀ᶠ η in nhds ξ, η ∈ ({η : Cyl | 0 < η.1} ∩ {η : Cyl | η.2.2.1 < 1}) :=
    hO.mem_nhds hξO
  filter_upwards [E1, E2] with η h1 h2
  have h2' : η.2.2.1 < 1 := h2.2
  have hqη : 0 < qC B.h η := (hok.1.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  exact hup _ _ (hloc _ hqη h1) ha

theorem velRem5_deck_invariant_v5 : ∀ (B : BG) (l0 : ℕ) (D : WC), B.ok → 7 ≤ l0 →
    (∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ∀ c : ℝ × ℝ, IsDeck B.h (qC B.h ξ) c →
      D γ m (shY ξ c) = D γ m ξ) →
    ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ∀ c : ℝ × ℝ, IsDeck B.h (qC B.h ξ) c →
      velRem5 B D γ m (shY ξ c) = velRem5 B D γ m ξ :=
by
  intro B l0 D hok hl0 hD γ m ξ hξ c hc

  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc' : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc'
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'

  have hloc : ∀ᶠ η in nhds ξ, D γ m (shY η c) = D γ m η := by
    filter_upwards [hDopen.mem_nhds hξ, deck_locally_stable_v5 B l0 hok hl0 ξ hξ c hc] with η hη hdη
    exact hD γ m η hη c hdη

  obtain ⟨e, he⟩ : ∃ e : Cyl, e = ((0:ℝ), (0:ℝ), (0:ℝ), c) := ⟨_, rfl⟩
  have hsh : ∀ η : Cyl, shY η c = η + e := by
    intro η
    rw [he]
    simp only [shY]
    ext <;> simp

  have hfd : ∀ i : Fin 3, fderiv ℝ (fun η => D γ m η i) (shY ξ c) =
      fderiv ℝ (fun η => D γ m η i) ξ := by
    intro i
    have hev : (fun x => D γ m (x + e) i) =ᶠ[nhds ξ] (fun η => D γ m η i) :=
      hloc.mono (fun η hη => by
        show D γ m (η + e) i = D γ m η i
        rw [← hsh η, hη])
    rw [hsh ξ, ← fderiv_comp_add_right]
    exact hev.fderiv_eq
  have hD1 : D γ m (shY ξ c) 1 = D γ m ξ 1 := congrFun (hD γ m ξ hξ c hc) 1
  have hz : ∀ i : Fin 3, DzC B γ.1 (fun η => D γ m η i) (shY ξ c) =
      DzC B γ.1 (fun η => D γ m η i) ξ := by
    intro i
    unfold DzC dZ
    rw [hfd i]
  have hr : ∀ i : Fin 3, DrC B γ.1 (fun η => D γ m η i) (shY ξ c) =
      DrC B γ.1 (fun η => D γ m η i) ξ := by
    intro i
    unfold DrC dR
    rw [hfd i]
    try rfl
  have hRC : RC γ.1 (shY ξ c) = RC γ.1 ξ := rfl
  simp only [velRem5]
  rw [hz 0, hz 1, hr 1, hr 2, hD1, hRC]

theorem velRem5_nb_pointwise_v5 : ∀ (B : BG), B.ok → ∀ k : ℕ, ∃ K : ℝ, ∀ (qs : ℝ) (D : WC) (γ : Lab) (m : ℤ)
    (ξ : Cyl), qs ≤ 1/128 → ContDiffOn ℝ ∞ (D γ m) (DomC B.h qs) →
    ContDiffOn ℝ ∞ (velRem5 B D γ m) (DomC B.h qs) → ξ ∈ DomC B.h qs →
    1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
    NB B.h (velRem5 B D γ m) k ξ ≤
      K * qC B.h ξ ^ (-(B.h * kapS)) * ∑ i ∈ Finset.range (k + 2), NB B.h (D γ m) i ξ :=
by
  intro B hok k
  have hh0 : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have key : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (F : E → G) (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]
  have nbdir : ∀ (U : Set Cyl) (ξ : Cyl) (F : Cyl → ℂ) (w : Cyl), IsOpen U → ξ ∈ U →
      ContDiffOn ℝ ∞ F U → ∀ k : ℕ,
      NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ w)) k ξ ≤ ‖w‖ * NB B.h F (k + 1) ξ := by
    intro U ξ F w hU hξ hF k
    have hFd : ContDiffAt ℝ ∞ (fderiv ℝ F) ξ :=
      (hF.fderiv_of_isOpen hU (by exact_mod_cast le_top)).contDiffAt (hU.mem_nhds hξ)
    have hcomp : (fun η => fderiv ℝ F η (Lnorm B.h ξ w)) =
        (ContinuousLinearMap.apply ℝ ℂ (Lnorm B.h ξ w)) ∘ (fderiv ℝ F) := by
      funext η; rfl
    have hit : iteratedFDeriv ℝ k (fun η => fderiv ℝ F η (Lnorm B.h ξ w)) ξ =
        (ContinuousLinearMap.apply ℝ ℂ (Lnorm B.h ξ w)).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fderiv ℝ F) ξ) := by
      rw [hcomp]
      exact ContinuousLinearMap.iteratedFDeriv_comp_left _ hFd (by exact_mod_cast le_top)
    have hNB0 : 0 ≤ NB B.h F (k + 1) ξ := norm_nonneg _
    unfold NB
    rw [hit]
    apply ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg (norm_nonneg _) hNB0)
    intro m
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      ContinuousLinearMap.apply_apply]
    have key2 : (iteratedFDeriv ℝ k (fderiv ℝ F) ξ (fun i => Lnorm B.h ξ (m i))) (Lnorm B.h ξ w) =
        ((iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ))
          (Fin.snoc (α := fun _ => Cyl) m w) := by
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_succ_apply_right]
      have e1 : Fin.init (fun i : Fin (k+1) => Lnorm B.h ξ (Fin.snoc (α := fun _ => Cyl) m w i)) =
          fun i => Lnorm B.h ξ (m i) := by
        funext i
        simp [Fin.init, Fin.snoc_castSucc]
      rw [e1]
      simp only [Fin.snoc_last]
    rw [key2]
    have hprod : ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ =
        (∏ i : Fin k, ‖m i‖) * ‖w‖ := by
      rw [Fin.prod_univ_castSucc]
      simp [Fin.snoc_castSucc, Fin.snoc_last]
    calc _ ≤ ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ *
          ∏ i : Fin (k+1), ‖Fin.snoc (α := fun _ => Cyl) m w i‖ :=
          ContinuousMultilinearMap.le_opNorm _ _
      _ = ‖w‖ * ‖(iteratedFDeriv ℝ (k+1) F ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ *
          ∏ i : Fin k, ‖m i‖ := by rw [hprod]; ring
  have leibS : ∀ (U : Set Cyl), IsOpen U → ∀ (a : Cyl → ℝ) (g : Cyl → ℂ), ContDiffOn ℝ ∞ a U →
      ContDiffOn ℝ ∞ g U → ∀ ξ ∈ U, ∀ k : ℕ, NB B.h (fun η => a η • g η) k ξ ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB B.h a i ξ * NB B.h g (k - i) ξ := by
    intro U hU a g ha hg ξ hξ k
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑(Lnorm B.h ξ) ⁻¹' s) := hs.preimage (Lnorm B.h ξ).continuous
    have h0O : (0 : Cyl) ∈ ⇑(Lnorm B.h ξ) ⁻¹' s := by
      show Lnorm B.h ξ 0 ∈ s
      rw [map_zero, hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hsmO : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : Cyl → V),
        ContDiffOn ℝ ∞ F U → ContDiffOn ℝ ∞ (fun z => F (ξ + Lnorm B.h ξ z)) (⇑(Lnorm B.h ξ) ⁻¹' s) := by
      intro V _ _ F hF
      exact hF.comp ((contDiff_const.add (Lnorm B.h ξ).contDiff).contDiffOn)
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hag : ContDiffOn ℝ ∞ (fun η => a η • g η) U := ha.smul hg
    have leib := norm_iteratedFDerivWithin_smul_le (hsmO a ha) (hsmO g hg) hO.uniqueDiffOn h0O
      (n := k) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => a (ξ + Lnorm B.h ξ y) • g (ξ + Lnorm B.h ξ y))
      k hO h0O] at leib
    unfold NB
    rw [← key _ U ξ (Lnorm B.h ξ) hU hag hξ k]
    calc ‖iteratedFDeriv ℝ k (fun z => (fun η => a η • g η) (ξ + Lnorm B.h ξ z)) 0‖
        = ‖iteratedFDeriv ℝ k (fun y => a (ξ + Lnorm B.h ξ y) • g (ξ + Lnorm B.h ξ y)) 0‖ := rfl
      _ ≤ _ := leib
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i _
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => a (ξ + Lnorm B.h ξ z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + Lnorm B.h ξ z)) (k - i) hO h0O,
          key a U ξ (Lnorm B.h ξ) hU ha hξ i, key g U ξ (Lnorm B.h ξ) hU hg hξ (k - i)]
  have radial : ∀ (c p : ℝ) (ξ : Cyl) (j : ℕ), 0 < ξ.1 →
      NB B.h (fun η : Cyl => c * η.1 ^ p) j ξ ≤
        |c| * |Polynomial.eval p (descPochhammer ℝ j)| * ξ.1 ^ (p - j) * Real.sqrt (qC B.h ξ) ^ j := by
    intro c p ξ j hr
    obtain ⟨φ, hφ⟩ : ∃ φ : ℝ → ℝ, φ = fun x => c * x ^ p := ⟨_, rfl⟩
    have hφS : ContDiffOn ℝ ∞ φ (Ioi 0) := by
      rw [hφ]
      exact contDiffOn_const.mul (contDiffOn_id.rpow_const_of_ne (fun x hx => ne_of_gt hx))
    obtain ⟨π, hπ⟩ : ∃ π : Cyl →L[ℝ] ℝ, π = ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)) := ⟨_, rfl⟩
    obtain ⟨s, hs⟩ : ∃ s : ℝ, s = Real.sqrt (qC B.h ξ) := ⟨_, rfl⟩
    have hs0 : 0 ≤ s := by rw [hs]; exact Real.sqrt_nonneg _
    obtain ⟨V, hV⟩ : ∃ V : Set Cyl, V = Prod.fst ⁻¹' (Ioi (0:ℝ)) := ⟨_, rfl⟩
    have hVo : IsOpen V := by rw [hV]; exact isOpen_Ioi.preimage continuous_fst
    have hξV : ξ ∈ V := by rw [hV]; exact hr
    have hFV : ContDiffOn ℝ ∞ (fun η : Cyl => φ η.1) V := by
      rw [hV]
      exact hφS.comp contDiff_fst.contDiffOn (fun η hη => hη)
    have hfunEq : (fun z : Cyl => (fun η : Cyl => φ η.1) (ξ + Lnorm B.h ξ z)) =
        (fun z : Cyl => φ (ξ.1 + (s • π) z)) := by
      funext z
      have h1 : (ξ + Lnorm B.h ξ z).1 = ξ.1 + (s • π) z := by
        rw [hπ, hs]; simp [Lnorm]
      show φ (ξ + Lnorm B.h ξ z).1 = _
      rw [h1]
    have e1 := key (fun η : Cyl => φ η.1) V ξ (Lnorm B.h ξ) hVo hFV hξV j
    have e2 := key φ (Ioi 0) ξ.1 (s • π) isOpen_Ioi hφS hr j
    have hNBeq : NB B.h (fun η : Cyl => φ η.1) j ξ =
        ‖(iteratedFDeriv ℝ j φ ξ.1).compContinuousLinearMap (fun _ => s • π)‖ := by
      unfold NB
      rw [← e1, hfunEq, e2]
    have hπ1 : ‖π‖ ≤ 1 := by
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
      rw [hπ]
      show ‖η.1‖ ≤ 1 * ‖η‖
      rw [one_mul]
      exact norm_fst_le η
    have hn : ‖s • π‖ ≤ s := by
      rw [norm_smul, Real.norm_of_nonneg hs0]
      exact mul_le_of_le_one_right hs0 hπ1
    have hprod : ∏ _i : Fin j, ‖s • π‖ ≤ s ^ j := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_pow_left₀ (norm_nonneg _) hn j
    have hd : ‖iteratedFDeriv ℝ j φ ξ.1‖ =
        |c| * |Polynomial.eval p (descPochhammer ℝ j)| * ξ.1 ^ (p - j) := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, hφ,
        iteratedDeriv_const_mul c (Real.contDiffAt_rpow_const_of_ne hr.ne'),
        iteratedDeriv_eq_iterate, Real.iter_deriv_rpow_const, abs_mul, abs_mul,
        abs_of_pos (Real.rpow_pos_of_pos hr _), mul_assoc]
    have hNB' : NB B.h (fun η : Cyl => c * η.1 ^ p) j ξ = NB B.h (fun η : Cyl => φ η.1) j ξ := by
      rw [hφ]
    rw [hNB', hNBeq]
    refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
    rw [hd, ← hs]
    exact mul_le_mul_of_nonneg_left hprod (by positivity)
  have comp : ∀ (F : Cyl → (Fin 3 → ℂ)) (ξ : Cyl) (k : ℕ), ContDiffAt ℝ ∞ F ξ →
      NB B.h F k ξ ≤ ∑ i : Fin 3, NB B.h (fun η => F η i) k ξ := by
    intro F ξ k hF
    have hc : ∀ i : Fin 3, (iteratedFDeriv ℝ k (fun η => F η i) ξ).compContinuousLinearMap
