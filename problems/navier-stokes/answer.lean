          rw [div_div]; ring

  rw [hsplit]
  calc |∑ k, ∑ l, ∫ u, ρ u * pd i (pd k (pd l (newtonPot (G k l)))) (x + L • u)|
      ≤ ∑ k, |∑ l, ∫ u, ρ u * pd i (pd k (pd l (newtonPot (G k l)))) (x + L • u)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ k, ∑ l, |∫ u, ρ u * pd i (pd k (pd l (newtonPot (G k l)))) (x + L • u)| :=
        Finset.sum_le_sum (fun k _ => Finset.abs_sum_le_sum_abs _ _)
    _ ≤ ∑ k, ∑ l, M * CK * (∫ y, |G k l y|) / L ^ 4 :=
        Finset.sum_le_sum (fun k _ => Finset.sum_le_sum (fun l _ => hterm k l))
    _ = M * CK * (∑ k, ∑ l, ∫ y, |G k l y|) / L ^ 4 := by
        simp only [Finset.mul_sum, Finset.sum_div]

theorem mollifier_time_deriv : ∀ (T₁ L : ℝ) (x : ℝ³) (ρ : ℝ³ → ℝ) (W : ℝ³ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿W) (univ ×ˢ Icc 0 T₁) → Continuous ρ → (∀ z : ℝ³, 1 ≤ ‖z‖ → ρ z = 0) → ∀ t ∈ Ioo 0 T₁, HasDerivAt (fun s => ∫ u, ρ u * W (x + L • u) s) (∫ u, ρ u * deriv (fun s => W (x + L • u) s) t) t ∧ Continuous (fun u => ρ u * deriv (fun s => W (x + L • u) s) t) :=
by
  intro T₁ L x ρ W hW hρ hρ1 t ht
  have hO : IsOpen ((univ : Set ℝ³) ×ˢ Ioo (0:ℝ) T₁) := isOpen_univ.prod isOpen_Ioo
  have hOS : (univ : Set ℝ³) ×ˢ Ioo (0:ℝ) T₁ ⊆ univ ×ˢ Icc 0 T₁ :=
    prod_mono subset_rfl Ioo_subset_Icc_self
  have hWO : ContDiffOn ℝ ∞ (↿W) ((univ : Set ℝ³) ×ˢ Ioo (0:ℝ) T₁) := hW.mono hOS
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ³ × ℝ → ℝ, D = fun z => fderiv ℝ (↿W) z ((0:ℝ³), (1:ℝ)) :=
    ⟨_, rfl⟩
  have hDc : ContinuousOn D ((univ : Set ℝ³) ×ˢ Ioo (0:ℝ) T₁) := by
    rw [hDdef]
    exact (hWO.continuousOn_fderiv_of_isOpen hO (by simp)).clm_apply continuousOn_const
  have hder : ∀ y : ℝ³, ∀ s ∈ Ioo (0:ℝ) T₁, HasDerivAt (fun r => W y r) (D (y, s)) s := by
    intro y s hs
    have hmem : (y, s) ∈ (univ : Set ℝ³) ×ˢ Ioo (0:ℝ) T₁ := ⟨mem_univ _, hs⟩
    have hG : HasFDerivAt (↿W) (fderiv ℝ (↿W) (y, s)) (y, s) :=
      ((hWO.contDiffAt (hO.mem_nhds hmem)).differentiableAt (by simp)).hasFDerivAt
    have hγ : HasDerivAt (fun r : ℝ => (y, r)) ((0:ℝ³), (1:ℝ)) s :=
      (hasDerivAt_const s y).prodMk (hasDerivAt_id' s)
    rw [hDdef]
    exact hG.comp_hasDerivAt s hγ
  have hderiv : ∀ y : ℝ³, ∀ s ∈ Ioo (0:ℝ) T₁, deriv (fun r => W y r) s = D (y, s) :=
    fun y s hs => (hder y s hs).deriv
  have hφ : Continuous (fun u : ℝ³ => x + L • u) :=
    continuous_const.add (continuous_const_smul L)
  have hb : Continuous (fun u => ρ u * deriv (fun s => W (x + L • u) s) t) := by
    have e : (fun u => ρ u * deriv (fun s => W (x + L • u) s) t)
        = fun u => ρ u * D (x + L • u, t) := by
      funext u
      rw [hderiv _ t ht]
    rw [e]
    refine hρ.mul ?_
    exact hDc.comp_continuous (hφ.prodMk continuous_const) (fun u => ⟨mem_univ _, ht⟩)
  obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = min t (T₁ - t) / 2 := ⟨_, rfl⟩
  have hmin1 := min_le_left t (T₁ - t)
  have hmin2 := min_le_right t (T₁ - t)
  have hδpos : 0 < δ := by
    rw [hδ]
    exact half_pos (lt_min ht.1 (sub_pos.mpr ht.2))
  have hcb : Metric.closedBall t δ ⊆ Ioo 0 T₁ := by
    intro s hs
    rw [Metric.mem_closedBall, Real.dist_eq, abs_le] at hs
    obtain ⟨h1, h2⟩ := hs
    constructor <;> linarith [ht.1, ht.2]
  have hK : IsCompact (Metric.closedBall x |L| ×ˢ Metric.closedBall t δ) :=
    (isCompact_closedBall x |L|).prod (isCompact_closedBall t δ)
  have hKO : Metric.closedBall x |L| ×ˢ Metric.closedBall t δ
      ⊆ (univ : Set ℝ³) ×ˢ Ioo (0:ℝ) T₁ :=
    prod_mono (subset_univ _) hcb
  obtain ⟨M, hM⟩ := hK.exists_bound_of_continuousOn (hDc.mono hKO)
  have hdom : ∀ u : ℝ³, ∀ s ∈ Metric.ball t δ,
      ‖ρ u * deriv (fun r => W (x + L • u) r) s‖ ≤ ‖ρ u‖ * M := by
    intro u s hs
    have hsI : s ∈ Ioo 0 T₁ := hcb (Metric.ball_subset_closedBall hs)
    rw [hderiv _ s hsI, norm_mul]
    by_cases hu : 1 ≤ ‖u‖
    · rw [hρ1 u hu]; simp
    · push_neg at hu
      refine mul_le_mul_of_nonneg_left (hM _ ⟨?_, Metric.ball_subset_closedBall hs⟩)
        (norm_nonneg _)
      rw [Metric.mem_closedBall, dist_eq_norm, add_sub_cancel_left, norm_smul,
        Real.norm_eq_abs]
      exact mul_le_of_le_one_right (abs_nonneg L) hu.le
  have hρcs : HasCompactSupport ρ := by
    refine HasCompactSupport.intro (isCompact_closedBall (0:ℝ³) 1) (fun z hz => hρ1 z ?_)
    rw [Metric.mem_closedBall, dist_zero_right, not_le] at hz
    exact hz.le
  have hρint : Integrable ρ := hρ.integrable_of_hasCompactSupport hρcs
  have hFc : ∀ s ∈ Icc 0 T₁, Continuous (fun u => ρ u * W (x + L • u) s) := by
    intro s hs
    have h1 : Continuous (fun y : ℝ³ => W y s) :=
      hW.continuousOn.comp_continuous (continuous_id.prodMk continuous_const)
        (fun y => ⟨mem_univ _, hs⟩)
    exact hρ.mul (h1.comp hφ)
  have hFi : ∀ s ∈ Icc 0 T₁, Integrable (fun u => ρ u * W (x + L • u) s) := fun s hs =>
    (hFc s hs).integrable_of_hasCompactSupport hρcs.mul_right
  refine ⟨(hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume)
    (F := fun s u => ρ u * W (x + L • u) s)
    (F' := fun s u => ρ u * deriv (fun r => W (x + L • u) r) s)
    (bound := fun u => ‖ρ u‖ * M) (x₀ := t)
    (Metric.ball_mem_nhds t hδpos)
    (Filter.eventually_of_mem (isOpen_Ioo.mem_nhds ht)
      (fun s hs => (hFc s (Ioo_subset_Icc_self hs)).aestronglyMeasurable))
    (hFi t (Ioo_subset_Icc_self ht))
    hb.aestronglyMeasurable
    (Filter.Eventually.of_forall (fun u s hs => hdom u s hs))
    (hρint.norm.mul_const M)
    (Filter.Eventually.of_forall (fun u s hs => ?_))).2, hb⟩
  have hsI : s ∈ Ioo 0 T₁ := hcb (Metric.ball_subset_closedBall hs)
  have h := hder (x + L • u) s hsI
  rw [← hderiv _ s hsI] at h
  exact h.const_mul (ρ u)

theorem deriv_zero_of_uniform_approx : ∀ (a b : ℝ) (h : ℝ → ℝ) (m m' : ℕ → ℝ → ℝ) (ε : ℕ → ℝ), Filter.Tendsto ε Filter.atTop (nhds 0) → (∀ n, ∀ t ∈ Ioo a b, HasDerivAt (m n) (m' n t) t) → (∀ n, ∀ t ∈ Ioo a b, |m n t| ≤ ε n) → (∀ n, ∀ t ∈ Ioo a b, |h t + m' n t| ≤ ε n) → ∀ t ∈ Ioo a b, h t = 0 :=
by
  intro a b h m m' ε hε hd hm hh t ht
  have hU : TendstoUniformlyOn m' (fun x => -h x) Filter.atTop (Set.Ioo a b) := by
    rw [Metric.tendstoUniformlyOn_iff]
    intro δ hδ
    filter_upwards [(tendsto_order.1 hε).2 δ hδ] with n hn x hx
    rw [Real.dist_eq, show -h x - m' n x = -(h x + m' n x) by ring, abs_neg]
    exact lt_of_le_of_lt (hh n x hx) hn
  have hP : ∀ x ∈ Set.Ioo a b,
      Filter.Tendsto (fun n => m n x) Filter.atTop (nhds ((fun _ => (0:ℝ)) x)) :=
    fun x hx => squeeze_zero_norm (fun n => by rw [Real.norm_eq_abs]; exact hm n x hx) hε
  have hD := hasDerivAt_of_tendstoUniformlyOn isOpen_Ioo hU
    (Filter.Eventually.of_forall hd) hP ht
  have := hD.unique (hasDerivAt_const t (0:ℝ))
  linarith

theorem stress_pressure_identification : ∀ (ν T₁ C₀ C₁ : ℝ) (w : ℝ³ → ℝ → ℝ³) (π : ℝ³ → ℝ → ℝ) (g : Fin 3 → Fin 3 → ℝ³ → ℝ → ℝ), 0 < T₁ → ContDiffOn ℝ ∞ (↿w) (univ ×ˢ Icc 0 T₁) → ContDiffOn ℝ ∞ (↿π) (univ ×ˢ Icc 0 T₁) → (∀ i j, ContDiffOn ℝ ∞ (↿(g i j)) (univ ×ˢ Icc 0 T₁)) → (∀ x t, t ∈ Ioo 0 T₁ → ∀ i : Fin 3, deriv (fun s => w x s i) t + ∑ j, pd j (fun y => g i j y t) x = ν * (Δ (fun y => w y t) x) i - pd i (fun y => π y t) x) → (∀ x t, t ∈ Icc 0 T₁ → divergence (fun y => w y t) x = 0) → (∀ t ∈ Icc 0 T₁, MemLp (fun x => w x t) 2 ∧ (∫ x, ‖w x t‖ ^ 2) ≤ C₀) → (∀ t ∈ Icc 0 T₁, ∀ i j, Integrable (fun x => g i j x t) ∧ (∫ x, |g i j x t|) ≤ C₁) → ∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo 0 T₁ → ∃ c : ℝ, ∀ x, π x t = stressPressure (fun i j y => g i j y t) x + c :=
by
  intro ν T₁ C₀ C₁ w π g hT₁ hw hπ hg hEQ hdiv hC₀ hC₁
  have h2 : (2 : WithTop ℕ∞) ≤ ∞ := by simp
  have h0 : (0:ℝ) ∈ Icc 0 T₁ := ⟨le_rfl, hT₁.le⟩
  have hC₀nn : 0 ≤ C₀ := le_trans (integral_nonneg (fun x => by positivity)) (hC₀ 0 h0).2
  have hC₁nn : 0 ≤ C₁ := le_trans (integral_nonneg (fun x => abs_nonneg _)) (hC₁ 0 h0 0 0).2
  obtain ⟨ρ, hρs, hρ1, hMVP⟩ := mean_value_kernel_exists
  obtain ⟨K₁, hK₁0, hK₁⟩ := mollifier_scaling_bounds ρ hρs hρ1
  obtain ⟨K₂, hK₂0, hK₂⟩ := mollified_stress_pressure_bound ρ hρs hρ1
  have hρc : Continuous ρ := hρs.continuous
  have hρcs : HasCompactSupport ρ := by
    refine HasCompactSupport.intro (isCompact_closedBall (0:ℝ³) 1) (fun z hz => hρ1 z ?_)
    rw [Metric.mem_closedBall, dist_zero_right, not_le] at hz
    exact hz.le
  have hint : ∀ φ : ℝ³ → ℝ, Continuous φ → Integrable (fun u => ρ u * φ u) := fun φ hφ =>
    (hρc.mul hφ).integrable_of_hasCompactSupport (hρcs.mul_right (f' := φ))
  have hshift : ∀ (x : ℝ³) (L : ℝ) (Ψ : ℝ³ → ℝ), Continuous Ψ →
      Continuous (fun u : ℝ³ => Ψ (x + L • u)) := fun x L Ψ hΨ =>
    hΨ.comp (continuous_const.add (continuous_const_smul L))
  have slice : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (G : ℝ³ → ℝ → F)
      (S : Set ℝ) (t : ℝ), ContDiffOn ℝ ∞ (↿G) (univ ×ˢ S) → t ∈ S →
      ContDiff ℝ ∞ (fun y => G y t) := by
    intro F _ _ G S t hG ht
    have h1 : ContDiff ℝ ∞ (fun y : ℝ³ => (y, t)) := contDiff_id.prodMk contDiff_const
    exact contDiffOn_univ.mp (hG.comp h1.contDiffOn (fun y _ => ⟨mem_univ _, ht⟩))
  have hcomp : ∀ i : Fin 3, ContDiffOn ℝ ∞ (↿(fun y s => w y s i)) (univ ×ˢ Icc 0 T₁) :=
    fun i => (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).contDiff.comp_contDiffOn hw
  have hcontΔ : ∀ f : ℝ³ → ℝ, ContDiff ℝ ∞ f → Continuous (Δ f) := by
    intro f hf
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis f
      (EuclideanSpace.basisFun (Fin 3) ℝ)]
    refine continuous_finset_sum _ (fun k _ => ?_)
    exact (hf.continuous_iteratedFDeriv (by simp)).eval_const _
  have hcontpd : ∀ (j : Fin 3) (f : ℝ³ → ℝ), ContDiff ℝ ∞ f → Continuous (pd j f) := by
    intro j f hf
    show Continuous (fun y => fderiv ℝ f y (EuclideanSpace.single j 1))
    exact (hf.continuous_fderiv (by simp)).clm_apply continuous_const
  have hcdpd : ∀ (j : Fin 3) (f : ℝ³ → ℝ), ContDiff ℝ ∞ f → ContDiff ℝ ∞ (pd j f) := by
    intro j f hf
    show ContDiff ℝ ∞ (fun y => fderiv ℝ f y (EuclideanSpace.single j 1))
    exact (contDiff_infty_iff_fderiv.mp hf).2.clm_apply contDiff_const
  have htri : ∀ a b c : ℝ, |a - b - c| ≤ |a| + |b| + |c| := fun a b c => by
    have e1 := abs_sub (a - b) c
    have e2 := abs_sub a b
    linarith

  have key : ∀ (i : Fin 3) (x : ℝ³), ∀ t ∈ Ioo 0 T₁,
      pd i (fun y => π y t - stressPressure (fun k l z => g k l z t) y) x = 0 := by
    intro i x
    obtain ⟨E, hE⟩ : ∃ E : ℝ, E = K₁ * Real.sqrt C₀ + |ν| * (K₁ * Real.sqrt C₀)
        + 3 * (K₁ * C₁) + K₂ * (9 * C₁) := ⟨_, rfl⟩
    have hmain : ∀ n : ℕ, ∀ s ∈ Ioo 0 T₁,
        |∫ u, ρ u * w (x + ((n:ℝ)+1) • u) s i| ≤ E / ((n:ℝ)+1) ∧
        |pd i (fun y => π y s - stressPressure (fun k l z => g k l z s) y) x
          + ∫ u, ρ u * deriv (fun r => w (x + ((n:ℝ)+1) • u) r i) s| ≤ E / ((n:ℝ)+1) := by
      intro n s hs
      obtain ⟨L, hLdef⟩ : ∃ L : ℝ, L = (n:ℝ) + 1 := ⟨_, rfl⟩
      rw [← hLdef]
      have hL : 1 ≤ L := by rw [hLdef]; linarith [(Nat.cast_nonneg n : (0:ℝ) ≤ n)]
      have hLpos : 0 < L := by linarith
      have hsI : s ∈ Icc 0 T₁ := ⟨hs.1.le, hs.2.le⟩

      have hws : ContDiff ℝ ∞ (fun y => w y s) := slice w _ s hw hsI
      have hwis : ContDiff ℝ ∞ (fun y => w y s i) := slice (fun y s => w y s i) _ s (hcomp i) hsI
      have hπs : ContDiff ℝ ∞ (fun y => π y s) := slice π _ s hπ hsI
      have hGs : ∀ k l, ContDiff ℝ ∞ (fun y => g k l y s) :=
        fun k l => slice (g k l) _ s (hg k l) hsI
      have hGsI : ∀ k l, ContDiff ℝ ∞ ((fun k l z => g k l z s) k l) ∧
          Integrable ((fun k l z => g k l z s) k l) := fun k l => ⟨hGs k l, (hC₁ s hsI k l).1⟩
      obtain ⟨hSPs, hSPΔ⟩ := stress_pressure_laplacian (fun k l z => g k l z s) hGsI
      have hHs : ContDiff ℝ ∞ (fun y => π y s - stressPressure (fun k l z => g k l z s) y) :=
        hπs.sub hSPs

      have hΔH : ∀ y, Δ (fun y => π y s - stressPressure (fun k l z => g k l z s) y) y = 0 := by
        intro y
        have e1 : (fun y => π y s - stressPressure (fun k l z => g k l z s) y)
            = (fun y => π y s) - stressPressure (fun k l z => g k l z s) := rfl
        rw [e1, ContDiffAt.laplacian_sub (hπs.contDiffAt.of_le h2) (hSPs.contDiffAt.of_le h2),
          hSPΔ y, pressure_laplacian_of_conservative_eq ν T₁ w π g hw hπ hg hEQ hdiv y s hs]
        simp
      have hF : ContDiff ℝ ∞ (pd i (fun y => π y s - stressPressure (fun k l z => g k l z s) y)) :=
        hcdpd i _ hHs
      have hFΔ : ∀ y, Δ (pd i (fun y => π y s - stressPressure (fun k l z => g k l z s) y)) y = 0 := by
        intro y
        rw [laplacian_pd_comm _ hHs i y]
        have e2 : Δ (fun y => π y s - stressPressure (fun k l z => g k l z s) y) = fun _ => 0 :=
          funext hΔH
        rw [e2]
        simp [pd]
      have hMV := hMVP _ hF hFΔ x L hLpos

      have hπd : Differentiable ℝ (fun y => π y s) := hπs.differentiable (by simp)
      have hSPd : Differentiable ℝ (stressPressure (fun k l z => g k l z s)) :=
        hSPs.differentiable (by simp)
      have hpt0 : ∀ y, pd i (fun y => π y s - stressPressure (fun k l z => g k l z s) y) y
            + deriv (fun r => w y r i) s
          = ν * Δ (fun z => w z s i) y - ∑ j, pd j (fun z => g i j z s) y
            - pd i (stressPressure (fun k l z => g k l z s)) y := by
        intro y
        have e3 : pd i (fun y => π y s - stressPressure (fun k l z => g k l z s) y) y
            = pd i (fun y => π y s) y - pd i (stressPressure (fun k l z => g k l z s)) y := by
          simp only [pd]
          rw [fderiv_fun_sub (hπd y) (hSPd y), ContinuousLinearMap.sub_apply]
        have e4 : (Δ (fun z => w z s) y) i = Δ (fun z => w z s i) y :=
          (ContDiffAt.laplacian_CLM_comp_left (l := (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ))
            (hws.contDiffAt.of_le h2)).symm
        have e5 := hEQ y s hs i
        rw [e4] at e5
        rw [e3]
        linarith

      have hc1 : Continuous (fun u => pd i (fun y => π y s - stressPressure (fun k l z => g k l z s) y)
          (x + L • u)) := hshift x L _ hF.continuous
      have hc2 : Continuous (fun u => Δ (fun z => w z s i) (x + L • u)) :=
        hshift x L _ (hcontΔ _ hwis)
      have hc3 : ∀ j, Continuous (fun u => pd j (fun z => g i j z s) (x + L • u)) :=
        fun j => hshift x L _ (hcontpd j _ (hGs i j))
      have hc4 : Continuous (fun u => pd i (stressPressure (fun k l z => g k l z s)) (x + L • u)) :=
        hshift x L _ (hcontpd i _ hSPs)
      have hc8 := mollifier_time_deriv T₁ L x ρ (fun y s => w y s i) (hcomp i) hρc hρ1 s hs
      have he : Integrable (fun u => ρ u * deriv (fun r => w (x + L • u) r i) s) :=
        hc8.2.integrable_of_hasCompactSupport (hρcs.mul_right (f' := fun u => deriv (fun r => w (x + L • u) r i) s))
      have hia : Integrable (fun u => ν * (ρ u * Δ (fun z => w z s i) (x + L • u))) :=
        (hint _ hc2).const_mul ν
      have hib : Integrable (fun u => ∑ j, ρ u * pd j (fun z => g i j z s) (x + L • u)) :=
        integrable_finset_sum _ (fun j _ => hint _ (hc3 j))
      have hiab : Integrable (fun u => ν * (ρ u * Δ (fun z => w z s i) (x + L • u))
          - ∑ j, ρ u * pd j (fun z => g i j z s) (x + L • u)) := hia.sub hib
      have hI : ∫ u, (ρ u * pd i (fun y => π y s - stressPressure (fun k l z => g k l z s) y) (x + L • u)
            + ρ u * deriv (fun r => w (x + L • u) r i) s)
          = ∫ u, (ν * (ρ u * Δ (fun z => w z s i) (x + L • u))
            - ∑ j, ρ u * pd j (fun z => g i j z s) (x + L • u)
            - ρ u * pd i (stressPressure (fun k l z => g k l z s)) (x + L • u)) := by
        congr 1
        funext u
        have h1 := hpt0 (x + L • u)
        rw [← Finset.mul_sum]
        linear_combination ρ u * h1
      rw [integral_add (hint _ hc1) he, integral_sub hiab (hint _ hc4), integral_sub hia hib,
        integral_const_mul ν, integral_finset_sum _ (fun j _ => hint _ (hc3 j)), hMV] at hI

      have hwiL : MemLp (fun y => w y s i) 2 :=
        (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).comp_memLp' (hC₀ s hsI).1
      have hnormInt : Integrable (fun y => ‖w y s‖ ^ 2) :=
        (memLp_two_iff_integrable_sq_norm (hC₀ s hsI).1.aestronglyMeasurable).mp (hC₀ s hsI).1
      have hwi2 : ∫ y, (w y s i) ^ 2 ≤ C₀ := by
        refine le_trans (integral_mono hwiL.integrable_sq hnormInt (fun y => ?_)) (hC₀ s hsI).2
        show (w y s i) ^ 2 ≤ ‖w y s‖ ^ 2
        have h := PiLp.norm_apply_le (w y s) i
        rw [Real.norm_eq_abs] at h
        nlinarith [sq_abs (w y s i), abs_nonneg (w y s i)]
      have hsq : (∫ y, (w y s i) ^ 2) ^ ((1:ℝ)/2) ≤ Real.sqrt C₀ := by
        rw [Real.sqrt_eq_rpow]
        exact Real.rpow_le_rpow (integral_nonneg (fun y => sq_nonneg _)) hwi2 (by norm_num)
      have hLp : ∀ p : ℝ, 1 ≤ p → L ≤ L ^ p := fun p hp => by
        simpa using Real.rpow_le_rpow_of_exponent_le hL hp
      have hL4 : L ≤ L ^ 4 := le_self_pow₀ hL (by norm_num)
      have hK1C0 : 0 ≤ K₁ * Real.sqrt C₀ := mul_nonneg hK₁0 (Real.sqrt_nonneg _)
      obtain ⟨-, hKb, hKc⟩ := hK₁ (fun y => w y s i) x L hwis hL
      have hmb : |∫ u, ρ u * w (x + L • u) s i| ≤ K₁ * Real.sqrt C₀ / L := by
        calc |∫ u, ρ u * w (x + L • u) s i|
            ≤ K₁ * (∫ y, (w y s i) ^ 2) ^ ((1:ℝ)/2) / L ^ ((3:ℝ)/2) := hKb hwiL
          _ ≤ K₁ * Real.sqrt C₀ / L ^ ((3:ℝ)/2) :=
            div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hsq hK₁0)
              (Real.rpow_pos_of_pos hLpos _).le
          _ ≤ K₁ * Real.sqrt C₀ / L :=
            div_le_div_of_nonneg_left hK1C0 hLpos (hLp _ (by norm_num))
      have hAb : |∫ u, ρ u * Δ (fun z => w z s i) (x + L • u)| ≤ K₁ * Real.sqrt C₀ / L := by
        calc |∫ u, ρ u * Δ (fun z => w z s i) (x + L • u)|
            ≤ K₁ * (∫ y, (w y s i) ^ 2) ^ ((1:ℝ)/2) / L ^ ((7:ℝ)/2) := hKc hwiL
          _ ≤ K₁ * Real.sqrt C₀ / L ^ ((7:ℝ)/2) :=
            div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hsq hK₁0)
              (Real.rpow_pos_of_pos hLpos _).le
          _ ≤ K₁ * Real.sqrt C₀ / L :=
            div_le_div_of_nonneg_left hK1C0 hLpos (hLp _ (by norm_num))
      have hBb : ∀ j, |∫ u, ρ u * pd j (fun z => g i j z s) (x + L • u)| ≤ K₁ * C₁ / L := by
        intro j
        have h1 := (hK₁ (fun z => g i j z s) x L (hGs i j) hL).1 (hC₁ s hsI i j).1 j
        calc |∫ u, ρ u * pd j (fun z => g i j z s) (x + L • u)|
            ≤ K₁ * (∫ y, |g i j y s|) / L ^ 4 := h1
          _ ≤ K₁ * C₁ / L ^ 4 :=
            div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left (hC₁ s hsI i j).2 hK₁0)
              (by positivity)
          _ ≤ K₁ * C₁ / L := div_le_div_of_nonneg_left (mul_nonneg hK₁0 hC₁nn) hLpos hL4
      have hDb : |∫ u, ρ u * pd i (stressPressure (fun k l z => g k l z s)) (x + L • u)|
          ≤ K₂ * (9 * C₁) / L := by
        have h1 := hK₂ (fun k l z => g k l z s) hGsI i x L hL
        have hsum : ∑ k, ∑ l, ∫ y, |g k l y s| ≤ 9 * C₁ := by
          calc ∑ k, ∑ l, ∫ y, |g k l y s| ≤ ∑ k : Fin 3, ∑ l : Fin 3, C₁ :=
                Finset.sum_le_sum (fun k _ => Finset.sum_le_sum (fun l _ => (hC₁ s hsI k l).2))
            _ = 9 * C₁ := by
                simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
                push_cast
                ring
        calc |∫ u, ρ u * pd i (stressPressure (fun k l z => g k l z s)) (x + L • u)|
            ≤ K₂ * (∑ k, ∑ l, ∫ y, |g k l y s|) / L ^ 4 := h1
          _ ≤ K₂ * (9 * C₁) / L ^ 4 :=
            div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hsum hK₂0) (by positivity)
          _ ≤ K₂ * (9 * C₁) / L :=
            div_le_div_of_nonneg_left (mul_nonneg hK₂0 (by linarith)) hLpos hL4
      have hn1 : 0 ≤ |ν| * (K₁ * Real.sqrt C₀) := mul_nonneg (abs_nonneg _) hK1C0
      have hn2 : 0 ≤ K₁ * C₁ := mul_nonneg hK₁0 hC₁nn
      have hn3 : 0 ≤ K₂ * (9 * C₁) := mul_nonneg hK₂0 (by linarith)
      have hEL : E / L = K₁ * Real.sqrt C₀ / L + |ν| * (K₁ * Real.sqrt C₀ / L)
          + 3 * (K₁ * C₁ / L) + K₂ * (9 * C₁) / L := by
        rw [hE]; ring
      have hnn : 0 ≤ K₁ * Real.sqrt C₀ / L := div_nonneg hK1C0 hLpos.le
      have hnn2 : 0 ≤ |ν| * (K₁ * Real.sqrt C₀ / L) :=
        mul_nonneg (abs_nonneg _) hnn
      have hnn3 : 0 ≤ K₁ * C₁ / L := div_nonneg hn2 hLpos.le
      have hnn4 : 0 ≤ K₂ * (9 * C₁) / L := div_nonneg hn3 hLpos.le
      refine ⟨?_, ?_⟩
      · rw [hEL]; linarith
      · rw [hI]
        have hsumB : |∑ j, ∫ u, ρ u * pd j (fun z => g i j z s) (x + L • u)|
            ≤ 3 * (K₁ * C₁ / L) := by
          refine le_trans (Finset.abs_sum_le_sum_abs _ _) ?_
          calc ∑ j, |∫ u, ρ u * pd j (fun z => g i j z s) (x + L • u)|
              ≤ ∑ j : Fin 3, K₁ * C₁ / L := Finset.sum_le_sum (fun j _ => hBb j)
            _ = 3 * (K₁ * C₁ / L) := by
                simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
                push_cast
                ring
        have hνA : |ν * ∫ u, ρ u * Δ (fun z => w z s i) (x + L • u)|
            ≤ |ν| * (K₁ * Real.sqrt C₀ / L) := by
          rw [abs_mul]; exact mul_le_mul_of_nonneg_left hAb (abs_nonneg _)
        have h3 := htri (ν * ∫ u, ρ u * Δ (fun z => w z s i) (x + L • u))
          (∑ j, ∫ u, ρ u * pd j (fun z => g i j z s) (x + L • u))
          (∫ u, ρ u * pd i (stressPressure (fun k l z => g k l z s)) (x + L • u))
        rw [hEL]
        linarith
    refine deriv_zero_of_uniform_approx 0 T₁
      (fun t => pd i (fun y => π y t - stressPressure (fun k l z => g k l z t) y) x)
      (fun n s => ∫ u, ρ u * w (x + ((n:ℝ)+1) • u) s i)
      (fun n s => ∫ u, ρ u * deriv (fun r => w (x + ((n:ℝ)+1) • u) r i) s)
      (fun n => E / ((n:ℝ)+1)) ?_ ?_ ?_ ?_
    · have := (tendsto_const_div_atTop_nhds_zero_nat E).comp (Filter.tendsto_add_atTop_nat 1)
      refine this.congr (fun n => ?_)
      simp [Function.comp]
    · intro n s hs
      exact (mollifier_time_deriv T₁ ((n:ℝ)+1) x ρ (fun y s => w y s i) (hcomp i) hρc hρ1 s hs).1
    · intro n s hs
      exact (hmain n s hs).1
    · intro n s hs
      exact (hmain n s hs).2

  refine Filter.Eventually.of_forall (fun t ht => ?_)
  have htI : t ∈ Icc 0 T₁ := ⟨ht.1.le, ht.2.le⟩
  have hπt : ContDiff ℝ ∞ (fun y => π y t) := slice π _ t hπ htI
  have hGt : ∀ k l, ContDiff ℝ ∞ ((fun k l z => g k l z t) k l) ∧
      Integrable ((fun k l z => g k l z t) k l) :=
    fun k l => ⟨slice (g k l) _ t (hg k l) htI, (hC₁ t htI k l).1⟩
  have hSPt := (stress_pressure_laplacian (fun k l z => g k l z t) hGt).1
  have hHd : Differentiable ℝ (fun y => π y t - stressPressure (fun k l z => g k l z t) y) :=
    (hπt.differentiable (by simp)).sub (hSPt.differentiable (by simp))
  have hfd : ∀ x, fderiv ℝ (fun y => π y t - stressPressure (fun k l z => g k l z t) y) x = 0 := by
    intro x
    apply ContinuousLinearMap.coe_injective
    refine (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.ext (fun k => ?_)
    simpa [pd] using key k x t ht
  refine ⟨π 0 t - stressPressure (fun k l z => g k l z t) 0, fun x => ?_⟩
  have hc := is_const_of_fderiv_eq_zero hHd hfd x 0
  try simp only [] at hc
  linarith

theorem flux_cutoff_beta : ∃ c₁ : ℝ, 0 < c₁ ∧ ∀ R : ℝ, 1 ≤ R → (∀ x y : ℝ³, |cutPhi R y ^ 6 - cutPhi R x ^ 6| ≤ min 1 (3 * c₁ / R * ‖x - y‖) * (cutPhi R x ^ 3 + cutPhi R y ^ 3)) ∧ ∀ w : ℝ³ → ℝ³, ContDiff ℝ ∞ w → ContDiff ℝ ∞ (fluxBeta R w) ∧ HasCompactSupport (fluxBeta R w) ∧ (∀ x, |fluxBeta R w x| ≤ 8 * c₁ / R * cutPhi R x * ‖w x‖) ∧ (∀ x, inner ℝ (w x) (gradient (fun y => cutPhi R y ^ 8) x) = cutPhi R x ^ 6 * fluxBeta R w x) :=
by
  have hbC : ContDiff ℝ ∞ (⇑bump12) := bump12.contDiff
  have hbS : HasCompactSupport (⇑bump12) := bump12.hasCompactSupport
  have hDc : Continuous (fderiv ℝ (⇑bump12)) := hbC.continuous_fderiv (by simp)
  have hDS : HasCompactSupport (fderiv ℝ (⇑bump12)) := hbS.fderiv ℝ
  obtain ⟨c, hc⟩ := hDS.exists_bound_of_continuous hDc
  have hc1pos : 0 < max c 0 + 1 := by positivity
  refine ⟨max c 0 + 1, hc1pos, fun R hR => ?_⟩
  have hc' : ∀ y, ‖fderiv ℝ (⇑bump12) y‖ ≤ max c 0 + 1 :=
    fun y => by have := le_max_left c 0; have := hc y; linarith
  have hRpos : 0 < R := by linarith
  have hRinv : 0 < R⁻¹ := inv_pos.mpr hRpos
  have hφeq : cutPhi R = fun x => bump12 (R⁻¹ • x) := rfl
  have hφC : ContDiff ℝ ∞ (cutPhi R) := by
    rw [hφeq]; exact hbC.comp (contDiff_const_smul R⁻¹)
  have hφS : HasCompactSupport (cutPhi R) := by
    rw [hφeq]; exact hbS.comp_smul (inv_ne_zero hRpos.ne')
  have hφb : ∀ x, 0 ≤ cutPhi R x ∧ cutPhi R x ≤ 1 :=
    fun x => ⟨bump12.nonneg, bump12.le_one⟩
  have hd : ∀ x, DifferentiableAt ℝ (cutPhi R) x := fun x => hφC.differentiable (by simp) x
  have hDφ : ∀ x, ‖fderiv ℝ (cutPhi R) x‖ ≤ (max c 0 + 1) / R := by
    intro x
    rw [hφeq, fderiv_comp_smul, norm_smul, Real.norm_eq_abs, abs_of_pos hRinv, div_eq_inv_mul]
    exact mul_le_mul_of_nonneg_left (hc' _) hRinv.le
  have hlip : ∀ x y : ℝ³, |cutPhi R y - cutPhi R x| ≤ (max c 0 + 1) / R * ‖x - y‖ := by
    intro x y
    have := Convex.norm_image_sub_le_of_norm_fderiv_le (𝕜 := ℝ) (s := univ) (fun z _ => hd z)
      (fun z _ => hDφ z) convex_univ (mem_univ x) (mem_univ y)
    rw [Real.norm_eq_abs, norm_sub_rev y x] at this
    exact this
  refine ⟨fun x y => ?_, fun w hw => ?_⟩
  · obtain ⟨ha0, ha1⟩ := hφb x
    obtain ⟨hb0, hb1⟩ := hφb y
    have hL := hlip x y
    generalize cutPhi R x = a at ha0 ha1 hL ⊢
    generalize cutPhi R y = b at hb0 hb1 hL ⊢
    have hd0 : 0 ≤ ‖x - y‖ := norm_nonneg _
    have hq0 : 0 ≤ b ^ 2 + a * b + a ^ 2 := by positivity
    have hq3 : b ^ 2 + a * b + a ^ 2 ≤ 3 := by
      nlinarith [mul_le_one₀ ha1 hb0 hb1, mul_le_one₀ ha1 ha0 ha1, mul_le_one₀ hb1 hb0 hb1]
    have hcube : |b ^ 3 - a ^ 3| ≤ 3 * (max c 0 + 1) / R * ‖x - y‖ := by
      rw [show b ^ 3 - a ^ 3 = (b - a) * (b ^ 2 + a * b + a ^ 2) by ring, abs_mul,
        abs_of_nonneg hq0]
      calc |b - a| * (b ^ 2 + a * b + a ^ 2) ≤ ((max c 0 + 1) / R * ‖x - y‖) * 3 :=
            mul_le_mul hL hq3 hq0 (by positivity)
        _ = 3 * (max c 0 + 1) / R * ‖x - y‖ := by ring
    have ha3 : a ^ 3 ≤ 1 := pow_le_one₀ ha0 ha1
    have hb3 : b ^ 3 ≤ 1 := pow_le_one₀ hb0 hb1
    have ha3' : 0 ≤ a ^ 3 := pow_nonneg ha0 3
    have hb3' : 0 ≤ b ^ 3 := pow_nonneg hb0 3
    have hone : |b ^ 3 - a ^ 3| ≤ 1 := by
      rw [abs_le]; constructor <;> linarith
    rw [show b ^ 6 - a ^ 6 = (b ^ 3 - a ^ 3) * (a ^ 3 + b ^ 3) by ring, abs_mul,
      abs_of_nonneg (by positivity : (0:ℝ) ≤ a ^ 3 + b ^ 3)]
    exact mul_le_mul_of_nonneg_right (le_min hone hcube) (by positivity)
  · have hβeq : fluxBeta R w = fun x => 8 * cutPhi R x * fderiv ℝ (cutPhi R) x (w x) := rfl
    have hDφC : ContDiff ℝ ∞ (fderiv ℝ (cutPhi R)) := hφC.fderiv_right (m := ∞) (by simp)
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hβeq]
      exact (contDiff_const.mul hφC).mul (hDφC.clm_apply hw)
    · rw [hβeq]
      have : (fun x => 8 * cutPhi R x * fderiv ℝ (cutPhi R) x (w x)) =
          (fun x => cutPhi R x * (8 * fderiv ℝ (cutPhi R) x (w x))) := by
        funext x; ring
      rw [this]
      exact hφS.mul_right
    · intro x
      rw [hβeq]
      have h0 := (hφb x).1
      show |8 * cutPhi R x * fderiv ℝ (cutPhi R) x (w x)| ≤ _
      rw [abs_mul, abs_of_nonneg (by positivity : (0:ℝ) ≤ 8 * cutPhi R x)]
      have h1 : |fderiv ℝ (cutPhi R) x (w x)| ≤ (max c 0 + 1) / R * ‖w x‖ := by
        rw [← Real.norm_eq_abs]
        exact ((fderiv ℝ (cutPhi R) x).le_opNorm (w x)).trans
          (mul_le_mul_of_nonneg_right (hDφ x) (norm_nonneg _))
      calc 8 * cutPhi R x * |fderiv ℝ (cutPhi R) x (w x)|
          ≤ 8 * cutPhi R x * ((max c 0 + 1) / R * ‖w x‖) :=
            mul_le_mul_of_nonneg_left h1 (by positivity)
        _ = _ := by ring
    · intro x
      have hfd : fderiv ℝ (fun y => cutPhi R y ^ 8) x =
          (8 * cutPhi R x ^ 7) • fderiv ℝ (cutPhi R) x := by
        rw [((hd x).hasFDerivAt.pow 8).fderiv]
        norm_num
      rw [real_inner_comm]
      simp only [gradient, InnerProductSpace.toDual_symm_apply]
      rw [hfd, hβeq]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring

theorem stressPressure_duality : ∀ (g : Fin 3 → Fin 3 → ℝ³ → ℝ) (b : ℝ³ → ℝ), (∀ i j, ContDiff ℝ ∞ (g i j)) → (∀ i j, Integrable (g i j)) → ContDiff ℝ ∞ b → HasCompactSupport b → ∫ x, stressPressure g x * b x = ∑ i, ∑ j, ∫ x, g i j x * pd i (pd j (newtonPot b)) x :=
by
  intro g b hg hgi hb hbc

  have hpd : ∀ (k : Fin 3) (F : ℝ³ → ℝ), ContDiff ℝ ∞ F → ContDiff ℝ ∞ (pd k F) := by
    intro k F hF
    exact (contDiff_infty_iff_fderiv.mp hF).2.clm_apply contDiff_const
  have hpdc : ∀ (k : Fin 3) (F : ℝ³ → ℝ), HasCompactSupport F → HasCompactSupport (pd k F) := by
    intro k F hF
    exact hF.fderiv_apply ℝ _

  have hK : LocallyIntegrable newtonKernel volume := by
    rw [locallyIntegrable_iff]
    intro k hk
    obtain ⟨r, hr⟩ := hk.isBounded.subset_closedBall (0 : ℝ³)
    refine IntegrableOn.mono_set ?_ hr
    rw [← integrable_indicator_iff Metric.isClosed_closedBall.measurableSet]
    have heq : (Metric.closedBall (0:ℝ³) r).indicator newtonKernel =
        fun x => (fun s : ℝ => if s ≤ r then (4 * Real.pi * s)⁻¹ else 0) ‖x‖ := by
      funext x
      simp only [Set.indicator, Metric.mem_closedBall, dist_zero_right, newtonKernel]
    rw [heq]
    refine (integrable_fun_norm_addHaar (volume : Measure ℝ³)
      (f := fun s : ℝ => if s ≤ r then (4 * Real.pi * s)⁻¹ else 0)).mpr ?_
    have h1 : IntegrableOn (fun y : ℝ => y / (4 * Real.pi)) (Icc 0 r) :=
      (continuous_id.div_const _).integrableOn_Icc
    have h2 : IntegrableOn ((Icc 0 r).indicator (fun y : ℝ => y / (4 * Real.pi))) (Ioi 0) :=
      (h1.integrable_indicator measurableSet_Icc).integrableOn
    refine h2.congr_fun ?_ measurableSet_Ioi
    intro y hy
    have hy0 : (0:ℝ) < y := hy
    simp only [finrank_euclideanSpace_fin, smul_eq_mul, Set.indicator, Set.mem_Icc]
    by_cases hyr : y ≤ r
    · rw [if_pos ⟨hy0.le, hyr⟩, if_pos hyr]
      field_simp
    · rw [if_neg (fun h => hyr h.2), if_neg hyr, mul_zero]

  have hconv : ∀ h : ℝ³ → ℝ,
      newtonPot h = convolution newtonKernel h (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    intro h
    funext x
    rw [convolution_def, newtonPot]
    simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul]
    rw [← integral_sub_left_eq_self (fun t => newtonKernel t * h (x - t)) volume x]
    simp only [sub_sub_cancel]

  have hs3 : ∀ c : ℝ³ → ℝ, ContDiff ℝ ∞ c → HasCompactSupport c → ∀ (k : Fin 3) (x : ℝ³),
      pd k (newtonPot c) x = newtonPot (pd k c) x := by
    intro c hc hcc k x
    have hd := hcc.hasFDerivAt_convolution_right (ContinuousLinearMap.lsmul ℝ ℝ) hK
      (hc.of_le (by simp)) x
    rw [← hconv c] at hd
    show fderiv ℝ (newtonPot c) x (EuclideanSpace.single k 1) = _
    rw [hd.fderiv, convolution_precompR_apply (ContinuousLinearMap.lsmul ℝ ℝ) hK (hcc.fderiv ℝ)
      ((contDiff_infty_iff_fderiv.mp hc).2.continuous) x (EuclideanSpace.single k 1), hconv]
    rfl

  have hs4 : ∀ F c : ℝ³ → ℝ, ContDiff ℝ ∞ F → ContDiff ℝ ∞ c → HasCompactSupport c →
      ∀ i j : Fin 3, ∫ x, pd i (pd j F) x * c x = ∫ x, F x * pd i (pd j c) x := by
    intro F c hF hc hcc i j
    have hint' : ∀ u v : ℝ³ → ℝ, Continuous u → Continuous v → HasCompactSupport u →
        Integrable (fun x => u x * v x) :=
      fun u v hu hv huc => (hu.mul hv).integrable_of_hasCompactSupport huc.mul_right
    have cF := hF.continuous
    have cjF := (hpd j F hF).continuous
    have cijF := (hpd i _ (hpd j F hF)).continuous
    have cc := hc.continuous
    have cic := (hpd i c hc).continuous
    have cjic := (hpd j _ (hpd i c hc)).continuous
    have hic := hpdc i c hcc
    have hjic := hpdc j _ hic
    have e1 : ∫ x, c x * fderiv ℝ (pd j F) x (EuclideanSpace.single i 1) =
        -∫ x, fderiv ℝ c x (EuclideanSpace.single i 1) * pd j F x :=
      integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (hint' _ _ cic cjF hic)
        (hint' _ _ cc cijF hcc) (hint' _ _ cc cjF hcc)
        (fun x _ => hc.differentiable (by simp) x)
        (fun x _ => (hpd j F hF).differentiable (by simp) x)
    have e2 : ∫ x, pd i c x * fderiv ℝ F x (EuclideanSpace.single j 1) =
        -∫ x, fderiv ℝ (pd i c) x (EuclideanSpace.single j 1) * F x :=
      integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (hint' _ _ cjic cF hjic)
        (hint' _ _ cic cjF hic) (hint' _ _ cic cF hic)
        (fun x _ => (hpd i c hc).differentiable (by simp) x)
        (fun x _ => hF.differentiable (by simp) x)
    have hsym : ∀ x, pd j (pd i c) x = pd i (pd j c) x := by
      intro x
      have hdc : Differentiable ℝ (fderiv ℝ c) :=
        ((contDiff_infty_iff_fderiv.mp hc).2).differentiable (by simp)
      have key : ∀ v w : ℝ³, fderiv ℝ (fun y => fderiv ℝ c y v) x w =
          fderiv ℝ (fderiv ℝ c) x w v := by
        intro v w
        rw [fderiv_clm_apply (hdc x) (differentiableAt_const _)]
        simp
      have hs := (hc.contDiffAt (x := x)).isSymmSndFDerivAt (by simp)
      show fderiv ℝ (fun y => fderiv ℝ c y (EuclideanSpace.single i 1)) x
          (EuclideanSpace.single j 1) =
        fderiv ℝ (fun y => fderiv ℝ c y (EuclideanSpace.single j 1)) x
          (EuclideanSpace.single i 1)
      rw [key, key]
      exact hs _ _
    calc ∫ x, pd i (pd j F) x * c x
        = ∫ x, c x * fderiv ℝ (pd j F) x (EuclideanSpace.single i 1) := by
          congr 1; funext x; rw [mul_comm]; rfl
      _ = -∫ x, pd i c x * fderiv ℝ F x (EuclideanSpace.single j 1) := by rw [e1]; rfl
      _ = ∫ x, pd j (pd i c) x * F x := by rw [e2, neg_neg]; rfl
      _ = ∫ x, F x * pd i (pd j c) x := by congr 1; funext x; rw [hsym, mul_comm]

  have hfub : ∀ (G h : ℝ³ → ℝ), Continuous G → Integrable G → Continuous h → HasCompactSupport h →
      ∫ x, newtonPot G x * h x = ∫ y, G y * newtonPot h y := by
    intro G h hGc hGi hhc hhcs
    obtain ⟨H, hH⟩ := hhc.bounded_above_of_compact_support hhcs
    have hΓ₀i : Integrable ((Metric.closedBall (0:ℝ³) 1).indicator newtonKernel) :=
      (integrable_indicator_iff Metric.isClosed_closedBall.measurableSet).mpr
        (hK.integrableOn_isCompact (isCompact_closedBall 0 1))
    have hhi : Integrable h := hhc.integrable_of_hasCompactSupport hhcs
    have hmeasK : Measurable newtonKernel := by unfold newtonKernel; fun_prop
    have hΦm : AEStronglyMeasurable
        (Function.uncurry fun x y => newtonKernel (x - y) * G y * h x) (volume.prod volume) := by
      apply Measurable.aestronglyMeasurable
      exact ((hmeasK.comp (measurable_fst.sub measurable_snd)).mul
        (hGc.measurable.comp measurable_snd)).mul (hhc.measurable.comp measurable_fst)
    have hc1 := hGi.convolution_integrand (ContinuousLinearMap.mul ℝ ℝ) hΓ₀i
    simp only [ContinuousLinearMap.mul_apply'] at hc1
    have hb1 := (hc1.const_mul H).norm
    have hb2 : Integrable (fun p : ℝ³ × ℝ³ => (4 * Real.pi)⁻¹ * (|h p.1| * |G p.2|))
        (volume.prod volume) :=
      (hhi.abs.mul_prod hGi.abs).const_mul _
    have hΦi : Integrable (Function.uncurry fun x y => newtonKernel (x - y) * G y * h x)
        (volume.prod volume) := by
      refine Integrable.mono' (hb1.add hb2) hΦm (Filter.Eventually.of_forall ?_)
      rintro ⟨x, y⟩
      simp only [Function.uncurry_apply_pair, Pi.add_apply]
      have hK0 : 0 ≤ newtonKernel (x - y) := by unfold newtonKernel; positivity
      have hHx : |h x| ≤ H := by have := hH x; rwa [Real.norm_eq_abs] at this
      have hH0 : 0 ≤ H := le_trans (abs_nonneg _) hHx
      have hpos : 0 ≤ (4 * Real.pi)⁻¹ * (|h x| * |G y|) := by positivity
      rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_mul, abs_mul, abs_mul,
        abs_of_nonneg hK0, abs_of_nonneg hH0]
      by_cases hz : ‖x - y‖ ≤ 1
      · have hi : (Metric.closedBall (0:ℝ³) 1).indicator newtonKernel (x - y) =
            newtonKernel (x - y) := by
          exact Set.indicator_of_mem (by simpa [Metric.mem_closedBall] using hz) _
        rw [hi, abs_of_nonneg hK0]
        nlinarith [mul_le_mul_of_nonneg_left hHx (mul_nonneg hK0 (abs_nonneg (G y)))]
      · have hi : (Metric.closedBall (0:ℝ³) 1).indicator newtonKernel (x - y) = 0 := by
          exact Set.indicator_of_notMem (by simpa [Metric.mem_closedBall] using hz) _
        rw [hi, abs_zero, mul_zero, mul_zero, zero_add]
        have hle : newtonKernel (x - y) ≤ (4 * Real.pi)⁻¹ := by
          unfold newtonKernel
          apply inv_anti₀ (by positivity)
          push_neg at hz
          nlinarith [Real.pi_pos]
        nlinarith [mul_le_mul_of_nonneg_right hle
          (mul_nonneg (abs_nonneg (G y)) (abs_nonneg (h x)))]
    have hswap := integral_integral_swap hΦi
    have e1 : (∫ x, newtonPot G x * h x) = ∫ x, ∫ y, newtonKernel (x - y) * G y * h x :=
      integral_congr_ae (Filter.Eventually.of_forall fun x => by
        simp only [newtonPot]; rw [integral_mul_const])
    have e2 : (∫ y, G y * newtonPot h y) = ∫ y, ∫ x, newtonKernel (x - y) * G y * h x :=
      integral_congr_ae (Filter.Eventually.of_forall fun y => by
        simp only [newtonPot]
        rw [← integral_const_mul]
        congr 1
        funext x
        rw [newtonKernel, newtonKernel, norm_sub_rev]
        ring)
    rw [e1, e2]
    exact hswap

  have hN : ∀ i j, ContDiff ℝ ∞ (newtonPot (g i j)) :=
    fun i j => newtonPot_contDiff_of_integrable (g i j) (hg i j) (hgi i j)
  have hTint : ∀ i j, Integrable (fun x => pd i (pd j (newtonPot (g i j))) x * b x) := fun i j =>
    ((hpd i _ (hpd j _ (hN i j))).continuous.mul hb.continuous).integrable_of_hasCompactSupport
      hbc.mul_left
  have hsplit : (fun x => stressPressure g x * b x) =
      fun x => ∑ i, ∑ j, pd i (pd j (newtonPot (g i j))) x * b x := by
    funext x
    simp only [stressPressure, Finset.sum_mul]
  rw [hsplit, integral_finsetSum _ (fun i _ => integrable_finsetSum _ (fun j _ => hTint i j))]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [integral_finsetSum _ (fun j _ => hTint i j)]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  have hjb := hpd j b hb
  have hjbc := hpdc j b hbc
  have hNb : newtonPot (pd j b) = pd j (newtonPot b) := funext fun x => (hs3 b hb hbc j x).symm
  rw [hs4 _ b (hN i j) hb hbc i j, hfub (g i j) (pd i (pd j b)) (hg i j).continuous
    (hgi i j) (hpd i _ hjb).continuous (hpdc i _ hjbc)]
  congr 1
  funext y
  rw [← hs3 (pd j b) hjb hjbc i y, hNb]

theorem newtonPot_decay_of_integral_zero : LocallyIntegrable newtonKernel volume → ∀ g : ℝ³ → ℝ, Continuous g → HasCompactSupport g → (∫ x, g x) = 0 → ∃ C : ℝ, ∀ x : ℝ³, |newtonPot g x| ≤ C * (1 + ‖x‖) ^ (-2 : ℝ) :=
by
  intro hΓ g hg hgs hg0

  obtain ⟨R₀, hR₀⟩ := hgs.isCompact.isBounded.subset_closedBall (0 : ℝ³)
  obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = max R₀ 1 := ⟨_, rfl⟩
  have hR1 : 1 ≤ R := hRdef ▸ le_max_right _ _
  have hRR₀ : R₀ ≤ R := hRdef ▸ le_max_left _ _
  have hR0 : 0 < R := lt_of_lt_of_le one_pos hR1
  have hsupp : ∀ y : ℝ³, R < ‖y‖ → g y = 0 := by
    intro y hy
    apply image_eq_zero_of_notMem_tsupport
    intro hmem
    have h1 := hR₀ hmem
    rw [Metric.mem_closedBall, dist_zero_right] at h1
    linarith

  have hid : newtonPot g = convolution newtonKernel g (ContinuousLinearMap.mul ℝ ℝ) volume := by
    funext x
    rw [convolution_eq_swap]
    simp [newtonPot]
  have hcont : Continuous (newtonPot g) := by
    rw [hid]; exact hgs.continuous_convolution_right _ hΓ hg

  obtain ⟨B₀, hB₀⟩ :=
    (isCompact_closedBall (0 : ℝ³) (2 * R)).exists_bound_of_continuousOn hcont.continuousOn
  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = max B₀ 0 := ⟨_, rfl⟩
  have hB : 0 ≤ B := hBdef ▸ le_max_right _ _
  have hnear : ∀ x : ℝ³, ‖x‖ ≤ 2 * R → |newtonPot g x| ≤ B := by
    intro x hx
    have h1 := hB₀ x (by rw [Metric.mem_closedBall, dist_zero_right]; exact hx)
    rw [Real.norm_eq_abs] at h1
    exact le_trans h1 (hBdef ▸ le_max_left _ _)

  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = ∫ y, |g y| := ⟨_, rfl⟩
  have hM : 0 ≤ M := hMdef ▸ integral_nonneg (fun y => abs_nonneg _)
  have hgi : Integrable g := hg.integrable_of_hasCompactSupport hgs
  have hpi : 0 < Real.pi := Real.pi_pos

  have hker : ∀ x y : ℝ³, ‖y‖ ≤ R → 2 * R ≤ ‖x‖ →
      |newtonKernel (x - y) - newtonKernel x| ≤ R / (2 * Real.pi * ‖x‖ ^ 2) := by
    intro x y hy hx
    have ha : 0 < ‖x‖ := by linarith
    have hb1 : ‖x‖ - ‖y‖ ≤ ‖x - y‖ := norm_sub_norm_le x y
    have hb : ‖x‖ / 2 ≤ ‖x - y‖ := by linarith
    have hb0 : 0 < ‖x - y‖ := by linarith
    have hab : |‖x‖ - ‖x - y‖| ≤ R := by
      have h1 := abs_norm_sub_norm_le x (x - y)
      rw [sub_sub_cancel] at h1
      linarith
    have heq : newtonKernel (x - y) - newtonKernel x =
        (‖x‖ - ‖x - y‖) / (4 * Real.pi * ‖x‖ * ‖x - y‖) := by
      unfold newtonKernel
      field_simp
    rw [heq, abs_div, abs_of_pos (by positivity : (0:ℝ) < 4 * Real.pi * ‖x‖ * ‖x - y‖),
      div_le_div_iff₀ (by positivity) (by positivity)]
    have h1 : |‖x‖ - ‖x - y‖| * (2 * Real.pi * ‖x‖ ^ 2) ≤ R * (2 * Real.pi * ‖x‖ ^ 2) :=
      mul_le_mul_of_nonneg_right hab (by positivity)
    have h2 : 2 * Real.pi * ‖x‖ ^ 2 ≤ 4 * Real.pi * ‖x‖ * ‖x - y‖ := by
      have h3 := mul_nonneg (mul_nonneg (by positivity : (0:ℝ) ≤ 2 * Real.pi) ha.le)
        (by linarith : (0:ℝ) ≤ 2 * ‖x - y‖ - ‖x‖)
      nlinarith
    exact le_trans h1 (mul_le_mul_of_nonneg_left h2 hR0.le)

  have hfar : ∀ x : ℝ³, 2 * R ≤ ‖x‖ →
      |newtonPot g x| ≤ R * M / (2 * Real.pi * ‖x‖ ^ 2) := by
    intro x hx
    have hKi : Integrable (fun y => newtonKernel (x - y) * g y) := by
      have h1 := ((hgs.convolutionExists_right (ContinuousLinearMap.mul ℝ ℝ) hΓ hg) x).integrable_swap
      simpa using h1
    have hci : Integrable (fun y => newtonKernel x * g y) := hgi.const_mul _
    have hzero : ∫ y, newtonKernel x * g y = 0 := by
      rw [integral_const_mul, hg0, mul_zero]
    have hrep : newtonPot g x = ∫ y, (newtonKernel (x - y) - newtonKernel x) * g y := by
      have h1 : (∫ y, (newtonKernel (x - y) - newtonKernel x) * g y) =
          ∫ y, (newtonKernel (x - y) * g y - newtonKernel x * g y) := by
        congr 1; funext y; ring
      rw [h1, integral_sub hKi hci, hzero, sub_zero]
      rfl
    rw [hrep, ← Real.norm_eq_abs]
    have hbound : ∀ y, ‖(newtonKernel (x - y) - newtonKernel x) * g y‖ ≤
        R / (2 * Real.pi * ‖x‖ ^ 2) * |g y| := by
      intro y
      rw [Real.norm_eq_abs, abs_mul]
      by_cases hy : R < ‖y‖
      · rw [hsupp y hy]; simp
      · exact mul_le_mul_of_nonneg_right (hker x y (not_lt.mp hy) hx) (abs_nonneg _)
    calc ‖∫ y, (newtonKernel (x - y) - newtonKernel x) * g y‖
        ≤ ∫ y, R / (2 * Real.pi * ‖x‖ ^ 2) * |g y| :=
          norm_integral_le_of_norm_le (hgi.abs.const_mul _) (Filter.Eventually.of_forall hbound)
      _ = R * M / (2 * Real.pi * ‖x‖ ^ 2) := by
          rw [integral_const_mul, hMdef]; ring

  refine ⟨max (B * (1 + 2 * R) ^ 2) (9 * R * M / (8 * Real.pi)), fun x => ?_⟩
  have hs : 0 ≤ ‖x‖ := norm_nonneg x
  have hpos : 0 < 1 + ‖x‖ := by linarith
  rw [Real.rpow_neg hpos.le, Real.rpow_two, ← div_eq_mul_inv, le_div_iff₀ (by positivity)]
  rcases le_or_gt ‖x‖ (2 * R) with h | h
  · have h1 := hnear x h
    have h2 : (1 + ‖x‖) ^ 2 ≤ (1 + 2 * R) ^ 2 := by gcongr
    calc |newtonPot g x| * (1 + ‖x‖) ^ 2 ≤ B * (1 + 2 * R) ^ 2 :=
          mul_le_mul h1 h2 (by positivity) hB
      _ ≤ _ := le_max_left _ _
  · have h1 := hfar x h.le
    have hs2 : 2 ≤ ‖x‖ := by linarith
    have hx0 : 0 < ‖x‖ := by linarith
    have h2 : (1 + ‖x‖) ^ 2 ≤ 9 / 4 * ‖x‖ ^ 2 := by nlinarith
    have hRM : 0 ≤ R * M / (2 * Real.pi * ‖x‖ ^ 2) :=
      div_nonneg (mul_nonneg hR0.le hM) (by positivity)
    calc |newtonPot g x| * (1 + ‖x‖) ^ 2
        ≤ R * M / (2 * Real.pi * ‖x‖ ^ 2) * (9 / 4 * ‖x‖ ^ 2) :=
          mul_le_mul h1 h2 (by positivity) hRM
      _ = 9 * R * M / (8 * Real.pi) := by field_simp; ring
      _ ≤ _ := le_max_right _ _

theorem newtonPot_green_identity : LocallyIntegrable newtonKernel volume → ∀ b : ℝ³ → ℝ, ContDiff ℝ ∞ b → HasCompactSupport b → ∀ x : ℝ³, ∑ k : Fin 3, newtonPot (pd k (pd k b)) x = - b x :=
by
  intro hΓ b hb hbs x
  have hpi : 0 < Real.pi := Real.pi_pos
  have hfr : Module.finrank ℝ ℝ³ = 3 := finrank_euclideanSpace_fin

  have hpow : ∀ A : ℝ, 0 < A → ∀ (p : ℝ) (n : ℕ), p = (n : ℝ) / 2 → A ^ (-p) = (√A ^ n)⁻¹ := by
    intro A hA p n hp
    rw [Real.rpow_neg hA.le, Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hA.le, hp]
    congr 2
    ring

  have hpdC : ∀ g : ℝ³ → ℝ, ContDiff ℝ ∞ g → ∀ k : Fin 3, ContDiff ℝ ∞ (pd k g) := by
    intro g hg k
    show ContDiff ℝ ∞ (fun x => fderiv ℝ g x (EuclideanSpace.single k 1))
    exact (contDiff_infty_iff_fderiv.mp hg).2.clm_apply contDiff_const
  have hpdS : ∀ g : ℝ³ → ℝ, HasCompactSupport g → ∀ k : Fin 3, HasCompactSupport (pd k g) := by
    intro g hg k
    exact HasCompactSupport.fderiv_apply ℝ hg _
  have hdiff : ∀ g : ℝ³ → ℝ, ContDiff ℝ ∞ g → Differentiable ℝ g :=
    fun g hg => hg.differentiable (by simp)
  have hintc : ∀ f g : ℝ³ → ℝ, Continuous f → Continuous g → HasCompactSupport g →
      Integrable (fun x => f x * g x) :=
    fun f g hf hg hgs => (hf.mul hg).integrable_of_hasCompactSupport hgs.mul_left

  have hibp : ∀ F : ℝ³ → ℝ, ContDiff ℝ ∞ F → ∀ k : Fin 3,
      (∫ y, F y * pd k (pd k b) y) = ∫ y, pd k (pd k F) y * b y := by
    intro F hF k
    have h1 := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume) (f := F)
      (g := pd k b) (v := EuclideanSpace.single k 1)
      (hintc _ _ (hpdC F hF k).continuous (hpdC b hb k).continuous (hpdS b hbs k))
      (hintc _ _ hF.continuous (hpdC _ (hpdC b hb k) k).continuous (hpdS _ (hpdS b hbs k) k))
      (hintc _ _ hF.continuous (hpdC b hb k).continuous (hpdS b hbs k))
      (fun x _ => hdiff F hF x) (fun x _ => hdiff _ (hpdC b hb k) x)
    have h2 := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume) (f := pd k F)
      (g := b) (v := EuclideanSpace.single k 1)
      (hintc _ _ (hpdC _ (hpdC F hF k) k).continuous hb.continuous hbs)
      (hintc _ _ (hpdC F hF k).continuous (hpdC b hb k).continuous (hpdS b hbs k))
      (hintc _ _ (hpdC F hF k).continuous hb.continuous hbs)
      (fun x _ => hdiff _ (hpdC F hF k) x) (fun x _ => hdiff b hb x)
    have e1 : (∫ y, F y * pd k (pd k b) y) = -∫ y, pd k F y * pd k b y := h1
    have e2 : (∫ y, pd k F y * pd k b y) = -∫ y, pd k (pd k F) y * b y := h2
    rw [e1, e2, neg_neg]

  have hderiv : ∀ c : ℝ, 0 < c →
      ContDiff ℝ ∞ (fun y : ℝ³ => (4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ))) ∧
      ∀ y : ℝ³, ∑ k : Fin 3, pd k (pd k (fun y : ℝ³ => (4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)))) y
        = -(c ^ 3 * (3 / (4 * Real.pi) * (1 + ‖c • (x - y)‖ ^ 2) ^ (-(5 / 2 : ℝ)))) := by
    intro c hc
    have hc2 : 0 < (c ^ 2)⁻¹ := by positivity
    have hQpos : ∀ y : ℝ³, 0 < ‖x - y‖ ^ 2 + (c ^ 2)⁻¹ := fun y => by positivity
    have hQc : ContDiff ℝ ∞ (fun y : ℝ³ => ‖x - y‖ ^ 2 + (c ^ 2)⁻¹) :=
      ((contDiff_norm_sq ℝ).comp (contDiff_const.sub contDiff_id)).add contDiff_const
    have hQd' : ∀ y : ℝ³, ∃ L : ℝ³ →L[ℝ] ℝ, HasFDerivAt (fun y : ℝ³ => ‖x - y‖ ^ 2 + (c ^ 2)⁻¹) L y ∧
        ∀ k : Fin 3, L (EuclideanSpace.single k 1) = -2 * (x k - y k) := by
      intro y
      refine ⟨_, (((hasFDerivAt_id y).const_sub x).norm_sq).add_const ((c ^ 2)⁻¹), fun k => ?_⟩
      simp [EuclideanSpace.inner_single_right]
      ring
    choose L hQd hQe using hQd'
    have hP : ∀ (p : ℝ) (y : ℝ³), HasFDerivAt (fun y : ℝ³ => (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ p)
        ((p * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (p - 1)) • L y) y :=
      fun p y => (hQd y).rpow_const (Or.inl (hQpos y).ne')
    have hproj : ∀ (k : Fin 3) (y : ℝ³),
        HasFDerivAt (fun y : ℝ³ => x k - y k) (-(EuclideanSpace.proj k : ℝ³ →L[ℝ] ℝ)) y := by
      intro k y
      exact ((EuclideanSpace.proj k : ℝ³ →L[ℝ] ℝ).hasFDerivAt (x := y)).const_sub (x k)
    have hpd1 : ∀ k : Fin 3, pd k (fun y : ℝ³ => (4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)))
        = fun y => (4 * Real.pi)⁻¹ * ((x k - y k) * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(3 / 2 : ℝ))) := by
      intro k
      funext y
      unfold pd
      rw [((hP (-(1 / 2 : ℝ)) y).const_mul (4 * Real.pi)⁻¹).fderiv, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.smul_apply, hQe, smul_eq_mul, smul_eq_mul,
        show -(1 / 2 : ℝ) - 1 = -(3 / 2) by norm_num]
      ring
    have hpd2 : ∀ (k : Fin 3) (y : ℝ³), pd k (pd k (fun y : ℝ³ => (4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)))) y
        = (4 * Real.pi)⁻¹ * (3 * (x k - y k) ^ 2 * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(5 / 2 : ℝ))
            - (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(3 / 2 : ℝ))) := by
      intro k y
      rw [hpd1 k]
      unfold pd
      have hm : HasFDerivAt (fun y : ℝ³ => (4 * Real.pi)⁻¹ * ((x k - y k) * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(3 / 2 : ℝ)))) _ y :=
        ((hproj k y).mul (hP (-(3 / 2 : ℝ)) y)).const_mul (4 * Real.pi)⁻¹
      rw [hm.fderiv]
      simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply, hQe,
        ContinuousLinearMap.neg_apply, smul_eq_mul]
      rw [show -(3 / 2 : ℝ) - 1 = -(5 / 2) by norm_num]
      simp
      ring
    refine ⟨?_, ?_⟩
    · exact contDiff_const.mul (hQc.rpow_const_of_ne (fun y => (hQpos y).ne'))
    · intro y
      simp only [hpd2]
      have hn : ‖x - y‖ ^ 2 = (x 0 - y 0) ^ 2 + (x 1 - y 1) ^ 2 + (x 2 - y 2) ^ 2 := by
        rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_three]
        simp
      have hsm : ‖c • (x - y)‖ ^ 2 = c ^ 2 * ‖x - y‖ ^ 2 := by
        rw [norm_smul, mul_pow, Real.norm_eq_abs, sq_abs]
      have h1 : 1 + ‖c • (x - y)‖ ^ 2 = c ^ 2 * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) := by
        rw [hsm]; field_simp; ring
      rw [h1, hpow (c ^ 2 * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹)) (by positivity) (5 / 2) 5 (by norm_num),
        hpow _ (hQpos y) (5 / 2) 5 (by norm_num), hpow _ (hQpos y) (3 / 2) 3 (by norm_num),
        Real.sqrt_mul (sq_nonneg c), Real.sqrt_sq hc.le, Fin.sum_univ_three]
      have hs2 : √(‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ 2 = ‖x - y‖ ^ 2 + (c ^ 2)⁻¹ :=
        Real.sq_sqrt (hQpos y).le
      have hsp : 0 < √(‖x - y‖ ^ 2 + (c ^ 2)⁻¹) := Real.sqrt_pos.mpr (hQpos y)
      generalize √(‖x - y‖ ^ 2 + (c ^ 2)⁻¹) = s at hs2 hsp ⊢
      have hn2 : (x 0 - y 0) ^ 2 + (x 1 - y 1) ^ 2 + (x 2 - y 2) ^ 2 = s ^ 2 - (c ^ 2)⁻¹ := by
        rw [← hn]; linarith
      have : (4 * Real.pi)⁻¹ * (3 * (x 0 - y 0) ^ 2 * (s ^ 5)⁻¹ - (s ^ 3)⁻¹) +
          (4 * Real.pi)⁻¹ * (3 * (x 1 - y 1) ^ 2 * (s ^ 5)⁻¹ - (s ^ 3)⁻¹) +
          (4 * Real.pi)⁻¹ * (3 * (x 2 - y 2) ^ 2 * (s ^ 5)⁻¹ - (s ^ 3)⁻¹) =
          (4 * Real.pi)⁻¹ * (3 * ((x 0 - y 0) ^ 2 + (x 1 - y 1) ^ 2 + (x 2 - y 2) ^ 2) * (s ^ 5)⁻¹
            - 3 * (s ^ 3)⁻¹) := by ring
      rw [this, hn2]
      field_simp
      ring

  have hdct : ∀ h : ℝ³ → ℝ, Continuous h → HasCompactSupport h →
      Filter.Tendsto (fun c : ℝ => ∫ y, (4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)) * h y)
        Filter.atTop (nhds (newtonPot h x)) := by
    intro h hc hs
    have hint : Integrable (fun y => newtonKernel (x - y) * h y) := by
      have := (hs.convolutionExists_right (ContinuousLinearMap.mul ℝ ℝ) hΓ hc x).integrable_swap
      simpa using this
    unfold newtonPot
    refine tendsto_integral_filter_of_dominated_convergence (fun y => ‖newtonKernel (x - y) * h y‖)
      ?_ ?_ hint.norm ?_
    · filter_upwards [Filter.eventually_gt_atTop 0] with c hc0
      have hQ : ∀ y : ℝ³, 0 < ‖x - y‖ ^ 2 + (c ^ 2)⁻¹ := fun y => by positivity
      refine Continuous.aestronglyMeasurable ?_
      refine (continuous_const.mul ?_).mul hc
      exact ((continuous_const.sub continuous_id).norm.pow 2 |>.add continuous_const).rpow_const
        (fun y => Or.inl (hQ y).ne')
    · filter_upwards [Filter.eventually_gt_atTop 0] with c hc0
      filter_upwards [Measure.ae_ne volume x] with y hy
      have hd : 0 < ‖x - y‖ := norm_pos_iff.mpr (sub_ne_zero.mpr (Ne.symm hy))
      have hd2 : 0 < ‖x - y‖ ^ 2 := by positivity
      have hle : (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)) ≤ (‖x - y‖ ^ 2) ^ (-(1 / 2 : ℝ)) :=
        Real.rpow_le_rpow_of_nonpos hd2 (by have : 0 < (c ^ 2)⁻¹ := by positivity
                                            linarith) (by norm_num)
      rw [hpow _ hd2 (1 / 2) 1 (by norm_num), Real.sqrt_sq hd.le, pow_one] at hle
      have hnn : 0 ≤ (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)) := Real.rpow_nonneg (by positivity) _
      have hK : (4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)) ≤ newtonKernel (x - y) := by
        rw [newtonKernel, mul_inv (4 * Real.pi) ‖x - y‖]
        exact mul_le_mul_of_nonneg_left hle (by positivity)
      have hK0 : 0 ≤ (4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)) := by positivity
      calc ‖(4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)) * h y‖
          = ((4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ))) * ‖h y‖ := by
            rw [norm_mul _ (h y), Real.norm_of_nonneg hK0]
        _ ≤ newtonKernel (x - y) * ‖h y‖ := mul_le_mul_of_nonneg_right hK (norm_nonneg _)
        _ = ‖newtonKernel (x - y) * h y‖ := by
            rw [norm_mul _ (h y), Real.norm_of_nonneg (hK0.trans hK)]
    · filter_upwards [Measure.ae_ne volume x] with y hy
      have hd : 0 < ‖x - y‖ := norm_pos_iff.mpr (sub_ne_zero.mpr (Ne.symm hy))
      have hd2 : 0 < ‖x - y‖ ^ 2 := by positivity
      have h0 : Filter.Tendsto (fun c : ℝ => (c ^ 2)⁻¹) Filter.atTop (nhds 0) :=
        tendsto_inv_atTop_zero.comp (Filter.tendsto_pow_atTop (by norm_num))
      have h1 := ((h0.const_add (‖x - y‖ ^ 2)).rpow_const (p := -(1 / 2 : ℝ))
        (Or.inl (by rw [add_zero]; exact hd2.ne'))).const_mul (4 * Real.pi)⁻¹ |>.mul_const (h y)
      rw [add_zero, hpow _ hd2 (1 / 2) 1 (by norm_num), Real.sqrt_sq hd.le, pow_one] at h1
      have hN : newtonKernel (x - y) = (4 * Real.pi)⁻¹ * ‖x - y‖⁻¹ := by
        rw [newtonKernel, mul_inv (4 * Real.pi) ‖x - y‖]
      rw [hN]
      exact h1

  have hradial : (∫ y in Ioi (0:ℝ), y ^ (3 - 1) • (3 / (4 * Real.pi) * (1 + y ^ 2) ^ (-(5 / 2 : ℝ))))
      = (4 * Real.pi)⁻¹ := by
    have ht0 : ∀ y : ℝ, 0 < √(1 + y ^ 2) := fun y => Real.sqrt_pos.mpr (by positivity)
    have hGc : Continuous (fun y : ℝ => (4 * Real.pi)⁻¹ * (y / √(1 + y ^ 2)) ^ 3) := by
      refine continuous_const.mul ((continuous_id.div ?_ (fun y => (ht0 y).ne')).pow 3)
      exact (continuous_const.add (continuous_pow 2)).sqrt
    have hGd : ∀ y ∈ Ioi (0:ℝ), HasDerivAt (fun y : ℝ => (4 * Real.pi)⁻¹ * (y / √(1 + y ^ 2)) ^ 3)
        (y ^ (3 - 1) • (3 / (4 * Real.pi) * (1 + y ^ 2) ^ (-(5 / 2 : ℝ)))) y := by
      intro y _
      have h1 : HasDerivAt (fun y : ℝ => 1 + y ^ 2) (2 * y) y := by
        simpa using ((hasDerivAt_pow 2 y).const_add 1)
      have h2 := h1.sqrt (by positivity)
      have h3 := (hasDerivAt_id' y).div h2 (ht0 y).ne'
      have h4 := (h3.pow 3).const_mul (4 * Real.pi)⁻¹
      simp only [Pi.div_apply, Pi.pow_apply] at h4
      convert h4 using 1
      rw [hpow (1 + y ^ 2) (by positivity) (5 / 2) 5 (by norm_num)]
      have htp : 0 < √(1 + y ^ 2) := ht0 y
      have ht2 : √(1 + y ^ 2) ^ 2 = 1 + y ^ 2 := Real.sq_sqrt (by positivity)
      generalize √(1 + y ^ 2) = t at htp ht2 ⊢
      simp only [smul_eq_mul, show (3:ℕ) - 1 = 2 from rfl, Nat.cast_ofNat]
      have htne : t ≠ 0 := htp.ne'
      have hk : 1 * t - y * (2 * y / (2 * t)) = t⁻¹ := by
        field_simp
        nlinarith [ht2]
      rw [hk]
      field_simp
    have hnn : ∀ y ∈ Ioi (0:ℝ), 0 ≤ y ^ (3 - 1) • (3 / (4 * Real.pi) * (1 + y ^ 2) ^ (-(5 / 2 : ℝ))) := by
      intro y _
      rw [smul_eq_mul]
      have : 0 ≤ (1 + y ^ 2) ^ (-(5 / 2 : ℝ)) := Real.rpow_nonneg (by positivity) _
      have : 0 ≤ y ^ (3 - 1) := by norm_num; positivity
      positivity
    have hlim : Filter.Tendsto (fun y : ℝ => (4 * Real.pi)⁻¹ * (y / √(1 + y ^ 2)) ^ 3) Filter.atTop
        (nhds (4 * Real.pi)⁻¹) := by
      have hu : Filter.Tendsto (fun y : ℝ => 1 - (1 + y ^ 2)⁻¹) Filter.atTop (nhds 1) := by
        have : Filter.Tendsto (fun y : ℝ => 1 + y ^ 2) Filter.atTop Filter.atTop :=
          Filter.tendsto_atTop_add_const_left _ _ (Filter.tendsto_pow_atTop (by norm_num))
        simpa using (tendsto_inv_atTop_zero.comp this).const_sub 1
      have hv : Filter.Tendsto (fun y : ℝ => y / √(1 + y ^ 2)) Filter.atTop (nhds 1) := by
        have hs := hu.sqrt
        rw [Real.sqrt_one] at hs
        refine hs.congr' ?_
        filter_upwards [Filter.eventually_ge_atTop 0] with y hy
        have hpos : (0:ℝ) < 1 + y ^ 2 := by positivity
        rw [show 1 - (1 + y ^ 2)⁻¹ = y ^ 2 / (1 + y ^ 2) by field_simp; ring,
          Real.sqrt_div (sq_nonneg y), Real.sqrt_sq hy]
      have := (hv.pow 3).const_mul (4 * Real.pi)⁻¹
      simpa using this
    rw [integral_Ioi_of_hasDerivAt_of_nonneg hGc.continuousWithinAt hGd hnn hlim]
    simp
  have hmass : (∫ z : ℝ³, 3 / (4 * Real.pi) * (1 + ‖z‖ ^ 2) ^ (-(5 / 2 : ℝ))) = 1 := by
    have hvol : (volume : Measure ℝ³).real (Metric.ball 0 1) = 4 * Real.pi / 3 := by
      rw [measureReal_def, EuclideanSpace.volume_ball_fin_three, ENNReal.ofReal_one, one_pow,
        one_mul, ENNReal.toReal_ofReal (by positivity)]
      ring
    rw [integral_fun_norm_addHaar (volume : Measure ℝ³)
      (fun r => 3 / (4 * Real.pi) * (1 + r ^ 2) ^ (-(5 / 2 : ℝ))), hfr, hvol, hradial]
    rw [smul_eq_mul, nsmul_eq_mul]
    push_cast
    field_simp
  have htail : Filter.Tendsto (fun z : ℝ³ => ‖z‖ ^ Module.finrank ℝ ℝ³ *
      (3 / (4 * Real.pi) * (1 + ‖z‖ ^ 2) ^ (-(5 / 2 : ℝ)))) (Bornology.cobounded ℝ³) (nhds 0) := by
    rw [hfr]
    have hr : Filter.Tendsto (fun r : ℝ => r ^ 3 * (3 / (4 * Real.pi) * (1 + r ^ 2) ^ (-(5 / 2 : ℝ))))
        Filter.atTop (nhds 0) := by
      have hb : Filter.Tendsto (fun r : ℝ => 3 / (4 * Real.pi) * r⁻¹) Filter.atTop (nhds 0) := by
        simpa using tendsto_inv_atTop_zero.const_mul (3 / (4 * Real.pi))
      refine squeeze_zero' ?_ ?_ hb
      · filter_upwards [Filter.eventually_ge_atTop 0] with r hr
        have : 0 ≤ (1 + r ^ 2) ^ (-(5 / 2 : ℝ)) := Real.rpow_nonneg (by positivity) _
        positivity
      · filter_upwards [Filter.eventually_ge_atTop 1] with r hr
        rw [hpow (1 + r ^ 2) (by positivity) (5 / 2) 5 (by norm_num)]
        have ht2 : √(1 + r ^ 2) ^ 2 = 1 + r ^ 2 := Real.sq_sqrt (by positivity)
        have ht1 : 1 ≤ √(1 + r ^ 2) := Real.le_sqrt_of_sq_le (by nlinarith)
        have hrt : r ≤ √(1 + r ^ 2) := Real.le_sqrt_of_sq_le (by nlinarith)
        generalize √(1 + r ^ 2) = t at ht2 ht1 hrt ⊢
        have hr0 : 0 < r := by linarith
        have hc : 0 < 3 / (4 * Real.pi) := by positivity
        rw [show r ^ 3 * (3 / (4 * Real.pi) * (t ^ 5)⁻¹) = 3 / (4 * Real.pi) * (r ^ 3 / t ^ 5) by ring]
        gcongr
        rw [div_le_iff₀ (by positivity)]
        have : r ^ 4 ≤ t ^ 4 := by gcongr
        have : t ^ 4 ≤ t ^ 5 := pow_le_pow_right₀ ht1 (by norm_num)
        calc r ^ 3 = r⁻¹ * r ^ 4 := by field_simp
          _ ≤ r⁻¹ * t ^ 5 := by gcongr; linarith
    exact hr.comp tendsto_norm_cobounded_atTop
  have hψnn : ∀ z : ℝ³, 0 ≤ 3 / (4 * Real.pi) * (1 + ‖z‖ ^ 2) ^ (-(5 / 2 : ℝ)) := by
    intro z
    have : 0 ≤ (1 + ‖z‖ ^ 2) ^ (-(5 / 2 : ℝ)) := Real.rpow_nonneg (by positivity) _
    positivity

  have happrox := tendsto_integral_comp_smul_smul_of_integrable' (μ := (volume : Measure ℝ³))
    (φ := fun z : ℝ³ => 3 / (4 * Real.pi) * (1 + ‖z‖ ^ 2) ^ (-(5 / 2 : ℝ))) hψnn hmass htail
    (g := b) (x₀ := x) (hb.continuous.integrable_of_hasCompactSupport hbs) hb.continuous.continuousAt

  have hA : Filter.Tendsto (fun c : ℝ => ∑ k : Fin 3,
      ∫ y, (4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)) * pd k (pd k b) y)
      Filter.atTop (nhds (∑ k : Fin 3, newtonPot (pd k (pd k b)) x)) :=
    tendsto_finsetSum _ (fun k _ => hdct _ (hpdC _ (hpdC b hb k) k).continuous
      (hpdS _ (hpdS b hbs k) k))

  have hB : Filter.Tendsto (fun c : ℝ => ∑ k : Fin 3,
      ∫ y, (4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)) * pd k (pd k b) y)
      Filter.atTop (nhds (-b x)) := by
    refine happrox.neg.congr' ?_
    filter_upwards [Filter.eventually_gt_atTop 0] with c hc
    obtain ⟨hKc, hsum⟩ := hderiv c hc
    have hE : ∀ k : Fin 3,
        (∫ y, (4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)) * pd k (pd k b) y)
          = ∫ y, pd k (pd k (fun y : ℝ³ => (4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)))) y * b y :=
      fun k => hibp _ hKc k
    have hint : ∀ k ∈ (Finset.univ : Finset (Fin 3)), Integrable (fun y =>
        pd k (pd k (fun y : ℝ³ => (4 * Real.pi)⁻¹ * (‖x - y‖ ^ 2 + (c ^ 2)⁻¹) ^ (-(1 / 2 : ℝ)))) y * b y) :=
      fun k _ => hintc _ _ (hpdC _ (hpdC _ hKc k) k).continuous hb.continuous hbs
    simp only [hE]
    rw [← integral_finsetSum _ hint, ← integral_neg]
    congr 1
    funext y
    simp only [smul_eq_mul, hfr]
    rw [← Finset.sum_mul, hsum y]
    ring
  exact tendsto_nhds_unique hA hB

theorem hessian_sq_integral_eq_of_decay : ∀ U : ℝ³ → ℝ, ContDiff ℝ ∞ U → (∀ k : Fin 3, ∃ C : ℝ, ∀ x : ℝ³, |pd k U x| ≤ C * (1 + ‖x‖) ^ (-2 : ℝ)) → (∀ k l : Fin 3, ∃ C : ℝ, ∀ x : ℝ³, |pd k (pd l U) x| ≤ C * (1 + ‖x‖) ^ (-2 : ℝ)) → (∀ k l m : Fin 3, ∃ C : ℝ, ∀ x : ℝ³, |pd k (pd l (pd m U)) x| ≤ C * (1 + ‖x‖) ^ (-2 : ℝ)) → (∀ (i j : Fin 3) (x : ℝ³), pd i (pd j U) x = pd j (pd i U) x) → (∀ (i j k : Fin 3) (x : ℝ³), pd i (pd j (pd k U)) x = pd j (pd i (pd k U)) x) → ∀ i j : Fin 3, MemLp (pd i (pd j U)) 2 ∧ (∫ x, (pd i (pd j U) x) ^ 2) = ∫ x, pd i (pd i U) x * pd j (pd j U) x :=
by
  intro U hU hd1 hd2 hd3 hs2 hs3 i j
  have hpdC : ∀ g : ℝ³ → ℝ, ContDiff ℝ ∞ g → ∀ k : Fin 3, ContDiff ℝ ∞ (pd k g) := by
    intro g hg k
    show ContDiff ℝ ∞ (fun x => fderiv ℝ g x (EuclideanSpace.single k 1))
    exact (contDiff_infty_iff_fderiv.mp hg).2.clm_apply contDiff_const
  have hdiff : ∀ g : ℝ³ → ℝ, ContDiff ℝ ∞ g → ∀ x, DifferentiableAt ℝ g x :=
    fun g hg x => (contDiff_infty_iff_fderiv.mp hg).1 x
  have hdom : Integrable (fun x : ℝ³ => (1 + ‖x‖) ^ (-(4:ℝ))) := by
    apply integrable_one_add_norm
    simp
    norm_num
  have hprod : ∀ F G : ℝ³ → ℝ, Continuous F → Continuous G →
      (∃ C : ℝ, ∀ x : ℝ³, |F x| ≤ C * (1 + ‖x‖) ^ (-2 : ℝ)) →
      (∃ C : ℝ, ∀ x : ℝ³, |G x| ≤ C * (1 + ‖x‖) ^ (-2 : ℝ)) →
      Integrable (fun x => F x * G x) := by
    rintro F G hF hG ⟨C₁, h₁⟩ ⟨C₂, h₂⟩
    refine (hdom.const_mul (C₁ * C₂)).mono' (hF.mul hG).aestronglyMeasurable ?_
    refine Filter.Eventually.of_forall (fun x => ?_)
    have hpos : (0:ℝ) < 1 + ‖x‖ := by positivity
    have ha : (1 + ‖x‖) ^ (-(4:ℝ)) = (1 + ‖x‖) ^ (-2:ℝ) * (1 + ‖x‖) ^ (-2:ℝ) := by
      rw [← Real.rpow_add hpos]; norm_num
    rw [Real.norm_eq_abs, abs_mul, ha]
    calc |F x| * |G x| ≤ (C₁ * (1 + ‖x‖) ^ (-2:ℝ)) * (C₂ * (1 + ‖x‖) ^ (-2:ℝ)) :=
          mul_le_mul (h₁ x) (h₂ x) (abs_nonneg _) ((abs_nonneg _).trans (h₁ x))
      _ = _ := by ring
  have hU1 : ∀ k, ContDiff ℝ ∞ (pd k U) := fun k => hpdC U hU k
  have hU2 : ∀ k l, ContDiff ℝ ∞ (pd k (pd l U)) := fun k l => hpdC _ (hU1 l) k
  have hU3 : ∀ k l m, ContDiff ℝ ∞ (pd k (pd l (pd m U))) := fun k l m => hpdC _ (hU2 l m) k
  have P1 := hprod _ _ (hU2 i j).continuous (hU2 i j).continuous (hd2 i j) (hd2 i j)
  have P2 := hprod _ _ (hU3 i i j).continuous (hU1 j).continuous (hd3 i i j) (hd1 j)
  have P3 := hprod _ _ (hU2 i j).continuous (hU1 j).continuous (hd2 i j) (hd1 j)
  have P4 := hprod _ _ (hU2 j j).continuous (hU2 i i).continuous (hd2 j j) (hd2 i i)
  have P5 := hprod _ _ (hU1 j).continuous (hU3 j i i).continuous (hd1 j) (hd3 j i i)
  have P6 := hprod _ _ (hU1 j).continuous (hU2 i i).continuous (hd1 j) (hd2 i i)
  have hmem : MemLp (pd i (pd j U)) 2 := by
    rw [memLp_two_iff_integrable_sq (hU2 i j).continuous.aestronglyMeasurable]
    simpa [pow_two] using P1
  refine ⟨hmem, ?_⟩
  have E1 : (∫ x, pd i (pd j U) x * pd i (pd j U) x) =
      -∫ x, pd i (pd i (pd j U)) x * pd j U x :=
    integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
      (f := pd i (pd j U)) (g := pd j U) (v := EuclideanSpace.single i 1) P2 P1 P3
      (fun x _ => hdiff _ (hU2 i j) x) (fun x _ => hdiff _ (hU1 j) x)
  have hsym : ∀ x, pd i (pd i (pd j U)) x = pd j (pd i (pd i U)) x := by
    intro x
    rw [show pd i (pd j U) = pd j (pd i U) from funext (hs2 i j)]
    exact hs3 i j i x
  have E2 : (∫ x, pd j U x * pd j (pd i (pd i U)) x) =
      -∫ x, pd j (pd j U) x * pd i (pd i U) x :=
    integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
      (f := pd j U) (g := pd i (pd i U)) (v := EuclideanSpace.single j 1) P4 P5 P6
      (fun x _ => hdiff _ (hU1 j) x) (fun x _ => hdiff _ (hU2 i i) x)
  calc (∫ x, (pd i (pd j U) x) ^ 2) = ∫ x, pd i (pd j U) x * pd i (pd j U) x := by
        congr 1; funext x; ring
    _ = -∫ x, pd i (pd i (pd j U)) x * pd j U x := E1
    _ = -∫ x, pd j U x * pd j (pd i (pd i U)) x := by
        congr 2; funext x; rw [hsym x]; ring
    _ = ∫ x, pd i (pd i U) x * pd j (pd j U) x := by
        rw [E2, neg_neg]; congr 1; funext x; ring

theorem newton_hessian_L2_bound : ∀ b : ℝ³ → ℝ, ContDiff ℝ ∞ b → HasCompactSupport b → ∀ i j : Fin 3, MemLp (pd i (pd j (newtonPot b))) 2 ∧ (∫ x, (pd i (pd j (newtonPot b)) x) ^ 2) ≤ ∫ x, b x ^ 2 :=
by
  intro b hb hbs i j
  have hΓ : LocallyIntegrable newtonKernel volume := by
    rw [locallyIntegrable_iff]
    intro K hK
    obtain ⟨R, hR⟩ := hK.isBounded.subset_closedBall (0 : ℝ³)
    refine IntegrableOn.mono_set ?_ hR
    rw [← integrable_indicator_iff Metric.isClosed_closedBall.measurableSet]
    set f : ℝ → ℝ := fun r => if r ≤ R then (4 * Real.pi * r)⁻¹ else 0 with hf
    have heq : (Metric.closedBall (0:ℝ³) R).indicator newtonKernel = fun x => f ‖x‖ := by
      funext x
      simp [Set.indicator, newtonKernel, Metric.mem_closedBall, dist_zero_right, hf]
    have hrad : IntegrableOn (fun y : ℝ => y ^ (Module.finrank ℝ ℝ³ - 1) • f y) (Ioi 0) := by
      have hfr : Module.finrank ℝ ℝ³ - 1 = 2 := by simp
      rw [hfr]
      have h1 : IntegrableOn (fun y : ℝ => y / (4 * Real.pi)) (Icc 0 R) :=
        (continuous_id.div_const _).integrableOn_Icc
      have h2 : Integrable ((Icc 0 R).indicator (fun y : ℝ => y / (4 * Real.pi))) :=
        (integrable_indicator_iff measurableSet_Icc).2 h1
      refine h2.integrableOn.congr_fun (fun y hy => ?_) measurableSet_Ioi
      have hy0 : 0 < y := hy
      simp only [Set.indicator, Set.mem_Icc, hf, smul_eq_mul]
      split_ifs with ha hb hb
      · field_simp
      · exact absurd ha.2 hb
      · exact absurd ⟨hy0.le, hb⟩ ha
      · simp
    rw [heq]
    exact (integrable_fun_norm_addHaar volume).2 hrad

  have hpdC : ∀ g : ℝ³ → ℝ, ContDiff ℝ ∞ g → ∀ k : Fin 3, ContDiff ℝ ∞ (pd k g) := by
    intro g hg k
    show ContDiff ℝ ∞ (fun x => fderiv ℝ g x (EuclideanSpace.single k 1))
    exact (contDiff_infty_iff_fderiv.mp hg).2.clm_apply contDiff_const
  have hpdS : ∀ g : ℝ³ → ℝ, HasCompactSupport g → ∀ k : Fin 3, HasCompactSupport (pd k g) := by
    intro g hg k
    show HasCompactSupport (fun x => fderiv ℝ g x (EuclideanSpace.single k 1))
    exact HasCompactSupport.fderiv_apply ℝ hg _

  have hint0 : ∀ h : ℝ³ → ℝ, ContDiff ℝ ∞ h → HasCompactSupport h → ∀ n : Fin 3,
      (∫ x, pd n h x) = 0 := by
    intro h hh hhs n
    have hI := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
      (f := fun _ : ℝ³ => (1 : ℝ)) (g := h) (v := EuclideanSpace.single n 1) (by simp)
      (by simp only [one_mul]; exact (hpdC h hh n).continuous.integrable_of_hasCompactSupport (hpdS h hhs n))
      (by simpa using hh.continuous.integrable_of_hasCompactSupport hhs)
      (fun x _ => differentiableAt_const _)
      (fun x _ => (contDiff_infty_iff_fderiv.mp hh).1 x)
    simpa [pd] using hI

  have hsymm : ∀ F : ℝ³ → ℝ, ContDiff ℝ ∞ F → ∀ (a c : Fin 3) (x : ℝ³),
      pd a (pd c F) x = pd c (pd a F) x := by
    intro F hF a c x
    have hd : Differentiable ℝ (fderiv ℝ F) :=
      (contDiff_infty_iff_fderiv.mp (contDiff_infty_iff_fderiv.mp hF).2).1
    have key : ∀ p q : Fin 3, pd p (pd q F) x =
        fderiv ℝ (fderiv ℝ F) x (EuclideanSpace.single p 1) (EuclideanSpace.single q 1) := by
      intro p q
      show fderiv ℝ (fun y => fderiv ℝ F y (EuclideanSpace.single q 1)) x
        (EuclideanSpace.single p 1) = _
      rw [fderiv_clm_apply (hd x) (differentiableAt_const _)]
      simp
    rw [key, key]
    exact (hF.contDiffAt.isSymmSndFDerivAt (by simp)) _ _

  have hP : ∀ g : ℝ³ → ℝ, ContDiff ℝ ∞ g → HasCompactSupport g →
      ContDiff ℝ ∞ (newtonPot g) ∧ ∀ k : Fin 3, pd k (newtonPot g) = newtonPot (pd k g) := by
    intro g hg hgs
    have hid : ∀ h : ℝ³ → ℝ, newtonPot h =
        convolution newtonKernel h (ContinuousLinearMap.mul ℝ ℝ) volume := by
      intro h; funext x
      rw [convolution_eq_swap]
      simp [newtonPot]
    refine ⟨?_, ?_⟩
    · rw [hid]; exact hgs.contDiff_convolution_right _ hΓ hg
    · intro k
      funext x
      have hd := hgs.hasFDerivAt_convolution_right (ContinuousLinearMap.mul ℝ ℝ) hΓ
        (hg.of_le (by simp)) x
      unfold pd
      rw [hid g, hd.fderiv, convolution_precompR_apply _ hΓ (hgs.fderiv ℝ)
        (hg.continuous_fderiv (by simp)), hid]
