  have hWT : lamT (w + ((v - vco h r0 γ c Y) * cib h γ.1) • vtv) = v * cib h γ.1 - r0 := by
    rw [l2, hτκ]; ring
  have hWT' : |lamT (w + ((v - vco h r0 γ c Y) * cib h γ.1) • vtv)| ≤ r0 := by
    rw [hWT, abs_le]; constructor <;> linarith
  obtain ⟨c1, c2⟩ := s3 (Jpow (bandIdx h γ.1) P - c - k) (by rw [hJ]; exact hWR) (by rw [hJ]; exact hWT')
  have d1 : |(Jpow (bandIdx h γ.1) P - c).1 - k.1| < 1/2 := by
    simpa only [Prod.fst_sub] using c1
  have d2 : |(Jpow (bandIdx h γ.1) P - c).2 - k.2| < 1/2 := by
    simpa only [Prod.snd_sub] using c2
  have hJc : Continuous (Jpow (bandIdx h γ.1)) := by unfold Jpow; fun_prop

  have hev : ∀ᶠ Y' in nhds P, rectW h γ c Y' = Jpow (bandIdx h γ.1) Y' - c - k := by
    have o1 : {Y' : ℝ × ℝ | |(Jpow (bandIdx h γ.1) Y' - c).1 - k.1| < 1/2} ∈ nhds P :=
      (isOpen_lt (((hJc.sub continuous_const).fst).sub continuous_const).abs continuous_const).mem_nhds d1
    have o2 : {Y' : ℝ × ℝ | |(Jpow (bandIdx h γ.1) Y' - c).2 - k.2| < 1/2} ∈ nhds P :=
      (isOpen_lt (((hJc.sub continuous_const).snd).sub continuous_const).abs continuous_const).mem_nhds d2
    filter_upwards [o1, o2] with Y' e1 e2
