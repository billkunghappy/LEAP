    rwa [Real.log_exp] at this
  have hyb : Real.log x < rfpYb P.Md P.lam P.T1 P.Lh - 2 := by
    have e : rfpXb P * Real.exp (-2) = Real.exp (rfpYb P.Md P.lam P.T1 P.Lh - 2) := by
      unfold rfpXb; rw [sub_eq_add_neg, Real.exp_add]
    have := Real.log_lt_log hx0 hx2
    rwa [e, Real.log_exp] at this

  have hhold : ∀ v : ℝ, rfpY4 P.Md P.lam + 60 < v → sigA ((v - rfpY4 P.Md P.lam) / 60) = 1 := by
    intro v hv
    exact s2 _ (by rw [le_div_iff₀ (by norm_num)]; linarith)
  have hcollar : ∀ v : ℝ, v < rfpYb P.Md P.lam P.T1 P.Lh - 2 →
      Real.log (tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp v) / (1 - P.ρ)) = 0 := by
    intro v hv
    unfold tailFac
    rw [← Real.exp_sub, Real.log_exp, s1 _ (by linarith)]
    have : (1 - P.ρ * (1 - 0)) / (1 - P.ρ) = 1 := by
      rw [sub_zero, mul_one]; exact div_self (by linarith)
    rw [this, Real.log_one]

  have hLam : HasDerivAt (rfpLam P) (-(1 / 2 + P.h)) (Real.log x) := by
    set y := Real.log x with hy
    have d1 := hSd y
    have d2 := (hSd (y - rfpY2 P.Md)).comp y ((hasDerivAt_id' y).sub_const (rfpY2 P.Md))
    have d3 := (hSd (y - rfpY5 P.Md P.lam)).comp y ((hasDerivAt_id' y).sub_const (rfpY5 P.Md P.lam))
    have d4 := (hSd (y - rfpY5 P.Md P.lam - 1 - P.T1)).comp y
      ((((hasDerivAt_id' y).sub_const (rfpY5 P.Md P.lam)).sub_const 1).sub_const P.T1)
    have hD := ((((((hasDerivAt_const y (Real.log P.Pst)).add ((hasDerivAt_id' y).div_const 10)).sub
      (d1.const_mul (3 / 5))).sub (d2.const_mul P.lam)).sub (d3.const_mul (1 - P.lam))).add
      (d4.const_mul (1 - P.h))).sub (hasDerivAt_const y (Real.log 2))
    have hmem : Ioi (rfpY4 P.Md P.lam + 60) ∩ Iio (rfpYb P.Md P.lam P.T1 P.Lh - 2) ∈ nhds y :=
