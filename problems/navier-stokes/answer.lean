            CP / c * (SC B.h ξ ^ bP * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dP)) := by ring
      rw [e]; linarith
    have hpow := pow_le_pow_left₀ (add_nonneg zero_le_one (div_nonneg hA0 hy0p.le)) r4 k
    rw [mul_pow, mul_pow] at hpow
