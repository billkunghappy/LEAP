        have a3 := (abs_le.1 (hwi 3)).1
        have a4 := (abs_le.1 (hwi 4)).1
        have m2 : 0 ≤ w 2 * (2 * x) + ‖w‖ * (2 * x) := by
          rw [← add_mul]; exact mul_nonneg (by linarith) hA0
        have m3 : 0 ≤ w 3 * (2 * x * f0 x) + ‖w‖ * (2 * x * f0 x) := by
          rw [← add_mul]; exact mul_nonneg (by linarith) hB0
        have m4 : 0 ≤ w 4 * (2 * f0 x) + ‖w‖ * (2 * f0 x) := by
          rw [← add_mul]; exact mul_nonneg (by linarith) hC0
        have n2 := mul_le_mul_of_nonneg_left hA1 hnw
        have n3 := mul_le_mul_of_nonneg_left hB1 hnw
        have n4 := mul_le_mul_of_nonneg_left hC1 hnw
        have eW : ‖w‖ * Wb = ‖w‖ * (2 * r2) + ‖w‖ * (2 * r2 * f0 r1) + ‖w‖ * (2 * f0 r1) := by
