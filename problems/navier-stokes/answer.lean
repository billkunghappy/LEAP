  have gF : osbGood (Ioi 0 ×ˢ Ioo (-1) 1) (Icc a X₂ ×ˢ Ioo (-1) 1) (fun p : ℝ × ℝ => F p.1 p.2) :=
    ⟨hF, fun k => (hcomp a X₂ ha k).imp fun C hC z hz =>
