    have e : Dr = pang5 B G γ * (Real.sqrt (Qb γ.1) *
        fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))) +
        pzr5 B G γ * (Real.sqrt (Qb γ.1) *
        fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))) := by
      rw [hDr, hfd]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    rw [e]
    have := (abs_add_le _ _).trans (add_le_add (mb _ _ _ _ hpa hFr) (mb _ _ _ _ hpz hBr))
    rw [hCD]; linarith
  have hDzb : |Dz| ≤ CD := by
    have e : Dz = pang5 B G γ * (Real.sqrt (Qb γ.1) *
        fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))) +
