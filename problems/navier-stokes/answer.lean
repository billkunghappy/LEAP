  have alg : ∀ q P b E w2 X3 ws B1 B2 : ℝ, q ≤ P → 0 ≤ q → 0 ≤ b → 0 ≤ E * w2 → 0 ≤ X3 * ws →
      E * w2 ≤ B1 → X3 * ws ≤ B2 →
      q * (E * (b * w2) + X3 * (b * ws)) ≤ P * b * (2 * (B2 + B1)) := by
