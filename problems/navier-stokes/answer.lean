    have hξu : ξu ∈ DomC B.h qs := ⟨mul_pos hu hξ0.1, hξ0.2.1, hξ0.2.2⟩
    have hTa : ∀ a : ℝ × ℝ × ℝ, gu u a = F (ξu + ((Lnorm B.h ξu).comp ι) a) := by
