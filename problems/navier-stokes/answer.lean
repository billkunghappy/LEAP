theorem pulse5_profile_track : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G →
    ∃ (l : ℕ) (a1 a2 c1 C1 Ct Cw : ℝ), 0 < a2 ∧ a2 ≤ a1 ∧ 0 < c1 ∧ c1 ≤ C1 ∧ 0 ≤ Ct ∧ 0 ≤ Cw ∧
    ∀ (γ : Lab) (ξ : Cyl), l ≤ γ.1 → ActiveL4 B G γ → ξ ∈ DomC B.h B.qB → etaL B.h γ ξ ≠ 0 →
      ContinuousOn (G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1)) (Set.Icc 0 (Lsb B.h G.r0 γ.1)) ∧
      ∀ v ∈ Set.Icc 0 (Lsb B.h G.r0 γ.1),
