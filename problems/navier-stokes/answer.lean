  obtain ⟨N1, hN1⟩ : ∃ f : ℝ × ℝ → ℝ, f = fun p => lW p * R3 p + Un p.1 p.2 * W1 p -
      axEa Λ t1 κ0 p.1 * R3 p * W1 p + p.1⁻¹ * T p + 4 * (1 / 2 + h) * p.2 * D4 p -
