  have iB : ∀ s : ℝ, IntegrableOn (fun y => Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + s))
      (Iic (Real.log x)) := fun s =>
    hInt _ (hEm'.mul (hbm.comp (by fun_prop))) (P.Pst + |C|) (fun y _ => by
