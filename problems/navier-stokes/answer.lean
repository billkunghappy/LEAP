  · rw [← hsum]
    refine Finset.sum_le_sum (fun k hk => ?_)
    have hk' : k < m + 4 := Finset.mem_range.mp hk
    obtain ⟨t1, t2, t3⟩ := htl k hk'
    exact add_le_add (add_le_add (hT k hk' _ t1) (hT k hk' _ t2)) (hT k hk' _ t3)
  · rw [← hsum]
    refine Finset.sum_le_sum (fun k hk => ?_)
    have hk' : k < m + 4 := Finset.mem_range.mp hk
    obtain ⟨t1, t2, -⟩ := htl k hk'
    obtain ⟨d1, d2, -⟩ := hDk k hk'
    exact add_le_add (add_le_add (add_le_add (hDW _ d1) (hDW _ d2))
      ((hT k hk' _ t1).trans hZW)) ((hT k hk' _ t2).trans hZW)

theorem approx_family_summation : ∀ (h qs Xe Xin c e0 γ : ℝ) (ℓ K : ℕ → ℝ) (A Bv : ℕ → ℝ³ → ℝ → ℝ³) (P : ℕ → ℝ³ → ℝ → ℝ), 0 < h → h < 1 / 2 → 0 < qs → qs ≤ 1 → 0 < Xin → Xin < Xe → 0 < e0 → 0 < γ → SimScaleProps h → ApproxFamily h qs Xe Xin c e0 γ ℓ K A Bv P → ∃ (A' Bv' : ℝ³ → ℝ → ℝ³) (P' : ℝ³ → ℝ → ℝ), LocalPackage h qs Xe Xin c e0 A' Bv' P' :=
by
  intro h qs Xe Xin c e0 γ ℓ K A Bv P hh0 hh1 hqs0 hqs1 hXin hXe he0 hγ hS hAF
  have hAF0 := hAF
  obtain ⟨hsm, hdivAF, hb0, hbj, hres, hext, hint, hgrow⟩ := hAF

  obtain ⟨Ls, hLs⟩ : ∃ Ls : ℕ → ℝ, ∀ m, Ls m = (m : ℝ) + ∑ i ∈ Finset.range (m + 1), |ℓ i| :=
    ⟨_, fun m => rfl⟩
  have hQpos : ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h qs → 0 < simScale h (x 2) (1 - t) := by
    intro x t hxt
    have ht : t < 1 := hxt.1
    exact (hS.1 (x 2) (1 - t) (by linarith)).1
  have hQle1 : ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h qs → simScale h (x 2) (1 - t) ≤ 1 := by
    intro x t hxt
    have hlt : simScale h (x 2) (1 - t) < qs := hxt.2
    linarith
  have hcut : ∀ j m : ℕ, ∃ C : ℝ, 1 ≤ j → ∀ a : ℝ, 0 < a → ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h qs →
      ‖iteratedFDeriv ℝ m (↿(fun y s => simCut h a y s • A j y s)) (x, t)‖ ≤
          C * simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) - Ls m) ∧
      ‖iteratedFDeriv ℝ m (↿(fun y s => simCut h a y s • Bv j y s)) (x, t)‖ ≤
          C * simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) - Ls m) ∧
      ‖iteratedFDeriv ℝ m (↿(fun y s => simCut h a y s • P j y s)) (x, t)‖ ≤
          C * simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) - Ls m) := by
    intro j m
    by_cases hj : 1 ≤ j
    · obtain ⟨C1, h1⟩ := cutoff_product_bound h qs (γ * (j : ℝ)) ℓ (A j) hh0 hh1 hqs0 hqs1 hS (hsm j).1
        (fun m => (hbj j hj m).imp fun C hC x t hxt => (hC x t hxt).1) m
      obtain ⟨C2, h2⟩ := cutoff_product_bound h qs (γ * (j : ℝ)) ℓ (Bv j) hh0 hh1 hqs0 hqs1 hS (hsm j).2.1
        (fun m => (hbj j hj m).imp fun C hC x t hxt => (hC x t hxt).2.1) m
      obtain ⟨C3, h3⟩ := cutoff_product_bound h qs (γ * (j : ℝ)) ℓ (P j) hh0 hh1 hqs0 hqs1 hS (hsm j).2.2
        (fun m => (hbj j hj m).imp fun C hC x t hxt => (hC x t hxt).2.2) m
      refine ⟨|C1| + |C2| + |C3|, fun _ a ha x t hxt => ?_⟩
      have e : γ * (j : ℝ) - Ls m = γ * (j : ℝ) - ((m : ℝ) + ∑ i ∈ Finset.range (m + 1), |ℓ i|) := by
        rw [hLs]
      have hq := Real.rpow_nonneg (hQpos x t hxt).le (γ * (j : ℝ) - Ls m)
      rw [e] at hq ⊢
      refine ⟨(h1 a ha x t hxt).trans (mul_le_mul_of_nonneg_right ?_ hq),
        (h2 a ha x t hxt).trans (mul_le_mul_of_nonneg_right ?_ hq),
        (h3 a ha x t hxt).trans (mul_le_mul_of_nonneg_right ?_ hq)⟩
      · linarith [le_abs_self C1, abs_nonneg C2, abs_nonneg C3]
      · linarith [abs_nonneg C1, le_abs_self C2, abs_nonneg C3]
      · linarith [abs_nonneg C1, abs_nonneg C2, le_abs_self C3]
    · exact ⟨0, fun h1 => absurd h1 hj⟩
  choose Ch hCh using hcut
  obtain ⟨a, ha1, -, ha2, hasmall⟩ := cut_scale_choice γ qs Ch hγ hqs0
  have hapos : ∀ j, 0 < a j := fun j => lt_of_lt_of_le one_pos (ha1 j)

  have hsupp : ∀ j : ℕ, 1 ≤ j → ∀ k : ℕ, k ≤ j → ∀ (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h qs →
      a j * simScale h (x 2) (1 - t) ≤ 1 → ∀ X : ℝ,
      X ≤ Ch j k * simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) - Ls k) →
      X ≤ (1 / 2) ^ j * simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) / 2 - Ls k) := by
    intro j hj k hk x t hxt hsup X hX
    have hq := hQpos x t hxt
    have hqa : simScale h (x 2) (1 - t) ≤ 1 / a j := by
      rw [le_div_iff₀ (hapos j)]
      linarith
    have hs := hasmall j hj k hk _ hq hqa
    have e : simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) - Ls k) =
        simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) / 2) *
          simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) / 2 - Ls k) := by
      rw [← Real.rpow_add hq]
      congr 1
      ring
    rw [e] at hX
    have h1 : 0 ≤ simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) / 2 - Ls k) := Real.rpow_nonneg hq.le _
    have h2 : 0 ≤ simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) / 2) := Real.rpow_nonneg hq.le _
    calc X ≤ Ch j k * (simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) / 2) *
          simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) / 2 - Ls k)) := hX
      _ = (Ch j k * simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) / 2)) *
          simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) / 2 - Ls k) := by ring
      _ ≤ (1 / 2) ^ j * simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) / 2 - Ls k) :=
          mul_le_mul_of_nonneg_right
            (le_trans (mul_le_mul_of_nonneg_right (le_abs_self _) h2) hs) h1
  have hglob : ∀ (j k : ℕ) (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain h qs → ∀ X : ℝ,
      X ≤ Ch j k * simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) - Ls k) →
      X ≤ |Ch j k| * simScale h (x 2) (1 - t) ^ (- Ls k) := by
    intro j k x t hxt X hX
    have hq := hQpos x t hxt
    have hq1 := hQle1 x t hxt
    have hγj : 0 ≤ γ * (j : ℝ) := mul_nonneg hγ.le (Nat.cast_nonneg j)
    have e1 : simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) - Ls k) ≤
        simScale h (x 2) (1 - t) ^ (- Ls k) :=
      Real.rpow_le_rpow_of_exponent_ge hq hq1 (by linarith)
    calc X ≤ Ch j k * simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) - Ls k) := hX
      _ ≤ |Ch j k| * simScale h (x 2) (1 - t) ^ (γ * (j : ℝ) - Ls k) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hq.le _)
      _ ≤ |Ch j k| * simScale h (x 2) (1 - t) ^ (- Ls k) :=
          mul_le_mul_of_nonneg_left e1 (abs_nonneg _)

  obtain ⟨hA1, hA2, hA3⟩ := cutSum_props h qs γ Ls a A hh0 hh1 hqs0 hqs1 hγ hS ha1 ha2
    (fun j => (hsm j).1)
    (fun j hj k hk x t hxt hsup =>
      hsupp j hj k hk x t hxt hsup _ (hCh j k hj (a j) (hapos j) x t hxt).1)
    (fun j hj k => ⟨|Ch j k|, fun x t hxt => hglob j k x t hxt _ (hCh j k hj (a j) (hapos j) x t hxt).1⟩)
  obtain ⟨hB1, hB2, hB3⟩ := cutSum_props h qs γ Ls a Bv hh0 hh1 hqs0 hqs1 hγ hS ha1 ha2
    (fun j => (hsm j).2.1)
    (fun j hj k hk x t hxt hsup =>
      hsupp j hj k hk x t hxt hsup _ (hCh j k hj (a j) (hapos j) x t hxt).2.1)
    (fun j hj k => ⟨|Ch j k|, fun x t hxt => hglob j k x t hxt _ (hCh j k hj (a j) (hapos j) x t hxt).2.1⟩)
  obtain ⟨hP1, hP2, hP3⟩ := cutSum_props h qs γ Ls a P hh0 hh1 hqs0 hqs1 hγ hS ha1 ha2
    (fun j => (hsm j).2.2)
    (fun j hj k hk x t hxt hsup =>
      hsupp j hj k hk x t hxt hsup _ (hCh j k hj (a j) (hapos j) x t hxt).2.2)
    (fun j hj k => ⟨|Ch j k|, fun x t hxt => hglob j k x t hxt _ (hCh j k hj (a j) (hapos j) x t hxt).2.2⟩)
  refine ⟨cutSum h a A, cutSum h a Bv, cutSum h a P, ?_⟩
  unfold LocalPackage
  refine ⟨hA1, hB1, hP1, ?_, ?_, ?_, ?_, ?_⟩
  ·
    exact cutSum_div_tangent h qs a Bv hh0 hh1 hqs0 hqs1 hS ha1 ha2 (fun j => (hsm j).2.1) hdivAF
  ·
    intro m
    obtain ⟨C0, h0⟩ := hb0 m
    obtain ⟨CA, hCA⟩ := hA2 m
    obtain ⟨CB, hCB⟩ := hB2 m
    obtain ⟨CP, hCP⟩ := hP2 m
    refine ⟨|C0| + |CA| + |CB| + |CP|, max (max (K m) (Ls m)) 0, le_max_right _ _,
      fun x t hxt => ?_⟩
    have hq := hQpos x t hxt
    have hq1 := hQle1 x t hxt
    have eK : simScale h (x 2) (1 - t) ^ (-K m) ≤
        simScale h (x 2) (1 - t) ^ (-max (max (K m) (Ls m)) 0) :=
      Real.rpow_le_rpow_of_exponent_ge hq hq1
        (neg_le_neg ((le_max_left _ _).trans (le_max_left _ _)))
    have eL : simScale h (x 2) (1 - t) ^ (-Ls m) ≤
        simScale h (x 2) (1 - t) ^ (-max (max (K m) (Ls m)) 0) :=
      Real.rpow_le_rpow_of_exponent_ge hq hq1
        (neg_le_neg ((le_max_right _ _).trans (le_max_left _ _)))
    have nK := Real.rpow_nonneg hq.le (-K m)
    have nL := Real.rpow_nonneg hq.le (-Ls m)
    have nκ := Real.rpow_nonneg hq.le (-max (max (K m) (Ls m)) 0)
    have comb : ∀ (N N0 C1 C2 : ℝ),
        N ≤ N0 + C2 * simScale h (x 2) (1 - t) ^ (-Ls m) →
        N0 ≤ C1 * simScale h (x 2) (1 - t) ^ (-K m) →
        |C1| + |C2| ≤ |C0| + |CA| + |CB| + |CP| →
        N ≤ (|C0| + |CA| + |CB| + |CP|) * simScale h (x 2) (1 - t) ^ (-max (max (K m) (Ls m)) 0) := by
      intro N N0 C1 C2 hN hN0 hT
      have a1 : C1 * simScale h (x 2) (1 - t) ^ (-K m) ≤
          |C1| * simScale h (x 2) (1 - t) ^ (-max (max (K m) (Ls m)) 0) :=
        le_trans (mul_le_mul_of_nonneg_right (le_abs_self _) nK)
          (mul_le_mul_of_nonneg_left eK (abs_nonneg _))
      have a2 : C2 * simScale h (x 2) (1 - t) ^ (-Ls m) ≤
          |C2| * simScale h (x 2) (1 - t) ^ (-max (max (K m) (Ls m)) 0) :=
        le_trans (mul_le_mul_of_nonneg_right (le_abs_self _) nL)
          (mul_le_mul_of_nonneg_left eL (abs_nonneg _))
      have a3 : (|C1| + |C2|) * simScale h (x 2) (1 - t) ^ (-max (max (K m) (Ls m)) 0) ≤
          (|C0| + |CA| + |CB| + |CP|) * simScale h (x 2) (1 - t) ^ (-max (max (K m) (Ls m)) 0) :=
        mul_le_mul_of_nonneg_right hT nκ
      nlinarith
    obtain ⟨b1, b2, b3⟩ := h0 x t hxt
    refine ⟨comb _ _ C0 CA (hCA x t hxt) b1 ?_, comb _ _ C0 CB (hCB x t hxt) b2 ?_,
      comb _ _ C0 CP (hCP x t hxt) b3 ?_⟩
    · linarith [abs_nonneg CB, abs_nonneg CP]
    · linarith [abs_nonneg CA, abs_nonneg CP]
    · linarith [abs_nonneg CA, abs_nonneg CB]
  ·
    intro x t hxt hr
    obtain ⟨e1, e2, e3, e4⟩ := hext x t hxt hr
    have zA : ∀ j : ℕ, simCut h (a (j + 1)) x t • A (j + 1) x t = 0 := fun j => by
      rw [(e4 (j + 1) (Nat.le_add_left 1 j)).1, smul_zero]
    have zB : ∀ j : ℕ, simCut h (a (j + 1)) x t • Bv (j + 1) x t = 0 := fun j => by
      rw [(e4 (j + 1) (Nat.le_add_left 1 j)).2.1, smul_zero]
    have zP : ∀ j : ℕ, simCut h (a (j + 1)) x t • P (j + 1) x t = 0 := fun j => by
      rw [(e4 (j + 1) (Nat.le_add_left 1 j)).2.2, smul_zero]
    refine ⟨?_, ?_, ?_⟩
    · simp only [cutSum, zA, tsum_zero, add_zero, e1]
    · simp only [cutSum, zB, tsum_zero, add_zero, e2]
    · simp only [cutSum, zP, tsum_zero, add_zero, e3]
  ·
    exact flat_residual_of_tail h qs Xe Xin c e0 γ ℓ K Ls A Bv P (cutSum h a A) (cutSum h a Bv)
      (cutSum h a P) a hh0 hh1 hqs0 hqs1 hγ hS hAF0 ha1 hA1 hB1 hP1
      (fun J k hk x t hxt hJ => ⟨hA3 J k hk x t hxt hJ, hB3 J k hk x t hxt hJ, hP3 J k hk x t hxt hJ⟩)
  ·
    obtain ⟨τ₁, hτ₁, hg⟩ := hgrow
    refine ⟨min τ₁ qs, lt_min hτ₁ hqs0, fun τ hτ hτ1 => ?_⟩
    have hτa : τ < τ₁ := lt_of_lt_of_le hτ1 (min_le_left _ _)
    have hτq : τ < qs := lt_of_lt_of_le hτ1 (min_le_right _ _)
    have hsub : (1 : ℝ) - (1 - τ) = τ := by ring
    have hScont : Continuous (fun y : ℝ³ => simScale h (y 2) τ) :=
      hS.2.2.2.1.continuousOn.comp_continuous (f := fun y : ℝ³ => ((y 2, τ) : ℝ × ℝ))
        (by fun_prop) (fun y => ⟨mem_univ _, hτ⟩)
    have hs0 : simScale h 0 τ = τ := by
      have := (hS.1 0 τ hτ).2
      simpa using this
    obtain ⟨U, hU⟩ : ∃ U : Set ℝ³, U = {y : ℝ³ | simScale h (y 2) τ < qs ∧
        y 0 ^ 2 + y 1 ^ 2 < 4 * Xin * simScale h (y 2) τ} := ⟨_, rfl⟩
    have hUo : IsOpen U := by
      rw [hU]
      exact (isOpen_lt hScont continuous_const).inter
        (isOpen_lt (by fun_prop) (continuous_const.mul hScont))
    have hx2 : (Real.sqrt (2 * Xin * τ) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) 2 = 0 := by simp
    have hx0 : (Real.sqrt (2 * Xin * τ) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) 0 =
        Real.sqrt (2 * Xin * τ) := by simp
    have hx1 : (Real.sqrt (2 * Xin * τ) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) 1 = 0 := by simp
    have hxU : Real.sqrt (2 * Xin * τ) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ) ∈ U := by
      rw [hU]
      refine ⟨?_, ?_⟩
      · show simScale h _ τ < qs
        rw [hx2, hs0]
        exact hτq
      · show _ < 4 * Xin * simScale h _ τ
        rw [hx2, hs0, hx0, hx1, Real.sq_sqrt (by positivity)]
        nlinarith
    have hvan : ∀ y ∈ U, ∀ j : ℕ, 1 ≤ j → A j y (1 - τ) = 0 ∧ Bv j y (1 - τ) = 0 ∧ P j y (1 - τ) = 0 := by
      intro y hy j hj
      rw [hU] at hy
      have hmem : (y, 1 - τ) ∈ simDomain h qs := by
        show 1 - τ < 1 ∧ simScale h (y 2) (1 - (1 - τ)) < qs
        rw [hsub]
        exact ⟨by linarith, hy.1⟩
      exact hint j hj y (1 - τ) hmem (by rw [hsub]; exact hy.2)
    have hcA : ∀ y ∈ U, cutSum h a A y (1 - τ) = A 0 y (1 - τ) := by
      intro y hy
      have zA : ∀ j : ℕ, simCut h (a (j + 1)) y (1 - τ) • A (j + 1) y (1 - τ) = 0 := fun j => by
        rw [(hvan y hy (j + 1) (Nat.le_add_left 1 j)).1, smul_zero]
      simp only [cutSum, zA, tsum_zero, add_zero]
    have hcB : ∀ y ∈ U, cutSum h a Bv y (1 - τ) = Bv 0 y (1 - τ) := by
      intro y hy
      have zB : ∀ j : ℕ, simCut h (a (j + 1)) y (1 - τ) • Bv (j + 1) y (1 - τ) = 0 := fun j => by
        rw [(hvan y hy (j + 1) (Nat.le_add_left 1 j)).2.1, smul_zero]
      simp only [cutSum, zB, tsum_zero, add_zero]
    have hev : (fun w => cutSum h a A w (1 - τ)) =ᶠ[nhds
        (Real.sqrt (2 * Xin * τ) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ))]
        (fun w => A 0 w (1 - τ)) :=
      Filter.eventuallyEq_of_mem (hUo.mem_nhds hxU) (fun y hy => hcA y hy)
    have hcurl : curl3 (fun w => cutSum h a A w (1 - τ))
        (Real.sqrt (2 * Xin * τ) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) =
        curl3 (fun w => A 0 w (1 - τ))
        (Real.sqrt (2 * Xin * τ) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) := by
      unfold curl3
      rw [hev.fderiv_eq]
    rw [hcurl, hcB _ hxU]
    have hp : 0 < τ ^ (-(1 / 2 : ℝ)) := Real.rpow_pos_of_pos hτ _
    have hgr := hg τ hτ hτa
    have hpp := mul_pos he0 hp
    linarith

theorem local_package_box : ∀ (h qs Xe Xin c e0 : ℝ) (A₀ Bv₀ : ℝ³ → ℝ → ℝ³) (P₀ : ℝ³ → ℝ → ℝ), 0 < h → h < 1 / 2 → 0 < qs → qs ≤ 1 → 0 < Xin → Xin < Xe → 0 < e0 → SimScaleProps h → HeatExteriorProps h c → LocalPackage h qs Xe Xin c e0 A₀ Bv₀ P₀ → ∃ (ρ τ₀ : ℝ) (A Bv : ℝ³ → ℝ → ℝ³) (P : ℝ³ → ℝ → ℝ), 0 < ρ ∧ 0 < τ₀ ∧ τ₀ < 1 ∧ ContDiffOn ℝ ∞ (↿A) (Metric.ball (0 : ℝ³) ρ ×ˢ Ioo (1 - τ₀) 1) ∧ ContDiffOn ℝ ∞ (↿Bv) (Metric.ball (0 : ℝ³) ρ ×ˢ Ioo (1 - τ₀) 1) ∧ ContDiffOn ℝ ∞ (↿P) (Metric.ball (0 : ℝ³) ρ ×ˢ Ioo (1 - τ₀) 1) ∧ (∀ x t, ‖x‖ < ρ → 1 - τ₀ < t → t < 1 → divergence (fun y => Bv y t) x = 0 ∧ inner ℝ x (Bv x t) = (0 : ℝ)) ∧ (∀ δ : ℝ, 0 < δ → ∀ m : ℕ, ∃ C : ℝ, ∀ x t, δ ≤ ‖x‖ → ‖x‖ ≤ ρ / 2 → 1 - τ₀ < t → t < 1 → ‖iteratedFDeriv ℝ m (↿A) (x, t)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿Bv) (x, t)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿P) (x, t)‖ ≤ C) ∧ (∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ x t, ‖x‖ < δ → 1 - δ < t → t < 1 → ‖iteratedFDeriv ℝ m (↿(nsResidual 1 (fun y s => curl3 (fun w => A w s) y + Bv y s) P)) (x, t)‖ < ε) ∧ (∀ M δ : ℝ, 0 < δ → ∃ x t, ‖x‖ < δ ∧ 1 - δ < t ∧ t < 1 ∧ M < ‖curl3 (fun w => A w t) x + Bv x t‖) :=
by
  intro h qs Xe Xin c e0 A₀ Bv₀ P₀ hh0 hh1 hqs0 hqs1 hXin hXe he0 hS hH hLP
  unfold SimScaleProps at hS
  unfold HeatExteriorProps at hH
  unfold LocalPackage at hLP
  obtain ⟨hAs, hBs, hPs, hdivB, hpoly, hext, hflat, hgrow⟩ := hLP
  obtain ⟨hS1, hS2, hS3, hS4, _⟩ := hS
  have hθ : 0 < 1 - 2 * h := by linarith
  have hθne : (1 - 2 * h) ≠ 0 := hθ.ne'
  have hinv : ∀ a : ℝ, 0 ≤ a → (a ^ (1 - 2 * h)) ^ (1 / (1 - 2 * h)) = a := by
    intro a ha
    rw [one_div]
    exact Real.rpow_rpow_inv ha hθne
  have hN1 : ∀ x : ℝ³, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]

  have hsmall : ∀ η z τ : ℝ, 0 < η → 0 < τ → τ < η / 4 → 2 * z ^ 2 < (η / 2) ^ (1 - 2 * h) →
      simScale h z τ < η := by
    intro η z τ hη hτ hτη hz
    have h1 := hS3 z τ hτ
    have h2 : (2 * z ^ 2) ^ (1 / (1 - 2 * h)) < ((η / 2) ^ (1 - 2 * h)) ^ (1 / (1 - 2 * h)) :=
      Real.rpow_lt_rpow (by positivity) hz (one_div_pos.mpr hθ)
    rw [hinv (η / 2) (by positivity)] at h2
    linarith

  obtain ⟨τ₀, hτ₀⟩ : ∃ τ₀ : ℝ, τ₀ = min (1 / 2) (qs / 4) := ⟨_, rfl⟩
  have hτ0 : 0 < τ₀ := by rw [hτ₀]; exact lt_min (by norm_num) (by linarith)
  have hτhalf : τ₀ ≤ 1 / 2 := by rw [hτ₀]; exact min_le_left _ _
  have hτqs : τ₀ ≤ qs / 4 := by rw [hτ₀]; exact min_le_right _ _
  have hτ1 : τ₀ < 1 := by linarith
  have ha0 : 0 < (qs / 2) ^ (1 - 2 * h) := Real.rpow_pos_of_pos (by linarith) _
  obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = min 1 (Real.sqrt ((qs / 2) ^ (1 - 2 * h) / 2)) := ⟨_, rfl⟩
  have hρ0 : 0 < ρ := by
    rw [hρ]; exact lt_min one_pos (Real.sqrt_pos.mpr (by positivity))
  have hρ1 : ρ ≤ 1 := by rw [hρ]; exact min_le_left _ _
  have hρsq : ρ ^ 2 ≤ (qs / 2) ^ (1 - 2 * h) / 2 := by
    have h1 : ρ ≤ Real.sqrt ((qs / 2) ^ (1 - 2 * h) / 2) := by rw [hρ]; exact min_le_right _ _
    have := pow_le_pow_left₀ hρ0.le h1 2
    rwa [Real.sq_sqrt (by positivity)] at this
  have hbox : ∀ (x : ℝ³) (t : ℝ), ‖x‖ < ρ → 1 - τ₀ < t → t < 1 → (x, t) ∈ simDomain h qs := by
    intro x t hx ht1 ht2
    show t < 1 ∧ simScale h (x 2) (1 - t) < qs
    refine ⟨ht2, ?_⟩
    apply hsmall qs (x 2) (1 - t) hqs0 (by linarith) (by linarith)
    have hn := hN1 x
    have hxx : ‖x‖ ^ 2 < ρ ^ 2 := pow_lt_pow_left₀ hx (norm_nonneg _) two_ne_zero
    nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]
  have hsub : Metric.ball (0 : ℝ³) ρ ×ˢ Ioo (1 - τ₀) 1 ⊆ simDomain h qs := by
    rintro ⟨x, t⟩ ⟨hx, ht1, ht2⟩
    exact hbox x t (mem_ball_zero_iff.mp hx) ht1 ht2

  have hunb : ∀ M δ : ℝ, 0 < δ → ∃ x t, ‖x‖ < δ ∧ 1 - δ < t ∧ t < 1 ∧
      M < ‖curl3 (fun w => A₀ w t) x + Bv₀ x t‖ := by
    intro M δ hδ
    obtain ⟨τ₁, hτ₁, hg⟩ := hgrow
    have hM1 : 0 < |M| + 1 := by positivity
    have hb : 0 < e0 / (|M| + 1) := div_pos he0 hM1
    obtain ⟨μ, hμ⟩ : ∃ μ : ℝ,
        μ = min (min τ₁ δ) (min (δ ^ 2 / (2 * Xin)) ((e0 / (|M| + 1)) ^ 2)) := ⟨_, rfl⟩
    have hμ0 : 0 < μ := by
      rw [hμ]; exact lt_min (lt_min hτ₁ hδ) (lt_min (by positivity) (by positivity))
    have e1 : μ ≤ τ₁ := by rw [hμ]; exact (min_le_left _ _).trans (min_le_left _ _)
    have e2 : μ ≤ δ := by rw [hμ]; exact (min_le_left _ _).trans (min_le_right _ _)
    have e3 : μ ≤ δ ^ 2 / (2 * Xin) := by rw [hμ]; exact (min_le_right _ _).trans (min_le_left _ _)
    have e4 : μ ≤ (e0 / (|M| + 1)) ^ 2 := by
      rw [hμ]; exact (min_le_right _ _).trans (min_le_right _ _)
    have hτ0' : 0 < μ / 2 := by linarith
    refine ⟨Real.sqrt (2 * Xin * (μ / 2)) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ), 1 - μ / 2,
      ?_, by linarith, by linarith, ?_⟩
    · rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
        abs_of_nonneg (Real.sqrt_nonneg _), Real.sqrt_lt' hδ]
      have h1 : 2 * Xin * (μ / 2) < 2 * Xin * (δ ^ 2 / (2 * Xin)) := by
        apply mul_lt_mul_of_pos_left _ (by positivity); linarith
      have h2 : 2 * Xin * (δ ^ 2 / (2 * Xin)) = δ ^ 2 := by field_simp
      linarith
    · have hgr := hg (μ / 2) hτ0' (by linarith)
      have hsq : Real.sqrt (μ / 2) < e0 / (|M| + 1) := (Real.sqrt_lt' hb).mpr (by linarith)
      have hsp : 0 < Real.sqrt (μ / 2) := Real.sqrt_pos.mpr hτ0'
      have hrw : (μ / 2) ^ (-(1 / 2 : ℝ)) = (Real.sqrt (μ / 2))⁻¹ := by
        rw [Real.rpow_neg hτ0'.le, Real.sqrt_eq_rpow]
      have h3 : |M| + 1 < e0 * (Real.sqrt (μ / 2))⁻¹ := by
        rw [← div_eq_mul_inv, lt_div_iff₀ hsp]
        rw [lt_div_iff₀ hM1] at hsq
        linarith
      rw [hrw] at hgr
      have := le_abs_self M
      linarith

  have hbd : ∀ δ : ℝ, 0 < δ → ∀ m : ℕ, ∃ C : ℝ, ∀ x t, δ ≤ ‖x‖ → ‖x‖ ≤ ρ / 2 → 1 - τ₀ < t →
      t < 1 → ‖iteratedFDeriv ℝ m (↿A₀) (x, t)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿Bv₀) (x, t)‖ ≤ C ∧
        ‖iteratedFDeriv ℝ m (↿P₀) (x, t)‖ ≤ C := by
    intro δ hδ m
    obtain ⟨C, κ, hκ, hCb⟩ := hpoly m
    obtain ⟨CH, hCH⟩ := hH.2.2.2 (δ / 2) (half_pos hδ) m
    have hXe0 : 0 < Xe := by linarith
    have hc1 : 0 < (δ ^ 2 / 4) ^ (1 / (1 - 2 * h)) := Real.rpow_pos_of_pos (by positivity) _
    have hc2 : 0 < δ ^ 2 / (4 * Xe) := by positivity
    obtain ⟨cc, hcc⟩ : ∃ cc : ℝ,
        cc = min ((δ ^ 2 / 4) ^ (1 / (1 - 2 * h))) (δ ^ 2 / (4 * Xe)) := ⟨_, rfl⟩
    have hcc0 : 0 < cc := by rw [hcc]; exact lt_min hc1 hc2
    have hcc1 : cc ≤ (δ ^ 2 / 4) ^ (1 / (1 - 2 * h)) := by rw [hcc]; exact min_le_left _ _
    have hcc2 : cc ≤ δ ^ 2 / (4 * Xe) := by rw [hcc]; exact min_le_right _ _
    obtain ⟨B, hB⟩ : ∃ B : Set (ℝ³ × ℝ), B = Metric.ball (0 : ℝ³) ρ ×ˢ Ioo (1 - τ₀) 1 :=
      ⟨_, rfl⟩
    have hBo : IsOpen B := by rw [hB]; exact Metric.isOpen_ball.prod isOpen_Ioo
    have hgc : ContinuousOn (fun w : ℝ³ × ℝ =>
        w.1 0 ^ 2 + w.1 1 ^ 2 - 2 * Xe * simScale h (w.1 2) (1 - w.2)) B := by
      have hq : ContinuousOn (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) B := by
        have hφ : Continuous (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)) := by fun_prop
        refine hS4.continuousOn.comp hφ.continuousOn ?_
        rintro ⟨x, t⟩ hw
        rw [hB] at hw
        exact ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith [hw.2.2]⟩
      have hc0 : Continuous (fun w : ℝ³ × ℝ => w.1 0 ^ 2 + w.1 1 ^ 2) := by fun_prop
      exact hc0.continuousOn.sub (continuousOn_const.mul hq)
    obtain ⟨O, hO⟩ : ∃ O : Set (ℝ³ × ℝ), O = B ∩ (fun w : ℝ³ × ℝ =>
        w.1 0 ^ 2 + w.1 1 ^ 2 - 2 * Xe * simScale h (w.1 2) (1 - w.2)) ⁻¹' Ioi 0 := ⟨_, rfl⟩
    have hOo : IsOpen O := by rw [hO]; exact hgc.isOpen_inter_preimage hBo isOpen_Ioi
    have hOext : ∀ w ∈ O, (↿A₀) w = 0 ∧ (↿Bv₀) w = (↿(heatSwirl h c)) w ∧
        (↿P₀) w = (↿(heatPressure h c)) w := by
      rintro ⟨y, s⟩ hw
      rw [hO, hB] at hw
      obtain ⟨⟨hy, hs1, hs2⟩, hg⟩ := hw
      have hg' : 2 * Xe * simScale h (y 2) (1 - s) < y 0 ^ 2 + y 1 ^ 2 := by
        simp only [mem_preimage, mem_Ioi] at hg; linarith
      exact hext y s (hbox y s (mem_ball_zero_iff.mp hy) hs1 hs2) hg'
    refine ⟨max (|C| * cc ^ (-κ)) (max CH 0), ?_⟩
    intro x t hx1 hx2 ht1 ht2
    have hρ2 : ‖x‖ < ρ := by linarith
    have hΩ := hbox x t hρ2 ht1 ht2
    have hτ : 0 < 1 - t := by linarith
    have hq0 := (hS1 (x 2) (1 - t) hτ).1
    by_cases hcase : cc ≤ simScale h (x 2) (1 - t)
    · have hpow : simScale h (x 2) (1 - t) ^ (-κ) ≤ cc ^ (-κ) :=
        Real.rpow_le_rpow_of_nonpos hcc0 hcase (by linarith)
      have hpos : 0 < simScale h (x 2) (1 - t) ^ (-κ) := Real.rpow_pos_of_pos hq0 _
      have key : C * simScale h (x 2) (1 - t) ^ (-κ) ≤ max (|C| * cc ^ (-κ)) (max CH 0) := by
        refine le_trans ?_ (le_max_left _ _)
        calc C * simScale h (x 2) (1 - t) ^ (-κ)
            ≤ |C| * simScale h (x 2) (1 - t) ^ (-κ) :=
              mul_le_mul_of_nonneg_right (le_abs_self C) hpos.le
          _ ≤ |C| * cc ^ (-κ) := mul_le_mul_of_nonneg_left hpow (abs_nonneg C)
      obtain ⟨b1, b2, b3⟩ := hCb x t hΩ
      exact ⟨b1.trans key, b2.trans key, b3.trans key⟩
    · push_neg at hcase
      have hz : x 2 ^ 2 < δ ^ 2 / 4 := by
        by_contra hcon
        push_neg at hcon
        have h1 := (hS2 (x 2) (1 - t) hτ).2
        have h2 : (δ ^ 2 / 4) ^ (1 / (1 - 2 * h)) <
            (simScale h (x 2) (1 - t) ^ (1 - 2 * h)) ^ (1 / (1 - 2 * h)) :=
          Real.rpow_lt_rpow (by positivity) (lt_of_le_of_lt hcon h1) (one_div_pos.mpr hθ)
        rw [hinv _ hq0.le] at h2
        linarith
      have hn := hN1 x
      have hxsq : δ ^ 2 ≤ ‖x‖ ^ 2 := pow_le_pow_left₀ hδ.le hx1 2
      have hr : 3 * δ ^ 2 / 4 < x 0 ^ 2 + x 1 ^ 2 := by linarith
      have hqc : 2 * Xe * simScale h (x 2) (1 - t) < δ ^ 2 / 2 := by
        have h1 : simScale h (x 2) (1 - t) < δ ^ 2 / (4 * Xe) := lt_of_lt_of_le hcase hcc2
        rw [lt_div_iff₀ (by positivity)] at h1
        linarith
      have hmem : ((x, t) : ℝ³ × ℝ) ∈ O := by
        rw [hO, hB]
        refine ⟨⟨mem_ball_zero_iff.mpr hρ2, ht1, ht2⟩, ?_⟩
        simp only [mem_preimage, mem_Ioi]
        nlinarith
      have hnhds := hOo.mem_nhds hmem
      have evA : (↿A₀) =ᶠ[nhds (x, t)] (fun _ => (0 : ℝ³)) :=
        Filter.eventuallyEq_of_mem hnhds (fun w hw => (hOext w hw).1)
      have evB : (↿Bv₀) =ᶠ[nhds (x, t)] ↿(heatSwirl h c) :=
        Filter.eventuallyEq_of_mem hnhds (fun w hw => (hOext w hw).2.1)
      have evP : (↿P₀) =ᶠ[nhds (x, t)] ↿(heatPressure h c) :=
        Filter.eventuallyEq_of_mem hnhds (fun w hw => (hOext w hw).2.2)
      have hx1' : ‖x‖ ≤ 1 := by linarith
      have hxle : ‖x‖ ^ 2 ≤ 1 := by nlinarith [norm_nonneg x]
      have hd2 : (δ / 2) ^ 2 = δ ^ 2 / 4 := by ring
      obtain ⟨hb1, hb2⟩ := hCH x t (by rw [hd2]; linarith [sq_nonneg δ])
        (by nlinarith [sq_nonneg (x 2)]) (by linarith) ht2
      refine ⟨?_, ?_, ?_⟩
      · rw [(evA.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
        simp only [Pi.zero_apply, norm_zero]
        exact le_trans (le_max_right _ _) (le_max_right _ _)
      · rw [(evB.iteratedFDeriv ℝ m).eq_of_nhds]
        exact hb1.trans ((le_max_left _ _).trans (le_max_right _ _))
      · rw [(evP.iteratedFDeriv ℝ m).eq_of_nhds]
        exact hb2.trans ((le_max_left _ _).trans (le_max_right _ _))

  have hfl : ∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ x t, ‖x‖ < δ → 1 - δ < t → t < 1 →
      ‖iteratedFDeriv ℝ m (↿(nsResidual 1 (fun y s => curl3 (fun w => A₀ w s) y + Bv₀ y s) P₀))
        (x, t)‖ < ε := by
    intro m ε hε
    obtain ⟨C, δ₁, hδ₁, hC⟩ := hflat m 1
    have hC1 : 0 < |C| + 1 := by positivity
    obtain ⟨η, hη⟩ : ∃ η : ℝ, η = min δ₁ (ε / (|C| + 1)) := ⟨_, rfl⟩
    have hη0 : 0 < η := by rw [hη]; exact lt_min hδ₁ (div_pos hε hC1)
    have hη1 : η ≤ δ₁ := by rw [hη]; exact min_le_left _ _
    have hη2 : η ≤ ε / (|C| + 1) := by rw [hη]; exact min_le_right _ _
    have ha : 0 < (η / 2) ^ (1 - 2 * h) := Real.rpow_pos_of_pos (by linarith) _
    obtain ⟨δ, hδ⟩ : ∃ δ : ℝ,
        δ = min (min ρ τ₀) (min (η / 4) (Real.sqrt ((η / 2) ^ (1 - 2 * h) / 2))) := ⟨_, rfl⟩
    have hsq0 : 0 < Real.sqrt ((η / 2) ^ (1 - 2 * h) / 2) := Real.sqrt_pos.mpr (by positivity)
    have hδ0 : 0 < δ := by
      rw [hδ]; exact lt_min (lt_min hρ0 hτ0) (lt_min (by linarith) hsq0)
    have d1 : δ ≤ ρ := by rw [hδ]; exact (min_le_left _ _).trans (min_le_left _ _)
    have d2 : δ ≤ τ₀ := by rw [hδ]; exact (min_le_left _ _).trans (min_le_right _ _)
    have d3 : δ ≤ η / 4 := by rw [hδ]; exact (min_le_right _ _).trans (min_le_left _ _)
    have d4 : δ ≤ Real.sqrt ((η / 2) ^ (1 - 2 * h) / 2) := by
      rw [hδ]; exact (min_le_right _ _).trans (min_le_right _ _)
    have d4' : δ ^ 2 ≤ (η / 2) ^ (1 - 2 * h) / 2 := by
      have := pow_le_pow_left₀ hδ0.le d4 2
      rwa [Real.sq_sqrt (by positivity)] at this
    refine ⟨δ, hδ0, ?_⟩
    intro x t hx ht1 ht2
    have hΩ := hbox x t (by linarith) (by linarith) ht2
    have hτ : 0 < 1 - t := by linarith
    have hn := hN1 x
    have hxx : ‖x‖ ^ 2 < δ ^ 2 := pow_lt_pow_left₀ hx (norm_nonneg _) two_ne_zero
    have hq := hsmall η (x 2) (1 - t) hη0 hτ (by linarith)
      (by nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)])
    have hq0 := (hS1 (x 2) (1 - t) hτ).1
    have hb := hC x t hΩ (by linarith)
    rw [pow_one] at hb
    have hq2 : simScale h (x 2) (1 - t) * (|C| + 1) < ε := by
      have h1 := lt_of_lt_of_le hq hη2
      rwa [lt_div_iff₀ hC1] at h1
    calc _ ≤ C * simScale h (x 2) (1 - t) := hb
      _ ≤ |C| * simScale h (x 2) (1 - t) :=
          mul_le_mul_of_nonneg_right (le_abs_self C) hq0.le
      _ < ε := by nlinarith
  refine ⟨ρ, τ₀, A₀, Bv₀, P₀, hρ0, hτ0, hτ1, hAs.mono hsub, hBs.mono hsub, hPs.mono hsub,
    fun x t hx ht1 ht2 => hdivB x t (hbox x t hx ht1 ht2), hbd, hfl, hunb⟩

theorem ns_local_blowup_field : ∃ (ρ τ₀ : ℝ) (A Bv : ℝ³ → ℝ → ℝ³) (P : ℝ³ → ℝ → ℝ), 0 < ρ ∧ 0 < τ₀ ∧ τ₀ < 1 ∧ ContDiffOn ℝ ∞ (↿A) (Metric.ball (0 : ℝ³) ρ ×ˢ Ioo (1 - τ₀) 1) ∧ ContDiffOn ℝ ∞ (↿Bv) (Metric.ball (0 : ℝ³) ρ ×ˢ Ioo (1 - τ₀) 1) ∧ ContDiffOn ℝ ∞ (↿P) (Metric.ball (0 : ℝ³) ρ ×ˢ Ioo (1 - τ₀) 1) ∧ (∀ x t, ‖x‖ < ρ → 1 - τ₀ < t → t < 1 → divergence (fun y => Bv y t) x = 0 ∧ inner ℝ x (Bv x t) = (0 : ℝ)) ∧ (∀ δ : ℝ, 0 < δ → ∀ m : ℕ, ∃ C : ℝ, ∀ x t, δ ≤ ‖x‖ → ‖x‖ ≤ ρ / 2 → 1 - τ₀ < t → t < 1 → ‖iteratedFDeriv ℝ m (↿A) (x, t)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿Bv) (x, t)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿P) (x, t)‖ ≤ C) ∧ (∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ x t, ‖x‖ < δ → 1 - δ < t → t < 1 → ‖iteratedFDeriv ℝ m (↿(nsResidual 1 (fun y s => curl3 (fun w => A w s) y + Bv y s) P)) (x, t)‖ < ε) ∧ (∀ M δ : ℝ, 0 < δ → ∃ x t, ‖x‖ < δ ∧ 1 - δ < t ∧ t < 1 ∧ M < ‖curl3 (fun w => A w t) x + Bv x t‖) :=
by
  obtain ⟨h, qs, Xe, Xin, c, e0, γ, ℓ, K, A, Bv, P, hh0, hh1, hqs0, hqs1, hXin, hXe, he0, hγ, hAF⟩ :=
    ns_approximate_family
  have hS : SimScaleProps h := simScale_props h hh0 hh1
  have hH : HeatExteriorProps h c := heat_exterior_field h c hh0 hh1
  obtain ⟨A', Bv', P', hLP⟩ :=
    approx_family_summation h qs Xe Xin c e0 γ ℓ K A Bv P hh0 hh1 hqs0 hqs1 hXin hXe he0 hγ hS hAF
  exact local_package_box h qs Xe Xin c e0 A' Bv' P' hh0 hh1 hqs0 hqs1 hXin hXe he0 hS hH hLP

theorem radial_time_cutoff_exists : ∀ (ρ τ₀ : ℝ), 0 < ρ → 0 < τ₀ → ∃ c : ℝ³ → ℝ → ℝ, ContDiff ℝ ∞ (↿c) ∧ (∀ y s, (ρ / 2 < ‖y‖ ∨ s < 1 - τ₀ / 2) → c y s = 0) ∧ (∀ y s, ‖y‖ < ρ / 4 → 1 - τ₀ / 4 < s → c y s = 1) ∧ (∀ (y : ℝ³) (s : ℝ) (v : ℝ³), inner ℝ y v = (0 : ℝ) → fderiv ℝ (fun w => c w s) y v = 0) ∧ (∀ k : ℕ, ∃ C : ℝ, ∀ z, ‖iteratedFDeriv ℝ k (↿c) z‖ ≤ C) :=
by
  intro ρ τ₀ hρ hτ₀

  have hgen : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (g : E → ℝ) (K : Set E),
      ContDiff ℝ ∞ g → IsCompact K → (∀ x, x ∉ K → g =ᶠ[nhds x] fun _ => g x) →
      (∀ x, ‖g x‖ ≤ 1) → ∀ k : ℕ, ∃ C : ℝ, ∀ x, ‖iteratedFDeriv ℝ k g x‖ ≤ C := by
    intro E _ _ g K hg hK hloc hb k
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · exact ⟨1, fun x => by rw [norm_iteratedFDeriv_zero]; exact hb x⟩
    · have hcont : Continuous (fun x => iteratedFDeriv ℝ k g x) :=
        hg.continuous_iteratedFDeriv (by exact_mod_cast le_top)
      obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hcont.continuousOn
      refine ⟨max C 0, fun x => ?_⟩
      by_cases hx : x ∈ K
      · exact (hC x hx).trans (le_max_left _ _)
      · have h1 := ((hloc x hx).iteratedFDeriv ℝ k).eq_of_nhds
        rw [h1, iteratedFDeriv_const_of_ne (Nat.pos_iff_ne_zero.mp hk)]
        simp
  obtain ⟨χ, hχ⟩ : ∃ χ : ℝ³ → ℝ,
      χ = fun y => Real.smoothTransition ((ρ ^ 2 / 4 - ‖y‖ ^ 2) / (3 * ρ ^ 2 / 16)) := ⟨_, rfl⟩
  obtain ⟨η, hη⟩ : ∃ η : ℝ → ℝ,
      η = fun s => Real.smoothTransition ((s - (1 - τ₀ / 2)) / (τ₀ / 4)) := ⟨_, rfl⟩
  have hχs : ContDiff ℝ ∞ χ := by
    rw [hχ]
    exact Real.smoothTransition.contDiff.comp ((contDiff_const.sub (contDiff_norm_sq ℝ)).div_const _)
  have hηs : ContDiff ℝ ∞ η := by
    rw [hη]
    exact Real.smoothTransition.contDiff.comp ((contDiff_id.sub contDiff_const).div_const _)
  have hχ0 : ∀ y : ℝ³, ρ / 2 < ‖y‖ → χ y = 0 := by
    intro y hy
    rw [hχ]
    apply Real.smoothTransition.zero_of_nonpos
    apply div_nonpos_of_nonpos_of_nonneg
    · nlinarith [norm_nonneg y]
    · positivity
  have hχ1 : ∀ y : ℝ³, ‖y‖ < ρ / 4 → χ y = 1 := by
    intro y hy
    rw [hχ]
    apply Real.smoothTransition.one_of_one_le
    rw [le_div_iff₀ (by positivity)]
    nlinarith [norm_nonneg y]
  have hη0 : ∀ s : ℝ, s < 1 - τ₀ / 2 → η s = 0 := by
    intro s hs
    rw [hη]
    apply Real.smoothTransition.zero_of_nonpos
    apply div_nonpos_of_nonpos_of_nonneg
    · linarith
    · linarith
  have hη1 : ∀ s : ℝ, 1 - τ₀ / 4 < s → η s = 1 := by
    intro s hs
    rw [hη]
    apply Real.smoothTransition.one_of_one_le
    rw [le_div_iff₀ (by linarith)]
    linarith
  have hχb : ∀ y, ‖χ y‖ ≤ 1 := by
    intro y
    rw [hχ, Real.norm_eq_abs, abs_of_nonneg (Real.smoothTransition.nonneg _)]
    exact Real.smoothTransition.le_one _
  have hηb : ∀ s, ‖η s‖ ≤ 1 := by
    intro s
    rw [hη, Real.norm_eq_abs, abs_of_nonneg (Real.smoothTransition.nonneg _)]
    exact Real.smoothTransition.le_one _
  have hχloc : ∀ x, x ∉ Metric.closedBall (0 : ℝ³) (ρ / 2) → χ =ᶠ[nhds x] fun _ => χ x := by
    intro x hx
    have hx' : ρ / 2 < ‖x‖ := by
      rw [Metric.mem_closedBall, dist_zero_right, not_le] at hx
      exact hx
    have hU : {w : ℝ³ | ρ / 2 < ‖w‖} ∈ nhds x :=
      (isOpen_lt continuous_const continuous_norm).mem_nhds hx'
    filter_upwards [hU] with w hw
    rw [hχ0 w hw, hχ0 x hx']
  have hηloc : ∀ s, s ∉ Icc (1 - τ₀ / 2) (1 - τ₀ / 4) → η =ᶠ[nhds s] fun _ => η s := by
    intro s hs
    rw [mem_Icc, not_and_or, not_le, not_le] at hs
    rcases hs with hs | hs
    · filter_upwards [Iio_mem_nhds hs] with w hw
      rw [hη0 w hw, hη0 s hs]
    · filter_upwards [Ioi_mem_nhds hs] with w hw
      rw [hη1 w hw, hη1 s hs]
  obtain ⟨Cχ, hCχ⟩ : ∃ C : ℕ → ℝ, ∀ i x, ‖iteratedFDeriv ℝ i χ x‖ ≤ C i := by
    choose C hC using hgen χ _ hχs (isCompact_closedBall (0 : ℝ³) (ρ / 2)) hχloc hχb
    exact ⟨C, hC⟩
  obtain ⟨Cη, hCη⟩ : ∃ C : ℕ → ℝ, ∀ i x, ‖iteratedFDeriv ℝ i η x‖ ≤ C i := by
    choose C hC using hgen η _ hηs (isCompact_Icc (a := 1 - τ₀ / 2) (b := 1 - τ₀ / 4)) hηloc hηb
    exact ⟨C, hC⟩
  refine ⟨fun y s => χ y * η s, ?_, ?_, ?_, ?_, ?_⟩
  · show ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => χ z.1 * η z.2)
    exact (hχs.comp contDiff_fst).mul (hηs.comp contDiff_snd)
  · intro y s h
    show χ y * η s = 0
    rcases h with h | h
    · rw [hχ0 y h, zero_mul]
    · rw [hη0 s h, mul_zero]
  · intro y s hy hs
    show χ y * η s = 1
    rw [hχ1 y hy, hη1 s hs, one_mul]
  · intro y s v hv
    show fderiv ℝ (fun w => χ w * η s) y v = 0
    have hh0 : ContDiff ℝ 1
        (fun r : ℝ => Real.smoothTransition ((ρ ^ 2 / 4 - r) / (3 * ρ ^ 2 / 16))) :=
      Real.smoothTransition.contDiff.comp ((contDiff_const.sub contDiff_id).div_const _)
    have hh : Differentiable ℝ
        (fun r : ℝ => Real.smoothTransition ((ρ ^ 2 / 4 - r) / (3 * ρ ^ 2 / 16))) :=
      hh0.differentiable (by norm_num)
    have hF := (hh (‖y‖ ^ 2)).hasDerivAt.comp_hasFDerivAt y
      (hasStrictFDerivAt_norm_sq y).hasFDerivAt
    have hχd : fderiv ℝ χ y v = 0 := by
      have e : χ = (fun r : ℝ => Real.smoothTransition ((ρ ^ 2 / 4 - r) / (3 * ρ ^ 2 / 16))) ∘
          (fun w : ℝ³ => ‖w‖ ^ 2) := by
        rw [hχ]; rfl
      rw [e, hF.fderiv]
      simp [hv]
    rw [fderiv_mul_const (hχs.differentiable (by norm_num) y), ContinuousLinearMap.smul_apply, hχd,
      smul_zero]
  · intro k
    refine ⟨∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |Cχ i| * |Cη (k - i)|, fun z => ?_⟩
    have hf1 : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => χ z.1) := hχs.comp contDiff_fst
    have hg1 : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => η z.2) := hηs.comp contDiff_snd
    have hb1 : ∀ i : ℕ, ‖iteratedFDeriv ℝ i (fun z : ℝ³ × ℝ => χ z.1) z‖ ≤ |Cχ i| := by
      intro i
      have e : (fun z : ℝ³ × ℝ => χ z.1) = χ ∘ ⇑(ContinuousLinearMap.fst ℝ ℝ³ ℝ) := rfl
      rw [e, ContinuousLinearMap.iteratedFDeriv_comp_right _ hχs z (by exact_mod_cast le_top)]
      refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
      have hp : ∏ _j : Fin i, ‖ContinuousLinearMap.fst ℝ ℝ³ ℝ‖ ≤ 1 := by
        rw [Finset.prod_const]
        exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_fst_le _ _ _)
      calc _ ≤ ‖iteratedFDeriv ℝ i χ ((ContinuousLinearMap.fst ℝ ℝ³ ℝ) z)‖ * 1 :=
            mul_le_mul_of_nonneg_left hp (norm_nonneg _)
        _ ≤ |Cχ i| := by rw [mul_one]; exact (hCχ i _).trans (le_abs_self _)
    have hb2 : ∀ i : ℕ, ‖iteratedFDeriv ℝ i (fun z : ℝ³ × ℝ => η z.2) z‖ ≤ |Cη i| := by
      intro i
      have e : (fun z : ℝ³ × ℝ => η z.2) = η ∘ ⇑(ContinuousLinearMap.snd ℝ ℝ³ ℝ) := rfl
      rw [e, ContinuousLinearMap.iteratedFDeriv_comp_right _ hηs z (by exact_mod_cast le_top)]
      refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
      have hp : ∏ _j : Fin i, ‖ContinuousLinearMap.snd ℝ ℝ³ ℝ‖ ≤ 1 := by
        rw [Finset.prod_const]
        exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_snd_le _ _ _)
      calc _ ≤ ‖iteratedFDeriv ℝ i η ((ContinuousLinearMap.snd ℝ ℝ³ ℝ) z)‖ * 1 :=
            mul_le_mul_of_nonneg_left hp (norm_nonneg _)
        _ ≤ |Cη i| := by rw [mul_one]; exact (hCη i _).trans (le_abs_self _)
    show ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => χ z.1 * η z.2) z‖ ≤ _
    refine (norm_iteratedFDeriv_mul_le hf1 hg1 z (by exact_mod_cast le_top)).trans ?_
    apply Finset.sum_le_sum
    intro i _
    exact mul_le_mul (mul_le_mul_of_nonneg_left (hb1 i) (by positivity)) (hb2 (k - i))
      (norm_nonneg _) (by positivity)

theorem divergence_smul_field : ∀ (φ : ℝ³ → ℝ) (V : ℝ³ → ℝ³) (x : ℝ³), DifferentiableAt ℝ φ x → DifferentiableAt ℝ V x → divergence (fun y => φ y • V y) x = φ x * divergence V x + fderiv ℝ φ x (V x) :=
by
  intro φ V x hφ hV
  rw [divergence, fderiv_fun_smul hφ hV, ContinuousLinearMap.toLinearMap_add,
    ContinuousLinearMap.toLinearMap_smul, map_add, map_smul, divergence, smul_eq_mul]
  congr 1
  have h : ((fderiv ℝ φ x).smulRight (V x) : ℝ³ →ₗ[ℝ] ℝ³) =
      (fderiv ℝ φ x : ℝ³ →ₗ[ℝ] ℝ).smulRight (V x) := rfl
  rw [h, LinearMap.trace_smulRight]
  rfl

theorem nsJet_iteratedFDeriv_bounded_on : ∀ (ν : ℝ) (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (O S : Set (ℝ³ × ℝ)), IsOpen O → S ⊆ O → ContDiffOn ℝ ∞ (↿u) O → ContDiffOn ℝ ∞ (↿p) O → (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿u) z‖ ≤ C ∧ ‖iteratedFDeriv ℝ k (↿p) z‖ ≤ C) → ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (nsJet ν u p) z‖ ≤ C :=
by
  intro ν u p O S hO hSO hu hp H
  have hnhds : ∀ z ∈ S, O ∈ nhds z := fun z hz => hO.mem_nhds (hSO hz)

  have hlin : ∀ {F G : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (L : F →L[ℝ] G) (f : ℝ³ × ℝ → F), ContDiffOn ℝ ∞ f O →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k f z‖ ≤ C) →
      ContDiffOn ℝ ∞ (fun z => L (f z)) O ∧
        ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (fun z => L (f z)) z‖ ≤ C := by
    intro F G _ _ _ _ L f hf hb
    refine ⟨hf.continuousLinearMap_comp L, fun k => ?_⟩
    obtain ⟨C, hC⟩ := hb k
    refine ⟨‖L‖ * C, fun z hz => ?_⟩
    have h1 := L.norm_iteratedFDeriv_comp_left (hf.contDiffAt (hnhds z hz)) (n := k)
      (by exact_mod_cast le_top)
    exact h1.trans (mul_le_mul_of_nonneg_left (hC z hz) (ContinuousLinearMap.opNorm_nonneg L))

  have hder : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F),
      ContDiffOn ℝ ∞ f O → (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k f z‖ ≤ C) →
      ContDiffOn ℝ ∞ (fderiv ℝ f) O ∧
        ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (fderiv ℝ f) z‖ ≤ C := by
    intro F _ _ f hf hb
    refine ⟨hf.fderiv_of_isOpen hO (by simp), fun k => ?_⟩
    obtain ⟨C, hC⟩ := hb (k + 1)
    exact ⟨C, fun z hz => by rw [norm_iteratedFDeriv_fderiv]; exact hC z hz⟩

  have hadd : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f g : ℝ³ × ℝ → F),
      ContDiffOn ℝ ∞ f O → ContDiffOn ℝ ∞ g O →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k f z‖ ≤ C) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k g z‖ ≤ C) →
      ContDiffOn ℝ ∞ (fun z => f z + g z) O ∧
        ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (fun z => f z + g z) z‖ ≤ C := by
    intro F _ _ f g hf hg hbf hbg
    refine ⟨hf.add hg, fun k => ?_⟩
    obtain ⟨C1, h1⟩ := hbf k
    obtain ⟨C2, h2⟩ := hbg k
    refine ⟨C1 + C2, fun z hz => ?_⟩
    have af : ContDiffAt ℝ k f z :=
      (hf.contDiffAt (hnhds z hz)).of_le (by exact_mod_cast le_top)
    have ag : ContDiffAt ℝ k g z :=
      (hg.contDiffAt (hnhds z hz)).of_le (by exact_mod_cast le_top)
    show ‖iteratedFDeriv ℝ k (f + g) z‖ ≤ C1 + C2
    rw [iteratedFDeriv_add_apply af ag]
    exact (norm_add_le _ _).trans (add_le_add (h1 z hz) (h2 z hz))

  have hbil : ∀ {F G K : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G]
      [NormedSpace ℝ G] [NormedAddCommGroup K] [NormedSpace ℝ K] (B : F →L[ℝ] G →L[ℝ] K)
      (f : ℝ³ × ℝ → F) (g : ℝ³ × ℝ → G), ContDiffOn ℝ ∞ f O → ContDiffOn ℝ ∞ g O →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k f z‖ ≤ C) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k g z‖ ≤ C) →
      ContDiffOn ℝ ∞ (fun z => B (f z) (g z)) O ∧
        ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (fun z => B (f z) (g z)) z‖ ≤ C := by
    intro F G K _ _ _ _ _ _ B f g hf hg hbf hbg
    refine ⟨(hf.continuousLinearMap_comp B).clm_apply hg, fun k => ?_⟩
    choose Cf hCf using hbf
    choose Cg hCg using hbg
    refine ⟨‖B‖ * ∑ i ∈ Finset.range (k + 1),
        (k.choose i : ℝ) * max (Cf i) 0 * max (Cg (k - i)) 0, fun z hz => ?_⟩
    have hzO : z ∈ O := hSO hz
    have hU : UniqueDiffOn ℝ O := hO.uniqueDiffOn
    have key := ContinuousLinearMap.norm_iteratedFDerivWithin_le_of_bilinear B hf hg hU hzO
      (n := k) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen k hO hzO] at key
    refine key.trans ?_
    refine mul_le_mul_of_nonneg_left ?_ (ContinuousLinearMap.opNorm_nonneg B)
    refine Finset.sum_le_sum fun i _ => ?_
    rw [iteratedFDerivWithin_of_isOpen i hO hzO, iteratedFDerivWithin_of_isOpen (k - i) hO hzO]
    have h1 : ‖iteratedFDeriv ℝ i f z‖ ≤ max (Cf i) 0 := (hCf i z hz).trans (le_max_left _ _)
    have h2 : ‖iteratedFDeriv ℝ (k - i) g z‖ ≤ max (Cg (k - i)) 0 :=
      (hCg (k - i) z hz).trans (le_max_left _ _)
    have h0 : (0 : ℝ) ≤ k.choose i := Nat.cast_nonneg _
    exact mul_le_mul (mul_le_mul_of_nonneg_left h1 h0) h2 (norm_nonneg _)
      (mul_nonneg h0 (le_max_right _ _))

  have Hu : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿u) z‖ ≤ C :=
    fun k => (H k).imp (fun C hC z hz => (hC z hz).1)
  have Hp : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿p) z‖ ≤ C :=
    fun k => (H k).imp (fun C hC z hz => (hC z hz).2)
  obtain ⟨hDu, HDu⟩ := hder (↿u) hu Hu
  obtain ⟨hD2u, HD2u⟩ := hder (fderiv ℝ (↿u)) hDu HDu
  obtain ⟨hDp, HDp⟩ := hder (↿p) hp Hp

  let e : Fin 3 → ℝ³ := fun i => EuclideanSpace.single i (1 : ℝ)
  let L₁ : (ℝ³ × ℝ →L[ℝ] ℝ³) →L[ℝ] ℝ³ := ContinuousLinearMap.apply ℝ ℝ³ ((0 : ℝ³), (1 : ℝ))
  let B : (ℝ³ × ℝ →L[ℝ] ℝ³) →L[ℝ] (ℝ³ × ℝ) →L[ℝ] ℝ³ :=
    ContinuousLinearMap.id ℝ (ℝ³ × ℝ →L[ℝ] ℝ³)
  let L₃ : (ℝ³ × ℝ →L[ℝ] ℝ³ × ℝ →L[ℝ] ℝ³) →L[ℝ] ℝ³ :=
    -(ν • ∑ i : Fin 3, (ContinuousLinearMap.apply ℝ ℝ³ (e i, (0 : ℝ))).comp
      (ContinuousLinearMap.apply ℝ (ℝ³ × ℝ →L[ℝ] ℝ³) (e i, (0 : ℝ))))
  let L₄ : (ℝ³ × ℝ →L[ℝ] ℝ) →L[ℝ] ℝ³ :=
    ∑ i : Fin 3, (ContinuousLinearMap.toSpanSingleton ℝ (e i)).comp
      (ContinuousLinearMap.apply ℝ ℝ (e i, (0 : ℝ)))
  obtain ⟨hw, Hw⟩ := hlin (ContinuousLinearMap.inl ℝ ℝ³ ℝ) (↿u) hu Hu
  obtain ⟨s1, b1⟩ := hlin L₁ _ hDu HDu
  obtain ⟨s2, b2⟩ := hbil B _ _ hDu hw HDu Hw
  obtain ⟨s3, b3⟩ := hlin L₃ _ hD2u HD2u
  obtain ⟨s4, b4⟩ := hlin L₄ _ hDp HDp
  obtain ⟨s12, b12⟩ := hadd _ _ s1 s2 b1 b2
  obtain ⟨s123, b123⟩ := hadd _ _ s12 s3 b12 b3
  obtain ⟨_, b1234⟩ := hadd _ _ s123 s4 b123 b4
  have hL3 : ∀ Ψ : ℝ³ × ℝ →L[ℝ] ℝ³ × ℝ →L[ℝ] ℝ³,
      L₃ Ψ = -(ν • ∑ i : Fin 3, Ψ (e i, (0 : ℝ)) (e i, (0 : ℝ))) := by
    intro Ψ
    show (-(ν • ∑ i : Fin 3, (ContinuousLinearMap.apply ℝ ℝ³ (e i, (0 : ℝ))).comp
      (ContinuousLinearMap.apply ℝ (ℝ³ × ℝ →L[ℝ] ℝ³) (e i, (0 : ℝ))))) Ψ = _
    simp only [ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_sum', Finset.sum_apply, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.apply_apply]
  have heq : nsJet ν u p = fun z =>
      ((L₁ (fderiv ℝ (↿u) z) + B (fderiv ℝ (↿u) z) (ContinuousLinearMap.inl ℝ ℝ³ ℝ ((↿u) z)))
        + L₃ (fderiv ℝ (fderiv ℝ (↿u)) z)) + L₄ (fderiv ℝ (↿p) z) := by
    funext z
    rw [hL3]
    simp [nsJet, L₁, B, L₄, e, ContinuousLinearMap.sum_apply, sub_eq_add_neg]
  rw [heq]
  exact b1234

theorem uniform_cauchy_of_flat_and_bounded : ∀ (G : ℝ³ × ℝ → ℝ³), ContDiffOn ℝ ∞ G (univ ×ˢ Iio 1) → (∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ x t, ‖x‖ < δ → 1 - δ < t → t < 1 → ‖iteratedFDeriv ℝ m G (x, t)‖ < ε) → (∀ δ : ℝ, 0 < δ → ∀ m : ℕ, ∃ C t₁ : ℝ, t₁ < 1 ∧ ∀ x t, δ ≤ ‖x‖ → t₁ < t → t < 1 → ‖iteratedFDeriv ℝ m G (x, t)‖ ≤ C) → ∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ t₀ < 1, ∀ x : ℝ³, ∀ t t' : ℝ, t₀ < t → t < 1 → t₀ < t' → t' < 1 → ‖iteratedFDeriv ℝ m G (x, t) - iteratedFDeriv ℝ m G (x, t')‖ < ε :=
by
  intro G hG hflat hbd m ε hε
  obtain ⟨δ₀, hδ₀, hδb⟩ := hflat m (ε / 2) (by linarith)
  obtain ⟨C, t₁, ht₁, hC⟩ := hbd δ₀ hδ₀ (m + 1)
  obtain ⟨C', hC'⟩ : ∃ C' : ℝ, C' = max C 0 := ⟨_, rfl⟩
  have hC'0 : 0 ≤ C' := hC' ▸ le_max_right _ _
  have hCC' : C ≤ C' := hC' ▸ le_max_left _ _
  obtain ⟨η, hη⟩ : ∃ η : ℝ, η = ε / (2 * (C' + 1)) := ⟨_, rfl⟩
  have hηpos : 0 < η := by rw [hη]; positivity
  have hηe : 2 * (C' + 1) * η = ε := by
    rw [hη]; field_simp
  obtain ⟨t₀, ht₀⟩ : ∃ t₀ : ℝ, t₀ = max (max (1 - δ₀) t₁) (1 - η) := ⟨_, rfl⟩
  have h1 : max (1 - δ₀) t₁ ≤ t₀ := ht₀ ▸ le_max_left _ _
  have h2 : 1 - η ≤ t₀ := ht₀ ▸ le_max_right _ _
  have h3 := le_max_left (1 - δ₀) t₁
  have h4 := le_max_right (1 - δ₀) t₁
  refine ⟨t₀, ?_, ?_⟩
  · rw [ht₀]; exact max_lt (max_lt (by linarith) ht₁) (by linarith)
  intro x t t' ht ht1 ht' ht'1
  rcases lt_or_ge ‖x‖ δ₀ with hx | hx
  · have a := hδb x t hx (by linarith) ht1
    have b := hδb x t' hx (by linarith) ht'1
    calc _ ≤ ‖iteratedFDeriv ℝ m G (x, t)‖ + ‖iteratedFDeriv ℝ m G (x, t')‖ := norm_sub_le _ _
      _ < ε := by linarith
  · have hopen : IsOpen (univ ×ˢ Iio (1:ℝ) : Set (ℝ³ × ℝ)) := isOpen_univ.prod isOpen_Iio
    have hS : Convex ℝ (({x} : Set ℝ³) ×ˢ Ioo t₀ 1) :=
      (convex_singleton x).prod (convex_Ioo t₀ 1)
    have hdiff : ∀ z ∈ (({x} : Set ℝ³) ×ˢ Ioo t₀ 1),
        DifferentiableAt ℝ (iteratedFDeriv ℝ m G) z := by
      intro z hz
      have hz1 : z ∈ (univ ×ˢ Iio (1:ℝ) : Set (ℝ³ × ℝ)) := ⟨mem_univ _, hz.2.2⟩
      exact (hG.contDiffAt (hopen.mem_nhds hz1)).differentiableAt_iteratedFDeriv
        (by exact_mod_cast ENat.natCast_lt_top m)
    have hbound : ∀ z ∈ (({x} : Set ℝ³) ×ˢ Ioo t₀ 1),
        ‖fderiv ℝ (iteratedFDeriv ℝ m G) z‖ ≤ C' := by
      intro z hz
      obtain ⟨z1, z2⟩ := z
      obtain ⟨hz1, hz2a, hz2b⟩ := hz
      simp only [mem_singleton_iff] at hz1
      subst hz1
      rw [norm_fderiv_iteratedFDeriv]
      exact (hC z1 z2 hx (by linarith) hz2b).trans hCC'
    have key := hS.norm_image_sub_le_of_norm_fderiv_le hdiff hbound
      (show ((x, t') : ℝ³ × ℝ) ∈ ({x} : Set ℝ³) ×ˢ Ioo t₀ 1 from ⟨rfl, ht', ht'1⟩)
      (show ((x, t) : ℝ³ × ℝ) ∈ ({x} : Set ℝ³) ×ˢ Ioo t₀ 1 from ⟨rfl, ht, ht1⟩)
    have hnorm : ‖((x, t) : ℝ³ × ℝ) - (x, t')‖ = |t - t'| := by
      rw [Prod.mk_sub_mk, sub_self, Prod.norm_mk, norm_zero, Real.norm_eq_abs]
      exact max_eq_right (abs_nonneg _)
    rw [hnorm] at key
    have habs : |t - t'| < η := by
      rw [abs_sub_lt_iff]; constructor <;> linarith
    have hm : C' * |t - t'| ≤ C' * η := mul_le_mul_of_nonneg_left habs.le hC'0
    nlinarith

theorem ns_blowup_flat_residual : ∃ (R : ℝ) (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ), 0 < R ∧ ContDiffOn ℝ ∞ (↿u) (univ ×ˢ Iio 1) ∧ ContDiffOn ℝ ∞ (↿p) (univ ×ˢ Iio 1) ∧ (∀ x t, t < 1 → (R ≤ ‖x‖ ∨ t ≤ 0) → u x t = 0 ∧ p x t = 0) ∧ (∀ x t, t < 1 → divergence (fun y => u y t) x = 0) ∧ (∀ M : ℝ, ∃ x t, 0 ≤ t ∧ t < 1 ∧ M < ‖u x t‖) ∧ ContDiffOn ℝ ∞ (↿(nsResidual 1 u p)) (univ ×ˢ Iio 1) ∧ (∀ x t, t < 1 → (R ≤ ‖x‖ ∨ t ≤ 0) → nsResidual 1 u p x t = 0) ∧ (∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ t₀ < 1, ∀ x : ℝ³, ∀ t t' : ℝ, t₀ < t → t < 1 → t₀ < t' → t' < 1 → ‖iteratedFDeriv ℝ m (↿(nsResidual 1 u p)) (x, t) - iteratedFDeriv ℝ m (↿(nsResidual 1 u p)) (x, t')‖ < ε) :=
by

  obtain ⟨ρ, τ₀, A, Bv, P, hρ, hτ₀, hτ₁, hAs, hBs, hPs, hBdiv, hbd, hflat, hunb⟩ :=
    ns_local_blowup_field
  obtain ⟨c, hcs, hc0, hc1, hctan, hcbd⟩ := radial_time_cutoff_exists ρ τ₀ hρ hτ₀
  obtain ⟨W, hW⟩ : ∃ W : Set (ℝ³ × ℝ), W = Metric.ball (0 : ℝ³) ρ ×ˢ Ioo (1 - τ₀) 1 := ⟨_, rfl⟩
  obtain ⟨V, hV⟩ : ∃ V : Set (ℝ³ × ℝ), V = {z | ρ / 2 < ‖z.1‖} ∪ {z | z.2 < 1 - τ₀ / 2} :=
    ⟨_, rfl⟩
  have hWo : IsOpen W := by rw [hW]; exact Metric.isOpen_ball.prod isOpen_Ioo
  have hVo : IsOpen V := by
    rw [hV]
    exact (isOpen_lt continuous_const continuous_fst.norm).union
      (isOpen_lt continuous_snd continuous_const)
  obtain ⟨A', hA'⟩ : ∃ A' : ℝ³ → ℝ → ℝ³, A' = fun y s => c y s • A y s := ⟨_, rfl⟩
  obtain ⟨Bv', hBv'⟩ : ∃ Bv' : ℝ³ → ℝ → ℝ³, Bv' = fun y s => c y s • Bv y s := ⟨_, rfl⟩
  obtain ⟨u, hu⟩ : ∃ u : ℝ³ → ℝ → ℝ³, u = fun y s => curl3 (fun w => A' w s) y + Bv' y s :=
    ⟨_, rfl⟩
  obtain ⟨p, hp⟩ : ∃ p : ℝ³ → ℝ → ℝ, p = fun y s => c y s * P y s := ⟨_, rfl⟩

  have hslice : ∀ (O : Set (ℝ³ × ℝ)), IsOpen O → ∀ (y : ℝ³) (s : ℝ), (y, s) ∈ O →
      {w : ℝ³ | (w, s) ∈ O} ∈ nhds y := fun O hO y s h =>
    (hO.preimage (Continuous.prodMk continuous_id (continuous_const : Continuous fun _ : ℝ³ => s))).mem_nhds h
  have hcurl_congr : ∀ (F₁ F₂ : ℝ³ → ℝ³) (x : ℝ³), F₁ =ᶠ[nhds x] F₂ → curl3 F₁ x = curl3 F₂ x := by
    intro F₁ F₂ x h
    simp only [curl3, h.fderiv_eq]
  have hsl : ∀ (G : ℝ³ → ℝ → ℝ³) (x : ℝ³) (t : ℝ), ContDiffOn ℝ ∞ (↿G) W → (x, t) ∈ W →
      ContDiffAt ℝ ∞ (fun w => G w t) x := by
    intro G x t hG hxt
    exact (hG.contDiffAt (hWo.mem_nhds hxt)).comp x
      ((contDiff_id.prodMk contDiff_const).contDiffAt)
  have hF0 : ∀ z : ℝ³ × ℝ, z.2 < 1 → z ∈ W ∨ z ∈ V := by
    intro z hz
    by_cases h : z ∈ V
    · exact Or.inr h
    · left
      rw [hV] at h
      simp only [mem_union, mem_setOf_eq, not_or, not_lt] at h
      rw [hW]
      refine ⟨?_, ?_, hz⟩
      · rw [mem_ball_zero_iff]; linarith [h.1]
      · show 1 - τ₀ < z.2; linarith [h.2]
  have hinV : ∀ (x : ℝ³) (t : ℝ), (ρ ≤ ‖x‖ ∨ t ≤ 0) → ((x, t) : ℝ³ × ℝ) ∈ V := by
    intro x t h
    rw [hV]
    rcases h with h | h
    · exact Or.inl (show ρ / 2 < ‖x‖ by linarith)
    · exact Or.inr (show t < 1 - τ₀ / 2 by linarith)
  have hglue : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (g : ℝ³ × ℝ → F),
      ContDiffOn ℝ ∞ g W → (∀ z ∈ V, g z = 0) → ContDiffOn ℝ ∞ g (univ ×ˢ Iio 1) := by
    intro F _ _ g hgW hgV
    apply contDiffOn_of_locally_contDiffOn
    intro z hz
    rcases hF0 z hz.2 with h | h
    · exact ⟨W, hWo, h, hgW.mono inter_subset_right⟩
    · exact ⟨V, hVo, h, (contDiffOn_const (c := (0 : F))).congr (fun w hw => hgV w hw.2)⟩

  have hcV : ∀ y s, ((y, s) : ℝ³ × ℝ) ∈ V → c y s = 0 := by
    intro y s h
    rw [hV] at h
    exact hc0 y s h
  have hAsW0 : ContDiffOn ℝ ∞ (↿A) W := by rw [hW]; exact hAs
  have hBsW0 : ContDiffOn ℝ ∞ (↿Bv) W := by rw [hW]; exact hBs
  have hAsW : ContDiffOn ℝ ∞ (↿A') W := by
    rw [hA', hW]; exact hcs.contDiffOn.smul hAs
  have hBsW : ContDiffOn ℝ ∞ (↿Bv') W := by
    rw [hBv', hW]; exact hcs.contDiffOn.smul hBs
  have hpW : ContDiffOn ℝ ∞ (↿p) W := by
    rw [hp, hW]; exact hcs.contDiffOn.mul hPs
  have huW : ContDiffOn ℝ ∞ (↿u) W := by
    rw [hu]; exact (curl_field_contDiffOn_bounded A' Bv' W W hWo subset_rfl hAsW hBsW).1

  have huV : ∀ y s, ((y, s) : ℝ³ × ℝ) ∈ V → u y s = 0 := by
    intro y s h
    have hev : (fun w => A' w s) =ᶠ[nhds y] fun _ => (0 : ℝ³) :=
      Filter.eventuallyEq_of_mem (hslice V hVo y s h)
        (fun w hw => by simp only [hA', hcV w s hw, zero_smul])
    simp only [hu, hBv', hcV y s h, zero_smul, add_zero]
    rw [hcurl_congr _ _ y hev]
    simp [curl3]
  have hpV : ∀ y s, ((y, s) : ℝ³ × ℝ) ∈ V → p y s = 0 := by
    intro y s h
    simp only [hp, hcV y s h, zero_mul]

  have hu_sm : ContDiffOn ℝ ∞ (↿u) (univ ×ˢ Iio 1) :=
    hglue (↿u) huW (fun z hz => huV z.1 z.2 hz)
  have hp_sm : ContDiffOn ℝ ∞ (↿p) (univ ×ˢ Iio 1) :=
    hglue (↿p) hpW (fun z hz => hpV z.1 z.2 hz)

  have hdiv : ∀ (x : ℝ³) (t : ℝ), t < 1 → divergence (fun y => u y t) x = 0 := by
    intro x t ht
    rcases hF0 (x, t) ht with h | h
    · have hxW := h
      rw [hW] at h
      have hx : ‖x‖ < ρ := mem_ball_zero_iff.mp h.1
      have ht1 : 1 - τ₀ < t := h.2.1
      have hA2 : ContDiffAt ℝ 2 (fun w => A' w t) x :=
        (hsl A' x t hAsW hxW).of_le (by norm_num)
      obtain ⟨hcd, hcdiv⟩ := curl3_differentiable_divergence_zero (fun w => A' w t) x hA2
      have hcdx : DifferentiableAt ℝ (fun w => c w t) x :=
        ((hcs.comp (contDiff_id.prodMk contDiff_const)).differentiable (by norm_num)) x
      have hBx : DifferentiableAt ℝ (fun w => Bv w t) x :=
        (hsl Bv x t hBsW0 hxW).differentiableAt (by norm_num)
      have hfun : (fun y => u y t) = fun y => curl3 (fun w => A' w t) y + c y t • Bv y t := by
        funext y; simp only [hu, hBv']
      have hcB : DifferentiableAt ℝ (fun y => c y t • Bv y t) x := hcdx.smul hBx
      rw [hfun, divergence_add hcd hcB, hcdiv,
        divergence_smul_field (fun w => c w t) (fun w => Bv w t) x hcdx hBx]
      obtain ⟨h1, h2⟩ := hBdiv x t hx ht1 ht
      rw [h1, hctan x t (Bv x t) h2]
      simp
    · have hev : (fun y => u y t) =ᶠ[nhds x] fun _ => (0 : ℝ³) :=
        Filter.eventuallyEq_of_mem (hslice V hVo x t h) (fun w hw => huV w t hw)
      rw [divergence, hev.fderiv_eq]
      simp

  have hNu : ∀ y s, ‖y‖ < ρ / 4 → 1 - τ₀ / 4 < s →
      u y s = curl3 (fun w => A w s) y + Bv y s := by
    intro y s hy hs
    have hev : (fun w => A' w s) =ᶠ[nhds y] fun w => A w s :=
      Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds (mem_ball_zero_iff.mpr hy))
        (fun w hw => by simp only [hA', hc1 w s (mem_ball_zero_iff.mp hw) hs, one_smul])
    simp only [hu, hBv', hc1 y s hy hs, one_smul]
    rw [hcurl_congr _ _ y hev]
  have hNp : ∀ y s, ‖y‖ < ρ / 4 → 1 - τ₀ / 4 < s → p y s = P y s := by
    intro y s hy hs
    simp only [hp, hc1 y s hy hs, one_mul]

  have hunb' : ∀ M : ℝ, ∃ (x : ℝ³) (t : ℝ), 0 ≤ t ∧ t < 1 ∧ M < ‖u x t‖ := by
    intro M
    obtain ⟨x, t, hx, ht1, ht2, hM⟩ :=
      hunb M (min (ρ / 4) (τ₀ / 4)) (lt_min (by linarith) (by linarith))
    have h3 := min_le_left (ρ / 4) (τ₀ / 4)
    have h4 := min_le_right (ρ / 4) (τ₀ / 4)
    have hx' : ‖x‖ < ρ / 4 := by linarith
    have ht' : 1 - τ₀ / 4 < t := by linarith
    refine ⟨x, t, by linarith, ht2, ?_⟩
    rw [hNu x t hx' ht']
    exact hM

  have hGs : ContDiffOn ℝ ∞ (↿(nsResidual 1 u p)) (univ ×ˢ Iio 1) :=
    (nsResidual_contDiffOn_eq_jet 1 u p _ (isOpen_univ.prod isOpen_Iio) hu_sm hp_sm).1
  have hGV : ∀ z ∈ V, (↿(nsResidual 1 u p)) z = 0 := by
    intro z hz
    have := nsResidual_local_and_zero.1 1 u (fun _ _ => (0 : ℝ³)) p (fun _ _ => (0 : ℝ)) V hVo
      (fun w hw => huV w.1 w.2 hw) (fun w hw => hpV w.1 w.2 hw) z hz
    rw [this]
    exact nsResidual_local_and_zero.2 1 z.1 z.2

  have hNo : IsOpen (Metric.ball (0 : ℝ³) (ρ / 4) ×ˢ Ioi (1 - τ₀ / 4)) :=
    Metric.isOpen_ball.prod isOpen_Ioi
  have hGN : ∀ z ∈ Metric.ball (0 : ℝ³) (ρ / 4) ×ˢ Ioi (1 - τ₀ / 4),
      (↿(nsResidual 1 u p)) z =
        (↿(nsResidual 1 (fun y s => curl3 (fun w => A w s) y + Bv y s) P)) z :=
    nsResidual_local_and_zero.1 1 u _ p P _ hNo
      (fun z hz => hNu z.1 z.2 (mem_ball_zero_iff.mp hz.1) hz.2)
      (fun z hz => hNp z.1 z.2 (mem_ball_zero_iff.mp hz.1) hz.2)
  have hflatG : ∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ (x : ℝ³) (t : ℝ), ‖x‖ < δ →
      1 - δ < t → t < 1 → ‖iteratedFDeriv ℝ m (↿(nsResidual 1 u p)) (x, t)‖ < ε := by
    intro m ε hε
    obtain ⟨δ, hδ, hδb⟩ := hflat m ε hε
    refine ⟨min δ (min (ρ / 4) (τ₀ / 4)), lt_min hδ (lt_min (by linarith) (by linarith)), ?_⟩
    intro x t hx ht1 ht2
    have h1 := min_le_left δ (min (ρ / 4) (τ₀ / 4))
    have h2 := min_le_right δ (min (ρ / 4) (τ₀ / 4))
    have h3 := min_le_left (ρ / 4) (τ₀ / 4)
    have h4 := min_le_right (ρ / 4) (τ₀ / 4)
    have hmem : ((x, t) : ℝ³ × ℝ) ∈ Metric.ball (0 : ℝ³) (ρ / 4) ×ˢ Ioi (1 - τ₀ / 4) :=
      ⟨mem_ball_zero_iff.mpr (by linarith), show 1 - τ₀ / 4 < t by linarith⟩
    have hev : (↿(nsResidual 1 u p)) =ᶠ[nhds (x, t)]
        ↿(nsResidual 1 (fun y s => curl3 (fun w => A w s) y + Bv y s) P) :=
      Filter.eventuallyEq_of_mem (hNo.mem_nhds hmem) hGN
    rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
    exact hδb x t (by linarith) (by linarith) ht2

  have hbdG : ∀ δ : ℝ, 0 < δ → ∀ m : ℕ, ∃ C t₁ : ℝ, t₁ < 1 ∧ ∀ (x : ℝ³) (t : ℝ), δ ≤ ‖x‖ →
      t₁ < t → t < 1 → ‖iteratedFDeriv ℝ m (↿(nsResidual 1 u p)) (x, t)‖ ≤ C := by
    intro δ hδ m
    obtain ⟨S, hS⟩ : ∃ S : Set (ℝ³ × ℝ),
        S = {z | δ ≤ ‖z.1‖ ∧ ‖z.1‖ ≤ ρ / 2 ∧ 1 - τ₀ / 2 < z.2 ∧ z.2 < 1} := ⟨_, rfl⟩
    have hSW : S ⊆ W := by
      intro z hz
      rw [hS] at hz
      rw [hW]
      exact ⟨mem_ball_zero_iff.mpr (by linarith [hz.2.1]),
        show 1 - τ₀ < z.2 by linarith [hz.2.2.1], hz.2.2.2⟩
    have hbA : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿A) z‖ ≤ C ∧
        ‖iteratedFDeriv ℝ k (↿Bv) z‖ ≤ C ∧ ‖iteratedFDeriv ℝ k (↿P) z‖ ≤ C := by
      intro k
      obtain ⟨C, hC⟩ := hbd δ hδ k
      refine ⟨C, fun z hz => ?_⟩
      rw [hS] at hz
      exact hC z.1 z.2 hz.1 hz.2.1 (by linarith [hz.2.2.1]) hz.2.2.2
    have hbc : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿c) z‖ ≤ C := by
      intro k
      obtain ⟨C, hC⟩ := hcbd k
      exact ⟨C, fun z _ => hC z⟩
    have hbA' : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿A') z‖ ≤ C := by
      have e : (↿A') = fun z =>
          (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³) ((↿c) z) ((↿A) z) := by
        funext z
        rw [ContinuousLinearMap.lsmul_apply, hA'] <;> rfl
      rw [e]
      exact iteratedFDeriv_bilinear_bounded_on _ (↿c) (↿A) W S hWo hSW hcs.contDiffOn hAsW0
        hbc (fun k => (hbA k).imp (fun C hC z hz => (hC z hz).1))
    have hbB' : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿Bv') z‖ ≤ C := by
      have e : (↿Bv') = fun z =>
          (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³) ((↿c) z) ((↿Bv) z) := by
        funext z
        rw [ContinuousLinearMap.lsmul_apply, hBv'] <;> rfl
      rw [e]
      exact iteratedFDeriv_bilinear_bounded_on _ (↿c) (↿Bv) W S hWo hSW hcs.contDiffOn hBsW0
        hbc (fun k => (hbA k).imp (fun C hC z hz => (hC z hz).2.1))
    have hbp : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿p) z‖ ≤ C := by
      have hPsW0 : ContDiffOn ℝ ∞ (↿P) W := by rw [hW]; exact hPs
      have e : (↿p) = fun z =>
          (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ →L[ℝ] ℝ) ((↿c) z) ((↿P) z) := by
        funext z
        rw [ContinuousLinearMap.lsmul_apply, smul_eq_mul, hp] <;> rfl
      rw [e]
      exact iteratedFDeriv_bilinear_bounded_on _ (↿c) (↿P) W S hWo hSW hcs.contDiffOn hPsW0
        hbc (fun k => (hbA k).imp (fun C hC z hz => (hC z hz).2.2))
    have hbu : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿u) z‖ ≤ C := by
      rw [hu]
      refine (curl_field_contDiffOn_bounded A' Bv' W S hWo hSW hAsW hBsW).2 ?_
      intro k
      obtain ⟨C1, h1⟩ := hbA' k
      obtain ⟨C2, h2⟩ := hbB' k
      exact ⟨max C1 C2, fun z hz =>
        ⟨(h1 z hz).trans (le_max_left _ _), (h2 z hz).trans (le_max_right _ _)⟩⟩
    have hbup : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿u) z‖ ≤ C ∧
        ‖iteratedFDeriv ℝ k (↿p) z‖ ≤ C := by
      intro k
      obtain ⟨C1, h1⟩ := hbu k
      obtain ⟨C2, h2⟩ := hbp k
      exact ⟨max C1 C2, fun z hz =>
        ⟨(h1 z hz).trans (le_max_left _ _), (h2 z hz).trans (le_max_right _ _)⟩⟩
    obtain ⟨C₀, hC₀⟩ := nsJet_iteratedFDeriv_bounded_on 1 u p W S hWo hSW huW hpW hbup m
    have hjet := (nsResidual_contDiffOn_eq_jet 1 u p W hWo huW hpW).2
    refine ⟨max C₀ 0, 1 - τ₀ / 2, by linarith, ?_⟩
    intro x t hx ht1 ht2
    by_cases hxr : ‖x‖ ≤ ρ / 2
    · have hzS : ((x, t) : ℝ³ × ℝ) ∈ S := by rw [hS]; exact ⟨hx, hxr, ht1, ht2⟩
      have hev : (↿(nsResidual 1 u p)) =ᶠ[nhds (x, t)] nsJet 1 u p :=
        Filter.eventuallyEq_of_mem (hWo.mem_nhds (hSW hzS)) hjet
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
      exact (hC₀ _ hzS).trans (le_max_left _ _)
    · have hzV : ((x, t) : ℝ³ × ℝ) ∈ V := by
        rw [hV]
        exact Or.inl (show ρ / 2 < ‖x‖ by linarith [not_le.mp hxr])
      have hev : (↿(nsResidual 1 u p)) =ᶠ[nhds (x, t)] fun _ => (0 : ℝ³) :=
        Filter.eventuallyEq_of_mem (hVo.mem_nhds hzV) hGV
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
      simp only [Pi.zero_apply, norm_zero]
      exact le_max_right _ _

  have hcauchy := uniform_cauchy_of_flat_and_bounded (↿(nsResidual 1 u p)) hGs hflatG hbdG

  exact ⟨ρ, u, p, hρ, hu_sm, hp_sm,
    fun x t _ h => ⟨huV x t (hinV x t h), hpV x t (hinV x t h)⟩, hdiv, hunb', hGs,
    fun x t _ h => hGV (x, t) (hinV x t h), hcauchy⟩

theorem jet_limits_of_uniform_cauchy : ∀ (c R : ℝ) (K : EuclideanSpace ℝ (Fin 3) × ℝ → EuclideanSpace ℝ (Fin 3)), ContDiffOn ℝ ∞ K (univ ×ˢ Iio c) → (∀ x t, t < c → R ≤ ‖x‖ → K (x, t) = 0) → (∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ t₀ < c, ∀ x : EuclideanSpace ℝ (Fin 3), ∀ t t' : ℝ, t₀ < t → t < c → t₀ < t' → t' < c → ‖iteratedFDeriv ℝ m K (x, t) - iteratedFDeriv ℝ m K (x, t')‖ < ε) → ∃ N : (m : ℕ) → EuclideanSpace ℝ (Fin 3) → ContinuousMultilinearMap ℝ (fun _ : Fin m => EuclideanSpace ℝ (Fin 3) × ℝ) (EuclideanSpace ℝ (Fin 3)), (∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ t₀ < c, ∀ x : EuclideanSpace ℝ (Fin 3), ∀ t : ℝ, t₀ < t → t < c → ‖iteratedFDeriv ℝ m K (x, t) - N m x‖ < ε) ∧ (∀ m x, R ≤ ‖x‖ → N m x = 0) :=
by
  intro c R K hK hvan hC
  have hO : IsOpen (univ ×ˢ Iio c : Set (EuclideanSpace ℝ (Fin 3) × ℝ)) :=
    isOpen_univ.prod isOpen_Iio

  have hZ : ∀ (m : ℕ) (U : Set (EuclideanSpace ℝ (Fin 3) × ℝ)) (z : EuclideanSpace ℝ (Fin 3) × ℝ),
      IsOpen U → z ∈ U → (∀ w ∈ U, K w = 0) → iteratedFDeriv ℝ m K z = 0 := by
    intro m U z hU hz hKU
    have h : K =ᶠ[nhds z] fun _ => (0 : EuclideanSpace ℝ (Fin 3)) :=
      Filter.eventuallyEq_of_mem (hU.mem_nhds hz) hKU
    rw [(h.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
    rfl
  have hout : ∀ (m : ℕ) (x : EuclideanSpace ℝ (Fin 3)) (t : ℝ), t < c → R < ‖x‖ →
      iteratedFDeriv ℝ m K (x, t) = 0 := by
    intro m x t ht hx
    refine hZ m {w | R < ‖w.1‖ ∧ w.2 < c} (x, t) ?_ ⟨hx, ht⟩ ?_
    · exact (isOpen_lt continuous_const (continuous_norm.comp continuous_fst)).inter
        (isOpen_lt continuous_snd continuous_const)
    · rintro ⟨y, s⟩ ⟨hy, hs⟩
      exact hvan y s hs hy.le
  have hvanD : ∀ (m : ℕ) (x : EuclideanSpace ℝ (Fin 3)) (t : ℝ), t < c → R ≤ ‖x‖ →
      iteratedFDeriv ℝ m K (x, t) = 0 := by
    intro m x t ht hx
    by_cases hR : R ≤ 0
    · refine hZ m (univ ×ˢ Iio c) (x, t) hO ⟨mem_univ _, ht⟩ ?_
      rintro ⟨y, s⟩ ⟨-, hs⟩
      exact hvan y s hs (le_trans hR (norm_nonneg _))
    rcases lt_or_eq_of_le hx with hlt | heq
    · exact hout m x t ht hlt
    · push_neg at hR
      have hmem : (x, t) ∈ (univ ×ˢ Iio c : Set (EuclideanSpace ℝ (Fin 3) × ℝ)) :=
        ⟨mem_univ _, ht⟩
      have hcont : ContinuousAt (iteratedFDeriv ℝ m K) (x, t) :=
        (hK.contDiffAt (hO.mem_nhds hmem)).continuousAt_iteratedFDeriv
          (by exact_mod_cast le_top)
      have ha : Filter.Tendsto (fun n : ℕ => (1 : ℝ) + 1 / ((n : ℝ) + 1)) Filter.atTop (nhds 1) := by
        have := (tendsto_one_div_add_atTop_nhds_zero_nat).const_add (1 : ℝ)
        rwa [add_zero] at this
      have hz : Filter.Tendsto (fun n : ℕ => (((1 : ℝ) + 1 / ((n : ℝ) + 1)) • x, t))
          Filter.atTop (nhds (x, t)) := by
        have h1 : Filter.Tendsto (fun n : ℕ => ((1 : ℝ) + 1 / ((n : ℝ) + 1)) • x)
            Filter.atTop (nhds x) := by
          have := ha.smul_const x
          rwa [one_smul] at this
        exact h1.prodMk_nhds tendsto_const_nhds
      have hlim := hcont.tendsto.comp hz
      have hzero : ∀ n : ℕ,
          iteratedFDeriv ℝ m K (((1 : ℝ) + 1 / ((n : ℝ) + 1)) • x, t) = 0 := by
        intro n
        apply hout m _ t ht
        have hp : 0 < 1 / ((n : ℝ) + 1) := by positivity
        rw [norm_smul, Real.norm_of_nonneg (by linarith), ← heq]
        nlinarith
      have h0 : Filter.Tendsto
          (fun n : ℕ => iteratedFDeriv ℝ m K (((1 : ℝ) + 1 / ((n : ℝ) + 1)) • x, t))
          Filter.atTop (nhds 0) :=
        (Filter.tendsto_congr hzero).mpr tendsto_const_nhds
      exact tendsto_nhds_unique hlim h0
  have hlim : ∀ m : ℕ, ∃ L : EuclideanSpace ℝ (Fin 3) → ContinuousMultilinearMap ℝ
      (fun _ : Fin m => EuclideanSpace ℝ (Fin 3) × ℝ) (EuclideanSpace ℝ (Fin 3)),
      ∀ ε : ℝ, 0 < ε → ∃ t₀ < c, ∀ x : EuclideanSpace ℝ (Fin 3), ∀ t : ℝ, t₀ < t → t < c →
        ‖iteratedFDeriv ℝ m K (x, t) - L x‖ < ε := by
    intro m
    haveI : CompleteSpace (ContinuousMultilinearMap ℝ
        (fun _ : Fin m => EuclideanSpace ℝ (Fin 3) × ℝ) (EuclideanSpace ℝ (Fin 3))) :=
      ContinuousMultilinearMap.instCompleteSpace
    have hex : ∀ x : EuclideanSpace ℝ (Fin 3), ∃ a, Filter.Tendsto
        (fun t => iteratedFDeriv ℝ m K (x, t)) (nhdsWithin c (Iio c)) (nhds a) := by
      intro x
      apply cauchy_map_iff_exists_tendsto.mp
      rw [Metric.cauchy_iff]
      refine ⟨Filter.map_neBot, fun ε hε => ?_⟩
      obtain ⟨t₀, ht₀, h⟩ := hC m ε hε
      refine ⟨(fun t => iteratedFDeriv ℝ m K (x, t)) '' Ioo t₀ c,
        Filter.image_mem_map (Ioo_mem_nhdsLT ht₀), ?_⟩
      rintro _ ⟨t, ht, rfl⟩ _ ⟨t', ht', rfl⟩
      rw [dist_eq_norm]
      exact h x t t' ht.1 ht.2 ht'.1 ht'.2
    choose L hL using hex
    refine ⟨L, fun ε hε => ?_⟩
    obtain ⟨t₀, ht₀, h⟩ := hC m (ε / 2) (by linarith)
    refine ⟨t₀, ht₀, fun x t ht htc => ?_⟩
    have h1 : Filter.Tendsto
        (fun t' => ‖iteratedFDeriv ℝ m K (x, t) - iteratedFDeriv ℝ m K (x, t')‖)
        (nhdsWithin c (Iio c)) (nhds ‖iteratedFDeriv ℝ m K (x, t) - L x‖) :=
      ((hL x).const_sub _).norm
    have h2 : ∀ᶠ t' in nhdsWithin c (Iio c),
        ‖iteratedFDeriv ℝ m K (x, t) - iteratedFDeriv ℝ m K (x, t')‖ ≤ ε / 2 := by
      filter_upwards [Ioo_mem_nhdsLT ht₀] with t' ht'
      exact (h x t t' ht htc ht'.1 ht'.2).le
    have h3 := le_of_tendsto h1 h2
    linarith
  choose N hN using hlim
  refine ⟨N, hN, fun m x hx => ?_⟩
  by_contra hne
  have hpos : 0 < ‖N m x‖ := norm_pos_iff.mpr hne
  obtain ⟨t₀, ht₀, h⟩ := hN m _ hpos
  have h4 := h x ((t₀ + c) / 2) (by linarith) (by linarith)
  rw [hvanD m x _ (by linarith) hx, zero_sub, norm_neg] at h4
  exact lt_irrefl _ h4

theorem jet_limits_smooth : ∀ (c : ℝ) (K : EuclideanSpace ℝ (Fin 3) × ℝ → EuclideanSpace ℝ (Fin 3)) (N : (m : ℕ) → EuclideanSpace ℝ (Fin 3) → ContinuousMultilinearMap ℝ (fun _ : Fin m => EuclideanSpace ℝ (Fin 3) × ℝ) (EuclideanSpace ℝ (Fin 3))), ContDiffOn ℝ ∞ K (univ ×ˢ Iio c) → (∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ t₀ < c, ∀ x : EuclideanSpace ℝ (Fin 3), ∀ t : ℝ, t₀ < t → t < c → ‖iteratedFDeriv ℝ m K (x, t) - N m x‖ < ε) → (∀ m x, HasFDerivAt (N m) ((N (m+1) x).curryLeft.comp (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ)) x) ∧ (∀ m, ContDiff ℝ ∞ (N m)) :=
by
  intro c K N hK hUC
  have hO : IsOpen (univ ×ˢ Iio c : Set (EuclideanSpace ℝ (Fin 3) × ℝ)) :=
    isOpen_univ.prod isOpen_Iio
  have hΛ : ∀ (m : ℕ) (A : ContinuousMultilinearMap ℝ
      (fun _ : Fin (m+1) => EuclideanSpace ℝ (Fin 3) × ℝ) (EuclideanSpace ℝ (Fin 3))),
      ‖A.curryLeft.comp (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ)‖ ≤ ‖A‖ := by
    intro m A
    calc _ ≤ ‖A.curryLeft‖ * ‖ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ‖ :=
          ContinuousLinearMap.opNorm_comp_le _ _
      _ ≤ ‖A‖ * 1 := by
          rw [ContinuousMultilinearMap.curryLeft_norm]
          exact mul_le_mul_of_nonneg_left (ContinuousLinearMap.norm_inl_le_one _ _ _)
            (norm_nonneg _)
      _ = ‖A‖ := mul_one _
  have hΛsub : ∀ (m : ℕ) (A B : ContinuousMultilinearMap ℝ
      (fun _ : Fin (m+1) => EuclideanSpace ℝ (Fin 3) × ℝ) (EuclideanSpace ℝ (Fin 3))),
      A.curryLeft.comp (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ) -
        B.curryLeft.comp (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ) =
        (A - B).curryLeft.comp (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ) := by
    intro m A B
    ext v w
    simp [ContinuousMultilinearMap.curryLeft_apply]
  have h1 : ∀ m x, HasFDerivAt (N m) ((N (m+1) x).curryLeft.comp
      (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ)) x := by
    intro m
    set t : ℕ → ℝ := fun n => c - 1 / ((n:ℝ) + 1) with ht_def
    have htc : ∀ n, t n < c := by
      intro n
      have : (0:ℝ) < 1 / ((n:ℝ)+1) := by positivity
      simp only [ht_def]
      linarith
    have hev : ∀ t₀ < c, ∀ᶠ n in Filter.atTop, t₀ < t n := by
      intro t₀ ht₀
      obtain ⟨n₀, hn₀⟩ := exists_nat_one_div_lt (sub_pos.mpr ht₀)
      rw [Filter.eventually_atTop]
      refine ⟨n₀, fun n hn => ?_⟩
      have : 1 / ((n:ℝ)+1) ≤ 1 / ((n₀:ℝ)+1) := by
        apply one_div_le_one_div_of_le (by positivity)
        have : (n₀:ℝ) ≤ n := by exact_mod_cast hn
        linarith
      simp only [ht_def]
      linarith
    have hder : ∀ n x, HasFDerivAt (fun y => iteratedFDeriv ℝ m K (y, t n))
        ((iteratedFDeriv ℝ (m+1) K (x, t n)).curryLeft.comp
          (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ)) x := by
      intro n x
      have hmem : (x, t n) ∈ (univ ×ˢ Iio c : Set (EuclideanSpace ℝ (Fin 3) × ℝ)) :=
        ⟨mem_univ _, htc n⟩
      have hKat : ContDiffAt ℝ ∞ K (x, t n) := hK.contDiffAt (hO.mem_nhds hmem)
      have hdiff : DifferentiableAt ℝ (iteratedFDeriv ℝ m K) (x, t n) :=
        hKat.differentiableAt_iteratedFDeriv (WithTop.coe_lt_coe.mpr (ENat.coe_lt_top m))
      have h2 : HasFDerivAt (iteratedFDeriv ℝ m K)
          (iteratedFDeriv ℝ (m+1) K (x, t n)).curryLeft (x, t n) := by
        have := hdiff.hasFDerivAt
        rw [fderiv_iteratedFDeriv] at this
        exact this
      exact h2.comp x (hasFDerivAt_prodMk_left x (t n))
    have hU : TendstoUniformly
        (fun n y => (iteratedFDeriv ℝ (m+1) K (y, t n)).curryLeft.comp
          (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ))
        (fun y => (N (m+1) y).curryLeft.comp
          (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ)) Filter.atTop := by
      have hd : ∀ ε > 0, ∀ᶠ n in Filter.atTop, ∀ y,
          dist ((N (m+1) y).curryLeft.comp
            (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ))
          ((iteratedFDeriv ℝ (m+1) K (y, t n)).curryLeft.comp
            (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ)) < ε := by
        intro ε hε
        obtain ⟨t₀, ht₀, h⟩ := hUC (m+1) ε hε
        filter_upwards [hev t₀ ht₀] with n hn
        intro y
        have e := dist_eq_norm ((N (m+1) y).curryLeft.comp
            (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ))
          ((iteratedFDeriv ℝ (m+1) K (y, t n)).curryLeft.comp
            (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ))
        refine lt_of_eq_of_lt e ?_
        rw [hΛsub]
        refine lt_of_le_of_lt (hΛ _ _) ?_
        rw [norm_sub_rev]
        exact h y (t n) hn (htc n)
      exact Metric.tendstoUniformly_iff.mpr hd
    have hP : ∀ y, Filter.Tendsto (fun n => iteratedFDeriv ℝ m K (y, t n)) Filter.atTop
        (nhds (N m y)) := by
      intro y
      rw [Metric.tendsto_nhds]
      intro ε hε
      obtain ⟨t₀, ht₀, h⟩ := hUC m ε hε
      filter_upwards [hev t₀ ht₀] with n hn
      rw [dist_eq_norm]
      exact h y (t n) hn (htc n)
    intro x
    exact hasFDerivAt_of_tendstoUniformly
      (f := fun n y => iteratedFDeriv ℝ m K (y, t n)) (g := N m) hU hder hP x
  refine ⟨h1, ?_⟩
  have hk : ∀ k : ℕ, ∀ m, ContDiff ℝ k (N m) := by
    intro k
    induction k with
    | zero =>
      intro m
      simp only [Nat.cast_zero, contDiff_zero]
      exact continuous_iff_continuousAt.mpr fun x => (h1 m x).continuousAt
    | succ k ih =>
      intro m
      rw [Nat.cast_succ, contDiff_succ_iff_hasFDerivAt]
      refine ⟨fun x => (N (m+1) x).curryLeft.comp
        (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ), ?_, h1 m⟩
      have hcl : ContDiff ℝ k (fun A : ContinuousMultilinearMap ℝ
          (fun _ : Fin (m+1) => EuclideanSpace ℝ (Fin 3) × ℝ) (EuclideanSpace ℝ (Fin 3)) =>
            A.curryLeft) := by
        apply IsBoundedLinearMap.contDiff
        refine IsLinearMap.with_bound ⟨fun A B => ?_, fun r A => ?_⟩ 1 fun A => ?_
        · refine ContinuousLinearMap.ext fun x => ContinuousMultilinearMap.ext fun v => ?_
          simp [ContinuousMultilinearMap.curryLeft_apply]
        · refine ContinuousLinearMap.ext fun x => ContinuousMultilinearMap.ext fun v => ?_
          simp [ContinuousMultilinearMap.curryLeft_apply]
        · rw [ContinuousMultilinearMap.curryLeft_norm, one_mul]
      have hL : ContDiff ℝ k (fun x => (N (m+1) x).curryLeft) := hcl.comp (ih (m+1))
      exact hL.clm_comp contDiff_const
  intro m
  exact contDiff_infty.mpr fun k => hk k m

theorem iteratedFDeriv_symm_of_contDiffOn : ∀ {E V : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup V] [NormedSpace ℝ V] (U : Set E) (f : E → V), IsOpen U → ContDiffOn ℝ ∞ f U → ∀ z ∈ U, ∀ (m : ℕ) (w : Fin m → E) (σ : Equiv.Perm (Fin m)), iteratedFDeriv ℝ m f z (w ∘ σ) = iteratedFDeriv ℝ m f z w :=
by
  intro E V _ _ _ _ U f hU hf z hz m w σ

  have hperm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (n : ℕ)
      (A : ContinuousMultilinearMap ℝ (fun _ : Fin (n + 1) => E) W),
      (∀ (i : Fin n) (w : Fin (n + 1) → E), A (w ∘ Equiv.swap i.castSucc i.succ) = A w) →
      ∀ (w : Fin (n + 1) → E) (σ : Equiv.Perm (Fin (n + 1))), A (w ∘ σ) = A w := by
    intro W _ _ n A hA w σ
    have hσ : σ ∈ Submonoid.closure (Set.range fun i : Fin n => Equiv.swap i.castSucc i.succ) := by
      rw [Equiv.Perm.mclosure_swap_castSucc_succ]; exact Submonoid.mem_top σ
    induction hσ using Submonoid.closure_induction generalizing w with
    | mem x hx => obtain ⟨i, rfl⟩ := hx; exact hA i w
    | one => rfl
    | mul x y _ _ hx hy =>
      rw [Equiv.Perm.coe_mul, ← Function.comp_assoc, hy, hx]

  have Q : ∀ k : ℕ, ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (g : E → W),
      ContDiffOn ℝ ∞ g U → ∀ y ∈ U, ∀ (u : Fin (k + 2) → E) (τ : Equiv.Perm (Fin (k + 2))),
      iteratedFDeriv ℝ (k + 2) g y (u ∘ τ) = iteratedFDeriv ℝ (k + 2) g y u := by
    intro k
    induction k with
    | zero =>
      intro W _ _ g hg y hy u τ
      refine hperm 1 (iteratedFDeriv ℝ 2 g y) ?_ u τ
      intro i v
      have hi : i = 0 := Subsingleton.elim _ _
      subst hi
      have hS : IsSymmSndFDerivAt ℝ g y :=
        (hg.contDiffAt (hU.mem_nhds hy)).isSymmSndFDerivAt
          (by rw [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.mpr le_top)
      rw [iteratedFDeriv_two_apply, iteratedFDeriv_two_apply]
      simp only [Function.comp_apply]
      have h0 : Equiv.swap (0 : Fin 1).castSucc (0 : Fin 1).succ 0 = 1 := by decide
      have h1 : Equiv.swap (0 : Fin 1).castSucc (0 : Fin 1).succ 1 = 0 := by decide
      rw [h0, h1]
      exact hS.eq _ _
    | succ k ih =>
      intro W _ _ g hg y hy u τ
      have hgy : ContDiffAt ℝ ∞ g y := hg.contDiffAt (hU.mem_nhds hy)

      have hzero : ∀ v : Fin (k + 2 + 1) → E,
          iteratedFDeriv ℝ (k + 2 + 1) g y
            (v ∘ Equiv.swap (0 : Fin (k + 2)).castSucc (0 : Fin (k + 2)).succ) =
          iteratedFDeriv ℝ (k + 2 + 1) g y v := by
        intro v
        have hg' : ContDiffOn ℝ ∞ (fderiv ℝ g) U :=
          ((contDiffOn_infty_iff_fderiv_of_isOpen hU).mp hg).2
        rw [iteratedFDeriv_succ_apply_right (n := k + 2), iteratedFDeriv_succ_apply_right (n := k + 2)]
        have hlast : (v ∘ Equiv.swap (0 : Fin (k + 2)).castSucc (0 : Fin (k + 2)).succ)
            (Fin.last (k + 2)) = v (Fin.last (k + 2)) := by
          simp only [Function.comp_apply]
          rw [Equiv.swap_apply_of_ne_of_ne]
          · apply Fin.ne_of_val_ne; simp
          · apply Fin.ne_of_val_ne; simp
        have hinit : Fin.init (v ∘ Equiv.swap (0 : Fin (k + 2)).castSucc (0 : Fin (k + 2)).succ) =
            Fin.init v ∘ Equiv.swap (0 : Fin (k + 1)).castSucc (0 : Fin (k + 1)).succ := by
          funext l
          simp only [Fin.init, Function.comp_apply]
          congr 1
          rw [Function.Injective.map_swap (Fin.castSucc_injective _)]
          congr 1
        rw [hlast, hinit]
        exact congrArg (fun A => A (v (Fin.last (k + 2))))
          (ih (fderiv ℝ g) hg' y hy (Fin.init v)
            (Equiv.swap (0 : Fin (k + 1)).castSucc (0 : Fin (k + 1)).succ))

      have hsucc : ∀ (j : Fin (k + 1)) (v : Fin (k + 2 + 1) → E),
          iteratedFDeriv ℝ (k + 2 + 1) g y (v ∘ Equiv.swap j.succ.castSucc j.succ.succ) =
          iteratedFDeriv ℝ (k + 2 + 1) g y v := by
        intro j v
        rw [iteratedFDeriv_succ_apply_left (n := k + 2), iteratedFDeriv_succ_apply_left (n := k + 2)]
        have h0 : (v ∘ Equiv.swap j.succ.castSucc j.succ.succ) 0 = v 0 := by
          simp only [Function.comp_apply]
          rw [Equiv.swap_apply_of_ne_of_ne]
          · rw [← Fin.succ_castSucc]; exact (Fin.succ_ne_zero _).symm
          · exact (Fin.succ_ne_zero _).symm
        have htail : Fin.tail (v ∘ Equiv.swap j.succ.castSucc j.succ.succ) =
            Fin.tail v ∘ Equiv.swap j.castSucc j.succ := by
          funext l
          simp only [Fin.tail, Function.comp_apply]
          rw [Function.Injective.map_swap (Fin.succ_injective _), Fin.succ_castSucc]
        rw [h0, htail]
        have hd : DifferentiableAt ℝ (iteratedFDeriv ℝ (k + 2) g) y :=
          hgy.differentiableAt_iteratedFDeriv
            (WithTop.coe_lt_coe.mpr (ENat.natCast_lt_top (k + 2)))
        rw [← fderiv_continuousMultilinear_apply_const_apply hd
              (Fin.tail v ∘ Equiv.swap j.castSucc j.succ) (v 0),
            ← fderiv_continuousMultilinear_apply_const_apply hd (Fin.tail v) (v 0)]
        congr 1
        apply Filter.EventuallyEq.fderiv_eq
        filter_upwards [hU.mem_nhds hy] with y' hy'
        exact ih g hg y' hy' _ _
      show iteratedFDeriv ℝ (k + 2 + 1) g y (u ∘ τ) = iteratedFDeriv ℝ (k + 2 + 1) g y u
      refine hperm (k + 2) (iteratedFDeriv ℝ (k + 2 + 1) g y) ?_ u τ
      intro i v
      refine Fin.cases ?_ (fun j => ?_) i
      · exact hzero v
      · exact hsucc j v

  rcases m with _ | _ | k
  · congr 1; funext i; exact Fin.elim0 i
  · congr 1; funext i; simp only [Function.comp_apply]; congr 1
    exact Fin.ext (by have := (σ i).isLt; have := i.isLt; omega)
  · exact Q k f hf z hz w σ

theorem jet_eq_zero_of_time_jet_zero : ∀ (D : (m : ℕ) → EuclideanSpace ℝ (Fin 3) → ContinuousMultilinearMap ℝ (fun _ : Fin m => EuclideanSpace ℝ (Fin 3) × ℝ) (EuclideanSpace ℝ (Fin 3))), (∀ m x, HasFDerivAt (D m) ((D (m+1) x).curryLeft.comp (ContinuousLinearMap.inl ℝ (EuclideanSpace ℝ (Fin 3)) ℝ)) x) → (∀ m x (w : Fin m → EuclideanSpace ℝ (Fin 3) × ℝ) (σ : Equiv.Perm (Fin m)), D m x (w ∘ σ) = D m x w) → (∀ m x, D m x (fun _ => ((0 : EuclideanSpace ℝ (Fin 3)), (1 : ℝ))) = 0) → ∀ m x, D m x = 0 :=
by
  intro D hD hS hT
  have key : ∀ (n : ℕ) (A : ContinuousMultilinearMap ℝ
      (fun _ : Fin (n+1) => EuclideanSpace ℝ (Fin 3) × ℝ) (EuclideanSpace ℝ (Fin 3))),
      (∀ (w : Fin (n+1) → EuclideanSpace ℝ (Fin 3) × ℝ) (σ : Equiv.Perm (Fin (n+1))),
        A (w ∘ σ) = A w) →
      (∀ (h : EuclideanSpace ℝ (Fin 3)) (v : Fin n → EuclideanSpace ℝ (Fin 3) × ℝ),
        A (Fin.cons ((h, (0:ℝ)) : EuclideanSpace ℝ (Fin 3) × ℝ) v) = 0) →
      A (fun _ => ((0 : EuclideanSpace ℝ (Fin 3)), (1 : ℝ))) = 0 → A = 0 := by
    intro n A hSym hCons hTime
    refine ContinuousMultilinearMap.ext (fun w => ?_)
    set a : Fin (n+1) → EuclideanSpace ℝ (Fin 3) × ℝ := fun i => ((w i).1, (0:ℝ)) with ha
    set b : Fin (n+1) → EuclideanSpace ℝ (Fin 3) × ℝ :=
      fun i => ((0 : EuclideanSpace ℝ (Fin 3)), (w i).2) with hb
    have hw : w = a + b := by
      funext i
      ext <;> simp [a, b]
    rw [ContinuousMultilinearMap.zero_apply, hw, A.map_add_univ]
    apply Finset.sum_eq_zero
    intro s _
    rcases s.eq_empty_or_nonempty with hs | ⟨i, hi⟩
    · subst hs
      rw [Finset.piecewise_empty]
      have hb' : b = fun i => (w i).2 • ((0 : EuclideanSpace ℝ (Fin 3)), (1 : ℝ)) := by
        funext i
        ext <;> simp [b]
      rw [hb', A.map_smul_univ, hTime, smul_zero]
    · rw [← hSym (s.piecewise a b) (Equiv.swap 0 i)]
      have h0 : (s.piecewise a b ∘ Equiv.swap 0 i) 0 = ((w i).1, (0:ℝ)) := by
        rw [Function.comp_apply, Equiv.swap_apply_left, Finset.piecewise_eq_of_mem _ _ _ hi]
      have hu : (s.piecewise a b ∘ Equiv.swap 0 i) =
          Fin.cons ((w i).1, (0:ℝ)) (Fin.tail (s.piecewise a b ∘ Equiv.swap 0 i)) := by
        rw [← h0]
        exact (Fin.cons_self_tail _).symm
      rw [hu]
      exact hCons _ _
  intro m
  induction m with
  | zero =>
    intro x
    refine ContinuousMultilinearMap.ext (fun w => ?_)
    have hw : w = fun _ => ((0 : EuclideanSpace ℝ (Fin 3)), (1 : ℝ)) := Subsingleton.elim _ _
    rw [ContinuousMultilinearMap.zero_apply, hw]
    exact hT 0 x
  | succ n IH =>
    intro x
    apply key n (D (n+1) x) (hS (n+1) x) _ (hT (n+1) x)
    intro h v
    have h0 : D n = fun _ => 0 := funext IH
    have hd := hD n x
    rw [h0] at hd
    have hL := hd.unique (hasFDerivAt_const 0 x)
    have := congrArg (fun L => L h v) hL
    simpa [ContinuousMultilinearMap.curryLeft_apply] using this

theorem borel_term_small : ∀ (c R ε : ℝ) (j : ℕ) (f : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3)), ContDiff ℝ ∞ f → (∀ x, R ≤ ‖x‖ → f x = 0) → 0 < ε → ∃ lam : ℝ, 1 ≤ lam ∧ ∀ k : ℕ, k < j → ∀ z : EuclideanSpace ℝ (Fin 3) × ℝ, ‖iteratedFDeriv ℝ k (fun z : EuclideanSpace ℝ (Fin 3) × ℝ => (Real.smoothTransition (4/3 * (1 - (lam * (z.2 - c))^2)) * (z.2 - c)^j / (j.factorial : ℝ)) • f z.1) z‖ ≤ ε :=
by
  intro c R ε j f hf hR hε

  set h : ℝ → ℝ := fun s => Real.smoothTransition (4/3 * (1 - s^2)) * s^j / (j.factorial : ℝ) with hh_def
  have hsm : ContDiff ℝ ∞ h := by
    have h1 : ContDiff ℝ ∞ (fun s : ℝ => Real.smoothTransition (4/3 * (1 - s^2))) :=
      Real.smoothTransition.contDiff.comp (contDiff_const.mul (contDiff_const.sub (contDiff_id.pow 2)))
    exact (h1.mul (contDiff_id.pow j)).div_const _
  have hcs : HasCompactSupport h := by
    apply HasCompactSupport.intro (isCompact_Icc : IsCompact (Icc (-1:ℝ) 1))
    intro s hs
    simp only [mem_Icc, not_and_or, not_le] at hs
    have : 1 < s^2 := by rcases hs with hs | hs <;> nlinarith
    simp only [hh_def]
    rw [Real.smoothTransition.zero_of_nonpos (by nlinarith)]
    simp
  have hb : ∀ i : ℕ, ∃ C, ∀ s, ‖iteratedFDeriv ℝ i h s‖ ≤ C := by
    intro i
    exact (hsm.continuous_iteratedFDeriv (by exact_mod_cast le_top)).bounded_above_of_compact_support
      (hcs.iteratedFDeriv i)
  choose C hC using hb
  obtain ⟨H, hH_def⟩ : ∃ H : ℕ → ℝ, H = fun i => max (C i) 0 := ⟨_, rfl⟩
  have hH0 : ∀ i, 0 ≤ H i := fun i => by rw [hH_def]; exact le_max_right _ _
  have hHb : ∀ (i : ℕ) (s : ℝ), ‖iteratedDeriv i h s‖ ≤ H i := by
    intro i s
    rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv, hH_def]
    exact (hC i s).trans (le_max_left _ _)

  have hfcs : HasCompactSupport f := by
    apply HasCompactSupport.intro (isCompact_closedBall (0 : EuclideanSpace ℝ (Fin 3)) (max R 0))
    intro x hx
    rw [Metric.mem_closedBall, dist_zero_right, not_le] at hx
    exact hR x ((le_max_left R 0).trans hx.le)
  have hbf : ∀ l : ℕ, ∃ C, ∀ x, ‖iteratedFDeriv ℝ l f x‖ ≤ C := by
    intro l
    exact (hf.continuous_iteratedFDeriv (by exact_mod_cast le_top)).bounded_above_of_compact_support
      (hfcs.iteratedFDeriv l)
  choose Cf hCf using hbf
  obtain ⟨B, hB_def⟩ : ∃ B : ℕ → ℝ, B = fun l => max (Cf l) 0 := ⟨_, rfl⟩
  have hB0 : ∀ l, 0 ≤ B l := fun l => by rw [hB_def]; exact le_max_right _ _
  have hBb : ∀ (l : ℕ) (x : EuclideanSpace ℝ (Fin 3)), ‖iteratedFDeriv ℝ l f x‖ ≤ B l := by
    intro l x
    rw [hB_def]
    exact (hCf l x).trans (le_max_left _ _)

  have scal : ∀ lam : ℝ, lam ≠ 0 → ∀ (i : ℕ) (t : ℝ),
      iteratedDeriv i (fun t : ℝ => Real.smoothTransition (4/3 * (1 - (lam * (t - c))^2)) * (t - c)^j
        / (j.factorial : ℝ)) t = (lam ^ j)⁻¹ * lam ^ i * iteratedDeriv i h (lam * (t - c)) := by
    intro lam hlam i t
    have e1 : (fun t : ℝ => Real.smoothTransition (4/3 * (1 - (lam * (t - c))^2)) * (t - c)^j
        / (j.factorial : ℝ)) = fun t => (lam^j)⁻¹ * h (lam * (t - c)) := by
      funext t
      simp only [hh_def, mul_pow]
      field_simp
    have e2 : iteratedDeriv i (fun t => h (lam * (t - c))) t
        = iteratedDeriv i (fun u => h (lam * u)) (t - c) :=
      congrFun (iteratedDeriv_comp_sub_const i (fun u => h (lam * u)) c) t
    have e3 : iteratedDeriv i (fun u => h (lam * u)) (t - c)
        = lam ^ i * iteratedDeriv i h (lam * (t - c)) :=
      congrFun (iteratedDeriv_comp_const_mul (hsm.of_le (by exact_mod_cast le_top)) lam) (t - c)
    rw [e1, iteratedDeriv_const_mul_field, e2, e3]
    ring

  have leib : ∀ g : ℝ → ℝ, ContDiff ℝ ∞ g → ∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 3) × ℝ),
      ‖iteratedFDeriv ℝ k (fun z : EuclideanSpace ℝ (Fin 3) × ℝ => g z.2 • f z.1) z‖ ≤
        ∑ i ∈ Finset.range (k+1), (k.choose i : ℝ) * ‖iteratedDeriv i g z.2‖ *
          ‖iteratedFDeriv ℝ (k - i) f z.1‖ := by
    intro g hg k z
    have hG : ContDiff ℝ ∞ (fun z : EuclideanSpace ℝ (Fin 3) × ℝ => g z.2) := hg.comp contDiff_snd
    have hF : ContDiff ℝ ∞ (fun z : EuclideanSpace ℝ (Fin 3) × ℝ => f z.1) := hf.comp contDiff_fst
    refine (norm_iteratedFDeriv_smul_le hG hF z (by exact_mod_cast le_top)).trans ?_
    apply Finset.sum_le_sum
    intro i _
    have h1 : ‖iteratedFDeriv ℝ i (fun z : EuclideanSpace ℝ (Fin 3) × ℝ => g z.2) z‖
        ≤ ‖iteratedDeriv i g z.2‖ := by
      have : (fun z : EuclideanSpace ℝ (Fin 3) × ℝ => g z.2)
          = g ∘ ⇑(ContinuousLinearMap.snd ℝ (EuclideanSpace ℝ (Fin 3)) ℝ) := rfl
      rw [this, ContinuousLinearMap.iteratedFDeriv_comp_right _ hg z (by exact_mod_cast le_top)]
      refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
      rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
      simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      apply mul_le_of_le_one_right (norm_nonneg _)
      exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_snd_le ℝ _ ℝ)
    have h2 : ∀ m : ℕ, ‖iteratedFDeriv ℝ m (fun z : EuclideanSpace ℝ (Fin 3) × ℝ => f z.1) z‖
        ≤ ‖iteratedFDeriv ℝ m f z.1‖ := by
      intro m
      have : (fun z : EuclideanSpace ℝ (Fin 3) × ℝ => f z.1)
          = f ∘ ⇑(ContinuousLinearMap.fst ℝ (EuclideanSpace ℝ (Fin 3)) ℝ) := rfl
      rw [this, ContinuousLinearMap.iteratedFDeriv_comp_right _ hf z (by exact_mod_cast le_top)]
      refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
      simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      apply mul_le_of_le_one_right (norm_nonneg _)
      exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_fst_le ℝ _ ℝ)
    gcongr
    exact h2 _

  obtain ⟨A, hA_def⟩ : ∃ A : ℕ → ℝ,
      A = fun k => ∑ i ∈ Finset.range (k+1), (k.choose i : ℝ) * H i * B (k - i) := ⟨_, rfl⟩
  have hA0 : ∀ k, 0 ≤ A k := by
    intro k
    rw [hA_def]
    exact Finset.sum_nonneg (fun i _ => mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (hH0 i)) (hB0 _))
  obtain ⟨S, hS_def⟩ : ∃ S : ℝ, S = ∑ k ∈ Finset.range j, A k := ⟨_, rfl⟩
  have hS0 : 0 ≤ S := by rw [hS_def]; exact Finset.sum_nonneg (fun k _ => hA0 k)
  obtain ⟨lam, hlam_def⟩ : ∃ lam : ℝ, lam = 1 + S / ε := ⟨_, rfl⟩
  have hSe : 0 ≤ S / ε := div_nonneg hS0 hε.le
  have hlam1 : 1 ≤ lam := by rw [hlam_def]; linarith
  have hlam0 : 0 < lam := by linarith
  refine ⟨lam, hlam1, ?_⟩
  intro k hk z
  have hgsm : ContDiff ℝ ∞ (fun t : ℝ => Real.smoothTransition (4/3 * (1 - (lam * (t - c))^2)) * (t - c)^j
      / (j.factorial : ℝ)) := by
    have h1 : ContDiff ℝ ∞ (fun t : ℝ => Real.smoothTransition (4/3 * (1 - (lam * (t - c))^2))) :=
      Real.smoothTransition.contDiff.comp (contDiff_const.mul (contDiff_const.sub
        ((contDiff_const.mul (contDiff_id.sub contDiff_const)).pow 2)))
    exact (h1.mul ((contDiff_id.sub contDiff_const).pow j)).div_const _
  refine (leib _ hgsm k z).trans ?_
  calc ∑ i ∈ Finset.range (k+1), (k.choose i : ℝ) *
          ‖iteratedDeriv i (fun t : ℝ => Real.smoothTransition (4/3 * (1 - (lam * (t - c))^2)) * (t - c)^j
            / (j.factorial : ℝ)) z.2‖ * ‖iteratedFDeriv ℝ (k - i) f z.1‖
      ≤ ∑ i ∈ Finset.range (k+1), (k.choose i : ℝ) * H i * B (k - i) / lam := by
        apply Finset.sum_le_sum
        intro i hi
        have hik : i + 1 ≤ j := by
          rw [Finset.mem_range] at hi
          omega
        have hfac : (lam ^ j)⁻¹ * lam ^ i ≤ 1 / lam := by
          rw [inv_mul_eq_div, div_le_div_iff₀ (pow_pos hlam0 j) hlam0]
          have := pow_le_pow_right₀ hlam1 hik
          rw [pow_succ] at this
          linarith
        have hgi : ‖iteratedDeriv i (fun t : ℝ => Real.smoothTransition (4/3 * (1 - (lam * (t - c))^2))
            * (t - c)^j / (j.factorial : ℝ)) z.2‖ ≤ H i / lam := by
          rw [scal lam hlam0.ne' i z.2, norm_mul, norm_mul,
            Real.norm_of_nonneg (inv_nonneg.2 (pow_pos hlam0 j).le),
            Real.norm_of_nonneg (pow_pos hlam0 i).le]
          calc (lam ^ j)⁻¹ * lam ^ i * ‖iteratedDeriv i h (lam * (z.2 - c))‖
              ≤ (1 / lam) * H i :=
                mul_le_mul hfac (hHb i _) (norm_nonneg _) (by positivity)
            _ = H i / lam := by ring
        calc (k.choose i : ℝ) * ‖iteratedDeriv i (fun t : ℝ => Real.smoothTransition
              (4/3 * (1 - (lam * (t - c))^2)) * (t - c)^j / (j.factorial : ℝ)) z.2‖ *
              ‖iteratedFDeriv ℝ (k - i) f z.1‖
            ≤ (k.choose i : ℝ) * (H i / lam) * B (k - i) :=
              mul_le_mul (mul_le_mul_of_nonneg_left hgi (Nat.cast_nonneg _)) (hBb _ _) (norm_nonneg _)
                (mul_nonneg (Nat.cast_nonneg _) (div_nonneg (hH0 i) hlam0.le))
          _ = (k.choose i : ℝ) * H i * B (k - i) / lam := by ring
    _ = A k / lam := by rw [hA_def, Finset.sum_div]
    _ ≤ S / lam := by
        apply div_le_div_of_nonneg_right _ hlam0.le
        rw [hS_def]
        exact Finset.single_le_sum (fun k _ => hA0 k) (Finset.mem_range.2 hk)
    _ ≤ ε := by
        rw [div_le_iff₀ hlam0, hlam_def]
        have : ε * (S / ε) = S := by field_simp
        nlinarith

theorem borel_term_props : ∀ (c R lam : ℝ) (j : ℕ) (f : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3)), ContDiff ℝ ∞ f → (∀ x, R ≤ ‖x‖ → f x = 0) → 1 ≤ lam → ContDiff ℝ ∞ (fun z : EuclideanSpace ℝ (Fin 3) × ℝ => (Real.smoothTransition (4/3 * (1 - (lam * (z.2 - c))^2)) * (z.2 - c)^j / (j.factorial : ℝ)) • f z.1) ∧ (∀ (x : EuclideanSpace ℝ (Fin 3)) (t : ℝ), R ≤ ‖x‖ → (Real.smoothTransition (4/3 * (1 - (lam * (t - c))^2)) * (t - c)^j / (j.factorial : ℝ)) • f x = 0) ∧ (∀ (x : EuclideanSpace ℝ (Fin 3)) (t : ℝ), c + 1 ≤ t → (Real.smoothTransition (4/3 * (1 - (lam * (t - c))^2)) * (t - c)^j / (j.factorial : ℝ)) • f x = 0) ∧ (∀ k : ℕ, ∃ M : ℝ, ∀ z : EuclideanSpace ℝ (Fin 3) × ℝ, ‖iteratedFDeriv ℝ k (fun z : EuclideanSpace ℝ (Fin 3) × ℝ => (Real.smoothTransition (4/3 * (1 - (lam * (z.2 - c))^2)) * (z.2 - c)^j / (j.factorial : ℝ)) • f z.1) z‖ ≤ M) :=
by
  intro c R lam j f hf hR hlam
  have hσ0 : ∀ t : ℝ, 1 ≤ |t - c| →
      Real.smoothTransition (4/3 * (1 - (lam * (t - c))^2)) * (t - c)^j / (j.factorial : ℝ) = 0 := by
    intro t ht
    have h1 : 1 ≤ (t - c)^2 := (one_le_sq_iff_one_le_abs _).mpr ht
    have h2 : 1 ≤ lam^2 := by nlinarith
    have h3 : 1 ≤ (lam * (t - c))^2 := by rw [mul_pow]; nlinarith
    have h4 : 4/3 * (1 - (lam * (t - c))^2) ≤ 0 := by nlinarith
    rw [Real.smoothTransition.zero_of_nonpos h4, zero_mul, zero_div]
  set φ : EuclideanSpace ℝ (Fin 3) × ℝ → EuclideanSpace ℝ (Fin 3) := fun z =>
    (Real.smoothTransition (4/3 * (1 - (lam * (z.2 - c))^2)) * (z.2 - c)^j / (j.factorial : ℝ)) • f z.1
    with hφ
  have hA : ContDiff ℝ ∞ φ := by
    have g1 : ContDiff ℝ ∞ (fun z : EuclideanSpace ℝ (Fin 3) × ℝ => 4/3 * (1 - (lam * (z.2 - c))^2)) := by
      fun_prop
    have g2 : ContDiff ℝ ∞ (fun z : EuclideanSpace ℝ (Fin 3) × ℝ =>
        Real.smoothTransition (4/3 * (1 - (lam * (z.2 - c))^2))) :=
      (Real.smoothTransition.contDiff (n := ⊤)).comp g1
    have g3 : ContDiff ℝ ∞ (fun z : EuclideanSpace ℝ (Fin 3) × ℝ =>
        Real.smoothTransition (4/3 * (1 - (lam * (z.2 - c))^2)) * (z.2 - c)^j / (j.factorial : ℝ)) :=
      (g2.mul ((contDiff_snd.sub contDiff_const).pow j)).div_const _
    exact g3.smul (hf.comp contDiff_fst)
  have hK : IsCompact (Metric.closedBall (0 : EuclideanSpace ℝ (Fin 3)) (max R 0) ×ˢ Set.Icc (c - 1) (c + 1)) :=
    (isCompact_closedBall _ _).prod isCompact_Icc
  have hcs : HasCompactSupport φ := by
    refine HasCompactSupport.intro hK ?_
    intro z hz
    rw [Set.mem_prod, not_and_or] at hz
    rcases hz with hz | hz
    · rw [Metric.mem_closedBall, dist_zero_right, not_le] at hz
      have : f z.1 = 0 := hR _ (le_trans (le_max_left _ _) hz.le)
      simp only [hφ, this, smul_zero]
    · rw [Set.mem_Icc, not_and_or, not_le, not_le] at hz
      have h1 : 1 ≤ |z.2 - c| := by
        rcases hz with hz | hz
        · rw [le_abs]; right; linarith
        · rw [le_abs]; left; linarith
      simp only [hφ, hσ0 z.2 h1, zero_smul]
  refine ⟨hA, ?_, ?_, ?_⟩
  · intro x t hx
    rw [hR x hx, smul_zero]
  · intro x t ht
    have h1 : 1 ≤ |t - c| := by rw [le_abs]; left; linarith
    rw [hσ0 t h1, zero_smul]
  · intro k
    exact (hcs.iteratedFDeriv k).exists_bound_of_continuous
      (hA.continuous_iteratedFDeriv (by exact_mod_cast le_top))

theorem borel_term_jet : ∀ (c lam : ℝ) (j i : ℕ) (f : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3)), ContDiff ℝ ∞ f → ∀ x : EuclideanSpace ℝ (Fin 3), iteratedFDeriv ℝ i (fun z : EuclideanSpace ℝ (Fin 3) × ℝ => (Real.smoothTransition (4/3 * (1 - (lam * (z.2 - c))^2)) * (z.2 - c)^j / (j.factorial : ℝ)) • f z.1) (x, c) (fun _ => ((0 : EuclideanSpace ℝ (Fin 3)), (1 : ℝ))) = if i = j then f x else 0 :=
by
  intro c lam j i f hf x

  have hline : ∀ Φ : EuclideanSpace ℝ (Fin 3) × ℝ → EuclideanSpace ℝ (Fin 3), ContDiff ℝ ∞ Φ →
      iteratedFDeriv ℝ i Φ (x, c) (fun _ => ((0 : EuclideanSpace ℝ (Fin 3)), (1 : ℝ))) =
        iteratedDeriv i (fun s : ℝ => Φ (x, s)) c := by
    intro Φ hΦ
    let g : ℝ →L[ℝ] EuclideanSpace ℝ (Fin 3) × ℝ := ContinuousLinearMap.inr ℝ (EuclideanSpace ℝ (Fin 3)) ℝ
    let a : EuclideanSpace ℝ (Fin 3) × ℝ := (x, 0)
    have hΦ' : ContDiff ℝ ∞ (fun w => Φ (w + a)) := hΦ.comp (contDiff_id.add contDiff_const)
    have heq : (fun s : ℝ => Φ (x, s)) = (fun w => Φ (w + a)) ∘ g := by
      funext s
      simp [g, a]
    rw [heq, iteratedDeriv_eq_iteratedFDeriv,
      ContinuousLinearMap.iteratedFDeriv_comp_right g hΦ' c (by exact_mod_cast le_top),
      ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_comp_add_right]
    simp [g, a]

  have hΦ : ContDiff ℝ ∞ (fun z : EuclideanSpace ℝ (Fin 3) × ℝ => (Real.smoothTransition (4/3 * (1 - (lam * (z.2 - c))^2)) * (z.2 - c)^j / (j.factorial : ℝ)) • f z.1) := by
    have h1 : ContDiff ℝ ∞ (fun z : EuclideanSpace ℝ (Fin 3) × ℝ =>
        Real.smoothTransition (4/3 * (1 - (lam * (z.2 - c))^2))) :=
      (Real.smoothTransition.contDiff (n := ⊤)).comp
        (contDiff_const.mul (contDiff_const.sub ((contDiff_const.mul (contDiff_snd.sub contDiff_const)).pow 2)))
    exact ((h1.mul ((contDiff_snd.sub contDiff_const).pow j)).div_const _).smul (hf.comp contDiff_fst)

  have hev : ∀ᶠ t in nhds c, Real.smoothTransition (4/3 * (1 - (lam * (t - c))^2)) = 1 := by
    have hδ : (0:ℝ) < 1 / (2 * (|lam| + 1)) := by positivity
    filter_upwards [Metric.ball_mem_nhds c hδ] with t ht
    apply Real.smoothTransition.one_of_one_le
    rw [Metric.mem_ball, Real.dist_eq] at ht
    have hl : 0 ≤ |lam| := abs_nonneg _
    have hu : |lam| * |t - c| < 1/2 := by
      have h1 : |lam| * |t - c| ≤ |lam| * (1 / (2 * (|lam| + 1))) :=
        mul_le_mul_of_nonneg_left ht.le hl
      have h2 : |lam| * (1 / (2 * (|lam| + 1))) < 1/2 := by
        rw [mul_one_div, div_lt_iff₀ (by positivity)]
        linarith
      linarith
    have hsq : (lam * (t - c))^2 = (|lam| * |t - c|)^2 := by rw [← abs_mul, sq_abs]
    have hu0 : 0 ≤ |lam| * |t - c| := by positivity
    rw [hsq]
    nlinarith

  have hmono : iteratedDeriv i (fun t : ℝ => (t - c) ^ j / (j.factorial : ℝ)) c = if i = j then 1 else 0 := by
    have h1 := congrFun (iteratedDeriv_comp_sub_const i (fun u : ℝ => u ^ j / (j.factorial : ℝ)) c) c
    simp only [sub_self] at h1
    rw [h1, iteratedDeriv_div_const (fun u : ℝ => u ^ j), iteratedDeriv_pow]
    split_ifs with h
    · subst h
      have hf0 : (i.factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero i)
      simp [Nat.descFactorial_self, hf0]
    · rcases Nat.lt_or_gt_of_ne h with h' | h'
      · rw [zero_pow (by omega)]
        simp
      · rw [Nat.descFactorial_eq_zero_iff_lt.mpr h']
        simp

  rw [hline _ hΦ]
  have hq : ContDiffAt ℝ (i : WithTop ℕ∞) (fun s : ℝ => (s - c) ^ j / (j.factorial : ℝ)) c :=
    (((contDiff_id.sub contDiff_const).pow j).div_const _).contDiffAt
  refine (Filter.EventuallyEq.iteratedDeriv_eq i
    (g := fun s : ℝ => ((s - c) ^ j / (j.factorial : ℝ)) • f x) ?_).trans ?_
  · filter_upwards [hev] with s hs
    rw [hs, one_mul]
  · rw [iteratedDeriv_smul_const hq (f x), hmono]
    split_ifs <;> simp

theorem borel_extension : ∀ (c R : ℝ) (F : ℕ → EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3)), (∀ j, ContDiff ℝ ∞ (F j)) → (∀ j x, R ≤ ‖x‖ → F j x = 0) → ∃ Φ : EuclideanSpace ℝ (Fin 3) × ℝ → EuclideanSpace ℝ (Fin 3), ContDiff ℝ ∞ Φ ∧ (∀ x t, R ≤ ‖x‖ → Φ (x, t) = 0) ∧ (∀ x t, c + 1 ≤ t → Φ (x, t) = 0) ∧ (∀ (j : ℕ) x, iteratedFDeriv ℝ j Φ (x, c) (fun _ => ((0 : EuclideanSpace ℝ (Fin 3)), (1 : ℝ))) = F j x) :=
by
  intro c R F hF hR
  have hsmall : ∀ j : ℕ, ∃ lam : ℝ, 1 ≤ lam ∧ ∀ k : ℕ, k < j →
      ∀ z : EuclideanSpace ℝ (Fin 3) × ℝ, ‖iteratedFDeriv ℝ k (fun z : EuclideanSpace ℝ (Fin 3) × ℝ =>
        (Real.smoothTransition (4/3 * (1 - (lam * (z.2 - c))^2)) * (z.2 - c)^j / (j.factorial : ℝ)) • F j z.1) z‖
        ≤ (1/2 : ℝ)^j :=
    fun j => borel_term_small c R ((1/2 : ℝ)^j) j (F j) (hF j) (hR j) (by positivity)
  choose lam hlam1 hlam using hsmall
  have hprops := fun j => borel_term_props c R (lam j) j (F j) (hF j) (hR j) (hlam1 j)
  obtain ⟨φ, hφ⟩ : ∃ φ : ℕ → EuclideanSpace ℝ (Fin 3) × ℝ → EuclideanSpace ℝ (Fin 3),
      φ = fun j z => (Real.smoothTransition (4/3 * (1 - (lam j * (z.2 - c))^2)) * (z.2 - c)^j
        / (j.factorial : ℝ)) • F j z.1 := ⟨_, rfl⟩
  have hsm : ∀ j, ContDiff ℝ ∞ (φ j) := fun j => by rw [hφ]; exact (hprops j).1
  have hbd : ∀ j k, ∃ M : ℝ, ∀ z, ‖iteratedFDeriv ℝ k (φ j) z‖ ≤ M :=
    fun j => by rw [hφ]; exact (hprops j).2.2.2
  choose M hM using hbd
  have hlow : ∀ j k, k < j → ∀ z, ‖iteratedFDeriv ℝ k (φ j) z‖ ≤ (1/2 : ℝ)^j :=
    fun j => by rw [hφ]; exact hlam j
  let v : ℕ → ℕ → ℝ := fun k j => if k < j then (1/2 : ℝ)^j else M j k
  have hv : ∀ k j z, ‖iteratedFDeriv ℝ k (φ j) z‖ ≤ v k j := by
    intro k j z
    by_cases h : k < j
    · simp only [v, if_pos h]; exact hlow j k h z
    · simp only [v, if_neg h]; exact hM j k z
  have hvs : ∀ k, Summable (v k) := by
    intro k
    have h1 : Summable (fun j : ℕ => (1/2 : ℝ)^j) := summable_geometric_two
    have h2 : Summable (fun j : ℕ => if k < j then (0 : ℝ) else M j k - (1/2 : ℝ)^j) := by
      apply summable_of_ne_finset_zero (s := Finset.range (k+1))
      intro b hb
      have hkb : k < b := by
        simp only [Finset.mem_range, not_lt] at hb
        omega
      simp [hkb]
    convert h1.add h2 using 1
    funext j
    simp only [v, Pi.add_apply]
    split_ifs <;> ring
  have hzero_R : ∀ j x t, R ≤ ‖x‖ → φ j (x, t) = 0 := by
    intro j x t hx
    rw [hφ]
    exact (hprops j).2.1 x t hx
  have hzero_c : ∀ j x t, c + 1 ≤ t → φ j (x, t) = 0 := by
    intro j x t ht
    rw [hφ]
    exact (hprops j).2.2.1 x t ht
  have hjet : ∀ n j x, iteratedFDeriv ℝ j (φ n) (x, c)
      (fun _ => ((0 : EuclideanSpace ℝ (Fin 3)), (1 : ℝ))) = if n = j then F n x else 0 := by
    intro n j x
    have e := borel_term_jet c (lam n) n j (F n) (hF n) x
    rw [hφ]
    refine e.trans ?_
    by_cases h : n = j
    · subst h; simp
    · simp [h, Ne.symm h]
  refine ⟨fun z => ∑' j, φ j z, ?_, ?_, ?_, ?_⟩
  · exact contDiff_tsum (N := ⊤) (fun i => hsm i) (fun k _ => hvs k) (fun k i x _ => hv k i x)
  · intro x t hx
    simp only [hzero_R _ x t hx, tsum_zero]
  · intro x t ht
    simp only [hzero_c _ x t ht, tsum_zero]
  · intro j x
    have h1 := iteratedFDeriv_tsum_apply (N := ⊤) (fun i => hsm i) (fun k _ => hvs k)
      (fun k i x _ => hv k i x) (k := j) (by exact_mod_cast le_top) (x, c)
    rw [h1]
    haveI hcs : CompleteSpace (ContinuousMultilinearMap ℝ (fun _ : Fin j => EuclideanSpace ℝ (Fin 3) × ℝ)
        (EuclideanSpace ℝ (Fin 3))) := ContinuousMultilinearMap.instCompleteSpace
    have hsum : Summable (fun n => iteratedFDeriv ℝ j (φ n) (x, c)) :=
      Summable.of_norm_bounded (hvs j) (fun n => hv j n (x, c))
    have h2 := (ContinuousMultilinearMap.apply ℝ (fun _ : Fin j => EuclideanSpace ℝ (Fin 3) × ℝ)
      (EuclideanSpace ℝ (Fin 3)) (fun _ => ((0 : EuclideanSpace ℝ (Fin 3)), (1 : ℝ)))).map_tsum hsum
    simp only [ContinuousMultilinearMap.apply_apply] at h2
    rw [h2]
    simp only [hjet]
    exact tsum_ite_eq j (fun n => F n x)

theorem smooth_jet_uniform_left_continuity : ∀ (R c : ℝ) (Φ : EuclideanSpace ℝ (Fin 3) × ℝ → EuclideanSpace ℝ (Fin 3)), ContDiff ℝ ∞ Φ → (∀ x t, R ≤ ‖x‖ → Φ (x, t) = 0) → ∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ t₀ < c, ∀ x : EuclideanSpace ℝ (Fin 3), ∀ t : ℝ, t₀ < t → t < c → ‖iteratedFDeriv ℝ m Φ (x, t) - iteratedFDeriv ℝ m Φ (x, c)‖ < ε :=
by
  intro R c Φ hΦ hR m ε hε
  have hg : Continuous (fun z => iteratedFDeriv ℝ m Φ z) :=
    hΦ.continuous_iteratedFDeriv (by exact_mod_cast le_top)
  have hO : IsOpen {w : EuclideanSpace ℝ (Fin 3) × ℝ | R < ‖w.1‖} :=
    isOpen_lt continuous_const (continuous_norm.comp continuous_fst)
  have hvan : ∀ z : EuclideanSpace ℝ (Fin 3) × ℝ, R < ‖z.1‖ → iteratedFDeriv ℝ m Φ z = 0 := by
    intro z hz
    have hev : Φ =ᶠ[nhds z] (fun _ => (0 : EuclideanSpace ℝ (Fin 3))) :=
      Filter.eventuallyEq_of_mem (hO.mem_nhds hz) (fun w hw => hR w.1 w.2 (le_of_lt hw))
    rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
    rfl
  have hK : IsCompact (Metric.closedBall (0 : EuclideanSpace ℝ (Fin 3)) (R + 1) ×ˢ Icc (c - 1) c) :=
    (isCompact_closedBall 0 (R + 1)).prod isCompact_Icc
  have hU := hK.uniformContinuousOn_of_continuous hg.continuousOn
  rw [Metric.uniformContinuousOn_iff] at hU
  obtain ⟨δ, hδ, hU⟩ := hU ε hε
  have hmin : 0 < min 1 (δ / 2) := lt_min one_pos (half_pos hδ)
  have hm1 : min 1 (δ / 2) ≤ 1 := min_le_left _ _
  have hm2 : min 1 (δ / 2) ≤ δ / 2 := min_le_right _ _
  refine ⟨c - min 1 (δ / 2), by linarith, ?_⟩
  intro x t ht htc
  by_cases hx : ‖x‖ ≤ R + 1
  · have hxb : x ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin 3)) (R + 1) := by
      rw [Metric.mem_closedBall, dist_zero_right]; exact hx
    have ha : (x, t) ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin 3)) (R + 1) ×ˢ Icc (c - 1) c :=
      ⟨hxb, by linarith, htc.le⟩
    have hb : (x, c) ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin 3)) (R + 1) ×ˢ Icc (c - 1) c :=
      ⟨hxb, by linarith, le_rfl⟩
    have hd : dist (x, t) (x, c) < δ := by
      rw [Prod.dist_eq, dist_self, Real.dist_eq]
      refine max_lt hδ ?_
      rw [abs_sub_lt_iff]
      constructor <;> linarith
    have := hU _ ha _ hb hd
    rwa [dist_eq_norm] at this
  · push_neg at hx
    rw [hvan (x, t) (by show R < ‖x‖; linarith), hvan (x, c) (by show R < ‖x‖; linarith)]
    simpa using hε

theorem flat_glue_contDiff : ∀ (c : ℝ) (W : EuclideanSpace ℝ (Fin 3) × ℝ → EuclideanSpace ℝ (Fin 3)), ContDiffOn ℝ ∞ W (univ ×ˢ Iio c) → (∀ x t, c ≤ t → W (x, t) = 0) → (∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ t₀ < c, ∀ x : EuclideanSpace ℝ (Fin 3), ∀ t : ℝ, t₀ < t → t < c → ‖iteratedFDeriv ℝ m W (x, t)‖ < ε) → ContDiff ℝ ∞ W :=
by
  intro c W hWs hW0 hflat
  have hO : IsOpen (univ ×ˢ Iio c : Set (EuclideanSpace ℝ (Fin 3) × ℝ)) :=
    isOpen_univ.prod isOpen_Iio

  have hA : ∀ (m : ℕ) (w : EuclideanSpace ℝ (Fin 3) × ℝ), w.2 < c →
      DifferentiableAt ℝ (iteratedFDeriv ℝ m W) w := by
    intro m w hw
    have hmem : w ∈ (univ ×ˢ Iio c : Set (EuclideanSpace ℝ (Fin 3) × ℝ)) := ⟨mem_univ _, hw⟩
    have h1 : ContDiffAt ℝ ∞ W w := hWs.contDiffAt (hO.mem_nhds hmem)
    exact h1.differentiableAt_iteratedFDeriv (by exact_mod_cast ENat.coe_lt_top m)

  have hB : ∀ (m : ℕ) (ε : ℝ), 0 < ε → ∃ t₀ < c, ∀ x : EuclideanSpace ℝ (Fin 3), ∀ s : ℝ,
      t₀ < s → s < c → ‖iteratedFDeriv ℝ m W (x, s)‖ ≤ ε * (c - s) := by
    intro m ε hε
    obtain ⟨t₀, ht₀, h0⟩ := hflat (m + 1) ε hε
    refine ⟨t₀, ht₀, fun x s hs hsc => ?_⟩
    have hKc : Convex ℝ (univ ×ˢ Ioo t₀ c : Set (EuclideanSpace ℝ (Fin 3) × ℝ)) :=
      convex_univ.prod (convex_Ioo t₀ c)
    have hdiff : ∀ w ∈ (univ ×ˢ Ioo t₀ c : Set (EuclideanSpace ℝ (Fin 3) × ℝ)),
        DifferentiableAt ℝ (iteratedFDeriv ℝ m W) w :=
      fun w hw => hA m w hw.2.2
    have hbd : ∀ w ∈ (univ ×ˢ Ioo t₀ c : Set (EuclideanSpace ℝ (Fin 3) × ℝ)),
        ‖fderiv ℝ (iteratedFDeriv ℝ m W) w‖ ≤ ε := by
      intro w hw
      rw [norm_fderiv_iteratedFDeriv]
      exact (h0 w.1 w.2 hw.2.1 hw.2.2).le
    apply le_of_forall_pos_lt_add
    intro ε' hε'
    obtain ⟨t₁, ht₁, h1⟩ := hflat m ε' hε'
    have hmx : max s t₁ < c := max_lt hsc ht₁
    have hm1 := le_max_left s t₁
    have hm2 := le_max_right s t₁
    have hss' : s < (max s t₁ + c) / 2 := by linarith
    have hts' : t₁ < (max s t₁ + c) / 2 := by linarith
    have hs'c : (max s t₁ + c) / 2 < c := by linarith
    have hxs : (x, s) ∈ (univ ×ˢ Ioo t₀ c : Set (EuclideanSpace ℝ (Fin 3) × ℝ)) :=
      ⟨mem_univ _, hs, hsc⟩
    have hxs' : (x, (max s t₁ + c) / 2) ∈ (univ ×ˢ Ioo t₀ c : Set (EuclideanSpace ℝ (Fin 3) × ℝ)) :=
      ⟨mem_univ _, by linarith, hs'c⟩
    have hmvt := hKc.norm_image_sub_le_of_norm_fderiv_le hdiff hbd hxs hxs'
    have hnorm : ‖(x, (max s t₁ + c) / 2) - (x, s)‖ = (max s t₁ + c) / 2 - s := by
      rw [Prod.mk_sub_mk, sub_self, Prod.norm_mk, norm_zero, Real.norm_eq_abs,
        abs_of_pos (by linarith)]
      exact max_eq_right (by linarith)
    rw [hnorm] at hmvt
    have e1 := h1 x ((max s t₁ + c) / 2) hts' hs'c
    have htri : ‖iteratedFDeriv ℝ m W (x, s)‖ ≤ ‖iteratedFDeriv ℝ m W (x, (max s t₁ + c) / 2)‖ +
        ‖iteratedFDeriv ℝ m W (x, (max s t₁ + c) / 2) - iteratedFDeriv ℝ m W (x, s)‖ := by
      calc ‖iteratedFDeriv ℝ m W (x, s)‖
          = ‖iteratedFDeriv ℝ m W (x, (max s t₁ + c) / 2) -
              (iteratedFDeriv ℝ m W (x, (max s t₁ + c) / 2) - iteratedFDeriv ℝ m W (x, s))‖ := by
            rw [sub_sub_cancel]
        _ ≤ _ := norm_sub_le _ _
    have hle : ε * ((max s t₁ + c) / 2 - s) ≤ ε * (c - s) :=
      mul_le_mul_of_nonneg_left (by linarith) hε.le
    linarith

  have hC : ∀ m : ℕ, (∀ x t, c ≤ t → iteratedFDeriv ℝ m W (x, t) = 0) →
      ∀ z : EuclideanSpace ℝ (Fin 3) × ℝ, c ≤ z.2 →
        HasFDerivAt (iteratedFDeriv ℝ m W) (0 : (EuclideanSpace ℝ (Fin 3) × ℝ) →L[ℝ]
          ContinuousMultilinearMap ℝ (fun _ : Fin m => EuclideanSpace ℝ (Fin 3) × ℝ)
            (EuclideanSpace ℝ (Fin 3))) z := by
    intro m hvan z hz
    rw [hasFDerivAt_iff_isLittleO_nhds_zero, Asymptotics.isLittleO_iff]
    intro ε hε
    obtain ⟨t₀, ht₀, hb⟩ := hB m ε hε
    have hz0 : iteratedFDeriv ℝ m W z = 0 := hvan z.1 z.2 hz
    filter_upwards [Metric.ball_mem_nhds (0 : EuclideanSpace ℝ (Fin 3) × ℝ) (sub_pos.mpr ht₀)]
      with h hh
    rw [hz0, ContinuousLinearMap.zero_apply, sub_zero, sub_zero]
    rw [Metric.mem_ball, dist_zero_right] at hh
    have h2 : |h.2| ≤ ‖h‖ := by rw [← Real.norm_eq_abs]; exact norm_snd_le h
    have h3 := neg_abs_le h.2
    have h4 := neg_le_abs h.2
    have hzh : (z + h).2 = z.2 + h.2 := rfl
    by_cases hc : c ≤ (z + h).2
    · rw [show iteratedFDeriv ℝ m W (z + h) = 0 from hvan (z + h).1 (z + h).2 hc, norm_zero]
      positivity
    · push_neg at hc
      have hlow : t₀ < (z + h).2 := by linarith
      have hb' := hb (z + h).1 (z + h).2 hlow hc
      calc ‖iteratedFDeriv ℝ m W (z + h)‖ = ‖iteratedFDeriv ℝ m W ((z + h).1, (z + h).2)‖ := rfl
        _ ≤ ε * (c - (z + h).2) := hb'
        _ ≤ ε * ‖h‖ := mul_le_mul_of_nonneg_left (by linarith) hε.le

  have hD : ∀ m : ℕ, ∀ x t, c ≤ t → iteratedFDeriv ℝ m W (x, t) = 0 := by
    intro m
    induction m with
    | zero =>
      intro x t ht
      ext v
      rw [iteratedFDeriv_zero_apply, hW0 x t ht]
      simp
    | succ k ih =>
      intro x t ht
      rw [iteratedFDeriv_succ_eq_comp_left, Function.comp_apply,
        (hC k ih (x, t) ht).fderiv, LinearIsometryEquiv.map_zero]

  have hE : ∀ m : ℕ, Differentiable ℝ (iteratedFDeriv ℝ m W) := by
    intro m z
    by_cases hz : z.2 < c
    · exact hA m z hz
    · exact (hC m (hD m) z (not_lt.mp hz)).differentiableAt
  exact contDiff_of_differentiable_iteratedFDeriv (fun m _ => hE m)

theorem smooth_extension_past_terminal_time : ∀ (T₁ R : ℝ) (G : ℝ³ → ℝ → ℝ³), ContDiffOn ℝ ∞ (↿G) (univ ×ˢ Iio T₁) → (∀ x t, t < T₁ → R ≤ ‖x‖ → G x t = 0) → (∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ t₀ < T₁, ∀ x : ℝ³, ∀ t t' : ℝ, t₀ < t → t < T₁ → t₀ < t' → t' < T₁ → ‖iteratedFDeriv ℝ m (↿G) (x, t) - iteratedFDeriv ℝ m (↿G) (x, t')‖ < ε) → ∃ F : ℝ³ → ℝ → ℝ³, ContDiff ℝ ∞ (↿F) ∧ (∀ x t, t < T₁ → F x t = G x t) ∧ (∀ x t, R ≤ ‖x‖ → F x t = 0) ∧ (∃ S : ℝ, ∀ x t, S ≤ t → F x t = 0) :=
by
  intro T₁ R G hGs hGv hGc
  have hO : IsOpen (univ ×ˢ Iio T₁ : Set (ℝ³ × ℝ)) := isOpen_univ.prod isOpen_Iio

  obtain ⟨N, hNU, hNR⟩ :=
    jet_limits_of_uniform_cauchy T₁ R (↿G) hGs (fun x t ht hx => hGv x t ht hx) hGc

  obtain ⟨hNrel, hNsm⟩ := jet_limits_smooth T₁ (↿G) N hGs hNU

  have hFjs : ∀ j, ContDiff ℝ ∞ (fun x => N j x (fun _ => ((0 : ℝ³), (1 : ℝ)))) := by
    intro j
    exact (ContinuousMultilinearMap.apply ℝ (fun _ : Fin j => ℝ³ × ℝ) ℝ³
      (fun _ => ((0 : ℝ³), (1 : ℝ)))).contDiff.comp (hNsm j)
  have hFjR : ∀ j x, R ≤ ‖x‖ → N j x (fun _ => ((0 : ℝ³), (1 : ℝ))) = 0 := by
    intro j x hx
    rw [hNR j x hx]
    rfl

  obtain ⟨Φ, hΦs, hΦR, hΦS, hΦjet⟩ :=
    borel_extension T₁ R (fun j x => N j x (fun _ => ((0 : ℝ³), (1 : ℝ)))) hFjs hFjR

  have hΦc := smooth_jet_uniform_left_continuity R T₁ Φ hΦs hΦR

  obtain ⟨hMrel, -⟩ :=
    jet_limits_smooth T₁ Φ (fun m x => iteratedFDeriv ℝ m Φ (x, T₁)) hΦs.contDiffOn hΦc

  have hKsym := iteratedFDeriv_symm_of_contDiffOn (univ ×ˢ Iio T₁) (↿G) hO hGs
  have hNsym : ∀ m x (w : Fin m → ℝ³ × ℝ) (σ : Equiv.Perm (Fin m)),
      N m x (w ∘ σ) = N m x w := by
    intro m x w σ
    have h1 : Filter.Tendsto (fun t => iteratedFDeriv ℝ m (↿G) (x, t))
        (nhdsWithin T₁ (Iio T₁)) (nhds (N m x)) := by
      rw [Metric.tendsto_nhds]
      intro ε hε
      obtain ⟨t₀, ht₀, h⟩ := hNU m ε hε
      filter_upwards [Ioo_mem_nhdsLT ht₀] with t ht
      rw [dist_eq_norm]
      exact h x t ht.1 ht.2
    have hT : ∀ v : Fin m → ℝ³ × ℝ, Filter.Tendsto (fun t => iteratedFDeriv ℝ m (↿G) (x, t) v)
        (nhdsWithin T₁ (Iio T₁)) (nhds (N m x v)) := by
      intro v
      exact ((continuous_eval_const v).tendsto (N m x)).comp h1
    refine tendsto_nhds_unique (hT (w ∘ σ)) ?_
    refine (hT w).congr' ?_
    filter_upwards [self_mem_nhdsWithin] with t ht
    exact (hKsym (x, t) ⟨mem_univ _, ht⟩ m w σ).symm
  have hMsym : ∀ m x (w : Fin m → ℝ³ × ℝ) (σ : Equiv.Perm (Fin m)),
      iteratedFDeriv ℝ m Φ (x, T₁) (w ∘ σ) = iteratedFDeriv ℝ m Φ (x, T₁) w :=
    fun m x w σ => iteratedFDeriv_symm_of_contDiffOn univ Φ isOpen_univ hΦs.contDiffOn
      (x, T₁) (mem_univ _) m w σ

  have hNM := jet_eq_zero_of_time_jet_zero (fun m x => N m x - iteratedFDeriv ℝ m Φ (x, T₁))
    (by
      intro m x
      have := (hNrel m x).sub (hMrel m x)
      convert this using 1
      ext v w
      simp [ContinuousMultilinearMap.curryLeft_apply])
    (by
      intro m x w σ
      simp only [ContinuousMultilinearMap.sub_apply]
      rw [hNsym m x w σ, hMsym m x w σ])
    (by
      intro m x
      simp only [ContinuousMultilinearMap.sub_apply]
      rw [hΦjet m x]
      exact sub_self _)
  have hNeq : ∀ m x, N m x = iteratedFDeriv ℝ m Φ (x, T₁) := fun m x => sub_eq_zero.mp (hNM m x)

  let W : ℝ³ × ℝ → ℝ³ := fun z => if z.2 < T₁ then (↿G) z - Φ z else 0
  have hWeq : ∀ z ∈ (univ ×ˢ Iio T₁ : Set (ℝ³ × ℝ)), W z = (↿G) z - Φ z :=
    fun z hz => if_pos hz.2
  have hWs : ContDiffOn ℝ ∞ W (univ ×ˢ Iio T₁) := (hGs.sub hΦs.contDiffOn).congr hWeq
  have hW0 : ∀ x t, T₁ ≤ t → W (x, t) = 0 := fun x t ht => if_neg (not_lt.mpr ht)
  have hWflat : ∀ m : ℕ, ∀ ε : ℝ, 0 < ε → ∃ t₀ < T₁, ∀ x : ℝ³, ∀ t : ℝ, t₀ < t → t < T₁ →
      ‖iteratedFDeriv ℝ m W (x, t)‖ < ε := by
    intro m ε hε
    obtain ⟨t₁, ht₁, h1⟩ := hNU m (ε / 2) (by linarith)
    obtain ⟨t₂, ht₂, h2⟩ := hΦc m (ε / 2) (by linarith)
    refine ⟨max t₁ t₂, max_lt ht₁ ht₂, fun x t ht htc => ?_⟩
    have hmem : (x, t) ∈ (univ ×ˢ Iio T₁ : Set (ℝ³ × ℝ)) := ⟨mem_univ _, htc⟩
    have hev : W =ᶠ[nhds (x, t)] fun z => (↿G) z - Φ z :=
      Filter.eventuallyEq_of_mem (hO.mem_nhds hmem) hWeq
    have hGat : ContDiffAt ℝ ∞ (↿G) (x, t) := hGs.contDiffAt (hO.mem_nhds hmem)
    have hD : iteratedFDeriv ℝ m W (x, t) =
        iteratedFDeriv ℝ m (↿G) (x, t) - iteratedFDeriv ℝ m Φ (x, t) := by
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
      exact iteratedFDeriv_sub_apply (hGat.of_le (by exact_mod_cast le_top))
        ((hΦs.contDiffAt).of_le (by exact_mod_cast le_top))
    rw [hD]
    have e1 := h1 x t (lt_of_le_of_lt (le_max_left _ _) ht) htc
    have e2 := h2 x t (lt_of_le_of_lt (le_max_right _ _) ht) htc
    rw [hNeq] at e1
    calc ‖iteratedFDeriv ℝ m (↿G) (x, t) - iteratedFDeriv ℝ m Φ (x, t)‖
        = ‖(iteratedFDeriv ℝ m (↿G) (x, t) - iteratedFDeriv ℝ m Φ (x, T₁)) -
            (iteratedFDeriv ℝ m Φ (x, t) - iteratedFDeriv ℝ m Φ (x, T₁))‖ := by
          congr 1; abel
      _ ≤ ‖iteratedFDeriv ℝ m (↿G) (x, t) - iteratedFDeriv ℝ m Φ (x, T₁)‖ +
            ‖iteratedFDeriv ℝ m Φ (x, t) - iteratedFDeriv ℝ m Φ (x, T₁)‖ := norm_sub_le _ _
      _ < ε := by linarith

  have hWsm : ContDiff ℝ ∞ W := flat_glue_contDiff T₁ W hWs hW0 hWflat

  refine ⟨fun x t => Φ (x, t) + W (x, t), ?_, ?_, ?_, ⟨T₁ + 1, ?_⟩⟩
  · have hfun : (↿(fun x t => Φ (x, t) + W (x, t))) = fun z => Φ z + W z := by
      funext z
      rfl
    rw [hfun]
    exact hΦs.add hWsm
  · intro x t ht
    show Φ (x, t) + (if t < T₁ then G x t - Φ (x, t) else 0) = G x t
    rw [if_pos ht]
    abel
  · intro x t hx
    show Φ (x, t) + (if t < T₁ then G x t - Φ (x, t) else 0) = 0
    split_ifs with h
    · rw [hGv x t h hx, hΦR x t hx]
      simp
    · rw [hΦR x t hx]
      simp
  · intro x t ht
    show Φ (x, t) + W (x, t) = 0
    rw [hΦS x t ht, hW0 x t (by linarith)]
    simp

theorem blowup_package_rescale : ∀ (ν₀ ν T R : ℝ) (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (f : ℝ³ → ℝ → ℝ³), 0 < ν₀ → 0 < ν → BlowupPackage ν₀ T R u p f → ∀ ρ : ℝ, 0 < ρ → ∃ (T' : ℝ) (u' : ℝ³ → ℝ → ℝ³) (p' : ℝ³ → ℝ → ℝ) (f' : ℝ³ → ℝ → ℝ³), BlowupPackage ν T' ρ u' p' f' :=
by
  intro ν₀ ν T R u p f hν₀ hν hP ρ hρ
  unfold BlowupPackage at hP
  obtain ⟨hT, hR, hu, hp, hf, hvan, hinit, hfvan, ⟨S, hfS⟩, hres, hdiv, hunb⟩ := hP

  have hG : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (G : ℝ³ → E) (c k : ℝ),
      fderiv ℝ (fun z => c • G (k • z)) = fun z => (c * k) • fderiv ℝ G (k • z) := by
    intro E _ _ G c k
    have h1 : (fun z => c • G (k • z)) = c • (fun z => G (k • z)) := rfl
    rw [h1, fderiv_const_smul_field]
    funext z
    rw [Pi.smul_apply, fderiv_comp_smul, smul_smul]

  have hLap : ∀ (v : ℝ³ → ℝ³) (c k : ℝ) (x : ℝ³),
      Δ (fun z => c • v (k • z)) x = (c * k * k) • Δ v (k • x) := by
    intro v c k x
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis (fun z => c • v (k • z))
        (EuclideanSpace.basisFun (Fin 3) ℝ),
      InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis v
        (EuclideanSpace.basisFun (Fin 3) ℝ)]
    simp only [iteratedFDeriv_two_apply]
    have e1 : fderiv ℝ (fun z => c • v (k • z)) = fun z => (c * k) • fderiv ℝ v (k • z) :=
      hG v c k
    have e2 : fderiv ℝ (fun z => (c * k) • fderiv ℝ v (k • z))
        = fun z => (c * k * k) • fderiv ℝ (fderiv ℝ v) (k • z) := hG (fderiv ℝ v) (c * k) k
    rw [e1, e2]
    simp only [ContinuousLinearMap.smul_apply, Finset.smul_sum]

  have hGrad : ∀ (q : ℝ³ → ℝ) (c k : ℝ) (x : ℝ³),
      gradient (fun z => c • q (k • z)) x = (c * k) • gradient q (k • x) := by
    intro q c k x
    have e1 : fderiv ℝ (fun z => c • q (k • z)) = fun z => (c * k) • fderiv ℝ q (k • z) :=
      hG q c k
    simp only [gradient, e1]
    rw [LinearIsometryEquiv.map_smulₛₗ]
    simp

  have hDiv : ∀ (v : ℝ³ → ℝ³) (c k : ℝ) (x : ℝ³),
      divergence (fun y => c • v (k • y)) x = (c * k) * divergence v (k • x) := by
    intro v c k x
    have e1 : fderiv ℝ (fun z => c • v (k • z)) = fun z => (c * k) • fderiv ℝ v (k • z) :=
      hG v c k
    simp only [divergence, e1]
    rw [ContinuousLinearMap.toLinearMap_smul, map_smul, smul_eq_mul]

  obtain ⟨k, hkdef⟩ : ∃ k : ℝ, k = R / ρ := ⟨_, rfl⟩
  obtain ⟨a, hadef⟩ : ∃ a : ℝ, a = ν * k / ν₀ := ⟨_, rfl⟩
  obtain ⟨μ, hμdef⟩ : ∃ μ : ℝ, μ = a * k := ⟨_, rfl⟩
  have hk : 0 < k := by rw [hkdef]; exact div_pos hR hρ
  have ha : 0 < a := by rw [hadef]; exact div_pos (mul_pos hν hk) hν₀
  have hμ : 0 < μ := by rw [hμdef]; exact mul_pos ha hk
  have hkρ : k * ρ = R := by rw [hkdef]; field_simp
  have haν : ν * k = a * ν₀ := by rw [hadef]; field_simp
  have hτ : ∀ t : ℝ, t < T / μ → μ * t < T := by
    intro t ht
    have := (lt_div_iff₀ hμ).1 ht
    linarith
  have hσ : ∀ x : ℝ³, ρ ≤ ‖x‖ → R ≤ ‖k • x‖ := by
    intro x hx
    rw [norm_smul, Real.norm_of_nonneg hk.le, ← hkρ]
    exact mul_le_mul_of_nonneg_left hx hk.le

  have hNS : ∀ x t, nsResidual ν (fun y s => a • u (k • y) (μ * s))
      (fun y s => (a ^ 2) • p (k • y) (μ * s)) x t
      = (a ^ 2 * k) • nsResidual ν₀ u p (k • x) (μ * t) := by
    intro x t
    have e1 : deriv (fun s => a • u (k • x) (μ * s)) t
        = (a * μ) • deriv (fun s => u (k • x) s) (μ * t) := by
      have h1 : (fun s => a • u (k • x) (μ * s)) = a • (fun s => u (k • x) (μ * s)) := rfl
      rw [h1, deriv_const_smul_field, deriv_comp_mul_left μ (u (k • x)) t, smul_smul]
    have hGu : fderiv ℝ (fun z => a • u (k • z) (μ * t))
        = fun z => (a * k) • fderiv ℝ (fun y => u y (μ * t)) (k • z) :=
      hG (fun y => u y (μ * t)) a k
    have e2 : fderiv ℝ (fun y => a • u (k • y) (μ * t)) x (a • u (k • x) (μ * t))
        = (a * k * a) • fderiv ℝ (fun y => u y (μ * t)) (k • x) (u (k • x) (μ * t)) := by
      rw [hGu]
      simp only [ContinuousLinearMap.smul_apply, map_smul, smul_smul]
      rw [mul_comm a (a * k)]
    have e3 : Δ (fun y => a • u (k • y) (μ * t)) x
        = (a * k * k) • Δ (fun y => u y (μ * t)) (k • x) :=
      hLap (fun y => u y (μ * t)) a k x
    have e4 : gradient (fun y => (a ^ 2) • p (k • y) (μ * t)) x
        = (a ^ 2 * k) • gradient (fun y => p y (μ * t)) (k • x) :=
      hGrad (fun y => p y (μ * t)) (a ^ 2) k x
    have c1 : a * μ = a ^ 2 * k := by rw [hμdef]; ring
    have c2 : a * k * a = a ^ 2 * k := by ring
    have c3 : ν * (a * k * k) = a ^ 2 * k * ν₀ := by linear_combination (a * k) * haν
    show deriv (fun s => a • u (k • x) (μ * s)) t
        + fderiv ℝ (fun y => a • u (k • y) (μ * t)) x (a • u (k • x) (μ * t))
        - ν • Δ (fun y => a • u (k • y) (μ * t)) x
        + gradient (fun y => (a ^ 2) • p (k • y) (μ * t)) x
      = (a ^ 2 * k) • (deriv (fun s => u (k • x) s) (μ * t)
        + fderiv ℝ (fun y => u y (μ * t)) (k • x) (u (k • x) (μ * t))
        - ν₀ • Δ (fun y => u y (μ * t)) (k • x) + gradient (fun y => p y (μ * t)) (k • x))
    rw [e1, e2, e3, e4, c1, c2, smul_smul, c3]
    module

  have hφ : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => (k • z.1, μ * z.2)) :=
    (contDiff_fst.const_smul k).prodMk (contDiff_const.mul contDiff_snd)
  have hsmooth : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (g : ℝ³ → ℝ → F) (c : ℝ),
      ContDiffOn ℝ ∞ (↿g) (univ ×ˢ Iio T) →
      ContDiffOn ℝ ∞ (↿(fun (x : ℝ³) (t : ℝ) => c • g (k • x) (μ * t))) (univ ×ˢ Iio (T / μ)) := by
    intro F _ _ g c hg
    have hmaps : MapsTo (fun z : ℝ³ × ℝ => (k • z.1, μ * z.2)) (univ ×ˢ Iio (T / μ))
        (univ ×ˢ Iio T) := by
      rintro ⟨x, t⟩ ⟨_, ht⟩
      refine ⟨mem_univ _, ?_⟩
      have ht' : t < T / μ := ht
      exact hτ t ht'
    exact (hg.comp hφ.contDiffOn hmaps).const_smul c
  refine ⟨T / μ, fun x t => a • u (k • x) (μ * t), fun x t => (a ^ 2) • p (k • x) (μ * t),
    fun x t => (a ^ 2 * k) • f (k • x) (μ * t), ?_⟩
  unfold BlowupPackage
  refine ⟨div_pos hT hμ, hρ, hsmooth u a hu, hsmooth p (a ^ 2) hp, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact (hf.comp hφ).const_smul (a ^ 2 * k)
  · intro x t ht hx
    obtain ⟨hu0, hp0⟩ := hvan (k • x) (μ * t) (hτ t ht) (hσ x hx)
    simp [hu0, hp0]
  · intro x
    simp [hinit]
  · intro x t h
    have h' : R ≤ ‖k • x‖ ∨ μ * t ≤ 0 := by
      rcases h with h | h
      · exact Or.inl (hσ x h)
      · right; nlinarith
    simp [hfvan _ _ h']
  · refine ⟨S / μ, fun x t ht => ?_⟩
    have h1 : S ≤ t * μ := (div_le_iff₀ hμ).1 ht
    have h2 : S ≤ μ * t := by linarith
    simp [hfS _ _ h2]
  · intro x t ht
    rw [hNS x t, hres _ _ (hτ t ht)]
  · intro x t ht
    have h2 : divergence (fun y => a • u (k • y) (μ * t)) x
        = a * k * divergence (fun z => u z (μ * t)) (k • x) := hDiv (fun z => u z (μ * t)) a k x
    show divergence (fun y => a • u (k • y) (μ * t)) x = 0
    rw [h2, hdiv _ _ (hτ t ht), mul_zero]
  · intro M
    obtain ⟨x₀, t₀, ht0, htT, hM⟩ := hunb (M / a)
    refine ⟨k⁻¹ • x₀, t₀ / μ, div_nonneg ht0 hμ.le, div_lt_div_of_pos_right htT hμ, ?_⟩
    show M < ‖a • u (k • (k⁻¹ • x₀)) (μ * (t₀ / μ))‖
    have e : μ * (t₀ / μ) = t₀ := by field_simp
    rw [smul_inv_smul₀ hk.ne', e, norm_smul, Real.norm_of_nonneg ha.le]
    have hMa : M = a * (M / a) := by field_simp
    rw [hMa]
    exact mul_lt_mul_of_pos_left hM ha

theorem force_decay_of_compact_support : ∀ (f : ℝ³ → ℝ → ℝ³) (R S : ℝ), ContDiff ℝ ∞ (↿f) → (∀ x t, R ≤ ‖x‖ → f x t = 0) → (∀ x t, S ≤ t → f x t = 0) → ForceConditionDecay f :=
by
  intro f R S hF hR hS
  have hU : ∀ z : ℝ³ × ℝ, (R < ‖z.1‖ ∨ S < z.2) → ∀ m : ℕ,
      iteratedFDeriv ℝ m (↿f) z = 0 := by
    intro z hz m
    let U : Set (ℝ³ × ℝ) := {w | R < ‖w.1‖} ∪ {w | S < w.2}
    have hUo : IsOpen U :=
      (isOpen_lt continuous_const (continuous_norm.comp continuous_fst)).union
        (isOpen_lt continuous_const continuous_snd)
    have hFU : ∀ w ∈ U, (↿f) w = (fun _ => (0 : ℝ³)) w := by
      rintro ⟨y, τ⟩ hw
      rcases hw with hw | hw
      · exact hR y τ (le_of_lt hw)
      · exact hS y τ (le_of_lt hw)
    have hev : (↿f) =ᶠ[nhds z] (fun _ => (0 : ℝ³)) :=
      Filter.eventually_of_mem (hUo.mem_nhds hz) hFU
    rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
    rfl
  have hm : ∀ m : ℕ, (m : WithTop ℕ∞) ≤ ∞ := fun m => by exact_mod_cast le_top
  have hs : UniqueDiffOn ℝ (univ ×ˢ Ici (0:ℝ) : Set (ℝ³ × ℝ)) :=
    uniqueDiffOn_univ.prod (uniqueDiffOn_Ici 0)
  refine ⟨⟨hF.contDiffOn⟩, fun m K => ?_⟩
  have hcont : Continuous fun z => iteratedFDeriv ℝ m (↿f) z :=
    hF.continuous_iteratedFDeriv (hm m)
  have hQ : IsCompact (Metric.closedBall (0:ℝ³) |R| ×ˢ Icc (0:ℝ) |S|) :=
    (isCompact_closedBall 0 |R|).prod isCompact_Icc
  obtain ⟨M₀, hM₀⟩ := hQ.exists_bound_of_continuousOn hcont.continuousOn
  have hM : 0 ≤ max M₀ 0 := le_max_right _ _
  have hL : 1 ≤ 1 + |R| + |S| := by
    have := abs_nonneg R
    have := abs_nonneg S
    linarith
  refine ⟨max M₀ 0 * (1 + |R| + |S|) ^ |K|, fun x t ht => ?_⟩
  have ht' : (0:ℝ) ≤ t := ht
  have hb : 1 ≤ 1 + ‖x‖ + t := by
    have := norm_nonneg x
    linarith
  have hb0 : 0 < 1 + ‖x‖ + t := by linarith
  have hbK : 0 < (1 + ‖x‖ + t) ^ K := Real.rpow_pos_of_pos hb0 K
  have hmemS : ((x, t) : ℝ³ × ℝ) ∈ (univ ×ˢ Ici (0:ℝ) : Set (ℝ³ × ℝ)) :=
    ⟨mem_univ x, show t ∈ Ici (0:ℝ) from ht'⟩
  rw [iteratedFDerivWithin_eq_iteratedFDeriv hs (hF.contDiffAt.of_le (hm m)) hmemS]
  by_cases hc : R < ‖x‖ ∨ S < t
  · rw [hU (x, t) hc m, norm_zero]
    exact div_nonneg (mul_nonneg hM (Real.rpow_nonneg (by linarith) _)) hbK.le
  · push_neg at hc
    obtain ⟨hx, htS⟩ := hc
    have hxR : ‖x‖ ≤ |R| := hx.trans (le_abs_self R)
    have htS' : t ≤ |S| := htS.trans (le_abs_self S)
    have hmem : (x, t) ∈ Metric.closedBall (0:ℝ³) |R| ×ˢ Icc (0:ℝ) |S| := by
      refine ⟨?_, ht', htS'⟩
      rw [Metric.mem_closedBall, dist_zero_right]
      exact hxR
    have h1 : ‖iteratedFDeriv ℝ m (↿f) (x, t)‖ ≤ max M₀ 0 :=
      (hM₀ _ hmem).trans (le_max_left _ _)
    have key : (1 + ‖x‖ + t) ^ K ≤ (1 + |R| + |S|) ^ |K| :=
      (Real.rpow_le_rpow_of_exponent_le hb (le_abs_self K)).trans
        (Real.rpow_le_rpow hb0.le (by linarith) (abs_nonneg K))
    refine h1.trans ?_
    rw [le_div_iff₀ hbK]
    exact mul_le_mul_of_nonneg_left key hM

theorem force_periodic_of_bounded_derivs : ∀ (F : ℝ³ → ℝ → ℝ³) (S : ℝ), ContDiff ℝ ∞ (↿F) → (∀ t, IsOnePeriodic (fun x => F x t)) → (∀ x t, S ≤ t → F x t = 0) → (∀ m : ℕ, ∃ M : ℝ, ∀ x t, 0 ≤ t → ‖iteratedFDeriv ℝ m (↿F) (x, t)‖ ≤ M) → ForceConditionPeriodic F :=
by
  intro F S hF hper hS hbd
  refine { smooth := hF.contDiffOn, isOnePeriodic := fun t _ => hper t, decay := ?_ }
  intro m K
  obtain ⟨M, hM⟩ := hbd m
  set M' : ℝ := max M 0 with hM'
  have hM'0 : 0 ≤ M' := le_max_right M 0
  refine ⟨M' * (1 + |S|) ^ |K|, ?_⟩
  intro x t ht
  have hC : 0 ≤ M' * (1 + |S|) ^ |K| :=
    mul_nonneg hM'0 (Real.rpow_nonneg (by positivity) _)
  have hUD : UniqueDiffOn ℝ ((univ : Set ℝ³) ×ˢ Ici (0:ℝ)) :=
    uniqueDiffOn_univ.prod (uniqueDiffOn_Ici 0)
  have hCA : ContDiffAt ℝ (m : WithTop ℕ∞) (↿F) (x, t) :=
    hF.contDiffAt.of_le (by exact_mod_cast le_top)
  have hmem : (x, t) ∈ (univ : Set ℝ³) ×ˢ Ici (0:ℝ) := ⟨mem_univ x, ht⟩
  rw [iteratedFDerivWithin_eq_iteratedFDeriv hUD hCA hmem]
  have h1t : (1:ℝ) ≤ 1 + t := by linarith
  have hw : 0 < (1 + t) ^ K := Real.rpow_pos_of_pos (by linarith) K
  rcases le_or_gt t S with hts | hst
  · have hb : ‖iteratedFDeriv ℝ m (↿F) (x, t)‖ ≤ M' := le_trans (hM x t ht) (le_max_left M 0)
    refine le_trans hb ?_
    rw [le_div_iff₀ hw]
    have h2 : (1 + t) ^ K ≤ (1 + t) ^ |K| := Real.rpow_le_rpow_of_exponent_le h1t (le_abs_self K)
    have h3 : (1 + t) ^ |K| ≤ (1 + |S|) ^ |K| :=
      Real.rpow_le_rpow (by linarith) (by linarith [le_abs_self S]) (abs_nonneg K)
    exact mul_le_mul_of_nonneg_left (le_trans h2 h3) hM'0
  · have hU : IsOpen {z : ℝ³ × ℝ | S < z.2} := isOpen_lt continuous_const continuous_snd
    have hev : (↿F) =ᶠ[nhds (x, t)] (fun _ => (0 : ℝ³)) := by
      filter_upwards [hU.mem_nhds (show (x, t) ∈ {z : ℝ³ × ℝ | S < z.2} from hst)] with z hz
      exact hS z.1 z.2 (le_of_lt hz)
    have hz : iteratedFDeriv ℝ m (↿F) (x, t) = 0 := by
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
      rfl
    rw [hz, norm_zero]
    exact div_nonneg hC hw.le

theorem periodize_blowup_package : ∀ (ν T : ℝ) (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (f : ℝ³ → ℝ → ℝ³), BlowupPackage ν T (1/4) u p f → ∃ (U : ℝ³ → ℝ → ℝ³) (P : ℝ³ → ℝ → ℝ) (F : ℝ³ → ℝ → ℝ³) (S : ℝ), ContDiffOn ℝ ∞ (↿U) (univ ×ˢ Iio T) ∧ ContDiffOn ℝ ∞ (↿P) (univ ×ˢ Iio T) ∧ ContDiff ℝ ∞ (↿F) ∧ (∀ t, t < T → IsOnePeriodic (fun x => U x t)) ∧ (∀ t, t < T → IsOnePeriodic (fun x => P x t)) ∧ (∀ t, IsOnePeriodic (fun x => F x t)) ∧ (∀ x, U x 0 = 0) ∧ (∀ x t, t < T → nsResidual ν U P x t = F x t) ∧ (∀ x t, t < T → divergence (fun y => U y t) x = 0) ∧ (∀ x t, S ≤ t → F x t = 0) ∧ (∀ m : ℕ, ∃ M : ℝ, ∀ x t, 0 ≤ t → ‖iteratedFDeriv ℝ m (↿F) (x, t)‖ ≤ M) ∧ (∀ M : ℝ, ∃ x t, 0 ≤ t ∧ t < T ∧ ‖x‖ ≤ 1/4 ∧ M < ‖U x t‖) :=
by
  intro ν T u p f h
  obtain ⟨hT, -, hu, hp, hf, hvan, hinit, hfvan, ⟨S, hfS⟩, hres, hdiv, hunb⟩ := h

  obtain ⟨σ, hσ⟩ : ∃ σ : ℝ³ → ℝ³, ∀ x j, (σ x).ofLp j = (round (x.ofLp j) : ℝ) :=
    ⟨fun x => WithLp.toLp 2 (fun j => (round (x.ofLp j) : ℝ)), fun x j => rfl⟩

  have hK2 : ∀ (y : ℝ) (n : ℤ), |y - n| < 1/2 → round y = n := by
    intro y n hy
    rw [round_eq, Int.floor_eq_iff]
    obtain ⟨h1, h2⟩ := abs_lt.mp hy
    constructor <;> linarith
  have hcoord : ∀ (x : ℝ³) (j : Fin 3), |x.ofLp j| ≤ ‖x‖ := by
    intro x j
    have := PiLp.norm_apply_le x j
    rwa [Real.norm_eq_abs] at this

  have hper : ∀ (x : ℝ³) (i : Fin 3),
      (x + EuclideanSpace.single i 1) - σ (x + EuclideanSpace.single i 1) = x - σ x := by
    intro x i
    apply PiLp.ext
    intro j
    simp only [PiLp.sub_apply, PiLp.add_apply, hσ]
    by_cases hji : j = i
    · subst hji
      simp [round_add_one]
    · simp [hji]

  have hsmall : ∀ x : ℝ³, ‖x‖ < 1/2 → σ x = 0 := by
    intro x hx
    apply PiLp.ext
    intro j
    have hlt : |x.ofLp j - ((0 : ℤ) : ℝ)| < 1/2 := by
      rw [Int.cast_zero, sub_zero]
      exact lt_of_le_of_lt (hcoord x j) hx
    rw [hσ, hK2 _ _ hlt]
    simp

  have hloc : ∀ {E : Type} [Zero E] (G : ℝ³ → ℝ → E) (I : Set ℝ), IsOpen I →
      (∀ x t, t ∈ I → 1/4 ≤ ‖x‖ → G x t = 0) → ∀ (x₀ : ℝ³) (t₀ : ℝ), t₀ ∈ I →
      (fun z : ℝ³ × ℝ => G (z.1 - σ z.1) z.2) =ᶠ[nhds (x₀, t₀)]
        (fun z : ℝ³ × ℝ => G (z.1 - σ x₀) z.2) := by
    intro E _ G I hI hG x₀ t₀ ht₀
    have hN : Metric.ball x₀ (1/8) ×ˢ I ∈ nhds (x₀, t₀) :=
      prod_mem_nhds (Metric.ball_mem_nhds _ (by norm_num)) (hI.mem_nhds ht₀)
    filter_upwards [hN] with z hz
    rw [Set.mem_prod] at hz
    obtain ⟨hz1, hz2⟩ := hz
    rw [Metric.mem_ball, dist_eq_norm] at hz1
    show G (z.1 - σ z.1) z.2 = G (z.1 - σ x₀) z.2
    by_cases hk : σ z.1 = σ x₀
    · rw [hk]
    · have ha : 1/4 ≤ ‖z.1 - σ z.1‖ := by
        by_contra hlt
        push_neg at hlt
        apply hk
        apply PiLp.ext
        intro j
        rw [hσ, hσ]
        have h1 := hcoord (z.1 - σ z.1) j
        have h2 := hcoord (z.1 - x₀) j
        rw [PiLp.sub_apply, hσ] at h1
        rw [PiLp.sub_apply] at h2
        obtain ⟨e1, e1'⟩ := abs_lt.mp (lt_of_le_of_lt h1 hlt)
        obtain ⟨e2, e2'⟩ := abs_lt.mp (lt_of_le_of_lt h2 hz1)
        have : round (x₀.ofLp j) = round (z.1.ofLp j) :=
          hK2 _ _ (by rw [abs_lt]; constructor <;> linarith)
        rw [this]
      have hb : 1/4 ≤ ‖z.1 - σ x₀‖ := by
        by_contra hlt
        push_neg at hlt
        apply hk
        apply PiLp.ext
        intro j
        rw [hσ, hσ]
        have h1 := hcoord (z.1 - σ x₀) j
        rw [PiLp.sub_apply, hσ] at h1
        have e1 := lt_of_le_of_lt h1 hlt
        have : round (z.1.ofLp j) = round (x₀.ofLp j) := hK2 _ _ (by linarith)
        rw [this]
      rw [hG _ _ hz2 ha, hG _ _ hz2 hb]

  have htr : ∀ (U : ℝ³ → ℝ → ℝ³) (P : ℝ³ → ℝ → ℝ) (k x₀ : ℝ³) (t₀ : ℝ),
      (fun z : ℝ³ × ℝ => U z.1 z.2) =ᶠ[nhds (x₀, t₀)] (fun z : ℝ³ × ℝ => u (z.1 - k) z.2) →
      (fun z : ℝ³ × ℝ => P z.1 z.2) =ᶠ[nhds (x₀, t₀)] (fun z : ℝ³ × ℝ => p (z.1 - k) z.2) →
      nsResidual ν U P x₀ t₀ = nsResidual ν u p (x₀ - k) t₀ ∧
        divergence (fun y => U y t₀) x₀ = divergence (fun y => u y t₀) (x₀ - k) := by
    intro U P k x₀ t₀ hU hP
    have hcx : Filter.Tendsto (fun y : ℝ³ => (y, t₀)) (nhds x₀) (nhds (x₀, t₀)) :=
      (Continuous.prodMk_left t₀).tendsto x₀
    have hct : Filter.Tendsto (fun s : ℝ => (x₀, s)) (nhds t₀) (nhds (x₀, t₀)) :=
      (Continuous.prodMk_right x₀).tendsto t₀
    have h1 : (fun y => U y t₀) =ᶠ[nhds x₀] (fun y => u (y - k) t₀) := hU.comp_tendsto hcx
    have h2 : (fun s => U x₀ s) =ᶠ[nhds t₀] (fun s => u (x₀ - k) s) := hU.comp_tendsto hct
    have h3 : (fun y => P y t₀) =ᶠ[nhds x₀] (fun y => p (y - k) t₀) := hP.comp_tendsto hcx
    have h4 : U x₀ t₀ = u (x₀ - k) t₀ := hU.eq_of_nhds
    have hD : fderiv ℝ (fun y => U y t₀) x₀ = fderiv ℝ (fun y => u y t₀) (x₀ - k) := by
      rw [h1.fderiv_eq]
      exact fderiv_comp_sub (f := fun y => u y t₀) k
    have hG : gradient (fun y => P y t₀) x₀ = gradient (fun y => p y t₀) (x₀ - k) := by
      rw [h3.gradient_eq]
      unfold gradient
      rw [fderiv_comp_sub (f := fun y => p y t₀) k]
    have hL : Δ (fun y => U y t₀) x₀ = Δ (fun y => u y t₀) (x₀ - k) := by
      rw [(laplacian_congr_nhds h1).eq_of_nhds]
      rw [laplacian_eq_iteratedFDeriv_stdOrthonormalBasis,
        laplacian_eq_iteratedFDeriv_stdOrthonormalBasis]
      have := iteratedFDeriv_comp_sub (𝕜 := ℝ) (f := fun y => u y t₀) 2 k x₀
      simp only [this]
    have hd : deriv (fun s => U x₀ s) t₀ = deriv (fun s => u (x₀ - k) s) t₀ := h2.deriv_eq
    refine ⟨?_, ?_⟩
    · unfold nsResidual
      rw [hd, hD, h4, hL, hG]
    · unfold divergence
      rw [hD]

  have hcd : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (g G : ℝ³ × ℝ → E)
      (I : Set ℝ) (k : ℝ³) (z₀ : ℝ³ × ℝ), IsOpen I → z₀.2 ∈ I → ContDiffOn ℝ ∞ g (univ ×ˢ I) →
      G =ᶠ[nhds z₀] (fun z => g (z.1 - k, z.2)) → ContDiffAt ℝ ∞ G z₀ := by
    intro E _ _ g G I k z₀ hI hz hg hG
    have hτ : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => (z.1 - k, z.2)) :=
      (contDiff_fst.sub contDiff_const).prodMk contDiff_snd
    have hmem : (z₀.1 - k, z₀.2) ∈ (univ ×ˢ I : Set (ℝ³ × ℝ)) := by
      rw [Set.mem_prod]
      exact ⟨mem_univ _, hz⟩
    have hgat : ContDiffAt ℝ ∞ g (z₀.1 - k, z₀.2) :=
      hg.contDiffAt ((isOpen_univ.prod hI).mem_nhds hmem)
    have hcomp : ContDiffAt ℝ ∞ (fun z => g (z.1 - k, z.2)) z₀ := hgat.comp z₀ hτ.contDiffAt
    exact hcomp.congr_of_eventuallyEq hG

  have hit : ∀ (g G : ℝ³ × ℝ → ℝ³) (k : ℝ³) (z₀ : ℝ³ × ℝ) (m : ℕ),
      G =ᶠ[nhds z₀] (fun z => g (z.1 - k, z.2)) →
      iteratedFDeriv ℝ m G z₀ = iteratedFDeriv ℝ m g (z₀.1 - k, z₀.2) := by
    intro g G k z₀ m hG
    rw [(hG.iteratedFDeriv ℝ m).eq_of_nhds]
    have e : (fun z : ℝ³ × ℝ => g (z.1 - k, z.2)) = fun z => g (z - ((k, 0) : ℝ³ × ℝ)) := by
      funext z
      congr 1
      exact Prod.ext (by simp) (by simp)
    rw [e, iteratedFDeriv_comp_sub (f := g) m ((k, 0) : ℝ³ × ℝ) z₀]
    congr 1
    exact Prod.ext (by simp) (by simp)

  have hbd : ∀ m : ℕ, ∃ M : ℝ, ∀ z : ℝ³ × ℝ, ‖iteratedFDeriv ℝ m (↿f) z‖ ≤ M := by
    intro m
    have hcs : HasCompactSupport (↿f) := by
      apply HasCompactSupport.intro
        ((isCompact_closedBall (0 : ℝ³) (1/4)).prod (isCompact_Icc (a := (0 : ℝ)) (b := S)))
      intro z hz
      show f z.1 z.2 = 0
      by_contra hne
      apply hz
      rw [Set.mem_prod, Set.mem_Icc, Metric.mem_closedBall, dist_zero_right]
      refine ⟨?_, ?_, ?_⟩
      · by_contra hc
        exact hne (hfvan _ _ (Or.inl (not_le.mp hc).le))
      · by_contra hc
        exact hne (hfvan _ _ (Or.inr (not_le.mp hc).le))
      · by_contra hc
        exact hne (hfS _ _ (not_le.mp hc).le)
    exact (hcs.iteratedFDeriv m).exists_bound_of_continuous
      (ContDiff.continuous_iteratedFDeriv (m := m) (by exact_mod_cast le_top) hf)

  have gU : ∀ x₀ t₀, t₀ < T → (fun z : ℝ³ × ℝ => u (z.1 - σ z.1) z.2) =ᶠ[nhds (x₀, t₀)]
      (fun z : ℝ³ × ℝ => u (z.1 - σ x₀) z.2) := fun x₀ t₀ ht =>
    hloc u (Iio T) isOpen_Iio (fun x t ht hx => (hvan x t ht hx).1) x₀ t₀ ht
  have gP : ∀ x₀ t₀, t₀ < T → (fun z : ℝ³ × ℝ => p (z.1 - σ z.1) z.2) =ᶠ[nhds (x₀, t₀)]
      (fun z : ℝ³ × ℝ => p (z.1 - σ x₀) z.2) := fun x₀ t₀ ht =>
    hloc p (Iio T) isOpen_Iio (fun x t ht hx => (hvan x t ht hx).2) x₀ t₀ ht
  have gF : ∀ x₀ t₀, (fun z : ℝ³ × ℝ => f (z.1 - σ z.1) z.2) =ᶠ[nhds (x₀, t₀)]
      (fun z : ℝ³ × ℝ => f (z.1 - σ x₀) z.2) := fun x₀ t₀ =>
    hloc f univ isOpen_univ (fun x t _ hx => hfvan x t (Or.inl hx)) x₀ t₀ (mem_univ _)
  refine ⟨fun x t => u (x - σ x) t, fun x t => p (x - σ x) t, fun x t => f (x - σ x) t, S,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro z hz
    rw [Set.mem_prod] at hz
    exact (hcd (↿u) (↿(fun x t => u (x - σ x) t)) (Iio T) (σ z.1) z isOpen_Iio hz.2 hu
      (gU z.1 z.2 hz.2)).contDiffWithinAt
  · intro z hz
    rw [Set.mem_prod] at hz
    exact (hcd (↿p) (↿(fun x t => p (x - σ x) t)) (Iio T) (σ z.1) z isOpen_Iio hz.2 hp
      (gP z.1 z.2 hz.2)).contDiffWithinAt
  · exact contDiff_iff_contDiffAt.2 (fun z =>
      hcd (↿f) (↿(fun x t => f (x - σ x) t)) univ (σ z.1) z isOpen_univ (mem_univ _)
        hf.contDiffOn (gF z.1 z.2))
  · intro t _ x i
    show u (x + EuclideanSpace.single i 1 - σ (x + EuclideanSpace.single i 1)) t = u (x - σ x) t
    rw [hper]
  · intro t _ x i
    show p (x + EuclideanSpace.single i 1 - σ (x + EuclideanSpace.single i 1)) t = p (x - σ x) t
    rw [hper]
  · intro t x i
    show f (x + EuclideanSpace.single i 1 - σ (x + EuclideanSpace.single i 1)) t = f (x - σ x) t
    rw [hper]
  · intro x
    exact hinit _
  · intro x t ht
    rw [(htr (fun x t => u (x - σ x) t) (fun x t => p (x - σ x) t) (σ x) x t
      (gU x t ht) (gP x t ht)).1]
    exact hres _ _ ht
  · intro x t ht
    rw [(htr (fun x t => u (x - σ x) t) (fun x t => p (x - σ x) t) (σ x) x t
      (gU x t ht) (gP x t ht)).2]
    exact hdiv _ _ ht
  · intro x t ht
    exact hfS _ _ ht
  · intro m
    obtain ⟨M, hM⟩ := hbd m
    refine ⟨M, fun x t _ => ?_⟩
    rw [hit (↿f) (↿(fun x t => f (x - σ x) t)) (σ x) (x, t) m (gF x t)]
    exact hM _
  · intro M
    obtain ⟨x, t, ht0, htT, hgt⟩ := hunb (max M 0)
    have hx : ‖x‖ < 1/4 := by
      by_contra hc
      push_neg at hc
      rw [(hvan x t htT hc).1, norm_zero] at hgt
      linarith [le_max_right M 0]
    have hs : σ x = 0 := hsmall x (by linarith)
    refine ⟨x, t, ht0, htT, hx.le, ?_⟩
    show M < ‖u (x - σ x) t‖
    rw [hs, sub_zero]
    linarith [le_max_left M 0]

theorem rn_difference_equations : ∀ (ν T R : ℝ) (u v : ℝ³ → ℝ → ℝ³) (p P : ℝ³ → ℝ → ℝ) (f : ℝ³ → ℝ → ℝ³), 0 < T → ContDiffOn ℝ ∞ (↿u) (univ ×ˢ Iio T) → ContDiffOn ℝ ∞ (↿p) (univ ×ˢ Iio T) → (∀ x t, 0 ≤ t → t < T → nsResidual ν u p x t = f x t) → (∀ x t, 0 ≤ t → t < T → divergence (fun y => u y t) x = 0) → ContDiffOn ℝ ∞ (↿v) (univ ×ˢ Ici 0) → ContDiffOn ℝ ∞ (↿P) (univ ×ˢ Ici 0) → (∀ x, ∀ t ≥ 0, derivWithin (v x ·) (Ici 0) t + fderiv ℝ (v · t) x (v x t) = ν • Δ (v · t) x - gradient (P · t) x + f x t) → (∀ x, ∀ t ≥ 0, divergence (v · t) x = 0) → ∀ x t, 0 ≤ t → t < T → (derivWithin (fun s => v x s - u x s) (Ici 0) t + fderiv ℝ (fun y => v y t - u y t) x (v x t) + fderiv ℝ (fun y => u y t) x (v x t - u x t) = ν • Δ (fun y => v y t - u y t) x - gradient (fun y => P y t - p y t) x) ∧ (0 < t → ∀ i : Fin 3, deriv (fun s => v x s i - u x s i) t + ∑ j, pd j (fun y => v y t i * v y t j - u y t i * u y t j) x = ν * (Δ (fun y => v y t - u y t) x) i - pd i (fun y => P y t - p y t) x) ∧ divergence (fun y => v y t - u y t) x = 0 :=
by
  intro ν T R u v p P f hT hu hp hres hdivu hv hP hNS hdivv x t ht0 htT

  have comp_fderiv : ∀ (V : ℝ³ → ℝ³) (y h : ℝ³) (i : Fin 3), DifferentiableAt ℝ V y →
      fderiv ℝ (fun z => V z i) y h = fderiv ℝ V y h i := by
    intro V y h i hV
    have hh := ((EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).hasFDerivAt.comp y hV.hasFDerivAt).fderiv
    have e : (fun z => V z i) = (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ) ∘ V := rfl
    rw [e, hh]
    rfl
  have grad_comp : ∀ (F : ℝ³ → ℝ) (y : ℝ³) (i : Fin 3), gradient F y i = pd i F y := by
    intro F y i
    have hh := EuclideanSpace.inner_single_right i (1:ℝ) (gradient F y)
    simp only [map_one, one_mul, RCLike.conj_to_real] at hh
    rw [← hh, gradient, InnerProductSpace.toDual_symm_apply]
    rfl
  have dfa : ∀ (V : ℝ³ → ℝ³) (y : ℝ³), DifferentiableAt ℝ V y → divergence V y = 0 →
      ∀ i : Fin 3, ∑ j, pd j (fun z => V z i * V z j) y = fderiv ℝ V y (V y) i := by
    intro V y hV hdiv i
    have hc : ∀ k, DifferentiableAt ℝ (fun z => V z k) y := fun k =>
      (EuclideanSpace.proj k : ℝ³ →L[ℝ] ℝ).differentiableAt.comp y hV
    have hpd : ∀ j, pd j (fun z => V z i * V z j) y
        = V y i * fderiv ℝ V y (EuclideanSpace.single j 1) j
          + V y j * fderiv ℝ V y (EuclideanSpace.single j 1) i := by
      intro j
      unfold pd
      rw [fderiv_fun_mul (hc i) (hc j)]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      rw [comp_fderiv V y _ i hV, comp_fderiv V y _ j hV]
    have htr : ∑ j, fderiv ℝ V y (EuclideanSpace.single j 1) j = 0 := by
      rw [← hdiv]
      unfold divergence
      rw [LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin 3) ℝ)]
      simp [EuclideanSpace.basisFun_apply, EuclideanSpace.inner_single_left]
    have hexp : V y = ∑ j, V y j • EuclideanSpace.single j (1:ℝ) := by
      ext k
      fin_cases k <;> simp [Fin.sum_univ_three, Pi.single_apply]
    have happ : fderiv ℝ V y (V y) i
        = ∑ j, V y j * fderiv ℝ V y (EuclideanSpace.single j 1) i := by
      have h2 : fderiv ℝ V y (∑ j, V y j • EuclideanSpace.single j (1:ℝ)) i
          = ∑ j, V y j * fderiv ℝ V y (EuclideanSpace.single j 1) i := by
        simp [map_sum, map_smul]
      rw [← hexp] at h2
      exact h2
    rw [Finset.sum_congr rfl (fun j _ => hpd j), Finset.sum_add_distrib, ← Finset.mul_sum, htr,
      happ]
    ring

  have slice : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (g : ℝ³ → ℝ → F)
      (S : Set ℝ), ContDiffOn ℝ ∞ (↿g) (univ ×ˢ S) → t ∈ S → ContDiff ℝ ∞ (fun y => g y t) := by
    intro F _ _ g S hg hs'
    have h : ContDiffOn ℝ ∞ ((↿g) ∘ (fun y : ℝ³ => (y, t))) univ :=
      hg.comp (contDiff_id.prodMk contDiff_const).contDiffOn (fun y _ => ⟨mem_univ _, hs'⟩)
    exact contDiffOn_univ.mp h
  have ht0' : t ∈ Ici (0:ℝ) := ht0
  have hV : ContDiff ℝ ∞ (fun y => v y t) := slice v (Ici 0) hv ht0'
  have hU : ContDiff ℝ ∞ (fun y => u y t) := slice u (Iio T) hu htT
  have hPs : ContDiff ℝ ∞ (fun y => P y t) := slice P (Ici 0) hP ht0'
  have hps : ContDiff ℝ ∞ (fun y => p y t) := slice p (Iio T) hp htT
  have hVd : DifferentiableAt ℝ (fun y => v y t) x := hV.differentiable (by simp) x
  have hUd : DifferentiableAt ℝ (fun y => u y t) x := hU.differentiable (by simp) x
  have hN2 : (univ : Set ℝ³) ×ˢ Iio T ∈ nhds (x, t) :=
    prod_mem_nhds Filter.univ_mem (Iio_mem_nhds htT)
  have hγ : DifferentiableAt ℝ (fun r : ℝ => (x, r)) t :=
    (differentiableAt_const x).prodMk differentiableAt_id
  have hud : DifferentiableAt ℝ (fun r => u x r) t :=
    ((hu.contDiffAt hN2).differentiableAt (by simp)).comp t hγ
  have hvdw : DifferentiableWithinAt ℝ (fun r => v x r) (Ici 0) t := by
    have h1 : DifferentiableWithinAt ℝ (↿v) (univ ×ˢ Ici 0) (x, t) :=
      hv.differentiableOn (by simp) (x, t) ⟨mem_univ _, ht0⟩
    exact h1.comp t hγ.differentiableWithinAt (fun r hr => ⟨mem_univ _, hr⟩)
  have e2 : derivWithin (fun s => v x s - u x s) (Ici 0) t
      = derivWithin (fun s => v x s) (Ici 0) t - deriv (fun s => u x s) t := by
    rw [derivWithin_fun_sub hvdw hud.differentiableWithinAt,
      hud.derivWithin (uniqueDiffOn_Ici (0:ℝ) t ht0)]
  have e3 : fderiv ℝ (fun y => v y t - u y t) x
      = fderiv ℝ (fun y => v y t) x - fderiv ℝ (fun y => u y t) x := fderiv_fun_sub hVd hUd
  have e4 : Δ (fun y => v y t - u y t) x = Δ (fun y => v y t) x - Δ (fun y => u y t) x :=
    ContDiffAt.laplacian_sub (hV.contDiffAt.of_le (by simp)) (hU.contDiffAt.of_le (by simp))
  have e5 : gradient (fun y => P y t - p y t) x
      = gradient (fun y => P y t) x - gradient (fun y => p y t) x := by
    simp only [gradient]
    rw [fderiv_fun_sub (hPs.differentiable (by simp) x) (hps.differentiable (by simp) x), map_sub]
  have h1 := hNS x t ht0
  have h2 := hres x t ht0 htT
  unfold nsResidual at h2
  have ha : derivWithin (fun r => v x r) (Ici 0) t
      = ν • Δ (fun y => v y t) x - gradient (fun y => P y t) x + f x t
        - fderiv ℝ (fun y => v y t) x (v x t) := eq_sub_of_add_eq h1
  have hb : deriv (fun r => u x r) t
      = f x t - fderiv ℝ (fun y => u y t) x (u x t) + ν • Δ (fun y => u y t) x
        - gradient (fun y => p y t) x := by
    rw [← h2]; abel
  have C1 : derivWithin (fun s => v x s - u x s) (Ici 0) t
      + fderiv ℝ (fun y => v y t - u y t) x (v x t)
      + fderiv ℝ (fun y => u y t) x (v x t - u x t)
      = ν • Δ (fun y => v y t - u y t) x - gradient (fun y => P y t - p y t) x := by
    rw [e2, e3, e4, e5, ContinuousLinearMap.sub_apply, map_sub, smul_sub, ha, hb]
    abel
  have C3 : divergence (fun y => v y t - u y t) x = 0 := by
    have hv0 := hdivv x t ht0
    have hu0 := hdivu x t ht0 htT
    unfold divergence at hv0 hu0 ⊢
    rw [e3, ContinuousLinearMap.coe_sub, map_sub, hv0, hu0, sub_zero]
  refine ⟨C1, ?_, C3⟩
  intro htpos i
  have hN1 : (univ : Set ℝ³) ×ˢ Ici (0:ℝ) ∈ nhds (x, t) :=
    prod_mem_nhds Filter.univ_mem (Ici_mem_nhds htpos)
  have hvd : DifferentiableAt ℝ (fun r => v x r) t :=
    ((hv.contDiffAt hN1).differentiableAt (by simp)).comp t hγ
  have hwd : DifferentiableAt ℝ (fun s => v x s - u x s) t := hvd.sub hud
  have Et : deriv (fun s => v x s i - u x s i) t
      = derivWithin (fun s => v x s - u x s) (Ici 0) t i := by
    rw [derivWithin_of_mem_nhds (Ici_mem_nhds htpos)]
    exact ((EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).hasFDerivAt.comp_hasDerivAt t hwd.hasDerivAt).deriv
  have Eg : gradient (fun y => P y t - p y t) x i = pd i (fun y => P y t - p y t) x :=
    grad_comp _ _ _
  have hprod : ∀ (W : ℝ³ → ℝ³), DifferentiableAt ℝ W x → ∀ j : Fin 3,
      DifferentiableAt ℝ (fun y => W y i * W y j) x := by
    intro W hW j
    exact ((EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).differentiableAt.comp x hW).mul
      ((EuclideanSpace.proj j : ℝ³ →L[ℝ] ℝ).differentiableAt.comp x hW)
  have hfv := dfa (fun y => v y t) x hVd (hdivv x t ht0) i
  have hfu := dfa (fun y => u y t) x hUd (hdivu x t ht0 htT) i
  simp only at hfv hfu
  have Eflux : ∑ j, pd j (fun y => v y t i * v y t j - u y t i * u y t j) x
      = fderiv ℝ (fun y => v y t) x (v x t) i - fderiv ℝ (fun y => u y t) x (u x t) i := by
    have hs : ∀ j, pd j (fun y => v y t i * v y t j - u y t i * u y t j) x
        = pd j (fun y => v y t i * v y t j) x - pd j (fun y => u y t i * u y t j) x := by
      intro j
      unfold pd
      rw [fderiv_fun_sub (hprod _ hVd j) (hprod _ hUd j)]
      rfl
    rw [Finset.sum_congr rfl (fun j _ => hs j), Finset.sum_sub_distrib, hfv, hfu]
  have hC1i := congrArg (fun z : ℝ³ => z i) C1
  simp only [PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, e3,
    ContinuousLinearMap.sub_apply, map_sub] at hC1i
  rw [Et, Eflux, ← Eg]
  linarith

theorem rn_uniform_bounds : ∀ (T₁ T R E : ℝ) (u v : ℝ³ → ℝ → ℝ³), 0 < T₁ → T₁ < T → ContDiffOn ℝ ∞ (↿u) (univ ×ˢ Iio T) → (∀ x t, t < T → R ≤ ‖x‖ → u x t = 0) → ContDiffOn ℝ ∞ (↿v) (univ ×ˢ Ici 0) → (∀ t ≥ 0, MemLp (fun x => ‖v x t‖) 2) → (∀ t ≥ 0, (∫ x, ‖v x t‖ ^ 2) < E) → ∃ M L C₀ C₁ : ℝ, (∀ x t, t ∈ Icc 0 T₁ → ‖u x t‖ ≤ M) ∧ (∀ x t, t ∈ Icc 0 T₁ → ‖fderiv ℝ (fun y => u y t) x‖ ≤ L) ∧ (∀ t ∈ Icc 0 T₁, MemLp (fun x => v x t - u x t) 2 ∧ (∫ x, ‖v x t - u x t‖ ^ 2) ≤ C₀) ∧ (∀ t ∈ Icc 0 T₁, ∀ i j : Fin 3, Integrable (fun x => v x t i * v x t j - u x t i * u x t j) ∧ (∫ x, |v x t i * v x t j - u x t i * u x t j|) ≤ C₁) :=
by
  intro T₁ T R E u v hT₁ hT₁T hu hvan hv hL2 hE
  have hO : IsOpen ((univ : Set ℝ³) ×ˢ Iio T) := isOpen_univ.prod isOpen_Iio
  have hK : IsCompact (Metric.closedBall (0 : ℝ³) R ×ˢ Icc (0 : ℝ) T₁) :=
    (isCompact_closedBall 0 R).prod isCompact_Icc
  have hKO : Metric.closedBall (0 : ℝ³) R ×ˢ Icc (0 : ℝ) T₁ ⊆ (univ : Set ℝ³) ×ˢ Iio T :=
    fun z hz => ⟨mem_univ _, lt_of_le_of_lt hz.2.2 hT₁T⟩
  obtain ⟨M₀, hM₀⟩ := hK.exists_bound_of_continuousOn (hu.continuousOn.mono hKO)
  have hfc : ContinuousOn (fderiv ℝ (↿u)) ((univ : Set ℝ³) ×ˢ Iio T) :=
    hu.continuousOn_fderiv_of_isOpen hO (by exact_mod_cast le_top)
  obtain ⟨L₀, hL₀⟩ := hK.exists_bound_of_continuousOn (hfc.mono hKO)
  have hIT : ∀ t, t ∈ Icc 0 T₁ → t < T := fun t ht => lt_of_le_of_lt ht.2 hT₁T
  have hmemK : ∀ x t, t ∈ Icc 0 T₁ → ‖x‖ ≤ R →
      (x, t) ∈ Metric.closedBall (0 : ℝ³) R ×ˢ Icc (0 : ℝ) T₁ := by
    intro x t ht hx
    refine ⟨?_, ht⟩
    rw [Metric.mem_closedBall, dist_zero_right]
    exact hx
  have hM0 : 0 ≤ max M₀ 0 := le_max_right _ _
  have hM : ∀ x t, t ∈ Icc 0 T₁ → ‖u x t‖ ≤ max M₀ 0 := by
    intro x t ht
    by_cases hx : ‖x‖ ≤ R
    · exact le_trans (hM₀ (x, t) (hmemK x t ht hx)) (le_max_left _ _)
    · rw [hvan x t (hIT t ht) (le_of_lt (not_le.mp hx)), norm_zero]
      exact hM0
  have hL : ∀ x t, t ∈ Icc 0 T₁ → ‖fderiv ℝ (fun y => u y t) x‖ ≤ max L₀ 0 := by
    intro x t ht
    by_cases hx : ‖x‖ ≤ R
    · have hmem := hmemK x t ht hx
      have hxO := hKO hmem
      have hdiff : DifferentiableAt ℝ (↿u) (x, t) :=
        (hu.differentiableOn (by simp)).differentiableAt (hO.mem_nhds hxO)
      have hcomp : HasFDerivAt (fun y => u y t)
          ((fderiv ℝ (↿u) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ)) x := by
        have h2 : HasFDerivAt (fun e : ℝ³ => (e, t)) (ContinuousLinearMap.inl ℝ ℝ³ ℝ) x :=
          hasFDerivAt_prodMk_left x t
        have h1 : HasFDerivAt (↿u) (fderiv ℝ (↿u) (x, t)) ((fun e : ℝ³ => (e, t)) x) :=
          hdiff.hasFDerivAt
        exact h1.comp x h2
      rw [hcomp.fderiv]
      calc ‖(fderiv ℝ (↿u) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ)‖
          ≤ ‖fderiv ℝ (↿u) (x, t)‖ * ‖ContinuousLinearMap.inl ℝ ℝ³ ℝ‖ :=
            ContinuousLinearMap.opNorm_comp_le _ _
        _ ≤ ‖fderiv ℝ (↿u) (x, t)‖ * 1 :=
            mul_le_mul_of_nonneg_left (ContinuousLinearMap.norm_inl_le_one ℝ ℝ³ ℝ) (norm_nonneg _)
        _ ≤ max L₀ 0 := by
            rw [mul_one]
            exact le_trans (hL₀ (x, t) hmem) (le_max_left _ _)
    · have hU : IsOpen {y : ℝ³ | R < ‖y‖} := isOpen_lt continuous_const continuous_norm
      have hxU : x ∈ {y : ℝ³ | R < ‖y‖} := not_le.mp hx
      have heq : (fun y => u y t) =ᶠ[nhds x] (fun _ => (0 : ℝ³)) :=
        Filter.eventuallyEq_of_mem (hU.mem_nhds hxU)
          (fun y hy => hvan y t (hIT t ht) (le_of_lt hy))
      rw [heq.fderiv_eq, fderiv_const_apply, norm_zero]
      exact le_max_right _ _

  set M := max M₀ 0 with hMdef
  set V := (volume : Measure ℝ³).real (Metric.closedBall (0 : ℝ³) R) with hVdef
  set ι : ℝ³ → ℝ := (Metric.closedBall (0 : ℝ³) R).indicator (fun _ => M ^ 2) with hιdef
  have hι : Integrable ι := by
    rw [hιdef, integrable_indicator_iff measurableSet_closedBall]
    exact integrableOn_const measure_closedBall_lt_top.ne
  have hιint : ∫ x, ι x = V * M ^ 2 := by
    rw [hιdef, integral_indicator_const _ measurableSet_closedBall, smul_eq_mul]
  have hvc : ∀ t, 0 ≤ t → Continuous (fun x => v x t) := fun t ht =>
    hv.continuousOn.comp_continuous
      (continuous_id.prodMk continuous_const : Continuous fun y : ℝ³ => (y, t))
      (fun y => ⟨mem_univ _, ht⟩)
  have huc : ∀ t, t < T → Continuous (fun x => u x t) := fun t ht =>
    hu.continuousOn.comp_continuous
      (continuous_id.prodMk continuous_const : Continuous fun y : ℝ³ => (y, t))
      (fun y => ⟨mem_univ _, ht⟩)
  have hbι : ∀ x t, t ∈ Icc 0 T₁ → ‖u x t‖ ^ 2 ≤ ι x := by
    intro x t ht
    by_cases hx : x ∈ Metric.closedBall (0 : ℝ³) R
    · rw [hιdef, Set.indicator_of_mem hx]
      exact pow_le_pow_left₀ (norm_nonneg _) (hM x t ht) 2
    · rw [hιdef, Set.indicator_of_notMem hx]
      rw [Metric.mem_closedBall, dist_zero_right, not_le] at hx
      rw [hvan x t (hIT t ht) hx.le, norm_zero]
      norm_num
  have hco : ∀ (c : ℝ³) (i j : Fin 3), |c i * c j| ≤ ‖c‖ ^ 2 := by
    intro c i j
    have hi : |c i| ≤ ‖c‖ := by
      have := PiLp.norm_apply_le c i
      rwa [Real.norm_eq_abs] at this
    have hj : |c j| ≤ ‖c‖ := by
      have := PiLp.norm_apply_le c j
      rwa [Real.norm_eq_abs] at this
    rw [abs_mul, sq]
    exact mul_le_mul hi hj (abs_nonneg _) (norm_nonneg _)
  refine ⟨M, max L₀ 0, 2 * E + 2 * M ^ 2 * V, E + M ^ 2 * V, hM, hL, ?_, ?_⟩
  · intro t ht
    have ha : MemLp (fun x => v x t) 2 :=
      (memLp_norm_iff (hvc t ht.1).aestronglyMeasurable).mp (hL2 t ht.1)
    have hb : MemLp (fun x => u x t) 2 :=
      (huc t (hIT t ht)).memLp_of_hasCompactSupport
        (HasCompactSupport.intro (isCompact_closedBall 0 R) (fun x hx => by
          rw [Metric.mem_closedBall, dist_zero_right, not_le] at hx
          exact hvan x t (hIT t ht) hx.le))
    have hab : MemLp (fun x => v x t - u x t) 2 := ha.sub hb
    refine ⟨hab, ?_⟩
    have int1 : Integrable (fun x => ‖v x t - u x t‖ ^ 2) := hab.norm.integrable_sq
    have inta : Integrable (fun x => ‖v x t‖ ^ 2) := (hL2 t ht.1).integrable_sq
    have int2 : Integrable (fun x => 2 * ‖v x t‖ ^ 2 + 2 * ι x) :=
      (inta.const_mul 2).add (hι.const_mul 2)
    have pw : ∀ x, ‖v x t - u x t‖ ^ 2 ≤ 2 * ‖v x t‖ ^ 2 + 2 * ι x := by
      intro x
      have h1 := pow_le_pow_left₀ (norm_nonneg _) (norm_sub_le (v x t) (u x t)) 2
      have h2 := hbι x t ht
      nlinarith [sq_nonneg (‖v x t‖ - ‖u x t‖)]
    have hmono := integral_mono int1 int2 pw
    rw [integral_add (inta.const_mul 2) (hι.const_mul 2), integral_const_mul,
      integral_const_mul, hιint] at hmono
    have hE' := hE t ht.1
    nlinarith
  · intro t ht i j
    have hvc' := hvc t ht.1
    have huc' := huc t (hIT t ht)
    have hg : Continuous (fun x => v x t i * v x t j - u x t i * u x t j) := by fun_prop
    have inta : Integrable (fun x => ‖v x t‖ ^ 2) := (hL2 t ht.1).integrable_sq
    have int3 : Integrable (fun x => ‖v x t‖ ^ 2 + ι x) := inta.add hι
    have pw : ∀ x, |v x t i * v x t j - u x t i * u x t j| ≤ ‖v x t‖ ^ 2 + ι x := by
      intro x
      have h1 := abs_sub (v x t i * v x t j) (u x t i * u x t j)
      have h2 := hco (v x t) i j
      have h3 := hco (u x t) i j
      have h4 := hbι x t ht
      linarith
    have hint : Integrable (fun x => v x t i * v x t j - u x t i * u x t j) :=
      Integrable.mono' int3 hg.aestronglyMeasurable
        (ae_of_all _ (fun x => by rw [Real.norm_eq_abs]; exact pw x))
    refine ⟨hint, ?_⟩
    have hmono := integral_mono hint.abs int3 pw
    rw [integral_add inta hι, hιint] at hmono
    have hE' := hE t ht.1
    nlinarith

theorem laplacian_pd_comm : ∀ (F : ℝ³ → ℝ), ContDiff ℝ ∞ F → ∀ (i : Fin 3) (x : ℝ³), Δ (pd i F) x = pd i (Δ F) x :=
by
  have A1 : ∀ (j : Fin 3) (f : ℝ³ → ℝ), ContDiff ℝ ∞ f → ContDiff ℝ ∞ (pd j f) := by
    intro j f hf
    show ContDiff ℝ ∞ (fun y => fderiv ℝ f y (EuclideanSpace.single j 1))
    exact (contDiff_infty_iff_fderiv.mp hf).2.clm_apply contDiff_const
  have A2 : ∀ (G : ℝ³ → ℝ), ContDiff ℝ ∞ G → ∀ (a b : Fin 3) (y : ℝ³),
      pd a (pd b G) y = fderiv ℝ (fderiv ℝ G) y (EuclideanSpace.single a 1)
        (EuclideanSpace.single b 1) := by
    intro G hG a b y
    have hd : DifferentiableAt ℝ (fderiv ℝ G) y :=
      ((contDiff_infty_iff_fderiv.mp hG).2.differentiable (by simp)) y
    show fderiv ℝ (fun z => fderiv ℝ G z (EuclideanSpace.single b 1)) y
      (EuclideanSpace.single a 1) = _
    rw [fderiv_clm_apply hd (differentiableAt_const _)]
    simp
  have S1 : ∀ (H : ℝ³ → ℝ), ContDiff ℝ ∞ H → ∀ (a b : Fin 3) (y : ℝ³),
      pd a (pd b H) y = pd b (pd a H) y := by
    intro H hH a b y
    rw [A2 H hH, A2 H hH]
    have hs : IsSymmSndFDerivAt ℝ H y :=
      hH.contDiffAt.isSymmSndFDerivAt (by simp [minSmoothness_of_isRCLikeNormedField])
    exact hs _ _
  have S2 : ∀ (G : ℝ³ → ℝ), ContDiff ℝ ∞ G → ∀ y, Δ G y = ∑ k : Fin 3, pd k (pd k G) y := by
    intro G hG y
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis G
      (EuclideanSpace.basisFun (Fin 3) ℝ)]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [A2 G hG, iteratedFDeriv_two_apply]
    simp
  intro F hF i x
  have hpk : ∀ k, ContDiff ℝ ∞ (pd k (pd k F)) := fun k => A1 k _ (A1 k F hF)
  have hΔF : Δ F = fun y => ∑ k : Fin 3, pd k (pd k F) y := funext (S2 F hF)
  have hswap : ∀ k, pd k (pd i F) = pd i (pd k F) := fun k => funext (S1 F hF k i)
  rw [S2 _ (A1 i F hF) x, hΔF]
  have hsum : pd i (fun y => ∑ k : Fin 3, pd k (pd k F) y) x
      = ∑ k : Fin 3, pd i (pd k (pd k F)) x := by
    show fderiv ℝ (fun y => ∑ k : Fin 3, pd k (pd k F) y) x (EuclideanSpace.single i 1) = _
    rw [fderiv_fun_sum (fun k _ => ((hpk k).differentiable (by simp)) x),
      ContinuousLinearMap.sum_apply]
    rfl
  rw [hsum]
  refine Finset.sum_congr rfl (fun k _ => ?_)
  rw [hswap k]
  exact S1 (pd k F) (A1 k F hF) k i x

theorem conv_bounded_deriv_kernel : ∀ (A B : ℝ³ → ℝ), Integrable A → ContDiff ℝ ∞ B → (∀ n : ℕ, ∃ C : ℝ, ∀ z, ‖iteratedFDeriv ℝ n B z‖ ≤ C) → (∀ x, Integrable (fun t => A t * B (x - t))) ∧ ContDiff ℝ ∞ (fun x => ∫ t, A t * B (x - t)) ∧ ∀ x, Δ (fun x => ∫ t, A t * B (x - t)) x = ∫ t, A t * Δ B (x - t) :=
by
  intro A B hA hB hb
  have hInt : ∀ (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] (B : ℝ³ → F) (C₀ : ℝ),
      Continuous B → (∀ z, ‖B z‖ ≤ C₀) → ∀ x, Integrable (fun t => A t • B (x - t)) := by
    intro F _ _ B C₀ hBc hBb x
    refine Integrable.mono' (hA.norm.mul_const C₀) ?_ (ae_of_all _ (fun t => ?_))
    · exact hA.aestronglyMeasurable.smul
        ((hBc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable)
    · rw [norm_smul]
      exact mul_le_mul_of_nonneg_left (hBb _) (norm_nonneg _)
  have hDer : ∀ (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] (B : ℝ³ → F) (C₀ C₁ : ℝ),
      ContDiff ℝ 1 B → (∀ z, ‖B z‖ ≤ C₀) → (∀ z, ‖fderiv ℝ B z‖ ≤ C₁) →
      ∀ x, HasFDerivAt (fun y => ∫ t, A t • B (y - t)) (∫ t, A t • fderiv ℝ B (x - t)) x := by
    intro F _ _ B C₀ C₁ hB1 hB0 hBd x
    have hBc : Continuous B := hB1.continuous
    have hdc : Continuous (fderiv ℝ B) := hB1.continuous_fderiv one_ne_zero
    have hBdiff : Differentiable ℝ B := hB1.differentiable one_ne_zero
    refine hasFDerivAt_integral_of_dominated_of_fderiv_le (s := univ)
      (F := fun y t => A t • B (y - t)) (F' := fun y t => A t • fderiv ℝ B (y - t)) (x₀ := x)
      (bound := fun t => ‖A t‖ * C₁) Filter.univ_mem ?_ (hInt F B C₀ hBc hB0 x) ?_ ?_
      (hA.norm.mul_const C₁) ?_
    · exact Filter.Eventually.of_forall (fun y => hA.aestronglyMeasurable.smul
        ((hBc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable))
    · exact hA.aestronglyMeasurable.smul
        ((hdc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable)
    · refine ae_of_all _ (fun t y _ => ?_)
      rw [norm_smul]
      exact mul_le_mul_of_nonneg_left (hBd _) (norm_nonneg _)
    · refine ae_of_all _ (fun t y _ => ?_)
      have h1 : HasFDerivAt (fun y => B (y - t)) (fderiv ℝ B (y - t)) y := by
        have := (hBdiff (y - t)).hasFDerivAt.comp y (hasFDerivAt_sub_const t)
        rw [ContinuousLinearMap.comp_id] at this
        exact this
      exact h1.const_smul (A t)
  have hDer' : ∀ (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] (B : ℝ³ → F),
      ContDiff ℝ ∞ B → (∀ m : ℕ, ∃ C : ℝ, ∀ z, ‖iteratedFDeriv ℝ m B z‖ ≤ C) →
      ∀ x, HasFDerivAt (fun y => ∫ t, A t • B (y - t)) (∫ t, A t • fderiv ℝ B (x - t)) x := by
    intro F _ _ B hB hb x
    obtain ⟨C₀, hC₀⟩ := hb 0
    obtain ⟨C₁, hC₁⟩ := hb 1
    have h1 : ContDiff ℝ 1 B := hB.of_le (by exact_mod_cast le_top)
    exact hDer F B C₀ C₁ h1 (fun z => by have := hC₀ z; rwa [norm_iteratedFDeriv_zero] at this)
      (fun z => by have := hC₁ z; rwa [norm_iteratedFDeriv_one] at this) x
  have hcl : ∀ (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] (B : ℝ³ → F),
      ContDiff ℝ ∞ B → (∀ m : ℕ, ∃ C : ℝ, ∀ z, ‖iteratedFDeriv ℝ m B z‖ ≤ C) →
      ContDiff ℝ ∞ (fderiv ℝ B) ∧
        (∀ m : ℕ, ∃ C : ℝ, ∀ z, ‖iteratedFDeriv ℝ m (fderiv ℝ B) z‖ ≤ C) := by
    intro F _ _ B hB hb
    refine ⟨(contDiff_infty_iff_fderiv.mp hB).2, fun m => ?_⟩
    obtain ⟨C, hC⟩ := hb (m + 1)
    exact ⟨C, fun z => by rw [norm_iteratedFDeriv_fderiv]; exact hC z⟩
  have hK : ∀ n : ℕ, ∀ (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] (B : ℝ³ → F),
      ContDiff ℝ ∞ B → (∀ m : ℕ, ∃ C : ℝ, ∀ z, ‖iteratedFDeriv ℝ m B z‖ ≤ C) →
      ContDiff ℝ n (fun x => ∫ t, A t • B (x - t)) := by
    intro n
    induction n with
    | zero =>
      intro F _ _ B hB hb
      have hdiff : Differentiable ℝ (fun x => ∫ t, A t • B (x - t)) := fun x =>
        (hDer' F B hB hb x).differentiableAt
      have h0 : ContDiff ℝ 0 (fun x => ∫ t, A t • B (x - t)) :=
        contDiff_zero.mpr hdiff.continuous
      exact_mod_cast h0
    | succ n ih =>
      intro F _ _ B hB hb
      obtain ⟨hB1s, hb1⟩ := hcl F B hB hb
      rw [Nat.cast_succ, contDiff_succ_iff_hasFDerivAt]
      exact ⟨fun x => ∫ t, A t • fderiv ℝ B (x - t), ih _ (fderiv ℝ B) hB1s hb1,
        fun x => hDer' F B hB hb x⟩
  have hu : (fun x => ∫ t, A t * B (x - t)) = fun x => ∫ t, A t • B (x - t) := by
    simp only [smul_eq_mul]
  obtain ⟨hB1s, hb1⟩ := hcl ℝ B hB hb
  obtain ⟨hB2s, hb2⟩ := hcl _ (fderiv ℝ B) hB1s hb1
  refine ⟨fun x => ?_, ?_, fun x => ?_⟩
  · obtain ⟨C₀, hC₀⟩ := hb 0
    have := hInt ℝ B C₀ hB.continuous
      (fun z => by have := hC₀ z; rwa [norm_iteratedFDeriv_zero] at this) x
    simpa only [smul_eq_mul] using this
  · rw [hu]
    exact contDiff_infty.mpr (fun n => hK n ℝ B hB hb)
  · rw [hu]
    have hD1 : fderiv ℝ (fun x => ∫ t, A t • B (x - t))
        = fun x => ∫ t, A t • fderiv ℝ B (x - t) :=
      funext (fun x => (hDer' ℝ B hB hb x).fderiv)
    have hD2 : fderiv ℝ (fderiv ℝ (fun x => ∫ t, A t • B (x - t)))
        = fun x => ∫ t, A t • fderiv ℝ (fderiv ℝ B) (x - t) := by
      rw [hD1]
      exact funext (fun x => (hDer' _ (fderiv ℝ B) hB1s hb1 x).fderiv)
    have hlap : ∀ (f : ℝ³ → ℝ) (y : ℝ³), Δ f y = ∑ i : Fin 3,
        fderiv ℝ (fderiv ℝ f) y (EuclideanSpace.single i 1) (EuclideanSpace.single i 1) := by
      intro f y
      rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis f
        (EuclideanSpace.basisFun (Fin 3) ℝ)]
      simp [iteratedFDeriv_two_apply]
    rw [hlap (fun x => ∫ t, A t • B (x - t)) x, hD2]
    obtain ⟨C₂, hC₂⟩ := hb2 0
    have hφ := hInt _ (fderiv ℝ (fderiv ℝ B)) C₂ hB2s.continuous
      (fun z => by have := hC₂ z; rwa [norm_iteratedFDeriv_zero] at this) x
    have hψ : ∀ i : Fin 3, Integrable (fun t =>
        (A t • fderiv ℝ (fderiv ℝ B) (x - t)) (EuclideanSpace.single i 1)) :=
      fun i => hφ.apply_continuousLinearMap _
    have hχ : ∀ i : Fin 3, Integrable (fun t =>
        A t * fderiv ℝ (fderiv ℝ B) (x - t) (EuclideanSpace.single i 1)
          (EuclideanSpace.single i 1)) := by
      intro i
      have := (hψ i).apply_continuousLinearMap (EuclideanSpace.single i 1)
      simpa only [ContinuousLinearMap.smul_apply, smul_eq_mul] using this
    have heval : ∀ i : Fin 3, (∫ t, A t • fderiv ℝ (fderiv ℝ B) (x - t))
        (EuclideanSpace.single i 1) (EuclideanSpace.single i 1)
        = ∫ t, A t * fderiv ℝ (fderiv ℝ B) (x - t) (EuclideanSpace.single i 1)
          (EuclideanSpace.single i 1) := by
      intro i
      rw [ContinuousLinearMap.integral_apply hφ, ContinuousLinearMap.integral_apply (hψ i)]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [Finset.sum_congr rfl (fun i _ => heval i), ← integral_finset_sum _ (fun i _ => hχ i)]
    congr 1
    funext t
    rw [hlap B (x - t), Finset.mul_sum]

theorem newton_kernel_ball_integral : ∀ r : ℝ, 0 < r → IntegrableOn newtonKernel (Metric.ball (0 : ℝ³) r) ∧ ∫ z in Metric.ball (0 : ℝ³) r, newtonKernel z = r ^ 2 / 2 :=
by
  intro r hr
  set f : ℝ → ℝ := fun s => if s < r then (4 * Real.pi * s)⁻¹ else 0 with hfdef
  have hpi : 0 < Real.pi := Real.pi_pos

  have hind : (Metric.ball (0 : ℝ³) r).indicator newtonKernel = fun z => f ‖z‖ := by
    funext z
    by_cases h : ‖z‖ < r
    · have hz : z ∈ Metric.ball (0 : ℝ³) r := mem_ball_zero_iff.mpr h
      rw [Set.indicator_of_mem hz]
      simp only [hfdef, if_pos h, newtonKernel]
    · have hz : z ∉ Metric.ball (0 : ℝ³) r := fun hz => h (mem_ball_zero_iff.mp hz)
      rw [Set.indicator_of_notMem hz]
      simp only [hfdef, if_neg h]

  set g : ℝ → ℝ := (Set.Iio r).indicator (fun y : ℝ => y / (4 * Real.pi)) with hgdef
  have hEq : Set.EqOn (fun y : ℝ => y ^ 2 * f y) g (Set.Ioi 0) := by
    intro y hy
    have hy0 : 0 < y := hy
    by_cases h : y < r
    · simp only [hfdef, if_pos h, hgdef, Set.indicator_of_mem (show y ∈ Set.Iio r from h)]
      field_simp
    · simp only [hfdef, if_neg h, hgdef, Set.indicator_of_notMem (show y ∉ Set.Iio r from h),
        mul_zero]
  have hgint : IntegrableOn g (Set.Ioi 0) := by
    rw [hgdef, integrableOn_indicator_iff measurableSet_Iio]
    have : IntegrableOn (fun y : ℝ => y / (4 * Real.pi)) (Set.Icc 0 r) :=
      (continuous_id.div_const _).integrableOn_Icc
    exact this.mono_set (fun y hy => ⟨le_of_lt hy.2, le_of_lt hy.1⟩)
  have h1int : IntegrableOn (fun y : ℝ => y ^ 2 * f y) (Set.Ioi 0) :=
    hgint.congr_fun hEq.symm measurableSet_Ioi
  have h1val : ∫ y in Set.Ioi (0:ℝ), y ^ 2 * f y = r ^ 2 / (8 * Real.pi) := by
    rw [setIntegral_congr_fun measurableSet_Ioi hEq, hgdef, setIntegral_indicator measurableSet_Iio,
      Set.Ioi_inter_Iio, ← integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le hr.le,
      intervalIntegral.integral_div, integral_id]
    field_simp
    ring

  have hfr : Module.finrank ℝ ℝ³ = 3 := finrank_euclideanSpace_fin
  have hFint : Integrable (fun z : ℝ³ => f ‖z‖) := by
    rw [integrable_fun_norm_addHaar (volume : Measure ℝ³), hfr]
    exact h1int
  have hvol : (volume : Measure ℝ³).real (Metric.ball 0 1) = 4 * Real.pi / 3 := by
    rw [measureReal_def, EuclideanSpace.volume_ball_fin_three, ENNReal.ofReal_one, one_pow,
      one_mul, ENNReal.toReal_ofReal (by positivity)]
    ring
  refine ⟨?_, ?_⟩
  · rw [← integrable_indicator_iff measurableSet_ball, hind]
    exact hFint
  · rw [← integral_indicator measurableSet_ball, hind,
      integral_fun_norm_addHaar (volume : Measure ℝ³) f, hfr, hvol]
    have h2 : ∫ y in Set.Ioi (0:ℝ), y ^ (3 - 1) • f y = r ^ 2 / (8 * Real.pi) := h1val
    rw [h2, smul_eq_mul, nsmul_eq_mul]
    push_cast
    field_simp
    ring

theorem far_kernel_basic : ContDiff ℝ ∞ (fun z : ℝ³ => Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z) ∧ (∀ z : ℝ³, 1 ≤ ‖z‖ → Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z = newtonKernel z) ∧ (∀ z : ℝ³, 0 ≤ Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z ∧ Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z ≤ newtonKernel z) ∧ ∀ n : ℕ, ∃ C : ℝ, ∀ z : ℝ³, ‖iteratedFDeriv ℝ n (fun z : ℝ³ => Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z) z‖ ≤ C :=
by
  set K : ℝ³ → ℝ := fun z : ℝ³ => Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z
    with hKdef
  have hΓnn : ∀ z : ℝ³, 0 ≤ newtonKernel z := fun z => by
    unfold newtonKernel; positivity
  have hb : ∀ z : ℝ³, 1 ≤ ‖z‖ → K z = newtonKernel z := by
    intro z hz
    show Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z = newtonKernel z
    rw [Real.smoothTransition.one_of_one_le (by nlinarith), one_mul]
  have hc : ∀ z : ℝ³, 0 ≤ K z ∧ K z ≤ newtonKernel z := fun z =>
    ⟨mul_nonneg (Real.smoothTransition.nonneg _) (hΓnn z),
     mul_le_of_le_one_left (hΓnn z) (Real.smoothTransition.le_one _)⟩
  have hq : ContDiff ℝ ∞ (fun w : ℝ³ => 2 * ‖w‖ ^ 2 - 1) :=
    (contDiff_const.mul (contDiff_norm_sq ℝ)).sub contDiff_const
  have hst : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff
  have ha : ContDiff ℝ ∞ K := by
    rw [contDiff_iff_contDiffAt]
    intro z
    rcases lt_or_ge (2 * ‖z‖ ^ 2 - 1) 0 with h | h
    · have hU : IsOpen {w : ℝ³ | 2 * ‖w‖ ^ 2 - 1 < 0} :=
        isOpen_lt hq.continuous continuous_const
      have hev : K =ᶠ[nhds z] (fun _ => (0:ℝ)) :=
        Filter.eventuallyEq_of_mem (hU.mem_nhds h) (fun w hw => by
          show Real.smoothTransition (2 * ‖w‖ ^ 2 - 1) * newtonKernel w = 0
          rw [Real.smoothTransition.zero_of_nonpos (le_of_lt hw), zero_mul])
      exact contDiffAt_const.congr_of_eventuallyEq hev
    · have hz : z ≠ 0 := by
        rintro rfl
        simp at h
        linarith
      have hnz : 0 < ‖z‖ := norm_pos_iff.mpr hz
      have h1 : ContDiffAt ℝ ∞ (fun w : ℝ³ => Real.smoothTransition (2 * ‖w‖ ^ 2 - 1)) z :=
        (hst.comp hq).contDiffAt
      have h2 : ContDiffAt ℝ ∞ (fun w : ℝ³ => 4 * Real.pi * ‖w‖) z :=
        contDiffAt_const.mul (contDiffAt_norm ℝ hz)
      have h3 : ContDiffAt ℝ ∞ (fun w : ℝ³ => (4 * Real.pi * ‖w‖)⁻¹) z :=
        h2.inv (mul_pos (by positivity) hnz).ne'
      exact h1.mul h3
  have hhom : ∀ (c : ℝ) (z : ℝ³), 1 ≤ c → 1 < ‖z‖ → K (c • z) = c⁻¹ * K z := by
    intro c z hc hz
    have hn : ‖c • z‖ = c * ‖z‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (by linarith)]
    rw [hb _ hz.le, hb _ (by rw [hn]; nlinarith)]
    unfold newtonKernel
    rw [hn, show 4 * Real.pi * (c * ‖z‖) = c * (4 * Real.pi * ‖z‖) by ring, mul_inv]
  have hd : ∀ n : ℕ, ∃ C : ℝ, ∀ z : ℝ³, ‖iteratedFDeriv ℝ n K z‖ ≤ C := by
    intro n
    have hn : (n : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
    have hcont : Continuous (iteratedFDeriv ℝ n K) := ha.continuous_iteratedFDeriv hn
    obtain ⟨C, hC⟩ :=
      (isCompact_closedBall (0:ℝ³) 2).exists_bound_of_continuousOn hcont.continuousOn
    have hscale : ∀ (c : ℝ) (z : ℝ³), 1 ≤ c → 1 < ‖z‖ →
        ‖iteratedFDeriv ℝ n K (c • z)‖ ≤ ‖iteratedFDeriv ℝ n K z‖ := by
      intro c z hc hz
      have hcpos : 0 < c := by linarith
      set L : ℝ³ →L[ℝ] ℝ³ := c • ContinuousLinearMap.id ℝ ℝ³ with hL
      have hLapp : ∀ y, L y = c • y := fun y => rfl
      have hU : IsOpen {y : ℝ³ | 1 < ‖y‖} := isOpen_lt continuous_const continuous_norm
      have hev : (K ∘ L) =ᶠ[nhds z] (fun y => c⁻¹ • K y) :=
        Filter.eventuallyEq_of_mem (hU.mem_nhds hz) (fun y hy => by
          show K (L y) = c⁻¹ • K y
          rw [hLapp, smul_eq_mul]
          exact hhom c y hc hy)
      have e1 := (hev.iteratedFDeriv ℝ n).eq_of_nhds
      rw [L.iteratedFDeriv_comp_right ha z hn,
        iteratedFDeriv_const_smul_apply' (ha.contDiffAt.of_le hn)] at e1
      have hm : ∀ m : Fin n → ℝ³, c ^ n * iteratedFDeriv ℝ n K (c • z) m
          = c⁻¹ * iteratedFDeriv ℝ n K z m := by
        intro m
        have e2 := congrArg (fun A : ContinuousMultilinearMap ℝ (fun _ : Fin n => ℝ³) ℝ => A m) e1
        simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply, hLapp,
          ContinuousMultilinearMap.smul_apply, smul_eq_mul] at e2
        rw [ContinuousMultilinearMap.map_smul_univ, Finset.prod_const, Finset.card_univ,
          Fintype.card_fin, smul_eq_mul] at e2
        exact e2
      refine ContinuousMultilinearMap.opNorm_le_bound (norm_nonneg _) (fun m => ?_)
      have hcn : 1 ≤ c ^ n := one_le_pow₀ hc
      have hci : c⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hc
      have hle := (iteratedFDeriv ℝ n K z).le_opNorm m
      have hA : 0 ≤ ‖iteratedFDeriv ℝ n K (c • z) m‖ := norm_nonneg _
      have hB : 0 ≤ ‖iteratedFDeriv ℝ n K z m‖ := norm_nonneg _
      have hnorm := congrArg (fun x : ℝ => ‖x‖) (hm m)
      simp only [norm_mul, norm_pow, norm_inv, Real.norm_eq_abs, abs_of_pos hcpos] at hnorm
      simp only [Real.norm_eq_abs] at hA hB hle ⊢
      calc |iteratedFDeriv ℝ n K (c • z) m|
          ≤ c ^ n * |iteratedFDeriv ℝ n K (c • z) m| := le_mul_of_one_le_left hA hcn
        _ = c⁻¹ * |iteratedFDeriv ℝ n K z m| := hnorm
        _ ≤ |iteratedFDeriv ℝ n K z m| := mul_le_of_le_one_left hB hci
        _ ≤ ‖iteratedFDeriv ℝ n K z‖ * ∏ i, ‖m i‖ := hle
    refine ⟨C, fun w => ?_⟩
    by_cases hw : ‖w‖ ≤ 2
    · exact hC w (mem_closedBall_zero_iff.mpr hw)
    · push_neg at hw
      set c : ℝ := 2 * ‖w‖ / 3 with hcdef
      have hc1 : 1 ≤ c := by rw [hcdef]; linarith
      have hc0 : c ≠ 0 := by linarith
      have hzn : ‖c⁻¹ • w‖ = 3 / 2 := by
        rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos (by linarith), hcdef]
        field_simp
      have hwz : c • (c⁻¹ • w) = w := smul_inv_smul₀ hc0 w
      calc ‖iteratedFDeriv ℝ n K w‖ = ‖iteratedFDeriv ℝ n K (c • (c⁻¹ • w))‖ := by rw [hwz]
        _ ≤ ‖iteratedFDeriv ℝ n K (c⁻¹ • w)‖ := hscale c _ hc1 (by rw [hzn]; norm_num)
        _ ≤ C := hC _ (mem_closedBall_zero_iff.mpr (by rw [hzn]; norm_num))
  exact ⟨ha, hb, hc, hd⟩

theorem laplacian_ibp_shift : ∀ (F h : ℝ³ → ℝ) (x : ℝ³) (R : ℝ), ContDiff ℝ ∞ F → ContDiff ℝ ∞ h → (∀ z : ℝ³, R ≤ ‖z‖ → F z = 0) → ∫ y, F (x - y) * Δ h y = ∫ y, Δ F (x - y) * h y :=
by
  intro F h x R hF hh hvan

  have hrefl : ∀ y : ℝ³, Δ (fun z => F (x - z)) y = Δ F (x - y) := by
    intro y
    have hGs : ContDiff ℝ ∞ (fun w : ℝ³ => F (x + w)) := hF.comp (contDiff_const.add contDiff_id)
    have hcomp : (fun z => F (x - z))
        = (fun w : ℝ³ => F (x + w)) ∘ ⇑(-(ContinuousLinearMap.id ℝ ℝ³)) := by
      funext z
      simp [sub_eq_add_neg]
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis _
        (EuclideanSpace.basisFun (Fin 3) ℝ),
      InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis F
        (EuclideanSpace.basisFun (Fin 3) ℝ)]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hcomp, ContinuousLinearMap.iteratedFDeriv_comp_right _ hGs y (i := 2) (by simp),
      ContinuousMultilinearMap.compContinuousLinearMap_apply]
    have e1 : (fun j => (-(ContinuousLinearMap.id ℝ ℝ³))
          (![(EuclideanSpace.basisFun (Fin 3) ℝ) i, (EuclideanSpace.basisFun (Fin 3) ℝ) i] j))
        = fun j => (fun _ => (-1 : ℝ)) j •
          ![(EuclideanSpace.basisFun (Fin 3) ℝ) i, (EuclideanSpace.basisFun (Fin 3) ℝ) i] j := by
      funext j
      simp
    rw [e1, ContinuousMultilinearMap.map_smul_univ, iteratedFDeriv_comp_add_left]
    have e2 : x + (-(ContinuousLinearMap.id ℝ ℝ³)) y = x - y := by
      simp [sub_eq_add_neg]
    rw [e2]
    simp [Fin.prod_univ_two]

  have hΔF0 : ∀ w : ℝ³, R < ‖w‖ → Δ F w = 0 := by
    intro w hw
    have hU : IsOpen {z : ℝ³ | R < ‖z‖} := isOpen_lt continuous_const continuous_norm
    have hev : F =ᶠ[nhds w] fun _ => (0:ℝ) :=
      Filter.eventually_of_mem (hU.mem_nhds hw) (fun z hz => hvan z (le_of_lt hz))
    rw [(laplacian_congr_nhds hev).eq_of_nhds, laplacian_const]
    simp

  obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = |R| + 1 := ⟨_, rfl⟩
  have hRρ : R < ρ := by have := le_abs_self R; linarith
  have hρpos : 0 < ρ := by have := abs_nonneg R; linarith
  obtain ⟨η, hη⟩ : ∃ η : ContDiffBump x, η.rIn = ρ :=
    ⟨⟨ρ, ρ + 1, hρpos, by linarith⟩, rfl⟩
  have hη1 : ∀ y ∈ Metric.closedBall x ρ, η y = 1 := fun y hy =>
    η.one_of_mem_closedBall (by rw [hη]; exact hy)
  have hh1s : ContDiff ℝ ∞ (fun y => η y * h y) := η.contDiff.mul hh
  have hh1c : HasCompactSupport (fun y => η y * h y) := η.hasCompactSupport.mul_right (f' := h)

  have hFts : ContDiff ℝ ∞ (fun y => F (x - y)) := hF.comp (contDiff_const.sub contDiff_id)
  have hFtc : HasCompactSupport (fun y => F (x - y)) := by
    refine HasCompactSupport.intro (isCompact_closedBall x |R|) (fun y hy => ?_)
    rw [Metric.mem_closedBall, not_le, dist_eq_norm, norm_sub_rev] at hy
    exact hvan _ (le_trans (le_abs_self R) hy.le)

  have hIBP : ∫ y, F (x - y) * Δ (fun y => η y * h y) y
      = ∫ y, Δ (fun y => F (x - y)) y * (η y * h y) := by
    have := SchwartzMap.integral_mul_laplacian_right_eq_left (μ := volume)
      (hFtc.toSchwartzMap hFts) (hh1c.toSchwartzMap hh1s)
    simp only [SchwartzMap.laplacian_apply] at this
    have ef : (⇑(hFtc.toSchwartzMap hFts) : ℝ³ → ℝ) = fun y => F (x - y) :=
      funext (HasCompactSupport.toSchwartzMap_toFun hFtc hFts)
    have eg : (⇑(hh1c.toSchwartzMap hh1s) : ℝ³ → ℝ) = fun y => η y * h y :=
      funext (HasCompactSupport.toSchwartzMap_toFun hh1c hh1s)
    rw [ef, eg] at this
    exact this

  have hL : ∫ y, F (x - y) * Δ h y = ∫ y, F (x - y) * Δ (fun y => η y * h y) y := by
    congr 1
    funext y
    by_cases hy : ‖x - y‖ < ρ
    · have hmem : y ∈ Metric.ball x ρ := by
        rw [Metric.mem_ball, dist_eq_norm, norm_sub_rev]; exact hy
      have hev : (fun y => η y * h y) =ᶠ[nhds y] h :=
        Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hmem) (fun z hz => by
          show η z * h z = h z
          rw [hη1 z (Metric.ball_subset_closedBall hz), one_mul])
      rw [(laplacian_congr_nhds hev).eq_of_nhds]
    · push_neg at hy
      rw [hvan _ (le_trans hRρ.le hy), zero_mul, zero_mul]

  have hR' : ∫ y, Δ (fun y => F (x - y)) y * (η y * h y) = ∫ y, Δ F (x - y) * h y := by
    congr 1
    funext y
    rw [hrefl y]
    by_cases hy : ‖x - y‖ ≤ ρ
    · have hmem : y ∈ Metric.closedBall x ρ := by
        rw [Metric.mem_closedBall, dist_eq_norm, norm_sub_rev]; exact hy
      rw [hη1 y hmem, one_mul]
    · push_neg at hy
      rw [hΔF0 _ (lt_trans hRρ hy), zero_mul, zero_mul]
  rw [hL, hIBP, hR']

theorem laplacian_rescale : ∀ (F : ℝ³ → ℝ) (ε : ℝ), ContDiff ℝ ∞ F → ε ≠ 0 → ∀ z : ℝ³, Δ (fun w : ℝ³ => ε⁻¹ * F (ε⁻¹ • w)) z = (ε ^ 3)⁻¹ * Δ F (ε⁻¹ • z) :=
by
  intro F ε hF _hε z
  have h2 : (2 : WithTop ℕ∞) ≤ ∞ := by simp
  set A : ℝ³ →L[ℝ] ℝ³ := ε⁻¹ • ContinuousLinearMap.id ℝ ℝ³ with hAdef
  have hA : ∀ u, A u = ε⁻¹ • u := fun u => rfl
  have hfun : (fun w : ℝ³ => ε⁻¹ * F (ε⁻¹ • w)) = ε⁻¹ • (F ∘ ⇑A) := by
    funext w
    simp only [Pi.smul_apply, Function.comp_apply, hA, smul_eq_mul]
  have hH : ContDiff ℝ ∞ (F ∘ ⇑A) := hF.comp A.contDiff
  rw [hfun, laplacian_smul ε⁻¹ (hH.contDiffAt.of_le h2), smul_eq_mul]
  set b := EuclideanSpace.basisFun (Fin 3) ℝ with hb
  rw [congrFun (laplacian_eq_iteratedFDeriv_orthonormalBasis (F ∘ ⇑A) b) z,
    congrFun (laplacian_eq_iteratedFDeriv_orthonormalBasis F b) (ε⁻¹ • z)]
  have hcomp := A.iteratedFDeriv_comp_right hF z (i := 2) h2
  have hterm : ∀ i, iteratedFDeriv ℝ 2 (F ∘ ⇑A) z ![b i, b i]
      = (ε⁻¹) ^ 2 * iteratedFDeriv ℝ 2 F (ε⁻¹ • z) ![b i, b i] := by
    intro i
    rw [hcomp, ContinuousMultilinearMap.compContinuousLinearMap_apply, hA z]
    have e : (fun j : Fin 2 => (fun _ : Fin 2 => A) j (![b i, b i] j))
        = fun j => (fun _ : Fin 2 => ε⁻¹) j • ![b i, b i] j := by
      funext j
      exact hA _
    rw [e, ContinuousMultilinearMap.map_smul_univ, Fin.prod_const, smul_eq_mul]
  simp only [hterm, ← Finset.mul_sum]
  rw [← inv_pow]
  ring

theorem radial_laplacian_sq : ∀ (φ : ℝ → ℝ) (z : ℝ³), ContDiff ℝ ∞ φ → Δ (fun w : ℝ³ => φ (‖w‖ ^ 2)) z = 4 * ‖z‖ ^ 2 * deriv (deriv φ) (‖z‖ ^ 2) + 6 * deriv φ (‖z‖ ^ 2) :=
by
  intro φ z hφ
  have hφd : Differentiable ℝ φ := hφ.differentiable (by simp)
  have hφ' : ContDiff ℝ ∞ (deriv φ) := (contDiff_infty_iff_deriv.mp hφ).2
  have hφ'd : Differentiable ℝ (deriv φ) := hφ'.differentiable (by simp)
  set f : ℝ³ → ℝ := fun w => φ (‖w‖ ^ 2) with hfdef
  have hf : ContDiff ℝ ∞ f := hφ.comp (contDiff_norm_sq ℝ)

  have hD1 : ∀ y v : ℝ³, fderiv ℝ f y v = 2 * deriv φ (‖y‖ ^ 2) * inner ℝ v y := by
    intro y v
    have h := (hφd (‖y‖ ^ 2)).hasDerivAt.comp_hasFDerivAt y
      (hasStrictFDerivAt_norm_sq y).hasFDerivAt
    have e : fderiv ℝ f y = deriv φ (‖y‖ ^ 2) • (2 • innerSL ℝ y) := h.fderiv
    rw [e]
    simp only [ContinuousLinearMap.smul_apply, innerSL_apply_apply, smul_eq_mul, nsmul_eq_mul]
    rw [real_inner_comm]
    push_cast
    ring

  have hD2 : ∀ v : ℝ³, fderiv ℝ (fun y : ℝ³ => 2 * deriv φ (‖y‖ ^ 2) * inner ℝ v y) z v
      = 4 * deriv (deriv φ) (‖z‖ ^ 2) * inner ℝ v z ^ 2 + 2 * deriv φ (‖z‖ ^ 2) * ‖v‖ ^ 2 := by
    intro v
    have hA := (hφ'd (‖z‖ ^ 2)).hasDerivAt.comp_hasFDerivAt z
      (hasStrictFDerivAt_norm_sq z).hasFDerivAt
    have hA2 := hA.const_mul 2
    have hB : HasFDerivAt (fun y : ℝ³ => inner ℝ v y) (innerSL ℝ v) z :=
      (innerSL ℝ v).hasFDerivAt
    have hM : HasFDerivAt (fun y : ℝ³ => 2 * deriv φ (‖y‖ ^ 2) * inner ℝ v y)
        ((2 * (deriv φ ∘ fun x : ℝ³ => ‖x‖ ^ 2) z) • innerSL ℝ v
          + inner ℝ v z • ((2 : ℝ) • (deriv (deriv φ) (‖z‖ ^ 2) • (2 • innerSL ℝ z)))) z :=
      hA2.mul hB
    rw [hM.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, innerSL_apply_apply,
      smul_eq_mul, nsmul_eq_mul, Function.comp_apply, real_inner_self_eq_norm_sq]
    rw [real_inner_comm z v]
    push_cast
    ring
  have hfd1 : Differentiable ℝ (fderiv ℝ f) :=
    (hf.fderiv_right (m := 1) (by simp)).differentiable (by simp)
  have hD2f : ∀ u : ℝ³, fderiv ℝ (fderiv ℝ f) z u u
      = 4 * deriv (deriv φ) (‖z‖ ^ 2) * inner ℝ u z ^ 2 + 2 * deriv φ (‖z‖ ^ 2) * ‖u‖ ^ 2 := by
    intro u
    have h1 := fderiv_clm_apply (hfd1 z) (differentiableAt_const (c := u) (x := z))
    have h2 : (fun y => fderiv ℝ f y u) = fun y => 2 * deriv φ (‖y‖ ^ 2) * inner ℝ u y :=
      funext (fun y => hD1 y u)
    rw [← hD2 u, ← h2, h1]
    simp
  rw [congrFun (InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis f
    (EuclideanSpace.basisFun (Fin 3) ℝ)) z]
  simp only [iteratedFDeriv_two_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, hD2f]
  have hP := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_inner_mul_inner z z
  have hn : ∀ i, ‖(EuclideanSpace.basisFun (Fin 3) ℝ) i‖ = 1 := fun i =>
    (EuclideanSpace.basisFun (Fin 3) ℝ).orthonormal.1 i
  have hc : ∀ i, inner ℝ z ((EuclideanSpace.basisFun (Fin 3) ℝ) i)
      = inner ℝ ((EuclideanSpace.basisFun (Fin 3) ℝ) i) z := fun i => real_inner_comm _ _
  simp only [hc, real_inner_self_eq_norm_sq] at hP
  simp only [hn, Fin.sum_univ_three] at hP ⊢
  linear_combination (4 * deriv (deriv φ) (‖z‖ ^ 2)) * hP

theorem radial_laplacian_integral : ∀ (φ : ℝ → ℝ), ContDiff ℝ ∞ φ → (∀ s : ℝ, 1 < s → 4 * s * deriv (deriv φ) s + 6 * deriv φ s = 0) → ∫ z : ℝ³, (4 * ‖z‖ ^ 2 * deriv (deriv φ) (‖z‖ ^ 2) + 6 * deriv φ (‖z‖ ^ 2)) = 64 * Real.pi * deriv φ 4 :=
by
  intro φ hφ htail
  have h1 : Differentiable ℝ φ ∧ ContDiff ℝ ∞ (deriv φ) := contDiff_infty_iff_deriv.mp hφ
  have h2 : Differentiable ℝ (deriv φ) ∧ ContDiff ℝ ∞ (deriv (deriv φ)) :=
    contDiff_infty_iff_deriv.mp h1.2
  have hd1 : Differentiable ℝ (deriv φ) := h2.1
  have hc1 : Continuous (deriv φ) := h1.2.continuous
  have hc2 : Continuous (deriv (deriv φ)) := h2.2.continuous
  set f : ℝ → ℝ := fun r => 4 * r ^ 2 * deriv (deriv φ) (r ^ 2) + 6 * deriv φ (r ^ 2) with hfdef
  set H : ℝ → ℝ := fun r => 2 * r ^ 3 * deriv φ (r ^ 2) with hHdef
  have hGc : Continuous (fun y : ℝ => y ^ 2 * f y) := by
    simp only [hfdef]
    have a : Continuous (fun y : ℝ => deriv (deriv φ) (y ^ 2)) := hc2.comp (continuous_pow 2)
    have b : Continuous (fun y : ℝ => deriv φ (y ^ 2)) := hc1.comp (continuous_pow 2)
    fun_prop
  have htail' : ∀ r : ℝ, 1 < r → f r = 0 := by
    intro r hr
    have hr2 : 1 < r ^ 2 := by nlinarith
    exact htail (r ^ 2) hr2
  have hderiv : ∀ y : ℝ, HasDerivAt H (y ^ 2 * f y) y := by
    intro y
    have hA : HasDerivAt (fun y : ℝ => y ^ 3) (↑(3:ℕ) * y ^ (3 - 1)) y := hasDerivAt_pow 3 y
    have hP : HasDerivAt (fun y : ℝ => y ^ 2) (↑(2:ℕ) * y ^ (2 - 1)) y := hasDerivAt_pow 2 y
    have hD : HasDerivAt (deriv φ) (deriv (deriv φ) (y ^ 2)) (y ^ 2) := (hd1 (y ^ 2)).hasDerivAt
    have hB : HasDerivAt (fun y : ℝ => deriv φ (y ^ 2))
        (deriv (deriv φ) (y ^ 2) * (↑(2:ℕ) * y ^ (2 - 1))) y :=
      HasDerivAt.comp (h := fun y : ℝ => y ^ 2) y hD hP
    have hM := (hA.const_mul 2).mul hB
    convert hM using 1
    simp only [hfdef]
    push_cast
    ring
  have hval : ∫ y in Set.Ioi (0:ℝ), y ^ 2 * f y = 16 * deriv φ 4 := by
    rw [MeasureTheory.setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (s := Set.Ioc (0:ℝ) 2)
      measurableSet_Ioi (fun x hx => hx.1) ?_]
    · rw [← intervalIntegral.integral_of_le (by norm_num : (0:ℝ) ≤ 2),
        intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hderiv x)
          (hGc.intervalIntegrable _ _)]
      simp only [hHdef]
      norm_num
    · intro x hx
      have hx0 : 0 < x := hx.1
      have hx2 : ¬ x ≤ 2 := fun h => hx.2 ⟨hx0, h⟩
      rw [htail' x (by linarith), mul_zero]
  have hfr : Module.finrank ℝ ℝ³ = 3 := finrank_euclideanSpace_fin
  have hvol : (volume : Measure ℝ³).real (Metric.ball 0 1) = 4 * Real.pi / 3 := by
    rw [measureReal_def, EuclideanSpace.volume_ball_fin_three, ENNReal.ofReal_one, one_pow,
      one_mul, ENNReal.toReal_ofReal (by positivity)]
    ring
  show ∫ z : ℝ³, f ‖z‖ = 64 * Real.pi * deriv φ 4
  rw [integral_fun_norm_addHaar (volume : Measure ℝ³) f, hfr, hvol]
  have h2' : ∫ y in Set.Ioi (0:ℝ), y ^ (3 - 1) • f y = 16 * deriv φ 4 := hval
  rw [h2', smul_eq_mul, nsmul_eq_mul]
  push_cast
  ring

theorem far_kernel_profile : ContDiff ℝ ∞ (fun s : ℝ => Real.smoothTransition (2 * s - 1) * (4 * Real.pi * Real.sqrt s)⁻¹) ∧ (∀ z : ℝ³, Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z = (fun s : ℝ => Real.smoothTransition (2 * s - 1) * (4 * Real.pi * Real.sqrt s)⁻¹) (‖z‖ ^ 2)) ∧ (∀ s : ℝ, 1 < s → 4 * s * deriv (deriv (fun s : ℝ => Real.smoothTransition (2 * s - 1) * (4 * Real.pi * Real.sqrt s)⁻¹)) s + 6 * deriv (fun s : ℝ => Real.smoothTransition (2 * s - 1) * (4 * Real.pi * Real.sqrt s)⁻¹) s = 0) ∧ deriv (fun s : ℝ => Real.smoothTransition (2 * s - 1) * (4 * Real.pi * Real.sqrt s)⁻¹) 4 = -(64 * Real.pi)⁻¹ :=
by
  set φ : ℝ → ℝ := fun s : ℝ => Real.smoothTransition (2 * s - 1) * (4 * Real.pi * Real.sqrt s)⁻¹
    with hφ
  have hpi : 0 < Real.pi := Real.pi_pos
  have hT : ∀ t : ℝ, 1 ≤ t → φ t = (4 * Real.pi)⁻¹ * t ^ (-(1/2):ℝ) := by
    intro t ht
    simp only [hφ]
    rw [Real.smoothTransition.one_of_one_le (by linarith), one_mul, mul_inv, Real.sqrt_eq_rpow,
      Real.rpow_neg (by linarith)]
  have hev : ∀ s : ℝ, 1 < s → φ =ᶠ[nhds s] (fun t => (4 * Real.pi)⁻¹ * t ^ (-(1/2):ℝ)) :=
    fun s hs => Filter.eventuallyEq_of_mem (Ioi_mem_nhds hs) (fun t ht => hT t (le_of_lt ht))
  have hD1 : ∀ t : ℝ, 1 < t →
      deriv φ t = (4 * Real.pi)⁻¹ * ((-(1/2):ℝ) * t ^ ((-(1/2):ℝ) - 1)) := by
    intro t ht
    rw [(hev t ht).deriv_eq]
    exact ((Real.hasDerivAt_rpow_const (Or.inl (by linarith : t ≠ 0))).const_mul _).deriv
  have hD2 : ∀ s : ℝ, 1 < s → deriv (deriv φ) s
      = (4 * Real.pi)⁻¹ * ((-(1/2):ℝ) * (((-(1/2):ℝ) - 1) * s ^ ((-(1/2):ℝ) - 1 - 1))) := by
    intro s hs
    have he : deriv φ =ᶠ[nhds s]
        (fun t => (4 * Real.pi)⁻¹ * ((-(1/2):ℝ) * t ^ ((-(1/2):ℝ) - 1))) :=
      Filter.eventuallyEq_of_mem (Ioi_mem_nhds hs) (fun t ht => hD1 t ht)
    rw [he.deriv_eq]
    exact (((Real.hasDerivAt_rpow_const (Or.inl (by linarith : s ≠ 0))).const_mul _).const_mul
      _).deriv
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [contDiff_iff_contDiffAt]
    intro s
    rcases lt_or_ge s (1/2) with hs | hs
    · have hev0 : φ =ᶠ[nhds s] (fun _ => (0:ℝ)) :=
        Filter.eventuallyEq_of_mem (Iio_mem_nhds hs) (fun t ht => by
          have ht' : t < 1/2 := ht
          simp only [hφ]
          rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_mul])
      exact contDiffAt_const.congr_of_eventuallyEq hev0
    · have hs0 : s ≠ 0 := by intro h; rw [h] at hs; norm_num at hs
      have h1 : ContDiffAt ℝ ∞ (fun t : ℝ => Real.smoothTransition (2 * t - 1)) s :=
        (Real.smoothTransition.contDiff.comp
          ((contDiff_const.mul contDiff_id).sub contDiff_const)).contDiffAt
      have h2 : ContDiffAt ℝ ∞ (fun t : ℝ => 4 * Real.pi * Real.sqrt t) s :=
        contDiffAt_const.mul (Real.contDiffAt_sqrt hs0)
      have hne : 4 * Real.pi * Real.sqrt s ≠ 0 := by
        have : 0 < Real.sqrt s := Real.sqrt_pos.mpr (by linarith)
        positivity
      exact h1.mul (h2.inv hne)
  · intro z
    simp only [hφ, newtonKernel, Real.sqrt_sq (norm_nonneg z)]
  · intro s hs
    rw [hD1 s hs, hD2 s hs]
    have hs0 : (0:ℝ) < s := by linarith
    have e2 : ((-(1/2):ℝ) - 1 - 1) = (-(5/2):ℝ) := by norm_num
    have e1 : ((-(1/2):ℝ) - 1) = (-(5/2):ℝ) + 1 := by norm_num
    rw [e2, e1, Real.rpow_add_one hs0.ne']
    ring
  · rw [hD1 4 (by norm_num)]
    have e : (4:ℝ) ^ ((-(1/2):ℝ) - 1) = 8⁻¹ := by
      rw [show ((-(1/2):ℝ) - 1) = -((1/2:ℝ) + 1) by norm_num, Real.rpow_neg (by norm_num),
        Real.rpow_add_one (by norm_num), ← Real.sqrt_eq_rpow,
        show (4:ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
      norm_num
    rw [e]
    field_simp
    ring

theorem truncated_newton_bound : ∀ (k D : ℝ³ → ℝ) (x : ℝ³) (r M : ℝ), 0 < r → Measurable k → (∀ z : ℝ³, 0 ≤ k z ∧ k z ≤ newtonKernel z) → (∀ z : ℝ³, r ≤ ‖z‖ → k z = 0) → Continuous D → (∀ y ∈ Metric.closedBall x r, |D y| ≤ M) → Integrable (fun y => k (x - y) * D y) ∧ |∫ y, k (x - y) * D y| ≤ M * (r ^ 2 / 2) :=
by
  intro k D x r M hr hkm hkb hk0 hD hM
  have hball : IntegrableOn newtonKernel (Metric.ball (0 : ℝ³) r) ∧
      ∫ z in Metric.ball (0 : ℝ³) r, newtonKernel z = r ^ 2 / 2 := by
    set f : ℝ → ℝ := fun s => if s < r then (4 * Real.pi * s)⁻¹ else 0 with hfdef
    have hpi : 0 < Real.pi := Real.pi_pos
    have hind : (Metric.ball (0 : ℝ³) r).indicator newtonKernel = fun z => f ‖z‖ := by
      funext z
      by_cases h : ‖z‖ < r
      · have hz : z ∈ Metric.ball (0 : ℝ³) r := mem_ball_zero_iff.mpr h
        rw [Set.indicator_of_mem hz]
        simp only [hfdef, if_pos h, newtonKernel]
      · have hz : z ∉ Metric.ball (0 : ℝ³) r := fun hz => h (mem_ball_zero_iff.mp hz)
        rw [Set.indicator_of_notMem hz]
        simp only [hfdef, if_neg h]
    set g : ℝ → ℝ := (Set.Iio r).indicator (fun y : ℝ => y / (4 * Real.pi)) with hgdef
    have hEq : Set.EqOn (fun y : ℝ => y ^ 2 * f y) g (Set.Ioi 0) := by
      intro y hy
      have hy0 : 0 < y := hy
      by_cases h : y < r
      · simp only [hfdef, if_pos h, hgdef, Set.indicator_of_mem (show y ∈ Set.Iio r from h)]
        field_simp
      · simp only [hfdef, if_neg h, hgdef, Set.indicator_of_notMem (show y ∉ Set.Iio r from h),
          mul_zero]
    have hgint : IntegrableOn g (Set.Ioi 0) := by
      rw [hgdef, integrableOn_indicator_iff measurableSet_Iio]
      have : IntegrableOn (fun y : ℝ => y / (4 * Real.pi)) (Set.Icc 0 r) :=
        (continuous_id.div_const _).integrableOn_Icc
      exact this.mono_set (fun y hy => ⟨le_of_lt hy.2, le_of_lt hy.1⟩)
    have h1int : IntegrableOn (fun y : ℝ => y ^ 2 * f y) (Set.Ioi 0) :=
      hgint.congr_fun hEq.symm measurableSet_Ioi
    have h1val : ∫ y in Set.Ioi (0:ℝ), y ^ 2 * f y = r ^ 2 / (8 * Real.pi) := by
      rw [setIntegral_congr_fun measurableSet_Ioi hEq, hgdef, setIntegral_indicator measurableSet_Iio,
        Set.Ioi_inter_Iio, ← integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le hr.le,
        intervalIntegral.integral_div, integral_id]
      field_simp
      ring
    have hfr : Module.finrank ℝ ℝ³ = 3 := finrank_euclideanSpace_fin
    have hFint : Integrable (fun z : ℝ³ => f ‖z‖) := by
      rw [integrable_fun_norm_addHaar (volume : Measure ℝ³), hfr]
      exact h1int
    have hvol : (volume : Measure ℝ³).real (Metric.ball 0 1) = 4 * Real.pi / 3 := by
      rw [measureReal_def, EuclideanSpace.volume_ball_fin_three, ENNReal.ofReal_one, one_pow,
        one_mul, ENNReal.toReal_ofReal (by positivity)]
      ring
    refine ⟨?_, ?_⟩
    · rw [← integrable_indicator_iff measurableSet_ball, hind]
      exact hFint
    · rw [← integral_indicator measurableSet_ball, hind,
        integral_fun_norm_addHaar (volume : Measure ℝ³) f, hfr, hvol]
      have h2 : ∫ y in Set.Ioi (0:ℝ), y ^ (3 - 1) • f y = r ^ 2 / (8 * Real.pi) := h1val
      rw [h2, smul_eq_mul, nsmul_eq_mul]
      push_cast
      field_simp
      ring
  obtain ⟨hIon, hval⟩ := hball
  set Φ : ℝ³ → ℝ := fun t => k t * D (x - t) with hΦdef
  set G : ℝ³ → ℝ := fun t => M * (Metric.ball (0 : ℝ³) r).indicator newtonKernel t with hGdef
  have hrefl : (fun y => k (x - y) * D y) = (fun y => Φ (x - y)) := by
    funext y
    simp only [hΦdef, sub_sub_cancel]
  have hGi : Integrable G :=
    ((integrable_indicator_iff measurableSet_ball).mpr hIon).const_mul M
  have hGint : ∫ t, G t = M * (r ^ 2 / 2) := by
    simp only [hGdef]
    rw [integral_const_mul, integral_indicator measurableSet_ball, hval]
  have hΦm : AEStronglyMeasurable Φ := by
    have hc : Continuous (fun t : ℝ³ => D (x - t)) := hD.comp (continuous_const.sub continuous_id)
    exact (hkm.mul hc.measurable).aestronglyMeasurable
  have hdom : ∀ t, ‖Φ t‖ ≤ G t := by
    intro t
    simp only [hΦdef, hGdef, Real.norm_eq_abs, abs_mul, abs_of_nonneg (hkb t).1]
    by_cases ht : t ∈ Metric.ball (0 : ℝ³) r
    · rw [Set.indicator_of_mem ht]
      have hmem : x - t ∈ Metric.closedBall x r := by
        rw [Metric.mem_closedBall, dist_eq_norm, sub_sub_cancel_left, norm_neg]
        rw [mem_ball_zero_iff] at ht
        exact ht.le
      have h1 := mul_le_mul (hkb t).2 (hM _ hmem) (abs_nonneg _) (le_trans (hkb t).1 (hkb t).2)
      linarith [mul_comm (newtonKernel t) M]
    · rw [Set.indicator_of_notMem ht]
      rw [mem_ball_zero_iff, not_lt] at ht
      rw [hk0 t ht]
      simp
  have hΦi : Integrable Φ := hGi.mono' hΦm (Filter.Eventually.of_forall hdom)
  have hb : ‖∫ t, Φ t‖ ≤ ∫ t, G t :=
    norm_integral_le_of_norm_le hGi (Filter.Eventually.of_forall hdom)
  refine ⟨?_, ?_⟩
  · rw [hrefl]
    exact hΦi.comp_sub_left x
  · rw [hrefl, integral_sub_left_eq_self Φ (volume : Measure ℝ³) x, ← hGint, ← Real.norm_eq_abs]
    exact hb

theorem scaled_kernel_limit : ∀ (Ψ g : ℝ³ → ℝ) (x : ℝ³) (ε M : ℝ), Continuous Ψ → (∀ u : ℝ³, 1 < ‖u‖ → Ψ u = 0) → ContDiff ℝ 1 g → 0 < ε → ε ≤ 1 → (∀ y ∈ Metric.closedBall x 1, ‖fderiv ℝ g y‖ ≤ M) → Integrable (fun y => (ε ^ 3)⁻¹ * Ψ (ε⁻¹ • (x - y)) * g y) ∧ |(∫ y, (ε ^ 3)⁻¹ * Ψ (ε⁻¹ • (x - y)) * g y) - (∫ u, Ψ u) * g x| ≤ ε * M * ∫ u, |Ψ u| :=
by
  intro Ψ g x ε M hΨc hΨs hg hε hε1 hM
  have hxmem : x ∈ Metric.closedBall x 1 := Metric.mem_closedBall_self zero_le_one
  have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hM x hxmem)
  have hgc : Continuous g := hg.continuous
  have hI : Integrable (fun y => (ε ^ 3)⁻¹ * Ψ (ε⁻¹ • (x - y)) * g y) := by
    refine Continuous.integrable_of_hasCompactSupport ?_ ?_
    · exact (continuous_const.mul
        (hΨc.comp ((continuous_const_smul ε⁻¹).comp
          ((continuous_const : Continuous (fun _ : ℝ³ => x)).sub continuous_id)))).mul hgc
    · refine HasCompactSupport.intro (isCompact_closedBall x 1) (fun y hy => ?_)
      rw [Metric.mem_closedBall, not_le, dist_eq_norm, norm_sub_rev] at hy
      have h1 : 1 < ‖ε⁻¹ • (x - y)‖ := by
        rw [norm_smul_of_nonneg (inv_nonneg.mpr hε.le), inv_mul_eq_div, one_lt_div hε]
        linarith
      show (ε ^ 3)⁻¹ * Ψ (ε⁻¹ • (x - y)) * g y = 0
      rw [hΨs _ h1, mul_zero, zero_mul]
  refine ⟨hI, ?_⟩
  obtain ⟨H, hH⟩ : ∃ H : ℝ³ → ℝ, H = fun u => Ψ u * g (x - ε • u) := ⟨_, rfl⟩
  have hcov : ∫ y, (ε ^ 3)⁻¹ * Ψ (ε⁻¹ • (x - y)) * g y = ∫ u, H u := by
    have e1 := integral_sub_left_eq_self
      (fun y => (ε ^ 3)⁻¹ * Ψ (ε⁻¹ • (x - y)) * g y) (volume : Measure ℝ³) x
    simp only [sub_sub_cancel] at e1
    rw [← e1]
    have e2 : (fun y => (ε ^ 3)⁻¹ * Ψ (ε⁻¹ • y) * g (x - y))
        = fun y => (ε ^ 3)⁻¹ * H (ε⁻¹ • y) := by
      funext y
      rw [hH]
      simp only [smul_inv_smul₀ hε.ne']
      ring
    rw [e2, integral_const_mul, Measure.integral_comp_inv_smul_of_nonneg volume H hε.le,
      finrank_euclideanSpace_fin, smul_eq_mul, inv_mul_cancel_left₀ (pow_ne_zero 3 hε.ne')]
  rw [hcov]
  have hsupp : ∀ φ : ℝ³ → ℝ, Continuous φ → Integrable (fun u => Ψ u * φ u) := by
    intro φ hφ
    refine (hΨc.mul hφ).integrable_of_hasCompactSupport ?_
    refine HasCompactSupport.intro (isCompact_closedBall (0:ℝ³) 1) (fun u hu => ?_)
    rw [Metric.mem_closedBall, dist_zero_right, not_le] at hu
    show Ψ u * φ u = 0
    rw [hΨs u hu, zero_mul]
  have hshc : Continuous (fun u : ℝ³ => g (x - ε • u)) :=
    hgc.comp (continuous_const.sub (continuous_const_smul ε))
  have hHi : Integrable H := by rw [hH]; exact hsupp _ hshc
  have hGi : Integrable (fun u => Ψ u * g x) := hsupp _ continuous_const
  have hAi : Integrable (fun u => |Ψ u| * (ε * M)) := by
    have h1 : Integrable (fun u => Ψ u * 1) := hsupp _ continuous_const
    simp only [mul_one] at h1
    exact h1.abs.mul_const _
  have hDi : Integrable (fun u => |Ψ u * (g (x - ε • u) - g x)|) :=
    (hsupp _ (hshc.sub continuous_const)).abs
  have hdiff : (∫ u, H u) - (∫ u, Ψ u) * g x = ∫ u, Ψ u * (g (x - ε • u) - g x) := by
    rw [← integral_mul_const, ← integral_sub hHi hGi]
    congr 1
    funext u
    rw [hH]
    ring
  rw [hdiff]
  have hpt : ∀ u, |Ψ u * (g (x - ε • u) - g x)| ≤ |Ψ u| * (ε * M) := by
    intro u
    by_cases hu : 1 < ‖u‖
    · rw [hΨs u hu]; simp
    · push_neg at hu
      have hz : x - ε • u ∈ Metric.closedBall x 1 := by
        rw [Metric.mem_closedBall, dist_eq_norm, sub_sub_cancel_left, norm_neg,
          norm_smul_of_nonneg hε.le]
        nlinarith [norm_nonneg u]
      have hmvt := (convex_closedBall x 1).norm_image_sub_le_of_norm_fderiv_le
        (fun y _ => (hg.differentiable one_ne_zero).differentiableAt) hM hxmem hz
      rw [sub_sub_cancel_left, norm_neg, norm_smul_of_nonneg hε.le, Real.norm_eq_abs] at hmvt
      rw [abs_mul]
      refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
      calc |g (x - ε • u) - g x| ≤ M * (ε * ‖u‖) := hmvt
        _ ≤ ε * M := by nlinarith [mul_nonneg hM0 hε.le]
  calc |∫ u, Ψ u * (g (x - ε • u) - g x)|
      ≤ ∫ u, |Ψ u * (g (x - ε • u) - g x)| := abs_integral_le_integral_abs
    _ ≤ ∫ u, |Ψ u| * (ε * M) := integral_mono hDi hAi hpt
    _ = ε * M * ∫ u, |Ψ u| := by rw [integral_mul_const]; ring

theorem scaled_far_kernel : ∀ ε : ℝ, 0 < ε → ContDiff ℝ ∞ (fun z : ℝ³ => ε⁻¹ * (Real.smoothTransition (2 * ‖ε⁻¹ • z‖ ^ 2 - 1) * newtonKernel (ε⁻¹ • z))) ∧ (∀ z : ℝ³, 0 ≤ ε⁻¹ * (Real.smoothTransition (2 * ‖ε⁻¹ • z‖ ^ 2 - 1) * newtonKernel (ε⁻¹ • z)) ∧ ε⁻¹ * (Real.smoothTransition (2 * ‖ε⁻¹ • z‖ ^ 2 - 1) * newtonKernel (ε⁻¹ • z)) ≤ newtonKernel z) ∧ (∀ z : ℝ³, ε ≤ ‖z‖ → ε⁻¹ * (Real.smoothTransition (2 * ‖ε⁻¹ • z‖ ^ 2 - 1) * newtonKernel (ε⁻¹ • z)) = newtonKernel z) :=
by
  intro ε hε
  set K : ℝ³ → ℝ := fun z : ℝ³ => Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z
    with hKdef
  have hΓnn : ∀ z : ℝ³, 0 ≤ newtonKernel z := fun z => by
    unfold newtonKernel; positivity
  have hK1 : ∀ z : ℝ³, 1 ≤ ‖z‖ → K z = newtonKernel z := by
    intro z hz
    show Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z = newtonKernel z
    rw [Real.smoothTransition.one_of_one_le (by nlinarith), one_mul]
  have hKb : ∀ z : ℝ³, 0 ≤ K z ∧ K z ≤ newtonKernel z := fun z =>
    ⟨mul_nonneg (Real.smoothTransition.nonneg _) (hΓnn z),
     mul_le_of_le_one_left (hΓnn z) (Real.smoothTransition.le_one _)⟩
  have hq : ContDiff ℝ ∞ (fun w : ℝ³ => 2 * ‖w‖ ^ 2 - 1) :=
    (contDiff_const.mul (contDiff_norm_sq ℝ)).sub contDiff_const
  have hst : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff
  have hKs : ContDiff ℝ ∞ K := by
    rw [contDiff_iff_contDiffAt]
    intro z
    rcases lt_or_ge (2 * ‖z‖ ^ 2 - 1) 0 with h | h
    · have hU : IsOpen {w : ℝ³ | 2 * ‖w‖ ^ 2 - 1 < 0} :=
        isOpen_lt hq.continuous continuous_const
      have hev : K =ᶠ[nhds z] (fun _ => (0:ℝ)) :=
        Filter.eventuallyEq_of_mem (hU.mem_nhds h) (fun w hw => by
          show Real.smoothTransition (2 * ‖w‖ ^ 2 - 1) * newtonKernel w = 0
          rw [Real.smoothTransition.zero_of_nonpos (le_of_lt hw), zero_mul])
      exact contDiffAt_const.congr_of_eventuallyEq hev
    · have hz : z ≠ 0 := by
        rintro rfl
        simp at h
        linarith
      have hnz : 0 < ‖z‖ := norm_pos_iff.mpr hz
      have h1 : ContDiffAt ℝ ∞ (fun w : ℝ³ => Real.smoothTransition (2 * ‖w‖ ^ 2 - 1)) z :=
        (hst.comp hq).contDiffAt
      have h2 : ContDiffAt ℝ ∞ (fun w : ℝ³ => 4 * Real.pi * ‖w‖) z :=
        contDiffAt_const.mul (contDiffAt_norm ℝ hz)
      have h3 : ContDiffAt ℝ ∞ (fun w : ℝ³ => (4 * Real.pi * ‖w‖)⁻¹) z :=
        h2.inv (mul_pos (by positivity) hnz).ne'
      exact h1.mul h3
  have hnorm : ∀ z : ℝ³, ‖ε⁻¹ • z‖ = ε⁻¹ * ‖z‖ := by
    intro z
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hε)]
  have hhom : ∀ z : ℝ³, ε⁻¹ * newtonKernel (ε⁻¹ • z) = newtonKernel z := by
    intro z
    unfold newtonKernel
    rw [hnorm z, show 4 * Real.pi * (ε⁻¹ * ‖z‖) = ε⁻¹ * (4 * Real.pi * ‖z‖) by ring,
      mul_inv, inv_inv, ← mul_assoc, inv_mul_cancel₀ hε.ne', one_mul]
  have hinv : 0 ≤ ε⁻¹ := inv_nonneg.mpr hε.le
  refine ⟨?_, fun z => ⟨?_, ?_⟩, fun z hz => ?_⟩
  · have hc : ContDiff ℝ ∞ (fun z : ℝ³ => ε⁻¹ • z) := contDiff_const_smul ε⁻¹
    exact contDiff_const.mul (hKs.comp hc)
  · exact mul_nonneg hinv (hKb (ε⁻¹ • z)).1
  · calc ε⁻¹ * (Real.smoothTransition (2 * ‖ε⁻¹ • z‖ ^ 2 - 1) * newtonKernel (ε⁻¹ • z))
        ≤ ε⁻¹ * newtonKernel (ε⁻¹ • z) := mul_le_mul_of_nonneg_left (hKb (ε⁻¹ • z)).2 hinv
      _ = newtonKernel z := hhom z
  · have h1 : 1 ≤ ‖ε⁻¹ • z‖ := by
      rw [hnorm z]
      exact (one_le_inv_mul₀ hε).mpr hz
    calc ε⁻¹ * (Real.smoothTransition (2 * ‖ε⁻¹ • z‖ ^ 2 - 1) * newtonKernel (ε⁻¹ • z))
        = ε⁻¹ * K (ε⁻¹ • z) := rfl
      _ = ε⁻¹ * newtonKernel (ε⁻¹ • z) := by rw [hK1 (ε⁻¹ • z) h1]
      _ = newtonKernel z := hhom z

theorem green_local : ∀ (g : ℝ³ → ℝ), ContDiff ℝ ∞ g → ∀ x : ℝ³, (∫ y, (newtonKernel (x - y) - Real.smoothTransition (2 * ‖x - y‖ ^ 2 - 1) * newtonKernel (x - y)) * Δ g y) + (∫ y, Δ (fun z : ℝ³ => Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z) (x - y) * g y) = - g x :=
by
  intro g hg x
  have h2 : (2 : WithTop ℕ∞) ≤ ∞ := by simp
  have hcontΔ : ∀ f : ℝ³ → ℝ, ContDiff ℝ ∞ f → Continuous (Δ f) := by
    intro f hf
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis f
      (EuclideanSpace.basisFun (Fin 3) ℝ)]
    refine continuous_finset_sum _ (fun k _ => ?_)
    exact (hf.continuous_iteratedFDeriv (by simp)).eval_const _
  obtain ⟨K, hK⟩ : ∃ K : ℝ³ → ℝ,
      K = fun z => Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z := ⟨_, rfl⟩
  have hgoal : ((∫ y, (newtonKernel (x - y) - Real.smoothTransition (2 * ‖x - y‖ ^ 2 - 1)
        * newtonKernel (x - y)) * Δ g y) + (∫ y, Δ (fun z : ℝ³ => Real.smoothTransition
        (2 * ‖z‖ ^ 2 - 1) * newtonKernel z) (x - y) * g y))
      = (∫ y, (newtonKernel (x - y) - K (x - y)) * Δ g y) + ∫ y, Δ K (x - y) * g y := by
    subst hK; rfl
  rw [hgoal]
  have hKs : ContDiff ℝ ∞ K := by rw [hK]; exact far_kernel_basic.1
  have hK1 : ∀ z : ℝ³, 1 ≤ ‖z‖ → K z = newtonKernel z := by
    rw [hK]; exact far_kernel_basic.2.1
  have hKb : ∀ z : ℝ³, 0 ≤ K z ∧ K z ≤ newtonKernel z := by
    rw [hK]; exact far_kernel_basic.2.2.1
  have hNKm : Measurable newtonKernel := by unfold newtonKernel; fun_prop

  obtain ⟨φ, hφ⟩ : ∃ φ : ℝ → ℝ,
      φ = fun s : ℝ => Real.smoothTransition (2 * s - 1) * (4 * Real.pi * Real.sqrt s)⁻¹ :=
    ⟨_, rfl⟩
  have hφs : ContDiff ℝ ∞ φ := by rw [hφ]; exact far_kernel_profile.1
  have hφK : ∀ z : ℝ³, K z = φ (‖z‖ ^ 2) := by rw [hK, hφ]; exact far_kernel_profile.2.1
  have hφtail : ∀ s : ℝ, 1 < s → 4 * s * deriv (deriv φ) s + 6 * deriv φ s = 0 := by
    rw [hφ]; exact far_kernel_profile.2.2.1
  have hφ4 : deriv φ 4 = -(64 * Real.pi)⁻¹ := by rw [hφ]; exact far_kernel_profile.2.2.2
  have hΔKform : ∀ z : ℝ³,
      Δ K z = 4 * ‖z‖ ^ 2 * deriv (deriv φ) (‖z‖ ^ 2) + 6 * deriv φ (‖z‖ ^ 2) := by
    intro z
    have e : K = fun w : ℝ³ => φ (‖w‖ ^ 2) := funext hφK
    rw [e]; exact radial_laplacian_sq φ z hφs
  have hP1 : ∀ u : ℝ³, 1 < ‖u‖ → Δ K u = 0 := by
    intro u hu
    rw [hΔKform u]
    exact hφtail _ (by nlinarith [norm_nonneg u])
  have hP2 : ∫ u, Δ K u = -1 := by
    calc ∫ u, Δ K u
        = ∫ u : ℝ³, (4 * ‖u‖ ^ 2 * deriv (deriv φ) (‖u‖ ^ 2) + 6 * deriv φ (‖u‖ ^ 2)) :=
          integral_congr_ae (Filter.Eventually.of_forall hΔKform)
      _ = 64 * Real.pi * deriv φ 4 := radial_laplacian_integral φ hφs hφtail
      _ = -1 := by
          rw [hφ4, mul_neg, mul_inv_cancel₀ (by positivity)]
  have hΔKc : Continuous (Δ K) := hcontΔ K hKs

  obtain ⟨M₂, hM₂⟩ :=
    (isCompact_closedBall x 1).exists_bound_of_continuousOn (hcontΔ g hg).continuousOn
  obtain ⟨M₁, hM₁⟩ := (isCompact_closedBall x 1).exists_bound_of_continuousOn
    (hg.continuous_fderiv (by simp)).continuousOn
  have hxmem : x ∈ Metric.closedBall x 1 := Metric.mem_closedBall_self zero_le_one
  have hM₂0 : 0 ≤ M₂ := le_trans (norm_nonneg _) (hM₂ x hxmem)
  have hM₁0 : 0 ≤ M₁ := le_trans (norm_nonneg _) (hM₁ x hxmem)
  have hM₂' : ∀ y ∈ Metric.closedBall x 1, |Δ g y| ≤ M₂ := fun y hy => by
    have := hM₂ y hy
    rwa [Real.norm_eq_abs] at this
  obtain ⟨C, hC⟩ : ∃ C : ℝ, C = ∫ u, |Δ K u| := ⟨_, rfl⟩
  have hC0 : 0 ≤ C := by rw [hC]; exact integral_nonneg (fun u => abs_nonneg _)

  have hIa : Integrable (fun y => (newtonKernel (x - y) - K (x - y)) * Δ g y) :=
    (truncated_newton_bound (fun z => newtonKernel z - K z) (Δ g) x 1 M₂ one_pos
      (hNKm.sub hKs.continuous.measurable)
      (fun z => ⟨by linarith [(hKb z).2], by linarith [(hKb z).1]⟩)
      (fun z hz => by show newtonKernel z - K z = 0; rw [hK1 z hz, sub_self])
      (hcontΔ g hg) hM₂').1
  have hId : Integrable (fun y => Δ K (x - y) * g y) := by
    refine Continuous.integrable_of_hasCompactSupport
      ((hΔKc.comp (continuous_const.sub continuous_id)).mul hg.continuous) ?_
    refine HasCompactSupport.intro (isCompact_closedBall x 1) (fun y hy => ?_)
    rw [Metric.mem_closedBall, not_le, dist_eq_norm, norm_sub_rev] at hy
    show Δ K (x - y) * g y = 0
    rw [hP1 _ hy, zero_mul]

  have hmain : ∀ ε : ℝ, 0 < ε → ε ≤ 1 →
      |(∫ y, (newtonKernel (x - y) - K (x - y)) * Δ g y) + (∫ y, Δ K (x - y) * g y) + g x|
        ≤ ε * (M₂ / 2 + M₁ * C) := by
    intro ε hε hε1
    obtain ⟨Kε, hKε⟩ : ∃ Kε : ℝ³ → ℝ, Kε = fun w => ε⁻¹ * K (ε⁻¹ • w) := ⟨_, rfl⟩
    have hKεs : ContDiff ℝ ∞ Kε := by
      rw [hKε, hK]; exact (scaled_far_kernel ε hε).1
    have hKεb : ∀ z : ℝ³, 0 ≤ Kε z ∧ Kε z ≤ newtonKernel z := by
      rw [hKε, hK]; exact (scaled_far_kernel ε hε).2.1
    have hKεt : ∀ z : ℝ³, ε ≤ ‖z‖ → Kε z = newtonKernel z := by
      rw [hKε, hK]; exact (scaled_far_kernel ε hε).2.2
    have hFs : ContDiff ℝ ∞ (fun z => K z - Kε z) := hKs.sub hKεs
    have hF0 : ∀ z : ℝ³, 1 ≤ ‖z‖ → (fun z => K z - Kε z) z = 0 := by
      intro z hz
      show K z - Kε z = 0
      rw [hK1 z hz, hKεt z (le_trans hε1 hz), sub_self]
    have hL1 := laplacian_ibp_shift (fun z => K z - Kε z) g x 1 hFs hg hF0
    have hΔF : ∀ w, Δ (fun z => K z - Kε z) w = Δ K w - (ε ^ 3)⁻¹ * Δ K (ε⁻¹ • w) := by
      intro w
      have e : (fun z => K z - Kε z) = K - Kε := rfl
      rw [e, ContDiffAt.laplacian_sub (hKs.contDiffAt.of_le h2) (hKεs.contDiffAt.of_le h2), hKε,
        laplacian_rescale K ε hKs hε.ne' w]
    have hMε : ∀ y ∈ Metric.closedBall x ε, |Δ g y| ≤ M₂ := fun y hy =>
      hM₂' y (Metric.closedBall_subset_closedBall hε1 hy)
    obtain ⟨hIb, hAb⟩ := truncated_newton_bound (fun z => newtonKernel z - Kε z) (Δ g) x ε M₂ hε
      (hNKm.sub hKεs.continuous.measurable)
      (fun z => ⟨by linarith [(hKεb z).2], by linarith [(hKεb z).1]⟩)
      (fun z hz => by show newtonKernel z - Kε z = 0; rw [hKεt z hz, sub_self])
      (hcontΔ g hg) hMε
    obtain ⟨hIe, hBb⟩ :=
      scaled_kernel_limit (Δ K) g x ε M₁ hΔKc hP1 (hg.of_le (by simp)) hε hε1 hM₁
    have e1 : ∫ y, (fun z => K z - Kε z) (x - y) * Δ g y
        = (∫ y, (newtonKernel (x - y) - Kε (x - y)) * Δ g y)
          - ∫ y, (newtonKernel (x - y) - K (x - y)) * Δ g y := by
      rw [← integral_sub hIb hIa]
      congr 1
      funext y
      show (K (x - y) - Kε (x - y)) * Δ g y = _
      ring
    have e2 : ∫ y, Δ (fun z => K z - Kε z) (x - y) * g y
        = (∫ y, Δ K (x - y) * g y) - ∫ y, (ε ^ 3)⁻¹ * Δ K (ε⁻¹ • (x - y)) * g y := by
      rw [← integral_sub hId hIe]
      congr 1
      funext y
      rw [hΔF]
      ring
    have key : (∫ y, (newtonKernel (x - y) - Kε (x - y)) * Δ g y)
          - (∫ y, (newtonKernel (x - y) - K (x - y)) * Δ g y)
        = (∫ y, Δ K (x - y) * g y) - ∫ y, (ε ^ 3)⁻¹ * Δ K (ε⁻¹ • (x - y)) * g y := by
      rw [← e1, ← e2]
      exact hL1
    have hBb' : |(∫ y, (ε ^ 3)⁻¹ * Δ K (ε⁻¹ • (x - y)) * g y) + g x| ≤ ε * M₁ * C := by
      have h := hBb
      rw [hP2, ← hC] at h
      rwa [neg_one_mul, sub_neg_eq_add] at h
    have hsplit : (∫ y, (newtonKernel (x - y) - K (x - y)) * Δ g y) + (∫ y, Δ K (x - y) * g y)
          + g x
        = (∫ y, (newtonKernel (x - y) - Kε (x - y)) * Δ g y)
          + ((∫ y, (ε ^ 3)⁻¹ * Δ K (ε⁻¹ • (x - y)) * g y) + g x) := by
      linarith
    have hε2 : M₂ * (ε ^ 2 / 2) ≤ ε * (M₂ / 2) := by
      nlinarith [mul_nonneg (mul_nonneg hM₂0 hε.le) (sub_nonneg.mpr hε1)]
    rw [hsplit]
    calc _ ≤ |∫ y, (newtonKernel (x - y) - Kε (x - y)) * Δ g y|
          + |(∫ y, (ε ^ 3)⁻¹ * Δ K (ε⁻¹ • (x - y)) * g y) + g x| := abs_add_le _ _
      _ ≤ M₂ * (ε ^ 2 / 2) + ε * M₁ * C := add_le_add hAb hBb'
      _ ≤ ε * (M₂ / 2 + M₁ * C) := by nlinarith

  obtain ⟨Q, hQ⟩ : ∃ Q : ℝ, Q = M₂ / 2 + M₁ * C := ⟨_, rfl⟩
  have hQ0 : 0 ≤ Q := by
    rw [hQ]
    have := mul_nonneg hM₁0 hC0
    linarith
  rw [← hQ] at hmain
  obtain ⟨D, hD⟩ : ∃ D : ℝ,
      D = |(∫ y, (newtonKernel (x - y) - K (x - y)) * Δ g y) + (∫ y, Δ K (x - y) * g y) + g x| :=
    ⟨_, rfl⟩
  rw [← hD] at hmain
  have hD0 : D = 0 := by
    by_contra hne
    have hDpos : 0 < D := lt_of_le_of_ne (by rw [hD]; exact abs_nonneg _) (Ne.symm hne)
    have hpos : 0 < D / (2 * (Q + 1)) := by positivity
    have hεpos : 0 < min 1 (D / (2 * (Q + 1))) := lt_min one_pos hpos
    have h1 := hmain _ hεpos (min_le_left _ _)
    have h2' : min 1 (D / (2 * (Q + 1))) * Q ≤ D / (2 * (Q + 1)) * Q :=
      mul_le_mul_of_nonneg_right (min_le_right _ _) hQ0
    have h3 : D / (2 * (Q + 1)) * Q < D := by
      rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
      nlinarith
    linarith
  rw [hD] at hD0
  have := abs_eq_zero.mp hD0
  linarith

theorem stress_pressure_laplacian : ∀ (G : Fin 3 → Fin 3 → ℝ³ → ℝ), (∀ k l, ContDiff ℝ ∞ (G k l) ∧ Integrable (G k l)) → ContDiff ℝ ∞ (stressPressure G) ∧ ∀ x, Δ (stressPressure G) x = - ∑ k, ∑ l, pd k (pd l (G k l)) x :=
by
  intro G hG
  have h2 : (2 : WithTop ℕ∞) ≤ ∞ := by simp
  obtain ⟨hKs, hK1, -, hKd⟩ := far_kernel_basic
  set K : ℝ³ → ℝ := fun z => Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z with hKdef
  set Kn : ℝ³ → ℝ := fun z => newtonKernel z - K z with hKndef

  have hKn0 : ∀ z : ℝ³, 1 ≤ ‖z‖ → Kn z = 0 := by
    intro z hz
    show newtonKernel z - K z = 0
    rw [show K z = newtonKernel z from hK1 z hz, sub_self]
  have hKcont : Continuous K := hKs.continuous
  have hKnInt : Integrable Kn := by
    have hΓ : IntegrableOn newtonKernel (Metric.ball (0 : ℝ³) 1) :=
      (newton_kernel_ball_integral 1 one_pos).1
    have hKon : IntegrableOn K (Metric.ball (0 : ℝ³) 1) :=
      (hKcont.continuousOn.integrableOn_compact (isCompact_closedBall (0 : ℝ³) 1)).mono_set
        Metric.ball_subset_closedBall
    have hsub : IntegrableOn Kn (Metric.ball (0 : ℝ³) 1) := hΓ.sub hKon
    refine (integrableOn_iff_integrable_of_support_subset ?_).mp hsub
    intro z hz
    rw [Function.mem_support] at hz
    rw [mem_ball_zero_iff]
    by_contra hc
    exact hz (hKn0 z (not_lt.mp hc))

  have hNewton : ∀ g : ℝ³ → ℝ, ContDiff ℝ ∞ g → Integrable g →
      ContDiff ℝ ∞ (newtonPot g) ∧ ∀ x, Δ (newtonPot g) x = - g x := by
    intro g hg hgi
    obtain ⟨hFarInt, hFarS, hFarΔ⟩ := conv_bounded_deriv_kernel g K hgi hKs hKd
    have hloc : ∀ x₀ : ℝ³, ∃ H : ℝ³ → ℝ, ContDiff ℝ ∞ H ∧ newtonPot g =ᶠ[nhds x₀] H ∧
        Δ H x₀ = - g x₀ := by
      intro x₀
      obtain ⟨η, hη⟩ : ∃ η : ContDiffBump x₀, η.rIn = 2 :=
        ⟨⟨2, 3, by norm_num, by norm_num⟩, rfl⟩
      have hη1 : ∀ y ∈ Metric.ball x₀ 2, η y = 1 := fun y hy =>
        η.one_of_mem_closedBall (by rw [hη]; exact Metric.ball_subset_closedBall hy)
      set h : ℝ³ → ℝ := fun y => η y * g y with hhdef
      have hh : ContDiff ℝ ∞ h := η.contDiff.mul hg
      have hhc : HasCompactSupport h := η.hasCompactSupport.mul_right (f' := g)
      have hhd : ∀ n : ℕ, ∃ C : ℝ, ∀ z, ‖iteratedFDeriv ℝ n h z‖ ≤ C := fun n =>
        (hh.continuous_iteratedFDeriv (m := n) (by exact_mod_cast le_top)).bounded_above_of_compact_support
          (hhc.iteratedFDeriv n)
      obtain ⟨hNearInt, hNearS, hNearΔ⟩ := conv_bounded_deriv_kernel Kn h hKnInt hh hhd
      have hagree : ∀ x ∈ Metric.ball x₀ 1, ∀ t : ℝ³, Kn t * h (x - t) = Kn t * g (x - t) := by
        intro x hx t
        by_cases ht : 1 ≤ ‖t‖
        · rw [hKn0 t ht, zero_mul, zero_mul]
        · push_neg at ht
          have hmem : x - t ∈ Metric.ball x₀ 2 := by
            rw [Metric.mem_ball, dist_eq_norm] at hx ⊢
            calc ‖x - t - x₀‖ = ‖(x - x₀) - t‖ := by congr 1; abel
              _ ≤ ‖x - x₀‖ + ‖t‖ := norm_sub_le _ _
              _ < 2 := by linarith
          show Kn t * (η (x - t) * g (x - t)) = Kn t * g (x - t)
          rw [hη1 _ hmem, one_mul]
      refine ⟨(fun x => ∫ t, Kn t * h (x - t)) + (fun x => ∫ t, g t * K (x - t)),
        hNearS.add hFarS, ?_, ?_⟩
      · refine Filter.eventually_of_mem (Metric.ball_mem_nhds x₀ one_pos) (fun x hx => ?_)
        show newtonPot g x = (∫ t, Kn t * h (x - t)) + ∫ t, g t * K (x - t)
        have e1 : newtonPot g x = ∫ t, newtonKernel t * g (x - t) := by
          have := integral_sub_left_eq_self (fun t => newtonKernel t * g (x - t))
            (volume : Measure ℝ³) x
          simp only [sub_sub_cancel] at this
          exact this
        have e2 : (∫ t, g t * K (x - t)) = ∫ t, g (x - t) * K t := by
          have := integral_sub_left_eq_self (fun t => g t * K (x - t)) (volume : Measure ℝ³) x
          simp only [sub_sub_cancel] at this
          exact this.symm
        have hI2 : Integrable (fun t => g (x - t) * K t) := by
          have := (hFarInt x).comp_sub_left x
          simp only [sub_sub_cancel] at this
          exact this
        rw [e1, e2, ← integral_add (hNearInt x) hI2]
        congr 1
        funext t
        rw [hagree x hx t]
        show newtonKernel t * g (x - t) = (newtonKernel t - K t) * g (x - t) + g (x - t) * K t
        ring
      · rw [ContDiffAt.laplacian_add (hNearS.contDiffAt.of_le h2) (hFarS.contDiffAt.of_le h2),
          hNearΔ x₀, hFarΔ x₀]
        have e3 : (∫ t, Kn t * Δ h (x₀ - t)) = ∫ y, Kn (x₀ - y) * Δ g y := by
          have e4 : (∫ t, Kn t * Δ h (x₀ - t)) = ∫ t, Kn t * Δ g (x₀ - t) := by
            congr 1
            funext t
            by_cases ht : 1 ≤ ‖t‖
            · rw [hKn0 t ht, zero_mul, zero_mul]
            · push_neg at ht
              have hmem : x₀ - t ∈ Metric.ball x₀ 2 := by
                rw [Metric.mem_ball, dist_eq_norm, sub_sub_cancel_left, norm_neg]
                linarith
              have hev : h =ᶠ[nhds (x₀ - t)] g :=
                Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hmem) (fun y hy => by
                  show η y * g y = g y
                  rw [hη1 y hy, one_mul])
              rw [(laplacian_congr_nhds hev).eq_of_nhds]
          rw [e4]
          have := integral_sub_left_eq_self (fun t => Kn t * Δ g (x₀ - t)) (volume : Measure ℝ³) x₀
          simp only [sub_sub_cancel] at this
          exact this.symm
        have e5 : (∫ t, g t * Δ K (x₀ - t)) = ∫ y, Δ K (x₀ - y) * g y := by
          congr 1
          funext t
          ring
        rw [e3, e5]
        exact green_local g hg x₀
    refine ⟨contDiff_iff_contDiffAt.mpr (fun x₀ => ?_), fun x₀ => ?_⟩
    · obtain ⟨H, hH, heq, -⟩ := hloc x₀
      exact hH.contDiffAt.congr_of_eventuallyEq heq
    · obtain ⟨H, -, heq, hΔ⟩ := hloc x₀
      rw [(laplacian_congr_nhds heq).eq_of_nhds, hΔ]

  have hcdpd : ∀ (j : Fin 3) (f : ℝ³ → ℝ), ContDiff ℝ ∞ f → ContDiff ℝ ∞ (pd j f) := by
    intro j f hf
    show ContDiff ℝ ∞ (fun y => fderiv ℝ f y (EuclideanSpace.single j 1))
    exact (contDiff_infty_iff_fderiv.mp hf).2.clm_apply contDiff_const
  have hpdneg : ∀ (j : Fin 3) (f : ℝ³ → ℝ), pd j (fun y => - f y) = fun y => - pd j f y := by
    intro j f
    funext y
    simp only [pd, fderiv_fun_neg, ContinuousLinearMap.neg_apply]
  have hΔsum : ∀ {ι : Type} (s : Finset ι) (f : ι → ℝ³ → ℝ), (∀ i, ContDiff ℝ ∞ (f i)) →
      ∀ x, Δ (fun y => ∑ i ∈ s, f i y) x = ∑ i ∈ s, Δ (f i) x := by
    intro ι s f hf x
    classical
    induction s using Finset.induction_on with
    | empty => simp only [Finset.sum_empty, laplacian_const, Pi.zero_apply]
    | insert a s ha ih =>
      have e : (fun y => ∑ i ∈ insert a s, f i y) = f a + fun y => ∑ i ∈ s, f i y := by
        funext y
        simp only [Finset.sum_insert ha, Pi.add_apply]
      rw [e, ContDiffAt.laplacian_add ((hf a).contDiffAt.of_le h2)
        ((ContDiff.sum (fun i _ => hf i)).contDiffAt.of_le h2), ih, Finset.sum_insert ha]
  have hN : ∀ k l, ContDiff ℝ ∞ (newtonPot (G k l)) ∧ ∀ x, Δ (newtonPot (G k l)) x = - G k l x :=
    fun k l => hNewton (G k l) (hG k l).1 (hG k l).2
  have hentry : ∀ i j x, Δ (pd i (pd j (newtonPot (G i j)))) x = - pd i (pd j (G i j)) x := by
    intro i j x
    obtain ⟨hNs, hNΔ⟩ := hN i j
    rw [laplacian_pd_comm (pd j (newtonPot (G i j))) (hcdpd j _ hNs) i x]
    have e1 : Δ (pd j (newtonPot (G i j))) = pd j (Δ (newtonPot (G i j))) :=
      funext (laplacian_pd_comm _ hNs j)
    have e2 : Δ (newtonPot (G i j)) = fun y => - G i j y := funext hNΔ
    rw [e1, e2, hpdneg j, hpdneg i]
  have hrowS : ∀ i, ContDiff ℝ ∞ (fun y => ∑ j, pd i (pd j (newtonPot (G i j))) y) :=
    fun i => ContDiff.sum (fun j _ => hcdpd i _ (hcdpd j _ (hN i j).1))
  refine ⟨?_, fun x => ?_⟩
  · show ContDiff ℝ ∞ (fun x => ∑ i, ∑ j, pd i (pd j (newtonPot (G i j))) x)
    exact ContDiff.sum (fun i _ => hrowS i)
  · have h1 : Δ (stressPressure G) x
        = ∑ i, Δ (fun y => ∑ j, pd i (pd j (newtonPot (G i j))) y) x :=
      hΔsum Finset.univ (fun i y => ∑ j, pd i (pd j (newtonPot (G i j))) y) hrowS x
    rw [h1, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    have hrow : Δ (fun y => ∑ j, pd i (pd j (newtonPot (G i j))) y) x
        = ∑ j, Δ (pd i (pd j (newtonPot (G i j)))) x :=
      hΔsum Finset.univ (fun j => pd i (pd j (newtonPot (G i j))))
        (fun j => hcdpd i _ (hcdpd j _ (hN i j).1)) x
    rw [hrow, ← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl (fun j _ => hentry i j x)

theorem pressure_laplacian_of_conservative_eq : ∀ (ν T₁ : ℝ) (w : ℝ³ → ℝ → ℝ³) (π : ℝ³ → ℝ → ℝ) (g : Fin 3 → Fin 3 → ℝ³ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿w) (univ ×ˢ Icc 0 T₁) → ContDiffOn ℝ ∞ (↿π) (univ ×ˢ Icc 0 T₁) → (∀ i j, ContDiffOn ℝ ∞ (↿(g i j)) (univ ×ˢ Icc 0 T₁)) → (∀ x t, t ∈ Ioo 0 T₁ → ∀ i : Fin 3, deriv (fun s => w x s i) t + ∑ j, pd j (fun y => g i j y t) x = ν * (Δ (fun y => w y t) x) i - pd i (fun y => π y t) x) → (∀ x t, t ∈ Icc 0 T₁ → divergence (fun y => w y t) x = 0) → ∀ x t, t ∈ Ioo 0 T₁ → Δ (fun y => π y t) x = - ∑ i, ∑ j, pd i (pd j (fun y => g i j y t)) x :=
by
  intro ν T₁ w π g hw hπ hg hEQ hdiv x t ht
  have h2 : (2 : WithTop ℕ∞) ≤ ∞ := by simp
  have htI : t ∈ Icc 0 T₁ := ⟨ht.1.le, ht.2.le⟩
  have slice : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (G : ℝ³ → ℝ → F)
      (S : Set ℝ) (t : ℝ), ContDiffOn ℝ ∞ (↿G) (univ ×ˢ S) → t ∈ S →
      ContDiff ℝ ∞ (fun y => G y t) := by
    intro F _ _ G S t hG ht
    have h1 : ContDiff ℝ ∞ (fun y : ℝ³ => (y, t)) := contDiff_id.prodMk contDiff_const
    exact contDiffOn_univ.mp (hG.comp h1.contDiffOn (fun y _ => ⟨mem_univ _, ht⟩))
  have hcomp : ∀ i : Fin 3, ContDiffOn ℝ ∞ (↿(fun y s => w y s i)) (univ ×ˢ Icc 0 T₁) :=
    fun i => (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).contDiff.comp_contDiffOn hw
  have hcdpd : ∀ (j : Fin 3) (f : ℝ³ → ℝ), ContDiff ℝ ∞ f → ContDiff ℝ ∞ (pd j f) := by
    intro j f hf
    show ContDiff ℝ ∞ (fun y => fderiv ℝ f y (EuclideanSpace.single j 1))
    exact (contDiff_infty_iff_fderiv.mp hf).2.clm_apply contDiff_const

  have hlap : ∀ f : ℝ³ → ℝ, ContDiff ℝ ∞ f → ∀ y, Δ f y = ∑ i, pd i (pd i f) y := by
    intro f hf y
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis f
      (EuclideanSpace.basisFun (Fin 3) ℝ)]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [iteratedFDeriv_two_apply, EuclideanSpace.basisFun_apply]
    have hfd : Differentiable ℝ (fderiv ℝ f) :=
      (contDiff_infty_iff_fderiv.mp hf).2.differentiable (by simp)
    show _ = fderiv ℝ (fun z => fderiv ℝ f z (EuclideanSpace.single i 1)) y
      (EuclideanSpace.single i 1)
    rw [fderiv_clm_apply (c := fderiv ℝ f) (u := fun _ => EuclideanSpace.single i (1:ℝ))
      (hfd y) (differentiableAt_const _)]
    simp

  have hpd2 : ∀ f : ℝ³ → ℝ, ContDiff ℝ ∞ f → ∀ (a b : Fin 3) (y : ℝ³),
      pd a (pd b f) y = fderiv ℝ (fderiv ℝ f) y (EuclideanSpace.single a 1)
        (EuclideanSpace.single b 1) := by
    intro f hf a b y
    have hfd : Differentiable ℝ (fderiv ℝ f) :=
      (contDiff_infty_iff_fderiv.mp hf).2.differentiable (by simp)
    show fderiv ℝ (fun z => fderiv ℝ f z (EuclideanSpace.single b 1)) y
      (EuclideanSpace.single a 1) = _
    rw [fderiv_clm_apply (c := fderiv ℝ f) (u := fun _ => EuclideanSpace.single b (1:ℝ))
      (hfd y) (differentiableAt_const _)]
    simp
  have hcomm : ∀ f : ℝ³ → ℝ, ContDiff ℝ ∞ f → ∀ (a b : Fin 3), pd a (pd b f) = pd b (pd a f) := by
    intro f hf a b
    funext y
    rw [hpd2 f hf a b y, hpd2 f hf b a y]
    exact (hf.contDiffAt.isSymmSndFDerivAt (by simp [minSmoothness_of_isRCLikeNormedField])) _ _
  have hpdlap : ∀ f : ℝ³ → ℝ, ContDiff ℝ ∞ f → ∀ i : Fin 3, pd i (Δ f) x = Δ (pd i f) x := by
    intro f hf i
    rw [hlap (pd i f) (hcdpd i f hf) x]
    have hΔ : Δ f = fun y => ∑ k, pd k (pd k f) y := funext (hlap f hf)
    rw [hΔ]
    show fderiv ℝ (fun y => ∑ k, pd k (pd k f) y) x (EuclideanSpace.single i 1) = _
    rw [fderiv_fun_sum (fun k _ => (hcdpd k _ (hcdpd k f hf)).differentiable (by simp) x),
      ContinuousLinearMap.sum_apply]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    show pd i (pd k (pd k f)) x = pd k (pd k (pd i f)) x
    rw [hcomm (pd k f) (hcdpd k f hf) i k, hcomm f hf i k]

  have hdivsum : ∀ (v : ℝ³ → ℝ³) (y : ℝ³), DifferentiableAt ℝ v y →
      divergence v y = ∑ i, pd i (fun z => v z i) y := by
    intro v y hv
    unfold divergence
    rw [LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin 3) ℝ)]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [EuclideanSpace.basisFun_apply, EuclideanSpace.inner_single_left]
    have : fderiv ℝ (fun z => v z i) y
        = (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).comp (fderiv ℝ v y) :=
      ((EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).hasFDerivAt.comp y hv.hasFDerivAt).fderiv
    simp [pd, this]

  have hU : IsOpen ((univ : Set ℝ³) ×ˢ Ioo 0 T₁) := isOpen_univ.prod isOpen_Ioo
  have hsub : (univ : Set ℝ³) ×ˢ Ioo 0 T₁ ⊆ univ ×ˢ Icc 0 T₁ :=
    prod_mono subset_rfl Ioo_subset_Icc_self
  have htime : ∀ (F : ℝ³ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿F) (univ ×ˢ Ioo 0 T₁) → ∀ i : Fin 3,
      DifferentiableAt ℝ (fun y => deriv (fun s => F y s) t) x ∧
      HasDerivAt (fun s => pd i (fun y => F y s) x)
        (pd i (fun y => deriv (fun s => F y s) t) x) t := by
    intro F hF i
    have hFat : ∀ y, ∀ s ∈ Ioo 0 T₁, ContDiffAt ℝ ∞ (↿F) (y, s) := fun y s hs =>
      hF.contDiffAt (hU.mem_nhds ⟨mem_univ _, hs⟩)
    have hFd : ∀ y, ∀ s ∈ Ioo 0 T₁, HasFDerivAt (↿F) (fderiv ℝ (↿F) (y, s)) (y, s) :=
      fun y s hs => ((hFat y s hs).differentiableAt (by simp)).hasFDerivAt
    have hDd : DifferentiableAt ℝ (fderiv ℝ (↿F)) (x, t) :=
      ((hFat x t ht).fderiv_right (m := 1) (by simp)).differentiableAt (by simp)
    have hT : ∀ y, deriv (fun s => F y s) t = fderiv ℝ (↿F) (y, t) ((0 : ℝ³), (1 : ℝ)) := by
      intro y
      have h1 : HasDerivAt (fun s : ℝ => (y, s)) ((0 : ℝ³), (1 : ℝ)) t :=
        (hasDerivAt_const t y).prodMk (hasDerivAt_id t)
      exact ((hFd y t ht).comp_hasDerivAt t h1).deriv
    have hTfun : (fun y => deriv (fun s => F y s) t)
        = fun y => fderiv ℝ (↿F) (y, t) ((0 : ℝ³), (1 : ℝ)) := funext hT
    have hDt : HasFDerivAt (fun y => fderiv ℝ (↿F) (y, t))
        ((fderiv ℝ (fderiv ℝ (↿F)) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ)) x :=
      hDd.hasFDerivAt.comp x (hasFDerivAt_prodMk_left x t)
    have hA : HasFDerivAt (fun y => fderiv ℝ (↿F) (y, t) ((0 : ℝ³), (1 : ℝ)))
        ((ContinuousLinearMap.apply ℝ ℝ ((0 : ℝ³), (1 : ℝ))).comp
          ((fderiv ℝ (fderiv ℝ (↿F)) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ))) x :=
      (ContinuousLinearMap.apply ℝ ℝ ((0 : ℝ³), (1 : ℝ))).hasFDerivAt.comp x hDt
    have hpdT : pd i (fun y => deriv (fun s => F y s) t) x
        = fderiv ℝ (fderiv ℝ (↿F)) (x, t) (EuclideanSpace.single i 1, 0)
            ((0 : ℝ³), (1 : ℝ)) := by
      unfold pd
      rw [hTfun, hA.fderiv]
      simp
    have hpdS : ∀ s ∈ Ioo 0 T₁, pd i (fun y => F y s) x
        = fderiv ℝ (↿F) (x, s) (EuclideanSpace.single i 1, 0) := by
      intro s hs
      have h1' : HasFDerivAt (fun y => F y s)
          ((fderiv ℝ (↿F) (x, s)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ)) x :=
        (by
          have h0 : HasFDerivAt (↿F) (fderiv ℝ (↿F) (x, s)) (x, s) := hFd x s hs
          have h1 := h0.comp x (hasFDerivAt_prodMk_left (𝕜 := ℝ) x s)
          exact h1)
      unfold pd
      rw [h1'.fderiv]
      simp
    have hDs : HasDerivAt (fun s => fderiv ℝ (↿F) (x, s))
        (fderiv ℝ (fderiv ℝ (↿F)) (x, t) ((0 : ℝ³), (1 : ℝ))) t := by
      have h1 : HasDerivAt (fun s : ℝ => (x, s)) ((0 : ℝ³), (1 : ℝ)) t :=
        (hasDerivAt_const t x).prodMk (hasDerivAt_id t)
      exact hDd.hasFDerivAt.comp_hasDerivAt t h1
    have hDs2 : HasDerivAt (fun s => fderiv ℝ (↿F) (x, s) (EuclideanSpace.single i 1, 0))
        (fderiv ℝ (fderiv ℝ (↿F)) (x, t) ((0 : ℝ³), (1 : ℝ))
          (EuclideanSpace.single i 1, 0)) t :=
      (ContinuousLinearMap.apply ℝ ℝ ((EuclideanSpace.single i 1 : ℝ³), (0:ℝ))).hasFDerivAt.comp_hasDerivAt
        t hDs
    have hsymm : fderiv ℝ (fderiv ℝ (↿F)) (x, t) (EuclideanSpace.single i 1, 0)
          ((0 : ℝ³), (1 : ℝ))
        = fderiv ℝ (fderiv ℝ (↿F)) (x, t) ((0 : ℝ³), (1 : ℝ))
          (EuclideanSpace.single i 1, 0) :=
      ((hFat x t ht).isSymmSndFDerivAt (by simp [minSmoothness_of_isRCLikeNormedField]))
        (EuclideanSpace.single i 1, 0) ((0 : ℝ³), (1 : ℝ))
    refine ⟨?_, ?_⟩
    · rw [hTfun]; exact hA.differentiableAt
    · rw [hpdT, hsymm]
      refine hDs2.congr_of_eventuallyEq ?_
      filter_upwards [Ioo_mem_nhds ht.1 ht.2] with s hs
      exact hpdS s hs

  have hTsum : ∑ i, pd i (fun y => deriv (fun s => w y s i) t) x = 0 := by
    have hφ : HasDerivAt (fun s => ∑ i, pd i (fun y => w y s i) x)
        (∑ i, pd i (fun y => deriv (fun s => w y s i) t) x) t :=
      HasDerivAt.fun_sum (fun i _ => (htime (fun y s => w y s i) ((hcomp i).mono hsub) i).2)
    have hφ0 : HasDerivAt (fun s => ∑ i, pd i (fun y => w y s i) x) 0 t := by
      refine (hasDerivAt_const t (0:ℝ)).congr_of_eventuallyEq ?_
      filter_upwards [Ioo_mem_nhds ht.1 ht.2] with s hs
      have hsI : s ∈ Icc 0 T₁ := ⟨hs.1.le, hs.2.le⟩
      rw [← hdivsum _ x ((slice w _ s hw hsI).differentiable (by simp) x)]
      exact hdiv x s hsI
    exact hφ.unique hφ0

  have hwt : ContDiff ℝ ∞ (fun y => w y t) := slice w _ t hw htI
  have hwti : ∀ i : Fin 3, ContDiff ℝ ∞ (fun y => w y t i) := fun i =>
    (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).contDiff.comp hwt
  have hV : ∀ i : Fin 3, (fun y => (Δ (fun z => w z t) y) i) = Δ (fun y => w y t i) := by
    intro i
    funext y
    exact (ContDiffAt.laplacian_CLM_comp_left (l := (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ))
      (hwt.contDiffAt.of_le h2)).symm
  have lap3 : ∀ a b c : ℝ³ → ℝ, ContDiff ℝ ∞ a → ContDiff ℝ ∞ b → ContDiff ℝ ∞ c →
      (∀ y, a y + b y + c y = 0) → Δ a x + Δ b x + Δ c x = 0 := by
    intro a b c ha hb hc habc
    have hf : a + b + c = fun _ => (0:ℝ) := funext (fun y => habc y)
    have := congrFun (InnerProductSpace.laplacian_const (E := ℝ³) (c := (0:ℝ))) x
    rw [← hf, ContDiffAt.laplacian_add (f₁ := a + b) (f₂ := c)
      ((ha.add hb).contDiffAt.of_le h2) (hc.contDiffAt.of_le h2),
      ContDiffAt.laplacian_add (f₁ := a) (f₂ := b)
      (ha.contDiffAt.of_le h2) (hb.contDiffAt.of_le h2)] at this
    simpa using this
  have hVsum : ∑ i, pd i (fun y => (Δ (fun z => w z t) y) i) x = 0 := by
    rw [Fin.sum_univ_three, hV 0, hV 1, hV 2, hpdlap _ (hwti 0) 0,
      hpdlap _ (hwti 1) 1, hpdlap _ (hwti 2) 2]
    refine lap3 _ _ _ (hcdpd 0 _ (hwti 0)) (hcdpd 1 _ (hwti 1)) (hcdpd 2 _ (hwti 2))
      (fun y => ?_)
    have := hdivsum _ y (hwt.differentiable (by simp) y)
    rw [hdiv y t htI, Fin.sum_univ_three] at this
    linarith

  have hGt : ∀ i j, ContDiff ℝ ∞ (fun y => g i j y t) := fun i j => slice (g i j) _ t (hg i j) htI
  have hπt : ContDiff ℝ ∞ (fun y => π y t) := slice π _ t hπ htI
  have hstar : ∀ i : Fin 3, pd i (fun y => deriv (fun s => w y s i) t) x
      + ∑ j, pd i (pd j (fun y => g i j y t)) x
      - ν * pd i (fun y => (Δ (fun z => w z t) y) i) x + pd i (pd i (fun y => π y t)) x = 0 := by
    intro i
    have hE : (fun y => deriv (fun s => w y s i) t + ∑ j, pd j (fun y => g i j y t) y
        - ν * (Δ (fun z => w z t) y) i + pd i (fun y => π y t) y) = fun _ => (0:ℝ) := by
      funext y
      have := hEQ y t ht i
      linarith
    have hd1 : DifferentiableAt ℝ (fun y => deriv (fun s => w y s i) t) x :=
      (htime (fun y s => w y s i) ((hcomp i).mono hsub) i).1
    have hd2 : DifferentiableAt ℝ (fun y => ∑ j, pd j (fun y => g i j y t) y) x :=
      (ContDiff.sum (fun j _ => hcdpd j _ (hGt i j))).differentiable (by simp) x
    have hd3 : DifferentiableAt ℝ (fun y => (Δ (fun z => w z t) y) i) x := by
      rw [hV i, show Δ (fun y => w y t i) = fun y => ∑ k, pd k (pd k (fun y => w y t i)) y
        from funext (hlap _ (hwti i))]
      exact (ContDiff.sum (fun k _ => hcdpd k _ (hcdpd k _ (hwti i)))).differentiable (by simp) x
    have hd4 : DifferentiableAt ℝ (pd i (fun y => π y t)) x :=
      (hcdpd i _ hπt).differentiable (by simp) x
    have hH : HasFDerivAt (fun y => deriv (fun s => w y s i) t + ∑ j, pd j (fun y => g i j y t) y
        - ν * (Δ (fun z => w z t) y) i + pd i (fun y => π y t) y)
        (fderiv ℝ (fun y => deriv (fun s => w y s i) t) x
          + fderiv ℝ (fun y => ∑ j, pd j (fun y => g i j y t) y) x
          - ν • fderiv ℝ (fun y => (Δ (fun z => w z t) y) i) x
          + fderiv ℝ (pd i (fun y => π y t)) x) x :=
      ((hd1.hasFDerivAt.add hd2.hasFDerivAt).sub (hd3.hasFDerivAt.const_mul ν)).add hd4.hasFDerivAt
    rw [hE] at hH
    have hz := hH.unique (hasFDerivAt_const (0:ℝ) x)
    have hz2 := congrArg (fun L : ℝ³ →L[ℝ] ℝ => L (EuclideanSpace.single i 1)) hz
    rw [fderiv_fun_sum (fun j _ => (hcdpd j _ (hGt i j)).differentiable (by simp) x)] at hz2
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul, ContinuousLinearMap.zero_apply,
      ContinuousLinearMap.sum_apply] at hz2
    exact hz2

  rw [hlap _ hπt x]
  have s0 := hstar 0
  have s1 := hstar 1
  have s2 := hstar 2
  rw [Fin.sum_univ_three] at hTsum hVsum
  simp only [Fin.sum_univ_three] at s0 s1 s2 ⊢
  linear_combination s0 + s1 + s2 - hTsum + ν * hVsum

theorem mean_value_kernel_exists : ∃ ρ : ℝ³ → ℝ, ContDiff ℝ ∞ ρ ∧ (∀ z : ℝ³, 1 ≤ ‖z‖ → ρ z = 0) ∧ ∀ F : ℝ³ → ℝ, ContDiff ℝ ∞ F → (∀ y, Δ F y = 0) → ∀ (x : ℝ³) (L : ℝ), 0 < L → ∫ u, ρ u * F (x + L • u) = F x :=
by
  have s2 : ∀ (ψ : ℝ → ℝ), ContDiff ℝ ∞ ψ → (∀ s : ℝ, 1 ≤ s → ψ s = 0) → ∀ F : ℝ³ → ℝ, ContDiff ℝ ∞ F → (∀ y, Δ F y = 0) → ∀ (x : ℝ³) (L : ℝ), ∫ u, 2 * deriv ψ (‖u‖ ^ 2) * fderiv ℝ F (x + L • u) u = 0 := by
    intro ψ hψ hψ1 F hF hΔ x L
    have hψd : Differentiable ℝ ψ := hψ.differentiable (by simp)
    have hΨs : ContDiff ℝ ∞ (fun u : ℝ³ => ψ (‖u‖ ^ 2)) := hψ.comp (contDiff_norm_sq ℝ)
    have hΨcs : HasCompactSupport (fun u : ℝ³ => ψ (‖u‖ ^ 2)) := by
      refine HasCompactSupport.intro (isCompact_closedBall (0:ℝ³) 1) (fun z hz => hψ1 _ ?_)
      rw [Metric.mem_closedBall, dist_zero_right, not_le] at hz
      exact one_le_pow₀ hz.le
    have hΨd : Differentiable ℝ (fun u : ℝ³ => ψ (‖u‖ ^ 2)) := hΨs.differentiable (by simp)
    have hgrad : ∀ (u : ℝ³) (k : Fin 3), fderiv ℝ (fun u : ℝ³ => ψ (‖u‖ ^ 2)) u (EuclideanSpace.single k 1) = 2 * deriv ψ (‖u‖ ^ 2) * u k := by
      intro u k
      have h1 : HasFDerivAt (fun u : ℝ³ => ψ (‖u‖ ^ 2)) (deriv ψ (‖u‖ ^ 2) • (2 • innerSL ℝ u)) u :=
        (hψd (‖u‖ ^ 2)).hasDerivAt.comp_hasFDerivAt u (hasStrictFDerivAt_norm_sq u).hasFDerivAt
      rw [h1.fderiv]
      simp [EuclideanSpace.inner_single_right]
      ring
    have hexp : ∀ (A : ℝ³ →L[ℝ] ℝ) (u : ℝ³), A u = ∑ k, u k * A (EuclideanSpace.single k 1) := by
      intro A u
      conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr u]
      simp [map_sum, map_smul]
    have hF1 : ContDiff ℝ ∞ (fderiv ℝ F) := (contDiff_infty_iff_fderiv.mp hF).2
    have hP : ∀ k : Fin 3, ContDiff ℝ ∞ (fun y => fderiv ℝ F y (EuclideanSpace.single k 1)) :=
      fun k => hF1.clm_apply contDiff_const
    have haffs : ContDiff ℝ ∞ (fun u : ℝ³ => x + L • u) := contDiff_const.add (contDiff_id.const_smul L)
    have hG : ∀ k : Fin 3, ContDiff ℝ ∞ (fun u : ℝ³ => fderiv ℝ F (x + L • u) (EuclideanSpace.single k 1)) :=
      fun k => (hP k).comp haffs
    have hGd : ∀ k : Fin 3, Differentiable ℝ (fun u : ℝ³ => fderiv ℝ F (x + L • u) (EuclideanSpace.single k 1)) :=
      fun k => (hG k).differentiable (by simp)
    have hPder : ∀ (k : Fin 3) (y v : ℝ³), fderiv ℝ (fun y => fderiv ℝ F y (EuclideanSpace.single k 1)) y v = fderiv ℝ (fderiv ℝ F) y v (EuclideanSpace.single k 1) := by
      intro k y v
      rw [fderiv_clm_apply ((hF1.differentiable (by simp)) y) (differentiableAt_const _)]
      simp
    have hGder : ∀ (k : Fin 3) (u : ℝ³), fderiv ℝ (fun u : ℝ³ => fderiv ℝ F (x + L • u) (EuclideanSpace.single k 1)) u (EuclideanSpace.single k 1) = L * fderiv ℝ (fderiv ℝ F) (x + L • u) (EuclideanSpace.single k 1) (EuclideanSpace.single k 1) := by
      intro k u
      have haff : HasFDerivAt (fun u : ℝ³ => x + L • u) (L • ContinuousLinearMap.id ℝ ℝ³) u := by
        simpa using ((hasFDerivAt_id u).const_smul L).const_add x
      have h2 := ((hP k).differentiable (by simp) (x + L • u)).hasFDerivAt.comp u haff
      rw [show (fun u : ℝ³ => fderiv ℝ F (x + L • u) (EuclideanSpace.single k 1)) = (fun y => fderiv ℝ F y (EuclideanSpace.single k 1)) ∘ (fun u : ℝ³ => x + L • u) from rfl, h2.fderiv]
      simp [hPder]
    have hlap : ∀ y, Δ F y = ∑ k : Fin 3, fderiv ℝ (fderiv ℝ F) y (EuclideanSpace.single k 1) (EuclideanSpace.single k 1) := by
      intro y
      rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis F (EuclideanSpace.basisFun (Fin 3) ℝ)]
      simp [iteratedFDeriv_two_apply]
    have hint : ∀ g h : ℝ³ → ℝ, Continuous g → Continuous h → HasCompactSupport h → Integrable (fun u => g u * h u) :=
      fun g h hg hh hcs => (hg.mul hh).integrable_of_hasCompactSupport (hcs.mul_left (f := g))
    have hdΨc : ∀ k : Fin 3, Continuous (fun u => fderiv ℝ (fun u : ℝ³ => ψ (‖u‖ ^ 2)) u (EuclideanSpace.single k 1)) :=
      fun k => (hΨs.continuous_fderiv (by simp)).clm_apply continuous_const
    have hdΨcs : ∀ k : Fin 3, HasCompactSupport (fun u => fderiv ℝ (fun u : ℝ³ => ψ (‖u‖ ^ 2)) u (EuclideanSpace.single k 1)) :=
      fun k => hΨcs.fderiv_apply (𝕜 := ℝ) _
    have hdGc : ∀ k : Fin 3, Continuous (fun u => fderiv ℝ (fun u : ℝ³ => fderiv ℝ F (x + L • u) (EuclideanSpace.single k 1)) u (EuclideanSpace.single k 1)) :=
      fun k => ((hG k).continuous_fderiv (by simp)).clm_apply continuous_const
    have hIBP : ∀ k : Fin 3, ∫ u, fderiv ℝ F (x + L • u) (EuclideanSpace.single k 1) * fderiv ℝ (fun u : ℝ³ => ψ (‖u‖ ^ 2)) u (EuclideanSpace.single k 1) = -∫ u, (L * fderiv ℝ (fderiv ℝ F) (x + L • u) (EuclideanSpace.single k 1) (EuclideanSpace.single k 1)) * ψ (‖u‖ ^ 2) := by
      intro k
      rw [integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (hint _ _ (hdGc k) hΨs.continuous hΨcs) (hint _ _ (hG k).continuous (hdΨc k) (hdΨcs k)) (hint _ _ (hG k).continuous hΨs.continuous hΨcs) (fun u _ => hGd k u) (fun u _ => hΨd u)]
      congr 1
      refine integral_congr_ae (Filter.Eventually.of_forall (fun u => ?_))
      simp only [hGder]
    have hpt : ∀ u : ℝ³, 2 * deriv ψ (‖u‖ ^ 2) * fderiv ℝ F (x + L • u) u = ∑ k : Fin 3, fderiv ℝ F (x + L • u) (EuclideanSpace.single k 1) * fderiv ℝ (fun u : ℝ³ => ψ (‖u‖ ^ 2)) u (EuclideanSpace.single k 1) := by
      intro u
      rw [hexp (fderiv ℝ F (x + L • u)) u, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [hgrad]
      ring
    have hH : ∀ k : Fin 3, Continuous (fun u : ℝ³ => L * fderiv ℝ (fderiv ℝ F) (x + L • u) (EuclideanSpace.single k 1) (EuclideanSpace.single k 1)) := by
      intro k
      have h2 : Continuous (fderiv ℝ (fderiv ℝ F)) := hF1.continuous_fderiv (by simp)
      exact continuous_const.mul (((h2.comp haffs.continuous).clm_apply continuous_const).clm_apply continuous_const)
    calc ∫ u, 2 * deriv ψ (‖u‖ ^ 2) * fderiv ℝ F (x + L • u) u
        = ∫ u, ∑ k : Fin 3, fderiv ℝ F (x + L • u) (EuclideanSpace.single k 1) * fderiv ℝ (fun u : ℝ³ => ψ (‖u‖ ^ 2)) u (EuclideanSpace.single k 1) := integral_congr_ae (Filter.Eventually.of_forall hpt)
      _ = ∑ k : Fin 3, ∫ u, fderiv ℝ F (x + L • u) (EuclideanSpace.single k 1) * fderiv ℝ (fun u : ℝ³ => ψ (‖u‖ ^ 2)) u (EuclideanSpace.single k 1) :=
          integral_finset_sum _ (fun k _ => hint _ _ (hG k).continuous (hdΨc k) (hdΨcs k))
      _ = ∑ k : Fin 3, -∫ u, (L * fderiv ℝ (fderiv ℝ F) (x + L • u) (EuclideanSpace.single k 1) (EuclideanSpace.single k 1)) * ψ (‖u‖ ^ 2) := Finset.sum_congr rfl (fun k _ => hIBP k)
      _ = -∫ u, ∑ k : Fin 3, (L * fderiv ℝ (fderiv ℝ F) (x + L • u) (EuclideanSpace.single k 1) (EuclideanSpace.single k 1)) * ψ (‖u‖ ^ 2) := by
          rw [Finset.sum_neg_distrib, integral_finset_sum _ (fun k _ => hint _ _ (hH k) hΨs.continuous hΨcs)]
      _ = 0 := by
          simp_rw [← Finset.sum_mul, ← Finset.mul_sum, ← hlap, hΔ]
          simp
  have s3 : ∀ (ρ₀ : ℝ³ → ℝ), Continuous ρ₀ → (∀ z : ℝ³, 1 ≤ ‖z‖ → ρ₀ z = 0) → ∀ F : ℝ³ → ℝ, ContDiff ℝ ∞ F → ∀ (x : ℝ³) (L : ℝ),
      HasDerivAt (fun t : ℝ => ∫ u, ρ₀ u * F (x + t • u)) (∫ u, ρ₀ u * fderiv ℝ F (x + L • u) u) L := by
    intro ρ₀ hρ hv F hF x L
    have hcsOf : ∀ g : ℝ³ → ℝ, (∀ z : ℝ³, 1 ≤ ‖z‖ → g z = 0) → HasCompactSupport g := by
      intro g hg
      refine HasCompactSupport.intro (isCompact_closedBall (0:ℝ³) 1) (fun z hz => hg z ?_)
      rw [Metric.mem_closedBall, dist_zero_right, not_le] at hz
      exact hz.le
    have hcs : HasCompactSupport ρ₀ := hcsOf ρ₀ hv
    have hFc : Continuous F := hF.continuous
    have hdF : Continuous (fderiv ℝ F) := hF.continuous_fderiv (by simp)
    have hFd : Differentiable ℝ F := hF.differentiable (by simp)
    have haff : ∀ t : ℝ, Continuous (fun u : ℝ³ => x + t • u) := fun t => continuous_const.add (continuous_id.const_smul t)
    obtain ⟨C, hC⟩ := (isCompact_closedBall (0:ℝ³) (‖x‖ + |L| + 1)).exists_bound_of_continuousOn hdF.continuousOn
    have hC0 : 0 ≤ C := le_trans (norm_nonneg _) (hC 0 (Metric.mem_closedBall_self (by positivity)))
    have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume)
      (F := fun t u => ρ₀ u * F (x + t • u))
      (F' := fun t u => ρ₀ u * fderiv ℝ F (x + t • u) u) (x₀ := L) (bound := fun u => |ρ₀ u| * C)
      (Metric.ball_mem_nhds L one_pos)
      (Filter.Eventually.of_forall (fun t => (hρ.mul (hFc.comp (haff t))).aestronglyMeasurable))
      ((hρ.mul (hFc.comp (haff L))).integrable_of_hasCompactSupport (hcs.mul_right))
      ((hρ.mul ((hdF.comp (haff L)).clm_apply continuous_id)).aestronglyMeasurable)
      ?_
      ((hρ.abs.mul continuous_const).integrable_of_hasCompactSupport
        (hcsOf _ (fun z hz => by simp [hv z hz])))
      ?_
    · exact key.2
    · refine Filter.Eventually.of_forall (fun u t ht => ?_)
      rw [norm_mul, Real.norm_eq_abs]
      by_cases hu : 1 ≤ ‖u‖
      · rw [hv u hu]; simp
      · have hu' : ‖u‖ < 1 := lt_of_not_ge hu
        refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
        have ht' : |t| < |L| + 1 := by
          rw [Metric.mem_ball, Real.dist_eq] at ht
          have := abs_sub_abs_le_abs_sub t L
          linarith
        have htu : |t| * ‖u‖ ≤ |t| := by
          have := mul_le_mul_of_nonneg_left hu'.le (abs_nonneg t)
          linarith
        have hmem : x + t • u ∈ Metric.closedBall (0:ℝ³) (‖x‖ + |L| + 1) := by
          rw [Metric.mem_closedBall, dist_zero_right]
          calc ‖x + t • u‖ ≤ ‖x‖ + ‖t • u‖ := norm_add_le _ _
            _ = ‖x‖ + |t| * ‖u‖ := by rw [norm_smul, Real.norm_eq_abs]
            _ ≤ ‖x‖ + |L| + 1 := by linarith
        calc ‖fderiv ℝ F (x + t • u) u‖ ≤ ‖fderiv ℝ F (x + t • u)‖ * ‖u‖ := ContinuousLinearMap.le_opNorm _ _
          _ ≤ C * 1 := mul_le_mul (hC _ hmem) hu'.le (norm_nonneg _) hC0
          _ = C := mul_one C
    · refine Filter.Eventually.of_forall (fun u t _ => ?_)
      have hγ : HasDerivAt (fun t : ℝ => x + t • u) u t := by
        simpa using ((hasDerivAt_id t).smul_const u).const_add x
      exact ((hFd (x + t • u)).hasFDerivAt.comp_hasDerivAt t hγ).const_mul (ρ₀ u)

  obtain ⟨ψ, hψs, hψz, hψnn, hψ0, s₀, hs₀, hs₀pos⟩ : ∃ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ ∧ (∀ s : ℝ, 1 / 2 ≤ s → ψ s = 0) ∧ (∀ s : ℝ, 0 ≤ deriv ψ s) ∧ (∀ s : ℝ, 1 / 2 < s → deriv ψ s = 0) ∧ ∃ s₀ : ℝ, 0 < s₀ ∧ 0 < deriv ψ s₀ := by
    refine ⟨fun s : ℝ => -Real.smoothTransition (1 - 2 * s), ?_⟩
    set ψ : ℝ → ℝ := fun s : ℝ => -Real.smoothTransition (1 - 2 * s) with hψdef
    have hψs : ContDiff ℝ ∞ ψ :=
      ((Real.smoothTransition.contDiff (n := ⊤)).comp (contDiff_const.sub (contDiff_const.mul contDiff_id))).neg
    have hz : ∀ s : ℝ, 1 / 2 ≤ s → ψ s = 0 := by
      intro s hs
      simp only [hψdef]
      rw [Real.smoothTransition.zero_of_nonpos (by linarith), neg_zero]
    have hmono : Monotone ψ := by
      intro a b hab
      simp only [hψdef, neg_le_neg_iff]
      exact Real.smoothTransition.monotone (by linarith)
    refine ⟨hψs, hz, fun s => hmono.deriv_nonneg, ?_, ?_⟩
    · intro s hs
      have hev : ψ =ᶠ[nhds s] (fun _ => (0:ℝ)) := by
        filter_upwards [Ioi_mem_nhds hs] with y hy
        exact hz y (le_of_lt hy)
      rw [hev.deriv_eq, deriv_const]
    · have hd : Differentiable ℝ ψ := hψs.differentiable (by simp)
      obtain ⟨s₀, hs₀, hder⟩ := exists_deriv_eq_slope ψ (by norm_num : (0:ℝ) < 1/2)
        hd.continuous.continuousOn (fun x _ => (hd x).differentiableWithinAt)
      refine ⟨s₀, hs₀.1, ?_⟩
      rw [hder, hz (1/2) le_rfl]
      have h0 : ψ 0 = -1 := by
        simp only [hψdef]
        rw [Real.smoothTransition.one_of_one_le (by norm_num)]
      rw [h0]; norm_num

  have hφs : ContDiff ℝ ∞ (deriv ψ) := (contDiff_infty_iff_deriv.mp hψs).2
  obtain ⟨ρ₀, hρ₀⟩ : ∃ ρ₀ : ℝ³ → ℝ, ρ₀ = fun u => 2 * deriv ψ (‖u‖ ^ 2) := ⟨_, rfl⟩
  have hρ₀s : ContDiff ℝ ∞ ρ₀ := by
    rw [hρ₀]
    exact contDiff_const.mul (hφs.comp (contDiff_norm_sq ℝ))
  have hρ₀v : ∀ z : ℝ³, 1 ≤ ‖z‖ → ρ₀ z = 0 := by
    intro z hz
    rw [hρ₀]
    show 2 * deriv ψ (‖z‖ ^ 2) = 0
    rw [hψ0 (‖z‖ ^ 2) (by nlinarith [norm_nonneg z]), mul_zero]
  have hρ₀cs : HasCompactSupport ρ₀ := by
    refine HasCompactSupport.intro (isCompact_closedBall (0:ℝ³) 1) (fun z hz => hρ₀v z ?_)
    rw [Metric.mem_closedBall, dist_zero_right, not_le] at hz
    exact hz.le
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = ∫ u, ρ₀ u := ⟨_, rfl⟩
  have hcpos : 0 < c := by
    rw [hc]
    refine Continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero
      (x := Real.sqrt s₀ • EuclideanSpace.single (0:Fin 3) (1:ℝ)) hρ₀s.continuous hρ₀cs (fun u => ?_) ?_
    · simp only [hρ₀, Pi.zero_apply]
      linarith [hψnn (‖u‖ ^ 2)]
    · have hn : ‖Real.sqrt s₀ • EuclideanSpace.single (0:Fin 3) (1:ℝ)‖ ^ 2 = s₀ := by
        rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
          abs_of_nonneg (Real.sqrt_nonneg _), Real.sq_sqrt hs₀.le]
      rw [hρ₀]
      show 2 * deriv ψ (‖Real.sqrt s₀ • EuclideanSpace.single (0:Fin 3) (1:ℝ)‖ ^ 2) ≠ 0
      rw [hn]
      exact ne_of_gt (by linarith)
  have hc0 : c ≠ 0 := ne_of_gt hcpos
  refine ⟨fun u => ρ₀ u / c, hρ₀s.div_const c, fun z hz => by simp [hρ₀v z hz], ?_⟩
  intro F hF hΔ x L _
  have hM : ∀ t : ℝ, HasDerivAt (fun t : ℝ => ∫ u, ρ₀ u * F (x + t • u)) 0 t := by
    intro t
    have h := s3 ρ₀ hρ₀s.continuous hρ₀v F hF x t
    have h0 : ∫ u, ρ₀ u * fderiv ℝ F (x + t • u) u = 0 := by
      rw [hρ₀]
      exact s2 ψ hψs (fun s hs => hψz s (by linarith)) F hF hΔ x t
    rwa [h0] at h
  have hconst := is_const_of_deriv_eq_zero (fun t => (hM t).differentiableAt) (fun t => (hM t).deriv) L 0
  simp only [zero_smul, add_zero] at hconst
  rw [integral_mul_const, ← hc] at hconst
  show ∫ u, ρ₀ u / c * F (x + L • u) = F x
  calc ∫ u, ρ₀ u / c * F (x + L • u) = (∫ u, ρ₀ u * F (x + L • u)) / c := by
        rw [← integral_div]
        congr 1
        funext u
        ring
    _ = F x := by
        rw [hconst]
        field_simp

theorem mollifier_scaling_bounds : ∀ ρ : ℝ³ → ℝ, ContDiff ℝ ∞ ρ → (∀ z : ℝ³, 1 ≤ ‖z‖ → ρ z = 0) → ∃ K : ℝ, 0 ≤ K ∧ ∀ (f : ℝ³ → ℝ) (x : ℝ³) (L : ℝ), ContDiff ℝ ∞ f → 1 ≤ L → (Integrable f → ∀ j : Fin 3, |∫ u, ρ u * pd j f (x + L • u)| ≤ K * (∫ y, |f y|) / L ^ 4) ∧ (MemLp f 2 → |∫ u, ρ u * f (x + L • u)| ≤ K * (∫ y, f y ^ 2) ^ ((1:ℝ)/2) / L ^ ((3:ℝ)/2)) ∧ (MemLp f 2 → |∫ u, ρ u * Δ f (x + L • u)| ≤ K * (∫ y, f y ^ 2) ^ ((1:ℝ)/2) / L ^ ((7:ℝ)/2)) :=
by

  have hpd_cd : ∀ (j : Fin 3) (F : ℝ³ → ℝ), ContDiff ℝ ∞ F → ContDiff ℝ ∞ (pd j F) := by
    intro j F hF
    show ContDiff ℝ ∞ (fun y => fderiv ℝ F y (EuclideanSpace.single j 1))
    exact (contDiff_infty_iff_fderiv.mp hF).2.clm_apply contDiff_const
  have hpd_cs : ∀ (j : Fin 3) (F : ℝ³ → ℝ), HasCompactSupport F → HasCompactSupport (pd j F) :=
    fun j F hF => HasCompactSupport.fderiv_apply ℝ hF (EuclideanSpace.single j 1)
  have haff : ∀ (x : ℝ³) (L : ℝ), ContDiff ℝ ∞ (fun u : ℝ³ => x + L • u) :=
    fun x L => contDiff_const.add (contDiff_id.const_smul L)
  have A2 : ∀ (G : ℝ³ → ℝ), ContDiff ℝ ∞ G → ∀ (a b : Fin 3) (y : ℝ³),
      pd a (pd b G) y = fderiv ℝ (fderiv ℝ G) y (EuclideanSpace.single a 1)
        (EuclideanSpace.single b 1) := by
    intro G hG a b y
    have hd : DifferentiableAt ℝ (fderiv ℝ G) y :=
      ((contDiff_infty_iff_fderiv.mp hG).2.differentiable (by simp)) y
    show fderiv ℝ (fun z => fderiv ℝ G z (EuclideanSpace.single b 1)) y
      (EuclideanSpace.single a 1) = _
    rw [fderiv_clm_apply hd (differentiableAt_const _)]
    simp
  have S2 : ∀ (G : ℝ³ → ℝ), ContDiff ℝ ∞ G → ∀ y, Δ G y = ∑ k : Fin 3, pd k (pd k G) y := by
    intro G hG y
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis G
      (EuclideanSpace.basisFun (Fin 3) ℝ)]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [A2 G hG, iteratedFDeriv_two_apply]
    simp
  have hchain : ∀ (F : ℝ³ → ℝ) (x : ℝ³) (L : ℝ) (u v : ℝ³), DifferentiableAt ℝ F (x + L • u) →
      fderiv ℝ (fun w => F (x + L • w)) u v = L * fderiv ℝ F (x + L • u) v := by
    intro F x L u v hF
    have hA : HasFDerivAt (fun w : ℝ³ => x + L • w) (L • ContinuousLinearMap.id ℝ ℝ³) u :=
      ((hasFDerivAt_id u).const_smul L).const_add x
    have h := (hF.hasFDerivAt.comp u hA).fderiv
    rw [show (fun w => F (x + L • w)) = F ∘ (fun w => x + L • w) from rfl, h]
    simp

  have c1 : ∀ (φ : ℝ³ → ℝ) (x : ℝ³) (L : ℝ), 0 < L →
      ∫ u, φ (x + L • u) = (∫ y, φ y) / L ^ 3 := by
    intro φ x L hL
    have h1 := Measure.integral_comp_smul (volume : Measure ℝ³) (fun v => φ (x + v)) L
    rw [finrank_euclideanSpace_fin] at h1
    have h2 : ∫ u, φ (x + L • u) = |(L ^ 3)⁻¹| • ∫ v, φ (x + v) := h1
    rw [h2, integral_add_left_eq_self φ x, abs_of_pos (inv_pos.mpr (pow_pos hL 3)), smul_eq_mul]
    ring

  have c2 : ∀ (ψ F : ℝ³ → ℝ) (x : ℝ³) (L : ℝ) (j : Fin 3), ContDiff ℝ ∞ ψ → HasCompactSupport ψ →
      ContDiff ℝ ∞ F → 0 < L →
      ∫ u, ψ u * pd j F (x + L • u) = -(∫ u, pd j ψ u * F (x + L • u)) / L := by
    intro ψ F x L j hψ hψc hF hL
    have hg : ContDiff ℝ ∞ (fun u => F (x + L • u)) := hF.comp (haff x L)
    have hFd : Differentiable ℝ F := hF.differentiable (by simp)
    have hψd : Differentiable ℝ ψ := hψ.differentiable (by simp)
    have hgd : Differentiable ℝ (fun u => F (x + L • u)) := hg.differentiable (by simp)
    have hder : ∀ u, fderiv ℝ (fun w => F (x + L • w)) u (EuclideanSpace.single j 1)
        = L * pd j F (x + L • u) :=
      fun u => hchain F x L u _ (hFd _)
    have hcontg : Continuous (fun u => F (x + L • u)) := hg.continuous
    have hcontdg : Continuous
        (fun u => fderiv ℝ (fun w => F (x + L • w)) u (EuclideanSpace.single j 1)) :=
      (hg.continuous_fderiv (by simp)).clm_apply continuous_const
    have hcontdψ : Continuous (fun u => fderiv ℝ ψ u (EuclideanSpace.single j 1)) :=
      (hψ.continuous_fderiv (by simp)).clm_apply continuous_const
    have i1 : Integrable (fun u => fderiv ℝ ψ u (EuclideanSpace.single j 1) * F (x + L • u)) :=
      (hcontdψ.mul hcontg).integrable_of_hasCompactSupport
        ((HasCompactSupport.fderiv_apply ℝ hψc (EuclideanSpace.single j 1)).mul_right)
    have i2 : Integrable
        (fun u => ψ u * fderiv ℝ (fun w => F (x + L • w)) u (EuclideanSpace.single j 1)) :=
      (hψ.continuous.mul hcontdg).integrable_of_hasCompactSupport hψc.mul_right
    have i3 : Integrable (fun u => ψ u * F (x + L • u)) :=
      (hψ.continuous.mul hcontg).integrable_of_hasCompactSupport hψc.mul_right
    have hibp := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable i1 i2 i3
      (fun u _ => hψd u) (fun u _ => hgd u)
    have e1 : (∫ u, ψ u * fderiv ℝ (fun w => F (x + L • w)) u (EuclideanSpace.single j 1))
        = L * ∫ u, ψ u * pd j F (x + L • u) := by
      rw [← integral_const_mul]
      congr 1
      funext u
      rw [hder u]
      ring
    rw [e1] at hibp
    show _ = -(∫ u, fderiv ℝ ψ u (EuclideanSpace.single j 1) * F (x + L • u)) / L
    rw [eq_div_iff hL.ne']
    linear_combination hibp

  have c3 : ∀ (ψ F : ℝ³ → ℝ) (x : ℝ³) (L : ℝ), ContDiff ℝ ∞ ψ → HasCompactSupport ψ →
      ContDiff ℝ ∞ F → 0 < L →
      ∫ u, ψ u * Δ F (x + L • u) = (∫ u, Δ ψ u * F (x + L • u)) / L ^ 2 := by
    intro ψ F x L hψ hψc hF hL
    have hcc : ∀ (φ G : ℝ³ → ℝ), Continuous φ → HasCompactSupport φ → Continuous G →
        Integrable (fun u => φ u * G (x + L • u)) :=
      fun φ G hφ hφc hG =>
        (hφ.mul (hG.comp (haff x L).continuous)).integrable_of_hasCompactSupport hφc.mul_right
    have hcont2 : ∀ (k : Fin 3) (G : ℝ³ → ℝ), ContDiff ℝ ∞ G → Continuous (pd k (pd k G)) :=
      fun k G hG => (hpd_cd k _ (hpd_cd k G hG)).continuous
    have hterm : ∀ k : Fin 3, ∫ u, ψ u * pd k (pd k F) (x + L • u)
        = (∫ u, pd k (pd k ψ) u * F (x + L • u)) / L ^ 2 := by
      intro k
      rw [c2 ψ (pd k F) x L k hψ hψc (hpd_cd k F hF) hL,
        c2 (pd k ψ) F x L k (hpd_cd k ψ hψ) (hpd_cs k ψ hψc) hF hL]
      ring
    calc ∫ u, ψ u * Δ F (x + L • u)
        = ∫ u, ∑ k : Fin 3, ψ u * pd k (pd k F) (x + L • u) := by
          congr 1; funext u; rw [S2 F hF, Finset.mul_sum]
      _ = ∑ k : Fin 3, ∫ u, ψ u * pd k (pd k F) (x + L • u) :=
          integral_finsetSum _ (fun k _ => hcc ψ _ hψ.continuous hψc (hcont2 k F hF))
      _ = ∑ k : Fin 3, (∫ u, pd k (pd k ψ) u * F (x + L • u)) / L ^ 2 :=
          Finset.sum_congr rfl (fun k _ => hterm k)
      _ = (∑ k : Fin 3, ∫ u, pd k (pd k ψ) u * F (x + L • u)) / L ^ 2 :=
          (Finset.sum_div _ _ _).symm
      _ = (∫ u, ∑ k : Fin 3, pd k (pd k ψ) u * F (x + L • u)) / L ^ 2 := by
          rw [integral_finsetSum _ (fun k _ => hcc _ F (hcont2 k ψ hψ)
            (hpd_cs k _ (hpd_cs k ψ hψc)) hF.continuous)]
      _ = (∫ u, Δ ψ u * F (x + L • u)) / L ^ 2 := by
          congr 2; funext u; rw [S2 ψ hψ u, Finset.sum_mul]

  have c4 : ∀ (φ F : ℝ³ → ℝ) (x : ℝ³) (L : ℝ), Continuous φ → HasCompactSupport φ →
      Continuous F → MemLp F 2 → 0 < L →
      |∫ u, φ u * F (x + L • u)|
        ≤ (∫ u, φ u ^ 2) ^ ((1:ℝ)/2) * (∫ y, F y ^ 2) ^ ((1:ℝ)/2) / L ^ ((3:ℝ)/2) := by
    intro φ F x L hφ hφc hF hF2 hL
    have hgc : Continuous (fun u => F (x + L • u)) := hF.comp (haff x L).continuous
    have hsqi : Integrable (fun u => F (x + L • u) ^ 2) :=
      (hF2.integrable_sq.comp_add_left x).comp_smul hL.ne'
    have hg2 : MemLp (fun u => F (x + L • u)) 2 :=
      (memLp_two_iff_integrable_sq hgc.aestronglyMeasurable).mpr hsqi
    have hφ2 : MemLp φ 2 := hφ.memLp_of_hasCompactSupport hφc
    have hH := integral_mul_le_Lp_mul_Lq_of_nonneg (μ := volume) Real.HolderConjugate.two_two
      (f := fun u => |φ u|) (g := fun u => |F (x + L • u)|)
      (Filter.Eventually.of_forall (fun u => abs_nonneg _))
      (Filter.Eventually.of_forall (fun u => abs_nonneg _))
      (by rw [ENNReal.ofReal_ofNat]; exact hφ2.abs) (by rw [ENNReal.ofReal_ofNat]; exact hg2.abs)
    simp only [Real.rpow_two, sq_abs] at hH
    have hs : ∫ u, F (x + L • u) ^ 2 = (∫ y, F y ^ 2) / L ^ 3 := c1 (fun y => F y ^ 2) x L hL
    have hS : 0 ≤ ∫ y, F y ^ 2 := integral_nonneg (fun y => sq_nonneg _)
    have hL32 : (L ^ 3) ^ ((1:ℝ)/2) = L ^ ((3:ℝ)/2) := by
      rw [← Real.rpow_natCast_mul hL.le]; norm_num
    calc |∫ u, φ u * F (x + L • u)| ≤ ∫ u, |φ u * F (x + L • u)| := abs_integral_le_integral_abs
      _ = ∫ u, |φ u| * |F (x + L • u)| := by congr 1; funext u; exact abs_mul _ _
      _ ≤ (∫ u, φ u ^ 2) ^ ((1:ℝ)/2) * (∫ u, F (x + L • u) ^ 2) ^ ((1:ℝ)/2) := hH
      _ = (∫ u, φ u ^ 2) ^ ((1:ℝ)/2) * (∫ y, F y ^ 2) ^ ((1:ℝ)/2) / L ^ ((3:ℝ)/2) := by
          rw [hs, Real.div_rpow hS (pow_pos hL 3).le, hL32, mul_div_assoc]

  have c5 : ∀ (φ F : ℝ³ → ℝ) (x : ℝ³) (L M : ℝ), Continuous φ → HasCompactSupport φ →
      (∀ u, |φ u| ≤ M) → Continuous F → Integrable F → 0 < L →
      |∫ u, φ u * F (x + L • u)| ≤ M * (∫ y, |F y|) / L ^ 3 := by
    intro φ F x L M hφ hφc hM hF hFi hL
    have hgc : Continuous (fun u => F (x + L • u)) := hF.comp (haff x L).continuous
    have hgi : Integrable (fun u => F (x + L • u)) := (hFi.comp_add_left x).comp_smul hL.ne'
    have hpi : Integrable (fun u => φ u * F (x + L • u)) :=
      (hφ.mul hgc).integrable_of_hasCompactSupport hφc.mul_right
    have hs : ∫ u, |F (x + L • u)| = (∫ y, |F y|) / L ^ 3 := c1 (fun y => |F y|) x L hL
    calc |∫ u, φ u * F (x + L • u)| ≤ ∫ u, |φ u * F (x + L • u)| := abs_integral_le_integral_abs
      _ ≤ ∫ u, M * |F (x + L • u)| := by
          refine integral_mono hpi.abs (hgi.abs.const_mul M) (fun u => ?_)
          show |φ u * F (x + L • u)| ≤ M * |F (x + L • u)|
          rw [abs_mul]
          exact mul_le_mul_of_nonneg_right (hM u) (abs_nonneg _)
      _ = M * (∫ y, |F y|) / L ^ 3 := by rw [integral_const_mul, hs, mul_div_assoc]

  intro ρ hρ hρ1
  have hρc : HasCompactSupport ρ := by
    refine HasCompactSupport.intro (isCompact_closedBall (0:ℝ³) 1) (fun z hz => hρ1 z ?_)
    rw [Metric.mem_closedBall, dist_zero_right, not_le] at hz
    exact hz.le
  have hbd : ∀ j : Fin 3, ∃ C : ℝ, ∀ u, ‖pd j ρ u‖ ≤ C := fun j =>
    (hpd_cd j ρ hρ).continuous.bounded_above_of_compact_support (hpd_cs j ρ hρc)
  choose C hC using hbd
  have hMb' : ∀ j : Fin 3, ∀ u, |pd j ρ u| ≤ ∑ k : Fin 3, |C k| := by
    intro j u
    rw [← Real.norm_eq_abs]
    exact (hC j u).trans ((le_abs_self _).trans
      (Finset.single_le_sum (f := fun k => |C k|) (fun k _ => abs_nonneg _) (Finset.mem_univ j)))
  obtain ⟨M, hM0, hMb⟩ : ∃ M : ℝ, 0 ≤ M ∧ ∀ j : Fin 3, ∀ u, |pd j ρ u| ≤ M :=
    ⟨_, Finset.sum_nonneg (fun k _ => abs_nonneg _), hMb'⟩
  have hΔρeq : Δ ρ = fun u => ∑ k : Fin 3, pd k (pd k ρ) u := funext (S2 ρ hρ)
  have hΔρc : Continuous (Δ ρ) := by
    rw [hΔρeq]
    exact continuous_finset_sum _ (fun k _ => (hpd_cd k _ (hpd_cd k ρ hρ)).continuous)
  have hΔρcs : HasCompactSupport (Δ ρ) := by
    rw [hΔρeq]
    simp only [Fin.sum_univ_three]
    exact ((hpd_cs 0 _ (hpd_cs 0 ρ hρc)).add (hpd_cs 1 _ (hpd_cs 1 ρ hρc))).add
      (hpd_cs 2 _ (hpd_cs 2 ρ hρc))
  obtain ⟨A, hA, hA0⟩ : ∃ A : ℝ, A = (∫ u, ρ u ^ 2) ^ ((1:ℝ)/2) ∧ 0 ≤ A :=
    ⟨_, rfl, Real.rpow_nonneg (integral_nonneg (fun _ => sq_nonneg _)) _⟩
  obtain ⟨B, hB, hB0⟩ : ∃ B : ℝ, B = (∫ u, Δ ρ u ^ 2) ^ ((1:ℝ)/2) ∧ 0 ≤ B :=
    ⟨_, rfl, Real.rpow_nonneg (integral_nonneg (fun _ => sq_nonneg _)) _⟩
  refine ⟨M + A + B, by linarith, ?_⟩
  intro f x L hf hL
  have hLpos : 0 < L := by linarith
  have hfc : Continuous f := hf.continuous
  have hN2 : 0 ≤ (∫ y, f y ^ 2) ^ ((1:ℝ)/2) :=
    Real.rpow_nonneg (integral_nonneg (fun _ => sq_nonneg _)) _
  refine ⟨?_, ?_, ?_⟩
  · intro hfi j
    have hN1 : 0 ≤ ∫ y, |f y| := integral_nonneg (fun _ => abs_nonneg _)
    rw [c2 ρ f x L j hρ hρc hf hLpos, abs_div, abs_neg, abs_of_pos hLpos]
    have h5 := c5 (pd j ρ) f x L M (hpd_cd j ρ hρ).continuous (hpd_cs j ρ hρc) (hMb j) hfc hfi
      hLpos
    calc |∫ u, pd j ρ u * f (x + L • u)| / L ≤ M * (∫ y, |f y|) / L ^ 3 / L :=
          div_le_div_of_nonneg_right h5 hLpos.le
      _ = M * (∫ y, |f y|) / L ^ 4 := by rw [div_div, ← pow_succ]
      _ ≤ (M + A + B) * (∫ y, |f y|) / L ^ 4 :=
          div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right (by linarith) hN1)
            (pow_pos hLpos 4).le
  · intro hf2
    have h4 := c4 ρ f x L hρ.continuous hρc hfc hf2 hLpos
    rw [← hA] at h4
    calc |∫ u, ρ u * f (x + L • u)| ≤ A * (∫ y, f y ^ 2) ^ ((1:ℝ)/2) / L ^ ((3:ℝ)/2) := h4
      _ ≤ (M + A + B) * (∫ y, f y ^ 2) ^ ((1:ℝ)/2) / L ^ ((3:ℝ)/2) :=
          div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right (by linarith) hN2)
            (Real.rpow_pos_of_pos hLpos _).le
  · intro hf2
    rw [c3 ρ f x L hρ hρc hf hLpos, abs_div, abs_of_pos (pow_pos hLpos 2)]
    have h4 := c4 (Δ ρ) f x L hΔρc hΔρcs hfc hf2 hLpos
    rw [← hB] at h4
    have hexp : L ^ ((3:ℝ)/2) * L ^ 2 = L ^ ((7:ℝ)/2) := by
      rw [← Real.rpow_natCast L 2, ← Real.rpow_add hLpos]
      norm_num
    calc |∫ u, Δ ρ u * f (x + L • u)| / L ^ 2
        ≤ B * (∫ y, f y ^ 2) ^ ((1:ℝ)/2) / L ^ ((3:ℝ)/2) / L ^ 2 :=
          div_le_div_of_nonneg_right h4 (pow_pos hLpos 2).le
      _ = B * (∫ y, f y ^ 2) ^ ((1:ℝ)/2) / L ^ ((7:ℝ)/2) := by rw [div_div, hexp]
      _ ≤ (M + A + B) * (∫ y, f y ^ 2) ^ ((1:ℝ)/2) / L ^ ((7:ℝ)/2) :=
          div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right (by linarith) hN2)
            (Real.rpow_pos_of_pos hLpos _).le

theorem newtonPot_contDiff_of_integrable : ∀ G : ℝ³ → ℝ, ContDiff ℝ ∞ G → Integrable G → ContDiff ℝ ∞ (newtonPot G) :=
by
  intro G hG hGi
  obtain ⟨hKs, hKeq, -, hKb⟩ := far_kernel_basic
  set K : ℝ³ → ℝ := fun z => Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z with hKdef

  have hLI : LocallyIntegrable newtonKernel volume := by
    rw [locallyIntegrable_iff]
    intro k hk
    obtain ⟨r, hr⟩ := hk.isBounded.subset_closedBall (0 : ℝ³)
    refine IntegrableOn.mono_set ?_ hr
    rw [← integrable_indicator_iff Metric.isClosed_closedBall.measurableSet]
    have heq : (Metric.closedBall (0:ℝ³) r).indicator newtonKernel =
        fun x => (fun s : ℝ => if s ≤ r then (4 * Real.pi * s)⁻¹ else 0) ‖x‖ := by
      funext x
      simp only [Set.indicator, Metric.mem_closedBall, dist_zero_right, newtonKernel]
    rw [heq]
    refine (integrable_fun_norm_addHaar (volume : Measure ℝ³)
      (f := fun s : ℝ => if s ≤ r then (4 * Real.pi * s)⁻¹ else 0)).mpr ?_
    have h1 : IntegrableOn (fun y : ℝ => y / (4 * Real.pi)) (Icc 0 r) :=
      (continuous_id.div_const _).integrableOn_Icc
    have h2 : IntegrableOn ((Icc 0 r).indicator (fun y : ℝ => y / (4 * Real.pi))) (Ioi 0) :=
      (h1.integrable_indicator measurableSet_Icc).integrableOn
    refine h2.congr_fun ?_ measurableSet_Ioi
    intro y hy
    have hy0 : (0:ℝ) < y := hy
    simp only [finrank_euclideanSpace_fin, smul_eq_mul, Set.indicator, Set.mem_Icc]
    by_cases hyr : y ≤ r
    · rw [if_pos ⟨hy0.le, hyr⟩, if_pos hyr]
      field_simp
    · rw [if_neg (fun h => hyr h.2), if_neg hyr, mul_zero]

  have hKcont : Continuous K := hKs.continuous
  have hKn0 : ∀ z : ℝ³, 1 ≤ ‖z‖ → newtonKernel z - K z = 0 := fun z hz => by
    show newtonKernel z - Real.smoothTransition (2 * ‖z‖ ^ 2 - 1) * newtonKernel z = 0
    rw [hKeq z hz, sub_self]
  have hKni : Integrable (fun z => newtonKernel z - K z) := by
    have h1 : IntegrableOn newtonKernel (Metric.closedBall (0:ℝ³) 1) :=
      hLI.integrableOn_isCompact (isCompact_closedBall 0 1)
    have h2 : IntegrableOn K (Metric.closedBall (0:ℝ³) 1) :=
      hKcont.continuousOn.integrableOn_compact (isCompact_closedBall 0 1)
    have h3 := h1.sub h2
    rw [← integrable_indicator_iff Metric.isClosed_closedBall.measurableSet] at h3
    convert h3 using 1
    funext z
    by_cases hz : z ∈ Metric.closedBall (0:ℝ³) 1
    · rw [Set.indicator_of_mem hz]
      rfl
    · rw [Set.indicator_of_notMem hz]
      apply hKn0
      rw [Metric.mem_closedBall, dist_zero_right, not_le] at hz
      exact hz.le

  obtain ⟨hF1, hF2, -⟩ := conv_bounded_deriv_kernel G K hGi hKs hKb

  rw [contDiff_iff_contDiffAt]
  intro x₀
  let η : ContDiffBump x₀ := ⟨2, 3, by norm_num, by norm_num⟩
  set h : ℝ³ → ℝ := fun y => η y * G y with hhdef
  have hhs : ContDiff ℝ ∞ h := η.contDiff.mul hG
  have hhc : HasCompactSupport h := η.hasCompactSupport.mul_right
  have hhb : ∀ n : ℕ, ∃ C : ℝ, ∀ z, ‖iteratedFDeriv ℝ n h z‖ ≤ C := by
    intro n
    exact (hhs.continuous_iteratedFDeriv (by exact_mod_cast le_top)).bounded_above_of_compact_support
      (hhc.iteratedFDeriv n)
  obtain ⟨hN1, hN2, -⟩ := conv_bounded_deriv_kernel (fun z => newtonKernel z - K z) h hKni hhs hhb
  have hP : ∀ x ∈ Metric.ball x₀ 1, ∀ y,
      (newtonKernel (x - y) - K (x - y)) * h y = (newtonKernel (x - y) - K (x - y)) * G y := by
    intro x hx y
    by_cases hxy : 1 ≤ ‖x - y‖
    · rw [hKn0 _ hxy, zero_mul, zero_mul]
    · push_neg at hxy
      have hy : y ∈ Metric.closedBall x₀ η.rIn := by
        rw [Metric.mem_closedBall, dist_eq_norm]
        rw [Metric.mem_ball, dist_eq_norm] at hx
        have e : y - x₀ = (y - x) + (x - x₀) := by abel
        have h1 := norm_add_le (y - x) (x - x₀)
        rw [← e, norm_sub_rev y x] at h1
        show ‖y - x₀‖ ≤ 2
        linarith
      have h1 := η.one_of_mem_closedBall hy
      simp only [hhdef, h1, one_mul]
  have hEq : newtonPot G =ᶠ[nhds x₀]
      fun x => (∫ t, (newtonKernel t - K t) * h (x - t)) + ∫ t, G t * K (x - t) := by
    filter_upwards [Metric.ball_mem_nhds x₀ one_pos] with x hx
    have ha : ∫ y, (newtonKernel (x - y) - K (x - y)) * h y =
        ∫ t, (newtonKernel t - K t) * h (x - t) := by
      have := integral_sub_left_eq_self (fun t => (newtonKernel t - K t) * h (x - t)) volume x
      simp only [sub_sub_cancel] at this
      exact this
    have hb : Integrable (fun y => (newtonKernel (x - y) - K (x - y)) * G y) := by
      have := (hN1 x).comp_sub_left x
      simp only [sub_sub_cancel] at this
      exact this.congr (Filter.Eventually.of_forall fun y => hP x hx y)
    have hc : newtonPot G x =
        (∫ y, (newtonKernel (x - y) - K (x - y)) * G y) + ∫ y, G y * K (x - y) := by
      rw [← integral_add hb (hF1 x)]
      unfold newtonPot
      congr 1
      funext y
      ring
    rw [hc, ← ha]
    congr 1
    exact integral_congr_ae (Filter.Eventually.of_forall fun y => (hP x hx y).symm)
  exact ((hN2.add hF2).contDiffAt).congr_of_eventuallyEq hEq

theorem mollified_stress_pressure_bound : ∀ ρ : ℝ³ → ℝ, ContDiff ℝ ∞ ρ → (∀ z : ℝ³, 1 ≤ ‖z‖ → ρ z = 0) → ∃ K : ℝ, 0 ≤ K ∧ ∀ (G : Fin 3 → Fin 3 → ℝ³ → ℝ), (∀ k l, ContDiff ℝ ∞ (G k l) ∧ Integrable (G k l)) → ∀ (i : Fin 3) (x : ℝ³) (L : ℝ), 1 ≤ L → |∫ u, ρ u * pd i (stressPressure G) (x + L • u)| ≤ K * (∑ k, ∑ l, ∫ y, |G k l y|) / L ^ 4 :=
by
  intro ρ hρ hρ1



  have kernel_part : ∃ C : ℝ, 0 ≤ C ∧ ∀ b : ℝ³, ∫⁻ u in Metric.closedBall (0:ℝ³) 1,
      ENNReal.ofReal (newtonKernel (b + u)) ≤ ENNReal.ofReal C := by
    have hA : ∫⁻ y in Metric.closedBall (0:ℝ³) 1, ENNReal.ofReal (newtonKernel y) < ⊤ := by
      obtain ⟨f, hf⟩ : ∃ f : ℝ → ℝ, f = fun r => if r ≤ 1 then (4 * Real.pi * r)⁻¹ else 0 :=
        ⟨_, rfl⟩
      have hfi : Integrable (fun y : ℝ³ => f ‖y‖) := by
        rw [integrable_fun_norm_addHaar volume, finrank_euclideanSpace_fin]
        have hI : Integrable ((Icc (0:ℝ) 1).indicator (fun r => r / (4 * Real.pi))) :=
          (ContinuousOn.integrableOn_Icc
            (continuous_id.div_const _).continuousOn).integrable_indicator measurableSet_Icc
        refine hI.integrableOn.congr_fun (fun r hr => ?_) measurableSet_Ioi
        simp only [mem_Ioi] at hr
        by_cases h1 : r ≤ 1
        · rw [indicator_of_mem (show r ∈ Icc (0:ℝ) 1 from ⟨hr.le, h1⟩), hf]
          simp only [if_pos h1, smul_eq_mul]
          norm_num
          field_simp
        · rw [indicator_of_notMem (fun h => h1 h.2), hf]
          simp [h1]
      have heq : ∫⁻ y in Metric.closedBall (0:ℝ³) 1, ENNReal.ofReal (newtonKernel y)
          = ∫⁻ y : ℝ³, ENNReal.ofReal (f ‖y‖) := by
        rw [← lintegral_indicator measurableSet_closedBall]
        congr 1; funext y
        by_cases h : ‖y‖ ≤ 1
        · rw [indicator_of_mem (mem_closedBall_zero_iff.2 h), hf]; simp [h, newtonKernel]
        · rw [indicator_of_notMem (fun h' => h (mem_closedBall_zero_iff.1 h')), hf]; simp [h]
      rw [heq]; exact hfi.lintegral_lt_top
