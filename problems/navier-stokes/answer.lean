  have hSK : Icc 0 X1 ×ˢ Ioo (-1:ℝ) 1 ⊆ Icc 0 X1 ×ˢ Icc (-1:ℝ) 1 := prod_mono subset_rfl Ioo_subset_Icc_self
  have hKc : IsCompact (Icc 0 X1 ×ˢ Icc (-1:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
  have hj1 : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X1 ×ˢ Ioo (-1:ℝ) 1,
