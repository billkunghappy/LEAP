          · rw [hZ ξ hξ u (Or.inl hlt)]; exact hm0
          · exact (hu1 (by linarith)).elim
          · rcases lt_trichotomy (ξ.1 ^ d + u) ((2 * B.Xb * qC B.h ξ) ^ (d / 2)) with
              hlt' | heq' | hgt'
            · exact hPb ξ hξ h1 h2 u hgt hlt'
            · exact (hu2 (by linarith)).elim
            · rw [hZ ξ hξ u (Or.inr hgt')]; exact hm0
      _ = Cf * ∑ i ∈ Finset.range (k + 1), ∫ u in S, g i ξ u := by
          rw [MeasureTheory.integral_const_mul,
            MeasureTheory.integral_finsetSum _ (fun i _ => hgi i)]
  refine ⟨Cf, fun ξ hξ h1 h2 => ⟨?_, ?_⟩⟩
  · obtain ⟨hr, -, -⟩ := hD ξ hξ
    have hξU : ξ ∈ DomC B.h qs ∩ {η : Cyl | η.1 < 2 * ξ.1} :=
      ⟨hξ, show ξ.1 < 2 * ξ.1 by linarith⟩
    have ha := hUa ξ ξ hξU
    have hev : (fun η => ∫ r' in (0:ℝ)..η.1, f (pathPt B.h η r')) =ᶠ[nhds ξ]
        (fun η => ∫ u in Set.Icc (-((2 * ξ.1) ^ d)) 0, K η u) :=
      Filter.eventuallyEq_of_mem ((hUo ξ).mem_nhds hξU) (fun η hη => hA_rep η hη.1 _ (hUa ξ η hη))
    have e : NB B.h (fun η => ∫ r' in (0:ℝ)..η.1, f (pathPt B.h η r')) k ξ =
        NB B.h (fun η => ∫ u in Set.Icc (-((2 * ξ.1) ^ d)) 0, K η u) k ξ := by
      unfold NB
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    rw [e]
    refine le_trans ((hAloc ξ).2 ξ hξU k) (le_trans (hmono ξ hξ h1 h2 _
      (fun i => ((hgcov i ξ hξ).1 _ ha).1)) (le_of_eq ?_))
    congr 1
    exact Finset.sum_congr rfl (fun i _ => ((hgcov i ξ hξ).1 _ ha).2)
  · have hev : (fun η => ∫ r' in Set.Ioi η.1, f (pathPt B.h η r')) =ᶠ[nhds ξ]
        (fun η => ∫ u in Set.Icc 0 b₀, K η u) :=
      Filter.eventuallyEq_of_mem (hDo.mem_nhds hξ) (fun η hη => hB_rep η hη)
    have e : NB B.h (fun η => ∫ r' in Set.Ioi η.1, f (pathPt B.h η r')) k ξ =
        NB B.h (fun η => ∫ u in Set.Icc 0 b₀, K η u) k ξ := by
      unfold NB
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    rw [e]
    refine le_trans (hBloc.2 ξ hξ k) (le_trans (hmono ξ hξ h1 h2 _
      (fun i => (hgcov i ξ hξ).2.1)) (le_of_eq ?_))
    congr 1
    exact Finset.sum_congr rfl (fun i _ => (hgcov i ξ hξ).2.2)

theorem icut_inner_class_v4 : ∀ (B : BG) (qs α : ℝ), B.ok → SimNorm B.h → 0 < qs → qs ≤ 1 →
    ∀ G : Cyl → ℝ, InM B qs α G →
    ContDiffOn ℝ ∞ (icutInner4 B G) (DomC B.h qs) ∧
    (∀ ξ ∈ DomC B.h qs, ∀ a, IsDeck B.h (qC B.h ξ) a → icutInner4 B G (shY ξ a) = icutInner4 B G ξ) ∧
    (∀ ξ ∈ DomC B.h qs, XC B.h ξ ≤ B.Xa → icutInner4 B G ξ = 0) ∧
    ∀ k : ℕ, ∃ C b d : ℝ, ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → XC B.h ξ ≤ B.m2 →
      NB B.h (icutInner4 B G) k ξ ≤ C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b *
        edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) :=
by
  intro B qs α hok hSN hqs0 hqs1 G hG
  obtain ⟨hDo, hqCs, hqpos, hXCc, -, -⟩ := domc_open_calculus B qs hok
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -, -, -, -, -, haa, hab⟩ := hok.2.1

  obtain ⟨P, hP⟩ : ∃ P : Cyl → ℝ, P = fun η => qC B.h η ^ (-(1/2:ℝ)) := ⟨_, rfl⟩
  obtain ⟨A, hA⟩ : ∃ A : Cyl → ℝ, A = fun η => ∫ r' in (0:ℝ)..η.1, G (pathPt B.h η r') := ⟨_, rfl⟩
  have hI : icutInner4 B G = fun η => P η * A η := by subst hP hA; rfl
  obtain ⟨hAs, -, hAb⟩ := path_integral_nb_v4 B qs hok hqs0 hqs1 G hG.1 hG.2.2.1
  rw [← hA] at hAs hAb
  have hPs : ContDiffOn ℝ ∞ P (DomC B.h qs) := by
    rw [hP]; exact hqCs.rpow_const_of_ne (fun x hx => (hqpos x hx).ne')

  have hpath : ∀ ξ ∈ DomC B.h qs, ∀ x : ℝ, 0 < x → pathPt B.h ξ x ∈ DomC B.h qs := by
    intro ξ hξ x hx
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    exact show 0 < x ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs from ⟨hx, hξ'.2.1, hξ'.2.2⟩
  have hXCle : ∀ ξ ∈ DomC B.h qs, ∀ x : ℝ, 0 < x → x ≤ ξ.1 →
      XC B.h (pathPt B.h ξ x) ≤ XC B.h ξ := by
    intro ξ hξ x hx hxr
    show x ^ 2 / (2 * qC B.h ξ) ≤ ξ.1 ^ 2 / (2 * qC B.h ξ)
    exact div_le_div_of_nonneg_right (pow_le_pow_left₀ hx.le hxr 2) (by linarith [hqpos ξ hξ])
  have hNB0 : ∀ (f : Cyl → ℝ) (j : ℕ) (η : Cyl), 0 ≤ NB B.h f j η := fun f j η => norm_nonneg _
  refine ⟨?_, ?_, ?_, ?_⟩
  ·
    rw [hI]; exact hPs.mul hAs
  ·
    intro ξ hξ a ha
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    show qC B.h ξ ^ (-(1/2:ℝ)) * ∫ r' in (0:ℝ)..ξ.1, G (pathPt B.h (shY ξ a) r') =
      qC B.h ξ ^ (-(1/2:ℝ)) * ∫ r' in (0:ℝ)..ξ.1, G (pathPt B.h ξ r')
    congr 1
    rw [intervalIntegral.integral_of_le hξ'.1.le, intervalIntegral.integral_of_le hξ'.1.le]
    refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioc (fun x hx => ?_)
    have hpx := hpath ξ hξ x hx.1
    have e : pathPt B.h (shY ξ a) x = shY (pathPt B.h ξ x) a := by
      unfold pathPt shY
      dsimp only
      rw [add_right_comm]
    show G (pathPt B.h (shY ξ a) x) = G (pathPt B.h ξ x)
    rw [e]
    exact hG.2.1 _ hpx a ha
  ·
    intro ξ hξ hX
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    have hint : ∫ r' in (0:ℝ)..ξ.1, G (pathPt B.h ξ r') = 0 := by
      rw [intervalIntegral.integral_of_le hξ'.1.le]
      have hEq : Set.EqOn (fun x => G (pathPt B.h ξ x)) (fun _ => (0:ℝ)) (Set.Ioc 0 ξ.1) := by
        intro x hx
        exact hG.2.2.1 _ (hpath ξ hξ x hx.1) (Or.inl (le_trans (hXCle ξ hξ x hx.1 hx.2) hX))
      rw [MeasureTheory.setIntegral_congr_fun measurableSet_Ioc hEq]
      simp
    show qC B.h ξ ^ (-(1/2:ℝ)) * ∫ r' in (0:ℝ)..ξ.1, G (pathPt B.h ξ r') = 0
    rw [hint, mul_zero]
  ·
    intro k
    choose Cf bf df hCf using hG.2.2.2
    have hle_sum : ∀ (f : ℕ → ℝ) (i : ℕ), i ≤ k → f i ≤ ∑ j ∈ Finset.range (k + 1), |f j| := by
      intro f i hi
      exact (le_abs_self _).trans (Finset.single_le_sum (f := fun j => |f j|)
        (fun j _ => abs_nonneg _) (Finset.mem_range.mpr (by omega)))
    obtain ⟨Cs, hCs⟩ : ∃ c : ℝ, c = ∑ j ∈ Finset.range (k + 1), |Cf j| := ⟨_, rfl⟩
    obtain ⟨bs, hbs⟩ : ∃ c : ℝ, c = ∑ j ∈ Finset.range (k + 1), |bf j| := ⟨_, rfl⟩
    obtain ⟨Ds, hDs⟩ : ∃ c : ℝ, c = ∑ j ∈ Finset.range (k + 1), |df j| := ⟨_, rfl⟩
    have hCs0 : 0 ≤ Cs := by rw [hCs]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
    have hED : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 < edgeDist B.Xa B.Xb X := by
      intro X e1 e2
      have hX0 : 0 < X := lt_trans hXa e1
      unfold edgeDist
      exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr e1))
        (Real.log_pos ((one_lt_div hX0).mpr e2)))
    have hEW : ∀ X : ℝ, 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X := by
      intro X
      unfold edgeWeight
      split_ifs
      · positivity
      · exact le_rfl

    have hunif : ∀ η ∈ DomC B.h qs, B.Xa < XC B.h η → XC B.h η < B.Xb → ∀ i ≤ k,
        NB B.h G i η ≤ Cs * qC B.h η ^ (B.h * α) * SC B.h η ^ bs *
          (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h η) * edgeDist B.Xa B.Xb (XC B.h η) ^ (-Ds)) := by
      intro η hη e1 e2 i hi
      have hS1 : 1 ≤ SC B.h η := by
        unfold SC; exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h η))])
      have hd0 := hED _ e1 e2
      have hd1 : edgeDist B.Xa B.Xb (XC B.h η) ≤ 1 := min_le_left _ _
      have hw := hEW (XC B.h η)
      have p1 : 0 ≤ qC B.h η ^ (B.h * α) := Real.rpow_nonneg (hqpos η hη).le _
      have hc : Cf i ≤ Cs := by rw [hCs]; exact hle_sum Cf i hi
      have hb : SC B.h η ^ bf i ≤ SC B.h η ^ bs :=
        Real.rpow_le_rpow_of_exponent_le hS1 (by rw [hbs]; exact hle_sum bf i hi)
      have hd : edgeDist B.Xa B.Xb (XC B.h η) ^ (-df i) ≤ edgeDist B.Xa B.Xb (XC B.h η) ^ (-Ds) :=
        Real.rpow_le_rpow_of_exponent_ge hd0 hd1 (by have := hle_sum df i hi; rw [hDs]; linarith)
      have p2 : 0 ≤ SC B.h η ^ bf i := Real.rpow_nonneg (by linarith) _
      have p2' : 0 ≤ SC B.h η ^ bs := Real.rpow_nonneg (by linarith) _
      have p3 : 0 ≤ edgeDist B.Xa B.Xb (XC B.h η) ^ (-df i) := Real.rpow_nonneg hd0.le _
      calc NB B.h G i η ≤ Cf i * qC B.h η ^ (B.h * α) * SC B.h η ^ bf i *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h η) * edgeDist B.Xa B.Xb (XC B.h η) ^ (-df i) :=
            hCf i η hη e1 e2
        _ = Cf i * (qC B.h η ^ (B.h * α) * SC B.h η ^ bf i *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h η) * edgeDist B.Xa B.Xb (XC B.h η) ^ (-df i)) := by
            ring
        _ ≤ Cs * (qC B.h η ^ (B.h * α) * SC B.h η ^ bf i *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h η) * edgeDist B.Xa B.Xb (XC B.h η) ^ (-df i)) :=
            mul_le_mul_of_nonneg_right hc (mul_nonneg (mul_nonneg (mul_nonneg p1 p2) hw) p3)
        _ ≤ Cs * (qC B.h η ^ (B.h * α) * SC B.h η ^ bs *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h η) * edgeDist B.Xa B.Xb (XC B.h η) ^ (-Ds)) :=
            mul_le_mul_of_nonneg_left (mul_le_mul (mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left hb p1) hw) hd p3 (mul_nonneg (mul_nonneg p1 p2') hw)) hCs0
        _ = _ := by ring

    obtain ⟨K, -, -, hK1, -, -⟩ :=
      edge_compare_v4 B.Xa B.Xb B.m1 B.m2 B.aa B.ab Ds hXa hXam1 hm12.le hm2Xb haa hab

    have hs5 : ∀ (ψ : ℝ → ℝ) (a r M : ℝ), 0 ≤ r → (∀ x, 0 ≤ ψ x) →
        (∀ x, 0 < x → x ≤ r → x ≠ a → ψ x ≤ M) → ∫ x in (0:ℝ)..r, ψ x ≤ M * r := by
      intro ψ a r M hr hψ0 hψM
      rw [intervalIntegral.integral_of_le hr]
      have hle : ∫ x in Set.Ioc 0 r, ψ x ≤ ∫ x in Set.Ioc 0 r, M := by
        apply MeasureTheory.integral_mono_of_nonneg
        · exact Filter.Eventually.of_forall (fun x => hψ0 x)
        · exact MeasureTheory.integrable_const M
        · have h1 : ∀ᵐ x ∂(MeasureTheory.volume : MeasureTheory.Measure ℝ), x ≠ a := by
            rw [MeasureTheory.ae_iff]; simp
          filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioc,
            MeasureTheory.ae_restrict_of_ae h1] with x hx hxa
          exact hψM x hx.1 hx.2 hxa
      rw [MeasureTheory.setIntegral_const, Real.volume_real_Ioc_of_le hr, smul_eq_mul, sub_zero,
        mul_comm] at hle
      exact hle

    choose C4 hC4 using hAb
    have hPb := (qpow_profile_nb_v4 B qs hok hSN hqs0 hqs1 (fun _ => (1:ℝ)) (-(1/2:ℝ))
      contDiffOn_const).2
    have hPb' : ∀ j : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h P j ξ ≤ C * qC B.h ξ ^ (-(1/2:ℝ)) := by
      intro j
      obtain ⟨C, hC⟩ := hPb j
      refine ⟨C, fun ξ hξ h1 h2 => ?_⟩
      refine le_trans (le_of_eq ?_) (hC ξ hξ h1 h2)
      rw [hP]
      congr 1
      funext η
      simp
    choose C6 hC6 using hPb'
    obtain ⟨Csum, hCsum⟩ : ∃ c : ℝ,
        c = ∑ j ∈ Finset.range (k + 1), (k.choose j : ℝ) * |C6 j| * |C4 (k - j)| := ⟨_, rfl⟩
    refine ⟨Csum * ((k:ℝ) + 1) * Real.sqrt (2 * B.Xb) * Cs * K, bs, Ds, ?_⟩
    intro ξ hξ h1 h2 h3
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    have hq : 0 < qC B.h ξ := hqpos ξ hξ
    have h2q : 0 < 2 * qC B.h ξ := by linarith
    obtain ⟨E, hE⟩ : ∃ E : ℝ, E = edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-Ds) := ⟨_, rfl⟩
    have hE0 : 0 ≤ E := by
      rw [hE]; exact mul_nonneg (hEW _) (Real.rpow_nonneg (hED _ h1 h2).le _)
    have hKE : E ≤ K * E := by rw [hE]; exact hK1 _ _ h1 le_rfl h3
    have hKE0 : 0 ≤ K * E := hE0.trans hKE
    have hcoef0 : 0 ≤ Cs * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bs :=
      mul_nonneg (mul_nonneg hCs0 (Real.rpow_nonneg hq.le _))
        (Real.rpow_nonneg (by unfold SC; positivity) _)
    obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = Cs * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bs * (K * E) := ⟨_, rfl⟩
    have hM0 : 0 ≤ M := by rw [hMdef]; exact mul_nonneg hcoef0 hKE0
    have hR : ξ.1 ≤ Real.sqrt (2 * B.Xb * qC B.h ξ) := by
      have h2' : ξ.1 ^ 2 / (2 * qC B.h ξ) < B.Xb := h2
      rw [div_lt_iff₀ h2q] at h2'
      exact ((Real.lt_sqrt hξ'.1.le).mpr (by linarith)).le
    have hMR0 : 0 ≤ M * Real.sqrt (2 * B.Xb * qC B.h ξ) := mul_nonneg hM0 (Real.sqrt_nonneg _)

    have hpb : ∀ i ≤ k, ∫ x in (0:ℝ)..ξ.1, NB B.h G i (pathPt B.h ξ x) ≤
        M * Real.sqrt (2 * B.Xb * qC B.h ξ) := by
      intro i hi
      refine le_trans (hs5 (fun x => NB B.h G i (pathPt B.h ξ x)) (Real.sqrt (2 * B.Xa * qC B.h ξ))
        ξ.1 M hξ'.1.le (fun x => hNB0 _ _ _) ?_) (mul_le_mul_of_nonneg_left hR hM0)
      intro x hx0 hxr hxa
      have hpx := hpath ξ hξ x hx0
      have hXle := hXCle ξ hξ x hx0 hxr
      show NB B.h G i (pathPt B.h ξ x) ≤ M
      rcases lt_trichotomy (x ^ 2) (2 * B.Xa * qC B.h ξ) with hlt | heq | hgt
      · have hXlt : XC B.h (pathPt B.h ξ x) < B.Xa := by
          show x ^ 2 / (2 * qC B.h ξ) < B.Xa
          rw [div_lt_iff₀ h2q]
          linarith
        have hW : IsOpen (DomC B.h qs ∩ XC B.h ⁻¹' Set.Iio B.Xa) :=
          hXCc.isOpen_inter_preimage hDo isOpen_Iio
        have hev : G =ᶠ[nhds (pathPt B.h ξ x)] fun _ => (0:ℝ) :=
          Filter.eventuallyEq_of_mem (hW.mem_nhds (Set.mem_inter hpx hXlt))
            (fun η hη => hG.2.2.1 η hη.1 (Or.inl (le_of_lt (hη.2 : XC B.h η < B.Xa))))
        have h0 : iteratedFDeriv ℝ i G (pathPt B.h ξ x) = 0 := by
          rw [(hev.iteratedFDeriv ℝ i).eq_of_nhds, iteratedFDeriv_fun_zero]
          rfl
        have hz : (0 : ContinuousMultilinearMap ℝ (fun _ : Fin i => Cyl) ℝ).compContinuousLinearMap
            (fun _ => Lnorm B.h (pathPt B.h ξ x)) = 0 := by
          ext v; simp
        unfold NB
        rw [h0, hz, norm_zero]
        exact hM0
      · exfalso
        apply hxa
        rw [← heq, Real.sqrt_sq hx0.le]
      · have hXgt : B.Xa < XC B.h (pathPt B.h ξ x) := by
          show B.Xa < x ^ 2 / (2 * qC B.h ξ)
          rw [lt_div_iff₀ h2q]
          linarith
        have hb := hunif (pathPt B.h ξ x) hpx hXgt (lt_of_le_of_lt hXle h2) i hi
        have hK := hK1 _ _ hXgt hXle h3
        rw [hMdef, hE]
        exact le_trans hb (mul_le_mul_of_nonneg_left hK hcoef0)

    have hAm : ∀ m ≤ k, NB B.h A m ξ ≤ |C4 m| * (((k:ℝ) + 1) * (M * Real.sqrt (2 * B.Xb * qC B.h ξ))) := by
      intro m hm
      obtain ⟨hb1, -⟩ := hC4 m ξ hξ h1 h2
      have hS0 : 0 ≤ ∑ i ∈ Finset.range (m + 1), ∫ x in (0:ℝ)..ξ.1, NB B.h G i (pathPt B.h ξ x) :=
        Finset.sum_nonneg (fun i _ => intervalIntegral.integral_nonneg hξ'.1.le (fun u _ => hNB0 _ _ _))
      have hS : ∑ i ∈ Finset.range (m + 1), ∫ x in (0:ℝ)..ξ.1, NB B.h G i (pathPt B.h ξ x) ≤
          ((k:ℝ) + 1) * (M * Real.sqrt (2 * B.Xb * qC B.h ξ)) := by
        calc ∑ i ∈ Finset.range (m + 1), ∫ x in (0:ℝ)..ξ.1, NB B.h G i (pathPt B.h ξ x)
            ≤ ∑ i ∈ Finset.range (m + 1), M * Real.sqrt (2 * B.Xb * qC B.h ξ) :=
              Finset.sum_le_sum (fun i hi => hpb i (by have := Finset.mem_range.mp hi; omega))
          _ = ((m:ℝ) + 1) * (M * Real.sqrt (2 * B.Xb * qC B.h ξ)) := by
              rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]; push_cast; ring
          _ ≤ ((k:ℝ) + 1) * (M * Real.sqrt (2 * B.Xb * qC B.h ξ)) :=
              mul_le_mul_of_nonneg_right (by have : (m:ℝ) ≤ k := Nat.cast_le.mpr hm; linarith) hMR0
      calc NB B.h A m ξ ≤ C4 m * ∑ i ∈ Finset.range (m + 1),
            ∫ x in (0:ℝ)..ξ.1, NB B.h G i (pathPt B.h ξ x) := hb1
        _ ≤ |C4 m| * ∑ i ∈ Finset.range (m + 1),
            ∫ x in (0:ℝ)..ξ.1, NB B.h G i (pathPt B.h ξ x) :=
            mul_le_mul_of_nonneg_right (le_abs_self _) hS0
        _ ≤ _ := mul_le_mul_of_nonneg_left hS (abs_nonneg _)

    have hPj : ∀ j : ℕ, NB B.h P j ξ ≤ |C6 j| * qC B.h ξ ^ (-(1/2:ℝ)) := fun j =>
      le_trans (hC6 j ξ hξ h1 h2) (mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hq.le _))
    have hqR : qC B.h ξ ^ (-(1/2:ℝ)) * Real.sqrt (2 * B.Xb * qC B.h ξ) = Real.sqrt (2 * B.Xb) := by
      rw [Real.sqrt_mul (by linarith) (qC B.h ξ), Real.sqrt_eq_rpow (qC B.h ξ), mul_left_comm,
        ← Real.rpow_add hq]
      norm_num
    have hprod := nb_mul_le_v4 B.h (DomC B.h qs) P A hDo hPs hAs ξ hξ k
    rw [hI]
    calc NB B.h (fun η => P η * A η) k ξ
        ≤ ∑ j ∈ Finset.range (k + 1), (k.choose j : ℝ) * NB B.h P j ξ * NB B.h A (k - j) ξ := hprod
      _ ≤ ∑ j ∈ Finset.range (k + 1), (k.choose j : ℝ) * (|C6 j| * qC B.h ξ ^ (-(1/2:ℝ))) *
            (|C4 (k - j)| * (((k:ℝ) + 1) * (M * Real.sqrt (2 * B.Xb * qC B.h ξ)))) := by
          refine Finset.sum_le_sum (fun j _ => ?_)
          exact mul_le_mul (mul_le_mul_of_nonneg_left (hPj j) (Nat.cast_nonneg _))
            (hAm (k - j) (Nat.sub_le k j)) (hNB0 _ _ _)
            (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (abs_nonneg _) (Real.rpow_nonneg hq.le _)))
      _ = Csum * ((k:ℝ) + 1) * (qC B.h ξ ^ (-(1/2:ℝ)) * Real.sqrt (2 * B.Xb * qC B.h ξ)) * M := by
          rw [hCsum, Finset.sum_mul, Finset.sum_mul, Finset.sum_mul]
          exact Finset.sum_congr rfl (fun j _ => by ring)
      _ = _ := by rw [hqR, hMdef, hE]; ring

theorem icut_outer_class_v4 : ∀ (B : BG) (qs α : ℝ), B.ok → SimNorm B.h → 0 < qs → qs ≤ 1 →
    ∀ G : Cyl → ℝ, InM B qs α G →
    ContDiffOn ℝ ∞ (icutOuter4 B G) (DomC B.h qs) ∧
    (∀ ξ ∈ DomC B.h qs, ∀ a, IsDeck B.h (qC B.h ξ) a → icutOuter4 B G (shY ξ a) = icutOuter4 B G ξ) ∧
    (∀ ξ ∈ DomC B.h qs, B.Xb ≤ XC B.h ξ → icutOuter4 B G ξ = 0) ∧
    ∀ k : ℕ, ∃ C b d : ℝ, ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → B.m1 ≤ XC B.h ξ →
      NB B.h (icutOuter4 B G) k ξ ≤ C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b *
        edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) :=
by
  intro B qs α hok hSN hqs0 hqs1 G hG
  obtain ⟨hDo, hqCs, hqpos, hXCc, -, -⟩ := domc_open_calculus B qs hok
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -, -, -, -, -, haa, hab⟩ := hok.2.1

  obtain ⟨P, hP⟩ : ∃ P : Cyl → ℝ, P = fun η => qC B.h η ^ (-(1/2:ℝ)) := ⟨_, rfl⟩
  obtain ⟨U, hU⟩ : ∃ U : Cyl → ℝ, U = fun η => ∫ r' in Set.Ioi η.1, G (pathPt B.h η r') := ⟨_, rfl⟩
  have hI : icutOuter4 B G = fun η => P η * U η := by subst hP hU; rfl
  obtain ⟨-, hUs, hUb⟩ := path_integral_nb_v4 B qs hok hqs0 hqs1 G hG.1 hG.2.2.1
  rw [← hU] at hUs hUb
  have hPs : ContDiffOn ℝ ∞ P (DomC B.h qs) := by
    rw [hP]; exact hqCs.rpow_const_of_ne (fun x hx => (hqpos x hx).ne')

  have hpath : ∀ ξ ∈ DomC B.h qs, ∀ x : ℝ, 0 < x → pathPt B.h ξ x ∈ DomC B.h qs := by
    intro ξ hξ x hx
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    exact show 0 < x ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs from ⟨hx, hξ'.2.1, hξ'.2.2⟩
  have hXCge : ∀ ξ ∈ DomC B.h qs, ∀ x : ℝ, ξ.1 ≤ x →
      XC B.h ξ ≤ XC B.h (pathPt B.h ξ x) := by
    intro ξ hξ x hxr
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    show ξ.1 ^ 2 / (2 * qC B.h ξ) ≤ x ^ 2 / (2 * qC B.h ξ)
    exact div_le_div_of_nonneg_right (pow_le_pow_left₀ hξ'.1.le hxr 2) (by linarith [hqpos ξ hξ])
  have hNB0 : ∀ (f : Cyl → ℝ) (j : ℕ) (η : Cyl), 0 ≤ NB B.h f j η := fun f j η => norm_nonneg _
  refine ⟨?_, ?_, ?_, ?_⟩
  ·
    rw [hI]; exact hPs.mul hUs
  ·
    intro ξ hξ a ha
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    show qC B.h ξ ^ (-(1/2:ℝ)) * ∫ r' in Set.Ioi ξ.1, G (pathPt B.h (shY ξ a) r') =
      qC B.h ξ ^ (-(1/2:ℝ)) * ∫ r' in Set.Ioi ξ.1, G (pathPt B.h ξ r')
    congr 1
    refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun x hx => ?_)
    have hx0 : 0 < x := lt_trans hξ'.1 hx
    have hpx := hpath ξ hξ x hx0
    have e : pathPt B.h (shY ξ a) x = shY (pathPt B.h ξ x) a := by
      unfold pathPt shY
      dsimp only
      rw [add_right_comm]
    show G (pathPt B.h (shY ξ a) x) = G (pathPt B.h ξ x)
    rw [e]
    exact hG.2.1 _ hpx a ha
  ·
    intro ξ hξ hX
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    have hint : ∫ r' in Set.Ioi ξ.1, G (pathPt B.h ξ r') = 0 := by
      have hEq : Set.EqOn (fun x => G (pathPt B.h ξ x)) (fun _ => (0:ℝ)) (Set.Ioi ξ.1) := by
        intro x hx
        have hx' : ξ.1 < x := hx
        exact hG.2.2.1 _ (hpath ξ hξ x (lt_trans hξ'.1 hx'))
          (Or.inr (le_trans hX (hXCge ξ hξ x hx'.le)))
      rw [MeasureTheory.setIntegral_congr_fun measurableSet_Ioi hEq]
      simp
    show qC B.h ξ ^ (-(1/2:ℝ)) * ∫ r' in Set.Ioi ξ.1, G (pathPt B.h ξ r') = 0
    rw [hint, mul_zero]
  ·
    intro k
    choose Cf bf df hCf using hG.2.2.2
    have hle_sum : ∀ (f : ℕ → ℝ) (i : ℕ), i ≤ k → f i ≤ ∑ j ∈ Finset.range (k + 1), |f j| := by
      intro f i hi
      exact (le_abs_self _).trans (Finset.single_le_sum (f := fun j => |f j|)
        (fun j _ => abs_nonneg _) (Finset.mem_range.mpr (by omega)))
    obtain ⟨Cs, hCs⟩ : ∃ c : ℝ, c = ∑ j ∈ Finset.range (k + 1), |Cf j| := ⟨_, rfl⟩
    obtain ⟨bs, hbs⟩ : ∃ c : ℝ, c = ∑ j ∈ Finset.range (k + 1), |bf j| := ⟨_, rfl⟩
    obtain ⟨Ds, hDs⟩ : ∃ c : ℝ, c = ∑ j ∈ Finset.range (k + 1), |df j| := ⟨_, rfl⟩
    have hCs0 : 0 ≤ Cs := by rw [hCs]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
    have hED : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 < edgeDist B.Xa B.Xb X := by
      intro X e1 e2
      have hX0 : 0 < X := lt_trans hXa e1
      unfold edgeDist
      exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr e1))
        (Real.log_pos ((one_lt_div hX0).mpr e2)))
    have hEW : ∀ X : ℝ, 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X := by
      intro X
      unfold edgeWeight
      split_ifs
      · positivity
      · exact le_rfl

    have hunif : ∀ η ∈ DomC B.h qs, B.Xa < XC B.h η → XC B.h η < B.Xb → ∀ i ≤ k,
        NB B.h G i η ≤ Cs * qC B.h η ^ (B.h * α) * SC B.h η ^ bs *
          (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h η) * edgeDist B.Xa B.Xb (XC B.h η) ^ (-Ds)) := by
      intro η hη e1 e2 i hi
      have hS1 : 1 ≤ SC B.h η := by
        unfold SC; exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h η))])
      have hd0 := hED _ e1 e2
      have hd1 : edgeDist B.Xa B.Xb (XC B.h η) ≤ 1 := min_le_left _ _
      have hw := hEW (XC B.h η)
      have p1 : 0 ≤ qC B.h η ^ (B.h * α) := Real.rpow_nonneg (hqpos η hη).le _
      have hc : Cf i ≤ Cs := by rw [hCs]; exact hle_sum Cf i hi
      have hb : SC B.h η ^ bf i ≤ SC B.h η ^ bs :=
        Real.rpow_le_rpow_of_exponent_le hS1 (by rw [hbs]; exact hle_sum bf i hi)
      have hd : edgeDist B.Xa B.Xb (XC B.h η) ^ (-df i) ≤ edgeDist B.Xa B.Xb (XC B.h η) ^ (-Ds) :=
        Real.rpow_le_rpow_of_exponent_ge hd0 hd1 (by have := hle_sum df i hi; rw [hDs]; linarith)
      have p2 : 0 ≤ SC B.h η ^ bf i := Real.rpow_nonneg (by linarith) _
      have p2' : 0 ≤ SC B.h η ^ bs := Real.rpow_nonneg (by linarith) _
      have p3 : 0 ≤ edgeDist B.Xa B.Xb (XC B.h η) ^ (-df i) := Real.rpow_nonneg hd0.le _
      calc NB B.h G i η ≤ Cf i * qC B.h η ^ (B.h * α) * SC B.h η ^ bf i *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h η) * edgeDist B.Xa B.Xb (XC B.h η) ^ (-df i) :=
            hCf i η hη e1 e2
        _ = Cf i * (qC B.h η ^ (B.h * α) * SC B.h η ^ bf i *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h η) * edgeDist B.Xa B.Xb (XC B.h η) ^ (-df i)) := by
            ring
        _ ≤ Cs * (qC B.h η ^ (B.h * α) * SC B.h η ^ bf i *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h η) * edgeDist B.Xa B.Xb (XC B.h η) ^ (-df i)) :=
            mul_le_mul_of_nonneg_right hc (mul_nonneg (mul_nonneg (mul_nonneg p1 p2) hw) p3)
        _ ≤ Cs * (qC B.h η ^ (B.h * α) * SC B.h η ^ bs *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h η) * edgeDist B.Xa B.Xb (XC B.h η) ^ (-Ds)) :=
            mul_le_mul_of_nonneg_left (mul_le_mul (mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left hb p1) hw) hd p3 (mul_nonneg (mul_nonneg p1 p2') hw)) hCs0
        _ = _ := by ring

    obtain ⟨K, -, -, -, hK2, -⟩ :=
      edge_compare_v4 B.Xa B.Xb B.m1 B.m2 B.aa B.ab Ds hXa hXam1 hm12.le hm2Xb haa hab

    have hs5 : ∀ (ψ : ℝ → ℝ) (a r R M : ℝ), r ≤ R → (∀ x, 0 ≤ ψ x) → (∀ x, R < x → ψ x = 0) →
        (∀ x, r < x → x ≤ R → x ≠ a → ψ x ≤ M) → ∫ x in Set.Ioi r, ψ x ≤ M * (R - r) := by
      intro ψ a r R M hrR hψ0 hψz hψM
      rw [MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero measurableSet_Ioi
        Set.Ioc_subset_Ioi_self (fun x hx => hψz x (by
          have hx1 : r < x := hx.1
          by_contra hc
          exact hx.2 ⟨hx1, not_lt.mp hc⟩))]
      have hle : ∫ x in Set.Ioc r R, ψ x ≤ ∫ x in Set.Ioc r R, M := by
        apply MeasureTheory.integral_mono_of_nonneg
        · exact Filter.Eventually.of_forall (fun x => hψ0 x)
        · exact MeasureTheory.integrable_const M
        · have h1 : ∀ᵐ x ∂(MeasureTheory.volume : MeasureTheory.Measure ℝ), x ≠ a := by
            rw [MeasureTheory.ae_iff]; simp
          filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioc,
            MeasureTheory.ae_restrict_of_ae h1] with x hx hxa
          exact hψM x hx.1 hx.2 hxa
      rw [MeasureTheory.setIntegral_const, Real.volume_real_Ioc_of_le hrR, smul_eq_mul,
        mul_comm] at hle
      exact hle

    choose C4 hC4 using hUb
    have hPb := (qpow_profile_nb_v4 B qs hok hSN hqs0 hqs1 (fun _ => (1:ℝ)) (-(1/2:ℝ))
      contDiffOn_const).2
    have hPb' : ∀ j : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h P j ξ ≤ C * qC B.h ξ ^ (-(1/2:ℝ)) := by
      intro j
      obtain ⟨C, hC⟩ := hPb j
      refine ⟨C, fun ξ hξ h1 h2 => ?_⟩
      refine le_trans (le_of_eq ?_) (hC ξ hξ h1 h2)
      rw [hP]
      congr 1
      funext η
      simp
    choose C6 hC6 using hPb'
    obtain ⟨Csum, hCsum⟩ : ∃ c : ℝ,
        c = ∑ j ∈ Finset.range (k + 1), (k.choose j : ℝ) * |C6 j| * |C4 (k - j)| := ⟨_, rfl⟩
    refine ⟨Csum * ((k:ℝ) + 1) * Real.sqrt (2 * B.Xb) * Cs * K, bs, Ds, ?_⟩
    intro ξ hξ h1 h2 h3
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    have hq : 0 < qC B.h ξ := hqpos ξ hξ
    have h2q : 0 < 2 * qC B.h ξ := by linarith
    obtain ⟨E, hE⟩ : ∃ E : ℝ, E = edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-Ds) := ⟨_, rfl⟩
    have hE0 : 0 ≤ E := by
      rw [hE]; exact mul_nonneg (hEW _) (Real.rpow_nonneg (hED _ h1 h2).le _)
    have hKE : E ≤ K * E := by rw [hE]; exact hK2 _ _ h3 le_rfl h2
    have hKE0 : 0 ≤ K * E := hE0.trans hKE
    have hcoef0 : 0 ≤ Cs * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bs :=
      mul_nonneg (mul_nonneg hCs0 (Real.rpow_nonneg hq.le _))
        (Real.rpow_nonneg (by unfold SC; positivity) _)
    obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = Cs * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bs * (K * E) := ⟨_, rfl⟩
    have hM0 : 0 ≤ M := by rw [hMdef]; exact mul_nonneg hcoef0 hKE0
    obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = Real.sqrt (2 * B.Xb * qC B.h ξ) := ⟨_, rfl⟩
    have hR : ξ.1 ≤ R := by
      have h2' : ξ.1 ^ 2 / (2 * qC B.h ξ) < B.Xb := h2
      rw [div_lt_iff₀ h2q] at h2'
      rw [hRdef]
      exact ((Real.lt_sqrt hξ'.1.le).mpr (by linarith)).le
    have hR0 : 0 < R := lt_of_lt_of_le hξ'.1 hR
    have hMR0 : 0 ≤ M * R := mul_nonneg hM0 hR0.le

    have hpb : ∀ i ≤ k, ∫ x in Set.Ioi ξ.1, NB B.h G i (pathPt B.h ξ x) ≤ M * R := by
      intro i hi
      refine le_trans (hs5 (fun x => NB B.h G i (pathPt B.h ξ x)) R ξ.1 R M hR
        (fun x => hNB0 _ _ _) ?_ ?_) (mul_le_mul_of_nonneg_left (by linarith [hξ'.1]) hM0)
      · intro x hx
        have hx0 : 0 < x := lt_trans hR0 hx
        have hpx := hpath ξ hξ x hx0
        have hXgt : B.Xb < XC B.h (pathPt B.h ξ x) := by
          show B.Xb < x ^ 2 / (2 * qC B.h ξ)
          rw [lt_div_iff₀ h2q]
          have := (Real.sqrt_lt' hx0).mp (by rw [← hRdef]; exact hx)
          linarith
        have hW : IsOpen (DomC B.h qs ∩ XC B.h ⁻¹' Set.Ioi B.Xb) :=
          hXCc.isOpen_inter_preimage hDo isOpen_Ioi
        have hev : G =ᶠ[nhds (pathPt B.h ξ x)] fun _ => (0:ℝ) :=
          Filter.eventuallyEq_of_mem (hW.mem_nhds (Set.mem_inter hpx hXgt))
            (fun η hη => hG.2.2.1 η hη.1 (Or.inr (le_of_lt (hη.2 : B.Xb < XC B.h η))))
        have h0 : iteratedFDeriv ℝ i G (pathPt B.h ξ x) = 0 := by
          rw [(hev.iteratedFDeriv ℝ i).eq_of_nhds, iteratedFDeriv_fun_zero]
          rfl
        have hz : (0 : ContinuousMultilinearMap ℝ (fun _ : Fin i => Cyl) ℝ).compContinuousLinearMap
            (fun _ => Lnorm B.h (pathPt B.h ξ x)) = 0 := by
          ext v; simp
        show NB B.h G i (pathPt B.h ξ x) = 0
        unfold NB
        rw [h0, hz, norm_zero]
      · intro x hxr hxR hxa
        have hx0 : 0 < x := lt_trans hξ'.1 hxr
        have hpx := hpath ξ hξ x hx0
        have hxlt : x < R := lt_of_le_of_ne hxR hxa
        have hXge := hXCge ξ hξ x hxr.le
        have hXlt : XC B.h (pathPt B.h ξ x) < B.Xb := by
          show x ^ 2 / (2 * qC B.h ξ) < B.Xb
          rw [div_lt_iff₀ h2q]
          have := (Real.lt_sqrt hx0.le).mp (by rw [← hRdef]; exact hxlt)
          linarith
        have hXgt : B.Xa < XC B.h (pathPt B.h ξ x) := lt_of_lt_of_le h1 hXge
        have hb := hunif (pathPt B.h ξ x) hpx hXgt hXlt i hi
        have hK := hK2 _ _ h3 hXge hXlt
        show NB B.h G i (pathPt B.h ξ x) ≤ M
        rw [hMdef, hE]
        exact le_trans hb (mul_le_mul_of_nonneg_left hK hcoef0)

    have hUm : ∀ m ≤ k, NB B.h U m ξ ≤ |C4 m| * (((k:ℝ) + 1) * (M * R)) := by
      intro m hm
      obtain ⟨-, hb1⟩ := hC4 m ξ hξ h1 h2
      have hS0 : 0 ≤ ∑ i ∈ Finset.range (m + 1), ∫ x in Set.Ioi ξ.1, NB B.h G i (pathPt B.h ξ x) :=
        Finset.sum_nonneg (fun i _ => MeasureTheory.setIntegral_nonneg measurableSet_Ioi
          (fun u _ => hNB0 _ _ _))
      have hS : ∑ i ∈ Finset.range (m + 1), ∫ x in Set.Ioi ξ.1, NB B.h G i (pathPt B.h ξ x) ≤
          ((k:ℝ) + 1) * (M * R) := by
        calc ∑ i ∈ Finset.range (m + 1), ∫ x in Set.Ioi ξ.1, NB B.h G i (pathPt B.h ξ x)
            ≤ ∑ i ∈ Finset.range (m + 1), M * R :=
              Finset.sum_le_sum (fun i hi => hpb i (by have := Finset.mem_range.mp hi; omega))
          _ = ((m:ℝ) + 1) * (M * R) := by
              rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]; push_cast; ring
          _ ≤ ((k:ℝ) + 1) * (M * R) :=
              mul_le_mul_of_nonneg_right (by have : (m:ℝ) ≤ k := Nat.cast_le.mpr hm; linarith) hMR0
      calc NB B.h U m ξ ≤ C4 m * ∑ i ∈ Finset.range (m + 1),
            ∫ x in Set.Ioi ξ.1, NB B.h G i (pathPt B.h ξ x) := hb1
        _ ≤ |C4 m| * ∑ i ∈ Finset.range (m + 1),
            ∫ x in Set.Ioi ξ.1, NB B.h G i (pathPt B.h ξ x) :=
            mul_le_mul_of_nonneg_right (le_abs_self _) hS0
        _ ≤ _ := mul_le_mul_of_nonneg_left hS (abs_nonneg _)

    have hPj : ∀ j : ℕ, NB B.h P j ξ ≤ |C6 j| * qC B.h ξ ^ (-(1/2:ℝ)) := fun j =>
      le_trans (hC6 j ξ hξ h1 h2) (mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hq.le _))
    have hqR : qC B.h ξ ^ (-(1/2:ℝ)) * R = Real.sqrt (2 * B.Xb) := by
      rw [hRdef, Real.sqrt_mul (by linarith) (qC B.h ξ), Real.sqrt_eq_rpow (qC B.h ξ), mul_left_comm,
        ← Real.rpow_add hq]
      norm_num
    have hprod := nb_mul_le_v4 B.h (DomC B.h qs) P U hDo hPs hUs ξ hξ k
    rw [hI]
    calc NB B.h (fun η => P η * U η) k ξ
        ≤ ∑ j ∈ Finset.range (k + 1), (k.choose j : ℝ) * NB B.h P j ξ * NB B.h U (k - j) ξ := hprod
      _ ≤ ∑ j ∈ Finset.range (k + 1), (k.choose j : ℝ) * (|C6 j| * qC B.h ξ ^ (-(1/2:ℝ))) *
            (|C4 (k - j)| * (((k:ℝ) + 1) * (M * R))) := by
          refine Finset.sum_le_sum (fun j _ => ?_)
          exact mul_le_mul (mul_le_mul_of_nonneg_left (hPj j) (Nat.cast_nonneg _))
            (hUm (k - j) (Nat.sub_le k j)) (hNB0 _ _ _)
            (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (abs_nonneg _) (Real.rpow_nonneg hq.le _)))
      _ = Csum * ((k:ℝ) + 1) * (qC B.h ξ ^ (-(1/2:ℝ)) * R) * M := by
          rw [hCsum, Finset.sum_mul, Finset.sum_mul, Finset.sum_mul]
          exact Finset.sum_congr rfl (fun j _ => by ring)
      _ = _ := by rw [hqR, hMdef, hE]; ring

theorem mom_icut_class_v4 : ∀ (B : BG), B.ok → SimNorm B.h → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (g : Cyl → ℝ) (α : ℝ), InM B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) g) →
      InM B (qsOf l0) α (nrm B (2 * Aex B.h) (Icut B (momDgt B g))) :=
by
  intro B hok hSN
  obtain ⟨l1, hl1⟩ := mom_radial_moment_class_v4 B hok hSN
  refine ⟨l1, ?_⟩
  intro l0 hl0 g α hg
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -⟩ := hok.2.1
  have hqs0 : 0 < qsOf l0 := by unfold qsOf Qb; positivity
  have hqs1 : qsOf l0 ≤ 1 := by
    unfold qsOf Qb
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  obtain ⟨hMc, -⟩ := mom_class_algebra_v4 B (qsOf l0) hok hqs0 hqs1

  have hR := hl1 l0 hl0 g α (2 * Aex B.h + 1/2) 0 (by norm_num) hg
  have e0 : (2 * Aex B.h + 1/2 - (((0:ℕ):ℝ) + 1) / 2) = 2 * Aex B.h := by push_cast; ring
  rw [e0] at hR
  have hRho := rhoP_moment_class_v4 B (qsOf l0) α hok hSN hqs0 hqs1 (radMom g 0) hR
  have hG : InM B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) (momDgt B g)) :=
    hMc α α α 1 (-1) _ _ _ hg hRho le_rfl le_rfl (fun ξ _ => by simp only [nrm, momDgt]; ring)
  set Gf : Cyl → ℝ := nrm B (2 * Aex B.h + 1/2) (momDgt B g) with hGf
  have hGs : ContinuousOn Gf (DomC B.h (qsOf l0)) := hG.1.continuousOn
  have hGz := hG.2.2.1

  obtain ⟨hIs, hId, hIz, hIb⟩ := icut_inner_class_v4 B (qsOf l0) α hok hSN hqs0 hqs1 Gf hG
  obtain ⟨hOs, hOd, hOz, hOb⟩ := icut_outer_class_v4 B (qsOf l0) α hok hSN hqs0 hqs1 Gf hG
  have hm : 0 < B.m2 - B.m1 := by linarith
  have hchi0 : ∀ X, X ≤ B.m1 → chiM B X = 0 := by
    intro X hX
    unfold chiM
    exact Real.smoothTransition.zero_of_nonpos (div_nonpos_of_nonpos_of_nonneg (by linarith) hm.le)
  have hchi1 : ∀ X, B.m2 ≤ X → chiM B X = 1 := by
    intro X hX
    unfold chiM
    exact Real.smoothTransition.one_of_one_le ((one_le_div hm).mpr (by linarith))
  have hchiC : ContDiff ℝ ∞ (chiM B) := by
    have e : chiM B = fun X => Real.smoothTransition ((X - B.m1) / (B.m2 - B.m1)) := rfl
    rw [e]
    exact (Real.smoothTransition.contDiff (n := ⊤)).comp ((contDiff_id.sub contDiff_const).div_const _)
  have hP1 := xc_profile_mul_class_v4 B (qsOf l0) α (fun X => 1 - chiM B X) (Set.Iic B.m2)
    (icutInner4 B Gf) hok hSN hqs0 hqs1 (contDiff_const.sub hchiC) isClosed_Iic
    (fun X hX => by
      have hX' : B.m2 < X := by simpa using hX
      show 1 - chiM B X = 0
      rw [hchi1 X hX'.le, sub_self])
    hIs hId
    (fun ξ hξ h => by
      show (1 - chiM B (XC B.h ξ)) * icutInner4 B Gf ξ = 0
      rcases h with h | h
      · rw [hIz ξ hξ h, mul_zero]
      · rw [hchi1 _ (by linarith), sub_self, zero_mul])
    hIb
  have hP2 := xc_profile_mul_class_v4 B (qsOf l0) α (chiM B) (Set.Ici B.m1)
    (icutOuter4 B Gf) hok hSN hqs0 hqs1 hchiC isClosed_Ici
    (fun X hX => by
      have hX' : X < B.m1 := by simpa using hX
      exact hchi0 X hX'.le)
    hOs hOd
    (fun ξ hξ h => by
      rcases h with h | h
      · rw [hchi0 _ (by linarith), zero_mul]
      · rw [hOz ξ hξ h, mul_zero])
    hOb
  refine hMc α α α 1 (-1) _ _ _ hP1 hP2 le_rfl le_rfl ?_

  intro ξ hξ
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  obtain ⟨hr, ht, hq⟩ := hξ'
  have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hF2 : ∀ r' : ℝ, momDgt B g (pathPt B.h ξ r') =
      qC B.h ξ ^ (-(2 * Aex B.h + 1/2)) * Gf (pathPt B.h ξ r') := by
    intro r'
    show _ = qC B.h ξ ^ (-(2 * Aex B.h + 1/2)) *
      (qC B.h ξ ^ (2 * Aex B.h + 1/2) * momDgt B g (pathPt B.h ξ r'))
    rw [← mul_assoc, ← Real.rpow_add hq0, neg_add_cancel, Real.rpow_zero, one_mul]
  have hpath : ContinuousOn (fun r' : ℝ => pathPt B.h ξ r') (Set.Ioi 0) := by
    intro r' hr'
    have hr0 : (0:ℝ) < r' := hr'
    apply ContinuousAt.continuousWithinAt
    unfold pathPt
    exact continuousAt_id.prodMk (continuousAt_const.prodMk (continuousAt_const.prodMk
      (continuousAt_const.add (((continuousAt_id.rpow_const (Or.inl hr0.ne')).sub
        continuousAt_const).smul continuousAt_const))))
  have hmaps : Set.MapsTo (fun r' : ℝ => pathPt B.h ξ r') (Set.Ioi 0) (DomC B.h (qsOf l0)) := by
    intro r' hr'
    show 0 < r' ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0
    exact ⟨hr', ht, hq⟩
  have hφc : ContinuousOn (fun r' : ℝ => Gf (pathPt B.h ξ r')) (Set.Ioi 0) := hGs.comp hpath hmaps
  have h2q : 0 < 2 * qC B.h ξ := by linarith
  have hvan : ∀ r' : ℝ, 0 < r' → (r' ^ 2 < 2 * B.Xa * qC B.h ξ ∨ 2 * B.Xb * qC B.h ξ < r' ^ 2) →
      Gf (pathPt B.h ξ r') = 0 := by
    intro r' hr0 h
    apply hGz (pathPt B.h ξ r') (hmaps hr0)
    show r' ^ 2 / (2 * qC B.h ξ) ≤ B.Xa ∨ B.Xb ≤ r' ^ 2 / (2 * qC B.h ξ)
    rcases h with h | h
    · left
      rw [div_le_iff₀ h2q]
      nlinarith
    · right
      rw [le_div_iff₀ h2q]
      nlinarith
  have ha : 0 < Real.sqrt (2 * B.Xa * qC B.h ξ) := Real.sqrt_pos.mpr (mul_pos (mul_pos two_pos hXa) hq0)
  have hint : MeasureTheory.IntegrableOn (fun r' : ℝ => Gf (pathPt B.h ξ r')) (Set.Ioi 0) := by
    have hsub : Set.Icc (Real.sqrt (2 * B.Xa * qC B.h ξ)) (Real.sqrt (2 * B.Xb * qC B.h ξ)) ⊆
        Set.Ioi 0 := fun x hx => lt_of_lt_of_le ha hx.1
    refine MeasureTheory.IntegrableOn.of_forall_sdiff_eq_zero
      ((hφc.mono hsub).integrableOn_Icc) measurableSet_Ioi ?_
    intro x hx
    have hx0 : (0:ℝ) < x := hx.1
    apply hvan x hx0
    by_cases h1 : x < Real.sqrt (2 * B.Xa * qC B.h ξ)
    · left
      exact (Real.lt_sqrt hx0.le).mp h1
    · right
      have h2 : Real.sqrt (2 * B.Xb * qC B.h ξ) < x := by
        by_contra h3
        exact hx.2 ⟨not_lt.mp h1, not_lt.mp h3⟩
      exact (Real.sqrt_lt' hx0).mp h2
  have hsplit : ∫ r' in Set.Ioi (0:ℝ), Gf (pathPt B.h ξ r') =
      (∫ r' in (0:ℝ)..ξ.1, Gf (pathPt B.h ξ r')) + ∫ r' in Set.Ioi ξ.1, Gf (pathPt B.h ξ r') := by
    rw [intervalIntegral.integral_of_le hr.le, ← MeasureTheory.setIntegral_union
      Set.Ioc_disjoint_Ioi_same measurableSet_Ioi (hint.mono_set Set.Ioc_subset_Ioi_self)
      (hint.mono_set (Set.Ioi_subset_Ioi hr.le)), Set.Ioc_union_Ioi_eq_Ioi hr.le]
  have h1 : ∫ r' in (0:ℝ)..ξ.1, momDgt B g (pathPt B.h ξ r') =
      qC B.h ξ ^ (-(2 * Aex B.h + 1/2)) * ∫ r' in (0:ℝ)..ξ.1, Gf (pathPt B.h ξ r') := by
    simp_rw [hF2]
    exact intervalIntegral.integral_const_mul _ _
  have h2 : ∫ r' in Set.Ioi (0:ℝ), momDgt B g (pathPt B.h ξ r') =
      qC B.h ξ ^ (-(2 * Aex B.h + 1/2)) * ((∫ r' in (0:ℝ)..ξ.1, Gf (pathPt B.h ξ r')) +
        ∫ r' in Set.Ioi ξ.1, Gf (pathPt B.h ξ r')) := by
    simp_rw [hF2]
    rw [MeasureTheory.integral_const_mul, hsplit]
  have hpow : qC B.h ξ ^ (2 * Aex B.h) * qC B.h ξ ^ (-(2 * Aex B.h + 1/2)) =
      qC B.h ξ ^ (-(1/2:ℝ)) := by
    rw [← Real.rpow_add hq0]
    congr 1
    ring
  simp only [nrm, Icut, icutInner4, icutOuter4]
  rw [h1, h2]
  linear_combination ((∫ r' in (0:ℝ)..ξ.1, Gf (pathPt B.h ξ r')) - chiM B (XC B.h ξ) *
    ((∫ r' in (0:ℝ)..ξ.1, Gf (pathPt B.h ξ r')) + ∫ r' in Set.Ioi ξ.1, Gf (pathPt B.h ξ r'))) * hpow

theorem pmr_reduced_identities_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState), B.ok →
    (∀ (a : Fin 3), ∀ ξ ∈ DomC B.h (qsOf l0), mcor5 B G l0 S a ξ = 0) → ∀ ξ ∈ DomC B.h (qsOf l0),
    EthP5 B G l0 S ξ = dR B.h (Wcov5 B G l0 S 0 1) ξ + 2 * Wcov5 B G l0 S 0 1 ξ / ξ.1 +
      dZ (Wcov5 B G l0 S 2 1) ξ + sBase B 1 ξ ∧
    EzP5 B G l0 S ξ = dR B.h (Wcov5 B G l0 S 0 2) ξ + Wcov5 B G l0 S 0 2 ξ / ξ.1 +
      dZ (fun η => Wcov5 B G l0 S 2 2 η + pmP5 B G l0 S η) ξ + sBase B 2 ξ ∧
    grP5 B G l0 S ξ = -(dR B.h (Wcov5 B G l0 S 0 0) ξ + Wcov5 B G l0 S 0 0 ξ / ξ.1) -
      dZ (Wcov5 B G l0 S 2 0) ξ + Wcov5 B G l0 S 1 1 ξ / ξ.1 ∧
    calJth5 B G l0 S ξ.2.1 ξ.2.2.1 = radMom (Wcov5 B G l0 S 2 1) 2 ξ.2.1 ξ.2.2.1 ∧
    calJz5 B G l0 S ξ.2.1 ξ.2.2.1 = radMom (Wcov5 B G l0 S 2 2) 1 ξ.2.1 ξ.2.2.1 -
      (1/2) * radMom (grP5 B G l0 S) 2 ξ.2.1 ξ.2.2.1 :=
by
  intro B G l0 S hok H ξ hξ
  have hOpen : IsOpen (DomC B.h (qsOf l0)) := (domc_open_calculus B (qsOf l0) hok).1
  have hfd : ∀ (f g : Cyl → ℝ), (∀ η ∈ DomC B.h (qsOf l0), f η = g η) →
      ∀ η ∈ DomC B.h (qsOf l0), fderiv ℝ f η = fderiv ℝ g η := by
    intro f g hfg η hη
    exact (Filter.eventuallyEq_of_mem (hOpen.mem_nhds hη) (fun x hx => hfg x hx)).fderiv_eq
  have hz : ∀ (f : Cyl → ℝ), (∀ η ∈ DomC B.h (qsOf l0), f η = 0) →
      ∀ η ∈ DomC B.h (qsOf l0), dR B.h f η = 0 ∧ dZ f η = 0 ∧ dT f η = 0 := by
    intro f hf η hη
    have e := hfd f (fun _ => (0:ℝ)) hf η hη
    refine ⟨?_, ?_, ?_⟩
    · unfold dR; rw [e]; simp
    · unfold dZ; rw [e]; simp
    · unfold dT; rw [e]; simp
  have hlap : ∀ a : Fin 3, lap0 B.h (mcor5 B G l0 S a) ξ = 0 := by
    intro a
    have ha := hz _ (H a)
    have h1 := (hz (dR B.h (mcor5 B G l0 S a)) (fun η hη => (ha η hη).1) ξ hξ).1
    have h2 := (hz (dZ (mcor5 B G l0 S a)) (fun η hη => (ha η hη).2.1) ξ hξ).2.1
    show dR B.h (dR B.h (mcor5 B G l0 S a)) ξ + dR B.h (mcor5 B G l0 S a) ξ / ξ.1
      + dZ (dZ (mcor5 B G l0 S a)) ξ = 0
    rw [h1, h2, (ha ξ hξ).1]
    simp
  have hdR : ∀ f g : Cyl → ℝ, (∀ η ∈ DomC B.h (qsOf l0), f η = g η) → dR B.h f ξ = dR B.h g ξ := by
    intro f g hfg
    unfold dR
    rw [hfd f g hfg ξ hξ]
  have hdZ : ∀ f g : Cyl → ℝ, (∀ η ∈ DomC B.h (qsOf l0), f η = g η) → dZ f ξ = dZ g ξ := by
    intro f g hfg
    unfold dZ
    rw [hfd f g hfg ξ hξ]
  have hrm : ∀ (f g : Cyl → ℝ) (e : ℕ), (∀ η ∈ DomC B.h (qsOf l0), f η = g η) →
      radMom f e ξ.2.1 ξ.2.2.1 = radMom g e ξ.2.1 ξ.2.2.1 := by
    intro f g e hfg
    unfold radMom
    refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun r hr => ?_)
    have hr' : (0:ℝ) < r := hr
    show r ^ e * yAvg f (r, ξ.2.1, ξ.2.2.1, 0) = r ^ e * yAvg g (r, ξ.2.1, ξ.2.2.1, 0)
    congr 1
    unfold yAvg
    congr 1
    funext Y
    exact hfg _ ⟨hr', hξ.2.1, hξ.2.2⟩
  have T0 := (hz _ (H 0) ξ hξ).2.2
  have T1 := (hz _ (H 1) ξ hξ).2.2
  have T2 := (hz _ (H 2) ξ hξ).2.2
  have Z0 := H 0 ξ hξ
  have Z1 := H 1 ξ hξ
  have Z2 := H 2 ξ hξ
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  ·
    have e01 : dR B.h (fun η => ubase B η 0 * mcor5 B G l0 S 1 η + mcor5 B G l0 S 0 η * ubase B η 1
        + mcor5 B G l0 S 0 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 0 1 η) ξ
        = dR B.h (Wcov5 B G l0 S 0 1) ξ :=
      hdR _ _ (fun η hη => by simp only [H 0 η hη, H 1 η hη]; ring)
    have e21 : dZ (fun η => ubase B η 2 * mcor5 B G l0 S 1 η + ubase B η 1 * mcor5 B G l0 S 2 η
        + mcor5 B G l0 S 2 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 2 1 η) ξ
        = dZ (Wcov5 B G l0 S 2 1) ξ :=
      hdZ _ _ (fun η hη => by simp only [H 1 η hη, H 2 η hη]; ring)
    show dT (mcor5 B G l0 S 1) ξ
        + dR B.h (fun η => ubase B η 0 * mcor5 B G l0 S 1 η + mcor5 B G l0 S 0 η * ubase B η 1
          + mcor5 B G l0 S 0 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 0 1 η) ξ
        + 2 * (ubase B ξ 0 * mcor5 B G l0 S 1 ξ + mcor5 B G l0 S 0 ξ * ubase B ξ 1
          + mcor5 B G l0 S 0 ξ * mcor5 B G l0 S 1 ξ + Wcov5 B G l0 S 0 1 ξ) / ξ.1
        + dZ (fun η => ubase B η 2 * mcor5 B G l0 S 1 η + ubase B η 1 * mcor5 B G l0 S 2 η
          + mcor5 B G l0 S 2 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 2 1 η) ξ
        - (lap0 B.h (mcor5 B G l0 S 1) ξ - mcor5 B G l0 S 1 ξ / ξ.1 ^ 2) + sBase B 1 ξ = _
    rw [T1, e01, e21, hlap 1, Z0, Z1]
    ring
  ·
    have e02 : dR B.h (fun η => ubase B η 0 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 0 η * ubase B η 2
        + mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 0 2 η) ξ
        = dR B.h (Wcov5 B G l0 S 0 2) ξ :=
      hdR _ _ (fun η hη => by simp only [H 0 η hη, H 2 η hη]; ring)
    have e22 : dZ (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η ^ 2
        + Wcov5 B G l0 S 2 2 η + pmP5 B G l0 S η) ξ
        = dZ (fun η => Wcov5 B G l0 S 2 2 η + pmP5 B G l0 S η) ξ :=
      hdZ _ _ (fun η hη => by simp only [H 2 η hη]; ring)
    show dT (mcor5 B G l0 S 2) ξ
        + dR B.h (fun η => ubase B η 0 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 0 η * ubase B η 2
          + mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 0 2 η) ξ
        + (ubase B ξ 0 * mcor5 B G l0 S 2 ξ + mcor5 B G l0 S 0 ξ * ubase B ξ 2
          + mcor5 B G l0 S 0 ξ * mcor5 B G l0 S 2 ξ + Wcov5 B G l0 S 0 2 ξ) / ξ.1
        + dZ (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η ^ 2
          + Wcov5 B G l0 S 2 2 η + pmP5 B G l0 S η) ξ
        - lap0 B.h (mcor5 B G l0 S 2) ξ + sBase B 2 ξ = _
    rw [T2, e02, e22, hlap 2, Z0, Z2]
    ring
  ·
    have e00 : dR B.h (fun η => 2 * ubase B η 0 * mcor5 B G l0 S 0 η + mcor5 B G l0 S 0 η ^ 2
        + Wcov5 B G l0 S 0 0 η) ξ = dR B.h (Wcov5 B G l0 S 0 0) ξ :=
      hdR _ _ (fun η hη => by simp only [H 0 η hη]; ring)
    have e20 : dZ (fun η => ubase B η 0 * mcor5 B G l0 S 2 η + ubase B η 2 * mcor5 B G l0 S 0 η
        + mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 2 0 η) ξ
        = dZ (Wcov5 B G l0 S 2 0) ξ :=
      hdZ _ _ (fun η hη => by simp only [H 0 η hη, H 2 η hη]; ring)
    show (0:ℝ) - dT (mcor5 B G l0 S 0) ξ
        - (dR B.h (fun η => 2 * ubase B η 0 * mcor5 B G l0 S 0 η + mcor5 B G l0 S 0 η ^ 2
            + Wcov5 B G l0 S 0 0 η) ξ
          + (2 * ubase B ξ 0 * mcor5 B G l0 S 0 ξ + mcor5 B G l0 S 0 ξ ^ 2 + Wcov5 B G l0 S 0 0 ξ) / ξ.1)
        - dZ (fun η => ubase B η 0 * mcor5 B G l0 S 2 η + ubase B η 2 * mcor5 B G l0 S 0 η
            + mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 2 0 η) ξ
        + (2 * ubase B ξ 1 * mcor5 B G l0 S 1 ξ + mcor5 B G l0 S 1 ξ ^ 2 + Wcov5 B G l0 S 1 1 ξ) / ξ.1
        + (lap0 B.h (mcor5 B G l0 S 0) ξ - mcor5 B G l0 S 0 ξ / ξ.1 ^ 2) = _
    rw [T0, e00, e20, hlap 0, Z0, Z1]
    ring
  ·
    unfold calJth5
    refine hrm _ _ _ ?_
    intro η hη
    simp only [H 1 η hη, H 2 η hη]
    ring
  ·
    unfold calJz5
    congr 1
    refine hrm _ _ _ ?_
    intro η hη
    simp only [H 2 η hη]
    ring

theorem pmr_mu2_nb_v5 : ∀ (B : BG) (l0 : ℕ), B.ok → (∀ ξ ∈ DomC B.h (qsOf l0), ContDiffAt ℝ ∞ (fun η : Cyl => (((B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun ζ => Real.log (qC B.h ζ)) η : ℝ)) : ℂ)) ξ) ∧ (∀ (ξ : Cyl) (c : ℝ × ℝ), (((B.h * qC B.h (shY ξ c) ^ (1/2:ℝ) * dZ (fun ζ => Real.log (qC B.h ζ)) (shY ξ c) : ℝ)) : ℂ) = (((B.h * qC B.h ξ ^ (1/2:ℝ) * dZ (fun ζ => Real.log (qC B.h ζ)) ξ : ℝ)) : ℂ)) ∧ ∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h (qsOf l0), NB B.h (fun η : Cyl => (((B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun ζ => Real.log (qC B.h ζ)) η : ℝ)) : ℂ)) k ξ ≤ C * qC B.h ξ ^ B.h :=
by
  intro B l0 hok
  have hh0 : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  have hqs0 : 0 < qsOf l0 := by
    show (0:ℝ) < (2:ℝ) ^ (-(l0:ℝ))
    positivity
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  obtain ⟨hOpen, hqCsm, hq0, -, hcal, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hSN : SimNorm B.h := simscale_normalized_v4 B.h hh0 hh1 hok.1
  have hs : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η ^ (1/2:ℝ)) (DomC B.h (qsOf l0)) :=
    hqCsm.rpow_const_of_ne (fun η hη => (hq0 η hη).ne')
  have hlog : ContDiffOn ℝ ∞ (fun ζ : Cyl => Real.log (qC B.h ζ)) (DomC B.h (qsOf l0)) :=
    hqCsm.log (fun η hη => (hq0 η hη).ne')

  obtain ⟨G, hG⟩ : ∃ G : (Cyl →L[ℝ] ℝ) →L[ℝ] ℂ, G = (2 * B.h) •
      (Complex.ofRealCLM.comp
        (ContinuousLinearMap.apply ℝ ℝ (((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ)) : Cyl))) := ⟨_, rfl⟩
  have hGapp : ∀ T : Cyl →L[ℝ] ℝ,
      G T = (((2 * B.h * T (((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ)) : Cyl)) : ℝ) : ℂ) := by
    intro T
    rw [hG, ContinuousLinearMap.smul_apply, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.apply_apply, Complex.ofRealCLM_apply, Complex.real_smul]
    push_cast
    ring

  have hshift : ∀ (ξ : Cyl) (f : Cyl → ℝ) (k : ℕ), 0 < qC B.h ξ → ContDiffAt ℝ ∞ f ξ →
      NB B.h (fun η => G (fderiv ℝ f η)) k ξ ≤
        |2 * B.h| * (qC B.h ξ ^ (B.h - 1/2) * NB B.h f (k + 1) ξ) := by
    intro ξ f k hq hf
    have hfd : ContDiffAt ℝ (k : WithTop ℕ∞) (fderiv ℝ f) ξ :=
      hf.fderiv_right (by exact_mod_cast le_top)
    have hcomp : iteratedFDeriv ℝ k (fun η => G (fderiv ℝ f η)) ξ =
        G.compContinuousMultilinearMap (iteratedFDeriv ℝ k (fderiv ℝ f) ξ) :=
      ContinuousLinearMap.iteratedFDeriv_comp_left G hfd (i := k) le_rfl
    obtain ⟨w, hw⟩ : ∃ w : Cyl, w = ((0:ℝ), qC B.h ξ ^ (B.h - 1/2), (0:ℝ), (0 : ℝ × ℝ)) := ⟨_, rfl⟩
    have hwpos : 0 ≤ qC B.h ξ ^ (B.h - 1/2) := Real.rpow_nonneg hq.le _
    have he : qC B.h ξ ^ (2⁻¹ - B.h) * qC B.h ξ ^ (B.h - 2⁻¹) = 1 := by
      rw [← Real.rpow_add hq, show (2⁻¹ - B.h + (B.h - 2⁻¹) : ℝ) = 0 by ring, Real.rpow_zero]
    have hwpos' : 0 ≤ qC B.h ξ ^ (B.h - 2⁻¹) := Real.rpow_nonneg hq.le _
    have hLw : Lnorm B.h ξ w = (((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ)) : Cyl) := by
      rw [hw]
      simp [Lnorm, ContinuousLinearMap.coe_prodMap', he]
    have hnw : ‖w‖ ≤ qC B.h ξ ^ (B.h - 1/2) := by
      rw [hw, Prod.norm_mk]
      refine max_le (by simp [hwpos, hwpos']) ?_
      rw [Prod.norm_mk]
      refine max_le (by rw [Real.norm_eq_abs, abs_of_nonneg hwpos]) ?_
      rw [Prod.norm_mk]
      exact max_le (by simp [hwpos, hwpos']) (by simp [hwpos, hwpos'])
    unfold NB
    rw [hcomp]
    have hM0 : 0 ≤ |2 * B.h| * (qC B.h ξ ^ (B.h - 1/2) *
        ‖(iteratedFDeriv ℝ (k + 1) f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖) :=
      mul_nonneg (abs_nonneg _) (mul_nonneg hwpos (norm_nonneg _))
    refine ContinuousMultilinearMap.opNorm_le_bound hM0 (fun v => ?_)
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply,
      ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply, hGapp]
    have hsucc : (iteratedFDeriv ℝ k (fderiv ℝ f) ξ (fun i => Lnorm B.h ξ (v i)))
        (((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ)) : Cyl) =
        ((iteratedFDeriv ℝ (k + 1) f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ))
          (Fin.snoc v w) := by
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_succ_apply_right]
      have h1 : Fin.init (fun i : Fin (k + 1) => Lnorm B.h ξ (Fin.snoc (α := fun _ => Cyl) v w i)) =
          fun i => Lnorm B.h ξ (v i) := by
        funext i
        simp [Fin.init]
      rw [h1]
      simp only [Fin.snoc_last, hLw]
    rw [hsucc, Complex.norm_real, Real.norm_eq_abs, abs_mul]
    have hb := ContinuousMultilinearMap.le_opNorm
      ((iteratedFDeriv ℝ (k + 1) f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) (Fin.snoc v w)
    rw [Fin.prod_univ_castSucc] at hb
    simp only [Fin.snoc_castSucc, Fin.snoc_last] at hb
    rw [Real.norm_eq_abs] at hb
    generalize ((iteratedFDeriv ℝ (k + 1) f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) = T at hb ⊢
    have hprod : 0 ≤ ∏ i, ‖v i‖ := Finset.prod_nonneg (fun i _ => norm_nonneg _)
    calc |2 * B.h| * |T (Fin.snoc v w)|
        ≤ |2 * B.h| * (‖T‖ * ((∏ i, ‖v i‖) * qC B.h ξ ^ (B.h - 1/2))) :=
          mul_le_mul_of_nonneg_left (hb.trans (mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left hnw hprod) (norm_nonneg _))) (abs_nonneg _)
      _ = |2 * B.h| * (qC B.h ξ ^ (B.h - 1/2) * ‖T‖) * ∏ i, ‖v i‖ := by ring

  have hid : ∀ η ∈ DomC B.h (qsOf l0), B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun ζ => Real.log (qC B.h ζ)) η =
      2 * B.h * dZ (fun ζ => qC B.h ζ ^ (1/2:ℝ)) η := by
    intro η hη
    have hqη := hq0 η hη
    have hD : HasFDerivAt (qC B.h) (fderiv ℝ (qC B.h) η) η :=
      ((hqCsm.contDiffAt (hOpen.mem_nhds hη)).differentiableAt (by norm_num)).hasFDerivAt
    have e1 := (hD.log hqη.ne').fderiv
    have e2 := (hD.rpow_const (p := (1/2:ℝ)) (Or.inl hqη.ne')).fderiv
    unfold dZ
    rw [e1, e2]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [Real.rpow_sub_one hqη.ne']
    field_simp
  refine ⟨?_, ?_, ?_⟩
  ·
    intro ξ hξ
    have hm : ContDiffOn ℝ ∞ (fun η : Cyl => B.h * qC B.h η ^ (1/2:ℝ) *
        dZ (fun ζ => Real.log (qC B.h ζ)) η) (DomC B.h (qsOf l0)) :=
      (contDiffOn_const.mul hs).mul (hcal _ hlog).2.1
    have := (Complex.ofRealCLM.contDiff (n := ∞)).contDiffAt.comp ξ (hm.contDiffAt (hOpen.mem_nhds hξ))
    simpa [Function.comp_def] using this
  ·
    intro ξ c
    obtain ⟨a, ha⟩ : ∃ a : Cyl, a = ((0:ℝ), (0:ℝ), (0:ℝ), c) := ⟨_, rfl⟩
    have e1 : shY ξ c = ξ + a := by
      rw [ha]
      ext <;> simp [shY]
    have h3 : fderiv ℝ (fun ζ : Cyl => Real.log (qC B.h ζ)) (ξ + a) =
        fderiv ℝ (fun ζ : Cyl => Real.log (qC B.h ζ)) ξ := by
      rw [← fderiv_comp_add_right a]
      congr 1
      funext x
      simp [qC, ha]
    have hd : dZ (fun ζ => Real.log (qC B.h ζ)) (shY ξ c) = dZ (fun ζ => Real.log (qC B.h ζ)) ξ := by
      unfold dZ
      rw [e1, h3]
    have hq : qC B.h (shY ξ c) = qC B.h ξ := rfl
    rw [hq, hd]
  ·
    intro k
    obtain ⟨C', hC'⟩ := nb_qpow_v4 B (qsOf l0) (1/2) hok hSN hqs0 hqs1 (k + 1)
    refine ⟨|2 * B.h| * C', fun ξ hξ => ?_⟩
    have hq := hq0 ξ hξ
    have hsA : ContDiffAt ℝ ∞ (fun ζ : Cyl => qC B.h ζ ^ (1/2:ℝ)) ξ := hs.contDiffAt (hOpen.mem_nhds hξ)
    have hgerm : (fun η : Cyl => (((B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun ζ => Real.log (qC B.h ζ)) η : ℝ)) : ℂ))
        =ᶠ[nhds ξ] (fun η => G (fderiv ℝ (fun ζ : Cyl => qC B.h ζ ^ (1/2:ℝ)) η)) := by
      refine Filter.eventuallyEq_of_mem (hOpen.mem_nhds hξ) (fun η hη => ?_)
      show (((B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun ζ => Real.log (qC B.h ζ)) η : ℝ)) : ℂ) =
        G (fderiv ℝ (fun ζ : Cyl => qC B.h ζ ^ (1/2:ℝ)) η)
      rw [hid η hη, hGapp]
      rfl
    have hNBeq : NB B.h (fun η : Cyl => (((B.h * qC B.h η ^ (1/2:ℝ) *
        dZ (fun ζ => Real.log (qC B.h ζ)) η : ℝ)) : ℂ)) k ξ =
        NB B.h (fun η => G (fderiv ℝ (fun ζ : Cyl => qC B.h ζ ^ (1/2:ℝ)) η)) k ξ := by
      unfold NB
      rw [(hgerm.iteratedFDeriv ℝ k).eq_of_nhds]
    rw [hNBeq]
    calc _ ≤ |2 * B.h| * (qC B.h ξ ^ (B.h - 1/2) *
          NB B.h (fun ζ : Cyl => qC B.h ζ ^ (1/2:ℝ)) (k + 1) ξ) := hshift ξ _ k hq hsA
      _ ≤ |2 * B.h| * (qC B.h ξ ^ (B.h - 1/2) * (C' * qC B.h ξ ^ (1/2:ℝ))) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (hC' ξ hξ)
            (Real.rpow_nonneg hq.le _)) (abs_nonneg _)
      _ = |2 * B.h| * C' * (qC B.h ξ ^ (B.h - 1/2) * qC B.h ξ ^ (1/2:ℝ)) := by ring
      _ = |2 * B.h| * C' * qC B.h ξ ^ B.h := by
          rw [← Real.rpow_add hq, sub_add_cancel]

theorem pmr_amp_split_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (c : WC), InWg5 B G (qsOf l0) 1 c → InWg5 B G (qsOf l0) (1/2) (W0h4 B G) →
    InWg5 B G (qsOf l0) (1 - kapS) (velW5 B G c - W0h4 B G) →
    InWg5 B G (qsOf l0) (1/2) (pmrP B G) ∧ InWg5 B G (qsOf l0) (1 - kapS) (wmoAmp5 B G c - pmrP B G) :=
by
  intro B G hok hG
  obtain ⟨lP, hPS⟩ := pulse_support_good_v5 B G hok hG
  refine ⟨lP, fun l0 hl0 c H1 H2 H3 => ?_⟩
  have hk : kapS = 1 / 100000 := rfl
  have hh0 : 0 < B.h := hok.2.1.1
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  obtain ⟨hOpen, hqCsm, hq0, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hQb : ∀ l : ℕ, 0 < Qb l := fun l => by unfold Qb; positivity
  have h42 : (4:ℝ) ^ (1/2:ℝ) = 2 := by
    rw [← Real.sqrt_eq_rpow, show (4:ℝ) = 2 ^ 2 by norm_num]
    exact Real.sqrt_sq (by norm_num)
  have hofR : ∀ (f : Cyl → ℝ) (ξ : Cyl), ContDiffAt ℝ ∞ f ξ →
      ContDiffAt ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) ξ := by
    intro f ξ hf
    have := (Complex.ofRealCLM.contDiff (n := ∞)).contDiffAt.comp ξ hf
    simpa [Function.comp_def] using this

  have M1 : ∀ (α : ℝ) (a : WC), InWg5 B G (qsOf l0) α a →
      InWg5 B G (qsOf l0) α (fun γ m ξ => (((qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ) • a γ m ξ) := by
    intro α a ha
    have sm : ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (a γ m) →
        ContDiffAt ℝ ∞ (fun η : Cyl => (((qC B.h η / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ)) ξ := by
      intro γ m ξ hξ _
      exact hofR _ ξ (((hqCsm.contDiffAt (hOpen.mem_nhds hξ)).div_const (Qb γ.1)).rpow_const_of_ne
        (ne_of_gt (div_pos (hq0 ξ hξ) (hQb γ.1))))
    have dk : ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), a γ m ξ ≠ 0 → ∀ c : ℝ × ℝ,
        IsDeck B.h (qC B.h ξ) c →
        (fun η : Cyl => (((qC B.h η / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ)) (shY ξ c) =
          (fun η : Cyl => (((qC B.h η / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ)) ξ := by
      intro γ m ξ _ _ c _
      rfl
    have bd : ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (a γ m) →
        B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h (fun η : Cyl => (((qC B.h η / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ)) k ξ ≤
          C * qC B.h ξ ^ (B.h * 0) * SC B.h ξ ^ b := by
      intro k
      obtain ⟨K, hK⟩ := qC_ratio_rpow_nb B hok (1/2) (by norm_num) (by norm_num) k
      refine ⟨2 * |K|, 0, fun γ m ξ hξ hts _ _ => ?_⟩
      have hr := (hPS l0 hl0 α a ha γ m ξ hξ hts).2.2.2.2.1
      have hrnn : 0 ≤ qC B.h ξ / Qb γ.1 := (div_pos (hq0 ξ hξ) (hQb γ.1)).le
      have hs : (qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) ≤ 2 := by
        calc (qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) ≤ (4:ℝ) ^ (1/2:ℝ) :=
              Real.rpow_le_rpow hrnn hr.le (by norm_num)
          _ = 2 := h42
      have hs0 : 0 ≤ (qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) := Real.rpow_nonneg hrnn _
      have hb := hK (Qb γ.1) (hQb γ.1) ξ hξ.2.1 (le_trans hξ.2.2.le hqs1)
      simp only [mul_zero, Real.rpow_zero, mul_one]
      calc _ ≤ K * (qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) := hb
        _ ≤ |K| * (qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) := mul_le_mul_of_nonneg_right (le_abs_self K) hs0
        _ ≤ |K| * 2 := mul_le_mul_of_nonneg_left hs (abs_nonneg K)
        _ = 2 * |K| := by ring
    have := inWg5_smul_mult B G l0 hok α 0 a
      (fun γ η => (((qC B.h η / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ)) ha sm dk bd
    simpa only [add_zero] using this

  have hA := M1 (1/2) (W0h4 B G) H2
  refine ⟨?_, ?_⟩
  · convert hA using 1
    funext γ m ξ i
    simp only [pmrP, Pi.smul_apply, smul_eq_mul]

  have hB1 := M1 (1 - kapS) _ H3

  have bdN : ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (c γ m) →
      B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      NB B.h (fun _ : Cyl => (![0, 0, -1] : Fin 3 → ℂ)) k ξ ≤ C * qC B.h ξ ^ (B.h * 0) * SC B.h ξ ^ b := by
    intro k
    refine ⟨‖(![0, 0, -1] : Fin 3 → ℂ)‖, 0, fun γ m ξ _ _ _ _ => ?_⟩
    simp only [mul_zero, Real.rpow_zero, mul_one]
    unfold NB
    refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
    rcases Nat.eq_zero_or_pos k with hk0 | hk0
    · subst hk0
      simp [norm_iteratedFDeriv_zero]
    · rw [iteratedFDeriv_const_of_ne (Nat.pos_iff_ne_zero.mp hk0)]
      simp
  have hB2' := inWg5_cross_mult B G l0 hok 1 0 c (fun _ _ _ => (![0, 0, -1] : Fin 3 → ℂ)) H1
    (fun γ m ξ _ _ => contDiffAt_const) (fun γ m ξ _ _ c' _ => rfl) bdN
  have hB2 : InWg5 B G (qsOf l0) 1 (fun γ m ξ => crossC (![0, 0, -1] : Fin 3 → ℂ) (c γ m ξ)) := by
    simpa only [add_zero] using hB2'

  obtain ⟨hm2s, hm2d, hm2b⟩ := pmr_mu2_nb_v5 B l0 hok
  have bd2 : ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      ξ ∈ tsupport ((fun γ m ξ => crossC (![0, 0, -1] : Fin 3 → ℂ) (c γ m ξ)) γ m) →
      B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      NB B.h (fun η : Cyl => (((B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun ζ => Real.log (qC B.h ζ)) η : ℝ)) : ℂ)) k ξ ≤
        C * qC B.h ξ ^ (B.h * (-kapS)) * SC B.h ξ ^ b := by
    intro k
    obtain ⟨C, hC⟩ := hm2b k
    refine ⟨|C|, 0, fun γ m ξ hξ _ _ _ => ?_⟩
    have hq := hq0 ξ hξ
    have hq1 : qC B.h ξ ≤ 1 := le_trans hξ.2.2.le hqs1
    have hexp : B.h * (-kapS) ≤ B.h := by rw [hk]; linarith
    have hmono : qC B.h ξ ^ B.h ≤ qC B.h ξ ^ (B.h * (-kapS)) :=
      Real.rpow_le_rpow_of_exponent_ge hq hq1 hexp
    have hpos : 0 ≤ qC B.h ξ ^ B.h := Real.rpow_nonneg hq.le _
    simp only [Real.rpow_zero, mul_one]
    calc _ ≤ C * qC B.h ξ ^ B.h := hC ξ hξ
      _ ≤ |C| * qC B.h ξ ^ B.h := mul_le_mul_of_nonneg_right (le_abs_self C) hpos
      _ ≤ |C| * qC B.h ξ ^ (B.h * (-kapS)) := mul_le_mul_of_nonneg_left hmono (abs_nonneg C)
  have hB3' := inWg5_smul_mult B G l0 hok 1 (-kapS)
    (fun γ m ξ => crossC (![0, 0, -1] : Fin 3 → ℂ) (c γ m ξ))
    (fun _ η => (((B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun ζ => Real.log (qC B.h ζ)) η : ℝ)) : ℂ))
    hB2 (fun γ m ξ hξ _ => hm2s ξ hξ) (fun γ m ξ _ _ c' _ => hm2d ξ c') bd2

  have hB4 := (pwr5_waveV_add B G hok (qsOf l0) hqs1 _ _ (1 - kapS) (1 + -kapS) hB1 hB3').1
  have e1 : min (1 - kapS) (1 + -kapS) = 1 - kapS := by rw [← sub_eq_add_neg, min_self]
  rw [e1] at hB4

  convert hB4 using 1
  funext γ m ξ i
  simp only [Pi.sub_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul, wmoAmp5, pmrP]
  fin_cases i <;> simp [rotC, crossC] <;> ring

theorem pmr_principal_wave_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → ∀ (ξ : Cyl), 0 < ξ.1 → ξ.2.2.1 < 1 →
    ∀ (θ : ℝ) (a : Fin 3),
      ∑ᶠ γ : Lab, tPart5 B G (W0c4 B G) γ θ ξ a = qC B.h ξ ^ (-Aex B.h) * waveV5 B G (pmrP B G) θ ξ a :=
by
  intro B G hok ξ _hξ1 hξ2 θ a
  have hq : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  obtain ⟨T, hT⟩ : ∃ T : Lab → ℝ, T = fun γ => (qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) * W0c4 B G γ ξ a *
      (2 * Real.cos ((pint5 B G γ : ℝ) * θ + (kb B.h γ.1 : ℝ) * phiL5 B G γ ξ)) := ⟨_, rfl⟩
  have hinner : ∀ γ : Lab,
      (∑ᶠ m : ℤ, pmrP B G γ m ξ a * ephase5 B G γ m θ ξ) = ((T γ : ℝ) : ℂ) := by
    intro γ
    have hsupp : Function.support (fun m : ℤ => pmrP B G γ m ξ a * ephase5 B G γ m θ ξ) ⊆
        ↑({1, -1} : Finset ℤ) := by
      intro m hm
      by_contra hc
      apply hm
      simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
        Set.mem_singleton_iff] at hc
      simp only [pmrP, W0h4, if_neg hc, Pi.zero_apply, mul_zero, zero_mul]
    rw [finsum_eq_sum_of_support_subset _ hsupp, Finset.sum_pair (by decide)]
    have e1 : pmrP B G γ 1 ξ a = (((qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ) * ((W0c4 B G γ ξ a : ℝ) : ℂ) := by
      simp [pmrP, W0h4]
    have e2 : pmrP B G γ (-1) ξ a = (((qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ) * ((W0c4 B G γ ξ a : ℝ) : ℂ) := by
      simp [pmrP, W0h4]
    have hψ : ((pint5 B G γ : ℂ) * (θ : ℂ) + (kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)) =
        ((((pint5 B G γ : ℝ) * θ + (kb B.h γ.1 : ℝ) * phiL5 B G γ ξ : ℝ)) : ℂ) := by
      push_cast; ring
    rw [e1, e2]
    simp only [ephase5]
    rw [hψ, hT]
    beta_reduce
    generalize (qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) = μ
    generalize W0c4 B G γ ξ a = c
    generalize (pint5 B G γ : ℝ) * θ + (kb B.h γ.1 : ℝ) * phiL5 B G γ ξ = ψ
    have hcos : Complex.exp (Complex.I * ((1:ℤ):ℂ) * (ψ:ℂ)) +
        Complex.exp (Complex.I * ((-1:ℤ):ℂ) * (ψ:ℂ)) = 2 * ((Real.cos ψ : ℝ) : ℂ) := by
      rw [Complex.ofReal_cos, Complex.two_cos]
      congr 1 <;> congr 1 <;> push_cast <;> ring
    generalize Real.cos ψ = C at hcos ⊢
    push_cast at hcos ⊢
    linear_combination ((μ : ℂ) * (c : ℂ)) * hcos
  have hwave : waveV5 B G (pmrP B G) θ ξ a = ∑ᶠ γ, T γ := by
    show (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, pmrP B G γ m ξ a * ephase5 B G γ m θ ξ).re = _
    rw [finsum_congr hinner]
    have h1 : ((∑ᶠ γ, T γ : ℝ) : ℂ) = ∑ᶠ γ, ((T γ : ℝ) : ℂ) :=
      AddMonoidHom.map_finsum_of_injective (Complex.ofRealHom.toAddMonoidHom)
        Complex.ofReal_injective T
    rw [← h1, Complex.ofReal_re]
  rw [hwave, mul_finsum]
  apply finsum_congr
  intro γ
  have hQ : 0 < Qb γ.1 := by unfold Qb; positivity
  rw [hT]
  simp only [tPart5, Aex]
  rw [Real.div_rpow hq.le hQ.le, Real.rpow_neg hQ.le,
    show -(1/2 + B.h) = -B.h + -(1/2:ℝ) by ring, Real.rpow_add hq, Real.rpow_neg hq.le (1/2:ℝ)]
  have hu : 0 < qC B.h ξ ^ (1/2:ℝ) := Real.rpow_pos_of_pos hq _
  have hv : 0 < Qb γ.1 ^ (1/2:ℝ) := Real.rpow_pos_of_pos hQ _
  field_simp

theorem pbd_chain : ∀ (B : BG) (qs X1 : ℝ) (Φ : ℝ × ℝ × ℝ → ℝ), B.ok → SimNorm B.h → 0 < qs → qs ≤ 1 → ContDiffOn ℝ ∞ Φ (Set.Iio (Real.log qs) ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1)) → (∀ ξ ∈ DomC B.h qs, pbdPsi B.h ξ ∈ Set.Iio (Real.log qs) ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1)) ∧ ContDiffOn ℝ ∞ (fun ξ => Φ (pbdPsi B.h ξ)) (DomC B.h qs) ∧ ∀ k : ℕ, ∃ K : ℝ, ∀ ξ ∈ DomC B.h qs, XC B.h ξ ≤ X1 → ∀ M : ℝ, (∀ j : ℕ, j ≤ k → ‖iteratedFDeriv ℝ j Φ (pbdPsi B.h ξ)‖ ≤ M) → NB B.h (fun ξ => Φ (pbdPsi B.h ξ)) k ξ ≤ K * M :=
by
  intro B qs X1 Φ hok hSN hqs0 hqs1 hΦ
  have hS := hok.1
  have hpos : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ := fun ξ hξ =>
    (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).1
  have hWo : IsOpen {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} :=
    (isOpen_lt continuous_const continuous_fst).inter
      (isOpen_lt (continuous_fst.comp (continuous_snd.comp continuous_snd)) continuous_const)
  have hqW : ContDiffOn ℝ ∞ (qC B.h) {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} := by
    have hlin : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
      (contDiff_fst.comp contDiff_snd).prodMk
        (contDiff_const.sub (contDiff_fst.comp (contDiff_snd.comp contDiff_snd)))
    exact hS.2.2.2.1.comp hlin.contDiffOn
      (fun ξ hξ => ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith [hξ.2]⟩)
  have hDeq : DomC B.h qs = {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Set.Iio qs := by
    ext ξ
    exact ⟨fun h => ⟨⟨h.1, h.2.1⟩, h.2.2⟩, fun h => ⟨h.1.1, h.1.2, h.2⟩⟩
  have hO : IsOpen (DomC B.h qs) := by
    rw [hDeq]; exact hqW.continuousOn.isOpen_inter_preimage hWo isOpen_Iio
  have hqC : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h qs) :=
    hqW.mono (fun ξ hξ => ⟨hξ.1, hξ.2.1⟩)
  have hq_ne : ∀ ξ ∈ DomC B.h qs, qC B.h ξ ≠ 0 := fun ξ hξ => (hpos ξ hξ).ne'
  have hVo : IsOpen (Set.Iio (Real.log qs) ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1) : Set (ℝ × ℝ × ℝ)) :=
    isOpen_Iio.prod (isOpen_Ioi.prod isOpen_Ioo)

  have hmap : ∀ ξ ∈ DomC B.h qs,
      pbdPsi B.h ξ ∈ (Set.Iio (Real.log qs) ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1) : Set (ℝ × ℝ × ℝ)) := by
    intro ξ hξ
    obtain ⟨hr, ht, hq⟩ := hξ
    have hq0 : 0 < qC B.h ξ := hpos ξ ⟨hr, ht, hq⟩
    have hz2 : ξ.2.1 ^ 2 < qC B.h ξ ^ (1 - 2 * B.h) :=
      (hS.2.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).2
    refine ⟨?_, ?_, ?_⟩
    · show Real.log (qC B.h ξ) < Real.log qs
      exact Real.log_lt_log hq0 hq
    · show 0 < ξ.1 ^ 2 / (2 * qC B.h ξ)
      positivity
    · have ha : 0 < qC B.h ξ ^ (1/2 - B.h) := Real.rpow_pos_of_pos hq0 _
      have hsq : (qC B.h ξ ^ (1/2 - B.h)) ^ 2 = qC B.h ξ ^ (1 - 2 * B.h) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul hq0.le]
        congr 1
        push_cast
        ring
      have habs : |ξ.2.1| < qC B.h ξ ^ (1/2 - B.h) :=
        abs_lt_of_sq_lt_sq (by rw [hsq]; exact hz2) ha.le
      have heta : etaC B.h ξ = ξ.2.1 / qC B.h ξ ^ (1/2 - B.h) := by
        unfold etaC
        rw [Real.rpow_neg hq0.le, ← div_eq_mul_inv]
      have h1 : |etaC B.h ξ| < 1 := by
        rw [heta, abs_div, abs_of_pos ha, div_lt_one ha]
        exact habs
      exact abs_lt.mp h1

  have hpsi : ContDiffOn ℝ ∞ (pbdPsi B.h) (DomC B.h qs) := by
    have h1 : ContDiffOn ℝ ∞ (fun ξ : Cyl => Real.log (qC B.h ξ)) (DomC B.h qs) := hqC.log hq_ne
    have h2 : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1 ^ 2 / (2 * qC B.h ξ)) (DomC B.h qs) :=
      ((contDiff_fst.pow 2).contDiffOn).div (contDiffOn_const.mul hqC)
        (fun ξ hξ => mul_ne_zero two_ne_zero (hq_ne ξ hξ))
    have h3 : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.2.1 * qC B.h ξ ^ (-(1/2 - B.h))) (DomC B.h qs) :=
      ((contDiff_fst.comp contDiff_snd).contDiffOn).mul (hqC.rpow_const_of_ne hq_ne)
    exact h1.prodMk (h2.prodMk h3)
  have hsm : ContDiffOn ℝ ∞ (fun ξ => Φ (pbdPsi B.h ξ)) (DomC B.h qs) :=
    hΦ.comp hpsi (fun ξ hξ => hmap ξ hξ)
  refine ⟨hmap, hsm, ?_⟩

  have key : ∀ {E F W : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F]
      [NormedSpace ℝ F] [NormedAddCommGroup W] [NormedSpace ℝ W] (G : F → W) (T : E →L[ℝ] F) (a : F)
      (V' : Set F) (i : ℕ), IsOpen V' → ContDiffOn ℝ ∞ G V' → a + T 0 ∈ V' →
      iteratedFDeriv ℝ i (fun z => G (a + T z)) 0 =
        (iteratedFDeriv ℝ i G (a + T 0)).compContinuousLinearMap (fun _ => T) := by
    intro E F W _ _ _ _ _ _ G T a V' i hV' hF ha
    obtain ⟨s, hs_def⟩ : ∃ s : Set F, s = (fun z => a + z) ⁻¹' V' := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV'.preimage (continuous_const.add continuous_id)
    have hOT : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have hAs : T 0 ∈ s := by rw [hs_def]; exact ha
    have hxO : (0:E) ∈ ⇑T ⁻¹' s := hAs
    have hsm' : ContDiffOn ℝ ∞ (fun z => G (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => G (a + T z)) i hOT hxO
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm' hs.uniqueDiffOn
      hOT.uniqueDiffOn hAs (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => G (a + z)) i hs hAs
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := G) i a (T 0)
    calc iteratedFDeriv ℝ i (fun z => G (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => G (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => G (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDeriv ℝ i (fun z => G (a + z)) (T 0)).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i G (a + T 0)).compContinuousLinearMap (fun _ => T) := by rw [e4]

  intro k
  choose Cs hCs using hSN
  obtain ⟨H0, hH0def⟩ : ∃ H0 : ℝ × ℝ × ℝ → ℝ × ℝ × ℝ,
      H0 = fun w => (Real.log w.1, w.2.1 ^ 2 * (w.1⁻¹ / 2), w.2.2 * w.1 ^ (-(1/2 - B.h))) := ⟨_, rfl⟩
  have hOo : IsOpen (Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set (ℝ × ℝ))) := isOpen_Ioi.prod isOpen_univ
  have hH0 : ContDiffOn ℝ ∞ H0 (Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set (ℝ × ℝ))) := by
    have hne : ∀ w ∈ Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set (ℝ × ℝ)), w.1 ≠ 0 :=
      fun w hw => (Set.mem_Ioi.mp hw.1).ne'
    rw [hH0def]
    refine ContDiffOn.prodMk ?_ (ContDiffOn.prodMk ?_ ?_)
    · exact contDiff_fst.contDiffOn.log hne
    · exact ((contDiff_fst.comp contDiff_snd).pow 2).contDiffOn.mul
        ((contDiff_fst.contDiffOn.inv hne).div_const 2)
    · exact (contDiff_snd.comp contDiff_snd).contDiffOn.mul
        (contDiff_fst.contDiffOn.rpow_const_of_ne hne)
  obtain ⟨cmax, hcmax⟩ : ∃ cmax : ℝ, cmax = Real.sqrt (2 * max X1 0) := ⟨_, rfl⟩
  have hKc : IsCompact (({(1:ℝ)} : Set ℝ) ×ˢ (Set.Icc (0:ℝ) cmax ×ˢ Set.Icc (-1:ℝ) 1)) :=
    isCompact_singleton.prod (isCompact_Icc.prod isCompact_Icc)
  have hKO : ({(1:ℝ)} : Set ℝ) ×ˢ (Set.Icc (0:ℝ) cmax ×ˢ Set.Icc (-1:ℝ) 1) ⊆
      Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set (ℝ × ℝ)) := by
    intro w hw
    have h1 : w.1 = 1 := hw.1
    exact ⟨show (0:ℝ) < w.1 by rw [h1]; exact one_pos, Set.mem_univ _⟩
  have hBd : ∀ j : ℕ, ∃ Bj : ℝ, ∀ w ∈ ({(1:ℝ)} : Set ℝ) ×ˢ (Set.Icc (0:ℝ) cmax ×ˢ Set.Icc (-1:ℝ) 1),
      ‖iteratedFDerivWithin ℝ j H0 (Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set (ℝ × ℝ))) w‖ ≤ Bj := by
    intro j
    exact hKc.exists_bound_of_continuousOn
      ((hH0.continuousOn_iteratedFDerivWithin (by exact_mod_cast le_top) hOo.uniqueDiffOn).mono hKO)
  choose Bf hBf using hBd
  obtain ⟨CH, hCH⟩ : ∃ CH : ℝ, CH = ∑ j ∈ Finset.range (k + 1), |Bf j| := ⟨_, rfl⟩
  obtain ⟨A1, hA1⟩ : ∃ A1 : ℝ, A1 = ∑ i ∈ Finset.range (k + 1), |Cs i| := ⟨_, rfl⟩
  obtain ⟨Dg, hDg⟩ : ∃ Dg : ℝ, Dg = max A1 1 := ⟨_, rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : ℝ, E = (k.factorial : ℝ) * max 1 CH := ⟨_, rfl⟩
  have hkf1 : (1:ℝ) ≤ k.factorial := Nat.one_le_cast.mpr (Nat.factorial_pos k)
  have hE1 : 1 ≤ E := by
    rw [hE]
    nlinarith [le_max_left (1:ℝ) CH]
  have hDg1 : 1 ≤ Dg := by rw [hDg]; exact le_max_right _ _
  have hCH0 : 0 ≤ CH := by rw [hCH]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
  refine ⟨(k.factorial : ℝ) * (E * Dg) ^ k, ?_⟩
  intro ξ0 hξ0 hX M hM
  have hq0 : 0 < qC B.h ξ0 := hpos ξ0 hξ0
  have hτ0 : 0 < 1 - ξ0.2.2.1 := by linarith [hξ0.2.1]
  have hq1 : simScale B.h ξ0.2.1 (1 - ξ0.2.2.1) ≤ 1 := le_trans hξ0.2.2.le hqs1
  obtain ⟨L, hL⟩ : ∃ L : Cyl →L[ℝ] Cyl, L = Lnorm B.h ξ0 := ⟨_, rfl⟩
  have hL1 : ∀ u : Cyl, (ξ0 + L u).1 = ξ0.1 + Real.sqrt (qC B.h ξ0) * u.1 := by
    intro u; rw [hL]; rfl
  have hL2 : ∀ u : Cyl, (ξ0 + L u).2.1 = ξ0.2.1 + qC B.h ξ0 ^ (1/2 - B.h) * u.2.1 := by
    intro u; rw [hL]; rfl
  have hL3 : ∀ u : Cyl, (ξ0 + L u).2.2.1 = ξ0.2.2.1 + qC B.h ξ0 * u.2.2.1 := by
    intro u; rw [hL]; rfl
  obtain ⟨Dn, hDn⟩ : ∃ Dn : ℝ × ℝ →L[ℝ] ℝ × ℝ,
      Dn = (simScale B.h ξ0.2.1 (1 - ξ0.2.2.1) ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
        (simScale B.h ξ0.2.1 (1 - ξ0.2.2.1) • ContinuousLinearMap.id ℝ ℝ) := ⟨_, rfl⟩
  obtain ⟨P2, hP2⟩ : ∃ P2 : Cyl →L[ℝ] ℝ × ℝ,
      P2 = ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))).prod
        (-((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))))) := ⟨_, rfl⟩
  have hP2app : ∀ u : Cyl, P2 u = (u.2.1, -u.2.2.1) := by intro u; rw [hP2]; rfl
  have hP2n : ‖P2‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound P2 zero_le_one (fun u => ?_)
    rw [hP2app, one_mul, Prod.norm_def]
    show max ‖u.2.1‖ ‖-u.2.2.1‖ ≤ ‖u‖
    rw [norm_neg]
    exact max_le ((norm_fst_le u.2).trans (norm_snd_le u))
      (((norm_fst_le u.2.2).trans (norm_snd_le u.2)).trans (norm_snd_le u))
  have hqL : ∀ u : Cyl, qC B.h (ξ0 + L u) =
      simScale B.h (((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) + (Dn.comp P2) u).1
        (((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) + (Dn.comp P2) u).2 := by
    intro u
    have e : (Dn.comp P2) u = (qC B.h ξ0 ^ (1/2 - B.h) * u.2.1, qC B.h ξ0 * (-u.2.2.1)) := by
      rw [ContinuousLinearMap.comp_apply, hP2app, hDn]; rfl
    rw [e]
    show simScale B.h (ξ0 + L u).2.1 (1 - (ξ0 + L u).2.2.1) =
      simScale B.h (ξ0.2.1 + qC B.h ξ0 ^ (1/2 - B.h) * u.2.1) (1 - ξ0.2.2.1 + qC B.h ξ0 * (-u.2.2.1))
    rw [hL2, hL3]
    congr 1
    ring

  obtain ⟨U, hUdef⟩ : ∃ U : Set Cyl, U = (fun u => ξ0 + L u) ⁻¹' DomC B.h qs := ⟨_, rfl⟩
  have hUo : IsOpen U := by rw [hUdef]; exact hO.preimage (continuous_const.add L.continuous)
  have h0U : (0:Cyl) ∈ U := by
    rw [hUdef]; show ξ0 + L 0 ∈ DomC B.h qs; rw [map_zero, add_zero]; exact hξ0
  have huU : ∀ u ∈ U, ξ0 + L u ∈ DomC B.h qs := by intro u hu; rw [hUdef] at hu; exact hu

  obtain ⟨ρ, hρ⟩ : ∃ ρ : Cyl → ℝ, ρ = fun u => (qC B.h ξ0)⁻¹ * qC B.h (ξ0 + L u) := ⟨_, rfl⟩
  have hρU : ContDiffOn ℝ ∞ ρ U := by
    rw [hρ]
    exact contDiffOn_const.mul (hqC.comp (contDiff_const.add L.contDiff).contDiffOn
      (fun u hu => huU u hu))
  have hρpos : ∀ u ∈ U, 0 < ρ u := by
    intro u hu; rw [hρ]; exact mul_pos (inv_pos.mpr hq0) (hpos _ (huU u hu))
  have hρ0 : ρ 0 = 1 := by
    rw [hρ]; show (qC B.h ξ0)⁻¹ * qC B.h (ξ0 + L 0) = 1
    rw [map_zero, add_zero, inv_mul_cancel₀ hq0.ne']
  have hρeq : ρ = (qC B.h ξ0)⁻¹ • (fun z : Cyl =>
      simScale B.h (((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) + (Dn.comp P2) z).1
        (((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) + (Dn.comp P2) z).2) := by
    funext u
    rw [hρ]
    show (qC B.h ξ0)⁻¹ * qC B.h (ξ0 + L u) = (qC B.h ξ0)⁻¹ * _
    rw [hqL u]
  have hSfo : IsOpen ((Set.univ : Set ℝ) ×ˢ Set.Ioi (0:ℝ)) := isOpen_univ.prod isOpen_Ioi
  have hw0m : ((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) + (Dn.comp P2) 0 ∈
      (Set.univ : Set ℝ) ×ˢ Set.Ioi (0:ℝ) := by
    rw [map_zero, add_zero]; exact ⟨Set.mem_univ _, hτ0⟩
  have hGat : ContDiffAt ℝ ∞ (fun z : Cyl =>
      simScale B.h (((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) + (Dn.comp P2) z).1
        (((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) + (Dn.comp P2) z).2) 0 := by
    have h1 : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2)
        (((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) + (Dn.comp P2) 0) :=
      hS.2.2.2.1.contDiffAt (hSfo.mem_nhds hw0m)
    have h2 : ContDiffAt ℝ ∞ (fun z : Cyl => ((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) + (Dn.comp P2) z) 0 :=
      (contDiff_const.add (Dn.comp P2).contDiff).contDiffAt
    exact ContDiffAt.comp (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2)
      (f := fun z : Cyl => ((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) + (Dn.comp P2) z) (0:Cyl) h1 h2

  have hρjet : ∀ i : ℕ, ‖iteratedFDeriv ℝ i ρ 0‖ ≤ |Cs i| := by
    intro i
    have hk1 : iteratedFDeriv ℝ i (fun z : Cyl =>
        simScale B.h (((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) + (Dn.comp P2) z).1
          (((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) + (Dn.comp P2) z).2) 0 =
        (iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2)
          (ξ0.2.1, 1 - ξ0.2.2.1)).compContinuousLinearMap (fun _ => Dn.comp P2) := by
      have := key (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Dn.comp P2)
        ((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) _ i hSfo hS.2.2.2.1 hw0m
      rw [map_zero, add_zero] at this
      exact this
    have hfac : (iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2)
          (ξ0.2.1, 1 - ξ0.2.2.1)).compContinuousLinearMap (fun _ => Dn.comp P2) =
        ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2)
          (ξ0.2.1, 1 - ξ0.2.2.1)).compContinuousLinearMap (fun _ => Dn)).compContinuousLinearMap
          (fun _ => P2) := by
      ext m
      simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      rfl
    have hnorm : ∀ N : ContinuousMultilinearMap ℝ (fun _ : Fin i => ℝ × ℝ) ℝ,
        ‖N.compContinuousLinearMap (fun _ => P2)‖ ≤ ‖N‖ := by
      intro N
      calc ‖N.compContinuousLinearMap (fun _ => P2)‖ ≤ ‖N‖ * ∏ _j : Fin i, ‖P2‖ :=
            ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
        _ = ‖N‖ * ‖P2‖ ^ i := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        _ ≤ ‖N‖ * 1 := mul_le_mul_of_nonneg_left (pow_le_one₀ (norm_nonneg _) hP2n) (norm_nonneg _)
        _ = ‖N‖ := mul_one _
    have hb := hCs i ξ0.2.1 (1 - ξ0.2.2.1) hτ0 hq1
    rw [← hDn] at hb
    have hqs' : simScale B.h ξ0.2.1 (1 - ξ0.2.2.1) = qC B.h ξ0 := rfl
    rw [hqs'] at hb
    rw [hρeq, iteratedFDeriv_const_smul_apply (hGat.of_le (by exact_mod_cast le_top)), hk1,
      norm_smul, hfac, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hq0)]
    refine le_trans (mul_le_mul_of_nonneg_left ((hnorm _).trans hb) (inv_pos.mpr hq0).le) ?_
    rw [show (qC B.h ξ0)⁻¹ * (Cs i * qC B.h ξ0) = Cs i by field_simp]
    exact le_abs_self _

  obtain ⟨c, hcdef⟩ : ∃ c : ℝ, c = Real.sqrt (2 * XC B.h ξ0) := ⟨_, rfl⟩
  obtain ⟨e, hedef⟩ : ∃ e : ℝ, e = etaC B.h ξ0 := ⟨_, rfl⟩
  obtain ⟨c0, hc0⟩ : ∃ c0 : ℝ, c0 = Real.log (qC B.h ξ0) := ⟨_, rfl⟩
  have hcK : c ∈ Set.Icc (0:ℝ) cmax := by
    rw [hcdef, hcmax]
    exact ⟨Real.sqrt_nonneg _, Real.sqrt_le_sqrt (by linarith [le_max_left X1 0])⟩
  have heK : e ∈ Set.Icc (-1:ℝ) 1 := by
    rw [hedef]
    have := (hmap ξ0 hξ0).2.2
    exact ⟨this.1.le, this.2.le⟩

  obtain ⟨g, hg⟩ : ∃ g : Cyl → ℝ × ℝ × ℝ, g = fun u => (ρ u, (u.1, u.2.1)) := ⟨_, rfl⟩
  have hPc : ContDiff ℝ ∞ (fun u : Cyl => (u.1, u.2.1)) :=
    contDiff_fst.prodMk (contDiff_fst.comp contDiff_snd)
  have hgU : ContDiffOn ℝ ∞ g U := by rw [hg]; exact hρU.prodMk hPc.contDiffOn
  obtain ⟨O1, hO1⟩ : ∃ O1 : Set (ℝ × ℝ × ℝ),
      O1 = (fun w => ((0:ℝ), c, e) + w) ⁻¹' (Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set (ℝ × ℝ))) := ⟨_, rfl⟩
  have hO1o : IsOpen O1 := by rw [hO1]; exact hOo.preimage (continuous_const.add continuous_id)
  have hgmap : Set.MapsTo g U O1 := by
    intro u hu
    rw [hO1, hg]
    show ((0:ℝ), c, e) + (ρ u, (u.1, u.2.1)) ∈ Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set (ℝ × ℝ))
    exact ⟨show (0:ℝ) < 0 + ρ u by rw [zero_add]; exact hρpos u hu, Set.mem_univ _⟩
  have hH1 : ContDiffOn ℝ ∞ (fun w => H0 (((0:ℝ), c, e) + w)) O1 := by
    rw [hO1]; exact hH0.comp (contDiff_const.add contDiff_id).contDiffOn (fun w hw => hw)
  obtain ⟨J, hJ⟩ : ∃ J : Cyl → ℝ × ℝ × ℝ, J = fun u => H0 (((0:ℝ), c, e) + g u) := ⟨_, rfl⟩
  have hJc : ((fun w => H0 (((0:ℝ), c, e) + w)) ∘ g) = J := by rw [hJ]; rfl

  have hform : ∀ u ∈ U, pbdPsi B.h (ξ0 + L u) = ((c0, (0:ℝ), (0:ℝ)) : ℝ × ℝ × ℝ) + J u := by
    intro u hu
    have hq' : 0 < qC B.h (ξ0 + L u) := hpos _ (huU u hu)
    rw [hJ, hH0def, hg, hρ]
    refine Prod.ext ?_ (Prod.ext ?_ ?_)
    · show Real.log (qC B.h (ξ0 + L u)) =
        c0 + Real.log (0 + (qC B.h ξ0)⁻¹ * qC B.h (ξ0 + L u))
      rw [zero_add, Real.log_mul (inv_ne_zero hq0.ne') hq'.ne', Real.log_inv, hc0]
      ring
    · show (ξ0 + L u).1 ^ 2 / (2 * qC B.h (ξ0 + L u)) =
        0 + (c + u.1) ^ 2 * ((0 + (qC B.h ξ0)⁻¹ * qC B.h (ξ0 + L u))⁻¹ / 2)
      have hc : Real.sqrt (qC B.h ξ0) * c = ξ0.1 := by
        rw [hcdef, ← Real.sqrt_mul hq0.le]
        have : qC B.h ξ0 * (2 * XC B.h ξ0) = ξ0.1 ^ 2 := by
          unfold XC; field_simp
        rw [this, Real.sqrt_sq hξ0.1.le]
      have hs2 : Real.sqrt (qC B.h ξ0) ^ 2 = qC B.h ξ0 := Real.sq_sqrt hq0.le
      rw [hL1, zero_add, zero_add, ← hc]
      have hsq : (Real.sqrt (qC B.h ξ0) * c + Real.sqrt (qC B.h ξ0) * u.1) ^ 2 =
          qC B.h ξ0 * (c + u.1) ^ 2 := by linear_combination (c + u.1) ^ 2 * hs2
      rw [hsq]
      field_simp
    · show (ξ0 + L u).2.1 * qC B.h (ξ0 + L u) ^ (-(1/2 - B.h)) =
        0 + (e + u.2.1) * (0 + (qC B.h ξ0)⁻¹ * qC B.h (ξ0 + L u)) ^ (-(1/2 - B.h))
      have ht : 0 < qC B.h ξ0 ^ (1/2 - B.h) := Real.rpow_pos_of_pos hq0 _
      rw [hL2, zero_add, zero_add, hedef, Real.mul_rpow (inv_nonneg.mpr hq0.le) hq'.le,
        Real.inv_rpow hq0.le]
      unfold etaC
      rw [Real.rpow_neg hq0.le, inv_inv]
      field_simp

  obtain ⟨P, hPdef⟩ : ∃ P : Cyl →L[ℝ] ℝ × ℝ,
      P = (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))).prod
        ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))) := ⟨_, rfl⟩
  have hPeq : (fun u : Cyl => (u.1, u.2.1)) = ⇑P := by funext u; rw [hPdef]; rfl
  have hPn : ‖P‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound P zero_le_one (fun u => ?_)
    have : P u = (u.1, u.2.1) := by rw [hPdef]; rfl
    rw [this, one_mul, Prod.norm_def]
    exact max_le (norm_fst_le u) ((norm_fst_le u.2).trans (norm_snd_le u))
  have hPjet : ∀ i : ℕ, 1 ≤ i → ‖iteratedFDeriv ℝ i (fun u : Cyl => (u.1, u.2.1)) 0‖ ≤ 1 := by
    intro i hi
    obtain ⟨m, rfl⟩ : ∃ m, i = m + 1 := ⟨i - 1, by omega⟩
    rw [hPeq, ← norm_iteratedFDeriv_fderiv]
    have hfd : fderiv ℝ ⇑P = fun _ => P := by funext x; exact P.fderiv
    rw [hfd]
    rcases Nat.eq_zero_or_pos m with hm | hm
    · subst hm; rw [norm_iteratedFDeriv_zero]; exact hPn
    · rw [iteratedFDeriv_const_of_ne (by omega)]; simp
  have hgjet : ∀ i : ℕ, 1 ≤ i → i ≤ k → ‖iteratedFDeriv ℝ i g 0‖ ≤ Dg := by
    intro i hi1 hik
    have hρat : ContDiffAt ℝ ∞ ρ 0 := hρU.contDiffAt (hUo.mem_nhds h0U)
    rw [hg, iteratedFDeriv_prodMk hρat hPc.contDiffAt (by exact_mod_cast le_top),
      ContinuousMultilinearMap.opNorm_prod]
    refine max_le ((hρjet i).trans ?_) ((hPjet i hi1).trans ?_)
    · rw [hDg, hA1]
      exact (Finset.single_le_sum (f := fun j => |Cs j|) (fun j _ => abs_nonneg (Cs j))
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hik))).trans (le_max_left _ _)
    · rw [hDg]; exact le_max_right _ _

  have hJjet : ∀ i : ℕ, 1 ≤ i → i ≤ k → ‖iteratedFDeriv ℝ i J 0‖ ≤ (E * Dg) ^ i := by
    intro i hi1 hik
    have hmemK : ((0:ℝ), c, e) + g 0 ∈
        ({(1:ℝ)} : Set ℝ) ×ˢ (Set.Icc (0:ℝ) cmax ×ˢ Set.Icc (-1:ℝ) 1) := by
      rw [hg]
      refine ⟨?_, ?_, ?_⟩
      · show (0:ℝ) + ρ 0 = 1
        rw [zero_add, hρ0]
      · show c + (0:Cyl).1 ∈ Set.Icc (0:ℝ) cmax
        rw [Prod.fst_zero, add_zero]; exact hcK
      · show e + (0:Cyl).2.1 ∈ Set.Icc (-1:ℝ) 1
        rw [Prod.snd_zero, Prod.fst_zero, add_zero]; exact heK
    have hC1 : ∀ j ≤ i, ‖iteratedFDerivWithin ℝ j (fun w => H0 (((0:ℝ), c, e) + w)) O1 (g 0)‖ ≤ CH := by
      intro j hj
      rw [iteratedFDerivWithin_of_isOpen (f := fun w => H0 (((0:ℝ), c, e) + w)) j hO1o (hgmap h0U),
        iteratedFDeriv_comp_add_left,
        ← iteratedFDerivWithin_of_isOpen (f := H0) j hOo (hKO hmemK)]
      refine (hBf j _ hmemK).trans ?_
      rw [hCH]
      exact (le_abs_self _).trans (Finset.single_le_sum (f := fun j => |Bf j|)
        (fun j _ => abs_nonneg (Bf j)) (Finset.mem_range.mpr (by omega)))
    have hD1 : ∀ j : ℕ, 1 ≤ j → j ≤ i → ‖iteratedFDerivWithin ℝ j g U 0‖ ≤ Dg ^ j := by
      intro j hj1 hji
      rw [iteratedFDerivWithin_of_isOpen (f := g) j hUo h0U]
      exact (hgjet j hj1 (by omega)).trans (le_self_pow₀ hDg1 (by omega))
    have hF := norm_iteratedFDerivWithin_comp_le (n := i) hH1 hgU (by exact_mod_cast le_top)
      hO1o.uniqueDiffOn hUo.uniqueDiffOn hgmap h0U hC1 hD1
    rw [← hJc, ← iteratedFDerivWithin_of_isOpen (f := (fun w => H0 (((0:ℝ), c, e) + w)) ∘ g) i hUo h0U]
    refine hF.trans ?_
    have hDgi : 0 ≤ Dg ^ i := pow_nonneg (by linarith) _
    have hfi : (i.factorial : ℝ) ≤ k.factorial := by exact_mod_cast Nat.factorial_le hik
    have h1 : (i.factorial : ℝ) * CH ≤ E := by
      rw [hE]; exact mul_le_mul hfi (le_max_right _ _) hCH0 (by linarith)
    calc (i.factorial : ℝ) * CH * Dg ^ i ≤ E * Dg ^ i := mul_le_mul_of_nonneg_right h1 hDgi
      _ ≤ E ^ i * Dg ^ i := mul_le_mul_of_nonneg_right (le_self_pow₀ hE1 (by omega)) hDgi
      _ = (E * Dg) ^ i := (mul_pow E Dg i).symm

  obtain ⟨V1, hV1⟩ : ∃ V1 : Set (ℝ × ℝ × ℝ), V1 = (fun w => ((c0, (0:ℝ), (0:ℝ)) : ℝ × ℝ × ℝ) + w) ⁻¹'
      (Set.Iio (Real.log qs) ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1)) := ⟨_, rfl⟩
  have hV1o : IsOpen V1 := by rw [hV1]; exact hVo.preimage (continuous_const.add continuous_id)
  have hΦ1 : ContDiffOn ℝ ∞ (fun w => Φ (((c0, (0:ℝ), (0:ℝ)) : ℝ × ℝ × ℝ) + w)) V1 := by
    rw [hV1]; exact hΦ.comp (contDiff_const.add contDiff_id).contDiffOn (fun w hw => hw)
  have hJU : ContDiffOn ℝ ∞ J U := by rw [← hJc]; exact hH1.comp hgU hgmap
  have hJmap : Set.MapsTo J U V1 := by
    intro u hu
    rw [hV1]
    show ((c0, (0:ℝ), (0:ℝ)) : ℝ × ℝ × ℝ) + J u ∈ Set.Iio (Real.log qs) ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1)
    rw [← hform u hu]
    exact hmap _ (huU u hu)
  have hJ0 : ((c0, (0:ℝ), (0:ℝ)) : ℝ × ℝ × ℝ) + J 0 = pbdPsi B.h ξ0 := by
    rw [← hform 0 h0U, map_zero, add_zero]
  have hC2 : ∀ j ≤ k, ‖iteratedFDerivWithin ℝ j (fun w => Φ (((c0, (0:ℝ), (0:ℝ)) : ℝ × ℝ × ℝ) + w))
      V1 (J 0)‖ ≤ M := by
    intro j hj
    rw [iteratedFDerivWithin_of_isOpen (f := fun w => Φ (((c0, (0:ℝ), (0:ℝ)) : ℝ × ℝ × ℝ) + w)) j hV1o
      (hJmap h0U), iteratedFDeriv_comp_add_left, hJ0]
    exact hM j hj
  have hD2 : ∀ i : ℕ, 1 ≤ i → i ≤ k → ‖iteratedFDerivWithin ℝ i J U 0‖ ≤ (E * Dg) ^ i := by
    intro i h1 h2
    rw [iteratedFDerivWithin_of_isOpen (f := J) i hUo h0U]
    exact hJjet i h1 h2
  have hF2 := norm_iteratedFDerivWithin_comp_le (n := k) hΦ1 hJU (by exact_mod_cast le_top)
    hV1o.uniqueDiffOn hUo.uniqueDiffOn hJmap h0U hC2 hD2

  have hkey : iteratedFDeriv ℝ k (fun z => Φ (pbdPsi B.h (ξ0 + L z))) 0 =
      (iteratedFDeriv ℝ k (fun ξ => Φ (pbdPsi B.h ξ)) ξ0).compContinuousLinearMap (fun _ => L) := by
    have := key (fun ξ => Φ (pbdPsi B.h ξ)) L ξ0 (DomC B.h qs) k hO hsm
      (by rw [map_zero, add_zero]; exact hξ0)
    rw [map_zero, add_zero] at this
    exact this
  have hev : (fun z => Φ (pbdPsi B.h (ξ0 + L z))) =ᶠ[nhds (0:Cyl)]
      ((fun w => Φ (((c0, (0:ℝ), (0:ℝ)) : ℝ × ℝ × ℝ) + w)) ∘ J) :=
    Filter.eventuallyEq_of_mem (hUo.mem_nhds h0U) (fun u hu => by
      show Φ (pbdPsi B.h (ξ0 + L u)) = Φ (((c0, (0:ℝ), (0:ℝ)) : ℝ × ℝ × ℝ) + J u)
      rw [hform u hu])
  unfold NB
  rw [← hL, ← hkey, (hev.iteratedFDeriv ℝ k).eq_of_nhds,
    ← iteratedFDerivWithin_of_isOpen
      (f := (fun w => Φ (((c0, (0:ℝ), (0:ℝ)) : ℝ × ℝ × ℝ) + w)) ∘ J) k hUo h0U]
  exact hF2.trans (le_of_eq (by ring))

theorem pbd_profile : ∀ (h c s1 Xa Xb aa ab β : ℝ) (G : ℝ × ℝ × ℝ → ℝ), 0 < Xa → Xa < Xb → ContDiffOn ℝ ∞ G (Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1)) → (∀ w ∈ Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1), (w.2.1 ≤ Xa ∨ Xb ≤ w.2.1) → G w = 0) → (∀ m : ℕ, ∃ C N : ℝ, ∀ w ∈ Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1), Xa < w.2.1 → w.2.1 < Xb → ‖iteratedFDeriv ℝ m G w‖ ≤ C * Real.exp (β * w.1) * edgeWeight Xa Xb aa ab w.2.1 * edgeDist Xa Xb w.2.1 ^ (-N)) → ContDiffOn ℝ ∞ (pbdProf h c G) (Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1)) ∧ (∀ w ∈ Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1), (w.2.1 ≤ Xa ∨ Xb ≤ w.2.1) → pbdProf h c G w = 0) ∧ ∀ k : ℕ, ∃ C N : ℝ, ∀ w ∈ Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1), Xa < w.2.1 → w.2.1 < Xb → ∀ j : ℕ, j ≤ k → ‖iteratedFDeriv ℝ j (pbdProf h c G) w‖ ≤ C * Real.exp ((β + h) * w.1) * edgeWeight Xa Xb aa ab w.2.1 * edgeDist Xa Xb w.2.1 ^ (-N) :=
by
  intro h c s1 Xa Xb aa ab β G hXa hXab hG hGv hGb
  set V : Set (ℝ × ℝ × ℝ) := Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1) with hVdef
  have hVo : IsOpen V := isOpen_Iio.prod (isOpen_Ioi.prod isOpen_Ioo)
  have hle : ∀ i : ℕ, ((i : ℕ∞) : WithTop ℕ∞) ≤ ∞ := fun i => by exact_mod_cast le_top

  obtain ⟨E, hE⟩ : ∃ E : ℝ × ℝ × ℝ → ℝ, E = fun y => Real.exp (h * y.1) := ⟨_, rfl⟩
  obtain ⟨φ1, hφ1⟩ : ∃ φ1 : ℝ → ℝ, φ1 = fun x => Real.sqrt (2 * x) := ⟨_, rfl⟩
  obtain ⟨φ2, hφ2⟩ : ∃ φ2 : ℝ → ℝ, φ2 = fun x => c * Real.sqrt (2 * x) / x := ⟨_, rfl⟩
  obtain ⟨G', hG'⟩ : ∃ G' : ℝ × ℝ × ℝ → ℝ, G' = fun y => fderiv ℝ G y ((0:ℝ), (1:ℝ), (0:ℝ)) :=
    ⟨_, rfl⟩
  have hPeq : pbdProf h c G = fun y => E y * (φ1 y.2.1 * G' y + φ2 y.2.1 * G y) := by
    funext y
    rw [hE, hφ1, hφ2, hG']
    simp only [pbdProf]
    ring

  have hEs : ContDiff ℝ ∞ E := by rw [hE]; exact (contDiff_const.mul contDiff_fst).exp
  have hsq : ContDiffOn ℝ ∞ (fun x : ℝ => Real.sqrt (2 * x)) (Set.Ioi 0) :=
    (contDiffOn_const.mul contDiffOn_id).sqrt
      (fun x hx => (mul_pos two_pos (show (0:ℝ) < x from hx)).ne')
  have hφ1s : ContDiffOn ℝ ∞ φ1 (Set.Ioi 0) := by rw [hφ1]; exact hsq
  have hφ2s : ContDiffOn ℝ ∞ φ2 (Set.Ioi 0) := by
    rw [hφ2]
    exact (contDiffOn_const.mul hsq).div contDiffOn_id (fun x hx => (show (0:ℝ) < x from hx).ne')
  have hπs : ContDiffOn ℝ ∞ (fun y : ℝ × ℝ × ℝ => y.2.1) V := (contDiff_fst.comp contDiff_snd).contDiffOn
  have hmaps : Set.MapsTo (fun y : ℝ × ℝ × ℝ => y.2.1) V (Set.Ioi 0) := fun w hw => hw.2.1
  have hSs : ContDiffOn ℝ ∞ (fun y : ℝ × ℝ × ℝ => φ1 y.2.1) V := hφ1s.comp hπs hmaps
  have hRs : ContDiffOn ℝ ∞ (fun y : ℝ × ℝ × ℝ => φ2 y.2.1) V := hφ2s.comp hπs hmaps
  have hfdG : ContDiffOn ℝ ∞ (fderiv ℝ G) V := hG.fderiv_of_isOpen hVo (by simp)
  have hG's : ContDiffOn ℝ ∞ G' V := by rw [hG']; exact hfdG.clm_apply contDiffOn_const
  have hQs : ContDiffOn ℝ ∞ (fun y => φ1 y.2.1 * G' y + φ2 y.2.1 * G y) V :=
    (hSs.mul hG's).add (hRs.mul hG)
  have hPs : ContDiffOn ℝ ∞ (pbdProf h c G) V := by
    rw [hPeq]; exact hEs.contDiffOn.mul hQs

  have hvan : ∀ w ∈ V, (w.2.1 ≤ Xa ∨ Xb ≤ w.2.1) → pbdProf h c G w = 0 := by
    intro w hw hX
    have hGw : G w = 0 := hGv w hw hX
    obtain ⟨s, X, η⟩ := w
    have hs : s < s1 := hw.1
    have hX0 : 0 < X := hw.2.1
    have hη : η ∈ Set.Ioo (-1:ℝ) 1 := hw.2.2
    have hγ : HasDerivAt (fun Y : ℝ => ((s, Y, η) : ℝ × ℝ × ℝ)) ((0:ℝ), (1:ℝ), (0:ℝ)) X :=
      (hasDerivAt_const X s).prodMk ((hasDerivAt_id X).prodMk (hasDerivAt_const X η))
    have hGd : DifferentiableAt ℝ G (s, X, η) :=
      (hG.contDiffAt (hVo.mem_nhds hw)).differentiableAt (by norm_num)
    have hd1 : HasDerivAt (G ∘ fun Y : ℝ => ((s, Y, η) : ℝ × ℝ × ℝ))
        (fderiv ℝ G (s, X, η) ((0:ℝ), (1:ℝ), (0:ℝ))) X :=
      hGd.hasFDerivAt.comp_hasDerivAt X hγ
    have hfd : fderiv ℝ G (s, X, η) ((0:ℝ), (1:ℝ), (0:ℝ)) = 0 := by
      rcases hX with hX | hX
      · have hev : (G ∘ fun Y : ℝ => ((s, Y, η) : ℝ × ℝ × ℝ)) =ᶠ[nhdsWithin X (Set.Iic X)]
            fun _ => (0:ℝ) := by
          filter_upwards [Ioc_mem_nhdsLE hX0] with Y hY
          show G (s, Y, η) = 0
          exact hGv (s, Y, η) ⟨hs, hY.1, hη⟩ (Or.inl (le_trans hY.2 hX))
        have h2 : HasDerivWithinAt (G ∘ fun Y : ℝ => ((s, Y, η) : ℝ × ℝ × ℝ)) 0 (Set.Iic X) X :=
          (hasDerivWithinAt_const X (Set.Iic X) (0:ℝ)).congr_of_eventuallyEq hev
            (by show G (s, X, η) = 0; exact hGw)
        exact (uniqueDiffWithinAt_Iic X).eq_deriv _ hd1.hasDerivWithinAt h2
      · have hev : (G ∘ fun Y : ℝ => ((s, Y, η) : ℝ × ℝ × ℝ)) =ᶠ[nhdsWithin X (Set.Ici X)]
            fun _ => (0:ℝ) := by
          filter_upwards [self_mem_nhdsWithin] with Y hY
          show G (s, Y, η) = 0
          have hY' : X ≤ Y := hY
          exact hGv (s, Y, η) ⟨hs, show (0:ℝ) < Y from lt_of_lt_of_le hX0 hY', hη⟩
            (Or.inr (le_trans hX hY'))
        have h2 : HasDerivWithinAt (G ∘ fun Y : ℝ => ((s, Y, η) : ℝ × ℝ × ℝ)) 0 (Set.Ici X) X :=
          (hasDerivWithinAt_const X (Set.Ici X) (0:ℝ)).congr_of_eventuallyEq hev
            (by show G (s, X, η) = 0; exact hGw)
        exact (uniqueDiffWithinAt_Ici X).eq_deriv _ hd1.hasDerivWithinAt h2
    simp only [pbdProf]
    rw [hfd, hGw]
    simp

  have hEb : ∀ (i : ℕ) (w : ℝ × ℝ × ℝ), ‖iteratedFDeriv ℝ i E w‖ ≤ |h| ^ i * Real.exp (h * w.1) := by
    intro i w
    have he : ContDiff ℝ ∞ (fun t : ℝ => Real.exp (h * t)) := (contDiff_const.mul contDiff_id).exp
    let π1 := ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)
    have e : E = (fun t : ℝ => Real.exp (h * t)) ∘ π1 := by rw [hE]; rfl
    rw [e, ContinuousLinearMap.iteratedFDeriv_comp_right π1 he w (hle i)]
    refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
    have hp : ∏ _i : Fin i, ‖π1‖ ≤ 1 := by
      rw [Finset.prod_const]
      exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_fst_le ℝ ℝ (ℝ × ℝ))
    have hn : ‖iteratedFDeriv ℝ i (fun t : ℝ => Real.exp (h * t)) (π1 w)‖ =
        |h| ^ i * Real.exp (h * w.1) := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
      simp only [iteratedDeriv_exp_const_mul, Real.norm_eq_abs, abs_mul, abs_pow, Real.abs_exp]
      rfl
    rw [hn]
    calc |h| ^ i * Real.exp (h * w.1) * ∏ _i : Fin i, ‖π1‖ ≤ |h| ^ i * Real.exp (h * w.1) * 1 :=
          mul_le_mul_of_nonneg_left hp (by positivity)
      _ = _ := mul_one _

  have hxf : ∀ (φ : ℝ → ℝ), ContDiffOn ℝ ∞ φ (Set.Ioi 0) → ∀ i : ℕ, ∃ σ : ℝ,
      ∀ w : ℝ × ℝ × ℝ, Xa ≤ w.2.1 → w.2.1 ≤ Xb →
        ‖iteratedFDeriv ℝ i (fun y : ℝ × ℝ × ℝ => φ y.2.1) w‖ ≤ σ := by
    intro φ hφ i
    have hcont : ContinuousOn (iteratedFDeriv ℝ i φ) (Set.Ioi 0) :=
      (hφ.continuousOn_iteratedFDerivWithin (hle i) isOpen_Ioi.uniqueDiffOn).congr
        (fun x hx => (iteratedFDerivWithin_of_isOpen i isOpen_Ioi hx).symm)
    have hsub : Set.Icc Xa Xb ⊆ Set.Ioi 0 := fun x hx => lt_of_lt_of_le hXa hx.1
    obtain ⟨σ, hσ⟩ := isCompact_Icc.exists_bound_of_continuousOn (hcont.mono hsub)
    refine ⟨σ, fun w h1 h2 => ?_⟩
    let π2 : (ℝ × ℝ × ℝ) →L[ℝ] ℝ :=
      (ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))
    have hU : IsOpen (π2 ⁻¹' Set.Ioi 0) := isOpen_Ioi.preimage π2.continuous
    have hwU : w ∈ π2 ⁻¹' Set.Ioi 0 := show (0:ℝ) < w.2.1 from lt_of_lt_of_le hXa h1
    have h1' := ContinuousLinearMap.iteratedFDerivWithin_comp_right π2 hφ isOpen_Ioi.uniqueDiffOn
      hU.uniqueDiffOn hwU (i := i) (hle i)
    rw [iteratedFDerivWithin_of_isOpen i hU hwU,
      iteratedFDerivWithin_of_isOpen i isOpen_Ioi (show π2 w ∈ Set.Ioi (0:ℝ) from hwU)] at h1'
    have e : (fun y : ℝ × ℝ × ℝ => φ y.2.1) = φ ∘ π2 := rfl
    rw [e, h1']
    refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
    have hπn : ‖π2‖ ≤ 1 :=
      (ContinuousLinearMap.opNorm_comp_le _ _).trans
        (mul_le_one₀ (ContinuousLinearMap.norm_fst_le ℝ ℝ ℝ) (norm_nonneg _)
          (ContinuousLinearMap.norm_snd_le ℝ ℝ (ℝ × ℝ)))
    have hp : ∏ _i : Fin i, ‖π2‖ ≤ 1 := by
      rw [Finset.prod_const]
      exact pow_le_one₀ (norm_nonneg _) hπn
    have hb : ‖iteratedFDeriv ℝ i φ (π2 w)‖ ≤ σ := hσ _ ⟨h1, h2⟩
    calc ‖iteratedFDeriv ℝ i φ (π2 w)‖ * ∏ _i : Fin i, ‖π2‖ ≤ ‖iteratedFDeriv ℝ i φ (π2 w)‖ * 1 :=
          mul_le_mul_of_nonneg_left hp (norm_nonneg _)
      _ ≤ σ := by rw [mul_one]; exact hb

  have hdX : ∀ (i : ℕ) (w : ℝ × ℝ × ℝ), w ∈ V →
      ‖iteratedFDeriv ℝ i G' w‖ ≤ ‖iteratedFDeriv ℝ (i + 1) G w‖ := by
    intro i w hw
    have hb := norm_iteratedFDerivWithin_clm_apply_const (hfdG w hw) hVo.uniqueDiffOn hw
      (c := ((0:ℝ), (1:ℝ), (0:ℝ))) (n := i) (hle i)
    rw [iteratedFDerivWithin_of_isOpen i hVo hw, iteratedFDerivWithin_of_isOpen i hVo hw] at hb
    have hv : ‖((0:ℝ), (1:ℝ), (0:ℝ))‖ = 1 := by simp [Prod.norm_def]
    rw [hv, one_mul, norm_iteratedFDeriv_fderiv] at hb
    rw [hG']
