theorem ax_prof_regular : ∀ (h j0 σ δ Λ C K ρ1 t1 κ0 om r : ℝ) (Pax : ℝ → ℝ) (Kder : ℕ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 1 ≤ Λ → 0 < t1 → 0 < om → 0 < r → r ≤ ρ1 → AxAxisOut h j0 σ δ Pax Λ C K ρ1 Kder Fn Un → ContDiffOn ℝ ∞ (↿(axShearA h Λ t1 κ0 om Fn Un)) (univ ×ˢ Ioo (-1 - r) (1 + r)) → ContDiffOn ℝ ∞ (↿(axSlopeU h Λ t1 κ0 om Pax Fn Un)) (univ ×ˢ Ioo (-1 - r) (1 + r)) → ∃ ε' : ℝ, 0 < ε' ∧ ContDiffOn ℝ ∞ (↿(axProfF h Λ t1 κ0 om Fn Un)) (Ioi (-ε') ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(axProfU h Λ t1 κ0 om Pax Fn Un)) (Ioi (-ε') ×ˢ Ioo (-1) 1) ∧ (∀ X η : ℝ, 0 ≤ X → -1 < η → η < 1 → 0 < axProfF h Λ t1 κ0 om Fn Un X η) ∧ (∀ X₁ : ℝ, ∀ m : ℕ, ∃ C' : ℝ, ∀ X η : ℝ, 0 ≤ X → X ≤ X₁ → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿(axProfF h Λ t1 κ0 om Fn Un)) (X, η)‖ ≤ C' ∧ ‖iteratedFDeriv ℝ m (↿(axProfU h Λ t1 κ0 om Pax Fn Un)) (X, η)‖ ≤ C') :=
by

  have pd : ∀ (lo hi α β x0 : ℝ), lo < x0 → x0 < hi → ∀ (c : ℝ × ℝ → ℝ),
      ContDiffOn ℝ ∞ c (Ioo lo hi ×ˢ Ioo α β) → ∀ (C1 : ℝ),
      (∀ z ∈ Ioo lo hi ×ˢ Ioo α β, ‖iteratedFDeriv ℝ 1 c z‖ ≤ C1) →
      ∀ p ∈ Ioo lo hi ×ˢ Ioo α β, HasFDerivAt (fun q : ℝ × ℝ => ∫ s in x0..q.1, c (s, q.2))
        ((∫ s in x0..p.1, fderiv ℝ c (s, p.2) (0, 1)) • ContinuousLinearMap.snd ℝ ℝ ℝ
          + c p • ContinuousLinearMap.fst ℝ ℝ ℝ) p := by
    intro lo hi α β x0 hax hxb c hc C1 hC1
    have hUo : IsOpen (Ioo lo hi ×ˢ Ioo α β) := isOpen_Ioo.prod isOpen_Ioo
