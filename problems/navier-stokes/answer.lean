        calc NB B.h (fun η => g (s γ m η)) k ξ ≤ ‖g‖ * NB B.h (s γ m) k ξ := h1
          _ ≤ ‖g‖ * (|C| * (qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ b)) :=
              mul_le_mul_of_nonneg_left (h2.trans h3) (norm_nonneg _)
          _ = ‖g‖ * |C| * qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ b := by ring
    obtain ⟨gA, hgA⟩ : ∃ g : ℝ →L[ℝ] (Fin 3 → ℂ), ∀ x : ℝ, g x = ![-(x:ℂ) / 2, 0, 0] :=
      ⟨(ContinuousLinearMap.id ℝ ℝ).smulRight ![(-1/2 : ℂ), 0, 0], fun x => by
        funext i; fin_cases i <;> simp [Complex.real_smul] <;> ring⟩
    obtain ⟨gB, hgB⟩ : ∃ g : ℝ →L[ℝ] (Fin 3 → ℂ), ∀ x : ℝ, g x = ![0, -(x:ℂ) / 2, 0] :=
      ⟨(ContinuousLinearMap.id ℝ ℝ).smulRight ![0, (-1/2 : ℂ), 0], fun x => by
