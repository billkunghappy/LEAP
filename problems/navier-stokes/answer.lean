            mul_le_mul (hb n w hw) (pow_le_pow_left₀ (norm_nonneg _) hy.le n) (by positivity)
              (by positivity)
        _ = B * (1 / 2) ^ n := by rw [mul_assoc, ← mul_pow]; norm_num
    have hFd : ∀ n, DifferentiableOn ℂ (fun w => c n w * y ^ n) (axRect s) :=
      fun n => (hd n).mul_const _
    have hT := Complex.differentiableOn_tsum_of_summable_norm hu hFd hU hFb
    have hH := Complex.hasSum_deriv_of_summable_norm hu hFd hU hFb hw0
    have hderiv : ∀ n, deriv (fun w => c n w * y ^ n) w0 = deriv (c n) w0 * y ^ n := fun n =>
      deriv_mul_const (((hd n).differentiableAt (hU.mem_nhds hw0))) _
    simp only [hderiv] at hH
