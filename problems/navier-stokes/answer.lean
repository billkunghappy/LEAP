    rw [hev.fderiv_eq, hchain, ContinuousLinearMap.smul_apply, hΛd, smul_eq_mul, mul_comm]

  have hvcoΩ : ContDiffOn ℝ ∞ (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) Ω := by
    have hs : ContDiff ℝ ∞ (fun η : Cyl => (Λ (bandIdx B.h γ.1) η + (-d) + G.r0) / cib B.h γ.1) :=
      (((Λ (bandIdx B.h γ.1)).contDiff.add contDiff_const).add contDiff_const).div_const _
    refine hs.contDiffOn.congr (fun η hη => ?_)
    show vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = (Λ (bandIdx B.h γ.1) η + (-d) + G.r0) / cib B.h γ.1
    unfold vco
    rw [hF η hη]
  have hpsiCD : ContDiffOn ℝ ∞ (psiW B G γ) Ω :=
    (hΘs.comp ((Λ (bandIdx B.h γ.1)).contDiff.add contDiff_const)).contDiffOn.congr
      (fun η hη => hpsiΩ η hη)
  have hpsidCD : ContDiffOn ℝ ∞ (psiWd B G γ) Ω :=
    ((contDiff_const (c := cib B.h γ.1)).mul
      (hΘ'cs.comp ((Λ (bandIdx B.h γ.1)).contDiff.add contDiff_const))).contDiffOn.congr
      (fun η hη => hpsiWd η hη)

  have hNBeq : ∀ (f g : Cyl → ℝ), f =ᶠ[nhds ξ] g → NB B.h f j ξ = NB B.h g j ξ := by
    intro f g hfg
    unfold NB
    rw [(hfg.iteratedFDeriv ℝ j).eq_of_nhds]
  have hcomp : ∀ (ψ : ℝ → ℝ) (K : ℝ), ContDiff ℝ ∞ ψ → (∀ x : ℝ, ‖iteratedFDeriv ℝ j ψ x‖ ≤ K) →
      NB B.h (fun η : Cyl => ψ (Λ (bandIdx B.h γ.1) η + (-d))) j ξ ≤ K * (2 * Tgc ^ 3) ^ j := by
    intro ψ K hψ hK
    have hg : ContDiff ℝ ∞ (fun y : ℝ => ψ (y + (-d))) := hψ.comp (contDiff_id.add contDiff_const)
    have hfun : (fun η : Cyl => ψ (Λ (bandIdx B.h γ.1) η + (-d))) =
        (fun y : ℝ => ψ (y + (-d))) ∘ ⇑(Λ (bandIdx B.h γ.1)) := rfl
    have h2 : iteratedFDeriv ℝ j (fun η : Cyl => ψ (Λ (bandIdx B.h γ.1) η + (-d))) ξ =
        (iteratedFDeriv ℝ j (fun y : ℝ => ψ (y + (-d))) (Λ (bandIdx B.h γ.1) ξ)).compContinuousLinearMap
          (fun _ => Λ (bandIdx B.h γ.1)) := by
      rw [hfun]
      exact (Λ (bandIdx B.h γ.1)).iteratedFDeriv_comp_right hg ξ (by exact_mod_cast le_top)
    have h3 : iteratedFDeriv ℝ j (fun y : ℝ => ψ (y + (-d))) (Λ (bandIdx B.h γ.1) ξ) =
        iteratedFDeriv ℝ j ψ (Λ (bandIdx B.h γ.1) ξ + (-d)) :=
      iteratedFDeriv_comp_add_right j (-d) (Λ (bandIdx B.h γ.1) ξ)
    set Mm := iteratedFDeriv ℝ j ψ (Λ (bandIdx B.h γ.1) ξ + (-d)) with hMm
    set T : Cyl →L[ℝ] ℝ := (Λ (bandIdx B.h γ.1)).comp (Lnorm B.h ξ) with hT
    have e : (Mm.compContinuousLinearMap (fun _ => Λ (bandIdx B.h γ.1))).compContinuousLinearMap
        (fun _ => Lnorm B.h ξ) = Mm.compContinuousLinearMap (fun _ => T) := by
      ext v
      rfl
    have h4 : NB B.h (fun η : Cyl => ψ (Λ (bandIdx B.h γ.1) η + (-d))) j ξ =
        ‖Mm.compContinuousLinearMap (fun _ => T)‖ := by
      unfold NB
      rw [h2, h3, e]
    have h5 : ‖Mm.compContinuousLinearMap (fun _ => T)‖ ≤ ‖Mm‖ * ∏ _i : Fin j, ‖T‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    have h6 : ‖T‖ ≤ 2 * Tgc ^ 3 := by
      refine ContinuousLinearMap.opNorm_le_bound _ hc (fun w => ?_)
      rw [hT, ContinuousLinearMap.comp_apply, Real.norm_eq_abs]
      exact hslope w
    have hprod : ∏ _i : Fin j, ‖T‖ = ‖T‖ ^ j := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    have hpow : ‖T‖ ^ j ≤ (2 * Tgc ^ 3) ^ j := pow_le_pow_left₀ (norm_nonneg _) h6 j
    have hMK : ‖Mm‖ ≤ K := hK _
    rw [h4]
    refine h5.trans ?_
    rw [hprod]
    exact mul_le_mul hMK hpow (pow_nonneg (norm_nonneg _) j) ((norm_nonneg _).trans hMK)
  have hevW : psiW B G γ =ᶠ[nhds ξ] (fun η : Cyl => Θ (Λ (bandIdx B.h γ.1) η + (-d))) :=
    Filter.eventuallyEq_of_mem (hΩo.mem_nhds hξΩ) (fun η hη => hpsiΩ η hη)
  have hevWd : psiWd B G γ =ᶠ[nhds ξ]
      (fun η : Cyl => cib B.h γ.1 * deriv Θ (Λ (bandIdx B.h γ.1) η + (-d))) :=
    Filter.eventuallyEq_of_mem (hΩo.mem_nhds hξΩ) (fun η hη => hpsiWd η hη)
  have hMle : ∀ K : ℝ, K ≤ K1 + K2 → K * (2 * Tgc ^ 3) ^ j ≤ (K1 + K2) * (2 * Tgc ^ 3) ^ j :=
    fun K hK => mul_le_mul_of_nonneg_right hK (pow_nonneg hc _)
  have hN1 : NB B.h (psiW B G γ) j ξ ≤ (K1 + K2) * (2 * Tgc ^ 3) ^ j := by
    rw [hNBeq _ _ hevW]
    exact (hcomp Θ K1 hΘs hK1).trans (hMle K1 (by linarith))
  have hb2 : ∀ x : ℝ, ‖iteratedFDeriv ℝ j (fun y : ℝ => cib B.h γ.1 * deriv Θ y) x‖ ≤ K2 := by
    intro x
    have e : (fun y : ℝ => cib B.h γ.1 * deriv Θ y) = cib B.h γ.1 • deriv Θ := rfl
    rw [e, iteratedFDeriv_const_smul_apply (hΘ'cs.contDiffAt.of_le (by exact_mod_cast le_top)),
      norm_smul, Real.norm_eq_abs, abs_of_pos hcb0]
    calc cib B.h γ.1 * ‖iteratedFDeriv ℝ j (deriv Θ) x‖ ≤ 1 * K2 :=
          mul_le_mul hcb1 (hK2 x) (norm_nonneg _) zero_le_one
      _ = K2 := one_mul _
  have hN2 : NB B.h (psiWd B G γ) j ξ ≤ (K1 + K2) * (2 * Tgc ^ 3) ^ j := by
    rw [hNBeq _ _ hevWd]
    exact (hcomp (fun y : ℝ => cib B.h γ.1 * deriv Θ y) K2 (contDiff_const.mul hΘ'cs) hb2).trans
      (hMle K2 (by linarith))

  have hwin : |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2| =
      |etG B.h γ (G.ctr γ) ξ.2.2.2| / cib B.h γ.1 := by
    unfold vco Lsb
    have e1 : (etG B.h γ (G.ctr γ) ξ.2.2.2 + G.r0) / cib B.h γ.1 - 2 * G.r0 / cib B.h γ.1 / 2 =
        etG B.h γ (G.ctr γ) ξ.2.2.2 / cib B.h γ.1 := by field_simp; ring
    rw [e1, abs_div, abs_of_pos hcb0]
  have hL5 : Lsb B.h G.r0 γ.1 / 5 = (2 * G.r0 / 5) / cib B.h γ.1 := by unfold Lsb; ring
  have hL3 : Lsb B.h G.r0 γ.1 / 3 = (2 * G.r0 / 3) / cib B.h γ.1 := by unfold Lsb; ring
  have hW1 : |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2| < Lsb B.h G.r0 γ.1 / 5 →
      |Λ (bandIdx B.h γ.1) ξ + (-d)| < 2 * G.r0 / 5 := by
    intro h
    rw [hwin, hL5] at h
    rw [← hF ξ hξΩ]
    exact (div_lt_div_iff_of_pos_right hcb0).mp h
  have hW2 : Lsb B.h G.r0 γ.1 / 3 < |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2| →
      2 * G.r0 / 3 < |Λ (bandIdx B.h γ.1) ξ + (-d)| := by
    intro h
    rw [hwin, hL3] at h
    rw [← hF ξ hξΩ]
    exact (div_lt_div_iff_of_pos_right hcb0).mp h
  have hcontF : Continuous (fun η : Cyl => |Λ (bandIdx B.h γ.1) η + (-d)|) :=
    continuous_abs.comp ((Λ (bandIdx B.h γ.1)).continuous.add continuous_const)
  have hZ1 : (|vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2| < Lsb B.h G.r0 γ.1 / 5 ∨
      Lsb B.h G.r0 γ.1 / 3 < |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2|) →
      NB B.h (psiWd B G γ) j ξ = 0 := by
    intro hcase
    have hξV : |Λ (bandIdx B.h γ.1) ξ + (-d)| < 2 * G.r0 / 5 ∨
        2 * G.r0 / 3 < |Λ (bandIdx B.h γ.1) ξ + (-d)| := hcase.imp hW1 hW2
    have hVo : IsOpen (Ω ∩ ({η : Cyl | |Λ (bandIdx B.h γ.1) η + (-d)| < 2 * G.r0 / 5} ∪
        {η : Cyl | 2 * G.r0 / 3 < |Λ (bandIdx B.h γ.1) η + (-d)|})) :=
      hΩo.inter ((isOpen_lt hcontF continuous_const).union (isOpen_lt continuous_const hcontF))
    have hev : psiWd B G γ =ᶠ[nhds ξ] fun _ => (0:ℝ) :=
      Filter.eventuallyEq_of_mem (hVo.mem_nhds ⟨hξΩ, hξV⟩) (fun η hη => by
        show psiWd B G γ η = 0
        rw [hpsiWd η hη.1, hD0 _ hη.2, mul_zero])
    rw [hNBeq _ _ hev]
    unfold NB
    have h0 : iteratedFDeriv ℝ j (fun _ : Cyl => (0:ℝ)) = 0 := iteratedFDeriv_fun_zero
    rw [h0]
    have e : ((0 : Cyl → ContinuousMultilinearMap ℝ (fun _ : Fin j => Cyl) ℝ) ξ).compContinuousLinearMap
        (fun _ => Lnorm B.h ξ) = 0 := by
      ext m; simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e, norm_zero]
  have hZ2 : Lsb B.h G.r0 γ.1 / 3 < |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2| →
      ∀ᶠ η in nhds ξ, psiW B G γ η = 0 ∧ psiWd B G γ η = 0 := by
    intro hcase
    have hξV := hW2 hcase
    have hVo : IsOpen (Ω ∩ {η : Cyl | 2 * G.r0 / 3 < |Λ (bandIdx B.h γ.1) η + (-d)|}) :=
      hΩo.inter (isOpen_lt continuous_const hcontF)
    exact Filter.eventually_of_mem (hVo.mem_nhds ⟨hξΩ, hξV⟩) (fun η hη =>
      ⟨by rw [hpsiΩ η hη.1, hFar _ hη.2], by rw [hpsiWd η hη.1, hD0 _ (Or.inr hη.2), mul_zero]⟩)
  exact ⟨⟨Ω, hΩo, hξΩ, hvcoΩ, hpsiCD, hpsidCD⟩, hN1, hN2, hZ1, hZ2⟩

theorem fpj_affine_pullback : ∀ {E E' V : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup E'] [NormedSpace ℝ E'] [NormedAddCommGroup V] [NormedSpace ℝ V] (g : E' → V) (O : Set E') (Pi : E →L[ℝ] E') (a : E') (p0 : E) (Λ : E →L[ℝ] E) (Λ' : E' →L[ℝ] E') (T : E →L[ℝ] E') (j : ℕ), IsOpen O → Pi p0 + a ∈ O → ContDiffOn ℝ ∞ g O → (∀ w : E, Pi (Λ w) = Λ' (T w)) → iteratedFDeriv ℝ j (fun p => g (Pi p + a)) p0 = (iteratedFDeriv ℝ j g (Pi p0 + a)).compContinuousLinearMap (fun _ => Pi) ∧ ‖(iteratedFDeriv ℝ j (fun p => g (Pi p + a)) p0).compContinuousLinearMap (fun _ => Λ)‖ ≤ ‖(iteratedFDeriv ℝ j g (Pi p0 + a)).compContinuousLinearMap (fun _ => Λ')‖ * ‖T‖ ^ j :=
by
  intro E E' V _ _ _ _ _ _ g O Pi a p0 Λ Λ' T j hO hmem hg hint
  have hO' : IsOpen ((fun y : E' => y + a) ⁻¹' O) :=
    hO.preimage (continuous_id.add continuous_const)
  have hS : IsOpen ((Pi : E → E') ⁻¹' ((fun y : E' => y + a) ⁻¹' O)) :=
    hO'.preimage (ContinuousLinearMap.continuous Pi)
  have hmem' : Pi p0 ∈ (fun y : E' => y + a) ⁻¹' O := hmem
  have hmemS : p0 ∈ (Pi : E → E') ⁻¹' ((fun y : E' => y + a) ⁻¹' O) := hmem
  have hh : ContDiffOn ℝ ∞ (fun y : E' => g (y + a)) ((fun y : E' => y + a) ⁻¹' O) :=
    hg.comp (contDiff_id.add contDiff_const).contDiffOn (fun y hy => hy)
  have hc := ContinuousLinearMap.iteratedFDerivWithin_comp_right Pi hh hO'.uniqueDiffOn
    hS.uniqueDiffOn hmem' (i := j) (by exact_mod_cast le_top)
  rw [iteratedFDerivWithin_of_isOpen j hS hmemS,
    iteratedFDerivWithin_of_isOpen j hO' hmem'] at hc
  have hA : iteratedFDeriv ℝ j (fun p => g (Pi p + a)) p0 =
      (iteratedFDeriv ℝ j g (Pi p0 + a)).compContinuousLinearMap (fun _ => Pi) := by
    have e1 : (fun p => g (Pi p + a)) = (fun y : E' => g (y + a)) ∘ Pi := rfl
    rw [e1, hc, iteratedFDeriv_comp_add_right]
  refine ⟨hA, ?_⟩
  rw [hA]
  have e2 : ((iteratedFDeriv ℝ j g (Pi p0 + a)).compContinuousLinearMap (fun _ => Pi)).compContinuousLinearMap
      (fun _ => Λ) = ((iteratedFDeriv ℝ j g (Pi p0 + a)).compContinuousLinearMap
      (fun _ => Λ')).compContinuousLinearMap (fun _ => T) := by
    ext m
    simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply, hint]
  rw [e2]
  refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
  rw [Fin.prod_const]

theorem fsj_cpx_duhamel : ∀ (A0 : ℝ → Matrix (Fin 3) (Fin 3) ℝ) (P : ℝ → ℝ) (L K F : ℝ) (y r : ℝ → (Fin 3 → ℂ)), ContinuousOn A0 (Set.Icc 0 L) → (∀ v, 0 < P v) → 0 ≤ K → 0 ≤ F → (∀ (x : ℝ → (Fin 3 → ℝ)) (w : ℝ), 0 ≤ w → w ≤ L → (∀ v ∈ Set.Icc w L, HasDerivAt x ((A0 v).mulVec (x v)) v) → ∀ v ∈ Set.Icc w L, ‖x v‖ ≤ K * (P v / P w) * ‖x w‖) → (∀ v ∈ Set.Icc 0 L, HasDerivWithinAt y (((A0 v).map (fun a : ℝ => (a : ℂ))).mulVec (y v) + r v) (Set.Icc 0 L) v) → (∀ v ∈ Set.Icc 0 L, ‖r v‖ ≤ F * P v) → y 0 = 0 → ∀ v ∈ Set.Icc 0 L, ‖y v‖ ≤ 2 * K * P v * F * v :=
by
  have forced_duhamel_within5 : ∀ (A0 : ℝ → Matrix (Fin 3) (Fin 3) ℝ) (P : ℝ → ℝ) (L K F : ℝ) (y r : ℝ → (Fin 3 → ℝ)), Continuous A0 → (∀ v, 0 < P v) → 0 ≤ K → 0 ≤ F → (∀ (x : ℝ → (Fin 3 → ℝ)) (w : ℝ), 0 ≤ w → w ≤ L → (∀ v ∈ Set.Icc w L, HasDerivAt x ((A0 v).mulVec (x v)) v) → ∀ v ∈ Set.Icc w L, ‖x v‖ ≤ K * (P v / P w) * ‖x w‖) → (∀ v ∈ Set.Icc (0:ℝ) L, HasDerivWithinAt y ((A0 v).mulVec (y v) + r v) (Set.Icc (0:ℝ) L) v) → (∀ v ∈ Set.Icc (0:ℝ) L, ‖r v‖ ≤ F * P v) → ∀ v ∈ Set.Icc (0:ℝ) L, ‖y v‖ ≤ K * P v * (‖y 0‖ / P 0 + F * v) := by
    have lode : ∀ (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] (B : ℝ → E →L[ℝ] E) (g : ℝ → E) (x0 : E), Continuous B → Continuous g → ∃ y : ℝ → E, y 0 = x0 ∧ ∀ v : ℝ, HasDerivAt y (B v (y v) + g v) v := by
      intro E _ _ _ B g x0 hB hg
      have : CompleteSpace E := FiniteDimensional.complete ℝ E
      have retr : ∀ R : ℝ, 0 < R → ∃ ρ : E → E, (∀ x y, ‖ρ x - ρ y‖ ≤ 2 * ‖x - y‖) ∧
          (∀ x, ‖ρ x‖ ≤ ‖x‖) ∧ (∀ x, ‖ρ x‖ ≤ R) ∧ (∀ x, ‖x‖ ≤ R → ρ x = x) := by
        intro R hR
        refine ⟨fun x => (R / max ‖x‖ R) • x, ?_, ?_, ?_, ?_⟩
        · intro x y
          have hmx : 0 < max ‖x‖ R := lt_max_of_lt_right hR
          have hmy : 0 < max ‖y‖ R := lt_max_of_lt_right hR
          obtain ⟨a, ha⟩ : ∃ a : ℝ, a = R / max ‖x‖ R := ⟨_, rfl⟩
          obtain ⟨b, hb⟩ : ∃ b : ℝ, b = R / max ‖y‖ R := ⟨_, rfl⟩
          have ha0 : 0 ≤ a := by rw [ha]; exact div_nonneg hR.le hmx.le
          have ha1 : a ≤ 1 := by rw [ha]; exact (div_le_one hmx).2 (le_max_right _ _)
          have hyb : ‖y‖ ≤ max ‖y‖ R := le_max_left _ _
          have hab : |a - b| * ‖y‖ ≤ ‖x - y‖ := by
            have e : a - b = a * (max ‖y‖ R - max ‖x‖ R) / max ‖y‖ R := by
              rw [ha, hb]; field_simp
            have hm := abs_max_sub_max_le_abs ‖y‖ ‖x‖ R
            have hn := abs_norm_sub_norm_le y x
            rw [norm_sub_rev] at hn
            rw [e, abs_div, abs_mul, abs_of_nonneg ha0, abs_of_pos hmy]
            have e2 : a * |max ‖y‖ R - max ‖x‖ R| / max ‖y‖ R * ‖y‖ =
                (a * (‖y‖ / max ‖y‖ R)) * |max ‖y‖ R - max ‖x‖ R| := by ring
            rw [e2]
            have h1 : ‖y‖ / max ‖y‖ R ≤ 1 := (div_le_one hmy).2 hyb
            have h2 : 0 ≤ ‖y‖ / max ‖y‖ R := div_nonneg (norm_nonneg _) hmy.le
            have h3 : a * (‖y‖ / max ‖y‖ R) ≤ 1 := by nlinarith
            calc a * (‖y‖ / max ‖y‖ R) * |max ‖y‖ R - max ‖x‖ R|
                ≤ 1 * |max ‖y‖ R - max ‖x‖ R| := mul_le_mul_of_nonneg_right h3 (abs_nonneg _)
              _ ≤ ‖x - y‖ := by linarith
          have e2 : a • x - b • y = a • (x - y) + (a - b) • y := by
            rw [smul_sub, sub_smul]; abel
          show ‖(R / max ‖x‖ R) • x - (R / max ‖y‖ R) • y‖ ≤ 2 * ‖x - y‖
          rw [← ha, ← hb, e2]
          calc ‖a • (x - y) + (a - b) • y‖ ≤ ‖a • (x - y)‖ + ‖(a - b) • y‖ := norm_add_le _ _
            _ = a * ‖x - y‖ + |a - b| * ‖y‖ := by
                rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg ha0]
            _ ≤ 1 * ‖x - y‖ + ‖x - y‖ :=
                add_le_add (mul_le_mul_of_nonneg_right ha1 (norm_nonneg _)) hab
            _ = 2 * ‖x - y‖ := by ring
        · intro x
          have hmx : 0 < max ‖x‖ R := lt_max_of_lt_right hR
          show ‖(R / max ‖x‖ R) • x‖ ≤ ‖x‖
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (div_nonneg hR.le hmx.le)]
          have ha1 : R / max ‖x‖ R ≤ 1 := (div_le_one hmx).2 (le_max_right _ _)
          calc R / max ‖x‖ R * ‖x‖ ≤ 1 * ‖x‖ := mul_le_mul_of_nonneg_right ha1 (norm_nonneg _)
            _ = ‖x‖ := one_mul _
        · intro x
          have hmx : 0 < max ‖x‖ R := lt_max_of_lt_right hR
          show ‖(R / max ‖x‖ R) • x‖ ≤ R
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (div_nonneg hR.le hmx.le)]
          rw [div_mul_eq_mul_div, div_le_iff₀ hmx]
          exact mul_le_mul_of_nonneg_left (le_max_left _ _) hR.le
        · intro x hx
          show (R / max ‖x‖ R) • x = x
          rw [max_eq_right hx, div_self hR.ne', one_smul]
      have fwd : ∀ (r F : ℝ → E) (K ε T : ℝ), 0 ≤ K → 0 ≤ ε → 0 ≤ T →
          (∀ v ∈ Set.Icc (-T) T, HasDerivWithinAt r (F v) (Set.Icc (-T) T) v) →
          (∀ v ∈ Set.Icc (-T) T, ‖F v‖ ≤ K * ‖r v‖ + ε) →
          ∀ v ∈ Set.Icc (0:ℝ) T, ‖r v‖ ≤ (‖r 0‖ + ε * T) * Real.exp (K * T) := by
        intro r F K ε T hK hε hT hd hbd v hv
        have hcont : ContinuousOn r (Set.Icc 0 T) := fun x hx =>
          ((hd x ⟨by linarith [hx.1], hx.2⟩).continuousWithinAt).mono
            (Set.Icc_subset_Icc (by linarith) le_rfl)
        have h1 := norm_le_gronwallBound_of_norm_deriv_right_le (f := r) (f' := F)
          (δ := ‖r 0‖) (K := K) (ε := ε) (a := 0) (b := T) hcont
          (fun x hx => (hd x ⟨by linarith [hx.1], hx.2.le⟩).mono_of_mem_nhdsWithin
            (Icc_mem_nhdsGE_of_mem ⟨by linarith [hx.1], hx.2⟩)) le_rfl
          (fun x hx => hbd x ⟨by linarith [hx.1], hx.2.le⟩)
          v hv
        rw [sub_zero] at h1
        refine h1.trans ?_
        have hv0 : 0 ≤ v := hv.1
        have hvT : v ≤ T := hv.2
        have hδ : 0 ≤ ‖r 0‖ := norm_nonneg _
        have key : gronwallBound ‖r 0‖ K ε v ≤ (‖r 0‖ + ε * v) * Real.exp (K * v) := by
          rcases hK.eq_or_lt with h | h
          · subst h
