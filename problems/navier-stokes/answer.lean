theorem rfp_MJ_pulse : ∀ P : RfpPar, RfpRegime P → (∫ y in Iic (rfpY4 P.Md P.lam), Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 3)) = Real.exp (rfpY3 P.Md P.lam + rfpLam P (rfpY3 P.Md P.lam)) * Real.exp ((1 / 2 - P.lam) * (13 / P.lam - 3)) * (∫ τ in (-(3 / 20) : ℝ)..(3 / 20), Real.exp ((1 / 2 - P.lam) * τ) * rfpBmp τ) ∧ (∫ y in Iic (rfpY4 P.Md P.lam), Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 1)) = Real.exp (rfpY3 P.Md P.lam + rfpLam P (rfpY3 P.Md P.lam)) * Real.exp ((1 / 2 - P.lam) * (13 / P.lam - 1)) * (∫ τ in (-(3 / 20) : ℝ)..(3 / 20), Real.exp ((1 / 2 - P.lam) * τ) * rfpBmp τ) ∧ (∫ y in Iic (rfpY4 P.Md P.lam), Real.sqrt 2 * Real.exp (3 / 2 * y + 2 * rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 3)) = Real.sqrt 2 * Real.exp (3 / 2 * rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam)) * Real.exp ((1 / 2 - 2 * P.lam) * (13 / P.lam - 3)) * (∫ τ in (-(3 / 20) : ℝ)..(3 / 20), Real.exp ((1 / 2 - 2 * P.lam) * τ) * rfpBmp τ) ∧ (∫ y in Iic (rfpY4 P.Md P.lam), Real.sqrt 2 * Real.exp (3 / 2 * y + 2 * rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 1)) = Real.sqrt 2 * Real.exp (3 / 2 * rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam)) * Real.exp ((1 / 2 - 2 * P.lam) * (13 / P.lam - 1)) * (∫ τ in (-(3 / 20) : ℝ)..(3 / 20), Real.exp ((1 / 2 - 2 * P.lam) * τ) * rfpBmp τ) ∧ 0 ≤ (∫ y in Iic (rfpY4 P.Md P.lam), Real.exp (y + rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))) ∧ (∫ y in Iic (rfpY4 P.Md P.lam), Real.exp (y + rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))) ≤ 23 * Real.exp (rfpY3 P.Md P.lam + rfpLam P (rfpY3 P.Md P.lam)) * Real.exp (11 / (2 * P.lam)) ∧ 0 ≤ (∫ y in Iic (rfpY4 P.Md P.lam), Real.sqrt 2 * Real.exp (3 / 2 * y + 2 * rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))) ∧ (∫ y in Iic (rfpY4 P.Md P.lam), Real.sqrt 2 * Real.exp (3 / 2 * y + 2 * rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))) ≤ 23 * (Real.sqrt 2 * Real.exp (3 / 2 * rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam))) * Real.exp (11 / (2 * P.lam)) :=
by
  intro P hP
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hP

  have s0 : ∀ t : ℝ, t ≤ 0 → sigA t = 0 := fun t ht => by unfold sigA; rw [if_pos ht]
  have s1 : ∀ t : ℝ, 1 ≤ t → sigA t = 1 := fun t ht => by
    unfold sigA; rw [if_neg (by linarith), if_pos ht]
  have sb : ∀ t : ℝ, 0 ≤ sigA t ∧ sigA t ≤ 1 := by
    intro t
    unfold sigA
    split_ifs
    · norm_num
    · norm_num
    · have ha := Real.exp_pos (-1 / t ^ 2)
      have hc := Real.exp_pos (-1 / (1 - t) ^ 2)
      constructor
      · positivity
      · rw [div_le_one (by positivity)]; linarith
  have smeas : Measurable sigA := by
    change Measurable (fun y : ℝ => if y ≤ 0 then (0:ℝ) else if 1 ≤ y then 1 else
      Real.exp (-1 / y ^ 2) / (Real.exp (-1 / y ^ 2) + Real.exp (-1 / (1 - y) ^ 2)))
    refine Measurable.ite measurableSet_Iic measurable_const
      (Measurable.ite measurableSet_Ici measurable_const ?_)
    fun_prop
  have sII : ∀ a b : ℝ, IntervalIntegrable sigA volume a b := by
    intro a b
    refine IntervalIntegrable.mono_fun' (g := fun _ => (1:ℝ)) intervalIntegrable_const
      smeas.aestronglyMeasurable (ae_of_all _ (fun x => ?_))
    show ‖sigA x‖ ≤ 1
    rw [Real.norm_eq_abs, abs_of_nonneg (sb x).1]; exact (sb x).2

  have Sig0 : ∀ t : ℝ, t ≤ 0 → rfpSigI t = 0 := by
    intro t ht
