      unfold axBeta
      rw [hsig0 _ (div_neg_of_neg_of_pos (by linarith) (by linarith)).le, sub_zero]
    have hRef : ∀ x e, 0 ≤ x → x ≤ 4 / Λ * Real.exp y →
        axRefF Λ t1 Fn x e = Fn x e ∧ axRefU Λ t1 Un x e = Un x e := by
      intro x e _ hx
