    intro Y hY hY1
    unfold rinMom
    rw [intervalIntegral.integral_congr (g := fun x => P * x ^ (3 / 5 : ℝ)) ?_]
    · rw [intervalIntegral.integral_const_mul, integral_rpow (Or.inl (by norm_num)),
        Real.zero_rpow (by norm_num), Real.rpow_add_one hY.ne']
      ring
    · intro x hx
      rw [Set.uIcc_of_le hY.le] at hx
      exact H1 x hx.1 (hx.2.trans hY1)
  have alg : ∀ (L A B Y G I : ℝ), Y ≠ 0 → G ≠ 0 →
      -(1 - L * (4 * Y) / Y) + (A * I - B * (4 * I)) / (Y * G)
        = 4 * L - 1 - (4 * B - A) * (I / (Y * G)) := by
    intro L A B Y G I hY hG
    field_simp
    ring
  constructor
  · intro hX1 hcase
    have hG : Real.sqrt (2 * X) * c (Real.log X) = P * X ^ (3 / 5 : ℝ) := H1 X hX.le hX1
    have hGpos : 0 < P * X ^ (3 / 5 : ℝ) := mul_pos hP (Real.rpow_pos_of_pos hX _)
    have hGne : Real.sqrt (2 * X) * c (Real.log X) ≠ 0 := by rw [hG]; exact hGpos.ne'
    have hXe : X ≤ Real.exp 1 := hX1.trans he1
    unfold rinQf
    rw [hM X hX hXe, hJ X hX hXe, alg _ _ _ X _ _ hX.ne' hGne, hI1 X hX hX1, hG]
    have hρ : 5 / 8 * X * (P * X ^ (3 / 5 : ℝ)) / (X * (P * X ^ (3 / 5 : ℝ))) = 5 / 8 := by
      rw [div_eq_iff (mul_pos hX hGpos).ne']
      ring
    rw [hρ]
    linarith
  · intro hX1 hXe hcase
    have hint : ∀ a b : ℝ, 0 ≤ a → a ≤ b →
