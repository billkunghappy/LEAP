theorem tn_global_commute_v5 : ∀ (F : Cyl → ℝ), ContDiff ℝ ∞ F →
    (∀ (η : Cyl) (n m : ℤ), F (shY η ((n : ℝ), (m : ℝ))) = F η) →
    (∀ n : ℕ, ∃ C : ℝ, ∀ η : Cyl, ‖iteratedFDeriv ℝ n F η‖ ≤ C) →
    ContDiff ℝ ∞ (TN F) ∧
    ∀ (k : ℕ) (ξ : Cyl) (w : Fin k → Cyl),
      iteratedFDeriv ℝ k (TN F) ξ w = TN (fun η => iteratedFDeriv ℝ k F η w) ξ :=
by
  intro F hF hper hbd

  have dio : ∀ k1 k2 : ℤ, (k1, k2) ≠ (0, 0) →
      1 ≤ 3 * (1 + |(k1:ℝ)| + |(k2:ℝ)|) * |bgc * (k1:ℝ) + (k2:ℝ)| := by
    intro k1 k2 hk
    have hs2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
    have hs15 : Real.sqrt 2 < 1.5 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
    have hxy : (bgc * (k1:ℝ) + (k2:ℝ)) * ((Real.sqrt 2 + 1) * (k1:ℝ) - (k2:ℝ)) =
        ((2 * k1 ^ 2 - (k2 - k1) ^ 2 : ℤ) : ℝ) := by
      push_cast
      have e : (bgc * (k1:ℝ) + (k2:ℝ)) * ((Real.sqrt 2 + 1) * (k1:ℝ) - (k2:ℝ)) =
          Real.sqrt 2 ^ 2 * (k1:ℝ) ^ 2 - ((k2:ℝ) - k1) ^ 2 := by unfold bgc; ring
      rw [e, hs2]
    have hz : (2 * k1 ^ 2 - (k2 - k1) ^ 2 : ℤ) ≠ 0 := by
      intro h0
      by_cases hk1 : k1 = 0
      · subst hk1
        have h3 : k2 ^ 2 = 0 := by nlinarith [h0]
        have hk2 : k2 = 0 := (pow_eq_zero_iff two_ne_zero).mp h3
        exact hk (by rw [hk2])
      · have hirr := (irrational_iff_ne_rational _).mp irrational_sqrt_two |(k2 - k1)| |k1|
          (abs_ne_zero.mpr hk1)
        apply hirr
        have h2 : (2:ℝ) * (k1:ℝ) ^ 2 = ((k2:ℝ) - k1) ^ 2 := by
          have := congrArg (fun z : ℤ => (z : ℝ)) h0
          push_cast at this
          linarith
        have hk1r : (k1:ℝ) ≠ 0 := by exact_mod_cast hk1
        rw [Int.cast_abs, Int.cast_abs, Int.cast_sub, eq_div_iff (abs_ne_zero.mpr hk1r)]
        have hA : 0 ≤ Real.sqrt 2 * |(k1:ℝ)| := by positivity
        have hB : 0 ≤ |(k2:ℝ) - k1| := abs_nonneg _
        have hsq : (Real.sqrt 2 * |(k1:ℝ)|) ^ 2 = |(k2:ℝ) - k1| ^ 2 := by
          rw [mul_pow, hs2, sq_abs, sq_abs]; exact h2
        exact (pow_left_inj₀ hA hB two_ne_zero).mp hsq
    have hyb : |(Real.sqrt 2 + 1) * (k1:ℝ) - (k2:ℝ)| ≤ 3 * (1 + |(k1:ℝ)| + |(k2:ℝ)|) := by
      have a1 := le_abs_self (k1:ℝ)
      have a2 := neg_abs_le (k1:ℝ)
      have b1 := le_abs_self (k2:ℝ)
      have b2 := neg_abs_le (k2:ℝ)
      have hs1 : Real.sqrt 2 + 1 ≤ 3 := by linarith
      have hp : 0 < Real.sqrt 2 + 1 := by positivity
      rw [abs_le]
      constructor <;> nlinarith [mul_le_mul_of_nonneg_left a1 hp.le, mul_le_mul_of_nonneg_left a2 hp.le,
        mul_le_mul_of_nonneg_right hs1 (abs_nonneg (k1:ℝ))]
    have h1 : (1:ℝ) ≤ |bgc * (k1:ℝ) + (k2:ℝ)| * |(Real.sqrt 2 + 1) * (k1:ℝ) - (k2:ℝ)| := by
      rw [← abs_mul, hxy]
      exact_mod_cast Int.one_le_abs hz
    nlinarith [mul_le_mul_of_nonneg_left hyb (abs_nonneg (bgc * (k1:ℝ) + (k2:ℝ)))]

  have hsum : Summable (fun κ : ℤ × ℤ => 1 / (1 + |(κ.1 : ℝ)| + |(κ.2 : ℝ)|) ^ 4) := by
    have hf : Summable (fun n : ℤ => 1 / (1 + |(n:ℝ)|) ^ 2) := by
      have h := (Real.summable_one_div_int_add_rpow (1/2) 2).mpr (by norm_num)
      refine Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_) h
      rw [Real.rpow_two]
      have hne : (n:ℝ) + 1/2 ≠ 0 := by
        intro h0
        have h3 : (2:ℝ) * n = -1 := by linarith
        have h4 : (2 * n : ℤ) = -1 := by exact_mod_cast h3
        omega
      apply one_div_le_one_div_of_le
      · have := abs_pos.mpr hne
        positivity
      · have h5 : |(n:ℝ) + 1/2| ≤ 1 + |(n:ℝ)| := by
          rw [abs_le]
          constructor <;> linarith [le_abs_self (n:ℝ), neg_abs_le (n:ℝ)]
        exact pow_le_pow_left₀ (abs_nonneg _) h5 2
    have hprod := hf.mul_of_nonneg hf (fun n => by positivity) (fun n => by positivity)
    refine Summable.of_nonneg_of_le (fun κ => by positivity) (fun κ => ?_) hprod
    have ha := abs_nonneg (κ.1:ℝ)
    have hb := abs_nonneg (κ.2:ℝ)
    show 1 / (1 + |(κ.1 : ℝ)| + |(κ.2 : ℝ)|) ^ 4 ≤ 1 / (1 + |(κ.1:ℝ)|) ^ 2 * (1 / (1 + |(κ.2:ℝ)|) ^ 2)
    rw [div_mul_div_comm, one_mul]
    apply one_div_le_one_div_of_le (by positivity)
    have hL : (1 + |(κ.1:ℝ)|) * (1 + |(κ.2:ℝ)|) ≤ (1 + |(κ.1:ℝ)| + |(κ.2:ℝ)|) ^ 2 := by nlinarith
    calc (1 + |(κ.1:ℝ)|) ^ 2 * (1 + |(κ.2:ℝ)|) ^ 2 = ((1 + |(κ.1:ℝ)|) * (1 + |(κ.2:ℝ)|)) ^ 2 := by ring
      _ ≤ ((1 + |(κ.1:ℝ)| + |(κ.2:ℝ)|) ^ 2) ^ 2 := pow_le_pow_left₀ (by positivity) hL 2
      _ = _ := by ring

  obtain ⟨c, hc⟩ : ∃ c : ℤ × ℤ → ℂ, c = fun κ => if κ = 0 then 0 else
      (2 * Real.pi * Complex.I * ((bgc * (κ.1 : ℝ) + (κ.2 : ℝ) : ℝ) : ℂ))⁻¹ := ⟨_, rfl⟩
  obtain ⟨M, hM⟩ : ∃ M : (Cyl → ℝ) → ℤ × ℤ → Cyl → ℂ, M = fun H κ x => fourY H x κ *
      Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (x.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (x.2.2.2.2 : ℂ))) :=
    ⟨_, rfl⟩

  have G0 : ∀ (H : Cyl → ℝ) (x : Cyl), TN H x = (∑' κ : ℤ × ℤ, c κ * M H κ x).re := by
    intro H x
    unfold TN
    congr 1
    apply tsum_congr
    intro κ
    rw [hc, hM]
    dsimp only
    split_ifs
    · rw [zero_mul]
    · rw [div_eq_mul_inv]; ring

  have G1 : ∀ κ : ℤ × ℤ, ‖c κ‖ ≤ 1 + |(κ.1:ℝ)| + |(κ.2:ℝ)| := by
    intro κ
    have hL1 : (1:ℝ) ≤ 1 + |(κ.1:ℝ)| + |(κ.2:ℝ)| := by
      linarith [abs_nonneg (κ.1:ℝ), abs_nonneg (κ.2:ℝ)]
    rw [hc]
    dsimp only
    split_ifs with h0
    · rw [norm_zero]; linarith
    · have hne : (κ.1, κ.2) ≠ ((0:ℤ), (0:ℤ)) := by
        intro h
        exact h0 (Prod.ext (congrArg Prod.fst h) (congrArg Prod.snd h))
      have hd := dio κ.1 κ.2 hne
      have hdpos : 0 < |bgc * (κ.1:ℝ) + (κ.2:ℝ)| := by
        by_contra hneg
        rw [not_lt] at hneg
        have h00 : |bgc * (κ.1:ℝ) + (κ.2:ℝ)| = 0 := le_antisymm hneg (abs_nonneg _)
        rw [h00, mul_zero] at hd
        linarith
      have hnorm : ‖(2 * Real.pi * Complex.I * (((bgc * (κ.1:ℝ) + (κ.2:ℝ)) : ℝ) : ℂ))‖ =
          2 * Real.pi * |bgc * (κ.1:ℝ) + (κ.2:ℝ)| := by
        simp only [norm_mul, Complex.norm_two, Complex.norm_real, Complex.norm_I, Real.norm_eq_abs,
          abs_of_pos Real.pi_pos, mul_one]
      rw [norm_inv, hnorm, inv_le_iff_one_le_mul₀ (mul_pos (mul_pos two_pos Real.pi_pos) hdpos)]
      nlinarith [Real.pi_gt_three, mul_nonneg (mul_nonneg (by linarith : (0:ℝ) ≤ 1 + |(κ.1:ℝ)| + |(κ.2:ℝ)|)
        (abs_nonneg (bgc * (κ.1:ℝ) + (κ.2:ℝ)))) (le_of_lt (sub_pos.mpr Real.pi_gt_three))]

  have hMs : ∀ κ, ContDiff ℝ ∞ (M F κ) := fun κ => by
    rw [hM]; exact (tn_mode_smooth_v5 F κ hF hper).1
  have hMd : ∀ (κ : ℤ × ℤ) (k : ℕ) (ξ : Cyl) (w : Fin k → Cyl),
      iteratedFDeriv ℝ k (M F κ) ξ w = M (fun η => iteratedFDeriv ℝ k F η w) κ ξ := by
    intro κ k ξ w; rw [hM]; exact (tn_mode_smooth_v5 F κ hF hper).2 k ξ w
  obtain ⟨C, hC⟩ : ∃ C : ℕ → ℝ, ∀ (n : ℕ) (κ : ℤ × ℤ) (x : Cyl),
      ‖iteratedFDeriv ℝ n (M F κ) x‖ ≤ C n / (1 + |(κ.1 : ℝ)| + |(κ.2 : ℝ)|) ^ 5 := by
    choose C hC using tn_mode_decay_v5 F hF hper hbd
    exact ⟨C, by rw [hM]; exact hC⟩

  have hTs : ∀ κ, ContDiff ℝ ∞ (c κ • M F κ) := fun κ => (hMs κ).const_smul (c κ)
  have hTd : ∀ (n : ℕ) (κ : ℤ × ℤ) (x : Cyl),
      iteratedFDeriv ℝ n (c κ • M F κ) x = c κ • iteratedFDeriv ℝ n (M F κ) x := fun n κ x =>
    iteratedFDeriv_const_smul_apply ((hMs κ).contDiffAt.of_le (by exact_mod_cast le_top))
  have hD : ∀ (n : ℕ) (κ : ℤ × ℤ) (x : Cyl), ‖iteratedFDeriv ℝ n (c κ • M F κ) x‖ ≤
      |C n| * (1 / (1 + |(κ.1 : ℝ)| + |(κ.2 : ℝ)|) ^ 4) := by
    intro n κ x
    rw [hTd, norm_smul]
    have hLpos : 0 < 1 + |(κ.1 : ℝ)| + |(κ.2 : ℝ)| := by positivity
    have h1 : ‖iteratedFDeriv ℝ n (M F κ) x‖ ≤ |C n| / (1 + |(κ.1 : ℝ)| + |(κ.2 : ℝ)|) ^ 5 :=
      (hC n κ x).trans (div_le_div_of_nonneg_right (le_abs_self _) (by positivity))
    have key : ∀ X A : ℝ, 0 < X → X * (A / X ^ 5) = A * (1 / X ^ 4) := by
      intro X A hX
      have hX0 : X ≠ 0 := hX.ne'
      field_simp
    calc ‖c κ‖ * ‖iteratedFDeriv ℝ n (M F κ) x‖ ≤
        (1 + |(κ.1 : ℝ)| + |(κ.2 : ℝ)|) * (|C n| / (1 + |(κ.1 : ℝ)| + |(κ.2 : ℝ)|) ^ 5) :=
          mul_le_mul (G1 κ) h1 (norm_nonneg _) hLpos.le
      _ = _ := key _ _ hLpos
  have hv : ∀ n : ℕ, Summable (fun κ : ℤ × ℤ => |C n| * (1 / (1 + |(κ.1 : ℝ)| + |(κ.2 : ℝ)|) ^ 4)) :=
    fun n => hsum.mul_left _

  have hS : ContDiff ℝ ∞ (fun x => ∑' κ : ℤ × ℤ, (c κ • M F κ) x) :=
    contDiff_tsum (N := ⊤) hTs (fun k _ => hv k) (fun k κ x _ => hD k κ x)
  have hTNF : TN F = fun x => Complex.reCLM (∑' κ : ℤ × ℤ, (c κ • M F κ) x) := by
    funext x
    rw [G0 F x, Complex.reCLM_apply]
    rfl
  refine ⟨?_, ?_⟩
  · rw [hTNF]
    exact Complex.reCLM.contDiff.comp hS
  ·
    intro k ξ w
    have hcomp := ContinuousLinearMap.iteratedFDeriv_comp_left Complex.reCLM (hS.contDiffAt (x := ξ))
      (i := k) (by exact_mod_cast le_top)
    have htsum := iteratedFDeriv_tsum_apply (N := ⊤) hTs (fun k _ => hv k) (fun k κ x _ => hD k κ x)
      (k := k) (by exact_mod_cast le_top) ξ
    have : CompleteSpace (ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) ℂ) :=
      @ContinuousMultilinearMap.instCompleteSpace ℝ (Fin k) (fun _ => Cyl) ℂ _ _ _ _ _ _ _ _ _ _ _ _
        inferInstance
    have hA : Summable (fun κ : ℤ × ℤ => iteratedFDeriv ℝ k (c κ • M F κ) ξ) :=
      Summable.of_norm_bounded (hv k) (fun κ => hD k κ ξ)
    have e1 : iteratedFDeriv ℝ k (TN F) ξ w =
        ((iteratedFDeriv ℝ k (fun x => ∑' κ : ℤ × ℤ, (c κ • M F κ) x) ξ) w).re := by
      rw [hTNF]
      have e2 : (fun x => Complex.reCLM (∑' κ : ℤ × ℤ, (c κ • M F κ) x)) =
          ⇑Complex.reCLM ∘ (fun x => ∑' κ : ℤ × ℤ, (c κ • M F κ) x) := rfl
      rw [e2, hcomp, ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
        Complex.reCLM_apply]
    rw [e1, htsum, ContinuousMultilinearMap.tsum_eval hA, G0]
    congr 1
    apply tsum_congr
    intro κ
    rw [hTd, ContinuousMultilinearMap.smul_apply, smul_eq_mul, hMd]

theorem tn_bump_localize_v5 : ∀ (U : Set Cyl) (g : Cyl → ℝ), IsOpen U → (∀ ξ ∈ U, ∀ a : ℝ × ℝ, shY ξ a ∈ U) →
    ContDiffOn ℝ ∞ g U → (∀ ξ ∈ U, ∀ n m : ℤ, g (shY ξ ((n : ℝ), (m : ℝ))) = g ξ) →
    ∀ ξ0 ∈ U, ∃ (G : Cyl → ℝ) (r : ℝ), 0 < r ∧ ContDiff ℝ ∞ G ∧
      (∀ (η : Cyl) (n m : ℤ), G (shY η ((n : ℝ), (m : ℝ))) = G η) ∧
      (∀ n : ℕ, ∃ C : ℝ, ∀ η : Cyl, ‖iteratedFDeriv ℝ n G η‖ ≤ C) ∧
      ∀ η : Cyl, dist ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ) (ξ0.1, ξ0.2.1, ξ0.2.2.1) < r → G =ᶠ[nhds η] g :=
by
  intro U g hU hsat hg hper ξ0 hξ0
  obtain ⟨s0, hs0⟩ : ∃ s0 : ℝ × ℝ × ℝ, s0 = (ξ0.1, ξ0.2.1, ξ0.2.2.1) := ⟨_, rfl⟩
  rw [← hs0]
  have hσd : ContDiff ℝ ∞ (fun η : Cyl => ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ)) :=
    contDiff_fst.prodMk (contDiff_snd.fst.prodMk contDiff_snd.snd.fst)
  have hσc : Continuous (fun η : Cyl => ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ)) := hσd.continuous

  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hU ξ0 hξ0
  have htube : ∀ η : Cyl, dist ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ) s0 < ε → η ∈ U := by
    intro η hη
    rw [hs0] at hη
    have hmem : ((η.1, η.2.1, η.2.2.1, ξ0.2.2.2) : Cyl) ∈ U := by
      apply hball
      rw [Metric.mem_ball]
      simp only [Prod.dist_eq, dist_self, max_self, max_lt_iff] at hη ⊢
      exact ⟨hη.1, hη.2.1, hη.2.2, hε⟩
    have h2 := hsat _ hmem (η.2.2.2 - ξ0.2.2.2)
    have e2 : shY ((η.1, η.2.1, η.2.2.1, ξ0.2.2.2) : Cyl) (η.2.2.2 - ξ0.2.2.2) = η := by
      simp [shY]
    rwa [e2] at h2

  obtain ⟨φ, hφd, hφ0, hφ1⟩ : ∃ φ : ℝ × ℝ × ℝ → ℝ, ContDiff ℝ ∞ φ ∧
      (∀ s, ε / 2 ≤ dist s s0 → φ s = 0) ∧ (∀ s, dist s s0 ≤ ε / 4 → φ s = 1) := by
    let b : ContDiffBump s0 := ⟨ε / 4, ε / 2, by positivity, by linarith⟩
    exact ⟨b, b.contDiff, fun s hs => b.zero_of_le_dist hs,
      fun s hs => b.one_of_mem_closedBall (Metric.mem_closedBall.mpr hs)⟩
  obtain ⟨G, hG⟩ : ∃ G : Cyl → ℝ, G = fun η => φ (η.1, η.2.1, η.2.2.1) * g η := ⟨_, rfl⟩
  have hGapp : ∀ η : Cyl, G η = φ (η.1, η.2.1, η.2.2.1) * g η := by
    intro η; rw [hG]
  have hzero : ∀ η : Cyl, ε / 2 ≤ dist ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ) s0 → G η = 0 := by
    intro η h
    rw [hGapp, hφ0 _ h, zero_mul]
  have hO : IsOpen {x : Cyl | ε / 2 < dist ((x.1, x.2.1, x.2.2.1) : ℝ × ℝ × ℝ) s0} :=
    isOpen_lt continuous_const (Continuous.dist hσc continuous_const)

  have hGs : ContDiff ℝ ∞ G := by
    rw [contDiff_iff_contDiffAt]
    intro η
    rcases lt_or_ge (dist ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ) s0) ε with h | h
    · have hgη : ContDiffAt ℝ ∞ g η := hg.contDiffAt (hU.mem_nhds (htube η h))
      have hφη : ContDiffAt ℝ ∞ (fun η : Cyl => φ (η.1, η.2.1, η.2.2.1)) η :=
        (hφd.comp hσd).contDiffAt
      rw [hG]
      exact hφη.mul hgη
    · have hηO : η ∈ {x : Cyl | ε / 2 < dist ((x.1, x.2.1, x.2.2.1) : ℝ × ℝ × ℝ) s0} := by
        show ε / 2 < dist ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ) s0
        linarith
      have hev : G =ᶠ[nhds η] fun _ => (0 : ℝ) :=
        Filter.eventuallyEq_of_mem (hO.mem_nhds hηO) (fun x hx => hzero x (le_of_lt hx))
      exact contDiffAt_const.congr_of_eventuallyEq hev

  have hσsh : ∀ (η : Cyl) (a : ℝ × ℝ),
      (((shY η a).1, (shY η a).2.1, (shY η a).2.2.1) : ℝ × ℝ × ℝ) = (η.1, η.2.1, η.2.2.1) :=
    fun η a => rfl
  have hGper : ∀ (η : Cyl) (n m : ℤ), G (shY η ((n : ℝ), (m : ℝ))) = G η := by
    intro η n m
    by_cases hη : η ∈ U
    · rw [hGapp, hGapp, hper η hη n m, hσsh]
    · have hd : ε ≤ dist ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ) s0 :=
        not_lt.mp (fun h => hη (htube η h))
      rw [hzero η (by linarith), hzero (shY η ((n : ℝ), (m : ℝ))) (by rw [hσsh]; linarith)]
  refine ⟨G, ε / 4, by positivity, hGs, hGper, ?_, ?_⟩

  · intro n
    have hcont : Continuous (fun x => iteratedFDeriv ℝ n G x) :=
      hGs.continuous_iteratedFDeriv (by exact_mod_cast le_top)
    obtain ⟨C₀, hC₀⟩ := (isCompact_closedBall
      ((s0.1, s0.2.1, s0.2.2, ((0 : ℝ), (0 : ℝ))) : Cyl) (max (ε / 2) 1)).exists_bound_of_continuousOn
      hcont.continuousOn
    refine ⟨max C₀ 0, fun η => ?_⟩
    have hshift : ∀ (x : Cyl) (p q : ℤ),
        iteratedFDeriv ℝ n G (x + ((0 : ℝ), (0 : ℝ), (0 : ℝ), ((p : ℝ), (q : ℝ)))) =
          iteratedFDeriv ℝ n G x := by
      intro x p q
      have hfun : (fun z => G (z + ((0 : ℝ), (0 : ℝ), (0 : ℝ), ((p : ℝ), (q : ℝ))))) = G := by
        funext z
        have e : z + ((0 : ℝ), (0 : ℝ), (0 : ℝ), ((p : ℝ), (q : ℝ))) = shY z ((p : ℝ), (q : ℝ)) := by
          ext <;> simp [shY]
        rw [e, hGper]
      rw [← iteratedFDeriv_comp_add_right, hfun]
    have hdecomp : ((η.1, η.2.1, η.2.2.1, (Int.fract η.2.2.2.1, Int.fract η.2.2.2.2)) : Cyl) +
        ((0 : ℝ), (0 : ℝ), (0 : ℝ), (((⌊η.2.2.2.1⌋ : ℤ) : ℝ), ((⌊η.2.2.2.2⌋ : ℤ) : ℝ))) = η := by
      ext <;> simp
    have key : iteratedFDeriv ℝ n G η = iteratedFDeriv ℝ n G
        ((η.1, η.2.1, η.2.2.1, (Int.fract η.2.2.2.1, Int.fract η.2.2.2.2)) : Cyl) := by
      rw [← hshift ((η.1, η.2.1, η.2.2.1, (Int.fract η.2.2.2.1, Int.fract η.2.2.2.2)) : Cyl)
        ⌊η.2.2.2.1⌋ ⌊η.2.2.2.2⌋, hdecomp]
    rw [key]
    rcases le_or_gt (dist ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ) s0) (ε / 2) with h | h
    · have hmem : ((η.1, η.2.1, η.2.2.1, (Int.fract η.2.2.2.1, Int.fract η.2.2.2.2)) : Cyl) ∈
          Metric.closedBall ((s0.1, s0.2.1, s0.2.2, ((0 : ℝ), (0 : ℝ))) : Cyl) (max (ε / 2) 1) := by
        rw [Metric.mem_closedBall]
        have hρ1 : ε / 2 ≤ max (ε / 2) 1 := le_max_left _ _
        have hρ2 : (1 : ℝ) ≤ max (ε / 2) 1 := le_max_right _ _
        have hf1 : dist (Int.fract η.2.2.2.1) 0 ≤ max (ε / 2) 1 := by
          rw [Real.dist_eq, sub_zero, abs_of_nonneg (Int.fract_nonneg _)]
          linarith [Int.fract_lt_one η.2.2.2.1]
        have hf2 : dist (Int.fract η.2.2.2.2) 0 ≤ max (ε / 2) 1 := by
          rw [Real.dist_eq, sub_zero, abs_of_nonneg (Int.fract_nonneg _)]
          linarith [Int.fract_lt_one η.2.2.2.2]
        have hd := h
        simp only [Prod.dist_eq, max_le_iff] at hd ⊢
        exact ⟨by linarith [hd.1], by linarith [hd.2.1], by linarith [hd.2.2], hf1, hf2⟩
      exact (hC₀ _ hmem).trans (le_max_left _ _)
    · have hηO : ((η.1, η.2.1, η.2.2.1, (Int.fract η.2.2.2.1, Int.fract η.2.2.2.2)) : Cyl) ∈
          {x : Cyl | ε / 2 < dist ((x.1, x.2.1, x.2.2.1) : ℝ × ℝ × ℝ) s0} := h
      have hev : G =ᶠ[nhds ((η.1, η.2.1, η.2.2.1, (Int.fract η.2.2.2.1, Int.fract η.2.2.2.2)) : Cyl)]
          fun _ => (0 : ℝ) :=
        Filter.eventuallyEq_of_mem (hO.mem_nhds hηO) (fun x hx => hzero x (le_of_lt hx))
      rw [(hev.iteratedFDeriv ℝ n).eq_of_nhds, iteratedFDeriv_fun_zero]
      simp only [Pi.zero_apply, norm_zero]
      exact le_max_right _ _

  · intro η hη
    have hW : IsOpen {x : Cyl | dist ((x.1, x.2.1, x.2.2.1) : ℝ × ℝ × ℝ) s0 < ε / 4} :=
      isOpen_lt (Continuous.dist hσc continuous_const) continuous_const
    refine Filter.eventuallyEq_of_mem (hW.mem_nhds hη) (fun x hx => ?_)
    have hx' : dist ((x.1, x.2.1, x.2.2.1) : ℝ × ℝ × ℝ) s0 < ε / 4 := hx
    rw [hGapp, hφ1 _ (le_of_lt hx'), one_mul]

theorem tn_smooth_commute_v5 : ∀ (U : Set Cyl) (g : Cyl → ℝ), IsOpen U → (∀ ξ ∈ U, ∀ a : ℝ × ℝ, shY ξ a ∈ U) →
    ContDiffOn ℝ ∞ g U → (∀ ξ ∈ U, ∀ n m : ℤ, g (shY ξ ((n : ℝ), (m : ℝ))) = g ξ) →
    ContDiffOn ℝ ∞ (TN g) U ∧
    (∀ (k : ℕ) (ξ : Cyl) (w : Fin k → Cyl), ξ ∈ U →
      iteratedFDeriv ℝ k (TN g) ξ w = TN (fun η => iteratedFDeriv ℝ k g η w) ξ) :=
by
  intro U g hU hsat hg hper

  have fib : ∀ (f1 f2 : Cyl → ℝ) (η : Cyl),
      (∀ Y : ℝ × ℝ, f1 (η.1, η.2.1, η.2.2.1, Y) = f2 (η.1, η.2.1, η.2.2.1, Y)) →
      TN f1 η = TN f2 η := by
    intro f1 f2 η h
    have hf : ∀ k, fourY f1 η k = fourY f2 η k := by
      intro k
      unfold fourY
      simp only [h]
    unfold TN
    simp only [hf]

  have loc : ∀ ξ ∈ U, ∃ G : Cyl → ℝ, ContDiff ℝ ∞ (TN G) ∧
      (∀ (k : ℕ) (ξ' : Cyl) (w : Fin k → Cyl),
        iteratedFDeriv ℝ k (TN G) ξ' w = TN (fun η => iteratedFDeriv ℝ k G η w) ξ') ∧
      ∃ W : Set Cyl, IsOpen W ∧ ξ ∈ W ∧
        (∀ η ∈ W, ∀ Y : ℝ × ℝ, ((η.1, η.2.1, η.2.2.1, Y) : Cyl) ∈ W) ∧
        ∀ p ∈ W, G =ᶠ[nhds p] g := by
    intro ξ hξ
    obtain ⟨G, r, hr, hGs, hGp, hGb, hGe⟩ := tn_bump_localize_v5 U g hU hsat hg hper ξ hξ
    obtain ⟨h1, h2⟩ := tn_global_commute_v5 G hGs hGp hGb
    refine ⟨G, h1, h2,
      {η : Cyl | dist ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ) (ξ.1, ξ.2.1, ξ.2.2.1) < r}, ?_, ?_, ?_, ?_⟩
    · exact isOpen_lt (Continuous.dist (by fun_prop) continuous_const) continuous_const
    · show dist ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ) (ξ.1, ξ.2.1, ξ.2.2.1) < r
      rw [dist_self]; exact hr
    · intro η hη Y; exact hη
    · intro p hp; exact hGe p hp
  have hevTN : ∀ (G : Cyl → ℝ) (W : Set Cyl) (ξ : Cyl), IsOpen W → ξ ∈ W →
      (∀ η ∈ W, ∀ Y : ℝ × ℝ, ((η.1, η.2.1, η.2.2.1, Y) : Cyl) ∈ W) →
      (∀ p ∈ W, G =ᶠ[nhds p] g) → TN g =ᶠ[nhds ξ] TN G := by
    intro G W ξ hWo hξW hWsat hWe
    filter_upwards [hWo.mem_nhds hξW] with η hη
    exact fib g G η (fun Y => ((hWe _ (hWsat η hη Y)).eq_of_nhds).symm)
  constructor
  · intro ξ hξ
    obtain ⟨G, h1, -, W, hWo, hξW, hWsat, hWe⟩ := loc ξ hξ
    have hev := hevTN G W ξ hWo hξW hWsat hWe
    exact (h1.contDiffAt.congr_of_eventuallyEq hev).contDiffWithinAt
  · intro k ξ w hξ
    obtain ⟨G, -, h2, W, hWo, hξW, hWsat, hWe⟩ := loc ξ hξ
    have hev := hevTN G W ξ hWo hξW hWsat hWe
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, h2]
    exact fib _ _ ξ (fun Y => by
      rw [((hWe _ (hWsat ξ hξW Y)).iteratedFDeriv ℝ k).eq_of_nhds])

theorem tn_yavg_tn_zero_v5 : ∀ (g : Cyl → ℝ) (ξ : Cyl), yAvg (TN g) ξ = 0 :=
by
  have one_d : ∀ j : ℤ, j ≠ 0 →
      ∫ y in Set.Icc (0:ℝ) 1, Complex.exp ((2 * Real.pi * Complex.I * (j:ℂ)) * (y:ℂ)) = 0 := by
    intro j hj
    have hc : (2 * Real.pi * Complex.I * (j:ℂ)) ≠ 0 := by
      refine mul_ne_zero (mul_ne_zero (mul_ne_zero two_ne_zero ?_) Complex.I_ne_zero) ?_
      · exact Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
      · exact_mod_cast hj
    rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le zero_le_one,
      integral_exp_mul_complex hc]
    have h1 : Complex.exp (2 * Real.pi * Complex.I * (j:ℂ) * ((1:ℝ):ℂ)) = 1 := by
      have : 2 * Real.pi * Complex.I * (j:ℂ) * ((1:ℝ):ℂ) = (j:ℂ) * (2 * Real.pi * Complex.I) := by
        push_cast; ring
      rw [this, Complex.exp_int_mul_two_pi_mul_I]
    rw [h1]
    simp
  have cell : ∀ k : ℤ × ℤ, k ≠ 0 →
      ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1),
        Complex.exp ((2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) = 0 := by
    intro k hk
    have hfac : ∀ Y : ℝ × ℝ,
        Complex.exp ((2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) =
        Complex.exp ((2 * Real.pi * Complex.I * (k.1:ℂ)) * (Y.1:ℂ)) *
          Complex.exp ((2 * Real.pi * Complex.I * (k.2:ℂ)) * (Y.2:ℂ)) := by
      intro Y
      rw [← Complex.exp_add]
      congr 1
      ring
    simp_rw [hfac]
    rw [MeasureTheory.Measure.volume_eq_prod, ← MeasureTheory.Measure.prod_restrict,
      MeasureTheory.integral_prod_mul
        (f := fun y : ℝ => Complex.exp ((2 * Real.pi * Complex.I * (k.1:ℂ)) * (y:ℂ)))
        (g := fun y : ℝ => Complex.exp ((2 * Real.pi * Complex.I * (k.2:ℂ)) * (y:ℂ)))]
    by_cases h1 : k.1 = 0
    · have h2 : k.2 ≠ 0 := fun h2 => hk (Prod.ext h1 h2)
      rw [one_d k.2 h2, mul_zero]
    · rw [one_d k.1 h1, zero_mul]
  have series : ∀ (a : ℤ × ℤ → ℂ), a 0 = 0 →
      (∀ k : ℤ × ℤ, k ≠ 0 → ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1),
        Complex.exp ((2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) = 0) →
      ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1),
        (∑' k : ℤ × ℤ, a k *
          Complex.exp ((2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ)))).re = 0 := by
    intro a ha hc
    obtain ⟨e, he⟩ : ∃ e : ℤ × ℤ → ℝ × ℝ → ℂ, ∀ k Y, e k Y =
        Complex.exp ((2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) :=
      ⟨fun k Y => Complex.exp ((2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))),
        fun _ _ => rfl⟩
    simp_rw [← he] at hc ⊢
    have hnorm : ∀ k Y, ‖e k Y‖ = 1 := by
      intro k Y
      have : (2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ)) =
          ((2 * Real.pi * ((k.1:ℝ) * Y.1 + (k.2:ℝ) * Y.2) : ℝ) : ℂ) * Complex.I := by
        push_cast; ring
      rw [he, this, Complex.norm_exp_ofReal_mul_I]
    have hcont : ∀ k, Continuous (e k) := by
      intro k
      have : e k = fun Y : ℝ × ℝ =>
          Complex.exp ((2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) :=
        funext (he k)
      rw [this]
      fun_prop
    have hK : IsCompact (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
    have hFn : ∀ k Y, ‖a k * e k Y‖ = ‖a k‖ := by
      intro k Y
      rw [norm_mul, hnorm, mul_one]
    by_cases hA : Summable (fun k => ‖a k‖)
    · have hint : ∀ k, MeasureTheory.Integrable (fun Y => a k * e k Y)
          (MeasureTheory.volume.restrict (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) :=
        fun k => ((continuous_const.mul (hcont k)).continuousOn).integrableOn_compact hK
      have hsum : Summable (fun k => ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), ‖a k * e k Y‖) := by
        simp_rw [hFn, MeasureTheory.setIntegral_const, smul_eq_mul]
        exact hA.mul_left _
      have h1 := MeasureTheory.integral_tsum_of_summable_integral_norm hint hsum
      have hzero : ∀ k, ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), a k * e k Y = 0 := by
        intro k
        rw [MeasureTheory.integral_const_mul]
        by_cases hk : k = 0
        · rw [hk, ha, zero_mul]
        · rw [hc k hk, mul_zero]
      simp_rw [hzero, tsum_zero] at h1
      have hS : Continuous (fun Y => ∑' k, a k * e k Y) :=
        continuous_tsum (fun k => continuous_const.mul (hcont k)) hA (fun k Y => (hFn k Y).le)
      have hSi : MeasureTheory.Integrable (fun Y => ∑' k, a k * e k Y)
          (MeasureTheory.volume.restrict (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) :=
        hS.continuousOn.integrableOn_compact hK
      have h2 := integral_re hSi
      simp only [RCLike.re_to_complex] at h2
      rw [h2, ← h1, Complex.zero_re]
    · have hz : ∀ Y : ℝ × ℝ, (∑' k, a k * e k Y) = 0 := by
        intro Y
        apply tsum_eq_zero_of_not_summable
        intro hs
        apply hA
        have := hs.norm
        simpa only [hFn] using this
      simp_rw [hz, Complex.zero_re, MeasureTheory.integral_zero]
  intro g ξ
  have h := series (fun k => if k = 0 then (0:ℂ) else
      fourY g ξ k / (2 * Real.pi * Complex.I * ((bgc * (k.1 : ℝ) + (k.2 : ℝ) : ℝ) : ℂ)))
    (by simp) cell
  refine Eq.trans ?_ h
  unfold yAvg TN
  congr 1
  funext Y
  congr 1
  apply tsum_congr
  intro k
  split_ifs with hk
  · simp
  · rfl

theorem tn_cell_coef_decay_v5 : ∀ (φ : ℝ × ℝ → ℝ), ContDiff ℝ ∞ φ →
    (∀ (n m : ℤ) (Y : ℝ × ℝ), φ (Y + ((n:ℝ), (m:ℝ))) = φ Y) →
    ∃ M : ℝ, ∀ k : ℤ × ℤ,
      ‖∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (φ Y : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ)))‖ ≤
        M / ((1 + (k.1 : ℝ) ^ 2) * (1 + (k.2 : ℝ) ^ 2)) :=
by
  intro φ hφ hper
  obtain ⟨c, hc⟩ : ∃ c : (ℝ × ℝ → ℝ) → ℤ × ℤ → ℂ, ∀ (ψ : ℝ × ℝ → ℝ) (k : ℤ × ℤ),
      c ψ k = ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (ψ Y : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) :=
    ⟨fun ψ k => ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (ψ Y : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))),
      fun _ _ => rfl⟩

  have hcl : ∀ (ψ : ℝ × ℝ → ℝ), ContDiff ℝ ∞ ψ →
      (∀ (n m : ℤ) (Y : ℝ × ℝ), ψ (Y + ((n:ℝ), (m:ℝ))) = ψ Y) →
      ∀ v : ℝ × ℝ, ContDiff ℝ ∞ (fun Y => fderiv ℝ ψ Y v) ∧
        (∀ (n m : ℤ) (Y : ℝ × ℝ), fderiv ℝ ψ (Y + ((n:ℝ), (m:ℝ))) v = fderiv ℝ ψ Y v) := by
    intro ψ hψ hp v
    refine ⟨?_, ?_⟩
    · have h1 : ContDiff ℝ ∞ (fderiv ℝ ψ) := (contDiff_infty_iff_fderiv.mp hψ).2
      exact h1.clm_apply contDiff_const
    · intro n m Y
      have hf : (fun x => ψ (x + ((n:ℝ), (m:ℝ)))) = ψ := funext fun x => hp n m x
      have h2 : fderiv ℝ (fun x => ψ (x + ((n:ℝ), (m:ℝ)))) Y = fderiv ℝ ψ (Y + ((n:ℝ), (m:ℝ))) := by
        rw [fderiv_comp_add_right]
      rw [hf] at h2
      rw [← h2]

  have hsup : ∀ (ψ : ℝ × ℝ → ℝ), Continuous ψ → ∃ C : ℝ, ∀ k : ℤ × ℤ, ‖c ψ k‖ ≤ C := by
    intro ψ hψ
    have hK : IsCompact (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
    obtain ⟨C0, hC0⟩ := hK.exists_bound_of_continuousOn hψ.continuousOn
    refine ⟨C0 * MeasureTheory.volume.real (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), fun k => ?_⟩
    rw [hc]
    apply MeasureTheory.norm_setIntegral_le_of_norm_le_const hK.measure_lt_top
    intro Y hY
    rw [norm_mul, Complex.norm_real]
    have he : ‖Complex.exp (-(2 * Real.pi * Complex.I) *
        ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ)))‖ = 1 := by
      have : -(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ)) =
          ((-(2 * Real.pi * ((k.1:ℝ) * Y.1 + (k.2:ℝ) * Y.2)) : ℝ) : ℂ) * Complex.I := by
        push_cast; ring
      rw [this, Complex.norm_exp_ofReal_mul_I]
    rw [he, mul_one]
    exact hC0 Y hY

  have hD : ∀ (ψ : ℝ × ℝ → ℝ), ContDiff ℝ ∞ ψ →
      (∀ (n m : ℤ) (Y : ℝ × ℝ), ψ (Y + ((n:ℝ), (m:ℝ))) = ψ Y) →
      ∀ (w : ℝ × ℝ) (k : ℤ × ℤ), c (fun Y => fderiv ℝ ψ Y w) k =
        (2 * Real.pi * Complex.I * ((k.1 : ℂ) * (w.1 : ℂ) + (k.2 : ℂ) * (w.2 : ℂ))) * c ψ k := by
    intro ψ hψ hp w k
    rw [hc, hc]
    exact tn_cell_coef_deriv_v5 ψ (hψ.of_le (by exact_mod_cast le_top)) hp w k
  have hN : ∀ (w : ℝ × ℝ) (k : ℤ × ℤ),
      ‖(2 * Real.pi * Complex.I * ((k.1 : ℂ) * (w.1 : ℂ) + (k.2 : ℂ) * (w.2 : ℂ)))‖ =
        2 * Real.pi * |(k.1:ℝ) * w.1 + (k.2:ℝ) * w.2| := by
    intro w k
    have : (2 * Real.pi * Complex.I * ((k.1 : ℂ) * (w.1 : ℂ) + (k.2 : ℂ) * (w.2 : ℂ))) =
        ((2 * Real.pi * ((k.1:ℝ) * w.1 + (k.2:ℝ) * w.2) : ℝ) : ℂ) * Complex.I := by
      push_cast; ring
    rw [this, norm_mul, Complex.norm_real, Complex.norm_I, mul_one, Real.norm_eq_abs, abs_mul,
      abs_of_pos (by positivity : (0:ℝ) < 2 * Real.pi)]

  have h1 := hcl φ hφ hper ((1:ℝ), (0:ℝ))
  have h11 := hcl _ h1.1 h1.2 ((1:ℝ), (0:ℝ))
  have h112 := hcl _ h11.1 h11.2 ((0:ℝ), (1:ℝ))
  have h1122 := hcl _ h112.1 h112.2 ((0:ℝ), (1:ℝ))
  have h2 := hcl φ hφ hper ((0:ℝ), (1:ℝ))
  have h22 := hcl _ h2.1 h2.2 ((0:ℝ), (1:ℝ))
  obtain ⟨C0, hC0⟩ := hsup φ hφ.continuous
  obtain ⟨C11, hC11⟩ := hsup _ h11.1.continuous
  obtain ⟨C22, hC22⟩ := hsup _ h22.1.continuous
  obtain ⟨C4, hC4⟩ := hsup _ h1122.1.continuous
  refine ⟨C0 + C11 + C22 + C4, fun k => ?_⟩
  rw [← hc φ k]
  have hNa : ‖(2 * Real.pi * Complex.I * ((k.1 : ℂ) * ((((1:ℝ), (0:ℝ)) : ℝ × ℝ).1 : ℂ) +
      (k.2 : ℂ) * ((((1:ℝ), (0:ℝ)) : ℝ × ℝ).2 : ℂ)))‖ = 2 * Real.pi * |(k.1:ℝ)| := by
    rw [hN]; simp
  have hNb : ‖(2 * Real.pi * Complex.I * ((k.1 : ℂ) * ((((0:ℝ), (1:ℝ)) : ℝ × ℝ).1 : ℂ) +
      (k.2 : ℂ) * ((((0:ℝ), (1:ℝ)) : ℝ × ℝ).2 : ℂ)))‖ = 2 * Real.pi * |(k.2:ℝ)| := by
    rw [hN]; simp

  have n1 := congrArg norm (hD φ hφ hper ((1:ℝ), (0:ℝ)) k)
  rw [norm_mul, hNa] at n1
  have n11 := congrArg norm (hD _ h1.1 h1.2 ((1:ℝ), (0:ℝ)) k)
  rw [norm_mul, hNa] at n11
  have n112 := congrArg norm (hD _ h11.1 h11.2 ((0:ℝ), (1:ℝ)) k)
  rw [norm_mul, hNb] at n112
  have n1122 := congrArg norm (hD _ h112.1 h112.2 ((0:ℝ), (1:ℝ)) k)
  rw [norm_mul, hNb] at n1122
  have n2 := congrArg norm (hD φ hφ hper ((0:ℝ), (1:ℝ)) k)
  rw [norm_mul, hNb] at n2
  have n22 := congrArg norm (hD _ h2.1 h2.2 ((0:ℝ), (1:ℝ)) k)
  rw [norm_mul, hNb] at n22
  have b11 := hC11 k
  have b22 := hC22 k
  have b4 := hC4 k
  have b0 := hC0 k
  rw [n11, n1] at b11
  rw [n22, n2] at b22
  rw [n1122, n112, n11, n1] at b4

  have hp : (1:ℝ) ≤ 2 * Real.pi := by linarith [Real.pi_gt_three]
  have hp2 : (1:ℝ) ≤ (2 * Real.pi) ^ 2 := one_le_pow₀ hp
  have hp4 : (1:ℝ) ≤ (2 * Real.pi) ^ 4 := one_le_pow₀ hp
  have hA : 0 ≤ ‖c φ k‖ := norm_nonneg _
  have q11 : |(k.1:ℝ)| ^ 2 * ‖c φ k‖ ≤ C11 := by
    have e : 2 * Real.pi * |(k.1:ℝ)| * (2 * Real.pi * |(k.1:ℝ)| * ‖c φ k‖) =
        (2 * Real.pi) ^ 2 * (|(k.1:ℝ)| ^ 2 * ‖c φ k‖) := by ring
    rw [e] at b11
    exact le_trans (le_mul_of_one_le_left (by positivity) hp2) b11
  have q22 : |(k.2:ℝ)| ^ 2 * ‖c φ k‖ ≤ C22 := by
    have e : 2 * Real.pi * |(k.2:ℝ)| * (2 * Real.pi * |(k.2:ℝ)| * ‖c φ k‖) =
        (2 * Real.pi) ^ 2 * (|(k.2:ℝ)| ^ 2 * ‖c φ k‖) := by ring
    rw [e] at b22
    exact le_trans (le_mul_of_one_le_left (by positivity) hp2) b22
  have q4 : |(k.1:ℝ)| ^ 2 * |(k.2:ℝ)| ^ 2 * ‖c φ k‖ ≤ C4 := by
    have e : 2 * Real.pi * |(k.2:ℝ)| * (2 * Real.pi * |(k.2:ℝ)| *
        (2 * Real.pi * |(k.1:ℝ)| * (2 * Real.pi * |(k.1:ℝ)| * ‖c φ k‖))) =
        (2 * Real.pi) ^ 4 * (|(k.1:ℝ)| ^ 2 * |(k.2:ℝ)| ^ 2 * ‖c φ k‖) := by ring
    rw [e] at b4
    exact le_trans (le_mul_of_one_le_left (by positivity) hp4) b4
  rw [sq_abs, sq_abs] at q4
  rw [sq_abs] at q11 q22
  rw [le_div_iff₀ (by positivity)]
  nlinarith

theorem tn_transport_identity_v5 : ∀ (U : Set Cyl) (g : Cyl → ℝ), IsOpen U → (∀ ξ ∈ U, ∀ a : ℝ × ℝ, shY ξ a ∈ U) →
    ContDiffOn ℝ ∞ g U → (∀ ξ ∈ U, ∀ n m : ℤ, g (shY ξ ((n : ℝ), (m : ℝ))) = g ξ) →
    (∀ ξ ∈ U, dYt (TN g) ξ = g ξ - yAvg g ξ) ∧ (∀ ξ ∈ U, yAvg (TN g) ξ = 0) :=
by
  intro U g hU hsat hg hper
  refine ⟨fun ξ hξ => ?_, fun ξ _ => tn_yavg_tn_zero_v5 g ξ⟩

  have hιU : ∀ Y : ℝ × ℝ, ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) ∈ U := by
    intro Y
    have e : ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) = shY ξ (Y - ξ.2.2.2) :=
      Prod.ext rfl (Prod.ext rfl (Prod.ext rfl (by show Y = ξ.2.2.2 + (Y - ξ.2.2.2); abel)))
    rw [e]
    exact hsat ξ hξ _

  have hιc : ContDiff ℝ ∞ (fun Y : ℝ × ℝ => ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl)) :=
    contDiff_const.prodMk (contDiff_const.prodMk (contDiff_const.prodMk contDiff_id))
  have hφs : ContDiff ℝ ∞ (fun Y : ℝ × ℝ => g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) :=
    contDiffOn_univ.mp (hg.comp hιc.contDiffOn (fun Y _ => hιU Y))

  have hφper : ∀ (n m : ℤ) (Y : ℝ × ℝ),
      g (ξ.1, ξ.2.1, ξ.2.2.1, Y + ((n:ℝ), (m:ℝ))) = g (ξ.1, ξ.2.1, ξ.2.2.1, Y) :=
    fun n m Y => hper _ (hιU Y) n m

  have hLι : ∀ Y : ℝ × ℝ, HasFDerivAt (fun Y : ℝ × ℝ => ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl))
      ((0 : ℝ × ℝ →L[ℝ] ℝ).prod ((0 : ℝ × ℝ →L[ℝ] ℝ).prod ((0 : ℝ × ℝ →L[ℝ] ℝ).prod
        (ContinuousLinearMap.id ℝ (ℝ × ℝ))))) Y := by
    intro Y
    exact (hasFDerivAt_const _ _).prodMk ((hasFDerivAt_const _ _).prodMk
      ((hasFDerivAt_const _ _).prodMk (hasFDerivAt_id _)))
  have hgd : ∀ Y : ℝ × ℝ, DifferentiableAt ℝ g ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) := fun Y =>
    (hg.contDiffAt (hU.mem_nhds (hιU Y))).differentiableAt (by simp)
  have hchain : ∀ (Y u : ℝ × ℝ), fderiv ℝ (fun Y : ℝ × ℝ => g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) Y u =
      fderiv ℝ g (ξ.1, ξ.2.1, ξ.2.2.1, Y) (0, 0, 0, u) := by
    intro Y u
    have h := ((hgd Y).hasFDerivAt.comp Y (hLι Y)).fderiv
    have e : (fun Y : ℝ × ℝ => g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) =
        g ∘ (fun Y : ℝ × ℝ => ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl)) := rfl
    rw [e, h]
    first
    | rfl
    | simp

  have hP := tn_smooth_commute_v5 U g hU hsat hg hper
  have h1 : dYt (TN g) ξ = TN (fun η => fderiv ℝ g η (0, 0, 0, vtv)) ξ := by
    have h := hP.2 1 ξ (fun _ => ((0:ℝ), (0:ℝ), (0:ℝ), vtv)) hξ
    simp only [iteratedFDeriv_one_apply] at h
    unfold dYt
    exact h

  have hcoef : ∀ k : ℤ × ℤ, fourY (fun η => fderiv ℝ g η (0, 0, 0, vtv)) ξ k =
      (2 * Real.pi * Complex.I * ((bgc * (k.1 : ℝ) + (k.2 : ℝ) : ℝ) : ℂ)) * fourY g ξ k := by
    intro k
    have h := tn_cell_coef_deriv_v5 (fun Y => g (ξ.1, ξ.2.1, ξ.2.2.1, Y))
      (hφs.of_le (by exact_mod_cast le_top)) hφper vtv k
    have e1 : fourY (fun η => fderiv ℝ g η (0, 0, 0, vtv)) ξ k =
        ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1),
          ((fderiv ℝ (fun Y : ℝ × ℝ => g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) Y vtv : ℝ) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) := by
      unfold fourY
      congr 1
      funext Y
      rw [hchain Y vtv]
    have e2 : (∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (g (ξ.1, ξ.2.1, ξ.2.2.1, Y) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ)))) =
        fourY g ξ k := rfl
    rw [e1, h, e2]
    congr 1
    simp only [vtv]
    push_cast
    ring

  have hd : ∀ k : ℤ × ℤ, k ≠ 0 → (bgc * (k.1 : ℝ) + (k.2 : ℝ)) ≠ 0 := by
    intro k hk h0
    apply hk
    simp only [bgc] at h0
    have hk1 : k.1 = 0 := by
      by_contra hne
      have hirr : Irrational (Real.sqrt 2 * (k.1 : ℝ)) := irrational_sqrt_two.mul_intCast hne
      apply hirr
      refine ⟨((k.1 - k.2 : ℤ) : ℚ), ?_⟩
      push_cast
      linear_combination -h0
    have hk2 : k.2 = 0 := by
      rw [hk1] at h0
      have : (k.2 : ℝ) = 0 := by simpa using h0
      exact_mod_cast this
    exact Prod.ext hk1 hk2
  have hsum : TN (fun η => fderiv ℝ g η (0, 0, 0, vtv)) ξ =
      (∑' k : ℤ × ℤ, if k = 0 then (0:ℂ) else fourY g ξ k *
        Complex.exp ((2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (ξ.2.2.2.1 : ℂ) + (k.2 : ℂ) * (ξ.2.2.2.2 : ℂ)))).re := by
    unfold TN
    congr 1
    apply tsum_congr
    intro k
    split_ifs with hk
    · rfl
    · rw [hcoef k, mul_div_cancel_left₀]
      exact mul_ne_zero (mul_ne_zero (mul_ne_zero two_ne_zero
        (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)) Complex.I_ne_zero)
        (Complex.ofReal_ne_zero.mpr (hd k hk))

  obtain ⟨M, hM⟩ := tn_cell_coef_decay_v5 (fun Y => g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) hφs hφper
  have hinv' : HasSum (fun k : ℤ × ℤ => fourY g ξ k *
      Complex.exp ((2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (ξ.2.2.2.1 : ℂ) + (k.2 : ℂ) * (ξ.2.2.2.2 : ℂ))))
      ((g ξ : ℝ) : ℂ) :=
    tn_inv2d_v5 (fun Y => g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) M hφs.continuous hφper hM ξ.2.2.2
  have hf0 : fourY g ξ 0 * Complex.exp ((2 * Real.pi * Complex.I) *
      ((((0 : ℤ × ℤ).1 : ℤ) : ℂ) * (ξ.2.2.2.1 : ℂ) + (((0 : ℤ × ℤ).2 : ℤ) : ℂ) * (ξ.2.2.2.2 : ℂ))) =
      ((yAvg g ξ : ℝ) : ℂ) := by
    simp only [fourY, yAvg, Prod.fst_zero, Prod.snd_zero, Int.cast_zero, zero_mul, add_zero, mul_zero,
      Complex.exp_zero, mul_one, neg_zero]
    exact integral_ofReal
  have h3 := (hasSum_ite_sub_hasSum hinv' 0).tsum_eq
  rw [h1, hsum]
  try simp only [] at h3
  rw [h3, hf0, ← Complex.ofReal_sub, Complex.ofReal_re]

theorem tn_fibre_props_v5 : ∀ (g c : Cyl → ℝ) (ξ : Cyl),
    ((∀ Y : ℝ × ℝ, g (ξ.1, ξ.2.1, ξ.2.2.1, Y) = 0) → TN g ξ = 0) ∧
    ((∀ Y : ℝ × ℝ, c (ξ.1, ξ.2.1, ξ.2.2.1, Y) = c ξ) → TN (fun η => c η * g η) ξ = c ξ * TN g ξ) ∧
    (∀ a : ℝ × ℝ, ContDiff ℝ ∞ (fun Y : ℝ × ℝ => g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) →
      (∀ (n m : ℤ) (Y : ℝ × ℝ), g (ξ.1, ξ.2.1, ξ.2.2.1, Y + ((n:ℝ), (m:ℝ))) = g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) →
      (∀ Y : ℝ × ℝ, g (ξ.1, ξ.2.1, ξ.2.2.1, Y + a) = g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) →
      TN g (shY ξ a) = TN g ξ) :=
by
  intro g c ξ
  refine ⟨fun hz => ?_, fun hc => ?_, fun a hsm hper hinv => ?_⟩
  ·
    have h0 : ∀ κ : ℤ × ℤ, fourY g ξ κ = 0 := by
      intro κ
      unfold fourY
      simp [hz]
    unfold TN
    simp [h0]
  ·
    have h1 : ∀ κ : ℤ × ℤ, fourY (fun η => c η * g η) ξ κ = (c ξ : ℂ) * fourY g ξ κ := by
      intro κ
      unfold fourY
      rw [← integral_const_mul]
      congr 1
      funext Y
      simp only [hc Y, Complex.ofReal_mul, mul_assoc]
    unfold TN
    rw [← Complex.re_ofReal_mul, ← tsum_mul_left]
    congr 1
    refine tsum_congr fun κ => ?_
    split_ifs with hκ
    · simp
    · rw [h1 κ]
      ring
  ·
    have hG : Continuous (fun Y : ℝ × ℝ => g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) := hsm.continuous

    have per1 : ∀ (ψ : ℝ → ℂ), Function.Periodic ψ 1 → ∀ b : ℝ,
        ∫ y in Icc (0:ℝ) 1, ψ (y + b) = ∫ y in Icc (0:ℝ) 1, ψ y := by
      intro ψ hψ b
      rw [integral_Icc_eq_integral_Ioc, integral_Icc_eq_integral_Ioc,
        ← intervalIntegral.integral_of_le zero_le_one, ← intervalIntegral.integral_of_le zero_le_one,
        intervalIntegral.integral_comp_add_right, zero_add, add_comm 1 b,
        hψ.intervalIntegral_add_eq b 0, zero_add]

    have cell : ∀ (Φ : ℝ × ℝ → ℂ), Continuous Φ →
        (∀ (n m : ℤ) (Y : ℝ × ℝ), Φ (Y + ((n : ℝ), (m : ℝ))) = Φ Y) →
        ∀ b : ℝ × ℝ, ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Φ (Z + b) =
          ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), Φ Z := by
      intro Φ hΦ hp b
      have fub : ∀ Ψ : ℝ × ℝ → ℂ, Continuous Ψ →
          ∫ Z in (Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1), Ψ Z =
            ∫ x in Icc (0:ℝ) 1, ∫ y in Icc (0:ℝ) 1, Ψ (x, y) := by
        intro Ψ hΨ
        rw [Measure.volume_eq_prod]
        exact setIntegral_prod Ψ
          ((hΨ.continuousOn).integrableOn_compact (isCompact_Icc.prod isCompact_Icc))
      rw [fub (fun Z => Φ (Z + b)) (hΦ.comp (continuous_id.add continuous_const)), fub _ hΦ]
      have h1 : ∀ x : ℝ, ∫ y in Icc (0:ℝ) 1, Φ ((x, y) + b) =
          ∫ y in Icc (0:ℝ) 1, Φ (x + b.1, y) := by
        intro x
        have hper1 : Function.Periodic (fun y => Φ (x + b.1, y)) 1 := by
          intro y
          have := hp 0 1 (x + b.1, y)
          simpa using this
        exact per1 _ hper1 b.2
      have hχ : Function.Periodic (fun u => ∫ y in Icc (0:ℝ) 1, Φ (u, y)) 1 := by
        intro u
        show ∫ y in Icc (0:ℝ) 1, Φ (u + 1, y) = ∫ y in Icc (0:ℝ) 1, Φ (u, y)
        congr 1
        funext y
        have := hp 1 0 (u, y)
        simpa using this
      rw [show (fun x => ∫ y in Icc (0:ℝ) 1, Φ ((x, y) + b)) =
          fun x => (fun u => ∫ y in Icc (0:ℝ) 1, Φ (u, y)) (x + b.1) from funext h1]
      exact per1 _ hχ b.1

    have phase : ∀ κ : ℤ × ℤ, fourY g ξ κ *
        Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (a.1 : ℂ) + (κ.2 : ℂ) * (a.2 : ℂ))) =
        fourY g ξ κ := by
      intro κ
      obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ × ℝ → ℂ, Φ = fun Z => (g (ξ.1, ξ.2.1, ξ.2.2.1, Z) : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (Z.1 : ℂ) + (κ.2 : ℂ) * (Z.2 : ℂ))) :=
        ⟨_, rfl⟩
      have hfour : fourY g ξ κ = ∫ Z in (Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1), Φ Z := by
        rw [hΦ]; rfl
      have hΦc : Continuous Φ := by
        rw [hΦ]
        refine (Complex.continuous_ofReal.comp hG).mul (Complex.continuous_exp.comp ?_)
        fun_prop
      have hΦp : ∀ (n m : ℤ) (Y : ℝ × ℝ), Φ (Y + ((n : ℝ), (m : ℝ))) = Φ Y := by
        intro n m Y
        rw [hΦ]
        dsimp only
        rw [hper n m Y]
        congr 1
        rw [Complex.exp_eq_exp_iff_exists_int]
        refine ⟨-(κ.1 * n + κ.2 * m), ?_⟩
        simp only [Prod.fst_add, Prod.snd_add]
        push_cast
        ring
      have hsh : ∀ Z : ℝ × ℝ, Φ (Z + a) = Φ Z *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (a.1 : ℂ) + (κ.2 : ℂ) * (a.2 : ℂ))) := by
        intro Z
        rw [hΦ]
        dsimp only
        rw [hinv Z, mul_assoc _ (Complex.exp _) (Complex.exp _), ← Complex.exp_add]
        congr 2
        simp only [Prod.fst_add, Prod.snd_add]
        push_cast
        ring
      have htr := cell Φ hΦc hΦp a
      rw [show (fun Z => Φ (Z + a)) = fun Z => Φ Z *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (a.1 : ℂ) + (κ.2 : ℂ) * (a.2 : ℂ)))
          from funext hsh, integral_mul_const, ← hfour] at htr
      calc fourY g ξ κ *
            Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (a.1 : ℂ) + (κ.2 : ℂ) * (a.2 : ℂ)))
          = (fourY g ξ κ *
              Complex.exp (-(2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (a.1 : ℂ) + (κ.2 : ℂ) * (a.2 : ℂ)))) *
            Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (a.1 : ℂ) + (κ.2 : ℂ) * (a.2 : ℂ))) := by
              rw [htr]
        _ = fourY g ξ κ := by
              rw [mul_assoc, ← Complex.exp_add, neg_mul, neg_add_cancel, Complex.exp_zero, mul_one]
    unfold TN
    congr 1
    refine tsum_congr fun κ => ?_
    split_ifs with hκ
    · rfl
    · have hf : fourY g (shY ξ a) κ = fourY g ξ κ := rfl
      have he : Complex.exp ((2 * Real.pi * Complex.I) *
            ((κ.1 : ℂ) * ((shY ξ a).2.2.2.1 : ℂ) + (κ.2 : ℂ) * ((shY ξ a).2.2.2.2 : ℂ))) =
          Complex.exp ((2 * Real.pi * Complex.I) *
            ((κ.1 : ℂ) * (ξ.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (ξ.2.2.2.2 : ℂ))) *
          Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (a.1 : ℂ) + (κ.2 : ℂ) * (a.2 : ℂ))) := by
        rw [← Complex.exp_add]
        congr 1
        simp only [shY, Prod.fst_add, Prod.snd_add]
        push_cast
        ring
      rw [hf, he]
      linear_combination
        (Complex.exp ((2 * Real.pi * Complex.I) *
            ((κ.1 : ℂ) * (ξ.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (ξ.2.2.2.2 : ℂ))) /
          (2 * Real.pi * Complex.I * ((bgc * (κ.1 : ℝ) + (κ.2 : ℝ) : ℝ) : ℂ))) * phase κ

theorem tn_fast_coef_bound_v5 : ∀ (h : ℝ) (U : Set Cyl) (g : Cyl → ℝ) (ξ : Cyl) (k : ℕ) (M : ℝ),
    IsOpen U → (∀ η ∈ U, ∀ a : ℝ × ℝ, shY η a ∈ U) → ContDiffOn ℝ ∞ g U →
    (∀ η ∈ U, ∀ p r : ℤ, g (shY η ((p : ℝ), (r : ℝ))) = g η) → ξ ∈ U →
    (∀ Y : ℝ × ℝ, NB h g k (ξ.1, ξ.2.1, ξ.2.2.1, Y) ≤ M ∧ NB h g (k + 5) (ξ.1, ξ.2.1, ξ.2.2.1, Y) ≤ M) →
    ∀ (w : Fin k → Cyl) (κ κ' : ℤ × ℤ),
      Jpow (coarseIdx h (qC h ξ)) ((κ'.1 : ℝ), (κ'.2 : ℝ)) = ((κ.1 : ℝ), (κ.2 : ℝ)) →
      ‖fourY (fun η => iteratedFDeriv ℝ k g η (fun i => Lnorm h ξ (w i))) ξ κ‖ *
        (1 + |(κ'.1 : ℝ)| + |(κ'.2 : ℝ)|) ^ 5 ≤ 729 * M * ∏ i, ‖w i‖ :=
by
  intro h U g ξ k M hU hsat hg hper hξ hM w κ κ' hκ
  set G := fourY (fun η => iteratedFDeriv ℝ k g η (fun i => Lnorm h ξ (w i))) ξ κ with hG

  have cellIBP : ∀ (φ : ℝ × ℝ → ℝ), ContDiff ℝ 1 φ →
      (∀ (n m : ℤ) (Y : ℝ × ℝ), φ (Y + ((n:ℝ), (m:ℝ))) = φ Y) →
      ∀ (w : ℝ × ℝ) (k : ℤ × ℤ),
        ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), ((fderiv ℝ φ Y w : ℝ) : ℂ) *
            Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) =
          (2 * Real.pi * Complex.I * ((k.1 : ℂ) * (w.1 : ℂ) + (k.2 : ℂ) * (w.2 : ℂ))) *
          ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (φ Y : ℂ) *
            Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) := by
    intro φ hφ hper w k
    set E : ℝ × ℝ → ℂ := fun Y =>
      Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) with hE
    have hd : Differentiable ℝ φ := hφ.differentiable (by norm_num)
    have hc' : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv (by norm_num)
    have hEc : Continuous E := by
      rw [hE]
      exact Complex.continuous_exp.comp (by fun_prop)
    have hPc : ∀ v : ℝ × ℝ, Continuous (fun Y => ((fderiv ℝ φ Y v : ℝ) : ℂ) * E Y) := fun v =>
      (Complex.continuous_ofReal.comp (hc'.clm_apply continuous_const)).mul hEc
    have hFc : Continuous (fun Y => (φ Y : ℂ) * E Y) :=
      (Complex.continuous_ofReal.comp hφ.continuous).mul hEc
    have hderφ : ∀ (γ : ℝ → ℝ × ℝ) (v : ℝ × ℝ) (t : ℝ), HasDerivAt γ v t →
        HasDerivAt (fun s => (φ (γ s) : ℂ)) ((fderiv ℝ φ (γ t) v : ℝ) : ℂ) t := by
      intro γ v t hγ
      exact ((hd (γ t)).hasFDerivAt.comp_hasDerivAt t hγ).ofReal_comp
    have ibp : ∀ (γ : ℝ → ℝ × ℝ) (v : ℝ × ℝ) (κ : ℂ), (∀ t, HasDerivAt γ v t) →
        (∀ t, HasDerivAt (fun s => E (γ s)) (E (γ t) * (-(2 * Real.pi * Complex.I) * κ)) t) →
        φ (γ 1) = φ (γ 0) → E (γ 1) = E (γ 0) →
        ∫ t in (0:ℝ)..1, ((fderiv ℝ φ (γ t) v : ℝ) : ℂ) * E (γ t) =
          (2 * Real.pi * Complex.I * κ) * ∫ t in (0:ℝ)..1, (φ (γ t) : ℂ) * E (γ t) := by
      intro γ v κ hγ hEγ hφ1 hE1
      have hγc : Continuous γ := continuous_iff_continuousAt.mpr fun t => (hγ t).continuousAt
      have hA : Continuous (fun t => ((fderiv ℝ φ (γ t) v : ℝ) : ℂ) * E (γ t)) := (hPc v).comp hγc
      have hF : Continuous (fun t => (φ (γ t) : ℂ) * E (γ t)) := hFc.comp hγc
      have hCF : Continuous (fun t => (2 * Real.pi * Complex.I * κ) * ((φ (γ t) : ℂ) * E (γ t))) :=
        continuous_const.mul hF
      have hder : ∀ t, HasDerivAt (fun s => (φ (γ s) : ℂ) * E (γ s))
          (((fderiv ℝ φ (γ t) v : ℝ) : ℂ) * E (γ t) -
            (2 * Real.pi * Complex.I * κ) * ((φ (γ t) : ℂ) * E (γ t))) t := by
        intro t
        exact ((hderφ γ v t (hγ t)).mul (hEγ t)).congr_deriv (by ring)
      have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hder t)
        ((hA.sub hCF).intervalIntegrable 0 1)
      rw [intervalIntegral.integral_sub (hA.intervalIntegrable 0 1) (hCF.intervalIntegrable 0 1),
        intervalIntegral.integral_const_mul, hφ1, hE1, sub_self] at hftc
      exact sub_eq_zero.mp hftc
    have hEx : ∀ y t : ℝ, HasDerivAt (fun s : ℝ => E (s, y))
        (E (t, y) * (-(2 * Real.pi * Complex.I) * (k.1 : ℂ))) t := by
      intro y t
      have h1 : HasDerivAt (fun s : ℝ => -(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (s : ℂ) + (k.2 : ℂ) * (y : ℂ)))
          (-(2 * Real.pi * Complex.I) * (k.1 : ℂ)) t := by
        have := ((((hasDerivAt_id t).ofReal_comp).const_mul (k.1 : ℂ)).add_const
          ((k.2 : ℂ) * (y : ℂ))).const_mul (-(2 * Real.pi * Complex.I))
        exact this.congr_deriv (by simp)
      rw [hE]
      exact h1.cexp
    have hEy : ∀ x t : ℝ, HasDerivAt (fun s : ℝ => E (x, s))
        (E (x, t) * (-(2 * Real.pi * Complex.I) * (k.2 : ℂ))) t := by
      intro x t
      have h1 : HasDerivAt (fun s : ℝ => -(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (x : ℂ) + (k.2 : ℂ) * (s : ℂ)))
          (-(2 * Real.pi * Complex.I) * (k.2 : ℂ)) t := by
        have := ((((hasDerivAt_id t).ofReal_comp).const_mul (k.2 : ℂ)).const_add
          ((k.1 : ℂ) * (x : ℂ))).const_mul (-(2 * Real.pi * Complex.I))
        exact this.congr_deriv (by simp)
      rw [hE]
      exact h1.cexp
    have hφx : ∀ y : ℝ, φ (1, y) = φ (0, y) := by
      intro y
      have := hper 1 0 (0, y)
      simpa using this
    have hφy : ∀ x : ℝ, φ (x, 1) = φ (x, 0) := by
      intro x
      have := hper 0 1 (x, 0)
      simpa using this
    have hEx1 : ∀ y : ℝ, E (1, y) = E (0, y) := by
      intro y
      rw [hE]
      dsimp only
      rw [Complex.exp_eq_exp_iff_exists_int]
      refine ⟨-k.1, ?_⟩
      push_cast
      ring
    have hEy1 : ∀ x : ℝ, E (x, 1) = E (x, 0) := by
      intro x
      rw [hE]
      dsimp only
      rw [Complex.exp_eq_exp_iff_exists_int]
      refine ⟨-k.2, ?_⟩
      push_cast
      ring
    have lineX : ∀ y : ℝ, ∫ x in Set.Icc (0:ℝ) 1, ((fderiv ℝ φ (x, y) ((1:ℝ), (0:ℝ)) : ℝ) : ℂ) * E (x, y) =
        (2 * Real.pi * Complex.I * (k.1 : ℂ)) * ∫ x in Set.Icc (0:ℝ) 1, (φ (x, y) : ℂ) * E (x, y) := by
      intro y
      rw [MeasureTheory.integral_Icc_eq_integral_Ioc, MeasureTheory.integral_Icc_eq_integral_Ioc,
        ← intervalIntegral.integral_of_le zero_le_one, ← intervalIntegral.integral_of_le zero_le_one]
      exact ibp (fun x => (x, y)) ((1:ℝ), (0:ℝ)) (k.1 : ℂ)
        (fun t => (hasDerivAt_id' t).prodMk (hasDerivAt_const t y)) (hEx y) (hφx y) (hEx1 y)
    have lineY : ∀ x : ℝ, ∫ y in Set.Icc (0:ℝ) 1, ((fderiv ℝ φ (x, y) ((0:ℝ), (1:ℝ)) : ℝ) : ℂ) * E (x, y) =
        (2 * Real.pi * Complex.I * (k.2 : ℂ)) * ∫ y in Set.Icc (0:ℝ) 1, (φ (x, y) : ℂ) * E (x, y) := by
      intro x
      rw [MeasureTheory.integral_Icc_eq_integral_Ioc, MeasureTheory.integral_Icc_eq_integral_Ioc,
