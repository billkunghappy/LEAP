      have h1 := sq_nonneg (W - 1 / 2)
      have e : (W - 1 / 2) ^ 2 = W ^ 2 - W + 1 / 4 := by ring
      linarith
    have hQ : -(2 * F0 * N.1) * (2 * F0 * N.1 + eN g) =
        (2 * F0 * (a * R⁻¹)) ^ 2 * ((a ^ 2 + b ^ 2) * a⁻¹ / 2 - 1) := by
      rw [hN1, hE, ← hRsq]
      field_simp
      ring
    have hu0 : 0 < a * R⁻¹ := mul_pos ha0 hRi
    have hlam' : lam = 2 * (F0 * (a * R⁻¹) * W) := by
      rw [hlam, hQ, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (by positivity), hW]
      ring
    have hc0 : lam / (2 * F0 * N.1) = -W := by
      have hc : 2 * (F0 * (a * R⁻¹)) ≠ 0 := by positivity
      rw [hlam', hN1, show 2 * (F0 * (a * R⁻¹) * W) = (2 * (F0 * (a * R⁻¹))) * W by ring,
        show 2 * F0 * -(a * R⁻¹) = -(2 * (F0 * (a * R⁻¹))) by ring, div_neg,
        mul_div_cancel_left₀ _ hc]
    have hF0b : |F0| ≤ 4 * D := by rw [abs_of_pos hF0pos]; exact hF0u
    exact ⟨R, a * R⁻¹, b * R⁻¹, (a ^ 2 + b ^ 2) * a⁻¹, W, hRpos, hRsq, haR, hbR, hRK, hRi,
      rfl, rfl, hu1, hv1, hNe, rfl, hai0, haK, hSabs, hWl, hWsq, hWu, hlam', hc0, hF0b⟩

  obtain ⟨CF, hCF⟩ : ∃ c : ℝ, c = 4 * 1 + D * 1 := ⟨_, rfl⟩
  obtain ⟨Cu, hCu⟩ : ∃ c : ℝ, c = D * (K * K * 1) + K * 1 := ⟨_, rfl⟩
  obtain ⟨CS, hCS⟩ : ∃ c : ℝ, c = (D * 1 + D * 1) + (D * 1 + D * 1) := ⟨_, rfl⟩
  obtain ⟨CX, hCX⟩ : ∃ c : ℝ, c = 2 * D ^ 2 * (K * K * 1) + K * CS := ⟨_, rfl⟩
  obtain ⟨CW, hCW⟩ : ∃ c : ℝ, c = K * CX / 2 := ⟨_, rfl⟩
  obtain ⟨CFu, hCFu⟩ : ∃ c : ℝ, c = 4 * D * Cu + 1 * CF := ⟨_, rfl⟩
  obtain ⟨CFuW, hCFuW⟩ : ∃ c : ℝ, c = 4 * D * 1 * CW + (1 + D ^ 2 * K) * CFu := ⟨_, rfl⟩
  have hCF0 : 0 ≤ CF := by rw [hCF]; positivity
  have hCu0 : 0 ≤ Cu := by rw [hCu]; positivity
  have hCS0 : 0 ≤ CS := by rw [hCS]; positivity
  have hCX0 : 0 ≤ CX := by rw [hCX]; positivity
  have hCW0 : 0 ≤ CW := by rw [hCW]; positivity
  have hCFu0 : 0 ≤ CFu := by rw [hCFu]; positivity
  have hCFuW0 : 0 ≤ CFuW := by rw [hCFuW]; positivity
  refine ⟨CF + Cu + Cu + 2 * CFuW + CW, by positivity, ?_⟩
  intro s p a b F0 lam s' p' a' b' F0' lam' g N g' N' hs1 hs2 hp1 hp2 ha1 ha2 hb hadm
    hs1' hs2' hp1' hp2' ha1' ha2' hb' hadm' hF0 hg hN hlam hF0' hg' hN' hlam'
  obtain ⟨R, u, v, X, W, hR, hRsq, haR, hbR, hRK, hRi, hu, hv, hu1, hv1, hNe, hX, hai, haK,
    hSabs, hWl, hWsq, hWu, hlame, hc0, hF0b⟩ :=
    tup s p a b F0 lam g N hs1 hs2 hp1 hp2 ha1 ha2 hb hadm hF0 hg hN hlam
  obtain ⟨R', u', v', X', W', hR', hRsq', haR', hbR', hRK', hRi', hu', hv', hu1', hv1', hNe',
    hX', hai', haK', hSabs', hWl', hWsq', hWu', hlame', hc0', hF0b'⟩ :=
    tup s' p' a' b' F0' lam' g' N' hs1' hs2' hp1' hp2' ha1' ha2' hb' hadm' hF0' hg' hN' hlam'
  obtain ⟨d, hd⟩ : ∃ d : ℝ, d = |s - s'| + |p - p'| + |a - a'| + |b - b'| := ⟨_, rfl⟩
  rw [← hd]
  have n1 := abs_nonneg (s - s')
  have n2 := abs_nonneg (p - p')
  have n3 := abs_nonneg (a - a')
  have n4 := abs_nonneg (b - b')
  have hds : |s - s'| ≤ 1 * d := by rw [hd]; linarith
  have hdp : |p - p'| ≤ 1 * d := by rw [hd]; linarith
  have hda : |a - a'| ≤ 1 * d := by rw [hd]; linarith
  have hdb : |b - b'| ≤ 1 * d := by rw [hd]; linarith
  have hsA : |s| ≤ 4 := abs_le.mpr ⟨by linarith, hs2⟩
  have hpA' : |p'| ≤ D := abs_le.mpr ⟨by linarith, hp2'⟩
  have haA : |a| ≤ D := abs_le.mpr ⟨by linarith, ha2⟩
  have haA' : |a'| ≤ D := abs_le.mpr ⟨by linarith, ha2'⟩

  have hF : |F0 - F0'| ≤ CF * d := by
    rw [hF0, hF0', hCF]; exact P1 s p s' p' 4 D 1 1 d hsA hpA' hds hdp (by norm_num) hD.le

  have hRd : |R - R'| ≤ 1 * d := by
    have := PR a b a' b' R R' hR hR' hRsq hRsq' haR hbR haR' hbR'
    rw [hd]; linarith
  have hRid : |R⁻¹ - R'⁻¹| ≤ (K * K * 1) * d := P2 R R' K 1 d hR hR' hRK hRK' hRd
  have hRiA' : |R'⁻¹| ≤ K := by rw [abs_of_pos hRi']; exact hRK'
  have hud : |u - u'| ≤ Cu * d := by
    rw [hu, hu', hCu]; exact P1 a R⁻¹ a' R'⁻¹ D K 1 (K * K * 1) d haA hRiA' hda hRid hD.le hK0.le
  have hvd : |v - v'| ≤ Cu * d := by
    rw [hv, hv', hCu]; exact P1 b R⁻¹ b' R'⁻¹ D K 1 (K * K * 1) d hb hRiA' hdb hRid hD.le hK0.le

  have haid : |a⁻¹ - a'⁻¹| ≤ (K * K * 1) * d :=
    P2 a a' K 1 d (by linarith) (by linarith) haK haK' hda
  have hSd : |(a ^ 2 + b ^ 2) - (a' ^ 2 + b' ^ 2)| ≤ CS * d := by
    have h1 := P1 a a a' a' D D 1 1 d haA haA' hda hda hD.le hD.le
    have h2 := P1 b b b' b' D D 1 1 d hb hb' hdb hdb hD.le hD.le
    have e : (a ^ 2 + b ^ 2) - (a' ^ 2 + b' ^ 2) = (a * a - a' * a') + (b * b - b' * b') := by ring
    rw [e, hCS]
    exact (abs_add_le _ _).trans (by linarith)
  have haiA' : |a'⁻¹| ≤ K := by rw [abs_of_pos hai']; exact haK'
  have hXd : |X - X'| ≤ CX * d := by
    rw [hX, hX', hCX]
    exact P1 (a ^ 2 + b ^ 2) a⁻¹ (a' ^ 2 + b' ^ 2) a'⁻¹ (2 * D ^ 2) K CS (K * K * 1) d hSabs
      haiA' hSd haid (by positivity) hK0.le
  have hWd : |W - W'| ≤ CW * d := by
    rw [hCW]; exact PS W W' X X' CX d hWl hWl' hWsq hWsq' hXd

  have hFud : |F0 * u - F0' * u'| ≤ CFu * d := by
    rw [hCFu]; exact P1 F0 u F0' u' (4 * D) 1 CF Cu d hF0b hu1' hF hud (by positivity) (by norm_num)
  have hFuA : |F0 * u| ≤ 4 * D * 1 := by
    rw [abs_mul]; exact mul_le_mul hF0b hu1 (abs_nonneg _) (by positivity)
  have hFuWd : |F0 * u * W - F0' * u' * W'| ≤ CFuW * d := by
    rw [hCFuW]
    exact P1 (F0 * u) W (F0' * u') W' (4 * D * 1) (1 + D ^ 2 * K) CFu CW d hFuA hWu' hFud hWd
      (by positivity) (by positivity)

  have T2 : eN (N - N') ≤ |u - u'| + |v - v'| := by
    have e : eN (N - N') = Real.sqrt ((u - u') ^ 2 + (v - v') ^ 2) := by
      rw [hNe, hNe']
      unfold eN
      congr 1
      simp only [Prod.fst_sub, Prod.snd_sub]
      ring
    rw [e, Real.sqrt_le_left (by positivity)]
    have h1 := mul_nonneg (abs_nonneg (u - u')) (abs_nonneg (v - v'))
    have e1 : |u - u'| ^ 2 = (u - u') ^ 2 := sq_abs _
    have e2 : |v - v'| ^ 2 = (v - v') ^ 2 := sq_abs _
    have e3 : (|u - u'| + |v - v'|) ^ 2 = |u - u'| ^ 2 + 2 * (|u - u'| * |v - v'|) + |v - v'| ^ 2 := by
      ring
    linarith
  have T3 : |lam - lam'| = 2 * |F0 * u * W - F0' * u' * W'| := by
    rw [hlame, hlame', ← mul_sub, abs_mul, abs_two]
  have T4 : |lam / (2 * F0 * N.1) - lam' / (2 * F0' * N'.1)| = |W - W'| := by
    rw [hc0, hc0', show -W - -W' = -(W - W') by ring, abs_neg]
  rw [T3, T4]
  have e : (CF + Cu + Cu + 2 * CFuW + CW) * d = CF * d + Cu * d + Cu * d + 2 * (CFuW * d) + CW * d := by
    ring
  rw [e]
  linarith

theorem frame5_consts : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ (c C : ℝ), 0 < c ∧
    ∀ γ : Lab, ActiveL4 B G γ → c ≤ F0r5 B G γ ∧ F0r5 B G γ ≤ C ∧ c ≤ eN (g0r5 B G γ) ∧
      eN (g0r5 B G γ) ≤ C ∧ (Nfr5 B G γ).1 ≤ -c ∧ c ≤ lam0_5 B G γ ∧ lam0_5 B G γ ≤ C ∧
      c0f5 B G γ ≤ -c ∧ -C ≤ c0f5 B G γ ∧
      ∀ γ' : Lab, ActiveL4 B G γ' → γ'.1 = γ.1 → γ'.2.1 = γ.2.1 →
        |F0r5 B G γ - F0r5 B G γ'| + eN (Nfr5 B G γ - Nfr5 B G γ') + |lam0_5 B G γ - lam0_5 B G γ'| +
          |c0f5 B G γ - c0f5 B G γ'| ≤ C * Sb γ.1 ^ (-3:ℤ) :=
by
  intro B G hB hG
  obtain ⟨κ, D, hκ0, hκ2, hκD, hP⟩ := profile_tuple_bounds B hB
  obtain ⟨Lp, hLp0, hLip⟩ :=
    profile_tuple_lip B hB κ hκ0 (fun X η h1 h2 h3 h4 => (hP X η h1 h2 h3 h4).1)
  obtain ⟨c3, C3, hc3, hBd⟩ := frame5_alg_bounds κ D hκ0 hκ2 hκD
  obtain ⟨L, hL0, hLL⟩ := frame5_alg_lip κ D hκ0 hκ2 hκD
  have hh0 : 0 < B.h := hB.2.1.1
  have hh1 : B.h < 1 / 100 := hB.2.1.2.1
  obtain ⟨hGP1, -, hGP3, -⟩ := hG
  have hlmin : 40 ≤ G.lmin := hGP1.2.2.2.2

  have s1b : ∀ ρ : ℝ, 1/2 ≤ ρ → ρ ≤ 2 → 1/4 ≤ ρ ^ (-(1 + B.h)) ∧ ρ ^ (-(1 + B.h)) ≤ 4 := by
    intro ρ h1 h2
    have hρ : 0 < ρ := by linarith
    rw [Real.rpow_neg hρ.le]
    have u1 : ρ ^ (1 + B.h) ≤ 4 := by
      calc ρ ^ (1 + B.h) ≤ (2:ℝ) ^ (1 + B.h) := Real.rpow_le_rpow hρ.le h2 (by linarith)
        _ ≤ (2:ℝ) ^ (2:ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
        _ = 4 := by rw [Real.rpow_two]; norm_num
    have u2 : 1/4 ≤ ρ ^ (1 + B.h) := by
      calc (1/4:ℝ) = (1/2:ℝ) ^ (2:ℝ) := by rw [Real.rpow_two]; norm_num
        _ ≤ (1/2:ℝ) ^ (1 + B.h) :=
            Real.rpow_le_rpow_of_exponent_ge (by norm_num) (by norm_num) (by linarith)
        _ ≤ ρ ^ (1 + B.h) := Real.rpow_le_rpow (by norm_num) h1 (by linarith)
    have hp : 0 < ρ ^ (1 + B.h) := Real.rpow_pos_of_pos hρ _
    constructor
    · rw [inv_eq_one_div]
      exact one_div_le_one_div_of_le hp u1
    · rw [inv_eq_one_div]
      have := one_div_le_one_div_of_le (by norm_num : (0:ℝ) < 1/4) u2
      linarith [this, show (1:ℝ) / (1/4) = 4 by norm_num]
  have s1l : ∀ ρ ρ' : ℝ, 1/2 ≤ ρ → ρ ≤ 2 → 1/2 ≤ ρ' → ρ' ≤ 2 →
      |ρ ^ (-(1 + B.h)) - ρ' ^ (-(1 + B.h))| ≤ 16 * |ρ - ρ'| := by
    intro ρ ρ' h1 h2 h3 h4
    have hd : ∀ x ∈ Set.Icc (1/2:ℝ) 2, HasDerivWithinAt (fun x : ℝ => x ^ (-(1 + B.h)))
        ((-(1 + B.h)) * x ^ (-(1 + B.h) - 1)) (Set.Icc (1/2:ℝ) 2) x := by
      intro x hx
      exact (Real.hasDerivAt_rpow_const
        (Or.inl (show (0:ℝ) < x by linarith [hx.1]).ne')).hasDerivWithinAt
    have hb : ∀ x ∈ Set.Icc (1/2:ℝ) 2, ‖(-(1 + B.h)) * x ^ (-(1 + B.h) - 1)‖ ≤ 16 := by
      intro x hx
      have hx0 : 0 < x := by linarith [hx.1]
      have e : -(1 + B.h) - 1 = -(2 + B.h) := by ring
      have hp : 0 < x ^ (2 + B.h) := Real.rpow_pos_of_pos hx0 _
      rw [e, Real.rpow_neg hx0.le, Real.norm_eq_abs, abs_mul,
        abs_of_neg (by linarith : -(1 + B.h) < 0), abs_of_pos (inv_pos.mpr hp)]
      have u2 : 1/8 ≤ x ^ (2 + B.h) := by
        calc (1/8:ℝ) = (1/2:ℝ) ^ ((3:ℕ):ℝ) := by rw [Real.rpow_natCast]; norm_num
          _ ≤ (1/2:ℝ) ^ (2 + B.h) :=
              Real.rpow_le_rpow_of_exponent_ge (by norm_num) (by norm_num) (by push_cast; linarith)
          _ ≤ x ^ (2 + B.h) := Real.rpow_le_rpow (by norm_num) hx.1 (by linarith)
      have hi : (x ^ (2 + B.h))⁻¹ ≤ 8 := by
        rw [inv_eq_one_div]
        have := one_div_le_one_div_of_le (by norm_num : (0:ℝ) < 1/8) u2
        linarith [this, show (1:ℝ) / (1/8) = 8 by norm_num]
      have hi0 : 0 ≤ (x ^ (2 + B.h))⁻¹ := (inv_pos.mpr hp).le
      nlinarith [mul_nonneg (show 0 ≤ 1 - B.h by linarith) hi0]
    have := (convex_Icc (1/2:ℝ) 2).norm_image_sub_le_of_norm_hasDerivWithin_le hd hb
      ⟨h3, h4⟩ ⟨h1, h2⟩
    simpa only [Real.norm_eq_abs] using this

  have act : ∀ γ : Lab, ActiveL4 B G γ →
      B.Xa ≤ (G.rep γ).1 ∧ (G.rep γ).1 ≤ B.Xb ∧ -1 < (G.rep γ).2.1 ∧ (G.rep γ).2.1 < 1 ∧
      1/2 ≤ (G.rep γ).2.2 ∧ (G.rep γ).2.2 ≤ 2 ∧ 0 < Sb γ.1 ^ (-3:ℤ) := by
    intro γ hγ
    obtain ⟨g1, g2, g3, g4, g5, -⟩ := hGP3 γ hγ
    have hl : (40:ℝ) ≤ (γ.1:ℝ) := by exact_mod_cast le_trans hlmin hγ.1
    have hSb : 0 < Sb γ.1 := by unfold Sb; exact pow_pos (by linarith) 2
    have hS : 0 < Sb γ.1 ^ (-3:ℤ) := zpow_pos hSb _
    have := abs_le.mp g3
    exact ⟨g1, g2, by linarith [this.1], by linarith [this.2], g4, g5, hS⟩

  have fin : ∀ (LHS ds dp da db dX dη dρ S : ℝ), LHS ≤ L * (ds + dp + da + db) →
      ds ≤ 16 * dρ → dp + da + db ≤ Lp * (dX + dη) → dX + dη + dρ ≤ 2 * G.Crep * S →
      0 ≤ dX → 0 ≤ dη → 0 ≤ dρ → 0 ≤ S →
      LHS ≤ max C3 (2 * L * max 16 Lp * G.Crep) * S := by
    intro LHS ds dp da db dX dη dρ S h1 h2 h3 h4 hX hη hρ hS
    have hM0 : 0 ≤ max 16 Lp := le_trans (by norm_num) (le_max_left 16 Lp)
    have k1 : ds + dp + da + db ≤ max 16 Lp * (dX + dη + dρ) := by
      have q1 := mul_le_mul_of_nonneg_right (le_max_left 16 Lp) hρ
      have q2 := mul_le_mul_of_nonneg_right (le_max_right 16 Lp) (add_nonneg hX hη)
      linarith
    have k2 : max 16 Lp * (dX + dη + dρ) ≤ max 16 Lp * (2 * G.Crep * S) :=
      mul_le_mul_of_nonneg_left h4 hM0
    have k3 : L * (ds + dp + da + db) ≤ L * (max 16 Lp * (2 * G.Crep * S)) :=
      mul_le_mul_of_nonneg_left (k1.trans k2) hL0
    have k4 : (2 * L * max 16 Lp * G.Crep) * S ≤ max C3 (2 * L * max 16 Lp * G.Crep) * S :=
      mul_le_mul_of_nonneg_right (le_max_right _ _) hS
    have e : L * (max 16 Lp * (2 * G.Crep * S)) = (2 * L * max 16 Lp * G.Crep) * S := by ring
    linarith
  refine ⟨c3, max C3 (2 * L * max 16 Lp * G.Crep), hc3, ?_⟩
  intro γ hγ
  obtain ⟨a1, a2, a3, a4, a5, a6, hS⟩ := act γ hγ
  obtain ⟨p1, p2, p3, p4, p5, p6⟩ := hP _ _ a1 a2 a3 a4
  obtain ⟨s1, s2⟩ := s1b _ a5 a6
  obtain ⟨b1, b2, b3, b4, b5, b6, b7, b8, b9⟩ := hBd _ _ _ _ (F0r5 B G γ) (lam0_5 B G γ)
    (g0r5 B G γ) (Nfr5 B G γ) s1 s2 p1 p2 p3 p4 p5 p6 rfl rfl rfl rfl
  refine ⟨b1, b2.trans (le_max_left _ _), b3, b4.trans (le_max_left _ _), b5, b6,
    b7.trans (le_max_left _ _), b8, le_trans (neg_le_neg (le_max_left _ _)) b9, ?_⟩
  intro γ' hγ' e1 e2
  obtain ⟨a1', a2', a3', a4', a5', a6', -⟩ := act γ' hγ'
  obtain ⟨p1', p2', p3', p4', p5', p6'⟩ := hP _ _ a1' a2' a3' a4'
  obtain ⟨s1', s2'⟩ := s1b _ a5' a6'
  have hLL' := hLL _ _ _ _ (F0r5 B G γ) (lam0_5 B G γ) _ _ _ _ (F0r5 B G γ') (lam0_5 B G γ')
    (g0r5 B G γ) (Nfr5 B G γ) (g0r5 B G γ') (Nfr5 B G γ')
    s1 s2 p1 p2 p3 p4 p5 p6 s1' s2' p1' p2' p3' p4' p5' p6' rfl rfl rfl rfl rfl rfl rfl rfl
  have g := (hGP3 γ hγ).2.2.2.2.2
  have g' := (hGP3 γ' hγ').2.2.2.2.2
  obtain ⟨-, ξ, hξ, hη, -⟩ := hγ
  have hetaeq : etaL B.h γ' ξ = etaL B.h γ ξ := by
    unfold etaL
    rw [e1, e2]
  have hη' : etaL B.h γ' ξ ≠ 0 := by rw [hetaeq]; exact hη
  have r1 := g ξ hξ hη
  have r2 := g' ξ hξ hη'
  rw [e1] at r2
  have hXd : |(G.rep γ).1 - (G.rep γ').1| ≤
      |XC B.h ξ - (G.rep γ).1| + |XC B.h ξ - (G.rep γ').1| := by
    rw [abs_sub_comm (XC B.h ξ) (G.rep γ).1]; exact abs_sub_le _ _ _
  have hEd : |(G.rep γ).2.1 - (G.rep γ').2.1| ≤
      |etaC B.h ξ - (G.rep γ).2.1| + |etaC B.h ξ - (G.rep γ').2.1| := by
    rw [abs_sub_comm (etaC B.h ξ) (G.rep γ).2.1]; exact abs_sub_le _ _ _
  have hRd : |(G.rep γ).2.2 - (G.rep γ').2.2| ≤
      |qC B.h ξ / Qb γ.1 - (G.rep γ).2.2| + |qC B.h ξ / Qb γ.1 - (G.rep γ').2.2| := by
    rw [abs_sub_comm (qC B.h ξ / Qb γ.1) (G.rep γ).2.2]; exact abs_sub_le _ _ _
  have hΔ : |(G.rep γ).1 - (G.rep γ').1| + |(G.rep γ).2.1 - (G.rep γ').2.1| +
      |(G.rep γ).2.2 - (G.rep γ').2.2| ≤ 2 * G.Crep * Sb γ.1 ^ (-3:ℤ) := by
    linarith
  have hs := s1l _ _ a5 a6 a5' a6'
  have hl := hLip _ _ _ _ a1 a2 a1' a2' a3 a4 a3' a4'
  exact fin _ _ _ _ _ _ _ _ _ hLL' hs hl hΔ (abs_nonneg _) (abs_nonneg _) (abs_nonneg _) hS.le

theorem pulse5_scale_consts : ∀ (h r0 : ℝ) (l : ℕ), 0 < h → h < 1/100 → 0 < r0 → 1 ≤ l →
    1 / (Tgc * (l:ℝ) ^ 2) ≤ cib h l ∧ cib h l ≤ 1 / (l:ℝ) ^ 2 ∧ 0 < ∫ u in (-r0)..r0, chig r0 u ^ 2 ∧
    ∫ u in (-r0)..r0, chig r0 u ^ 2 ≤ 2 * r0 :=
by
  intro h r0 l _ _ hr0 hl
  have hL : (1:ℝ) ≤ (l:ℝ) := by exact_mod_cast hl
  have hL2 : (0:ℝ) < (l:ℝ) ^ 2 := by positivity
  have hT1 : (1:ℝ) < Tgc := by
    unfold Tgc
    have := Real.sqrt_nonneg 2
    linarith
  have hT0 : (0:ℝ) < Tgc := by linarith
  have hy0 : (0:ℝ) < (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) :=
    div_pos (Real.rpow_pos_of_pos two_pos _) hL2
  have hQ0 : 0 < Qb l := Real.rpow_pos_of_pos two_pos _
  have hQp : 0 < Qb l ^ (1 + h) := Real.rpow_pos_of_pos hQ0 _
  have hfl : ((bandIdx h l : ℤ) : ℝ) ≤
      Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2)) := Int.floor_le _
  have hfl2 : Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2)) - 1 ≤
      ((bandIdx h l : ℤ) : ℝ) := (Int.sub_one_lt_floor _).le
  have hz : Tgc ^ (bandIdx h l) ≤ (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) := by
    rw [← Real.rpow_intCast]
    calc Tgc ^ ((bandIdx h l : ℤ) : ℝ)
        ≤ Tgc ^ (Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2))) :=
          Real.rpow_le_rpow_of_exponent_le hT1.le hfl
      _ = (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) := Real.rpow_logb hT0 hT1.ne' hy0
  have hz2 : (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) / Tgc ≤ Tgc ^ (bandIdx h l) := by
    rw [← Real.rpow_intCast]
    calc (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) / Tgc
        = Tgc ^ (Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2)) - 1) := by
          rw [Real.rpow_sub hT0, Real.rpow_one, Real.rpow_logb hT0 hT1.ne' hy0]
      _ ≤ Tgc ^ ((bandIdx h l : ℤ) : ℝ) := Real.rpow_le_rpow_of_exponent_le hT1.le hfl2
  have hQe : Qb l ^ (1 + h) * (2:ℝ) ^ ((1 + h) * (l:ℝ)) = 1 := by
    unfold Qb
    rw [← Real.rpow_mul (by norm_num), ← Real.rpow_add two_pos]
    have e : -(l:ℝ) * (1 + h) + (1 + h) * (l:ℝ) = 0 := by ring
    rw [e, Real.rpow_zero]
  have hyL : (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) * (l:ℝ) ^ 2 =
      (2:ℝ) ^ ((1 + h) * (l:ℝ)) := div_mul_cancel₀ _ hL2.ne'
  have sB : cib h l ≤ 1 / (l:ℝ) ^ 2 := by
    rw [le_div_iff₀ hL2]
    unfold cib
    calc Tgc ^ (bandIdx h l) * Qb l ^ (1 + h) * (l:ℝ) ^ 2
        ≤ (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) * Qb l ^ (1 + h) * (l:ℝ) ^ 2 := by
          have := mul_le_mul_of_nonneg_right hz hQp.le
          exact mul_le_mul_of_nonneg_right this hL2.le
      _ = ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) * (l:ℝ) ^ 2) * Qb l ^ (1 + h) := by ring
      _ = 1 := by rw [hyL, mul_comm]; exact hQe
  have sA : 1 / (Tgc * (l:ℝ) ^ 2) ≤ cib h l := by
    unfold cib
    have e1 : 1 / (Tgc * (l:ℝ) ^ 2) =
        (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) / Tgc * Qb l ^ (1 + h) := by
      generalize (2:ℝ) ^ ((1 + h) * (l:ℝ)) = P at hQe ⊢
      generalize Qb l ^ (1 + h) = Q at hQe ⊢
      rw [div_div, div_mul_eq_mul_div, mul_comm P Q, hQe]
      ring
    rw [e1]
    exact mul_le_mul_of_nonneg_right hz2 hQp.le
  have hcont : Continuous (fun u => chig r0 u ^ 2) := by
    unfold chig bumpR
    exact (Real.smoothTransition.continuous.comp (by fun_prop)).pow 2
  have hnn : ∀ u, 0 ≤ chig r0 u := by
    intro u; unfold chig bumpR; exact Real.smoothTransition.nonneg _
