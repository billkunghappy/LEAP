theorem stress5_lift_wave_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → ∀ (c : Lab → Cyl → (Fin 3 → ℝ)) (ξ : Cyl),
    0 < ξ.1 → ξ.2.2.1 < 1 → ∀ (θ : ℝ) (a : Fin 3),
      tSum5 B G c a θ ξ = qC B.h ξ ^ (-Aex B.h) * waveV5 B G (liftAmp5 B c) θ ξ a :=
by
  intro B G hok c ξ _hξ1 hξ2 θ a
  have hq : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  obtain ⟨T, hT⟩ : ∃ T : Lab → ℝ, T = fun γ => (qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) * c γ ξ a *
      (2 * Real.cos ((pint5 B G γ : ℝ) * θ + (kb B.h γ.1 : ℝ) * phiL5 B G γ ξ)) := ⟨_, rfl⟩
  have hinner : ∀ γ : Lab,
      (∑ᶠ m : ℤ, liftAmp5 B c γ m ξ a * ephase5 B G γ m θ ξ) = ((T γ : ℝ) : ℂ) := by
    intro γ
    have hsupp : Function.support (fun m : ℤ => liftAmp5 B c γ m ξ a * ephase5 B G γ m θ ξ) ⊆
        ↑({1, -1} : Finset ℤ) := by
      intro m hm
      by_contra hc
      apply hm
      simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
        Set.mem_singleton_iff] at hc
      simp only [liftAmp5, liftH5, if_neg hc, Pi.zero_apply, mul_zero, zero_mul]
    rw [finsum_eq_sum_of_support_subset _ hsupp, Finset.sum_pair (by decide)]
    have e1 : liftAmp5 B c γ 1 ξ a = (((qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ) * ((c γ ξ a : ℝ) : ℂ) := by
      simp [liftAmp5, liftH5]
    have e2 : liftAmp5 B c γ (-1) ξ a = (((qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ) * ((c γ ξ a : ℝ) : ℂ) := by
      simp [liftAmp5, liftH5]
    have hψ : ((pint5 B G γ : ℂ) * (θ : ℂ) + (kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)) =
        ((((pint5 B G γ : ℝ) * θ + (kb B.h γ.1 : ℝ) * phiL5 B G γ ξ : ℝ)) : ℂ) := by
      push_cast; ring
    rw [e1, e2]
    simp only [ephase5]
    rw [hψ, hT]
    beta_reduce
    generalize (qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) = μ
    generalize c γ ξ a = cv
    generalize (pint5 B G γ : ℝ) * θ + (kb B.h γ.1 : ℝ) * phiL5 B G γ ξ = ψ
    have hcos : Complex.exp (Complex.I * ((1:ℤ):ℂ) * (ψ:ℂ)) +
        Complex.exp (Complex.I * ((-1:ℤ):ℂ) * (ψ:ℂ)) = 2 * ((Real.cos ψ : ℝ) : ℂ) := by
      rw [Complex.ofReal_cos, Complex.two_cos]
      congr 1 <;> congr 1 <;> push_cast <;> ring
    generalize Real.cos ψ = C at hcos ⊢
    push_cast at hcos ⊢
    linear_combination ((μ : ℂ) * (cv : ℂ)) * hcos
  have hwave : waveV5 B G (liftAmp5 B c) θ ξ a = ∑ᶠ γ, T γ := by
    show (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, liftAmp5 B c γ m ξ a * ephase5 B G γ m θ ξ).re = _
    rw [finsum_congr hinner]
    have h1 : ((∑ᶠ γ, T γ : ℝ) : ℂ) = ∑ᶠ γ, ((T γ : ℝ) : ℂ) :=
      AddMonoidHom.map_finsum_of_injective (Complex.ofRealHom.toAddMonoidHom)
        Complex.ofReal_injective T
    rw [← h1, Complex.ofReal_re]
  show ∑ᶠ γ : Lab, tPart5 B G c γ θ ξ a = _
  rw [hwave, mul_finsum]
  apply finsum_congr
  intro γ
  have hQ : 0 < Qb γ.1 := by unfold Qb; positivity
  rw [hT]
  simp only [tPart5, Aex]
  rw [Real.div_rpow hq.le hQ.le, Real.rpow_neg hQ.le,
    show -(1/2 + B.h) = -B.h + -(1/2:ℝ) by ring, Real.rpow_add hq, Real.rpow_neg hq.le (1/2:ℝ)]
  have hu : 0 < qC B.h ξ ^ (1/2:ℝ) := Real.rpow_pos_of_pos hq _
  have hv : 0 < Qb γ.1 ^ (1/2:ℝ) := Real.rpow_pos_of_pos hQ _
  field_simp

theorem stress5_cov_pairing_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S S2 : CState)
    (c : Lab → Cyl → (Fin 3 → ℝ)) (Bo : ℝ) (u0 : Cyl → Fin 3 → ℝ) (A0 AD : WC), B.ok → 7/10 ≤ Bo →
    (∀ (a b : WC) (α β : ℝ), InWg5 B G (qsOf l0) α a → InWg5 B G (qsOf l0) β b →
      ∀ ξ ∈ DomC B.h (qsOf l0), ∀ i j : Fin 3,
        Continuous (fun θ => waveV5 B G a θ ξ i) ∧ thA (fun θ => waveV5 B G a θ ξ i) = 0 ∧
        (∀ θ, waveV5 B G (a + b) θ ξ i = waveV5 B G a θ ξ i + waveV5 B G b θ ξ i) ∧
