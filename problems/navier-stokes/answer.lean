      rw [abs_mul, abs_of_nonneg hA0] at this
      exact this
    have h1 : |X| * s ≤ 2 / 5 * Real.sqrt lam := by
      rw [habs]
      nlinarith [mul_nonneg (abs_nonneg d1) (sub_nonneg.2 hA1), abs_nonneg d0]
    have h2 : |X| * (2 / 5) ≤ |X| * s := mul_le_mul_of_nonneg_left hs (abs_nonneg X)
    linarith
  refine ⟨fun η => (Real.sqrt (q1 η ^ 2 - 4 * q2 * q0 η) - q1 η) / (2 * q2), ?_, ?_, ?_⟩
  · have hDs : ContDiffOn ℝ ∞ (fun η => q1 η ^ 2 - 4 * q2 * q0 η) (Ioo (-2) 2) :=
      (hq1s.contDiffOn.pow 2).sub (contDiffOn_const.mul hq0s)
    have hDne : ∀ x ∈ Ioo (-2 : ℝ) 2, q1 x ^ 2 - 4 * q2 * q0 x ≠ 0 := fun x hx =>
      (scal _ _ (hb x hx.1 hx.2).1 (hb x hx.1 hx.2).2.1 (hb x hx.1 hx.2).2.2).1.ne'
    exact ((hDs.sqrt hDne).sub hq1s.contDiffOn).div_const _
  · intro η h1 h2
    obtain ⟨hD, -, -, -⟩ := scal _ _ (hb η h1 h2).1 (hb η h1 h2).2.1 (hb η h1 h2).2.2
    have hs2 := Real.sq_sqrt hD.le
    have hq2ne : q2 ≠ 0 := hq2pos.ne'
    have e : q2 * ((Real.sqrt (q1 η ^ 2 - 4 * q2 * q0 η) - q1 η) / (2 * q2)) ^ 2 +
        q1 η * ((Real.sqrt (q1 η ^ 2 - 4 * q2 * q0 η) - q1 η) / (2 * q2)) + q0 η =
        (Real.sqrt (q1 η ^ 2 - 4 * q2 * q0 η) ^ 2 - (q1 η ^ 2 - 4 * q2 * q0 η)) / (4 * q2) := by
      field_simp
      ring
    show q2 * ((Real.sqrt (q1 η ^ 2 - 4 * q2 * q0 η) - q1 η) / (2 * q2)) ^ 2 +
        q1 η * ((Real.sqrt (q1 η ^ 2 - 4 * q2 * q0 η) - q1 η) / (2 * q2)) + q0 η = 0
    rw [e, hs2, sub_self, zero_div]
  · intro η h1 h2
    have hη1 : -2 < η := by linarith
    have hη2 : η < 2 := by linarith
    obtain ⟨hDp, hs, hA1, hA2⟩ :=
      scal _ _ (hb η hη1 hη2).1 (hb η hη1 hη2).2.1 (hb η hη1 hη2).2.2
    refine ⟨hA1, hA2, ?_⟩
    have hmem : Ioo (-2 : ℝ) 2 ∈ nhds η := Ioo_mem_nhds hη1 hη2
    have hd0 : DifferentiableAt ℝ q0 η := (hq0s.contDiffAt hmem).differentiableAt (by simp)
    have hd1 : DifferentiableAt ℝ q1 η := hq1s.differentiable (by simp) η
    have hD' : HasDerivAt (fun x => q1 x ^ 2 - 4 * q2 * q0 x)
        (2 * q1 η * deriv q1 η - 4 * q2 * deriv q0 η) η := by
      have := (hd1.hasDerivAt.mul hd1.hasDerivAt).sub (hd0.hasDerivAt.const_mul (4 * q2))
      rw [show (fun x => q1 x ^ 2 - 4 * q2 * q0 x) = fun x => q1 x * q1 x - 4 * q2 * q0 x from
        funext fun x => by ring]
      convert this using 1
      ring
    have hA' : HasDerivAt (fun η => (Real.sqrt (q1 η ^ 2 - 4 * q2 * q0 η) - q1 η) / (2 * q2))
        (((2 * q1 η * deriv q1 η - 4 * q2 * deriv q0 η) /
          (2 * Real.sqrt (q1 η ^ 2 - 4 * q2 * q0 η)) - deriv q1 η) / (2 * q2)) η :=
      ((hD'.sqrt hDp.ne').sub hd1.hasDerivAt).div_const (2 * q2)
    rw [hA'.deriv]
    exact dscal _ _ _ _ hs (by linarith) hA2 (hd η h1 h2)

theorem rfp_moment_closure : ∀ Md : ℝ, 0 < Md → ∃ P0 : ℝ, ∀ Pst : ℝ, P0 ≤ Pst → ∃ l0 : ℝ, 0 < l0 ∧ ∀ lam : ℝ, 0 < lam → lam ≤ l0 → ∃ h0 : ℝ, 0 < h0 ∧ ∀ h ρ T1 : ℝ, 0 < h → h ≤ h0 → 0 < ρ → ρ ≤ h / 800 → 4 * Real.log (1 / h) ≤ T1 → ∃ P : RfpPar, P.Md = Md ∧ P.Pst = Pst ∧ P.lam = lam ∧ P.h = h ∧ P.ρ = ρ ∧ P.T1 = T1 ∧ RfpRegime P ∧ RfpClos P :=
by
  intro Md hMd
  refine ⟨Real.exp (Real.exp Md + 10) + 1, ?_⟩
  intro Pst hPst
  have hE : 0 < Real.exp Md + 13 := by positivity
  refine ⟨min (1 / 1000) (1 / (10 ^ 14 * (Real.exp Md + 13))), lt_min (by norm_num) (by positivity), ?_⟩
  intro lam hlam0 hlam1
  have hlamA : lam ≤ 1 / 1000 := le_trans hlam1 (min_le_left _ _)
  have hlamB0 : lam ≤ 1 / (10 ^ 14 * (Real.exp Md + 13)) := le_trans hlam1 (min_le_right _ _)
  have hlamB1 : lam * (10 ^ 14 * (Real.exp Md + 13)) ≤ 1 := (le_div_iff₀ (by positivity)).mp hlamB0
  have hlamM : lam * (Real.exp Md + 13) ≤ 1 / 10 ^ 14 := by
    rw [le_div_iff₀ (by positivity)]
    calc lam * (Real.exp Md + 13) * 10 ^ 14 = lam * (10 ^ 14 * (Real.exp Md + 13)) := by ring
      _ ≤ 1 := hlamB1
  have hlamS : lam ≤ 1 / 10 ^ 14 := by
    have : lam ≤ lam * (Real.exp Md + 13) := by nlinarith [Real.exp_pos Md]
    linarith
  refine ⟨lam ^ 2, by positivity, ?_⟩
  intro h ρ T1 hh0 hh1 hρ0 hρ1 hT1
  have hreg : ∀ (Lh : ℝ) (A c1 c2 ca : ℝ → ℝ), 0 ≤ Lh →
      RfpRegime (RfpPar.mk Md Pst lam h ρ T1 Lh A c1 c2 ca) := by
    intro Lh A c1 c2 ca hLh
    unfold RfpRegime
    exact ⟨(hMd : 0 < Md), (by linarith : Real.exp (Real.exp Md + 10) < Pst), (hlam0 : 0 < lam),
      (by linarith : lam ≤ 1 / 100), (hh0 : 0 < h), (hh1 : h ≤ lam ^ 2), (hρ0 : 0 < ρ),
      (hρ1 : ρ ≤ h / 800), (hT1 : 4 * Real.log (1 / h) ≤ T1), (hLh : 0 ≤ Lh)⟩

  have hl1 : lam ≤ 1 := by linarith
  have hl9 : lam ^ 9 ≤ 1 / 1000 := le_trans (pow_le_of_le_one hlam0.le hl1 (by norm_num)) hlamA
  have hl20pos : 0 ≤ lam ^ 20 := by positivity
  have hl29 : lam ^ 29 ≤ lam ^ 20 / 1000 := by
    calc lam ^ 29 = lam ^ 20 * lam ^ 9 := by ring
      _ ≤ lam ^ 20 * (1 / 1000) := mul_le_mul_of_nonneg_left hl9 hl20pos
      _ = lam ^ 20 / 1000 := by ring
  have hl20 : lam ^ 20 ≤ 1 / 1000 := le_trans (pow_le_of_le_one hlam0.le hl1 (by norm_num)) hlamA
  have hl29pos : 0 ≤ lam ^ 29 := by positivity

  obtain ⟨N5, G, δ, hN5, hGs, hG0, hGd, hδs, hδ0, hδb, hψ0, hI⟩ :=
    rfp_I_reduction (RfpPar.mk Md Pst lam h ρ T1 0 0 0 0 0) (hreg 0 0 0 0 0 le_rfl)
  have hδb' : ∀ η : ℝ, 0 ≤ δ η ∧ δ η ≤ lam ^ 29 ∧ |deriv δ η| ≤ lam ^ 29 := hδb
  have hδlt : ∀ η : ℝ, |δ η| < 1 / 40 * (1 / 16) := by
    intro η
    rw [abs_of_nonneg (hδb' η).1]
    have h' : δ η ≤ lam ^ 29 := (hδb' η).2.1
    linarith
  obtain ⟨g, hgs, hg⟩ := smooth_inverse_of_strict_anti G δ (1 / 16) (1 / 8) (1 / 40)
    (by norm_num) (by norm_num) (by norm_num) hGs hG0 hGd hδs hδlt
  have hgb : ∀ η : ℝ, |g η| ≤ 40 * lam ^ 29 ∧ |deriv g η| ≤ 40 * lam ^ 29 := by
    intro η
    obtain ⟨-, hg1, hg2⟩ := hg η
    have hd1 : |δ η| ≤ lam ^ 29 := by
      rw [abs_of_nonneg (hδb' η).1]; exact (hδb' η).2.1
    have hd2 : |deriv δ η| ≤ lam ^ 29 := (hδb' η).2.2
    constructor
    · calc |g η| ≤ |δ η| / (1 / 40) := hg1
        _ = 40 * |δ η| := by ring
        _ ≤ 40 * lam ^ 29 := by linarith
    · calc |deriv g η| ≤ |deriv δ η| / (1 / 40) := hg2
        _ = 40 * |deriv δ η| := by ring
        _ ≤ 40 * lam ^ 29 := by linarith
  have hg0 : g 0 = 0 := by
    have h1 := (hg 0).2.1
    rw [hδ0, abs_zero, zero_div] at h1
    exact abs_nonpos_iff.mp h1
  have hg16 : ∀ e : ℝ, |g e| ≤ 1 / 16 := fun e => by linarith [(hgb e).1]
  have hgψ : ∀ (P : RfpPar), (∀ y : ℝ, |rfpPsi P y| ≤ 8) → ∀ (η y : ℝ),
      |g η * rfpPsi P y| ≤ 1 / 2 := by
    intro P hP η y
    rw [abs_mul]
    calc |g η| * |rfpPsi P y| ≤ (40 * lam ^ 29) * 8 :=
          mul_le_mul (hgb η).1 (hP y) (abs_nonneg _) (by positivity)
      _ ≤ 1 / 2 := by linarith
  have hgb' : ∀ η : ℝ, |g η| + |deriv g η| ≤ lam ^ 20 := by
    intro η
    have := hgb η
    linarith
  have hIP1 : ∀ η : ℝ, -1 < η → η < 1 →
      (∫ x in (0:ℝ)..Real.exp (rfpY5 Md lam),
          2 * x * rfpF (RfpPar.mk Md Pst lam h ρ T1 0 0 0 0 g) x η) =
        ∫ x in (0:ℝ)..Real.exp (rfpY5 Md lam),
          2 * x * rfpF (RfpPar.mk Md Pst lam h ρ T1 0 0 0 0 g) x 0 := by
    intro η _ _
    have e := hI g η hg16
    have e2 : N5 * (δ η - 0 - δ η) = 0 := by ring
    rw [(hg η).1, hg0, hG0, e2] at e
    exact sub_eq_zero.mp e

  obtain ⟨Lh, hLh, hFeq, hT⟩ := rfp_T_closure (RfpPar.mk Md Pst lam h ρ T1 0 0 0 0 g)
    (hreg 0 0 0 0 g le_rfl) hg0
    (fun η h1 h2 => ⟨fun y => hgψ (RfpPar.mk Md Pst lam h ρ T1 0 0 0 0 0) hψ0 η y, hIP1 η h1 h2⟩)
  have hIP2 : ∀ η : ℝ, -1 < η → η < 1 →
      (∫ x in (0:ℝ)..Real.exp (rfpY5 Md lam),
          2 * x * rfpF (RfpPar.mk Md Pst lam h ρ T1 Lh 0 0 0 g) x η) =
        ∫ x in (0:ℝ)..Real.exp (rfpY5 Md lam),
          2 * x * rfpF (RfpPar.mk Md Pst lam h ρ T1 Lh 0 0 0 g) x 0 := by
    have hcong : ∀ e : ℝ,
        (∫ x in (0:ℝ)..Real.exp (rfpY5 Md lam),
            2 * x * rfpF (RfpPar.mk Md Pst lam h ρ T1 Lh 0 0 0 g) x e) =
          ∫ x in (0:ℝ)..Real.exp (rfpY5 Md lam),
            2 * x * rfpF (RfpPar.mk Md Pst lam h ρ T1 0 0 0 0 g) x e := by
      intro e
      apply intervalIntegral.integral_congr
      intro x hx
      rw [Set.uIcc_of_le (Real.exp_pos _).le] at hx
      rcases eq_or_lt_of_le hx.1 with h0 | hpos
      · subst h0
        simp
      · have hF := hFeq x e hpos hx.2
        show 2 * x * rfpF (RfpPar.mk Md Pst lam h ρ T1 Lh 0 0 0 g) x e =
          2 * x * rfpF (RfpPar.mk Md Pst lam h ρ T1 0 0 0 0 g) x e
        exact congrArg (fun v => 2 * x * v) hF
    intro η h1 h2
    rw [hcong η, hcong 0]
    exact hIP1 η h1 h2

  obtain ⟨_, _, _, -, -, -, -, -, -, -, hψ2, -⟩ :=
    rfp_I_reduction (RfpPar.mk Md Pst lam h ρ T1 Lh 0 0 0 g) (hreg Lh 0 0 0 g hLh)
  obtain ⟨α1, α2, γ1, γ2, hαγ, hMJ⟩ :=
    rfp_MJ_linear (RfpPar.mk Md Pst lam h ρ T1 Lh 0 0 0 g) (hreg Lh 0 0 0 g hLh) hlamA
  have hαγ' : |α1| + |α2| + |γ1| + |γ2| ≤ lam ^ 20 / 16 := hαγ

  obtain ⟨hD0, hIp1, hIp2, hB10, hB11, hB20, hB21, hK0, hK1, hW⟩ :=
    rfp_S_masses_pre (RfpPar.mk Md Pst lam h ρ T1 Lh 0 0 0 g) (hreg Lh 0 0 0 g hLh) hlamM
  obtain ⟨hC0, hC1, hΨ⟩ :=
    rfp_S_masses_post (RfpPar.mk Md Pst lam h ρ T1 Lh 0 0 0 g) (hreg Lh 0 0 0 g hLh)
  obtain ⟨hVs, hVb⟩ :=
    rfp_S_V_smooth (RfpPar.mk Md Pst lam h ρ T1 Lh 0 0 0 g) (hreg Lh 0 0 0 g hLh)
  obtain ⟨q2, q1, q0, hq2a, hq2b, hq1s, hq0s, hqb, hqd, hid⟩ :=
    rfp_S_coeffs lam _ _ _ _ _ _ _ _ α1 α2 γ1 γ2 _ g hlam0 hlamS hD0 hIp1 hIp2 hB10 hB11 hB20 hB21
      hK0 hK1 hW hC0 hC1 hΨ hαγ' hVs hgs hVb hgb'

  obtain ⟨Amp, hAs, hAroot, hAb⟩ :=
    quad_root_smooth_sqrt q2 lam q1 q0 hlam0 (by linarith) hq2a hq2b hq1s hq0s hqb hqd

  have hpoly : ∀ η : ℝ, HasDerivAt (fun e : ℝ => e * (1 + e ^ 2)) (1 + 3 * η ^ 2) η := by
    intro η
    have h2 : HasDerivAt (fun e : ℝ => 1 + e ^ 2) (2 * η) η := by
      simpa using (hasDerivAt_pow 2 η).const_add 1
    have hd := (hasDerivAt_id' η).mul h2
    convert hd using 1
    ring
  have hc_s : ∀ a c : ℝ, ContDiffOn ℝ ∞ (fun e => Amp e * a + e * (1 + e ^ 2) * c) (Ioo (-2) 2) := by
    intro a c
    have hp : ContDiff ℝ ∞ (fun e : ℝ => e * (1 + e ^ 2) * c) := by fun_prop
    exact (hAs.mul contDiffOn_const).add hp.contDiffOn
  have hkey : ∀ (a c A dA p dp : ℝ), |A| ≤ 6 / 5 → |dA| ≤ 1 → |p| ≤ 2 → |dp| ≤ 4 →
      |A * a + p * c| + |dA * a + dp * c| ≤ 6 * (|a| + |c|) := by
    intro a c A dA p dp hA hdA hp hdp
    have e1 := abs_add_le (A * a) (p * c)
    have e2 := abs_add_le (dA * a) (dp * c)
    rw [abs_mul, abs_mul] at e1 e2
    have m1 : |A| * |a| ≤ 6 / 5 * |a| := mul_le_mul_of_nonneg_right hA (abs_nonneg a)
    have m2 : |p| * |c| ≤ 2 * |c| := mul_le_mul_of_nonneg_right hp (abs_nonneg c)
    have m3 : |dA| * |a| ≤ 1 * |a| := mul_le_mul_of_nonneg_right hdA (abs_nonneg a)
    have m4 : |dp| * |c| ≤ 4 * |c| := mul_le_mul_of_nonneg_right hdp (abs_nonneg c)
    linarith [abs_nonneg a, abs_nonneg c]
  have hsq : Real.sqrt lam ≤ 1 := by
    calc Real.sqrt lam ≤ Real.sqrt 1 := Real.sqrt_le_sqrt (by linarith)
      _ = 1 := Real.sqrt_one
  have hcb : ∀ (a c : ℝ) (η : ℝ), -1 ≤ η → η ≤ 1 → |a| + |c| ≤ lam ^ 20 / 16 →
      |Amp η * a + η * (1 + η ^ 2) * c| +
        |deriv (fun e => Amp e * a + e * (1 + e ^ 2) * c) η| ≤ lam ^ 20 := by
    intro a c η h1 h2 hac
    obtain ⟨-, hA2, hA3⟩ := hAb η h1 h2
    have hA1 : 9 / 10 ≤ Amp η := (hAb η h1 h2).1
    have hAd : DifferentiableAt ℝ Amp η :=
      (hAs.contDiffAt (Ioo_mem_nhds (by linarith) (by linarith))).differentiableAt (by simp)
    have hD : HasDerivAt (fun e => Amp e * a + e * (1 + e ^ 2) * c)
        (deriv Amp η * a + (1 + 3 * η ^ 2) * c) η :=
      (hAd.hasDerivAt.mul_const a).add ((hpoly η).mul_const c)
    rw [hD.deriv]
    have hη2 : η ^ 2 ≤ 1 := by nlinarith
    have hηa : |η| ≤ 1 := abs_le.mpr ⟨h1, h2⟩
    have hp : |η * (1 + η ^ 2)| ≤ 2 := by
      rw [abs_mul, abs_of_pos (by positivity : (0:ℝ) < 1 + η ^ 2)]
      nlinarith [mul_le_mul_of_nonneg_right hηa (by positivity : (0:ℝ) ≤ 1 + η ^ 2)]
    have hdp : |1 + 3 * η ^ 2| ≤ 4 := by
      rw [abs_of_pos (by positivity)]; linarith
    have hAabs : |Amp η| ≤ 6 / 5 := abs_le.mpr ⟨by linarith, hA2⟩
    have := hkey a c (Amp η) (deriv Amp η) (η * (1 + η ^ 2)) (1 + 3 * η ^ 2) hAabs
      (le_trans hA3 hsq) hp hdp
    linarith
  have hregF := hreg Lh Amp (fun e => Amp e * α1 + e * (1 + e ^ 2) * γ1)
    (fun e => Amp e * α2 + e * (1 + e ^ 2) * γ2) g hLh
  refine ⟨RfpPar.mk Md Pst lam h ρ T1 Lh Amp (fun e => Amp e * α1 + e * (1 + e ^ 2) * γ1)
    (fun e => Amp e * α2 + e * (1 + e ^ 2) * γ2) g, rfl, rfl, rfl, rfl, rfl, rfl, hregF, ?_⟩
  unfold RfpClos
  refine ⟨hAs, hc_s α1 γ1, hc_s α2 γ2, hgs.contDiffOn, ?_, ?_, hg0, ?_⟩
  · intro η h1 h2
    obtain ⟨hA1, hA2, hA3⟩ := hAb η h1 h2
    exact ⟨hA1, hA2, hA3,
      hcb α1 γ1 η h1 h2 (by linarith [abs_nonneg α2, abs_nonneg γ2]),
      hcb α2 γ2 η h1 h2 (by linarith [abs_nonneg α1, abs_nonneg γ1])⟩
  · intro η _ _
    exact ⟨hgb' η, fun y => hgψ _ hψ2 η y⟩
  · intro η h1 h2
    refine ⟨(hMJ Amp η).1, (hMJ Amp η).2, ?_, hT η h1 h2, hIP2 η h1 h2⟩
    have hU := rfp_S_U2_rep _ hregF η
    have hF := rfp_S_F2_rep _ hregF η (fun y => hgψ _ hψ2 η y)
    rw [integral_sub hU.1 hF.1, hU.2, hF.2]
    have hid' := hid (Amp η) η
    rw [hAroot η (by linarith) (by linarith), mul_zero] at hid'
    have eLam : rfpLam (RfpPar.mk Md Pst lam h ρ T1 Lh Amp (fun e => Amp e * α1 + e * (1 + e ^ 2) * γ1)
        (fun e => Amp e * α2 + e * (1 + e ^ 2) * γ2) g) =
        rfpLam (RfpPar.mk Md Pst lam h ρ T1 Lh 0 0 0 g) := rfl
    have eTh : rfpTh (RfpPar.mk Md Pst lam h ρ T1 Lh Amp (fun e => Amp e * α1 + e * (1 + e ^ 2) * γ1)
        (fun e => Amp e * α2 + e * (1 + e ^ 2) * γ2) g) =
        rfpTh (RfpPar.mk Md Pst lam h ρ T1 Lh 0 0 0 g) := rfl
    have ePsi : rfpPsi (RfpPar.mk Md Pst lam h ρ T1 Lh Amp (fun e => Amp e * α1 + e * (1 + e ^ 2) * γ1)
        (fun e => Amp e * α2 + e * (1 + e ^ 2) * γ2) g) =
        rfpPsi (RfpPar.mk Md Pst lam h ρ T1 Lh 0 0 0 g) := rfl
    dsimp only at hid' ⊢
    rw [eLam, eTh, ePsi]
    linear_combination hid'.symm

theorem rfp_inner_patch : ∀ P : RfpPar, RfpRegime P → (∀ x η : ℝ, 0 < x → x ≤ 1 → -1 < η → η < 1 → rfpU P x η = 4 * η ∧ rfpF P x η = refFin P.Pst 1 x η) ∧ (∀ x η : ℝ, ((rfpXk P 24 ≤ x ∧ x ≤ rfpXk P 21) ∨ (rfpXk P 19 ≤ x ∧ x ≤ rfpXk P 16) ∨ (rfpXk P 13 ≤ x ∧ x ≤ rfpXk P 10) ∨ (rfpXk P 7 ≤ x ∧ x ≤ rfpXk P 4)) → -1 < η → η < 1 → rfpU P x η = 0 ∧ Real.sqrt (2 * x) * rfpF P x η = rfpCp P * (1 + η ^ 2)⁻¹ * x ^ (-(1 / 2 + P.lam))) :=
by
  intro P hR
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hR
  have sig0 : ∀ y : ℝ, y ≤ 0 → sigA y = 0 := fun y hy => by unfold sigA; simp [hy]
  have sig1 : ∀ y : ℝ, 1 ≤ y → sigA y = 1 := fun y hy => by
    unfold sigA; rw [if_neg (by linarith), if_pos hy]
  have hl2 : P.lam ^ 2 ≤ 1 / 10000 := by nlinarith
  have hh1 : P.h ≤ 1 := by linarith
  have hρ1 : P.ρ < 1 := by linarith
  have hlogh : 0 ≤ Real.log (1 / P.h) :=
    Real.log_nonneg (by rw [le_div_iff₀ hh0]; linarith)
  have hT0 : 0 ≤ P.T1 := by linarith
  have hL : 1 / 2 < Real.log (1 / P.lam) := by
    have h2 : (2:ℝ) ≤ 1 / P.lam := by rw [le_div_iff₀ hl0]; linarith
    have := Real.log_le_log (by norm_num) h2
    linarith [Real.log_two_gt_d9]
  have h13 : 1300 ≤ 13 / P.lam := by rw [le_div_iff₀ hl0]; linarith
  have hexpMd : P.Md + 1 ≤ Real.exp P.Md := Real.add_one_le_exp P.Md
  have hPst0 : 0 < P.Pst := lt_trans (Real.exp_pos _) hPst
  have eY2 : rfpY2 P.Md = Real.exp P.Md + 11 := rfl
  have eY3 : rfpY3 P.Md P.lam = rfpY2 P.Md + 1 + 60 * Real.log (1 / P.lam) := rfl
  have eY4 : rfpY4 P.Md P.lam = rfpY3 P.Md P.lam + 13 / P.lam := rfl
  have eY5 : rfpY5 P.Md P.lam = rfpY4 P.Md P.lam + 60 + 30 * Real.log (1 / P.lam) := rfl
  have eYb : rfpYb P.Md P.lam P.T1 P.Lh = rfpY5 P.Md P.lam + 2 + P.T1 + P.Lh + 3 := rfl

  have hmeas : Measurable sigA := by
    have e : sigA = fun y : ℝ => if y ≤ 0 then 0 else if 1 ≤ y then 1 else
        Real.exp (-1 / y ^ 2) / (Real.exp (-1 / y ^ 2) + Real.exp (-1 / (1 - y) ^ 2)) := by
      funext y; rfl
    rw [e]
    refine Measurable.ite (measurableSet_le measurable_id measurable_const) measurable_const
      (Measurable.ite (measurableSet_le measurable_const measurable_id) measurable_const ?_)
    fun_prop
  have hbd : ∀ y : ℝ, |sigA y| ≤ 1 := by
    intro y
    unfold sigA
    split_ifs
    · simp
    · simp
    · have ha := Real.exp_pos (-1 / y ^ 2)
      have hb := Real.exp_pos (-1 / (1 - y) ^ 2)
      rw [abs_of_nonneg (div_nonneg ha.le (by linarith)), div_le_one (by linarith)]
      linarith
  have hint : ∀ a b : ℝ, IntervalIntegrable sigA MeasureTheory.volume a b := fun a b =>
    (intervalIntegrable_const (c := (1:ℝ))).mono_fun hmeas.aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => by simpa using hbd y)
  have hS0 : ∀ t : ℝ, t ≤ 0 → rfpSigI t = 0 := by
    intro t ht
    unfold rfpSigI
    rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ))]
    · simp
    · intro v hv
      rw [Set.uIcc_of_ge ht] at hv
      exact sig0 v hv.2
  have hSdiff : ∀ s t : ℝ, 1 ≤ s → s ≤ t → rfpSigI t - rfpSigI s = t - s := by
    intro s t hs hst
    unfold rfpSigI
    rw [intervalIntegral.integral_interval_sub_left (hint 0 t) (hint 0 s)]
    rw [intervalIntegral.integral_congr (g := fun _ => (1:ℝ))]
    · simp
    · intro v hv
      rw [Set.uIcc_of_le hst] at hv
      exact sig1 v (le_trans hs hv.1)

  have htail : ∀ y : ℝ, y ≤ rfpY4 P.Md P.lam →
      Real.log (tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) / (1 - P.ρ)) = 0 := by
    intro y hy
    unfold tailFac
    rw [← Real.exp_sub, Real.log_exp, sig0 _ (by rw [eYb, eY5]; linarith)]
    rw [show 1 - P.ρ * (1 - 0) = 1 - P.ρ by ring, div_self (by linarith), Real.log_one]
  have hLam : ∀ y : ℝ, y ≤ rfpY4 P.Md P.lam →
      rfpLam P y = Real.log P.Pst + y / 10 - 3 / 5 * rfpSigI y - P.lam * rfpSigI (y - rfpY2 P.Md) := by
    intro y hy
    unfold rfpLam
    rw [hS0 (y - rfpY5 P.Md P.lam) (by rw [eY5]; linarith),
      hS0 (y - rfpY5 P.Md P.lam - 1 - P.T1) (by rw [eY5]; linarith),
      sig0 ((y - rfpY4 P.Md P.lam) / 60) (by linarith), htail y hy]
    ring
  have hbmp : ∀ t : ℝ, t ≤ -(3 / 20) → rfpBmp t = 0 := by
    intro t ht
    unfold rfpBmp
    have e : t / (3 / 20) = 20 / 3 * t := by ring
    rw [sig0 (1 + t / (3 / 20)) (by rw [e]; linarith)]
    ring
  have hE : ∀ y η : ℝ, y ≤ rfpY3 P.Md P.lam →
      rfpE P y η = Real.exp (rfpLam P y) * (1 + η ^ 2)⁻¹ ∧ rfpRb P y η = 0 := by
    intro y η hy
    have hTh : rfpTh P y = 1 := by
      unfold rfpTh
      rw [sig0 _ (by rw [eY4]; linarith)]
      ring
    have hPsi : rfpPsi P y = 0 := by
      unfold rfpPsi
      rw [hbmp _ (by rw [eY5, eY4]; linarith), hbmp _ (by rw [eY5, eY4]; linarith)]
      ring
    have hR0 : rfpR0 (P.lam * (y - rfpY3 P.Md P.lam)) = 0 := by
      have hξ : P.lam * (y - rfpY3 P.Md P.lam) ≤ 0 := by nlinarith
      unfold rfpR0
      rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ))]
      · simp
      · intro v hv
        rw [Set.uIcc_of_ge hξ] at hv
        exact sig0 _ (by linarith [hv.2])
    refine ⟨?_, ?_⟩
    · unfold rfpE
      rw [hTh, hPsi, Real.rpow_one]
      simp
    · unfold rfpRb
      rw [hR0, hbmp _ (by rw [eY4]; linarith), hbmp _ (by rw [eY4]; linarith)]
      ring
  refine ⟨?_, ?_⟩
  · intro x η hx0 hx1 h1 h2
    have hy : Real.log x ≤ 0 := Real.log_nonpos hx0.le hx1
    obtain ⟨hEe, hRb⟩ := hE (Real.log x) η (by rw [eY3, eY2]; linarith [Real.exp_pos P.Md])
    refine ⟨?_, ?_⟩
    · have hK : rfpK P.Md (Real.log x) = 4 := by
        unfold rfpK; rw [if_pos (by linarith)]
      unfold rfpU
      rw [hRb, hK]; ring
    · have hΛ : rfpLam P (Real.log x) = Real.log P.Pst + Real.log x / 10 := by
        rw [hLam _ (by rw [eY4, eY3, eY2]; linarith [Real.exp_pos P.Md, div_pos (by norm_num : (0:ℝ) < 13) hl0]),
          hS0 _ hy, hS0 _ (by rw [eY2]; linarith [Real.exp_pos P.Md])]
        ring
      have hr : (x / 1) ^ (1 / 10 : ℝ) = Real.exp (Real.log x / 10) := by
        rw [div_one, Real.rpow_def_of_pos hx0]; congr 1; ring
      unfold rfpF refFin
      rw [hEe, hΛ, Real.exp_add, Real.exp_log hPst0, hr]
      ring
  · intro x η hx h1 h2
    have hb1 : Real.exp (rfpY3 P.Md P.lam - 24) ≤ x ∧ x ≤ Real.exp (rfpY3 P.Md P.lam - 4) := by
      unfold rfpXk at hx
      rcases hx with ⟨a, b⟩ | ⟨a, b⟩ | ⟨a, b⟩ | ⟨a, b⟩ <;>
        exact ⟨le_trans (Real.exp_le_exp.2 (by linarith)) a, le_trans b (Real.exp_le_exp.2 (by linarith))⟩
    have hx0 : 0 < x := lt_of_lt_of_le (Real.exp_pos _) hb1.1
    have hylo : rfpY3 P.Md P.lam - 24 ≤ Real.log x := by
      have := Real.log_le_log (Real.exp_pos _) hb1.1
      rwa [Real.log_exp] at this
    have hyhi : Real.log x ≤ rfpY3 P.Md P.lam - 4 := by
      have := Real.log_le_log hx0 hb1.2
      rwa [Real.log_exp] at this
    obtain ⟨hEe, hRb⟩ := hE (Real.log x) η (by linarith)
    have hMdlog : Real.exp P.Md ≤ Real.log x := by rw [eY3, eY2] at hylo; linarith
    refine ⟨?_, ?_⟩
    · have hK : rfpK P.Md (Real.log x) = 0 := by
        unfold rfpK
        rw [if_neg (by linarith)]
        have hlog : P.Md ≤ Real.log (Real.log x) := by
          have := Real.log_le_log (Real.exp_pos P.Md) hMdlog
          rwa [Real.log_exp] at this
        rw [sig1 _ (by rw [le_div_iff₀ hMd]; linarith)]
        ring
      unfold rfpU
      rw [hRb, hK]; ring
    · have hsq : 0 < Real.sqrt (2 * x) := Real.sqrt_pos.2 (by linarith)
      have hΛ : rfpLam P (Real.log x) = rfpLam P (rfpY2 P.Md + 1) -
          (1 / 2 + P.lam) * (Real.log x - (rfpY2 P.Md + 1)) := by
        have hy4 : Real.log x ≤ rfpY4 P.Md P.lam := by
          rw [eY4]; linarith [div_pos (by norm_num : (0:ℝ) < 13) hl0]
        have hlo : rfpY2 P.Md + 1 ≤ Real.log x := by rw [eY3] at hylo; linarith
        have e1 := hLam (Real.log x) hy4
        have e2 := hLam (rfpY2 P.Md + 1) (by linarith)
        have d1 := hSdiff (rfpY2 P.Md + 1) (Real.log x) (by rw [eY2]; linarith [Real.exp_pos P.Md]) hlo
        have d2 := hSdiff 1 (Real.log x - rfpY2 P.Md) le_rfl (by linarith)
        rw [show rfpY2 P.Md + 1 - rfpY2 P.Md = 1 by ring] at e2
        rw [e1, e2]
        linear_combination (-3 / 5) * d1 - P.lam * d2
      rw [show Real.sqrt (2 * x) * rfpF P x η = rfpE P (Real.log x) η by
        unfold rfpF; field_simp]
      rw [hEe, hΛ, Real.rpow_def_of_pos hx0]
      unfold rfpCp
      rw [show rfpLam P (rfpY2 P.Md + 1) - (1 / 2 + P.lam) * (Real.log x - (rfpY2 P.Md + 1)) =
          (rfpLam P (rfpY2 P.Md + 1) + (1 / 2 + P.lam) * (rfpY2 P.Md + 1)) +
            Real.log x * (-(1 / 2 + P.lam)) by ring, Real.exp_add]
      ring

theorem rfp_tail_collar : ∀ P : RfpPar, RfpRegime P → (∀ x η : ℝ, rfpXb P * Real.exp (-3) ≤ x → -1 < η → η < 1 → Real.sqrt (2 * x) * rfpF P x η = rfpCi P * x ^ (-(1 / 2 + P.h)) * tailFac P.ρ (rfpXb P) x) ∧ (∀ x η : ℝ, rfpXb P * Real.exp (-(11 / 4)) ≤ x → x < rfpXb P → -1 < η → η < 1 → Real.sqrt (2 * x) * rfpF P x η ≤ Real.exp (rfpL5 P.Md P.Pst P.lam - 3 / 2 * P.T1) / (1 - P.ρ)) :=
by
  intro P hR
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hR

  have hl2 : P.lam ^ 2 ≤ 1 / 10000 := by nlinarith
  have hhlam : P.h ≤ P.lam := by nlinarith
  have hρ1 : P.ρ < 1 := by linarith
  have h1ρ : 0 < 1 - P.ρ := by linarith
  have hlogh : 0 ≤ Real.log (1 / P.h) :=
    Real.log_nonneg (by rw [le_div_iff₀ hh0]; linarith)
  have hT0 : 0 ≤ P.T1 := by linarith
  have hL : 0 ≤ Real.log (1 / P.lam) :=
    Real.log_nonneg (by rw [le_div_iff₀ hl0]; linarith)
  have hexpMd : 0 < Real.exp P.Md := Real.exp_pos _
  have hlam13 : 0 < 13 / P.lam := by positivity
  have eY2 : rfpY2 P.Md = Real.exp P.Md + 11 := rfl
  have eY3 : rfpY3 P.Md P.lam = rfpY2 P.Md + 1 + 60 * Real.log (1 / P.lam) := rfl
  have eY4 : rfpY4 P.Md P.lam = rfpY3 P.Md P.lam + 13 / P.lam := rfl
  have eY5 : rfpY5 P.Md P.lam = rfpY4 P.Md P.lam + 60 + 30 * Real.log (1 / P.lam) := rfl
  obtain ⟨yb, hyb⟩ : ∃ yb : ℝ, yb = rfpYb P.Md P.lam P.T1 P.Lh := ⟨_, rfl⟩
  have eYb : yb = rfpY5 P.Md P.lam + 2 + P.T1 + P.Lh + 3 := by rw [hyb]; rfl
  have hXb : rfpXb P = Real.exp yb := by rw [hyb]; rfl

  have sig0 : ∀ y : ℝ, y ≤ 0 → sigA y = 0 := fun y hy => by unfold sigA; simp [hy]
  have sig1 : ∀ y : ℝ, 1 ≤ y → sigA y = 1 := fun y hy => by
    unfold sigA; rw [if_neg (by linarith), if_pos hy]
  have sigR : ∀ y : ℝ, 0 ≤ sigA y ∧ sigA y ≤ 1 := by
    intro y
    unfold sigA
    split_ifs
    · norm_num
    · norm_num
    · have ha := Real.exp_pos (-1 / y ^ 2)
      have hb := Real.exp_pos (-1 / (1 - y) ^ 2)
      exact ⟨div_nonneg ha.le (by linarith), (div_le_one (by linarith)).2 (by linarith)⟩
  have sigM : Measurable sigA := by
    unfold sigA
    refine Measurable.ite (measurableSet_le measurable_id measurable_const) measurable_const
      (Measurable.ite (measurableSet_le measurable_const measurable_id) measurable_const ?_)
    fun_prop
  have sigInt : ∀ a b : ℝ, IntervalIntegrable sigA MeasureTheory.volume a b := by
    intro a b
    refine (intervalIntegrable_const (c := (1:ℝ))).mono_fun' sigM.aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall (fun x => by
      show ‖sigA x‖ ≤ 1
      rw [Real.norm_eq_abs, abs_le]; constructor <;> linarith [(sigR x).1, (sigR x).2])
  have hI1 : ∀ t : ℝ, 1 ≤ t → rfpSigI t = rfpSigI 1 + (t - 1) := by
    intro t ht
    unfold rfpSigI
    rw [← intervalIntegral.integral_add_adjacent_intervals (sigInt 0 1) (sigInt 1 t)]
    congr 1
    rw [intervalIntegral.integral_congr (g := fun _ => (1:ℝ))]
    · simp
    · intro s hs
      rw [Set.uIcc_of_le ht] at hs
      exact sig1 s hs.1
  have hS1 : rfpSigI 1 ≤ 1 := by
    unfold rfpSigI
    have := intervalIntegral.integral_mono_on (zero_le_one' ℝ) (sigInt 0 1)
      (intervalIntegrable_const (c := (1:ℝ))) (fun x _ => (sigR x).2)
    simpa using this
  have tauR : ∀ a b : ℝ, 1 - P.ρ ≤ tailFac P.ρ a b ∧ tailFac P.ρ a b ≤ 1 := by
    intro a b
    unfold tailFac
    obtain ⟨s0, s1⟩ := sigR ((Real.log (b / a) + 2) / 2)
    constructor <;> nlinarith

  obtain ⟨C0, hC0⟩ : ∃ C0 : ℝ, C0 = Real.log P.Pst - 3 / 5 * (rfpSigI 1 - 1)
      - P.lam * (rfpSigI 1 - rfpY2 P.Md - 1) - (1 - P.lam) * (rfpSigI 1 - rfpY5 P.Md P.lam - 1)
      + (1 - P.h) * (rfpSigI 1 - rfpY5 P.Md P.lam - 2 - P.T1) - Real.log 2 := ⟨_, rfl⟩
  have hΛ : ∀ y : ℝ, yb - 3 ≤ y → rfpLam P y = C0 - (1 / 2 + P.h) * y +
      Real.log (tailFac P.ρ (Real.exp yb) (Real.exp y) / (1 - P.ρ)) := by
    intro y hy
    have a1 : 1 ≤ y := by linarith
    have a2 : 1 ≤ y - rfpY2 P.Md := by linarith
    have a3 : 1 ≤ y - rfpY5 P.Md P.lam := by linarith
    have a4 : 1 ≤ y - rfpY5 P.Md P.lam - 1 - P.T1 := by linarith
    have a5 : 1 ≤ (y - rfpY4 P.Md P.lam) / 60 := by
      rw [le_div_iff₀ (by norm_num)]; linarith
    unfold rfpLam
    rw [← hyb, hI1 y a1, hI1 _ a2, hI1 _ a3, hI1 _ a4, sig1 _ a5, hC0]
    ring
  have hτT : tailFac P.ρ (Real.exp yb) (Real.exp (yb - 3)) = 1 - P.ρ := by
    unfold tailFac
    rw [← Real.exp_sub, Real.log_exp, sig0 ((yb - 3 - yb + 2) / 2) (by linarith)]
    ring
  have hTh : ∀ y : ℝ, yb - 3 ≤ y → rfpTh P y = 0 := by
    intro y hy
    unfold rfpTh
    rw [sig1 ((y - rfpY4 P.Md P.lam) / 60) (by rw [le_div_iff₀ (by norm_num)]; linarith)]
    ring
  have hPsi : ∀ y : ℝ, yb - 3 ≤ y → rfpPsi P y = 0 := by
    intro y hy
    unfold rfpPsi rfpBmp
    rw [sig0 (1 - (y - rfpY5 P.Md P.lam + 3) / (3 / 20))
        (by rw [sub_nonpos, le_div_iff₀ (by norm_num)]; linarith),
      sig0 (1 - (y - rfpY5 P.Md P.lam + 1) / (3 / 20))
        (by rw [sub_nonpos, le_div_iff₀ (by norm_num)]; linarith)]
    ring
  have hE : ∀ x η : ℝ, 0 < x → yb - 3 ≤ Real.log x →
      Real.sqrt (2 * x) * rfpF P x η = Real.exp (rfpLam P (Real.log x)) := by
    intro x η hx hy
    have hs : Real.sqrt (2 * x) ≠ 0 := (Real.sqrt_pos.2 (by linarith)).ne'
    unfold rfpF rfpE
    rw [hTh _ hy, hPsi _ hy, Real.rpow_zero, mul_zero, add_zero, Real.sqrt_one, mul_one, mul_one]
    field_simp
  have hCi : rfpCi P = Real.exp C0 / (1 - P.ρ) := by
    unfold rfpCi
    rw [← hyb, hΛ (yb - 3) le_rfl, hτT, div_self h1ρ.ne', Real.log_one]
    have e : C0 - (1 / 2 + P.h) * (yb - 3) + 0 + (1 / 2 + P.h) * (yb - 3) = C0 := by ring
    rw [e]
  refine ⟨?_, ?_⟩
  · intro x η hx _ _
    rw [hXb] at hx ⊢
    rw [← Real.exp_add] at hx
    have hxpos : 0 < x := lt_of_lt_of_le (Real.exp_pos _) hx
    have hy : yb - 3 ≤ Real.log x := by
      have := Real.log_le_log (Real.exp_pos _) hx
      rw [Real.log_exp] at this
      linarith
    rw [hE x η hxpos hy, hΛ _ hy, Real.exp_log hxpos, hCi, Real.rpow_def_of_pos hxpos]
    obtain ⟨t0, _⟩ := tauR (Real.exp yb) x
    have hq : 0 < tailFac P.ρ (Real.exp yb) x / (1 - P.ρ) := div_pos (by linarith) h1ρ
    rw [Real.exp_add, Real.exp_log hq]
    have e : Real.exp (C0 - (1 / 2 + P.h) * Real.log x) =
        Real.exp C0 * Real.exp (Real.log x * -(1 / 2 + P.h)) := by
      rw [← Real.exp_add]; congr 1; ring
    rw [e]
    ring
  · intro x η hx _ _ _
    rw [hXb, ← Real.exp_add] at hx
    have hxpos : 0 < x := lt_of_lt_of_le (Real.exp_pos _) hx
    have hy' : yb - 11 / 4 ≤ Real.log x := by
      have := Real.log_le_log (Real.exp_pos _) hx
      rw [Real.log_exp] at this
      linarith
    have hy : yb - 3 ≤ Real.log x := by linarith
    rw [hE x η hxpos hy, hΛ _ hy, Real.exp_log hxpos]
    obtain ⟨t0, t1⟩ := tauR (Real.exp yb) x
    have hq : 0 < tailFac P.ρ (Real.exp yb) x / (1 - P.ρ) := div_pos (by linarith) h1ρ
    rw [Real.exp_add, Real.exp_log hq]
    have hM : C0 - (1 / 2 + P.h) * Real.log x ≤ rfpL5 P.Md P.Pst P.lam - 3 / 2 * P.T1 := by
      have e5 : rfpL5 P.Md P.Pst P.lam = Real.log P.Pst + rfpY5 P.Md P.lam / 10
          - 3 / 5 * (rfpSigI 1 + (rfpY5 P.Md P.lam - 1))
          - P.lam * (rfpSigI 1 + (rfpY5 P.Md P.lam - rfpY2 P.Md - 1)) - Real.log 2 := by
        unfold rfpL5
        rw [hI1 (rfpY5 P.Md P.lam) (by linarith),
          hI1 (rfpY5 P.Md P.lam - rfpY2 P.Md) (by linarith)]
      rw [e5, hC0]
      have hd : rfpY5 P.Md P.lam + 9 / 4 + P.T1 ≤ Real.log x := by linarith
      have hA : 0 ≤ 1 / 2 + P.h := by linarith
      nlinarith [mul_le_mul_of_nonneg_left hd hA,
        mul_nonpos_of_nonneg_of_nonpos (sub_nonneg.2 hhlam) (sub_nonpos.2 hS1)]
    rw [mul_div_assoc']
    refine (div_le_div_iff_of_pos_right h1ρ).2 ?_
    refine le_trans (mul_le_mul_of_nonneg_left t1 (Real.exp_pos _).le) ?_
    rw [mul_one]
    exact Real.exp_le_exp.2 hM

theorem rfp_leadPi_identity : ∀ P : RfpPar, RfpRegime P → RfpClos P → ∀ η : ℝ, -1 < η → η < 1 → leadPi (rfpF P) 0 η = shapeDatum (fun y => Real.exp (rfpLam P y)) (rfpTh P) η :=
by
  intro P hR hC η h1 h2
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hR
  obtain ⟨-, -, -, -, -, hca, -, -⟩ := hC

  obtain ⟨q, hq_def⟩ : ∃ q : ℝ → ℝ, q = fun y => expNegInvGlue (y * |y|) := ⟨_, rfl⟩
  have hqC : Continuous q := by
    rw [hq_def]
    exact (expNegInvGlue.contDiff (n := 0)).continuous.comp (continuous_id.mul continuous_abs)
  have qpos_arg : ∀ y : ℝ, 0 < y → 0 < y * |y| := fun y hy => by
    rw [abs_of_pos hy]; exact mul_pos hy hy
  have qa : ∀ y : ℝ, y ≤ 0 → q y = 0 := fun y hy => by
    rw [hq_def]
    exact expNegInvGlue.zero_of_nonpos (mul_nonpos_of_nonpos_of_nonneg hy (abs_nonneg y))
  have qb : ∀ y : ℝ, 0 < y → 0 < q y := fun y hy => by
    rw [hq_def]
    exact expNegInvGlue.pos_of_pos (qpos_arg y hy)
  have qc : ∀ y : ℝ, 0 ≤ q y := fun y => by
    rw [hq_def]
    exact expNegInvGlue.nonneg _
  have qd : ∀ y : ℝ, 0 < y → q y = Real.exp (-1 / y ^ 2) := by
    intro y hy
    rw [hq_def]
    show expNegInvGlue (y * |y|) = _
    rw [expNegInvGlue, if_neg (not_le.mpr (qpos_arg y hy)), abs_of_pos hy]
    congr 1
    rw [neg_div, one_div, sq]
  have hDpos : ∀ y : ℝ, 0 < q y + q (1 - y) := by
    intro y
    by_cases hy : 0 < y
    · exact add_pos_of_pos_of_nonneg (qb y hy) (qc _)
    · exact add_pos_of_nonneg_of_pos (qc y) (qb _ (by linarith [not_lt.mp hy]))
  have heq : sigA = fun y => q y / (q y + q (1 - y)) := by
    funext y
    unfold sigA
    split_ifs with hh1 hh2
    · rw [qa y hh1, zero_div]
    · have hy : 0 < y := not_le.mp hh1
      rw [qa (1 - y) (by linarith), add_zero, div_self (qb y hy).ne']
    · have hy : 0 < y := not_le.mp hh1
      rw [qd y hy, qd (1 - y) (by linarith [not_le.mp hh2])]
  have sigC : Continuous sigA := by
    rw [heq]
    exact hqC.div (hqC.add (hqC.comp (continuous_const.sub continuous_id)))
      (fun y => (hDpos y).ne')
  have sig0 : ∀ y : ℝ, y ≤ 0 → sigA y = 0 := fun y hy => by unfold sigA; simp [hy]
  have sig1 : ∀ y : ℝ, 1 ≤ y → sigA y = 1 := fun y hy => by
    unfold sigA; rw [if_neg (by linarith), if_pos hy]
  have sigNN : ∀ y : ℝ, 0 ≤ sigA y := fun y => by
    rw [heq]
    show 0 ≤ q y / (q y + q (1 - y))
    exact div_nonneg (qc y) (hDpos y).le

  have bmpC : Continuous rfpBmp := by
    have e : rfpBmp = fun t => sigA (1 + t / (3 / 20)) * sigA (1 - t / (3 / 20)) := rfl
    rw [e]
    exact (sigC.comp (continuous_const.add (continuous_id.div_const _))).mul
      (sigC.comp (continuous_const.sub (continuous_id.div_const _)))
  have bmp0 : ∀ t : ℝ, 3 / 20 ≤ |t| → rfpBmp t = 0 := by
    intro t ht
    unfold rfpBmp
    rcases le_abs'.mp ht with h | h
    · have : t / (3 / 20) ≤ -1 := by rw [div_le_iff₀ (by norm_num)]; linarith
      rw [sig0 (1 + t / (3 / 20)) (by linarith), zero_mul]
    · have : 1 ≤ t / (3 / 20) := by rw [le_div_iff₀ (by norm_num)]; linarith
      rw [sig0 (1 - t / (3 / 20)) (by linarith), mul_zero]
  have bmp1 : rfpBmp 0 = 1 := by
    unfold rfpBmp
    rw [show (1 : ℝ) + 0 / (3 / 20) = 1 by norm_num, show (1 : ℝ) - 0 / (3 / 20) = 1 by norm_num,
      sig1 1 le_rfl]
    norm_num
  have bmpNN : ∀ t : ℝ, 0 ≤ rfpBmp t := fun t => by
    unfold rfpBmp; exact mul_nonneg (sigNN _) (sigNN _)

  have hl2 : P.lam ^ 2 ≤ 1 / 10000 := by nlinarith
  have hρ1 : P.ρ < 1 := by linarith
  have SigC : Continuous rfpSigI := by
    have e : rfpSigI = fun t => ∫ s in (0:ℝ)..t, sigA s := rfl
    rw [e]
    exact intervalIntegral.continuous_primitive (fun a b => sigC.intervalIntegrable a b) 0
  have tailC : Continuous (fun y => tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh))
      (Real.exp y) / (1 - P.ρ)) := by
    unfold tailFac
    have hlog : Continuous (fun y => Real.log (Real.exp y / Real.exp (rfpYb P.Md P.lam P.T1 P.Lh))) :=
      (Real.continuous_exp.div_const _).log
        (fun y => (div_pos (Real.exp_pos _) (Real.exp_pos _)).ne')
    exact (continuous_const.sub (continuous_const.mul (continuous_const.sub
      (sigC.comp ((hlog.add continuous_const).div_const _))))).div_const _
  have tailNZ : ∀ y : ℝ, tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh))
      (Real.exp y) / (1 - P.ρ) ≠ 0 := by
    intro y
    unfold tailFac
    have key : ∀ s : ℝ, 0 ≤ s → 0 < 1 - P.ρ * (1 - s) := fun s hs => by nlinarith
    exact div_ne_zero (key _ (sigNN _)).ne' (by linarith)
  have lamC : Continuous (rfpLam P) := by
    have e : rfpLam P = fun y => Real.log P.Pst + y / 10 - 3 / 5 * rfpSigI y
        - P.lam * rfpSigI (y - rfpY2 P.Md)
        - (1 - P.lam) * rfpSigI (y - rfpY5 P.Md P.lam)
        + (1 - P.h) * rfpSigI (y - rfpY5 P.Md P.lam - 1 - P.T1)
        - sigA ((y - rfpY4 P.Md P.lam) / 60) * Real.log 2
        + Real.log (tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) / (1 - P.ρ)) :=
      rfl
    rw [e]
    refine Continuous.add ?_ (tailC.log tailNZ)
    refine Continuous.sub ?_ ((sigC.comp ((continuous_id.sub continuous_const).div_const _)).mul
      continuous_const)
    refine Continuous.add ?_ (continuous_const.mul (SigC.comp
      (((continuous_id.sub continuous_const).sub continuous_const).sub continuous_const)))
    refine Continuous.sub ?_ (continuous_const.mul (SigC.comp (continuous_id.sub continuous_const)))
    refine Continuous.sub ?_ (continuous_const.mul (SigC.comp (continuous_id.sub continuous_const)))
    refine Continuous.sub ?_ (continuous_const.mul SigC)
    exact continuous_const.add (continuous_id.div_const _)

  have hL : 20 < 30 * Real.log (1 / P.lam) := by
    have h2' : (2:ℝ) ≤ 1 / P.lam := by rw [le_div_iff₀ hl0]; linarith
    have := Real.log_le_log (by norm_num) h2'
    linarith [Real.log_two_gt_d9]
  have e5 : rfpY5 P.Md P.lam = rfpY4 P.Md P.lam + 60 + 30 * Real.log (1 / P.lam) := rfl
  have psiTh : ∀ y : ℝ, rfpPsi P y ≠ 0 → rfpTh P y = 0 := by
    intro y hy
    have hy' : rfpY5 P.Md P.lam - 63 / 20 < y := by
      by_contra hcon
      push_neg at hcon
      apply hy
      have h3 : 3 / 20 ≤ |y - rfpY5 P.Md P.lam + 3| := by
        rw [abs_of_neg (by linarith)]; linarith
      have h4 : 3 / 20 ≤ |y - rfpY5 P.Md P.lam + 1| := by
        rw [abs_of_neg (by linarith)]; linarith
      unfold rfpPsi
      rw [bmp0 _ h3, bmp0 _ h4]; ring
    have hge : 1 ≤ (y - rfpY4 P.Md P.lam) / 60 := by
      rw [le_div_iff₀ (by norm_num)]; linarith
    unfold rfpTh
    rw [sig1 _ hge]; ring

  have wC : Continuous (fun y => Real.exp (2 * rfpLam P y)) :=
    Real.continuous_exp.comp (continuous_const.mul lamC)
  have b1C : Continuous (fun y => rfpBmp (y - rfpY5 P.Md P.lam + 3)) :=
    bmpC.comp ((continuous_id.sub continuous_const).add continuous_const)
  have b2C : Continuous (fun y => rfpBmp (y - rfpY5 P.Md P.lam + 1)) :=
    bmpC.comp ((continuous_id.sub continuous_const).add continuous_const)
  have b1S : HasCompactSupport (fun y => rfpBmp (y - rfpY5 P.Md P.lam + 3)) := by
    refine HasCompactSupport.intro
      (isCompact_Icc (a := rfpY5 P.Md P.lam - 63 / 20) (b := rfpY5 P.Md P.lam - 57 / 20)) ?_
    intro y hy
    apply bmp0
    rw [Set.mem_Icc, not_and_or, not_le, not_le] at hy
    rcases hy with hy | hy
    · rw [abs_of_neg (by linarith)]; linarith
    · rw [abs_of_pos (by linarith)]; linarith
  have b2S : HasCompactSupport (fun y => rfpBmp (y - rfpY5 P.Md P.lam + 1)) := by
    refine HasCompactSupport.intro
      (isCompact_Icc (a := rfpY5 P.Md P.lam - 23 / 20) (b := rfpY5 P.Md P.lam - 17 / 20)) ?_
    intro y hy
    apply bmp0
    rw [Set.mem_Icc, not_and_or, not_le, not_le] at hy
    rcases hy with hy | hy
    · rw [abs_of_neg (by linarith)]; linarith
    · rw [abs_of_pos (by linarith)]; linarith
  have g1I : Integrable (fun y => Real.exp (2 * rfpLam P y) * rfpBmp (y - rfpY5 P.Md P.lam + 3)) :=
    (wC.mul b1C).integrable_of_hasCompactSupport b1S.mul_left
  have g2I : Integrable (fun y => Real.exp (2 * rfpLam P y) * rfpBmp (y - rfpY5 P.Md P.lam + 1)) :=
    (wC.mul b2C).integrable_of_hasCompactSupport b2S.mul_left
  have Bpos : 0 < ∫ y, Real.exp (2 * rfpLam P y) * rfpBmp (y - rfpY5 P.Md P.lam + 1) := by
    refine Continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero
      (x := rfpY5 P.Md P.lam - 1) (wC.mul b2C) b2S.mul_left ?_ ?_
    · intro y
      exact mul_nonneg (Real.exp_pos _).le (bmpNN _)
    · show Real.exp (2 * rfpLam P (rfpY5 P.Md P.lam - 1)) *
        rfpBmp (rfpY5 P.Md P.lam - 1 - rfpY5 P.Md P.lam + 1) ≠ 0
      rw [show rfpY5 P.Md P.lam - 1 - rfpY5 P.Md P.lam + 1 = 0 by ring, bmp1, mul_one]
      exact (Real.exp_pos _).ne'
  have Heq : (fun y => Real.exp (2 * rfpLam P y) * rfpPsi P y) = fun y =>
      Real.exp (2 * rfpLam P y) * rfpBmp (y - rfpY5 P.Md P.lam + 3) -
        rfpKa P * (Real.exp (2 * rfpLam P y) * rfpBmp (y - rfpY5 P.Md P.lam + 1)) := by
    funext y; unfold rfpPsi; ring
  have HI : Integrable (fun y => Real.exp (2 * rfpLam P y) * rfpPsi P y) := by
    rw [Heq]; exact g1I.sub (g2I.const_mul _)
  have H0 : ∫ y, Real.exp (2 * rfpLam P y) * rfpPsi P y = 0 := by
    rw [Heq, integral_sub g1I (g2I.const_mul _), integral_const_mul]
    unfold rfpKa
    rw [div_mul_cancel₀ _ Bpos.ne', sub_self]

  have hf0 : 0 < (1 + η ^ 2)⁻¹ := by positivity
  have hcaψ : ∀ y, |P.ca η * rfpPsi P y| ≤ 1 / 2 := (hca η (by linarith) (by linarith)).2
  have ptw : ∀ y, Real.exp y * rfpF P (Real.exp y) η ^ 2 =
      (Real.exp (rfpLam P y) ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * rfpTh P y) +
        P.ca η * (Real.exp (2 * rfpLam P y) * rfpPsi P y)) / 2 := by
    intro y
    have hE : Real.exp y ≠ 0 := (Real.exp_pos y).ne'
    have hsq : Real.sqrt (1 + P.ca η * rfpPsi P y) ^ 2 = 1 + P.ca η * rfpPsi P y := by
      rw [Real.sq_sqrt]
      have := neg_abs_le (P.ca η * rfpPsi P y)
      linarith [hcaψ y]
    have hrp : ((1 + η ^ 2)⁻¹) ^ (2 * rfpTh P y) = (((1 + η ^ 2)⁻¹) ^ (rfpTh P y)) ^ 2 := by
      rw [mul_comm (2:ℝ) (rfpTh P y), Real.rpow_mul hf0.le, Real.rpow_two]
    have hcross : Real.exp (rfpLam P y) ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * rfpTh P y) * rfpPsi P y =
        Real.exp (2 * rfpLam P y) * rfpPsi P y := by
      by_cases hψ : rfpPsi P y = 0
      · rw [hψ]; ring
      · rw [psiTh y hψ, mul_zero, Real.rpow_zero, mul_one, sq, ← Real.exp_add, two_mul]
    have hS : Real.sqrt (2 * Real.exp y) ^ 2 = 2 * Real.exp y := Real.sq_sqrt (by positivity)
    unfold rfpF rfpE
    rw [Real.log_exp, div_pow, hS, mul_pow, mul_pow, hsq, ← hrp]
    generalize ((1 + η ^ 2)⁻¹) ^ (2 * rfpTh P y) = R at hcross ⊢
    rw [← hcross]
    field_simp

  have key : ∫ y, (Real.exp (rfpLam P y) ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * rfpTh P y) +
        P.ca η * (Real.exp (2 * rfpLam P y) * rfpPsi P y)) / 2 =
      (∫ y, Real.exp (rfpLam P y) ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * rfpTh P y)) / 2 := by
    rw [integral_div]
    congr 1
    by_cases hGI : Integrable (fun y => Real.exp (rfpLam P y) ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * rfpTh P y))
    · rw [integral_add hGI (HI.const_mul _), integral_const_mul, H0, mul_zero, add_zero]
    · have hnot : ¬ Integrable (fun y => Real.exp (rfpLam P y) ^ 2 *
          ((1 + η ^ 2)⁻¹) ^ (2 * rfpTh P y) + P.ca η * (Real.exp (2 * rfpLam P y) * rfpPsi P y)) := by
        intro hI
        apply hGI
        refine (hI.sub (HI.const_mul (P.ca η))).congr (Filter.Eventually.of_forall fun y => ?_)
        simp only [Pi.sub_apply]
        ring
      rw [integral_undef hGI, integral_undef hnot]

  have hcv := integral_comp_exp (fun x => rfpF P x η ^ 2)
  simp only [smul_eq_mul] at hcv
  unfold leadPi shapeDatum
  rw [← hcv, show (fun x => Real.exp x * rfpF P (Real.exp x) η ^ 2) = fun y =>
      (Real.exp (rfpLam P y) ^ 2 * ((1 + η ^ 2)⁻¹) ^ (2 * rfpTh P y) +
        P.ca η * (Real.exp (2 * rfpLam P y) * rfpPsi P y)) / 2 from funext ptw, key]
  ring

theorem rfp_profile_identities : ∀ P : RfpPar, RfpRegime P → RfpClos P → (1 < rfpXg P ∧ rfpXg P < rfpXg2 P ∧ rfpXg2 P < rfpXk P 24 ∧ rfpXk P 24 < rfpXk P 21 ∧ rfpXk P 21 < rfpXk P 19 ∧ rfpXk P 19 < rfpXk P 16 ∧ rfpXk P 16 < rfpXk P 13 ∧ rfpXk P 13 < rfpXk P 10 ∧ rfpXk P 10 < rfpXk P 7 ∧ rfpXk P 7 < rfpXk P 4 ∧ rfpXk P 4 < rfpXv P ∧ rfpXv P < rfpXb P * Real.exp (-3) ∧ 0 < rfpCp P ∧ 0 < rfpCi P) ∧ (∀ x η : ℝ, 0 < x → x ≤ 1 → -1 < η → η < 1 → rfpU P x η = 4 * η ∧ rfpF P x η = refFin P.Pst 1 x η) ∧ (∀ x η : ℝ, ((rfpXk P 24 ≤ x ∧ x ≤ rfpXk P 21) ∨ (rfpXk P 19 ≤ x ∧ x ≤ rfpXk P 16) ∨ (rfpXk P 13 ≤ x ∧ x ≤ rfpXk P 10) ∨ (rfpXk P 7 ≤ x ∧ x ≤ rfpXk P 4)) → -1 < η → η < 1 → rfpU P x η = 0 ∧ Real.sqrt (2 * x) * rfpF P x η = rfpCp P * (1 + η ^ 2)⁻¹ * x ^ (-(1 / 2 + P.lam))) ∧ (∀ x η : ℝ, rfpXv P ≤ x → -1 < η → η < 1 → rfpU P x η = 0 ∧ profRadInt (rfpU P) x η = 0) ∧ (∀ x η : ℝ, rfpXb P * Real.exp (-3) ≤ x → -1 < η → η < 1 → Real.sqrt (2 * x) * rfpF P x η = rfpCi P * x ^ (-(1 / 2 + P.h)) * tailFac P.ρ (rfpXb P) x) ∧ ShapeData P.Pst (fun y => Real.exp (rfpLam P y)) (rfpTh P) ∧ (∀ η : ℝ, -1 < η → η < 1 → leadPi (rfpF P) 0 η = shapeDatum (fun y => Real.exp (rfpLam P y)) (rfpTh P) η) ∧ (∀ x η : ℝ, rfpXb P * Real.exp (-(11 / 4)) ≤ x → x < rfpXb P → -1 < η → η < 1 → Real.sqrt (2 * x) * rfpF P x η ≤ Real.exp (rfpL5 P.Md P.Pst P.lam - 3 / 2 * P.T1) / (1 - P.ρ)) ∧ (∀ x η : ℝ, 0 < x → -2 < η → η < 2 → 0 < rfpF P x η) :=
by
  intro P hR hC
  have hR' : RfpRegime P := hR
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hR
  have sig0 : ∀ y : ℝ, y ≤ 0 → sigA y = 0 := fun y hy => by unfold sigA; simp [hy]
  have sig1 : ∀ y : ℝ, 1 ≤ y → sigA y = 1 := fun y hy => by
    unfold sigA; rw [if_neg (by linarith), if_pos hy]
  have hl2 : P.lam ^ 2 ≤ 1 / 10000 := by nlinarith
  have hh1 : P.h ≤ 1 := by linarith
  have hρ1 : P.ρ < 1 := by linarith
  have hlogh : 0 ≤ Real.log (1 / P.h) :=
    Real.log_nonneg (by rw [le_div_iff₀ hh0]; linarith)
  have hT0 : 0 ≤ P.T1 := by linarith
  have hL : 1 / 2 < Real.log (1 / P.lam) := by
    have h2 : (2:ℝ) ≤ 1 / P.lam := by rw [le_div_iff₀ hl0]; linarith
    have := Real.log_le_log (by norm_num) h2
    linarith [Real.log_two_gt_d9]
  have hexpMd : 0 < Real.exp P.Md := Real.exp_pos _
  have hlam13 : 0 < 13 / P.lam := by positivity
  have eY2 : rfpY2 P.Md = Real.exp P.Md + 11 := rfl
  have eY3 : rfpY3 P.Md P.lam = rfpY2 P.Md + 1 + 60 * Real.log (1 / P.lam) := rfl
  have eY4 : rfpY4 P.Md P.lam = rfpY3 P.Md P.lam + 13 / P.lam := rfl
  have eY5 : rfpY5 P.Md P.lam = rfpY4 P.Md P.lam + 60 + 30 * Real.log (1 / P.lam) := rfl
  have eYb : rfpYb P.Md P.lam P.T1 P.Lh = rfpY5 P.Md P.lam + 2 + P.T1 + P.Lh + 3 := rfl

  have hord : 1 < rfpXg P ∧ rfpXg P < rfpXg2 P ∧ rfpXg2 P < rfpXk P 24 ∧ rfpXk P 24 < rfpXk P 21 ∧
      rfpXk P 21 < rfpXk P 19 ∧ rfpXk P 19 < rfpXk P 16 ∧ rfpXk P 16 < rfpXk P 13 ∧
      rfpXk P 13 < rfpXk P 10 ∧ rfpXk P 10 < rfpXk P 7 ∧ rfpXk P 7 < rfpXk P 4 ∧
      rfpXk P 4 < rfpXv P ∧ rfpXv P < rfpXb P * Real.exp (-3) ∧ 0 < rfpCp P ∧ 0 < rfpCi P := by
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · have := Real.add_one_le_exp (rfpY2 P.Md + 1)
      unfold rfpXg; rw [eY2] at this ⊢; linarith
    · unfold rfpXg rfpXg2; exact Real.exp_lt_exp.2 (by linarith)
    · unfold rfpXg2 rfpXk; exact Real.exp_lt_exp.2 (by rw [eY3]; linarith)
    · unfold rfpXk; exact Real.exp_lt_exp.2 (by linarith)
    · unfold rfpXk; exact Real.exp_lt_exp.2 (by linarith)
    · unfold rfpXk; exact Real.exp_lt_exp.2 (by linarith)
    · unfold rfpXk; exact Real.exp_lt_exp.2 (by linarith)
    · unfold rfpXk; exact Real.exp_lt_exp.2 (by linarith)
    · unfold rfpXk; exact Real.exp_lt_exp.2 (by linarith)
    · unfold rfpXk; exact Real.exp_lt_exp.2 (by linarith)
    · unfold rfpXk rfpXv; exact Real.exp_lt_exp.2 (by rw [eY4]; linarith)
    · unfold rfpXv rfpXb; rw [← Real.exp_add]
      exact Real.exp_lt_exp.2 (by rw [eYb, eY5]; linarith)
    · unfold rfpCp; exact Real.exp_pos _
    · unfold rfpCi; exact div_pos (Real.exp_pos _) (by linarith)

  have hpos : ∀ x η : ℝ, 0 < x → -2 < η → η < 2 → 0 < rfpF P x η := by
    intro x η hx h1 h2
    obtain ⟨-, -, -, -, -, hca, -, -⟩ := hC
    have hb := (hca η h1 h2).2 (Real.log x)
    have hin : 0 < 1 + P.ca η * rfpPsi P (Real.log x) := by
      have := neg_abs_le (P.ca η * rfpPsi P (Real.log x)); linarith
    unfold rfpF rfpE
    apply div_pos
    · exact mul_pos (mul_pos (Real.exp_pos _) (Real.rpow_pos_of_pos (by positivity) _))
        (Real.sqrt_pos.2 hin)
    · exact Real.sqrt_pos.2 (by linarith)

  have hxv0 : 0 < rfpXv P := Real.exp_pos _
  have hU0 : ∀ x η : ℝ, rfpXv P ≤ x → rfpU P x η = 0 := by
    intro x η hx
    have hxpos : 0 < x := lt_of_lt_of_le hxv0 hx
    have hy : rfpY4 P.Md P.lam ≤ Real.log x := by
      have := Real.log_le_log (Real.exp_pos _) hx
      unfold rfpXv at this
      rwa [Real.log_exp] at this
    have hy' : Real.exp P.Md + 11 + 1 + 60 * Real.log (1 / P.lam) + 13 / P.lam ≤ Real.log x := by
      rw [eY4, eY3, eY2] at hy; exact hy
    have hK : rfpK P.Md (Real.log x) = 0 := by
      unfold rfpK
      rw [if_neg (by intro h; linarith)]
      have hlog : P.Md ≤ Real.log (Real.log x) := by
        have := Real.log_le_log (Real.exp_pos P.Md) (show Real.exp P.Md ≤ Real.log x by linarith)
        rwa [Real.log_exp] at this
      rw [sig1 _ (by rw [le_div_iff₀ hMd]; linarith)]
      ring
    have hRb : rfpRb P (Real.log x) η = 0 := by
      unfold rfpRb rfpR0 rfpBmp
      have hd : 13 / P.lam ≤ Real.log x - rfpY3 P.Md P.lam := by rw [eY4] at hy; linarith
      have hd' := (div_le_iff₀ hl0).1 hd
      have hxi : 13 ≤ P.lam * (Real.log x - rfpY3 P.Md P.lam) := by
        linarith [mul_comm P.lam (Real.log x - rfpY3 P.Md P.lam)]
      have hY4 : 0 ≤ Real.log x - rfpY4 P.Md P.lam := by linarith
      rw [sig1 (P.lam * (Real.log x - rfpY3 P.Md P.lam) - 10) (by linarith),
        sig0 (1 - (Real.log x - rfpY4 P.Md P.lam + 3) / (3 / 20)) (by linarith),
        sig0 (1 - (Real.log x - rfpY4 P.Md P.lam + 1) / (3 / 20)) (by linarith)]
      ring
    unfold rfpU
    rw [hK, hRb]; ring
  have hxv : ∀ x η : ℝ, rfpXv P ≤ x → -1 < η → η < 1 →
      rfpU P x η = 0 ∧ profRadInt (rfpU P) x η = 0 := by
    intro x η hx h1 h2
    refine ⟨hU0 x η hx, ?_⟩
    obtain ⟨-, -, -, -, -, -, -, hmom⟩ := hC
    have hI0 := (hmom η h1 h2).1
    unfold profRadInt
    have hzero : ∫ t in (rfpXv P)..x, rfpU P t η = 0 := by
      rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ))]
      · simp
      · intro t ht
        rw [Set.uIcc_of_le hx] at ht
        exact hU0 t η ht.1
    by_cases hint : IntervalIntegrable (fun t => rfpU P t η) MeasureTheory.volume 0 (rfpXv P)
    · have hint2 : IntervalIntegrable (fun t => rfpU P t η) MeasureTheory.volume (rfpXv P) x := by
        have h0 : IntervalIntegrable (fun _ : ℝ => (0:ℝ)) MeasureTheory.volume (rfpXv P) x :=
          intervalIntegrable_const
        refine h0.congr ?_
        intro t ht
        rw [Set.uIoc_of_le hx] at ht
        exact (hU0 t η ht.1.le).symm
      rw [← intervalIntegral.integral_add_adjacent_intervals hint hint2, hI0, hzero, add_zero]
    · have hnot : ¬ IntervalIntegrable (fun t => rfpU P t η) MeasureTheory.volume 0 x := by
        intro h
        apply hint
        apply h.mono_set
        rw [Set.uIcc_of_le hxv0.le, Set.uIcc_of_le (le_trans hxv0.le hx)]
        exact Set.Icc_subset_Icc le_rfl hx
      exact intervalIntegral.integral_undef hnot
  obtain ⟨hin, hpat⟩ := rfp_inner_patch P hR'
  obtain ⟨htail, hcol⟩ := rfp_tail_collar P hR'
  exact ⟨hord, hin, hpat, hxv, htail, rfp_shape_data P hR', rfp_leadPi_identity P hR' hC, hcol, hpos⟩

theorem rfp_joint_smooth : ∀ P : RfpPar, RfpRegime P → RfpClos P → ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => rfpE P p.1 p.2) (univ ×ˢ Ioo (-2) 2) ∧ ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => ((1 + p.2 ^ 2)⁻¹) ^ (rfpTh P p.1) * Real.sqrt (1 + P.ca p.2 * rfpPsi P p.1)) (univ ×ˢ Ioo (-2) 2) ∧ ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.2 * rfpK P.Md p.1 + rfpE P p.1 p.2 * rfpRb P p.1 p.2) (univ ×ˢ Ioo (-2) 2) :=
by
  intro P hReg hClos
  obtain ⟨hMd, hPst, hl0, hl100, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hReg
  obtain ⟨cAmp, cc1, cc2, cca, -, hca, -, -⟩ := hClos

  have hσ : ContDiff ℝ ∞ sigA := by
    obtain ⟨F, hF⟩ : ∃ F : ℕ → ℝ → ℝ,
        F = fun j z => if z ≤ 0 then (0 : ℝ) else (z ^ j)⁻¹ * Real.exp (-1 / z ^ 2) := ⟨_, rfl⟩
    have hflat : ∀ (j : ℕ) (z : ℝ), 0 < z → z ≤ 1 →
        (z ^ j)⁻¹ * Real.exp (-1 / z ^ 2) ≤ ((j + 1).factorial : ℝ) * z ^ 2 := by
      intro j z hz hz1
      have hx : (0 : ℝ) ≤ 1 / z ^ 2 := by positivity
      have h1 := Real.pow_div_factorial_le_exp _ hx (j + 1)
      have hA : (0 : ℝ) < ((j + 1).factorial : ℝ) := by exact_mod_cast Nat.factorial_pos _
      have hE : Real.exp (-1 / z ^ 2) = (Real.exp (1 / z ^ 2))⁻¹ := by
        rw [← Real.exp_neg]; ring_nf
      have hEpos := Real.exp_pos (1 / z ^ 2)
      have hzj : z ^ j ≤ 1 := pow_le_one₀ hz.le hz1
      have hzjpos : 0 < z ^ j := pow_pos hz j
      rw [div_le_iff₀ hA] at h1
      have h2 : (1 / z ^ 2) ^ (j + 1) * (z ^ 2) ^ (j + 1) = 1 := by
        rw [← mul_pow]; field_simp; simp
      have h3 : 1 ≤ ((j + 1).factorial : ℝ) * (z ^ 2) ^ (j + 1) * Real.exp (1 / z ^ 2) := by
        calc (1 : ℝ) = (1 / z ^ 2) ^ (j + 1) * (z ^ 2) ^ (j + 1) := h2.symm
          _ ≤ (Real.exp (1 / z ^ 2) * ((j + 1).factorial : ℝ)) * (z ^ 2) ^ (j + 1) :=
              mul_le_mul_of_nonneg_right h1 (by positivity)
          _ = _ := by ring
      have h4 : (z ^ 2) ^ (j + 1) ≤ z ^ 2 * z ^ j := by
        calc (z ^ 2) ^ (j + 1) = z ^ 2 * z ^ j * z ^ j := by ring
          _ ≤ z ^ 2 * z ^ j * 1 := mul_le_mul_of_nonneg_left hzj (by positivity)
          _ = z ^ 2 * z ^ j := by ring
      have key : 1 ≤ ((j + 1).factorial : ℝ) * z ^ 2 * (z ^ j * Real.exp (1 / z ^ 2)) := by
        have := mul_le_mul_of_nonneg_left h4 (le_of_lt (mul_pos hA hEpos))
        nlinarith
      rw [hE, ← mul_inv, ← one_div, div_le_iff₀ (by positivity)]
      exact key
    have hFcont0 : ∀ j, ContinuousAt (F j) 0 := by
      intro j
      have h0 : F j 0 = 0 := by simp only [hF]; rw [if_pos le_rfl]
      rw [ContinuousAt, h0]
      apply squeeze_zero_norm' (a := fun z => ((j + 1).factorial : ℝ) * z ^ 2)
      · filter_upwards [Metric.ball_mem_nhds (0 : ℝ) one_pos] with z hz
        rw [Metric.mem_ball, Real.dist_eq, sub_zero] at hz
        simp only [hF]
        split_ifs with h
        · rw [norm_zero]; positivity
        · push_neg at h
          rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
          exact hflat j z h (by linarith [le_abs_self z])
      · exact (continuous_const.mul (continuous_pow 2)).tendsto' 0 0 (by simp)
    have hpos : ∀ (k : ℕ) (y : ℝ), 0 < y →
        HasDerivAt (fun z : ℝ => (z ^ k)⁻¹ * Real.exp (-1 / z ^ 2))
          (-(k : ℝ) * ((y ^ (k + 1))⁻¹ * Real.exp (-1 / y ^ 2)) +
            2 * ((y ^ (k + 3))⁻¹ * Real.exp (-1 / y ^ 2))) y := by
      intro k y hy
      have hy0 : y ≠ 0 := hy.ne'
      have h1 : HasDerivAt (fun z : ℝ => (z ^ k)⁻¹) (-(k : ℝ) * (y ^ (k + 1))⁻¹) y := by
        have := (hasDerivAt_pow k y).inv (pow_ne_zero k hy0)
        convert this using 1
        rcases k with _ | m
        · simp
        · simp only [Nat.add_sub_cancel]
          field_simp
          ring
      have h2 : HasDerivAt (fun z : ℝ => -1 / z ^ 2) (2 / y ^ 3) y := by
        have := (hasDerivAt_const y (-1 : ℝ)).div (hasDerivAt_pow 2 y) (pow_ne_zero 2 hy0)
        convert this using 1
        field_simp
        ring
      have h3 := h1.mul h2.exp
      convert h3 using 1
      field_simp
      ring
    have hFd : ∀ (k : ℕ) (y : ℝ), HasDerivAt (F k) (-(k : ℝ) * F (k + 1) y + 2 * F (k + 3) y) y := by
      have hneg : ∀ (k : ℕ) (y : ℝ), y < 0 →
          HasDerivAt (F k) (-(k : ℝ) * F (k + 1) y + 2 * F (k + 3) y) y := by
        intro k y hy
        have hev : F k =ᶠ[nhds y] fun _ => (0 : ℝ) := by
          filter_upwards [Iio_mem_nhds hy] with z hz
          simp only [hF]
          rw [if_pos (le_of_lt hz)]
        have hv : -(k : ℝ) * F (k + 1) y + 2 * F (k + 3) y = 0 := by
          simp only [hF]
          rw [if_pos hy.le, if_pos hy.le]
          ring
        rw [hv]
        exact (hasDerivAt_const y (0 : ℝ)).congr_of_eventuallyEq hev
      have hposF : ∀ (k : ℕ) (y : ℝ), 0 < y →
          HasDerivAt (F k) (-(k : ℝ) * F (k + 1) y + 2 * F (k + 3) y) y := by
        intro k y hy
        have hev : F k =ᶠ[nhds y] fun z => (z ^ k)⁻¹ * Real.exp (-1 / z ^ 2) := by
          filter_upwards [Ioi_mem_nhds hy] with z hz
          simp only [hF]
          rw [if_neg (not_le.mpr (show (0 : ℝ) < z from hz))]
        have hv1 : F (k + 1) y = (y ^ (k + 1))⁻¹ * Real.exp (-1 / y ^ 2) := by
          simp only [hF]; rw [if_neg (not_le.mpr hy)]
        have hv3 : F (k + 3) y = (y ^ (k + 3))⁻¹ * Real.exp (-1 / y ^ 2) := by
          simp only [hF]; rw [if_neg (not_le.mpr hy)]
        rw [hv1, hv3]
        exact (hpos k y hy).congr_of_eventuallyEq hev
      intro k y
      rcases lt_trichotomy y 0 with hy | hy | hy
      · exact hneg k y hy
      · subst hy
        have hg : ContinuousAt (fun z => -(k : ℝ) * F (k + 1) z + 2 * F (k + 3) z) 0 :=
          (continuousAt_const.mul (hFcont0 (k + 1))).add (continuousAt_const.mul (hFcont0 (k + 3)))
        exact hasDerivAt_of_hasDerivAt_of_ne (f := F k)
          (g := fun z => -(k : ℝ) * F (k + 1) z + 2 * F (k + 3) z)
          (fun z hz => by
            rcases lt_or_gt_of_ne hz with h | h
            · exact hneg k z h
            · exact hposF k z h) (hFcont0 k) hg
      · exact hposF k y hy
    have hFsmooth : ∀ k, ContDiff ℝ ∞ (F k) := by
      have hdiff : ∀ k, Differentiable ℝ (F k) := fun k y => (hFd k y).differentiableAt
      have hderiv : ∀ k, deriv (F k) = fun y => -(k : ℝ) * F (k + 1) y + 2 * F (k + 3) y :=
        fun k => funext fun y => (hFd k y).deriv
      have hn : ∀ n : ℕ, ∀ k, ContDiff ℝ n (F k) := by
        intro n
        induction n with
        | zero => intro k; exact contDiff_zero.mpr (hdiff k).continuous
        | succ n ih =>
          intro k
          rw [Nat.cast_succ, contDiff_succ_iff_deriv]
          refine ⟨hdiff k, ?_, ?_⟩
          · intro h; exact absurd h (by simp)
          · rw [hderiv k]
            exact (contDiff_const.mul (ih (k + 1))).add (contDiff_const.mul (ih (k + 3)))
      intro k
      exact contDiff_infty.mpr (fun n => hn n k)
    have hsq : sqFlat = F 0 := by
      funext y; simp only [hF, sqFlat, pow_zero, inv_one, one_mul]
    have hS : ContDiff ℝ ∞ sqFlat := by rw [hsq]; exact hFsmooth 0
    have hsq_nn : ∀ y, 0 ≤ sqFlat y := by intro y; unfold sqFlat; split_ifs <;> positivity
    have hD : ∀ y, 0 < sqFlat y + sqFlat (1 - y) := by
      intro y
      by_cases hy : y ≤ 0
      · have : sqFlat (1 - y) = Real.exp (-1 / (1 - y) ^ 2) := by
          unfold sqFlat; rw [if_neg (not_le.mpr (by linarith))]
        linarith [hsq_nn y, Real.exp_pos (-1 / (1 - y) ^ 2)]
      · have : sqFlat y = Real.exp (-1 / y ^ 2) := by
          unfold sqFlat; rw [if_neg hy]
        linarith [hsq_nn (1 - y), Real.exp_pos (-1 / y ^ 2)]
    have hsig : ∀ y, sigA y = sqFlat y / (sqFlat y + sqFlat (1 - y)) := by
      intro y
      unfold sigA sqFlat
      by_cases h0 : y ≤ 0
      · simp only [if_pos h0, zero_div]
      · by_cases h1 : 1 ≤ y
        · have h2 : 1 - y ≤ 0 := by linarith
          simp only [if_neg h0, if_pos h1, if_pos h2, add_zero]
          rw [div_self (Real.exp_pos _).ne']
        · have h2 : ¬ (1 - y ≤ 0) := not_le.mpr (by linarith)
          simp only [if_neg h0, if_neg h1, if_neg h2]
    have hr : ContDiff ℝ ∞ (fun y : ℝ => 1 - y) := contDiff_const.sub contDiff_id
    have hS1 : ContDiff ℝ ∞ (fun y => sqFlat (1 - y)) := hS.comp hr
    have hDc : ContDiff ℝ ∞ (fun y => sqFlat y + sqFlat (1 - y)) := hS.add hS1
    have hD0 : ∀ y, sqFlat y + sqFlat (1 - y) ≠ 0 := fun y => (hD y).ne'
    have hsigeq : sigA = fun y => sqFlat y / (sqFlat y + sqFlat (1 - y)) := funext hsig
    rw [hsigeq]; exact hS.div hDc hD0
  have hσ0 : ∀ y, 0 ≤ sigA y := by
    intro y; unfold sigA; split_ifs <;> positivity

  have hprim : ∀ g : ℝ → ℝ, ContDiff ℝ ∞ g → ContDiff ℝ ∞ (fun t => ∫ s in (0:ℝ)..t, g s) := by
    intro g hg
    have hc := hg.continuous
    rw [contDiff_infty_iff_deriv]
    refine ⟨fun b => (hc.integral_hasStrictDerivAt 0 b).hasDerivAt.differentiableAt, ?_⟩
    have : deriv (fun t => ∫ s in (0:ℝ)..t, g s) = g :=
      funext fun b => (hc.integral_hasStrictDerivAt 0 b).hasDerivAt.deriv
    rw [this]; exact hg
  have hSI : ContDiff ℝ ∞ rfpSigI := hprim sigA hσ
  have hR0 : ContDiff ℝ ∞ rfpR0 := by
    have h1 : ContDiff ℝ ∞ (fun ξ => ∫ v in (0:ℝ)..ξ, sigA (50 * v)) :=
      hprim (fun v => sigA (50 * v)) (by fun_prop)
    have h2 : ContDiff ℝ ∞ (fun ξ : ℝ => 1 - sigA (ξ - 10)) := by fun_prop
    exact h1.mul h2
  have hBmp : ContDiff ℝ ∞ rfpBmp := by
    show ContDiff ℝ ∞ (fun t => sigA (1 + t / (3 / 20)) * sigA (1 - t / (3 / 20)))
    fun_prop
  have hTh : ContDiff ℝ ∞ (rfpTh P) := by
    show ContDiff ℝ ∞ (fun y => 1 - sigA ((y - rfpY4 P.Md P.lam) / 60))
    fun_prop
  have hPsi : ContDiff ℝ ∞ (rfpPsi P) := by
    show ContDiff ℝ ∞ (fun y => rfpBmp (y - rfpY5 P.Md P.lam + 3) - rfpKa P * rfpBmp (y - rfpY5 P.Md P.lam + 1))
    fun_prop

  have hK : ContDiff ℝ ∞ (rfpK P.Md) := by
    rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : 0 < y
    · have hk : ContDiffAt ℝ ∞ (fun t => 4 * (1 - sigA (Real.log t / P.Md))) y :=
        contDiffAt_const.mul (contDiffAt_const.sub
          (hσ.contDiffAt.comp y ((contDiffAt_id.log hy.ne').div_const P.Md)))
      refine hk.congr_of_eventuallyEq ?_
      filter_upwards [Ioi_mem_nhds hy] with t ht
      unfold rfpK
      split_ifs with h1
      · have hl : Real.log t / P.Md ≤ 0 :=
          div_nonpos_of_nonpos_of_nonneg (Real.log_nonpos (le_of_lt ht) h1) hMd.le
        have : sigA (Real.log t / P.Md) = 0 := by unfold sigA; rw [if_pos hl]
        rw [this]; ring
      · rfl
    · have hy1 : y < 1 := by linarith [not_lt.mp hy]
      refine (contDiffAt_const (c := (4:ℝ))).congr_of_eventuallyEq ?_
      filter_upwards [Iio_mem_nhds hy1] with t ht
      unfold rfpK
      rw [if_pos (le_of_lt ht)]

  have hlam2 : P.lam ^ 2 ≤ 1 := by nlinarith
  have hρ1 : P.ρ < 1 := by linarith
  have hT : ∀ y, tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) =
      1 - P.ρ * (1 - sigA ((y - rfpYb P.Md P.lam P.T1 P.Lh + 2) / 2)) := by
    intro y
    unfold tailFac
    rw [← Real.exp_sub, Real.log_exp]
  have hLam : ContDiff ℝ ∞ (rfpLam P) := by
    have hfun : rfpLam P = fun y => (Real.log P.Pst + y / 10 - 3 / 5 * rfpSigI y
        - P.lam * rfpSigI (y - rfpY2 P.Md)
        - (1 - P.lam) * rfpSigI (y - rfpY5 P.Md P.lam)
        + (1 - P.h) * rfpSigI (y - rfpY5 P.Md P.lam - 1 - P.T1)
        - sigA ((y - rfpY4 P.Md P.lam) / 60) * Real.log 2)
        + Real.log ((1 - P.ρ * (1 - sigA ((y - rfpYb P.Md P.lam P.T1 P.Lh + 2) / 2))) / (1 - P.ρ)) := by
      funext y; unfold rfpLam; rw [hT y]
    rw [hfun]
    have hpos : ∀ y, (1 - P.ρ * (1 - sigA ((y - rfpYb P.Md P.lam P.T1 P.Lh + 2) / 2))) /
        (1 - P.ρ) ≠ 0 := by
      intro y
      have h0 := hσ0 ((y - rfpYb P.Md P.lam P.T1 P.Lh + 2) / 2)
      apply ne_of_gt
      apply div_pos _ (by linarith)
      nlinarith
    have hrest : ContDiff ℝ ∞ (fun y => Real.log P.Pst + y / 10 - 3 / 5 * rfpSigI y
        - P.lam * rfpSigI (y - rfpY2 P.Md)
        - (1 - P.lam) * rfpSigI (y - rfpY5 P.Md P.lam)
        + (1 - P.h) * rfpSigI (y - rfpY5 P.Md P.lam - 1 - P.T1)
        - sigA ((y - rfpY4 P.Md P.lam) / 60) * Real.log 2) := by fun_prop
    have hT' : ContDiff ℝ ∞ (fun y => (1 - P.ρ * (1 - sigA ((y - rfpYb P.Md P.lam P.T1 P.Lh + 2) / 2))) /
        (1 - P.ρ)) := by fun_prop
    exact hrest.add (hT'.log hpos)

  have L : ∀ a : ℝ → ℝ, ContDiff ℝ ∞ a →
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => a p.1) (univ ×ˢ Ioo (-2) 2) :=
    fun a ha => (ha.comp contDiff_fst).contDiffOn
  have S : ∀ b : ℝ → ℝ, ContDiffOn ℝ ∞ b (Ioo (-2) 2) →
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => b p.2) (univ ×ˢ Ioo (-2) 2) :=
    fun b hb => hb.comp contDiffOn_snd (fun p hp => hp.2)
  have hbase : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => (1 + p.2 ^ 2)⁻¹) (univ ×ˢ Ioo (-2) 2) :=
    (ContDiff.inv (by fun_prop : ContDiff ℝ ∞ (fun p : ℝ × ℝ => 1 + p.2 ^ 2))
      (fun p => by positivity)).contDiffOn
  have Fp : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => ((1 + p.2 ^ 2)⁻¹) ^ (rfpTh P p.1))
      (univ ×ˢ Ioo (-2) 2) :=
    hbase.rpow (L _ hTh) (fun p _ => by positivity)
  have Sq : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Real.sqrt (1 + P.ca p.2 * rfpPsi P p.1))
      (univ ×ˢ Ioo (-2) 2) := by
    have hrad : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 1 + P.ca p.2 * rfpPsi P p.1)
        (univ ×ˢ Ioo (-2) 2) := contDiffOn_const.add ((S _ cca).mul (L _ hPsi))
    refine hrad.sqrt (fun p hp => ?_)
    have hb := (hca p.2 hp.2.1 hp.2.2).2 p.1
    rw [abs_le] at hb
    apply ne_of_gt
    linarith [hb.1]
  have hG : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => ((1 + p.2 ^ 2)⁻¹) ^ (rfpTh P p.1) *
      Real.sqrt (1 + P.ca p.2 * rfpPsi P p.1)) (univ ×ˢ Ioo (-2) 2) := Fp.mul Sq
  have hE : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => rfpE P p.1 p.2) (univ ×ˢ Ioo (-2) 2) :=
    ((L _ hLam.exp).mul Fp).mul Sq
  have hR0' : ContDiff ℝ ∞ (fun y => rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))) := by fun_prop
  have hB1 : ContDiff ℝ ∞ (fun y => rfpBmp (y - rfpY4 P.Md P.lam + 3)) := by fun_prop
  have hB2 : ContDiff ℝ ∞ (fun y => rfpBmp (y - rfpY4 P.Md P.lam + 1)) := by fun_prop
  have hRb : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => rfpRb P p.1 p.2) (univ ×ˢ Ioo (-2) 2) :=
    (((S _ cAmp).mul (L _ hR0')).add ((S _ cc1).mul (L _ hB1))).add ((S _ cc2).mul (L _ hB2))
  have hU : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.2 * rfpK P.Md p.1 + rfpE P p.1 p.2 * rfpRb P p.1 p.2)
      (univ ×ˢ Ioo (-2) 2) :=
    (contDiffOn_snd.mul (L _ hK)).add (hE.mul hRb)
  exact ⟨hE, hG, hU⟩

theorem eventually_const_slice_bound : ∀ (g : ℝ × ℝ → ℝ) (a b : ℝ), a ≤ b → ContDiffOn ℝ ∞ g (univ ×ˢ Ioo (-2) 2) → (∀ y η : ℝ, y ≤ a → g (y, η) = g (a, η)) → (∀ y η : ℝ, b ≤ y → g (y, η) = g (b, η)) → ∀ m : ℕ, ∃ C : ℝ, ∀ y η : ℝ, |η| ≤ 3 / 2 → |iteratedDeriv m (fun e => g (y, e)) η| ≤ C :=
by
  intro g a b hab hg hlo hhi m
  have hU : IsOpen ((univ : Set ℝ) ×ˢ Ioo (-2 : ℝ) 2) := isOpen_univ.prod isOpen_Ioo
  have hrep : ∀ k : ℕ, ∃ D : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ D (univ ×ˢ Ioo (-2) 2) ∧
      ∀ y η : ℝ, -2 < η → η < 2 → iteratedDeriv k (fun e => g (y, e)) η = D (y, η) := by
    intro k
    induction k with
    | zero => exact ⟨g, hg, fun y η _ _ => by simp⟩
    | succ k ih =>
      obtain ⟨D, hD, hDr⟩ := ih
      refine ⟨fun z => fderiv ℝ D z ((0:ℝ), (1:ℝ)), ?_, ?_⟩
      · have h1 := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hD).2
        exact h1.clm_apply contDiffOn_const
      · intro y η h1 h2
        rw [iteratedDeriv_succ]
        have hev : iteratedDeriv k (fun e => g (y, e)) =ᶠ[nhds η] fun e => D (y, e) :=
          Filter.eventuallyEq_of_mem (Ioo_mem_nhds h1 h2) (fun e he => hDr y e he.1 he.2)
        rw [hev.deriv_eq]
        have hmem : ((y, η) : ℝ × ℝ) ∈ (univ : Set ℝ) ×ˢ Ioo (-2 : ℝ) 2 :=
          ⟨mem_univ _, h1, h2⟩
        have hdiff : DifferentiableAt ℝ D (y, η) :=
          (hD.contDiffAt (hU.mem_nhds hmem)).differentiableAt (by simp)
        have hc : HasDerivAt (fun e : ℝ => ((y, e) : ℝ × ℝ)) ((0:ℝ), (1:ℝ)) η :=
          (hasDerivAt_const η y).prodMk (hasDerivAt_id' η)
        have hcomp := hdiff.hasFDerivAt.comp_hasDerivAt η hc
        exact hcomp.deriv
  obtain ⟨D, hD, hDr⟩ := hrep m
  have hK : IsCompact (Icc a b ×ˢ Icc (-3/2 : ℝ) (3/2)) := isCompact_Icc.prod isCompact_Icc
  have hsub : Icc a b ×ˢ Icc (-3/2 : ℝ) (3/2) ⊆ (univ : Set ℝ) ×ˢ Ioo (-2 : ℝ) 2 := by
    intro z hz
    exact ⟨mem_univ _, by linarith [hz.2.1], by linarith [hz.2.2]⟩
  obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn (hD.continuousOn.mono hsub)
  refine ⟨C, fun y η hη => ?_⟩
  obtain ⟨hη1, hη2⟩ := abs_le.1 hη
  obtain ⟨y', hy'⟩ : ∃ y' : ℝ, y' = max a (min y b) := ⟨_, rfl⟩
  have hy'a : a ≤ y' := by rw [hy']; exact le_max_left _ _
  have hy'b : y' ≤ b := by rw [hy']; exact max_le hab (min_le_right _ _)
  have hslice : (fun e => g (y, e)) = fun e => g (y', e) := by
    funext e
    rcases le_or_gt y a with h | h
    · have : y' = a := by rw [hy']; exact max_eq_left (le_trans (min_le_left _ _) h)
      rw [this, hlo y e h]
    · rcases le_or_gt b y with h' | h'
      · have : y' = b := by rw [hy', min_eq_right h', max_eq_right hab]
        rw [this, hhi y e h']
      · have : y' = y := by rw [hy', min_eq_left h'.le, max_eq_right h.le]
        rw [this]
  rw [hslice, hDr y' η (by linarith) (by linarith), ← Real.norm_eq_abs]
  exact hC (y', η) ⟨⟨hy'a, hy'b⟩, by linarith, by linarith⟩

theorem rfp_profile_regular : ∀ P : RfpPar, RfpRegime P → RfpClos P → ContDiffOn ℝ ∞ (↿(rfpF P)) (Ioi 0 ×ˢ Ioo (-2) 2) ∧ ContDiffOn ℝ ∞ (↿(rfpU P)) (Ioi 0 ×ˢ Ioo (-2) 2) ∧ (∀ x₀ x₁ : ℝ, 0 < x₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ x η : ℝ, x₀ ≤ x → x ≤ x₁ → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿(rfpF P)) (x, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(rfpU P)) (x, η)‖ ≤ C) ∧ (∀ m : ℕ, ∃ C : ℝ, ∀ x η : ℝ, 0 < x → |η| ≤ 3 / 2 → |iteratedDeriv m (fun e => rfpF P x e) η| ≤ C * x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + P.h)) ∧ |iteratedDeriv m (fun e => rfpU P x e) η| ≤ C) ∧ (∀ η : ℝ, -1 < η → η < 1 → IntegrableOn (fun x => rfpU P x η * (2 * x * rfpF P x η)) (Ioi 0) ∧ IntegrableOn (fun x => rfpU P x η ^ 2 - x * rfpF P x η ^ 2) (Ioi 0) ∧ IntegrableOn (fun x => 2 * x * rfpF P x η - Real.sqrt (2 * x) * rfpCi P * x ^ (-(1 / 2 + P.h))) (Ioi 0) ∧ IntegrableOn (fun x => rfpF P x η ^ 2) (Ioi 0) ∧ ∀ X : ℝ, 0 ≤ X → IntervalIntegrable (fun x => rfpU P x η) volume 0 X ∧ IntervalIntegrable (fun x => 2 * x * rfpF P x η) volume 0 X ∧ IntervalIntegrable (fun x => rfpU P x η * (2 * x * rfpF P x η)) volume 0 X ∧ IntervalIntegrable (fun x => rfpU P x η ^ 2 - x * rfpF P x η ^ 2) volume 0 X ∧ IntervalIntegrable (fun x => rfpF P x η ^ 2) volume 0 X) :=
by
  intro P hReg hClos
  have hR := hReg
  obtain ⟨hMd, hPst, hl0, hl100, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hR
  obtain ⟨sE, sG, sU⟩ := rfp_joint_smooth P hReg hClos
  obtain ⟨⟨hY41, hY45, hY5b⟩, cG1, cG2, cU1, cU2⟩ := rfp_clamp_identities P hReg
  obtain ⟨hTail, B, hB⟩ := rfp_lam_tail_envelope P hReg

  have hℓ : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ => (Real.log z.1, z.2)) (Ioi 0 ×ˢ Ioo (-2) 2) :=
    (contDiffOn_fst.log (fun z hz => (mem_Ioi.mp hz.1).ne')).prodMk contDiffOn_snd
  have hℓmap : MapsTo (fun z : ℝ × ℝ => (Real.log z.1, z.2)) (Ioi 0 ×ˢ Ioo (-2) 2)
      (univ ×ˢ Ioo (-2) 2) := fun z hz => ⟨mem_univ _, hz.2⟩

  have hA : ContDiffOn ℝ ∞ (↿(rfpF P)) (Ioi 0 ×ˢ Ioo (-2) 2) := by
    have h1 := ContDiffOn.comp sE hℓ hℓmap
    have h2 : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ => Real.sqrt (2 * z.1)) (Ioi 0 ×ˢ Ioo (-2) 2) :=
      (contDiffOn_const.mul contDiffOn_fst).sqrt
        (fun z hz => mul_ne_zero two_ne_zero (mem_Ioi.mp hz.1).ne')
    have h3 := h1.div h2 (fun z hz => (Real.sqrt_pos.2 (by linarith [mem_Ioi.mp hz.1])).ne')
    refine h3.congr (fun z _ => ?_)
    simp only [Function.HasUncurry.uncurry, id, rfpF, Function.comp_apply, Pi.div_apply]

  have hB' : ContDiffOn ℝ ∞ (↿(rfpU P)) (Ioi 0 ×ˢ Ioo (-2) 2) := by
    have h1 := ContDiffOn.comp sU hℓ hℓmap
    refine h1.congr (fun z _ => ?_)
    simp only [Function.HasUncurry.uncurry, id, rfpU, Function.comp_apply]

  have hcpt : ∀ (g : ℝ × ℝ → ℝ), ContDiffOn ℝ ∞ g (Ioi 0 ×ˢ Ioo (-2) 2) → ∀ x₀ x₁ : ℝ, 0 < x₀ →
      ∀ m : ℕ, ∃ C : ℝ, ∀ z ∈ Icc x₀ x₁ ×ˢ Icc (-1:ℝ) 1, ‖iteratedFDeriv ℝ m g z‖ ≤ C := by
    intro g hg x₀ x₁ hx₀ m
    have hO : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-2:ℝ) 2) := isOpen_Ioi.prod isOpen_Ioo
    have hc : ContinuousOn (iteratedFDeriv ℝ m g) (Ioi 0 ×ˢ Ioo (-2) 2) :=
      (hg.continuousOn_iteratedFDerivWithin (by exact_mod_cast le_top) hO.uniqueDiffOn).congr
        (fun z hz => (iteratedFDerivWithin_of_isOpen m hO hz).symm)
    have hK : IsCompact (Icc x₀ x₁ ×ˢ Icc (-1:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
    have hsub : Icc x₀ x₁ ×ˢ Icc (-1:ℝ) 1 ⊆ Ioi 0 ×ˢ Ioo (-2) 2 := fun z hz =>
      ⟨lt_of_lt_of_le hx₀ hz.1.1, by linarith [hz.2.1], by linarith [hz.2.2]⟩
    exact hK.exists_bound_of_continuousOn (hc.mono hsub)

  have hW : ∀ x : ℝ, 0 < x → Real.exp (rfpLam P (Real.log x)) / Real.sqrt (2 * x) ≤
      Real.exp B * 2 ^ (3 / 5 + P.h) / Real.sqrt 2 *
        (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + P.h))) := by
    intro x hx
    have ha0 : (0:ℝ) ≤ 3 / 5 + P.h := by linarith
    have hs2 : 0 < Real.sqrt 2 := Real.sqrt_pos.2 (by norm_num)
    have hsq : 0 < Real.sqrt (2 * x) := Real.sqrt_pos.2 (by linarith)
    have hsx : Real.sqrt (2 * x) = Real.sqrt 2 * Real.exp (Real.log x * (1 / 2)) := by
      rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2) x, Real.sqrt_eq_rpow x, Real.rpow_def_of_pos hx]
    have hxp : x ^ (-(2 / 5 : ℝ)) = Real.exp (Real.log x * (-(2 / 5))) := Real.rpow_def_of_pos hx _
    have hkey : Real.exp (-((3 / 5 + P.h) * max (Real.log x) 0)) ≤
        2 ^ (3 / 5 + P.h) * (1 + x) ^ (-(3 / 5 + P.h)) := by
      have h1 : 1 + x ≤ 2 * Real.exp (max (Real.log x) 0) := by
        rcases le_or_gt x 1 with hx1 | hx1
        · have : 1 ≤ Real.exp (max (Real.log x) 0) := Real.one_le_exp (le_max_right _ _)
          linarith
        · have e1 : Real.exp (Real.log x) = x := Real.exp_log hx
          have e2 : Real.exp (Real.log x) ≤ Real.exp (max (Real.log x) 0) :=
            Real.exp_le_exp.2 (le_max_left _ _)
          linarith
      have h3 : Real.log (1 + x) ≤ Real.log 2 + max (Real.log x) 0 := by
        have := Real.log_le_log (by linarith) h1
        rwa [Real.log_mul (by norm_num) (Real.exp_pos _).ne', Real.log_exp] at this
      have h4 := mul_le_mul_of_nonneg_left h3 ha0
      rw [Real.rpow_def_of_pos (by norm_num : (0:ℝ) < 2),
        Real.rpow_def_of_pos (by linarith : (0:ℝ) < 1 + x), ← Real.exp_add]
      apply Real.exp_le_exp.2
      nlinarith [h4]
    have hΛ : rfpLam P (Real.log x) ≤ B + Real.log x / 10 - (3 / 5 + P.h) * max (Real.log x) 0 :=
      hB (Real.log x)
    have hpos : 0 ≤ Real.exp B / Real.sqrt 2 * Real.exp (Real.log x * (-(2 / 5))) := by positivity
    calc Real.exp (rfpLam P (Real.log x)) / Real.sqrt (2 * x)
        ≤ Real.exp (B + Real.log x / 10 - (3 / 5 + P.h) * max (Real.log x) 0) /
            Real.sqrt (2 * x) := (div_le_div_iff_of_pos_right hsq).2 (Real.exp_le_exp.2 hΛ)
      _ = Real.exp B / Real.sqrt 2 * Real.exp (Real.log x * (-(2 / 5))) *
            Real.exp (-((3 / 5 + P.h) * max (Real.log x) 0)) := by
          have e1 : Real.exp (B + Real.log x / 10 - (3 / 5 + P.h) * max (Real.log x) 0) =
              Real.exp B * Real.exp (Real.log x * (-(2 / 5))) *
                Real.exp (-((3 / 5 + P.h) * max (Real.log x) 0)) *
                Real.exp (Real.log x * (1 / 2)) := by
            rw [← Real.exp_add, ← Real.exp_add, ← Real.exp_add]; congr 1; ring
          rw [hsx, e1, mul_div_mul_right _ _ (Real.exp_pos _).ne']
          ring
      _ ≤ Real.exp B / Real.sqrt 2 * Real.exp (Real.log x * (-(2 / 5))) *
            (2 ^ (3 / 5 + P.h) * (1 + x) ^ (-(3 / 5 + P.h))) :=
          mul_le_mul_of_nonneg_left hkey hpos
      _ = _ := by rw [hxp]; ring

  have hD : ∀ m : ℕ, ∃ C : ℝ, ∀ x η : ℝ, 0 < x → |η| ≤ 3 / 2 →
      |iteratedDeriv m (fun e => rfpF P x e) η| ≤
        C * x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + P.h)) ∧
      |iteratedDeriv m (fun e => rfpU P x e) η| ≤ C := by
    intro m
    obtain ⟨CU, hCU⟩ := eventually_const_slice_bound
      (fun p : ℝ × ℝ => p.2 * rfpK P.Md p.1 + rfpE P p.1 p.2 * rfpRb P p.1 p.2) 1
      (rfpY4 P.Md P.lam) hY41 sU
      (fun y η hy => (cU1 y η hy).trans (cU1 1 η le_rfl).symm)
      (fun y η hy => (cU2 y η hy).trans (cU2 _ η le_rfl).symm) m
    obtain ⟨CG, hCG⟩ := eventually_const_slice_bound
      (fun p : ℝ × ℝ => ((1 + p.2 ^ 2)⁻¹) ^ (rfpTh P p.1) * Real.sqrt (1 + P.ca p.2 * rfpPsi P p.1))
      (rfpY4 P.Md P.lam) (rfpY5 P.Md P.lam) hY45 sG
      (fun y η hy => (cG1 y η hy).trans (cG1 _ η le_rfl).symm)
      (fun y η hy => (cG2 y η hy).trans (cG2 _ η le_rfl).symm) m
    refine ⟨max (Real.exp B * 2 ^ (3 / 5 + P.h) / Real.sqrt 2 * max CG 0) (max CU 0),
      fun x η hx hη => ⟨?_, ?_⟩⟩
    · have hfun : (fun e => rfpF P x e) = fun e => Real.exp (rfpLam P (Real.log x)) /
          Real.sqrt (2 * x) * (((1 + e ^ 2)⁻¹) ^ (rfpTh P (Real.log x)) *
            Real.sqrt (1 + P.ca e * rfpPsi P (Real.log x))) := by
        funext e; simp only [rfpF, rfpE]; ring
      have hderiv : iteratedDeriv m (fun e => rfpF P x e) η =
          Real.exp (rfpLam P (Real.log x)) / Real.sqrt (2 * x) *
            iteratedDeriv m (fun e => ((1 + e ^ 2)⁻¹) ^ (rfpTh P (Real.log x)) *
              Real.sqrt (1 + P.ca e * rfpPsi P (Real.log x))) η := by
        rw [hfun]; exact iteratedDeriv_const_mul_field _ _
      have hc0 : 0 ≤ Real.exp (rfpLam P (Real.log x)) / Real.sqrt (2 * x) := by positivity
      have hw1 : 0 ≤ x ^ (-(2 / 5 : ℝ)) := Real.rpow_nonneg hx.le _
      have hw2 : 0 ≤ (1 + x) ^ (-(3 / 5 + P.h)) := Real.rpow_nonneg (by linarith) _
      rw [hderiv, abs_mul, abs_of_nonneg hc0]
      refine le_trans (mul_le_mul_of_nonneg_left ((hCG (Real.log x) η hη).trans
        (le_max_left CG 0)) hc0) ?_
      calc Real.exp (rfpLam P (Real.log x)) / Real.sqrt (2 * x) * max CG 0
          ≤ Real.exp B * 2 ^ (3 / 5 + P.h) / Real.sqrt 2 *
              (x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + P.h))) * max CG 0 :=
            mul_le_mul_of_nonneg_right (hW x hx) (le_max_right _ _)
        _ = Real.exp B * 2 ^ (3 / 5 + P.h) / Real.sqrt 2 * max CG 0 * x ^ (-(2 / 5 : ℝ)) *
              (1 + x) ^ (-(3 / 5 + P.h)) := by ring
        _ ≤ _ := mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_right (le_max_left _ _) hw1) hw2
    · exact (hCU (Real.log x) η hη).trans ((le_max_left CU 0).trans (le_max_right _ _))
  refine ⟨hA, hB', ?_, hD, ?_⟩

  · intro x₀ x₁ hx₀ m
    obtain ⟨C1, hC1⟩ := hcpt _ hA x₀ x₁ hx₀ m
    obtain ⟨C2, hC2⟩ := hcpt _ hB' x₀ x₁ hx₀ m
    refine ⟨max C1 C2, fun x η hx0 hx1 h1 h2 => ?_⟩
    have hz : ((x, η) : ℝ × ℝ) ∈ Icc x₀ x₁ ×ˢ Icc (-1:ℝ) 1 := ⟨⟨hx0, hx1⟩, h1.le, h2.le⟩
    exact ⟨(hC1 _ hz).trans (le_max_left _ _), (hC2 _ hz).trans (le_max_right _ _)⟩

  · intro η h1 h2
    obtain ⟨C0, hC0⟩ := hD 0
    have hm : MapsTo (fun x : ℝ => (x, η)) (Ioi 0) (Ioi 0 ×ˢ Ioo (-2) 2) :=
      fun x hx => ⟨hx, show (-2:ℝ) < η by linarith, show η < 2 by linarith⟩
    have hι : ContinuousOn (fun x : ℝ => ((x, η) : ℝ × ℝ)) (Ioi 0) :=
      (continuous_id.prodMk (continuous_const : Continuous fun _ : ℝ => η)).continuousOn
    have hcF : ContinuousOn (fun x => rfpF P x η) (Ioi 0) := by
      have := ContinuousOn.comp hA.continuousOn hι hm
      refine this.congr (fun x _ => ?_)
      simp only [Function.comp_apply, Function.HasUncurry.uncurry, id]
    have hcU : ContinuousOn (fun x => rfpU P x η) (Ioi 0) := by
      have := ContinuousOn.comp hB'.continuousOn hι hm
      refine this.congr (fun x _ => ?_)
      simp only [Function.comp_apply, Function.HasUncurry.uncurry, id]
    have hxb0 : 0 < rfpXb P := Real.exp_pos _
    have hρ1 : 0 < 1 - P.ρ := by nlinarith
    have hvan : ∀ x : ℝ, rfpXv P ≤ x → rfpU P x η = 0 := by
      intro x hx
      have hx0 : 0 < x := lt_of_lt_of_le (Real.exp_pos _) hx
      have hy : rfpY4 P.Md P.lam ≤ Real.log x := by
        rw [Real.le_log_iff_exp_le hx0]; exact hx
      exact cU2 (Real.log x) η hy
    have htail : ∀ x : ℝ, rfpXb P ≤ x →
        2 * x * rfpF P x η = Real.sqrt (2 * x) * rfpCi P * x ^ (-(1 / 2 + P.h)) := by
      intro x hx
      have hx0 : 0 < x := lt_of_lt_of_le hxb0 hx
      have hy : rfpYb P.Md P.lam P.T1 P.Lh ≤ Real.log x := by
        rw [Real.le_log_iff_exp_le hx0]; exact hx
      have hG1 := cG2 (Real.log x) η (le_trans hY5b hy)
      have hΛ := hTail (Real.log x) hy
      have hE : rfpE P (Real.log x) η = rfpCi P * x ^ (-(1 / 2 + P.h)) := by
        have e0 : rfpE P (Real.log x) η = Real.exp (rfpLam P (Real.log x)) *
            (((1 + η ^ 2)⁻¹) ^ (rfpTh P (Real.log x)) *
              Real.sqrt (1 + P.ca η * rfpPsi P (Real.log x))) := by
          simp only [rfpE]; ring
        rw [e0, hG1, mul_one, hΛ, rfpCi, Real.rpow_def_of_pos hx0, Real.exp_sub, Real.exp_sub,
          Real.exp_log hρ1, show Real.log x * -(1 / 2 + P.h) = -((1 / 2 + P.h) * Real.log x) by ring,
          Real.exp_neg]
        field_simp
      have hs : Real.sqrt (2 * x) * Real.sqrt (2 * x) = 2 * x := Real.mul_self_sqrt (by linarith)
      have hs0 : 0 < Real.sqrt (2 * x) := Real.sqrt_pos.2 (by linarith)
      show 2 * x * (rfpE P (Real.log x) η / Real.sqrt (2 * x)) = _
      rw [hE]
      calc 2 * x * (rfpCi P * x ^ (-(1 / 2 + P.h)) / Real.sqrt (2 * x))
          = Real.sqrt (2 * x) * Real.sqrt (2 * x) *
              (rfpCi P * x ^ (-(1 / 2 + P.h)) / Real.sqrt (2 * x)) := by rw [hs]
        _ = _ := by field_simp
    have hbd : ∀ x : ℝ, 0 < x → |rfpF P x η| ≤ C0 * x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + P.h)) ∧
        |rfpU P x η| ≤ C0 := by
      intro x hx
      have := hC0 x η hx (abs_le.2 ⟨by linarith, by linarith⟩)
      simpa only [iteratedDeriv_zero] using this
    exact slice_integrability (fun x => rfpF P x η) (fun x => rfpU P x η) P.h C0 (rfpCi P)
      (rfpXv P) (rfpXb P) hh0 (by nlinarith) (Real.exp_pos _) hxb0 hcF hcU hbd hvan htail

theorem rfp_lead_continuous : ∀ (h : ℝ) (F U : ℝ → ℝ → ℝ), 0 < h → h < 1 / 100 → ContDiffOn ℝ ∞ (↿F) (Ioi 0 ×ˢ Ioo (-2) 2) → ContDiffOn ℝ ∞ (↿U) (Ioi 0 ×ˢ Ioo (-2) 2) → (∀ x η : ℝ, 0 < x → -2 < η → η < 2 → 0 < F x η) → (∀ m : ℕ, m ≤ 2 → ∃ C : ℝ, ∀ x η : ℝ, 0 < x → |η| ≤ 3 / 2 → |iteratedDeriv m (fun e => F x e) η| ≤ C * x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)) ∧ |iteratedDeriv m (fun e => U x e) η| ≤ C) → ContinuousOn (fun z : ℝ × ℝ => shearA F z.1 z.2) (Ioi 0 ×ˢ Ioo (-3 / 2) (3 / 2)) ∧ ContinuousOn (fun z : ℝ × ℝ => shearB F U z.1 z.2) (Ioi 0 ×ˢ Ioo (-3 / 2) (3 / 2)) ∧ ContinuousOn (fun z : ℝ × ℝ => psLead1 h F U z.1 z.2) (Ioi 0 ×ˢ Ioo (-3 / 2) (3 / 2)) ∧ ContinuousOn (fun z : ℝ × ℝ => psLead2 h F U z.1 z.2) (Ioi 0 ×ˢ Ioo (-3 / 2) (3 / 2)) :=
by
  intro h F U hh0 hh1 hF hU hFpos hb
  have hΩ2 : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-2:ℝ) 2) := isOpen_Ioi.prod isOpen_Ioo
  have hΩ : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) := isOpen_Ioi.prod isOpen_Ioo
  have hsub : Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2) ⊆ Ioi 0 ×ˢ Ioo (-2) 2 :=
    Set.prod_mono subset_rfl (Set.Ioo_subset_Ioo (by norm_num) (by norm_num))

  have s1 : ∀ G : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿G) (Ioi 0 ×ˢ Ioo (-2) 2) →
      ContinuousOn (fun z : ℝ × ℝ => deriv (fun Y => G Y z.2) z.1) (Ioi 0 ×ˢ Ioo (-2) 2) ∧
      ContinuousOn (fun z : ℝ × ℝ => deriv (fun e => G z.1 e) z.2) (Ioi 0 ×ˢ Ioo (-2) 2) ∧
      ∀ x η : ℝ, 0 < x → -2 < η → η < 2 →
        HasDerivAt (fun e => G x e) (deriv (fun e => G x e) η) η := by
    intro G hG
    have hd := hG.continuousOn_fderiv_of_isOpen hΩ2 (by simp)
    have hdiff : ∀ x η : ℝ, 0 < x → -2 < η → η < 2 → DifferentiableAt ℝ (↿G) (x, η) :=
      fun x η hx h1 h2 => (hG.contDiffAt (hΩ2.mem_nhds
        (show ((x, η) : ℝ × ℝ) ∈ Ioi (0:ℝ) ×ˢ Ioo (-2:ℝ) 2 from ⟨hx, h1, h2⟩))).differentiableAt (by simp)
    have hη : ∀ x η : ℝ, 0 < x → -2 < η → η < 2 →
        HasDerivAt (fun e => G x e) (fderiv ℝ (↿G) (x, η) (0, 1)) η := by
      intro x η hx h1 h2
      have := (hdiff x η hx h1 h2).hasFDerivAt.comp_hasDerivAt η
        ((hasDerivAt_const η x).prodMk (hasDerivAt_id η))
      exact this
    have hX : ∀ x η : ℝ, 0 < x → -2 < η → η < 2 →
        HasDerivAt (fun Y => G Y η) (fderiv ℝ (↿G) (x, η) (1, 0)) x := by
      intro x η hx h1 h2
      have := (hdiff x η hx h1 h2).hasFDerivAt.comp_hasDerivAt x
        ((hasDerivAt_id x).prodMk (hasDerivAt_const x η))
      exact this
    refine ⟨(hd.clm_apply (continuousOn_const (c := ((1:ℝ), (0:ℝ))))).congr ?_,
      (hd.clm_apply (continuousOn_const (c := ((0:ℝ), (1:ℝ))))).congr ?_, ?_⟩
    · rintro ⟨x, η⟩ ⟨hx, h1, h2⟩
      exact (hX x η hx h1 h2).deriv
    · rintro ⟨x, η⟩ ⟨hx, h1, h2⟩
      exact (hη x η hx h1 h2).deriv
    · intro x η hx h1 h2
      exact (hη x η hx h1 h2).differentiableAt.hasDerivAt

  have slice : ∀ (G : ℝ → ℝ → ℝ), ContinuousOn (↿G) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) →
      ∀ η : ℝ, -3 / 2 < η → η < 3 / 2 → ContinuousOn (fun x => G x η) (Ioi 0) :=
    fun G hG η h1 h2 =>
      hG.comp (f := fun x : ℝ => ((x, η) : ℝ × ℝ)) (by fun_prop) (fun x hx => ⟨hx, h1, h2⟩)

  have radII : ∀ (G : ℝ → ℝ → ℝ) (B : ℝ), ContinuousOn (↿G) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) →
      (∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → |G x η| ≤ B) →
      ∀ η X : ℝ, -3 / 2 < η → η < 3 / 2 → 0 ≤ X → IntervalIntegrable (fun x => G x η) volume 0 X := by
    intro G B hG hB η X h1 h2 hX
    rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hX]
    refine Integrable.mono' (integrableOn_const (C := B) (by simp))
      (((slice G hG η h1 h2).mono Ioc_subset_Ioi_self).aestronglyMeasurable measurableSet_Ioc) ?_
    refine (ae_restrict_iff' measurableSet_Ioc).2 (Filter.Eventually.of_forall fun x hx => ?_)
    rw [Real.norm_eq_abs]; exact hB x η hx.1 h1 h2

  have s2 : ∀ (G : ℝ → ℝ → ℝ) (B : ℝ), ContinuousOn (↿G) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) →
      (∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → |G x η| ≤ B) →
      ContinuousOn (fun z : ℝ × ℝ => ∫ x in (0:ℝ)..z.1, G x z.2)
        (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) := by
    intro G B hG hB
    rintro ⟨X₀, η₀⟩ ⟨hX₀, h1₀, h2₀⟩
    apply ContinuousAt.continuousWithinAt
    have hX₀' : (0:ℝ) < X₀ := hX₀
    have hA : ContinuousAt (fun η => ∫ x in (0:ℝ)..X₀, G x η) η₀ := by
      apply intervalIntegral.continuousAt_of_dominated_interval (bound := fun _ => B)
      · filter_upwards [isOpen_Ioo.mem_nhds ⟨h1₀, h2₀⟩] with η hη
        rw [Set.uIoc_of_le hX₀'.le]
        exact ((slice G hG η hη.1 hη.2).mono Ioc_subset_Ioi_self).aestronglyMeasurable
          measurableSet_Ioc
      · filter_upwards [isOpen_Ioo.mem_nhds ⟨h1₀, h2₀⟩] with η hη
        refine Filter.Eventually.of_forall fun x hx => ?_
        rw [Set.uIoc_of_le hX₀'.le] at hx
        rw [Real.norm_eq_abs]; exact hB x η hx.1 hη.1 hη.2
      · exact intervalIntegrable_const
      · refine Filter.Eventually.of_forall fun x hx => ?_
        rw [Set.uIoc_of_le hX₀'.le] at hx
        have hc : ContinuousAt (↿G) (x, η₀) := hG.continuousAt (hΩ.mem_nhds ⟨hx.1, h1₀, h2₀⟩)
        exact hc.comp (f := fun η : ℝ => ((x, η) : ℝ × ℝ)) (by fun_prop)
    have hN : Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2) ∈ nhds ((X₀, η₀) : ℝ × ℝ) :=
      hΩ.mem_nhds ⟨hX₀, h1₀, h2₀⟩
    have hR : Filter.Tendsto (fun z : ℝ × ℝ => ∫ x in X₀..z.1, G x z.2) (nhds (X₀, η₀)) (nhds 0) := by
      apply squeeze_zero_norm' (a := fun z : ℝ × ℝ => B * |z.1 - X₀|)
      · filter_upwards [hN] with z hz
        apply intervalIntegral.norm_integral_le_of_norm_le_const
        intro x hx
        rw [Real.norm_eq_abs]
        have hz1 : (0:ℝ) < z.1 := hz.1
        have hxpos : 0 < x := by
          rcases Set.mem_uIoc.1 hx with h' | h'
          · linarith [h'.1]
          · linarith [h'.1]
        exact hB x z.2 hxpos hz.2.1 hz.2.2
      · have hc : Continuous (fun z : ℝ × ℝ => B * |z.1 - X₀|) := by fun_prop
        convert hc.tendsto (X₀, η₀) using 2
        simp
    have hA' : ContinuousAt (fun z : ℝ × ℝ => ∫ x in (0:ℝ)..X₀, G x z.2) (X₀, η₀) :=
      ContinuousAt.comp (g := fun η => ∫ x in (0:ℝ)..X₀, G x η) (f := Prod.snd) hA continuousAt_snd
    have hR' : ContinuousAt (fun z : ℝ × ℝ => ∫ x in X₀..z.1, G x z.2) (X₀, η₀) := by
      show Filter.Tendsto _ _ (nhds (∫ x in X₀..X₀, G x η₀))
      rw [intervalIntegral.integral_same]; exact hR
    have hsum : ContinuousAt (fun z : ℝ × ℝ =>
        (∫ x in (0:ℝ)..X₀, G x z.2) + ∫ x in X₀..z.1, G x z.2) (X₀, η₀) := hA'.add hR'
    apply hsum.congr
    filter_upwards [hN] with z hz
    have hz1 : (0:ℝ) < z.1 := hz.1
    exact intervalIntegral.integral_add_adjacent_intervals
      (radII G B hG hB z.2 X₀ hz.2.1 hz.2.2 hX₀'.le)
      ((radII G B hG hB z.2 X₀ hz.2.1 hz.2.2 hX₀'.le).symm.trans
        (radII G B hG hB z.2 z.1 hz.2.1 hz.2.2 hz1.le))

  have tailI : ∀ (G : ℝ → ℝ → ℝ) (L : ℝ), ContinuousOn (↿G) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) →
      (∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → |G x η| ≤ L * x ^ (-2:ℝ)) →
      ∀ η d : ℝ, -3 / 2 < η → η < 3 / 2 → 0 < d → IntegrableOn (fun x => G x η) (Ioi d) := by
    intro G L hG hB η d h1 h2 hd
    refine Integrable.mono'
      ((integrableOn_Ioi_rpow_of_lt (by norm_num : (-2:ℝ) < -1) hd).const_mul L)
      (((slice G hG η h1 h2).mono (fun x (hx : d < x) => show (0:ℝ) < x from lt_trans hd hx)).aestronglyMeasurable
        measurableSet_Ioi) ?_
    refine (ae_restrict_iff' measurableSet_Ioi).2 (Filter.Eventually.of_forall fun x hx => ?_)
    rw [Real.norm_eq_abs]; exact hB x η (lt_trans hd hx) h1 h2

  have s3 : ∀ (G : ℝ → ℝ → ℝ) (L : ℝ), 0 ≤ L →
      ContinuousOn (↿G) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) →
      (∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → |G x η| ≤ L * x ^ (-2:ℝ)) →
      ContinuousOn (fun z : ℝ × ℝ => ∫ x in Ioi z.1, G x z.2)
        (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) := by
    intro G L hL hG hB
    rintro ⟨X₀, η₀⟩ ⟨hX₀, h1₀, h2₀⟩
    apply ContinuousAt.continuousWithinAt
    have hX₀' : (0:ℝ) < X₀ := hX₀
    have hA : ContinuousAt (fun η => ∫ x in Ioi X₀, G x η) η₀ := by
      apply MeasureTheory.continuousAt_of_dominated (bound := fun x => L * x ^ (-2:ℝ))
      · filter_upwards [isOpen_Ioo.mem_nhds ⟨h1₀, h2₀⟩] with η hη
        exact ((slice G hG η hη.1 hη.2).mono
          (fun x (hx : X₀ < x) => show (0:ℝ) < x from lt_trans hX₀' hx)).aestronglyMeasurable
          measurableSet_Ioi
      · filter_upwards [isOpen_Ioo.mem_nhds ⟨h1₀, h2₀⟩] with η hη
        refine (ae_restrict_iff' measurableSet_Ioi).2 (Filter.Eventually.of_forall fun x hx => ?_)
        rw [Real.norm_eq_abs]; exact hB x η (lt_trans hX₀' hx) hη.1 hη.2
      · exact (integrableOn_Ioi_rpow_of_lt (by norm_num : (-2:ℝ) < -1) hX₀').const_mul L
      · refine (ae_restrict_iff' measurableSet_Ioi).2 (Filter.Eventually.of_forall fun x hx => ?_)
        have hc : ContinuousAt (↿G) (x, η₀) :=
          hG.continuousAt (hΩ.mem_nhds ⟨lt_trans hX₀' hx, h1₀, h2₀⟩)
        exact hc.comp (f := fun η : ℝ => ((x, η) : ℝ × ℝ)) (by fun_prop)
    have hN : Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2) ∈ nhds ((X₀, η₀) : ℝ × ℝ) :=
      hΩ.mem_nhds ⟨hX₀, h1₀, h2₀⟩
    have hN2 : {z : ℝ × ℝ | X₀ / 2 < z.1} ∈ nhds ((X₀, η₀) : ℝ × ℝ) :=
      (isOpen_lt continuous_const continuous_fst).mem_nhds (show X₀ / 2 < X₀ by linarith)
    have hR : Filter.Tendsto (fun z : ℝ × ℝ => ∫ x in X₀..z.1, G x z.2) (nhds (X₀, η₀)) (nhds 0) := by
      apply squeeze_zero_norm' (a := fun z : ℝ × ℝ => L * (X₀ / 2) ^ (-2:ℝ) * |z.1 - X₀|)
      · filter_upwards [hN, hN2] with z hz hz2
        apply intervalIntegral.norm_integral_le_of_norm_le_const
        intro x hx
        rw [Real.norm_eq_abs]
        have hz2' : X₀ / 2 < z.1 := hz2
        have hxc : X₀ / 2 < x := by
          rcases Set.mem_uIoc.1 hx with h' | h'
          · linarith [h'.1]
          · linarith [h'.1]
        have hxpos : 0 < x := by linarith
        refine (hB x z.2 hxpos hz.2.1 hz.2.2).trans ?_
        exact mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_nonpos (by linarith) hxc.le (by norm_num)) hL
      · have hc : Continuous (fun z : ℝ × ℝ => L * (X₀ / 2) ^ (-2:ℝ) * |z.1 - X₀|) := by fun_prop
        convert hc.tendsto (X₀, η₀) using 2
        simp
    have hA' : ContinuousAt (fun z : ℝ × ℝ => ∫ x in Ioi X₀, G x z.2) (X₀, η₀) :=
      ContinuousAt.comp (g := fun η => ∫ x in Ioi X₀, G x η) (f := Prod.snd) hA continuousAt_snd
    have hR' : ContinuousAt (fun z : ℝ × ℝ => ∫ x in X₀..z.1, G x z.2) (X₀, η₀) := by
      show Filter.Tendsto _ _ (nhds (∫ x in X₀..X₀, G x η₀))
      rw [intervalIntegral.integral_same]; exact hR
    have hsum : ContinuousAt (fun z : ℝ × ℝ =>
        (∫ x in Ioi X₀, G x z.2) - ∫ x in X₀..z.1, G x z.2) (X₀, η₀) := hA'.sub hR'
    apply hsum.congr
    filter_upwards [hN] with z hz
    have hz1 : (0:ℝ) < z.1 := hz.1
    have e := intervalIntegral.integral_Ioi_sub_Ioi' (tailI G L hG hB z.2 X₀ hz.2.1 hz.2.2 hX₀')
      (tailI G L hG hB z.2 z.1 hz.2.1 hz.2.2 hz1)
    beta_reduce at e
    show (∫ x in Ioi X₀, G x z.2) - (∫ x in X₀..z.1, G x z.2) = ∫ x in Ioi z.1, G x z.2
    linarith

  have s4 : ∀ (G G' : ℝ → ℝ → ℝ) (B B' : ℝ),
      ContinuousOn (↿G) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) →
      ContinuousOn (↿G') (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) →
      (∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → |G x η| ≤ B) →
      (∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → |G' x η| ≤ B') →
      (∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → HasDerivAt (fun e => G x e) (G' x η) η) →
      ∀ X η : ℝ, 0 < X → -3 / 2 < η → η < 3 / 2 →
        HasDerivAt (fun e => ∫ x in (0:ℝ)..X, G x e) (∫ x in (0:ℝ)..X, G' x η) η := by
    intro G G' B B' hG hG' hB hB' hd X η hX h1 h2
    have hu : uIoc 0 X = Ioc 0 X := Set.uIoc_of_le hX.le
    have := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le (𝕜 := ℝ)
      (μ := volume) (F := fun e x => G x e) (F' := fun e x => G' x e) (x₀ := η)
      (bound := fun _ => B') (s := Ioo (-3 / 2) (3 / 2)) (a := 0) (b := X)
      (isOpen_Ioo.mem_nhds ⟨h1, h2⟩) ?_ ?_ ?_ ?_ intervalIntegrable_const ?_
    · exact this.2
    · filter_upwards [isOpen_Ioo.mem_nhds ⟨h1, h2⟩] with e he
      rw [hu]
      exact ((slice G hG e he.1 he.2).mono Ioc_subset_Ioi_self).aestronglyMeasurable
        measurableSet_Ioc
    · exact radII G B hG hB η X h1 h2 hX.le
    · rw [hu]
      exact ((slice G' hG' η h1 h2).mono Ioc_subset_Ioi_self).aestronglyMeasurable measurableSet_Ioc
    · refine Filter.Eventually.of_forall fun x hx e he => ?_
      rw [hu] at hx
      rw [Real.norm_eq_abs]; exact hB' x e hx.1 he.1 he.2
    · refine Filter.Eventually.of_forall fun x hx e he => ?_
      rw [hu] at hx
      exact hd x e hx.1 he.1 he.2

  have s5 : ∀ (G G' : ℝ → ℝ → ℝ) (L : ℝ),
      ContinuousOn (↿G) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) →
      ContinuousOn (↿G') (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) →
      (∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → |G x η| ≤ L * x ^ (-2:ℝ)) →
      (∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → |G' x η| ≤ L * x ^ (-2:ℝ)) →
      (∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → HasDerivAt (fun e => G x e) (G' x η) η) →
      ∀ X η : ℝ, 0 < X → -3 / 2 < η → η < 3 / 2 →
        HasDerivAt (fun e => ∫ x in Ioi X, G x e) (∫ x in Ioi X, G' x η) η := by
    intro G G' L hG hG' hB hB' hd X η hX h1 h2
    have hpos : ∀ x ∈ Ioi X, (0:ℝ) < x := fun x hx => lt_trans hX hx
    have := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume.restrict (Ioi X))
      (F := fun e x => G x e) (F' := fun e x => G' x e) (x₀ := η)
      (bound := fun x => L * x ^ (-2:ℝ)) (s := Ioo (-3 / 2) (3 / 2))
      (isOpen_Ioo.mem_nhds ⟨h1, h2⟩) ?_ ?_ ?_ ?_ ?_ ?_
    · exact this.2
    · filter_upwards [isOpen_Ioo.mem_nhds ⟨h1, h2⟩] with e he
      exact ((slice G hG e he.1 he.2).mono hpos).aestronglyMeasurable measurableSet_Ioi
    · exact tailI G L hG hB η X h1 h2 hX
    · exact ((slice G' hG' η h1 h2).mono hpos).aestronglyMeasurable measurableSet_Ioi
    · refine (ae_restrict_iff' measurableSet_Ioi).2 (Filter.Eventually.of_forall fun x hx e he => ?_)
      rw [Real.norm_eq_abs]; exact hB' x e (hpos x hx) he.1 he.2
    · exact (integrableOn_Ioi_rpow_of_lt (by norm_num : (-2:ℝ) < -1) hX).const_mul L
    · refine (ae_restrict_iff' measurableSet_Ioi).2 (Filter.Eventually.of_forall fun x hx e he => ?_)
      exact hd x e (hpos x hx) he.1 he.2

  have radPair : ∀ (G G' : ℝ → ℝ → ℝ) (B B' : ℝ),
      ContinuousOn (↿G) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) →
      ContinuousOn (↿G') (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) →
      (∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → |G x η| ≤ B) →
      (∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → |G' x η| ≤ B') →
      (∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → HasDerivAt (fun e => G x e) (G' x η) η) →
      ContinuousOn (↿(profRadInt G)) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) ∧
      ContinuousOn (↿(profEtaD (profRadInt G))) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) := by
    intro G G' B B' hG hG' hB hB' hd
    refine ⟨s2 G B hG hB, (s2 G' B' hG' hB').congr ?_⟩
    rintro ⟨X, η⟩ ⟨hX, h1, h2⟩
    exact (s4 G G' B B' hG hG' hB hB' hd X η hX h1 h2).deriv

  obtain ⟨Fd, hFd⟩ : ∃ Fd : ℝ → ℝ → ℝ, Fd = fun x e => deriv (fun e' => F x e') e := ⟨_, rfl⟩
  obtain ⟨Ud, hUd⟩ : ∃ Ud : ℝ → ℝ → ℝ, Ud = fun x e => deriv (fun e' => U x e') e := ⟨_, rfl⟩
  obtain ⟨hFx, hFdc0, hFder0⟩ := s1 F hF
  obtain ⟨hUx, hUdc0, hUder0⟩ := s1 U hU
  have hFc : ContinuousOn (fun p : ℝ × ℝ => F p.1 p.2) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) :=
    hF.continuousOn.mono hsub
  have hUc : ContinuousOn (fun p : ℝ × ℝ => U p.1 p.2) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) :=
    hU.continuousOn.mono hsub
  have hFdc : ContinuousOn (fun p : ℝ × ℝ => Fd p.1 p.2) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) := by
    rw [hFd]; exact hFdc0.mono hsub
  have hUdc : ContinuousOn (fun p : ℝ × ℝ => Ud p.1 p.2) (Ioi (0:ℝ) ×ˢ Ioo (-3 / 2:ℝ) (3 / 2)) := by
    rw [hUd]; exact hUdc0.mono hsub
  have hFder : ∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → HasDerivAt (fun e => F x e) (Fd x η) η := by
    intro x η hx h1 h2; rw [hFd]; exact hFder0 x η hx (by linarith) (by linarith)
  have hUder : ∀ x η : ℝ, 0 < x → -3 / 2 < η → η < 3 / 2 → HasDerivAt (fun e => U x e) (Ud x η) η := by
    intro x η hx h1 h2; rw [hUd]; exact hUder0 x η hx (by linarith) (by linarith)

  obtain ⟨w, hw⟩ : ∃ w : ℝ → ℝ, w = fun x => x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)) :=
    ⟨_, rfl⟩
  obtain ⟨C0, hC0⟩ := hb 0 (by norm_num)
  obtain ⟨C1, hC1⟩ := hb 1 (by norm_num)
  obtain ⟨K, hKdef⟩ : ∃ K : ℝ, K = |C0| + |C1| := ⟨_, rfl⟩
  have hK : 0 ≤ K := by rw [hKdef]; positivity
  have hw0 : ∀ x : ℝ, 0 < x → 0 ≤ w x := fun x hx => by rw [hw]; positivity
  have kp : ∀ x p : ℝ, 0 < x → 0 < p → x ^ p * (1 + x) ^ (-p) ≤ 1 := by
    intro x p hx hp
    rw [Real.rpow_neg (by linarith), ← div_eq_mul_inv]
    exact div_le_one_of_le₀ (Real.rpow_le_rpow hx.le (by linarith) hp.le) (by positivity)
  have hxw : ∀ x : ℝ, 0 < x → x * w x ≤ 1 := by
    intro x hx
    have e1 : x * x ^ (-(2 / 5 : ℝ)) = x ^ (3 / 5 : ℝ) := by
      rw [show (3 / 5 : ℝ) = 1 + (-(2 / 5)) by norm_num, Real.rpow_add hx, Real.rpow_one]
    have hm : (1 + x) ^ (-(3 / 5 + h)) ≤ (1 + x) ^ (-(3 / 5 : ℝ)) :=
      Real.rpow_le_rpow_of_exponent_le (by linarith) (by linarith)
    calc x * w x = x ^ (3 / 5 : ℝ) * (1 + x) ^ (-(3 / 5 + h)) := by rw [hw, ← e1]; ring
      _ ≤ x ^ (3 / 5 : ℝ) * (1 + x) ^ (-(3 / 5 : ℝ)) :=
          mul_le_mul_of_nonneg_left hm (by positivity)
      _ ≤ 1 := kp x (3 / 5) hx (by norm_num)
  have hxw2 : ∀ x : ℝ, 0 < x → x * w x ^ 2 ≤ 1 := by
    intro x hx
    have e1 : x * x ^ (-(2 / 5 : ℝ)) = x ^ (3 / 5 : ℝ) := by
      rw [show (3 / 5 : ℝ) = 1 + (-(2 / 5)) by norm_num, Real.rpow_add hx, Real.rpow_one]
    have e2 : x * (x ^ (-(2 / 5 : ℝ))) ^ 2 = x ^ (1 / 5 : ℝ) := by
      rw [sq, ← mul_assoc, e1, ← Real.rpow_add hx]; norm_num
    have hm : (1 + x) ^ (-(3 / 5 + h)) ≤ (1 + x) ^ (-(1 / 5 : ℝ)) :=
      Real.rpow_le_rpow_of_exponent_le (by linarith) (by linarith)
    have ha1 : (1 + x) ^ (-(3 / 5 + h)) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (by linarith) (by linarith)
    have ha0 : 0 ≤ (1 + x) ^ (-(3 / 5 + h)) := by positivity
    have hsq : ((1 + x) ^ (-(3 / 5 + h))) ^ 2 ≤ (1 + x) ^ (-(1 / 5 : ℝ)) := by
      calc ((1 + x) ^ (-(3 / 5 + h))) ^ 2 = (1 + x) ^ (-(3 / 5 + h)) * (1 + x) ^ (-(3 / 5 + h)) := sq _
        _ ≤ (1 + x) ^ (-(1 / 5 : ℝ)) * 1 := mul_le_mul hm ha1 ha0 (by positivity)
        _ = _ := mul_one _
    calc x * w x ^ 2 = x ^ (1 / 5 : ℝ) * ((1 + x) ^ (-(3 / 5 + h))) ^ 2 := by rw [hw, ← e2]; ring
      _ ≤ x ^ (1 / 5 : ℝ) * (1 + x) ^ (-(1 / 5 : ℝ)) :=
          mul_le_mul_of_nonneg_left hsq (by positivity)
      _ ≤ 1 := kp x (1 / 5) hx (by norm_num)
  have hw2 : ∀ x : ℝ, 0 < x → w x ^ 2 ≤ x ^ (-2:ℝ) := by
    intro x hx
    have h1 : (x * w x) ^ 2 ≤ 1 := pow_le_one₀ (mul_nonneg hx.le (hw0 x hx)) (hxw x hx)
    rw [Real.rpow_neg hx.le, Real.rpow_two]
