  have E4 : edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
      (c * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) ^ (-(1/2:ℝ)) =
      c ^ (-(1/2:ℝ)) * Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) := by
    have e : edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) ^ (-(1/2:ℝ)) =
