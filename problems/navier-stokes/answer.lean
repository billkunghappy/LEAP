    intro y η h1 h2 h3 h4
    have ha := (hpt y η h1 h2 h3 h4).1
    have hD := (hpt y η h1 h2 h3 h4).2
    have hη : |η| ≤ 1 := abs_le.mpr ⟨by linarith, by linarith⟩
