    rw [hk2] at e2
    have q1 := hround _ _ e1
    have q2 := hround _ _ e2
    unfold rectW frac0
    rw [q1, q2]
    ext
    · simp only [Prod.fst_sub, hk1]
    · simp only [Prod.snd_sub, hk2]
  have hPw : rectW h γ c P = w + ((v - vco h r0 γ c Y) * cib h γ.1) • vtv := hev.self_of_nhds.trans hJ
  refine ⟨?_, ?_, k, hev⟩
  · unfold vco etG
    rw [hPw, hWT, sub_add_cancel, mul_div_cancel_right₀ _ hκ.ne']
  · show |xiG h γ c P| ≤ r0 ∧ |etG h γ c P| ≤ r0
    unfold xiG etG
    rw [hPw]
    exact ⟨hWR, hWT'⟩

