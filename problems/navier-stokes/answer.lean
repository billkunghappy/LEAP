    have het : |etG B.h γ (G.ctr γ) η.2.2.2| < 1/8 := by
      have := hRη.2; linarith
    obtain ⟨U', c', -, hηU', -, hU'⟩ := nPhi5_local_model_v5 B G γ η hB hDη hxi het
    have hn := (hU' η hηU').2
    rw [hvη] at hn
    simp only [zero_mul, sub_zero] at hn
