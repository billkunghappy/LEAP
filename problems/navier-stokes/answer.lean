theorem ax_collar_rep_F : ∀ (h j0 σ δ Λ C K ρ1 t1 κ0 om : ℝ) (Pax : ℝ → ℝ) (Kder : ℕ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 1 ≤ Λ → 0 < ρ1 → 0 < t1 → t1 ≤ 1 / 100 → 0 < om → AxAxisOut h j0 σ δ Pax Λ C K ρ1 Kder Fn Un → ∀ X η : ℝ, X < 4 / Λ * Real.exp t1 → -1 < η → η < 1 → axProfF h Λ t1 κ0 om Fn Un X η = Fn X η * Real.exp (-1 * ∫ s in (0:ℝ)..X, axEa Λ t1 κ0 s * (deriv (fun Y => Fn Y η) s * (Fn s η)⁻¹)) :=
by
  intro h j0 σ δ Λ C K ρ1 t1 κ0 om Pax Kder Fn Un hΛ hρ1 ht1 ht1' hom hA X η hX hη1 hη2
