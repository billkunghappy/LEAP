theorem afc_leadW_pert : ∀ (h X η D B : ℝ) (U Ur : ℝ → ℝ → ℝ), 0 < h → h < 1 / 2 → 0 < X → -1 < η → η < 1 → (∀ e : ℝ, -1 < e → e < 1 → ContinuousOn (fun x => U x e) (Icc 0 X) ∧ ContinuousOn (fun x => Ur x e) (Icc 0 X)) → (∀ x e : ℝ, 0 < x → x ≤ X → -1 < e → e < 1 → DifferentiableAt ℝ (fun e' => U x e') e ∧ DifferentiableAt ℝ (fun e' => Ur x e') e ∧ |deriv (fun e' => U x e') e| ≤ B ∧ |deriv (fun e' => Ur x e') e| ≤ B) → (∀ x : ℝ, 0 ≤ x → x ≤ X → |U x η - Ur x η| ≤ D) → (∀ x : ℝ, 0 < x → x ≤ X → |deriv (fun e => U x e) η - deriv (fun e => Ur x e) η| ≤ D) → |leadW h U X η - leadW h Ur X η| ≤ 2 * D :=
