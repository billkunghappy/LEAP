  have hRu := (abs_le.1 hRb).2

  have hGi : -5 ≤ G := by rw [hG]; linarith
  have hGz : y ≤ rfpY5 P.Md P.lam + 1 + P.T1 → G ≤ -(1 / 2 + P.lam / 2) := by
    intro hz
