      obtain ⟨C2, c2, e2, hb2⟩ := bb k
      refine ⟨|C1| + |C2|, max c1 c2, max e1 e2, fun γ m ξ hξ hX1 hX2 => ?_⟩
      obtain ⟨hq0, hq1, hS1⟩ := hDq ξ hξ
      obtain ⟨hE, he0, he1⟩ := hEdge _ hX1 hX2
      have hn := hNB (a γ m) (b γ m) (c γ m) k ξ hξ (sa γ m) (sb γ m) (heq γ m)
      have hP0 : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
        unfold Penv5
        exact (Real.exp_pos _).le
      exact le_trans hn (hW _ _ _ _ _ C1 C2 c1 c2 e1 e2 α α1 α2 _ _ hq0 hq1 hS1 (Real.sqrt_nonneg _)
        he0 he1 hP0 ha1 ha2 (hb1 γ m ξ hξ hX1 hX2) (hb2 γ m ξ hξ hX1 hX2))
  have hNB0 : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (k : ℕ) (ξ : Cyl),
      NB B.h (fun _ : Cyl => (0 : V)) k ξ = 0 := by
    intro V _ _ k ξ
    unfold NB
    rw [iteratedFDeriv_fun_zero]
    have e : ((0 : Cyl → ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) V) ξ).compContinuousLinearMap
        (fun _ => Lnorm B.h ξ) = 0 := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e, norm_zero]
  have hZ : ∀ α : ℝ, InM B (qsOf l0) α (fun _ : Cyl => (0 : ℝ)) := by
    intro α
    refine ⟨contDiffOn_const, fun _ _ _ _ => rfl, fun _ _ _ => rfl, fun k => ⟨0, 0, 0, fun ξ _ _ _ => ?_⟩⟩
    rw [hNB0]
    simp
  have hW0 : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (α : ℝ),
      InWg5 B G (qsOf l0) α (fun (_ : Lab) (_ : ℤ) (_ : Cyl) => (0 : V)) := by
    intro V _ _ α
    refine ⟨⟨∅, by simp, fun _ _ _ => rfl⟩, fun _ _ => contDiffOn_const, fun _ _ _ _ _ _ => rfl,
      fun _ _ _ _ h => absurd rfl h, fun k => ⟨0, 0, 0, fun γ m ξ _ _ _ => ?_⟩⟩
    rw [hNB0]
    simp
  have hWmono : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (α α1 : ℝ)
      (a : Lab → ℤ → Cyl → V), InWg5 B G (qsOf l0) α1 a → α ≤ α1 → InWg5 B G (qsOf l0) α a := by
    intro V _ _ α α1 a ea h
    exact hInWg α α1 α a (fun _ _ _ => 0) a ea (hW0 α) h le_rfl ea.1 (fun γ m ξ _ => by simp)
  have hHsum : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (α β : ℝ) (a b : Lab → ℤ → Cyl → V),
      InWg5 B G (qsOf l0) α a → InWg5 B G (qsOf l0) β b →
      ∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → a γ m = 0 ∧ b γ m = 0 := by
    intro V _ _ α β a b ea eb
    obtain ⟨Ha, Ha0, Hav⟩ := ea.1
    obtain ⟨Hb, Hb0, Hbv⟩ := eb.1
    exact ⟨Ha ∪ Hb, by simp [Ha0, Hb0], fun γ m hm =>
      ⟨Hav γ m (fun h => hm (Finset.mem_union_left _ h)), Hbv γ m (fun h => hm (Finset.mem_union_right _ h))⟩⟩
  have hdiff : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (α : ℝ) (a : Lab → ℤ → Cyl → V),
      InWg5 B G (qsOf l0) α a → ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), DifferentiableAt ℝ (a γ m) ξ := by
    intro V _ _ α a ea γ m ξ hξ
    exact ((ea.2.1 γ m).contDiffAt (hDopen.mem_nhds hξ)).differentiableAt (by norm_num)

  have hvloc : ∀ (a b : WC) (γ : Lab) (m : ℤ), a γ m = b γ m → velW5 B G a γ m = velW5 B G b γ m := by
    intro a b γ m h
    funext ξ
    simp only [velW5, velC5, h]
  have hvz : ∀ (a : WC) (γ : Lab) (m : ℤ), a γ m = 0 → velW5 B G a γ m = 0 := by
    intro a γ m h
    funext ξ j
    fin_cases j <;> simp [velW5, velC5, DrC, DzC, dR, dZ, h]
  have hvadd : ∀ (a b : WC) (γ : Lab) (m : ℤ) (ξ : Cyl), DifferentiableAt ℝ (a γ m) ξ →
      DifferentiableAt ℝ (b γ m) ξ →
      velW5 B G (a + b) γ m ξ = velW5 B G a γ m ξ + velW5 B G b γ m ξ := by
    intro a b γ m ξ ha hb
    have hai : ∀ i, DifferentiableAt ℝ (fun η => a γ m η i) ξ := differentiableAt_pi.1 ha
    have hbi : ∀ i, DifferentiableAt ℝ (fun η => b γ m η i) ξ := differentiableAt_pi.1 hb
    have hD : ∀ (v : Cyl) (i : Fin 3), fderiv ℝ (fun η => a γ m η i + b γ m η i) ξ v =
        fderiv ℝ (fun η => a γ m η i) ξ v + fderiv ℝ (fun η => b γ m η i) ξ v := by
      intro v i
      rw [fderiv_fun_add (hai i) (hbi i)]
      rfl
    funext j
    fin_cases j <;> simp [velW5, velC5, DrC, DzC, dR, dZ, hD] <;> ring

  have hRM : ∀ (a : Fin 3) (e : ℕ) (z t : ℝ), t < 1 → simScale B.h z (1 - t) < qsOf l0 →
      radMom (mcor5 B G l0 (waveAdd S (potOf5 B G tw) (cutS B G pr)) a) e z t =
        radMom (mcor5 B G l0 S a) e z t := by
    intro a e z t ht hq
    unfold radMom
    refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun r hr => ?_)
    have hr' : (0:ℝ) < r := hr
    show r ^ e * yAvg (mcor5 B G l0 (waveAdd S (potOf5 B G tw) (cutS B G pr)) a) (r, z, t, 0) =
      r ^ e * yAvg (mcor5 B G l0 S a) (r, z, t, 0)
    congr 1
    unfold yAvg
    refine MeasureTheory.setIntegral_congr_fun (measurableSet_Icc.prod measurableSet_Icc) (fun Y _ => ?_)
    exact hMI a _ ⟨hr', ht, hq⟩

  have hA1 : InWg5 B G (qsOf l0) 1 (S.Aw + potOf5 B G tw) := by
    obtain ⟨H, H0, Hv⟩ := hHsum 1 (Bo + 1/2) S.Aw (potOf5 B G tw) c1 hDc
    refine hInWg 1 1 (Bo + 1/2) S.Aw (potOf5 B G tw) _ c1 hDc le_rfl hBo1 ⟨H, H0, fun γ m hm => ?_⟩
      (fun γ m ξ _ => rfl)
    show S.Aw γ m + potOf5 B G tw γ m = 0
    rw [(Hv γ m hm).1, (Hv γ m hm).2, add_zero]
  have hP1 : InWg5 B G (qsOf l0) 1 (S.pw + cutS B G pr) := by
    obtain ⟨H, H0, Hv⟩ := hHsum 1 (Bo + 1/2) S.pw (cutS B G pr) c2 hEc
    refine hInWg 1 1 (Bo + 1/2) S.pw (cutS B G pr) _ c2 hEc le_rfl hBo1 ⟨H, H0, fun γ m hm => ?_⟩
      (fun γ m ξ _ => rfl)
    show S.pw γ m + cutS B G pr γ m = 0
    rw [(Hv γ m hm).1, (Hv γ m hm).2, add_zero]
  have hV1 : InWg5 B G (qsOf l0) (1/2) (velW5 B G (S.Aw + potOf5 B G tw)) := by
    obtain ⟨H, H0, Hv⟩ := hHsum 1 (Bo + 1/2) S.Aw (potOf5 B G tw) c1 hDc
    refine hInWg (1/2) (1/2) Bo (velW5 B G S.Aw) (velW5 B G (potOf5 B G tw)) _ c16 hDv le_rfl hBoh
      ⟨H, H0, fun γ m hm => hvz _ γ m ?_⟩
      (fun γ m ξ hξ => hvadd S.Aw (potOf5 B G tw) γ m ξ (hdiff 1 S.Aw c1 γ m ξ hξ)
        (hdiff _ _ hDc γ m ξ hξ))
    show S.Aw γ m + potOf5 B G tw γ m = 0
    rw [(Hv γ m hm).1, (Hv γ m hm).2, add_zero]
  have hV2 : InWg5 B G (qsOf l0) 0.68 (velW5 B G (S.Aw + potOf5 B G tw) - W0h4 B G) := by
    obtain ⟨H1, H10, H1v⟩ := c17.1
    obtain ⟨H2, H20, H2v⟩ := hDc.1
    refine hInWg 0.68 0.68 Bo (velW5 B G S.Aw - W0h4 B G) (velW5 B G (potOf5 B G tw)) _ c17 hDv le_rfl hBo68
      ⟨H1 ∪ H2, by simp [H10, H20], fun γ m hm => ?_⟩ (fun γ m ξ hξ => ?_)
    · have hA : (S.Aw + potOf5 B G tw) γ m = S.Aw γ m := by
        show S.Aw γ m + potOf5 B G tw γ m = S.Aw γ m
        rw [H2v γ m (fun h => hm (Finset.mem_union_right _ h)), add_zero]
      have e1 := hvloc (S.Aw + potOf5 B G tw) S.Aw γ m hA
      have e2 := H1v γ m (fun h => hm (Finset.mem_union_left _ h))
      show velW5 B G (S.Aw + potOf5 B G tw) γ m - W0h4 B G γ m = 0
      rw [e1]
      exact e2
    · show velW5 B G (S.Aw + potOf5 B G tw) γ m ξ - W0h4 B G γ m ξ =
        (velW5 B G S.Aw γ m ξ - W0h4 B G γ m ξ) + velW5 B G (potOf5 B G tw) γ m ξ
      rw [hvadd S.Aw (potOf5 B G tw) γ m ξ (hdiff 1 S.Aw c1 γ m ξ hξ) (hdiff _ _ hDc γ m ξ hξ)]
      abel

  refine ⟨waveAdd S (potOf5 B G tw) (cutS B G pr), ?_, ?_⟩
  · unfold StOrd5
    refine ⟨hA1, hP1, c3, c4, c5, c6, hO1, m1, m2, m3, m4, m5, m6, m7, hR, hV1, hV2, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · exact hInM 0.9 0.9 0.9 _ _ _ c18 (hZ 0.9) le_rfl le_rfl (fun ξ hξ => by simp [nrm, hMI 1 ξ hξ])
    · exact hInM 0.9 0.9 0.9 _ _ _ c19 (hZ 0.9) le_rfl le_rfl (fun ξ hξ => by simp [nrm, hMI 2 ξ hξ])
    · exact hInM 0.9 0.9 (Bo + 1/2 - kapS) _ _ _ c20 m8 le_rfl h09 (fun ξ _ => by simp only [nrm]; ring)
    · exact hInM 1.9 1.9 1.9 _ _ _ c21 (hZ 1.9) le_rfl le_rfl (fun ξ hξ => by simp [nrm, hMI 0 ξ hξ])
    · intro z t ht hq
      rw [hRM 1 2 z t ht hq]
      exact c22 z t ht hq
    · intro z t ht hq
      rw [hRM 2 1 z t ht hq]
      exact c23 z t ht hq
  · unfold Incr5
    have eA : (waveAdd S (potOf5 B G tw) (cutS B G pr)).Aw - S.Aw = potOf5 B G tw :=
      add_sub_cancel_left S.Aw (potOf5 B G tw)
    have eP : (waveAdd S (potOf5 B G tw) (cutS B G pr)).pw - S.pw = cutS B G pr :=
      add_sub_cancel_left S.pw (cutS B G pr)
    have ePsi : (waveAdd S (potOf5 B G tw) (cutS B G pr)).Psi - S.Psi = fun _ => (0:ℝ) := by
      show S.Psi - S.Psi = _
      rw [sub_self]
      rfl
    have eBd : (waveAdd S (potOf5 B G tw) (cutS B G pr)).bdir - S.bdir = fun _ => (0:ℝ) := by
      show S.bdir - S.bdir = _
      rw [sub_self]
      rfl
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [eA]; exact hWmono _ _ _ hDc hBoD
    · rw [eA]; exact hDv
    · rw [eP]; exact hWmono _ _ _ hEc hBoD
    · rw [ePsi]; exact hZ Bo
    · rw [eBd]; exact hZ Bo
    · exact hInM Bo (Bo + 1/2 - kapS) Bo _ _ _ m8 (hZ Bo) hBoK le_rfl (fun ξ _ => by simp)
    · exact hInM (Bo + 1) (Bo + 1) (Bo + 1) _ _ _ (hZ _) (hZ _) le_rfl le_rfl
        (fun ξ hξ => by simp [nrm, hMI 0 ξ hξ])
    · exact hInM Bo Bo Bo _ _ _ (hZ _) (hZ _) le_rfl le_rfl (fun ξ hξ => by simp [nrm, hMI 2 ξ hξ])

theorem stp5_param_prim_smooth : ∀ (V : Set (ℝ × ℝ)) (k : ℝ → ℝ × ℝ → ℝ) (a b c : ℝ), IsOpen V → c ∈ Set.Ioo a b → ContDiffOn ℝ ∞ (fun x : ℝ × (ℝ × ℝ) => k x.1 x.2) (Set.Ioo a b ×ˢ V) → ContDiffOn ℝ ∞ (fun x : ℝ × (ℝ × ℝ) => ∫ s in c..x.1, k s x.2) (Set.Ioo a b ×ˢ V) :=
by
  intro V k a b c hV hc hk
  obtain ⟨hac, hcb⟩ := hc
  have hUo : IsOpen (Set.Ioo a b ×ˢ V) := isOpen_Ioo.prod hV
  have hφc : ContDiff ℝ ∞
      (fun p : ℝ × (ℝ × (ℝ × ℝ)) => (((p.2.1 - c) * p.1 + c, p.2.2) : ℝ × (ℝ × ℝ))) := by
    fun_prop
  have hO : IsOpen ((fun p : ℝ × (ℝ × (ℝ × ℝ)) => (((p.2.1 - c) * p.1 + c, p.2.2) : ℝ × (ℝ × ℝ)))
      ⁻¹' (Set.Ioo a b ×ˢ V)) := hUo.preimage hφc.continuous
  have hsub : Set.Icc (0:ℝ) 1 ×ˢ (Set.Ioo a b ×ˢ V) ⊆
      (fun p : ℝ × (ℝ × (ℝ × ℝ)) => (((p.2.1 - c) * p.1 + c, p.2.2) : ℝ × (ℝ × ℝ)))
        ⁻¹' (Set.Ioo a b ×ˢ V) := by
    rintro ⟨u, t, v⟩ ⟨⟨hu0, hu1⟩, ⟨ht1, ht2⟩, hv⟩
    show ((t - c) * u + c, v) ∈ Set.Ioo a b ×ˢ V
    refine ⟨⟨?_, ?_⟩, hv⟩
    · rcases le_total c t with h | h
      · nlinarith [mul_nonneg (sub_nonneg.mpr h) hu0]
      · nlinarith [mul_nonneg (sub_nonneg.mpr h) (sub_nonneg.mpr hu1)]
    · rcases le_total c t with h | h
      · nlinarith [mul_nonneg (sub_nonneg.mpr h) (sub_nonneg.mpr hu1)]
      · nlinarith [mul_nonneg (sub_nonneg.mpr h) hu0]
  have hG : ContDiffOn ℝ ∞ (fun p : ℝ × (ℝ × (ℝ × ℝ)) => k ((p.2.1 - c) * p.1 + c) p.2.2)
      ((fun p : ℝ × (ℝ × (ℝ × ℝ)) => (((p.2.1 - c) * p.1 + c, p.2.2) : ℝ × (ℝ × ℝ)))
        ⁻¹' (Set.Ioo a b ×ˢ V)) :=
    hk.comp hφc.contDiffOn (fun p hp => hp)

  have unit_leibniz : ∀ (U : Set (ℝ × (ℝ × ℝ))) (W : Set (ℝ × (ℝ × (ℝ × ℝ)))),
      IsOpen U → IsOpen W → Set.Icc (0:ℝ) 1 ×ˢ U ⊆ W → ∀ (n : ℕ) {F : Type}
      [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F] (H : ℝ × (ℝ × (ℝ × ℝ)) → F),
      ContDiffOn ℝ ∞ H W → ContDiffOn ℝ n (fun w' => ∫ u in (0:ℝ)..1, H (u, w')) U := by
    intro U W hUo hO hsub
    have param_fderiv : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
        (H : ℝ × (ℝ × (ℝ × ℝ)) → F), ContDiffOn ℝ ∞ H W →
        ContDiffOn ℝ ∞ (fun p : ℝ × (ℝ × (ℝ × ℝ)) => fderiv ℝ (fun w' => H (p.1, w')) p.2) W := by
      intro F _ _ H hH p hp
      have hHa : ContDiffAt ℝ ∞ H p := hH.contDiffAt (hO.mem_nhds hp)
      apply ContDiffAt.contDiffWithinAt
      have h1 : ContDiffAt ℝ ∞
          (Function.uncurry (fun (q : ℝ × (ℝ × (ℝ × ℝ))) (w' : ℝ × (ℝ × ℝ)) => H (q.1, w')))
          (p, p.2) := by
        have e : Function.uncurry
            (fun (q : ℝ × (ℝ × (ℝ × ℝ))) (w' : ℝ × (ℝ × ℝ)) => H (q.1, w')) =
            H ∘ (fun z : (ℝ × (ℝ × (ℝ × ℝ))) × (ℝ × (ℝ × ℝ)) => (z.1.1, z.2)) := rfl
        rw [e]
        apply ContDiffAt.comp (g := H) (p, p.2)
        · simpa using hHa
        · fun_prop
      exact ContDiffAt.fderiv (f := fun (q : ℝ × (ℝ × (ℝ × ℝ))) (w' : ℝ × (ℝ × ℝ)) => H (q.1, w'))
        (g := Prod.snd) h1 contDiffAt_snd (le_of_eq ENat.coe_top_add_one)
    have param_hasFDeriv : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
        (H : ℝ × (ℝ × (ℝ × ℝ)) → F), ContDiffOn ℝ ∞ H W → ∀ w ∈ U,
        HasFDerivAt (fun w' => ∫ u in (0:ℝ)..1, H (u, w'))
          (∫ u in (0:ℝ)..1, fderiv ℝ (fun w' => H (u, w')) w) w := by
      intro F _ _ _ H hH w hw
      have hHs := param_fderiv H hH
      obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hUo w hw
      set s := Metric.closedBall w (δ / 2) with hs
      have hsU : s ⊆ U := (Metric.closedBall_subset_ball (by linarith)).trans hball
      have hsn : s ∈ nhds w := Metric.closedBall_mem_nhds w (by linarith)
      have hK : IsCompact (Set.Icc (0:ℝ) 1 ×ˢ s) := isCompact_Icc.prod (isCompact_closedBall _ _)
      have hKsub : Set.Icc (0:ℝ) 1 ×ˢ s ⊆ W := fun z hz => hsub ⟨hz.1, hsU hz.2⟩
      obtain ⟨B, hB⟩ := hK.exists_bound_of_continuousOn (hHs.continuousOn.mono hKsub)
      have hcont : ∀ x ∈ U, ContinuousOn (fun u : ℝ => H (u, x)) (Set.Icc 0 1) := by
        intro x hx
        exact hH.continuousOn.comp (f := fun u : ℝ => ((u, x) : ℝ × (ℝ × (ℝ × ℝ))))
          (Continuous.continuousOn (by fun_prop)) (fun u hu => hsub ⟨hu, hx⟩)
      have hcont' : ∀ x ∈ U,
          ContinuousOn (fun u : ℝ => fderiv ℝ (fun w' => H (u, w')) x) (Set.Icc 0 1) := by
        intro x hx
        exact hHs.continuousOn.comp (f := fun u : ℝ => ((u, x) : ℝ × (ℝ × (ℝ × ℝ))))
          (Continuous.continuousOn (by fun_prop)) (fun u hu => hsub ⟨hu, hx⟩)
      have hIoc : Set.uIoc (0:ℝ) 1 ⊆ Set.Icc 0 1 := by
        rw [Set.uIoc_of_le zero_le_one]
        exact Set.Ioc_subset_Icc_self
      refine intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := volume)
        (F := fun x u => H (u, x)) (F' := fun x u => fderiv ℝ (fun w' => H (u, w')) x)
        (bound := fun _ => B) hsn ?_ ?_ ?_ ?_ ?_ ?_
      · filter_upwards [hUo.mem_nhds hw] with x hx
        exact ((hcont x hx).mono hIoc).aestronglyMeasurable measurableSet_uIoc
      · exact ContinuousOn.intervalIntegrable_of_Icc zero_le_one (hcont w hw)
      · exact ((hcont' w hw).mono hIoc).aestronglyMeasurable measurableSet_uIoc
      · refine ae_of_all _ (fun u hu x hx => ?_)
        exact hB (u, x) ⟨hIoc hu, hx⟩
      · exact intervalIntegrable_const
      · refine ae_of_all _ (fun u hu x hx => ?_)
        have hxU : x ∈ U := hsU hx
        have hHa : ContDiffAt ℝ ∞ H (u, x) := hH.contDiffAt (hO.mem_nhds (hsub ⟨hIoc hu, hxU⟩))
        have : ContDiffAt ℝ ∞ (fun w' => H (u, w')) x :=
          hHa.comp x (by fun_prop : ContDiffAt ℝ ∞
            (fun w' : ℝ × (ℝ × ℝ) => ((u, w') : ℝ × (ℝ × (ℝ × ℝ)))) x)
        exact (this.differentiableAt (by simp)).hasFDerivAt
    intro n
    induction n with
    | zero =>
      intro F _ _ _ H hH
      have hD : DifferentiableOn ℝ (fun w' => ∫ u in (0:ℝ)..1, H (u, w')) U :=
        fun w hw => (param_hasFDeriv H hH w hw).differentiableAt.differentiableWithinAt
      rw [Nat.cast_zero]
      exact contDiffOn_zero.mpr hD.continuousOn
    | succ n ih =>
      intro F _ _ _ H hH
      have hD : DifferentiableOn ℝ (fun w' => ∫ u in (0:ℝ)..1, H (u, w')) U :=
        fun w hw => (param_hasFDeriv H hH w hw).differentiableAt.differentiableWithinAt
      have hCS : CompleteSpace ((ℝ × (ℝ × ℝ)) →L[ℝ] F) :=
        ContinuousLinearMap.instCompleteSpace (E := ℝ × (ℝ × ℝ))
      have hIH := @ih ((ℝ × (ℝ × ℝ)) →L[ℝ] F) _ _ hCS
        (fun p : ℝ × (ℝ × (ℝ × ℝ)) => fderiv ℝ (fun w' => H (p.1, w')) p.2) (param_fderiv H hH)
      rw [Nat.cast_succ]
      refine (contDiffOn_succ_iff_fderiv_of_isOpen hUo).mpr ⟨hD, fun h => ?_, ?_⟩
      · exact absurd h (by simp)
      · refine hIH.congr (fun w hw => ?_)
        exact (param_hasFDeriv H hH w hw).fderiv
  have hI : ContDiffOn ℝ ∞
      (fun x : ℝ × (ℝ × ℝ) => ∫ u in (0:ℝ)..1, k ((x.1 - c) * u + c) x.2)
      (Set.Ioo a b ×ˢ V) :=
    contDiffOn_infty.mpr (fun n => unit_leibniz _ _ hUo hO hsub n _ hG)
  have hprod : ContDiffOn ℝ ∞
      (fun x : ℝ × (ℝ × ℝ) => (x.1 - c) * ∫ u in (0:ℝ)..1, k ((x.1 - c) * u + c) x.2)
      (Set.Ioo a b ×ˢ V) :=
    (contDiffOn_fst.sub contDiffOn_const).mul hI
  refine hprod.congr (fun x _ => ?_)
  have h := intervalIntegral.mul_integral_comp_mul_add (a := 0) (b := 1)
    (f := fun s => k s x.2) (x.1 - c) c
  simp only [mul_zero, zero_add, mul_one, sub_add_cancel] at h
  exact h.symm

theorem stp5_bE_norm : ∀ (B : BG), B.ok → ∀ e : ℕ, (e = 1 ∨ e = 2) → (∀ z t : ℝ, t < 1 → (∫ r in Set.Ioi (0:ℝ), r ^ e * bE B e (r, z, t, 0)) = 1) ∧ (∀ ξ : Cyl, 0 < ξ.1 → ξ.2.2.1 < 1 → (XC B.h ξ ≤ B.m1 ∨ B.m2 ≤ XC B.h ξ) → bE B e ξ = 0) :=
by
  intro B hB e _he
  have hXa : 0 < B.Xa := hB.2.1.2.2.1
  have hXm : B.Xa < B.m1 := hB.2.1.2.2.2.1
  have hm12 : B.m1 < B.m2 := hB.2.1.2.2.2.2.1
  have ha0 : 0 < Real.sqrt (2 * B.m1) := Real.sqrt_pos.mpr (by linarith)
  have hab : Real.sqrt (2 * B.m1) < Real.sqrt (2 * B.m2) :=
    Real.sqrt_lt_sqrt (by linarith) (by linarith)
  have hw : 0 < (Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2 := by linarith

  have hvan : ∀ s : ℝ, (s ≤ Real.sqrt (2 * B.m1) ∨ Real.sqrt (2 * B.m2) ≤ s) → rhoHat B s = 0 := by
    intro s hs
    have hu : 1 ≤ ((s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) ^ 2 := by
      rcases hs with hs | hs
      · have h1 : (s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
            ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2) ≤ -1 := by
          rw [div_le_iff₀ hw]; linarith
        nlinarith
      · have h1 : 1 ≤ (s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
            ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2) := by
          rw [le_div_iff₀ hw]; linarith
        nlinarith
    have hnum : bumpR ((s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) = 0 :=
      Real.smoothTransition.zero_of_nonpos (by linarith)
    unfold rhoHat
    rw [hnum, zero_div]

  have hbcont : Continuous (fun u : ℝ => bumpR ((u - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2))) := by
    unfold bumpR
    exact Real.smoothTransition.continuous.comp (by fun_prop)
  have hbpos : ∀ x ∈ Set.Ioo (Real.sqrt (2 * B.m1)) (Real.sqrt (2 * B.m2)),
      0 < bumpR ((x - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) := by
    intro x hx
    have h1 : -1 < (x - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2) := by
      rw [lt_div_iff₀ hw]; linarith [hx.1]
    have h2 : (x - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2) < 1 := by
      rw [div_lt_iff₀ hw]; linarith [hx.2]
    unfold bumpR
    exact Real.smoothTransition.pos_of_pos (by nlinarith)
  have hZpos : 0 < ∫ u in (Real.sqrt (2 * B.m1))..(Real.sqrt (2 * B.m2)),
      bumpR ((u - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) :=
    intervalIntegral.intervalIntegral_pos_of_pos_on (hbcont.intervalIntegrable _ _) hbpos hab
  have hrcont : Continuous (rhoHat B) := by
    unfold rhoHat
    exact hbcont.div_const _
  have hrpos : ∀ x ∈ Set.Ioo (Real.sqrt (2 * B.m1)) (Real.sqrt (2 * B.m2)), 0 < rhoHat B x := by
    intro x hx
    unfold rhoHat
    exact div_pos (hbpos x hx) hZpos
  have hNpos : 0 < ∫ u in (Real.sqrt (2 * B.m1))..(Real.sqrt (2 * B.m2)), u ^ e * rhoHat B u :=
    intervalIntegral.intervalIntegral_pos_of_pos_on
      (((continuous_pow e).mul hrcont).intervalIntegrable _ _)
      (fun x hx => mul_pos (pow_pos (lt_trans ha0 hx.1) e) (hrpos x hx)) hab
  have hbvan : ∀ s : ℝ, (s ≤ Real.sqrt (2 * B.m1) ∨ Real.sqrt (2 * B.m2) ≤ s) → bHatE B e s = 0 := by
    intro s hs
    unfold bHatE
    rw [hvan s hs, zero_div]
  refine ⟨fun z t ht => ?_, fun ξ h1 h2 hX => ?_⟩
  · have hq : 0 < simScale B.h z (1 - t) := (hB.1.1 z (1 - t) (by linarith)).1
    have hσ : 0 < Real.sqrt (simScale B.h z (1 - t)) := Real.sqrt_pos.mpr hq
    have hpow : simScale B.h z (1 - t) ^ (-(((e:ℝ) + 1) / 2)) =
        ((Real.sqrt (simScale B.h z (1 - t)))⁻¹) ^ (e + 1) := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_neg hq.le, ← Real.rpow_natCast, ← Real.rpow_mul hq.le]
      congr 1
      push_cast
      ring
    have hpt : ∀ r : ℝ, r ^ e * bE B e (r, z, t, 0) =
        (Real.sqrt (simScale B.h z (1 - t)))⁻¹ *
          (((Real.sqrt (simScale B.h z (1 - t)))⁻¹ * r) ^ e *
            bHatE B e ((Real.sqrt (simScale B.h z (1 - t)))⁻¹ * r)) := by
      intro r
      show r ^ e * (simScale B.h z (1 - t) ^ (-(((e:ℝ) + 1) / 2)) *
        bHatE B e (r / Real.sqrt (simScale B.h z (1 - t)))) = _
      rw [hpow, div_eq_inv_mul, mul_pow, pow_succ]
      ring
    have hcv := MeasureTheory.integral_comp_mul_left_Ioi (fun x : ℝ => x ^ e * bHatE B e x) 0
      (inv_pos.mpr hσ)
    have hI : ∫ r in Set.Ioi (0:ℝ), r ^ e * bE B e (r, z, t, 0) =
        ∫ x in Set.Ioi (0:ℝ), x ^ e * bHatE B e x := by
      simp_rw [hpt]
      rw [MeasureTheory.integral_const_mul, hcv, mul_zero, inv_inv,
        smul_eq_mul, ← mul_assoc, inv_mul_cancel₀ hσ.ne', one_mul]
    have hsub : Set.Ioc (Real.sqrt (2 * B.m1)) (Real.sqrt (2 * B.m2)) ⊆ Set.Ioi (0:ℝ) :=
      fun x hx => lt_trans ha0 hx.1
    have hdiff : ∀ x ∈ Set.Ioi (0:ℝ) \ Set.Ioc (Real.sqrt (2 * B.m1)) (Real.sqrt (2 * B.m2)),
        x ^ e * bHatE B e x = 0 := by
      intro x hx
      rcases hx with ⟨-, hx1⟩
      simp only [Set.mem_Ioc, not_and_or, not_lt, not_le] at hx1
      rw [hbvan x (hx1.imp id le_of_lt), mul_zero]
    rw [hI, MeasureTheory.setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi hsub hdiff,
      ← intervalIntegral.integral_of_le hab.le]
    unfold bHatE
    simp_rw [← mul_div_assoc]
    rw [intervalIntegral.integral_div]
    exact div_self hNpos.ne'
  · have hq : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    have hσ : 0 < Real.sqrt (qC B.h ξ) := Real.sqrt_pos.mpr hq
    have hR : 0 < ξ.1 / Real.sqrt (qC B.h ξ) := div_pos h1 hσ
    have hR2 : (ξ.1 / Real.sqrt (qC B.h ξ)) ^ 2 = 2 * XC B.h ξ := by
      rw [div_pow, Real.sq_sqrt hq.le]
      unfold XC
      field_simp
    have hzero : bHatE B e (ξ.1 / Real.sqrt (qC B.h ξ)) = 0 := by
      apply hbvan
      rcases hX with hX | hX
      · left
        rw [← Real.sqrt_sq hR.le]
        exact Real.sqrt_le_sqrt (by rw [hR2]; linarith)
      · right
        rw [← Real.sqrt_sq hR.le]
        exact Real.sqrt_le_sqrt (by rw [hR2]; linarith)
    unfold bE
    rw [hzero, mul_zero]

theorem stp5_sig_shell_ode : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (α : ℝ) (e : ℕ), B.ok → (e = 1 ∨ e = 2) → InM B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) (FE5 B G l0 S e)) → (∀ z t : ℝ, t < 1 → (∫ r in Set.Ioi (0:ℝ), r ^ e * bE B e (r, z, t, 0)) = 1) → (∀ ξ : Cyl, 0 < ξ.1 → ξ.2.2.1 < 1 → (XC B.h ξ ≤ B.m1 ∨ B.m2 ≤ XC B.h ξ) → bE B e ξ = 0) → (∀ (V : Set (ℝ × ℝ)) (k : ℝ → ℝ × ℝ → ℝ) (a b c : ℝ), IsOpen V → c ∈ Set.Ioo a b → ContDiffOn ℝ ∞ (fun x : ℝ × (ℝ × ℝ) => k x.1 x.2) (Set.Ioo a b ×ˢ V) → ContDiffOn ℝ ∞ (fun x : ℝ × (ℝ × ℝ) => ∫ s in c..x.1, k s x.2) (Set.Ioo a b ×ˢ V)) → ContDiffOn ℝ ∞ (sigE5 B G l0 S e) (DomC B.h (qsOf l0)) ∧ (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → sigE5 B G l0 S e ξ = 0) ∧ (∀ ξ ∈ DomC B.h (qsOf l0), dR B.h (sigE5 B G l0 S e) ξ + (e : ℝ) / ξ.1 * sigE5 B G l0 S e ξ = -FE5 B G l0 S e ξ + bE B e ξ * ME5 B G l0 S e ξ.2.1 ξ.2.2.1) :=
by
  intro B G l0 S α e hB he hF hnorm hbE hPP

  have vanishA : ∀ (f g : ℝ → ℝ) (e : ℕ) (M r : ℝ), 0 ≤ r →
      (∀ s : ℝ, 0 < s → s ≤ r → f s = 0 ∧ g s = 0) →
      ∫ s in (0:ℝ)..r, s ^ e * (f s - g s * M) = 0 := by
    intro f g e M r hr H
    rw [intervalIntegral.integral_of_le hr]
    rw [setIntegral_congr_fun measurableSet_Ioc (g := fun _ => (0:ℝ)) ?_]
    · simp
    · intro s hs
      obtain ⟨h1, h2⟩ := H s hs.1 hs.2
      simp [h1, h2]
  have vanishB : ∀ (f g : ℝ → ℝ) (e : ℕ) (c r : ℝ), 0 < c → c ≤ r →
      ContinuousOn f (Ioi 0) → ContinuousOn g (Ioi 0) →
      (∀ s : ℝ, 0 < s → (s ≤ c ∨ r ≤ s) → f s = 0 ∧ g s = 0) →
      (∫ s in Ioi (0:ℝ), s ^ e * g s) = 1 →
      ∫ s in (0:ℝ)..r, s ^ e * (f s - g s * ∫ s' in Ioi (0:ℝ), s' ^ e * f s') = 0 := by
    intro f g e c r hc hcr hf hg H hn
    have hsub : ∀ x ∈ Ioi (0:ℝ) \ Icc c r, x ≤ c ∨ r ≤ x := by
      intro x hx
      rcases le_or_gt x c with h | h
      · exact Or.inl h
      · right
        by_contra h'
        push Not at h'
        exact hx.2 ⟨h.le, h'.le⟩
    have hIcc : Icc c r ⊆ Ioi (0:ℝ) := fun x hx => lt_of_lt_of_le hc hx.1
    have i1 : IntegrableOn (fun s => s ^ e * f s) (Ioi (0:ℝ)) := by
      apply IntegrableOn.of_forall_sdiff_eq_zero (s := Icc c r)
      · exact ContinuousOn.integrableOn_Icc ((continuousOn_pow e).mul (hf.mono hIcc))
      · exact measurableSet_Ioi
      · intro x hx
        simp [(H x hx.1 (hsub x hx)).1]
    have i2 : IntegrableOn (fun s => s ^ e * g s) (Ioi (0:ℝ)) := by
      apply IntegrableOn.of_forall_sdiff_eq_zero (s := Icc c r)
      · exact ContinuousOn.integrableOn_Icc ((continuousOn_pow e).mul (hg.mono hIcc))
      · exact measurableSet_Ioi
      · intro x hx
        simp [(H x hx.1 (hsub x hx)).2]
    set M := ∫ s' in Ioi (0:ℝ), s' ^ e * f s' with hM
    have hr0 : 0 ≤ r := (hc.le.trans hcr)
    rw [intervalIntegral.integral_of_le hr0]
    rw [← setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi Ioc_subset_Ioi_self ?_]
    · have e1 : ∫ s in Ioi (0:ℝ), s ^ e * (f s - g s * M) =
          ∫ s in Ioi (0:ℝ), (s ^ e * f s - M * (s ^ e * g s)) := by
        congr 1
        funext s
        ring
      rw [e1, integral_sub i1 (i2.const_mul M), integral_const_mul, hn, ← hM]
      ring
    · intro x hx
      have hx0 : 0 < x := hx.1
      have : r ≤ x := by
        by_contra h'
        push Not at h'
        exact hx.2 ⟨hx0, h'.le⟩
      obtain ⟨h1, h2⟩ := H x hx0 (Or.inr this)
      simp [h1, h2]
  have hderiv : ∀ (f g : ℝ → ℝ) (M : ℝ) (e : ℕ) (r ρ0 : ℝ), 1 ≤ e → 0 < r → 0 < ρ0 →
      ContinuousOn f (Ioi 0) → ContinuousOn g (Ioi 0) →
      (∀ s : ℝ, 0 < s → s ≤ ρ0 → f s = 0 ∧ g s = 0) →
      HasDerivAt (fun x : ℝ => -(x ^ e)⁻¹ * ∫ s in (0:ℝ)..x, s ^ e * (f s - g s * M))
        (-((e : ℝ) / r) * (-(r ^ e)⁻¹ * ∫ s in (0:ℝ)..r, s ^ e * (f s - g s * M)) - f r + g r * M) r := by
    intro f g M e r ρ0 he hr hρ0 hf hg H
    have hk : ContinuousOn (fun s => s ^ e * (f s - g s * M)) (Ioi 0) :=
      (continuousOn_pow e).mul (hf.sub (hg.mul continuousOn_const))
    have hc : 0 < min ρ0 r := lt_min hρ0 hr
    have int1 : IntervalIntegrable (fun s => s ^ e * (f s - g s * M)) volume 0 (min ρ0 r) := by
      rw [intervalIntegrable_iff, uIoc_of_le hc.le]
      refine (integrableOn_zero).congr_fun (fun s hs => ?_) measurableSet_Ioc
      obtain ⟨h1, h2⟩ := H s hs.1 (hs.2.trans (min_le_left _ _))
      simp [h1, h2]
    have int2 : IntervalIntegrable (fun s => s ^ e * (f s - g s * M)) volume (min ρ0 r) r := by
      apply ContinuousOn.intervalIntegrable
      apply hk.mono
      rw [uIcc_of_le (min_le_right _ _)]
      exact fun x hx => lt_of_lt_of_le hc hx.1
    have hI := intervalIntegral.integral_hasDerivAt_right (int1.trans int2)
      (hk.stronglyMeasurableAtFilter isOpen_Ioi r hr) (hk.continuousAt (isOpen_Ioi.mem_nhds hr))
    have hpow := hasDerivAt_pow e r
    have hinv := hpow.inv (pow_ne_zero e hr.ne')
    have hprod := hinv.neg.mul hI
    refine hprod.congr_deriv ?_
    simp only [Pi.neg_apply, Pi.inv_apply]
    generalize (∫ s in (0:ℝ)..r, s ^ e * (f s - g s * M)) = I
    obtain ⟨n, rfl⟩ : ∃ n, e = n + 1 := ⟨e - 1, by omega⟩
    simp only [Nat.add_sub_cancel]
    have hrn : r ^ n ≠ 0 := pow_ne_zero n hr.ne'
    push_cast
    field_simp
    ring
  have hproj : ∀ (Sg : ℝ × (ℝ × ℝ) → ℝ) (W : Set (ℝ × (ℝ × ℝ))), IsOpen W → ContDiffOn ℝ ∞ Sg W →
      ContDiffOn ℝ ∞ (fun η : Cyl => Sg (η.1, (η.2.1, η.2.2.1))) {η : Cyl | (η.1, (η.2.1, η.2.2.1)) ∈ W} ∧
      ∀ (ξ : Cyl) (w : ℝ × ℝ) (L : ℝ), (ξ.1, (ξ.2.1, ξ.2.2.1)) ∈ W →
        HasDerivAt (fun x : ℝ => Sg (x, (ξ.2.1, ξ.2.2.1))) L ξ.1 →
        fderiv ℝ (fun η : Cyl => Sg (η.1, (η.2.1, η.2.2.1))) ξ (1, 0, 0, w) = L := by
    intro Sg W hW hSg
    let πL : Cyl →L[ℝ] ℝ × (ℝ × ℝ) :=
      (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))).prod
        (((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))).prod
          ((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
            (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))))))
    refine ⟨hSg.comp_continuousLinearMap πL, ?_⟩
    intro ξ w L hξ hL
    have hd : HasFDerivAt Sg (fderiv ℝ Sg (πL ξ)) (πL ξ) :=
      ((hSg.contDiffAt (hW.mem_nhds hξ)).differentiableAt (by simp)).hasFDerivAt
    have hcomp : HasFDerivAt (fun η : Cyl => Sg (η.1, (η.2.1, η.2.2.1))) ((fderiv ℝ Sg (πL ξ)).comp πL) ξ :=
      hd.comp ξ πL.hasFDerivAt
    rw [hcomp.fderiv]
    have hγ : HasDerivAt (fun x : ℝ => ((x, (ξ.2.1, ξ.2.2.1)) : ℝ × (ℝ × ℝ))) ((1:ℝ), ((0:ℝ), (0:ℝ))) ξ.1 :=
      (hasDerivAt_id' ξ.1).prodMk (hasDerivAt_const _ _)
    have h2 := hd.comp_hasDerivAt ξ.1 hγ
    exact h2.unique hL
  have hradprim : ∀ (U : Set (ℝ × ℝ)) (f g : ℝ → ℝ × ℝ → ℝ) (e : ℕ), IsOpen U →
      ContDiffOn ℝ ∞ (fun x : ℝ × (ℝ × ℝ) => f x.1 x.2) (Set.Ioi 0 ×ˢ U) →
      ContDiffOn ℝ ∞ (fun x : ℝ × (ℝ × ℝ) => g x.1 x.2) (Set.Ioi 0 ×ˢ U) →
      (∀ p0 ∈ U, ∃ V : Set (ℝ × ℝ), IsOpen V ∧ p0 ∈ V ∧ V ⊆ U ∧ ∃ ρ0 ρ1 : ℝ, 0 < ρ0 ∧ ρ0 < ρ1 ∧
        ∀ p ∈ V, ∀ s : ℝ, 0 < s → (s ≤ ρ0 ∨ ρ1 ≤ s) → f s p = 0 ∧ g s p = 0) →
      (∀ (V : Set (ℝ × ℝ)) (k : ℝ → ℝ × ℝ → ℝ) (a b c : ℝ), IsOpen V → c ∈ Set.Ioo a b →
        ContDiffOn ℝ ∞ (fun x : ℝ × (ℝ × ℝ) => k x.1 x.2) (Set.Ioo a b ×ˢ V) →
        ContDiffOn ℝ ∞ (fun x : ℝ × (ℝ × ℝ) => ∫ s in c..x.1, k s x.2) (Set.Ioo a b ×ˢ V)) →
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => ∫ s in Set.Ioi (0:ℝ), s ^ e * f s p) U ∧
      ContDiffOn ℝ ∞ (fun x : ℝ × (ℝ × ℝ) => -(x.1 ^ e)⁻¹ * ∫ s in (0:ℝ)..x.1,
        s ^ e * (f s x.2 - g s x.2 * ∫ s' in Set.Ioi (0:ℝ), s' ^ e * f s' x.2)) (Set.Ioi 0 ×ˢ U) := by
    intro U f g e hU hf hg hsupp hPP
    have hM : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => ∫ s in Set.Ioi (0:ℝ), s ^ e * f s p) U := by
      apply contDiffOn_of_locally_contDiffOn
      intro p0 hp0
      obtain ⟨V, hVo, hp0V, hVU, ρ0, ρ1, hρ0, hρ01, hV⟩ := hsupp p0 hp0
      refine ⟨V, hVo, hp0V, ?_⟩
      have hsub : Ioo (0:ℝ) (ρ1 + 1) ×ˢ V ⊆ Ioi 0 ×ˢ U := prod_mono Ioo_subset_Ioi_self hVU
      have hk : ContDiffOn ℝ ∞ (fun x : ℝ × (ℝ × ℝ) => x.1 ^ e * f x.1 x.2) (Ioo (0:ℝ) (ρ1 + 1) ×ˢ V) :=
        (contDiffOn_fst.pow e).mul (hf.mono hsub)
      have hΦ := hPP V (fun s p => s ^ e * f s p) 0 (ρ1 + 1) ρ0 hVo ⟨hρ0, by linarith⟩ hk
      have hι : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => ((ρ1, p) : ℝ × (ℝ × ℝ))) V :=
        contDiffOn_const.prodMk contDiffOn_id
      have hΦι := hΦ.comp hι (fun p hp => ⟨⟨by linarith, by linarith⟩, hp⟩)
      refine (hΦι.mono inter_subset_right).congr (fun p hp => ?_)
      show (∫ s in Set.Ioi (0:ℝ), s ^ e * f s p) = ∫ s in ρ0..ρ1, s ^ e * f s p
      rw [intervalIntegral.integral_of_le hρ01.le]
      apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi
      · exact fun x hx => lt_trans hρ0 hx.1
      · intro x hx
        have hx0 : 0 < x := hx.1
        have hor : x ≤ ρ0 ∨ ρ1 ≤ x := by
