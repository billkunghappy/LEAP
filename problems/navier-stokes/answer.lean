  have line_fd : ∀ (f : ℝ × ℝ × ℝ → ℝ) (g : ℝ → ℝ) (s : ℝ × ℝ × ℝ) (g' : ℝ), 0 < s.1 →
      DifferentiableAt ℝ f s → HasDerivAt g g' s.1 →
      (∀ r' : ℝ, 0 < r' → f (r', s.2.1, s.2.2) = g r') →
      fderiv ℝ f s ((1:ℝ), (0:ℝ), (0:ℝ)) = g' := by
    intro f g s g' hs hf hg heq
    have hl : HasDerivAt (fun r' : ℝ => (r', s.2.1, s.2.2)) ((1:ℝ), (0:ℝ), (0:ℝ)) s.1 :=
      (hasDerivAt_id' s.1).prodMk ((hasDerivAt_const s.1 _).prodMk (hasDerivAt_const s.1 _))
    have h1 : HasDerivAt (f ∘ fun r' : ℝ => (r', s.2.1, s.2.2)) (fderiv ℝ f s ((1:ℝ), (0:ℝ), (0:ℝ))) s.1 :=
      hf.hasFDerivAt.comp_hasDerivAt s.1 hl
    have h2 : (f ∘ fun r' : ℝ => (r', s.2.1, s.2.2)) =ᶠ[nhds s.1] g := by
      filter_upwards [Ioi_mem_nhds hs] with r' hr'
      exact heq r' hr'
    exact (h2.hasDerivAt_iff.mp h1).unique hg

  have rep_line : ∀ (G : ℝ → ℝ) (a q Q r G' : ℝ), 0 < q → 0 < Q → 0 < r →
      HasDerivAt G G' (r ^ 2 / (2 * q)) →
      HasDerivAt (fun r' : ℝ => a * G (r' ^ 2 / (2 * q)) / (r' / Real.sqrt Q))
        ((a * (G' * (r / q)) * (r / Real.sqrt Q) - a * G (r ^ 2 / (2 * q)) * (1 / Real.sqrt Q)) /
          (r / Real.sqrt Q) ^ 2) r ∧
      HasDerivAt (fun r' : ℝ => a * G (r' ^ 2 / (2 * q))) (a * (G' * (r / q))) r := by
    intro G a q Q r G' hq hQ hr hG
    have hκ : HasDerivAt (fun r' : ℝ => r' ^ 2 / (2 * q)) (r / q) r := by
      have := (hasDerivAt_pow 2 r).div_const (2 * q)
      convert this using 1
      field_simp
      ring
    have hc : HasDerivAt (fun r' : ℝ => G (r' ^ 2 / (2 * q))) (G' * (r / q)) r := hG.comp r hκ
    have h2 := hc.const_mul a
    have hd : HasDerivAt (fun r' : ℝ => r' / Real.sqrt Q) (1 / Real.sqrt Q) r := (hasDerivAt_id' r).div_const _
    have hsQ : 0 < Real.sqrt Q := Real.sqrt_pos.mpr hQ
    have hne : r / Real.sqrt Q ≠ 0 := (div_pos hr hsQ).ne'
    exact ⟨h2.div hd hne, h2⟩

  have base_w : ∀ (h q Q : ℝ), 0 < h → h < 1/100 → 0 < Q → Q ≤ 1 → 1/2 < q / Q → q / Q < 2 →
      Q ^ (1/2 + h) * q ^ (-(1/2 + h)) * Real.sqrt Q = (q / Q) ^ (-(1 + h)) * Real.sqrt q ∧
      0 ≤ (q / Q) ^ (-(1 + h)) ∧ (q / Q) ^ (-(1 + h)) ≤ 4 ∧ q ^ (2 * h) ≤ 2 * Q ^ h := by
    intro h q Q hh hh1 hQ hQ1 hρ1 hρ2
    obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = q / Q := ⟨_, rfl⟩
    have hqρ : q = ρ * Q := by rw [hρ]; field_simp
    rw [← hρ] at hρ1 hρ2 ⊢
    subst hqρ
    have hρ0 : 0 < ρ := by linarith
    have e1 : Q ^ (1/2 + h) * Q ^ (-(1/2 + h)) = 1 := by
      rw [← Real.rpow_add hQ]; simp
    have e2 : ρ ^ (-(1 + h)) * Real.sqrt ρ = ρ ^ (-(1/2 + h)) := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_add hρ0]; congr 1; ring
    refine ⟨?_, Real.rpow_nonneg hρ0.le _, ?_, ?_⟩
    · calc Q ^ (1/2 + h) * (ρ * Q) ^ (-(1/2 + h)) * Real.sqrt Q
          = (Q ^ (1/2 + h) * Q ^ (-(1/2 + h))) * ρ ^ (-(1/2 + h)) * Real.sqrt Q := by
            rw [Real.mul_rpow hρ0.le hQ.le]; ring
        _ = ρ ^ (-(1/2 + h)) * Real.sqrt Q := by rw [e1]; ring
        _ = ρ ^ (-(1 + h)) * Real.sqrt (ρ * Q) := by
            rw [← e2, Real.sqrt_mul hρ0.le]; ring
    · have h1 : ρ ^ (-(1 + h)) ≤ (1/2 : ℝ) ^ (-(1 + h)) :=
        Real.rpow_le_rpow_of_nonpos (by norm_num) hρ1.le (by linarith)
      have h2 : (1/2 : ℝ) ^ (-(1 + h)) = (2:ℝ) ^ (1 + h) := by
        rw [show (1/2:ℝ) = 2⁻¹ by norm_num, Real.inv_rpow (by norm_num), Real.rpow_neg (by norm_num), inv_inv]
      have h3 : (2:ℝ) ^ (1 + h) ≤ (2:ℝ) ^ (2:ℝ) :=
        Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
      have h4 : (2:ℝ) ^ (2:ℝ) = 4 := by rw [Real.rpow_two]; norm_num
      linarith
    · rw [Real.mul_rpow hρ0.le hQ.le]
      have h1 : ρ ^ (2 * h) ≤ (2:ℝ) ^ (2 * h) := Real.rpow_le_rpow hρ0.le hρ2.le (by linarith)
      have h2 : (2:ℝ) ^ (2 * h) ≤ (2:ℝ) ^ (1:ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
      have h3 : Q ^ (2 * h) ≤ Q ^ h := Real.rpow_le_rpow_of_exponent_ge hQ hQ1 (by linarith)
      rw [Real.rpow_one] at h2
      exact mul_le_mul (h1.trans h2) h3 (Real.rpow_nonneg hQ.le _) (by norm_num)

  have eta_unit : ∀ (h q z : ℝ), 0 < q → z ^ 2 < q ^ (1 - 2 * h) →
      -1 < z * q ^ (-(1/2 - h)) ∧ z * q ^ (-(1/2 - h)) < 1 := by
    intro h q z hq hz
    have e : (q ^ (-(1/2 - h))) ^ 2 * q ^ (1 - 2 * h) = 1 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hq.le, ← Real.rpow_add hq,
        show (-(1/2 - h)) * ((2:ℕ):ℝ) + (1 - 2 * h) = 0 by push_cast; ring, Real.rpow_zero]
    have hp : 0 < q ^ (-(1/2 - h)) := Real.rpow_pos_of_pos hq _
    have h2 : (z * q ^ (-(1/2 - h))) ^ 2 < 1 := by
      rw [mul_pow]
      calc z ^ 2 * (q ^ (-(1/2 - h))) ^ 2 < q ^ (1 - 2 * h) * (q ^ (-(1/2 - h))) ^ 2 :=
            mul_lt_mul_of_pos_right hz (by positivity)
        _ = 1 := by rw [mul_comm]; exact e
    have := abs_lt.mp ((sq_lt_one_iff_abs_lt_one _).mp h2)
    exact ⟨this.1, this.2⟩

  have r_alg : ∀ (Q q r a w F0 FX UX E0 E1 U1 K Sa Sb DFa DB : ℝ), 0 < Q → 0 < q → 0 < r →
      a * Real.sqrt Q = w * Real.sqrt q → 0 ≤ w → w ≤ 4 → 0 < Sa →
      Sa ≤ Real.sqrt (2 * (r ^ 2 / (2 * q))) → Real.sqrt (2 * (r ^ 2 / (2 * q))) ≤ Sb → 0 ≤ K →
      |E0 - Real.sqrt (2 * (r ^ 2 / (2 * q))) * F0| ≤ K →
      |E1 - (Real.sqrt (2 * (r ^ 2 / (2 * q))) * FX + F0 / Real.sqrt (2 * (r ^ 2 / (2 * q))))| ≤ K →
      |U1 - UX| ≤ K →
      DFa = (a * (E1 * (r / q)) * (r / Real.sqrt Q) - a * E0 * (1 / Real.sqrt Q)) / (r / Real.sqrt Q) ^ 2 →
      DB = a * (U1 * (r / q)) →
      |a * E0 / (r / Real.sqrt Q) - w * F0| ≤ 4 * K / Sa ∧
      |r / Real.sqrt Q * (Real.sqrt Q * DFa) - w * (2 * (r ^ 2 / (2 * q)) * FX)| ≤
        4 * (Sb * K + K / Sa) ∧
      |Real.sqrt Q * DB - w * (Real.sqrt (2 * (r ^ 2 / (2 * q))) * UX)| ≤ 4 * Sb * K ∧
      r / Real.sqrt Q = Real.sqrt (2 * (r ^ 2 / (2 * q)) * (q / Q)) := by
    intro Q q r a w F0 FX UX E0 E1 U1 K Sa Sb DFa DB hQ hq hr haw hw0 hw4 hSa hSa' hSb hK h0 h1 h2 hDFa hDB
    have hsQ : 0 < Real.sqrt Q := Real.sqrt_pos.mpr hQ
    have hsq : 0 < Real.sqrt q := Real.sqrt_pos.mpr hq
    have hsq2 : Real.sqrt q ^ 2 = q := Real.sq_sqrt hq.le
    have hsQ2 : Real.sqrt Q ^ 2 = Q := Real.sq_sqrt hQ.le
    have hS : Real.sqrt (2 * (r ^ 2 / (2 * q))) = r / Real.sqrt q := by
      rw [show 2 * (r ^ 2 / (2 * q)) = (r / Real.sqrt q) ^ 2 by rw [div_pow, hsq2]; field_simp]
      exact Real.sqrt_sq (div_pos hr hsq).le
    have hS4 : r / Real.sqrt Q = Real.sqrt (2 * (r ^ 2 / (2 * q)) * (q / Q)) := by
      rw [show 2 * (r ^ 2 / (2 * q)) * (q / Q) = (r / Real.sqrt Q) ^ 2 by rw [div_pow, hsQ2]; field_simp]
      exact (Real.sqrt_sq (div_pos hr hsQ).le).symm
    rw [hS] at hSa' hSb h0 h1 ⊢
    set S := r / Real.sqrt q with hSdef
    have hSpos : 0 < S := div_pos hr hsq
    have ha : a = w * Real.sqrt q / Real.sqrt Q := by
      rw [eq_div_iff hsQ.ne']; exact haw
    have i1 : a * E0 / (r / Real.sqrt Q) - w * F0 = w * ((E0 - S * F0) / S) := by
      rw [ha, hSdef]; field_simp <;> ring
    have i2 : r / Real.sqrt Q * (Real.sqrt Q * DFa) - w * (2 * (r ^ 2 / (2 * q)) * FX) =
        w * (S * (E1 - (S * FX + F0 / S)) - (E0 - S * F0) / S) := by
      rw [hDFa, ha, hSdef]
      generalize Real.sqrt q = sq at hsq hsq2 ⊢
      generalize Real.sqrt Q = sQ at hsQ ⊢
      subst hsq2
      field_simp
      ring
    have i3 : Real.sqrt Q * DB - w * (S * UX) = w * (S * (U1 - UX)) := by
      rw [hDB, ha, hSdef]
      generalize Real.sqrt q = sq at hsq hsq2 ⊢
      generalize Real.sqrt Q = sQ at hsQ ⊢
      subst hsq2
      field_simp <;> ring
    have b0 : |E0 - S * F0| / S ≤ K / Sa := div_le_div₀ hK h0 hSa hSa'
    have b1 : S * |E1 - (S * FX + F0 / S)| ≤ Sb * K :=
      mul_le_mul hSb h1 (abs_nonneg _) (hSa.le.trans (hSa'.trans hSb))
    have b2 : S * |U1 - UX| ≤ Sb * K :=
      mul_le_mul hSb h2 (abs_nonneg _) (hSa.le.trans (hSa'.trans hSb))
    refine ⟨?_, ?_, ?_, hS4⟩
    · rw [i1, abs_mul, abs_div, abs_of_nonneg hw0, abs_of_pos hSpos]
      calc w * (|E0 - S * F0| / S) ≤ 4 * (K / Sa) :=
            mul_le_mul hw4 b0 (div_nonneg (abs_nonneg _) hSpos.le) (by norm_num)
        _ = 4 * K / Sa := by ring
    · rw [i2, abs_mul, abs_of_nonneg hw0]
      have t : |S * (E1 - (S * FX + F0 / S)) - (E0 - S * F0) / S| ≤ Sb * K + K / Sa := by
        calc _ ≤ |S * (E1 - (S * FX + F0 / S))| + |(E0 - S * F0) / S| := abs_sub _ _
          _ = S * |E1 - (S * FX + F0 / S)| + |E0 - S * F0| / S := by
              rw [abs_mul, abs_of_pos hSpos, abs_div, abs_of_pos hSpos]
          _ ≤ Sb * K + K / Sa := add_le_add b1 b0
      exact mul_le_mul hw4 t (abs_nonneg _) (by norm_num)
    · rw [i3, abs_mul, abs_of_nonneg hw0, abs_mul, abs_of_pos hSpos]
      calc w * (S * |U1 - UX|) ≤ 4 * (Sb * K) :=
            mul_le_mul hw4 b2 (mul_nonneg hSpos.le (abs_nonneg _)) (by norm_num)
        _ = 4 * Sb * K := by ring

  obtain ⟨hS, ⟨hh0, hh1, hXa0, -, -, -, -, -, -, -, -, -, -⟩, ⟨hFs, hUs, -, -⟩, -, -, -, hrep,
    ⟨hEs, hUbs, -, hRem⟩, -⟩ := hB
  have hXa2 : 0 < B.Xa / 2 := by linarith
  obtain ⟨C0, hC0⟩ := hRem (B.Xa / 2) (2 * B.Xb) hXa2 0
  obtain ⟨C1, hC1⟩ := hRem (B.Xa / 2) (2 * B.Xb) hXa2 1
  obtain ⟨K0, hK0⟩ : ∃ K0 : ℝ, K0 = |C0| + |C1| := ⟨_, rfl⟩
  have hK00 : 0 ≤ K0 := by rw [hK0]; positivity
  have hC0K : C0 ≤ K0 := by rw [hK0]; linarith [le_abs_self C0, abs_nonneg C1]
  have hC1K : C1 ≤ K0 := by rw [hK0]; linarith [le_abs_self C1, abs_nonneg C0]
  obtain ⟨Sa, hSadef⟩ : ∃ Sa : ℝ, Sa = Real.sqrt B.Xa := ⟨_, rfl⟩
  obtain ⟨Sb, hSbdef⟩ : ∃ Sb : ℝ, Sb = Real.sqrt (4 * B.Xb) := ⟨_, rfl⟩
  have hSa : 0 < Sa := by rw [hSadef]; exact Real.sqrt_pos.mpr hXa0
  have hSb0 : 0 ≤ Sb := by rw [hSbdef]; exact Real.sqrt_nonneg _
  have hA1 : 0 ≤ 8 * K0 / Sa := div_nonneg (by linarith) hSa.le
  have hA2 : 0 ≤ 8 * (Sb * K0 + K0 / Sa) :=
    mul_nonneg (by norm_num) (add_nonneg (mul_nonneg hSb0 hK00) (div_nonneg hK00 hSa.le))
  have hA3 : 0 ≤ 8 * Sb * K0 := mul_nonneg (mul_nonneg (by norm_num) hSb0) hK00
  refine ⟨8 * K0 / Sa + 8 * (Sb * K0 + K0 / Sa) + 8 * Sb * K0, by linarith, ?_⟩
  intro l ξ hdom hρ1 hρ2 hX1 hX2

  have hr : 0 < ξ.1 := hdom.1
  have hq0 : 0 < qC B.h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hdom.2.1])).1
  have hz2 : ξ.2.1 ^ 2 < qC B.h ξ ^ (1 - 2 * B.h) := (hS.2.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hdom.2.1])).2
  obtain ⟨hη1, hη2⟩ := eta_unit B.h (qC B.h ξ) ξ.2.1 hq0 hz2
  have hη1' : -1 < etaC B.h ξ := hη1
  have hη2' : etaC B.h ξ < 1 := hη2
  have hQ0 : 0 < Qb l := by unfold Qb; positivity
  have hQ1 : Qb l ≤ 1 := by
    show (2:ℝ) ^ (-(l:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hsQ : 0 < Real.sqrt (Qb l) := Real.sqrt_pos.mpr hQ0
  obtain ⟨haw, hw0, hw4, hqQ⟩ := base_w B.h (qC B.h ξ) (Qb l) hh0 hh1 hQ0 hQ1 hρ1 hρ2
  have hX0 : 0 < XC B.h ξ := by linarith
  have h2X : (2:ℝ) * XC B.h ξ ≠ 0 := (mul_pos two_pos hX0).ne'
  have hXe : XC B.h ξ = ξ.1 ^ 2 / (2 * qC B.h ξ) := rfl

  have rep : ∀ r' : ℝ, 0 < r' →
      pcB5 B l 1 (r', ξ.2.1, ξ.2.2.1) = Qb l ^ (1/2 + B.h) * qC B.h ξ ^ (-(1/2 + B.h)) *
        B.Eb (qC B.h ξ) (r' ^ 2 / (2 * qC B.h ξ)) (etaC B.h ξ) ∧
      pcB5 B l 2 (r', ξ.2.1, ξ.2.2.1) = Qb l ^ (1/2 + B.h) * qC B.h ξ ^ (-(1/2 + B.h)) *
        B.Ub (qC B.h ξ) (r' ^ 2 / (2 * qC B.h ξ)) (etaC B.h ξ) := by
    intro r' hr'
    have h0 : (rotPt r' 0 ξ.2.1) 0 = r' := by simp [rotPt]
    have h1 : (rotPt r' 0 ξ.2.1) 1 = 0 := by simp [rotPt]
    have h2 : (rotPt r' 0 ξ.2.1) 2 = ξ.2.1 := by simp [rotPt]
    have hpos : 0 < (rotPt r' 0 ξ.2.1) 0 ^ 2 + (rotPt r' 0 ξ.2.1) 1 ^ 2 := by rw [h0, h1]; positivity
    have hmem : (rotPt r' 0 ξ.2.1, ξ.2.2.1) ∈ simDomain B.h B.qB := by
      show ξ.2.2.1 < 1 ∧ simScale B.h ((rotPt r' 0 ξ.2.1) 2) (1 - ξ.2.2.1) < B.qB
      rw [h2]; exact ⟨hdom.2.1, hdom.2.2⟩
    obtain ⟨c1, c2, -⟩ := hrep _ _ hmem hpos
    have hsimS : simScale B.h ((rotPt r' 0 ξ.2.1) 2) (1 - ξ.2.2.1) = qC B.h ξ := by rw [h2]; rfl
    have hsimX : simX B.h (rotPt r' 0 ξ.2.1) ξ.2.2.1 = r' ^ 2 / (2 * qC B.h ξ) := by
      unfold simX; rw [hsimS, h0, h1]; ring
    have hsimE : simEta B.h (rotPt r' 0 ξ.2.1) ξ.2.2.1 = etaC B.h ξ := by
      unfold simEta; rw [hsimS, h2]; rfl
    rw [hsimS, hsimX, hsimE] at c1 c2
    have c1' : inner ℝ (uB B (rotPt r' 0 ξ.2.1) ξ.2.2.1) (azVec (rotPt r' 0 ξ.2.1)) =
        rad (rotPt r' 0 ξ.2.1) * qC B.h ξ ^ (-(1 / 2 + B.h)) *
          B.Eb (qC B.h ξ) (r' ^ 2 / (2 * qC B.h ξ)) (etaC B.h ξ) := c1
    have c2' : (uB B (rotPt r' 0 ξ.2.1) ξ.2.2.1) 2 =
        qC B.h ξ ^ (-(1 / 2 + B.h)) * B.Ub (qC B.h ξ) (r' ^ 2 / (2 * qC B.h ξ)) (etaC B.h ξ) := c2
    have hradpos : 0 < rad (rotPt r' 0 ξ.2.1) := Real.sqrt_pos.mpr hpos
    constructor
    · show Qb l ^ (1/2 + B.h) * inner ℝ (uB B (rotPt r' 0 ξ.2.1) ξ.2.2.1) (eTh (rotPt r' 0 ξ.2.1)) = _
      unfold eTh
      rw [real_inner_smul_right, c1', mul_assoc (rad (rotPt r' 0 ξ.2.1)),
        inv_mul_cancel_left₀ hradpos.ne']
      ring
    · show Qb l ^ (1/2 + B.h) * inner ℝ (uB B (rotPt r' 0 ξ.2.1) ξ.2.2.1) eZ = _
      unfold eZ
      rw [EuclideanSpace.inner_single_right]
      simp only [one_mul, conj_trivial]
      rw [c2']
      ring

  have hsΩ : (ξ.1, ξ.2.1, ξ.2.2.1) ∈
      {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} :=
    ⟨hdom.1, hdom.2.1, hdom.2.2⟩
  have hdB : ∀ i : Fin 3, DifferentiableAt ℝ (pcB5 B l i) (ξ.1, ξ.2.1, ξ.2.2.1) := fun i =>
    ((geom.2 l i).contDiffAt (geom.1.mem_nhds hsΩ)).differentiableAt (by norm_num)
  have hdRC : DifferentiableAt ℝ (pcRC5 l) (ξ.1, ξ.2.1, ξ.2.2.1) := by
    show DifferentiableAt ℝ (fun s : ℝ × ℝ × ℝ => s.1 / Real.sqrt (Qb l)) _
    fun_prop
  have hRCne : pcRC5 l (ξ.1, ξ.2.1, ξ.2.2.1) ≠ 0 := (div_pos hr hsQ).ne'
  have hdFa : DifferentiableAt ℝ (pcFa5 B l) (ξ.1, ξ.2.1, ξ.2.2.1) := by
    have e : pcFa5 B l = pcB5 B l 1 * (pcRC5 l)⁻¹ := by
      funext s; simp [pcFa5, div_eq_mul_inv]
    rw [e]
    exact (hdB 1).mul (hdRC.inv hRCne)

  have hO : IsOpen (Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) :=
    isOpen_Iio.prod (isOpen_Ioi.prod isOpen_Ioo)
  have hp : (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) ∈ Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) :=
    ⟨Real.log_lt_log hq0 hdom.2.2, hX0, hη1', hη2'⟩
  have hEd : DifferentiableAt ℝ (logLift B.Eb) (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) :=
    (hEs.contDiffAt (hO.mem_nhds hp)).differentiableAt (by norm_num)
  have hUbd : DifferentiableAt ℝ (logLift B.Ub) (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) :=
    (hUbs.contDiffAt (hO.mem_nhds hp)).differentiableAt (by norm_num)
  have hO2 : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hp2 : (XC B.h ξ, etaC B.h ξ) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := ⟨hX0, hη1', hη2'⟩
  have hFd : DifferentiableAt ℝ (↿B.F) (XC B.h ξ, etaC B.h ξ) :=
    (hFs.contDiffAt (hO2.mem_nhds hp2)).differentiableAt (by norm_num)
  have hUd : DifferentiableAt ℝ (↿B.U) (XC B.h ξ, etaC B.h ξ) :=
    (hUs.contDiffAt (hO2.mem_nhds hp2)).differentiableAt (by norm_num)
  have hproj : DifferentiableAt ℝ (fun w : ℝ × ℝ × ℝ => (w.2.1, w.2.2))
      (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) := by fun_prop
  have hFc : DifferentiableAt ℝ (fun w : ℝ × ℝ × ℝ => B.F w.2.1 w.2.2)
      (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) :=
    DifferentiableAt.comp (g := ↿B.F) (f := fun w : ℝ × ℝ × ℝ => (w.2.1, w.2.2)) _ hFd hproj
  have hUc : DifferentiableAt ℝ (fun w : ℝ × ℝ × ℝ => B.U w.2.1 w.2.2)
      (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) :=
    DifferentiableAt.comp (g := ↿B.U) (f := fun w : ℝ × ℝ × ℝ => (w.2.1, w.2.2)) _ hUd hproj
  have hsqd : DifferentiableAt ℝ (fun w : ℝ × ℝ × ℝ => Real.sqrt (2 * w.2.1))
      (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) := by
    refine DifferentiableAt.sqrt ?_ h2X
    fun_prop
  have hPd : DifferentiableAt ℝ (fun w : ℝ × ℝ × ℝ => Real.sqrt (2 * w.2.1) * B.F w.2.1 w.2.2)
      (Real.log (qC B.h ξ), XC B.h ξ, etaC B.h ξ) := hsqd.mul hFc
  obtain ⟨b0E, b0U, -⟩ := hC0 (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) hq0 hdom.2.2 hX1 hX2 hη1' hη2'
  obtain ⟨b1E, b1U, -⟩ := hC1 (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) hq0 hdom.2.2 hX1 hX2 hη1' hη2'
  have hqp : 0 ≤ qC B.h ξ ^ (2 * B.h) := Real.rpow_nonneg hq0.le _
  have hk0 : C0 * qC B.h ξ ^ (2 * B.h) ≤ K0 * qC B.h ξ ^ (2 * B.h) := mul_le_mul_of_nonneg_right hC0K hqp
  have hk1 : C1 * qC B.h ξ ^ (2 * B.h) ≤ K0 * qC B.h ξ ^ (2 * B.h) := mul_le_mul_of_nonneg_right hC1K hqp
  obtain ⟨hEdiff, hEval, hEder⟩ := slice B.Eb (fun X η => Real.sqrt (2 * X) * B.F X η) (qC B.h ξ) (XC B.h ξ)
    (etaC B.h ξ) (K0 * qC B.h ξ ^ (2 * B.h)) hq0 hEd hPd (b0E.trans hk0) (b1E.trans hk1)
  obtain ⟨hUdiff, -, hUder⟩ := slice B.Ub B.U (qC B.h ξ) (XC B.h ξ)
    (etaC B.h ξ) (K0 * qC B.h ξ ^ (2 * B.h)) hq0 hUbd hUc (b0U.trans hk0) (b1U.trans hk1)
  have hEval' : |B.Eb (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) -
      Real.sqrt (2 * XC B.h ξ) * B.F (XC B.h ξ) (etaC B.h ξ)| ≤ K0 * qC B.h ξ ^ (2 * B.h) := hEval
  have hEder' : |deriv (fun Y => B.Eb (qC B.h ξ) Y (etaC B.h ξ)) (XC B.h ξ) -
      deriv (fun Y => Real.sqrt (2 * Y) * B.F Y (etaC B.h ξ)) (XC B.h ξ)| ≤ K0 * qC B.h ξ ^ (2 * B.h) := hEder

  have hFXd : DifferentiableAt ℝ (fun Y => B.F Y (etaC B.h ξ)) (XC B.h ξ) :=
    DifferentiableAt.comp (g := ↿B.F) (f := fun Y : ℝ => (Y, etaC B.h ξ)) (XC B.h ξ) hFd (by fun_prop)
  have hsqrt : HasDerivAt (fun Y : ℝ => Real.sqrt (2 * Y)) (1 / Real.sqrt (2 * XC B.h ξ)) (XC B.h ξ) := by
    have := ((hasDerivAt_id' (XC B.h ξ)).const_mul 2).sqrt h2X
    convert this using 1
    exact (mul_div_mul_left (1:ℝ) (Real.sqrt (2 * XC B.h ξ)) two_ne_zero).symm
  have hprod : HasDerivAt (fun Y => Real.sqrt (2 * Y) * B.F Y (etaC B.h ξ))
      (1 / Real.sqrt (2 * XC B.h ξ) * B.F (XC B.h ξ) (etaC B.h ξ) +
        Real.sqrt (2 * XC B.h ξ) * deriv (fun Y => B.F Y (etaC B.h ξ)) (XC B.h ξ)) (XC B.h ξ) :=
    hsqrt.mul hFXd.hasDerivAt
  have hPder : deriv (fun Y => Real.sqrt (2 * Y) * B.F Y (etaC B.h ξ)) (XC B.h ξ) =
      Real.sqrt (2 * XC B.h ξ) * deriv (fun Y => B.F Y (etaC B.h ξ)) (XC B.h ξ) +
        B.F (XC B.h ξ) (etaC B.h ξ) / Real.sqrt (2 * XC B.h ξ) := by
    rw [hprod.deriv]; ring
  rw [hPder] at hEder'

  obtain ⟨hFaLine, -⟩ := rep_line (fun Y => B.Eb (qC B.h ξ) Y (etaC B.h ξ))
    (Qb l ^ (1/2 + B.h) * qC B.h ξ ^ (-(1/2 + B.h))) (qC B.h ξ) (Qb l) ξ.1
    (deriv (fun Y => B.Eb (qC B.h ξ) Y (etaC B.h ξ)) (XC B.h ξ)) hq0 hQ0 hr hEdiff.hasDerivAt
  obtain ⟨-, hBLine⟩ := rep_line (fun Y => B.Ub (qC B.h ξ) Y (etaC B.h ξ))
    (Qb l ^ (1/2 + B.h) * qC B.h ξ ^ (-(1/2 + B.h))) (qC B.h ξ) (Qb l) ξ.1
    (deriv (fun Y => B.Ub (qC B.h ξ) Y (etaC B.h ξ)) (XC B.h ξ)) hq0 hQ0 hr hUdiff.hasDerivAt
  have hfdFa := line_fd (pcFa5 B l) _ (ξ.1, ξ.2.1, ξ.2.2.1) _ hr hdFa hFaLine (by
    intro r' hr'
    show pcB5 B l 1 (r', ξ.2.1, ξ.2.2.1) / pcRC5 l (r', ξ.2.1, ξ.2.2.1) = _
    rw [(rep r' hr').1]
    rfl)
  have hfdB := line_fd (pcB5 B l 2) _ (ξ.1, ξ.2.1, ξ.2.2.1) _ hr (hdB 2) hBLine (by
    intro r' hr'
    show pcB5 B l 2 (r', ξ.2.1, ξ.2.2.1) = _
    rw [(rep r' hr').2])
  have hFaval : pcFa5 B l (ξ.1, ξ.2.1, ξ.2.2.1) = Qb l ^ (1/2 + B.h) * qC B.h ξ ^ (-(1/2 + B.h)) *
      B.Eb (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ) / (ξ.1 / Real.sqrt (Qb l)) := by
    show pcB5 B l 1 (ξ.1, ξ.2.1, ξ.2.2.1) / pcRC5 l (ξ.1, ξ.2.1, ξ.2.2.1) = _
    rw [(rep ξ.1 hr).1]
    rfl

  have hSa' : Sa ≤ Real.sqrt (2 * (ξ.1 ^ 2 / (2 * qC B.h ξ))) := by
    rw [hSadef]; apply Real.sqrt_le_sqrt; rw [← hXe]; linarith
  have hSb' : Real.sqrt (2 * (ξ.1 ^ 2 / (2 * qC B.h ξ))) ≤ Sb := by
    rw [hSbdef]; apply Real.sqrt_le_sqrt; rw [← hXe]; linarith
  have hK : 0 ≤ K0 * qC B.h ξ ^ (2 * B.h) := mul_nonneg hK00 hqp
  obtain ⟨a1, a2, a3, a4⟩ := r_alg (Qb l) (qC B.h ξ) ξ.1 (Qb l ^ (1/2 + B.h) * qC B.h ξ ^ (-(1/2 + B.h)))
    ((qC B.h ξ / Qb l) ^ (-(1 + B.h))) (B.F (XC B.h ξ) (etaC B.h ξ))
    (deriv (fun Y => B.F Y (etaC B.h ξ)) (XC B.h ξ)) (deriv (fun Y => B.U Y (etaC B.h ξ)) (XC B.h ξ))
    (B.Eb (qC B.h ξ) (XC B.h ξ) (etaC B.h ξ)) (deriv (fun Y => B.Eb (qC B.h ξ) Y (etaC B.h ξ)) (XC B.h ξ))
    (deriv (fun Y => B.Ub (qC B.h ξ) Y (etaC B.h ξ)) (XC B.h ξ)) (K0 * qC B.h ξ ^ (2 * B.h)) Sa Sb
    _ _ hQ0 hq0 hr haw hw0 hw4 hSa hSa' hSb' hK hEval' hEder' hUder rfl rfl
  rw [← hXe] at a2 a3

  have hP0 : 0 ≤ Qb l ^ B.h := Real.rpow_nonneg hQ0.le _
  have hK2 : K0 * qC B.h ξ ^ (2 * B.h) ≤ 2 * K0 * Qb l ^ B.h := by
    have := mul_le_mul_of_nonneg_left hqQ hK00
    linarith
  have hCe : (8 * K0 / Sa + 8 * (Sb * K0 + K0 / Sa) + 8 * Sb * K0) * Qb l ^ B.h =
      8 * K0 / Sa * Qb l ^ B.h + 8 * (Sb * K0 + K0 / Sa) * Qb l ^ B.h + 8 * Sb * K0 * Qb l ^ B.h := by ring
  have m1 := mul_nonneg hA1 hP0
  have m2 := mul_nonneg hA2 hP0
  have m3 := mul_nonneg hA3 hP0
  have t1 : 4 * (K0 * qC B.h ξ ^ (2 * B.h)) / Sa ≤ 8 * K0 / Sa * Qb l ^ B.h := by
    calc 4 * (K0 * qC B.h ξ ^ (2 * B.h)) / Sa ≤ 4 * (2 * K0 * Qb l ^ B.h) / Sa := by gcongr
      _ = 8 * K0 / Sa * Qb l ^ B.h := by ring
  have t2 : 4 * (Sb * (K0 * qC B.h ξ ^ (2 * B.h)) + K0 * qC B.h ξ ^ (2 * B.h) / Sa) ≤
      8 * (Sb * K0 + K0 / Sa) * Qb l ^ B.h := by
    calc 4 * (Sb * (K0 * qC B.h ξ ^ (2 * B.h)) + K0 * qC B.h ξ ^ (2 * B.h) / Sa)
        ≤ 4 * (Sb * (2 * K0 * Qb l ^ B.h) + 2 * K0 * Qb l ^ B.h / Sa) := by gcongr
      _ = 8 * (Sb * K0 + K0 / Sa) * Qb l ^ B.h := by ring
  have t3 : 4 * Sb * (K0 * qC B.h ξ ^ (2 * B.h)) ≤ 8 * Sb * K0 * Qb l ^ B.h := by
    calc 4 * Sb * (K0 * qC B.h ξ ^ (2 * B.h)) ≤ 4 * Sb * (2 * K0 * Qb l ^ B.h) := by gcongr
      _ = 8 * Sb * K0 * Qb l ^ B.h := by ring
  refine ⟨?_, ?_, ?_, a4⟩
  · rw [hFaval, hCe]
    linarith
  · rw [hfdFa, hCe]
    beta_reduce
    rw [← hXe]
    rw [show pcRC5 l (ξ.1, ξ.2.1, ξ.2.2.1) = ξ.1 / Real.sqrt (Qb l) from rfl]
    linarith
  · rw [hfdB, hCe]
    linarith

theorem base_z_win5 : ∀ (B : BG), B.ok → ∃ C : ℝ, 0 ≤ C ∧ ∀ (l : ℕ) (ξ : Cyl), ξ ∈ DomC B.h B.qB → 1/2 < qC B.h ξ / Qb l → qC B.h ξ / Qb l < 2 → B.Xa / 2 ≤ XC B.h ξ → XC B.h ξ ≤ 2 * B.Xb → |Real.sqrt (Qb l) * fderiv ℝ (pcFa5 B l) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))| ≤ C * Qb l ^ B.h ∧ |Real.sqrt (Qb l) * fderiv ℝ (pcB5 B l 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))| ≤ C * Qb l ^ B.h :=
by
  intro B hok

  have hout : ∀ m : ℕ, ∃ C : ℝ, ∀ q X η : ℝ, 0 < q → q < B.qB → B.Xa / 2 ≤ X → X ≤ 2 * B.Xb →
      -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (logLift B.Eb) (Real.log q, X, η)‖ ≤ C ∧
        ‖iteratedFDeriv ℝ m (logLift B.Ub) (Real.log q, X, η)‖ ≤ C := by
    intro m
    obtain ⟨⟨hh0, -, hXa, -, -, -, -, hqB0, hqB1, -, -, -, -⟩, ⟨hFs, hUs, -, hFb⟩, -, -, -, -,
      ⟨hEs, hUbs, -, hdev⟩, -, -, -, -, -⟩ := hok.2
    have hS : IsOpen (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
    have hWo : IsOpen (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) :=
      isOpen_Iio.prod hS
    have hX0 : 0 < B.Xa / 2 := by linarith
    have hpt : ∀ p : ℝ × ℝ, p.1 ≠ 0 → ContDiffAt ℝ ∞ (fun p : ℝ × ℝ => Real.sqrt (2 * p.1)) p := by
      intro p hp
      exact (contDiffAt_const.mul contDiffAt_fst).sqrt (mul_ne_zero two_ne_zero hp)
    have hsqS : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Real.sqrt (2 * p.1))
        (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) :=
      fun p hp => (hpt p (ne_of_gt hp.1)).contDiffWithinAt
    have hMs : ∀ k : ℕ, ∃ M : ℝ, ∀ p ∈ Set.Icc (B.Xa / 2) (2 * B.Xb) ×ˢ Set.Icc (-1:ℝ) 1,
        ‖iteratedFDeriv ℝ k (fun p : ℝ × ℝ => Real.sqrt (2 * p.1)) p‖ ≤ M := by
      intro k
      have hK : IsCompact (Set.Icc (B.Xa / 2) (2 * B.Xb) ×ˢ Set.Icc (-1:ℝ) 1) :=
        isCompact_Icc.prod isCompact_Icc
      have hc : ContinuousOn (iteratedFDeriv ℝ k (fun p : ℝ × ℝ => Real.sqrt (2 * p.1)))
          (Set.Icc (B.Xa / 2) (2 * B.Xb) ×ˢ Set.Icc (-1:ℝ) 1) := by
        refine continuousOn_of_forall_continuousAt (fun p hp => ?_)
        exact (hpt p (ne_of_gt (lt_of_lt_of_le hX0 hp.1.1))).continuousAt_iteratedFDeriv
          (by exact_mod_cast le_top)
      exact hK.exists_bound_of_continuousOn hc
    choose Ms hMs using hMs
    choose MF hMF using hFb (B.Xa / 2) (2 * B.Xb) hX0
    obtain ⟨C7, hC7⟩ := hdev (B.Xa / 2) (2 * B.Xb) hX0 m
    have hsum0 : 0 ≤ ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * |Ms i| * |MF (m - i)| :=
      Finset.sum_nonneg (fun i _ => by positivity)
    obtain ⟨C1, hC1⟩ : ∃ C : ℝ,
        C = ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * |Ms i| * |MF (m - i)| + |MF m| := ⟨_, rfl⟩
    have hP2s : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Real.sqrt (2 * p.1) * (↿B.F) p)
        (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) := hsqS.mul hFs
    have hP2b : ∀ X η : ℝ, B.Xa / 2 ≤ X → X ≤ 2 * B.Xb → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ m (fun p : ℝ × ℝ => Real.sqrt (2 * p.1) * (↿B.F) p) (X, η)‖ ≤ C1 := by
      intro X η h1 h2 h3 h4
      have hpS : ((X, η) : ℝ × ℝ) ∈ Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1 :=
        ⟨lt_of_lt_of_le hX0 h1, h3, h4⟩
      have hL : ‖iteratedFDerivWithin ℝ m (fun p : ℝ × ℝ => Real.sqrt (2 * p.1) * (↿B.F) p)
          (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) (X, η)‖ ≤
          ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) *
            ‖iteratedFDerivWithin ℝ i (fun p : ℝ × ℝ => Real.sqrt (2 * p.1))
              (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) (X, η)‖ *
            ‖iteratedFDerivWithin ℝ (m - i) (↿B.F) (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) (X, η)‖ :=
        norm_iteratedFDerivWithin_mul_le hsqS hFs hS.uniqueDiffOn hpS (by exact_mod_cast le_top)
      rw [iteratedFDerivWithin_of_isOpen m hS hpS] at hL
      have hterm : ∀ i ∈ Finset.range (m + 1), (m.choose i : ℝ) *
            ‖iteratedFDerivWithin ℝ i (fun p : ℝ × ℝ => Real.sqrt (2 * p.1))
              (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) (X, η)‖ *
            ‖iteratedFDerivWithin ℝ (m - i) (↿B.F) (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) (X, η)‖ ≤
          (m.choose i : ℝ) * |Ms i| * |MF (m - i)| := by
        intro i _
        rw [iteratedFDerivWithin_of_isOpen i hS hpS, iteratedFDerivWithin_of_isOpen (m - i) hS hpS]
        have a := (hMs i (X, η) ⟨⟨h1, h2⟩, h3.le, h4.le⟩).trans (le_abs_self _)
        have b := ((hMF (m - i) X η h1 h2 h3 h4).1).trans (le_abs_self _)
        have c : (0:ℝ) ≤ (m.choose i : ℝ) := Nat.cast_nonneg _
        exact mul_le_mul (mul_le_mul_of_nonneg_left a c) b (norm_nonneg _)
          (mul_nonneg c (abs_nonneg _))
      calc _ ≤ _ := hL
        _ ≤ _ := Finset.sum_le_sum hterm
        _ ≤ C1 := by rw [hC1]; linarith [abs_nonneg (MF m)]
    have hproj : ∀ (f : ℝ × ℝ → ℝ), ContDiffOn ℝ ∞ f (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) → ∀ (m : ℕ)
        (w : ℝ × ℝ × ℝ), w.2 ∈ Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1 →
        ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => f w.2) w‖ ≤ ‖iteratedFDeriv ℝ m f w.2‖ := by
      intro f hf m w hw
      let π := ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)
      have hU : IsOpen (π ⁻¹' (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) := hS.preimage π.continuous
      have hwU : w ∈ π ⁻¹' (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) := hw
      have h1 := ContinuousLinearMap.iteratedFDerivWithin_comp_right π hf hS.uniqueDiffOn
        hU.uniqueDiffOn hwU (n := ∞) (i := m) (by exact_mod_cast le_top)
      rw [iteratedFDerivWithin_of_isOpen m hU hwU,
        iteratedFDerivWithin_of_isOpen m hS (show π w ∈ Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1 from hw)] at h1
      have e : (fun w : ℝ × ℝ × ℝ => f w.2) = f ∘ π := rfl
      rw [e, h1]
      refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
      have hp : ∏ _i : Fin m, ‖π‖ ≤ 1 := by
        rw [Finset.prod_const]
        exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_snd_le ℝ ℝ (ℝ × ℝ))
      calc ‖iteratedFDeriv ℝ m f (π w)‖ * ∏ _i : Fin m, ‖π‖ ≤ ‖iteratedFDeriv ℝ m f (π w)‖ * 1 :=
            mul_le_mul_of_nonneg_left hp (norm_nonneg _)
        _ = ‖iteratedFDeriv ℝ m f w.2‖ := mul_one _
    refine ⟨|C7| + C1, ?_⟩
    intro q X η hq hqB hX1 hX2 hη1 hη2
    have hw : ((Real.log q, X, η) : ℝ × ℝ × ℝ) ∈
        Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) :=
      ⟨Real.log_lt_log hq hqB, lt_of_lt_of_le hX0 hX1, hη1, hη2⟩
    have hnhds := hWo.mem_nhds hw
    have hsnd : Set.MapsTo (Prod.snd : ℝ × ℝ × ℝ → ℝ × ℝ)
        (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1))
        (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) := fun w hw => hw.2
    have hPE : ContDiffOn ℝ ∞ (fun v : ℝ × ℝ × ℝ => Real.sqrt (2 * v.2.1) * B.F v.2.1 v.2.2)
        (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) :=
      hP2s.comp contDiff_snd.contDiffOn hsnd
    have hPU : ContDiffOn ℝ ∞ (fun v : ℝ × ℝ × ℝ => B.U v.2.1 v.2.2)
        (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) :=
      hUs.comp contDiff_snd.contDiffOn hsnd
    have hqp0 : 0 ≤ q ^ (2 * B.h) := Real.rpow_nonneg hq.le _
    have hqp1 : q ^ (2 * B.h) ≤ 1 := Real.rpow_le_one hq.le (hqB.le.trans hqB1) (by linarith)
    have hC7a : C7 * q ^ (2 * B.h) ≤ |C7| :=
      (mul_le_mul_of_nonneg_right (le_abs_self _) hqp0).trans
        (mul_le_of_le_one_right (abs_nonneg _) hqp1)
    obtain ⟨hdE, hdU, -⟩ := hC7 q X η hq hqB hX1 hX2 hη1 hη2
    have hsplit : ∀ (L P : ℝ × ℝ × ℝ → ℝ),
        ContDiffOn ℝ ∞ L (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) →
        ContDiffOn ℝ ∞ P (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) →
        ‖iteratedFDeriv ℝ m (fun w => L w - P w) (Real.log q, X, η)‖ ≤ C7 * q ^ (2 * B.h) →
        ‖iteratedFDeriv ℝ m P (Real.log q, X, η)‖ ≤ C1 →
        ‖iteratedFDeriv ℝ m L (Real.log q, X, η)‖ ≤ |C7| + C1 := by
      intro L P hL hP h1 h2
      have e : L = (fun w => L w - P w) + P := by
        funext w
        simp
      rw [e, iteratedFDeriv_add_apply (((hL.sub hP).contDiffAt hnhds).of_le (by exact_mod_cast le_top))
        ((hP.contDiffAt hnhds).of_le (by exact_mod_cast le_top))]
      exact (norm_add_le _ _).trans (add_le_add (h1.trans hC7a) h2)
    refine ⟨hsplit _ _ hEs hPE hdE ?_, hsplit _ _ hUbs hPU hdU ?_⟩
    · exact (hproj _ hP2s m _ hw.2).trans (hP2b X η hX1 hX2 hη1 hη2)
    · refine (hproj _ hUs m _ hw.2).trans (((hMF m X η hX1 hX2 hη1 hη2).2).trans ?_)
      rw [hC1]
      linarith [le_abs_self (MF m)]

  have tA : ∀ (f : ℝ × ℝ × ℝ → ℝ) (g : ℝ → ℝ) (g' r z t : ℝ), HasDerivAt g g' z →
      (∀ᶠ y in nhds z, f (r, y, t) = g y) →
      |fderiv ℝ f (r, z, t) ((0:ℝ), (1:ℝ), (0:ℝ))| ≤ |g'| := by
    intro f g g' r z t hg heq
    by_cases hd : DifferentiableAt ℝ f (r, z, t)
    · have hl : HasDerivAt (fun y : ℝ => ((r, y, t) : ℝ × ℝ × ℝ)) ((0:ℝ), (1:ℝ), (0:ℝ)) z :=
        (hasDerivAt_const z r).prodMk ((hasDerivAt_id' z).prodMk (hasDerivAt_const z t))
      have h1 := hd.hasFDerivAt.comp_hasDerivAt z hl
      have h2 : HasDerivAt (f ∘ fun y : ℝ => ((r, y, t) : ℝ × ℝ × ℝ)) g' z :=
        hg.congr_of_eventuallyEq heq
      exact le_of_eq (congrArg (fun x : ℝ => |x|) (h1.unique h2))
    · rw [fderiv_zero_of_not_differentiableAt hd]
      simp

  have tB : ∀ (h τ z D : ℝ) (Q : ℝ → ℝ), 0 < h → h < 1/100 → HasDerivAt Q D z →
      (∀ y, Q y - y ^ 2 * Q y ^ (2 * h) = τ) → 0 < Q z → z ^ 2 < Q z ^ (1 - 2 * h) →
      |D| ≤ 3 * Q z ^ (1/2 + h) ∧ |z| < Q z ^ (1/2 - h) := by
    intro h τ z D Q hh0 hh1 hQ heq hq hz
    have hP : HasDerivAt (fun y => Q y - y ^ 2 * Q y ^ (2 * h))
        (D - (2 * z * Q z ^ (2 * h) + z ^ 2 * (D * (2 * h) * Q z ^ (2 * h - 1)))) z := by
      have h1 : HasDerivAt (fun y : ℝ => y ^ 2) (2 * z) z := by simpa using hasDerivAt_pow 2 z
      have h2 := hQ.rpow_const (p := 2 * h) (Or.inl hq.ne')
      exact hQ.sub (h1.mul h2)
    have hc : HasDerivAt (fun y => Q y - y ^ 2 * Q y ^ (2 * h)) 0 z :=
      (hasDerivAt_const z τ).congr_of_eventuallyEq (Filter.Eventually.of_forall heq)
    have hD := hP.unique hc
    have hpos1 : 0 < Q z ^ (2 * h - 1) := Real.rpow_pos_of_pos hq _
    have hprod : Q z ^ (1 - 2 * h) * Q z ^ (2 * h - 1) = 1 := by
