  exact hAff η hη

theorem good_coeff_smooth_v5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl), B.ok → ξ ∈ DomC B.h B.qB → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → ∃ U : Set Cyl, IsOpen U ∧ ξ ∈ U ∧ U ⊆ DomC B.h B.qB ∧ (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhi5 B G γ η i) U) ∧ (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhiP5 B G γ η i) U) ∧ (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => Kmat B G γ η i j) U) :=
by
