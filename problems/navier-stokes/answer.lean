  ·
    have hX0 : 0 < X := by linarith
    have hXKc : (X, η) ∈ Icc Xm Xb ×ˢ Icc (-1:ℝ) 1 := ⟨⟨hXm, hX2.le⟩, hη1.le, hη2.le⟩
    have hgen : ∀ (g : ℝ → ℝ → ℝ) (a P : ℝ × ℝ → ℝ) (A B : ℝ),
        ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
        (∀ x e : ℝ, Xb < x → -1 < e → e < 1 → g x e = 0) →
        ContDiffOn ℝ ∞ a (Ioi 0 ×ˢ univ) →
        (∀ j, j ≤ m → ∀ q ∈ Icc Xm Xb ×ˢ Icc (-1:ℝ) 1, ‖iteratedFDeriv ℝ j a q‖ ≤ A) →
