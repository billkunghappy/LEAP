        X = (a ^ 2 + b ^ 2) * a⁻¹ ∧ 0 < a⁻¹ ∧ a⁻¹ ≤ K ∧ |a ^ 2 + b ^ 2| ≤ 2 * D ^ 2 ∧
        κ / 2 ≤ W ∧ W ^ 2 = X / 2 - 1 ∧ |W| ≤ 1 + D ^ 2 * K ∧
        lam = 2 * (F0 * u * W) ∧ lam / (2 * F0 * N.1) = -W ∧ |F0| ≤ 4 * D := by
    intro s p a b F0 lam g N hs1 hs2 hp1 hp2 ha1 ha2 hb hadm hF0 hg hN hlam
    have ha0 : 0 < a := by linarith
    have hF0l : κ / 4 ≤ F0 := by
      have := mul_le_mul hs1 hp1 hκ.le (by linarith : (0:ℝ) ≤ s)
      rw [hF0]; linarith
    have hF0u : F0 ≤ 4 * D := by
      have := mul_le_mul hs2 hp2 (by linarith : (0:ℝ) ≤ p) (by norm_num : (0:ℝ) ≤ 4)
      rw [hF0]; linarith
    have hF0pos : 0 < F0 := by linarith
    obtain ⟨hb1, hb2⟩ := abs_le.mp hb
    have hb2' : b ^ 2 ≤ D ^ 2 := sq_le_sq' hb1 hb2
    have ha2' : a ^ 2 ≤ D ^ 2 := pow_le_pow_left₀ ha0.le ha2 2
    obtain ⟨R, hR⟩ : ∃ R : ℝ, R = Real.sqrt (a ^ 2 + b ^ 2) := ⟨_, rfl⟩
    have hRsq : R ^ 2 = a ^ 2 + b ^ 2 := by rw [hR]; exact Real.sq_sqrt (by positivity)
    have haR : |a| ≤ R := by rw [hR]; exact Real.abs_le_sqrt (by linarith [sq_nonneg b])
    have hbR : |b| ≤ R := by rw [hR]; exact Real.abs_le_sqrt (by linarith [sq_nonneg a])
    have haR' : a ≤ R := by rw [abs_of_pos ha0] at haR; exact haR
    have hRpos : 0 < R := by linarith
    have hRi : 0 < R⁻¹ := inv_pos.mpr hRpos
    have hRK : R⁻¹ ≤ K := by rw [hK]; exact inv_anti₀ hκ (by linarith)
    have hRR : R * R⁻¹ = 1 := mul_inv_cancel₀ hRpos.ne'
    have hai0 : 0 < a⁻¹ := inv_pos.mpr ha0
    have hai : a * a⁻¹ = 1 := mul_inv_cancel₀ ha0.ne'
    have haK : a⁻¹ ≤ K := by rw [hK]; exact inv_anti₀ hκ ha1
    have hu1 : |a * R⁻¹| ≤ 1 := by
      rw [abs_mul, abs_of_pos hRi]
