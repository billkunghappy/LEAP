    · rfl
  refine ⟨_, hcls, fun x t Y hxt => ?_⟩
  rw [hosc x t Y hxt, hgeq]

theorem ssh5_transport_rep : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (w : Ext ℝ³) (V : WC) (H : Finset ℤ), (∀ γ m, ContDiffOn ℝ ∞ (V γ m) (DomC B.h (qsOf l0))) → (∀ γ m, m ∉ H → V γ m = 0) → (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → V γ m ξ ≠ 0 → SuppW B G γ ξ) → (∀ (γ γ' : Lab) (m m' : ℤ), γ ≠ γ' → ∀ ξ ∈ DomC B.h (qsOf l0), V γ m ξ ≠ 0 → ξ ∉ tsupport (V γ' m')) → (∀ x t Y, corrOn B l0 x t → w x t Y = cyl2cart x (waveV5 B G V (thetaOf x) (ptOf x t Y))) → (∀ ξ ∈ DomC B.h (qsOf l0), ∃ T : Finset Lab, ∀ γ M, γ ∉ T → ssh5QOf B G H V γ M ξ = 0) ∧ ∀ x t Y, corrOn B l0 x t → pwrTr B.h w w x t Y = (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) • cyl2cart x (waveV5 B G (ssh5QOf B G H V) (thetaOf x) (ptOf x t Y)) :=
by
  intro B G hok hG

  obtain ⟨hh0, -, -, -, -, -, -, hqB0, hqB1, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 w V H hVs hVm hVsupp hdisj hrep => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le

  have hTr0 : ∀ (n : ℤ) (U : Fin 3 → ℂ) (c : Cyl → (Fin 3 → ℂ)) (ξ : Cyl), (∀ a, U a = 0) →
      ssh5TrM B.h n U c ξ = 0 := by
    intro n U c ξ hU
    funext i
    fin_cases i <;> simp [ssh5TrM, hU]
  have hQ0 : ∀ γ M ξ, (∀ m, V γ m ξ = 0) → ssh5QOf B G H V γ M ξ = 0 := by
    intro γ M ξ h
    unfold ssh5QOf
    rw [Finset.sum_eq_zero, smul_zero]
    intro m _
    apply Finset.sum_eq_zero
    intro m' _
    have hU : ∀ a, modeCoef5 B G V γ m ξ a = 0 := fun a => by simp [modeCoef5, h m]
    have hU' : ∀ a, (fun i => starRingEnd ℂ (modeCoef5 B G V γ m ξ i)) a = 0 := fun a => by
      simp [hU a]
    rw [hTr0 _ _ _ _ hU, hTr0 _ _ _ _ hU']
    simp

  obtain ⟨Hq, hHq1, hHq2⟩ : ∃ Hq : Finset ℤ, (∀ m ∈ H, ∀ m' ∈ H, m + m' ∈ Hq) ∧
      (∀ m ∈ H, ∀ m' ∈ H, m' - m ∈ Hq) :=
    ⟨(H ×ˢ H).image (fun p : ℤ × ℤ => p.1 + p.2) ∪ (H ×ˢ H).image (fun p : ℤ × ℤ => p.2 - p.1),
      fun m hm m' hm' => Finset.mem_union_left _
        (Finset.mem_image.2 ⟨(m, m'), Finset.mem_product.2 ⟨hm, hm'⟩, rfl⟩),
      fun m hm m' hm' => Finset.mem_union_right _
        (Finset.mem_image.2 ⟨(m, m'), Finset.mem_product.2 ⟨hm, hm'⟩, rfl⟩)⟩

  have hregroup : ∀ (ξ : Cyl) (θ : ℝ) (Γ : Finset Lab), 0 < qC B.h ξ → (∀ γ m, γ ∉ Γ → V γ m ξ = 0) →
      (qC B.h ξ ^ (-(2 * Aex B.h + 1/2))) • waveV5 B G (ssh5QOf B G H V) θ ξ = fun i =>
        ∑ γ ∈ Γ, ∑ m ∈ H, ∑ m' ∈ H, ((1/2 : ℂ) * (ssh5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G V γ m ξ) (modeCoef5 B G V γ m') ξ i * Complex.exp (Complex.I * ((m * pint5 B G γ + m' * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) + ssh5TrM B.h (m' * pint5 B G γ) (fun a => starRingEnd ℂ (modeCoef5 B G V γ m ξ a)) (modeCoef5 B G V γ m') ξ i * Complex.exp (Complex.I * ((m' * pint5 B G γ - m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)))).re := by
    intro ξ θ Γ hq hΓ
    funext i
    have hE : ∀ (γ : Lab) (M : ℤ), ssh5QOf B G H V γ M ξ i * ephase5 B G γ M θ ξ =
        (((qC B.h ξ ^ (2 * Aex B.h + 1/2) / 2 : ℝ)) : ℂ) *
          ∑ m ∈ H, ∑ m' ∈ H,
            ((if m + m' = M then ssh5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G V γ m ξ)
                (modeCoef5 B G V γ m') ξ i *
                Complex.exp (Complex.I * ((M * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) else 0) +
             (if m' - m = M then ssh5TrM B.h (m' * pint5 B G γ)
                (fun a => starRingEnd ℂ (modeCoef5 B G V γ m ξ a)) (modeCoef5 B G V γ m') ξ i *
                Complex.exp (Complex.I * ((M * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) else 0)) := by
      intro γ M
      have he : Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) ≠ 0 :=
        Complex.exp_ne_zero _
      have hph : ephase5 B G γ M θ ξ =
          Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
            Complex.exp (Complex.I * ((M * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) := by
        unfold ephase5
        rw [← Complex.exp_add]
        congr 1
        push_cast
        ring
      have key : ∀ (c S F : ℂ),
          c * (Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))⁻¹ * S *
            (Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) * F) =
          c * (S * F) := by
        intro c S F
        rw [show c * (Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))⁻¹ * S *
            (Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) * F) =
            c * (S * F) * ((Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))⁻¹ *
              Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)))) by ring,
          inv_mul_cancel₀ he, mul_one]
      rw [hph]
      unfold ssh5QOf
      simp only [Pi.smul_apply, smul_eq_mul, Finset.sum_apply, Pi.add_apply, ite_apply, Pi.zero_apply]
      rw [key]
      congr 1
      simp only [Finset.sum_mul, add_mul, ite_mul, zero_mul]
    have hsupp : ∀ γ : Lab, (Function.support fun M : ℤ => ssh5QOf B G H V γ M ξ i * ephase5 B G γ M θ ξ) ⊆
        (Hq : Set ℤ) := by
      intro γ M hM
      by_contra hn
      apply hM
      show ssh5QOf B G H V γ M ξ i * ephase5 B G γ M θ ξ = 0
      rw [hE, Finset.sum_eq_zero, mul_zero]
      intro m hm
      apply Finset.sum_eq_zero
      intro m' hm'
      have h1 : ¬ (m + m' = M) := fun he => hn (by rw [← he]; exact Finset.mem_coe.2 (hHq1 m hm m' hm'))
      have h2 : ¬ (m' - m = M) := fun he => hn (by rw [← he]; exact Finset.mem_coe.2 (hHq2 m hm m' hm'))
      rw [if_neg h1, if_neg h2, add_zero]
    have hinner : ∀ γ : Lab, ∑ᶠ M : ℤ, ssh5QOf B G H V γ M ξ i * ephase5 B G γ M θ ξ =
        (((qC B.h ξ ^ (2 * Aex B.h + 1/2) / 2 : ℝ)) : ℂ) *
          ∑ m ∈ H, ∑ m' ∈ H,
            (ssh5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G V γ m ξ) (modeCoef5 B G V γ m') ξ i *
                Complex.exp (Complex.I * ((m * pint5 B G γ + m' * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) +
              ssh5TrM B.h (m' * pint5 B G γ) (fun a => starRingEnd ℂ (modeCoef5 B G V γ m ξ a))
                (modeCoef5 B G V γ m') ξ i *
                Complex.exp (Complex.I * ((m' * pint5 B G γ - m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ))) := by
      intro γ
      rw [finsum_eq_sum_of_support_subset _ (hsupp γ), Finset.sum_congr rfl (fun M _ => hE γ M),
        ← Finset.mul_sum]
      congr 1
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun m hm => ?_)
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun m' hm' => ?_)
      rw [Finset.sum_add_distrib, Finset.sum_ite_eq, Finset.sum_ite_eq]
      rw [if_pos (hHq1 m hm m' hm'), if_pos (hHq2 m hm m' hm'), add_mul, sub_mul]
    have hsuppΓ : (Function.support fun γ : Lab =>
        ∑ᶠ M : ℤ, ssh5QOf B G H V γ M ξ i * ephase5 B G γ M θ ξ) ⊆ (Γ : Set Lab) := by
      intro γ hγ
      by_contra hn
      apply hγ
      have h0 : ∀ M, ssh5QOf B G H V γ M ξ = 0 := fun M => hQ0 γ M ξ (fun m => hΓ γ m hn)
      simp [h0]
    have hc : qC B.h ξ ^ (-(2 * Aex B.h + 1/2)) * (qC B.h ξ ^ (2 * Aex B.h + 1/2) / 2) = 1/2 := by
      rw [Real.rpow_neg hq.le]
      field_simp [(Real.rpow_pos_of_pos hq (2 * Aex B.h + 1/2)).ne']
    simp only [Pi.smul_apply, smul_eq_mul, waveV5]
    rw [finsum_eq_sum_of_support_subset _ hsuppΓ, Finset.sum_congr rfl (fun γ _ => hinner γ),
      Complex.re_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [Complex.re_ofReal_mul, ← mul_assoc, hc, Complex.re_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    rw [Complex.re_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun m' _ => ?_)
    rw [show (1/2 : ℂ) = ((1/2 : ℝ) : ℂ) by push_cast; ring, Complex.re_ofReal_mul]
  refine ⟨fun ξ hξ => ?_, fun x t Y hxt => ?_⟩
  ·
    have hfin := etaL_tsupport_finite B.h ξ hok.1 hξ.2.1
    refine ⟨hfin.toFinset, fun γ M hγ => hQ0 γ M ξ (fun m => ?_)⟩
    by_contra hne
    exact hγ ((Set.Finite.mem_toFinset hfin).mpr (hVsupp γ m ξ hξ hne).2.1)
  ·
    have hxt' : 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
    have hξD : ptOf x t Y ∈ DomC B.h (qsOf l0) := hxt
    have hq : 0 < qC B.h (ptOf x t Y) := (hok.1.1 (x 2) (1 - t) (by linarith [hxt'.2.1])).1
    obtain ⟨Y', hY'⟩ : ∃ Y' : ℝ × ℝ, Y' = Y - Yph B.h (rad x) t := ⟨_, rfl⟩
    have hζx : ptOf x t (Yph B.h (rad x) t + Y') = ptOf x t Y := by
      rw [hY']; simp
    obtain ⟨-, hCd⟩ := pq5_coef_diff B G l0 V hok hG hqB hVs hVsupp
    have hCdx : ∀ γ m, DifferentiableAt ℝ (modeCoef5 B G V γ m) (ptOf x t (Yph B.h (rad x) t + Y')) := by
      intro γ m
      rw [hζx]
      exact hCd γ m _ hξD

    obtain ⟨N, hN, Γ, hΓN⟩ := etaL_local_finite_v5 B.h hok.1 (ptOf x t Y) hxt'.2.1
    have hoffN : ∀ η ∈ N, η ∈ DomC B.h (qsOf l0) → ∀ (γ : Lab) (m : ℤ),
        (γ ∉ Γ ∨ m ∉ H) → V γ m η = 0 := by
      intro η hηN hηD γ m hγm
      by_contra hne
      rcases hγm with hγ | hm
      · exact hγ (hΓN γ η hηN (hVsupp γ m η hηD hne).2.1)
      · exact hne (congrFun (hVm γ m hm) η)
    have hsum : ∀ (F : Lab → ℤ → ℂ), (∀ γ m, (γ ∉ Γ ∨ m ∉ H) → F γ m = 0) →
        ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, F γ m = ∑ γ ∈ Γ, ∑ m ∈ H, F γ m := by
      intro F hF
      have hin : ∀ γ, ∑ᶠ m : ℤ, F γ m = ∑ m ∈ H, F γ m := by
        intro γ
        apply finsum_eq_sum_of_support_subset
        intro m hm
        rw [Function.mem_support] at hm
        by_contra h
        exact hm (hF γ m (Or.inr (by simpa using h)))
      simp_rw [hin]
      apply finsum_eq_sum_of_support_subset
      intro γ hγ
      rw [Function.mem_support] at hγ
      by_contra h
      exact hγ (Finset.sum_eq_zero (fun m _ => hF γ m (Or.inl (by simpa using h))))
    have hphase : ∀ (γ : Lab) (m : ℤ) (θ : ℝ) (η : Cyl), ephase5 B G γ m θ η =
        Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) *
          Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) := by
      intro γ m θ η
      simp only [ephase5]
      rw [← Complex.exp_add]
      congr 1
      push_cast
      ring
    have hcyl_sum : ∀ (y : ℝ³) {ι : Type} (s : Finset ι) (v : ι → Fin 3 → ℝ),
        cyl2cart y (∑ j ∈ s, v j) = ∑ j ∈ s, cyl2cart y (v j) := by
      intro y ι s v
      let L : (Fin 3 → ℝ) →+ ℝ³ := AddMonoidHom.mk' (cyl2cart y) (fun c d => by
        simp only [cyl2cart, Pi.add_apply, add_smul]; abel)
      exact map_sum L v s
    have hexpand : ∀ (y : ℝ³), corrOn B l0 y t →
        (∀ (γ : Lab) (m : ℤ), (γ ∉ Γ ∨ m ∉ H) →
          V γ m (ptOf y t (Yph B.h (rad y) t + Y')) = 0) →
        cyl2cart y (waveV5 B G V (thetaOf y) (ptOf y t (Yph B.h (rad y) t + Y'))) =
          ∑ γ ∈ Γ, ∑ m ∈ H,
            modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m) y := by
      intro y hc hz
      have hF : ∀ (n : ℤ) (c : Cyl → (Fin 3 → ℂ)), modeF5 B.h 0 t Y' n c y =
          cyl2cart y (fun i => (c (ptOf y t (Yph B.h (rad y) t + Y')) i *
            Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re) := by
        intro n c
        simp only [modeF5, Real.rpow_zero, one_smul]
      trans cyl2cart y (∑ γ ∈ Γ, ∑ m ∈ H, fun i =>
        (modeCoef5 B G V γ m (ptOf y t (Yph B.h (rad y) t + Y')) i *
          Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf y : ℂ))).re)
      · congr 1
        funext i
        simp only [waveV5, Finset.sum_apply]
        rw [hsum (fun γ m => V γ m (ptOf y t (Yph B.h (rad y) t + Y')) i *
            ephase5 B G γ m (thetaOf y) (ptOf y t (Yph B.h (rad y) t + Y')))
          (fun γ m h => by simp only [hz γ m h, Pi.zero_apply, zero_mul]), Complex.re_sum]
        refine Finset.sum_congr rfl (fun γ _ => ?_)
        rw [Complex.re_sum]
        refine Finset.sum_congr rfl (fun m _ => ?_)
        rw [hphase]
        simp only [modeCoef5]
        congr 1
        ring
      · rw [hcyl_sum]
        refine Finset.sum_congr rfl (fun γ _ => ?_)
        rw [hcyl_sum]
        refine Finset.sum_congr rfl (fun m _ => ?_)
        exact (hF _ _).symm
    have hradc : Continuous rad := by
      unfold rad
      fun_prop
    have hOopen : IsOpen {y : ℝ³ | corrOn B l0 y t ∧
        ptOf y t (Yph B.h (rad y) t + Y') ∈ interior N} := by
      rw [isOpen_iff_mem_nhds]
      intro y0 hy0
      have h1 : 0 < rad y0 := hy0.1.1
      have h2 : t < 1 := hy0.1.2.1
      have h3 : simScale B.h (y0 2) (1 - t) < qsOf l0 := hy0.1.2.2
      have h4 : ptOf y0 t (Yph B.h (rad y0) t + Y') ∈ interior N := hy0.2
      have e1 : ∀ᶠ y in nhds y0, (0:ℝ) < rad y :=
        continuousAt_const.eventually_lt hradc.continuousAt h1
      have hmem2 : ((y0 2, 1 - t) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ)) :=
        ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩
      have hc1 : ContinuousAt (fun y : ℝ³ => simScale B.h (y 2) (1 - t)) y0 := by
        have h1' : ContinuousAt (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (y0 2, 1 - t) :=
          (hok.1.2.2.2.1.contDiffAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds hmem2)).continuousAt
        have h2' : ContinuousAt (fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ)) y0 := by fun_prop
        exact ContinuousAt.comp (x := y0) (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2)
          (f := fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ)) h1' h2'
      have e3 : ∀ᶠ y in nhds y0, simScale B.h (y 2) (1 - t) < qsOf l0 :=
        hc1.eventually_lt continuousAt_const h3
      have hPc : ContinuousAt (fun y : ℝ³ => ptOf y t (Yph B.h (rad y) t + Y')) y0 := by
        have hr1 : ContinuousAt (fun y : ℝ³ => rad y ^ drx B.h) y0 :=
          hradc.continuousAt.rpow_const (Or.inl h1.ne')
        have h4' : ContinuousAt (fun y : ℝ³ => Yph B.h (rad y) t + Y') y0 :=
          ((hr1.smul continuousAt_const).add continuousAt_const).add continuousAt_const
        have h2'' : ContinuousAt (fun y : ℝ³ => y 2) y0 := by fun_prop
        exact hradc.continuousAt.prodMk (h2''.prodMk (continuousAt_const.prodMk h4'))
      have e4 : ∀ᶠ y in nhds y0, ptOf y t (Yph B.h (rad y) t + Y') ∈ interior N :=
        hPc.preimage_mem_nhds (isOpen_interior.mem_nhds h4)
      filter_upwards [e1, e3, e4] with y a1 a3 a4
      exact ⟨⟨a1, h2, a3⟩, a4⟩
    have hxO : x ∈ {y : ℝ³ | corrOn B l0 y t ∧ ptOf y t (Yph B.h (rad y) t + Y') ∈ interior N} := by
      refine ⟨hxt, ?_⟩
      show ptOf x t (Yph B.h (rad x) t + Y') ∈ interior N
      rw [hζx]
      exact mem_interior_iff_mem_nhds.mpr hN
    have hΓ : ∀ γ m, γ ∉ Γ → V γ m (ptOf x t Y) = 0 := fun γ m hγ =>
      hoffN _ (mem_of_mem_nhds hN) hxt γ m (Or.inl hγ)
    have hFx : ∀ (n : ℤ) (c : Cyl → (Fin 3 → ℂ)), modeF5 B.h 0 t Y' n c x =
        cyl2cart x (fun i => (c (ptOf x t Y) i * Complex.exp (Complex.I * (n : ℂ) * (thetaOf x : ℂ))).re) := by
      intro n c
      simp only [modeF5, Real.rpow_zero, one_smul, hζx]
    have hFd : ∀ γ (m : ℤ), DifferentiableAt ℝ (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m)) x :=
      fun γ m => modeF5_differentiable_v5 B.h 0 t Y' _ _ x hok.1 hxt'.2.1 hxt'.1 (hCdx γ m)

    have hQdef : pwrTr B.h w w x t Y = fderiv ℝ (fun y => w y t (Yph B.h (rad y) t + Y')) x
        (w x t (Yph B.h (rad x) t + Y')) := by
      rw [hY']; rfl

    have hslice : (fun y => w y t (Yph B.h (rad y) t + Y')) =ᶠ[nhds x]
        (fun y => ∑ γ ∈ Γ, ∑ m ∈ H,
          modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m) y) := by
      filter_upwards [hOopen.mem_nhds hxO] with y hy
      rw [hrep y t _ hy.1, hexpand y hy.1 (fun γ m h => hoffN _ (interior_subset hy.2) hy.1 γ m h)]

    have hD : fderiv ℝ (fun y => w y t (Yph B.h (rad y) t + Y')) x =
        ∑ γ ∈ Γ, ∑ m ∈ H,
          fderiv ℝ (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m)) x := by
      rw [hslice.fderiv_eq, fderiv_fun_sum (fun γ _ => DifferentiableAt.fun_sum (fun m _ => hFd γ m))]
      refine Finset.sum_congr rfl (fun γ _ => ?_)
      exact fderiv_fun_sum (fun m _ => hFd γ m)

    have hu : w x t (Yph B.h (rad x) t + Y') =
        ∑ γ ∈ Γ, ∑ m ∈ H,
          modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m) x :=
      hslice.eq_of_nhds

    have hoff : ∀ γ' γ (m' m : ℤ), γ ≠ γ' →
        fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ') (modeCoef5 B G V γ' m')) x
          (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m) x) = 0 := by
      intro γ' γ m' m hne
      by_cases hV : V γ m (ptOf x t Y) = 0
      · have h0 : ∀ i, modeCoef5 B G V γ m (ptOf x t Y) i = 0 := fun i => by simp [modeCoef5, hV]
        rw [hFx]
        simp [cyl2cart, h0]
      · have hts := hdisj γ γ' m m' hne _ hξD hV
        have hev : modeCoef5 B G V γ' m' =ᶠ[nhds (ptOf x t (Yph B.h (rad x) t + Y'))] 0 := by
          rw [hζx]
          filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hts] with η hη
          funext i
          simp [modeCoef5, hη]
        rw [pq5_offdiag B.h t Y' _ _ x hxt'.1 hev]
        simp

    have hlin : ∀ (a b d : Fin 3 → ℝ) (s1 s2 s3 : ℝ),
        s1 • cyl2cart x a + s2 • cyl2cart x b + s3 • cyl2cart x d =
          cyl2cart x (fun i => s1 * a i + s2 * b i + s3 * d i) := by
      intro a b d s1 s2 s3
      simp only [cyl2cart, add_smul, smul_add, smul_smul]
      abel
    have hjet : ∀ (n' : ℤ) (c : Cyl → (Fin 3 → ℂ)) (v : Fin 3 → ℝ),
        DifferentiableAt ℝ c (ptOf x t (Yph B.h (rad x) t + Y')) →
        fderiv ℝ (modeF5 B.h 0 t Y' n' c) x (cyl2cart x v) =
          cyl2cart x (fun i => (ssh5TrM B.h n' (fun a => ((v a : ℝ) : ℂ)) c (ptOf x t Y) i *
            Complex.exp (Complex.I * (n' : ℂ) * (thetaOf x : ℂ))).re) := by
      intro n' c v hc
      have hR := pq5_jet_R B.h t Y' n' c x hok.1 hxt'.2.1 hxt'.1 hc
      have hZ := pq5_jet_Z B.h t Y' n' c x hok.1 hxt'.2.1 hxt'.1 hc
      have hT := pq5_jet_Th B.h t Y' n' c x hok.1 hxt'.2.1 hxt'.1 hc
      rw [hζx] at hR hZ hT
      have e1 : cyl2cart x v = v 0 • eR x + v 1 • eTh x + v 2 • eZ := rfl
      rw [e1, map_add, map_add, map_smul, map_smul, map_smul, hR, hZ, hT, hlin]
      congr 1
      funext i
      rw [← Complex.re_ofReal_mul, ← Complex.re_ofReal_mul, ← Complex.re_ofReal_mul,
        ← Complex.add_re, ← Complex.add_re]
      congr 1
      fin_cases i <;> simp [ssh5TrM, ptOf] <;> ring

    obtain ⟨X, hX⟩ : ∃ X : Lab → ℤ → ℤ → Fin 3 → ℝ, ∀ γ m m' i, X γ m m' i =
        ((1/2 : ℂ) * (ssh5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G V γ m (ptOf x t Y)) (modeCoef5 B G V γ m') (ptOf x t Y) i * Complex.exp (Complex.I * ((m * pint5 B G γ + m' * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ)) + ssh5TrM B.h (m' * pint5 B G γ) (fun a => starRingEnd ℂ (modeCoef5 B G V γ m (ptOf x t Y) a)) (modeCoef5 B G V γ m') (ptOf x t Y) i * Complex.exp (Complex.I * ((m' * pint5 B G γ - m * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ)))).re :=
      ⟨fun γ m m' i => ((1/2 : ℂ) * (ssh5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G V γ m (ptOf x t Y)) (modeCoef5 B G V γ m') (ptOf x t Y) i * Complex.exp (Complex.I * ((m * pint5 B G γ + m' * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ)) + ssh5TrM B.h (m' * pint5 B G γ) (fun a => starRingEnd ℂ (modeCoef5 B G V γ m (ptOf x t Y) a)) (modeCoef5 B G V γ m') (ptOf x t Y) i * Complex.exp (Complex.I * ((m' * pint5 B G γ - m * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ)))).re,
        fun _ _ _ _ => rfl⟩
    have hTT : ssh5TrM = pq5TrM := rfl
    have hdiag : ∀ γ (m m' : ℤ),
        fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ) (modeCoef5 B G V γ m')) x
          (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G V γ m) x) = cyl2cart x (X γ m m') := by
      intro γ m m'
      rw [hFx (m * pint5 B G γ), hjet (m' * pint5 B G γ) (modeCoef5 B G V γ m') _ (hCdx γ m')]
      congr 1
      funext i
      rw [hX, hTT]
      exact pq5_trm_split B.h (m * pint5 B G γ) (m' * pint5 B G γ) (modeCoef5 B G V γ m (ptOf x t Y))
        (modeCoef5 B G V γ m') (ptOf x t Y) (thetaOf x) i

    have hRHS : (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) •
        cyl2cart x (waveV5 B G (ssh5QOf B G H V) (thetaOf x) (ptOf x t Y)) =
          cyl2cart x (fun i => ∑ γ ∈ Γ, ∑ m ∈ H, ∑ m' ∈ H, X γ m m' i) := by
      have hsm : ∀ (c : ℝ) (u : Fin 3 → ℝ), c • cyl2cart x u = cyl2cart x (c • u) := by
        intro c u
        simp only [cyl2cart, Pi.smul_apply, smul_eq_mul, smul_add, smul_smul]
      rw [hsm, hregroup (ptOf x t Y) (thetaOf x) Γ hq hΓ]
      simp only [hX]
    obtain ⟨Lc, hLc⟩ : ∃ Lc : (Fin 3 → ℝ) →+ ℝ³, ∀ u, Lc u = cyl2cart x u :=
      ⟨{ toFun := cyl2cart x
         map_zero' := by simp [cyl2cart]
         map_add' := fun u v => by simp only [cyl2cart, Pi.add_apply, add_smul]; abel },
        fun u => rfl⟩

    rw [hQdef, hD, hu, hRHS]
    simp only [sum_apply, map_sum]
    calc _ = ∑ γ' ∈ Γ, ∑ m' ∈ H, ∑ m ∈ H,
          cyl2cart x (X γ' m' m) := by
          refine Finset.sum_congr rfl (fun γ' hγ' => Finset.sum_congr rfl (fun m' _ => ?_))
          rw [Finset.sum_eq_single_of_mem γ' hγ' ?_]
          · exact Finset.sum_congr rfl (fun m _ => hdiag γ' m' m)
          · intro γ _ hne
            exact Finset.sum_eq_zero (fun m _ => hoff γ γ' m m' (Ne.symm hne))
      _ = _ := by
          simp only [← hLc, ← map_sum]
          congr 1
          funext i
          simp only [Finset.sum_apply]

theorem ssh5_phase_free : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (l0 : ℕ) (α : ℝ) (D : WC) (H : Finset ℤ), qsOf l0 ≤ B.qB → InWg5 B G (qsOf l0) α (wmoAmp5 B G D) → ∀ (γ : Lab) (M : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ssh5Osc (ssh5QOf B G H (ssh5Vw B G D)) γ M ξ = ssh5PF B G H (wmoAmp5 B G D) γ M ξ :=
by
  intro B G hok hG l0 α D H hq hW γ M ξ hξ
  obtain ⟨hΩ, hqC, hqpos, -, -, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hQb : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _

  have hs1 : ∀ (m : ℤ), ∀ η ∈ DomC B.h (qsOf l0), ssh5Vw B G D γ m η =
      ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ) • wmoAmp5 B G D γ m η := by
    intro m η hη
    have hq0 := hqpos η hη
    have hne : qC B.h η ≠ 0 := hq0.ne'
    have hd : HasFDerivAt (qC B.h) (fderiv ℝ (qC B.h) η) η :=
      ((hqC.contDiffAt (hΩ.mem_nhds hη)).differentiableAt (by norm_num)).hasFDerivAt
    have hdz : dZ (fun η' => qC B.h η' ^ (-B.h)) η =
        -B.h * qC B.h η ^ (-B.h) * dZ (fun η' => Real.log (qC B.h η')) η := by
      unfold dZ
      rw [(hd.rpow_const (p := -B.h) (Or.inl hne)).fderiv, (hd.log hne).fderiv]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
      rw [Real.rpow_sub_one hne]
      ring
    have hab : qC B.h η ^ (-Aex B.h) * qC B.h η ^ (1/2:ℝ) = qC B.h η ^ (-B.h) := by
      rw [← Real.rpow_add hq0]; congr 1; unfold Aex; ring
    have hdiv : (qC B.h η / Qb γ.1) ^ (1/2:ℝ) = qC B.h η ^ (1/2:ℝ) * (Qb γ.1 ^ (1/2:ℝ))⁻¹ := by
      rw [Real.div_rpow hq0.le hQb.le, div_eq_mul_inv]
    have hneg : Qb γ.1 ^ (-(1/2:ℝ)) = (Qb γ.1 ^ (1/2:ℝ))⁻¹ := Real.rpow_neg hQb.le _
    funext i
    simp only [ssh5Vw, wmoAmp5, rotC, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    rw [hdz, hdiv, hneg, ← hab]
    fin_cases i <;>
      simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue, Matrix.cons_val_zero,
        Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] <;>
      push_cast <;> ring
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  have hq0 := hqpos ξ hξ
  have hne : qC B.h ξ ≠ 0 := hq0.ne'
  have hd : HasFDerivAt (qC B.h) (fderiv ℝ (qC B.h) ξ) ξ :=
    ((hqC.contDiffAt (hΩ.mem_nhds hξ)).differentiableAt (by norm_num)).hasFDerivAt

  have hR0 : fderiv ℝ (qC B.h) ξ ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) = 0 := by
    have hL : HasDerivAt (fun t : ℝ => ξ + t • ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv))
        ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) 0 := by
      have h0 := ((hasDerivAt_id (0:ℝ)).smul_const
        ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)).const_add ξ
      simpa using h0
    have hd' : HasFDerivAt (qC B.h) (fderiv ℝ (qC B.h) ξ)
        (ξ + (0:ℝ) • ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) := by
      rw [zero_smul, add_zero]; exact hd
    have h1 := hd'.comp_hasDerivAt (0:ℝ) hL
    have hc : (qC B.h ∘ fun t : ℝ => ξ + t • ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) =
        fun _ => qC B.h ξ := by
      funext t
      simp [qC]
    rw [hc] at h1
    exact h1.unique (hasDerivAt_const _ _)
  have hgq : HasFDerivAt (fun η => qC B.h η ^ (-Aex B.h))
      ((-Aex B.h * qC B.h ξ ^ (-Aex B.h - 1)) • fderiv ℝ (qC B.h) ξ) ξ :=
    hd.rpow_const (Or.inl hne)
  have hgC : HasFDerivAt (fun η => ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ))
      (Complex.ofRealCLM.comp ((-Aex B.h * qC B.h ξ ^ (-Aex B.h - 1)) • fderiv ℝ (qC B.h) ξ)) ξ := by
    have h0 := Complex.ofRealCLM.hasFDerivAt.comp ξ hgq
    exact h0
  have hZw : -Aex B.h * qC B.h ξ ^ (-Aex B.h - 1) * fderiv ℝ (qC B.h) ξ ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) =
      -(qC B.h ξ ^ (-Aex B.h) * (Aex B.h * dZ (fun η => Real.log (qC B.h η)) ξ)) := by
    unfold dZ
    rw [(hd.log hne).fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul, Real.rpow_sub_one hne]
    ring

  have hjet : ∀ (m : ℤ) (i : Fin 3),
      dR B.h (modeCoef5 B G (ssh5Vw B G D) γ m) ξ i =
        ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * dR B.h (fun η => modeCoef5 B G (wmoAmp5 B G D) γ m η i) ξ ∧
      dZ (modeCoef5 B G (ssh5Vw B G D) γ m) ξ i =
        ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * (dZ (fun η => modeCoef5 B G (wmoAmp5 B G D) γ m η i) ξ -
          ((Aex B.h * dZ (fun η => Real.log (qC B.h η)) ξ : ℝ) : ℂ) * modeCoef5 B G (wmoAmp5 B G D) γ m ξ i) := by
    intro m i
    have hEq : modeCoef5 B G (ssh5Vw B G D) γ m =ᶠ[nhds ξ]
        (fun η => ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ)) • modeCoef5 B G (wmoAmp5 B G D) γ m := by
      filter_upwards [hΩ.mem_nhds hξ] with η hη
      funext j
      simp only [modeCoef5, Pi.smul_apply, smul_eq_mul]
      rw [hs1 m η hη, Pi.smul_apply, smul_eq_mul, mul_assoc]
      rfl
    have hF : HasFDerivAt (modeCoef5 B G (wmoAmp5 B G D) γ m)
        (fderiv ℝ (modeCoef5 B G (wmoAmp5 B G D) γ m) ξ) ξ :=
      (modeCoef5_differentiable_v5 B G hok hG (qsOf l0) α (wmoAmp5 B G D) hq hW γ m ξ hξ).hasFDerivAt
    have hFi := (hasFDerivAt_pi'.1 hF i).fderiv
    have hfd := (hEq.fderiv_eq).trans (hgC.smul hF).fderiv
    constructor
    · show fderiv ℝ (modeCoef5 B G (ssh5Vw B G D) γ m) ξ
          ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) i =
        ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * fderiv ℝ (fun η => modeCoef5 B G (wmoAmp5 B G D) γ m η i) ξ
          ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)
      rw [hfd, hFi]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.comp_apply, ContinuousLinearMap.proj_apply,
        Complex.ofRealCLM_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul, hR0, mul_zero,
        Complex.ofReal_zero, zero_mul, add_zero]
    · show fderiv ℝ (modeCoef5 B G (ssh5Vw B G D) γ m) ξ ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) i =
        ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * (fderiv ℝ (fun η => modeCoef5 B G (wmoAmp5 B G D) γ m η i) ξ
          ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) -
          ((Aex B.h * dZ (fun η => Real.log (qC B.h η)) ξ : ℝ) : ℂ) * modeCoef5 B G (wmoAmp5 B G D) γ m ξ i)
      rw [hfd, hFi]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.comp_apply, ContinuousLinearMap.proj_apply,
        Complex.ofRealCLM_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      rw [hZw]
      push_cast
      ring

  obtain ⟨E, hE⟩ : ∃ E : ℤ → ℂ, ∀ k : ℤ,
      E k = Complex.exp (Complex.I * (k : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) := ⟨_, fun k => rfl⟩
  obtain ⟨s, hs⟩ : ∃ s : ℂ, s = ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) := ⟨_, rfl⟩
  have hval : ∀ (m : ℤ) (i : Fin 3), modeCoef5 B G (ssh5Vw B G D) γ m ξ i =
      s * (wmoAmp5 B G D γ m ξ i * E m) := by
    intro m i
    rw [hE, hs]
    show ssh5Vw B G D γ m ξ i * _ = _
    rw [hs1 m ξ hξ, Pi.smul_apply, smul_eq_mul, mul_assoc]
  have hdR' : ∀ (m : ℤ) (i : Fin 3), dR B.h (modeCoef5 B G (ssh5Vw B G D) γ m) ξ i =
      s * ((dR B.h (fun η => wmoAmp5 B G D γ m η i) ξ + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) *
        ((dR B.h (phiL5 B G γ) ξ : ℝ) : ℂ) * wmoAmp5 B G D γ m ξ i) * E m) := by
    intro m i
    rw [(hjet m i).1, (wmo_phase_deriv_v5 B G hok hG (qsOf l0) α (wmoAmp5 B G D) hq hW γ m ξ hξ i).1, hE, hs]
  have hdZ' : ∀ (m : ℤ) (i : Fin 3), dZ (modeCoef5 B G (ssh5Vw B G D) γ m) ξ i =
      s * ((dZ (fun η => wmoAmp5 B G D γ m η i) ξ + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) *
        ((dZ (phiL5 B G γ) ξ : ℝ) : ℂ) * wmoAmp5 B G D γ m ξ i) * E m -
        ((Aex B.h * dZ (fun η => Real.log (qC B.h η)) ξ : ℝ) : ℂ) * (wmoAmp5 B G D γ m ξ i * E m)) := by
    intro m i
    rw [(hjet m i).2, (wmo_phase_deriv_v5 B G hok hG (qsOf l0) α (wmoAmp5 B G D) hq hW γ m ξ hξ i).2, hE, hs]
    rfl
  have hEadd : ∀ a b : ℤ, E (a + b) = E a * E b := by
    intro a b
    rw [hE, hE, hE, ← Complex.exp_add]
    congr 1
    push_cast
    ring
  have hconj : ∀ (m : ℤ) (i : Fin 3), starRingEnd ℂ (modeCoef5 B G (ssh5Vw B G D) γ m ξ i) =
      s * (starRingEnd ℂ (wmoAmp5 B G D γ m ξ i) * E (-m)) := by
    intro m i
    have hsr : starRingEnd ℂ s = s := by rw [hs, Complex.conj_ofReal]
    have hEc : starRingEnd ℂ (E m) = E (-m) := by
      rw [hE, hE, ← Complex.exp_conj]
      congr 1
      simp only [map_mul, Complex.conj_I, Complex.conj_ofReal, map_intCast, map_natCast]
      push_cast
      ring
    rw [hval, map_mul, map_mul, hsr, hEc]

  have hkb : 0 < kb B.h γ.1 := by
    unfold kb epsb
    exact Nat.ceil_pos.2 (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos hQb _) _)
  have hK : (kb B.h γ.1 : ℂ) ≠ 0 := by exact_mod_cast hkb.ne'
  have hr0 : (ξ.1 : ℂ) ≠ 0 := by exact_mod_cast hξ'.1.ne'
  have hQh : ((Real.sqrt (Qb γ.1) : ℝ) : ℂ) ≠ 0 := by exact_mod_cast (Real.sqrt_pos.2 hQb).ne'
  have hs0 : s ≠ 0 := by rw [hs]; exact_mod_cast (Real.rpow_pos_of_pos hq0 _).ne'
  have hE0 : ∀ k, E k ≠ 0 := fun k => by rw [hE]; exact Complex.exp_ne_zero _
  have hQi : Qb γ.1 ^ (-(1/2:ℝ)) = (Real.sqrt (Qb γ.1))⁻¹ := by
    rw [Real.rpow_neg hQb.le, Real.sqrt_eq_rpow]
  have hPC : ((qC B.h ξ ^ (2 * Aex B.h + 1/2) / 2 : ℝ) : ℂ) =
      ((Real.sqrt (qC B.h ξ) : ℝ) : ℂ) / (2 * (s * s)) := by
    have hP : qC B.h ξ ^ (2 * Aex B.h + 1/2) * (qC B.h ξ ^ (-Aex B.h) * qC B.h ξ ^ (-Aex B.h)) =
        Real.sqrt (qC B.h ξ) := by
      rw [← Real.rpow_add hq0, ← Real.rpow_add hq0, Real.sqrt_eq_rpow]
      congr 1
      ring
    have ha : ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) ≠ 0 := by rw [← hs]; exact hs0
    rw [← hP, hs]
    push_cast
    field_simp
  have hpair : ∀ (σ m' : ℤ) (u U : Fin 3 → ℂ), σ + m' = M → (∀ i, U i = s * (u i * E σ)) →
      (((qC B.h ξ ^ (2 * Aex B.h + 1/2) / 2 : ℝ) : ℂ) *
        (Complex.exp (Complex.I * (M : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))⁻¹) •
        ssh5TrM B.h (m' * pint5 B G γ) U (modeCoef5 B G (ssh5Vw B G D) γ m') ξ =
      (1/2 : ℂ) • ssh5T B G γ m' u (wmoAmp5 B G D γ m') ξ := by
    intro σ m' u U hσ hU
    have h1 := hE0 σ
    have h2 := hE0 m'
    rw [← hE M, ← hσ, hEadd, hPC]
    funext i
    fin_cases i <;>
      simp only [ssh5TrM, ssh5T, crossC, nPhi5, DrC, DzC, pang5, RC, dotProduct, Fin.sum_univ_three,
        Pi.smul_apply, smul_eq_mul, hU, hval, hdR', hdZ', hQi, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk,
        Fin.isValue, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
        Matrix.tail_cons] <;>
      push_cast <;>
      field_simp <;>
      ring

  by_cases hM : M = 0
  · subst hM
    simp [ssh5Osc, ssh5PF]
  · simp only [ssh5Osc, ssh5PF, if_neg hM, ssh5QOf]
    rw [Finset.smul_sum, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    rw [Finset.smul_sum, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun m' _ => ?_)
    rw [smul_add, smul_add]
    congr 1
    · by_cases h1 : m + m' = M
      · rw [if_pos h1, if_pos h1]
        exact hpair m m' _ _ h1 (hval m)
      · rw [if_neg h1, if_neg h1, smul_zero, smul_zero]
    · by_cases h2 : m' - m = M
      · rw [if_pos h2, if_pos h2]
        exact hpair (-m) m' _ _ (by omega) (fun i => hconj m i)
      · rw [if_neg h2, if_neg h2, smul_zero, smul_zero]

theorem ssh5_quad_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (β : ℝ) (D : WC) (H : Finset ℤ), 1/2 ≤ β → InWg5 B G (qsOf l0) (β + 1/2) D → InWg5 B G (qsOf l0) β (wmoAmp5 B G D) → InWg5 B G (qsOf l0) (β + 1/2 - kapS) (velRem5 B D) → (0 : ℤ) ∉ H → (∀ γ m, m ∉ H → D γ m = 0) → InWg5 B G (qsOf l0) (β + 2/5) (ssh5PF B G H (wmoAmp5 B G D)) :=
by
  intro B G hok hG
  obtain ⟨hh0, -, hXa, -, -, -, -, -, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨lP, hP⟩ := pq5_prod_class B G hok hG
  obtain ⟨lR, hR⟩ := pq5_dR_class B G hok hG
  obtain ⟨lZ, hZ⟩ := pq5_dZ_class B G hok hG
  obtain ⟨lM, hM⟩ := pq5_mult_class B G hok hG
  obtain ⟨lN, hN⟩ := ssh5_ndot_class B G hok hG
  refine ⟨lP + lR + lZ + lM + lN, fun l0 hl0 β D H hβ hD hW hVR _h0H _hHD => ?_⟩
  have hk : kapS = 1 / 100000 := rfl
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hq1 : qsOf l0 ≤ 1 := by
    rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)

  have hpos : ∀ z t : ℝ, t < 1 → 0 < simScale B.h z (1 - t) := fun z t ht =>
    (hok.1.1 z (1 - t) (by linarith)).1
  have key0 : ∀ (C q a a' : ℝ), 0 < q → q ≤ 1 → a' ≤ a →
      C * q ^ (B.h * a) ≤ |C| * q ^ (B.h * a') := by
    intro C q a a' hq0 hq1' haa
    calc C * q ^ (B.h * a) ≤ |C| * q ^ (B.h * a) :=
          mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0.le _)
      _ ≤ |C| * q ^ (B.h * a') :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0 hq1'
            (mul_le_mul_of_nonneg_left haa hh0.le)) (abs_nonneg C)
  have hED : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 < edgeDist B.Xa B.Xb X := by
    intro X h1 h2
    have hX0 : 0 < X := lt_trans hXa h1
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr h1))
      (Real.log_pos ((one_lt_div hX0).mpr h2)))
  have hSC : ∀ (ξ : Cyl) (b : ℝ), 0 ≤ SC B.h ξ ^ b := by
    intro ξ b
    exact Real.rpow_nonneg (by unfold SC; positivity) b
  have hMono : ∀ (a : WC) (α α' : ℝ),
      α' ≤ α → InWg5 B G (qsOf l0) α a → InWg5 B G (qsOf l0) α' a := by
    intro a α α' hαα ha
    obtain ⟨c1, c2, c3, c4, c5⟩ := ha
    refine ⟨c1, c2, c3, c4, fun k => ?_⟩
    obtain ⟨C, b, d, hC⟩ := c5 k
    refine ⟨|C|, b, d, fun γ m ξ hξ hX1 hX2 => ?_⟩
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hq0 : 0 < qC B.h ξ := hpos ξ.2.1 ξ.2.2.1 hξ'.2.1
    have hq1' : qC B.h ξ ≤ 1 := le_trans hξ'.2.2.le hq1
    refine le_trans (hC γ m ξ hξ hX1 hX2) ?_
    apply mul_le_mul_of_nonneg_right _ (by unfold Penv5; exact (Real.exp_pos _).le)
    apply mul_le_mul_of_nonneg_right _ (Real.rpow_pos_of_pos (hED _ hX1 hX2) _).le
    apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
    exact mul_le_mul_of_nonneg_right (key0 C _ α α' hq0 hq1' hαα) (hSC ξ b)
  have hAddV := (@pq5_add_congr_class B G (qsOf l0) hok hq1 (Fin 3 → ℂ) _ _)
  have low : ∀ (a : WC) (α : ℝ), β + 2/5 ≤ α → InWg5 B G (qsOf l0) α a →
      InWg5 B G (qsOf l0) (β + 2/5) a := fun a α h ha => hMono a α _ h ha
  have add2 : ∀ f g : WC, InWg5 B G (qsOf l0) (β + 2/5) f → InWg5 B G (qsOf l0) (β + 2/5) g →
      InWg5 B G (qsOf l0) (β + 2/5) (fun γ m ξ => f γ m ξ + g γ m ξ) := by
    intro f g hf hg
    have h := hAddV.1 _ _ f g hf hg
    rwa [min_self] at h

  have hNd := hN l0 (by omega) (β + 1/2) D hD hVR
  generalize wmoAmp5 B G D = W at hW hNd ⊢

  have hua : ∀ j : Fin 3, InWg5 B G (qsOf l0) β (fun γ m ξ => W γ m ξ j) := fun j =>
    (pq5_comp_conj_class B G (qsOf l0) β hok).1 W j hW
  have hub : ∀ j : Fin 3, InWg5 B G (qsOf l0) β (fun γ m ξ => starRingEnd ℂ (W γ (-m) ξ j)) := fun j =>
    (pq5_comp_conj_class B G (qsOf l0) β hok).2 _ (hua j)
  have hNdb := (pq5_comp_conj_class B G (qsOf l0) (β + 1/2 - kapS) hok).2 _ hNd

  have hRc := hR l0 (by omega) β W hW
  have hZc := hZ l0 (by omega) β W hW
  obtain ⟨hJ1, hW2, hW3⟩ := hM l0 (by omega) β W hW
  have hZW := hAddV.1 _ _ _ _ hZc hW2

  have hG : ∀ p : ℤ × ℤ, ∃ g : WC, InWg5 B G (qsOf l0) (β + 2/5) g ∧ ∀ γ M ξ, g γ M ξ =
      (if M ∈ ({p.1 + p.2} : Finset ℤ).erase 0 then
        (1/2 : ℂ) • ssh5T B G γ p.2 (W γ p.1 ξ) (W γ p.2) ξ else 0) +
      (if M ∈ ({p.2 - p.1} : Finset ℤ).erase 0 then
        (1/2 : ℂ) • ssh5T B G γ p.2 (fun i => starRingEnd ℂ (W γ p.1 ξ i)) (W γ p.2) ξ else 0) := by
    intro p
    have ha0 : (0:ℤ) ∉ ({p.1 + p.2} : Finset ℤ).erase 0 := Finset.notMem_erase 0 _
    have hb0 : (0:ℤ) ∉ ({p.2 - p.1} : Finset ℤ).erase 0 := Finset.notMem_erase 0 _
    have f1a := low _ _ (by rw [hk]; linarith)
      (hP l0 (by omega) _ _ (1/2 : ℂ) _ _ _ (fun _ => p.1) (fun _ => p.2) ha0 (hua 0) hRc)
    have f2a := low _ _ (by rw [min_eq_right (by linarith)]; linarith)
      (hP l0 (by omega) _ _ (1/2 : ℂ) _ _ _ (fun _ => p.1) (fun _ => p.2) ha0 (hua 2) hZW)
    have f3a := low _ _ (by linarith)
      (hP l0 (by omega) _ _ (1/2 : ℂ) _ _ _ (fun _ => p.1) (fun _ => p.2) ha0 (hua 1) hJ1)
    have f5a := low _ _ (by rw [hk]; linarith)
      (hP l0 (by omega) _ _ (1/2 : ℂ) _ _ _ (fun _ => p.1) (fun _ => p.2) ha0 hNd hW3)
    have f1b := low _ _ (by rw [hk]; linarith)
      (hP l0 (by omega) _ _ (1/2 : ℂ) _ _ _ (fun _ => -p.1) (fun _ => p.2) hb0 (hub 0) hRc)
    have f2b := low _ _ (by rw [min_eq_right (by linarith)]; linarith)
      (hP l0 (by omega) _ _ (1/2 : ℂ) _ _ _ (fun _ => -p.1) (fun _ => p.2) hb0 (hub 2) hZW)
    have f3b := low _ _ (by linarith)
      (hP l0 (by omega) _ _ (1/2 : ℂ) _ _ _ (fun _ => -p.1) (fun _ => p.2) hb0 (hub 1) hJ1)
    have f5b := low _ _ (by rw [hk]; linarith)
      (hP l0 (by omega) _ _ (1/2 : ℂ) _ _ _ (fun _ => -p.1) (fun _ => p.2) hb0 hNdb hW3)
    refine ⟨_, add2 _ _ (add2 _ _ (add2 _ _ (add2 _ _ (add2 _ _ (add2 _ _ (add2 _ _ f1a f2a) f3a) f5a)
      f1b) f2b) f3b) f5b, ?_⟩
    intro γ M ξ
    beta_reduce
    by_cases ha : M ∈ ({p.1 + p.2} : Finset ℤ).erase 0 <;>
      by_cases hb : M ∈ ({p.2 - p.1} : Finset ℤ).erase 0 <;>
      simp only [ha, hb, ↓reduceIte, add_zero, zero_add] <;>
      funext i <;>
      simp only [ssh5T, Pi.add_apply, Pi.smul_apply, smul_eq_mul, dotProduct, Fin.sum_univ_three,
        map_add, map_mul, Complex.conj_ofReal, neg_neg] <;>
      ring
  choose Gp hGpc hGpe using hG

  have hZ0 : InWg5 B G (qsOf l0) (β + 2/5) (fun (_ : Lab) (_ : ℤ) (_ : Cyl) => (0 : Fin 3 → ℂ)) := by
    have hF := hP l0 (by omega) _ _ (1/2 : ℂ) _ _ (∅ : Finset ℤ) id id (Finset.notMem_empty 0) (hua 0) hRc
    have hF' := hAddV.2 _ _ (fun (_ : Lab) (_ : ℤ) (_ : Cyl) => (0 : Fin 3 → ℂ)) hF
      ⟨∅, Finset.notMem_empty 0, fun _ _ _ => rfl⟩ (fun γ m ξ _ => by simp)
    exact low _ _ (by rw [hk]; linarith) hF'

  have hFS : ∀ S : Finset (ℤ × ℤ),
      InWg5 B G (qsOf l0) (β + 2/5) (fun γ M ξ => ∑ p ∈ S, Gp p γ M ξ) := by
    intro S
    refine Finset.induction_on S ?_ ?_
    · simpa only [Finset.sum_empty] using hZ0
    · intro a S ha ih
      have e : (fun γ M ξ => ∑ p ∈ insert a S, Gp p γ M ξ) =
          fun γ M ξ => Gp a γ M ξ + ∑ p ∈ S, Gp p γ M ξ := by
        funext γ M ξ
        rw [Finset.sum_insert ha]
      rw [e]
      exact add2 _ _ (hGpc a) ih

  have hEq : ssh5PF B G H W = fun γ M ξ => ∑ p ∈ H ×ˢ H, Gp p γ M ξ := by
    funext γ M ξ
    simp only [ssh5PF, hGpe]
    by_cases hM : M = 0
    · rw [if_pos hM]
      symm
      apply Finset.sum_eq_zero
      intro p _
      have h1 : M ∉ ({p.1 + p.2} : Finset ℤ).erase 0 := by rw [hM]; exact Finset.notMem_erase 0 _
      have h2 : M ∉ ({p.2 - p.1} : Finset ℤ).erase 0 := by rw [hM]; exact Finset.notMem_erase 0 _
      rw [if_neg h1, if_neg h2, add_zero]
    · have hmem : ∀ x : ℤ, M ∈ ({x} : Finset ℤ).erase 0 ↔ x = M := by
        intro x
        rw [Finset.mem_erase, Finset.mem_singleton]
        constructor
        · rintro ⟨-, h⟩; exact h.symm
        · intro h; exact ⟨hM, h.symm⟩
      rw [if_neg hM, Finset.sum_product, Finset.smul_sum]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      rw [Finset.smul_sum]
      refine Finset.sum_congr rfl (fun m' _ => ?_)
      dsimp only
      rw [smul_add]
      congr 1
      · by_cases h : m + m' = M
        · rw [if_pos h, if_pos ((hmem _).2 h)]
        · rw [if_neg h, if_neg (fun hh => h ((hmem _).1 hh)), smul_zero]
      · by_cases h : m' - m = M
        · rw [if_pos h, if_pos ((hmem _).2 h)]
        · rw [if_neg h, if_neg (fun hh => h ((hmem _).1 hh)), smul_zero]
  rw [hEq]
  exact hFS _

theorem sw5_self_harmonics : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (β : ℝ) (D : WC), 1/2 ≤ β → InWg5 B G (qsOf l0) (β + 1/2) D → InWg5 B G (qsOf l0) β (velW5 B G D) →
    ∃ g : WC, InWg5 B G (qsOf l0) (β + 2/5) g ∧ ∀ x t Y, corrOn B l0 x t →
      sw5Sf B G l0 D x t Y - thAvgVec (sw5Sf B G l0 D) x t Y =
        (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) • cyl2cart x (waveV5 B G g (thetaOf x) (ptOf x t Y)) :=
by
  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  obtain ⟨a1, h1⟩ := ssh5_vel_rep B G hok hG
  obtain ⟨a2, h2⟩ := ssh5_transport_rep B G hok hG
  obtain ⟨a3, h3⟩ := pq5_label_disjoint B G hok hG
  obtain ⟨a6, h6⟩ := ssh5_quad_class B G hok hG
  obtain ⟨a8, h8⟩ := velRem5_class B G hok hG
  obtain ⟨a9, h9⟩ := wmo_amp_class_v5 B G hok hG
  refine ⟨n0 + a1 + a2 + a3 + a6 + a8 + a9, fun l0 hl0 β D hβ hD hvD => ?_⟩

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hq : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le

  have hW : InWg5 B G (qsOf l0) β (wmoAmp5 B G D) := (h9 l0 (by omega)).1 D β hD hvD
  have hR : InWg5 B G (qsOf l0) (β + 1/2 - kapS) (velRem5 B D) := h8 l0 (by omega) (β + 1/2) D hD
  obtain ⟨H, h0H, hHD⟩ := hD.1

  obtain ⟨hVs, hVz, hVsupp, hrep⟩ := h1 l0 (by omega) (β + 1/2) β D hD hvD
  have hVm : ∀ γ m, m ∉ H → ssh5Vw B G D γ m = 0 := fun γ m hm => hVz γ m (hHD γ m hm)
  have hdisj := h3 l0 (by omega) (ssh5Vw B G D) (fun γ m => (hVs γ m).continuousOn) hVsupp
  obtain ⟨hT, hQ⟩ := h2 l0 (by omega) (sw5W B G l0 D) (ssh5Vw B G D) H hVs hVm hVsupp hdisj hrep

  have hPF := h6 l0 (by omega) β D H hβ hD hW hR h0H hHD
  have heq := ssh5_phase_free B G hok hG l0 β D H hq hW

  obtain ⟨Hq, hHq⟩ : ∃ Hq : Finset ℤ, Hq = (H ×ˢ H).image (fun p : ℤ × ℤ => p.1 + p.2) ∪
      (H ×ˢ H).image (fun p : ℤ × ℤ => p.2 - p.1) := ⟨_, rfl⟩
  have hMs : ∀ (γ : Lab) (M : ℤ) (ξ : Cyl), M ∉ Hq → ssh5QOf B G H (ssh5Vw B G D) γ M ξ = 0 := by
    intro γ M ξ hM
    unfold ssh5QOf
    rw [Finset.sum_eq_zero, smul_zero]
    intro m hm
    rw [Finset.sum_eq_zero]
    intro m' hm'
    have e1 : ¬ (m + m' = M) := fun he => hM (by
      rw [hHq]
      exact Finset.mem_union_left _ (Finset.mem_image.2 ⟨(m, m'), Finset.mem_product.2 ⟨hm, hm'⟩, he⟩))
    have e2 : ¬ (m' - m = M) := fun he => hM (by
      rw [hHq]
      exact Finset.mem_union_right _ (Finset.mem_image.2 ⟨(m, m'), Finset.mem_product.2 ⟨hm, hm'⟩, he⟩))
    rw [if_neg e1, if_neg e2, add_zero]
  have hSf : ∀ x t Y, corrOn B l0 x t → sw5Sf B G l0 D x t Y =
      (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) •
        cyl2cart x (waveV5 B G (ssh5QOf B G H (ssh5Vw B G D)) (thetaOf x) (ptOf x t Y)) :=
    fun x t Y hxt => hQ x t Y hxt
  generalize ssh5QOf B G H (ssh5Vw B G D) = Q at hT hSf hMs heq

  have hsum : ∀ (F : Lab → ℤ → ℂ) (Γ : Finset Lab) (H : Finset ℤ),
      (∀ γ m, (γ ∉ Γ ∨ m ∉ H) → F γ m = 0) →
      ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, F γ m = ∑ γ ∈ Γ, ∑ m ∈ H, F γ m := by
    intro F Γ H hF
    have hin : ∀ γ, ∑ᶠ m : ℤ, F γ m = ∑ m ∈ H, F γ m := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      rw [Function.mem_support] at hm
      by_contra h
      exact hm (hF γ m (Or.inr (by simpa using h)))
    simp_rw [hin]
    apply finsum_eq_sum_of_support_subset
    intro γ hγ
    rw [Function.mem_support] at hγ
    by_contra h
    exact hγ (Finset.sum_eq_zero (fun m _ => hF γ m (Or.inl (by simpa using h))))
  have hrot : ∀ r θ z : ℝ, 0 < r → rad (rotPt r θ z) = r ∧ rotPt r θ z 2 = z := by
    intro r θ z hr
    constructor
    · have h : (rotPt r θ z) 0 ^ 2 + (rotPt r θ z) 1 ^ 2 = r ^ 2 := by
        simp [rotPt]
        rw [mul_pow, mul_pow, ← mul_add, Real.cos_sq_add_sin_sq, mul_one]
      unfold rad
      rw [h, Real.sqrt_sq hr.le]
    · simp [rotPt]
  have hframe : ∀ (y : ℝ³), 0 < rad y → ∀ (v : Fin 3 → ℝ) (a : Fin 3),
      inner ℝ (cyl2cart y v) (![eR y, eTh y, eZ] a) = v a := by
    intro y hy v a
    have hr2 : rad y ^ 2 = y 0 ^ 2 + y 1 ^ 2 := Real.sq_sqrt (by positivity)
    have hne : rad y ≠ 0 := hy.ne'
    have hs : (rad y)⁻¹ ^ 2 * (y 0 ^ 2 + y 1 ^ 2) = 1 := by
      rw [← hr2]; field_simp
    fin_cases a <;>
      simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three] <;>
      first
      | linear_combination (v 0) * hs
      | linear_combination (v 1) * hs
  have hthA : ∀ (c z : ℝ) (f : ℝ → ℝ), Continuous f → thA f = 0 →
      thA (fun θ => c * (z + f θ)) = c * z := by
    intro c z f hf h0
    have hpi : (2 * Real.pi) ≠ 0 := by positivity
    have hI : ∫ θ in (0:ℝ)..(2 * Real.pi), f θ = 0 := by
      unfold thA at h0
      rcases mul_eq_zero.mp h0 with h | h
      · exact absurd h (inv_ne_zero hpi)
      · exact h
    unfold thA
    rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_add
      (continuous_const.intervalIntegrable _ _) (hf.intervalIntegrable _ _),
      intervalIntegral.integral_const, hI, smul_eq_mul, sub_zero, add_zero]
    calc (2 * Real.pi)⁻¹ * (c * (2 * Real.pi * z)) = c * z * ((2 * Real.pi)⁻¹ * (2 * Real.pi)) := by
          ring
      _ = c * z := by rw [inv_mul_cancel₀ hpi, mul_one]
  refine ⟨ssh5PF B G H (wmoAmp5 B G D), hPF, ?_⟩
  intro x t Y hxt
  have hxt' : 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
  have hξ : ptOf x t Y ∈ DomC B.h (qsOf l0) := hxt
  have hrx : 0 < rad x := hxt'.1
  obtain ⟨T, hTz⟩ := hT _ hξ
  have hQH : ∀ γ m, (γ ∉ T ∨ m ∉ insert 0 Hq) → Q γ m (ptOf x t Y) = 0 := by
    intro γ m h
    rcases h with h | h
    · exact hTz γ m h
    · exact hMs γ m _ (fun hm => h (Finset.mem_insert_of_mem hm))
  have hOH : ∀ γ m, (γ ∉ T ∨ m ∉ insert 0 Hq) → ssh5Osc Q γ m (ptOf x t Y) = 0 := by
    intro γ m h
    unfold ssh5Osc
    split_ifs
    · rfl
    · exact hQH γ m h

  have hsplit : ∀ θ', waveV5 B G Q θ' (ptOf x t Y) =
      (fun i => (∑ γ ∈ T, Q γ 0 (ptOf x t Y) i).re) + waveV5 B G (ssh5Osc Q) θ' (ptOf x t Y) := by
    intro θ'
    funext i
    have e1 : ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) =
        ∑ γ ∈ T, ∑ m ∈ insert 0 Hq, Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) :=
      hsum _ T _ (fun γ m h => by simp only [hQH γ m h, Pi.zero_apply, zero_mul])
    have e2 : ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, ssh5Osc Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) =
        ∑ γ ∈ T, ∑ m ∈ insert 0 Hq,
          ssh5Osc Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) :=
      hsum _ T _ (fun γ m h => by simp only [hOH γ m h, Pi.zero_apply, zero_mul])
    show (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y)).re =
      (∑ γ ∈ T, Q γ 0 (ptOf x t Y) i).re +
        (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, ssh5Osc Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y)).re
    rw [e1, e2, ← Complex.add_re, ← Finset.sum_add_distrib]
    congr 1
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    have h0H' : (0:ℤ) ∈ insert 0 Hq := Finset.mem_insert_self _ _
    have hind : Q γ 0 (ptOf x t Y) i = ∑ m ∈ insert 0 Hq,
        (if m = 0 then Q γ m (ptOf x t Y) i else 0) := by
      rw [Finset.sum_ite_eq', if_pos h0H']
    rw [hind, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    by_cases hm : m = 0
    · subst hm
      simp [ssh5Osc, ephase5]
    · simp [ssh5Osc, hm]

  have hmean : thAvgVec (sw5Sf B G l0 D) x t Y = cyl2cart x (fun a =>
      qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2)) * (∑ γ ∈ T, Q γ 0 (ptOf x t Y) a).re) := by
    unfold thAvgVec
    congr 1
    funext a
    have hfun : (fun θ => inner ℝ (sw5Sf B G l0 D (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) =
        fun θ => qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2)) *
          ((∑ γ ∈ T, Q γ 0 (ptOf x t Y) a).re +
            waveS5 B G (fun γ m η => ssh5Osc Q γ m η a) (thetaOf (rotPt (rad x) θ (x 2))) (ptOf x t Y)) := by
      funext θ
      obtain ⟨hr, hzz⟩ := hrot (rad x) θ (x 2) hrx
      have hc : corrOn B l0 (rotPt (rad x) θ (x 2)) t := by
        show 0 < rad (rotPt (rad x) θ (x 2)) ∧ t < 1 ∧
          simScale B.h ((rotPt (rad x) θ (x 2)) 2) (1 - t) < qsOf l0
        rw [hr, hzz]
        exact hxt'
      have hp : ptOf (rotPt (rad x) θ (x 2)) t Y = ptOf x t Y := by
        show (rad (rotPt (rad x) θ (x 2)), (rotPt (rad x) θ (x 2)) 2, t, Y) = (rad x, x 2, t, Y)
        rw [hr, hzz]
      rw [hSf _ t Y hc, hp, real_inner_smul_left]
      have hf : frameAt θ (ptOf x t Y) a =
          ![eR (rotPt (rad x) θ (x 2)), eTh (rotPt (rad x) θ (x 2)), eZ] a := rfl
      rw [hf, hframe _ (by rw [hr]; exact hrx), hsplit]
      rfl
    have hm1 : ∀ γ m, m ∉ Hq.erase 0 → ssh5Osc Q γ m (ptOf x t Y) a = 0 := by
      intro γ m hm
      unfold ssh5Osc
      split_ifs with h0
      · rfl
      · exact congrFun (hMs γ m _ (fun hmq => hm (Finset.mem_erase.2 ⟨h0, hmq⟩))) a
    have hm2 : ∀ γ m, γ ∉ T → ssh5Osc Q γ m (ptOf x t Y) a = 0 := by
      intro γ m hγ
      exact congrFun (hOH γ m (Or.inl hγ)) a
    obtain ⟨hcont, hz⟩ := waveS5_circle_mean_zero B G (fun γ m η => ssh5Osc Q γ m η a) (ptOf x t Y)
      (rad x) (x 2) (Hq.erase 0) T hrx (Finset.notMem_erase 0 Hq) hm1 hm2
    rw [hfun]
    exact hthA _ _ _ hcont hz

  have hPFeq : waveV5 B G (ssh5Osc Q) (thetaOf x) (ptOf x t Y) =
      waveV5 B G (ssh5PF B G H (wmoAmp5 B G D)) (thetaOf x) (ptOf x t Y) := by
    have e : ∀ γ M, ssh5Osc Q γ M (ptOf x t Y) = ssh5PF B G H (wmoAmp5 B G D) γ M (ptOf x t Y) :=
      fun γ M => heq γ M _ hξ
    unfold waveV5
    simp_rw [e]
  rw [hmean, hSf x t Y hxt, hsplit, ← hPFeq]
  simp only [cyl2cart, Pi.add_apply, add_smul, smul_add, smul_smul]
  abel

theorem sw5_O1_flat_smooth : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (S : CState) (bw ca cm cd α : ℝ) (f : WC) (Fl : Ext ℝ³), StOrd5 B G l0 S bw ca cm cd →
    InWg5 B G (qsOf l0) α f →
    (∀ x t Y, corrOn B l0 x t →
      resX B.h (uX5 B G l0 S) (PX5 B G l0 S) x t Y - thAvgVec (resX B.h (uX5 B G l0 S) (PX5 B G l0 S)) x t Y =
        (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) • cyl2cart x (waveV5 B G f (thetaOf x) (ptOf x t Y))
          + Fl x t Y) →
    ∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (↿(evOff B.h Fl Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} :=
by
  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, ?_⟩
  intro l0 hl0 S bw ca cm cd α f Fl hSt hf hid Y₀
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le

  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  obtain ⟨hΩo, hΨ, hQs, -, heR, heTh⟩ := corr_domain_v5 B l0 Y₀ hok
  obtain ⟨-, hUsm, hPsm, -⟩ := state_flow_props_v5 B G l0 S bw ca cm cd hok hG hqsB hSt Y₀
  set Ω : Set (ℝ³ × ℝ) := {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} with hΩdef
  set Ψ : ℝ³ × ℝ → Cyl := fun w => ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y₀) with hΨdef
  have hSP : SimScaleProps B.h := hok.1
  have hΩmem : ∀ w ∈ Ω, corrOn B l0 w.1 w.2 := fun w hw => hw
  have hΨmaps : MapsTo Ψ Ω (DomC B.h (qsOf l0)) := fun w hw => hw
  have hQpos : ∀ w ∈ Ω, 0 < simScale B.h (w.1 2) (1 - w.2) := fun w hw =>
    (hSP.1 (w.1 2) (1 - w.2) (by linarith [(hΩmem w hw).2.1])).1
  have hQΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) Ω :=
    hQs.mono (fun w hw => (hΩmem w hw).2.1)
  have hQp : ∀ p : ℝ, ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2) ^ p) Ω :=
    fun p => hQΩ.rpow_const_of_ne (fun w hw => (hQpos w hw).ne')
  have heRΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => eR w.1) Ω :=
    heR.comp contDiff_fst.contDiffOn (fun w hw => (hΩmem w hw).1)
  have heThΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => eTh w.1) Ω :=
    heTh.comp contDiff_fst.contDiffOn (fun w hw => (hΩmem w hw).1)
  have hbase : ∀ (l : ℕ) (i : Fin 3), ContDiffOn ℝ ∞ (fun ξ => baseC B l ξ i) (DomC B.h (qsOf l0)) := by
    intro l i
    have h1 := (geom_slow_base_smooth_v5 B hok).2 l i
    have hp : ContDiff ℝ ∞ (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) :=
      contDiff_fst.prodMk ((contDiff_fst.comp contDiff_snd).prodMk
        (contDiff_fst.comp (contDiff_snd.comp contDiff_snd)))
    have hmaps : MapsTo (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) (DomC B.h (qsOf l0))
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
      intro ξ hξ
      have h3 : qC B.h ξ < B.qB := lt_of_lt_of_le hξ.2.2 hqsB
      exact ⟨hξ.1, hξ.2.1, h3⟩
    have hcomp := h1.comp hp.contDiffOn hmaps
    refine hcomp.congr (fun ξ _ => ?_)
    simp only [Function.comp_apply, baseC]
  have hwave : ∀ a : WS, (∃ H : Finset ℤ, ∀ γ m, m ∉ H → a γ m = 0) →
      (∀ γ m, ContDiffOn ℝ ∞ (a γ m) (DomC B.h (qsOf l0))) →
      (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → a γ m ξ ≠ 0 → SuppW B G γ ξ) →
      ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => waveS5 B G a (thetaOf w.1) (Ψ w)) Ω := by
    intro a hHa ha hsupp
    obtain ⟨H, hH⟩ := hHa
    have hfac : ∀ w : ℝ³ × ℝ, waveS5 B G a (thetaOf w.1) (Ψ w) =
        (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, a γ m (Ψ w) * Complex.exp (Complex.I * (m : ℂ) *
          ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (Ψ w) : ℂ))) *
          Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf w.1 : ℂ))).re := by
      intro w
      unfold waveS5
      congr 1
      refine finsum_congr (fun γ => finsum_congr (fun m => ?_))
      unfold ephase5
      have key : Complex.I * (m : ℂ) * ((pint5 B G γ : ℂ) * (thetaOf w.1 : ℂ) +
          (kb B.h γ.1 : ℂ) * (phiL5 B G γ (Ψ w) : ℂ)) =
          Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (Ψ w) : ℂ)) +
          Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf w.1 : ℂ) := by
        push_cast; ring
      rw [key, Complex.exp_add]
      ring
    refine (wave_sum_assembly Ω (DomC B.h (qsOf l0)) Ψ
      (fun γ m ξ => a γ m ξ * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))
      (fun γ m => m * pint5 B G γ) H hΩo (fun w hw => (hΩmem w hw).1) hΨ hΨmaps ?_ ?_
      (fun γ m => wave_coef_phase_smooth_v5 B G (qsOf l0) a hG hbase ha hsupp γ m)).congr
      (fun w _ => hfac w)
    · intro γ m hm ξ _
