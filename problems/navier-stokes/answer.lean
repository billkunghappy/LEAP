        rw [hF', Set.Finite.mem_toFinset] at hp; exact hp
      rw [Fintype.sum_bool]
      obtain ⟨Hp, hHp⟩ : ∃ H, H = Hcol B G (p.1, p.2, true) (ξ.1, ξ.2.1, ξ.2.2.1) := ⟨_, rfl⟩
      obtain ⟨Hm, hHm⟩ : ∃ H, H = Hcol B G (p.1, p.2, false) (ξ.1, ξ.2.1, ξ.2.2.1) := ⟨_, rfl⟩
      obtain ⟨T, hT⟩ : ∃ T, T = T0star4 B p.1 ξ := ⟨_, rfl⟩
      have hd : Hp.1 * Hm.2 - Hm.1 * Hp.2 ≠ 0 := by
        rw [hHp, hHm]; exact hdet (p.1, p.2, true) hpe
      have e1 : yAmp4 B G (p.1, p.2, true) ξ =
          (Hm.2 * T.1 - Hm.1 * T.2) / (Hp.1 * Hm.2 - Hm.1 * Hp.2) := by
        subst hHp hHm hT; rfl
      have e2 : yAmp4 B G (p.1, p.2, false) ξ =
          (Hp.1 * T.2 - Hp.2 * T.1) / (Hp.1 * Hm.2 - Hm.1 * Hp.2) := by
        subst hHp hHm hT; rfl
      have hcr := congrArg π (cram Hp Hm T hd)
      simp only [map_add, map_smul, smul_eq_mul] at hcr
      have hπT : yAmp4 B G (p.1, p.2, true) ξ * π Hp + yAmp4 B G (p.1, p.2, false) ξ * π Hm =
          (Qb p.1 / qC B.h ξ) ^ (1 - B.h) *
            π (B.T0th (XC B.h ξ) (etaC B.h ξ), B.T0z (XC B.h ξ) (etaC B.h ξ)) := by
        rw [e1, e2, hcr, hT]; unfold T0star4; rw [map_smul, smul_eq_mul]
      have hn := hnorm p.1
      show Kc (p.1, p.2, true) * (2 * π (Hcol B G (p.1, p.2, true) (ξ.1, ξ.2.1, ξ.2.2.1))) +
          Kc (p.1, p.2, false) * (2 * π (Hcol B G (p.1, p.2, false) (ξ.1, ξ.2.1, ξ.2.2.1))) = _
      rw [← hHp, ← hHm, hKc, hKc,
        show etaL B.h (p.1, p.2, false) ξ = etaL B.h (p.1, p.2, true) ξ from rfl]
      linear_combination ((qC B.h ξ ^ (-B.h) * Qb p.1 ^ (-(1/2:ℝ))) ^ 2 * epsb B.h p.1 *
          etaL B.h (p.1, p.2, true) ξ ^ 2) * hπT +
        (π (B.T0th (XC B.h ξ) (etaC B.h ξ), B.T0z (XC B.h ξ) (etaC B.h ξ)) *
          etaL B.h (p.1, p.2, true) ξ ^ 2) * hn
    have hs1 : ∑ p ∈ F', etaL B.h (p.1, p.2, true) ξ ^ 2 = 1 := by
      rw [← hsum]; symm
      apply finsum_eq_sum_of_support_subset
      intro p hp
      rw [Function.mem_support] at hp
      rw [Finset.mem_coe, hF', Set.Finite.mem_toFinset]
      exact fun h0 => hp (by rw [h0]; ring)
    rw [hF, Finset.sum_map, Finset.sum_product, Finset.sum_congr rfl hbox, ← Finset.mul_sum, hs1, mul_one]
  refine ⟨?_, ?_⟩
  · exact key 1 (ContinuousLinearMap.fst ℝ ℝ ℝ) (Or.inl rfl) (fun v => by simp)
  · exact key 2 (ContinuousLinearMap.snd ℝ ℝ ℝ) (Or.inr rfl) (fun v => by simp)

theorem mom_class_algebra_v4 : ∀ (B : BG) (qs : ℝ), B.ok → 0 < qs → qs ≤ 1 →
    (∀ (α β γ c d : ℝ) (f g k : Cyl → ℝ), InM B qs α f → InM B qs β g → γ ≤ α → γ ≤ β →
      (∀ ξ ∈ DomC B.h qs, k ξ = c * f ξ + d * g ξ) → InM B qs γ k) ∧
    (∀ (α β γ c d : ℝ) (F G K : ℝ × ℝ → ℝ), InS B qs α F → InS B qs β G → γ ≤ α → γ ≤ β →
      (∀ w : ℝ × ℝ, w.2 < 1 → simScale B.h w.1 (1 - w.2) < qs → K w = c * F w + d * G w) →
      InS B qs γ K) :=
by
  intro B qs hok hqs0 hqs1
  have hS : SimScaleProps B.h := hok.1
  have hh : 0 < B.h := hok.2.1.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1

  have hΩ : IsOpen {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} := by
    have hcont : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hS.2.2.2.1.continuousOn
    have hφ : Continuous (fun w : ℝ × ℝ => ((w.1, 1 - w.2) : ℝ × ℝ)) :=
      continuous_fst.prodMk (continuous_const.sub continuous_snd)
    have hcomp : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2)) {w : ℝ × ℝ | w.2 < 1} :=
      hcont.comp hφ.continuousOn (fun w hw => ⟨mem_univ _, by
        have hw' : w.2 < 1 := hw
        show (0:ℝ) < 1 - w.2
        linarith⟩)
    exact hcomp.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  have hD : IsOpen (DomC B.h qs) := by
    have hπ : Continuous (fun ξ : Cyl => ((ξ.2.1, ξ.2.2.1) : ℝ × ℝ)) :=
      (continuous_snd.fst).prodMk (continuous_snd.snd.fst)
    exact (isOpen_lt continuous_const continuous_fst).inter (hΩ.preimage hπ)

  have lin : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (U : Set E) (f g k : E → ℝ)
      (c d : ℝ), IsOpen U → ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ g U →
      (∀ x ∈ U, k x = c * f x + d * g x) →
      ContDiffOn ℝ ∞ k U ∧ ∀ (n : ℕ) (x : E) (L : E →L[ℝ] E), x ∈ U →
        ‖(iteratedFDeriv ℝ n k x).compContinuousLinearMap (fun _ => L)‖ ≤
          |c| * ‖(iteratedFDeriv ℝ n f x).compContinuousLinearMap (fun _ => L)‖ +
          |d| * ‖(iteratedFDeriv ℝ n g x).compContinuousLinearMap (fun _ => L)‖ := by
    intro E _ _ U f g k c d hU hf hg hk
    have hp : ContDiffOn ℝ ∞ (fun y => c * f y + d * g y) U :=
      (contDiffOn_const.mul hf).add (contDiffOn_const.mul hg)
    refine ⟨hp.congr hk, ?_⟩
    intro n x L hx
    have hev : k =ᶠ[nhds x] (c • f + d • g) :=
      Filter.eventuallyEq_of_mem (hU.mem_nhds hx) (fun y hy => by simp [hk y hy, smul_eq_mul])
    have hfa : ContDiffAt ℝ n f x := (hf.contDiffAt (hU.mem_nhds hx)).of_le (by exact_mod_cast le_top)
    have hga : ContDiffAt ℝ n g x := (hg.contDiffAt (hU.mem_nhds hx)).of_le (by exact_mod_cast le_top)
    have heq : iteratedFDeriv ℝ n k x =
        c • iteratedFDeriv ℝ n f x + d • iteratedFDeriv ℝ n g x := by
      have e1 : iteratedFDeriv ℝ n (c • f + d • g) x =
          iteratedFDeriv ℝ n (c • f) x + iteratedFDeriv ℝ n (d • g) x :=
        iteratedFDeriv_add_apply (hfa.const_smul c) (hga.const_smul d)
      rw [(hev.iteratedFDeriv ℝ n).eq_of_nhds, e1,
        iteratedFDeriv_const_smul_apply hfa, iteratedFDeriv_const_smul_apply hga]
    have hlin : (c • iteratedFDeriv ℝ n f x + d • iteratedFDeriv ℝ n g x).compContinuousLinearMap
          (fun _ => L) =
        c • (iteratedFDeriv ℝ n f x).compContinuousLinearMap (fun _ => L) +
        d • (iteratedFDeriv ℝ n g x).compContinuousLinearMap (fun _ => L) := by
      ext v; simp
    rw [heq, hlin]
    refine (norm_add_le _ _).trans ?_
    rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]

  have wm : ∀ (C q α γ S b b' : ℝ), 0 < q → q ≤ 1 → γ ≤ α → 1 ≤ S → b ≤ b' →
      C * q ^ (B.h * α) * S ^ b ≤ |C| * q ^ (B.h * γ) * S ^ b' := by
    intro C q α γ S b b' hq0 hq1 hγ hS1 hb
    have h1 : q ^ (B.h * α) ≤ q ^ (B.h * γ) :=
      Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (mul_le_mul_of_nonneg_left hγ hh.le)
    have h2 : S ^ b ≤ S ^ b' := Real.rpow_le_rpow_of_exponent_le hS1 hb
    have h3 : 0 ≤ q ^ (B.h * α) := Real.rpow_nonneg hq0.le _
    have h4 : 0 ≤ S ^ b := Real.rpow_nonneg (by linarith) _
    calc C * q ^ (B.h * α) * S ^ b ≤ |C| * q ^ (B.h * α) * S ^ b :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_abs_self C) h3) h4
      _ ≤ |C| * q ^ (B.h * γ) * S ^ b' :=
          mul_le_mul (mul_le_mul_of_nonneg_left h1 (abs_nonneg C)) h2 h4
            (mul_nonneg (abs_nonneg C) (Real.rpow_nonneg hq0.le _))
  have key : ∀ (γ q S W e : ℝ), 0 < q → q ≤ 1 → 1 ≤ S → 0 ≤ W → 0 < e → e ≤ 1 →
      ∀ (C₀ a b₀ d₀ b' d' : ℝ), γ ≤ a → b₀ ≤ b' → d₀ ≤ d' →
      C₀ * q ^ (B.h * a) * S ^ b₀ * W * e ^ (-d₀) ≤
        |C₀| * (q ^ (B.h * γ) * S ^ b' * W * e ^ (-d')) := by
    intro γ q S W e hq0 hq1 hS1 hW he0 he1 C₀ a b₀ d₀ b' d' ha hb hd
    have P := wm C₀ q a γ S b₀ b' hq0 hq1 ha hS1 hb
    have E : e ^ (-d₀) ≤ e ^ (-d') := Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hd)
    have hep : 0 ≤ e ^ (-d₀) := Real.rpow_nonneg he0.le _
    have hn : 0 ≤ |C₀| * q ^ (B.h * γ) * S ^ b' * W :=
      mul_nonneg (mul_nonneg (mul_nonneg (abs_nonneg _) (Real.rpow_nonneg hq0.le _))
        (Real.rpow_nonneg (by linarith) _)) hW
    calc C₀ * q ^ (B.h * a) * S ^ b₀ * W * e ^ (-d₀)
        ≤ |C₀| * q ^ (B.h * γ) * S ^ b' * W * e ^ (-d₀) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right P hW) hep
      _ ≤ |C₀| * q ^ (B.h * γ) * S ^ b' * W * e ^ (-d') :=
          mul_le_mul_of_nonneg_left E hn
      _ = _ := by ring
  refine ⟨?_, ?_⟩
  · intro α β γ c d f g k hf hg hγα hγβ hk
    obtain ⟨f1, f2, f3, f4⟩ := hf
    obtain ⟨g1, g2, g3, g4⟩ := hg
    obtain ⟨hksm, hkb⟩ := lin (DomC B.h qs) f g k c d hD f1 g1 hk
    refine ⟨hksm, ?_, ?_, ?_⟩
    · intro ξ hξ a ha
      have hsh : shY ξ a ∈ DomC B.h qs := hξ
      rw [hk _ hsh, f2 ξ hξ a ha, g2 ξ hξ a ha, hk ξ hξ]
    · intro ξ hξ hX
      rw [hk ξ hξ, f3 ξ hξ hX, g3 ξ hξ hX]
      ring
    · intro n
      obtain ⟨C₁, b₁, d₁, H₁⟩ := f4 n
      obtain ⟨C₂, b₂, d₂, H₂⟩ := g4 n
      refine ⟨|c| * |C₁| + |d| * |C₂|, max b₁ b₂, max d₁ d₂, fun ξ hξ hX1 hX2 => ?_⟩
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
      have hq0 : 0 < qC B.h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
      have hq1 : qC B.h ξ ≤ 1 := hξ'.2.2.le.trans hqs1
      have hSC : 1 ≤ SC B.h ξ := by
        unfold SC
        exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h ξ))])
      have hEW : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
        unfold edgeWeight
        split_ifs
        · positivity
        · exact le_rfl
      have hX0 : 0 < XC B.h ξ := hXa.trans hX1
      have hE0 : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) := by
        unfold edgeDist
        exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
          (Real.log_pos ((one_lt_div hX0).mpr hX2)))
      have hE1 : edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := by
        unfold edgeDist
        exact min_le_left _ _
      have k1 := (H₁ ξ hξ hX1 hX2).trans (key γ _ _ _ _ hq0 hq1 hSC hEW hE0 hE1 C₁ α b₁ d₁
        (max b₁ b₂) (max d₁ d₂) hγα (le_max_left _ _) (le_max_left _ _))
      have k2 := (H₂ ξ hξ hX1 hX2).trans (key γ _ _ _ _ hq0 hq1 hSC hEW hE0 hE1 C₂ β b₂ d₂
        (max b₁ b₂) (max d₁ d₂) hγβ (le_max_right _ _) (le_max_right _ _))
      have hk0 : NB B.h k n ξ ≤ |c| * NB B.h f n ξ + |d| * NB B.h g n ξ :=
        hkb n ξ (Lnorm B.h ξ) hξ
      exact hk0.trans ((add_le_add (mul_le_mul_of_nonneg_left k1 (abs_nonneg c))
        (mul_le_mul_of_nonneg_left k2 (abs_nonneg d))).trans (le_of_eq (by ring)))
  · intro α β γ c d F G K hF hG hγα hγβ hK
    obtain ⟨F1, F2⟩ := hF
    obtain ⟨G1, G2⟩ := hG
    obtain ⟨hKsm, hKb⟩ := lin _ F G K c d hΩ F1 G1 (fun w hw => hK w hw.1 hw.2)
    refine ⟨hKsm, fun n => ?_⟩
    obtain ⟨C₁, b₁, H₁⟩ := F2 n
    obtain ⟨C₂, b₂, H₂⟩ := G2 n
    refine ⟨|c| * |C₁| + |d| * |C₂|, max b₁ b₂, fun w hw1 hw2 => ?_⟩
    have hs0 : 0 < simScale B.h w.1 (1 - w.2) := (hS.1 w.1 (1 - w.2) (by linarith)).1
    have hs1 : simScale B.h w.1 (1 - w.2) ≤ 1 := hw2.le.trans hqs1
    have hL : 1 ≤ 1 + |Real.log (simScale B.h w.1 (1 - w.2))| := by
      linarith [abs_nonneg (Real.log (simScale B.h w.1 (1 - w.2)))]
    have k1 := (H₁ w hw1 hw2).trans (wm C₁ _ α γ _ (2 * b₁) (2 * max b₁ b₂) hs0 hs1 hγα hL
      (by linarith [le_max_left b₁ b₂]))
    have k2 := (H₂ w hw1 hw2).trans (wm C₂ _ β γ _ (2 * b₂) (2 * max b₁ b₂) hs0 hs1 hγβ hL
      (by linarith [le_max_right b₁ b₂]))
    have hk0 := hKb n w ((simScale B.h w.1 (1 - w.2) ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
        (simScale B.h w.1 (1 - w.2) • ContinuousLinearMap.id ℝ ℝ)) ⟨hw1, hw2⟩
    exact hk0.trans ((add_le_add (mul_le_mul_of_nonneg_left k1 (abs_nonneg c))
      (mul_le_mul_of_nonneg_left k2 (abs_nonneg d))).trans (le_of_eq (by ring)))

theorem g_regular_of_nrm_InM_v5 : ∀ (B : BG) (qs e α : ℝ) (g : Cyl → ℝ), B.ok → InM B qs α (nrm B e g) → ContDiffOn ℝ ∞ g (DomC B.h qs) ∧ ∀ ξ ∈ DomC B.h qs, (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → g ξ = 0 :=
by
  intro B qs e α g hok hg
  obtain ⟨hs, -, hz, -⟩ := hg
  have hpos : ∀ η ∈ DomC B.h qs, 0 < qC B.h η := by
    intro η hη
    obtain ⟨-, h2, -⟩ := hη
    exact (hok.1.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hS : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
    hok.1.2.2.2.1
  have hφ : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by fun_prop
  have hmaps : Set.MapsTo (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ))
      (DomC B.h qs) (univ ×ˢ Ioi 0) := by
    intro η hη
    obtain ⟨-, h2, -⟩ := hη
    exact ⟨mem_univ _, show (0:ℝ) < 1 - η.2.2.1 by linarith⟩
  have hq : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h qs) :=
    (hS.comp hφ.contDiffOn hmaps).congr (fun η _ => rfl)
  have hw : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-e)) (DomC B.h qs) :=
    hq.rpow_const_of_ne (fun η hη => (hpos η hη).ne')
  have hid : ∀ η ∈ DomC B.h qs, g η = qC B.h η ^ (-e) * nrm B e g η := by
    intro η hη
    have h0 := hpos η hη
    show g η = qC B.h η ^ (-e) * (qC B.h η ^ e * g η)
    rw [← mul_assoc, ← Real.rpow_add h0, neg_add_cancel, Real.rpow_zero, one_mul]
  refine ⟨(hw.mul hs).congr hid, ?_⟩
  intro ξ hξ hX
  have h1 : qC B.h ξ ^ e * g ξ = 0 := hz ξ hξ hX
  exact (mul_eq_zero.mp h1).resolve_left (Real.rpow_pos_of_pos (hpos ξ hξ) e).ne'

theorem mwh5_waveV_add : ∀ (B : BG) (G : CorrGeom), B.ok → ∀ (l0 : ℕ) (f g : WC) (α β : ℝ), (∀ ξ₀ ∈ DomC B.h (qsOf l0), ∃ (U : Set Cyl) (Γ : Finset Lab), IsOpen U ∧ ξ₀ ∈ U ∧ ∀ ξ ∈ U, ∀ γ, γ ∉ Γ → ¬ SuppW B G γ ξ) → InWg5 B G (qsOf l0) α f → InWg5 B G (qsOf l0) β g → InWg5 B G (qsOf l0) (min α β) (f + g) ∧ ∀ (θ : ℝ) (ξ : Cyl), ξ ∈ DomC B.h (qsOf l0) → waveV5 B G (f + g) θ ξ = waveV5 B G f θ ξ + waveV5 B G g θ ξ :=
by
  intro B G hok l0 f g α β _hLF hf hg
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  generalize qsOf l0 = qs at hf hg hqs1 ⊢

  have hΓfin : ∀ (h : ℝ) (ξ : Cyl), SimScaleProps h → ξ.2.2.1 < 1 →
      {γ : Lab | ξ ∈ tsupport (etaL h γ)}.Finite := by
    intro h ξ hS hξ
    have s1 : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ → 1 < |φ ξ / μ - (j : ℝ)| →
        ∀ᶠ η in nhds ξ, sqPart μ j (φ η) = 0 := by
      intro μ j φ hφ h1
      have hψ : ContinuousAt (fun η => |φ η / μ - (j : ℝ)|) ξ :=
        ((hφ.div_const μ).sub continuousAt_const).abs
      have hev := (continuousAt_const : ContinuousAt (fun _ : Cyl => (1:ℝ)) ξ).eventually_lt hψ h1
      filter_upwards [hev] with η hη
      have hsq : 1 < (φ η / μ - (j : ℝ)) ^ 2 := (one_lt_sq_iff_one_lt_abs _).mpr hη
      unfold sqPart bumpR
      rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_div]
    have hτ : 0 < 1 - ξ.2.2.1 := by linarith
    have hqpos : 0 < qC h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
    have hqcont : ContinuousAt (qC h) ξ := by
      have hU : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
      have hp : ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) :=
        ⟨trivial, hτ⟩
      have hg : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (ξ.2.1, 1 - ξ.2.2.1) :=
        hS.2.2.2.1.continuousOn.continuousAt (hU.mem_nhds hp)
      have hk : ContinuousAt (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) ξ := by fun_prop
      have he : qC h = (fun w : ℝ × ℝ => simScale h w.1 w.2) ∘
          (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by
        funext η; rfl
      rw [he]
      exact ContinuousAt.comp hg hk
    have hLc : ContinuousAt (fun η => Real.logb 2 (qC h η)) ξ := hqcont.logb hqpos.ne'
    have hwin : ∀ γ : Lab, ξ ∈ tsupport (etaL h γ) →
        |Real.logb 2 (qC h ξ) + (γ.1:ℝ)| ≤ 1 ∧
        |chartR h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1:ℝ)| ≤ 1 ∧
        |chartZ h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.1:ℝ)| ≤ 1 ∧
        |chartT h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2:ℝ)| ≤ 1 := by
      intro γ hγ
      have key : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ →
          (∀ η, sqPart μ j (φ η) = 0 → etaL h γ η = 0) → |φ ξ / μ - (j:ℝ)| ≤ 1 := by
        intro μ j φ hφ himp
        by_contra hc
        push_neg at hc
        have hev := s1 μ j φ hφ hc
        apply (notMem_tsupport_iff_eventuallyEq.mpr _) hγ
        filter_upwards [hev] with η hη
        exact himp η hη
      refine ⟨?_, ?_, ?_, ?_⟩
      · have := key 1 (-(γ.1:ℤ)) (fun η => Real.logb 2 (qC h η)) hLc
          (fun η hη => by simp only [etaL, hη, zero_mul])
        simpa [div_one, sub_neg_eq_add] using this
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.1 (chartR h γ.1) (by unfold chartR; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.1 (chartZ h γ.1) (by unfold chartZ; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.2 (chartT h γ.1) (by unfold chartT; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
    have hI : ∀ (c : ℝ) (j : ℤ), |c - (j:ℝ)| ≤ 1 → j ∈ Set.Icc ⌈c - 1⌉ ⌊c + 1⌋ := by
      intro c j hj
      rw [abs_le] at hj
      exact ⟨Int.ceil_le.mpr (by linarith [hj.2]), Int.le_floor.mpr (by linarith [hj.1])⟩
    have hfin : (⋃ n ∈ Set.Iic ⌊1 - Real.logb 2 (qC h ξ)⌋₊, ({n} : Set ℕ) ×ˢ
        ((Set.Icc ⌈chartR h n ξ / Sb n ^ (-3:ℤ) - 1⌉ ⌊chartR h n ξ / Sb n ^ (-3:ℤ) + 1⌋ ×ˢ
          Set.Icc ⌈chartZ h n ξ / Sb n ^ (-3:ℤ) - 1⌉ ⌊chartZ h n ξ / Sb n ^ (-3:ℤ) + 1⌋ ×ˢ
          Set.Icc ⌈chartT h n ξ / Sb n ^ (-3:ℤ) - 1⌉ ⌊chartT h n ξ / Sb n ^ (-3:ℤ) + 1⌋) ×ˢ
          (Set.univ : Set Bool))).Finite := by
      refine Set.Finite.biUnion (Set.finite_Iic _) (fun n _ => ?_)
      exact (Set.finite_singleton n).prod (((Set.finite_Icc _ _).prod
        ((Set.finite_Icc _ _).prod (Set.finite_Icc _ _))).prod Set.finite_univ)
    refine hfin.subset ?_
    rintro ⟨n, ⟨a, b, c⟩, σ⟩ hγ
    obtain ⟨h1, h2, h3, h4⟩ := hwin _ hγ
    rw [abs_le] at h1
    refine Set.mem_iUnion₂.mpr ⟨n, Nat.le_floor (by simp only at h1; linarith [h1.2]), ?_⟩
    exact ⟨rfl, ⟨hI _ _ h2, hI _ _ h3, hI _ _ h4⟩, trivial⟩
  have hh0 : 0 ≤ B.h := hok.2.1.1.le
  have hXa : 0 < B.Xa := hok.2.1.2.2.1

  have hDopen : IsOpen (DomC B.h qs) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4 : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3 := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio qs := by
      ext ξ
      constructor
      · rintro ⟨h1, h2, h3⟩
        exact ⟨⟨h1, h2⟩, h3⟩
      · rintro ⟨⟨h1, h2⟩, h3⟩
        exact ⟨h1, h2, h3⟩
    rw [e]
    exact h3
  have hDq : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 ∧ 1 ≤ SC B.h ξ := by
    intro ξ hξ
    obtain ⟨-, h2, h3⟩ := hξ
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    refine ⟨hq0, by linarith, ?_⟩
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hEdge : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X ∧
      0 < edgeDist B.Xa B.Xb X ∧ edgeDist B.Xa B.Xb X ≤ 1 := by
    intro X h1 h2
    refine ⟨?_, ?_, min_le_left _ _⟩
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · have hX : 0 < X := lt_trans hXa h1
      have l1 : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr h1)
      have l2 : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX).mpr h2)
      exact lt_min one_pos (lt_min l1 l2)

  have hW : ∀ (q Sv E e P C1 C2 b1 b2 d1 d2 a a1 a2 N1 N2 : ℝ), 0 < q → q ≤ 1 → 1 ≤ Sv → 0 ≤ E →
      0 < e → e ≤ 1 → 0 ≤ P → a ≤ a1 → a ≤ a2 →
      N1 ≤ C1 * q ^ (B.h * a1) * Sv ^ b1 * E * e ^ (-d1) * P →
      N2 ≤ C2 * q ^ (B.h * a2) * Sv ^ b2 * E * e ^ (-d2) * P →
      N1 + N2 ≤ (|C1| + |C2|) * q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P := by
    intro q Sv E e P C1 C2 b1 b2 d1 d2 a a1 a2 N1 N2 hq0 hq1 hS1 hE he0 he1 hP ha1 ha2 hN1 hN2
    have key : ∀ (C b d ai N : ℝ), a ≤ ai → N ≤ C * q ^ (B.h * ai) * Sv ^ b * E * e ^ (-d) * P →
        b ≤ max b1 b2 → d ≤ max d1 d2 →
        N ≤ |C| * (q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by
      intro C b d ai N hα hN hb hd
      have f1 : q ^ (B.h * ai) ≤ q ^ (B.h * a) :=
        Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (mul_le_mul_of_nonneg_left hα hh0)
      have f2 : Sv ^ b ≤ Sv ^ (max b1 b2) := Real.rpow_le_rpow_of_exponent_le hS1 hb
      have f3 : e ^ (-d) ≤ e ^ (-(max d1 d2)) :=
        Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hd)
      have p1 : 0 ≤ q ^ (B.h * ai) := Real.rpow_nonneg hq0.le _
      have p2 : 0 ≤ Sv ^ b := Real.rpow_nonneg (by linarith) _
      have p3 : 0 ≤ e ^ (-d) := Real.rpow_nonneg he0.le _
      have p1' : 0 ≤ q ^ (B.h * a) := Real.rpow_nonneg hq0.le _
      have p2' : 0 ≤ Sv ^ (max b1 b2) := Real.rpow_nonneg (by linarith) _
      have m1 : q ^ (B.h * ai) * Sv ^ b ≤ q ^ (B.h * a) * Sv ^ (max b1 b2) := mul_le_mul f1 f2 p2 p1'
      have m2 : q ^ (B.h * ai) * Sv ^ b * E ≤ q ^ (B.h * a) * Sv ^ (max b1 b2) * E :=
        mul_le_mul_of_nonneg_right m1 hE
      have m3 : q ^ (B.h * ai) * Sv ^ b * E * e ^ (-d) ≤
          q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) :=
        mul_le_mul m2 f3 p3 (mul_nonneg (mul_nonneg p1' p2') hE)
      have hWi := mul_le_mul_of_nonneg_right m3 hP
      have hWi0 : 0 ≤ q ^ (B.h * ai) * Sv ^ b * E * e ^ (-d) * P :=
        mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg p1 p2) hE) p3) hP
      calc N ≤ C * q ^ (B.h * ai) * Sv ^ b * E * e ^ (-d) * P := hN
        _ = C * (q ^ (B.h * ai) * Sv ^ b * E * e ^ (-d) * P) := by ring
        _ ≤ |C| * (q ^ (B.h * ai) * Sv ^ b * E * e ^ (-d) * P) :=
            mul_le_mul_of_nonneg_right (le_abs_self C) hWi0
        _ ≤ |C| * (q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) :=
            mul_le_mul_of_nonneg_left hWi (abs_nonneg C)
    have k1 := key C1 b1 d1 a1 N1 ha1 hN1 (le_max_left _ _) (le_max_left _ _)
    have k2 := key C2 b2 d2 a2 N2 ha2 hN2 (le_max_right _ _) (le_max_right _ _)
    have e : (|C1| + |C2|) * q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P =
        |C1| * (q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) +
        |C2| * (q ^ (B.h * a) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by ring
    rw [e]
    linarith

  have hNB : ∀ (f1 f2 g0 : Cyl → (Fin 3 → ℂ)) (k : ℕ) (ξ : Cyl),
      ξ ∈ DomC B.h qs → ContDiffOn ℝ ∞ f1 (DomC B.h qs) →
      ContDiffOn ℝ ∞ f2 (DomC B.h qs) →
      (∀ η ∈ DomC B.h qs, g0 η = f1 η + f2 η) → NB B.h g0 k ξ ≤ NB B.h f1 k ξ + NB B.h f2 k ξ := by
    intro f1 f2 g0 k ξ hξ hf1 hf2 heq
    have hn : DomC B.h qs ∈ nhds ξ := hDopen.mem_nhds hξ
    have hev : g0 =ᶠ[nhds ξ] f1 + f2 := Filter.eventuallyEq_of_mem hn (fun η hη => heq η hη)
    have e1 : iteratedFDeriv ℝ k g0 ξ = iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ := by
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      exact iteratedFDeriv_add_apply ((hf1.contDiffAt hn).of_le (by exact_mod_cast le_top))
        ((hf2.contDiffAt hn).of_le (by exact_mod_cast le_top))
    unfold NB
    rw [e1]
    have e2 : (iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) =
        (iteratedFDeriv ℝ k f1 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) +
        (iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    exact norm_add_le _ _
  obtain ⟨⟨Hf, h0f, hHf⟩, sf, df, uf, bf⟩ := hf
  obtain ⟨⟨Hg, h0g, hHg⟩, sg, dg, ug, bg⟩ := hg
  refine ⟨⟨⟨Hf ∪ Hg, ?_, ?_⟩, fun γ m => ((sf γ m).add (sg γ m)).congr (fun _ _ => rfl), ?_, ?_, ?_⟩, ?_⟩
  · rw [Finset.mem_union, not_or]
    exact ⟨h0f, h0g⟩
  · intro γ m hm
    rw [Finset.mem_union, not_or] at hm
    show f γ m + g γ m = 0
    rw [hHf γ m hm.1, hHg γ m hm.2, add_zero]
  · intro γ m ξ hξ c hc
    show f γ m (shY ξ c) + g γ m (shY ξ c) = f γ m ξ + g γ m ξ
    rw [df γ m ξ hξ c hc, dg γ m ξ hξ c hc]
  · intro γ m ξ hξ hne
    change f γ m ξ + g γ m ξ ≠ 0 at hne
    by_cases h : f γ m ξ = 0
    · rw [h, zero_add] at hne
      exact ug γ m ξ hξ hne
    · exact uf γ m ξ hξ h
  · intro k
    obtain ⟨C1, c1, e1, hb1⟩ := bf k
    obtain ⟨C2, c2, e2, hb2⟩ := bg k
    refine ⟨|C1| + |C2|, max c1 c2, max e1 e2, fun γ m ξ hξ hX1 hX2 => ?_⟩
    obtain ⟨hq0, hq1, hS1⟩ := hDq ξ hξ
    obtain ⟨hE, he0, he1⟩ := hEdge _ hX1 hX2
    have hn := hNB (f γ m) (g γ m) ((f + g) γ m) k ξ hξ (sf γ m) (sg γ m) (fun _ _ => rfl)
    have hP : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
      unfold Penv5
      exact (Real.exp_pos _).le
    have := hW (qC B.h ξ) (SC B.h ξ) (Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)))
      (edgeDist B.Xa B.Xb (XC B.h ξ)) (Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2))
      C1 C2 c1 c2 e1 e2 (min α β) α β _ _ hq0 hq1 hS1 (Real.sqrt_nonneg _) he0 he1 hP
      (min_le_left α β) (min_le_right α β)
      (hb1 γ m ξ hξ hX1 hX2) (hb2 γ m ξ hξ hX1 hX2)
    exact le_trans hn this
  ·
    intro θ ξ hξ
    have hξ1 : ξ.2.2.1 < 1 := by
      obtain ⟨-, h2, -⟩ := hξ
      exact h2
    have hΓ := hΓfin B.h ξ hok.1 hξ1
    funext i
    simp only [waveV5, Pi.add_apply]
    rw [← Complex.add_re]
    congr 1
    have hin : ∀ γ : Lab, ∑ᶠ m : ℤ, (f γ m ξ i + g γ m ξ i) * ephase5 B G γ m θ ξ =
        ∑ᶠ m : ℤ, f γ m ξ i * ephase5 B G γ m θ ξ + ∑ᶠ m : ℤ, g γ m ξ i * ephase5 B G γ m θ ξ := by
      intro γ
      simp_rw [add_mul]
      apply finsum_add_distrib
      · refine Set.Finite.subset (Finset.finite_toSet Hf) ?_
        intro m hm
        by_contra hc
        rw [Function.mem_support] at hm
        apply hm
        rw [hHf γ m hc]
        simp
      · refine Set.Finite.subset (Finset.finite_toSet Hg) ?_
        intro m hm
        by_contra hc
        rw [Function.mem_support] at hm
        apply hm
        rw [hHg γ m hc]
        simp
    rw [finsum_congr hin]
    apply finsum_add_distrib
    · refine Set.Finite.subset hΓ ?_
      intro γ hγ
      by_contra hc
      rw [Function.mem_support] at hγ
      apply hγ
      apply finsum_eq_zero_of_forall_eq_zero
      intro m
      have h0 : f γ m ξ = 0 := by
        by_contra hne
        exact hc (uf γ m ξ hξ hne).2.1
      rw [h0]
      simp
    · refine Set.Finite.subset hΓ ?_
      intro γ hγ
      by_contra hc
      rw [Function.mem_support] at hγ
      apply hγ
      apply finsum_eq_zero_of_forall_eq_zero
      intro m
      have h0 : g γ m ξ = 0 := by
        by_contra hne
        exact hc (ug γ m ξ hξ hne).2.1
      rw [h0]
      simp

theorem wmo_local_modes_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (l0 : ℕ) (T : CState) (α : ℝ) (Γ : Finset Lab) (H : Finset ℤ), qsOf l0 ≤ B.qB → InWg5 B G (qsOf l0) α T.Aw → InM B (qsOf l0) (1/2) T.Psi → ∀ ξ ∈ DomC B.h (qsOf l0), (∃ N ∈ nhds ξ, ∀ η ∈ N ∩ DomC B.h (qsOf l0), ∀ γ m, T.Aw γ m η ≠ 0 → γ ∈ Γ ∧ m ∈ H) → ∀ (θ : ℝ) (a : Fin 3), ucyl5 B G l0 T θ ξ a = ucyl5 B G l0 (wmoBase T) θ ξ a + ∑ γ ∈ Γ, ∑ m ∈ H, inner ℝ (curl3 (modeF5 B.h (1/2 - Aex B.h) ξ.2.2.1 (ξ.2.2.2 - Yph B.h ξ.1 ξ.2.2.1) (m * pint5 B G γ) (modeCoef5 B G T.Aw γ m)) (rotPt ξ.1 θ ξ.2.1)) (frameAt θ ξ a) :=
by
  intro B G hok hG l0 T α Γ H hqB hT hP ξ hξ hcovH
  rcases ξ with ⟨r, z, t, Y⟩
  obtain ⟨hr, ht, hqξ⟩ : 0 < r ∧ t < 1 ∧ simScale B.h z (1 - t) < qsOf l0 := id hξ
  obtain ⟨N, hN, hsupp⟩ := hcovH
  have hopen : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi

  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'

  have hexp : ∀ (A : WC) (θ' : ℝ) (η : Cyl), (∀ γ m, A γ m η ≠ 0 → γ ∈ Γ ∧ m ∈ H) →
      waveV5 B G A θ' η = ∑ γ ∈ Γ, ∑ m ∈ H, (fun i => (modeCoef5 B G A γ m η i *
        Complex.exp (Complex.I * (((m * pint5 B G γ : ℤ)) : ℂ) * (θ' : ℂ))).re) := by
    intro A θ' η hA
    funext i
    have hph : ∀ γ m, A γ m η i * ephase5 B G γ m θ' η = modeCoef5 B G A γ m η i *
        Complex.exp (Complex.I * (((m * pint5 B G γ : ℤ)) : ℂ) * (θ' : ℂ)) := by
      intro γ m
      simp only [ephase5, modeCoef5]
      rw [mul_assoc (A γ m η i), ← Complex.exp_add]
      congr 2
      push_cast
      ring
    have hin : ∀ γ, ∑ᶠ m : ℤ, A γ m η i * ephase5 B G γ m θ' η =
        ∑ m ∈ H, A γ m η i * ephase5 B G γ m θ' η := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      rw [Function.support_subset_iff']
      intro m hm
      by_contra hne
      have hA0 : A γ m η ≠ 0 := fun h0 => hne (by simp [h0])
      exact hm (Finset.mem_coe.mpr (hA γ m hA0).2)
    have hout : (Function.support fun γ => ∑ m ∈ H, A γ m η i * ephase5 B G γ m θ' η) ⊆ ↑Γ := by
      rw [Function.support_subset_iff']
      intro γ hγ
      apply Finset.sum_eq_zero
      intro m _
      by_contra hne
      have hA0 : A γ m η ≠ 0 := fun h0 => hne (by simp [h0])
      exact hγ (Finset.mem_coe.mpr (hA γ m hA0).1)
    simp only [waveV5, Finset.sum_apply]
    rw [finsum_congr hin, finsum_eq_sum_of_support_subset _ hout, Complex.re_sum]
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [Complex.re_sum]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    rw [hph]

  have hcyl_sum : ∀ (y : ℝ³) {ι : Type} (s : Finset ι) (v : ι → Fin 3 → ℝ),
      cyl2cart y (∑ j ∈ s, v j) = ∑ j ∈ s, cyl2cart y (v j) := by
    intro y ι s v
    let L : (Fin 3 → ℝ) →+ ℝ³ := AddMonoidHom.mk' (cyl2cart y) (fun c d => by
      simp only [cyl2cart, Pi.add_apply, add_smul]; abel)
    exact map_sum L v s

  have hcurl : ∀ (F F' : ℝ³ → ℝ³) {ι : Type} (s : Finset ι) (g : ι → ℝ³ → ℝ³) (x : ℝ³),
      F' =ᶠ[nhds x] (fun y => F y + ∑ i ∈ s, g i y) → DifferentiableAt ℝ F x →
      (∀ i ∈ s, DifferentiableAt ℝ (g i) x) → curl3 F' x = curl3 F x + ∑ i ∈ s, curl3 (g i) x := by
    intro F F' ι s g x hev hF hg
    have hfd : fderiv ℝ F' x = fderiv ℝ F x + ∑ i ∈ s, fderiv ℝ (g i) x := by
      rw [hev.fderiv_eq, fderiv_fun_add hF (DifferentiableAt.fun_sum hg), fderiv_fun_sum hg]
    let cH : (ℝ³ →L[ℝ] ℝ³) →+ ℝ³ := AddMonoidHom.mk' (fun L =>
      (L (EuclideanSpace.single 1 1) 2 - L (EuclideanSpace.single 2 1) 1) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
      (L (EuclideanSpace.single 2 1) 0 - L (EuclideanSpace.single 0 1) 2) • EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
      (L (EuclideanSpace.single 0 1) 1 - L (EuclideanSpace.single 1 1) 0) • EuclideanSpace.single (2 : Fin 3) (1 : ℝ))
      (by
        intro L1 L2
        simp only [ContinuousLinearMap.add_apply, PiLp.add_apply, add_smul, sub_smul]
        abel)
    have e1 : ∀ G' : ℝ³ → ℝ³, curl3 G' x = cH (fderiv ℝ G' x) := fun G' => rfl
    have e2 : ∑ i ∈ s, curl3 (g i) x = ∑ i ∈ s, cH (fderiv ℝ (g i) x) :=
      Finset.sum_congr rfl (fun i _ => e1 (g i))
    rw [e2, e1 F', e1 F, hfd, map_add, map_sum]
  intro θ a
  dsimp only

  obtain ⟨x, hxdef⟩ : ∃ x : ℝ³, x = rotPt r θ z := ⟨_, rfl⟩
  have hx0 : x 0 = r * Real.cos θ := by rw [hxdef]; simp [rotPt]
  have hx1 : x 1 = r * Real.sin θ := by rw [hxdef]; simp [rotPt]
  have hx2 : x 2 = z := by rw [hxdef]; simp [rotPt]
  have hsq : x 0 ^ 2 + x 1 ^ 2 = r ^ 2 := by
    rw [hx0, hx1]; linear_combination r ^ 2 * Real.sin_sq_add_cos_sq θ
  have hrad : rad x = r := by
    show Real.sqrt (x 0 ^ 2 + x 1 ^ 2) = r
    rw [hsq, Real.sqrt_sq hr.le]
  have hradd : DifferentiableAt ℝ rad x := by
    have h1 : DifferentiableAt ℝ (fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2) x := by fun_prop
    exact h1.sqrt (by rw [hsq]; exact (pow_pos hr 2).ne')
  have hPx : ptOf x t (Yph B.h (rad x) t + (Y - Yph B.h r t)) = (r, z, t, Y) := by
    simp [ptOf, hrad, hx2]
  have hPd : DifferentiableAt ℝ (fun y : ℝ³ => ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) x := by
    have hr1 : DifferentiableAt ℝ (fun y : ℝ³ => rad y ^ drx B.h) x :=
      hradd.rpow_const (Or.inl (by rw [hrad]; exact hr.ne'))
    have h2 : DifferentiableAt ℝ (fun y : ℝ³ => y 2) x := by fun_prop
    have h4 : DifferentiableAt ℝ (fun y : ℝ³ => Yph B.h (rad y) t + (Y - Yph B.h r t)) x :=
      ((hr1.smul_const vrv).add_const (t • vtv)).add_const _
    exact hradd.prodMk (h2.prodMk ((differentiableAt_const t).prodMk h4))
  have hq_d : DifferentiableAt ℝ (fun y : ℝ³ => simScale B.h (y 2) (1 - t)) x := by
    have hmem : ((x 2, 1 - t) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ)) :=
      ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩
    have h1 : DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (x 2, 1 - t) :=
      (hok.1.2.2.2.1.contDiffAt (hopen.mem_nhds hmem)).differentiableAt (by norm_num)
    have h2 : DifferentiableAt ℝ (fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ)) x := by fun_prop
    exact DifferentiableAt.comp (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2) x h1 h2
  have hNx : N ∩ DomC B.h (qsOf l0) ∈ nhds (ptOf x t (Yph B.h (rad x) t + (Y - Yph B.h r t))) := by
    rw [hPx]; exact Filter.inter_mem hN (hDopen.mem_nhds hξ)
  have hO : ∀ᶠ y in nhds x, 0 < rad y ∧ simScale B.h (y 2) (1 - t) < qsOf l0 ∧
      ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t)) ∈ N ∩ DomC B.h (qsOf l0) := by
    have e1 : ∀ᶠ y in nhds x, (0:ℝ) < rad y :=
      continuousAt_const.eventually_lt hradd.continuousAt (by rw [hrad]; exact hr)
    have e2 : ∀ᶠ y in nhds x, simScale B.h (y 2) (1 - t) < qsOf l0 :=
      hq_d.continuousAt.eventually_lt continuousAt_const (by rw [hx2]; exact hqξ)
    have e3 : ∀ᶠ y in nhds x, ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t)) ∈ N ∩ DomC B.h (qsOf l0) :=
      hPd.continuousAt.preimage_mem_nhds hNx
    exact e1.and (e2.and e3)

  have hloc : ∀ (S' : CState) (A : WC) (Ψ : Cyl → ℝ), S'.Aw = A → S'.Psi = Ψ →
      (∀ η ∈ N ∩ DomC B.h (qsOf l0), ∀ γ m, A γ m η ≠ 0 → γ ∈ Γ ∧ m ∈ H) →
      (fun y => AX5 B G l0 S' y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) =ᶠ[nhds x]
      (fun y => B.AB y t + ((∑ γ ∈ Γ, ∑ m ∈ H, modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
          (m * pint5 B G γ) (modeCoef5 B G A γ m) y) +
        qC B.h (ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) ^ (1/2 - Aex B.h) •
          (Ψ (ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) • eTh y))) := by
    intro S' A Ψ hA hΨ hsupp'
    subst hA hΨ
    filter_upwards [hO] with y hy
    obtain ⟨hy1, hy2, hy3⟩ := hy
    have hcorr : corrOn B l0 y t := ⟨hy1, ht, hy2⟩
    simp only [AX5]
    rw [if_pos hcorr, smul_add, hexp S'.Aw (thetaOf y) _ (hsupp' _ hy3), hcyl_sum, Finset.smul_sum]
    congr 2
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [hcyl_sum, Finset.smul_sum]
    all_goals rfl
  have hTl := hloc T T.Aw T.Psi rfl rfl hsupp
  have hBl := hloc (wmoBase T) 0 T.Psi rfl rfl (fun _ _ γ m h => (h rfl).elim)

  have hz : ∀ (n : ℤ) (γ : Lab) (m : ℤ) (y : ℝ³),
      modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) n (modeCoef5 B G (0 : WC) γ m) y = 0 := by
    intro n γ m y
    simp [modeF5, modeCoef5, cyl2cart]
  have hev : (fun y => AX5 B G l0 T y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) =ᶠ[nhds x]
      (fun y => AX5 B G l0 (wmoBase T) y t (Yph B.h (rad y) t + (Y - Yph B.h r t)) +
        ∑ p ∈ Γ ×ˢ H, modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (p.2 * pint5 B G p.1)
          (modeCoef5 B G T.Aw p.1 p.2) y) := by
    filter_upwards [hTl, hBl] with y h1 h2
    rw [h1, h2]
    simp only [hz, Finset.sum_const_zero, zero_add, Finset.sum_product]
    abel

  have hPxr : 0 < rad x := by rw [hrad]; exact hr
  have hMD : ∀ γ m, DifferentiableAt ℝ (modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t)
      (m * pint5 B G γ) (modeCoef5 B G T.Aw γ m)) x := by
    intro γ m
    refine modeF5_differentiable_v5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (m * pint5 B G γ)
      (modeCoef5 B G T.Aw γ m) x hok.1 ht hPxr ?_
    rw [hPx]
    exact modeCoef5_differentiable_v5 B G hok hG (qsOf l0) α T.Aw hqB hT γ m _ hξ
  have hAB : DifferentiableAt ℝ (fun y => B.AB y t) x := by
    have hmem2 : ((x 2, 1 - t) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ)) :=
      ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩
    have hc1 : ContinuousAt (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) (x, t) := by
      have h1 : ContinuousAt (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (x 2, 1 - t) :=
        (hok.1.2.2.2.1.contDiffAt (hopen.mem_nhds hmem2)).continuousAt
      have h2 : ContinuousAt (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) (x, t) := by fun_prop
      exact ContinuousAt.comp (x := ((x, t) : ℝ³ × ℝ)) (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2)
        (f := fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) h1 h2
    have hmemN : simDomain B.h B.qB ∈ nhds ((x, t) : ℝ³ × ℝ) := by
      have e1 : ∀ᶠ w in nhds ((x, t) : ℝ³ × ℝ), w.2 < 1 :=
        continuousAt_snd.eventually_lt continuousAt_const ht
      have e2 : ∀ᶠ w in nhds ((x, t) : ℝ³ × ℝ), simScale B.h (w.1 2) (1 - w.2) < B.qB :=
        hc1.eventually_lt continuousAt_const (by
          show simScale B.h (x 2) (1 - t) < B.qB
          rw [hx2]; exact lt_of_lt_of_le hqξ hqB)
      filter_upwards [e1, e2] with w h1 h2
      exact ⟨h1, h2⟩
    have hcd : DifferentiableAt ℝ (↿B.AB) ((x, t) : ℝ³ × ℝ) :=
      (hok.2.2.2.2.1.1.contDiffAt hmemN).differentiableAt (by norm_num)
    have hpm : DifferentiableAt ℝ (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) x :=
      differentiableAt_id.prodMk (differentiableAt_const t)
    exact DifferentiableAt.comp (g := ↿B.AB) x hcd hpm
  have hΨ : DifferentiableAt ℝ (fun y => qC B.h (ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) ^
      (1/2 - Aex B.h) • (T.Psi (ptOf y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) • eTh y)) x := by
    have hqpos : 0 < simScale B.h (x 2) (1 - t) := (hok.1.1 _ (1 - t) (by linarith)).1
    have h1 : DifferentiableAt ℝ (fun y : ℝ³ => simScale B.h (y 2) (1 - t) ^ (1/2 - Aex B.h)) x :=
      hq_d.rpow_const (Or.inl hqpos.ne')
    have hPsi0 : DifferentiableAt ℝ T.Psi (ptOf x t (Yph B.h (rad x) t + (Y - Yph B.h r t))) := by
      rw [hPx]; exact (hP.1.contDiffAt (hDopen.mem_nhds hξ)).differentiableAt (by norm_num)
    have h2 := hPsi0.comp x hPd
    have h3 : DifferentiableAt ℝ (fun y => eTh y) x := by
      have hi := hradd.inv (by rw [hrad]; exact hr.ne')
      have ha : DifferentiableAt ℝ (fun y : ℝ³ => azVec y) x := by unfold azVec; fun_prop
      exact hi.smul ha
    exact h1.smul (h2.smul h3)
  have hFbase : DifferentiableAt ℝ
      (fun y => AX5 B G l0 (wmoBase T) y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) x := by
    rw [hBl.differentiableAt_iff]
    simp only [hz, Finset.sum_const_zero, zero_add]
    exact hAB.add hΨ
  have hcurlEq := hcurl (fun y => AX5 B G l0 (wmoBase T) y t (Yph B.h (rad y) t + (Y - Yph B.h r t)))
    (fun y => AX5 B G l0 T y t (Yph B.h (rad y) t + (Y - Yph B.h r t)))
    (Γ ×ˢ H) (fun p => modeF5 B.h (1/2 - Aex B.h) t (Y - Yph B.h r t) (p.2 * pint5 B G p.1)
      (modeCoef5 B G T.Aw p.1 p.2)) x hev hFbase (fun p _ => hMD p.1 p.2)

  have hu : ∀ S' : CState, ucyl5 B G l0 S' θ (r, z, t, Y) a =
      inner ℝ (curl3 (fun y => AX5 B G l0 S' y t (Yph B.h (rad y) t + (Y - Yph B.h r t))) x +
        BX B G l0 S' x t Y) (frameAt θ (r, z, t, Y) a) := by
    intro S'
    subst hxdef
    simp only [ucyl5, uX5, curlX, evOff, hrad]
  have hBX : BX B G l0 T x t Y = BX B G l0 (wmoBase T) x t Y := rfl
  rw [hu T, hu (wmoBase T), hcurlEq, hBX, ← hxdef]
  simp only [inner_add_left, sum_inner, Finset.sum_product]
  exact add_right_comm _ _ _

theorem wmo_base_theta_free_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (T : CState), B.ok → qsOf l0 ≤ B.qB → InM B (qsOf l0) (1/2) T.Psi → ∀ ξ ∈ DomC B.h (qsOf l0), ∀ (θ : ℝ) (a : Fin 3), ucyl5 B G l0 (wmoBase T) θ ξ a = ucyl5 B G l0 (wmoBase T) 0 ξ a :=
by

  have trig : ∀ (h e t : ℝ) (Y0 : ℝ × ℝ) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (r z : ℝ), 0 < r → DifferentiableAt ℝ (modeF5 h e t Y0 n c) (rotPt r 0 z) → DifferentiableAt ℝ (modeF5 h e t Y0 n (fun η i => Complex.I * c η i)) (rotPt r 0 z) → ∀ (Y : ℝ × ℝ) (a : Fin 3), ∃ A1 A2 : ℝ, ∀ θ : ℝ, inner ℝ (curl3 (modeF5 h e t Y0 n c) (rotPt r θ z)) (frameAt θ (r, z, t, Y) a) = Real.cos (n * θ) * A1 + Real.sin (n * θ) * A2 := by
    have hc : ∀ (φ : ℝ) (y : ℝ³), rotZ5 φ y 0 = Real.cos φ * y 0 - Real.sin φ * y 1 ∧
        rotZ5 φ y 1 = Real.sin φ * y 0 + Real.cos φ * y 1 ∧ rotZ5 φ y 2 = y 2 := by
      intro φ y
      simp [rotZ5]
    have ext3 : ∀ u v : ℝ³, u 0 = v 0 → u 1 = v 1 → u 2 = v 2 → u = v := by
      intro u v h0 h1 h2
      ext i
      fin_cases i
      · exact h0
      · exact h1
      · exact h2
    have hinv : ∀ (φ : ℝ) (y : ℝ³), rotZ5 φ (rotZ5 (-φ) y) = y := by
      intro φ y
      obtain ⟨a0, a1, a2⟩ := hc φ (rotZ5 (-φ) y)
      obtain ⟨b0, b1, b2⟩ := hc (-φ) y
      apply ext3
      · rw [a0, b0, b1, Real.cos_neg, Real.sin_neg]
        linear_combination y 0 * Real.cos_sq_add_sin_sq φ
      · rw [a1, b0, b1, Real.cos_neg, Real.sin_neg]
        linear_combination y 1 * Real.cos_sq_add_sin_sq φ
      · rw [a2, b2]
    have hrad : ∀ (φ : ℝ) (y : ℝ³), rad (rotZ5 φ y) = rad y := by
      intro φ y
      obtain ⟨a0, a1, -⟩ := hc φ y
      unfold rad
      rw [a0, a1]
      congr 1
      linear_combination (y 0 ^ 2 + y 1 ^ 2) * Real.cos_sq_add_sin_sq φ
    have hlin : ∀ φ : ℝ, ∃ L : ℝ³ →L[ℝ] ℝ³, ∀ v : ℝ³, L v = rotZ5 φ v := by
      intro φ
      let f : ℝ³ →ₗ[ℝ] ℝ³ :=
        { toFun := rotZ5 φ
          map_add' := fun u v => by
            apply ext3 <;> simp [hc] <;> ring
          map_smul' := fun a u => by
            apply ext3 <;> simp [hc] <;> ring }
      exact ⟨⟨f, f.continuous_of_finiteDimensional⟩, fun v => rfl⟩
    have hinner : ∀ (φ : ℝ) (u v : ℝ³), inner ℝ (rotZ5 φ u) (rotZ5 φ v) = inner ℝ u v := by
      intro φ u v
      have e : ∀ a b : ℝ³, inner ℝ a b = a 0 * b 0 + a 1 * b 1 + a 2 * b 2 := by
        intro a b
        simp [PiLp.inner_apply, Fin.sum_univ_three]
        ring
      rw [e, e]
      obtain ⟨a0, a1, a2⟩ := hc φ u
      obtain ⟨b0, b1, b2⟩ := hc φ v
      rw [a0, a1, a2, b0, b1, b2]
      linear_combination (u 0 * v 0 + u 1 * v 1) * Real.cos_sq_add_sin_sq φ
    have hpt : ∀ r φ z : ℝ, rotPt r φ z = rotZ5 φ (rotPt r 0 z) := by
      intro r φ z
      apply ext3 <;> simp [rotPt, hc] <;> ring
    have hframe : ∀ (φ : ℝ) (y : ℝ³), eR (rotZ5 φ y) = rotZ5 φ (eR y) ∧
        eTh (rotZ5 φ y) = rotZ5 φ (eTh y) ∧ rotZ5 φ eZ = eZ := by
      intro φ y
      refine ⟨?_, ?_, ?_⟩
      · apply ext3 <;> simp [eR, radVec, hc, hrad] <;> ring
      · apply ext3 <;> simp [eTh, azVec, hc, hrad] <;> ring
      · apply ext3 <;> simp [eZ, hc]
    have hphase : ∀ (φ : ℝ) (y : ℝ³) (n : ℤ), 0 < rad y →
        Complex.exp (Complex.I * (n : ℂ) * (thetaOf (rotZ5 φ y) : ℂ)) =
          Complex.exp (Complex.I * (n : ℂ) * (φ : ℂ)) *
            Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ)) := by
      intro φ y n hy
      obtain ⟨w, hw⟩ : ∃ w : ℂ, w = ⟨y 0, y 1⟩ := ⟨_, rfl⟩
      obtain ⟨w', hw'⟩ : ∃ w' : ℂ, w' = ⟨rotZ5 φ y 0, rotZ5 φ y 1⟩ := ⟨_, rfl⟩
      have hth : thetaOf y = w.arg := by rw [hw]; rfl
      have hth' : thetaOf (rotZ5 φ y) = w'.arg := by rw [hw']; rfl
      have hww : w' = Complex.exp ((φ : ℂ) * Complex.I) * w := by
        obtain ⟨a0, a1, -⟩ := hc φ y
        apply Complex.ext
        · rw [Complex.mul_re, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im, hw, hw', a0]
        · rw [Complex.mul_im, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im, hw, hw', a1]
          simp only
          ring
      have hnorm : ‖w‖ = rad y := by
        rw [Complex.norm_eq_sqrt_sq_add_sq, hw]
        rfl
      have hw0 : ((‖w‖ : ℝ) : ℂ) ≠ 0 := by
        rw [hnorm]
        exact_mod_cast hy.ne'
      have hnorm' : ‖w'‖ = ‖w‖ := by
        rw [hww, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
      have key : Complex.exp ((w'.arg : ℂ) * Complex.I) =
          Complex.exp ((φ : ℂ) * Complex.I) * Complex.exp ((w.arg : ℂ) * Complex.I) := by
        apply mul_left_cancel₀ hw0
        have h1 := Complex.norm_mul_exp_arg_mul_I w'
        have h2 := Complex.norm_mul_exp_arg_mul_I w
        rw [hnorm'] at h1
        calc ((‖w‖ : ℝ) : ℂ) * Complex.exp ((w'.arg : ℂ) * Complex.I) = w' := h1
          _ = Complex.exp ((φ : ℂ) * Complex.I) * w := hww
          _ = Complex.exp ((φ : ℂ) * Complex.I) * (((‖w‖ : ℝ) : ℂ) * Complex.exp ((w.arg : ℂ) * Complex.I)) := by
              rw [h2]
          _ = _ := by ring
      have hpow : ∀ α : ℝ, Complex.exp (Complex.I * (n : ℂ) * (α : ℂ)) =
          Complex.exp ((α : ℂ) * Complex.I) ^ n := by
        intro α
        rw [← Complex.exp_int_mul]
        congr 1
        ring
      rw [hpow, hpow, hpow, hth, hth', key, mul_zpow]
    have hmode : ∀ (h e t : ℝ) (Y0 : ℝ × ℝ) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (φ : ℝ) (y : ℝ³),
        0 < rad y → modeF5 h e t Y0 n c (rotZ5 φ y) =
          rotZ5 φ (Real.cos (n * φ) • modeF5 h e t Y0 n c y +
            Real.sin (n * φ) • modeF5 h e t Y0 n (fun η i => Complex.I * c η i) y) := by
      intro h e t Y0 n c φ y hy
      have hP : ptOf (rotZ5 φ y) t (Yph h (rad (rotZ5 φ y)) t + Y0) =
          ptOf y t (Yph h (rad y) t + Y0) := by
        simp only [ptOf, hrad, (hc φ y).2.2]
      have hco : ∀ κ E : ℂ, (κ * (Complex.exp (Complex.I * (n : ℂ) * (φ : ℂ)) * E)).re =
          Real.cos (n * φ) * (κ * E).re + Real.sin (n * φ) * (Complex.I * κ * E).re := by
        intro κ E
        have hx : Complex.exp (Complex.I * (n : ℂ) * (φ : ℂ)) =
            Complex.exp (((n * φ : ℝ) : ℂ) * Complex.I) := by
          congr 1
          push_cast
          ring
