theorem ax_gain_props : ∀ (Λ C M r : ℝ) (Ξ ζc : ℂ → ℂ), 0 ≤ Λ → Real.exp (Λ * M) ≤ C → (∀ w ∈ axRect r, ‖Ξ w‖ ≤ M ∧ HasDerivAt Ξ (ζc w) w) → DifferentiableOn ℂ (axGain Λ C Ξ) (axRect r) ∧ (∀ w ∈ axRect r, ‖axGain Λ C Ξ w‖ ≤ 1 ∧ HasDerivAt (axGain Λ C Ξ) (axGain Λ C Ξ w * ((Λ : ℂ) * ζc w)) w) ∧ (∀ η : ℝ, (Ξ (η : ℂ)).im = 0 → axGain Λ C Ξ (η : ℂ) = ((Real.exp (Λ * (Ξ (η : ℂ)).re) / C : ℝ) : ℂ) ∧ 0 < Real.exp (Λ * (Ξ (η : ℂ)).re) / C) :=
by
  intro Λ C M r Ξ ζc hΛ hC hΞ
  have hCpos : 0 < C := lt_of_lt_of_le (Real.exp_pos _) hC
  have hgdef : axGain Λ C Ξ = fun x => Complex.exp ((Λ : ℂ) * Ξ x) / (C : ℂ) := by
    funext x; unfold axGain; rfl
  have hder : ∀ w ∈ axRect r,
      HasDerivAt (axGain Λ C Ξ) (axGain Λ C Ξ w * ((Λ : ℂ) * ζc w)) w := by
    intro w hw
    have h1 := (((hΞ w hw).2.const_mul (Λ : ℂ)).cexp).div_const (C : ℂ)
    rw [hgdef]
    convert h1 using 1
    ring
  have hnorm : ∀ w ∈ axRect r, ‖axGain Λ C Ξ w‖ ≤ 1 := by
    intro w hw
    rw [hgdef]
    simp only
    rw [norm_div, Complex.norm_exp, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hCpos,
      Complex.re_ofReal_mul, div_le_one hCpos]
    have h1 : (Ξ w).re ≤ M := le_trans (Complex.re_le_norm _) (hΞ w hw).1
    have h2 : Λ * (Ξ w).re ≤ Λ * M := mul_le_mul_of_nonneg_left h1 hΛ
    exact le_trans (Real.exp_le_exp.mpr h2) hC
  refine ⟨fun w hw => (hder w hw).differentiableAt.differentiableWithinAt,
    fun w hw => ⟨hnorm w hw, hder w hw⟩, fun η hη => ⟨?_, div_pos (Real.exp_pos _) hCpos⟩⟩
  have hreal : Ξ (η : ℂ) = (((Ξ (η : ℂ)).re : ℝ) : ℂ) := by
    apply Complex.ext
    · simp
    · simp [hη]
  rw [hgdef]
  simp only
  rw [hreal]
  simp only [Complex.ofReal_re]
  push_cast
  rfl

theorem ax_holo_series : ∀ (r B Y η : ℝ) (c : ℕ → ℂ → ℂ), 0 < r → (∀ n : ℕ, DifferentiableOn ℂ (c n) (axRect r)) → (∀ n : ℕ, ∀ w ∈ axRect (r / 2), ‖c n w‖ ≤ B * (1 / 10) ^ n) → |Y| < 5 → -1 - r / 8 < η → η < 1 + r / 8 → (∀ w ∈ axRect (r / 2), Summable (fun n : ℕ => c n w * (Y : ℂ) ^ n)) ∧ ∃ D : ℂ, HasDerivAt (fun w : ℂ => ∑' n : ℕ, c n w * (Y : ℂ) ^ n) D (η : ℂ) ∧ ‖D‖ ≤ 8 * B / r :=
by
  intro r B Y η c hr hcd hcb hY hη1 hη2
  have hrectOpen : IsOpen (axRect r) := by
    unfold axRect
    exact (isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).inter
      ((isOpen_lt continuous_const Complex.continuous_re).inter
        (isOpen_lt Complex.continuous_re continuous_const))
  have hsub : axRect (r / 2) ⊆ axRect r := by
    intro w hw
    obtain ⟨h1, h2, h3⟩ := hw
    exact ⟨by linarith, by linarith, by linarith⟩
  have hgeom : ∀ z : ℂ, ‖z - (η : ℂ)‖ ≤ 3 * r / 8 → z ∈ axRect (r / 2) := by
    intro z hz
    have h1 := Complex.abs_im_le_norm (z - (η : ℂ))
    have h2 := Complex.abs_re_le_norm (z - (η : ℂ))
    rw [Complex.sub_im, Complex.ofReal_im, sub_zero] at h1
    rw [Complex.sub_re, Complex.ofReal_re] at h2
    obtain ⟨h2a, h2b⟩ := abs_le.mp (le_trans h2 hz)
    exact ⟨by linarith, by linarith, by linarith⟩
  have hηR : (η : ℂ) ∈ axRect (r / 2) :=
    hgeom _ (by rw [sub_self, norm_zero]; linarith)
  have hB : 0 ≤ B := by
    have h := hcb 0 _ hηR
    rw [pow_zero, mul_one] at h
    exact le_trans (norm_nonneg _) h
  have hgeo : ∀ n : ℕ, (1 / 10 : ℝ) ^ n * ‖(Y : ℂ) ^ n‖ ≤ (1 / 2) ^ n := by
    intro n
    rw [norm_pow, Complex.norm_real, Real.norm_eq_abs, ← mul_pow]
    apply pow_le_pow_left₀ (by positivity)
    have := abs_nonneg Y
    linarith
  have hdom : ∀ (n : ℕ) (x : ℂ) (K : ℝ), 0 ≤ K → ‖x‖ ≤ K * (1 / 10) ^ n →
      ‖x * (Y : ℂ) ^ n‖ ≤ K * (1 / 2) ^ n := by
    intro n x K hK hx
    rw [norm_mul]
    calc ‖x‖ * ‖(Y : ℂ) ^ n‖ ≤ K * (1 / 10) ^ n * ‖(Y : ℂ) ^ n‖ :=
          mul_le_mul_of_nonneg_right hx (norm_nonneg _)
      _ = K * ((1 / 10) ^ n * ‖(Y : ℂ) ^ n‖) := by ring
      _ ≤ K * (1 / 2) ^ n := mul_le_mul_of_nonneg_left (hgeo n) hK
  have hcauchy : ∀ (n : ℕ) (w : ℂ) (R : ℝ), 0 < R → Metric.closedBall w R ⊆ axRect (r / 2) →
      ‖deriv (c n) w‖ ≤ B * (1 / 10) ^ n / R := by
    intro n w R hR hball
    apply Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hR
    · apply DifferentiableOn.diffContOnCl
      rw [closure_ball w hR.ne']
      exact (hcd n).mono (hball.trans hsub)
    · intro z hz
      exact hcb n z (hball (Metric.sphere_subset_closedBall hz))
  have hsumm : ∀ w ∈ axRect (r / 2), Summable (fun n : ℕ => c n w * (Y : ℂ) ^ n) := by
    intro w hw
    exact Summable.of_norm_bounded
      ((summable_geometric_of_lt_one (by norm_num) (by norm_num)).mul_left B)
      (fun n => hdom n _ B hB (hcb n w hw))
  have hr8 : 0 < r / 8 := by linarith
  have hball_t : ∀ y ∈ Metric.ball (η : ℂ) (r / 8),
      Metric.closedBall y (r / 8) ⊆ axRect (r / 2) := by
    intro y hy z hz
    apply hgeom
    rw [Metric.mem_ball, dist_eq_norm] at hy
    rw [Metric.mem_closedBall, dist_eq_norm] at hz
    have := norm_add_le (z - y) (y - (η : ℂ))
    rw [sub_add_sub_cancel] at this
    linarith
  have ht_sub : ∀ y ∈ Metric.ball (η : ℂ) (r / 8), y ∈ axRect r := by
    intro y hy
    exact hsub (hball_t y hy (Metric.mem_closedBall_self hr8.le))
  have hder : HasDerivAt (fun w : ℂ => ∑' n : ℕ, c n w * (Y : ℂ) ^ n)
      (∑' n : ℕ, deriv (c n) (η : ℂ) * (Y : ℂ) ^ n) (η : ℂ) := by
    refine hasDerivAt_tsum_of_isPreconnected (u := fun n => 8 * B / r * (1 / 2 : ℝ) ^ n)
      (g := fun n w => c n w * (Y : ℂ) ^ n) (g' := fun n w => deriv (c n) w * (Y : ℂ) ^ n)
      ((summable_geometric_of_lt_one (by norm_num) (by norm_num)).mul_left _)
      Metric.isOpen_ball (convex_ball (η : ℂ) (r / 8)).isPreconnected ?_ ?_
      (Metric.mem_ball_self hr8) (hsumm _ hηR) (Metric.mem_ball_self hr8)
    · intro n y hy
      have hd : DifferentiableAt ℂ (c n) y :=
        (hcd n).differentiableAt (hrectOpen.mem_nhds (ht_sub y hy))
      exact hd.hasDerivAt.mul_const _
    · intro n y hy
      apply hdom n _ (8 * B / r) (div_nonneg (by linarith) hr.le)
      calc ‖deriv (c n) y‖ ≤ B * (1 / 10) ^ n / (r / 8) := hcauchy n y (r / 8) hr8 (hball_t y hy)
        _ = 8 * B / r * (1 / 10) ^ n := by rw [div_div_eq_mul_div]; ring
  refine ⟨hsumm, _, hder, ?_⟩
  have hη4 : Metric.closedBall (η : ℂ) (r / 4) ⊆ axRect (r / 2) := by
    intro z hz
    apply hgeom
    rw [Metric.mem_closedBall, dist_eq_norm] at hz
    linarith
  have hbd : ∀ n : ℕ, ‖deriv (c n) (η : ℂ) * (Y : ℂ) ^ n‖ ≤ 4 * B / r * (1 / 2) ^ n := by
    intro n
    apply hdom n _ (4 * B / r) (div_nonneg (by linarith) hr.le)
    calc ‖deriv (c n) (η : ℂ)‖ ≤ B * (1 / 10) ^ n / (r / 4) :=
          hcauchy n _ (r / 4) (by linarith) hη4
      _ = 4 * B / r * (1 / 10) ^ n := by rw [div_div_eq_mul_div]; ring
  have hs := (hasSum_geometric_of_lt_one (r := (1 / 2 : ℝ)) (by norm_num) (by norm_num)).mul_left
    (4 * B / r)
  have hfin := tsum_of_norm_bounded hs hbd
  calc _ ≤ 4 * B / r * (1 - 1 / 2)⁻¹ := hfin
    _ = 8 * B / r := by ring

theorem ax_ps_sq_primitive : ∀ (a : ℕ → ℝ) (B Λ p0 : ℝ), 0 < Λ → (∀ n : ℕ, |a n| ≤ B * (1 / 10) ^ n) → (∀ n : ℕ, |(if n = 0 then p0 else (∑ i ∈ Finset.range n, a i * a (n - 1 - i)) / ((n : ℝ) * Λ))| ≤ (|p0| + 10 * B ^ 2 / Λ) * (1 / 10) ^ n) ∧ ∀ Y : ℝ, |Λ * Y| < 5 → p0 + ∫ x in (0:ℝ)..Y, (∑' n : ℕ, a n * (Λ * x) ^ n) ^ 2 = ∑' n : ℕ, (if n = 0 then p0 else (∑ i ∈ Finset.range n, a i * a (n - 1 - i)) / ((n : ℝ) * Λ)) * (Λ * Y) ^ n :=
by
  intro a B Λ p0 hΛ ha

  have hconv : ∀ m : ℕ, |∑ k ∈ Finset.range (m + 1), a k * a (m - k)| ≤
      ((m : ℝ) + 1) * B ^ 2 * (1 / 10) ^ m := by
    intro m
    have hterm : ∀ k ∈ Finset.range (m + 1), |a k * a (m - k)| ≤ B ^ 2 * (1 / 10) ^ m := by
      intro k hk
      have hkm : k ≤ m := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
      rw [abs_mul]
      have h1 := ha k
      have h2 := ha (m - k)
      have h0 : 0 ≤ B * (1 / 10) ^ k := le_trans (abs_nonneg _) h1
      calc |a k| * |a (m - k)| ≤ (B * (1 / 10) ^ k) * (B * (1 / 10) ^ (m - k)) :=
            mul_le_mul h1 h2 (abs_nonneg _) h0
        _ = B ^ 2 * ((1 / 10) ^ k * (1 / 10) ^ (m - k)) := by ring
        _ = B ^ 2 * (1 / 10) ^ m := by rw [← pow_add, Nat.add_sub_cancel' hkm]
    calc |∑ k ∈ Finset.range (m + 1), a k * a (m - k)|
        ≤ ∑ k ∈ Finset.range (m + 1), |a k * a (m - k)| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ k ∈ Finset.range (m + 1), B ^ 2 * (1 / 10) ^ m := Finset.sum_le_sum hterm
      _ = ((m : ℝ) + 1) * B ^ 2 * (1 / 10) ^ m := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]; push_cast; ring

  have hP : ∀ m : ℕ, (if m + 1 = 0 then p0 else
      (∑ i ∈ Finset.range (m + 1), a i * a (m + 1 - 1 - i)) / (((m + 1 : ℕ) : ℝ) * Λ)) =
      (∑ k ∈ Finset.range (m + 1), a k * a (m - k)) / (((m : ℝ) + 1) * Λ) := by
    intro m
    rw [if_neg (Nat.succ_ne_zero m)]
    simp only [Nat.add_sub_cancel]
    push_cast
    rfl
  have hB2 : 0 ≤ 10 * B ^ 2 / Λ := by positivity
  refine ⟨?_, ?_⟩
  ·
    intro n
    rcases n with _ | m
    · simp only [if_true, pow_zero, mul_one]
      linarith [abs_nonneg p0]
    · rw [hP m]
      have hpos : 0 < ((m : ℝ) + 1) * Λ := by positivity
      rw [abs_div, abs_of_pos hpos, div_le_iff₀ hpos]
      have e1 : (10 * B ^ 2 / Λ) * (1 / 10) ^ (m + 1) * (((m : ℝ) + 1) * Λ) =
          ((m : ℝ) + 1) * B ^ 2 * (1 / 10) ^ m := by
        rw [pow_succ]; field_simp; ring
      have e2 : (|p0| + 10 * B ^ 2 / Λ) * (1 / 10) ^ (m + 1) * (((m : ℝ) + 1) * Λ) =
          |p0| * (1 / 10) ^ (m + 1) * (((m : ℝ) + 1) * Λ) +
            (10 * B ^ 2 / Λ) * (1 / 10) ^ (m + 1) * (((m : ℝ) + 1) * Λ) := by ring
      have h3 : 0 ≤ |p0| * (1 / 10) ^ (m + 1) * (((m : ℝ) + 1) * Λ) := by positivity
      rw [e2, e1]
      linarith [hconv m]
  ·
    intro Y hY
    obtain ⟨c, hc⟩ : ∃ c : ℕ → ℝ, c = fun m => ∑ k ∈ Finset.range (m + 1), a k * a (m - k) :=
      ⟨_, rfl⟩
    have hx5 : ∀ x ∈ Set.uIcc (0:ℝ) Y, |Λ * x| < 5 := by
      intro x hx
      have hxY : |x| ≤ |Y| := by
        rcases Set.mem_uIcc.mp hx with ⟨h1, h2⟩ | ⟨h1, h2⟩
        · rw [abs_of_nonneg h1, abs_of_nonneg (h1.trans h2)]; exact h2
        · rw [abs_of_nonpos h2, abs_of_nonpos (h1.trans h2)]; linarith
      rw [abs_mul, abs_of_pos hΛ] at hY ⊢
      calc Λ * |x| ≤ Λ * |Y| := mul_le_mul_of_nonneg_left hxY hΛ.le
        _ < 5 := hY

    have hcauchy : ∀ z : ℝ, |z| < 5 →
        HasSum (fun m => c m * z ^ m) ((∑' n : ℕ, a n * z ^ n) ^ 2) := by
      intro z hz
      obtain ⟨f, hf⟩ : ∃ f : ℕ → ℝ, f = fun n => a n * z ^ n := ⟨_, rfl⟩
      have hfb : ∀ n, ‖f n‖ ≤ B * (1 / 2) ^ n := by
        intro n
        rw [Real.norm_eq_abs, hf, abs_mul, abs_pow]
        have h0 : 0 ≤ B * (1 / 10) ^ n := le_trans (abs_nonneg _) (ha n)
        calc |a n| * |z| ^ n ≤ (B * (1 / 10) ^ n) * 5 ^ n :=
              mul_le_mul (ha n) (pow_le_pow_left₀ (abs_nonneg z) hz.le n) (by positivity) h0
          _ = B * (1 / 2) ^ n := by rw [mul_assoc, ← mul_pow]; norm_num
      have hfs : Summable (fun n => ‖f n‖) :=
        Summable.of_nonneg_of_le (fun n => norm_nonneg _) hfb
          ((summable_geometric_of_lt_one (by norm_num) (by norm_num)).mul_left B)
      have h1 := tsum_mul_tsum_eq_tsum_sum_range_of_summable_norm hfs hfs
      have h2 := (summable_norm_sum_mul_range_of_summable_norm hfs hfs).of_norm
      have e : (fun m => ∑ k ∈ Finset.range (m + 1), f k * f (m - k)) = fun m => c m * z ^ m := by
        funext m
        rw [hc, hf, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun k hk => ?_)
        have hkm : k ≤ m := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
        calc a k * z ^ k * (a (m - k) * z ^ (m - k))
            = a k * a (m - k) * (z ^ k * z ^ (m - k)) := by ring
          _ = a k * a (m - k) * z ^ m := by rw [← pow_add, Nat.add_sub_cancel' hkm]
      have h3 := h2.hasSum
      rw [← h1, e] at h3
      have hfs' : (∑' n : ℕ, a n * z ^ n) = ∑' n, f n := by rw [hf]
      rw [hfs', sq]
      exact h3

    have hbound_summ : Summable (fun m : ℕ => ((m : ℝ) + 1) * B ^ 2 * (1 / 2) ^ m) := by
      have h1 : Summable (fun m : ℕ => ((m : ℝ) ^ 1) * (1 / 2 : ℝ) ^ m) :=
        summable_pow_mul_geometric_of_norm_lt_one 1 (by norm_num [Real.norm_eq_abs])
      have h2 : Summable (fun m : ℕ => (1 / 2 : ℝ) ^ m) :=
        summable_geometric_of_lt_one (by norm_num) (by norm_num)
      refine ((h1.add h2).mul_left (B ^ 2)).congr (fun m => ?_)
      ring
    have hb : ∀ m : ℕ, ∀ x ∈ Set.uIcc (0:ℝ) Y,
        ‖c m * (Λ * x) ^ m‖ ≤ ((m : ℝ) + 1) * B ^ 2 * (1 / 2) ^ m := by
      intro m x hx
      rw [Real.norm_eq_abs, abs_mul, abs_pow]
      have hcm : |c m| ≤ ((m : ℝ) + 1) * B ^ 2 * (1 / 10) ^ m := by rw [hc]; exact hconv m
      have h0 : 0 ≤ ((m : ℝ) + 1) * B ^ 2 * (1 / 10) ^ m := le_trans (abs_nonneg _) hcm
      calc |c m| * |Λ * x| ^ m ≤ (((m : ℝ) + 1) * B ^ 2 * (1 / 10) ^ m) * 5 ^ m :=
            mul_le_mul hcm (pow_le_pow_left₀ (abs_nonneg _) (hx5 x hx).le m) (by positivity) h0
        _ = ((m : ℝ) + 1) * B ^ 2 * (1 / 2) ^ m := by rw [mul_assoc, ← mul_pow]; norm_num

    have hint : HasSum (fun m : ℕ => ∫ x in (0:ℝ)..Y, c m * (Λ * x) ^ m)
        (∫ x in (0:ℝ)..Y, (∑' n : ℕ, a n * (Λ * x) ^ n) ^ 2) :=
      intervalIntegral.hasSum_integral_of_dominated_convergence
        (fun m _ => ((m : ℝ) + 1) * B ^ 2 * (1 / 2) ^ m)
        (fun m => (by fun_prop : Continuous fun x : ℝ => c m * (Λ * x) ^ m).aestronglyMeasurable)
        (fun m => Filter.Eventually.of_forall (fun x hx => hb m x (Set.uIoc_subset_uIcc hx)))
        (Filter.Eventually.of_forall (fun x _ => hbound_summ))
        intervalIntegrable_const
        (Filter.Eventually.of_forall (fun x hx => hcauchy _ (hx5 x (Set.uIoc_subset_uIcc hx))))
    have hterm : ∀ m : ℕ, ∫ x in (0:ℝ)..Y, c m * (Λ * x) ^ m =
        c m * (Λ * Y) ^ (m + 1) / (((m : ℝ) + 1) * Λ) := by
      intro m
      have e : (fun x : ℝ => c m * (Λ * x) ^ m) = fun x => (c m * Λ ^ m) * x ^ m := by
        funext x; rw [mul_pow]; ring
      rw [e, intervalIntegral.integral_const_mul, integral_pow, zero_pow (Nat.succ_ne_zero m),
        sub_zero]
      field_simp
      ring
    have hS2 : HasSum (fun m : ℕ => (if m + 1 = 0 then p0 else
        (∑ i ∈ Finset.range (m + 1), a i * a (m + 1 - 1 - i)) / (((m + 1 : ℕ) : ℝ) * Λ)) *
          (Λ * Y) ^ (m + 1)) (∫ x in (0:ℝ)..Y, (∑' n : ℕ, a n * (Λ * x) ^ n) ^ 2) := by
      have hfe : (fun m : ℕ => ∫ x in (0:ℝ)..Y, c m * (Λ * x) ^ m) =
          (fun m : ℕ => (if m + 1 = 0 then p0 else
            (∑ i ∈ Finset.range (m + 1), a i * a (m + 1 - 1 - i)) / (((m + 1 : ℕ) : ℝ) * Λ)) *
              (Λ * Y) ^ (m + 1)) := by
        funext m
        rw [hterm m, hP m, hc]
        ring
      rw [← hfe]
      exact hint
    have hS3 := HasSum.zero_add (f := fun n : ℕ => (if n = 0 then p0 else
        (∑ i ∈ Finset.range n, a i * a (n - 1 - i)) / ((n : ℝ) * Λ)) * (Λ * Y) ^ n) hS2
    rw [hS3.tsum_eq]
    simp

theorem ax_ode_nonlocal_calc (h j0 σ ρ : ℝ) (Pc : ℂ → ℂ) (Pax : ℝ → ℝ) (r M Λ0 A : ℝ)
    (χc ζc ℓc zc Ξ : ℂ → ℂ) (hCD : AxCoefData h j0 σ ρ Pc Pax r M χc ζc ℓc zc Ξ)
    (hMaj : AxMajor h j0 r Λ0 A χc ζc ℓc zc) (Λ C X η : ℝ) (hΛ : Λ0 ≤ Λ)
    (hC : Real.exp (Λ * M) ≤ C) (hX0 : 0 < X) (hX1 : X < 9 / (2 * Λ))
    (hη1 : -1 - r / 8 < η) (hη2 : η < 1 + r / 8) :
    (∀ n : ℕ, ‖axQn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)‖ ≤ 10 * A ^ 2 * (1 / 10) ^ n ∧
      ‖deriv (axQn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ)‖ ≤ 80 / r * A ^ 2 * (1 / 10) ^ n) ∧
    ((leadW h (axUnDef h j0 Λ C χc ζc ℓc zc Ξ) X η : ℝ) : ℂ) =
      1 - 2 * (1 / 2 - (h : ℂ)) * (η : ℂ) * (4 * (η : ℂ) + (j0 : ℂ) +
          axSer (fun n => axVn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ) / ((n : ℂ) + 1)) ((Λ * X : ℝ) : ℂ) /
            (Λ : ℂ))
        - (1 - (η : ℂ) ^ 2) * (4 +
          axSer (fun n => deriv (axVn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ) / ((n : ℂ) + 1))
              ((Λ * X : ℝ) : ℂ) / (Λ : ℂ)) ∧
    ((profRadInt (fun x e => axFnDef h j0 Λ C χc ζc ℓc zc Ξ x e ^ 2) X η : ℝ) : ℂ) =
      axSer (fun n => axQn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)) ((Λ * X : ℝ) : ℂ) / (Λ : ℂ) ∧
    ∃ v : ℝ, HasDerivAt (fun e => profRadInt (fun x e => axFnDef h j0 Λ C χc ζc ℓc zc Ξ x e ^ 2) X e) v η ∧
      (v : ℂ) = axSer (fun n => deriv (axQn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ)) ((Λ * X : ℝ) : ℂ) / (Λ : ℂ) :=
by

  have s1 : ∀ (f : ℝ → ℝ) (c : ℂ → ℂ) (c' : ℂ) (η : ℝ),
      (∀ᶠ e in nhds η, ((f e : ℝ) : ℂ) = c (e : ℂ)) → HasDerivAt c c' (η : ℂ) →
      HasDerivAt f c'.re η ∧ ((c'.re : ℝ) : ℂ) = c' := by
    intro f c c' η hfc hc
    have h1 : HasDerivAt (fun e : ℝ => c (e : ℂ)) c' η := hc.comp_ofReal
    have h2 : HasDerivAt (fun e : ℝ => (c (e : ℂ)).re) c'.re η := hc.real_of_complex
    have h3 : HasDerivAt f c'.re η := by
      refine h2.congr_of_eventuallyEq ?_
      filter_upwards [hfc] with e he
      rw [← he, Complex.ofReal_re]
    refine ⟨h3, ?_⟩
    have h4 : HasDerivAt (fun e : ℝ => ((f e : ℝ) : ℂ)) ((c'.re : ℝ) : ℂ) η := h3.ofReal_comp
    have h5 : HasDerivAt (fun e : ℝ => ((f e : ℝ) : ℂ)) c' η := h1.congr_of_eventuallyEq hfc
    exact h4.unique h5
  have hRo : ∀ s : ℝ, IsOpen (axRect s) := fun s =>
    (isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).inter
      ((isOpen_lt continuous_const Complex.continuous_re).inter
        (isOpen_lt Complex.continuous_re continuous_const))
  have hRsub : ∀ s : ℝ, 0 < s → axRect (s / 2) ⊆ axRect s := by
    intro s hs w hw
    obtain ⟨a1, a2, a3⟩ := hw
    exact ⟨by linarith, by linarith, by linarith⟩

  have s2 : ∀ (r B Y η : ℝ) (c : ℕ → ℂ → ℂ), 0 < r → (∀ n, DifferentiableOn ℂ (c n) (axRect r)) →
      (∀ n, ∀ w ∈ axRect (r / 2), ‖c n w‖ ≤ B * (1 / 10) ^ n) → |Y| < 5 →
      -1 - r / 8 < η → η < 1 + r / 8 →
      HasDerivAt (fun w : ℂ => ∑' n : ℕ, c n w * (Y : ℂ) ^ n)
        (∑' n : ℕ, deriv (c n) (η : ℂ) * (Y : ℂ) ^ n) (η : ℂ) := by
    intro r B Y η c hr hd hb hY hη1 hη2
    have hUo : IsOpen (axRect (r / 2)) := hRo _
    have hU : axRect (r / 2) ⊆ axRect r := hRsub r hr
    have hηU : (η : ℂ) ∈ axRect (r / 2) := by
      refine ⟨?_, ?_, ?_⟩ <;> simp <;> linarith
    have hηR : (η : ℂ) ∈ axRect r := hU hηU
    have hu : Summable (fun n : ℕ => B * (|Y| / 10) ^ n) :=
      (summable_geometric_of_lt_one (by positivity) (by linarith [abs_nonneg Y])).mul_left B
    have hFb : ∀ n, ∀ w ∈ axRect (r / 2), ‖c n w * (Y : ℂ) ^ n‖ ≤ B * (|Y| / 10) ^ n := by
      intro n w hw
      rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs]
      have := hb n w hw
      have h0 : (0:ℝ) ≤ |Y| ^ n := by positivity
      calc ‖c n w‖ * |Y| ^ n ≤ B * (1 / 10) ^ n * |Y| ^ n := mul_le_mul_of_nonneg_right this h0
        _ = B * (|Y| / 10) ^ n := by rw [div_pow, div_pow, one_pow]; ring
    have hFd : ∀ n, DifferentiableOn ℂ (fun w => c n w * (Y : ℂ) ^ n) (axRect (r / 2)) :=
      fun n => ((hd n).mono hU).mul_const _
    have hdiff := Complex.differentiableOn_tsum_of_summable_norm hu hFd hUo hFb
    have hsum := Complex.hasSum_deriv_of_summable_norm hu hFd hUo hFb hηU
    have hda : DifferentiableAt ℂ (fun w : ℂ => ∑' n : ℕ, c n w * (Y : ℂ) ^ n) (η : ℂ) :=
      hdiff.differentiableAt (hUo.mem_nhds hηU)
    have heq : deriv (fun w : ℂ => ∑' n : ℕ, c n w * (Y : ℂ) ^ n) (η : ℂ) =
        ∑' n : ℕ, deriv (c n) (η : ℂ) * (Y : ℂ) ^ n := by
      rw [← hsum.tsum_eq]
      refine tsum_congr fun n => ?_
      exact deriv_mul_const ((hd n).differentiableAt ((hRo r).mem_nhds hηR)) _
    rw [← heq]
    exact hda.hasDerivAt

  have s3 : ∀ (Λ X A : ℝ) (K : ℂ) (V : ℕ → ℂ) (U : ℝ → ℝ), 0 < Λ → 0 < X → Λ * X < 9 / 2 →
      (∀ n, ‖V n‖ ≤ A * (1 / 10) ^ n) →
      (∀ x : ℝ, 0 ≤ x → x ≤ X → ((U x : ℝ) : ℂ) = K + (∑' n : ℕ, V n * ((Λ * x : ℝ) : ℂ) ^ n) / (Λ : ℂ)) →
      ((∫ s in (0:ℝ)..1, U (s * X) : ℝ) : ℂ) =
        K + (∑' n : ℕ, V n / ((n : ℂ) + 1) * ((Λ * X : ℝ) : ℂ) ^ n) / (Λ : ℂ) := by
    intro Λ X A K V U hΛ hX hΛX hV hU
    set y : ℂ := ((Λ * X : ℝ) : ℂ) with hy
    have hA : 0 ≤ A := le_trans (norm_nonneg _) (by simpa using hV 0)
    have hΛX0 : 0 < Λ * X := mul_pos hΛ hX
    have hny : ‖y‖ = Λ * X := by rw [hy, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hΛX0]
    set b : ℕ → ℂ := fun n => V n * y ^ n with hb
    have hbb : ∀ n, ‖b n‖ ≤ A * (1 / 2) ^ n := by
      intro n
      simp only [hb, norm_mul, norm_pow, hny]
      calc ‖V n‖ * (Λ * X) ^ n ≤ A * (1 / 10) ^ n * (Λ * X) ^ n :=
            mul_le_mul_of_nonneg_right (hV n) (by positivity)
        _ = A * ((Λ * X) / 10) ^ n := by rw [div_pow, div_pow, one_pow]; ring
        _ ≤ A * (1 / 2) ^ n := by
            apply mul_le_mul_of_nonneg_left _ hA
            exact pow_le_pow_left₀ (by positivity) (by linarith) n
    have hsum : Summable (fun n : ℕ => A * (1 / 2 : ℝ) ^ n) :=
      (summable_geometric_of_lt_one (by norm_num) (by norm_num)).mul_left A
    set G : ℝ → ℂ := fun s => ∑' n : ℕ, b n * (s : ℂ) ^ n with hG
    have hpt : ∀ s ∈ Set.uIcc (0:ℝ) 1, ((U (s * X) : ℝ) : ℂ) = K + G s / (Λ : ℂ) := by
      intro s hs
      rw [Set.uIcc_of_le zero_le_one] at hs
      rw [hU (s * X) (mul_nonneg hs.1 hX.le) (by nlinarith [hs.2])]
      congr 2
      refine tsum_congr fun n => ?_
      simp only [hb, hy]
      push_cast
      ring
    have hFb : ∀ n (s : ℝ), s ∈ Set.Icc (0:ℝ) 1 → ‖b n * (s : ℂ) ^ n‖ ≤ A * (1 / 2) ^ n := by
      intro n s hs
      rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hs.1]
      calc ‖b n‖ * s ^ n ≤ ‖b n‖ * 1 :=
            mul_le_mul_of_nonneg_left (pow_le_one₀ hs.1 hs.2) (norm_nonneg _)
        _ ≤ A * (1 / 2) ^ n := by rw [mul_one]; exact hbb n
    have hGc : ContinuousOn G (Set.Icc 0 1) :=
      continuousOn_tsum (fun n => (continuous_const.mul (Complex.continuous_ofReal.pow n)).continuousOn)
        hsum hFb
    have hGi : IntervalIntegrable G MeasureTheory.volume 0 1 := by
      apply ContinuousOn.intervalIntegrable
      rw [Set.uIcc_of_le zero_le_one]; exact hGc
    have hint : HasSum (fun n => ∫ s in (0:ℝ)..1, b n * (s : ℂ) ^ n) (∫ s in (0:ℝ)..1, G s) := by
      refine intervalIntegral.hasSum_integral_of_dominated_convergence (fun n _ => A * (1 / 2) ^ n)
        ?_ ?_ ?_ ?_ ?_
      · intro n
        exact (continuous_const.mul (Complex.continuous_ofReal.pow n)).aestronglyMeasurable
      · intro n
        refine MeasureTheory.ae_of_all _ fun s hs => ?_
        rw [Set.uIoc_of_le zero_le_one] at hs
        exact hFb n s ⟨hs.1.le, hs.2⟩
      · exact MeasureTheory.ae_of_all _ fun s _ => hsum
      · exact intervalIntegrable_const
      · refine MeasureTheory.ae_of_all _ fun s hs => ?_
        rw [Set.uIoc_of_le zero_le_one] at hs
        exact (Summable.of_norm_bounded hsum (fun n => hFb n s ⟨hs.1.le, hs.2⟩)).hasSum
    have hterm : ∀ n : ℕ, ∫ s in (0:ℝ)..1, b n * (s : ℂ) ^ n = V n / ((n : ℂ) + 1) * y ^ n := by
      intro n
      rw [intervalIntegral.integral_const_mul]
      have e1 : ∫ s in (0:ℝ)..1, (s : ℂ) ^ n = ((∫ s in (0:ℝ)..1, s ^ n : ℝ) : ℂ) := by
        rw [← intervalIntegral.integral_ofReal]; push_cast; rfl
      rw [e1, integral_pow]
      simp only [hb]
      push_cast
      simp only [one_pow, ne_eq, Nat.add_eq_zero_iff, one_ne_zero, and_false, not_false_eq_true,
        zero_pow, sub_zero]
      field_simp
    have hI : ∫ s in (0:ℝ)..1, ((U (s * X) : ℝ) : ℂ) = ∫ s in (0:ℝ)..1, (K + G s / (Λ : ℂ)) :=
      intervalIntegral.integral_congr hpt
    rw [← intervalIntegral.integral_ofReal, hI,
      intervalIntegral.integral_add intervalIntegrable_const (hGi.div_const _),
      intervalIntegral.integral_const, intervalIntegral.integral_div, ← hint.tsum_eq]
    simp only [sub_zero, one_smul]
    congr 2
    exact tsum_congr hterm

  have s6 : ∀ (r A : ℝ) (G : ℂ → ℂ) (P : ℕ → ℂ → ℂ), 0 < r → 0 ≤ A →
      DifferentiableOn ℂ G (axRect r) → (∀ w ∈ axRect r, ‖G w‖ ≤ 1) →
      (∀ n, DifferentiableOn ℂ (P n) (axRect r)) →
      (∀ n, ∀ w ∈ axRect (r / 2), ‖P n w‖ ≤ A * (1 / 10) ^ n) →
      ∀ (n : ℕ) (q : ℂ → ℂ), (∀ w, q w = (if n = 0 then 0 else G w ^ 2 *
        ∑ i ∈ Finset.range (n - 1 + 1), P i w * P (n - 1 - i) w) / (n : ℂ)) →
      DifferentiableOn ℂ q (axRect r) ∧ (∀ w ∈ axRect (r / 2), ‖q w‖ ≤ 10 * A ^ 2 * (1 / 10) ^ n) ∧
        (∀ η : ℝ, -1 - r / 8 < η → η < 1 + r / 8 →
          ‖deriv q (η : ℂ)‖ ≤ 80 / r * A ^ 2 * (1 / 10) ^ n) := by
    intro r A G P hr hA hGd hGb hPd hPb n q hq
    have hU : axRect (r / 2) ⊆ axRect r := hRsub r hr
    have hqf : q = fun w => (if n = 0 then 0 else G w ^ 2 *
        ∑ i ∈ Finset.range (n - 1 + 1), P i w * P (n - 1 - i) w) / (n : ℂ) := funext hq
    have hDq : DifferentiableOn ℂ q (axRect r) := by
      rw [hqf]
      rcases Nat.eq_zero_or_pos n with h0 | hpos
      · subst h0; simp
      · simp only [hpos.ne', ↓reduceIte]
        refine DifferentiableOn.div_const ?_ _
        refine (hGd.pow 2).mul ?_
        exact DifferentiableOn.fun_sum (fun i _ => (hPd i).mul (hPd (n - 1 - i)))
    have hV : ∀ w ∈ axRect (r / 2), ‖q w‖ ≤ 10 * A ^ 2 * (1 / 10) ^ n := by
      intro w hw
      have hwr : w ∈ axRect r := hU hw
      rw [hq]
      rcases n with _ | k
      · simp; positivity
      · simp only [Nat.add_one_ne_zero, ↓reduceIte, Nat.add_sub_cancel]
        rw [norm_div, norm_mul, norm_pow]
        have hs : ‖∑ i ∈ Finset.range (k + 1), P i w * P (k - i) w‖ ≤
            ((k:ℝ) + 1) * (A ^ 2 * (1 / 10) ^ k) := by
          calc _ ≤ ∑ i ∈ Finset.range (k + 1), ‖P i w * P (k - i) w‖ := norm_sum_le _ _
            _ ≤ ∑ i ∈ Finset.range (k + 1), A ^ 2 * (1 / 10 : ℝ) ^ k := by
                apply Finset.sum_le_sum
                intro i hi
                have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
                rw [norm_mul]
                have hp : (1 / 10 : ℝ) ^ i * (1 / 10) ^ (k - i) = (1 / 10) ^ k := by
                  rw [← pow_add, Nat.add_sub_cancel' hik]
                calc ‖P i w‖ * ‖P (k - i) w‖ ≤ (A * (1 / 10) ^ i) * (A * (1 / 10) ^ (k - i)) :=
                      mul_le_mul (hPb i w hw) (hPb _ w hw) (norm_nonneg _) (by positivity)
                  _ = A ^ 2 * ((1 / 10) ^ i * (1 / 10) ^ (k - i)) := by ring
                  _ = A ^ 2 * (1 / 10) ^ k := by rw [hp]
            _ = ((k:ℝ) + 1) * (A ^ 2 * (1 / 10) ^ k) := by simp
        have hG2 : ‖G w‖ ^ 2 ≤ 1 := by
          have := hGb w hwr; nlinarith [norm_nonneg (G w)]
        rw [Complex.norm_natCast, div_le_iff₀ (by positivity)]
        push_cast
        have e : 10 * A ^ 2 * (1 / 10) ^ (k + 1) * ((k:ℝ) + 1) =
            1 * (((k:ℝ) + 1) * (A ^ 2 * (1 / 10) ^ k)) := by ring
        rw [e]
        exact mul_le_mul hG2 hs (norm_nonneg _) zero_le_one
    refine ⟨hDq, hV, ?_⟩
    intro η h1 h2
    obtain ⟨-, D, hD, hDb⟩ := ax_holo_series r (10 * A ^ 2 * (1 / 10) ^ n) 0 η
      (fun m w => if m = 0 then q w else 0) hr
      (fun m => by
        by_cases hm : m = 0
        · subst hm; simpa using hDq
        · simp only [hm, ↓reduceIte]; exact differentiableOn_const _)
      (fun m w hw => by
        by_cases hm : m = 0
        · subst hm; simp only [↓reduceIte, pow_zero, mul_one]; exact hV w hw
        · simp only [hm, ↓reduceIte, norm_zero]; positivity)
      (by simp) h1 h2
    have hfun : (fun w : ℂ => ∑' m : ℕ, (if m = 0 then q w else 0) * ((0:ℝ) : ℂ) ^ m) = q := by
      funext w
      rw [tsum_eq_single 0 (fun m hm => by simp [hm])]
      simp
    rw [hfun] at hD
    rw [hD.deriv]
    calc ‖D‖ ≤ 8 * (10 * A ^ 2 * (1 / 10) ^ n) / r := hDb
      _ = 80 / r * A ^ 2 * (1 / 10) ^ n := by ring

  have s7 : ∀ (Λ X A : ℝ) (G : ℂ) (P : ℕ → ℂ) (F : ℝ → ℝ), 0 < Λ → 0 < X → Λ * X < 9 / 2 →
      (∀ n, ‖G * P n‖ ≤ A * (1 / 10) ^ n) → (∀ n, (G * P n).im = 0) →
      (∀ x : ℝ, 0 ≤ x → x ≤ X → F x = ∑' n : ℕ, (G * P n).re * (Λ * x) ^ n) →
      ((∫ x in (0:ℝ)..X, F x ^ 2 : ℝ) : ℂ) =
        (∑' n : ℕ, (if n = 0 then 0 else G ^ 2 * ∑ i ∈ Finset.range (n - 1 + 1), P i * P (n - 1 - i)) /
          (n : ℂ) * ((Λ * X : ℝ) : ℂ) ^ n) / (Λ : ℂ) := by
    intro Λ X A G P F hΛ hX hΛX hb hre hF
    set a : ℕ → ℝ := fun n => (G * P n).re with ha
    have hab : ∀ n, |a n| ≤ A * (1 / 10) ^ n := fun n => (Complex.abs_re_le_norm _).trans (hb n)
    have hGP : ∀ n, G * P n = ((a n : ℝ) : ℂ) :=
      fun n => Complex.ext (by simp [ha]) (by simp [hre n])
    obtain ⟨-, hprim⟩ := ax_ps_sq_primitive a A Λ 0 hΛ hab
    have hY : |Λ * X| < 5 := by rw [abs_of_pos (mul_pos hΛ hX)]; linarith
    have h1 := hprim X hY
    rw [zero_add] at h1
    have hint : ∫ x in (0:ℝ)..X, F x ^ 2 = ∫ x in (0:ℝ)..X, (∑' n : ℕ, a n * (Λ * x) ^ n) ^ 2 := by
      refine intervalIntegral.integral_congr (fun x hx => ?_)
      rw [Set.uIcc_of_le hX.le] at hx
      rw [hF x hx.1 hx.2]
    rw [hint, h1, Complex.ofReal_tsum, ← tsum_div_const]
    refine tsum_congr fun n => ?_
    rcases n with _ | k
    · simp
    · simp only [Nat.add_one_ne_zero, ↓reduceIte, Nat.add_sub_cancel]
      have e : G ^ 2 * ∑ i ∈ Finset.range (k + 1), P i * P (k - i) =
          ∑ i ∈ Finset.range (k + 1), ((a i : ℝ) : ℂ) * ((a (k - i) : ℝ) : ℂ) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [← hGP, ← hGP]; ring
      rw [e]
      push_cast
      have hk : ((k : ℂ) + 1) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero k
      have hΛ' : (Λ : ℂ) ≠ 0 := by exact_mod_cast hΛ.ne'
      field_simp

