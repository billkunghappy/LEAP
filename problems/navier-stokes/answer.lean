      refine aestronglyMeasurable_of_tendsto_ae Filter.atTop
        (f := fun (n : ℕ) t => (((ε / 4 * (1 / ((n : ℝ) + 1)) : ℝ) : ℂ))⁻¹ •
          (g t (w₀ + ((ε / 4 * (1 / ((n : ℝ) + 1)) : ℝ) : ℂ)) - g t w₀)) ?_ ?_
