      have := lt_min (sub_pos.mpr hcη) (sub_pos.mpr hηd); linarith
    have hρ1 : c < η - ρ := by linarith [min_le_left (η - c) (d - η)]
    have hρ2 : η + ρ < d := by linarith [min_le_right (η - c) (d - η)]
    have hK : Icc a b ×ˢ Icc (η - ρ) (η + ρ) ⊆ W := by
      intro p hp
