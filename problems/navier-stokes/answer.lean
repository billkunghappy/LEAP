      congr 1
      rw [hLι]
      ext <;> simp only [Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul] <;> ring
    have e := pull (fun w : (ℝ × ℝ × ℝ) × ℝ => M γ w.1 w.2) ((ξ.1, ξ.2.1, ξ.2.2.1), v') Af U
      (ξ.1, ξ.2.1, ξ.2.2.1, ξ.2.2.2 + (v' - y0) • d) Lι hUo hAU hξU hev k
    rw [e]
    refine le_trans (cmp _ Lι _ (Lnorm B.h ξ) R hTR hR1) ?_
    exact hNB
  refine ⟨?_, ?_⟩
  ·
    have hO : IsOpen (Ω ×ˢ (Set.univ : Set ℝ)) := hΩo.prod isOpen_univ
    have hcont : ContinuousOn (iteratedFDeriv ℝ k (fun w : (ℝ × ℝ × ℝ) × ℝ => M γ w.1 w.2))
        (Ω ×ˢ (Set.univ : Set ℝ)) := by
      have h1 := (hMs γ).continuousOn_iteratedFDerivWithin (m := k) (by exact_mod_cast le_top)
        hO.uniqueDiffOn
      exact h1.congr (fun w hw => (iteratedFDerivWithin_of_isOpen k hO hw).symm)
    have h2 : Continuous (fun v' : ℝ =>
        iteratedFDeriv ℝ k (fun w : (ℝ × ℝ × ℝ) × ℝ => M γ w.1 w.2) ((ξ.1, ξ.2.1, ξ.2.2.1), v')) :=
      hcont.comp_continuous (continuous_const.prodMk continuous_id) (fun v' => ⟨hs0, trivial⟩)
