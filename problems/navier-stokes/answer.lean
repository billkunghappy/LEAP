    rw [hvs, sub_mul, div_mul_cancel₀ _ hκ.ne']
  generalize hPdef : Y + (v - vco h r0 γ c Y) • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv) = P

  have hJ : Jpow (bandIdx h γ.1) P - c - k = w + ((v - vco h r0 γ c Y) * cib h γ.1) • vtv := by
    rw [← hPdef, smul_smul, s2, hwdef]
    have e : Tgc ^ (bandIdx h γ.1) * ((v - vco h r0 γ c Y) * (cib h γ.1 * Tgc ^ (-(bandIdx h γ.1)))) =
        (v - vco h r0 γ c Y) * cib h γ.1 := by
      linear_combination ((v - vco h r0 γ c Y) * cib h γ.1) * hunit
    rw [e]
    abel
  obtain ⟨l1, l2⟩ := s1 w ((v - vco h r0 γ c Y) * cib h γ.1)
  have hvk0 : 0 ≤ v * cib h γ.1 := mul_nonneg hv0 hκ.le
  have hvk1 : v * cib h γ.1 ≤ 2 * r0 := by
