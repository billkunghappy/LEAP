      ubase B η 1 * momDgP B dPsi η + mcor5 B G l0 S 2 η * momDvP B dv η +
      momDgP B dPsi η * mcor5 B G l0 S 1 η + momDgP B dPsi η * momDvP B dv η)) :=
    hlin6 _ _ _ _ _ _ _ _ 1 1 1 1 1 0 _ _ _ _ _ _ _ (hGm _ _ hdw) (hVm _ _ hdg) (hM2 _ _ _ _ hγ hdw)
      (hM2 _ _ _ _ hv hdg) (hM2 _ _ _ _ hdg hdw) (hM2 _ _ _ _ hdg hdw)
      (by linarith) (by linarith) (by linarith) (by linarith) (by linarith) (by linarith)
      (fun ξ _ => by (try dsimp only); ring)
  have hTh : InM B (qsOf l0) (α + 1 - 2 * kapS)
      (nrm B (2 * Aex B.h + 1/2) (momTanTh5 B G l0 S dPsi dv)) :=
    hlin6 _ _ _ _ _ _ _ _ 1 1 2 1 (-1) 0 _ _ _ _ _ _ _
      (hdTs _ _ hdw hYDW) (hDR _ _ _ hΦ) (hrm _ _ _ hΦ) (hDZ' _ _ _ hΨ) (hL _ _ hdw).2 (hL _ _ hdw).2
      (by linarith) (by linarith) (by linarith) (by linarith) (by linarith) (by linarith)
      (fun ξ _ => by simp only [momTanTh5]; ring)
  have hΦz : InM B (qsOf l0) (α + 1) (nrm B (2 * Aex B.h) (fun η => ubase B η 0 * momDgP B dPsi η +
      momDbP B dPsi η * ubase B η 2 + mcor5 B G l0 S 0 η * momDgP B dPsi η +
      momDbP B dPsi η * mcor5 B G l0 S 2 η + momDbP B dPsi η * momDgP B dPsi η)) :=
    hlin6 _ _ _ _ _ _ _ _ 1 1 1 1 1 0 _ _ _ _ _ _ _ (hbm _ _ hdg) (hGm _ _ hdb) (hM2 _ _ _ _ hβ hdg)
      (hM2 _ _ _ _ hγ hdb) (hM2 _ _ _ _ hdb hdg) (hM2 _ _ _ _ hdb hdg)
      (by linarith) (by linarith) (by linarith) (by linarith) (by linarith) (by linarith)
      (fun ξ _ => by (try dsimp only); ring)
  have hΨz : InM B (qsOf l0) α (nrm B (2 * Aex B.h) (fun η => 2 * ubase B η 2 * momDgP B dPsi η +
      2 * mcor5 B G l0 S 2 η * momDgP B dPsi η + momDgP B dPsi η ^ 2 +
      (pmP5 B G l0 (momUpd S dPsi dv) η - pmP5 B G l0 S η))) :=
    hlin6 _ _ _ _ _ _ _ _ 2 2 1 1 0 0 _ _ _ _ _ _ _ (hGm _ _ hdg) (hM2 _ _ _ _ hγ hdg) (hM2 _ _ _ _ hdg hdg)
      hdp hdp hdp
      (by linarith) (by linarith) (by linarith) (by linarith) (by linarith) (by linarith)
      (fun ξ _ => by (try dsimp only); ring)
  have hTz : InM B (qsOf l0) (α + 1 - 2 * kapS)
      (nrm B (2 * Aex B.h + 1/2) (momTanZ5 B G l0 S dPsi dv)) :=
    hlin6 _ _ _ _ _ _ _ _ 1 1 1 1 (-1) 0 _ _ _ _ _ _ _
      (hdTs _ _ hdg hYDG) (hDR _ _ _ hΦz) (hrm _ _ _ hΦz) (hDZ' _ _ _ hΨz) (hL _ _ hdg).1 (hL _ _ hdg).1
      (by linarith) (by linarith) (by linarith) (by linarith) (by linarith) (by linarith)
      (fun ξ _ => by simp only [momTanZ5]; ring)
  have hdE : InM B (qsOf l0) (α + 1 - 2 * kapS) (nrm B (2 * Aex B.h + 1/2)
      (fun ξ => EthP5 B G l0 (momUpd S dPsi dv) ξ - EthP5 B G l0 S ξ)) :=
    hsc _ _ _ _ 1 _ _ hTh le_rfl rfl (fun ξ hξ => by (try dsimp only); rw [(hTan ξ hξ).1]; ring)
  have hdZ5 : InM B (qsOf l0) (α + 1 - 2 * kapS) (nrm B (2 * Aex B.h + 1/2)
      (fun ξ => EzP5 B G l0 (momUpd S dPsi dv) ξ - EzP5 B G l0 S ξ)) :=
    hsc _ _ _ _ 1 _ _ hTz le_rfl rfl (fun ξ hξ => by (try dsimp only); rw [(hTan ξ hξ).2]; ring)

  have hyE := (hWm _ _ _ hdE).2.2.2.1
  have haE := (hWm _ _ _ hEth).2.2.2.2 _ _ hdE
  have hyZ := (hWm _ _ _ hdZ5).2.2.2.1
  have haZ := (hWm _ _ _ hEz).2.2.2.2 _ _ hdZ5
  have eE : (fun η => EthP5 B G l0 S η +
      (fun ξ => EthP5 B G l0 (momUpd S dPsi dv) ξ - EthP5 B G l0 S ξ) η) = EthP5 B G l0 (momUpd S dPsi dv) := by
    funext η; (try dsimp only); ring
  have eZ : (fun η => EzP5 B G l0 S η +
      (fun ξ => EzP5 B G l0 (momUpd S dPsi dv) ξ - EzP5 B G l0 S ξ) η) = EzP5 B G l0 (momUpd S dPsi dv) := by
    funext η; (try dsimp only); ring
  refine ⟨hdE, hdZ5, ?_, ?_⟩
  · refine hsc _ _ _ _ 1 _ _ hyE le_rfl rfl (fun ξ hξ => ?_)
    have h1 := haE ξ hξ
    rw [eE] at h1
    (try dsimp only)
    linarith
  · refine hsc _ _ _ _ 1 _ _ hyZ le_rfl rfl (fun ξ hξ => ?_)
    have h1 := haZ ξ hξ
    rw [eZ] at h1
    (try dsimp only)
    linarith

theorem mwh5_pm_increment_smooth : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (S : CState) (bw ca cm cd α : ℝ) (dPsi dv : Cyl → ℝ), StOrd5 B G l0 S bw ca cm cd →
    MomShape B dPsi → MomShape B dv → InM B (qsOf l0) α dPsi → InM B (qsOf l0) α dv →
    ContDiffOn ℝ ∞ (pmP5 B G l0 (momUpd S dPsi dv)) (DomC B.h (qsOf l0)) :=
by
  intro B G hok hG
  obtain ⟨lm, hlm⟩ := mom_mean_update_v5 B G hok hG
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨lm + n0, ?_⟩
  intro l0 hl0 S bw ca cm cd α dPsi dv hSt hshP hshv hP hv

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs0 : 0 < qsOf l0 := by rw [hQb]; positivity
  have hqs1 : qsOf l0 ≤ 1 := by rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have hqB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le

  obtain ⟨hDo, hqCs, hqC0, -, hCl, hSVd⟩ := domc_open_calculus B (qsOf l0) hok
  obtain ⟨-, hub, hmS, hWS, -⟩ := state_cyl_smooth_v5 B G l0 S bw ca cm cd hok hG hqB hSt
  have hWv := wcov5_shell_vanish B G l0 S bw ca cm cd hok hqB hSt
  have hMM := hlm l0 (by omega) S bw ca cm cd dPsi dv hSt hshP hshv hP.1 hv.1
  have hdPsi := hP.1
  have hdv := hv.1
  have hmemD : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 :=
    fun ξ hξ => hξ
  have hSt' := hSt
  unfold StOrd5 at hSt'
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hm1, hm2, -, hm0, -, -⟩ := hSt'
  have keyV : ∀ (f : Cyl → ℝ) (α' : ℝ), InM B (qsOf l0) α' (nrm B (Aex B.h) f) →
      ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → f ξ = 0 := by
    intro f α' hf ξ hξ hX
    have h0 : qC B.h ξ ^ Aex B.h * f ξ = 0 := hf.2.2.1 ξ hξ (hX.imp le_of_lt le_of_lt)
    rcases mul_eq_zero.mp h0 with h | h
    · exact absurd h (Real.rpow_pos_of_pos (hqC0 ξ hξ) _).ne'
    · exact h
  have hmV : ∀ a : Fin 3, ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) →
      mcor5 B G l0 S a ξ = 0 := by
    intro a
    fin_cases a
    · exact keyV _ _ hm0
    · exact keyV _ _ hm1
    · exact keyV _ _ hm2
  have hdV : ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → dPsi ξ = 0 ∧ dv ξ = 0 := by
    intro ξ _ hX
    constructor
    · by_contra hne
      have hp := hshP.2 ξ hne
      rcases hX with h | h <;> linarith [hp.1, hp.2]
    · by_contra hne
      have hp := hshv.2 ξ hne
      rcases hX with h | h <;> linarith [hp.1, hp.2]

  have hqpow : ∀ e : ℝ, ContDiffOn ℝ ∞ (fun ξ => qC B.h ξ ^ e) (DomC B.h (qsOf l0)) :=
    fun e => hqCs.rpow_const_of_ne (fun ξ hξ => (hqC0 ξ hξ).ne')
  have hpsS : ContDiffOn ℝ ∞ (momPsP B dPsi) (DomC B.h (qsOf l0)) :=
    (hqpow (1/2 - Aex B.h)).mul hdPsi
  have hpsV : ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → momPsP B dPsi ξ = 0 := by
    intro ξ hξ hX
    simp only [momPsP, (hdV ξ hξ hX).1, mul_zero]
  have hdwS : ContDiffOn ℝ ∞ (momDvP B dv) (DomC B.h (qsOf l0)) := (hqpow (-Aex B.h)).mul hdv
  have hdwV : ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → momDvP B dv ξ = 0 := by
    intro ξ hξ hX
    simp only [momDvP, (hdV ξ hξ hX).2, mul_zero]
  have hfstS : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1) (DomC B.h (qsOf l0)) := contDiff_fst.contDiffOn
  have hdgS : ContDiffOn ℝ ∞ (momDgP B dPsi) (DomC B.h (qsOf l0)) :=
    (hCl _ hpsS).1.add (hpsS.div hfstS (fun ξ hξ => (hmemD ξ hξ).1.ne'))
  have hdgV : ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → momDgP B dPsi ξ = 0 := by
    intro ξ hξ hX
    simp only [momDgP, (hSVd _ hpsV ξ hξ hX).1, hpsV ξ hξ hX, zero_div, add_zero]
  have hdbS : ContDiffOn ℝ ∞ (momDbP B dPsi) (DomC B.h (qsOf l0)) := (hCl _ hpsS).2.1.neg
  have hdbV : ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → momDbP B dPsi ξ = 0 := by
    intro ξ hξ hX
    simp only [momDbP, (hSVd _ hpsV ξ hξ hX).2.1, neg_zero]
  have hmS' : ∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 (momUpd S dPsi dv) a) (DomC B.h (qsOf l0)) := by
    have e0 : ContDiffOn ℝ ∞ (mcor5 B G l0 (momUpd S dPsi dv) 0) (DomC B.h (qsOf l0)) :=
      ((hmS 0).add hdbS).congr (fun ξ hξ => (hMM ξ hξ).1)
    have e1 : ContDiffOn ℝ ∞ (mcor5 B G l0 (momUpd S dPsi dv) 1) (DomC B.h (qsOf l0)) :=
      ((hmS 1).add hdwS).congr (fun ξ hξ => (hMM ξ hξ).2.1)
    have e2 : ContDiffOn ℝ ∞ (mcor5 B G l0 (momUpd S dPsi dv) 2) (DomC B.h (qsOf l0)) :=
      ((hmS 2).add hdgS).congr (fun ξ hξ => (hMM ξ hξ).2.2.1)
    intro a
    fin_cases a
    · exact e0
    · exact e1
    · exact e2
  have hWS' : ∀ a c : Fin 3, ContDiffOn ℝ ∞ (Wcov5 B G l0 (momUpd S dPsi dv) a c) (DomC B.h (qsOf l0)) :=
    fun a c => (hWS a c).congr (fun ξ hξ => (hMM ξ hξ).2.2.2 a c)
  have hmV' : ∀ a : Fin 3, ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) →
      mcor5 B G l0 (momUpd S dPsi dv) a ξ = 0 := by
    intro a ξ hξ hX
    have e0 : mcor5 B G l0 (momUpd S dPsi dv) 0 ξ = 0 := by
      rw [(hMM ξ hξ).1, hmV 0 ξ hξ hX, hdbV ξ hξ hX, add_zero]
    have e1 : mcor5 B G l0 (momUpd S dPsi dv) 1 ξ = 0 := by
      rw [(hMM ξ hξ).2.1, hmV 1 ξ hξ hX, hdwV ξ hξ hX, add_zero]
    have e2 : mcor5 B G l0 (momUpd S dPsi dv) 2 ξ = 0 := by
      rw [(hMM ξ hξ).2.2.1, hmV 2 ξ hξ hX, hdgV ξ hξ hX, add_zero]
    fin_cases a
    · exact e0
    · exact e1
    · exact e2
  have hWV' : ∀ a c : Fin 3, ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) →
      Wcov5 B G l0 (momUpd S dPsi dv) a c ξ = 0 := by
    intro a c ξ hξ hX
    rw [(hMM ξ hξ).2.2.2 a c]
    exact hWv a c ξ hξ hX
  have hgrS := grP5_contDiffOn_v5 B G l0 (momUpd S dPsi dv) hDo hub hmS' hWS'
  have hgrV := grP5_shell_vanish_v5 B G l0 (momUpd S dPsi dv) hok hmV' hWV'

  have hclos : ∀ f : Cyl → ℝ, ContinuousOn f (DomC B.h (qsOf l0)) →
      (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → f ξ = 0) →
      ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → f ξ = 0 := by
    intro f hf hfv ξ hξ hX
    obtain ⟨hr, ht, hq⟩ := hmemD ξ hξ
    have hq0 := hqC0 ξ hξ
    have h2q : 0 < 2 * qC B.h ξ := mul_pos two_pos hq0
    have hγc : Continuous (fun s : ℝ => ((ξ.1 + s, ξ.2) : Cyl)) :=
      (continuous_const.add continuous_id).prodMk continuous_const
    have hγ0 : ((ξ.1 + 0, ξ.2) : Cyl) = ξ := by simp
    have hγt : Filter.Tendsto (fun s : ℝ => ((ξ.1 + s, ξ.2) : Cyl)) (nhds 0) (nhds ξ) := by
      have := hγc.tendsto 0
      rwa [hγ0] at this
    have hfc : ContinuousAt f ξ := hf.continuousAt (hDo.mem_nhds hξ)
    have hlim : Filter.Tendsto (fun s : ℝ => f ((ξ.1 + s, ξ.2) : Cyl)) (nhds 0) (nhds (f ξ)) :=
      hfc.tendsto.comp hγt
    have hγD : ∀ s : ℝ, 0 < ξ.1 + s → ((ξ.1 + s, ξ.2) : Cyl) ∈ DomC B.h (qsOf l0) :=
      fun s hs => ⟨hs, ht, hq⟩
    have hXCγ : ∀ s : ℝ, XC B.h ((ξ.1 + s, ξ.2) : Cyl) = (ξ.1 + s) ^ 2 / (2 * qC B.h ξ) := fun s => rfl
    have hXCξ : XC B.h ξ = ξ.1 ^ 2 / (2 * qC B.h ξ) := rfl
    rcases hX with hX | hX
    · have hev : ∀ᶠ s in nhdsWithin (0:ℝ) (Set.Iio 0), f ((ξ.1 + s, ξ.2) : Cyl) = 0 := by
        filter_upwards [Ioo_mem_nhdsLT (neg_lt_zero.mpr hr)] with s hs
        obtain ⟨hs1, hs2⟩ := hs
        have hpos : 0 < ξ.1 + s := by linarith
        apply hfv _ (hγD s hpos)
        left
        rw [hXCγ, div_lt_iff₀ h2q]
        rw [hXCξ, div_le_iff₀ h2q] at hX
        nlinarith [mul_pos (neg_pos.mpr hs2) (by linarith : (0:ℝ) < 2 * ξ.1 + s)]
      exact tendsto_nhds_unique (hlim.mono_left nhdsWithin_le_nhds) (tendsto_nhds_of_eventually_eq hev)
    · have hev : ∀ᶠ s in nhdsWithin (0:ℝ) (Set.Ioi 0), f ((ξ.1 + s, ξ.2) : Cyl) = 0 := by
        filter_upwards [self_mem_nhdsWithin] with s hs
        have hs' : (0:ℝ) < s := hs
        have hpos : 0 < ξ.1 + s := by linarith
        apply hfv _ (hγD s hpos)
        right
        rw [hXCγ, lt_div_iff₀ h2q]
        rw [hXCξ, le_div_iff₀ h2q] at hX
        nlinarith [mul_pos hs' (by linarith : (0:ℝ) < 2 * ξ.1 + s)]
      exact tendsto_nhds_unique (hlim.mono_left nhdsWithin_le_nhds) (tendsto_nhds_of_eventually_eq hev)

  have hgrN := hclos _ hgrS.continuousOn hgrV
  have hM := (path_integral_smooth_v5 B (qsOf l0) (grP5 B G l0 (momUpd S dPsi dv)) hok hqs0 hqs1
    hgrS hgrN).2.2.1
  have hcal : ContDiffOn ℝ ∞ (fun η : Cyl => calP5 B G l0 (momUpd S dPsi dv) η.2.1 η.2.2.1)
      (DomC B.h (qsOf l0)) := by
    have hπ : ContDiff ℝ ∞ (fun η : Cyl => (η.2.1, η.2.2.1)) :=
      contDiff_snd.fst.prodMk contDiff_snd.snd.fst
    refine (hM.comp hπ.contDiffOn (fun η hη => ?_)).congr (fun η _ => ?_)
    · obtain ⟨_, h2, h3⟩ := hmemD η hη
      exact ⟨h2, h3⟩
    · simp only [calP5, radMom, yAvg, pow_zero, one_mul, Function.comp_apply]

  obtain ⟨hrs, hrv⟩ := rhoP_regular_v5 B (qsOf l0) hok
  obtain ⟨g, hg⟩ : ∃ g : Cyl → ℝ, g = fun η => grP5 B G l0 (momUpd S dPsi dv) η -
      rhoP B η * calP5 B G l0 (momUpd S dPsi dv) η.2.1 η.2.2.1 := ⟨_, rfl⟩
  have hgs : ContDiffOn ℝ ∞ g (DomC B.h (qsOf l0)) := by
    rw [hg]; exact hgrS.sub (hrs.mul hcal)
  have hgv : ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → g ξ = 0 := by
    intro ξ hξ hX
    rw [hg]
    simp only [hgrV ξ hξ hX, hrv ξ hξ (hX.imp le_of_lt le_of_lt), zero_mul, sub_zero]

  have hPiD : ∀ p : ℝ × Cyl, 0 < p.1 → p.2 ∈ DomC B.h (qsOf l0) →
      pathPt B.h p.2 p.1 ∈ DomC B.h (qsOf l0) := by
    intro p hp1 hp2
    obtain ⟨_, h2, h3⟩ := hmemD p.2 hp2
    exact ⟨hp1, h2, h3⟩
  have hPiS : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => pathPt B.h p.2 p.1) (Set.Ioi 0 ×ˢ DomC B.h (qsOf l0)) := by
    have h1 : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => p.1 ^ drx B.h) (Set.Ioi 0 ×ˢ DomC B.h (qsOf l0)) :=
      contDiffOn_fst.rpow_const_of_ne (fun p hp => (show (0:ℝ) < p.1 from hp.1).ne')
    have h2 : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => p.2.1 ^ drx B.h) (Set.Ioi 0 ×ˢ DomC B.h (qsOf l0)) :=
      (contDiff_snd.fst.contDiffOn).rpow_const_of_ne (fun p hp => (hmemD p.2 hp.2).1.ne')
    have h3 : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => p.2.2.2.2 + (p.1 ^ drx B.h - p.2.1 ^ drx B.h) • vrv)
        (Set.Ioi 0 ×ˢ DomC B.h (qsOf l0)) :=
      contDiff_snd.snd.snd.snd.contDiffOn.add ((h1.sub h2).smul contDiffOn_const)
    exact contDiffOn_fst.prodMk (contDiff_snd.snd.fst.contDiffOn.prodMk
      (contDiff_snd.snd.snd.fst.contDiffOn.prodMk h3))
  obtain ⟨gz, hgz⟩ : ∃ gz : ℝ × Cyl → ℝ,
      gz = fun p => if 0 < p.1 then g (pathPt B.h p.2 p.1) else 0 := ⟨_, rfl⟩
  have hgzS : ContDiffOn ℝ ∞ gz (univ ×ˢ DomC B.h (qsOf l0)) := by
    have hV1 : IsOpen (Set.Ioi (0:ℝ) ×ˢ DomC B.h (qsOf l0)) := isOpen_Ioi.prod hDo
    have hgPi : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => g (pathPt B.h p.2 p.1))
        (Set.Ioi 0 ×ˢ DomC B.h (qsOf l0)) :=
      hgs.comp hPiS (fun p hp => hPiD p hp.1 hp.2)
    have hq : ContinuousOn (fun p : ℝ × Cyl => qC B.h p.2) (univ ×ˢ DomC B.h (qsOf l0)) :=
      hqCs.continuousOn.comp continuous_snd.continuousOn (fun p hp => hp.2)
    have hφ : ContinuousOn (fun p : ℝ × Cyl => Real.sqrt (2 * B.Xa * qC B.h p.2) - p.1)
        (univ ×ˢ DomC B.h (qsOf l0)) :=
      (Real.continuous_sqrt.comp_continuousOn (continuousOn_const.mul hq)).sub continuous_fst.continuousOn
    have hV0 := hφ.isOpen_inter_preimage (isOpen_univ.prod hDo) (isOpen_Ioi (a := (0:ℝ)))
    apply contDiffOn_of_locally_contDiffOn
    rintro ⟨r, ξ⟩ ⟨-, hξ⟩
    by_cases hr : 0 < r
    · refine ⟨Set.Ioi 0 ×ˢ DomC B.h (qsOf l0), hV1, ⟨hr, hξ⟩, ?_⟩
      refine (hgPi.mono inter_subset_right).congr (fun p hp => ?_)
      rw [hgz]
      exact if_pos hp.2.1
    · refine ⟨(univ ×ˢ DomC B.h (qsOf l0)) ∩
          (fun p : ℝ × Cyl => Real.sqrt (2 * B.Xa * qC B.h p.2) - p.1) ⁻¹' Set.Ioi 0, hV0,
          ⟨⟨mem_univ _, hξ⟩, ?_⟩, ?_⟩
      · show (0:ℝ) < Real.sqrt (2 * B.Xa * qC B.h ξ) - r
        have : 0 < Real.sqrt (2 * B.Xa * qC B.h ξ) :=
          Real.sqrt_pos.mpr (mul_pos (mul_pos two_pos hXa) (hqC0 ξ hξ))
        linarith [not_lt.mp hr]
      · refine (contDiffOn_const (c := (0:ℝ))).congr (fun p hp => ?_)
        rw [hgz]
        show (if 0 < p.1 then g (pathPt B.h p.2 p.1) else 0) = 0
        split_ifs with hp1
        · have hpD : p.2 ∈ DomC B.h (qsOf l0) := hp.2.1.2
          have hlt0 : (0:ℝ) < Real.sqrt (2 * B.Xa * qC B.h p.2) - p.1 := hp.2.2
          have hlt : p.1 < Real.sqrt (2 * B.Xa * qC B.h p.2) := by linarith
          have hsq : p.1 ^ 2 < 2 * B.Xa * qC B.h p.2 := (Real.lt_sqrt hp1.le).mp hlt
          apply hgv _ (hPiD p hp1 hpD)
          left
          show p.1 ^ 2 / (2 * qC B.h p.2) < B.Xa
          rw [div_lt_iff₀ (mul_pos two_pos (hqC0 p.2 hpD))]
          linarith
        · rfl

  have hL1 : ∀ ℓ : Cyl → ℝ, ContDiffOn ℝ ∞ ℓ (DomC B.h (qsOf l0)) → (∀ ξ ∈ DomC B.h (qsOf l0), 0 < ℓ ξ) →
      ContDiffOn ℝ ∞ (fun ξ => ∫ r in (0:ℝ)..ℓ ξ, g (pathPt B.h ξ r)) (DomC B.h (qsOf l0)) := by
    intro ℓ hℓ hℓ0
    have hc : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => ℓ p.2 / (2 * Real.pi)) (univ ×ˢ DomC B.h (qsOf l0)) :=
      (hℓ.comp contDiffOn_snd (fun p hp => hp.2)).div_const _
    have hmap : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => (ℓ p.2 / (2 * Real.pi) * p.1, p.2))
        (univ ×ˢ DomC B.h (qsOf l0)) :=
      (hc.mul contDiffOn_fst).prodMk contDiffOn_snd
    have hGl : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => ℓ p.2 / (2 * Real.pi) * gz (ℓ p.2 / (2 * Real.pi) * p.1, p.2))
        (univ ×ˢ DomC B.h (qsOf l0)) :=
      hc.mul (hgzS.comp hmap (fun p hp => ⟨mem_univ _, hp.2⟩))
    have hI := cyl_param_integral_contDiffOn (DomC B.h (qsOf l0)) _ hDo hGl
    refine hI.congr (fun ξ hξ => ?_)
    show ∫ r in (0:ℝ)..ℓ ξ, g (pathPt B.h ξ r) =
      ∫ θ in (0:ℝ)..(2 * Real.pi), ℓ ξ / (2 * Real.pi) * gz (ℓ ξ / (2 * Real.pi) * θ, ξ)
    have hπ := Real.pi_pos
    have hℓξ := hℓ0 ξ hξ
    have hcne : ℓ ξ / (2 * Real.pi) ≠ 0 := (div_pos hℓξ (by positivity)).ne'
    have h1 := intervalIntegral.integral_comp_mul_left (a := (0:ℝ)) (b := 2 * Real.pi)
      (fun r => gz (r, ξ)) hcne
    have hc2 : ℓ ξ / (2 * Real.pi) * (2 * Real.pi) = ℓ ξ := by field_simp
    simp only [mul_zero, hc2] at h1
    rw [intervalIntegral.integral_const_mul, h1, smul_eq_mul, mul_inv_cancel_left₀ hcne,
      intervalIntegral.integral_of_le hℓξ.le, intervalIntegral.integral_of_le hℓξ.le]
    refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioc (fun r hr => ?_)
    rw [hgz]
    exact (if_pos hr.1).symm

  have hT1 := hL1 (fun ξ => ξ.1) hfstS (fun ξ hξ => (hmemD ξ hξ).1)
  have hR0 : 0 < Real.sqrt (2 * B.Xb) := Real.sqrt_pos.mpr (by linarith)
  have hT2 := hL1 (fun _ => Real.sqrt (2 * B.Xb)) contDiffOn_const (fun _ _ => hR0)
  have hT2eq : ∀ ξ ∈ DomC B.h (qsOf l0), ∫ r in Set.Ioi (0:ℝ), g (pathPt B.h ξ r) =
      ∫ r in (0:ℝ)..Real.sqrt (2 * B.Xb), g (pathPt B.h ξ r) := by
    intro ξ hξ
    rw [intervalIntegral.integral_of_le hR0.le]
    refine MeasureTheory.setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi
      Set.Ioc_subset_Ioi_self (fun r hr => ?_)
    obtain ⟨hr0, hrR⟩ := hr
    have hr0' : (0:ℝ) < r := hr0
    have hRr : Real.sqrt (2 * B.Xb) < r := by
      by_contra h
      exact hrR ⟨hr0', not_lt.mp h⟩
    have hsq : 2 * B.Xb < r ^ 2 := (Real.sqrt_lt' hr0').mp hRr
    obtain ⟨_, _, hq⟩ := hmemD ξ hξ
    have hq0 := hqC0 ξ hξ
    have hq1 : qC B.h ξ < 1 := lt_of_lt_of_le hq hqs1
    apply hgv _ (hPiD (r, ξ) hr0' hξ)
    right
    show B.Xb < r ^ 2 / (2 * qC B.h ξ)
    rw [lt_div_iff₀ (mul_pos two_pos hq0)]
    nlinarith

  have hXCs : ContDiffOn ℝ ∞ (XC B.h) (DomC B.h (qsOf l0)) :=
    ((contDiff_fst.pow 2).contDiffOn).div (contDiffOn_const.mul hqCs)
      (fun ξ hξ => mul_ne_zero two_ne_zero (hqC0 ξ hξ).ne')
  have hsm : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff (n := ⊤)
  have haff : ContDiff ℝ ∞ (fun X : ℝ => (X - B.m1) / (B.m2 - B.m1)) :=
    (contDiff_id.sub contDiff_const).div_const _
  have hchi : ContDiffOn ℝ ∞ (fun ξ => chiM B (XC B.h ξ)) (DomC B.h (qsOf l0)) :=
    (hsm.comp haff).comp_contDiffOn hXCs

  refine (hT1.sub (hchi.mul hT2)).congr (fun ξ hξ => ?_)
  show Icut B (fun η => grP5 B G l0 (momUpd S dPsi dv) η -
      rhoP B η * calP5 B G l0 (momUpd S dPsi dv) η.2.1 η.2.2.1) ξ = _
  rw [← hg]
  simp only [Icut]
  rw [hT2eq ξ hξ]

theorem mom_wave_harmonics_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → SimNorm B.h → ∃ l1 : ℕ,
    ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (S : CState) (bw ca cm cd : ℝ) (dPsi dv : Cyl → ℝ) (Hx : ℝ), StOrd5 B G l0 S bw ca cm cd → bw ≤ Hx →
    MomShape B dPsi → MomShape B dv → InM B (qsOf l0) Hx dPsi → InM B (qsOf l0) Hx dv →
    InM B (qsOf l0) Hx (nrm B (Aex B.h) (momDvP B dv)) → InM B (qsOf l0) Hx (nrm B (Aex B.h) (momDgP B dPsi)) →
    InM B (qsOf l0) (Hx + 1) (nrm B (Aex B.h) (momDbP B dPsi)) →
    ∃ (f : WC) (Fl : Ext ℝ³), InWg5 B G (qsOf l0) bw f ∧ FlatX B (qsOf l0) Fl ∧ ∀ x t Y, corrOn B l0 x t →
      resX B.h (uX5 B G l0 (momUpd S dPsi dv)) (PX5 B G l0 (momUpd S dPsi dv)) x t Y
        - thAvgVec (resX B.h (uX5 B G l0 (momUpd S dPsi dv)) (PX5 B G l0 (momUpd S dPsi dv))) x t Y
        = (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) • cyl2cart x (waveV5 B G f (thetaOf x) (ptOf x t Y))
          + Fl x t Y :=
by
  intro B G hok hG hSN
  obtain ⟨l₁, h1⟩ := twg5_fields_smooth B G hok hG
  obtain ⟨l₁b, h1b⟩ := mwh5_pm_increment_smooth B G hok hG
  obtain ⟨l₃, h3⟩ := mwh5_wave_velocity_rep B G hok hG
  obtain ⟨l₅a, h5a⟩ := twg5_cross_identity B G hok hG
  obtain ⟨l₅b, h5b⟩ := twg5_cross_coeff_struct B G hok hG
  obtain ⟨l₅c, h5c⟩ := twg5_cross_coeff_bound B G hok hG hSN
  refine ⟨l₁ + l₁b + l₃ + l₅a + l₅b + l₅c, ?_⟩
  intro l0 hl0 S bw ca cm cd dPsi dv Hx hSt hbw hshP hshv hP hv hdw hdg hdb

  have hLF : ∀ ξ₀ ∈ DomC B.h (qsOf l0), ∃ (U : Set Cyl) (Γ : Finset Lab), IsOpen U ∧ ξ₀ ∈ U ∧
      ∀ ξ ∈ U, ∀ γ, γ ∉ Γ → ¬ SuppW B G γ ξ := by
    intro ξ₀ hξ₀
    obtain ⟨N, hN, Γ, hΓ⟩ := etaL_local_finite_v5 B.h hok.1 ξ₀ hξ₀.2.1
    exact ⟨interior N, Γ, isOpen_interior, mem_interior_iff_mem_nhds.mpr hN,
      fun ξ hξ γ hγ hS => hγ (hΓ γ ξ (interior_subset hξ) hS.2.1)⟩

  have hSt' := hSt
  unfold StOrd5 at hSt'
  obtain ⟨-, -, -, -, -, -, ⟨fS, FlS, hfS, hFlS, hEqS⟩, -, -, -, -, -, -, -, -, -, -, -, -, hpm0, -, -, -⟩ :=
    hSt'

  have hdU : ContDiffOn ℝ ∞ (dUM5 B dPsi dv) (DomC B.h (qsOf l0)) := by
    have e1 := (g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) (Hx + 1) _ hok hdb).1
    have e2 := (g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) Hx _ hok hdw).1
    have e3 := (g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) Hx _ hok hdg).1
    refine contDiffOn_pi.mpr (fun i => ?_)
    fin_cases i
    · exact e1
    · exact e2
    · exact e3
  have hpm' := h1b l0 (by omega) S bw ca cm cd Hx dPsi dv hSt hshP hshv hP hv
  have hPc : ContDiffOn ℝ ∞ (fun ξ => pmP5 B G l0 (momUpd S dPsi dv) ξ - pmP5 B G l0 S ξ)
      (DomC B.h (qsOf l0)) :=
    hpm'.sub (g_regular_of_nrm_InM_v5 B (qsOf l0) (2 * Aex B.h) 0.9 _ hok hpm0).1
  have hDrep : ∀ x t Y, corrOn B l0 x t →
      DXm5 B l0 dPsi dv x t Y = cyl2cart x (dUM5 B dPsi dv (ptOf x t Y)) := by
    intro x t Y h
    simp only [DXm5, if_pos h]

  obtain ⟨hA, huS, hpS, hW'⟩ := h1 l0 (by omega) S bw ca cm cd hSt hLF
  have hinc := twg5_increment_fields B G l0 S Hx dPsi dv hok hP hv hA
  have hw := h3 l0 (by omega) S bw ca cm cd hSt hLF
  have hproj := mwh5_theta_projection B G l0 S (momUpd S dPsi dv)
    (fun ξ => pmP5 B G l0 (momUpd S dPsi dv) ξ - pmP5 B G l0 S ξ) (dUM5 B dPsi dv)
    (fun x' t' Y' => cyl2cart x' (waveV5 B G (VwT5 B G S) (thetaOf x') (ptOf x' t' Y')))
    (DXm5 B l0 dPsi dv) hok huS hpS hW' hdU hPc hDrep hw hinc
  have hcross := h5a l0 (by omega) S bw ca cm cd Hx dPsi dv hSt hP hv hLF
  have hstr := h5b l0 (by omega) S bw ca cm cd dPsi dv Hx hSt hP hv hdw hdg hdb
  have hbd := h5c l0 (by omega) S bw ca cm cd dPsi dv Hx hSt hP hv hdw hdg hdb
  have hcls : InWg5 B G (qsOf l0) Hx (crossCoefM5 B G S dPsi dv) :=
    ⟨hstr.1, hstr.2.1, hstr.2.2.1, hstr.2.2.2, hbd⟩
  obtain ⟨hsum, hadd⟩ := mwh5_waveV_add B G hok l0 fS (crossCoefM5 B G S dPsi dv) bw Hx hLF hfS hcls
  rw [min_eq_left hbw] at hsum
  refine ⟨fS + crossCoefM5 B G S dPsi dv, FlS, hsum, hFlS, fun x t Y hxt => ?_⟩
  have hmem : ptOf x t Y ∈ DomC B.h (qsOf l0) := ⟨hxt.1, hxt.2.1, hxt.2.2⟩
  have hc : ∀ a b : Fin 3 → ℝ, cyl2cart x (a + b) = cyl2cart x a + cyl2cart x b := by
    intro a b
    simp only [cyl2cart, Pi.add_apply, add_smul]
    abel
  rw [hproj x t Y hxt, hEqS x t Y hxt, hcross x t Y hxt, hadd _ _ hmem, hc, smul_add]
  abel

theorem initial_mean_update_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ,
