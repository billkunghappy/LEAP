      have hpU : p ∈ U0 ∪ U2 := by
        left
        rw [hU0]
        refine ⟨hp, ?_⟩
        show 0 < 2 * B.Xa * simScale B.h (p.1 2) (1 - p.2) - rad p.1 ^ 2
        have h0 : (0:ℝ) ^ 2 = 0 := by norm_num
        rw [hr0, h0, sub_zero]
        exact mul_pos (mul_pos two_pos hXa) (hQpos p hp.1)
      refine ⟨U0 ∪ U2, hU0o.union hU2o, hpU, ?_⟩
      exact (contDiffOn_const (c := (0 : ℝ³))).congr (fun w hw => hZ0 Y₀ w hw.2)

  have hF1' : FlatX B (qsOf l0) F := by
    intro m N
    obtain ⟨K, M, hK, hcrux⟩ := wpf_sum_bound B hok l0 hqs1 e m
    obtain ⟨N', hN'⟩ : ∃ N' : ℕ, N' = N + m + ⌈M⌉₊ := ⟨_, rfl⟩
    choose Cb hCb using fun (i : Fin 3) (j : ℕ) => hbd i j N'
    obtain ⟨A0, hA0def⟩ : ∃ A0 : ℝ, A0 = ∑ i : Fin 3, ∑ j ∈ Finset.range (m + 1), |Cb i j| :=
      ⟨_, rfl⟩
    obtain ⟨MH, hMHdef⟩ : ∃ MH : ℝ, MH = ∑ m' ∈ H, |(m' : ℝ)| := ⟨_, rfl⟩
    have hA00 : 0 ≤ A0 := by
      rw [hA0def]
      exact Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => abs_nonneg _))
    have hMH0 : 0 ≤ MH := by
      rw [hMHdef]
      exact Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have hCbA : ∀ (i : Fin 3) (j : ℕ), j ≤ m → Cb i j ≤ A0 := by
      intro i j hj
      rw [hA0def]
      calc Cb i j ≤ |Cb i j| := le_abs_self _
        _ ≤ ∑ j' ∈ Finset.range (m + 1), |Cb i j'| :=
            Finset.single_le_sum (f := fun j' => |Cb i j'|) (fun _ _ => abs_nonneg _)
              (Finset.mem_range.2 (by omega))
        _ ≤ ∑ i' : Fin 3, ∑ j' ∈ Finset.range (m + 1), |Cb i' j'| :=
            Finset.single_le_sum (f := fun i' => ∑ j' ∈ Finset.range (m + 1), |Cb i' j'|)
              (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _)) (Finset.mem_univ i)
    have hMHb : ∀ m' ∈ H, |(m' : ℝ)| ≤ MH := by
      intro m' hm'
      rw [hMHdef]
      exact Finset.single_le_sum (f := fun m'' : ℤ => |(m'' : ℝ)|) (fun _ _ => abs_nonneg _) hm'
    have hMK1 : 0 ≤ MH * K4 + 1 := by
      have := mul_nonneg hMH0 hK40
      linarith
    have hc'0 : (0:ℝ) ≤ 162 * (H.card : ℝ) := by positivity
    have hC0 : 0 ≤ K * (162 * (H.card : ℝ)) * (MH * K4 + 1) ^ m * A0 :=
      mul_nonneg (mul_nonneg (mul_nonneg hK hc'0) (pow_nonneg hMK1 m)) hA00
    refine ⟨K * (162 * (H.card : ℝ)) * (MH * K4 + 1) ^ m * A0, fun Y₀ x s hxs => ?_⟩
    have hq0 : 0 < simScale B.h (x 2) (1 - s) := hQpos (x, s) hxs.1
    have hq1 : simScale B.h (x 2) (1 - s) ≤ 1 := le_trans hxs.2.le hqs1
    set Q := simScale B.h (x 2) (1 - s) with hQ
    by_cases hsh : 2 * B.Xa * Q ≤ rad x ^ 2 ∧ rad x ^ 2 ≤ 2 * B.Xb * Q
    · obtain ⟨hsh1, hsh2⟩ := hsh
      have hXQ : 0 < B.Xa * Q := mul_pos hXa hq0
      have hXbQ : 0 < B.Xb * Q := mul_pos hXb hq0
      have hr : 0 < rad x := by
        rcases (Real.sqrt_nonneg (x 0 ^ 2 + x 1 ^ 2)).lt_or_eq with h | h
        · exact h
        · exfalso
          have h0 : rad x = 0 := h.symm
          have h00 : (0:ℝ) ^ 2 = 0 := by norm_num
          rw [h0, h00] at hsh1
          linarith
      have hc : corrOn B l0 x s := ⟨hr, hxs.1, hxs.2⟩
      obtain ⟨T, V, hVo, hpV, -, hcard, hTprop, hrep⟩ := hloc Y₀ (x, s) hc
      have hev : (↿(evOff B.h F Y₀)) =ᶠ[nhds (x, s)] wpfPsi B e T β n Y₀ :=
        Filter.eventuallyEq_of_mem (hVo.mem_nhds hpV) hrep
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
      have hξ : ptOf x s (Yph B.h (rad x) s + Y₀) ∈ DomC B.h (qsOf l0) := hc
      obtain ⟨ν, hνdef⟩ : ∃ ν : ℝ, ν = MH * K4 / Q := ⟨_, rfl⟩
      obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = A0 * Q ^ (N' : ℝ) := ⟨_, rfl⟩
      have hν0 : 0 ≤ ν := by
        rw [hνdef]
        exact div_nonneg (mul_nonneg hMH0 hK40) hq0.le
      have hA0 : 0 ≤ A := by
        rw [hAdef]
        exact mul_nonneg hA00 (Real.rpow_nonneg hq0.le _)
      have hνb : ∀ t ∈ T, |(n t : ℝ)| ≤ ν := by
        intro t ht
        obtain ⟨htH, hAct, hlog⟩ := hTprop t ht
        have hp : |(pint5 B G t.1 : ℝ)| ≤ K4 / Q := hK4 t.1 Q hAct hq0 hq1 hlog
        have hm := hMHb t.2 htH
        have e1 : ((n t : ℤ) : ℝ) = (t.2 : ℝ) * (pint5 B G t.1 : ℝ) := by
          simp only [hn]
          push_cast
          ring
        rw [e1, abs_mul, hνdef, mul_div_assoc]
        exact mul_le_mul hm hp (abs_nonneg _) hMH0
      have hAb : ∀ t ∈ T, ∀ i : Fin 3, ∀ j ≤ m, ‖iteratedFDeriv ℝ j (β t i)
          (ptOf (x, s).1 (x, s).2 (Yph B.h (rad (x, s).1) (x, s).2 + Y₀))‖ ≤ A := by
        intro t _ i j hj
        rw [hAdef]
        exact le_trans (hCb i j t.1 t.2 _ hξ)
          (mul_le_mul_of_nonneg_right (hCbA i j hj) (Real.rpow_nonneg hq0.le _))
      have hfinal : ‖iteratedFDeriv ℝ m (wpfPsi B e T β n Y₀) (x, s)‖ ≤
          K * (T.card : ℝ) * (ν + 1) ^ m * Q ^ (-M) * A :=
        (hcrux T β n Y₀ hβsm).2 (x, s) ν A hc (by show B.Xa * Q < rad x ^ 2; linarith)
          (by show rad x ^ 2 < 4 * B.Xb * Q; linarith) hν0 hA0 hνb hAb
      refine le_trans hfinal ?_
      have hcardR : (T.card : ℝ) ≤ 162 * (H.card : ℝ) := by exact_mod_cast hcard
      have h1Q : 1 ≤ 1 / Q := by
        rw [le_div_iff₀ hq0]
        linarith
      have hν1 : ν + 1 ≤ (MH * K4 + 1) / Q := by
        rw [add_div, hνdef]
        linarith
      have hu : (ν + 1) ^ m ≤ (MH * K4 + 1) ^ m / Q ^ m := by
        rw [← div_pow]
        exact pow_le_pow_left₀ (by linarith) hν1 m
      have hP : Q ^ (-M) * Q ^ (N' : ℝ) / Q ^ m ≤ Q ^ (N : ℝ) := by
        have e1 : Q ^ (-M) * Q ^ (N' : ℝ) / Q ^ m = Q ^ (-M + (N' : ℝ) + (-(m : ℝ))) := by
          rw [Real.rpow_add hq0, Real.rpow_add hq0, Real.rpow_neg hq0.le (m : ℝ),
            Real.rpow_natCast Q m, div_eq_mul_inv]
        rw [e1]
        apply Real.rpow_le_rpow_of_exponent_ge hq0 hq1
        have hcM : M ≤ (⌈M⌉₊ : ℝ) := Nat.le_ceil M
        rw [hN']
        push_cast
        linarith
      have hw0 : 0 ≤ Q ^ (-M) * A := mul_nonneg (Real.rpow_nonneg hq0.le _) hA0
      calc K * (T.card : ℝ) * (ν + 1) ^ m * Q ^ (-M) * A
          = (K * (T.card : ℝ) * (ν + 1) ^ m) * (Q ^ (-M) * A) := by ring
        _ ≤ (K * (162 * (H.card : ℝ)) * ((MH * K4 + 1) ^ m / Q ^ m)) * (Q ^ (-M) * A) := by
            apply mul_le_mul_of_nonneg_right _ hw0
            exact mul_le_mul (mul_le_mul_of_nonneg_left hcardR hK) hu
              (pow_nonneg (by linarith) m) (mul_nonneg hK hc'0)
        _ = K * (162 * (H.card : ℝ)) * (MH * K4 + 1) ^ m * A0 *
              (Q ^ (-M) * Q ^ (N' : ℝ) / Q ^ m) := by
            rw [hAdef]
            ring
        _ ≤ K * (162 * (H.card : ℝ)) * (MH * K4 + 1) ^ m * A0 * Q ^ (N : ℝ) :=
            mul_le_mul_of_nonneg_left hP hC0
    · have hpU : (x, s) ∈ U0 ∪ U2 := by
        rw [hU0, hU2]
        rcases not_and_or.mp hsh with h | h
        · left
          refine ⟨hxs, ?_⟩
          show 0 < 2 * B.Xa * Q - rad x ^ 2
          linarith [not_le.mp h]
        · right
          refine ⟨hxs, ?_⟩
          show 0 < rad x ^ 2 - 2 * B.Xb * Q
          linarith [not_le.mp h]
      have hev : (↿(evOff B.h F Y₀)) =ᶠ[nhds (x, s)] fun _ => (0 : ℝ³) :=
        Filter.eventuallyEq_of_mem ((hU0o.union hU2o).mem_nhds hpU) (fun w hw => hZ0 Y₀ w hw)
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds, iteratedFDeriv_fun_zero]
      simp only [Pi.zero_apply, norm_zero]
      exact mul_nonneg hC0 (Real.rpow_nonneg hq0.le _)
  exact ⟨hF1', hF2, fun x t Y hxt hr => hzero x t Y hxt (Or.inl hr)⟩

theorem plin5_tail_flat : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → InWg5 B G (qsOf l0) (1/2) (W0h4 B G) → InWg5 B G (qsOf l0) 1 (primState5 B G).pw → (∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), princC5 B G γ m ξ ≠ 0 → (m = 1 ∨ m = -1) ∧ SuppW B G γ ξ ∧ Lsb B.h G.r0 γ.1 / 5 ≤ |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2|) → FlatS5 B l0 (tailF5 B G l0) :=
by
  intro B G hok hG
  obtain ⟨-, -, hXa, -, -, -, -, hqB0, -, -, -, haa, hab⟩ := hok.2.1
  obtain ⟨l2, h2⟩ := plin5_princ_smooth B G hok hG
  obtain ⟨c, hc, h3⟩ := plin5_window_env B G hok hG
  obtain ⟨l5, h5⟩ := plin5_princ_nb_env B G hok hG
  obtain ⟨l8, h8⟩ := plin5_phase_flat B G hok hG
  obtain ⟨l9, h9⟩ := plin5_wave_phys_flat B G hok hG
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨l2 + l5 + l8 + l9 + n0, fun l0 hl0 hW0 hpw H3 => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le

  have hsm := h2 l0 (by omega) hW0 hpw
  have hact : ∀ (γ : Lab) (m : ℤ) (ξ : Cyl), ξ ∈ DomC B.h (qsOf l0) → princC5 B G γ m ξ ≠ 0 →
      etaL B.h γ ξ ≠ 0 :=
    fun γ m ξ hξ hne => plin5_princ_active B G hok l0 hW0 γ m ξ hξ hne
  have hnb := h5 l0 (by omega) hW0 hpw

  have gauss : ∀ (n : ℕ) (a s : ℝ), 0 < a → 0 ≤ s →
      Real.exp (-(a * s ^ 2 / 2)) * s ^ n ≤ 1 + (2 / a) ^ n * (n.factorial : ℝ) := by
    intro n a s ha hs
    obtain ⟨x, hx⟩ : ∃ x : ℝ, x = a * s ^ 2 / 2 := ⟨_, rfl⟩
    rw [← hx]
    have hx0 : 0 ≤ x := by rw [hx]; positivity
    have e1 : 2 / a * x = s ^ 2 := by rw [hx]; field_simp
    have e2 : (2 / a) ^ n * x ^ n = (s ^ n) ^ 2 := by
      rw [← mul_pow, e1]; ring
    have hsn : 0 ≤ s ^ n := pow_nonneg hs n
    have h1 : s ^ n ≤ 1 + (2 / a) ^ n * x ^ n := by
      rw [e2]; nlinarith [sq_nonneg (s ^ n - 1)]
    have hfac : (0:ℝ) < (n.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos n
    have h2' : x ^ n ≤ Real.exp x * (n.factorial : ℝ) :=
      (div_le_iff₀ hfac).mp (Real.pow_div_factorial_le_exp x hx0 n)
    have hE : Real.exp (-x) * Real.exp x = 1 := by rw [← Real.exp_add]; simp
    have hE0 : 0 < Real.exp (-x) := Real.exp_pos _
    have hE1 : Real.exp (-x) ≤ 1 := Real.exp_le_one_iff.mpr (by linarith)
    have h2a : 0 ≤ (2 / a) ^ n := by positivity
    have h3' : Real.exp (-x) * x ^ n ≤ (n.factorial : ℝ) := by
      calc Real.exp (-x) * x ^ n ≤ Real.exp (-x) * (Real.exp x * (n.factorial : ℝ)) :=
            mul_le_mul_of_nonneg_left h2' hE0.le
        _ = (n.factorial : ℝ) := by rw [← mul_assoc, hE, one_mul]
    have h4 := mul_le_mul_of_nonneg_left h3' h2a
    calc Real.exp (-x) * s ^ n ≤ Real.exp (-x) * (1 + (2 / a) ^ n * x ^ n) :=
          mul_le_mul_of_nonneg_left h1 hE0.le
      _ = Real.exp (-x) + (2 / a) ^ n * (Real.exp (-x) * x ^ n) := by ring
      _ ≤ 1 + (2 / a) ^ n * (n.factorial : ℝ) := by linarith

  have hgauss : ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      princC5 B G γ m ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      NB B.h (princC5 B G γ m) k ξ ≤ C * qC B.h ξ ^ (-1:ℝ) * SC B.h ξ ^ b * Real.exp (-c * (γ.1 : ℝ) ^ 2) := by
    intro k
    obtain ⟨C5, b, d, hC5⟩ := hnb k
    obtain ⟨n, hn⟩ : ∃ n : ℕ, d ≤ (n : ℝ) := ⟨⌈d⌉₊, Nat.le_ceil d⟩
    refine ⟨|C5| * (3 + (2 / B.aa) ^ n * (n.factorial : ℝ) + (2 / B.ab) ^ n * (n.factorial : ℝ)), b,
      fun γ m ξ hξ hne hX1 hX2 => ?_⟩
    obtain ⟨hm, hS, hwin⟩ := H3 γ m ξ hξ hne
    have het := hact γ m ξ hξ hne
    have hb5 := hC5 γ m ξ hξ hm hS het hX1 hX2
    obtain ⟨⟨hlmin, -⟩, -, -, het0, hXa', hXb'⟩ := hS
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
    have hmem : ξ ∈ DomC B.h B.qB :=
      show 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < B.qB from ⟨hξ'.1, hξ'.2.1, lt_of_lt_of_le hξ'.2.2 hqs⟩
    have hAct : ActiveL4 B G γ := ⟨hlmin, ξ, hmem, het, hXa', hXb'⟩

    have hTgc : (0:ℝ) < Tgc := by unfold Tgc; positivity
    have hcib : 0 < cib B.h γ.1 := by
      unfold cib
      exact mul_pos (zpow_pos hTgc _) (Real.rpow_pos_of_pos (by unfold Qb; positivity) _)
    have hetl := abs_le.mp het0
    have hv0 : 0 ≤ vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 := by
      unfold vco; exact div_nonneg (by linarith [hetl.1]) hcib.le
    have hv1 : vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 ≤ Lsb B.h G.r0 γ.1 := by
      unfold vco Lsb; exact div_le_div_of_nonneg_right (by linarith [hetl.2]) hcib.le
    have hP := h3 γ _ hAct hv0 hv1 hwin
    have hP0 : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
      unfold Penv5; exact (Real.exp_pos _).le

    set X := XC B.h ξ with hXdef
    have hX0 : 0 < X := lt_trans hXa hX1
    obtain ⟨y, hydef⟩ : ∃ y : ℝ, y = Real.log (X / B.Xa) := ⟨_, rfl⟩
    obtain ⟨z, hzdef⟩ : ∃ z : ℝ, z = Real.log (B.Xb / X) := ⟨_, rfl⟩
    have hy : 0 < y := by rw [hydef]; exact Real.log_pos ((one_lt_div hXa).mpr hX1)
    have hz : 0 < z := by rw [hzdef]; exact Real.log_pos ((one_lt_div hX0).mpr hX2)
    have hew : edgeWeight B.Xa B.Xb B.aa B.ab X = Real.exp (-(B.aa / y ^ 2) - B.ab / z ^ 2) := by
      unfold edgeWeight; rw [if_pos ⟨hX1, hX2⟩, hydef, hzdef]
    set sw := Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab X) with hswdef
    have hsw : sw = Real.exp ((-(B.aa / y ^ 2) - B.ab / z ^ 2) / 2) := by
      have hsplit : Real.exp (-(B.aa / y ^ 2) - B.ab / z ^ 2) =
          Real.exp ((-(B.aa / y ^ 2) - B.ab / z ^ 2) / 2) * Real.exp ((-(B.aa / y ^ 2) - B.ab / z ^ 2) / 2) := by
        rw [← Real.exp_add]; ring_nf
      rw [hswdef, hew, hsplit, Real.sqrt_mul_self (Real.exp_pos _).le]
    obtain ⟨u, hudef⟩ : ∃ u : ℝ, u = y⁻¹ := ⟨_, rfl⟩
    obtain ⟨w, hwdef⟩ : ∃ w : ℝ, w = z⁻¹ := ⟨_, rfl⟩
    have hu0 : 0 ≤ u := by rw [hudef]; exact (inv_pos.mpr hy).le
    have hw0 : 0 ≤ w := by rw [hwdef]; exact (inv_pos.mpr hz).le
    have hay : B.aa / y ^ 2 = B.aa * u ^ 2 := by rw [hudef, inv_pow, div_eq_mul_inv]
    have hbz : B.ab / z ^ 2 = B.ab * w ^ 2 := by rw [hwdef, inv_pow, div_eq_mul_inv]
    have hA0 : 0 ≤ B.aa * u ^ 2 := by positivity
    have hB0 : 0 ≤ B.ab * w ^ 2 := by positivity
    have hsw0 : 0 ≤ sw := Real.sqrt_nonneg _
    have hsw1 : sw ≤ 1 := by
      rw [hsw]; apply Real.exp_le_one_iff.mpr; rw [hay, hbz]; linarith
    have hswa : sw ≤ Real.exp (-(B.aa * u ^ 2 / 2)) := by
      rw [hsw]; apply Real.exp_le_exp.mpr; rw [hay, hbz]; linarith
    have hswb : sw ≤ Real.exp (-(B.ab * w ^ 2 / 2)) := by
      rw [hsw]; apply Real.exp_le_exp.mpr; rw [hay, hbz]; linarith
    set ed := edgeDist B.Xa B.Xb X with heddef
    have hed : ed = min 1 (min y z) := by rw [heddef, hydef, hzdef]; rfl
    have hed0 : 0 < ed := by rw [hed]; exact lt_min one_pos (lt_min hy hz)
    have hed1 : ed ≤ 1 := by rw [hed]; exact min_le_left _ _
    have hedd : ed ^ (-d) ≤ (ed⁻¹) ^ n := by
      calc ed ^ (-d) ≤ ed ^ (-(n:ℝ)) := Real.rpow_le_rpow_of_exponent_ge hed0 hed1 (by linarith)
        _ = (ed⁻¹) ^ n := by rw [Real.rpow_neg hed0.le, Real.rpow_natCast, inv_pow]
    have hun : 0 ≤ u ^ n := pow_nonneg hu0 n
    have hwn : 0 ≤ w ^ n := pow_nonneg hw0 n
    have hedn : (ed⁻¹) ^ n ≤ 1 + u ^ n + w ^ n := by
      rcases min_choice (1:ℝ) (min y z) with h1 | h1
      · rw [hed, h1, inv_one, one_pow]; linarith
      · rcases min_choice y z with h2 | h2
        · rw [hed, h1, h2, ← hudef]; linarith
        · rw [hed, h1, h2, ← hwdef]; linarith
    have hedd0 : 0 ≤ ed ^ (-d) := Real.rpow_nonneg hed0.le _
    have gA := gauss n B.aa u haa hu0
    have gB := gauss n B.ab w hab hw0
    have hEdge : sw * ed ^ (-d) ≤
        3 + (2 / B.aa) ^ n * (n.factorial : ℝ) + (2 / B.ab) ^ n * (n.factorial : ℝ) := by
      have e1 : sw * ed ^ (-d) ≤ sw + sw * u ^ n + sw * w ^ n :=
        calc sw * ed ^ (-d) ≤ sw * (1 + u ^ n + w ^ n) :=
              mul_le_mul_of_nonneg_left (le_trans hedd hedn) hsw0
          _ = sw + sw * u ^ n + sw * w ^ n := by ring
      have e2 : sw * u ^ n ≤ Real.exp (-(B.aa * u ^ 2 / 2)) * u ^ n :=
        mul_le_mul_of_nonneg_right hswa hun
      have e3 : sw * w ^ n ≤ Real.exp (-(B.ab * w ^ 2 / 2)) * w ^ n :=
        mul_le_mul_of_nonneg_right hswb hwn
      linarith

    have hqi : 0 ≤ qC B.h ξ ^ (-1:ℝ) := Real.rpow_nonneg hq0.le _
    have hSC : 0 ≤ SC B.h ξ ^ b := Real.rpow_nonneg (by unfold SC; positivity) _
    obtain ⟨Q, hQdef⟩ : ∃ Q : ℝ, Q = qC B.h ξ ^ (-1:ℝ) * SC B.h ξ ^ b := ⟨_, rfl⟩
    have hQ0 : 0 ≤ Q := by rw [hQdef]; exact mul_nonneg hqi hSC
    obtain ⟨K, hKdef⟩ : ∃ K : ℝ,
        K = 3 + (2 / B.aa) ^ n * (n.factorial : ℝ) + (2 / B.ab) ^ n * (n.factorial : ℝ) := ⟨_, rfl⟩
    rw [← hKdef] at hEdge
    have hK0 : 0 ≤ K := le_trans (mul_nonneg hsw0 hedd0) hEdge
    have hb5' : NB B.h (princC5 B G γ m) k ξ ≤
        C5 * Q * ((sw * ed ^ (-d)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) := by
      rw [hQdef]
      calc NB B.h (princC5 B G γ m) k ξ ≤ C5 * qC B.h ξ ^ (-1:ℝ) * SC B.h ξ ^ b * sw * ed ^ (-d) *
            Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := hb5
        _ = _ := by ring
    have s1 : (sw * ed ^ (-d)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) ≤
        K * Real.exp (-c * (γ.1 : ℝ) ^ 2) := mul_le_mul hEdge hP hP0 hK0
    have s2 : C5 * Q ≤ |C5| * Q := mul_le_mul_of_nonneg_right (le_abs_self _) hQ0
    have s3 : C5 * Q * ((sw * ed ^ (-d)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) ≤
        |C5| * Q * (K * Real.exp (-c * (γ.1 : ℝ) ^ 2)) :=
      mul_le_mul s2 s1 (mul_nonneg (mul_nonneg hsw0 hedd0) hP0) (mul_nonneg (abs_nonneg _) hQ0)
    rw [← hKdef]
    calc NB B.h (princC5 B G γ m) k ξ ≤ |C5| * Q * (K * Real.exp (-c * (γ.1 : ℝ) ^ 2)) :=
          le_trans hb5' s3
      _ = |C5| * K * qC B.h ξ ^ (-1:ℝ) * SC B.h ξ ^ b * Real.exp (-c * (γ.1 : ℝ) ^ 2) := by
          rw [hQdef]; ring

  have hflat := plin5_nb_gauss_flat B G hok l0 hqs (princC5 B G) c hc hsm
    (fun γ m ξ hξ hne => by
      obtain ⟨-, hS, -⟩ := H3 γ m ξ hξ hne
      obtain ⟨-, -, -, -, hXa', hXb'⟩ := hS
      exact ⟨hXa', hXb', hact γ m ξ hξ hne⟩) hgauss

  have hph := h8 l0 (by omega) (princC5 B G) hsm
    (fun γ m ξ hξ hne => ⟨(H3 γ m ξ hξ hne).1, (H3 γ m ξ hξ hne).2.1, hact γ m ξ hξ hne⟩) hflat

  exact h9 l0 (by omega) (princC5 B G) (2 * Aex B.h + 1/2) (tailF5 B G l0)
    ⟨({1, -1} : Finset ℤ), fun γ m hm ξ hξ => by
      by_contra hne
      rcases (H3 γ m ξ hξ hne).1 with rfl | rfl <;> simp at hm⟩
    (fun γ m ξ hξ hne => ⟨(H3 γ m ξ hξ hne).2.1, hact γ m ξ hξ hne⟩)
    (fun i γ m => (hph i).1 γ m) (fun i k N => (hph i).2 k N)
    (fun x t Y h => if_pos h) (fun x t Y h => if_neg h)

theorem pwr5_linear_harmonics : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    InWg5 B G (qsOf l0) (1/2) (W0h4 B G) →
    (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), dotProduct (nPhi5 B G γ ξ) (W0c4 B G γ ξ) = 0) →
    InWg5 B G (qsOf l0) 1 (primState5 B G).Aw → InWg5 B G (qsOf l0) 1 (primState5 B G).pw →
    InWg5 B G (qsOf l0) (1/2) (velW5 B G (primState5 B G).Aw) →
    InWg5 B G (qsOf l0) (1 - kapS) (velW5 B G (primState5 B G).Aw - W0h4 B G) →
    ∃ (g : WC) (Fl : Ext ℝ³), InWg5 B G (qsOf l0) (1 - 3 * kapS) g ∧ FlatS5 B l0 Fl ∧
      ∀ x t Y, corrOn B l0 x t →
        pwrLin B G l0 x t Y - thAvgVec (pwrLin B G l0) x t Y =
          (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) • cyl2cart x (waveV5 B G g (thetaOf x) (ptOf x t Y))
            + Fl x t Y :=
by
  intro B G hok hG
  obtain ⟨a1, h1⟩ := plin5_mode_rep B G hok hG
  obtain ⟨a4, h4⟩ := plin5_principal_support B G hok hG
  obtain ⟨a5, h5⟩ := plin5_remainder_class B G hok hG
  obtain ⟨a6, h6⟩ := plin5_tail_flat B G hok hG
  refine ⟨a1 + a4 + a5 + a6, fun l0 hl0 hW0 htr hAw hpw hvel hdiff => ?_⟩
  have hsupp := h4 l0 (by omega) hW0 htr
  have hg := h5 l0 (by omega) hW0 htr hAw hpw hvel hdiff
  have hFl := h6 l0 (by omega) hW0 hpw hsupp
  have hrep := h1 l0 (by omega) hAw hpw
  have hgc := hg
  obtain ⟨⟨Hg, hHg0, hHg⟩, -, -, hSg, -⟩ := hgc

  have hfin : ∀ ξ ∈ DomC B.h (qsOf l0), ∃ (Γ : Finset Lab) (H : Finset ℤ), (0 : ℤ) ∉ H ∧
      ∀ γ m, (γ ∉ Γ ∨ m ∉ H) → (linC5 B G - princC5 B G) γ m ξ = 0 ∧ princC5 B G γ m ξ = 0 ∧
        linC5 B G γ m ξ = 0 := by
    intro ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    obtain ⟨N, hN, Γ, hΓ⟩ := etaL_local_finite_v5 B.h hok.1 ξ hξ'.2.1
    have hS : ∀ γ, SuppW B G γ ξ → γ ∈ Γ := by
      intro γ hs
      obtain ⟨-, hts, -⟩ := hs
      exact hΓ γ ξ (mem_of_mem_nhds hN) hts
    refine ⟨Γ, insert 1 (insert (-1) Hg), ?_, ?_⟩
    · intro hmem
      rcases Finset.mem_insert.1 hmem with h | hmem
      · norm_num at h
      rcases Finset.mem_insert.1 hmem with h | h
      · norm_num at h
      · exact hHg0 h
    · intro γ m hγm
      have hgz : (linC5 B G - princC5 B G) γ m ξ = 0 := by
        by_contra hne
        have hs := hSg γ m ξ hξ hne
        rcases hγm with hγ | hm
        · exact hγ (hS γ hs)
        · have hm' : m ∉ Hg := fun h => hm (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem h))
          exact hne (by rw [hHg γ m hm']; rfl)
      have hpz : princC5 B G γ m ξ = 0 := by
        by_contra hne
        obtain ⟨hm1, hs, -⟩ := hsupp γ m ξ hξ hne
        rcases hγm with hγ | hm
        · exact hγ (hS γ hs)
        · apply hm
          rcases hm1 with rfl | rfl <;> simp
      refine ⟨hgz, hpz, ?_⟩
      have e : linC5 B G γ m ξ = (linC5 B G - princC5 B G) γ m ξ + princC5 B G γ m ξ :=
        (sub_add_cancel (linC5 B G γ m ξ) (princC5 B G γ m ξ)).symm
      rw [e, hgz, hpz, add_zero]

  have hsum : ∀ (F : Lab → ℤ → ℂ) (Γ : Finset Lab) (H : Finset ℤ),
      (∀ γ m, (γ ∉ Γ ∨ m ∉ H) → F γ m = 0) →
      ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, F γ m = ∑ γ ∈ Γ, ∑ m ∈ H, F γ m := by
    intro F Γ H hF
    have hin : ∀ γ, ∑ᶠ m : ℤ, F γ m = ∑ m ∈ H, F γ m := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      rw [Function.mem_support] at hm
      by_contra h
      exact hm (hF γ m (Or.inr (by simpa using h)))
    simp_rw [hin]
    apply finsum_eq_sum_of_support_subset
    intro γ hγ
    rw [Function.mem_support] at hγ
    by_contra h
    exact hγ (Finset.sum_eq_zero (fun m _ => hF γ m (Or.inl (by simpa using h))))

  have hadd : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ θ : ℝ, waveV5 B G (linC5 B G) θ ξ =
      waveV5 B G (linC5 B G - princC5 B G) θ ξ + waveV5 B G (princC5 B G) θ ξ := by
    intro ξ hξ θ
    obtain ⟨Γ, H, -, hz⟩ := hfin ξ hξ
    funext i
    have e1 : ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, linC5 B G γ m ξ i * ephase5 B G γ m θ ξ =
        ∑ γ ∈ Γ, ∑ m ∈ H, linC5 B G γ m ξ i * ephase5 B G γ m θ ξ :=
      hsum (fun γ m => linC5 B G γ m ξ i * ephase5 B G γ m θ ξ) Γ H (fun γ m h => by
        show linC5 B G γ m ξ i * ephase5 B G γ m θ ξ = 0
        rw [(hz γ m h).2.2]; simp)
    have e2 : ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, (linC5 B G - princC5 B G) γ m ξ i * ephase5 B G γ m θ ξ =
        ∑ γ ∈ Γ, ∑ m ∈ H, (linC5 B G - princC5 B G) γ m ξ i * ephase5 B G γ m θ ξ :=
      hsum (fun γ m => (linC5 B G - princC5 B G) γ m ξ i * ephase5 B G γ m θ ξ) Γ H (fun γ m h => by
        show (linC5 B G - princC5 B G) γ m ξ i * ephase5 B G γ m θ ξ = 0
        rw [(hz γ m h).1]; simp)
    have e3 : ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, princC5 B G γ m ξ i * ephase5 B G γ m θ ξ =
        ∑ γ ∈ Γ, ∑ m ∈ H, princC5 B G γ m ξ i * ephase5 B G γ m θ ξ :=
      hsum (fun γ m => princC5 B G γ m ξ i * ephase5 B G γ m θ ξ) Γ H (fun γ m h => by
        show princC5 B G γ m ξ i * ephase5 B G γ m θ ξ = 0
        rw [(hz γ m h).2.1]; simp)
    show (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, linC5 B G γ m ξ i * ephase5 B G γ m θ ξ).re =
      (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, (linC5 B G - princC5 B G) γ m ξ i * ephase5 B G γ m θ ξ).re +
      (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, princC5 B G γ m ξ i * ephase5 B G γ m θ ξ).re
    rw [e1, e2, e3, ← Complex.add_re, ← Finset.sum_add_distrib]
    congr 1
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    rw [← add_mul]
    congr 1
    exact (sub_add_cancel (linC5 B G γ m ξ i) (princC5 B G γ m ξ i)).symm

  have hrot : ∀ r θ z : ℝ, 0 < r → rad (rotPt r θ z) = r ∧ rotPt r θ z 2 = z := by
    intro r θ z hr
    constructor
    · have h : (rotPt r θ z) 0 ^ 2 + (rotPt r θ z) 1 ^ 2 = r ^ 2 := by
        simp [rotPt]
        rw [mul_pow, mul_pow, ← mul_add, Real.cos_sq_add_sin_sq, mul_one]
      unfold rad
      rw [h, Real.sqrt_sq hr.le]
    · simp [rotPt]
  have hframe : ∀ (y : ℝ³), 0 < rad y → ∀ (v : Fin 3 → ℝ) (a : Fin 3),
      inner ℝ (cyl2cart y v) (![eR y, eTh y, eZ] a) = v a := by
    intro y hy v a
    have hr2 : rad y ^ 2 = y 0 ^ 2 + y 1 ^ 2 := Real.sq_sqrt (by positivity)
    have hne : rad y ≠ 0 := hy.ne'
    have hs : (rad y)⁻¹ ^ 2 * (y 0 ^ 2 + y 1 ^ 2) = 1 := by
      rw [← hr2]; field_simp
    fin_cases a <;>
      simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three] <;>
      first
      | linear_combination (v 0) * hs
      | linear_combination (v 1) * hs
  have hlin : ∀ (c : ℝ) (f : ℝ → ℝ), thA (fun θ => c * f θ) = c * thA f := by
    intro c f
    simp only [thA, intervalIntegral.integral_const_mul]
    ring
  refine ⟨linC5 B G - princC5 B G, tailF5 B G l0, hg, hFl, ?_⟩
  intro x t Y hxt
  have hxt' : 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
  have hξ : ptOf x t Y ∈ DomC B.h (qsOf l0) := hxt
  have hrx : 0 < rad x := hxt'.1

  have hmean : thAvgVec (pwrLin B G l0) x t Y = 0 := by
    obtain ⟨Γ, H, hH0, hz⟩ := hfin _ hξ
    have hcomp : ∀ a : Fin 3, thA (fun θ => inner ℝ (pwrLin B G l0 (rotPt (rad x) θ (x 2)) t Y)
        (frameAt θ (ptOf x t Y) a)) = 0 := by
      intro a
      have hfun : (fun θ => inner ℝ (pwrLin B G l0 (rotPt (rad x) θ (x 2)) t Y)
          (frameAt θ (ptOf x t Y) a)) =
          fun θ => qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2)) *
            waveS5 B G (fun γ m η => linC5 B G γ m η a) (thetaOf (rotPt (rad x) θ (x 2))) (ptOf x t Y) := by
        funext θ
        obtain ⟨hr, hzz⟩ := hrot (rad x) θ (x 2) hrx
        have hc : corrOn B l0 (rotPt (rad x) θ (x 2)) t := by
          show 0 < rad (rotPt (rad x) θ (x 2)) ∧ t < 1 ∧
            simScale B.h ((rotPt (rad x) θ (x 2)) 2) (1 - t) < qsOf l0
          rw [hr, hzz]
          exact hxt'
        have hp : ptOf (rotPt (rad x) θ (x 2)) t Y = ptOf x t Y := by
          show (rad (rotPt (rad x) θ (x 2)), (rotPt (rad x) θ (x 2)) 2, t, Y) = (rad x, x 2, t, Y)
          rw [hr, hzz]
        rw [hrep _ t Y hc, hp, real_inner_smul_left]
        have hf : frameAt θ (ptOf x t Y) a =
            ![eR (rotPt (rad x) θ (x 2)), eTh (rotPt (rad x) θ (x 2)), eZ] a := rfl
        rw [hf, hframe _ (by rw [hr]; exact hrx)]
        rfl
      have h0 := (waveS5_circle_mean_zero B G (fun γ m η => linC5 B G γ m η a) (ptOf x t Y) (rad x) (x 2)
        H Γ hrx hH0 (fun γ m hm => by simp [(hz γ m (Or.inr hm)).2.2])
        (fun γ m hγ => by simp [(hz γ m (Or.inl hγ)).2.2])).2
      rw [hfun, hlin, h0, mul_zero]
    unfold thAvgVec
    have hzero : (fun a => thA (fun θ => inner ℝ (pwrLin B G l0 (rotPt (rad x) θ (x 2)) t Y)
        (frameAt θ (ptOf x t Y) a))) = fun _ => 0 := funext hcomp
    rw [hzero]
    simp [cyl2cart]
  have htail : tailF5 B G l0 x t Y = qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2)) •
      cyl2cart x (waveV5 B G (princC5 B G) (thetaOf x) (ptOf x t Y)) := if_pos hxt
  have hc : ∀ (u v : Fin 3 → ℝ), cyl2cart x (u + v) = cyl2cart x u + cyl2cart x v := by
    intro u v
    simp only [cyl2cart, Pi.add_apply, add_smul]
    abel
  rw [hmean, sub_zero, hrep x t Y hxt, hadd _ hξ, htail, hc, smul_add]

theorem mode_curl_axis_v5 : ∀ (h e t : ℝ) (Y0 : ℝ × ℝ) (n : ℤ) (C : Cyl → (Fin 3 → ℂ)) (r z : ℝ), SimScaleProps h → t < 1 → 0 < r → DifferentiableAt ℝ C (r, z, t, Yph h r t + Y0) → (∀ a : Fin 3, inner ℝ (curl3 (modeF5 h e t Y0 n C) (rotPt r 0 z)) (frameAt 0 (r, z, t, Yph h r t + Y0) a) = qC h (r, z, t, Yph h r t + Y0) ^ e * (axV5 h e n C (r, z, t, Yph h r t + Y0) a).re) ∧ axV5 h e n (fun η i => Complex.I * C η i) (r, z, t, Yph h r t + Y0) = fun i => Complex.I * axV5 h e n C (r, z, t, Yph h r t + Y0) i :=
by
  intro h e t Y0 n C r z hS ht hr hC
  have hr0 : r ≠ 0 := hr.ne'
  have ht1 : (0:ℝ) < 1 - t := by linarith
  obtain ⟨hQpos, -⟩ := hS.1 z (1 - t) ht1
  have hQne : simScale h z (1 - t) ≠ 0 := hQpos.ne'
  have hSo : (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) ∈ nhds (z, 1 - t) :=
    (isOpen_univ.prod isOpen_Ioi).mem_nhds ⟨mem_univ _, ht1⟩
  have hSd : DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, 1 - t) :=
    (hS.2.2.2.1.contDiffAt hSo).differentiableAt (by simp)
  have hSline : ∀ w : ℝ × ℝ, HasDerivAt
      (fun s : ℝ => simScale h ((z, 1 - t) + s • w).1 ((z, 1 - t) + s • w).2)
      (fderiv ℝ (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, 1 - t) w) 0 := by
    intro w
    have hl : HasDerivAt (fun s : ℝ => (z, 1 - t) + s • w) w 0 :=
      (((hasDerivAt_id' (0:ℝ)).smul_const w).const_add (z, 1 - t)).congr_deriv (one_smul ℝ w)
    exact hSd.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hl (by simp)
  have hL : dZ (fun η : Cyl => Real.log (qC h η)) (r, z, t, Yph h r t + Y0) =
      fderiv ℝ (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, 1 - t) (1, 0) / simScale h z (1 - t) := by
    have hqd : DifferentiableAt ℝ (fun η : Cyl => qC h η) (r, z, t, Yph h r t + Y0) := by
      have hf : DifferentiableAt ℝ (fun η : Cyl => (η.2.1, 1 - η.2.2.1)) (r, z, t, Yph h r t + Y0) := by
        fun_prop
      exact DifferentiableAt.comp (g := fun w : ℝ × ℝ => simScale h w.1 w.2)
        (f := fun η : Cyl => (η.2.1, 1 - η.2.2.1)) _ hSd hf
    have hld := hqd.log hQne
    have hl : HasDerivAt (fun s : ℝ => ((r, z, t, Yph h r t + Y0) : Cyl) +
        s • ((0:ℝ), (1:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ)))) ((0:ℝ), (1:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ))) 0 :=
      (((hasDerivAt_id' (0:ℝ)).smul_const _).const_add _).congr_deriv (one_smul ℝ _)
    have h1 := hld.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hl (by simp)
    have h2 := (hSline (1, 0)).log (by simpa using hQne)
    have h3 : HasDerivAt (fun s : ℝ => Real.log (qC h (((r, z, t, Yph h r t + Y0) : Cyl) +
        s • ((0:ℝ), (1:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ))))))
        (fderiv ℝ (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, 1 - t) (1, 0) / simScale h z (1 - t)) 0 := by
      refine (h2.congr_deriv (by simp)).congr_of_eventuallyEq (Filter.Eventually.of_forall fun s => ?_)
      simp [qC]
    exact h1.unique h3
  have hx00 : rotPt r 0 z 0 = r := by simp [rotPt]
  have hx01 : rotPt r 0 z 1 = 0 := by simp [rotPt]
  have hx02 : rotPt r 0 z 2 = z := by simp [rotPt]
  have hrad0 : rad (rotPt r 0 z) = r := by
    simp only [rad, hx00, hx01]; simp [Real.sqrt_sq hr.le]
  have hptx0 : ptOf (rotPt r 0 z) t (Yph h (rad (rotPt r 0 z)) t + Y0) = (r, z, t, Yph h r t + Y0) := by
    simp only [ptOf, hrad0, hx02]
  have hMdiff : ∀ (c : Cyl → (Fin 3 → ℂ)) (x : ℝ³), 0 < rad x →
      DifferentiableAt ℝ c (ptOf x t (Yph h (rad x) t + Y0)) →
      DifferentiableAt ℝ (modeF5 h e t Y0 n c) x := by
    intro c x hrad hc
    have hcoord : ∀ (i : Fin 3) (y : ℝ³), DifferentiableAt ℝ (fun w : ℝ³ => w i) y := by
      intro i y
      have h0 : DifferentiableAt ℝ (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) i) y :=
        ContinuousLinearMap.differentiableAt _
      rwa [EuclideanSpace.coe_proj] at h0
    have hradpos : 0 < x 0 ^ 2 + x 1 ^ 2 := Real.sqrt_pos.mp hrad
    have hradD : DifferentiableAt ℝ rad x := by
      have h1 : DifferentiableAt ℝ (fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2) x :=
        ((hcoord 0 x).pow 2).add ((hcoord 1 x).pow 2)
      exact h1.sqrt hradpos.ne'
    have hinv : DifferentiableAt ℝ (fun y : ℝ³ => (rad y)⁻¹) x := hradD.inv hrad.ne'
    have hq : DifferentiableAt ℝ (fun y : ℝ³ => qC h (ptOf y t (Yph h (rad y) t + Y0)) ^ e) x := by
      have hSo' : (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) ∈ nhds (x 2, 1 - t) :=
        (isOpen_univ.prod isOpen_Ioi).mem_nhds ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩
      have hSd' : DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale h w.1 w.2) (x 2, 1 - t) :=
        (hS.2.2.2.1.contDiffAt hSo').differentiableAt (by simp)
      have hgd : DifferentiableAt ℝ (fun y : ℝ³ => (y 2, 1 - t)) x :=
        (hcoord 2 x).prodMk (differentiableAt_const _)
      have hcomp : DifferentiableAt ℝ (fun y : ℝ³ => simScale h (y 2) (1 - t)) x :=
        DifferentiableAt.comp (g := fun w : ℝ × ℝ => simScale h w.1 w.2)
          (f := fun y : ℝ³ => (y 2, 1 - t)) x hSd' hgd
      have hpos : simScale h (x 2) (1 - t) ≠ 0 := (hS.1 (x 2) (1 - t) (by linarith)).1.ne'
      exact hcomp.rpow_const (Or.inl hpos)
    have hP : DifferentiableAt ℝ (fun y : ℝ³ => ptOf y t (Yph h (rad y) t + Y0)) x := by
      have h4 : DifferentiableAt ℝ (fun y : ℝ³ => Yph h (rad y) t + Y0) x := by
        have h5 := ((hradD.rpow_const (p := drx h) (Or.inl hrad.ne')).smul_const vrv).add_const (t • vtv)
        exact h5.add_const Y0
      exact hradD.prodMk ((hcoord 2 x).prodMk ((differentiableAt_const t).prodMk h4))
    have hnormAll : ∀ y : ℝ³, ‖(⟨y 0, y 1⟩ : ℂ)‖ = rad y := by
      intro y
      rw [Complex.norm_eq_sqrt_sq_add_sq]
      rfl
    have hE : DifferentiableAt ℝ
        (fun y : ℝ³ => Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))) x := by
      obtain ⟨g, hg⟩ : ∃ g : ℝ³ → ℂ, g = fun y => ((rad y)⁻¹ : ℝ) • (⟨y 0, y 1⟩ : ℂ) := ⟨_, rfl⟩
      have hz : DifferentiableAt ℝ (fun y : ℝ³ => (⟨y 0, y 1⟩ : ℂ)) x := by
        have e1 : (fun y : ℝ³ => (⟨y 0, y 1⟩ : ℂ)) =
            fun y => Complex.ofRealCLM (y 0) + Complex.ofRealCLM (y 1) * Complex.I := by
          funext y
          rw [Complex.mk_eq_add_mul_I]
          simp
        rw [e1]
        exact (Complex.ofRealCLM.differentiableAt.comp x (hcoord 0 x)).add
          ((Complex.ofRealCLM.differentiableAt.comp x (hcoord 1 x)).mul_const Complex.I)
      have hgD : DifferentiableAt ℝ g x := by
        rw [hg]
        exact hinv.smul hz
      have hgx : g x ≠ 0 := by
        rw [hg]
        refine smul_ne_zero (inv_ne_zero hrad.ne') ?_
        intro h0
        have h1 := hnormAll x
        rw [h0, norm_zero] at h1
        linarith
      have hpow : DifferentiableAt ℂ (fun u : ℂ => u ^ n) (g x) :=
        differentiableAt_zpow.mpr (Or.inl hgx)
      have hG : DifferentiableAt ℝ (fun y => g y ^ n) x := (hpow.restrictScalars ℝ).comp x hgD
      refine hG.congr_of_eventuallyEq ?_
      filter_upwards [hradD.continuousAt (Ioi_mem_nhds hrad)] with y hy
      have hy' : 0 < rad y := hy
      have hne : ((rad y : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hy'.ne'
      have key := Complex.norm_mul_exp_arg_mul_I (⟨y 0, y 1⟩ : ℂ)
      rw [hnormAll y] at key
      have hexp : Complex.exp (((thetaOf y : ℝ) : ℂ) * Complex.I) = g y := by
        rw [hg]
        show _ = ((rad y)⁻¹ : ℝ) • (⟨y 0, y 1⟩ : ℂ)
        rw [Complex.real_smul, Complex.ofReal_inv, eq_inv_mul_iff_mul_eq₀ hne]
        exact key
      calc Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))
          = Complex.exp ((n : ℂ) * ((thetaOf y : ℂ) * Complex.I)) := by
            congr 1
            ring
        _ = Complex.exp ((thetaOf y : ℂ) * Complex.I) ^ n := Complex.exp_int_mul _ _
        _ = g y ^ n := by rw [hexp]
    have hcP : DifferentiableAt ℝ (fun y : ℝ³ => c (ptOf y t (Yph h (rad y) t + Y0))) x :=
      hc.comp x hP
    have hv : ∀ i : Fin 3, DifferentiableAt ℝ (fun y : ℝ³ =>
        (c (ptOf y t (Yph h (rad y) t + Y0)) i *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re) x := by
      intro i
      have h1 : DifferentiableAt ℝ (fun y : ℝ³ => c (ptOf y t (Yph h (rad y) t + Y0)) i) x :=
        differentiableAt_pi.1 hcP i
      have h2 := h1.mul hE
      exact Complex.reCLM.differentiableAt.comp x h2
    have heR : DifferentiableAt ℝ eR x := by
      have h1 : DifferentiableAt ℝ radVec x :=
        ((hcoord 0 x).smul_const _).add ((hcoord 1 x).smul_const _)
      exact hinv.smul h1
    have heTh : DifferentiableAt ℝ eTh x := by
      have h1 : DifferentiableAt ℝ azVec x :=
        ((hcoord 1 x).neg.smul_const _).add ((hcoord 0 x).smul_const _)
      exact hinv.smul h1
    have hcyl : DifferentiableAt ℝ (fun y : ℝ³ => cyl2cart y (fun i =>
        (c (ptOf y t (Yph h (rad y) t + Y0)) i *
          Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re)) x :=
      (((hv 0).smul heR).add ((hv 1).smul heTh)).add ((hv 2).smul_const eZ)
    exact hq.smul hcyl
  have hMd : DifferentiableAt ℝ (modeF5 h e t Y0 n C) (rotPt r 0 z) :=
    hMdiff C _ (by rw [hrad0]; exact hr) (by rw [hptx0]; exact hC)
  obtain ⟨Qf, hQf⟩ : ∃ Qf : ℝ³ → ℝ, ∀ y, Qf y = qC h (ptOf y t (Yph h (rad y) t + Y0)) ^ e :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : ℝ³ → Fin 3 → ℝ, ∀ y i, G y i = (C (ptOf y t (Yph h (rad y) t + Y0)) i *
      Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re := ⟨_, fun _ _ => rfl⟩
  have hMc : ∀ y : ℝ³, modeF5 h e t Y0 n C y 0 =
        Qf y * (G y 0 * ((rad y)⁻¹ * y 0) - G y 1 * ((rad y)⁻¹ * y 1)) ∧
      modeF5 h e t Y0 n C y 1 = Qf y * (G y 0 * ((rad y)⁻¹ * y 1) + G y 1 * ((rad y)⁻¹ * y 0)) ∧
      modeF5 h e t Y0 n C y 2 = Qf y * G y 2 := by
    intro y
    simp only [hQf, hG]
    refine ⟨?_, ?_, ?_⟩ <;> simp [modeF5, cyl2cart, eR, eTh, eZ, radVec, azVec] <;> ring
  have hnormAll : ∀ y : ℝ³, ‖(⟨y 0, y 1⟩ : ℂ)‖ = rad y := by
    intro y
    rw [Complex.norm_eq_sqrt_sq_add_sq]
    rfl
  obtain ⟨gd, hgd⟩ : ∃ gd : ℝ³ → Fin 3 → ℝ, ∀ v i, gd v i =
      ((v 0) • dR h (fun η => C η i) (r, z, t, Yph h r t + Y0) +
        (v 2) • dZ (fun η => C η i) (r, z, t, Yph h r t + Y0) +
        C (r, z, t, Yph h r t + Y0) i * ((n : ℂ) * (((v 1 / r : ℝ) : ℂ) * Complex.I))).re :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨qd, hqd⟩ : ∃ qd : ℝ³ → ℝ, ∀ v, qd v = fderiv ℝ (fun w : ℝ × ℝ => simScale h w.1 w.2)
      (z, 1 - t) (v 2, 0) * e * simScale h z (1 - t) ^ (e - 1) := ⟨_, fun _ => rfl⟩
  have hD : ∀ v : ℝ³,
      fderiv ℝ (modeF5 h e t Y0 n C) (rotPt r 0 z) v 0 = qd v * (C (r, z, t, Yph h r t + Y0) 0).re +
        simScale h z (1 - t) ^ e * (gd v 0 - (C (r, z, t, Yph h r t + Y0) 1).re * (v 1 / r)) ∧
      fderiv ℝ (modeF5 h e t Y0 n C) (rotPt r 0 z) v 1 = qd v * (C (r, z, t, Yph h r t + Y0) 1).re +
        simScale h z (1 - t) ^ e * ((C (r, z, t, Yph h r t + Y0) 0).re * (v 1 / r) + gd v 1) ∧
      fderiv ℝ (modeF5 h e t Y0 n C) (rotPt r 0 z) v 2 = qd v * (C (r, z, t, Yph h r t + Y0) 2).re +
        simScale h z (1 - t) ^ e * gd v 2 := by
    intro v
    obtain ⟨γ, hγ⟩ : ∃ γ : ℝ → ℝ³, γ = fun s => rotPt r 0 z + s • v := ⟨_, rfl⟩
    have hγk : ∀ (s : ℝ) (k : Fin 3), γ s k = rotPt r 0 z k + s * v k := by
      intro s k; rw [hγ]; simp
    have hγ00 : γ 0 0 = r := by rw [hγk, hx00]; ring
    have hγ01 : γ 0 1 = 0 := by rw [hγk, hx01]; ring
    have hγ02 : γ 0 2 = z := by rw [hγk, hx02]; ring
    have hγd : ∀ k : Fin 3, HasDerivAt (fun s => γ s k) (v k) 0 := by
      intro k
      have e1 : (fun s => γ s k) = fun s => rotPt r 0 z k + s * v k := funext fun s => hγk s k
      rw [e1]
      exact (((hasDerivAt_id' (0:ℝ)).mul_const (v k)).const_add _).congr_deriv (one_mul _)
    have hρ0 : rad (γ 0) = r := by
      simp only [rad, hγ00, hγ01]; simp [Real.sqrt_sq hr.le]
    have hρ : HasDerivAt (fun s => rad (γ s)) (v 0) 0 := by
      have e1 : (fun s => rad (γ s)) = fun s => Real.sqrt (γ s 0 * γ s 0 + γ s 1 * γ s 1) := by
        funext s; simp only [rad, pow_two]
      rw [e1]
      have h1 := (((hγd 0).mul (hγd 0)).add ((hγd 1).mul (hγd 1))).sqrt
        (by simp only [Pi.add_apply, Pi.mul_apply, hγ00, hγ01]; simp [hr0])
      refine h1.congr_deriv ?_
      simp only [Pi.add_apply, Pi.mul_apply, hγ00, hγ01]
      have : Real.sqrt (r * r + 0 * 0) = r := by simp [Real.sqrt_mul_self hr.le]
      rw [this]; field_simp; try ring
    have hρi : HasDerivAt (fun s => (rad (γ s))⁻¹) (-(v 0) / r ^ 2) 0 := by
      have h1 := hρ.inv (by rw [hρ0]; exact hr0)
      rw [hρ0] at h1
      exact h1
    have ha : HasDerivAt (fun s => (rad (γ s))⁻¹ * γ s 0) 0 0 := by
      refine (hρi.mul (hγd 0)).congr_deriv ?_
      rw [hγ00, hρ0]; field_simp; try ring
    have hb : HasDerivAt (fun s => (rad (γ s))⁻¹ * γ s 1) (v 1 / r) 0 := by
      refine (hρi.mul (hγd 1)).congr_deriv ?_
      rw [hγ01, hρ0]; field_simp; try ring
    have ha0 : (rad (γ 0))⁻¹ * γ 0 0 = 1 := by rw [hρ0, hγ00]; field_simp
    have hb0 : (rad (γ 0))⁻¹ * γ 0 1 = 0 := by rw [hγ01]; ring
    have hQv : Qf (γ 0) = simScale h z (1 - t) ^ e := by
      rw [hQf]; simp only [qC, ptOf, hγ02]
    have hQd : HasDerivAt (fun s => Qf (γ s)) (qd v) 0 := by
      have h1 := (hSline (v 2, 0)).rpow_const (p := e) (Or.inl (by simpa using hQne))
      rw [hqd]
      refine (h1.congr_deriv (by simp)).congr_of_eventuallyEq (Filter.Eventually.of_forall fun s => ?_)
      simp only [hQf, qC, ptOf, hγk, hx02]
      simp
    obtain ⟨u, hu⟩ : ∃ u : ℝ → ℂ, u = fun s => (((rad (γ s))⁻¹ : ℝ) : ℂ) *
        (((γ s 0 : ℝ) : ℂ) + ((γ s 1 : ℝ) : ℂ) * Complex.I) := ⟨_, rfl⟩
    have hu0 : u 0 = 1 := by
      rw [hu]; simp only [hρ0, hγ00, hγ01]; simp [hr0]
    have hud : HasDerivAt u (((v 1 / r : ℝ) : ℂ) * Complex.I) 0 := by
      rw [hu]
      refine (hρi.ofReal_comp.mul ((hγd 0).ofReal_comp.add
        ((hγd 1).ofReal_comp.mul_const Complex.I))).congr_deriv ?_
      have hrC : (r : ℂ) ≠ 0 := by exact_mod_cast hr0
      simp only [Pi.add_apply, hρ0, hγ00, hγ01]; push_cast; field_simp; try ring
    have hev : ∀ᶠ s in nhds (0:ℝ), Complex.exp (Complex.I * (n : ℂ) * (thetaOf (γ s) : ℂ)) = u s ^ n := by
      filter_upwards [hρ.continuousAt (Ioi_mem_nhds (show (0:ℝ) < rad (γ 0) by rw [hρ0]; exact hr))]
        with s hs
      have hs' : 0 < rad (γ s) := hs
      have hne : ((rad (γ s) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hs'.ne'
      have key := Complex.norm_mul_exp_arg_mul_I (⟨γ s 0, γ s 1⟩ : ℂ)
      rw [hnormAll (γ s)] at key
      have hexp : Complex.exp (((thetaOf (γ s) : ℝ) : ℂ) * Complex.I) = u s := by
        rw [hu]
        show _ = (((rad (γ s))⁻¹ : ℝ) : ℂ) * (((γ s 0 : ℝ) : ℂ) + ((γ s 1 : ℝ) : ℂ) * Complex.I)
        rw [← Complex.mk_eq_add_mul_I, Complex.ofReal_inv, eq_inv_mul_iff_mul_eq₀ hne]
        exact key
      calc Complex.exp (Complex.I * (n : ℂ) * (thetaOf (γ s) : ℂ))
          = Complex.exp ((n : ℂ) * ((thetaOf (γ s) : ℂ) * Complex.I)) := by congr 1; ring
        _ = Complex.exp ((thetaOf (γ s) : ℂ) * Complex.I) ^ n := Complex.exp_int_mul _ _
        _ = u s ^ n := by rw [hexp]
    have hΦ0 : Complex.exp (Complex.I * (n : ℂ) * (thetaOf (γ 0) : ℂ)) = 1 := by
      rw [hev.self_of_nhds, hu0, one_zpow]
    have hΦ : HasDerivAt (fun s => Complex.exp (Complex.I * (n : ℂ) * (thetaOf (γ s) : ℂ)))
        ((n : ℂ) * (((v 1 / r : ℝ) : ℂ) * Complex.I)) 0 := by
      have h1 := (hasDerivAt_zpow n (u 0) (Or.inl (by rw [hu0]; exact one_ne_zero))).comp (0:ℝ) hud
      rw [hu0, one_zpow, mul_one] at h1
      exact h1.congr_of_eventuallyEq hev
    have hP0 : ptOf (γ 0) t (Yph h (rad (γ 0)) t + Y0) = (r, z, t, Yph h r t + Y0) := by
      simp only [ptOf, hρ0, hγ02]
    have hP : HasDerivAt (fun s => ptOf (γ s) t (Yph h (rad (γ s)) t + Y0))
        (v 0 • ((1:ℝ), (0:ℝ), (0:ℝ), (drx h * r ^ (drx h - 1)) • vrv) +
          v 2 • ((0:ℝ), (1:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ)))) 0 := by
      have hY : HasDerivAt (fun s => Yph h (rad (γ s)) t + Y0) ((v 0 * drx h * r ^ (drx h - 1)) • vrv) 0 := by
        have h1 := ((hρ.rpow_const (p := drx h) (Or.inl (by rw [hρ0]; exact hr0))).smul_const vrv).add_const
          (t • vtv)
        have h2 := h1.add_const Y0
        rw [hρ0] at h2
        exact h2
      have h3 := hρ.prodMk ((hγd 2).prodMk ((hasDerivAt_const (0:ℝ) t).prodMk hY))
      refine h3.congr_deriv ?_
      simp [smul_smul, mul_assoc]
    have hc : ∀ i : Fin 3, HasDerivAt (fun s => C (ptOf (γ s) t (Yph h (rad (γ s)) t + Y0)) i)
        (v 0 • dR h (fun η => C η i) (r, z, t, Yph h r t + Y0) +
          v 2 • dZ (fun η => C η i) (r, z, t, Yph h r t + Y0)) 0 := by
      intro i
      have hCi : DifferentiableAt ℝ (fun η => C η i) (r, z, t, Yph h r t + Y0) := differentiableAt_pi.1 hC i
      have h1 := hCi.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hP hP0.symm
      rw [map_add, map_smul, map_smul] at h1
      exact h1
    have hGv : ∀ i, G (γ 0) i = (C (r, z, t, Yph h r t + Y0) i).re := by
      intro i; rw [hG, hP0, hΦ0, mul_one]
    have hGd : ∀ i : Fin 3, HasDerivAt (fun s => G (γ s) i) (gd v i) 0 := by
      intro i
      have h1 := Complex.reCLM.hasFDerivAt.comp_hasDerivAt (0:ℝ) ((hc i).mul hΦ)
      rw [Complex.reCLM_apply, hP0, hΦ0, mul_one] at h1
      rw [hgd]
      refine h1.congr_of_eventuallyEq (Filter.Eventually.of_forall fun s => ?_)
      simp only [hG, Function.comp_apply, Complex.reCLM_apply, Pi.mul_apply]
    have hline : ∀ k : Fin 3, HasDerivAt (fun s => modeF5 h e t Y0 n C (γ s) k)
        (fderiv ℝ (modeF5 h e t Y0 n C) (rotPt r 0 z) v k) 0 := by
      intro k
      have hγl : HasDerivAt γ v 0 := by
        rw [hγ]
        exact (((hasDerivAt_id' (0:ℝ)).smul_const v).const_add _).congr_deriv (one_smul ℝ v)
      have h0 : HasFDerivAt (modeF5 h e t Y0 n C) (fderiv ℝ (modeF5 h e t Y0 n C) (rotPt r 0 z)) (γ 0) := by
        rw [hγ]; simp only [zero_smul, add_zero]; exact hMd.hasFDerivAt
      exact (EuclideanSpace.proj k : ℝ³ →L[ℝ] ℝ).hasFDerivAt.comp_hasDerivAt (0:ℝ)
        (h0.comp_hasDerivAt (0:ℝ) hγl)
    have e0 : (fun s => modeF5 h e t Y0 n C (γ s) 0) = fun s => Qf (γ s) *
        (G (γ s) 0 * ((rad (γ s))⁻¹ * γ s 0) - G (γ s) 1 * ((rad (γ s))⁻¹ * γ s 1)) :=
      funext fun s => (hMc (γ s)).1
    have e1 : (fun s => modeF5 h e t Y0 n C (γ s) 1) = fun s => Qf (γ s) *
        (G (γ s) 0 * ((rad (γ s))⁻¹ * γ s 1) + G (γ s) 1 * ((rad (γ s))⁻¹ * γ s 0)) :=
      funext fun s => (hMc (γ s)).2.1
    have e2 : (fun s => modeF5 h e t Y0 n C (γ s) 2) = fun s => Qf (γ s) * G (γ s) 2 :=
      funext fun s => (hMc (γ s)).2.2
    have d0 := hQd.mul (((hGd 0).mul ha).sub ((hGd 1).mul hb))
    have d1 := hQd.mul (((hGd 0).mul hb).add ((hGd 1).mul ha))
    have d2 := hQd.mul (hGd 2)
    have l0 := hline 0
    rw [e0] at l0
    have l1 := hline 1
    rw [e1] at l1
    have l2 := hline 2
    rw [e2] at l2
    rw [l0.unique d0, l1.unique d1, l2.unique d2]
    refine ⟨?_, ?_, ?_⟩
    all_goals simp only [Pi.mul_apply, Pi.sub_apply, Pi.add_apply, hQv, hGv, ha0, hb0]
    all_goals ring_nf
  have heR : eR (rotPt r 0 z) = EuclideanSpace.single 0 1 := by
    simp only [eR, radVec, hrad0, hx00, hx01, zero_smul, add_zero, smul_smul, inv_mul_cancel₀ hr0, one_smul]
  have heTh : eTh (rotPt r 0 z) = EuclideanSpace.single 1 1 := by
    simp only [eTh, azVec, hrad0, hx00, hx01, neg_zero, zero_smul, zero_add, smul_smul,
      inv_mul_cancel₀ hr0, one_smul]
  have hfr : ∀ a : Fin 3, frameAt 0 (r, z, t, Yph h r t + Y0) a = EuclideanSpace.single a 1 := by
    intro a
    fin_cases a
    · exact heR
    · exact heTh
    · show eZ = _
      rfl
  refine ⟨fun a => ?_, ?_⟩
  · rw [hfr a, EuclideanSpace.inner_single_right, one_mul, conj_trivial]
    have hq : qC h (r, z, t, Yph h r t + Y0) = simScale h z (1 - t) := rfl
    rw [hq]
    have hf00 : fderiv ℝ (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, 1 - t) (0, 0) = 0 := by
      rw [Prod.mk_zero_zero, map_zero]
    obtain ⟨A0, A1, A2⟩ := hD (EuclideanSpace.single 0 1)
    obtain ⟨B0, B1, B2⟩ := hD (EuclideanSpace.single 1 1)
    obtain ⟨E0, E1, E2⟩ := hD (EuclideanSpace.single 2 1)
    fin_cases a
    · simp [curl3]
      rw [B2, E1]
      simp only [hgd, hqd, axV5]
      simp [hL, hf00, Prod.mk_zero_zero, Complex.mul_re, Complex.div_ofReal_re, Real.rpow_sub_one hQne]
      field_simp
      ring
    · simp [curl3]
      rw [E0, A2]
      simp only [hgd, hqd, axV5]
      simp [hL, hf00, Prod.mk_zero_zero, Complex.mul_re, Complex.div_ofReal_re, Real.rpow_sub_one hQne]
      field_simp
      ring
    · simp [curl3]
      rw [A1, B0]
      simp only [hgd, hqd, axV5]
      simp [hL, hf00, Prod.mk_zero_zero, Complex.mul_re, Complex.div_ofReal_re, Real.rpow_sub_one hQne]
      field_simp
      ring
  · have hCi : ∀ i, DifferentiableAt ℝ (fun η => C η i) (r, z, t, Yph h r t + Y0) :=
      fun i => differentiableAt_pi.1 hC i
    have hR : ∀ i, dR h (fun η => Complex.I * C η i) (r, z, t, Yph h r t + Y0) =
        Complex.I * dR h (fun η => C η i) (r, z, t, Yph h r t + Y0) := by
      intro i; simp only [dR]; rw [fderiv_const_mul (hCi i)]; rfl
    have hZ : ∀ i, dZ (fun η => Complex.I * C η i) (r, z, t, Yph h r t + Y0) =
        Complex.I * dZ (fun η => C η i) (r, z, t, Yph h r t + Y0) := by
      intro i; simp only [dZ]; rw [fderiv_const_mul (hCi i)]; rfl
    funext i
    fin_cases i <;> simp [axV5, hR, hZ] <;> ring

theorem wmo_phase_deriv_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (qs α : ℝ) (c : WC), qs ≤ B.qB → InWg5 B G qs α c → ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h qs, ∀ i : Fin 3, dR B.h (fun η => modeCoef5 B G c γ m η i) ξ = (dR B.h (fun η => c γ m η i) ξ + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) * ((dR B.h (phiL5 B G γ) ξ : ℝ) : ℂ) * c γ m ξ i) * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) ∧ dZ (fun η => modeCoef5 B G c γ m η i) ξ = (dZ (fun η => c γ m η i) ξ + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) * ((dZ (phiL5 B G γ) ξ : ℝ) : ℂ) * c γ m ξ i) * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) :=
by
  intro B G hok hG qs α c hqs hc γ m ξ hξ i

  have hcalc : ∀ (f : Cyl → ℂ) (φ : Cyl → ℝ) (a b : ℂ), DifferentiableAt ℝ f ξ →
      DifferentiableAt ℝ φ ξ → ∀ v : Cyl,
      fderiv ℝ (fun η => f η * Complex.exp (a * (b * (φ η : ℂ)))) ξ v =
        (fderiv ℝ f ξ v + a * b * ((fderiv ℝ φ ξ v : ℝ) : ℂ) * f ξ) *
          Complex.exp (a * (b * (φ ξ : ℂ))) := by
    intro f φ a b hf hφ v
    have hcst : HasFDerivAt (fun η => ((φ η : ℝ) : ℂ)) (Complex.ofRealCLM.comp (fderiv ℝ φ ξ)) ξ := by
      have h0 := Complex.ofRealCLM.hasFDerivAt.comp ξ hφ.hasFDerivAt
      exact h0
    have hL := (hcst.const_mul b).const_mul a
    have hE := hL.cexp
    have hP := hf.hasFDerivAt.mul hE
    rw [show (fun η => f η * Complex.exp (a * (b * (φ η : ℂ)))) =
      (f * fun x => Complex.exp (a * (b * (φ x : ℂ)))) from rfl, hP.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.comp_apply, Complex.ofRealCLM_apply, smul_eq_mul]
    ring

  have hDopen : IsOpen (DomC B.h qs) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc' : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc'
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio qs := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hDn : DomC B.h qs ∈ nhds ξ := hDopen.mem_nhds hξ
  obtain ⟨hr, ht, hqξ⟩ := id hξ
  have hamp : DifferentiableAt ℝ (c γ m) ξ :=
    ((hc.2.1 γ m).contDiffAt hDn).differentiableAt (by norm_num)
  have hci : DifferentiableAt ℝ (fun η => c γ m η i) ξ := differentiableAt_pi.1 hamp i

  have hdich : (c γ m =ᶠ[nhds ξ] fun _ => (0 : Fin 3 → ℂ)) ∨
      DifferentiableAt ℝ (phiL5 B G γ) ξ := by
    set v : Cyl → ℝ × ℝ := fun η => Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ with hv
    have hvc : Continuous v := by
      rw [hv]
      unfold Jpow
      fun_prop
    set U : Set Cyl := DomC B.h qs ∩ {η | |(v η).1 - (v ξ).1| < 1/8} ∩
      {η | |(v η).2 - (v ξ).2| < 1/8} with hU
    have hUo : IsOpen U :=
      (hDopen.inter (isOpen_lt ((hvc.fst.sub continuous_const).abs) continuous_const)).inter
        (isOpen_lt ((hvc.snd.sub continuous_const).abs) continuous_const)
    have hξU : ξ ∈ U := by
      refine ⟨⟨hξ, ?_⟩, ?_⟩
      · show |(v ξ).1 - (v ξ).1| < 1/8
        rw [sub_self, abs_zero]; norm_num
      · show |(v ξ).2 - (v ξ).2| < 1/8
        rw [sub_self, abs_zero]; norm_num
    have hUn : U ∈ nhds ξ := hUo.mem_nhds hξU
    by_cases hA : ∀ η ∈ U, c γ m η = 0
    · exact Or.inl (Filter.eventuallyEq_of_mem hUn hA)
    · right
      push_neg at hA
      obtain ⟨η1, hη1U, hη1⟩ := hA
      have hη1D : η1 ∈ DomC B.h qs := hη1U.1.1
      obtain ⟨-, -, hxi, het, -, -⟩ := hc.2.2.2.1 γ m η1 hη1D hη1
      have hr0 : G.r0 ≤ 1/100 := hG.1.2.1
      have hb0 : 0 ≤ bgc := by unfold bgc; linarith [Real.one_lt_sqrt_two]
      have hb1 : bgc ≤ 1 := by
        unfold bgc
        nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
      have hden : (1 + bgc ^ 2) * (1 + bgc ^ 2)⁻¹ = 1 := mul_inv_cancel₀ (by positivity)
      have id1 : ∀ w : ℝ × ℝ, w.1 = lamR w + bgc * lamT w := by
        intro w
        simp only [lamR, lamT, div_eq_mul_inv]
        linear_combination (-w.1) * hden
      have id2 : ∀ w : ℝ × ℝ, w.2 = -(bgc * lamR w) + lamT w := by
        intro w
        simp only [lamR, lamT, div_eq_mul_inv]
        linear_combination (-w.2) * hden
      have key : ∀ (R T : ℝ), |R| ≤ G.r0 / 4 → |T| ≤ G.r0 →
          |R + bgc * T| ≤ 1/80 ∧ |-(bgc * R) + T| ≤ 1/80 := by
        intro R T hR hT
        obtain ⟨hR1, hR2⟩ := abs_le.mp hR
        obtain ⟨hT1, hT2⟩ := abs_le.mp hT
        have hr0n : 0 ≤ G.r0 := le_trans (abs_nonneg _) hT
        have e1 : bgc * T ≤ G.r0 := by
          nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hT2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
        have e2 : -G.r0 ≤ bgc * T := by
          nlinarith [mul_nonneg hb0 (show 0 ≤ T + G.r0 by linarith),
            mul_nonneg (sub_nonneg.mpr hb1) hr0n]
        have e3 : bgc * R ≤ G.r0 / 4 := by
          nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hR2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
        have e4 : -(G.r0 / 4) ≤ bgc * R := by
          nlinarith [mul_nonneg hb0 (show 0 ≤ R + G.r0 / 4 by linarith),
            mul_nonneg (sub_nonneg.mpr hb1) hr0n]
        exact ⟨abs_le.mpr ⟨by linarith, by linarith⟩, abs_le.mpr ⟨by linarith, by linarith⟩⟩
      have hround : ∀ (x : ℝ) (k : ℤ), |x - k| < 1/2 → round x = k := by
        intro x k hk
        rw [round_eq, Int.floor_eq_iff]
        obtain ⟨h1, h2⟩ := abs_lt.mp hk
        constructor <;> linarith
      have hw1 : |lamR (frac0 (v η1))| ≤ G.r0 / 4 := hxi
      have hw2 : |lamT (frac0 (v η1))| ≤ G.r0 := het
      have hw := key _ _ hw1 hw2
      have ex1 : (v η1).1 - ((round (v η1).1 : ℤ) : ℝ) =
          lamR (frac0 (v η1)) + bgc * lamT (frac0 (v η1)) := id1 (frac0 (v η1))
      have ex2 : (v η1).2 - ((round (v η1).2 : ℤ) : ℝ) =
          -(bgc * lamR (frac0 (v η1))) + lamT (frac0 (v η1)) := id2 (frac0 (v η1))
      have hx1 : |(v η1).1 - ((round (v η1).1 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex1]; exact hw.1
      have hx2 : |(v η1).2 - ((round (v η1).2 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex2]; exact hw.2
