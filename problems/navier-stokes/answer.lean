    χc (η : ℂ) = ((axChi h j0 σ η : ℝ) : ℂ) ∧ ζc (η : ℂ) = ((axZeta h j0 σ η : ℝ) : ℂ) ∧
    zc (η : ℂ) = ((axZs h j0 Pax η / (1 - 2 * h * η ^ 2) : ℝ) : ℂ) ∧
