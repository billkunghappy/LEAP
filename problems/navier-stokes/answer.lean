        congrFun (congrArg deriv hAvg) e
      exact h1.trans (congrFun (deriv_const_mul_field' (v := fun e => profRadInt Un X e) X⁻¹) e)
    refine (hs3alg X (fun e => profRadInt Un X e) (fun e => profEtaD (profRadInt Un) X e)
      (fun e => profRadInt (fun x e => 2 * x * Fn x e) X e)
      (fun e => profEtaD (profRadInt (fun x e => 2 * x * Fn x e)) X e)
      (fun e => profRadInt (fun x e => Un x e * (2 * x * Fn x e)) X e)
      (fun e => profEtaD (profRadInt (fun x e => Un x e * (2 * x * Fn x e))) X e)
      (fun e => Fn X e) η0 hX.ne' hF0 hL0 c1 c2 c3 c4 c5 c6 cF).congr
      (Filter.Eventually.of_forall fun e => ?_)
    simp only [psLead1, leadQs, leadW, hAvgD, hAvg']

  have hnat : ∀ X η, 0 < X → X ≤ 41 / (10 * Λ) → -1 < η → η < 1 →
