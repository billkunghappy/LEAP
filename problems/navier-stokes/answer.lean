      have hle := ContinuousLinearMap.le_opNorm
        (fderiv ℝ (fun w : ℝ × ℝ × ℝ => logLift G w - P w.2.1 w.2.2) (Real.log q, X, η)) ((0:ℝ), (1:ℝ), (0:ℝ))
      rw [hn, mul_one, Real.norm_eq_abs] at hle
