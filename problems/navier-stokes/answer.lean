  have hVd : ∀ m, m ≤ n → (starRingEnd ℂ) (deriv (pv m).2 (η : ℂ)) = deriv (pv m).2 (η : ℂ) :=
    fun m hm => hc _ (dreal _ (hpv m hm).2 (fun e e1 e2 => (hpvreal m hm e e1 e2).2) η h1 h2)
