  have hdF : ContinuousOn (deriv (fun Y => Fn Y e)) (Ioo (-1 / Λ) (5 / Λ)) :=
    hSF.continuousOn_deriv_of_isOpen isOpen_Ioo (by norm_num)
  have hdU : ContinuousOn (deriv (fun Y => Un Y e)) (Ioo (-1 / Λ) (5 / Λ)) :=
    hSU.continuousOn_deriv_of_isOpen isOpen_Ioo (by norm_num)
  have hpath : Continuous (fun z : ℝ => 4 / Λ * Real.exp z) := continuous_const.mul Real.continuous_exp
  have hFpos : ∀ z ∈ Icc (0:ℝ) (2 * t1), 0 < Fn (4 / Λ * Real.exp z) e := by
