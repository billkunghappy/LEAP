      mul_le_mul e1 e2 (Real.rpow_nonneg hσ0 _) (mul_nonneg hCm hZ)
    have e5 := mul_le_mul_of_nonneg_right e4 hY
    exact mul_le_mul e5 e3 (Real.rpow_nonneg hδ0.le _)
      (mul_nonneg (mul_nonneg (mul_nonneg hCm hZ) (Real.rpow_nonneg hσ0 _)) hY)

  obtain ⟨aP, haP⟩ : ∃ x : ℝ, x = CP * SC B.h ξ ^ bP := ⟨_, rfl⟩
  obtain ⟨aS, haS⟩ : ∃ x : ℝ, x = CS * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bS *
      edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dS) := ⟨_, rfl⟩
  obtain ⟨aQ, haQ⟩ : ∃ x : ℝ, x = K1 * qC B.h ξ ^ (-1:ℝ) * (1 + Cq) ^ k := ⟨_, rfl⟩
  obtain ⟨aR, haR⟩ : ∃ x : ℝ, x = K2 * (c * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) ^ (-(1/2:ℝ)) *
