    have hNBnn : 0 ≤ NB B.h F i ((u * ξ0.1, ξ0.2.1, ξ0.2.2.1, (0 : ℝ × ℝ)) : Cyl) := norm_nonneg _
    have huD : u ≤ max 1 D := le_trans (hu.2.trans hc'D) (le_max_right 1 D)
    have hpow : max 1 u ^ i ≤ max 1 D ^ k :=
      (pow_le_pow_left₀ (le_trans zero_le_one (le_max_left _ _))
        (max_le_max le_rfl (hu.2.trans hc'D)) i).trans (pow_le_pow_right₀ (le_max_left 1 D) hi)
    have ha : ‖iteratedFDeriv ℝ i (gu u) 0‖ ≤
        max 1 D ^ k * (C0 * qC B.h ξ0 ^ (B.h * α) * SC B.h ξ0 ^ b * W) :=
      (hray u hu0 i).trans (mul_le_mul hpow hNBu hNBnn (pow_nonneg hD0 _))
    have hb : u ^ e ≤ max 1 D ^ e := pow_le_pow_left₀ hu0.le huD e
    calc u ^ e * ‖iteratedFDeriv ℝ i (gu u) 0‖
        ≤ max 1 D ^ e * (max 1 D ^ k * (C0 * qC B.h ξ0 ^ (B.h * α) * SC B.h ξ0 ^ b * W)) :=
          mul_le_mul hb ha (norm_nonneg _) (pow_nonneg hD0 _)
      _ = max 1 D ^ (k + e) * C0 * qC B.h ξ0 ^ (B.h * α) * SC B.h ξ0 ^ b * W := by
          rw [pow_add]; ring
  rw [hstar, hPd i 0 h0V]
  have hint := norm_setIntegral_le_of_norm_le_const (μ := (volume : Measure ℝ)) measure_Icc_lt_top hpt
  rw [Real.volume_real_Icc_of_le hcc'] at hint
  calc _ ≤ max 1 D ^ (k + e) * C0 * qC B.h ξ0 ^ (B.h * α) * SC B.h ξ0 ^ b * W * (c' - c) := hint
    _ ≤ max 1 D ^ (k + e) * C0 * qC B.h ξ0 ^ (B.h * α) * SC B.h ξ0 ^ b * W * D :=
