    have hx0 : |x0 - x0| < δ := by simp [hδ]
    have hFc : ∀ x, |x - x0| < δ → ContinuousOn (fun r => Φ r x) (Icc a b) := by
      intro x hx
      refine hΦ.continuousOn.comp (continuous_id.prodMk continuous_const).continuousOn ?_
      intro r hr
      exact ⟨hab' hr, (bz _ _ _).2 hx⟩
    have hD0c : ContinuousOn (fun r => fderiv ℝ (fun p : ℝ × ℝ => Φ p.1 p.2) (r, x0) ((0:ℝ), (1:ℝ)))
        (Icc a b) := by
      refine hDc.comp (continuous_id.prodMk continuous_const).continuousOn ?_
      intro r hr
      exact ⟨hab' hr, (bz _ _ _).2 hx0⟩
    obtain ⟨-, hLB⟩ := hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (μ := volume.restrict (Icc a b)) (F := fun x r => Φ r x)
      (F' := fun x r => fderiv ℝ (fun p : ℝ × ℝ => Φ p.1 p.2) (r, x) ((0:ℝ), (1:ℝ)))
      (bound := fun _ => C) (x₀ := x0) hsn
      (Filter.eventually_of_mem hsn
        (fun x hx => (hFc x (hball x hx)).aestronglyMeasurable measurableSet_Icc))
      ((hFc x0 hx0).integrableOn_Icc)
      (hD0c.aestronglyMeasurable measurableSet_Icc)
      (ae_restrict_of_forall_mem measurableSet_Icc
        (fun r hr x hx => hC (r, x) ⟨hr, Metric.ball_subset_closedBall hx⟩))
      (continuousOn_const.integrableOn_Icc)
      (ae_restrict_of_forall_mem measurableSet_Icc
        (fun r hr x hx => hDd r x (hab' hr) (hball x hx)))
    have hL : (fun x => ∫ r in Ioi (0:ℝ), Φ r x) =ᶠ[nhds x0] (fun x => ∫ r in Icc a b, Φ r x) := by
      filter_upwards [hsn] with x hx
      exact RES (fun r => Φ r x) a b ha le_rfl le_rfl
        (fun r hr h => hv r x hr (h.imp le_of_lt le_of_lt) (hball x hx))
    have hRv : ∀ r, 0 < r → (r < a ∨ b < r) → deriv (fun x => Φ r x) x0 = 0 := by
      intro r hr h
      apply LZ _ (Metric.ball x0 δ) x0 Metric.isOpen_ball (Metric.mem_ball_self hδ)
      intro y hy
      exact hv r y hr (h.imp le_of_lt le_of_lt) ((bz _ _ _).1 hy)
    have hR : (∫ r in Ioi (0:ℝ), deriv (fun x => Φ r x) x0) =
        ∫ r in Icc a b, fderiv ℝ (fun p : ℝ × ℝ => Φ p.1 p.2) (r, x0) ((0:ℝ), (1:ℝ)) := by
      rw [RES _ a b ha le_rfl le_rfl hRv]
      exact setIntegral_congr_fun measurableSet_Icc (fun r hr => (hDd r x0 (hab' hr) hx0).deriv)
    rw [hR]
    exact hLB.congr_of_eventuallyEq hL
  set Ω := Ioi (0:ℝ) ×ˢ (Metric.ball z0 ε ×ˢ Metric.ball t0 ε) with hΩdef
  have hΩo : IsOpen Ω := isOpen_Ioi.prod (Metric.isOpen_ball.prod Metric.isOpen_ball)
  have memΩ : ∀ r z t : ℝ, 0 < r → |z - z0| < ε → |t - t0| < ε → ((r, z, t) : ℝ × ℝ × ℝ) ∈ Ω :=
    fun r z t hr hz ht => ⟨hr, (bz _ _ _).2 hz, (bz _ _ _).2 ht⟩
  have FLD : ∀ P' : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ P' Ω → ∀ v : ℝ × ℝ × ℝ,
      ContDiffOn ℝ ∞ (fun p => fderiv ℝ P' p v) Ω := fun P' hP' v =>
    (hP'.fderiv_of_isOpen hΩo (by simp)).clm_apply contDiffOn_const
  have SDz : ∀ P' : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ P' Ω → ∀ r z t : ℝ, 0 < r → |z - z0| < ε →
      |t - t0| < ε → HasDerivAt (fun z' => P' (r, z', t)) (fderiv ℝ P' (r, z, t) ((0:ℝ), (1:ℝ), (0:ℝ))) z := by
    intro P' hP' r z t hr hz ht
    have hd := ((hP'.differentiableOn (by simp)).differentiableAt
      (hΩo.mem_nhds (memΩ r z t hr hz ht))).hasFDerivAt
    have hc : HasDerivAt (fun z' : ℝ => ((r, z', t) : ℝ × ℝ × ℝ)) ((0:ℝ), (1:ℝ), (0:ℝ)) z :=
      (hasDerivAt_const z r).prodMk ((hasDerivAt_id' z).prodMk (hasDerivAt_const z t))
    exact hd.comp_hasDerivAt z hc
  have hpow : ContDiff ℝ ∞ (fun p : ℝ × ℝ => p.1 ^ k) := contDiff_fst.pow k
  have TRI : ∀ x z1 : ℝ, |x - z1| < ε / 2 → |z1 - z0| < ε / 2 → |x - z0| < ε := by
    intro x z1 h1 h2
    rw [abs_sub_lt_iff] at h1 h2 ⊢
    constructor <;> linarith
  have DZ0 : ∀ r y, 0 < r → (r ≤ a ∨ b ≤ r) → |y - z0| < ε → deriv (fun z' => pg r z' t0) y = 0 :=
    fun r y hr h hy => LZ _ (Metric.ball z0 ε) y Metric.isOpen_ball ((bz _ _ _).2 hy)
      (fun w hw => hvan r w t0 hr h ((bz _ _ _).1 hw) h0t)
  set Q : ℝ × ℝ × ℝ → ℝ := fun p => fderiv ℝ (fun p : ℝ × ℝ × ℝ => pg p.1 p.2.1 p.2.2) p ((0:ℝ), (1:ℝ), (0:ℝ))
    with hQdef
  have hQs : ContDiffOn ℝ ∞ Q Ω := FLD _ hPg _
  have v1 : (∫ r in Ioi (0:ℝ), r ^ k * deriv (fun t => pg r z0 t) t0) = 0 := by
    have hreg : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 ^ k * pg p.1 z0 p.2) (Ioi 0 ×ˢ Metric.ball t0 ε) :=
      hpow.contDiffOn.mul (hPg.comp (by fun_prop : ContDiff ℝ ∞ fun p : ℝ × ℝ =>
        ((p.1, z0, p.2) : ℝ × ℝ × ℝ)).contDiffOn
        (fun p hp => memΩ p.1 z0 p.2 hp.1 h0z ((bz _ _ _).1 hp.2)))
    have hD := LB (fun r t => r ^ k * pg r z0 t) t0 ε hε hreg
      (fun r t hr h ht => by simp only [hvan r z0 t hr h h0z ht, mul_zero])
    have hu := hD.unique ((hasDerivAt_const t0 (0:ℝ)).congr_of_eventuallyEq (by
      filter_upwards [Metric.ball_mem_nhds t0 hε] with x hx
      exact hmom z0 x h0z ((bz _ _ _).1 hx)))
    simp only [deriv_const_mul_field] at hu
    exact hu
  have hJ : ∀ z1, |z1 - z0| < ε / 2 →
      (∫ r in Ioi (0:ℝ), r ^ k * deriv (fun z => pg r z t0) z1) = 0 := by
    intro z1 hz1
    have hreg : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 ^ k * pg p.1 p.2 t0)
        (Ioi 0 ×ˢ Metric.ball z1 (ε / 2)) :=
      hpow.contDiffOn.mul (hPg.comp (by fun_prop : ContDiff ℝ ∞ fun p : ℝ × ℝ =>
        ((p.1, p.2, t0) : ℝ × ℝ × ℝ)).contDiffOn
        (fun p hp => memΩ p.1 p.2 t0 hp.1 (TRI _ _ ((bz _ _ _).1 hp.2) hz1) h0t))
    have hD := LB (fun r z => r ^ k * pg r z t0) z1 (ε / 2) (by linarith) hreg
      (fun r z hr h hz => by simp only [hvan r z t0 hr h (TRI _ _ hz hz1) h0t, mul_zero])
    have hu := hD.unique ((hasDerivAt_const z1 (0:ℝ)).congr_of_eventuallyEq (by
      filter_upwards [Metric.ball_mem_nhds z1 (by linarith : (0:ℝ) < ε / 2)] with x hx
      exact hmom x t0 (TRI _ _ ((bz _ _ _).1 hx) hz1) h0t))
    simp only [deriv_const_mul_field] at hu
    exact hu
  have v5 : (∫ r in Ioi (0:ℝ), r ^ k * deriv (fun z => deriv (fun z' => pg r z' t0) z) z0) = 0 := by
    have hreg0 : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 ^ k * Q (p.1, p.2, t0))
        (Ioi 0 ×ˢ Metric.ball z0 (ε / 2)) :=
      hpow.contDiffOn.mul (hQs.comp (by fun_prop : ContDiff ℝ ∞ fun p : ℝ × ℝ =>
        ((p.1, p.2, t0) : ℝ × ℝ × ℝ)).contDiffOn
        (fun p hp => memΩ p.1 p.2 t0 hp.1 (by have := (bz _ _ _).1 hp.2; linarith) h0t))
    have hreg : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 ^ k * deriv (fun z' => pg p.1 z' t0) p.2)
        (Ioi 0 ×ˢ Metric.ball z0 (ε / 2)) := by
      refine hreg0.congr (fun p hp => ?_)
      have hp2 : |p.2 - z0| < ε := by have := (bz _ _ _).1 hp.2; linarith
      show p.1 ^ k * deriv (fun z' => pg p.1 z' t0) p.2 = p.1 ^ k * Q (p.1, p.2, t0)
      rw [(SDz _ hPg p.1 p.2 t0 hp.1 hp2 h0t).deriv]
    have hD := LB (fun r z => r ^ k * deriv (fun z' => pg r z' t0) z) z0 (ε / 2) (by linarith) hreg
      (fun r z hr h hz => by simp only [DZ0 r z hr h (by linarith), mul_zero])
    have hu := hD.unique ((hasDerivAt_const z0 (0:ℝ)).congr_of_eventuallyEq (by
      filter_upwards [Metric.ball_mem_nhds z0 (by linarith : (0:ℝ) < ε / 2)] with x hx
      exact hJ x ((bz _ _ _).1 hx)))
    simp only [deriv_const_mul_field] at hu
    exact hu
  exact ⟨v1, v5⟩

theorem stp5_moment_assembly_th : ∀ (pv pF pG sb : ℝ → ℝ → ℝ → ℝ) (z0 t0 ε a b : ℝ), 0 < a → a < b → 0 < ε → ContDiffOn ℝ ∞ (fun p : ℝ × ℝ × ℝ => pv p.1 p.2.1 p.2.2) (Set.Ioi 0 ×ˢ (Metric.ball z0 ε ×ˢ Metric.ball t0 ε)) → ContDiffOn ℝ ∞ (fun p : ℝ × ℝ × ℝ => pF p.1 p.2.1 p.2.2) (Set.Ioi 0 ×ˢ (Metric.ball z0 ε ×ˢ Metric.ball t0 ε)) → ContDiffOn ℝ ∞ (fun p : ℝ × ℝ × ℝ => pG p.1 p.2.1 p.2.2) (Set.Ioi 0 ×ˢ (Metric.ball z0 ε ×ˢ Metric.ball t0 ε)) → ContinuousOn (fun r => sb r z0 t0) (Set.Ioi 0) → (∀ r z t : ℝ, 0 < r → (r ≤ a ∨ b ≤ r) → |z - z0| < ε → |t - t0| < ε → pv r z t = 0 ∧ pF r z t = 0 ∧ pG r z t = 0) → (∀ r : ℝ, 0 < r → (r ≤ a ∨ b ≤ r) → sb r z0 t0 = 0) → (∀ z t : ℝ, |z - z0| < ε → |t - t0| < ε → (∫ r in Set.Ioi (0:ℝ), r ^ 2 * pv r z t) = 0) → (∫ r in Set.Ioi (0:ℝ), r ^ 2 * sb r z0 t0) = 0 → (∫ r in Set.Ioi (0:ℝ), r ^ 2 * (deriv (fun t => pv r z0 t) t0 + (deriv (fun r' => pF r' z0 t0) r + 2 * pF r z0 t0 / r) + deriv (fun z => pG r z t0) z0 - ((deriv (fun r' => deriv (fun r'' => pv r'' z0 t0) r') r + deriv (fun r' => pv r' z0 t0) r / r + deriv (fun z => deriv (fun z' => pv r z' t0) z) z0) - pv r z0 t0 / r ^ 2) + sb r z0 t0)) = deriv (fun z => ∫ r in Set.Ioi (0:ℝ), r ^ 2 * pG r z t0) z0 :=
by
  intro pv pF pG sb z0 t0 ε a b ha hab hε hv hF hG hsc hvan hsb hm hm'
  have ha2 : 0 < a / 2 := by linarith
  have hab2 : a / 2 < 2 * b := by linarith
  have hIoi : IsOpen (Set.Ioi (0:ℝ)) := isOpen_Ioi
  have hz0 : |z0 - z0| < ε := by simp [hε]
  have ht0 : |t0 - t0| < ε := by simp [hε]
  have hball : ∀ x0 x : ℝ, x ∈ Metric.ball x0 ε → |x - x0| < ε := fun x0 x hx => by
    rw [Metric.mem_ball, Real.dist_eq] at hx
    exact hx

  obtain ⟨hψs, hTc, -, hZZc, -, -, -⟩ := stp5z_slice_regular pv z0 t0 ε hε hv
  obtain ⟨hfs, -, -, -, -, -, -⟩ := stp5z_slice_regular pF z0 t0 ε hε hF
  obtain ⟨-, -, hZc, -, hGs2, -, -⟩ := stp5z_slice_regular pG z0 t0 ε hε hG
  have hψ' : ContDiffOn ℝ ∞ (deriv (fun r => pv r z0 t0)) (Set.Ioi 0) :=
    hψs.deriv_of_isOpen hIoi (by simp)
  have hψ'c : ContinuousOn (deriv (deriv (fun r => pv r z0 t0))) (Set.Ioi 0) :=
    hψ'.continuousOn_deriv_of_isOpen hIoi (by simp)
  have hψ1c : ContinuousOn (deriv (fun r => pv r z0 t0)) (Set.Ioi 0) := hψ'.continuousOn
  have hf'c : ContinuousOn (deriv (fun r => pF r z0 t0)) (Set.Ioi 0) :=
    hfs.continuousOn_deriv_of_isOpen hIoi (by simp)
  have hdiffψ : ∀ r : ℝ, 0 < r → DifferentiableAt ℝ (fun r => pv r z0 t0) r := fun r hr =>
    (hψs.differentiableOn (by simp)).differentiableAt (hIoi.mem_nhds hr)
  have hdiffψ' : ∀ r : ℝ, 0 < r → DifferentiableAt ℝ (deriv (fun r => pv r z0 t0)) r := fun r hr =>
    (hψ'.differentiableOn (by simp)).differentiableAt (hIoi.mem_nhds hr)
  have hdifff : ∀ r : ℝ, 0 < r → DifferentiableAt ℝ (fun r => pF r z0 t0) r := fun r hr =>
    (hfs.differentiableOn (by simp)).differentiableAt (hIoi.mem_nhds hr)

  have V1 : ∀ r : ℝ, 0 < r → (r ≤ a ∨ b ≤ r) →
      deriv (fun t => pv r z0 t) t0 = 0 ∧ deriv (fun z => pG r z t0) z0 = 0 ∧
      deriv (fun z => deriv (fun z' => pv r z' t0) z) z0 = 0 ∧ pF r z0 t0 = 0 ∧
      pv r z0 t0 = 0 ∧ sb r z0 t0 = 0 := by
    intro r hr hra
    refine ⟨?_, ?_, ?_, (hvan r z0 t0 hr hra hz0 ht0).2.1, (hvan r z0 t0 hr hra hz0 ht0).1,
      hsb r hr hra⟩
    · have hev : (fun t => pv r z0 t) =ᶠ[nhds t0] fun _ => (0:ℝ) :=
        Filter.eventuallyEq_of_mem (Metric.ball_mem_nhds t0 hε)
          (fun t ht => (hvan r z0 t hr hra hz0 (hball t0 t ht)).1)
      rw [hev.deriv_eq, deriv_const]
    · have hev : (fun z => pG r z t0) =ᶠ[nhds z0] fun _ => (0:ℝ) :=
        Filter.eventuallyEq_of_mem (Metric.ball_mem_nhds z0 hε)
          (fun z hz => (hvan r z t0 hr hra (hball z0 z hz) ht0).2.2)
      rw [hev.deriv_eq, deriv_const]
    · have hev : (fun z => deriv (fun z' => pv r z' t0) z) =ᶠ[nhds z0] fun _ => (0:ℝ) := by
        refine Filter.eventuallyEq_of_mem (Metric.ball_mem_nhds z0 hε) (fun z hz => ?_)
        have hev2 : (fun z' => pv r z' t0) =ᶠ[nhds z] fun _ => (0:ℝ) :=
          Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds hz)
            (fun z' hz' => (hvan r z' t0 hr hra (hball z0 z' hz') ht0).1)
        show deriv (fun z' => pv r z' t0) z = 0
        rw [hev2.deriv_eq, deriv_const]
      rw [hev.deriv_eq, deriv_const]
  have V2 : ∀ r : ℝ, 0 < r → (r < a ∨ b < r) →
      deriv (fun r' => pF r' z0 t0) r = 0 ∧ deriv (fun r' => pv r' z0 t0) r = 0 ∧
      deriv (fun r' => deriv (fun r'' => pv r'' z0 t0) r') r = 0 := by
    intro r hr hra
    obtain ⟨O, hOo, hrO, hO⟩ : ∃ O : Set ℝ, IsOpen O ∧ r ∈ O ∧
        ∀ x ∈ O, 0 < x ∧ (x ≤ a ∨ b ≤ x) := by
      rcases hra with h | h
      · exact ⟨Set.Ioo 0 a, isOpen_Ioo, ⟨hr, h⟩, fun x hx => ⟨hx.1, Or.inl hx.2.le⟩⟩
      · exact ⟨Set.Ioi b, isOpen_Ioi, h,
          fun x hx => ⟨lt_trans (lt_trans ha hab) hx, Or.inr (le_of_lt hx)⟩⟩
    have hfz : ∀ x ∈ O, pF x z0 t0 = 0 := fun x hx =>
      (hvan x z0 t0 (hO x hx).1 (hO x hx).2 hz0 ht0).2.1
    have hψz : ∀ x ∈ O, pv x z0 t0 = 0 := fun x hx =>
      (hvan x z0 t0 (hO x hx).1 (hO x hx).2 hz0 ht0).1
    have hψ'z : ∀ x ∈ O, deriv (fun r' => pv r' z0 t0) x = 0 := by
      intro x hx
      have hev : (fun r' => pv r' z0 t0) =ᶠ[nhds x] fun _ => (0:ℝ) :=
        Filter.eventuallyEq_of_mem (hOo.mem_nhds hx) hψz
      rw [hev.deriv_eq, deriv_const]
    refine ⟨?_, hψ'z r hrO, ?_⟩
    · have hev : (fun r' => pF r' z0 t0) =ᶠ[nhds r] fun _ => (0:ℝ) :=
        Filter.eventuallyEq_of_mem (hOo.mem_nhds hrO) hfz
      rw [hev.deriv_eq, deriv_const]
    · have hev : (fun r' => deriv (fun r'' => pv r'' z0 t0) r') =ᶠ[nhds r] fun _ => (0:ℝ) :=
        Filter.eventuallyEq_of_mem (hOo.mem_nhds hrO) hψ'z
      rw [hev.deriv_eq, deriv_const]
  have Vout : ∀ r : ℝ, 0 < r → (r ≤ a / 2 ∨ 2 * b ≤ r) → (r ≤ a ∨ b ≤ r) ∧ (r < a ∨ b < r) := by
    intro r hr h
    rcases h with h | h
    · exact ⟨Or.inl (by linarith), Or.inl (by linarith)⟩
    · exact ⟨Or.inr (by linarith), Or.inr (by linarith)⟩

  have radInt : ∀ g : ℝ → ℝ, ContinuousOn g (Set.Ioi 0) →
      (∀ r, 0 < r → (r ≤ a / 2 ∨ 2 * b ≤ r) → g r = 0) → IntegrableOn g (Set.Ioi 0) := by
    intro g hg h0
    have hI : IntegrableOn g (Set.Icc (a / 2) (2 * b)) :=
      (hg.mono (fun x hx => lt_of_lt_of_le ha2 hx.1)).integrableOn_Icc
    refine hI.of_forall_sdiff_eq_zero measurableSet_Ioi ?_
    intro x hx
    apply h0 x hx.1
    by_contra hcon
    push_neg at hcon
    exact hx.2 ⟨hcon.1.le, hcon.2.le⟩

  obtain ⟨I1, hI1⟩ : ∃ I : ℝ → ℝ, I = fun r => r ^ 2 * deriv (fun t => pv r z0 t) t0 := ⟨_, rfl⟩
  obtain ⟨I2, hI2⟩ : ∃ I : ℝ → ℝ, I = fun r => r ^ (1 + 1) * deriv (fun r' => pF r' z0 t0) r +
      (((1:ℕ):ℝ) + 1) * r ^ 1 * pF r z0 t0 := ⟨_, rfl⟩
  obtain ⟨I3, hI3⟩ : ∃ I : ℝ → ℝ, I = fun r => r ^ 2 * deriv (fun z => pG r z t0) z0 := ⟨_, rfl⟩
  obtain ⟨I4, hI4⟩ : ∃ I : ℝ → ℝ, I = fun r =>
      r ^ (1 + 1) * deriv (fun r' => deriv (fun r'' => pv r'' z0 t0) r') r +
      (((1:ℕ):ℝ) + 1) * r ^ 1 * deriv (fun r' => pv r' z0 t0) r := ⟨_, rfl⟩
  obtain ⟨I5, hI5⟩ : ∃ I : ℝ → ℝ, I = fun r => r ^ (0 + 1) * deriv (fun r' => pv r' z0 t0) r +
      (((0:ℕ):ℝ) + 1) * r ^ 0 * pv r z0 t0 := ⟨_, rfl⟩
  obtain ⟨I6, hI6⟩ : ∃ I : ℝ → ℝ, I = fun r =>
      r ^ 2 * deriv (fun z => deriv (fun z' => pv r z' t0) z) z0 := ⟨_, rfl⟩
  obtain ⟨I7, hI7⟩ : ∃ I : ℝ → ℝ, I = fun r => r ^ 2 * sb r z0 t0 := ⟨_, rfl⟩
  have alg : ∀ r T f' f Z p2 p1 ZZ p s : ℝ, r ≠ 0 →
      r ^ 2 * (T + (f' + 2 * f / r) + Z - ((p2 + p1 / r + ZZ) - p / r ^ 2) + s) =
      r ^ 2 * T + (r ^ (1 + 1) * f' + (((1:ℕ):ℝ) + 1) * r ^ 1 * f) + r ^ 2 * Z -
      (r ^ (1 + 1) * p2 + (((1:ℕ):ℝ) + 1) * r ^ 1 * p1) +
      (r ^ (0 + 1) * p1 + (((0:ℕ):ℝ) + 1) * r ^ 0 * p) - r ^ 2 * ZZ + r ^ 2 * s := by
    intro r T f' f Z p2 p1 ZZ p s hr
    push_cast
    field_simp
    ring
  have hsplit : Set.EqOn (fun r => r ^ 2 * (deriv (fun t => pv r z0 t) t0 + (deriv (fun r' => pF r' z0 t0) r + 2 * pF r z0 t0 / r) + deriv (fun z => pG r z t0) z0 - ((deriv (fun r' => deriv (fun r'' => pv r'' z0 t0) r') r + deriv (fun r' => pv r' z0 t0) r / r + deriv (fun z => deriv (fun z' => pv r z' t0) z) z0) - pv r z0 t0 / r ^ 2) + sb r z0 t0))
      (I1 + I2 + I3 - I4 + I5 - I6 + I7) (Set.Ioi 0) := by
    intro r hr
    simp only [Pi.add_apply, Pi.sub_apply, hI1, hI2, hI3, hI4, hI5, hI6, hI7]
    exact alg r _ _ _ _ _ _ _ _ _ (Set.mem_Ioi.mp hr).ne'

  have i1 : IntegrableOn I1 (Set.Ioi 0) := by
    refine radInt I1 ?_ ?_
    · rw [hI1]; exact (continuous_pow 2).continuousOn.mul hTc
    · intro r hr h
      simp only [hI1, (V1 r hr (Vout r hr h).1).1, mul_zero]
  have i2 : IntegrableOn I2 (Set.Ioi 0) := by
    refine radInt I2 ?_ ?_
    · rw [hI2]
      exact ((continuous_pow (1 + 1)).continuousOn.mul hf'c).add
        ((continuous_const.mul (continuous_pow 1)).continuousOn.mul hfs.continuousOn)
    · intro r hr h
      simp only [hI2, (V1 r hr (Vout r hr h).1).2.2.2.1, (V2 r hr (Vout r hr h).2).1, mul_zero,
        add_zero]
  have i3 : IntegrableOn I3 (Set.Ioi 0) := by
    refine radInt I3 ?_ ?_
    · rw [hI3]; exact (continuous_pow 2).continuousOn.mul hZc
    · intro r hr h
      simp only [hI3, (V1 r hr (Vout r hr h).1).2.1, mul_zero]
  have i4 : IntegrableOn I4 (Set.Ioi 0) := by
    refine radInt I4 ?_ ?_
    · rw [hI4]
      exact ((continuous_pow (1 + 1)).continuousOn.mul hψ'c).add
        ((continuous_const.mul (continuous_pow 1)).continuousOn.mul hψ1c)
    · intro r hr h
      simp only [hI4, (V2 r hr (Vout r hr h).2).2.1, (V2 r hr (Vout r hr h).2).2.2, mul_zero,
        add_zero]
  have i5 : IntegrableOn I5 (Set.Ioi 0) := by
    refine radInt I5 ?_ ?_
    · rw [hI5]
      exact ((continuous_pow (0 + 1)).continuousOn.mul hψ1c).add
        ((continuous_const.mul (continuous_pow 0)).continuousOn.mul hψs.continuousOn)
    · intro r hr h
      simp only [hI5, (V2 r hr (Vout r hr h).2).2.1, (V1 r hr (Vout r hr h).1).2.2.2.2.1,
        mul_zero, add_zero]
  have i6 : IntegrableOn I6 (Set.Ioi 0) := by
    refine radInt I6 ?_ ?_
    · rw [hI6]; exact (continuous_pow 2).continuousOn.mul hZZc
    · intro r hr h
      simp only [hI6, (V1 r hr (Vout r hr h).1).2.2.1, mul_zero]
  have i7 : IntegrableOn I7 (Set.Ioi 0) := by
    refine radInt I7 ?_ ?_
    · rw [hI7]; exact (continuous_pow 2).continuousOn.mul hsc
    · intro r hr h
      simp only [hI7, hsb r hr (Vout r hr h).1, mul_zero]

  have hpv0 : ∀ r z t : ℝ, 0 < r → (r ≤ a ∨ b ≤ r) → |z - z0| < ε → |t - t0| < ε → pv r z t = 0 :=
    fun r z t hr h hz ht => (hvan r z t hr h hz ht).1
  have hzm := stp5z_zero_moment pv z0 t0 ε a b 2 ha hab hε hv hpv0 hm
  have v1 : ∫ r in Set.Ioi (0:ℝ), I1 r = 0 := by rw [hI1]; exact hzm.1
  have v6 : ∫ r in Set.Ioi (0:ℝ), I6 r = 0 := by rw [hI6]; exact hzm.2
  have v2 : ∫ r in Set.Ioi (0:ℝ), I2 r = 0 := by
    rw [hI2]
    exact stp5_radial_ibp (fun r' => pF r' z0 t0) (a / 2) (2 * b) 1 ha2 hab2 hdifff hf'c
      (fun r hr h => (V1 r hr (Vout r hr h).1).2.2.2.1) (fun r hr h => (V2 r hr (Vout r hr h).2).1)
  have v4 : ∫ r in Set.Ioi (0:ℝ), I4 r = 0 := by
    rw [hI4]
    exact stp5_radial_ibp (deriv (fun r' => pv r' z0 t0)) (a / 2) (2 * b) 1 ha2 hab2 hdiffψ' hψ'c
      (fun r hr h => (V2 r hr (Vout r hr h).2).2.1) (fun r hr h => (V2 r hr (Vout r hr h).2).2.2)
  have v5 : ∫ r in Set.Ioi (0:ℝ), I5 r = 0 := by
    rw [hI5]
    exact stp5_radial_ibp (fun r' => pv r' z0 t0) (a / 2) (2 * b) 0 ha2 hab2 hdiffψ hψ1c
      (fun r hr h => (V1 r hr (Vout r hr h).1).2.2.2.2.1) (fun r hr h => (V2 r hr (Vout r hr h).2).2.1)
  have v7 : ∫ r in Set.Ioi (0:ℝ), I7 r = 0 := by rw [hI7]; exact hm'
  have hreg : ContDiffOn ℝ 1 (fun p : ℝ × ℝ => p.1 ^ 2 * pG p.1 p.2 t0)
      (Set.Ioi 0 ×ˢ Metric.ball z0 ε) :=
    ((contDiffOn_fst.pow 2).mul hGs2).of_le (by simp)
  have hK := stp5_radmom_hasderiv (fun r z => r ^ 2 * pG r z t0) a b z0 ε ha hab hε hreg
    (fun r x hr h hx => by simp only [(hvan r x t0 hr h hx ht0).2.2, mul_zero])
  have hKd : deriv (fun z => ∫ r in Set.Ioi (0:ℝ), r ^ 2 * pG r z t0) z0 =
      ∫ r in Set.Ioi (0:ℝ), deriv (fun z => r ^ 2 * pG r z t0) z0 := hK.deriv
  have v3 : ∫ r in Set.Ioi (0:ℝ), I3 r = deriv (fun z => ∫ r in Set.Ioi (0:ℝ), r ^ 2 * pG r z t0) z0 := by
    rw [hKd, hI3]
    congr 1
    funext r
    exact (deriv_const_mul_field (r ^ 2)).symm

  have A5 : IntegrableOn (I1 + I2 + I3 - I4 + I5 - I6) (Set.Ioi 0) :=
    Integrable.sub (Integrable.add (Integrable.sub (Integrable.add (Integrable.add i1 i2) i3) i4) i5) i6
  have A4 : IntegrableOn (I1 + I2 + I3 - I4 + I5) (Set.Ioi 0) :=
    Integrable.add (Integrable.sub (Integrable.add (Integrable.add i1 i2) i3) i4) i5
  have A3 : IntegrableOn (I1 + I2 + I3 - I4) (Set.Ioi 0) :=
    Integrable.sub (Integrable.add (Integrable.add i1 i2) i3) i4
  have A2 : IntegrableOn (I1 + I2 + I3) (Set.Ioi 0) := Integrable.add (Integrable.add i1 i2) i3
  have A1 : IntegrableOn (I1 + I2) (Set.Ioi 0) := Integrable.add i1 i2
  rw [setIntegral_congr_fun measurableSet_Ioi hsplit, integral_add' A5 i7, integral_sub' A4 i6,
    integral_add' A3 i5, integral_sub' A2 i4, integral_add' A1 i3, integral_add' i1 i2]
  linarith [v1, v2, v3, v4, v5, v6, v7]

theorem stp5_moment_assembly_z : ∀ (pg pF pG sb : ℝ → ℝ → ℝ → ℝ) (z0 t0 ε a b : ℝ), 0 < a → a < b → 0 < ε → ContDiffOn ℝ ∞ (fun p : ℝ × ℝ × ℝ => pg p.1 p.2.1 p.2.2) (Set.Ioi 0 ×ˢ (Metric.ball z0 ε ×ˢ Metric.ball t0 ε)) → ContDiffOn ℝ ∞ (fun p : ℝ × ℝ × ℝ => pF p.1 p.2.1 p.2.2) (Set.Ioi 0 ×ˢ (Metric.ball z0 ε ×ˢ Metric.ball t0 ε)) → ContDiffOn ℝ ∞ (fun p : ℝ × ℝ × ℝ => pG p.1 p.2.1 p.2.2) (Set.Ioi 0 ×ˢ (Metric.ball z0 ε ×ˢ Metric.ball t0 ε)) → ContinuousOn (fun r => sb r z0 t0) (Set.Ioi 0) → (∀ r z t : ℝ, 0 < r → (r ≤ a ∨ b ≤ r) → |z - z0| < ε → |t - t0| < ε → pg r z t = 0 ∧ pF r z t = 0 ∧ pG r z t = 0) → (∀ r : ℝ, 0 < r → (r ≤ a ∨ b ≤ r) → sb r z0 t0 = 0) → (∀ z t : ℝ, |z - z0| < ε → |t - t0| < ε → (∫ r in Set.Ioi (0:ℝ), r ^ 1 * pg r z t) = 0) → (∫ r in Set.Ioi (0:ℝ), r ^ 1 * sb r z0 t0) = 0 → (∫ r in Set.Ioi (0:ℝ), r ^ 1 * (deriv (fun t => pg r z0 t) t0 + (deriv (fun r' => pF r' z0 t0) r + pF r z0 t0 / r) + deriv (fun z => pG r z t0) z0 - (deriv (fun r' => deriv (fun r'' => pg r'' z0 t0) r') r + deriv (fun r' => pg r' z0 t0) r / r + deriv (fun z => deriv (fun z' => pg r z' t0) z) z0) + sb r z0 t0)) = deriv (fun z => ∫ r in Set.Ioi (0:ℝ), r ^ 1 * pG r z t0) z0 :=
by
  intro pg pF pG sb z0 t0 ε a b ha hab hε hPg hPF hPG hsb hvan hsbv hmom hsmom
  have bz : ∀ c δ x : ℝ, x ∈ Metric.ball c δ ↔ |x - c| < δ := fun c δ x => by
    rw [Metric.mem_ball, Real.dist_eq]
  have h0z : |z0 - z0| < ε := by simp [hε]
  have h0t : |t0 - t0| < ε := by simp [hε]
  have LZ : ∀ (g : ℝ → ℝ) (O : Set ℝ) (x : ℝ), IsOpen O → x ∈ O → (∀ y ∈ O, g y = 0) →
      deriv g x = 0 := by
    intro g O x hO hx h
    have hev : g =ᶠ[nhds x] fun _ => (0:ℝ) := Filter.eventuallyEq_of_mem (hO.mem_nhds hx) h
    rw [hev.deriv_eq, deriv_const]
  have OPEN : ∀ g : ℝ → ℝ, (∀ r, 0 < r → (r < a ∨ b < r) → g r = 0) →
      ∀ r, 0 < r → (r < a ∨ b < r) → deriv g r = 0 := by
    intro g hg r hr h
    rcases h with h | h
    · exact LZ g (Ioo 0 a) r isOpen_Ioo ⟨hr, h⟩ (fun y hy => hg y hy.1 (Or.inl hy.2))
    · exact LZ g (Ioi b) r isOpen_Ioi h (fun y hy => hg y (by have : b < y := hy; linarith)
        (Or.inr hy))
  have RES : ∀ (f : ℝ → ℝ) (c d : ℝ), 0 < c → c ≤ a → b ≤ d →
      (∀ r, 0 < r → (r < a ∨ b < r) → f r = 0) →
      ∫ r in Ioi (0:ℝ), f r = ∫ r in Icc c d, f r := by
    intro f c d hc hca hbd h0
    apply setIntegral_eq_of_subset_of_forall_diff_eq_zero measurableSet_Ioi
    · intro x hx; exact lt_of_lt_of_le hc hx.1
    · intro x hx
      apply h0 x hx.1
      by_contra hcon
      push_neg at hcon
      exact hx.2 ⟨by linarith [hcon.1], by linarith [hcon.2]⟩
  have INT : ∀ f : ℝ → ℝ, ContinuousOn f (Ioi 0) → (∀ r, 0 < r → (r < a ∨ b < r) → f r = 0) →
      IntegrableOn f (Ioi 0) := by
    intro f hf h0
    have hI : IntegrableOn f (Icc a b) :=
      (hf.mono (fun x hx => lt_of_lt_of_le ha hx.1)).integrableOn_Icc
    refine hI.of_forall_diff_eq_zero measurableSet_Ioi ?_
    intro x hx
    apply h0 x hx.1
    by_contra hcon
    push_neg at hcon
    exact hx.2 ⟨hcon.1, hcon.2⟩
  have IBP : ∀ (Ψ : ℝ → ℝ) (c d : ℝ), 0 < c → c ≤ a → b ≤ d →
      (∀ r, 0 < r → DifferentiableAt ℝ Ψ r) → ContinuousOn (deriv Ψ) (Ioi 0) → Ψ c = 0 → Ψ d = 0 →
      (∀ r, 0 < r → (r < a ∨ b < r) → r * deriv Ψ r + Ψ r = 0) →
      ∫ r in Ioi (0:ℝ), (r * deriv Ψ r + Ψ r) = 0 := by
    intro Ψ c d hc hca hbd hd hcont hΨc hΨd h0
    have hcd : c ≤ d := by linarith
    rw [RES _ c d hc hca hbd h0, integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hcd]
    have hsub : Icc c d ⊆ Ioi 0 := fun x hx => lt_of_lt_of_le hc hx.1
    have hderiv : ∀ x ∈ uIcc c d, HasDerivAt (fun r => r * Ψ r) (x * deriv Ψ x + Ψ x) x := by
      intro x hx
      rw [uIcc_of_le hcd] at hx
      exact ((hasDerivAt_id' x).mul (hd x (hsub hx)).hasDerivAt).congr_deriv (by ring)
    have hint : IntervalIntegrable (fun x => x * deriv Ψ x + Ψ x) volume c d := by
      apply ContinuousOn.intervalIntegrable
      rw [uIcc_of_le hcd]
      exact ContinuousOn.add (continuousOn_id.mul (hcont.mono hsub))
        (fun x hx => (hd x (hsub hx)).continuousAt.continuousWithinAt)
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint]
    simp [hΨc, hΨd]
  have LB : ∀ (Φ : ℝ → ℝ → ℝ) (x0 δ : ℝ), 0 < δ →
      ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Φ p.1 p.2) (Ioi 0 ×ˢ Metric.ball x0 δ) →
      (∀ r x, 0 < r → (r ≤ a ∨ b ≤ r) → |x - x0| < δ → Φ r x = 0) →
      HasDerivAt (fun x => ∫ r in Ioi (0:ℝ), Φ r x)
        (∫ r in Ioi (0:ℝ), deriv (fun x => Φ r x) x0) x0 := by
    intro Φ x0 δ hδ hΦ hv
    have hUo : IsOpen (Ioi (0:ℝ) ×ˢ Metric.ball x0 δ) := isOpen_Ioi.prod Metric.isOpen_ball
    have hDc : ContinuousOn (fun p : ℝ × ℝ => fderiv ℝ (fun p : ℝ × ℝ => Φ p.1 p.2) p ((0:ℝ), (1:ℝ)))
        (Ioi (0:ℝ) ×ˢ Metric.ball x0 δ) :=
      (hΦ.continuousOn_fderiv_of_isOpen hUo (by simp)).clm_apply continuousOn_const
    have hDd : ∀ r x, 0 < r → |x - x0| < δ → HasDerivAt (fun x => Φ r x)
        (fderiv ℝ (fun p : ℝ × ℝ => Φ p.1 p.2) (r, x) ((0:ℝ), (1:ℝ))) x := by
      intro r x hr hx
      have hmem : ((r, x) : ℝ × ℝ) ∈ Ioi (0:ℝ) ×ˢ Metric.ball x0 δ := ⟨hr, (bz _ _ _).2 hx⟩
      have hdiff := ((hΦ.differentiableOn (by simp)).differentiableAt (hUo.mem_nhds hmem)).hasFDerivAt
      have hc : HasDerivAt (fun x : ℝ => ((r, x) : ℝ × ℝ)) ((0:ℝ), (1:ℝ)) x :=
        (hasDerivAt_const x r).prodMk (hasDerivAt_id' x)
      exact hdiff.comp_hasDerivAt x hc
    have hK : IsCompact (Icc a b ×ˢ Metric.closedBall x0 (δ/2)) :=
      isCompact_Icc.prod (isCompact_closedBall _ _)
    have hKU : Icc a b ×ˢ Metric.closedBall x0 (δ/2) ⊆ Ioi (0:ℝ) ×ˢ Metric.ball x0 δ := fun p hp =>
      ⟨lt_of_lt_of_le ha hp.1.1, Metric.closedBall_subset_ball (by linarith) hp.2⟩
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn (hDc.mono hKU)
    have hsn : Metric.ball x0 (δ/2) ∈ nhds x0 := Metric.ball_mem_nhds x0 (by linarith)
    have hab' : Icc a b ⊆ Ioi 0 := fun r hr => lt_of_lt_of_le ha hr.1
    have hball : ∀ x ∈ Metric.ball x0 (δ/2), |x - x0| < δ := by
      intro x hx
      have := (bz _ _ _).1 hx
      linarith
    have hx0 : |x0 - x0| < δ := by simp [hδ]
    have hFc : ∀ x, |x - x0| < δ → ContinuousOn (fun r => Φ r x) (Icc a b) := by
      intro x hx
      refine hΦ.continuousOn.comp (continuous_id.prodMk continuous_const).continuousOn ?_
      intro r hr
      exact ⟨hab' hr, (bz _ _ _).2 hx⟩
    have hD0c : ContinuousOn (fun r => fderiv ℝ (fun p : ℝ × ℝ => Φ p.1 p.2) (r, x0) ((0:ℝ), (1:ℝ)))
        (Icc a b) := by
      refine hDc.comp (continuous_id.prodMk continuous_const).continuousOn ?_
      intro r hr
      exact ⟨hab' hr, (bz _ _ _).2 hx0⟩
    obtain ⟨-, hLB⟩ := hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (μ := volume.restrict (Icc a b)) (F := fun x r => Φ r x)
      (F' := fun x r => fderiv ℝ (fun p : ℝ × ℝ => Φ p.1 p.2) (r, x) ((0:ℝ), (1:ℝ)))
      (bound := fun _ => C) (x₀ := x0) hsn
      (Filter.eventually_of_mem hsn
        (fun x hx => (hFc x (hball x hx)).aestronglyMeasurable measurableSet_Icc))
      ((hFc x0 hx0).integrableOn_Icc)
      (hD0c.aestronglyMeasurable measurableSet_Icc)
      (ae_restrict_of_forall_mem measurableSet_Icc
        (fun r hr x hx => hC (r, x) ⟨hr, Metric.ball_subset_closedBall hx⟩))
      (continuousOn_const.integrableOn_Icc)
      (ae_restrict_of_forall_mem measurableSet_Icc
        (fun r hr x hx => hDd r x (hab' hr) (hball x hx)))
    have hL : (fun x => ∫ r in Ioi (0:ℝ), Φ r x) =ᶠ[nhds x0] (fun x => ∫ r in Icc a b, Φ r x) := by
      filter_upwards [hsn] with x hx
      exact RES (fun r => Φ r x) a b ha le_rfl le_rfl
        (fun r hr h => hv r x hr (h.imp le_of_lt le_of_lt) (hball x hx))
    have hRv : ∀ r, 0 < r → (r < a ∨ b < r) → deriv (fun x => Φ r x) x0 = 0 := by
      intro r hr h
      apply LZ _ (Metric.ball x0 δ) x0 Metric.isOpen_ball (Metric.mem_ball_self hδ)
      intro y hy
