      StOrd5 B G l0 S' (Bo + 1/10) (Bo + 1/10 + 1/2) (Bo + 1/10 + 1/2) (Bo + 1/10 + 1/2) ∧
        Incr5 B G l0 S S' (Bo - kapS)) := by
    intro S Bo
    by_cases hh : 7/10 ≤ Bo ∧ StOrd5 B G l0 S Bo (Bo + 1/2) (Bo + 1/2) (Bo + 1/2)
    · obtain ⟨S', hS'⟩ := cyc S Bo hh.1 hh.2
      exact ⟨S', fun _ _ => hS'⟩
    · exact ⟨S, fun h1 h2 => absurd ⟨h1, h2⟩ hh⟩
  choose nxt hnxt using cyc'

  let st : ℕ → CState := fun n => Nat.rec S0 (fun j S => nxt S (7/10 + (j:ℝ)/10)) n
  have hst : ∀ j : ℕ, StOrd5 B G l0 (st j) (7/10 + (j:ℝ)/10) (7/10 + (j:ℝ)/10 + 1/2) (7/10 + (j:ℝ)/10 + 1/2)
