  rw [hQ]
  obtain ⟨Z, hZ⟩ : ∃ Z : ℝ, Q ^ ((N:ℝ) + κ) = Z := ⟨_, rfl⟩
  obtain ⟨W, hW⟩ : ∃ W : ℝ, Q ^ (-κ) = W := ⟨_, rfl⟩
