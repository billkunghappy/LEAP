theorem rfp_extB_shearA : ∀ P : RfpPar, RfpRegime P → ∀ x η : ℝ, Real.exp (rfpY6 P) ≤ x → x < rfpXb P * Real.exp (-2) → shearA (rfpF P) x η = 2 + 2 * P.h :=
