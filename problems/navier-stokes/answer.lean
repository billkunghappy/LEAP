    rw [Prod.norm_mk, Prod.norm_mk, Prod.norm_mk, norm_zero]
    exact max_le zero_le_one (max_le zero_le_one (max_le zero_le_one hv))
  · intro p t
    have e1 : (p + t • dVdir h l).1 = p.1 := by simp [dVdir]
    have e2 : (p + t • dVdir h l).2.1 = p.2.1 := by simp [dVdir]
    have e3 : (p + t • dVdir h l).2.2.1 = p.2.2.1 := by simp [dVdir]
    have hq : qC h (p + t • dVdir h l) = qC h p := by unfold qC; rw [e2, e3]
    refine ⟨hq, ?_, ?_, ?_⟩
    · unfold XC; rw [hq, e1]
    · unfold SC; rw [hq]
