    have h1 : (qC B.h ξ ^ (-B.h)) ^ 2 * qC B.h ξ ^ (2 * B.h) = 1 := by
      rw [Real.rpow_neg hq0.le, two_mul, Real.rpow_add hq0, inv_pow, ← sq,
        inv_mul_cancel₀ (pow_ne_zero 2 hqh.ne')]
    have h2 : (Qb l ^ (-(1/2:ℝ))) ^ 2 * Qb l = 1 := by
      have hsq : (Qb l ^ (1/2:ℝ)) ^ 2 = Qb l := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul hQ.le]; norm_num
      rw [Real.rpow_neg hQ.le, inv_pow, hsq, inv_mul_cancel₀ hQ.ne']
    rw [Real.sq_sqrt he.le]
    calc (qC B.h ξ ^ (-B.h) * Qb l ^ (-(1/2:ℝ))) ^ 2 * epsb B.h l * (qC B.h ξ ^ (2 * B.h) * Qb l / epsb B.h l)
        = ((qC B.h ξ ^ (-B.h)) ^ 2 * qC B.h ξ ^ (2 * B.h)) * ((Qb l ^ (-(1/2:ℝ))) ^ 2 * Qb l) *
            (epsb B.h l / epsb B.h l) := by ring
      _ = 1 := by rw [h1, h2, div_self he.ne']; ring
  have alg : ∀ (F2 E e2 yt yf Hp1 Hp2 Hm1 Hm2 κ σ1 σ2 : ℝ), 0 < yt → 0 < yf →
      Hp1 * Hm2 - Hm1 * Hp2 ≠ 0 → F2 * E * κ = 1 →
      (F2 * E * e2 * Real.sqrt (max yt 0) *
          ((Hm2 * (κ * σ1) - Hm1 * (κ * σ2)) / (Hp1 * Hm2 - Hm1 * Hp2) / (2 * Real.sqrt yt)) * (2 * Hp1) +
        F2 * E * e2 * Real.sqrt (max yf 0) *
          ((Hp1 * (κ * σ2) - Hp2 * (κ * σ1)) / (Hp1 * Hm2 - Hm1 * Hp2) / (2 * Real.sqrt yf)) * (2 * Hm1)
        = σ1 * e2) ∧
      (F2 * E * e2 * Real.sqrt (max yt 0) *
          ((Hm2 * (κ * σ1) - Hm1 * (κ * σ2)) / (Hp1 * Hm2 - Hm1 * Hp2) / (2 * Real.sqrt yt)) * (2 * Hp2) +
        F2 * E * e2 * Real.sqrt (max yf 0) *
          ((Hp1 * (κ * σ2) - Hp2 * (κ * σ1)) / (Hp1 * Hm2 - Hm1 * Hp2) / (2 * Real.sqrt yf)) * (2 * Hm2)
        = σ2 * e2) := by
    intro F2 E e2 yt yf Hp1 Hp2 Hm1 Hm2 κ σ1 σ2 hyt hyf hdet hF
    rw [max_eq_left hyt.le, max_eq_left hyf.le]
    have h1 := (Real.sqrt_pos.2 hyt).ne'
    have h2 := (Real.sqrt_pos.2 hyf).ne'
    constructor
    · rw [show σ1 * e2 = F2 * E * κ * (σ1 * e2) by rw [hF, one_mul]]
      field_simp
      have hD : (Hm2 * Hp1 - Hm1 * Hp2) * (Hm2 * Hp1 - Hm1 * Hp2)⁻¹ = 1 :=
        mul_inv_cancel₀ (by rw [mul_comm Hm2]; exact hdet)
      linear_combination (F2 * E * e2 * κ * σ1) * hD
    · rw [show σ2 * e2 = F2 * E * κ * (σ2 * e2) by rw [hF, one_mul]]
      field_simp
      have hD : (Hm2 * Hp1 - Hm1 * Hp2) * (Hm2 * Hp1 - Hm1 * Hp2)⁻¹ = 1 :=
        mul_inv_cancel₀ (by rw [mul_comm Hm2]; exact hdet)
      linear_combination (F2 * E * e2 * κ * σ2) * hD
  have hfs : ∑ᶠ p : ℕ × (ℤ × ℤ × ℤ), etaL B.h (p.1, p.2, true) ξ ^ 2 =
      ∑ p ∈ F', etaL B.h (p.1, p.2, true) ξ ^ 2 := by
    apply finsum_eq_sum_of_support_subset
    intro p hp
    rw [Finset.mem_coe, hF', Set.Finite.mem_toFinset]
    intro h0
    exact hp (by simp [h0])
  have hpF : ∀ p ∈ F', etaL B.h (p.1, p.2, true) ξ ≠ 0 := by
    intro p hp
    rw [hF', Set.Finite.mem_toFinset] at hp
    exact hp
  have m1 := main 1 (Or.inl rfl)
  have m2 := main 2 (Or.inr rfl)
  simp only [if_pos (rfl : (1 : Fin 3) = 1)] at m1
  simp only [if_neg (by decide : (2 : Fin 3) ≠ 1)] at m2
  refine ⟨?_, ?_⟩
  · rw [m1, hsplit, ← (show sigE5 B G l0 S 2 ξ * ∑ p ∈ F', etaL B.h (p.1, p.2, true) ξ ^ 2 =
        sigE5 B G l0 S 2 ξ by rw [← hfs, hsum1, mul_one]), Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro p hp
    have hpe := hpF p hp
    obtain ⟨-, hdet, hyt⟩ := hbox (p.1, p.2, true) hpe
    obtain ⟨-, -, hyf⟩ := hbox (p.1, p.2, false) hpe
    have := (alg ((qC B.h ξ ^ (-B.h) * Qb p.1 ^ (-(1/2:ℝ))) ^ 2) (Real.sqrt (epsb B.h p.1) ^ 2)
      (etaL B.h (p.1, p.2, true) ξ ^ 2) (yAmp4 B G (p.1, p.2, true) ξ) (yAmp4 B G (p.1, p.2, false) ξ)
      (Hcol B G (p.1, p.2, true) (ξ.1, ξ.2.1, ξ.2.2.1)).1 (Hcol B G (p.1, p.2, true) (ξ.1, ξ.2.1, ξ.2.2.1)).2
      (Hcol B G (p.1, p.2, false) (ξ.1, ξ.2.1, ξ.2.2.1)).1 (Hcol B G (p.1, p.2, false) (ξ.1, ξ.2.1, ξ.2.2.1)).2
      (qC B.h ξ ^ (2 * B.h) * Qb p.1 / epsb B.h p.1) (sigE5 B G l0 S 2 ξ) (sigE5 B G l0 S 1 ξ)
      hyt hyf hdet (hnorm p.1)).1
    have he' : etaL B.h (p.1, p.2, false) ξ = etaL B.h (p.1, p.2, true) ξ := rfl
    rw [← this, hKc]
    simp only [sigAmp5, sigPair5, Prod.smul_fst, Prod.smul_snd, smul_eq_mul, ite_true, ite_false,
      if_true, Bool.false_eq_true, he']
  · rw [m2, hsplit, ← (show sigE5 B G l0 S 1 ξ * ∑ p ∈ F', etaL B.h (p.1, p.2, true) ξ ^ 2 =
        sigE5 B G l0 S 1 ξ by rw [← hfs, hsum1, mul_one]), Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro p hp
    have hpe := hpF p hp
    obtain ⟨-, hdet, hyt⟩ := hbox (p.1, p.2, true) hpe
    obtain ⟨-, -, hyf⟩ := hbox (p.1, p.2, false) hpe
    have := (alg ((qC B.h ξ ^ (-B.h) * Qb p.1 ^ (-(1/2:ℝ))) ^ 2) (Real.sqrt (epsb B.h p.1) ^ 2)
      (etaL B.h (p.1, p.2, true) ξ ^ 2) (yAmp4 B G (p.1, p.2, true) ξ) (yAmp4 B G (p.1, p.2, false) ξ)
      (Hcol B G (p.1, p.2, true) (ξ.1, ξ.2.1, ξ.2.2.1)).1 (Hcol B G (p.1, p.2, true) (ξ.1, ξ.2.1, ξ.2.2.1)).2
      (Hcol B G (p.1, p.2, false) (ξ.1, ξ.2.1, ξ.2.2.1)).1 (Hcol B G (p.1, p.2, false) (ξ.1, ξ.2.1, ξ.2.2.1)).2
      (qC B.h ξ ^ (2 * B.h) * Qb p.1 / epsb B.h p.1) (sigE5 B G l0 S 2 ξ) (sigE5 B G l0 S 1 ξ)
      hyt hyf hdet (hnorm p.1)).2
    have he' : etaL B.h (p.1, p.2, false) ξ = etaL B.h (p.1, p.2, true) ξ := rfl
    rw [← this, hKc]
    simp only [sigAmp5, sigPair5, Prod.smul_fst, Prod.smul_snd, smul_eq_mul, ite_true, ite_false,
      if_true, Bool.false_eq_true, he']

theorem sw5_pm_smooth : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (S : CState) (Bo : ℝ), 7/10 ≤ Bo → StressIn5 B G l0 S Bo → StressTargetOK5 B G l0 S Bo →
    SignedClass5 B G l0 S Bo →
    ContDiffOn ℝ ∞ (pmP5 B G l0 (stressStep5 B G l0 S)) (DomC B.h (qsOf l0)) :=
by
  intro B G hok hG
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, ?_⟩
  intro l0 hl0 S Bo _hBo hIn _hT hSC

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs0 : 0 < qsOf l0 := by rw [hQb]; positivity
  have hqs1 : qsOf l0 ≤ 1 := by rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have hqB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le

  have hSt : StOrd5 B G l0 S (Bo + 2/5) (Bo + 1/2 - kapS) (Bo + 1/2 - kapS) (Bo + 1/2 - kapS) := hIn
  obtain ⟨-, hub, -, -, -⟩ := state_cyl_smooth_v5 B G l0 S _ _ _ _ hok hG hqB hSt
  obtain ⟨hDo, hqCs, hqC0, -, -, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hSt' := hSt
  unfold StOrd5 at hSt'
  obtain ⟨c1, -, c3, c4, c5, c6, -⟩ := hSt'

  have hAw' : InWg5 B G (qsOf l0) (min 1 (Bo + 1/2 - kapS)) (stressStep5 B G l0 S).Aw :=
    (pwr5_waveV_add B G hok (qsOf l0) hqs1 S.Aw _ _ _ c1 hSC.2.1).1
  have hPsi' : InM B (qsOf l0) (1/2) (stressStep5 B G l0 S).Psi := c3
  have hbdir' : InM B (qsOf l0) (1/2) (stressStep5 B G l0 S).bdir := c4
  have hShP' : ShellSupp B (stressStep5 B G l0 S).Psi := c5
  have hShb' : ShellSupp B (stressStep5 B G l0 S).bdir := c6
  generalize stressStep5 B G l0 S = T at hAw' hPsi' hbdir' hShP' hShb' ⊢
  have hmemD : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 :=
    fun ξ hξ => hξ
  have hfstS : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1) (DomC B.h (qsOf l0)) := contDiff_fst.contDiffOn

  have hper_e : ∀ (γ : Lab) (m : ℤ) (θ : ℝ) (ξ : Cyl),
      ephase5 B G γ m (θ + 2 * Real.pi) ξ = ephase5 B G γ m θ ξ := by
    intro γ m θ ξ
    simp only [ephase5]
    have e : Complex.I * (m : ℂ) * ((pint5 B G γ : ℂ) * ((θ + 2 * Real.pi : ℝ) : ℂ) +
        (kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)) =
        Complex.I * (m : ℂ) * ((pint5 B G γ : ℂ) * (θ : ℂ) + (kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)) +
        ((m * pint5 B G γ : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
      push_cast; ring
    rw [e, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]
  have hper_w : ∀ (θ : ℝ) (ξ : Cyl) (i : Fin 3),
      waveV5 B G T.Aw (θ + 2 * Real.pi) ξ i = waveV5 B G T.Aw θ ξ i := by
    intro θ ξ i
    simp only [waveV5, hper_e]
  have hterm := wave5_term_contDiffOn B G (qsOf l0) _ T.Aw hok hG hqB hAw'
  have hwave : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => waveV5 B G T.Aw p.1 p.2 i)
      (univ ×ˢ DomC B.h (qsOf l0)) := by
    intro i
    apply contDiffOn_of_locally_contDiffOn
    rintro ⟨θ₀, ξ₀⟩ ⟨-, hξ₀⟩
    obtain ⟨N, hNo, hξN, Γ, H, hΓ⟩ := wave5_locfin B G (qsOf l0) _ T.Aw hok hAw' ξ₀ hξ₀
    refine ⟨univ ×ˢ N, isOpen_univ.prod hNo, ⟨mem_univ _, hξN⟩, ?_⟩
    have h1 : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl =>
        ∑ γ ∈ Γ, ∑ m ∈ H, T.Aw γ m p.2 i * ephase5 B G γ m p.1 p.2) (univ ×ˢ DomC B.h (qsOf l0)) :=
      ContDiffOn.sum (fun γ _ => ContDiffOn.sum (fun m _ => hterm γ m i))
    have hsum := Complex.reCLM.contDiff.comp_contDiffOn h1
    refine (hsum.mono inter_subset_left).congr ?_
    rintro ⟨θ, ξ⟩ ⟨⟨-, hξD⟩, ⟨-, hξN'⟩⟩
    have hmem : ξ ∈ N ∩ DomC B.h (qsOf l0) := ⟨hξN', hξD⟩
    simp only [waveV5, Function.comp_apply, Complex.reCLM_apply]
    congr 1
    have hin : ∀ γ, ∑ᶠ m : ℤ, T.Aw γ m ξ i * ephase5 B G γ m θ ξ =
        ∑ m ∈ H, T.Aw γ m ξ i * ephase5 B G γ m θ ξ := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      rw [Function.mem_support] at hm
      have hne : T.Aw γ m ξ ≠ 0 := by
        intro h0; apply hm; simp [h0]
      exact Finset.mem_coe.mpr (hΓ ξ hmem γ m hne).2
    rw [finsum_congr hin]
    apply finsum_eq_sum_of_support_subset
    intro γ hγ
    rw [Function.mem_support] at hγ
    apply Finset.mem_coe.mpr
    by_contra hnot
    apply hγ
    apply Finset.sum_eq_zero
    intro m _
    have h0 : T.Aw γ m ξ = 0 := by
      by_contra h0
      exact hnot (hΓ ξ hmem γ m h0).1
    simp [h0]
  have hwθ : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ³ × Cyl => waveV5 B G T.Aw (thetaOf p.1) p.2 i)
      ({y : ℝ³ | 0 < rad y} ×ˢ DomC B.h (qsOf l0)) := fun i =>
    thetaOf_periodic_comp (DomC B.h (qsOf l0)) (fun q : ℝ × Cyl => waveV5 B G T.Aw q.1 q.2 i) (hwave i)
      (fun θ e => hper_w θ e i)
  have hAX := ax5_lift_contDiffOn B G l0 T hok hqB hPsi' hwθ
  have hucyl := ucyl5_of_ax5_lift B G l0 T hok hqB hbdir' hAX
  have hmc : ∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 T a) (DomC B.h (qsOf l0)) := by
    intro a
    have hI := cyl_param_integral_contDiffOn (DomC B.h (qsOf l0)) _ hDo (hucyl a)
    refine (((contDiffOn_const (c := (2 * Real.pi)⁻¹)).mul hI).sub (hub a)).congr (fun ξ _ => ?_)
    simp only [mcor5, thA]
  have hW : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (Wcov5 B G l0 T a b) (DomC B.h (qsOf l0)) := by
    intro a b
    have hMp : ∀ c : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => mcor5 B G l0 T c p.2 + ubase B p.2 c)
        (univ ×ˢ DomC B.h (qsOf l0)) :=
      fun c => ((hmc c).add (hub c)).comp contDiff_snd.contDiffOn (fun p hp => hp.2)
    have hg : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl =>
        (ucyl5 B G l0 T p.1 p.2 a - (mcor5 B G l0 T a p.2 + ubase B p.2 a)) *
        (ucyl5 B G l0 T p.1 p.2 b - (mcor5 B G l0 T b p.2 + ubase B p.2 b))) (univ ×ˢ DomC B.h (qsOf l0)) :=
      ((hucyl a).sub (hMp a)).mul ((hucyl b).sub (hMp b))
    have hI := cyl_param_integral_contDiffOn (DomC B.h (qsOf l0)) _ hDo hg
    refine ((contDiffOn_const (c := (2 * Real.pi)⁻¹)).mul hI).congr (fun ξ _ => ?_)
    simp only [Wcov5, thA, mcor5, sub_add_cancel]

  have hushell : ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) →
      ∀ (θ : ℝ) (b : Fin 3), ucyl5 B G l0 T θ ξ b = ubase B ξ b := by
    intro ξ hξ hsh
    obtain ⟨r, z, t, Y⟩ := ξ
    obtain ⟨hr, ht, hqs⟩ : 0 < r ∧ t < 1 ∧ qC B.h (r, z, t, Y) < qsOf l0 := hξ
    obtain ⟨hS1, -, -, hS4, -⟩ := hok.1
    obtain ⟨-, -, -, -, -, hVel, -⟩ := hok.2
    have hτ : 0 < 1 - t := by linarith
    obtain ⟨q, hqdef⟩ : ∃ q : ℝ, q = qC B.h (r, z, t, Y) := ⟨_, rfl⟩
    have hq : 0 < q := by rw [hqdef]; exact (hS1 z (1 - t) hτ).1
    have hqs' : q < qsOf l0 := by rw [hqdef]; exact hqs
    have hXC : XC B.h (r, z, t, Y) = r ^ 2 / (2 * q) := by rw [hqdef]; rfl
    have hc0 : ∀ ρ θ ζ : ℝ, rotPt ρ θ ζ 0 = ρ * Real.cos θ := by intro ρ θ ζ; simp [rotPt]
    have hc1 : ∀ ρ θ ζ : ℝ, rotPt ρ θ ζ 1 = ρ * Real.sin θ := by intro ρ θ ζ; simp [rotPt]
    have hc2 : ∀ ρ θ ζ : ℝ, rotPt ρ θ ζ 2 = ζ := by intro ρ θ ζ; simp [rotPt]
    have hsq : ∀ θ : ℝ, rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2 = r ^ 2 := by
      intro θ; rw [hc0, hc1]; linear_combination r ^ 2 * Real.cos_sq_add_sin_sq θ
    have hrad : ∀ θ : ℝ, rad (rotPt r θ z) = r := by
      intro θ
      show Real.sqrt (rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2) = r
      rw [hsq, Real.sqrt_sq hr.le]
    have hsx : ∀ θ : ℝ, simScale B.h (rotPt r θ z 2) (1 - t) = q := by
      intro θ; rw [hc2, hqdef]; rfl
    have hco : ∀ i : Fin 3, Continuous fun w : ℝ³ => w i := by
      intro i
      have h0 : Continuous (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) i) := ContinuousLinearMap.continuous _
      rwa [EuclideanSpace.coe_proj] at h0
    have hscont : Continuous fun y : ℝ³ => simScale B.h (y 2) (1 - t) := by
      have hg : Continuous fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ) := (hco 2).prodMk continuous_const
      exact hS4.continuousOn.comp_continuous hg (fun y => ⟨mem_univ _, hτ⟩)
    have hsum : Continuous fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2 := ((hco 0).pow 2).add ((hco 1).pow 2)
    obtain ⟨N, hN⟩ : ∃ N : Set ℝ³, N = {y | y 0 ^ 2 + y 1 ^ 2 < 2 * B.Xa * simScale B.h (y 2) (1 - t)} ∪
        {y | 2 * B.Xb * simScale B.h (y 2) (1 - t) < y 0 ^ 2 + y 1 ^ 2} := ⟨_, rfl⟩
    have hNo : IsOpen N := by
      rw [hN]
      exact (isOpen_lt hsum (continuous_const.mul hscont)).union (isOpen_lt (continuous_const.mul hscont) hsum)
    have hxN : ∀ θ : ℝ, rotPt r θ z ∈ N := by
      intro θ
      rw [hN]
      rcases hsh with h | h
      · refine Set.mem_union_left _ ?_
        show rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2 < 2 * B.Xa * simScale B.h (rotPt r θ z 2) (1 - t)
        rw [hsq, hsx]
        rw [hXC, div_lt_iff₀ (by linarith)] at h
        linarith
      · refine Set.mem_union_right _ ?_
        show 2 * B.Xb * simScale B.h (rotPt r θ z 2) (1 - t) < rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2
        rw [hsq, hsx]
        rw [hXC, lt_div_iff₀ (by linarith)] at h
        linarith
    have hshell : ∀ y ∈ N, ∀ Y' : ℝ × ℝ, corrOn B l0 y t →
        ptOf y t Y' ∈ DomC B.h (qsOf l0) ∧
          (XC B.h (ptOf y t Y') < B.Xa ∨ B.Xb < XC B.h (ptOf y t Y')) := by
      intro y hy Y' hc
      obtain ⟨hc1', hc2', hc3⟩ := hc
      refine ⟨(show ptOf y t Y' ∈ DomC B.h (qsOf l0) from ⟨hc1', hc2', hc3⟩), ?_⟩
      have hsy : 0 < simScale B.h (y 2) (1 - t) := (hS1 (y 2) (1 - t) hτ).1
      have hXy : XC B.h (ptOf y t Y') = (y 0 ^ 2 + y 1 ^ 2) / (2 * simScale B.h (y 2) (1 - t)) := by
        show rad y ^ 2 / (2 * simScale B.h (y 2) (1 - t)) = _
        rw [rad, Real.sq_sqrt (by positivity)]
      rw [hXy]
      rw [hN] at hy
      rcases hy with h | h
      · have h' : y 0 ^ 2 + y 1 ^ 2 < 2 * B.Xa * simScale B.h (y 2) (1 - t) := h
        left
        rw [div_lt_iff₀ (by linarith)]
        linarith
      · have h' : 2 * B.Xb * simScale B.h (y 2) (1 - t) < y 0 ^ 2 + y 1 ^ 2 := h
        right
        rw [lt_div_iff₀ (by linarith)]
        linarith
    have hAX : ∀ y ∈ N, ∀ Y' : ℝ × ℝ, AX5 B G l0 T y t Y' = B.AB y t := by
      intro y hy Y'
      unfold AX5
      by_cases hc : corrOn B l0 y t
      · rw [if_pos hc]
        obtain ⟨hD, hsh'⟩ := hshell y hy Y' hc
        have hz : ∀ γ m, T.Aw γ m (ptOf y t Y') = 0 := by
          intro γ m
          by_contra hne
