      (∫ v in Ioi (Real.log x), w v * rfpE P v e ^ 2) =
        (∫ v in (Real.log x)..Y, w v * rfpE P v e ^ 2) + ∫ v in Ioi Y, w v * rfpE P v 0 ^ 2 := by
    intro w e hwc hw he1 he2
    have hf0c : Continuous (fun v => w v * rfpE P v 0 ^ 2) :=
