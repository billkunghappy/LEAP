    rw [hetw, hu]
    refine lim (fun η => |lamT ((w η).1 - ((round (w ξ).1 : ℤ) : ℝ),
      (w η).2 - ((round (w ξ).2 : ℤ) : ℝ))|) _ (Set.Iic G.r0) ?_ hξN isClosed_Iic ?_
    · apply Continuous.continuousAt; unfold lamT; fun_prop
    · intro η hη
      simp only [Set.mem_Iic]
      rw [← hfreeze η hη]
      have := (hSS η hη.2).2.2.2.1
      rw [hetw] at this
      exact this
  have hSuppξ : SuppW B G γ ξ := ⟨hS0.1, htsE, hxi, het, hXa', hXb'⟩

  have hAct4 : ActiveL4 B G γ := by
    have hO : IsOpen (DomC B.h (qsOf l0) ∩ f ⁻¹' {0}ᶜ) :=
      hfc.isOpen_inter_preimage hDopen isOpen_compl_singleton
    obtain ⟨ξ2, ⟨hξ2U, hξ2f⟩, hξ2e⟩ := mem_closure_iff.mp hS0.2.1 _ hO ⟨hη0U, hη0⟩
    have hs := hSupp ξ2 hξ2U hξ2f
    refine ⟨hS0.1.1, ξ2, ?_, hξ2e, hs.2.2.2.2.1, hs.2.2.2.2.2⟩
    have h' : 0 < ξ2.1 ∧ ξ2.2.2.1 < 1 ∧ qC B.h ξ2 < qsOf l0 := hξ2U
    exact ⟨h'.1, h'.2.1, lt_of_lt_of_le h'.2.2 hqsB⟩

  have hq1 : ∀ l : ℕ, (2:ℝ) ^ (1 - (l:ℝ)) = 2 * Qb l := by
    intro l
    rw [sub_eq_add_neg, Real.rpow_add two_pos, Real.rpow_one]; rfl
  have hq2 : ∀ l : ℕ, (2:ℝ) ^ (-1 - (l:ℝ)) = Qb l / 2 := by
    intro l
    rw [sub_eq_add_neg, Real.rpow_add two_pos, Real.rpow_neg_one]; unfold Qb; ring
  have band_pt : ∀ η ∈ DomC B.h (qsOf l0), etaL B.h γ η ≠ 0 →
      Qb γ.1 / 2 < qC B.h η ∧ qC B.h η < 2 * Qb γ.1 := by
    intro η hη hne
    have hq := hqpos η hη
    have h1 : sqPart 1 (-(γ.1:ℤ)) (Real.logb 2 (qC B.h η)) ≠ 0 := left_ne_zero_of_mul hne
    unfold sqPart at h1
    have h2 := (div_ne_zero_iff.mp h1).1
    unfold bumpR at h2
    have h3 : 0 < 1 - (Real.logb 2 (qC B.h η) / 1 - ((-(γ.1:ℤ) : ℤ) : ℝ)) ^ 2 := by
      by_contra hcon
      exact h2 (Real.smoothTransition.zero_of_nonpos (not_lt.mp hcon))
    have h4 : (Real.logb 2 (qC B.h η) / 1 - ((-(γ.1:ℤ) : ℤ) : ℝ)) =
        Real.logb 2 (qC B.h η) + (γ.1 : ℝ) := by
      push_cast; ring
    rw [h4] at h3
    have h5 : |Real.logb 2 (qC B.h η) + (γ.1 : ℝ)| < 1 :=
      (sq_lt_one_iff_abs_lt_one _).mp (by linarith)
    rw [abs_lt] at h5
    have e1 : Real.logb 2 (qC B.h η) < 1 - (γ.1:ℝ) := by linarith
    have e2 : -1 - (γ.1:ℝ) < Real.logb 2 (qC B.h η) := by linarith
    rw [Real.logb_lt_iff_lt_rpow one_lt_two hq, hq1] at e1
    rw [Real.lt_logb_iff_rpow_lt one_lt_two hq, hq2] at e2
    exact ⟨e2, e1⟩
  have hξE : ξ ∈ closure (DomC B.h (qsOf l0) ∩ Function.support (etaL B.h γ)) :=
    hDopen.inter_closure ⟨hξ, htsE⟩
  have hband : qC B.h ξ ∈ Set.Icc (Qb γ.1 / 2) (2 * Qb γ.1) :=
    lim (qC B.h) _ _ (hqcont ξ hξ) hξE isClosed_Icc
      (fun η hη => ⟨(band_pt η hη.1 hη.2).1.le, (band_pt η hη.1 hη.2).2.le⟩)
  have hQpos : 0 < Qb γ.1 := Real.rpow_pos_of_pos two_pos _
  have hl : l0 ≤ γ.1 := by
    have h1 : (2:ℝ) ^ (-1 - (γ.1:ℝ)) < (2:ℝ) ^ (-(l0:ℝ)) := by
      calc (2:ℝ) ^ (-1 - (γ.1:ℝ)) = Qb γ.1 / 2 := hq2 _
        _ ≤ qC B.h ξ := hband.1
        _ < qsOf l0 := hξ'.2.2
        _ = (2:ℝ) ^ (-(l0:ℝ)) := rfl
    rw [Real.rpow_lt_rpow_left_iff one_lt_two] at h1
    have h2 : (l0:ℝ) < (γ.1:ℝ) + 1 := by linarith
    have h3 : l0 < γ.1 + 1 := by exact_mod_cast h2
    omega
  have hXb0 : 0 < B.Xb := by linarith
  refine ⟨hSuppξ, hAct4, hl, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [lt_div_iff₀ hQpos]; linarith [hband.1]
  · rw [div_lt_iff₀ hQpos]; linarith [hband.2]
  · linarith
  · linarith
  · linarith
  · linarith

theorem ujet5_ring_v5 : ∀ {ι : Type} (h : ℝ) (P : ι → Cyl → Prop) (f g : ι → Cyl → ℝ),
    UJet5 h P f → UJet5 h P g →
    UJet5 h P (fun i η => f i η * g i η) ∧ UJet5 h P (fun i η => f i η + g i η) :=
by
  intro ι h P f g hf hg
  obtain ⟨hfs, hfb⟩ := hf
  obtain ⟨hgs, hgb⟩ := hg

  have mulb : ∀ (ξ : Cyl) (a b : Cyl → ℝ) (k : ℕ) (A E : ℝ), ContDiffAt ℝ ∞ a ξ →
      ContDiffAt ℝ ∞ b ξ → (∀ i : ℕ, i ≤ k → NB h a i ξ ≤ A) →
      (∀ i : ℕ, i ≤ k → NB h b i ξ ≤ E) → NB h (fun η => a η * b η) k ξ ≤ 2 ^ k * A * E := by
    intro ξ a b k A E ha hb hA hE
    have hNBnn : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (i : ℕ),
        0 ≤ NB h f i ξ := fun f i => norm_nonneg _
    have leib : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (U : Set Cyl) (n : ℕ),
        IsOpen U → ξ ∈ U → ∀ (f : Cyl → ℝ) (g : Cyl → V), ContDiffOn ℝ n f U → ContDiffOn ℝ n g U →
        NB h (fun η => f η • g η) n ξ ≤
          ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * NB h f i ξ * NB h g (n - i) ξ := by
      intro V _ _ U n hU hξ f g hf hg
      unfold NB
      generalize Lnorm h ξ = L
      obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
      have hs : IsOpen s := by
        rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
      have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
      have h0s : (0 : Cyl) ∈ s := by
        rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
      have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
      have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
      have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + z)) s := by
        intro W _ _ F hF
        exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
          (fun z hz => by rw [hs_def] at hz; exact hz)
      have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
        intro W _ _ F hF
        exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
      have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ∀ i : ℕ, i ≤ n →
          iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
            (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
        intro W _ _ F hF i hi
        have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
        have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
          hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
        have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
        have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
        calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
            = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
          _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
                (fun _ => L) := e2
          _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
                (fun _ => L) := by rw [map_zero]
          _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
                (fun _ => L) := by rw [e3]
          _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
      have hfg : ContDiffOn ℝ n (fun η => f η • g η) U := hf.smul hg
      have hl := norm_iteratedFDerivWithin_smul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
        (n := n) le_rfl
      rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) • g (ξ + L y)) n hO h0O] at hl
      rw [← key _ hfg n le_rfl]
      calc ‖iteratedFDeriv ℝ n (fun z => (fun η => f η • g η) (ξ + L z)) 0‖
          = ‖iteratedFDeriv ℝ n (fun y => f (ξ + L y) • g (ξ + L y)) 0‖ := rfl
        _ ≤ _ := hl
        _ = _ := by
          apply Finset.sum_congr rfl
          intro i hi
          have hik : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
            iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (n - i) hO h0O,
            key f hf i hik, key g hg (n - i) (Nat.sub_le n i)]
    have hA0 : 0 ≤ A := le_trans (hNBnn a 0) (hA 0 (Nat.zero_le k))
    have hE0 : 0 ≤ E := le_trans (hNBnn b 0) (hE 0 (Nat.zero_le k))
    have ha' : ContDiffAt ℝ k a ξ := ha.of_le (by exact_mod_cast le_top)
    have hb' : ContDiffAt ℝ k b ξ := hb.of_le (by exact_mod_cast le_top)
    obtain ⟨ua, hua, hau⟩ := ha'.contDiffOn le_rfl (by simp)
    obtain ⟨ub, hub, hbu⟩ := hb'.contDiffOn le_rfl (by simp)
    obtain ⟨O, hOsub, hOopen, hξO⟩ := mem_nhds_iff.mp (Filter.inter_mem hua hub)
    have haO : ContDiffOn ℝ k a O := hau.mono (fun x hx => (hOsub hx).1)
    have hbO : ContDiffOn ℝ k b O := hbu.mono (fun x hx => (hOsub hx).2)
    have l1 := leib O k hOopen hξO a b haO hbO
    have l1' : NB h (fun η => a η * b η) k ξ ≤ ∑ i ∈ Finset.range (k + 1),
        (k.choose i : ℝ) * NB h a i ξ * NB h b (k - i) ξ := l1
    refine le_trans l1' ?_
    calc ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB h a i ξ * NB h b (k - i) ξ
        ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * A * E := by
          apply Finset.sum_le_sum
          intro i hi
          have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          exact mul_le_mul (mul_le_mul_of_nonneg_left (hA i hik) (Nat.cast_nonneg _))
            (hE _ (Nat.sub_le k i)) (hNBnn _ _) (mul_nonneg (Nat.cast_nonneg _) hA0)
      _ = A * E * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) := by
          rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro i _; ring
      _ = 2 ^ k * A * E := by
          have hs : ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) = 2 ^ k := by
            exact_mod_cast Nat.sum_range_choose k
          rw [hs]; ring

  have hSC : ∀ ξ, 1 ≤ SC h ξ := by
    intro ξ
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC h ξ)| := by linarith [abs_nonneg (Real.log (qC h ξ))]
    exact one_le_pow₀ this

  have hsm : ∀ i ξ, P i ξ → ∃ U : Set Cyl, IsOpen U ∧ ξ ∈ U ∧ ContDiffOn ℝ ∞ (f i) U ∧
      ContDiffOn ℝ ∞ (g i) U := by
    intro i ξ hP
    obtain ⟨U, hU, hξU, hfU⟩ := hfs i ξ hP
    obtain ⟨V, hV, hξV, hgV⟩ := hgs i ξ hP
    exact ⟨U ∩ V, hU.inter hV, ⟨hξU, hξV⟩, hfU.mono Set.inter_subset_left,
      hgV.mono Set.inter_subset_right⟩
  refine ⟨⟨fun i ξ hP => ?_, fun k => ?_⟩, ⟨fun i ξ hP => ?_, fun k => ?_⟩⟩
  · obtain ⟨U, hU, hξU, h1, h2⟩ := hsm i ξ hP
    exact ⟨U, hU, hξU, h1.mul h2⟩
  · choose Cf bf hCf using hfb
    choose Cg bg hCg using hgb
    refine ⟨2 ^ k * (∑ l ∈ Finset.range (k + 1), |Cf l|) * (∑ l ∈ Finset.range (k + 1), |Cg l|),
      (∑ l ∈ Finset.range (k + 1), |bf l|) + (∑ l ∈ Finset.range (k + 1), |bg l|),
      fun i ξ hP => ?_⟩
    obtain ⟨U, hU, hξU, h1, h2⟩ := hsm i ξ hP
    have hS1 := hSC ξ
    have hS0 : 0 < SC h ξ := lt_of_lt_of_le one_pos hS1
    have bnd : ∀ (C bb : ℕ → ℝ) (F : Cyl → ℝ), (∀ j, NB h F j ξ ≤ C j * SC h ξ ^ bb j) →
        ∀ j, j ≤ k → NB h F j ξ ≤ (∑ l ∈ Finset.range (k + 1), |C l|) *
          SC h ξ ^ (∑ l ∈ Finset.range (k + 1), |bb l|) := by
      intro C bb F hF j hj
      have hjm : j ∈ Finset.range (k + 1) := Finset.mem_range.mpr (Nat.lt_succ_of_le hj)
      have e1 : |C j| ≤ ∑ l ∈ Finset.range (k + 1), |C l| :=
        Finset.single_le_sum (f := fun l => |C l|) (fun l _ => abs_nonneg _) hjm
      have e2 : bb j ≤ ∑ l ∈ Finset.range (k + 1), |bb l| :=
        le_trans (le_abs_self _)
          (Finset.single_le_sum (f := fun l => |bb l|) (fun l _ => abs_nonneg _) hjm)
      have p1 : 0 ≤ SC h ξ ^ bb j := Real.rpow_nonneg hS0.le _
      have p2 : 0 ≤ SC h ξ ^ (∑ l ∈ Finset.range (k + 1), |bb l|) := Real.rpow_nonneg hS0.le _
      have m : SC h ξ ^ bb j ≤ SC h ξ ^ (∑ l ∈ Finset.range (k + 1), |bb l|) :=
        Real.rpow_le_rpow_of_exponent_le hS1 e2
      calc NB h F j ξ ≤ C j * SC h ξ ^ bb j := hF j
        _ ≤ |C j| * SC h ξ ^ bb j := mul_le_mul_of_nonneg_right (le_abs_self _) p1
        _ ≤ |C j| * SC h ξ ^ (∑ l ∈ Finset.range (k + 1), |bb l|) :=
            mul_le_mul_of_nonneg_left m (abs_nonneg _)
        _ ≤ (∑ l ∈ Finset.range (k + 1), |C l|) *
              SC h ξ ^ (∑ l ∈ Finset.range (k + 1), |bb l|) :=
            mul_le_mul_of_nonneg_right e1 p2
    have hmb := mulb ξ (f i) (g i) k _ _ (h1.contDiffAt (hU.mem_nhds hξU))
      (h2.contDiffAt (hU.mem_nhds hξU)) (bnd Cf bf (f i) (fun j => hCf j i ξ hP))
      (bnd Cg bg (g i) (fun j => hCg j i ξ hP))
    refine le_trans hmb (le_of_eq ?_)
    rw [Real.rpow_add hS0]
    ring
  · obtain ⟨U, hU, hξU, h1, h2⟩ := hsm i ξ hP
    exact ⟨U, hU, hξU, h1.add h2⟩
  · obtain ⟨C1, b1, hC1⟩ := hfb k
    obtain ⟨C2, b2, hC2⟩ := hgb k
    refine ⟨|C1| + |C2|, max b1 b2, fun i ξ hP => ?_⟩
    obtain ⟨U, hU, hξU, h1, h2⟩ := hsm i ξ hP
    have hS1 := hSC ξ
    have hS0 : 0 < SC h ξ := lt_of_lt_of_le one_pos hS1
    have hfA : ContDiffAt ℝ k (f i) ξ :=
      (h1.contDiffAt (hU.mem_nhds hξU)).of_le (by exact_mod_cast le_top)
    have hgA : ContDiffAt ℝ k (g i) ξ :=
      (h2.contDiffAt (hU.mem_nhds hξU)).of_le (by exact_mod_cast le_top)
    have hadd : NB h (fun η => f i η + g i η) k ξ ≤ NB h (f i) k ξ + NB h (g i) k ξ := by
      have e1 : iteratedFDeriv ℝ k (fun η => f i η + g i η) ξ =
          iteratedFDeriv ℝ k (f i) ξ + iteratedFDeriv ℝ k (g i) ξ :=
        iteratedFDeriv_add_apply hfA hgA
      unfold NB
      rw [e1]
      have e2 : (iteratedFDeriv ℝ k (f i) ξ + iteratedFDeriv ℝ k (g i) ξ).compContinuousLinearMap
            (fun _ => Lnorm h ξ) =
          (iteratedFDeriv ℝ k (f i) ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) +
          (iteratedFDeriv ℝ k (g i) ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) := by
        ext m
        simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      rw [e2]
      exact norm_add_le _ _
    have key : ∀ (C b : ℝ) (N : ℝ), N ≤ C * SC h ξ ^ b → b ≤ max b1 b2 →
        N ≤ |C| * SC h ξ ^ max b1 b2 := by
      intro C b N hN hb
      have p1 : 0 ≤ SC h ξ ^ b := Real.rpow_nonneg hS0.le _
      calc N ≤ C * SC h ξ ^ b := hN
        _ ≤ |C| * SC h ξ ^ b := mul_le_mul_of_nonneg_right (le_abs_self _) p1
        _ ≤ |C| * SC h ξ ^ max b1 b2 :=
            mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hS1 hb) (abs_nonneg _)
    have k1 := key C1 b1 _ (hC1 i ξ hP) (le_max_left _ _)
    have k2 := key C2 b2 _ (hC2 i ξ hP) (le_max_right _ _)
    have e : (|C1| + |C2|) * SC h ξ ^ max b1 b2 =
        |C1| * SC h ξ ^ max b1 b2 + |C2| * SC h ξ ^ max b1 b2 := by ring
    rw [e]
    linarith

theorem ujet5_inv_v5 : ∀ {ι : Type} (h : ℝ) (P : ι → Cyl → Prop) (f : ι → Cyl → ℝ) (c : ℝ),
    UJet5 h P f → 0 < c → (∀ i ξ, P i ξ → c ≤ f i ξ) → UJet5 h P (fun i η => (f i η)⁻¹) :=
by
  intro ι h P f c hf hc hlow
  obtain ⟨hf1, hf2⟩ := hf

  have key : ∀ (F : Cyl → ℝ) (V : Set Cyl) (a : Cyl) (T : Cyl →L[ℝ] Cyl), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  have hloc : ∀ i ξ, P i ξ → ∃ U : Set Cyl, IsOpen U ∧ ξ ∈ U ∧ ContDiffOn ℝ ∞ (f i) U ∧
      ∀ η ∈ U, 0 < f i η := by
    intro i ξ hi
    obtain ⟨U, hU, hξU, hfU⟩ := hf1 i ξ hi
    exact ⟨U ∩ f i ⁻¹' Set.Ioi 0, hfU.continuousOn.isOpen_inter_preimage hU isOpen_Ioi,
      ⟨hξU, lt_of_lt_of_le hc (hlow i ξ hi)⟩, hfU.mono Set.inter_subset_left, fun η hη => hη.2⟩
  have hinvs : ContDiffOn ℝ ∞ (fun x : ℝ => x⁻¹) (Set.Ioi 0) :=
    (contDiffOn_inv ℝ).mono (fun x hx => Set.mem_compl_singleton_iff.mpr (ne_of_gt hx))

  have hinvb : ∀ (j : ℕ) (y : ℝ), c ≤ y →
      ‖iteratedFDeriv ℝ j (fun x : ℝ => x⁻¹) y‖ ≤ (j.factorial : ℝ) * (1 / c) ^ (j + 1) := by
    intro j y hy
    have hy0 : 0 < y := lt_of_lt_of_le hc hy
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate]
    have e : (fun x : ℝ => x⁻¹) = Inv.inv := rfl
    rw [e, iter_deriv_inv]
    have e2 : (-1 - (j:ℤ)) = -((j + 1 : ℕ) : ℤ) := by push_cast; ring
    rw [e2, zpow_neg, zpow_natCast, norm_mul, norm_mul, norm_pow, norm_neg, norm_one, one_pow,
      one_mul, norm_inv, norm_pow, Real.norm_of_nonneg hy0.le, Real.norm_natCast]
    apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
    rw [one_div_pow, one_div]
    exact inv_anti₀ (pow_pos hc _) (pow_le_pow_left₀ hc.le hy _)
  refine ⟨fun i ξ hi => ?_, fun k => ?_⟩
  · obtain ⟨U, hU, hξU, hfU, hpos⟩ := hloc i ξ hi
    exact ⟨U, hU, hξU, hinvs.comp hfU (fun η hη => hpos η hη)⟩
  ·
    choose Cf bf hCf using hf2
    obtain ⟨M, hM⟩ : ∃ M : ℝ, M = max 1 (∑ j ∈ Finset.range (k + 1), |Cf j|) := ⟨_, rfl⟩
    obtain ⟨Bx, hBx⟩ : ∃ Bx : ℝ, Bx = ∑ j ∈ Finset.range (k + 1), |bf j| := ⟨_, rfl⟩
    obtain ⟨Cg, hCg⟩ : ∃ Cg : ℝ, Cg = (k.factorial : ℝ) * (max 1 (1 / c)) ^ (k + 1) := ⟨_, rfl⟩
    have hM1 : 1 ≤ M := by rw [hM]; exact le_max_left _ _
    have hBx0 : 0 ≤ Bx := by rw [hBx]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
    refine ⟨(k.factorial : ℝ) * Cg * M ^ k, Bx * k, fun i ξ hi => ?_⟩
    obtain ⟨U, hU, hξU, hfU, hpos⟩ := hloc i ξ hi
    have hS1 : (1:ℝ) ≤ SC h ξ := by
      unfold SC
      have : (1:ℝ) ≤ 1 + |Real.log (qC h ξ)| := by linarith [abs_nonneg (Real.log (qC h ξ))]
      exact one_le_pow₀ this
    have hS0 : (0:ℝ) ≤ SC h ξ := by linarith
    obtain ⟨D, hD⟩ : ∃ D : ℝ, D = M * SC h ξ ^ Bx := ⟨_, rfl⟩
    have hSB1 : 1 ≤ SC h ξ ^ Bx := Real.one_le_rpow hS1 hBx0
    have hD1 : 1 ≤ D := by rw [hD]; nlinarith
    have hNBf : ∀ j : ℕ, 1 ≤ j → j ≤ k → NB h (f i) j ξ ≤ D ^ j := by
      intro j hj1 hjk
      have hjm : j ∈ Finset.range (k + 1) := Finset.mem_range.mpr (by omega)
      have a1 := hCf j i ξ hi
      have a2 : Cf j * SC h ξ ^ bf j ≤ |Cf j| * SC h ξ ^ bf j :=
        mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hS0 _)
      have a3 : SC h ξ ^ bf j ≤ SC h ξ ^ Bx := by
        refine Real.rpow_le_rpow_of_exponent_le hS1 (le_trans (le_abs_self _) ?_)
        rw [hBx]
        exact Finset.single_le_sum (f := fun j => |bf j|) (fun j _ => abs_nonneg _) hjm
      have a4 : |Cf j| ≤ M := by
        rw [hM]
        exact le_trans (Finset.single_le_sum (f := fun j => |Cf j|) (fun j _ => abs_nonneg _) hjm)
          (le_max_right _ _)
      have a5 : |Cf j| * SC h ξ ^ bf j ≤ M * SC h ξ ^ Bx :=
        mul_le_mul a4 a3 (Real.rpow_nonneg hS0 _) (by linarith)
      calc NB h (f i) j ξ ≤ D := by rw [hD]; linarith
        _ ≤ D ^ j := le_self_pow₀ hD1 (by omega)
    have hcy : c ≤ f i ξ := hlow i ξ hi
    have hCgb : ∀ j : ℕ, j ≤ k → ‖iteratedFDeriv ℝ j (fun x : ℝ => x⁻¹) (f i ξ)‖ ≤ Cg := by
      intro j hj
      refine le_trans (hinvb j (f i ξ) hcy) ?_
      rw [hCg]
      have m1 : (1:ℝ) ≤ max 1 (1 / c) := le_max_left _ _
      have b1 : (1 / c) ^ (j + 1) ≤ (max 1 (1 / c)) ^ (j + 1) :=
        pow_le_pow_left₀ (by positivity) (le_max_right _ _) _
      have b2 : (max 1 (1 / c)) ^ (j + 1) ≤ (max 1 (1 / c)) ^ (k + 1) :=
        pow_le_pow_right₀ m1 (by omega)
      have b3 : (j.factorial : ℝ) ≤ k.factorial := by exact_mod_cast Nat.factorial_le hj
      exact mul_le_mul b3 (b1.trans b2) (by positivity) (by positivity)

    obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = (fun z => ξ + Lnorm h ξ z) ⁻¹' U := ⟨_, rfl⟩
    have hO : IsOpen O := by
      rw [hOdef]; exact hU.preimage (continuous_const.add (Lnorm h ξ).continuous)
    have h0O : (0 : Cyl) ∈ O := by
      rw [hOdef]; show ξ + Lnorm h ξ 0 ∈ U; rw [map_zero, add_zero]; exact hξU
    obtain ⟨Φ, hΦdef⟩ : ∃ Φ : Cyl → ℝ, Φ = fun z => f i (ξ + Lnorm h ξ z) := ⟨_, rfl⟩
    have hΦ : ContDiffOn ℝ ∞ Φ O := by
      rw [hΦdef]
      exact hfU.comp (contDiff_const.add (Lnorm h ξ).contDiff).contDiffOn
        (fun z hz => by rw [hOdef] at hz; exact hz)
    have hΦmaps : Set.MapsTo Φ O (Set.Ioi 0) := by
      intro z hz; rw [hΦdef]; rw [hOdef] at hz; exact hpos _ hz
    have hΦ0 : Φ 0 = f i ξ := by
      rw [hΦdef]; show f i (ξ + Lnorm h ξ 0) = f i ξ; rw [map_zero, add_zero]
    have hCw : ∀ j ≤ k, ‖iteratedFDerivWithin ℝ j (fun x : ℝ => x⁻¹) (Set.Ioi 0) (Φ 0)‖ ≤ Cg := by
      intro j hj
      rw [hΦ0, iteratedFDerivWithin_of_isOpen j isOpen_Ioi
        (show f i ξ ∈ Set.Ioi (0:ℝ) from hpos ξ hξU)]
      exact hCgb j hj
    have hDw : ∀ j, 1 ≤ j → j ≤ k → ‖iteratedFDerivWithin ℝ j Φ O 0‖ ≤ D ^ j := by
      intro j hj1 hjk
      rw [iteratedFDerivWithin_of_isOpen j hO h0O, hΦdef, key (f i) U ξ (Lnorm h ξ) hU hfU hξU j]
      exact hNBf j hj1 hjk
    have hFdB := norm_iteratedFDerivWithin_comp_le hinvs hΦ (by exact_mod_cast le_top)
      isOpen_Ioi.uniqueDiffOn hO.uniqueDiffOn hΦmaps h0O (C := Cg) (D := D) hCw hDw
    have hG : ContDiffOn ℝ ∞ (fun η => (f i η)⁻¹) U := hinvs.comp hfU (fun η hη => hpos η hη)
    have hNBeq : NB h (fun η => (f i η)⁻¹) k ξ =
        ‖iteratedFDeriv ℝ k (fun z => (f i (ξ + Lnorm h ξ z))⁻¹) 0‖ := by
      have := key (fun η => (f i η)⁻¹) U ξ (Lnorm h ξ) hU hG hξU k
      unfold NB
      rw [this]
    have hEq : (fun z => (f i (ξ + Lnorm h ξ z))⁻¹) = (fun x : ℝ => x⁻¹) ∘ Φ := by
      rw [hΦdef]; rfl
    calc NB h (fun η => (f i η)⁻¹) k ξ
        = ‖iteratedFDeriv ℝ k ((fun x : ℝ => x⁻¹) ∘ Φ) 0‖ := by rw [hNBeq, hEq]
      _ = ‖iteratedFDerivWithin ℝ k ((fun x : ℝ => x⁻¹) ∘ Φ) O 0‖ := by
          rw [iteratedFDerivWithin_of_isOpen k hO h0O]
      _ ≤ (k.factorial : ℝ) * Cg * D ^ k := hFdB
      _ = (k.factorial : ℝ) * Cg * M ^ k * SC h ξ ^ (Bx * k) := by
          rw [hD, mul_pow, ← Real.rpow_natCast (SC h ξ ^ Bx) k, ← Real.rpow_mul hS0]
          ring

theorem nb_cvec5_v5 : ∀ (h : ℝ) (U : Set Cyl) (ξ : Cyl) (z : ℂ) (N : Fin 3 → Cyl → ℝ), IsOpen U → ξ ∈ U →
    (∀ j, ContDiffOn ℝ ∞ (N j) U) →
    ContDiffOn ℝ ∞ (fun η j => z * ((N j η : ℝ) : ℂ)) U ∧
    ∀ k : ℕ, NB h (fun η j => z * ((N j η : ℝ) : ℂ)) k ξ ≤ ‖z‖ * ∑ j : Fin 3, NB h (N j) k ξ :=
by
  intro h U ξ z N hU hξ hN
  set G : Cyl → (Fin 3 → ℂ) := fun η j => z * ((N j η : ℝ) : ℂ) with hGdef
  set gc : ℝ →L[ℝ] ℂ := z • Complex.ofRealCLM with hgc
  have hgc_apply : ∀ r : ℝ, gc r = z * (r : ℂ) := by
    intro r
    simp [hgc, Complex.ofRealCLM_apply, smul_eq_mul]
  have s1 : ∀ j : Fin 3, (fun η => G η j) = ⇑gc ∘ N j := by
    intro j
    funext η
    simp only [Function.comp, hgc_apply, hGdef]
  have hA : ContDiffOn ℝ ∞ G U := by
    refine contDiffOn_pi.mpr (fun j => ?_)
    rw [s1 j]
    exact gc.contDiff.comp_contDiffOn (hN j)
  refine ⟨hA, ?_⟩
  intro k
  have hG : ContDiffAt ℝ ∞ G ξ := hA.contDiffAt (hU.mem_nhds hξ)
  have hNj : ∀ j, ContDiffAt ℝ ∞ (N j) ξ := fun j => (hN j).contDiffAt (hU.mem_nhds hξ)
  have hk : ((k : ℕ∞) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have s4 : ∀ (j : Fin 3) (v : Fin k → Cyl),
      iteratedFDeriv ℝ k G ξ v j = gc (iteratedFDeriv ℝ k (N j) ξ v) := by
    intro j v
    have ha := ContinuousLinearMap.iteratedFDeriv_comp_left
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) j) hG (i := k) hk
    have hb := ContinuousLinearMap.iteratedFDeriv_comp_left gc (hNj j) (i := k) hk
    have hc : (⇑(ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) j) ∘ G) =
        ⇑gc ∘ N j := by
      rw [← s1 j]; rfl
    rw [hc, hb] at ha
    have hd := congrArg (fun T => T v) ha
    simp only [ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp,
      ContinuousLinearMap.proj_apply] at hd
    exact hd.symm
  have hNB0 : ∀ i, 0 ≤ NB h (N i) k ξ := fun i => by unfold NB; exact norm_nonneg _
  have hM0 : 0 ≤ ‖z‖ * ∑ j : Fin 3, NB h (N j) k ξ :=
    mul_nonneg (norm_nonneg _) (Finset.sum_nonneg (fun i _ => hNB0 i))
  show ‖(iteratedFDeriv ℝ k G ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ ≤ _
  refine ContinuousMultilinearMap.opNorm_le_bound hM0 (fun m => ?_)
  have hQ : 0 ≤ ∏ i, ‖m i‖ := Finset.prod_nonneg (fun i _ => norm_nonneg _)
  refine (pi_norm_le_iff_of_nonneg (mul_nonneg hM0 hQ)).mpr (fun j => ?_)
  rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, s4, hgc_apply, norm_mul,
    Complex.norm_real]
  have h5 : ‖iteratedFDeriv ℝ k (N j) ξ (fun i => Lnorm h ξ (m i))‖ ≤
      NB h (N j) k ξ * ∏ i, ‖m i‖ := by
    have := ((iteratedFDeriv ℝ k (N j) ξ).compContinuousLinearMap
      (fun _ => Lnorm h ξ)).le_opNorm m
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply] at this
    unfold NB
    exact this
  have h6 : NB h (N j) k ξ ≤ ∑ i : Fin 3, NB h (N i) k ξ :=
    Finset.single_le_sum (fun i _ => hNB0 i) (Finset.mem_univ j)
  calc ‖z‖ * ‖iteratedFDeriv ℝ k (N j) ξ (fun i => Lnorm h ξ (m i))‖
      ≤ ‖z‖ * (NB h (N j) k ξ * ∏ i, ‖m i‖) := mul_le_mul_of_nonneg_left h5 (norm_nonneg _)
    _ ≤ ‖z‖ * ((∑ i : Fin 3, NB h (N i) k ξ) * ∏ i, ‖m i‖) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right h6 hQ) (norm_nonneg _)
    _ = ‖z‖ * (∑ j : Fin 3, NB h (N j) k ξ) * ∏ i, ‖m i‖ := by ring

theorem nPhi5_comp_ujet_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ,
    ∀ j : Fin 3, UJet5 B.h (GoodPt5 B G l1) (fun i η => nPhi5 B G i.2 η j) :=
by
  intro B G hB hG
  obtain ⟨hΩo, hbase⟩ := geom_slow_base_smooth_v5 B hB
  obtain ⟨l2, cr, Cr, hcr, hrep⟩ := rep_consts_v5 B G hB hG
  obtain ⟨l5, C5, h5⟩ := vco_nb_v5 B hB
  obtain ⟨l12, h12⟩ := slow_profile_dir_nb_v5 B hB
  choose C12 hC12 using h12
  choose C11 hC11 using inv_r_nb_v5 B hB
  obtain ⟨hh, hh1, hXa, -, -, -, -, hqB0, hqB1, -⟩ := hB.2.1
  have hr0 : 0 < G.r0 := hG.1.1
  have hr0' : G.r0 ≤ 1 / 100 := hG.1.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  obtain ⟨A, hAdef⟩ : ∃ A : ℕ → ℝ, A = fun k => ∑ j ∈ Finset.range (k + 1), (|C12 j| + |C11 j|) :=
    ⟨_, rfl⟩
  obtain ⟨Cf, hCf⟩ : ∃ Cf : ℕ → ℝ, Cf = fun k =>
      |Cr| * |G.ustar| + |Cr| + 2 ^ k * (8 * |C5| * |Cr| * A k) + |Cr| * A k := ⟨_, rfl⟩
  have main : ∀ (k : ℕ) (i : ℕ × Lab) (ξ : Cyl), GoodPt5 B G (l2 + l5 + l12 + n0) i ξ →
      (∃ U : Set Cyl, IsOpen U ∧ ξ ∈ U ∧ ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η => nPhi5 B G i.2 η j) U) ∧
      ∀ j : Fin 3, NB B.h (fun η => nPhi5 B G i.2 η j) k ξ ≤ Cf k * SC B.h ξ ^ (1:ℝ) := by
    intro k i ξ hi
    obtain ⟨l0, γ⟩ := i
    obtain ⟨hl0, hAct, hlγ, hξl, hwin1, hwin2, hX1, hX2, hxi, het⟩ := hi
    have hl0' : l2 + l5 + l12 + n0 ≤ l0 := hl0
    have hlγ' : l0 ≤ γ.1 := hlγ
    have hAct' : ActiveL4 B G γ := hAct
    have hξl' : ξ ∈ DomC B.h (qsOf l0) := hξl
    have hw1 : 1/4 < qC B.h ξ / Qb γ.1 := hwin1
    have hw2 : qC B.h ξ / Qb γ.1 < 4 := hwin2
    have hx1 : B.Xa / 2 < XC B.h ξ := hX1
    have hx2 : XC B.h ξ < 2 * B.Xb := hX2
    have hxi' : |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 := hxi
    have het' : |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 := het
    show (∃ U : Set Cyl, IsOpen U ∧ ξ ∈ U ∧ ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η => nPhi5 B G γ η j) U) ∧
      ∀ j : Fin 3, NB B.h (fun η => nPhi5 B G γ η j) k ξ ≤ Cf k * SC B.h ξ ^ (1:ℝ)
    have hCfk : Cf k = |Cr| * |G.ustar| + |Cr| + 2 ^ k * (8 * |C5| * |Cr| * A k) + |Cr| * A k := by
      rw [hCf]
    have hAk : A k = ∑ j ∈ Finset.range (k + 1), (|C12 j| + |C11 j|) := by rw [hAdef]

    have hQbq : qsOf l0 = (1/2:ℝ) ^ l0 := by
      show (2:ℝ) ^ (-(l0:ℝ)) = _
      rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
    have hqsB : qsOf l0 < B.qB := by
      rw [hQbq]
      exact lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0
    have hξ : ξ ∈ DomC B.h B.qB := ⟨hξl'.1, hξl'.2.1, lt_trans hξl'.2.2 hqsB⟩
    have hq : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).1
    have hq1 : qC B.h ξ < 1 := lt_of_lt_of_le hξ.2.2 hqB1
    have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
    have hql : qC B.h ξ < 4 * Qb γ.1 := by rwa [div_lt_iff₀ hQ] at hw2
    have hlog : Real.log (qC B.h ξ) < 0 := Real.log_neg hq hq1
    have hS1 : 1 ≤ SC B.h ξ := by
      unfold SC; nlinarith [abs_nonneg (Real.log (qC B.h ξ))]
    have hlS : (γ.1:ℝ) ^ 2 ≤ 4 * SC B.h ξ := by
      have h2 := Real.log_lt_log hq hql
      unfold Qb at h2
      rw [Real.log_mul (by norm_num) (Real.rpow_pos_of_pos (by norm_num) _).ne',
        Real.log_rpow (by norm_num)] at h2
      have h4 : Real.log 4 = 2 * Real.log 2 := by
        rw [show (4:ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; norm_num
      rw [h4] at h2
      have hl2 := Real.log_two_gt_d9
      have habs : |Real.log (qC B.h ξ)| = -Real.log (qC B.h ξ) := abs_of_neg hlog
      have hl0 : (0:ℝ) ≤ γ.1 := Nat.cast_nonneg _
      have hm : (γ.1:ℝ) * Real.log 2 < 2 * (1 + -Real.log (qC B.h ξ)) * Real.log 2 := by
        nlinarith [mul_nonneg (show 0 ≤ -Real.log (qC B.h ξ) by linarith)
          (show 0 ≤ 2 * Real.log 2 - 1 by linarith)]
      have hlb : (γ.1:ℝ) ≤ 2 * (1 + |Real.log (qC B.h ξ)|) := by
        rw [habs]; exact le_of_lt (lt_of_mul_lt_mul_right hm (by positivity))
      unfold SC
      nlinarith [mul_le_mul hlb hlb hl0 (by positivity)]
    have hqh1 : qC B.h ξ ^ B.h ≤ 1 := Real.rpow_le_one hq.le hq1.le hh.le

    have hNBn : ∀ (f : Cyl → ℝ) (j : ℕ), 0 ≤ NB B.h f j ξ := fun f j => norm_nonneg _
    have hgerm : ∀ (f g : Cyl → ℝ) (U : Set Cyl), IsOpen U → ξ ∈ U → (∀ η ∈ U, f η = g η) →
        ∀ j, NB B.h f j ξ = NB B.h g j ξ := by
      intro f g U hU hξU hfg j
      unfold NB
      rw [((Filter.eventuallyEq_of_mem (hU.mem_nhds hξU) hfg).iteratedFDeriv ℝ j).eq_of_nhds]

    set Ω := {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} with hΩe
    have hsQ : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr hQ
    have hsl : ContDiff ℝ ∞ (fun η : Cyl => (η.1, η.2.1, η.2.2.1)) := by fun_prop
    have hDo : IsOpen (DomC B.h B.qB) := hΩo.preimage hsl.continuous
    have hcs : ∀ f : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ f Ω →
        ContDiffOn ℝ ∞ (fun η : Cyl => f (η.1, η.2.1, η.2.2.1)) (DomC B.h B.qB) :=
      fun f hf => hf.comp hsl.contDiffOn (fun η hη => hη)
    have hRC : ∀ s ∈ Ω, pcRC5 γ.1 s ≠ 0 := fun s hs => div_ne_zero (ne_of_gt hs.1) hsQ.ne'
    have hRCs : ContDiff ℝ ∞ (pcRC5 γ.1) := by unfold pcRC5; fun_prop
    have hb : ∀ i, ContDiffOn ℝ ∞ (pcB5 B γ.1 i) Ω := fun i => hbase γ.1 i
    have hFa : ContDiffOn ℝ ∞ (pcFa5 B γ.1) Ω := (hb 1).div hRCs.contDiffOn hRC
    have hD : ∀ f : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ f Ω → ∀ e : ℝ × ℝ × ℝ,
        ContDiffOn ℝ ∞ (fun s => fderiv ℝ f s e) Ω := by
      intro f hf e
      first
      | exact ((contDiffOn_infty_iff_fderiv_of_isOpen hΩo).1 hf).2.clm_apply contDiffOn_const
      | exact (hf.fderiv_of_isOpen hΩo (by simp)).clm_apply contDiffOn_const
    have hsmF : ∀ F : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F Ω → ∀ e : ℝ × ℝ × ℝ,
        ContDiffOn ℝ ∞ (fun η : Cyl => Real.sqrt (Qb γ.1) * fderiv ℝ F (η.1, η.2.1, η.2.2.1) e)
          (DomC B.h B.qB) :=
      fun F hF e => contDiffOn_const.mul (hcs _ (hD F hF e))
    have hsplit : ∀ (e : ℝ × ℝ × ℝ), ∀ η ∈ DomC B.h B.qB,
        Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) e =
          pang5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) e) +
          pzr5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (η.1, η.2.1, η.2.2.1) e) := by
      intro e η hη
      have hs : (η.1, η.2.1, η.2.2.1) ∈ Ω := hη
      have dFa := ((hFa.contDiffAt (hΩo.mem_nhds hs)).differentiableAt (by simp)).hasFDerivAt
      have dB := (((hb 2).contDiffAt (hΩo.mem_nhds hs)).differentiableAt (by simp)).hasFDerivAt
      have hsum : fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) = _ :=
        ((dFa.const_mul (pang5 B G γ)).add (dB.const_mul (pzr5 B G γ))).fderiv
      rw [hsum]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring

    have hlin : ∀ (U : Set Cyl) (f g : Cyl → ℝ), IsOpen U → ξ ∈ U → ContDiffOn ℝ ∞ f U →
        ContDiffOn ℝ ∞ g U → ∀ (a b : ℝ) (j : ℕ),
        NB B.h (fun η => a * f η + b * g η) j ξ ≤ |a| * NB B.h f j ξ + |b| * NB B.h g j ξ :=
      fun U f g hU hξU hf hg a b j => (nb_real_algebra_v5 B.h U ξ hU hξU f g hf hg j).2.1 a b
    have hconst : ∀ (a : ℝ) (j : ℕ), NB B.h (fun _ : Cyl => a) j ξ ≤ |a| := by
      intro a j
      have := (nb_real_algebra_v5 B.h _ ξ hDo hξ (fun _ => a) (fun _ => a) contDiffOn_const
        contDiffOn_const j).2.2 a
      split_ifs at this <;> linarith [abs_nonneg a]
    have hprod : ∀ (U : Set Cyl) (f g : Cyl → ℝ), IsOpen U → ξ ∈ U → ContDiffOn ℝ ∞ f U →
        ContDiffOn ℝ ∞ g U → ∀ X Y : ℝ, 0 ≤ X → (∀ j, j ≤ k → NB B.h f j ξ ≤ X) →
        (∀ j, j ≤ k → NB B.h g j ξ ≤ Y) → NB B.h (fun η => f η * g η) k ξ ≤ 2 ^ k * (X * Y) := by
      intro U f g hU hξU hf hg X Y hX hfX hgY
      refine ((nb_real_algebra_v5 B.h U ξ hU hξU f g hf hg k).1).trans ?_
      calc ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB B.h f i ξ * NB B.h g (k - i) ξ
          ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * X * Y := by
            apply Finset.sum_le_sum
            intro i hi
            have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
            have hc : (0:ℝ) ≤ (k.choose i : ℝ) := Nat.cast_nonneg _
            exact mul_le_mul (mul_le_mul_of_nonneg_left (hfX i hik) hc) (hgY (k - i) (by omega))
              (hNBn _ _) (mul_nonneg hc hX)
        _ = 2 ^ k * (X * Y) := by
            rw [← Finset.sum_mul, ← Finset.sum_mul]
            have : (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ)) = 2 ^ k := by
              exact_mod_cast Nat.sum_range_choose k
            rw [this]; ring

    have hA : ∀ j, j ≤ k → |C12 j| ≤ A k ∧ |C11 j| ≤ A k := by
      intro j hj
      have h := Finset.single_le_sum (s := Finset.range (k + 1)) (f := fun j => |C12 j| + |C11 j|)
        (fun i _ => by positivity) (Finset.mem_range.2 (by omega : j < k + 1))
      have h' : |C12 j| + |C11 j| ≤ A k := by rw [hAk]; exact h
      refine ⟨?_, ?_⟩ <;> linarith [abs_nonneg (C12 j), abs_nonneg (C11 j)]
    have hA0 : 0 ≤ A k := by rw [hAk]; exact Finset.sum_nonneg (fun i _ => by positivity)
    have hl12 : l12 ≤ l0 := by omega
    have hl5 : l5 ≤ l0 := by omega
    obtain ⟨-, hpzC, hpaC, hBsC⟩ := hrep γ hAct' (by omega)
    have hpa : |pang5 B G γ| ≤ |Cr| := hpaC.trans (le_abs_self _)
    have hpz : |pzr5 B G γ| ≤ |Cr| := hpzC.trans (le_abs_self _)
    have hBs : |Bs5 B G γ| ≤ |Cr| := hBsC.trans (le_abs_self _)
    have hcrp : 0 ≤ |Cr| := abs_nonneg _
    have hFb : ∀ (e : ℝ × ℝ × ℝ), (e = ((1:ℝ), (0:ℝ), (0:ℝ)) ∨ e = ((0:ℝ), (1:ℝ), (0:ℝ))) →
        ∀ F : ℝ × ℝ × ℝ → ℝ, (F = pcFa5 B γ.1 ∨ F = pcB5 B γ.1 2) → ∀ j,
        NB B.h (fun η : Cyl => Real.sqrt (Qb γ.1) * fderiv ℝ F (η.1, η.2.1, η.2.2.1) e) j ξ ≤ |C12 j| := by
      intro e he F hF j
      have h := hC12 j γ.1 l0 hl12 hlγ' ξ hξl' hw1 hw2 hx1 hx2 F hF
      rcases he with rfl | rfl
      · exact h.1.trans (le_abs_self _)
      · refine h.2.trans ?_
        calc C12 j * qC B.h ξ ^ B.h ≤ |C12 j| * qC B.h ξ ^ B.h :=
              mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hq.le _)
          _ ≤ |C12 j| := mul_le_of_le_one_right (abs_nonneg _) hqh1
    have hPsi : ∀ (e : ℝ × ℝ × ℝ), (e = ((1:ℝ), (0:ℝ), (0:ℝ)) ∨ e = ((0:ℝ), (1:ℝ), (0:ℝ))) →
        ∀ j, j ≤ k → NB B.h (fun η : Cyl => Real.sqrt (Qb γ.1) *
          fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) e) j ξ ≤ 2 * |Cr| * A k := by
      intro e he j hj
      refine (hgerm _ _ _ hDo hξ (fun η hη => hsplit e η hη) j).trans_le ?_
      refine (hlin _ _ _ hDo hξ (hsmF _ hFa e) (hsmF _ (hb 2) e) _ _ j).trans ?_
      have h1 := hFb e he _ (Or.inl rfl) j
      have h2 := hFb e he _ (Or.inr rfl) j
      calc _ ≤ |Cr| * A k + |Cr| * A k :=
            add_le_add (mul_le_mul hpa (h1.trans (hA j hj).1) (hNBn _ _) (abs_nonneg _))
              (mul_le_mul hpz (h2.trans (hA j hj).1) (hNBn _ _) (abs_nonneg _))
        _ = 2 * |Cr| * A k := by ring

    obtain ⟨U1, c1, hU1o, hξU1, hU1sub, hU1⟩ := nPhi5_local_model_v5 B G γ ξ hB hξ hxi' het'
    obtain ⟨vf, hvf⟩ : ∃ f : Cyl → ℝ, f = fun η => vco B.h G.r0 γ (G.ctr γ) η.2.2.2 := ⟨_, rfl⟩
    obtain ⟨P0, hP0⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl => Real.sqrt (Qb γ.1) *
        fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) := ⟨_, rfl⟩
    obtain ⟨P2, hP2⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl => Real.sqrt (Qb γ.1) *
        fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)) := ⟨_, rfl⟩
    have hU1' : ∀ η ∈ U1, nPhi5 B G γ η 0 = sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 - vf η * P0 η ∧
        nPhi5 B G γ η 2 = pzr5 B G γ - vf η * P2 η := by
      intro η hη; rw [(hU1 η hη).2, hvf, hP0, hP2]; exact ⟨rfl, rfl⟩
    have hU1e : ∀ η ∈ U1, nPhi5 B G γ η 1 = pang5 B G γ * (Real.sqrt (Qb γ.1) / η.1) := by
      intro η hη
      rw [(hU1 η hη).2]
      show pang5 B G γ / RC γ.1 η = _
      unfold RC
      rw [div_div_eq_mul_div]; ring
    have hP2s : ContDiffOn ℝ ∞ (pcPhi2_5 B G γ) Ω :=
      (contDiffOn_const.mul hFa).add (contDiffOn_const.mul (hb 2))
    have hvS : ContDiffOn ℝ ∞ vf U1 := by
      rw [hvf]
      exact (show ContDiff ℝ ∞ (fun η : Cyl => Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1 * lamT η.2.2.2 + c1) by
        unfold lamT; fun_prop).contDiffOn.congr (fun η hη => (hU1 η hη).1)
    have hP0S : ContDiffOn ℝ ∞ P0 (DomC B.h B.qB) := by rw [hP0]; exact hsmF _ hP2s _
    have hP2S : ContDiffOn ℝ ∞ P2 (DomC B.h B.qB) := by rw [hP2]; exact hsmF _ hP2s _
    have hRi : ContDiffOn ℝ ∞ (fun η : Cyl => Real.sqrt (Qb γ.1) / η.1) (DomC B.h B.qB) :=
      contDiffOn_const.div (by fun_prop) (fun η hη => (ne_of_gt hη.1))
    have hUo : IsOpen (U1 ∩ DomC B.h B.qB) := hU1o.inter hDo
    have hξU : ξ ∈ U1 ∩ DomC B.h B.qB := ⟨hξU1, hξ⟩

    have hsm : ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η => nPhi5 B G γ η j) (U1 ∩ DomC B.h B.qB) := by
      intro j
      fin_cases j
      · exact (contDiffOn_const.sub ((hvS.mono Set.inter_subset_left).mul
          (hP0S.mono Set.inter_subset_right))).congr (fun η hη => (hU1' η hη.1).1)
      · exact (contDiffOn_const.mul (hRi.mono Set.inter_subset_right)).congr
          (fun η hη => hU1e η hη.1)
      · exact (contDiffOn_const.sub ((hvS.mono Set.inter_subset_left).mul
          (hP2S.mono Set.inter_subset_right))).congr (fun η hη => (hU1' η hη.1).2)
    refine ⟨⟨U1 ∩ DomC B.h B.qB, hUo, hξU, hsm⟩, ?_⟩

    have hvNB : ∀ j, NB B.h vf j ξ ≤ |C5| * (γ.1:ℝ) ^ 2 := by
      intro j; rw [hvf]
      exact (h5 γ G.r0 (G.ctr γ) l0 hr0.le hr0' hl5 hlγ' ξ hξl' hw1 hw2 hxi' het' j).trans
        (mul_le_mul_of_nonneg_right (le_abs_self _) (sq_nonneg _))
    have hvNB' : ∀ j, j ≤ k → NB B.h vf j ξ ≤ |C5| * (4 * SC B.h ξ) :=
      fun j _ => (hvNB j).trans (mul_le_mul_of_nonneg_left hlS (abs_nonneg _))
    have hP0NB : ∀ j, j ≤ k → NB B.h P0 j ξ ≤ 2 * |Cr| * A k := by
      intro j hj; rw [hP0]; exact hPsi _ (Or.inl rfl) j hj
    have hP2NB : ∀ j, j ≤ k → NB B.h P2 j ξ ≤ 2 * |Cr| * A k := by
      intro j hj; rw [hP2]; exact hPsi _ (Or.inr rfl) j hj
    have hvP : ∀ P : Cyl → ℝ, ContDiffOn ℝ ∞ P (DomC B.h B.qB) →
        (∀ j, j ≤ k → NB B.h P j ξ ≤ 2 * |Cr| * A k) →
        NB B.h (fun η => vf η * P η) k ξ ≤ 2 ^ k * (8 * |C5| * |Cr| * A k) * SC B.h ξ := by
      intro P hP hPb
      have h := hprod (U1 ∩ DomC B.h B.qB) vf P hUo hξU
        (hvS.mono Set.inter_subset_left) (hP.mono Set.inter_subset_right) _ _
        (by positivity) hvNB' hPb
      calc _ ≤ 2 ^ k * (|C5| * (4 * SC B.h ξ) * (2 * |Cr| * A k)) := h
        _ = 2 ^ k * (8 * |C5| * |Cr| * A k) * SC B.h ξ := by ring
    have hT : ∀ X : ℝ, 0 ≤ X → X ≤ Cf k → X ≤ Cf k * SC B.h ξ ^ (1:ℝ) := by
      intro X hX0 hX; rw [Real.rpow_one]; nlinarith
    have hT2 : ∀ X Y : ℝ, 0 ≤ X → 0 ≤ Y → X + Y ≤ Cf k →
        X + Y * SC B.h ξ ≤ Cf k * SC B.h ξ ^ (1:ℝ) := by
      intro X Y hX hY hXY; rw [Real.rpow_one]; nlinarith
    have hK1 : 0 ≤ 2 ^ k * (8 * |C5| * |Cr| * A k) := by positivity
    have hcA : 0 ≤ |Cr| * A k := mul_nonneg hcrp hA0

    have hn0 : NB B.h (fun η => nPhi5 B G γ η 0) k ξ ≤ Cf k * SC B.h ξ ^ (1:ℝ) := by
      rw [hgerm _ (fun η => (sgn γ.2.2 * Bs5 B G γ * G.ustar / 2) * 1 + (-1) * (vf η * P0 η)) U1 hU1o hξU1
        (fun η hη => by rw [(hU1' η hη).1]; ring) k]
      refine (hlin (U1 ∩ DomC B.h B.qB) _ _ hUo hξU contDiffOn_const
        ((hvS.mono Set.inter_subset_left).mul (hP0S.mono Set.inter_subset_right)) _ _ k).trans ?_
      have hc1 := hconst 1 k
      have hsg : |sgn γ.2.2 * Bs5 B G γ * G.ustar / 2| ≤ |Cr| * |G.ustar| := by
        have hs : |sgn γ.2.2| = 1 := by unfold sgn; split_ifs <;> simp
        rw [abs_div, abs_mul, abs_mul, hs, one_mul, abs_two]
        nlinarith [abs_nonneg (Bs5 B G γ), abs_nonneg G.ustar,
          mul_le_mul_of_nonneg_right hBs (abs_nonneg G.ustar)]
      have hv := hvP P0 hP0S hP0NB
      rw [abs_one] at hc1
      have : |sgn γ.2.2 * Bs5 B G γ * G.ustar / 2| * NB B.h (fun _ : Cyl => (1:ℝ)) k ξ ≤
          |Cr| * |G.ustar| :=
        (mul_le_mul hsg hc1 (hNBn _ _) (by positivity)).trans (le_of_eq (mul_one _))
      have e := hT2 (|Cr| * |G.ustar|) (2 ^ k * (8 * |C5| * |Cr| * A k)) (by positivity) hK1 (by
        rw [hCfk]; linarith)
      rw [abs_neg, abs_one, one_mul]
      linarith

    have hn2 : NB B.h (fun η => nPhi5 B G γ η 2) k ξ ≤ Cf k * SC B.h ξ ^ (1:ℝ) := by
      rw [hgerm _ (fun η => pzr5 B G γ * 1 + (-1) * (vf η * P2 η)) U1 hU1o hξU1
        (fun η hη => by rw [(hU1' η hη).2]; ring) k]
      refine (hlin (U1 ∩ DomC B.h B.qB) _ _ hUo hξU contDiffOn_const
        ((hvS.mono Set.inter_subset_left).mul (hP2S.mono Set.inter_subset_right)) _ _ k).trans ?_
      have hc1 := hconst 1 k
      rw [abs_one] at hc1
      have hv := hvP P2 hP2S hP2NB
      have : |pzr5 B G γ| * NB B.h (fun _ : Cyl => (1:ℝ)) k ξ ≤ |Cr| :=
        (mul_le_mul hpz hc1 (hNBn _ _) hcrp).trans (le_of_eq (mul_one _))
      have hus : 0 ≤ |Cr| * |G.ustar| := mul_nonneg hcrp (abs_nonneg _)
      have e := hT2 |Cr| (2 ^ k * (8 * |C5| * |Cr| * A k)) hcrp hK1 (by
        rw [hCfk]; linarith)
      rw [abs_neg, abs_one, one_mul]
      linarith

    have hn1 : NB B.h (fun η => nPhi5 B G γ η 1) k ξ ≤ Cf k * SC B.h ξ ^ (1:ℝ) := by
      rw [hgerm _ (fun η => pang5 B G γ * (Real.sqrt (Qb γ.1) / η.1) + 0 * (Real.sqrt (Qb γ.1) / η.1))
        U1 hU1o hξU1 (fun η hη => by rw [hU1e η hη]; ring) k]
      refine (hlin _ _ _ hDo hξ hRi hRi _ _ k).trans ?_
      have hI : NB B.h (fun η : Cyl => Real.sqrt (Qb γ.1) / η.1) k ξ ≤ A k :=
        (hC11 k γ.1 ξ hξ.1 hξ.2.1 hw1 hx1).trans ((le_abs_self _).trans (hA k le_rfl).2)
      have hus : 0 ≤ |Cr| * |G.ustar| := mul_nonneg hcrp (abs_nonneg _)
      have e := hT (|Cr| * A k) hcA (by rw [hCfk]; linarith)
      rw [abs_zero, zero_mul, add_zero]
      exact (mul_le_mul hpa hI (hNBn _ _) hcrp).trans e
    intro j
    fin_cases j
    · exact hn0
    · exact hn1
    · exact hn2
  refine ⟨l2 + l5 + l12 + n0, fun j => ?_⟩
  unfold UJet5
  refine ⟨fun i ξ hi => ?_, fun k => ⟨Cf k, 1, fun i ξ hi => (main k i ξ hi).2 j⟩⟩
  obtain ⟨U, hUo, hξU, hU⟩ := (main 0 i ξ hi).1
  exact ⟨U, hUo, hξU, hU j⟩

theorem nPhi5_nsq_lower_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ (l1 : ℕ) (c0 : ℝ), 0 < c0 ∧
    ∀ i ξ, GoodPt5 B G l1 i ξ → c0 ≤ dotProduct (nPhi5 B G i.2 ξ) (nPhi5 B G i.2 ξ) :=
by
  intro B G hB hG
  obtain ⟨hΩo, hbase⟩ := geom_slow_base_smooth_v5 B hB
  obtain ⟨l2, cr, Cr, hcr, hrep⟩ := rep_consts_v5 B G hB hG
  obtain ⟨l5, C5, h5⟩ := vco_nb_v5 B hB
  obtain ⟨l12, h12⟩ := slow_profile_dir_nb_v5 B hB
  obtain ⟨C12, hC12⟩ := h12 0
  obtain ⟨hh, hh1, hXa, -, -, -, -, hqB0, hqB1, -⟩ := hB.2.1
  have hr0 : 0 < G.r0 := hG.1.1
  have hr0' : G.r0 ≤ 1 / 100 := hG.1.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  set ρ : ℝ := (2:ℝ) ^ (-B.h) with hρ
  have hρ0 : 0 < ρ := Real.rpow_pos_of_pos (by norm_num) _
  have hρ1 : ρ < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  set Λ : ℝ := 8 * |C5| * |Cr| * |C12| + 1 with hΛ
  have hΛ0 : 0 < Λ := by positivity
  have hlim := tendsto_pow_const_mul_const_pow_of_abs_lt_one 2
    (show |ρ| < 1 by rw [abs_of_pos hρ0]; exact hρ1)
  obtain ⟨L, hL⟩ := Filter.eventually_atTop.1
    (Filter.Tendsto.eventually_lt_const (show (0:ℝ) < cr / (2 * Λ) by positivity) hlim)
  refine ⟨l2 + l5 + l12 + n0 + L, (cr / 2) ^ 2, by positivity, ?_⟩
  rintro ⟨l0, γ⟩ ξ hi
  obtain ⟨hl0, hAct, hlγ, hξ, hw1, hw2, hX1, hX2, hxi, het⟩ := hi
  change l2 + l5 + l12 + n0 + L ≤ l0 at hl0
  change ActiveL4 B G γ at hAct
  change l0 ≤ γ.1 at hlγ
  change ξ ∈ DomC B.h (qsOf l0) at hξ
  change 1/4 < qC B.h ξ / Qb γ.1 at hw1
  change qC B.h ξ / Qb γ.1 < 4 at hw2
  change |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 at hxi
  change |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 at het
  show (cr / 2) ^ 2 ≤ dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ)

  have hq : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).1
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hξB : ξ ∈ DomC B.h B.qB := ⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqsB⟩
  have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have hql : qC B.h ξ < 4 * Qb γ.1 := by rwa [div_lt_iff₀ hQ] at hw2
  have hqh : qC B.h ξ ^ B.h ≤ 4 * ρ ^ γ.1 := by
    have e1 : qC B.h ξ ^ B.h ≤ (4 * Qb γ.1) ^ B.h := Real.rpow_le_rpow hq.le hql.le hh.le
    rw [Real.mul_rpow (by norm_num) hQ.le] at e1
    have e2 : (4:ℝ) ^ B.h ≤ 4 := by
      calc (4:ℝ) ^ B.h ≤ 4 ^ (1:ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
        _ = 4 := Real.rpow_one 4
    have e3 : Qb γ.1 ^ B.h = ρ ^ γ.1 := by
      rw [hρ]; unfold Qb
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_mul (by norm_num)]
      congr 1; ring
    rw [e3] at e1
    have : 0 ≤ ρ ^ γ.1 := pow_nonneg hρ0.le _
    nlinarith
  have hNB0 : ∀ f : Cyl → ℝ, |f ξ| ≤ NB B.h f 0 ξ := by
    intro f
    have := ContinuousMultilinearMap.le_opNorm
      ((iteratedFDeriv ℝ 0 f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) (fun _ => 0)
    simpa [NB, iteratedFDeriv_zero_apply] using this

  set Ω := {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} with hΩe
  have hsQ : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr hQ
  have hRC : ∀ s ∈ Ω, pcRC5 γ.1 s ≠ 0 := fun s hs => div_ne_zero (ne_of_gt hs.1) hsQ.ne'
  have hRCs : ContDiff ℝ ∞ (pcRC5 γ.1) := by unfold pcRC5; fun_prop
  have hb : ∀ i, ContDiffOn ℝ ∞ (pcB5 B γ.1 i) Ω := fun i => hbase γ.1 i
  have hFa : ContDiffOn ℝ ∞ (pcFa5 B γ.1) Ω := (hb 1).div hRCs.contDiffOn hRC
  have hsplit : ∀ (e : ℝ × ℝ × ℝ),
      Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) (ξ.1, ξ.2.1, ξ.2.2.1) e =
        pang5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) e) +
        pzr5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) e) := by
    intro e
    have hs : (ξ.1, ξ.2.1, ξ.2.2.1) ∈ Ω := hξB
    have dFa := ((hFa.contDiffAt (hΩo.mem_nhds hs)).differentiableAt (by simp)).hasFDerivAt
    have dB := (((hb 2).contDiffAt (hΩo.mem_nhds hs)).differentiableAt (by simp)).hasFDerivAt
    have hsum : fderiv ℝ (pcPhi2_5 B G γ) (ξ.1, ξ.2.1, ξ.2.2.1) = _ :=
      ((dFa.const_mul (pang5 B G γ)).add (dB.const_mul (pzr5 B G γ))).fderiv
    rw [hsum]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring

  obtain ⟨hpzlow, hpzC, hpaC, -⟩ := hrep γ hAct (by omega)
  have hpa : |pang5 B G γ| ≤ |Cr| := hpaC.trans (le_abs_self _)
  have hpz : |pzr5 B G γ| ≤ |Cr| := hpzC.trans (le_abs_self _)

  obtain ⟨P2, hP2⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl => Real.sqrt (Qb γ.1) *
      fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)) := ⟨_, rfl⟩
  obtain ⟨vf, hvf⟩ : ∃ f : Cyl → ℝ, f = fun η => vco B.h G.r0 γ (G.ctr γ) η.2.2.2 := ⟨_, rfl⟩
  have hqn : 0 ≤ qC B.h ξ ^ B.h := Real.rpow_nonneg hq.le _
  have hZ : ∀ F : ℝ × ℝ × ℝ → ℝ, (F = pcFa5 B γ.1 ∨ F = pcB5 B γ.1 2) →
      |Real.sqrt (Qb γ.1) * fderiv ℝ F (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))| ≤
        |C12| * qC B.h ξ ^ B.h := by
    intro F hF
    have h := (hC12 γ.1 l0 (by omega) hlγ ξ hξ hw1 hw2 hX1 hX2 F hF).2
    refine ((hNB0 (fun η : Cyl => Real.sqrt (Qb γ.1) *
      fderiv ℝ F (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)))).trans h).trans ?_
    exact mul_le_mul_of_nonneg_right (le_abs_self _) hqn
  have hP20 : |P2 ξ| ≤ 2 * |Cr| * |C12| * qC B.h ξ ^ B.h := by
    have e : P2 ξ = pang5 B G γ * (Real.sqrt (Qb γ.1) *
          fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))) +
        pzr5 B G γ * (Real.sqrt (Qb γ.1) *
          fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))) := by
      rw [hP2]; exact hsplit _
    rw [e]
    have h1 := hZ _ (Or.inl rfl)
    have h2 := hZ _ (Or.inr rfl)
    refine (abs_add_le _ _).trans ?_
    rw [abs_mul (pang5 B G γ), abs_mul (pzr5 B G γ)]
    calc _ ≤ |Cr| * (|C12| * qC B.h ξ ^ B.h) + |Cr| * (|C12| * qC B.h ξ ^ B.h) :=
          add_le_add (mul_le_mul hpa h1 (abs_nonneg _) (abs_nonneg _))
            (mul_le_mul hpz h2 (abs_nonneg _) (abs_nonneg _))
      _ = 2 * |Cr| * |C12| * qC B.h ξ ^ B.h := by ring
  have hv0 : |vf ξ| ≤ |C5| * (γ.1:ℝ) ^ 2 := by
    refine (hNB0 vf).trans ?_
    rw [hvf]
    exact (h5 γ G.r0 (G.ctr γ) l0 hr0.le hr0' (by omega) hlγ ξ hξ hw1 hw2 hxi het 0).trans
      (mul_le_mul_of_nonneg_right (le_abs_self _) (sq_nonneg _))

  obtain ⟨U1, c1, hU1o, hξU1, hU1sub, hU1⟩ := nPhi5_local_model_v5 B G γ ξ hB hξB hxi het
  have hn2e : nPhi5 B G γ ξ 2 = pzr5 B G γ - vf ξ * P2 ξ := by
    rw [(hU1 ξ hξU1).2, hvf, hP2]; rfl
  have hvΨ : |vf ξ * P2 ξ| < cr / 2 := by
    have hLl : L ≤ γ.1 := by omega
    have hsm := hL γ.1 hLl
    have hρn : 0 ≤ (γ.1:ℝ) ^ 2 * ρ ^ γ.1 := by positivity
    rw [abs_mul]
    calc |vf ξ| * |P2 ξ| ≤ (|C5| * (γ.1:ℝ) ^ 2) * (2 * |Cr| * |C12| * (4 * ρ ^ γ.1)) :=
          mul_le_mul hv0 (hP20.trans (mul_le_mul_of_nonneg_left hqh (by positivity)))
            (abs_nonneg _) (by positivity)
      _ = (Λ - 1) * ((γ.1:ℝ) ^ 2 * ρ ^ γ.1) := by rw [hΛ]; ring
      _ ≤ Λ * ((γ.1:ℝ) ^ 2 * ρ ^ γ.1) := by nlinarith
      _ < Λ * (cr / (2 * Λ)) := mul_lt_mul_of_pos_left hsm hΛ0
      _ = cr / 2 := by field_simp
  have hn2 : cr / 2 < |nPhi5 B G γ ξ 2| := by
    rw [hn2e]
    have := abs_sub_abs_le_abs_sub (pzr5 B G γ) (vf ξ * P2 ξ)
    linarith
  rw [dotProduct, Fin.sum_univ_three]
  have h2 : (cr / 2) ^ 2 ≤ nPhi5 B G γ ξ 2 * nPhi5 B G γ ξ 2 := by
    rw [← abs_mul_abs_self]; nlinarith [abs_nonneg (nPhi5 B G γ ξ 2)]
  nlinarith [mul_self_nonneg (nPhi5 B G γ ξ 0), mul_self_nonneg (nPhi5 B G γ ξ 1)]

theorem nPhi5_deck_v5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (n0 : ℤ) (c : ℝ × ℝ), n0 ≤ bandIdx B.h γ.1 → (∃ a b : ℤ, Jpow n0 c = ((a : ℝ), (b : ℝ))) → ∀ ξ : Cyl, nPhi5 B G γ (shY ξ c) = nPhi5 B G γ ξ :=
by
  intro B G γ n0 c hn0 hlat ξ
  have hs : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
  have hs2 : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
  have hL : Lgc ≠ 0 := by unfold Lgc; intro h0; linarith
  have hT : Tgc ≠ 0 := by unfold Tgc; intro h0; linarith
  have hN : (1 + bgc ^ 2) ≠ 0 := by positivity
  have c1 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).1 = Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) * bgc := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have c2 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).2 = -(Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) * bgc) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have hcomp : ∀ (m n : ℤ) (Y : ℝ × ℝ), Jpow m (Jpow n Y) = Jpow (m + n) Y := by
    intro m n Y
    refine Prod.ext ?_ ?_
    · rw [c1 m, c1 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
      field_simp
      ring
    · rw [c2 m, c2 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
      field_simp
      ring
  have hid : ∀ Y : ℝ × ℝ, Jpow 0 Y = Y := by
    intro Y
    refine Prod.ext ?_ ?_
    · rw [c1, zpow_zero, zpow_zero]
      field_simp
      ring
    · rw [c2, zpow_zero, zpow_zero]
      field_simp
      ring
  have hNinv : ∀ x : ℝ, x / (1 + bgc ^ 2) = x * (2 + Real.sqrt 2) / 4 := by
    intro x
    rw [div_eq_div_iff hN (by norm_num)]
    unfold bgc
    linear_combination (-x * Real.sqrt 2) * hs
  have hJ1 : ∀ Y : ℝ × ℝ, Jpow 1 Y = (3 * Y.1 + Y.2, Y.1 + 5 * Y.2) := by
    intro Y
    refine Prod.ext ?_ ?_
    · rw [c1, zpow_one, zpow_one, hNinv, hNinv]
      unfold Lgc Tgc bgc
      linear_combination ((Real.sqrt 2 ^ 2 + 4 * Real.sqrt 2 - 2) * Y.1 + 2 * (Real.sqrt 2 + 1) * Y.2) / 4 * hs
    · rw [c2, zpow_one, zpow_one, hNinv, hNinv]
      unfold Lgc Tgc bgc
      linear_combination (2 * (Real.sqrt 2 + 1) * Y.1 - (Real.sqrt 2 ^ 2 - 4 * Real.sqrt 2 - 2) * Y.2) / 4 * hs
  have hint : ∀ k : ℕ, ∀ i j : ℤ, ∃ i' j' : ℤ,
      Jpow (k : ℤ) ((i : ℝ), (j : ℝ)) = ((i' : ℝ), (j' : ℝ)) := by
    intro k
    induction k with
    | zero => intro i j; exact ⟨i, j, by rw [Nat.cast_zero, hid]⟩
    | succ k ih =>
      intro i j
      obtain ⟨i', j', h'⟩ := ih i j
      refine ⟨3 * i' + j', i' + 5 * j', ?_⟩
      have e : ((k + 1 : ℕ) : ℤ) = 1 + (k : ℤ) := by push_cast; ring
      rw [e, ← hcomp 1 k, h', hJ1]
      push_cast
      rfl

  obtain ⟨a0, b0, hab⟩ := hlat
  obtain ⟨k, hk⟩ := Int.le.dest hn0
  have hJk : Jpow (bandIdx B.h γ.1) c = Jpow (k : ℤ) (Jpow n0 c) := by
    rw [hcomp, ← hk, add_comm]
  obtain ⟨a1, b1, hJk'⟩ := hint k a0 b0
  have hJc : Jpow (bandIdx B.h γ.1) c = ((a1 : ℝ), (b1 : ℝ)) := by
    rw [hJk, hab, hJk']

  have hadd : ∀ (n : ℤ) (Y W : ℝ × ℝ), Jpow n (Y + W) = Jpow n Y + Jpow n W := by
    intro n Y W
    refine Prod.ext ?_ ?_
    · rw [Prod.fst_add, c1 n (Y + W), c1 n Y, c1 n W, Prod.fst_add, Prod.snd_add]
      ring
    · rw [Prod.snd_add, c2 n (Y + W), c2 n Y, c2 n W, Prod.fst_add, Prod.snd_add]
      ring

  have hfr : ∀ (y : ℝ × ℝ) (a b : ℤ), frac0 (y + ((a : ℝ), (b : ℝ))) = frac0 y := by
    intro y a b
    have e1 : (y + ((a : ℝ), (b : ℝ))).1 = y.1 + (a : ℝ) := rfl
    have e2 : (y + ((a : ℝ), (b : ℝ))).2 = y.2 + (b : ℝ) := rfl
    unfold frac0
    rw [e1, e2, round_add_intCast, round_add_intCast]
    refine Prod.ext ?_ ?_
    · show y.1 + (a : ℝ) - (((round y.1 + a : ℤ)) : ℝ) = y.1 - ((round y.1 : ℤ) : ℝ)
      push_cast
      ring
    · show y.2 + (b : ℝ) - (((round y.2 + b : ℤ)) : ℝ) = y.2 - ((round y.2 : ℤ) : ℝ)
      push_cast
      ring
  have hrect : ∀ Y : ℝ × ℝ, rectW B.h γ (G.ctr γ) (Y + c) = rectW B.h γ (G.ctr γ) Y := by
    intro Y
    unfold rectW
    rw [hadd, hJc]
    have e : Jpow (bandIdx B.h γ.1) Y + ((a1 : ℝ), (b1 : ℝ)) - G.ctr γ =
        (Jpow (bandIdx B.h γ.1) Y - G.ctr γ) + ((a1 : ℝ), (b1 : ℝ)) := by abel
    rw [e, hfr]
  have hvco : ∀ Y : ℝ × ℝ, vco B.h G.r0 γ (G.ctr γ) (Y + c) = vco B.h G.r0 γ (G.ctr γ) Y := by
    intro Y
    unfold vco etG
    rw [hrect]
  have hphi : ∀ x : Cyl, phiL5 B G γ (shY x c) = phiL5 B G γ x := by
    intro x
    unfold phiL5
    have e : (shY x c).2.2.2 = x.2.2.2 + c := rfl
    rw [e, hvco]
    rfl
  obtain ⟨e, he⟩ : ∃ e : Cyl, e = ((0:ℝ), (0:ℝ), (0:ℝ), c) := ⟨_, rfl⟩
  have hsh : ∀ η : Cyl, shY η c = η + e := by
    intro η
    rw [he]
    simp only [shY]
    ext <;> simp
  have hF : (fun x => phiL5 B G γ (x + e)) = phiL5 B G γ := by
    funext x
    rw [← hsh x, hphi x]
  have hfd : fderiv ℝ (phiL5 B G γ) (shY ξ c) = fderiv ℝ (phiL5 B G γ) ξ := by
    rw [hsh ξ, ← fderiv_comp_add_right]
    exact congrArg (fun g => fderiv ℝ g ξ) hF
  funext i
  fin_cases i
  · show DrC B γ.1 (phiL5 B G γ) (shY ξ c) = DrC B γ.1 (phiL5 B G γ) ξ
    unfold DrC dR
    rw [hfd]
    rfl
  · rfl
  · show DzC B γ.1 (phiL5 B G γ) (shY ξ c) = DzC B γ.1 (phiL5 B G γ) ξ
    unfold DzC dZ
    rw [hfd]

theorem pulse_mult_coeffs_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ,
    ∃ C b : ℝ, ∀ (l0 : ℕ), l1 ≤ l0 → ∀ (γ : Lab) (m : ℤ), ActiveL4 B G γ → l0 ≤ γ.1 →
    ∀ ξ ∈ DomC B.h (qsOf l0), 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 →
    B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 →
    |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 →
    dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) ≠ 0 ∧ ContDiffAt ℝ ∞ (pulseMult5 B G γ m) ξ ∧
    NB B.h (pulseMult5 B G γ m) k ξ ≤ C * qC B.h ξ ^ (B.h * (1/2)) * SC B.h ξ ^ b ∧
    ∀ c : ℝ × ℝ, IsDeck B.h (qC B.h ξ) c → pulseMult5 B G γ m (shY ξ c) = pulseMult5 B G γ m ξ :=
by
  intro B G hok hG
  obtain ⟨l2, hN⟩ := nPhi5_comp_ujet_v5 B G hok hG
  obtain ⟨l3, c0, hc0, hlow⟩ := nPhi5_nsq_lower_v5 B G hok hG
  have hh : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  obtain ⟨l4, hband⟩ := band_coarse_gap_v5 B.h hh hh1
  have hP2 : ∀ i ξ, GoodPt5 B G (l2 + l3 + l4) i ξ → GoodPt5 B G l2 i ξ := by
    intro i ξ hi
    obtain ⟨a, rest⟩ := hi
    exact ⟨le_trans (by omega) a, rest⟩
  have hP3 : ∀ i ξ, GoodPt5 B G (l2 + l3 + l4) i ξ → GoodPt5 B G l3 i ξ := by
    intro i ξ hi
    obtain ⟨a, rest⟩ := hi
    exact ⟨le_trans (by omega) a, rest⟩
  have hn : ∀ j : Fin 3, UJet5 B.h (GoodPt5 B G (l2 + l3 + l4)) (fun i η => nPhi5 B G i.2 η j) := by
    intro j
    obtain ⟨h1, h2⟩ := hN j
    refine ⟨fun i ξ hi => h1 i ξ (hP2 i ξ hi), fun k => ?_⟩
    obtain ⟨C, b, hC⟩ := h2 k
    exact ⟨C, b, fun i ξ hi => hC i ξ (hP2 i ξ hi)⟩
  have R := ujet5_ring_v5 B.h (GoodPt5 B G (l2 + l3 + l4))
  have m0 := (R _ _ (hn 0) (hn 0)).1
  have m1 := (R _ _ (hn 1) (hn 1)).1
  have m2 := (R _ _ (hn 2) (hn 2)).1
  have hsq0 := (R _ _ (R _ _ m0 m1).2 m2).2
  have hsq : UJet5 B.h (GoodPt5 B G (l2 + l3 + l4))
      (fun i η => dotProduct (nPhi5 B G i.2 η) (nPhi5 B G i.2 η)) := by
    have e : (fun (i : ℕ × Lab) (η : Cyl) => dotProduct (nPhi5 B G i.2 η) (nPhi5 B G i.2 η)) =
        fun i η => (nPhi5 B G i.2 η 0 * nPhi5 B G i.2 η 0 + nPhi5 B G i.2 η 1 * nPhi5 B G i.2 η 1) +
          nPhi5 B G i.2 η 2 * nPhi5 B G i.2 η 2 := by
      funext i η
      simp [dotProduct, Fin.sum_univ_three]
    rw [e]
    exact hsq0
  have hinv := ujet5_inv_v5 B.h (GoodPt5 B G (l2 + l3 + l4)) _ c0 hsq hc0
    (fun i ξ hi => hlow i ξ (hP3 i ξ hi))
  have NN : ∀ j : Fin 3, UJet5 B.h (GoodPt5 B G (l2 + l3 + l4))
      (fun i η => (dotProduct (nPhi5 B G i.2 η) (nPhi5 B G i.2 η))⁻¹ * nPhi5 B G i.2 η j) :=
    fun j => (R _ _ hinv (hn j)).1
  refine ⟨l2 + l3 + l4, ?_⟩
  intro k
  choose Cf bf hCf using fun j : Fin 3 => (NN j).2 k
  refine ⟨4 * ∑ j : Fin 3, |Cf j|, ∑ j : Fin 3, |bf j|, ?_⟩
  intro l0 hl0 γ m hA hl ξ hξ q1 q2 x1 x2 e1 e2
  have hi : GoodPt5 B G (l2 + l3 + l4) (l0, γ) ξ := ⟨hl0, hA, hl, hξ, q1, q2, x1, x2, e1, e2⟩
  have hξ' := hξ
  obtain ⟨-, hξt, hξq⟩ := hξ'
  have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hS1 : (1:ℝ) ≤ SC B.h ξ := by
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hS0 : (0:ℝ) ≤ SC B.h ξ := by linarith
  have hns : c0 ≤ dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) := hlow (l0, γ) ξ (hP3 _ _ hi)

  obtain ⟨z, hzdef⟩ : ∃ z : ℂ, z = if m = 0 then 0 else Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ)) :=
    ⟨_, rfl⟩
  have hrep : pulseMult5 B G γ m = fun η j =>
      z * ((((dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η))⁻¹ * nPhi5 B G γ η j : ℝ)) : ℂ) := by
    funext η j
    by_cases hm : m = 0
    · rw [hzdef, if_pos hm]
      simp [pulseMult5, hm]
    · rw [hzdef, if_neg hm]
      simp only [pulseMult5, if_neg hm, Pi.smul_apply, smul_eq_mul, nsqC5, nPhiC5]
      push_cast
      ring
  have hz : ‖z‖ ≤ 4 * qC B.h ξ ^ (B.h * (1/2)) := by
    have hqe : 0 ≤ qC B.h ξ ^ (B.h * (1/2)) := Real.rpow_nonneg hq0.le _
    by_cases hm : m = 0
    · rw [hzdef, if_pos hm, norm_zero]
      positivity
    · rw [hzdef, if_neg hm]
      have hQb : 0 < Qb γ.1 := by unfold Qb; exact Real.rpow_pos_of_pos two_pos _
      have heps : 0 < epsb B.h γ.1 := by unfold epsb; exact Real.rpow_pos_of_pos hQb _
      have hk0 : 0 < epsb B.h γ.1 ^ (-(1/2:ℝ)) := Real.rpow_pos_of_pos heps _
      have hkpos : epsb B.h γ.1 ^ (-(1/2:ℝ)) ≤ (kb B.h γ.1 : ℝ) := by
        unfold kb
        exact Nat.le_ceil _
      have hkb : 0 < (kb B.h γ.1 : ℝ) := lt_of_lt_of_le hk0 hkpos
      have hm1 : (1:ℝ) ≤ |(m:ℝ)| := by
        rw [← Int.cast_abs]
        exact_mod_cast Int.one_le_abs hm
      have hn1 : ‖Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ))‖ = 1 / ((kb B.h γ.1 : ℝ) * |(m:ℝ)|) := by
        rw [norm_div, norm_mul, Complex.norm_I, Complex.norm_natCast, Complex.norm_intCast]
      rw [hn1]
      have s1 : 1 / ((kb B.h γ.1 : ℝ) * |(m:ℝ)|) ≤ 1 / (kb B.h γ.1 : ℝ) :=
        one_div_le_one_div_of_le hkb (le_mul_of_one_le_right hkb.le hm1)
      have s2 : 1 / (kb B.h γ.1 : ℝ) ≤ epsb B.h γ.1 ^ (1/2:ℝ) := by
        have := one_div_le_one_div_of_le hk0 hkpos
        rw [Real.rpow_neg heps.le] at this
        simp only [one_div, inv_inv] at this ⊢
        exact this
      have s3 : epsb B.h γ.1 ^ (1/2:ℝ) = Qb γ.1 ^ (B.h * (1/2)) := by
        unfold epsb
        rw [← Real.rpow_mul hQb.le]
      have hQ4 : Qb γ.1 ≤ 4 * qC B.h ξ := by
        have := (lt_div_iff₀ hQb).1 q1
        linarith
      have s4 : Qb γ.1 ^ (B.h * (1/2)) ≤ (4 * qC B.h ξ) ^ (B.h * (1/2)) :=
        Real.rpow_le_rpow hQb.le hQ4 (by positivity)
      have s5 : (4 * qC B.h ξ) ^ (B.h * (1/2)) = (4:ℝ) ^ (B.h * (1/2)) * qC B.h ξ ^ (B.h * (1/2)) :=
        Real.mul_rpow (by norm_num) hq0.le
      have s6 : (4:ℝ) ^ (B.h * (1/2)) ≤ 4 := by
        have := Real.rpow_le_rpow_of_exponent_le (by norm_num : (1:ℝ) ≤ 4)
          (show B.h * (1/2) ≤ 1 by linarith)
        rwa [Real.rpow_one] at this
      have s7 : (4:ℝ) ^ (B.h * (1/2)) * qC B.h ξ ^ (B.h * (1/2)) ≤ 4 * qC B.h ξ ^ (B.h * (1/2)) :=
        mul_le_mul_of_nonneg_right s6 hqe
      rw [s3] at s2
      rw [s5] at s4
      linarith

  choose Uf hUo hUm hUs using fun j : Fin 3 => (NN j).1 (l0, γ) ξ hi
  have hUo' : IsOpen (⋂ j, Uf j) := isOpen_iInter_of_finite hUo
  have hξU : ξ ∈ ⋂ j, Uf j := Set.mem_iInter.2 hUm
  have hcv := nb_cvec5_v5 B.h (⋂ j, Uf j) ξ z
    (fun j η => (dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η))⁻¹ * nPhi5 B G γ η j) hUo' hξU
    (fun j => (hUs j).mono (Set.iInter_subset _ j))
  have hterm : ∀ j : Fin 3,
      NB B.h (fun η => (dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η))⁻¹ * nPhi5 B G γ η j) k ξ ≤
        |Cf j| * SC B.h ξ ^ (∑ j : Fin 3, |bf j|) := by
    intro j
    refine le_trans (hCf j (l0, γ) ξ hi) (le_trans
      (mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hS0 _)) ?_)
    exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hS1 (le_trans (le_abs_self _)
      (Finset.single_le_sum (fun j _ => abs_nonneg (bf j)) (Finset.mem_univ j)))) (abs_nonneg _)
  have hsum : ∑ j : Fin 3,
      NB B.h (fun η => (dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η))⁻¹ * nPhi5 B G γ η j) k ξ ≤
        (∑ j : Fin 3, |Cf j|) * SC B.h ξ ^ (∑ j : Fin 3, |bf j|) := by
    rw [Finset.sum_mul]
    exact Finset.sum_le_sum (fun j _ => hterm j)
  have hsum0 : 0 ≤ ∑ j : Fin 3,
      NB B.h (fun η => (dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η))⁻¹ * nPhi5 B G γ η j) k ξ :=
    Finset.sum_nonneg (fun j _ => by unfold NB; exact norm_nonneg _)
  refine ⟨(lt_of_lt_of_le hc0 hns).ne', ?_, ?_, ?_⟩
  · rw [hrep]
    exact hcv.1.contDiffAt (hUo'.mem_nhds hξU)
  · rw [hrep]
    refine le_trans (hcv.2 k) ?_
    calc ‖z‖ * ∑ j : Fin 3,
          NB B.h (fun η => (dotProduct (nPhi5 B G γ η) (nPhi5 B G γ η))⁻¹ * nPhi5 B G γ η j) k ξ
        ≤ (4 * qC B.h ξ ^ (B.h * (1/2))) *
          ((∑ j : Fin 3, |Cf j|) * SC B.h ξ ^ (∑ j : Fin 3, |bf j|)) :=
          mul_le_mul hz hsum hsum0 (by positivity)
      _ = 4 * (∑ j : Fin 3, |Cf j|) * qC B.h ξ ^ (B.h * (1/2)) * SC B.h ξ ^ (∑ j : Fin 3, |bf j|) := by
          ring
  · intro c hc
    obtain ⟨a, b', hab⟩ := hc
    have hb := (hband γ.1 l0 (qC B.h ξ) (by omega) hq0 hξq q1 q2).1
    have hdeck := nPhi5_deck_v5 B G γ _ c hb ⟨a, b', hab⟩ ξ
    rw [hrep]
    simp only [hdeck]

theorem nb_vec_complex_v5 : ∀ (h : ℝ) (U : Set Cyl) (ξ : Cyl) (c : ℂ) (f : Fin 3 → Cyl → ℝ) (F : Cyl → (Fin 3 → ℂ)), IsOpen U → ξ ∈ U → (∀ i, ContDiffOn ℝ ∞ (f i) U) → (∀ η ∈ U, F η = fun i => c * ((f i η : ℝ) : ℂ)) → ∀ k : ℕ, NB h F k ξ ≤ ‖c‖ * ∑ i : Fin 3, NB h (f i) k ξ :=
by
  intro h U ξ c f F hU hξ hf hFG k
  have hfi : ∀ i, ContDiffAt ℝ ∞ (f i) ξ := fun i => (hf i).contDiffAt (hU.mem_nhds hξ)
  have hG : ContDiffAt ℝ ∞ (fun η : Cyl => fun i : Fin 3 => c * ((f i η : ℝ) : ℂ)) ξ := by
    refine contDiffAt_pi.mpr (fun i => ?_)
    exact contDiffAt_const.mul ((Complex.ofRealCLM.contDiff.contDiffAt).comp ξ (hfi i))
  have hev : F =ᶠ[nhds ξ] (fun η : Cyl => fun i : Fin 3 => c * ((f i η : ℝ) : ℂ)) :=
    Filter.eventuallyEq_of_mem (hU.mem_nhds hξ) (fun η hη => hFG η hη)
  have hD : iteratedFDeriv ℝ k F ξ =
      iteratedFDeriv ℝ k (fun η : Cyl => fun i : Fin 3 => c * ((f i η : ℝ) : ℂ)) ξ :=
    (hev.iteratedFDeriv ℝ k).eq_of_nhds
  have hgc : ∀ r : ℝ, (c • Complex.ofRealCLM : ℝ →L[ℝ] ℂ) r = c * (r : ℂ) := by
    intro r
    simp [ContinuousLinearMap.smul_apply, Complex.ofRealCLM_apply, smul_eq_mul]
  have hcomp : ∀ (i : Fin 3) (v : Fin k → Cyl),
      iteratedFDeriv ℝ k (fun η : Cyl => fun i : Fin 3 => c * ((f i η : ℝ) : ℂ)) ξ v i =
        c * ((iteratedFDeriv ℝ k (f i) ξ v : ℝ) : ℂ) := by
    intro i v
    have e1 : (⇑(ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i) ∘
        (fun η : Cyl => fun i : Fin 3 => c * ((f i η : ℝ) : ℂ))) =
        ⇑(c • Complex.ofRealCLM : ℝ →L[ℝ] ℂ) ∘ f i := by
      funext η
      simp only [Function.comp_apply, ContinuousLinearMap.proj_apply, hgc]
    have h1 := ContinuousLinearMap.iteratedFDeriv_comp_left
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℂ) i) hG (i := k)
      (by exact_mod_cast le_top)
    have h2 := ContinuousLinearMap.iteratedFDeriv_comp_left
      (c • Complex.ofRealCLM : ℝ →L[ℝ] ℂ) (hfi i) (i := k) (by exact_mod_cast le_top)
    rw [e1, h2] at h1
    have h3 := congrArg (fun T => T v) h1
    simp only [ContinuousLinearMap.compContinuousMultilinearMap_coe, Function.comp_apply,
      ContinuousLinearMap.proj_apply] at h3
    rw [← h3, hgc]
  have hNBnn : ∀ i, 0 ≤ NB h (f i) k ξ := fun i => norm_nonneg _
  have hM0 : 0 ≤ ‖c‖ * ∑ i : Fin 3, NB h (f i) k ξ :=
    mul_nonneg (norm_nonneg _) (Finset.sum_nonneg (fun i _ => hNBnn i))
  have key : ‖(iteratedFDeriv ℝ k (fun η : Cyl => fun i : Fin 3 => c * ((f i η : ℝ) : ℂ)) ξ).compContinuousLinearMap
      (fun _ => Lnorm h ξ)‖ ≤ ‖c‖ * ∑ i : Fin 3, NB h (f i) k ξ := by
    refine ContinuousMultilinearMap.opNorm_le_bound hM0 (fun m => ?_)
    have hP : 0 ≤ ∏ j, ‖m j‖ := Finset.prod_nonneg (fun j _ => norm_nonneg _)
    refine (pi_norm_le_iff_of_nonneg (mul_nonneg hM0 hP)).mpr (fun i => ?_)
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, hcomp, norm_mul, Complex.norm_real]
    have hle : ‖iteratedFDeriv ℝ k (f i) ξ (fun j => Lnorm h ξ (m j))‖ ≤
        NB h (f i) k ξ * ∏ j, ‖m j‖ := by
      have := ((iteratedFDeriv ℝ k (f i) ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)).le_opNorm m
      rw [ContinuousMultilinearMap.compContinuousLinearMap_apply] at this
      exact this
    have hs : NB h (f i) k ξ ≤ ∑ j : Fin 3, NB h (f j) k ξ :=
      Finset.single_le_sum (f := fun j => NB h (f j) k ξ) (fun j _ => hNBnn j) (Finset.mem_univ i)
    calc ‖c‖ * ‖iteratedFDeriv ℝ k (f i) ξ (fun j => Lnorm h ξ (m j))‖
        ≤ ‖c‖ * (NB h (f i) k ξ * ∏ j, ‖m j‖) := mul_le_mul_of_nonneg_left hle (norm_nonneg _)
      _ ≤ ‖c‖ * ((∑ j : Fin 3, NB h (f j) k ξ) * ∏ j, ‖m j‖) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hs hP) (norm_nonneg _)
      _ = (‖c‖ * ∑ j : Fin 3, NB h (f j) k ξ) * ∏ j, ‖m j‖ := by ring
  show ‖(iteratedFDeriv ℝ k F ξ).compContinuousLinearMap (fun _ => Lnorm h ξ)‖ ≤ _
  rw [hD]
  exact key

theorem good_nsq_lower_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ (l1 : ℕ) (c : ℝ), 0 < c ∧ ∀ (l0 : ℕ), l1 ≤ l0 → ∀ (γ : Lab), ActiveL4 B G γ → l0 ≤ γ.1 → ∀ ξ ∈ DomC B.h (qsOf l0), 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 → B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → c ≤ dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) :=
by
  intro B G hB hG
  obtain ⟨hΩo, hbase⟩ := geom_slow_base_smooth_v5 B hB
  obtain ⟨l2, cr, Cr, hcr, hrep⟩ := rep_consts_v5 B G hB hG
  obtain ⟨l5, C5, h5⟩ := vco_nb_v5 B hB
  obtain ⟨l12, h12⟩ := slow_profile_dir_nb_v5 B hB
  obtain ⟨C12, hC12⟩ := h12 0
  obtain ⟨hh, hh1, hXa, -, -, -, -, hqB0, hqB1, -⟩ := hB.2.1
  have hr0 : 0 < G.r0 := hG.1.1
  have hr0' : G.r0 ≤ 1 / 100 := hG.1.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  set ρ : ℝ := (2:ℝ) ^ (-B.h) with hρ
  have hρ0 : 0 < ρ := Real.rpow_pos_of_pos (by norm_num) _
  have hρ1 : ρ < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  set Λ : ℝ := 8 * |C5| * |Cr| * |C12| + 1 with hΛ
  have hΛ0 : 0 < Λ := by positivity
  have hlim := tendsto_pow_const_mul_const_pow_of_abs_lt_one 2
    (show |ρ| < 1 by rw [abs_of_pos hρ0]; exact hρ1)
  obtain ⟨L, hL⟩ := Filter.eventually_atTop.1
    (Filter.Tendsto.eventually_lt_const (show (0:ℝ) < cr / (2 * Λ) by positivity) hlim)
  refine ⟨l2 + l5 + l12 + n0 + L, (cr / 2) ^ 2, by positivity, ?_⟩
  intro l0 hl0 γ hAct hlγ ξ hξ hw1 hw2 hX1 hX2 hxi het

  have hq : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).1
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hξB : ξ ∈ DomC B.h B.qB := ⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqsB⟩
  have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have hql : qC B.h ξ < 4 * Qb γ.1 := by rwa [div_lt_iff₀ hQ] at hw2
  have hqh : qC B.h ξ ^ B.h ≤ 4 * ρ ^ γ.1 := by
    have e1 : qC B.h ξ ^ B.h ≤ (4 * Qb γ.1) ^ B.h := Real.rpow_le_rpow hq.le hql.le hh.le
    rw [Real.mul_rpow (by norm_num) hQ.le] at e1
    have e2 : (4:ℝ) ^ B.h ≤ 4 := by
      calc (4:ℝ) ^ B.h ≤ 4 ^ (1:ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
        _ = 4 := Real.rpow_one 4
    have e3 : Qb γ.1 ^ B.h = ρ ^ γ.1 := by
      rw [hρ]; unfold Qb
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_mul (by norm_num)]
      congr 1; ring
    rw [e3] at e1
    have : 0 ≤ ρ ^ γ.1 := pow_nonneg hρ0.le _
    nlinarith
  have hNB0 : ∀ f : Cyl → ℝ, |f ξ| ≤ NB B.h f 0 ξ := by
    intro f
    have := ContinuousMultilinearMap.le_opNorm
      ((iteratedFDeriv ℝ 0 f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) (fun _ => 0)
    simpa [NB, iteratedFDeriv_zero_apply] using this

  set Ω := {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} with hΩe
  have hsQ : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr hQ
  have hRC : ∀ s ∈ Ω, pcRC5 γ.1 s ≠ 0 := fun s hs => div_ne_zero (ne_of_gt hs.1) hsQ.ne'
  have hRCs : ContDiff ℝ ∞ (pcRC5 γ.1) := by unfold pcRC5; fun_prop
  have hb : ∀ i, ContDiffOn ℝ ∞ (pcB5 B γ.1 i) Ω := fun i => hbase γ.1 i
  have hFa : ContDiffOn ℝ ∞ (pcFa5 B γ.1) Ω := (hb 1).div hRCs.contDiffOn hRC
  have hsplit : ∀ (e : ℝ × ℝ × ℝ),
      Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) (ξ.1, ξ.2.1, ξ.2.2.1) e =
        pang5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) e) +
        pzr5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) e) := by
    intro e
    have hs : (ξ.1, ξ.2.1, ξ.2.2.1) ∈ Ω := hξB
    have dFa := ((hFa.contDiffAt (hΩo.mem_nhds hs)).differentiableAt (by simp)).hasFDerivAt
    have dB := (((hb 2).contDiffAt (hΩo.mem_nhds hs)).differentiableAt (by simp)).hasFDerivAt
    have hsum : fderiv ℝ (pcPhi2_5 B G γ) (ξ.1, ξ.2.1, ξ.2.2.1) = _ :=
      ((dFa.const_mul (pang5 B G γ)).add (dB.const_mul (pzr5 B G γ))).fderiv
    rw [hsum]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring

  obtain ⟨hpzlow, hpzC, hpaC, -⟩ := hrep γ hAct (by omega)
  have hpa : |pang5 B G γ| ≤ |Cr| := hpaC.trans (le_abs_self _)
  have hpz : |pzr5 B G γ| ≤ |Cr| := hpzC.trans (le_abs_self _)

  obtain ⟨P2, hP2⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl => Real.sqrt (Qb γ.1) *
      fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)) := ⟨_, rfl⟩
  obtain ⟨vf, hvf⟩ : ∃ f : Cyl → ℝ, f = fun η => vco B.h G.r0 γ (G.ctr γ) η.2.2.2 := ⟨_, rfl⟩
  have hqn : 0 ≤ qC B.h ξ ^ B.h := Real.rpow_nonneg hq.le _
  have hZ : ∀ F : ℝ × ℝ × ℝ → ℝ, (F = pcFa5 B γ.1 ∨ F = pcB5 B γ.1 2) →
      |Real.sqrt (Qb γ.1) * fderiv ℝ F (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))| ≤
        |C12| * qC B.h ξ ^ B.h := by
    intro F hF
    have h := (hC12 γ.1 l0 (by omega) hlγ ξ hξ hw1 hw2 hX1 hX2 F hF).2
    refine ((hNB0 (fun η : Cyl => Real.sqrt (Qb γ.1) *
      fderiv ℝ F (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)))).trans h).trans ?_
    exact mul_le_mul_of_nonneg_right (le_abs_self _) hqn
  have hP20 : |P2 ξ| ≤ 2 * |Cr| * |C12| * qC B.h ξ ^ B.h := by
    have e : P2 ξ = pang5 B G γ * (Real.sqrt (Qb γ.1) *
          fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))) +
        pzr5 B G γ * (Real.sqrt (Qb γ.1) *
          fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))) := by
      rw [hP2]; exact hsplit _
    rw [e]
    have h1 := hZ _ (Or.inl rfl)
    have h2 := hZ _ (Or.inr rfl)
    refine (abs_add_le _ _).trans ?_
    rw [abs_mul (pang5 B G γ), abs_mul (pzr5 B G γ)]
    calc _ ≤ |Cr| * (|C12| * qC B.h ξ ^ B.h) + |Cr| * (|C12| * qC B.h ξ ^ B.h) :=
          add_le_add (mul_le_mul hpa h1 (abs_nonneg _) (abs_nonneg _))
            (mul_le_mul hpz h2 (abs_nonneg _) (abs_nonneg _))
      _ = 2 * |Cr| * |C12| * qC B.h ξ ^ B.h := by ring
  have hv0 : |vf ξ| ≤ |C5| * (γ.1:ℝ) ^ 2 := by
    refine (hNB0 vf).trans ?_
    rw [hvf]
    exact (h5 γ G.r0 (G.ctr γ) l0 hr0.le hr0' (by omega) hlγ ξ hξ hw1 hw2 hxi het 0).trans
      (mul_le_mul_of_nonneg_right (le_abs_self _) (sq_nonneg _))

  obtain ⟨U1, c1, hU1o, hξU1, hU1sub, hU1⟩ := nPhi5_local_model_v5 B G γ ξ hB hξB hxi het
  have hn2e : nPhi5 B G γ ξ 2 = pzr5 B G γ - vf ξ * P2 ξ := by
    rw [(hU1 ξ hξU1).2, hvf, hP2]; rfl
  have hvΨ : |vf ξ * P2 ξ| < cr / 2 := by
    have hLl : L ≤ γ.1 := by omega
    have hsm := hL γ.1 hLl
    have hρn : 0 ≤ (γ.1:ℝ) ^ 2 * ρ ^ γ.1 := by positivity
    rw [abs_mul]
    calc |vf ξ| * |P2 ξ| ≤ (|C5| * (γ.1:ℝ) ^ 2) * (2 * |Cr| * |C12| * (4 * ρ ^ γ.1)) :=
          mul_le_mul hv0 (hP20.trans (mul_le_mul_of_nonneg_left hqh (by positivity)))
            (abs_nonneg _) (by positivity)
      _ = (Λ - 1) * ((γ.1:ℝ) ^ 2 * ρ ^ γ.1) := by rw [hΛ]; ring
      _ ≤ Λ * ((γ.1:ℝ) ^ 2 * ρ ^ γ.1) := by nlinarith
      _ < Λ * (cr / (2 * Λ)) := mul_lt_mul_of_pos_left hsm hΛ0
      _ = cr / 2 := by field_simp
  have hn2 : cr / 2 < |nPhi5 B G γ ξ 2| := by
    rw [hn2e]
    have := abs_sub_abs_le_abs_sub (pzr5 B G γ) (vf ξ * P2 ξ)
    linarith
  rw [dotProduct, Fin.sum_univ_three]
  have h2 : (cr / 2) ^ 2 ≤ nPhi5 B G γ ξ 2 * nPhi5 B G γ ξ 2 := by
    rw [← abs_mul_abs_self]; nlinarith [abs_nonneg (nPhi5 B G γ ξ 2)]
  nlinarith [mul_self_nonneg (nPhi5 B G γ ξ 0), mul_self_nonneg (nPhi5 B G γ ξ 1)]

theorem good_nphi5_nb_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C : ℝ, ∀ (l0 : ℕ), l1 ≤ l0 → ∀ (γ : Lab), ActiveL4 B G γ → l0 ≤ γ.1 → ∀ ξ ∈ DomC B.h (qsOf l0), 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 → B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → ∀ i : Fin 3, NB B.h (fun η : Cyl => nPhi5 B G γ η i) k ξ ≤ C * SC B.h ξ :=
by
  intro B G hB hG
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hB.2.1
  obtain ⟨hr0, hr01, hus, -, -⟩ := hG.1
  obtain ⟨l2, cr, Cr, hcr, hR⟩ := rep_consts_v5 B G hB hG
  obtain ⟨l5, C5, hV⟩ := vco_nb_v5 B hB
  obtain ⟨l12, hP12⟩ := slow_profile_dir_nb_v5 B hB
  choose C12 hC12 using hP12
  choose C11 hC11 using inv_r_nb_v5 B hB
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  obtain ⟨hΩo, hBsm⟩ := geom_slow_base_smooth_v5 B hB
  set Ω : Set (ℝ × ℝ × ℝ) := {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}
    with hΩ
  refine ⟨l2 + l5 + l12 + n0, fun k => ?_⟩
  obtain ⟨M, hM⟩ : ∃ M : ℝ, M = ∑ j ∈ Finset.range (k + 1), |C12 j| := ⟨_, rfl⟩
  have hM0 : 0 ≤ M := by rw [hM]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
  have hCM : ∀ j, j ≤ k → |C12 j| ≤ M := by
    intro j hj
    rw [hM]
    exact Finset.single_le_sum (f := fun j => |C12 j|) (fun i _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  obtain ⟨C, hC⟩ : ∃ C : ℝ, C = |Cr| * (G.ustar / 2 + 1) + 2 ^ k * 8 * |C5| * |Cr| * M + |Cr| * |C11 k| :=
    ⟨_, rfl⟩
  refine ⟨C, ?_⟩
  intro l0 hl0 γ hA hlγ ξ hξ hq1 hq2 hX1 hX2 hxi het

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hqs1 : qsOf l0 ≤ 1 := by
    rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have hξB : ξ ∈ DomC B.h B.qB := ⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqsB⟩
  have hq0 : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).1
  have hqlt1 : qC B.h ξ < 1 := lt_of_lt_of_le hξ.2.2 hqs1
  have hS1 : 1 ≤ SC B.h ξ := by
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hS0 : 0 ≤ SC B.h ξ := by linarith
  have hqh0 : 0 ≤ qC B.h ξ ^ B.h := Real.rpow_nonneg hq0.le _
  have hqh1 : qC B.h ξ ^ B.h ≤ 1 := Real.rpow_le_one hq0.le hqlt1.le hh0.le
  have hQbpos : 0 < Qb γ.1 := by unfold Qb; positivity

  have hl2 : (γ.1 : ℝ) ^ 2 ≤ 4 * SC B.h ξ := by
    have hlt : qC B.h ξ < 4 * Qb γ.1 := by
      have := (div_lt_iff₀ hQbpos).mp hq2
      linarith
    have hlog : Real.log (qC B.h ξ) < Real.log (4 * Qb γ.1) := Real.log_lt_log hq0 hlt
    rw [Real.log_mul (by norm_num) hQbpos.ne'] at hlog
    have hQlog : Real.log (Qb γ.1) = -(γ.1 : ℝ) * Real.log 2 := by
      unfold Qb
      rw [Real.log_rpow (by norm_num : (0:ℝ) < 2)]
    have h4 : Real.log 4 = 2 * Real.log 2 := by
      rw [show (4:ℝ) = 2 ^ 2 by norm_num, Real.log_pow]
      norm_num
    have hneg : Real.log (qC B.h ξ) < 0 := Real.log_neg hq0 hqlt1
    have hl2g : (1:ℝ) / 2 < Real.log 2 := by
      have := Real.log_two_gt_d9
      linarith
    obtain ⟨a, ha⟩ : ∃ a : ℝ, a = |Real.log (qC B.h ξ)| := ⟨_, rfl⟩
    have habs : a = -Real.log (qC B.h ξ) := by rw [ha]; exact abs_of_neg hneg
    have ha0 : 0 < a := by linarith
    have hl0' : (0:ℝ) ≤ (γ.1 : ℝ) := Nat.cast_nonneg _
    have key : (γ.1 : ℝ) * Real.log 2 < 2 * Real.log 2 + a := by
      rw [hQlog, h4] at hlog
      linarith
    have hlt2 : (γ.1 : ℝ) < 2 * (1 + a) := by
      by_contra hc
      push_neg at hc
      have h5 : 2 * (1 + a) * Real.log 2 ≤ (γ.1 : ℝ) * Real.log 2 :=
        mul_le_mul_of_nonneg_right hc (by linarith)
      nlinarith [mul_pos ha0 (sub_pos.mpr hl2g)]
    unfold SC
    rw [← ha]
    nlinarith [mul_le_mul hlt2.le hlt2.le hl0' (by linarith : (0:ℝ) ≤ 2 * (1 + a))]

  have hB2 : ContDiffOn ℝ ∞ (pcB5 B γ.1 2) Ω := hBsm γ.1 2
  have hB1 : ContDiffOn ℝ ∞ (pcB5 B γ.1 1) Ω := hBsm γ.1 1
  have hRC : ContDiffOn ℝ ∞ (pcRC5 γ.1) Ω := by
    have : ContDiff ℝ ∞ (pcRC5 γ.1) := by unfold pcRC5; fun_prop
    exact this.contDiffOn
  have hFa : ContDiffOn ℝ ∞ (pcFa5 B γ.1) Ω := by
    have := hB1.div hRC (fun s hs => by
      unfold pcRC5
      exact div_ne_zero (ne_of_gt hs.1) (Real.sqrt_pos.mpr hQbpos).ne')
    exact this
  have hmaps : ∀ η ∈ DomC B.h B.qB, ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ) ∈ Ω := by
    intro η hη
    simp only [hΩ, Set.mem_setOf_eq]
    exact ⟨hη.1, hη.2.1, hη.2.2⟩
  have hdir : ∀ F : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F Ω → ∀ e : ℝ × ℝ × ℝ,
      ContDiffOn ℝ ∞ (fun η : Cyl => Real.sqrt (Qb γ.1) * fderiv ℝ F (η.1, η.2.1, η.2.2.1) e)
        (DomC B.h B.qB) := by
    intro F hF e
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ F) Ω := ((contDiffOn_infty_iff_fderiv_of_isOpen hΩo).mp hF).2
    have h2 : ContDiffOn ℝ ∞ (fun s => fderiv ℝ F s e) Ω := h1.clm_apply contDiffOn_const
    have hsl : ContDiff ℝ ∞ (fun η : Cyl => ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ)) := by fun_prop
    have h3 : ContDiffOn ℝ ∞ (fun η : Cyl => fderiv ℝ F (η.1, η.2.1, η.2.2.1) e) (DomC B.h B.qB) :=
      h2.comp hsl.contDiffOn hmaps
    exact contDiffOn_const.mul h3
  have hsplit : ∀ η ∈ DomC B.h B.qB, ∀ e : ℝ × ℝ × ℝ,
      Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) e =
        pang5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) e) +
        pzr5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (η.1, η.2.1, η.2.2.1) e) := by
    intro η hη e
    have hn : Ω ∈ nhds ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ) := hΩo.mem_nhds (hmaps η hη)
    have d1 : DifferentiableAt ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) :=
      (hFa.contDiffAt hn).differentiableAt (by norm_num)
    have d2 : DifferentiableAt ℝ (pcB5 B γ.1 2) (η.1, η.2.1, η.2.2.1) :=
      (hB2.contDiffAt hn).differentiableAt (by norm_num)
    have hd := (d1.hasFDerivAt.const_mul (pang5 B G γ)).add (d2.hasFDerivAt.const_mul (pzr5 B G γ))
    rw [show pcPhi2_5 B G γ = (fun y => pang5 B G γ * pcFa5 B γ.1 y) + (fun y => pzr5 B G γ * pcB5 B γ.1 2 y)
      from rfl, hd.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring

  obtain ⟨U, c1, hUo, hξU, hUsub, hloc⟩ := nPhi5_local_model_v5 B G γ ξ hB hξB hxi het
  have hUn : U ∈ nhds ξ := hUo.mem_nhds hξU
  obtain ⟨va, hva⟩ : ∃ va : Cyl → ℝ,
      va = fun η => Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1 * lamT η.2.2.2 + c1 := ⟨_, rfl⟩
  obtain ⟨RF, hRF⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl =>
      Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) := ⟨_, rfl⟩
  obtain ⟨RB, hRB⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl =>
      Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) := ⟨_, rfl⟩
  obtain ⟨ZF, hZF⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl =>
      Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)) := ⟨_, rfl⟩
  obtain ⟨ZB, hZB⟩ : ∃ f : Cyl → ℝ, f = fun η : Cyl =>
      Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)) := ⟨_, rfl⟩
  obtain ⟨Ψ0, hΨ0⟩ : ∃ f : Cyl → ℝ, f = fun η => pang5 B G γ * RF η + pzr5 B G γ * RB η := ⟨_, rfl⟩
  obtain ⟨Ψ2, hΨ2⟩ : ∃ f : Cyl → ℝ, f = fun η => pang5 B G γ * ZF η + pzr5 B G γ * ZB η := ⟨_, rfl⟩
  obtain ⟨K0, hK0⟩ : ∃ K : ℝ, K = sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 := ⟨_, rfl⟩

  have hvaS : ContDiff ℝ ∞ va := by rw [hva]; unfold lamT; fun_prop
  have hRFs : ContDiffOn ℝ ∞ RF U := by rw [hRF]; exact (hdir _ hFa _).mono hUsub
  have hRBs : ContDiffOn ℝ ∞ RB U := by rw [hRB]; exact (hdir _ hB2 _).mono hUsub
  have hZFs : ContDiffOn ℝ ∞ ZF U := by rw [hZF]; exact (hdir _ hFa _).mono hUsub
  have hZBs : ContDiffOn ℝ ∞ ZB U := by rw [hZB]; exact (hdir _ hB2 _).mono hUsub
  have hΨ0s : ContDiffOn ℝ ∞ Ψ0 U := by
    rw [hΨ0]; exact (contDiffOn_const.mul hRFs).add (contDiffOn_const.mul hRBs)
  have hΨ2s : ContDiffOn ℝ ∞ Ψ2 U := by
    rw [hΨ2]; exact (contDiffOn_const.mul hZFs).add (contDiffOn_const.mul hZBs)

  have ev0 : ∀ a b c : ℝ, (![a, b, c] : Fin 3 → ℝ) 0 = a := fun _ _ _ => rfl
  have ev2 : ∀ a b c : ℝ, (![a, b, c] : Fin 3 → ℝ) 2 = c := fun _ _ _ => rfl
  have hvco : ∀ η ∈ U, vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = va η := by
    intro η hη
    rw [hva]
    exact (hloc η hη).1
  have hU0 : ∀ η ∈ U, nPhi5 B G γ η 0 = 1 * K0 + (-1) * (va η * Ψ0 η) := by
    intro η hη
    obtain ⟨hv, hn⟩ := hloc η hη
    rw [hn, ev0, hv, hsplit η (hUsub hη)]
    simp only [hva, hΨ0, hRF, hRB, hK0]
    ring
  have hU2 : ∀ η ∈ U, nPhi5 B G γ η 2 = 1 * pzr5 B G γ + (-1) * (va η * Ψ2 η) := by
    intro η hη
    obtain ⟨hv, hn⟩ := hloc η hη
    rw [hn, ev2, hv, hsplit η (hUsub hη)]
    simp only [hva, hΨ2, hZF, hZB]
    ring

  have germ : ∀ (f g : Cyl → ℝ) (j : ℕ), (∀ η ∈ U, f η = g η) → NB B.h f j ξ = NB B.h g j ξ := by
    intro f g j hfg
    have hev : f =ᶠ[nhds ξ] g := Filter.eventuallyEq_of_mem hUn hfg
    unfold NB
    rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds]

  have hRc := hR γ hA (by omega)
  have hpa : |pang5 B G γ| ≤ |Cr| := hRc.2.2.1.trans (le_abs_self _)
  have hpz : |pzr5 B G γ| ≤ |Cr| := hRc.2.1.trans (le_abs_self _)
  have hbs : |Bs5 B G γ| ≤ |Cr| := hRc.2.2.2.trans (le_abs_self _)
  have hvaB : ∀ j, NB B.h va j ξ ≤ 4 * |C5| * SC B.h ξ := by
    intro j
    rw [← germ (fun η => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) va j hvco]
    refine (hV γ G.r0 (G.ctr γ) l0 hr0.le hr01 (by omega) hlγ ξ hξ hq1 hq2 hxi het j).trans ?_
    have hl0 : (0:ℝ) ≤ (γ.1:ℝ) ^ 2 := by positivity
    calc C5 * (γ.1:ℝ) ^ 2 ≤ |C5| * (γ.1:ℝ) ^ 2 := mul_le_mul_of_nonneg_right (le_abs_self _) hl0
      _ ≤ |C5| * (4 * SC B.h ξ) := mul_le_mul_of_nonneg_left hl2 (abs_nonneg _)
      _ = 4 * |C5| * SC B.h ξ := by ring
  have hPF : ∀ j, j ≤ k → ∀ F : ℝ × ℝ × ℝ → ℝ, (F = pcFa5 B γ.1 ∨ F = pcB5 B γ.1 2) →
      NB B.h (fun η : Cyl => Real.sqrt (Qb γ.1) * fderiv ℝ F (η.1, η.2.1, η.2.2.1)
        ((1:ℝ), (0:ℝ), (0:ℝ))) j ξ ≤ M ∧
      NB B.h (fun η : Cyl => Real.sqrt (Qb γ.1) * fderiv ℝ F (η.1, η.2.1, η.2.2.1)
        ((0:ℝ), (1:ℝ), (0:ℝ))) j ξ ≤ M := by
    intro j hj F hF
    obtain ⟨a1, a2⟩ := hC12 j γ.1 l0 (by omega) hlγ ξ hξ hq1 hq2 hX1 hX2 F hF
    have hc := hCM j hj
    refine ⟨a1.trans ((le_abs_self _).trans hc), a2.trans ?_⟩
    calc C12 j * qC B.h ξ ^ B.h ≤ |C12 j| * qC B.h ξ ^ B.h :=
          mul_le_mul_of_nonneg_right (le_abs_self _) hqh0
      _ ≤ |C12 j| * 1 := mul_le_mul_of_nonneg_left hqh1 (abs_nonneg _)
      _ ≤ M := by linarith
  have hRFb : ∀ j, j ≤ k → NB B.h RF j ξ ≤ M := by
    intro j hj; rw [hRF]; exact (hPF j hj _ (Or.inl rfl)).1
  have hRBb : ∀ j, j ≤ k → NB B.h RB j ξ ≤ M := by
    intro j hj; rw [hRB]; exact (hPF j hj _ (Or.inr rfl)).1
  have hZFb : ∀ j, j ≤ k → NB B.h ZF j ξ ≤ M := by
    intro j hj; rw [hZF]; exact (hPF j hj _ (Or.inl rfl)).2
  have hZBb : ∀ j, j ≤ k → NB B.h ZB j ξ ≤ M := by
    intro j hj; rw [hZB]; exact (hPF j hj _ (Or.inr rfl)).2
  have hΨb : ∀ (f g : Cyl → ℝ), ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ g U →
      (∀ j, j ≤ k → NB B.h f j ξ ≤ M) → (∀ j, j ≤ k → NB B.h g j ξ ≤ M) →
      ∀ j, j ≤ k → NB B.h (fun η => pang5 B G γ * f η + pzr5 B G γ * g η) j ξ ≤ 2 * |Cr| * M := by
    intro f g hf hg hfb hgb j hj
    have hlin := (nb_real_algebra_v5 B.h U ξ hUo hξU f g hf hg j).2.1 (pang5 B G γ) (pzr5 B G γ)
    refine hlin.trans ?_
    have m1 : |pang5 B G γ| * NB B.h f j ξ ≤ |Cr| * M :=
      mul_le_mul hpa (hfb j hj) (norm_nonneg _) (abs_nonneg _)
    have m2 : |pzr5 B G γ| * NB B.h g j ξ ≤ |Cr| * M :=
      mul_le_mul hpz (hgb j hj) (norm_nonneg _) (abs_nonneg _)
    linarith
  have hΨ0b : ∀ j, j ≤ k → NB B.h Ψ0 j ξ ≤ 2 * |Cr| * M := by
    intro j hj; rw [hΨ0]; exact hΨb RF RB hRFs hRBs hRFb hRBb j hj
  have hΨ2b : ∀ j, j ≤ k → NB B.h Ψ2 j ξ ≤ 2 * |Cr| * M := by
    intro j hj; rw [hΨ2]; exact hΨb ZF ZB hZFs hZBs hZFb hZBb j hj
  have hconst : ∀ K : ℝ, NB B.h (fun _ : Cyl => K) k ξ ≤ |K| := by
    intro K
    have hc := (nb_real_algebra_v5 B.h U ξ hUo hξU (fun _ => K) (fun _ => K) contDiffOn_const
      contDiffOn_const k).2.2 K
    refine hc.trans ?_
    split_ifs
    · exact le_rfl
    · exact abs_nonneg _
  have hcomp : ∀ (K : ℝ) (Ψ : Cyl → ℝ), ContDiffOn ℝ ∞ Ψ U → (∀ j, j ≤ k → NB B.h Ψ j ξ ≤ 2 * |Cr| * M) →
      NB B.h (fun η => 1 * K + (-1) * (va η * Ψ η)) k ξ ≤
        |K| + 2 ^ k * 8 * |C5| * |Cr| * M * SC B.h ξ := by
    intro K Ψ hΨs hΨbd
    have hlin := (nb_real_algebra_v5 B.h U ξ hUo hξU (fun _ => K) (fun η => va η * Ψ η) contDiffOn_const
      (hvaS.contDiffOn.mul hΨs) k).2.1 1 (-1)
    have hprod := nb_real_mul_le_v5 B.h ξ va Ψ k (4 * |C5| * SC B.h ξ) (2 * |Cr| * M) hvaS.contDiffAt
      (hΨs.contDiffAt hUn) (fun j _ => hvaB j) hΨbd
    have hc := hconst K
    have e : 2 ^ k * (4 * |C5| * SC B.h ξ) * (2 * |Cr| * M) =
        2 ^ k * 8 * |C5| * |Cr| * M * SC B.h ξ := by ring
    rw [e] at hprod
    rw [abs_one, abs_neg, abs_one] at hlin
    refine hlin.trans ?_
    linarith
  have hP0 : 0 ≤ 2 ^ k * 8 * |C5| * |Cr| * M * SC B.h ξ :=
    mul_nonneg (mul_nonneg (by positivity) hM0) hS0
  have hA1 : |Cr| * (G.ustar / 2 + 1) ≤ |Cr| * (G.ustar / 2 + 1) * SC B.h ξ :=
    le_mul_of_one_le_right (mul_nonneg (abs_nonneg _) (by linarith)) hS1
  have hA3' : 0 ≤ |Cr| * |C11 k| * SC B.h ξ :=
    mul_nonneg (mul_nonneg (abs_nonneg _) (abs_nonneg _)) hS0
  have hA1' : 0 ≤ |Cr| * (G.ustar / 2 + 1) * SC B.h ξ :=
    mul_nonneg (mul_nonneg (abs_nonneg _) (by linarith)) hS0
  have hA3 : |Cr| * |C11 k| ≤ |Cr| * |C11 k| * SC B.h ξ :=
    le_mul_of_one_le_right (mul_nonneg (abs_nonneg _) (abs_nonneg _)) hS1
  have hCS : C * SC B.h ξ = |Cr| * (G.ustar / 2 + 1) * SC B.h ξ +
      2 ^ k * 8 * |C5| * |Cr| * M * SC B.h ξ + |Cr| * |C11 k| * SC B.h ξ := by
    rw [hC]; ring
  have hK0b : |K0| ≤ |Cr| * (G.ustar / 2) := by
    have hsg : |sgn γ.2.2| = 1 := by unfold sgn; split_ifs <;> simp
    rw [hK0, abs_div, abs_mul, abs_mul, hsg, abs_of_pos hus, abs_of_pos (by norm_num : (0:ℝ) < 2)]
    calc 1 * |Bs5 B G γ| * G.ustar / 2 = |Bs5 B G γ| * (G.ustar / 2) := by ring
      _ ≤ |Cr| * (G.ustar / 2) := mul_le_mul_of_nonneg_right hbs (by linarith)
  have hCr0 : 0 ≤ |Cr| := abs_nonneg _

  have h0 : NB B.h (fun η : Cyl => nPhi5 B G γ η 0) k ξ ≤ C * SC B.h ξ := by
    rw [germ _ (fun η => 1 * K0 + (-1) * (va η * Ψ0 η)) k hU0]
