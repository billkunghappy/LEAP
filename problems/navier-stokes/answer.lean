    have hloc : ∀ (pv pv' : ℕ → (ℂ → ℂ) × (ℂ → ℂ)) (n : ℕ), (∀ i, i ≤ n → pv i = pv' i) →
        axRecStep h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) pv n = axRecStep h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) pv' n := by
      intro pv pv' n hpv
      simp only [axRecStep]
      simp (contextual := true) (disch := ((try simp only [Finset.mem_range] at *); omega)) only [hpv]
    intro n
    show axRecList h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) (n + 1) (n + 1) = _
    rw [axRecList, if_neg (Nat.not_succ_le_self n)]
    exact hloc _ _ n (fun i hi => hlist n i hi)
  have hrecP : ∀ n : ℕ,
      let D : ℂ := 1 / 2 - (h : ℂ)
      let d : ℂ := 1 - (η : ℂ) ^ 2
      let Us : ℂ := 4 * (η : ℂ) + (j0 : ℂ)
