theorem rfp_inter_lam_small : ∀ K A : ℝ, 1 ≤ K → 1 ≤ A → ∃ l0 : ℝ, 0 < l0 ∧ l0 ≤ 1 / 100 ∧ ∀ lam : ℝ, 0 < lam → lam ≤ l0 → K * lam * (A + 60 * Real.log (1 / lam)) ^ 2 ≤ 1 :=
