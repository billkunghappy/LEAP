      calc Real.sqrt (1 + sco B G γ 0 ^ 2) ≤ Real.sqrt ((1 + |G.ustar|) ^ 2) := Real.sqrt_le_sqrt hsq1
        _ = 1 + |G.ustar| := Real.sqrt_sq (by positivity)
    rw [hκdef, abs_mul, abs_mul, abs_one, one_mul, abs_of_nonneg (Real.sqrt_nonneg _)]
    exact mul_le_mul hc0f hsq (Real.sqrt_nonneg _) (abs_nonneg _)
  have hsXa : 0 < Real.sqrt B.Xa := Real.sqrt_pos.mpr hXa
  have hAb : |A| ≤ |Cr| / Real.sqrt B.Xa := by
    have hQX0 : Qb γ.1 * B.Xa ≤ ξ.1 ^ 2 := by
      have := mul_le_mul_of_nonneg_right (show Qb γ.1 ≤ 2 * qC B.h ξ by linarith) hXa.le
      linarith
    have hQX : Real.sqrt (Qb γ.1) * Real.sqrt B.Xa ≤ ξ.1 := by
      rw [← Real.sqrt_mul hQb0.le]
