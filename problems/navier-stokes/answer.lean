    have h1 := le_abs_self (∫ y in (rfpY4 P.Md P.lam)..(rfpY4 P.Md P.lam + 60),
      W y * Real.exp (-(Θ y * Real.log (1 + η ^ 2))))
    rw [show 60 * Real.exp (-26) * Real.exp (rfpY3 P.Md P.lam + 2 * rfpLam P (rfpY3 P.Md P.lam)) =
      M * 60 by rw [hM]; ring]
    linarith
