      linarith
    funext i
    rcases hF5 i with rfl | rfl | rfl | rfl | rfl
    · exact hUz.1
    · exact hUz.2
    · exact hEz.1
    · exact hEz.2.1
    · exact hEz.2.2
  obtain ⟨r, L, g, hr, hL, hg0, hgsm, hgsol⟩ := hIFT 5 a b hinj

  obtain ⟨κm, hκm⟩ : ∃ t : ℝ, t = 5 / cpatch := ⟨_, rfl⟩
  have hκm0 : 0 < κm := by rw [hκm]; exact div_pos (by norm_num) hcp
  obtain ⟨K, hK⟩ : ∃ t : ℝ, t = κm + κm ^ 2 := ⟨_, rfl⟩
  have hK0 : 0 < K := by rw [hK]; have := sq_nonneg κm; linarith
  have hKa : κm ≤ K := by rw [hK]; have := sq_nonneg κm; linarith
