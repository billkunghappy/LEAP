          AKc * SC B.h ξ ^ 2 + ADc * SC B.h ξ ^ 2 + (m : ℝ) ^ 2 * (AKc * SC B.h ξ ^ 2) +
            (m : ℝ) ^ 2 * (ADc * SC B.h ξ ^ 2) := by ring
      rw [e]; linarith
    have hpre : 0 ≤ (2:ℝ) ^ k * Arc := mul_nonneg (by positivity) hAr0
    calc (2:ℝ) ^ k * Arc * (AKc * SC B.h ξ + |μ| * (ADc * SC B.h ξ ^ 2))
        ≤ (2:ℝ) ^ k * Arc * ((1 + (m : ℝ) ^ 2) * (AKc + ADc) * SC B.h ξ ^ 2) :=
          mul_le_mul_of_nonneg_left hfin hpre
      _ = 2 ^ k * Arc * (AKc + ADc) * (1 + (m : ℝ) ^ 2) * SC B.h ξ ^ 2 := by ring
  ·
    intro c hc
    have hsh : shY ξ c ∈ DomC B.h B.qB := hξB
    have hq : qC B.h (shY ξ c) = qC B.h ξ := rfl
    have hK : Kmat B G γ (shY ξ c) = Kmat B G γ ξ :=
      (kmat_slow_form_v5 B G γ hok _ hsh).trans (kmat_slow_form_v5 B G γ hok _ hξB).symm
    have hnn : nPhi5 B G γ (shY ξ c) = nPhi5 B G γ ξ :=
