    simp only [Finset.sum_range]
    simp (disch := (first | exact Fin.is_le _ | exact Nat.sub_le _ _ | exact le_refl _ | exact le_trans (Fin.is_le _) (Nat.sub_le _ _) | exact le_trans (Nat.sub_le _ _) (Nat.sub_le _ _) | omega)) only [hP, hV, hPd, hVd]

theorem ax_src_P : ∀ (h j0 r M Λ E E' : ℝ) (χ ζ ℓ z g : ℂ → ℂ) (pv : ℕ → (ℂ → ℂ) × (ℂ → ℂ)) (n : ℕ), 0 < h → h < 1 / 100 → 0 ≤ j0 → j0 ≤ 1 / 20 → 0 < r → r ≤ 1 / 100 → 20 ≤ M → 1 ≤ Λ → 0 ≤ E → 0 ≤ E' → (∀ w ∈ axRect r, ‖ζ w‖ ≤ M ∧ ‖ℓ w‖ ≤ M) → (pv 0).2 = (fun _ => 0) → (∀ m ≤ n, DifferentiableOn ℂ (pv m).1 (axRect r) ∧ DifferentiableOn ℂ (pv m).2 (axRect r)) → (∀ m ≤ n, ∀ s w, 0 ≤ s → s < r → w ∈ axRect s → ‖(pv m).1 w‖ ≤ E * (r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ m ∧ ‖(pv m).2 w‖ ≤ E' * (r / 20) ^ m / ((m : ℝ) + 1) ^ 2 * ((r - s)⁻¹) ^ m) → ∀ s w, 0 ≤ s → s < r → w ∈ axRect s → ‖2 * ((n : ℂ) + 1) * ((n : ℂ) + 2) * (axRecStep h j0 Λ χ ζ ℓ z g pv n).1 w + χ w * (pv n).1 w‖ ≤ M * (M * (7 * E + 12 * M * E * E')) / Λ * (r / 20) ^ n / ((n : ℝ) + 1) * ((r - s)⁻¹) ^ (n + 1) :=
