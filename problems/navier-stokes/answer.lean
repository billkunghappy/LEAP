  have hk2 : k.2 = ((round (Jpow (bandIdx h γ.1) Y - c).2 : ℤ) : ℝ) := by rw [hk]
  obtain ⟨w, hwdef⟩ : ∃ w : ℝ × ℝ, w = Jpow (bandIdx h γ.1) Y - c - k := ⟨_, rfl⟩
