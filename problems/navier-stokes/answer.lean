theorem ipb5_azimuthal_div : ∀ (B : BG) (l0 : ℕ) (e : ℝ) (f : Cyl → ℝ), B.ok → ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) → (∀ ξ ∈ DomC B.h (qsOf l0), XC B.h ξ ≤ B.Xa → f ξ = 0) → ∀ x t, (x, t) ∈ simDomain B.h (qsOf l0) → divergence (fun y => ipb5MV B l0 e f (y, t)) x = 0 ∧ inner ℝ x (ipb5MV B l0 e f (x, t)) = (0:ℝ) ∧ ipb5MV B l0 e f (x, t) 2 = 0 :=
by
  intro B l0 e f hok hf hvan x t hxt
  classical
  have hxt' : t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
  have hS : SimScaleProps B.h := hok.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hτ : 0 < 1 - t := by linarith [hxt'.1]

  have swirl : ∀ (G : ℝ × ℝ → ℝ) (φ : ℝ³ → ℝ) (x : ℝ³), (∀ y, φ y = G (rad y, y 2)) →
      DifferentiableAt ℝ φ x →
      DifferentiableAt ℝ (fun y => φ y • azVec y) x ∧ divergence (fun y => φ y • azVec y) x = 0 := by
    intro G φ x hG hφ
    set L : ℝ³ →L[ℝ] ℝ³ :=
      (-(EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ)).smulRight (EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) +
      (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).smulRight (EuclideanSpace.single (1 : Fin 3) (1 : ℝ))
      with hLdef
    have hL : (⇑L : ℝ³ → ℝ³) = azVec := by
      funext y
      simp only [hLdef, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
        ContinuousLinearMap.neg_apply]
      unfold azVec
      simp
    have hA : DifferentiableAt ℝ azVec x := by
      rw [← hL]; exact L.differentiableAt
    have hdivA : divergence azVec x = 0 := by
      unfold divergence
      rw [← hL, ContinuousLinearMap.fderiv]
      have e : ((L : ℝ³ →L[ℝ] ℝ³) : ℝ³ →ₗ[ℝ] ℝ³) =
          ((-(EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ)) : ℝ³ →ₗ[ℝ] ℝ).smulRight
            (EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) +
          ((EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ) : ℝ³ →ₗ[ℝ] ℝ).smulRight
            (EuclideanSpace.single (1 : Fin 3) (1 : ℝ)) := rfl
      rw [e, map_add, LinearMap.trace_smulRight, LinearMap.trace_smulRight]
      simp
    have hrot : fderiv ℝ φ x (azVec x) = 0 := by
      set w : ℝ³ := x 0 • EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
        x 1 • EuclideanSpace.single (1 : Fin 3) (1 : ℝ) with hw
      set a : ℝ³ := azVec x with ha
      set c : ℝ → ℝ³ := fun θ => x + ((Real.cos θ - 1) • w + Real.sin θ • a) with hc
      have ha0 : a 0 = -(x 1) := by rw [ha]; unfold azVec; simp
      have ha1 : a 1 = x 0 := by rw [ha]; unfold azVec; simp
      have ha2 : a 2 = 0 := by rw [ha]; unfold azVec; simp
      have hc0 : ∀ θ, c θ 0 = x 0 * Real.cos θ - x 1 * Real.sin θ := by
        intro θ
        simp only [hc, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, ha0, hw]
        simp
        ring
      have hc1 : ∀ θ, c θ 1 = x 1 * Real.cos θ + x 0 * Real.sin θ := by
        intro θ
        simp only [hc, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, ha1, hw]
        simp
        ring
      have hc2 : ∀ θ, c θ 2 = x 2 := by
        intro θ
        simp only [hc, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, ha2, hw]
        simp
      have hrad : ∀ θ, rad (c θ) = rad x := by
        intro θ
        unfold rad
        rw [hc0, hc1]
        congr 1
        linear_combination (x 0 ^ 2 + x 1 ^ 2) * Real.cos_sq_add_sin_sq θ
      have hconst : (φ ∘ c) = fun _ => φ x := by
        funext θ
        simp only [Function.comp_apply]
        rw [hG (c θ), hG x, hrad θ, hc2 θ]
      have hd1 : HasDerivAt (φ ∘ c) 0 0 := by
        rw [hconst]; exact hasDerivAt_const _ _
      have hcd : HasDerivAt c a 0 := by
        have h1 : HasDerivAt (fun θ => (Real.cos θ - 1) • w) ((-Real.sin 0) • w) 0 :=
          ((Real.hasDerivAt_cos 0).sub_const 1).smul_const w
        have h2 : HasDerivAt (fun θ => Real.sin θ • a) (Real.cos 0 • a) 0 :=
          (Real.hasDerivAt_sin 0).smul_const a
        have h3 := (h1.add h2).const_add x
        simp only [Real.sin_zero, Real.cos_zero, neg_zero, zero_smul, one_smul, zero_add] at h3
        exact h3
      have hcx : x = c 0 := by simp [hc]
      have hd2 : HasDerivAt (φ ∘ c) (fderiv ℝ φ x a) 0 :=
        HasFDerivAt.comp_hasDerivAt_of_eq 0 hφ.hasFDerivAt hcd hcx
      exact hd2.unique hd1
    refine ⟨hφ.smul hA, ?_⟩
    unfold divergence at hdivA ⊢
    have hfd : HasFDerivAt (fun y => φ y • azVec y)
        (φ x • fderiv ℝ azVec x + (fderiv ℝ φ x).smulRight (azVec x)) x :=
      hφ.hasFDerivAt.smul hA.hasFDerivAt
    rw [hfd.fderiv]
    have e : ((φ x • fderiv ℝ azVec x + (fderiv ℝ φ x).smulRight (azVec x) : ℝ³ →L[ℝ] ℝ³) :
        ℝ³ →ₗ[ℝ] ℝ³) = φ x • ((fderiv ℝ azVec x : ℝ³ →L[ℝ] ℝ³) : ℝ³ →ₗ[ℝ] ℝ³) +
          (fderiv ℝ φ x : ℝ³ →ₗ[ℝ] ℝ).smulRight (azVec x) := rfl
    rw [e, map_add, map_smul, LinearMap.trace_smulRight, hdivA, smul_zero, zero_add]
    exact hrot

  let Γ : ℝ × ℝ → ℝ := fun w =>
    if 0 < w.1 ∧ t < 1 ∧ simScale B.h w.2 (1 - t) < qsOf l0 then
      simScale B.h w.2 (1 - t) ^ e * f (w.1, w.2, t, Yph B.h w.1 t + 0) * w.1⁻¹ else 0
  let φ : ℝ³ → ℝ := fun y => Γ (rad y, y 2)
  have hφ1 : ∀ y, corrOn B l0 y t → φ y =
      simScale B.h (y 2) (1 - t) ^ e * f (rad y, y 2, t, Yph B.h (rad y) t + 0) * (rad y)⁻¹ :=
    fun y h => if_pos h
  have hφ0 : ∀ y, ¬ corrOn B l0 y t → φ y = 0 := fun y h => if_neg h
  have hV : ∀ y, ipb5MV B l0 e f (y, t) = φ y • azVec y := by
    intro y
    by_cases hc : corrOn B l0 y t
    · rw [hφ1 y hc]
      simp only [ipb5MV, eTh, hc, if_true, smul_smul]
      rfl
    · rw [hφ0 y hc, zero_smul]
      simp [ipb5MV, hc]
  have hcoord : ∀ (i : Fin 3) (y : ℝ³), DifferentiableAt ℝ (fun w : ℝ³ => w i) y := by
    intro i y
    have h0 : DifferentiableAt ℝ (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) i) y :=
      ContinuousLinearMap.differentiableAt _
    rwa [EuclideanSpace.coe_proj] at h0
  have hφd : DifferentiableAt ℝ φ x := by
    rcases (Real.sqrt_nonneg (x 0 ^ 2 + x 1 ^ 2)).eq_or_lt with h0 | hpos
    ·
      have hsq : x 0 ^ 2 + x 1 ^ 2 ≤ 0 := Real.sqrt_eq_zero'.1 h0.symm
      have hcont01 : Continuous (fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2) :=
        continuous_iff_continuousAt.2 fun y =>
          (((hcoord 0 y).pow 2).add ((hcoord 1 y).pow 2)).continuousAt
      have hN : IsOpen {y : ℝ³ | y 0 ^ 2 + y 1 ^ 2 < 2 * B.Xa * (1 - t)} :=
        isOpen_lt hcont01 continuous_const
      have hxN : x ∈ {y : ℝ³ | y 0 ^ 2 + y 1 ^ 2 < 2 * B.Xa * (1 - t)} := by
        show x 0 ^ 2 + x 1 ^ 2 < 2 * B.Xa * (1 - t)
        have := mul_pos (mul_pos two_pos hXa) hτ
        linarith
      have hev : φ =ᶠ[nhds x] fun _ => (0:ℝ) := by
        refine Filter.eventuallyEq_of_mem (hN.mem_nhds hxN) ?_
        intro y hy
        have hy' : y 0 ^ 2 + y 1 ^ 2 < 2 * B.Xa * (1 - t) := hy
        by_cases hc : corrOn B l0 y t
        · rw [hφ1 y hc]
          obtain ⟨hr, -, hq⟩ := hc
          have hqge : 1 - t ≤ simScale B.h (y 2) (1 - t) := (hS.2.1 (y 2) (1 - t) hτ).1
          have hqpos : 0 < simScale B.h (y 2) (1 - t) := by linarith
          have hdom : ((rad y, y 2, t, Yph B.h (rad y) t + 0) : Cyl) ∈ DomC B.h (qsOf l0) :=
            show 0 < rad y ∧ t < 1 ∧ simScale B.h (y 2) (1 - t) < qsOf l0 from ⟨hr, hxt'.1, hq⟩
          have hrad2 : rad y ^ 2 = y 0 ^ 2 + y 1 ^ 2 := Real.sq_sqrt (by positivity)
          have hXC : XC B.h ((rad y, y 2, t, Yph B.h (rad y) t + 0) : Cyl) ≤ B.Xa := by
            show rad y ^ 2 / (2 * simScale B.h (y 2) (1 - t)) ≤ B.Xa
            rw [div_le_iff₀ (by linarith), hrad2]
            have := mul_le_mul_of_nonneg_left hqge hXa.le
            nlinarith
          rw [hvan _ hdom hXC, mul_zero, zero_mul]
        · exact hφ0 y hc
      exact (differentiableAt_const (0:ℝ)).congr_of_eventuallyEq hev
    ·
      have hr : 0 < rad x := hpos
      have hsum : 0 < x 0 ^ 2 + x 1 ^ 2 := Real.sqrt_pos.1 hpos
      have hradD : DifferentiableAt ℝ rad x :=
        (((hcoord 0 _).pow 2).add ((hcoord 1 _).pow 2)).sqrt hsum.ne'
      have hSo : (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) ∈ nhds (x 2, 1 - t) :=
        (isOpen_univ.prod isOpen_Ioi).mem_nhds ⟨mem_univ _, show (0:ℝ) < 1 - t from hτ⟩
      have hSd : DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (x 2, 1 - t) :=
        (hS.2.2.2.1.contDiffAt hSo).differentiableAt (by simp)
      have hσD : DifferentiableAt ℝ (fun y : ℝ³ => simScale B.h (y 2) (1 - t)) x :=
        DifferentiableAt.comp (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2)
          (f := fun y : ℝ³ => (y 2, 1 - t)) x hSd ((hcoord 2 _).prodMk (differentiableAt_const _))
      have hev : ∀ᶠ y in nhds x, corrOn B l0 y t := by
        filter_upwards [hradD.continuousAt (Ioi_mem_nhds hr),
          hσD.continuousAt (Iio_mem_nhds hxt'.2)] with y hy1 hy2
        exact ⟨hy1, hxt'.1, hy2⟩
      have hζ : DifferentiableAt ℝ (fun y : ℝ³ => ((rad y, y 2, t, Yph B.h (rad y) t + 0) : Cyl)) x := by
        have h4 : DifferentiableAt ℝ (fun y : ℝ³ => Yph B.h (rad y) t + 0) x :=
          (((hradD.rpow_const (p := drx B.h) (Or.inl hr.ne')).smul_const vrv).add_const
            (t • vtv)).add_const 0
        exact hradD.prodMk ((hcoord 2 _).prodMk ((differentiableAt_const t).prodMk h4))
      have hDom : DomC B.h (qsOf l0) ∈ nhds ((rad x, x 2, t, Yph B.h (rad x) t + 0) : Cyl) := by
        have hc1 : ContinuousAt (fun η : Cyl => η.1) (rad x, x 2, t, Yph B.h (rad x) t + 0) :=
          continuous_fst.continuousAt
        have hc3 : ContinuousAt (fun η : Cyl => η.2.2.1) (rad x, x 2, t, Yph B.h (rad x) t + 0) :=
          (continuous_fst.comp (continuous_snd.comp continuous_snd)).continuousAt
        have hψ : ContinuousAt (fun η : Cyl => (η.2.1, 1 - η.2.2.1))
            (rad x, x 2, t, Yph B.h (rad x) t + 0) :=
          ((continuous_fst.comp continuous_snd).prodMk
            (continuous_const.sub (continuous_fst.comp (continuous_snd.comp continuous_snd)))).continuousAt
        have hq : ContinuousAt (fun η : Cyl => simScale B.h η.2.1 (1 - η.2.2.1))
            (rad x, x 2, t, Yph B.h (rad x) t + 0) :=
          ContinuousAt.comp (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2)
            (f := fun η : Cyl => (η.2.1, 1 - η.2.2.1)) hSd.continuousAt hψ
        filter_upwards [hc1 (Ioi_mem_nhds hr), hc3 (Iio_mem_nhds hxt'.1),
          hq (Iio_mem_nhds hxt'.2)] with η h1 h2 h3
        exact ⟨h1, h2, h3⟩
      have hfd : DifferentiableAt ℝ f ((rad x, x 2, t, Yph B.h (rad x) t + 0) : Cyl) :=
        (hf.contDiffAt hDom).differentiableAt (by simp)
      have hfζ : DifferentiableAt ℝ
          (fun y : ℝ³ => f ((rad y, y 2, t, Yph B.h (rad y) t + 0) : Cyl)) x :=
        hfd.comp x hζ
      have hqd : DifferentiableAt ℝ (fun y : ℝ³ => simScale B.h (y 2) (1 - t) ^ e) x :=
        hσD.rpow_const (p := e) (Or.inl (hS.1 (x 2) (1 - t) hτ).1.ne')
      have hg : DifferentiableAt ℝ (fun y : ℝ³ => simScale B.h (y 2) (1 - t) ^ e *
          f ((rad y, y 2, t, Yph B.h (rad y) t + 0) : Cyl) * (rad y)⁻¹) x :=
        (hqd.mul hfζ).mul (hradD.inv hr.ne')
      refine hg.congr_of_eventuallyEq ?_
      filter_upwards [hev] with y hy
      exact hφ1 y hy

  have hin : inner ℝ x (azVec x) = (0:ℝ) := by
    unfold azVec
    rw [inner_add_right, real_inner_smul_right, real_inner_smul_right,
      EuclideanSpace.inner_single_right, EuclideanSpace.inner_single_right]
    simp only [conj_trivial, one_mul]
    ring
  refine ⟨?_, ?_, ?_⟩
  · have hfun : (fun y => ipb5MV B l0 e f (y, t)) = fun y => φ y • azVec y := funext hV
    rw [hfun]
    exact (swirl Γ φ x (fun y => rfl) hφd).2
  · rw [hV x, real_inner_smul_right, hin, mul_zero]
  · rw [hV x, PiLp.smul_apply]
    unfold azVec
    simp

theorem ipb5_mean_coord_bounds : ∀ (B : BG) (l0 : ℕ) (e : ℝ), B.ok → IsOpen (DomC B.h (qsOf l0)) ∧ IsOpen {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} ∧ Set.MapsTo (fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} (DomC B.h (qsOf l0)) ∧ ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} ∧ ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => eTh z.1) {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} ∧ ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => simScale B.h (z.1 2) (1 - z.2) ^ e) {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} ∧ ∀ k : ℕ, ∃ C K : ℝ, ∀ z ∈ {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)}, ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) z‖ ≤ C * simScale B.h (z.1 2) (1 - z.2) ^ (-K) ∧ ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => eTh z.1) z‖ ≤ C * simScale B.h (z.1 2) (1 - z.2) ^ (-K) ∧ ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => simScale B.h (z.1 2) (1 - z.2) ^ e) z‖ ≤ C * simScale B.h (z.1 2) (1 - z.2) ^ (-K) :=
by
  intro B l0 e hok
  obtain ⟨hSP, hBP⟩ := hok
  obtain ⟨hh0, hh1, hXa, hXam1, hm12, hm2Xb, -⟩ := hBP.1
  have hXb : 0 < B.Xb := by linarith
  set W : Set (ℝ³ × ℝ) := {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧
    B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧
    rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} with hWdef
  have hco : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => z.1 i) := fun i =>
    ((EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).contDiff.comp contDiff_fst)
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have key2 : ∀ (C a b q : ℝ), 0 < q → q ≤ 1 → b ≤ a → C * q ^ a ≤ |C| * q ^ b := by
    intro C a b q hq0 hq1 hba
    calc C * q ^ a ≤ |C| * q ^ a :=
          mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0.le _)
      _ ≤ |C| * q ^ b :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0 hq1 hba) (abs_nonneg C)

  have hqcont : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    have hm : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
      (((EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst).prodMk
        (continuous_const.sub continuous_snd))
    refine hSP.2.2.2.1.continuousOn.comp hm.continuousOn ?_
    intro w hw
    exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
  have hΩ : IsOpen (simDomain B.h (qsOf l0)) := by
    have he' : simDomain B.h (qsOf l0) = {w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0) := rfl
    rw [he']
    exact hqcont.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  have hD : IsOpen (DomC B.h (qsOf l0)) := by
    have hc : ContinuousOn (fun ξ : Cyl => qC B.h ξ) {ξ : Cyl | ξ.2.2.1 < 1} := by
      show ContinuousOn (fun ξ : Cyl => simScale B.h ξ.2.1 (1 - ξ.2.2.1)) {ξ : Cyl | ξ.2.2.1 < 1}
      have hm : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) :=
        continuous_snd.fst.prodMk (continuous_const.sub continuous_snd.snd.fst)
      refine hSP.2.2.2.1.continuousOn.comp hm.continuousOn ?_
      intro ξ hξ
      exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hξ)⟩
    have he' : DomC B.h (qsOf l0) = ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩
        (fun ξ : Cyl => qC B.h ξ) ⁻¹' Iio (qsOf l0) := by
      ext ξ
      simp only [DomC, mem_setOf_eq, mem_inter_iff, mem_preimage, mem_Iio]
      tauto
    rw [he']
    exact (hc.mono inter_subset_right).isOpen_inter_preimage
      ((isOpen_lt continuous_const continuous_fst).inter
        (isOpen_lt continuous_snd.snd.fst continuous_const)) isOpen_Iio
  have hradc : Continuous (fun z : ℝ³ × ℝ => rad z.1) :=
    Real.continuous_sqrt.comp (((hco 0).pow 2).add ((hco 1).pow 2)).continuous
  have hWo : IsOpen W := by
    have he' : W = (simDomain B.h (qsOf l0) ∩ {z : ℝ³ × ℝ | 0 < rad z.1}) ∩
        (fun z : ℝ³ × ℝ => ((2 * rad z.1 ^ 2 - B.Xa * simScale B.h (z.1 2) (1 - z.2),
          8 * B.Xb * simScale B.h (z.1 2) (1 - z.2) - rad z.1 ^ 2) : ℝ × ℝ)) ⁻¹'
          (Ioi 0 ×ˢ Ioi 0) := by
      ext z
      simp only [hWdef, mem_setOf_eq, mem_inter_iff, mem_preimage, mem_prod, mem_Ioi, sub_pos]
      tauto
    rw [he']
    have hq' : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
        (simDomain B.h (qsOf l0) ∩ {z : ℝ³ × ℝ | 0 < rad z.1}) :=
      hqcont.mono (fun z hz => hz.1.1)
    have hψ : ContinuousOn (fun z : ℝ³ × ℝ => ((2 * rad z.1 ^ 2 - B.Xa * simScale B.h (z.1 2) (1 - z.2),
          8 * B.Xb * simScale B.h (z.1 2) (1 - z.2) - rad z.1 ^ 2) : ℝ × ℝ))
        (simDomain B.h (qsOf l0) ∩ {z : ℝ³ × ℝ | 0 < rad z.1}) :=
      ((continuous_const.mul (hradc.pow 2)).continuousOn.sub (continuousOn_const.mul hq')).prodMk
        ((continuousOn_const.mul hq').sub (hradc.pow 2).continuousOn)
    exact hψ.isOpen_inter_preimage (hΩ.inter (isOpen_lt continuous_const hradc))
      (isOpen_Ioi.prod isOpen_Ioi)

  have hmap : Set.MapsTo (fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) W
      (DomC B.h (qsOf l0)) := by
    intro z hz
    obtain ⟨⟨ht1, hqlt⟩, hr0, -, -⟩ := hz
    exact ⟨hr0, ht1, hqlt⟩

  have hfac : ∀ z ∈ W, z.2 < 1 ∧ 0 < simScale B.h (z.1 2) (1 - z.2) ∧
      simScale B.h (z.1 2) (1 - z.2) ≤ 1 ∧
      B.Xa / 2 * simScale B.h (z.1 2) (1 - z.2) < z.1 0 ^ 2 + z.1 1 ^ 2 ∧
      z.1 0 ^ 2 + z.1 1 ^ 2 < 8 * B.Xb ∧ ‖z‖ ≤ 8 * B.Xb + 2 := by
    intro z hz
    obtain ⟨⟨ht1, hqlt⟩, hr0, hlo, hhi⟩ := hz
    have hτ : 0 < 1 - z.2 := by linarith
    have hq0 := (hSP.1 (z.1 2) (1 - z.2) hτ).1
    have hq1 : simScale B.h (z.1 2) (1 - z.2) ≤ 1 := le_trans hqlt.le hqs1
    have hrsq : rad z.1 ^ 2 = z.1 0 ^ 2 + z.1 1 ^ 2 := Real.sq_sqrt (by positivity)
    obtain ⟨hτq, hz2⟩ := hSP.2.1 (z.1 2) (1 - z.2) hτ
    have hpow1 : simScale B.h (z.1 2) (1 - z.2) ^ (1 - 2 * B.h) ≤ 1 :=
      Real.rpow_le_one hq0.le hq1 (by linarith)
    have hx2 : z.1 2 ^ 2 < 1 := lt_of_lt_of_le hz2 hpow1
    have hρ8 : z.1 0 ^ 2 + z.1 1 ^ 2 < 8 * B.Xb := by
      rw [← hrsq]
      calc rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2) := hhi
        _ ≤ 8 * B.Xb * 1 := mul_le_mul_of_nonneg_left hq1 (by linarith)
        _ = 8 * B.Xb := mul_one _
    have hnx : ‖z.1‖ ^ 2 = z.1 0 ^ 2 + z.1 1 ^ 2 + z.1 2 ^ 2 := by
      rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity), Fin.sum_univ_three]
      simp [Real.norm_eq_abs, sq_abs]
    have hlt : ‖z.1‖ ^ 2 < 8 * B.Xb + 1 := by rw [hnx]; linarith
    have hx : ‖z.1‖ ≤ 8 * B.Xb + 2 := by linarith [sq_nonneg (‖z.1‖ - 1)]
    have ht0 : 0 ≤ z.2 := by linarith
    have hnz : ‖z‖ ≤ 8 * B.Xb + 2 := by
      rw [Prod.norm_def, max_le_iff]
      refine ⟨hx, ?_⟩
      rw [Real.norm_eq_abs, abs_of_nonneg ht0]
      linarith
    exact ⟨ht1, hq0, hq1, by linarith, hρ8, hnz⟩
  have hq01 : ∀ w ∈ W, 0 < simScale B.h (w.1 2) (1 - w.2) ∧ simScale B.h (w.1 2) (1 - w.2) ≤ 1 :=
    fun w hw => ⟨(hfac w hw).2.1, (hfac w hw).2.2.1⟩

  have hbdd : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (φ : ℝ³ × ℝ → V),
      ContDiff ℝ ∞ φ → ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ W,
        ‖iteratedFDeriv ℝ k φ w‖ ≤ C * simScale B.h (w.1 2) (1 - w.2) ^ (-K) := by
    intro V _ _ φ hφ k
    have hc : Continuous (fun z => iteratedFDeriv ℝ k φ z) :=
      hφ.continuous_iteratedFDeriv (by exact_mod_cast le_top)
    obtain ⟨C, hC⟩ := (isCompact_closedBall (0 : ℝ³ × ℝ) (8 * B.Xb + 2)).exists_bound_of_continuousOn
      hc.continuousOn
    refine ⟨C, 0, fun w hw => ?_⟩
    rw [neg_zero, Real.rpow_zero, mul_one]
    exact hC w (mem_closedBall_zero_iff.mpr (hfac w hw).2.2.2.2.2)

  have hadd : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f g : ℝ³ × ℝ → V),
      ContDiffOn ℝ ∞ f W → ContDiffOn ℝ ∞ g W →
      (∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ W,
        ‖iteratedFDeriv ℝ k f w‖ ≤ C * simScale B.h (w.1 2) (1 - w.2) ^ (-K)) →
      (∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ W,
        ‖iteratedFDeriv ℝ k g w‖ ≤ C * simScale B.h (w.1 2) (1 - w.2) ^ (-K)) →
      ContDiffOn ℝ ∞ (fun z => f z + g z) W ∧ ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ W,
        ‖iteratedFDeriv ℝ k (fun z => f z + g z) w‖ ≤ C * simScale B.h (w.1 2) (1 - w.2) ^ (-K) := by
    intro V _ _ f g hf hg bf bg
    refine ⟨hf.add hg, fun k => ?_⟩
    obtain ⟨C1, K1, h1⟩ := bf k
    obtain ⟨C2, K2, h2⟩ := bg k
    refine ⟨|C1| + |C2|, max K1 K2, fun w hw => ?_⟩
    have hq := hq01 w hw
    have hmle : ((k : ℕ) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
    have hnh : W ∈ nhds w := hWo.mem_nhds hw
    have hsum : iteratedFDeriv ℝ k (fun z => f z + g z) w =
        iteratedFDeriv ℝ k f w + iteratedFDeriv ℝ k g w :=
      iteratedFDeriv_add_apply ((hf.contDiffAt hnh).of_le hmle) ((hg.contDiffAt hnh).of_le hmle)
    rw [hsum]
    have e1 := (h1 w hw).trans (key2 C1 _ _ _ hq.1 hq.2 (neg_le_neg (le_max_left K1 K2)))
    have e2 := (h2 w hw).trans (key2 C2 _ _ _ hq.1 hq.2 (neg_le_neg (le_max_right K1 K2)))
    calc ‖iteratedFDeriv ℝ k f w + iteratedFDeriv ℝ k g w‖
        ≤ ‖iteratedFDeriv ℝ k f w‖ + ‖iteratedFDeriv ℝ k g w‖ := norm_add_le _ _
      _ ≤ |C1| * simScale B.h (w.1 2) (1 - w.2) ^ (-max K1 K2) +
          |C2| * simScale B.h (w.1 2) (1 - w.2) ^ (-max K1 K2) := add_le_add e1 e2
      _ = (|C1| + |C2|) * simScale B.h (w.1 2) (1 - w.2) ^ (-max K1 K2) := by ring

  have hρc : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => z.1 0 ^ 2 + z.1 1 ^ 2) :=
    ((hco 0).pow 2).add ((hco 1).pow 2)
  have hrho : ∀ p : ℝ, ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => (z.1 0 ^ 2 + z.1 1 ^ 2) ^ p) W ∧
      ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ W, ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => (z.1 0 ^ 2 + z.1 1 ^ 2) ^ p) w‖ ≤
        C * simScale B.h (w.1 2) (1 - w.2) ^ (-K) := by
    intro p
    have hg : ContDiffOn ℝ ∞ (fun s : ℝ => s ^ p) (Ioi 0) :=
      fun _ hs => (Real.contDiffAt_rpow_const_of_ne (ne_of_gt hs)).contDiffWithinAt
    have hmT : Set.MapsTo (fun z : ℝ³ × ℝ => z.1 0 ^ 2 + z.1 1 ^ 2) W (Ioi 0) := by
      intro z hz
      have hf := hfac z hz
      have ha : 0 < B.Xa / 2 * simScale B.h (z.1 2) (1 - z.2) := mul_pos (by linarith) hf.2.1
      exact mem_Ioi.mpr (lt_trans ha hf.2.2.2.1)
    have hnorm : ∀ (k : ℕ) (s : ℝ), 0 < s → ‖iteratedFDeriv ℝ k (fun s : ℝ => s ^ p) s‖ =
        |(descPochhammer ℝ k).eval p| * s ^ (p - k) := by
      intro k s hs
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
        Real.iter_deriv_rpow_const, Real.norm_eq_abs, abs_mul, abs_of_pos (Real.rpow_pos_of_pos hs _)]
    have hgb : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ W,
        ‖iteratedFDeriv ℝ k (fun s : ℝ => s ^ p) ((fun z : ℝ³ × ℝ => z.1 0 ^ 2 + z.1 1 ^ 2) w)‖ ≤
          C * simScale B.h (w.1 2) (1 - w.2) ^ (-K) := by
      intro k
      by_cases hpk : 0 ≤ p - k
      · refine ⟨|(descPochhammer ℝ k).eval p| * (8 * B.Xb) ^ (p - k), 0, fun w hw => ?_⟩
        have hf := hfac w hw
        have hs0 : 0 < w.1 0 ^ 2 + w.1 1 ^ 2 := hmT hw
        rw [neg_zero, Real.rpow_zero, mul_one]
        show ‖iteratedFDeriv ℝ k (fun s : ℝ => s ^ p) (w.1 0 ^ 2 + w.1 1 ^ 2)‖ ≤ _
        rw [hnorm k _ hs0]
        exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow hs0.le hf.2.2.2.2.1.le hpk)
          (abs_nonneg _)
      · push_neg at hpk
        refine ⟨|(descPochhammer ℝ k).eval p| * (B.Xa / 2) ^ (p - k), k - p, fun w hw => ?_⟩
        have hf := hfac w hw
        have hs0 : 0 < w.1 0 ^ 2 + w.1 1 ^ 2 := hmT hw
        have ha0 : 0 < B.Xa / 2 * simScale B.h (w.1 2) (1 - w.2) := mul_pos (by linarith) hf.2.1
        show ‖iteratedFDeriv ℝ k (fun s : ℝ => s ^ p) (w.1 0 ^ 2 + w.1 1 ^ 2)‖ ≤ _
        rw [hnorm k _ hs0]
        have h1 : (w.1 0 ^ 2 + w.1 1 ^ 2) ^ (p - k) ≤
            (B.Xa / 2 * simScale B.h (w.1 2) (1 - w.2)) ^ (p - k) :=
          Real.rpow_le_rpow_of_nonpos ha0 hf.2.2.2.1.le hpk.le
        rw [Real.mul_rpow (by linarith) hf.2.1.le] at h1
        calc |(descPochhammer ℝ k).eval p| * (w.1 0 ^ 2 + w.1 1 ^ 2) ^ (p - k)
            ≤ |(descPochhammer ℝ k).eval p| *
                ((B.Xa / 2) ^ (p - k) * simScale B.h (w.1 2) (1 - w.2) ^ (p - k)) :=
              mul_le_mul_of_nonneg_left h1 (abs_nonneg _)
          _ = |(descPochhammer ℝ k).eval p| * (B.Xa / 2) ^ (p - k) *
                simScale B.h (w.1 2) (1 - w.2) ^ (-((k:ℝ) - p)) := by
              rw [neg_sub]; ring
    exact wt_comp_bound (fun s : ℝ => s ^ p) (fun z : ℝ³ × ℝ => z.1 0 ^ 2 + z.1 1 ^ 2)
      (fun w => simScale B.h (w.1 2) (1 - w.2)) W W (Ioi 0) hWo isOpen_Ioi subset_rfl hmT hq01 hg
      hρc.contDiffOn hgb (hbdd _ hρc)

  obtain ⟨u1, hu1⟩ : ∃ f : ℝ³ × ℝ → ℝ, f = fun z => (z.1 0 ^ 2 + z.1 1 ^ 2) ^ (1/2 : ℝ) := ⟨_, rfl⟩
  obtain ⟨u4, hu4⟩ : ∃ f : ℝ³ × ℝ → ℝ, f = fun z => (z.1 0 ^ 2 + z.1 1 ^ 2) ^ (1/2 * drx B.h) :=
    ⟨_, rfl⟩
  obtain ⟨v, hv⟩ : ∃ f : ℝ³ × ℝ → ℝ, f = fun z => (z.1 0 ^ 2 + z.1 1 ^ 2) ^ (-(1/2 : ℝ)) := ⟨_, rfl⟩
  obtain ⟨Aff, hAffd⟩ : ∃ f : ℝ³ × ℝ → Cyl, f = fun z => ((0:ℝ), z.1 2, z.2, z.2 • vtv) := ⟨_, rfl⟩
  obtain ⟨e1, he1⟩ : ∃ c : Cyl, c = ((1:ℝ), (0:ℝ), (0:ℝ), ((0:ℝ), (0:ℝ))) := ⟨_, rfl⟩
  obtain ⟨e4, he4⟩ : ∃ c : Cyl, c = ((0:ℝ), (0:ℝ), (0:ℝ), vrv) := ⟨_, rfl⟩
  obtain ⟨lsC, hlsC⟩ : ∃ L : ℝ →L[ℝ] Cyl →L[ℝ] Cyl, L = ContinuousLinearMap.lsmul ℝ ℝ := ⟨_, rfl⟩
  obtain ⟨lsE, hlsE⟩ : ∃ L : ℝ →L[ℝ] ℝ³ →L[ℝ] ℝ³, L = ContinuousLinearMap.lsmul ℝ ℝ := ⟨_, rfl⟩
  have sU1 : ContDiffOn ℝ ∞ u1 W := by rw [hu1]; exact (hrho _).1
  have bU1 : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ W,
      ‖iteratedFDeriv ℝ k u1 w‖ ≤ C * simScale B.h (w.1 2) (1 - w.2) ^ (-K) := by
    rw [hu1]; exact (hrho _).2
  have sU4 : ContDiffOn ℝ ∞ u4 W := by rw [hu4]; exact (hrho _).1
  have bU4 : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ W,
      ‖iteratedFDeriv ℝ k u4 w‖ ≤ C * simScale B.h (w.1 2) (1 - w.2) ^ (-K) := by
    rw [hu4]; exact (hrho _).2
  have sV : ContDiffOn ℝ ∞ v W := by rw [hv]; exact (hrho _).1
  have bV : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ W,
      ‖iteratedFDeriv ℝ k v w‖ ≤ C * simScale B.h (w.1 2) (1 - w.2) ^ (-K) := by
    rw [hv]; exact (hrho _).2
  have hAff : ContDiff ℝ ∞ Aff := by
    rw [hAffd]
    exact contDiff_const.prodMk ((hco 2).prodMk (contDiff_snd.prodMk (contDiff_snd.smul contDiff_const)))
  have hI1 : ∀ x : ℝ³, rad x = (x 0 ^ 2 + x 1 ^ 2) ^ (1/2 : ℝ) := fun x => Real.sqrt_eq_rpow _

  obtain ⟨sP1, bP1⟩ := wt_bilinear_bound lsC u1 (fun _ : ℝ³ × ℝ => e1)
    (fun w => simScale B.h (w.1 2) (1 - w.2)) W W hWo subset_rfl hq01 sU1 contDiffOn_const bU1
    (hbdd _ contDiff_const)
  obtain ⟨sP4, bP4⟩ := wt_bilinear_bound lsC u4 (fun _ : ℝ³ × ℝ => e4)
    (fun w => simScale B.h (w.1 2) (1 - w.2)) W W hWo subset_rfl hq01 sU4 contDiffOn_const bU4
    (hbdd _ contDiff_const)
  obtain ⟨sA1, bA1⟩ := hadd Aff (fun z => lsC (u1 z) e1) hAff.contDiffOn sP1 (hbdd _ hAff) bP1
  obtain ⟨sXi0, bXi0⟩ := hadd (fun z => Aff z + lsC (u1 z) e1) (fun z => lsC (u4 z) e4) sA1 sP4 bA1 bP4
  have hXi_eq : (fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) =
      fun z => (Aff z + lsC (u1 z) e1) + lsC (u4 z) e4 := by
    funext z
    have I2 : rad z.1 ^ drx B.h = (z.1 0 ^ 2 + z.1 1 ^ 2) ^ (1/2 * drx B.h) := by
      rw [hI1, ← Real.rpow_mul (by positivity)]
    subst hu1 hu4 hAffd he1 he4 hlsC
    beta_reduce
    rw [← hI1, ← I2]
    simp only [ContinuousLinearMap.lsmul_apply, ptOf, Yph, add_zero]
    ext <;> simp <;> ring
  have sXi : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) W := by
    rw [hXi_eq]; exact sXi0
  have bXi : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ W,
      ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) w‖ ≤
        C * simScale B.h (w.1 2) (1 - w.2) ^ (-K) := by
    rw [hXi_eq]; exact bXi0

  have hAz : ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => azVec z.1) := by
    show ContDiff ℝ ∞ (fun z : ℝ³ × ℝ => -(z.1 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
      z.1 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ))
    exact ((hco 1).neg.smul contDiff_const).add ((hco 0).smul contDiff_const)
  obtain ⟨sE0, bE0⟩ := wt_bilinear_bound lsE v (fun z : ℝ³ × ℝ => azVec z.1)
    (fun w => simScale B.h (w.1 2) (1 - w.2)) W W hWo subset_rfl hq01 sV hAz.contDiffOn bV
    (hbdd _ hAz)
  have hE_eq : (fun z : ℝ³ × ℝ => eTh z.1) = fun z => lsE (v z) (azVec z.1) := by
    funext z
    have I3 : (rad z.1)⁻¹ = (z.1 0 ^ 2 + z.1 1 ^ 2) ^ (-(1/2:ℝ)) := by
      rw [hI1, Real.rpow_neg (by positivity)]
    subst hv hlsE
    simp only [eTh, ContinuousLinearMap.lsmul_apply, I3]
  have sE : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => eTh z.1) W := by rw [hE_eq]; exact sE0
  have bE : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ W,
      ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => eTh z.1) w‖ ≤
        C * simScale B.h (w.1 2) (1 - w.2) ^ (-K) := by
    rw [hE_eq]; exact bE0

  obtain ⟨sP0, bP0⟩ := simScale_rpow_wt_bound B.h e hSP hh0 (by linarith)
  have sP : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => simScale B.h (z.1 2) (1 - z.2) ^ e) W :=
    sP0.mono (fun z hz => (hfac z hz).1)
  have bP : ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ W,
      ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => simScale B.h (z.1 2) (1 - z.2) ^ e) w‖ ≤
        C * simScale B.h (w.1 2) (1 - w.2) ^ (-K) := by
    intro k
    obtain ⟨C, K, hC⟩ := bP0 k
    exact ⟨C, K, fun w hw => hC w (hfac w hw).1 (hfac w hw).2.2.1⟩

  refine ⟨hD, hWo, hmap, sXi, sE, sP, fun k => ?_⟩
  obtain ⟨C1, K1, h1⟩ := bXi k
  obtain ⟨C2, K2, h2⟩ := bE k
  obtain ⟨C3, K3, h3⟩ := bP k
  refine ⟨|C1| + |C2| + |C3|, max K1 (max K2 K3), fun z hz => ?_⟩
  have hq := hq01 z hz
  have hpn : 0 ≤ simScale B.h (z.1 2) (1 - z.2) ^ (-max K1 (max K2 K3)) := Real.rpow_nonneg hq.1.le _
  have hK1 : K1 ≤ max K1 (max K2 K3) := le_max_left _ _
  have hK2 : K2 ≤ max K1 (max K2 K3) := le_trans (le_max_left _ _) (le_max_right _ _)
  have hK3 : K3 ≤ max K1 (max K2 K3) := le_trans (le_max_right _ _) (le_max_right _ _)
  have f1 := (h1 z hz).trans (key2 C1 _ _ _ hq.1 hq.2 (neg_le_neg hK1))
  have f2 := (h2 z hz).trans (key2 C2 _ _ _ hq.1 hq.2 (neg_le_neg hK2))
  have f3 := (h3 z hz).trans (key2 C3 _ _ _ hq.1 hq.2 (neg_le_neg hK3))
  have a1 := abs_nonneg C1
  have a2 := abs_nonneg C2
  have a3 := abs_nonneg C3
  refine ⟨f1.trans (mul_le_mul_of_nonneg_right (by linarith) hpn),
    f2.trans (mul_le_mul_of_nonneg_right (by linarith) hpn),
    f3.trans (mul_le_mul_of_nonneg_right (by linarith) hpn)⟩

theorem wv5_window_reduction : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (e : ℝ) (a : WC), B.ok → (∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → a γ m ξ = 0) → (∀ z ∈ {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)}, ipb5WV B G l0 e a z = simScale B.h (z.1 2) (1 - z.2) ^ e • cyl2cart z.1 (waveV5 B G a (thetaOf z.1) (ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)))) ∧ ∀ z ∈ simDomain B.h (qsOf l0), z ∈ {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} ∨ ipb5WV B G l0 e a =ᶠ[nhds z] (fun _ => (0 : ℝ³)) :=
by
  intro B G l0 e a hok hvan
  obtain ⟨-, -, hXa, hXa1, h12, h2Xb, -⟩ := hok.2.1
  have hXb : 0 < B.Xb := by linarith
  have hqpos : ∀ w : ℝ³ × ℝ, w.2 < 1 → 0 < simScale B.h (w.1 2) (1 - w.2) := fun w hw =>
    (hok.1.1 (w.1 2) (1 - w.2) (by linarith)).1
  have hqcont : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    have hmap : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
      (((EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst).prodMk
        (continuous_const.sub continuous_snd))
    refine hok.1.2.2.2.1.continuousOn.comp hmap.continuousOn ?_
    intro w hw
    exact ⟨mem_univ _, mem_Ioi.mpr (sub_pos.mpr hw)⟩
  have hΩ : IsOpen (simDomain B.h (qsOf l0)) := by
    have e : simDomain B.h (qsOf l0) = {w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0) := rfl
    rw [e]
    exact hqcont.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  have hqcΩ : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      (simDomain B.h (qsOf l0)) := hqcont.mono (fun w hw => hw.1)
  have hrad : Continuous (fun w : ℝ³ × ℝ => rad w.1 ^ 2) := by
    have p0 : Continuous (fun w : ℝ³ × ℝ => w.1 0) :=
      (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst
    have p1 : Continuous (fun w : ℝ³ × ℝ => w.1 1) :=
      (EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ).continuous.comp continuous_fst
    unfold rad
    exact (Real.continuous_sqrt.comp ((p0.pow 2).add (p1.pow 2))).pow 2

  have hwz : ∀ (θ : ℝ) (ξ : Cyl), (∀ γ m, a γ m ξ = 0) → waveV5 B G a θ ξ = 0 := by
    intro θ ξ h
    funext i
    simp only [waveV5, h, Pi.zero_apply, zero_mul, finsum_zero, Complex.zero_re]
  have hcz : ∀ x : ℝ³, cyl2cart x 0 = 0 := by
    intro x
    simp only [cyl2cart, Pi.zero_apply, zero_smul, add_zero]

  have hzero : ∀ w : ℝ³ × ℝ, (corrOn B l0 w.1 w.2 →
      XC B.h (ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0)) < B.Xa ∨
        B.Xb < XC B.h (ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0))) →
      ipb5WV B G l0 e a w = 0 := by
    intro w H
    by_cases hc : corrOn B l0 w.1 w.2
    · have hmem : ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0) ∈ DomC B.h (qsOf l0) :=
        ⟨hc.1, hc.2.1, hc.2.2⟩
      have ha0 : ∀ γ m, a γ m (ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0)) = 0 :=
        fun γ m => hvan γ m _ hmem (H hc)
      simp only [ipb5WV, if_pos hc, hwz _ _ ha0, hcz, smul_zero]
    · simp only [ipb5WV, if_neg hc]
  refine ⟨?_, ?_⟩
  · intro z hz
    obtain ⟨hzΩ, hr, -, -⟩ := hz
    have hc : corrOn B l0 z.1 z.2 := ⟨hr, hzΩ.1, hzΩ.2⟩
    simp only [ipb5WV, if_pos hc]
    rfl
  · intro z hz
    have hQ : 0 < simScale B.h (z.1 2) (1 - z.2) := hqpos z hz.1
    have hO₁ : IsOpen (simDomain B.h (qsOf l0) ∩
        (fun w : ℝ³ × ℝ => B.Xa * simScale B.h (w.1 2) (1 - w.2) - rad w.1 ^ 2) ⁻¹' Ioi 0) :=
      ((continuousOn_const.mul hqcΩ).sub hrad.continuousOn).isOpen_inter_preimage hΩ isOpen_Ioi
    have hO₂ : IsOpen (simDomain B.h (qsOf l0) ∩
        (fun w : ℝ³ × ℝ => rad w.1 ^ 2 - 4 * B.Xb * simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Ioi 0) :=
      (hrad.continuousOn.sub (continuousOn_const.mul hqcΩ)).isOpen_inter_preimage hΩ isOpen_Ioi
    have hXCeq : ∀ w : ℝ³ × ℝ, XC B.h (ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0)) =
        rad w.1 ^ 2 / (2 * simScale B.h (w.1 2) (1 - w.2)) := fun w => rfl
    by_cases h1 : rad z.1 ^ 2 < B.Xa * simScale B.h (z.1 2) (1 - z.2)
    · right
      have hzO : z ∈ simDomain B.h (qsOf l0) ∩
          (fun w : ℝ³ × ℝ => B.Xa * simScale B.h (w.1 2) (1 - w.2) - rad w.1 ^ 2) ⁻¹' Ioi 0 :=
        ⟨hz, sub_pos.mpr h1⟩
      refine Filter.eventuallyEq_of_mem (hO₁.mem_nhds hzO) (fun w hw => ?_)
      apply hzero w
      intro _
      left
      have hqw := hqpos w hw.1.1
      have hw2 : 0 < B.Xa * simScale B.h (w.1 2) (1 - w.2) - rad w.1 ^ 2 := hw.2
      have hpos : 0 < B.Xa * simScale B.h (w.1 2) (1 - w.2) := mul_pos hXa hqw
      rw [hXCeq w, div_lt_iff₀ (by linarith)]
      linarith
    by_cases h2 : 4 * B.Xb * simScale B.h (z.1 2) (1 - z.2) < rad z.1 ^ 2
    · right
      have hzO : z ∈ simDomain B.h (qsOf l0) ∩
          (fun w : ℝ³ × ℝ => rad w.1 ^ 2 - 4 * B.Xb * simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Ioi 0 :=
        ⟨hz, sub_pos.mpr h2⟩
      refine Filter.eventuallyEq_of_mem (hO₂.mem_nhds hzO) (fun w hw => ?_)
      apply hzero w
      intro _
      right
      have hqw := hqpos w hw.1.1
      have hw2 : 0 < rad w.1 ^ 2 - 4 * B.Xb * simScale B.h (w.1 2) (1 - w.2) := hw.2
      have hpos : 0 < B.Xb * simScale B.h (w.1 2) (1 - w.2) := mul_pos hXb hqw
      rw [hXCeq w, lt_div_iff₀ (by linarith)]
      linarith
    left
    push_neg at h1 h2
    have hpa : 0 < B.Xa * simScale B.h (z.1 2) (1 - z.2) := mul_pos hXa hQ
    have hpb : 0 < B.Xb * simScale B.h (z.1 2) (1 - z.2) := mul_pos hXb hQ
    have hr : 0 < rad z.1 := by
      rcases (Real.sqrt_nonneg (z.1 0 ^ 2 + z.1 1 ^ 2)).lt_or_eq with h | h
      · exact h
      · exfalso
        have h0 : rad z.1 = 0 := h.symm
        rw [h0] at h1
        linarith
    refine ⟨hz, hr, by linarith, by linarith⟩

theorem wv5_label_count : ∀ (h : ℝ), SimScaleProps h → ∀ ξ : Cyl, ξ.2.2.1 < 1 → ∃ Γ : Finset Lab, Γ.card ≤ 162 ∧ ∀ γ : Lab, ξ ∈ tsupport (etaL h γ) → γ ∈ Γ :=
by
  classical
  intro h hS ξ0 hξ0
  have hq0 : 0 < qC h ξ0 := (hS.1 ξ0.2.1 (1 - ξ0.2.2.1) (by linarith)).1
  have hqc : ContinuousAt (qC h) ξ0 := by
    have hmem : ((ξ0.2.1, 1 - ξ0.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ)) :=
      ⟨mem_univ _, show (0:ℝ) < 1 - ξ0.2.2.1 by linarith⟩
    have hg : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (ξ0.2.1, 1 - ξ0.2.2.1) :=
      hS.2.2.2.1.continuousOn.continuousAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds hmem)
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    exact hg.comp (f := fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) hφ.continuousAt
  have hlogc : ContinuousAt (fun ξ => Real.logb 2 (qC h ξ)) ξ0 := by
    have := ((Real.continuousAt_log hq0.ne').comp hqc).div_const (Real.log 2)
    exact this
  have hK : ∀ (μ : ℝ) (j : ℤ) (s : ℝ), sqPart μ j s ≠ 0 → |s / μ - (j:ℝ)| < 1 := by
    intro μ j s hne
    have hb : bumpR (s / μ - j) ≠ 0 := by
      intro h0
      apply hne
      unfold sqPart
      rw [h0, zero_div]
    unfold bumpR at hb
    by_contra hlt
    apply hb
    apply Real.smoothTransition.zero_of_nonpos
    have h1 : (1:ℝ) ≤ |s / μ - j| := not_lt.mp hlt
    have h2 : (1:ℝ) ≤ (s / μ - j) ^ 2 := by
      calc (1:ℝ) = 1 * 1 := by norm_num
        _ ≤ |s / μ - j| * |s / μ - j| := mul_le_mul h1 h1 zero_le_one (abs_nonneg _)
        _ = (s / μ - j) ^ 2 := by rw [← sq, sq_abs]
    linarith
  have hWin : ∀ (γ : Lab) (ξ : Cyl), etaL h γ ξ ≠ 0 →
      |Real.logb 2 (qC h ξ) + (γ.1 : ℝ)| < 1 ∧
      |chartR h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1 : ℝ)| < 1 ∧
      |chartZ h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.1 : ℝ)| < 1 ∧
      |chartT h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2 : ℝ)| < 1 := by
    intro γ ξ hne
    unfold etaL at hne
    obtain ⟨hA, hBC⟩ := mul_ne_zero_iff.mp hne
    obtain ⟨hB12, hB3⟩ := mul_ne_zero_iff.mp hBC
    obtain ⟨hB1, hB2⟩ := mul_ne_zero_iff.mp hB12
    refine ⟨?_, hK _ _ _ hB1, hK _ _ _ hB2, hK _ _ _ hB3⟩
    have h0 := hK _ _ _ hA
    have e : Real.logb 2 (qC h ξ) / 1 - (((-(γ.1:ℤ)) : ℤ) : ℝ) =
        Real.logb 2 (qC h ξ) + (γ.1 : ℝ) := by
      push_cast; ring
    rw [e] at h0
    exact h0
  obtain ⟨W, hWdef⟩ : ∃ W : ℝ → Finset ℤ, W = fun y => Finset.Icc ⌈y - 1⌉ ⌊y + 1⌋ := ⟨_, rfl⟩
  have hWm : ∀ (y : ℝ) (z : ℤ), |y - (z:ℝ)| ≤ 1 → z ∈ W y := by
    intro y z hz
    obtain ⟨h1, h2⟩ := abs_le.mp hz
    simp only [hWdef, Finset.mem_Icc]
    exact ⟨Int.ceil_le.mpr (by linarith), Int.le_floor.mpr (by linarith)⟩
  have hWc : ∀ y : ℝ, (W y).card ≤ 3 := by
    intro y
    simp only [hWdef]
    rw [Int.card_Icc]
    have h1 := Int.floor_le (y + 1)
    have h2 := Int.le_ceil (y - 1)
    have h3 : ((⌊y + 1⌋ - ⌈y - 1⌉ : ℤ) : ℝ) ≤ 2 := by push_cast; linarith
    have h4 : ⌊y + 1⌋ - ⌈y - 1⌉ ≤ 2 := by exact_mod_cast h3
    have h5 : ⌊y + 1⌋ + 1 - ⌈y - 1⌉ ≤ ((3:ℕ):ℤ) := by push_cast; omega
    exact Int.toNat_le.mpr h5
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : Finset Lab, Λ = ((W (-Real.logb 2 (qC h ξ0))).image Int.toNat).biUnion
      (fun ℓ => ((W (chartR h ℓ ξ0 / Sb ℓ ^ (-3:ℤ))) ×ˢ ((W (chartZ h ℓ ξ0 / Sb ℓ ^ (-3:ℤ))) ×ˢ
        ((W (chartT h ℓ ξ0 / Sb ℓ ^ (-3:ℤ))) ×ˢ (Finset.univ : Finset Bool)))).image
        (fun z : ℤ × ℤ × ℤ × Bool => ((ℓ, (z.1, z.2.1, z.2.2.1), z.2.2.2) : Lab))) := ⟨_, rfl⟩
  have hΛcard : Λ.card ≤ 162 := by
    rw [hΛ]
    refine le_trans Finset.card_biUnion_le ?_
    refine le_trans (Finset.sum_le_sum (g := fun _ => 54) (fun ℓ _ => ?_)) ?_
    · refine le_trans Finset.card_image_le ?_
      rw [Finset.card_product, Finset.card_product, Finset.card_product, Finset.card_univ,
        Fintype.card_bool]
      calc _ ≤ 3 * (3 * (3 * 2)) :=
            Nat.mul_le_mul (hWc _) (Nat.mul_le_mul (hWc _) (Nat.mul_le_mul (hWc _) le_rfl))
        _ = 54 := by norm_num
    · simp only [Finset.sum_const, smul_eq_mul]
      have := le_trans (Finset.card_image_le (s := W (-Real.logb 2 (qC h ξ0))) (f := Int.toNat))
        (hWc (-Real.logb 2 (qC h ξ0)))
      omega
  have hmemΛ : ∀ γ : Lab, |Real.logb 2 (qC h ξ0) + (γ.1 : ℝ)| ≤ 1 →
      |chartR h γ.1 ξ0 / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1 : ℝ)| ≤ 1 →
      |chartZ h γ.1 ξ0 / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.1 : ℝ)| ≤ 1 →
      |chartT h γ.1 ξ0 / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2 : ℝ)| ≤ 1 → γ ∈ Λ := by
    intro γ h0 h1 h2 h3
    rw [hΛ, Finset.mem_biUnion]
    refine ⟨γ.1, ?_, ?_⟩
    · rw [Finset.mem_image]
      refine ⟨(γ.1 : ℤ), hWm _ _ ?_, Int.toNat_natCast γ.1⟩
      have e : -Real.logb 2 (qC h ξ0) - (((γ.1 : ℤ)) : ℝ) =
          -(Real.logb 2 (qC h ξ0) + (γ.1 : ℝ)) := by
        push_cast; ring
      rw [e, abs_neg]
      exact h0
    · rw [Finset.mem_image]
      refine ⟨(γ.2.1.1, γ.2.1.2.1, γ.2.1.2.2, γ.2.2), ?_, rfl⟩
      simp only [Finset.mem_product, Finset.mem_univ, and_true]
      exact ⟨hWm _ _ h1, hWm _ _ h2, hWm _ _ h3⟩
  refine ⟨Λ, hΛcard, fun γ hγ => ?_⟩
  have hcl : ξ0 ∈ closure (Function.support (etaL h γ)) := hγ
  have hEtS : ∀ ξ ∈ Function.support (etaL h γ), etaL h γ ξ ≠ 0 := fun ξ hξ => hξ
  have key : ∀ f : Cyl → ℝ, ContinuousAt f ξ0 →
      (∀ ξ ∈ Function.support (etaL h γ), f ξ < 1) → f ξ0 ≤ 1 := by
    intro f hf hlt
    exact ContinuousWithinAt.closure_le hcl hf.continuousWithinAt continuousWithinAt_const
      (fun ξ hξ => (hlt ξ hξ).le)
  exact hmemΛ γ
    (key (fun ξ => |Real.logb 2 (qC h ξ) + (γ.1 : ℝ)|)
      (continuous_abs.continuousAt.comp (hlogc.add continuousAt_const))
      (fun ξ hξ => (hWin γ ξ (hEtS ξ hξ)).1))
    (key (fun ξ => |chartR h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1 : ℝ)|)
      ((continuous_abs.comp (by unfold chartR; fun_prop)).continuousAt)
      (fun ξ hξ => (hWin γ ξ (hEtS ξ hξ)).2.1))
    (key (fun ξ => |chartZ h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.1 : ℝ)|)
      ((continuous_abs.comp (by unfold chartZ; fun_prop)).continuousAt)
      (fun ξ hξ => (hWin γ ξ (hEtS ξ hξ)).2.2.1))
    (key (fun ξ => |chartT h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2 : ℝ)|)
      ((continuous_abs.comp (by unfold chartT; fun_prop)).continuousAt)
      (fun ξ hξ => (hWin γ ξ (hEtS ξ hξ)).2.2.2))

theorem wv5_raw_coef_bound : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ), B.ok → GeomPrim5 B G → 60 ≤ l0 → ∀ (α : ℝ) (a : WC), InWg5 B G (qsOf l0) α a → ∀ n : ℕ, ∃ C : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ∀ j : ℕ, j ≤ n → ‖iteratedFDeriv ℝ j (a γ m) ξ‖ ≤ C * qC B.h ξ ^ (B.h * α - 2 * (n : ℝ) - 1) :=
by
  intro B G l0 hok hG hl0 α a ha n

  have hinvB : ∀ (h : ℝ) (ξ : Cyl), 0 ≤ h → h ≤ 1/2 → 0 < qC h ξ → qC h ξ ≤ 1 →
      0 ≤ coarseIdx h (qC h ξ) → Tgc ^ (coarseIdx h (qC h ξ)) ≤ qC h ξ ^ (-(2:ℝ)) →
      ∀ (g : Cyl → (Fin 3 → ℂ)) (k : ℕ),
        ‖iteratedFDeriv ℝ k g ξ‖ ≤ (4 * qC h ξ ^ (-(2:ℝ))) ^ k * NB h g k ξ := by
    intro h ξ hh0 hh1 hq hhi hn hTn g k
    have hs2lt : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
    have hs2gt : 1 < Real.sqrt 2 := Real.one_lt_sqrt_two
    have hL : Lgc ≠ 0 := by unfold Lgc; intro h0; linarith
    have hTg : Tgc ≠ 0 := by unfold Tgc; intro h0; linarith [Real.sqrt_nonneg 2]
    have hN : (1 + bgc ^ 2) ≠ 0 := by positivity
    have c1 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).1 = Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) +
        Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) * bgc := by
      intro n Y
      simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
      ring
    have c2 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).2 = -(Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) * bgc) +
        Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) := by
      intro n Y
      simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
      ring
    have hcomp : ∀ (m n : ℤ) (Y : ℝ × ℝ), Jpow m (Jpow n Y) = Jpow (m + n) Y := by
      intro m n Y
      refine Prod.ext ?_ ?_
      · rw [c1 m, c1 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hTg]
        field_simp
        ring
      · rw [c2 m, c2 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hTg]
        field_simp
        ring
    have hid : ∀ Y : ℝ × ℝ, Jpow 0 Y = Y := by
      intro Y
      refine Prod.ext ?_ ?_
      · rw [c1, zpow_zero, zpow_zero]
        field_simp
        ring
      · rw [c2, zpow_zero, zpow_zero]
        field_simp
        ring
    have hJ : ∀ (m : ℤ) (Y : ℝ × ℝ), JpowL m Y = Jpow m Y := by
      intro m Y
      refine Prod.ext ?_ ?_
      · simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
          ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Prod.fst_add, Prod.smul_fst,
          smul_eq_mul]
        rw [c1, c1, c1]
        ring
      · simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
          ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Prod.snd_add, Prod.smul_snd,
          smul_eq_mul]
        rw [c2, c2, c2]
        ring
    have hJinv : ∀ (n : ℤ) (Y : ℝ × ℝ), JpowL (-n) (JpowL n Y) = Y := by
      intro n Y
      rw [hJ, hJ, hcomp, neg_add_cancel, hid]
    have hb0 : 0 ≤ bgc := by unfold bgc; linarith
    have hb1 : bgc ≤ 1 := by unfold bgc; linarith
    have hc1 : 1 ≤ 1 + bgc ^ 2 := le_add_of_nonneg_right (sq_nonneg _)
    have hcpos : (0:ℝ) < 1 + bgc ^ 2 := by linarith
    have hLpos : 0 < Lgc := by unfold Lgc; linarith
    have hLT : Lgc ≤ Tgc := by unfold Lgc Tgc; linarith [Real.sqrt_nonneg 2]
    obtain ⟨K, hK⟩ : ∃ K : ℝ, K = 4 * qC h ξ ^ (-(2:ℝ)) := ⟨_, rfl⟩
    have hQ1 : 1 ≤ qC h ξ ^ (-(2:ℝ)) :=
      Real.one_le_rpow_of_pos_of_le_one_of_nonpos hq hhi (by norm_num)
    have hqinvQ : (qC h ξ)⁻¹ ≤ qC h ξ ^ (-(2:ℝ)) := by
      rw [← Real.rpow_neg_one]
      exact Real.rpow_le_rpow_of_exponent_ge hq hhi (by norm_num)
    have hK0 : 0 ≤ K := by rw [hK]; linarith
    have hQK : qC h ξ ^ (-(2:ℝ)) ≤ K := by rw [hK]; linarith
    have hqK : (qC h ξ)⁻¹ ≤ K := le_trans hqinvQ hQK
    have hsq0 : 0 < Real.sqrt (qC h ξ) := Real.sqrt_pos.mpr hq
    have hsq1 : Real.sqrt (qC h ξ) ≤ 1 := by
      rw [← Real.sqrt_one]; exact Real.sqrt_le_sqrt hhi
    have hqsq : qC h ξ ≤ Real.sqrt (qC h ξ) := by
      have e := Real.mul_self_sqrt hq.le
      have := mul_le_mul_of_nonneg_left hsq1 hsq0.le
      nlinarith
    have hqe0 : 0 < qC h ξ ^ (1/2 - h) := Real.rpow_pos_of_pos hq _
    have hqqe : qC h ξ ≤ qC h ξ ^ (1/2 - h) := by
      have := Real.rpow_le_rpow_of_exponent_ge hq hhi (show 1/2 - h ≤ 1 by linarith)
      rwa [Real.rpow_one] at this
    have hi1 : (Real.sqrt (qC h ξ))⁻¹ ≤ K := le_trans (inv_anti₀ hq hqsq) hqK
    have hi2 : (qC h ξ ^ (1/2 - h))⁻¹ ≤ K := le_trans (inv_anti₀ hq hqqe) hqK
    have hslot : ∀ (m : ℤ), 0 ≤ m → Tgc ^ m ≤ qC h ξ ^ (-(2:ℝ)) → ∀ Y : ℝ × ℝ,
        ‖JpowL m Y‖ ≤ K * ‖Y‖ := by
      intro m hm hTm Y
      have hY1 : |Y.1| ≤ ‖Y‖ := by rw [← Real.norm_eq_abs]; exact norm_fst_le Y
      have hY2 : |Y.2| ≤ ‖Y‖ := by rw [← Real.norm_eq_abs]; exact norm_snd_le Y
      have hr : 0 ≤ ‖Y‖ := norm_nonneg _
      have hdiv : ∀ x : ℝ, |x / (1 + bgc ^ 2)| ≤ |x| := by
        intro x
        rw [abs_div, abs_of_pos hcpos]
        exact div_le_self (abs_nonneg _) hc1
      have hbY2 : |bgc * Y.2| ≤ ‖Y‖ := by
        rw [abs_mul, abs_of_nonneg hb0]
        calc bgc * |Y.2| ≤ 1 * ‖Y‖ := mul_le_mul hb1 hY2 (abs_nonneg _) zero_le_one
          _ = ‖Y‖ := one_mul _
      have hbY1 : |bgc * Y.1| ≤ ‖Y‖ := by
        rw [abs_mul, abs_of_nonneg hb0]
        calc bgc * |Y.1| ≤ 1 * ‖Y‖ := mul_le_mul hb1 hY1 (abs_nonneg _) zero_le_one
          _ = ‖Y‖ := one_mul _
      obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = (Y.1 - bgc * Y.2) / (1 + bgc ^ 2) := ⟨_, rfl⟩
      obtain ⟨b, hb_def⟩ : ∃ b : ℝ, b = (bgc * Y.1 + Y.2) / (1 + bgc ^ 2) := ⟨_, rfl⟩
      have ha : |a| ≤ 2 * ‖Y‖ := by
        rw [ha_def]
        refine le_trans (hdiv _) ?_
        linarith [abs_sub (Y.1) (bgc * Y.2)]
      have hb : |b| ≤ 2 * ‖Y‖ := by
        rw [hb_def]
        refine le_trans (hdiv _) ?_
        linarith [abs_add_le (bgc * Y.1) (Y.2)]
