        exact huK ⟨not_lt.mp hcon, hu1⟩
      rw [lt_div_iff₀ (by linarith)] at hu'
      have hy0 : 0 < y.1 := by linarith [hy1.1]
      have hy1' : y.1 < 2 * p₁ := hy1.2
      have hlt : y.1 * u < ε := by nlinarith
      have h0 : g (y.1 * u, y.2.1, y.2.2.1, y.2.2.2 + ((y.1 * u) ^ drx B.h) • vrv) = 0 :=
        hU0 (y.2.1, y.2.2.1) hy2 (y.1 * u) (y.2.2.2 + ((y.1 * u) ^ drx B.h) • vrv)
          (mul_pos hy0 hu0) (Or.inl hlt)
      rw [h0, mul_zero]
  have E5 := engine (volume : Measure ℝ)
    (Ioi (0:ℝ) ×ˢ {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs})
    (Ioi (0:ℝ)) (Ioc (0:ℝ) 1)
    (fun (y : ℝ × (ℝ × ℝ × (ℝ × ℝ))) (u : ℝ) =>
      y.1 * g (y.1 * u, y.2.1, y.2.2.1, y.2.2.2 + ((y.1 * u) ^ drx B.h) • vrv))
    hΩ5o isOpen_Ioi measurableSet_Ioc Ioc_subset_Ioi_self hF5 hloc5
  refine ⟨E1.1, ?_, ?_, ?_, ?_⟩
  ·
    intro k ζ hζ1 hζ2 v
    refine ((E1.2.2 k ζ ⟨hζ1, hζ2⟩ v).2).trans ?_
    refine setIntegral_congr_fun measurableSet_Ioi (fun r hr => ?_)
    have hr0 : (0:ℝ) < r := hr
    have hcL : ∀ y : ℝ × ℝ × (ℝ × ℝ), ((r, 0, 0, (r ^ drx B.h) • vrv) : Cyl) + Li y =
        (r, y.1, y.2.1, y.2.2 + (r ^ drx B.h) • vrv) := by
      intro y
      rw [hLi, Prod.mk_add_mk, Prod.mk_add_mk, Prod.mk_add_mk, add_zero, zero_add, zero_add,
        add_comm ((r ^ drx B.h) • vrv)]
    have hA := affine g (DomC B.h qs) Li ((r, 0, 0, (r ^ drx B.h) • vrv) : Cyl) ζ k hDopen hgs
      (by rw [hcL]; exact ⟨hr0, hζ1, hζ2⟩)
    simp only [hcL] at hA
    show iteratedFDeriv ℝ k (fun x' : ℝ × ℝ × (ℝ × ℝ) =>
        g (r, x'.1, x'.2.1, x'.2.2 + (r ^ drx B.h) • vrv)) ζ v =
      iteratedFDeriv ℝ k g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv)
        (fun i => ((0:ℝ), (v i).1, (v i).2.1, (v i).2.2))
    rw [hA, ContinuousMultilinearMap.compContinuousLinearMap_apply]
    simp only [hLi]
  ·
    exact E2.1.congr (fun w hw => hM w hw)
  ·
    intro k w hw1 hw2 v
    have hw : w ∈ {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} := ⟨hw1, hw2⟩
    have hev : (fun w' : ℝ × ℝ => ∫ r in Set.Ioi (0:ℝ), ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
        g (r, w'.1, w'.2, Y)) =ᶠ[nhds w]
        (fun w' : ℝ × ℝ => ∫ a in Ioi (0:ℝ) ×ˢ (Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1), g (a.1, w'.1, w'.2, a.2)) :=
      Filter.eventuallyEq_of_mem (hΩ2o.mem_nhds hw) (fun w' hw' => hM w' hw')
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    obtain ⟨hI, hEq⟩ := E2.2.2 k w hw v
    refine hEq.trans ?_
    have hpt : ∀ a ∈ Ioi (0:ℝ) ×ˢ (Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1),
        iteratedFDeriv ℝ k (fun x' : ℝ × ℝ => g (a.1, x'.1, x'.2, a.2)) w v =
          iteratedFDeriv ℝ k g (a.1, w.1, w.2, a.2) (fun i => ((0:ℝ), (v i).1, (v i).2, (0 : ℝ × ℝ))) := by
      intro a ha
      have hcL : ∀ y : ℝ × ℝ, ((a.1, 0, 0, a.2) : Cyl) + Lw y = (a.1, y.1, y.2, a.2) := by
        intro y; rw [hLw]; simp
      have hA := affine g (DomC B.h qs) Lw ((a.1, 0, 0, a.2) : Cyl) w k hDopen hgs
        (by rw [hcL]; exact ⟨ha.1, hw1, hw2⟩)
      simp only [hcL] at hA
      rw [hA, ContinuousMultilinearMap.compContinuousLinearMap_apply]
      simp only [hLw]
    refine (setIntegral_congr_fun hSm hpt).trans ?_
    have h := setIntegral_prod _ (hI.congr_fun hpt hSm)
    exact h
  ·
    intro ζ p hζ1 hζ2 hp
    have hζ : ζ ∈ {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} := ⟨hζ1, hζ2⟩
    have hmem : ((p, ζ) : ℝ × (ℝ × ℝ × (ℝ × ℝ))) ∈ Ioi (0:ℝ) ×ˢ
        {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} := ⟨hp, hζ⟩
    refine ⟨?_, ?_⟩
    · have hd := (E5.1.contDiffAt (hΩ5o.mem_nhds hmem)).differentiableAt (by simp)
      refine hd.congr_of_eventuallyEq ?_
      filter_upwards [hΩ5o.mem_nhds hmem] with y hy
      exact hresc y.1 (fun r => g (r, y.2.1, y.2.2.1, y.2.2.2 + (r ^ drx B.h) • vrv)) hy.1
    · have hcontf : ContinuousOn (fun r : ℝ => g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv))
          (Ioi (0:ℝ)) := by
        have h := hF3.continuousOn.comp
          (Continuous.continuousOn (by fun_prop :
            Continuous (fun r : ℝ => ((ζ, r) : (ℝ × ℝ × (ℝ × ℝ)) × ℝ))))
          (fun r hr => ⟨hζ, hr⟩)
        exact h
      have hint : IntervalIntegrable (fun r : ℝ => g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv))
          volume 0 p :=
        (intervalIntegrable_iff_integrableOn_Ioc_of_le hp.le).2
          ((E1.2.1 ζ hζ).mono_set Ioc_subset_Ioi_self)
      exact intervalIntegral.integral_hasDerivAt_right hint
        (hcontf.stronglyMeasurableAtFilter isOpen_Ioi p hp) (hcontf.continuousAt (Ioi_mem_nhds hp))

theorem rhoP_regular_v5 : ∀ (B : BG) (qs : ℝ), B.ok → ContDiffOn ℝ ∞ (rhoP B) (DomC B.h qs) ∧ ∀ ξ ∈ DomC B.h qs, (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → rhoP B ξ = 0 :=
by
  intro B qs hok
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hXm : B.Xa < B.m1 := hok.2.1.2.2.2.1
  have hm12 : B.m1 < B.m2 := hok.2.1.2.2.2.2.1
  have hm2b : B.m2 < B.Xb := hok.2.1.2.2.2.2.2.1
  have hpos : ∀ η ∈ DomC B.h qs, 0 < qC B.h η := by
    intro η hη
    have h2 : η.2.2.1 < 1 := hη.2.1
    exact (hok.1.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hne : ∀ η ∈ DomC B.h qs, qC B.h η ≠ 0 := fun η hη => (hpos η hη).ne'
  have hqs : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h qs) := by
    have hφ : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ))
        (DomC B.h qs) (univ ×ˢ Ioi 0) := by
      intro η hη
      have h2 : η.2.2.1 < 1 := hη.2.1
      exact ⟨mem_univ _, show (0:ℝ) < 1 - η.2.2.1 by linarith⟩
    have hS : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1
    exact hS.comp hφ.contDiffOn hmaps
  have h1 : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-(1/2:ℝ))) (DomC B.h qs) :=
    hqs.rpow_const_of_ne hne
  have hsq : ContDiffOn ℝ ∞ (fun η => Real.sqrt (qC B.h η)) (DomC B.h qs) := hqs.sqrt hne
  have h2 : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 / Real.sqrt (qC B.h η)) (DomC B.h qs) :=
    contDiffOn_fst.div hsq (fun η hη => (Real.sqrt_pos.mpr (hpos η hη)).ne')
  have h3 : ContDiff ℝ ∞ (rhoHat B) := by
    unfold rhoHat bumpR
    apply ContDiff.div_const
    exact Real.smoothTransition.contDiff.comp (by fun_prop)
  refine ⟨?_, ?_⟩
  · exact h1.mul (h3.comp_contDiffOn h2)
  · intro ξ hξ hX
    have hq := hpos ξ hξ
    have hξ1 : 0 < ξ.1 := hξ.1
    have hσ : 0 < Real.sqrt (qC B.h ξ) := Real.sqrt_pos.mpr hq
    have hs0 : 0 < ξ.1 / Real.sqrt (qC B.h ξ) := div_pos hξ1 hσ
    have hsq2 : (ξ.1 / Real.sqrt (qC B.h ξ)) ^ 2 = 2 * XC B.h ξ := by
      rw [div_pow, Real.sq_sqrt hq.le]
      unfold XC
      field_simp
    have hab : Real.sqrt (2 * B.m1) < Real.sqrt (2 * B.m2) :=
      Real.sqrt_lt_sqrt (by linarith) (by linarith)
    have hcase : ξ.1 / Real.sqrt (qC B.h ξ) ≤ Real.sqrt (2 * B.m1) ∨
        Real.sqrt (2 * B.m2) < ξ.1 / Real.sqrt (qC B.h ξ) := by
      rcases hX with hX | hX
      · left
        apply le_of_lt
        rw [Real.lt_sqrt hs0.le, hsq2]
        linarith
      · right
        rw [Real.sqrt_lt' hs0, hsq2]
        linarith
    have hvan : ∀ s : ℝ, (s ≤ Real.sqrt (2 * B.m1) ∨ Real.sqrt (2 * B.m2) < s) → rhoHat B s = 0 := by
      intro s hs
      have hw : 0 < (Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2 := by linarith
      have hu : 1 ≤ ((s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
          ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) ^ 2 := by
        rcases hs with hs | hs
        · have h1 : (s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
              ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2) ≤ -1 := by
            rw [div_le_iff₀ hw]; linarith
          nlinarith
        · have h1 : 1 < (s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
              ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2) := by
            rw [lt_div_iff₀ hw]; linarith
          nlinarith
      have hnum : bumpR ((s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
          ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) = 0 :=
        Real.smoothTransition.zero_of_nonpos (by linarith)
      unfold rhoHat
      rw [hnum, zero_div]
    show qC B.h ξ ^ (-(1/2:ℝ)) * rhoHat B (ξ.1 / Real.sqrt (qC B.h ξ)) = 0
    rw [hvan _ hcase, mul_zero]

theorem pws_icut_diff : ∀ (B : BG) (qs : ℝ) (g : Cyl → ℝ), B.ok → 0 < qs → qs ≤ 1 → ContDiffOn ℝ ∞ g (DomC B.h qs) → (∀ ξ ∈ DomC B.h qs, (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → g ξ = 0) → ∀ ξ ∈ DomC B.h qs, DifferentiableAt ℝ (Icut B (fun η => g η - rhoP B η * radMom g 0 η.2.1 η.2.2.1)) ξ :=
by
  intro B qs g hok hqs0 hqs1 hg hsh ξ hξ
  obtain ⟨hD, hqC, hqpos, -, -, -⟩ := domc_open_calculus B qs hok
  obtain ⟨hrho, hrho0⟩ := rhoP_regular_v5 B qs hok
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ

  have hg' : ∀ η ∈ DomC B.h qs, (XC B.h η ≤ B.Xa ∨ B.Xb ≤ XC B.h η) → g η = 0 := by
    intro η hη hsh'
    have hη' : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < qs := hη
    have hφD : ∀ s : ℝ, 0 < s → ((s * η.1, η.2) : Cyl) ∈ DomC B.h qs := fun s hs =>
      ⟨mul_pos hs hη'.1, hη'.2.1, hη'.2.2⟩
    have hXCφ : ∀ s : ℝ, XC B.h ((s * η.1, η.2) : Cyl) = s ^ 2 * XC B.h η := by
      intro s
      show (s * η.1) ^ 2 / (2 * qC B.h η) = s ^ 2 * (η.1 ^ 2 / (2 * qC B.h η))
      ring
    have hXCpos : 0 < XC B.h η :=
      div_pos (pow_pos hη'.1 2) (mul_pos two_pos (hqpos η hη))
    have hgc : ContinuousAt g η := (hg.contDiffAt (hD.mem_nhds hη)).continuousAt
    have hφc : Continuous (fun s : ℝ => ((s * η.1, η.2) : Cyl)) :=
      (continuous_id.mul continuous_const).prodMk continuous_const
    have h1 : (((1:ℝ) * η.1, η.2) : Cyl) = η := Prod.ext (one_mul _) rfl
    have hT : Filter.Tendsto (fun s : ℝ => g (s * η.1, η.2)) (nhds 1) (nhds (g η)) :=
      hgc.tendsto.comp (hφc.tendsto' 1 η h1)
    rcases hsh' with hle | hge
    · have hev : (fun s : ℝ => g (s * η.1, η.2)) =ᶠ[nhdsWithin 1 (Set.Iio 1)] fun _ => (0:ℝ) := by
        filter_upwards [Ioo_mem_nhdsLT (zero_lt_one : (0:ℝ) < 1)] with s hs
        apply hsh _ (hφD s hs.1)
        left
        rw [hXCφ]
        have hs2 : s ^ 2 < 1 := by nlinarith [hs.1, hs.2]
        have := mul_lt_mul_of_pos_right hs2 hXCpos
        linarith
      have hT0 : Filter.Tendsto (fun s : ℝ => g (s * η.1, η.2)) (nhdsWithin 1 (Set.Iio 1)) (nhds 0) :=
        tendsto_const_nhds.congr' hev.symm
      exact tendsto_nhds_unique (hT.mono_left nhdsWithin_le_nhds) hT0
    · have hev : (fun s : ℝ => g (s * η.1, η.2)) =ᶠ[nhdsWithin 1 (Set.Ioi 1)] fun _ => (0:ℝ) := by
        filter_upwards [Ioo_mem_nhdsGT (one_lt_two : (1:ℝ) < 2)] with s hs
        apply hsh _ (hφD s (by linarith [hs.1]))
        right
        rw [hXCφ]
        have hs2 : 1 < s ^ 2 := by nlinarith [hs.1, hs.2]
        have := mul_lt_mul_of_pos_right hs2 hXCpos
        linarith
      have hT0 : Filter.Tendsto (fun s : ℝ => g (s * η.1, η.2)) (nhdsWithin 1 (Set.Ioi 1)) (nhds 0) :=
        tendsto_const_nhds.congr' hev.symm
      exact tendsto_nhds_unique (hT.mono_left nhdsWithin_le_nhds) hT0

  have P0 := path_integral_smooth_v5 B qs g hok hqs0 hqs1 hg hg'
  have hrad : ∀ z t : ℝ, radMom g 0 z t =
      ∫ r in Set.Ioi (0:ℝ), ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (r, z, t, Y) := by
    intro z t
    simp only [radMom, yAvg, pow_zero, one_mul]
  have hRM : ContDiffOn ℝ ∞ (fun η : Cyl => radMom g 0 η.2.1 η.2.2.1) (DomC B.h qs) := by
    have e : (fun η : Cyl => radMom g 0 η.2.1 η.2.2.1) =
        (fun w : ℝ × ℝ => ∫ r in Set.Ioi (0:ℝ), ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (r, w.1, w.2, Y))
          ∘ (fun η : Cyl => (η.2.1, η.2.2.1)) := by
      funext η
      simp only [Function.comp, hrad]
    rw [e]
    refine P0.2.2.1.comp (contDiff_snd.fst.prodMk contDiff_snd.snd.fst).contDiffOn ?_
    intro η hη
    have hη' : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < qs := hη
    exact ⟨hη'.2.1, hη'.2.2⟩
  have hGs : ContDiffOn ℝ ∞ (fun η => g η - rhoP B η * radMom g 0 η.2.1 η.2.2.1) (DomC B.h qs) :=
    hg.sub (hrho.mul hRM)
  have hG0 : ∀ η ∈ DomC B.h qs, (XC B.h η ≤ B.Xa ∨ B.Xb ≤ XC B.h η) →
      (fun η => g η - rhoP B η * radMom g 0 η.2.1 η.2.2.1) η = 0 := by
    intro η hη hs
    show g η - rhoP B η * radMom g 0 η.2.1 η.2.2.1 = 0
    rw [hg' η hη hs, hrho0 η hη hs]
    ring
  generalize (fun η => g η - rhoP B η * radMom g 0 η.2.1 η.2.2.1) = G at hGs hG0 ⊢
  have P := path_integral_smooth_v5 B qs G hok hqs0 hqs1 hGs hG0

  have hIcut : Icut B G = fun η : Cyl =>
      (fun pζ : ℝ × (ℝ × ℝ × (ℝ × ℝ)) =>
          ∫ r in (0:ℝ)..pζ.1, G (r, pζ.2.1, pζ.2.2.1, pζ.2.2.2 + (r ^ drx B.h) • vrv))
        (η.1, (η.2.1, η.2.2.1, η.2.2.2 - (η.1 ^ drx B.h) • vrv))
      - chiM B (XC B.h η) *
        (fun ζ' : ℝ × ℝ × (ℝ × ℝ) =>
            ∫ r in Set.Ioi (0:ℝ), G (r, ζ'.1, ζ'.2.1, ζ'.2.2 + (r ^ drx B.h) • vrv))
          (η.2.1, η.2.2.1, η.2.2.2 - (η.1 ^ drx B.h) • vrv) := by
    funext η
    have hp : ∀ r' : ℝ, pathPt B.h η r' =
        (r', η.2.1, η.2.2.1, (η.2.2.2 - (η.1 ^ drx B.h) • vrv) + (r' ^ drx B.h) • vrv) := by
      intro r'
      refine Prod.ext rfl (Prod.ext rfl (Prod.ext rfl ?_))
      show η.2.2.2 + (r' ^ drx B.h - η.1 ^ drx B.h) • vrv =
        (η.2.2.2 - (η.1 ^ drx B.h) • vrv) + (r' ^ drx B.h) • vrv
      rw [sub_smul]
      abel
    simp only [Icut, hp]

  have hζd : DifferentiableAt ℝ (fun η : Cyl => (η.2.1, η.2.2.1, η.2.2.2 - (η.1 ^ drx B.h) • vrv)) ξ := by
    have hpow : DifferentiableAt ℝ (fun η : Cyl => η.1 ^ drx B.h) ξ :=
      differentiableAt_fst.rpow_const (Or.inl hξ'.1.ne')
    exact differentiableAt_snd.fst.prodMk
      (differentiableAt_snd.snd.fst.prodMk (differentiableAt_snd.snd.snd.sub (hpow.smul_const vrv)))
  have hXC : DifferentiableAt ℝ (XC B.h) ξ := by
    have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ 2 / (2 * qC B.h η)) (DomC B.h qs) :=
      (contDiffOn_fst.pow 2).div (contDiffOn_const.mul hqC)
        (fun η hη => (mul_pos two_pos (hqpos η hη)).ne')
    exact (h1.contDiffAt (hD.mem_nhds hξ)).differentiableAt (by norm_num)
  have hchi : Differentiable ℝ (chiM B) := by
    have h1 : Differentiable ℝ Real.smoothTransition :=
      (Real.smoothTransition.contDiff (n := 1)).differentiable (by norm_num)
    intro X
    exact (h1 _).comp X ((differentiableAt_id.sub_const _).div_const _)

  have hF1 := (P.2.2.2.2 (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) ξ.1 hξ'.2.1 hξ'.2.2 hξ'.1).1
  have hWo : IsOpen {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} := by
    have e : {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} =
        (fun ζ : ℝ × ℝ × (ℝ × ℝ) => (((1:ℝ), ζ) : Cyl)) ⁻¹' DomC B.h qs := by
      ext ζ
      exact ⟨fun h => ⟨zero_lt_one, h.1, h.2⟩, fun h => ⟨h.2.1, h.2.2⟩⟩
    rw [e]
    exact hD.preimage (continuous_const.prodMk continuous_id)
  have hζW : (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) ∈
      {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} := ⟨hξ'.2.1, hξ'.2.2⟩
  have hF2 := (P.1.contDiffAt (hWo.mem_nhds hζW)).differentiableAt (by norm_num)

  rw [hIcut]
  exact (hF1.comp ξ (differentiableAt_fst.prodMk hζd)).sub
    (((hchi _).comp ξ hXC).mul (hF2.comp ξ hζd))

theorem pws_pointwise_split : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ), B.ok → qsOf l0 ≤ B.qB → (∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (↿(evOff B.h (pwrA5 B G l0) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2}) → (∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (↿(evOff B.h (pwrW5 B G l0) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2}) → (∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (↿(evOff B.h (pwrP5 B G l0) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2}) → (∀ ξ ∈ DomC B.h (qsOf l0), DifferentiableAt ℝ (pmP5 B G l0 (primState5 B G)) ξ) → ∀ x t Y, corrOn B l0 x t → resX B.h (uX5 B G l0 (primState5 B G)) (PX5 B G l0 (primState5 B G)) x t Y = pwrE B x t Y + stressDivField B.h B.Tth B.Tz x t + pwrLin B G l0 x t Y + pwrQ B G l0 x t Y + gradient (fun y => PX5 B G l0 (primState5 B G) y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t)) - B.PB y t - pwrP5 B G l0 y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t))) x :=
by
  classical
  intro B G l0 hok hqB hA hW hP hpm x t Y hxt

  have hBP := hok.2
  unfold BackgroundProps at hBP
  obtain ⟨-, -, -, ⟨hAB, hBvB, hPB⟩, -⟩ := hBP
  have hS : SimScaleProps B.h := hok.1
  have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => w.1 i) := fun i =>
    (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).contDiff.comp contDiff_fst
  have hψ : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
    (hc 2).prodMk (contDiff_const.sub contDiff_snd)
  have hqH : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} :=
    hS.2.2.2.1.comp hψ.contDiffOn (fun w hw =>
      ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by linarith [show w.2 < 1 from hw]⟩)
  have hHo : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  have hDo : IsOpen (simDomain B.h B.qB) := by
    have e : simDomain B.h B.qB = {w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio B.qB := Set.ext fun _ => Iff.rfl
    rw [e]
    exact hqH.continuousOn.isOpen_inter_preimage hHo isOpen_Iio
  have hradc : Continuous (fun w : ℝ³ × ℝ => rad w.1) := by
    unfold rad
    fun_prop
  have hCO : IsOpen {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} := by
    have h1 : IsOpen {w : ℝ³ × ℝ | 0 < rad w.1} := isOpen_lt continuous_const hradc
    have h2 : IsOpen ({w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0)) :=
      hqH.continuousOn.isOpen_inter_preimage hHo isOpen_Iio
    have e : {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} = {w : ℝ³ × ℝ | 0 < rad w.1} ∩
        ({w : ℝ³ × ℝ | w.2 < 1} ∩
          (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0)) := by
      ext w; rfl
    rw [e]; exact h1.inter h2
  have hsub : ∀ z : ℝ³ × ℝ, corrOn B l0 z.1 z.2 → z ∈ simDomain B.h B.qB :=
    fun z hz => ⟨hz.2.1, lt_of_lt_of_le hz.2.2 hqB⟩
  have hxD : ((x, t) : ℝ³ × ℝ) ∈ simDomain B.h B.qB := hsub (x, t) hxt
  have hxC : ((x, t) : ℝ³ × ℝ) ∈ {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} := hxt

  have hsl : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ → ℝ → F)
      (O : Set (ℝ³ × ℝ)) (y : ℝ³) (s : ℝ), IsOpen O → ContDiffOn ℝ ∞ (↿f) O → (y, s) ∈ O →
      DifferentiableAt ℝ (fun w => f w s) y := by
    intro F _ _ f O y s hO hf hys
    exact ((hf.contDiffAt (hO.mem_nhds hys)).comp y
      ((contDiff_id.prodMk contDiff_const).contDiffAt)).differentiableAt (by simp)

  have huB : ContDiffOn ℝ ∞ (↿(uB B)) (simDomain B.h B.qB) := by
    let ev : Fin 3 → Fin 3 → ((ℝ³ × ℝ) →L[ℝ] ℝ³) →L[ℝ] ℝ := fun a b =>
      (EuclideanSpace.proj b).comp
        (ContinuousLinearMap.apply ℝ ℝ³ ((EuclideanSpace.single a (1:ℝ) : ℝ³), (0:ℝ)))
    let L : ((ℝ³ × ℝ) →L[ℝ] ℝ³) →L[ℝ] ℝ³ :=
      (ev 1 2 - ev 2 1).smulRight (EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) +
      (ev 2 0 - ev 0 2).smulRight (EuclideanSpace.single (1 : Fin 3) (1 : ℝ)) +
      (ev 0 1 - ev 1 0).smulRight (EuclideanSpace.single (2 : Fin 3) (1 : ℝ))
    have hLapp : ∀ Φ : (ℝ³ × ℝ) →L[ℝ] ℝ³, L Φ =
        (Φ (EuclideanSpace.single 1 1, 0) 2 - Φ (EuclideanSpace.single 2 1, 0) 1) •
            EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
          (Φ (EuclideanSpace.single 2 1, 0) 0 - Φ (EuclideanSpace.single 0 1, 0) 2) •
            EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
          (Φ (EuclideanSpace.single 0 1, 0) 1 - Φ (EuclideanSpace.single 1 1, 0) 0) •
            EuclideanSpace.single (2 : Fin 3) (1 : ℝ) := by
      intro Φ
      rfl
    have hslice : ∀ z ∈ simDomain B.h B.qB, ∀ v : ℝ³,
        fderiv ℝ (fun w => B.AB w z.2) z.1 v = fderiv ℝ (↿B.AB) z (v, 0) := by
      intro z hz v
      have hd : DifferentiableAt ℝ (↿B.AB) z :=
        (hAB.contDiffAt (hDo.mem_nhds hz)).differentiableAt (by simp)
      have hd' : DifferentiableAt ℝ (↿B.AB) (z.1, z.2) := hd
      have he : (fun w => B.AB w z.2) = (↿B.AB) ∘ (fun w : ℝ³ => (w, z.2)) := rfl
      rw [he, fderiv_comp z.1 hd' (hasFDerivAt_prodMk_left z.1 z.2).differentiableAt,
        (hasFDerivAt_prodMk_left z.1 z.2).fderiv]
      rfl
    have hE : ∀ z ∈ simDomain B.h B.qB, (↿(uB B)) z = L (fderiv ℝ (↿B.AB) z) + (↿B.BvB) z := by
      intro z hz
      show curl3 (fun w => B.AB w z.2) z.1 + B.BvB z.1 z.2 = L (fderiv ℝ (↿B.AB) z) + B.BvB z.1 z.2
      rw [hLapp]
      simp only [curl3, hslice z hz]
    have hfd : ContDiffOn ℝ ∞ (fderiv ℝ (↿B.AB)) (simDomain B.h B.qB) :=
      hAB.fderiv_of_isOpen hDo (by simp)
    exact ((hfd.continuousLinearMap_comp L).add hBvB).congr hE

  have hcurl_add : ∀ (F₁ F₂ : ℝ³ → ℝ³) (y : ℝ³), DifferentiableAt ℝ F₁ y →
      DifferentiableAt ℝ F₂ y → curl3 (fun w => F₁ w + F₂ w) y = curl3 F₁ y + curl3 F₂ y := by
    intro F₁ F₂ y h1 h2
    unfold curl3
    rw [fderiv_fun_add h1 h2]
    simp only [ContinuousLinearMap.add_apply, PiLp.add_apply, add_sub_add_comm, add_smul]
    abel

  have hAX : ∀ w s Z, AX5 B G l0 (primState5 B G) w s Z = B.AB w s + pwrA5 B G l0 w s Z := by
    intro w s Z
    by_cases hcw : corrOn B l0 w s
    · simp only [AX5, pwrA5, if_pos hcw]
      rw [show (primState5 B G).Psi = fun _ => 0 from rfl]
      simp only [zero_smul, add_zero]
    · simp only [AX5, pwrA5, if_neg hcw]
  have hBX : ∀ w s Z, BX B G l0 (primState5 B G) w s Z = B.BvB w s := by
    intro w s Z
    by_cases hcw : corrOn B l0 w s
    · simp only [BX, if_pos hcw]
      rw [show (primState5 B G).bdir = fun _ => 0 from rfl]
      simp only [mul_zero, zero_smul, add_zero]
    · simp only [BX, if_neg hcw, add_zero]

  have hlocal : ∀ (u₁ u₂ : ℝ³ → ℝ → ℝ³) (p₁ p₂ : ℝ³ → ℝ → ℝ) (O : Set (ℝ³ × ℝ)), IsOpen O →
      (∀ z ∈ O, (↿u₁) z = (↿u₂) z) → (∀ z ∈ O, (↿p₁) z = (↿p₂) z) → ((x, t) : ℝ³ × ℝ) ∈ O →
      nsResidual 1 u₁ p₁ x t = nsResidual 1 u₂ p₂ x t := by
    intro u₁ u₂ p₁ p₂ O hO hu hp hz
    have hNt : {s : ℝ | ((x, s) : ℝ³ × ℝ) ∈ O} ∈ nhds t :=
      (hO.preimage (continuous_const.prodMk continuous_id)).mem_nhds hz
    have hNx : {y : ℝ³ | ((y, t) : ℝ³ × ℝ) ∈ O} ∈ nhds x :=
      (hO.preimage (continuous_id.prodMk continuous_const)).mem_nhds hz
    have E1 : (fun s => u₁ x s) =ᶠ[nhds t] (fun s => u₂ x s) :=
      Filter.eventuallyEq_of_mem hNt (fun s hs => hu (x, s) hs)
    have E2 : (fun y => u₁ y t) =ᶠ[nhds x] (fun y => u₂ y t) :=
      Filter.eventuallyEq_of_mem hNx (fun y hy => hu (y, t) hy)
    have E3 : (fun y => p₁ y t) =ᶠ[nhds x] (fun y => p₂ y t) :=
      Filter.eventuallyEq_of_mem hNx (fun y hy => hp (y, t) hy)
    have E0 : u₁ x t = u₂ x t := hu (x, t) hz
    have h4 : deriv (fun s => u₁ x s) t = deriv (fun s => u₂ x s) t := E1.deriv_eq
    have h5 : fderiv ℝ (fun y => u₁ y t) x = fderiv ℝ (fun y => u₂ y t) x := E2.fderiv_eq
    have h6 : Δ (fun y => u₁ y t) x = Δ (fun y => u₂ y t) x :=
      (InnerProductSpace.laplacian_congr_nhds E2).eq_of_nhds
    have h7 : gradient (fun y => p₁ y t) x = gradient (fun y => p₂ y t) x := E3.gradient_eq
    unfold nsResidual
    rw [h4, h5, h6, h7, E0]

  have hexp : ∀ (u w : ℝ³ → ℝ → ℝ³) (p π₁ π₂ : ℝ³ → ℝ → ℝ), ContDiffAt ℝ 2 (↿u) (x, t) →
      ContDiffAt ℝ 2 (↿w) (x, t) → DifferentiableAt ℝ (fun y => p y t) x →
      DifferentiableAt ℝ (fun y => π₁ y t) x → DifferentiableAt ℝ (fun y => π₂ y t) x →
      nsResidual 1 (fun y s => u y s + w y s) (fun y s => p y s + π₁ y s + π₂ y s) x t =
        nsResidual 1 u p x t + nsResidual 1 w π₁ x t + gradient (fun y => π₂ y t) x +
          fderiv ℝ (fun y => w y t) x (u x t) + fderiv ℝ (fun y => u y t) x (w x t) := by
    intro u w p π₁ π₂ hu hw hp h1 h2
    have hus : ContDiffAt ℝ 2 (fun y => u y t) x :=
      hu.comp x ((contDiff_id.prodMk contDiff_const).contDiffAt)
    have hws : ContDiffAt ℝ 2 (fun y => w y t) x :=
      hw.comp x ((contDiff_id.prodMk contDiff_const).contDiffAt)
    have hut : DifferentiableAt ℝ (fun s => u x s) t :=
      (hu.comp t ((contDiff_const.prodMk contDiff_id).contDiffAt)).differentiableAt (by simp)
    have hwt : DifferentiableAt ℝ (fun s => w x s) t :=
      (hw.comp t ((contDiff_const.prodMk contDiff_id).contDiffAt)).differentiableAt (by simp)
    have hud : DifferentiableAt ℝ (fun y => u y t) x := hus.differentiableAt (by simp)
    have hwd : DifferentiableAt ℝ (fun y => w y t) x := hws.differentiableAt (by simp)
    have hL : Δ (fun y => u y t + w y t) x = Δ (fun y => u y t) x + Δ (fun y => w y t) x :=
      hus.laplacian_add hws
    have hG : gradient (fun y => p y t + π₁ y t + π₂ y t) x =
        gradient (fun y => p y t) x + gradient (fun y => π₁ y t) x + gradient (fun y => π₂ y t) x := by
      simp only [gradient, fderiv_fun_add (hp.fun_add h1) h2, fderiv_fun_add hp h1, map_add]
    simp only [nsResidual]
    rw [deriv_fun_add hut hwt, fderiv_fun_add hud hwd, hL, hG]
    simp only [ContinuousLinearMap.add_apply, map_add, smul_add]
    abel

  show nsResidual 1 (evOff B.h (uX5 B G l0 (primState5 B G)) (Y - Yph B.h (rad x) t))
      (evOff B.h (PX5 B G l0 (primState5 B G)) (Y - Yph B.h (rad x) t)) x t =
    (nsResidual 1 (uB B) B.PB x t - stressDivField B.h B.Tth B.Tz x t) + stressDivField B.h B.Tth B.Tz x t +
    (nsResidual 1 (evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t))
        (evOff B.h (pwrP5 B G l0) (Y - Yph B.h (rad x) t)) x t
      - fderiv ℝ (fun y => evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) y t) x
          (evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) x t)
      + fderiv ℝ (fun y => evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) y t) x (uB B x t)
      + fderiv ℝ (fun y => uB B y t) x (evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) x t)) +
    fderiv ℝ (fun y => evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) y t) x
      (evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) x t) +
    gradient (fun y => PX5 B G l0 (primState5 B G) y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t))
      - B.PB y t - pwrP5 B G l0 y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t))) x
  obtain ⟨Y', hY'⟩ : ∃ Y' : ℝ × ℝ, Y - Yph B.h (rad x) t = Y' := ⟨_, rfl⟩
  rw [hY']

  have hU : ∀ z ∈ {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2},
      (↿(evOff B.h (uX5 B G l0 (primState5 B G)) Y')) z =
        (↿(fun y s => uB B y s + evOff B.h (pwrW5 B G l0) Y' y s)) z := by
    rintro ⟨y, s⟩ hz
    have hd1 : DifferentiableAt ℝ (fun w => B.AB w s) y := hsl B.AB _ y s hDo hAB (hsub (y, s) hz)
    have hd2 : DifferentiableAt ℝ (fun w => evOff B.h (pwrA5 B G l0) Y' w s) y :=
      hsl _ _ y s hCO (hA Y') hz
    have e1 : evOff B.h (uX5 B G l0 (primState5 B G)) Y' y s =
        curl3 (fun w => AX5 B G l0 (primState5 B G) w s (Yph B.h (rad w) s + Y')) y +
          BX B G l0 (primState5 B G) y s (Yph B.h (rad y) s + Y') := by
      show curl3 (fun w => AX5 B G l0 (primState5 B G) w s
          (Yph B.h (rad w) s + (Yph B.h (rad y) s + Y' - Yph B.h (rad y) s))) y +
          BX B G l0 (primState5 B G) y s (Yph B.h (rad y) s + Y') = _
      rw [add_sub_cancel_left]
    have e2 : evOff B.h (pwrW5 B G l0) Y' y s =
        curl3 (fun w => evOff B.h (pwrA5 B G l0) Y' w s) y := by
      show curl3 (fun w => pwrA5 B G l0 w s
          (Yph B.h (rad w) s + (Yph B.h (rad y) s + Y' - Yph B.h (rad y) s))) y = _
      rw [add_sub_cancel_left]
      rfl
    have hfA : (fun w => AX5 B G l0 (primState5 B G) w s (Yph B.h (rad w) s + Y')) =
        fun w => B.AB w s + evOff B.h (pwrA5 B G l0) Y' w s := by
      funext w
      exact hAX w s _
    have hcA : curl3 (fun w => B.AB w s + evOff B.h (pwrA5 B G l0) Y' w s) y =
        curl3 (fun w => B.AB w s) y + curl3 (fun w => evOff B.h (pwrA5 B G l0) Y' w s) y :=
      hcurl_add _ _ y hd1 hd2
    show evOff B.h (uX5 B G l0 (primState5 B G)) Y' y s =
      (curl3 (fun w => B.AB w s) y + B.BvB y s) + evOff B.h (pwrW5 B G l0) Y' y s
    rw [e1, e2, hfA, hcA, hBX]
    abel

  have hPr : ∀ z ∈ {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2},
      (↿(evOff B.h (PX5 B G l0 (primState5 B G)) Y')) z =
        (↿(fun y s => B.PB y s + evOff B.h (pwrP5 B G l0) Y' y s +
          (PX5 B G l0 (primState5 B G) y s (Yph B.h (rad y) s + Y') - B.PB y s
            - pwrP5 B G l0 y s (Yph B.h (rad y) s + Y')))) z := by
    rintro ⟨y, s⟩ _
    show PX5 B G l0 (primState5 B G) y s (Yph B.h (rad y) s + Y') =
      B.PB y s + pwrP5 B G l0 y s (Yph B.h (rad y) s + Y') +
        (PX5 B G l0 (primState5 B G) y s (Yph B.h (rad y) s + Y') - B.PB y s
          - pwrP5 B G l0 y s (Yph B.h (rad y) s + Y'))
    ring
  have hloc := hlocal _ _ _ _ _ hCO hU hPr hxC

  have hu2 : ContDiffAt ℝ 2 (↿(uB B)) (x, t) :=
    (huB.contDiffAt (hDo.mem_nhds hxD)).of_le (by norm_num)
  have hw2 : ContDiffAt ℝ 2 (↿(evOff B.h (pwrW5 B G l0) Y')) (x, t) :=
    ((hW Y').contDiffAt (hCO.mem_nhds hxC)).of_le (by norm_num)
  have hp1 : DifferentiableAt ℝ (fun y => B.PB y t) x := hsl B.PB _ x t hDo hPB hxD
  have hp2 : DifferentiableAt ℝ (fun y => evOff B.h (pwrP5 B G l0) Y' y t) x :=
    hsl _ _ x t hCO (hP Y') hxC

  have hradd : ∀ y : ℝ³, 0 < rad y → DifferentiableAt ℝ rad y := by
    intro y hy
    have hpos : y 0 ^ 2 + y 1 ^ 2 ≠ 0 := (Real.sqrt_pos.mp hy).ne'
    have h0 := ((EuclideanSpace.proj (0:Fin 3) : ℝ³ →L[ℝ] ℝ).differentiableAt (x := y)).pow 2
    have h1 := ((EuclideanSpace.proj (1:Fin 3) : ℝ³ →L[ℝ] ℝ).differentiableAt (x := y)).pow 2
    exact (h0.fun_add h1).sqrt hpos
  have hκd : DifferentiableAt ℝ (fun y : ℝ³ => ptOf y t (Yph B.h (rad y) t + Y')) x := by
    have hr := hradd x hxt.1
    have h1 : DifferentiableAt ℝ (fun y : ℝ³ => rad y ^ drx B.h) x :=
      hr.rpow_const (Or.inl hxt.1.ne')
    have h2 : DifferentiableAt ℝ (fun y : ℝ³ => Yph B.h (rad y) t + Y') x := by
      unfold Yph
      exact ((h1.smul_const vrv).add_const _).add_const _
    exact hr.prodMk (((EuclideanSpace.proj (2:Fin 3) : ℝ³ →L[ℝ] ℝ).differentiableAt).prodMk
      ((differentiableAt_const t).prodMk h2))
  have hmem : ptOf x t (Yph B.h (rad x) t + Y') ∈ DomC B.h (qsOf l0) := hxt
  have hcd : DifferentiableAt ℝ
      (fun y => pmP5 B G l0 (primState5 B G) (ptOf y t (Yph B.h (rad y) t + Y'))) x :=
    (hpm _ hmem).comp x hκd
  have hMd : DifferentiableAt ℝ (fun y => PX5 B G l0 (primState5 B G) y t (Yph B.h (rad y) t + Y')
      - B.PB y t - pwrP5 B G l0 y t (Yph B.h (rad y) t + Y')) x := by
    refine hcd.congr_of_eventuallyEq ?_
    filter_upwards [(hCO.preimage (continuous_id.prodMk continuous_const)).mem_nhds hxt] with y hy
    have hcy : corrOn B l0 y t := hy
    simp only [PX5, pwrP5, if_pos hcy]
    ring
  have hE : nsResidual 1 (fun y s => uB B y s + evOff B.h (pwrW5 B G l0) Y' y s)
      (fun y s => B.PB y s + evOff B.h (pwrP5 B G l0) Y' y s +
          (PX5 B G l0 (primState5 B G) y s (Yph B.h (rad y) s + Y') - B.PB y s
            - pwrP5 B G l0 y s (Yph B.h (rad y) s + Y'))) x t =
      nsResidual 1 (uB B) B.PB x t +
        nsResidual 1 (evOff B.h (pwrW5 B G l0) Y') (evOff B.h (pwrP5 B G l0) Y') x t +
        gradient (fun y => PX5 B G l0 (primState5 B G) y t (Yph B.h (rad y) t + Y')
          - B.PB y t - pwrP5 B G l0 y t (Yph B.h (rad y) t + Y')) x +
        fderiv ℝ (fun y => evOff B.h (pwrW5 B G l0) Y' y t) x (uB B x t) +
        fderiv ℝ (fun y => uB B y t) x (evOff B.h (pwrW5 B G l0) Y' x t) :=
    hexp (uB B) (evOff B.h (pwrW5 B G l0) Y') B.PB (evOff B.h (pwrP5 B G l0) Y')
      (fun y s => PX5 B G l0 (primState5 B G) y s (Yph B.h (rad y) s + Y') - B.PB y s
        - pwrP5 B G l0 y s (Yph B.h (rad y) s + Y')) hu2 hw2 hp1 hp2 hMd
  rw [hloc, hE]
  abel

theorem pws_stress_frame : ∀ (h : ℝ) (Tth Tz : ℝ → ℝ → ℝ → ℝ) (r z t : ℝ), 0 < r → ∃ c1 c2 : ℝ, ∀ y : ℝ³, rad y = r → y 2 = z → stressDivField h Tth Tz y t = c1 • eTh y + c2 • eZ :=
by
  intro h Tth Tz r z t hr
  refine ⟨(-(simScale h z (1 - t) ^ (-(2 + h)) *
      (deriv (fun Y => Tth (simScale h z (1 - t)) Y (z * simScale h z (1 - t) ^ (-(1 / 2 - h))))
          (r ^ 2 / (2 * simScale h z (1 - t)))
        + Tth (simScale h z (1 - t)) (r ^ 2 / (2 * simScale h z (1 - t)))
            (z * simScale h z (1 - t) ^ (-(1 / 2 - h))) / (r ^ 2 / (2 * simScale h z (1 - t)))))) * r,
    -(Real.sqrt (2 * (r ^ 2 / (2 * simScale h z (1 - t)))) * simScale h z (1 - t) ^ (-(3 / 2 + h)) *
      (deriv (fun Y => Tz (simScale h z (1 - t)) Y (z * simScale h z (1 - t) ^ (-(1 / 2 - h))))
          (r ^ 2 / (2 * simScale h z (1 - t)))
        + Tz (simScale h z (1 - t)) (r ^ 2 / (2 * simScale h z (1 - t)))
            (z * simScale h z (1 - t) ^ (-(1 / 2 - h))) / (2 * (r ^ 2 / (2 * simScale h z (1 - t)))))), ?_⟩
  intro y hy hz
  have hs : y 0 ^ 2 + y 1 ^ 2 = r ^ 2 := by
    rw [← hy]
    unfold rad
    exact (Real.sq_sqrt (add_nonneg (sq_nonneg _) (sq_nonneg _))).symm
  have haz : azVec y = r • eTh y := by
    unfold eTh
    rw [hy, smul_inv_smul₀ hr.ne']
  unfold stressDivField simX simEta
  rw [hz, hs, haz, smul_smul]
  rfl

theorem pws_pm_grad_frame : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ), B.ok → (∀ ξ ∈ DomC B.h (qsOf l0), DifferentiableAt ℝ (pmP5 B G l0 (primState5 B G)) ξ) → ∀ (x : ℝ³) (t : ℝ) (Y : ℝ × ℝ), corrOn B l0 x t → ∃ c0 c2 : ℝ, ∀ y : ℝ³, rad y = rad x → y 2 = x 2 → gradient (fun w => PX5 B G l0 (primState5 B G) w t (Yph B.h (rad w) t + (Y - Yph B.h (rad y) t)) - B.PB w t - pwrP5 B G l0 w t (Yph B.h (rad w) t + (Y - Yph B.h (rad y) t))) y = c0 • eR y + c2 • eZ :=
by
  classical
  intro B G l0 hok hpm x t Y hxt
  obtain ⟨hr, ht, hs⟩ := hxt

  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : ℝ → ℝ → ℝ, ∀ a b, Φ a b =
      if (0 < a ∧ t < 1 ∧ simScale B.h b (1 - t) < qsOf l0) then
        pmP5 B G l0 (primState5 B G) (a, b, t, Yph B.h a t + (Y - Yph B.h (rad x) t)) else 0 :=
    ⟨fun a b => if (0 < a ∧ t < 1 ∧ simScale B.h b (1 - t) < qsOf l0) then
        pmP5 B G l0 (primState5 B G) (a, b, t, Yph B.h a t + (Y - Yph B.h (rad x) t)) else 0,
      fun _ _ => rfl⟩

  obtain ⟨κ, hκdef⟩ : ∃ κ : ℝ × ℝ → Cyl,
      κ = fun p => (p.1, p.2, t, Yph B.h p.1 t + (Y - Yph B.h (rad x) t)) := ⟨_, rfl⟩
  have hκd : DifferentiableAt ℝ κ (rad x, x 2) := by
    have h1 : DifferentiableAt ℝ (fun p : ℝ × ℝ => p.1 ^ drx B.h) (rad x, x 2) :=
      differentiableAt_fst.rpow_const (Or.inl hr.ne')
    have h2 : DifferentiableAt ℝ (fun p : ℝ × ℝ => Yph B.h p.1 t + (Y - Yph B.h (rad x) t))
        (rad x, x 2) := by
      unfold Yph
      exact ((h1.smul_const vrv).add_const _).add_const _
    rw [hκdef]
    exact differentiableAt_fst.prodMk (differentiableAt_snd.prodMk
      ((differentiableAt_const t).prodMk h2))
  have hmem : κ (rad x, x 2) ∈ DomC B.h (qsOf l0) := by
    rw [hκdef]
    show 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0
    exact ⟨hr, ht, hs⟩
  have hcompd : DifferentiableAt ℝ (pmP5 B G l0 (primState5 B G) ∘ κ) (rad x, x 2) :=
    (hpm _ hmem).comp _ hκd
  have hcont : Continuous (fun p : ℝ × ℝ => simScale B.h p.2 (1 - t)) := by
    have := hok.1.2.2.2.1.continuousOn.comp_continuous (f := fun p : ℝ × ℝ => (p.2, 1 - t))
      (by fun_prop) (fun p => ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩)
    exact this
  have hU : IsOpen ({p : ℝ × ℝ | 0 < p.1} ∩ {p : ℝ × ℝ | simScale B.h p.2 (1 - t) < qsOf l0}) :=
    (isOpen_lt continuous_const continuous_fst).inter (isOpen_lt hcont continuous_const)
  have hΦd : DifferentiableAt ℝ (fun p : ℝ × ℝ => Φ p.1 p.2) (rad x, x 2) := by
    refine hcompd.congr_of_eventuallyEq ?_
    have hin : ((rad x, x 2) : ℝ × ℝ) ∈ ({p : ℝ × ℝ | 0 < p.1} ∩
        {p : ℝ × ℝ | simScale B.h p.2 (1 - t) < qsOf l0}) := ⟨hr, hs⟩
    filter_upwards [hU.mem_nhds hin] with p hp
    obtain ⟨hp1, hp2⟩ := hp
    have hp1' : 0 < p.1 := hp1
    have hp2' : simScale B.h p.2 (1 - t) < qsOf l0 := hp2
    rw [hΦdef, if_pos ⟨hp1', ht, hp2'⟩, hκdef]
    rfl
  obtain ⟨L, hLdef⟩ : ∃ L : ℝ × ℝ →L[ℝ] ℝ,
      L = fderiv ℝ (fun p : ℝ × ℝ => Φ p.1 p.2) (rad x, x 2) := ⟨_, rfl⟩
  have hlin : ∀ a b : ℝ, L (a, b) = a * L (1, 0) + b * L (0, 1) := by
    intro a b
    have e : ((a, b) : ℝ × ℝ) = a • ((1:ℝ), (0:ℝ)) + b • ((0:ℝ), (1:ℝ)) := by
      ext <;> simp
    rw [e, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
  refine ⟨L (1, 0), L (0, 1), fun y hy hz => ?_⟩
  have hry : 0 < rad y := by rw [hy]; exact hr

  have hfun : (fun w => PX5 B G l0 (primState5 B G) w t (Yph B.h (rad w) t + (Y - Yph B.h (rad y) t))
      - B.PB w t - pwrP5 B G l0 w t (Yph B.h (rad w) t + (Y - Yph B.h (rad y) t))) =
      fun w => Φ (rad w) (w 2) := by
    funext w
    rw [hy, hΦdef]
    by_cases hc : corrOn B l0 w t
    · have hc' : 0 < rad w ∧ t < 1 ∧ simScale B.h (w 2) (1 - t) < qsOf l0 := hc
      rw [if_pos hc']
      simp only [PX5, pwrP5, if_pos hc, ptOf]
      ring
    · have hc' : ¬ (0 < rad w ∧ t < 1 ∧ simScale B.h (w 2) (1 - t) < qsOf l0) := hc
      rw [if_neg hc']
      simp only [PX5, pwrP5, if_neg hc]
      ring

  obtain ⟨D, hDdef⟩ : ∃ D : ℝ³ →L[ℝ] ℝ, D = (rad y)⁻¹ •
      ((y 0) • (EuclideanSpace.proj (0:Fin 3) : ℝ³ →L[ℝ] ℝ)
        + (y 1) • (EuclideanSpace.proj (1:Fin 3) : ℝ³ →L[ℝ] ℝ)) := ⟨_, rfl⟩
  have hD : HasFDerivAt rad D y := by
    have hpos : 0 < y 0 ^ 2 + y 1 ^ 2 := Real.sqrt_pos.mp hry
    have h0 := ((EuclideanSpace.proj (0:Fin 3) : ℝ³ →L[ℝ] ℝ).hasFDerivAt (x := y)).pow 2
    have h1 := ((EuclideanSpace.proj (1:Fin 3) : ℝ³ →L[ℝ] ℝ).hasFDerivAt (x := y)).pow 2
    have hsq := (h0.add h1).sqrt (by exact hpos.ne')
    refine hsq.congr_fderiv ?_
    rw [hDdef]
    refine ContinuousLinearMap.ext fun v => ?_
    have hp : ∀ i, (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ) v = v i := fun i => rfl
    have hq : ∀ i, (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ) y = y i := fun i => rfl
    have hr2 : Real.sqrt (y 0 ^ 2 + y 1 ^ 2) = rad y := rfl
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply, smul_eq_mul, hp, hq,
      Pi.add_apply, hr2]
    field_simp
    ring
  have hψ : HasFDerivAt (fun w : ℝ³ => (rad w, w 2))
      (D.prod (EuclideanSpace.proj (2:Fin 3) : ℝ³ →L[ℝ] ℝ)) y :=
    hD.prodMk ((EuclideanSpace.proj (2:Fin 3) : ℝ³ →L[ℝ] ℝ).hasFDerivAt (x := y))
  have hpt : ((rad y, y 2) : ℝ × ℝ) = (rad x, x 2) := by rw [hy, hz]
  have hL : HasFDerivAt (fun p : ℝ × ℝ => Φ p.1 p.2) L (rad y, y 2) := by
    rw [hpt, hLdef]
    exact hΦd.hasFDerivAt
  have hcomp := hL.comp y hψ
  rw [hfun]
  apply HasGradientAt.gradient
  rw [hasGradientAt_iff_hasFDerivAt]
  refine hcomp.congr_fderiv ?_
  refine ContinuousLinearMap.ext fun v => ?_
  rw [InnerProductSpace.toDual_apply_apply]
  have hDv : D v = (rad y)⁻¹ * (y 0 * v 0 + y 1 * v 1) := by rw [hDdef]; rfl
  have hP2 : (EuclideanSpace.proj (2:Fin 3) : ℝ³ →L[ℝ] ℝ) v = v 2 := rfl
  rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.prod_apply, hDv, hP2, hlin]
  unfold eR radVec eZ
  simp only [inner_add_left, real_inner_smul_left, EuclideanSpace.inner_single_left, map_one,
    one_mul]
  ring

theorem pws_frame_avg : ∀ (F : Ext ℝ³) (x : ℝ³) (t : ℝ) (Y : ℝ × ℝ) (c0 c1 c2 : ℝ), 0 < rad x → (∀ θ : ℝ, F (rotPt (rad x) θ (x 2)) t Y = c0 • eR (rotPt (rad x) θ (x 2)) + c1 • eTh (rotPt (rad x) θ (x 2)) + c2 • eZ) → thAvgVec F x t Y = c0 • eR x + c1 • eTh x + c2 • eZ ∧ ∀ a : Fin 3, IntervalIntegrable (fun θ => inner ℝ (F (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) MeasureTheory.volume 0 (2 * Real.pi) :=
by
  intro F x t Y c0 c1 c2 hr hF

  have hrad : ∀ θ : ℝ, rad (rotPt (rad x) θ (x 2)) = rad x := by
    intro θ
    have e0 : (rotPt (rad x) θ (x 2)) 0 = rad x * Real.cos θ := by simp [rotPt]
    have e1 : (rotPt (rad x) θ (x 2)) 1 = rad x * Real.sin θ := by simp [rotPt]
    have hsq : (rad x * Real.cos θ) ^ 2 + (rad x * Real.sin θ) ^ 2 = rad x ^ 2 := by
      have hcs := Real.cos_sq_add_sin_sq θ
      calc (rad x * Real.cos θ) ^ 2 + (rad x * Real.sin θ) ^ 2
          = rad x ^ 2 * (Real.cos θ ^ 2 + Real.sin θ ^ 2) := by ring
        _ = rad x ^ 2 := by rw [hcs, mul_one]
    rw [show rad (rotPt (rad x) θ (x 2)) =
        Real.sqrt ((rotPt (rad x) θ (x 2)) 0 ^ 2 + (rotPt (rad x) θ (x 2)) 1 ^ 2) from rfl, e0, e1, hsq,
      Real.sqrt_sq hr.le]

  have hcoef : ∀ y : ℝ³, 0 < rad y →
      inner ℝ (c0 • eR y + c1 • eTh y + c2 • eZ) (eR y) = c0 ∧
      inner ℝ (c0 • eR y + c1 • eTh y + c2 • eZ) (eTh y) = c1 ∧
      inner ℝ (c0 • eR y + c1 • eTh y + c2 • eZ) eZ = c2 := by
    intro y hy
    have hS : (rad y)⁻¹ ^ 2 * (y 0 ^ 2 + y 1 ^ 2) = 1 := by
      have h1 : rad y ^ 2 = y 0 ^ 2 + y 1 ^ 2 :=
        Real.sq_sqrt (add_nonneg (sq_nonneg _) (sq_nonneg _))
      rw [← h1, inv_pow, inv_mul_cancel₀ (pow_ne_zero 2 hy.ne')]
    simp only [eR, eTh, eZ, radVec, azVec]
    generalize (rad y)⁻¹ = a at hS ⊢
    simp only [PiLp.inner_apply, Fin.sum_univ_three, PiLp.add_apply, PiLp.smul_apply,
      EuclideanSpace.single_apply, smul_eq_mul, RCLike.inner_apply, conj_trivial]
    refine ⟨?_, ?_, ?_⟩ <;> (try norm_num) <;>
      first
        | linear_combination c0 * hS
        | linear_combination c1 * hS
        | ring

  have hconst : ∀ a : Fin 3, (fun θ => inner ℝ (F (rotPt (rad x) θ (x 2)) t Y)
      (frameAt θ (ptOf x t Y) a)) = fun _ => ![c0, c1, c2] a := by
    intro a
    funext θ
    have hy : 0 < rad (rotPt (rad x) θ (x 2)) := by rw [hrad θ]; exact hr
    obtain ⟨e0, e1, e2⟩ := hcoef _ hy
    rw [hF θ]
    fin_cases a
    · exact e0
    · exact e1
    · exact e2
  have hthA : ∀ c : ℝ, thA (fun _ => c) = c := by
    intro c
    unfold thA
    rw [intervalIntegral.integral_const, smul_eq_mul, sub_zero, ← mul_assoc,
      inv_mul_cancel₀ (by positivity), one_mul]
  refine ⟨?_, fun a => ?_⟩
  · have hfun : (fun a => thA (fun θ => inner ℝ (F (rotPt (rad x) θ (x 2)) t Y)
        (frameAt θ (ptOf x t Y) a))) = ![c0, c1, c2] := by
      funext a
      rw [hconst a, hthA]
    unfold thAvgVec
    rw [hfun]
    rfl
  · rw [hconst a]
    exact intervalIntegrable_const

theorem pws_circle_integrable : ∀ (F : Ext ℝ³) (x : ℝ³) (t : ℝ) (Y : ℝ × ℝ) (O : Set ℝ³), 0 < rad x → ContinuousOn (fun y => F y t Y) O → (∀ θ : ℝ, rotPt (rad x) θ (x 2) ∈ O) → ∀ a : Fin 3, IntervalIntegrable (fun θ => inner ℝ (F (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) MeasureTheory.volume 0 (2 * Real.pi) :=
by
  intro F x t Y O hr hF hO a
  apply Continuous.intervalIntegrable
  have hc : Continuous (fun θ : ℝ => rotPt (rad x) θ (x 2)) := by
    unfold rotPt
    fun_prop
  have hφ : Continuous (fun θ => F (rotPt (rad x) θ (x 2)) t Y) :=
    hF.comp_continuous hc hO
  have e0 : ∀ θ : ℝ, (rotPt (rad x) θ (x 2)) 0 = rad x * Real.cos θ := fun θ => by simp [rotPt]
  have e1 : ∀ θ : ℝ, (rotPt (rad x) θ (x 2)) 1 = rad x * Real.sin θ := fun θ => by simp [rotPt]
  have hrad : ∀ θ : ℝ, rad (rotPt (rad x) θ (x 2)) = rad x := by
    intro θ
    have hsq : (rad x * Real.cos θ) ^ 2 + (rad x * Real.sin θ) ^ 2 = rad x ^ 2 := by
      have hcs := Real.cos_sq_add_sin_sq θ
      calc (rad x * Real.cos θ) ^ 2 + (rad x * Real.sin θ) ^ 2
          = rad x ^ 2 * (Real.cos θ ^ 2 + Real.sin θ ^ 2) := by ring
        _ = rad x ^ 2 := by rw [hcs, mul_one]
    rw [show rad (rotPt (rad x) θ (x 2)) =
        Real.sqrt ((rotPt (rad x) θ (x 2)) 0 ^ 2 + (rotPt (rad x) θ (x 2)) 1 ^ 2) from rfl, e0, e1, hsq,
      Real.sqrt_sq hr.le]
  have hR : Continuous (fun θ : ℝ => eR (rotPt (rad x) θ (x 2))) := by
    have e : (fun θ : ℝ => eR (rotPt (rad x) θ (x 2))) = fun θ : ℝ =>
        (rad x)⁻¹ • ((rad x * Real.cos θ) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
          (rad x * Real.sin θ) • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) := by
      funext θ
      rw [eR, hrad θ, radVec, e0, e1]
    rw [e]
    fun_prop
  have hT : Continuous (fun θ : ℝ => eTh (rotPt (rad x) θ (x 2))) := by
    have e : (fun θ : ℝ => eTh (rotPt (rad x) θ (x 2))) = fun θ : ℝ =>
        (rad x)⁻¹ • (-(rad x * Real.sin θ) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
          (rad x * Real.cos θ) • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) := by
      funext θ
      rw [eTh, hrad θ, azVec, e0, e1]
    rw [e]
    fun_prop
  have hframe : Continuous (fun θ => frameAt θ (ptOf x t Y) a) := by
    fin_cases a
    · exact hR
    · exact hT
    · exact continuous_const
  exact hφ.inner hframe

theorem pws_avg_add5 : ∀ (R F1 F2 F3 F4 F5 : Ext ℝ³) (x : ℝ³) (t : ℝ) (Y : ℝ × ℝ), (∀ θ : ℝ, R (rotPt (rad x) θ (x 2)) t Y = F1 (rotPt (rad x) θ (x 2)) t Y + F2 (rotPt (rad x) θ (x 2)) t Y + F3 (rotPt (rad x) θ (x 2)) t Y + F4 (rotPt (rad x) θ (x 2)) t Y + F5 (rotPt (rad x) θ (x 2)) t Y) → (∀ a : Fin 3, IntervalIntegrable (fun θ => inner ℝ (F1 (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) MeasureTheory.volume 0 (2 * Real.pi)) → (∀ a : Fin 3, IntervalIntegrable (fun θ => inner ℝ (F2 (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) MeasureTheory.volume 0 (2 * Real.pi)) → (∀ a : Fin 3, IntervalIntegrable (fun θ => inner ℝ (F3 (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) MeasureTheory.volume 0 (2 * Real.pi)) → (∀ a : Fin 3, IntervalIntegrable (fun θ => inner ℝ (F4 (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) MeasureTheory.volume 0 (2 * Real.pi)) → (∀ a : Fin 3, IntervalIntegrable (fun θ => inner ℝ (F5 (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) MeasureTheory.volume 0 (2 * Real.pi)) → thAvgVec R x t Y = thAvgVec F1 x t Y + thAvgVec F2 x t Y + thAvgVec F3 x t Y + thAvgVec F4 x t Y + thAvgVec F5 x t Y :=
by
  intro R F1 F2 F3 F4 F5 x t Y H0 h1 h2 h3 h4 h5
  have lin : ∀ (f g1 g2 g3 g4 g5 : ℝ → ℝ), (∀ θ, f θ = g1 θ + g2 θ + g3 θ + g4 θ + g5 θ) →
      IntervalIntegrable g1 MeasureTheory.volume 0 (2 * Real.pi) →
      IntervalIntegrable g2 MeasureTheory.volume 0 (2 * Real.pi) →
      IntervalIntegrable g3 MeasureTheory.volume 0 (2 * Real.pi) →
      IntervalIntegrable g4 MeasureTheory.volume 0 (2 * Real.pi) →
      IntervalIntegrable g5 MeasureTheory.volume 0 (2 * Real.pi) →
      thA f = thA g1 + thA g2 + thA g3 + thA g4 + thA g5 := by
    intro f g1 g2 g3 g4 g5 hf i1 i2 i3 i4 i5
    have hfe : f = fun θ => g1 θ + g2 θ + g3 θ + g4 θ + g5 θ := funext hf
    subst hfe
    have e1 : (∫ θ in (0:ℝ)..(2 * Real.pi), g1 θ + g2 θ + g3 θ + g4 θ + g5 θ) =
        (∫ θ in (0:ℝ)..(2 * Real.pi), g1 θ + g2 θ + g3 θ + g4 θ) +
          ∫ θ in (0:ℝ)..(2 * Real.pi), g5 θ :=
      intervalIntegral.integral_add (((i1.add i2).add i3).add i4) i5
    have e2 : (∫ θ in (0:ℝ)..(2 * Real.pi), g1 θ + g2 θ + g3 θ + g4 θ) =
        (∫ θ in (0:ℝ)..(2 * Real.pi), g1 θ + g2 θ + g3 θ) +
          ∫ θ in (0:ℝ)..(2 * Real.pi), g4 θ :=
      intervalIntegral.integral_add ((i1.add i2).add i3) i4
    have e3 : (∫ θ in (0:ℝ)..(2 * Real.pi), g1 θ + g2 θ + g3 θ) =
        (∫ θ in (0:ℝ)..(2 * Real.pi), g1 θ + g2 θ) +
          ∫ θ in (0:ℝ)..(2 * Real.pi), g3 θ :=
      intervalIntegral.integral_add (i1.add i2) i3
    have e4 : (∫ θ in (0:ℝ)..(2 * Real.pi), g1 θ + g2 θ) =
        (∫ θ in (0:ℝ)..(2 * Real.pi), g1 θ) + ∫ θ in (0:ℝ)..(2 * Real.pi), g2 θ :=
      intervalIntegral.integral_add i1 i2
    unfold thA
    rw [e1, e2, e3, e4]
    ring
  have key : ∀ a : Fin 3,
      thA (fun θ => inner ℝ (R (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) =
        thA (fun θ => inner ℝ (F1 (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) +
        thA (fun θ => inner ℝ (F2 (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) +
        thA (fun θ => inner ℝ (F3 (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) +
        thA (fun θ => inner ℝ (F4 (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) +
        thA (fun θ => inner ℝ (F5 (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) := by
    intro a
    refine lin _ _ _ _ _ _ (fun θ => ?_) (h1 a) (h2 a) (h3 a) (h4 a) (h5 a)
    simp only [H0 θ, inner_add_left]
  simp only [thAvgVec, cyl2cart]
  rw [key 0, key 1, key 2]
  simp only [add_smul]
  abel

theorem pwr5_split_identity : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    InWg5 B G (qsOf l0) 1 (primState5 B G).Aw → InWg5 B G (qsOf l0) 1 (primState5 B G).pw →
    (∀ (a : Fin 3), ∀ ξ ∈ DomC B.h (qsOf l0), mcor5 B G l0 (primState5 B G) a ξ = 0) →
    ∀ x t Y, corrOn B l0 x t →
      resX B.h (uX5 B G l0 (primState5 B G)) (PX5 B G l0 (primState5 B G)) x t Y -
        thAvgVec (resX B.h (uX5 B G l0 (primState5 B G)) (PX5 B G l0 (primState5 B G))) x t Y =
      pwrFB B x t Y + (pwrLin B G l0 x t Y - thAvgVec (pwrLin B G l0) x t Y)
        + (pwrQ B G l0 x t Y - thAvgVec (pwrQ B G l0) x t Y) :=
by
  intro B G hok hG
  obtain ⟨a1, h1⟩ := pws_fields_smooth B G hok hG
  obtain ⟨a2, h2⟩ := pws_prim_grP_regular B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, hqB1, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0 + a1 + a2, fun l0 hl0 hAw hpw hm0 => ?_⟩
  intro x t Y hxt
  have hxt' : 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs0 : 0 < qsOf l0 := by rw [hQb]; positivity
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hq1 : qsOf l0 ≤ 1 := le_trans hqsB hqB1

  have hF := h1 l0 (by omega) hAw hpw
  obtain ⟨hgr, hsh⟩ := h2 l0 (by omega) hAw hm0
  have hpm : ∀ ξ ∈ DomC B.h (qsOf l0), DifferentiableAt ℝ (pmP5 B G l0 (primState5 B G)) ξ :=
    pws_icut_diff B (qsOf l0) _ hok hqs0 hq1 hgr hsh
  have hsplit := pws_pointwise_split B G l0 hok hqsB (fun Y₀ => (hF Y₀).1) (fun Y₀ => (hF Y₀).2.1)
    (fun Y₀ => (hF Y₀).2.2.1) hpm

  have hr0 : 0 < rad x := hxt'.1
  have hrot : ∀ θ : ℝ, rad (rotPt (rad x) θ (x 2)) = rad x ∧ (rotPt (rad x) θ (x 2)) 2 = x 2 := by
    intro θ
    have e0 : (rotPt (rad x) θ (x 2)) 0 = rad x * Real.cos θ := by simp [rotPt]
    have e1 : (rotPt (rad x) θ (x 2)) 1 = rad x * Real.sin θ := by simp [rotPt]
    have e2 : (rotPt (rad x) θ (x 2)) 2 = x 2 := by simp [rotPt]
    refine ⟨?_, e2⟩
    have hsq : (rad x * Real.cos θ) ^ 2 + (rad x * Real.sin θ) ^ 2 = rad x ^ 2 := by
      have hcs := Real.cos_sq_add_sin_sq θ
      calc (rad x * Real.cos θ) ^ 2 + (rad x * Real.sin θ) ^ 2
          = rad x ^ 2 * (Real.cos θ ^ 2 + Real.sin θ ^ 2) := by ring
        _ = rad x ^ 2 := by rw [hcs, mul_one]
    rw [show rad (rotPt (rad x) θ (x 2)) =
        Real.sqrt ((rotPt (rad x) θ (x 2)) 0 ^ 2 + (rotPt (rad x) θ (x 2)) 1 ^ 2) from rfl, e0, e1, hsq,
      Real.sqrt_sq hr0.le]
  have hcirc : ∀ θ : ℝ, corrOn B l0 (rotPt (rad x) θ (x 2)) t := by
    intro θ
    obtain ⟨e1, e2⟩ := hrot θ
    show 0 < rad (rotPt (rad x) θ (x 2)) ∧ t < 1 ∧ simScale B.h ((rotPt (rad x) θ (x 2)) 2) (1 - t) < qsOf l0
    rw [e1, e2]
    exact hxt'

  obtain ⟨FS, hFSv⟩ : ∃ F : Ext ℝ³, ∀ y s Y0, F y s Y0 = stressDivField B.h B.Tth B.Tz y s :=
    ⟨fun y s _ => stressDivField B.h B.Tth B.Tz y s, fun _ _ _ => rfl⟩
  obtain ⟨FG, hFGv⟩ : ∃ F : Ext ℝ³, ∀ y s Y0, F y s Y0 =
      gradient (fun w => PX5 B G l0 (primState5 B G) w s (Yph B.h (rad w) s + (Y0 - Yph B.h (rad y) s))
        - B.PB w s - pwrP5 B G l0 w s (Yph B.h (rad w) s + (Y0 - Yph B.h (rad y) s))) y :=
    ⟨fun y s Y0 => gradient (fun w => PX5 B G l0 (primState5 B G) w s
        (Yph B.h (rad w) s + (Y0 - Yph B.h (rad y) s))
        - B.PB w s - pwrP5 B G l0 w s (Yph B.h (rad w) s + (Y0 - Yph B.h (rad y) s))) y,
      fun _ _ _ => rfl⟩
  have hR : ∀ y, corrOn B l0 y t →
      resX B.h (uX5 B G l0 (primState5 B G)) (PX5 B G l0 (primState5 B G)) y t Y =
        pwrE B y t Y + FS y t Y + pwrLin B G l0 y t Y + pwrQ B G l0 y t Y + FG y t Y := by
    intro y hy
    rw [hFSv, hFGv]
    exact hsplit y t Y hy
  obtain ⟨c1, c2, hst⟩ := pws_stress_frame B.h B.Tth B.Tz (rad x) (x 2) t hr0
  obtain ⟨d0, d2, hgf⟩ := pws_pm_grad_frame B G l0 hok hpm x t Y hxt
  obtain ⟨hFSavg, hFSint⟩ := pws_frame_avg FS x t Y 0 c1 c2 hr0 (fun θ => by
    obtain ⟨e1, e2⟩ := hrot θ
    rw [hFSv, hst _ e1 e2, zero_smul, zero_add])
  obtain ⟨hFGavg, hFGint⟩ := pws_frame_avg FG x t Y d0 0 d2 hr0 (fun θ => by
    obtain ⟨e1, e2⟩ := hrot θ
    rw [hFGv, hgf _ e1 e2, zero_smul, add_zero])

  obtain ⟨-, -, -, -, hmriE⟩ := bg_flow_props B hok
  have hEc : ContinuousOn (fun y => pwrE B y t Y) {y : ℝ³ | (y, t) ∈ simDomain B.h B.qB} := by
    have := hmriE.continuousOn.comp (f := fun y : ℝ³ => (y, t))
      (continuous_id.prodMk continuous_const).continuousOn (fun y hy => hy)
    exact this
  have hEint := pws_circle_integrable (pwrE B) x t Y {y : ℝ³ | (y, t) ∈ simDomain B.h B.qB} hr0 hEc
    (fun θ => by
      obtain ⟨-, e2⟩ := hrot θ
      show t < 1 ∧ simScale B.h ((rotPt (rad x) θ (x 2)) 2) (1 - t) < B.qB
      rw [e2]
      exact ⟨hxt'.2.1, lt_of_lt_of_le hxt'.2.2 hqsB⟩)
  have hoff : ∀ θ : ℝ, Yph B.h (rad (rotPt (rad x) θ (x 2))) t + (Y - Yph B.h (rad x) t) = Y := by
    intro θ
    rw [(hrot θ).1]
    abel
  have hLint0 := pws_circle_integrable (fun y s _ => evOff B.h (pwrLin B G l0) (Y - Yph B.h (rad x) t) y s)
    x t Y {y : ℝ³ | corrOn B l0 y t} hr0 ((hF (Y - Yph B.h (rad x) t)).2.2.2.1 t) hcirc
  have hQint0 := pws_circle_integrable (fun y s _ => evOff B.h (pwrQ B G l0) (Y - Yph B.h (rad x) t) y s)
    x t Y {y : ℝ³ | corrOn B l0 y t} hr0 ((hF (Y - Yph B.h (rad x) t)).2.2.2.2 t) hcirc
  have hLint : ∀ a : Fin 3, IntervalIntegrable (fun θ => inner ℝ (pwrLin B G l0 (rotPt (rad x) θ (x 2)) t Y)
      (frameAt θ (ptOf x t Y) a)) MeasureTheory.volume 0 (2 * Real.pi) := by
    intro a
    have e : (fun θ => inner ℝ (pwrLin B G l0 (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) =
        (fun θ => inner ℝ ((fun y s _ => evOff B.h (pwrLin B G l0) (Y - Yph B.h (rad x) t) y s)
          (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) := by
      funext θ
      simp only [evOff, hoff θ]
    rw [e]
    exact hLint0 a
  have hQint : ∀ a : Fin 3, IntervalIntegrable (fun θ => inner ℝ (pwrQ B G l0 (rotPt (rad x) θ (x 2)) t Y)
      (frameAt θ (ptOf x t Y) a)) MeasureTheory.volume 0 (2 * Real.pi) := by
    intro a
    have e : (fun θ => inner ℝ (pwrQ B G l0 (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) =
        (fun θ => inner ℝ ((fun y s _ => evOff B.h (pwrQ B G l0) (Y - Yph B.h (rad x) t) y s)
          (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) := by
      funext θ
      simp only [evOff, hoff θ]
    rw [e]
    exact hQint0 a

  have hsum := pws_avg_add5 (resX B.h (uX5 B G l0 (primState5 B G)) (PX5 B G l0 (primState5 B G)))
    (pwrE B) FS (pwrLin B G l0) (pwrQ B G l0) FG x t Y (fun θ => hR _ (hcirc θ))
    hEint hFSint hLint hQint hFGint
  have hFSx : thAvgVec FS x t Y = FS x t Y := by
    rw [hFSavg, hFSv, hst x rfl rfl]
    simp
  have hFGx : thAvgVec FG x t Y = FG x t Y := by
    rw [hFGavg, hFGv, hgf x rfl rfl]
    simp
  rw [hsum, hR x hxt, hFSx, hFGx]
  rw [show pwrFB B x t Y = pwrE B x t Y - thAvgVec (pwrE B) x t Y from rfl]
  abel

theorem pwr5_base_flat : ∀ (B : BG), B.ok → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    FlatX B (qsOf l0) (pwrFB B) ∧
    ∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (↿(evOff B.h (pwrFB B) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} :=
by
  intro B hok
  obtain ⟨-, -, -, -, -, -, -, hqB0, -⟩ := hok.2.1
  obtain ⟨-, -, -, -, -, -, -, -, -, hflatB, -, -⟩ := hok.2
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 => ?_⟩
  have hS : SimScaleProps B.h := hok.1
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  set U := simDomain B.h (qsOf l0) with hUdef
  have hUB : U ⊆ simDomain B.h B.qB := fun z hz => ⟨hz.1, lt_of_lt_of_le hz.2 hqsB⟩

  have hrot2 : ∀ (φ : ℝ) (v : ℝ³), (rotZ φ v) 2 = v 2 := by
    intro φ v; simp [rotZ]
  have hinv : ∀ (φ : ℝ) (v : ℝ³) (s : ℝ), (v, s) ∈ U → (rotZ φ v, s) ∈ U := by
    intro φ v s hv
    refine ⟨hv.1, ?_⟩
    show simScale B.h ((rotZ φ v) 2) (1 - s) < qsOf l0
    rw [hrot2]; exact hv.2
  have hUo : IsOpen U := by
    have hc : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} := by
      have hp : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) := by fun_prop
      exact hS.2.2.2.1.continuousOn.comp hp.continuousOn
        (fun w hw => ⟨mem_univ _, by simp only [mem_Ioi]; simp at hw; linarith⟩)
    exact hc.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) (isOpen_Iio (a := qsOf l0))

  have t1 : ContDiff ℝ ∞ (fun p : ℝ × (ℝ³ × ℝ) => rotZ p.1 p.2.1) := by
    unfold rotZ; fun_prop
  have t2 : ContDiff ℝ ∞ (fun p : ℝ × (ℝ³ × ℝ) => ((rotZ p.1 p.2.1, p.2.2) : ℝ³ × ℝ)) :=
    t1.prodMk (contDiff_snd.comp contDiff_snd)
  have t3 : ContDiff ℝ ∞ (fun q : ℝ × ℝ³ => rotZ (-q.1) q.2) := by
    unfold rotZ; fun_prop

  obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ → (ℝ³ ≃ₗᵢ[ℝ] ℝ³), ∀ φ v, ρ φ v = rotZ φ v :=
    ⟨fun φ =>
      { toFun := rotZ φ
        invFun := rotZ (-φ)
        map_add' := by
          intro u v; ext i; fin_cases i <;> simp [rotZ] <;> ring
        map_smul' := by
          intro c v; ext i; fin_cases i <;> simp [rotZ] <;> ring
        left_inv := by
          intro v; ext i; fin_cases i <;> simp [rotZ, Real.cos_neg, Real.sin_neg]
          · linear_combination (v 0) * Real.sin_sq_add_cos_sq φ
          · linear_combination (v 1) * Real.sin_sq_add_cos_sq φ
        right_inv := by
          intro v; ext i; fin_cases i <;> simp [rotZ, Real.cos_neg, Real.sin_neg]
          · linear_combination (v 0) * Real.sin_sq_add_cos_sq φ
          · linear_combination (v 1) * Real.sin_sq_add_cos_sq φ
        norm_map' := by
          intro v
          simp only [EuclideanSpace.norm_eq, Fin.sum_univ_three]
          congr 1
          simp [rotZ]
          linear_combination (v 0 ^ 2 + v 1 ^ 2) * Real.sin_sq_add_cos_sq φ }, fun _ _ => rfl⟩
  obtain ⟨τ, hτ⟩ : ∃ τ : ℝ → ((ℝ³ × ℝ) ≃ₗᵢ[ℝ] (ℝ³ × ℝ)), ∀ φ w, τ φ w = (rotZ φ w.1, w.2) :=
    ⟨fun φ =>
      { toLinearEquiv := (ρ φ).toLinearEquiv.prodCongr (LinearEquiv.refl ℝ ℝ)
        norm_map' := by
          intro w
          simp [Prod.norm_def] }, fun φ w => by simp [hρ]⟩

  have param_fderiv : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
      (H : ℝ × (ℝ³ × ℝ) → F), ContDiffOn ℝ ∞ H (univ ×ˢ U) →
      ContDiffOn ℝ ∞ (fun p : ℝ × (ℝ³ × ℝ) => fderiv ℝ (fun w' => H (p.1, w')) p.2) (univ ×ˢ U) := by
    intro F _ _ H hH p hp
    have hO : IsOpen ((univ : Set ℝ) ×ˢ U) := isOpen_univ.prod hUo
    have hHa : ContDiffAt ℝ ∞ H p := hH.contDiffAt (hO.mem_nhds hp)
    apply ContDiffAt.contDiffWithinAt
    have h1 : ContDiffAt ℝ ∞ (Function.uncurry (fun (q : ℝ × (ℝ³ × ℝ)) (w' : ℝ³ × ℝ) => H (q.1, w')))
        (p, p.2) := by
      have e : Function.uncurry (fun (q : ℝ × (ℝ³ × ℝ)) (w' : ℝ³ × ℝ) => H (q.1, w')) =
          H ∘ (fun z : (ℝ × (ℝ³ × ℝ)) × (ℝ³ × ℝ) => (z.1.1, z.2)) := rfl
      rw [e]
      apply ContDiffAt.comp (g := H) (p, p.2)
      · simpa using hHa
      · fun_prop
    exact ContDiffAt.fderiv (f := fun (q : ℝ × (ℝ³ × ℝ)) (w' : ℝ³ × ℝ) => H (q.1, w'))
      (g := Prod.snd) h1 contDiffAt_snd (le_of_eq ENat.coe_top_add_one)
  have param_hasFDeriv : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (H : ℝ × (ℝ³ × ℝ) → F), ContDiffOn ℝ ∞ H (univ ×ˢ U) → ∀ w ∈ U,
      HasFDerivAt (fun w' => ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w'))
        (∫ φ in (0:ℝ)..(2 * Real.pi), fderiv ℝ (fun w' => H (φ, w')) w) w := by
    intro F _ _ _ H hH w hw
    have hO : IsOpen ((univ : Set ℝ) ×ˢ U) := isOpen_univ.prod hUo
    have hHs := param_fderiv H hH
    obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hUo w hw
    set s := Metric.closedBall w (δ / 2) with hs
    have hsU : s ⊆ U := (Metric.closedBall_subset_ball (by linarith)).trans hball
    have hsn : s ∈ nhds w := Metric.closedBall_mem_nhds w (by linarith)
    have hK : IsCompact (Icc (0:ℝ) (2 * Real.pi) ×ˢ s) := isCompact_Icc.prod (isCompact_closedBall _ _)
    have hKsub : Icc (0:ℝ) (2 * Real.pi) ×ˢ s ⊆ univ ×ˢ U := fun z hz => ⟨mem_univ _, hsU hz.2⟩
    obtain ⟨Bd, hBd⟩ := hK.exists_bound_of_continuousOn (hHs.continuousOn.mono hKsub)
    have hcontφ : ∀ x ∈ U, Continuous (fun φ : ℝ => H (φ, x)) := by
      intro x hx
      exact hH.continuousOn.comp_continuous (by fun_prop) (fun φ => ⟨mem_univ _, hx⟩)
    have hcontφ' : ∀ x ∈ U, Continuous (fun φ : ℝ => fderiv ℝ (fun w' => H (φ, w')) x) := by
      intro x hx
      exact hHs.continuousOn.comp_continuous (f := fun φ : ℝ => ((φ, x) : ℝ × (ℝ³ × ℝ))) (by fun_prop)
        (fun φ => ⟨mem_univ _, hx⟩)
    have hpi : (0:ℝ) ≤ 2 * Real.pi := by positivity
    refine intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := volume)
      (F := fun x φ => H (φ, x)) (F' := fun x φ => fderiv ℝ (fun w' => H (φ, w')) x)
      (bound := fun _ => Bd) hsn ?_ ?_ ?_ ?_ ?_ ?_
    · filter_upwards [hUo.mem_nhds hw] with x hx
      exact (hcontφ x hx).aestronglyMeasurable
    · exact (hcontφ w hw).intervalIntegrable _ _
    · exact (hcontφ' w hw).aestronglyMeasurable
    · refine ae_of_all _ (fun φ hφ x hx => ?_)
      rw [Set.uIoc_of_le hpi] at hφ
      exact hBd (φ, x) ⟨Set.Ioc_subset_Icc_self hφ, hx⟩
    · exact intervalIntegrable_const
    · refine ae_of_all _ (fun φ _ x hx => ?_)
      have hxU : x ∈ U := hsU hx
      have hHa : ContDiffAt ℝ ∞ H (φ, x) := hH.contDiffAt (hO.mem_nhds ⟨mem_univ _, hxU⟩)
      have : ContDiffAt ℝ ∞ (fun w' => H (φ, w')) x :=
        hHa.comp x (by fun_prop : ContDiffAt ℝ ∞ (fun w' : ℝ³ × ℝ => ((φ, w') : ℝ × (ℝ³ × ℝ))) x)
      exact (this.differentiableAt (by simp)).hasFDerivAt
  have param_bound : ∀ (n : ℕ) {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
      [CompleteSpace F] (H : ℝ × (ℝ³ × ℝ) → F),
      ContDiffOn ℝ ∞ H (univ ×ˢ U) → ∀ w ∈ U, ∀ M : ℝ,
      (∀ φ : ℝ, ‖iteratedFDeriv ℝ n (fun w' => H (φ, w')) w‖ ≤ M) →
      ‖iteratedFDeriv ℝ n (fun w' => (2 * Real.pi)⁻¹ • ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w')) w‖ ≤ M := by
    intro n
    induction n with
    | zero =>
      intro F _ _ _ H _ w _ M hM
      simp only [norm_iteratedFDeriv_zero] at hM ⊢
      have hpi : (0:ℝ) < 2 * Real.pi := by positivity
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpi)]
      have h1 := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := 2 * Real.pi)
        (f := fun φ => H (φ, w)) (C := M) (fun φ _ => hM φ)
      rw [sub_zero, abs_of_pos hpi] at h1
      calc (2 * Real.pi)⁻¹ * ‖∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w)‖
          ≤ (2 * Real.pi)⁻¹ * (M * (2 * Real.pi)) :=
            mul_le_mul_of_nonneg_left h1 (inv_nonneg.mpr hpi.le)
        _ = M := by field_simp
    | succ n ih =>
      intro F _ _ _ H hH w hw M hM
      set Hs : ℝ × (ℝ³ × ℝ) → ((ℝ³ × ℝ) →L[ℝ] F) :=
        fun p => fderiv ℝ (fun w' => H (p.1, w')) p.2 with hHs_def
      have hHs : ContDiffOn ℝ ∞ Hs (univ ×ˢ U) := param_fderiv H hH
      have hMs : ∀ φ : ℝ, ‖iteratedFDeriv ℝ n (fun w' => Hs (φ, w')) w‖ ≤ M := by
        intro φ
        have : (fun w' => Hs (φ, w')) = fderiv ℝ (fun w' => H (φ, w')) := rfl
        rw [this, norm_iteratedFDeriv_fderiv]
        exact hM φ
      have hIH := ih Hs hHs w hw M hMs
      have hev : fderiv ℝ (fun w' => (2 * Real.pi)⁻¹ • ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w')) =ᶠ[nhds w]
          (fun w' => (2 * Real.pi)⁻¹ • ∫ φ in (0:ℝ)..(2 * Real.pi), Hs (φ, w')) := by
        filter_upwards [hUo.mem_nhds hw] with x hx
        exact ((param_hasFDeriv H hH x hx).const_smul ((2 * Real.pi)⁻¹)).fderiv
      rw [← norm_iteratedFDeriv_fderiv, (hev.iteratedFDeriv ℝ n).eq_of_nhds]
      exact hIH
  have param_nat : ∀ (k : ℕ) {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
      [CompleteSpace F] (H : ℝ × (ℝ³ × ℝ) → F), ContDiffOn ℝ ∞ H (univ ×ˢ U) →
      ContDiffOn ℝ k (fun w' => ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w')) U := by
    intro k
    induction k with
    | zero =>
      intro F _ _ _ H hH
      have hD : DifferentiableOn ℝ (fun w' => ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w')) U :=
        fun w hw => (param_hasFDeriv H hH w hw).differentiableAt.differentiableWithinAt
      rw [Nat.cast_zero]
      exact contDiffOn_zero.mpr hD.continuousOn
    | succ k ih =>
      intro F _ _ _ H hH
      have hD : DifferentiableOn ℝ (fun w' => ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w')) U :=
        fun w hw => (param_hasFDeriv H hH w hw).differentiableAt.differentiableWithinAt
      have hCS : CompleteSpace ((ℝ³ × ℝ) →L[ℝ] F) := ContinuousLinearMap.instCompleteSpace (E := ℝ³ × ℝ)
      have hIH := @ih ((ℝ³ × ℝ) →L[ℝ] F) _ _ hCS
        (fun p : ℝ × (ℝ³ × ℝ) => fderiv ℝ (fun w' => H (p.1, w')) p.2) (param_fderiv H hH)
      rw [Nat.cast_succ]
      refine (contDiffOn_succ_iff_fderiv_of_isOpen hUo).mpr ⟨hD, fun h => ?_, ?_⟩
      · exact absurd h (by simp)
      · refine hIH.congr (fun w hw => ?_)
        exact (param_hasFDeriv H hH w hw).fderiv

  have hs2 : ∀ (E : ℝ³ → ℝ → ℝ³) (x : ℝ³) (t : ℝ), Continuous (fun φ : ℝ => E (rotZ φ x) t) →
      thAvgVec (fun x' t' (_ : ℝ × ℝ) => E x' t') x t 0 =
        (2 * Real.pi)⁻¹ • ∫ φ in (0:ℝ)..(2 * Real.pi), rotZ (-φ) (E (rotZ φ x) t) := by
    intro E x t hcont
    have hr0 : 0 ≤ rad x := Real.sqrt_nonneg _
    have hradrot : ∀ θ, rad (rotPt (rad x) θ (x 2)) = rad x := by
      intro θ
      have e0 : rotPt (rad x) θ (x 2) 0 = rad x * Real.cos θ := by simp [rotPt]
      have e1 : rotPt (rad x) θ (x 2) 1 = rad x * Real.sin θ := by simp [rotPt]
      have e : (rad x * Real.cos θ) ^ 2 + (rad x * Real.sin θ) ^ 2 = rad x ^ 2 := by
        linear_combination (rad x) ^ 2 * Real.cos_sq_add_sin_sq θ
      show Real.sqrt ((rotPt (rad x) θ (x 2)) 0 ^ 2 + (rotPt (rad x) θ (x 2)) 1 ^ 2) = rad x
      rw [e0, e1, e, Real.sqrt_sq hr0]
    have hunf : thAvgVec (fun x' t' (_ : ℝ × ℝ) => E x' t') x t 0 =
        (2 * Real.pi)⁻¹ • ((∫ θ in (0:ℝ)..(2 * Real.pi), inner ℝ (E (rotPt (rad x) θ (x 2)) t)
            (eR (rotPt (rad x) θ (x 2)))) • eR x +
          (∫ θ in (0:ℝ)..(2 * Real.pi), inner ℝ (E (rotPt (rad x) θ (x 2)) t)
            (eTh (rotPt (rad x) θ (x 2)))) • eTh x +
          (∫ θ in (0:ℝ)..(2 * Real.pi), inner ℝ (E (rotPt (rad x) θ (x 2)) t) eZ) • eZ) := by
      simp only [thAvgVec, cyl2cart, thA, frameAt, ptOf, smul_add, smul_smul]
      rfl
    rw [hunf]
    rcases eq_or_lt_of_le hr0 with hr | hr
    ·
      have hr' : rad x = 0 := hr.symm
      have hsq : x 0 ^ 2 + x 1 ^ 2 ≤ 0 := (Real.sqrt_eq_zero').mp hr'
      have hx0 : x 0 = 0 := by nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]
      have hx1 : x 1 = 0 := by nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]
      have hxr : ∀ φ, rotZ φ x = x := by
        intro φ; ext i; fin_cases i <;> simp [rotZ, hx0, hx1]
      have hP : ∀ θ, rotPt (rad x) θ (x 2) = x := by
        intro θ; ext i; fin_cases i <;> simp [rotPt, hr', hx0, hx1]
      have heR : eR x = 0 := by simp [eR, hr']
      have heTh : eTh x = 0 := by simp [eTh, hr']
      simp only [hP, hxr, heR, heTh, smul_zero, zero_add, intervalIntegral.integral_const]
      set v := E x t with hv
      have hdec : ∀ φ : ℝ, rotZ (-φ) v = Real.cos φ • (v 0 • EuclideanSpace.single 0 1 +
          v 1 • EuclideanSpace.single 1 1)
          + Real.sin φ • (v 1 • EuclideanSpace.single 0 1 - v 0 • EuclideanSpace.single 1 1) + v 2 • eZ := by
        intro φ; ext i; fin_cases i <;> simp [rotZ, eZ, Real.cos_neg, Real.sin_neg] <;> ring
      simp only [hdec]
      rw [intervalIntegral.integral_add, intervalIntegral.integral_add, intervalIntegral.integral_smul_const,
        intervalIntegral.integral_smul_const, intervalIntegral.integral_const, integral_cos, integral_sin]
      · ext i
        fin_cases i <;> simp [eZ, EuclideanSpace.inner_single_right]
      all_goals (apply Continuous.intervalIntegrable; fun_prop)
    ·
      have hnw : ‖(⟨x 0, x 1⟩ : ℂ)‖ = rad x := by
        rw [Complex.norm_def, Complex.normSq_mk, rad]; congr 1; ring
      obtain ⟨θ₀, hθ₀⟩ : ∃ θ₀, θ₀ = Complex.arg ⟨x 0, x 1⟩ := ⟨_, rfl⟩
      have hx0 : x 0 = rad x * Real.cos θ₀ := by
        have := Complex.norm_mul_cos_arg (⟨x 0, x 1⟩ : ℂ)
        rw [hnw, ← hθ₀] at this; exact this.symm
      have hx1 : x 1 = rad x * Real.sin θ₀ := by
        have := Complex.norm_mul_sin_arg (⟨x 0, x 1⟩ : ℂ)
        rw [hnw, ← hθ₀] at this; exact this.symm
      have hrot : ∀ θ, rotPt (rad x) θ (x 2) = rotZ (θ - θ₀) x := by
        intro θ
        ext i; fin_cases i
        · simp [rotPt, rotZ, Real.cos_sub, Real.sin_sub]
          rw [hx0, hx1]
          linear_combination (-(rad x * Real.cos θ)) * Real.sin_sq_add_cos_sq θ₀
        · simp [rotPt, rotZ, Real.cos_sub, Real.sin_sub]
          rw [hx0, hx1]
          linear_combination (-(rad x * Real.sin θ)) * Real.sin_sq_add_cos_sq θ₀
        · simp [rotPt, rotZ]
      have hrne : rad x ≠ 0 := hr.ne'
      have key : ∀ (w : ℝ³) (θ : ℝ),
          inner ℝ w (eR (rotPt (rad x) θ (x 2))) • eR x + inner ℝ w (eTh (rotPt (rad x) θ (x 2))) • eTh x
            + inner ℝ w eZ • eZ = rotZ (-(θ - θ₀)) w := by
        intro w θ
        simp only [eR, eTh, hradrot]
        ext i; fin_cases i
        · simp [radVec, azVec, rotPt, rotZ, eZ, inner_add_right, inner_smul_right, inner_neg_right,
            EuclideanSpace.inner_single_right, Real.cos_sub, Real.sin_sub]
          rw [hx0, hx1]
          field_simp
          ring
        · simp [radVec, azVec, rotPt, rotZ, eZ, inner_add_right, inner_smul_right, inner_neg_right,
            EuclideanSpace.inner_single_right, Real.cos_sub, Real.sin_sub]
          rw [hx0, hx1]
          field_simp
          ring
        · simp [radVec, azVec, rotPt, rotZ, eZ, inner_add_right, inner_smul_right, inner_neg_right,
            EuclideanSpace.inner_single_right]
      have hcE : Continuous (fun θ => E (rotPt (rad x) θ (x 2)) t) := by
        simp_rw [hrot]
        exact hcont.comp (continuous_id.sub continuous_const)
      have heRc : Continuous (fun θ => eR (rotPt (rad x) θ (x 2))) := by
        simp_rw [eR, hradrot]
        unfold radVec rotPt
        fun_prop
      have heThc : Continuous (fun θ => eTh (rotPt (rad x) θ (x 2))) := by
        simp_rw [eTh, hradrot]
        unfold azVec rotPt
        fun_prop
      have hc1 : Continuous (fun θ => inner ℝ (E (rotPt (rad x) θ (x 2)) t)
          (eR (rotPt (rad x) θ (x 2))) • eR x) :=
        Continuous.smul (Continuous.inner (𝕜 := ℝ) hcE heRc) (continuous_const : Continuous fun _ : ℝ => eR x)
      have hc2 : Continuous (fun θ => inner ℝ (E (rotPt (rad x) θ (x 2)) t)
          (eTh (rotPt (rad x) θ (x 2))) • eTh x) :=
        Continuous.smul (Continuous.inner (𝕜 := ℝ) hcE heThc) (continuous_const : Continuous fun _ : ℝ => eTh x)
      have hc3 : Continuous (fun θ => inner ℝ (E (rotPt (rad x) θ (x 2)) t) eZ • eZ) :=
        Continuous.smul (Continuous.inner (𝕜 := ℝ) hcE (continuous_const : Continuous fun _ : ℝ => eZ))
          (continuous_const : Continuous fun _ : ℝ => eZ)
      have hc12 : Continuous (fun θ => inner ℝ (E (rotPt (rad x) θ (x 2)) t)
          (eR (rotPt (rad x) θ (x 2))) • eR x +
          inner ℝ (E (rotPt (rad x) θ (x 2)) t) (eTh (rotPt (rad x) θ (x 2))) • eTh x) := hc1.add hc2
      rw [← intervalIntegral.integral_smul_const, ← intervalIntegral.integral_smul_const,
        ← intervalIntegral.integral_smul_const, ← intervalIntegral.integral_add (hc1.intervalIntegrable _ _)
          (hc2.intervalIntegrable _ _),
        ← intervalIntegral.integral_add (hc12.intervalIntegrable _ _) (hc3.intervalIntegrable _ _)]
      congr 1
      have hH : ∀ θ, inner ℝ (E (rotPt (rad x) θ (x 2)) t) (eR (rotPt (rad x) θ (x 2))) • eR x +
          inner ℝ (E (rotPt (rad x) θ (x 2)) t) (eTh (rotPt (rad x) θ (x 2))) • eTh x +
          inner ℝ (E (rotPt (rad x) θ (x 2)) t) eZ • eZ =
          (fun φ => rotZ (-φ) (E (rotZ φ x) t)) (θ - θ₀) := by
        intro θ
        rw [key]
        simp only [hrot]
      simp only [hH]
      have hper : Function.Periodic (fun φ => rotZ (-φ) (E (rotZ φ x) t)) (2 * Real.pi) := by
        intro φ
        have h1 : rotZ (φ + 2 * Real.pi) = rotZ φ := by
          funext y; simp [rotZ, Real.cos_add_two_pi, Real.sin_add_two_pi]
        have h2 : rotZ (-(φ + 2 * Real.pi)) = rotZ (-φ) := by
          rw [show -(φ + 2 * Real.pi) = -φ - 2 * Real.pi by ring]
          funext y; simp only [rotZ, Real.cos_sub_two_pi, Real.sin_sub_two_pi]
        simp only [h1, h2]
      rw [intervalIntegral.integral_comp_sub_right (fun φ => rotZ (-φ) (E (rotZ φ x) t)) θ₀]
      have := hper.intervalIntegral_add_eq (-θ₀) 0
      rw [show (0:ℝ) - θ₀ = -θ₀ by ring, show 2 * Real.pi - θ₀ = -θ₀ + 2 * Real.pi by ring, this, zero_add]

  have pkg : ∀ (E : ℝ³ → ℝ → ℝ³), ContDiffOn ℝ ∞ (↿E) U →
      (∀ m N : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ U →
        ‖iteratedFDeriv ℝ m (↿E) (x, t)‖ ≤ C * simScale B.h (x 2) (1 - t) ^ (N : ℝ)) →
      ContDiffOn ℝ ∞ (↿(fun y s => thAvgVec (fun x' t' (_ : ℝ × ℝ) => E x' t') y s 0)) U ∧
      ∀ m N : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ U →
        ‖iteratedFDeriv ℝ m (↿(fun y s => thAvgVec (fun x' t' (_ : ℝ × ℝ) => E x' t') y s 0)) (x, t)‖ ≤
          C * simScale B.h (x 2) (1 - t) ^ (N : ℝ) := by
    intro E hE hflat
    set G : ℝ × (ℝ³ × ℝ) → ℝ³ := fun p => rotZ (-p.1) (E (rotZ p.1 p.2.1) p.2.2) with hGdef
    have hG : ContDiffOn ℝ ∞ G (univ ×ˢ U) := by
      have hmaps : MapsTo (fun p : ℝ × (ℝ³ × ℝ) => ((rotZ p.1 p.2.1, p.2.2) : ℝ³ × ℝ)) (univ ×ˢ U) U :=
        fun p hp => hinv p.1 p.2.1 p.2.2 hp.2
      have h4 : ContDiffOn ℝ ∞ (fun p : ℝ × (ℝ³ × ℝ) => E (rotZ p.1 p.2.1) p.2.2) (univ ×ˢ U) :=
        hE.comp t2.contDiffOn hmaps
      have h5 : ContDiffOn ℝ ∞ (fun p : ℝ × (ℝ³ × ℝ) => ((p.1, E (rotZ p.1 p.2.1) p.2.2) : ℝ × ℝ³))
          (univ ×ˢ U) := contDiffOn_fst.prodMk h4
      have h6 := t3.comp_contDiffOn h5
      exact h6
    have hs3 : ∀ (m : ℕ) (φ : ℝ) (w : ℝ³ × ℝ),
        ‖iteratedFDeriv ℝ m (fun w' : ℝ³ × ℝ => G (φ, w')) w‖ =
          ‖iteratedFDeriv ℝ m (↿E) (rotZ φ w.1, w.2)‖ := by
      intro m φ w
      have e : (fun w' : ℝ³ × ℝ => G (φ, w')) = (ρ (-φ)) ∘ ((↿E) ∘ (τ φ)) := by
        funext w'
        simp only [Function.comp, hρ, hτ, hGdef]
        rfl
      rw [e, LinearIsometryEquiv.norm_iteratedFDeriv_comp_left,
        LinearIsometryEquiv.norm_iteratedFDeriv_comp_right, hτ]
    have hcirc : ∀ w ∈ U, Continuous (fun φ : ℝ => E (rotZ φ w.1) w.2) := by
      intro w hw
      have hc0 : Continuous (fun φ : ℝ => rotZ φ w.1) := by
        unfold rotZ; fun_prop
      have hc : Continuous (fun φ : ℝ => ((rotZ φ w.1, w.2) : ℝ³ × ℝ)) :=
        hc0.prodMk continuous_const
      have hres := hE.continuousOn.comp_continuous hc (fun φ => hinv φ w.1 w.2 hw)
      exact hres
    have hAeq : ∀ w ∈ U, (↿(fun y s => thAvgVec (fun x' t' (_ : ℝ × ℝ) => E x' t') y s 0)) w =
        (2 * Real.pi)⁻¹ • ∫ φ in (0:ℝ)..(2 * Real.pi), G (φ, w) := by
      intro w hw
      exact hs2 E w.1 w.2 (hcirc w hw)
    refine ⟨?_, ?_⟩
    · have h1 := (contDiffOn_infty.mpr (fun k => param_nat k G hG)).const_smul ((2 * Real.pi)⁻¹)
      exact h1.congr hAeq
    · intro m N
      obtain ⟨C, hC⟩ := hflat m N
      refine ⟨C, fun x t hxt => ?_⟩
      have hev : (↿(fun y s => thAvgVec (fun x' t' (_ : ℝ × ℝ) => E x' t') y s 0)) =ᶠ[nhds (x, t)]
          (fun w' => (2 * Real.pi)⁻¹ • ∫ φ in (0:ℝ)..(2 * Real.pi), G (φ, w')) := by
        filter_upwards [hUo.mem_nhds hxt] with w hw
        exact hAeq w hw
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
      refine param_bound m G hG (x, t) hxt _ (fun φ => ?_)
      rw [hs3 m φ (x, t)]
      have := hC (rotZ φ x) t (hinv φ x t hxt)
      rw [hrot2] at this
      exact this


  have hbgE : ContDiffOn ℝ ∞ (↿(mriE B)) (simDomain B.h B.qB) := by
    have hBP := hok.2
    unfold BackgroundProps at hBP
    obtain ⟨⟨-, -, hXa, -⟩, -, -, ⟨hAB, hBvB, hPB⟩, -, -, -, -, ⟨hTth, hTz, hvan, -⟩, -, -, -⟩ := hBP
    have hjet : ∀ (ν : ℝ) (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (O : Set (ℝ³ × ℝ)), IsOpen O →
        ContDiffOn ℝ ∞ (↿u) O → ContDiffOn ℝ ∞ (↿p) O → ContDiffOn ℝ ∞ (↿(nsResidual ν u p)) O := by
      intro ν u p O hO hu hp
      have s1 : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (x : ℝ³)
          (t : ℝ), DifferentiableAt ℝ f (x, t) →
          deriv (fun s => f (x, s)) t = fderiv ℝ f (x, t) ((0 : ℝ³), (1 : ℝ)) ∧
          fderiv ℝ (fun y => f (y, t)) x =
            (fderiv ℝ f (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := by
        intro F _ _ f x t hf
        constructor
        · have hγ : HasDerivAt (fun s : ℝ => ((x, s) : ℝ³ × ℝ)) ((0 : ℝ³), (1 : ℝ)) t :=
            (hasDerivAt_const t x).prodMk (hasDerivAt_id t)
          exact (hf.hasFDerivAt.comp_hasDerivAt t hγ).deriv
        · exact (hf.hasFDerivAt.comp x (hasFDerivAt_prodMk_left x t)).fderiv
      have s2 : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (x : ℝ³)
          (t : ℝ), ContDiffOn ℝ ∞ f O → (x, t) ∈ O → ∀ a b : ℝ³,
          fderiv ℝ (fderiv ℝ (fun y => f (y, t))) x a b =
            fderiv ℝ (fderiv ℝ f) (x, t) (a, (0 : ℝ)) (b, (0 : ℝ)) := by
        intro F _ _ f x t hf hxt a b
        have hemb : Continuous (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) :=
          continuous_id.prodMk continuous_const
        have hN : {y : ℝ³ | (y, t) ∈ O} ∈ nhds x := (hO.preimage hemb).mem_nhds hxt
        let Φ : (ℝ³ × ℝ →L[ℝ] F) →L[ℝ] (ℝ³ →L[ℝ] F) :=
