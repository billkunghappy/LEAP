  have hP1 : ∀ w : ℝ, pulsePth5 B G γ ξ 0 + w • dVdir B.h γ.1 = pulsePth5 B G γ ξ w := by
    intro w
    simp only [pulsePth5]
    rw [add_assoc, ← add_smul]
    congr 2
    ring
  have hIccJ : ∀ t ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
      t ∈ Set.Ioo (-(Lsb B.h G.r0 γ.1) / 2) (3 * Lsb B.h G.r0 γ.1 / 2) := by
    intro t ht
