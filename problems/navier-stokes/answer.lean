    · intro x hxa hxb
      have hx0 : 0 < x := lt_of_lt_of_le hr1 hxa
      obtain ⟨hfa, hfb, hfc⟩ := hf0le x hxa hxb
      simp only [repF, hpf, ← hk, hc, hγx, hW0, hW1, hW2]
      have hwi : ∀ i, |w i| ≤ ‖w‖ := fun i => by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm w i
      have hA0 : 0 ≤ 2 * x := by linarith
      have hA1 : 2 * x ≤ 2 * r2 := by linarith
      have hB0 : 0 ≤ 2 * x * f0 x := by positivity
      have hB1 : 2 * x * f0 x ≤ 2 * r2 * f0 r1 := mul_le_mul hA1 hfb hfc.le (by linarith)
      have hC0 : 0 ≤ 2 * f0 x := by linarith
      have hC1 : 2 * f0 x ≤ 2 * f0 r1 := by linarith
