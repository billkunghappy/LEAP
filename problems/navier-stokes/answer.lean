  obtain ⟨hI2d, hI2b⟩ := s1 (fun x e => F x e ^ 2) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) 0 X
    (-1 - r) (1 + r) η (2 * m0 * m1 * iC) hWo hX0 hη1 hη2
    (fun p hp => ⟨show -ε < p.1 by linarith [hp.1.1], hp.2⟩) ((hF.pow 2).congr (fun p _ => rfl))
    (fun y hy0 hyX => (hsq y hy0 (by linarith)).2)
