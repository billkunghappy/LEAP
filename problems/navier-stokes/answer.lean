    convert H using 1
    all_goals (try funext e)
    all_goals (try simp only [Pi.add_apply, Pi.mul_apply, Pi.pow_apply, Pi.sub_apply, id])
    all_goals ring
  have hd2 : HasDerivAt (fun e => e ^ 2 * K2 + ((1 + e ^ 2)⁻¹) ^ 2 *
