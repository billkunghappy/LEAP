    rw [h3]
    have hle : Real.exp 1 ≤ 2.7182818286 := hd.le
    have hm1 : Real.exp 1 * Real.exp 1 ≤ 2.7182818286 * 2.7182818286 :=
      mul_le_mul hle hle hepos.le (by norm_num)
    have hm2 : Real.exp 1 * Real.exp 1 * Real.exp 1 ≤ 2.7182818286 * 2.7182818286 * 2.7182818286 :=
      mul_le_mul hm1 hle hepos.le (by norm_num)
    have : (2.7182818286 : ℝ) * 2.7182818286 * 2.7182818286 < 21 := by norm_num
    linarith

