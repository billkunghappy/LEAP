  refine ⟨la + lb + lc + ld + le' + lf + lg + lh + m2 + m3 + m4 + m5 + m6 + m6' + m7 + m8, ?_⟩
  intro l0 hl0 S bw ca H hbw hbwH hH9 hH1 hca32 hSt

  have hk : kapS = 1 / 100000 := rfl
