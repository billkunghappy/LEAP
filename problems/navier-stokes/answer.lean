theorem slowjet_vderiv_comm_v5 : ∀ (U : Set (ℝ × ℝ × ℝ)) (g : (ℝ × ℝ × ℝ) × ℝ → (Fin 3 → ℝ)) (s0 : ℝ × ℝ × ℝ) (j : ℕ) (v : ℝ), IsOpen U → s0 ∈ U → ContDiffOn ℝ ∞ g (U ×ˢ Set.univ) → HasDerivAt (fun v' => iteratedFDeriv ℝ j (fun s => g (s, v')) s0) (iteratedFDeriv ℝ j (fun s => deriv (fun v'' => g (s, v'')) v) s0) v :=
by
