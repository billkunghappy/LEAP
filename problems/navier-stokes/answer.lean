  obtain ⟨t6, ht6⟩ : ∃ f : Cyl → ℝ, f = fun ξ => lap0 B.h (mcor5 B G l0 S 0) ξ -
      mcor5 B G l0 S 0 ξ / ξ.1 ^ 2 := ⟨_, rfl⟩
  have hT6 : InM B (qsOf l0) (4/5) (nrm B (2 * Aex B.h + 1/2) t6) := by
    have d0 := h3 l0 hl3 (mcor5 B G l0 S 0) _ _ hβ
