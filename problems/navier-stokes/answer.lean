  obtain ⟨hΦs, hΦd⟩ := hEP (rfpY4 P.Md P.lam) (rfpY4 P.Md P.lam + 60) W Θ hWc hΘc
  have hpoly : ContDiff ℝ ∞ (fun η : ℝ => 1 + η ^ 2) := by fun_prop
