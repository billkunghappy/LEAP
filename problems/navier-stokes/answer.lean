      rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.inl_apply, one_mul]
      have en : ‖((a, 0) : (ℝ × ℝ × ℝ) × ℝ)‖ = ‖a‖ := by simp [Prod.norm_def]
      calc ‖R (a, 0)‖ ≤ ‖R‖ * ‖((a, 0) : (ℝ × ℝ × ℝ) × ℝ)‖ := R.le_opNorm _
        _ ≤ 1 * ‖((a, 0) : (ℝ × ℝ × ℝ) × ℝ)‖ := mul_le_mul_of_nonneg_right hR1 (norm_nonneg _)
        _ = ‖a‖ := by rw [one_mul, en]
    have hTR' : ∀ a : ℝ × ℝ × ℝ, (Lι.comp (ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ))
        (((Real.sqrt (qC B.h ξ) • ContinuousLinearMap.id ℝ ℝ).prodMap
          ((qC B.h ξ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
            (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ))) a) =
        Lnorm B.h ξ ((R.comp (ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ)) a) := by
      intro a
