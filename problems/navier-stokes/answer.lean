    nlinarith [mul_le_mul hlt2.le hlt2.le hl0' (by linarith : (0:ℝ) ≤ 2 * (1 + a'))]
  have hκpos : 0 < Qb γ.1 ^ (-B.h) := Real.rpow_pos_of_pos hQ _
  have hκq : Qb γ.1 ^ (-B.h) * qC B.h ξ ^ B.h ≤ 4 := by
    rw [Real.rpow_neg hQ.le, inv_mul_eq_div, ← Real.div_rpow hq0.le hQ.le]
    have h1 : (qC B.h ξ / Qb γ.1) ^ B.h ≤ (4:ℝ) ^ B.h :=
      Real.rpow_le_rpow (div_nonneg hq0.le hQ.le) hq2.le hh0.le
    have h2 : (4:ℝ) ^ B.h ≤ (4:ℝ) ^ (1:ℝ) :=
