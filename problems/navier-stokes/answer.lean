      have k1 : (n 1 - Bs * -N2) ^ 2 * x 1 ^ 2 ≤ δ ^ 2 * x 1 ^ 2 :=
        mul_le_mul_of_nonneg_right q1 (sq_nonneg _)
      have k2 : (n 2 - Bs * N1) ^ 2 * x 2 ^ 2 ≤ δ ^ 2 * x 2 ^ 2 :=
        mul_le_mul_of_nonneg_right q2 (sq_nonneg _)
      have k3 : δ ^ 2 * X = δ ^ 2 * x 0 ^ 2 + δ ^ 2 * x 1 ^ 2 + δ ^ 2 * x 2 ^ 2 := by
        rw [hX]; ring
      linarith
    have hBc : (Bs * c) ^ 2 ≤ 2 * g ^ 2 + 2 * E ^ 2 := by
      rw [hgE]; nlinarith [sq_nonneg (g + E)]
    have hc2 : c ^ 2 ≤ 2 * M ^ 2 * g ^ 2 + X / 2 := by
      have h1 : 1 ≤ (Bs * M) ^ 2 := one_le_pow₀ hB1'
      have h2 : c ^ 2 ≤ (Bs * M) ^ 2 * c ^ 2 := le_mul_of_one_le_left (sq_nonneg c) h1
