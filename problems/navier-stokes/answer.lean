theorem pp_leadPi_pair : ∀ (F F' : ℝ → ℝ → ℝ) (ε x M A ε' : ℝ), 0 < ε → 0 < x → ContDiffOn ℝ ∞ (↿F) (Ioi (-ε) ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿F') (Ioi (-ε) ×ˢ Ioo (-1) 1) → (∀ η : ℝ, -1 < η → η < 1 → IntegrableOn (fun y => F y η ^ 2) (Ioi 0) ∧ IntegrableOn (fun y => F' y η ^ 2) (Ioi 0) ∧ leadPi F' 0 η = leadPi F 0 η ∧ |leadPi F 0 η| ≤ M ∧ |deriv (fun e => leadPi F 0 e) η| ≤ M) → (∀ η : ℝ, -1 < η → η < 1 → |profRadInt (fun y e => F y e ^ 2) x η| ≤ A ∧ |profEtaD (profRadInt (fun y e => F y e ^ 2)) x η| ≤ A ∧ |profRadInt (fun y e => F' y e ^ 2) x η - profRadInt (fun y e => F y e ^ 2) x η| ≤ ε' ∧ |profEtaD (profRadInt (fun y e => F' y e ^ 2)) x η - profEtaD (profRadInt (fun y e => F y e ^ 2)) x η| ≤ ε') → ∀ η : ℝ, -1 < η → η < 1 → |leadPi F x η| ≤ M + A ∧ |profEtaD (leadPi F) x η| ≤ M + A ∧ |leadPi F' x η - leadPi F x η| ≤ ε' ∧ |profEtaD (leadPi F') x η - profEtaD (leadPi F) x η| ≤ ε' :=
