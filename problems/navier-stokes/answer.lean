    fun c c' e f hf hc => hlin c c c' e 1 0 f f f hf hf hc hc (fun ξ _ => by ring)
  have hmul : ∀ (c1 c2 : ℝ) (f g : Cyl → ℝ), InM B (qsOf l0) c1 (nrm B (Aex B.h) f) →
