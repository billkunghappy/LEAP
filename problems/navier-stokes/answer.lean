  have hCne : (C : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hCpos.ne'

  have hE : ∀ w ∈ axRect r, ‖Complex.exp ((Λ : ℂ) * Ξ w)‖ ≤ Real.exp (Λ * M) := by
    intro w hw
