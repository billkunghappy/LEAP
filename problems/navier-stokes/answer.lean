    have X0 := norm_nonneg (cf ((Tv ((1:ℝ), ((0:ℝ), (0:ℝ))))^[j] G) s)
    have h00 := bd 0 0 (Nat.zero_le _) (Nat.zero_le _)
    have h10 := bd P 0 le_rfl (Nat.zero_le _)
    have h01 := bd 0 P (Nat.zero_le _) le_rfl
    have h11 := bd P P le_rfl le_rfl
    simp only [pow_zero, one_mul] at h00 h10 h01
    exact arith _ _ _ (2 * Real.pi) X0 (abs_nonneg _) (abs_nonneg _)
