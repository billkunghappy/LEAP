    apply intervalIntegral.integral_pos (by linarith) hcont.continuousOn
    · intro x _; positivity
    · refine ⟨0, ⟨by linarith, by linarith⟩, ?_⟩
      rw [h00]; norm_num
  have sD : ∫ u in (-r0)..r0, chig r0 u ^ 2 ≤ 2 * r0 := by
    have hm := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) (g := fun _ => (1:ℝ))
      (by linarith : -r0 ≤ r0)
      (hcont.intervalIntegrable _ _) (continuous_const.intervalIntegrable _ _)
      (fun u _ => pow_le_one₀ (hnn u) (hle1 u))
    rw [intervalIntegral.integral_const, smul_eq_mul] at hm
    linarith
  exact ⟨sA, sB, sC, sD⟩

theorem pulse_line_rect5 : ∀ (h r0 : ℝ) (γ : Lab) (c Y : ℝ × ℝ), 0 < r0 → r0 ≤ 1/100 → inRect h γ c r0 Y → ∀ v : ℝ, 0 ≤ v → v ≤ Lsb h r0 γ.1 → vco h r0 γ c (Y + (v - vco h r0 γ c Y) • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) = v ∧ inRect h γ c r0 (Y + (v - vco h r0 γ c Y) • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)) ∧ ∃ k : ℝ × ℝ, ∀ᶠ Y' in nhds (Y + (v - vco h r0 γ c Y) • ((cib h γ.1 * Tgc ^ (-(bandIdx h γ.1))) • vtv)), rectW h γ c Y' = Jpow (bandIdx h γ.1) Y' - c - k :=
by
  intro h r0 γ c Y hr0 hr1 hR v hv0 hvL
  have hsq : (1:ℝ) < Real.sqrt 2 := Real.one_lt_sqrt_two
  have hs2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hb0 : 0 ≤ bgc := by unfold bgc; linarith
  have hb1 : bgc ≤ 1 := by unfold bgc; nlinarith [Real.sqrt_nonneg 2]
