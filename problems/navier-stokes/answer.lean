      (hM.snd.mul hTl.fst).sub (hM.fst.mul hTl.snd)
    refine ((hnum.mono hS).div (hA.mono hS) hden).congr (fun ξ _ => ?_)
    simp only [yAmp4, if_pos hb] <;> rfl
  · have hnum : ContDiffOn ℝ ∞ (fun ξ : Cyl =>
        (Hcol B G (γ.1, γ.2.1, true) (ξ.1, ξ.2.1, ξ.2.2.1)).1 * (T0star4 B γ.1 ξ).2 -
        (Hcol B G (γ.1, γ.2.1, true) (ξ.1, ξ.2.1, ξ.2.2.1)).2 * (T0star4 B γ.1 ξ).1) (DomC B.h B.qB) :=
      (hP.fst.mul hTl.snd).sub (hP.snd.mul hTl.fst)
    refine ((hnum.mono hS).div (hA.mono hS) hden).congr (fun ξ _ => ?_)
    simp only [yAmp4, if_neg hb] <;> rfl

theorem sqrt_amp_bound_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (lN : ℕ) (c : ℝ), 0 < c → PrimNondegAt4 B G lN c → (∀ γ : Lab, ContDiffOn ℝ ∞ (hDetC B G γ) (DomC B.h B.qB) ∧ ContDiffOn ℝ ∞ (yAmp4 B G γ) {ξ : Cyl | ξ ∈ DomC B.h B.qB ∧ hDetC B G γ ξ ≠ 0}) → (∀ (γ : Lab) (ξ : Cyl), lN ≤ γ.1 → ActiveL4 B G γ → etaL B.h γ ξ ≠ 0 → ξ ∈ DomC B.h B.qB → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ContDiffAt ℝ ∞ (fun η : Cyl => Real.sqrt (max (yAmp4 B G γ η) 0)) ξ) ∧ ∀ k : ℕ, ∃ C b d : ℝ, ∀ (γ : Lab) (ξ : Cyl), lN ≤ γ.1 → ActiveL4 B G γ → etaL B.h γ ξ ≠ 0 → ξ ∈ DomC B.h B.qB → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → NB B.h (fun η : Cyl => Real.sqrt (max (yAmp4 B G γ η) 0)) k ξ ≤ C * SC B.h ξ ^ b * Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) :=
by
  intro B G hok hG lN c hc hND hsm
  have hS := hok.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1

  have key : ∀ {E G' : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G']
      [NormedSpace ℝ G'] (F : E → G') (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G' _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  have scal : ∀ (c Cu S e b d z a K : ℝ) (k : ℕ), 0 < c → 0 ≤ Cu → 1 ≤ S → 0 < e → e ≤ 1 →
      0 ≤ b → 0 ≤ d → 0 ≤ z → 0 ≤ K → a ≤ Cu * S ^ b * z * e ^ (-d) →
      Real.sqrt a * (K * (1 + Cu / c * (S ^ b * e ^ (-d))) ^ k) ≤
        K * (1 + Cu / c) ^ k * (1 + Cu) * S ^ (((k:ℝ) + 1) * b) * Real.sqrt z *
          e ^ (-(((k:ℝ) + 1) * d)) := by
    intro c Cu S e b d z a K k hc hCu hS he0 he1 hb hd hz hK ha
    have hSb : 1 ≤ S ^ b := Real.one_le_rpow hS hb
    have hed : 1 ≤ e ^ (-d) := Real.one_le_rpow_of_pos_of_le_one_of_nonpos he0 he1 (by linarith)
    obtain ⟨W, hW⟩ : ∃ W, W = S ^ b * e ^ (-d) := ⟨_, rfl⟩
    have hW1 : 1 ≤ W := by rw [hW]; exact one_le_mul_of_one_le_of_one_le hSb hed
    have hW0 : 0 ≤ W := by linarith
    have hCc : 0 ≤ Cu / c := div_nonneg hCu hc.le
    have hCW : 0 ≤ Cu / c * W := mul_nonneg hCc hW0
    have hD0 : 0 ≤ 1 + Cu / c * W := by linarith
    have hDle : 1 + Cu / c * W ≤ (1 + Cu / c) * W := by nlinarith
    have hDk : (1 + Cu / c * W) ^ k ≤ ((1 + Cu / c) * W) ^ k := pow_le_pow_left₀ hD0 hDle k
    have hX1 : 1 ≤ (1 + Cu) * W := by nlinarith
    have ha1 : a ≤ Cu * W * z := by
      calc a ≤ Cu * S ^ b * z * e ^ (-d) := ha
        _ = Cu * W * z := by rw [hW]; ring
    have ha2 : Cu * W ≤ ((1 + Cu) * W) ^ 2 := by nlinarith
    have ha' : a ≤ ((1 + Cu) * W) ^ 2 * z := ha1.trans (mul_le_mul_of_nonneg_right ha2 hz)
    have hsa : Real.sqrt a ≤ (1 + Cu) * W * Real.sqrt z := by
      calc Real.sqrt a ≤ Real.sqrt (((1 + Cu) * W) ^ 2 * z) := Real.sqrt_le_sqrt ha'
        _ = (1 + Cu) * W * Real.sqrt z := by
          rw [Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (by linarith)]
    have hp1 : (S ^ b) ^ (k + 1) = S ^ (((k:ℝ) + 1) * b) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by linarith)]
      congr 1
      push_cast
      ring
    have hp2 : (e ^ (-d)) ^ (k + 1) = e ^ (-(((k:ℝ) + 1) * d)) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul he0.le]
      congr 1
      push_cast
      ring
    rw [← hW]
    calc Real.sqrt a * (K * (1 + Cu / c * W) ^ k)
        ≤ ((1 + Cu) * W * Real.sqrt z) * (K * ((1 + Cu / c) * W) ^ k) :=
          mul_le_mul hsa (mul_le_mul_of_nonneg_left hDk hK) (mul_nonneg hK (pow_nonneg hD0 k))
            (mul_nonneg (by linarith) (Real.sqrt_nonneg _))
      _ = K * (1 + Cu / c) ^ k * (1 + Cu) * (S ^ b) ^ (k + 1) * Real.sqrt z * (e ^ (-d)) ^ (k + 1) := by
          rw [mul_pow, hW, mul_pow]; ring
      _ = _ := by rw [hp1, hp2]

  have hDomOpen : IsOpen (DomC B.h B.qB) := by
    have hU : IsOpen {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} :=
      (isOpen_lt continuous_const continuous_fst).inter
        (isOpen_lt (continuous_fst.comp (continuous_snd.comp continuous_snd)) continuous_const)
    have hcq : ContinuousOn (qC B.h) {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} := by
      have h1 := hS.2.2.2.1.continuousOn
      have h2 : Continuous (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) := by fun_prop
      refine h1.comp h2.continuousOn ?_
      intro ξ hξ
      exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by
        linarith [(show 0 < ξ.1 ∧ ξ.2.2.1 < 1 from hξ).2]⟩
    have := hcq.isOpen_inter_preimage hU (isOpen_Iio (a := B.qB))
    convert this using 1
    ext ξ
    simp only [DomC, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iio]
    tauto

  have hloc : ∀ (γ : Lab) (ξ : Cyl), lN ≤ γ.1 → ActiveL4 B G γ → etaL B.h γ ξ ≠ 0 →
      ξ ∈ DomC B.h B.qB → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      ∃ U : Set Cyl, IsOpen U ∧ ξ ∈ U ∧ ContDiffOn ℝ ∞ (yAmp4 B G γ) U ∧
        (∀ η ∈ U, 0 < yAmp4 B G γ η) ∧
        ContDiffOn ℝ ∞ (fun η : Cyl => Real.sqrt (max (yAmp4 B G γ η) 0)) U := by
    intro γ ξ hl hAct heta hξ hX1 hX2
    obtain ⟨hDsm, hysm⟩ := hsm γ
    obtain ⟨C0, b0, d0, h0⟩ := hND 0
    have hz : 0 < edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
      unfold edgeWeight; rw [if_pos ⟨hX1, hX2⟩]; exact Real.exp_pos _
    have ha : 0 < yAmp4 B G γ ξ :=
      lt_of_lt_of_le (mul_pos hc hz) (h0 γ ξ hl hAct heta hξ hX1 hX2).2.1
    have hdet : hDetC B G γ ξ ≠ 0 := by
      intro hd
      have hd' := hd
      unfold hDetC at hd'
      have hy0 : yAmp4 B G γ ξ = 0 := by
        first
          | simp only [yAmp4, hd', div_zero, ite_self]
          | (unfold yAmp4; dsimp only; rw [hd']; split_ifs <;> simp)
      linarith
    obtain ⟨O, hOd⟩ : ∃ O : Set Cyl, O = {η : Cyl | η ∈ DomC B.h B.qB ∧ hDetC B G γ η ≠ 0} :=
      ⟨_, rfl⟩
    have hOo : IsOpen O := by
      have := hDsm.continuousOn.isOpen_inter_preimage hDomOpen (isOpen_compl_singleton (x := (0:ℝ)))
      rw [hOd]; exact this
    have hyO : ContDiffOn ℝ ∞ (yAmp4 B G γ) O := by rw [hOd]; exact hysm
    have hUo : IsOpen (O ∩ yAmp4 B G γ ⁻¹' Set.Ioi 0) :=
      hyO.continuousOn.isOpen_inter_preimage hOo isOpen_Ioi
    have hyU : ContDiffOn ℝ ∞ (yAmp4 B G γ) (O ∩ yAmp4 B G γ ⁻¹' Set.Ioi 0) :=
      hyO.mono Set.inter_subset_left
    have hpos : ∀ η ∈ O ∩ yAmp4 B G γ ⁻¹' Set.Ioi 0, 0 < yAmp4 B G γ η := fun η hη => hη.2
    refine ⟨O ∩ yAmp4 B G γ ⁻¹' Set.Ioi 0, hUo, ⟨by rw [hOd]; exact ⟨hξ, hdet⟩, ha⟩, hyU, hpos, ?_⟩
    exact (hyU.sqrt (fun η hη => (hpos η hη).ne')).congr
      (fun η hη => by rw [max_eq_left (hpos η hη).le])
  refine ⟨fun γ ξ hl hAct heta hξ hX1 hX2 => ?_, fun k => ?_⟩
  · obtain ⟨U, hUo, hξU, -, -, hAU⟩ := hloc γ ξ hl hAct heta hξ hX1 hX2
    exact hAU.contDiffAt (hUo.mem_nhds hξU)
  · have hND' := hND
    unfold PrimNondegAt4 at hND'
    choose Cf bf df hf using hND'
    obtain ⟨Cu, hCud⟩ : ∃ Cu : ℝ, Cu = ∑ j ∈ Finset.range (k + 1), |Cf j| := ⟨_, rfl⟩
    obtain ⟨bu, hbud⟩ : ∃ bu : ℝ, bu = ∑ j ∈ Finset.range (k + 1), |bf j| := ⟨_, rfl⟩
    obtain ⟨du, hdud⟩ : ∃ du : ℝ, du = ∑ j ∈ Finset.range (k + 1), |df j| := ⟨_, rfl⟩
    obtain ⟨Cg, hCgd⟩ : ∃ Cg : ℝ,
        Cg = ∑ i ∈ Finset.range (k + 1), |Polynomial.eval (1/2:ℝ) (descPochhammer ℝ i)| := ⟨_, rfl⟩
    have hCu0 : 0 ≤ Cu := by rw [hCud]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
    have hbu0 : 0 ≤ bu := by rw [hbud]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
    have hdu0 : 0 ≤ du := by rw [hdud]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
    have hCg0 : 0 ≤ Cg := by rw [hCgd]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
    have hsum : ∀ (f : ℕ → ℝ) (i : ℕ), i ≤ k → f i ≤ ∑ j ∈ Finset.range (k + 1), |f j| :=
      fun f i hi => (le_abs_self _).trans (Finset.single_le_sum (f := fun j => |f j|)
        (fun j _ => abs_nonneg _) (Finset.mem_range.mpr (by omega)))
    refine ⟨(k.factorial : ℝ) * Cg * (1 + Cu / c) ^ k * (1 + Cu), ((k:ℝ) + 1) * bu,
      ((k:ℝ) + 1) * du, ?_⟩
    intro γ ξ hl hAct heta hξ hX1 hX2
    obtain ⟨U, hUo, hξU, hyU, hpos, hAU⟩ := hloc γ ξ hl hAct heta hξ hX1 hX2
    have hz : 0 < edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
      unfold edgeWeight; rw [if_pos ⟨hX1, hX2⟩]; exact Real.exp_pos _
    have hed0 : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) := by
      have hX0 : 0 < XC B.h ξ := lt_trans hXa hX1
      unfold edgeDist
      exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
        (Real.log_pos ((one_lt_div hX0).mpr hX2)))
    have hed1 : edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := min_le_left _ _
    have hSC1 : 1 ≤ SC B.h ξ := by
      unfold SC; exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h ξ))])
    have hNBi : ∀ i, i ≤ k → NB B.h (yAmp4 B G γ) i ξ ≤
        Cu * SC B.h ξ ^ bu * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
          edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-du) := by
      intro i hi
      refine ((hf i γ ξ hl hAct heta hξ hX1 hX2).2.2.1).trans ?_
      have e1 : Cf i * SC B.h ξ ^ bf i ≤ Cu * SC B.h ξ ^ bu :=
        mul_le_mul (by rw [hCud]; exact hsum Cf i hi)
          (Real.rpow_le_rpow_of_exponent_le hSC1 (by rw [hbud]; exact hsum bf i hi))
          (Real.rpow_nonneg (by linarith) _) hCu0
      have e3 : df i ≤ du := by rw [hdud]; exact hsum df i hi
      exact mul_le_mul (mul_le_mul_of_nonneg_right e1 hz.le)
        (Real.rpow_le_rpow_of_exponent_ge hed0 hed1 (by linarith))
        (Real.rpow_nonneg hed0.le _)
        (mul_nonneg (mul_nonneg hCu0 (Real.rpow_nonneg (by linarith) _)) hz.le)
    obtain ⟨a, had⟩ : ∃ a : ℝ, a = yAmp4 B G γ ξ := ⟨_, rfl⟩
    have ha : 0 < a := by rw [had]; exact hpos ξ hξU
    have hca : c * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) ≤ a := by
      rw [had]; exact (hf 0 γ ξ hl hAct heta hξ hX1 hX2).2.1

    obtain ⟨O', hO'd⟩ : ∃ O' : Set Cyl, O' = (fun v : Cyl => ξ + Lnorm B.h ξ v) ⁻¹' U := ⟨_, rfl⟩
    have hO'm : ∀ v, v ∈ O' ↔ ξ + Lnorm B.h ξ v ∈ U := by intro v; rw [hO'd]; rfl
    have hO' : IsOpen O' := by
      rw [hO'd]; exact hUo.preimage (continuous_const.add (Lnorm B.h ξ).continuous)
    have h0O' : (0:Cyl) ∈ O' := by rw [hO'm, map_zero, add_zero]; exact hξU
    have hfO : ContDiffOn ℝ ∞ (fun v : Cyl => yAmp4 B G γ (ξ + Lnorm B.h ξ v)) O' :=
      hyU.comp (contDiff_const.add (Lnorm B.h ξ).contDiff).contDiffOn (fun v hv => (hO'm v).1 hv)
    have hf0 : ContDiffAt ℝ ∞ (fun v : Cyl => yAmp4 B G γ (ξ + Lnorm B.h ξ v)) 0 :=
      hfO.contDiffAt (hO'.mem_nhds h0O')
    have haM : a ≤ Cu * SC B.h ξ ^ bu * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-du) := by
      refine le_trans ?_ (hNBi 0 (Nat.zero_le _))
      unfold NB
      rw [← key (yAmp4 B G γ) U ξ (Lnorm B.h ξ) hUo hyU hξU 0, norm_iteratedFDeriv_zero]
      show a ≤ ‖yAmp4 B G γ (ξ + Lnorm B.h ξ 0)‖
      rw [map_zero, add_zero, Real.norm_eq_abs, ← had]
      exact le_abs_self _

    obtain ⟨W, hWd⟩ : ∃ W : ℝ, W = SC B.h ξ ^ bu * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-du) :=
      ⟨_, rfl⟩
    have hW1 : 1 ≤ W := by
      rw [hWd]
      exact one_le_mul_of_one_le_of_one_le (Real.one_le_rpow hSC1 hbu0)
        (Real.one_le_rpow_of_pos_of_le_one_of_nonpos hed0 hed1 (by linarith))
    obtain ⟨D, hDd⟩ : ∃ D : ℝ, D = 1 + Cu / c * W := ⟨_, rfl⟩
    have hCc : 0 ≤ Cu / c := div_nonneg hCu0 hc.le
    have hCW : 0 ≤ Cu / c * W := mul_nonneg hCc (by linarith)
    have hD1 : 1 ≤ D := by rw [hDd]; linarith
    have hcc : c * (Cu / c) = Cu := by field_simp
    have hNBD : ∀ i, 1 ≤ i → i ≤ k → NB B.h (yAmp4 B G γ) i ξ ≤ a * D ^ i := by
      intro i hi1 hik
      have hM : Cu * SC B.h ξ ^ bu * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
          edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-du) =
          (c * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * (Cu / c * W) := by
        rw [hWd]
        linear_combination (-(edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
          (SC B.h ξ ^ bu * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-du)))) * hcc
      calc NB B.h (yAmp4 B G γ) i ξ
          ≤ Cu * SC B.h ξ ^ bu * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
              edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-du) := hNBi i hik
        _ = (c * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * (Cu / c * W) := hM
        _ ≤ a * D := mul_le_mul hca (by rw [hDd]; linarith) hCW ha.le
        _ ≤ a * D ^ i := mul_le_mul_of_nonneg_left (le_self_pow₀ hD1 (by omega)) ha.le

    obtain ⟨ψ, hψd⟩ : ∃ ψ : Cyl → ℝ, ψ = fun v => a⁻¹ * yAmp4 B G γ (ξ + Lnorm B.h ξ v) :=
      ⟨_, rfl⟩
    have hψv : ∀ v, ψ v = a⁻¹ * yAmp4 B G γ (ξ + Lnorm B.h ξ v) := by intro v; rw [hψd]
    have hψ : ContDiffOn ℝ ∞ ψ O' := by rw [hψd]; exact contDiffOn_const.mul hfO
    have hψpos : ∀ v ∈ O', 0 < ψ v := fun v hv => by
      rw [hψv]; exact mul_pos (inv_pos.mpr ha) (hpos _ ((hO'm v).1 hv))
    have hψ0 : ψ 0 = 1 := by
      rw [hψv, map_zero, add_zero, ← had]; exact inv_mul_cancel₀ ha.ne'
    have hψeq : ψ = a⁻¹ • (fun v : Cyl => yAmp4 B G γ (ξ + Lnorm B.h ξ v)) := by
      funext v; rw [hψv]; rfl
    have hDψ : ∀ i : ℕ, 1 ≤ i → i ≤ k → ‖iteratedFDerivWithin ℝ i ψ O' 0‖ ≤ D ^ i := by
      intro i hi1 hik
      rw [iteratedFDerivWithin_of_isOpen i hO' h0O', hψeq,
        iteratedFDeriv_const_smul_apply (hf0.of_le (by exact_mod_cast le_top)),
        key (yAmp4 B G γ) U ξ (Lnorm B.h ξ) hUo hyU hξU i, norm_smul,
        Real.norm_of_nonneg (inv_nonneg.mpr ha.le)]
      calc a⁻¹ * ‖(iteratedFDeriv ℝ i (yAmp4 B G γ) ξ).compContinuousLinearMap
            (fun _ => Lnorm B.h ξ)‖
          ≤ a⁻¹ * (a * D ^ i) := mul_le_mul_of_nonneg_left (hNBD i hi1 hik) (inv_nonneg.mpr ha.le)
        _ = D ^ i := inv_mul_cancel_left₀ ha.ne' _

    have hg : ContDiffOn ℝ ∞ (fun x : ℝ => x ^ (1/2:ℝ)) (Set.Ioi 0) :=
      (contDiffOn_id (s := Set.Ioi (0:ℝ))).rpow_const_of_ne (fun x hx => ne_of_gt hx)
    have hψmaps : Set.MapsTo ψ O' (Set.Ioi 0) := fun v hv => hψpos v hv
    have hCg : ∀ i ≤ k, ‖iteratedFDerivWithin ℝ i (fun x : ℝ => x ^ (1/2:ℝ)) (Set.Ioi 0) (ψ 0)‖ ≤ Cg := by
      intro i hi
      rw [hψ0, iteratedFDerivWithin_of_isOpen i isOpen_Ioi (Set.mem_Ioi.mpr (zero_lt_one' ℝ)),
        norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
        Real.iter_deriv_rpow_const, Real.one_rpow, mul_one, Real.norm_eq_abs, hCgd]
      exact Finset.single_le_sum (f := fun i => |Polynomial.eval (1/2:ℝ) (descPochhammer ℝ i)|)
        (fun i _ => abs_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    have hFdB := norm_iteratedFDerivWithin_comp_le hg hψ (by exact_mod_cast le_top)
      isOpen_Ioi.uniqueDiffOn hO'.uniqueDiffOn hψmaps h0O' (C := Cg) (D := D) hCg hDψ

    obtain ⟨A, hAd⟩ : ∃ A : Cyl → ℝ, A = fun η => Real.sqrt (max (yAmp4 B G γ η) 0) := ⟨_, rfl⟩
    have hAv : ∀ η, A η = Real.sqrt (max (yAmp4 B G γ η) 0) := by intro η; rw [hAd]
    have hAU' : ContDiffOn ℝ ∞ A U := by rw [hAd]; exact hAU
    suffices hmain : NB B.h A k ξ ≤ Real.sqrt a * ((k.factorial : ℝ) * Cg * D ^ k) by
      rw [hAd] at hmain
      refine hmain.trans ?_
      rw [hDd, hWd]
      exact scal c Cu (SC B.h ξ) (edgeDist B.Xa B.Xb (XC B.h ξ)) bu du
        (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) a ((k.factorial : ℝ) * Cg) k hc hCu0 hSC1
        hed0 hed1 hbu0 hdu0 hz.le (mul_nonneg (Nat.cast_nonneg _) hCg0) haM
    obtain ⟨gl, hgld⟩ : ∃ gl : ℝ →L[ℝ] ℝ, gl = Real.sqrt a • ContinuousLinearMap.id ℝ ℝ :=
      ⟨_, rfl⟩
    have hglx : ∀ x, gl x = Real.sqrt a * x := by intro x; rw [hgld]; rfl
    have hgl : ‖gl‖ ≤ Real.sqrt a :=
      ContinuousLinearMap.opNorm_le_bound _ (Real.sqrt_nonneg _) (fun x => by
        rw [hglx, norm_mul, Real.norm_of_nonneg (Real.sqrt_nonneg _)])
    have hEq : Set.EqOn (fun z => A (ξ + Lnorm B.h ξ z))
        (⇑gl ∘ ((fun x : ℝ => x ^ (1/2:ℝ)) ∘ ψ)) O' := by
      intro v hv
      have hp := hpos _ ((hO'm v).1 hv)
      show A (ξ + Lnorm B.h ξ v) = gl (ψ v ^ (1/2:ℝ))
      rw [hAv, hψv, hglx, max_eq_left hp.le, ← Real.sqrt_eq_rpow, ← Real.sqrt_mul ha.le,
        mul_inv_cancel_left₀ ha.ne']
    have hgψ : ContDiffOn ℝ ∞ ((fun x : ℝ => x ^ (1/2:ℝ)) ∘ ψ) O' := hg.comp hψ hψmaps
    calc NB B.h A k ξ = ‖iteratedFDeriv ℝ k (fun z => A (ξ + Lnorm B.h ξ z)) 0‖ := by
          unfold NB; rw [key A U ξ (Lnorm B.h ξ) hUo hAU' hξU k]
      _ = ‖iteratedFDerivWithin ℝ k (fun z => A (ξ + Lnorm B.h ξ z)) O' 0‖ := by
          rw [iteratedFDerivWithin_of_isOpen k hO' h0O']
      _ = ‖iteratedFDerivWithin ℝ k (⇑gl ∘ ((fun x : ℝ => x ^ (1/2:ℝ)) ∘ ψ)) O' 0‖ := by
          rw [iteratedFDerivWithin_congr hEq h0O' k]
      _ = ‖gl.compContinuousMultilinearMap
            (iteratedFDerivWithin ℝ k ((fun x : ℝ => x ^ (1/2:ℝ)) ∘ ψ) O' 0)‖ := by
          rw [ContinuousLinearMap.iteratedFDerivWithin_comp_left gl (hgψ.contDiffWithinAt h0O')
            hO'.uniqueDiffOn h0O' (i := k) (by exact_mod_cast le_top)]
      _ ≤ ‖gl‖ * ‖iteratedFDerivWithin ℝ k ((fun x : ℝ => x ^ (1/2:ℝ)) ∘ ψ) O' 0‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ Real.sqrt a * ((k.factorial : ℝ) * Cg * D ^ k) :=
          mul_le_mul hgl hFdB (norm_nonneg _) (Real.sqrt_nonneg _)

theorem w0c4_support_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (γ : Lab), ∀ ξ ∈ DomC B.h B.qB, (ActiveL4 B G γ → W0c4 B G γ ξ = (Real.sqrt (epsb B.h γ.1) / 2 * etaL B.h γ ξ * Real.sqrt (max (yAmp4 B G γ ξ) 0)) • ((chig G.r0 (xiG B.h γ (G.ctr γ) ξ.2.2.2) * psiT (Lsb B.h G.r0 γ.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) • G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2))) ∧ (W0c4 B G γ ξ ≠ 0 → SuppW B G γ ξ ∧ ActiveL4 B G γ ∧ etaL B.h γ ξ ≠ 0 ∧ B.Xa < XC B.h ξ ∧ XC B.h ξ < B.Xb ∧ inRect B.h γ (G.ctr γ) G.r0 ξ.2.2.2) :=
by
  intro B G hok hG γ ξ hξ
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < B.qB := hξ
  have hr0 : 0 < G.r0 := hG.1.1
  have hci : 0 < cib B.h γ.1 := by
    unfold cib
    have hT : (0:ℝ) < Tgc := by unfold Tgc; positivity
    have hQ : (0:ℝ) < Qb γ.1 := by unfold Qb; positivity
    exact mul_pos (zpow_pos hT _) (Real.rpow_pos_of_pos hQ _)
  have hq : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have hX : 0 < XC B.h ξ := by
    unfold XC
    exact div_pos (pow_pos hξ'.1 2) (by linarith)

  have s1 : ∀ s : ℝ, chig G.r0 s ≠ 0 → |s| < G.r0 / 4 := by
    intro s hs
    unfold chig bumpR at hs
    have h3 : (4 * s / G.r0) ^ 2 < 1 := by
      by_contra hcon
      exact hs (Real.smoothTransition.zero_of_nonpos (by linarith [not_lt.mp hcon]))
    have h4 := (sq_lt_one_iff_abs_lt_one _).mp h3
    rw [abs_div, abs_mul, abs_of_pos hr0, abs_of_pos (by norm_num : (0:ℝ) < 4), div_lt_one hr0] at h4
    linarith

  have s2gen : ∀ E ci r : ℝ, 0 < ci → 0 < r →
      Real.smoothTransition ((2 * r / ci / 3 - |(E + r) / ci - 2 * r / ci / 2|) /
        (2 * r / ci / 3 - 2 * r / ci / 5)) ≠ 0 → |E| < 2 * r / 3 := by
    intro E ci r hci0 hr hs
    have hLpos : 0 < 2 * r / ci := div_pos (by linarith) hci0
    have hden : 0 < 2 * r / ci / 3 - 2 * r / ci / 5 := by linarith
    have hnum : 0 < 2 * r / ci / 3 - |(E + r) / ci - 2 * r / ci / 2| := by
      by_contra hcon
      apply hs
      apply Real.smoothTransition.zero_of_nonpos
      exact div_nonpos_of_nonpos_of_nonneg (not_lt.mp hcon) hden.le
    have hid : (E + r) / ci - 2 * r / ci / 2 = E / ci := by ring
    rw [hid, abs_div, abs_of_pos hci0] at hnum
    have e : 2 * r / ci / 3 = (2 * r / 3) / ci := by ring
    have h5 : |E| / ci < (2 * r / 3) / ci := by linarith
    exact (div_lt_div_iff_of_pos_right hci0).mp h5
  have s2 : psiT (Lsb B.h G.r0 γ.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) ≠ 0 →
      |etG B.h γ (G.ctr γ) ξ.2.2.2| < 2 * G.r0 / 3 := fun hs =>
    s2gen (etG B.h γ (G.ctr γ) ξ.2.2.2) (cib B.h γ.1) G.r0 hci hr0 hs

  have s4 : (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → Real.sqrt (max (yAmp4 B G γ ξ) 0) = 0 := by
    intro hout
    obtain ⟨h1, h2⟩ := hok.2.2.2.1.2.2.1 (XC B.h ξ) (etaC B.h ξ) hX hout
    have hT : T0star4 B γ.1 ξ = (0, 0) := by
      unfold T0star4
      rw [h1, h2]
      simp
    have hy : yAmp4 B G γ ξ = 0 := by
      unfold yAmp4
      simp [hT]
    rw [hy, max_self, Real.sqrt_zero]
  refine ⟨fun hAct => ?_, fun hne => ?_⟩
  · unfold W0c4
    by_cases hR : inRect B.h γ (G.ctr γ) (2 * G.r0) ξ.2.2.2
    · rw [if_pos ⟨hAct, hR⟩, smul_smul]
      congr 1
      ring
    · rw [if_neg (fun h => hR h.2)]
      have hχψ : chig G.r0 (xiG B.h γ (G.ctr γ) ξ.2.2.2) *
          psiT (Lsb B.h G.r0 γ.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) = 0 := by
        by_contra hne
        obtain ⟨hc, hp⟩ := mul_ne_zero_iff.mp hne
        have hx := s1 _ hc
        have hE := s2 hp
        exact hR ⟨by linarith, by linarith⟩
      rw [hχψ, zero_smul, smul_zero]
  · unfold W0c4 at hne
    by_cases hc : ActiveL4 B G γ ∧ inRect B.h γ (G.ctr γ) (2 * G.r0) ξ.2.2.2
    swap
    · exact absurd (if_neg hc) hne
    rw [if_pos hc] at hne
    obtain ⟨hAct, -⟩ := hc
    have hsc := (smul_ne_zero_iff.mp hne).1
    obtain ⟨h1, hψ⟩ := mul_ne_zero_iff.mp hsc
    obtain ⟨h2, hχ⟩ := mul_ne_zero_iff.mp h1
    obtain ⟨h3, hAm⟩ := mul_ne_zero_iff.mp h2
    obtain ⟨-, he⟩ := mul_ne_zero_iff.mp h3
    have hXa : B.Xa < XC B.h ξ := by
      by_contra hcon
      exact hAm (s4 (Or.inl (not_lt.mp hcon)))
    have hXb : XC B.h ξ < B.Xb := by
      by_contra hcon
      exact hAm (s4 (Or.inr (not_lt.mp hcon)))
    have hx := s1 _ hχ
    have hE := s2 hψ
    refine ⟨⟨⟨hAct.1, ξ, he, hXa.le, hXb.le⟩, subset_tsupport _ (Function.mem_support.mpr he),
      hx.le, by linarith, hXa.le, hXb.le⟩, hAct, he, hXa, hXb, by linarith, by linarith⟩

theorem w0c4_deck_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (γ : Lab), ∀ ξ ∈ DomC B.h B.qB, ∀ a : ℝ × ℝ, IsDeck B.h (qC B.h ξ) a → W0c4 B G γ (shY ξ a) = W0c4 B G γ ξ :=
by
  intro B G hok hG γ ξ hξ a ha
  have hh : 0 < B.h := hok.2.1.1
  have he : etaL B.h γ (shY ξ a) = etaL B.h γ ξ := rfl
  have hY : (shY ξ a).2.2.2 = ξ.2.2.2 + a := rfl
  by_cases hAct : ActiveL4 B G γ
  swap
  · unfold W0c4
    simp [hAct]
  by_cases heta : etaL B.h γ ξ = 0
  · unfold W0c4
    rw [he]
    split_ifs <;> simp [heta]
  have hl40 : 40 ≤ γ.1 := le_trans hG.1.2.2.2.2 hAct.1

  have hwin : γ.1 ≤ bandOf (qC B.h ξ) ∧ bandOf (qC B.h ξ) ≤ γ.1 + 1 := by
    have h1 : sqPart 1 (-(γ.1:ℤ)) (Real.logb 2 (qC B.h ξ)) ≠ 0 := left_ne_zero_of_mul heta
    unfold sqPart at h1
    have h2 := (div_ne_zero_iff.mp h1).1
    unfold bumpR at h2
    simp only [Int.cast_neg, Int.cast_natCast, div_one, sub_neg_eq_add] at h2
    have h3 : (Real.logb 2 (qC B.h ξ) + (γ.1:ℝ)) ^ 2 < 1 := by
      by_contra hcon
      exact h2 (Real.smoothTransition.zero_of_nonpos (by linarith [not_lt.mp hcon]))
    have h4 := abs_lt.mp ((sq_lt_one_iff_abs_lt_one _).mp h3)
    have hb : bandOf (qC B.h ξ) = ⌈-Real.logb 2 (qC B.h ξ)⌉₊ := by
      unfold bandOf
      rw [one_div, Real.logb_inv]
    rw [hb]
    constructor
    · have h5 := Nat.le_ceil (-Real.logb 2 (qC B.h ξ))
      have h6 : (γ.1:ℝ) < (⌈-Real.logb 2 (qC B.h ξ)⌉₊ : ℝ) + 1 := by linarith [h4.1, h4.2]
      have h7 : γ.1 < ⌈-Real.logb 2 (qC B.h ξ)⌉₊ + 1 := by exact_mod_cast h6
      omega
    · rw [Nat.ceil_le]
      push_cast
      linarith [h4.1, h4.2]

  have hmono : ∀ m l : ℕ, 3 ≤ m → m ≤ l → bandIdx B.h m ≤ bandIdx B.h l := by
    have hT1 : 1 < Tgc := by unfold Tgc; have := Real.sqrt_nonneg 2; linarith
    have hpos : ∀ x : ℕ, 1 ≤ x → 0 < (2:ℝ) ^ ((1 + B.h) * (x:ℝ)) / ((x:ℝ) ^ 2) := by
      intro x hx
      have : (1:ℝ) ≤ x := by exact_mod_cast hx
      exact div_pos (Real.rpow_pos_of_pos (by norm_num) _) (pow_pos (by linarith) 2)
    have hstep : ∀ x : ℕ, 3 ≤ x → (2:ℝ) ^ ((1 + B.h) * (x:ℝ)) / ((x:ℝ) ^ 2) ≤
        (2:ℝ) ^ ((1 + B.h) * ((x+1:ℕ):ℝ)) / (((x+1:ℕ):ℝ) ^ 2) := by
      intro x hx
      have hx3 : (3:ℝ) ≤ x := by exact_mod_cast hx
      have hx0 : (0:ℝ) < (x:ℝ) := by linarith
      have hx1 : (0:ℝ) < ((x+1:ℕ):ℝ) := by push_cast; linarith
      have hP : 0 < (2:ℝ) ^ ((1 + B.h) * (x:ℝ)) := Real.rpow_pos_of_pos (by norm_num) _
      have e : (2:ℝ) ^ ((1 + B.h) * ((x+1:ℕ):ℝ)) =
          (2:ℝ) ^ ((1 + B.h) * (x:ℝ)) * (2:ℝ) ^ (1 + B.h) := by
        rw [← Real.rpow_add (by norm_num)]
        congr 1
        push_cast
        ring
      have h2 : (2:ℝ) ≤ (2:ℝ) ^ (1 + B.h) := by
        have := Real.rpow_le_rpow_of_exponent_le (by norm_num : (1:ℝ) ≤ 2)
          (by linarith : (1:ℝ) ≤ 1 + B.h)
        rwa [Real.rpow_one] at this
      rw [e, div_le_div_iff₀ (pow_pos hx0 2) (pow_pos hx1 2)]
      push_cast
      have hq : ((x:ℝ) + 1) ^ 2 ≤ (2:ℝ) ^ (1 + B.h) * (x:ℝ) ^ 2 := by
        nlinarith [mul_le_mul_of_nonneg_right h2 (sq_nonneg (x:ℝ)),
          mul_nonneg (sub_nonneg.2 hx3) (by linarith : (0:ℝ) ≤ (x:ℝ) + 1)]
      nlinarith [mul_le_mul_of_nonneg_left hq hP.le]
    intro m l hm hml
    have hg : (2:ℝ) ^ ((1 + B.h) * (m:ℝ)) / ((m:ℝ) ^ 2) ≤
        (2:ℝ) ^ ((1 + B.h) * (l:ℝ)) / ((l:ℝ) ^ 2) := by
      induction l, hml using Nat.le_induction with
      | base => exact le_rfl
      | succ n hn ih => exact le_trans ih (hstep n (by omega))
    unfold bandIdx
    exact Int.floor_le_floor (Real.logb_le_logb_of_le hT1 (hpos m (by omega)) hg)

  have hs2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hsq0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
  have hL0 : Lgc ≠ 0 := by
    unfold Lgc
    apply ne_of_gt
    nlinarith
  have hT0 : Tgc ≠ 0 := by
    unfold Tgc
    positivity
  have hL' : Lgc = 3 - bgc := by unfold Lgc bgc; ring
  have hT' : Tgc * bgc = 3 * bgc + 1 := by unfold Tgc bgc; linear_combination hs2
  have hLb : bgc * Lgc = 5 * bgc - 1 := by unfold Lgc bgc; linear_combination (-1:ℝ) * hs2
  have hT'' : Tgc = bgc + 5 := by unfold Tgc bgc; ring
  have hJs : ∀ (n : ℤ) (c : ℝ × ℝ), (∃ i j : ℤ, Jpow n c = ((i:ℝ), (j:ℝ))) →
      ∃ i j : ℤ, Jpow (n + 1) c = ((i:ℝ), (j:ℝ)) := by
    rintro n ⟨c1, c2⟩ ⟨i, j, hij⟩
    refine ⟨3 * i + j, i + 5 * j, ?_⟩
    unfold Jpow at hij ⊢
    rw [zpow_add_one₀ hL0, zpow_add_one₀ hT0]
    simp only [vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk, Prod.mk.injEq] at hij ⊢
    obtain ⟨h1, h2⟩ := hij
    push_cast
    refine ⟨?_, ?_⟩
    · linear_combination 3 * h1 + h2 + (Lgc ^ n * ((c1 - bgc * c2) / (1 + bgc ^ 2))) * hL'
        + (Tgc ^ n * ((bgc * c1 + c2) / (1 + bgc ^ 2))) * hT'
    · linear_combination h1 + 5 * h2 - (Lgc ^ n * ((c1 - bgc * c2) / (1 + bgc ^ 2))) * hLb
        + (Tgc ^ n * ((bgc * c1 + c2) / (1 + bgc ^ 2))) * hT''
  have hlat : ∀ (ci : ℤ) (d : ℕ) (c : ℝ × ℝ), (∃ i j : ℤ, Jpow ci c = ((i:ℝ), (j:ℝ))) →
      ∃ i j : ℤ, Jpow (ci + (d:ℤ)) c = ((i:ℝ), (j:ℝ)) := by
    intro ci d c hc
    induction d with
    | zero => simp only [Nat.cast_zero, add_zero]; exact hc
    | succ d ih =>
      have e : ci + ((d+1 : ℕ) : ℤ) = (ci + (d:ℤ)) + 1 := by push_cast; ring
      rw [e]
      exact hJs _ c ih
  have hadd : ∀ (n : ℤ) (Y b : ℝ × ℝ), Jpow n (Y + b) = Jpow n Y + Jpow n b := by
    rintro n ⟨y1, y2⟩ ⟨b1, b2⟩
    simp only [Jpow, vrv, vtv, Prod.mk_add_mk, Prod.smul_mk, smul_eq_mul, Prod.mk.injEq]
    constructor <;> ring
  have hfrac : ∀ (w : ℝ × ℝ) (k1 k2 : ℤ), frac0 (w + ((k1:ℝ), (k2:ℝ))) = frac0 w := by
    rintro ⟨w1, w2⟩ k1 k2
    simp only [frac0, Prod.mk_add_mk, round_add_intCast, Int.cast_add, Prod.mk.injEq]
    constructor <;> ring

  obtain ⟨hl1, hl2⟩ := hwin
  have hci : coarseIdx B.h (qC B.h ξ) ≤ bandIdx B.h γ.1 := by
    unfold coarseIdx
    exact hmono _ _ (by omega) (by omega)
  obtain ⟨d, hd⟩ : ∃ d : ℕ, bandIdx B.h γ.1 = coarseIdx B.h (qC B.h ξ) + (d:ℤ) :=
    ⟨(bandIdx B.h γ.1 - coarseIdx B.h (qC B.h ξ)).toNat, by
      rw [Int.toNat_of_nonneg (by omega)]; ring⟩
  obtain ⟨k1, k2, hk⟩ := hlat _ d a ha
  rw [← hd] at hk
  have hrect : rectW B.h γ (G.ctr γ) (ξ.2.2.2 + a) = rectW B.h γ (G.ctr γ) ξ.2.2.2 := by
    unfold rectW
    rw [hadd, hk]
    have e : Jpow (bandIdx B.h γ.1) ξ.2.2.2 + ((k1:ℝ), (k2:ℝ)) - G.ctr γ =
        (Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ) + ((k1:ℝ), (k2:ℝ)) := by abel
    rw [e, hfrac]
  have hxi : xiG B.h γ (G.ctr γ) (ξ.2.2.2 + a) = xiG B.h γ (G.ctr γ) ξ.2.2.2 := by
    unfold xiG; rw [hrect]
  have hvco : vco B.h G.r0 γ (G.ctr γ) (ξ.2.2.2 + a) = vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 := by
    unfold vco etG; rw [hrect]
  have hin : inRect B.h γ (G.ctr γ) (2 * G.r0) (ξ.2.2.2 + a) ↔
      inRect B.h γ (G.ctr γ) (2 * G.r0) ξ.2.2.2 := by
    unfold inRect xiG etG; rw [hrect]
  unfold W0c4
  rw [hY, hxi, hvco]
  by_cases hR : inRect B.h γ (G.ctr γ) (2 * G.r0) ξ.2.2.2
  · rw [if_pos (And.intro hAct (hin.2 hR)), if_pos (And.intro hAct hR)]
    all_goals rfl
  · rw [if_neg (fun h : ActiveL4 B G γ ∧ inRect B.h γ (G.ctr γ) (2 * G.r0) (ξ.2.2.2 + a) => hR (hin.1 h.2)),
      if_neg (fun h : ActiveL4 B G γ ∧ inRect B.h γ (G.ctr γ) (2 * G.r0) ξ.2.2.2 => hR h.2)]

theorem nb_triple_leibniz : ∀ (h c : ℝ) (ξ : Cyl) (a e : Cyl → ℝ) (P : Cyl → (Fin 3 → ℝ)) (k : ℕ) (A E Q : ℝ), ContDiffAt ℝ ∞ a ξ → ContDiffAt ℝ ∞ e ξ → ContDiffAt ℝ ∞ P ξ → (∀ i : ℕ, i ≤ k → NB h a i ξ ≤ A) → (∀ i : ℕ, i ≤ k → NB h e i ξ ≤ E) → (∀ i : ℕ, i ≤ k → NB h P i ξ ≤ Q) → NB h (fun η => (c * a η * e η) • P η) k ξ ≤ |c| * 3 ^ k * A * E * Q :=
by
  intro h c ξ a e P k A E Q ha he hP hA hE hQ
  have hNBnn : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (i : ℕ),
      0 ≤ NB h f i ξ := fun f i => norm_nonneg _

  have leib : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (U : Set Cyl) (n : ℕ),
      IsOpen U → ξ ∈ U → ∀ (f : Cyl → ℝ) (g : Cyl → V), ContDiffOn ℝ n f U → ContDiffOn ℝ n g U →
      NB h (fun η => f η • g η) n ξ ≤
        ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * NB h f i ξ * NB h g (n - i) ξ := by
    intro V _ _ U n hU hξ f g hf hg
    unfold NB
    generalize Lnorm h ξ = L
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
    have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + z)) s := by
      intro W _ _ F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
      intro W _ _ F hF
      exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
    have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ∀ i : ℕ, i ≤ n →
        iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
          (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
      intro W _ _ F hF i hi
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
      calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
              (fun _ => L) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
              (fun _ => L) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
              (fun _ => L) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
    have hfg : ContDiffOn ℝ n (fun η => f η • g η) U := hf.smul hg
    have hl := norm_iteratedFDerivWithin_smul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
      (n := n) le_rfl
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) • g (ξ + L y)) n hO h0O] at hl
    rw [← key _ hfg n le_rfl]
    calc ‖iteratedFDeriv ℝ n (fun z => (fun η => f η • g η) (ξ + L z)) 0‖
        = ‖iteratedFDeriv ℝ n (fun y => f (ξ + L y) • g (ξ + L y)) 0‖ := rfl
      _ ≤ _ := hl
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (n - i) hO h0O,
          key f hf i hik, key g hg (n - i) (Nat.sub_le n i)]

  have cmul : ∀ (f : Cyl → ℝ) (i : ℕ), ContDiffAt ℝ i f ξ →
      NB h (fun η => c * f η) i ξ = |c| * NB h f i ξ := by
    intro f i hf
    unfold NB
    have e0 : (fun η => c * f η) = fun η => c • f η := rfl
    have e : iteratedFDeriv ℝ i (fun η => c • f η) ξ = c • iteratedFDeriv ℝ i f ξ :=
      iteratedFDeriv_const_smul_apply' hf
    rw [e0, e]
    have e2 : (c • iteratedFDeriv ℝ i f ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) =
        c • (iteratedFDeriv ℝ i f ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) := by
      ext v; simp
    rw [e2, norm_smul, Real.norm_eq_abs]
  have hA0 : 0 ≤ A := le_trans (hNBnn a 0) (hA 0 (Nat.zero_le k))
  have hE0 : 0 ≤ E := le_trans (hNBnn e 0) (hE 0 (Nat.zero_le k))
  have hQ0 : 0 ≤ Q := le_trans (hNBnn P 0) (hQ 0 (Nat.zero_le k))

  have ha' : ContDiffAt ℝ k a ξ := ha.of_le (by exact_mod_cast le_top)
  have he' : ContDiffAt ℝ k e ξ := he.of_le (by exact_mod_cast le_top)
  have hP' : ContDiffAt ℝ k P ξ := hP.of_le (by exact_mod_cast le_top)
  obtain ⟨ua, hua, hau⟩ := ha'.contDiffOn le_rfl (by simp)
  obtain ⟨ue, hue, heu⟩ := he'.contDiffOn le_rfl (by simp)
  obtain ⟨uP, huP, hPu⟩ := hP'.contDiffOn le_rfl (by simp)
  obtain ⟨O, hOsub, hOopen, hξO⟩ :=
    mem_nhds_iff.mp (Filter.inter_mem hua (Filter.inter_mem hue huP))
  have haO : ContDiffOn ℝ k a O := hau.mono (fun x hx => (hOsub hx).1)
  have heO : ContDiffOn ℝ k e O := heu.mono (fun x hx => (hOsub hx).2.1)
  have hPO : ContDiffOn ℝ k P O := hPu.mono (fun x hx => (hOsub hx).2.2)

  have hgO : ContDiffOn ℝ k (fun η => c * a η * e η) O := (contDiffOn_const.mul haO).mul heO
  have hg : ∀ i : ℕ, i ≤ k → NB h (fun η => c * a η * e η) i ξ ≤ |c| * A * E * 2 ^ i := by
    intro i hi
    have hik : ((i : ℕ) : WithTop ℕ∞) ≤ ((k : ℕ) : WithTop ℕ∞) := by exact_mod_cast hi
    have l1 := leib O i hOopen hξO (fun η => c * a η) e
      (contDiffOn_const.mul (haO.of_le hik)) (heO.of_le hik)
    have l1' : NB h (fun η => c * a η * e η) i ξ ≤ ∑ j ∈ Finset.range (i + 1),
        (i.choose j : ℝ) * NB h (fun η => c * a η) j ξ * NB h e (i - j) ξ := l1
    refine le_trans l1' ?_
    calc ∑ j ∈ Finset.range (i + 1), (i.choose j : ℝ) * NB h (fun η => c * a η) j ξ * NB h e (i - j) ξ
        ≤ ∑ j ∈ Finset.range (i + 1), (i.choose j : ℝ) * (|c| * A) * E := by
          apply Finset.sum_le_sum
          intro j hj
          have hji : j ≤ i := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
          have h1 : NB h (fun η => c * a η) j ξ ≤ |c| * A := by
            rw [cmul a j (ha.of_le (by exact_mod_cast le_top))]
            exact mul_le_mul_of_nonneg_left (hA j (le_trans hji hi)) (abs_nonneg c)
          have h2 : NB h e (i - j) ξ ≤ E := hE _ (le_trans (Nat.sub_le i j) hi)
          exact mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) h2 (hNBnn _ _)
            (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (abs_nonneg c) hA0))
      _ = |c| * A * E * ∑ j ∈ Finset.range (i + 1), (i.choose j : ℝ) := by
          rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro j _; ring
      _ = |c| * A * E * 2 ^ i := by
          congr 1; exact_mod_cast Nat.sum_range_choose i

  have l2 := leib O k hOopen hξO (fun η => c * a η * e η) P hgO hPO
  refine le_trans l2 ?_
  calc ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB h (fun η => c * a η * e η) i ξ *
        NB h P (k - i) ξ
      ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (|c| * A * E * 2 ^ i) * Q := by
        apply Finset.sum_le_sum
        intro i hi
        have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        exact mul_le_mul (mul_le_mul_of_nonneg_left (hg i hik) (Nat.cast_nonneg _))
          (hQ _ (Nat.sub_le k i)) (hNBnn _ _)
          (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (mul_nonneg (mul_nonneg (abs_nonneg c) hA0) hE0)
            (pow_nonneg (by norm_num) i)))
    _ = |c| * A * E * Q * ∑ i ∈ Finset.range (k + 1), (2:ℝ) ^ i * 1 ^ (k - i) * (k.choose i : ℝ) := by
        rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro i _; rw [one_pow]; ring
    _ = |c| * 3 ^ k * A * E * Q := by
        rw [← add_pow]; ring

theorem flat_zero_extension_cyl : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (U V : Set Cyl) (f : Cyl → F), IsOpen U → IsOpen V → V ⊆ U → ContDiffOn ℝ ∞ f V → (∀ x ∈ U, x ∉ V → f x = 0) → (∀ x ∈ U, x ∉ V → ∀ k : ℕ, Filter.Tendsto (fun y => iteratedFDeriv ℝ k f y) (nhdsWithin x V) (nhds 0)) → ContDiffOn ℝ ∞ f U ∧ ∀ x ∈ U, x ∉ V → ∀ k : ℕ, iteratedFDeriv ℝ k f x = 0 :=
by
  intro F _ _ U V f hU hV _hVU hf h0 hlim

  have key : ∀ {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G] (g : Cyl → G),
      DifferentiableOn ℝ g V → (∀ x ∈ U, x ∉ V → g x = 0) →
      (∀ x ∈ U, x ∉ V → Filter.Tendsto g (nhdsWithin x V) (nhds 0)) →
      (∀ x ∈ U, x ∉ V → Filter.Tendsto (fun y => fderiv ℝ g y) (nhdsWithin x V) (nhds 0)) →
      ∀ x ∈ U, x ∉ V → HasFDerivAt g (0 : Cyl →L[ℝ] G) x := by
    intro G _ _ g hgd hg0 hglim hdlim x hxU hxV
    apply HasFDerivAt.of_isLittleO
    have hgx : g x = 0 := hg0 x hxU hxV
    have e : (fun x' => g x' - g x - (0 : Cyl →L[ℝ] G) (x' - x)) = g := by
      funext x'; simp [hgx]
    rw [e, Asymptotics.isLittleO_iff]
    intro c hc
    obtain ⟨δ₁, hδ₁, hd⟩ := Metric.tendsto_nhdsWithin_nhds.1 (hdlim x hxU hxV) c hc
    obtain ⟨δU, hδU, hball⟩ := Metric.isOpen_iff.1 hU x hxU
    rw [Metric.eventually_nhds_iff]
    refine ⟨min δ₁ δU, lt_min hδ₁ hδU, fun y hy => ?_⟩
    have hy1 : dist y x < δ₁ := lt_of_lt_of_le hy (min_le_left _ _)
    have hyU' : dist y x < δU := lt_of_lt_of_le hy (min_le_right _ _)
    have hr0 : 0 ≤ ‖y - x‖ := norm_nonneg _
    have hrd : dist y x = ‖y - x‖ := dist_eq_norm y x
    by_cases hyV : y ∈ V
    swap
    · have : g y = 0 := hg0 y (hball (Metric.mem_ball.2 hyU')) hyV
      rw [this, norm_zero]
      exact mul_nonneg hc.le hr0

    obtain ⟨p, hp⟩ : ∃ p : ℝ → Cyl, p = fun s => x + s • (y - x) := ⟨_, rfl⟩
    have hpc : Continuous p := by
      rw [hp]; exact continuous_const.add (continuous_id.smul continuous_const)
    have hpdist : ∀ s t : ℝ, dist (p t) (p s) = |t - s| * ‖y - x‖ := by
      intro s t
      rw [dist_eq_norm]
      have : p t - p s = (t - s) • (y - x) := by simp only [hp]; module
      rw [this, norm_smul, Real.norm_eq_abs]
    have hp0 : p 0 = x := by rw [hp]; simp
    have hp1 : p 1 = y := by rw [hp]; simp
    obtain ⟨S, hS⟩ : ∃ S : Set ℝ, S = Icc (0:ℝ) 1 ∩ p ⁻¹' Vᶜ := ⟨_, rfl⟩
    have hSc : IsClosed S := by
      rw [hS]; exact isClosed_Icc.inter (hV.isClosed_compl.preimage hpc)
    have hSne : S.Nonempty := by
      refine ⟨0, ?_⟩
      rw [hS]
      refine ⟨⟨le_rfl, zero_le_one⟩, ?_⟩
      show p 0 ∉ V
      rw [hp0]; exact hxV
    have hSb : BddAbove S := ⟨1, fun s hs => by rw [hS] at hs; exact hs.1.2⟩
    obtain ⟨s₀, hs₀⟩ : ∃ s₀ : ℝ, s₀ = sSup S := ⟨_, rfl⟩
    have hs₀S : s₀ ∈ S := by rw [hs₀]; exact hSc.csSup_mem hSne hSb
    rw [hS] at hs₀S
    have hs₀0 : 0 ≤ s₀ := hs₀S.1.1
    have hs₀le : s₀ ≤ 1 := hs₀S.1.2
    have hs₀V : p s₀ ∉ V := hs₀S.2
    have hs₀1 : s₀ < 1 := by
      rcases lt_or_eq_of_le hs₀le with h | h
      · exact h
      · exfalso; apply hs₀V; rw [h, hp1]; exact hyV
    have htail : ∀ s, s₀ < s → s ≤ 1 → p s ∈ V := by
      intro s h1 h2
      by_contra hn
      have hsS : s ∈ S := by rw [hS]; exact ⟨⟨by linarith, h2⟩, hn⟩
      have := le_csSup hSb hsS
      rw [← hs₀] at this
      linarith
    have hzdist : dist (p s₀) x = s₀ * ‖y - x‖ := by
      have := hpdist 0 s₀
      rw [hp0, sub_zero, abs_of_nonneg hs₀0] at this
      exact this
    have hzU : p s₀ ∈ U := by
      apply hball
      rw [Metric.mem_ball, hzdist]
      have : s₀ * ‖y - x‖ ≤ ‖y - x‖ := mul_le_of_le_one_left hr0 hs₀le
      linarith

    have hmvt : ∀ s', s₀ < s' → s' ≤ 1 → ‖g y - g (p s')‖ ≤ c * ‖y - x‖ := by
      intro s' h1 h2
      have hseg : ∀ u ∈ segment ℝ (p s') y, u ∈ V ∧ dist u x < δ₁ := by
        intro u hu
        rw [segment_eq_image'] at hu
        obtain ⟨θ, ⟨hθ0, hθ1⟩, rfl⟩ := hu
        have e : p s' + θ • (y - p s') = p (s' + θ * (1 - s')) := by
          rw [hp]; simp only; module
        show p s' + θ • (y - p s') ∈ V ∧ dist (p s' + θ • (y - p s')) x < δ₁
        rw [e]
        have hA : 0 ≤ θ * (1 - s') := mul_nonneg hθ0 (by linarith)
        have hB : 0 ≤ (1 - θ) * (1 - s') := mul_nonneg (by linarith) (by linarith)
        have hs_nonneg : 0 ≤ s' + θ * (1 - s') := by linarith
        have hs_le : s' + θ * (1 - s') ≤ 1 := by nlinarith
        refine ⟨htail _ (by linarith) hs_le, ?_⟩
        have := hpdist 0 (s' + θ * (1 - s'))
        rw [hp0, sub_zero, abs_of_nonneg hs_nonneg] at this
        rw [this]
        have : (s' + θ * (1 - s')) * ‖y - x‖ ≤ ‖y - x‖ := mul_le_of_le_one_left hr0 hs_le
        linarith
      have hmv := Convex.norm_image_sub_le_of_norm_fderiv_le (𝕜 := ℝ) (f := g) (C := c)
        (s := segment ℝ (p s') y)
        (fun u hu => hgd.differentiableAt (hV.mem_nhds (hseg u hu).1))
        (fun u hu => by
          have := hd (hseg u hu).1 (hseg u hu).2
          rw [dist_zero_right] at this
          exact this.le)
        (convex_segment _ _) (left_mem_segment ℝ _ _) (right_mem_segment ℝ _ _)
      refine le_trans hmv ?_
      have hd2 : ‖y - p s'‖ = (1 - s') * ‖y - x‖ := by
        have := hpdist s' 1
        rw [hp1, dist_eq_norm, abs_of_nonneg (by linarith)] at this
        exact this
      rw [hd2]
      have : (1 - s') * ‖y - x‖ ≤ ‖y - x‖ := mul_le_of_le_one_left hr0 (by linarith)
      exact mul_le_mul_of_nonneg_left this hc.le

    apply le_of_forall_pos_lt_add
    intro η hη
    obtain ⟨δ', hδ', hδ'g⟩ := Metric.tendsto_nhdsWithin_nhds.1 (hglim _ hzU hs₀V) η hη
    have hpos : 0 < δ' / (2 * (‖y - x‖ + 1)) := by positivity
    obtain ⟨s', hs'⟩ : ∃ s' : ℝ, s' = min 1 (s₀ + δ' / (2 * (‖y - x‖ + 1))) := ⟨_, rfl⟩
    have hs'1 : s' ≤ 1 := by rw [hs']; exact min_le_left _ _
    have hs'0 : s₀ < s' := by rw [hs']; exact lt_min hs₀1 (by linarith)
    have hs'le : s' ≤ s₀ + δ' / (2 * (‖y - x‖ + 1)) := by rw [hs']; exact min_le_right _ _
    have hpV := htail s' hs'0 hs'1
    have hdz : dist (p s') (p s₀) < δ' := by
      rw [hpdist s₀ s', abs_of_nonneg (by linarith)]
      have h1 : (s' - s₀) * ‖y - x‖ ≤ δ' / (2 * (‖y - x‖ + 1)) * ‖y - x‖ :=
        mul_le_mul_of_nonneg_right (by linarith) hr0
      have h2 : δ' / (2 * (‖y - x‖ + 1)) * ‖y - x‖ < δ' := by
        rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
        nlinarith
      linarith
    have hgs := hδ'g hpV hdz
    rw [dist_zero_right] at hgs
    have := hmvt s' hs'0 hs'1
    calc ‖g y‖ ≤ ‖g y - g (p s')‖ + ‖g (p s')‖ := norm_le_norm_sub_add _ _
      _ < c * ‖y - x‖ + η := by linarith

  have hFD : ∀ m : ℕ, DifferentiableOn ℝ (iteratedFDeriv ℝ m f) V := by
    intro m y hy
    have hc : ContDiffAt ℝ ∞ f y := hf.contDiffAt (hV.mem_nhds hy)
    exact (hc.differentiableAt_iteratedFDeriv
      (by exact_mod_cast ENat.natCast_lt_top m)).differentiableWithinAt

  have hDlim : ∀ m : ℕ, ∀ x ∈ U, x ∉ V →
      Filter.Tendsto (fun y => fderiv ℝ (iteratedFDeriv ℝ m f) y) (nhdsWithin x V) (nhds 0) := by
    intro m x hx hxV
    have h1 := tendsto_zero_iff_norm_tendsto_zero.1 (hlim x hx hxV (m + 1))
    have h2 : Filter.Tendsto (fun y => ‖fderiv ℝ (iteratedFDeriv ℝ m f) y‖) (nhdsWithin x V) (nhds 0) :=
      h1.congr (fun y => norm_fderiv_iteratedFDeriv.symm)
    exact (tendsto_zero_iff_norm_tendsto_zero
      (E := Cyl →L[ℝ] ContinuousMultilinearMap ℝ (fun _ : Fin m => Cyl) F)).2 h2

  have hZ : ∀ m : ℕ, ∀ x ∈ U, x ∉ V → iteratedFDeriv ℝ m f x = 0 := by
    intro m
    induction m with
    | zero =>
      intro x hx hxV
      rw [← norm_eq_zero, norm_iteratedFDeriv_zero, h0 x hx hxV, norm_zero]
    | succ m ih =>
      intro x hx hxV
      have hd := key (iteratedFDeriv ℝ m f) (hFD m) ih (fun x hx hxV => hlim x hx hxV m)
        (hDlim m) x hx hxV
      have hfd : fderiv ℝ (iteratedFDeriv ℝ m f) x = 0 := hd.fderiv
      rw [← norm_eq_zero, ← norm_fderiv_iteratedFDeriv, hfd]
      exact ContinuousLinearMap.opNorm_zero

  have hDU : ∀ m : ℕ, DifferentiableOn ℝ (iteratedFDeriv ℝ m f) U := by
    intro m x hx
    by_cases hxV : x ∈ V
    · exact ((hFD m).differentiableAt (hV.mem_nhds hxV)).differentiableWithinAt
    · exact (key _ (hFD m) (hZ m) (fun x hx hxV => hlim x hx hxV m) (hDlim m) x hx
        hxV).differentiableAt.differentiableWithinAt
  refine ⟨?_, fun x hx hxV k => hZ k x hx hxV⟩
  apply contDiffOn_of_differentiableOn
  intro m _
  exact (hDU m).congr (fun x hx => iteratedFDerivWithin_of_isOpen m hU hx)

theorem lnorm_two_sided_bound_v5 : ∀ (h q0 : ℝ), 0 ≤ h → h ≤ 1/2 → 0 < q0 → ∃ M : ℝ, 0 ≤ M ∧ ∀ ξ : Cyl, q0 ≤ qC h ξ → qC h ξ ≤ 1 → ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (k : ℕ), ‖iteratedFDeriv ℝ k f ξ‖ ≤ M ^ k * NB h f k ξ ∧ NB h f k ξ ≤ M ^ k * ‖iteratedFDeriv ℝ k f ξ‖ :=
by
  intro h q0 hh0 hh1 hq0

  have hL : Lgc ≠ 0 := by
    unfold Lgc; intro h0
    have : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
    linarith
  have hT : Tgc ≠ 0 := by unfold Tgc; intro h0; linarith [Real.sqrt_nonneg 2]
  have hN : (1 + bgc ^ 2) ≠ 0 := by positivity
  have c1 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).1 = Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) * bgc := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have c2 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).2 = -(Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) * bgc) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have hcomp : ∀ (m n : ℤ) (Y : ℝ × ℝ), Jpow m (Jpow n Y) = Jpow (m + n) Y := by
    intro m n Y
    refine Prod.ext ?_ ?_
    · rw [c1 m, c1 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
      field_simp
      ring
    · rw [c2 m, c2 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
      field_simp
      ring
  have hid : ∀ Y : ℝ × ℝ, Jpow 0 Y = Y := by
    intro Y
    refine Prod.ext ?_ ?_
    · rw [c1, zpow_zero, zpow_zero]
      field_simp
      ring
    · rw [c2, zpow_zero, zpow_zero]
      field_simp
      ring
  have hJ : ∀ (m : ℤ) (Y : ℝ × ℝ), JpowL m Y = Jpow m Y := by
    intro m Y
    refine Prod.ext ?_ ?_
    · simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
        ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Prod.fst_add, Prod.smul_fst,
        smul_eq_mul]
      rw [c1, c1, c1]
      ring
    · simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
        ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Prod.snd_add, Prod.smul_snd,
        smul_eq_mul]
      rw [c2, c2, c2]
      ring
  have hJinv : ∀ (n : ℤ) (Y : ℝ × ℝ), JpowL (-n) (JpowL n Y) = Y := by
    intro n Y
    rw [hJ, hJ, hcomp, neg_add_cancel, hid]

  obtain ⟨S, hSdef⟩ : ∃ S : ℝ, S = ∑ l ∈ Finset.range (bandOf q0 + 1),
      (‖JpowL (-(bandIdx h l))‖ + ‖JpowL (bandIdx h l)‖) := ⟨_, rfl⟩
  have hS0 : 0 ≤ S := by
    rw [hSdef]; exact Finset.sum_nonneg (fun l _ => by positivity)
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = 1 + 1 / q0 + S := ⟨_, rfl⟩
  have hq0inv : 0 < q0⁻¹ := inv_pos.mpr hq0
  have hM1 : 1 ≤ M := by rw [hMdef, one_div]; linarith
  have hMq : q0⁻¹ ≤ M := by rw [hMdef, one_div]; linarith
  have hMS : S ≤ M := by rw [hMdef, one_div]; linarith
  have hM0 : 0 ≤ M := by linarith
  refine ⟨M, hM0, ?_⟩
  intro ξ hlo hhi V _ _ f k

  have hq : 0 < qC h ξ := lt_of_lt_of_le hq0 hlo
  have hband : bandOf (qC h ξ) ≤ bandOf q0 := by
    unfold bandOf
    apply Nat.ceil_mono
    apply Real.logb_le_logb_of_le one_lt_two (by positivity)
    exact one_div_le_one_div_of_le hq0 hlo
  have hl : bandOf (qC h ξ) - 4 ∈ Finset.range (bandOf q0 + 1) := Finset.mem_range.mpr (by omega)
  have hsingle := Finset.single_le_sum
    (f := fun l => ‖JpowL (-(bandIdx h l))‖ + ‖JpowL (bandIdx h l)‖) (fun l _ => by positivity) hl
  have hci : coarseIdx h (qC h ξ) = bandIdx h (bandOf (qC h ξ) - 4) := rfl
  have hJm : ‖JpowL (-(coarseIdx h (qC h ξ)))‖ ≤ S := by
    rw [hSdef, hci]
    exact le_trans (le_add_of_nonneg_right (norm_nonneg _)) hsingle
  have hJp : ‖JpowL (coarseIdx h (qC h ξ))‖ ≤ S := by
    rw [hSdef, hci]
    exact le_trans (le_add_of_nonneg_left (norm_nonneg _)) hsingle

  have hsq0 : 0 < Real.sqrt (qC h ξ) := Real.sqrt_pos.mpr hq
  have hsq1 : Real.sqrt (qC h ξ) ≤ 1 := by
    rw [← Real.sqrt_one]; exact Real.sqrt_le_sqrt hhi
  have hqsq : qC h ξ ≤ Real.sqrt (qC h ξ) := by
    have e := Real.mul_self_sqrt hq.le
    have := mul_le_mul_of_nonneg_left hsq1 hsq0.le
    nlinarith
  have hqe0 : 0 < qC h ξ ^ (1/2 - h) := Real.rpow_pos_of_pos hq _
  have hqe1 : qC h ξ ^ (1/2 - h) ≤ 1 := Real.rpow_le_one hq.le hhi (by linarith)
  have hqqe : qC h ξ ≤ qC h ξ ^ (1/2 - h) := by
    have := Real.rpow_le_rpow_of_exponent_ge hq hhi (show 1/2 - h ≤ 1 by linarith)
    rwa [Real.rpow_one] at this
  have hi1 : (Real.sqrt (qC h ξ))⁻¹ ≤ M := le_trans (inv_anti₀ hq0 (le_trans hlo hqsq)) hMq
  have hi2 : (qC h ξ ^ (1/2 - h))⁻¹ ≤ M := le_trans (inv_anti₀ hq0 (le_trans hlo hqqe)) hMq
  have hi3 : (qC h ξ)⁻¹ ≤ M := le_trans (inv_anti₀ hq0 hlo) hMq

  have hnorm4 : ∀ (a b c : ℝ) (d : ℝ × ℝ) (r : ℝ), ‖a‖ ≤ r → ‖b‖ ≤ r → ‖c‖ ≤ r → ‖d‖ ≤ r →
      ‖((a, b, c, d) : Cyl)‖ ≤ r := by
    intro a b c d r ha hb hc hd
    exact norm_prod_le_iff.mpr ⟨ha, norm_prod_le_iff.mpr ⟨hb, norm_prod_le_iff.mpr ⟨hc, hd⟩⟩⟩
  have hsc : ∀ (c x r : ℝ), 0 ≤ c → c ≤ M → ‖x‖ ≤ r → ‖c * x‖ ≤ M * r := by
    intro c x r hc hcM hx
    rw [norm_mul, Real.norm_of_nonneg hc]
    exact mul_le_mul hcM hx (norm_nonneg _) hM0
  have hlin : ∀ (T : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)) (x : ℝ × ℝ) (r : ℝ), ‖T‖ ≤ S → ‖x‖ ≤ r →
      ‖T x‖ ≤ M * r := by
    intro T x r hTS hx
    have hr : 0 ≤ r := le_trans (norm_nonneg _) hx
    calc ‖T x‖ ≤ ‖T‖ * ‖x‖ := ContinuousLinearMap.le_opNorm _ _
      _ ≤ S * r := mul_le_mul hTS hx (norm_nonneg _) hS0
      _ ≤ M * r := mul_le_mul_of_nonneg_right hMS hr
  have hu1 : ∀ u : Cyl, ‖u.1‖ ≤ ‖u‖ := fun u => norm_fst_le u
  have hu2 : ∀ u : Cyl, ‖u.2.1‖ ≤ ‖u‖ := fun u => (norm_fst_le u.2).trans (norm_snd_le u)
  have hu3 : ∀ u : Cyl, ‖u.2.2.1‖ ≤ ‖u‖ := fun u =>
    ((norm_fst_le u.2.2).trans (norm_snd_le u.2)).trans (norm_snd_le u)
  have hu4 : ∀ u : Cyl, ‖u.2.2.2‖ ≤ ‖u‖ := fun u =>
    ((norm_snd_le u.2.2).trans (norm_snd_le u.2)).trans (norm_snd_le u)

  have hLap : ∀ u : Cyl, Lnorm h ξ u = (Real.sqrt (qC h ξ) * u.1, qC h ξ ^ (1/2 - h) * u.2.1,
      qC h ξ * u.2.2.1, JpowL (-(coarseIdx h (qC h ξ))) u.2.2.2) := fun u => rfl
  obtain ⟨R, hRdef⟩ : ∃ R : Cyl →L[ℝ] Cyl,
      R = ((Real.sqrt (qC h ξ))⁻¹ • ContinuousLinearMap.id ℝ ℝ).prodMap
        (((qC h ξ ^ (1/2 - h))⁻¹ • ContinuousLinearMap.id ℝ ℝ).prodMap
          (((qC h ξ)⁻¹ • ContinuousLinearMap.id ℝ ℝ).prodMap (JpowL (coarseIdx h (qC h ξ))))) :=
    ⟨_, rfl⟩
  have hRap : ∀ u : Cyl, R u = ((Real.sqrt (qC h ξ))⁻¹ * u.1, (qC h ξ ^ (1/2 - h))⁻¹ * u.2.1,
      (qC h ξ)⁻¹ * u.2.2.1, JpowL (coarseIdx h (qC h ξ)) u.2.2.2) := by
    intro u; rw [hRdef]; rfl
  have hP : ∀ u : Cyl, ‖Lnorm h ξ u‖ ≤ M * ‖u‖ := by
    intro u
    rw [hLap]
    exact hnorm4 _ _ _ _ _ (hsc _ _ _ hsq0.le (le_trans hsq1 hM1) (hu1 u))
      (hsc _ _ _ hqe0.le (le_trans hqe1 hM1) (hu2 u))
      (hsc _ _ _ hq.le (le_trans hhi hM1) (hu3 u)) (hlin _ _ _ hJm (hu4 u))
  have hR : ∀ u : Cyl, ‖R u‖ ≤ M * ‖u‖ := by
    intro u
    rw [hRap]
    exact hnorm4 _ _ _ _ _ (hsc _ _ _ (inv_nonneg.mpr hsq0.le) hi1 (hu1 u))
      (hsc _ _ _ (inv_nonneg.mpr hqe0.le) hi2 (hu2 u))
      (hsc _ _ _ (inv_nonneg.mpr hq.le) hi3 (hu3 u)) (hlin _ _ _ hJp (hu4 u))
  have hPR : ∀ u : Cyl, Lnorm h ξ (R u) = u := by
    intro u
    obtain ⟨a, b, c, d⟩ := u
    rw [hRap, hLap]
    simp only [Prod.mk.injEq]
    refine ⟨mul_inv_cancel_left₀ hsq0.ne' a, mul_inv_cancel_left₀ hqe0.ne' b,
      mul_inv_cancel_left₀ hq.ne' c, hJinv _ d⟩
  have hPn : ‖Lnorm h ξ‖ ≤ M := ContinuousLinearMap.opNorm_le_bound _ hM0 hP
  have hRn : ‖R‖ ≤ M := ContinuousLinearMap.opNorm_le_bound _ hM0 hR

  have gen : ∀ (B : ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) V) (T : Cyl →L[ℝ] Cyl),
      ‖T‖ ≤ M → ‖B.compContinuousLinearMap (fun _ => T)‖ ≤ M ^ k * ‖B‖ := by
    intro B T hTM
    have h1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le B (fun _ : Fin k => T)
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin] at h1
    calc _ ≤ ‖B‖ * ‖T‖ ^ k := h1
      _ ≤ ‖B‖ * M ^ k :=
          mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) hTM k) (norm_nonneg _)
      _ = M ^ k * ‖B‖ := mul_comm _ _
  unfold NB
  obtain ⟨A, hAdef⟩ : ∃ A, A = iteratedFDeriv ℝ k f ξ := ⟨_, rfl⟩
  rw [← hAdef]
  have hA : A = (A.compContinuousLinearMap (fun _ => Lnorm h ξ)).compContinuousLinearMap
      (fun _ => R) := by
    ext m
    simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply, hPR]
  constructor
  · calc ‖A‖ = ‖(A.compContinuousLinearMap (fun _ => Lnorm h ξ)).compContinuousLinearMap
          (fun _ => R)‖ := congrArg _ hA
      _ ≤ M ^ k * ‖A.compContinuousLinearMap (fun _ => Lnorm h ξ)‖ := gen _ R hRn
  · exact gen A _ hPn

theorem edge_factor_limits_v5 : ∀ (Xa Xb aa ab d : ℝ), 0 < Xa → Xa < Xb → 0 < aa → 0 < ab → ContinuousOn (fun X => Real.sqrt (edgeWeight Xa Xb aa ab X) * edgeDist Xa Xb X ^ (-d)) (Set.Ioo Xa Xb) ∧ Filter.Tendsto (fun X => Real.sqrt (edgeWeight Xa Xb aa ab X) * edgeDist Xa Xb X ^ (-d)) (nhdsWithin Xa (Set.Ioo Xa Xb)) (nhds 0) ∧ Filter.Tendsto (fun X => Real.sqrt (edgeWeight Xa Xb aa ab X) * edgeDist Xa Xb X ^ (-d)) (nhdsWithin Xb (Set.Ioo Xa Xb)) (nhds 0) :=
by
  intro Xa Xb aa ab d hXa hab haa hab'
  have hXa0 : Xa ≠ 0 := hXa.ne'
  have hXb0 : 0 < Xb := hXa.trans hab

  have core : ∀ c : ℝ, 0 < c → Filter.Tendsto (fun s : ℝ => Real.exp (-(c / s ^ 2)) * s ^ (-d))
      (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
    intro c hc
    have ht : Filter.Tendsto (fun s : ℝ => (s⁻¹) ^ 2) (nhdsWithin 0 (Set.Ioi 0)) Filter.atTop :=
      (Filter.tendsto_pow_atTop two_ne_zero).comp tendsto_inv_nhdsGT_zero
    have H := (tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero (d / 2) c hc).comp ht
    refine H.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with s hs
    have hs' : (0:ℝ) < s := hs
    show ((s⁻¹) ^ 2) ^ (d / 2) * Real.exp (-c * (s⁻¹) ^ 2) = Real.exp (-(c / s ^ 2)) * s ^ (-d)
    have e1 : -c * (s⁻¹) ^ 2 = -(c / s ^ 2) := by rw [inv_pow]; ring
    have e2 : ((s⁻¹) ^ 2) ^ (d / 2) = s ^ (-d) := by
      rw [← Real.rpow_two, ← Real.rpow_mul (inv_nonneg.mpr hs'.le),
        show (2:ℝ) * (d / 2) = d by ring, Real.inv_rpow hs'.le, Real.rpow_neg hs'.le]
    rw [e1, e2, mul_comm]

  have hI : ∀ X ∈ Set.Ioo Xa Xb, 0 < Real.log (X / Xa) ∧ 0 < Real.log (Xb / X) := fun X hX =>
    ⟨Real.log_pos ((one_lt_div hXa).mpr hX.1), Real.log_pos ((one_lt_div (hXa.trans hX.1)).mpr hX.2)⟩
  have hEW : ∀ X ∈ Set.Ioo Xa Xb, edgeWeight Xa Xb aa ab X =
      Real.exp (-(aa / Real.log (X / Xa) ^ 2) - ab / Real.log (Xb / X) ^ 2) := by
    intro X hX
    unfold edgeWeight
    rw [if_pos (show Xa < X ∧ X < Xb from hX)]
  have hED : ∀ X ∈ Set.Ioo Xa Xb, 0 < edgeDist Xa Xb X := by
    intro X hX
    unfold edgeDist
    exact lt_min one_pos (lt_min (hI X hX).1 (hI X hX).2)

  have hL1c : ContinuousOn (fun X => Real.log (X / Xa)) (Set.Ioo Xa Xb) :=
    (continuousOn_id.div_const Xa).log (fun X hX => (div_pos (hXa.trans hX.1) hXa).ne')
  have hL2c : ContinuousOn (fun X => Real.log (Xb / X)) (Set.Ioo Xa Xb) :=
    (continuousOn_const.div continuousOn_id (fun X hX => (hXa.trans hX.1).ne')).log
      (fun X hX => (div_pos hXb0 (hXa.trans hX.1)).ne')
  have hEc : ContinuousOn (fun X => Real.sqrt (Real.exp (-(aa / Real.log (X / Xa) ^ 2) -
      ab / Real.log (Xb / X) ^ 2))) (Set.Ioo Xa Xb) :=
    ((((continuousOn_const.div (hL1c.pow 2) (fun X hX => pow_ne_zero 2 (hI X hX).1.ne')).neg).sub
      (continuousOn_const.div (hL2c.pow 2) (fun X hX => pow_ne_zero 2 (hI X hX).2.ne'))).rexp).sqrt
  have hDm : ContinuousOn (fun X => min 1 (min (Real.log (X / Xa)) (Real.log (Xb / X))))
      (Set.Ioo Xa Xb) :=
    continuous_min.comp_continuousOn
      (continuousOn_const.prodMk (continuous_min.comp_continuousOn (hL1c.prodMk hL2c)))
  have hD : ContinuousOn (fun X => edgeDist Xa Xb X) (Set.Ioo Xa Xb) := hDm
  have hDc : ContinuousOn (fun X => edgeDist Xa Xb X ^ (-d)) (Set.Ioo Xa Xb) :=
    hD.rpow_const (fun X hX => Or.inl (hED X hX).ne')
  have hcont : ContinuousOn (fun X => Real.sqrt (edgeWeight Xa Xb aa ab X) * edgeDist Xa Xb X ^ (-d))
      (Set.Ioo Xa Xb) :=
    (hEc.mul hDc).congr (fun X hX => by simp only [hEW X hX, Pi.mul_apply])
  have hpos : 0 < Real.log (Xb / Xa) := Real.log_pos ((one_lt_div hXa).mpr hab)
  have hnn : ∀ᶠ X in nhdsWithin Xa (Set.Ioo Xa Xb) ⊔ nhdsWithin Xb (Set.Ioo Xa Xb),
      (0:ℝ) ≤ Real.sqrt (edgeWeight Xa Xb aa ab X) * edgeDist Xa Xb X ^ (-d) := by
    have hm : Set.Ioo Xa Xb ∈ nhdsWithin Xa (Set.Ioo Xa Xb) ⊔ nhdsWithin Xb (Set.Ioo Xa Xb) :=
      Filter.mem_sup.mpr ⟨self_mem_nhdsWithin, self_mem_nhdsWithin⟩
    filter_upwards [hm] with X hX
    exact mul_nonneg (Real.sqrt_nonneg _) (Real.rpow_nonneg (hED X hX).le _)
  refine ⟨hcont, ?_, ?_⟩
  ·
    have hc1 : ContinuousAt (fun X => Real.log (X / Xa)) Xa :=
      (continuousAt_id.div_const Xa).log (by rw [id, div_self hXa0]; exact one_ne_zero)
    have hL1a' : Filter.Tendsto (fun X => Real.log (X / Xa)) (nhds Xa) (nhds (Real.log (Xa / Xa))) :=
      hc1.tendsto
    rw [div_self hXa0, Real.log_one] at hL1a'
    have hL1a := hL1a'.mono_left (nhdsWithin_le_nhds (s := Set.Ioo Xa Xb))
    have hc2 : ContinuousAt (fun X => Real.log (Xb / X)) Xa :=
      (continuousAt_const.div continuousAt_id hXa0).log (div_pos hXb0 hXa).ne'
    have hL2a' : Filter.Tendsto (fun X => Real.log (Xb / X)) (nhds Xa) (nhds (Real.log (Xb / Xa))) :=
      hc2.tendsto
    have hL2a := hL2a'.mono_left (nhdsWithin_le_nhds (s := Set.Ioo Xa Xb))
    have hT : Filter.Tendsto (fun X => Real.log (X / Xa)) (nhdsWithin Xa (Set.Ioo Xa Xb))
        (nhdsWithin 0 (Set.Ioi 0)) :=
      tendsto_nhdsWithin_iff.mpr ⟨hL1a, eventually_nhdsWithin_of_forall (fun X hX => (hI X hX).1)⟩
    have hG := (core (aa / 2) (half_pos haa)).comp hT
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hG
      (hnn.filter_mono le_sup_left) ?_
    filter_upwards [self_mem_nhdsWithin, Filter.Tendsto.eventually_lt_const zero_lt_one hL1a,
      hL1a.eventually_lt hL2a hpos] with X hX h1 h2
    have hDX : edgeDist Xa Xb X = Real.log (X / Xa) := by
      unfold edgeDist
      rw [min_eq_left h2.le, min_eq_right h1.le]
    show Real.sqrt (edgeWeight Xa Xb aa ab X) * edgeDist Xa Xb X ^ (-d) ≤
      Real.exp (-((aa / 2) / Real.log (X / Xa) ^ 2)) * Real.log (X / Xa) ^ (-d)
    rw [hDX, hEW X hX]
    apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg (hI X hX).1.le _)
    rw [show -((aa / 2) / Real.log (X / Xa) ^ 2) = (-(aa / Real.log (X / Xa) ^ 2)) / 2 by ring,
      Real.exp_half]
    apply Real.sqrt_le_sqrt
    apply Real.exp_le_exp.mpr
    have : 0 ≤ ab / Real.log (Xb / X) ^ 2 := div_nonneg hab'.le (sq_nonneg _)
    linarith
  ·
    have hXb0' : Xb ≠ 0 := hXb0.ne'
    have hc2 : ContinuousAt (fun X => Real.log (Xb / X)) Xb :=
      (continuousAt_const.div continuousAt_id hXb0').log (by simp [hXb0'])
    have hL2b' : Filter.Tendsto (fun X => Real.log (Xb / X)) (nhds Xb) (nhds (Real.log (Xb / Xb))) :=
      hc2.tendsto
    rw [div_self hXb0', Real.log_one] at hL2b'
    have hL2b := hL2b'.mono_left (nhdsWithin_le_nhds (s := Set.Ioo Xa Xb))
    have hc1 : ContinuousAt (fun X => Real.log (X / Xa)) Xb :=
      (continuousAt_id.div_const Xa).log (div_pos hXb0 hXa).ne'
    have hL1b' : Filter.Tendsto (fun X => Real.log (X / Xa)) (nhds Xb) (nhds (Real.log (Xb / Xa))) :=
      hc1.tendsto
    have hL1b := hL1b'.mono_left (nhdsWithin_le_nhds (s := Set.Ioo Xa Xb))
    have hT : Filter.Tendsto (fun X => Real.log (Xb / X)) (nhdsWithin Xb (Set.Ioo Xa Xb))
        (nhdsWithin 0 (Set.Ioi 0)) :=
      tendsto_nhdsWithin_iff.mpr ⟨hL2b, eventually_nhdsWithin_of_forall (fun X hX => (hI X hX).2)⟩
    have hG := (core (ab / 2) (half_pos hab')).comp hT
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hG
      (hnn.filter_mono le_sup_right) ?_
    filter_upwards [self_mem_nhdsWithin, Filter.Tendsto.eventually_lt_const zero_lt_one hL2b,
      hL2b.eventually_lt hL1b hpos] with X hX h1 h2
    have hDX : edgeDist Xa Xb X = Real.log (Xb / X) := by
      unfold edgeDist
      rw [min_eq_right h2.le, min_eq_right h1.le]
    show Real.sqrt (edgeWeight Xa Xb aa ab X) * edgeDist Xa Xb X ^ (-d) ≤
      Real.exp (-((ab / 2) / Real.log (Xb / X) ^ 2)) * Real.log (Xb / X) ^ (-d)
    rw [hDX, hEW X hX]
    apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg (hI X hX).2.le _)
    rw [show -((ab / 2) / Real.log (Xb / X) ^ 2) = (-(ab / Real.log (Xb / X) ^ 2)) / 2 by ring,
      Real.exp_half]
    apply Real.sqrt_le_sqrt
    apply Real.exp_le_exp.mpr
    have : 0 ≤ aa / Real.log (X / Xa) ^ 2 := div_nonneg haa.le (sq_nonneg _)
    linarith

theorem w0c4_jet_tendsto_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (lN : ℕ) (c : ℝ), 0 < c → PrimNondegAt4 B G lN c → (∀ (h q0 : ℝ), 0 ≤ h → h ≤ 1/2 → 0 < q0 → ∃ M : ℝ, 0 ≤ M ∧ ∀ ξ : Cyl, q0 ≤ qC h ξ → qC h ξ ≤ 1 → ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (k : ℕ), ‖iteratedFDeriv ℝ k f ξ‖ ≤ M ^ k * NB h f k ξ ∧ NB h f k ξ ≤ M ^ k * ‖iteratedFDeriv ℝ k f ξ‖) → (∀ (Xa Xb aa ab d : ℝ), 0 < Xa → Xa < Xb → 0 < aa → 0 < ab → ContinuousOn (fun X => Real.sqrt (edgeWeight Xa Xb aa ab X) * edgeDist Xa Xb X ^ (-d)) (Set.Ioo Xa Xb) ∧ Filter.Tendsto (fun X => Real.sqrt (edgeWeight Xa Xb aa ab X) * edgeDist Xa Xb X ^ (-d)) (nhdsWithin Xa (Set.Ioo Xa Xb)) (nhds 0) ∧ Filter.Tendsto (fun X => Real.sqrt (edgeWeight Xa Xb aa ab X) * edgeDist Xa Xb X ^ (-d)) (nhdsWithin Xb (Set.Ioo Xa Xb)) (nhds 0)) → (∀ γ : Lab, ContDiffOn ℝ ∞ (etaL B.h γ) (DomC B.h B.qB)) → (∀ (γ : Lab), ∀ ξ ∈ DomC B.h B.qB, etaL B.h γ ξ = 0 → ∀ k : ℕ, iteratedFDeriv ℝ k (etaL B.h γ) ξ = 0) → ∀ (γ : Lab) (x : Cyl) (k : ℕ), lN ≤ γ.1 → ActiveL4 B G γ → x ∈ DomC B.h B.qB → B.Xa ≤ XC B.h x → XC B.h x ≤ B.Xb → (etaL B.h γ x = 0 ∨ XC B.h x = B.Xa ∨ XC B.h x = B.Xb) → Filter.Tendsto (fun y => iteratedFDeriv ℝ k (W0c4 B G γ) y) (nhdsWithin x {η : Cyl | η ∈ DomC B.h B.qB ∧ etaL B.h γ η ≠ 0 ∧ B.Xa < XC B.h η ∧ XC B.h η < B.Xb}) (nhds 0) :=
by
  intro B G hok hG lN c hc hND hL hE hEsm hEfl γ x k hlN hAct hxN hXa_le hXb_le hdisj
  have hS := hok.1
  obtain ⟨hh0, hh1, hXa, hXam1, hm12, hm2Xb, -, hqB0, hqB1, -, -, haa, hab⟩ := hok.2.1
  have hXab : B.Xa < B.Xb := by linarith
  have hA := sqrt_amp_bound_v5 B G hok hG lN c hc hND (yAmp4_smooth_v5 B G hok hG)
  choose CA bA dA hAi using hA.2

  obtain ⟨V1, hV1⟩ : ∃ V1 : Set Cyl, V1 = {η : Cyl | η ∈ DomC B.h B.qB ∧ etaL B.h γ η ≠ 0 ∧
      B.Xa < XC B.h η ∧ XC B.h η < B.Xb} := ⟨_, rfl⟩
  rw [← hV1]
  have hV1mem : ∀ y ∈ V1, y ∈ DomC B.h B.qB ∧ etaL B.h γ y ≠ 0 ∧ B.Xa < XC B.h y ∧
      XC B.h y < B.Xb := by
    intro y hy
    rw [hV1] at hy
    exact hy

  have hqpos : ∀ ξ : Cyl, ξ.2.2.1 < 1 → 0 < qC B.h ξ :=
    fun ξ ht => (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hcq : ContinuousOn (qC B.h) {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} := by
    have h1 := hS.2.2.2.1.continuousOn
    have h2 : Continuous (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) := by fun_prop
    refine h1.comp h2.continuousOn ?_
    intro ξ hξ
    exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by
      linarith [(show 0 < ξ.1 ∧ ξ.2.2.1 < 1 from hξ).2]⟩
  have hU : IsOpen {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} :=
    (isOpen_lt continuous_const continuous_fst).inter
      (isOpen_lt (continuous_fst.comp (continuous_snd.comp continuous_snd)) continuous_const)
  have hNo : IsOpen (DomC B.h B.qB) := by
    have := hcq.isOpen_inter_preimage hU (isOpen_Iio (a := B.qB))
    convert this using 1
    ext ξ
    simp only [DomC, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iio]
    tauto
  have hqx : 0 < qC B.h x := hqpos x hxN.2.1
  have hqc : ContinuousAt (qC B.h) x := hcq.continuousAt (hU.mem_nhds ⟨hxN.1, hxN.2.1⟩)
  have hXc : ContinuousAt (XC B.h) x := by
    have e : XC B.h = fun ξ : Cyl => ξ.1 ^ 2 / (2 * qC B.h ξ) := rfl
    rw [e]
    exact ((continuous_fst.pow 2).continuousAt).div (continuousAt_const.mul hqc)
      (mul_pos two_pos hqx).ne'
  have hSc : ContinuousAt (SC B.h) x := by
    have e : SC B.h = fun ξ : Cyl => (1 + |Real.log (qC B.h ξ)|) ^ 2 := rfl
    rw [e]
    exact (continuousAt_const.add (hqc.log hqx.ne').abs).pow 2
  have hSC1 : ∀ ξ : Cyl, 1 ≤ SC B.h ξ := fun ξ => by
    unfold SC; exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h ξ))])
  have hSpow : ∀ b : ℝ, ContinuousAt (fun y => SC B.h y ^ b) x := fun b =>
    hSc.rpow_const (Or.inl (lt_of_lt_of_le one_pos (hSC1 x)).ne')
  have hED : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 < edgeDist B.Xa B.Xb X := by
    intro X h1 h2
    have hX0 : 0 < X := lt_trans hXa h1
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr h1))
      (Real.log_pos ((one_lt_div hX0).mpr h2)))

  obtain ⟨M, hM0, hM⟩ := hL B.h (qC B.h x / 2) hh0.le (by linarith) (half_pos hqx)
  have hev_q : ∀ᶠ y in nhds x, qC B.h x / 2 < qC B.h y :=
    Filter.Tendsto.eventually_const_lt (half_lt_self hqx) hqc.tendsto
  have hxNn : DomC B.h B.qB ∈ nhds x := hNo.mem_nhds hxN

  obtain ⟨A, hAdef⟩ : ∃ A : Cyl → ℝ, A = fun η => Real.sqrt (max (yAmp4 B G γ η) 0) := ⟨_, rfl⟩
  obtain ⟨P, hPdef⟩ : ∃ P : Cyl → (Fin 3 → ℝ), P = fun η : Cyl =>
      (chig G.r0 (xiG B.h γ (G.ctr γ) η.2.2.2) * psiT (Lsb B.h G.r0 γ.1)
        (vco B.h G.r0 γ (G.ctr γ) η.2.2.2)) •
      G.tH γ (η.1, η.2.1, η.2.2.1) (vco B.h G.r0 γ (G.ctr γ) η.2.2.2) := ⟨_, rfl⟩
  have hPsm : ContDiffOn ℝ ∞ P (DomC B.h B.qB) := by
    rw [hPdef]; exact pulse_profile_smooth_v5 B G hok hG γ
  obtain ⟨Eb, hEb⟩ : ∃ Eb : Cyl → ℝ, Eb = fun y =>
      ∑ i ∈ Finset.range (k + 1), M ^ i * ‖iteratedFDeriv ℝ i (etaL B.h γ) y‖ := ⟨_, rfl⟩
  obtain ⟨Pb, hPb⟩ : ∃ Pb : Cyl → ℝ, Pb = fun y =>
      ∑ i ∈ Finset.range (k + 1), M ^ i * ‖iteratedFDeriv ℝ i P y‖ := ⟨_, rfl⟩
  obtain ⟨Ab, hAb⟩ : ∃ Ab : Cyl → ℝ, Ab = fun y =>
      ∑ i ∈ Finset.range (k + 1), |CA i| * SC B.h y ^ (bA i) *
        (Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h y)) *
          edgeDist B.Xa B.Xb (XC B.h y) ^ (-(dA i))) := ⟨_, rfl⟩
  have hsum_le : ∀ (f : ℕ → ℝ) (i : ℕ), i ≤ k → (∀ j, 0 ≤ f j) →
      f i ≤ ∑ j ∈ Finset.range (k + 1), f j :=
    fun f i hi hf => Finset.single_le_sum (fun j _ => hf j) (Finset.mem_range.mpr (by omega))

  have hbound : ∀ᶠ y in nhdsWithin x V1, ‖iteratedFDeriv ℝ k (W0c4 B G γ) y‖ ≤
      M ^ k * (|Real.sqrt (epsb B.h γ.1) / 2| * 3 ^ k * Eb y * Ab y * Pb y) := by
    filter_upwards [self_mem_nhdsWithin, hev_q.filter_mono nhdsWithin_le_nhds] with y hyV hyq
    obtain ⟨hyN, hyη, hy1, hy2⟩ := hV1mem y hyV
    have hq0 : qC B.h x / 2 ≤ qC B.h y := hyq.le
    have hq1 : qC B.h y ≤ 1 := le_trans hyN.2.2.le hqB1
    have hyNn : DomC B.h B.qB ∈ nhds y := hNo.mem_nhds hyN
    have hev : W0c4 B G γ =ᶠ[nhds y]
        fun η => (Real.sqrt (epsb B.h γ.1) / 2 * etaL B.h γ η * A η) • P η :=
      Filter.eventuallyEq_of_mem hyNn (fun η hη => by
        rw [hAdef, hPdef]; exact (w0c4_support_v5 B G hok hG γ η hη).1 hAct)
    have hNBeq : NB B.h (W0c4 B G γ) k y =
        NB B.h (fun η => (Real.sqrt (epsb B.h γ.1) / 2 * etaL B.h γ η * A η) • P η) k y := by
      unfold NB; rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    have hEi : ∀ i, i ≤ k → NB B.h (etaL B.h γ) i y ≤ Eb y := by
      intro i hi
      rw [hEb]
      exact le_trans (hM y hq0 hq1 (etaL B.h γ) i).2
        (hsum_le (fun j => M ^ j * ‖iteratedFDeriv ℝ j (etaL B.h γ) y‖) i hi
          (fun j => mul_nonneg (pow_nonneg hM0 j) (norm_nonneg _)))
    have hPi : ∀ i, i ≤ k → NB B.h P i y ≤ Pb y := by
      intro i hi
      rw [hPb]
      exact le_trans (hM y hq0 hq1 P i).2
        (hsum_le (fun j => M ^ j * ‖iteratedFDeriv ℝ j P y‖) i hi
          (fun j => mul_nonneg (pow_nonneg hM0 j) (norm_nonneg _)))
    have hAcd : ContDiffAt ℝ ∞ A y := by
      rw [hAdef]; exact hA.1 γ y hlN hAct hyη hyN hy1 hy2
    have hAi' : ∀ i, i ≤ k → NB B.h A i y ≤ Ab y := by
      intro i hi
      have h1 : NB B.h A i y ≤ CA i * SC B.h y ^ bA i *
          Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h y)) *
          edgeDist B.Xa B.Xb (XC B.h y) ^ (-dA i) := by
        rw [hAdef]; exact hAi i γ y hlN hAct hyη hyN hy1 hy2
      have hz : 0 ≤ Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h y)) *
          edgeDist B.Xa B.Xb (XC B.h y) ^ (-(dA i)) :=
        mul_nonneg (Real.sqrt_nonneg _) (Real.rpow_nonneg (hED _ hy1 hy2).le _)
      have h2 : CA i * SC B.h y ^ bA i *
          Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h y)) *
          edgeDist B.Xa B.Xb (XC B.h y) ^ (-dA i) ≤ |CA i| * SC B.h y ^ bA i *
          (Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h y)) *
            edgeDist B.Xa B.Xb (XC B.h y) ^ (-(dA i))) := by
        rw [mul_assoc (CA i * SC B.h y ^ bA i)]
        exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_abs_self _)
          (Real.rpow_nonneg (by linarith [hSC1 y]) _)) hz
      rw [hAb]
      refine le_trans h1 (le_trans h2 ?_)
      exact hsum_le (fun j => |CA j| * SC B.h y ^ bA j *
          (Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h y)) *
            edgeDist B.Xa B.Xb (XC B.h y) ^ (-(dA j)))) i hi
        (fun j => mul_nonneg (mul_nonneg (abs_nonneg _)
          (Real.rpow_nonneg (by linarith [hSC1 y]) _))
          (mul_nonneg (Real.sqrt_nonneg _) (Real.rpow_nonneg (hED _ hy1 hy2).le _)))
    have hL3 := nb_triple_leibniz B.h (Real.sqrt (epsb B.h γ.1) / 2) y (etaL B.h γ) A P k
      (Eb y) (Ab y) (Pb y) ((hEsm γ).contDiffAt hyNn) hAcd (hPsm.contDiffAt hyNn) hEi hAi' hPi
    calc ‖iteratedFDeriv ℝ k (W0c4 B G γ) y‖ ≤ M ^ k * NB B.h (W0c4 B G γ) k y :=
          (hM y hq0 hq1 (W0c4 B G γ) k).1
      _ = M ^ k * NB B.h (fun η => (Real.sqrt (epsb B.h γ.1) / 2 * etaL B.h γ η * A η) • P η)
            k y := by rw [hNBeq]
      _ ≤ M ^ k * (|Real.sqrt (epsb B.h γ.1) / 2| * 3 ^ k * Eb y * Ab y * Pb y) :=
          mul_le_mul_of_nonneg_left hL3 (pow_nonneg hM0 k)

  have hEbT : Filter.Tendsto Eb (nhds x) (nhds (Eb x)) := by
    simp only [hEb]
    exact tendsto_finsetSum _ (fun i _ => (continuousAt_const.mul
      (((hEsm γ).contDiffAt hxNn).continuousAt_iteratedFDeriv
        (by exact_mod_cast le_top)).norm).tendsto)
  have hPbT : Filter.Tendsto Pb (nhds x) (nhds (Pb x)) := by
    simp only [hPb]
    exact tendsto_finsetSum _ (fun i _ => (continuousAt_const.mul
      ((hPsm.contDiffAt hxNn).continuousAt_iteratedFDeriv
        (by exact_mod_cast le_top)).norm).tendsto)
  have hXT : ∀ Z : ℝ, XC B.h x = Z →
      Filter.Tendsto (XC B.h) (nhdsWithin x V1) (nhdsWithin Z (Set.Ioo B.Xa B.Xb)) := by
    intro Z hZ
    apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
    · rw [← hZ]; exact hXc.tendsto.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with y hy
      obtain ⟨-, -, h1, h2⟩ := hV1mem y hy
      exact ⟨h1, h2⟩
  have hAbEdge : (XC B.h x = B.Xa ∨ XC B.h x = B.Xb) →
      Filter.Tendsto Ab (nhdsWithin x V1) (nhds 0) := by
    intro hed
    have hlim : ∀ i, Filter.Tendsto (fun y => Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h y)) *
        edgeDist B.Xa B.Xb (XC B.h y) ^ (-(dA i))) (nhdsWithin x V1) (nhds 0) := by
      intro i
      obtain ⟨-, hla, hlb⟩ := hE B.Xa B.Xb B.aa B.ab (dA i) hXa hXab haa hab
      rcases hed with h | h
      · exact hla.comp (hXT _ h)
      · exact hlb.comp (hXT _ h)
    have := tendsto_finsetSum (Finset.range (k + 1)) (fun i _ =>
      ((tendsto_const_nhds (x := |CA i|)).mul
        ((hSpow (bA i)).tendsto.mono_left nhdsWithin_le_nhds)).mul (hlim i))
    simp only [mul_zero, Finset.sum_const_zero] at this
    rw [hAb]
    exact this
  have hAbInt : B.Xa < XC B.h x → XC B.h x < B.Xb →
      Filter.Tendsto Ab (nhdsWithin x V1) (nhds (Ab x)) := by
    intro h1 h2
    have hcA : ∀ i, ContinuousAt (fun y => Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h y)) *
        edgeDist B.Xa B.Xb (XC B.h y) ^ (-(dA i))) x := by
      intro i
      obtain ⟨hcon, -, -⟩ := hE B.Xa B.Xb B.aa B.ab (dA i) hXa hXab haa hab
      exact (hcon.continuousAt (Ioo_mem_nhds h1 h2)).comp hXc
    simp only [hAb]
    refine Filter.Tendsto.mono_left ?_ nhdsWithin_le_nhds
    exact tendsto_finsetSum _ (fun i _ =>
      ((tendsto_const_nhds (x := |CA i|)).mul (hSpow (bA i)).tendsto).mul (hcA i).tendsto)

  refine squeeze_zero_norm' hbound ?_
  by_cases hed : XC B.h x = B.Xa ∨ XC B.h x = B.Xb
  · have := ((((tendsto_const_nhds (x := |Real.sqrt (epsb B.h γ.1) / 2| * (3:ℝ) ^ k)).mul
      (hEbT.mono_left nhdsWithin_le_nhds)).mul (hAbEdge hed)).mul
      (hPbT.mono_left nhdsWithin_le_nhds)).const_mul (M ^ k)
    simp only [mul_zero, zero_mul] at this
    exact this
  · push_neg at hed
    have h1 : B.Xa < XC B.h x := lt_of_le_of_ne hXa_le (Ne.symm hed.1)
    have h2 : XC B.h x < B.Xb := lt_of_le_of_ne hXb_le hed.2
    have he0 : etaL B.h γ x = 0 := by
      rcases hdisj with h | h | h
      · exact h
      · exact absurd h hed.1
      · exact absurd h hed.2
    have hEx : Eb x = 0 := by
      rw [hEb]
      simp only [hEfl γ x hxN he0, norm_zero, mul_zero, Finset.sum_const_zero]
    have := ((((tendsto_const_nhds (x := |Real.sqrt (epsb B.h γ.1) / 2| * (3:ℝ) ^ k)).mul
      (hEbT.mono_left nhdsWithin_le_nhds)).mul (hAbInt h1 h2)).mul
      (hPbT.mono_left nhdsWithin_le_nhds)).const_mul (M ^ k)
    rw [hEx] at this
    simp only [mul_zero, zero_mul] at this
    exact this

theorem w0c4_smooth_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (lN : ℕ) (c : ℝ), 0 < c → PrimNondegAt4 B G lN c → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ γ : Lab, ContDiffOn ℝ ∞ (W0c4 B G γ) (DomC B.h (qsOf l0)) ∧ ∀ ξ ∈ DomC B.h (qsOf l0), etaL B.h γ ξ = 0 → ∀ k : ℕ, iteratedFDeriv ℝ k (W0c4 B G γ) ξ = 0 :=
by
  intro B G hok hG lN c hc hND
  have hS := hok.1
  obtain ⟨-, -, hXa, hXam1, hm12, hm2Xb, -, hqB0, -, -, -, haa, hab⟩ := hok.2.1
  obtain ⟨hEsm, hEfl, -, -⟩ := etaL_class_v5 B hok
  have hA := sqrt_amp_bound_v5 B G hok hG lN c hc hND (yAmp4_smooth_v5 B G hok hG)
  have hJ := w0c4_jet_tendsto_v5 B G hok hG lN c hc hND lnorm_two_sided_bound_v5 edge_factor_limits_v5
    hEsm hEfl
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨lN + n0, fun l0 hl0 γ => ?_⟩

  have hQb : ∀ n : ℕ, Qb n = (1/2:ℝ) ^ n := by
    intro n
    show (2:ℝ) ^ (-(n:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 < B.qB := by
    show Qb l0 < _
    rw [hQb]
    exact lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0
  have hDom : ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ DomC B.h B.qB :=
    fun ξ hξ => ⟨hξ.1, hξ.2.1, lt_trans hξ.2.2 hqsB⟩
  have hqpos : ∀ ξ : Cyl, ξ.2.2.1 < 1 → 0 < qC B.h ξ :=
    fun ξ ht => (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hcq : ContinuousOn (qC B.h) {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} := by
    have h1 := hS.2.2.2.1.continuousOn
    have h2 : Continuous (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) := by fun_prop
    refine h1.comp h2.continuousOn ?_
    intro ξ hξ
    exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by
      linarith [(show 0 < ξ.1 ∧ ξ.2.2.1 < 1 from hξ).2]⟩
  have hOpen : ∀ q : ℝ, IsOpen (DomC B.h q) := by
    intro q
    have hU : IsOpen {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} :=
      (isOpen_lt continuous_const continuous_fst).inter
        (isOpen_lt (continuous_fst.comp (continuous_snd.comp continuous_snd)) continuous_const)
    have := hcq.isOpen_inter_preimage hU (isOpen_Iio (a := q))
    convert this using 1
    ext ξ
    simp only [DomC, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iio]
    tauto
  have hXC : ContinuousOn (XC B.h) {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} := by
    have e : XC B.h = fun ξ : Cyl => ξ.1 ^ 2 / (2 * qC B.h ξ) := rfl
    rw [e]
    have h1 : ContinuousOn (fun ξ : Cyl => ξ.1 ^ 2) {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} :=
      (continuous_fst.pow 2).continuousOn
    have h2 : ContinuousOn (fun ξ : Cyl => 2 * qC B.h ξ) {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} :=
      continuousOn_const.mul hcq
    refine h1.div h2 (fun ξ hξ => ?_)
    have := hqpos ξ (show 0 < ξ.1 ∧ ξ.2.2.1 < 1 from hξ).2
    positivity
  have hlev : ∀ ξ ∈ DomC B.h (qsOf l0), etaL B.h γ ξ ≠ 0 → l0 ≤ γ.1 := by
    intro ξ hξ he
    have hq : 0 < qC B.h ξ := hqpos ξ hξ.2.1
    have h1 : sqPart 1 (-(γ.1:ℤ)) (Real.logb 2 (qC B.h ξ)) ≠ 0 := left_ne_zero_of_mul he
    unfold sqPart at h1
    have h2 := (div_ne_zero_iff.mp h1).1
    unfold bumpR at h2
    simp only [Int.cast_neg, Int.cast_natCast, div_one, sub_neg_eq_add] at h2
    have h3 : (Real.logb 2 (qC B.h ξ) + (γ.1:ℝ)) ^ 2 < 1 := by
      by_contra hcon
      exact h2 (Real.smoothTransition.zero_of_nonpos (by linarith [not_lt.mp hcon]))
    have h4 := (abs_lt.mp ((sq_lt_one_iff_abs_lt_one _).mp h3)).1
    have h5 : Real.logb 2 (qC B.h ξ) < -(l0:ℝ) :=
      (Real.logb_lt_iff_lt_rpow (by norm_num) hq).2 hξ.2.2
    have h6 : (l0:ℝ) < (γ.1:ℝ) + 1 := by linarith
    have h7 : l0 < γ.1 + 1 := by exact_mod_cast h6
    omega
  have hz0 : ∀ (k : ℕ) (ξ : Cyl), iteratedFDeriv ℝ k (fun _ : Cyl => (0 : Fin 3 → ℝ)) ξ = 0 := by
    intro k ξ
    have h := (iteratedFDeriv_fun_zero : iteratedFDeriv ℝ k (fun _ : Cyl => (0 : Fin 3 → ℝ)) = 0)
    exact congrFun h ξ
  have hUo := hOpen (qsOf l0)

  by_cases hM : ActiveL4 B G γ ∧ l0 ≤ γ.1
  swap
  ·
    have hZ : ∀ η ∈ DomC B.h (qsOf l0), W0c4 B G γ η = 0 := by
      intro η hη
      by_contra hne
      obtain ⟨-, hAct, heta, -, -, -⟩ := (w0c4_support_v5 B G hok hG γ η (hDom η hη)).2 hne
      exact hM ⟨hAct, hlev η hη heta⟩
    refine ⟨contDiffOn_const.congr hZ, fun ξ hξ _ k => ?_⟩
    have hev : W0c4 B G γ =ᶠ[nhds ξ] fun _ => (0 : Fin 3 → ℝ) :=
      Filter.eventuallyEq_of_mem (hUo.mem_nhds hξ) hZ
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    exact hz0 k ξ

  obtain ⟨hAct, hlγ⟩ := hM
  have hlN : lN ≤ γ.1 := by omega
  have hW0 : ∀ η ∈ DomC B.h B.qB,
      ¬(etaL B.h γ η ≠ 0 ∧ B.Xa < XC B.h η ∧ XC B.h η < B.Xb) → W0c4 B G γ η = 0 := by
    intro η hη hn
    by_contra hne
    obtain ⟨-, -, he, h1, h2, -⟩ := (w0c4_support_v5 B G hok hG γ η hη).2 hne
    exact hn ⟨he, h1, h2⟩
  have hsubU : DomC B.h (qsOf l0) ⊆ {ξ : Cyl | 0 < ξ.1 ∧ ξ.2.2.1 < 1} :=
    fun ξ hξ => ⟨hξ.1, hξ.2.1⟩
  have hXCU : ContinuousOn (XC B.h) (DomC B.h (qsOf l0)) := hXC.mono hsubU
  have hEU : ContinuousOn (etaL B.h γ) (DomC B.h (qsOf l0)) :=
    (hEsm γ).continuousOn.mono (fun ξ hξ => hDom ξ hξ)

  have hO : IsOpen {p : ℝ × ℝ | (p.1 ≠ 0 ∧ B.Xa < p.2 ∧ p.2 < B.Xb) ∨ p.2 < B.Xa ∨ B.Xb < p.2} := by
    show IsOpen ({p : ℝ × ℝ | p.1 ≠ 0} ∩ ({p : ℝ × ℝ | B.Xa < p.2} ∩ {p : ℝ × ℝ | p.2 < B.Xb}) ∪
      ({p : ℝ × ℝ | p.2 < B.Xa} ∪ {p : ℝ × ℝ | B.Xb < p.2}))
    exact ((isOpen_ne_fun continuous_fst continuous_const).inter
      ((isOpen_lt continuous_const continuous_snd).inter (isOpen_lt continuous_snd continuous_const))).union
      ((isOpen_lt continuous_snd continuous_const).union (isOpen_lt continuous_const continuous_snd))
  have hO2 : IsOpen {p : ℝ | p < B.Xa ∨ B.Xb < p} := by
    show IsOpen ({p : ℝ | p < B.Xa} ∪ {p : ℝ | B.Xb < p})
    exact (isOpen_lt continuous_id continuous_const).union (isOpen_lt continuous_const continuous_id)
  obtain ⟨V, hVdef⟩ : ∃ V : Set Cyl, V = {η : Cyl | η ∈ DomC B.h (qsOf l0) ∧
      ((etaL B.h γ η ≠ 0 ∧ B.Xa < XC B.h η ∧ XC B.h η < B.Xb) ∨ XC B.h η < B.Xa ∨ B.Xb < XC B.h η)} :=
    ⟨_, rfl⟩
  obtain ⟨W23, hWdef⟩ : ∃ W : Set Cyl, W = {η : Cyl | η ∈ DomC B.h (qsOf l0) ∧
      (XC B.h η < B.Xa ∨ B.Xb < XC B.h η)} := ⟨_, rfl⟩
  have hVo : IsOpen V := by
    have := (hEU.prodMk hXCU).isOpen_inter_preimage hUo hO
    rw [hVdef]
    exact this
  have hWo : IsOpen W23 := by
    have := hXCU.isOpen_inter_preimage hUo hO2
    rw [hWdef]
    exact this
  have hW23ev : ∀ y ∈ W23, W0c4 B G γ =ᶠ[nhds y] fun _ => (0 : Fin 3 → ℝ) := by
    intro y hy
    apply Filter.eventuallyEq_of_mem (hWo.mem_nhds hy)
    intro η hη
    rw [hWdef] at hη
    apply hW0 η (hDom η hη.1)
    rintro ⟨-, h1, h2⟩
    rcases hη.2 with h | h <;> linarith

  have hsmV : ContDiffOn ℝ ∞ (W0c4 B G γ) V := by
    intro y hy
    apply ContDiffAt.contDiffWithinAt
    rw [hVdef] at hy
    obtain ⟨hyU, hy2⟩ := hy
    rcases hy2 with ⟨he, h1, h2⟩ | h
    · have hyN := hDom y hyU
      have hNy := (hOpen B.qB).mem_nhds hyN
      have hev : W0c4 B G γ =ᶠ[nhds y] fun η => (Real.sqrt (epsb B.h γ.1) / 2 * etaL B.h γ η *
          Real.sqrt (max (yAmp4 B G γ η) 0)) • ((chig G.r0 (xiG B.h γ (G.ctr γ) η.2.2.2) *
          psiT (Lsb B.h G.r0 γ.1) (vco B.h G.r0 γ (G.ctr γ) η.2.2.2)) •
          G.tH γ (η.1, η.2.1, η.2.2.1) (vco B.h G.r0 γ (G.ctr γ) η.2.2.2)) :=
        Filter.eventuallyEq_of_mem hNy (fun η hη => (w0c4_support_v5 B G hok hG γ η hη).1 hAct)
      refine ContDiffAt.congr_of_eventuallyEq ?_ hev
      exact ((contDiffAt_const.mul ((hEsm γ).contDiffAt hNy)).mul
        (hA.1 γ y hlN hAct he hyN h1 h2)).smul
        ((pulse_profile_smooth_v5 B G hok hG γ).contDiffAt hNy)
    · have hyW : y ∈ W23 := by rw [hWdef]; exact ⟨hyU, h⟩
      exact contDiffAt_const.congr_of_eventuallyEq (hW23ev y hyW)

  have hUV : ∀ x ∈ DomC B.h (qsOf l0), x ∉ V → W0c4 B G γ x = 0 ∧ B.Xa ≤ XC B.h x ∧
      XC B.h x ≤ B.Xb ∧ (etaL B.h γ x = 0 ∨ XC B.h x = B.Xa ∨ XC B.h x = B.Xb) := by
    intro x hx hxV
    have hn : ¬((etaL B.h γ x ≠ 0 ∧ B.Xa < XC B.h x ∧ XC B.h x < B.Xb) ∨
