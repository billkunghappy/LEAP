        hbm (y - rfpY5 P.Md P.lam + 1) (by linarith), mul_zero, sub_zero]
    unfold rfpF rfpE
    rw [← hydef, hTh1, hPsi, mul_zero, add_zero, Real.sqrt_one, mul_one, Real.rpow_one, hEl]
  exact ⟨hU, hF⟩

theorem rfp_inner_power_profile : ∀ Md Pst lam : ℝ, 0 < Md → 0 < Pst → 0 ≤ lam → ContinuousOn (fun x => Real.sqrt (2 * x) * rinC Md Pst lam (Real.log x)) (Set.Ici 0) ∧ ContinuousOn (fun x => rfpK Md (Real.log x)) (Set.Ici 0) ∧ 0 < Real.sqrt (2 * Real.exp (rfpY2 Md + 1)) * rinC Md Pst lam (Real.log (Real.exp (rfpY2 Md + 1))) ∧ (∀ x : ℝ, Real.exp (rfpY2 Md + 1) ≤ x → Real.sqrt (2 * x) * rinC Md Pst lam (Real.log x) = Real.sqrt (2 * Real.exp (rfpY2 Md + 1)) * rinC Md Pst lam (Real.log (Real.exp (rfpY2 Md + 1))) * (x / Real.exp (rfpY2 Md + 1)) ^ (-lam)) ∧ (∀ x : ℝ, Real.exp (rfpY2 Md + 1) ≤ x → rfpK Md (Real.log x) = 0) :=
by
  intro Md Pst lam hMd hPst hlam
  obtain ⟨-, hgc, hgpos, -, -, -⟩ := rin_g_profile Md Pst lam hMd hPst hlam
  obtain ⟨hkc, -, -, hk0, -, -⟩ := rin_k_profile Md hMd
  obtain ⟨-, -, -, -, -, -, h7, -, -⟩ := rfp_sig_basics
  have hy2 : 11 ≤ rfpY2 Md := by unfold rfpY2; linarith [Real.exp_pos Md]
  have hX0 : 0 < Real.exp (rfpY2 Md + 1) := Real.exp_pos _

  have tail : ∀ y : ℝ, rfpY2 Md + 1 ≤ y → rinC Md Pst lam y =
      rinC Md Pst lam (rfpY2 Md + 1) * Real.exp (-(1 / 2 + lam) * (y - (rfpY2 Md + 1))) := by
    intro y hy
    have e1 := h7 y (by linarith)
    have e2 := h7 (y - rfpY2 Md) (by linarith)
    have e3 := h7 (rfpY2 Md + 1) (by linarith)
    have e4 : rfpY2 Md + 1 - rfpY2 Md = 1 := by ring
    simp only [rinC]
    rw [e1, e2, e3, e4, mul_assoc, ← Real.exp_add]
    congr 1
    apply congrArg
    ring
  refine ⟨hgc, hkc, hgpos _ hX0, ?_, ?_⟩
  · intro x hx
    have hx0 : 0 < x := lt_of_lt_of_le hX0 hx
    have hy : rfpY2 Md + 1 ≤ Real.log x := by
      have := Real.log_le_log hX0 hx
      rwa [Real.log_exp] at this
    rw [Real.log_exp, tail (Real.log x) hy]
    have hsx : Real.sqrt (2 * x) = Real.sqrt 2 * Real.exp (Real.log x / 2) := by
      rw [Real.sqrt_mul (by norm_num), Real.exp_half, Real.exp_log hx0]
    have hsX : Real.sqrt (2 * Real.exp (rfpY2 Md + 1)) =
        Real.sqrt 2 * Real.exp ((rfpY2 Md + 1) / 2) := by
      rw [Real.sqrt_mul (by norm_num), Real.exp_half]
    have hp : (x / Real.exp (rfpY2 Md + 1)) ^ (-lam) =
        Real.exp ((Real.log x - (rfpY2 Md + 1)) * (-lam)) := by
      rw [Real.rpow_def_of_pos (div_pos hx0 hX0), Real.log_div hx0.ne' hX0.ne', Real.log_exp]
    rw [hsx, hsX, hp]
    have key : Real.exp (Real.log x / 2) * Real.exp (-(1 / 2 + lam) * (Real.log x - (rfpY2 Md + 1))) =
        Real.exp ((rfpY2 Md + 1) / 2) * Real.exp ((Real.log x - (rfpY2 Md + 1)) * (-lam)) := by
      rw [← Real.exp_add, ← Real.exp_add]
      apply congrArg
      ring
    linear_combination (Real.sqrt 2 * rinC Md Pst lam (rfpY2 Md + 1)) * key
  · intro x hx
    apply hk0
    refine le_trans (Real.exp_le_exp.2 ?_) hx
    unfold rfpY2
    linarith

theorem rinQ_power_region : ∀ (h η lam X0 G0 : ℝ) (c k : ℝ → ℝ), 0 < X0 → 0 < G0 → lam < 1 → ContinuousOn (fun x => Real.sqrt (2 * x) * c (Real.log x)) (Set.Ici 0) → ContinuousOn (fun x => k (Real.log x)) (Set.Ici 0) → (∀ x : ℝ, X0 ≤ x → Real.sqrt (2 * x) * c (Real.log x) = G0 * (x / X0) ^ (-lam)) → (∀ x : ℝ, X0 ≤ x → k (Real.log x) = 0) → ∀ X : ℝ, X0 ≤ X → X * rinQf h c k X η = -X + (1 - 2 * h * η ^ 2) * rinMom (fun x => k (Real.log x)) X0 + (X / X0) ^ lam * (X0 * rinQf h c k X0 η + X0 - (1 - 2 * h * η ^ 2) * rinMom (fun x => k (Real.log x)) X0) + (1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2))) * X0 * (X / X0 - (X / X0) ^ lam) / (1 - lam) :=
by
  intro h η lam X0 G0 c k hX0 hG0 hlam hgc hkc hg hk X hX
  have hXpos : 0 < X := lt_of_lt_of_le hX0 hX
  have h1l : (1 - lam) ≠ 0 := by
    intro h0
    linarith

  have hsplit : ∀ f : ℝ → ℝ, ContinuousOn f (Set.Ici 0) →
      rinMom f X = rinMom f X0 + ∫ x in X0..X, f x := by
    intro f hf
    unfold rinMom
    refine (intervalIntegral.integral_add_adjacent_intervals ?_ ?_).symm
    · apply ContinuousOn.intervalIntegrable
      apply hf.mono
      rw [Set.uIcc_of_le hX0.le]
      exact Set.Icc_subset_Ici_self
    · apply ContinuousOn.intervalIntegrable
      apply hf.mono
      rw [Set.uIcc_of_le hX]
      intro x hx
      exact le_trans hX0.le hx.1
  have hI := hsplit (fun x => Real.sqrt (2 * x) * c (Real.log x)) hgc
  have hM := hsplit (fun x => k (Real.log x)) hkc
  have hJ := hsplit (fun x => k (Real.log x) * (Real.sqrt (2 * x) * c (Real.log x))) (hkc.mul hgc)

  have hk0 : ∫ x in X0..X, k (Real.log x) = 0 := by
    rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ)) ?_]
    · simp
    · intro x hx
      rw [Set.uIcc_of_le hX] at hx
      simp only [hk x hx.1]
  have hJ0 : ∫ x in X0..X, k (Real.log x) * (Real.sqrt (2 * x) * c (Real.log x)) = 0 := by
    rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ)) ?_]
    · simp
    · intro x hx
      rw [Set.uIcc_of_le hX] at hx
      simp only [hk x hx.1, zero_mul]
  have hItail : ∫ x in X0..X, Real.sqrt (2 * x) * c (Real.log x)
      = ∫ x in X0..X, G0 * (x / X0) ^ (-lam) := by
    apply intervalIntegral.integral_congr
    intro x hx
    rw [Set.uIcc_of_le hX] at hx
    simp only [hg x hx.1]

  have hpow : ∫ x in X0..X, G0 * (x / X0) ^ (-lam)
      = G0 * X0 * ((X / X0) ^ (1 - lam) - 1) / (1 - lam) := by
    have hderiv : ∀ x ∈ Set.uIcc X0 X,
        HasDerivAt (fun y => G0 * X0 * (y / X0) ^ (1 - lam) / (1 - lam))
          (G0 * (x / X0) ^ (-lam)) x := by
      intro x hx
      rw [Set.uIcc_of_le hX] at hx
      have hxpos : 0 < x / X0 := div_pos (lt_of_lt_of_le hX0 hx.1) hX0
      have h1 := ((((hasDerivAt_id' x).div_const X0).rpow_const (p := 1 - lam)
        (Or.inl hxpos.ne')).const_mul (G0 * X0)).div_const (1 - lam)
      convert h1 using 1
      have e : (1 - lam - 1) = -lam := by ring
      rw [e]
      field_simp
    have hint : IntervalIntegrable (fun x => G0 * (x / X0) ^ (-lam)) MeasureTheory.volume X0 X := by
      apply ContinuousOn.intervalIntegrable
      apply continuousOn_const.mul
      apply (continuousOn_id.div_const X0).rpow_const
      intro x hx
      rw [Set.uIcc_of_le hX] at hx
      left
      exact (div_pos (lt_of_lt_of_le hX0 hx.1) hX0).ne'
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint]
    simp only [div_self hX0.ne', Real.one_rpow]
    ring

  have hgX := hg X hX
  have hgX0 : Real.sqrt (2 * X0) * c (Real.log X0) = G0 := by
    rw [hg X0 le_rfl, div_self hX0.ne', Real.one_rpow, mul_one]
  have ht0 : 0 < X / X0 := div_pos hXpos hX0
  have hneg : (X / X0) ^ (-lam) = ((X / X0) ^ lam)⁻¹ := Real.rpow_neg ht0.le lam
  have hsub : (X / X0) ^ (1 - lam) = (X / X0) / (X / X0) ^ lam := by
    rw [Real.rpow_sub ht0, Real.rpow_one]
  have hu : 0 < (X / X0) ^ lam := Real.rpow_pos_of_pos ht0 lam

  simp only [rinQf]
  rw [hI, hM, hJ, hItail, hpow, hk0, hJ0, hgX, hgX0, hneg, hsub]
  generalize (X / X0) ^ lam = u at hu ⊢
  generalize (1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2))) = A
  generalize ((1 - η ^ 2) * (1 - 2 * η ^ 2 / (1 + η ^ 2)) + (1 - 4 * h) * η ^ 2) = B
  generalize (1 - 2 * h * η ^ 2) = L
  have hXne : X ≠ 0 := hXpos.ne'
  have hX0ne : X0 ≠ 0 := hX0.ne'
  have hG0ne : G0 ≠ 0 := hG0.ne'
  have hune : u ≠ 0 := hu.ne'
  field_simp
  ring

theorem rinQ_anchor_X0 : ∀ Md Pst lam h η : ℝ, 0 < Md → 0 < Pst → 0 < lam → lam ≤ 1 / 100 → 0 < h → h ≤ Real.exp (-rfpY2 Md) / 1000 → -1 ≤ η → η ≤ 1 → Real.exp 1 / 5 + ((1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2))) - 1) * (Real.exp (rfpY2 Md + 1) - Real.exp 1) ≤ Real.exp (rfpY2 Md + 1) * rinQf h (rinC Md Pst lam) (rfpK Md) (Real.exp (rfpY2 Md + 1)) η ∧ 0 ≤ rinMom (fun x => rfpK Md (Real.log x)) (Real.exp (rfpY2 Md + 1)) ∧ rinMom (fun x => rfpK Md (Real.log x)) (Real.exp (rfpY2 Md + 1)) ≤ Real.exp (rfpY2 Md) :=
by
  intro Md Pst lam h η hMd hPst hl0 hl1 hh0 hhE he1 he2

  have flat : ∀ (h η G Xe X2 : ℝ) (c k : ℝ → ℝ), 0 < Xe → 0 < G → ContinuousOn (fun x => Real.sqrt (2 * x) * c (Real.log x)) (Set.Ici 0) → ContinuousOn (fun x => k (Real.log x)) (Set.Ici 0) → (∀ x : ℝ, Xe ≤ x → x ≤ X2 → Real.sqrt (2 * x) * c (Real.log x) = G) → (∀ x : ℝ, Xe ≤ x → x ≤ X2 → 0 ≤ k (Real.log x)) → 0 ≤ (1 - 2 * h * η ^ 2) - ((1 - η ^ 2) * (1 - 2 * η ^ 2 / (1 + η ^ 2)) + (1 - 4 * h) * η ^ 2) → ∀ X : ℝ, Xe ≤ X → X ≤ X2 → Xe * rinQf h c k Xe η + ((1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2))) - 1) * (X - Xe) ≤ X * rinQf h c k X η := by
    intro h η G Xe X2 c k hXe hG hgc hkc hflat hk0 hLB X h1 h2
    have hX : 0 < X := lt_of_lt_of_le hXe h1
    have hXeX2 : Xe ≤ X2 := h1.trans h2
    have hgXe : Real.sqrt (2 * Xe) * c (Real.log Xe) = G := hflat Xe le_rfl hXeX2
    have hgX : Real.sqrt (2 * X) * c (Real.log X) = G := hflat X h1 h2
    have hkgc : ContinuousOn (fun x => k (Real.log x) * (Real.sqrt (2 * x) * c (Real.log x)))
        (Set.Ici 0) := hkc.mul hgc
    have hsub1 : Set.Icc 0 Xe ⊆ Set.Ici (0:ℝ) := fun x hx => hx.1
    have hsub2 : Set.Icc Xe X ⊆ Set.Ici (0:ℝ) := fun x hx => le_trans hXe.le hx.1
    have hsplit : ∀ f : ℝ → ℝ, ContinuousOn f (Set.Ici 0) →
        rinMom f X = rinMom f Xe + ∫ x in Xe..X, f x := by
      intro f hf
      unfold rinMom
      exact (intervalIntegral.integral_add_adjacent_intervals
        ((hf.mono hsub1).intervalIntegrable_of_Icc hXe.le)
        ((hf.mono hsub2).intervalIntegrable_of_Icc h1)).symm
    have hEq : ∀ x ∈ Set.uIcc Xe X, Real.sqrt (2 * x) * c (Real.log x) = G := by
      intro x hx
      rw [Set.uIcc_of_le h1] at hx
      exact hflat x hx.1 (hx.2.trans h2)
    have hI : ∫ x in Xe..X, Real.sqrt (2 * x) * c (Real.log x) = (X - Xe) * G := by
      rw [intervalIntegral.integral_congr (g := fun _ => G) hEq, intervalIntegral.integral_const,
        smul_eq_mul]
    have hJ : ∫ x in Xe..X, k (Real.log x) * (Real.sqrt (2 * x) * c (Real.log x)) =
        (∫ x in Xe..X, k (Real.log x)) * G := by
      rw [← intervalIntegral.integral_mul_const]
      apply intervalIntegral.integral_congr
      intro x hx
      show k (Real.log x) * (Real.sqrt (2 * x) * c (Real.log x)) = k (Real.log x) * G
      rw [hEq x hx]
    have hD : 0 ≤ ∫ x in Xe..X, k (Real.log x) :=
      intervalIntegral.integral_nonneg h1 (fun u hu => hk0 u hu.1 (hu.2.trans h2))
    have key : ∀ (L A B M0 I0 J0 D : ℝ), 0 ≤ L - B → 0 ≤ D →
        Xe * (-(1 - L * M0 / Xe) + (A * I0 - B * J0) / (Xe * G)) + (A - 1) * (X - Xe) ≤
          X * (-(1 - L * (M0 + D) / X) + (A * (I0 + (X - Xe) * G) - B * (J0 + D * G)) / (X * G)) := by
      intro L A B M0 I0 J0 D hLB' hD'
      have hXne : X ≠ 0 := hX.ne'
      have hXene : Xe ≠ 0 := hXe.ne'
      have hGne : G ≠ 0 := hG.ne'
      have e1 : Xe * (-(1 - L * M0 / Xe) + (A * I0 - B * J0) / (Xe * G)) =
          -Xe + L * M0 + (A * I0 - B * J0) / G := by
        field_simp
        ring
      have e2 : X * (-(1 - L * (M0 + D) / X) + (A * (I0 + (X - Xe) * G) - B * (J0 + D * G)) / (X * G)) =
          -X + L * (M0 + D) + (A * I0 - B * J0) / G + A * (X - Xe) - B * D := by
        field_simp
        ring
      rw [e1, e2]
      have e3 : (-X + L * (M0 + D) + (A * I0 - B * J0) / G + A * (X - Xe) - B * D) -
          (-Xe + L * M0 + (A * I0 - B * J0) / G + (A - 1) * (X - Xe)) = (L - B) * D := by ring
      have hp : 0 ≤ (L - B) * D := mul_nonneg hLB' hD'
      linarith
    unfold rinQf
    rw [hsplit _ hkc, hsplit _ hgc, hsplit _ hkgc, hI, hJ, hgXe, hgX]
    exact key _ _ _ _ _ _ _ hLB hD

  have decr : ∀ (h η X0 : ℝ) (c k : ℝ → ℝ), 0 < X0 → ContinuousOn (fun x => Real.sqrt (2 * x) * c (Real.log x)) (Set.Ici 0) → ContinuousOn (fun x => k (Real.log x)) (Set.Ici 0) → (∀ x : ℝ, 0 < x → 0 < Real.sqrt (2 * x) * c (Real.log x)) → (∀ x X : ℝ, X0 ≤ x → x ≤ X → Real.sqrt (2 * X) * c (Real.log X) ≤ Real.sqrt (2 * x) * c (Real.log x)) → (∀ x : ℝ, X0 ≤ x → k (Real.log x) = 0) → 0 ≤ 1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2)) → 1 - 2 * h * η ^ 2 ≤ 1 → 0 ≤ rinMom (fun x => k (Real.log x)) X0 → rinMom (fun x => k (Real.log x)) X0 ≤ X0 → 0 ≤ rinQf h c k X0 η → ∀ X : ℝ, X0 ≤ X → X0 * rinQf h c k X0 η + ((1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2))) - 1) * (X - X0) ≤ X * rinQf h c k X η := by
    intro h η X0 c k hX0 hgc hkc hpos hmono hk0 hA hL hM0 hM1 hQ0 X h1
    have hX : 0 < X := lt_of_lt_of_le hX0 h1
    have g0pos : 0 < Real.sqrt (2 * X0) * c (Real.log X0) := hpos X0 hX0
    have gXpos : 0 < Real.sqrt (2 * X) * c (Real.log X) := hpos X hX
    have gle : Real.sqrt (2 * X) * c (Real.log X) ≤ Real.sqrt (2 * X0) * c (Real.log X0) :=
      hmono X0 X le_rfl h1
    have hkgc : ContinuousOn (fun x => k (Real.log x) * (Real.sqrt (2 * x) * c (Real.log x)))
        (Set.Ici 0) := hkc.mul hgc
    have hsub1 : Set.Icc 0 X0 ⊆ Set.Ici (0:ℝ) := fun x hx => hx.1
    have hsub2 : Set.Icc X0 X ⊆ Set.Ici (0:ℝ) := fun x hx => le_trans hX0.le hx.1
    have hsplit : ∀ f : ℝ → ℝ, ContinuousOn f (Set.Ici 0) →
        rinMom f X = rinMom f X0 + ∫ x in X0..X, f x := by
      intro f hf
      unfold rinMom
      exact (intervalIntegral.integral_add_adjacent_intervals
        ((hf.mono hsub1).intervalIntegrable_of_Icc hX0.le)
        ((hf.mono hsub2).intervalIntegrable_of_Icc h1)).symm
    have hK : ∫ x in X0..X, k (Real.log x) = 0 := by
      rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ)), intervalIntegral.integral_zero]
      intro x hx
      rw [Set.uIcc_of_le h1] at hx
      exact hk0 x hx.1
    have hJ : ∫ x in X0..X, k (Real.log x) * (Real.sqrt (2 * x) * c (Real.log x)) = 0 := by
      rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ)), intervalIntegral.integral_zero]
      intro x hx
      rw [Set.uIcc_of_le h1] at hx
      show k (Real.log x) * (Real.sqrt (2 * x) * c (Real.log x)) = 0
      rw [hk0 x hx.1, zero_mul]
    have hP : (X - X0) * (Real.sqrt (2 * X) * c (Real.log X)) ≤
        ∫ x in X0..X, Real.sqrt (2 * x) * c (Real.log x) := by
      have hm := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) h1
        (intervalIntegrable_const (c := Real.sqrt (2 * X) * c (Real.log X)))
        ((hgc.mono hsub2).intervalIntegrable_of_Icc (μ := MeasureTheory.volume) h1)
        (fun u hu => hmono u X hu.1 hu.2)
      rw [intervalIntegral.integral_const, smul_eq_mul] at hm
      exact hm
    have key : ∀ (L A B M0 I0 J0 P g0 gX : ℝ), 0 < g0 → 0 < gX → gX ≤ g0 → 0 ≤ A → L ≤ 1 →
        0 ≤ M0 → M0 ≤ X0 → (X - X0) * gX ≤ P →
        0 ≤ -(1 - L * M0 / X0) + (A * I0 - B * J0) / (X0 * g0) →
        X0 * (-(1 - L * M0 / X0) + (A * I0 - B * J0) / (X0 * g0)) + (A - 1) * (X - X0) ≤
          X * (-(1 - L * (M0 + 0) / X) + (A * (I0 + P) - B * (J0 + 0)) / (X * gX)) := by
      intro L A B M0 I0 J0 P g0 gX hg0 hgX hgle hA' hL' hM0' hM1' hP' hQ'
      have hXne : X ≠ 0 := hX.ne'
      have hX0ne : X0 ≠ 0 := hX0.ne'
      have hg0ne : g0 ≠ 0 := hg0.ne'
      have hgXne : gX ≠ 0 := hgX.ne'
      have e1 : X0 * (-(1 - L * M0 / X0) + (A * I0 - B * J0) / (X0 * g0)) =
          -X0 + L * M0 + (A * I0 - B * J0) / g0 := by
        field_simp
        ring
      have e2 : X * (-(1 - L * (M0 + 0) / X) + (A * (I0 + P) - B * (J0 + 0)) / (X * gX)) =
          -X + L * M0 + (A * I0 - B * J0) / gX + A * (P / gX) := by
        field_simp
        ring
      have hc : 0 ≤ -X0 + L * M0 + (A * I0 - B * J0) / g0 := by
        rw [← e1]; exact mul_nonneg hX0.le hQ'
      have hd : L * M0 ≤ M0 := mul_le_of_le_one_left hM0' hL'
      have hRg : 0 ≤ (A * I0 - B * J0) / g0 := by linarith
      have hR : 0 ≤ A * I0 - B * J0 := by
        have := mul_nonneg hRg hg0.le
        rwa [div_mul_cancel₀ _ hg0ne] at this
      have hf : (A * I0 - B * J0) / g0 ≤ (A * I0 - B * J0) / gX :=
        div_le_div_of_nonneg_left hR hgX hgle
      have hg : X - X0 ≤ P / gX := (le_div_iff₀ hgX).2 hP'
      have hg' : A * (X - X0) ≤ A * (P / gX) := mul_le_mul_of_nonneg_left hg hA'
      rw [e1, e2]
      linarith
    unfold rinQf at hQ0 ⊢
    rw [hsplit _ hkc, hsplit _ hgc, hsplit _ hkgc, hK, hJ]
    exact key _ _ _ _ _ _ _ _ _ g0pos gXpos gle hA hL hM0 hM1 hP hQ0

  have hy2 : Real.exp Md + 11 ≤ rfpY2 Md := by unfold rfpY2; linarith [Real.exp_pos Md]
  have hy2' : 11 ≤ rfpY2 Md := by linarith [Real.exp_pos Md]
  have he2' : 2 ≤ Real.exp 1 := by linarith [Real.add_one_le_exp 1]
  have heX2 : Real.exp 1 ≤ Real.exp (rfpY2 Md) := Real.exp_le_exp.2 (by linarith)
  have h20 : Real.exp (rfpY2 Md) ≤ Real.exp (rfpY2 Md + 1) := Real.exp_le_exp.2 (by linarith)
  have hEE : Real.exp (Real.exp Md) ≤ Real.exp (rfpY2 Md) := Real.exp_le_exp.2 (by linarith)
  have hX2pos : 0 < Real.exp (rfpY2 Md) := Real.exp_pos _
  have hEle : Real.exp (-rfpY2 Md) ≤ 1 := Real.exp_le_one_iff.2 (by linarith)
  have hh1 : h ≤ 1 / 1000 := by linarith
  have hη2 : η ^ 2 ≤ 1 := by nlinarith
  have hfrac : 0 ≤ 2 * η ^ 2 / (1 + η ^ 2) := by positivity
  have hA : 0 ≤ 1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2)) := by
    have := mul_nonneg (by linarith : (0:ℝ) ≤ 1 / 2 - h) hfrac
    linarith
  have hL : 1 - 2 * h * η ^ 2 ≤ 1 := by nlinarith [sq_nonneg η]
  have hLB : 0 ≤ (1 - 2 * h * η ^ 2) - ((1 - η ^ 2) * (1 - 2 * η ^ 2 / (1 + η ^ 2)) + (1 - 4 * h) * η ^ 2) := by
    have hu : 0 < 1 + η ^ 2 := by positivity
    have e : (1 - 2 * h * η ^ 2) - ((1 - η ^ 2) * (1 - 2 * η ^ 2 / (1 + η ^ 2)) + (1 - 4 * h) * η ^ 2)
        = (2 * η ^ 2 * (1 - η ^ 2) + 2 * h * η ^ 2 * (1 + η ^ 2)) / (1 + η ^ 2) := by
      rw [eq_div_iff hu.ne']
      field_simp
      ring
    rw [e]
    apply div_nonneg _ hu.le
    have t1 := mul_nonneg (sq_nonneg η) (by linarith : (0:ℝ) ≤ 1 - η ^ 2)
    have t2 := mul_nonneg (mul_nonneg hh0.le (sq_nonneg η)) hu.le
    nlinarith

  obtain ⟨-, hgc, hgpos, -, hgflat, hgmono⟩ := rin_g_profile Md Pst lam hMd hPst hl0.le
  obtain ⟨hkc, -, hkb, hkz, hM0, hM1⟩ := rin_k_profile Md hMd
  have hQe := (rfp_inner_Q_bounds Md Pst lam h hMd hPst hl0 hl1 hh0 hhE (Real.exp 1) η
    (Real.exp_pos 1) he1 he2).2.1 (by linarith) le_rfl
  have hQ2 := (rfp_inner_Q_bounds Md Pst lam h hMd hPst hl0 hl1 hh0 hhE (Real.exp (rfpY2 Md)) η
    hX2pos he1 he2).2.2.1 heX2 le_rfl
  have hQ2n : 0 ≤ rinQf h (rinC Md Pst lam) (rfpK Md) (Real.exp (rfpY2 Md)) η := by
    have : 0 ≤ (Real.exp 1 / Real.exp (rfpY2 Md) + η ^ 2) / 20 := by positivity
    linarith

  have hF := flat h η (Real.sqrt (2 * Real.exp 1) * rinC Md Pst lam (Real.log (Real.exp 1)))
    (Real.exp 1) (Real.exp (rfpY2 Md)) (rinC Md Pst lam) (rfpK Md) (Real.exp_pos 1)
    (hgpos _ (Real.exp_pos 1)) hgc hkc hgflat (fun x _ _ => (hkb x).1) hLB
    (Real.exp (rfpY2 Md)) heX2 le_rfl
  have hD := decr h η (Real.exp (rfpY2 Md)) (rinC Md Pst lam) (rfpK Md) hX2pos hgc hkc hgpos
    (fun x X hx hxX => hgmono x X (le_trans heX2 hx) hxX) (fun x hx => hkz x (le_trans hEE hx))
    hA hL hM0 hM1 hQ2n (Real.exp (rfpY2 Md + 1)) h20
  have hQe' : Real.exp 1 * (1 / 5) ≤ Real.exp 1 * rinQf h (rinC Md Pst lam) (rfpK Md) (Real.exp 1) η :=
    mul_le_mul_of_nonneg_left hQe (Real.exp_pos 1).le

  have hMeq : rinMom (fun x => rfpK Md (Real.log x)) (Real.exp (rfpY2 Md + 1)) =
      rinMom (fun x => rfpK Md (Real.log x)) (Real.exp (rfpY2 Md)) := by
    have hsub1 : Set.Icc 0 (Real.exp (rfpY2 Md)) ⊆ Set.Ici (0:ℝ) := fun x hx => hx.1
    have hsub2 : Set.Icc (Real.exp (rfpY2 Md)) (Real.exp (rfpY2 Md + 1)) ⊆ Set.Ici (0:ℝ) :=
      fun x hx => le_trans hX2pos.le hx.1
    have hs := intervalIntegral.integral_add_adjacent_intervals
      ((hkc.mono hsub1).intervalIntegrable_of_Icc (μ := MeasureTheory.volume) hX2pos.le)
      ((hkc.mono hsub2).intervalIntegrable_of_Icc (μ := MeasureTheory.volume) h20)
    have hK : ∫ x in (Real.exp (rfpY2 Md))..(Real.exp (rfpY2 Md + 1)), rfpK Md (Real.log x) = 0 := by
      rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ)), intervalIntegral.integral_zero]
      intro x hx
      rw [Set.uIcc_of_le h20] at hx
      exact hkz x (le_trans hEE hx.1)
    unfold rinMom
    linarith
  refine ⟨?_, ?_, ?_⟩
  · have e : ((1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2))) - 1) *
        (Real.exp (rfpY2 Md + 1) - Real.exp 1) =
        ((1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2))) - 1) *
          (Real.exp (rfpY2 Md) - Real.exp 1) +
        ((1 - h + (1 / 2 - h) * (2 * η ^ 2 / (1 + η ^ 2))) - 1) *
          (Real.exp (rfpY2 Md + 1) - Real.exp (rfpY2 Md)) := by ring
    rw [e]
    linarith
  · rw [hMeq]; exact hM0
  · rw [hMeq]; exact hM1

theorem rfp_qs_power_ineq : ∀ lam E h s m v w Q0 : ℝ, 0 < lam → lam ≤ E / 20 → E ≤ 1 / 10 → 0 ≤ h → h ≤ lam ^ 2 → 0 ≤ s → s ≤ 1 → 0 ≤ m → m ≤ 1 / 2 → 0 ≤ w → w ≤ v → v ≤ 1 → v - w ≤ lam → E / 5 + ((1 / 2 - h) * (2 * s / (1 + s)) - h) * (1 - E) ≤ Q0 → lam / 16 + 3 / 10 * s + E * v / 10 ≤ -1 + m * w + v * (Q0 + 1 - m) + (1 - h + (1 / 2 - h) * (2 * s / (1 + s))) * (1 - v) / (1 - lam) :=
by
  intro lam E h s m v w Q0 hl hlE hE hh0 hh hs0 hs1 hm0 hm1 hw0 hwv hv1 hvw hQ
  have hs1' : (0:ℝ) < 1 + s := by linarith
  have hσ0 : 0 ≤ 2 * s / (1 + s) := by positivity
