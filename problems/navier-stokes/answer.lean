      · exact hFa
      · exact hB2
    have hGs : ContDiffOn ℝ ∞ (fun η : Cyl => F (η.1, η.2.1, η.2.2.1)) (DomC B.h B.qB) :=
      hFs.comp hsl.contDiffOn hmaps
    have hcomp : ∀ η ∈ DomC B.h B.qB, ∀ d : Cyl,
