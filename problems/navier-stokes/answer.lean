  obtain ⟨η, hηdef⟩ : ∃ η : Cyl, η = (ξ.1, ξ.2.1, ξ.2.2.1,
      Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) := ⟨_, rfl⟩
