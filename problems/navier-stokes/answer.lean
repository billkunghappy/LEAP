          have := mul_le_mul hTτ hp1 (abs_nonneg _) hτ0
          linarith
        exact sq_le_sq' (abs_le.mp h1).1 (abs_le.mp h1).2
      have hcl := cone_low (p1 + (ts q + s q * Dn q u) * p2) (p2 - (ts q + s q * Dn q u) * p1)
        (by linarith)
      have hcone : 2 + δL ≤ coneUp (p1 + (ts q + s q * Dn q u) * p2)
          (p2 - (ts q + s q * Dn q u) * p1) := by
        generalize p1 + (ts q + s q * Dn q u) * p2 = P at hP2 hcl ⊢
        generalize p2 - (ts q + s q * Dn q u) * p1 = J at hJ hcl ⊢
        have hx : μ / 2 ≤ P - 2 := by linarith
        have hfrac : μ ^ 2 / (2 * (JM ^ 2 + 2 * μ)) ≤
            2 * (P - 2) ^ 2 / (J ^ 2 + 4 * (P - 2)) := by
          rw [div_le_div_iff₀ (by positivity) (by nlinarith [sq_nonneg J])]
          have h1 : μ ^ 2 ≤ 4 * (P - 2) ^ 2 := by nlinarith
          have h2 := mul_le_mul h1 hJ (sq_nonneg J) (by positivity)
          have h3 := mul_le_mul_of_nonneg_left hx (show 0 ≤ 4 * μ * (P - 2) by nlinarith)
          nlinarith
        linarith
      have := hmarg hvge (Or.inr ⟨hvle, hcone⟩) (hFa' q φ) (hFb' q φ)
      rw [← hκdef] at this
      exact this

theorem lead_ps_regularity : LeadPsRegularity :=
by
  intro h cinf Xb ε F U h0 h1 hXb hε hPR
  obtain ⟨hFs, hUs, hFpos, hbd, -, htail⟩ := hPR
  have hle : ∀ k : ℕ, (k : WithTop ℕ∞) ≤ ∞ := fun k => WithTop.coe_le_coe.mpr le_top
  have hunc : ∀ (G : ℝ → ℝ → ℝ) (z : ℝ × ℝ), (↿G) z = G z.1 z.2 := fun _ _ => rfl
  have hO : IsOpen (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hSO : ∀ X₁ : ℝ, Icc 0 X₁ ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 :=
    fun X₁ z hz => ⟨show -ε < z.1 by linarith [hz.1.1], hz.2⟩
  have hK0 : ∀ X₁ : ℝ, IsCompact (Icc 0 X₁ ×ˢ Icc (-1:ℝ) 1) := fun X₁ => isCompact_Icc.prod isCompact_Icc
  have hSK0 : ∀ X₁ : ℝ, Icc 0 X₁ ×ˢ Ioo (-1:ℝ) 1 ⊆ Icc 0 X₁ ×ˢ Icc (-1:ℝ) 1 :=
    fun X₁ z hz => ⟨hz.1, Ioo_subset_Icc_self hz.2⟩
  have hcptT : ∀ {Ω S K : Set (ℝ × ℝ)} (φ : ℝ × ℝ → ℝ), ContDiff ℝ ∞ φ → IsCompact K → S ⊆ K →
      axgeGood Ω S φ := by
    intro Ω S K φ hφ hK hSK
    refine ⟨hφ.contDiffOn, fun k => ?_⟩
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn
      (ContDiff.continuous_iteratedFDeriv (m := k) (hle k) hφ).continuousOn
    exact ⟨C, fun z hz => hC z (hSK hz)⟩
  have hadd : ∀ {Ω S : Set (ℝ × ℝ)} {f g : ℝ × ℝ → ℝ}, IsOpen Ω → S ⊆ Ω → axgeGood Ω S f →
      axgeGood Ω S g → axgeGood Ω S (fun z => f z + g z) := by
    intro Ω S f g hΩ hS hf hg
    refine ⟨hf.1.add hg.1, fun k => ?_⟩
    obtain ⟨C1, h1'⟩ := hf.2 k
    obtain ⟨C2, h2'⟩ := hg.2 k
    refine ⟨C1 + C2, fun z hz => ?_⟩
    have hn := hΩ.mem_nhds (hS hz)
    have e : iteratedFDeriv ℝ k (fun z => f z + g z) z =
        iteratedFDeriv ℝ k f z + iteratedFDeriv ℝ k g z :=
      iteratedFDeriv_add_apply ((hf.1.contDiffAt hn).of_le (hle k)) ((hg.1.contDiffAt hn).of_le (hle k))
    rw [e]
    exact (norm_add_le _ _).trans (add_le_add (h1' z hz) (h2' z hz))
  have hsub : ∀ {Ω S : Set (ℝ × ℝ)} {f g : ℝ × ℝ → ℝ}, IsOpen Ω → S ⊆ Ω → axgeGood Ω S f →
      axgeGood Ω S g → axgeGood Ω S (fun z => f z - g z) := by
    intro Ω S f g hΩ hS hf hg
    refine ⟨hf.1.sub hg.1, fun k => ?_⟩
    obtain ⟨C1, h1'⟩ := hf.2 k
    obtain ⟨C2, h2'⟩ := hg.2 k
    refine ⟨C1 + C2, fun z hz => ?_⟩
    have hn := hΩ.mem_nhds (hS hz)
    have e : iteratedFDeriv ℝ k (fun z => f z - g z) z =
        iteratedFDeriv ℝ k f z - iteratedFDeriv ℝ k g z :=
      iteratedFDeriv_sub_apply ((hf.1.contDiffAt hn).of_le (hle k)) ((hg.1.contDiffAt hn).of_le (hle k))
    rw [e]
    exact (norm_sub_le _ _).trans (add_le_add (h1' z hz) (h2' z hz))
  have hmul : ∀ {Ω S : Set (ℝ × ℝ)} {f g : ℝ × ℝ → ℝ}, IsOpen Ω → S ⊆ Ω → axgeGood Ω S f →
      axgeGood Ω S g → axgeGood Ω S (fun z => f z * g z) := by
    intro Ω S f g hΩ hS hf hg
    refine ⟨hf.1.mul hg.1, fun k => ?_⟩
    obtain ⟨C, hC⟩ := iteratedFDeriv_bilinear_bounded_on (ContinuousLinearMap.mul ℝ ℝ) f g Ω S hΩ hS
      hf.1 hg.1 hf.2 hg.2 k
    refine ⟨C, fun z hz => ?_⟩
    have := hC z hz
    simpa only [ContinuousLinearMap.mul_apply'] using this
  have hcongr : ∀ {Ω S : Set (ℝ × ℝ)} {f g : ℝ × ℝ → ℝ}, IsOpen Ω → S ⊆ Ω → axgeGood Ω S f →
