theorem geom_cone_margin_v5 : ∀ B : BG, B.ok → ∀ Cr : ℝ, 0 < Cr → ∃ (L₁ : ℕ) (us ηm : ℝ), 0 < us ∧ 0 < ηm ∧
    ∀ (G : CorrGeom), G.ustar = us → ∀ γ : Lab, L₁ ≤ γ.1 → B.Xa < (G.rep γ).1 → (G.rep γ).1 < B.Xb →
    |(G.rep γ).2.1| < 1 → 0 < (G.rep γ).2.2 → ∀ ξ ∈ DomC B.h B.qB, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
    |XC B.h ξ - (G.rep γ).1| + |etaC B.h ξ - (G.rep γ).2.1| ≤ Cr * Sb γ.1 ^ (-3:ℤ) →
    (B.T0th (XC B.h ξ) (etaC B.h ξ) * (Nfr5 B G γ).1 + B.T0z (XC B.h ξ) (etaC B.h ξ) * (Nfr5 B G γ).2
        ≤ -ηm * eN (B.T0th (XC B.h ξ) (etaC B.h ξ), B.T0z (XC B.h ξ) (etaC B.h ξ)) ∧
      |c0f5 B G γ| * |B.T0th (XC B.h ξ) (etaC B.h ξ) * (Kfr5 B G γ).1 + B.T0z (XC B.h ξ) (etaC B.h ξ) * (Kfr5 B G γ).2|
        ≤ (1 - ηm) * (G.ustar / Real.sqrt (1 + G.ustar ^ 2)) *
          |B.T0th (XC B.h ξ) (etaC B.h ξ) * (Nfr5 B G γ).1 + B.T0z (XC B.h ξ) (etaC B.h ξ) * (Nfr5 B G γ).2|) :=
by

  have core : ∀ (κ M Cc s0 d ηm r δ : ℝ), 0 < κ → 0 ≤ M → 0 ≤ Cc → 0 ≤ s0 → s0 ^ 2 = 1 - κ / 2 →
      d = 1 - s0 → 0 < d → ηm ≤ κ / (2 * (1 + M)) → ηm ≤ d / 4 → 0 < ηm → 1 - d / 4 ≤ r →
      δ * (1 + M) * (1 + Cc) * 4 ≤ d * κ →
      ∀ (T1 T2 S1 S2 e e0 N1 N2 K1 K2 ts c V : ℝ), |ts| ≤ M → |c| ≤ Cc → N1 < 0 → 1 ≤ -N1 * (1 + M) →
        c ^ 2 = V / 2 → N2 = -(ts * N1) → K1 = -N2 → K2 = N1 → e = Real.sqrt (T1 ^ 2 + T2 ^ 2) → 0 < e →
        0 < e0 → κ * e0 ≤ S1 - ts * S2 → V * (S2 + ts * S1) ^ 2 ≤ (2 - κ) * (S1 - ts * S2) ^ 2 →
        |T1 / e - S1 / e0| ≤ δ → |T2 / e - S2 / e0| ≤ δ →
        T1 * N1 + T2 * N2 ≤ -ηm * e ∧ |c| * |T1 * K1 + T2 * K2| ≤ (1 - ηm) * r * |T1 * N1 + T2 * N2| := by
    intro κ M Cc s0 d ηm r δ hκ hM hCc0 hs0 hs0sq hd hd0 hηa hηb hη0 hr hδ
    intro T1 T2 S1 S2 e e0 N1 N2 K1 K2 ts c V hts hCc hN1 hN1M hc2 hN2 hK1 hK2 _he hepos he0 hcone hquad
      hu1 hu2
    rw [hK1, hK2, hN2]
    have hM1 : 0 ≤ 1 + M := by linarith
    have hδ0 : 0 ≤ δ := le_trans (abs_nonneg _) hu1
    have hD0 : 0 ≤ δ * (1 + M) := mul_nonneg hδ0 hM1
    obtain ⟨u1, hu1d⟩ : ∃ u1, u1 = T1 / e := ⟨_, rfl⟩
    obtain ⟨u2, hu2d⟩ : ∃ u2, u2 = T2 / e := ⟨_, rfl⟩
    obtain ⟨v1, hv1⟩ : ∃ v1, v1 = S1 / e0 := ⟨_, rfl⟩
    obtain ⟨v2, hv2⟩ : ∃ v2, v2 = S2 / e0 := ⟨_, rfl⟩
    rw [← hu1d, ← hv1] at hu1
    rw [← hu2d, ← hv2] at hu2
    have hT1 : T1 = e * u1 := by rw [hu1d]; field_simp
    have hT2 : T2 = e * u2 := by rw [hu2d]; field_simp
    have hS1 : S1 = e0 * v1 := by rw [hv1]; field_simp
    have hS2 : S2 = e0 * v2 := by rw [hv2]; field_simp
    rw [hS1, hS2] at hcone hquad
    rw [hT1, hT2]
    have hpv : κ ≤ v1 - ts * v2 := by
      have : e0 * κ ≤ e0 * (v1 - ts * v2) := by linarith
      exact le_of_mul_le_mul_left this he0
    have hqv2 : V * (v2 + ts * v1) ^ 2 ≤ (2 - κ) * (v1 - ts * v2) ^ 2 := by
      have : e0 ^ 2 * (V * (v2 + ts * v1) ^ 2) ≤ e0 ^ 2 * ((2 - κ) * (v1 - ts * v2) ^ 2) := by
        linarith
      exact le_of_mul_le_mul_left this (by positivity)
    have hqv : |c| * |v2 + ts * v1| ≤ s0 * (v1 - ts * v2) := by
      rw [← abs_mul]
      apply abs_le_of_sq_le_sq _ (mul_nonneg hs0 (by linarith))
      rw [mul_pow, mul_pow, hc2, hs0sq]
      linarith
    have hd1 : d ≤ 1 := by rw [hd]; linarith
    have hs01 : s0 ≤ 1 := by linarith
    have hΔ : δ * (1 + M) ≤ κ / 4 := by
      have h1 : 0 ≤ δ * (1 + M) * Cc := mul_nonneg hD0 hCc0
      have h2 : 0 ≤ (1 - d) * κ := mul_nonneg (by linarith) hκ.le
      linarith
    have hpp : |(u1 - ts * u2) - (v1 - ts * v2)| ≤ δ * (1 + M) := by
      have e1 : (u1 - ts * u2) - (v1 - ts * v2) = (u1 - v1) - ts * (u2 - v2) := by ring
      rw [e1]
      calc |(u1 - v1) - ts * (u2 - v2)| ≤ |u1 - v1| + |ts * (u2 - v2)| := abs_sub _ _
        _ = |u1 - v1| + |ts| * |u2 - v2| := by rw [abs_mul]
        _ ≤ δ + M * δ := by gcongr
        _ = δ * (1 + M) := by ring
    have hqq : |(u2 + ts * u1) - (v2 + ts * v1)| ≤ δ * (1 + M) := by
      have e1 : (u2 + ts * u1) - (v2 + ts * v1) = (u2 - v2) + ts * (u1 - v1) := by ring
      rw [e1]
      calc |(u2 - v2) + ts * (u1 - v1)| ≤ |u2 - v2| + |ts * (u1 - v1)| := abs_add_le _ _
        _ = |u2 - v2| + |ts| * |u1 - v1| := by rw [abs_mul]
        _ ≤ δ + M * δ := by gcongr
        _ = δ * (1 + M) := by ring
    obtain ⟨pu, hpu⟩ : ∃ pu, pu = u1 - ts * u2 := ⟨_, rfl⟩
    obtain ⟨qu, hqu⟩ : ∃ qu, qu = u2 + ts * u1 := ⟨_, rfl⟩
    rw [← hpu] at hpp
    rw [← hqu] at hqq
    have hpp' := abs_le.mp hpp
    have hpu_lb : κ / 2 ≤ pu := by linarith [hpp'.1]
    have hpu0 : 0 < pu := by linarith
    have hTN : (e * u1) * N1 + (e * u2) * (-(ts * N1)) = e * N1 * pu := by rw [hpu]; ring
    have hTK : (e * u1) * (-(-(ts * N1))) + (e * u2) * N1 = e * N1 * qu := by rw [hqu]; ring
    rw [hTN, hTK]
    have hnN1 : 0 ≤ -N1 := by linarith
    refine ⟨?_, ?_⟩
    · have h1 : ηm * (2 * (1 + M)) ≤ κ := (le_div_iff₀ (by linarith)).mp hηa
      have h2a : -N1 * (ηm * (1 + M)) ≤ -N1 * pu :=
        mul_le_mul_of_nonneg_left (by linarith) hnN1
      have h2b : ηm * 1 ≤ ηm * (-N1 * (1 + M)) := mul_le_mul_of_nonneg_left hN1M hη0.le
      have h2 : ηm ≤ -N1 * pu := by linarith
      have h3 : e * ηm ≤ e * (-N1 * pu) := mul_le_mul_of_nonneg_left h2 hepos.le
      linarith
    · have hq1 : |qu| ≤ |v2 + ts * v1| + δ * (1 + M) := by
        have := abs_sub_abs_le_abs_sub qu (v2 + ts * v1)
        linarith
      have hc0 : 0 ≤ |c| := abs_nonneg _
      have hc_q : |c| * |qu| ≤ s0 * pu + (1 + Cc) * (δ * (1 + M)) := by
        have k1 : |c| * |qu| ≤ |c| * (|v2 + ts * v1| + δ * (1 + M)) :=
          mul_le_mul_of_nonneg_left hq1 hc0
        have k2 : |c| * (δ * (1 + M)) ≤ Cc * (δ * (1 + M)) := mul_le_mul_of_nonneg_right hCc hD0
        have k3 : s0 * (v1 - ts * v2) ≤ s0 * (pu + δ * (1 + M)) :=
          mul_le_mul_of_nonneg_left (by linarith [hpp'.1]) hs0
        have k4 : s0 * (δ * (1 + M)) ≤ 1 * (δ * (1 + M)) := mul_le_mul_of_nonneg_right hs01 hD0
        linarith
      have h3 : (1 + Cc) * (δ * (1 + M)) ≤ d * κ / 4 := by linarith
      have h4 : 1 - d / 2 ≤ (1 - ηm) * r := by
        have hr0 : 0 ≤ 1 - d / 4 := by linarith
        have : (1 - d / 4) * (1 - d / 4) ≤ (1 - ηm) * r :=
          mul_le_mul (by linarith) hr hr0 (by linarith)
        nlinarith [sq_nonneg d]
      have h5 : s0 * pu = pu - d * pu := by rw [hd]; ring
      have h6 : 0 ≤ d * (pu - κ / 2) := mul_nonneg hd0.le (by linarith)
      have h7 : 0 ≤ ((1 - ηm) * r - (1 - d / 2)) * pu := mul_nonneg (by linarith) hpu0.le
      have hbd : |c| * |qu| ≤ (1 - ηm) * r * pu := by linarith
      have hN1a : |e * N1 * qu| = e * (-N1) * |qu| := by
        rw [abs_mul, abs_mul, abs_of_pos hepos, abs_of_neg hN1]
      have hN1b : |e * N1 * pu| = e * (-N1) * pu := by
        rw [abs_mul, abs_mul, abs_of_pos hepos, abs_of_neg hN1, abs_of_pos hpu0]
      rw [hN1a, hN1b]
      have hk : 0 ≤ e * (-N1) := mul_nonneg hepos.le hnN1
      calc |c| * (e * -N1 * |qu|) = e * (-N1) * (|c| * |qu|) := by ring
        _ ≤ e * (-N1) * ((1 - ηm) * r * pu) := mul_le_mul_of_nonneg_left hbd hk
        _ = (1 - ηm) * r * (e * -N1 * pu) := by ring

  have hframe : ∀ F5 a b M n N1 N2 c : ℝ, 0 < F5 → 0 < a → |b / a| ≤ M → 0 ≤ a * (1 + (b / a) ^ 2) - 2 →
      n = Real.sqrt ((F5 * -a) ^ 2 + (F5 * b) ^ 2) → N1 = n⁻¹ * (F5 * -a) → N2 = n⁻¹ * (F5 * b) →
