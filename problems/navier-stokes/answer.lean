    have hk1 : 13 / P.lam ≤ y - rfpY3 P.Md P.lam := by linarith
    have hk2 := mul_le_mul_of_nonneg_left hk1 hl0.le
    have hk3 : P.lam * (13 / P.lam) = 13 := by field_simp
    linarith
  have hint : ∀ s : ℝ, 0 ≤ s → ∀ y ∈ Set.uIoc (rfpY4 P.Md P.lam) (rfpY4 P.Md P.lam + 60),
      ‖W y * Real.exp (-(Θ y * s))‖ ≤ M ∧ ‖-(Θ y) * (W y * Real.exp (-(Θ y * s)))‖ ≤ 2 * M := by
