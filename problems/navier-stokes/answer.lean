    have e2 : (1 + K * (Z * Z)) ^ i ≤ ((1 + K) * (Z * Z)) ^ k := by
      have h1 : 1 + K * (Z * Z) ≤ (1 + K) * (Z * Z) := by nlinarith
      calc (1 + K * (Z * Z)) ^ i ≤ ((1 + K) * (Z * Z)) ^ i := pow_le_pow_left₀ (by linarith) h1 _
        _ ≤ ((1 + K) * (Z * Z)) ^ k := pow_le_pow_right₀ (by nlinarith) hi
    rw [hAI]
    have h3 := mul_le_mul (pow_le_pow_left₀ hf0 hf 2) e1 (pow_nonneg hδ1 _) (by positivity)
    exact mul_le_mul h3 e2 (pow_nonneg (by linarith) _) (mul_nonneg (by positivity) (pow_nonneg hZ0 _))
  have hinvs : ContDiffAt ℝ ∞ invf s0 := (hinv 0 (Nat.zero_le _)).1
  have hInvZ : ∀ i, i ≤ k → 0 ≤ sJet5 invf s0 Λ i ∧ sJet5 invf s0 Λ i ≤ AI :=
    fun i hi => ⟨hsJ0 _ i, (hinv i hi).2⟩

  obtain ⟨hgs, hgb⟩ := njet_bilinear lsmulP5 invf (HPair5 B G γ) s0 Λ k hinvs hHPs
  have hP4 : NB B.h (fun η : Cyl => lsmulP5 (invf (η.1, η.2.1, η.2.2.1)) (HPair5 B G γ (η.1, η.2.1, η.2.2.1)))
      k ξ ≤ C4 * SC B.h ξ ^ b := by
    refine le_trans (nb_of_proj B.h (fun s => lsmulP5 (invf s) (HPair5 B G γ s)) ξ k hgs) (le_trans hgb ?_)
    have hs := hsum k (fun j => sJet5 invf s0 Λ j) (fun j => sJet5 (HPair5 B G γ) s0 Λ j) AI Z hInvZ hHPZ
    calc _ ≤ ‖lsmulP5‖ * (2 ^ k * AI * Z) := mul_le_mul_of_nonneg_left hs (norm_nonneg lsmulP5)
      _ = ‖lsmulP5‖ * 2 ^ k * ((k.factorial : ℝ) ^ 2 * (1 + K) ^ k) * Z ^ (3 * k + 2) := by
          rw [hAI, mul_pow]; ring
      _ = C4 * SC B.h ξ ^ b := by rw [hpow, hC4]; ring

  obtain ⟨hTs, hTb⟩ := hT γ.1 ξ hdom hXa' hXb' hqQl hqQ
  obtain ⟨AT, hAT⟩ : ∃ x : ℝ, x = CT * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
      edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-N) := ⟨_, rfl⟩
  have hTZ : ∀ i, i ≤ k → 0 ≤ sJet5 Tf s0 Λ i ∧ sJet5 Tf s0 Λ i ≤ AT := by
    intro i hi
    refine ⟨hsJ0 _ i, ?_⟩
    rw [hAT]; exact hTb i hi
  have hAT0 : 0 ≤ AT := le_trans (hTZ 0 (Nat.zero_le _)).1 (hTZ 0 (Nat.zero_le _)).2
  have hKBσ : ‖numBil5 γ.2.2‖ ≤ KB := by
    rw [hKB]
    cases γ.2.2
    · linarith [norm_nonneg (numBil5 true)]
    · linarith [norm_nonneg (numBil5 false)]
  have hnum : ∀ i, i ≤ k → ContDiffAt ℝ ∞ numf s0 ∧ 0 ≤ sJet5 numf s0 Λ i ∧
      sJet5 numf s0 Λ i ≤ KB * 2 ^ k * Z * AT := by
    intro i hi
    obtain ⟨hs, hbd⟩ := njet_bilinear (numBil5 γ.2.2) (HPair5 B G γ) Tf s0 Λ i hHPs hTs
    refine ⟨hs, hsJ0 _ i, le_trans hbd ?_⟩
    have hs2 := hsum i (fun j => sJet5 (HPair5 B G γ) s0 Λ j) (fun j => sJet5 Tf s0 Λ j) Z AT
      (fun j hj => hHPZ j (le_trans hj hi)) (fun j hj => hTZ j (le_trans hj hi))
    have h2 : (2:ℝ) ^ i ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hi
    calc _ ≤ ‖numBil5 γ.2.2‖ * (2 ^ i * Z * AT) := mul_le_mul_of_nonneg_left hs2 (norm_nonneg (numBil5 γ.2.2))
      _ ≤ KB * (2 ^ k * Z * AT) :=
          mul_le_mul hKBσ (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right h2 hZ0) hAT0)
            (mul_nonneg (mul_nonneg (by positivity) hZ0) hAT0) hKB0
      _ = KB * 2 ^ k * Z * AT := by ring
  obtain ⟨hYs, hYb⟩ := njet_bilinear mulR5 numf invf s0 Λ k (hnum 0 (Nat.zero_le _)).1 hinvs
  have hnb : ∀ (σ : Bool) (a : (ℝ × ℝ) × (ℝ × ℝ)) (T : ℝ × ℝ), numBil5 σ a T =
      if σ then a.2.2 * T.1 - a.2.1 * T.2 else a.1.1 * T.2 - a.1.2 * T.1 := by
    intro σ a T; cases σ <;> rfl
  have hdb : ∀ a b : (ℝ × ℝ) × (ℝ × ℝ), detBil5 a b = a.1.1 * b.2.2 - a.2.1 * b.1.2 :=
    fun _ _ => rfl
  have hYeq : yAmp4 B G γ = fun η : Cyl => mulR5 (numf (η.1, η.2.1, η.2.2.1)) (invf (η.1, η.2.1, η.2.2.1)) := by
    funext η
    have hT' : Tf (η.1, η.2.1, η.2.2.1) = T0star4 B γ.1 η := rfl
    show _ = numBil5 γ.2.2 (HPair5 B G γ (η.1, η.2.1, η.2.2.1)) (Tf (η.1, η.2.1, η.2.2.1)) *
      (detBil5 (HPair5 B G γ (η.1, η.2.1, η.2.2.1)) (HPair5 B G γ (η.1, η.2.1, η.2.2.1)))⁻¹
    rw [hnb, hT', hdb]
    simp only [yAmp4, HPair5]
    split_ifs <;> rw [div_eq_mul_inv]
  have hP3 : NB B.h (yAmp4 B G γ) k ξ ≤
      C3 * SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-N) := by
    rw [hYeq]
    refine le_trans (nb_of_proj B.h (fun s => mulR5 (numf s) (invf s)) ξ k hYs) (le_trans hYb ?_)
    have hs := hsum k (fun j => sJet5 numf s0 Λ j) (fun j => sJet5 invf s0 Λ j) (KB * 2 ^ k * Z * AT) AI
      (fun j hj => ⟨(hnum j hj).2.1, (hnum j hj).2.2⟩) hInvZ
    calc _ ≤ ‖mulR5‖ * (2 ^ k * (KB * 2 ^ k * Z * AT) * AI) := mul_le_mul_of_nonneg_left hs (norm_nonneg mulR5)
      _ = ‖mulR5‖ * 2 ^ k * (KB * 2 ^ k) * ((k.factorial : ℝ) ^ 2 * (1 + K) ^ k) * Z ^ (3 * k + 2) * AT := by
          rw [hAI, mul_pow]; ring
      _ = C3 * SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-N) := by
          rw [hpow, hC3, hAT]; ring

  have hXb0 : 0 ≤ SC B.h ξ ^ b := Real.rpow_nonneg (by linarith) _
  have hew : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
    unfold edgeWeight; split_ifs <;> positivity
  have hed : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) := by
    have hX0 : 0 < XC B.h ξ := lt_trans hXa hXa'
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hXa'))
      (Real.log_pos ((one_lt_div hX0).mpr hXb')))
  have hedN : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-N) := Real.rpow_nonneg hed.le _
  refine ⟨le_trans hP3 ?_, le_trans hP4 ?_⟩
  · have hnn : 0 ≤ SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-N) := mul_nonneg (mul_nonneg hXb0 hew) hedN
    have h1 := mul_le_mul_of_nonneg_right (le_max_left C3 C4) hnn
    calc C3 * SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-N)
        = C3 * (SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-N)) := by ring
      _ ≤ max C3 C4 * (SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-N)) := h1
      _ = _ := by ring
  · exact mul_le_mul_of_nonneg_right (le_max_right C3 C4) hXb0

theorem stress5_prim_nondeg : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G →
    ∃ (l1 : ℕ) (c : ℝ), 0 < c ∧ PrimNondegAt4 B G l1 c :=
by
  intro B G hB hG

  have cramer : ∀ (A u η δ h1 h2 N1 N2 a1 a2 b1 b2 TN TK T P1 P2 M1 M2 T1 T2 : ℝ), 0 < A → 0 < u →
      0 < η → 0 < h1 → 0 < h2 → 0 ≤ δ → δ ≤ 1 → 4 * δ * (A + u + 1) ≤ A * u → 4 * δ ≤ u * η ^ 2 →
      |a1| ≤ δ → |a2| ≤ δ → |b1| ≤ δ → |b2| ≤ δ → N1 ^ 2 + N2 ^ 2 = 1 → 0 ≤ T →
      TN = T1 * N1 + T2 * N2 → TK = -(T1 * N2) + T2 * N1 →
      |TN| ≤ T → |TK| ≤ T → TN ≤ -η * T → A * |TK| ≤ (1 - η) * u * |TN| →
      P1 = h1 * ((-A + a1) * N1 - (-u + a2) * N2) → P2 = h1 * ((-A + a1) * N2 + (-u + a2) * N1) →
      M1 = h2 * ((-A + b1) * N1 - (u + b2) * N2) → M2 = h2 * ((-A + b1) * N2 + (u + b2) * N1) →
      A * u * h1 * h2 ≤ |P1 * M2 - M1 * P2| ∧
      η ^ 2 * T / (5 * A * h1) ≤ (M2 * T1 - M1 * T2) / (P1 * M2 - M1 * P2) ∧
      η ^ 2 * T / (5 * A * h2) ≤ (P1 * T2 - P2 * T1) / (P1 * M2 - M1 * P2) := by
    intro A u η δ h1 h2 N1 N2 a1 a2 b1 b2 TN TK T P1 P2 M1 M2 T1 T2 hA hu hη hh1 hh2 hδ0 hδ1 hδA hδη
      ha1 ha2 hb1 hb2 hN hT hTN hTK hTNb hTKb hcone1 hcone2 hP1 hP2 hM1 hM2
    obtain ⟨D', hD'⟩ : ∃ D', D' = -2 * A * u + (A * a2 - A * b2) + (u * a1 + u * b1) + (a1 * b2 - a2 * b1) :=
      ⟨_, rfl⟩
    have hD : P1 * M2 - M1 * P2 = h1 * h2 * D' := by
      rw [hP1, hP2, hM1, hM2, hD']
      linear_combination (h1 * h2 * ((-A + a1) * (u + b2) - (-A + b1) * (-u + a2))) * hN
    have hNp : M2 * T1 - M1 * T2 = h2 * ((u * TN + A * TK) + (b2 * TN - b1 * TK)) := by
      rw [hM1, hM2, hTN, hTK]; ring
    have hNm : P1 * T2 - P2 * T1 = h1 * ((u * TN - A * TK) + (a1 * TK - a2 * TN)) := by
      rw [hP1, hP2, hTN, hTK]; ring
    have bA : |A * a2 - A * b2| ≤ A * δ + A * δ := by
      refine (abs_sub _ _).trans ?_
      rw [abs_mul, abs_mul, abs_of_pos hA]
      exact add_le_add (mul_le_mul_of_nonneg_left ha2 hA.le) (mul_le_mul_of_nonneg_left hb2 hA.le)
    have bu : |u * a1 + u * b1| ≤ u * δ + u * δ := by
      refine (abs_add_le _ _).trans ?_
      rw [abs_mul, abs_mul, abs_of_pos hu]
      exact add_le_add (mul_le_mul_of_nonneg_left ha1 hu.le) (mul_le_mul_of_nonneg_left hb1 hu.le)
    have bq : |a1 * b2 - a2 * b1| ≤ δ * 1 + δ * 1 := by
      refine (abs_sub _ _).trans ?_
      rw [abs_mul, abs_mul]
      exact add_le_add (mul_le_mul ha1 (hb2.trans hδ1) (abs_nonneg _) hδ0)
        (mul_le_mul ha2 (hb1.trans hδ1) (abs_nonneg _) hδ0)
    have hAu : 0 < A * u := mul_pos hA hu
    have hD'u : D' ≤ -(3/2) * (A * u) := by
      have := (abs_le.mp bA).2; have := (abs_le.mp bu).2; have := (abs_le.mp bq).2
      rw [hD']; nlinarith
    have hD'l : -(5/2) * (A * u) ≤ D' := by
      have := (abs_le.mp bA).1; have := (abs_le.mp bu).1; have := (abs_le.mp bq).1
      rw [hD']; nlinarith
    have hD'neg : D' < 0 := by linarith
    have hhh : 0 < h1 * h2 := mul_pos hh1 hh2
    have hDneg : h1 * h2 * D' < 0 := mul_neg_of_pos_of_neg hhh hD'neg
    have hTN0 : TN ≤ 0 := by nlinarith
    have habsTN : |TN| = -TN := abs_of_nonpos hTN0
    have c1 : |b2 * TN - b1 * TK| ≤ δ * T + δ * T := by
      refine (abs_sub _ _).trans ?_
      rw [abs_mul, abs_mul]
      exact add_le_add (mul_le_mul hb2 hTNb (abs_nonneg _) hδ0) (mul_le_mul hb1 hTKb (abs_nonneg _) hδ0)
    have c2 : |a1 * TK - a2 * TN| ≤ δ * T + δ * T := by
      refine (abs_sub _ _).trans ?_
      rw [abs_mul, abs_mul]
      exact add_le_add (mul_le_mul ha1 hTKb (abs_nonneg _) hδ0) (mul_le_mul ha2 hTNb (abs_nonneg _) hδ0)
    have hATK1 : A * TK ≤ A * |TK| := mul_le_mul_of_nonneg_left (le_abs_self _) hA.le
    have hATK2 : -(A * TK) ≤ A * |TK| := by
      have := mul_le_mul_of_nonneg_left (neg_abs_le TK) hA.le; linarith
    rw [habsTN] at hcone2
    have hηTN : η * TN ≤ -(η ^ 2 * T) := by nlinarith
    have hu1 : u * (η * TN) ≤ u * (-(η ^ 2 * T)) := mul_le_mul_of_nonneg_left hηTN hu.le
    have hδT : 4 * δ * T ≤ u * η ^ 2 * T := mul_le_mul_of_nonneg_right hδη hT
    have hNpb : (u * TN + A * TK) + (b2 * TN - b1 * TK) ≤ -(u * η ^ 2 * T / 2) := by
      have := (abs_le.mp c1).2; nlinarith
    have hNmb : (u * TN - A * TK) + (a1 * TK - a2 * TN) ≤ -(u * η ^ 2 * T / 2) := by
      have := (abs_le.mp c2).2; nlinarith
    refine ⟨?_, ?_, ?_⟩
    · rw [hD, abs_of_neg hDneg]
      have := mul_le_mul_of_nonneg_left hD'u hhh.le
      nlinarith
    · rw [hNp, hD, le_div_iff_of_neg hDneg]
      have e : η ^ 2 * T / (5 * A * h1) * (h1 * h2 * D') = (η ^ 2 * T / (5 * A)) * h2 * D' := by
        field_simp
      rw [e]
      have h0 : 0 ≤ η ^ 2 * T / (5 * A) * h2 := by positivity
      have k1 := mul_le_mul_of_nonneg_left hD'l h0
      have e2 : η ^ 2 * T / (5 * A) * h2 * (-(5 / 2) * (A * u)) = -(u * η ^ 2 * T / 2) * h2 := by
        field_simp <;> ring
      have k2 := mul_le_mul_of_nonneg_left hNpb hh2.le
      linarith
    · rw [hNm, hD, le_div_iff_of_neg hDneg]
      have e : η ^ 2 * T / (5 * A * h2) * (h1 * h2 * D') = (η ^ 2 * T / (5 * A)) * h1 * D' := by
        field_simp
      rw [e]
      have h0 : 0 ≤ η ^ 2 * T / (5 * A) * h1 := by positivity
      have k1 := mul_le_mul_of_nonneg_left hD'l h0
      have e2 : η ^ 2 * T / (5 * A) * h1 * (-(5 / 2) * (A * u)) = -(u * η ^ 2 * T / 2) * h1 := by
        field_simp <;> ring
      have k2 := mul_le_mul_of_nonneg_left hNmb hh1.le
      linarith

  have hG' := hG
  obtain ⟨cf, Cf, hcf, hFr⟩ := frame5_consts B G hB hG
  obtain ⟨l8, c8, C8, hc8, hcol⟩ := pulse5_columns B G hB hG
  obtain ⟨hGP1, -, hGP3, ⟨ηm, hηm, hGP4⟩, -, -, -⟩ := hG
  obtain ⟨c₀, hc₀, hc₀b⟩ := hB.2.2.2.1.2.2.2.1
  have hhpos : 0 < B.h := hB.2.1.1
  have hhlt : B.h < 1 / 100 := hB.2.1.2.1
  have hu : 0 < G.ustar := hGP1.2.2.1
  have hCrep : 0 < G.Crep := hGP1.2.2.2.1
  obtain ⟨Su, hSu⟩ : ∃ s, s = Real.sqrt (1 + G.ustar ^ 2) := ⟨_, rfl⟩
  have hSu1 : 1 ≤ Su := by rw [hSu]; exact Real.one_le_sqrt.mpr (by nlinarith)
  have hSu0 : 0 < Su := by linarith
  obtain ⟨CA, hCA⟩ : ∃ x, x = max Cf 1 * Su := ⟨_, rfl⟩
  have hCA0 : 0 < CA := by rw [hCA]; exact mul_pos (lt_of_lt_of_le one_pos (le_max_right _ _)) hSu0
  obtain ⟨C8p, hC8pdef⟩ : ∃ x, x = max C8 1 := ⟨_, rfl⟩
  have hC8p : 0 < C8p := by rw [hC8pdef]; exact lt_of_lt_of_le one_pos (le_max_right _ _)
  obtain ⟨δ0, hδ0def⟩ : ∃ x, x = min (min 1 (cf * G.ustar / (4 * (CA + G.ustar + 1))))
      (G.ustar * ηm ^ 2 / 4) := ⟨_, rfl⟩
  have hδ0pos : 0 < δ0 := by
    rw [hδ0def]
    exact lt_min (lt_min one_pos (div_pos (mul_pos hcf hu) (by linarith)))
      (div_pos (mul_pos hu (pow_pos hηm 2)) (by norm_num))
  obtain ⟨cD, hcD⟩ : ∃ x, x = cf * G.ustar * c8 ^ 2 := ⟨_, rfl⟩
  obtain ⟨cY, hcY⟩ : ∃ x, x = ηm ^ 2 * (1 / (2 + G.Crep) * c₀) / (5 * CA * C8p) := ⟨_, rfl⟩
  have hcD0 : 0 < cD := by rw [hcD]; exact mul_pos (mul_pos hcf hu) (pow_pos hc8 2)
  have hcY0 : 0 < cY := by
    rw [hcY]
    exact div_pos (mul_pos (pow_pos hηm 2) (mul_pos (div_pos one_pos (by linarith)) hc₀))
      (mul_pos (mul_pos (by norm_num) hCA0) hC8p)
  obtain ⟨c, hcdef⟩ : ∃ x, x = min cD cY := ⟨_, rfl⟩
  have hc : 0 < c := by rw [hcdef]; exact lt_min hcD0 hcY0
  have hs1 : sgn true = 1 := by simp [sgn]
  have hs2 : sgn false = -1 := by simp [sgn]

  have key : ∀ (γ : Lab) (ξ : Cyl), l8 + ⌈C8p / δ0⌉₊ + 1 ≤ γ.1 → ActiveL4 B G γ → etaL B.h γ ξ ≠ 0 →
      ξ ∈ DomC B.h B.qB → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      c / Sb γ.1 ≤ |hDetC B G γ ξ| ∧ c * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) ≤ yAmp4 B G γ ξ := by
    intro γ ξ hl hact hη hdom hXa hXb
    have hl' : l8 ≤ γ.1 := by omega
    obtain ⟨ℓ, hℓ⟩ : ∃ x : ℝ, x = (γ.1 : ℝ) := ⟨_, rfl⟩
    have hceil : ((⌈C8p / δ0⌉₊ : ℕ) : ℝ) + 1 ≤ ℓ := by
      have : ⌈C8p / δ0⌉₊ + 1 ≤ γ.1 := by omega
      rw [hℓ]; exact_mod_cast this
    have hℓ1 : 1 ≤ ℓ := by have := Nat.cast_nonneg (α := ℝ) ⌈C8p / δ0⌉₊; linarith
    have hℓ0 : 0 < ℓ := by linarith
    have hδ : C8p / ℓ ≤ δ0 := by
      rw [div_le_iff₀ hℓ0]
      have h1 := Nat.le_ceil (C8p / δ0)
      have h2 : C8p / δ0 ≤ ℓ := by linarith
      rw [div_le_iff₀ hδ0pos] at h2; linarith
    rw [hδ0def] at hδ
    have hSb : Sb γ.1 = ℓ ^ 2 := by rw [hℓ]; rfl
    have hsq : Real.sqrt (Sb γ.1) = ℓ := by rw [hSb]; exact Real.sqrt_sq hℓ0.le
    have hSb1 : 1 ≤ Sb γ.1 := by rw [hSb]; exact one_le_pow₀ hℓ1

    obtain ⟨-, -, hg0, -, -, -, -, hc0u, hc0l, -⟩ := hFr γ hact
    have hc0neg : c0f5 B G γ < 0 := by linarith
    have hAcf : cf ≤ -c0f5 B G γ * Su := by
      have := mul_le_mul (show cf ≤ -c0f5 B G γ by linarith) hSu1 zero_le_one (by linarith)
      linarith
    have hApos : 0 < -c0f5 B G γ * Su := by linarith
    have hAle : -c0f5 B G γ * Su ≤ CA := by
      rw [hCA]; exact mul_le_mul_of_nonneg_right (by linarith [le_max_left Cf 1]) hSu0.le
    have hAabs : -c0f5 B G γ * Su = |c0f5 B G γ| * Su := by rw [abs_of_neg hc0neg]

    have hNunit0 : (Nfr5 B G γ).1 ^ 2 + (Nfr5 B G γ).2 ^ 2 = 1 := by
      have hpos : 0 < eN (g0r5 B G γ) := lt_of_lt_of_le hcf hg0
      have hsq2 : eN (g0r5 B G γ) ^ 2 = (g0r5 B G γ).1 ^ 2 + (g0r5 B G γ).2 ^ 2 :=
        Real.sq_sqrt (by positivity)
      simp only [Nfr5, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
      rw [mul_pow, mul_pow, ← mul_add, ← hsq2, ← mul_pow, inv_mul_cancel₀ hpos.ne', one_pow]
    obtain ⟨N, hNdef⟩ : ∃ N, Nfr5 B G γ = N := ⟨_, rfl⟩
    have hK : Kfr5 B G γ = (-N.2, N.1) := by unfold Kfr5; rw [hNdef]
    rw [hNdef] at hNunit0
    have cs : ∀ x y : ℝ, (x * N.1 + y * N.2) ^ 2 + (-(x * N.2) + y * N.1) ^ 2 = x ^ 2 + y ^ 2 :=
      fun x y => by linear_combination (x ^ 2 + y ^ 2) * hNunit0

    obtain ⟨h1, e1, h1l, h1u, he1, hHp⟩ := hcol γ ξ hl' hact hdom hη true
    obtain ⟨h2, e2, h2l, h2u, he2, hHm⟩ := hcol γ ξ hl' hact hdom hη false
    rw [hsq] at h1l h1u he1 h2l h2u he2
    have hh1pos : 0 < h1 := lt_of_lt_of_le (div_pos hc8 hℓ0) h1l
    have hh2pos : 0 < h2 := lt_of_lt_of_le (div_pos hc8 hℓ0) h2l
    have hC8ℓ : C8 / ℓ ≤ C8p / ℓ :=
      div_le_div_of_nonneg_right (by rw [hC8pdef]; exact le_max_left _ _) hℓ0.le
    have hC8p1 : C8p / ℓ ≤ C8p := div_le_self hC8p.le hℓ1
    obtain ⟨Hp, hHpdef⟩ : ∃ H, Hcol B G (γ.1, γ.2.1, true) (ξ.1, ξ.2.1, ξ.2.2.1) = H := ⟨_, rfl⟩
    obtain ⟨Hm, hHmdef⟩ : ∃ H, Hcol B G (γ.1, γ.2.1, false) (ξ.1, ξ.2.1, ξ.2.2.1) = H := ⟨_, rfl⟩
    rw [hHpdef, ← hSu, hK, hNdef, hs1] at hHp
    rw [hHmdef, ← hSu, hK, hNdef, hs2] at hHm
    have eP1 := congrArg Prod.fst hHp
    have eP2 := congrArg Prod.snd hHp
    have eM1 := congrArg Prod.fst hHm
    have eM2 := congrArg Prod.snd hHm
    simp only [Prod.smul_fst, Prod.smul_snd, Prod.fst_add, Prod.snd_add, Prod.fst_sub, Prod.snd_sub,
      smul_eq_mul] at eP1 eP2 eM1 eM2
    have eP1' : Hp.1 = h1 * ((-(-c0f5 B G γ * Su) + (e1.1 * N.1 + e1.2 * N.2)) * N.1 -
        (-G.ustar + (-(e1.1 * N.2) + e1.2 * N.1)) * N.2) := by
      rw [eP1]; linear_combination (-(h1 * e1.1)) * hNunit0
    have eP2' : Hp.2 = h1 * ((-(-c0f5 B G γ * Su) + (e1.1 * N.1 + e1.2 * N.2)) * N.2 +
        (-G.ustar + (-(e1.1 * N.2) + e1.2 * N.1)) * N.1) := by
      rw [eP2]; linear_combination (-(h1 * e1.2)) * hNunit0
    have eM1' : Hm.1 = h2 * ((-(-c0f5 B G γ * Su) + (e2.1 * N.1 + e2.2 * N.2)) * N.1 -
        (G.ustar + (-(e2.1 * N.2) + e2.2 * N.1)) * N.2) := by
      rw [eM1]; linear_combination (-(h2 * e2.1)) * hNunit0
    have eM2' : Hm.2 = h2 * ((-(-c0f5 B G γ * Su) + (e2.1 * N.1 + e2.2 * N.2)) * N.2 +
        (G.ustar + (-(e2.1 * N.2) + e2.2 * N.1)) * N.1) := by
      rw [eM2]; linear_combination (-(h2 * e2.2)) * hNunit0
    have habs1 : ∀ x y : ℝ, |x * N.1 + y * N.2| ≤ Real.sqrt (x ^ 2 + y ^ 2) := fun x y =>
      Real.abs_le_sqrt (by linarith [cs x y, sq_nonneg (-(x * N.2) + y * N.1)])
    have habs2 : ∀ x y : ℝ, |-(x * N.2) + y * N.1| ≤ Real.sqrt (x ^ 2 + y ^ 2) := fun x y =>
      Real.abs_le_sqrt (by linarith [cs x y, sq_nonneg (x * N.1 + y * N.2)])
    have ha1 : |e1.1 * N.1 + e1.2 * N.2| ≤ C8p / ℓ := ((habs1 _ _).trans he1).trans hC8ℓ
    have ha2 : |-(e1.1 * N.2) + e1.2 * N.1| ≤ C8p / ℓ := ((habs2 _ _).trans he1).trans hC8ℓ
    have hb1 : |e2.1 * N.1 + e2.2 * N.2| ≤ C8p / ℓ := ((habs1 _ _).trans he2).trans hC8ℓ
    have hb2 : |-(e2.1 * N.2) + e2.2 * N.1| ≤ C8p / ℓ := ((habs2 _ _).trans he2).trans hC8ℓ

    have hδ0' : 0 ≤ C8p / ℓ := div_nonneg hC8p.le hℓ0.le
    have hδ1 : C8p / ℓ ≤ 1 := hδ.trans ((min_le_left _ _).trans (min_le_left _ _))
    have hδA : 4 * (C8p / ℓ) * (-c0f5 B G γ * Su + G.ustar + 1) ≤ -c0f5 B G γ * Su * G.ustar := by
      have hq0 := hδ.trans ((min_le_left _ _).trans (min_le_right _ _))
      have hpos : 0 < 4 * (CA + G.ustar + 1) := by linarith
      rw [le_div_iff₀ hpos] at hq0
      have h4 : 4 * (C8p / ℓ) * (-c0f5 B G γ * Su + G.ustar + 1) ≤ 4 * (C8p / ℓ) * (CA + G.ustar + 1) :=
        mul_le_mul_of_nonneg_left (by linarith) (by positivity)
      have h5 := mul_le_mul_of_nonneg_right hAcf hu.le
      linarith
    have hδη : 4 * (C8p / ℓ) ≤ G.ustar * ηm ^ 2 := by
      have := hδ.trans (min_le_right _ _); linarith

    have hτ : 0 < 1 - ξ.2.2.1 := by linarith [hdom.2.1]
    have hq : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
    have hz := (hB.1.2.1 ξ.2.1 (1 - ξ.2.2.1) hτ).2
    have hetaC : -1 < etaC B.h ξ ∧ etaC B.h ξ < 1 := by
      have hp : 0 < qC B.h ξ ^ (1/2 - B.h) := Real.rpow_pos_of_pos hq _
      have hp2 : (qC B.h ξ ^ (1/2 - B.h)) ^ 2 = qC B.h ξ ^ (1 - 2 * B.h) := by
        rw [sq, ← Real.rpow_add hq]; congr 1; ring
      have hz' : ξ.2.1 ^ 2 < (qC B.h ξ ^ (1/2 - B.h)) ^ 2 := by rw [hp2]; exact hz
      have habs := abs_lt_of_sq_lt_sq hz' hp.le
      have he : etaC B.h ξ = ξ.2.1 / qC B.h ξ ^ (1/2 - B.h) := by
        rw [etaC, Real.rpow_neg hq.le, div_eq_mul_inv ξ.2.1]
      rw [he]
      constructor
      · rw [lt_div_iff₀ hp]; linarith [neg_abs_le ξ.2.1]
      · rw [div_lt_iff₀ hp]; linarith [le_abs_self ξ.2.1]
    have hQb : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
    obtain ⟨-, -, -, -, hrep2, hrepξ⟩ := hGP3 γ hact
    have hbr := hrepξ ξ hdom hη
    have hzp : Sb γ.1 ^ (-3:ℤ) ≤ 1 := zpow_le_one_of_nonpos₀ hSb1 (by norm_num)
    have hqQ : qC B.h ξ / Qb γ.1 ≤ 2 + G.Crep := by
      have h2 : G.Crep * Sb γ.1 ^ (-3:ℤ) ≤ G.Crep := by
        have := mul_le_mul_of_nonneg_left hzp hCrep.le; linarith
      linarith [le_abs_self (qC B.h ξ / Qb γ.1 - (G.rep γ).2.2), abs_nonneg (XC B.h ξ - (G.rep γ).1),
        abs_nonneg (etaC B.h ξ - (G.rep γ).2.1)]
    have hr : 1 / (2 + G.Crep) ≤ Qb γ.1 / qC B.h ξ := by
      have := one_div_le_one_div_of_le (div_pos hq hQb) hqQ
      rwa [one_div_div] at this
    obtain ⟨sT, hsTdef⟩ : ∃ s, s = (Qb γ.1 / qC B.h ξ) ^ (1 - B.h) := ⟨_, rfl⟩
    have hsT0 : 0 < sT := by rw [hsTdef]; exact Real.rpow_pos_of_pos (div_pos hQb hq) _
    have hsTlow : 1 / (2 + G.Crep) ≤ sT := by
      rw [hsTdef]
      by_cases hle : Qb γ.1 / qC B.h ξ ≤ 1
      · calc 1 / (2 + G.Crep) ≤ Qb γ.1 / qC B.h ξ := hr
          _ = (Qb γ.1 / qC B.h ξ) ^ (1:ℝ) := (Real.rpow_one _).symm
          _ ≤ (Qb γ.1 / qC B.h ξ) ^ (1 - B.h) :=
              Real.rpow_le_rpow_of_exponent_ge (div_pos hQb hq) hle (by linarith)
      · push_neg at hle
        have h1' : 1 ≤ (Qb γ.1 / qC B.h ξ) ^ (1 - B.h) := Real.one_le_rpow hle.le (by linarith)
        have h2' : 1 / (2 + G.Crep) ≤ 1 := by rw [div_le_one (by linarith)]; linarith
        linarith
    obtain ⟨a, ha⟩ : ∃ x, x = B.T0th (XC B.h ξ) (etaC B.h ξ) := ⟨_, rfl⟩
    obtain ⟨b, hb⟩ : ∃ x, x = B.T0z (XC B.h ξ) (etaC B.h ξ) := ⟨_, rfl⟩
    have hT0 := hc₀b (XC B.h ξ) (etaC B.h ξ) hXa hXb hetaC.1 hetaC.2
    rw [← ha, ← hb] at hT0
    have hg := hGP4 γ hact ξ hdom hη hXa hXb
    simp only [hK, hNdef, ← hSu, ← ha, ← hb] at hg
    have hTeq : Real.sqrt ((sT * a) ^ 2 + (sT * b) ^ 2) = sT * Real.sqrt (a ^ 2 + b ^ 2) := by
      rw [show (sT * a) ^ 2 + (sT * b) ^ 2 = sT ^ 2 * (a ^ 2 + b ^ 2) by ring,
        Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq hsT0.le]
    have hew : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
      unfold edgeWeight; split_ifs <;> positivity
    have hTlow : 1 / (2 + G.Crep) * (c₀ * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) ≤
        Real.sqrt ((sT * a) ^ 2 + (sT * b) ^ 2) := by
      rw [hTeq]
      exact mul_le_mul hsTlow hT0 (mul_nonneg hc₀.le hew) hsT0.le
    have hcone1 : (sT * a) * N.1 + (sT * b) * N.2 ≤ -ηm * Real.sqrt ((sT * a) ^ 2 + (sT * b) ^ 2) := by
      rw [hTeq]
      calc (sT * a) * N.1 + (sT * b) * N.2 = sT * (a * N.1 + b * N.2) := by ring
        _ ≤ sT * (-ηm * eN (a, b)) := mul_le_mul_of_nonneg_left hg.1 hsT0.le
        _ = -ηm * (sT * Real.sqrt (a ^ 2 + b ^ 2)) := by
            show sT * (-ηm * Real.sqrt (a ^ 2 + b ^ 2)) = _; ring
    have hcone2 : (-c0f5 B G γ * Su) * |-((sT * a) * N.2) + (sT * b) * N.1| ≤
        (1 - ηm) * G.ustar * |(sT * a) * N.1 + (sT * b) * N.2| := by
      have eK : -((sT * a) * N.2) + (sT * b) * N.1 = sT * (a * -N.2 + b * N.1) := by ring
      have eN' : (sT * a) * N.1 + (sT * b) * N.2 = sT * (a * N.1 + b * N.2) := by ring
      have hSune : Su ≠ 0 := hSu0.ne'
      rw [eK, eN', abs_mul, abs_mul, abs_of_pos hsT0, hAabs]
      calc |c0f5 B G γ| * Su * (sT * |a * -N.2 + b * N.1|)
          = Su * sT * (|c0f5 B G γ| * |a * -N.2 + b * N.1|) := by ring
        _ ≤ Su * sT * ((1 - ηm) * (G.ustar / Su) * |a * N.1 + b * N.2|) :=
            mul_le_mul_of_nonneg_left hg.2 (mul_pos hSu0 hsT0).le
        _ = (1 - ηm) * G.ustar * (sT * |a * N.1 + b * N.2|) := by field_simp <;> ring
    obtain ⟨hDb, hy1, hy2⟩ := cramer (-c0f5 B G γ * Su) G.ustar ηm (C8p / ℓ) h1 h2 N.1 N.2
      (e1.1 * N.1 + e1.2 * N.2) (-(e1.1 * N.2) + e1.2 * N.1)
      (e2.1 * N.1 + e2.2 * N.2) (-(e2.1 * N.2) + e2.2 * N.1)
      ((sT * a) * N.1 + (sT * b) * N.2) (-((sT * a) * N.2) + (sT * b) * N.1)
      (Real.sqrt ((sT * a) ^ 2 + (sT * b) ^ 2)) Hp.1 Hp.2 Hm.1 Hm.2 (sT * a) (sT * b)
      hApos hu hηm hh1pos hh2pos hδ0' hδ1 hδA hδη ha1 ha2 hb1 hb2 hNunit0 (Real.sqrt_nonneg _) rfl rfl
      (habs1 _ _) (habs2 _ _) hcone1 hcone2 eP1' eP2' eM1' eM2'
    have hdet : hDetC B G γ ξ = Hp.1 * Hm.2 - Hm.1 * Hp.2 := by
      rw [← hHpdef, ← hHmdef]; rfl
    have hy : yAmp4 B G γ ξ = if γ.2.2 then (Hm.2 * (sT * a) - Hm.1 * (sT * b)) / (Hp.1 * Hm.2 - Hm.1 * Hp.2)
        else (Hp.1 * (sT * b) - Hp.2 * (sT * a)) / (Hp.1 * Hm.2 - Hm.1 * Hp.2) := by
      rw [← hHpdef, ← hHmdef, ha, hb, hsTdef]; rfl

    have hylow : ∀ hσ : ℝ, 0 < hσ → hσ ≤ C8 / ℓ →
        c * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) ≤
          ηm ^ 2 * Real.sqrt ((sT * a) ^ 2 + (sT * b) ^ 2) / (5 * (-c0f5 B G γ * Su) * hσ) := by
      intro hσ hσ0 hσu
      have hσp : hσ ≤ C8p := (hσu.trans hC8ℓ).trans hC8p1
      have hAh : -c0f5 B G γ * Su * hσ ≤ CA * C8p := mul_le_mul hAle hσp hσ0.le hCA0.le
      calc c * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)
          ≤ cY * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) :=
            mul_le_mul_of_nonneg_right (by rw [hcdef]; exact min_le_right _ _) hew
        _ = ηm ^ 2 * (1 / (2 + G.Crep) * (c₀ * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ))) /
              (5 * CA * C8p) := by rw [hcY]; ring
        _ ≤ ηm ^ 2 * Real.sqrt ((sT * a) ^ 2 + (sT * b) ^ 2) / (5 * (-c0f5 B G γ * Su) * hσ) := by
            have hden : 5 * (-c0f5 B G γ * Su) * hσ ≤ 5 * CA * C8p := by linarith
            exact div_le_div₀ (mul_nonneg (sq_nonneg _) (Real.sqrt_nonneg _))
              (mul_le_mul_of_nonneg_left hTlow (sq_nonneg _))
              (mul_pos (mul_pos (by norm_num) hApos) hσ0) hden
    refine ⟨?_, ?_⟩
    · rw [hdet]
      have e : cD / Sb γ.1 = cf * G.ustar * (c8 / ℓ) * (c8 / ℓ) := by
        rw [hcD, hSb]; field_simp
      have hch : cf * G.ustar * (c8 / ℓ) * (c8 / ℓ) ≤ -c0f5 B G γ * Su * G.ustar * h1 * h2 :=
        mul_le_mul (mul_le_mul (mul_le_mul_of_nonneg_right hAcf hu.le) h1l
          (div_pos hc8 hℓ0).le (mul_pos hApos hu).le) h2l (div_pos hc8 hℓ0).le
          (mul_pos (mul_pos hApos hu) hh1pos).le
      have hSbpos : 0 < Sb γ.1 := by linarith
      calc c / Sb γ.1 ≤ cD / Sb γ.1 :=
            div_le_div_of_nonneg_right (by rw [hcdef]; exact min_le_left _ _) hSbpos.le
        _ = cf * G.ustar * (c8 / ℓ) * (c8 / ℓ) := e
        _ ≤ _ := hch.trans hDb
    · rw [hy]
      split_ifs
      · exact (hylow h1 hh1pos h1u).trans hy1
      · exact (hylow h2 hh2pos h2u).trans hy2
  have hpd := prim5_deriv_bounds B G hB hG' (l8 + ⌈C8p / δ0⌉₊ + 1) c hc
    (fun γ ξ hl hact hdom hη hXa hXb => (key γ ξ hl hact hη hdom hXa hXb).1)
  refine ⟨l8 + ⌈C8p / δ0⌉₊ + 1, c, hc, fun k => ?_⟩
  obtain ⟨C, b, d, hCbd⟩ := hpd k
  refine ⟨C, b, d, fun γ ξ hl hact hη hdom hXa hXb => ?_⟩
  obtain ⟨k1, k2⟩ := key γ ξ hl hact hη hdom hXa hXb
  obtain ⟨k3, k4⟩ := hCbd γ ξ hl hact hη hdom hXa hXb
  exact ⟨k1, k2, k3, k4⟩

theorem pulse_profile_smooth_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ γ : Lab, ContDiffOn ℝ ∞ (fun η : Cyl => (chig G.r0 (xiG B.h γ (G.ctr γ) η.2.2.2) * psiT (Lsb B.h G.r0 γ.1) (vco B.h G.r0 γ (G.ctr γ) η.2.2.2)) • G.tH γ (η.1, η.2.1, η.2.2.1) (vco B.h G.r0 γ (G.ctr γ) η.2.2.2)) (DomC B.h B.qB) :=
by
  intro B G hok hG γ
  set v : Cyl → ℝ × ℝ := fun η => Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ with hv
  have hvc : Continuous v := by
    rw [hv]
    unfold Jpow
    fun_prop
  have hr0 : 0 < G.r0 := hG.1.1
  have hci : 0 < cib B.h γ.1 := by
    unfold cib
    have hT : (0:ℝ) < Tgc := by unfold Tgc; positivity
    have hQ : (0:ℝ) < Qb γ.1 := by unfold Qb; positivity
    exact mul_pos (zpow_pos hT _) (Real.rpow_pos_of_pos hQ _)
  have hLs : 0 < Lsb B.h G.r0 γ.1 := by
    unfold Lsb
    exact div_pos (by linarith) hci

  have hpsi : ∀ Ls : ℝ, 0 < Ls → ContDiff ℝ ∞ (psiT Ls) := by
    intro Ls hLs0
    rw [contDiff_iff_contDiffAt]
    intro v0
    by_cases hv0 : |v0 - Ls/2| < Ls/5
    · have hev : psiT Ls =ᶠ[nhds v0] fun _ => (1:ℝ) := by
        have hO : IsOpen {w : ℝ | |w - Ls/2| < Ls/5} :=
          isOpen_lt ((continuous_id.sub continuous_const).abs) continuous_const
        filter_upwards [hO.mem_nhds hv0] with w hw
        unfold psiT
        apply Real.smoothTransition.one_of_one_le
        have hden : 0 < Ls/3 - Ls/5 := by linarith
        rw [le_div_iff₀ hden]
        have : |w - Ls/2| < Ls/5 := hw
        linarith
      exact contDiffAt_const.congr_of_eventuallyEq hev
    · have hne : v0 - Ls/2 ≠ 0 := by
        intro h
        apply hv0
        rw [h, abs_zero]
        linarith
      have habs : ContDiffAt ℝ ∞ (fun w : ℝ => |w - Ls/2|) v0 :=
        (contDiffAt_abs hne).comp v0 (contDiffAt_id.sub contDiffAt_const)
      have hg : ContDiffAt ℝ ∞ (fun w : ℝ => (Ls/3 - |w - Ls/2|) / (Ls/3 - Ls/5)) v0 :=
        (contDiffAt_const.sub habs).div_const _
      exact Real.smoothTransition.contDiff.contDiffAt.comp v0 hg
  have hpsiL := hpsi _ hLs
  have hchig : ContDiff ℝ ∞ (chig G.r0) := by
    have e : chig G.r0 = fun s => Real.smoothTransition (1 - (4 * s / G.r0) ^ 2) := rfl
    rw [e]
    exact Real.smoothTransition.contDiff.comp
      (contDiff_const.sub (((contDiff_const.mul contDiff_id).div_const _).pow 2))

  have s1 : ∀ s : ℝ, chig G.r0 s ≠ 0 → |s| < G.r0 / 4 := by
    intro s hs
    unfold chig bumpR at hs
    have h3 : (4 * s / G.r0) ^ 2 < 1 := by
      by_contra hcon
      exact hs (Real.smoothTransition.zero_of_nonpos (by linarith [not_lt.mp hcon]))
    have h4 := (sq_lt_one_iff_abs_lt_one _).mp h3
    rw [abs_div, abs_mul, abs_of_pos hr0, abs_of_pos (by norm_num : (0:ℝ) < 4), div_lt_one hr0] at h4
    linarith
  have s2gen : ∀ E ci r : ℝ, 0 < ci → 0 < r →
      Real.smoothTransition ((2 * r / ci / 3 - |(E + r) / ci - 2 * r / ci / 2|) /
        (2 * r / ci / 3 - 2 * r / ci / 5)) ≠ 0 → |E| < 2 * r / 3 := by
    intro E ci r hci0 hr hs
    have hLpos : 0 < 2 * r / ci := div_pos (by linarith) hci0
    have hden : 0 < 2 * r / ci / 3 - 2 * r / ci / 5 := by linarith
    have hnum : 0 < 2 * r / ci / 3 - |(E + r) / ci - 2 * r / ci / 2| := by
      by_contra hcon
      apply hs
      apply Real.smoothTransition.zero_of_nonpos
      exact div_nonpos_of_nonpos_of_nonneg (not_lt.mp hcon) hden.le
    have hid : (E + r) / ci - 2 * r / ci / 2 = E / ci := by ring
    rw [hid, abs_div, abs_of_pos hci0] at hnum
    have e : 2 * r / ci / 3 = (2 * r / 3) / ci := by ring
    have h5 : |E| / ci < (2 * r / 3) / ci := by linarith
    exact (div_lt_div_iff_of_pos_right hci0).mp h5

  have hb0 : 0 ≤ bgc := by unfold bgc; linarith [Real.one_lt_sqrt_two]
  have hb1 : bgc ≤ 1 := by
    unfold bgc
    nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
  have hden : (1 + bgc ^ 2) * (1 + bgc ^ 2)⁻¹ = 1 := mul_inv_cancel₀ (by positivity)
  have id1 : ∀ w : ℝ × ℝ, w.1 = lamR w + bgc * lamT w := by
    intro w
    simp only [lamR, lamT, div_eq_mul_inv]
    linear_combination (-w.1) * hden
  have id2 : ∀ w : ℝ × ℝ, w.2 = -(bgc * lamR w) + lamT w := by
    intro w
    simp only [lamR, lamT, div_eq_mul_inv]
    linear_combination (-w.2) * hden
  have hr0' : G.r0 ≤ 1/100 := hG.1.2.1
  have key : ∀ (R T : ℝ), |R| ≤ G.r0 / 4 → |T| ≤ G.r0 →
      |R + bgc * T| ≤ 1/80 ∧ |-(bgc * R) + T| ≤ 1/80 := by
    intro R T hR hT
    obtain ⟨hR1, hR2⟩ := abs_le.mp hR
    obtain ⟨hT1, hT2⟩ := abs_le.mp hT
    have hr0n : 0 ≤ G.r0 := le_trans (abs_nonneg _) hT
    have e1 : bgc * T ≤ G.r0 := by
      nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hT2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
