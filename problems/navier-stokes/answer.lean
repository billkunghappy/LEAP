  have hDne : (1 + bgc ^ 2 : ℝ) ≠ 0 := hD.ne'
  have hTg : (0:ℝ) < Tgc := by unfold Tgc; positivity
  have hκ : 0 < cib h γ.1 := by
    unfold cib
    have hQ : (0:ℝ) < Qb γ.1 := by unfold Qb; positivity
