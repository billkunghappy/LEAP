theorem plin5_prin_small_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (β : ℝ) (d : WC), InWg5 B G (qsOf l0) β d → InWg5 B G (qsOf l0) (β - 2 * kapS) (primOp5 B G (fun γ m η => (((qC B.h η ^ (-Aex B.h)) : ℝ) : ℂ) • d γ m η)) :=
by
  intro B G hok hG
  obtain ⟨lp, Hp⟩ := pulse_support_good_v5 B G hok hG
  obtain ⟨l2, H2⟩ := inWg5_dVc_class_v5 B G hok hG
  obtain ⟨l4, H4⟩ := prin_mat_coeffs_v5 B G hok hG
  refine ⟨lp + l2 + l4, fun l0 hl0 β d hd => ?_⟩
  have hk : kapS = 1 / 100000 := rfl
  have hh : 0 < B.h := hok.2.1.1
  have hh1 : B.h < 1/100 := hok.2.1.2.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hq1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  obtain ⟨hDo, hqsm, hqpos, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hQ : ∀ l : ℕ, 0 < Qb l := fun l => Real.rpow_pos_of_pos (by norm_num) _

  have hV : InWg5 B G (qsOf l0) β (fun γ m ξ => dVc B γ.1 (d γ m) ξ) := H2 l0 (by omega) β d hd

  obtain ⟨μ, hμ⟩ : ∃ μ : Lab → Cyl → ℂ, μ = fun γ η => (((qC B.h η / Qb γ.1) ^ (1 + B.h) : ℝ) : ℂ) :=
    ⟨_, rfl⟩
  have hT1 : InWg5 B G (qsOf l0) (β + 0) (fun γ m ξ => μ γ ξ • dVc B γ.1 (d γ m) ξ) := by
    refine inWg5_smul_mult B G l0 hok β 0 (fun γ m ξ => dVc B γ.1 (d γ m) ξ) μ hV ?_ ?_ ?_
    · intro γ m ξ hξ _
      have h1 : ContDiffAt ℝ ∞ (qC B.h) ξ := hqsm.contDiffAt (hDo.mem_nhds hξ)
      have h2 : ContDiffAt ℝ ∞ (fun η => qC B.h η / Qb γ.1) ξ := h1.div_const _
      have h3 : ContDiffAt ℝ ∞ (fun η => (qC B.h η / Qb γ.1) ^ (1 + B.h)) ξ :=
        h2.rpow_const_of_ne (div_pos (hqpos ξ hξ) (hQ _)).ne'
      have e : μ γ = fun η => Complex.ofRealCLM ((qC B.h η / Qb γ.1) ^ (1 + B.h)) := by
        funext η; rw [hμ]; simp
      rw [e]
      exact Complex.ofRealCLM.contDiff.comp_contDiffAt ξ h3
    · intro γ m ξ _ _ c _
      rw [hμ]
      rfl
    · intro k
      obtain ⟨K, hK⟩ := qC_ratio_rpow_nb B hok (1 + B.h) (by linarith) (by linarith) k
      refine ⟨16 * |K|, 0, fun γ m ξ hξ hts _ _ => ?_⟩
      have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
      have hb : NB B.h (μ γ) k ξ ≤ K * (qC B.h ξ / Qb γ.1) ^ (1 + B.h) := by
        rw [hμ]; exact hK (Qb γ.1) (hQ _) ξ hξ'.2.1 (le_trans hξ'.2.2.le hq1)
      have h4 := (Hp l0 (by omega) β _ hV γ m ξ hξ hts).2.2.2.2.1
      have h0 : 0 ≤ qC B.h ξ / Qb γ.1 := (div_pos (hqpos ξ hξ) (hQ _)).le
      have hx0 : 0 ≤ (qC B.h ξ / Qb γ.1) ^ (1 + B.h) := Real.rpow_nonneg h0 _
      have hx16 : (qC B.h ξ / Qb γ.1) ^ (1 + B.h) ≤ 16 := by
        have h5 := Real.rpow_le_rpow h0 h4.le (by linarith : (0:ℝ) ≤ 1 + B.h)
        have h6 : (4:ℝ) ^ (1 + B.h) ≤ (4:ℝ) ^ (2:ℝ) :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
        have e : (4:ℝ) ^ (2:ℝ) = 16 := by rw [Real.rpow_two]; norm_num
        linarith
      have hKx : K * (qC B.h ξ / Qb γ.1) ^ (1 + B.h) ≤ |K| * 16 :=
        le_trans (mul_le_mul_of_nonneg_right (le_abs_self K) hx0)
          (mul_le_mul_of_nonneg_left hx16 (abs_nonneg K))
      have e2 : 16 * |K| * qC B.h ξ ^ (B.h * 0) * SC B.h ξ ^ (0:ℝ) = 16 * |K| := by simp
      rw [e2]
      linarith

  obtain ⟨H, hH0, hHz⟩ := hd.1
  have hT2 : InWg5 B G (qsOf l0) (β + 0)
      (fun γ m ξ => (pulseMatC (prinMat5 B G γ m ξ)).mulVec (d γ m ξ)) := by
    refine inWg5_mat_mult_v5 B G l0 hok β 0 d (prinMat5 B G) hd ?_ ?_ ?_
    · intro γ m ξ hξ hts i j
      obtain ⟨-, hA, hl, h1, h2, h3, h4, h5, h6⟩ := Hp l0 (by omega) β d hd γ m ξ hξ hts
