        _ ≤ Krf i' * 16 := mul_le_mul_of_nonneg_left hx16 (hKr0 i')
        _ ≤ Arc := by rw [hArc]; linarith
    have hKb : ∀ i' : ℕ, i' ≤ k → NB B.h (fun η : Cyl => Kmat B G γ η i j) i' ξ ≤ AKc * SC B.h ξ := by
      intro i' hi'
      have h1 := hCK i' l0 (by omega) γ hA hlγ ξ hξ hq1 hq2 hX1 hX2 hxi het i j
      have h2 : |CKf i'| ≤ AKc := by
        rw [hAKc]
        exact Finset.single_le_sum (f := fun j => |CKf j|) (fun j _ => abs_nonneg _)
          (Finset.mem_range.mpr (by omega))
      calc NB B.h (fun η : Cyl => Kmat B G γ η i j) i' ξ ≤ CKf i' * SC B.h ξ := h1
        _ ≤ AKc * SC B.h ξ :=
          mul_le_mul_of_nonneg_right (le_trans (le_abs_self _) h2) hS0
    have hNb : ∀ (t : Fin 3) (i' : ℕ), i' ≤ k →
        NB B.h (fun η : Cyl => nPhi5 B G γ η t) i' ξ ≤ ANc * SC B.h ξ := by
      intro t i' hi'
      have h1 := hCN i' l0 (by omega) γ hA hlγ ξ hξ hq1 hq2 hX1 hX2 hxi het t
      have h2 : |CNf i'| ≤ ANc := by
        rw [hANc]
        exact Finset.single_le_sum (f := fun j => |CNf j|) (fun j _ => abs_nonneg _)
          (Finset.mem_range.mpr (by omega))
      calc NB B.h (fun η : Cyl => nPhi5 B G γ η t) i' ξ ≤ CNf i' * SC B.h ξ := h1
        _ ≤ ANc * SC B.h ξ :=
          mul_le_mul_of_nonneg_right (le_trans (le_abs_self _) h2) hS0
    have hA0 : 0 ≤ ANc * SC B.h ξ := mul_nonneg hAN0 hS0
    have hDb : ∀ i' : ℕ, i' ≤ k →
        NB B.h (fun η => dDamp5 B G γ η) i' ξ ≤ ADc * SC B.h ξ ^ 2 := by
      intro i' hi'
      have h := hdot (U ∩ DomC B.h (qsOf l0)) ξ (nPhi5 B G γ)
        (epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2) (ANc * SC B.h ξ) i' hWo hξW hnW
        (fun t i'' hi'' => hNb t i'' (le_trans hi'' hi'))
      refine le_trans h ?_
      have h2 : (2:ℝ) ^ i' ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hi'
      have h3 : 3 * (2 ^ i' * (ANc * SC B.h ξ) * (ANc * SC B.h ξ)) ≤
          3 * (2 ^ k * (ANc * SC B.h ξ) * (ANc * SC B.h ξ)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right h2 hA0) hA0) (by norm_num)
      have h4 : 0 ≤ 3 * (2 ^ k * (ANc * SC B.h ξ) * (ANc * SC B.h ξ)) :=
        mul_nonneg (by norm_num) (mul_nonneg (mul_nonneg (by positivity) hA0) hA0)
      calc |epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2| *
            (3 * (2 ^ i' * (ANc * SC B.h ξ) * (ANc * SC B.h ξ)))
          ≤ 4 * (3 * (2 ^ k * (ANc * SC B.h ξ) * (ANc * SC B.h ξ))) :=
            mul_le_mul (hekb γ.1) h3 (mul_nonneg (by norm_num)
              (mul_nonneg (mul_nonneg (by positivity) hA0) hA0)) (by norm_num)
        _ = ADc * SC B.h ξ ^ 2 := by rw [hADc]; ring
    have hgb : ∀ i' : ℕ, i' ≤ k →
        NB B.h (fun η => 1 * Kmat B G γ η i j + μ * dDamp5 B G γ η) i' ξ ≤
          AKc * SC B.h ξ + |μ| * (ADc * SC B.h ξ ^ 2) := by
      intro i' hi'
      have hlin := (nb_real_algebra_v5 B.h (U ∩ DomC B.h (qsOf l0)) ξ hWo hξW
        (fun η : Cyl => Kmat B G γ η i j) (fun η => dDamp5 B G γ η) hKW hDW i').2.1 1 μ
      refine le_trans hlin ?_
