  have n5 := mul_nonneg (by linarith : (0:ℝ) ≤ 1 + m0) hm1n
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = 110 * m0 ^ 2 + 220 * m0 * m1 + 220 * m0 ^ 2 +
