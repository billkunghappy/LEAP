    have hlb : l ≤ b + 1 := by
      have h' : (l:ℝ) < (b:ℝ) + 2 := by linarith
      have h'' : l < b + 2 := by exact_mod_cast h'
      omega
    obtain ⟨a, ha⟩ : ∃ a : ℕ, a = b - 4 := ⟨_, rfl⟩
    have hcI : coarseIdx h q = bandIdx h a := by
      unfold coarseIdx; rw [← hb, ← ha]
    have ha5 : 5 ≤ a := by omega
    have hal : a ≤ l := by omega
    have hla : l ≤ a + 5 := by omega
    obtain ⟨φ, hφ⟩ : ∃ φ : ℕ → ℝ, φ = fun m : ℕ => (1 + h) * (m:ℝ) * Real.log 2 - 2 * Real.log (m:ℝ) :=
      ⟨_, rfl⟩
