theorem wmo_amp_multipliers_v5 : ∀ (B : BG), B.ok → ∀ (qs : ℝ), qs ≤ 1 → (∀ ξ ∈ DomC B.h qs, ContDiffAt ℝ ∞ (fun η => Real.sqrt (qC B.h η)) ξ ∧ ContDiffAt ℝ ∞ (fun η => B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) η) ξ) ∧ ∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h qs, NB B.h (fun η => Real.sqrt (qC B.h η)) k ξ ≤ C * Real.sqrt (qC B.h ξ) ∧ NB B.h (fun η => B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun η' => Real.log (qC B.h η')) η) k ξ ≤ C :=
by
  intro B hok qs hqs
  have hh0 : 0 < B.h := hok.2.1.1
  have hS : SimScaleProps B.h := hok.1

  have hSNgen : ∀ h : ℝ, SimScaleProps h → SimNorm h := by
    intro h hS
    obtain ⟨hS1, -, -, -, hS5⟩ := hS
    open Pointwise in
    have hom : ∀ μ z τ : ℝ, 0 < μ →
        simScale h (μ ^ (1/2 - h) * z) (μ * τ) = μ * simScale h z τ := by
      intro μ z τ hμ
      have key : ∀ p : ℝ, 0 < p → μ * p - (μ ^ (1/2 - h) * z) ^ 2 * (μ * p) ^ (2 * h) =
          μ * (p - z ^ 2 * p ^ (2 * h)) := by
        intro p hp
