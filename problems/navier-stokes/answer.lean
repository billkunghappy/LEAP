       ((dotProduct (nPhiC5 B G γ ξ) ((pulseMatC (Kmat B G γ ξ)).mulVec (tw γ m ξ))
         - dotProduct (fun i => ((nPhiP5 B G γ ξ i : ℝ) : ℂ)) (tw γ m ξ)
         + dotProduct (nPhiC5 B G γ ξ) (srcHat B f γ m ξ)) / nsqC5 B G γ ξ)) ∧
  FlatW B (qsOf l0) (fun γ m ξ => ((psiWd B G γ ξ : ℝ) : ℂ) • tw γ m ξ) ∧
  FlatW B (qsOf l0) (fun γ m ξ => ((1 - psiW B G γ ξ : ℝ) : ℂ) • srcHat B f γ m ξ)
