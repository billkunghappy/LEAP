  have WB : ∀ (b φ : ℝ → ℝ) (A K s y0 Y c : ℝ), (∀ t : ℝ, t ≤ -(3 / 20) → b t = 0) →
      (∀ t : ℝ, 3 / 20 ≤ t → b t = 0) → 3 / 20 ≤ c →
