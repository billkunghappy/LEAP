    (tailHt h cinf X η) (deriv (fun y => tailHt h cinf y η) X)
    hc0.ne' hp.ne' (hFpos X η hX0 hη1 hη2).ne' rfl hHx.deriv (hFrep X hX) hFd.deriv hI0 hI.deriv
  unfold leadStressTh leadQs shearA collarTth
  rw [hWv, hJ0, hJ1]
  linear_combination halg + hsplit / (2 * X * (1 - 2 * h * η ^ 2)) -
    hIBP / (2 * X * (1 - 2 * h * η ^ 2))

theorem tailFac_C1 : ∀ ρ Xb : ℝ, 0 < Xb → 0 ≤ ρ → ρ < 1 → ContinuousOn (deriv (tailFac ρ Xb)) (Ioi 0) ∧ ∀ x : ℝ, 0 < x → HasDerivAt (tailFac ρ Xb) (deriv (tailFac ρ Xb) x) x ∧ 0 < tailFac ρ Xb x ∧ tailFac ρ Xb x ≤ 1 ∧ (Xb ≤ x → deriv (tailFac ρ Xb) x = 0) :=
