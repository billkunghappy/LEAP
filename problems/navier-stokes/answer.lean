      filter_upwards [ha] with y hy
      simp [pchAmp5, hy]
    filter_upwards [hA.eventuallyEq_nhds] with y hy
    have hy0 : pchAmp5 B Q γ N y = 0 := hy.eq_of_nhds
    have hfd : fderiv ℝ (pchAmp5 B Q γ N) y = 0 := by
      rw [hy.fderiv_eq]
      exact fderiv_const_apply (0 : Fin 3 → ℂ)
    funext j
    fin_cases j <;> simp [pchMW5, pchTr5, dR, dZ, hfd, hy0]

  have hpure : ∀ s e E p a1 a2 x1 x2 : ℝ, 0 < s → 0 ≤ e → e ≤ 1 → 0 < E → 0 ≤ p →
      s ^ a1 * e * E ^ (-x1) * (s ^ a2 * Real.sqrt e * E ^ (-x2) * p) * s ≤
        s ^ (a1 + a2 + 1) * Real.sqrt e * E ^ (-(x1 + x2)) * p := by
    intro s e E p a1 a2 x1 x2 hs he0 he1 hE hp
    have r1 : s ^ (a1 + a2 + 1) = s ^ a1 * s ^ a2 * s := by
      rw [Real.rpow_add hs, Real.rpow_add hs, Real.rpow_one]
    have r2 : E ^ (-(x1 + x2)) = E ^ (-x1) * E ^ (-x2) := by
      rw [neg_add, Real.rpow_add hE]
    rw [r1, r2]
    have hY : 0 ≤ s ^ a1 * s ^ a2 * s * Real.sqrt e * (E ^ (-x1) * E ^ (-x2)) * p :=
      mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (Real.rpow_nonneg hs.le _)
        (Real.rpow_nonneg hs.le _)) hs.le) (Real.sqrt_nonneg _))
        (mul_nonneg (Real.rpow_nonneg hE.le _) (Real.rpow_nonneg hE.le _))) hp
    calc s ^ a1 * e * E ^ (-x1) * (s ^ a2 * Real.sqrt e * E ^ (-x2) * p) * s
        = (s ^ a1 * s ^ a2 * s * Real.sqrt e * (E ^ (-x1) * E ^ (-x2)) * p) * e := by ring
      _ ≤ (s ^ a1 * s ^ a2 * s * Real.sqrt e * (E ^ (-x1) * E ^ (-x2)) * p) * 1 :=
          mul_le_mul_of_nonneg_left he1 hY
      _ = s ^ a1 * s ^ a2 * s * Real.sqrt e * (E ^ (-x1) * E ^ (-x2)) * p := by ring
  refine ⟨c0 + c1 + c2, b1 + b2 + 1, d1 + d2, fun γ m ξ hξ hX1 hX2 => ?_⟩
  show NB B.h (pchMW5 B G Mn Q γ m) k ξ ≤ _
  obtain ⟨hq0, hq1, hS⟩ := hDq ξ hξ
  obtain ⟨hE, hE1, he0⟩ := hEdge _ hX1 hX2
  have hPv : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
    unfold Penv5; exact (Real.exp_pos _).le
  have hSC0 : 0 < SC B.h ξ := by linarith
  have hcs : 0 ≤ c0 + c1 + c2 := by linarith
  have hA : 0 ≤ qC B.h ξ ^ (B.h * (β + 2/5)) := Real.rpow_nonneg hq0.le _
  have hX0 : 0 ≤ SC B.h ξ ^ (b1 + b2 + 1) * Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
      edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(d1 + d2)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) :=
    mul_nonneg (mul_nonneg (mul_nonneg (Real.rpow_nonneg hSC0.le _) (Real.sqrt_nonneg _))
      (Real.rpow_nonneg he0.le _)) hPv
  by_cases hts : ξ ∈ tsupport (Q γ m)
  · have hP : pchMwP5 B l0 Q γ m ξ := by
      show ξ ∈ DomC B.h (qsOf l0) ∧ B.Xa < XC B.h ξ ∧ XC B.h ξ < B.Xb ∧ ξ ∈ tsupport (Q γ m)
      exact ⟨hξ, hX1, hX2, hts⟩
    obtain ⟨-, ⟨U0, hU0o, hU0ξ, hU0s⟩, B0⟩ := H0 γ m ξ hP
    obtain ⟨-, ⟨U1, hU1o, hU1ξ, hU1s⟩, B1⟩ := H1 γ m ξ hP
    obtain ⟨-, ⟨U2, hU2o, hU2ξ, hU2s⟩, B2⟩ := H2 γ m ξ hP
    have hv : NB B.h (pchMW5 B G Mn Q γ m) k ξ ≤
        NB B.h (fun η => pchMW5 B G Mn Q γ m η 0) k ξ +
        NB B.h (fun η => pchMW5 B G Mn Q γ m η 1) k ξ +
        NB B.h (fun η => pchMW5 B G Mn Q γ m η 2) k ξ := by
      have := hvec B.h (pchMW5 B G Mn Q γ m) ξ k (by
        intro i
        fin_cases i
        · exact hU0s.contDiffAt (hU0o.mem_nhds hU0ξ)
        · exact hU1s.contDiffAt (hU1o.mem_nhds hU1ξ)
        · exact hU2s.contDiffAt (hU2o.mem_nhds hU2ξ))
      rwa [Fin.sum_univ_three] at this
    have e0 : NB B.h (fun η => pchMW5 B G Mn Q γ m η 0) k ξ ≤
        c0 * qC B.h ξ ^ (B.h * (β + 2/5)) * Ω γ ξ := B0 k le_rfl
    have e1 : NB B.h (fun η => pchMW5 B G Mn Q γ m η 1) k ξ ≤
        c1 * qC B.h ξ ^ (B.h * (β + 2/5)) * Ω γ ξ := B1 k le_rfl
    have e2 : NB B.h (fun η => pchMW5 B G Mn Q γ m η 2) k ξ ≤
        c2 * qC B.h ξ ^ (B.h * (β + 2/5)) * Ω γ ξ := B2 k le_rfl
    have hΩle : Ω γ ξ ≤ SC B.h ξ ^ (b1 + b2 + 1) * Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(d1 + d2)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
      rw [hΩ]
      exact hpure _ _ _ _ _ _ _ _ hSC0 hE hE1 he0 hPv
    have hsum : c0 * qC B.h ξ ^ (B.h * (β + 2/5)) * Ω γ ξ + c1 * qC B.h ξ ^ (B.h * (β + 2/5)) * Ω γ ξ +
        c2 * qC B.h ξ ^ (B.h * (β + 2/5)) * Ω γ ξ =
          (c0 + c1 + c2) * qC B.h ξ ^ (B.h * (β + 2/5)) * Ω γ ξ := by ring
    calc NB B.h (pchMW5 B G Mn Q γ m) k ξ
        ≤ (c0 + c1 + c2) * qC B.h ξ ^ (B.h * (β + 2/5)) * Ω γ ξ := by linarith
      _ ≤ (c0 + c1 + c2) * qC B.h ξ ^ (B.h * (β + 2/5)) * (SC B.h ξ ^ (b1 + b2 + 1) *
          Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
          edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(d1 + d2)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) :=
          mul_le_mul_of_nonneg_left hΩle (mul_nonneg hcs hA)
      _ = _ := by ring
  · have hev := hoff γ m ξ hts
    have h0 : NB B.h (pchMW5 B G Mn Q γ m) k ξ = 0 := by
      unfold NB
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      have hz : iteratedFDeriv ℝ k (0 : Cyl → Fin 3 → ℂ) ξ = 0 := by
        have := (iteratedFDeriv_fun_zero (𝕜 := ℝ) (E := Cyl) (F := Fin 3 → ℂ) (n := k))
        exact congrFun this ξ
      rw [hz]
      have e : ((0 : ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) (Fin 3 → ℂ))
          ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) = 0 := by
        ext v
        simp
      rw [e, norm_zero]
    rw [h0]
    have := mul_nonneg (mul_nonneg hcs hA) hX0
    calc (0:ℝ) ≤ (c0 + c1 + c2) * qC B.h ξ ^ (B.h * (β + 2/5)) * (SC B.h ξ ^ (b1 + b2 + 1) *
          Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
          edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(d1 + d2)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) := this
      _ = _ := by ring

theorem pch5_pair_term : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (P Q : WC) (T : Lab → ℤ → Cyl → ℂ) (α1 α2 : ℝ), InWg5 B G (qsOf l0) α1 P → InWg5 B G (qsOf l0) α2 Q → InWg5 B G (qsOf l0) (α1 - kapS) T → (∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), T γ m ξ = ((qC B.h ξ ^ (1/2:ℝ) * (kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) : ℝ) : ℂ) * (((nPhi5 B G γ ξ 0 : ℝ) : ℂ) * P γ m ξ 0 + ((nPhi5 B G γ ξ 1 : ℝ) : ℂ) * P γ m ξ 1 + ((nPhi5 B G γ ξ 2 : ℝ) : ℂ) * P γ m ξ 2)) → (∀ (γ : Lab) (m n : ℤ), ContDiffOn ℝ ∞ (fun η => ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) • pchTr5 B G γ n (pchAmp5 B P γ m η) (pchAmp5 B Q γ n) η) (DomC B.h (qsOf l0))) ∧ ∀ k : ℕ, ∃ C b d : ℝ, ∀ (γ : Lab) (m n : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → NB B.h (fun η => ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) • pchTr5 B G γ n (pchAmp5 B P γ m η) (pchAmp5 B Q γ n) η) k ξ ≤ C * qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * SC B.h ξ ^ b * Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) :=
by
  intro B G hok hG
  obtain ⟨hh0, hh1, hXa, -, -, -, -, -, -, -, -, haa, hab⟩ := hok.2.1
  obtain ⟨lW, hWv⟩ := pch5_wave_factor B G hok hG
  obtain ⟨ls, hs⟩ := pulse_support_good_v5 B G hok hG
  refine ⟨lW + ls, ?_⟩
  intro l0 hl0 P Q T α1 α2 hP hQ hT hTid
  have hk : kapS = 1 / 100000 := rfl
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs0 : 0 < qsOf l0 := by rw [hQb]; positivity
  have hqs1 : qsOf l0 ≤ 1 := by rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  obtain ⟨hDo, hqC, hqpos, -, -, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hDq : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 ∧ 1 ≤ SC B.h ξ := by
    intro ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    refine ⟨hqpos ξ hξ, by linarith [hξ'.2.2], ?_⟩
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hEdge : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X ∧
      edgeWeight B.Xa B.Xb B.aa B.ab X ≤ 1 ∧ 0 < edgeDist B.Xa B.Xb X ∧ edgeDist B.Xa B.Xb X ≤ 1 := by
    intro X e1 e2
    refine ⟨?_, ?_, ?_, min_le_left _ _⟩
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · unfold edgeWeight
      split_ifs
      · apply Real.exp_le_one_iff.mpr
        have t1 := div_nonneg haa.le (sq_nonneg (Real.log (X / B.Xa)))
        have t2 := div_nonneg hab.le (sq_nonneg (Real.log (B.Xb / X)))
        linarith
      · norm_num
    · have hX : 0 < X := lt_trans hXa e1
      have l1 : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr e1)
      have l2 : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX).mpr e2)
      exact lt_min one_pos (lt_min l1 l2)
  have hPv0 : ∀ (γ : Lab) (ξ : Cyl), 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
    intro γ ξ; unfold Penv5; exact (Real.exp_pos _).le
  have hcastc : ∀ (ξ : Cyl) (c : ℝ) (f : Cyl → ℝ), ContDiffAt ℝ ∞ f ξ → ∀ j : ℕ,
      NB B.h (fun η => ((c * f η : ℝ) : ℂ)) j ξ ≤ |c| * NB B.h f j ξ := by
    intro ξ c f hf j
    have hLn : ‖(c • (Complex.ofRealCLM : ℝ →L[ℝ] ℂ))‖ ≤ |c| :=
      ContinuousLinearMap.opNorm_le_bound _ (abs_nonneg c) (fun x => by
        rw [ContinuousLinearMap.smul_apply, Complex.ofRealCLM_apply, norm_smul, Complex.norm_real,
          Real.norm_eq_abs, Real.norm_eq_abs])
    have hcomp : (fun η => ((c * f η : ℝ) : ℂ)) = ⇑(c • (Complex.ofRealCLM : ℝ →L[ℝ] ℂ)) ∘ f := by
      funext η
      simp [Complex.ofRealCLM_apply]
    rw [hcomp]
    have e1 : iteratedFDeriv ℝ j (⇑(c • (Complex.ofRealCLM : ℝ →L[ℝ] ℂ)) ∘ f) ξ =
        (c • (Complex.ofRealCLM : ℝ →L[ℝ] ℂ)).compContinuousMultilinearMap (iteratedFDeriv ℝ j f ξ) :=
      ContinuousLinearMap.iteratedFDeriv_comp_left (c • (Complex.ofRealCLM : ℝ →L[ℝ] ℂ)) hf
        (i := j) (by exact_mod_cast le_top)
    unfold NB
    rw [e1]
    have e2 : ((c • (Complex.ofRealCLM : ℝ →L[ℝ] ℂ)).compContinuousMultilinearMap
          (iteratedFDeriv ℝ j f ξ)).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
        (c • (Complex.ofRealCLM : ℝ →L[ℝ] ℂ)).compContinuousMultilinearMap
          ((iteratedFDeriv ℝ j f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext v
      rfl
    rw [e2]
    calc _ ≤ ‖(c • (Complex.ofRealCLM : ℝ →L[ℝ] ℂ))‖ *
          ‖(iteratedFDeriv ℝ j f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ _ := mul_le_mul_of_nonneg_right hLn (norm_nonneg _)
  have hNBc : ∀ (ξ : Cyl) (z : ℂ) (j : ℕ), NB B.h (fun _ : Cyl => z) j ξ ≤ ‖z‖ := by
    intro ξ z j
    unfold NB
    refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
    rcases Nat.eq_zero_or_pos j with hk0 | hk'
    · subst hk0; simp
    · rw [iteratedFDeriv_const_of_ne hk'.ne']; simp
  have hsm : ∀ (U : Set Cyl) (f : Cyl → ℝ), ContDiffOn ℝ ∞ f U →
      ContDiffOn ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) U := by
    intro U f hf
    have hcomp : (fun η => ((f η : ℝ) : ℂ)) = ⇑(Complex.ofRealCLM : ℝ →L[ℝ] ℂ) ∘ f := by
      funext η; simp [Complex.ofRealCLM_apply]
    rw [hcomp]
    exact (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).contDiff.comp_contDiffOn hf
  have hqsm : ∀ c : ℝ, ContDiffOn ℝ ∞ (fun η => qC B.h η ^ c) (DomC B.h (qsOf l0)) := fun c =>
    hqC.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
  have hAmpS : ∀ X : WC, (∀ γ m, ContDiffOn ℝ ∞ (X γ m) (DomC B.h (qsOf l0))) →
      ∀ γ m, ContDiffOn ℝ ∞ (pchAmp5 B X γ m) (DomC B.h (qsOf l0)) := fun X hX γ m =>
    (hsm _ _ (hqsm (-Aex B.h))).smul (hX γ m)
  have hDer : ∀ f : Cyl → (Fin 3 → ℂ), ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ (dR B.h f) (DomC B.h (qsOf l0)) ∧ ContDiffOn ℝ ∞ (dZ f) (DomC B.h (qsOf l0)) := by
    intro f hf
    have hfd : ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y) (DomC B.h (qsOf l0)) :=
      hf.fderiv_of_isOpen hDo (by exact_mod_cast le_top)
    have hvR : ContDiffOn ℝ ∞ (fun ξ : Cyl => ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv))
        (DomC B.h (qsOf l0)) :=
      contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk
        ((contDiffOn_const.mul (contDiffOn_fst.rpow_const_of_ne (fun η hη => (hη.1).ne'))).smul
          contDiffOn_const)))
    exact ⟨hfd.clm_apply hvR, hfd.clm_apply contDiffOn_const⟩

  have hph : ∀ (γ : Lab) (m : ℤ) (η : Cyl), η ∈ DomC B.h (qsOf l0) →
      pchAmp5 B P γ m η 0 * (((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) * nPhi5 B G γ η 0 : ℝ) : ℂ) +
      pchAmp5 B P γ m η 1 * (((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) * nPhi5 B G γ η 1 : ℝ) : ℂ) +
      pchAmp5 B P γ m η 2 * (((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) * nPhi5 B G γ η 2 : ℝ) : ℂ) =
      ((qC B.h η ^ (-(Aex B.h + 1/2)) : ℝ) : ℂ) * T γ m η := by
    intro γ m η hη
    have hq := hqpos η hη
    have hqq : qC B.h η ^ (-(Aex B.h + 1/2)) * qC B.h η ^ (1/2:ℝ) = qC B.h η ^ (-Aex B.h) := by
      rw [← Real.rpow_add hq]; congr 1; ring
    have hqqC : ((qC B.h η ^ (-(Aex B.h + 1/2)) : ℝ) : ℂ) * ((qC B.h η ^ (1/2:ℝ) : ℝ) : ℂ) =
        ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ) := by rw [← Complex.ofReal_mul, hqq]
    rw [hTid γ m η hη]
    simp only [pchAmp5, Pi.smul_apply, smul_eq_mul, Complex.ofReal_mul]
    linear_combination (-(((kb B.h γ.1 : ℝ) : ℂ) * ((Qb γ.1 ^ (-(1/2:ℝ)) : ℝ) : ℂ) *
      (((nPhi5 B G γ η 0 : ℝ) : ℂ) * P γ m η 0 + ((nPhi5 B G γ η 1 : ℝ) : ℂ) * P γ m η 1 +
        ((nPhi5 B G γ η 2 : ℝ) : ℂ) * P γ m η 2))) * hqqC

  let Qc : Lab → ℤ → Cyl → ℂ := fun _ _ η => ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ)
  let qa : Lab → ℤ → Cyl → ℂ := fun _ _ η => ((qC B.h η ^ (-(Aex B.h + 1/2)) : ℝ) : ℂ)
  let Rc : Lab → ℤ → Cyl → ℂ := fun _ _ η => (((η.1)⁻¹ : ℝ) : ℂ)
  let Mc : ℤ → Lab → ℤ → Cyl → ℂ := fun n _ _ _ => Complex.I * (n : ℂ)
  let Wp : Fin 3 → Lab → ℤ → Cyl → ℂ := fun i γ m η => pchAmp5 B P γ m η i
  let Wq : ℤ → Fin 3 → Lab → ℤ → Cyl → ℂ := fun n i γ _ η => pchAmp5 B Q γ n η i
  let rWq : ℤ → Fin 3 → Lab → ℤ → Cyl → ℂ := fun n i γ _ η => dR B.h (pchAmp5 B Q γ n) η i
  let zWq : ℤ → Fin 3 → Lab → ℤ → Cyl → ℂ := fun n i γ _ η => dZ (pchAmp5 B Q γ n) η i
  let PhT : Lab → ℤ → Cyl → ℂ := cxMul5 qa T
  let E0 : ℤ → Lab → ℤ → Cyl → ℂ := fun n =>
    cxSub5 (cxAdd5 (cxAdd5 (cxMul5 (Wp 0) (rWq n 0)) (cxMul5 (Wp 2) (zWq n 0)))
      (cxMul5 (cxMul5 (Mc n) PhT) (Wq n 0))) (cxMul5 (cxMul5 (Wp 1) (Wq n 1)) Rc)
  let E1 : ℤ → Lab → ℤ → Cyl → ℂ := fun n =>
    cxAdd5 (cxAdd5 (cxAdd5 (cxMul5 (Wp 0) (rWq n 1)) (cxMul5 (Wp 2) (zWq n 1)))
      (cxMul5 (cxMul5 (Mc n) PhT) (Wq n 1))) (cxMul5 (cxMul5 (Wp 1) (Wq n 0)) Rc)
  let E2 : ℤ → Lab → ℤ → Cyl → ℂ := fun n =>
    cxAdd5 (cxAdd5 (cxMul5 (Wp 0) (rWq n 2)) (cxMul5 (Wp 2) (zWq n 2)))
      (cxMul5 (cxMul5 (Mc n) PhT) (Wq n 2))

  have heq0 : ∀ (n : ℤ) (γ : Lab) (m : ℤ) (η : Cyl), η ∈ DomC B.h (qsOf l0) →
      pchPT5 B G P Q n γ m η 0 = cxMul5 Qc (E0 n) γ m η := by
    intro n γ m η hη
    have h := hph γ m η hη
