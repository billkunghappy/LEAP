      · show |Fv v 0 - (lam / Real.sqrt (1 + σ v ^ 2) - ek * Bs ^ 2 * (1 + σ v ^ 2)) * x v| ≤ γ * x v
        have hαρ : α v * ρ v = lam / Real.sqrt (1 + σ v ^ 2) := by rw [hαw, hρw]; exact c1
        have eq : Fv v 0 - (lam / Real.sqrt (1 + σ v ^ 2) - ek * Bs ^ 2 * (1 + σ v ^ 2)) * x v
            = α v * (y v - ρ v * x v) + r0 v := by
          rw [← hαρ, eqx v, hddw]; ring
        rw [eq]
        have h1 : |α v * (y v - ρ v * x v)| ≤ A * (k * x v) := by
