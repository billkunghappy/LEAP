  have hCφ : 1 ≤ (1 + |(m:ℝ)|) * Ch := by
    have := abs_nonneg (m:ℝ)
    nlinarith
  obtain ⟨V, hVo, hzV, hVW, hEs, hEb⟩ :=
    hs9 (fun η : Cyl => ((m : ℝ) * (kb B.h γ.1 : ℝ)) * phiL5 B G γ η) U0 z ((1 + |(m:ℝ)|) * Ch) Mh
