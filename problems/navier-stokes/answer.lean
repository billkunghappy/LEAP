    · rw [← hκ]; exact hκb.2
    · rw [← hκ]; exact hκt

  have h4X : 4 < X * Λ := by
    have := (div_lt_iff₀ hΛ0).mp hX
    linarith
  have hXpos : 0 < X * Λ / 4 := by linarith
  have hs0 : 0 < axLogY Λ X := by
    show 0 < Real.log (X * Λ / 4)
    exact Real.log_pos (by linarith)
  have hsY : axLogY Λ X ≤ Real.log (110 * Λ / 4) := by
    show Real.log (X * Λ / 4) ≤ Real.log (110 * Λ / 4)
