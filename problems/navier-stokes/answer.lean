  refine ⟨κ, hκ, fun a b p1 p2 φ => Fa ((a, b, p1, p2), φ),
    fun a b p1 p2 φ => Fb ((a, b, p1, p2), φ), hFa_s.comp hι.contDiffOn hιm,
    hFb_s.comp hι.contDiffOn hιm, ?_, ?_⟩
  · intro a b p1 p2 ha2 _
    have ha : 0 < a := by linarith
    have hq : ((a, b, p1, p2) : ℝ × ℝ × ℝ × ℝ) ∈ U := by rw [hUdef]; exact ha
    have htsq : ts (a, b, p1, p2) = -(b / a) := hts _
    have hvsq : vs (a, b, p1, p2) = a * (1 + (b / a) ^ 2) := hvs _
    have key : ∀ φ, Dn (a, b, p1, p2) (θ (a, b, p1, p2) (φ + 1)) =
