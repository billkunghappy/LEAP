        · rw [flat g ε Xb hε hXb0.le hg hgz j _ η hge hη1 hη2, norm_zero]; exact hB
      have hev : P =ᶠ[nhds (X, η)] fun q => a q * ∫ s in (0:ℝ)..1, g (q.1 + Xb * s) q.2 :=
        Filter.eventuallyEq_of_mem (hO.mem_nhds ⟨hX0, hη1, hη2⟩) hrep
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
      exact mulb a _ _ (X, η) m A B hO ⟨hX0, hη1, hη2⟩
        (ha.mono (fun q hq => ⟨hq.1, mem_univ _⟩)) hΨs (fun j hj => haA j hj _ hXKc) hbΨ
    have hcont : ∀ (f : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿f) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
