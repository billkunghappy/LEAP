      have hfrac : ∀ w ∈ S, ‖2 * w / (1 + w ^ 2)‖ ≤ 16 / 5 := by
        intro w hw
        have hu := hnu w hw
        have hupos : 0 < ‖1 + w ^ 2‖ := by linarith
        rw [norm_div, norm_mul, div_le_iff₀ hupos]
        have : ‖(2 : ℂ)‖ = 2 := by simp
        rw [this]
        nlinarith [hnw w hw]
      have hderiv : ∀ w ∈ S, ∀ y, HasDerivAt (fun w => Fc w y) (Fc' w y) w := by
        intro w hw y
        have h1 : HasDerivAt (fun w : ℂ => 1 + w ^ 2) (2 * w) w := by
