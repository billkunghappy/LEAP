    (CB _ univ _ isOpen_univ hKc (subset_univ _) hp1.contDiffOn k).imp (fun C hC z hz => hC z (hSK hz))
  have hj2 : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X1 ×ˢ Ioo (-1:ℝ) 1,
      ‖iteratedFDeriv ℝ k (fun z : ℝ × ℝ => 16 * z.2 ^ 2) z‖ ≤ C := fun k =>
    (CB _ univ _ isOpen_univ hKc (subset_univ _) hp2.contDiffOn k).imp (fun C hC z hz => hC z (hSK hz))
  have jM : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X1 ×ˢ Ioo (-1:ℝ) 1,
      ‖iteratedFDeriv ℝ k (fun z : ℝ × ℝ => U0 z.1 z.2 - 4 * z.2) z‖ ≤ C :=
    SUB (↿U0) (fun z : ℝ × ℝ => 4 * z.2) _ _ hΩo hSΩ hU hp1.contDiffOn hjU hj1
  have jSq : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X1 ×ˢ Ioo (-1:ℝ) 1,
      ‖iteratedFDeriv ℝ k (fun z : ℝ × ℝ => U0 z.1 z.2 * U0 z.1 z.2) z‖ ≤ C :=
    PROD (↿U0) (↿U0) _ _ hΩo hSΩ hU hU hjU hjU
  have jU0 : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X1 ×ˢ Ioo (-1:ℝ) 1,
      ‖iteratedFDeriv ℝ k (fun z : ℝ × ℝ => U0 z.1 z.2 * U0 z.1 z.2 - 16 * z.2 ^ 2) z‖ ≤ C :=
    SUB (fun z : ℝ × ℝ => U0 z.1 z.2 * U0 z.1 z.2) (fun z : ℝ × ℝ => 16 * z.2 ^ 2) _ _ hΩo hSΩ
      cSq hp2.contDiffOn jSq hj2
  have eU : (fun z : ℝ × ℝ => U0 z.1 z.2 ^ 2 - 16 * z.2 ^ 2) =
      (fun z : ℝ × ℝ => U0 z.1 z.2 * U0 z.1 z.2 - 16 * z.2 ^ 2) := by
    funext z; ring
  have jU : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ Icc 0 X1 ×ˢ Ioo (-1:ℝ) 1,
      ‖iteratedFDeriv ℝ k (fun z : ℝ × ℝ => U0 z.1 z.2 ^ 2 - 16 * z.2 ^ 2) z‖ ≤ C := by
    rw [eU]; exact jU0

  have hdiff : ∀ y η : ℝ, 0 ≤ y → -1 < η → η < 1 →
      HasDerivAt (fun e => U0 y e) (deriv (fun e => U0 y e) η) η := by
    intro y η h1 h2 h3
    have hc : ContDiffAt ℝ ∞ (↿U0) (y, η) :=
      hU.contDiffAt (hΩo.mem_nhds ⟨show -ε' < y by linarith, h2, h3⟩)
    have hι : ContDiffAt ℝ ∞ (fun e : ℝ => (y, e)) η := (contDiff_const.prodMk contDiff_id).contDiffAt
    have hd := (hc.comp η hι).differentiableAt (by simp)
    exact hd.hasDerivAt
  have ptM : ∀ y η : ℝ, 0 ≤ y → -1 < η → η < 1 →
      HasDerivAt (fun e => U0 y e - 4 * e) (deriv (fun e => U0 y e) η - 4 * 1) η :=
    fun y η h1 h3 h4 => (hdiff y η h1 h3 h4).sub ((hasDerivAt_id' η).const_mul 4)

  have ptU : ∀ y η : ℝ, 0 ≤ y → y ≤ X1 → -1 < η → η < 1 →
