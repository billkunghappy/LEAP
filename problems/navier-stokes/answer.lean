    have s2 := h11 l0 (by omega) (Wcov5 B G l0 S 0 2) (fun η => Wcov5 B G l0 S 2 2 η + pmP5 B G l0 S η)
      (sBase B 2) 1 1 (1 - kapS) (2 * Aex B.h) (hWS 0 2) hZc (fun η Y => rfl) ξ hξ
    have hY : ∀ η ∈ DomC B.h (qsOf l0), B.Xa < XC B.h η → XC B.h η < B.Xb →
        yAvg (Wcov5 B G l0 S 0 2) η = pmrTh B B.T0z η + yAvg (Dv 0 2) η := by
      intro η hη hY1 hY2
      have t1 : yAvg (Wcov5 B G l0 S 0 2) η = yAvg (fun ζ => Cv 0 2 ζ + Dv 0 2 ζ) η :=
        hslice _ _ η (fun Y => by simp only [hDv]; ring)
      rw [t1, (h6 l0 (by omega) _ _ _ (hCc 0 2)).2.2.2.2 _ _ (hDc 0 2) η hη]
