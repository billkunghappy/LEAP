    have hgI : IntegrableOn g (Ioi 0) := hgint

    have hsplit : (∫ x in Ioi (0:ℝ), g x) = (∫ x in Ioc 0 X6, g x) + ∫ x in Ioi X6, g x := by
      rw [← Set.Ioc_union_Ioi_eq_Ioi hX6.le]
      exact setIntegral_union Set.Ioc_disjoint_Ioi_same measurableSet_Ioi
        (hgI.mono_set Set.Ioc_subset_Ioi_self) (hgI.mono_set (Set.Ioi_subset_Ioi hX6.le))
    have hIoc : (∫ x in Ioc 0 X6, g x) = ∫ x in (0:ℝ)..X6, g x :=
      (intervalIntegral.integral_of_le hX6.le).symm
    obtain ⟨hpi, hpv⟩ := power_head_integral (rfpCi { P with Lh := Lh }) P.h X6 hh0 hh1 hX6.le
    have hsub : (∫ x in (0:ℝ)..X6, g x) =
        (∫ x in (0:ℝ)..X6, 2 * x * rfpF { P with Lh := Lh } x η) -
          ∫ x in (0:ℝ)..X6, Real.sqrt (2 * x) * rfpCi { P with Lh := Lh } * x ^ (-(1 / 2 + P.h)) :=
      intervalIntegral.integral_sub (hfQint X6 hX6.le) hpi

    have hcongQ : (∫ x in (0:ℝ)..X6, 2 * x * rfpF { P with Lh := Lh } x η) =
        ∫ x in (0:ℝ)..X6, 2 * x * rfpF P x η := by
      apply intervalIntegral.integral_congr
      intro x hx
      rw [Set.uIcc_of_le hX6.le] at hx
      rcases eq_or_lt_of_le hx.1 with h0 | hpos
      · subst h0; simp
      · simp only
        have hlx : Real.log x ≤ rfpY5 P.Md P.lam + 2 + P.T1 := by
          rw [Real.log_le_iff_le_exp hpos, ← hX6def]; exact hx.2
        unfold rfpF
        rw [(hheadQ (Real.log x) hlx).2 η]

    obtain ⟨-, -, hclamp, -, -⟩ := rfp_clamp_identities P hReg
    have hEclamp : ∀ y e : ℝ, rfpY5 P.Md P.lam ≤ y → rfpE P y e = Real.exp (rfpLam P y) := by
      intro y e hy
      unfold rfpE
      rw [mul_assoc, hclamp y e hy, mul_one]
    have hX56 : Real.exp (rfpY5 P.Md P.lam) ≤ X6 := by
      rw [hX6def]; exact Real.exp_le_exp.2 (by linarith)
    have hmid2 : (∫ x in Real.exp (rfpY5 P.Md P.lam)..X6, 2 * x * rfpF P x η) =
        ∫ x in Real.exp (rfpY5 P.Md P.lam)..X6, 2 * x * rfpF P x 0 := by
      apply intervalIntegral.integral_congr
      intro x hx
      rw [Set.uIcc_of_le hX56] at hx
      have hpos : 0 < x := lt_of_lt_of_le (Real.exp_pos _) hx.1
      have hly : rfpY5 P.Md P.lam ≤ Real.log x := by
        rw [Real.le_log_iff_exp_le hpos]; exact hx.1
      simp only
      unfold rfpF
      rw [hEclamp _ η hly, hEclamp _ 0 hly]
    have hJη : (∫ x in (0:ℝ)..X6, 2 * x * rfpF P x η) = J := by
      have hsubI : Set.uIcc (Real.exp (rfpY5 P.Md P.lam)) X6 ⊆ Set.uIcc 0 X6 :=
        Set.uIcc_subset_uIcc (Set.mem_uIcc_of_le (Real.exp_pos _).le hX56) Set.right_mem_uIcc
      have hA := hint η h1 h2 (Real.exp (rfpY5 P.Md P.lam)) (Real.exp_pos _).le
      have hB := (hint η h1 h2 X6 hX6.le).mono_set hsubI
      have hA0 := hint 0 (by norm_num) (by norm_num) (Real.exp (rfpY5 P.Md P.lam)) (Real.exp_pos _).le
      have hB0 := (hint 0 (by norm_num) (by norm_num) X6 hX6.le).mono_set hsubI
      rw [← intervalIntegral.integral_add_adjacent_intervals hA hB, (hI η h1 h2).2, hmid2,
        intervalIntegral.integral_add_adjacent_intervals hA0 hB0, hJ]

    obtain ⟨-, hciQ, htailQ⟩ := rfp_T_pointwise { P with Lh := Lh } hRegQ
    have hciQ' : rfpCi { P with Lh := Lh } * Real.exp ((1 - P.h) * (rfpY5 P.Md P.lam + 2 + P.T1)) =
        Real.exp (3 / 2 * (rfpY5 P.Md P.lam + 1) + rfpLam { P with Lh := Lh } (rfpY5 P.Md P.lam + 1)
          + (1 - P.h) * rfpSigI 1) / (1 - P.ρ) := hciQ
    have hlamQ : rfpLam { P with Lh := Lh } (rfpY5 P.Md P.lam + 1) = rfpLam P (rfpY5 P.Md P.lam + 1) :=
      (hheadQ _ (by linarith)).1
    have hW : Real.sqrt 2 * (rfpCi { P with Lh := Lh } *
        Real.exp ((1 - P.h) * (rfpY5 P.Md P.lam + 2 + P.T1))) = N := by
      rw [hciQ', hlamQ, hN, hH, hS1]; ring

    have hXb : rfpXb { P with Lh := Lh } = Real.exp (rfpY5 P.Md P.lam + 2 + P.T1 + Lh + 3) := rfl
    have hX6le : X6 ≤ rfpXb { P with Lh := Lh } * Real.exp (-2) := by
      rw [hXb, ← Real.exp_add, hX6def]; exact Real.exp_le_exp.2 (by linarith)
    have hgtail : ∀ x : ℝ, X6 ≤ x → g x = -(Real.sqrt 2 * rfpCi { P with Lh := Lh } * P.ρ *
        x ^ (-P.h) * (1 - sigA ((Real.log (x / rfpXb { P with Lh := Lh }) + 2) / 2))) := by
      intro x hx
      have hx' : Real.exp (rfpY5 P.Md P.lam + 2 + P.T1) ≤ x := (le_of_eq hX6def.symm).trans hx
      exact htailQ x η hx'
    obtain ⟨-, hgtV⟩ := tail_cutoff_integral sigA g (rfpCi { P with Lh := Lh }) P.ρ P.h X6
      (rfpXb { P with Lh := Lh }) hscont hs0 hs1 hh0 (by linarith) hX6 hX6le hgtail
    rw [← hKp] at hgtV
    have hr1 : X6 ^ (1 - P.h) = Real.exp ((1 - P.h) * (rfpY5 P.Md P.lam + 2 + P.T1)) := by
      rw [hX6def, ← Real.exp_mul]; congr 1; ring
    have hr2 : (rfpXb { P with Lh := Lh } * Real.exp (-2)) ^ (1 - P.h) =
        Real.exp ((1 - P.h) * (rfpY5 P.Md P.lam + 2 + P.T1) + (1 - P.h) * Lh + (1 - P.h)) := by
      rw [hXb, ← Real.exp_add, ← Real.exp_mul]; congr 1; ring
    have hr3 : rfpXb { P with Lh := Lh } ^ (1 - P.h) =
        Real.exp ((1 - P.h) * (rfpY5 P.Md P.lam + 2 + P.T1) + (1 - P.h) * Lh + 3 * (1 - P.h)) := by
      rw [hXb, ← Real.exp_mul]; congr 1; ring
    rw [Real.exp_add, Real.exp_add] at hr2 hr3
    rw [hD0, hD1] at hE
    rw [hsplit, hIoc, hsub, hcongQ, hJη, hpv, hgtV, hr1, hr2, hr3]
    linear_combination (-1 : ℝ) * hE + (-1 / (1 - P.h) - P.ρ * Real.exp ((1 - P.h) * Lh) *
      Real.exp (1 - P.h) / (1 - P.h) + P.ρ / (1 - P.h) - P.ρ * Real.exp ((1 - P.h) * Lh) *
      Real.exp (3 * (1 - P.h)) * Kp) * hW

theorem rfp_shape_data : ∀ P : RfpPar, RfpRegime P → ShapeData P.Pst (fun y => Real.exp (rfpLam P y)) (rfpTh P) :=
by
  intro P hR
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hR
  have hl2 : P.h ≤ P.lam := by nlinarith
  have hh1 : P.h ≤ 1 := by linarith
  have hρ1' : 0 < 1 - P.ρ := by linarith
  have hPst0 : 0 < P.Pst := lt_trans (Real.exp_pos _) hPst
  have hlogh : 0 ≤ Real.log (1 / P.h) := Real.log_nonneg (by rw [le_div_iff₀ hh0]; linarith)
  have hT0 : 0 ≤ P.T1 := by linarith
  have hL : 0 ≤ Real.log (1 / P.lam) := Real.log_nonneg (by rw [le_div_iff₀ hl0]; linarith)
  have hlam13 : 0 < 13 / P.lam := by positivity
  have hexpMd : 0 < Real.exp P.Md := Real.exp_pos _
  have eY2 : rfpY2 P.Md = Real.exp P.Md + 11 := rfl
  have eY3 : rfpY3 P.Md P.lam = rfpY2 P.Md + 1 + 60 * Real.log (1 / P.lam) := rfl
  have eY4 : rfpY4 P.Md P.lam = rfpY3 P.Md P.lam + 13 / P.lam := rfl
  have eY5 : rfpY5 P.Md P.lam = rfpY4 P.Md P.lam + 60 + 30 * Real.log (1 / P.lam) := rfl
  have eYb : rfpYb P.Md P.lam P.T1 P.Lh = rfpY5 P.Md P.lam + 2 + P.T1 + P.Lh + 3 := rfl
  have hY2 : 0 < rfpY2 P.Md := by rw [eY2]; linarith
  have hY4 : 0 < rfpY4 P.Md P.lam := by rw [eY4, eY3]; linarith
  have hY5 : 0 < rfpY5 P.Md P.lam := by rw [eY5]; linarith

  have sig0 : ∀ y : ℝ, y ≤ 0 → sigA y = 0 := fun y hy => by unfold sigA; simp [hy]
  have sig1 : ∀ y : ℝ, 1 ≤ y → sigA y = 1 := fun y hy => by
    unfold sigA; rw [if_neg (by linarith), if_pos hy]
  have sigR : ∀ y : ℝ, 0 ≤ sigA y ∧ sigA y ≤ 1 := by
    intro y
    unfold sigA
    split_ifs with h1 h2
    · norm_num
    · norm_num
    · have ha := Real.exp_pos (-1 / y ^ 2)
      have hb := Real.exp_pos (-1 / (1 - y) ^ 2)
      constructor
      · positivity
      · rw [div_le_one (by linarith)]; linarith
  have hσm : Measurable sigA := by
    unfold sigA
    refine Measurable.ite measurableSet_Iic measurable_const
      (Measurable.ite measurableSet_Ici measurable_const ?_)
    fun_prop
  have hI : ∀ a b : ℝ, IntervalIntegrable sigA MeasureTheory.volume a b := by
    intro a b
    refine (intervalIntegrable_const (c := (1:ℝ))).mono_fun' hσm.aestronglyMeasurable ?_
    refine Filter.Eventually.of_forall (fun s => ?_)
    show ‖sigA s‖ ≤ 1
    rw [Real.norm_eq_abs, abs_of_nonneg (sigR s).1]
    exact (sigR s).2

  have hdiff : ∀ a b : ℝ, rfpSigI b - rfpSigI a = ∫ s in a..b, sigA s := by
    intro a b; unfold rfpSigI; exact intervalIntegral.integral_interval_sub_left (hI 0 b) (hI 0 a)
  have hmono : ∀ a b : ℝ, a ≤ b → rfpSigI a ≤ rfpSigI b := by
    intro a b hab
    have := intervalIntegral.integral_nonneg (μ := MeasureTheory.volume) hab (fun u _ => (sigR u).1)
    linarith [hdiff a b]
  have hlip : ∀ a b : ℝ, a ≤ b → rfpSigI b - rfpSigI a ≤ b - a := by
    intro a b hab
    rw [hdiff a b]
    have := intervalIntegral.integral_mono_on hab (hI a b) (intervalIntegrable_const (c := (1:ℝ)))
      (fun u _ => (sigR u).2)
    simpa using this
  have hS0 : ∀ t : ℝ, t ≤ 0 → rfpSigI t = 0 := by
    intro t ht
    unfold rfpSigI
    rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ))]
    · simp
    · intro s hs
      rw [Set.uIcc_of_ge ht] at hs
      exact sig0 s hs.2
  have hS1 : ∀ t : ℝ, 1 ≤ t → rfpSigI t - rfpSigI 1 = t - 1 := by
    intro t ht
    rw [hdiff 1 t, intervalIntegral.integral_congr (g := fun _ => (1:ℝ))]
    · simp
    · intro s hs
      rw [Set.uIcc_of_le ht] at hs
      exact sig1 s hs.1
  have hSup : ∀ t : ℝ, 0 ≤ t → rfpSigI t ≤ t := by
    intro t ht; have := hlip 0 t ht; rw [hS0 0 le_rfl] at this; linarith
  have hSnn : ∀ t : ℝ, 0 ≤ rfpSigI t := by
    intro t
    rcases le_total t 0 with ht | ht
    · rw [hS0 t ht]
    · have := hmono 0 t ht; rw [hS0 0 le_rfl] at this; exact this
  have hSlow : ∀ t : ℝ, t - 1 ≤ rfpSigI t := by
    intro t
    rcases le_total t 1 with ht | ht
    · linarith [hSnn t]
    · linarith [hS1 t ht, hSnn 1]
  have hSm : Measurable rfpSigI := by
    have : Continuous rfpSigI := by
      unfold rfpSigI; exact intervalIntegral.continuous_primitive hI 0
    exact this.measurable
  have hΛm : Measurable (rfpLam P) := by
    unfold rfpLam tailFac
    fun_prop
  have hτ : ∀ y : ℝ, 1 - P.ρ ≤ tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) ∧
      tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) ≤ 1 := by
    intro y; unfold tailFac
    obtain ⟨a, b⟩ := sigR ((Real.log (Real.exp y / Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) + 2) / 2)
    have q1 := mul_nonneg hρ0.le a
    have q2 := mul_nonneg hρ0.le (show 0 ≤ 1 - sigA ((Real.log (Real.exp y /
      Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) + 2) / 2) by linarith)
    constructor <;> nlinarith
  refine ⟨hΛm.exp, ?_, ?_, ?_, ?_⟩
  · show Measurable (fun y => 1 - sigA ((y - rfpY4 P.Md P.lam) / 60))
    fun_prop
  · intro y
    have hs := sigR ((y - rfpY4 P.Md P.lam) / 60)
    refine ⟨(Real.exp_pos _).le, ?_, ?_⟩
    · show 0 ≤ 1 - sigA ((y - rfpY4 P.Md P.lam) / 60); linarith
    · show 1 - sigA ((y - rfpY4 P.Md P.lam) / 60) ≤ 1; linarith
  · intro y hy
    have hσ0 : sigA ((y - rfpY4 P.Md P.lam) / 60) = 0 :=
      sig0 _ (div_nonpos_of_nonpos_of_nonneg (by linarith) (by norm_num))
    refine ⟨?_, ?_⟩
    · show 1 - sigA ((y - rfpY4 P.Md P.lam) / 60) = 1
      rw [hσ0]; ring
    · show Real.exp (rfpLam P y) = P.Pst * Real.exp (y / 10)
      have htail : tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) = 1 - P.ρ := by
        unfold tailFac
        rw [← Real.exp_sub, Real.log_exp,
          sig0 ((y - rfpYb P.Md P.lam P.T1 P.Lh + 2) / 2) (by rw [eYb]; linarith)]
        ring
      have hΛ : rfpLam P y = Real.log P.Pst + y / 10 := by
        unfold rfpLam
        rw [hS0 y hy, hS0 (y - rfpY2 P.Md) (by linarith), hS0 (y - rfpY5 P.Md P.lam) (by linarith),
          hS0 (y - rfpY5 P.Md P.lam - 1 - P.T1) (by linarith), hσ0, htail, div_self hρ1'.ne',
          Real.log_one]
        ring
      rw [hΛ, Real.exp_add, Real.exp_log hPst0]
  · refine ⟨Real.exp (Real.log P.Pst + 3 / 5 - Real.log (1 - P.ρ)), 1 / 2 - P.lam, by linarith, ?_⟩
    intro y hy
    show Real.exp (rfpLam P y) ≤ _
    rw [← Real.exp_add]
    apply Real.exp_le_exp.2
    obtain ⟨hτ1, hτ2⟩ := hτ y
    have hτpos : 0 < tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) := by linarith
    have hlogτ : Real.log (tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) /
        (1 - P.ρ)) ≤ -Real.log (1 - P.ρ) := by
      rw [Real.log_div hτpos.ne' hρ1'.ne']
      linarith [Real.log_nonpos hτpos.le hτ2]
    have hu1 := hmono (y - rfpY5 P.Md P.lam - 1 - P.T1) (y - rfpY5 P.Md P.lam) (by linarith)
    have hu2 : rfpSigI (y - rfpY5 P.Md P.lam) ≤ y := by
      rcases le_total (y - rfpY5 P.Md P.lam) 0 with h | h
      · rw [hS0 _ h]; exact hy
      · linarith [hSup _ h]
    have p1 := mul_le_mul_of_nonneg_left hu1 (show 0 ≤ 1 - P.h by linarith)
    have p2 := mul_le_mul_of_nonneg_left hu2 (show 0 ≤ P.lam - P.h by linarith)
    have p3 := mul_nonneg hh0.le hy
    have p4 := mul_nonneg hl0.le (hSnn (y - rfpY2 P.Md))
    have p5 := mul_nonneg (sigR ((y - rfpY4 P.Md P.lam) / 60)).1
      (Real.log_nonneg (by norm_num : (1:ℝ) ≤ 2))
    have p6 := hSlow y
    unfold rfpLam
    linarith

theorem rfp_M_rep : ∀ P : RfpPar, RfpRegime P → ∀ η : ℝ, (∫ x in (0:ℝ)..rfpXv P, rfpU P x η) = η * (∫ y in Iic (rfpY4 P.Md P.lam), Real.exp y * rfpK P.Md y) + (1 + η ^ 2)⁻¹ * (P.Amp η * (∫ y in Iic (rfpY4 P.Md P.lam), Real.exp (y + rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))) + P.c1 η * (∫ y in Iic (rfpY4 P.Md P.lam), Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 3)) + P.c2 η * (∫ y in Iic (rfpY4 P.Md P.lam), Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 1))) :=
by
  intro P hP η
  have hR := hP
  obtain ⟨hMd, hPst, hl0, hl100, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hR
  have hPst0 : 0 < P.Pst := lt_trans (Real.exp_pos _) hPst
  obtain ⟨_, cG1, -, -, -⟩ := rfp_clamp_identities P hP
  obtain ⟨hcm, -, -, hcneg, C, κ, hκ, hCb⟩ := rfp_shape_data P hP

  have hsig : ∀ t, 0 ≤ sigA t ∧ sigA t ≤ 1 := by
    intro t
    unfold sigA
    split_ifs with h1 h2
    · exact ⟨le_rfl, zero_le_one⟩
    · exact ⟨zero_le_one, le_rfl⟩
    · have ha := Real.exp_pos (-1 / t ^ 2)
      have hc := Real.exp_pos (-1 / (1 - t) ^ 2)
      refine ⟨by positivity, ?_⟩
      rw [div_le_one (by positivity)]
      linarith
  have hsigm : Measurable sigA := by
    have e : sigA = fun y => if y ≤ 0 then 0 else if 1 ≤ y then 1 else
        Real.exp (-1 / y ^ 2) / (Real.exp (-1 / y ^ 2) + Real.exp (-1 / (1 - y) ^ 2)) := by
      funext y; rfl
    rw [e]
    refine Measurable.ite measurableSet_Iic measurable_const
      (Measurable.ite measurableSet_Ici measurable_const ?_)
    fun_prop

  have hb : ∀ t, |rfpBmp t| ≤ 1 := by
    intro t
    unfold rfpBmp
    obtain ⟨a0, a1⟩ := hsig (1 + t / (3 / 20))
    obtain ⟨b0, b1⟩ := hsig (1 - t / (3 / 20))
    rw [abs_of_nonneg (mul_nonneg a0 b0)]
    exact mul_le_one₀ a1 b0 b1
  have hbm : Measurable rfpBmp := by
    have e : rfpBmp = fun t => sigA (1 + t / (3 / 20)) * sigA (1 - t / (3 / 20)) := by
      funext t; rfl
    rw [e]
    exact (hsigm.comp (by fun_prop : Measurable fun t : ℝ => 1 + t / (3 / 20))).mul
      (hsigm.comp (by fun_prop : Measurable fun t : ℝ => 1 - t / (3 / 20)))

  have hk : ∀ y, |rfpK P.Md y| ≤ 4 := by
    intro y
    unfold rfpK
    split_ifs
    · norm_num
    · obtain ⟨a0, a1⟩ := hsig (Real.log y / P.Md)
      rw [abs_le]; constructor <;> linarith
  have hkm : Measurable (rfpK P.Md) := by
    have e : rfpK P.Md = fun y => if y ≤ 1 then 4 else 4 * (1 - sigA (Real.log y / P.Md)) := by
      funext y; rfl
    rw [e]
    exact Measurable.ite measurableSet_Iic measurable_const
      (measurable_const.mul (measurable_const.sub (hsigm.comp (Real.measurable_log.div_const _))))

  have hII : ∀ a b : ℝ, IntervalIntegrable (fun v => sigA (50 * v)) volume a b := by
    intro a b
    have hc : IntervalIntegrable (fun _ : ℝ => (1:ℝ)) volume a b := intervalIntegrable_const
    refine hc.mono_fun' ?_ ?_
    · exact (hsigm.comp (measurable_const.mul measurable_id)).aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun v => ?_)
      show ‖sigA (50 * v)‖ ≤ 1
      rw [Real.norm_eq_abs, abs_of_nonneg (hsig _).1]
      exact (hsig _).2
  have hR0m : Measurable rfpR0 := by
    have e : rfpR0 = fun ξ => (∫ v in (0:ℝ)..ξ, sigA (50 * v)) * (1 - sigA (ξ - 10)) := by
      funext ξ; rfl
    rw [e]
    exact (intervalIntegral.continuous_primitive hII 0).measurable.mul
      (measurable_const.sub (hsigm.comp (measurable_id.sub_const _)))
  have hR0b : ∀ ξ : ℝ, ξ ≤ 13 → |rfpR0 ξ| ≤ 13 := by
    intro ξ hξ
    unfold rfpR0
    obtain ⟨s0, s1⟩ := hsig (ξ - 10)
    have h1 : |1 - sigA (ξ - 10)| ≤ 1 := by rw [abs_le]; constructor <;> linarith
    rcases le_or_gt ξ 0 with hn | hp
    · have hz : (∫ v in (0:ℝ)..ξ, sigA (50 * v)) = ∫ v in (0:ℝ)..ξ, (0:ℝ) := by
        apply intervalIntegral.integral_congr
        intro v hv
        rw [Set.uIcc_of_ge hn] at hv
        show sigA (50 * v) = 0
        unfold sigA
        rw [if_pos (by linarith [hv.2])]
      rw [hz, intervalIntegral.integral_zero, zero_mul, abs_zero]
      norm_num
    · have hI := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := ξ) (C := 1)
        (f := fun v => sigA (50 * v)) (fun v _ => by
          show ‖sigA (50 * v)‖ ≤ 1
          rw [Real.norm_eq_abs, abs_of_nonneg (hsig _).1]
          exact (hsig _).2)
      rw [Real.norm_eq_abs] at hI
      have hξ' : |ξ - 0| ≤ 13 := by rw [sub_zero, abs_of_pos hp]; exact hξ
      rw [abs_mul]
      calc |∫ v in (0:ℝ)..ξ, sigA (50 * v)| * |1 - sigA (ξ - 10)| ≤ 13 * 1 :=
            mul_le_mul (by linarith) h1 (abs_nonneg _) (by norm_num)
        _ = 13 := by norm_num

  have hEm : Measurable (fun y => Real.exp (rfpLam P y)) := hcm
  have hE : ∀ y, Real.exp (rfpLam P y) ≤ P.Pst + |C| := by
    intro y
    rcases le_or_gt y 0 with hy | hy
    · have e : Real.exp (rfpLam P y) = P.Pst * Real.exp (y / 10) := (hcneg y hy).2
      rw [e]
      have : Real.exp (y / 10) ≤ 1 := Real.exp_le_one_iff.2 (by linarith)
      nlinarith [abs_nonneg C]
    · have e : Real.exp (rfpLam P y) ≤ C * Real.exp (-(κ * y)) := hCb y hy.le
      have h1 : Real.exp (-(κ * y)) ≤ 1 := Real.exp_le_one_iff.2 (by nlinarith)
      have h2 : C * Real.exp (-(κ * y)) ≤ |C| := by
        calc C * Real.exp (-(κ * y)) ≤ |C| * Real.exp (-(κ * y)) :=
              mul_le_mul_of_nonneg_right (le_abs_self C) (Real.exp_pos _).le
          _ ≤ |C| * 1 := mul_le_mul_of_nonneg_left h1 (abs_nonneg C)
          _ = |C| := mul_one _
      linarith
  have hM0 : 0 ≤ P.Pst + |C| := by linarith [abs_nonneg C]
  have hEm' : Measurable (fun y => Real.exp (y + rfpLam P y)) := by
    have e : (fun y => Real.exp (y + rfpLam P y)) = fun y => Real.exp y * Real.exp (rfpLam P y) := by
      funext y; exact Real.exp_add _ _
    rw [e]
    exact Real.measurable_exp.mul hEm
  have hEP : ∀ y, ‖Real.exp (y + rfpLam P y)‖ ≤ (P.Pst + |C|) * Real.exp y := by
    intro y
    rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), Real.exp_add, mul_comm (P.Pst + |C|)]
    exact mul_le_mul_of_nonneg_left (hE y) (Real.exp_pos y).le

  have hexpI : IntegrableOn Real.exp (Iic (rfpY4 P.Md P.lam)) := integrableOn_exp_Iic _
  have hIA : IntegrableOn (fun y => Real.exp y * rfpK P.Md y) (Iic (rfpY4 P.Md P.lam)) := by
    refine Integrable.mono' (hexpI.const_mul 4) ((Real.measurable_exp.mul hkm).aestronglyMeasurable) ?_
    refine Filter.Eventually.of_forall (fun y => ?_)
    show ‖Real.exp y * rfpK P.Md y‖ ≤ 4 * Real.exp y
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos (Real.exp_pos y), mul_comm 4]
    exact mul_le_mul_of_nonneg_left (hk y) (Real.exp_pos y).le
  have hIB : ∀ s : ℝ, IntegrableOn (fun y => Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + s))
      (Iic (rfpY4 P.Md P.lam)) := by
    intro s
    refine Integrable.mono' (hexpI.const_mul (P.Pst + |C|))
      ((hEm'.mul (hbm.comp (by fun_prop : Measurable fun y : ℝ => y - rfpY4 P.Md P.lam + s))).aestronglyMeasurable) ?_
    refine Filter.Eventually.of_forall (fun y => ?_)
    show ‖Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + s)‖ ≤ (P.Pst + |C|) * Real.exp y
    rw [norm_mul]
    calc ‖Real.exp (y + rfpLam P y)‖ * ‖rfpBmp (y - rfpY4 P.Md P.lam + s)‖
        ≤ ((P.Pst + |C|) * Real.exp y) * 1 :=
          mul_le_mul (hEP y) (by rw [Real.norm_eq_abs]; exact hb _) (norm_nonneg _)
            (mul_nonneg hM0 (Real.exp_pos y).le)
      _ = (P.Pst + |C|) * Real.exp y := mul_one _
  have hIR : IntegrableOn (fun y => Real.exp (y + rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam)))
      (Iic (rfpY4 P.Md P.lam)) := by
    refine Integrable.mono' (hexpI.const_mul ((P.Pst + |C|) * 13))
      ((hEm'.mul (hR0m.comp (by fun_prop : Measurable fun y : ℝ => P.lam * (y - rfpY3 P.Md P.lam)))).aestronglyMeasurable) ?_
    refine ae_restrict_of_forall_mem measurableSet_Iic (fun y hy => ?_)
    show ‖Real.exp (y + rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))‖ ≤ (P.Pst + |C|) * 13 * Real.exp y
    have hξ : P.lam * (y - rfpY3 P.Md P.lam) ≤ 13 := by
      have h4 : y - rfpY3 P.Md P.lam ≤ 13 / P.lam := by
        have := mem_Iic.mp hy
        unfold rfpY4 at this
        linarith
      calc P.lam * (y - rfpY3 P.Md P.lam) ≤ P.lam * (13 / P.lam) := mul_le_mul_of_nonneg_left h4 hl0.le
        _ = 13 := by field_simp
    rw [norm_mul]
    calc ‖Real.exp (y + rfpLam P y)‖ * ‖rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))‖
        ≤ ((P.Pst + |C|) * Real.exp y) * 13 :=
          mul_le_mul (hEP y) (by rw [Real.norm_eq_abs]; exact hR0b _ hξ) (norm_nonneg _)
            (mul_nonneg hM0 (Real.exp_pos y).le)
      _ = (P.Pst + |C|) * 13 * Real.exp y := by ring

  have hsub : (∫ x in (0:ℝ)..rfpXv P, rfpU P x η) =
      ∫ y in Iic (rfpY4 P.Md P.lam), Real.exp y * rfpU P (Real.exp y) η := by
    have h0 : (0:ℝ) ≤ rfpXv P := (Real.exp_pos _).le
    rw [intervalIntegral.integral_of_le h0, show rfpXv P = Real.exp (rfpY4 P.Md P.lam) from rfl,
      ← Real.image_exp_Iic,
      integral_image_eq_integral_abs_deriv_smul measurableSet_Iic
        (fun x _ => (Real.hasDerivAt_exp x).hasDerivWithinAt) Real.exp_injective.injOn
        (fun x => rfpU P x η)]
    refine setIntegral_congr_fun measurableSet_Iic (fun y _ => ?_)
    simp only [abs_of_pos (Real.exp_pos y), smul_eq_mul]

  have hpt : ∀ y ∈ Iic (rfpY4 P.Md P.lam), Real.exp y * rfpU P (Real.exp y) η =
      η * (Real.exp y * rfpK P.Md y)
      + ((1 + η ^ 2)⁻¹ * P.Amp η) * (Real.exp (y + rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam)))
      + ((1 + η ^ 2)⁻¹ * P.c1 η) * (Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 3))
      + ((1 + η ^ 2)⁻¹ * P.c2 η) * (Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 1)) := by
    intro y hy
    have hEy : rfpE P y η = Real.exp (rfpLam P y) * (1 + η ^ 2)⁻¹ := by
      rw [← cG1 y η (mem_Iic.mp hy)]
      unfold rfpE
      ring
    have hU : rfpU P (Real.exp y) η = η * rfpK P.Md y + rfpE P y η * rfpRb P y η := by
      unfold rfpU
      rw [Real.log_exp]
    rw [hU, hEy, Real.exp_add]
    unfold rfpRb
    ring
  rw [hsub, setIntegral_congr_fun measurableSet_Iic hpt]
  have iA : Integrable (fun y => η * (Real.exp y * rfpK P.Md y)) (volume.restrict (Iic (rfpY4 P.Md P.lam))) :=
    hIA.const_mul η
  have iR : Integrable (fun y => ((1 + η ^ 2)⁻¹ * P.Amp η) *
      (Real.exp (y + rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))))
      (volume.restrict (Iic (rfpY4 P.Md P.lam))) := hIR.const_mul _
  have iB1 : Integrable (fun y => ((1 + η ^ 2)⁻¹ * P.c1 η) *
      (Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 3)))
      (volume.restrict (Iic (rfpY4 P.Md P.lam))) := (hIB 3).const_mul _
  have iB2 : Integrable (fun y => ((1 + η ^ 2)⁻¹ * P.c2 η) *
      (Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 1)))
      (volume.restrict (Iic (rfpY4 P.Md P.lam))) := (hIB 1).const_mul _
  have iAR : Integrable (fun y => η * (Real.exp y * rfpK P.Md y) + ((1 + η ^ 2)⁻¹ * P.Amp η) *
      (Real.exp (y + rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))))
      (volume.restrict (Iic (rfpY4 P.Md P.lam))) := iA.add iR
  have iARB : Integrable (fun y => η * (Real.exp y * rfpK P.Md y) + ((1 + η ^ 2)⁻¹ * P.Amp η) *
      (Real.exp (y + rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))) +
      ((1 + η ^ 2)⁻¹ * P.c1 η) * (Real.exp (y + rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 3)))
      (volume.restrict (Iic (rfpY4 P.Md P.lam))) := iAR.add iB1
  rw [integral_add iARB iB2, integral_add iAR iB1, integral_add iA iR, integral_const_mul,
    integral_const_mul, integral_const_mul, integral_const_mul]
  ring

theorem rfp_J_rep : ∀ P : RfpPar, RfpRegime P → ∀ η : ℝ, (∫ x in Ioi (0:ℝ), rfpU P x η * (2 * x * rfpF P x η)) = η * (1 + η ^ 2)⁻¹ * (∫ y in Iic (rfpY4 P.Md P.lam), Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * rfpK P.Md y) + ((1 + η ^ 2)⁻¹) ^ 2 * (P.Amp η * (∫ y in Iic (rfpY4 P.Md P.lam), Real.sqrt 2 * Real.exp (3 / 2 * y + 2 * rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))) + P.c1 η * (∫ y in Iic (rfpY4 P.Md P.lam), Real.sqrt 2 * Real.exp (3 / 2 * y + 2 * rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 3)) + P.c2 η * (∫ y in Iic (rfpY4 P.Md P.lam), Real.sqrt 2 * Real.exp (3 / 2 * y + 2 * rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 1))) :=
by
  intro P hP η
  have hR := hP
  obtain ⟨hMd, hPst, hl0, hl100, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hR
  have hPst0 : 0 < P.Pst := lt_trans (Real.exp_pos _) hPst
  obtain ⟨_, cG1, -, -, cG5⟩ := rfp_clamp_identities P hP
  obtain ⟨hcm, -, -, hcneg, C, κ, hκ, hCb⟩ := rfp_shape_data P hP

  have hsig : ∀ t, 0 ≤ sigA t ∧ sigA t ≤ 1 := by
    intro t
    unfold sigA
    split_ifs with h1 h2
    · exact ⟨le_rfl, zero_le_one⟩
    · exact ⟨zero_le_one, le_rfl⟩
    · have ha := Real.exp_pos (-1 / t ^ 2)
      have hc := Real.exp_pos (-1 / (1 - t) ^ 2)
      refine ⟨by positivity, ?_⟩
      rw [div_le_one (by positivity)]
      linarith
  have hsigm : Measurable sigA := by
    have e : sigA = fun y => if y ≤ 0 then 0 else if 1 ≤ y then 1 else
        Real.exp (-1 / y ^ 2) / (Real.exp (-1 / y ^ 2) + Real.exp (-1 / (1 - y) ^ 2)) := by
      funext y; rfl
    rw [e]
    refine Measurable.ite measurableSet_Iic measurable_const
      (Measurable.ite measurableSet_Ici measurable_const ?_)
    fun_prop

  have hb : ∀ t, |rfpBmp t| ≤ 1 := by
    intro t
    unfold rfpBmp
    obtain ⟨a0, a1⟩ := hsig (1 + t / (3 / 20))
    obtain ⟨b0, b1⟩ := hsig (1 - t / (3 / 20))
    rw [abs_of_nonneg (mul_nonneg a0 b0)]
    exact mul_le_one₀ a1 b0 b1
  have hbm : Measurable rfpBmp := by
    have e : rfpBmp = fun t => sigA (1 + t / (3 / 20)) * sigA (1 - t / (3 / 20)) := by
      funext t; rfl
    rw [e]
    exact (hsigm.comp (by fun_prop : Measurable fun t : ℝ => 1 + t / (3 / 20))).mul
      (hsigm.comp (by fun_prop : Measurable fun t : ℝ => 1 - t / (3 / 20)))

  have hk : ∀ y, |rfpK P.Md y| ≤ 4 := by
    intro y
    unfold rfpK
    split_ifs
    · norm_num
    · obtain ⟨a0, a1⟩ := hsig (Real.log y / P.Md)
      rw [abs_le]; constructor <;> linarith
  have hkm : Measurable (rfpK P.Md) := by
    have e : rfpK P.Md = fun y => if y ≤ 1 then 4 else 4 * (1 - sigA (Real.log y / P.Md)) := by
      funext y; rfl
    rw [e]
    exact Measurable.ite measurableSet_Iic measurable_const
      (measurable_const.mul (measurable_const.sub (hsigm.comp (Real.measurable_log.div_const _))))

  have hII : ∀ a b : ℝ, IntervalIntegrable (fun v => sigA (50 * v)) volume a b := by
    intro a b
    have hc : IntervalIntegrable (fun _ : ℝ => (1:ℝ)) volume a b := intervalIntegrable_const
    refine hc.mono_fun' ?_ ?_
    · exact (hsigm.comp (measurable_const.mul measurable_id)).aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun v => ?_)
      show ‖sigA (50 * v)‖ ≤ 1
      rw [Real.norm_eq_abs, abs_of_nonneg (hsig _).1]
      exact (hsig _).2
  have hR0m : Measurable rfpR0 := by
    have e : rfpR0 = fun ξ => (∫ v in (0:ℝ)..ξ, sigA (50 * v)) * (1 - sigA (ξ - 10)) := by
      funext ξ; rfl
    rw [e]
    exact (intervalIntegral.continuous_primitive hII 0).measurable.mul
      (measurable_const.sub (hsigm.comp (measurable_id.sub_const _)))
  have hR0b : ∀ ξ : ℝ, ξ ≤ 13 → |rfpR0 ξ| ≤ 13 := by
    intro ξ hξ
    unfold rfpR0
    obtain ⟨s0, s1⟩ := hsig (ξ - 10)
    have h1 : |1 - sigA (ξ - 10)| ≤ 1 := by rw [abs_le]; constructor <;> linarith
    rcases le_or_gt ξ 0 with hn | hp
    · have hz : (∫ v in (0:ℝ)..ξ, sigA (50 * v)) = ∫ v in (0:ℝ)..ξ, (0:ℝ) := by
        apply intervalIntegral.integral_congr
        intro v hv
        rw [Set.uIcc_of_ge hn] at hv
        show sigA (50 * v) = 0
        unfold sigA
        rw [if_pos (by linarith [hv.2])]
      rw [hz, intervalIntegral.integral_zero, zero_mul, abs_zero]
      norm_num
    · have hI := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := ξ) (C := 1)
        (f := fun v => sigA (50 * v)) (fun v _ => by
          show ‖sigA (50 * v)‖ ≤ 1
          rw [Real.norm_eq_abs, abs_of_nonneg (hsig _).1]
          exact (hsig _).2)
      rw [Real.norm_eq_abs] at hI
      have hξ' : |ξ - 0| ≤ 13 := by rw [sub_zero, abs_of_pos hp]; exact hξ
      rw [abs_mul]
      calc |∫ v in (0:ℝ)..ξ, sigA (50 * v)| * |1 - sigA (ξ - 10)| ≤ 13 * 1 :=
            mul_le_mul (by linarith) h1 (abs_nonneg _) (by norm_num)
        _ = 13 := by norm_num

  have hEm : Measurable (fun y => Real.exp (rfpLam P y)) := hcm
  have hΛm : Measurable (rfpLam P) := by
    have e : rfpLam P = fun y => Real.log (Real.exp (rfpLam P y)) :=
      funext (fun y => (Real.log_exp _).symm)
    rw [e]
    exact Real.measurable_log.comp hEm
  have hE : ∀ y, Real.exp (rfpLam P y) ≤ P.Pst + |C| := by
    intro y
    rcases le_or_gt y 0 with hy | hy
    · have e : Real.exp (rfpLam P y) = P.Pst * Real.exp (y / 10) := (hcneg y hy).2
      rw [e]
      have : Real.exp (y / 10) ≤ 1 := Real.exp_le_one_iff.2 (by linarith)
      nlinarith [abs_nonneg C]
    · have e : Real.exp (rfpLam P y) ≤ C * Real.exp (-(κ * y)) := hCb y hy.le
      have h1 : Real.exp (-(κ * y)) ≤ 1 := Real.exp_le_one_iff.2 (by nlinarith)
      have h2 : C * Real.exp (-(κ * y)) ≤ |C| := by
        calc C * Real.exp (-(κ * y)) ≤ |C| * Real.exp (-(κ * y)) :=
              mul_le_mul_of_nonneg_right (le_abs_self C) (Real.exp_pos _).le
          _ ≤ |C| * 1 := mul_le_mul_of_nonneg_left h1 (abs_nonneg C)
          _ = |C| := mul_one _
      linarith
  have hM0 : 0 ≤ P.Pst + |C| := by linarith [abs_nonneg C]

  have hexpI : IntegrableOn Real.exp (Iic (rfpY4 P.Md P.lam)) := integrableOn_exp_Iic _
  have hgen : ∀ (a m : ℝ → ℝ) (K Mm : ℝ), Measurable a → Measurable m →
      (∀ y, y ≤ rfpY4 P.Md P.lam → Real.exp (a y) ≤ K * Real.exp y) →
      (∀ y, y ≤ rfpY4 P.Md P.lam → |m y| ≤ Mm) →
      IntegrableOn (fun y => Real.sqrt 2 * Real.exp (a y) * m y) (Iic (rfpY4 P.Md P.lam)) := by
    intro a m K Mm ha hm hK hMm
    refine Integrable.mono' (hexpI.const_mul (Real.sqrt 2 * K * Mm))
      ((measurable_const.mul (Real.measurable_exp.comp ha)).mul hm).aestronglyMeasurable ?_
    refine ae_restrict_of_forall_mem measurableSet_Iic (fun y hy => ?_)
    have hy' : y ≤ rfpY4 P.Md P.lam := hy
    show ‖Real.sqrt 2 * Real.exp (a y) * m y‖ ≤ Real.sqrt 2 * K * Mm * Real.exp y
    rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_of_nonneg (Real.sqrt_nonneg 2),
      abs_of_pos (Real.exp_pos _)]
    have h1 := hK y hy'
    have h2 := hMm y hy'
    have hs := Real.sqrt_nonneg 2
    have hm0 := abs_nonneg (m y)
    have he := Real.exp_pos (a y)
    calc Real.sqrt 2 * Real.exp (a y) * |m y| ≤ Real.sqrt 2 * (K * Real.exp y) * Mm :=
          mul_le_mul (mul_le_mul_of_nonneg_left h1 hs) h2 hm0 (mul_nonneg hs (le_trans he.le h1))
      _ = Real.sqrt 2 * K * Mm * Real.exp y := by ring
  have ha1m : Measurable (fun y => 3 / 2 * y + rfpLam P y) :=
    (measurable_const.mul measurable_id).add hΛm
  have ha2m : Measurable (fun y => 3 / 2 * y + 2 * rfpLam P y) :=
    (measurable_const.mul measurable_id).add (measurable_const.mul hΛm)
  have ha1b : ∀ y, y ≤ rfpY4 P.Md P.lam →
      Real.exp (3 / 2 * y + rfpLam P y) ≤ (Real.exp (rfpY4 P.Md P.lam / 2) * (P.Pst + |C|)) * Real.exp y := by
    intro y hy
    rw [show 3 / 2 * y + rfpLam P y = y / 2 + rfpLam P y + y by ring, Real.exp_add, Real.exp_add]
    exact mul_le_mul_of_nonneg_right
      (mul_le_mul (Real.exp_le_exp.2 (by linarith)) (hE y) (Real.exp_pos _).le (Real.exp_pos _).le)
      (Real.exp_pos y).le
  have ha2b : ∀ y, y ≤ rfpY4 P.Md P.lam →
      Real.exp (3 / 2 * y + 2 * rfpLam P y) ≤
        (Real.exp (rfpY4 P.Md P.lam / 2) * (P.Pst + |C|) * (P.Pst + |C|)) * Real.exp y := by
    intro y hy
    rw [show 3 / 2 * y + 2 * rfpLam P y = y / 2 + rfpLam P y + rfpLam P y + y by ring,
      Real.exp_add, Real.exp_add, Real.exp_add]
    refine mul_le_mul_of_nonneg_right ?_ (Real.exp_pos y).le
    exact mul_le_mul
      (mul_le_mul (Real.exp_le_exp.2 (by linarith)) (hE y) (Real.exp_pos _).le (Real.exp_pos _).le)
      (hE y) (Real.exp_pos _).le (mul_nonneg (Real.exp_pos _).le hM0)
  have hI0 : IntegrableOn (fun y => Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * rfpK P.Md y)
      (Iic (rfpY4 P.Md P.lam)) :=
    hgen (fun y => 3 / 2 * y + rfpLam P y) (rfpK P.Md) _ 4 ha1m hkm ha1b (fun y _ => hk y)
  have hI1 : IntegrableOn (fun y => Real.sqrt 2 * Real.exp (3 / 2 * y + 2 * rfpLam P y) *
      rfpR0 (P.lam * (y - rfpY3 P.Md P.lam))) (Iic (rfpY4 P.Md P.lam)) := by
    refine hgen (fun y => 3 / 2 * y + 2 * rfpLam P y) (fun y => rfpR0 (P.lam * (y - rfpY3 P.Md P.lam)))
      _ 13 ha2m (hR0m.comp (by fun_prop : Measurable fun y : ℝ => P.lam * (y - rfpY3 P.Md P.lam)))
      ha2b ?_
    intro y hy
    apply hR0b
    have h4 : y - rfpY3 P.Md P.lam ≤ 13 / P.lam := by
      unfold rfpY4 at hy
      linarith
    calc P.lam * (y - rfpY3 P.Md P.lam) ≤ P.lam * (13 / P.lam) := mul_le_mul_of_nonneg_left h4 hl0.le
      _ = 13 := by field_simp
  have hIB : ∀ s : ℝ, IntegrableOn (fun y => Real.sqrt 2 * Real.exp (3 / 2 * y + 2 * rfpLam P y) *
      rfpBmp (y - rfpY4 P.Md P.lam + s)) (Iic (rfpY4 P.Md P.lam)) := by
    intro s
    exact hgen (fun y => 3 / 2 * y + 2 * rfpLam P y) (fun y => rfpBmp (y - rfpY4 P.Md P.lam + s))
      _ 1 ha2m (hbm.comp (by fun_prop : Measurable fun y : ℝ => y - rfpY4 P.Md P.lam + s))
      ha2b (fun y _ => hb _)

  have hsub : (∫ x in Ioi (0:ℝ), rfpU P x η * (2 * x * rfpF P x η)) =
      ∫ y in Iic (rfpY4 P.Md P.lam), Real.exp y * (rfpU P (Real.exp y) η *
        (2 * Real.exp y * rfpF P (Real.exp y) η)) := by
    have hce := integral_comp_exp (fun x => rfpU P x η * (2 * x * rfpF P x η))
    simp only [smul_eq_mul] at hce
    rw [← hce]
    symm
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro y hy
    rw [mem_Iic, not_le] at hy
    have hU : rfpU P (Real.exp y) η = 0 := by
      unfold rfpU
      rw [Real.log_exp]
      exact cG5 y η hy.le
    rw [hU]
