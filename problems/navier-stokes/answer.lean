      _ = Real.sqrt (2 * X) * (∫ s in X..Xb, Kz s) / (X * (1 - 2 * h * η ^ 2)) := s2
      _ ≤ M * (∫ x in X..Xb, Kθ x) / (X * (1 - 2 * h * η ^ 2)) := s3
