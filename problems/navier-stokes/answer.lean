  have hps : -(4 * P * S * a * b) ≤ 2 * u * Q := by linarith

  have hd1 := mul_le_mul_of_nonneg_left hdev (mul_nonneg hE0 hQ0)
  have hd2 := mul_le_mul_of_nonneg_right hE1 (by positivity : (0:ℝ) ≤ 8 * M ^ 2 * δ * Q)

  have habs_tri : ∀ u v : ℝ, |u| ≤ |u - v| + |v| := fun u v => by
    have := abs_add_le (u - v) v; rwa [sub_add_cancel] at this
  have abs3' : ∀ A B C : ℝ, |A + B - C| ≤ |A| + |B| + |C| := fun A B C => by
    have h := abs3 A B (-C); rw [abs_neg, ← sub_eq_add_neg] at h; exact h
  have abs_sub' : ∀ A B : ℝ, |A - B| ≤ |A| + |B| := fun A B => by
    have h := abs_add_le A (-B); rw [abs_neg, ← sub_eq_add_neg] at h; exact h
  have hx0a := abs_nonneg (x 0)
  have hx1a := abs_nonneg (x 1)
  have hx2a := abs_nonneg (x 2)
  have hab_a : |a| ≤ 2 * M * X1 := by
    have e := abs3' (x 0) (σ * N2 * x 1) (σ * N1 * x 2)
    have f1 := hab (σ * N2) (x 1) _ hσN2
    have f2 := hab (σ * N1) (x 2) _ hσN1
