      ← Real.rpow_mul hq0.le, show -(aX + aY) * (k:ℝ) = -((k:ℝ) * (aX + aY)) by ring]

  obtain ⟨Af, hAf⟩ : ∃ f : ℝ³ × ℝ → ℂ, f = fun w : ℝ³ × ℝ =>
