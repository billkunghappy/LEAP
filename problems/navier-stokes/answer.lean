def AxMajor (h j0 r Λ0 A : ℝ) (χ ζ ℓ z : ℂ → ℂ) : Prop :=
  1 ≤ Λ0 ∧ 0 < A ∧ ∀ Λ : ℝ, Λ0 ≤ Λ → ∀ g : ℂ → ℂ, DifferentiableOn ℂ g (axRect r) →
    (∀ w ∈ axRect r, ‖g w‖ ≤ 1) → ∀ n : ℕ,
