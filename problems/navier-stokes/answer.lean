theorem inv_r_nb_v5 : ∀ B : BG, B.ok → ∀ k : ℕ, ∃ C : ℝ, ∀ (l : ℕ) (ξ : Cyl), 0 < ξ.1 → ξ.2.2.1 < 1 → 1/4 < qC B.h ξ / Qb l → B.Xa / 2 < XC B.h ξ → NB B.h (fun η : Cyl => Real.sqrt (Qb l) / η.1) k ξ ≤ C :=
