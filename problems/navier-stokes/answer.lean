theorem ax_ode_local_calc (h j0 σ ρ : ℝ) (Pc : ℂ → ℂ) (Pax : ℝ → ℝ) (r M Λ0 A : ℝ)
    (χc ζc ℓc zc Ξ : ℂ → ℂ) (hCD : AxCoefData h j0 σ ρ Pc Pax r M χc ζc ℓc zc Ξ)
    (hMaj : AxMajor h j0 r Λ0 A χc ζc ℓc zc) (Λ C X η : ℝ) (hΛ : Λ0 ≤ Λ)
    (hC : Real.exp (Λ * M) ≤ C) (hX0 : 0 < X) (hX1 : X < 9 / (2 * Λ))
    (hη1 : -1 - r / 8 < η) (hη2 : η < 1 + r / 8) :
    (∀ n : ℕ, ‖axPn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)‖ ≤ A * (1 / 10) ^ n ∧
      ‖deriv (axPn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ)‖ ≤ 8 / r * A * (1 / 10) ^ n ∧
      ‖axVn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)‖ ≤ A * (1 / 10) ^ n ∧
      ‖deriv (axVn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ)‖ ≤ 8 / r * A * (1 / 10) ^ n) ∧
    ((axFnDef h j0 Λ C χc ζc ℓc zc Ξ X η : ℝ) : ℂ) =
      axGain Λ C Ξ (η : ℂ) * axSer (fun n => axPn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)) ((Λ * X : ℝ) : ℂ) ∧
    ((deriv (fun Y => axFnDef h j0 Λ C χc ζc ℓc zc Ξ Y η) X : ℝ) : ℂ) =
      axGain Λ C Ξ (η : ℂ) * (Λ : ℂ) *
        axSer (fun n => ((n : ℂ) + 1) * axPn h j0 Λ C χc ζc ℓc zc Ξ (n + 1) (η : ℂ)) ((Λ * X : ℝ) : ℂ) ∧
    ((iteratedDeriv 2 (fun Y => axFnDef h j0 Λ C χc ζc ℓc zc Ξ Y η) X : ℝ) : ℂ) =
      axGain Λ C Ξ (η : ℂ) * (Λ : ℂ) ^ 2 *
        axSer (fun n => ((n : ℂ) + 1) * ((n : ℂ) + 2) * axPn h j0 Λ C χc ζc ℓc zc Ξ (n + 2) (η : ℂ))
          ((Λ * X : ℝ) : ℂ) ∧
    ((deriv (fun e => axFnDef h j0 Λ C χc ζc ℓc zc Ξ X e) η : ℝ) : ℂ) =
      axGain Λ C Ξ (η : ℂ) *
        ((Λ : ℂ) * ζc (η : ℂ) * axSer (fun n => axPn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)) ((Λ * X : ℝ) : ℂ) +
          axSer (fun n => deriv (axPn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ)) ((Λ * X : ℝ) : ℂ)) ∧
    ((axUnDef h j0 Λ C χc ζc ℓc zc Ξ X η : ℝ) : ℂ) =
      4 * (η : ℂ) + (j0 : ℂ) +
        axSer (fun n => axVn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)) ((Λ * X : ℝ) : ℂ) / (Λ : ℂ) ∧
    ((deriv (fun Y => axUnDef h j0 Λ C χc ζc ℓc zc Ξ Y η) X : ℝ) : ℂ) =
      axSer (fun n => ((n : ℂ) + 1) * axVn h j0 Λ C χc ζc ℓc zc Ξ (n + 1) (η : ℂ)) ((Λ * X : ℝ) : ℂ) ∧
    ((iteratedDeriv 2 (fun Y => axUnDef h j0 Λ C χc ζc ℓc zc Ξ Y η) X : ℝ) : ℂ) =
      (Λ : ℂ) *
        axSer (fun n => ((n : ℂ) + 1) * ((n : ℂ) + 2) * axVn h j0 Λ C χc ζc ℓc zc Ξ (n + 2) (η : ℂ))
          ((Λ * X : ℝ) : ℂ) ∧
    ((deriv (fun e => axUnDef h j0 Λ C χc ζc ℓc zc Ξ X e) η : ℝ) : ℂ) =
      4 + axSer (fun n => deriv (axVn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ)) ((Λ * X : ℝ) : ℂ) / (Λ : ℂ) :=
by
  obtain ⟨hr0, -, -, -, -, -, -, -, -, -, hbd, hreal⟩ := hCD
  obtain ⟨hΛ01, hA0, hmaj⟩ := hMaj
  have hΛpos : 0 < Λ := by linarith
  have hΛne : (Λ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hΛpos.ne'

  have hCpos : 0 < C := lt_of_lt_of_le (Real.exp_pos _) hC
  have hgdef : axGain Λ C Ξ = fun x => Complex.exp ((Λ : ℂ) * Ξ x) / (C : ℂ) := by
    funext x; unfold axGain; rfl
  have hgder : ∀ w ∈ axRect r,
      HasDerivAt (axGain Λ C Ξ) (axGain Λ C Ξ w * ((Λ : ℂ) * ζc w)) w := by
    intro w hw
    have h1 := ((((hbd w hw).2.2.2.2.2.2.1).const_mul (Λ : ℂ)).cexp).div_const (C : ℂ)
    rw [hgdef]
    convert h1 using 1
    ring
  have hgnorm : ∀ w ∈ axRect r, ‖axGain Λ C Ξ w‖ ≤ 1 := by
    intro w hw
    rw [hgdef]
    simp only
    rw [norm_div, Complex.norm_exp, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hCpos,
      Complex.re_ofReal_mul, div_le_one hCpos]
    have h1 : (Ξ w).re ≤ M := le_trans (Complex.re_le_norm _) (hbd w hw).2.2.2.2.1
    have h2 : Λ * (Ξ w).re ≤ Λ * M := mul_le_mul_of_nonneg_left h1 hΛpos.le
    exact le_trans (Real.exp_le_exp.mpr h2) hC
  have gdiff : DifferentiableOn ℂ (axGain Λ C Ξ) (axRect r) :=
    fun w hw => (hgder w hw).differentiableAt.differentiableWithinAt
  have gbd : ∀ w ∈ axRect r, ‖axGain Λ C Ξ w‖ ≤ 1 ∧
      HasDerivAt (axGain Λ C Ξ) (axGain Λ C Ξ w * ((Λ : ℂ) * ζc w)) w :=
    fun w hw => ⟨hgnorm w hw, hgder w hw⟩
  have greal : ∀ e : ℝ, (Ξ (e : ℂ)).im = 0 → (axGain Λ C Ξ (e : ℂ)).im = 0 := by
    intro e he
    have hr : Ξ (e : ℂ) = (((Ξ (e : ℂ)).re : ℝ) : ℂ) := Complex.ext (by simp) (by simp [he])
    rw [hgdef]
    simp only
    rw [hr, ← Complex.ofReal_mul, ← Complex.ofReal_exp, ← Complex.ofReal_div, Complex.ofReal_im]
  have hM := hmaj Λ hΛ (axGain Λ C Ξ) gdiff (fun w hw => (gbd w hw).1)



  have hRopen : ∀ s : ℝ, IsOpen (axRect s) := by
    intro s
    unfold axRect
    exact (isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).inter
      ((isOpen_lt continuous_const Complex.continuous_re).inter
        (isOpen_lt Complex.continuous_re continuous_const))
  have hre : ∀ z : ℂ, z.im = 0 → ((z.re : ℝ) : ℂ) = z := fun z hz =>
    Complex.ext (by simp) (by simp [hz])

  have G1 : ∀ (f : ℝ → ℝ) (K : ℂ → ℂ) (K' : ℂ) (x0 : ℝ), HasDerivAt K K' (x0 : ℂ) →
      (∀ᶠ x in nhds x0, ((f x : ℝ) : ℂ) = K (x : ℂ)) → ((deriv f x0 : ℝ) : ℂ) = K' := by
    intro f K K' x0 hK hE
    have ha : HasDerivAt (fun x : ℝ => K (x : ℂ)) K' x0 := hK.comp_ofReal
    have ha' : HasDerivAt (fun x : ℝ => ((f x : ℝ) : ℂ)) K' x0 := ha.congr_of_eventuallyEq hE
    have hb : HasDerivAt (fun x : ℝ => (K (x : ℂ)).re) K'.re x0 := hK.real_of_complex
    have hE2 : ∀ᶠ x in nhds x0, f x = (K (x : ℂ)).re :=
