    have e2 : ((1/2 : ℂ) • iteratedFDeriv ℝ k (E γ N) ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
        (1/2 : ℂ) • (iteratedFDeriv ℝ k (E γ N) ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
      ext m; simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2, norm_smul]
    have h12 : ‖(1/2 : ℂ)‖ ≤ 1 := by rw [norm_div, norm_one]; norm_num
    exact mul_le_of_le_one_left (norm_nonneg _) h12
