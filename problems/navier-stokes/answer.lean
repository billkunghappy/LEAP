  obtain ⟨O1, O2⟩ := h8 l0 (by omega) S bw ca H hbw hbwH hH9 hca hSt hI hP hMn

  have hS1 : StOrd5 B G l0 (tempState5 B G l0 S) bw ca ca H := by
