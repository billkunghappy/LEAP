      (by
        rintro ⟨X, η⟩ ⟨-, ⟨hX, -⟩⟩
        exact hFin X η (mem_Iio.mp hX))
      (by
        rintro ⟨X, η⟩ ⟨-, ⟨hX, hη⟩⟩
        exact (hagree X η (mem_Ioi.mp hX) hη.1 hη.2).1)
  have hUSε : ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1) :=
    two_patch (↿U) (↿Ui) (↿Uo) _ _ _ _ _ hB1o hB2o (hcover (-ε)) hUiS hUoS inter_subset_left
      (by
        rintro ⟨X, η⟩ ⟨-, ⟨hX, hη⟩⟩
        exact ⟨mem_Ioi.mpr (lt_trans hXh1pos (mem_Ioi.mp hX)), hη⟩)
      (by
        rintro ⟨X, η⟩ ⟨-, ⟨hX, -⟩⟩
        exact hUin X η (mem_Iio.mp hX))
      (by
        rintro ⟨X, η⟩ ⟨-, ⟨hX, hη⟩⟩
        exact (hagree X η (mem_Ioi.mp hX) hη.1 hη.2).2)
  have hsubε : Ioi (0 : ℝ) ×ˢ Ioo (-1 : ℝ) 1 ⊆ Ioi (-ε) ×ˢ Ioo (-1 : ℝ) 1 :=
    prod_mono (Ioi_subset_Ioi (by linarith)) subset_rfl

  have hThS : ContDiffOn ℝ ∞ (↿(leadStressTh h F U)) (Ioi 0 ×ˢ Ioo (-1 : ℝ) 1) :=
    two_patch _ (↿(leadStressTh h F U)) (↿(leadStressTh h Fo Uo)) _ _ _ _ _ hB1o hB2o (hcover 0)
