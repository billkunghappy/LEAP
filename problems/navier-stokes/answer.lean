      _ = _ := by rw [hxx]; ring
  have hb3 : ∀ (m : ℕ) (x η : ℝ), a ≤ x → -1 < η → η < 1 →
      |iteratedDeriv m (fun η' => F x η' ^ 2 * (2 * q e x η' + q e x η' ^ 2)) η| ≤
