    have hSabs : |a ^ 2 + b ^ 2| ≤ 2 * D ^ 2 := by
      rw [abs_of_nonneg (by positivity)]; linarith
    obtain ⟨W, hW⟩ : ∃ W : ℝ, W = Real.sqrt ((a ^ 2 + b ^ 2) * a⁻¹ / 2 - 1) := ⟨_, rfl⟩
    have hWsq : W ^ 2 = (a ^ 2 + b ^ 2) * a⁻¹ / 2 - 1 := by
      rw [hW]; exact Real.sq_sqrt (by linarith)
    have hWl : κ / 2 ≤ W := by
