theorem tn_inv2d_v5 : ∀ (φ : ℝ × ℝ → ℝ) (M : ℝ), Continuous φ →
    (∀ (n m : ℤ) (Y : ℝ × ℝ), φ (Y + ((n:ℝ), (m:ℝ))) = φ Y) →
    (∀ k : ℤ × ℤ, ‖∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (φ Y : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ)))‖ ≤
        M / ((1 + (k.1 : ℝ) ^ 2) * (1 + (k.2 : ℝ) ^ 2))) →
    ∀ Y : ℝ × ℝ, HasSum (fun k : ℤ × ℤ => (∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (φ Z : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Z.1 : ℂ) + (k.2 : ℂ) * (Z.2 : ℂ)))) *
        Complex.exp ((2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ)))) (φ Y : ℂ) :=
by
  intro φ M hφc hper hbd Y



  have inv1d : ∀ (ψ : ℝ → ℂ), Continuous ψ → (∀ x : ℝ, ψ (x + 1) = ψ x) →
      Summable (fun n : ℤ => ‖∫ y in Set.Icc (0:ℝ) 1,
        ψ y * Complex.exp (-(2 * Real.pi * Complex.I) * ((n : ℂ) * (y : ℂ)))‖) →
      ∀ x : ℝ, HasSum (fun n : ℤ => (∫ y in Set.Icc (0:ℝ) 1,
          ψ y * Complex.exp (-(2 * Real.pi * Complex.I) * ((n : ℂ) * (y : ℂ)))) *
        Complex.exp ((2 * Real.pi * Complex.I) * ((n : ℂ) * (x : ℂ)))) (ψ x) := by
    intro ψ hc hp hs x
    have hF : Continuous (AddCircle.liftIco 1 0 ψ) :=
      AddCircle.liftIco_continuous (hp 0).symm hc.continuousOn
    obtain ⟨Fc, hFc⟩ : ∃ Fc : C(AddCircle (1:ℝ), ℂ), ⇑Fc = AddCircle.liftIco 1 0 ψ :=
      ⟨⟨_, hF⟩, rfl⟩
    have hcoef : ∀ n : ℤ, fourierCoeff (⇑Fc) n = ∫ y in Set.Icc (0:ℝ) 1,
        ψ y * Complex.exp (-(2 * Real.pi * Complex.I) * ((n : ℂ) * (y : ℂ))) := by
      intro n
      rw [hFc, fourierCoeff_liftIco_eq, fourierCoeffOn_eq_integral,
        intervalIntegral.integral_of_le (by norm_num : (0:ℝ) ≤ 0 + 1)]
      simp only [zero_add, sub_zero, div_one, one_smul]
      rw [← MeasureTheory.integral_Icc_eq_integral_Ioc]
      congr 1
      funext y
      rw [fourier_coe_apply, smul_eq_mul, mul_comm]
      congr 2
      push_cast
      ring
    have hsum : Summable (fourierCoeff ⇑Fc) := by
      apply Summable.of_norm
      simpa only [hcoef] using hs
    have hval : Fc (x : AddCircle (1:ℝ)) = ψ x := by
      have e : ((x : ℝ) : AddCircle (1:ℝ)) = ((Int.fract x : ℝ) : AddCircle (1:ℝ)) := by
        rw [QuotientAddGroup.eq, AddSubgroup.mem_zmultiples_iff]
        refine ⟨-⌊x⌋, ?_⟩
        rw [zsmul_eq_mul, mul_one, ← Int.self_sub_floor]
        push_cast
        ring
      have hmem : Int.fract x ∈ Set.Ico (0:ℝ) (0 + 1) :=
        ⟨Int.fract_nonneg x, by rw [zero_add]; exact Int.fract_lt_one x⟩
      rw [e, hFc, AddCircle.liftIco_coe_apply hmem]
      have hper1 : Function.Periodic ψ 1 := fun x => hp x
      have := hper1.sub_int_mul_eq (x := x) ⌊x⌋
      rw [mul_one] at this
      rw [← Int.self_sub_floor, this]
    have h := has_pointwise_sum_fourier_series_of_summable hsum (x : AddCircle (1:ℝ))
    rw [hval] at h
    convert h using 1
    funext n
    rw [hcoef, fourier_coe_apply, smul_eq_mul]
    congr 2
    push_cast
    ring



  have sqs : Summable (fun n : ℤ => 1 / (1 + (n : ℝ) ^ 2)) := by
    have h := ((Real.summable_one_div_int_add_rpow (1/2) 2).mpr one_lt_two).mul_left 2
    refine Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_) h
    have hne : (n:ℝ) + 1/2 ≠ 0 := by
      intro h0
      have h1 : ((2 * n + 1 : ℤ) : ℝ) = 0 := by push_cast; linarith
      have h2 : (2 * n + 1 : ℤ) = 0 := by exact_mod_cast h1
      omega
    have hpos : 0 < ((n:ℝ) + 1/2) ^ 2 := lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 hne))
    show 1 / (1 + (n:ℝ) ^ 2) ≤ 2 * (1 / |(n:ℝ) + 1/2| ^ (2:ℝ))
    rw [Real.rpow_two, sq_abs, mul_one_div, div_le_div_iff₀ (by positivity) hpos]
    nlinarith [sq_nonneg ((n:ℝ) - 1/2)]



  have fub : ∀ k : ℤ × ℤ,
      ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (φ Y : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))) =
        ∫ t in Set.Icc (0:ℝ) 1, (∫ s in Set.Icc (0:ℝ) 1, (φ (s, t) : ℂ) *
            Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (s : ℂ)))) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((k.2 : ℂ) * (t : ℂ))) := by
    intro k
    have hFc : Continuous (fun Y : ℝ × ℝ => (φ Y : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ)))) := by
      fun_prop
    have hmeas : (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ)).restrict
        (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) =
        ((MeasureTheory.volume : MeasureTheory.Measure ℝ).restrict (Set.Icc 0 1)).prod
          ((MeasureTheory.volume : MeasureTheory.Measure ℝ).restrict (Set.Icc 0 1)) := by
      rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_restrict]
    have hint : MeasureTheory.Integrable (fun Y : ℝ × ℝ => (φ Y : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ))))
        (((MeasureTheory.volume : MeasureTheory.Measure ℝ).restrict (Set.Icc 0 1)).prod
          ((MeasureTheory.volume : MeasureTheory.Measure ℝ).restrict (Set.Icc 0 1))) := by
      rw [← hmeas]
      exact (hFc.continuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)).integrable
    rw [hmeas, MeasureTheory.integral_prod_symm _ hint]
    congr 1
    funext t
    rw [← MeasureTheory.integral_mul_const]
    congr 1
    funext s
    simp only []
    rw [show (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (s : ℂ) + (k.2 : ℂ) * (t : ℂ))) =
        -(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (s : ℂ)) +
          -(2 * Real.pi * Complex.I) * ((k.2 : ℂ) * (t : ℂ)) by ring, Complex.exp_add]
    ring



  obtain ⟨c, hc⟩ : ∃ c : ℤ × ℤ → ℂ, ∀ k : ℤ × ℤ, c k =
      ∫ Z in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (φ Z : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Z.1 : ℂ) + (k.2 : ℂ) * (Z.2 : ℂ))) :=
    ⟨_, fun _ => rfl⟩
  suffices key : HasSum (fun k : ℤ × ℤ => c k *
      Complex.exp ((2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ)))) (φ Y : ℂ) by
    simp only [hc] at key
    exact key
  have hbd' : ∀ k : ℤ × ℤ, ‖c k‖ ≤ M / ((1 + (k.1 : ℝ) ^ 2) * (1 + (k.2 : ℝ) ^ 2)) := fun k => by
    rw [hc]; exact hbd k
  obtain ⟨u, hu⟩ : ∃ u : ℤ → ℝ, ∀ n : ℤ, u n = 1 / (1 + (n : ℝ) ^ 2) := ⟨_, fun _ => rfl⟩
  have hS : Summable u := by
    rw [show u = fun n : ℤ => 1 / (1 + (n : ℝ) ^ 2) from funext hu]
    exact sqs
  have hu0 : ∀ n, 0 < u n := fun n => by rw [hu]; positivity
  have hu1 : ∀ n, u n ≤ 1 := fun n => by
    rw [hu, div_le_one (by positivity)]
    nlinarith [sq_nonneg (n : ℝ)]
  have hM0 : 0 ≤ M := by
    have h := hbd' (0, 0)
    norm_num at h
    exact le_trans (norm_nonneg _) h
  have hcb : ∀ k : ℤ × ℤ, ‖c k‖ ≤ M * (u k.1 * u k.2) := fun k => by
    rw [hu, hu, one_div_mul_one_div, mul_one_div]
    exact hbd' k
  have hE : ∀ z : ℂ, z.re = 0 → ‖Complex.exp z‖ = 1 := fun z hz => by
    rw [Complex.norm_exp, hz, Real.exp_zero]

  obtain ⟨a, ha⟩ : ∃ a : ℤ → ℝ → ℂ, ∀ (k1 : ℤ) (t : ℝ), a k1 t =
      ∫ s in Set.Icc (0:ℝ) 1, (φ (s, t) : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((k1 : ℂ) * (s : ℂ))) := ⟨_, fun _ _ => rfl⟩
  have hac : ∀ k1 : ℤ, Continuous (a k1) := by
    intro k1
    rw [show a k1 = fun t => ∫ s in Set.Icc (0:ℝ) 1, (φ (s, t) : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((k1 : ℂ) * (s : ℂ))) from funext (ha k1)]
    refine continuous_parametric_integral_of_continuous
      (f := fun t s => (φ (s, t) : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((k1 : ℂ) * (s : ℂ)))) ?_ isCompact_Icc
    show Continuous (fun p : ℝ × ℝ => (φ (p.2, p.1) : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((k1 : ℂ) * (p.2 : ℂ))))
    fun_prop
  have hap : ∀ (k1 : ℤ) (t : ℝ), a k1 (t + 1) = a k1 t := by
    intro k1 t
    have e : ∀ s : ℝ, φ (s, t + 1) = φ (s, t) := fun s => by
      have := hper 0 1 (s, t)
      simpa using this
    simp only [ha, e]
  have hacoef : ∀ k1 n : ℤ, (∫ y in Set.Icc (0:ℝ) 1, a k1 y *
      Complex.exp (-(2 * Real.pi * Complex.I) * ((n : ℂ) * (y : ℂ)))) = c (k1, n) := by
    intro k1 n
    rw [hc, fub (k1, n)]
    simp only [ha]

  have H1 : ∀ k1 : ℤ, HasSum (fun k2 : ℤ => c (k1, k2) *
      Complex.exp ((2 * Real.pi * Complex.I) * ((k2 : ℂ) * (Y.2 : ℂ)))) (a k1 Y.2) := by
    intro k1
    have hsm : Summable (fun n : ℤ => ‖∫ y in Set.Icc (0:ℝ) 1, a k1 y *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((n : ℂ) * (y : ℂ)))‖) := by
      simp only [hacoef]
      refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun n => ?_) (hS.mul_left M)
      calc ‖c (k1, n)‖ ≤ M * (u k1 * u n) := hcb (k1, n)
        _ ≤ M * u n := by
          apply mul_le_mul_of_nonneg_left _ hM0
          exact mul_le_of_le_one_left (hu0 n).le (hu1 k1)
    have h := inv1d (a k1) (hac k1) (hap k1) hsm Y.2
    simp only [hacoef] at h
    exact h

  have hab : ∀ k1 : ℤ, ‖a k1 Y.2‖ ≤ M * (∑' n, u n) * u k1 := by
    intro k1
    rw [← (H1 k1).tsum_eq]
    have hb : ∀ k2 : ℤ, ‖c (k1, k2) *
        Complex.exp ((2 * Real.pi * Complex.I) * ((k2 : ℂ) * (Y.2 : ℂ)))‖ ≤ (M * u k1) * u k2 := by
      intro k2
      rw [norm_mul, hE _ (by simp), mul_one, mul_assoc]
      exact hcb (k1, k2)
    have hsn : Summable (fun k2 : ℤ => ‖c (k1, k2) *
        Complex.exp ((2 * Real.pi * Complex.I) * ((k2 : ℂ) * (Y.2 : ℂ)))‖) :=
      Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hb (hS.mul_left _)
    refine le_trans (norm_tsum_le_tsum_norm hsn) ?_
    refine le_trans (Summable.tsum_le_tsum hb hsn (hS.mul_left _)) ?_
    rw [tsum_mul_left]
    exact le_of_eq (by ring)

  have H2 : HasSum (fun k1 : ℤ => a k1 Y.2 *
      Complex.exp ((2 * Real.pi * Complex.I) * ((k1 : ℂ) * (Y.1 : ℂ)))) (φ Y : ℂ) := by
    have hc2 : Continuous (fun s : ℝ => (φ (s, Y.2) : ℂ)) := by fun_prop
    have hp2 : ∀ s : ℝ, (φ (s + 1, Y.2) : ℂ) = (φ (s, Y.2) : ℂ) := by
      intro s
      have := hper 1 0 (s, Y.2)
      simp at this
      rw [this]
    have e : ∀ n : ℤ, (∫ y in Set.Icc (0:ℝ) 1, (φ (y, Y.2) : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((n : ℂ) * (y : ℂ)))) = a n Y.2 :=
      fun n => (ha n Y.2).symm
    have hsm : Summable (fun n : ℤ => ‖∫ y in Set.Icc (0:ℝ) 1, (φ (y, Y.2) : ℂ) *
        Complex.exp (-(2 * Real.pi * Complex.I) * ((n : ℂ) * (y : ℂ)))‖) := by
      simp only [e]
      exact Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hab (hS.mul_left _)
    have h := inv1d (fun s : ℝ => (φ (s, Y.2) : ℂ)) hc2 hp2 hsm Y.1
    simp only [e] at h
    exact h

  have hmaj : Summable (fun k : ℤ × ℤ => M * (u k.1 * u k.2)) :=
    (Summable.mul_of_nonneg hS hS (fun n => (hu0 n).le) (fun n => (hu0 n).le)).mul_left M
  have hfs : Summable (fun k : ℤ × ℤ => c k *
      Complex.exp ((2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ)))) :=
    Summable.of_norm_bounded hmaj (fun k => by
      rw [norm_mul, hE _ (by simp), mul_one]
      exact hcb k)
  have hfib : ∀ k1 : ℤ, HasSum (fun k2 : ℤ => c (k1, k2) *
      Complex.exp ((2 * Real.pi * Complex.I) * ((k1 : ℂ) * (Y.1 : ℂ) + (k2 : ℂ) * (Y.2 : ℂ))))
      (a k1 Y.2 * Complex.exp ((2 * Real.pi * Complex.I) * ((k1 : ℂ) * (Y.1 : ℂ)))) := by
    intro k1
    have h := (H1 k1).mul_right (Complex.exp ((2 * Real.pi * Complex.I) * ((k1 : ℂ) * (Y.1 : ℂ))))
    convert h using 1
    funext k2
    rw [mul_add, Complex.exp_add]
    ring
  have hF := hfs.hasSum
  have h4 := (hF.prod_fiberwise hfib).unique H2
  rw [h4] at hF
  exact hF

theorem fourier2_inversion_v5 : ∀ (g : ℝ × ℝ → ℝ) (K : ℝ), Continuous g → (∀ (Z : ℝ × ℝ) (i j : ℤ), g (Z + ((i:ℝ), (j:ℝ))) = g Z) → (∀ m : ℤ × ℤ, ‖∫ W in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, (g W : ℂ) * Complex.exp (-(2 * ↑Real.pi * Complex.I * ((m.1 : ℂ) * (W.1 : ℂ) + (m.2 : ℂ) * (W.2 : ℂ))))‖ ≤ K / ((1 + |(m.1:ℝ)|) ^ 2 * (1 + |(m.2:ℝ)|) ^ 2)) → ∀ Z : ℝ × ℝ, HasSum (fun m : ℤ × ℤ => (∫ W in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, (g W : ℂ) * Complex.exp (-(2 * ↑Real.pi * Complex.I * ((m.1 : ℂ) * (W.1 : ℂ) + (m.2 : ℂ) * (W.2 : ℂ))))) * Complex.exp (2 * ↑Real.pi * Complex.I * ((m.1 : ℂ) * (Z.1 : ℂ) + (m.2 : ℂ) * (Z.2 : ℂ)))) (g Z : ℂ) :=
by
  intro g K hg hper hbound Z
  have hK0 : 0 ≤ K := by
    have h0 := hbound (0, 0)
    simp only [Int.cast_zero, abs_zero, add_zero, one_pow, mul_one, div_one] at h0
    exact le_trans (norm_nonneg _) h0
  have hbound' : ∀ k : ℤ × ℤ, ‖∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (g Y : ℂ) *
          Complex.exp (-(2 * Real.pi * Complex.I) * ((k.1 : ℂ) * (Y.1 : ℂ) + (k.2 : ℂ) * (Y.2 : ℂ)))‖ ≤
        K / ((1 + (k.1 : ℝ) ^ 2) * (1 + (k.2 : ℝ) ^ 2)) := by
    intro k
    have hk := hbound k
    simp only [neg_mul]
    refine le_trans hk ?_
    apply div_le_div_of_nonneg_left hK0 (by positivity)
    have ha : 1 + (k.1 : ℝ) ^ 2 ≤ (1 + |(k.1 : ℝ)|) ^ 2 := by
      nlinarith [sq_abs (k.1 : ℝ), abs_nonneg (k.1 : ℝ)]
    have hb : 1 + (k.2 : ℝ) ^ 2 ≤ (1 + |(k.2 : ℝ)|) ^ 2 := by
      nlinarith [sq_abs (k.2 : ℝ), abs_nonneg (k.2 : ℝ)]
    exact mul_le_mul ha hb (by positivity) (by positivity)
  have h := tn_inv2d_v5 g K hg (fun n m Y => hper Y n m) hbound' Z
  simpa only [neg_mul] using h

theorem linear_phase_decay_v5 : ∀ (p : ℕ) (α β lam B : ℝ) (A : ℝ → ℂ), α ≤ β → lam ≠ 0 → ContDiff ℝ ∞ A → (∀ x : ℝ, (x ≤ α ∨ β ≤ x) → A x = 0) → (∀ x : ℝ, ‖iteratedDeriv p A x‖ ≤ B) → ‖∫ x in α..β, A x * Complex.exp (((lam * x : ℝ) : ℂ) * Complex.I)‖ ≤ (β - α) * B / |lam| ^ p :=
by
  intro p
  induction p with
  | zero =>
    intro α β lam B A hαβ hlam hA hsupp hbd
    have hb : ∀ x ∈ Set.uIoc α β,
        ‖A x * Complex.exp (((lam * x : ℝ) : ℂ) * Complex.I)‖ ≤ B := by
      intro x _
      rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
      have := hbd x
      rwa [iteratedDeriv_zero] at this
    have h1 := intervalIntegral.norm_integral_le_of_norm_le_const hb
    rw [abs_of_nonneg (sub_nonneg.mpr hαβ)] at h1
    rw [pow_zero, div_one, mul_comm]
    exact h1
  | succ p ih =>
    intro α β lam B A hαβ hlam hA hsupp hbd
    obtain ⟨hAd, hA'⟩ := contDiff_infty_iff_deriv.mp hA
    have hcont : Continuous (deriv A) := hA'.continuous
    have hZ : IsClosed {y : ℝ | deriv A y = 0} := isClosed_eq hcont continuous_const
    have hloc : ∀ y : ℝ, (y < α ∨ β < y) → deriv A y = 0 := by
      intro y hy
      have hmem : {z : ℝ | A z = 0} ∈ nhds y := by
        rcases hy with hy | hy
        · exact Filter.mem_of_superset (Iio_mem_nhds hy)
            (fun z hz => hsupp z (Or.inl (le_of_lt hz)))
        · exact Filter.mem_of_superset (Ioi_mem_nhds hy)
            (fun z hz => hsupp z (Or.inr (le_of_lt hz)))
      have hev : A =ᶠ[nhds y] fun _ => (0:ℂ) := Filter.eventuallyEq_of_mem hmem (fun z hz => hz)
      rw [hev.deriv_eq, deriv_const]
    have hsupp' : ∀ x : ℝ, (x ≤ α ∨ β ≤ x) → deriv A x = 0 := by
      have h1 : Set.Iio α ⊆ {y : ℝ | deriv A y = 0} := fun y hy => hloc y (Or.inl hy)
      have h2 : Set.Ioi β ⊆ {y : ℝ | deriv A y = 0} := fun y hy => hloc y (Or.inr hy)
      rw [← hZ.closure_subset_iff, closure_Iio] at h1
      rw [← hZ.closure_subset_iff, closure_Ioi] at h2
      intro x hx
      rcases hx with hx | hx
      · exact h1 hx
      · exact h2 hx
    have hbd' : ∀ x : ℝ, ‖iteratedDeriv p (deriv A) x‖ ≤ B := by
      intro x
      rw [← iteratedDeriv_succ']
      exact hbd x
    have hih := ih α β lam B (deriv A) hαβ hlam hA' hsupp' hbd'
    have hne : (lam : ℂ) * Complex.I ≠ 0 :=
      mul_ne_zero (Complex.ofReal_ne_zero.mpr hlam) Complex.I_ne_zero
    have hc1 : (lam : ℂ) * Complex.I * ((lam : ℂ) * Complex.I)⁻¹ = 1 := mul_inv_cancel₀ hne
    have hv : ∀ x : ℝ, HasDerivAt
        (fun y : ℝ => Complex.exp (((lam * y : ℝ) : ℂ) * Complex.I) * ((lam : ℂ) * Complex.I)⁻¹)
        (Complex.exp (((lam * x : ℝ) : ℂ) * Complex.I)) x := by
      intro x
      have h1 : HasDerivAt (fun y : ℝ => lam * y) lam x := by
        simpa using (hasDerivAt_id x).const_mul lam
      have h2 := ((h1.ofReal_comp).mul_const Complex.I).cexp.mul_const ((lam : ℂ) * Complex.I)⁻¹
      convert h2 using 1
      rw [mul_assoc, hc1, mul_one]
    have hu : ∀ x ∈ Set.uIcc α β, HasDerivAt A (deriv A x) x := fun x _ => (hAd x).hasDerivAt
    have hEc : Continuous (fun x : ℝ => Complex.exp (((lam * x : ℝ) : ℂ) * Complex.I)) := by
      fun_prop
    have hibp := intervalIntegral.integral_mul_deriv_eq_deriv_mul (u := A) (u' := deriv A)
      (v := fun y : ℝ => Complex.exp (((lam * y : ℝ) : ℂ) * Complex.I) * ((lam : ℂ) * Complex.I)⁻¹)
      (v' := fun y : ℝ => Complex.exp (((lam * y : ℝ) : ℂ) * Complex.I))
      hu (fun x _ => hv x) (hcont.intervalIntegrable α β) (hEc.intervalIntegrable α β)
    beta_reduce at hibp
    rw [hsupp α (Or.inl le_rfl), hsupp β (Or.inr le_rfl), zero_mul, zero_mul, sub_zero,
      zero_sub] at hibp
    have hre : ∫ x in α..β, deriv A x * (Complex.exp (((lam * x : ℝ) : ℂ) * Complex.I) *
        ((lam : ℂ) * Complex.I)⁻¹) = (∫ x in α..β, deriv A x *
        Complex.exp (((lam * x : ℝ) : ℂ) * Complex.I)) * ((lam : ℂ) * Complex.I)⁻¹ := by
      rw [← intervalIntegral.integral_mul_const]
      exact intervalIntegral.integral_congr (fun x _ => by ring)
    rw [hibp, hre, norm_neg, norm_mul]
    have hcn : ‖((lam : ℂ) * Complex.I)⁻¹‖ = |lam|⁻¹ := by
      rw [norm_inv, norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I, mul_one]
    rw [hcn]
    have hl : 0 < |lam| := abs_pos.mpr hlam
    calc ‖∫ x in α..β, deriv A x * Complex.exp (((lam * x : ℝ) : ℂ) * Complex.I)‖ * |lam|⁻¹
        ≤ (β - α) * B / |lam| ^ p * |lam|⁻¹ :=
          mul_le_mul_of_nonneg_right hih (inv_nonneg.mpr hl.le)
      _ = (β - α) * B / |lam| ^ (p + 1) := by
          rw [pow_succ, div_eq_mul_inv, div_eq_mul_inv, mul_inv]
          ring

theorem power_subst_v5 : ∀ (d s1 s2 : ℝ), 1 ≤ d → 0 < s1 → s1 < s2 → ∀ p : ℕ, ∃ K : ℝ, 0 ≤ K ∧ ∀ (B : ℝ) (a : ℝ → ℂ), ContDiff ℝ ∞ a → (∀ s : ℝ, (s ≤ s1 ∨ s2 ≤ s) → a s = 0) → (∀ j : ℕ, j ≤ p → ∀ s : ℝ, ‖iteratedDeriv j a s‖ ≤ B) → ∃ A : ℝ → ℂ, ContDiff ℝ ∞ A ∧ (∀ x : ℝ, (x ≤ s1 ^ d ∨ s2 ^ d ≤ x) → A x = 0) ∧ (∀ x : ℝ, ‖iteratedDeriv p A x‖ ≤ K * B) ∧ ∀ lam : ℝ, ∫ s in s1..s2, a s * Complex.exp (((lam * s ^ d : ℝ) : ℂ) * Complex.I) = ∫ x in (s1 ^ d)..(s2 ^ d), A x * Complex.exp (((lam * x : ℝ) : ℂ) * Complex.I) :=
by
  intro d s1 s2 hd1 hs1 hs12 p

  have c3b : ∀ (a : ℝ → ℂ) (ψ : ℝ → ℝ) (g : ℝ → ℂ) (U : Set ℝ) (x : ℝ) (B D E : ℝ),
      IsOpen U → x ∈ U → ContDiff ℝ ∞ a → ContDiffOn ℝ ∞ ψ U → ContDiffOn ℝ ∞ g U → 1 ≤ D →
      (∀ i : ℕ, i ≤ p → ‖iteratedDeriv i a (ψ x)‖ ≤ B) →
      (∀ i : ℕ, 1 ≤ i → i ≤ p → ‖iteratedFDeriv ℝ i ψ x‖ ≤ D ^ i) →
      (∀ i : ℕ, i ≤ p → ‖iteratedFDeriv ℝ i g x‖ ≤ E) →
      ‖iteratedDeriv p (fun y => a (ψ y) * g y) x‖ ≤ 2 ^ p * (p.factorial : ℝ) * D ^ p * E * B := by
    intro a ψ g U x B D E hU hx ha hψ hg hD haB hψD hgE
    have hB : 0 ≤ B := le_trans (norm_nonneg _) (haB 0 (Nat.zero_le _))
    have hE : 0 ≤ E := le_trans (norm_nonneg _) (hgE 0 (Nat.zero_le _))
    have hD0 : 0 < D := by linarith
    have hUd : UniqueDiffOn ℝ U := hU.uniqueDiffOn
    have hf : ContDiffOn ℝ ∞ (fun y => a (ψ y)) U := ha.contDiffOn.comp hψ (Set.mapsTo_univ ψ U)
    have hfi : ∀ i, i ≤ p → ‖iteratedFDerivWithin ℝ i (fun y => a (ψ y)) U x‖ ≤
        (p.factorial : ℝ) * B * D ^ p := by
      intro i hi
      have h1 := norm_iteratedFDerivWithin_comp_le (g := a) (f := ψ) (n := i) (s := U)
        (t := Set.univ) (x := x) (N := ∞)
        ha.contDiffOn hψ (by exact_mod_cast le_top) uniqueDiffOn_univ hUd (Set.mapsTo_univ ψ U) hx
        (C := B) (D := D)
        (fun j hj => by
          rw [iteratedFDerivWithin_univ, norm_iteratedFDeriv_eq_norm_iteratedDeriv]
          exact haB j (hj.trans hi))
        (fun j hj1 hj2 => by
          rw [iteratedFDerivWithin_of_isOpen j hU hx]
          exact hψD j hj1 (hj2.trans hi))
      have h2 : (i.factorial : ℝ) ≤ p.factorial := by exact_mod_cast Nat.factorial_le hi
      have h3 : D ^ i ≤ D ^ p := pow_le_pow_right₀ hD hi
      calc ‖iteratedFDerivWithin ℝ i (fun y => a (ψ y)) U x‖
          = ‖iteratedFDerivWithin ℝ i (a ∘ ψ) U x‖ := rfl
        _ ≤ (i.factorial : ℝ) * B * D ^ i := h1
        _ ≤ (p.factorial : ℝ) * B * D ^ p :=
          mul_le_mul (mul_le_mul_of_nonneg_right h2 hB) h3 (pow_nonneg hD0.le _)
            (mul_nonneg (Nat.cast_nonneg _) hB)
    have hL := norm_iteratedFDerivWithin_mul_le hf hg hUd hx (n := p) (by exact_mod_cast le_top)
    rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv, ← iteratedFDerivWithin_of_isOpen p hU hx]
    refine hL.trans ?_
    calc ∑ i ∈ Finset.range (p + 1), (p.choose i : ℝ) *
          ‖iteratedFDerivWithin ℝ i (fun y => a (ψ y)) U x‖ * ‖iteratedFDerivWithin ℝ (p - i) g U x‖
        ≤ ∑ i ∈ Finset.range (p + 1), (p.choose i : ℝ) * ((p.factorial : ℝ) * B * D ^ p * E) := by
          apply Finset.sum_le_sum
          intro i hi
          have hi' : i ≤ p := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [mul_assoc]
          apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
          rw [iteratedFDerivWithin_of_isOpen (p - i) hU hx]
          exact mul_le_mul (hfi i hi') (hgE (p - i) (Nat.sub_le _ _)) (norm_nonneg _)
            (mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hB) (pow_nonneg hD0.le _))
      _ = 2 ^ p * (p.factorial : ℝ) * D ^ p * E * B := by
          rw [← Finset.sum_mul]
          have hs : ∑ i ∈ Finset.range (p + 1), (p.choose i : ℝ) = 2 ^ p := by
            exact_mod_cast Nat.sum_range_choose p
          rw [hs]; ring

  have hd0 : 0 < d := by linarith
  have hs2 : 0 < s2 := hs1.trans hs12
  have hα : 0 < s1 ^ d := Real.rpow_pos_of_pos hs1 d
  have hθ : 0 ≤ d⁻¹ := inv_nonneg.mpr hd0.le
  have hψs : ContDiffOn ℝ ∞ (fun y : ℝ => y ^ d⁻¹) (Set.Ioi 0) := fun y hy =>
    (Real.contDiffAt_rpow_const_of_ne (ne_of_gt hy)).contDiffWithinAt
  have hgs : ContDiffOn ℝ ∞ (fun y : ℝ => ((d⁻¹ * y ^ (d⁻¹ - 1) : ℝ) : ℂ)) (Set.Ioi 0) := by
    intro y hy
    have h1 : ContDiffAt ℝ ∞ (fun y : ℝ => d⁻¹ * y ^ (d⁻¹ - 1)) y :=
      contDiffAt_const.mul (Real.contDiffAt_rpow_const_of_ne (ne_of_gt hy))
    exact (Complex.ofRealCLM.contDiff.comp_contDiffAt y h1).contDiffWithinAt

  have hsub : Set.Icc (s1 ^ d) (s2 ^ d) ⊆ Set.Ioi 0 := fun x hx => lt_of_lt_of_le hα hx.1
  have hcpt : ∀ {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G] (f : ℝ → G),
      ContDiffOn ℝ ∞ f (Set.Ioi 0) → ∀ i : ℕ, ∃ R : ℝ,
        ∀ x ∈ Set.Icc (s1 ^ d) (s2 ^ d), ‖iteratedFDeriv ℝ i f x‖ ≤ R := by
    intro G _ _ f hf i
    have hc := hf.continuousOn_iteratedFDerivWithin (m := i) (by exact_mod_cast le_top)
      (isOpen_Ioi.uniqueDiffOn)
    obtain ⟨R, hR⟩ := (isCompact_Icc (a := s1 ^ d) (b := s2 ^ d)).exists_bound_of_continuousOn
      (hc.mono hsub)
    refine ⟨R, fun x hx => ?_⟩
    rw [← iteratedFDerivWithin_of_isOpen i isOpen_Ioi (hsub hx)]
    exact hR x hx
  choose R hR using hcpt _ hψs
  choose Eb hEb using hcpt _ hgs
  obtain ⟨D, hD⟩ : ∃ D : ℝ, D = 1 + ∑ i ∈ Finset.range (p + 1), |R i| := ⟨_, rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : ℝ, E = ∑ i ∈ Finset.range (p + 1), |Eb i| := ⟨_, rfl⟩
  have hD1 : 1 ≤ D := by
    rw [hD]; linarith [Finset.sum_nonneg (fun i (_ : i ∈ Finset.range (p + 1)) => abs_nonneg (R i))]
  have hE0 : 0 ≤ E := by
    rw [hE]; exact Finset.sum_nonneg (fun i _ => abs_nonneg (Eb i))
  have hDb : ∀ x ∈ Set.Icc (s1 ^ d) (s2 ^ d), ∀ i : ℕ, 1 ≤ i → i ≤ p →
      ‖iteratedFDeriv ℝ i (fun y : ℝ => y ^ d⁻¹) x‖ ≤ D ^ i := by
    intro x hx i hi1 hip
    calc ‖iteratedFDeriv ℝ i (fun y : ℝ => y ^ d⁻¹) x‖ ≤ R i := hR i x hx
      _ ≤ |R i| := le_abs_self _
      _ ≤ ∑ j ∈ Finset.range (p + 1), |R j| :=
          Finset.single_le_sum (f := fun j => |R j|) (fun j _ => abs_nonneg _)
            (Finset.mem_range.mpr (by omega))
      _ ≤ D := by rw [hD]; linarith
      _ ≤ D ^ i := le_self_pow₀ hD1 (by omega)
  have hEbd : ∀ x ∈ Set.Icc (s1 ^ d) (s2 ^ d), ∀ i : ℕ, i ≤ p →
      ‖iteratedFDeriv ℝ i (fun y : ℝ => ((d⁻¹ * y ^ (d⁻¹ - 1) : ℝ) : ℂ)) x‖ ≤ E := by
    intro x hx i hip
    calc ‖iteratedFDeriv ℝ i (fun y : ℝ => ((d⁻¹ * y ^ (d⁻¹ - 1) : ℝ) : ℂ)) x‖ ≤ Eb i := hEb i x hx
      _ ≤ |Eb i| := le_abs_self _
      _ ≤ E := by
          rw [hE]
          exact Finset.single_le_sum (f := fun j => |Eb j|) (fun j _ => abs_nonneg _)
            (Finset.mem_range.mpr (by omega))
  have hK0 : 0 ≤ 2 ^ p * (p.factorial : ℝ) * D ^ p * E :=
    mul_nonneg (mul_nonneg (mul_nonneg (by positivity) (Nat.cast_nonneg _))
      (pow_nonneg (by linarith) _)) hE0
  refine ⟨2 ^ p * (p.factorial : ℝ) * D ^ p * E, hK0, ?_⟩
  intro B a ha hsupp hbd
  have hB0 : 0 ≤ B := le_trans (norm_nonneg _) (hbd 0 (Nat.zero_le _) 0)
  obtain ⟨A, hA⟩ : ∃ A : ℝ → ℂ, A = fun x : ℝ =>
      if 0 < x then a (x ^ d⁻¹) * ((d⁻¹ * x ^ (d⁻¹ - 1) : ℝ) : ℂ) else 0 := ⟨_, rfl⟩
  have hAx : ∀ x : ℝ, A x = if 0 < x then a (x ^ d⁻¹) * ((d⁻¹ * x ^ (d⁻¹ - 1) : ℝ) : ℂ) else 0 := by
    intro x; rw [hA]

  have hsuppA : ∀ x : ℝ, (x ≤ s1 ^ d ∨ s2 ^ d ≤ x) → A x = 0 := by
    intro x hx
    rw [hAx]
    by_cases hx0 : 0 < x
    · rw [if_pos hx0, hsupp _ ?_, zero_mul]
      rcases hx with h | h
      · left
        calc x ^ d⁻¹ ≤ (s1 ^ d) ^ d⁻¹ := Real.rpow_le_rpow hx0.le h hθ
          _ = s1 := Real.rpow_rpow_inv hs1.le hd0.ne'
      · right
        calc s2 = (s2 ^ d) ^ d⁻¹ := (Real.rpow_rpow_inv hs2.le hd0.ne').symm
          _ ≤ x ^ d⁻¹ := Real.rpow_le_rpow (Real.rpow_nonneg hs2.le _) h hθ
    · rw [if_neg hx0]

  have hAs : ContDiff ℝ ∞ A := by
    rw [contDiff_iff_contDiffAt]
    intro x
    by_cases hx0 : 0 < x
    · have hev : A =ᶠ[nhds x] fun y => a (y ^ d⁻¹) * ((d⁻¹ * y ^ (d⁻¹ - 1) : ℝ) : ℂ) :=
        Filter.eventuallyEq_of_mem (Ioi_mem_nhds hx0)
          (fun y hy => by rw [hAx, if_pos (show (0:ℝ) < y from hy)])
      refine ContDiffAt.congr_of_eventuallyEq ?_ hev
      exact (ha.comp_contDiffAt x (Real.contDiffAt_rpow_const_of_ne hx0.ne')).mul
        (hgs.contDiffAt (Ioi_mem_nhds hx0))
    · have hev : A =ᶠ[nhds x] fun _ => (0:ℂ) :=
        Filter.eventuallyEq_of_mem (Iio_mem_nhds (show x < s1 ^ d by linarith [not_lt.mp hx0]))
          (fun y hy => hsuppA y (Or.inl (le_of_lt hy)))
      exact contDiffAt_const.congr_of_eventuallyEq hev
  have hz : iteratedDeriv p (fun _ : ℝ => (0:ℂ)) = fun _ => 0 := by
    funext x; rw [iteratedDeriv_const]; split_ifs <;> rfl
  refine ⟨A, hAs, hsuppA, ?_, ?_⟩
  ·
    intro x
    rcases lt_or_ge x (s1 ^ d) with hxa | hxa
    · have hev : A =ᶠ[nhds x] fun _ => (0:ℂ) :=
        Filter.eventuallyEq_of_mem (Iio_mem_nhds hxa) (fun y hy => hsuppA y (Or.inl (le_of_lt hy)))
      rw [hev.iteratedDeriv_eq, hz, norm_zero]
      exact mul_nonneg hK0 hB0
    rcases lt_or_ge (s2 ^ d) x with hxb | hxb
    · have hev : A =ᶠ[nhds x] fun _ => (0:ℂ) :=
        Filter.eventuallyEq_of_mem (Ioi_mem_nhds hxb) (fun y hy => hsuppA y (Or.inr (le_of_lt hy)))
      rw [hev.iteratedDeriv_eq, hz, norm_zero]
      exact mul_nonneg hK0 hB0
    have hx0 : 0 < x := lt_of_lt_of_le hα hxa
    have hev : A =ᶠ[nhds x] fun y => a (y ^ d⁻¹) * ((d⁻¹ * y ^ (d⁻¹ - 1) : ℝ) : ℂ) :=
      Filter.eventuallyEq_of_mem (Ioi_mem_nhds hx0)
        (fun y hy => by rw [hAx, if_pos (show (0:ℝ) < y from hy)])
    rw [hev.iteratedDeriv_eq]
    have hmain := c3b a (fun y : ℝ => y ^ d⁻¹) (fun y : ℝ => ((d⁻¹ * y ^ (d⁻¹ - 1) : ℝ) : ℂ))
      (Set.Ioi 0) x B D E isOpen_Ioi hx0 ha hψs hgs hD1 (fun i hi => hbd i hi _)
      (fun i h1 h2 => hDb x ⟨hxa, hxb⟩ i h1 h2) (fun i hi => hEbd x ⟨hxa, hxb⟩ i hi)
    refine hmain.trans (le_of_eq ?_)
    ring
  ·
    intro lam
    have hpos : ∀ s ∈ Set.uIcc s1 s2, 0 < s := by
      intro s hs
      rw [Set.uIcc_of_le hs12.le] at hs
      exact lt_of_lt_of_le hs1 hs.1
    have hG : Continuous (fun x : ℝ => A x * Complex.exp (((lam * x : ℝ) : ℂ) * Complex.I)) :=
      hAs.continuous.mul (Complex.continuous_exp.comp
        ((Complex.continuous_ofReal.comp (continuous_const.mul continuous_id)).mul continuous_const))
    have hcov : ∫ s in s1..s2, (d * s ^ (d - 1)) •
          (A (s ^ d) * Complex.exp (((lam * s ^ d : ℝ) : ℂ) * Complex.I)) =
        ∫ x in (s1 ^ d)..(s2 ^ d), A x * Complex.exp (((lam * x : ℝ) : ℂ) * Complex.I) :=
      intervalIntegral.integral_deriv_smul_comp (a := s1) (b := s2)
        (f := fun s : ℝ => s ^ d) (f' := fun s => d * s ^ (d - 1))
        (g := fun x : ℝ => A x * Complex.exp (((lam * x : ℝ) : ℂ) * Complex.I))
        (fun s hs => Real.hasDerivAt_rpow_const (Or.inl (ne_of_gt (hpos s hs))))
        (continuousOn_const.mul (continuousOn_id.rpow_const
          (fun s hs => Or.inl (ne_of_gt (hpos s hs))))) hG
    rw [← hcov]
    apply intervalIntegral.integral_congr
    intro s hs
    have hsp := hpos s hs
    have hsd : 0 < s ^ d := Real.rpow_pos_of_pos hsp d
    show a s * Complex.exp (((lam * s ^ d : ℝ) : ℂ) * Complex.I) =
      (d * s ^ (d - 1)) • (A (s ^ d) * Complex.exp (((lam * s ^ d : ℝ) : ℂ) * Complex.I))
    rw [hAx, if_pos hsd, Real.rpow_rpow_inv hsp.le hd0.ne', ← Real.rpow_mul hsp.le,
      Complex.real_smul]
    have e : d * (d⁻¹ - 1) = -(d - 1) := by rw [mul_sub, mul_inv_cancel₀ hd0.ne']; ring
    have h1 : s ^ (d - 1) ≠ 0 := (Real.rpow_pos_of_pos hsp _).ne'
    have key : (d * s ^ (d - 1)) * (d⁻¹ * s ^ (d * (d⁻¹ - 1))) = 1 := by
      rw [e, Real.rpow_neg hsp.le, mul_mul_mul_comm, mul_inv_cancel₀ hd0.ne',
        mul_inv_cancel₀ h1, one_mul]
    have key' : ((d * s ^ (d - 1) : ℝ) : ℂ) * ((d⁻¹ * s ^ (d * (d⁻¹ - 1)) : ℝ) : ℂ) = 1 := by
      rw [← Complex.ofReal_mul, key, Complex.ofReal_one]
    linear_combination (-(a s * Complex.exp (((lam * s ^ d : ℝ) : ℂ) * Complex.I))) * key'

theorem torus_path_oscillation_v5 : ∀ (d s1 s2 : ℝ), 1 ≤ d → d ≤ 2 → 0 < s1 → s1 < s2 → ∀ p : ℕ, ∃ C : ℝ, ∀ (n : ℕ) (ρ M : ℝ) (F : ℝ × (ℝ × ℝ) → ℝ) (W : ℝ × ℝ), 0 < ρ → ContDiff ℝ ∞ F → (∀ (s : ℝ) (Y c : ℝ × ℝ), (∃ i j : ℤ, Jpow (n:ℤ) c = ((i:ℝ), (j:ℝ))) → F (s, Y + c) = F (s, Y)) → (∀ (s : ℝ) (Y : ℝ × ℝ), (s ≤ s1 ∨ s2 ≤ s) → F (s, Y) = 0) → (∀ k : ℕ, k ≤ 3 * p + 6 → ∀ (s : ℝ) (Y : ℝ × ℝ), ‖(iteratedFDeriv ℝ k F (s, Y)).compContinuousLinearMap (fun _ => (ContinuousLinearMap.id ℝ ℝ).prodMap (JpowL (-(n:ℤ))))‖ ≤ M) → |∫ s in s1..s2, (F (s, W + (ρ ^ d * s ^ d) • vrv) - ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, F (s, Y))| ≤ C * M * (Lgc ^ n * ρ ^ d) ^ (-(p:ℝ)) :=
by
  intro d s1 s2 hd1 _hd2 hs1 hs12 p

  have hsq2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hsq0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
  have hsqlt : Real.sqrt 2 < 2 := by nlinarith
  have hL : 0 < Lgc := by unfold Lgc; linarith
  have hT : 0 < Tgc := by unfold Tgc; linarith
  have hD : 0 < 1 + bgc ^ 2 := by positivity
  have hDne : 1 + bgc ^ 2 ≠ 0 := hD.ne'

  have hJcomp : ∀ (a b : ℤ) (Y : ℝ × ℝ), Jpow a (Jpow b Y) = Jpow (a + b) Y := by
    intro a b Y
    ext <;> simp only [Jpow, vrv, vtv, Prod.smul_mk, Prod.mk_add_mk, smul_eq_mul, zpow_add₀ hL.ne',
      zpow_add₀ hT.ne'] <;> field_simp <;> ring
  have hJ0 : ∀ Y : ℝ × ℝ, Jpow 0 Y = Y := by
    intro Y
    ext <;> simp only [Jpow, vrv, vtv, Prod.smul_mk, Prod.mk_add_mk, smul_eq_mul, zpow_zero, one_mul] <;>
      field_simp <;> ring
  have hJL : ∀ (a : ℤ) (Y : ℝ × ℝ), JpowL a Y = Jpow a Y := by
    intro a Y
    ext <;> simp [JpowL, Jpow, vrv, vtv] <;> ring

  have hbad : ∀ m : ℤ × ℤ, m ≠ 0 → 1 ≤ |(m.1:ℝ) - bgc * (m.2:ℝ)| * (|(m.1:ℝ)| + 3 * |(m.2:ℝ)|) := by
    intro m hm
    obtain ⟨m1, m2⟩ := m
    show 1 ≤ |(m1:ℝ) - bgc * (m2:ℝ)| * (|(m1:ℝ)| + 3 * |(m2:ℝ)|)
    have hkey : ((m1:ℝ) - bgc * (m2:ℝ)) * ((m1:ℝ) + (Real.sqrt 2 + 1) * (m2:ℝ)) =
        ((m1 ^ 2 + 2 * m1 * m2 - m2 ^ 2 : ℤ) : ℝ) := by
      simp only [bgc]; push_cast; linear_combination (-(m2:ℝ) ^ 2) * hsq2
    have hKz : (m1 ^ 2 + 2 * m1 * m2 - m2 ^ 2 : ℤ) ≠ 0 := by
      intro h0
      by_cases hm2 : m2 = 0
      · subst hm2
        simp at h0
        exact hm (by simp [h0])
      · have hq : ((m1:ℝ) + (m2:ℝ)) ^ 2 = 2 * (m2:ℝ) ^ 2 := by
          have h0' : ((m1 ^ 2 + 2 * m1 * m2 - m2 ^ 2 : ℤ) : ℝ) = 0 := by exact_mod_cast h0
          push_cast at h0'
          linarith
        have hb' : (m2:ℝ) ≠ 0 := by exact_mod_cast hm2
        have hq' : ((((m1 + m2 : ℤ) : ℚ) / (m2 : ℚ) : ℚ) : ℝ) ^ 2 = 2 := by
          push_cast
          field_simp
          linarith
        have h2 : Real.sqrt 2 = ((|(((m1 + m2 : ℤ) : ℚ) / (m2 : ℚ))| : ℚ) : ℝ) := by
          rw [← hq', Real.sqrt_sq_eq_abs]; push_cast; rfl
        exact irrational_sqrt_two.ne_rat _ h2
    have h1 : (1:ℝ) ≤ |((m1 ^ 2 + 2 * m1 * m2 - m2 ^ 2 : ℤ) : ℝ)| := by
      exact_mod_cast Int.one_le_abs hKz
    rw [← hkey, abs_mul] at h1
    have h2 : |(m1:ℝ) + (Real.sqrt 2 + 1) * (m2:ℝ)| ≤ |(m1:ℝ)| + 3 * |(m2:ℝ)| := by
      calc _ ≤ |(m1:ℝ)| + |(Real.sqrt 2 + 1) * (m2:ℝ)| := abs_add_le _ _
        _ = |(m1:ℝ)| + (Real.sqrt 2 + 1) * |(m2:ℝ)| := by
          rw [abs_mul, abs_of_pos (show (0:ℝ) < Real.sqrt 2 + 1 by positivity)]
        _ ≤ _ := by nlinarith [abs_nonneg (m2:ℝ)]
    calc (1:ℝ) ≤ _ := h1
      _ ≤ _ := mul_le_mul_of_nonneg_left h2 (abs_nonneg _)

  have hφ : Summable (fun k : ℤ => 1 / (1 + |(k:ℝ)|) ^ 2) := by
    have hn : Summable (fun n : ℕ => 1 / ((n:ℝ) + 1) ^ 2) := by
      have := (summable_nat_add_iff 1).mpr (Real.summable_one_div_nat_pow.mpr one_lt_two)
      simpa [Nat.cast_add, Nat.cast_one] using this
    rw [summable_int_iff_summable_nat_and_neg]
    constructor
    · refine hn.congr (fun n => ?_)
      simp [add_comm]
    · refine hn.congr (fun n => ?_)
      simp [add_comm]
  have hw2 : Summable (fun m : ℤ × ℤ => 1 / ((1 + |(m.1:ℝ)|) ^ 2 * (1 + |(m.2:ℝ)|) ^ 2)) := by
    have := Summable.mul_of_nonneg hφ hφ (fun k => by simp only [Pi.zero_apply]; positivity)
      (fun k => by simp only [Pi.zero_apply]; positivity)
    refine this.congr (fun m => ?_)
    rw [one_div_mul_one_div]

  have arith : ∀ (X a b μ Q : ℝ), 0 ≤ X → 0 ≤ a → 0 ≤ b → 0 < Q → 1 ≤ |μ| * (a + 3 * b) →
      X / ((1 + a) ^ (p + 2) * (1 + b) ^ (p + 2)) / (Q ^ p * |μ| ^ p) ≤
        X * 3 ^ p / Q ^ p * (1 / ((1 + a) ^ 2 * (1 + b) ^ 2)) := by
    intro X a b μ Q hX ha hb hQ h6
    obtain ⟨u, hu⟩ : ∃ u : ℝ, u = (1 + a) * (1 + b) := ⟨_, rfl⟩
    have hu1 : 1 ≤ u := by rw [hu]; nlinarith
    have hu0 : 0 < u := by linarith
    have h3 : a + 3 * b ≤ 3 * u := by rw [hu]; nlinarith
    have hμu : 1 ≤ 3 * u * |μ| := by nlinarith [mul_le_mul_of_nonneg_left h3 (abs_nonneg μ)]
    have hμ0 : 0 < |μ| := by
      rcases (abs_nonneg μ).lt_or_eq with h | h
      · exact h
      · rw [← h] at hμu; linarith
    have e1 : (1 + a) ^ (p + 2) * (1 + b) ^ (p + 2) = u ^ 2 * u ^ p := by
      rw [← mul_pow, ← hu]; ring
    have e2 : (1 + a) ^ 2 * (1 + b) ^ 2 = u ^ 2 := by rw [← mul_pow, ← hu]
    have hpow : 1 ≤ (3 * u * |μ|) ^ p := one_le_pow₀ hμu
    rw [e1, e2, div_div, div_le_iff₀ (by positivity)]
    have e3 : X * 3 ^ p / Q ^ p * (1 / u ^ 2) * (u ^ 2 * u ^ p * (Q ^ p * |μ| ^ p)) =
        X * (3 * u * |μ|) ^ p := by
      field_simp; ring
    rw [e3]
    exact le_mul_of_one_le_right hX hpow

  obtain ⟨K, hK0, hK⟩ := power_subst_v5 d s1 s2 hd1 hs1 hs12 p
  obtain ⟨S, hS⟩ := hw2
  have hd0 : 0 < d := by linarith
  have hαβ : s1 ^ d < s2 ^ d := Real.rpow_lt_rpow hs1.le hs12 hd0
  refine ⟨(s2 ^ d - s1 ^ d) * K * 4 ^ (p + 2) * 3 ^ p * S / (2 * Real.pi) ^ p, ?_⟩
  intro n ρ M F W hρ hF hper hsupp hbd

  set G : ℝ × (ℝ × ℝ) → ℝ := fun x => F (x.1, JpowL (-(n:ℤ)) x.2) with hGdef
  have hGΛ : G = F ∘ ⇑((ContinuousLinearMap.id ℝ ℝ).prodMap (JpowL (-(n:ℤ)))) := by
    funext x; rfl
  have hGs : ContDiff ℝ ∞ G := by
    rw [hGΛ]; exact hF.comp (ContinuousLinearMap.contDiff _)
  have hGb : ∀ k : ℕ, k ≤ 3 * p + 6 → ∀ x : ℝ × (ℝ × ℝ), ‖iteratedFDeriv ℝ k G x‖ ≤ M := by
    intro k hk x
    rw [hGΛ, ContinuousLinearMap.iteratedFDeriv_comp_right _ hF x (by exact_mod_cast le_top)]
    exact hbd k hk x.1 (JpowL (-(n:ℤ)) x.2)
  have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hbd 0 (by omega) 0 0)
  have hGper : ∀ (s : ℝ) (Z : ℝ × ℝ) (i j : ℤ), G (s, Z + ((i:ℝ), (j:ℝ))) = G (s, Z) := by
    intro s Z i j
    show F (s, JpowL (-(n:ℤ)) (Z + ((i:ℝ), (j:ℝ)))) = F (s, JpowL (-(n:ℤ)) Z)
    rw [map_add]
    apply hper
    refine ⟨i, j, ?_⟩
    rw [hJL, hJcomp, add_neg_cancel, hJ0]
  have hFG : ∀ (s : ℝ) (Y : ℝ × ℝ), F (s, Y) = G (s, Jpow (n:ℤ) Y) := by
    intro s Y
    show F (s, Y) = F (s, JpowL (-(n:ℤ)) (Jpow (n:ℤ) Y))
    rw [hJL, hJcomp, neg_add_cancel, hJ0]
  have hJpath : ∀ t : ℝ, Jpow (n:ℤ) (W + t • vrv) = Jpow (n:ℤ) W + (Lgc ^ n * t) • vrv := by
    intro t
    ext <;> simp [Jpow, vrv, vtv, zpow_natCast] <;> field_simp <;> ring
  have hGc : ∀ s : ℝ, Continuous (fun Z : ℝ × ℝ => G (s, Z)) := fun s =>
    hGs.continuous.comp (continuous_const.prodMk continuous_id)
  have hmean : ∀ s : ℝ, ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, F (s, Y) =
      ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, G (s, Z) := by
    intro s
    have h2 := torus_mean_jpow_invariant_v5 n (fun Z => G (s, Z)) (hGc s) (fun Z i j => hGper s Z i j)
    calc ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, F (s, Y)
        = ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, G (s, Jpow (n:ℤ) Y) := by
          congr 1; funext Y; exact hFG s Y
      _ = _ := h2
  obtain ⟨Ω, hΩ⟩ : ∃ Ω : ℝ, Ω = Lgc ^ n * ρ ^ d := ⟨_, rfl⟩
  rw [← hΩ]
  have hΩ0 : 0 < Ω := by rw [hΩ]; exact mul_pos (pow_pos hL n) (Real.rpow_pos_of_pos hρ d)
  have hΩne : Ω ≠ 0 := hΩ0.ne'
  have hpine : Real.pi ≠ 0 := Real.pi_ne_zero
  set W' : ℝ × ℝ := Jpow (n:ℤ) W with hW'
  set Zs : ℝ → ℝ × ℝ := fun s => W' + (Ω * s ^ d) • vrv with hZs
  have hpath : ∀ s : ℝ, F (s, W + (ρ ^ d * s ^ d) • vrv) = G (s, Zs s) := by
    intro s
    rw [hFG, hJpath]
    have e : Lgc ^ n * (ρ ^ d * s ^ d) = Ω * s ^ d := by rw [hΩ]; ring
    rw [e]

  set c : ℤ × ℤ → ℝ → ℂ := fun m s => ∫ Z in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
    (G (s, Z) : ℂ) * Complex.exp (-(2 * ↑Real.pi * Complex.I * ((m.1 : ℂ) * (Z.1 : ℂ) + (m.2 : ℂ) * (Z.2 : ℂ))))
    with hcdef
  have hbox := box_coef_decay_v5 (p + 2) p M G hGs hGper (fun k hk x => hGb k (by omega) x)
  have hcs : ∀ m, ContDiff ℝ ∞ (c m) := fun m => (hbox m).1
  have hcd : ∀ m : ℤ × ℤ, ∀ j : ℕ, j ≤ p → ∀ s, ‖iteratedDeriv j (c m) s‖ ≤
      4 ^ (p + 2) * M / ((1 + |(m.1:ℝ)|) ^ (p + 2) * (1 + |(m.2:ℝ)|) ^ (p + 2)) := fun m => (hbox m).2
  have hw2le : ∀ m : ℤ × ℤ, (1 + |(m.1:ℝ)|) ^ 2 * (1 + |(m.2:ℝ)|) ^ 2 ≤
      (1 + |(m.1:ℝ)|) ^ (p + 2) * (1 + |(m.2:ℝ)|) ^ (p + 2) := by
    intro m
    have h1 : (1:ℝ) ≤ 1 + |(m.1:ℝ)| := by linarith [abs_nonneg (m.1:ℝ)]
