    have hSaQ : S * a ^ 2 ≤ Q := by rw [hQ]; linarith
    have hPbQ : P * (1 + σ ^ 2) * b ^ 2 ≤ Q := by rw [hQ]; linarith
    have ha2 : a ^ 2 ≤ 2 * M ^ 3 * Q := by
      have h1 : a ^ 2 ≤ 2 * M ^ 3 * S * a ^ 2 := le_mul_of_one_le_left (sq_nonneg a) hS3
      have h2 : 2 * M ^ 3 * (S * a ^ 2) ≤ 2 * M ^ 3 * Q :=
        mul_le_mul_of_nonneg_left hSaQ (by positivity)
      have e : 2 * M ^ 3 * S * a ^ 2 = 2 * M ^ 3 * (S * a ^ 2) := by ring
      linarith
    have hb2 : 2 * b ^ 2 ≤ M ^ 2 * Q := by
      have h1 : P * 1 ≤ P * (1 + σ ^ 2) := mul_le_mul_of_nonneg_left hr1 hPpos.le
      have h2 : M ^ 2 * (P * 1) ≤ M ^ 2 * (P * (1 + σ ^ 2)) :=
        mul_le_mul_of_nonneg_left h1 (by positivity)
      have e0 : M ^ 2 * (P * 1) = P * M ^ 2 := by ring
      have h3 : 2 ≤ M ^ 2 * (P * (1 + σ ^ 2)) := by linarith
      have h4 : 2 * b ^ 2 ≤ M ^ 2 * (P * (1 + σ ^ 2)) * b ^ 2 :=
        mul_le_mul_of_nonneg_right h3 (sq_nonneg b)
      have h5 : M ^ 2 * (P * (1 + σ ^ 2) * b ^ 2) ≤ M ^ 2 * Q :=
        mul_le_mul_of_nonneg_left hPbQ (by positivity)
      have e : M ^ 2 * (P * (1 + σ ^ 2)) * b ^ 2 = M ^ 2 * (P * (1 + σ ^ 2) * b ^ 2) := by ring
      linarith

    obtain ⟨E, hE⟩ : ∃ E : ℝ, E = (n 0 - Bs * σ) * x 0 + (n 1 - Bs * -N2) * x 1 + (n 2 - Bs * N1) * x 2 :=
      ⟨_, rfl⟩
    have hgE : Bs * c = g - E := by rw [hg, hc, hE]; ring
    have hE2 : E ^ 2 ≤ 3 * δ ^ 2 * X := by
      have h := three ((n 0 - Bs * σ) * x 0) ((n 1 - Bs * -N2) * x 1) ((n 2 - Bs * N1) * x 2)
