    obtain ⟨Bd, hBd⟩ :=
      (isCompact_Icc.prod isCompact_Icc).exists_bound_of_continuousOn (hcont.mono hK)
    have hsub2 : uIoc a b ⊆ Icc a b := by rw [uIoc_of_le hab]; exact Ioc_subset_Icc_self
