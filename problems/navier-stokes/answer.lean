      N2 = -(b / a * N1) ∧ N1 < 0 ∧ 1 ≤ -N1 * (1 + M) ∧ c ^ 2 = (a * (1 + (b / a) ^ 2) - 2) / 2 := by
    intro F5 a b M n N1 N2 c hF ha hM hV hn hN1 hN2 hc
    have hFa : 0 < F5 * a := mul_pos hF ha
    have hrad : 0 < (F5 * -a) ^ 2 + (F5 * b) ^ 2 := by nlinarith [sq_nonneg (F5 * b)]
    have hnpos : 0 < n := by rw [hn]; exact Real.sqrt_pos.mpr hrad
    have hn2 : n ^ 2 = F5 ^ 2 * (a ^ 2 + b ^ 2) := by
