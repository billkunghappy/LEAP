  have hbm : ∀ (c : ℝ) (f : Cyl → ℝ), InM B (qsOf l0) c (nrm B (Aex B.h) f) →
      InM B (qsOf l0) (c + 1) (nrm B (2 * Aex B.h) (fun ξ => ubase B ξ 0 * f ξ)) := by
