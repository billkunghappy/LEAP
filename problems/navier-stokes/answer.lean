  choose B0 hB0 using hbd
  refine ⟨243 * (|B0 n| + 2 * |B0 (n + 1 + 1 + 1 + 1 + 1)|), ?_⟩
  intro κ x
  set M : Cyl → ℂ := fun y : Cyl => fourY F y κ *
    Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * (y.2.2.2.1 : ℂ) + (κ.2 : ℂ) * (y.2.2.2.2 : ℂ)))
