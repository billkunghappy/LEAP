  have k20 : |Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))| ≤ A := by
