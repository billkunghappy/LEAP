      (fun x _ => (Real.hasDerivAt_exp x).const_mul (4 / Λ))
      (continuous_const.mul Real.continuous_exp).continuousOn (hgc.mono himg)
    have hmain : (∫ y in (0:ℝ)..L, axSlopeU h Λ t1 κ0 om Pax Fn Un y η) =
        ∫ x in (4 / Λ)..X, (1 - axEa Λ t1 κ0 x) * deriv (fun Y => Un Y η) x := by
      rw [hint, hcov]
      simp only [Real.exp_zero, mul_one, hLX]
    have hsplit : (∫ x in (4 / Λ)..X, (1 - axEa Λ t1 κ0 x) * deriv (fun Y => Un Y η) x) =
        (∫ x in (4 / Λ)..X, deriv (fun Y => Un Y η) x) -
          ∫ x in (4 / Λ)..X, axEa Λ t1 κ0 x * deriv (fun Y => Un Y η) x := by
      rw [← intervalIntegral.integral_sub hdi hedi]
      congr 1; funext x; ring
    have hftc : (∫ x in (4 / Λ)..X, deriv (fun Y => Un Y η) x) = Un X η - Un (4 / Λ) η :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt
        (fun x hx => by rw [hu1] at hx; exact hψh x (hIccJ (hsub hx))) hdi
    have hext : (∫ x in (0:ℝ)..X, axEa Λ t1 κ0 x * deriv (fun Y => Un Y η) x) =
        ∫ x in (4 / Λ)..X, axEa Λ t1 κ0 x * deriv (fun Y => Un Y η) x := by
      rw [← intervalIntegral.integral_add_adjacent_intervals hedi0 hedi]
      have heq : Set.EqOn (fun x => axEa Λ t1 κ0 x * deriv (fun Y => Un Y η) x) (fun _ => (0:ℝ))
          (Set.uIcc 0 (4 / Λ)) := by
        intro x hx
        rw [hu0] at hx
        simp only [hEa0 x hx.2, zero_mul]
      rw [intervalIntegral.integral_congr heq]
      simp
    rw [hmain, hsplit, hftc, hext]
    ring

  have hΛ0 : 0 < Λ := by linarith
  have hc : 0 < 4 / Λ := div_pos (by norm_num) hΛ0
  have s3 : ∀ (g : ℝ → ℝ) (c : ℝ), 0 < c → (∀ s, s ≤ c → g s = 0) → ∀ Y : ℝ,
      (∫ s in (0:ℝ)..Y, g s) = ∫ s in c..Y, g s := by
    intro g c hc0 hg Y
    by_cases hY : Y ≤ c
    · have e1 : (∫ s in (0:ℝ)..Y, g s) = ∫ s in (0:ℝ)..Y, (0:ℝ) := by
        apply intervalIntegral.integral_congr
        intro s hs
        rcases Set.mem_uIcc.mp hs with ⟨_, h2⟩ | ⟨_, h2⟩
        · exact hg s (by linarith)
        · exact hg s (by linarith)
      have e2 : (∫ s in c..Y, g s) = ∫ s in c..Y, (0:ℝ) := by
        apply intervalIntegral.integral_congr
        intro s hs
        rcases Set.mem_uIcc.mp hs with ⟨_, h2⟩ | ⟨_, h2⟩
        · exact hg s (by linarith)
        · exact hg s (by linarith)
      rw [e1, e2, intervalIntegral.integral_zero, intervalIntegral.integral_zero]
    · push_neg at hY
      rw [intervalIntegral.integral_of_le (by linarith), intervalIntegral.integral_of_le hY.le]
      refine MeasureTheory.setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioc
        (Set.Ioc_subset_Ioc_left hc0.le) ?_
      intro x hx
      apply hg
      by_contra hxc
      push_neg at hxc
      exact hx.2 ⟨hxc, hx.1.2⟩
  have hzero : ∀ s, s ≤ 4 / Λ → axEa Λ t1 κ0 s = 0 := by
    intro s hs
    unfold axEa
    rw [if_pos hs]
  refine ⟨?_, ?_⟩
  · rw [repF]
    unfold axFfModelF
    rw [s3 (fun s => axEa Λ t1 κ0 s * (deriv (fun Y => Fn Y η) s * (Fn s η)⁻¹)) (4 / Λ) hc
      (fun s hs => by simp only [hzero s hs, zero_mul]) X, neg_one_mul]
    simp only [div_eq_mul_inv]
  · rw [repU]
    unfold axFfModelU
    rw [s3 (fun s => axEa Λ t1 κ0 s * deriv (fun Y => Un Y η) s) (4 / Λ) hc
      (fun s hs => by simp only [hzero s hs, zero_mul]) X]
    ring

theorem ps_local_congr : ∀ (h : ℝ) (Pax : ℝ → ℝ) (F U G V : ℝ → ℝ → ℝ) (X η : ℝ), 0 ≤ X → -1 < η → η < 1 → (∀ x e : ℝ, 0 ≤ x → x ≤ X → -1 < e → e < 1 → G x e = F x e ∧ V x e = U x e) → G X η = F X η ∧ psLead1 h G V X η = psLead1 h F U X η ∧ axPs2 h Pax G V X η = axPs2 h Pax F U X η :=
by
  intro h Pax F U G V X η hX hη1 hη2 hag

  have hI : ∀ (g g' : ℝ → ℝ → ℝ),
      (∀ x e : ℝ, 0 ≤ x → x ≤ X → -1 < e → e < 1 → g' x e = g x e) →
      ∀ e : ℝ, -1 < e → e < 1 → profRadInt g' X e = profRadInt g X e := by
    intro g g' hg e he1 he2
    unfold profRadInt
    apply intervalIntegral.integral_congr
    intro x hx
    rw [Set.uIcc_of_le hX] at hx
    exact hg x e hx.1 hx.2 he1 he2

  have hAv : ∀ e : ℝ, -1 < e → e < 1 → profRadAvg V X e = profRadAvg U X e := by
    intro e he1 he2
    unfold profRadAvg
    apply intervalIntegral.integral_congr
    intro s hs
    rw [Set.uIcc_of_le zero_le_one] at hs
    exact (hag (s * X) e (mul_nonneg hs.1 hX) (mul_le_of_le_one_left hX hs.2) he1 he2).2

  have hD : ∀ (φ ψ : ℝ → ℝ), (∀ e : ℝ, -1 < e → e < 1 → φ e = ψ e) → deriv φ η = deriv ψ η := by
    intro φ ψ hφ
    apply Filter.EventuallyEq.deriv_eq
    exact Filter.eventuallyEq_of_mem (Ioo_mem_nhds hη1 hη2) (fun e he => hφ e he.1 he.2)
  have hED : ∀ (g g' : ℝ → ℝ → ℝ), (∀ e : ℝ, -1 < e → e < 1 → g' X e = g X e) →
      profEtaD g' X η = profEtaD g X η := by
    intro g g' hg
    unfold profEtaD
    exact hD _ _ hg

  have h1 : ∀ x e : ℝ, 0 ≤ x → x ≤ X → -1 < e → e < 1 →
      (fun x e => 2 * x * G x e) x e = (fun x e => 2 * x * F x e) x e := by
    intro x e a b c d
    simp only [(hag x e a b c d).1]
  have h2 : ∀ x e : ℝ, 0 ≤ x → x ≤ X → -1 < e → e < 1 →
      (fun x e => V x e * (2 * x * G x e)) x e = (fun x e => U x e * (2 * x * F x e)) x e := by
    intro x e a b c d
    simp only [(hag x e a b c d).1, (hag x e a b c d).2]
  have h3 : ∀ x e : ℝ, 0 ≤ x → x ≤ X → -1 < e → e < 1 → V x e = U x e :=
    fun x e a b c d => (hag x e a b c d).2
  have h4 : ∀ x e : ℝ, 0 ≤ x → x ≤ X → -1 < e → e < 1 →
      (fun x e => V x e ^ 2 - x * G x e ^ 2) x e = (fun x e => U x e ^ 2 - x * F x e ^ 2) x e := by
    intro x e a b c d
    simp only [(hag x e a b c d).1, (hag x e a b c d).2]
  have h5 : ∀ x e : ℝ, 0 ≤ x → x ≤ X → -1 < e → e < 1 →
      (fun x e => G x e ^ 2) x e = (fun x e => F x e ^ 2) x e := by
    intro x e a b c d
    simp only [(hag x e a b c d).1]
  have e1 := hI _ _ h1 η hη1 hη2
  have e2 := hI _ _ h2 η hη1 hη2
  have e3 := hI _ _ h3 η hη1 hη2
  have e4 := hI _ _ h4 η hη1 hη2
  have d1 := hED _ _ (hI _ _ h1)
  have d2 := hED _ _ (hI _ _ h2)
  have d3 := hED _ _ (hI _ _ h3)
  have d4 := hED _ _ (hI _ _ h4)
  have hW : leadW h V X η = leadW h U X η := by
    unfold leadW
    rw [hAv η hη1 hη2, hED _ _ hAv]
  have hPi : ∀ e : ℝ, -1 < e → e < 1 → axPi Pax G X e = axPi Pax F X e := by
    intro e he1 he2
    unfold axPi
    rw [hI _ _ h5 e he1 he2]
  have dPi := hED _ _ hPi

  have hFX : G X η = F X η := (hag X η hX le_rfl hη1 hη2).1
  have hUX : V X η = U X η := (hag X η hX le_rfl hη1 hη2).2
  refine ⟨hFX, ?_, ?_⟩
  ·
    unfold psLead1 leadQs
    rw [hW, e1, d1, d2, e2, hFX]
  ·
    unfold axPs2 axNs
    rw [hW, e3, d3, e4, d4, hPi η hη1 hη2, dPi, hUX, hFX]

theorem ax_model_pointwise : ∀ (h j0 σ δ Λ C K ρ1 : ℝ) (Pax : ℝ → ℝ) (Kder : ℕ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 1 ≤ Λ → 0 < ρ1 → AxAxisOut h j0 σ δ Pax Λ C K ρ1 Kder Fn Un → ∃ c Bn Km : ℝ, 0 < c ∧ 0 ≤ Bn ∧ 0 ≤ Km ∧ ∀ t1 κ0 X : ℝ, 0 < t1 → t1 ≤ 1 / 100 → 0 < κ0 → κ0 < 1 / 2 → 4 / Λ < X → X ≤ 4 / Λ * Real.exp t1 → (∀ e : ℝ, -1 < e → e < 1 → ContinuousOn (fun x => Fn x e) (Icc 0 X) ∧ ContinuousOn (fun x => deriv (fun e' => Fn x e') e) (Icc 0 X) ∧ ContinuousOn (fun x => Un x e) (Icc 0 X) ∧ ContinuousOn (fun x => deriv (fun e' => Un x e') e) (Icc 0 X) ∧ ContinuousOn (fun x => axFfModelF Λ t1 κ0 Fn x e) (Icc 0 X) ∧ ContinuousOn (fun x => deriv (fun e' => axFfModelF Λ t1 κ0 Fn x e') e) (Icc 0 X) ∧ ContinuousOn (fun x => axFfModelU Λ t1 κ0 Un x e) (Icc 0 X) ∧ ContinuousOn (fun x => deriv (fun e' => axFfModelU Λ t1 κ0 Un x e') e) (Icc 0 X)) ∧ (∀ x e : ℝ, 0 ≤ x → x ≤ X → -1 < e → e < 1 → DifferentiableAt ℝ (fun e' => Fn x e') e ∧ DifferentiableAt ℝ (fun e' => Un x e') e ∧ DifferentiableAt ℝ (fun e' => axFfModelF Λ t1 κ0 Fn x e') e ∧ DifferentiableAt ℝ (fun e' => axFfModelU Λ t1 κ0 Un x e') e ∧ c ≤ Fn x e ∧ c ≤ axFfModelF Λ t1 κ0 Fn x e ∧ |Fn x e| ≤ Bn ∧ |deriv (fun e' => Fn x e') e| ≤ Bn ∧ |Un x e| ≤ Bn ∧ |deriv (fun e' => Un x e') e| ≤ Bn ∧ |axFfModelF Λ t1 κ0 Fn x e - Fn x e| ≤ Km * (axEa Λ t1 κ0 X * (X - 4 / Λ)) ∧ |deriv (fun e' => axFfModelF Λ t1 κ0 Fn x e') e - deriv (fun e' => Fn x e') e| ≤ Km * (axEa Λ t1 κ0 X * (X - 4 / Λ)) ∧ |axFfModelU Λ t1 κ0 Un x e - Un x e| ≤ Km * (axEa Λ t1 κ0 X * (X - 4 / Λ)) ∧ |deriv (fun e' => axFfModelU Λ t1 κ0 Un x e') e - deriv (fun e' => Un x e') e| ≤ Km * (axEa Λ t1 κ0 X * (X - 4 / Λ))) :=
by
  intro h j0 σ δ Λ C K ρ1 Pax Kder Fn Un hΛ hρ1 hA
  have hF := hA.1
  have hU := hA.2.1
  have hpos := hA.2.2.1

  have s1 : ∀ (f : ℝ → ℝ → ℝ) (S : Set (ℝ × ℝ)) (a b c d : ℝ), IsOpen S → ContDiffOn ℝ ∞ (↿f) S → Icc a b ×ˢ Icc c d ⊆ S → ∃ B : ℝ, 0 ≤ B ∧ (∀ x e : ℝ, a ≤ x → x ≤ b → c ≤ e → e ≤ d → |f x e| ≤ B ∧ |deriv (fun Y => f Y e) x| ≤ B ∧ |deriv (fun e' => f x e') e| ≤ B ∧ |deriv (fun e' => deriv (fun Y => f Y e') x) e| ≤ B ∧ HasDerivAt (fun e' => f x e') (deriv (fun e' => f x e') e) e ∧ HasDerivAt (fun e' => deriv (fun Y => f Y e') x) (deriv (fun e' => deriv (fun Y => f Y e') x) e) e) ∧ (∀ e : ℝ, c ≤ e → e ≤ d → ContinuousOn (fun Y => f Y e) (Icc a b) ∧ ContinuousOn (fun Y => deriv (fun Y' => f Y' e) Y) (Icc a b) ∧ ContinuousOn (fun Y => deriv (fun e' => f Y e') e) (Icc a b) ∧ ContinuousOn (fun Y => deriv (fun e' => deriv (fun Y' => f Y' e') Y) e) (Icc a b)) := by
    intro f S a b c d hS hF hK
    set F : ℝ × ℝ → ℝ := ↿f with hFdef
    have hD : ContDiffOn ℝ 2 (fderiv ℝ F) S := hF.fderiv_of_isOpen hS (by norm_num)
    set g1 : ℝ × ℝ → ℝ := fun p => fderiv ℝ F p ((1:ℝ), (0:ℝ)) with hg1def
    set g2 : ℝ × ℝ → ℝ := fun p => fderiv ℝ F p ((0:ℝ), (1:ℝ)) with hg2def
    have hg1 : ContDiffOn ℝ 2 g1 S := hD.clm_apply contDiffOn_const
    have hg2 : ContDiffOn ℝ 2 g2 S := hD.clm_apply contDiffOn_const
    set g12 : ℝ × ℝ → ℝ := fun p => fderiv ℝ g1 p ((0:ℝ), (1:ℝ)) with hg12def
    have hg1f : ContinuousOn (fderiv ℝ g1) S := hg1.continuousOn_fderiv_of_isOpen hS (by norm_num)
    have hg12 : ContinuousOn g12 S :=
      (ContinuousLinearMap.apply ℝ ℝ ((0:ℝ), (1:ℝ))).continuous.comp_continuousOn hg1f
    have hdiff : ∀ (G : ℝ × ℝ → ℝ), ContDiffOn ℝ 2 G S → ∀ p ∈ S, DifferentiableAt ℝ G p :=
      fun G hG p hp => (hG.contDiffAt (hS.mem_nhds hp)).differentiableAt (by norm_num)
    have hFd : ∀ p ∈ S, DifferentiableAt ℝ F p :=
      fun p hp => (hF.contDiffAt (hS.mem_nhds hp)).differentiableAt (by norm_num)
    have hsl1 : ∀ (G : ℝ × ℝ → ℝ) (x e : ℝ), DifferentiableAt ℝ G (x, e) →
        HasDerivAt (fun Y => G (Y, e)) (fderiv ℝ G (x, e) ((1:ℝ), (0:ℝ))) x := by
      intro G x e hG
      have hp : HasDerivAt (fun Y : ℝ => (Y, e)) ((1:ℝ), (0:ℝ)) x :=
        (hasDerivAt_id x).prodMk (hasDerivAt_const x e)
      exact hG.hasFDerivAt.comp_hasDerivAt x hp
    have hsl2 : ∀ (G : ℝ × ℝ → ℝ) (x e : ℝ), DifferentiableAt ℝ G (x, e) →
        HasDerivAt (fun e' => G (x, e')) (fderiv ℝ G (x, e) ((0:ℝ), (1:ℝ))) e := by
      intro G x e hG
      have hp : HasDerivAt (fun e' : ℝ => (x, e')) ((0:ℝ), (1:ℝ)) e :=
        (hasDerivAt_const e x).prodMk (hasDerivAt_id e)
      exact hG.hasFDerivAt.comp_hasDerivAt e hp
    have hid1 : ∀ x e, (x, e) ∈ S → deriv (fun Y => f Y e) x = g1 (x, e) :=
      fun x e h => (hsl1 F x e (hFd _ h)).deriv
    have hid2 : ∀ x e, (x, e) ∈ S → HasDerivAt (fun e' => f x e') (g2 (x, e)) e :=
      fun x e h => hsl2 F x e (hFd _ h)
    have hid12 : ∀ x e, (x, e) ∈ S →
        HasDerivAt (fun e' => deriv (fun Y => f Y e') x) (g12 (x, e)) e := by
      intro x e h
      have h1 : HasDerivAt (fun e' => g1 (x, e')) (g12 (x, e)) e := hsl2 g1 x e (hdiff g1 hg1 _ h)
      apply h1.congr_of_eventuallyEq
      have hn : {e' : ℝ | (x, e') ∈ S} ∈ nhds e :=
        (hS.preimage (Continuous.prodMk continuous_const continuous_id)).mem_nhds h
      exact Filter.eventually_of_mem hn (fun e' he' => hid1 x e' he')
    have hKc : IsCompact (Icc a b ×ˢ Icc c d) := isCompact_Icc.prod isCompact_Icc
    obtain ⟨B0, hB0⟩ := hKc.exists_bound_of_continuousOn (hF.continuousOn.mono hK)
    obtain ⟨B1, hB1⟩ := hKc.exists_bound_of_continuousOn (hg1.continuousOn.mono hK)
    obtain ⟨B2, hB2⟩ := hKc.exists_bound_of_continuousOn (hg2.continuousOn.mono hK)
    obtain ⟨B3, hB3⟩ := hKc.exists_bound_of_continuousOn (hg12.mono hK)
    refine ⟨|B0| + |B1| + |B2| + |B3|, by positivity, ?_, ?_⟩
    · intro x e hx1 hx2 he1 he2
      have hm : (x, e) ∈ Icc a b ×ˢ Icc c d := ⟨⟨hx1, hx2⟩, ⟨he1, he2⟩⟩
      have hS' := hK hm
      have a0 := hB0 _ hm
      have a1 := hB1 _ hm
      have a2 := hB2 _ hm
      have a3 := hB3 _ hm
      rw [Real.norm_eq_abs] at a0 a1 a2 a3
      have q0 := le_abs_self B0
      have q1 := le_abs_self B1
      have q2 := le_abs_self B2
      have q3 := le_abs_self B3
      have p0 := abs_nonneg B0
      have p1 := abs_nonneg B1
      have p2 := abs_nonneg B2
      have p3 := abs_nonneg B3
      rw [(hid2 x e hS').deriv, (hid12 x e hS').deriv, hid1 x e hS']
      refine ⟨?_, ?_, ?_, ?_, hid2 x e hS', hid12 x e hS'⟩
      · show |F (x, e)| ≤ _; linarith
      · linarith
      · linarith
      · linarith
    · intro e he1 he2
      have hmap : MapsTo (fun Y : ℝ => (Y, e)) (Icc a b) S := fun Y hY => hK ⟨hY, ⟨he1, he2⟩⟩
      have hcY : ∀ G : ℝ × ℝ → ℝ, ContinuousOn G S → ContinuousOn (fun Y => G (Y, e)) (Icc a b) :=
        fun G hG => hG.comp (Continuous.prodMk continuous_id continuous_const).continuousOn hmap
      refine ⟨hcY F hF.continuousOn, ?_, ?_, ?_⟩
      · exact (hcY g1 hg1.continuousOn).congr (fun Y hY => hid1 Y e (hmap hY))
      · exact (hcY g2 hg2.continuousOn).congr (fun Y hY => (hid2 Y e (hmap hY)).deriv)
      · exact (hcY g12 hg12).congr (fun Y hY => (hid12 Y e (hmap hY)).deriv)

  have s3 : ∀ (B d f fe E Ee : ℝ), 1 ≤ B → 0 ≤ d → d ≤ 1 → 1 / B ≤ f → f ≤ B → |fe| ≤ B → |E| ≤ B * d → |Ee| ≤ B * d → 1 / (B * Real.exp B) ≤ f * Real.exp (-E) ∧ |f * Real.exp (-E) - f| ≤ B ^ 2 * Real.exp B * d ∧ |(fe * Real.exp (-E) + f * (Real.exp (-E) * -Ee)) - fe| ≤ 2 * B ^ 2 * Real.exp B * d := by
    intro B d f fe E Ee hB hd0 hd1 hf1 hf2 hfe hE hEe
    have hB0 : 0 < B := by linarith
    have hf0 : 0 < f := lt_of_lt_of_le (by positivity) hf1
    have hBd : B * d ≤ B := by nlinarith
    have hEB : |E| ≤ B := le_trans hE hBd
    have hexpB : Real.exp |E| ≤ Real.exp B := Real.exp_le_exp.mpr hEB
    have key : ∀ u : ℝ, |Real.exp u - 1| ≤ |u| * Real.exp |u| := by
      intro u
      rcases le_or_gt 0 u with hu | hu
      · have h1 := Real.add_one_le_exp u
        have h2 := Real.add_one_le_exp (-u)
        have h3 : Real.exp (-u) * Real.exp u = 1 := by rw [← Real.exp_add]; simp
        have h4 := mul_le_mul_of_nonneg_right h2 (Real.exp_pos u).le
        rw [abs_of_nonneg (by linarith), abs_of_nonneg hu]
        nlinarith
      · have h1 := Real.add_one_le_exp u
        have h2 : Real.exp u ≤ 1 := Real.exp_le_one_iff.mpr hu.le
        have h3 : 1 ≤ Real.exp (-u) := Real.one_le_exp (by linarith)
        rw [abs_of_nonpos (by linarith : Real.exp u - 1 ≤ 0), abs_of_neg hu]
        nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ -u) (by linarith : (0:ℝ) ≤ Real.exp (-u) - 1)]
    have hK := key (-E)
    rw [abs_neg] at hK
    have hK2 : |Real.exp (-E) - 1| ≤ B * d * Real.exp B :=
      le_trans hK (mul_le_mul hE hexpB (Real.exp_pos _).le (by positivity))
    have hexpE : Real.exp (-E) ≤ Real.exp B := Real.exp_le_exp.mpr (by linarith [neg_le_abs E])
    have hexpE' : Real.exp (-B) ≤ Real.exp (-E) := Real.exp_le_exp.mpr (by linarith [le_abs_self E])
    refine ⟨?_, ?_, ?_⟩
    · have : 1 / (B * Real.exp B) = (1 / B) * Real.exp (-B) := by rw [Real.exp_neg]; field_simp
      rw [this]; exact mul_le_mul hf1 hexpE' (Real.exp_pos _).le hf0.le
    · have : f * Real.exp (-E) - f = f * (Real.exp (-E) - 1) := by ring
      rw [this, abs_mul, abs_of_pos hf0]
      calc f * |Real.exp (-E) - 1| ≤ B * (B * d * Real.exp B) := mul_le_mul hf2 hK2 (abs_nonneg _) hB0.le
        _ = B ^ 2 * Real.exp B * d := by ring
    · have : (fe * Real.exp (-E) + f * (Real.exp (-E) * -Ee)) - fe = fe * (Real.exp (-E) - 1) - f * Real.exp (-E) * Ee := by ring
      rw [this]
      have t1 : |fe * (Real.exp (-E) - 1)| ≤ B * (B * d * Real.exp B) := by
        rw [abs_mul]; exact mul_le_mul hfe hK2 (abs_nonneg _) hB0.le
      have t2 : |f * Real.exp (-E) * Ee| ≤ B * Real.exp B * (B * d) := by
        rw [abs_mul, abs_mul, abs_of_pos hf0, abs_of_pos (Real.exp_pos _)]
        exact mul_le_mul (mul_le_mul hf2 hexpE (Real.exp_pos _).le hB0.le) hEe (abs_nonneg _) (by positivity)
      obtain ⟨a1, a2⟩ := abs_le.mp t1
