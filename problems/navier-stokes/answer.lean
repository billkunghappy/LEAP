      ⟨fun j X w => ∫ t in (0:ℝ)..1, ((kk t * t ^ j : ℝ) : ℂ) * rc j (t * X) w,
        fun _ _ _ => rfl⟩
    have hIf : ∀ j, (fun p : ℝ × ℂ => I j p.1 p.2) =
        fun p => ∫ t in (0:ℝ)..1, ((kk t * t ^ j : ℝ) : ℂ) * rc j (t * p.1) p.2 :=
      fun j => funext fun p => hI j p.1 p.2
    have hlev2 : ∀ j : ℕ,
        ContinuousOn (fun p : ℝ × ℂ => I j p.1 p.2) (Ioo 0 Xi ×ˢ cStrip (ρ j)) ∧
        ∀ X w, 0 < X → X < Xi → w ∈ cStrip (ρ j) →
          ‖I j X w‖ ≤ (∫ t in (0:ℝ)..1, |kk t * t ^ j|) * |C j| := by
