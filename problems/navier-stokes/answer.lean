  have hε5 : ε ≤ Pst ^ 2 / (2000000 * A * N) := by
    rw [hεd]; exact (min_le_right _ _).trans ((min_le_right _ _).trans (min_le_right _ _))
  have e2 : K1 * ε ≤ δ / 2 := by
    have := (le_div_iff₀ (by positivity : (0:ℝ) < 2 * K1)).mp hε2
    linarith
  have e3 : ε * (100 * A) ≤ 1 := (le_div_iff₀ (by positivity)).mp hε3
  have e4 : ε * (3000 * A) ≤ Pst := (le_div_iff₀ (by positivity)).mp hε4
  have e5 : ε * (2000000 * A * N) ≤ Pst ^ 2 := (le_div_iff₀ (by positivity)).mp hε5
  have hθ0 : 0 ≤ K2 * (K1 * ε) := by positivity
  have hεKs : 0 ≤ ε * Ks := by positivity
  have g1 : ε + 2 * (K2 * (K1 * ε)) * Kb ≤ 1 / 50 := by
    rw [hAd] at e3; nlinarith
  have g2 : 3 * (K2 * (K1 * ε)) * Kb ≤ Pst / 1000 := by
    rw [hAd] at e4; nlinarith
  have g3 : (Ks * ε + 2 * (K2 * (K1 * ε)) * Kb) * (200 + 4 * MP + 30 * Pst ^ 2) * 1000000 ≤ Pst ^ 2 := by
    rw [← hNd]
    have hX : Ks * ε + 2 * (K2 * (K1 * ε)) * Kb ≤ 2 * (ε * A) := by
