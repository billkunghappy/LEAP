      _ = 162 * (Ha.card : ℝ) * K * qC B.h ξ ^ (B.h * (α + β)) * SC B.h ξ ^ Bt *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-Dt) := by
          rw [hM]; ring

theorem shell_deriv_vanish_v5 : ∀ (B : BG) (qs : ℝ) (f : Cyl → ℝ), B.ok → ContDiffOn ℝ ∞ f (DomC B.h qs) → (∀ ξ ∈ DomC B.h qs, (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → f ξ = 0) → ∀ (k : ℕ), ∀ ξ ∈ DomC B.h qs, (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → iteratedFDeriv ℝ k f ξ = 0 :=
by
  intro B qs f hok hf hz k ξ hξ hX
  have hS := hok.1
  have hT : IsOpen {ξ : Cyl | ξ.2.2.1 < 1} :=
    isOpen_lt continuous_snd.snd.fst continuous_const
  have hπq : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
    contDiff_snd.fst.prodMk (contDiff_const.sub contDiff_snd.snd.fst)
  have hqC : ContDiffOn ℝ ∞ (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have h4 := hS.2.2.2.1
    have hc := h4.comp hπq.contDiffOn (fun ξ (hξ : ξ.2.2.1 < 1) =>
      (⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩ : (ξ.2.1, 1 - ξ.2.2.1) ∈ univ ×ˢ Ioi (0:ℝ)))
    exact hc
  have hDopen : IsOpen (DomC B.h qs) := by
    have h1 : IsOpen {ξ : Cyl | 0 < ξ.1} := isOpen_lt continuous_const continuous_fst
    have h2 := hqC.continuousOn.isOpen_inter_preimage hT (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Iio qs) := by
      ext ξ; exact Iff.rfl
    rw [e]; exact h1.inter h2
  have hqpos : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ := by
    intro ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    exact (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have hqCD : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h qs) :=
    hqC.mono (fun ξ (hξ : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs) => hξ.2.1)
  have hXC : ContinuousOn (XC B.h) (DomC B.h qs) := by
    have hnum : ContinuousOn (fun ξ : Cyl => ξ.1 ^ 2) (DomC B.h qs) :=
      (continuous_fst.pow 2).continuousOn
    have hden : ContinuousOn (fun ξ : Cyl => 2 * qC B.h ξ) (DomC B.h qs) :=
      continuousOn_const.mul hqCD.continuousOn
    have h := hnum.div hden (fun ξ hξ => by have := hqpos ξ hξ; positivity)
    exact h.congr (fun ξ _ => rfl)

  have hint : ∀ η ∈ DomC B.h qs, (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) →
      iteratedFDeriv ℝ k f η = 0 := by
    intro η hη hXη
    have hO : IsOpen (DomC B.h qs ∩ XC B.h ⁻¹' (Iio B.Xa ∪ Ioi B.Xb)) :=
      hXC.isOpen_inter_preimage hDopen (isOpen_Iio.union isOpen_Ioi)
    have hηO : η ∈ DomC B.h qs ∩ XC B.h ⁻¹' (Iio B.Xa ∪ Ioi B.Xb) := ⟨hη, hXη⟩
    have hev : f =ᶠ[nhds η] (fun _ => (0:ℝ)) :=
      Filter.eventuallyEq_of_mem (hO.mem_nhds hηO) (fun ζ hζ => hz ζ hζ.1 (by
        rcases hζ.2 with h | h
        · exact Or.inl (le_of_lt h)
        · exact Or.inr (le_of_lt h)))
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_zero]
    rfl

  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
  have hq : 0 < qC B.h ξ := hqpos ξ hξ
  have h2q : 0 < 2 * qC B.h ξ := by linarith
  have hcont : ContinuousAt (iteratedFDeriv ℝ k f) ξ :=
    ((hf.contDiffAt (hDopen.mem_nhds hξ)).iteratedFDeriv_right (m := 0) (by simp)).continuousAt
  let c : ℝ → Cyl := fun s => (s, ξ.2)
  have hc : Continuous c := continuous_id.prodMk continuous_const
  have hcD : ∀ s : ℝ, 0 < s → c s ∈ DomC B.h qs := fun s hs =>
    (⟨hs, hξ'.2.1, hξ'.2.2⟩ : 0 < (c s).1 ∧ (c s).2.2.1 < 1 ∧ qC B.h (c s) < qs)
  have hXc : ∀ s : ℝ, XC B.h (c s) = s ^ 2 / (2 * qC B.h ξ) := fun s => rfl
  have hXξ : XC B.h ξ = ξ.1 ^ 2 / (2 * qC B.h ξ) := rfl
  have hTc : Filter.Tendsto (fun s => iteratedFDeriv ℝ k f (c s)) (nhds ξ.1)
      (nhds (iteratedFDeriv ℝ k f ξ)) :=
    (ContinuousAt.comp (x := ξ.1) (f := c) hcont hc.continuousAt).tendsto
  rcases hX with hX | hX
  · have hev : ∀ᶠ s in nhdsWithin ξ.1 (Iio ξ.1), iteratedFDeriv ℝ k f (c s) = 0 := by
      filter_upwards [Ioo_mem_nhdsLT hξ'.1] with s hs
      apply hint (c s) (hcD s hs.1)
      left
      have h1 : s ^ 2 < ξ.1 ^ 2 := by nlinarith [hs.1, hs.2]
      have h2 : s ^ 2 / (2 * qC B.h ξ) < ξ.1 ^ 2 / (2 * qC B.h ξ) :=
        div_lt_div_of_pos_right h1 h2q
      rw [hXc]
      rw [hXξ] at hX
      linarith
    have T1 := hTc.mono_left (nhdsWithin_le_nhds (s := Iio ξ.1))
    have T2 : Filter.Tendsto (fun s => iteratedFDeriv ℝ k f (c s)) (nhdsWithin ξ.1 (Iio ξ.1))
        (nhds 0) :=
      tendsto_const_nhds.congr' (hev.mono fun s hs => hs.symm)
    exact tendsto_nhds_unique T1 T2
  · have hev : ∀ᶠ s in nhdsWithin ξ.1 (Ioi ξ.1), iteratedFDeriv ℝ k f (c s) = 0 := by
      filter_upwards [self_mem_nhdsWithin] with s hs
      have hs' : ξ.1 < s := hs
      apply hint (c s) (hcD s (lt_trans hξ'.1 hs'))
      right
      have h1 : ξ.1 ^ 2 < s ^ 2 := by nlinarith [hξ'.1, hs']
      have h2 : ξ.1 ^ 2 / (2 * qC B.h ξ) < s ^ 2 / (2 * qC B.h ξ) :=
        div_lt_div_of_pos_right h1 h2q
      rw [hXc]
      rw [hXξ] at hX
      linarith
    have T1 := hTc.mono_left (nhdsWithin_le_nhds (s := Ioi ξ.1))
    have T2 : Filter.Tendsto (fun s => iteratedFDeriv ℝ k f (c s)) (nhdsWithin ξ.1 (Ioi ξ.1))
        (nhds 0) :=
      tendsto_const_nhds.congr' (hev.mono fun s hs => hs.symm)
    exact tendsto_nhds_unique T1 T2

theorem dR_coarse_frame_bound_v5 : ∀ (B : BG) (qs : ℝ), B.ok → 0 < qs → qs ≤ 1 → ∀ (F : Cyl → ℝ), ContDiffOn ℝ ∞ F (DomC B.h qs) → ∀ k : ℕ, ∃ M : ℝ, 0 ≤ M ∧ ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → Real.sqrt (qC B.h ξ) * NB B.h (dR B.h F) k ξ ≤ M * qC B.h ξ ^ (-(B.h * kapS)) * ∑ i ∈ Finset.range (k + 2), NB B.h F i ξ :=
by
  intro B qs hok hqs0 hqs1 F hF k
  have hh : 0 < B.h := hok.2.1.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hΩo : IsOpen (DomC B.h qs) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio qs := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hqpos : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ := fun ξ hξ =>
    (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).1

  have hJ : ∀ (n : ℤ) (t : ℝ), JpowL n (t • vrv) = (Lgc ^ n * t) • vrv := by
    intro n t
    have hD : (1 + bgc ^ 2) ≠ 0 := by positivity
    simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
      ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Jpow, vrv, vtv]
    refine Prod.ext ?_ ?_
    · simp only [Prod.smul_fst, Prod.smul_snd, Prod.fst_add, smul_eq_mul]
      field_simp
      ring
    · simp only [Prod.smul_fst, Prod.smul_snd, Prod.snd_add, smul_eq_mul]
      field_simp
      ring

  have hcoarse : ∀ h q : ℝ, 0 ≤ h → 0 < q → q ≤ 1 →
      Lgc ^ (coarseIdx h q) ≤ q ^ (-(drx h / 2 + h * kapS)) := by
    intro h q hh q0 hq1
    have hs2a : (1:ℝ) ≤ Real.sqrt 2 := by
      have := Real.sqrt_le_sqrt (show (1:ℝ) ≤ 2 by norm_num)
      rwa [Real.sqrt_one] at this
    have hs2b : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
    have hL1 : 1 < Lgc := by unfold Lgc; linarith
    have hT1 : 1 < Tgc := by unfold Tgc; linarith
    have hL0 : 0 < Lgc := by linarith
    have hLl : 0 < Real.log Lgc := Real.log_pos hL1
    have hTl : 0 < Real.log Tgc := Real.log_pos hT1
    have hl2 : 0 < Real.log 2 := Real.log_pos one_lt_two
    obtain ⟨x, hxdef⟩ : ∃ x : ℝ, x = Real.logb 2 (1 / q) := ⟨_, rfl⟩
    have hx0 : 0 ≤ x := by
      rw [hxdef]; exact Real.logb_nonneg one_lt_two (one_le_one_div q0 hq1)
    have hx : x * Real.log 2 = -Real.log q := by
      rw [hxdef, Real.logb, div_mul_cancel₀ _ hl2.ne', one_div, Real.log_inv]
    have hb : bandOf q = ⌈x⌉₊ := by rw [hxdef]; rfl
