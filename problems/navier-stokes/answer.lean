  have hmc : ∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 S a) (DomC B.h (qsOf l0)) := by
    intro a
    fin_cases a
    · exact (g_regular_of_nrm_InM_v5 B _ _ _ _ hok c21).1
    · exact (g_regular_of_nrm_InM_v5 B _ _ _ _ hok c18).1
    · exact (g_regular_of_nrm_InM_v5 B _ _ _ _ hok c19).1

  have hrep := h1 l0 (by omega) S D 1 (β + 1/2) c1 ha hD c3 c4
  obtain ⟨hT, hQ⟩ := h2 l0 (by omega) S D (cr5Vel B G S.Aw) (cr5Vel B G D) H
    (fun γ m => ⟨hVoS γ m, hVnS γ m⟩)
    (fun γ m hm => ⟨hVel0 S.Aw γ m (hHa γ m (hHmem m hm).2.2.1),
      hVel0 D γ m (hHa' γ m (hHmem m hm).2.2.2)⟩)
    (fun γ m ξ hξ => ⟨hVoSupp γ m ξ hξ, hVnSupp γ m ξ hξ⟩)
    (fun γ γ' m m' hne ξ hξ => by
      constructor
      · intro h
        have := hdisj γ γ' (2 * m) (2 * m' + 1) hne ξ hξ (by rw [e1]; exact h)
        rwa [e2] at this
      · intro h
        have := hdisj γ γ' (2 * m + 1) (2 * m') hne ξ hξ (by rw [e2]; exact h)
        rwa [e1] at this)
    hmc hrep

  have hTr0 : ∀ (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (ξ : Cyl), pq5TrM B.h n 0 c ξ = 0 := by
    intro n c ξ
    funext i
    fin_cases i <;> simp [pq5TrM]
  have hTr0' : ∀ (n : ℤ) (U : Fin 3 → ℂ) (ξ : Cyl), pq5TrM B.h n U (fun _ => 0) ξ = 0 := by
    intro n U ξ
    funext i
    fin_cases i <;> simp [pq5TrM, dR, dZ]
  have hMWz : ∀ γ M, cr5Vel B G D γ M = 0 → ∀ ξ, cr5MW B G l0 S (cr5Vel B G D) γ M ξ = 0 := by
    intro γ M h ξ
    have hc : modeCoef5 B G (cr5Vel B G D) γ M = fun _ => 0 := by
      funext η i
      simp [modeCoef5, h]
    simp only [cr5MW, hc]
    rw [hTr0', hTr0, add_zero, smul_zero]
  have hMW0 : ∀ γ ξ, cr5MW B G l0 S (cr5Vel B G D) γ 0 ξ = 0 :=
    fun γ ξ => hMWz γ 0 (hVel0 D γ 0 (hHa' γ 0 h0a')) ξ
  obtain ⟨HQ, hHQ⟩ : ∃ HQ : Finset ℤ,
      HQ = Finset.image₂ (fun a b => a + b) H H ∪ Finset.image₂ (fun a b => b - a) H H ∪ H := ⟨_, rfl⟩
  have hWWz : ∀ (V1 V2 : WC) γ M, M ∉ HQ → ∀ ξ, cr5WW B G H V1 V2 γ M ξ = 0 := by
    intro V1 V2 γ M hM ξ
    unfold cr5WW
    rw [Finset.sum_eq_zero, smul_zero]
    intro m hm
    apply Finset.sum_eq_zero
    intro m' hm'
    have n1 : ¬ (m + m' = M) := by
      intro h
      apply hM
      rw [hHQ, ← h]
      exact Finset.mem_union_left _ (Finset.mem_union_left _
        (Finset.mem_image₂_of_mem (f := fun a b => a + b) hm hm'))
    have n2 : ¬ (m' - m = M) := by
      intro h
      apply hM
      rw [hHQ, ← h]
      exact Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_image₂_of_mem (f := fun a b => b - a) hm hm'))
    rw [if_neg n1, if_neg n2, add_zero]
  have hQH : ∀ γ M, M ∉ HQ → cr5Q B G l0 S H (cr5Vel B G S.Aw) (cr5Vel B G D) γ M = 0 := by
    intro γ M hM
    have hMH : M ∉ H := fun h => hM (by rw [hHQ]; exact Finset.mem_union_right _ h)
    funext ξ
    simp only [cr5Q, Pi.add_apply, Pi.zero_apply]
    rw [hWWz _ _ γ M hM ξ, hWWz _ _ γ M hM ξ,
      hMWz γ M (hVel0 D γ M (hHa' γ M (hHmem M hMH).2.2.2)) ξ, add_zero, add_zero]

  have hosc := cr5_osc_split B G l0 (sw5Cr B G l0 S D) (cr5Q B G l0 S H (cr5Vel B G S.Aw) (cr5Vel B G D))
    (2 * Aex B.h + 1/2) HQ hok hQH hT hQ

  have hWW := h6 l0 (by omega) S bw ca cm cd β D H hSt hD hvD
    (fun γ m hm => ⟨hHs γ m (hHmem m hm).1, hHd γ m (hHmem m hm).2.1⟩)
  have hMW := h5 l0 (by omega) S bw ca cm cd β D hSt hD hvD
  obtain ⟨hcls, -⟩ := pwr5_waveV_add B G hok (qsOf l0) hq1 _ _ _ _ hWW hMW
  have hmin : min (β + 1/2 - kapS) (β + 2/5) = β + 2/5 := min_eq_right (by rw [hk]; linarith)
  rw [hmin] at hcls
  have hgeq : cr5Osc (cr5Q B G l0 S H (cr5Vel B G S.Aw) (cr5Vel B G D)) =
      cr5Osc (cr5WW B G H (cr5Vel B G S.Aw) (cr5Vel B G D) + cr5WW B G H (cr5Vel B G D) (cr5Vel B G S.Aw))
        + cr5MW B G l0 S (cr5Vel B G D) := by
    funext γ M ξ
    simp only [cr5Osc, cr5Q, Pi.add_apply]
    split_ifs with hM
    · subst hM
