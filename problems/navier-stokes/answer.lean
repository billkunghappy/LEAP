        push_neg at h0
        have h1 : x * Λ / 4 ≤ X * Λ / 4 := by
          have := mul_le_mul_of_nonneg_right hx hΛ0.le
          linarith
        unfold axLogY
        calc Real.log (x * Λ / 4) ≤ Real.log (X * Λ / 4) := Real.log_le_log (by positivity) h1
