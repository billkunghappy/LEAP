          rw [hR]
          exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 (by nlinarith [ht.2])) (norm_nonneg _)
    refine ⟨α, hα0', fun t ht => ?_⟩
    have e : f t (α t) = (A t).mulVec (α t) := by
      rw [hf]; simp only
      rw [hpid t ht, hP3 _ (hbound t ht)]
    rw [← e]
    exact hαd t ht

  have s2 : ∀ (A1 A2 : ℝ → Matrix (Fin 3) (Fin 3) ℝ) (M δ Y : ℝ) (x y : ℝ → (Fin 3 → ℝ)),
      1 ≤ M → 0 ≤ δ → 0 ≤ Y →
      (∀ t ∈ Set.Icc w L, ‖(fun i j : Fin 3 => A1 t i j)‖ ≤ M) →
      (∀ t ∈ Set.Icc w L, dist (fun i j : Fin 3 => A1 t i j) (fun i j : Fin 3 => A2 t i j) ≤ δ) →
      (∀ t ∈ Set.Icc w L, ‖y t‖ ≤ Y) →
      (∀ t ∈ Set.Icc w L, HasDerivAt x ((A1 t).mulVec (x t)) t) →
      (∀ t ∈ Set.Icc w L, HasDerivAt y ((A2 t).mulVec (y t)) t) →
