  have hzc : ContDiff ℝ ∞ (fun p : (Fin 5 → ℝ) × ℝ => zf p.1 p.2) := by
    rw [hzf]
    refine contDiff_pi.2 (fun i => ?_)
    rcases hF5 i with rfl | rfl | rfl | rfl | rfl
    all_goals simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons]
    all_goals fun_prop
  have hzb : ∀ d η, -2 < η → η < 2 → ‖zf d η‖ ≤ K * ‖d‖ := by
    intro d η h1 h2
    obtain ⟨κ, hκ⟩ : ∃ t : ℝ, t = (1 + η ^ 2) / cpatch := ⟨_, rfl⟩
    have hκ0 : 0 ≤ κ := by rw [hκ]; exact div_nonneg (by positivity) hcp.le
    have hκ1 : κ ≤ κm := by
      rw [hκ, hκm]; exact div_le_div_of_nonneg_right (by nlinarith) hcp.le
    have hD := norm_nonneg d
    have hd : ∀ i, |d i| ≤ ‖d‖ := fun i => by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm d i
