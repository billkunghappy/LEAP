    have : 1 * |x 0| ≤ 2 * M * |x 0| :=
      mul_le_mul_of_nonneg_right (show (1:ℝ) ≤ 2 * M by linarith) hx0a
    linarith
  have hab_b : |b| ≤ X1 := by
    have e := abs_add_le (N1 * x 1) (N2 * x 2)
    have f1 := hab N1 (x 1) _ hN1abs
    have f2 := hab N2 (x 2) _ hN2abs
