theorem power_head_integral : ∀ c h X : ℝ, 0 < h → h < 1 → 0 ≤ X → IntervalIntegrable (fun x => Real.sqrt (2 * x) * c * x ^ (-(1 / 2 + h))) volume 0 X ∧ (∫ x in (0:ℝ)..X, Real.sqrt (2 * x) * c * x ^ (-(1 / 2 + h))) = Real.sqrt 2 * c * X ^ (1 - h) / (1 - h) :=
