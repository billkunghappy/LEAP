    have j123 : Integrable (fun y => e ^ 2 * (Real.exp y * rfpK P.Md y ^ 2)
        + (((1 + e ^ 2)⁻¹) ^ 2 * P.Amp e ^ 2) *
            (Real.exp (y + 2 * rfpLam P y) * rfpR0 (P.lam * (y - rfpY3 P.Md P.lam)) ^ 2)
        + (((1 + e ^ 2)⁻¹) ^ 2 * P.c1 e ^ 2) *
