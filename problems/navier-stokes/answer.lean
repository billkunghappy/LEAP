    have r3 : A / (c * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) =
        CP / c * (SC B.h ξ ^ bP * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dP)) := by
      rw [hAdef]; exact r3gen _ _ _ _ hζ.ne'
    have hM1 : 1 ≤ SC B.h ξ ^ bP * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dP) := by
      have hbP0 : 0 ≤ bP := by rw [hbP]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
      have hdP0 : 0 ≤ dP := by rw [hdP]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
