    have := (abs_le.mp hH1).1
    have hk : h * h ≤ h / 100 := by nlinarith
    have hkZ : h * (1 + h) * (2 * (1 - η ^ 2) / X) ≤ h * (1 + h) * (1 / 8) :=
      mul_le_mul_of_nonneg_left hZ8 (mul_pos hh0 (by linarith)).le
    nlinarith
  have hHpos : 0 < heatProfile h (2 * (1 - η ^ 2) / X) := by linarith
  obtain ⟨dH, hdH, hdHb⟩ := hheat _ hZ0
  obtain ⟨ds, hds, hdsb⟩ := dsig _ hy1

  have hform : ∀ Y : ℝ, 0 < Y →
      Real.sqrt (2 * Y) * F Y η =
        cinf * Y ^ (-(1 / 2 + h)) * heatProfile h (2 * (1 - η ^ 2) / Y) * tailFac ρ Xb Y →
      F Y η = cinf / Real.sqrt 2 *
        (Y ^ (-h) / Y * heatProfile h (2 * (1 - η ^ 2) / Y) * tailFac ρ Xb Y) := by
    intro Y hY hE
    have hs : 0 < Real.sqrt Y := Real.sqrt_pos.mpr hY
    have hss : Real.sqrt Y * Real.sqrt Y = Y := Real.mul_self_sqrt hY.le
    have h2 : 0 < Real.sqrt 2 := by positivity
    have hsq2 : Real.sqrt (2 * Y) = Real.sqrt 2 * Real.sqrt Y := Real.sqrt_mul (by norm_num) Y
    have hrp : Y ^ (-(1 / 2 + h)) = Y ^ (-h) / Real.sqrt Y := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_sub hY]
      congr 1
      ring
    rw [hsq2, hrp] at hE
    have key : F Y η * (Real.sqrt 2 * Real.sqrt Y) =
        cinf * (Y ^ (-h) / Real.sqrt Y) * heatProfile h (2 * (1 - η ^ 2) / Y) * tailFac ρ Xb Y := by
      rw [← hE]; ring
    have hF := eq_div_of_mul_eq (mul_pos h2 hs).ne' key
    have hYd : Y ^ (-h) / Y = Y ^ (-h) / (Real.sqrt Y * Real.sqrt Y) := by rw [hss]
    rw [hF, hYd]
    field_simp
  have hTd : HasDerivAt (fun Y => tailFac ρ Xb Y) (ρ * ds / (2 * X)) X := by
    have hdiv : HasDerivAt (fun Y => Y / Xb) (1 / Xb) X := (hasDerivAt_id' X).div_const Xb
    have hlog := hdiv.log (div_pos hX0 hXb0).ne'
    have hu := (hlog.add_const 2).div_const 2
    have hc := (((hds.comp X hu).const_sub 1).const_mul ρ).const_sub 1
    unfold tailFac
    refine hc.congr_deriv ?_
    field_simp
  have hp : HasDerivAt (fun Y => Y ^ (-h)) (-h * X ^ (-h - 1)) X :=
    Real.hasDerivAt_rpow_const (Or.inl hXne)
  have hq := hp.div (hasDerivAt_id' X) hXne
  have hav := (hasDerivAt_const X (2 * (1 - η ^ 2))).div (hasDerivAt_id' X) hXne
  have hH := hdH.comp X hav
  have hG := ((hq.mul hH).mul hTd).const_mul (cinf / Real.sqrt 2)
  have hev : (fun Y => F Y η) =ᶠ[nhds X] (fun Y => cinf / Real.sqrt 2 *
      (Y ^ (-h) / Y * heatProfile h (2 * (1 - η ^ 2) / Y) * tailFac ρ Xb Y)) := by
    filter_upwards [Ioi_mem_nhds hXt] with Y hY
    have hY0 : 0 < Y := lt_trans (mul_pos hXb0 (Real.exp_pos _)) hY
    exact hform Y hY0 (htail Y η (le_of_lt hY) hη1 hη2).2.2
  have hFd := hG.congr_of_eventuallyEq hev
  have hFX := hform X hX0 (htail X η hXt.le hη1 hη2).2.2
  have hs2ne : Real.sqrt 2 ≠ 0 := (Real.sqrt_pos.mpr two_pos).ne'
  have hcne : cinf ≠ 0 := hc0.ne'
  have hP0 : 0 < X ^ (-h) := Real.rpow_pos_of_pos hX0 _
  have hPne : X ^ (-h) ≠ 0 := hP0.ne'
  have hHne := hHpos.ne'
  have hfne := hfpos.ne'

  have hSA : shearA F X η = 2 * (1 + h) + 2 * (2 * (1 - η ^ 2) / X) * dH /
      heatProfile h (2 * (1 - η ^ 2) / X) - ρ * ds / tailFac ρ Xb X := by
    unfold shearA
    rw [hFd.deriv, hFX]
    simp only [Function.comp_apply, Pi.div_apply, Pi.mul_apply]
    rw [Real.rpow_sub_one hXne]
    generalize heatProfile h (2 * (1 - η ^ 2) / X) = Hv at hHne ⊢
    generalize tailFac ρ Xb X = fv at hfne ⊢
    generalize X ^ (-h) = P at hPne ⊢
    field_simp
    ring

  have hU : deriv (fun Y => U Y η) X = 0 := by
    have hevU : (fun Y => U Y η) =ᶠ[nhds X] (fun _ => (0:ℝ)) := by
      filter_upwards [Ioi_mem_nhds hXt] with Y hY
      exact (htail Y η hY.le hη1 hη2).1
    rw [hevU.deriv_eq]
    simp
  have hshB : shearB F U X η = 0 := by
    unfold shearB
    rw [hU]
    simp

  have hFlow : Real.sqrt 2 * cinf * Xb ^ (-h) / (8 * Xb) ≤ F X η := by
    rw [hFX]
    have hs2 : Real.sqrt 2 * Real.sqrt 2 = 2 := Real.mul_self_sqrt (by norm_num)
    have hc : cinf / Real.sqrt 2 = Real.sqrt 2 * cinf / 2 := by
      rw [div_eq_iff hs2ne]
      linear_combination (-cinf / 2) * hs2
    have hpow : Xb ^ (-h) ≤ X ^ (-h) := Real.rpow_le_rpow_of_nonpos hX0 hX2.le (by linarith)
    have hQ : Xb ^ (-h) / Xb ≤ X ^ (-h) / X := by
      rw [div_le_div_iff₀ hXb0 hX0]
      nlinarith [mul_le_mul_of_nonneg_right hpow hX0.le, mul_le_mul_of_nonneg_left hX2.le hP0.le]
    have hHf : 99 / 100 * (99 / 100) ≤ heatProfile h (2 * (1 - η ^ 2) / X) * tailFac ρ Xb X :=
      mul_le_mul hHlow (by linarith [hf1.1]) (by norm_num) hHpos.le
    have hQ0 : 0 < X ^ (-h) / X := div_pos hP0 hX0
    have e : Real.sqrt 2 * cinf * Xb ^ (-h) / (8 * Xb) =
        (Real.sqrt 2 * cinf / 2) * (Xb ^ (-h) / Xb / 4) := by ring
    rw [e, hc]
    refine mul_le_mul_of_nonneg_left ?_ (div_pos (mul_pos (Real.sqrt_pos.mpr two_pos) hc0) two_pos).le
    have : X ^ (-h) / X * (99 / 100 * (99 / 100)) ≤
        X ^ (-h) / X * (heatProfile h (2 * (1 - η ^ 2) / X) * tailFac ρ Xb X) :=
      mul_le_mul_of_nonneg_left hHf hQ0.le
    nlinarith
  obtain ⟨hA1, hA2⟩ := alg _ _ dH _ ds hZ0 hZ8 hH1 hdHb hf1.1 hdsb
  rw [hSA]
  exact ⟨hA1, hA2, hshB, hFlow⟩

theorem collar_ratio_bound : ∀ (h cinf ρ Xb X η M : ℝ), 0 < h → h < 1 / 100 → 0 < cinf → 0 ≤ ρ → ρ ≤ 1 / 2 → 0 < X → X < Xb → -1 < η → η < 1 → (∀ s : ℝ, X ≤ s → s < Xb → tailEh h cinf s η ≤ M) → 0 ≤ collarTth h cinf ρ Xb X η ∧ |collarTz h cinf ρ Xb X η| ≤ 2 * M * collarTth h cinf ρ Xb X η :=
by
  intro h cinf ρ Xb X η M hh0 hh1 hc0 hρ0 hρ1 hX0 hXXb hη1 hη2 hM
  have hXb0 : 0 < Xb := by linarith
  have hd : 0 < 1 - η ^ 2 := by nlinarith
  have hL : 0 < 1 - 2 * h * η ^ 2 := by nlinarith



  have hsigB : ∀ y : ℝ, 0 ≤ sigA y ∧ sigA y ≤ 1 := by
    intro y
    unfold sigA
    split_ifs with h1 h2
    · exact ⟨le_refl 0, zero_le_one⟩
    · exact ⟨zero_le_one, le_refl 1⟩
    · have ha := Real.exp_pos (-1 / y ^ 2)
      have hb := Real.exp_pos (-1 / (1 - y) ^ 2)
      refine ⟨div_nonneg ha.le (by positivity), ?_⟩
      rw [div_le_one (by positivity)]
      linarith
  have hsigM : Monotone sigA := by
    intro y₁ y₂ hy
    by_cases h1 : y₁ ≤ 0
    · have : sigA y₁ = 0 := by unfold sigA; rw [if_pos h1]
      rw [this]; exact (hsigB y₂).1
    by_cases h2 : 1 ≤ y₂
    · have : sigA y₂ = 1 := by
        unfold sigA; rw [if_neg (by linarith), if_pos h2]
      rw [this]; exact (hsigB y₁).2
    have h1l : 0 < y₁ := lt_of_not_ge h1
    have h2l : y₂ < 1 := lt_of_not_ge h2
    have h1' : ¬ (1 ≤ y₁) := by intro h; linarith
    have h2' : ¬ (y₂ ≤ 0) := by intro h; linarith
    unfold sigA
    rw [if_neg h1, if_neg h1', if_neg h2', if_neg h2]
    have ha : Real.exp (-1 / y₁ ^ 2) ≤ Real.exp (-1 / y₂ ^ 2) := by
      apply Real.exp_le_exp.mpr
      have hsq : y₁ ^ 2 ≤ y₂ ^ 2 := pow_le_pow_left₀ h1l.le hy 2
      have : 1 / y₂ ^ 2 ≤ 1 / y₁ ^ 2 := one_div_le_one_div_of_le (by positivity) hsq
      rw [neg_div, neg_div]
      linarith
    have hb' : Real.exp (-1 / (1 - y₂) ^ 2) ≤ Real.exp (-1 / (1 - y₁) ^ 2) := by
      apply Real.exp_le_exp.mpr
      have hsq : (1 - y₂) ^ 2 ≤ (1 - y₁) ^ 2 := pow_le_pow_left₀ (by linarith) (by linarith) 2
      have hpos : 0 < (1 - y₂) ^ 2 := by
        have : 0 < 1 - y₂ := by linarith
        positivity
      have : 1 / (1 - y₁) ^ 2 ≤ 1 / (1 - y₂) ^ 2 := one_div_le_one_div_of_le hpos hsq
      rw [neg_div, neg_div]
      linarith
    have pa1 := Real.exp_pos (-1 / y₁ ^ 2)
    have pa2 := Real.exp_pos (-1 / y₂ ^ 2)
    have pb1 := Real.exp_pos (-1 / (1 - y₁) ^ 2)
    have pb2 := Real.exp_pos (-1 / (1 - y₂) ^ 2)
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    nlinarith [mul_le_mul ha hb' pb2.le pa2.le]



  have hfM : MonotoneOn (tailFac ρ Xb) (Ioi 0) := by
    intro x hx y hy hxy
    have hx' : (0:ℝ) < x := hx
    have hlog : Real.log (x / Xb) ≤ Real.log (y / Xb) :=
      Real.log_le_log (div_pos hx' hXb0) (div_le_div_of_nonneg_right hxy hXb0.le)
    have hs := hsigM (show (Real.log (x / Xb) + 2) / 2 ≤ (Real.log (y / Xb) + 2) / 2 by linarith)
    unfold tailFac
    nlinarith [mul_le_mul_of_nonneg_left hs hρ0]
  have hfB : ∀ x : ℝ, 0 < x →
      0 ≤ deriv (tailFac ρ Xb) x ∧ 0 ≤ tailFac ρ Xb x ∧ tailFac ρ Xb x ≤ 1 := by
    intro x hx
    refine ⟨?_, ?_, ?_⟩
    · rw [← derivWithin_of_isOpen isOpen_Ioi hx]
      exact hfM.derivWithin_nonneg
    · have := hsigB ((Real.log (x / Xb) + 2) / 2)
      unfold tailFac
      nlinarith [mul_le_mul_of_nonneg_left this.2 hρ0]
    · have := hsigB ((Real.log (x / Xb) + 2) / 2)
      unfold tailFac
      nlinarith [mul_nonneg hρ0 (sub_nonneg.mpr this.2)]
  have hfI : IntervalIntegrable (deriv (tailFac ρ Xb)) volume X Xb := by
    apply MonotoneOn.intervalIntegrable_deriv
    apply hfM.mono
    intro z hz
    rw [uIcc_of_le hXXb.le] at hz
    exact lt_of_lt_of_le hX0 hz.1



  have hΓ : 0 < Real.Gamma (1 + h) := Real.Gamma_pos_of_pos (by linarith)
  have hHP : ∀ Z : ℝ, 0 < Z → 0 ≤ heatProfile h Z := by
    intro Z hZ
    unfold heatProfile
    apply mul_nonneg (inv_nonneg.mpr hΓ.le)
    apply setIntegral_nonneg measurableSet_Ioi
    intro v hv
    have hv' : (0:ℝ) < v := hv
    exact mul_nonneg (mul_nonneg (Real.exp_pos _).le (Real.rpow_nonneg hv'.le _))
      (Real.rpow_nonneg (add_pos one_pos (mul_pos hZ hv')).le _)
  have hZpos : ∀ y : ℝ, 0 < y → 0 < 2 * (1 - η ^ 2) / y := fun y hy => div_pos (mul_pos two_pos hd) hy
  have hHt0 : ∀ y : ℝ, 0 < y → 0 ≤ tailHt h cinf y η := by
    intro y hy
    unfold tailHt
    exact mul_nonneg (mul_nonneg (mul_pos (Real.sqrt_pos.mpr two_pos) hc0).le
      (Real.rpow_nonneg hy.le _)) (hHP _ (hZpos y hy))
  have hE0 : ∀ y : ℝ, 0 < y → 0 ≤ tailEh h cinf y η := by
    intro y hy
    unfold tailEh
    exact mul_nonneg (mul_nonneg hc0.le (Real.rpow_nonneg hy.le _)) (hHP _ (hZpos y hy))
  have hφI : ∀ y : ℝ, 0 < y →
      IntegrableOn (fun v => Real.exp (-v) * v ^ h * (y + 2 * (1 - η ^ 2) * v) ^ (-h)) (Ioi 0) := by
    intro y hy
    have hG : IntegrableOn (fun v : ℝ => Real.exp (-v) * v ^ (h + 1 - 1)) (Ioi 0) :=
      Real.GammaIntegral_convergent (by linarith)
    have hG' : IntegrableOn (fun v : ℝ => y ^ (-h) * (Real.exp (-v) * v ^ (h + 1 - 1))) (Ioi 0) :=
      hG.const_mul _
    refine Integrable.mono' hG' ?_ ?_
    · exact (by fun_prop : Measurable (fun v : ℝ =>
        Real.exp (-v) * v ^ h * (y + 2 * (1 - η ^ 2) * v) ^ (-h))).aestronglyMeasurable
    · refine (ae_restrict_iff' measurableSet_Ioi).mpr (Filter.Eventually.of_forall fun v hv => ?_)
      have hv' : (0:ℝ) < v := hv
      have hpos : 0 < y + 2 * (1 - η ^ 2) * v := by nlinarith [mul_pos hd hv']
      show ‖Real.exp (-v) * v ^ h * (y + 2 * (1 - η ^ 2) * v) ^ (-h)‖ ≤
        y ^ (-h) * (Real.exp (-v) * v ^ (h + 1 - 1))
      have h0 : 0 ≤ Real.exp (-v) * v ^ h := mul_nonneg (Real.exp_pos _).le (Real.rpow_nonneg hv'.le _)
      rw [show h + 1 - 1 = h by ring, Real.norm_eq_abs,
        abs_of_nonneg (mul_nonneg h0 (Real.rpow_nonneg hpos.le _))]
      have hle : (y + 2 * (1 - η ^ 2) * v) ^ (-h) ≤ y ^ (-h) :=
        Real.rpow_le_rpow_of_nonpos hy (by nlinarith [mul_pos hd hv']) (by linarith)
      nlinarith [mul_le_mul_of_nonneg_left hle h0]
  have hrep : ∀ y : ℝ, 0 < y → y ^ (-h) * heatProfile h (2 * (1 - η ^ 2) / y) =
      (Real.Gamma (1 + h))⁻¹ * ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ h * (y + 2 * (1 - η ^ 2) * v) ^ (-h) := by
    intro y hy
    unfold heatProfile
    rw [mul_left_comm, ← integral_const_mul]
    congr 1
    apply setIntegral_congr_fun measurableSet_Ioi
    intro v hv
    have hv' : (0:ℝ) < v := hv
    have h1 : 0 ≤ 1 + 2 * (1 - η ^ 2) / y * v := (add_pos one_pos (mul_pos (hZpos y hy) hv')).le
    show y ^ (-h) * (Real.exp (-v) * v ^ h * (1 + 2 * (1 - η ^ 2) / y * v) ^ (-h)) =
      Real.exp (-v) * v ^ h * (y + 2 * (1 - η ^ 2) * v) ^ (-h)
    have h2 : y + 2 * (1 - η ^ 2) * v = y * (1 + 2 * (1 - η ^ 2) / y * v) := by
      field_simp
    rw [h2, Real.mul_rpow hy.le h1]
    ring
  have hAnti : AntitoneOn (fun y => tailHt h cinf y η) (Ioi 0) := by
    intro y1 hy1 y2 hy2 hy
    have hy1' : (0:ℝ) < y1 := hy1
    have hy2' : (0:ℝ) < y2 := hy2
    show tailHt h cinf y2 η ≤ tailHt h cinf y1 η
    have e : ∀ y : ℝ, tailHt h cinf y η =
        Real.sqrt 2 * cinf * (y ^ (-h) * heatProfile h (2 * (1 - η ^ 2) / y)) := by
      intro y; unfold tailHt; ring
    rw [e y1, e y2, hrep y1 hy1', hrep y2 hy2']
    have hint : ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ h * (y2 + 2 * (1 - η ^ 2) * v) ^ (-h) ≤
        ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ h * (y1 + 2 * (1 - η ^ 2) * v) ^ (-h) := by
      apply setIntegral_mono_on (hφI y2 hy2') (hφI y1 hy1') measurableSet_Ioi
      intro v hv
      have hv' : (0:ℝ) < v := hv
      have hle : (y2 + 2 * (1 - η ^ 2) * v) ^ (-h) ≤ (y1 + 2 * (1 - η ^ 2) * v) ^ (-h) :=
        Real.rpow_le_rpow_of_nonpos (by nlinarith [mul_pos hd hv']) (by linarith) (by linarith)
      exact mul_le_mul_of_nonneg_left hle (mul_nonneg (Real.exp_pos _).le (Real.rpow_nonneg hv'.le _))
    apply mul_le_mul_of_nonneg_left _ (mul_pos (Real.sqrt_pos.mpr two_pos) hc0).le
    exact mul_le_mul_of_nonneg_left hint (inv_nonneg.mpr hΓ.le)
  have hHtd : ∀ y : ℝ, 0 < y → deriv (fun y => tailHt h cinf y η) y ≤ 0 := by
    intro y hy
    rw [← derivWithin_of_isOpen isOpen_Ioi hy]
    exact hAnti.derivWithin_nonpos



  have hPs : ContDiffOn ℝ ∞ (heatProfile h) (Ioi 0) :=
    (heatProfile_props h hh0 heatK_deriv_bound (fun Z hZ => heatK_ode h Z hh0 hZ)).1
  have hC : ContDiffOn ℝ ∞ (fun y => tailHt h cinf y η) (Ioi 0) := by
    have hq : ContDiffOn ℝ ∞ (fun y : ℝ => 2 * (1 - η ^ 2) / y) (Ioi 0) :=
      contDiffOn_const.div contDiffOn_id (fun y hy => ne_of_gt hy)
    have hmaps : MapsTo (fun y : ℝ => 2 * (1 - η ^ 2) / y) (Ioi 0) (Ioi 0) :=
      fun y hy => hZpos y hy
    have hcomp : ContDiffOn ℝ ∞ (fun y => heatProfile h (2 * (1 - η ^ 2) / y)) (Ioi 0) :=
      hPs.comp hq hmaps
    have hpow : ContDiffOn ℝ ∞ (fun y : ℝ => y ^ (-h)) (Ioi 0) :=
      fun y hy => (Real.contDiffAt_rpow_const_of_ne (ne_of_gt hy)).contDiffWithinAt
    show ContDiffOn ℝ ∞ (fun y => Real.sqrt 2 * cinf * y ^ (-h) * heatProfile h (2 * (1 - η ^ 2) / y)) (Ioi 0)
    exact (contDiffOn_const.mul hpow).mul hcomp
  have hHtc : ContinuousOn (fun y => tailHt h cinf y η) (Ioi 0) := hC.continuousOn
  have hHtdc : ContinuousOn (deriv (fun y => tailHt h cinf y η)) (Ioi 0) :=
    hC.continuousOn_deriv_of_isOpen isOpen_Ioi (by simp)



  have hF3 : ∀ s : ℝ, 0 < s → tailHt h cinf s η = Real.sqrt (2 * s) * tailEh h cinf s η := by
    intro s hs
    unfold tailHt tailEh
    rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2), Real.sqrt_eq_rpow s]
    have key : s ^ (1 / 2 : ℝ) * s ^ (-(1 / 2 + h)) = s ^ (-h) := by
      rw [← Real.rpow_add hs]; ring_nf
    rw [← key]
    ring
  have hM0 : 0 ≤ M := le_trans (hE0 X hX0) (hM X le_rfl hXXb)
  obtain ⟨Kθ, hKθdef⟩ : ∃ K : ℝ → ℝ, K = fun x => (2 * (1 - 2 * h * η ^ 2) *
      (tailHt h cinf x η - x * deriv (fun y => tailHt h cinf y η) x) + x * tailHt h cinf x η) *
      deriv (tailFac ρ Xb) x := ⟨_, rfl⟩
  obtain ⟨Kz, hKzdef⟩ : ∃ K : ℝ → ℝ, K = fun s => (s - X) * tailEh h cinf s η ^ 2 *
      tailFac ρ Xb s * deriv (tailFac ρ Xb) s := ⟨_, rfl⟩
  have eTth : collarTth h cinf ρ Xb X η = tailHt h cinf X η * deriv (tailFac ρ Xb) X +
      (∫ x in X..Xb, Kθ x) / (2 * X * (1 - 2 * h * η ^ 2)) := by
    rw [hKθdef]; rfl
  have eTz : collarTz h cinf ρ Xb X η =
      2 * η * (∫ s in X..Xb, Kz s) / ((1 - 2 * h * η ^ 2) * Real.sqrt (2 * X)) := by
    rw [hKzdef]; rfl
  have hKθ : ∀ s ∈ Icc X Xb, s * tailHt h cinf s η * deriv (tailFac ρ Xb) s ≤ Kθ s ∧
      0 ≤ s * tailHt h cinf s η * deriv (tailFac ρ Xb) s := by
    intro s hs
    have hs0 : 0 < s := lt_of_lt_of_le hX0 hs.1
    have a1 := hHt0 s hs0
    have a2 := hHtd s hs0
    have a3 := (hfB s hs0).1
    refine ⟨?_, mul_nonneg (mul_nonneg hs0.le a1) a3⟩
    simp only [hKθdef]
    apply mul_le_mul_of_nonneg_right _ a3
    have b1 : 0 ≤ tailHt h cinf s η - s * deriv (fun y => tailHt h cinf y η) s := by
      nlinarith [mul_nonneg hs0.le (neg_nonneg.mpr a2)]
    nlinarith [mul_nonneg hL.le b1]
  have hA0 : 0 ≤ ∫ x in X..Xb, Kθ x :=
    intervalIntegral.integral_nonneg hXXb.le (fun s hs => le_trans (hKθ s hs).2 (hKθ s hs).1)
  have hP0 : 0 ≤ tailHt h cinf X η * deriv (tailFac ρ Xb) X :=
    mul_nonneg (hHt0 X hX0) (hfB X hX0).1
  have hT0 : 0 ≤ collarTth h cinf ρ Xb X η := by
    rw [eTth]
    exact add_nonneg hP0 (div_nonneg hA0 (mul_pos (mul_pos two_pos hX0) hL).le)
  refine ⟨hT0, ?_⟩
  by_cases hI : IntervalIntegrable Kz volume X Xb
  · have hF4 : ∀ s ∈ Ioo X Xb, Real.sqrt (2 * X) * Kz s ≤ M * Kθ s := by
      intro s hs
      have hs0 : 0 < s := lt_trans hX0 hs.1
      obtain ⟨hD, hF0, hF1⟩ := hfB s hs0
      have he0 := hE0 s hs0
      have heM := hM s hs.1.le hs.2
      have hq : Real.sqrt (2 * X) ≤ Real.sqrt (2 * s) := Real.sqrt_le_sqrt (by linarith [hs.1])
      have hr0 : 0 ≤ Real.sqrt (2 * X) := Real.sqrt_nonneg _
      have hKθs := (hKθ s ⟨hs.1.le, hs.2.le⟩).1
      have t1 : tailEh h cinf s η ^ 2 * tailFac ρ Xb s ≤ tailEh h cinf s η * M := by
        have : tailEh h cinf s η * tailFac ρ Xb s ≤ tailEh h cinf s η := by nlinarith
        nlinarith
      have t2 : Real.sqrt (2 * X) * (s - X) ≤ Real.sqrt (2 * s) * s := by
        have : 0 ≤ s - X := by linarith [hs.1]
        exact mul_le_mul hq (by linarith) this (le_trans hr0 hq)
      have t3 := mul_le_mul t2 t1 (mul_nonneg (sq_nonneg _) hF0)
        (mul_nonneg (le_trans hr0 hq) hs0.le)
      have t4 := mul_le_mul_of_nonneg_right t3 hD
      simp only [hKzdef]
      calc Real.sqrt (2 * X) * ((s - X) * tailEh h cinf s η ^ 2 * tailFac ρ Xb s *
            deriv (tailFac ρ Xb) s)
          = Real.sqrt (2 * X) * (s - X) * (tailEh h cinf s η ^ 2 * tailFac ρ Xb s) *
            deriv (tailFac ρ Xb) s := by ring
        _ ≤ Real.sqrt (2 * s) * s * (tailEh h cinf s η * M) * deriv (tailFac ρ Xb) s := t4
        _ = M * (s * tailHt h cinf s η * deriv (tailFac ρ Xb) s) := by rw [hF3 s hs0]; ring
        _ ≤ M * Kθ s := mul_le_mul_of_nonneg_left hKθs hM0
    have hKθI : IntervalIntegrable Kθ volume X Xb := by
      rw [hKθdef]
      have hsub : uIcc X Xb ⊆ Ioi 0 := by
        rw [uIcc_of_le hXXb.le]; intro z hz; exact lt_of_lt_of_le hX0 hz.1
      have c1 := hHtc.mono hsub
      have c2 := hHtdc.mono hsub
      have hcont : ContinuousOn (fun x => 2 * (1 - 2 * h * η ^ 2) *
          (tailHt h cinf x η - x * deriv (fun y => tailHt h cinf y η) x) + x * tailHt h cinf x η)
