theorem pulse_path_pullback_v5 : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl) (v : ℝ) (g : Cyl → V) (O O' : Set Cyl) (lam : Cyl →L[ℝ] ℝ) (c0 σ : ℝ) (eh : Cyl) (j : ℕ), IsOpen O → ξ ∈ O → (∀ η ∈ O, vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = lam η + c0) → IsOpen O' → pulsePth5 B G γ ξ v ∈ O' → ContDiffOn ℝ ∞ g O' → 0 ≤ σ → (∀ w : Cyl, |lam (Lnorm B.h ξ w)| ≤ σ * ‖w‖) → Lnorm B.h ξ eh = dVdir B.h γ.1 → ‖eh‖ ≤ 1 → Lnorm B.h (pulsePth5 B G γ ξ v) = Lnorm B.h ξ → ‖(iteratedFDeriv ℝ j (fun pv : Cyl × ℝ => g (pulsePth5 B G γ pv.1 pv.2)) (ξ, v)).compContinuousLinearMap (fun _ => (Lnorm B.h ξ).prodMap (ContinuousLinearMap.id ℝ ℝ))‖ ≤ NB B.h g j (pulsePth5 B G γ ξ v) * (2 + σ) ^ j :=
