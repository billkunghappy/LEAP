  have hmvt : ∀ (T1 T2 P : ℝ → ℝ → ℝ) (Xa Xb Cg : ℝ), 0 < Xa →
      ContDiffOn ℝ ∞ (↿T1) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿T2) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿P) (Ioi 0 ×ˢ Ioo (-1) 1) →
      (∀ X η : ℝ, Xa < X → X < Xb → -1 < η → η < 1 → 0 < Real.sqrt (T1 X η ^ 2 + T2 X η ^ 2)) →
      (∀ X η : ℝ, Xa < X → X < Xb → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ 1 (fun w : ℝ × ℝ => P w.1 w.2 / Real.sqrt (T1 w.1 w.2 ^ 2 + T2 w.1 w.2 ^ 2))
          (X, η)‖ ≤ Cg) →
      ∀ X η X' η' : ℝ, Xa < X → X < Xb → -1 < η → η < 1 → Xa < X' → X' < Xb → -1 < η' → η' < 1 →
