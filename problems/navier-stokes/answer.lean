      _ ≤ |Cr| * ξ.1 := mul_le_mul (hangC.trans (le_abs_self _)) hQX (by positivity) (abs_nonneg _)
  have hpb : |p| ≤ |Cr| := by rw [hpdef]; exact hpC.trans (le_abs_self _)
  have hz0K : ((1:ℝ), β, κ, A, p) ∈ K := by
    rw [hKdef]
    refine ⟨?_, rfl, hcp'⟩
    rw [mem_closedBall_zero_iff]
    refine norm_prod_le_iff.mpr ⟨?_, norm_prod_le_iff.mpr ⟨?_, norm_prod_le_iff.mpr ⟨?_,
      norm_prod_le_iff.mpr ⟨?_, ?_⟩⟩⟩⟩
