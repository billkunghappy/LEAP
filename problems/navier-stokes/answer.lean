    have e2 : (APhi5 B G γ (s.1, s.2.1, s.2.2, ξ.2.2.2 + (v' - y0) • d)).mulVec (Pi.single c 1) a =
        APhi5 B G γ (s.1, s.2.1, s.2.2, ξ.2.2.2 + (v' - y0) • d) a c := by simp
    rw [Pi.sub_apply, e1, e2, Pi.smul_apply, smul_eq_mul, Pi.single_apply] at h1
    rw [h1]
