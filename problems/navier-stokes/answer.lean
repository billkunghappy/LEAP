    intro E G _ _ _ _ f s L c x k hs hf hx
    have hs' : IsOpen ((fun z => c + z) ⁻¹' s) := hs.preimage (by fun_prop)
    have hf's : ContDiffOn ℝ ∞ (fun z => f (c + z)) ((fun z => c + z) ⁻¹' s) :=
