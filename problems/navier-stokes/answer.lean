  obtain ⟨gu, hgu⟩ : ∃ gu : ℝ → ℝ × ℝ × ℝ → ℝ, gu = fun u a =>
      F (u * (sgc5ch B.h ξ0 a).1, (sgc5ch B.h ξ0 a).2.1, (sgc5ch B.h ξ0 a).2.2.1, (0 : ℝ × ℝ)) :=
