    hK (Real.exp (Λ * M) * A) cF (mul_nonneg (Real.exp_pos _).le hA.le) hcFd hcFb
  obtain ⟨hSUs, hSUb⟩ := hK (5 + A) cU (by linarith) hcUd hcUb

