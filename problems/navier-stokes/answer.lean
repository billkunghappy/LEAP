          Uc k X (η : ℂ) = ((iteratedDeriv k (fun Y => axProfU h Λ t1 κ0 om Pax Fn Un Y η) X : ℝ) : ℂ) ∧
          Pc k X (η : ℂ) = ((iteratedDeriv k (fun Y => Pax η + profRadInt (fun x e => axProfF h Λ t1 κ0 om Fn Un x e ^ 2) Y η) X : ℝ) : ℂ))) ∧
    (∀ X η : ℝ, 0 < X → X ≤ 4 / Λ → -1 < η → η < 1 → leadStressTh h (axProfF h Λ t1 κ0 om Fn Un) (axProfU h Λ t1 κ0 om Pax Fn Un) X η = 0 ∧ axTz h Pax (axProfF h Λ t1 κ0 om Fn Un) (axProfU h Λ t1 κ0 om Pax Fn Un) X η = 0) ∧
    AxAdm h Pax (fun X => Real.exp (-(t1 ^ 2 / Real.log (X / (4 / Λ)) ^ 2))) (fun X => min 1 (Real.log (X / (4 / Λ)))) (Ioc (4 / Λ) Xa2) (axProfF h Λ t1 κ0 om Fn Un) (axProfU h Λ t1 κ0 om Pax Fn Un) ∧
    AxCone h μ Pax (Icc Xa1 (4 / Λ * Real.exp t1)) (axProfF h Λ t1 κ0 om Fn Un) (axProfU h Λ t1 κ0 om Pax Fn Un) :=
by
  intro hCone hSm h Pst Pax hD j0 σ δ ρ Pc hj0 hj0' hAD Λ C K ρ1 ts Kder M Fn Un hΛ hK hρ1 hts hts' hA hRef
  refine ⟨1 / 4, by norm_num, by norm_num, ?_⟩
  intro κ0 hκ0 hκ0'
  have hκ0h : κ0 < 1 / 2 := by linarith
  obtain ⟨tss, htss, htss', hConeT⟩ := ax_collar_cone_unit hCone hSm h Pst Pax hD j0 σ δ ρ Pc hj0 hj0' hAD
    Λ C K ρ1 ts Kder M Fn Un hΛ hK hρ1 hts hts' hA hRef κ0 hκ0 hκ0h
  refine ⟨tss, htss, htss', ?_⟩
  intro t1 ht1 ht1' om hom hom'
  have ht1s : t1 ≤ ts := le_trans ht1' htss'
  have ht1c : t1 ≤ 1 / 100 := le_trans ht1s hts'
  have hR1 := hRef t1 ht1 ht1s
  obtain ⟨tf, cB, Bθ, Bz, hFF⟩ := ax_collar_flat_factor_unit hSm h Pst Pax hD j0 σ δ ρ Pc hj0 hj0' hAD
    Λ C K ρ1 t1 κ0 om Kder M Fn Un hΛ hK hρ1 ht1 ht1c hκ0 hκ0h hom hom' hA hR1
  have htf : 0 < tf := hFF.1
  have htf' : tf ≤ t1 / 2 := hFF.2.1
  have hAdm := ax_collar_adm h Pax Λ t1 κ0 tf cB Bθ Bz _ _ hΛ ht1 ht1c hκ0 hκ0h hFF
  obtain ⟨μ, hμ, hCn⟩ := hConeT t1 ht1 ht1' om hom hom' (tf / 4) (by linarith) (by linarith)
  have hX0 : 0 < 4 / Λ := div_pos (by norm_num) (by linarith)
  have hXan1 : 4 / Λ < 4 / Λ * Real.exp (tf / 6) :=
    lt_mul_of_one_lt_right hX0 (by
      have := Real.add_one_lt_exp (show tf / 6 ≠ 0 by linarith)
      linarith)
  have hXan2 : 4 / Λ * Real.exp (tf / 6) < 4 / Λ * Real.exp t1 :=
    mul_lt_mul_of_pos_left (Real.exp_lt_exp.mpr (by linarith)) hX0
  refine ⟨4 / Λ * Real.exp (tf / 6), 4 / Λ * Real.exp (tf / 4), 4 / Λ * Real.exp (tf / 2), μ,
    hXan1, ?_, ?_, ?_, hμ, ?_, ?_, hAdm, hCn⟩
  · exact mul_lt_mul_of_pos_left (Real.exp_lt_exp.mpr (by linarith)) hX0
  · exact mul_lt_mul_of_pos_left (Real.exp_lt_exp.mpr (by linarith)) hX0
  · exact mul_lt_mul_of_pos_left (Real.exp_lt_exp.mpr (by linarith)) hX0
  · exact ax_collar_analytic_unit hSm h Pst Pax hD j0 σ δ ρ Pc hj0 hj0' hAD Λ C K ρ1 t1 κ0 om Kder M Fn Un
      hΛ hK hρ1 ht1 ht1c hκ0 hκ0h hom hom' hA hR1 _ hXan1 hXan2
  · exact ax_collar_stress_zero_unit hSm h Pst Pax hD j0 σ δ ρ Pc hj0 hj0' hAD Λ C K ρ1 t1 κ0 om Kder M Fn Un
      hΛ hK hρ1 ht1 ht1c hκ0 hκ0h hom hom' hA hR1

theorem ax_integrands_smooth : ∀ (h Λ t1 κ0 om r ρ1 : ℝ) (Pax : ℝ → ℝ) (Fn Un : ℝ → ℝ → ℝ), 0 < h → h < 1 / 100 → 1 ≤ Λ → 0 < t1 → 0 < om → 0 < r → r ≤ ρ1 → r ≤ 1 → ContDiffOn ℝ ∞ Pax (Ioo (-1 - r) (1 + r)) → ContDiffOn ℝ ∞ (↿(axRefF Λ t1 Fn)) (Ioi (-1 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) → ContDiffOn ℝ ∞ (↿(axRefU Λ t1 Un)) (Ioi (-1 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1)) → (∀ X η : ℝ, 0 ≤ X → -1 - ρ1 < η → η < 1 + ρ1 → 0 < axRefF Λ t1 Fn X η) → ContDiffOn ℝ ∞ (↿(axShearA h Λ t1 κ0 om Fn Un)) (univ ×ˢ Ioo (-1 - r) (1 + r)) ∧ ContDiffOn ℝ ∞ (↿(axSlopeU h Λ t1 κ0 om Pax Fn Un)) (univ ×ˢ Ioo (-1 - r) (1 + r)) :=
by
  intro h Λ t1 κ0 om r ρ1 Pax Fn Un hh0 hh1 hΛ ht1 hom hr hrρ hr1 hPax hF hU hFpos
  have hw : (0:ℝ) < 1 + r := by linarith

  have hstrip : ∀ (g : ℝ → ℝ → ℝ) (c : ℝ), 0 < c →
      ContDiffOn ℝ ∞ (↿g) (Ioi (-c) ×ˢ Ioo (-1 - r) (1 + r)) →
      ContDiffOn ℝ ∞ (↿(profRadAvg g)) (Ioi (-c) ×ˢ Ioo (-1 - r) (1 + r)) ∧
      ContDiffOn ℝ ∞ (↿(profRadInt g)) (Ioi (-c) ×ˢ Ioo (-1 - r) (1 + r)) := by
    intro g c hc hg
    have hχ : ContDiff ℝ ∞ (fun p : ℝ × ℝ => (p.1, (1 + r) * p.2)) :=
      contDiff_fst.prodMk (contDiff_const.mul contDiff_snd)
    have hgt : ContDiffOn ℝ ∞ (↿(fun x ξ : ℝ => g x ((1 + r) * ξ))) (Ioi (-c) ×ˢ Ioo (-1) 1) := by
      refine (hg.comp hχ.contDiffOn ?_).congr (fun p _ => rfl)
      intro p hp
      have h1 : -1 < p.2 := hp.2.1
      have h2 : p.2 < 1 := hp.2.2
      refine ⟨hp.1, ?_, ?_⟩
      · show -1 - r < (1 + r) * p.2
        nlinarith [mul_pos hw (show (0:ℝ) < p.2 + 1 by linarith)]
      · show (1 + r) * p.2 < 1 + r
        nlinarith [mul_pos hw (show (0:ℝ) < 1 - p.2 by linarith)]
    obtain ⟨hA, -, hId⟩ := profRadAvg_props _ c hc hgt
    have hψ : ContDiff ℝ ∞ (fun p : ℝ × ℝ => (p.1, p.2 / (1 + r))) :=
      contDiff_fst.prodMk (contDiff_snd.div_const _)
    have hψm : MapsTo (fun p : ℝ × ℝ => (p.1, p.2 / (1 + r)))
        (Ioi (-c) ×ˢ Ioo (-1 - r) (1 + r)) (Ioi (-c) ×ˢ Ioo (-1) 1) := by
      intro p hp
      have h1 : -1 - r < p.2 := hp.2.1
      have h2 : p.2 < 1 + r := hp.2.2
      refine ⟨hp.1, ?_, ?_⟩
      · show -1 < p.2 / (1 + r)
        rw [lt_div_iff₀ hw]; linarith
      · show p.2 / (1 + r) < 1
        rw [div_lt_iff₀ hw]; linarith
    have heq : ∀ η : ℝ, (1 + r) * (η / (1 + r)) = η := fun η => by field_simp
    have hAvg : ∀ X η : ℝ,
        profRadAvg (fun x ξ : ℝ => g x ((1 + r) * ξ)) X (η / (1 + r)) = profRadAvg g X η := by
      intro X η
      simp only [profRadAvg, heq η]
    have hInt : ∀ X η : ℝ,
        profRadInt (fun x ξ : ℝ => g x ((1 + r) * ξ)) X (η / (1 + r)) = profRadInt g X η := by
      intro X η
      simp only [profRadInt, heq η]
    have hAv : ContDiffOn ℝ ∞ (↿(profRadAvg g)) (Ioi (-c) ×ˢ Ioo (-1 - r) (1 + r)) := by
      refine (hA.comp hψ.contDiffOn hψm).congr ?_
      intro p _
      exact (hAvg p.1 p.2).symm
    refine ⟨hAv, ?_⟩
    refine (contDiffOn_fst.mul hAv).congr ?_
    intro p hp
    have hm := hψm hp
    have h1 := (hId p.1 (p.2 / (1 + r)) hp.1 hm.2.1 hm.2.2).1
    show profRadInt g p.1 p.2 = p.1 * profRadAvg g p.1 p.2
    rw [← hInt, ← hAvg]
    exact h1.symm

  have hpd : ∀ (g : ℝ → ℝ → ℝ) (W : Set (ℝ × ℝ)), IsOpen W → ContDiffOn ℝ ∞ (↿g) W →
      ContDiffOn ℝ ∞ (↿(profEtaD g)) W := by
    intro g W hW hg
    obtain ⟨hd, hG'⟩ := (contDiffOn_infty_iff_fderiv_of_isOpen hW).1 hg
    refine (hG'.clm_apply (contDiffOn_const (c := ((0:ℝ), (1:ℝ))))).congr ?_
    intro p hp
    have hhas : HasFDerivAt (↿g) (fderiv ℝ (↿g) p) (p.1, p.2) :=
      ((hd p hp).differentiableAt (hW.mem_nhds hp)).hasFDerivAt
    have hc : HasDerivAt (fun e : ℝ => (p.1, e)) ((0:ℝ), (1:ℝ)) p.2 :=
      (hasDerivAt_const p.2 p.1).prodMk (hasDerivAt_id' p.2)
    exact (hhas.comp_hasDerivAt p.2 hc).deriv

  have key : ∀ (ε : ℝ) (F U : ℝ → ℝ → ℝ), 0 < ε →
      ContDiffOn ℝ ∞ (↿F) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) →
      ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) →
      (∀ X η : ℝ, 0 < X → -1 - r < η → η < 1 + r → 0 < F X η) →
      ContDiffOn ℝ ∞ (↿(psLead1 h F U)) (Ioi 0 ×ˢ Ioo (-1 - r) (1 + r)) ∧
      ContDiffOn ℝ ∞ (↿(axNs h Pax F U)) (Ioi 0 ×ˢ Ioo (-1 - r) (1 + r)) := by
    intro ε F U hε hF hU hFpos
    set Ω : Set (ℝ × ℝ) := Ioi (0:ℝ) ×ˢ Ioo (-1 - r) (1 + r) with hΩdef
    have hΩo : IsOpen Ω := isOpen_Ioi.prod isOpen_Ioo
    have hsub : Ω ⊆ Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r) := fun p hp =>
      ⟨show -ε < p.1 from lt_trans (neg_lt_zero.mpr hε) hp.1, hp.2⟩
    have hrad : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) →
        ContDiffOn ℝ ∞ (↿(profRadInt g)) Ω :=
      fun g hg => ((hstrip g ε hε hg).2).mono hsub
    have hFp : ∀ p ∈ Ω, 0 < F p.1 p.2 := fun p hp => hFpos _ _ hp.1 hp.2.1 hp.2.2
    have hLp : ∀ p ∈ Ω, 0 < 1 - 2 * h * p.2 ^ 2 := by
      intro p hp
      have h1 : -1 - r < p.2 := hp.2.1
      have h2 : p.2 < 1 + r := hp.2.2
      have hsq : p.2 ^ 2 < 4 := by
        nlinarith [mul_pos (show (0:ℝ) < 2 - p.2 by linarith) (show (0:ℝ) < 2 + p.2 by linarith)]
      have := mul_lt_mul_of_pos_left hsq hh0
      nlinarith
    have g2 : ContDiffOn ℝ ∞ (↿(fun x e : ℝ => 2 * x * F x e)) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 2 * p.1 * F p.1 p.2) _
      exact (contDiffOn_const.mul contDiffOn_fst).mul hF
    have g3 : ContDiffOn ℝ ∞ (↿(fun x e : ℝ => U x e * (2 * x * F x e)))
        (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => U p.1 p.2 * (2 * p.1 * F p.1 p.2)) _
      exact hU.mul ((contDiffOn_const.mul contDiffOn_fst).mul hF)
    have g4 : ContDiffOn ℝ ∞ (↿(fun x e : ℝ => U x e ^ 2 - x * F x e ^ 2))
        (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => U p.1 p.2 ^ 2 - p.1 * F p.1 p.2 ^ 2) _
      exact (hU.pow 2).sub (contDiffOn_fst.mul (hF.pow 2))
    have g5 : ContDiffOn ℝ ∞ (↿(fun x e : ℝ => F x e ^ 2)) (Ioi (-ε) ×ˢ Ioo (-1 - r) (1 + r)) := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => F p.1 p.2 ^ 2) _
      exact hF.pow 2
    have f : ContDiffOn ℝ ∞ (↿F) Ω := hF.mono hsub
    have u : ContDiffOn ℝ ∞ (↿U) Ω := hU.mono hsub
    have a : ContDiffOn ℝ ∞ (↿(profRadAvg U)) Ω := (hstrip U ε hε hU).1.mono hsub
    have a' := hpd _ _ hΩo a
    have I := hrad _ g2
    have I' := hpd _ _ hΩo I
    have J := hrad _ g3
    have J' := hpd _ _ hΩo J
    have M := hrad _ hU
    have M' := hpd _ _ hΩo M
    have S := hrad _ g4
    have S' := hpd _ _ hΩo S
    have hPi : ContDiffOn ℝ ∞ (↿(axPi Pax F)) Ω := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Pax p.2 + profRadInt (fun x e => F x e ^ 2) p.1 p.2) Ω
      exact (hPax.comp contDiffOn_snd (fun p hp => hp.2)).add (hrad _ g5)
    have hPi' := hpd _ _ hΩo hPi
    have hLs : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 1 - 2 * h * p.2 ^ 2) Ω :=
      contDiffOn_const.sub (contDiffOn_const.mul (contDiffOn_snd.pow 2))
    have hW : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => leadW h U p.1 p.2) Ω := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 1 - 2 * (1 / 2 - h) * p.2 * profRadAvg U p.1 p.2
        - (1 - p.2 ^ 2) * profEtaD (profRadAvg U) p.1 p.2) Ω
      exact (contDiffOn_const.sub ((contDiffOn_const.mul contDiffOn_snd).mul a)).sub
        ((contDiffOn_const.sub (contDiffOn_snd.pow 2)).mul a')
    have hQ : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => leadQs h F U p.1 p.2) Ω := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => -leadW h U p.1 p.2 +
        ((1 - h) * profRadInt (fun x e => 2 * x * F x e) p.1 p.2
          - (1 / 2 - h) * p.2 * profEtaD (profRadInt (fun x e => 2 * x * F x e)) p.1 p.2
          - (1 - p.2 ^ 2) * profEtaD (profRadInt (fun x e => U x e * (2 * x * F x e))) p.1 p.2
          + 2 * (h - (1 / 2 - h)) * p.2 * profRadInt (fun x e => U x e * (2 * x * F x e)) p.1 p.2) /
        (p.1 * (2 * p.1 * F p.1 p.2))) Ω
      refine hW.neg.add (ContDiffOn.fun_div ?_ ?_ ?_)
      · exact (((contDiffOn_const.mul I).sub ((contDiffOn_const.mul contDiffOn_snd).mul I')).sub
          ((contDiffOn_const.sub (contDiffOn_snd.pow 2)).mul J')).add
          ((contDiffOn_const.mul contDiffOn_snd).mul J)
      · exact contDiffOn_fst.mul ((contDiffOn_const.mul contDiffOn_fst).mul f)
      · intro p hp
        exact (mul_pos hp.1 (mul_pos (mul_pos two_pos hp.1) (hFp p hp))).ne'
    have hNs : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => axNs h Pax F U p.1 p.2) Ω := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => -leadW h U p.1 p.2 * U p.1 p.2 +
        ((1 / 2 - h) * (profRadInt U p.1 p.2 - p.2 * profEtaD (profRadInt U) p.1 p.2)
          + 4 * h * p.2 * profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2) p.1 p.2
          - (1 - p.2 ^ 2) * profEtaD (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2)) p.1 p.2) / p.1
        + 4 * (1 / 2 + h) * p.2 * axPi Pax F p.1 p.2 - (1 - p.2 ^ 2) * profEtaD (axPi Pax F) p.1 p.2) Ω
      have hnum : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ =>
          (1 / 2 - h) * (profRadInt U p.1 p.2 - p.2 * profEtaD (profRadInt U) p.1 p.2)
          + 4 * h * p.2 * profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2) p.1 p.2
          - (1 - p.2 ^ 2) * profEtaD (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2)) p.1 p.2) Ω :=
        ((contDiffOn_const.mul (M.sub (contDiffOn_snd.mul M'))).add
          ((contDiffOn_const.mul contDiffOn_snd).mul S)).sub
          ((contDiffOn_const.sub (contDiffOn_snd.pow 2)).mul S')
      exact (((hW.neg.mul u).add (hnum.fun_div contDiffOn_fst (fun p hp => (ne_of_gt hp.1)))).add
        ((contDiffOn_const.mul contDiffOn_snd).mul hPi)).sub
        ((contDiffOn_const.sub (contDiffOn_snd.pow 2)).mul hPi')
    refine ⟨?_, hNs⟩
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => p.1 * leadQs h F U p.1 p.2 / (1 - 2 * h * p.2 ^ 2)) Ω
    exact (contDiffOn_fst.mul hQ).fun_div hLs (fun p hp => (hLp p hp).ne')

  have hΛ0 : (0:ℝ) < Λ := by linarith
  have hε : (0:ℝ) < 1 / Λ := div_pos one_pos hΛ0
  have hsubS : Ioo (-1 - r) (1 + r) ⊆ Ioo (-1 - ρ1) (1 + ρ1) :=
    Ioo_subset_Ioo (by linarith) (by linarith)
  have hdom : Ioi (-(1 / Λ)) ×ˢ Ioo (-1 - r) (1 + r) ⊆ Ioi (-1 / Λ) ×ˢ Ioo (-1 - ρ1) (1 + ρ1) := by
    rw [neg_div]
    exact Set.prod_mono subset_rfl hsubS
  have hF' : ContDiffOn ℝ ∞ (↿(axRefF Λ t1 Fn)) (Ioi (-(1 / Λ)) ×ˢ Ioo (-1 - r) (1 + r)) :=
    hF.mono hdom
  have hU' : ContDiffOn ℝ ∞ (↿(axRefU Λ t1 Un)) (Ioi (-(1 / Λ)) ×ˢ Ioo (-1 - r) (1 + r)) :=
    hU.mono hdom
  obtain ⟨hP1, hN⟩ := key (1 / Λ) (axRefF Λ t1 Fn) (axRefU Λ t1 Un) hε hF' hU'
    (fun X η hX h1 h2 => hFpos X η hX.le (by linarith) (by linarith))
  have hφ : ContDiff ℝ ∞ (fun p : ℝ × ℝ => (4 / Λ * Real.exp p.1, p.2)) :=
    (contDiff_const.mul (Real.contDiff_exp.comp contDiff_fst)).prodMk contDiff_snd
  have hφm : MapsTo (fun p : ℝ × ℝ => (4 / Λ * Real.exp p.1, p.2))
      (univ ×ˢ Ioo (-1 - r) (1 + r)) (Ioi 0 ×ˢ Ioo (-1 - r) (1 + r)) := by
    intro p hp
    exact ⟨show (0:ℝ) < 4 / Λ * Real.exp p.1 from
      mul_pos (div_pos (by norm_num) hΛ0) (Real.exp_pos _), hp.2⟩
  have hPc : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ =>
      psLead1 h (axRefF Λ t1 Fn) (axRefU Λ t1 Un) (4 / Λ * Real.exp p.1) p.2)
      (univ ×ˢ Ioo (-1 - r) (1 + r)) :=
    (hP1.comp hφ.contDiffOn hφm).congr (fun p _ => rfl)
  have hNc : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ =>
      axNs h Pax (axRefF Λ t1 Fn) (axRefU Λ t1 Un) (4 / Λ * Real.exp p.1) p.2)
      (univ ×ˢ Ioo (-1 - r) (1 + r)) :=
    (hN.comp hφ.contDiffOn hφm).congr (fun p _ => rfl)
  have hσ : ContDiff ℝ ∞ sigA := sigA_collar_facts.1
  have hθ : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => axTheta Λ om p.1) (univ ×ˢ Ioo (-1 - r) (1 + r)) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => sigA ((p.1 - Real.log (25 * Λ) - om / 2) / (om / 2))) _
    exact (hσ.comp (((contDiff_fst.sub contDiff_const).sub contDiff_const).div_const (om / 2))).contDiffOn
  have hβ : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => axBeta Λ om p.1) (univ ×ˢ Ioo (-1 - r) (1 + r)) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 1 - sigA ((p.1 - Real.log (25 * Λ)) / (om / 2))) _
    exact (contDiff_const.sub (hσ.comp ((contDiff_fst.sub contDiff_const).div_const (om / 2)))).contDiffOn
  have hκ : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => axKap κ0 t1 p.1) (univ ×ˢ Ioo (-1 - r) (1 + r)) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 1 - (1 - κ0) * sigA (p.1 / t1)) _
    exact (contDiff_const.sub (contDiff_const.mul (hσ.comp (contDiff_fst.div_const t1)))).contDiffOn
  have hZ : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 4 / Λ * Real.exp p.1) (univ ×ˢ Ioo (-1 - r) (1 + r)) :=
    (contDiff_const.mul (Real.contDiff_exp.comp contDiff_fst)).contDiffOn
