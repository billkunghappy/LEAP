            rw [← ENNReal.ofReal_add ha (hv0 x),
              ENNReal.ofReal_rpow_of_nonneg (add_nonneg ha (hv0 x)) (by norm_num)]
        _ ≤ 2 ^ ((4:ℝ)/3 - 1) * (ENNReal.ofReal (φ x ^ 3 * ‖w x‖ ^ 2) ^ ((4:ℝ)/3)
              + ENNReal.ofReal (v x) ^ ((4:ℝ)/3)) :=
            ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ h43
        _ = _ := by
            rw [ENNReal.ofReal_rpow_of_nonneg ha (by norm_num),
              ENNReal.ofReal_rpow_of_nonneg (hv0 x) (by norm_num)]
    have hm2 : Measurable (fun x => ENNReal.ofReal ((φ x ^ 3 * ‖w x‖ ^ 2) ^ ((4:ℝ)/3))) :=
      ((by fun_prop : Continuous (fun x => φ x ^ 3 * ‖w x‖ ^ 2)).rpow_const
        (fun _ => Or.inr (by norm_num))).measurable.ennreal_ofReal
    have hc2 : (2:ENNReal) ^ ((4:ℝ)/3 - 1) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by norm_num) (by norm_num)
    have hball43 := hball ((4:ℝ)/3) (by norm_num) (by norm_num)
    have hX : 0 ≤ W ^ ((5:ℝ)/6) * S ^ ((1:ℝ)/6) :=
      mul_nonneg (Real.rpow_nonneg hW0 _) (Real.rpow_nonneg hS0 _)
    have hY : 0 ≤ (2 * M) ^ ((4:ℝ)/3) * (V + W) :=
      mul_nonneg (Real.rpow_nonneg h2M _) (add_nonneg hV0 hW0)
    calc _ ≤ ∫⁻ x, 2 ^ ((4:ℝ)/3 - 1) * (ENNReal.ofReal ((φ x ^ 3 * ‖w x‖ ^ 2) ^ ((4:ℝ)/3))
          + ENNReal.ofReal (v x ^ ((4:ℝ)/3))) := lintegral_mono hpt
      _ = 2 ^ ((4:ℝ)/3 - 1) * ((∫⁻ x, ENNReal.ofReal ((φ x ^ 3 * ‖w x‖ ^ 2) ^ ((4:ℝ)/3)))
          + ∫⁻ x, ENNReal.ofReal (v x ^ ((4:ℝ)/3))) := by
          rw [lintegral_const_mul' _ _ hc2, lintegral_add_left hm2]
      _ ≤ 2 ^ ((4:ℝ)/3 - 1) * (ENNReal.ofReal (W ^ ((5:ℝ)/6) * S ^ ((1:ℝ)/6))
          + ENNReal.ofReal ((2 * M) ^ ((4:ℝ)/3) * (V + W))) :=
          mul_le_mul' le_rfl (add_le_add hhol hball43)
      _ = _ := by
          rw [← ENNReal.ofReal_add hX hY, show (4:ℝ)/3 - 1 = 1/3 by norm_num,
            ← ENNReal.ofReal_ofNat 2, ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by norm_num),
            ← ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _)]

theorem flux_beta_moments : ∀ (a : ℝ) (w : ℝ³ → ℝ³) (φ β : ℝ³ → ℝ), 0 ≤ a → Continuous w → Continuous φ → Continuous β → HasCompactSupport φ → (∀ x, 0 ≤ φ x ∧ φ x ≤ 1) → MemLp w 2 → (∀ x, |β x| ≤ a * φ x * ‖w x‖) → (∫⁻ x, ENNReal.ofReal (β x ^ 2) ≤ ENNReal.ofReal (a ^ 2 * ∫ x, ‖w x‖ ^ 2)) ∧ (∫⁻ x, ENNReal.ofReal ((φ x ^ 3 * |β x|) ^ 4) ≤ ENNReal.ofReal (a ^ 4 * ((∫ x, ‖w x‖ ^ 2) ^ ((1:ℝ)/2) * (∫ x, φ x ^ 24 * ‖w x‖ ^ 6) ^ ((1:ℝ)/2)))) :=
by
  intro a w φ β ha hw hφ hβ hφc hφ01 hwL2 hβb
  have hWi : Integrable (fun x => ‖w x‖ ^ 2) :=
    (memLp_two_iff_integrable_sq_norm hwL2.aestronglyMeasurable).mp hwL2
  have hW0 : 0 ≤ ∫ x, ‖w x‖ ^ 2 := integral_nonneg fun x => by positivity
  have hWlin : (∫⁻ x, ENNReal.ofReal (‖w x‖ ^ 2)) = ENNReal.ofReal (∫ x, ‖w x‖ ^ 2) :=
    (ofReal_integral_eq_lintegral_ofReal hWi (ae_of_all _ fun x => by positivity)).symm
  have hScs : HasCompactSupport (fun x => φ x ^ 24 * ‖w x‖ ^ 6) := by
    have h1 : HasCompactSupport (fun x => φ x ^ 24) :=
      hφc.comp_left (g := fun t : ℝ => t ^ 24) (by norm_num)
    exact h1.mul_right
  have hSi : Integrable (fun x => φ x ^ 24 * ‖w x‖ ^ 6) :=
    ((hφ.pow 24).mul (hw.norm.pow 6)).integrable_of_hasCompactSupport hScs
  have hSnn : ∀ x, 0 ≤ φ x ^ 24 * ‖w x‖ ^ 6 := fun x =>
    mul_nonneg (pow_nonneg (hφ01 x).1 _) (by positivity)
  have hS0 : 0 ≤ ∫ x, φ x ^ 24 * ‖w x‖ ^ 6 := integral_nonneg hSnn
  have hSlin : (∫⁻ x, ENNReal.ofReal (φ x ^ 24 * ‖w x‖ ^ 6))
      = ENNReal.ofReal (∫ x, φ x ^ 24 * ‖w x‖ ^ 6) :=
    (ofReal_integral_eq_lintegral_ofReal hSi (ae_of_all _ hSnn)).symm
  constructor
  · have hpt : ∀ x, ENNReal.ofReal (β x ^ 2) ≤ ENNReal.ofReal (a ^ 2 * ‖w x‖ ^ 2) := by
      intro x
      apply ENNReal.ofReal_le_ofReal
      have h1 := hβb x
      obtain ⟨h0, h1'⟩ := hφ01 x
      have hn := norm_nonneg (w x)
      have han : 0 ≤ a * ‖w x‖ := mul_nonneg ha hn
      have h2 : |β x| ≤ a * ‖w x‖ := h1.trans (by nlinarith)
      have h3 : |β x| ^ 2 ≤ (a * ‖w x‖) ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h2 2
      rw [sq_abs] at h3
      nlinarith
    calc _ ≤ ∫⁻ x, ENNReal.ofReal (a ^ 2 * ‖w x‖ ^ 2) := lintegral_mono hpt
      _ = ENNReal.ofReal (∫ x, a ^ 2 * ‖w x‖ ^ 2) :=
          (ofReal_integral_eq_lintegral_ofReal (hWi.const_mul _)
            (ae_of_all _ fun x => by positivity)).symm
      _ = _ := by rw [integral_const_mul]
  · have hpt : ∀ x, ENNReal.ofReal ((φ x ^ 3 * |β x|) ^ 4) ≤ ENNReal.ofReal (a ^ 4) *
        (ENNReal.ofReal ‖w x‖ * ENNReal.ofReal (φ x ^ 12 * ‖w x‖ ^ 3)) := by
      intro x
      obtain ⟨h0, h1⟩ := hφ01 x
      have hn := norm_nonneg (w x)
      have hb := abs_nonneg (β x)
      rw [← ENNReal.ofReal_mul hn, ← ENNReal.ofReal_mul (by positivity)]
      apply ENNReal.ofReal_le_ofReal
      have e1 : 0 ≤ φ x ^ 3 * |β x| := mul_nonneg (pow_nonneg h0 3) hb
      have e2 : φ x ^ 3 * |β x| ≤ φ x ^ 3 * (a * φ x * ‖w x‖) :=
        mul_le_mul_of_nonneg_left (hβb x) (pow_nonneg h0 3)
      have e3 : (φ x ^ 3 * |β x|) ^ 4 ≤ (φ x ^ 3 * (a * φ x * ‖w x‖)) ^ 4 :=
        pow_le_pow_left₀ e1 e2 4
      have e4 : φ x ^ 16 ≤ φ x ^ 12 := pow_le_pow_of_le_one h0 h1 (by norm_num)
      have e5 : a ^ 4 * ‖w x‖ ^ 4 * φ x ^ 16 ≤ a ^ 4 * ‖w x‖ ^ 4 * φ x ^ 12 :=
        mul_le_mul_of_nonneg_left e4 (by positivity)
      calc (φ x ^ 3 * |β x|) ^ 4 ≤ (φ x ^ 3 * (a * φ x * ‖w x‖)) ^ 4 := e3
        _ = a ^ 4 * ‖w x‖ ^ 4 * φ x ^ 16 := by ring
        _ ≤ a ^ 4 * ‖w x‖ ^ 4 * φ x ^ 12 := e5
        _ = a ^ 4 * (‖w x‖ * (φ x ^ 12 * ‖w x‖ ^ 3)) := by ring
    have hfm : AEMeasurable (fun x => ENNReal.ofReal ‖w x‖) :=
      hw.norm.measurable.ennreal_ofReal.aemeasurable
    have hgm : AEMeasurable (fun x => ENNReal.ofReal (φ x ^ 12 * ‖w x‖ ^ 3)) :=
      ((hφ.pow 12).mul (hw.norm.pow 3)).measurable.ennreal_ofReal.aemeasurable
    have hCS := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two hfm hgm
    have hF2 : (∫⁻ x, ENNReal.ofReal ‖w x‖ ^ (2:ℝ)) = ENNReal.ofReal (∫ x, ‖w x‖ ^ 2) := by
      rw [← hWlin]
      refine lintegral_congr fun x => ?_
      rw [ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num), Real.rpow_two]
    have hG2 : (∫⁻ x, ENNReal.ofReal (φ x ^ 12 * ‖w x‖ ^ 3) ^ (2:ℝ))
        = ENNReal.ofReal (∫ x, φ x ^ 24 * ‖w x‖ ^ 6) := by
      rw [← hSlin]
      refine lintegral_congr fun x => ?_
      rw [ENNReal.ofReal_rpow_of_nonneg (mul_nonneg (pow_nonneg (hφ01 x).1 _) (by positivity))
        (by norm_num), Real.rpow_two]
      congr 1
      ring
    calc _ ≤ ∫⁻ x, ENNReal.ofReal (a ^ 4) *
          (ENNReal.ofReal ‖w x‖ * ENNReal.ofReal (φ x ^ 12 * ‖w x‖ ^ 3)) := lintegral_mono hpt
      _ = ENNReal.ofReal (a ^ 4) *
          ∫⁻ x, ENNReal.ofReal ‖w x‖ * ENNReal.ofReal (φ x ^ 12 * ‖w x‖ ^ 3) :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      _ ≤ ENNReal.ofReal (a ^ 4) * ((∫⁻ x, ENNReal.ofReal ‖w x‖ ^ (2:ℝ)) ^ (1 / (2:ℝ)) *
          (∫⁻ x, ENNReal.ofReal (φ x ^ 12 * ‖w x‖ ^ 3) ^ (2:ℝ)) ^ (1 / (2:ℝ))) :=
          mul_le_mul_of_nonneg_left hCS zero_le
      _ = _ := by
          rw [hF2, hG2, ENNReal.ofReal_rpow_of_nonneg hW0 (by norm_num),
            ENNReal.ofReal_rpow_of_nonneg hS0 (by norm_num),
            ← ENNReal.ofReal_mul (Real.rpow_nonneg hW0 _), ← ENNReal.ofReal_mul (by positivity)]

theorem flux_comm_arith : ∀ (C₀ M K c V R W S I : ℝ), 0 ≤ C₀ → 0 ≤ M → 0 ≤ K → 0 < c → 0 ≤ V → 1 ≤ R → 0 ≤ W → W ≤ C₀ → 0 ≤ S → 0 ≤ I → S ^ ((1:ℝ)/6) ≤ K * (1 + I ^ ((1:ℝ)/2)) → Real.pi⁻¹ * (16 * Real.pi * (3 * c / R)) ^ ((3:ℝ)/4) * ((2 ^ ((1:ℝ)/3) * (W ^ ((5:ℝ)/6) * S ^ ((1:ℝ)/6) + (2 * M) ^ ((4:ℝ)/3) * (V + W))) ^ ((3:ℝ)/4) * ((8 * c / R) ^ 2 * W) ^ ((1:ℝ)/2) + (W + 2 * M * (V + W)) * ((8 * c / R) ^ 4 * (W ^ ((1:ℝ)/2) * S ^ ((1:ℝ)/2))) ^ ((1:ℝ)/4)) ≤ 2 * ((48 * Real.pi * c) ^ ((3:ℝ)/4) / Real.pi) * (8 * c) * (2 * (C₀ + 2 * M * (V + C₀)) * C₀ ^ ((1:ℝ)/8) * K ^ ((3:ℝ)/4) + 2 ^ ((1:ℝ)/4) * (2 * C₀ ^ ((9:ℝ)/8) * K ^ ((3:ℝ)/4) + 2 * M * (V + C₀) ^ ((3:ℝ)/4) * C₀ ^ ((1:ℝ)/2))) / R * (1 + I ^ ((3:ℝ)/4)) :=
by
  intro C₀ M K c V R W S I hC₀ hM hK hc hV hR hW hWC hS hI hH
  have hR0 : (0:ℝ) < R := lt_of_lt_of_le one_pos hR
  have hpi := Real.pi_pos
  have hI34 : 0 ≤ I ^ ((3:ℝ)/4) := Real.rpow_nonneg hI _
  have hJ1 : 1 ≤ 1 + I ^ ((3:ℝ)/4) := by linarith
  have hJ0 : 0 ≤ 1 + I ^ ((3:ℝ)/4) := by linarith
  have hK34 : 0 ≤ K ^ ((3:ℝ)/4) := Real.rpow_nonneg hK _

  have hS8 : S ^ ((1:ℝ)/8) ≤ 2 * K ^ ((3:ℝ)/4) * (1 + I ^ ((3:ℝ)/4)) := by
    have e1 : S ^ ((1:ℝ)/8) = (S ^ ((1:ℝ)/6)) ^ ((3:ℝ)/4) := by
      rw [← Real.rpow_mul hS]; norm_num
    have hI12 : 0 ≤ I ^ ((1:ℝ)/2) := Real.rpow_nonneg hI _
    have h2 : (S ^ ((1:ℝ)/6)) ^ ((3:ℝ)/4) ≤ (K * (1 + I ^ ((1:ℝ)/2))) ^ ((3:ℝ)/4) :=
      Real.rpow_le_rpow (Real.rpow_nonneg hS _) hH (by norm_num)
    have h3 : (K * (1 + I ^ ((1:ℝ)/2))) ^ ((3:ℝ)/4)
        = K ^ ((3:ℝ)/4) * (1 + I ^ ((1:ℝ)/2)) ^ ((3:ℝ)/4) :=
      Real.mul_rpow hK (by linarith)
    have h4 : (1 + I ^ ((1:ℝ)/2)) ^ ((3:ℝ)/4) ≤ 1 + I ^ ((3:ℝ)/8) := by
      have := Real.rpow_add_le_add_rpow zero_le_one hI12 (by norm_num : (0:ℝ) ≤ 3/4)
        (by norm_num : (3:ℝ)/4 ≤ 1)
      rw [Real.one_rpow, ← Real.rpow_mul hI] at this
      have e : (1:ℝ)/2 * (3/4) = 3/8 := by norm_num
      rw [e] at this
      exact this
    have h5 : I ^ ((3:ℝ)/8) ≤ 1 + I ^ ((3:ℝ)/4) := by
      rcases le_total I 1 with hI1 | hI1
      · have := Real.rpow_le_one hI hI1 (by norm_num : (0:ℝ) ≤ 3/8); linarith
      · have := Real.rpow_le_rpow_of_exponent_le hI1 (by norm_num : (3:ℝ)/8 ≤ 3/4); linarith
    calc S ^ ((1:ℝ)/8) ≤ K ^ ((3:ℝ)/4) * (1 + I ^ ((3:ℝ)/8)) := by
          rw [e1]
          calc _ ≤ _ := h2
            _ = _ := h3
            _ ≤ _ := mul_le_mul_of_nonneg_left h4 hK34
      _ ≤ K ^ ((3:ℝ)/4) * (2 * (1 + I ^ ((3:ℝ)/4))) :=
          mul_le_mul_of_nonneg_left (by linarith) hK34
      _ = _ := by ring

  have hb : 0 ≤ 8 * c / R := by positivity
  have hb2 : ((8 * c / R) ^ 2 * W) ^ ((1:ℝ)/2) = (8 * c / R) * W ^ ((1:ℝ)/2) := by
    rw [Real.mul_rpow (pow_nonneg hb 2) hW]
    congr 1
    rw [← Real.rpow_natCast, ← Real.rpow_mul hb]; norm_num
  have hb4 : ((8 * c / R) ^ 4 * (W ^ ((1:ℝ)/2) * S ^ ((1:ℝ)/2))) ^ ((1:ℝ)/4)
