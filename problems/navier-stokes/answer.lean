        congr 2
        ring
    · intro y hy; exact mem_Iic.2 hy.2
    · intro y hy
      obtain ⟨hy1, hy2⟩ := hy
      have hyY : y < Y3 := by
        simp only [mem_Icc, not_and_or, not_le] at hy2
        rcases hy2 with h | h
        · exact h
        · exact absurd (mem_Iic.1 hy1) (not_le.2 h)
      rw [R0z _ (by nlinarith)]; ring

  have WB : ∀ s : ℝ, 3 / 20 ≤ s → s ≤ 3 →
      (∫ y in Iic Y4, Real.exp (w y) * rfpBmp (y - Y4 + s) ^ 2) ≤ D := by
    intro s hs1 hs2
    have hlohi : Y4 - s - 3 / 20 ≤ Y4 - s + 3 / 20 := by linarith
    have hf0 : ∀ y, 0 ≤ Real.exp (w y) * rfpBmp (y - Y4 + s) ^ 2 := fun y => by positivity
    rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero
      (s := Icc (Y4 - s - 3 / 20) (Y4 - s + 3 / 20)) measurableSet_Iic ?_ ?_]
    · have hm : (∫ y in Icc (Y4 - s - 3 / 20) (Y4 - s + 3 / 20), Real.exp (w y) * rfpBmp (y - Y4 + s) ^ 2)
          ≤ ∫ y in Icc (Y4 - s - 3 / 20) (Y4 - s + 3 / 20), D := by
