  have hA0nn : 0 ≤ A0 := by
    rw [hA0def]
    exact intervalIntegral.integral_nonneg (Real.exp_pos _).le (fun x _ => by positivity)
  have hmass' : A0 + Φ 0 ≤ P.lam ^ 29 * N5 := by
    rw [hA0def, hΦ0, hN5def]; exact hmass

  have hfirst : ∀ η : ℝ, (∫ y in y4..y4 + 60, Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) *
      ((1 + η ^ 2)⁻¹) ^ (rfpTh P y)) = Φ (Real.log (1 + η ^ 2)) := by
    intro η
    rw [hΦ_s]
    apply intervalIntegral.integral_congr
    intro y _
    beta_reduce
    have hpos : (0:ℝ) < (1 + η ^ 2)⁻¹ := by positivity
    rw [Real.rpow_def_of_pos hpos, Real.log_inv,
      show -Real.log (1 + η ^ 2) * rfpTh P y = -(rfpTh P y * Real.log (1 + η ^ 2)) by ring]
  have hlast : ∀ c : ℝ, (∫ y in y5 - 4..y5, Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) *
      Real.sqrt (1 + c * rfpPsi P y)) = N5 * ∫ s in (-4:ℝ)..0, u s * Real.sqrt (1 + c * v s) := by
    intro c
    have e1 : (∫ s in (-4:ℝ)..0, Real.sqrt 2 * Real.exp (3 / 2 * (s + y5) + rfpLam P (s + y5)) *
        Real.sqrt (1 + c * rfpPsi P (s + y5))) = ∫ y in (-4:ℝ) + y5..0 + y5,
        Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * Real.sqrt (1 + c * rfpPsi P y) :=
      intervalIntegral.integral_comp_add_right (fun y => Real.sqrt 2 *
        Real.exp (3 / 2 * y + rfpLam P y) * Real.sqrt (1 + c * rfpPsi P y)) y5
    rw [show (-4:ℝ) + y5 = y5 - 4 by ring, zero_add] at e1
    rw [← e1, ← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr
    intro s hs
    rw [Set.uIcc_of_le (by norm_num : (-4:ℝ) ≤ 0)] at hs
    beta_reduce
    have hΛs := hΛaff (s + y5) (by linarith [hs.1]) (by linarith [hs.2])
    have hexp : Real.exp (3 / 2 * (s + y5) + rfpLam P (s + y5)) =
        Real.exp (3 / 2 * y5 + rfpLam P y5) * Real.exp ((1 - P.lam) * s) := by
      rw [← Real.exp_add, hΛs]; congr 1; ring
    have hψs : rfpPsi P (s + y5) = v s := by
      rw [show s + y5 = y5 + s from add_comm _ _, hψtr s, hv_s]
    rw [hexp, hψs, hN5def, hu_s]
    ring
  have hGK : ∀ c : ℝ, G c = (∫ s in (-4:ℝ)..0, u s * Real.sqrt (1 + c * v s)) -
      ∫ s in (-4:ℝ)..0, u s := by
    intro c
    have h1 : IntervalIntegrable (fun s => u s * Real.sqrt (1 + c * v s)) volume (-4) 0 :=
      Continuous.intervalIntegrable (by fun_prop) _ _
    have h2 : IntervalIntegrable u volume (-4) 0 := huc.intervalIntegrable _ _
    rw [hG_s, ← intervalIntegral.integral_sub h1 h2]
    apply intervalIntegral.integral_congr
    intro s _
    beta_reduce
    ring

  have hκ7 : 7 ≤ Real.exp (2 + 4 * P.lam) := by
    have he1' := Real.exp_one_gt_d9
    have he2 : Real.exp 2 = Real.exp 1 * Real.exp 1 := by rw [← Real.exp_add]; norm_num
    have : Real.exp 2 ≤ Real.exp (2 + 4 * P.lam) := Real.exp_le_exp.mpr (by linarith)
    nlinarith [Real.exp_pos 1]
  have hκ8 : Real.exp (2 + 4 * P.lam) ≤ 8 := by
    have he1 := Real.exp_one_lt_d9
    have he2 : Real.exp 2 = Real.exp 1 * Real.exp 1 := by rw [← Real.exp_add]; norm_num
    have hsplit : Real.exp (2 + 4 * P.lam) = Real.exp 2 * Real.exp (4 * P.lam) := Real.exp_add _ _
    have hm : Real.exp (4 * P.lam) * Real.exp (-(4 * P.lam)) = 1 := by
      rw [← Real.exp_add]; simp
    have hl := Real.add_one_le_exp (-(4 * P.lam))
    have hq : Real.exp (4 * P.lam) * (-(4 * P.lam) + 1) ≤ 1 := by
      have h := mul_le_mul_of_nonneg_left hl (Real.exp_pos (4 * P.lam)).le
      linarith
    have h4 : Real.exp (4 * P.lam) ≤ 25 / 24 := by
      nlinarith [mul_nonneg (Real.exp_pos (4 * P.lam)).le
        (by linarith : (0:ℝ) ≤ 1 / 25 - 4 * P.lam)]
    have h2 : Real.exp 2 < 739 / 100 := by rw [he2]; nlinarith [Real.exp_pos 1]
    have h5 := mul_le_mul h2.le h4 (Real.exp_pos _).le (by norm_num)
    rw [hsplit]; linarith
  refine ⟨N5, G, δ, hN5, ?_, ?_, ?_, ?_, ?_, ?_, hψ8, ?_⟩
  · rw [hGdef]; exact hGs
  · rw [hG_s]; simp
  · intro c h1 h2
    have hd : HasDerivAt G (∫ s in (-4:ℝ)..0, u s * v s / (2 * Real.sqrt (1 + c * v s))) c := by
      rw [hGdef]; exact hGd c (by linarith) (by linarith)
    rw [hd.deriv, hu, hv]
    exact bump_slope_bound rfpBmp P.lam (Real.exp (2 + 4 * P.lam)) c hbc hb01 hbsupp hblow
      hlam0 hlam1 hκ7 hκ8 (abs_le.mpr ⟨h1, h2⟩)
  · have hsq : ContDiff ℝ ∞ (fun e : ℝ => 1 + e ^ 2) := by fun_prop
    have hinvc : ContDiff ℝ ∞ (fun e : ℝ => (1 + e ^ 2)⁻¹) := hsq.inv (fun e => by positivity)
    have hlogc : ContDiff ℝ ∞ (fun e : ℝ => Real.log (1 + e ^ 2)) :=
      hsq.log (fun e => by positivity)
    have hΦJc : ContDiff ℝ ∞ (fun e : ℝ => Φ (Real.log (1 + e ^ 2))) := hΦs.comp hlogc
    rw [hδdef]
    exact (((contDiff_const.sub hinvc).mul contDiff_const).add
      (contDiff_const.sub hΦJc)).div_const N5
  · rw [hδ_s]; simp
  · intro η
    have h1η : (1:ℝ) ≤ 1 + η ^ 2 := by nlinarith [sq_nonneg η]
    have hJ : 0 ≤ Real.log (1 + η ^ 2) := Real.log_nonneg h1η
    have hf1 : (1 + η ^ 2)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ h1η
    have hf0 : 0 < (1 + η ^ 2)⁻¹ := by positivity
    have hΦJ := hΦle _ hJ
    have hΦJ0 := hΦnn (Real.log (1 + η ^ 2))
    have hfA : 0 ≤ (1 - (1 + η ^ 2)⁻¹) * A0 := mul_nonneg (sub_nonneg.mpr hf1) hA0nn
    have hfA' : (1 - (1 + η ^ 2)⁻¹) * A0 ≤ A0 := by nlinarith [mul_nonneg hf0.le hA0nn]
    refine ⟨?_, ?_, ?_⟩
    · rw [hδ_s]; exact div_nonneg (by linarith) hN5.le
    · rw [hδ_s, div_le_iff₀ hN5]; linarith
    · have hq : HasDerivAt (fun e : ℝ => 1 + e ^ 2) (2 * η) η := by
        simpa using (hasDerivAt_pow 2 η).const_add 1
      have hq0 : (1 + η ^ 2) ≠ 0 := by positivity
      have hinvd := hq.inv hq0
      have hlogd := hq.log hq0
      have hΦJd := (hΦd (Real.log (1 + η ^ 2))).comp η hlogd
      have hall := (((hinvd.const_sub 1).mul_const A0).add (hΦJd.const_sub (Φ 0))).div_const N5
      have hδd : HasDerivAt δ ((-(-(2 * η) / (1 + η ^ 2) ^ 2) * A0 +
          -(Φd (Real.log (1 + η ^ 2)) * (2 * η / (1 + η ^ 2)))) / N5) η := by
        rw [hδdef]; exact hall
      rw [hδd.deriv, abs_div, abs_of_pos hN5, div_le_iff₀ hN5, neg_div, neg_neg]
      have hp1 : (0:ℝ) < 1 + η ^ 2 := by positivity
      have hp2 : (0:ℝ) < (1 + η ^ 2) ^ 2 := by positivity
      have ha : |2 * η / (1 + η ^ 2) ^ 2| ≤ 1 := by
        rw [abs_div, abs_of_pos hp2, div_le_one hp2]
        exact abs_le.mpr ⟨by nlinarith [sq_nonneg (η + 1), sq_nonneg η, sq_nonneg (η ^ 2)],
          by nlinarith [sq_nonneg (η - 1), sq_nonneg η, sq_nonneg (η ^ 2)]⟩
      have hb : |2 * η / (1 + η ^ 2)| ≤ 1 := by
        rw [abs_div, abs_of_pos hp1, div_le_one hp1]
        exact abs_le.mpr ⟨by nlinarith [sq_nonneg (η + 1)], by nlinarith [sq_nonneg (η - 1)]⟩
      have hY : |Φd (Real.log (1 + η ^ 2))| ≤ Φ 0 :=
        abs_le.mpr ⟨hΦd_lo _ hJ, by linarith [hΦd_hi _ hJ, hΦnn 0]⟩
      calc |2 * η / (1 + η ^ 2) ^ 2 * A0 + -(Φd (Real.log (1 + η ^ 2)) * (2 * η / (1 + η ^ 2)))|
          ≤ |2 * η / (1 + η ^ 2) ^ 2 * A0| +
              |-(Φd (Real.log (1 + η ^ 2)) * (2 * η / (1 + η ^ 2)))| := abs_add_le _ _
        _ = |2 * η / (1 + η ^ 2) ^ 2| * A0 +
              |Φd (Real.log (1 + η ^ 2))| * |2 * η / (1 + η ^ 2)| := by
            rw [abs_neg, abs_mul, abs_mul, abs_of_nonneg hA0nn]
        _ ≤ 1 * A0 + Φ 0 * 1 := add_le_add (mul_le_mul_of_nonneg_right ha hA0nn)
              (mul_le_mul hY hb (abs_nonneg _) (hΦnn 0))
        _ ≤ P.lam ^ 29 * N5 := by linarith
  · intro ca η _
    have hf00 : (1 + (0:ℝ) ^ 2)⁻¹ = 1 := by norm_num
    have hJ00 : Real.log (1 + (0:ℝ) ^ 2) = 0 := by norm_num
    rw [← hA0def] at hwin
    rw [hwin ca η, hwin ca 0, hfirst η, hfirst 0, hlast (ca η), hlast (ca 0), hf00, hJ00]
    linear_combination hNδ η - N5 * hGK (ca η) + N5 * hGK (ca 0)

theorem smooth_inverse_of_strict_anti : ∀ (G d : ℝ → ℝ) (a b cs : ℝ), 0 < a → a < b → 0 < cs → ContDiffOn ℝ ∞ G (Ioo (-b) b) → G 0 = 0 → (∀ c : ℝ, -a ≤ c → c ≤ a → deriv G c ≤ -cs) → ContDiff ℝ ∞ d → (∀ η : ℝ, |d η| < cs * a) → ∃ g : ℝ → ℝ, ContDiff ℝ ∞ g ∧ ∀ η : ℝ, G (g η) = d η ∧ |g η| ≤ |d η| / cs ∧ |deriv g η| ≤ |deriv d η| / cs :=
by
  intro G d a b cs ha hab hcs hGs hG0 hGd hds hdb
  have hsub : Icc (-a) a ⊆ Ioo (-b) b := fun x hx => ⟨by linarith [hx.1], by linarith [hx.2]⟩
  have hsub' : Ioo (-a) a ⊆ Ioo (-b) b := Ioo_subset_Icc_self.trans hsub
  have hcont : ContinuousOn G (Icc (-a) a) := hGs.continuousOn.mono hsub
  have hdiff : DifferentiableOn ℝ G (Ioo (-b) b) := hGs.differentiableOn (by simp)
  have hmvt : ∀ x₁ x₂ : ℝ, -a ≤ x₁ → x₁ ≤ x₂ → x₂ ≤ a → G x₂ - G x₁ ≤ -cs * (x₂ - x₁) := by
    intro x₁ x₂ h1 h12 h2
    exact (convex_Icc (-a) a).image_sub_le_mul_sub_of_deriv_le hcont
      (by rw [interior_Icc]; exact hdiff.mono hsub')
      (fun x hx => by rw [interior_Icc] at hx; exact hGd x hx.1.le hx.2.le)
      x₁ ⟨h1, by linarith⟩ x₂ ⟨by linarith, h2⟩ h12
  have hGa : G a ≤ -cs * a := by
    have := hmvt 0 a (by linarith) ha.le le_rfl
    rw [hG0] at this; linarith
  have hGma : cs * a ≤ G (-a) := by
    have := hmvt (-a) 0 le_rfl (by linarith) ha.le
    rw [hG0] at this; linarith
  obtain ⟨H, hH⟩ : ∃ H : ℝ → ℝ, H = Function.invFunOn G (Icc (-a) a) := ⟨_, rfl⟩
  have hHprop : ∀ y : ℝ, |y| < cs * a → H y ∈ Ioo (-a) a ∧ G (H y) = y ∧ |H y| ≤ |y| / cs ∧
      ∀ x : ℝ, -a ≤ x → x ≤ a → G x = y → x = H y := by
    intro y hy
    obtain ⟨hy1, hy2⟩ := abs_lt.mp hy
    have hex : ∃ x ∈ Icc (-a) a, G x = y :=
      intermediate_value_Icc' (by linarith : -a ≤ a) hcont ⟨by linarith, by linarith⟩
    have hmem : H y ∈ Icc (-a) a := by rw [hH]; exact Function.invFunOn_mem hex
    have heq : G (H y) = y := by rw [hH]; exact Function.invFunOn_eq hex
    have hne1 : H y ≠ a := by intro h; rw [h] at heq; linarith
    have hne2 : H y ≠ -a := by intro h; rw [h] at heq; linarith
    refine ⟨⟨lt_of_le_of_ne hmem.1 (Ne.symm hne2), lt_of_le_of_ne hmem.2 hne1⟩, heq, ?_, ?_⟩
    · rw [le_div_iff₀ hcs]
      rcases le_or_gt 0 (H y) with h | h
      · have := hmvt 0 (H y) (by linarith) h hmem.2
        rw [hG0, heq] at this
        rw [abs_of_nonneg h]; linarith [neg_abs_le y]
      · have := hmvt (H y) 0 hmem.1 h.le ha.le
        rw [hG0, heq] at this
        rw [abs_of_neg h]; linarith [le_abs_self y]
    · intro x hx1 hx2 hx
      rcases lt_trichotomy x (H y) with h | h | h
      · have := hmvt x (H y) hx1 h.le hmem.2
        rw [heq, hx] at this
        exfalso; nlinarith [mul_pos hcs (sub_pos.mpr h)]
      · exact h
      · have := hmvt (H y) x hmem.1 h.le hx2
        rw [heq, hx] at this
        exfalso; nlinarith [mul_pos hcs (sub_pos.mpr h)]
  have hloc : ∀ y : ℝ, |y| < cs * a → ContDiffAt ℝ ∞ H y ∧ HasDerivAt H (deriv G (H y))⁻¹ y := by
    intro y₀ hy₀
    obtain ⟨hx₀, hGx₀, -, -⟩ := hHprop y₀ hy₀
    have hG : ContDiffAt ℝ ∞ G (H y₀) :=
      hGs.contDiffAt (Ioo_mem_nhds (by linarith [hx₀.1]) (by linarith [hx₀.2]))
    have hD : deriv G (H y₀) ≠ 0 := by
      have := hGd (H y₀) hx₀.1.le hx₀.2.le
      intro h; linarith
    have hGd' : HasDerivAt G (deriv G (H y₀)) (H y₀) := (hG.differentiableAt (by simp)).hasDerivAt
    have hf' := hGd'.hasFDerivAt_equiv hD
    have hn : (∞ : WithTop ℕ∞) ≠ 0 := by simp
    have hLs := hG.to_localInverse hf' hn
    have hL0 := hG.localInverse_apply_image hf' hn
    have hLr : ∀ᶠ y in nhds (G (H y₀)), G (hG.localInverse hf' hn y) = y :=
      (hG.hasStrictFDerivAt' hf' hn).eventually_right_inverse
    obtain ⟨L, hL⟩ : ∃ L : ℝ → ℝ, L = hG.localInverse hf' hn := ⟨_, rfl⟩
    rw [← hL] at hLs hL0 hLr
    rw [hGx₀] at hLs hL0 hLr
    have hU : ∀ᶠ y in nhds y₀, |y| < cs * a :=
      (isOpen_lt continuous_abs continuous_const).mem_nhds hy₀
    have hLin : ∀ᶠ y in nhds y₀, L y ∈ Ioo (-a) a :=
      hLs.continuousAt.eventually_mem (by rw [hL0]; exact Ioo_mem_nhds hx₀.1 hx₀.2)
    have heqv : H =ᶠ[nhds y₀] L := by
      filter_upwards [hU, hLin, hLr] with y hy hy2 hy3
      exact ((hHprop y hy).2.2.2 (L y) hy2.1.le hy2.2.le hy3).symm
    have hHs : ContDiffAt ℝ ∞ H y₀ := hLs.congr_of_eventuallyEq heqv
    refine ⟨hHs, ?_⟩
    exact HasDerivAt.of_local_left_inverse hHs.continuousAt hGd' hD
      (by filter_upwards [hU] with y hy; exact (hHprop y hy).2.1)
  refine ⟨fun η => H (d η), ?_, ?_⟩
  · rw [contDiff_iff_contDiffAt]
    intro η
    exact (hloc (d η) (hdb η)).1.comp η hds.contDiffAt
  · intro η
    obtain ⟨hmem, heq, hb, -⟩ := hHprop (d η) (hdb η)
    refine ⟨heq, hb, ?_⟩
    have hdd : HasDerivAt d (deriv d η) η := (hds.differentiable (by simp) η).hasDerivAt
    have hc := (hloc (d η) (hdb η)).2.comp η hdd
    rw [show (fun η => H (d η)) = H ∘ d from rfl, hc.deriv]
    have hDle := hGd (H (d η)) hmem.1.le hmem.2.le
    have hDabs : cs ≤ |deriv G (H (d η))| := by
      rw [abs_of_neg (by linarith)]; linarith
    rw [abs_mul, abs_inv, inv_mul_eq_div]
    exact div_le_div_of_nonneg_left (abs_nonneg _) hcs hDabs

theorem rfp_clamp_identities : ∀ P : RfpPar, RfpRegime P → (1 ≤ rfpY4 P.Md P.lam ∧ rfpY4 P.Md P.lam ≤ rfpY5 P.Md P.lam ∧ rfpY5 P.Md P.lam ≤ rfpYb P.Md P.lam P.T1 P.Lh) ∧ (∀ y η : ℝ, y ≤ rfpY4 P.Md P.lam → ((1 + η ^ 2)⁻¹) ^ (rfpTh P y) * Real.sqrt (1 + P.ca η * rfpPsi P y) = (1 + η ^ 2)⁻¹) ∧ (∀ y η : ℝ, rfpY5 P.Md P.lam ≤ y → ((1 + η ^ 2)⁻¹) ^ (rfpTh P y) * Real.sqrt (1 + P.ca η * rfpPsi P y) = 1) ∧ (∀ y η : ℝ, y ≤ 1 → η * rfpK P.Md y + rfpE P y η * rfpRb P y η = 4 * η) ∧ (∀ y η : ℝ, rfpY4 P.Md P.lam ≤ y → η * rfpK P.Md y + rfpE P y η * rfpRb P y η = 0) :=
by
  intro P hReg
  obtain ⟨hMd, hPst, hl0, hl100, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hReg
  have hs0 : ∀ t : ℝ, t ≤ 0 → sigA t = 0 := fun t ht => by
    unfold sigA; rw [if_pos ht]
  have hs1 : ∀ t : ℝ, 1 ≤ t → sigA t = 1 := fun t ht => by
    unfold sigA; rw [if_neg (by linarith), if_pos ht]
  have hbm : ∀ t : ℝ, t ≤ -(3 / 20) → rfpBmp t = 0 := by
    intro t ht
    have e : t / (3 / 20) = 20 * t / 3 := by ring
    unfold rfpBmp
    rw [hs0 (1 + t / (3 / 20)) (by rw [e]; linarith), zero_mul]
  have hbp : ∀ t : ℝ, 3 / 20 ≤ t → rfpBmp t = 0 := by
    intro t ht
    have e : t / (3 / 20) = 20 * t / 3 := by ring
    unfold rfpBmp
    rw [hs0 (1 - t / (3 / 20)) (by rw [e]; linarith), mul_zero]
  have hR0n : ∀ ξ : ℝ, ξ ≤ 0 → rfpR0 ξ = 0 := by
    intro ξ hξ
    unfold rfpR0
    have hI : (∫ v in (0:ℝ)..ξ, sigA (50 * v)) = ∫ v in (0:ℝ)..ξ, (0:ℝ) := by
      apply intervalIntegral.integral_congr
      intro v hv
      rw [Set.uIcc_of_ge hξ] at hv
      exact hs0 (50 * v) (by linarith [hv.2])
    rw [hI, intervalIntegral.integral_zero, zero_mul]
  have hR0p : ∀ ξ : ℝ, 11 ≤ ξ → rfpR0 ξ = 0 := by
    intro ξ hξ
    unfold rfpR0
    rw [hs1 (ξ - 10) (by linarith), sub_self, mul_zero]
  have hL : 0 ≤ Real.log (1 / P.lam) :=
    Real.log_nonneg (by rw [le_div_iff₀ hl0]; linarith)
  have h13 : 0 < 13 / P.lam := by positivity
  have hh1 : P.h < 1 := by nlinarith [mul_le_mul_of_nonneg_left hl100 hl0.le]
  have hLh1 : 0 ≤ Real.log (1 / P.h) :=
    Real.log_nonneg (by rw [le_div_iff₀ hh0]; linarith)
  have hE := Real.exp_pos P.Md
  have hY3 : rfpY3 P.Md P.lam = Real.exp P.Md + 12 + 60 * Real.log (1 / P.lam) := by
    unfold rfpY3 rfpY2; ring
  have hY4 : rfpY4 P.Md P.lam = rfpY3 P.Md P.lam + 13 / P.lam := rfl
  have hY5 : rfpY5 P.Md P.lam = rfpY4 P.Md P.lam + 60 + 30 * Real.log (1 / P.lam) := rfl
  have hYb : rfpYb P.Md P.lam P.T1 P.Lh = rfpY5 P.Md P.lam + 2 + P.T1 + P.Lh + 3 := rfl
  have hTh1 : ∀ y, y ≤ rfpY4 P.Md P.lam → rfpTh P y = 1 := by
    intro y hy
    unfold rfpTh
    rw [hs0 ((y - rfpY4 P.Md P.lam) / 60)
      (by rw [div_le_iff₀ (by norm_num : (0:ℝ) < 60)]; linarith), sub_zero]
  have hTh0 : ∀ y, rfpY5 P.Md P.lam ≤ y → rfpTh P y = 0 := by
    intro y hy
    unfold rfpTh
    rw [hs1 ((y - rfpY4 P.Md P.lam) / 60)
      (by rw [le_div_iff₀ (by norm_num : (0:ℝ) < 60)]; linarith), sub_self]
  have hPsi : ∀ y, (y ≤ rfpY4 P.Md P.lam ∨ rfpY5 P.Md P.lam ≤ y) → rfpPsi P y = 0 := by
    intro y hy
    unfold rfpPsi
    rcases hy with hy | hy
    · rw [hbm (y - rfpY5 P.Md P.lam + 3) (by linarith),
        hbm (y - rfpY5 P.Md P.lam + 1) (by linarith), mul_zero, sub_zero]
    · rw [hbp (y - rfpY5 P.Md P.lam + 3) (by linarith),
        hbp (y - rfpY5 P.Md P.lam + 1) (by linarith), mul_zero, sub_zero]
  have hRb : ∀ y η, (y ≤ 1 ∨ rfpY4 P.Md P.lam ≤ y) → rfpRb P y η = 0 := by
    intro y η hy
    unfold rfpRb
    rcases hy with hy | hy
    · have hn : P.lam * (y - rfpY3 P.Md P.lam) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos hl0.le (by linarith)
      rw [hR0n _ hn, hbm (y - rfpY4 P.Md P.lam + 3) (by linarith),
        hbm (y - rfpY4 P.Md P.lam + 1) (by linarith)]
      ring
    · have e : P.lam * (13 / P.lam) = 13 := by field_simp
      have hm := mul_le_mul_of_nonneg_left
        (show 13 / P.lam ≤ y - rfpY3 P.Md P.lam by linarith) hl0.le
      have hn : 11 ≤ P.lam * (y - rfpY3 P.Md P.lam) := by linarith
      rw [hR0p _ hn, hbp (y - rfpY4 P.Md P.lam + 3) (by linarith),
        hbp (y - rfpY4 P.Md P.lam + 1) (by linarith)]
      ring
  have hK4 : ∀ y, y ≤ 1 → rfpK P.Md y = 4 := fun y hy => by
    unfold rfpK; rw [if_pos hy]
  have hK0 : ∀ y, rfpY4 P.Md P.lam ≤ y → rfpK P.Md y = 0 := by
    intro y hy
    have hy0 : 0 < y := by linarith
    have hlog : P.Md ≤ Real.log y := by
      rw [Real.le_log_iff_exp_le hy0]; linarith
    unfold rfpK
    rw [if_neg (by linarith), hs1 (Real.log y / P.Md) (by rw [le_div_iff₀ hMd]; linarith),
      sub_self, mul_zero]
  refine ⟨⟨by linarith, by linarith, by linarith⟩, ?_, ?_, ?_, ?_⟩
  · intro y η hy
    rw [hTh1 y hy, hPsi y (Or.inl hy), mul_zero, add_zero, Real.sqrt_one, mul_one,
      Real.rpow_one]
  · intro y η hy
    rw [hTh0 y hy, hPsi y (Or.inr hy), mul_zero, add_zero, Real.sqrt_one, mul_one,
      Real.rpow_zero]
  · intro y η hy
    rw [hK4 y hy, hRb y η (Or.inl hy)]
    ring
  · intro y η hy
    rw [hK0 y hy, hRb y η (Or.inr hy)]
    ring

theorem rfp_sig_basics : (∀ y : ℝ, y ≤ 0 → sigA y = 0) ∧ (∀ y : ℝ, 1 ≤ y → sigA y = 1) ∧ (∀ y : ℝ, 0 ≤ sigA y ∧ sigA y ≤ 1) ∧ Continuous sigA ∧ Continuous rfpSigI ∧ (∀ t : ℝ, t ≤ 0 → rfpSigI t = 0) ∧ (∀ t : ℝ, 1 ≤ t → rfpSigI t = t - 1 + rfpSigI 1) ∧ 0 ≤ rfpSigI 1 ∧ rfpSigI 1 ≤ 1 :=
by
  have h1 : ∀ y : ℝ, y ≤ 0 → sigA y = 0 := by
    intro y hy
    unfold sigA
    rw [if_pos hy]
  have h2 : ∀ y : ℝ, 1 ≤ y → sigA y = 1 := by
    intro y hy
    unfold sigA
    rw [if_neg (by linarith), if_pos hy]
  have h3 : ∀ y : ℝ, 0 ≤ sigA y ∧ sigA y ≤ 1 := by
    intro y
    unfold sigA
    split_ifs
    · norm_num
    · norm_num
    · have ha := Real.exp_pos (-1 / y ^ 2)
      have hb := Real.exp_pos (-1 / (1 - y) ^ 2)
      refine ⟨div_nonneg ha.le (by linarith), ?_⟩
      rw [div_le_one (by linarith)]
      linarith
  have hcont : Continuous sigA := by
    set G : ℝ → ℝ := fun y => expNegInvGlue (max y 0 ^ 2) with hG
    have hGc : Continuous G :=
      ((expNegInvGlue.contDiff (n := 0)).continuous).comp ((continuous_id.max continuous_const).pow 2)
    have hG0 : ∀ y : ℝ, y ≤ 0 → G y = 0 := by
      intro y hy
      simp only [hG, max_eq_right hy]
      exact expNegInvGlue.zero_of_nonpos (by norm_num)
    have hGp : ∀ y : ℝ, 0 < y → G y = Real.exp (-1 / y ^ 2) := by
      intro y hy
      simp only [hG, max_eq_left hy.le]
      unfold expNegInvGlue
      rw [if_neg (not_le.mpr (pow_pos hy 2)), neg_div, one_div]
    have hGpos : ∀ y : ℝ, 0 < y → 0 < G y := by
      intro y hy
      rw [hGp y hy]; exact Real.exp_pos _
    have hGnn : ∀ y : ℝ, 0 ≤ G y := by
      intro y
      rcases le_or_gt y 0 with hy | hy
      · rw [hG0 y hy]
      · exact (hGpos y hy).le
    have hden : ∀ y : ℝ, G y + G (1 - y) ≠ 0 := by
      intro y
      rcases le_or_gt y 0 with hy | hy
      · have := hGpos (1 - y) (by linarith)
        have := hGnn y
        linarith
      · have := hGpos y hy
        have := hGnn (1 - y)
        linarith
    have heq : sigA = fun y => G y / (G y + G (1 - y)) := by
      funext y
      unfold sigA
      split_ifs with hy0 hy1
      · rw [hG0 y hy0, zero_div]
      · rw [hG0 (1 - y) (by linarith), add_zero, div_self (hGpos y (by linarith)).ne']
      · push_neg at hy0 hy1
        rw [hGp y hy0, hGp (1 - y) (by linarith)]
    rw [heq]
    exact hGc.div (hGc.add (hGc.comp (continuous_const.sub continuous_id))) hden
  have hII : ∀ a b : ℝ, IntervalIntegrable sigA MeasureTheory.volume a b :=
    fun a b => hcont.intervalIntegrable a b
  have hS : Continuous rfpSigI := by
    show Continuous (fun t => ∫ s in (0:ℝ)..t, sigA s)
    exact intervalIntegral.continuous_primitive hII 0
  have h6 : ∀ t : ℝ, t ≤ 0 → rfpSigI t = 0 := by
    intro t ht
    show (∫ s in (0:ℝ)..t, sigA s) = 0
    rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ))]
    · simp
    · intro s hs
      rw [Set.uIcc_of_ge ht] at hs
      exact h1 s hs.2
  have h7 : ∀ t : ℝ, 1 ≤ t → rfpSigI t = t - 1 + rfpSigI 1 := by
    intro t ht
    show (∫ s in (0:ℝ)..t, sigA s) = t - 1 + ∫ s in (0:ℝ)..1, sigA s
    rw [← intervalIntegral.integral_add_adjacent_intervals (hII 0 1) (hII 1 t)]
    have e : (∫ s in (1:ℝ)..t, sigA s) = ∫ s in (1:ℝ)..t, (1:ℝ) := by
      apply intervalIntegral.integral_congr
      intro s hs
      rw [Set.uIcc_of_le ht] at hs
      exact h2 s hs.1
    rw [e, intervalIntegral.integral_const, smul_eq_mul, mul_one]
    ring
  have h8 : 0 ≤ rfpSigI 1 := by
    show 0 ≤ ∫ s in (0:ℝ)..1, sigA s
    exact intervalIntegral.integral_nonneg (by norm_num) (fun u _ => (h3 u).1)
  have h9 : rfpSigI 1 ≤ 1 := by
    show (∫ s in (0:ℝ)..1, sigA s) ≤ 1
    have := intervalIntegral.integral_mono_on (by norm_num : (0:ℝ) ≤ 1) (hII 0 1)
      (intervalIntegrable_const : IntervalIntegrable (fun _ => (1:ℝ)) MeasureTheory.volume 0 1)
      (fun x _ => (h3 x).2)
    simpa using this
  exact ⟨h1, h2, h3, hcont, hS, h6, h7, h8, h9⟩

theorem rfp_lh_shift_head : ∀ P : RfpPar, RfpRegime P → ∀ L : ℝ, 0 ≤ L → (∀ y : ℝ, rfpPsi { P with Lh := L } y = rfpPsi P y) ∧ ∀ y : ℝ, y ≤ rfpY5 P.Md P.lam + 2 + P.T1 → rfpLam { P with Lh := L } y = rfpLam P y ∧ ∀ η : ℝ, rfpE { P with Lh := L } y η = rfpE P y η :=
by
  intro P hReg L hL
  obtain ⟨_hMd, _hPst, hlam0, hlam1, hh0, hhl, _hρ0, _hρh, hT1, hLhP⟩ := hReg
  have hh1 : P.h ≤ 1 := by nlinarith
  have hlog : 0 ≤ Real.log (1 / P.h) := Real.log_nonneg (one_le_one_div hh0 hh1)
  have hT0 : 0 ≤ P.T1 := by linarith
  have hsig0 : ∀ z : ℝ, z ≤ 0 → sigA z = 0 := fun z hz => by unfold sigA; rw [if_pos hz]
  have htail : ∀ M : ℝ, 0 ≤ M → ∀ y : ℝ, y ≤ rfpY5 P.Md P.lam + 2 + P.T1 →
      tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 M)) (Real.exp y) = 1 - P.ρ := by
    intro M hM y hy
    unfold tailFac
    rw [← Real.exp_sub, Real.log_exp, hsig0]
    · ring
    · unfold rfpYb; linarith
  have hlam : ∀ y : ℝ, y ≤ rfpY5 P.Md P.lam + 2 + P.T1 →
      rfpLam { P with Lh := L } y = rfpLam P y := by
    intro y hy
    unfold rfpLam
    dsimp only
    rw [htail L hL y hy, htail P.Lh hLhP y hy]
  have hbmp : ∀ y k : ℝ, 1 ≤ k → rfpY5 P.Md P.lam + 2 + P.T1 < y →
      rfpBmp (y - rfpY5 P.Md P.lam + k) = 0 := by
    intro y k hk hy
    unfold rfpBmp
    rw [hsig0 (1 - (y - rfpY5 P.Md P.lam + k) / (3 / 20)) ?_, mul_zero]
    have h3 : 3 ≤ y - rfpY5 P.Md P.lam + k := by linarith
    have e : (y - rfpY5 P.Md P.lam + k) / (3 / 20) = 20 / 3 * (y - rfpY5 P.Md P.lam + k) := by ring
    rw [e]; linarith
  have hint : ∀ k : ℝ, 1 ≤ k →
      (fun y => Real.exp (2 * rfpLam { P with Lh := L } y) * rfpBmp (y - rfpY5 P.Md P.lam + k)) =
        fun y => Real.exp (2 * rfpLam P y) * rfpBmp (y - rfpY5 P.Md P.lam + k) := by
    intro k hk
    funext y
    by_cases hy : y ≤ rfpY5 P.Md P.lam + 2 + P.T1
    · rw [hlam y hy]
    · rw [hbmp y k hk (not_le.mp hy), mul_zero, mul_zero]
  have hKa : rfpKa { P with Lh := L } = rfpKa P := by
    have h3 := hint 3 (by norm_num)
    have h1 := hint 1 le_rfl
    unfold rfpKa
    exact congrArg₂ (· / ·) (congrArg (fun f : ℝ → ℝ => ∫ y, f y) h3)
      (congrArg (fun f : ℝ → ℝ => ∫ y, f y) h1)
  have hpsi : ∀ y : ℝ, rfpPsi { P with Lh := L } y = rfpPsi P y := by
    intro y
    unfold rfpPsi
    rw [hKa]
  refine ⟨hpsi, fun y hy => ⟨hlam y hy, fun η => ?_⟩⟩
  unfold rfpE rfpTh
  dsimp only
  rw [hlam y hy, hpsi y]

theorem rfp_T_pointwise : ∀ R : RfpPar, RfpRegime R → (∀ x η : ℝ, Real.exp (rfpY5 R.Md R.lam + 1) ≤ x → x ≤ Real.exp (rfpY5 R.Md R.lam + 1 + R.T1) → 2 * x * rfpF R x η = Real.sqrt 2 * Real.exp (3 / 2 * (rfpY5 R.Md R.lam + 1) + rfpLam R (rfpY5 R.Md R.lam + 1)) / x) ∧ rfpCi R * Real.exp ((1 - R.h) * (rfpY5 R.Md R.lam + 2 + R.T1)) = Real.exp (3 / 2 * (rfpY5 R.Md R.lam + 1) + rfpLam R (rfpY5 R.Md R.lam + 1) + (1 - R.h) * rfpSigI 1) / (1 - R.ρ) ∧ ∀ x η : ℝ, Real.exp (rfpY5 R.Md R.lam + 2 + R.T1) ≤ x → 2 * x * rfpF R x η - Real.sqrt (2 * x) * rfpCi R * x ^ (-(1 / 2 + R.h)) = -(Real.sqrt 2 * rfpCi R * R.ρ * x ^ (-R.h) * (1 - sigA ((Real.log (x / rfpXb R) + 2) / 2))) :=
by
  intro R hReg
  have hReg' := hReg
  obtain ⟨_hMd, _hPst, hlam0, hlam1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hReg'
  obtain ⟨⟨hy4, -, -⟩, -, hclamp, -, -⟩ := rfp_clamp_identities R hReg
  obtain ⟨hs0, hs1, hs01, -, -, hSig0, hSig1, -, -⟩ := rfp_sig_basics
  have hh4 : R.h ≤ 1 / 10000 := by nlinarith
  have hρ1 : R.ρ < 1 := by linarith
  have h1ρ : 0 < 1 - R.ρ := by linarith
  have hlog : 0 ≤ Real.log (1 / R.h) := Real.log_nonneg (one_le_one_div hh0 (by linarith))
  have hT0 : 0 ≤ R.T1 := by linarith
  have hℓ : 0 ≤ Real.log (1 / R.lam) := Real.log_nonneg (one_le_one_div hlam0 (by linarith))
  have h13 : 0 < 13 / R.lam := by positivity
  have hyb : rfpYb R.Md R.lam R.T1 R.Lh = rfpY5 R.Md R.lam + 2 + R.T1 + R.Lh + 3 := rfl
  have hy54 : rfpY5 R.Md R.lam = rfpY4 R.Md R.lam + 60 + 30 * Real.log (1 / R.lam) := rfl
  have hy43 : rfpY4 R.Md R.lam = rfpY3 R.Md R.lam + 13 / R.lam := rfl
  have hy32 : rfpY3 R.Md R.lam = rfpY2 R.Md + 1 + 60 * Real.log (1 / R.lam) := rfl
  have hy5a : rfpY4 R.Md R.lam + 60 ≤ rfpY5 R.Md R.lam := by linarith
  have hy5b : 61 ≤ rfpY5 R.Md R.lam := by linarith
  have hy5c : rfpY2 R.Md + 61 ≤ rfpY5 R.Md R.lam := by linarith

  have hTF : ∀ y : ℝ, tailFac R.ρ (Real.exp (rfpYb R.Md R.lam R.T1 R.Lh)) (Real.exp y) =
      1 - R.ρ * (1 - sigA ((y - rfpYb R.Md R.lam R.T1 R.Lh + 2) / 2)) := by
    intro y
    unfold tailFac
    rw [← Real.exp_sub, Real.log_exp]
  have hTFpos : ∀ y : ℝ, 0 < tailFac R.ρ (Real.exp (rfpYb R.Md R.lam R.T1 R.Lh)) (Real.exp y) := by
    intro y
    rw [hTF y]
    have hs := hs01 ((y - rfpYb R.Md R.lam R.T1 R.Lh + 2) / 2)
    have : R.ρ * (1 - sigA ((y - rfpYb R.Md R.lam R.T1 R.Lh + 2) / 2)) ≤ R.ρ :=
      mul_le_of_le_one_right hρ0.le (by linarith)
    linarith
  have hLT0 : ∀ y : ℝ, y ≤ rfpYb R.Md R.lam R.T1 R.Lh - 2 →
      Real.log (tailFac R.ρ (Real.exp (rfpYb R.Md R.lam R.T1 R.Lh)) (Real.exp y) / (1 - R.ρ)) = 0 := by
    intro y hy
    rw [hTF y, hs0 ((y - rfpYb R.Md R.lam R.T1 R.Lh + 2) / 2) (by linarith)]
    rw [show (1:ℝ) - R.ρ * (1 - 0) = 1 - R.ρ by ring, div_self h1ρ.ne', Real.log_one]

  have hramp : ∀ z : ℝ, rfpY5 R.Md R.lam + 1 ≤ z → 3 / 2 * z + rfpLam R z =
      3 / 2 * (rfpY5 R.Md R.lam + 1) + rfpLam R (rfpY5 R.Md R.lam + 1)
        + (1 - R.h) * rfpSigI (z - rfpY5 R.Md R.lam - 1 - R.T1)
        + Real.log (tailFac R.ρ (Real.exp (rfpYb R.Md R.lam R.T1 R.Lh)) (Real.exp z) / (1 - R.ρ)) := by
    have hAff : ∀ u : ℝ, rfpY5 R.Md R.lam + 1 ≤ u →
        rfpSigI u = u - 1 + rfpSigI 1 ∧
        rfpSigI (u - rfpY2 R.Md) = u - rfpY2 R.Md - 1 + rfpSigI 1 ∧
        rfpSigI (u - rfpY5 R.Md R.lam) = u - rfpY5 R.Md R.lam - 1 + rfpSigI 1 ∧
        sigA ((u - rfpY4 R.Md R.lam) / 60) = 1 := by
      intro u hu
      exact ⟨hSig1 u (by linarith), hSig1 _ (by linarith), hSig1 _ (by linarith),
        hs1 _ (by rw [le_div_iff₀ (by norm_num)]; linarith)⟩
    intro z hz
    obtain ⟨a1, a2, a3, a4⟩ := hAff z hz
    obtain ⟨b1, b2, b3, b4⟩ := hAff (rfpY5 R.Md R.lam + 1) le_rfl
    have b5 : rfpSigI (rfpY5 R.Md R.lam + 1 - rfpY5 R.Md R.lam - 1 - R.T1) = 0 :=
      hSig0 _ (by linarith)
    have b6 := hLT0 (rfpY5 R.Md R.lam + 1) (by linarith [hyb])
    unfold rfpLam
    rw [a1, a2, a3, a4, b1, b2, b3, b4, b5, b6]
    ring

  have hsx : ∀ x : ℝ, 0 < x → Real.sqrt (2 * x) = Real.sqrt 2 * Real.exp (Real.log x / 2) := by
    intro x hx
    rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2), Real.exp_half, Real.exp_log hx]
  have hclampF : ∀ x η : ℝ, 0 < x → rfpY5 R.Md R.lam ≤ Real.log x →
      2 * x * rfpF R x η = Real.sqrt 2 * Real.exp (Real.log x / 2 + rfpLam R (Real.log x)) := by
    intro x η hx hy
    unfold rfpF rfpE
    rw [mul_assoc (Real.exp (rfpLam R (Real.log x))), hclamp _ η hy, mul_one]
    have hs2 : 0 < Real.sqrt (2 * x) := Real.sqrt_pos.mpr (by linarith)
    calc 2 * x * (Real.exp (rfpLam R (Real.log x)) / Real.sqrt (2 * x))
        = Real.sqrt (2 * x) * Real.sqrt (2 * x) *
            (Real.exp (rfpLam R (Real.log x)) / Real.sqrt (2 * x)) := by
          rw [Real.mul_self_sqrt (by linarith)]
      _ = Real.sqrt (2 * x) * Real.exp (rfpLam R (Real.log x)) := by
          field_simp
      _ = _ := by rw [hsx x hx, Real.exp_add]; ring

  obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = rfpLam R (rfpYb R.Md R.lam R.T1 R.Lh - 3) +
      (1 / 2 + R.h) * (rfpYb R.Md R.lam R.T1 R.Lh - 3) := ⟨_, rfl⟩
  have hci : rfpCi R = Real.exp A / (1 - R.ρ) := by rw [hAdef]; rfl
  have key : A + (1 - R.h) * (rfpY5 R.Md R.lam + 2 + R.T1) =
      3 / 2 * (rfpY5 R.Md R.lam + 1) + rfpLam R (rfpY5 R.Md R.lam + 1) + (1 - R.h) * rfpSigI 1 := by
    have hw : rfpY5 R.Md R.lam + 1 ≤ rfpYb R.Md R.lam R.T1 R.Lh - 3 := by linarith [hyb]
    have hr := hramp _ hw
    rw [hSig1 (rfpYb R.Md R.lam R.T1 R.Lh - 3 - rfpY5 R.Md R.lam - 1 - R.T1) (by linarith [hyb]),
      hLT0 (rfpYb R.Md R.lam R.T1 R.Lh - 3) (by linarith)] at hr
    rw [hAdef]
    linear_combination hr
  refine ⟨?_, ?_, ?_⟩
  ·
    intro x η hx1 hx2
    have hx : 0 < x := lt_of_lt_of_le (Real.exp_pos _) hx1
    have hy1 : rfpY5 R.Md R.lam + 1 ≤ Real.log x := (Real.le_log_iff_exp_le hx).2 hx1
    have hy2 : Real.log x ≤ rfpY5 R.Md R.lam + 1 + R.T1 := (Real.log_le_iff_le_exp hx).2 hx2
    rw [hclampF x η hx (by linarith)]
    have hr := hramp (Real.log x) hy1
    rw [hSig0 (Real.log x - rfpY5 R.Md R.lam - 1 - R.T1) (by linarith),
      hLT0 (Real.log x) (by linarith [hyb])] at hr
    have he : Real.log x / 2 + rfpLam R (Real.log x) =
        (3 / 2 * (rfpY5 R.Md R.lam + 1) + rfpLam R (rfpY5 R.Md R.lam + 1)) - Real.log x := by
      linarith
    rw [he, Real.exp_sub, Real.exp_log hx, mul_div_assoc]
  ·
    rw [hci, div_mul_eq_mul_div, ← Real.exp_add, key]
  ·
    intro x η hx1
    have hx : 0 < x := lt_of_lt_of_le (Real.exp_pos _) hx1
    have hy : rfpY5 R.Md R.lam + 2 + R.T1 ≤ Real.log x := (Real.le_log_iff_exp_le hx).2 hx1
    have hr := hramp (Real.log x) (by linarith)
    rw [hSig1 (Real.log x - rfpY5 R.Md R.lam - 1 - R.T1) (by linarith)] at hr
    have hexp : Real.log x / 2 + rfpLam R (Real.log x) = A + -(R.h * Real.log x) +
        Real.log (tailFac R.ρ (Real.exp (rfpYb R.Md R.lam R.T1 R.Lh)) (Real.exp (Real.log x)) /
          (1 - R.ρ)) := by
      linear_combination hr - key
    have f2 : Real.exp (Real.log x / 2 + rfpLam R (Real.log x)) =
        rfpCi R * Real.exp (-(R.h * Real.log x)) *
          (1 - R.ρ * (1 - sigA ((Real.log x - rfpYb R.Md R.lam R.T1 R.Lh + 2) / 2))) := by
      rw [hexp, Real.exp_add (A + -(R.h * Real.log x)), Real.exp_add A,
        Real.exp_log (div_pos (hTFpos (Real.log x)) h1ρ), hTF, hci]
      field_simp
    have f3 : Real.sqrt (2 * x) * rfpCi R * x ^ (-(1 / 2 + R.h)) =
        Real.sqrt 2 * rfpCi R * Real.exp (-(R.h * Real.log x)) := by
      rw [hsx x hx, Real.rpow_def_of_pos hx]
      have e : Real.exp (Real.log x / 2) * Real.exp (Real.log x * -(1 / 2 + R.h)) =
          Real.exp (-(R.h * Real.log x)) := by
        rw [← Real.exp_add]; congr 1; ring
      rw [← e]; ring
    have f4 : x ^ (-R.h) = Real.exp (-(R.h * Real.log x)) := by
      rw [Real.rpow_def_of_pos hx]; congr 1; ring
    have f5 : Real.log (x / rfpXb R) = Real.log x - rfpYb R.Md R.lam R.T1 R.Lh := by
      unfold rfpXb
      rw [Real.log_div hx.ne' (Real.exp_pos _).ne', Real.log_exp]
    rw [hclampF x η hx (by linarith), f2, f3, f4, f5]
    ring

theorem slice_integrability : ∀ (f u : ℝ → ℝ) (h C ci xv xb : ℝ), 0 < h → h < 1 → 0 < xv → 0 < xb → ContinuousOn f (Ioi 0) → ContinuousOn u (Ioi 0) → (∀ x : ℝ, 0 < x → |f x| ≤ C * x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)) ∧ |u x| ≤ C) → (∀ x : ℝ, xv ≤ x → u x = 0) → (∀ x : ℝ, xb ≤ x → 2 * x * f x = Real.sqrt (2 * x) * ci * x ^ (-(1 / 2 + h))) → IntegrableOn (fun x => u x * (2 * x * f x)) (Ioi 0) ∧ IntegrableOn (fun x => u x ^ 2 - x * f x ^ 2) (Ioi 0) ∧ IntegrableOn (fun x => 2 * x * f x - Real.sqrt (2 * x) * ci * x ^ (-(1 / 2 + h))) (Ioi 0) ∧ IntegrableOn (fun x => f x ^ 2) (Ioi 0) ∧ ∀ X : ℝ, 0 ≤ X → IntervalIntegrable (fun x => u x) volume 0 X ∧ IntervalIntegrable (fun x => 2 * x * f x) volume 0 X ∧ IntervalIntegrable (fun x => u x * (2 * x * f x)) volume 0 X ∧ IntervalIntegrable (fun x => u x ^ 2 - x * f x ^ 2) volume 0 X ∧ IntervalIntegrable (fun x => f x ^ 2) volume 0 X :=
by
  intro f u h C ci xv xb hh0 hh1 hxv hxb hf hu hbd hvan htail
  have hC : 0 ≤ C := le_trans (abs_nonneg _) (hbd 1 one_pos).2

  have local_tool : ∀ (g : ℝ → ℝ) (A B p a : ℝ), ContinuousOn g (Ioi 0) → p < 1 → 0 ≤ a →
      (∀ x : ℝ, 0 < x → x ≤ a → |g x| ≤ A + B * x ^ (-p)) → IntegrableOn g (Ioc 0 a) := by
    intro g A B p a hg hp ha hb
    have h2 : IntegrableOn (fun x : ℝ => A + B * x ^ (-p)) (Ioc 0 a) :=
      (intervalIntegrable_iff_integrableOn_Ioc_of_le ha).1
        (intervalIntegrable_const.add
          ((intervalIntegral.intervalIntegrable_rpow' (by linarith)).const_mul B))
    refine Integrable.mono' h2
      ((hg.mono Ioc_subset_Ioi_self).aestronglyMeasurable measurableSet_Ioc) ?_
    refine ae_restrict_of_forall_mem measurableSet_Ioc ?_
    intro x hx
    rw [Real.norm_eq_abs]
    exact hb x hx.1 hx.2

  have tail_tool : ∀ (g : ℝ → ℝ) (A q : ℝ), ContinuousOn g (Ioi 0) → 1 < q →
      (∀ x : ℝ, 1 < x → |g x| ≤ A * x ^ (-q)) → IntegrableOn g (Ioi 1) := by
    intro g A q hg hq hb
    have h2 : IntegrableOn (fun x : ℝ => A * x ^ (-q)) (Ioi 1) :=
      (integrableOn_Ioi_rpow_of_lt (by linarith) one_pos).const_mul A
    refine Integrable.mono' h2
      ((hg.mono (Ioi_subset_Ioi zero_le_one)).aestronglyMeasurable measurableSet_Ioi) ?_
    refine ae_restrict_of_forall_mem measurableSet_Ioi ?_
    intro x hx
    rw [Real.norm_eq_abs]
    exact hb x hx

  have glue : ∀ (g : ℝ → ℝ) (a : ℝ), 0 ≤ a → IntegrableOn g (Ioc 0 a) →
      (∀ x : ℝ, a < x → g x = 0) → IntegrableOn g (Ioi 0) := by
    intro g a ha hI hz
    rw [← Set.Ioc_union_Ioi_eq_Ioi ha]
    refine hI.union ?_
    exact (integrableOn_zero).congr_fun (fun x hx => (hz x hx).symm) measurableSet_Ioi
  have split : ∀ g : ℝ → ℝ, IntegrableOn g (Ioc 0 1) → IntegrableOn g (Ioi 1) →
      IntegrableOn g (Ioi 0) := by
    intro g h1 h2
    rw [← Set.Ioc_union_Ioi_eq_Ioi zero_le_one]
    exact h1.union h2

  have pw : ∀ x : ℝ, 0 < x → |x * f x| ≤ C ∧ |f x| ≤ C * x ^ (-(2 / 5 : ℝ)) ∧
      |f x| ≤ C * x ^ (-(1 + h)) := by
    intro x hx
    have hb := (hbd x hx).1
    have hx1 : (0 : ℝ) < 1 + x := by linarith
    have e1 : (1 + x) ^ (-(3 / 5 + h)) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (by linarith) (by linarith)
    have e2 : (1 + x) ^ (-(3 / 5 + h)) ≤ x ^ (-(3 / 5 + h)) :=
      Real.rpow_le_rpow_of_nonpos hx (by linarith) (by linarith)
    have p1 : 0 ≤ x ^ (-(2 / 5 : ℝ)) := Real.rpow_nonneg hx.le _
    have p2 : 0 ≤ (1 + x) ^ (-(3 / 5 + h)) := Real.rpow_nonneg hx1.le _
    refine ⟨?_, ?_, ?_⟩
    · have e3 : x * x ^ (-(2 / 5 : ℝ)) = x ^ (3 / 5 : ℝ) := by
        have : x * x ^ (-(2 / 5 : ℝ)) = x ^ (1 : ℝ) * x ^ (-(2 / 5 : ℝ)) := by
          rw [Real.rpow_one]
        rw [this, ← Real.rpow_add hx]; norm_num
      have e4 : x ^ (3 / 5 : ℝ) ≤ (1 + x) ^ (3 / 5 : ℝ) :=
        Real.rpow_le_rpow hx.le (by linarith) (by norm_num)
      have e5 : (1 + x) ^ (3 / 5 : ℝ) * (1 + x) ^ (-(3 / 5 + h)) = (1 + x) ^ (-h) := by
        rw [← Real.rpow_add hx1]; congr 1; ring
      have e6 : (1 + x) ^ (-h) ≤ 1 :=
        Real.rpow_le_one_of_one_le_of_nonpos (by linarith) (by linarith)
      rw [abs_mul, abs_of_pos hx]
      calc x * |f x| ≤ x * (C * x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h))) :=
            mul_le_mul_of_nonneg_left hb hx.le
        _ = C * ((x * x ^ (-(2 / 5 : ℝ))) * (1 + x) ^ (-(3 / 5 + h))) := by ring
        _ ≤ C * ((1 + x) ^ (3 / 5 : ℝ) * (1 + x) ^ (-(3 / 5 + h))) := by
            rw [e3]; exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right e4 p2) hC
        _ = C * (1 + x) ^ (-h) := by rw [e5]
        _ ≤ C * 1 := mul_le_mul_of_nonneg_left e6 hC
        _ = C := mul_one C
    · calc |f x| ≤ C * x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)) := hb
        _ ≤ C * x ^ (-(2 / 5 : ℝ)) * 1 := mul_le_mul_of_nonneg_left e1 (mul_nonneg hC p1)
        _ = C * x ^ (-(2 / 5 : ℝ)) := mul_one _
    · calc |f x| ≤ C * x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)) := hb
        _ ≤ C * x ^ (-(2 / 5 : ℝ)) * x ^ (-(3 / 5 + h)) :=
            mul_le_mul_of_nonneg_left e2 (mul_nonneg hC p1)
        _ = C * x ^ (-(1 + h)) := by
            rw [mul_assoc, ← Real.rpow_add hx]; congr 2; ring
  have tf : ∀ x : ℝ, 1 < x → |f x| ≤ C ∧ |f x| ≤ C * x ^ (-(1 + h)) := by
    intro x hx
    obtain ⟨-, -, b3⟩ := pw x (by linarith)
    have : x ^ (-(1 + h)) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hx.le (by linarith)
    exact ⟨le_trans b3 (mul_le_of_le_one_right hC this), b3⟩
  have bf2 : ∀ x : ℝ, 0 < x → x ≤ 1 → |f x ^ 2| ≤ 0 + C ^ 2 * x ^ (-(4 / 5 : ℝ)) := by
    intro x hx _
    obtain ⟨-, b2, -⟩ := pw x hx
    have e : x ^ (-(4 / 5 : ℝ)) = x ^ (-(2 / 5 : ℝ)) * x ^ (-(2 / 5 : ℝ)) := by
      rw [← Real.rpow_add hx]; norm_num
    rw [zero_add, abs_pow, e]
    calc |f x| ^ 2 = |f x| * |f x| := sq _
      _ ≤ (C * x ^ (-(2 / 5 : ℝ))) * (C * x ^ (-(2 / 5 : ℝ))) :=
          mul_le_mul b2 b2 (abs_nonneg _) (le_trans (abs_nonneg _) b2)
      _ = C ^ 2 * (x ^ (-(2 / 5 : ℝ)) * x ^ (-(2 / 5 : ℝ))) := by ring
  have tf2 : ∀ x : ℝ, 1 < x → |f x ^ 2| ≤ C ^ 2 * x ^ (-(1 + h)) := by
    intro x hx
    obtain ⟨t1, t2⟩ := tf x hx
    rw [abs_pow]
    calc |f x| ^ 2 = |f x| * |f x| := sq _
      _ ≤ C * (C * x ^ (-(1 + h))) := mul_le_mul t1 t2 (abs_nonneg _) hC
      _ = C ^ 2 * x ^ (-(1 + h)) := by ring
  have bxf2 : ∀ x : ℝ, 0 < x → x ≤ 1 → |x * f x ^ 2| ≤ 0 + C ^ 2 * x ^ (-(2 / 5 : ℝ)) := by
    intro x hx _
    obtain ⟨b1, b2, -⟩ := pw x hx
    rw [zero_add, show x * f x ^ 2 = (x * f x) * f x by ring, abs_mul]
    calc |x * f x| * |f x| ≤ C * (C * x ^ (-(2 / 5 : ℝ))) := mul_le_mul b1 b2 (abs_nonneg _) hC
      _ = C ^ 2 * x ^ (-(2 / 5 : ℝ)) := by ring
  have txf2 : ∀ x : ℝ, 1 < x → |x * f x ^ 2| ≤ C ^ 2 * x ^ (-(1 + h)) := by
    intro x hx
    obtain ⟨b1, -, -⟩ := pw x (by linarith)
    obtain ⟨-, t2⟩ := tf x hx
    rw [show x * f x ^ 2 = (x * f x) * f x by ring, abs_mul]
    calc |x * f x| * |f x| ≤ C * (C * x ^ (-(1 + h))) := mul_le_mul b1 t2 (abs_nonneg _) hC
      _ = C ^ 2 * x ^ (-(1 + h)) := by ring
  have b2xf : ∀ x : ℝ, 0 < x → |2 * x * f x| ≤ 2 * C := by
    intro x hx
    rw [show 2 * x * f x = 2 * (x * f x) by ring, abs_mul, abs_two]
    linarith [(pw x hx).1]
  have hSid : ∀ x : ℝ, 0 < x →
      Real.sqrt (2 * x) * ci * x ^ (-(1 / 2 + h)) = Real.sqrt 2 * ci * x ^ (-h) := by
    intro x hx
    rw [Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 2) x, Real.sqrt_eq_rpow x]
    have e : x ^ (1 / (2 : ℝ)) * x ^ (-(1 / 2 + h)) = x ^ (-h) := by
      rw [← Real.rpow_add hx]; congr 1; ring
    calc Real.sqrt 2 * x ^ (1 / (2 : ℝ)) * ci * x ^ (-(1 / 2 + h))
        = Real.sqrt 2 * ci * (x ^ (1 / (2 : ℝ)) * x ^ (-(1 / 2 + h))) := by ring
      _ = _ := by rw [e]
  have bT3 : ∀ x : ℝ, 0 < x → x ≤ xb →
      |2 * x * f x - Real.sqrt (2 * x) * ci * x ^ (-(1 / 2 + h))| ≤
        2 * C + Real.sqrt 2 * |ci| * x ^ (-h) := by
    intro x hx _
    rw [hSid x hx]
    have e : |Real.sqrt 2 * ci * x ^ (-h)| = Real.sqrt 2 * |ci| * x ^ (-h) := by
      rw [abs_mul, abs_mul, abs_of_nonneg (Real.sqrt_nonneg 2),
        abs_of_nonneg (Real.rpow_nonneg hx.le _)]
    calc _ ≤ |2 * x * f x| + |Real.sqrt 2 * ci * x ^ (-h)| := abs_sub _ _
      _ ≤ _ := by rw [e]; linarith [b2xf x hx]
  have bT1 : ∀ x : ℝ, 0 < x → x ≤ xv →
      |u x * (2 * x * f x)| ≤ 2 * C ^ 2 + 0 * x ^ (-(0 : ℝ)) := by
    intro x hx _
    rw [zero_mul, add_zero, abs_mul]
    calc |u x| * |2 * x * f x| ≤ C * (2 * C) :=
          mul_le_mul (hbd x hx).2 (b2xf x hx) (abs_nonneg _) hC
      _ = 2 * C ^ 2 := by ring
  have bu2 : ∀ x : ℝ, 0 < x → x ≤ xv → |u x ^ 2| ≤ C ^ 2 + 0 * x ^ (-(0 : ℝ)) := by
    intro x hx _
    rw [zero_mul, add_zero, abs_pow]
    exact pow_le_pow_left₀ (abs_nonneg _) (hbd x hx).2 2

  have hxf : ContinuousOn (fun x => 2 * x * f x) (Ioi 0) :=
    (continuousOn_const.mul continuousOn_id).mul hf
  have hf2 : ContinuousOn (fun x => f x ^ 2) (Ioi 0) := hf.pow 2
  have hxf2 : ContinuousOn (fun x => x * f x ^ 2) (Ioi 0) := continuousOn_id.mul hf2
  have hu2 : ContinuousOn (fun x => u x ^ 2) (Ioi 0) := hu.pow 2
  have huxf : ContinuousOn (fun x => u x * (2 * x * f x)) (Ioi 0) := hu.mul hxf
  have hS : ContinuousOn (fun x : ℝ => Real.sqrt (2 * x) * ci * x ^ (-(1 / 2 + h))) (Ioi 0) :=
    ((continuousOn_const.mul continuousOn_id).sqrt.mul continuousOn_const).mul
      (continuousOn_id.rpow_const (fun x hx => Or.inl (Set.mem_Ioi.mp hx).ne'))

  have T4 : IntegrableOn (fun x => f x ^ 2) (Ioi 0) :=
    split _ (local_tool _ 0 (C ^ 2) (4 / 5) 1 hf2 (by norm_num) zero_le_one bf2)
      (tail_tool _ (C ^ 2) (1 + h) hf2 (by linarith) tf2)
  have Ixf2 : IntegrableOn (fun x => x * f x ^ 2) (Ioi 0) :=
    split _ (local_tool _ 0 (C ^ 2) (2 / 5) 1 hxf2 (by norm_num) zero_le_one bxf2)
      (tail_tool _ (C ^ 2) (1 + h) hxf2 (by linarith) txf2)
  have T1 : IntegrableOn (fun x => u x * (2 * x * f x)) (Ioi 0) :=
    glue _ xv hxv.le (local_tool _ (2 * C ^ 2) 0 0 xv huxf (by norm_num) hxv.le bT1)
      (fun x hx => by simp only [hvan x hx.le, zero_mul])
  have Iu2 : IntegrableOn (fun x => u x ^ 2) (Ioi 0) :=
    glue _ xv hxv.le (local_tool _ (C ^ 2) 0 0 xv hu2 (by norm_num) hxv.le bu2)
      (fun x hx => by simp [hvan x hx.le])
  have T2 : IntegrableOn (fun x => u x ^ 2 - x * f x ^ 2) (Ioi 0) := Iu2.sub Ixf2
  have T3 : IntegrableOn (fun x => 2 * x * f x - Real.sqrt (2 * x) * ci * x ^ (-(1 / 2 + h)))
      (Ioi 0) :=
    glue _ xb hxb.le (local_tool _ (2 * C) (Real.sqrt 2 * |ci|) h xb (hxf.sub hS) hh1 hxb.le bT3)
      (fun x hx => sub_eq_zero.mpr (htail x hx.le))
  refine ⟨T1, T2, T3, T4, fun X hX => ⟨?_, ?_, ?_, ?_, ?_⟩⟩
  · refine (intervalIntegrable_iff_integrableOn_Ioc_of_le hX).2 ?_
    refine local_tool _ C 0 0 X hu (by norm_num) hX (fun x hx _ => ?_)
    rw [zero_mul, add_zero]
    exact (hbd x hx).2
  · refine (intervalIntegrable_iff_integrableOn_Ioc_of_le hX).2 ?_
    refine local_tool _ (2 * C) 0 0 X hxf (by norm_num) hX (fun x hx _ => ?_)
    rw [zero_mul, add_zero]
    exact b2xf x hx
  · exact (intervalIntegrable_iff_integrableOn_Ioc_of_le hX).2 (T1.mono_set Ioc_subset_Ioi_self)
  · exact (intervalIntegrable_iff_integrableOn_Ioc_of_le hX).2 (T2.mono_set Ioc_subset_Ioi_self)
  · exact (intervalIntegrable_iff_integrableOn_Ioc_of_le hX).2 (T4.mono_set Ioc_subset_Ioi_self)

theorem rfp_lam_tail_envelope : ∀ P : RfpPar, RfpRegime P → (∀ y : ℝ, rfpYb P.Md P.lam P.T1 P.Lh ≤ y → rfpLam P y = rfpLam P (rfpYb P.Md P.lam P.T1 P.Lh - 3) + (1 / 2 + P.h) * (rfpYb P.Md P.lam P.T1 P.Lh - 3) - Real.log (1 - P.ρ) - (1 / 2 + P.h) * y) ∧ ∃ B : ℝ, ∀ y : ℝ, rfpLam P y ≤ B + y / 10 - (3 / 5 + P.h) * max y 0 :=
by
  intro P hR
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hR

  have hl2 : P.lam ^ 2 ≤ 1 / 10000 := by nlinarith
  have hhlam : P.h ≤ P.lam := by nlinarith
  have hρ1 : P.ρ < 1 := by linarith
  have h1ρ : 0 < 1 - P.ρ := by linarith
  have hlogh : 0 ≤ Real.log (1 / P.h) :=
    Real.log_nonneg (by rw [le_div_iff₀ hh0]; linarith)
  have hT0 : 0 ≤ P.T1 := by linarith
  have hL : 0 ≤ Real.log (1 / P.lam) :=
    Real.log_nonneg (by rw [le_div_iff₀ hl0]; linarith)
  have hexpMd : 0 < Real.exp P.Md := Real.exp_pos _
  have hlam13 : 0 < 13 / P.lam := by positivity
  have eY2 : rfpY2 P.Md = Real.exp P.Md + 11 := rfl
  have eY3 : rfpY3 P.Md P.lam = rfpY2 P.Md + 1 + 60 * Real.log (1 / P.lam) := rfl
  have eY4 : rfpY4 P.Md P.lam = rfpY3 P.Md P.lam + 13 / P.lam := rfl
  have eY5 : rfpY5 P.Md P.lam = rfpY4 P.Md P.lam + 60 + 30 * Real.log (1 / P.lam) := rfl
  obtain ⟨yb, hyb⟩ : ∃ yb : ℝ, yb = rfpYb P.Md P.lam P.T1 P.Lh := ⟨_, rfl⟩
  have eYb : yb = rfpY5 P.Md P.lam + 2 + P.T1 + P.Lh + 3 := by rw [hyb]; rfl

  have sig0 : ∀ y : ℝ, y ≤ 0 → sigA y = 0 := fun y hy => by unfold sigA; simp [hy]
  have sig1 : ∀ y : ℝ, 1 ≤ y → sigA y = 1 := fun y hy => by
    unfold sigA; rw [if_neg (by linarith), if_pos hy]
  have sigR : ∀ y : ℝ, 0 ≤ sigA y ∧ sigA y ≤ 1 := by
    intro y
    unfold sigA
    split_ifs
    · norm_num
    · norm_num
    · have ha := Real.exp_pos (-1 / y ^ 2)
      have hb := Real.exp_pos (-1 / (1 - y) ^ 2)
      exact ⟨div_nonneg ha.le (by linarith), (div_le_one (by linarith)).2 (by linarith)⟩
  have sigM : Measurable sigA := by
    unfold sigA
    refine Measurable.ite (measurableSet_le measurable_id measurable_const) measurable_const
      (Measurable.ite (measurableSet_le measurable_const measurable_id) measurable_const ?_)
    fun_prop
  have sigInt : ∀ a b : ℝ, IntervalIntegrable sigA MeasureTheory.volume a b := by
    intro a b
    refine (intervalIntegrable_const (c := (1:ℝ))).mono_fun' sigM.aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall (fun x => by
      show ‖sigA x‖ ≤ 1
      rw [Real.norm_eq_abs, abs_le]; constructor <;> linarith [(sigR x).1, (sigR x).2])

  have hI1 : ∀ t : ℝ, 1 ≤ t → rfpSigI t = rfpSigI 1 + (t - 1) := by
    intro t ht
    unfold rfpSigI
    rw [← intervalIntegral.integral_add_adjacent_intervals (sigInt 0 1) (sigInt 1 t)]
    congr 1
    rw [intervalIntegral.integral_congr (g := fun _ => (1:ℝ))]
    · simp
    · intro s hs
      rw [Set.uIcc_of_le ht] at hs
      exact sig1 s hs.1
  have hI0 : ∀ t : ℝ, t ≤ 0 → rfpSigI t = 0 := by
    intro t ht
    unfold rfpSigI
    rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ))]
    · simp
    · intro s hs
      rw [Set.uIcc_of_ge ht] at hs
      exact sig0 s hs.2
  have hInn : ∀ t : ℝ, 0 ≤ rfpSigI t := by
    intro t
    rcases le_total t 0 with ht | ht
    · rw [hI0 t ht]
    · unfold rfpSigI
      exact intervalIntegral.integral_nonneg ht (fun u _ => (sigR u).1)
  have hIle : ∀ t : ℝ, 0 ≤ t → rfpSigI t ≤ t := by
    intro t ht
    unfold rfpSigI
    have := intervalIntegral.integral_mono_on ht (sigInt 0 t)
      (intervalIntegrable_const (c := (1:ℝ))) (fun x _ => (sigR x).2)
    simpa using this
  have hIge : ∀ t : ℝ, t - 1 ≤ rfpSigI t := by
    intro t
    rcases le_total 1 t with ht | ht
    · rw [hI1 t ht]; linarith [hInn 1]
    · linarith [hInn t]
  have tauR : ∀ a b : ℝ, 1 - P.ρ ≤ tailFac P.ρ a b ∧ tailFac P.ρ a b ≤ 1 := by
    intro a b
    unfold tailFac
    obtain ⟨s0, s1⟩ := sigR ((Real.log (b / a) + 2) / 2)
    constructor <;> nlinarith

  obtain ⟨C0, hC0⟩ : ∃ C0 : ℝ, C0 = Real.log P.Pst - 3 / 5 * (rfpSigI 1 - 1)
      - P.lam * (rfpSigI 1 - rfpY2 P.Md - 1) - (1 - P.lam) * (rfpSigI 1 - rfpY5 P.Md P.lam - 1)
      + (1 - P.h) * (rfpSigI 1 - rfpY5 P.Md P.lam - 2 - P.T1) - Real.log 2 := ⟨_, rfl⟩
  have hΛ : ∀ y : ℝ, yb - 3 ≤ y → rfpLam P y = C0 - (1 / 2 + P.h) * y +
      Real.log (tailFac P.ρ (Real.exp yb) (Real.exp y) / (1 - P.ρ)) := by
    intro y hy
    have a1 : 1 ≤ y := by linarith
    have a2 : 1 ≤ y - rfpY2 P.Md := by linarith
    have a3 : 1 ≤ y - rfpY5 P.Md P.lam := by linarith
    have a4 : 1 ≤ y - rfpY5 P.Md P.lam - 1 - P.T1 := by linarith
    have a5 : 1 ≤ (y - rfpY4 P.Md P.lam) / 60 := by
      rw [le_div_iff₀ (by norm_num)]; linarith
    unfold rfpLam
    rw [← hyb, hI1 y a1, hI1 _ a2, hI1 _ a3, hI1 _ a4, sig1 _ a5, hC0]
    ring
  have hτT : tailFac P.ρ (Real.exp yb) (Real.exp (yb - 3)) = 1 - P.ρ := by
    unfold tailFac
    rw [← Real.exp_sub, Real.log_exp, sig0 ((yb - 3 - yb + 2) / 2) (by linarith)]
    ring
  have hτ1 : ∀ y : ℝ, yb ≤ y → tailFac P.ρ (Real.exp yb) (Real.exp y) = 1 := by
    intro y hy
    unfold tailFac
    rw [← Real.exp_sub, Real.log_exp, sig1 ((y - yb + 2) / 2) (by linarith)]
    ring
  refine ⟨?_, ?_⟩
  ·
    intro y hy
    rw [← hyb] at hy ⊢
    rw [hΛ y (by linarith), hΛ (yb - 3) le_rfl, hτT, hτ1 y hy, div_self h1ρ.ne',
      Real.log_div one_ne_zero h1ρ.ne', Real.log_one]
    ring
  ·
    obtain ⟨B1, hB1⟩ : ∃ B1 : ℝ, B1 = Real.log P.Pst - Real.log (1 - P.ρ) +
        (3 / 5 + P.h) * (rfpY5 P.Md P.lam + 1 + P.T1) := ⟨_, rfl⟩
    obtain ⟨B2, hB2⟩ : ∃ B2 : ℝ, B2 = Real.log P.Pst + 3 / 5 + P.lam * (rfpY2 P.Md + 1) +
        (1 - P.lam) * (rfpY5 P.Md P.lam + 1) - (1 - P.h) * (rfpY5 P.Md P.lam + 1 + P.T1) -
        Real.log (1 - P.ρ) := ⟨_, rfl⟩
    refine ⟨max B1 B2, ?_⟩
    intro y
    have hY1 : 0 < rfpY5 P.Md P.lam + 1 + P.T1 := by linarith
    have U1 : 0 ≤ sigA ((y - rfpY4 P.Md P.lam) / 60) * Real.log 2 :=
      mul_nonneg (sigR _).1 (Real.log_nonneg (by norm_num))
    have U2 : Real.log (tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) /
        (1 - P.ρ)) ≤ -Real.log (1 - P.ρ) := by
      obtain ⟨t0, t1⟩ := tauR (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y)
      have tp : 0 < tailFac P.ρ (Real.exp (rfpYb P.Md P.lam P.T1 P.Lh)) (Real.exp y) := by
        linarith
      rw [Real.log_div tp.ne' h1ρ.ne']
      have := Real.log_le_log tp t1
      rw [Real.log_one] at this
      linarith
    have hB1le := le_max_left B1 B2
    have hB2le := le_max_right B1 B2
    unfold rfpLam
    rcases le_or_gt y (rfpY5 P.Md P.lam + 1 + P.T1) with hy | hy
    · rw [hI0 (y - rfpY5 P.Md P.lam - 1 - P.T1) (by linarith)]
      have m1 : 0 ≤ 3 / 5 * rfpSigI y := mul_nonneg (by norm_num) (hInn _)
      have m2 : 0 ≤ P.lam * rfpSigI (y - rfpY2 P.Md) := mul_nonneg hl0.le (hInn _)
      have m3 : 0 ≤ (1 - P.lam) * rfpSigI (y - rfpY5 P.Md P.lam) :=
        mul_nonneg (by linarith) (hInn _)
      have hmax : max y 0 ≤ rfpY5 P.Md P.lam + 1 + P.T1 := max_le hy hY1.le
      have m4 := mul_le_mul_of_nonneg_left hmax (show (0:ℝ) ≤ 3 / 5 + P.h by linarith)
      linarith
    · rw [max_eq_left (show (0:ℝ) ≤ y by linarith)]
      have m1 := mul_le_mul_of_nonneg_left (hIge y) (show (0:ℝ) ≤ 3 / 5 by norm_num)
      have m2 := mul_le_mul_of_nonneg_left (hIge (y - rfpY2 P.Md)) hl0.le
      have m3 := mul_le_mul_of_nonneg_left (hIge (y - rfpY5 P.Md P.lam))
        (show (0:ℝ) ≤ 1 - P.lam by linarith)
      have m4 := mul_le_mul_of_nonneg_left (hIle (y - rfpY5 P.Md P.lam - 1 - P.T1) (by linarith))
        (show (0:ℝ) ≤ 1 - P.h by linarith)
      linarith

theorem rfp_T_slice_integrable : ∀ R : RfpPar, RfpRegime R → ∀ η : ℝ, -1 < η → η < 1 → (∀ y : ℝ, |R.ca η * rfpPsi R y| ≤ 1 / 2) → IntegrableOn (fun x => 2 * x * rfpF R x η - Real.sqrt (2 * x) * rfpCi R * x ^ (-(1 / 2 + R.h))) (Ioi 0) ∧ ∀ X : ℝ, 0 ≤ X → IntervalIntegrable (fun x => 2 * x * rfpF R x η) volume 0 X :=
by
  intro R hReg η _h1 _h2 hψ
  have hReg' := hReg
  obtain ⟨_hMd, _hPst, _hlam0, hlam1, hh0, hhl, _hρ0, hρh, _hT1, _hLh⟩ := hReg'
  have hh4 : R.h ≤ 1 / 10000 := by nlinarith
  have hh1 : R.h < 1 := by linarith
  have hρ1 : R.ρ < 1 := by linarith
  obtain ⟨-, -, hs01, hscont, -, -, -, -, -⟩ := rfp_sig_basics
  obtain ⟨hyb1, -, hclamp, -, -⟩ := rfp_clamp_identities R hReg
  obtain ⟨htailL, B, hB⟩ := rfp_lam_tail_envelope R hReg
  have hΛc : Continuous (rfpLam R) := (rfp_lam_window sigA_contDiff_one R hReg).1
  have hb0 : (0:ℝ) < (1 + η ^ 2)⁻¹ := by positivity

  have hEc : Continuous (fun y : ℝ => rfpE R y η) := by
    have hTh : Continuous (rfpTh R) := by
      unfold rfpTh
      exact continuous_const.sub (hscont.comp (by fun_prop))
    have hpow : Continuous (fun y => ((1 + η ^ 2)⁻¹) ^ (rfpTh R y)) :=
      continuous_const.rpow hTh (fun _ => Or.inl hb0.ne')
    have hBmp : Continuous rfpBmp := by
      unfold rfpBmp
      exact (hscont.comp (by fun_prop)).mul (hscont.comp (by fun_prop))
    have hPsi : Continuous (rfpPsi R) := by
      unfold rfpPsi
      exact (hBmp.comp (by fun_prop)).sub (continuous_const.mul (hBmp.comp (by fun_prop)))
    have hsq : Continuous (fun y => Real.sqrt (1 + R.ca η * rfpPsi R y)) :=
      Real.continuous_sqrt.comp (continuous_const.add (continuous_const.mul hPsi))
    unfold rfpE
    exact ((Real.continuous_exp.comp hΛc).mul hpow).mul hsq
  have hFc : ContinuousOn (fun x => rfpF R x η) (Ioi 0) := by
    unfold rfpF
    apply ContinuousOn.div
    · exact hEc.comp_continuousOn (Real.continuousOn_log.mono (fun x hx => by
        simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
        exact ne_of_gt hx))
    · exact (Real.continuous_sqrt.comp (continuous_const.mul continuous_id)).continuousOn
    · intro x hx
      have hx0 : (0:ℝ) < x := hx
      exact Real.sqrt_ne_zero'.mpr (by linarith)

  have hEb : ∀ y : ℝ, 0 ≤ rfpE R y η ∧ rfpE R y η ≤ 5 / 4 * Real.exp (rfpLam R y) := by
    intro y
    have hb1 : (1 + η ^ 2)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by nlinarith [sq_nonneg η])
    have ht0 : 0 ≤ rfpTh R y := by
      unfold rfpTh; linarith [(hs01 ((y - rfpY4 R.Md R.lam) / 60)).2]
    have hbt0 : 0 ≤ ((1 + η ^ 2)⁻¹) ^ (rfpTh R y) := Real.rpow_nonneg hb0.le _
    have hbt1 : ((1 + η ^ 2)⁻¹) ^ (rfpTh R y) ≤ 1 := Real.rpow_le_one hb0.le hb1 ht0
    have hc := le_abs_self (R.ca η * rfpPsi R y)
    have hcy := hψ y
    have hs0 : 0 ≤ Real.sqrt (1 + R.ca η * rfpPsi R y) := Real.sqrt_nonneg _
    have hs1 : Real.sqrt (1 + R.ca η * rfpPsi R y) ≤ 5 / 4 := by
      calc Real.sqrt (1 + R.ca η * rfpPsi R y) ≤ Real.sqrt ((5 / 4) ^ 2) :=
            Real.sqrt_le_sqrt (by nlinarith)
        _ = 5 / 4 := Real.sqrt_sq (by norm_num)
    have hE0 : 0 < Real.exp (rfpLam R y) := Real.exp_pos _
    unfold rfpE
    constructor
    · exact mul_nonneg (mul_nonneg hE0.le hbt0) hs0
    · calc Real.exp (rfpLam R y) * ((1 + η ^ 2)⁻¹) ^ (rfpTh R y) * Real.sqrt (1 + R.ca η * rfpPsi R y)
          ≤ Real.exp (rfpLam R y) * 1 * (5 / 4) :=
            mul_le_mul (mul_le_mul_of_nonneg_left hbt1 hE0.le) hs1 hs0 (by linarith)
        _ = 5 / 4 * Real.exp (rfpLam R y) := by ring

  have hFb : ∀ x : ℝ, 0 < x →
      |rfpF R x η| ≤ 3 * Real.exp B * x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + R.h)) := by
    intro x hx
    have hxy : Real.exp (Real.log x) = x := Real.exp_log hx
    obtain ⟨hE0, hE1⟩ := hEb (Real.log x)
    have hsq2 : 0 < Real.sqrt (2 * x) := Real.sqrt_pos.mpr (by linarith)
    have hF0 : 0 ≤ rfpF R x η := by unfold rfpF; exact div_nonneg hE0 hsq2.le
    rw [abs_of_nonneg hF0]
    have hsq : Real.exp (Real.log x / 2) ^ 2 = x := by
      rw [sq, ← Real.exp_add, add_halves, hxy]
    have hsx : Real.exp (Real.log x / 2) ≤ Real.sqrt (2 * x) := by
      calc Real.exp (Real.log x / 2) = Real.sqrt (Real.exp (Real.log x / 2) ^ 2) :=
            (Real.sqrt_sq (Real.exp_pos _).le).symm
        _ = Real.sqrt x := by rw [hsq]
        _ ≤ Real.sqrt (2 * x) := Real.sqrt_le_sqrt (by linarith)
    have hBy := hB (Real.log x)
    have ha0 : 0 ≤ 3 / 5 + R.h := by linarith
    have ha1 : 3 / 5 + R.h ≤ 1 := by linarith

    have hA : rfpF R x η ≤ 5 / 4 * Real.exp (B - 2 / 5 * Real.log x - (3 / 5 + R.h) * max (Real.log x) 0) := by
      unfold rfpF
      rw [div_le_iff₀ hsq2]
      have e1 : Real.exp (rfpLam R (Real.log x)) ≤
          Real.exp (B - 2 / 5 * Real.log x - (3 / 5 + R.h) * max (Real.log x) 0) * Real.exp (Real.log x / 2) := by
        rw [← Real.exp_add]
        exact Real.exp_le_exp.mpr (by linarith)
      have e2 := mul_le_mul_of_nonneg_left hsx
        (Real.exp_pos (B - 2 / 5 * Real.log x - (3 / 5 + R.h) * max (Real.log x) 0)).le
      nlinarith
    have hL1 : Real.log (1 + x) ≤ Real.log 2 + max (Real.log x) 0 := by
      by_cases hx1 : x ≤ 1
      · have := Real.log_le_log (by linarith) (show 1 + x ≤ 2 by linarith)
        linarith [le_max_right (Real.log x) 0]
      · have h2x := Real.log_le_log (by linarith) (show 1 + x ≤ 2 * x by linarith)
        rw [Real.log_mul (by norm_num) hx.ne'] at h2x
        linarith [le_max_left (Real.log x) 0]
    have hlog2 : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
    have hK : B - 2 / 5 * Real.log x - (3 / 5 + R.h) * max (Real.log x) 0 - Real.log 2 ≤
        B + Real.log x * (-(2 / 5 : ℝ)) + Real.log (1 + x) * (-(3 / 5 + R.h)) := by
      have m1 := mul_le_mul_of_nonneg_left hL1 ha0
      have m2 : (3 / 5 + R.h) * Real.log 2 ≤ Real.log 2 := by nlinarith
      nlinarith
    have hB2 : Real.exp (B - 2 / 5 * Real.log x - (3 / 5 + R.h) * max (Real.log x) 0) / 2 ≤
        Real.exp B * x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + R.h)) := by
      rw [Real.rpow_def_of_pos hx, Real.rpow_def_of_pos (by linarith : (0:ℝ) < 1 + x),
        ← Real.exp_add, ← Real.exp_add]
      have := Real.exp_le_exp.mpr hK
      rw [Real.exp_sub, Real.exp_log (by norm_num : (0:ℝ) < 2)] at this
      exact this
    have hKp := Real.exp_pos (B - 2 / 5 * Real.log x - (3 / 5 + R.h) * max (Real.log x) 0)
    nlinarith

  have htail : ∀ x : ℝ, rfpXb R ≤ x →
      2 * x * rfpF R x η = Real.sqrt (2 * x) * rfpCi R * x ^ (-(1 / 2 + R.h)) := by
    intro x hx
    have hxb0 : 0 < rfpXb R := Real.exp_pos _
    have hx0 : 0 < x := lt_of_lt_of_le hxb0 hx
    have hyb : rfpYb R.Md R.lam R.T1 R.Lh ≤ Real.log x := by
      rw [Real.le_log_iff_exp_le hx0]; exact hx
    have hy5 : rfpY5 R.Md R.lam ≤ Real.log x := le_trans hyb1.2.2 hyb
    have hE : rfpE R (Real.log x) η = Real.exp (rfpLam R (Real.log x)) := by
      unfold rfpE; rw [mul_assoc, hclamp _ η hy5, mul_one]
    have hL := htailL (Real.log x) hyb
    have h1ρ : 0 < 1 - R.ρ := by linarith
    have hciE : rfpCi R = Real.exp (rfpLam R (rfpYb R.Md R.lam R.T1 R.Lh - 3) +
        (1 / 2 + R.h) * (rfpYb R.Md R.lam R.T1 R.Lh - 3) - Real.log (1 - R.ρ)) := by
      unfold rfpCi; rw [Real.exp_sub, Real.exp_log h1ρ]
    have hci : Real.exp (rfpLam R (Real.log x)) = rfpCi R * x ^ (-(1 / 2 + R.h)) := by
      rw [hL, Real.rpow_def_of_pos hx0, hciE, ← Real.exp_add]
      congr 1; ring
    have hs0 : 0 < Real.sqrt (2 * x) := Real.sqrt_pos.mpr (by linarith)
    unfold rfpF
    rw [hE, hci]
    calc 2 * x * (rfpCi R * x ^ (-(1 / 2 + R.h)) / Real.sqrt (2 * x))
        = (Real.sqrt (2 * x) * Real.sqrt (2 * x)) *
            (rfpCi R * x ^ (-(1 / 2 + R.h)) / Real.sqrt (2 * x)) := by
          rw [Real.mul_self_sqrt (by linarith)]
      _ = Real.sqrt (2 * x) * rfpCi R * x ^ (-(1 / 2 + R.h)) := by
          field_simp

  have hres := slice_integrability (fun x => rfpF R x η) (fun _ => 0) R.h (3 * Real.exp B)
    (rfpCi R) 1 (rfpXb R) hh0 hh1 one_pos (Real.exp_pos _) hFc continuousOn_const
    (fun x hx => ⟨hFb x hx, by rw [abs_zero]; positivity⟩) (fun _ _ => rfl) htail
  obtain ⟨-, -, hI3, -, hX⟩ := hres
  exact ⟨hI3, fun X hX0 => (hX X hX0).2.1⟩

theorem tail_cutoff_integral : ∀ (s g : ℝ → ℝ) (c ρ h X6 Xb : ℝ), Continuous s → (∀ y : ℝ, y ≤ 0 → s y = 0) → (∀ y : ℝ, 1 ≤ y → s y = 1) → 0 < h → h ≤ 1 / 2 → 0 < X6 → X6 ≤ Xb * Real.exp (-2) → (∀ x : ℝ, X6 ≤ x → g x = -(Real.sqrt 2 * c * ρ * x ^ (-h) * (1 - s ((Real.log (x / Xb) + 2) / 2)))) → IntegrableOn g (Ioi X6) ∧ (∫ x in Ioi X6, g x) = -(Real.sqrt 2 * c * ρ * ((Xb * Real.exp (-2)) ^ (1 - h) - X6 ^ (1 - h)) / (1 - h)) - Real.sqrt 2 * c * ρ * Xb ^ (1 - h) * (∫ u in Real.exp (-2)..1, u ^ (-h) * (1 - s ((Real.log u + 2) / 2))) :=
by
  intro s g c ρ h X6 Xb hs hs0 hs1 hh0 hh1 hX6 hX6a hg
  have he2pos : 0 < Real.exp (-2) := Real.exp_pos _
  have he2le : Real.exp (-2) ≤ 1 := Real.exp_le_one_iff.2 (by norm_num)
  have hXb : 0 < Xb := by
    by_contra hc
    push_neg at hc
    have := mul_nonpos_of_nonpos_of_nonneg hc he2pos.le
    linarith
  have haXb : Xb * Real.exp (-2) ≤ Xb := mul_le_of_le_one_right hXb.le he2le
  have hX6Xb : X6 ≤ Xb := hX6a.trans haXb
  have htail : ∀ x, Xb ≤ x → g x = 0 := by
    intro x hx
    rw [hg x (hX6Xb.trans hx)]
    have hl : 0 ≤ Real.log (x / Xb) := Real.log_nonneg ((one_le_div hXb).2 hx)
    rw [hs1 _ (by linarith)]
    ring
  have hhead : ∀ x, X6 ≤ x → x ≤ Xb * Real.exp (-2) →
      g x = -(Real.sqrt 2 * c * ρ * x ^ (-h)) := by
    intro x hx1 hx2
    rw [hg x hx1]
    have hxpos : 0 < x := lt_of_lt_of_le hX6 hx1
    have hdiv : x / Xb ≤ Real.exp (-2) := by
      rw [div_le_iff₀ hXb]; linarith
    have hl : Real.log (x / Xb) ≤ -2 := by
      have := Real.log_le_log (div_pos hxpos hXb) hdiv
      rwa [Real.log_exp] at this
    rw [hs0 _ (by linarith)]
    ring
  have hGc : ContinuousOn (fun x : ℝ => -(Real.sqrt 2 * c * ρ * x ^ (-h) *
      (1 - s ((Real.log (x / Xb) + 2) / 2)))) (Icc X6 Xb) := by
    have hpos : ∀ x ∈ Icc X6 Xb, x ≠ 0 := fun x hx => (lt_of_lt_of_le hX6 hx.1).ne'
    apply ContinuousOn.neg
    apply ContinuousOn.mul
    · apply ContinuousOn.mul continuousOn_const
