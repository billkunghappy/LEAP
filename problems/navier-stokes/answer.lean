    exact ⟨(hS.1 (x 2) (1 - t) (by linarith [hxt'.1])).1, by linarith [hxt'.2]⟩
  have key2 : ∀ (C a b q : ℝ), 0 < q → q ≤ 1 → b ≤ a → C * q ^ a ≤ |C| * q ^ b := by
    intro C a b q hq0 hq1 hba
    calc C * q ^ a ≤ |C| * q ^ a := mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0.le _)
      _ ≤ |C| * q ^ b :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0 hq1 hba) (abs_nonneg C)
  refine ⟨qsOf l0, h / 10, L5, L4, telD (fun j => fA5 B G l0 (st j)), telD (fun j => fB B G l0 (st j)),
    telD (fun j => fP5 B G l0 (st j)), ⟨hqs0, hqsB, by linarith⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro j
    cases j with
    | zero => exact (hP 0).1
    | succ i =>
      exact ⟨(hP (i+1)).1.1.sub (hP i).1.1, (hP (i+1)).1.2.1.sub (hP i).1.2.1,
        (hP (i+1)).1.2.2.sub (hP i).1.2.2⟩
  ·
    intro j x t hxt
    cases j with
    | zero => exact (hP 0).2.1 x t hxt
    | succ i => exact (H5 (st i) (st (i+1)) _ _ _ _ _ _ _ _ _ (hst i) (hst (i+1)) (hinc i)).1 x t hxt
  ·
    intro m
    exact (hP 0).2.2.1 m
  ·
    intro j hj m
    obtain ⟨i, rfl⟩ : ∃ i, j = i + 1 := ⟨j - 1, by omega⟩
    obtain ⟨C, hC⟩ := (H5 (st i) (st (i+1)) _ _ _ _ _ _ _ _ _ (hst i) (hst (i+1)) (hinc i)).2 m
    have hi0 : (0:ℝ) ≤ i := Nat.cast_nonneg i
    have hexp : h / 10 * ((i + 1 : ℕ) : ℝ) - L5 m ≤ h * (7/10 + (i:ℝ)/10 - kapS) - L5 m := by
      push_cast; rw [hk]; nlinarith
    refine ⟨|C|, fun x t hxt => ?_⟩
    obtain ⟨hq0, hq1⟩ := hq x t hxt
    obtain ⟨e1, e2, e3⟩ := hC x t hxt
    exact ⟨le_trans e1 (key2 _ _ _ _ hq0 hq1 hexp), le_trans e2 (key2 _ _ _ _ hq0 hq1 hexp),
      le_trans e3 (key2 _ _ _ _ hq0 hq1 hexp)⟩
  ·
    intro J m
    have hsA : ∀ w s, ∑ j ∈ Finset.range (J + 1), telD (fun j => fA5 B G l0 (st j)) j w s =
        fA5 B G l0 (st J) w s := by
      intro w s
      have := congrFun (congrFun (htel (fun j => fA5 B G l0 (st j)) J) w) s
      simpa only [Finset.sum_apply] using this
    have hsB : ∀ w s, ∑ j ∈ Finset.range (J + 1), telD (fun j => fB B G l0 (st j)) j w s =
        fB B G l0 (st J) w s := by
      intro w s
      have := congrFun (congrFun (htel (fun j => fB B G l0 (st j)) J) w) s
      simpa only [Finset.sum_apply] using this
    have hsP : ∀ w s, ∑ j ∈ Finset.range (J + 1), telD (fun j => fP5 B G l0 (st j)) j w s =
        fP5 B G l0 (st J) w s := by
      intro w s
      have := congrFun (congrFun (htel (fun j => fP5 B G l0 (st j)) J) w) s
      simpa only [Finset.sum_apply] using this
    simp only [hsA, hsB, hsP]
    obtain ⟨C, hC⟩ := (hP J).2.2.2.1 m ⌈h / 10 * (J:ℝ)⌉₊
    refine ⟨|C| + |C|, fun x t hxt => ?_⟩
    obtain ⟨hq0, hq1⟩ := hq x t hxt
    have hbd := hC x t hxt
    have hJ0 : (0:ℝ) ≤ J := Nat.cast_nonneg J
    have hmin : min (7/10 + (J:ℝ)/10) (min (7/10 + (J:ℝ)/10 + 1/2) (7/10 + (J:ℝ)/10 + 1/2)) =
