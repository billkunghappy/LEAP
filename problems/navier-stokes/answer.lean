    refine ⟨c, hc, fun γ m ξ hp => ?_⟩
    obtain ⟨hξ, -, -, -, -⟩ := hPn n γ m ξ hp
    obtain ⟨hw, ⟨U, hU, hξU, hsU⟩, hb⟩ := H γ m ξ hp
    have hev : f γ m =ᶠ[nhds ξ] g γ m :=
      Filter.mem_of_superset (hDo.mem_nhds hξ) (fun η hη => hfg γ m η hη)
    refine ⟨hw, ⟨U ∩ DomC B.h (qsOf l0), hU.inter hDo, ⟨hξU, hξ⟩,
      (hsU.mono Set.inter_subset_left).congr (fun η hη => hfg γ m η hη.2)⟩, fun j hj => ?_⟩
    have := hb j hj
    unfold NB at this ⊢
    rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds]
    exact this
  have hper : ∀ n : ℤ, ∃ c : ℝ, 0 ≤ c ∧ ∀ γ m ξ, pchPtP5 B l0 P Q n γ m ξ →
      NB B.h (pchPT5 B G P Q n γ m) k ξ ≤ c * qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * wtW5 B G bΩ dΩ γ ξ := by
    intro n
    obtain ⟨hmul, hadd, -, hweak, hvec⟩ := cub5_algebra B (pchPtP5 B l0 P Q n) k (hPq n)
    have cQc : CUB5 B (pchPtP5 B l0 P Q n) k Qc (2 * Aex B.h + 1/2) (fun _ _ => 1) := hqcub n _
    have cqa : CUB5 B (pchPtP5 B l0 P Q n) k qa (-(Aex B.h + 1/2)) (fun _ _ => 1) := hqcub n _
    have cMc : CUB5 B (pchPtP5 B l0 P Q n) k (Mc n) 0 (fun _ _ => 1) := by
      refine ⟨|(n:ℝ)|, abs_nonneg _, fun γ m ξ hp => ⟨zero_le_one,
        ⟨Set.univ, isOpen_univ, Set.mem_univ _, contDiffOn_const⟩, fun j hj => ?_⟩⟩
      refine (hNBc ξ _ j).trans ?_
      have hnm : ‖Complex.I * (n : ℂ)‖ = |(n : ℝ)| := by
        rw [norm_mul, Complex.norm_I, one_mul, Complex.norm_intCast]
      rw [hnm, Real.rpow_zero, mul_one, mul_one]
    have cWp : ∀ i, CUB5 B (pchPtP5 B l0 P Q n) k (Wp i) (-Aex B.h + B.h * α1) (wtW5 B G b1 d1) :=
      fun i => hresP n _ _ _ (hWP i).1
    have cWq : ∀ i, CUB5 B (pchPtP5 B l0 P Q n) k (Wq n i) (-Aex B.h + B.h * α2) (wtW5 B G b2 d2) :=
      fun i => hreQ n _ _ _ (hWQ i).1
    have crWq : ∀ i, CUB5 B (pchPtP5 B l0 P Q n) k (rWq n i) (-Aex B.h + B.h * α2 - 1/2 - B.h * kapS)
        (wtW5 B G b2 d2) := fun i => hreQ n _ _ _ (hWQ i).2.1
    have czWq : ∀ i, CUB5 B (pchPtP5 B l0 P Q n) k (zWq n i) (-Aex B.h + B.h * α2 - 1/2)
        (wtW5 B G b2 d2) := fun i => hreQ n _ _ _ (hWQ i).2.2
    have cPhT : CUB5 B (pchPtP5 B l0 P Q n) k PhT (-(Aex B.h + 1/2) + B.h * (α1 - kapS))
        (fun γ ξ => 1 * wtW5 B G b3 d3 γ ξ) := hmul qa T _ _ _ _ cqa (hTc n)
    have hfin : ∀ (f : Lab → ℤ → Cyl → ℂ) (e : ℝ) (w : Lab → Cyl → ℝ), CUB5 B (pchPtP5 B l0 P Q n) k f e w →
        B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2) ≤ e →
        (∀ γ m ξ, pchPtP5 B l0 P Q n γ m ξ → w γ ξ ≤ wtW5 B G bΩ dΩ γ ξ) →
        CUB5 B (pchPtP5 B l0 P Q n) k f (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2)) (wtW5 B G bΩ dΩ) :=
      fun f e w h1 h2 h3 => hweak f e _ w _ h1 h2 h3
    have hA2 : ∀ f g : Lab → ℤ → Cyl → ℂ,
        CUB5 B (pchPtP5 B l0 P Q n) k f (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2)) (wtW5 B G bΩ dΩ) →
        CUB5 B (pchPtP5 B l0 P Q n) k g (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2)) (wtW5 B G bΩ dΩ) →
        CUB5 B (pchPtP5 B l0 P Q n) k (cxAdd5 f g) (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2))
          (wtW5 B G bΩ dΩ) :=
      fun f g hf hg => (hadd f g _ _ hf hg).1
    have hS2 : ∀ f g : Lab → ℤ → Cyl → ℂ,
        CUB5 B (pchPtP5 B l0 P Q n) k f (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2)) (wtW5 B G bΩ dΩ) →
        CUB5 B (pchPtP5 B l0 P Q n) k g (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2)) (wtW5 B G bΩ dΩ) →
        CUB5 B (pchPtP5 B l0 P Q n) k (cxSub5 f g) (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2))
          (wtW5 B G bΩ dΩ) :=
      fun f g hf hg => (hadd f g _ _ hf hg).2
    have tR : ∀ a b : Fin 3, CUB5 B (pchPtP5 B l0 P Q n) k (cxMul5 (Wp a) (rWq n b))
        (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2)) (wtW5 B G bΩ dΩ) := fun a b =>
      hfin _ _ _ (hmul _ _ _ _ _ _ (cWp a) (crWq b)) (by linarith) (hw12 n)
    have tZ : ∀ a b : Fin 3, CUB5 B (pchPtP5 B l0 P Q n) k (cxMul5 (Wp a) (zWq n b))
        (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2)) (wtW5 B G bΩ dΩ) := fun a b =>
      hfin _ _ _ (hmul _ _ _ _ _ _ (cWp a) (czWq b)) (by linarith) (hw12 n)
    have tM : ∀ b : Fin 3, CUB5 B (pchPtP5 B l0 P Q n) k (cxMul5 (cxMul5 (Mc n) PhT) (Wq n b))
        (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2)) (wtW5 B G bΩ dΩ) := fun b =>
      hfin _ _ _ (hmul _ _ _ _ _ _ (hmul _ _ _ _ _ _ cMc cPhT) (cWq b)) (by linarith)
        (fun γ m ξ hp => Eq.trans_le (by norm_num) (hw32 n γ m ξ hp))
    have tRr : ∀ a b : Fin 3, CUB5 B (pchPtP5 B l0 P Q n) k (cxMul5 (cxMul5 (Wp a) (Wq n b)) Rc)
        (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2)) (wtW5 B G bΩ dΩ) := fun a b =>
      hfin _ _ _ (hmul _ _ _ _ _ _ (hmul _ _ _ _ _ _ (cWp a) (cWq b)) (hRc n)) (by linarith)
        (fun γ m ξ hp => Eq.trans_le (by norm_num) (hw12 n γ m ξ hp))
    have hE0 : CUB5 B (pchPtP5 B l0 P Q n) k (E0 n)
        (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2)) (wtW5 B G bΩ dΩ) :=
      hS2 _ _ (hA2 _ _ (hA2 _ _ (tR 0 0) (tZ 2 0)) (tM 0)) (tRr 1 1)
    have hE1 : CUB5 B (pchPtP5 B l0 P Q n) k (E1 n)
        (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2)) (wtW5 B G bΩ dΩ) :=
      hA2 _ _ (hA2 _ _ (hA2 _ _ (tR 0 1) (tZ 2 1)) (tM 1)) (tRr 1 0)
    have hE2 : CUB5 B (pchPtP5 B l0 P Q n) k (E2 n)
        (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2)) (wtW5 B G bΩ dΩ) :=
      hA2 _ _ (hA2 _ _ (tR 0 2) (tZ 2 2)) (tM 2)
    have hcomp : ∀ E : Lab → ℤ → Cyl → ℂ,
        CUB5 B (pchPtP5 B l0 P Q n) k E (B.h * (α1 + α2 - kapS) - (2 * Aex B.h + 1/2)) (wtW5 B G bΩ dΩ) →
        CUB5 B (pchPtP5 B l0 P Q n) k (cxMul5 Qc E) (B.h * (α1 + α2 - kapS)) (wtW5 B G bΩ dΩ) :=
      fun E hE => hweak _ _ _ _ _ (hmul Qc E _ _ _ _ cQc hE) (by linarith)
        (fun γ m ξ _ => le_of_eq (one_mul _))
    have hC0 : CUB5 B (pchPtP5 B l0 P Q n) k (fun γ m η => pchPT5 B G P Q n γ m η 0)
        (B.h * (α1 + α2 - kapS)) (wtW5 B G bΩ dΩ) :=
      hcongr n _ _ _ _ (hcomp _ hE0) (fun γ m η hη => heq0 n γ m η hη)
    have hC1 : CUB5 B (pchPtP5 B l0 P Q n) k (fun γ m η => pchPT5 B G P Q n γ m η 1)
        (B.h * (α1 + α2 - kapS)) (wtW5 B G bΩ dΩ) :=
      hcongr n _ _ _ _ (hcomp _ hE1) (fun γ m η hη => heq1 n γ m η hη)
    have hC2 : CUB5 B (pchPtP5 B l0 P Q n) k (fun γ m η => pchPT5 B G P Q n γ m η 2)
        (B.h * (α1 + α2 - kapS)) (wtW5 B G bΩ dΩ) :=
      hcongr n _ _ _ _ (hcomp _ hE2) (fun γ m η hη => heq2 n γ m η hη)
    obtain ⟨c0, hc0, H0⟩ := hC0
    obtain ⟨c1, hc1, H1⟩ := hC1
    obtain ⟨c2, hc2, H2⟩ := hC2
    refine ⟨c0 + c1 + c2, by linarith, fun γ m ξ hp => ?_⟩
    obtain ⟨-, ⟨U0, hU0o, hU0ξ, hU0s⟩, B0⟩ := H0 γ m ξ hp
    obtain ⟨-, ⟨U1, hU1o, hU1ξ, hU1s⟩, B1⟩ := H1 γ m ξ hp
    obtain ⟨-, ⟨U2, hU2o, hU2ξ, hU2s⟩, B2⟩ := H2 γ m ξ hp
    have hv : NB B.h (pchPT5 B G P Q n γ m) k ξ ≤
        NB B.h (fun η => pchPT5 B G P Q n γ m η 0) k ξ +
        NB B.h (fun η => pchPT5 B G P Q n γ m η 1) k ξ +
        NB B.h (fun η => pchPT5 B G P Q n γ m η 2) k ξ := by
      have := hvec B.h (pchPT5 B G P Q n γ m) ξ k (by
        intro i
        fin_cases i
        · exact hU0s.contDiffAt (hU0o.mem_nhds hU0ξ)
        · exact hU1s.contDiffAt (hU1o.mem_nhds hU1ξ)
        · exact hU2s.contDiffAt (hU2o.mem_nhds hU2ξ))
      rwa [Fin.sum_univ_three] at this
    have e0 := B0 k le_rfl
    have e1 := B1 k le_rfl
    have e2 := B2 k le_rfl
    have hsum : c0 * qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * wtW5 B G bΩ dΩ γ ξ +
        c1 * qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * wtW5 B G bΩ dΩ γ ξ +
        c2 * qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * wtW5 B G bΩ dΩ γ ξ =
        (c0 + c1 + c2) * qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * wtW5 B G bΩ dΩ γ ξ := by ring
    linarith

  have hNB0 : ∀ (F : Cyl → Fin 3 → ℂ) (ξ : Cyl), F =ᶠ[nhds ξ] 0 → NB B.h F k ξ = 0 := by
    intro F ξ hev
    unfold NB
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    have hz : iteratedFDeriv ℝ k (0 : Cyl → Fin 3 → ℂ) ξ = 0 := by
      have := (iteratedFDeriv_fun_zero (𝕜 := ℝ) (E := Cyl) (F := Fin 3 → ℂ) (n := k))
      exact congrFun this ξ
    rw [hz]
    have e : ((0 : ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) (Fin 3 → ℂ))
        ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) = 0 := by
      ext v
      simp
    rw [e, norm_zero]
  have hoffQ : ∀ (γ : Lab) (m n : ℤ) (ξ : Cyl), ξ ∉ tsupport (Q γ n) →
      pchPT5 B G P Q n γ m =ᶠ[nhds ξ] 0 := by
    intro γ m n ξ hξ
    have ha : Q γ n =ᶠ[nhds ξ] 0 := (notMem_tsupport_iff_eventuallyEq).mp hξ
    have hA : pchAmp5 B Q γ n =ᶠ[nhds ξ] 0 := by
      filter_upwards [ha] with y hy
      simp [pchAmp5, hy]
    filter_upwards [hA.eventuallyEq_nhds] with y hy
    have hy0 : pchAmp5 B Q γ n y = 0 := hy.eq_of_nhds
    have hfd : fderiv ℝ (pchAmp5 B Q γ n) y = 0 := by
      rw [hy.fderiv_eq]
      exact fderiv_const_apply (0 : Fin 3 → ℂ)
    funext j
    fin_cases j <;> simp [pchPT5, pchTr5, dR, dZ, hfd, hy0]
  have hoffP : ∀ (γ : Lab) (m n : ℤ) (ξ : Cyl), ξ ∉ tsupport (P γ m) →
      pchPT5 B G P Q n γ m =ᶠ[nhds ξ] 0 := by
    intro γ m n ξ hξ
    have ha : P γ m =ᶠ[nhds ξ] 0 := (notMem_tsupport_iff_eventuallyEq).mp hξ
    filter_upwards [ha] with y hy
    funext j
    fin_cases j <;> simp [pchPT5, pchTr5, pchAmp5, hy]

  choose cn hcn0 hcn using hper
  obtain ⟨HQ, -, hHQ⟩ := hQ.1
  refine ⟨∑ n ∈ HQ, cn n, bΩ, dΩ, fun γ m n ξ hξ hX1 hX2 => ?_⟩
  show NB B.h (pchPT5 B G P Q n γ m) k ξ ≤ _
  have hCs : 0 ≤ ∑ n ∈ HQ, cn n := Finset.sum_nonneg (fun n _ => hcn0 n)
  have hq : 0 ≤ qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) := Real.rpow_nonneg (hDq ξ hξ).1.le _
  have hw0 := hwnn bΩ dΩ γ ξ hξ hX1 hX2
  have hRHS : (∑ n ∈ HQ, cn n) * qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * SC B.h ξ ^ bΩ *
      Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dΩ) *
      Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) =
      (∑ n ∈ HQ, cn n) * qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * wtW5 B G bΩ dΩ γ ξ := by
    unfold wtW5; ring
  rw [hRHS]
  by_cases htP : ξ ∈ tsupport (P γ m)
  · by_cases htQ : ξ ∈ tsupport (Q γ n)
    · have hnH : n ∈ HQ := by
        by_contra hn
        rw [hHQ γ n hn, tsupport_zero] at htQ
        simp at htQ
      have hb := hcn n γ m ξ ⟨hξ, hX1, hX2, htP, htQ⟩
      have hle : cn n ≤ ∑ n ∈ HQ, cn n := Finset.single_le_sum (fun i _ => hcn0 i) hnH
      exact hb.trans (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hle hq) hw0)
    · rw [hNB0 _ ξ (hoffQ γ m n ξ htQ)]
      exact mul_nonneg (mul_nonneg hCs hq) hw0
  · rw [hNB0 _ ξ (hoffP γ m n ξ htP)]
    exact mul_nonneg (mul_nonneg hCs hq) hw0

theorem pch5_star_class : ∀ (B : BG) (G : CorrGeom) (qs α : ℝ), B.ok → (∀ (a : WC), InWg5 B G qs α a → InWg5 B G qs α (fun γ m ξ i => star (a γ m ξ i))) ∧ (∀ (T : Lab → ℤ → Cyl → ℂ), InWg5 B G qs α T → InWg5 B G qs α (fun γ m ξ => star (T γ m ξ))) :=
by
  intro B G qs α hok
  have hD : IsOpen (DomC B.h qs) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio qs := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have s1 : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (L : V →L[ℝ] V), ‖L‖ ≤ 1 →
      ∀ (a : Lab → ℤ → Cyl → V), InWg5 B G qs α a →
        InWg5 B G qs α (fun γ m ξ => L (a γ m ξ)) := by
    intro V _ _ L hL a ha
    obtain ⟨⟨H, H0, hH⟩, sa, da, pa, ba⟩ := ha
    refine ⟨⟨H, H0, fun γ m hm => ?_⟩, fun γ m => ?_, fun γ m ξ hξ c hc => ?_,
      fun γ m ξ hξ hne => ?_, fun k => ?_⟩
    · funext ξ
      show L (a γ m ξ) = 0
      rw [hH γ m hm, Pi.zero_apply, map_zero]
    · exact L.contDiff.comp_contDiffOn (sa γ m)
    · show L (a γ m (shY ξ c)) = L (a γ m ξ)
      rw [da γ m ξ hξ c hc]
    · apply pa γ m ξ hξ
      intro h0
      apply hne
      show L (a γ m ξ) = 0
      rw [h0, map_zero]
    · obtain ⟨C, b, d, hC⟩ := ba k
      refine ⟨C, b, d, fun γ m ξ hξ hX1 hX2 => ?_⟩
      refine le_trans ?_ (hC γ m ξ hξ hX1 hX2)
      have hf : ContDiffAt ℝ ∞ (a γ m) ξ := (sa γ m).contDiffAt (hD.mem_nhds hξ)
      have hit : iteratedFDeriv ℝ k (⇑L ∘ a γ m) ξ =
          L.compContinuousMultilinearMap (iteratedFDeriv ℝ k (a γ m) ξ) :=
        L.iteratedFDeriv_comp_left hf (by exact_mod_cast le_top)
      show NB B.h (⇑L ∘ a γ m) k ξ ≤ NB B.h (a γ m) k ξ
      unfold NB
      rw [hit]
      have e2 : (L.compContinuousMultilinearMap (iteratedFDeriv ℝ k (a γ m) ξ)).compContinuousLinearMap
            (fun _ => Lnorm B.h ξ) =
          L.compContinuousMultilinearMap ((iteratedFDeriv ℝ k (a γ m) ξ).compContinuousLinearMap
            (fun _ => Lnorm B.h ξ)) := by
        ext v; rfl
      rw [e2]
      calc _ ≤ ‖L‖ * ‖(iteratedFDeriv ℝ k (a γ m) ξ).compContinuousLinearMap
              (fun _ => Lnorm B.h ξ)‖ := L.norm_compContinuousMultilinearMap_le _
        _ ≤ 1 * ‖(iteratedFDeriv ℝ k (a γ m) ξ).compContinuousLinearMap
              (fun _ => Lnorm B.h ξ)‖ := mul_le_mul_of_nonneg_right hL (norm_nonneg _)
        _ = _ := one_mul _
  let Lv : (Fin 3 → ℂ) →L[ℝ] (Fin 3 → ℂ) :=
    ContinuousLinearMap.pi (fun i => (Complex.conjCLE : ℂ →L[ℝ] ℂ).comp (ContinuousLinearMap.proj i))
  have hLv : ∀ (v : Fin 3 → ℂ) (i : Fin 3), Lv v i = star (v i) := by
    intro v i
    simp [Lv, Complex.star_def]
  have hLvn : ‖Lv‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound Lv zero_le_one (fun v => ?_)
    rw [one_mul]
    refine (pi_norm_le_iff_of_nonneg (norm_nonneg v)).2 (fun i => ?_)
    rw [hLv, Complex.star_def, Complex.norm_conj]
    exact norm_le_pi_norm v i
  refine ⟨fun a ha => ?_, fun T hT => ?_⟩
  · have h1 := s1 Lv hLvn a ha
    have e : (fun γ m ξ i => star (a γ m ξ i)) = (fun γ m ξ => Lv (a γ m ξ)) := by
      funext γ m ξ i
      exact (hLv _ _).symm
    rw [e]
    exact h1
  · have hn : ‖(Complex.conjCLE : ℂ →L[ℝ] ℂ)‖ ≤ 1 := le_of_eq Complex.conjCLE_norm
    have h1 := s1 (Complex.conjCLE : ℂ →L[ℝ] ℂ) hn T hT
    have e : (fun γ m ξ => star (T γ m ξ)) = (fun γ m ξ => (Complex.conjCLE : ℂ →L[ℝ] ℂ) (T γ m ξ)) := by
      funext γ m ξ
      simp [Complex.star_def]
    rw [e]
    exact h1

theorem pch5_pair_finsum : ∀ (B : BG) (G : CorrGeom) (P Q : WC) (HP HQ : Finset ℤ), (∀ γ m, m ∉ HP → P γ m = 0) → (∀ γ m, m ∉ HQ → Q γ m = 0) → ∀ (γ : Lab) (N : ℤ) (η : Cyl), ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) • (pchPair5 B G (pchAmp5 B P) (pchAmp5 B Q) N γ η + pchPair5 B G (pchAmp5 B Q) (pchAmp5 B P) N γ η) = (∑ m ∈ HP, ((1/2 : ℂ) • (((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) • pchTr5 B G γ (N - m) (pchAmp5 B P γ m η) (pchAmp5 B Q γ (N - m)) η) + (1/2 : ℂ) • (((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) • pchTr5 B G γ (N + m) (pchAmp5 B (fun γ' m' ξ' i => star (P γ' m' ξ' i)) γ m η) (pchAmp5 B Q γ (N + m)) η))) + (∑ m ∈ HQ, ((1/2 : ℂ) • (((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) • pchTr5 B G γ (N - m) (pchAmp5 B Q γ m η) (pchAmp5 B P γ (N - m)) η) + (1/2 : ℂ) • (((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) • pchTr5 B G γ (N + m) (pchAmp5 B (fun γ' m' ξ' i => star (Q γ' m' ξ' i)) γ m η) (pchAmp5 B P γ (N + m)) η))) :=
by
  intro B G P Q HP HQ hP hQ γ N η
  have h0 : ∀ (n : ℤ) (al : Fin 3 → ℂ) (bt : Cyl → Fin 3 → ℂ), (∀ i, al i = 0) →
      pchTr5 B G γ n al bt η = 0 := by
    intro n al bt hal
    have a0 := hal 0
    have a1 := hal 1
    have a2 := hal 2
    funext i
    fin_cases i <;> simp [pchTr5, a0, a1, a2]
  have hst : ∀ (X : WC) (m : ℤ), (fun i => star (pchAmp5 B X γ m η i)) =
      pchAmp5 B (fun γ' m' ξ' i => star (X γ' m' ξ' i)) γ m η := by
    intro X m
    funext i
    simp only [pchAmp5, Pi.smul_apply, smul_eq_mul, Complex.star_def, map_mul, Complex.conj_ofReal]
  have hsupp : ∀ (X Y : WC) (HX : Finset ℤ), (∀ γ m, m ∉ HX → X γ m = 0) →
      pchPair5 B G (pchAmp5 B X) (pchAmp5 B Y) N γ η =
        ∑ m ∈ HX, ((1/2 : ℂ) • pchTr5 B G γ (N - m) (pchAmp5 B X γ m η) (pchAmp5 B Y γ (N - m)) η +
          (1/2 : ℂ) • pchTr5 B G γ (N + m) (fun i => star (pchAmp5 B X γ m η i))
            (pchAmp5 B Y γ (N + m)) η) := by
    intro X Y HX hX
    unfold pchPair5
    apply finsum_eq_sum_of_support_subset
    rw [Function.support_subset_iff']
    intro m hm
    have hm' : m ∉ HX := fun h => hm (Finset.mem_coe.mpr h)
    have hz : ∀ i, pchAmp5 B X γ m η i = 0 := by
      intro i
      simp [pchAmp5, hX γ m hm']
    rw [h0 _ _ _ hz, h0 _ _ _ (fun i => by simp [hz i])]
    simp
  rw [hsupp P Q HP hP, hsupp Q P HQ hQ, smul_add, Finset.smul_sum, Finset.smul_sum]
  congr 1 <;> refine Finset.sum_congr rfl (fun m _ => ?_) <;>
    rw [smul_add, smul_comm _ (1/2 : ℂ), smul_comm _ (1/2 : ℂ), hst]

theorem pch5_nb_lin : ∀ (h : ℝ) (U : Set Cyl), IsOpen U → ∀ ξ ∈ U, ∀ k : ℕ, (∀ (f g : Cyl → (Fin 3 → ℂ)), ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ g U → NB h (fun η => f η + g η) k ξ ≤ NB h f k ξ + NB h g k ξ) ∧ (∀ (c : ℂ) (f : Cyl → (Fin 3 → ℂ)), ContDiffOn ℝ ∞ f U → NB h (fun η => c • f η) k ξ ≤ ‖c‖ * NB h f k ξ) ∧ (∀ (s : Finset ℤ) (f : ℤ → Cyl → (Fin 3 → ℂ)), (∀ i ∈ s, ContDiffOn ℝ ∞ (f i) U) → NB h (fun η => ∑ i ∈ s, f i η) k ξ ≤ ∑ i ∈ s, NB h (f i) k ξ) :=
by
  intro h U hU ξ hξ k
  have hn : U ∈ nhds ξ := hU.mem_nhds hξ
  have hcd : ∀ F : Cyl → (Fin 3 → ℂ), ContDiffOn ℝ ∞ F U → ContDiffAt ℝ k F ξ := fun F hF =>
    (hF.contDiffAt hn).of_le (by exact_mod_cast le_top)
  have hA : ∀ (f g : Cyl → (Fin 3 → ℂ)), ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ g U →
      NB h (fun η => f η + g η) k ξ ≤ NB h f k ξ + NB h g k ξ := by
    intro f g hf hg
    have e1 : iteratedFDeriv ℝ k (fun η => f η + g η) ξ =
        iteratedFDeriv ℝ k f ξ + iteratedFDeriv ℝ k g ξ :=
      iteratedFDeriv_add_apply (hcd f hf) (hcd g hg)
    unfold NB
    rw [e1]
    have e2 : (iteratedFDeriv ℝ k f ξ + iteratedFDeriv ℝ k g ξ).compContinuousLinearMap
          (fun _ => Lnorm h ξ) =
        (iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) +
        (iteratedFDeriv ℝ k g ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    exact norm_add_le _ _
  refine ⟨hA, ?_, ?_⟩
  · intro c f hf
    have e1 : iteratedFDeriv ℝ k (fun η => c • f η) ξ = c • iteratedFDeriv ℝ k f ξ :=
      iteratedFDeriv_const_smul_apply' (hcd f hf)
    unfold NB
    rw [e1]
    have e2 : (c • iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) =
        c • (iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    exact norm_smul_le c ((iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm h ξ))
  · intro s f
    classical
    induction s using Finset.induction_on with
    | empty =>
      intro _
      simp only [Finset.sum_empty]
      unfold NB
      rw [iteratedFDeriv_fun_zero]
      have e : ((0 : Cyl → ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) (Fin 3 → ℂ)) ξ).compContinuousLinearMap
          (fun _ => Lnorm h ξ) = 0 := by
        ext m
        simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      rw [e, norm_zero]
    | insert a s ha ih =>
      intro hs
      have hfa : ContDiffOn ℝ ∞ (f a) U := hs a (Finset.mem_insert_self a s)
      have hs' : ∀ i ∈ s, ContDiffOn ℝ ∞ (f i) U := fun i hi => hs i (Finset.mem_insert_of_mem hi)
      have hG : ContDiffOn ℝ ∞ (fun η => ∑ i ∈ s, f i η) U :=
        ContDiffOn.sum (fun i hi => hs' i hi)
      have e : (fun η => ∑ i ∈ insert a s, f i η) = fun η => f a η + ∑ i ∈ s, f i η := by
        funext η
        rw [Finset.sum_insert ha]
      rw [e, Finset.sum_insert ha]
      have h1 := hA (f a) (fun η => ∑ i ∈ s, f i η) hfa hG
      have h2 := ih hs'
      linarith

theorem pch5_pw_bound : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (P Q : WC) (α1 α2 : ℝ), InWg5 B G (qsOf l0) α1 P → InWg5 B G (qsOf l0) α2 Q → InWg5 B G (qsOf l0) (α1 - kapS) (fun γ m ξ => ((qC B.h ξ ^ (1/2:ℝ) * (kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) : ℝ) : ℂ) * (((nPhi5 B G γ ξ 0 : ℝ) : ℂ) * P γ m ξ 0 + ((nPhi5 B G γ ξ 1 : ℝ) : ℂ) * P γ m ξ 1 + ((nPhi5 B G γ ξ 2 : ℝ) : ℂ) * P γ m ξ 2)) → InWg5 B G (qsOf l0) (α2 - kapS) (fun γ m ξ => ((qC B.h ξ ^ (1/2:ℝ) * (kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) : ℝ) : ℂ) * (((nPhi5 B G γ ξ 0 : ℝ) : ℂ) * Q γ m ξ 0 + ((nPhi5 B G γ ξ 1 : ℝ) : ℂ) * Q γ m ξ 1 + ((nPhi5 B G γ ξ 2 : ℝ) : ℂ) * Q γ m ξ 2)) → (∀ (γ : Lab) (N : ℤ), ContDiffOn ℝ ∞ (fun η => ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) • (pchPair5 B G (pchAmp5 B P) (pchAmp5 B Q) N γ η + pchPair5 B G (pchAmp5 B Q) (pchAmp5 B P) N γ η)) (DomC B.h (qsOf l0))) ∧ ∀ k : ℕ, ∃ C b d : ℝ, ∀ (γ : Lab) (N : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → NB B.h (fun η => ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) • (pchPair5 B G (pchAmp5 B P) (pchAmp5 B Q) N γ η + pchPair5 B G (pchAmp5 B Q) (pchAmp5 B P) N γ η)) k ξ ≤ C * qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * SC B.h ξ ^ b * Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) :=
by
  intro B G hok hG
  obtain ⟨lp, hPT⟩ := pch5_pair_term B G hok hG
  refine ⟨lp, ?_⟩
  intro l0 hl0 P Q α1 α2 hP hQ hTP hTQ
  have hh0 : 0 ≤ B.h := hok.2.1.1.le
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hUo : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'

  have hPs := (pch5_star_class B G (qsOf l0) α1 hok).1 P hP
  have hQs := (pch5_star_class B G (qsOf l0) α2 hok).1 Q hQ
  have hTPs := (pch5_star_class B G (qsOf l0) (α1 - kapS) hok).2 _ hTP
  have hTQs := (pch5_star_class B G (qsOf l0) (α2 - kapS) hok).2 _ hTQ

  have I1 := hPT l0 hl0 P Q _ α1 α2 hP hQ hTP (fun γ m ξ _ => rfl)
  have I2 := hPT l0 hl0 (fun γ' m' ξ' i => star (P γ' m' ξ' i)) Q _ α1 α2 hPs hQ hTPs
    (fun γ m ξ _ => by simp only [Complex.star_def, map_mul, map_add, Complex.conj_ofReal])
  have I3 := hPT l0 hl0 Q P _ α2 α1 hQ hP hTQ (fun γ m ξ _ => rfl)
  have I4 := hPT l0 hl0 (fun γ' m' ξ' i => star (Q γ' m' ξ' i)) P _ α2 α1 hQs hP hTQs
    (fun γ m ξ _ => by simp only [Complex.star_def, map_mul, map_add, Complex.conj_ofReal])

  obtain ⟨HP, -, hHP⟩ := hP.1
  obtain ⟨HQ, -, hHQ⟩ := hQ.1
  have hfs := pch5_pair_finsum B G P Q HP HQ hHP hHQ

  obtain ⟨J, hJ⟩ : ∃ J : WC → WC → Lab → ℤ → ℤ → Cyl → (Fin 3 → ℂ), ∀ X Y γ m n η,
      J X Y γ m n η = ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) •
        pchTr5 B G γ n (pchAmp5 B X γ m η) (pchAmp5 B Y γ n) η :=
    ⟨fun X Y γ m n η => ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) •
        pchTr5 B G γ n (pchAmp5 B X γ m η) (pchAmp5 B Y γ n) η, fun _ _ _ _ _ _ => rfl⟩
  have eJ : ∀ X Y γ m n, J X Y γ m n = fun η => ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) •
      pchTr5 B G γ n (pchAmp5 B X γ m η) (pchAmp5 B Y γ n) η :=
    fun X Y γ m n => funext (hJ X Y γ m n)
  have hJ1 : ∀ γ m n, ContDiffOn ℝ ∞ (J P Q γ m n) (DomC B.h (qsOf l0)) := by
    intro γ m n; rw [eJ]; exact I1.1 γ m n
  have hJ2 : ∀ γ m n, ContDiffOn ℝ ∞ (J (fun γ' m' ξ' i => star (P γ' m' ξ' i)) Q γ m n)
      (DomC B.h (qsOf l0)) := by
    intro γ m n; rw [eJ]; exact I2.1 γ m n
  have hJ3 : ∀ γ m n, ContDiffOn ℝ ∞ (J Q P γ m n) (DomC B.h (qsOf l0)) := by
    intro γ m n; rw [eJ]; exact I3.1 γ m n
  have hJ4 : ∀ γ m n, ContDiffOn ℝ ∞ (J (fun γ' m' ξ' i => star (Q γ' m' ξ' i)) P γ m n)
      (DomC B.h (qsOf l0)) := by
    intro γ m n; rw [eJ]; exact I4.1 γ m n

  obtain ⟨gP, hgP⟩ : ∃ g : Lab → ℤ → ℤ → Cyl → (Fin 3 → ℂ), ∀ γ N m η,
      g γ N m η = (1/2 : ℂ) • J P Q γ m (N - m) η +
        (1/2 : ℂ) • J (fun γ' m' ξ' i => star (P γ' m' ξ' i)) Q γ m (N + m) η :=
    ⟨fun γ N m η => (1/2 : ℂ) • J P Q γ m (N - m) η +
        (1/2 : ℂ) • J (fun γ' m' ξ' i => star (P γ' m' ξ' i)) Q γ m (N + m) η,
      fun _ _ _ _ => rfl⟩
  obtain ⟨gQ, hgQ⟩ : ∃ g : Lab → ℤ → ℤ → Cyl → (Fin 3 → ℂ), ∀ γ N m η,
      g γ N m η = (1/2 : ℂ) • J Q P γ m (N - m) η +
        (1/2 : ℂ) • J (fun γ' m' ξ' i => star (Q γ' m' ξ' i)) P γ m (N + m) η :=
    ⟨fun γ N m η => (1/2 : ℂ) • J Q P γ m (N - m) η +
        (1/2 : ℂ) • J (fun γ' m' ξ' i => star (Q γ' m' ξ' i)) P γ m (N + m) η,
      fun _ _ _ _ => rfl⟩
  have hfs' : ∀ (γ : Lab) (N : ℤ) (η : Cyl),
      ((qC B.h η ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) • (pchPair5 B G (pchAmp5 B P) (pchAmp5 B Q) N γ η +
        pchPair5 B G (pchAmp5 B Q) (pchAmp5 B P) N γ η) =
      (∑ m ∈ HP, gP γ N m η) + ∑ m ∈ HQ, gQ γ N m η := by
    intro γ N η
    rw [hfs γ N η]
    simp only [hgP, hgQ, hJ]
  have hgs : ∀ γ N m, ContDiffOn ℝ ∞ (gP γ N m) (DomC B.h (qsOf l0)) := by
    intro γ N m
    rw [funext (hgP γ N m)]
    exact ((hJ1 γ m (N - m)).const_smul (1/2 : ℂ)).add ((hJ2 γ m (N + m)).const_smul (1/2 : ℂ))
  have hgsQ : ∀ γ N m, ContDiffOn ℝ ∞ (gQ γ N m) (DomC B.h (qsOf l0)) := by
    intro γ N m
    rw [funext (hgQ γ N m)]
    exact ((hJ3 γ m (N - m)).const_smul (1/2 : ℂ)).add ((hJ4 γ m (N + m)).const_smul (1/2 : ℂ))
  have hsP : ∀ γ N, ContDiffOn ℝ ∞ (fun η => ∑ m ∈ HP, gP γ N m η) (DomC B.h (qsOf l0)) :=
    fun γ N => ContDiffOn.sum (fun m (_ : m ∈ HP) => hgs γ N m)
  have hsQ : ∀ γ N, ContDiffOn ℝ ∞ (fun η => ∑ m ∈ HQ, gQ γ N m η) (DomC B.h (qsOf l0)) :=
    fun γ N => ContDiffOn.sum (fun m (_ : m ∈ HQ) => hgsQ γ N m)
  refine ⟨fun γ N => ((hsP γ N).add (hsQ γ N)).congr (fun η _ => hfs' γ N η), ?_⟩

  intro k
  obtain ⟨C1, b1, d1, hb1⟩ := I1.2 k
  obtain ⟨C2, b2, d2, hb2⟩ := I2.2 k
  obtain ⟨C3, b3, d3, hb3⟩ := I3.2 k
  obtain ⟨C4, b4, d4, hb4⟩ := I4.2 k
  obtain ⟨bb, hbb⟩ : ∃ x : ℝ, x = |b1| + |b2| + |b3| + |b4| := ⟨_, rfl⟩
  obtain ⟨dd, hdd⟩ : ∃ x : ℝ, x = |d1| + |d2| + |d3| + |d4| := ⟨_, rfl⟩
  have hb1' : b1 ≤ bb := by rw [hbb]; linarith [le_abs_self b1, abs_nonneg b2, abs_nonneg b3, abs_nonneg b4]
  have hb2' : b2 ≤ bb := by rw [hbb]; linarith [le_abs_self b2, abs_nonneg b1, abs_nonneg b3, abs_nonneg b4]
  have hb3' : b3 ≤ bb := by rw [hbb]; linarith [le_abs_self b3, abs_nonneg b2, abs_nonneg b1, abs_nonneg b4]
  have hb4' : b4 ≤ bb := by rw [hbb]; linarith [le_abs_self b4, abs_nonneg b2, abs_nonneg b3, abs_nonneg b1]
  have hd1' : d1 ≤ dd := by rw [hdd]; linarith [le_abs_self d1, abs_nonneg d2, abs_nonneg d3, abs_nonneg d4]
  have hd2' : d2 ≤ dd := by rw [hdd]; linarith [le_abs_self d2, abs_nonneg d1, abs_nonneg d3, abs_nonneg d4]
  have hd3' : d3 ≤ dd := by rw [hdd]; linarith [le_abs_self d3, abs_nonneg d2, abs_nonneg d1, abs_nonneg d4]
  have hd4' : d4 ≤ dd := by rw [hdd]; linarith [le_abs_self d4, abs_nonneg d2, abs_nonneg d3, abs_nonneg d1]
  refine ⟨((HP.card : ℝ) + (HQ.card : ℝ)) * (|C1| + |C2| + |C3| + |C4|), bb, dd, ?_⟩
  intro γ N ξ hξ hX1 hX2

  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  have hξ' := hξ
  obtain ⟨-, e2, e3⟩ := hξ'
  have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hS1 : (1:ℝ) ≤ SC B.h ξ := by
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hX : 0 < XC B.h ξ := lt_trans hXa hX1
  have he0 : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) := by
    have l1 : 0 < Real.log (XC B.h ξ / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr hX1)
    have l2 : 0 < Real.log (B.Xb / XC B.h ξ) := Real.log_pos ((one_lt_div hX).mpr hX2)
    exact lt_min one_pos (lt_min l1 l2)
  have he1 : edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := min_le_left _ _
  have hP0 : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
    unfold Penv5
    exact (Real.exp_pos _).le
  obtain ⟨W, hW⟩ : ∃ W : ℝ, W = qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * SC B.h ξ ^ bb *
      Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd) *
      Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := ⟨_, rfl⟩
  have hW0 : 0 ≤ W := by
    rw [hW]
    exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (Real.rpow_nonneg hq0.le _)
      (Real.rpow_nonneg (by linarith) _)) (Real.sqrt_nonneg _)) (Real.rpow_nonneg he0.le _)) hP0
  have key : ∀ (C b d e N0 : ℝ), b ≤ bb → d ≤ dd → e = B.h * (α1 + α2 - kapS) →
      N0 ≤ C * qC B.h ξ ^ e * SC B.h ξ ^ b * Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) →
      N0 ≤ |C| * W := by
    intro C b d e N0 hb hd he hN
    rw [he] at hN
    have f2 : SC B.h ξ ^ b ≤ SC B.h ξ ^ bb := Real.rpow_le_rpow_of_exponent_le hS1 hb
    have f3 : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd) :=
      Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hd)
    have p0 : 0 ≤ qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) := Real.rpow_nonneg hq0.le _
    have pS : 0 ≤ SC B.h ξ ^ b := Real.rpow_nonneg (by linarith) _
    have pS' : 0 ≤ SC B.h ξ ^ bb := Real.rpow_nonneg (by linarith) _
    have pE : 0 ≤ Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) := Real.sqrt_nonneg _
    have pD : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) := Real.rpow_nonneg he0.le _
    have m1 : qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * SC B.h ξ ^ b ≤
        qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * SC B.h ξ ^ bb := mul_le_mul_of_nonneg_left f2 p0
    have m2 := mul_le_mul_of_nonneg_right m1 pE
    have m3 := mul_le_mul m2 f3 pD (mul_nonneg (mul_nonneg p0 pS') pE)
    have m4 := mul_le_mul_of_nonneg_right m3 hP0
    have X0 : 0 ≤ qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * SC B.h ξ ^ b *
        Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) *
        Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) :=
      mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg p0 pS) pE) pD) hP0
    calc N0 ≤ C * qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * SC B.h ξ ^ b *
          Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) *
          Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := hN
      _ = C * (qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * SC B.h ξ ^ b *
          Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) *
          Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) := by ring
      _ ≤ |C| * (qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) * SC B.h ξ ^ b *
          Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) *
          Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) := mul_le_mul_of_nonneg_right (le_abs_self C) X0
      _ ≤ |C| * W := by rw [hW]; exact mul_le_mul_of_nonneg_left m4 (abs_nonneg C)
  have hL := pch5_nb_lin B.h (DomC B.h (qsOf l0)) hUo ξ hξ k
  have hhalf : ‖(1/2 : ℂ)‖ = 1/2 := by simp
  have c1 := mul_nonneg (abs_nonneg C1) hW0
  have c2 := mul_nonneg (abs_nonneg C2) hW0
  have c3 := mul_nonneg (abs_nonneg C3) hW0
  have c4 := mul_nonneg (abs_nonneg C4) hW0
  have hgb : ∀ m : ℤ, NB B.h (gP γ N m) k ξ ≤ (|C1| + |C2| + |C3| + |C4|) * W := by
    intro m
    have a1 : NB B.h (J P Q γ m (N - m)) k ξ ≤ |C1| * W := by
      rw [eJ]; exact key C1 b1 d1 _ _ hb1' hd1' rfl (hb1 γ m (N - m) ξ hξ hX1 hX2)
    have a2 : NB B.h (J (fun γ' m' ξ' i => star (P γ' m' ξ' i)) Q γ m (N + m)) k ξ ≤ |C2| * W := by
      rw [eJ]; exact key C2 b2 d2 _ _ hb2' hd2' rfl (hb2 γ m (N + m) ξ hξ hX1 hX2)
    have n1 := hL.2.1 (1/2 : ℂ) _ (hJ1 γ m (N - m))
    have n2 := hL.2.1 (1/2 : ℂ) _ (hJ2 γ m (N + m))
    have s := hL.1 _ _ ((hJ1 γ m (N - m)).const_smul (1/2 : ℂ)) ((hJ2 γ m (N + m)).const_smul (1/2 : ℂ))
    rw [hhalf] at n1 n2
    rw [funext (hgP γ N m)]
    linarith
  have hgbQ : ∀ m : ℤ, NB B.h (gQ γ N m) k ξ ≤ (|C1| + |C2| + |C3| + |C4|) * W := by
    intro m
    have a1 : NB B.h (J Q P γ m (N - m)) k ξ ≤ |C3| * W := by
      rw [eJ]; exact key C3 b3 d3 _ _ hb3' hd3' (by ring) (hb3 γ m (N - m) ξ hξ hX1 hX2)
    have a2 : NB B.h (J (fun γ' m' ξ' i => star (Q γ' m' ξ' i)) P γ m (N + m)) k ξ ≤ |C4| * W := by
      rw [eJ]; exact key C4 b4 d4 _ _ hb4' hd4' (by ring) (hb4 γ m (N + m) ξ hξ hX1 hX2)
    have n1 := hL.2.1 (1/2 : ℂ) _ (hJ3 γ m (N - m))
    have n2 := hL.2.1 (1/2 : ℂ) _ (hJ4 γ m (N + m))
    have s := hL.1 _ _ ((hJ3 γ m (N - m)).const_smul (1/2 : ℂ)) ((hJ4 γ m (N + m)).const_smul (1/2 : ℂ))
    rw [hhalf] at n1 n2
    rw [funext (hgQ γ N m)]
    linarith
  have s0 := hL.1 _ _ (hsP γ N) (hsQ γ N)
  have sP := hL.2.2 HP (gP γ N) (fun m _ => hgs γ N m)
  have sQ := hL.2.2 HQ (gQ γ N) (fun m _ => hgsQ γ N m)
  have tP : ∑ m ∈ HP, NB B.h (gP γ N m) k ξ ≤ ∑ m ∈ HP, (|C1| + |C2| + |C3| + |C4|) * W :=
    Finset.sum_le_sum (fun m _ => hgb m)
  have tQ : ∑ m ∈ HQ, NB B.h (gQ γ N m) k ξ ≤ ∑ m ∈ HQ, (|C1| + |C2| + |C3| + |C4|) * W :=
    Finset.sum_le_sum (fun m _ => hgbQ m)
  rw [Finset.sum_const, nsmul_eq_mul] at tP tQ
  rw [funext (hfs' γ N)]
  have hfin : ((HP.card : ℝ) + (HQ.card : ℝ)) * (|C1| + |C2| + |C3| + |C4|) * W =
      ((HP.card : ℝ) + (HQ.card : ℝ)) * (|C1| + |C2| + |C3| + |C4|) * qC B.h ξ ^ (B.h * (α1 + α2 - kapS)) *
        SC B.h ξ ^ bb * Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
    rw [hW]; ring
  rw [← hfin]
  have hc0 : 0 ≤ (|C1| + |C2| + |C3| + |C4|) * W := by positivity
  nlinarith [s0, sP, sQ, tP, tQ]

theorem pch5_coeff_bound : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (S : CState) (bw ca cm cd β : ℝ) (D : WC), StOrd5 B G l0 S bw ca cm cd → InWg5 B G (qsOf l0) (β + 1/2) D → InWg5 B G (qsOf l0) β (velW5 B G D) → ∀ k : ℕ, ∃ C b d : ℝ, ∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → NB B.h (pchG5 B G (fun ξ a => mcor5 B G l0 S a ξ) (wmoAmp5 B G S.Aw) (wmoAmp5 B G D) γ m) k ξ ≤ C * qC B.h ξ ^ (B.h * (β + 2/5)) * SC B.h ξ ^ b * Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) :=
by
  intro B G hok hG
  obtain ⟨lT, hT⟩ := pch5_transversal B G hok hG
  obtain ⟨lM, hMW⟩ := pch5_mw_bound B G hok hG
  obtain ⟨lP, hPW⟩ := pch5_pw_bound B G hok hG
  obtain ⟨lw, hw⟩ := wmo_amp_class_v5 B G hok hG
  refine ⟨lT + lM + lP + lw, ?_⟩
  intro l0 hl0 S bw ca cm cd β D hS hD hDv k
  have hS' := hS
  unfold StOrd5 at hS'
  obtain ⟨c1, -, -, -, -, -, -, -, -, -, -, -, -, -, -, c16, -, c18, c19, -, c21, -, -⟩ := hS'
  have hh0 : 0 ≤ B.h := hok.2.1.1.le
  have hXa : 0 < B.Xa := hok.2.1.2.2.1

  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hDq : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 ∧ 1 ≤ SC B.h ξ := by
    have hqs1 : qsOf l0 ≤ 1 := by
      show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
      exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
    intro ξ hξ
    obtain ⟨-, e2, e3⟩ := hξ
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    refine ⟨hq0, by linarith, ?_⟩
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hEdge : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X ∧
      0 < edgeDist B.Xa B.Xb X ∧ edgeDist B.Xa B.Xb X ≤ 1 := by
    intro X e1 e2
    refine ⟨?_, ?_, min_le_left _ _⟩
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · have hX : 0 < X := lt_trans hXa e1
      have l1 : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr e1)
      have l2 : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX).mpr e2)
      exact lt_min one_pos (lt_min l1 l2)

  have hW : ∀ (q Sv E e P C1 C2 b1 b2 d1 d2 α α1 α2 N1 N2 : ℝ), 0 < q → q ≤ 1 → 1 ≤ Sv → 0 ≤ E →
      0 < e → e ≤ 1 → 0 ≤ P → α ≤ α1 → α ≤ α2 →
      N1 ≤ C1 * q ^ (B.h * α1) * Sv ^ b1 * E * e ^ (-d1) * P →
      N2 ≤ C2 * q ^ (B.h * α2) * Sv ^ b2 * E * e ^ (-d2) * P →
      N1 + N2 ≤ (|C1| + |C2|) * q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P := by
    intro q Sv E e P C1 C2 b1 b2 d1 d2 α α1 α2 N1 N2 hq0 hq1 hS1 hE he0 he1 hP0 ha1 ha2 hN1 hN2
    have key : ∀ (C b d αi N : ℝ), α ≤ αi → N ≤ C * q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P →
        b ≤ max b1 b2 → d ≤ max d1 d2 →
        N ≤ |C| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by
      intro C b d αi N hα hN hb hd
      have f1 : q ^ (B.h * αi) ≤ q ^ (B.h * α) :=
        Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (mul_le_mul_of_nonneg_left hα hh0)
      have f2 : Sv ^ b ≤ Sv ^ (max b1 b2) := Real.rpow_le_rpow_of_exponent_le hS1 hb
      have f3 : e ^ (-d) ≤ e ^ (-(max d1 d2)) :=
        Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hd)
      have p1 : 0 ≤ q ^ (B.h * αi) := Real.rpow_nonneg hq0.le _
      have p2 : 0 ≤ Sv ^ b := Real.rpow_nonneg (by linarith) _
      have p3 : 0 ≤ e ^ (-d) := Real.rpow_nonneg he0.le _
      have p1' : 0 ≤ q ^ (B.h * α) := Real.rpow_nonneg hq0.le _
      have p2' : 0 ≤ Sv ^ (max b1 b2) := Real.rpow_nonneg (by linarith) _
      have m1 : q ^ (B.h * αi) * Sv ^ b ≤ q ^ (B.h * α) * Sv ^ (max b1 b2) := mul_le_mul f1 f2 p2 p1'
      have m2 : q ^ (B.h * αi) * Sv ^ b * E ≤ q ^ (B.h * α) * Sv ^ (max b1 b2) * E :=
        mul_le_mul_of_nonneg_right m1 hE
      have m3 : q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) ≤
          q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) :=
        mul_le_mul m2 f3 p3 (mul_nonneg (mul_nonneg p1' p2') hE)
      have hWi := mul_le_mul_of_nonneg_right m3 hP0
      have hWi0 : 0 ≤ q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P :=
        mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg p1 p2) hE) p3) hP0
      calc N ≤ C * q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P := hN
        _ = C * (q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P) := by ring
        _ ≤ |C| * (q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P) :=
            mul_le_mul_of_nonneg_right (le_abs_self C) hWi0
        _ ≤ |C| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) :=
            mul_le_mul_of_nonneg_left hWi (abs_nonneg C)
    have k1 := key C1 b1 d1 α1 N1 ha1 hN1 (le_max_left _ _) (le_max_left _ _)
    have k2 := key C2 b2 d2 α2 N2 ha2 hN2 (le_max_right _ _) (le_max_right _ _)
    have e : (|C1| + |C2|) * q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P =
        |C1| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) +
        |C2| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by ring
    rw [e]
    linarith

  have hNB : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f1 f2 g : Cyl → V) (k : ℕ) (ξ : Cyl),
      ξ ∈ DomC B.h (qsOf l0) → ContDiffOn ℝ ∞ f1 (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ f2 (DomC B.h (qsOf l0)) →
      (∀ η ∈ DomC B.h (qsOf l0), g η = f1 η + f2 η) → NB B.h g k ξ ≤ NB B.h f1 k ξ + NB B.h f2 k ξ := by
    intro V _ _ f1 f2 g k ξ hξ hf1 hf2 heq
    have hn : DomC B.h (qsOf l0) ∈ nhds ξ := hDopen.mem_nhds hξ
    have hev : g =ᶠ[nhds ξ] f1 + f2 := Filter.eventuallyEq_of_mem hn (fun η hη => heq η hη)
    have e1 : iteratedFDeriv ℝ k g ξ = iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ := by
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      exact iteratedFDeriv_add_apply ((hf1.contDiffAt hn).of_le (by exact_mod_cast le_top))
        ((hf2.contDiffAt hn).of_le (by exact_mod_cast le_top))
    unfold NB
    rw [e1]
    have e2 : (iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) =
        (iteratedFDeriv ℝ k f1 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) +
        (iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    exact norm_add_le _ _
  have hNB0 : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (k : ℕ) (ξ : Cyl),
      NB B.h (fun _ : Cyl => (0 : V)) k ξ = 0 := by
    intro V _ _ k ξ
    unfold NB
    rw [iteratedFDeriv_fun_zero]
    have e : ((0 : Cyl → ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) V) ξ).compContinuousLinearMap
        (fun _ => Lnorm B.h ξ) = 0 := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e, norm_zero]

  have hc1' : InWg5 B G (qsOf l0) (1/2 + 1/2) S.Aw := by
    have e : (1/2 + 1/2 : ℝ) = 1 := by norm_num
    rw [e]
    exact c1
  obtain ⟨hwA, -⟩ := hw l0 (by omega)
  have hP := hwA S.Aw (1/2) hc1' c16
  have hQ := hwA D β hD hDv
  have hTP := hT l0 (by omega) S.Aw (1/2) hc1' c16
  have hTQ := hT l0 (by omega) D β hD hDv
  have hMn : ∀ a : Fin 3, InM B (qsOf l0) 0.9 (nrm B (Aex B.h) (mcor5 B G l0 S a)) := by
    intro a
    fin_cases a
    · show InM B (qsOf l0) 0.9 (nrm B (Aex B.h) (mcor5 B G l0 S 0))
      obtain ⟨d1, d2, d3, d4⟩ := c21
      refine ⟨d1, d2, d3, fun j => ?_⟩
      obtain ⟨C, b, d, hC⟩ := d4 j
      refine ⟨|C|, b, d, fun ξ hξ hX1 hX2 => le_trans (hC ξ hξ hX1 hX2) ?_⟩
      obtain ⟨hq0, hq1, hS1⟩ := hDq ξ hξ
      obtain ⟨hE, he0, -⟩ := hEdge _ hX1 hX2
      have f1 : C * qC B.h ξ ^ (B.h * 1.9) ≤ |C| * qC B.h ξ ^ (B.h * 0.9) :=
        calc C * qC B.h ξ ^ (B.h * 1.9) ≤ |C| * qC B.h ξ ^ (B.h * 1.9) :=
              mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0.le _)
          _ ≤ |C| * qC B.h ξ ^ (B.h * 0.9) :=
