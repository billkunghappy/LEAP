theorem rfp_pulse_qs_lower : rfpPref (fun P => ∀ x η : ℝ, rfpXg P ≤ x → x ≤ rfpXv P → -1 ≤ η → η ≤ 1 → P.lam / 16 + 3 / 10 * η ^ 2 + Real.exp (-(rfpY2 P.Md) - (1 - P.lam) * (Real.log x - rfpY2 P.Md - 1)) / 10 ≤ leadQs P.h (rfpF P) (rfpU P) x η) :=
