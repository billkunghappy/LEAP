    have b3 : (2:ℝ) ^ i * A * (Cs * W0) ≤ 2 ^ k * A * Cs * W0 := by
      rw [show (2:ℝ) ^ k * A * Cs * W0 = 2 ^ k * A * (Cs * W0) by ring]
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (hpw i hi) hA0) hCW0
    exact (norm_add_le _ _).trans (add_le_add (b1.trans b3) (b2.trans b3))
  have hEb' : ∀ i : ℕ, i ≤ k → ‖iteratedFDeriv ℝ i E w‖ ≤ H * Real.exp (h * w.1) := by
    intro i hi
    have hir : i ∈ Finset.range (k + 1) := Finset.mem_range.mpr (by omega)
    refine (hEb i w).trans (mul_le_mul_of_nonneg_right ?_ heh.le)
    rw [hH]
    exact Finset.single_le_sum (f := fun i => |h| ^ i) (fun i _ => by positivity) hir
  rw [hPeq]
  have hfin := hleib E _ w j (H * Real.exp (h * w.1)) (2 ^ k * A * Cs * W0 + 2 ^ k * A * Cs * W0)
    hEs.contDiffOn hQs hw (fun i hi => hEb' i (by omega)) (fun i hi => hQb i (by omega))
  refine hfin.trans ?_
  have hQ0 : 0 ≤ 2 ^ k * A * Cs * W0 + 2 ^ k * A * Cs * W0 := by positivity
  calc (2:ℝ) ^ j * (H * Real.exp (h * w.1)) * (2 ^ k * A * Cs * W0 + 2 ^ k * A * Cs * W0)
      ≤ 2 ^ k * (H * Real.exp (h * w.1)) * (2 ^ k * A * Cs * W0 + 2 ^ k * A * Cs * W0) :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (hpw j hj)
          (mul_nonneg hH0 heh.le)) hQ0
    _ = 2 ^ k * H * (2 ^ k * A * Cs + 2 ^ k * A * Cs) * Real.exp ((β + h) * w.1) *
          edgeWeight Xa Xb aa ab w.2.1 * edgeDist Xa Xb w.2.1 ^ (-N) := by
        rw [hW0, show (β + h) * w.1 = β * w.1 + h * w.1 by ring, Real.exp_add]
        ring

theorem pbd_bg_lifts : ∀ (B : BG) (s1 : ℝ), B.ok → s1 ≤ Real.log B.qB → s1 ≤ 0 → (ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => B.T0th w.2.1 w.2.2) (Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1)) ∧ ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => B.T0z w.2.1 w.2.2) (Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1)) ∧ ContDiffOn ℝ ∞ (logLift B.Tth) (Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1)) ∧ ContDiffOn ℝ ∞ (logLift B.Tz) (Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1)) ∧ ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => logLift B.Tth w - B.T0th w.2.1 w.2.2) (Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1)) ∧ ContDiffOn ℝ ∞ (fun w : ℝ × ℝ × ℝ => logLift B.Tz w - B.T0z w.2.1 w.2.2) (Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1))) ∧ (∀ w ∈ Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1), (w.2.1 ≤ B.Xa ∨ B.Xb ≤ w.2.1) → B.T0th w.2.1 w.2.2 = 0 ∧ B.T0z w.2.1 w.2.2 = 0 ∧ logLift B.Tth w = 0 ∧ logLift B.Tz w = 0) ∧ (∀ m : ℕ, ∃ C N : ℝ, ∀ w ∈ Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1), B.Xa < w.2.1 → w.2.1 < B.Xb → ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => logLift B.Tth w - B.T0th w.2.1 w.2.2) w‖ ≤ C * Real.exp (B.h * w.1) * edgeWeight B.Xa B.Xb B.aa B.ab w.2.1 * edgeDist B.Xa B.Xb w.2.1 ^ (-N) ∧ ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => logLift B.Tz w - B.T0z w.2.1 w.2.2) w‖ ≤ C * Real.exp (B.h * w.1) * edgeWeight B.Xa B.Xb B.aa B.ab w.2.1 * edgeDist B.Xa B.Xb w.2.1 ^ (-N)) ∧ (∀ m : ℕ, ∃ C N : ℝ, ∀ w ∈ Set.Iio s1 ×ˢ (Set.Ioi 0 ×ˢ Set.Ioo (-1) 1), B.Xa < w.2.1 → w.2.1 < B.Xb → ‖iteratedFDeriv ℝ m (logLift B.Tth) w‖ ≤ C * Real.exp (0 * w.1) * edgeWeight B.Xa B.Xb B.aa B.ab w.2.1 * edgeDist B.Xa B.Xb w.2.1 ^ (-N) ∧ ‖iteratedFDeriv ℝ m (logLift B.Tz) w‖ ≤ C * Real.exp (0 * w.1) * edgeWeight B.Xa B.Xb B.aa B.ab w.2.1 * edgeDist B.Xa B.Xb w.2.1 ^ (-N)) :=
by
  intro B s1 hok hs1 hs10
  obtain ⟨⟨hh0, -, hXa, -, -, -, -, hqB0, -, -, -, -, -⟩, -, ⟨hT0s, hT0zs, hT0v, -, hT0b, -, -⟩, -, -, -, -, -,
    ⟨hTs, hTzs, hTv, hTb⟩, -, -, -⟩ := hok.2
  have hV0o : IsOpen (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hVo : IsOpen (Set.Iio s1 ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) := isOpen_Iio.prod hV0o
  have hVsub : Set.Iio s1 ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) ⊆
