            (deriv (fun Y => Fn Y e) (4 / Λ * Real.exp z) / Fn (4 / Λ * Real.exp z) e)) := by
        unfold axRefF; rw [if_neg (not_or.mpr ⟨not_le.mpr hX0, not_le.mpr hyt⟩)]
