    have hn2' : n 2 ^ 2 ≤ 9 * M ^ 4 := nb (n 2) N1 q2 (by linarith)
    have hg2 : g ^ 2 ≤ 81 * M ^ 4 * ‖x‖ ^ 2 := by
      have h := three (n 0 * x 0) (n 1 * x 1) (n 2 * x 2)
      rw [← hg, mul_pow, mul_pow, mul_pow] at h
      have t0 : n 0 ^ 2 * x 0 ^ 2 ≤ 9 * M ^ 4 * ‖x‖ ^ 2 :=
        mul_le_mul hn0' (hxi 0) (sq_nonneg _) (by positivity)
      have t1 : n 1 ^ 2 * x 1 ^ 2 ≤ 9 * M ^ 4 * ‖x‖ ^ 2 :=
        mul_le_mul hn1' (hxi 1) (sq_nonneg _) (by positivity)
      have t2 : n 2 ^ 2 * x 2 ^ 2 ≤ 9 * M ^ 4 * ‖x‖ ^ 2 :=
        mul_le_mul hn2' (hxi 2) (sq_nonneg _) (by positivity)
      linarith
    have k : M ^ 3 * ‖x‖ ^ 2 ≤ M ^ 4 * ‖x‖ ^ 2 := mul_le_mul_of_nonneg_right hM34 hR0
    have k0 : 0 ≤ M ^ 4 * ‖x‖ ^ 2 := mul_nonneg (by positivity) hR0
    have e1 : M * (27 * M ^ 2 * ‖x‖ ^ 2) = 27 * (M ^ 3 * ‖x‖ ^ 2) := by ring
    have e2 : 2 * M * (5 * M ^ 2) * (4 * ‖x‖ ^ 2) = 40 * (M ^ 3 * ‖x‖ ^ 2) := by ring
    have e3 : 81 * M ^ 4 * ‖x‖ ^ 2 = 81 * (M ^ 4 * ‖x‖ ^ 2) := by ring
    have e4 : 150 * M ^ 4 * ‖x‖ ^ 2 = 150 * (M ^ 4 * ‖x‖ ^ 2) := by ring
    rw [hQ]
    linarith

theorem pa5_deriv_ineq : ∀ M : ℝ, 1 ≤ M → ∃ C : ℝ, 0 < C ∧ ∀ (F0 G0 N1 N2 Bs E lam δ σ s : ℝ) (n p x : Fin 3 → ℝ) (K : Matrix (Fin 3) (Fin 3) ℝ), 1 / M ≤ F0 → F0 ≤ M → 0 ≤ G0 → G0 ≤ M → N1 ^ 2 + N2 ^ 2 = 1 → N1 ≤ -1 / M → 1 / M ^ 2 ≤ -(2 * F0 * N1) * (2 * F0 * N1 + G0) → lam = Real.sqrt (-(2 * F0 * N1) * (2 * F0 * N1 + G0)) → 1 / M ≤ Bs → Bs ≤ M → 0 ≤ E → E ≤ M → |σ| ≤ 2 * M → |s| ≤ δ → 0 < δ → δ ≤ 1 / (8 * M) → (∀ i : Fin 3, |n i - Bs * ![σ, -N2, N1] i| ≤ δ) → (∀ i : Fin 3, |p i| ≤ M) → (∀ i j : Fin 3, |K i j - !![0, -2 * F0, 0; 2 * F0 + G0 * N1, 0, 0; G0 * N2, 0, 0] i j| ≤ δ) → ∀ y : Fin 3 → ℝ, y = (-K + (dotProduct n n)⁻¹ • Matrix.vecMulVec n (Matrix.vecMul n K - p)).mulVec x - (E * dotProduct n n) • x → 2 * (2 * F0 * N1 + G0) * (x 0 + σ * N2 * x 1 - σ * N1 * x 2) * ((y 0 + σ * N2 * y 1 - σ * N1 * y 2) + s * (N2 * x 1 - N1 * x 2)) + (-(2 * F0 * N1)) * (2 * σ * s) * (N1 * x 1 + N2 * x 2) ^ 2 + 2 * (-(2 * F0 * N1)) * (1 + σ ^ 2) * (N1 * x 1 + N2 * x 2) * (N1 * y 1 + N2 * y 2) ≤ 2 * (lam / Real.sqrt (1 + σ ^ 2) - E * Bs ^ 2 * (1 + σ ^ 2)) * ((2 * F0 * N1 + G0) * (x 0 + σ * N2 * x 1 - σ * N1 * x 2) ^ 2 + (-(2 * F0 * N1)) * (1 + σ ^ 2) * (N1 * x 1 + N2 * x 2) ^ 2) + C * (δ * ((2 * F0 * N1 + G0) * (x 0 + σ * N2 * x 1 - σ * N1 * x 2) ^ 2 + (-(2 * F0 * N1)) * (1 + σ ^ 2) * (N1 * x 1 + N2 * x 2) ^ 2) + δ * dotProduct x x + (dotProduct n x) ^ 2 / δ) :=
by
  intro M hM
  have hM0 : 0 < M := by linarith
  refine ⟨30000 * M ^ 8, by positivity, ?_⟩
  intro F0 G0 N1 N2 Bs E lam δ σ s n p x K hF0a hF0b hG0a hG0b hN hN1 hPS hlam hBsa hBsb hE0 hE1
    hσ hs hδ0 hδ1 hn hp hK y hy

  have abs3 : ∀ A B C : ℝ, |A + B + C| ≤ |A| + |B| + |C| := fun A B C => by
    have := abs_add_le (A + B) C; have := abs_add_le A B; linarith
  have hab : ∀ u v B : ℝ, |u| ≤ B → |u * v| ≤ B * |v| := fun u v B h => by
    rw [abs_mul]; exact mul_le_mul_of_nonneg_right h (abs_nonneg v)
  have hab2 : ∀ u v B C : ℝ, |u| ≤ B → |v| ≤ C → 0 ≤ B → |u * v| ≤ B * C :=
    fun u v B C h1 h2 hB => by rw [abs_mul]; exact mul_le_mul h1 h2 (abs_nonneg v) hB

  have hF0pos : 0 < F0 := lt_of_lt_of_le (by positivity) hF0a
  have hN1neg : N1 < 0 := by
    have h1 : 0 < 1 / M := by positivity
    have e : -1 / M = -(1 / M) := by ring
    linarith
  have hN1sq : N1 ^ 2 ≤ 1 := by linarith [sq_nonneg N2]
  have hN2sq : N2 ^ 2 ≤ 1 := by linarith [sq_nonneg N1]
  have hN1abs : |N1| ≤ 1 := (sq_le_one_iff_abs_le_one N1).mp hN1sq
  have hN2abs : |N2| ≤ 1 := (sq_le_one_iff_abs_le_one N2).mp hN2sq
  have hN1lo : -1 ≤ N1 := (abs_le.mp hN1abs).1
  have hδM : δ * M ≤ 1 / 8 := by
    rw [le_div_iff₀ (by positivity)] at hδ1; linarith
  have hδle : δ ≤ 1 := by
    have := mul_le_mul_of_nonneg_left hM hδ0.le
    linarith
  have hBs0 : 0 < Bs := lt_of_lt_of_le (by positivity) hBsa
  have hBsM : 1 ≤ Bs * M := by rw [div_le_iff₀ hM0] at hBsa; linarith
  have h12 : 1 ≤ M ^ 2 := one_le_pow₀ hM
  have h15 : 1 ≤ M ^ 5 := one_le_pow₀ hM
  have h16 : 1 ≤ M ^ 6 := one_le_pow₀ hM
  have hM2 : M ≤ M ^ 2 := le_self_pow₀ hM (by norm_num)
  have hM3 : M ≤ M ^ 3 := le_self_pow₀ hM (by norm_num)
  have hM6 : M ≤ M ^ 6 := le_self_pow₀ hM (by norm_num)
  have h28 : M ^ 2 ≤ M ^ 8 := pow_le_pow_right₀ hM (by norm_num)
  have h38 : M ^ 3 ≤ M ^ 8 := pow_le_pow_right₀ hM (by norm_num)
  have hM8 : 0 ≤ M ^ 8 := by positivity
  have hσN2 : |σ * N2| ≤ 2 * M * 1 := hab2 σ N2 _ _ hσ hN2abs (by linarith)
  have hσN1 : |σ * N1| ≤ 2 * M * 1 := hab2 σ N1 _ _ hσ hN1abs (by linarith)

  obtain ⟨P, hPd⟩ : ∃ P, P = -(2 * F0 * N1) := ⟨_, rfl⟩
  obtain ⟨S, hSd⟩ : ∃ S, S = 2 * F0 * N1 + G0 := ⟨_, rfl⟩
  rw [← hSd, ← hPd] at hPS hlam ⊢
  have hP0 : 0 < P := by
    have := mul_pos hF0pos (neg_pos.mpr hN1neg)
    rw [hPd]; linarith
  have hP2 : P ≤ 2 * M := by
    have := mul_le_mul hF0b (show -N1 ≤ 1 by linarith) (by linarith) hM0.le
    rw [hPd]; linarith
  have hS0 : 0 < S := by
    by_contra hcon
    have hcon' : S ≤ 0 := not_lt.mp hcon
    have h1 := mul_nonpos_of_nonneg_of_nonpos hP0.le hcon'
    have h2 : 0 < 1 / M ^ 2 := by positivity
    linarith
  have hSM : S ≤ M := by
    have := hP0
    rw [hPd] at this
    rw [hSd]; linarith

  have h0 : |n 0 - Bs * σ| ≤ δ := by simpa using hn 0
  have h1 : |n 1 + Bs * N2| ≤ δ := by simpa using hn 1
  have h2 : |n 2 - Bs * N1| ≤ δ := by simpa using hn 2
  obtain ⟨a0, b0⟩ := abs_le.mp h0
  obtain ⟨a1, b1⟩ := abs_le.mp h1
  obtain ⟨a2, b2⟩ := abs_le.mp h2
  have hν : dotProduct n n = n 0 * n 0 + n 1 * n 1 + n 2 * n 2 := by
    simp [dotProduct, Fin.sum_univ_three]
  have q1 : (Bs * N2) ^ 2 / 2 - (n 1 + Bs * N2) ^ 2 ≤ n 1 * n 1 := by
    linarith [sq_nonneg (2 * n 1 + Bs * N2)]
  have q2 : (Bs * N1) ^ 2 / 2 - (n 2 - Bs * N1) ^ 2 ≤ n 2 * n 2 := by
    linarith [sq_nonneg (2 * n 2 - Bs * N1)]
  have hBN : (Bs * N2) ^ 2 + (Bs * N1) ^ 2 = Bs ^ 2 := by linear_combination Bs ^ 2 * hN
  have s1 : (n 1 + Bs * N2) ^ 2 ≤ δ ^ 2 := sq_le_sq' a1 b1
  have s2 : (n 2 - Bs * N1) ^ 2 ≤ δ ^ 2 := sq_le_sq' a2 b2
  have hSlow : Bs ^ 2 / 2 - 2 * δ ^ 2 ≤ dotProduct n n := by
    rw [hν]; linarith [mul_self_nonneg (n 0)]
  have hc1 : 1 / (4 * M ^ 2) ≤ dotProduct n n := by
    rw [div_le_iff₀ (by positivity)]
    have k1 := mul_le_mul hBsM hBsM zero_le_one (by linarith)
    have k2 := mul_le_mul hδM hδM (by positivity) (by norm_num)
    have k3 := mul_le_mul_of_nonneg_right hSlow (by positivity : (0:ℝ) ≤ 4 * M ^ 2)
    linarith
  have hdev : Bs ^ 2 * (1 + σ ^ 2) - dotProduct n n ≤ 8 * M ^ 2 * δ := by
    have hidν : dotProduct n n = Bs ^ 2 * (1 + σ ^ 2)
        + 2 * Bs * (σ * (n 0 - Bs * σ) - N2 * (n 1 + Bs * N2) + N1 * (n 2 - Bs * N1))
        + ((n 0 - Bs * σ) ^ 2 + (n 1 + Bs * N2) ^ 2 + (n 2 - Bs * N1) ^ 2) := by
      rw [hν]; linear_combination Bs ^ 2 * hN
    have e0 : |σ * (n 0 - Bs * σ)| ≤ 2 * M * δ := by
      rw [abs_mul]; exact mul_le_mul hσ h0 (abs_nonneg _) (by linarith)
    have e1 : |N2 * (n 1 + Bs * N2)| ≤ 1 * δ := by
      rw [abs_mul]; exact mul_le_mul hN2abs h1 (abs_nonneg _) zero_le_one
    have e2 : |N1 * (n 2 - Bs * N1)| ≤ 1 * δ := by
      rw [abs_mul]; exact mul_le_mul hN1abs h2 (abs_nonneg _) zero_le_one
    have f0 := neg_abs_le (σ * (n 0 - Bs * σ))
    have f1 := le_abs_self (N2 * (n 1 + Bs * N2))
    have f2 := neg_abs_le (N1 * (n 2 - Bs * N1))
    have hMδ : 1 * δ ≤ M * δ := mul_le_mul_of_nonneg_right hM hδ0.le
    have hμ : 0 ≤ (σ * (n 0 - Bs * σ) - N2 * (n 1 + Bs * N2) + N1 * (n 2 - Bs * N1))
        + 4 * M * δ := by linarith
    have g1 := mul_nonneg hBs0.le hμ
    have g2 : Bs * (8 * M * δ) ≤ M * (8 * M * δ) :=
      mul_le_mul_of_nonneg_right hBsb (by positivity)
    have g3 := sq_nonneg (n 0 - Bs * σ)
    have g4 := sq_nonneg (n 1 + Bs * N2)
    have g5 := sq_nonneg (n 2 - Bs * N1)
    rw [hidν]; linarith
  have hνpos : 0 < dotProduct n n := lt_of_lt_of_le (by positivity) hc1
  have hw0 : 0 ≤ (dotProduct n n)⁻¹ := inv_nonneg.mpr hνpos.le
  have hw4 : (dotProduct n n)⁻¹ ≤ 4 * M ^ 2 := by
    have := inv_anti₀ (by positivity) hc1
    rwa [one_div, inv_inv] at this

  have hy0 : y 0 = -(K 0 0 * x 0 + K 0 1 * x 1 + K 0 2 * x 2)
      + (dotProduct n n)⁻¹ * n 0 * dotProduct (Matrix.vecMul n K - p) x - E * dotProduct n n * x 0 := by
    rw [hy]
    simp only [dotProduct, Fin.sum_univ_three, Matrix.mulVec, Matrix.vecMul, Matrix.vecMulVec_apply,
      Matrix.add_apply, Matrix.neg_apply, Matrix.smul_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
    ring
  have hy1 : y 1 = -(K 1 0 * x 0 + K 1 1 * x 1 + K 1 2 * x 2)
      + (dotProduct n n)⁻¹ * n 1 * dotProduct (Matrix.vecMul n K - p) x - E * dotProduct n n * x 1 := by
    rw [hy]
    simp only [dotProduct, Fin.sum_univ_three, Matrix.mulVec, Matrix.vecMul, Matrix.vecMulVec_apply,
      Matrix.add_apply, Matrix.neg_apply, Matrix.smul_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
    ring
  have hy2 : y 2 = -(K 2 0 * x 0 + K 2 1 * x 1 + K 2 2 * x 2)
      + (dotProduct n n)⁻¹ * n 2 * dotProduct (Matrix.vecMul n K - p) x - E * dotProduct n n * x 2 := by
    rw [hy]
    simp only [dotProduct, Fin.sum_univ_three, Matrix.mulVec, Matrix.vecMul, Matrix.vecMulVec_apply,
      Matrix.add_apply, Matrix.neg_apply, Matrix.smul_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
    ring
  have hox : dotProduct (Matrix.vecMul n K - p) x =
      (n 0 * K 0 0 + n 1 * K 1 0 + n 2 * K 2 0 - p 0) * x 0
      + (n 0 * K 0 1 + n 1 * K 1 1 + n 2 * K 2 1 - p 1) * x 1
      + (n 0 * K 0 2 + n 1 * K 1 2 + n 2 * K 2 2 - p 2) * x 2 := by
    simp only [dotProduct, Fin.sum_univ_three, Matrix.vecMul, Pi.sub_apply]
    try ring
  generalize hO : dotProduct (Matrix.vecMul n K - p) x = ox at hy0 hy1 hy2 hox
  generalize hW : (dotProduct n n)⁻¹ = w at hy0 hy1 hy2 hw0 hw4
  generalize hV : dotProduct n n = ν at hy0 hy1 hy2 hdev

  obtain ⟨a, ha⟩ : ∃ a, a = x 0 + σ * N2 * x 1 - σ * N1 * x 2 := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b, b = N1 * x 1 + N2 * x 2 := ⟨_, rfl⟩
  obtain ⟨c, hc⟩ : ∃ c, c = σ * x 0 - N2 * x 1 + N1 * x 2 := ⟨_, rfl⟩
  rw [← ha, ← hb]
  obtain ⟨Q, hQ⟩ : ∃ Q, Q = S * a ^ 2 + P * (1 + σ ^ 2) * b ^ 2 := ⟨_, rfl⟩
  rw [← hQ]
  obtain ⟨t, ht⟩ : ∃ t, t = Real.sqrt (1 + σ ^ 2) := ⟨_, rfl⟩
  rw [← ht]
  obtain ⟨u, hu⟩ : ∃ u, u = lam / t := ⟨_, rfl⟩
  rw [← hu]
  have hgx : dotProduct n x = n 0 * x 0 + n 1 * x 1 + n 2 * x 2 := by
    simp [dotProduct, Fin.sum_univ_three]
  have hXx : dotProduct x x = x 0 * x 0 + x 1 * x 1 + x 2 * x 2 := by
    simp [dotProduct, Fin.sum_univ_three]
  obtain ⟨g, hg⟩ : ∃ g, g = dotProduct n x := ⟨_, rfl⟩
  rw [← hg]
  rw [← hg] at hgx
  obtain ⟨X, hX⟩ : ∃ X, X = dotProduct x x := ⟨_, rfl⟩
  rw [← hX]
  rw [← hX] at hXx
  obtain ⟨Z, hZ⟩ : ∃ Z, Z = g ^ 2 / δ := ⟨_, rfl⟩
  rw [← hZ]
  obtain ⟨α, hαd⟩ : ∃ α, α = 4 * S * F0 * N2 * a + 2 * P * S * σ * b := ⟨_, rfl⟩
  obtain ⟨D0, hD0d⟩ : ∃ D0, D0 = K 0 0 * x 0 + (K 0 1 + 2 * F0) * x 1 + K 0 2 * x 2 := ⟨_, rfl⟩
  obtain ⟨D1, hD1d⟩ : ∃ D1, D1 = (K 1 0 - (2 * F0 + G0 * N1)) * x 0 + K 1 1 * x 1 + K 1 2 * x 2 :=
    ⟨_, rfl⟩
  obtain ⟨D2, hD2d⟩ : ∃ D2, D2 = (K 2 0 - G0 * N2) * x 0 + K 2 1 * x 1 + K 2 2 * x 2 := ⟨_, rfl⟩
  obtain ⟨T1, hT1d⟩ : ∃ T1, T1 = -(D0 + σ * N2 * D1 - σ * N1 * D2)
