  have hStage : ∀ z : ℝ, 0 ≤ z → z ≤ t1 →
      -(1 / 2) * axShearA h Λ t1 κ0 om Fn Un z e = axKap κ0 t1 z *
        (4 / Λ * Real.exp z * (deriv (fun Y => Fn Y e) (4 / Λ * Real.exp z) / Fn (4 / Λ * Real.exp z) e)) ∧
