theorem prefactor_composition_flat_v5 : ∀ (B : BG) (qs : ℝ) (Φ : ℝ × ℝ × (ℝ × ℝ) → ℝ), B.ok → 0 < qs → qs ≤ 1 → ContDiffOn ℝ ∞ Φ {ζ | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} → (∀ k N : ℕ, ∃ C : ℝ, ∀ ζ : ℝ × ℝ × (ℝ × ℝ), ζ.2.1 < 1 → simScale B.h ζ.1 (1 - ζ.2.1) < qs → ‖iteratedFDeriv ℝ k Φ ζ‖ ≤ C * simScale B.h ζ.1 (1 - ζ.2.1) ^ (N : ℝ)) → ∀ m N : ℕ, ∃ C : ℝ, ∀ (Y₀ : ℝ × ℝ) (x : ℝ³) (t : ℝ), (x, t) ∈ simDomain B.h qs → 0 < rad x → ‖iteratedFDeriv ℝ m (↿(fun (y : ℝ³) (s : ℝ) => -(deriv (chiM B) (rad y ^ 2 / (2 * simScale B.h (y 2) (1 - s))) * (rad y / simScale B.h (y 2) (1 - s))) * Φ (y 2, s, s • vtv + Y₀))) (x, t)‖ ≤ C * simScale B.h (x 2) (1 - t) ^ (N : ℝ) :=
