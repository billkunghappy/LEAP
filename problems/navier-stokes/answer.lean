        hexpand Vn y hy.1 (fun γ m h => hoffN Vn hVnH hVnSupp _ (interior_subset hy.2) hy.1 γ m h)]
    have hUsl : (fun y => uX5 B G l0 S y t (Yph B.h (rad y) t + Y') - pwrUB B y t (Yph B.h (rad y) t + Y'))
        =ᶠ[nhds x] (fun y => modeF5 B.h 0 t Y' 0 (cr5Mc B G l0 S) y +
          ∑ γ ∈ Γ, ∑ m ∈ H, modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vo γ m) y) := by
      filter_upwards [hOopen.mem_nhds hxO] with y hy
      rw [(h6 y t _ hy.1).1,
        hexpand Vo y hy.1 (fun γ m h => hoffN Vo hVoH hVoSupp _ (interior_subset hy.2) hy.1 γ m h), hMm y]

    have hDW : fderiv ℝ (fun y => sw5W B G l0 D y t (Yph B.h (rad y) t + Y')) x =
        ∑ γ ∈ Γ, ∑ m ∈ H, fderiv ℝ (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vn γ m)) x := by
      rw [hWsl.fderiv_eq, fderiv_fun_sum (fun γ _ => DifferentiableAt.fun_sum (fun m _ => hFn γ m))]
      refine Finset.sum_congr rfl (fun γ _ => ?_)
      exact fderiv_fun_sum (fun m _ => hFn γ m)
    have hDU : fderiv ℝ (fun y => uX5 B G l0 S y t (Yph B.h (rad y) t + Y') -
          pwrUB B y t (Yph B.h (rad y) t + Y')) x =
        fderiv ℝ (modeF5 B.h 0 t Y' 0 (cr5Mc B G l0 S)) x +
          ∑ γ ∈ Γ, ∑ m ∈ H, fderiv ℝ (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vo γ m)) x := by
      rw [hUsl.fderiv_eq, fderiv_fun_add hMd
        (DifferentiableAt.fun_sum (fun γ _ => DifferentiableAt.fun_sum (fun m _ => hFo γ m))),
        fderiv_fun_sum (fun γ _ => DifferentiableAt.fun_sum (fun m _ => hFo γ m))]
      congr 1
      refine Finset.sum_congr rfl (fun γ _ => ?_)
      exact fderiv_fun_sum (fun m _ => hFo γ m)

    have hu0 : uX5 B G l0 S x t (Yph B.h (rad x) t + Y') - pwrUB B x t (Yph B.h (rad x) t + Y') =
        modeF5 B.h 0 t Y' 0 (cr5Mc B G l0 S) x +
          ∑ γ ∈ Γ, ∑ m ∈ H, modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vo γ m) x :=
      hUsl.eq_of_nhds
    have hw0 : sw5W B G l0 D x t (Yph B.h (rad x) t + Y') =
        ∑ γ ∈ Γ, ∑ m ∈ H, modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vn γ m) x :=
      hWsl.eq_of_nhds

    have hoff1 : ∀ γ' γ (m' m : ℤ), γ ≠ γ' →
        fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ') (modeCoef5 B G Vn γ' m')) x
          (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vo γ m) x) = 0 := by
      intro γ' γ m' m hne
      by_cases hV : Vo γ m (ptOf x t Y) = 0
      · have h0 : ∀ i, modeCoef5 B G Vo γ m (ptOf x t Y) i = 0 := fun i => by simp [modeCoef5, hV]
        rw [hFx]
        simp [cyl2cart, h0]
      · have hts := (h4 γ γ' m m' hne _ hξD).1 hV
        have hev : modeCoef5 B G Vn γ' m' =ᶠ[nhds (ptOf x t (Yph B.h (rad x) t + Y'))] 0 := by
          rw [hζx]
          exact hCev Vn γ' m' _ (notMem_tsupport_iff_eventuallyEq.mp hts)
        rw [pq5_offdiag B.h t Y' _ _ x hxt'.1 hev]
        simp
    have hoff2 : ∀ γ' γ (m' m : ℤ), γ ≠ γ' →
        fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ') (modeCoef5 B G Vo γ' m')) x
          (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vn γ m) x) = 0 := by
      intro γ' γ m' m hne
      by_cases hV : Vn γ m (ptOf x t Y) = 0
      · have h0 : ∀ i, modeCoef5 B G Vn γ m (ptOf x t Y) i = 0 := fun i => by simp [modeCoef5, hV]
        rw [hFx]
        simp [cyl2cart, h0]
      · have hts := (h4 γ γ' m m' hne _ hξD).2 hV
        have hev : modeCoef5 B G Vo γ' m' =ᶠ[nhds (ptOf x t (Yph B.h (rad x) t + Y'))] 0 := by
          rw [hζx]
          exact hCev Vo γ' m' _ (notMem_tsupport_iff_eventuallyEq.mp hts)
        rw [pq5_offdiag B.h t Y' _ _ x hxt'.1 hev]
        simp

    have hlin : ∀ (a b d : Fin 3 → ℝ) (s1 s2 s3 : ℝ),
        s1 • cyl2cart x a + s2 • cyl2cart x b + s3 • cyl2cart x d =
          cyl2cart x (fun i => s1 * a i + s2 * b i + s3 * d i) := by
      intro a b d s1 s2 s3
      simp only [cyl2cart, add_smul, smul_add, smul_smul]
      abel
    have hjet : ∀ (n' : ℤ) (c : Cyl → (Fin 3 → ℂ)) (v : Fin 3 → ℝ),
        DifferentiableAt ℝ c (ptOf x t (Yph B.h (rad x) t + Y')) →
        fderiv ℝ (modeF5 B.h 0 t Y' n' c) x (cyl2cart x v) =
          cyl2cart x (fun i => (pq5TrM B.h n' (fun a => ((v a : ℝ) : ℂ)) c (ptOf x t Y) i *
            Complex.exp (Complex.I * (n' : ℂ) * (thetaOf x : ℂ))).re) := by
      intro n' c v hc
      have hR := pq5_jet_R B.h t Y' n' c x hok.1 hxt'.2.1 hxt'.1 hc
      have hZ := pq5_jet_Z B.h t Y' n' c x hok.1 hxt'.2.1 hxt'.1 hc
      have hT := pq5_jet_Th B.h t Y' n' c x hok.1 hxt'.2.1 hxt'.1 hc
      rw [hζx] at hR hZ hT
      have e1 : cyl2cart x v = v 0 • eR x + v 1 • eTh x + v 2 • eZ := rfl
      rw [e1, map_add, map_add, map_smul, map_smul, map_smul, hR, hZ, hT, hlin]
      congr 1
      funext i
      rw [← Complex.re_ofReal_mul, ← Complex.re_ofReal_mul, ← Complex.re_ofReal_mul,
        ← Complex.add_re, ← Complex.add_re]
      congr 1
      fin_cases i <;> simp [pq5TrM, ptOf] <;> ring
    have hpair : ∀ (n n' : ℤ) (c c' : Cyl → (Fin 3 → ℂ)),
        DifferentiableAt ℝ c' (ptOf x t (Yph B.h (rad x) t + Y')) →
        fderiv ℝ (modeF5 B.h 0 t Y' n' c') x (modeF5 B.h 0 t Y' n c x) =
          cyl2cart x (fun i => ((1/2 : ℂ) * (pq5TrM B.h n' (c (ptOf x t Y)) c' (ptOf x t Y) i *
            Complex.exp (Complex.I * ((n + n' : ℤ) : ℂ) * (thetaOf x : ℂ)) +
            pq5TrM B.h n' (fun a => starRingEnd ℂ (c (ptOf x t Y) a)) c' (ptOf x t Y) i *
            Complex.exp (Complex.I * ((n' - n : ℤ) : ℂ) * (thetaOf x : ℂ)))).re) := by
      intro n n' c c' hc'
      rw [hFx n c, hjet n' c' _ hc']
      congr 1
      funext i
      exact pq5_trm_split B.h n n' (c (ptOf x t Y)) c' (ptOf x t Y) (thetaOf x) i

    obtain ⟨X1, hX1⟩ : ∃ X1 : Lab → ℤ → ℤ → Fin 3 → ℝ, ∀ γ m m' i, X1 γ m m' i =
        ((1/2 : ℂ) * (pq5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G Vo γ m (ptOf x t Y)) (modeCoef5 B G Vn γ m') (ptOf x t Y) i * Complex.exp (Complex.I * ((m * pint5 B G γ + m' * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ)) + pq5TrM B.h (m' * pint5 B G γ) (fun a => starRingEnd ℂ (modeCoef5 B G Vo γ m (ptOf x t Y) a)) (modeCoef5 B G Vn γ m') (ptOf x t Y) i * Complex.exp (Complex.I * ((m' * pint5 B G γ - m * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ)))).re :=
      ⟨_, fun _ _ _ _ => rfl⟩
    obtain ⟨X2, hX2⟩ : ∃ X2 : Lab → ℤ → ℤ → Fin 3 → ℝ, ∀ γ m m' i, X2 γ m m' i =
        ((1/2 : ℂ) * (pq5TrM B.h (m' * pint5 B G γ) (modeCoef5 B G Vn γ m (ptOf x t Y)) (modeCoef5 B G Vo γ m') (ptOf x t Y) i * Complex.exp (Complex.I * ((m * pint5 B G γ + m' * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ)) + pq5TrM B.h (m' * pint5 B G γ) (fun a => starRingEnd ℂ (modeCoef5 B G Vn γ m (ptOf x t Y) a)) (modeCoef5 B G Vo γ m') (ptOf x t Y) i * Complex.exp (Complex.I * ((m' * pint5 B G γ - m * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ)))).re :=
      ⟨_, fun _ _ _ _ => rfl⟩
    obtain ⟨X3, hX3⟩ : ∃ X3 : Lab → ℤ → Fin 3 → ℝ, ∀ γ m i, X3 γ m i =
        (pq5TrM B.h (m * pint5 B G γ) (cr5Mc B G l0 S (ptOf x t Y)) (modeCoef5 B G Vn γ m) (ptOf x t Y) i * Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ))).re :=
      ⟨_, fun _ _ _ => rfl⟩
    obtain ⟨X4, hX4⟩ : ∃ X4 : Lab → ℤ → Fin 3 → ℝ, ∀ γ m i, X4 γ m i =
        (pq5TrM B.h 0 (modeCoef5 B G Vn γ m (ptOf x t Y)) (cr5Mc B G l0 S) (ptOf x t Y) i * Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ))).re :=
      ⟨_, fun _ _ _ => rfl⟩
    have hd1 : ∀ γ (m m' : ℤ),
        fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ) (modeCoef5 B G Vn γ m')) x
          (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vo γ m) x) = cyl2cart x (X1 γ m m') := by
      intro γ m m'
      rw [hpair _ _ _ _ (hCnx γ m')]
      congr 1
      funext i
      rw [hX1]
    have hd2 : ∀ γ (m m' : ℤ),
        fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ) (modeCoef5 B G Vo γ m')) x
          (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vn γ m) x) = cyl2cart x (X2 γ m m') := by
      intro γ m m'
      rw [hpair _ _ _ _ (hCox γ m')]
      congr 1
      funext i
      rw [hX2]
    have hd3 : ∀ γ (m : ℤ),
        fderiv ℝ (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vn γ m)) x
          (modeF5 B.h 0 t Y' 0 (cr5Mc B G l0 S) x) = cyl2cart x (X3 γ m) := by
      intro γ m
      rw [hpair _ _ _ _ (hCnx γ m)]
      congr 1
      funext i
      rw [hX3, hMcconj, zero_add, sub_zero]
      congr 1
      ring
    have hconjTr : ∀ (U : Fin 3 → ℂ) (i : Fin 3),
        pq5TrM B.h 0 (fun a => starRingEnd ℂ (U a)) (cr5Mc B G l0 S) (ptOf x t Y) i =
          starRingEnd ℂ (pq5TrM B.h 0 U (cr5Mc B G l0 S) (ptOf x t Y) i) := by
      intro U i
      fin_cases i <;> simp [pq5TrM, hMcR, hMcZ, hMcv]
    have hexpc : ∀ k : ℤ, Complex.exp (Complex.I * ((0 - k : ℤ) : ℂ) * (thetaOf x : ℂ)) =
        starRingEnd ℂ (Complex.exp (Complex.I * (k : ℂ) * (thetaOf x : ℂ))) := by
      intro k
      rw [← Complex.exp_conj]
      congr 1
      simp only [map_mul, Complex.conj_I, map_intCast, Complex.conj_ofReal]
      push_cast
      ring
    have hd4 : ∀ γ (m : ℤ),
        fderiv ℝ (modeF5 B.h 0 t Y' 0 (cr5Mc B G l0 S)) x
          (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vn γ m) x) = cyl2cart x (X4 γ m) := by
      intro γ m
      rw [hpair _ _ _ _ hMcx]
      congr 1
      funext i
      rw [hX4, add_zero, hconjTr, hexpc (m * pint5 B G γ), ← map_mul,
        show (1/2 : ℂ) = ((1/2 : ℝ) : ℂ) by push_cast; ring, Complex.re_ofReal_mul, Complex.add_re,
        Complex.conj_re]
      ring

    have hRHS : (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) •
        cyl2cart x (waveV5 B G (cr5Q B G l0 S H Vo Vn) (thetaOf x) (ptOf x t Y)) =
          cyl2cart x (fun i => ∑ γ ∈ Γ, ∑ m ∈ H, ∑ m' ∈ H, X1 γ m m' i +
            ∑ γ ∈ Γ, ∑ m ∈ H, ∑ m' ∈ H, X2 γ m m' i + ∑ γ ∈ Γ, ∑ m ∈ H, X3 γ m i +
            ∑ γ ∈ Γ, ∑ m ∈ H, X4 γ m i) := by
      have hsm : ∀ (c : ℝ) (u : Fin 3 → ℝ), c • cyl2cart x u = cyl2cart x (c • u) := by
        intro c u
        simp only [cyl2cart, Pi.smul_apply, smul_eq_mul, smul_add, smul_smul]
      rw [hsm, hregroup (ptOf x t Y) (thetaOf x) Γ hq hΓQ]
      simp only [hX1, hX2, hX3, hX4]
    obtain ⟨Lc, hLc⟩ : ∃ Lc : (Fin 3 → ℝ) →+ ℝ³, ∀ u, Lc u = cyl2cart x u :=
      ⟨{ toFun := cyl2cart x
         map_zero' := by simp [cyl2cart]
         map_add' := fun u v => by simp only [cyl2cart, Pi.add_apply, add_smul]; abel },
        fun u => rfl⟩

    have hLHS : (∑ γ ∈ Γ, ∑ m ∈ H, fderiv ℝ (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vn γ m)) x)
          (modeF5 B.h 0 t Y' 0 (cr5Mc B G l0 S) x +
            ∑ γ ∈ Γ, ∑ m ∈ H, modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vo γ m) x) +
        (fderiv ℝ (modeF5 B.h 0 t Y' 0 (cr5Mc B G l0 S)) x +
          ∑ γ ∈ Γ, ∑ m ∈ H, fderiv ℝ (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vo γ m)) x)
          (∑ γ ∈ Γ, ∑ m ∈ H, modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vn γ m) x) =
        (∑ γ' ∈ Γ, ∑ m' ∈ H, fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ') (modeCoef5 B G Vn γ' m')) x
            (modeF5 B.h 0 t Y' 0 (cr5Mc B G l0 S) x) +
          ∑ γ ∈ Γ, ∑ m ∈ H, ∑ γ' ∈ Γ, ∑ m' ∈ H,
            fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ') (modeCoef5 B G Vn γ' m')) x
              (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vo γ m) x)) +
        (∑ γ ∈ Γ, ∑ m ∈ H, fderiv ℝ (modeF5 B.h 0 t Y' 0 (cr5Mc B G l0 S)) x
            (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vn γ m) x) +
          ∑ γ ∈ Γ, ∑ m ∈ H, ∑ γ' ∈ Γ, ∑ m' ∈ H,
            fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ') (modeCoef5 B G Vo γ' m')) x
              (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vn γ m) x)) := by
      simp only [map_add, map_sum, ContinuousLinearMap.add_apply, sum_apply, Finset.sum_add_distrib]
      try abel
    have hT1b : ∑ γ ∈ Γ, ∑ m ∈ H, ∑ γ' ∈ Γ, ∑ m' ∈ H,
        fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ') (modeCoef5 B G Vn γ' m')) x
          (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vo γ m) x) =
        ∑ γ ∈ Γ, ∑ m ∈ H, ∑ m' ∈ H, cyl2cart x (X1 γ m m') := by
      refine Finset.sum_congr rfl (fun γ hγ => Finset.sum_congr rfl (fun m _ => ?_))
      rw [Finset.sum_eq_single_of_mem γ hγ
        (fun γ' _ hne => Finset.sum_eq_zero (fun m' _ => hoff1 γ' γ m' m (Ne.symm hne)))]
      exact Finset.sum_congr rfl (fun m' _ => hd1 γ m m')
    have hT2b : ∑ γ ∈ Γ, ∑ m ∈ H, ∑ γ' ∈ Γ, ∑ m' ∈ H,
        fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ') (modeCoef5 B G Vo γ' m')) x
          (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vn γ m) x) =
        ∑ γ ∈ Γ, ∑ m ∈ H, ∑ m' ∈ H, cyl2cart x (X2 γ m m') := by
      refine Finset.sum_congr rfl (fun γ hγ => Finset.sum_congr rfl (fun m _ => ?_))
      rw [Finset.sum_eq_single_of_mem γ hγ
        (fun γ' _ hne => Finset.sum_eq_zero (fun m' _ => hoff2 γ' γ m' m (Ne.symm hne)))]
      exact Finset.sum_congr rfl (fun m' _ => hd2 γ m m')
    have hT1a : ∑ γ' ∈ Γ, ∑ m' ∈ H, fderiv ℝ (modeF5 B.h 0 t Y' (m' * pint5 B G γ') (modeCoef5 B G Vn γ' m')) x
        (modeF5 B.h 0 t Y' 0 (cr5Mc B G l0 S) x) = ∑ γ ∈ Γ, ∑ m ∈ H, cyl2cart x (X3 γ m) :=
      Finset.sum_congr rfl (fun γ _ => Finset.sum_congr rfl (fun m _ => hd3 γ m))
    have hT2a : ∑ γ ∈ Γ, ∑ m ∈ H, fderiv ℝ (modeF5 B.h 0 t Y' 0 (cr5Mc B G l0 S)) x
        (modeF5 B.h 0 t Y' (m * pint5 B G γ) (modeCoef5 B G Vn γ m) x) =
        ∑ γ ∈ Γ, ∑ m ∈ H, cyl2cart x (X4 γ m) :=
      Finset.sum_congr rfl (fun γ _ => Finset.sum_congr rfl (fun m _ => hd4 γ m))
    rw [hQdef, hDW, hDU, hu0, hw0, hLHS, hT1a, hT1b, hT2a, hT2b, hRHS]
    simp only [← hLc, ← map_sum, ← map_add]
    congr 1
    funext i
    simp only [Pi.add_apply, Finset.sum_apply]
    ring

theorem cr5_osc_split : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (F : Ext ℝ³) (Q : WC) (e : ℝ) (HQ : Finset ℤ), B.ok → (∀ γ M, M ∉ HQ → Q γ M = 0) → (∀ ξ ∈ DomC B.h (qsOf l0), ∃ T : Finset Lab, ∀ γ M, γ ∉ T → Q γ M ξ = 0) → (∀ x t Y, corrOn B l0 x t → F x t Y = (qC B.h (ptOf x t Y) ^ (-e)) • cyl2cart x (waveV5 B G Q (thetaOf x) (ptOf x t Y))) → ∀ x t Y, corrOn B l0 x t → F x t Y - thAvgVec F x t Y = (qC B.h (ptOf x t Y) ^ (-e)) • cyl2cart x (waveV5 B G (cr5Osc Q) (thetaOf x) (ptOf x t Y)) :=
by
  intro B G l0 F Q e HQ _hok hH hT hF

  have hcirc : ∀ (a : WS) (ξ : Cyl) (r z : ℝ) (H : Finset ℤ)
      (T : Finset Lab), 0 < r → (0 : ℤ) ∉ H → (∀ γ m, m ∉ H → a γ m ξ = 0) → (∀ γ m, γ ∉ T → a γ m ξ = 0) →
      Continuous (fun θ : ℝ => waveS5 B G a (thetaOf (rotPt r θ z)) ξ) ∧
      thA (fun θ : ℝ => waveS5 B G a (thetaOf (rotPt r θ z)) ξ) = 0 := by
    intro a ξ r z H T hr hH0 hH hT
    have hpint : ∀ γ : Lab, pint5 B G γ ≠ 0 := by
      intro γ
      unfold pint5
      split_ifs with h
      · exact one_ne_zero
      · exact h
    have hphase : ∀ (γ : Lab) (m : ℤ) (θ : ℝ), ephase5 B G γ m (thetaOf (rotPt r θ z)) ξ =
        Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
          Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) := by
      intro γ m θ
      have e0 : rotPt r θ z 0 = r * Real.cos θ := by simp [rotPt]
      have e1 : rotPt r θ z 1 = r * Real.sin θ := by simp [rotPt]
      have hc : (⟨rotPt r θ z 0, rotPt r θ z 1⟩ : ℂ) =
          (r : ℂ) * (Complex.cos (θ : ℂ) + Complex.sin (θ : ℂ) * Complex.I) := by
        rw [e0, e1]
        apply Complex.ext <;> simp [Complex.cos_ofReal_re, Complex.sin_ofReal_re]
      have hth : thetaOf (rotPt r θ z) = toIocMod Real.two_pi_pos (-Real.pi) θ := by
        unfold thetaOf
        rw [hc]
        exact Complex.arg_mul_cos_add_sin_mul_I_eq_toIocMod hr θ
      have hn := self_sub_toIocMod Real.two_pi_pos (-Real.pi) θ
      have hmod : toIocMod Real.two_pi_pos (-Real.pi) θ =
          θ - ((toIocDiv Real.two_pi_pos (-Real.pi) θ : ℤ) : ℝ) * (2 * Real.pi) := by
        rw [zsmul_eq_mul] at hn
        linarith
      have hth' : ((thetaOf (rotPt r θ z) : ℝ) : ℂ) =
          (θ : ℂ) - ((toIocDiv Real.two_pi_pos (-Real.pi) θ : ℤ) : ℂ) * (2 * (Real.pi : ℂ)) := by
        rw [hth, hmod]
        push_cast
        ring
      have key : Complex.I * (m : ℂ) * ((pint5 B G γ : ℂ) *
            ((θ : ℂ) - ((toIocDiv Real.two_pi_pos (-Real.pi) θ : ℤ) : ℂ) * (2 * (Real.pi : ℂ))) +
            (kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)) =
          (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)) +
            Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) +
          ((-(m * pint5 B G γ * toIocDiv Real.two_pi_pos (-Real.pi) θ) : ℤ) : ℂ) *
            (2 * (Real.pi : ℂ) * Complex.I) := by
        push_cast
        ring
      unfold ephase5
      rw [hth', key, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one, Complex.exp_add]
    have hgen : ∀ (s : Finset (Lab × ℤ)) (c : Lab × ℤ → ℂ) (k : Lab × ℤ → ℤ), (∀ i ∈ s, k i ≠ 0) →
        Continuous (fun θ : ℝ => (∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))).re) ∧
        ∫ θ in (0:ℝ)..(2 * Real.pi),
          (∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))).re = 0 := by
      intro s c k hk
      have hcont : ∀ i, Continuous (fun θ : ℝ => c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))) :=
        fun i => continuous_const.mul (Complex.continuous_exp.comp
          (continuous_const.mul Complex.continuous_ofReal))
      have hF : Continuous (fun θ : ℝ => ∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))) :=
        continuous_finsetSum _ (fun i _ => hcont i)
      refine ⟨Complex.continuous_re.comp hF, ?_⟩
      have h1 : ∫ θ in (0:ℝ)..(2 * Real.pi),
            (∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))).re =
          (∫ θ in (0:ℝ)..(2 * Real.pi),
            ∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))).re := by
        have := ContinuousLinearMap.intervalIntegral_comp_comm Complex.reCLM
          (hF.intervalIntegrable (μ := MeasureTheory.volume) 0 (2 * Real.pi))
        simpa only [Complex.reCLM_apply] using this
      rw [h1, intervalIntegral.integral_finsetSum (fun i _ => (hcont i).intervalIntegrable _ _)]
      rw [Finset.sum_eq_zero, Complex.zero_re]
      intro i hi
      rw [intervalIntegral.integral_const_mul]
      have hw : Complex.I * (k i : ℂ) ≠ 0 :=
        mul_ne_zero Complex.I_ne_zero (Int.cast_ne_zero.mpr (hk i hi))
      rw [integral_exp_mul_complex hw]
      have e2 : Complex.I * (k i : ℂ) * ((2 * Real.pi : ℝ) : ℂ) =
          (k i : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
        push_cast
        ring
      rw [e2, Complex.exp_int_mul_two_pi_mul_I]
      simp
    have hfin : ∀ θ' : ℝ, waveS5 B G a θ' ξ =
        (∑ p ∈ T ×ˢ H, a p.1 p.2 ξ * ephase5 B G p.1 p.2 θ' ξ).re := by
      intro θ'
      unfold waveS5
      congr 1
      have hin : ∀ γ : Lab, ∑ᶠ m : ℤ, a γ m ξ * ephase5 B G γ m θ' ξ =
          ∑ m ∈ H, a γ m ξ * ephase5 B G γ m θ' ξ := by
        intro γ
        apply finsum_eq_sum_of_support_subset
        intro m hm
        by_contra hmH
        exact (Function.mem_support.mp hm)
          (by rw [hH γ m (fun h => hmH (Finset.mem_coe.mpr h)), zero_mul])
      rw [finsum_congr hin, finsum_eq_sum_of_support_subset (s := T)]
      · exact (Finset.sum_product T H (fun p : Lab × ℤ => a p.1 p.2 ξ * ephase5 B G p.1 p.2 θ' ξ)).symm
      · intro γ hγ
        by_contra hγT
        apply Function.mem_support.mp hγ
        exact Finset.sum_eq_zero (fun m _ => by
          rw [hT γ m (fun h => hγT (Finset.mem_coe.mpr h)), zero_mul])
    have hfun : (fun θ : ℝ => waveS5 B G a (thetaOf (rotPt r θ z)) ξ) = fun θ : ℝ =>
        (∑ p ∈ T ×ˢ H, (a p.1 p.2 ξ * Complex.exp (Complex.I * (p.2 : ℂ) *
          ((kb B.h p.1.1 : ℂ) * (phiL5 B G p.1 ξ : ℂ)))) *
          Complex.exp (Complex.I * ((p.2 * pint5 B G p.1 : ℤ) : ℂ) * (θ : ℂ))).re := by
      funext θ
      rw [hfin]
      congr 1
      apply Finset.sum_congr rfl
      intro p _
      rw [hphase]
      ring
    have hk : ∀ p ∈ T ×ˢ H, p.2 * pint5 B G p.1 ≠ 0 := by
      intro p hp
      have hp2 : p.2 ∈ H := (Finset.mem_product.mp hp).2
      have hne : p.2 ≠ 0 := fun h => hH0 (h ▸ hp2)
      exact mul_ne_zero hne (hpint p.1)
    obtain ⟨hC, hI⟩ := hgen (T ×ˢ H)
      (fun p => a p.1 p.2 ξ * Complex.exp (Complex.I * (p.2 : ℂ) *
        ((kb B.h p.1.1 : ℂ) * (phiL5 B G p.1 ξ : ℂ))))
      (fun p => p.2 * pint5 B G p.1) hk
    rw [hfun]
    refine ⟨hC, ?_⟩
    simp only [thA, hI, mul_zero]

  have hsum : ∀ (F : Lab → ℤ → ℂ) (Γ : Finset Lab) (H : Finset ℤ),
      (∀ γ m, (γ ∉ Γ ∨ m ∉ H) → F γ m = 0) →
      ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, F γ m = ∑ γ ∈ Γ, ∑ m ∈ H, F γ m := by
    intro F Γ H hF
    have hin : ∀ γ, ∑ᶠ m : ℤ, F γ m = ∑ m ∈ H, F γ m := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      rw [Function.mem_support] at hm
      by_contra h
      exact hm (hF γ m (Or.inr (by simpa using h)))
    simp_rw [hin]
    apply finsum_eq_sum_of_support_subset
    intro γ hγ
    rw [Function.mem_support] at hγ
    by_contra h
    exact hγ (Finset.sum_eq_zero (fun m _ => hF γ m (Or.inl (by simpa using h))))
  have hrot : ∀ r θ z : ℝ, 0 < r → rad (rotPt r θ z) = r ∧ rotPt r θ z 2 = z := by
    intro r θ z hr
    constructor
    · have h : (rotPt r θ z) 0 ^ 2 + (rotPt r θ z) 1 ^ 2 = r ^ 2 := by
        simp [rotPt]
        rw [mul_pow, mul_pow, ← mul_add, Real.cos_sq_add_sin_sq, mul_one]
      unfold rad
      rw [h, Real.sqrt_sq hr.le]
    · simp [rotPt]
  have hframe : ∀ (y : ℝ³), 0 < rad y → ∀ (v : Fin 3 → ℝ) (a : Fin 3),
      inner ℝ (cyl2cart y v) (![eR y, eTh y, eZ] a) = v a := by
    intro y hy v a
    have hr2 : rad y ^ 2 = y 0 ^ 2 + y 1 ^ 2 := Real.sq_sqrt (by positivity)
    have hne : rad y ≠ 0 := hy.ne'
    have hs : (rad y)⁻¹ ^ 2 * (y 0 ^ 2 + y 1 ^ 2) = 1 := by
      rw [← hr2]; field_simp
    fin_cases a <;>
      simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three] <;>
      first
      | linear_combination (v 0) * hs
      | linear_combination (v 1) * hs
  have hthA : ∀ (c z : ℝ) (f : ℝ → ℝ), Continuous f → thA f = 0 →
      thA (fun θ => c * (z + f θ)) = c * z := by
    intro c z f hf h0
    have hpi : (2 * Real.pi) ≠ 0 := by positivity
    have hI : ∫ θ in (0:ℝ)..(2 * Real.pi), f θ = 0 := by
      unfold thA at h0
      rcases mul_eq_zero.mp h0 with h | h
      · exact absurd h (inv_ne_zero hpi)
      · exact h
    unfold thA
    rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_add
      (continuous_const.intervalIntegrable _ _) (hf.intervalIntegrable _ _),
      intervalIntegral.integral_const, hI, smul_eq_mul, sub_zero, add_zero]
    calc (2 * Real.pi)⁻¹ * (c * (2 * Real.pi * z)) = c * z * ((2 * Real.pi)⁻¹ * (2 * Real.pi)) := by
          ring
      _ = c * z := by rw [inv_mul_cancel₀ hpi, mul_one]
  intro x t Y hxt
  have hxt' : 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt
  have hξ : ptOf x t Y ∈ DomC B.h (qsOf l0) := hxt
  have hrx : 0 < rad x := hxt'.1
  obtain ⟨T, hTz⟩ := hT _ hξ
  have hQH : ∀ γ m, (γ ∉ T ∨ m ∉ insert (0:ℤ) HQ) → Q γ m (ptOf x t Y) = 0 := by
    intro γ m h
    rcases h with h | h
    · exact hTz γ m h
    · have h' : m ∉ HQ := fun hm => h (Finset.mem_insert_of_mem hm)
      rw [hH γ m h']
      rfl
  have hOH : ∀ γ m, (γ ∉ T ∨ m ∉ insert (0:ℤ) HQ) → cr5Osc Q γ m (ptOf x t Y) = 0 := by
    intro γ m h
    unfold cr5Osc
    split_ifs
    · rfl
    · exact hQH γ m h
  have hsplit : ∀ θ', waveV5 B G Q θ' (ptOf x t Y) =
      (fun i => (∑ γ ∈ T, Q γ 0 (ptOf x t Y) i).re) + waveV5 B G (cr5Osc Q) θ' (ptOf x t Y) := by
    intro θ'
    funext i
    have e1 : ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) =
        ∑ γ ∈ T, ∑ m ∈ insert (0:ℤ) HQ, Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) :=
      hsum _ T _ (fun γ m h => by simp only [hQH γ m h, Pi.zero_apply, zero_mul])
    have e2 : ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, cr5Osc Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) =
        ∑ γ ∈ T, ∑ m ∈ insert (0:ℤ) HQ,
          cr5Osc Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) :=
      hsum _ T _ (fun γ m h => by simp only [hOH γ m h, Pi.zero_apply, zero_mul])
    show (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y)).re =
      (∑ γ ∈ T, Q γ 0 (ptOf x t Y) i).re +
        (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, cr5Osc Q γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y)).re
    rw [e1, e2, ← Complex.add_re, ← Finset.sum_add_distrib]
    congr 1
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    have h0H : (0:ℤ) ∈ insert (0:ℤ) HQ := Finset.mem_insert_self _ _
    have hind : Q γ 0 (ptOf x t Y) i = ∑ m ∈ insert (0:ℤ) HQ,
        (if m = 0 then Q γ m (ptOf x t Y) i else 0) := by
      rw [Finset.sum_ite_eq', if_pos h0H]
    rw [hind, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    by_cases hm : m = 0
    · subst hm
      simp [cr5Osc, ephase5]
    · simp [cr5Osc, hm]
  have hmean : thAvgVec F x t Y = cyl2cart x (fun a =>
      qC B.h (ptOf x t Y) ^ (-e) * (∑ γ ∈ T, Q γ 0 (ptOf x t Y) a).re) := by
    unfold thAvgVec
    congr 1
    funext a
    have hfun : (fun θ => inner ℝ (F (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) =
        fun θ => qC B.h (ptOf x t Y) ^ (-e) *
          ((∑ γ ∈ T, Q γ 0 (ptOf x t Y) a).re +
            waveS5 B G (fun γ m η => cr5Osc Q γ m η a) (thetaOf (rotPt (rad x) θ (x 2))) (ptOf x t Y)) := by
      funext θ
      obtain ⟨hr, hzz⟩ := hrot (rad x) θ (x 2) hrx
      have hc : corrOn B l0 (rotPt (rad x) θ (x 2)) t := by
        show 0 < rad (rotPt (rad x) θ (x 2)) ∧ t < 1 ∧
          simScale B.h ((rotPt (rad x) θ (x 2)) 2) (1 - t) < qsOf l0
        rw [hr, hzz]
        exact hxt'
      have hp : ptOf (rotPt (rad x) θ (x 2)) t Y = ptOf x t Y := by
        show (rad (rotPt (rad x) θ (x 2)), (rotPt (rad x) θ (x 2)) 2, t, Y) = (rad x, x 2, t, Y)
        rw [hr, hzz]
      rw [hF _ t Y hc, hp, real_inner_smul_left]
      have hf : frameAt θ (ptOf x t Y) a =
          ![eR (rotPt (rad x) θ (x 2)), eTh (rotPt (rad x) θ (x 2)), eZ] a := rfl
      rw [hf, hframe _ (by rw [hr]; exact hrx), hsplit]
      rfl
    have hm1 : ∀ γ m, m ∉ HQ.erase 0 → cr5Osc Q γ m (ptOf x t Y) a = 0 := by
      intro γ m hm
      unfold cr5Osc
      split_ifs with h0
      · rfl
      · have hm' : m ∉ HQ := fun h => hm (Finset.mem_erase.mpr ⟨h0, h⟩)
        rw [hH γ m hm']
        rfl
    have hm2 : ∀ γ m, γ ∉ T → cr5Osc Q γ m (ptOf x t Y) a = 0 := by
      intro γ m hγ
      exact congrFun (hOH γ m (Or.inl hγ)) a
    obtain ⟨hcont, hz⟩ := hcirc (fun γ m η => cr5Osc Q γ m η a) (ptOf x t Y)
      (rad x) (x 2) (HQ.erase 0) T hrx (Finset.notMem_erase 0 HQ) hm1 hm2
    rw [hfun]
    exact hthA _ _ _ hcont hz
  rw [hmean, hF x t Y hxt, hsplit]
  simp only [cyl2cart, Pi.add_apply, add_smul, smul_add, smul_smul]
  abel

theorem cr5mw_phase_free : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (S : CState) (β : ℝ) (D : WC), InWg5 B G (qsOf l0) β (wmoAmp5 B G D) →
    (∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 S a) (DomC B.h (qsOf l0))) →
    ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      cr5MW B G l0 S (cr5Vel B G D) γ m ξ = cr5mwPF B G l0 S (wmoAmp5 B G D) γ m ξ :=
by
  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 S β D hW hmc γ m ξ hξ => ?_⟩

  have hQs : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hq : qsOf l0 ≤ B.qB := by
    rw [hQs]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  obtain ⟨hΩ, hqC, hqpos, -, -, -⟩ := domc_open_calculus B (qsOf l0) hok
  have hQb : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  have hq0 := hqpos ξ hξ
  have hne : qC B.h ξ ≠ 0 := hq0.ne'
  have hd : HasFDerivAt (qC B.h) (fderiv ℝ (qC B.h) ξ) ξ :=
    ((hqC.contDiffAt (hΩ.mem_nhds hξ)).differentiableAt (by norm_num)).hasFDerivAt

  have hR0 : fderiv ℝ (qC B.h) ξ ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) = 0 := by
    have hL : HasDerivAt (fun t : ℝ => ξ + t • ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv))
        ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) 0 := by
      have h0 := ((hasDerivAt_id (0:ℝ)).smul_const
        ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)).const_add ξ
      simpa using h0
    have hd' : HasFDerivAt (qC B.h) (fderiv ℝ (qC B.h) ξ)
        (ξ + (0:ℝ) • ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) := by
      rw [zero_smul, add_zero]; exact hd
    have h1 := hd'.comp_hasDerivAt (0:ℝ) hL
    have hc : (qC B.h ∘ fun t : ℝ => ξ + t • ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) =
        fun _ => qC B.h ξ := by
      funext t
      simp [qC]
    rw [hc] at h1
    exact h1.unique (hasDerivAt_const _ _)
  have hgq : HasFDerivAt (fun η => qC B.h η ^ (-Aex B.h))
      ((-Aex B.h * qC B.h ξ ^ (-Aex B.h - 1)) • fderiv ℝ (qC B.h) ξ) ξ :=
    hd.rpow_const (Or.inl hne)
  have hgC : HasFDerivAt (fun η => ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ))
      (Complex.ofRealCLM.comp ((-Aex B.h * qC B.h ξ ^ (-Aex B.h - 1)) • fderiv ℝ (qC B.h) ξ)) ξ := by
    have h0 := Complex.ofRealCLM.hasFDerivAt.comp ξ hgq
    exact h0
  have hZw : -Aex B.h * qC B.h ξ ^ (-Aex B.h - 1) * fderiv ℝ (qC B.h) ξ ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) =
      -(qC B.h ξ ^ (-Aex B.h) * (Aex B.h * dZ (fun η => Real.log (qC B.h η)) ξ)) := by
    unfold dZ
    rw [(hd.log hne).fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul, Real.rpow_sub_one hne]
    ring

  have hfun : modeCoef5 B G (cr5Vel B G D) γ m =
      (fun η => ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ)) • modeCoef5 B G (wmoAmp5 B G D) γ m := by
    funext η j
    show _ = ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ) * modeCoef5 B G (wmoAmp5 B G D) γ m η j
    simp only [modeCoef5, cr5Vel, Pi.smul_apply, smul_eq_mul]
    ring
  have hF : HasFDerivAt (modeCoef5 B G (wmoAmp5 B G D) γ m)
      (fderiv ℝ (modeCoef5 B G (wmoAmp5 B G D) γ m) ξ) ξ :=
    (modeCoef5_differentiable_v5 B G hok hG (qsOf l0) β (wmoAmp5 B G D) hq hW γ m ξ hξ).hasFDerivAt
  have hfd : fderiv ℝ (modeCoef5 B G (cr5Vel B G D) γ m) ξ =
      fderiv ℝ ((fun η => ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ)) • modeCoef5 B G (wmoAmp5 B G D) γ m) ξ := by
    rw [hfun]
  rw [(hgC.smul hF).fderiv] at hfd
  have hjR : ∀ i : Fin 3, dR B.h (modeCoef5 B G (cr5Vel B G D) γ m) ξ i =
      ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * dR B.h (fun η => modeCoef5 B G (wmoAmp5 B G D) γ m η i) ξ := by
    intro i
    have hFi := (hasFDerivAt_pi'.1 hF i).fderiv
    show fderiv ℝ (modeCoef5 B G (cr5Vel B G D) γ m) ξ
        ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) i =
      ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * fderiv ℝ (fun η => modeCoef5 B G (wmoAmp5 B G D) γ m η i) ξ
        ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)
    rw [hfd, hFi]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.comp_apply, ContinuousLinearMap.proj_apply,
      Complex.ofRealCLM_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul, hR0, mul_zero,
      Complex.ofReal_zero, zero_mul, add_zero]
  have hjZ : ∀ i : Fin 3, dZ (modeCoef5 B G (cr5Vel B G D) γ m) ξ i =
      ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * (dZ (fun η => modeCoef5 B G (wmoAmp5 B G D) γ m η i) ξ -
        ((Aex B.h * dZ (fun η => Real.log (qC B.h η)) ξ : ℝ) : ℂ) * modeCoef5 B G (wmoAmp5 B G D) γ m ξ i) := by
    intro i
    have hFi := (hasFDerivAt_pi'.1 hF i).fderiv
    show fderiv ℝ (modeCoef5 B G (cr5Vel B G D) γ m) ξ ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) i =
      ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * (fderiv ℝ (fun η => modeCoef5 B G (wmoAmp5 B G D) γ m η i) ξ
        ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) -
        ((Aex B.h * dZ (fun η => Real.log (qC B.h η)) ξ : ℝ) : ℂ) * modeCoef5 B G (wmoAmp5 B G D) γ m ξ i)
    rw [hfd, hFi]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.comp_apply, ContinuousLinearMap.proj_apply,
      Complex.ofRealCLM_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    rw [hZw]
    push_cast
    ring
  obtain ⟨E, hE⟩ : ∃ E : ℂ,
      E = Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) := ⟨_, rfl⟩
  have hval : ∀ i : Fin 3, modeCoef5 B G (cr5Vel B G D) γ m ξ i =
      ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * (wmoAmp5 B G D γ m ξ i * E) := by
    intro i
    rw [hE]
    simp only [modeCoef5, cr5Vel, Pi.smul_apply, smul_eq_mul]
    ring
  have hdR' : ∀ i : Fin 3, dR B.h (modeCoef5 B G (cr5Vel B G D) γ m) ξ i =
      ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * ((dR B.h (fun η => wmoAmp5 B G D γ m η i) ξ +
        Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) * ((dR B.h (phiL5 B G γ) ξ : ℝ) : ℂ) *
        wmoAmp5 B G D γ m ξ i) * E) := by
    intro i
    rw [hjR i, (wmo_phase_deriv_v5 B G hok hG (qsOf l0) β (wmoAmp5 B G D) hq hW γ m ξ hξ i).1, hE]
  have hdZ' : ∀ i : Fin 3, dZ (modeCoef5 B G (cr5Vel B G D) γ m) ξ i =
      ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * ((dZ (fun η => wmoAmp5 B G D γ m η i) ξ +
        Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) * ((dZ (phiL5 B G γ) ξ : ℝ) : ℂ) *
        wmoAmp5 B G D γ m ξ i) * E -
        ((Aex B.h * dZ (fun η => Real.log (qC B.h η)) ξ : ℝ) : ℂ) * (wmoAmp5 B G D γ m ξ i * E)) := by
    intro i
    rw [hjZ i, (wmo_phase_deriv_v5 B G hok hG (qsOf l0) β (wmoAmp5 B G D) hq hW γ m ξ hξ i).2, hE]
    rfl

  have ha : ∀ a : Fin 3, HasFDerivAt (mcor5 B G l0 S a) (fderiv ℝ (mcor5 B G l0 S a) ξ) ξ := fun a =>
    (((hmc a).contDiffAt (hΩ.mem_nhds hξ)).differentiableAt (by norm_num)).hasFDerivAt
  have hcM : HasFDerivAt (cr5Mc B G l0 S)
      (ContinuousLinearMap.pi fun a => Complex.ofRealCLM.comp (fderiv ℝ (mcor5 B G l0 S a) ξ)) ξ :=
    (hasFDerivAt_pi (φ := fun a η => ((mcor5 B G l0 S a η : ℝ) : ℂ))).2
      (fun a => Complex.ofRealCLM.hasFDerivAt.comp ξ (ha a))
  have hMR : ∀ i : Fin 3, dR B.h (cr5Mc B G l0 S) ξ i = ((dR B.h (mcor5 B G l0 S i) ξ : ℝ) : ℂ) := by
    intro i
    unfold dR
    rw [hcM.fderiv]
    rfl
  have hMZ : ∀ i : Fin 3, dZ (cr5Mc B G l0 S) ξ i = ((dZ (mcor5 B G l0 S i) ξ : ℝ) : ℂ) := by
    intro i
    unfold dZ
    rw [hcM.fderiv]
    rfl
  have hMc : ∀ j : Fin 3, cr5Mc B G l0 S ξ j = ((mcor5 B G l0 S j ξ : ℝ) : ℂ) := fun j => rfl

  have hA0 : 0 < qC B.h ξ ^ Aex B.h := Real.rpow_pos_of_pos hq0 _
  have G1 : qC B.h ξ ^ (-Aex B.h) = (qC B.h ξ ^ Aex B.h)⁻¹ := Real.rpow_neg hq0.le _
  have G2 : qC B.h ξ ^ (2 * Aex B.h + 1/2) =
      qC B.h ξ ^ Aex B.h * qC B.h ξ ^ Aex B.h * Real.sqrt (qC B.h ξ) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_add hq0, ← Real.rpow_add hq0]
    congr 1
    ring
  have G3 : qC B.h ξ ^ (Aex B.h + 1/2) = qC B.h ξ ^ Aex B.h * Real.sqrt (qC B.h ξ) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_add hq0]
  have G4 : Qb γ.1 ^ (-(1/2:ℝ)) = (Real.sqrt (Qb γ.1))⁻¹ := by
    rw [Real.rpow_neg hQb.le, Real.sqrt_eq_rpow]
  have hkb : 0 < kb B.h γ.1 := by
    unfold kb epsb
    exact Nat.ceil_pos.2 (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos hQb _) _)
  have hK : (kb B.h γ.1 : ℂ) ≠ 0 := by exact_mod_cast hkb.ne'
  have hr0 : (ξ.1 : ℂ) ≠ 0 := by exact_mod_cast hξ'.1.ne'
  have hQh : ((Real.sqrt (Qb γ.1) : ℝ) : ℂ) ≠ 0 := by exact_mod_cast (Real.sqrt_pos.2 hQb).ne'
  have hα : ((qC B.h ξ ^ Aex B.h : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hA0.ne'
  have hE0 : E ≠ 0 := by rw [hE]; exact Complex.exp_ne_zero _
  funext j
  simp only [cr5MW, cr5Ph]
  rw [← hE]
  fin_cases j <;>
    simp only [pq5TrM, cr5mwPF, cr5mwMat, nrm, nPhi5, DrC, DzC, pang5, RC, pulseMatC, Matrix.mulVec,
      dotProduct, Fin.sum_univ_three, Matrix.map_apply, Matrix.of_apply, Pi.add_apply, Pi.smul_apply,
      smul_eq_mul, hval, hdR', hdZ', hMR, hMZ, hMc, G1, G2, G3, G4, Fin.zero_eta, Fin.mk_one,
      Fin.reduceFinMk, Fin.isValue, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons] <;>
    push_cast <;>
    field_simp <;>
    ring

theorem cr5mw_nu_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (α : ℝ) (w : WC) (i : Fin 3), InWg5 B G (qsOf l0) α w →
    InWg5 B G (qsOf l0) (α - 1/2) (fun γ m ξ => (Complex.I * (m : ℂ) *
      ((Real.sqrt (qC B.h ξ) * (kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) * nPhi5 B G γ ξ i : ℝ) : ℂ)) • w γ m ξ) :=
by
  intro B G hok hG
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨lM, hM⟩ := pq5_mult_class B G hok hG
  obtain ⟨lP, hP⟩ := pulse_support_good_v5 B G hok hG
  obtain ⟨lN, hN⟩ := good_nphi5_nb_v5 B G hok hG
  obtain ⟨lG, hGap⟩ := band_coarse_gap_v5 B.h hh0 hh1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨lM + lP + lN + lG + n0, fun l0 hl0 α w i hw => ?_⟩

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hD1 : ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ DomC B.h B.qB := by
    intro ξ hξ
    obtain ⟨e1, e2, e3⟩ := hξ
    exact ⟨e1, e2, lt_of_lt_of_le e3 hqsB⟩
  have hqpos : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ := by
    intro ξ hξ
    obtain ⟨-, e2, -⟩ := hξ
    exact (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1

  have hcoe : ∀ (g : Cyl → ℝ) (ξ : Cyl) (k : ℕ), ContDiffAt ℝ ∞ g ξ →
      NB B.h (fun η => ((g η : ℝ) : ℂ)) k ξ ≤ NB B.h g k ξ := by
    intro g ξ k hg
    unfold NB
    have e : (fun η => ((g η : ℝ) : ℂ)) = ⇑Complex.ofRealCLM ∘ g := by
      funext η
      simp
    rw [e, ContinuousLinearMap.iteratedFDeriv_comp_left _ hg (i := k) (by exact_mod_cast le_top)]
    have e2 : (Complex.ofRealCLM.compContinuousMultilinearMap (iteratedFDeriv ℝ k g ξ)).compContinuousLinearMap
        (fun _ => Lnorm B.h ξ) = Complex.ofRealCLM.compContinuousMultilinearMap
          ((iteratedFDeriv ℝ k g ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext v
      rfl
    rw [e2]
    refine le_trans (ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _) ?_
    rw [Complex.ofRealCLM_norm, one_mul]

  have hsmR : ∀ (γ : Lab) (ξ : Cyl), ξ ∈ DomC B.h (qsOf l0) → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 →
      |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → ContDiffAt ℝ ∞ (fun η : Cyl => nPhi5 B G γ η i) ξ := by
    intro γ ξ hξ h1 h2
    obtain ⟨U, hUo, hξU, -, hU, -⟩ := good_coeff_smooth_v5 B G γ ξ hok (hD1 ξ hξ) h1 h2
    exact (hU i).contDiffAt (hUo.mem_nhds hξU)
  have hsm : ∀ (γ : Lab) (ξ : Cyl), ξ ∈ DomC B.h (qsOf l0) → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 →
      |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → ContDiffAt ℝ ∞ (fun η : Cyl => ((nPhi5 B G γ η i : ℝ) : ℂ)) ξ := by
    intro γ ξ hξ h1 h2
    have e : (fun η : Cyl => ((nPhi5 B G γ η i : ℝ) : ℂ)) =
        ⇑Complex.ofRealCLM ∘ (fun η : Cyl => nPhi5 B G γ η i) := by
      funext η
      simp
    rw [e]
    exact Complex.ofRealCLM.contDiff.contDiffAt.comp ξ (hsmR γ ξ hξ h1 h2)

  obtain ⟨w', hw'e⟩ : ∃ w' : WC, w' = fun (γ : Lab) (m : ℤ) (ξ : Cyl) =>
      (Complex.I * (m : ℂ) * (((kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) * Real.sqrt (qC B.h ξ) : ℝ) : ℂ)) •
        w γ m ξ := ⟨_, rfl⟩
  have hw' : InWg5 B G (qsOf l0) (α - 1/2) w' := by
    rw [hw'e]
    exact (hM l0 (by omega) α w hw).2.2

  have hres := inWg5_smul_mult B G l0 hok (α - 1/2) 0 w'
    (fun γ η => ((nPhi5 B G γ η i : ℝ) : ℂ)) hw'
    (fun γ m ξ hξ hts => by
      obtain ⟨-, -, -, -, -, -, -, W7, W8⟩ := hP l0 (by omega) (α - 1/2) w' hw' γ m ξ hξ hts
      exact hsm γ ξ hξ W7 W8)
    (fun γ m ξ hξ hne c hc => by
      have hts : ξ ∈ tsupport (w' γ m) := subset_tsupport _ (Function.mem_support.mpr hne)
      obtain ⟨-, -, -, W3, W4, -⟩ := hP l0 (by omega) (α - 1/2) w' hw' γ m ξ hξ hts
      have hξ3 : qC B.h ξ < qsOf l0 :=
        (show 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 from hξ).2.2
      have hle := (hGap γ.1 l0 (qC B.h ξ) (by omega) (hqpos ξ hξ) hξ3 W3 W4).1
      have hd := nPhi5_deck_v5 B G γ (coarseIdx B.h (qC B.h ξ)) c hle hc ξ
      show ((nPhi5 B G γ (shY ξ c) i : ℝ) : ℂ) = ((nPhi5 B G γ ξ i : ℝ) : ℂ)
      rw [hd])
    (fun k => by
      obtain ⟨C, hC⟩ := hN k
      refine ⟨C, 1, fun γ m ξ hξ hts _ _ => ?_⟩
      obtain ⟨-, W1, W2, W3, W4, W5, W6, W7, W8⟩ := hP l0 (by omega) (α - 1/2) w' hw' γ m ξ hξ hts
      rw [mul_zero, Real.rpow_zero, mul_one, Real.rpow_one]
      exact le_trans (hcoe (fun η => nPhi5 B G γ η i) ξ k (hsmR γ ξ hξ W7 W8))
        (hC l0 (by omega) γ W1 W2 ξ hξ W3 W4 W5 W6 W7 W8 i))
  rw [add_zero] at hres

  have e : (fun (γ : Lab) (m : ℤ) (ξ : Cyl) => (Complex.I * (m : ℂ) *
      ((Real.sqrt (qC B.h ξ) * (kb B.h γ.1 : ℝ) * Qb γ.1 ^ (-(1/2:ℝ)) * nPhi5 B G γ ξ i : ℝ) : ℂ)) • w γ m ξ) =
      (fun (γ : Lab) (m : ℤ) (ξ : Cyl) => ((nPhi5 B G γ ξ i : ℝ) : ℂ) • w' γ m ξ) := by
    funext γ m ξ
    simp only [hw'e, smul_smul]
    congr 1
    push_cast
    ring
  rw [e]
  exact hres

theorem cr5mw_inm_mult : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ), B.ok → ∀ (α β : ℝ) (w : WC),
    InWg5 B G (qsOf l0) β w →
    (∀ f : Cyl → ℝ, InM B (qsOf l0) α f →
      InWg5 B G (qsOf l0) (α + β) (fun γ m ξ => ((f ξ : ℝ) : ℂ) • w γ m ξ)) ∧
    (∀ Mf : Cyl → Matrix (Fin 3) (Fin 3) ℝ, (∀ i j : Fin 3, InM B (qsOf l0) α (fun ξ => Mf ξ i j)) →
      InWg5 B G (qsOf l0) (α + β) (fun γ m ξ => (pulseMatC (Mf ξ)).mulVec (w γ m ξ))) :=
by
  intro B G l0 hok α β w hw
  obtain ⟨hh0, hh1, hXa, hXam1, hm12, hm2Xb, -, -, -, -, -, haa, hab⟩ := hok.2.1
  have hXab : B.Xa < B.Xb := lt_trans (lt_trans hXam1 hm12) hm2Xb
  have hO : IsOpen (DomC B.h (qsOf l0)) := (domc_open_calculus B (qsOf l0) hok).1
  have hqp : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ := (domc_open_calculus B (qsOf l0) hok).2.2.1
  have hSC : ∀ (ξ : Cyl) (b : ℝ), 0 ≤ SC B.h ξ ^ b := by
    intro ξ b
    exact Real.rpow_nonneg (by unfold SC; positivity) b
  have hSC1 : ∀ ξ : Cyl, 1 ≤ SC B.h ξ := by
    intro ξ
    unfold SC
    have h1 : 1 ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    nlinarith
  have hEW : ∀ X : ℝ, 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X := by
    intro X
    unfold edgeWeight
    split_ifs
    · positivity
    · exact le_rfl
  have hED : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 < edgeDist B.Xa B.Xb X := by
    intro X h1 h2
    have hX0 : 0 < X := lt_trans hXa h1
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr h1))
      (Real.log_pos ((one_lt_div hX0).mpr h2)))
  have hED1 : ∀ X : ℝ, edgeDist B.Xa B.Xb X ≤ 1 := fun X => min_le_left _ _

  have hK : ∀ g : Cyl → ℝ, InM B (qsOf l0) α g → ∀ k : ℕ, ∃ C b : ℝ, 0 ≤ C ∧
      ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h g k ξ ≤ C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b := by
    intro g hg k
    obtain ⟨C, b, d, hC⟩ := hg.2.2.2 k
    obtain ⟨Ce, hCe0, -, hCe⟩ := stp5_edge_mono B.Xa B.Xb B.aa B.ab (max d 0) hXa hXab haa hab
      (le_max_right d 0)
    refine ⟨|C| * Ce, b, mul_nonneg (abs_nonneg C) hCe0.le, fun ξ hξ hX1 hX2 => ?_⟩
    have hq := hqp ξ hξ
    have hqa : 0 ≤ qC B.h ξ ^ (B.h * α) := Real.rpow_nonneg hq.le _
    have hs := hSC ξ b
    have hew := hEW (XC B.h ξ)
    have hed := hED _ hX1 hX2
    have hed1 := hED1 (XC B.h ξ)
    have hpow : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) ≤
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(max d 0)) :=
      Real.rpow_le_rpow_of_exponent_ge hed hed1 (neg_le_neg (le_max_left d 0))
    have hedp : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) := Real.rpow_nonneg hed.le _
    have hb := hCe (XC B.h ξ) hX1 hX2
    have hP : 0 ≤ |C| * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b :=
      mul_nonneg (mul_nonneg (abs_nonneg C) hqa) hs
    have h1 : C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b ≤ |C| * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_abs_self C) hqa) hs
    have h2 : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) :=
      mul_nonneg hew hedp
    calc NB B.h g k ξ ≤ C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b *
          edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) :=
          hC ξ hξ hX1 hX2
      _ = (C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b) *
          (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d)) := by
          ring
      _ ≤ (|C| * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b) *
          (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d)) :=
          mul_le_mul_of_nonneg_right h1 h2
      _ ≤ (|C| * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b) *
          (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(max d 0))) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hpow hew) hP
      _ ≤ (|C| * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b) * Ce :=
          mul_le_mul_of_nonneg_left hb hP
      _ = |C| * Ce * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b := by ring

  have hNBc : ∀ (g : Cyl → ℝ) (k : ℕ) (ξ : Cyl), ContDiffAt ℝ ∞ g ξ →
      NB B.h (fun η => ((g η : ℝ) : ℂ)) k ξ ≤ NB B.h g k ξ := by
    intro g k ξ hg
    have hμ : (fun η => ((g η : ℝ) : ℂ)) = (Complex.ofRealCLM : ℝ →L[ℝ] ℂ) ∘ g := by
      funext η
      rfl
    unfold NB
    rw [hμ, ContinuousLinearMap.iteratedFDeriv_comp_left _ hg (by exact_mod_cast le_top)]
    have e : (Complex.ofRealCLM.compContinuousMultilinearMap
        (iteratedFDeriv ℝ k g ξ)).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
        Complex.ofRealCLM.compContinuousMultilinearMap
          ((iteratedFDeriv ℝ k g ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
      ext v
      rfl
    rw [e]
    refine le_trans (ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _) ?_
    rw [Complex.ofRealCLM_norm, one_mul]
  refine ⟨fun f hf => ?_, fun Mf hM => ?_⟩
  · have hfd : ∀ ξ ∈ DomC B.h (qsOf l0), ContDiffAt ℝ ∞ f ξ :=
      fun ξ hξ => hf.1.contDiffAt (hO.mem_nhds hξ)
    have hμd : ∀ ξ ∈ DomC B.h (qsOf l0), ContDiffAt ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) ξ := by
      intro ξ hξ
      have h := (Complex.ofRealCLM : ℝ →L[ℝ] ℂ).contDiff.contDiffAt.comp ξ (hfd ξ hξ)
      exact h
    have H := inWg5_smul_mult B G l0 hok β α w (fun _ η => ((f η : ℝ) : ℂ)) hw
      (fun γ m ξ hξ _ => hμd ξ hξ)
      (fun γ m ξ hξ _ c hc => congrArg (fun x : ℝ => (x : ℂ)) (hf.2.1 ξ hξ c hc))
      (fun k => by
        obtain ⟨C, b, -, hC⟩ := hK f hf k
        exact ⟨C, b, fun γ m ξ hξ _ hX1 hX2 =>
          le_trans (hNBc f k ξ (hfd ξ hξ)) (hC ξ hξ hX1 hX2)⟩)
    rw [add_comm β α] at H
    exact H
  · have hMd : ∀ i j : Fin 3, ∀ ξ ∈ DomC B.h (qsOf l0), ContDiffAt ℝ ∞ (fun η => Mf η i j) ξ :=
      fun i j ξ hξ => (hM i j).1.contDiffAt (hO.mem_nhds hξ)
    have H := inWg5_mat_mult_v5 B G l0 hok β α w (fun _ _ ξ => Mf ξ) hw
      (fun γ m ξ hξ _ i j => hMd i j ξ hξ)
      (fun γ m ξ hξ _ c hc => Matrix.ext (fun i j => (hM i j).2.1 ξ hξ c hc))
      (fun k => by
        have hKk : ∀ i j : Fin 3, ∃ C b : ℝ, 0 ≤ C ∧ ∀ ξ ∈ DomC B.h (qsOf l0),
            B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
