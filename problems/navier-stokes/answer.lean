theorem pulse5_nsq_lower_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ c : ℝ, 0 < c ∧ ∀ (γ : Lab) (ξ : Cyl), ActiveL4 B G γ → ξ ∈ DomC B.h B.qB → etaL B.h γ ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), c ≤ pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 1 ^ 2 + pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) v 2 ^ 2 :=
