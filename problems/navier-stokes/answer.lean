    have hCPc : 0 ≤ CP / c := div_nonneg hCP0 hc.le
    have r4 : 1 + A / yAmp4 B G γ ξ ≤
        (1 + CP / c) * (SC B.h ξ ^ bP * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dP)) := by
      have e : (1 + CP / c) * (SC B.h ξ ^ bP * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dP)) =
