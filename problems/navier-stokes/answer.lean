      hs (Filter.eventually_of_mem hs (fun e he => hmeas e he.1 he.2))
      ((hgc η he1 he2).intervalIntegrable_of_Icc zero_le_one) hderm hbound
      intervalIntegrable_const hder
  obtain ⟨hJU, hAU⟩ := leib U (fun e h1 h2 => (hC e h1 h2).1)
    (fun x e a b c d => ⟨(hDf x e a b c d).1, (hDf x e a b c d).2.2.1⟩)
  obtain ⟨hJR, hAR⟩ := leib Ur (fun e h1 h2 => (hC e h1 h2).2)
