    intro w hw
    obtain ⟨h1, h2, h3⟩ := hw
    show |w.im| < r ∧ -1 - r < w.re ∧ w.re < 1 + r
    exact ⟨by linarith, by linarith, by linarith⟩
  have h4 : ∀ w ∈ axRect (r / 2), ‖4 * w + (j0 : ℂ)‖ ≤ 5 := by
    intro w hw
