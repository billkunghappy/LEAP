    obtain ⟨T0, T1, T2⟩ := hT d
    have c0 : fderiv ℝ (fun z => mvec5 h n d Y0 z s) y v 0 =
        (α • mvec5 h n (fun η i => dR h (fun η' => d η' i) η) Y0 y s + β • mvec5 h n (mthC n d) Y0 y s
          + (v 2) • mvec5 h n (fun η i => dZ (fun η' => d η' i) η) Y0 y s) 0 := by
      rw [l0.unique d0]
      simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, (hMc _ y).1]
      beta_reduce
      rw [hγ0, T0, T1]
      simp only [Complex.real_smul]
      simp [Complex.mul_re, Complex.mul_im]
      ring
    have c1 : fderiv ℝ (fun z => mvec5 h n d Y0 z s) y v 1 =
        (α • mvec5 h n (fun η i => dR h (fun η' => d η' i) η) Y0 y s + β • mvec5 h n (mthC n d) Y0 y s
          + (v 2) • mvec5 h n (fun η i => dZ (fun η' => d η' i) η) Y0 y s) 1 := by
      rw [l1.unique d1]
      simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, (hMc _ y).2.1]
      beta_reduce
      rw [hγ0, T0, T1]
      simp only [Complex.real_smul]
      simp [Complex.mul_re, Complex.mul_im]
      ring
    have c2 : fderiv ℝ (fun z => mvec5 h n d Y0 z s) y v 2 =
        (α • mvec5 h n (fun η i => dR h (fun η' => d η' i) η) Y0 y s + β • mvec5 h n (mthC n d) Y0 y s
          + (v 2) • mvec5 h n (fun η i => dZ (fun η' => d η' i) η) Y0 y s) 2 := by
      rw [l2.unique d2]
      simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, (hMc _ y).2.2]
      beta_reduce
      rw [T2]
      simp only [Complex.real_smul]
      simp [Complex.mul_re, Complex.mul_im]
      ring
    ext k
    fin_cases k
    · exact c0
    · exact c1
    · exact c2
  have heR0 : eR y 0 = (rad y)⁻¹ * y 0 := by simp [eR, radVec]
  have heR1 : eR y 1 = (rad y)⁻¹ * y 1 := by simp [eR, radVec]
  have heR2 : eR y 2 = 0 := by simp [eR, radVec]
  have heT0 : eTh y 0 = -((rad y)⁻¹ * y 1) := by simp [eTh, azVec]
  have heT1 : eTh y 1 = (rad y)⁻¹ * y 0 := by simp [eTh, azVec]
  have heT2 : eTh y 2 = 0 := by simp [eTh, azVec]
  have heZ0 : eZ 0 = 0 := by simp [eZ]
  have heZ1 : eZ 1 = 0 := by simp [eZ]
  have heZ2 : eZ 2 = 1 := by simp [eZ]
  have hdir : ∀ d : Cyl → (Fin 3 → ℂ), DifferentiableAt ℝ d (ptOf y s (Yph h (rad y) s + Y0)) →
      fderiv ℝ (fun z => mvec5 h n d Y0 z s) y (eR y) = mvec5 h n (fun η i => dR h (fun η' => d η' i) η) Y0 y s ∧
      fderiv ℝ (fun z => mvec5 h n d Y0 z s) y (eTh y) = mvec5 h n (mthC n d) Y0 y s ∧
      fderiv ℝ (fun z => mvec5 h n d Y0 z s) y eZ = mvec5 h n (fun η i => dZ (fun η' => d η' i) η) Y0 y s := by
    intro d hd
    refine ⟨?_, ?_, ?_⟩
    · rw [hD d hd (eR y) 1 0 (by rw [heR0]; ring) (by rw [heR1]; ring), heR2]
      simp
    · rw [hD d hd (eTh y) 0 1 (by rw [heT0]; ring) (by rw [heT1]; ring), heT2]
      simp
    · rw [hD d hd eZ 0 0 (by rw [heZ0]; ring) (by rw [heZ1]; ring), heZ2]
      simp
  have hTime : HasDerivAt (fun s' => mvec5 h n c Y0 y s')
      (mvec5 h n (fun η i => dT (fun η' => c η' i) η) Y0 y s) s := by
    have hY : HasDerivAt (fun s' => Yph h (rad y) s' + Y0) vtv s :=
      ((((hasDerivAt_id' s).smul_const vtv).const_add ((rad y) ^ drx h • vrv)).add_const Y0).congr_deriv
        (one_smul ℝ vtv)
    have hQ : HasDerivAt (fun s' => ptOf y s' (Yph h (rad y) s' + Y0)) ((0:ℝ), (0:ℝ), (1:ℝ), vtv) s :=
      (hasDerivAt_const s (rad y)).prodMk ((hasDerivAt_const s (y 2)).prodMk ((hasDerivAt_id' s).prodMk hY))
    have hci : ∀ i : Fin 3, HasDerivAt (fun s' => c (ptOf y s' (Yph h (rad y) s' + Y0)) i)
        (dT (fun η => c η i) (ptOf y s (Yph h (rad y) s + Y0))) s := by
      intro i
      have h1 := (differentiableAt_pi.1 hcd i).hasFDerivAt.comp_hasDerivAt s hQ
      exact h1
    have g := fun i : Fin 3 => Complex.reCLM.hasFDerivAt.comp_hasDerivAt s
      ((hci i).mul_const (Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))))
    have hh := (((g 0).smul_const (eR y)).add ((g 1).smul_const (eTh y))).add ((g 2).smul_const eZ)
    simp only [Complex.reCLM_apply, Function.comp_def] at hh
    exact hh
  obtain ⟨C', hC'⟩ : ∃ C' : Cyl → (Fin 3 → ℂ), C' = fun η => ![0, 0, p η] := ⟨_, rfl⟩
  have hc'd : DifferentiableAt ℝ C' (ptOf y s (Yph h (rad y) s + Y0)) := by
    rw [hC']
    refine differentiableAt_pi.2 (fun i => ?_)
    fin_cases i
    · simp
    · simp
    · simpa using hpd
  have hfun : (fun z => msc5 h n p Y0 z s) =
      fun z => (EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ) (mvec5 h n C' Y0 z s) := by
    funext z
    rw [show (EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ) (mvec5 h n C' Y0 z s) =
      mvec5 h n C' Y0 z s 2 by rw [EuclideanSpace.coe_proj], (hMc _ z).2.2]
    simp [msc5, hC']
  have hF' := hMdiff C' hc'd
  have hHas := (EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).hasFDerivAt.comp y hF'.hasFDerivAt
  have hPd : HasFDerivAt (fun z => msc5 h n p Y0 z s)
      ((EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).comp (fderiv ℝ (fun z => mvec5 h n C' Y0 z s) y)) y := by
    rw [hfun]; exact hHas
  have hPv : ∀ v : ℝ³, fderiv ℝ (fun z => msc5 h n p Y0 z s) y v =
      fderiv ℝ (fun z => mvec5 h n C' Y0 z s) y v 2 := by
    intro v
    rw [hPd.fderiv, ContinuousLinearMap.comp_apply, EuclideanSpace.coe_proj]
  obtain ⟨hC1, hC2, hC3⟩ := hdir c hcd
  obtain ⟨hP1, hP2, hP3⟩ := hdir C' hc'd
  refine ⟨hMdiff c hcd, hPd.differentiableAt, hC1, hC2, hC3, hTime, ?_, ?_, ?_⟩
  · rw [hPv, hP1, (hMc _ y).2.2]
    simp [msc5, hC']
  · rw [hPv, hP2, (hMc _ y).2.2]
    simp [msc5, mthC, hC']
  · rw [hPv, hP3, (hMc _ y).2.2]
    simp [msc5, hC']

theorem mode5_smooth : ∀ (h : ℝ) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)) (Y0 : ℝ × ℝ) (U : Set Cyl) (y : ℝ³) (s : ℝ), IsOpen U → ContDiffOn ℝ ∞ c U → 0 < rad y → ptOf y s (Yph h (rad y) s + Y0) ∈ U → ContDiffAt ℝ ∞ (fun z => mvec5 h n c Y0 z s) y :=
by
  intro h n c Y0 U y s hU hc hy hmem


  have hpc : ∀ (Φ : ℝ × ℂ → ℝ), ContDiff ℝ ∞ Φ →
      (∀ (θ : ℝ) (e : ℂ), Φ (θ + 2 * Real.pi, e) = Φ (θ, e)) →
      ContDiffOn ℝ ∞ (fun p : ℝ³ × ℂ => Φ (thetaOf p.1, p.2))
        ({y : ℝ³ | 0 < rad y} ×ˢ (univ : Set ℂ)) := by
    intro Φ hΦ' hper
    have hΦ : ContDiffOn ℝ ∞ Φ (univ ×ˢ (univ : Set ℂ)) := hΦ'.contDiffOn
    set Z : ℝ³ → ℂ := fun y => (⟨y 0, y 1⟩ : ℂ) with hZdef
    have hp0 : ContDiff ℝ ∞ (fun y : ℝ³ => y 0) :=
      (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).contDiff
    have hp1 : ContDiff ℝ ∞ (fun y : ℝ³ => y 1) :=
      (EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ).contDiff
    have hZeq : Z = fun y => Complex.ofRealCLM (y 0) + Complex.ofRealCLM (y 1) * Complex.I := by
      funext y; apply Complex.ext <;> simp [hZdef]
    have hZ : ContDiff ℝ ∞ Z := by
      rw [hZeq]
      exact (Complex.ofRealCLM.contDiff.comp hp0).add
        ((Complex.ofRealCLM.contDiff.comp hp1).mul contDiff_const)
    have harg : ∀ z : ℂ, z ∈ Complex.slitPlane → ContDiffAt ℝ ∞ Complex.arg z := by
      intro z hz
      have h1 : ContDiffAt ℝ ∞ Complex.log z := (Complex.contDiffAt_log hz).restrict_scalars ℝ
      have h2 : ContDiffAt ℝ ∞ (fun w => (Complex.log w).im) z :=
        Complex.imCLM.contDiff.contDiffAt.comp z h1
      have e : (fun w => (Complex.log w).im) = Complex.arg := by
        funext w; exact Complex.log_im w
      rwa [e] at h2
    have hbr : ∀ z : ℂ, z ≠ 0 → ∀ e : ℂ,
        Φ (Complex.arg z, e) = Φ (Complex.arg (-z) + Real.pi, e) := by
      intro z hz e
      rcases lt_trichotomy z.im 0 with h | h | h
      · rw [Complex.arg_neg_eq_arg_add_pi_of_im_neg h,
          show z.arg + Real.pi + Real.pi = z.arg + 2 * Real.pi by ring, hper]
      · have hre : z.re ≠ 0 := by
          intro hr; apply hz; exact Complex.ext (by simp [hr]) (by simp [h])
        rcases lt_or_gt_of_ne hre with hr | hr
        · have h1 : z.arg = Real.pi := Complex.arg_eq_pi_iff.mpr ⟨hr, h⟩
          have h2 : (-z).arg = 0 :=
            Complex.arg_eq_zero_iff.mpr ⟨by simp only [Complex.neg_re]; linarith, by simp [h]⟩
          rw [h1, h2, zero_add]
        · have h1 : z.arg = 0 := Complex.arg_eq_zero_iff.mpr ⟨hr.le, h⟩
          have h2 : (-z).arg = Real.pi :=
            Complex.arg_eq_pi_iff.mpr ⟨by simp only [Complex.neg_re]; linarith, by simp [h]⟩
          rw [h1, h2, show Real.pi + Real.pi = 0 + 2 * Real.pi by ring, hper]
      · rw [Complex.arg_neg_eq_arg_sub_pi_of_im_pos h, sub_add_cancel]
    have hZne : ∀ y : ℝ³, 0 < rad y → Z y ≠ 0 := by
      intro y hy h
      have h0 : y 0 = 0 := by
        have := congrArg Complex.re h; simpa [hZdef] using this
      have h1 : y 1 = 0 := by
        have := congrArg Complex.im h; simpa [hZdef] using this
      simp [rad, h0, h1] at hy
    set N₁ : Set ℝ³ := Z ⁻¹' Complex.slitPlane with hN₁def
    set N₂ : Set ℝ³ := (fun y => -Z y) ⁻¹' Complex.slitPlane with hN₂def
    have hN₁ : IsOpen N₁ := Complex.isOpen_slitPlane.preimage hZ.continuous
    have hN₂ : IsOpen N₂ := Complex.isOpen_slitPlane.preimage hZ.continuous.neg
    have hcov : ∀ y : ℝ³, 0 < rad y → y ∈ N₁ ∨ y ∈ N₂ := by
      intro y hy
      by_cases h : Z y ∈ Complex.slitPlane
      · exact Or.inl h
      · right
        rw [Complex.mem_slitPlane_iff] at h
        push_neg at h
        have hre : (Z y).re ≠ 0 := fun hr =>
          hZne y hy (Complex.ext (by simp [hr]) (by simp [h.2]))
        show -Z y ∈ Complex.slitPlane
        rw [Complex.mem_slitPlane_iff]
        left
        simp only [Complex.neg_re]
        exact neg_pos.mpr (lt_of_le_of_ne h.1 hre)
    have hα₁ : ContDiffOn ℝ ∞ (fun y => Complex.arg (Z y)) N₁ := fun y hy =>
      ((harg _ hy).comp y hZ.contDiffAt).contDiffWithinAt
    have hα₂ : ContDiffOn ℝ ∞ (fun y => Complex.arg (-Z y) + Real.pi) N₂ := fun y hy =>
      (((harg _ hy).comp y hZ.neg.contDiffAt).add contDiffAt_const).contDiffWithinAt
    have hcomp : ∀ (α : ℝ³ → ℝ) (N : Set ℝ³), ContDiffOn ℝ ∞ α N →
        ContDiffOn ℝ ∞ (fun p : ℝ³ × ℂ => Φ (α p.1, p.2)) (N ×ˢ (univ : Set ℂ)) := by
      intro α N hα
      have hψ : ContDiffOn ℝ ∞ (fun p : ℝ³ × ℂ => (α p.1, p.2)) (N ×ˢ (univ : Set ℂ)) :=
        (hα.comp contDiff_fst.contDiffOn (fun p hp => hp.1)).prodMk contDiff_snd.contDiffOn
      exact hΦ.comp hψ (fun p hp => ⟨mem_univ _, hp.2⟩)
    apply contDiffOn_of_locally_contDiffOn
    rintro ⟨y', e⟩ ⟨hy', he⟩
    rcases hcov y' hy' with h | h
    · refine ⟨N₁ ×ˢ univ, hN₁.prod isOpen_univ, ⟨h, mem_univ _⟩, ?_⟩
      exact ((hcomp _ N₁ hα₁).mono (fun q hq => ⟨hq.2.1, hq.1.2⟩)).congr (fun q _ => rfl)
    · refine ⟨N₂ ×ˢ univ, hN₂.prod isOpen_univ, ⟨h, mem_univ _⟩, ?_⟩
      refine ((hcomp _ N₂ hα₂).mono (fun q hq => ⟨hq.2.1, hq.1.2⟩)).congr (fun q hq => ?_)
      exact hbr (Z q.1) (hZne q.1 hq.1.1) q.2

  have hp : ∀ i : Fin 3, ContDiff ℝ ∞ (fun x : ℝ³ => x i) := fun i =>
    (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).contDiff
  have hf : ContDiff ℝ ∞ (fun z : ℝ³ => z 0 ^ 2 + z 1 ^ 2) := ((hp 0).pow 2).add ((hp 1).pow 2)
  have hfy : (y 0 ^ 2 + y 1 ^ 2) ≠ 0 := (Real.sqrt_pos.mp hy).ne'
  have hrad : ContDiffAt ℝ ∞ rad y := hf.contDiffAt.sqrt hfy
  have hradc : Continuous rad := Real.continuous_sqrt.comp hf.continuous

  have hinv : ContDiffAt ℝ ∞ (fun z => (rad z)⁻¹) y := hrad.inv hy.ne'
  have hradV : ContDiff ℝ ∞ radVec := by
    unfold radVec
    exact ((hp 0).smul contDiff_const).add ((hp 1).smul contDiff_const)
  have hazV : ContDiff ℝ ∞ azVec := by
    unfold azVec
    exact ((hp 1).neg.smul contDiff_const).add ((hp 0).smul contDiff_const)
  have heR : ContDiffAt ℝ ∞ eR y := hinv.smul hradV.contDiffAt
  have heTh : ContDiffAt ℝ ∞ eTh y := hinv.smul hazV.contDiffAt

  have hY : ContDiffAt ℝ ∞ (fun z => Yph h (rad z) s + Y0) y := by
    unfold Yph
    exact (((hrad.rpow_const_of_ne hy.ne').smul contDiffAt_const).add contDiffAt_const).add
      contDiffAt_const
  have hζ : ContDiffAt ℝ ∞ (fun z => ptOf z s (Yph h (rad z) s + Y0)) y := by
    unfold ptOf
    exact hrad.prodMk ((hp 2).contDiffAt.prodMk (contDiffAt_const.prodMk hY))
  have hcAt : ContDiffAt ℝ ∞ c (ptOf y s (Yph h (rad y) s + Y0)) :=
    hc.contDiffAt (hU.mem_nhds hmem)
  have hcomp : ∀ i : Fin 3,
      ContDiffAt ℝ ∞ (fun z => c (ptOf z s (Yph h (rad z) s + Y0)) i) y := by
    intro i
    have h2 := (contDiffAt_pi.1 hcAt i).comp y hζ
    exact h2

  have hΦ : ContDiff ℝ ∞
      (fun p : ℝ × ℂ => (p.2 * Complex.exp (Complex.I * (n : ℂ) * (p.1 : ℂ))).re) :=
    Complex.reCLM.contDiff.comp (contDiff_snd.mul
      ((contDiff_const.mul (Complex.ofRealCLM.contDiff.comp contDiff_fst)).cexp))
  have hper : ∀ (θ : ℝ) (e : ℂ),
      (e * Complex.exp (Complex.I * (n : ℂ) * ((θ + 2 * Real.pi : ℝ) : ℂ))).re =
        (e * Complex.exp (Complex.I * (n : ℂ) * (θ : ℂ))).re := by
    intro θ e
    have hexp : Complex.I * (n : ℂ) * ((θ + 2 * Real.pi : ℝ) : ℂ) =
        Complex.I * (n : ℂ) * (θ : ℂ) + (n : ℂ) * (2 * Real.pi * Complex.I) := by
      push_cast; ring
    rw [hexp, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]
  have hT := hpc (fun p : ℝ × ℂ => (p.2 * Complex.exp (Complex.I * (n : ℂ) * (p.1 : ℂ))).re)
    hΦ hper
  have hopen : IsOpen ({z : ℝ³ | 0 < rad z} ×ˢ (univ : Set ℂ)) :=
    (isOpen_lt continuous_const hradc).prod isOpen_univ
  have hg : ∀ i : Fin 3, ContDiffAt ℝ ∞ (fun z => (c (ptOf z s (Yph h (rad z) s + Y0)) i *
      Complex.exp (Complex.I * (n : ℂ) * (thetaOf z : ℂ))).re) y := by
    intro i
    have h1 := hT.contDiffAt (hopen.mem_nhds
      (show (y, c (ptOf y s (Yph h (rad y) s + Y0)) i) ∈ {z : ℝ³ | 0 < rad z} ×ˢ (univ : Set ℂ)
        from ⟨hy, mem_univ _⟩))
    have h2 := h1.comp y (contDiffAt_id.prodMk (hcomp i))
    exact h2

  exact (((hg 0).smul heR).add ((hg 1).smul heTh)).add ((hg 2).smul contDiffAt_const)

theorem frame_lap_identity : ∀ (F : ℝ³ → ℝ³) (y : ℝ³), 0 < rad y → ContDiffAt ℝ 2 F y → Δ F y = fderiv ℝ (fun z => fderiv ℝ F z (eR z)) y (eR y) + fderiv ℝ (fun z => fderiv ℝ F z (eTh z)) y (eTh y) + (rad y)⁻¹ • fderiv ℝ F y (eR y) + fderiv ℝ (fun z => fderiv ℝ F z eZ) y eZ :=
by
  intro F y hy hF
  have hS : 0 < y 0 ^ 2 + y 1 ^ 2 := Real.sqrt_pos.mp hy
  have hr0 : rad y ≠ 0 := hy.ne'
  have hrr : y 0 ^ 2 + y 1 ^ 2 = rad y ^ 2 := (Real.sq_sqrt hS.le).symm
  have hq : (rad y)⁻¹ ^ 2 * (y 0 ^ 2 + y 1 ^ 2) = 1 := by
    rw [hrr, inv_pow, inv_mul_cancel₀ (pow_ne_zero 2 hr0)]
  have hcoord : ∀ (i : Fin 3) (z : ℝ³), DifferentiableAt ℝ (fun w : ℝ³ => w i) z := by
    intro i z
    have h0 : DifferentiableAt ℝ (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) i) z :=
      ContinuousLinearMap.differentiableAt _
    rwa [EuclideanSpace.coe_proj] at h0
  have hradD : DifferentiableAt ℝ rad y :=
    (((hcoord 0 y).pow 2).add ((hcoord 1 y).pow 2)).sqrt hS.ne'
  have hinv : DifferentiableAt ℝ (fun z : ℝ³ => (rad z)⁻¹) y := hradD.inv hr0
  have heR : DifferentiableAt ℝ eR y :=
    hinv.smul (((hcoord 0 y).smul_const _).add ((hcoord 1 y).smul_const _))
  have heTh : DifferentiableAt ℝ eTh y :=
    hinv.smul (((hcoord 1 y).neg.smul_const _).add ((hcoord 0 y).smul_const _))

  have hfr : ∀ v : ℝ³,
      fderiv ℝ eR y v = ((y 0 * v 1 - y 1 * v 0) * (rad y)⁻¹ ^ 2) • eTh y ∧
      fderiv ℝ eTh y v = (-((y 0 * v 1 - y 1 * v 0) * (rad y)⁻¹ ^ 2)) • eR y := by
    intro v
    have hy0 : y + (0:ℝ) • v = y := by simp
    have hγi : ∀ i : Fin 3, HasDerivAt (fun τ : ℝ => (y + τ • v) i) (v i) 0 := by
      intro i
      have e : (fun τ : ℝ => (y + τ • v) i) = fun τ => y i + τ * v i := by
        funext τ
        simp
      rw [e]
      simpa using ((hasDerivAt_id (0:ℝ)).mul_const (v i)).const_add (y i)
    have hγ : HasDerivAt (fun τ : ℝ => y + τ • v) v 0 := by
      simpa using ((hasDerivAt_id (0:ℝ)).smul_const v).const_add y
    have hρ : HasDerivAt (fun τ : ℝ => rad (y + τ • v)) ((y 0 * v 0 + y 1 * v 1) * (rad y)⁻¹) 0 := by
      have hf : HasDerivAt (fun τ : ℝ => (y + τ • v) 0 ^ 2 + (y + τ • v) 1 ^ 2)
          (2 * (y 0 * v 0 + y 1 * v 1)) 0 := by
        have := ((hγi 0).pow 2).add ((hγi 1).pow 2)
        refine this.congr_deriv ?_
        simp only [zero_smul, add_zero]
        push_cast
        ring
      have hne : (y + (0:ℝ) • v) 0 ^ 2 + (y + (0:ℝ) • v) 1 ^ 2 ≠ 0 := by
        rw [hy0]
        exact hS.ne'
      refine (hf.sqrt hne).congr_deriv ?_
      simp only [zero_smul, add_zero]
      show 2 * (y 0 * v 0 + y 1 * v 1) / (2 * rad y) = _
      field_simp
    have hρ0 : 0 < rad (y + (0:ℝ) • v) := by
      rw [hy0]
      exact hy
    have hρinv : HasDerivAt (fun τ : ℝ => (rad (y + τ • v))⁻¹)
        (-((y 0 * v 0 + y 1 * v 1) * (rad y)⁻¹) * (rad y)⁻¹ ^ 2) 0 := by
      refine (hρ.inv hρ0.ne').congr_deriv ?_
      simp only [zero_smul, add_zero]
      rw [div_eq_mul_inv, inv_pow]
    have heR' : HasDerivAt (fun τ : ℝ => eR (y + τ • v))
        (((y 0 * v 1 - y 1 * v 0) * (rad y)⁻¹ ^ 2) • eTh y) 0 := by
      have hrv : HasDerivAt (fun τ : ℝ => radVec (y + τ • v))
          (v 0 • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
            v 1 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) 0 :=
        ((hγi 0).smul_const _).add ((hγi 1).smul_const _)
      refine (hρinv.smul hrv).congr_deriv ?_
      simp only [zero_smul, add_zero]
      refine PiLp.ext (fun i => ?_)
      fin_cases i
      · simp [radVec, eTh, azVec]
        linear_combination (-((rad y)⁻¹ * v 0)) * hq
      · simp [radVec, eTh, azVec]
        linear_combination (-((rad y)⁻¹ * v 1)) * hq
      · simp [radVec, eTh, azVec]
    have heTh' : HasDerivAt (fun τ : ℝ => eTh (y + τ • v))
        ((-((y 0 * v 1 - y 1 * v 0) * (rad y)⁻¹ ^ 2)) • eR y) 0 := by
      have hav : HasDerivAt (fun τ : ℝ => azVec (y + τ • v))
          ((-(v 1)) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
            v 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) 0 :=
        ((hγi 1).neg.smul_const _).add ((hγi 0).smul_const _)
      refine (hρinv.smul hav).congr_deriv ?_
      simp only [zero_smul, add_zero]
      refine PiLp.ext (fun i => ?_)
      fin_cases i
      · simp [radVec, eR, azVec]
        linear_combination ((rad y)⁻¹ * v 1) * hq
      · simp [radVec, eR, azVec]
        linear_combination (-((rad y)⁻¹ * v 0)) * hq
      · simp [radVec, eR, azVec]
    have heR'' : HasDerivAt (eR ∘ fun τ : ℝ => y + τ • v) _ 0 := heR'
    have heTh'' : HasDerivAt (eTh ∘ fun τ : ℝ => y + τ • v) _ 0 := heTh'
    have h1 := heR.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hγ (by simp)
    have h2 := heTh.hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hγ (by simp)
    exact ⟨h1.unique heR'', h2.unique heTh''⟩
  have hc1 : y 0 * eR y 1 - y 1 * eR y 0 = 0 := by
    simp [eR, radVec]
    ring
  have hc2 : (y 0 * eTh y 1 - y 1 * eTh y 0) * (rad y)⁻¹ ^ 2 = (rad y)⁻¹ := by
    simp [eTh, azVec]
    linear_combination (rad y)⁻¹ * hq

  have hon : Orthonormal ℝ ![eR y, eTh y, eZ] := by
    rw [orthonormal_iff_ite]
    intro i j
    rw [PiLp.inner_apply, Fin.sum_univ_three]
    simp only [RCLike.inner_apply, conj_trivial]
    fin_cases i <;> fin_cases j <;>
      simp [eR, eTh, eZ, radVec, azVec] <;>
      first
      | ring1
      | linear_combination hq
  have hsp : ⊤ ≤ Submodule.span ℝ (Set.range ![eR y, eTh y, eZ]) :=
    (hon.linearIndependent.span_eq_top_of_card_eq_finrank (by simp)).ge
  have hlap : Δ F y = fderiv ℝ (fderiv ℝ F) y (eR y) (eR y) +
      fderiv ℝ (fderiv ℝ F) y (eTh y) (eTh y) + fderiv ℝ (fderiv ℝ F) y eZ eZ := by
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis F (OrthonormalBasis.mk hon hsp)]
    simp only [OrthonormalBasis.coe_mk, Fin.sum_univ_three, iteratedFDeriv_two_apply,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two,
      Matrix.tail_cons]

  have hc : DifferentiableAt ℝ (fderiv ℝ F) y :=
    (hF.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
  have hprod : ∀ (u : ℝ³ → ℝ³), DifferentiableAt ℝ u y → ∀ w : ℝ³,
      fderiv ℝ (fun z => fderiv ℝ F z (u z)) y w =
        fderiv ℝ F y (fderiv ℝ u y w) + fderiv ℝ (fderiv ℝ F) y w (u y) := by
    intro u hu w
    rw [fderiv_clm_apply hc hu]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.coe_comp', Function.comp_apply,
      ContinuousLinearMap.flip_apply]
  have hR : fderiv ℝ (fun z => fderiv ℝ F z (eR z)) y (eR y) =
      fderiv ℝ (fderiv ℝ F) y (eR y) (eR y) := by
    rw [hprod eR heR, (hfr (eR y)).1, hc1, zero_mul, zero_smul, map_zero, zero_add]
  have hT : fderiv ℝ (fun z => fderiv ℝ F z (eTh z)) y (eTh y) =
      (-(rad y)⁻¹) • fderiv ℝ F y (eR y) + fderiv ℝ (fderiv ℝ F) y (eTh y) (eTh y) := by
    rw [hprod eTh heTh, (hfr (eTh y)).2, hc2, map_smul]
  have hZ : fderiv ℝ (fun z => fderiv ℝ F z eZ) y eZ = fderiv ℝ (fderiv ℝ F) y eZ eZ := by
    have h := hprod (fun _ => eZ) (differentiableAt_const _) eZ
    simp only [fderiv_const_apply, ContinuousLinearMap.zero_apply, map_zero, zero_add] at h
    exact h
  rw [hlap, hR, hT, hZ]
  module

theorem mode5_lap1 : ∀ (h : ℝ) (n : ℤ) (a : Cyl → (Fin 3 → ℂ)) (Y0 : ℝ × ℝ) (U : Set Cyl) (y : ℝ³) (s : ℝ), IsOpen U → (∀ η ∈ U, 0 < η.1) → ContDiffOn ℝ ∞ a U → 0 < rad y → ptOf y s (Yph h (rad y) s + Y0) ∈ U → Δ (fun z => mvec5 h n a Y0 z s) y = mvec5 h n (fun η => ![mlapC h n (fun η' => a η' 0) η - a η 0 / (η.1 : ℂ) ^ 2 - 2 * (Complex.I * (n : ℂ) / (η.1 : ℂ)) * a η 1 / (η.1 : ℂ), mlapC h n (fun η' => a η' 1) η - a η 1 / (η.1 : ℂ) ^ 2 + 2 * (Complex.I * (n : ℂ) / (η.1 : ℂ)) * a η 0 / (η.1 : ℂ), mlapC h n (fun η' => a η' 2) η]) Y0 y s :=
by
  intro h n a Y0 U y s hU hUpos ha hy hζ
  have hp0 : ContDiffOn ℝ ∞ (fun _ : Cyl => (0 : ℂ)) U := contDiffOn_const

  have hai : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => a η i) U := contDiffOn_pi.1 ha
  have hfd : ∀ (f : Cyl → ℂ), ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ (fderiv ℝ f) U := fun f hf =>
    hf.fderiv_of_isOpen hU (le_of_eq ENat.coe_top_add_one)
  have hvec : ContDiffOn ℝ ∞
      (fun ξ : Cyl => (((1:ℝ), (0:ℝ), (0:ℝ), (drx h * ξ.1 ^ (drx h - 1)) • vrv) : Cyl)) U := by
    have h1 : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1 ^ (drx h - 1)) U :=
      contDiffOn_fst.rpow_const_of_ne (fun ξ hξ => (hUpos ξ hξ).ne')
    exact contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk
      ((contDiffOn_const.mul h1).smul contDiffOn_const)))
  have hR : ContDiffOn ℝ ∞ (fun η i => dR h (fun η' => a η' i) η) U := by
    refine contDiffOn_pi.2 (fun i => ?_)
    show ContDiffOn ℝ ∞ (fun ξ => fderiv ℝ (fun η' => a η' i) ξ
      (1, 0, 0, (drx h * ξ.1 ^ (drx h - 1)) • vrv)) U
    exact (hfd _ (hai i)).clm_apply hvec
  have hZ : ContDiffOn ℝ ∞ (fun η i => dZ (fun η' => a η' i) η) U := by
    refine contDiffOn_pi.2 (fun i => ?_)
    show ContDiffOn ℝ ∞ (fun ξ => fderiv ℝ (fun η' => a η' i) ξ (0, 1, 0, 0)) U
    exact (hfd _ (hai i)).clm_apply contDiffOn_const
  have hinv : ContDiffOn ℝ ∞ (fun ξ : Cyl => ((ξ.1 : ℂ))⁻¹) U :=
    (Complex.ofRealCLM.contDiff.comp contDiff_fst).contDiffOn.inv
      (fun ξ hξ => by simpa using (hUpos ξ hξ).ne')
  have hT : ContDiffOn ℝ ∞ (mthC n a) U := by
    have hk : ContDiffOn ℝ ∞ (fun ξ : Cyl => Complex.I * (n : ℂ) / (ξ.1 : ℂ)) U := by
      simp only [div_eq_mul_inv]
      exact contDiffOn_const.mul hinv
    have hk2 : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun ξ : Cyl => a ξ i / (ξ.1 : ℂ)) U := by
      intro i
      simp only [div_eq_mul_inv]
      exact (hai i).mul hinv
    refine contDiffOn_pi.2 (fun i => ?_)
    fin_cases i
    · show ContDiffOn ℝ ∞ (fun ξ => Complex.I * (n : ℂ) / (ξ.1 : ℂ) * a ξ 0 - a ξ 1 / (ξ.1 : ℂ)) U
      exact (hk.mul (hai 0)).sub (hk2 1)
    · show ContDiffOn ℝ ∞ (fun ξ => Complex.I * (n : ℂ) / (ξ.1 : ℂ) * a ξ 1 + a ξ 0 / (ξ.1 : ℂ)) U
      exact (hk.mul (hai 1)).add (hk2 0)
    · show ContDiffOn ℝ ∞ (fun ξ => Complex.I * (n : ℂ) / (ξ.1 : ℂ) * a ξ 2) U
      exact hk.mul (hai 2)

  have hrc : Continuous rad := by
    unfold rad
    fun_prop
  have hN : {z : ℝ³ | 0 < rad z ∧ ptOf z s (Yph h (rad z) s + Y0) ∈ U} ∈ nhds y := by
    have h1 : {z : ℝ³ | 0 < rad z} ∈ nhds y := (isOpen_lt continuous_const hrc).mem_nhds hy
    have hφ : ContinuousAt (fun z : ℝ³ => ptOf z s (Yph h (rad z) s + Y0)) y := by
      unfold ptOf Yph
      have hr : ContinuousAt (fun z : ℝ³ => rad z ^ drx h) y :=
        hrc.continuousAt.rpow_const (Or.inl hy.ne')
      have h2 : Continuous (fun z : ℝ³ => z 2) := by fun_prop
      exact hrc.continuousAt.prodMk (h2.continuousAt.prodMk (continuousAt_const.prodMk
        (((hr.smul continuousAt_const).add continuousAt_const).add continuousAt_const)))
    have h2 : (fun z : ℝ³ => ptOf z s (Yph h (rad z) s + Y0)) ⁻¹' U ∈ nhds y :=
      hφ.preimage_mem_nhds (hU.mem_nhds hζ)
    exact Filter.inter_mem h1 h2

  have hF2 : ContDiffAt ℝ 2 (fun z => mvec5 h n a Y0 z s) y :=
    (mode5_smooth h n a Y0 U y s hU ha hy hζ).of_le (by norm_num)
  rw [frame_lap_identity _ y hy hF2]
  have evR : (fun z => fderiv ℝ (fun z => mvec5 h n a Y0 z s) z (eR z)) =ᶠ[nhds y]
      (fun z => mvec5 h n (fun η i => dR h (fun η' => a η' i) η) Y0 z s) :=
    Filter.eventuallyEq_of_mem hN (fun z hz =>
      (mode5_jet h n a (fun _ : Cyl => (0 : ℂ)) Y0 U z s hU hUpos ha hp0 hz.1 hz.2).2.2.1)
  have evT : (fun z => fderiv ℝ (fun z => mvec5 h n a Y0 z s) z (eTh z)) =ᶠ[nhds y]
      (fun z => mvec5 h n (mthC n a) Y0 z s) :=
    Filter.eventuallyEq_of_mem hN (fun z hz =>
      (mode5_jet h n a (fun _ : Cyl => (0 : ℂ)) Y0 U z s hU hUpos ha hp0 hz.1 hz.2).2.2.2.1)
  have evZ : (fun z => fderiv ℝ (fun z => mvec5 h n a Y0 z s) z eZ) =ᶠ[nhds y]
      (fun z => mvec5 h n (fun η i => dZ (fun η' => a η' i) η) Y0 z s) :=
    Filter.eventuallyEq_of_mem hN (fun z hz =>
      (mode5_jet h n a (fun _ : Cyl => (0 : ℂ)) Y0 U z s hU hUpos ha hp0 hz.1 hz.2).2.2.2.2.1)
  rw [evR.fderiv_eq, evT.fderiv_eq, evZ.fderiv_eq,
    (mode5_jet h n _ (fun _ : Cyl => (0 : ℂ)) Y0 U y s hU hUpos hR hp0 hy hζ).2.2.1,
    (mode5_jet h n _ (fun _ : Cyl => (0 : ℂ)) Y0 U y s hU hUpos hT hp0 hy hζ).2.2.2.1,
    (mode5_jet h n _ (fun _ : Cyl => (0 : ℂ)) Y0 U y s hU hUpos hZ hp0 hy hζ).2.2.2.2.1,
    (mode5_jet h n a (fun _ : Cyl => (0 : ℂ)) Y0 U y s hU hUpos ha hp0 hy hζ).2.2.1]

  have hcomp : ∀ η : Cyl,
      (mlapC h n (fun η' => a η' 0) η - a η 0 / (η.1 : ℂ) ^ 2
          - 2 * (Complex.I * (n : ℂ) / (η.1 : ℂ)) * a η 1 / (η.1 : ℂ) =
        dR h (dR h (fun η' => a η' 0)) η
          + (Complex.I * (n : ℂ) / (η.1 : ℂ) * (Complex.I * (n : ℂ) / (η.1 : ℂ) * a η 0 - a η 1 / (η.1 : ℂ))
            - (Complex.I * (n : ℂ) / (η.1 : ℂ) * a η 1 + a η 0 / (η.1 : ℂ)) / (η.1 : ℂ))
          + ((η.1 : ℂ))⁻¹ * dR h (fun η' => a η' 0) η + dZ (dZ (fun η' => a η' 0)) η) ∧
      (mlapC h n (fun η' => a η' 1) η - a η 1 / (η.1 : ℂ) ^ 2
          + 2 * (Complex.I * (n : ℂ) / (η.1 : ℂ)) * a η 0 / (η.1 : ℂ) =
        dR h (dR h (fun η' => a η' 1)) η
          + (Complex.I * (n : ℂ) / (η.1 : ℂ) * (Complex.I * (n : ℂ) / (η.1 : ℂ) * a η 1 + a η 0 / (η.1 : ℂ))
            + (Complex.I * (n : ℂ) / (η.1 : ℂ) * a η 0 - a η 1 / (η.1 : ℂ)) / (η.1 : ℂ))
          + ((η.1 : ℂ))⁻¹ * dR h (fun η' => a η' 1) η + dZ (dZ (fun η' => a η' 1)) η) ∧
      (mlapC h n (fun η' => a η' 2) η =
        dR h (dR h (fun η' => a η' 2)) η
          + Complex.I * (n : ℂ) / (η.1 : ℂ) * (Complex.I * (n : ℂ) / (η.1 : ℂ) * a η 2)
          + ((η.1 : ℂ))⁻¹ * dR h (fun η' => a η' 2) η + dZ (dZ (fun η' => a η' 2)) η) := by
    intro η
    refine ⟨?_, ?_, ?_⟩
    · unfold mlapC
      linear_combination (-((n : ℂ) ^ 2 / (η.1 : ℂ) ^ 2 * a η 0)) * Complex.I_sq
    · unfold mlapC
      linear_combination (-((n : ℂ) ^ 2 / (η.1 : ℂ) ^ 2 * a η 1)) * Complex.I_sq
    · unfold mlapC
      linear_combination (-((n : ℂ) ^ 2 / (η.1 : ℂ) ^ 2 * a η 2)) * Complex.I_sq
  have hlin : ∀ (c1 c2 c3 c4 c : Cyl → (Fin 3 → ℂ)),
      (∀ i : Fin 3, c (ptOf y s (Yph h (rad y) s + Y0)) i =
        c1 (ptOf y s (Yph h (rad y) s + Y0)) i + c2 (ptOf y s (Yph h (rad y) s + Y0)) i
          + ((rad y : ℂ))⁻¹ * c3 (ptOf y s (Yph h (rad y) s + Y0)) i
          + c4 (ptOf y s (Yph h (rad y) s + Y0)) i) →
      mvec5 h n c1 Y0 y s + mvec5 h n c2 Y0 y s + (rad y)⁻¹ • mvec5 h n c3 Y0 y s
        + mvec5 h n c4 Y0 y s = mvec5 h n c Y0 y s := by
    intro c1 c2 c3 c4 c hc
    have hre : ∀ i : Fin 3, (c (ptOf y s (Yph h (rad y) s + Y0)) i *
        Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re =
        (c1 (ptOf y s (Yph h (rad y) s + Y0)) i * Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re
        + (c2 (ptOf y s (Yph h (rad y) s + Y0)) i * Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re
        + (rad y)⁻¹ *
          (c3 (ptOf y s (Yph h (rad y) s + Y0)) i * Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re
        + (c4 (ptOf y s (Yph h (rad y) s + Y0)) i * Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re := by
      intro i
      rw [hc i]
      simp only [add_mul, Complex.add_re, mul_assoc, ← Complex.ofReal_inv, Complex.re_ofReal_mul]
    simp only [mvec5, cyl2cart, hre]
    module
  refine hlin _ _ _ _ _ (fun i => ?_)
  fin_cases i
  · exact (hcomp _).1
  · exact (hcomp _).2.1
  · exact (hcomp _).2.2

theorem mode5_grad1 : ∀ (h : ℝ) (n : ℤ) (p : Cyl → ℂ) (Y0 : ℝ × ℝ) (U : Set Cyl) (y : ℝ³) (s : ℝ), IsOpen U → (∀ η ∈ U, 0 < η.1) → ContDiffOn ℝ ∞ p U → 0 < rad y → ptOf y s (Yph h (rad y) s + Y0) ∈ U → gradient (fun z => msc5 h n p Y0 z s) y = mvec5 h n (fun η => ![dR h p η, Complex.I * (n : ℂ) / (η.1 : ℂ) * p η, dZ p η]) Y0 y s :=
by
  intro h n p Y0 U y s hU hUpos hp hr hζ
  obtain ⟨-, -, -, -, -, -, h7, h8, h9⟩ :=
    mode5_jet h n (fun _ _ => (0 : ℂ)) p Y0 U y s hU hUpos contDiffOn_const hp hr hζ
  have hinner : ∀ v : ℝ³, inner ℝ (gradient (fun z => msc5 h n p Y0 z s) y) v =
      fderiv ℝ (fun z => msc5 h n p Y0 z s) y v := by
    intro v
    unfold gradient
    exact InnerProductSpace.toDual_symm_apply
  have hrec : ∀ v : ℝ³, v = cyl2cart y ![inner ℝ v (eR y), inner ℝ v (eTh y), inner ℝ v eZ] := by
    intro v
    have hr2 : rad y ^ 2 = y 0 ^ 2 + y 1 ^ 2 := Real.sq_sqrt (by positivity)
    have hne : rad y ≠ 0 := hr.ne'
    have hs : (rad y)⁻¹ ^ 2 * (y 0 ^ 2 + y 1 ^ 2) = 1 := by
      rw [← hr2]; field_simp
    ext j
    fin_cases j <;>
      simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three] <;>
      first
      | linear_combination (v 0) * hs
      | linear_combination (v 1) * hs
      | linear_combination (-(v 0)) * hs
      | linear_combination (-(v 1)) * hs
  rw [hrec (gradient (fun z => msc5 h n p Y0 z s) y), hinner, hinner, hinner, h7, h8, h9]
  simp only [mvec5, msc5]
  congr 1
  funext i
  fin_cases i <;> rfl

theorem mode5_stretch1 : ∀ (h : ℝ) (n : ℤ) (a : Cyl → (Fin 3 → ℂ)) (ub : Cyl → (Fin 3 → ℝ)) (Y0 : ℝ × ℝ) (U : Set Cyl) (y : ℝ³) (s : ℝ), IsOpen U → (∀ η ∈ U, 0 < η.1) → (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => ub η i) U) → 0 < rad y → ptOf y s (Yph h (rad y) s + Y0) ∈ U → fderiv ℝ (fun z => cyl2cart z (fun i => ub (ptOf z s (Yph h (rad z) s + Y0)) i)) y (mvec5 h n a Y0 y s) = mvec5 h n (fun η => ![a η 0 * ((dR h (fun η' => ub η' 0) η : ℝ) : ℂ) + a η 2 * ((dZ (fun η' => ub η' 0) η : ℝ) : ℂ) - ((ub η 1 : ℝ) : ℂ) * a η 1 / (η.1 : ℂ), a η 0 * ((dR h (fun η' => ub η' 1) η : ℝ) : ℂ) + a η 2 * ((dZ (fun η' => ub η' 1) η : ℝ) : ℂ) + ((ub η 0 : ℝ) : ℂ) * a η 1 / (η.1 : ℂ), a η 0 * ((dR h (fun η' => ub η' 2) η : ℝ) : ℂ) + a η 2 * ((dZ (fun η' => ub η' 2) η : ℝ) : ℂ)]) Y0 y s :=
by
  intro h n a ub Y0 U y s hU hUpos hub hr hζ
  have hũs : ContDiffOn ℝ ∞ (fun η (i : Fin 3) => ((ub η i : ℝ) : ℂ)) U := by
    refine contDiffOn_pi.2 (fun i => ?_)
    exact Complex.ofRealCLM.contDiff.comp_contDiffOn (hub i)
  have hbase : (fun z => cyl2cart z (fun i => ub (ptOf z s (Yph h (rad z) s + Y0)) i)) =
      (fun z => mvec5 h 0 (fun η (i : Fin 3) => ((ub η i : ℝ) : ℂ)) Y0 z s) := by
    funext z
    simp [mvec5]
  rw [hbase]
  obtain ⟨-, -, J3, J4, J5, -⟩ := mode5_jet h 0 (fun η (i : Fin 3) => ((ub η i : ℝ) : ℂ))
    (fun _ => (0 : ℂ)) Y0 U y s hU hUpos hũs contDiffOn_const hr hζ
  have hdiff : ∀ i : Fin 3, DifferentiableAt ℝ (fun η => ub η i) (ptOf y s (Yph h (rad y) s + Y0)) :=
    fun i => ((hub i).differentiableOn (by simp)).differentiableAt (hU.mem_nhds hζ)
  have hfd : ∀ i : Fin 3, fderiv ℝ (fun η => ((ub η i : ℝ) : ℂ)) (ptOf y s (Yph h (rad y) s + Y0)) =
      Complex.ofRealCLM.comp (fderiv ℝ (fun η => ub η i) (ptOf y s (Yph h (rad y) s + Y0))) :=
    fun i => ((Complex.ofRealCLM.hasFDerivAt).comp _ (hdiff i).hasFDerivAt).fderiv
  have hdR : ∀ i : Fin 3, dR h (fun η => ((ub η i : ℝ) : ℂ)) (ptOf y s (Yph h (rad y) s + Y0)) =
      ((dR h (fun η => ub η i) (ptOf y s (Yph h (rad y) s + Y0)) : ℝ) : ℂ) := by
    intro i
    simp only [dR]
    rw [hfd i]
    rfl
  have hdZ : ∀ i : Fin 3, dZ (fun η => ((ub η i : ℝ) : ℂ)) (ptOf y s (Yph h (rad y) s + Y0)) =
      ((dZ (fun η => ub η i) (ptOf y s (Yph h (rad y) s + Y0)) : ℝ) : ℂ) := by
    intro i
    simp only [dZ]
    rw [hfd i]
    rfl
  have hW : mvec5 h n a Y0 y s =
      (a (ptOf y s (Yph h (rad y) s + Y0)) 0 * Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re • eR y
      + (a (ptOf y s (Yph h (rad y) s + Y0)) 1 * Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re • eTh y
      + (a (ptOf y s (Yph h (rad y) s + Y0)) 2 * Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))).re • eZ :=
    rfl
  rw [hW, map_add, map_add, map_smul, map_smul, map_smul, J3, J4, J5]
  simp only [mvec5, cyl2cart, mthC, hdR, hdZ, Int.cast_zero, mul_zero, zero_mul, Complex.exp_zero, mul_one,
    zero_div, zero_sub, zero_add, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.head_cons, Matrix.tail_cons, Complex.mul_re, Complex.mul_im, Complex.add_re, Complex.add_im,
    Complex.sub_re, Complex.sub_im, Complex.neg_re, Complex.neg_im, Complex.div_ofReal_re,
    Complex.div_ofReal_im, Complex.ofReal_re, Complex.ofReal_im, Complex.zero_re, Complex.zero_im]
  module

theorem mode5_linres : ∀ {ι : Type} (B : BG) (K : Finset ι) (n : ι → ℤ) (a : ι → Cyl → (Fin 3 → ℂ)) (p : ι → Cyl → ℂ) (Y0 : ℝ × ℝ) (U : Set Cyl) (O : Set (ℝ³ × ℝ)) (x : ℝ³) (t : ℝ), IsOpen U → IsOpen O → (∀ η ∈ U, 0 < η.1) → (x, t) ∈ O → (∀ y s, (y, s) ∈ O → 0 < rad y ∧ ptOf y s (Yph B.h (rad y) s + Y0) ∈ U ∧ uB B y s = cyl2cart y (fun i => ubase B (ptOf y s (Yph B.h (rad y) s + Y0)) i)) → (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => ubase B η i) U) → (∀ k ∈ K, ContDiffOn ℝ ∞ (a k) U ∧ ContDiffOn ℝ ∞ (p k) U) → deriv (fun s => ∑ k ∈ K, mvec5 B.h (n k) (a k) Y0 x s) t - Δ (fun y => ∑ k ∈ K, mvec5 B.h (n k) (a k) Y0 y t) x + gradient (fun y => ∑ k ∈ K, msc5 B.h (n k) (p k) Y0 y t) x + fderiv ℝ (fun y => ∑ k ∈ K, mvec5 B.h (n k) (a k) Y0 y t) x (uB B x t) + fderiv ℝ (fun y => uB B y t) x (∑ k ∈ K, mvec5 B.h (n k) (a k) Y0 x t) = ∑ k ∈ K, mvec5 B.h (n k) (mresC B (n k) (a k) (p k)) Y0 x t :=
by
  intro ι B K n a p Y0 U O x t hU hO hUpos hxO hOm hub hap
  obtain ⟨hrx, hζ, huBx⟩ := hOm x t hxO
  have hJ := fun k (hk : k ∈ K) =>
    mode5_jet B.h (n k) (a k) (p k) Y0 U x t hU hUpos (hap k hk).1 (hap k hk).2 hrx hζ

  have hT : deriv (fun s => ∑ k ∈ K, mvec5 B.h (n k) (a k) Y0 x s) t =
      ∑ k ∈ K, mvec5 B.h (n k) (fun η i => dT (fun η' => a k η' i) η) Y0 x t := by
    apply HasDerivAt.deriv
    exact HasDerivAt.fun_sum (fun k hk => (hJ k hk).2.2.2.2.2.1)

  have hlapsum : ∀ (S : Finset ι) (f : ι → ℝ³ → ℝ³), (∀ k ∈ S, ContDiffAt ℝ 2 (f k) x) →
      Δ (fun y => ∑ k ∈ S, f k y) x = ∑ k ∈ S, Δ (f k) x := by
    classical
    intro S f
    induction S using Finset.induction_on with
    | empty =>
      intro _
      simp only [Finset.sum_empty]
      rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_stdOrthonormalBasis]
      simp [iteratedFDeriv_fun_zero]
    | @insert j S hj ih =>
      intro hf
      have e : (fun y => ∑ k ∈ insert j S, f k y) = f j + (fun y => ∑ k ∈ S, f k y) := by
        funext y
        simp only [Finset.sum_insert hj, Pi.add_apply]
      rw [e, ContDiffAt.laplacian_add (hf j (Finset.mem_insert_self j S))
        (ContDiffAt.sum (fun k hk => hf k (Finset.mem_insert_of_mem hk))),
        ih (fun k hk => hf k (Finset.mem_insert_of_mem hk)), Finset.sum_insert hj]
  have hC2 : ∀ k ∈ K, ContDiffAt ℝ 2 (fun z => mvec5 B.h (n k) (a k) Y0 z t) x := fun k hk =>
    (mode5_smooth B.h (n k) (a k) Y0 U x t hU (hap k hk).1 hrx hζ).of_le (by norm_num)
  have hL : Δ (fun y => ∑ k ∈ K, mvec5 B.h (n k) (a k) Y0 y t) x =
      ∑ k ∈ K, Δ (fun z => mvec5 B.h (n k) (a k) Y0 z t) x :=
    hlapsum K (fun k z => mvec5 B.h (n k) (a k) Y0 z t) hC2

  have hG : gradient (fun y => ∑ k ∈ K, msc5 B.h (n k) (p k) Y0 y t) x =
      ∑ k ∈ K, gradient (fun z => msc5 B.h (n k) (p k) Y0 z t) x := by
    unfold gradient
    rw [fderiv_fun_sum (fun k hk => (hJ k hk).2.1), map_sum]

  have hCv : fderiv ℝ (fun y => ∑ k ∈ K, mvec5 B.h (n k) (a k) Y0 y t) x (uB B x t) =
      ∑ k ∈ K, fderiv ℝ (fun z => mvec5 B.h (n k) (a k) Y0 z t) x
        (cyl2cart x (fun i => ubase B (ptOf x t (Yph B.h (rad x) t + Y0)) i)) := by
    rw [fderiv_fun_sum (fun k hk => (hJ k hk).1), ContinuousLinearMap.sum_apply, huBx]

  have hsl : {z : ℝ³ | (z, t) ∈ O} ∈ nhds x :=
    (hO.preimage (Continuous.prodMk continuous_id
      (continuous_const : Continuous fun _ : ℝ³ => t))).mem_nhds hxO
  have hev : (fun y => uB B y t) =ᶠ[nhds x]
      (fun z => cyl2cart z (fun i => ubase B (ptOf z t (Yph B.h (rad z) t + Y0)) i)) :=
    Filter.eventuallyEq_of_mem hsl (fun z hz => (hOm z t hz).2.2)
  have hSt : fderiv ℝ (fun y => uB B y t) x (∑ k ∈ K, mvec5 B.h (n k) (a k) Y0 x t) =
      ∑ k ∈ K, fderiv ℝ (fun z => cyl2cart z (fun i => ubase B (ptOf z t (Yph B.h (rad z) t + Y0)) i)) x
        (mvec5 B.h (n k) (a k) Y0 x t) := by
    rw [hev.fderiv_eq, map_sum]

  have hsmul : ∀ (m : ℤ) (r : ℝ) (c : Cyl → (Fin 3 → ℂ)),
      r • mvec5 B.h m c Y0 x t = mvec5 B.h m (fun η i => (r : ℂ) * c η i) Y0 x t := by
    intro m r c
    simp only [mvec5, cyl2cart, smul_add, smul_smul, mul_assoc, Complex.re_ofReal_mul]
  have hlin : ∀ (m : ℤ) (c1 c2 c3 c4 c5 c6 c7 c : Cyl → (Fin 3 → ℂ)),
      (∀ i : Fin 3, c1 (ptOf x t (Yph B.h (rad x) t + Y0)) i - c2 (ptOf x t (Yph B.h (rad x) t + Y0)) i
        + c3 (ptOf x t (Yph B.h (rad x) t + Y0)) i + (c4 (ptOf x t (Yph B.h (rad x) t + Y0)) i
        + c5 (ptOf x t (Yph B.h (rad x) t + Y0)) i + c6 (ptOf x t (Yph B.h (rad x) t + Y0)) i)
        + c7 (ptOf x t (Yph B.h (rad x) t + Y0)) i = c (ptOf x t (Yph B.h (rad x) t + Y0)) i) →
      mvec5 B.h m c1 Y0 x t - mvec5 B.h m c2 Y0 x t + mvec5 B.h m c3 Y0 x t
        + (mvec5 B.h m c4 Y0 x t + mvec5 B.h m c5 Y0 x t + mvec5 B.h m c6 Y0 x t)
        + mvec5 B.h m c7 Y0 x t = mvec5 B.h m c Y0 x t := by
    intro m c1 c2 c3 c4 c5 c6 c7 c hc
    have hre : ∀ i : Fin 3, (c (ptOf x t (Yph B.h (rad x) t + Y0)) i *
        Complex.exp (Complex.I * (m : ℂ) * (thetaOf x : ℂ))).re =
        (c1 (ptOf x t (Yph B.h (rad x) t + Y0)) i * Complex.exp (Complex.I * (m : ℂ) * (thetaOf x : ℂ))).re
        - (c2 (ptOf x t (Yph B.h (rad x) t + Y0)) i * Complex.exp (Complex.I * (m : ℂ) * (thetaOf x : ℂ))).re
        + (c3 (ptOf x t (Yph B.h (rad x) t + Y0)) i * Complex.exp (Complex.I * (m : ℂ) * (thetaOf x : ℂ))).re
        + ((c4 (ptOf x t (Yph B.h (rad x) t + Y0)) i * Complex.exp (Complex.I * (m : ℂ) * (thetaOf x : ℂ))).re
        + (c5 (ptOf x t (Yph B.h (rad x) t + Y0)) i * Complex.exp (Complex.I * (m : ℂ) * (thetaOf x : ℂ))).re
        + (c6 (ptOf x t (Yph B.h (rad x) t + Y0)) i * Complex.exp (Complex.I * (m : ℂ) * (thetaOf x : ℂ))).re)
        + (c7 (ptOf x t (Yph B.h (rad x) t + Y0)) i * Complex.exp (Complex.I * (m : ℂ) * (thetaOf x : ℂ))).re := by
      intro i
      rw [← hc i]
      simp only [add_mul, sub_mul, Complex.add_re, Complex.sub_re]
    simp only [mvec5, cyl2cart, hre]
    module
  rw [hT, hL, hG, hCv, hSt, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib,
    ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl (fun k hk => ?_)
  obtain ⟨-, -, hJR, hJT, hJZ, -, -, -, -⟩ := hJ k hk
  have hconv : fderiv ℝ (fun z => mvec5 B.h (n k) (a k) Y0 z t) x
      (cyl2cart x (fun i => ubase B (ptOf x t (Yph B.h (rad x) t + Y0)) i)) =
      ubase B (ptOf x t (Yph B.h (rad x) t + Y0)) 0 •
          mvec5 B.h (n k) (fun η i => dR B.h (fun η' => a k η' i) η) Y0 x t
        + ubase B (ptOf x t (Yph B.h (rad x) t + Y0)) 1 • mvec5 B.h (n k) (mthC (n k) (a k)) Y0 x t
        + ubase B (ptOf x t (Yph B.h (rad x) t + Y0)) 2 •
          mvec5 B.h (n k) (fun η i => dZ (fun η' => a k η' i) η) Y0 x t := by
    unfold cyl2cart
    rw [map_add, map_add, map_smul, map_smul, map_smul, hJR, hJT, hJZ]
  rw [hconv, hsmul, hsmul, hsmul,
    mode5_lap1 B.h (n k) (a k) Y0 U x t hU hUpos (hap k hk).1 hrx hζ,
    mode5_grad1 B.h (n k) (p k) Y0 U x t hU hUpos (hap k hk).2 hrx hζ,
    mode5_stretch1 B.h (n k) (a k) (ubase B) Y0 U x t hU hUpos hub hrx hζ]
  exact hlin (n k) _ _ _ _ _ _ _ _ (fun i => by fin_cases i <;> simp [mresC, mthC] <;> ring)

theorem ubase5_axisym : ∀ (B : BG), B.ok → (∀ (y : ℝ³) (s : ℝ) (Y0 : ℝ × ℝ), (y, s) ∈ simDomain B.h B.qB → 0 < rad y → uB B y s = cyl2cart y (fun i => ubase B (ptOf y s Y0) i)) ∧ ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => ubase B η i) {η : Cyl | 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < B.qB} :=
by
  intro B hok
  obtain ⟨hS, hBP⟩ := hok
  unfold BackgroundProps at hBP
  obtain ⟨-, -, -, hBsm, -, h6, -⟩ := hBP

  have frame : ∀ r z : ℝ, 0 < r → (rotPt r 0 z) 0 = r ∧ (rotPt r 0 z) 1 = 0 ∧ (rotPt r 0 z) 2 = z ∧
      rad (rotPt r 0 z) = r ∧
      eR (rotPt r 0 z) = EuclideanSpace.single (0 : Fin 3) (1 : ℝ) ∧
      eTh (rotPt r 0 z) = EuclideanSpace.single (1 : Fin 3) (1 : ℝ) := by
    intro r z hr
    have h0 : (rotPt r 0 z) 0 = r := by simp [rotPt]
    have h1 : (rotPt r 0 z) 1 = 0 := by simp [rotPt]
    have h2 : (rotPt r 0 z) 2 = z := by simp [rotPt]
    have hrad : rad (rotPt r 0 z) = r := by
      unfold rad
      rw [h0, h1]
      simp [Real.sqrt_sq hr.le]
    refine ⟨h0, h1, h2, hrad, ?_, ?_⟩
    · unfold eR radVec
      rw [hrad, h0, h1, zero_smul, add_zero, smul_smul, inv_mul_cancel₀ hr.ne', one_smul]
    · unfold eTh azVec
      rw [hrad, h0, h1, neg_zero, zero_smul, zero_add, smul_smul, inv_mul_cancel₀ hr.ne', one_smul]
  have hinZ : ∀ v : ℝ³, inner ℝ v eZ = v 2 := by
    intro v
    simp [eZ, EuclideanSpace.inner_single_right]
  refine ⟨?_, ?_⟩
  ·
    intro y s Y0 hmem hr
    obtain ⟨y₀, hy₀⟩ : ∃ y₀ : ℝ³, y₀ = rotPt (rad y) 0 (y 2) := ⟨_, rfl⟩
    obtain ⟨h0, h1, h2, hrad0, -, -⟩ := frame (rad y) (y 2) hr
    rw [← hy₀] at h0 h1 h2 hrad0
    have hpos : 0 < y 0 ^ 2 + y 1 ^ 2 := Real.sqrt_pos.mp hr
    have hr2 : rad y ^ 2 = y 0 ^ 2 + y 1 ^ 2 := Real.sq_sqrt hpos.le
    have hsum : y₀ 0 ^ 2 + y₀ 1 ^ 2 = y 0 ^ 2 + y 1 ^ 2 := by
      rw [h0, h1, ← hr2]; ring
    have hpos₀ : 0 < y₀ 0 ^ 2 + y₀ 1 ^ 2 := by rw [hsum]; exact hpos
    have hmem₀ : (y₀, s) ∈ simDomain B.h B.qB := by
      have hm : s < 1 ∧ simScale B.h (y 2) (1 - s) < B.qB := hmem
      show s < 1 ∧ simScale B.h (y₀ 2) (1 - s) < B.qB
      rw [h2]; exact hm
    have A := h6 y s hmem hpos
    have A0 := h6 y₀ s hmem₀ hpos₀
    unfold simX simEta at A A0
    rw [hsum, h2] at A0
    have hE : inner ℝ (uB B y₀ s) (azVec y₀) = inner ℝ (uB B y s) (azVec y) := A0.1.trans A.1.symm
    have hU : (uB B y₀ s) 2 = (uB B y s) 2 := A0.2.1.trans A.2.1.symm
    have hV : inner ℝ (uB B y₀ s) (radVec y₀) = inner ℝ (uB B y s) (radVec y) :=
      A0.2.2.trans A.2.2.symm
    have hub : ∀ i, ubase B (ptOf y s Y0) i = inner ℝ (uB B y₀ s) (![eR y₀, eTh y₀, eZ] i) := by
      intro i; rw [hy₀]; rfl
    have c0 : ubase B (ptOf y s Y0) 0 = inner ℝ (uB B y s) (eR y) := by
      rw [hub]
      show inner ℝ (uB B y₀ s) (eR y₀) = _
      unfold eR
      rw [real_inner_smul_right, real_inner_smul_right, hrad0, hV]
    have c1 : ubase B (ptOf y s Y0) 1 = inner ℝ (uB B y s) (eTh y) := by
      rw [hub]
      show inner ℝ (uB B y₀ s) (eTh y₀) = _
      unfold eTh
      rw [real_inner_smul_right, real_inner_smul_right, hrad0, hE]
    have c2 : ubase B (ptOf y s Y0) 2 = inner ℝ (uB B y s) eZ := by
      rw [hub]
      show inner ℝ (uB B y₀ s) eZ = _
      rw [hinZ, hinZ, hU]
    have hfun : (fun i => ubase B (ptOf y s Y0) i) =
        fun i => inner ℝ (uB B y s) (![eR y, eTh y, eZ] i) := by
      funext i
      fin_cases i
      · exact c0
      · exact c1
      · exact c2
    rw [hfun]
    have hs : (rad y)⁻¹ ^ 2 * (y 0 ^ 2 + y 1 ^ 2) = 1 := by
      rw [← hr2]; field_simp
    refine PiLp.ext (fun j => ?_)
    fin_cases j <;>
      simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three] <;>
      first
      | linear_combination (uB B y s 0) * hs
      | linear_combination (-(uB B y s 0)) * hs
      | linear_combination (uB B y s 1) * hs
      | linear_combination (-(uB B y s 1)) * hs
  ·
    intro i
    have hsc : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hS.2.2.2.1.continuousOn
    have hD : IsOpen (simDomain B.h B.qB) := by
      have hm : Continuous (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)) := by fun_prop
      have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)))
          {w : ℝ³ × ℝ | w.2 < 1} := by
        refine hsc.comp hm.continuousOn ?_
        intro w hw
        have hw' : w.2 < 1 := hw
        exact ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by linarith⟩
      have hU : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
      have h1 := hc.isOpen_inter_preimage hU (isOpen_Iio (a := B.qB))
      have e : simDomain B.h B.qB = {w : ℝ³ × ℝ | w.2 < 1} ∩
          ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2))) ⁻¹' Iio B.qB := by
        ext w
        simp only [simDomain, mem_setOf_eq, mem_inter_iff, mem_preimage, mem_Iio, Function.comp]
      rw [e]
      exact h1
    have hu : ContDiffOn ℝ ∞ (↿(uB B)) (simDomain B.h B.qB) := by
      have hAB : ContDiffOn ℝ ∞ (↿B.AB) (simDomain B.h B.qB) := hBsm.1
      have hBv : ContDiffOn ℝ ∞ (↿B.BvB) (simDomain B.h B.qB) := hBsm.2.1
      have hDA : ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z) (simDomain B.h B.qB) :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hAB).2
      have hc : ∀ (v : ℝ³) (j : Fin 3),
          ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z (v, (0:ℝ)) j) (simDomain B.h B.qB) := by
        intro v j
        have h1 : ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z (v, (0:ℝ))) (simDomain B.h B.qB) :=
          hDA.clm_apply contDiffOn_const
        exact (EuclideanSpace.proj j : ℝ³ →L[ℝ] ℝ).contDiff.comp_contDiffOn h1
      let e0 : ℝ³ := EuclideanSpace.single 0 1
      let e1 : ℝ³ := EuclideanSpace.single 1 1
      let e2 : ℝ³ := EuclideanSpace.single 2 1
      have hg : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ =>
          (fderiv ℝ (↿B.AB) z (e1, (0:ℝ)) 2 - fderiv ℝ (↿B.AB) z (e2, (0:ℝ)) 1) •
              EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
          (fderiv ℝ (↿B.AB) z (e2, (0:ℝ)) 0 - fderiv ℝ (↿B.AB) z (e0, (0:ℝ)) 2) •
              EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
          (fderiv ℝ (↿B.AB) z (e0, (0:ℝ)) 1 - fderiv ℝ (↿B.AB) z (e1, (0:ℝ)) 0) •
              EuclideanSpace.single (2 : Fin 3) (1 : ℝ) + (↿B.BvB) z) (simDomain B.h B.qB) := by
        refine ((((hc e1 2).sub (hc e2 1)).smul contDiffOn_const).add
          (((hc e2 0).sub (hc e0 2)).smul contDiffOn_const)).add
          (((hc e0 1).sub (hc e1 0)).smul contDiffOn_const) |>.add hBv
      refine hg.congr ?_
      rintro ⟨y, s⟩ hz
      have hdiff : DifferentiableAt ℝ (↿B.AB) (y, s) :=
        (hAB.contDiffAt (hD.mem_nhds hz)).differentiableAt (by norm_num)
      have hpart : fderiv ℝ (fun w => B.AB w s) y =
          (fderiv ℝ (↿B.AB) (y, s)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := by
        have h1 : HasFDerivAt (fun w : ℝ³ => (w, s)) (ContinuousLinearMap.inl ℝ ℝ³ ℝ) y :=
          hasFDerivAt_prodMk_left y s
        have h2 : HasFDerivAt ((↿B.AB) ∘ (fun w : ℝ³ => (w, s)))
            ((fderiv ℝ (↿B.AB) (y, s)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ)) y :=
          HasFDerivAt.comp (g := ↿B.AB) y hdiff.hasFDerivAt h1
        exact h2.fderiv
      show curl3 (fun w => B.AB w s) y + B.BvB y s = _
      unfold curl3
      rw [hpart]
      simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.inl_apply]
      rfl
    let ψ : Cyl → ℝ³ × ℝ := fun η => (rotPt η.1 0 η.2.1, η.2.2.1)
    have hψ : ContDiff ℝ ∞ ψ := by
      have hr : ContDiff ℝ ∞ (fun η : Cyl => rotPt η.1 0 η.2.1) := by
        unfold rotPt
        fun_prop
      exact hr.prodMk (contDiff_fst.comp (contDiff_snd.comp contDiff_snd))
    have hmaps : MapsTo ψ {η : Cyl | 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < B.qB} (simDomain B.h B.qB) := by
      intro η hη
      obtain ⟨e1, e2, e3⟩ := hη
      show η.2.2.1 < 1 ∧ simScale B.h ((rotPt η.1 0 η.2.1) 2) (1 - η.2.2.1) < B.qB
      rw [(frame η.1 η.2.1 e1).2.2.1]
      exact ⟨e2, e3⟩
    have hcomp : ContDiffOn ℝ ∞ ((↿(uB B)) ∘ ψ)
        {η : Cyl | 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < B.qB} :=
      hu.comp hψ.contDiffOn hmaps
    have hg : ContDiffOn ℝ ∞ (fun η => inner ℝ (((↿(uB B)) ∘ ψ) η)
        ((![EuclideanSpace.single (0 : Fin 3) (1 : ℝ), EuclideanSpace.single (1 : Fin 3) (1 : ℝ), eZ] :
          Fin 3 → ℝ³) i))
        {η : Cyl | 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < B.qB} :=
      ContDiffOn.inner ℝ hcomp contDiffOn_const
    refine hg.congr ?_
    intro η hη
    obtain ⟨-, -, -, -, f2, f3⟩ := frame η.1 η.2.1 hη.1
    show inner ℝ (uB B (rotPt η.1 0 η.2.1) η.2.2.1)
        (![eR (rotPt η.1 0 η.2.1), eTh (rotPt η.1 0 η.2.1), eZ] i) = _
    rw [f2, f3]
    rfl

theorem plin5_cof_smooth : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ l0 : ℕ, qsOf l0 ≤ B.qB → InWg5 B G (qsOf l0) 1 (primState5 B G).Aw → InWg5 B G (qsOf l0) 1 (primState5 B G).pw → ∀ (γ : Lab) (m : ℤ), ContDiffOn ℝ ∞ (cofA5 B G γ m) (DomC B.h (qsOf l0)) ∧ ContDiffOn ℝ ∞ (cofP5 B G γ m) (DomC B.h (qsOf l0)) :=
by
  intro B G hok hG l0 hqs hAw hpw γ m
  have hqsm : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h (qsOf l0)) := by
    have h4' : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1
    have hφ : ContDiff ℝ ∞ (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        (DomC B.h (qsOf l0)) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2.1
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    exact (h4'.comp hφ.contDiffOn hmaps).congr (fun ξ _ => rfl)
  have hqpos : ∀ η ∈ DomC B.h (qsOf l0), 0 < qC B.h η := by
    intro η hη
    have h' : η.2.2.1 < 1 := hη.2.1
    exact (hok.1.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hqpow : ∀ c : ℝ, ContDiffOn ℝ ∞ (fun η : Cyl => ((qC B.h η ^ c : ℝ) : ℂ))
      (DomC B.h (qsOf l0)) := by
    intro c
    have hr : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η ^ c) (DomC B.h (qsOf l0)) :=
      hqsm.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
    exact (Complex.ofRealCLM.contDiff.comp_contDiffOn hr).congr
      (fun η _ => by simp only [Function.comp_apply, Complex.ofRealCLM_apply])

  have K : ∀ f : Cyl → ℂ, ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) →
      (∀ ξ ∈ DomC B.h (qsOf l0), f ξ ≠ 0 → SuppW B G γ ξ) →
      ContDiffOn ℝ ∞ (fun η => f η *
        Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))))
        (DomC B.h (qsOf l0)) := by
    intro f hf hsupp
    set v : Cyl → ℝ × ℝ := fun η => Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ with hv
    have hvc : Continuous v := by
      rw [hv]
      unfold Jpow
      fun_prop
    have hbase : ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => baseC B γ.1 η j)
        (DomC B.h (qsOf l0)) := by
      intro j
      obtain ⟨_, hsm⟩ := geom_slow_base_smooth_v5 B hok
      have hπ : ContDiff ℝ ∞ (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) :=
        contDiff_fst.prodMk (contDiff_snd.fst.prodMk contDiff_snd.snd.fst)
      have hc := (hsm γ.1 j).comp hπ.contDiffOn
        (fun ξ (hξ : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0) =>
          (⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqs⟩ : ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ) ∈
            {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}))
      exact hc.congr (fun ξ _ => rfl)
    have hZ : ContDiff ℝ ∞ (fun η : Cyl => chartZ B.h γ.1 η) := by
      unfold chartZ
      exact contDiff_snd.fst.div_const _
    have hRC : ContDiff ℝ ∞ (fun η : Cyl => RC γ.1 η) := by
      unfold RC
      exact contDiff_fst.div_const _
    have hRCpos : ∀ η ∈ DomC B.h (qsOf l0), RC γ.1 η ≠ 0 := by
      intro η hη
      have hr : 0 < η.1 := hη.1
      have : 0 < RC γ.1 η :=
        div_pos hr (Real.sqrt_pos.mpr (Real.rpow_pos_of_pos (by norm_num) _))
      exact this.ne'
    have hF : ContDiffOn ℝ ∞ (fun η : Cyl => Fang B γ.1 η) (DomC B.h (qsOf l0)) :=
      ((hbase 1).div hRC.contDiffOn hRCpos).congr (fun η _ => rfl)
    apply contDiffOn_of_locally_contDiffOn
    intro ξ₀ _
    set U' : Set Cyl := {η | |(v η).1 - (v ξ₀).1| < 1/8} ∩ {η | |(v η).2 - (v ξ₀).2| < 1/8}
      with hU'
    have hU'o : IsOpen U' :=
      (isOpen_lt ((hvc.fst.sub continuous_const).abs) continuous_const).inter
        (isOpen_lt ((hvc.snd.sub continuous_const).abs) continuous_const)
    have hξU : ξ₀ ∈ U' := by
      refine ⟨?_, ?_⟩
      · show |(v ξ₀).1 - (v ξ₀).1| < 1/8
        rw [sub_self, abs_zero]; norm_num
      · show |(v ξ₀).2 - (v ξ₀).2| < 1/8
        rw [sub_self, abs_zero]; norm_num
    refine ⟨U', hU'o, hξU, ?_⟩
    by_cases hA : ∀ η ∈ DomC B.h (qsOf l0) ∩ U', f η = 0
    · refine (contDiffOn_const (c := (0:ℂ))).congr (fun p hp => ?_)
      have h0 := hA p hp
      simp [h0]
    · push_neg at hA
      obtain ⟨η1, ⟨hη1D, hη1U⟩, hη1⟩ := hA
      obtain ⟨-, -, hxi, het, -, -⟩ := hsupp η1 hη1D hη1
      have hr0 : G.r0 ≤ 1/100 := hG.1.2.1
      have hb0 : 0 ≤ bgc := by unfold bgc; linarith [Real.one_lt_sqrt_two]
      have hb1 : bgc ≤ 1 := by
        unfold bgc
        nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
      have hden : (1 + bgc ^ 2) * (1 + bgc ^ 2)⁻¹ = 1 := mul_inv_cancel₀ (by positivity)
      have id1 : ∀ w : ℝ × ℝ, w.1 = lamR w + bgc * lamT w := by
        intro w
        simp only [lamR, lamT, div_eq_mul_inv]
        linear_combination (-w.1) * hden
      have id2 : ∀ w : ℝ × ℝ, w.2 = -(bgc * lamR w) + lamT w := by
        intro w
        simp only [lamR, lamT, div_eq_mul_inv]
        linear_combination (-w.2) * hden
      have key : ∀ (R T : ℝ), |R| ≤ G.r0 / 4 → |T| ≤ G.r0 →
          |R + bgc * T| ≤ 1/80 ∧ |-(bgc * R) + T| ≤ 1/80 := by
        intro R T hR hT
        obtain ⟨hR1, hR2⟩ := abs_le.mp hR
        obtain ⟨hT1, hT2⟩ := abs_le.mp hT
        have hr0n : 0 ≤ G.r0 := le_trans (abs_nonneg _) hT
        have e1 : bgc * T ≤ G.r0 := by
          nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hT2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
        have e2 : -G.r0 ≤ bgc * T := by
          nlinarith [mul_nonneg hb0 (show 0 ≤ T + G.r0 by linarith),
            mul_nonneg (sub_nonneg.mpr hb1) hr0n]
        have e3 : bgc * R ≤ G.r0 / 4 := by
          nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hR2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
        have e4 : -(G.r0 / 4) ≤ bgc * R := by
          nlinarith [mul_nonneg hb0 (show 0 ≤ R + G.r0 / 4 by linarith),
            mul_nonneg (sub_nonneg.mpr hb1) hr0n]
        exact ⟨abs_le.mpr ⟨by linarith, by linarith⟩, abs_le.mpr ⟨by linarith, by linarith⟩⟩
      have hround : ∀ (x : ℝ) (k : ℤ), |x - k| < 1/2 → round x = k := by
        intro x k hk
        rw [round_eq, Int.floor_eq_iff]
        obtain ⟨h1, h2⟩ := abs_lt.mp hk
        constructor <;> linarith
      have hw1 : |lamR (frac0 (v η1))| ≤ G.r0 / 4 := hxi
      have hw2 : |lamT (frac0 (v η1))| ≤ G.r0 := het
      have hw := key _ _ hw1 hw2
      have ex1 : (v η1).1 - ((round (v η1).1 : ℤ) : ℝ) =
          lamR (frac0 (v η1)) + bgc * lamT (frac0 (v η1)) := id1 (frac0 (v η1))
      have ex2 : (v η1).2 - ((round (v η1).2 : ℤ) : ℝ) =
          -(bgc * lamR (frac0 (v η1))) + lamT (frac0 (v η1)) := id2 (frac0 (v η1))
      have hx1 : |(v η1).1 - ((round (v η1).1 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex1]; exact hw.1
      have hx2 : |(v η1).2 - ((round (v η1).2 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex2]; exact hw.2
      obtain ⟨kk, hkk⟩ : ∃ kk : ℝ × ℝ,
          kk = (((round (v η1).1 : ℤ) : ℝ), ((round (v η1).2 : ℤ) : ℝ)) := ⟨_, rfl⟩
      have hfr : ∀ η ∈ U', frac0 (v η) = v η - kk := by
        intro η hη
        have h1 : |(v η).1 - (v ξ₀).1| < 1/8 := hη.1
        have h2 : |(v η).2 - (v ξ₀).2| < 1/8 := hη.2
        have g1 : |(v η1).1 - (v ξ₀).1| < 1/8 := hη1U.1
        have g2 : |(v η1).2 - (v ξ₀).2| < 1/8 := hη1U.2
        obtain ⟨a1, a2⟩ := abs_lt.mp h1
        obtain ⟨a3, a4⟩ := abs_lt.mp h2
        obtain ⟨b1, b2⟩ := abs_lt.mp g1
        obtain ⟨b3, b4⟩ := abs_lt.mp g2
        obtain ⟨c1, c2⟩ := abs_le.mp hx1
        obtain ⟨c3, c4⟩ := abs_le.mp hx2
        have r1 : round (v η).1 = round (v η1).1 :=
          hround _ _ (abs_lt.mpr ⟨by linarith, by linarith⟩)
        have r2 : round (v η).2 = round (v η1).2 :=
          hround _ _ (abs_lt.mpr ⟨by linarith, by linarith⟩)
        rw [hkk]
        unfold frac0
        rw [r1, r2]
        rfl
      have hT : ContDiff ℝ ∞ (fun η : Cyl => lamT (v η - kk)) := by
        simp only [hv, lamT, Jpow, div_eq_mul_inv]
        fun_prop
      obtain ⟨M, hMdef⟩ : ∃ M : Cyl → ℝ, M = fun η : Cyl =>
          pzr5 B G γ * chartZ B.h γ.1 η / epsb B.h γ.1 + sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 * RC γ.1 η
          - (lamT (v η - kk) + G.r0) / cib B.h γ.1 *
            (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2) := ⟨_, rfl⟩
      have hM : ContDiffOn ℝ ∞ M (DomC B.h (qsOf l0)) := by
        rw [hMdef]
        exact ((((contDiffOn_const (c := pzr5 B G γ)).mul hZ.contDiffOn).div_const (epsb B.h γ.1)).add
          ((contDiffOn_const (c := sgn γ.2.2 * Bs5 B G γ * G.ustar / 2)).mul hRC.contDiffOn)).sub
          (((hT.contDiffOn.add (contDiffOn_const (c := G.r0))).div_const (cib B.h γ.1)).mul
            (((contDiffOn_const (c := pang5 B G γ)).mul hF).add
              ((contDiffOn_const (c := pzr5 B G γ)).mul (hbase 2))))
      have hmod : ∀ η ∈ U', phiL5 B G γ η = M η := by
        intro η hη
        have hvco : vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = (lamT (v η - kk) + G.r0) / cib B.h γ.1 := by
          show (lamT (frac0 (v η)) + G.r0) / cib B.h γ.1 = _
          rw [hfr η hη]
        rw [hMdef]
        show phiL5 B G γ η = _
        unfold phiL5
        rw [hvco]
      have hMc : ContDiffOn ℝ ∞ (fun η : Cyl => ((M η : ℝ) : ℂ)) (DomC B.h (qsOf l0)) :=
        (Complex.ofRealCLM.contDiff.comp_contDiffOn hM).congr
          (fun p _ => by simp only [Function.comp_apply, Complex.ofRealCLM_apply])
      have hE : ContDiffOn ℝ ∞ (fun η : Cyl => Complex.exp (Complex.I * (m : ℂ) *
          ((kb B.h γ.1 : ℂ) * ((M η : ℝ) : ℂ)))) (DomC B.h (qsOf l0)) :=
        ((contDiffOn_const (c := Complex.I * (m : ℂ))).mul
          ((contDiffOn_const (c := (kb B.h γ.1 : ℂ))).mul hMc)).cexp
      refine ((hf.mul hE).mono inter_subset_left).congr (fun p hp => ?_)
      have hpU : p ∈ U' := hp.2
      show f p * _ = _
      rw [hmod p hpU]
  constructor
  · refine contDiffOn_pi.2 (fun i => ?_)
    have hc : ContDiffOn ℝ ∞ (fun η => (primState5 B G).Aw γ m η i) (DomC B.h (qsOf l0)) :=
      contDiffOn_pi.1 (hAw.2.1 γ m) i
    have hs : ∀ ξ ∈ DomC B.h (qsOf l0), (primState5 B G).Aw γ m ξ i ≠ 0 → SuppW B G γ ξ := by
      intro ξ hξ hne
      apply hAw.2.2.2.1 γ m ξ hξ
      intro h0
      apply hne
      simp [h0]
    refine ((hqpow (1/2 - Aex B.h)).mul (K _ hc hs)).congr (fun η _ => ?_)
    simp only [cofA5, Pi.smul_apply, smul_eq_mul]
    ring
  · refine ((hqpow (-2 * Aex B.h)).mul
      (K _ (hpw.2.1 γ m) (fun ξ hξ hne => hpw.2.2.2.1 γ m ξ hξ hne))).congr (fun η _ => ?_)
    simp only [cofP5]
    ring

theorem plin5_local_modes : ∀ (B : BG) (G : CorrGeom), B.ok → ∀ l0 : ℕ, InWg5 B G (qsOf l0) 1 (primState5 B G).Aw → InWg5 B G (qsOf l0) 1 (primState5 B G).pw → ∀ x t Y, corrOn B l0 x t → ∃ (O : Set (ℝ³ × ℝ)) (Γ : Finset Lab) (H : Finset ℤ), IsOpen O ∧ (x, t) ∈ O ∧ (∀ y s, (y, s) ∈ O → corrOn B l0 y s ∧ evOff B.h (pwrA5 B G l0) (Y - Yph B.h (rad x) t) y s = ∑ k ∈ Γ ×ˢ H, mvec5 B.h (k.2 * pint5 B G k.1) (cofA5 B G k.1 k.2) (Y - Yph B.h (rad x) t) y s ∧ evOff B.h (pwrP5 B G l0) (Y - Yph B.h (rad x) t) y s = ∑ k ∈ Γ ×ˢ H, msc5 B.h (k.2 * pint5 B G k.1) (cofP5 B G k.1 k.2) (Y - Yph B.h (rad x) t) y s) ∧ ∀ (γ : Lab) (m : ℤ), (γ ∉ Γ ∨ m ∉ H) → linC5 B G γ m (ptOf x t Y) = 0 :=
by
  intro B G hok l0 hAw hpw x t Y hxt
  obtain ⟨Y', hY'⟩ : ∃ Y' : ℝ × ℝ, Y' = Y - Yph B.h (rad x) t := ⟨_, rfl⟩
  rw [← hY']
  have hxt' : 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt

  have hEta : ∀ (h : ℝ), SimScaleProps h → ∀ ξ0 : Cyl, ξ0.2.2.1 < 1 → ∃ N ∈ nhds ξ0, ∃ Γ : Finset Lab,
      ∀ (γ : Lab) (ξ : Cyl), ξ ∈ N → ξ ∈ tsupport (etaL h γ) → γ ∈ Γ := by
    intro h hS ξ0 hξ0
    have hLc : ∀ ξ : Cyl, ξ.2.2.1 < 1 → ContinuousAt (fun η => Real.logb 2 (qC h η)) ξ := by
      intro ξ hξ
      have hτ : 0 < 1 - ξ.2.2.1 := by linarith
      have hqpos : 0 < qC h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
      have hqcont : ContinuousAt (qC h) ξ := by
        have hU : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
        have hp : ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) :=
          ⟨trivial, hτ⟩
        have hg : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (ξ.2.1, 1 - ξ.2.2.1) :=
          hS.2.2.2.1.continuousOn.continuousAt (hU.mem_nhds hp)
        have hk : ContinuousAt (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) ξ := by fun_prop
        have he : qC h = (fun w : ℝ × ℝ => simScale h w.1 w.2) ∘
            (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by
          funext η; rfl
        rw [he]
        exact ContinuousAt.comp hg hk
      exact hqcont.logb hqpos.ne'
    have hwin : ∀ (ξ : Cyl) (γ : Lab), ξ.2.2.1 < 1 → ξ ∈ tsupport (etaL h γ) →
        |Real.logb 2 (qC h ξ) + (γ.1:ℝ)| ≤ 1 ∧
        |chartR h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1:ℝ)| ≤ 1 ∧
        |chartZ h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.1:ℝ)| ≤ 1 ∧
        |chartT h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2:ℝ)| ≤ 1 := by
      intro ξ γ hξ hγ
      have s1 : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ → 1 < |φ ξ / μ - (j : ℝ)| →
          ∀ᶠ η in nhds ξ, sqPart μ j (φ η) = 0 := by
        intro μ j φ hφ h1
        have hψ : ContinuousAt (fun η => |φ η / μ - (j : ℝ)|) ξ :=
          ((hφ.div_const μ).sub continuousAt_const).abs
        have hev := (continuousAt_const : ContinuousAt (fun _ : Cyl => (1:ℝ)) ξ).eventually_lt hψ h1
        filter_upwards [hev] with η hη
        have hsq : 1 < (φ η / μ - (j : ℝ)) ^ 2 := (one_lt_sq_iff_one_lt_abs _).mpr hη
        unfold sqPart bumpR
        rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_div]
      have key : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ →
          (∀ η, sqPart μ j (φ η) = 0 → etaL h γ η = 0) → |φ ξ / μ - (j:ℝ)| ≤ 1 := by
        intro μ j φ hφ himp
        by_contra hc
        push_neg at hc
        have hev := s1 μ j φ hφ hc
        apply (notMem_tsupport_iff_eventuallyEq.mpr _) hγ
        filter_upwards [hev] with η hη
        exact himp η hη
      refine ⟨?_, ?_, ?_, ?_⟩
      · have := key 1 (-(γ.1:ℤ)) (fun η => Real.logb 2 (qC h η)) (hLc ξ hξ)
          (fun η hη => by simp only [etaL, hη, zero_mul])
        simpa [div_one, sub_neg_eq_add] using this
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.1 (chartR h γ.1) (by unfold chartR; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.1 (chartZ h γ.1) (by unfold chartZ; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.2 (chartT h γ.1) (by unfold chartT; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
    obtain ⟨L0, hL0⟩ : ∃ L0 : ℝ, L0 = Real.logb 2 (qC h ξ0) := ⟨_, rfl⟩
    have hfin : (⋃ n ∈ Set.Iic ⌊2 - L0⌋₊, ({n} : Set ℕ) ×ˢ
        ((Set.Icc ⌈chartR h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartR h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋ ×ˢ
          Set.Icc ⌈chartZ h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartZ h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋ ×ˢ
          Set.Icc ⌈chartT h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartT h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋) ×ˢ
          (Set.univ : Set Bool))).Finite := by
      refine Set.Finite.biUnion (Set.finite_Iic _) (fun n _ => ?_)
      exact (Set.finite_singleton n).prod (((Set.finite_Icc _ _).prod
        ((Set.finite_Icc _ _).prod (Set.finite_Icc _ _))).prod Set.finite_univ)
    have hI : ∀ (x c : ℝ) (j : ℤ), |x - (j:ℝ)| ≤ 1 → |x - c| < 1 → j ∈ Set.Icc ⌈c - 2⌉ ⌊c + 2⌋ := by
      intro x c j hj hc
      rw [abs_le] at hj
      rw [abs_lt] at hc
      exact ⟨Int.ceil_le.mpr (by linarith [hj.2, hc.1]), Int.le_floor.mpr (by linarith [hj.1, hc.2])⟩
    have hcR : ∀ n : ℕ, ContinuousAt (chartR h n) ξ0 := fun n => by unfold chartR; fun_prop
    have hcZ : ∀ n : ℕ, ContinuousAt (chartZ h n) ξ0 := fun n => by unfold chartZ; fun_prop
    have hcT : ∀ n : ℕ, ContinuousAt (chartT h n) ξ0 := fun n => by unfold chartT; fun_prop
    have hch : ∀ (φ : Cyl → ℝ) (μ : ℝ), ContinuousAt φ ξ0 →
        ∀ᶠ ξ in nhds ξ0, |φ ξ / μ - φ ξ0 / μ| < 1 := by
      intro φ μ hφ
      exact (((hφ.div_const μ).sub continuousAt_const).abs).eventually_lt continuousAt_const
        (by simp)
    have e1 : ∀ᶠ ξ in nhds ξ0, ξ.2.2.1 < 1 :=
      (show ContinuousAt (fun ξ : Cyl => ξ.2.2.1) ξ0 by fun_prop).eventually_lt
        continuousAt_const hξ0
    have e2 : ∀ᶠ ξ in nhds ξ0, |Real.logb 2 (qC h ξ) - L0| < 1 :=
      (((hLc ξ0 hξ0).sub continuousAt_const).abs).eventually_lt continuousAt_const
        (by simp [hL0])
    have e3 : ∀ᶠ ξ in nhds ξ0, ∀ n ∈ Finset.range (⌊2 - L0⌋₊ + 1),
        |chartR h n ξ / Sb n ^ (-3:ℤ) - chartR h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartZ h n ξ / Sb n ^ (-3:ℤ) - chartZ h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartT h n ξ / Sb n ^ (-3:ℤ) - chartT h n ξ0 / Sb n ^ (-3:ℤ)| < 1 := by
      rw [Filter.eventually_all_finset]
      intro n _
      exact (hch _ _ (hcR n)).and ((hch _ _ (hcZ n)).and (hch _ _ (hcT n)))
    refine ⟨{ξ | ξ.2.2.1 < 1 ∧ |Real.logb 2 (qC h ξ) - L0| < 1 ∧
        ∀ n ∈ Finset.range (⌊2 - L0⌋₊ + 1),
        |chartR h n ξ / Sb n ^ (-3:ℤ) - chartR h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartZ h n ξ / Sb n ^ (-3:ℤ) - chartZ h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartT h n ξ / Sb n ^ (-3:ℤ) - chartT h n ξ0 / Sb n ^ (-3:ℤ)| < 1}, ?_,
      hfin.toFinset, ?_⟩
    · filter_upwards [e1, e2, e3] with ξ h1 h2 h3
      exact ⟨h1, h2, h3⟩
    rintro ⟨n, ⟨a, b, c⟩, σ⟩ ξ ⟨ht, hL, hC⟩ hγ
    obtain ⟨w0, wR, wZ, wT⟩ := hwin ξ _ ht hγ
    simp only at w0 wR wZ wT
    rw [abs_le] at w0
    rw [abs_lt] at hL
    have hn : n ≤ ⌊2 - L0⌋₊ := Nat.le_floor (by linarith [w0.2, hL.1])
    obtain ⟨cR, cZ, cT⟩ := hC n (Finset.mem_range.mpr (Nat.lt_succ_of_le hn))
    rw [Set.Finite.mem_toFinset]
    refine Set.mem_iUnion₂.mpr ⟨n, hn, ?_⟩
    exact ⟨rfl, ⟨hI _ _ _ wR cR, hI _ _ _ wZ cZ, hI _ _ _ wT cT⟩, trivial⟩
  obtain ⟨N, hN, Γ, hΓ⟩ := hEta B.h hok.1 (ptOf x t Y) hxt'.2.1
  obtain ⟨⟨HA, -, hHA⟩, -, -, hSA, -⟩ := hAw
  obtain ⟨⟨Hp, -, hHp⟩, -, -, hSp, -⟩ := hpw

  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'

  have hoff : ∀ η ∈ N, η ∈ DomC B.h (qsOf l0) → ∀ (γ : Lab) (m : ℤ), (γ ∉ Γ ∨ m ∉ HA ∪ Hp) →
      (primState5 B G).Aw γ m η = 0 ∧ (primState5 B G).pw γ m η = 0 := by
    intro η hηN hηD γ m hγm
    constructor
    · by_contra hne
      rcases hγm with hγ | hm
      · exact hγ (hΓ γ η hηN (hSA γ m η hηD hne).2.1)
      · exact hne (congrFun (hHA γ m (fun h => hm (Finset.mem_union_left _ h))) η)
    · by_contra hne
      rcases hγm with hγ | hm
      · exact hγ (hΓ γ η hηN (hSp γ m η hηD hne).2.1)
      · exact hne (congrFun (hHp γ m (fun h => hm (Finset.mem_union_right _ h))) η)

  have hsum : ∀ (F : Lab → ℤ → ℂ), (∀ γ m, (γ ∉ Γ ∨ m ∉ HA ∪ Hp) → F γ m = 0) →
      ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, F γ m = ∑ k ∈ Γ ×ˢ (HA ∪ Hp), F k.1 k.2 := by
    intro F hF
    rw [Finset.sum_product]
    show _ = ∑ γ ∈ Γ, ∑ m ∈ HA ∪ Hp, F γ m
    have hin : ∀ γ, ∑ᶠ m : ℤ, F γ m = ∑ m ∈ HA ∪ Hp, F γ m := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      rw [Function.mem_support] at hm
      by_contra h
      exact hm (hF γ m (Or.inr (by simpa using h)))
    simp_rw [hin]
    apply finsum_eq_sum_of_support_subset
    intro γ hγ
    rw [Function.mem_support] at hγ
    by_contra h
    exact hγ (Finset.sum_eq_zero (fun m _ => hF γ m (Or.inl (by simpa using h))))
  have hphase : ∀ (γ : Lab) (m : ℤ) (θ : ℝ) (η : Cyl), ephase5 B G γ m θ η =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) *
        Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) := by
    intro γ m θ η
    simp only [ephase5]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  have key : ∀ (q : ℝ) (A E X : ℂ), q * (A * (E * X)).re = ((q : ℂ) * (E * A) * X).re := by
    intro q A E X
    rw [show (q : ℂ) * (E * A) * X = (q : ℂ) * (A * (E * X)) by ring, Complex.re_ofReal_mul]
  have hcyl_sum : ∀ (y : ℝ³) {ι : Type} (s : Finset ι) (v : ι → Fin 3 → ℝ),
      cyl2cart y (∑ j ∈ s, v j) = ∑ j ∈ s, cyl2cart y (v j) := by
    intro y ι s v
    let L : (Fin 3 → ℝ) →+ ℝ³ := AddMonoidHom.mk' (cyl2cart y) (fun c d => by
      simp only [cyl2cart, Pi.add_apply, add_smul]; abel)
    exact map_sum L v s

  have hexpand : ∀ (y : ℝ³) (s : ℝ), corrOn B l0 y s →
      (∀ (γ : Lab) (m : ℤ), (γ ∉ Γ ∨ m ∉ HA ∪ Hp) →
        (primState5 B G).Aw γ m (ptOf y s (Yph B.h (rad y) s + Y')) = 0 ∧
        (primState5 B G).pw γ m (ptOf y s (Yph B.h (rad y) s + Y')) = 0) →
      evOff B.h (pwrA5 B G l0) Y' y s = ∑ k ∈ Γ ×ˢ (HA ∪ Hp),
          mvec5 B.h (k.2 * pint5 B G k.1) (cofA5 B G k.1 k.2) Y' y s ∧
      evOff B.h (pwrP5 B G l0) Y' y s = ∑ k ∈ Γ ×ˢ (HA ∪ Hp),
          msc5 B.h (k.2 * pint5 B G k.1) (cofP5 B G k.1 k.2) Y' y s := by
    intro y s hc hz
    have hscale : ∀ (c : ℝ) (v : Fin 3 → ℝ), c • cyl2cart y v = cyl2cart y (fun i => c * v i) := by
      intro c v
      simp only [cyl2cart, smul_add, mul_smul]
    constructor
    · simp only [evOff, pwrA5, if_pos hc]
      rw [hscale]
      trans cyl2cart y (∑ k ∈ Γ ×ˢ (HA ∪ Hp), fun i =>
        (cofA5 B G k.1 k.2 (ptOf y s (Yph B.h (rad y) s + Y')) i *
          Complex.exp (Complex.I * ((k.2 * pint5 B G k.1 : ℤ) : ℂ) * (thetaOf y : ℂ))).re)
      · congr 1
        funext i
        simp only [waveV5, Finset.sum_apply]
        rw [hsum (fun γ m => (primState5 B G).Aw γ m (ptOf y s (Yph B.h (rad y) s + Y')) i *
            ephase5 B G γ m (thetaOf y) (ptOf y s (Yph B.h (rad y) s + Y')))
          (fun γ m h => by simp only [(hz γ m h).1, Pi.zero_apply, zero_mul]),
          Complex.re_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        try dsimp only
        rw [hphase]
        simp only [cofA5, Pi.smul_apply, smul_eq_mul]
        exact key _ _ _ _
      · rw [hcyl_sum]
        rfl
    · simp only [evOff, pwrP5, if_pos hc, waveS5, msc5]
      rw [hsum (fun γ m => (primState5 B G).pw γ m (ptOf y s (Yph B.h (rad y) s + Y')) *
          ephase5 B G γ m (thetaOf y) (ptOf y s (Yph B.h (rad y) s + Y')))
        (fun γ m h => by simp only [(hz γ m h).2, zero_mul]),
        Complex.re_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      try dsimp only
      rw [hphase]
      simp only [cofP5]
      exact key _ _ _ _

  have hZ : ∀ (W : Set Cyl) (f : Cyl → ℂ), IsOpen W → (∀ η ∈ W, f η = 0) →
      ∀ η ∈ W, fderiv ℝ f η = 0 := by
    intro W f hW hf η hη
    have hev : f =ᶠ[nhds η] fun _ => (0:ℂ) := Filter.eventuallyEq_of_mem (hW.mem_nhds hη) hf
    rw [hev.fderiv_eq]
    exact fderiv_const_apply _
  have hdR : ∀ (W : Set Cyl) (f : Cyl → ℂ), IsOpen W → (∀ η ∈ W, f η = 0) →
      ∀ η ∈ W, dR B.h f η = 0 := by
    intro W f hW hf η hη
    show fderiv ℝ f η _ = 0
    rw [hZ W f hW hf η hη, ContinuousLinearMap.zero_apply]
  have hdZ : ∀ (W : Set Cyl) (f : Cyl → ℂ), IsOpen W → (∀ η ∈ W, f η = 0) →
      ∀ η ∈ W, dZ f η = 0 := by
    intro W f hW hf η hη
    show fderiv ℝ f η _ = 0
    rw [hZ W f hW hf η hη, ContinuousLinearMap.zero_apply]
  have hdT : ∀ (W : Set Cyl) (f : Cyl → ℂ), IsOpen W → (∀ η ∈ W, f η = 0) →
      ∀ η ∈ W, dT f η = 0 := by
    intro W f hW hf η hη
    show fderiv ℝ f η _ = 0
    rw [hZ W f hW hf η hη, ContinuousLinearMap.zero_apply]
  have hcurl0 : ∀ (W : Set Cyl) (n : ℤ) (c : Cyl → (Fin 3 → ℂ)), IsOpen W → (∀ η ∈ W, c η = 0) →
      ∀ η ∈ W, mcurlC B.h n c η = 0 := by
    intro W n c hW hc η hη
    have hci : ∀ i, ∀ η' ∈ W, (fun η'' => c η'' i) η' = 0 := fun i η' hη' => by simp [hc η' hη']
    have h1 : ∀ i, c η i = 0 := fun i => by simp [hc η hη]
    have h2 : ∀ i, dR B.h (fun η'' => c η'' i) η = 0 := fun i => hdR W (fun η'' => c η'' i) hW (hci i) η hη
    have h3 : ∀ i, dZ (fun η'' => c η'' i) η = 0 := fun i => hdZ W (fun η'' => c η'' i) hW (hci i) η hη
    funext i
    fin_cases i <;> simp [mcurlC, h1, h2, h3]
  have hres0 : ∀ (W : Set Cyl) (n : ℤ) (a : Cyl → (Fin 3 → ℂ)) (p : Cyl → ℂ) (ξ0 : Cyl), IsOpen W →
      ξ0 ∈ W → (∀ η ∈ W, a η = 0) → (∀ η ∈ W, p η = 0) → mresC B n a p ξ0 = 0 := by
    intro W n a p ξ0 hW hξ0 ha hp
    have hai : ∀ i, ∀ η' ∈ W, (fun η'' => a η'' i) η' = 0 := fun i η' hη' => by simp [ha η' hη']
    have h1 : ∀ i, a ξ0 i = 0 := fun i => by simp [ha ξ0 hξ0]
    have h2 : ∀ i, dR B.h (fun η'' => a η'' i) ξ0 = 0 := fun i => hdR W _ hW (hai i) ξ0 hξ0
    have h3 : ∀ i, dZ (fun η'' => a η'' i) ξ0 = 0 := fun i => hdZ W _ hW (hai i) ξ0 hξ0
    have h4 : ∀ i, dT (fun η'' => a η'' i) ξ0 = 0 := fun i => hdT W _ hW (hai i) ξ0 hξ0
    have h5 : ∀ i, dR B.h (dR B.h (fun η'' => a η'' i)) ξ0 = 0 := fun i =>
      hdR W (dR B.h (fun η'' => a η'' i)) hW (fun η' hη' => hdR W (fun η'' => a η'' i) hW (hai i) η' hη') ξ0 hξ0
    have h6 : ∀ i, dZ (dZ (fun η'' => a η'' i)) ξ0 = 0 := fun i =>
      hdZ W (dZ (fun η'' => a η'' i)) hW (fun η' hη' => hdZ W (fun η'' => a η'' i) hW (hai i) η' hη') ξ0 hξ0
    have h7 : p ξ0 = 0 := hp ξ0 hξ0
    have h8 : dR B.h p ξ0 = 0 := hdR W p hW hp ξ0 hξ0
    have h9 : dZ p ξ0 = 0 := hdZ W p hW hp ξ0 hξ0
    have hl : ∀ i, mlapC B.h n (fun η'' => a η'' i) ξ0 = 0 := by
      intro i
      simp [mlapC, h1, h2, h5, h6]
    funext i
    fin_cases i <;> simp [mresC, h1, h2, h3, h4, hl, h7, h8, h9]
  have hlin0 : ∀ (γ : Lab) (m : ℤ), (γ ∉ Γ ∨ m ∉ HA ∪ Hp) → linC5 B G γ m (ptOf x t Y) = 0 := by
    intro γ m hγm
    have hW : IsOpen (interior N ∩ DomC B.h (qsOf l0)) := isOpen_interior.inter hDopen
    have hξW : ptOf x t Y ∈ interior N ∩ DomC B.h (qsOf l0) :=
      ⟨mem_interior_iff_mem_nhds.mpr hN, hxt⟩
    have hz : ∀ η ∈ interior N ∩ DomC B.h (qsOf l0),
        (primState5 B G).Aw γ m η = 0 ∧ (primState5 B G).pw γ m η = 0 :=
      fun η hη => hoff η (interior_subset hη.1) hη.2 γ m hγm
    have hc : ∀ η ∈ interior N ∩ DomC B.h (qsOf l0), cofA5 B G γ m η = 0 := by
      intro η hη
      simp only [cofA5, (hz η hη).1, smul_zero]
    have hp : ∀ η ∈ interior N ∩ DomC B.h (qsOf l0), cofP5 B G γ m η = 0 := by
      intro η hη
      simp only [cofP5, (hz η hη).2, mul_zero]
    have hmr := hres0 _ (m * pint5 B G γ) (mcurlC B.h (m * pint5 B G γ) (cofA5 B G γ m))
      (cofP5 B G γ m) (ptOf x t Y) hW hξW (hcurl0 _ _ _ hW hc) hp
    show (((qC B.h (ptOf x t Y) ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) *
        (Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (ptOf x t Y) : ℂ))))⁻¹) •
        mresC B (m * pint5 B G γ) (mcurlC B.h (m * pint5 B G γ) (cofA5 B G γ m)) (cofP5 B G γ m)
          (ptOf x t Y) = 0
    rw [hmr, smul_zero]

  have hradc : Continuous (fun w : ℝ³ × ℝ => rad w.1) := by
    unfold rad
    fun_prop
  have hOopen : IsOpen {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2 ∧
      ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y') ∈ interior N} := by
    rw [isOpen_iff_mem_nhds]
    intro w0 hw0
    have h1 : 0 < rad w0.1 := hw0.1.1
    have h2 : w0.2 < 1 := hw0.1.2.1
    have h3 : simScale B.h (w0.1 2) (1 - w0.2) < qsOf l0 := hw0.1.2.2
    have h4 : ptOf w0.1 w0.2 (Yph B.h (rad w0.1) w0.2 + Y') ∈ interior N := hw0.2
    have e1 : ∀ᶠ w in nhds w0, (0:ℝ) < rad w.1 :=
      continuousAt_const.eventually_lt hradc.continuousAt h1
    have e2 : ∀ᶠ w in nhds w0, w.2 < 1 :=
      continuousAt_snd.eventually_lt continuousAt_const h2
    have hmem2 : ((w0.1 2, 1 - w0.2) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ)) :=
      ⟨mem_univ _, show (0:ℝ) < 1 - w0.2 by linarith⟩
    have hc1 : ContinuousAt (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) w0 := by
      have h1' : ContinuousAt (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (w0.1 2, 1 - w0.2) :=
        (hok.1.2.2.2.1.contDiffAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds hmem2)).continuousAt
      have h2' : ContinuousAt (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) w0 := by fun_prop
      exact ContinuousAt.comp (x := w0) (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2)
        (f := fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) h1' h2'
    have e3 : ∀ᶠ w in nhds w0, simScale B.h (w.1 2) (1 - w.2) < qsOf l0 :=
      hc1.eventually_lt continuousAt_const h3
    have hPc : ContinuousAt (fun w : ℝ³ × ℝ => ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y')) w0 := by
      have hr1 : ContinuousAt (fun w : ℝ³ × ℝ => rad w.1 ^ drx B.h) w0 :=
        hradc.continuousAt.rpow_const (Or.inl h1.ne')
      have h4' : ContinuousAt (fun w : ℝ³ × ℝ => Yph B.h (rad w.1) w.2 + Y') w0 :=
        ((hr1.smul continuousAt_const).add (continuousAt_snd.smul continuousAt_const)).add
          continuousAt_const
      have h2'' : ContinuousAt (fun w : ℝ³ × ℝ => w.1 2) w0 := by fun_prop
      exact hradc.continuousAt.prodMk (h2''.prodMk (continuousAt_snd.prodMk h4'))
    have e4 : ∀ᶠ w in nhds w0, ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y') ∈ interior N :=
      hPc.preimage_mem_nhds (isOpen_interior.mem_nhds h4)
    filter_upwards [e1, e2, e3, e4] with w a1 a2 a3 a4
    exact ⟨⟨a1, a2, a3⟩, a4⟩
  have hpx : ptOf x t (Yph B.h (rad x) t + Y') = ptOf x t Y := by
    rw [hY']
    congr 1
    abel
  refine ⟨{w : ℝ³ × ℝ | corrOn B l0 w.1 w.2 ∧ ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y') ∈ interior N},
    Γ, HA ∪ Hp, hOopen, ?_, ?_, hlin0⟩
  · refine ⟨hxt, ?_⟩
    show ptOf x t (Yph B.h (rad x) t + Y') ∈ interior N
    rw [hpx]
    exact mem_interior_iff_mem_nhds.mpr hN
  · intro y s hys
    have hc : corrOn B l0 y s := hys.1
    have hi : ptOf y s (Yph B.h (rad y) s + Y') ∈ interior N := hys.2
    exact ⟨hc, hexpand y s hc (fun γ m h => hoff _ (interior_subset hi) hc γ m h)⟩

theorem plin5_mode_rep : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → InWg5 B G (qsOf l0) 1 (primState5 B G).Aw → InWg5 B G (qsOf l0) 1 (primState5 B G).pw → ∀ x t Y, corrOn B l0 x t → pwrLin B G l0 x t Y = qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2)) • cyl2cart x (waveV5 B G (linC5 B G) (thetaOf x) (ptOf x t Y)) :=
by

  have hsum : ∀ (F : Lab → ℤ → ℂ) (Γ : Finset Lab) (H : Finset ℤ),
      (∀ γ m, (γ ∉ Γ ∨ m ∉ H) → F γ m = 0) →
      ∑ᶠ γ : Lab, ∑ᶠ m : ℤ, F γ m = ∑ γ ∈ Γ, ∑ m ∈ H, F γ m := by
    intro F Γ H hF
    have hin : ∀ γ, ∑ᶠ m : ℤ, F γ m = ∑ m ∈ H, F γ m := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      rw [Function.mem_support] at hm
      by_contra h
      exact hm (hF γ m (Or.inr (by simpa using h)))
    simp_rw [hin]
    apply finsum_eq_sum_of_support_subset
    intro γ hγ
    rw [Function.mem_support] at hγ
    by_contra h
    exact hγ (Finset.sum_eq_zero (fun m _ => hF γ m (Or.inl (by simpa using h))))
  have hlapc : ∀ (F1 F2 : ℝ³ → ℝ³) (z : ℝ³), F1 =ᶠ[nhds z] F2 → Δ F1 z = Δ F2 z := by
    intro F1 F2 z h
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_stdOrthonormalBasis F1,
      InnerProductSpace.laplacian_eq_iteratedFDeriv_stdOrthonormalBasis F2]
    simp only [(h.iteratedFDeriv ℝ 2).eq_of_nhds]
  have hgradc : ∀ (F1 F2 : ℝ³ → ℝ) (z : ℝ³), F1 =ᶠ[nhds z] F2 → gradient F1 z = gradient F2 z := by
    intro F1 F2 z h
    simp only [gradient, h.fderiv_eq]
  have hcurlc : ∀ (F1 F2 : ℝ³ → ℝ³) (z : ℝ³), F1 =ᶠ[nhds z] F2 → curl3 F1 z = curl3 F2 z := by
    intro F1 F2 z h
    simp only [curl3, h.fderiv_eq]
  have hterm : ∀ (qe : ℝ) (E M X : ℂ), E ≠ 0 →
      ((((qe : ℂ) * E⁻¹) * M) * (E * X)).re = qe * (M * X).re := by
    intro qe E M X hE
    have e : (((qe : ℂ) * E⁻¹) * M) * (E * X) = (qe : ℂ) * (M * X) := by
      calc (((qe : ℂ) * E⁻¹) * M) * (E * X) = (qe : ℂ) * (M * X) * (E⁻¹ * E) := by ring
        _ = (qe : ℂ) * (M * X) := by rw [inv_mul_cancel₀ hE, mul_one]
    rw [e, Complex.re_ofReal_mul]

  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, ?_⟩
  intro l0 hl0 hAw hpw x t Y hxt
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  have hcorr : ∀ y s, corrOn B l0 y s → 0 < rad y ∧ s < 1 ∧ simScale B.h (y 2) (1 - s) < qsOf l0 :=
    fun y s h => h
  have hDm : ∀ η, η ∈ DomC B.h (qsOf l0) → 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < qsOf l0 :=
    fun η h => h
  have hcD : ∀ y s (Y0 : ℝ × ℝ), corrOn B l0 y s → ptOf y s Y0 ∈ DomC B.h (qsOf l0) :=
    fun y s Y0 h => h
  have hsimD : ∀ y s, corrOn B l0 y s → (y, s) ∈ simDomain B.h B.qB := by
    intro y s h
    have h' := hcorr y s h
    show s < 1 ∧ simScale B.h (y 2) (1 - s) < B.qB
    exact ⟨h'.2.1, lt_of_lt_of_le h'.2.2 hqsB⟩
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'

  have hfd : ∀ (f : Cyl → ℂ), ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ (fderiv ℝ f) (DomC B.h (qsOf l0)) := fun f hf =>
    hf.fderiv_of_isOpen hDopen (le_of_eq ENat.coe_top_add_one)
  have hdZ : ∀ (f : Cyl → ℂ), ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ (dZ f) (DomC B.h (qsOf l0)) := by
    intro f hf
    show ContDiffOn ℝ ∞ (fun ξ => fderiv ℝ f ξ (0, 1, 0, 0)) _
    exact (hfd f hf).clm_apply contDiffOn_const
  have hvec : ContDiffOn ℝ ∞ (fun ξ : Cyl => (((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) : Cyl))
      (DomC B.h (qsOf l0)) := by
    have h1 : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1 ^ (drx B.h - 1)) (DomC B.h (qsOf l0)) :=
      contDiffOn_fst.rpow_const_of_ne (fun ξ hξ => (hDm ξ hξ).1.ne')
    exact contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk
      ((contDiffOn_const.mul h1).smul contDiffOn_const)))
  have hdR : ∀ (f : Cyl → ℂ), ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ (dR B.h f) (DomC B.h (qsOf l0)) := by
    intro f hf
    show ContDiffOn ℝ ∞ (fun ξ => fderiv ℝ f ξ (1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) _
    exact (hfd f hf).clm_apply hvec
  have hinv : ContDiffOn ℝ ∞ (fun ξ : Cyl => ((ξ.1 : ℂ))⁻¹) (DomC B.h (qsOf l0)) :=
    (Complex.ofRealCLM.contDiff.comp contDiff_fst).contDiffOn.inv
      (fun ξ hξ => by simpa using (hDm ξ hξ).1.ne')
  have hmc : ∀ (n : ℤ) (c : Cyl → (Fin 3 → ℂ)), ContDiffOn ℝ ∞ c (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ (mcurlC B.h n c) (DomC B.h (qsOf l0)) := by
    intro n c hc
    have hci : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => c η i) (DomC B.h (qsOf l0)) :=
      contDiffOn_pi.1 hc
    have hk : ContDiffOn ℝ ∞ (fun ξ : Cyl => Complex.I * (n : ℂ) / (ξ.1 : ℂ)) (DomC B.h (qsOf l0)) := by
      simp only [div_eq_mul_inv]
      exact contDiffOn_const.mul hinv
    have hk2 : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun ξ : Cyl => c ξ i / (ξ.1 : ℂ)) (DomC B.h (qsOf l0)) := by
      intro i
      simp only [div_eq_mul_inv]
      exact (hci i).mul hinv
    refine contDiffOn_pi.2 (fun i => ?_)
    fin_cases i
    · show ContDiffOn ℝ ∞ (fun ξ => Complex.I * (n : ℂ) / (ξ.1 : ℂ) * c ξ 2 - dZ (fun η => c η 1) ξ) _
      exact (hk.mul (hci 2)).sub (hdZ _ (hci 1))
    · show ContDiffOn ℝ ∞ (fun ξ => dZ (fun η => c η 0) ξ - dR B.h (fun η => c η 2) ξ) _
      exact (hdZ _ (hci 0)).sub (hdR _ (hci 2))
    · show ContDiffOn ℝ ∞ (fun ξ => dR B.h (fun η => c η 1) ξ + c ξ 1 / (ξ.1 : ℂ)
        - Complex.I * (n : ℂ) / (ξ.1 : ℂ) * c ξ 0) _
      exact ((hdR _ (hci 1)).add (hk2 1)).sub (hk.mul (hci 0))

  obtain ⟨hub, hubs⟩ := ubase5_axisym B hok
  have hubU : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η => ubase B η i) (DomC B.h (qsOf l0)) := by
    intro i
    refine (hubs i).mono (fun η hη => ?_)
    have h' := hDm η hη
    show 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < B.qB
    exact ⟨h'.1, h'.2.1, lt_of_lt_of_le h'.2.2 hqsB⟩
  have hcof := plin5_cof_smooth B G hok hG l0 hqsB hAw hpw
  obtain ⟨O, Γ, H, hO, hxO, hOm, hvan⟩ := plin5_local_modes B G hok l0 hAw hpw x t Y hxt
  have hsl : ∀ y s, (y, s) ∈ O → {z : ℝ³ | (z, s) ∈ O} ∈ nhds y := fun y s h =>
    (hO.preimage (Continuous.prodMk continuous_id (continuous_const : Continuous fun _ : ℝ³ => s))).mem_nhds h
  have htl : {s : ℝ | (x, s) ∈ O} ∈ nhds t :=
    (hO.preimage (Continuous.prodMk (continuous_const : Continuous fun _ : ℝ => x) continuous_id)).mem_nhds hxO

  have hWS : ∀ y s, (y, s) ∈ O → evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) y s =
      ∑ k ∈ Γ ×ˢ H, mvec5 B.h (k.2 * pint5 B G k.1) (mcurlC B.h (k.2 * pint5 B G k.1) (cofA5 B G k.1 k.2))
        (Y - Yph B.h (rad x) t) y s := by
    intro y s hys
    have hc := (hOm y s hys).1
    have e1 : evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) y s =
        curl3 (fun z => evOff B.h (pwrA5 B G l0) (Y - Yph B.h (rad x) t) z s) y := by
      show curl3 (fun z => evOff B.h (pwrA5 B G l0)
        (Yph B.h (rad y) s + (Y - Yph B.h (rad x) t) - Yph B.h (rad y) s) z s) y = _
      rw [add_sub_cancel_left]
    rw [e1, hcurlc _ _ y (Filter.eventuallyEq_of_mem (hsl y s hys) (fun z hz => (hOm z s hz).2.1))]
    exact mode5_curl B.h (Γ ×ˢ H) (fun k => k.2 * pint5 B G k.1) (fun k => cofA5 B G k.1 k.2)
      (Y - Yph B.h (rad x) t) (DomC B.h (qsOf l0)) y s hDopen (fun η hη => (hDm η hη).1)
      (fun k _ => (hcof k.1 k.2).1) (hcorr y s hc).1 (hcD y s _ hc)

  have hL : pwrLin B G l0 x t Y =
      deriv (fun s => evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) x s) t
      - Δ (fun y => evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) y t) x
      + gradient (fun y => evOff B.h (pwrP5 B G l0) (Y - Yph B.h (rad x) t) y t) x
      + fderiv ℝ (fun y => evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) y t) x (uB B x t)
      + fderiv ℝ (fun y => uB B y t) x (evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) x t) := by
    show (deriv (fun s => evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) x s) t
        + fderiv ℝ (fun y => evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) y t) x
            (evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) x t)
        - (1:ℝ) • Δ (fun y => evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) y t) x
        + gradient (fun y => evOff B.h (pwrP5 B G l0) (Y - Yph B.h (rad x) t) y t) x)
      - fderiv ℝ (fun y => evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) y t) x
            (evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) x t)
      + fderiv ℝ (fun y => evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) y t) x (uB B x t)
      + fderiv ℝ (fun y => uB B y t) x (evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) x t) = _
    rw [one_smul]
    abel

  have hevx : (fun y => evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) y t) =ᶠ[nhds x]
      (fun y => ∑ k ∈ Γ ×ˢ H, mvec5 B.h (k.2 * pint5 B G k.1)
        (mcurlC B.h (k.2 * pint5 B G k.1) (cofA5 B G k.1 k.2)) (Y - Yph B.h (rad x) t) y t) :=
    Filter.eventuallyEq_of_mem (hsl x t hxO) (fun z hz => hWS z t hz)
  have hevt : (fun s => evOff B.h (pwrW5 B G l0) (Y - Yph B.h (rad x) t) x s) =ᶠ[nhds t]
      (fun s => ∑ k ∈ Γ ×ˢ H, mvec5 B.h (k.2 * pint5 B G k.1)
        (mcurlC B.h (k.2 * pint5 B G k.1) (cofA5 B G k.1 k.2)) (Y - Yph B.h (rad x) t) x s) :=
    Filter.eventuallyEq_of_mem htl (fun s hs => hWS x s hs)
  have hevp : (fun y => evOff B.h (pwrP5 B G l0) (Y - Yph B.h (rad x) t) y t) =ᶠ[nhds x]
      (fun y => ∑ k ∈ Γ ×ˢ H, msc5 B.h (k.2 * pint5 B G k.1) (cofP5 B G k.1 k.2) (Y - Yph B.h (rad x) t) y t) :=
    Filter.eventuallyEq_of_mem (hsl x t hxO) (fun z hz => (hOm z t hz).2.2)
  have hres := mode5_linres B (Γ ×ˢ H) (fun k => k.2 * pint5 B G k.1)
    (fun k => mcurlC B.h (k.2 * pint5 B G k.1) (cofA5 B G k.1 k.2)) (fun k => cofP5 B G k.1 k.2)
    (Y - Yph B.h (rad x) t) (DomC B.h (qsOf l0)) O x t hDopen hO (fun η hη => (hDm η hη).1) hxO
    (fun y s hys => ⟨(hcorr y s (hOm y s hys).1).1, hcD y s _ (hOm y s hys).1,
      hub y s _ (hsimD y s (hOm y s hys).1) (hcorr y s (hOm y s hys).1).1⟩)
    hubU (fun k _ => ⟨hmc _ _ (hcof k.1 k.2).1, (hcof k.1 k.2).2⟩)
  rw [hL, hevt.deriv_eq, hlapc _ _ x hevx, hgradc _ _ x hevp, hevx.fderiv_eq, hWS x t hxO]
  refine hres.trans ?_

  have hY : Yph B.h (rad x) t + (Y - Yph B.h (rad x) t) = Y := by abel
  have hq : 0 < qC B.h (ptOf x t Y) := (hok.1.1 (x 2) (1 - t) (by linarith [(hcorr x t hxt).2.1])).1
  have hcs : ∀ (f : Lab × ℤ → Fin 3 → ℝ), ∑ k ∈ Γ ×ˢ H, cyl2cart x (f k) =
      cyl2cart x (fun i => ∑ k ∈ Γ ×ˢ H, f k i) := by
    intro f
    simp only [cyl2cart, Finset.sum_add_distrib, Finset.sum_smul]
  have hscale : ∀ (c : ℝ) (v : Fin 3 → ℝ), cyl2cart x (fun i => c * v i) = c • cyl2cart x v := by
    intro c v
    simp only [cyl2cart, smul_add, mul_smul]
  have hwave : waveV5 B G (linC5 B G) (thetaOf x) (ptOf x t Y) = fun i =>
      qC B.h (ptOf x t Y) ^ (2 * Aex B.h + 1/2) * ∑ k ∈ Γ ×ˢ H,
        (mresC B (k.2 * pint5 B G k.1) (mcurlC B.h (k.2 * pint5 B G k.1) (cofA5 B G k.1 k.2))
          (cofP5 B G k.1 k.2) (ptOf x t Y) i *
          Complex.exp (Complex.I * ((k.2 * pint5 B G k.1 : ℤ) : ℂ) * (thetaOf x : ℂ))).re := by
    funext i
    simp only [waveV5]
    rw [hsum (fun γ m => linC5 B G γ m (ptOf x t Y) i * ephase5 B G γ m (thetaOf x) (ptOf x t Y)) Γ H
      (fun γ m h => by simp only [hvan γ m h, Pi.zero_apply, zero_mul]), Finset.sum_product,
      Complex.re_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun γ _ => ?_)
    rw [Complex.re_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    dsimp only
    have hE : Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (ptOf x t Y) : ℂ))) ≠ 0 :=
      Complex.exp_ne_zero _
    have hph : ephase5 B G γ m (thetaOf x) (ptOf x t Y) =
        Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (ptOf x t Y) : ℂ))) *
          Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf x : ℂ)) := by
      simp only [ephase5]
      rw [← Complex.exp_add]
      congr 1
      push_cast
      ring
    have hlin : linC5 B G γ m (ptOf x t Y) i =
        (((qC B.h (ptOf x t Y) ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) *
          (Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (ptOf x t Y) : ℂ))))⁻¹) *
        mresC B (m * pint5 B G γ) (mcurlC B.h (m * pint5 B G γ) (cofA5 B G γ m)) (cofP5 B G γ m)
          (ptOf x t Y) i := rfl
    rw [hph, hlin, hterm _ _ _ _ hE]
  rw [hwave]
  simp only [mvec5, hY]
  rw [hcs, hscale, smul_smul, ← Real.rpow_add hq, neg_add_cancel, Real.rpow_zero, one_smul]

theorem plin5_principal_support : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → InWg5 B G (qsOf l0) (1/2) (W0h4 B G) → (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), dotProduct (nPhi5 B G γ ξ) (W0c4 B G γ ξ) = 0) → ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), princC5 B G γ m ξ ≠ 0 → (m = 1 ∨ m = -1) ∧ SuppW B G γ ξ ∧ Lsb B.h G.r0 γ.1 / 5 ≤ |vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2| :=
by
  intro B G hok hG
  have hS : SimScaleProps B.h := hok.1
  obtain ⟨hh0, -, hXa, -, -, -, -, hqB0, hqB1, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 hW0 _htr γ m ξ hξ hne => ?_⟩
  have hr0 : 0 < G.r0 := hG.1.1
  have hr1 : G.r0 ≤ 1/100 := hG.1.2.1
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 < B.qB := by
    rw [hQb]
    exact lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  have hξB : ξ ∈ DomC B.h B.qB := ⟨hξ'.1, hξ'.2.1, hξ'.2.2.trans hqsB⟩
  have hq0 : 0 < qC B.h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have hqcont : ContinuousOn (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h4 := hS.2.2.2.1.continuousOn
    have hm : MapsTo (fun η : Cyl => (η.2.1, 1 - η.2.2.1)) {η : Cyl | η.2.2.1 < 1} (univ ×ˢ Ioi 0) := by
      intro η hη
      have hη' : η.2.2.1 < 1 := hη
