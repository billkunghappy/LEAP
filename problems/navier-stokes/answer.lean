      exact this
    have hcont : ContinuousOn ψ' W := by
      rw [hψ']
      exact (hψ.continuousOn_fderiv_of_isOpen hW (by simp)).clm_apply continuousOn_const
    obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = min (η - c) (d - η) / 2 := ⟨_, rfl⟩
