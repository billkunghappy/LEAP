  ring

theorem rfp_extB_I_cont : ∀ P : RfpPar, RfpRegime P → RfpClos P → ∀ x : ℝ, rfpXv P ≤ x → ContinuousOn (fun e => profRadInt (fun s e => 2 * s * rfpF P s e) x e) (Icc (-1) 1) :=
by
  intro P hReg hClos x hx
  have hxv0 : 0 < rfpXv P := by unfold rfpXv; exact Real.exp_pos _
  have hstar : ∀ s e : ℝ, 0 ≤ s → s ≤ rfpXv P →
      2 * s * rfpF P s e = (1 + e ^ 2)⁻¹ * (2 * s * rfpF P s 0) := by
    intro s e hs0 hs1
    rw [((pqc_rfp_rep P hReg).2.2.2.2 s e hs0 hs1).2,
      ((pqc_rfp_rep P hReg).2.2.2.2 s 0 hs0 hs1).2]
    simp
  have hFc : ContinuousOn (↿(rfpF P)) (Ioi 0 ×ˢ Ioo (-2) 2) :=
    (rfp_profile_regular P hReg hClos).1.continuousOn
  have hI0 : IntervalIntegrable (fun s => 2 * s * rfpF P s 0) MeasureTheory.volume 0 (rfpXv P) :=
    (((rfp_profile_regular P hReg hClos).2.2.2.2 0 (by norm_num) (by norm_num)).2.2.2.2
      (rfpXv P) hxv0.le).2.1
  let c : ℝ → ℝ := fun s => max (rfpXv P) (min x s)
  let k : ℝ → ℝ := fun e => max (-1) (min 1 e)
  have hc : Continuous c := continuous_const.max (continuous_const.min continuous_id)
  have hk : Continuous k := continuous_const.max (continuous_const.min continuous_id)
  let g : ℝ → ℝ → ℝ := fun e s => 2 * c s * rfpF P (c s) (k e)
  have hg : Continuous (Function.uncurry g) := by
    have hmap : Continuous (fun p : ℝ × ℝ => (c p.2, k p.1)) :=
      (hc.comp continuous_snd).prodMk (hk.comp continuous_fst)
    have hmem : ∀ p : ℝ × ℝ, (c p.2, k p.1) ∈ Ioi (0:ℝ) ×ˢ Ioo (-2:ℝ) 2 := by
      intro p
      refine ⟨lt_of_lt_of_le hxv0 (le_max_left _ _), ?_, ?_⟩
      · have : (-1:ℝ) ≤ k p.1 := le_max_left _ _
        linarith
      · have : k p.1 ≤ 1 := max_le (by norm_num) (min_le_left _ _)
        linarith
    have h1 : Continuous (fun p : ℝ × ℝ => (↿(rfpF P)) (c p.2, k p.1)) :=
      hFc.comp_continuous hmap hmem
    have h2 : Continuous (fun p : ℝ × ℝ => 2 * c p.2 * (↿(rfpF P)) (c p.2, k p.1)) :=
      (continuous_const.mul (hc.comp continuous_snd)).mul h1
    exact h2
  have hG : Continuous (fun e => ∫ s in (rfpXv P)..x, g e s) :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hg _ _
  have hH : Continuous (fun e : ℝ => (1 + e ^ 2)⁻¹ * (∫ s in (0:ℝ)..(rfpXv P), 2 * s * rfpF P s 0)
      + ∫ s in (rfpXv P)..x, g e s) := by
    refine Continuous.add (Continuous.mul ?_ continuous_const) hG
    have hq : Continuous (fun e : ℝ => 1 + e ^ 2) := continuous_const.add (continuous_id.pow 2)
    exact hq.inv₀ (fun e => by positivity)
  refine hH.continuousOn.congr ?_
  intro e he
  have hce : ∀ s ∈ Icc (rfpXv P) x, g e s = 2 * s * rfpF P s e := by
    intro s hs
    have h1 : c s = s := by
      show max (rfpXv P) (min x s) = s
      rw [min_eq_right hs.2, max_eq_right hs.1]
    have h2 : k e = e := by
      show max (-1) (min 1 e) = e
      rw [min_eq_right he.2, max_eq_right he.1]
    show 2 * c s * rfpF P (c s) (k e) = _
    rw [h1, h2]
  have hA : IntervalIntegrable (fun s => 2 * s * rfpF P s e) MeasureTheory.volume 0 (rfpXv P) := by
    refine (hI0.const_mul ((1 + e ^ 2)⁻¹)).congr ?_
    intro s hs
    rw [Set.uIoc_of_le hxv0.le] at hs
    exact (hstar s e hs.1.le hs.2).symm
  have hB : IntervalIntegrable (fun s => 2 * s * rfpF P s e) MeasureTheory.volume (rfpXv P) x := by
    have hgc : Continuous (fun s => g e s) := hg.comp (continuous_const.prodMk continuous_id)
    refine (hgc.intervalIntegrable _ _).congr ?_
    intro s hs
    have hs' : s ∈ Icc (rfpXv P) x := by
      have := Set.uIoc_subset_uIcc hs
      rwa [Set.uIcc_of_le hx] at this
    exact hce s hs'
  show (∫ s in (0:ℝ)..x, 2 * s * rfpF P s e) = _
  rw [← intervalIntegral.integral_add_adjacent_intervals hA hB]
  congr 1
  · rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr
    intro s hs
    rw [Set.uIcc_of_le hxv0.le] at hs
    exact hstar s e hs.1 hs.2
  · apply intervalIntegral.integral_congr
    intro s hs
    rw [Set.uIcc_of_le hx] at hs
    exact (hce s hs).symm

theorem rfp_extB_I_lower : ∀ P : RfpPar, RfpRegime P → RfpClos P → ∀ x : ℝ, Real.exp (rfpY6 P) ≤ x → x ≤ rfpXb P * Real.exp (-2) → x * (2 * x * rfpF P x 0) ≤ (1 - P.ρ) * ((1 - P.h) * profRadInt (fun s e => 2 * s * rfpF P s e) x 0) :=
by
  intro P hReg hClos x hx1 hx2
  have hReg' := hReg
  obtain ⟨_, _, hl0, hl1, hh0, hhl, hρ0, hρh, _, _⟩ := hReg'
  have hh1 : P.h < 1 := by nlinarith
  have hρ1 : P.ρ < 1 := by linarith
  have hx0 : 0 < x := lt_of_lt_of_le (Real.exp_pos _) hx1
  have hxb : 0 < rfpXb P := by unfold rfpXb; exact Real.exp_pos _
  have hci : 0 < rfpCi P := by
    unfold rfpCi; exact div_pos (Real.exp_pos _) (by linarith)
  have hsig : ∀ t : ℝ, sigA t ≤ 1 := by
    intro t
    unfold sigA
    split_ifs with h1 h2
    · norm_num
    · exact le_refl _
    · rw [div_le_one (by positivity)]
      linarith [Real.exp_pos (-1 / (1 - t) ^ 2)]
  have hT3 := (rfp_T_pointwise P hReg).2.2
  have hy6 : rfpY6 P = rfpY5 P.Md P.lam + 2 + P.T1 := rfl

  have htail : ∀ s : ℝ, x ≤ s →
      2 * s * rfpF P s 0 - Real.sqrt (2 * s) * rfpCi P * s ^ (-(1 / 2 + P.h)) ≤ 0 := by
    intro s hs
    have hs' : Real.exp (rfpY5 P.Md P.lam + 2 + P.T1) ≤ s := by rw [← hy6]; linarith
    rw [hT3 s 0 hs']
    apply neg_nonpos.2
    have hs0 : 0 ≤ s := by linarith
    have hσ := hsig ((Real.log (s / rfpXb P) + 2) / 2)
    exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (Real.sqrt_nonneg _) hci.le) hρ0.le)
      (Real.rpow_nonneg hs0 _)) (by linarith)

  have eT := (hClos.2.2.2.2.2.2.2 0 (by norm_num) (by norm_num)).2.2.2.1
  have R := rfp_T_slice_integrable P hReg 0 (by norm_num) (by norm_num)
    (hClos.2.2.2.2.2.1 0 (by norm_num) (by norm_num)).2
  have hgint : IntegrableOn (fun s => 2 * s * rfpF P s 0 -
      Real.sqrt (2 * s) * rfpCi P * s ^ (-(1 / 2 + P.h))) (Ioi 0) := R.1
  have hFint : IntervalIntegrable (fun s => 2 * s * rfpF P s 0) MeasureTheory.volume 0 x :=
    R.2 x hx0.le
  have hsplit : (∫ s in Ioi (0:ℝ), (2 * s * rfpF P s 0 -
      Real.sqrt (2 * s) * rfpCi P * s ^ (-(1 / 2 + P.h)))) =
      (∫ s in Ioc 0 x, (2 * s * rfpF P s 0 -
        Real.sqrt (2 * s) * rfpCi P * s ^ (-(1 / 2 + P.h)))) +
      ∫ s in Ioi x, (2 * s * rfpF P s 0 -
        Real.sqrt (2 * s) * rfpCi P * s ^ (-(1 / 2 + P.h))) := by
    rw [← Set.Ioc_union_Ioi_eq_Ioi hx0.le]
    exact MeasureTheory.setIntegral_union Set.Ioc_disjoint_Ioi_same measurableSet_Ioi
      (hgint.mono_set Set.Ioc_subset_Ioi_self) (hgint.mono_set (Set.Ioi_subset_Ioi hx0.le))
  have htailint : (∫ s in Ioi x, (2 * s * rfpF P s 0 -
        Real.sqrt (2 * s) * rfpCi P * s ^ (-(1 / 2 + P.h)))) ≤ 0 :=
    MeasureTheory.setIntegral_nonpos measurableSet_Ioi (fun s hs => htail s (le_of_lt hs))
  have hPH := power_head_integral (rfpCi P) P.h x hh0 hh1 hx0.le
  have hhead0 : 0 ≤ ∫ s in (0:ℝ)..x, (2 * s * rfpF P s 0 -
        Real.sqrt (2 * s) * rfpCi P * s ^ (-(1 / 2 + P.h))) := by
    rw [intervalIntegral.integral_of_le hx0.le]
    linarith
  rw [intervalIntegral.integral_sub hFint hPH.1, hPH.2] at hhead0
  have hI : profRadInt (fun s e => 2 * s * rfpF P s e) x 0 =
      ∫ s in (0:ℝ)..x, 2 * s * rfpF P s 0 := rfl
  have hhead : Real.sqrt 2 * rfpCi P * x ^ (1 - P.h) / (1 - P.h) ≤
      profRadInt (fun s e => 2 * s * rfpF P s e) x 0 := by
    rw [hI]; linarith

  have hpt := hT3 x 0 (by rw [← hy6]; exact hx1)
  have harg : (Real.log (x / rfpXb P) + 2) / 2 ≤ 0 := by
    have h1 : x / rfpXb P ≤ Real.exp (-2) := by
      rw [div_le_iff₀ hxb]; linarith [mul_comm (rfpXb P) (Real.exp (-2))]
    have h2 := Real.log_le_log (div_pos hx0 hxb) h1
    rw [Real.log_exp] at h2
    linarith
  have hs0 : sigA ((Real.log (x / rfpXb P) + 2) / 2) = 0 := by
    unfold sigA; rw [if_pos harg]
  rw [hs0] at hpt
  have hW : Real.sqrt (2 * x) * x ^ (-(1 / 2 + P.h)) = Real.sqrt 2 * x ^ (-P.h) := by
    rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2) x, Real.sqrt_eq_rpow x, mul_assoc,
      ← Real.rpow_add hx0]
    rw [show (1 / 2 : ℝ) + -(1 / 2 + P.h) = -P.h by ring]
  have hX : x * x ^ (-P.h) = x ^ (1 - P.h) := by
    rw [sub_eq_add_neg, Real.rpow_add hx0, Real.rpow_one]
  have hval : x * (2 * x * rfpF P x 0) = (1 - P.ρ) * (Real.sqrt 2 * rfpCi P * x ^ (1 - P.h)) := by
    have e : 2 * x * rfpF P x 0 = Real.sqrt (2 * x) * rfpCi P * x ^ (-(1 / 2 + P.h)) -
        Real.sqrt 2 * rfpCi P * P.ρ * x ^ (-P.h) * (1 - 0) := by linarith
    have e2 : Real.sqrt (2 * x) * rfpCi P * x ^ (-(1 / 2 + P.h)) =
        rfpCi P * (Real.sqrt 2 * x ^ (-P.h)) := by rw [← hW]; ring
    rw [e, e2, ← hX]
    ring
  rw [hval]
  apply mul_le_mul_of_nonneg_left _ (by linarith)
  rw [div_le_iff₀ (by linarith)] at hhead
  linarith

theorem rfp_extB_N_bound : ∀ P : RfpPar, RfpRegime P → ∀ x η : ℝ, Real.exp (rfpY6 P) ≤ x → x ≤ rfpXb P * Real.exp (-2) → -1 ≤ η → η ≤ 1 → |rfpExtN P x η| ≤ 3 * P.ρ * rfpE P (Real.log x) η ^ 2 :=
by
  intro P hReg x η hx1 hx2 h1 h2
  have hReg' := hReg
  obtain ⟨hMd, hPst, hl0, hl1, hh0, hhl, hρ0, hρh, hT1, hLh⟩ := hReg'
  have hxb : 0 < rfpXb P := Real.exp_pos _
  have hx0 : 0 < x := lt_of_lt_of_le (Real.exp_pos _) hx1
  have hlam2 : P.lam ^ 2 ≤ 1 / 10000 := by nlinarith
  have hρ1 : P.ρ ≤ 1 / 100 := by linarith

  have hsig : ∀ y, 0 ≤ sigA y ∧ sigA y ≤ 1 := by
    intro y
    unfold sigA
    split_ifs
    · norm_num
    · norm_num
    · have ha := Real.exp_pos (-1 / y ^ 2)
      have hb := Real.exp_pos (-1 / (1 - y) ^ 2)
      constructor
      · positivity
      · rw [div_le_one (by positivity)]
        linarith
  have hsigM : Measurable sigA := by
    have e : sigA = fun y => if y ≤ 0 then 0 else if 1 ≤ y then 1 else
        Real.exp (-1 / y ^ 2) / (Real.exp (-1 / y ^ 2) + Real.exp (-1 / (1 - y) ^ 2)) := by
      funext y; rfl
    rw [e]
    refine Measurable.ite measurableSet_Iic measurable_const
      (Measurable.ite measurableSet_Ici measurable_const ?_)
    fun_prop
  have htF : ∀ s, 1 - P.ρ ≤ tailFac P.ρ (rfpXb P) s ∧ tailFac P.ρ (rfpXb P) s ≤ 1 := by
    intro s
    unfold tailFac
    obtain ⟨a, b⟩ := hsig ((Real.log (s / rfpXb P) + 2) / 2)
    constructor
    · nlinarith [mul_nonneg hρ0.le a]
    · nlinarith [mul_nonneg hρ0.le (sub_nonneg.2 b)]

  have hlaw : ∀ s e : ℝ, Real.exp (rfpY6 P) ≤ s →
      s * rfpF P s e ^ 2 = rfpCi P ^ 2 / 2 * (tailFac P.ρ (rfpXb P) s ^ 2 * s ^ (-1 - 2 * P.h)) ∧
      rfpF P s e ^ 2 = rfpCi P ^ 2 / 2 * (tailFac P.ρ (rfpXb P) s ^ 2 * s ^ (-2 - 2 * P.h)) ∧
      rfpE P (Real.log s) e ^ 2 = rfpCi P ^ 2 * (tailFac P.ρ (rfpXb P) s ^ 2 * s ^ (-1 - 2 * P.h)) := by
    intro s e hs
    have hs0 : 0 < s := lt_of_lt_of_le (Real.exp_pos _) hs
    have hcl := (rfp_T_pointwise P hReg).2.2 s e hs
    have hsq : Real.sqrt (2 * s) * s ^ (-(1 / 2 + P.h)) = Real.sqrt 2 * s ^ (-P.h) := by
      rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2), Real.sqrt_eq_rpow s, mul_assoc,
        ← Real.rpow_add hs0, show (1:ℝ) / 2 + -(1 / 2 + P.h) = -P.h by ring]
    have hG : 2 * s * rfpF P s e = Real.sqrt 2 * rfpCi P * s ^ (-P.h) * tailFac P.ρ (rfpXb P) s := by
      unfold tailFac
      have h3 : Real.sqrt (2 * s) * rfpCi P * s ^ (-(1 / 2 + P.h)) =
          Real.sqrt 2 * rfpCi P * s ^ (-P.h) := by
        calc Real.sqrt (2 * s) * rfpCi P * s ^ (-(1 / 2 + P.h))
            = rfpCi P * (Real.sqrt (2 * s) * s ^ (-(1 / 2 + P.h))) := by ring
          _ = Real.sqrt 2 * rfpCi P * s ^ (-P.h) := by rw [hsq]; ring
      linear_combination hcl + h3
    have hpow : s ^ (-P.h) * s ^ (-P.h) = s ^ (-1 - 2 * P.h) * s := by
      rw [← Real.rpow_add hs0, ← Real.rpow_add_one hs0.ne']
      congr 1; ring
    have hpow2 : s ^ (-1 - 2 * P.h) = s ^ (-2 - 2 * P.h) * s := by
      rw [← Real.rpow_add_one hs0.ne']
      congr 1; ring
    have h2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    have hsq4 : (2 * s * rfpF P s e) ^ 2 =
        2 * rfpCi P ^ 2 * tailFac P.ρ (rfpXb P) s ^ 2 * (s ^ (-1 - 2 * P.h) * s) := by
      rw [hG]
      linear_combination (rfpCi P ^ 2 * (s ^ (-P.h)) ^ 2 * tailFac P.ρ (rfpXb P) s ^ 2) * h2 +
        (2 * rfpCi P ^ 2 * tailFac P.ρ (rfpXb P) s ^ 2) * hpow
    have hA : s * rfpF P s e ^ 2 =
        rfpCi P ^ 2 / 2 * (tailFac P.ρ (rfpXb P) s ^ 2 * s ^ (-1 - 2 * P.h)) := by
      have h4s : (4 * s) ≠ 0 := by positivity
      apply mul_right_cancel₀ h4s
      linear_combination hsq4
    have hB : rfpF P s e ^ 2 =
        rfpCi P ^ 2 / 2 * (tailFac P.ρ (rfpXb P) s ^ 2 * s ^ (-2 - 2 * P.h)) := by
      apply mul_right_cancel₀ hs0.ne'
      linear_combination hA + (rfpCi P ^ 2 / 2 * tailFac P.ρ (rfpXb P) s ^ 2) * hpow2
    have hne : Real.sqrt (2 * s) ≠ 0 := (Real.sqrt_pos.2 (by positivity)).ne'
    have hE1 : rfpE P (Real.log s) e = rfpF P s e * Real.sqrt (2 * s) := by
      unfold rfpF
      exact (div_mul_cancel₀ _ hne).symm
    have hsq2s : Real.sqrt (2 * s) ^ 2 = 2 * s := Real.sq_sqrt (by positivity)
    refine ⟨hA, hB, ?_⟩
    rw [hE1]
    linear_combination (rfpF P s e ^ 2) * hsq2s + 2 * hA

  obtain ⟨J1, hJ1⟩ : ∃ J : ℝ,
      J = ∫ s in Ioi x, tailFac P.ρ (rfpXb P) s ^ 2 * s ^ (-1 - 2 * P.h) := ⟨_, rfl⟩
  obtain ⟨J2, hJ2⟩ : ∃ J : ℝ,
      J = ∫ s in Ioi x, tailFac P.ρ (rfpXb P) s ^ 2 * s ^ (-2 - 2 * P.h) := ⟨_, rfl⟩
  have hS : ∀ e, rfpExtS P x e = rfpCi P ^ 2 / 2 * J1 := by
    intro e
    rw [hJ1, rfpExtS, ← integral_const_mul]
    refine setIntegral_congr_fun measurableSet_Ioi (fun s hs => ?_)
    exact (hlaw s e (le_trans hx1 (le_of_lt hs))).1
  have hPi : ∀ e, leadPi (rfpF P) x e = -(rfpCi P ^ 2 / 2 * J2) := by
    intro e
    rw [hJ2, leadPi, ← integral_const_mul]
    congr 1
    refine setIntegral_congr_fun measurableSet_Ioi (fun s hs => ?_)
    exact (hlaw s e (le_trans hx1 (le_of_lt hs))).2.1
  have hD1 : profEtaD (rfpExtS P) x η = 0 := by
    simp only [profEtaD, hS, deriv_const]
  have hD2 : profEtaD (leadPi (rfpF P)) x η = 0 := by
    simp only [profEtaD, hPi, deriv_const]
  have hN : rfpExtN P x η = 2 * η * rfpCi P ^ 2 * (P.h / x * J1 - (1 / 2 + P.h) * J2) := by
    unfold rfpExtN
    rw [hD1, hD2, hS η, hPi η]
    ring

  have ha1 : (-1 - 2 * P.h) < -1 := by linarith
  have ha2 : (-2 - 2 * P.h) < -1 := by linarith
  have hI1 : P.h / x * (∫ s in Ioi x, s ^ (-1 - 2 * P.h)) = x ^ (-1 - 2 * P.h) / 2 := by
    rw [integral_Ioi_rpow_of_lt ha1 hx0, Real.rpow_add_one hx0.ne',
      show (-1 - 2 * P.h + 1) = -(2 * P.h) by ring]
    have hhne : P.h ≠ 0 := hh0.ne'
    have hxne : x ≠ 0 := hx0.ne'
    field_simp
  have hI2 : (1 / 2 + P.h) * (∫ s in Ioi x, s ^ (-2 - 2 * P.h)) = x ^ (-1 - 2 * P.h) / 2 := by
    rw [integral_Ioi_rpow_of_lt ha2 hx0, show (-2 - 2 * P.h + 1) = (-1 - 2 * P.h) by ring]
    have hne : (-1 - 2 * P.h) ≠ 0 := (by linarith : -1 - 2 * P.h < 0).ne
    field_simp
    ring

  have hτM : Measurable (fun s => tailFac P.ρ (rfpXb P) s ^ 2) := by
    unfold tailFac; fun_prop
  have hτ1 : ∀ s, tailFac P.ρ (rfpXb P) s ^ 2 ≤ 1 := by
    intro s
    obtain ⟨t1, t2⟩ := htF s
    nlinarith
  have hτ0 : ∀ s, (1 - P.ρ) ^ 2 ≤ tailFac P.ρ (rfpXb P) s ^ 2 := by
    intro s
    exact pow_le_pow_left₀ (by linarith) (htF s).1 2
  have hint : ∀ a : ℝ, a < -1 →
      IntegrableOn (fun s => tailFac P.ρ (rfpXb P) s ^ 2 * s ^ a) (Ioi x) := by
    intro a ha
    refine Integrable.mono' (integrableOn_Ioi_rpow_of_lt ha hx0) ?_ ?_
    · exact (hτM.mul (by fun_prop)).aestronglyMeasurable
    · rw [ae_restrict_iff' measurableSet_Ioi]
      refine Filter.Eventually.of_forall (fun s hs => ?_)
      have hs0 : 0 < s := lt_trans hx0 hs
      have hp := Real.rpow_pos_of_pos hs0 a
      have hq : 0 ≤ tailFac P.ρ (rfpXb P) s ^ 2 := sq_nonneg _
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hq hp.le)]
      calc tailFac P.ρ (rfpXb P) s ^ 2 * s ^ a ≤ 1 * s ^ a :=
            mul_le_mul_of_nonneg_right (hτ1 s) hp.le
        _ = s ^ a := one_mul _
  have hsand : ∀ a : ℝ, a < -1 →
      (1 - P.ρ) ^ 2 * (∫ s in Ioi x, s ^ a) ≤
        (∫ s in Ioi x, tailFac P.ρ (rfpXb P) s ^ 2 * s ^ a) ∧
      (∫ s in Ioi x, tailFac P.ρ (rfpXb P) s ^ 2 * s ^ a) ≤ ∫ s in Ioi x, s ^ a := by
    intro a ha
    have hg := integrableOn_Ioi_rpow_of_lt ha hx0
    constructor
    · rw [← integral_const_mul]
      refine setIntegral_mono_on (Integrable.const_mul hg _) (hint a ha) measurableSet_Ioi ?_
      intro s hs
      have hs0 : 0 < s := lt_trans hx0 hs
      have hp := Real.rpow_pos_of_pos hs0 a
      exact mul_le_mul_of_nonneg_right (hτ0 s) hp.le
    · refine setIntegral_mono_on (hint a ha) hg measurableSet_Ioi ?_
      intro s hs
      have hs0 : 0 < s := lt_trans hx0 hs
      have hp := Real.rpow_pos_of_pos hs0 a
      calc tailFac P.ρ (rfpXb P) s ^ 2 * s ^ a ≤ 1 * s ^ a :=
            mul_le_mul_of_nonneg_right (hτ1 s) hp.le
        _ = s ^ a := one_mul _
  have hX : 0 < x ^ (-1 - 2 * P.h) := Real.rpow_pos_of_pos hx0 _
  obtain ⟨s1, s2⟩ := hsand _ ha1
  obtain ⟨r1, r2⟩ := hsand _ ha2
  rw [← hJ1] at s1 s2
  rw [← hJ2] at r1 r2
  have hhx : 0 ≤ P.h / x := by positivity
  have hA0 : 0 ≤ 1 / 2 + P.h := by linarith
  have u1 : (1 - P.ρ) ^ 2 * (x ^ (-1 - 2 * P.h) / 2) ≤ P.h / x * J1 := by
    rw [← hI1]
    calc (1 - P.ρ) ^ 2 * (P.h / x * ∫ s in Ioi x, s ^ (-1 - 2 * P.h))
        = P.h / x * ((1 - P.ρ) ^ 2 * ∫ s in Ioi x, s ^ (-1 - 2 * P.h)) := by ring
      _ ≤ P.h / x * J1 := mul_le_mul_of_nonneg_left s1 hhx
  have u2 : P.h / x * J1 ≤ x ^ (-1 - 2 * P.h) / 2 := by
    rw [← hI1]
    exact mul_le_mul_of_nonneg_left s2 hhx
  have v1 : (1 - P.ρ) ^ 2 * (x ^ (-1 - 2 * P.h) / 2) ≤ (1 / 2 + P.h) * J2 := by
    rw [← hI2]
    calc (1 - P.ρ) ^ 2 * ((1 / 2 + P.h) * ∫ s in Ioi x, s ^ (-2 - 2 * P.h))
        = (1 / 2 + P.h) * ((1 - P.ρ) ^ 2 * ∫ s in Ioi x, s ^ (-2 - 2 * P.h)) := by ring
      _ ≤ (1 / 2 + P.h) * J2 := mul_le_mul_of_nonneg_left r1 hA0
  have v2 : (1 / 2 + P.h) * J2 ≤ x ^ (-1 - 2 * P.h) / 2 := by
    rw [← hI2]
    exact mul_le_mul_of_nonneg_left r2 hA0
  have hD : |P.h / x * J1 - (1 / 2 + P.h) * J2| ≤ P.ρ * x ^ (-1 - 2 * P.h) := by
    have hq := mul_nonneg (sq_nonneg P.ρ) hX.le
    rw [abs_le]
    constructor <;> nlinarith

  have htFx : tailFac P.ρ (rfpXb P) x = 1 - P.ρ := by
    have hq : x / rfpXb P ≤ Real.exp (-2) := by
      rw [div_le_iff₀ hxb]; linarith
    have hl : Real.log (x / rfpXb P) ≤ -2 := by
      have := Real.log_le_log (div_pos hx0 hxb) hq
      rwa [Real.log_exp] at this
    have hs : sigA ((Real.log (x / rfpXb P) + 2) / 2) = 0 := by
      unfold sigA
      rw [if_pos (by linarith)]
    unfold tailFac
    rw [hs]; ring
  have hE2 := (hlaw x η hx1).2.2
  rw [hN, hE2, htFx, abs_mul]
  have hη : |η| ≤ 1 := abs_le.mpr ⟨h1, h2⟩
  have hc2 : 0 ≤ rfpCi P ^ 2 := sq_nonneg _
  have hcoef : |2 * η * rfpCi P ^ 2| ≤ 2 * rfpCi P ^ 2 := by
    rw [abs_mul, abs_mul, abs_of_nonneg hc2, abs_two]
    nlinarith [mul_le_mul_of_nonneg_right hη hc2]
  have hk : 2 ≤ 3 * (1 - P.ρ) ^ 2 := by nlinarith
  have hm : 0 ≤ P.ρ * rfpCi P ^ 2 * x ^ (-1 - 2 * P.h) := by positivity
  calc |2 * η * rfpCi P ^ 2| * |P.h / x * J1 - (1 / 2 + P.h) * J2|
      ≤ (2 * rfpCi P ^ 2) * (P.ρ * x ^ (-1 - 2 * P.h)) :=
        mul_le_mul hcoef hD (abs_nonneg _) (by positivity)
    _ ≤ 3 * P.ρ * (rfpCi P ^ 2 * ((1 - P.ρ) ^ 2 * x ^ (-1 - 2 * P.h))) := by
        nlinarith [mul_le_mul_of_nonneg_left hk hm]

theorem rfp_ext_regionB : rfpPref (fun P => ∀ x η : ℝ, Real.exp (rfpY6 P) ≤ x → x ≤ rfpXb P * Real.exp (-(5 / 2)) → -1 ≤ η → η ≤ 1 → 2 < shearA (rfpF P) x η ∧ 0 < rfpExtQ P x η ∧ (shearA (rfpF P) x η - 2) * (rfpExtN P x η / (Real.sqrt (2 * x) * rfpF P x η * rfpExtQ P x η)) ^ 2 ≤ 1) :=
by
  refine ⟨1, one_pos, ?_⟩
  intro Md _
  refine ⟨0, ?_⟩
  intro Pst _
  refine ⟨1 / 100, by norm_num, ?_⟩
  intro lam _ _
  have hm0 : 0 < max Pst 1 := lt_of_lt_of_le one_pos (le_max_right _ _)
  refine ⟨min (1 / 18) (1 / max Pst 1), lt_min (by norm_num) (div_pos one_pos hm0), ?_⟩
  intro P _ hPP _ hPh hReg hClos
  intro x η hx1 hx2 h1 h2
  have hReg' := hReg
  obtain ⟨_, hPst, hl0, hl1, hh0, _, hρ0, hρh, hT1, _⟩ := hReg'
  have hPst0 : 0 < P.Pst := lt_trans (Real.exp_pos _) hPst
  have hh18 : P.h ≤ 1 / 18 := le_trans hPh (min_le_left _ _)
  have hhM : P.h ≤ 1 / max P.Pst 1 := by rw [hPP]; exact le_trans hPh (min_le_right _ _)
  have hh1 : P.h ≤ 1 := by linarith
  have hρ1 : P.ρ < 1 := by linarith

  have hlogl : 0 ≤ Real.log (1 / P.lam) :=
    Real.log_nonneg (by rw [le_div_iff₀ hl0]; linarith)
  have hlogh : 0 ≤ Real.log (1 / P.h) :=
    Real.log_nonneg (by rw [le_div_iff₀ hh0]; linarith)
  have hT10 : 0 ≤ P.T1 := by linarith
  have hy56 : rfpY5 P.Md P.lam ≤ rfpY6 P := by unfold rfpY6; linarith
  have hy45 : rfpY4 P.Md P.lam ≤ rfpY5 P.Md P.lam := by unfold rfpY5; linarith
  have hx0 : 0 < x := lt_of_lt_of_le (Real.exp_pos _) hx1
  have hxX5 : Real.exp (rfpY5 P.Md P.lam) ≤ x := le_trans (Real.exp_le_exp.2 hy56) hx1
  have hxv : rfpXv P ≤ x := by
    unfold rfpXv; exact le_trans (Real.exp_le_exp.2 (le_trans hy45 hy56)) hx1
  have hxb : 0 < rfpXb P := by unfold rfpXb; exact Real.exp_pos _
  have hx2s : x < rfpXb P * Real.exp (-2) :=
    lt_of_le_of_lt hx2 (mul_lt_mul_of_pos_left (Real.exp_lt_exp.2 (by norm_num)) hxb)
  have hx2' : x ≤ rfpXb P * Real.exp (-2) := hx2s.le
  have hlogx : rfpY6 P ≤ Real.log x := by
    have := Real.log_le_log (Real.exp_pos _) hx1
    rwa [Real.log_exp] at this
  have hlogx5 : rfpY5 P.Md P.lam ≤ Real.log x := le_trans hy56 hlogx
  have hlogx2 : Real.log x ≤ rfpYb P.Md P.lam P.T1 P.Lh - 2 := by
    have e : rfpXb P * Real.exp (-2) = Real.exp (rfpYb P.Md P.lam P.T1 P.Lh - 2) := by
      unfold rfpXb; rw [sub_eq_add_neg, Real.exp_add]
    have := Real.log_le_log hx0 hx2'
    rwa [e, Real.log_exp] at this

  have hEfree : ∀ y e : ℝ, rfpY5 P.Md P.lam ≤ y → rfpE P y e = Real.exp (rfpLam P y) := by
    intro y e hy
    have hc := (rfp_clamp_identities P hReg).2.2.1 y e hy
    unfold rfpE
    rw [mul_assoc, hc, mul_one]
  have hFfree : ∀ s e : ℝ, Real.exp (rfpY5 P.Md P.lam) ≤ s → rfpF P s e = rfpF P s 0 := by
    intro s e hs
    have hl : rfpY5 P.Md P.lam ≤ Real.log s := by
      have := Real.log_le_log (Real.exp_pos _) hs
      rwa [Real.log_exp] at this
    unfold rfpF
    rw [hEfree _ e hl, hEfree _ 0 hl]
  have hs2x : 0 < Real.sqrt (2 * x) := Real.sqrt_pos.2 (by linarith)
  have hF0 : 0 < rfpF P x 0 := by
    unfold rfpF
    rw [hEfree _ _ hlogx5]
    exact div_pos (Real.exp_pos _) hs2x

  have hA : shearA (rfpF P) x η = 2 + 2 * P.h := rfp_extB_shearA P hReg x η hx1 hx2s

  obtain ⟨phi, hphi⟩ : ∃ phi : ℝ → ℝ,
      phi = fun e => profRadInt (fun s e => 2 * s * rfpF P s e) x e := ⟨_, rfl⟩
  have hint : ∀ e : ℝ, -1 < e → e < 1 → ∀ X : ℝ, 0 ≤ X →
      IntervalIntegrable (fun s => 2 * s * rfpF P s e) MeasureTheory.volume 0 X := by
    intro e he1 he2 X hX
    exact (((rfp_profile_regular P hReg hClos).2.2.2.2 e he1 he2).2.2.2.2 X hX).2.1
  have hsplit : ∀ e : ℝ, -1 < e → e < 1 → phi e =
      (∫ s in (0:ℝ)..Real.exp (rfpY5 P.Md P.lam), 2 * s * rfpF P s e) +
        ∫ s in Real.exp (rfpY5 P.Md P.lam)..x, 2 * s * rfpF P s e := by
    intro e he1 he2
    have hA' := hint e he1 he2 (Real.exp (rfpY5 P.Md P.lam)) (Real.exp_pos _).le
    have hB' := hint e he1 he2 x hx0.le
    rw [intervalIntegral.integral_add_adjacent_intervals hA' (hA'.symm.trans hB'), hphi]
    rfl
  have hphi_eq : ∀ e : ℝ, -1 < e → e < 1 → phi e = phi 0 := by
    intro e he1 he2
    rw [hsplit e he1 he2, hsplit 0 (by norm_num) (by norm_num),
      (hClos.2.2.2.2.2.2.2 e he1 he2).2.2.2.2]
    congr 1
    apply intervalIntegral.integral_congr
    intro s hs
    rw [Set.uIcc_of_le hxX5] at hs
    simp only
    rw [hFfree s e hs.1]
  have hphi_Icc : ∀ e ∈ Set.Icc (-1:ℝ) 1, phi e = phi 0 := by
    have hc : ContinuousOn phi (Set.Icc (-1) 1) := by
      rw [hphi]; exact rfp_extB_I_cont P hReg hClos x hxv
    have hEq : Set.EqOn phi (fun _ => phi 0) (Set.Ioo (-1) 1) := fun e he => hphi_eq e he.1 he.2
    exact hEq.of_subset_closure hc continuousOn_const Set.Ioo_subset_Icc_self
      (closure_Ioo (by norm_num : (-1:ℝ) ≠ 1)).symm.subset
  have hmem : η ∈ Set.Icc (-1:ℝ) 1 := ⟨h1, h2⟩
  have hderiv0 : deriv phi η = 0 := by
    by_cases hd : DifferentiableAt ℝ phi η
    · have hA1 : HasDerivWithinAt phi (deriv phi η) (Set.Icc (-1) 1) η :=
        hd.hasDerivAt.hasDerivWithinAt
      have hB1 : HasDerivWithinAt phi 0 (Set.Icc (-1) 1) η := by
        have hc : HasDerivWithinAt (fun _ : ℝ => phi 0) 0 (Set.Icc (-1) 1) η :=
          hasDerivWithinAt_const _ _ _
        exact hc.congr (fun e he => hphi_Icc e he) (hphi_Icc η hmem)
      exact (uniqueDiffOn_Icc (by norm_num : (-1:ℝ) < 1) η hmem).eq_deriv _ hA1 hB1
    · exact deriv_zero_of_not_differentiableAt hd
  have hQform : rfpExtQ P x η = -1 + (1 - P.h) * phi 0 / (x * (2 * x * rfpF P x 0)) := by
    have e1 : profRadInt (fun s e => 2 * s * rfpF P s e) x η = phi 0 := by
      rw [← hphi_Icc η hmem, hphi]
    have e2 : profEtaD (profRadInt (fun s e => 2 * s * rfpF P s e)) x η = 0 := by
      have hfun : (fun e => profRadInt (fun s e => 2 * s * rfpF P s e) x e) = phi := hphi.symm
      unfold profEtaD
      rw [hfun]
      exact hderiv0
    unfold rfpExtQ
    rw [e1, e2, hFfree x η hxX5]
    ring
  have hW : 0 < x * (2 * x * rfpF P x 0) := by positivity
  have hs8 : x * (2 * x * rfpF P x 0) ≤ (1 - P.ρ) * ((1 - P.h) * phi 0) := by
    rw [hphi]; exact rfp_extB_I_lower P hReg hClos x hx1 hx2'
  have hK : 0 < (1 - P.h) * phi 0 := by
    by_contra hc
    push_neg at hc
    have := mul_nonpos_of_nonneg_of_nonpos (by linarith : (0:ℝ) ≤ 1 - P.ρ) hc
    linarith
  have hQρ : P.ρ ≤ rfpExtQ P x η := by
    rw [hQform]
    have h3 : 1 + P.ρ ≤ (1 - P.h) * phi 0 / (x * (2 * x * rfpF P x 0)) := by
      rw [le_div_iff₀ hW]
      nlinarith [mul_le_mul_of_nonneg_left hs8 (by linarith : (0:ℝ) ≤ 1 + P.ρ),
        mul_nonneg (sq_nonneg P.ρ) hK.le]
    linarith
  have hQpos : 0 < rfpExtQ P x η := lt_of_lt_of_le hρ0 hQρ

  have hEy_eq : Real.sqrt (2 * x) * rfpF P x η = rfpE P (Real.log x) η := by
    unfold rfpF
    field_simp
  have hEy_pos : 0 < rfpE P (Real.log x) η := by
    rw [hEfree _ _ hlogx5]; exact Real.exp_pos _
  have hEy1 : rfpE P (Real.log x) η ≤ 1 := by
    have hsz := rfp_extB_E_size P hReg (Real.log x) η hlogx hlogx2
    have h6 : P.h ^ 6 ≤ P.h := by
      have h5 : P.h ^ 5 ≤ 1 := pow_le_one₀ hh0.le hh1
      calc P.h ^ 6 = P.h * P.h ^ 5 := by ring
        _ ≤ P.h * 1 := mul_le_mul_of_nonneg_left h5 hh0.le
        _ = P.h := mul_one _
    have hm : 0 < max P.Pst 1 := lt_of_lt_of_le one_pos (le_max_right _ _)
    have hhm : P.h * max P.Pst 1 ≤ 1 := (le_div_iff₀ hm).1 hhM
    have hPh1 : P.Pst * P.h ≤ 1 := by
      nlinarith [mul_le_mul_of_nonneg_right (le_max_left P.Pst 1) hh0.le]
    nlinarith [mul_le_mul_of_nonneg_left h6 hPst0.le]
  have hD : 0 < rfpE P (Real.log x) η * rfpExtQ P x η := mul_pos hEy_pos hQpos
  have hw : |rfpExtN P x η / (rfpE P (Real.log x) η * rfpExtQ P x η)| ≤ 3 := by
    rw [abs_div, abs_of_pos hD, div_le_iff₀ hD]
    have hN := rfp_extB_N_bound P hReg x η hx1 hx2' h1 h2
    have hρE : P.ρ * rfpE P (Real.log x) η ≤ rfpExtQ P x η :=
      le_trans (mul_le_of_le_one_right hρ0.le hEy1) hQρ
    calc |rfpExtN P x η| ≤ 3 * P.ρ * rfpE P (Real.log x) η ^ 2 := hN
      _ = 3 * rfpE P (Real.log x) η * (P.ρ * rfpE P (Real.log x) η) := by ring
      _ ≤ 3 * rfpE P (Real.log x) η * rfpExtQ P x η :=
          mul_le_mul_of_nonneg_left hρE (by linarith)
      _ = 3 * (rfpE P (Real.log x) η * rfpExtQ P x η) := by ring
  have hw2 : (rfpExtN P x η / (rfpE P (Real.log x) η * rfpExtQ P x η)) ^ 2 ≤ 9 := by
    rw [← sq_abs]
    nlinarith [abs_nonneg (rfpExtN P x η / (rfpE P (Real.log x) η * rfpExtQ P x η))]
  refine ⟨?_, hQpos, ?_⟩
  · rw [hA]; linarith
  · rw [hA, hEy_eq]
    have e3 : (2 + 2 * P.h - 2) = 2 * P.h := by ring
    rw [e3]
    nlinarith [mul_le_mul_of_nonneg_left hw2 (by linarith : (0:ℝ) ≤ 2 * P.h)]

theorem rfp_exterior_strict : rfpPref (fun P => ∀ x η : ℝ, rfpXv P ≤ x → x ≤ rfpXb P * Real.exp (-(5 / 2)) → -1 ≤ η → η ≤ 1 → RfpStrict True P.h (rfpF P) (rfpU P) x η) :=
by
  obtain ⟨MA, hMA, GA⟩ := rfp_ext_regionA
  obtain ⟨MB, hMB, GB⟩ := rfp_ext_regionB
  refine ⟨max MA MB, lt_max_of_lt_left hMA, ?_⟩
  intro Md hMd
  obtain ⟨PA, GA⟩ := GA Md (le_trans (le_max_left _ _) hMd)
  obtain ⟨PB, GB⟩ := GB Md (le_trans (le_max_right _ _) hMd)
  refine ⟨max PA PB, ?_⟩
  intro Pst hPst
  obtain ⟨lA, hlA, GA⟩ := GA Pst (le_trans (le_max_left _ _) hPst)
  obtain ⟨lB, hlB, GB⟩ := GB Pst (le_trans (le_max_right _ _) hPst)
  refine ⟨min lA lB, lt_min hlA hlB, ?_⟩
  intro lam hlam hlaml
  obtain ⟨hA, hhA, GA⟩ := GA lam hlam (le_trans hlaml (min_le_left _ _))
  obtain ⟨hB, hhB, GB⟩ := GB lam hlam (le_trans hlaml (min_le_right _ _))
  refine ⟨min hA hB, lt_min hhA hhB, ?_⟩
  intro P hPM hPP hPl hPh hReg hClos
  have RA := GA P hPM hPP hPl (le_trans hPh (min_le_left _ _)) hReg hClos
  have RB := GB P hPM hPP hPl (le_trans hPh (min_le_right _ _)) hReg hClos
  intro x η hx1 hx2 h1 h2

  have key : 2 < shearA (rfpF P) x η ∧ 0 < rfpExtQ P x η ∧
      (shearA (rfpF P) x η - 2) *
        (rfpExtN P x η / (Real.sqrt (2 * x) * rfpF P x η * rfpExtQ P x η)) ^ 2 ≤ 1 := by
    by_cases hx6 : x ≤ Real.exp (rfpY6 P)
    · exact RA x η hx1 hx6 h1 h2
    · exact RB x η (le_of_lt (not_le.1 hx6)) hx2 h1 h2
  obtain ⟨ha, hQ, hr⟩ := key

  obtain ⟨hb, hQs, hNs⟩ := rfp_ext_vanish P hReg hClos x η hx1 h1 h2

  have hx0 : 0 < x := lt_of_lt_of_le (by unfold rfpXv; exact Real.exp_pos _) hx1
  have hClos' := hClos
  obtain ⟨-, -, -, -, -, hca, -, -⟩ := hClos'
  have hcaη := (hca η (by linarith) (by linarith)).2 (Real.log x)
  have hsq : 0 < Real.sqrt (1 + P.ca η * rfpPsi P (Real.log x)) :=
    Real.sqrt_pos.2 (by have := (abs_le.1 hcaη).1; linarith)
  have hE : 0 < rfpE P (Real.log x) η := by
    unfold rfpE
    exact mul_pos (mul_pos (Real.exp_pos _) (Real.rpow_pos_of_pos (inv_pos.2 (by positivity)) _)) hsq
  have hs2x : 0 < Real.sqrt (2 * x) := Real.sqrt_pos.2 (by linarith)
  have hF : 0 < rfpF P x η := by unfold rfpF; exact div_pos hE hs2x
  have hReg' := hReg
  obtain ⟨-, -, hl0, hl1, hh0, hhl, -⟩ := hReg'
  have hL : 0 < 1 - 2 * P.h * η ^ 2 := by
    have hη2 : η ^ 2 ≤ 1 := by nlinarith
    have hlam2 : P.lam ^ 2 ≤ 1 / 10000 := by nlinarith
    have hh1 : P.h ≤ 1 / 10000 := le_trans hhl hlam2
    nlinarith [mul_le_mul_of_nonneg_left hη2 hh0.le]

  have hratio : psLead2 P.h (rfpF P) (rfpU P) x η / psLead1 P.h (rfpF P) (rfpU P) x η =
      rfpExtN P x η / (Real.sqrt (2 * x) * rfpF P x η * rfpExtQ P x η) := by
    unfold psLead1 psLead2
    rw [hQs, hNs]
    have hx0' : x ≠ 0 := hx0.ne'
    have hL' : 1 - 2 * P.h * η ^ 2 ≠ 0 := hL.ne'
    have hs' : Real.sqrt (2 * x) ≠ 0 := hs2x.ne'
    have hF' : rfpF P x η ≠ 0 := hF.ne'
    have hQ' : rfpExtQ P x η ≠ 0 := hQ.ne'
    field_simp
  have hp1 : 0 < psLead1 P.h (rfpF P) (rfpU P) x η := by
    unfold psLead1
    rw [hQs]
    exact div_pos (mul_pos hx0 hQ) hL
  refine ⟨hF, by linarith, hp1, ?_, ?_, fun _ => ?_⟩
  · rw [hb, zero_mul, sub_zero]; linarith
  · rw [hb, hratio]
    have h0 : (0:ℝ) ^ 2 / shearA (rfpF P) x η = 0 := by simp
    rw [h0]
    linarith
  · rw [hb, zero_div]
    simpa using ha

theorem ref_profile_exists : ∀ ρ0 ε0 : ℝ → ℝ, (∀ h, 0 < ρ0 h ∧ 0 < ε0 h) → ∃ (h lam Pst ρ cp ci xg xg2 r1 r2 k1 k2 p1 p2 m1 m2 xv xb μ : ℝ) (c ϑ : ℝ → ℝ) (F U : ℝ → ℝ → ℝ), Real.exp 10 < Pst ∧ ShapeData Pst c ϑ ∧ ρ ≤ ρ0 h ∧ RefProf h lam Pst ρ cp ci xg xg2 r1 r2 k1 k2 p1 p2 m1 m2 xv xb (ε0 h) μ c ϑ F U :=
by
  intro ρ0 ε0 hpos

  obtain ⟨M6, hM6, G6⟩ := rfp_relaxed_strict
  obtain ⟨M7, hM7, G7⟩ := rfp_pulse_strict
  obtain ⟨M8, hM8, G8⟩ := rfp_exterior_strict
  obtain ⟨Md, hMd⟩ : ∃ Md : ℝ, Md = max (max M6 M7) (max M8 1) := ⟨_, rfl⟩
  have hMd6 : M6 ≤ Md := by rw [hMd]; exact le_trans (le_max_left _ _) (le_max_left _ _)
  have hMd7 : M7 ≤ Md := by rw [hMd]; exact le_trans (le_max_right _ _) (le_max_left _ _)
  have hMd8 : M8 ≤ Md := by rw [hMd]; exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hMd1 : 1 ≤ Md := by rw [hMd]; exact le_trans (le_max_right _ _) (le_max_right _ _)
  have hMd0 : 0 < Md := by linarith
  obtain ⟨P1, G1⟩ := rfp_moment_closure Md hMd0
  obtain ⟨P6, G6⟩ := G6 Md hMd6
  obtain ⟨P7, G7⟩ := G7 Md hMd7
  obtain ⟨P8, G8⟩ := G8 Md hMd8
  obtain ⟨Pst, hPst⟩ : ∃ Pst : ℝ,
      Pst = max (max (max P1 P6) (max P7 P8)) 0 + Real.exp (Real.exp Md + 10) + 1 := ⟨_, rfl⟩
  have hEx : 0 < Real.exp (Real.exp Md + 10) := Real.exp_pos _
  have hq0 := le_max_right (max (max P1 P6) (max P7 P8)) 0
  have hq1 := le_max_left (max (max P1 P6) (max P7 P8)) 0
  have hq2 := le_max_left (max P1 P6) (max P7 P8)
  have hq3 := le_max_right (max P1 P6) (max P7 P8)
  have hPst1 : P1 ≤ Pst := by rw [hPst]; linarith [le_max_left P1 P6]
  have hPst6 : P6 ≤ Pst := by rw [hPst]; linarith [le_max_right P1 P6]
  have hPst7 : P7 ≤ Pst := by rw [hPst]; linarith [le_max_left P7 P8]
  have hPst8 : P8 ≤ Pst := by rw [hPst]; linarith [le_max_right P7 P8]
  have hPstE : Real.exp (Real.exp Md + 10) < Pst := by rw [hPst]; linarith
  have hPst10 : Real.exp 10 < Pst :=
    lt_of_le_of_lt (Real.exp_le_exp.2 (by linarith [Real.exp_pos Md])) hPstE
  obtain ⟨l1, hl1, G1⟩ := G1 Pst hPst1
  obtain ⟨l6, hl6, G6⟩ := G6 Pst hPst6
  obtain ⟨l7, hl7, G7⟩ := G7 Pst hPst7
  obtain ⟨l8, hl8, G8⟩ := G8 Pst hPst8
  obtain ⟨lam, hlam⟩ : ∃ lam : ℝ, lam = min (min l1 l6) (min l7 l8) := ⟨_, rfl⟩
  have hlam0 : 0 < lam := by rw [hlam]; exact lt_min (lt_min hl1 hl6) (lt_min hl7 hl8)
  have hlam1 : lam ≤ l1 := by rw [hlam]; exact le_trans (min_le_left _ _) (min_le_left _ _)
  have hlam6 : lam ≤ l6 := by rw [hlam]; exact le_trans (min_le_left _ _) (min_le_right _ _)
  have hlam7 : lam ≤ l7 := by rw [hlam]; exact le_trans (min_le_right _ _) (min_le_left _ _)
  have hlam8 : lam ≤ l8 := by rw [hlam]; exact le_trans (min_le_right _ _) (min_le_right _ _)
  obtain ⟨g1, hg1, G1⟩ := G1 lam hlam0 hlam1
  obtain ⟨g6, hg6, G6⟩ := G6 lam hlam0 hlam6
  obtain ⟨g7, hg7, G7⟩ := G7 lam hlam0 hlam7
  obtain ⟨g8, hg8, G8⟩ := G8 lam hlam0 hlam8
  obtain ⟨h, hh⟩ : ∃ h : ℝ, h = min (min g1 g6) (min g7 g8) := ⟨_, rfl⟩
  have hh0 : 0 < h := by rw [hh]; exact lt_min (lt_min hg1 hg6) (lt_min hg7 hg8)
  have hh1 : h ≤ g1 := by rw [hh]; exact le_trans (min_le_left _ _) (min_le_left _ _)
  have hh6 : h ≤ g6 := by rw [hh]; exact le_trans (min_le_left _ _) (min_le_right _ _)
  have hh7 : h ≤ g7 := by rw [hh]; exact le_trans (min_le_right _ _) (min_le_left _ _)
  have hh8 : h ≤ g8 := by rw [hh]; exact le_trans (min_le_right _ _) (min_le_right _ _)
  have hε : 0 < ε0 h := (hpos h).2
  obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = min (ρ0 h) (h / 800) := ⟨_, rfl⟩
  have hρ0 : 0 < ρ := by rw [hρ]; exact lt_min (hpos h).1 (by positivity)
  have hρle : ρ ≤ ρ0 h := by rw [hρ]; exact min_le_left _ _
  have hρh : ρ ≤ h / 800 := by rw [hρ]; exact min_le_right _ _

  obtain ⟨T1, hT1⟩ : ∃ T1 : ℝ, T1 = max (4 * Real.log (1 / h))
      (2 / 3 * (rfpL5 Md Pst lam - Real.log ((1 - ρ) * ε0 h))) := ⟨_, rfl⟩
  have hT1a : 4 * Real.log (1 / h) ≤ T1 := by rw [hT1]; exact le_max_left _ _
  have hT1b : 2 / 3 * (rfpL5 Md Pst lam - Real.log ((1 - ρ) * ε0 h)) ≤ T1 := by
    rw [hT1]; exact le_max_right _ _

  obtain ⟨P, hPMd, hPPst, hPlam, hPh, hPρ, hPT1, hReg, hClos⟩ :=
    G1 h ρ T1 hh0 hh1 hρ0 hρh hT1a
  have S6 := G6 P hPMd hPPst hPlam (by rw [hPh]; exact hh6) hReg hClos
  have S7 := G7 P hPMd hPPst hPlam (by rw [hPh]; exact hh7) hReg hClos
  have S8 := G8 P hPMd hPPst hPlam (by rw [hPh]; exact hh8) hReg hClos
  subst hPMd hPPst hPlam hPh hPρ hPT1
  have hh100 : P.h < 1 / 100 := by
    have hReg' := hReg
    obtain ⟨-, -, hl0, hl100, -, hhl, -⟩ := hReg'
    nlinarith [mul_le_mul_of_nonneg_left hl100 hl0.le]
  have hρ1 : P.ρ < 1 := by linarith

  obtain ⟨⟨o1, o2, o3, o4, o5, o6, o7, o8, o9, o10, o11, o12, hcp, hci⟩, sIn, sPat, sXv, sTail,
    sShape, sPi, sCol, sPos⟩ := rfp_profile_identities P hReg hClos
  obtain ⟨hFs, hUs, sCpt, sW, sInt⟩ := rfp_profile_regular P hReg hClos

  obtain ⟨hC1, hC2, hC3, hC4⟩ :=
    rfp_lead_continuous P.h (rfpF P) (rfpU P) hh0 hh100 hFs hUs sPos (fun m _ => sW m)

  have hbox : ∀ (adm : Prop) (x1 x2 : ℝ), 0 < x1 → x1 ≤ x2 →
      (∀ x η : ℝ, x1 ≤ x → x ≤ x2 → -1 ≤ η → η ≤ 1 → RfpStrict adm P.h (rfpF P) (rfpU P) x η) →
      ∃ μ0 : ℝ, 0 < μ0 ∧ μ0 ≤ 1 ∧ ∀ μ : ℝ, 0 < μ → μ ≤ μ0 →
        NMargin P.h μ (Icc x1 x2) (rfpF P) (rfpU P) adm := by
    intro adm x1 x2 hx1 hx12 hstr
    have hsub : Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1 ⊆ Ioi 0 ×ˢ Ioo (-3 / 2) (3 / 2) := by
      intro z hz
      exact ⟨lt_of_lt_of_le hx1 hz.1.1, by linarith [hz.2.1], by linarith [hz.2.2]⟩
    have hsub2 : Icc x1 x2 ×ˢ Icc (-1 : ℝ) 1 ⊆ Ioi 0 ×ˢ Ioo (-2) 2 := by
      intro z hz
      exact ⟨lt_of_lt_of_le hx1 hz.1.1, by linarith [hz.2.1], by linarith [hz.2.2]⟩
    exact rfp_nmargin_of_strict P.h x1 x2 (rfpF P) (rfpU P) adm hx1 hx12
      (hFs.continuousOn.mono hsub2) (hC1.mono hsub) (hC2.mono hsub) (hC3.mono hsub)
