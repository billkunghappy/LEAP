    refine (hD.congr_of_eventuallyEq ?_).congr_deriv ?_
    · filter_upwards [hmem] with v hv
      simp only [Pi.add_apply, Pi.sub_apply, Function.comp_apply]
      unfold rfpLam
      rw [hhold v hv.1, hcollar v hv.2]
      ring
    · rw [s2 y (by linarith), s2 (y - rfpY2 P.Md) (by linarith),
        s2 (y - rfpY5 P.Md P.lam) (by linarith), s2 (y - rfpY5 P.Md P.lam - 1 - P.T1) (by linarith)]
      ring

  have hmemF : Ioi (Real.exp (rfpY5 P.Md P.lam)) ∈ nhds x := by
    refine Ioi_mem_nhds (lt_of_lt_of_le (Real.exp_lt_exp.2 (by linarith)) hx1)
  have hb : ∀ t : ℝ, 1 ≤ t → rfpBmp t = 0 := by
    intro t ht
    unfold rfpBmp
    have h1 : 1 ≤ t / (3 / 20) := by rw [le_div_iff₀ (by norm_num)]; linarith
    rw [s1 (1 - t / (3 / 20)) (by linarith), mul_zero]
  have hF : (fun Y => rfpF P Y η) =ᶠ[nhds x]
      (fun Y => Real.exp (rfpLam P (Real.log Y)) / Real.sqrt (2 * Y)) := by
    filter_upwards [hmemF] with Y hY
    have hY' : Real.exp (rfpY5 P.Md P.lam) < Y := hY
    have hlY : rfpY5 P.Md P.lam ≤ Real.log Y := by
      have := Real.log_le_log (Real.exp_pos _) hY'.le
      rwa [Real.log_exp] at this
    have hth : rfpTh P (Real.log Y) = 0 := by
      unfold rfpTh
      rw [s2 _ (by rw [le_div_iff₀ (by norm_num)]; linarith)]
      ring
    have hpsi : rfpPsi P (Real.log Y) = 0 := by
      unfold rfpPsi
