    have h6 := mom_dgP_formula_v4 B (qsOf l0) (fun y => -((1 + y ^ 2) / B.cpatch)) Ψ
      (nrmS B (2 * Aex B.h - 3/2) Jt) hok hψm cΨ hJ.1 ξ hξ
    rw [hdPsi, hΨtd _ hx]
