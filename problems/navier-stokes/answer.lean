    have := mul_le_mul_of_nonneg_right hpow (Real.exp_pos (-9)).le
    linarith
  have hXRpos : 0 < 110 * (C * Pst) ^ 10 := by positivity

  have hCoef0 : AxCoef 0 (fun _ => 0) := by
