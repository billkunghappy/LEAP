  have hf2 : 0 < f0 r2 := (hf0le r2 hr12.le le_rfl).2.2
  have hf1 : 0 < f0 r1 := (hf0le r1 le_rfl hr12.le).2.2
  have hr20 : 0 < r2 := by linarith
  obtain ⟨Wb, hWb⟩ : ∃ t : ℝ, t = 2 * r2 + 2 * r2 * f0 r1 + 2 * f0 r1 := ⟨_, rfl⟩
  have hWb0 : 0 < Wb := by rw [hWb]; positivity
