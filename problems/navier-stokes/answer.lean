      _ ≤ |C| * qC B.h ξ ^ (B.h * (β' - β1)) := mul_le_mul_of_nonneg_left hmono (abs_nonneg C)
  have hB3' := inWg5_smul_mult B G l0 hok β1 (β' - β1)
    (fun γ m ξ => crossC (![0, 0, -1] : Fin 3 → ℂ) (c γ m ξ))
    (fun _ η => (((B.h * qC B.h η ^ (1/2:ℝ) * dZ (fun ζ => Real.log (qC B.h ζ)) η : ℝ)) : ℂ))
