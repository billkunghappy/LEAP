  have hE0 : 0 < E := by linarith
  have hT0 : 0 ≤ 3 / 10 * η ^ 2 + b / 10 := by positivity
  have hQT : 3 / 10 * η ^ 2 + b / 10 ≤ Q := by linarith
  have hQ0 : 0 < Q := by nlinarith [sq_nonneg η]
  have hEQ : 0 < E * Q := mul_pos hE0 hQ0
  have hT2 : 12 / 100 * η ^ 2 * b ≤ (3 / 10 * η ^ 2 + b / 10) ^ 2 := by
