        HasDerivAt (fun x => V (t * X) x) (deriv (fun e' => V (t * X) e') x) x := by
      refine Filter.Eventually.of_forall (fun t ht x hx => ?_)
      rw [hIoc] at ht
      exact (hVd (t * X) x (hsX t ht).1 (hsX t ht).2 hx.1 hx.2).1.hasDerivAt
    exact intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
