        refine ⟨fun x hx => (d4 Ψ hΨ hZ x hx).differentiableAt.differentiableWithinAt,
          fun h => absurd h (by simp), ?_⟩
        refine (ih Ψ' hD hDZ).congr (fun x hx => ?_)
        rw [(d4 Ψ hΨ hZ x hx).fderiv]
        simp only [hfun]
    exact ⟨contDiffOn_infty.2 (fun n => d6 n _ hF hFz), fun x hx => d3 _ hF hFz x hx,
