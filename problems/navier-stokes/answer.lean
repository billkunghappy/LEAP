    rw [map_zero, add_zero] at e1
    have hfac : (iteratedFDeriv ℝ i F ξu).compContinuousLinearMap (fun _ => (Lnorm B.h ξu).comp ι) =
        ((iteratedFDeriv ℝ i F ξu).compContinuousLinearMap (fun _ => Lnorm B.h ξu)).compContinuousLinearMap
