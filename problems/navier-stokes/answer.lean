  have gcoefΩ : ∀ f : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ f univ →
      osbGood (Ioi 0 ×ˢ Ioo (-1) 1) (Icc a X₂ ×ˢ Ioo (-1) 1) f :=
    fun f hf => good_coef univ (Icc a X₂ ×ˢ Icc (-1) 1) _ _ f isOpen_univ
