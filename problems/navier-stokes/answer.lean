      obtain ⟨k0, k1, k2⟩ := hKφ y
      have p01 := hφ01 y
      have p02 := hφ02 y
      have p12 := hφ12 y
      have key : Real.exp y * (rfpU P (Real.exp y) e ^ 2 - Real.exp y * rfpF P (Real.exp y) e ^ 2) =
          Real.exp y * rfpU P (Real.exp y) e ^ 2 - Real.exp y * (Real.exp y * rfpF P (Real.exp y) e ^ 2) := by
        ring
