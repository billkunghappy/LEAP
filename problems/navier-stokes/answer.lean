      exact Finset.single_le_sum (f := fun i => |Polynomial.eval c (descPochhammer ℝ i)|)
        (fun i _ => abs_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    have hFdB := norm_iteratedFDerivWithin_comp_le hg hψ (by exact_mod_cast le_top)
      isOpen_Ioi.uniqueDiffOn hO.uniqueDiffOn hψmaps h0O (C := A) (D := D) hCg hDψ
    obtain ⟨gl, hgldef⟩ : ∃ gl : ℝ →L[ℝ] ℝ, gl = a • ContinuousLinearMap.id ℝ ℝ := ⟨_, rfl⟩
    have hgl : ‖gl‖ ≤ a := ContinuousLinearMap.opNorm_le_bound _ ha0 (fun x => le_of_eq (by
      rw [hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, norm_smul,
        Real.norm_of_nonneg ha0]))
    have hEq : Set.EqOn (fun z => F (ξ + Lnorm B.h ξ z)) (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O := by
      intro z hz
      have hψz := hψpos z hz
      have e : qC B.h (ξ + Lnorm B.h ξ z) = qC B.h ξ * ψ z := by
        rw [hψdef]
        show _ = qC B.h ξ * (qC B.h (ξ + Lnorm B.h ξ z) / qC B.h ξ)
        field_simp
      show F (ξ + Lnorm B.h ξ z) = gl (ψ z ^ c)
      rw [hFdef, hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, smul_eq_mul]
      show qC B.h (ξ + Lnorm B.h ξ z) ^ c = a * ψ z ^ c
      rw [e, Real.mul_rpow hq0.le hψz.le, ← hadef]
    have hgψ : ContDiffOn ℝ ∞ ((fun x : ℝ => x ^ c) ∘ ψ) O := hg.comp hψ hψmaps
    have hNB : NB B.h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := by
      unfold NB
      rw [key F {η : Cyl | η.2.2.1 < 1} ξ (Lnorm B.h ξ) hU hFU hξ j]
    calc NB B.h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := hNB
      _ = ‖iteratedFDerivWithin ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) O 0‖ := by
          rw [iteratedFDerivWithin_of_isOpen j hO h0O]
      _ = ‖iteratedFDerivWithin ℝ j (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O 0‖ := by
          rw [iteratedFDerivWithin_congr hEq h0O j]
      _ = ‖gl.compContinuousMultilinearMap
            (iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0)‖ := by
          rw [ContinuousLinearMap.iteratedFDerivWithin_comp_left gl (hgψ.contDiffWithinAt h0O)
            hO.uniqueDiffOn h0O (i := j) (by exact_mod_cast le_top)]
      _ ≤ ‖gl‖ * ‖iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ a * ((j.factorial : ℝ) * A * D ^ j) := mul_le_mul hgl hFdB (norm_nonneg _) ha0
      _ = (j.factorial : ℝ) * A * D ^ j * a := by ring

  have hf1 : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η ^ (1/2:ℝ)) (DomC B.h qs) :=
    hqCs.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
  have hf2 : ContDiffOn ℝ ∞ (fun η : Cyl => η.1⁻¹) (DomC B.h qs) :=
    contDiff_fst.contDiffOn.inv (fun η (hη : η ∈ DomC B.h qs) =>
      (hη : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < qs).1.ne')

  have hinv : ∀ (ξ : Cyl), 0 < ξ.1 → ∀ l : ℕ, NB B.h (fun η : Cyl => η.1⁻¹) l ξ ≤
      (l.factorial : ℝ) * ξ.1⁻¹ ^ (l + 1) * Real.sqrt (qC B.h ξ) ^ l := by
    intro ξ hr l
    have hV : IsOpen {η : Cyl | 0 < η.1} := isOpen_lt continuous_const continuous_fst
    have hFV : ContDiffOn ℝ ∞ (fun η : Cyl => η.1⁻¹) {η : Cyl | 0 < η.1} :=
      contDiff_fst.contDiffOn.inv (fun η (hη : 0 < η.1) => hη.ne')
    obtain ⟨π, hπ⟩ : ∃ π : Cyl →L[ℝ] ℝ, π = ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)) := ⟨_, rfl⟩
    obtain ⟨s, hs⟩ : ∃ s : ℝ, s = Real.sqrt (qC B.h ξ) := ⟨_, rfl⟩
    have hs0 : 0 ≤ s := by rw [hs]; exact Real.sqrt_nonneg _
    have hfun : ∀ z : Cyl, (ξ + Lnorm B.h ξ z).1⁻¹ = (ξ.1 + (s • π) z)⁻¹ := by
      intro z; rw [hπ, hs]; simp [Lnorm]
    have hfunEq : (fun z : Cyl => (fun η : Cyl => η.1⁻¹) (ξ + Lnorm B.h ξ z)) =
        (fun z : Cyl => (Inv.inv : ℝ → ℝ) (ξ.1 + (s • π) z)) := funext hfun
    have hinvS : ContDiffOn ℝ ∞ (Inv.inv : ℝ → ℝ) (Set.Ioi 0) :=
      (contDiffOn_id (s := Set.Ioi (0:ℝ))).inv (fun x (hx : (0:ℝ) < x) => hx.ne')
    have e1 := key (fun η : Cyl => η.1⁻¹) {η : Cyl | 0 < η.1} ξ (Lnorm B.h ξ) hV hFV hr l
    have e2 := key (Inv.inv : ℝ → ℝ) (Set.Ioi 0) ξ.1 (s • π) isOpen_Ioi hinvS hr l
    have hNBeq : NB B.h (fun η : Cyl => η.1⁻¹) l ξ =
        ‖(iteratedFDeriv ℝ l (Inv.inv : ℝ → ℝ) ξ.1).compContinuousLinearMap (fun _ => s • π)‖ := by
      unfold NB
      rw [← e1, hfunEq, e2]
    rw [hNBeq, ← hs]
    refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
    have hπ1 : ‖π‖ ≤ 1 := by
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
      rw [hπ]
      show ‖η.1‖ ≤ 1 * ‖η‖
      rw [one_mul]
      exact norm_fst_le η
    have hn : ‖s • π‖ ≤ s := by
      rw [norm_smul, Real.norm_of_nonneg hs0]
      exact mul_le_of_le_one_right hs0 hπ1
    have hprod : ∏ _i : Fin l, ‖s • π‖ ≤ s ^ l := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_pow_left₀ (norm_nonneg _) hn l
    have hz : ξ.1 ^ ((-1 : ℤ) - (l : ℤ)) = ξ.1⁻¹ ^ (l + 1) := by
      rw [show ((-1 : ℤ) - (l : ℤ)) = -((l + 1 : ℕ) : ℤ) by push_cast; ring, zpow_neg, zpow_natCast,
        inv_pow]
    have hd : ‖iteratedFDeriv ℝ l (Inv.inv : ℝ → ℝ) ξ.1‖ = (l.factorial : ℝ) * ξ.1⁻¹ ^ (l + 1) := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate, iter_deriv_inv, hz,
        Real.norm_eq_abs, abs_mul, abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul, Nat.abs_cast,
        abs_of_pos (pow_pos (inv_pos.mpr hr) _)]
    rw [hd]
    exact mul_le_mul_of_nonneg_left hprod
      (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg (inv_nonneg.mpr hr.le) _))

  have hmbound : ∀ k : ℕ, ∃ M : ℝ, ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ →
      NB B.h (fun η : Cyl => qC B.h η ^ (1/2:ℝ) * η.1⁻¹) k ξ ≤ M := by
    intro k
    choose C hC using hqpow (1/2:ℝ)
    obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = (Real.sqrt (2 * B.Xa))⁻¹ := ⟨_, rfl⟩
    refine ⟨∑ i ∈ Finset.range (k + 1),
      (k.choose i : ℝ) * (|C i| * ((k - i).factorial : ℝ) * ρ ^ (k - i + 1)), ?_⟩
    intro ξ hξ hX
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    have hr : 0 < ξ.1 := hξ'.1
    have hq : 0 < qC B.h ξ := hqpos ξ hξ
    obtain ⟨s, hs⟩ : ∃ s : ℝ, s = Real.sqrt (qC B.h ξ) := ⟨_, rfl⟩
    have hs0 : 0 ≤ s := by rw [hs]; exact Real.sqrt_nonneg _
    have hqs : qC B.h ξ ^ (1/2:ℝ) = s := by rw [hs, Real.sqrt_eq_rpow]
    have h2X : 0 < Real.sqrt (2 * B.Xa) := Real.sqrt_pos.mpr (by linarith)
    have hX0 : B.Xa < ξ.1 ^ 2 / (2 * qC B.h ξ) := hX
    have hX' : B.Xa * (2 * qC B.h ξ) < ξ.1 ^ 2 := (lt_div_iff₀ (by linarith)).mp hX0
    have hkey : Real.sqrt (2 * B.Xa) * s ≤ ξ.1 := by
      rw [hs, ← Real.sqrt_mul (by linarith : (0:ℝ) ≤ 2 * B.Xa)]
      calc Real.sqrt (2 * B.Xa * qC B.h ξ) ≤ Real.sqrt (ξ.1 ^ 2) := Real.sqrt_le_sqrt (by linarith)
        _ = ξ.1 := Real.sqrt_sq hr.le
    have hsr : s * ξ.1⁻¹ ≤ ρ := by
      rw [hρ]
      calc s * ξ.1⁻¹ = (Real.sqrt (2 * B.Xa))⁻¹ * (Real.sqrt (2 * B.Xa) * s) * ξ.1⁻¹ := by
            rw [← mul_assoc, inv_mul_cancel₀ h2X.ne', one_mul]
        _ ≤ (Real.sqrt (2 * B.Xa))⁻¹ * ξ.1 * ξ.1⁻¹ :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hkey (inv_nonneg.mpr h2X.le))
              (inv_nonneg.mpr hr.le)
        _ = (Real.sqrt (2 * B.Xa))⁻¹ := by rw [mul_assoc, mul_inv_cancel₀ hr.ne', mul_one]
    have ht0 : 0 ≤ s * ξ.1⁻¹ := mul_nonneg hs0 (inv_nonneg.mpr hr.le)
    have hl := leib ξ (DomC B.h qs) k hDopen hξ (fun η : Cyl => qC B.h η ^ (1/2:ℝ))
      (fun η : Cyl => η.1⁻¹) (hf1.of_le (by exact_mod_cast le_top))
      (hf2.of_le (by exact_mod_cast le_top))
    refine le_trans hl (Finset.sum_le_sum (fun i hi => ?_))
    have b1 : NB B.h (fun η : Cyl => qC B.h η ^ (1/2:ℝ)) i ξ ≤ |C i| * s := by
      refine (hC i ξ hξ).trans ?_
      rw [hqs]
      exact mul_le_mul_of_nonneg_right (le_abs_self _) hs0
    have b2 := hinv ξ hr (k - i)
    rw [← hs] at b2
    have hpow : (s * ξ.1⁻¹) ^ (k - i + 1) ≤ ρ ^ (k - i + 1) := pow_le_pow_left₀ ht0 hsr _
    calc (k.choose i : ℝ) * NB B.h (fun η : Cyl => qC B.h η ^ (1/2:ℝ)) i ξ *
          NB B.h (fun η : Cyl => η.1⁻¹) (k - i) ξ
        ≤ (k.choose i : ℝ) * (|C i| * s) *
            (((k - i).factorial : ℝ) * ξ.1⁻¹ ^ (k - i + 1) * s ^ (k - i)) :=
          mul_le_mul (mul_le_mul_of_nonneg_left b1 (Nat.cast_nonneg _)) b2 (norm_nonneg _)
            (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (abs_nonneg _) hs0))
      _ = (k.choose i : ℝ) * (|C i| * ((k - i).factorial : ℝ) * (s * ξ.1⁻¹) ^ (k - i + 1)) := by
          ring
      _ ≤ (k.choose i : ℝ) * (|C i| * ((k - i).factorial : ℝ) * ρ ^ (k - i + 1)) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left hpow (mul_nonneg (abs_nonneg _) (Nat.cast_nonneg _)))
            (Nat.cast_nonneg _)

  have hmF : InM B qs α (fun ξ => (qC B.h ξ ^ (1/2:ℝ) * ξ.1⁻¹) * nrm B e f ξ) := by
    obtain ⟨F1, F2, F3, F4⟩ := hF
    have hm : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η ^ (1/2:ℝ) * η.1⁻¹) (DomC B.h qs) :=
      hf1.mul hf2
    refine ⟨hm.mul F1, ?_, ?_, ?_⟩
    · intro ξ hξ a ha
      show (qC B.h (shY ξ a) ^ (1/2:ℝ) * (shY ξ a).1⁻¹) * nrm B e f (shY ξ a) =
        (qC B.h ξ ^ (1/2:ℝ) * ξ.1⁻¹) * nrm B e f ξ
      rw [F2 ξ hξ a ha]
      rfl
    · intro ξ hξ hX
      show (qC B.h ξ ^ (1/2:ℝ) * ξ.1⁻¹) * nrm B e f ξ = 0
      rw [F3 ξ hξ hX, mul_zero]
    · intro k
      choose M hM using hmbound
      choose C b d hC using F4
      obtain ⟨Cs, hCs⟩ : ∃ Cs : ℝ, Cs = ∑ j ∈ Finset.range (k + 1), |C j| := ⟨_, rfl⟩
      obtain ⟨bs, hbs⟩ : ∃ bs : ℝ, bs = ∑ j ∈ Finset.range (k + 1), |b j| := ⟨_, rfl⟩
      obtain ⟨ds, hds⟩ : ∃ ds : ℝ, ds = ∑ j ∈ Finset.range (k + 1), |d j| := ⟨_, rfl⟩
      obtain ⟨Ms, hMs⟩ : ∃ Ms : ℝ, Ms = ∑ j ∈ Finset.range (k + 1), |M j| := ⟨_, rfl⟩
      have hCs0 : 0 ≤ Cs := by rw [hCs]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
      have hMs0 : 0 ≤ Ms := by rw [hMs]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
      have mem : ∀ j, j ≤ k → j ∈ Finset.range (k + 1) :=
        fun j hj => Finset.mem_range.mpr (Nat.lt_succ_of_le hj)
      have hCj : ∀ j, j ≤ k → C j ≤ Cs := fun j hj => (le_abs_self _).trans (by
        rw [hCs]; exact Finset.single_le_sum (f := fun j => |C j|) (fun j _ => abs_nonneg _) (mem j hj))
      have hbj : ∀ j, j ≤ k → b j ≤ bs := fun j hj => (le_abs_self _).trans (by
        rw [hbs]; exact Finset.single_le_sum (f := fun j => |b j|) (fun j _ => abs_nonneg _) (mem j hj))
      have hdj : ∀ j, j ≤ k → d j ≤ ds := fun j hj => (le_abs_self _).trans (by
        rw [hds]; exact Finset.single_le_sum (f := fun j => |d j|) (fun j _ => abs_nonneg _) (mem j hj))
      have hMj : ∀ j, j ≤ k → M j ≤ Ms := fun j hj => (le_abs_self _).trans (by
        rw [hMs]; exact Finset.single_le_sum (f := fun j => |M j|) (fun j _ => abs_nonneg _) (mem j hj))
      refine ⟨2 ^ k * Ms * Cs, bs, ds, fun ξ hξ hX1 hX2 => ?_⟩
      have hq : 0 < qC B.h ξ := hqpos ξ hξ
      have hS1 : 1 ≤ SC B.h ξ := by
        unfold SC
        exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h ξ))])
      have hE : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
        unfold edgeWeight
        split_ifs
        · exact (Real.exp_pos _).le
        · exact le_rfl
      have hδ0 : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) := by
        have hX : 0 < XC B.h ξ := lt_trans hXa hX1
        unfold edgeDist
        exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
          (Real.log_pos ((one_lt_div hX).mpr hX2)))
      have hδ1 : edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := min_le_left _ _
      have hqa : 0 ≤ qC B.h ξ ^ (B.h * α) := Real.rpow_nonneg hq.le _
      have p3 : 0 ≤ SC B.h ξ ^ bs := Real.rpow_nonneg (by linarith) _
      obtain ⟨W, hW⟩ : ∃ W : ℝ, W = qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bs *
          edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-ds) := ⟨_, rfl⟩
      have hFb : ∀ j, j ≤ k → NB B.h (nrm B e f) j ξ ≤ Cs * W := by
        intro j hj
        have h1 := hC j ξ hξ hX1 hX2
        have hb : SC B.h ξ ^ (b j) ≤ SC B.h ξ ^ bs := Real.rpow_le_rpow_of_exponent_le hS1 (hbj j hj)
        have hd : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d j) ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-ds) :=
          Real.rpow_le_rpow_of_exponent_ge hδ0 hδ1 (neg_le_neg (hdj j hj))
        have p1 : 0 ≤ SC B.h ξ ^ (b j) := Real.rpow_nonneg (by linarith) _
        have p2 : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d j) := Real.rpow_nonneg hδ0.le _
        calc NB B.h (nrm B e f) j ξ
            ≤ C j * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ (b j) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
                edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d j) := h1
          _ = C j * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ (b j) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
                edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d j)) := by ring
          _ ≤ Cs * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ (b j) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
                edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d j)) :=
              mul_le_mul_of_nonneg_right (hCj j hj)
                (mul_nonneg (mul_nonneg (mul_nonneg hqa p1) hE) p2)
          _ ≤ Cs * W := by
              rw [hW]
              refine mul_le_mul_of_nonneg_left ?_ hCs0
              exact mul_le_mul (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hb hqa) hE) hd p2
                (mul_nonneg (mul_nonneg hqa p3) hE)
      have hl := leib ξ (DomC B.h qs) k hDopen hξ (fun η : Cyl => qC B.h η ^ (1/2:ℝ) * η.1⁻¹)
        (nrm B e f) (hm.of_le (by exact_mod_cast le_top)) (F1.of_le (by exact_mod_cast le_top))
      calc NB B.h (fun ξ => (qC B.h ξ ^ (1/2:ℝ) * ξ.1⁻¹) * nrm B e f ξ) k ξ
          ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) *
              NB B.h (fun η : Cyl => qC B.h η ^ (1/2:ℝ) * η.1⁻¹) i ξ * NB B.h (nrm B e f) (k - i) ξ := hl
        _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * Ms * (Cs * W) := by
            apply Finset.sum_le_sum
            intro i hi
            have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
            exact mul_le_mul
              (mul_le_mul_of_nonneg_left ((hM i ξ hξ hX1).trans (hMj i hik)) (Nat.cast_nonneg _))
              (hFb _ (Nat.sub_le k i)) (norm_nonneg _) (mul_nonneg (Nat.cast_nonneg _) hMs0)
        _ = 2 ^ k * Ms * Cs * W := by
            rw [← Finset.sum_mul, ← Finset.sum_mul]
            have hs2 : ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) = 2 ^ k := by
              exact_mod_cast Nat.sum_range_choose k
            rw [hs2]; ring
        _ = 2 ^ k * Ms * Cs * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bs *
              edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-ds) := by
            rw [hW]; ring

  have heq : ∀ ξ ∈ DomC B.h qs, nrm B (e + 1/2) (fun ξ => f ξ / ξ.1) ξ =
      (qC B.h ξ ^ (1/2:ℝ) * ξ.1⁻¹) * nrm B e f ξ := by
    intro ξ hξ
    have hq : 0 < qC B.h ξ := hqpos ξ hξ
    simp only [nrm]
    rw [Real.rpow_add hq e (1/2), div_eq_mul_inv]
    ring
  obtain ⟨G1, G2, G3, G4⟩ := hmF
  refine ⟨G1.congr heq, ?_, ?_, ?_⟩
  · intro ξ hξ a ha
    rw [heq _ hξ, heq (shY ξ a) hξ]
    exact G2 ξ hξ a ha
  · intro ξ hξ hX
    rw [heq _ hξ]
    exact G3 ξ hξ hX
  · intro k
    obtain ⟨C, b, d, hC⟩ := G4 k
    refine ⟨C, b, d, fun ξ hξ hX1 hX2 => ?_⟩
    have hev : nrm B (e + 1/2) (fun ξ => f ξ / ξ.1) =ᶠ[nhds ξ]
        (fun ξ => (qC B.h ξ ^ (1/2:ℝ) * ξ.1⁻¹) * nrm B e f ξ) :=
      Filter.eventuallyEq_of_mem (hDopen.mem_nhds hξ) heq
    have hNBeq : NB B.h (nrm B (e + 1/2) (fun ξ => f ξ / ξ.1)) k ξ =
        NB B.h (fun ξ => (qC B.h ξ ^ (1/2:ℝ) * ξ.1⁻¹) * nrm B e f ξ) k ξ := by
      unfold NB
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    rw [hNBeq]
    exact hC ξ hξ hX1 hX2

theorem wmo_rc_yavg_v5 : ∀ (B : BG), B.ok → ∀ (qs : ℝ) (f : Cyl → ℝ) (e α : ℝ), InM B qs α (nrm B e f) → InM B qs α (nrm B e (yAvg f)) :=
by
  intro B hok qs f e α hF

  have PIC : ∀ {P E' F : Type} [NormedAddCommGroup P] [NormedSpace ℝ P]
      [FiniteDimensional ℝ P] [NormedAddCommGroup E'] [NormedSpace ℝ E'] [FiniteDimensional ℝ E']
      [MeasurableSpace E'] [BorelSpace E'] [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (μ : MeasureTheory.Measure E') [MeasureTheory.IsFiniteMeasureOnCompacts μ]
      (U : Set P) (V K : Set E') (G : P → E' → F) (hU : IsOpen U) (hV : IsOpen V) (hK : IsCompact K)
      (hKV : K ⊆ V) (hG : ContDiffOn ℝ ∞ (fun z : P × E' => G z.1 z.2) (U ×ˢ V)),
      ContDiffOn ℝ ∞ (fun x => ∫ y in K, G x y ∂μ) U ∧
      (∀ k : ℕ, ∀ x ∈ U, iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) x =
        ∫ y in K, iteratedFDeriv ℝ k (fun x' => G x' y) x ∂μ) := by
    intro P E' F _ _ _ _ _ _ _ _ _ _ _ μ _ U V K G hU hV hK hKV hG
    have hO : IsOpen (U ×ˢ V) := hU.prod hV
    have hKm : MeasurableSet K := hK.isClosed.measurableSet
    have slice : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F'] (H : P → E' → F'),
        ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) →
        ∀ x ∈ U, ContinuousOn (fun y => H x y) K := by
      intro F' _ _ H hH x hx
      have hc : Continuous (fun y : E' => ((x, y) : P × E')) := by fun_prop
      have h := ContinuousOn.comp (g := fun z : P × E' => H z.1 z.2) (f := fun y : E' => ((x, y) : P × E'))
        hH.continuousOn hc.continuousOn (fun y hy => ⟨hx, hKV hy⟩)
      exact h
    have param_fderiv : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F'] (H : P → E' → F'),
        ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) →
        ContDiffOn ℝ ∞ (fun z : P × E' => fderiv ℝ (fun x' => H x' z.2) z.1) (U ×ˢ V) := by
      intro F' _ _ H hH p hp
      have hHa : ContDiffAt ℝ ∞ (fun z : P × E' => H z.1 z.2) p := hH.contDiffAt (hO.mem_nhds hp)
      apply ContDiffAt.contDiffWithinAt
      have h1 : ContDiffAt ℝ ∞ (Function.uncurry (fun (q : P × E') (x' : P) => H x' q.2)) (p, p.1) := by
        have e : Function.uncurry (fun (q : P × E') (x' : P) => H x' q.2) =
            (fun z : P × E' => H z.1 z.2) ∘ (fun w : (P × E') × P => (w.2, w.1.2)) := rfl
        rw [e]
        apply ContDiffAt.comp (g := fun z : P × E' => H z.1 z.2) (p, p.1)
        · simpa using hHa
        · fun_prop
      exact ContDiffAt.fderiv (f := fun (q : P × E') (x' : P) => H x' q.2)
        (g := Prod.fst) h1 contDiffAt_fst (le_of_eq ENat.coe_top_add_one)
    have param_hasFDeriv : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F']
        (H : P → E' → F'), ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) → ∀ x ∈ U,
        HasFDerivAt (fun x' => ∫ y in K, H x' y ∂μ) (∫ y in K, fderiv ℝ (fun x' => H x' y) x ∂μ) x := by
      intro F' _ _ H hH x hx
      have hHs := param_fderiv H hH
      obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hU x hx
      have hsU : Metric.closedBall x (δ / 2) ⊆ U :=
        (Metric.closedBall_subset_ball (by linarith)).trans hball
      have hsn : Metric.closedBall x (δ / 2) ∈ nhds x := Metric.closedBall_mem_nhds x (by linarith)
      have hC : IsCompact (Metric.closedBall x (δ / 2) ×ˢ K) := (isCompact_closedBall _ _).prod hK
      have hCsub : Metric.closedBall x (δ / 2) ×ˢ K ⊆ U ×ˢ V := fun z hz => ⟨hsU hz.1, hKV hz.2⟩
      obtain ⟨Bd, hB⟩ := hC.exists_bound_of_continuousOn (hHs.continuousOn.mono hCsub)
      refine hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := μ.restrict K)
        (F := fun x' y => H x' y) (F' := fun x' y => fderiv ℝ (fun x'' => H x'' y) x')
        (bound := fun _ => Bd) hsn ?_ ?_ ?_ ?_ ?_ ?_
      · filter_upwards [hU.mem_nhds hx] with x' hx'
        exact (slice H hH x' hx').aestronglyMeasurable_of_isCompact hK hKm
      · exact (slice H hH x hx).integrableOn_compact hK
      · exact (slice (fun x' y => fderiv ℝ (fun x'' => H x'' y) x') hHs x hx).aestronglyMeasurable_of_isCompact
          hK hKm
      · exact ae_restrict_of_forall_mem hKm (fun y hy x' hx' => hB (x', y) ⟨hx', hy⟩)
      · exact continuousOn_const.integrableOn_compact hK
      · refine ae_restrict_of_forall_mem hKm (fun y hy x' hx' => ?_)
        have hHa : ContDiffAt ℝ ∞ (fun z : P × E' => H z.1 z.2) (x', y) :=
          hH.contDiffAt (hO.mem_nhds ⟨hsU hx', hKV hy⟩)
        have hc : ContDiffAt ℝ ∞ (fun x'' : P => ((x'', y) : P × E')) x' := by fun_prop
        have h2 := ContDiffAt.comp (g := fun z : P × E' => H z.1 z.2) x' hHa hc
        have : ContDiffAt ℝ ∞ (fun x'' => H x'' y) x' := h2
        exact (this.differentiableAt (by simp)).hasFDerivAt
    have hD0 : ∀ x y, iteratedFDeriv ℝ 0 (fun x' => G x' y) x =
        (continuousMultilinearCurryFin0 ℝ P F).symm (G x y) := by
      intro x y; rw [iteratedFDeriv_zero_eq_comp]; rfl
    have hDs : ∀ (k : ℕ) x y, iteratedFDeriv ℝ (k + 1) (fun x' => G x' y) x =
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm
          (fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') x) := by
      intro k x y; rw [iteratedFDeriv_succ_eq_comp_left]; rfl
    have D_smooth : ∀ k : ℕ, ContDiffOn ℝ ∞
        (fun z : P × E' => iteratedFDeriv ℝ k (fun x' => G x' z.2) z.1) (U ×ˢ V) := by
      intro k
      induction k with
      | zero =>
        have e : (fun z : P × E' => iteratedFDeriv ℝ 0 (fun x' => G x' z.2) z.1) =
            (continuousMultilinearCurryFin0 ℝ P F).symm ∘ (fun z : P × E' => G z.1 z.2) := by
          funext z; exact hD0 z.1 z.2
        rw [e]
        exact (continuousMultilinearCurryFin0 ℝ P F).symm.contDiff.comp_contDiffOn hG
      | succ k ih =>
        have e : (fun z : P × E' => iteratedFDeriv ℝ (k + 1) (fun x' => G x' z.2) z.1) =
            (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm ∘
              (fun z : P × E' => fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' z.2) x') z.1) := by
          funext z; exact hDs k z.1 z.2
        rw [e]
        have h2 := param_fderiv (fun x' y => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') ih
        exact (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm.contDiff.comp_contDiffOn h2
    have formula : ∀ k : ℕ, ∀ x ∈ U, iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) x =
        ∫ y in K, iteratedFDeriv ℝ k (fun x' => G x' y) x ∂μ := by
      intro k
      induction k with
      | zero =>
        intro x _
        rw [iteratedFDeriv_zero_eq_comp (f := fun x' => ∫ y in K, G x' y ∂μ)]
        simp only [hD0]
        exact (ContinuousLinearEquiv.integral_comp_comm
          (continuousMultilinearCurryFin0 ℝ P F).symm.toContinuousLinearEquiv (fun y => G x y)).symm
      | succ k ih =>
        intro x hx
        have hα : iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) =ᶠ[nhds x]
            (fun x' => ∫ y in K, iteratedFDeriv ℝ k (fun x'' => G x'' y) x' ∂μ) :=
          Filter.eventuallyEq_of_mem (hU.mem_nhds hx) ih
        have hβ := (param_hasFDeriv (fun x' y => iteratedFDeriv ℝ k (fun x'' => G x'' y) x')
          (D_smooth k) x hx).fderiv
        rw [iteratedFDeriv_succ_eq_comp_left (f := fun x' => ∫ y in K, G x' y ∂μ), Function.comp_apply,
          hα.fderiv_eq, hβ]
        simp only [hDs]
        have hL := ContinuousLinearEquiv.integral_comp_comm (μ := μ.restrict K) (𝕜 := ℝ)
          (E := P →L[ℝ] ContinuousMultilinearMap ℝ (fun _ : Fin k => P) F)
          (F := ContinuousMultilinearMap ℝ (fun _ : Fin (k + 1) => P) F)
          (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm.toContinuousLinearEquiv
          (fun y => fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') x)
        exact hL.symm
    have hsmooth : ContDiffOn ℝ ∞ (fun x => ∫ y in K, G x y ∂μ) U := by
      have key : ∀ m : ℕ, EqOn (iteratedFDerivWithin ℝ m (fun x => ∫ y in K, G x y ∂μ) U)
          (fun x => ∫ y in K, iteratedFDeriv ℝ m (fun x' => G x' y) x ∂μ) U := by
        intro m x hx
        rw [iteratedFDerivWithin_of_isOpen m hU hx]
        exact formula m x hx
      have hdiff : ∀ m : ℕ, DifferentiableOn ℝ
          (fun x => ∫ y in K, iteratedFDeriv ℝ m (fun x' => G x' y) x ∂μ) U :=
        fun m x hx => (param_hasFDeriv (fun x' y => iteratedFDeriv ℝ m (fun x'' => G x'' y) x')
          (D_smooth m) x hx).differentiableAt.differentiableWithinAt
      exact contDiffOn_of_continuousOn_differentiableOn (n := ⊤)
        (fun m _ => ((hdiff m).continuousOn).congr (key m))
        (fun m _ => (hdiff m).congr (key m))
    exact ⟨hsmooth, formula⟩

  have hDopen : IsOpen (DomC B.h qs) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio qs := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'

  have key : ∀ (F : Cyl → ℝ) (V : Set Cyl) (a : Cyl) (T : Cyl →L[ℝ] Cyl), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  have hM : ∀ ξ ∈ DomC B.h qs, ∀ Y : ℝ × ℝ, ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) ∈ DomC B.h qs :=
    fun ξ hξ Y => ⟨hξ.1, hξ.2.1, hξ.2.2⟩
  have hΦ : ContDiff ℝ ∞ (fun z : Cyl × (ℝ × ℝ) => ((z.1.1, z.1.2.1, z.1.2.2.1, z.2) : Cyl)) :=
    contDiff_fst.fst.prodMk (contDiff_fst.snd.fst.prodMk (contDiff_fst.snd.snd.fst.prodMk contDiff_snd))
  have hKc : IsCompact (Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
  obtain ⟨π, hπ⟩ : ∃ π : Cyl →L[ℝ] Cyl, ∀ w : Cyl, π w = (w.1, w.2.1, w.2.2.1, 0) :=
    ⟨(ContinuousLinearMap.id ℝ ℝ).prodMap ((ContinuousLinearMap.id ℝ ℝ).prodMap
      ((ContinuousLinearMap.id ℝ ℝ).prodMap (0 : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)))), fun w => rfl⟩
  have hcon : ∀ w : Cyl, ‖π w‖ ≤ ‖w‖ := by
    intro w
    rw [hπ]
    simp only [Prod.norm_def]
    refine max_le_max le_rfl (max_le_max le_rfl (max_le_max le_rfl ?_))
    exact le_trans (le_of_eq (by simp)) (le_max_of_le_left (norm_nonneg _))

  have NBle : ∀ (F : Cyl → ℝ), ContDiffOn ℝ ∞ F (DomC B.h qs) → ∀ ξ ∈ DomC B.h qs, ∀ (k : ℕ) (W : ℝ),
      (∀ Y : ℝ × ℝ, NB B.h F k (ξ.1, ξ.2.1, ξ.2.2.1, Y) ≤ W) → NB B.h (yAvg F) k ξ ≤ W := by
    intro F hFs ξ hξ k W hW
    have hGF : ContDiffOn ℝ ∞ (fun z : Cyl × (ℝ × ℝ) => F (z.1.1, z.1.2.1, z.1.2.2.1, z.2))
        (DomC B.h qs ×ˢ univ) :=
      hFs.comp hΦ.contDiffOn (fun z hz => hM z.1 hz.1 z.2)
    have hPF := PIC MeasureTheory.volume (DomC B.h qs) univ (Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1)
      (fun x Y => F (x.1, x.2.1, x.2.2.1, Y)) hDopen isOpen_univ hKc (subset_univ _) hGF
    have hformula : iteratedFDeriv ℝ k (yAvg F) ξ = ∫ Y in Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1,
        iteratedFDeriv ℝ k (fun x : Cyl => F (x.1, x.2.1, x.2.2.1, Y)) ξ := hPF.2 k ξ hξ
    have hN0 : 0 ≤ NB B.h F k (ξ.1, ξ.2.1, ξ.2.2.1, 0) := norm_nonneg _
    have hW0 : 0 ≤ W := le_trans hN0 (hW 0)
    have hcomm : ∀ (Y : ℝ × ℝ) (w : Cyl),
        π (Lnorm B.h ξ w) = Lnorm B.h (ξ.1, ξ.2.1, ξ.2.2.1, Y) (π w) := by
      intro Y w
      show π (Lnorm B.h ξ w) = Lnorm B.h ξ (π w)
      rw [hπ, hπ]
      simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have hslice : ∀ Y : ℝ × ℝ, iteratedFDeriv ℝ k (fun x : Cyl => F (x.1, x.2.1, x.2.2.1, Y)) ξ =
        (iteratedFDeriv ℝ k F (ξ.1, ξ.2.1, ξ.2.2.1, Y)).compContinuousLinearMap (fun _ => π) := by
      intro Y
      have e4 : iteratedFDeriv ℝ k (fun z : Cyl => F ((ξ + z).1, (ξ + z).2.1, (ξ + z).2.2.1, Y)) 0 =
          iteratedFDeriv ℝ k (fun x : Cyl => F (x.1, x.2.1, x.2.2.1, Y)) ξ := by
        have := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := fun x : Cyl => F (x.1, x.2.1, x.2.2.1, Y)) k ξ 0
        rw [add_zero] at this
        exact this
      have efun : (fun z : Cyl => F ((ξ + z).1, (ξ + z).2.1, (ξ + z).2.2.1, Y)) =
          fun z => F ((ξ.1, ξ.2.1, ξ.2.2.1, Y) + π z) := by
        funext z
        rw [hπ]
        simp only [Prod.mk_add_mk, Prod.fst_add, Prod.snd_add, add_zero]
      rw [← e4, efun]
      exact key F (DomC B.h qs) _ π hDopen hFs (hM ξ hξ Y) k
    have hpt : ∀ (Y : ℝ × ℝ) (v : Fin k → Cyl),
        ‖iteratedFDeriv ℝ k (fun x : Cyl => F (x.1, x.2.1, x.2.2.1, Y)) ξ (fun i => Lnorm B.h ξ (v i))‖ ≤
          W * ∏ i, ‖v i‖ := by
      intro Y v
      rw [hslice Y]
      simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      have e : (fun i => π (Lnorm B.h ξ (v i))) =
          fun i => Lnorm B.h (ξ.1, ξ.2.1, ξ.2.2.1, Y) (π (v i)) := by
        funext i; exact hcomm Y (v i)
      rw [e]
      have e2 : (iteratedFDeriv ℝ k F (ξ.1, ξ.2.1, ξ.2.2.1, Y))
            (fun i => Lnorm B.h (ξ.1, ξ.2.1, ξ.2.2.1, Y) (π (v i))) =
          ((iteratedFDeriv ℝ k F (ξ.1, ξ.2.1, ξ.2.2.1, Y)).compContinuousLinearMap
            (fun _ => Lnorm B.h (ξ.1, ξ.2.1, ξ.2.2.1, Y))) (fun i => π (v i)) := by
        rw [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      rw [e2]
      calc _ ≤ NB B.h F k (ξ.1, ξ.2.1, ξ.2.2.1, Y) * ∏ i, ‖π (v i)‖ :=
            ContinuousMultilinearMap.le_opNorm _ _
        _ ≤ W * ∏ i, ‖v i‖ :=
            mul_le_mul (hW Y) (by gcongr with i; exact hcon (v i))
              (Finset.prod_nonneg (fun i _ => norm_nonneg _)) hW0
    unfold NB
    rw [hformula]
    refine ContinuousMultilinearMap.opNorm_le_bound hW0 (fun v => ?_)
    simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    by_cases hint : MeasureTheory.Integrable
        (fun Y => iteratedFDeriv ℝ k (fun x : Cyl => F (x.1, x.2.1, x.2.2.1, Y)) ξ)
        (MeasureTheory.volume.restrict (Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1))
    · rw [ContinuousMultilinearMap.integral_apply hint]
      have hvol : MeasureTheory.volume (Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1) = 1 := by
        rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod, Real.volume_Icc]
        simp
      calc _ ≤ (W * ∏ i, ‖v i‖) * (MeasureTheory.volume.real (Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1)) :=
            MeasureTheory.norm_setIntegral_le_of_norm_le_const (by rw [hvol]; exact ENNReal.one_lt_top)
              (fun Y _ => hpt Y v)
        _ = W * ∏ i, ‖v i‖ := by rw [MeasureTheory.measureReal_def, hvol]; simp
    · rw [MeasureTheory.integral_undef hint]
      simp only [ContinuousMultilinearMap.zero_apply, norm_zero]
      exact mul_nonneg hW0 (Finset.prod_nonneg (fun i _ => norm_nonneg _))

  have hid : nrm B e (yAvg f) = yAvg (nrm B e f) := by
    funext ξ
    show qC B.h ξ ^ e * (∫ Y in Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1, f (ξ.1, ξ.2.1, ξ.2.2.1, Y)) =
      ∫ Y in Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1, qC B.h ξ ^ e * f (ξ.1, ξ.2.1, ξ.2.2.1, Y)
    exact (MeasureTheory.integral_const_mul _ _).symm
  rw [hid]
  obtain ⟨hs, -, hshell, hbd⟩ := hF
  have hG : ContDiffOn ℝ ∞ (fun z : Cyl × (ℝ × ℝ) => nrm B e f (z.1.1, z.1.2.1, z.1.2.2.1, z.2))
      (DomC B.h qs ×ˢ univ) :=
    hs.comp hΦ.contDiffOn (fun z hz => hM z.1 hz.1 z.2)
  have hP := PIC MeasureTheory.volume (DomC B.h qs) univ (Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1)
    (fun x Y => nrm B e f (x.1, x.2.1, x.2.2.1, Y)) hDopen isOpen_univ hKc (subset_univ _) hG
  refine ⟨hP.1, fun ξ _ a _ => rfl, ?_, ?_⟩
  · intro ξ hξ hX
    show ∫ Y in Icc (0:ℝ) 1 ×ˢ Icc (0:ℝ) 1, nrm B e f (ξ.1, ξ.2.1, ξ.2.2.1, Y) = 0
    exact MeasureTheory.setIntegral_eq_zero_of_forall_eq_zero (fun Y _ => hshell _ (hM ξ hξ Y) hX)
  · intro k
    obtain ⟨C, b, d, hC⟩ := hbd k
    refine ⟨C, b, d, fun ξ hξ hX1 hX2 => ?_⟩
    exact NBle (nrm B e f) hs ξ hξ k
      (C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
        edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d))
      (fun Y => hC _ (hM ξ hξ Y) hX1 hX2)

theorem wmo_radial_calculus_v5 : ∀ (B : BG), B.ok → SimNorm B.h → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (f : Cyl → ℝ) (e α : ℝ), InM B (qsOf l0) α (nrm B e f) →
      InM B (qsOf l0) (α - kapS) (nrm B (e + 1/2) (dR B.h f)) ∧
      InM B (qsOf l0) (α + 1 - kapS) (nrm B (e + 1/2) (dZ f)) ∧
      InM B (qsOf l0) α (nrm B (e + 1/2) (fun ξ => f ξ / ξ.1)) ∧
      InM B (qsOf l0) α (nrm B e (yAvg f)) ∧
      (∀ (g : Cyl → ℝ) (β : ℝ), InM B (qsOf l0) β (nrm B e g) →
        ∀ ξ ∈ DomC B.h (qsOf l0), yAvg (fun η => f η + g η) ξ = yAvg f ξ + yAvg g ξ) :=
by
  intro B hok hSN
  refine ⟨7, ?_⟩
  intro l0 hl0 f e α hF
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  have hqs0 : 0 < qsOf l0 := by
    show (0:ℝ) < (2:ℝ) ^ (-(l0:ℝ))
    positivity
  refine ⟨wmo_rc_dR_v5 B hok hSN l0 hl0 f e α hF, wmo_rc_dZ_v5 B hok hSN l0 hl0 f e α hF,
    wmo_rc_divr_v5 B hok hSN (qsOf l0) hqs0 hqs1 f e α hF, wmo_rc_yavg_v5 B hok (qsOf l0) f e α hF, ?_⟩
  intro g β hg ξ hξ
  have hq : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).1
  have hne : qC B.h ξ ^ e ≠ 0 := (Real.rpow_pos_of_pos hq e).ne'
  have hι : Continuous (fun Y : ℝ × ℝ => ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl)) := by fun_prop
  have hmem : ∀ Y : ℝ × ℝ, ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) ∈ DomC B.h (qsOf l0) :=
    fun Y => ⟨hξ.1, hξ.2.1, hξ.2.2⟩
  have hfeq : ∀ (k : Cyl → ℝ) (Y : ℝ × ℝ),
      nrm B e k ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl) / qC B.h ξ ^ e = k (ξ.1, ξ.2.1, ξ.2.2.1, Y) := by
    intro k Y
    show qC B.h ξ ^ e * k (ξ.1, ξ.2.1, ξ.2.2.1, Y) / qC B.h ξ ^ e = k (ξ.1, ξ.2.1, ξ.2.2.1, Y)
    exact mul_div_cancel_left₀ _ hne
  have c1 : Continuous (fun Y : ℝ × ℝ => f (ξ.1, ξ.2.1, ξ.2.2.1, Y)) :=
    ((hF.1.continuousOn.comp_continuous hι hmem).div_const (qC B.h ξ ^ e)).congr (fun Y => hfeq f Y)
  have c2 : Continuous (fun Y : ℝ × ℝ => g (ξ.1, ξ.2.1, ξ.2.2.1, Y)) :=
    ((hg.1.continuousOn.comp_continuous hι hmem).div_const (qC B.h ξ ^ e)).congr (fun Y => hfeq g Y)
  have hK : IsCompact (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
  unfold yAvg
  exact MeasureTheory.integral_add (c1.continuousOn.integrableOn_compact hK)
    (c2.continuousOn.integrableOn_compact hK)

theorem param_integral_contDiff {P E' F : Type} [NormedAddCommGroup P] [NormedSpace ℝ P]
    [FiniteDimensional ℝ P] [NormedAddCommGroup E'] [NormedSpace ℝ E'] [FiniteDimensional ℝ E']
    [MeasurableSpace E'] [BorelSpace E'] [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (μ : MeasureTheory.Measure E') [MeasureTheory.IsFiniteMeasureOnCompacts μ]
    (U : Set P) (V K : Set E') (G : P → E' → F) (hU : IsOpen U) (hV : IsOpen V) (hK : IsCompact K)
    (hKV : K ⊆ V) (hG : ContDiffOn ℝ ∞ (fun z : P × E' => G z.1 z.2) (U ×ˢ V)) :
    ContDiffOn ℝ ∞ (fun x => ∫ y in K, G x y ∂μ) U ∧
    (∀ k : ℕ, ∀ x ∈ U, iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) x =
      ∫ y in K, iteratedFDeriv ℝ k (fun x' => G x' y) x ∂μ) :=
by
  have hO : IsOpen (U ×ˢ V) := hU.prod hV
  have hKm : MeasurableSet K := hK.isClosed.measurableSet

  have slice : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F'] (H : P → E' → F'),
      ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) →
      ∀ x ∈ U, ContinuousOn (fun y => H x y) K := by
    intro F' _ _ H hH x hx
    have hc : Continuous (fun y : E' => ((x, y) : P × E')) := by fun_prop
    have h := ContinuousOn.comp (g := fun z : P × E' => H z.1 z.2) (f := fun y : E' => ((x, y) : P × E'))
      hH.continuousOn hc.continuousOn (fun y hy => ⟨hx, hKV hy⟩)
    exact h

  have param_fderiv : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F'] (H : P → E' → F'),
      ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) →
      ContDiffOn ℝ ∞ (fun z : P × E' => fderiv ℝ (fun x' => H x' z.2) z.1) (U ×ˢ V) := by
    intro F' _ _ H hH p hp
    have hHa : ContDiffAt ℝ ∞ (fun z : P × E' => H z.1 z.2) p := hH.contDiffAt (hO.mem_nhds hp)
    apply ContDiffAt.contDiffWithinAt
    have h1 : ContDiffAt ℝ ∞ (Function.uncurry (fun (q : P × E') (x' : P) => H x' q.2)) (p, p.1) := by
      have e : Function.uncurry (fun (q : P × E') (x' : P) => H x' q.2) =
          (fun z : P × E' => H z.1 z.2) ∘ (fun w : (P × E') × P => (w.2, w.1.2)) := rfl
      rw [e]
      apply ContDiffAt.comp (g := fun z : P × E' => H z.1 z.2) (p, p.1)
      · simpa using hHa
      · fun_prop
    exact ContDiffAt.fderiv (f := fun (q : P × E') (x' : P) => H x' q.2)
      (g := Prod.fst) h1 contDiffAt_fst (le_of_eq ENat.coe_top_add_one)

  have param_hasFDeriv : ∀ {F' : Type} [NormedAddCommGroup F'] [NormedSpace ℝ F']
      (H : P → E' → F'), ContDiffOn ℝ ∞ (fun z : P × E' => H z.1 z.2) (U ×ˢ V) → ∀ x ∈ U,
      HasFDerivAt (fun x' => ∫ y in K, H x' y ∂μ) (∫ y in K, fderiv ℝ (fun x' => H x' y) x ∂μ) x := by
    intro F' _ _ H hH x hx
    have hHs := param_fderiv H hH
    obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hU x hx
    have hsU : Metric.closedBall x (δ / 2) ⊆ U :=
      (Metric.closedBall_subset_ball (by linarith)).trans hball
    have hsn : Metric.closedBall x (δ / 2) ∈ nhds x := Metric.closedBall_mem_nhds x (by linarith)
    have hC : IsCompact (Metric.closedBall x (δ / 2) ×ˢ K) := (isCompact_closedBall _ _).prod hK
    have hCsub : Metric.closedBall x (δ / 2) ×ˢ K ⊆ U ×ˢ V := fun z hz => ⟨hsU hz.1, hKV hz.2⟩
    obtain ⟨B, hB⟩ := hC.exists_bound_of_continuousOn (hHs.continuousOn.mono hCsub)
    refine hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := μ.restrict K)
      (F := fun x' y => H x' y) (F' := fun x' y => fderiv ℝ (fun x'' => H x'' y) x')
      (bound := fun _ => B) hsn ?_ ?_ ?_ ?_ ?_ ?_
    · filter_upwards [hU.mem_nhds hx] with x' hx'
      exact (slice H hH x' hx').aestronglyMeasurable_of_isCompact hK hKm
    · exact (slice H hH x hx).integrableOn_compact hK
    · exact (slice (fun x' y => fderiv ℝ (fun x'' => H x'' y) x') hHs x hx).aestronglyMeasurable_of_isCompact
        hK hKm
    · exact ae_restrict_of_forall_mem hKm (fun y hy x' hx' => hB (x', y) ⟨hx', hy⟩)
    · exact continuousOn_const.integrableOn_compact hK
    · refine ae_restrict_of_forall_mem hKm (fun y hy x' hx' => ?_)
      have hHa : ContDiffAt ℝ ∞ (fun z : P × E' => H z.1 z.2) (x', y) :=
        hH.contDiffAt (hO.mem_nhds ⟨hsU hx', hKV hy⟩)
      have hc : ContDiffAt ℝ ∞ (fun x'' : P => ((x'', y) : P × E')) x' := by fun_prop
      have h2 := ContDiffAt.comp (g := fun z : P × E' => H z.1 z.2) x' hHa hc
      have : ContDiffAt ℝ ∞ (fun x'' => H x'' y) x' := h2
      exact (this.differentiableAt (by simp)).hasFDerivAt

  have hD0 : ∀ x y, iteratedFDeriv ℝ 0 (fun x' => G x' y) x =
      (continuousMultilinearCurryFin0 ℝ P F).symm (G x y) := by
    intro x y; rw [iteratedFDeriv_zero_eq_comp]; rfl
  have hDs : ∀ (k : ℕ) x y, iteratedFDeriv ℝ (k + 1) (fun x' => G x' y) x =
      (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm
        (fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') x) := by
    intro k x y; rw [iteratedFDeriv_succ_eq_comp_left]; rfl
  have D_smooth : ∀ k : ℕ, ContDiffOn ℝ ∞
      (fun z : P × E' => iteratedFDeriv ℝ k (fun x' => G x' z.2) z.1) (U ×ˢ V) := by
    intro k
    induction k with
    | zero =>
      have e : (fun z : P × E' => iteratedFDeriv ℝ 0 (fun x' => G x' z.2) z.1) =
          (continuousMultilinearCurryFin0 ℝ P F).symm ∘ (fun z : P × E' => G z.1 z.2) := by
        funext z; exact hD0 z.1 z.2
      rw [e]
      exact (continuousMultilinearCurryFin0 ℝ P F).symm.contDiff.comp_contDiffOn hG
    | succ k ih =>
      have e : (fun z : P × E' => iteratedFDeriv ℝ (k + 1) (fun x' => G x' z.2) z.1) =
          (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm ∘
            (fun z : P × E' => fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' z.2) x') z.1) := by
        funext z; exact hDs k z.1 z.2
      rw [e]
      have h2 := param_fderiv (fun x' y => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') ih
      exact (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm.contDiff.comp_contDiffOn h2

  have formula : ∀ k : ℕ, ∀ x ∈ U, iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) x =
      ∫ y in K, iteratedFDeriv ℝ k (fun x' => G x' y) x ∂μ := by
    intro k
    induction k with
    | zero =>
      intro x _
      rw [iteratedFDeriv_zero_eq_comp (f := fun x' => ∫ y in K, G x' y ∂μ)]
      simp only [hD0]
      exact (ContinuousLinearEquiv.integral_comp_comm
        (continuousMultilinearCurryFin0 ℝ P F).symm.toContinuousLinearEquiv (fun y => G x y)).symm
    | succ k ih =>
      intro x hx
      have hα : iteratedFDeriv ℝ k (fun x' => ∫ y in K, G x' y ∂μ) =ᶠ[nhds x]
          (fun x' => ∫ y in K, iteratedFDeriv ℝ k (fun x'' => G x'' y) x' ∂μ) :=
        Filter.eventuallyEq_of_mem (hU.mem_nhds hx) ih
      have hβ := (param_hasFDeriv (fun x' y => iteratedFDeriv ℝ k (fun x'' => G x'' y) x')
        (D_smooth k) x hx).fderiv
      rw [iteratedFDeriv_succ_eq_comp_left (f := fun x' => ∫ y in K, G x' y ∂μ), Function.comp_apply,
        hα.fderiv_eq, hβ]
      simp only [hDs]
      have hL := ContinuousLinearEquiv.integral_comp_comm (μ := μ.restrict K) (𝕜 := ℝ)
        (E := P →L[ℝ] ContinuousMultilinearMap ℝ (fun _ : Fin k => P) F)
        (F := ContinuousMultilinearMap ℝ (fun _ : Fin (k + 1) => P) F)
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => P) F).symm.toContinuousLinearEquiv
        (fun y => fderiv ℝ (fun x' => iteratedFDeriv ℝ k (fun x'' => G x'' y) x') x)
      exact hL.symm

  have hsmooth : ContDiffOn ℝ ∞ (fun x => ∫ y in K, G x y ∂μ) U := by
    have key : ∀ m : ℕ, EqOn (iteratedFDerivWithin ℝ m (fun x => ∫ y in K, G x y ∂μ) U)
        (fun x => ∫ y in K, iteratedFDeriv ℝ m (fun x' => G x' y) x ∂μ) U := by
      intro m x hx
      rw [iteratedFDerivWithin_of_isOpen m hU hx]
      exact formula m x hx
    have hdiff : ∀ m : ℕ, DifferentiableOn ℝ
        (fun x => ∫ y in K, iteratedFDeriv ℝ m (fun x' => G x' y) x ∂μ) U :=
      fun m x hx => (param_hasFDeriv (fun x' y => iteratedFDeriv ℝ m (fun x'' => G x'' y) x')
        (D_smooth m) x hx).differentiableAt.differentiableWithinAt
    exact contDiffOn_of_continuousOn_differentiableOn (n := ⊤)
      (fun m _ => ((hdiff m).continuousOn).congr (key m))
      (fun m _ => (hdiff m).congr (key m))
  exact ⟨hsmooth, formula⟩

theorem simnorm_sqrt_ratio_bound (h : ℝ) (hS : SimScaleProps h) (hN : SimNorm h) (i : ℕ) :
    ∃ M : ℝ, ∀ z t : ℝ, t < 1 → simScale h z (1 - t) ≤ 1 →
      ‖iteratedFDeriv ℝ i (fun u : ℝ × ℝ => Real.sqrt (simScale h (z + simScale h z (1 - t) ^ (1/2 - h) * u.1)
        (1 - (t + simScale h z (1 - t) * u.2)) / simScale h z (1 - t))) 0‖ ≤ M :=
by
  obtain ⟨hS1, -, -, hS4, -⟩ := hS
  choose C hC using hN

  set A : ℝ := ∑ k ∈ Finset.range (i + 1), |Polynomial.eval (1/2 : ℝ) (descPochhammer ℝ k)| with hAdef
  set D : ℝ := 1 + ∑ k ∈ Finset.range (i + 1), |C k| with hDdef
  have hD1 : 1 ≤ D := by
    have := Finset.sum_nonneg (fun k (_ : k ∈ Finset.range (i + 1)) => abs_nonneg (C k))
    linarith
  have hA : ∀ k : ℕ, k ≤ i →
      ‖iteratedFDerivWithin ℝ k (fun x : ℝ => x ^ (1/2 : ℝ)) (Set.Ioi (0:ℝ)) 1‖ ≤ A := by
    intro k hk
    rw [iteratedFDerivWithin_of_isOpen k isOpen_Ioi (show (1:ℝ) ∈ Set.Ioi (0:ℝ) from Set.mem_Ioi.mpr one_pos),
      norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
      Real.iter_deriv_rpow_const, Real.one_rpow, mul_one, Real.norm_eq_abs]
    exact Finset.single_le_sum (f := fun k => |Polynomial.eval (1/2 : ℝ) (descPochhammer ℝ k)|)
      (fun k _ => abs_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hk))
  refine ⟨(i.factorial : ℝ) * A * D ^ i, fun z t ht hq1 => ?_⟩
  have hτ : 0 < 1 - t := by linarith
  obtain ⟨hq0, -⟩ := hS1 z (1 - t) hτ
  obtain ⟨q, hqd⟩ : ∃ q, q = simScale h z (1 - t) := ⟨_, rfl⟩
  have hCq : ∀ k : ℕ, ‖(iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, 1 - t)).compContinuousLinearMap
      (fun _ => (q ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap
                (q • ContinuousLinearMap.id ℝ ℝ))‖ ≤ C k * q := by
    intro k
    rw [hqd]
    exact hC k z (1 - t) hτ hq1
  rw [← hqd] at hq0 hq1 ⊢

  have hpa : 0 < q ^ (1/2 - h) := Real.rpow_pos_of_pos hq0 _
  let e₁ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 (q ^ (1/2 - h)) hpa.ne')
  let e₂ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 (-q) (neg_ne_zero.mpr hq0.ne'))
  let L : (ℝ × ℝ) ≃L[ℝ] (ℝ × ℝ) := e₁.prodCongr e₂
  let M : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 q⁻¹ (inv_ne_zero hq0.ne'))
  have hL : ∀ x : ℝ × ℝ, L x = (q ^ (1/2 - h) * x.1, -q * x.2) := by
    intro x
    apply Prod.ext <;> (simp [L, e₁, e₂]; try ring)
  have hM : ∀ y : ℝ, M y = q⁻¹ * y := by
    intro y
    simp [M, mul_comm]
  have hMn : ‖(M : ℝ →L[ℝ] ℝ)‖ ≤ q⁻¹ := by
    refine ContinuousLinearMap.opNorm_le_bound _ (inv_nonneg.mpr hq0.le) fun y => ?_
    show ‖M y‖ ≤ q⁻¹ * ‖y‖
    rw [hM, norm_mul, Real.norm_eq_abs q⁻¹, abs_of_pos (inv_pos.mpr hq0)]
  let σ : ℝ × ℝ →L[ℝ] ℝ × ℝ := (ContinuousLinearMap.id ℝ ℝ).prodMap (-ContinuousLinearMap.id ℝ ℝ)
  have hσ : ‖σ‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x => ?_)
    rw [one_mul]
    simp [σ, Prod.norm_def]
  have hLclm : (L : ℝ × ℝ →L[ℝ] ℝ × ℝ) =
      ((q ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap (q • ContinuousLinearMap.id ℝ ℝ)).comp σ := by
    apply ContinuousLinearMap.ext
    intro x
    simp only [ContinuousLinearEquiv.coe_coe]
    rw [hL]
    apply Prod.ext <;> (simp [σ]; try ring)
  have hw1 : ∀ u : ℝ × ℝ, (((z, 1 - t) : ℝ × ℝ) + L u).1 = z + q ^ (1/2 - h) * u.1 := by
    intro u
    simp only [Prod.fst_add, hL]
  have hw2 : ∀ u : ℝ × ℝ, (((z, 1 - t) : ℝ × ℝ) + L u).2 = 1 - (t + q * u.2) := by
    intro u
    simp only [Prod.snd_add, hL]
    ring

  obtain ⟨Qf, hQfd⟩ : ∃ Qf : ℝ × ℝ → ℝ, Qf = M ∘ ((fun v : ℝ × ℝ =>
      simScale h (((z, 1 - t) : ℝ × ℝ) + v).1 (((z, 1 - t) : ℝ × ℝ) + v).2) ∘ L) := ⟨_, rfl⟩
  obtain ⟨O, hOd⟩ : ∃ O : Set (ℝ × ℝ), O = (fun u : ℝ × ℝ => ((z, 1 - t) : ℝ × ℝ) + L u) ⁻¹'
      (Set.univ ×ˢ Set.Ioi (0:ℝ)) := ⟨_, rfl⟩
  have hUo : IsOpen (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
  have hO : IsOpen O := by
    rw [hOd]
    exact hUo.preimage (continuous_const.add L.continuous)
  have h0O : (0 : ℝ × ℝ) ∈ O := by
    rw [hOd]
    show ((z, 1 - t) : ℝ × ℝ) + L 0 ∈ Set.univ ×ˢ Set.Ioi (0:ℝ)
    rw [map_zero, add_zero]
    exact ⟨Set.mem_univ _, hτ⟩
  have hQs : ContDiffOn ℝ ∞ Qf O := by
    rw [hQfd, hOd]
    exact M.contDiff.comp_contDiffOn
      (hS4.comp (contDiff_const.add L.contDiff).contDiffOn (fun u hu => hu))
  have hQpos : ∀ u ∈ O, 0 < Qf u := by
    intro u hu
    rw [hOd] at hu
    rw [hQfd]
    show 0 < M (simScale h (((z, 1 - t) : ℝ × ℝ) + L u).1 (((z, 1 - t) : ℝ × ℝ) + L u).2)
    rw [hM]
    exact mul_pos (inv_pos.mpr hq0) (hS1 _ _ hu.2).1
  have hQ0 : Qf 0 = 1 := by
    rw [hQfd]
    show M (simScale h (((z, 1 - t) : ℝ × ℝ) + L 0).1 (((z, 1 - t) : ℝ × ℝ) + L 0).2) = 1
    rw [hM, map_zero, add_zero]
    show q⁻¹ * simScale h z (1 - t) = 1
    rw [← hqd]
    exact inv_mul_cancel₀ hq0.ne'
  have hfun : (fun u : ℝ × ℝ => Real.sqrt (simScale h (z + q ^ (1/2 - h) * u.1)
      (1 - (t + q * u.2)) / q)) = (fun x : ℝ => x ^ (1/2 : ℝ)) ∘ Qf := by
    funext u
    rw [hQfd]
    show Real.sqrt (simScale h (z + q ^ (1/2 - h) * u.1) (1 - (t + q * u.2)) / q) =
      (M (simScale h (((z, 1 - t) : ℝ × ℝ) + L u).1 (((z, 1 - t) : ℝ × ℝ) + L u).2)) ^ (1/2 : ℝ)
    rw [hM, hw1 u, hw2 u, Real.sqrt_eq_rpow, div_eq_inv_mul]

  have hK : ∀ k : ℕ, 1 ≤ k → k ≤ i → ‖iteratedFDerivWithin ℝ k Qf O 0‖ ≤ D ^ k := by
    intro k hk1 hki
    rw [iteratedFDerivWithin_of_isOpen k hO h0O, hQfd, M.iteratedFDeriv_comp_left]
    have hcomp : iteratedFDeriv ℝ k ((fun v : ℝ × ℝ =>
        simScale h (((z, 1 - t) : ℝ × ℝ) + v).1 (((z, 1 - t) : ℝ × ℝ) + v).2) ∘ L) 0 =
        (iteratedFDeriv ℝ k (fun v : ℝ × ℝ =>
          simScale h (((z, 1 - t) : ℝ × ℝ) + v).1 (((z, 1 - t) : ℝ × ℝ) + v).2) (L 0)).compContinuousLinearMap
          (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) := by
      have := L.iteratedFDerivWithin_comp_right (fun v : ℝ × ℝ =>
          simScale h (((z, 1 - t) : ℝ × ℝ) + v).1 (((z, 1 - t) : ℝ × ℝ) + v).2)
        uniqueDiffOn_univ (Set.mem_univ (L 0)) k
      rwa [Set.preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at this
    rw [hcomp, map_zero, iteratedFDeriv_comp_add_left (f := fun w : ℝ × ℝ => simScale h w.1 w.2),
      add_zero, hLclm]
    have hsplit : (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, 1 - t)).compContinuousLinearMap
        (fun _ => ((q ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap
          (q • ContinuousLinearMap.id ℝ ℝ)).comp σ) =
        ((iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, 1 - t)).compContinuousLinearMap
          (fun _ => (q ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap
            (q • ContinuousLinearMap.id ℝ ℝ))).compContinuousLinearMap (fun _ => σ) :=
      ContinuousMultilinearMap.ext (fun m => rfl)
    rw [hsplit]
    have hX := hCq k
    have hX0 : 0 ≤ C k * q := le_trans (norm_nonneg _) hX
    have hY : ‖((iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, 1 - t)).compContinuousLinearMap
          (fun _ => (q ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap
            (q • ContinuousLinearMap.id ℝ ℝ))).compContinuousLinearMap (fun _ => σ)‖ ≤ C k * q := by
      refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      calc _ ≤ (C k * q) * 1 :=
            mul_le_mul hX (pow_le_one₀ (norm_nonneg _) hσ) (pow_nonneg (norm_nonneg _) _) hX0
        _ = C k * q := mul_one _
    have hCk : |C k| ≤ D := by
      have := Finset.single_le_sum (f := fun k => |C k|) (fun k _ => abs_nonneg _)
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hki))
      linarith
    calc _ ≤ ‖(M : ℝ →L[ℝ] ℝ)‖ * (C k * q) :=
          le_trans (ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _)
            (mul_le_mul_of_nonneg_left hY (norm_nonneg _))
      _ ≤ q⁻¹ * (C k * q) := mul_le_mul_of_nonneg_right hMn hX0
      _ = C k := by field_simp
      _ ≤ D ^ k := (le_abs_self _).trans (hCk.trans (le_self_pow₀ hD1 (by omega)))

  have hg : ContDiffOn ℝ ∞ (fun x : ℝ => x ^ (1/2 : ℝ)) (Set.Ioi 0) :=
    (contDiffOn_id (s := Set.Ioi (0:ℝ))).rpow_const_of_ne (fun x hx => ne_of_gt hx)
  have hA' : ∀ k : ℕ, k ≤ i →
      ‖iteratedFDerivWithin ℝ k (fun x : ℝ => x ^ (1/2 : ℝ)) (Set.Ioi (0:ℝ)) (Qf 0)‖ ≤ A := by
    intro k hk
    rw [hQ0]
    exact hA k hk
  have key := norm_iteratedFDerivWithin_comp_le hg hQs (by exact_mod_cast le_top)
    isOpen_Ioi.uniqueDiffOn hO.uniqueDiffOn (fun u hu => hQpos u hu) h0O (C := A) (D := D) hA' hK
  rw [iteratedFDerivWithin_of_isOpen i hO h0O] at key
  rw [hfun]
  exact key

theorem inm_nb_uniform (B : BG) (qs α : ℝ) (f : Cyl → ℝ) (hB : B.ok) (hf : InM B qs α f) (k : ℕ) :
    ∃ A b : ℝ, ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ j : ℕ, j ≤ k →
      NB B.h f j ξ ≤ A * qC B.h ξ ^ (B.h * α) * (1 + |Real.log (qC B.h ξ)|) ^ (2 * b) :=
by
  obtain ⟨hS, hBP⟩ := hB
  obtain ⟨-, -, hXa, -, -, -, -, -, -, -, -, haa, hab⟩ := hBP.1

  have core : ∀ (c δ d : ℝ) (m : ℕ), 0 < c → 0 < δ → δ ≤ 1 → d ≤ 2 * (m:ℝ) →
      Real.exp (-(c / δ ^ 2)) * δ ^ (-d) ≤ (m.factorial : ℝ) / c ^ m := by
    intro c δ d m hc hδ hδ1 hd
    have h1 : δ ^ (-d) ≤ δ ^ (-(2 * (m:ℝ))) :=
      Real.rpow_le_rpow_of_exponent_ge hδ hδ1 (by linarith)
    have h2 : δ ^ (-(2 * (m:ℝ))) = (1 / δ ^ 2) ^ m := by
      rw [Real.rpow_neg hδ.le, Real.rpow_mul hδ.le, Real.rpow_two, Real.rpow_natCast, one_div,
        inv_pow]
    have hx : 0 ≤ c * (1 / δ ^ 2) := by positivity
    have h3 := Real.pow_div_factorial_le_exp (c * (1 / δ ^ 2)) hx m
    have hfac : (0:ℝ) < m.factorial := by exact_mod_cast Nat.factorial_pos m
    have hcm : (0:ℝ) < c ^ m := pow_pos hc m
    have he : Real.exp (-(c / δ ^ 2)) = Real.exp (-(c * (1 / δ ^ 2))) := by rw [mul_one_div]
    have hee : Real.exp (-(c * (1 / δ ^ 2))) * Real.exp (c * (1 / δ ^ 2)) = 1 := by
      rw [← Real.exp_add]; simp
    calc Real.exp (-(c / δ ^ 2)) * δ ^ (-d) ≤ Real.exp (-(c / δ ^ 2)) * (1 / δ ^ 2) ^ m := by
          rw [← h2]; exact mul_le_mul_of_nonneg_left h1 (Real.exp_pos _).le
      _ = (m.factorial : ℝ) / c ^ m *
            (Real.exp (-(c * (1 / δ ^ 2))) * ((c * (1 / δ ^ 2)) ^ m / m.factorial)) := by
          rw [he, mul_pow]; field_simp
      _ ≤ (m.factorial : ℝ) / c ^ m *
            (Real.exp (-(c * (1 / δ ^ 2))) * Real.exp (c * (1 / δ ^ 2))) := by
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          exact mul_le_mul_of_nonneg_left h3 (Real.exp_pos _).le
      _ = (m.factorial : ℝ) / c ^ m := by rw [hee, mul_one]

  have edge : ∀ d : ℝ, ∃ M : ℝ, 0 ≤ M ∧ ∀ X : ℝ, B.Xa < X → X < B.Xb →
      edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-d) ≤ M := by
    intro d
    obtain ⟨m, hm⟩ : ∃ m : ℕ, m = ⌈d / 2⌉₊ := ⟨_, rfl⟩
    have hdm : d ≤ 2 * (m:ℝ) := by
      have := Nat.le_ceil (d / 2); rw [← hm] at this; linarith
    have hfa : 0 ≤ (m.factorial : ℝ) / B.aa ^ m := by positivity
    have hfb : 0 ≤ (m.factorial : ℝ) / B.ab ^ m := by positivity
    refine ⟨1 + (m.factorial : ℝ) / B.aa ^ m + (m.factorial : ℝ) / B.ab ^ m, by linarith, ?_⟩
    intro X hX1 hX2
    have hX0 : 0 < X := lt_trans hXa hX1
    have hda : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr hX1)
    have hdb : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX0).mpr hX2)
    have hEW : edgeWeight B.Xa B.Xb B.aa B.ab X =
        Real.exp (-(B.aa / Real.log (X / B.Xa) ^ 2) - B.ab / Real.log (B.Xb / X) ^ 2) := by
      unfold edgeWeight; rw [if_pos ⟨hX1, hX2⟩]
    have hta : 0 ≤ B.aa / Real.log (X / B.Xa) ^ 2 := by positivity
    have htb : 0 ≤ B.ab / Real.log (B.Xb / X) ^ 2 := by positivity
    have hED1 : edgeDist B.Xa B.Xb X ≤ 1 := min_le_left _ _
    rcases min_choice 1 (min (Real.log (X / B.Xa)) (Real.log (B.Xb / X))) with h | h
    · have hE : edgeDist B.Xa B.Xb X = 1 := h
      rw [hE, Real.one_rpow, mul_one, hEW]
      have : Real.exp (-(B.aa / Real.log (X / B.Xa) ^ 2) - B.ab / Real.log (B.Xb / X) ^ 2) ≤ 1 :=
        Real.exp_le_one_iff.mpr (by linarith)
      linarith
    · rcases min_choice (Real.log (X / B.Xa)) (Real.log (B.Xb / X)) with h' | h'
      · have hE : edgeDist B.Xa B.Xb X = Real.log (X / B.Xa) := by
          unfold edgeDist; rw [h, h']
        have hle1 : Real.log (X / B.Xa) ≤ 1 := by rw [← hE]; exact hED1
        calc edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-d)
            ≤ Real.exp (-(B.aa / Real.log (X / B.Xa) ^ 2)) * Real.log (X / B.Xa) ^ (-d) := by
              rw [hEW, hE]
              apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hda.le _)
              exact Real.exp_le_exp.mpr (by linarith)
          _ ≤ (m.factorial : ℝ) / B.aa ^ m := core _ _ _ _ haa hda hle1 hdm
          _ ≤ _ := by linarith
      · have hE : edgeDist B.Xa B.Xb X = Real.log (B.Xb / X) := by
          unfold edgeDist; rw [h, h']
        have hle1 : Real.log (B.Xb / X) ≤ 1 := by rw [← hE]; exact hED1
        calc edgeWeight B.Xa B.Xb B.aa B.ab X * edgeDist B.Xa B.Xb X ^ (-d)
            ≤ Real.exp (-(B.ab / Real.log (B.Xb / X) ^ 2)) * Real.log (B.Xb / X) ^ (-d) := by
              rw [hEW, hE]
              apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hdb.le _)
              exact Real.exp_le_exp.mpr (by linarith)
          _ ≤ (m.factorial : ℝ) / B.ab ^ m := core _ _ _ _ hab hdb hle1 hdm
          _ ≤ _ := by linarith

  obtain ⟨-, -, -, hf4⟩ := hf
  choose Cc bb dd hCbd using hf4
  choose M hM0 hM using fun j => edge (dd j)
  refine ⟨∑ i ∈ Finset.range (k + 1), |Cc i| * M i, ∑ i ∈ Finset.range (k + 1), |bb i|, ?_⟩

  intro ξ hξ hX1 hX2 j hj
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
  have hq0 : 0 < qC B.h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have hjr : j ∈ Finset.range (k + 1) := Finset.mem_range.mpr (by omega)
  have hP : 0 ≤ qC B.h ξ ^ (B.h * α) := Real.rpow_nonneg hq0.le _
  have hL1 : 1 ≤ 1 + |Real.log (qC B.h ξ)| := by
    have := abs_nonneg (Real.log (qC B.h ξ)); linarith
  have hS1 : 1 ≤ SC B.h ξ := by
    show 1 ≤ (1 + |Real.log (qC B.h ξ)|) ^ 2
    nlinarith
  have hbj : bb j ≤ ∑ i ∈ Finset.range (k + 1), |bb i| :=
    le_trans (le_abs_self _)
      (Finset.single_le_sum (f := fun i => |bb i|) (fun i _ => abs_nonneg _) hjr)
  have hSb : SC B.h ξ ^ bb j ≤ SC B.h ξ ^ (∑ i ∈ Finset.range (k + 1), |bb i|) :=
    Real.rpow_le_rpow_of_exponent_le hS1 hbj
  have hSbj0 : 0 ≤ SC B.h ξ ^ bb j := Real.rpow_nonneg (by linarith) _
  have hSb0 : 0 ≤ SC B.h ξ ^ (∑ i ∈ Finset.range (k + 1), |bb i|) :=
    Real.rpow_nonneg (by linarith) _
  have hEW0 : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
    unfold edgeWeight; split_ifs
    · exact (Real.exp_pos _).le
    · exact le_rfl
  have hX0 : 0 < XC B.h ξ := lt_trans hXa hX1
  have hED0 : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) :=
    lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
      (Real.log_pos ((one_lt_div hX0).mpr hX2)))
  have hE0 : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd j) := Real.rpow_nonneg hED0.le _
  have hWt := hM j (XC B.h ξ) hX1 hX2
  have hAj : |Cc j| * M j ≤ ∑ i ∈ Finset.range (k + 1), |Cc i| * M i :=
    Finset.single_le_sum (f := fun i => |Cc i| * M i)
      (fun i _ => mul_nonneg (abs_nonneg _) (hM0 i)) hjr
  have hSeq : SC B.h ξ ^ (∑ i ∈ Finset.range (k + 1), |bb i|) =
      (1 + |Real.log (qC B.h ξ)|) ^ (2 * ∑ i ∈ Finset.range (k + 1), |bb i|) := by
    show ((1 + |Real.log (qC B.h ξ)|) ^ 2) ^ (∑ i ∈ Finset.range (k + 1), |bb i|) = _
    rw [← Real.rpow_two, ← Real.rpow_mul (by linarith)]
  calc NB B.h f j ξ
      ≤ Cc j * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ bb j *
          edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd j) :=
        hCbd j ξ hξ hX1 hX2
    _ = Cc j * (qC B.h ξ ^ (B.h * α) * (SC B.h ξ ^ bb j *
          (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-dd j)))) := by ring
    _ ≤ |Cc j| * (qC B.h ξ ^ (B.h * α) *
          (SC B.h ξ ^ (∑ i ∈ Finset.range (k + 1), |bb i|) * M j)) := by
        apply mul_le_mul (le_abs_self _) _
          (mul_nonneg hP (mul_nonneg hSbj0 (mul_nonneg hEW0 hE0))) (abs_nonneg _)
        apply mul_le_mul_of_nonneg_left _ hP
        exact mul_le_mul hSb hWt (mul_nonneg hEW0 hE0) hSb0
    _ = (|Cc j| * M j) * (qC B.h ξ ^ (B.h * α) *
          SC B.h ξ ^ (∑ i ∈ Finset.range (k + 1), |bb i|)) := by ring
    _ ≤ (∑ i ∈ Finset.range (k + 1), |Cc i| * M i) * (qC B.h ξ ^ (B.h * α) *
          SC B.h ξ ^ (∑ i ∈ Finset.range (k + 1), |bb i|)) :=
        mul_le_mul_of_nonneg_right hAj (mul_nonneg hP hSb0)
    _ = _ := by rw [hSeq]; ring

theorem radmom_chain_bound (h qs R2 : ℝ) (f : Cyl → ℝ) (k e : ℕ) (M : ℕ → ℝ) (hS : SimScaleProps h)
    (hqs : qs ≤ 1) (hf : ContDiffOn ℝ ∞ f (DomC h qs))
    (hM : ∀ i : ℕ, ∀ z t : ℝ, t < 1 → simScale h z (1 - t) < qs →
      ‖iteratedFDeriv ℝ i (fun u : ℝ × ℝ => Real.sqrt (simScale h (z + simScale h z (1 - t) ^ (1/2 - h) * u.1)
        (1 - (t + simScale h z (1 - t) * u.2)) / simScale h z (1 - t))) 0‖ ≤ M i)
    (p : ℝ × ℝ) (R : ℝ) (Y : ℝ × ℝ) (Cf : ℝ) (hp1 : p.2 < 1) (hp2 : simScale h p.1 (1 - p.2) < qs)
    (hR : 0 < R) (hR2 : R ≤ R2)
    (hCf : ∀ j : ℕ, j ≤ k → NB h f j (Real.sqrt (simScale h p.1 (1 - p.2)) * R, p.1, p.2, Y) ≤ Cf) :
    ‖(iteratedFDeriv ℝ k (fun p' : ℝ × ℝ =>
        R ^ e * f (Real.sqrt (simScale h p'.1 (1 - p'.2)) * R, p'.1, p'.2, Y)) p).compContinuousLinearMap
      (fun _ => (simScale h p.1 (1 - p.2) ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap
        (simScale h p.1 (1 - p.2) • ContinuousLinearMap.id ℝ ℝ))‖ ≤
      R ^ e * ((k.factorial : ℝ) * Cf * (1 + R2 * ∑ i ∈ Finset.range (k + 1), M i) ^ k) :=
by

  have key : ∀ {E G H : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] [NormedAddCommGroup H] [NormedSpace ℝ H] (F : E → G) (V : Set E) (a : E)
      (T : H →L[ℝ] E), IsOpen V → ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G H _ _ _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : H) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  obtain ⟨Φ, hΦd⟩ : ∃ Φ : ℝ × ℝ → ℝ, Φ = fun p' : ℝ × ℝ =>
      R ^ e * f (Real.sqrt (simScale h p'.1 (1 - p'.2)) * R, p'.1, p'.2, Y) := ⟨_, rfl⟩
  rw [← hΦd]
  obtain ⟨q, hqd⟩ : ∃ q : ℝ, q = simScale h p.1 (1 - p.2) := ⟨_, rfl⟩
  obtain ⟨L, hLd⟩ : ∃ L : ℝ × ℝ →L[ℝ] ℝ × ℝ,
      L = (q ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap (q • ContinuousLinearMap.id ℝ ℝ) :=
    ⟨_, rfl⟩
  obtain ⟨D, hDd⟩ : ∃ D : ℝ, D = 1 + R2 * ∑ i ∈ Finset.range (k + 1), M i := ⟨_, rfl⟩
  rw [← hqd, ← hLd, ← hDd]
  have hq0 : 0 < q := by rw [hqd]; exact (hS.1 p.1 (1 - p.2) (by linarith)).1
  have hL : ∀ u : ℝ × ℝ, L u = (q ^ (1/2 - h) * u.1, q * u.2) := by
    intro u; rw [hLd]; first | rfl | simp [ContinuousLinearMap.coe_prodMap', Prod.map]
  have hMp : ∀ i : ℕ, ‖iteratedFDeriv ℝ i (fun u : ℝ × ℝ => Real.sqrt (simScale h
      (p.1 + q ^ (1/2 - h) * u.1) (1 - (p.2 + q * u.2)) / q)) 0‖ ≤ M i := by
    intro i; have := hM i p.1 p.2 hp1 hp2; rw [← hqd] at this; exact this
  obtain ⟨ρ, hρd⟩ : ∃ ρ : ℝ × ℝ → ℝ, ρ = fun u : ℝ × ℝ => Real.sqrt (simScale h
      (p.1 + q ^ (1/2 - h) * u.1) (1 - (p.2 + q * u.2)) / q) := ⟨_, rfl⟩
  rw [← hρd] at hMp
  have hM0 : ∀ i, 0 ≤ M i := fun i => le_trans (norm_nonneg _) (hMp i)
  have hsum0 : 0 ≤ ∑ i ∈ Finset.range (k + 1), M i := Finset.sum_nonneg (fun i _ => hM0 i)
  have hR20 : 0 ≤ R2 := le_trans hR.le hR2
  have hD1 : 1 ≤ D := by rw [hDd]; have := mul_nonneg hR20 hsum0; linarith

  have hP4 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
    hS.2.2.2.1
  have hσ : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale h w.1 (1 - w.2)) {w : ℝ × ℝ | w.2 < 1} :=
    hP4.comp (contDiff_fst.prodMk (contDiff_const.sub contDiff_snd)).contDiffOn
      (fun w (hw : w.2 < 1) => ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hσpos : ∀ w : ℝ × ℝ, w.2 < 1 → 0 < simScale h w.1 (1 - w.2) := fun w hw =>
    (hS.1 w.1 (1 - w.2) (by linarith)).1
  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC h η) {η : Cyl | η.2.2.1 < 1} :=
    hP4.comp ((contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)).contDiffOn
      (fun η (hη : η.2.2.1 < 1) => ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hU : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
  have hDom : IsOpen (DomC h qs) := by
    have h1 := hqC.continuousOn.isOpen_inter_preimage hU (isOpen_Iio (a := qs))
    have h2 : IsOpen {ξ : Cyl | 0 < ξ.1} := isOpen_lt continuous_const continuous_fst
    exact h2.inter h1
  obtain ⟨Ω, hΩd⟩ : ∃ Ω : Set (ℝ × ℝ),
      Ω = {w : ℝ × ℝ | w.2 < 1 ∧ simScale h w.1 (1 - w.2) < qs} := ⟨_, rfl⟩
  have hmemΩ : ∀ w, w ∈ Ω ↔ (w.2 < 1 ∧ simScale h w.1 (1 - w.2) < qs) := by
    intro w; rw [hΩd]; rfl
  have hΩo : IsOpen Ω := by
    rw [hΩd]
    exact hσ.continuousOn.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const)
      (isOpen_Iio (a := qs))
  have hpΩ : p ∈ Ω := (hmemΩ p).2 ⟨hp1, hp2⟩
  have hΨ : ContDiffOn ℝ ∞
      (fun w : ℝ × ℝ => ((Real.sqrt (simScale h w.1 (1 - w.2)) * R, w.1, w.2, Y) : Cyl)) Ω :=
    (((hσ.mono (fun w hw => ((hmemΩ w).1 hw).1)).sqrt
      (fun w hw => (hσpos w ((hmemΩ w).1 hw).1).ne')).mul contDiffOn_const).prodMk
      (contDiffOn_fst.prodMk (contDiffOn_snd.prodMk contDiffOn_const))
  have hΨmaps : Set.MapsTo
      (fun w : ℝ × ℝ => ((Real.sqrt (simScale h w.1 (1 - w.2)) * R, w.1, w.2, Y) : Cyl)) Ω
      (DomC h qs) := by
    intro w hw
    have hw' := (hmemΩ w).1 hw
    exact ⟨mul_pos (Real.sqrt_pos.mpr (hσpos w hw'.1)) hR, hw'.1, hw'.2⟩
  have hΦsm : ContDiffOn ℝ ∞ Φ Ω := by
    rw [hΦd]; exact contDiffOn_const.mul (hf.comp hΨ hΨmaps)

  obtain ⟨ξ0, hξ0d⟩ : ∃ ξ0 : Cyl, ξ0 = (Real.sqrt q * R, p.1, p.2, Y) := ⟨_, rfl⟩
  have hCf' : ∀ j : ℕ, j ≤ k → NB h f j ξ0 ≤ Cf := by
    intro j hj; rw [hξ0d, hqd]; exact hCf j hj
  have hqξ0 : qC h ξ0 = q := by rw [hξ0d, hqd]; rfl
  have hξ0mem : ξ0 ∈ DomC h qs := by
    rw [hξ0d]; exact ⟨mul_pos (Real.sqrt_pos.mpr hq0) hR, hp1, hp2⟩
  have hΛ : ∀ v : Cyl, Lnorm h ξ0 v =
      (Real.sqrt q * v.1, q ^ (1/2 - h) * v.2.1, q * v.2.2.1, JpowL (-(coarseIdx h q)) v.2.2.2) := by
    intro v
    simp only [Lnorm, hqξ0]
    first | rfl | (simp [ContinuousLinearMap.coe_prodMap', Prod.map]) | (ext <;> simp [Prod.map])
  obtain ⟨θ, hθd⟩ : ∃ θ : ℝ × ℝ → Cyl,
      θ = fun u : ℝ × ℝ => ((R * (ρ u - 1), u.1, u.2, (0 : ℝ × ℝ)) : Cyl) := ⟨_, rfl⟩
  obtain ⟨g, hgd⟩ : ∃ g : Cyl → ℝ, g = fun v : Cyl => f (ξ0 + Lnorm h ξ0 v) := ⟨_, rfl⟩

  have hid : ∀ u : ℝ × ℝ, ((Real.sqrt (simScale h (p + L u).1 (1 - (p + L u).2)) * R,
      (p + L u).1, (p + L u).2, Y) : Cyl) = ξ0 + Lnorm h ξ0 (θ u) := by
    intro u
    have e1 : (p + L u).1 = p.1 + q ^ (1/2 - h) * u.1 := by rw [Prod.fst_add, hL]
    have e2 : (p + L u).2 = p.2 + q * u.2 := by rw [Prod.snd_add, hL]
    obtain ⟨S', hS'd⟩ : ∃ S', S' = simScale h (p.1 + q ^ (1/2 - h) * u.1) (1 - (p.2 + q * u.2)) :=
      ⟨_, rfl⟩
    have hρu : ρ u = Real.sqrt (S' / q) := by rw [hρd, hS'd]
    have hsq : Real.sqrt S' = Real.sqrt q * Real.sqrt (S' / q) := by
      rw [← Real.sqrt_mul hq0.le, mul_div_cancel₀ S' hq0.ne']
    rw [e1, e2, hΛ, hθd, hξ0d]
    simp only [hρu, ← hS'd, map_zero, Prod.mk_add_mk, add_zero]
    rw [hsq]
    congr 1
    ring

  obtain ⟨O, hOd⟩ : ∃ O : Set (ℝ × ℝ), O = (fun u : ℝ × ℝ => p + L u) ⁻¹' Ω := ⟨_, rfl⟩
  have hmemO : ∀ u, u ∈ O ↔ p + L u ∈ Ω := by intro u; rw [hOd]; rfl
  have hOo : IsOpen O := by rw [hOd]; exact hΩo.preimage (continuous_const.add L.continuous)
  have h0O : (0 : ℝ × ℝ) ∈ O := by rw [hmemO, map_zero, add_zero]; exact hpΩ
  have hρeq : ρ = fun u : ℝ × ℝ => Real.sqrt (simScale h (p + L u).1 (1 - (p + L u).2) / q) := by
    funext u; rw [hρd, Prod.fst_add, Prod.snd_add, hL]
  have hσL : ContDiffOn ℝ ∞ (fun u : ℝ × ℝ => simScale h (p + L u).1 (1 - (p + L u).2)) O :=
    hσ.comp (contDiff_const.add L.contDiff).contDiffOn
      (fun u hu => ((hmemΩ _).1 ((hmemO u).1 hu)).1)
  have hσLpos : ∀ u ∈ O, 0 < simScale h (p + L u).1 (1 - (p + L u).2) := fun u hu =>
    hσpos _ ((hmemΩ _).1 ((hmemO u).1 hu)).1
  have hρO : ContDiffOn ℝ ∞ ρ O := by
    rw [hρeq]; exact (hσL.div_const q).sqrt (fun u hu => (div_pos (hσLpos u hu) hq0).ne')
  have hρat : ContDiffAt ℝ ∞ ρ 0 := hρO.contDiffAt (hOo.mem_nhds h0O)
  have hθO : ContDiffOn ℝ ∞ θ O := by
    rw [hθd]
    exact (contDiffOn_const.mul (hρO.sub contDiffOn_const)).prodMk
      (contDiffOn_fst.prodMk (contDiffOn_snd.prodMk contDiffOn_const))

  obtain ⟨T, hTd⟩ : ∃ T : Set Cyl, T = (fun v : Cyl => ξ0 + Lnorm h ξ0 v) ⁻¹' DomC h qs :=
    ⟨_, rfl⟩
  have hmemT : ∀ v, v ∈ T ↔ ξ0 + Lnorm h ξ0 v ∈ DomC h qs := by intro v; rw [hTd]; rfl
  have hTo : IsOpen T := by
    rw [hTd]; exact hDom.preimage (continuous_const.add (Lnorm h ξ0).continuous)
  have h0T : (0 : Cyl) ∈ T := by rw [hmemT, map_zero, add_zero]; exact hξ0mem
  have hgT : ContDiffOn ℝ ∞ g T := by
    rw [hgd]
    exact hf.comp (contDiff_const.add (Lnorm h ξ0).contDiff).contDiffOn
      (fun v hv => (hmemT v).1 hv)
  have hmaps : Set.MapsTo θ O T := by
    intro u hu
    rw [hmemT, ← hid u]
    exact hΨmaps ((hmemO u).1 hu)
  have hρ0 : ρ 0 = 1 := by
    rw [hρd]
    simp only [Prod.fst_zero, Prod.snd_zero, mul_zero, add_zero]
    rw [← hqd, div_self hq0.ne', Real.sqrt_one]
  have hθ0 : θ 0 = 0 := by
    rw [hθd]
    simp only [hρ0, sub_self, mul_zero]
    rfl

  have hCb : ∀ i ≤ k, ‖iteratedFDerivWithin ℝ i g T (θ 0)‖ ≤ Cf := by
    intro i hi
    rw [hθ0, iteratedFDerivWithin_of_isOpen i hTo h0T, hgd,
      key f (DomC h qs) ξ0 (Lnorm h ξ0) hDom hf hξ0mem i]
    exact hCf' i hi

  obtain ⟨ι, hιd⟩ : ∃ ι : ℝ →L[ℝ] Cyl, ι = ContinuousLinearMap.inl ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)) :=
    ⟨_, rfl⟩
  obtain ⟨A, hAd⟩ : ∃ A : ℝ × ℝ →L[ℝ] Cyl, A = (ContinuousLinearMap.inr ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))).comp
      ((ContinuousLinearMap.fst ℝ ℝ ℝ).prod
        ((ContinuousLinearMap.snd ℝ ℝ ℝ).prod (0 : ℝ × ℝ →L[ℝ] ℝ × ℝ))) := ⟨_, rfl⟩
  have hAapp : ∀ u : ℝ × ℝ, A u = ((0 : ℝ), u.1, u.2, (0 : ℝ × ℝ)) := by
    intro u; rw [hAd]; rfl
  have hιapp : ∀ x : ℝ, ι x = (x, (0 : ℝ × ℝ × (ℝ × ℝ))) := by
    intro x; rw [hιd]; rfl
  have hιn : ‖ι‖ ≤ 1 := by rw [hιd]; exact ContinuousLinearMap.norm_inl_le_one ℝ ℝ _
  have hAn : ‖A‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun u => ?_)
    rw [hAapp, one_mul]
    refine norm_prod_le_iff.mpr ⟨by simp, norm_prod_le_iff.mpr ⟨norm_fst_le u,
      norm_prod_le_iff.mpr ⟨norm_snd_le u, by simp⟩⟩⟩
  obtain ⟨σ', hσ'd⟩ : ∃ σ' : ℝ × ℝ → ℝ, σ' = R • ρ - (fun _ => R) := ⟨_, rfl⟩
  have hθsplit : θ = (⇑ι ∘ σ') + ⇑A := by
    funext u
    rw [hθd, Pi.add_apply, Function.comp_apply, hιapp, hAapp, hσ'd]
    simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Prod.mk_add_mk, add_zero, zero_add]
    congr 1
    ring
  have hσ'at : ContDiffAt ℝ ∞ σ' 0 := by
    rw [hσ'd]; exact (hρat.const_smul R).sub contDiffAt_const
  have hDθ : ∀ i : ℕ, 1 ≤ i → ‖iteratedFDeriv ℝ i θ 0‖ ≤ R * ‖iteratedFDeriv ℝ i ρ 0‖ + 1 := by
    intro i hi
    have h1 : ContDiffAt ℝ i (⇑ι ∘ σ') 0 :=
      (ContDiff.comp_contDiffAt 0 ι.contDiff hσ'at).of_le (by exact_mod_cast le_top)
    have h2 : ContDiffAt ℝ i (⇑A) 0 := A.contDiff.contDiffAt
    have hσ'i : iteratedFDeriv ℝ i σ' 0 = R • iteratedFDeriv ℝ i ρ 0 := by
      rw [hσ'd]
      have e1 : iteratedFDeriv ℝ i (R • ρ - fun _ => R) 0 =
          iteratedFDeriv ℝ i (R • ρ) 0 - iteratedFDeriv ℝ i (fun _ : ℝ × ℝ => R) 0 :=
        iteratedFDeriv_sub_apply (f := R • ρ) (g := fun _ => R)
          ((hρat.const_smul R).of_le (by exact_mod_cast le_top)) contDiffAt_const
      rw [e1, iteratedFDeriv_const_smul_apply (hρat.of_le (by exact_mod_cast le_top)),
        iteratedFDeriv_const_of_ne (by omega : i ≠ 0)]
      simp
    have hι' : ‖ι.compContinuousMultilinearMap (iteratedFDeriv ℝ i σ' 0)‖ ≤
        R * ‖iteratedFDeriv ℝ i ρ 0‖ := by
      refine (ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _).trans ?_
      rw [hσ'i, norm_smul, Real.norm_of_nonneg hR.le]
      exact mul_le_of_le_one_left (mul_nonneg hR.le (norm_nonneg _)) hιn
    have hA' : ‖iteratedFDeriv ℝ i (⇑A) 0‖ ≤ 1 := by
      obtain ⟨n, rfl⟩ : ∃ n, i = n + 1 := ⟨i - 1, by omega⟩
      rw [← norm_iteratedFDeriv_fderiv]
      have hfd : fderiv ℝ (⇑A) = fun _ => A := by funext x; exact A.fderiv
      rw [hfd]
      rcases Nat.eq_zero_or_pos n with hn | hn
      · subst hn; rw [norm_iteratedFDeriv_zero]; exact hAn
      · rw [iteratedFDeriv_const_of_ne (by omega : n ≠ 0)]; simp
    rw [hθsplit, iteratedFDeriv_add_apply h1 h2,
      ContinuousLinearMap.iteratedFDeriv_comp_left ι hσ'at (i := i) (by exact_mod_cast le_top)]
    calc ‖ι.compContinuousMultilinearMap (iteratedFDeriv ℝ i σ' 0) + iteratedFDeriv ℝ i (⇑A) 0‖
        ≤ ‖ι.compContinuousMultilinearMap (iteratedFDeriv ℝ i σ' 0)‖ +
            ‖iteratedFDeriv ℝ i (⇑A) 0‖ := norm_add_le _ _
      _ ≤ R * ‖iteratedFDeriv ℝ i ρ 0‖ + 1 := add_le_add hι' hA'
  have hDb : ∀ i : ℕ, 1 ≤ i → i ≤ k → ‖iteratedFDerivWithin ℝ i θ O 0‖ ≤ D ^ i := by
    intro i hi1 hik
    rw [iteratedFDerivWithin_of_isOpen i hOo h0O]
    have hMi : M i ≤ ∑ j ∈ Finset.range (k + 1), M j :=
      Finset.single_le_sum (f := M) (fun j _ => hM0 j) (Finset.mem_range.mpr (by omega))
    have h1 : R * ‖iteratedFDeriv ℝ i ρ 0‖ ≤ R * M i := mul_le_mul_of_nonneg_left (hMp i) hR.le
    have h2 : R * M i ≤ R2 * M i := mul_le_mul_of_nonneg_right hR2 (hM0 i)
    have h3 : R2 * M i ≤ R2 * ∑ j ∈ Finset.range (k + 1), M j :=
      mul_le_mul_of_nonneg_left hMi hR20
    calc ‖iteratedFDeriv ℝ i θ 0‖ ≤ R * ‖iteratedFDeriv ℝ i ρ 0‖ + 1 := hDθ i hi1
      _ ≤ D := by rw [hDd]; linarith
      _ ≤ D ^ i := le_self_pow₀ hD1 (by omega)

  have hFdB := norm_iteratedFDerivWithin_comp_le hgT hθO (by exact_mod_cast le_top)
    hTo.uniqueDiffOn hOo.uniqueDiffOn hmaps h0O (C := Cf) (D := D) hCb hDb

  have hgθ : ContDiffOn ℝ ∞ (g ∘ θ) O := hgT.comp hθO hmaps
  have hfun : (fun u : ℝ × ℝ => Φ (p + L u)) = R ^ e • (g ∘ θ) := by
    funext u
    simp only [hΦd, hgd, Pi.smul_apply, Function.comp_apply, smul_eq_mul]
    rw [hid u]
  rw [← key Φ Ω p L hΩo hΦsm hpΩ k, hfun,
    iteratedFDeriv_const_smul_apply ((hgθ.contDiffAt (hOo.mem_nhds h0O)).of_le
      (by exact_mod_cast le_top)),
    norm_smul, Real.norm_of_nonneg (pow_nonneg hR.le e), ← iteratedFDerivWithin_of_isOpen k hOo h0O]
  exact mul_le_mul_of_nonneg_left hFdB (pow_nonneg hR.le e)

theorem radmom_rescale (B : BG) (qs a : ℝ) (e : ℕ) (g : Cyl → ℝ) (hB : B.ok)
    (hc : ContDiffOn ℝ ∞ (nrm B a g) (DomC B.h qs))
    (hsupp : ∀ ξ ∈ DomC B.h qs, (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → nrm B a g ξ = 0)
    (w : ℝ × ℝ) (hw1 : w.2 < 1) (hw2 : simScale B.h w.1 (1 - w.2) < qs) :
    nrmS B (a - ((e:ℝ) + 1) / 2) (radMom g e) w =
      ∫ y in Set.Icc (Real.sqrt (2 * B.Xa)) (Real.sqrt (2 * B.Xb)) ×ˢ (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1),
        y.1 ^ e * nrm B a g (Real.sqrt (simScale B.h w.1 (1 - w.2)) * y.1, w.1, w.2, y.2) :=
by
  set q := simScale B.h w.1 (1 - w.2) with hqdef
  have hq : 0 < q := (hB.1.1 w.1 (1 - w.2) (by linarith)).1
  set p := Real.sqrt q with hpdef
  have hp : 0 < p := Real.sqrt_pos.mpr hq
  have hp2 : p ^ 2 = q := Real.sq_sqrt hq.le
  have hXa : 0 < B.Xa := hB.2.1.2.2.1
  have hXab : B.Xa ≤ B.Xb := by
    obtain ⟨_, _, _, h1, h2, h3, _⟩ := hB.2.1
    linarith
  have hR1 : 0 < Real.sqrt (2 * B.Xa) := Real.sqrt_pos.mpr (by linarith)

  obtain ⟨Yf, hYf⟩ : ∃ Yf : ℝ → ℝ, ∀ r, Yf r =
      ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, nrm B a g (r, w.1, w.2, Y) := ⟨_, fun r => rfl⟩
  have hqa : q ^ (-a) * q ^ a = 1 := by
    rw [← Real.rpow_add hq]; simp
  have hslice : ∀ r : ℝ, yAvg g (r, w.1, w.2, 0) = q ^ (-a) * Yf r := by
    intro r
    rw [hYf, ← MeasureTheory.integral_const_mul]
    show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (r, w.1, w.2, Y)) = _
    congr 1
    funext Y
    show g (r, w.1, w.2, Y) = q ^ (-a) * (q ^ a * g (r, w.1, w.2, Y))
    rw [← mul_assoc, hqa, one_mul]

  have hvan : ∀ s : ℝ, 0 < s → (s ≤ Real.sqrt (2 * B.Xa) ∨ Real.sqrt (2 * B.Xb) < s) →
      ∀ Y : ℝ × ℝ, nrm B a g (p * s, w.1, w.2, Y) = 0 := by
    intro s hs hsR Y
    have hmem : ((p * s, w.1, w.2, Y) : Cyl) ∈ DomC B.h qs := ⟨mul_pos hp hs, hw1, hw2⟩
    have hXC : XC B.h (p * s, w.1, w.2, Y) = s ^ 2 / 2 := by
      show (p * s) ^ 2 / (2 * q) = s ^ 2 / 2
      rw [mul_pow, hp2, div_eq_div_iff (mul_pos two_pos hq).ne' (by norm_num)]
      ring
    apply hsupp _ hmem
    rw [hXC]
    rcases hsR with h | h
    · left
      have h2 : s ^ 2 ≤ 2 * B.Xa := by
        have := pow_le_pow_left₀ hs.le h 2
        rwa [Real.sq_sqrt (by linarith)] at this
      linarith
    · right
      have h2 : 2 * B.Xb < s ^ 2 := by
        have := pow_lt_pow_left₀ h (Real.sqrt_nonneg _) (by norm_num : (2:ℕ) ≠ 0)
        rwa [Real.sq_sqrt (by linarith)] at this
      linarith

  have hA : nrmS B (a - ((e:ℝ) + 1) / 2) (radMom g e) w =
      q ^ (a - ((e:ℝ) + 1) / 2) * ∫ r in Set.Ioi (0:ℝ), r ^ e * yAvg g (r, w.1, w.2, 0) := rfl
  have hB1 : (∫ r in Set.Ioi (0:ℝ), r ^ e * yAvg g (r, w.1, w.2, 0)) =
      q ^ (-a) * ∫ r in Set.Ioi (0:ℝ), r ^ e * Yf r := by
    rw [← MeasureTheory.integral_const_mul]
    congr 1
    funext r
    rw [hslice r]
    ring

  have hdil : (∫ r in Set.Ioi (0:ℝ), r ^ e * Yf r) =
      p * (p ^ e * ∫ x in Set.Ioi (0:ℝ), x ^ e * Yf (p * x)) := by
    have hcv := MeasureTheory.integral_comp_mul_left_Ioi (fun r : ℝ => r ^ e * Yf r) 0 hp
    simp only [mul_zero] at hcv
    rw [← MeasureTheory.integral_const_mul]
    have h3 : (fun x : ℝ => p ^ e * (x ^ e * Yf (p * x))) = fun x => (p * x) ^ e * Yf (p * x) := by
      funext x
      rw [mul_pow]
      ring
    rw [h3, hcv, smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hp.ne', one_mul]

  have hres : (∫ x in Set.Ioi (0:ℝ), x ^ e * Yf (p * x)) =
      ∫ x in Set.Icc (Real.sqrt (2 * B.Xa)) (Real.sqrt (2 * B.Xb)), x ^ e * Yf (p * x) := by
    apply MeasureTheory.setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi
    · intro x hx
      exact lt_of_lt_of_le hR1 hx.1
    · intro x hx
      obtain ⟨hx0, hx1⟩ := hx
      have hx0' : 0 < x := hx0
      have hor : x ≤ Real.sqrt (2 * B.Xa) ∨ Real.sqrt (2 * B.Xb) < x := by
        by_contra hcon
        push_neg at hcon
        exact hx1 ⟨hcon.1.le, hcon.2⟩
      have hz : Yf (p * x) = 0 := by
        rw [hYf]
        simp [hvan x hx0' hor]
      rw [hz, mul_zero]

  have hK : IsCompact (Set.Icc (Real.sqrt (2 * B.Xa)) (Real.sqrt (2 * B.Xb)) ×ˢ
      (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) :=
    isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc)
  have hcont : ContinuousOn (fun y : ℝ × (ℝ × ℝ) => y.1 ^ e * nrm B a g (p * y.1, w.1, w.2, y.2))
      (Set.Icc (Real.sqrt (2 * B.Xa)) (Real.sqrt (2 * B.Xb)) ×ˢ (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) := by
    have hφ : Continuous (fun y : ℝ × (ℝ × ℝ) => ((p * y.1, w.1, w.2, y.2) : Cyl)) := by fun_prop
    have hmaps : Set.MapsTo (fun y : ℝ × (ℝ × ℝ) => ((p * y.1, w.1, w.2, y.2) : Cyl))
        (Set.Icc (Real.sqrt (2 * B.Xa)) (Real.sqrt (2 * B.Xb)) ×ˢ (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1))
        (DomC B.h qs) := by
      intro y hy
      exact ⟨mul_pos hp (lt_of_lt_of_le hR1 hy.1.1), hw1, hw2⟩
    exact (continuous_fst.pow e).continuousOn.mul (hc.continuousOn.comp hφ.continuousOn hmaps)
  have hint : MeasureTheory.IntegrableOn
      (fun y : ℝ × (ℝ × ℝ) => y.1 ^ e * nrm B a g (p * y.1, w.1, w.2, y.2))
      (Set.Icc (Real.sqrt (2 * B.Xa)) (Real.sqrt (2 * B.Xb)) ×ˢ (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1))
      ((MeasureTheory.volume : MeasureTheory.Measure ℝ).prod
        (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ))) :=
    hcont.integrableOn_compact hK
  have hfub : (∫ y in Set.Icc (Real.sqrt (2 * B.Xa)) (Real.sqrt (2 * B.Xb)) ×ˢ
        (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), y.1 ^ e * nrm B a g (p * y.1, w.1, w.2, y.2)) =
      ∫ x in Set.Icc (Real.sqrt (2 * B.Xa)) (Real.sqrt (2 * B.Xb)), x ^ e * Yf (p * x) := by
    rw [MeasureTheory.Measure.volume_eq_prod ℝ (ℝ × ℝ), MeasureTheory.setIntegral_prod _ hint]
    congr 1
    funext x
    rw [hYf, ← MeasureTheory.integral_const_mul]

  have hpe : p ^ (e + 1) = q ^ (((e:ℝ) + 1) / 2) := by
    rw [hpdef, Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hq.le]
    congr 1
    push_cast
    ring
  have hconst : q ^ (a - ((e:ℝ) + 1) / 2) * (q ^ (-a) * (p * p ^ e)) = 1 := by
    rw [← pow_succ', hpe, ← Real.rpow_add hq, ← Real.rpow_add hq]
    convert Real.rpow_zero q using 2
    ring
  rw [hA, hB1, hdil, hres, hfub]
  linear_combination (∫ x in Set.Icc (Real.sqrt (2 * B.Xa)) (Real.sqrt (2 * B.Xb)),
    x ^ e * Yf (p * x)) * hconst

theorem radmom_integrand_smooth (h qs : ℝ) (e : ℕ) (f : Cyl → ℝ) (hS : SimScaleProps h)
    (hf : ContDiffOn ℝ ∞ f (DomC h qs)) :
    ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ) × (ℝ × (ℝ × ℝ)) =>
        z.2.1 ^ e * f (Real.sqrt (simScale h z.1.1 (1 - z.1.2)) * z.2.1, z.1.1, z.1.2, z.2.2))
      ({w : ℝ × ℝ | w.2 < 1 ∧ simScale h w.1 (1 - w.2) < qs} ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.univ)) :=
by
  set W : Set ((ℝ × ℝ) × (ℝ × (ℝ × ℝ))) :=
    {w : ℝ × ℝ | w.2 < 1 ∧ simScale h w.1 (1 - w.2) < qs} ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.univ) with hW
  have hmem : ∀ z ∈ W, z.1.2 < 1 ∧ simScale h z.1.1 (1 - z.1.2) < qs ∧ 0 < z.2.1 := by
    intro z hz
    obtain ⟨⟨h1, h2⟩, h3, -⟩ := hz
    exact ⟨h1, h2, h3⟩
  have hA : ContDiff ℝ ∞ (fun z : (ℝ × ℝ) × (ℝ × (ℝ × ℝ)) => (z.1.1, 1 - z.1.2)) :=
    contDiff_fst.fst.prodMk (contDiff_const.sub contDiff_fst.snd)
  have hP4 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
    hS.2.2.2.1
  have hs : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ) × (ℝ × (ℝ × ℝ)) => simScale h z.1.1 (1 - z.1.2)) W := by
    have := hP4.comp hA.contDiffOn (fun z hz => ⟨Set.mem_univ _,
      show (0:ℝ) < 1 - z.1.2 by linarith [(hmem z hz).1]⟩)
    exact this
  have hpos : ∀ z ∈ W, 0 < simScale h z.1.1 (1 - z.1.2) := fun z hz =>
    (hS.1 z.1.1 (1 - z.1.2) (by linarith [(hmem z hz).1])).1
  have hsq : ContDiffOn ℝ ∞
      (fun z : (ℝ × ℝ) × (ℝ × (ℝ × ℝ)) => Real.sqrt (simScale h z.1.1 (1 - z.1.2))) W :=
    hs.sqrt (fun z hz => (hpos z hz).ne')
  have hΦ : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ) × (ℝ × (ℝ × ℝ)) =>
      ((Real.sqrt (simScale h z.1.1 (1 - z.1.2)) * z.2.1, z.1.1, z.1.2, z.2.2) : Cyl)) W :=
    (hsq.mul contDiff_snd.fst.contDiffOn).prodMk
      (contDiff_fst.fst.contDiffOn.prodMk (contDiff_fst.snd.contDiffOn.prodMk contDiff_snd.snd.contDiffOn))
  have hmaps : Set.MapsTo (fun z : (ℝ × ℝ) × (ℝ × (ℝ × ℝ)) =>
      ((Real.sqrt (simScale h z.1.1 (1 - z.1.2)) * z.2.1, z.1.1, z.1.2, z.2.2) : Cyl)) W (DomC h qs) := by
    intro z hz
    obtain ⟨h1, h2, h3⟩ := hmem z hz
    exact ⟨mul_pos (Real.sqrt_pos.mpr (hpos z hz)) h3, h1, h2⟩
  have hcomp := hf.comp hΦ hmaps
  exact (contDiff_snd.fst.pow e).contDiffOn.mul hcomp

theorem mom_radial_moment_class_v4 : ∀ (B : BG), B.ok → SimNorm B.h → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (g : Cyl → ℝ) (α a : ℝ) (e : ℕ), e ≤ 2 → InM B (qsOf l0) α (nrm B a g) →
      InS B (qsOf l0) α (nrmS B (a - ((e:ℝ) + 1) / 2) (radMom g e)) :=
by
  intro B hok hSN
  refine ⟨0, ?_⟩
  intro l0 _ g α a e _ hf
  have hS : SimScaleProps B.h := hok.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hXab : B.Xa < B.Xb := by
    obtain ⟨_, _, _, h1, h2, h3, _⟩ := hok.2.1
    linarith
  have hqs1 : qsOf l0 ≤ 1 := by
    unfold qsOf Qb
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  obtain ⟨hf1, hf2, hf3, hf4⟩ := hf
  have hR1 : 0 < Real.sqrt (2 * B.Xa) := Real.sqrt_pos.mpr (by linarith)
  have hR2 : 0 < Real.sqrt (2 * B.Xb) := Real.sqrt_pos.mpr (by linarith)

  have hσ : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2)) {w : ℝ × ℝ | w.2 < 1} := by
    have h4 : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hS.2.2.2.1.continuousOn
    have hc : Continuous (fun w : ℝ × ℝ => (w.1, 1 - w.2)) :=
      continuous_fst.prodMk (continuous_const.sub continuous_snd)
    exact h4.comp hc.continuousOn (fun w hw => ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by
      have hw' : w.2 < 1 := hw
      linarith⟩)
  have hΩ : IsOpen {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qsOf l0} := by
    have := hσ.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) (isOpen_Iio (a := qsOf l0))
    exact this

  obtain ⟨Kc, hKcdef⟩ : ∃ Kc : Set (ℝ × (ℝ × ℝ)), Kc = Set.Icc (Real.sqrt (2 * B.Xa)) (Real.sqrt (2 * B.Xb)) ×ˢ
      (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := ⟨_, rfl⟩
  have hKc : IsCompact Kc := by
    rw [hKcdef]; exact isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc)
  have hKV : Kc ⊆ Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set (ℝ × ℝ)) := by
    rw [hKcdef]
    intro y hy
    exact ⟨lt_of_lt_of_le hR1 hy.1.1, mem_univ _⟩

  have hs6 := radmom_integrand_smooth B.h (qsOf l0) e (nrm B a g) hS hf1
  obtain ⟨hΦ, hDΦ⟩ := param_integral_contDiff (volume : Measure (ℝ × (ℝ × ℝ)))
    {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qsOf l0}
    (Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set (ℝ × ℝ))) Kc
    (fun x y => y.1 ^ e * nrm B a g (Real.sqrt (simScale B.h x.1 (1 - x.2)) * y.1, x.1, x.2, y.2))
    hΩ (isOpen_Ioi.prod isOpen_univ) hKc hKV hs6

  have hFeq : ∀ w ∈ {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qsOf l0},
      nrmS B (a - ((e:ℝ) + 1) / 2) (radMom g e) w =
        ∫ y in Kc, y.1 ^ e * nrm B a g (Real.sqrt (simScale B.h w.1 (1 - w.2)) * y.1, w.1, w.2, y.2) := by
    intro w hw
    rw [hKcdef]
    exact radmom_rescale B (qsOf l0) a e g hok hf1 hf3 w hw.1 hw.2
  refine ⟨hΦ.congr (fun x hx => hFeq x hx), fun k => ?_⟩

  obtain ⟨A, b, hAb⟩ := inm_nb_uniform B (qsOf l0) α (nrm B a g) hok ⟨hf1, hf2, hf3, hf4⟩ k
  choose M0 hM0 using fun i => simnorm_sqrt_ratio_bound B.h hS hSN i
  have hsum : 0 ≤ ∑ i ∈ Finset.range (k + 1), |M0 i| := Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have hD1 : 1 ≤ 1 + Real.sqrt (2 * B.Xb) * ∑ i ∈ Finset.range (k + 1), |M0 i| :=
    le_add_of_nonneg_right (mul_nonneg hR2.le hsum)
  have hDk : 0 ≤ (1 + Real.sqrt (2 * B.Xb) * ∑ i ∈ Finset.range (k + 1), |M0 i|) ^ k :=
    pow_nonneg (le_trans zero_le_one hD1) k
  refine ⟨Real.sqrt (2 * B.Xb) ^ e * ((k.factorial : ℝ) * |A| *
      (1 + Real.sqrt (2 * B.Xb) * ∑ i ∈ Finset.range (k + 1), |M0 i|) ^ k) * volume.real Kc, b,
      fun w hw1 hw2 => ?_⟩
  have hq0 : 0 < simScale B.h w.1 (1 - w.2) := (hS.1 w.1 (1 - w.2) (by linarith)).1
  have hwΩ : w ∈ {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qsOf l0} := ⟨hw1, hw2⟩
  have hev : nrmS B (a - ((e:ℝ) + 1) / 2) (radMom g e) =ᶠ[nhds w]
      (fun x : ℝ × ℝ => ∫ y in Kc,
        y.1 ^ e * nrm B a g (Real.sqrt (simScale B.h x.1 (1 - x.2)) * y.1, x.1, x.2, y.2)) :=
    Filter.eventuallyEq_of_mem (hΩ.mem_nhds hwΩ) (fun x hx => hFeq x hx)
  have hEq : iteratedFDeriv ℝ k (nrmS B (a - ((e:ℝ) + 1) / 2) (radMom g e)) w =
      ∫ y in Kc, iteratedFDeriv ℝ k (fun x' : ℝ × ℝ =>
        y.1 ^ e * nrm B a g (Real.sqrt (simScale B.h x'.1 (1 - x'.2)) * y.1, x'.1, x'.2, y.2)) w := by
    rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
    exact hDΦ k w hwΩ
  rw [hEq]

  have key : ∀ (φ : ℝ × (ℝ × ℝ) → ContinuousMultilinearMap ℝ (fun _ : Fin k => ℝ × ℝ) ℝ) (Cb : ℝ),
      0 ≤ Cb →
      (∀ᵐ y ∂(volume : Measure (ℝ × (ℝ × ℝ))), y ∈ Kc →
        ‖(φ y).compContinuousLinearMap (fun _ =>
          (simScale B.h w.1 (1 - w.2) ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
            (simScale B.h w.1 (1 - w.2) • ContinuousLinearMap.id ℝ ℝ))‖ ≤ Cb) →
      ‖(∫ y in Kc, φ y).compContinuousLinearMap (fun _ =>
          (simScale B.h w.1 (1 - w.2) ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
            (simScale B.h w.1 (1 - w.2) • ContinuousLinearMap.id ℝ ℝ))‖ ≤ Cb * volume.real Kc := by
    intro φ Cb hCb hae
    have hT : ∀ m : ContinuousMultilinearMap ℝ (fun _ : Fin k => ℝ × ℝ) ℝ,
        m.compContinuousLinearMap (fun _ =>
          (simScale B.h w.1 (1 - w.2) ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
            (simScale B.h w.1 (1 - w.2) • ContinuousLinearMap.id ℝ ℝ)) =
        ContinuousMultilinearMap.compContinuousLinearMapL (fun _ : Fin k =>
          (simScale B.h w.1 (1 - w.2) ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
            (simScale B.h w.1 (1 - w.2) • ContinuousLinearMap.id ℝ ℝ)) m :=
      fun m => (ContinuousMultilinearMap.compContinuousLinearMapL_apply _ _).symm
    rw [hT]
    by_cases hint : Integrable φ (volume.restrict Kc)
    · rw [← ContinuousLinearMap.integral_comp_comm _ hint]
      refine norm_setIntegral_le_of_norm_le_const_ae' hKc.measure_lt_top ?_
      filter_upwards [hae] with y hy hyK
      rw [← hT]
      exact hy hyK
    · rw [integral_undef hint, map_zero, norm_zero]
      exact mul_nonneg hCb measureReal_nonneg

  have hN0 : volume (({Real.sqrt (2 * B.Xa), Real.sqrt (2 * B.Xb)} : Set ℝ) ×ˢ
      (Set.univ : Set (ℝ × ℝ))) = 0 := by
    rw [MeasureTheory.Measure.volume_eq_prod ℝ (ℝ × ℝ), MeasureTheory.Measure.prod_prod,
      ((Set.finite_singleton _).insert _).measure_zero _, zero_mul]
  have hNae := measure_eq_zero_iff_ae_notMem.mp hN0
  have hCf0 : 0 ≤ |A| * simScale B.h w.1 (1 - w.2) ^ (B.h * α) *
      (1 + |Real.log (simScale B.h w.1 (1 - w.2))|) ^ (2 * b) :=
    mul_nonneg (mul_nonneg (abs_nonneg _) (Real.rpow_nonneg hq0.le _))
      (Real.rpow_nonneg (by positivity) _)
  have hnn : 0 ≤ (k.factorial : ℝ) * (|A| * simScale B.h w.1 (1 - w.2) ^ (B.h * α) *
      (1 + |Real.log (simScale B.h w.1 (1 - w.2))|) ^ (2 * b)) *
      (1 + Real.sqrt (2 * B.Xb) * ∑ i ∈ Finset.range (k + 1), |M0 i|) ^ k :=
    mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hCf0) hDk
  refine le_trans (key _ _ (mul_nonneg (pow_nonneg hR2.le e) hnn) ?_) (le_of_eq (by ring))
  filter_upwards [hNae] with y hyN hyK
  rw [hKcdef] at hyK
  have hyK' := Set.mem_prod.mp hyK
  have hy1 : Real.sqrt (2 * B.Xa) ≤ y.1 := hyK'.1.1
  have hy2 : y.1 ≤ Real.sqrt (2 * B.Xb) := hyK'.1.2
  have hne1 : y.1 ≠ Real.sqrt (2 * B.Xa) := fun h =>
    hyN (Set.mem_prod.mpr ⟨Set.mem_insert_iff.mpr (Or.inl h), Set.mem_univ _⟩)
  have hne2 : y.1 ≠ Real.sqrt (2 * B.Xb) := fun h =>
    hyN (Set.mem_prod.mpr ⟨Set.mem_insert_iff.mpr (Or.inr (Set.mem_singleton_iff.mpr h)), Set.mem_univ _⟩)
  have hy0 : 0 < y.1 := lt_of_lt_of_le hR1 hy1
  have hsq1 : 2 * B.Xa < y.1 ^ 2 := (Real.sqrt_lt' hy0).mp (lt_of_le_of_ne hy1 (Ne.symm hne1))
  have hsq2 : y.1 ^ 2 < 2 * B.Xb := (Real.lt_sqrt hy0.le).mp (lt_of_le_of_ne hy2 hne2)
  have hXC : XC B.h (Real.sqrt (simScale B.h w.1 (1 - w.2)) * y.1, w.1, w.2, y.2) = y.1 ^ 2 / 2 := by
    show (Real.sqrt (simScale B.h w.1 (1 - w.2)) * y.1) ^ 2 / (2 * simScale B.h w.1 (1 - w.2)) = y.1 ^ 2 / 2
    rw [mul_pow, Real.sq_sqrt hq0.le, div_eq_div_iff (mul_pos two_pos hq0).ne' (by norm_num)]
    ring
  have hmem : (Real.sqrt (simScale B.h w.1 (1 - w.2)) * y.1, w.1, w.2, y.2) ∈ DomC B.h (qsOf l0) :=
    ⟨mul_pos (Real.sqrt_pos.mpr hq0) hy0, hw1, hw2⟩
  have hCf : ∀ j : ℕ, j ≤ k → NB B.h (nrm B a g) j
      (Real.sqrt (simScale B.h w.1 (1 - w.2)) * y.1, w.1, w.2, y.2) ≤
      |A| * simScale B.h w.1 (1 - w.2) ^ (B.h * α) *
        (1 + |Real.log (simScale B.h w.1 (1 - w.2))|) ^ (2 * b) := by
    intro j hj
    refine le_trans (hAb _ hmem (by rw [hXC]; linarith) (by rw [hXC]; linarith) j hj) ?_
    show A * simScale B.h w.1 (1 - w.2) ^ (B.h * α) *
        (1 + |Real.log (simScale B.h w.1 (1 - w.2))|) ^ (2 * b) ≤ _
    simp only [mul_assoc]
    exact mul_le_mul_of_nonneg_right (le_abs_self A)
      (mul_nonneg (Real.rpow_nonneg hq0.le _) (Real.rpow_nonneg (by positivity) _))
  have hs4 := radmom_chain_bound B.h (qsOf l0) (Real.sqrt (2 * B.Xb)) (nrm B a g) k e (fun i => |M0 i|)
    hS hqs1 hf1 (fun i z t ht hq => le_trans (hM0 i z t ht (le_trans hq.le hqs1)) (le_abs_self _))
    w y.1 y.2 _ hw1 hw2 hy0 hy2 hCf
  exact le_trans hs4 (mul_le_mul_of_nonneg_right (pow_le_pow_left₀ hy0.le hy2 e) hnn)

theorem xc_profile_mul_class_v4 : ∀ (B : BG) (qs α : ℝ) (φ : ℝ → ℝ) (S : Set ℝ) (F : Cyl → ℝ),
    B.ok → SimNorm B.h → 0 < qs → qs ≤ 1 → ContDiff ℝ ∞ φ → IsClosed S → (∀ X, X ∉ S → φ X = 0) →
    ContDiffOn ℝ ∞ F (DomC B.h qs) →
    (∀ ξ ∈ DomC B.h qs, ∀ a, IsDeck B.h (qC B.h ξ) a → F (shY ξ a) = F ξ) →
    (∀ ξ ∈ DomC B.h qs, (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → φ (XC B.h ξ) * F ξ = 0) →
    (∀ k : ℕ, ∃ C b d : ℝ, ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → XC B.h ξ ∈ S →
      NB B.h F k ξ ≤ C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b *
        edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d)) →
    InM B qs α (fun ξ => φ (XC B.h ξ) * F ξ) :=
by
  intro B qs α φ S F hok hSN hqs0 hqs1 hφ hS hφS hF hFd hsupp hbd
  obtain ⟨hDo, hqpos, hXc⟩ : IsOpen (DomC B.h qs) ∧ (∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ) ∧
      ContinuousOn (XC B.h) (DomC B.h qs) := by
    have hmemD : ∀ ξ ∈ DomC B.h qs, 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := fun ξ hξ => hξ
    have hT : IsOpen {ξ : Cyl | ξ.2.2.1 < 1} :=
      isOpen_lt continuous_snd.snd.fst continuous_const
    have hqc : ContinuousOn (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
      have hs := hok.1.2.2.2.1
      have hg : Continuous (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
        continuous_snd.fst.prodMk (continuous_const.sub continuous_snd.snd.fst)
      have hc := hs.continuousOn.comp hg.continuousOn (fun ξ (hξ : ξ.2.2.1 < 1) =>
        (⟨Set.mem_univ _, Set.mem_Ioi.mpr (sub_pos.mpr hξ)⟩ : (ξ.2.1, 1 - ξ.2.2.1) ∈ Set.univ ×ˢ Set.Ioi (0:ℝ)))
      exact hc
    have hqp : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ := fun ξ hξ =>
      (hok.1.1 _ _ (sub_pos.mpr (hmemD ξ hξ).2.1)).1
    refine ⟨?_, hqp, ?_⟩
    · have h1 : IsOpen ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Set.Iio qs) :=
        hqc.isOpen_inter_preimage hT isOpen_Iio
      have h2 : IsOpen {ξ : Cyl | 0 < ξ.1} := isOpen_lt continuous_const continuous_fst
      have e : DomC B.h qs = {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Set.Iio qs) := by
        ext ξ
        simp only [DomC, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iio]
      rw [e]
      exact h2.inter h1
    · have hq' : ContinuousOn (qC B.h) (DomC B.h qs) := hqc.mono (fun ξ hξ => (hmemD ξ hξ).2.1)
      have hc : ContinuousOn (fun ξ : Cyl => ξ.1 ^ 2 / (2 * qC B.h ξ)) (DomC B.h qs) :=
        (continuous_fst.pow 2).continuousOn.div (continuousOn_const.mul hq')
          (fun ξ hξ => by have := hqp ξ hξ; positivity)
      exact hc
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  obtain ⟨hφX0, hM0⟩ := qpow_profile_nb_v4 B qs hok hSN hqs0 hqs1 φ 0 hφ.contDiffOn
  simp only [Real.rpow_zero, one_mul, mul_one] at hφX0 hM0
  have hφX : ContDiffOn ℝ ∞ (fun η => φ (XC B.h η)) (DomC B.h qs) := hφX0
  refine ⟨hφX.mul hF, ?_, hsupp, ?_⟩
  · intro ξ hξ a ha
    show φ (XC B.h (shY ξ a)) * F (shY ξ a) = φ (XC B.h ξ) * F ξ
    rw [hFd ξ hξ a ha]
    rfl
  · intro k
    choose Cf bf df hCf using hbd
    choose M hMb using hM0
    obtain ⟨b, hb⟩ : ∃ b : ℝ, b = ∑ j ∈ Finset.range (k + 1), |bf j| := ⟨_, rfl⟩
    obtain ⟨d, hd⟩ : ∃ d : ℝ, d = ∑ j ∈ Finset.range (k + 1), |df j| := ⟨_, rfl⟩
    obtain ⟨Ct, hCt⟩ : ∃ Ct : ℝ,
        Ct = ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * |M i| * |Cf (k - i)| := ⟨_, rfl⟩
    have hbj : ∀ j, j ≤ k → bf j ≤ b := by
      intro j hj
      rw [hb]
      exact (le_abs_self _).trans (Finset.single_le_sum (f := fun j => |bf j|)
        (fun j _ => abs_nonneg (bf j)) (Finset.mem_range.mpr (by omega)))
    have hdj : ∀ j, j ≤ k → df j ≤ d := by
      intro j hj
      rw [hd]
      exact (le_abs_self _).trans (Finset.single_le_sum (f := fun j => |df j|)
        (fun j _ => abs_nonneg (df j)) (Finset.mem_range.mpr (by omega)))
    have hCt0 : 0 ≤ Ct := by
      rw [hCt]
      exact Finset.sum_nonneg (fun i _ => by positivity)
    refine ⟨Ct, b, d, ?_⟩
    intro ξ hξ h1 h2
    have hq : 0 < qC B.h ξ := hqpos ξ hξ
    have hSC1 : 1 ≤ SC B.h ξ := by
      have := abs_nonneg (Real.log (qC B.h ξ))
      unfold SC
      nlinarith
    have hEW : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
      unfold edgeWeight
      split_ifs
      · positivity
      · exact le_rfl
    have hX0 : 0 < XC B.h ξ := lt_trans hXa h1
    have hED0 : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) := by
      unfold edgeDist
      exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr h1))
        (Real.log_pos ((one_lt_div hX0).mpr h2)))
    have hED1 : edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := min_le_left _ _
    have hqa : 0 ≤ qC B.h ξ ^ (B.h * α) := Real.rpow_nonneg hq.le _
    have hW0 : ∀ b' d' : ℝ, 0 ≤ qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b' *
        edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d') := by
      intro b' d'
      have h3 : 0 ≤ SC B.h ξ ^ b' := Real.rpow_nonneg (by linarith) _
      have h4 : 0 ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d') := Real.rpow_nonneg hED0.le _
      exact mul_nonneg (mul_nonneg (mul_nonneg hqa h3) hEW) h4
    have hWle : ∀ j, j ≤ k → qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ (bf j) *
        edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(df j)) ≤
        qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b *
        edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) := by
      intro j hj
      have hSCb : SC B.h ξ ^ (bf j) ≤ SC B.h ξ ^ b :=
        Real.rpow_le_rpow_of_exponent_le hSC1 (hbj j hj)
      have hEDd : edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(df j)) ≤ edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) :=
        Real.rpow_le_rpow_of_exponent_ge hED0 hED1 (neg_le_neg (hdj j hj))
      have hA : qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ (bf j) ≤ qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b :=
        mul_le_mul_of_nonneg_left hSCb hqa
      have hB : qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ (bf j) * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) ≤
          qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) :=
        mul_le_mul_of_nonneg_right hA hEW
      have hBn : 0 ≤ qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) :=
        mul_nonneg (mul_nonneg hqa (Real.rpow_nonneg (by linarith) _)) hEW
      calc _ ≤ qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b * edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(df j)) :=
            mul_le_mul_of_nonneg_right hB (Real.rpow_nonneg hED0.le _)
        _ ≤ _ := mul_le_mul_of_nonneg_left hEDd hBn
    have hgoal : NB B.h (fun ξ => φ (XC B.h ξ) * F ξ) k ξ ≤ Ct * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b *
        edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d)) := by
      by_cases hXS : XC B.h ξ ∈ S
      · have hL := nb_mul_le_v4 B.h (DomC B.h qs) (fun η => φ (XC B.h η)) F hDo hφX hF ξ hξ k
        refine hL.trans ?_
        rw [hCt, Finset.sum_mul]
        apply Finset.sum_le_sum
        intro i hi
        have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        have hN1 : NB B.h (fun η => φ (XC B.h η)) i ξ ≤ |M i| := (hMb i ξ hξ h1 h2).trans (le_abs_self _)
        have hN2' : 0 ≤ NB B.h F (k - i) ξ := by unfold NB; exact norm_nonneg _
        have hN2 : NB B.h F (k - i) ξ ≤ |Cf (k - i)| * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d)) := by
          have h0 := hCf (k - i) ξ hξ h1 h2 hXS
          have hWj := hWle (k - i) (Nat.sub_le k i)
          have hWj0 := hW0 (bf (k - i)) (df (k - i))
          calc NB B.h F (k - i) ξ ≤ Cf (k - i) * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ (bf (k - i)) *
                edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
                edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(df (k - i)))) := by
                refine h0.trans (le_of_eq ?_)
                ring
            _ ≤ |Cf (k - i)| * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ (bf (k - i)) *
                edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
                edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(df (k - i)))) :=
                mul_le_mul_of_nonneg_right (le_abs_self _) hWj0
            _ ≤ _ := mul_le_mul_of_nonneg_left hWj (abs_nonneg _)
        calc (k.choose i : ℝ) * NB B.h (fun η => φ (XC B.h η)) i ξ * NB B.h F (k - i) ξ ≤
            (k.choose i : ℝ) * |M i| * (|Cf (k - i)| * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d))) :=
              mul_le_mul (mul_le_mul_of_nonneg_left hN1 (Nat.cast_nonneg _)) hN2 hN2'
                (mul_nonneg (Nat.cast_nonneg _) (abs_nonneg _))
          _ = _ := by ring
      · have hV : IsOpen (DomC B.h qs ∩ XC B.h ⁻¹' Sᶜ) := hXc.isOpen_inter_preimage hDo hS.isOpen_compl
        have hmem : ξ ∈ DomC B.h qs ∩ XC B.h ⁻¹' Sᶜ := ⟨hξ, hXS⟩
        have hev : (fun η => φ (XC B.h η) * F η) =ᶠ[nhds ξ] fun _ => (0:ℝ) :=
          Filter.eventuallyEq_of_mem (hV.mem_nhds hmem) (fun η hη => by
            show φ (XC B.h η) * F η = 0
            rw [hφS _ hη.2, zero_mul])
        have hNB0 : NB B.h (fun η => φ (XC B.h η) * F η) k ξ = 0 := by
          unfold NB
          rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_zero, norm_eq_zero]
          ext v
          simp
        rw [hNB0]
        exact mul_nonneg hCt0 (hW0 b d)
    refine hgoal.trans (le_of_eq ?_)
    ring

theorem rhoP_moment_class_v4 : ∀ (B : BG) (qs α : ℝ), B.ok → SimNorm B.h → 0 < qs → qs ≤ 1 →
    ∀ (F : ℝ → ℝ → ℝ), InS B qs α (nrmS B (2 * Aex B.h) F) →
      InM B qs α (nrm B (2 * Aex B.h + 1/2) (fun η => rhoP B η * F η.2.1 η.2.2.1)) :=
by
  intro B qs α hok hSN hqs0 hqs1 F hF
  obtain ⟨-, -, hXa, hXm, hm12, hm2b, -, -, -, -, -, haa, hab⟩ := hok.2.1
  have hpos : ∀ η ∈ DomC B.h qs, 0 < qC B.h η := by
    intro η hη
    have h2 : η.2.2.1 < 1 := hη.2.1
    exact (hok.1.1 η.2.1 (1 - η.2.2.1) (by linarith)).1

  have hab' : Real.sqrt (2 * B.m1) < Real.sqrt (2 * B.m2) :=
    Real.sqrt_lt_sqrt (by linarith) (by linarith)
  have hvan : ∀ s : ℝ, (s ≤ Real.sqrt (2 * B.m1) ∨ Real.sqrt (2 * B.m2) < s) → rhoHat B s = 0 := by
    intro s hs
    have hw : 0 < (Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2 := by linarith
    have hu : 1 ≤ ((s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) ^ 2 := by
      rcases hs with hs | hs
      · have h1 : (s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
            ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2) ≤ -1 := by
          rw [div_le_iff₀ hw]; linarith
        nlinarith
      · have h1 : 1 < (s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
            ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2) := by
          rw [lt_div_iff₀ hw]; linarith
        nlinarith
    have hnum : bumpR ((s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
        ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2)) = 0 :=
      Real.smoothTransition.zero_of_nonpos (by linarith)
    unfold rhoHat
    rw [hnum, zero_div]
  have hRH : ContDiff ℝ ∞ (rhoHat B) := by
    unfold rhoHat bumpR
    apply ContDiff.div_const
    exact Real.smoothTransition.contDiff.comp (by fun_prop)
  have hψ0 : ∀ X : ℝ, X ∉ Set.Icc B.m1 B.m2 → rhoHat B (Real.sqrt (2 * X)) = 0 := by
    intro X hX
    rw [Set.mem_Icc, not_and_or, not_le, not_le] at hX
    rcases hX with hX | hX
    · exact hvan _ (Or.inl (Real.sqrt_le_sqrt (by linarith)))
    · exact hvan _ (Or.inr (Real.sqrt_lt_sqrt (by linarith) (by linarith)))
  have hψs : ContDiff ℝ ∞ (fun X : ℝ => rhoHat B (Real.sqrt (2 * X))) := by
    rw [contDiff_iff_contDiffAt]
    intro X
    rcases lt_or_ge X B.m1 with hX | hX
    · have hev : (fun X : ℝ => rhoHat B (Real.sqrt (2 * X))) =ᶠ[nhds X] fun _ => (0:ℝ) := by
        filter_upwards [Iio_mem_nhds hX] with Y hY
        exact hψ0 Y (fun h => absurd h.1 (not_le.mpr hY))
      exact contDiffAt_const.congr_of_eventuallyEq hev
    · have hX0 : 0 < X := by linarith
      have hsq : ContDiffAt ℝ ∞ (fun Y : ℝ => Real.sqrt (2 * Y)) X :=
        ContDiffAt.sqrt (by fun_prop) (mul_pos two_pos hX0).ne'
      exact hRH.contDiffAt.comp X hsq

  have hs1 : 0 < Real.log (B.m1 / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr hXm)
  have hm2pos : 0 < B.m2 := by linarith
  have hl2 : 0 < Real.log (B.Xb / B.m2) := Real.log_pos ((one_lt_div hm2pos).mpr hm2b)
  obtain ⟨cE, hcEdef⟩ : ∃ cE : ℝ,
      cE = Real.exp (-(B.aa / Real.log (B.m1 / B.Xa) ^ 2) - B.ab / Real.log (B.Xb / B.m2) ^ 2) :=
    ⟨_, rfl⟩
  have hcE : 0 < cE := by rw [hcEdef]; exact Real.exp_pos _
  have hEW : ∀ X : ℝ, B.m1 ≤ X → X ≤ B.m2 → cE ≤ edgeWeight B.Xa B.Xb B.aa B.ab X := by
    intro X h1 h2
    have hX0 : 0 < X := by linarith
    unfold edgeWeight
    rw [if_pos ⟨by linarith, by linarith⟩, hcEdef]
    apply Real.exp_le_exp.mpr
    have e1 : Real.log (B.m1 / B.Xa) ≤ Real.log (X / B.Xa) :=
      Real.log_le_log (div_pos (by linarith) hXa) (div_le_div_of_nonneg_right h1 hXa.le)
    have e2 : Real.log (B.Xb / B.m2) ≤ Real.log (B.Xb / X) :=
      Real.log_le_log (div_pos (by linarith) hm2pos) (div_le_div_of_nonneg_left (by linarith) hX0 h2)
    have f1 : B.aa / Real.log (X / B.Xa) ^ 2 ≤ B.aa / Real.log (B.m1 / B.Xa) ^ 2 :=
      div_le_div_of_nonneg_left haa.le (pow_pos hs1 2) (pow_le_pow_left₀ hs1.le e1 2)
    have f2 : B.ab / Real.log (B.Xb / X) ^ 2 ≤ B.ab / Real.log (B.Xb / B.m2) ^ 2 :=
      div_le_div_of_nonneg_left hab.le (pow_pos hl2 2) (pow_le_pow_left₀ hl2.le e2 2)
    linarith

  obtain ⟨Pm, hPmdef⟩ : ∃ Pm : Cyl →L[ℝ] ℝ × ℝ,
      Pm = ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
        (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))).prod
        ((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ)))))) := ⟨_, rfl⟩
  have hPapp : ∀ η : Cyl, Pm η = (η.2.1, η.2.2.1) := by
    intro η; rw [hPmdef]; simp
  have hP1 : ‖Pm‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
    rw [hPapp η, one_mul, Prod.norm_def (η.2.1, η.2.2.1)]
    refine max_le ?_ ?_
    · exact (norm_fst_le η.2).trans (norm_snd_le η)
    · exact ((norm_fst_le η.2.2).trans (norm_snd_le η.2)).trans (norm_snd_le η)
  have hO : IsOpen {w : ℝ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  have hg : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 (1 - w.2)) {w : ℝ × ℝ | w.2 < 1} := by
    have hφ : ContDiff ℝ ∞ (fun w : ℝ × ℝ => ((w.1, 1 - w.2) : ℝ × ℝ)) := by fun_prop
    have hS : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1
    exact (hS.comp hφ.contDiffOn (fun w (hw : w.2 < 1) =>
      ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by linarith⟩)).continuousOn
  have hU : IsOpen {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} := by
    have := hg.isOpen_inter_preimage hO (isOpen_Iio (a := qs))
    exact this
  have hV : IsOpen (⇑Pm ⁻¹' {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs}) :=
    hU.preimage Pm.continuous
  have hDV : ∀ ξ ∈ DomC B.h qs,
      ξ ∈ ⇑Pm ⁻¹' {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} := by
    intro ξ hξ
    rw [Set.mem_preimage, hPapp]
    exact ⟨hξ.2.1, hξ.2.2⟩
  have hDomOpen : IsOpen (DomC B.h qs) := by
    have e : DomC B.h qs = {ξ : Cyl | 0 < ξ.1} ∩
        ⇑Pm ⁻¹' {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} := by
      ext ξ
      constructor
      · intro hξ
        exact ⟨hξ.1, hDV ξ hξ⟩
      · rintro ⟨h1, h2⟩
        rw [Set.mem_preimage, hPapp] at h2
        exact ⟨h1, h2.1, h2.2⟩
    rw [e]
    exact (isOpen_lt continuous_const continuous_fst).inter hV
  have lift : ∀ Q : ℝ × ℝ → ℝ, InS B qs α Q →
      ContDiffOn ℝ ∞ (fun η : Cyl => Q (η.2.1, η.2.2.1)) (DomC B.h qs) ∧
      ∀ k : ℕ, ∃ C b : ℝ, ∀ ξ ∈ DomC B.h qs,
        NB B.h (fun η : Cyl => Q (η.2.1, η.2.2.1)) k ξ ≤ C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b := by
    intro Q hQ
    obtain ⟨hQs, hQb⟩ := hQ
    have hfun : (fun η : Cyl => Q (η.2.1, η.2.2.1)) = Q ∘ Pm := by
      funext η; simp only [Function.comp, hPapp]
    refine ⟨?_, ?_⟩
    · rw [hfun]
      exact hQs.comp Pm.contDiff.contDiffOn (fun ξ hξ => hDV ξ hξ)
    · intro k
      obtain ⟨C, b, hC⟩ := hQb k
      refine ⟨C, b, fun ξ hξ => ?_⟩
      have hξV := hDV ξ hξ
      have hw : Pm ξ ∈ {w : ℝ × ℝ | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} := hξV
      have hchain : iteratedFDeriv ℝ k (Q ∘ Pm) ξ =
          (iteratedFDeriv ℝ k Q (Pm ξ)).compContinuousLinearMap (fun _ => Pm) := by
        have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right Pm hQs hU.uniqueDiffOn
          hV.uniqueDiffOn hw (i := k) (by exact_mod_cast le_top)
        rw [iteratedFDerivWithin_of_isOpen k hV hξV, iteratedFDerivWithin_of_isOpen k hU hw] at e2
        exact e2
      obtain ⟨Mq, hMqdef⟩ : ∃ Mq : ℝ × ℝ →L[ℝ] ℝ × ℝ,
          Mq = (qC B.h ξ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
            (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ) := ⟨_, rfl⟩
      have hPL : ∀ v : Cyl, Pm (Lnorm B.h ξ v) = Mq (Pm v) := by
        intro v
        rw [hPapp, hPapp, hMqdef]
        simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have hcomp : ((iteratedFDeriv ℝ k Q (Pm ξ)).compContinuousLinearMap (fun _ => Pm)).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) =
          ((iteratedFDeriv ℝ k Q (Pm ξ)).compContinuousLinearMap (fun _ => Mq)).compContinuousLinearMap
            (fun _ => Pm) := by
        ext m
        simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply, hPL]
      have hNB : NB B.h (fun η : Cyl => Q (η.2.1, η.2.2.1)) k ξ =
          ‖((iteratedFDeriv ℝ k Q (Pm ξ)).compContinuousLinearMap (fun _ => Mq)).compContinuousLinearMap
            (fun _ => Pm)‖ := by
        unfold NB
        rw [hfun, hchain, hcomp]
      have hprod : ∏ _i : Fin k, ‖Pm‖ ≤ 1 := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        exact pow_le_one₀ (norm_nonneg _) hP1
      have hb1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
        ((iteratedFDeriv ℝ k Q (Pm ξ)).compContinuousLinearMap (fun _ => Mq)) (fun _ : Fin k => Pm)
      have hCw : ‖(iteratedFDeriv ℝ k Q (Pm ξ)).compContinuousLinearMap (fun _ => Mq)‖ ≤
          C * qC B.h ξ ^ (B.h * α) * (1 + |Real.log (qC B.h ξ)|) ^ (2 * b) := by
        rw [hPapp, hMqdef]
        exact hC (ξ.2.1, ξ.2.2.1) hξ.2.1 hξ.2.2
      have hSC : SC B.h ξ ^ b = (1 + |Real.log (qC B.h ξ)|) ^ (2 * b) := by
        unfold SC
        rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
        norm_num
      rw [hNB, hSC]
      exact hb1.trans ((mul_le_of_le_one_right (norm_nonneg _) hprod).trans hCw)
  obtain ⟨hF0s, hF0b⟩ := lift _ hF

  have hP : InM B qs α (fun ξ => rhoHat B (Real.sqrt (2 * XC B.h ξ)) *
      nrmS B (2 * Aex B.h) F (ξ.2.1, ξ.2.2.1)) := by
    refine xc_profile_mul_class_v4 B qs α (fun X => rhoHat B (Real.sqrt (2 * X))) (Set.Icc B.m1 B.m2)
      (fun η : Cyl => nrmS B (2 * Aex B.h) F (η.2.1, η.2.2.1)) hok hSN hqs0 hqs1 hψs isClosed_Icc hψ0
      hF0s (fun _ _ _ _ => rfl) ?_ ?_
    · intro ξ _ h
      have hn : XC B.h ξ ∉ Set.Icc B.m1 B.m2 := by
        rintro ⟨h1, h2⟩
        rcases h with h | h <;> linarith
      show rhoHat B (Real.sqrt (2 * XC B.h ξ)) * _ = 0
      rw [hψ0 _ hn, zero_mul]
    · intro k
      obtain ⟨C₀, b₀, hb⟩ := hF0b k
      refine ⟨|C₀| / cE, b₀, 0, fun ξ hξ _ _ hS => ?_⟩
      have hPn : 0 ≤ qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b₀ :=
        mul_nonneg (Real.rpow_nonneg (hpos ξ hξ).le _) (Real.rpow_nonneg (by unfold SC; positivity) _)
      have hE := hEW _ hS.1 hS.2
      have hE1 : 1 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) / cE := (one_le_div hcE).mpr hE
      rw [neg_zero, Real.rpow_zero, mul_one]
      calc NB B.h (fun η : Cyl => nrmS B (2 * Aex B.h) F (η.2.1, η.2.2.1)) k ξ
          ≤ C₀ * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b₀ := hb ξ hξ
        _ ≤ |C₀| * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b₀) := by
            rw [mul_assoc]; exact mul_le_mul_of_nonneg_right (le_abs_self _) hPn
        _ ≤ |C₀| * (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b₀) *
              (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) / cE) :=
            le_mul_of_one_le_right (mul_nonneg (abs_nonneg _) hPn) hE1
        _ = |C₀| / cE * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b₀ *
              edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
            rw [div_eq_mul_inv, div_eq_mul_inv]; ring

  have hcongr : ∀ f g : Cyl → ℝ, InM B qs α f → (∀ ξ ∈ DomC B.h qs, g ξ = f ξ) → InM B qs α g := by
    intro f g hf heq
    obtain ⟨c1, c2, c3, c4⟩ := hf
    refine ⟨c1.congr heq, ?_, ?_, ?_⟩
    · intro ξ hξ a ha
      have hξ' : shY ξ a ∈ DomC B.h qs := hξ
      rw [heq _ hξ', heq _ hξ, c2 ξ hξ a ha]
    · intro ξ hξ h
      rw [heq _ hξ]
      exact c3 ξ hξ h
    · intro k
      obtain ⟨C, b, d, hC⟩ := c4 k
      refine ⟨C, b, d, fun ξ hξ h1 h2 => ?_⟩
      have hev : g =ᶠ[nhds ξ] f := Filter.eventuallyEq_of_mem (hDomOpen.mem_nhds hξ) heq
      have hNBe : NB B.h g k ξ = NB B.h f k ξ := by
        unfold NB
        rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      rw [hNBe]
      exact hC ξ hξ h1 h2
  refine hcongr _ _ hP ?_
  intro ξ hξ
  have hq := hpos ξ hξ
  have hξ1 : 0 < ξ.1 := hξ.1
  have hσ : 0 < Real.sqrt (qC B.h ξ) := Real.sqrt_pos.mpr hq
  have hs0 : 0 < ξ.1 / Real.sqrt (qC B.h ξ) := div_pos hξ1 hσ
  have hsq2 : (ξ.1 / Real.sqrt (qC B.h ξ)) ^ 2 = 2 * XC B.h ξ := by
    rw [div_pow, Real.sq_sqrt hq.le]
    unfold XC
    field_simp
  have hrt : Real.sqrt (2 * XC B.h ξ) = ξ.1 / Real.sqrt (qC B.h ξ) := by
    rw [← hsq2, Real.sqrt_sq hs0.le]
  have hpow : qC B.h ξ ^ (2 * Aex B.h + 1/2) * qC B.h ξ ^ (-(1/2:ℝ)) = qC B.h ξ ^ (2 * Aex B.h) := by
    rw [← Real.rpow_add hq]
    congr 1
    ring
  show qC B.h ξ ^ (2 * Aex B.h + 1/2) *
      (qC B.h ξ ^ (-(1/2:ℝ)) * rhoHat B (ξ.1 / Real.sqrt (qC B.h ξ)) * F ξ.2.1 ξ.2.2.1) =
    rhoHat B (Real.sqrt (2 * XC B.h ξ)) * (simScale B.h ξ.2.1 (1 - ξ.2.2.1) ^ (2 * Aex B.h) * F ξ.2.1 ξ.2.2.1)
  have hqd : simScale B.h ξ.2.1 (1 - ξ.2.2.1) = qC B.h ξ := rfl
  rw [hqd, hrt, ← hpow]
  ring

theorem edge_compare_v4 : ∀ (Xa Xb m1 m2 aa ab D : ℝ), 0 < Xa → Xa < m1 → m1 ≤ m2 → m2 < Xb → 0 < aa → 0 < ab →
    ∃ K c : ℝ, 0 < c ∧
    (∀ X' X : ℝ, Xa < X' → X' ≤ X → X ≤ m2 →
      edgeWeight Xa Xb aa ab X' * edgeDist Xa Xb X' ^ (-D) ≤ K * (edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-D))) ∧
    (∀ X X' : ℝ, m1 ≤ X → X ≤ X' → X' < Xb →
      edgeWeight Xa Xb aa ab X' * edgeDist Xa Xb X' ^ (-D) ≤ K * (edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-D))) ∧
    (∀ X : ℝ, m1 ≤ X → X ≤ m2 → c ≤ edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-D)) :=
by
  intro Xa Xb m1 m2 aa ab D hXa hXam1 hm12 hm2Xb haa hab

  have s1 : ∀ (D p p' q q' q0 : ℝ), 0 < p' → p' ≤ p → 0 < q0 → q0 ≤ q → q0 ≤ q' →
      D * (Real.log (min 1 (min p q)) - Real.log (min 1 (min p' q'))) ≤
        |D| * (Real.log (p / p') - Real.log (min 1 q0)) := by
    intro D p p' q q' q0 hp' hpp hq0 hq hq'
    have hp : 0 < p := lt_of_lt_of_le hp' hpp
    obtain ⟨σ, hσ⟩ : ∃ x : ℝ, x = min 1 q0 := ⟨_, rfl⟩
    obtain ⟨δ, hδ⟩ : ∃ x : ℝ, x = min 1 (min p q) := ⟨_, rfl⟩
    obtain ⟨δ', hδ'⟩ : ∃ x : ℝ, x = min 1 (min p' q') := ⟨_, rfl⟩
    rw [← hσ, ← hδ, ← hδ']
    have hσ0 : 0 < σ := by rw [hσ]; exact lt_min one_pos hq0
    have hσ1 : σ ≤ 1 := by rw [hσ]; exact min_le_left _ _
    have hσq0 : σ ≤ q0 := by rw [hσ]; exact min_le_right _ _
    have hδ0 : 0 < δ := by rw [hδ]; exact lt_min one_pos (lt_min hp (lt_of_lt_of_le hq0 hq))
    have hδ'0 : 0 < δ' := by rw [hδ']; exact lt_min one_pos (lt_min hp' (lt_of_lt_of_le hq0 hq'))
    have hδ1 : δ ≤ 1 := by rw [hδ]; exact min_le_left _ _
    have hδp : δ ≤ p := by rw [hδ]; exact (min_le_right _ _).trans (min_le_left _ _)
    have hδ'1 : δ' ≤ 1 := by rw [hδ']; exact min_le_left _ _
    have hδ'p : δ' ≤ p' := by rw [hδ']; exact (min_le_right _ _).trans (min_le_left _ _)

    have hσδ1 : σ * δ ≤ 1 := by nlinarith
    have hσδp : σ * δ ≤ p := by nlinarith
    have hp'δ : p' * δ ≤ p := by nlinarith
    have e1 : σ * p' * δ ≤ p * 1 := by nlinarith [mul_le_mul_of_nonneg_left hσδ1 hp'.le]
    have e2 : σ * p' * δ ≤ p * p' := by nlinarith [mul_le_mul_of_nonneg_left hσδp hp'.le]
    have e3 : σ * p' * δ ≤ p * q' := by
      have := mul_le_mul (hσq0.trans hq') hp'δ (by positivity) (by linarith)
      nlinarith
    have hA : σ * p' * δ ≤ p * δ' := by
      rcases min_choice 1 (min p' q') with h | h
      · rw [hδ', h]; exact e1
      · rw [hδ', h]
        rcases min_choice p' q' with h' | h'
        · rw [h']; exact e2
        · rw [h']; exact e3

    have hB : σ * δ' ≤ δ := by
      rw [hδ]
      refine le_min (by nlinarith) (le_min (by nlinarith) ?_)
      have : σ * δ' ≤ σ := by nlinarith
      linarith
    have lA := Real.log_le_log (by positivity) hA
    have lB := Real.log_le_log (by positivity) hB
    rw [Real.log_mul (by positivity) hδ0.ne', Real.log_mul hσ0.ne' hp'.ne',
      Real.log_mul hp.ne' hδ'0.ne'] at lA
    rw [Real.log_mul hσ0.ne' hδ'0.ne'] at lB
    have hpp' : Real.log p' ≤ Real.log p := Real.log_le_log hp' hpp
    have hlσ : Real.log σ ≤ 0 := Real.log_nonpos hσ0.le hσ1
    rw [Real.log_div hp.ne' hp'.ne']
    rcases le_total 0 D with hD | hD
    · rw [abs_of_nonneg hD]
      exact mul_le_mul_of_nonneg_left (by linarith) hD
    · rw [abs_of_nonpos hD]
      have := mul_le_mul_of_nonneg_left
        (show -(Real.log δ - Real.log δ') ≤ Real.log p - Real.log p' - Real.log σ by linarith)
        (neg_nonneg.mpr hD)
      linarith

  have s2 : ∀ (a A S s s' : ℝ), 0 < a → 0 ≤ A → 0 < s' → s' ≤ s → s ≤ S →
      a / s ^ 2 - a / s' ^ 2 + A * Real.log (s / s') ≤ A ^ 2 * S ^ 2 / (4 * a) := by
    intro a A S s s' ha hA hs' hss hsS
    have hs : 0 < s := lt_of_lt_of_le hs' hss
    have hS : 0 < S := lt_of_lt_of_le hs hsS
    obtain ⟨u, hu⟩ : ∃ x : ℝ, x = s / s' := ⟨_, rfl⟩
    obtain ⟨γ, hγ⟩ : ∃ x : ℝ, x = a / s ^ 2 := ⟨_, rfl⟩
    obtain ⟨β, hβ⟩ : ∃ x : ℝ, x = a / S ^ 2 := ⟨_, rfl⟩
    have hu1 : 1 ≤ u := by rw [hu]; exact (one_le_div hs').mpr hss
    have hlog : Real.log u ≤ u - 1 := Real.log_le_sub_one_of_pos (by linarith)
    have hβ0 : 0 < β := by rw [hβ]; positivity
    have hβγ : β ≤ γ := by
      rw [hβ, hγ]
      exact div_le_div_of_nonneg_left ha.le (by positivity) (pow_le_pow_left₀ hs.le hsS 2)
    have hs'u : a / s' ^ 2 = γ * u ^ 2 := by rw [hγ, hu]; field_simp
    have key1 : A * Real.log u ≤ A * (u - 1) := mul_le_mul_of_nonneg_left hlog hA
    have key2 : β * (u - 1) ^ 2 ≤ γ * u ^ 2 - γ := by
      nlinarith [mul_nonneg (sub_nonneg.mpr hβγ) (sq_nonneg (u - 1)),
        mul_nonneg (hβ0.le.trans hβγ) (sub_nonneg.mpr hu1)]
    have key3 : A * (u - 1) - β * (u - 1) ^ 2 ≤ A ^ 2 / (4 * β) := by
      rw [le_div_iff₀ (by positivity)]
      nlinarith [sq_nonneg (A - 2 * β * (u - 1))]
    have e : A ^ 2 / (4 * β) = A ^ 2 * S ^ 2 / (4 * a) := by
      rw [hβ]; field_simp
    rw [hs'u, ← hu, ← hγ, ← e]
    linarith

  have s3 : ∀ X, Xa < X → X < Xb → 0 < Real.log (X / Xa) ∧ 0 < Real.log (Xb / X) ∧
      edgeWeight Xa Xb aa ab X * edgeDist Xa Xb X ^ (-D) =
        Real.exp (-(aa / Real.log (X / Xa) ^ 2) - ab / Real.log (Xb / X) ^ 2 -
          D * Real.log (min 1 (min (Real.log (X / Xa)) (Real.log (Xb / X))))) := by
    intro X h1 h2
    have hX0 : 0 < X := hXa.trans h1
    have hs := Real.log_pos ((one_lt_div hXa).mpr h1)
    have hl := Real.log_pos ((one_lt_div hX0).mpr h2)
    have hd : 0 < edgeDist Xa Xb X := lt_min one_pos (lt_min hs hl)
    refine ⟨hs, hl, ?_⟩
    rw [edgeWeight, if_pos ⟨h1, h2⟩, Real.rpow_def_of_pos hd, ← Real.exp_add]
    congr 1
    unfold edgeDist
    ring

  have hm1 : 0 < m1 := hXa.trans hXam1
  have hm2 : 0 < m2 := hm1.trans_le hm12
  have hXb0 : 0 < Xb := hm2.trans hm2Xb
  obtain ⟨l2, hl2d⟩ : ∃ x : ℝ, x = Real.log (Xb / m2) := ⟨_, rfl⟩
  obtain ⟨S2, hS2d⟩ : ∃ x : ℝ, x = Real.log (m2 / Xa) := ⟨_, rfl⟩
  obtain ⟨s1v, hs1d⟩ : ∃ x : ℝ, x = Real.log (m1 / Xa) := ⟨_, rfl⟩
  obtain ⟨L1, hL1d⟩ : ∃ x : ℝ, x = Real.log (Xb / m1) := ⟨_, rfl⟩
  have hl2 : 0 < l2 := by rw [hl2d]; exact Real.log_pos ((one_lt_div hm2).mpr hm2Xb)
  have hs1 : 0 < s1v := by rw [hs1d]; exact Real.log_pos ((one_lt_div hXa).mpr hXam1)
  obtain ⟨k1, hk1⟩ : ∃ x : ℝ, x = ab / l2 ^ 2 + |D| * (-Real.log (min 1 l2)) + |D| ^ 2 * S2 ^ 2 / (4 * aa) :=
    ⟨_, rfl⟩
  obtain ⟨k2, hk2⟩ : ∃ x : ℝ, x = aa / s1v ^ 2 + |D| * (-Real.log (min 1 s1v)) + |D| ^ 2 * L1 ^ 2 / (4 * ab) :=
    ⟨_, rfl⟩
  obtain ⟨k3, hk3⟩ : ∃ x : ℝ, x = aa / s1v ^ 2 + ab / l2 ^ 2 + |D| * (-Real.log (min 1 (min s1v l2))) :=
    ⟨_, rfl⟩
  refine ⟨Real.exp (max k1 k2), Real.exp (-k3), Real.exp_pos _, ?_, ?_, ?_⟩
  ·
    intro X' X h1 h2 h3
    have hX : Xa < X := h1.trans_le h2
    have hXb : X < Xb := h3.trans_lt hm2Xb
    have hX'b : X' < Xb := h2.trans_lt hXb
    have hX'0 : 0 < X' := hXa.trans h1
    have hX0 : 0 < X := hXa.trans hX
    obtain ⟨hs', hl', e'⟩ := s3 X' h1 hX'b
    obtain ⟨hs, hl, e⟩ := s3 X hX hXb
    rw [e, e', ← Real.exp_add]
    apply Real.exp_le_exp.mpr
    have hss : Real.log (X' / Xa) ≤ Real.log (X / Xa) :=
      Real.log_le_log (div_pos hX'0 hXa) (div_le_div_of_nonneg_right h2 hXa.le)
    have hsS : Real.log (X / Xa) ≤ S2 := by
      rw [hS2d]; exact Real.log_le_log (div_pos hX0 hXa) (div_le_div_of_nonneg_right h3 hXa.le)
    have hll : Real.log (Xb / X) ≤ Real.log (Xb / X') :=
      Real.log_le_log (div_pos hXb0 hX0) (div_le_div_of_nonneg_left hXb0.le hX'0 h2)
    have hlb : l2 ≤ Real.log (Xb / X) := by
      rw [hl2d]; exact Real.log_le_log (div_pos hXb0 hm2) (div_le_div_of_nonneg_left hXb0.le hX0 h3)
    have ha := s1 D _ _ _ _ l2 hs' hss hl2 hlb (hlb.trans hll)
    have hb := s2 aa |D| S2 _ _ haa (abs_nonneg D) hs' hss hsS
    have hc1 : 0 ≤ ab / Real.log (Xb / X') ^ 2 := by positivity
    have hc2 : ab / Real.log (Xb / X) ^ 2 ≤ ab / l2 ^ 2 :=
      div_le_div_of_nonneg_left hab.le (by positivity) (pow_le_pow_left₀ hl2.le hlb 2)
    have hm := le_max_left k1 k2
    linarith
  ·
    intro X X' h1 h2 h3
    have hX : Xa < X := hXam1.trans_le h1
    have hX' : Xa < X' := hX.trans_le h2
    have hXb : X < Xb := h2.trans_lt h3
    have hX'0 : 0 < X' := hXa.trans hX'
    have hX0 : 0 < X := hXa.trans hX
    obtain ⟨hs', hl', e'⟩ := s3 X' hX' h3
    obtain ⟨hs, hl, e⟩ := s3 X hX hXb
    rw [e, e', ← Real.exp_add]
    apply Real.exp_le_exp.mpr
    have hss : Real.log (X / Xa) ≤ Real.log (X' / Xa) :=
      Real.log_le_log (div_pos hX0 hXa) (div_le_div_of_nonneg_right h2 hXa.le)
    have hsb : s1v ≤ Real.log (X / Xa) := by
      rw [hs1d]; exact Real.log_le_log (div_pos hm1 hXa) (div_le_div_of_nonneg_right h1 hXa.le)
    have hll : Real.log (Xb / X') ≤ Real.log (Xb / X) :=
      Real.log_le_log (div_pos hXb0 hX'0) (div_le_div_of_nonneg_left hXb0.le hX0 h2)
    have hlL : Real.log (Xb / X) ≤ L1 := by
      rw [hL1d]; exact Real.log_le_log (div_pos hXb0 hX0) (div_le_div_of_nonneg_left hXb0.le hm1 h1)
    have ha := s1 D _ _ _ _ s1v hl' hll hs1 hsb (hsb.trans hss)
    rw [min_comm (Real.log (Xb / X)) (Real.log (X / Xa)),
      min_comm (Real.log (Xb / X')) (Real.log (X' / Xa))] at ha
    have hb := s2 ab |D| L1 _ _ hab (abs_nonneg D) hl' hll hlL
    have hc1 : 0 ≤ aa / Real.log (X' / Xa) ^ 2 := by positivity
    have hc2 : aa / Real.log (X / Xa) ^ 2 ≤ aa / s1v ^ 2 :=
      div_le_div_of_nonneg_left haa.le (by positivity) (pow_le_pow_left₀ hs1.le hsb 2)
    have hm := le_max_right k1 k2
    linarith
  ·
    intro X h1 h2
    have hX : Xa < X := hXam1.trans_le h1
    have hXb : X < Xb := h2.trans_lt hm2Xb
    have hX0 : 0 < X := hXa.trans hX
    obtain ⟨hs, hl, e⟩ := s3 X hX hXb
    rw [e]
    apply Real.exp_le_exp.mpr
    have hsb : s1v ≤ Real.log (X / Xa) := by
      rw [hs1d]; exact Real.log_le_log (div_pos hm1 hXa) (div_le_div_of_nonneg_right h1 hXa.le)
    have hlb : l2 ≤ Real.log (Xb / X) := by
      rw [hl2d]; exact Real.log_le_log (div_pos hXb0 hm2) (div_le_div_of_nonneg_left hXb0.le hX0 h2)
    have hρ0 : 0 < min 1 (min s1v l2) := lt_min one_pos (lt_min hs1 hl2)
    have hρ1 : min 1 (min s1v l2) ≤ 1 := min_le_left _ _
    have hρδ : min 1 (min s1v l2) ≤ min 1 (min (Real.log (X / Xa)) (Real.log (Xb / X))) :=
      min_le_min le_rfl (min_le_min hsb hlb)
    have hδ1 : min 1 (min (Real.log (X / Xa)) (Real.log (Xb / X))) ≤ 1 := min_le_left _ _
    have lρδ := Real.log_le_log hρ0 hρδ
    have lδ := Real.log_nonpos (hρ0.trans_le hρδ).le hδ1
    have lρ := Real.log_nonpos hρ0.le hρ1
    have hD : D * Real.log (min 1 (min (Real.log (X / Xa)) (Real.log (Xb / X)))) ≤
        |D| * (-Real.log (min 1 (min s1v l2))) := by
      rcases le_total 0 D with hD | hD
      · rw [abs_of_nonneg hD]
        exact mul_le_mul_of_nonneg_left (by linarith) hD
      · rw [abs_of_nonpos hD]
        have := mul_le_mul_of_nonpos_left lρδ hD
        linarith
    have hc1 : aa / Real.log (X / Xa) ^ 2 ≤ aa / s1v ^ 2 :=
      div_le_div_of_nonneg_left haa.le (by positivity) (pow_le_pow_left₀ hs1.le hsb 2)
    have hc2 : ab / Real.log (Xb / X) ^ 2 ≤ ab / l2 ^ 2 :=
      div_le_div_of_nonneg_left hab.le (by positivity) (pow_le_pow_left₀ hl2.le hlb 2)
    linarith

theorem path_cov_v4 : ∀ (d : ℝ), 0 < d → ∀ (r : ℝ) (ψ : ℝ → ℝ), 0 < r → ContinuousOn ψ (Set.Ioi 0) →
     ((∃ ε : ℝ, 0 < ε ∧ ∀ x : ℝ, 0 < x → x < ε → ψ x = 0) → ∀ a : ℝ, a ≤ -(r ^ d) →
       MeasureTheory.IntegrableOn (fun u : ℝ => if 0 < r ^ d + u then (1 / d) * (r ^ d + u) ^ (1 / d - 1) * ψ ((r ^ d + u) ^ (1 / d)) else 0) (Set.Icc a 0) ∧
       ∫ u in Set.Icc a 0, (if 0 < r ^ d + u then (1 / d) * (r ^ d + u) ^ (1 / d - 1) * ψ ((r ^ d + u) ^ (1 / d)) else 0) = ∫ x in (0:ℝ)..r, ψ x) ∧
     (∀ b : ℝ, 0 ≤ b → (∀ x : ℝ, 0 < x → r ^ d + b ≤ x ^ d → ψ x = 0) →
       MeasureTheory.IntegrableOn (fun u : ℝ => if 0 < r ^ d + u then (1 / d) * (r ^ d + u) ^ (1 / d - 1) * ψ ((r ^ d + u) ^ (1 / d)) else 0) (Set.Icc 0 b) ∧
       ∫ u in Set.Icc 0 b, (if 0 < r ^ d + u then (1 / d) * (r ^ d + u) ^ (1 / d - 1) * ψ ((r ^ d + u) ^ (1 / d)) else 0) = ∫ x in Set.Ioi r, ψ x) :=
by
  intro d hd r ψ hr hψ
  have hc : 0 < r ^ d := Real.rpow_pos_of_pos hr d
  have hd0 : d ≠ 0 := hd.ne'
  have hid : 0 < 1 / d := one_div_pos.mpr hd
  have F2 : ∀ x : ℝ, 0 ≤ x → (x ^ d) ^ (1 / d) = x := by
    intro x hx
    rw [one_div]
    exact Real.rpow_rpow_inv hx hd0
  have F2c : (r ^ d) ^ (1 / d) = r := F2 r hr.le
  set g : ℝ → ℝ := fun u => if 0 < r ^ d + u then (1 / d) * (r ^ d + u) ^ (1 / d - 1) *
    ψ ((r ^ d + u) ^ (1 / d)) else 0 with hg
  have core : ∀ p q : ℝ, p ≤ q → 0 < r ^ d + p →
      MeasureTheory.IntegrableOn g (Set.Icc p q) ∧
      ∫ u in Set.Icc p q, g u = ∫ x in ((r ^ d + p) ^ (1 / d))..((r ^ d + q) ^ (1 / d)), ψ x := by
    intro p q hpq hcp
    have hpos : ∀ u ∈ Set.Icc p q, 0 < r ^ d + u := fun u hu => by linarith [hu.1]
    have hκ : ContinuousOn (fun u : ℝ => (1 / d) * (r ^ d + u) ^ (1 / d - 1)) (Set.Icc p q) :=
      continuousOn_const.mul ((continuousOn_const.add continuousOn_id).rpow_const
        (fun u hu => Or.inl (hpos u hu).ne'))
    have hρ : ContinuousOn (fun u : ℝ => (r ^ d + u) ^ (1 / d)) (Set.Icc p q) :=
      (continuousOn_const.add continuousOn_id).rpow_const (fun u hu => Or.inl (hpos u hu).ne')
    have hmaps : Set.MapsTo (fun u : ℝ => (r ^ d + u) ^ (1 / d)) (Set.Icc p q) (Set.Ioi 0) :=
      fun u hu => Real.rpow_pos_of_pos (hpos u hu) _
    have hψρ : ContinuousOn (fun u : ℝ => ψ ((r ^ d + u) ^ (1 / d))) (Set.Icc p q) :=
      hψ.comp hρ hmaps
    have heq : Set.EqOn g (fun u => (1 / d) * (r ^ d + u) ^ (1 / d - 1) * ψ ((r ^ d + u) ^ (1 / d)))
        (Set.Icc p q) := by
      intro u hu
      simp only [hg, if_pos (hpos u hu)]
    have hcont : ContinuousOn g (Set.Icc p q) := (hκ.mul hψρ).congr heq
    refine ⟨hcont.integrableOn_Icc, ?_⟩
    rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hpq]
    have hderiv : ∀ u ∈ Set.uIcc p q, HasDerivAt (fun y : ℝ => (r ^ d + y) ^ (1 / d))
        ((fun u : ℝ => (1 / d) * (r ^ d + u) ^ (1 / d - 1)) u) u := by
      intro u hu
      rw [Set.uIcc_of_le hpq] at hu
      have := ((hasDerivAt_id' u).const_add (r ^ d)).rpow_const (p := 1 / d)
        (Or.inl (hpos u hu).ne')
      convert this using 1
      ring
    have hcongr : ∫ u in p..q, g u = ∫ u in p..q,
        (ψ ∘ fun y : ℝ => (r ^ d + y) ^ (1 / d)) u * ((fun u : ℝ => (1 / d) * (r ^ d + u) ^ (1 / d - 1)) u) := by
      apply intervalIntegral.integral_congr
      intro u hu
      rw [Set.uIcc_of_le hpq] at hu
      simp only [hg, Function.comp_apply, if_pos (hpos u hu)]
      ring
    rw [hcongr]
    exact intervalIntegral.integral_comp_mul_deriv' (f := fun y : ℝ => (r ^ d + y) ^ (1 / d))
      (f' := fun u : ℝ => (1 / d) * (r ^ d + u) ^ (1 / d - 1)) (g := ψ) hderiv
      (by rw [Set.uIcc_of_le hpq]; exact hκ)
      (hψ.mono (by
        rintro _ ⟨u, hu, rfl⟩
        rw [Set.uIcc_of_le hpq] at hu
        exact hmaps hu))
  refine ⟨?_, ?_⟩
  · rintro ⟨ε, hε, hψε⟩ a ha
    show MeasureTheory.IntegrableOn g (Set.Icc a 0) ∧ ∫ u in Set.Icc a 0, g u = ∫ x in (0:ℝ)..r, ψ x
    obtain ⟨ε', hε'⟩ : ∃ ε' : ℝ, ε' = min ε r / 2 := ⟨_, rfl⟩
    have hm : 0 < min ε r := lt_min hε hr
    have hm1 := min_le_left ε r
    have hm2 := min_le_right ε r
    have hε'0 : 0 < ε' := by rw [hε']; linarith
    have hε'ε : ε' < ε := by rw [hε']; linarith
    have hε'r : ε' < r := by rw [hε']; linarith
    have hε'd : 0 < ε' ^ d := Real.rpow_pos_of_pos hε'0 d
    have hε'dc : ε' ^ d < r ^ d := Real.rpow_lt_rpow hε'0.le hε'r hd
    obtain ⟨p, hp⟩ : ∃ p : ℝ, p = ε' ^ d - r ^ d := ⟨_, rfl⟩
    have hcp : r ^ d + p = ε' ^ d := by rw [hp]; ring
    have hap : a ≤ p := by linarith
    have hp0 : p ≤ 0 := by linarith
    obtain ⟨hI, hE⟩ := core p 0 hp0 (by rw [hcp]; exact hε'd)
    rw [hcp, add_zero, F2 ε' hε'0.le, F2c] at hE
    have hZ : ∀ u ∈ Set.Icc a 0 \ Set.Icc p 0, g u = 0 := by
      rintro u ⟨⟨hau, hu0⟩, hnot⟩
      have hup : u < p := by
        by_contra h
        exact hnot ⟨not_lt.mp h, hu0⟩
      simp only [hg]
      split_ifs with hcu
      · have hlt : r ^ d + u < ε' ^ d := by linarith
        have h1 : (r ^ d + u) ^ (1 / d) < ε' := by
          have := Real.rpow_lt_rpow hcu.le hlt hid
          rwa [F2 ε' hε'0.le] at this
        have h2 : 0 < (r ^ d + u) ^ (1 / d) := Real.rpow_pos_of_pos hcu _
        rw [hψε _ h2 (by linarith), mul_zero]
      · rfl
    have hsub : Set.Icc p 0 ⊆ Set.Icc a 0 := Set.Icc_subset_Icc hap le_rfl
    refine ⟨hI.of_forall_diff_eq_zero measurableSet_Icc hZ, ?_⟩
    rw [MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero measurableSet_Icc hsub hZ, hE]
    rw [intervalIntegral.integral_of_le hε'r.le, intervalIntegral.integral_of_le hr.le]
    symm
    apply MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero measurableSet_Ioc
      (Set.Ioc_subset_Ioc_left hε'0.le)
    rintro x ⟨⟨hx0, hxr⟩, hnot⟩
    have hxe : x ≤ ε' := by
      by_contra h
      exact hnot ⟨not_le.mp h, hxr⟩
    exact hψε x hx0 (by linarith)
  · intro b hb hvan
    show MeasureTheory.IntegrableOn g (Set.Icc 0 b) ∧ ∫ u in Set.Icc 0 b, g u = ∫ x in Set.Ioi r, ψ x
    obtain ⟨hI, hE⟩ := core 0 b hb (by rw [add_zero]; exact hc)
    refine ⟨hI, ?_⟩
    rw [add_zero, F2c] at hE
    obtain ⟨R, hR⟩ : ∃ R : ℝ, R = (r ^ d + b) ^ (1 / d) := ⟨_, rfl⟩
    rw [← hR] at hE
    have hrR : r ≤ R := by
      have := Real.rpow_le_rpow hc.le (show r ^ d ≤ r ^ d + b by linarith) hid.le
      rw [F2c, ← hR] at this
      exact this
    have hR0 : 0 < R := lt_of_lt_of_le hr hrR
    have hRd : R ^ d = r ^ d + b := by
      rw [hR, one_div]
      exact Real.rpow_inv_rpow (by linarith) hd0
    rw [hE, intervalIntegral.integral_of_le hrR]
    symm
    apply MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero measurableSet_Ioi
      Set.Ioc_subset_Ioi_self
    rintro x ⟨hxr, hnot⟩
    have hxR : R < x := by
      by_contra h
      exact hnot ⟨hxr, not_lt.mp h⟩
    have hx0 : 0 < x := by linarith
    apply hvan x hx0
    have := Real.rpow_lt_rpow hR0.le hxR hd
    rw [hRd] at this
    exact this.le

theorem rpow_shift_deriv_v4 : ∀ (d c T : ℝ), 0 < d → ∀ j : ℕ, ∃ C : ℝ, ∀ r u : ℝ, 0 < r → 0 < r ^ d + u →
     r ^ d / (r ^ d + u) ≤ T → |iteratedDeriv j (fun s : ℝ => (s ^ d + u) ^ c) r| * r ^ j ≤ C * (r ^ d + u) ^ c :=
by
  intro d c T hd
  have s1 : ∀ (u : ℝ) (j : ℕ) (P : Polynomial ℝ) (x : ℝ), 0 < x → 0 < x ^ d + u →
      HasDerivAt (fun s : ℝ => (s ^ d + u) ^ c * P.eval (s ^ d / (s ^ d + u)) / s ^ j)
        ((x ^ d + u) ^ c * ((Polynomial.C (c * d) * Polynomial.X - Polynomial.C (j : ℝ)) * P
          + Polynomial.C d * (Polynomial.X - Polynomial.X ^ 2) * Polynomial.derivative P).eval
            (x ^ d / (x ^ d + u)) / x ^ (j + 1)) x := by
    intro u j P x hx hA
    have h1 : HasDerivAt (fun s : ℝ => s ^ d) (d * x ^ (d - 1)) x :=
      Real.hasDerivAt_rpow_const (Or.inl hx.ne')
    have h2 : HasDerivAt (fun s : ℝ => s ^ d + u) (d * x ^ (d - 1)) x := h1.add_const u
    have h3 : HasDerivAt (fun s : ℝ => (s ^ d + u) ^ c)
        (d * x ^ (d - 1) * c * (x ^ d + u) ^ (c - 1)) x :=
      h2.rpow_const (Or.inl hA.ne')
    have h4 : HasDerivAt (fun s : ℝ => s ^ d / (s ^ d + u))
        ((d * x ^ (d - 1) * (x ^ d + u) - x ^ d * (d * x ^ (d - 1))) / (x ^ d + u) ^ 2) x :=
      h1.div h2 hA.ne'
    have h5 : HasDerivAt (fun s : ℝ => P.eval (s ^ d / (s ^ d + u)))
        ((Polynomial.derivative P).eval (x ^ d / (x ^ d + u)) *
          ((d * x ^ (d - 1) * (x ^ d + u) - x ^ d * (d * x ^ (d - 1))) / (x ^ d + u) ^ 2)) x :=
      (P.hasDerivAt _).comp x h4
    have h6 : HasDerivAt (fun s : ℝ => s ^ j) ((j : ℝ) * x ^ (j - 1)) x := hasDerivAt_pow j x
    have h7 := (h3.mul h5).div h6 (pow_ne_zero j hx.ne')
    convert h7 using 1
    simp only [Pi.mul_apply]
    have hx0 := hx.ne'
    have hA0 := hA.ne'
    rw [Real.rpow_sub_one hx0, Real.rpow_sub_one hA0]
    simp only [Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_X, Polynomial.eval_pow]
    cases j with
    | zero =>
      simp only [Nat.cast_zero, zero_mul, pow_zero, zero_add, pow_one, mul_one, sub_zero]
      field_simp
      ring
    | succ k =>
      simp only [Nat.add_sub_cancel]
      push_cast
      field_simp
      ring
  have s2 : ∀ n : ℕ, ∃ P : Polynomial ℝ, ∀ u s : ℝ, 0 < s → 0 < s ^ d + u →
      iteratedDeriv n (fun s : ℝ => (s ^ d + u) ^ c) s * s ^ n =
        (s ^ d + u) ^ c * P.eval (s ^ d / (s ^ d + u)) := by
    intro n
    induction n with
    | zero => exact ⟨1, fun u s _ _ => by simp⟩
    | succ n ih =>
      obtain ⟨P, hP⟩ := ih
      refine ⟨(Polynomial.C (c * d) * Polynomial.X - Polynomial.C (n : ℝ)) * P
          + Polynomial.C d * (Polynomial.X - Polynomial.X ^ 2) * Polynomial.derivative P,
          fun u x hx hA => ?_⟩
      have hS : IsOpen {s : ℝ | 0 < s ∧ 0 < s ^ d + u} :=
        (isOpen_lt continuous_const continuous_id).inter
          (isOpen_lt continuous_const ((Real.continuous_rpow_const hd.le).add continuous_const))
      have hev : iteratedDeriv n (fun s : ℝ => (s ^ d + u) ^ c) =ᶠ[nhds x]
          (fun s : ℝ => (s ^ d + u) ^ c * P.eval (s ^ d / (s ^ d + u)) / s ^ n) :=
        Filter.eventuallyEq_of_mem (hS.mem_nhds ⟨hx, hA⟩) (fun s hs =>
          (eq_div_iff (pow_ne_zero _ hs.1.ne')).mpr (hP u s hs.1 hs.2))
      rw [iteratedDeriv_succ, hev.deriv_eq, (s1 u n P x hx hA).deriv]
      exact div_mul_cancel₀ _ (pow_ne_zero _ hx.ne')
  intro j
  obtain ⟨P, hP⟩ := s2 j
  obtain ⟨C0, hC0⟩ := (isCompact_Icc (a := (0:ℝ)) (b := |T|)).exists_bound_of_continuousOn
    (Polynomial.continuous P).continuousOn
  refine ⟨C0, fun r u hr hA hT => ?_⟩
  have hτ0 : 0 ≤ r ^ d / (r ^ d + u) := (div_pos (Real.rpow_pos_of_pos hr d) hA).le
  have hmem : r ^ d / (r ^ d + u) ∈ Set.Icc (0:ℝ) |T| := ⟨hτ0, hT.trans (le_abs_self T)⟩
  have hb := hC0 _ hmem
  rw [Real.norm_eq_abs] at hb
  have hAc : 0 < (r ^ d + u) ^ c := Real.rpow_pos_of_pos hA c
  calc |iteratedDeriv j (fun s : ℝ => (s ^ d + u) ^ c) r| * r ^ j
      = |iteratedDeriv j (fun s : ℝ => (s ^ d + u) ^ c) r * r ^ j| := by
        rw [abs_mul, abs_of_pos (pow_pos hr j)]
    _ = (r ^ d + u) ^ c * |P.eval (r ^ d / (r ^ d + u))| := by
        rw [hP u r hr hA, abs_mul, abs_of_pos hAc]
    _ ≤ (r ^ d + u) ^ c * C0 := mul_le_mul_of_nonneg_left hb hAc.le
    _ = C0 * (r ^ d + u) ^ c := mul_comm _ _

theorem radial_nb_v4 : ∀ (h : ℝ) (φ : ℝ → ℝ) (S : Set ℝ) (ξ : Cyl) (j : ℕ), IsOpen S → ξ.1 ∈ S →
     ContDiffOn ℝ ∞ φ S → NB h (fun η => φ η.1) j ξ ≤ Real.sqrt (qC h ξ) ^ j * |iteratedDeriv j φ ξ.1| :=
by
  intro h φ S ξ j hS hξS hφ

  have key : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (F : E → G) (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  obtain ⟨π, hπ⟩ : ∃ π : Cyl →L[ℝ] ℝ, π = ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)) := ⟨_, rfl⟩
  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = Real.sqrt (qC h ξ) := ⟨_, rfl⟩
  have hs0 : 0 ≤ s := by rw [hs]; exact Real.sqrt_nonneg _
  obtain ⟨V, hV⟩ : ∃ V : Set Cyl, V = Prod.fst ⁻¹' S := ⟨_, rfl⟩
  have hVo : IsOpen V := by rw [hV]; exact hS.preimage continuous_fst
  have hξV : ξ ∈ V := by rw [hV]; exact hξS
  have hFV : ContDiffOn ℝ ∞ (fun η : Cyl => φ η.1) V := by
    rw [hV]
    exact hφ.comp contDiff_fst.contDiffOn (fun η hη => hη)

  have hfun : ∀ z : Cyl, (fun η : Cyl => φ η.1) (ξ + Lnorm h ξ z) = φ (ξ.1 + (s • π) z) := by
    intro z
    have h1 : (ξ + Lnorm h ξ z).1 = ξ.1 + (s • π) z := by
      rw [hπ, hs]; simp [Lnorm]
    show φ (ξ + Lnorm h ξ z).1 = _
    rw [h1]
  have hfunEq : (fun z : Cyl => (fun η : Cyl => φ η.1) (ξ + Lnorm h ξ z)) =
      (fun z : Cyl => φ (ξ.1 + (s • π) z)) := funext hfun
  have e1 := key (fun η : Cyl => φ η.1) V ξ (Lnorm h ξ) hVo hFV hξV j
  have e2 := key φ S ξ.1 (s • π) hS hφ hξS j
  have hNBeq : NB h (fun η : Cyl => φ η.1) j ξ =
      ‖(iteratedFDeriv ℝ j φ ξ.1).compContinuousLinearMap (fun _ => s • π)‖ := by
    unfold NB
    rw [← e1, hfunEq, e2]
  rw [hNBeq]
  refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
  have hπ1 : ‖π‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
    rw [hπ]
    show ‖η.1‖ ≤ 1 * ‖η‖
    rw [one_mul]
    exact norm_fst_le η
  have hn : ‖s • π‖ ≤ s := by
    rw [norm_smul, Real.norm_of_nonneg hs0]
    exact mul_le_of_le_one_right hs0 hπ1
  have hprod : ∏ _i : Fin j, ‖s • π‖ ≤ s ^ j := by
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    exact pow_le_pow_left₀ (norm_nonneg _) hn j
  have hd : ‖iteratedFDeriv ℝ j φ ξ.1‖ = |iteratedDeriv j φ ξ.1| := by
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs]
  rw [hd, ← hs, mul_comm (s ^ j)]
  exact mul_le_mul_of_nonneg_left hprod (abs_nonneg _)

theorem fiber_comp_nb_v4 : ∀ (B : BG) (qs : ℝ), B.ok → 0 < drx B.h → 0 < qs → qs ≤ 1 →
     ∀ (f : Cyl → ℝ), ContDiffOn ℝ ∞ f (DomC B.h qs) → ∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h qs,
       B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ u : ℝ,
       (2 * B.Xa * qC B.h ξ) ^ (drx B.h / 2) < ξ.1 ^ drx B.h + u →
       ξ.1 ^ drx B.h + u < (2 * B.Xb * qC B.h ξ) ^ (drx B.h / 2) →
       NB B.h (fun η => f ((η.1 ^ drx B.h + u) ^ (1 / drx B.h), η.2.1, η.2.2.1, η.2.2.2 + u • vrv)) k ξ ≤
         C * ∑ i ∈ Finset.range (k + 1), NB B.h f i (pathPt B.h ξ ((ξ.1 ^ drx B.h + u) ^ (1 / drx B.h))) :=
by
  intro B qs hok hd0 hqs0 hqs1 f hf k

  have key : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (F : E → ℝ) (V : Set E) (a z0 : E)
      (T : E →L[ℝ] E) (i : ℕ), IsOpen V → ContDiffOn ℝ ∞ F V → a + T z0 ∈ V →
      iteratedFDeriv ℝ i (fun z => F (a + T z)) z0 =
        (iteratedFDeriv ℝ i F (a + T z0)).compContinuousLinearMap (fun _ => T) := by
    intro E _ _ F V a z0 T i hV hF ha
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have hT0s : T z0 ∈ s := by rw [hs_def]; exact ha
    have h0O : z0 ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs hT0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a (T z0)
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) z0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) z0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T z0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) (T z0)).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = _ := by rw [e4]

  have thetaB : ∀ (d u a r : ℝ) (i : ℕ), 0 < d → 0 < a → 0 < r → 0 < r ^ d + u →
      ‖iteratedFDeriv ℝ i (fun x : ℝ => a⁻¹ * ((r + a * x) ^ d + u) ^ (1 / d)) 0‖ ≤
        a⁻¹ * a ^ i * |iteratedDeriv i (fun s : ℝ => (s ^ d + u) ^ (1 / d)) r| := by
    intro d u a r i hd ha hr hs
    obtain ⟨S, hSdef⟩ : ∃ S : Set ℝ, S = {x : ℝ | 0 < x ∧ 0 < x ^ d + u} := ⟨_, rfl⟩
    have hS : IsOpen S := by
      rw [hSdef]
      exact (isOpen_lt continuous_const continuous_id).inter
        (isOpen_lt continuous_const ((Real.continuous_rpow_const hd.le).add continuous_const))
    obtain ⟨φ, hφdef⟩ : ∃ φ : ℝ → ℝ, φ = fun s => (s ^ d + u) ^ (1 / d) := ⟨_, rfl⟩
    have hφ : ContDiffOn ℝ ∞ φ S := by
      intro x hx
      rw [hSdef] at hx
      rw [hφdef]
      exact (((contDiffAt_id.rpow_const_of_ne hx.1.ne').add contDiffAt_const).rpow_const_of_ne
        hx.2.ne').contDiffWithinAt
    obtain ⟨T, hT⟩ : ∃ T : ℝ →L[ℝ] ℝ, T = a • ContinuousLinearMap.id ℝ ℝ := ⟨_, rfl⟩
    have hTx : ∀ x, T x = a * x := by intro x; rw [hT]; rfl
    have hrS : r + T 0 ∈ S := by rw [map_zero, add_zero, hSdef]; exact ⟨hr, hs⟩
    have hk := key φ S r 0 T i hS hφ hrS
    rw [map_zero, add_zero] at hk
    have hg : ContDiffAt ℝ i (fun x => φ (r + T x)) 0 := by
      have h1 : ContDiffAt ℝ ∞ φ (r + T 0) := hφ.contDiffAt (hS.mem_nhds hrS)
      exact (h1.comp (0:ℝ) (contDiff_const.add T.contDiff).contDiffAt).of_le
        (by exact_mod_cast le_top)
    have hfun : (fun x : ℝ => a⁻¹ * ((r + a * x) ^ d + u) ^ (1 / d)) =
        fun x => a⁻¹ • φ (r + T x) := by
      funext x; rw [hTx, hφdef, smul_eq_mul]
    have hTn : ‖T‖ ≤ a := by
      refine ContinuousLinearMap.opNorm_le_bound _ ha.le (fun x => ?_)
      rw [hTx, norm_mul, Real.norm_eq_abs a, abs_of_pos ha]
    have hprod : ∏ _j : Fin i, ‖T‖ ≤ a ^ i := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_pow_left₀ (norm_nonneg _) hTn i
    have hc := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
      (iteratedFDeriv ℝ i φ r) (fun _ => T)
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs] at hc
    rw [hfun, iteratedFDeriv_const_smul_apply' hg, hk, norm_smul, Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr ha), ← hφdef]
    calc a⁻¹ * ‖(iteratedFDeriv ℝ i φ r).compContinuousLinearMap (fun _ => T)‖
        ≤ a⁻¹ * (|iteratedDeriv i φ r| * a ^ i) :=
          mul_le_mul_of_nonneg_left (hc.trans (mul_le_mul_of_nonneg_left hprod (abs_nonneg _)))
            (inv_nonneg.mpr ha.le)
      _ = a⁻¹ * a ^ i * |iteratedDeriv i φ r| := by ring

  have prodB : ∀ (θ : ℝ → ℝ) (V : Set ℝ) (i : ℕ), IsOpen V → (0:ℝ) ∈ V → ContDiffOn ℝ ∞ θ V → 1 ≤ i →
      ‖iteratedFDeriv ℝ i (fun w : Cyl => ((θ w.1, w.2) : Cyl)) 0‖ ≤ ‖iteratedFDeriv ℝ i θ 0‖ + 1 := by
    intro θ V i hV h0 hθ hi
    have hfun : (fun w : Cyl => ((θ w.1, w.2) : Cyl)) =
        (⇑(ContinuousLinearMap.inl ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) ∘
          (θ ∘ ⇑(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))))) +
        ⇑((ContinuousLinearMap.inr ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))) := by
      funext w
      simp
    have hπ0 : (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) 0 ∈ V := by rw [map_zero]; exact h0
    have hO : IsOpen (⇑(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) ⁻¹' V) :=
      hV.preimage (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))).continuous
    have h0O : (0:Cyl) ∈ ⇑(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) ⁻¹' V := hπ0
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right
      (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) hθ hV.uniqueDiffOn hO.uniqueDiffOn hπ0
      (i := i) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen i hO h0O, iteratedFDerivWithin_of_isOpen i hV hπ0,
      map_zero] at e2
    have hθc : ContDiffAt ℝ ∞ θ ((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) 0) :=
      hθ.contDiffAt (hV.mem_nhds hπ0)
    have hA : ContDiffAt ℝ ∞ (θ ∘ ⇑(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))) 0 :=
      hθc.comp (0:Cyl) (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))).contDiff.contDiffAt
    have hA2 : ContDiffAt ℝ ∞ (⇑(ContinuousLinearMap.inl ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) ∘
        (θ ∘ ⇑(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))))) 0 :=
      (ContinuousLinearMap.inl ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))).contDiff.contDiffAt.comp (0:Cyl) hA
    have t1 : ‖iteratedFDeriv ℝ i (⇑(ContinuousLinearMap.inl ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) ∘
        (θ ∘ ⇑(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))))) 0‖ ≤ ‖iteratedFDeriv ℝ i θ 0‖ := by
      refine (ContinuousLinearMap.norm_iteratedFDeriv_comp_left _ hA
        (by exact_mod_cast le_top)).trans ?_
      rw [e2]
      have hp : ∏ _j : Fin i, ‖ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))‖ ≤ 1 := by
        rw [Finset.prod_const]
        exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_fst_le ℝ ℝ _)
      have hc := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
        (iteratedFDeriv ℝ i θ 0) (fun _ => ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))
