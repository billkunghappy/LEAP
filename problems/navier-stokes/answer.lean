theorem temp_dg_class_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → SimNorm B.h → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (S : CState) (dPsi dv : Cyl → ℝ) (α : ℝ), 0 ≤ α → InM B (qsOf l0) 0.9 (nrm B (Aex B.h) (mcor5 B G l0 S 1)) → InM B (qsOf l0) 0.9 (nrm B (Aex B.h) (mcor5 B G l0 S 2)) → InM B (qsOf l0) 1.9 (nrm B (Aex B.h) (mcor5 B G l0 S 0)) → InM B (qsOf l0) α (nrm B (Aex B.h) (momDvP B dv)) → InM B (qsOf l0) α (nrm B (Aex B.h) (momDgP B dPsi)) → InM B (qsOf l0) (α + 1) (nrm B (Aex B.h) (momDbP B dPsi)) → InM B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) (momDg5 B G l0 S dPsi dv)) :=
by
