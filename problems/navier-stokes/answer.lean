theorem pqc_moment_values : ∀ (X η B : ℝ) (κ g φ0 φ1 φ2 A c1 c2 : ℝ → ℝ) (F U : ℝ → ℝ → ℝ), 0 < X → Measurable κ → Measurable g → Measurable φ0 → Measurable φ1 → Measurable φ2 → (∀ s : ℝ, 0 ≤ s → s ≤ X → |κ s| ≤ B ∧ |g s| ≤ B ∧ |φ0 s| ≤ B ∧ |φ1 s| ≤ B ∧ |φ2 s| ≤ B) → DifferentiableAt ℝ A η → DifferentiableAt ℝ c1 η → DifferentiableAt ℝ c2 η → (∀ s e : ℝ, 0 ≤ s → s ≤ X → U s e = e * κ s + (1 + e ^ 2)⁻¹ * g s * (A e * φ0 s + c1 e * φ1 s + c2 e * φ2 s) ∧ 2 * s * F s e = (1 + e ^ 2)⁻¹ * (Real.sqrt (2 * s) * g s)) → ∃ Ik IG IJk M0 M1 M2 J0 J1 J2 : ℝ, Ik = (∫ s in (0:ℝ)..X, κ s) ∧ IG = (∫ s in (0:ℝ)..X, Real.sqrt (2 * s) * g s) ∧ IJk = (∫ s in (0:ℝ)..X, Real.sqrt (2 * s) * g s * κ s) ∧ M0 = (∫ s in (0:ℝ)..X, g s * φ0 s) ∧ M1 = (∫ s in (0:ℝ)..X, g s * φ1 s) ∧ M2 = (∫ s in (0:ℝ)..X, g s * φ2 s) ∧ J0 = (∫ s in (0:ℝ)..X, Real.sqrt (2 * s) * g s ^ 2 * φ0 s) ∧ J1 = (∫ s in (0:ℝ)..X, Real.sqrt (2 * s) * g s ^ 2 * φ1 s) ∧ J2 = (∫ s in (0:ℝ)..X, Real.sqrt (2 * s) * g s ^ 2 * φ2 s) ∧ profRadAvg U X η = X⁻¹ * (η * Ik + (1 + η ^ 2)⁻¹ * (A η * M0 + c1 η * M1 + c2 η * M2)) ∧ profEtaD (profRadAvg U) X η = X⁻¹ * (Ik + -(2 * η * ((1 + η ^ 2)⁻¹) ^ 2) * (A η * M0 + c1 η * M1 + c2 η * M2) + (1 + η ^ 2)⁻¹ * (deriv A η * M0 + deriv c1 η * M1 + deriv c2 η * M2)) ∧ profRadInt (fun x e => 2 * x * F x e) X η = (1 + η ^ 2)⁻¹ * IG ∧ profEtaD (profRadInt (fun x e => 2 * x * F x e)) X η = -(2 * η * ((1 + η ^ 2)⁻¹) ^ 2) * IG ∧ profRadInt (fun x e => U x e * (2 * x * F x e)) X η = η * (1 + η ^ 2)⁻¹ * IJk + ((1 + η ^ 2)⁻¹) ^ 2 * (A η * J0 + c1 η * J1 + c2 η * J2) ∧ profEtaD (profRadInt (fun x e => U x e * (2 * x * F x e))) X η = ((1 + η ^ 2)⁻¹ - 2 * η ^ 2 * ((1 + η ^ 2)⁻¹) ^ 2) * IJk + -(4 * η * ((1 + η ^ 2)⁻¹) ^ 3) * (A η * J0 + c1 η * J1 + c2 η * J2) + ((1 + η ^ 2)⁻¹) ^ 2 * (deriv A η * J0 + deriv c1 η * J1 + deriv c2 η * J2) ∧ 2 * X * F X η = (1 + η ^ 2)⁻¹ * (Real.sqrt (2 * X) * g X) :=
by
  intro X η B κ g φ0 φ1 φ2 A c1 c2 F U hX hκ hg hφ0 hφ1 hφ2 hb hA hc1 hc2 hrep

  have hII : ∀ (h : ℝ → ℝ) (M : ℝ), Measurable h → (∀ s, 0 ≤ s → s ≤ X → |h s| ≤ M) →
