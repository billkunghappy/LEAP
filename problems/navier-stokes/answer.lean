  have affine : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (f : E → ℝ) (s : Set E) (L : G →L[ℝ] E) (c : E) (x : G) (k : ℕ), IsOpen s →
