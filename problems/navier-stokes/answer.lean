        ring
      have key := intervalIntegral.integral_eq_sub_of_hasDerivAt hder ((hcDF.mono hsub).intervalIntegrable)
      simp only [Real.exp_zero, mul_one] at key
      linarith
    · have hder : ∀ z ∈ uIcc 0 b, HasDerivAt (fun z => Un (4 / Λ * Real.exp z) e)
          (4 / Λ * Real.exp z * deriv (fun Y => Un Y e) (4 / Λ * Real.exp z)) z := by
        intro z hz
        have hzI := hsub hz
        have hf : HasDerivAt (fun Y => Un Y e) (deriv (fun Y => Un Y e) (4 / Λ * Real.exp z))
