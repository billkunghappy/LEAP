  refine ⟨l₁ + l₃ + l₅a + l₅b + l₅c, ?_⟩
  intro l0 hl0 S bw ca H hbw hbwH hH9 hca hSt hI hP hMn hR

  have hqpos : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η hη =>
    (hok.1.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hO : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt (by fun_prop) continuous_const

  have hcongr : ∀ (α : ℝ) (f g : Cyl → ℝ), (∀ η : Cyl, η.2.2.1 < 1 → g η = f η) →
      InM B (qsOf l0) α f → InM B (qsOf l0) α g := by
    intro α f g hfg hf
    obtain ⟨c1, c2, c3, c4⟩ := hf
    have hdom : ∀ ξ ∈ DomC B.h (qsOf l0), ξ.2.2.1 < 1 := fun ξ hξ => hξ.2.1
    have hev : ∀ ξ ∈ DomC B.h (qsOf l0), g =ᶠ[nhds ξ] f := fun ξ hξ =>
      Filter.eventuallyEq_of_mem (hO.mem_nhds (hdom ξ hξ)) (fun η hη => hfg η hη)
    refine ⟨c1.congr (fun ξ hξ => hfg ξ (hdom ξ hξ)), ?_, ?_, ?_⟩
    · intro ξ hξ a ha
      have e1 : g (shY ξ a) = f (shY ξ a) := hfg (shY ξ a) (hdom ξ hξ)
      rw [e1, hfg ξ (hdom ξ hξ)]
      exact c2 ξ hξ a ha
    · intro ξ hξ hX
      rw [hfg ξ (hdom ξ hξ)]
      exact c3 ξ hξ hX
    · intro k
      obtain ⟨C, b, d, hC⟩ := c4 k
      refine ⟨C, b, d, fun ξ hξ hX1 hX2 => ?_⟩
      have hb := hC ξ hξ hX1 hX2
      unfold NB at hb ⊢
      rwa [((hev ξ hξ).iteratedFDeriv ℝ k).eq_of_nhds]

  set dPsi : Cyl → ℝ := nrm B (Aex B.h - 1/2) (PsiT5 B G l0 S) with hdPsi
  set dv : Cyl → ℝ := nrm B (Aex B.h) (dvT5 B G l0 S) with hdv
  have hS3 : tempState5 B G l0 S = momUpd S dPsi dv := rfl
  have hcP : InM B (qsOf l0) H dPsi := hP.1
  have hcv : InM B (qsOf l0) H dv := hI.1

  have hPs : ∀ η : Cyl, η.2.2.1 < 1 → momPsP B dPsi η = PsiT5 B G l0 S η := by
    intro η hη
    have hq := hqpos η hη
    simp only [momPsP, hdPsi, nrm]
    rw [← mul_assoc, ← Real.rpow_add hq]
    have e : (1/2 - Aex B.h + (Aex B.h - 1/2)) = 0 := by ring
    rw [e, Real.rpow_zero, one_mul]
  have hPsEv : ∀ η : Cyl, η.2.2.1 < 1 → momPsP B dPsi =ᶠ[nhds η] PsiT5 B G l0 S := fun η hη =>
    Filter.eventuallyEq_of_mem (hO.mem_nhds hη) (fun ζ hζ => hPs ζ hζ)
  have hdw : InM B (qsOf l0) H (nrm B (Aex B.h) (momDvP B dv)) := by
    refine hcongr H _ _ (fun η hη => ?_) hcv
    have hq := hqpos η hη
    simp only [nrm, momDvP, hdv]
    rw [← mul_assoc (qC B.h η ^ Aex B.h) (qC B.h η ^ (-Aex B.h)), ← Real.rpow_add hq, add_neg_cancel,
      Real.rpow_zero, one_mul]
  have hdg : InM B (qsOf l0) H (nrm B (Aex B.h) (momDgP B dPsi)) := by
    refine hcongr H _ _ (fun η hη => ?_) hP.2.1
    simp only [nrm, momDgP, dR]
    rw [(hPsEv η hη).fderiv_eq, hPs η hη]
  have hdb : InM B (qsOf l0) (H + 1) (nrm B (Aex B.h) (momDbP B dPsi)) := by
    refine hcongr (H + 1) _ _ (fun η hη => ?_) hP.2.2.1
    simp only [nrm, momDbP, dZ]
    rw [(hPsEv η hη).fderiv_eq]

  have hLF : ∀ ξ₀ ∈ DomC B.h (qsOf l0), ∃ (U : Set Cyl) (Γ : Finset Lab), IsOpen U ∧ ξ₀ ∈ U ∧
      ∀ ξ ∈ U, ∀ γ, γ ∉ Γ → ¬ SuppW B G γ ξ := by
    intro ξ₀ hξ₀
    obtain ⟨N, hN, Γ, hΓ⟩ := etaL_local_finite_v5 B.h hok.1 ξ₀ hξ₀.2.1
    exact ⟨interior N, Γ, isOpen_interior, mem_interior_iff_mem_nhds.mpr hN,
      fun ξ hξ γ hγ hS => hγ (hΓ γ ξ (interior_subset hξ) hS.2.1)⟩

  have hdU : ContDiffOn ℝ ∞ (dUM5 B dPsi dv) (DomC B.h (qsOf l0)) := by
    have e1 := (g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) (H + 1) _ hok hdb).1
    have e2 := (g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) H _ hok hdw).1
    have e3 := (g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) H _ hok hdg).1
    refine contDiffOn_pi.mpr (fun i => ?_)
    fin_cases i
    · exact e1
    · exact e2
    · exact e3
  have hPi : ContDiffOn ℝ ∞ (fun ξ => pmP5 B G l0 (momUpd S dPsi dv) ξ - pmP5 B G l0 S ξ)
      (DomC B.h (qsOf l0)) :=
    (g_regular_of_nrm_InM_v5 B (qsOf l0) (2 * Aex B.h) H _ hok hR.1).1
  have hDrep : ∀ x t Y, corrOn B l0 x t →
      DXm5 B l0 dPsi dv x t Y = cyl2cart x (dUM5 B dPsi dv (ptOf x t Y)) := by
    intro x t Y h
    simp only [DXm5, if_pos h]

  have hSt0 := hSt
  unfold StOrd5 at hSt0
  obtain ⟨-, -, -, -, -, -, ⟨fS, FlS, hfS, hFlS, hEqS⟩, -⟩ := hSt0

  obtain ⟨hA, huS, hpS, hW'⟩ := h1 l0 (by omega) S bw ca H H hSt hLF
  have hinc := twg5_increment_fields B G l0 S H dPsi dv hok hcP hcv hA
  have hw := h3 l0 (by omega) S bw ca H H hSt hLF
  have hproj := mwh5_theta_projection B G l0 S (momUpd S dPsi dv)
    (fun ξ => pmP5 B G l0 (momUpd S dPsi dv) ξ - pmP5 B G l0 S ξ) (dUM5 B dPsi dv)
    (fun x' t' Y' => cyl2cart x' (waveV5 B G (VwT5 B G S) (thetaOf x') (ptOf x' t' Y')))
    (DXm5 B l0 dPsi dv) hok huS hpS hW' hdU hPi hDrep hw hinc
  have hcross := h5a l0 (by omega) S bw ca H H H dPsi dv hSt hcP hcv hLF
  have hstr := h5b l0 (by omega) S bw ca H H dPsi dv H hSt hcP hcv hdw hdg hdb
  have hbd := h5c l0 (by omega) S bw ca H H dPsi dv H hSt hcP hcv hdw hdg hdb
  have hcls : InWg5 B G (qsOf l0) H (crossCoefM5 B G S dPsi dv) :=
    ⟨hstr.1, hstr.2.1, hstr.2.2.1, hstr.2.2.2, hbd⟩
  obtain ⟨hsum, hadd⟩ := mwh5_waveV_add B G hok l0 fS (crossCoefM5 B G S dPsi dv) bw H hLF hfS hcls
  rw [min_eq_left hbwH] at hsum
  rw [hS3]
  refine ⟨fS + crossCoefM5 B G S dPsi dv, FlS, hsum, hFlS, fun x t Y hxt => ?_⟩
  have hmem : ptOf x t Y ∈ DomC B.h (qsOf l0) := ⟨hxt.1, hxt.2.1, hxt.2.2⟩
  have hc : ∀ a b : Fin 3 → ℝ, cyl2cart x (a + b) = cyl2cart x a + cyl2cart x b := by
    intro a b
    simp only [cyl2cart, Pi.add_apply, add_smul]
    abel
  rw [hproj x t Y hxt, hEqS x t Y hxt, hcross x t Y hxt, hadd _ _ hmem, hc, smul_add]
  abel

theorem mom_moment_linear_v5 : ∀ (B : BG) (qs : ℝ), B.ok → 0 < qs →
    (∀ (f g : Cyl → ℝ) (c d : ℝ) (e : ℕ) (z t : ℝ), MomGood5 B qs f → MomGood5 B qs g →
      t < 1 → simScale B.h z (1 - t) < qs →
      radMom (fun η => c * f η + d * g η) e z t = c * radMom f e z t + d * radMom g e z t) ∧
    (∀ (f g : Cyl → ℝ) (e : ℕ) (z t : ℝ), (∀ ξ ∈ DomC B.h qs, f ξ = g ξ) →
      t < 1 → simScale B.h z (1 - t) < qs → radMom f e z t = radMom g e z t) ∧
    (∀ (f g : Cyl → ℝ) (cf cg : ℝ → ℝ → ℝ), MomGood5 B qs f → MomGood5 B qs g →
      ∀ ξ ∈ DomC B.h qs,
        Icut B (fun η => (f η + g η) - rhoP B η * (cf η.2.1 η.2.2.1 + cg η.2.1 η.2.2.1)) ξ =
          Icut B (fun η => f η - rhoP B η * cf η.2.1 η.2.2.1) ξ +
            Icut B (fun η => g η - rhoP B η * cg η.2.1 η.2.2.1) ξ) ∧
    (∀ (f g : Cyl → ℝ), (∀ ξ ∈ DomC B.h qs, f ξ = g ξ) →
      ∀ ξ ∈ DomC B.h qs, Icut B f ξ = Icut B g ξ) :=
by
  intro B qs hok hqs
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hXam1 : B.Xa < B.m1 := hok.2.1.2.2.2.1
  have hm12 : B.m1 < B.m2 := hok.2.1.2.2.2.2.1
  have hm2Xb : B.m2 < B.Xb := hok.2.1.2.2.2.2.2.1
  have hXb : 0 < B.Xb := by linarith

  have shell : ∀ q r : ℝ, 0 < q → 0 < r →
      (r < Real.sqrt (2 * B.Xa * q) ∨ Real.sqrt (2 * B.Xb * q) < r) →
      (r ^ 2 / (2 * q) < B.Xa ∨ B.Xb < r ^ 2 / (2 * q)) := by
    intro q r hq hr h
    rcases h with h | h
    · left
      have h2 : r ^ 2 < 2 * B.Xa * q := by
        have := pow_lt_pow_left₀ h hr.le (by norm_num : (2:ℕ) ≠ 0)
        rwa [Real.sq_sqrt (mul_pos (mul_pos two_pos hXa) hq).le] at this
      rw [div_lt_iff₀ (mul_pos two_pos hq)]
      linarith
    · right
      have h2 : 2 * B.Xb * q < r ^ 2 := by
        have := pow_lt_pow_left₀ h (Real.sqrt_nonneg _) (by norm_num : (2:ℕ) ≠ 0)
        rwa [Real.sq_sqrt (mul_pos (mul_pos two_pos hXb) hq).le] at this
      rw [lt_div_iff₀ (mul_pos two_pos hq)]
      linarith

  have radInt : ∀ (f : Cyl → ℝ) (e : ℕ) (z t : ℝ), MomGood5 B qs f → t < 1 →
      simScale B.h z (1 - t) < qs →
      (∀ r : ℝ, 0 < r → MeasureTheory.IntegrableOn (fun Y : ℝ × ℝ => f (r, z, t, Y))
        (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) ∧
      MeasureTheory.IntegrableOn (fun r : ℝ => r ^ e * yAvg f (r, z, t, 0)) (Set.Ioi (0:ℝ)) := by
    intro f e z t hf ht hq
    obtain ⟨hfc, hfz⟩ := hf
    have hq0 : 0 < simScale B.h z (1 - t) := (hok.1.1 z (1 - t) (by linarith)).1
    have hmem : ∀ r : ℝ, 0 < r → ∀ Y : ℝ × ℝ, ((r, z, t, Y) : Cyl) ∈ DomC B.h qs :=
      fun r hr Y => ⟨hr, ht, hq⟩
    have ha : 0 < Real.sqrt (2 * B.Xa * simScale B.h z (1 - t)) :=
      Real.sqrt_pos.mpr (mul_pos (mul_pos two_pos hXa) hq0)
    have hvan : ∀ r : ℝ, 0 < r → (r < Real.sqrt (2 * B.Xa * simScale B.h z (1 - t)) ∨
        Real.sqrt (2 * B.Xb * simScale B.h z (1 - t)) < r) → ∀ Y : ℝ × ℝ, f (r, z, t, Y) = 0 := by
      intro r hr h Y
      exact hfz _ (hmem r hr Y) (shell _ r hq0 hr h)
    have hslice : ∀ r : ℝ, 0 < r → MeasureTheory.IntegrableOn (fun Y : ℝ × ℝ => f (r, z, t, Y))
        (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) := by
      intro r hr
      have hφ : Continuous (fun Y : ℝ × ℝ => ((r, z, t, Y) : Cyl)) := by fun_prop
      have hc : ContinuousOn (fun Y : ℝ × ℝ => f (r, z, t, Y)) (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1) :=
        hfc.continuousOn.comp hφ.continuousOn (fun Y _ => hmem r hr Y)
      exact hc.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
    have hK : IsCompact (Set.Icc (Real.sqrt (2 * B.Xa * simScale B.h z (1 - t)))
        (Real.sqrt (2 * B.Xb * simScale B.h z (1 - t))) ×ˢ (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) :=
      isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc)
    have hcont : ContinuousOn (fun y : ℝ × (ℝ × ℝ) => y.1 ^ e * f (y.1, z, t, y.2))
        (Set.Icc (Real.sqrt (2 * B.Xa * simScale B.h z (1 - t)))
          (Real.sqrt (2 * B.Xb * simScale B.h z (1 - t))) ×ˢ (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1)) := by
      have hφ : Continuous (fun y : ℝ × (ℝ × ℝ) => ((y.1, z, t, y.2) : Cyl)) := by fun_prop
      exact (continuous_fst.pow e).continuousOn.mul
        (hfc.continuousOn.comp hφ.continuousOn
          (fun y hy => hmem y.1 (lt_of_lt_of_le ha hy.1.1) y.2))
    have hint : MeasureTheory.IntegrableOn (fun y : ℝ × (ℝ × ℝ) => y.1 ^ e * f (y.1, z, t, y.2))
        (Set.Icc (Real.sqrt (2 * B.Xa * simScale B.h z (1 - t)))
          (Real.sqrt (2 * B.Xb * simScale B.h z (1 - t))) ×ˢ (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1))
        ((MeasureTheory.volume : MeasureTheory.Measure ℝ).prod
          (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ))) :=
      hcont.integrableOn_compact hK
    have hint2 : MeasureTheory.Integrable (fun y : ℝ × (ℝ × ℝ) => y.1 ^ e * f (y.1, z, t, y.2))
        (((MeasureTheory.volume : MeasureTheory.Measure ℝ).restrict
            (Set.Icc (Real.sqrt (2 * B.Xa * simScale B.h z (1 - t)))
              (Real.sqrt (2 * B.Xb * simScale B.h z (1 - t))))).prod
          ((MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ)).restrict
            (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1))) := by
      rw [MeasureTheory.Measure.prod_restrict]
      exact hint
    have hI : MeasureTheory.IntegrableOn (fun r : ℝ => r ^ e * yAvg f (r, z, t, 0))
        (Set.Icc (Real.sqrt (2 * B.Xa * simScale B.h z (1 - t)))
          (Real.sqrt (2 * B.Xb * simScale B.h z (1 - t)))) := by
      refine (hint2.integral_prod_left).congr (Filter.Eventually.of_forall (fun x => ?_))
      show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, x ^ e * f (x, z, t, Y)) =
        x ^ e * ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, f (x, z, t, Y)
      exact MeasureTheory.integral_const_mul _ _
    refine ⟨hslice, hI.of_forall_sdiff_eq_zero measurableSet_Ioi ?_⟩
    rintro r ⟨hr0, hrI⟩
    have hr0' : (0:ℝ) < r := hr0
    have hor : r < Real.sqrt (2 * B.Xa * simScale B.h z (1 - t)) ∨
        Real.sqrt (2 * B.Xb * simScale B.h z (1 - t)) < r := by
      by_contra hcon
      push_neg at hcon
      exact hrI ⟨hcon.1, hcon.2⟩
    have hz : yAvg f (r, z, t, 0) = 0 := by
      show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, f (r, z, t, Y)) = 0
      simp [hvan r hr0' hor]
    show r ^ e * yAvg f (r, z, t, 0) = 0
    rw [hz, mul_zero]

  have pathInt : ∀ (f : Cyl → ℝ) (ξ : Cyl), MomGood5 B qs f → ξ ∈ DomC B.h qs →
      MeasureTheory.IntegrableOn (fun r : ℝ => f (pathPt B.h ξ r)) (Set.Ioi (0:ℝ)) := by
    intro f ξ hf hξ
    obtain ⟨hfc, hfz⟩ := hf
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    obtain ⟨_, hξ2, hξ3⟩ := hξ'
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    have hmem : ∀ r : ℝ, 0 < r → pathPt B.h ξ r ∈ DomC B.h qs := fun r hr => ⟨hr, hξ2, hξ3⟩
    have ha : 0 < Real.sqrt (2 * B.Xa * qC B.h ξ) :=
      Real.sqrt_pos.mpr (mul_pos (mul_pos two_pos hXa) hq0)
    have hzero : ∀ r ∈ Set.Ioi (0:ℝ) \ Set.Icc (Real.sqrt (2 * B.Xa * qC B.h ξ))
        (Real.sqrt (2 * B.Xb * qC B.h ξ)), f (pathPt B.h ξ r) = 0 := by
      rintro r ⟨hr0, hrI⟩
      have hr0' : (0:ℝ) < r := hr0
      have hor : r < Real.sqrt (2 * B.Xa * qC B.h ξ) ∨ Real.sqrt (2 * B.Xb * qC B.h ξ) < r := by
        by_contra hcon
        push_neg at hcon
        exact hrI ⟨hcon.1, hcon.2⟩
      exact hfz _ (hmem r hr0') (shell _ r hq0 hr0' hor)
    have hcont : ContinuousOn (fun r : ℝ => f (pathPt B.h ξ r))
        (Set.Icc (Real.sqrt (2 * B.Xa * qC B.h ξ)) (Real.sqrt (2 * B.Xb * qC B.h ξ))) := by
      have hp : ContinuousOn (fun r : ℝ => r ^ drx B.h)
          (Set.Icc (Real.sqrt (2 * B.Xa * qC B.h ξ)) (Real.sqrt (2 * B.Xb * qC B.h ξ))) :=
        ContinuousOn.rpow_const continuousOn_id
          (fun x hx => Or.inl (ne_of_gt (lt_of_lt_of_le ha hx.1)))
      have hγ : ContinuousOn (fun r : ℝ => pathPt B.h ξ r)
          (Set.Icc (Real.sqrt (2 * B.Xa * qC B.h ξ)) (Real.sqrt (2 * B.Xb * qC B.h ξ))) := by
        show ContinuousOn (fun r : ℝ =>
          ((r, ξ.2.1, ξ.2.2.1, ξ.2.2.2 + (r ^ drx B.h - ξ.1 ^ drx B.h) • vrv) : Cyl)) _
        exact continuousOn_id.prodMk (continuousOn_const.prodMk (continuousOn_const.prodMk
          (continuousOn_const.add ((hp.sub continuousOn_const).smul continuousOn_const))))
      exact hfc.continuousOn.comp hγ (fun r hr => hmem r (lt_of_lt_of_le ha hr.1))
    exact (hcont.integrableOn_Icc).of_forall_sdiff_eq_zero measurableSet_Ioi hzero

  have rhoInt : ∀ ξ : Cyl, ξ.2.2.1 < 1 →
      MeasureTheory.IntegrableOn (fun r : ℝ => rhoP B (pathPt B.h ξ r)) (Set.Ioi (0:ℝ)) := by
    intro ξ hξ
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    have hsq : 0 < Real.sqrt (qC B.h ξ) := Real.sqrt_pos.mpr hq0
    have hs12 : Real.sqrt (2 * B.m1) < Real.sqrt (2 * B.m2) :=
      Real.sqrt_lt_sqrt (by linarith) (by linarith)
    have hbump : Continuous bumpR := by
      have : bumpR = fun s : ℝ => Real.smoothTransition (1 - s ^ 2) := rfl
      rw [this]
      exact Real.smoothTransition.continuous.comp (continuous_const.sub (continuous_id.pow 2))
    have hb0 : ∀ u : ℝ, 1 < u → bumpR u = 0 := by
      intro u hu
      show Real.smoothTransition (1 - u ^ 2) = 0
      apply Real.smoothTransition.zero_of_nonpos
      nlinarith
    have hrhoHat : Continuous (rhoHat B) := by
      have h1 : Continuous (fun s : ℝ => bumpR ((s - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
          ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2))) :=
        hbump.comp ((continuous_id.sub continuous_const).div_const _)
      exact h1.div_const _
    have hvanish : ∀ r : ℝ, Real.sqrt (qC B.h ξ) * Real.sqrt (2 * B.m2) < r →
        rhoHat B (r / Real.sqrt (qC B.h ξ)) = 0 := by
      intro r hr
      have hs : Real.sqrt (2 * B.m2) < r / Real.sqrt (qC B.h ξ) := by
        rw [lt_div_iff₀ hsq]
        linarith
      have hw : 0 < (Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2 := by linarith
      have hu : 1 < (r / Real.sqrt (qC B.h ξ) - (Real.sqrt (2 * B.m1) + Real.sqrt (2 * B.m2)) / 2) /
          ((Real.sqrt (2 * B.m2) - Real.sqrt (2 * B.m1)) / 2) := by
        rw [lt_div_iff₀ hw]
        linarith
      simp only [rhoHat]
      rw [hb0 _ hu, zero_div]
    have hcontR : Continuous (fun r : ℝ => rhoP B (pathPt B.h ξ r)) := by
      have : (fun r : ℝ => rhoP B (pathPt B.h ξ r)) =
          fun r => qC B.h ξ ^ (-(1/2:ℝ)) * rhoHat B (r / Real.sqrt (qC B.h ξ)) := rfl
      rw [this]
      exact continuous_const.mul (hrhoHat.comp (continuous_id.div_const _))
    have hIcc : MeasureTheory.IntegrableOn (fun r : ℝ => rhoP B (pathPt B.h ξ r))
        (Set.Icc 0 (Real.sqrt (qC B.h ξ) * Real.sqrt (2 * B.m2))) := hcontR.integrableOn_Icc
    refine hIcc.of_forall_sdiff_eq_zero measurableSet_Ioi ?_
    rintro r ⟨hr0, hrI⟩
    have hr0' : (0:ℝ) < r := hr0
    have hr : Real.sqrt (qC B.h ξ) * Real.sqrt (2 * B.m2) < r := by
      by_contra hcon
      push_neg at hcon
      exact hrI ⟨hr0'.le, hcon⟩
    show qC B.h ξ ^ (-(1/2:ℝ)) * rhoHat B (r / Real.sqrt (qC B.h ξ)) = 0
    rw [hvanish r hr, mul_zero]

  have P2 : ∀ (f g : Cyl → ℝ) (e : ℕ) (z t : ℝ), (∀ ξ ∈ DomC B.h qs, f ξ = g ξ) →
      t < 1 → simScale B.h z (1 - t) < qs → radMom f e z t = radMom g e z t := by
    intro f g e z t hfg ht hq
    unfold radMom
    refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun r hr => ?_)
    have hr0 : (0:ℝ) < r := hr
    show r ^ e * yAvg f (r, z, t, 0) = r ^ e * yAvg g (r, z, t, 0)
    congr 1
    show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, f (r, z, t, Y)) =
      ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (r, z, t, Y)
    congr 1
    funext Y
    exact hfg _ ⟨hr0, ht, hq⟩

  have P4 : ∀ (f g : Cyl → ℝ), (∀ ξ ∈ DomC B.h qs, f ξ = g ξ) →
      ∀ ξ ∈ DomC B.h qs, Icut B f ξ = Icut B g ξ := by
    intro f g hfg ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    obtain ⟨hξ1, hξ2, hξ3⟩ := hξ'
    have hpt : ∀ r : ℝ, 0 < r → f (pathPt B.h ξ r) = g (pathPt B.h ξ r) :=
      fun r hr => hfg _ ⟨hr, hξ2, hξ3⟩
    have e1 : (∫ r in Set.Ioc (0:ℝ) ξ.1, f (pathPt B.h ξ r)) =
        ∫ r in Set.Ioc (0:ℝ) ξ.1, g (pathPt B.h ξ r) :=
      MeasureTheory.setIntegral_congr_fun measurableSet_Ioc (fun r hr => hpt r hr.1)
    have e2 : (∫ r in Set.Ioi (0:ℝ), f (pathPt B.h ξ r)) =
        ∫ r in Set.Ioi (0:ℝ), g (pathPt B.h ξ r) :=
      MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun r hr => hpt r hr)
    show (∫ r' in (0:ℝ)..ξ.1, f (pathPt B.h ξ r')) - chiM B (XC B.h ξ) *
        (∫ r' in Set.Ioi (0:ℝ), f (pathPt B.h ξ r')) =
      (∫ r' in (0:ℝ)..ξ.1, g (pathPt B.h ξ r')) - chiM B (XC B.h ξ) *
        (∫ r' in Set.Ioi (0:ℝ), g (pathPt B.h ξ r'))
    rw [intervalIntegral.integral_of_le hξ1.le, intervalIntegral.integral_of_le hξ1.le, e1, e2]

  have P1 : ∀ (f g : Cyl → ℝ) (c d : ℝ) (e : ℕ) (z t : ℝ), MomGood5 B qs f → MomGood5 B qs g →
      t < 1 → simScale B.h z (1 - t) < qs →
      radMom (fun η => c * f η + d * g η) e z t = c * radMom f e z t + d * radMom g e z t := by
    intro f g c d e z t hf hg ht hq
    obtain ⟨hYf, hRf⟩ := radInt f e z t hf ht hq
    obtain ⟨hYg, hRg⟩ := radInt g e z t hg ht hq
    have hpt : ∀ r ∈ Set.Ioi (0:ℝ), r ^ e * yAvg (fun η => c * f η + d * g η) (r, z, t, 0) =
        c * (r ^ e * yAvg f (r, z, t, 0)) + d * (r ^ e * yAvg g (r, z, t, 0)) := by
      intro r hr
      have hr0 : (0:ℝ) < r := hr
      have hy : yAvg (fun η => c * f η + d * g η) (r, z, t, 0) =
          c * yAvg f (r, z, t, 0) + d * yAvg g (r, z, t, 0) := by
        show (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, (c * f (r, z, t, Y) + d * g (r, z, t, Y))) =
          c * (∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, f (r, z, t, Y)) +
            d * ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (r, z, t, Y)
        rw [MeasureTheory.integral_add (MeasureTheory.Integrable.const_mul (hYf r hr0) c)
          (MeasureTheory.Integrable.const_mul (hYg r hr0) d),
          MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]
      rw [hy]
      ring
    show (∫ r in Set.Ioi (0:ℝ), r ^ e * yAvg (fun η => c * f η + d * g η) (r, z, t, 0)) =
      c * (∫ r in Set.Ioi (0:ℝ), r ^ e * yAvg f (r, z, t, 0)) +
        d * ∫ r in Set.Ioi (0:ℝ), r ^ e * yAvg g (r, z, t, 0)
    rw [MeasureTheory.setIntegral_congr_fun measurableSet_Ioi hpt,
      MeasureTheory.integral_add (MeasureTheory.Integrable.const_mul hRf c)
        (MeasureTheory.Integrable.const_mul hRg d),
      MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]

  have P3 : ∀ (f g : Cyl → ℝ) (cf cg : ℝ → ℝ → ℝ), MomGood5 B qs f → MomGood5 B qs g →
      ∀ ξ ∈ DomC B.h qs,
        Icut B (fun η => (f η + g η) - rhoP B η * (cf η.2.1 η.2.2.1 + cg η.2.1 η.2.2.1)) ξ =
          Icut B (fun η => f η - rhoP B η * cf η.2.1 η.2.2.1) ξ +
            Icut B (fun η => g η - rhoP B η * cg η.2.1 η.2.2.1) ξ := by
    intro f g cf cg hf hg ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    have hρ := rhoInt ξ hξ'.2.1
    have iF : MeasureTheory.IntegrableOn (fun r : ℝ => f (pathPt B.h ξ r) -
        rhoP B (pathPt B.h ξ r) * cf ξ.2.1 ξ.2.2.1) (Set.Ioi (0:ℝ)) :=
      MeasureTheory.Integrable.sub (pathInt f ξ hf hξ) (MeasureTheory.Integrable.mul_const hρ _)
    have iG : MeasureTheory.IntegrableOn (fun r : ℝ => g (pathPt B.h ξ r) -
        rhoP B (pathPt B.h ξ r) * cg ξ.2.1 ξ.2.2.1) (Set.Ioi (0:ℝ)) :=
      MeasureTheory.Integrable.sub (pathInt g ξ hg hξ) (MeasureTheory.Integrable.mul_const hρ _)
    have jF : IntervalIntegrable (fun r : ℝ => f (pathPt B.h ξ r) -
        rhoP B (pathPt B.h ξ r) * cf ξ.2.1 ξ.2.2.1) MeasureTheory.volume 0 ξ.1 :=
      (intervalIntegrable_iff_integrableOn_Ioc_of_le hξ'.1.le).2 (iF.mono_set Set.Ioc_subset_Ioi_self)
    have jG : IntervalIntegrable (fun r : ℝ => g (pathPt B.h ξ r) -
        rhoP B (pathPt B.h ξ r) * cg ξ.2.1 ξ.2.2.1) MeasureTheory.volume 0 ξ.1 :=
      (intervalIntegrable_iff_integrableOn_Ioc_of_le hξ'.1.le).2 (iG.mono_set Set.Ioc_subset_Ioi_self)
    have eI : (∫ r in (0:ℝ)..ξ.1, ((f (pathPt B.h ξ r) + g (pathPt B.h ξ r)) -
          rhoP B (pathPt B.h ξ r) * (cf ξ.2.1 ξ.2.2.1 + cg ξ.2.1 ξ.2.2.1))) =
        (∫ r in (0:ℝ)..ξ.1, (f (pathPt B.h ξ r) - rhoP B (pathPt B.h ξ r) * cf ξ.2.1 ξ.2.2.1)) +
          ∫ r in (0:ℝ)..ξ.1, (g (pathPt B.h ξ r) - rhoP B (pathPt B.h ξ r) * cg ξ.2.1 ξ.2.2.1) := by
      rw [← intervalIntegral.integral_add jF jG]
      congr 1
      funext r
      ring
    have eO : (∫ r in Set.Ioi (0:ℝ), ((f (pathPt B.h ξ r) + g (pathPt B.h ξ r)) -
          rhoP B (pathPt B.h ξ r) * (cf ξ.2.1 ξ.2.2.1 + cg ξ.2.1 ξ.2.2.1))) =
        (∫ r in Set.Ioi (0:ℝ), (f (pathPt B.h ξ r) - rhoP B (pathPt B.h ξ r) * cf ξ.2.1 ξ.2.2.1)) +
          ∫ r in Set.Ioi (0:ℝ), (g (pathPt B.h ξ r) - rhoP B (pathPt B.h ξ r) * cg ξ.2.1 ξ.2.2.1) := by
      rw [← MeasureTheory.integral_add iF iG]
      congr 1
      funext r
      ring
    show ((∫ r in (0:ℝ)..ξ.1, ((f (pathPt B.h ξ r) + g (pathPt B.h ξ r)) -
          rhoP B (pathPt B.h ξ r) * (cf ξ.2.1 ξ.2.2.1 + cg ξ.2.1 ξ.2.2.1))) -
        chiM B (XC B.h ξ) * ∫ r in Set.Ioi (0:ℝ), ((f (pathPt B.h ξ r) + g (pathPt B.h ξ r)) -
          rhoP B (pathPt B.h ξ r) * (cf ξ.2.1 ξ.2.2.1 + cg ξ.2.1 ξ.2.2.1))) =
      ((∫ r in (0:ℝ)..ξ.1, (f (pathPt B.h ξ r) - rhoP B (pathPt B.h ξ r) * cf ξ.2.1 ξ.2.2.1)) -
        chiM B (XC B.h ξ) *
          ∫ r in Set.Ioi (0:ℝ), (f (pathPt B.h ξ r) - rhoP B (pathPt B.h ξ r) * cf ξ.2.1 ξ.2.2.1)) +
      ((∫ r in (0:ℝ)..ξ.1, (g (pathPt B.h ξ r) - rhoP B (pathPt B.h ξ r) * cg ξ.2.1 ξ.2.2.1)) -
        chiM B (XC B.h ξ) *
          ∫ r in Set.Ioi (0:ℝ), (g (pathPt B.h ξ r) - rhoP B (pathPt B.h ξ r) * cg ξ.2.1 ξ.2.2.1))
    rw [eI, eO]
    ring
  exact ⟨P1, P2, P3, P4⟩

theorem temp_defect_identities_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState), B.ok → ContDiffOn ℝ ∞ (grP5 B G l0 S) (DomC B.h (qsOf l0)) → (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → grP5 B G l0 S ξ = 0) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (fun ξ => ubase B ξ a) (DomC B.h (qsOf l0))) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 S a) (DomC B.h (qsOf l0))) → (∀ a b : Fin 3, ContDiffOn ℝ ∞ (Wcov5 B G l0 S a b) (DomC B.h (qsOf l0))) → (∀ a : Fin 3, ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → mcor5 B G l0 S a ξ = 0) → (∀ a b : Fin 3, ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → Wcov5 B G l0 S a b ξ = 0) → ContDiffOn ℝ ∞ (dvT5 B G l0 S) (DomC B.h (qsOf l0)) → (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → dvT5 B G l0 S ξ = 0) → ContDiffOn ℝ ∞ (fun ξ => dR B.h (PsiT5 B G l0 S) ξ + PsiT5 B G l0 S ξ / ξ.1) (DomC B.h (qsOf l0)) → (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → dR B.h (PsiT5 B G l0 S) ξ + PsiT5 B G l0 S ξ / ξ.1 = 0) → ContDiffOn ℝ ∞ (fun ξ => grP5 B G l0 (tempState5 B G l0 S) ξ - grP5 B G l0 S ξ) (DomC B.h (qsOf l0)) → (∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → grP5 B G l0 (tempState5 B G l0 S) ξ - grP5 B G l0 S ξ = 0) → TMean5 B G l0 S → ∀ z t : ℝ, t < 1 → simScale B.h z (1 - t) < qsOf l0 → calP5 B G l0 (tempState5 B G l0 S) z t = calP5 B G l0 S z t + radMom (fun ξ => grP5 B G l0 (tempState5 B G l0 S) ξ - grP5 B G l0 S ξ) 0 z t ∧ calJth5 B G l0 (tempState5 B G l0 S) z t = calJth5 B G l0 S z t + radMom (fun η => ubase B η 2 * dvT5 B G l0 S η + ubase B η 1 * (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) + mcor5 B G l0 S 2 η * dvT5 B G l0 S η + (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) * mcor5 B G l0 S 1 η + (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) * dvT5 B G l0 S η) 2 z t ∧ calJz5 B G l0 (tempState5 B G l0 S) z t = calJz5 B G l0 S z t + radMom (fun η => 2 * ubase B η 2 * (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) + 2 * mcor5 B G l0 S 2 η * (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) + (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) ^ 2) 1 z t - (1/2) * radMom (fun ξ => grP5 B G l0 (tempState5 B G l0 S) ξ - grP5 B G l0 S ξ) 2 z t :=
by
  intro B G l0 S hok hgr hgv hub hmc hWc hmv hWv hdvs hdvv hΓs hΓv hDgs hDgv hMn z t ht hq
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqs0 : 0 < qsOf l0 := by rw [hQb]; positivity
  obtain ⟨hlin, hcongr, -, -⟩ := mom_moment_linear_v5 B (qsOf l0) hok hqs0

  have gadd : ∀ f g : Cyl → ℝ, MomGood5 B (qsOf l0) f → MomGood5 B (qsOf l0) g →
      MomGood5 B (qsOf l0) (fun η => f η + g η) := fun f g hf hg =>
    ⟨hf.1.add hg.1, fun ξ hξ hx => by simp [hf.2 ξ hξ hx, hg.2 ξ hξ hx]⟩
  have gmul : ∀ f g : Cyl → ℝ, ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) → MomGood5 B (qsOf l0) g →
      MomGood5 B (qsOf l0) (fun η => f η * g η) := fun f g hf hg =>
    ⟨hf.mul hg.1, fun ξ hξ hx => by simp [hg.2 ξ hξ hx]⟩
  have gpow : ∀ f : Cyl → ℝ, MomGood5 B (qsOf l0) f → MomGood5 B (qsOf l0) (fun η => f η ^ 2) :=
    fun f hf => ⟨hf.1.pow 2, fun ξ hξ hx => by simp [hf.2 ξ hξ hx]⟩

  have hgrG : MomGood5 B (qsOf l0) (grP5 B G l0 S) := ⟨hgr, hgv⟩
  have hDgG : MomGood5 B (qsOf l0)
      (fun ξ => grP5 B G l0 (tempState5 B G l0 S) ξ - grP5 B G l0 S ξ) := ⟨hDgs, hDgv⟩
  have hv : MomGood5 B (qsOf l0) (mcor5 B G l0 S 1) := ⟨hmc 1, hmv 1⟩
  have hγ : MomGood5 B (qsOf l0) (mcor5 B G l0 S 2) := ⟨hmc 2, hmv 2⟩
  have hW21 : MomGood5 B (qsOf l0) (Wcov5 B G l0 S 2 1) := ⟨hWc 2 1, hWv 2 1⟩
  have hW22 : MomGood5 B (qsOf l0) (Wcov5 B G l0 S 2 2) := ⟨hWc 2 2, hWv 2 2⟩
  have hdv : MomGood5 B (qsOf l0) (dvT5 B G l0 S) := ⟨hdvs, hdvv⟩
  have hΓ : MomGood5 B (qsOf l0)
      (fun ξ => dR B.h (PsiT5 B G l0 S) ξ + PsiT5 B G l0 S ξ / ξ.1) := ⟨hΓs, hΓv⟩

  have hJ0G : MomGood5 B (qsOf l0) (fun η => ubase B η 2 * mcor5 B G l0 S 1 η +
      ubase B η 1 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η * mcor5 B G l0 S 1 η +
      Wcov5 B G l0 S 2 1 η) :=
    gadd _ _ (gadd _ _ (gadd _ _ (gmul _ _ (hub 2) hv) (gmul _ _ (hub 1) hγ)) (gmul _ _ (hmc 2) hv)) hW21
  have hQthG : MomGood5 B (qsOf l0) (fun η => ubase B η 2 * dvT5 B G l0 S η + ubase B η 1 * (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) + mcor5 B G l0 S 2 η * dvT5 B G l0 S η + (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) * mcor5 B G l0 S 1 η + (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) * dvT5 B G l0 S η) :=
    gadd _ _ (gadd _ _ (gadd _ _ (gadd _ _ (gmul _ _ (hub 2) hdv) (gmul _ _ (hub 1) hΓ))
      (gmul _ _ (hmc 2) hdv)) (gmul _ _ hΓs hv)) (gmul _ _ hΓs hdv)
  have hK0G : MomGood5 B (qsOf l0) (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η +
      mcor5 B G l0 S 2 η ^ 2 + Wcov5 B G l0 S 2 2 η) :=
    gadd _ _ (gadd _ _ (gmul _ _ (contDiffOn_const.mul (hub 2)) hγ) (gpow _ hγ)) hW22
  have hQzG : MomGood5 B (qsOf l0) (fun η => 2 * ubase B η 2 * (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) + 2 * mcor5 B G l0 S 2 η * (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) + (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) ^ 2) :=
    gadd _ _ (gadd _ _ (gmul _ _ (contDiffOn_const.mul (hub 2)) hΓ)
      (gmul _ _ (contDiffOn_const.mul (hmc 2)) hΓ)) (gpow _ hΓ)

  have L2 : ∀ (f g : Cyl → ℝ) (e : ℕ), MomGood5 B (qsOf l0) f → MomGood5 B (qsOf l0) g →
      radMom (fun η => f η + g η) e z t = radMom f e z t + radMom g e z t := by
    intro f g e hf hg
    simpa using hlin f g 1 1 e z t hf hg ht hq

  have eg : ∀ e : ℕ, radMom (grP5 B G l0 (tempState5 B G l0 S)) e z t =
      radMom (grP5 B G l0 S) e z t +
        radMom (fun ξ => grP5 B G l0 (tempState5 B G l0 S) ξ - grP5 B G l0 S ξ) e z t := by
    intro e
    have h1 : radMom (grP5 B G l0 (tempState5 B G l0 S)) e z t = radMom (fun η =>
        grP5 B G l0 S η + (grP5 B G l0 (tempState5 B G l0 S) η - grP5 B G l0 S η)) e z t :=
      hcongr _ _ e z t (fun ξ _ => by ring) ht hq
    rw [h1]
    exact L2 _ _ e hgrG hDgG

  have I0 : calP5 B G l0 (tempState5 B G l0 S) z t = calP5 B G l0 S z t +
      radMom (fun ξ => grP5 B G l0 (tempState5 B G l0 S) ξ - grP5 B G l0 S ξ) 0 z t := eg 0

  have eJ : calJth5 B G l0 (tempState5 B G l0 S) z t = radMom (fun η =>
      (ubase B η 2 * mcor5 B G l0 S 1 η + ubase B η 1 * mcor5 B G l0 S 2 η +
        mcor5 B G l0 S 2 η * mcor5 B G l0 S 1 η + Wcov5 B G l0 S 2 1 η) +
      (ubase B η 2 * dvT5 B G l0 S η + ubase B η 1 * (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) + mcor5 B G l0 S 2 η * dvT5 B G l0 S η + (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) * mcor5 B G l0 S 1 η + (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) * dvT5 B G l0 S η)) 2 z t := by
    refine hcongr _ _ 2 z t (fun ξ hξ => ?_) ht hq
    obtain ⟨h1, h2, -, hW⟩ := hMn ξ hξ
    try dsimp only
    rw [h1, h2, hW]
    ring
  have sJ := L2 _ _ 2 hJ0G hQthG
  have hJth : calJth5 B G l0 S z t = radMom (fun η => ubase B η 2 * mcor5 B G l0 S 1 η +
      ubase B η 1 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η * mcor5 B G l0 S 1 η +
      Wcov5 B G l0 S 2 1 η) 2 z t := rfl

  have eK : calJz5 B G l0 (tempState5 B G l0 S) z t = radMom (fun η =>
      (2 * ubase B η 2 * mcor5 B G l0 S 2 η + mcor5 B G l0 S 2 η ^ 2 + Wcov5 B G l0 S 2 2 η) +
      (2 * ubase B η 2 * (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) + 2 * mcor5 B G l0 S 2 η * (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) + (dR B.h (PsiT5 B G l0 S) η + PsiT5 B G l0 S η / η.1) ^ 2)) 1 z t -
      (1/2) * radMom (grP5 B G l0 (tempState5 B G l0 S)) 2 z t := by
    unfold calJz5
    refine congrArg (fun x => x - (1/2) * radMom (grP5 B G l0 (tempState5 B G l0 S)) 2 z t)
      (hcongr _ _ 1 z t (fun ξ hξ => ?_) ht hq)
    obtain ⟨-, h2, -, hW⟩ := hMn ξ hξ
    try dsimp only
    rw [h2, hW]
    ring
  have sK := L2 _ _ 1 hK0G hQzG
  have hJz : calJz5 B G l0 S z t = radMom (fun η => 2 * ubase B η 2 * mcor5 B G l0 S 2 η +
      mcor5 B G l0 S 2 η ^ 2 + Wcov5 B G l0 S 2 2 η) 1 z t -
      (1/2) * radMom (grP5 B G l0 S) 2 z t := rfl
  have e2 := eg 2
  refine ⟨I0, ?_, ?_⟩
  · rw [eJ, sJ, ← hJth]
