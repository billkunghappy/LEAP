        have h1 := hCb n γ m ξ hξ hX1 hX2
        have h2 := hCb n γ (-m) ξ hξ hX1 hX2
        have hR : 0 ≤ qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ (bb n) *
            Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(db n)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) :=
          mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (Real.rpow_nonneg hq.le _) (Real.rpow_nonneg hS0 _))
            (Real.sqrt_nonneg _)) (Real.rpow_nonneg he0.le _)) hP0
        have h3 : Cb n * qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ (bb n) *
            Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(db n)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) ≤
            |Cb n| * (qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ (bb n) *
            Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(db n)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) := by
          have e : Cb n * qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ (bb n) *
              Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
              edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(db n)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) =
              Cb n * (qC B.h ξ ^ (B.h * β) * SC B.h ξ ^ (bb n) *
              Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) *
              edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(db n)) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) := by
            ring
