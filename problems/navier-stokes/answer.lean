theorem wmo_mode_amp_v5 : ∀ (B : BG) (G : CorrGeom) (c : WC) (γ : Lab) (m : ℤ) (ξ : Cyl), B.ok → 0 < ξ.1 → ξ.2.2.1 < 1 → (∀ i : Fin 3, dR B.h (fun η => modeCoef5 B G c γ m η i) ξ = (dR B.h (fun η => c γ m η i) ξ + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) * ((dR B.h (phiL5 B G γ) ξ : ℝ) : ℂ) * c γ m ξ i) * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)))) → (∀ i : Fin 3, dZ (fun η => modeCoef5 B G c γ m η i) ξ = (dZ (fun η => c γ m η i) ξ + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) * ((dZ (phiL5 B G γ) ξ : ℝ) : ℂ) * c γ m ξ i) * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)))) → ∀ i : Fin 3, ((qC B.h ξ ^ (1/2 - Aex B.h) : ℝ) : ℂ) * axV5 B.h (1/2 - Aex B.h) (m * pint5 B G γ) (modeCoef5 B G c γ m) ξ i = ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * (wmoAmp5 B G c γ m ξ i * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)))) :=
by
  intro B G c γ m ξ hok hr ht hR hZ i
  have hq : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hQb : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have hs : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr hQb
  have hkb : 0 < kb B.h γ.1 := by
    unfold kb
    exact Nat.ceil_pos.mpr (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos hQb _) _)
  have f1 : (qC B.h ξ / Qb γ.1) ^ (1/2:ℝ) = qC B.h ξ ^ (1/2:ℝ) / Real.sqrt (Qb γ.1) := by
    rw [Real.div_rpow hq.le hQb.le, Real.sqrt_eq_rpow]
