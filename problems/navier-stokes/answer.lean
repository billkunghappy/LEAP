    have hF : Fn X η ≠ 0 := (hA3 X η hX1.le hX2 (by linarith) (by linarith)).ne'
    unfold leadStressTh at h1
    unfold axTz at h2
    rcases mul_eq_zero.mp h1 with hh | hh
    · exact absurd hh hF
    rcases mul_eq_zero.mp h2 with hh' | hh'
    · exact absurd hh' hF
    constructor
    · unfold psLead1; linarith
    · linarith

  obtain ⟨hDFc, -, hDF⟩ := hs1 Fn hA1
  obtain ⟨hDUc, -, hDU⟩ := hs1 Un hA2
  have hFc : ContinuousOn (fun z : ℝ × ℝ => Fn z.1 z.2) O := hA1.continuousOn
  have hFposK : ∀ z ∈ Kb, 0 < Fn z.1 z.2 := fun z hz => by
    obtain ⟨a1, a2, a3, a4⟩ := hKfacts z hz
    exact hA3 _ _ a1.le a2 a3 a4
  have hShA_eq : ∀ z ∈ O,
      shearA Fn z.1 z.2 = -2 * z.1 * fderiv ℝ (↿Fn) z (1, 0) / Fn z.1 z.2 := by
    intro z hz; unfold shearA; rw [(hDF z hz).1.deriv]
  have hShB_eq : ∀ z ∈ O,
      shearB Fn Un z.1 z.2 = Real.sqrt (2 * z.1) * fderiv ℝ (↿Un) z (1, 0) / Fn z.1 z.2 := by
    intro z hz; unfold shearB; rw [(hDU z hz).1.deriv]
  have hShAc : ContinuousOn (fun z : ℝ × ℝ => shearA Fn z.1 z.2) Kb := by
    refine ContinuousOn.congr ?_ (fun z hz => hShA_eq z (hKO hz))
    exact ((continuousOn_const.mul continuousOn_fst).mul (hDFc.mono hKO)).div (hFc.mono hKO)
      (fun z hz => (hFposK z hz).ne')
  have hShBc : ContinuousOn (fun z : ℝ × ℝ => shearB Fn Un z.1 z.2) Kb := by
    refine ContinuousOn.congr ?_ (fun z hz => hShB_eq z (hKO hz))
    have hsq : ContinuousOn (fun z : ℝ × ℝ => Real.sqrt (2 * z.1)) Kb :=
      (by fun_prop : Continuous fun z : ℝ × ℝ => Real.sqrt (2 * z.1)).continuousOn
    exact (hsq.mul (hDUc.mono hKO)).div (hFc.mono hKO) (fun z hz => (hFposK z hz).ne')

  have hBd : ∀ X η0, X ∈ Icc (4 / Λ) Xm → (η0 = 1 ∨ η0 = -1) →
      shearA Fn X η0 = psLead1 h Fn Un X η0 := by
    intro X η0 hX hη0
    have hXpos : 0 < X := lt_of_lt_of_le hX0 hX.1
    have hX41 : X ≤ 41 / (10 * Λ) := by linarith [hX.2]
    have hη0a : -1 - ρ1 < η0 := by rcases hη0 with hh | hh <;> rw [hh] <;> linarith
    have hη0b : η0 < 1 + ρ1 := by rcases hη0 with hh | hh <;> rw [hh] <;> linarith
    have hη0I : η0 ∈ Icc (-1 : ℝ) 1 := by rcases hη0 with hh | hh <;> rw [hh] <;> norm_num
    have hXO : (X, η0) ∈ O := ⟨⟨by linarith, by linarith [hX.2]⟩, hη0a, hη0b⟩
    have hP : 0 < psLead1 h Fn Un X η0 := (hA6 X η0 hXpos hX41 hη0a hη0b).2.2.2.2.2.2.2
    have hL : 1 - 2 * h * η0 ^ 2 ≠ 0 := by
      intro h0; unfold psLead1 at hP; rw [h0, div_zero] at hP; exact lt_irrefl _ hP
    have hFX : Fn X η0 ≠ 0 := (hA3 X η0 hXpos.le hX41 hη0a hη0b).ne'
    have hcF : ContinuousAt (fun e => Fn X e) η0 :=
      (hFc.continuousAt (hO.mem_nhds hXO)).comp (continuous_const.prodMk continuous_id).continuousAt
    have hX5 : X < 5 / Λ := by linarith [hX.2]
    have hg2 : ContDiffOn ℝ ∞ (↿(fun x e => 2 * x * Fn x e)) O := by
      show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 2 * p.1 * Fn p.1 p.2) O
