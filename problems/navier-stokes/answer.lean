  have hy5Y : rfpY5 P.Md P.lam ≤ Y := by rw [hY]; exact le_max_right _ _
  have h2a : (-2 : ℝ) < η := by linarith
  have h2b : η < 2 := by linarith
  have hEc : ∀ e : ℝ, -2 < e → e < 2 → Continuous (fun v => rfpE P v e) := fun e h1 h2 =>
    (rfp_joint_smooth P hReg hClos).1.continuousOn.comp_continuous
      (continuous_id.prodMk continuous_const) (fun v => ⟨mem_univ _, h1, h2⟩)
  obtain ⟨⟨hy4one, hy45, -⟩, -, hcl3, -, -⟩ := rfp_clamp_identities P hReg
  have hEexp : ∀ v e : ℝ, rfpY5 P.Md P.lam ≤ v → rfpE P v e = Real.exp (rfpLam P v) := by
    intro v e hv
    unfold rfpE
    rw [mul_assoc, hcl3 v e hv, mul_one]
  obtain ⟨B, hB⟩ := (rfp_lam_tail_envelope P hReg).2

  have hsplit : ∀ (w : ℝ → ℝ) (e : ℝ), Continuous w → (∀ v : ℝ, 0 ≤ v → |w v| ≤ Real.exp v) →
