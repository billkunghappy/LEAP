  have hQ2 : (3 / 10 * η ^ 2 + b / 10) ^ 2 ≤ Q ^ 2 := pow_le_pow_left₀ hT0 hQT 2
  have hE2 : (Pst * a / 2) ^ 2 ≤ E ^ 2 := pow_le_pow_left₀ hEa.le h7 2
