        rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
      have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
      have h0s : (0 : Cyl) ∈ s := by
        rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
      have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
      have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
      have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + z)) s := by
        intro W _ _ F hF
        exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
          (fun z hz => by rw [hs_def] at hz; exact hz)
      have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
        intro W _ _ F hF
        exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
      have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
          ContDiffOn ℝ n F U → ∀ i : ℕ, i ≤ n →
          iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
            (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
        intro W _ _ F hF i hi
        have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
        have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
          hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
        have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
        have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
        calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
            = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
          _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
                (fun _ => L) := e2
          _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
                (fun _ => L) := by rw [map_zero]
          _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
                (fun _ => L) := by rw [e3]
          _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
      have hfg : ContDiffOn ℝ n (fun η => f η • g η) U := hf.smul hg
      have hl := norm_iteratedFDerivWithin_smul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
        (n := n) le_rfl
      rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) • g (ξ + L y)) n hO h0O] at hl
      rw [← key _ hfg n le_rfl]
      calc ‖iteratedFDeriv ℝ n (fun z => (fun η => f η • g η) (ξ + L z)) 0‖
          = ‖iteratedFDeriv ℝ n (fun y => f (ξ + L y) • g (ξ + L y)) 0‖ := rfl
        _ ≤ _ := hl
        _ = _ := by
          apply Finset.sum_congr rfl
          intro i hi
          have hik : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
            iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (n - i) hO h0O,
            key f hf i hik, key g hg (n - i) (Nat.sub_le n i)]
    have hA0 : 0 ≤ A := le_trans (hNBnn a 0) (hA 0 (Nat.zero_le k))
    have hE0 : 0 ≤ E := le_trans (hNBnn b 0) (hE 0 (Nat.zero_le k))
    have ha' : ContDiffAt ℝ k a ξ := ha.of_le (by exact_mod_cast le_top)
    have hb' : ContDiffAt ℝ k b ξ := hb.of_le (by exact_mod_cast le_top)
    obtain ⟨ua, hua, hau⟩ := ha'.contDiffOn le_rfl (by simp)
    obtain ⟨ub, hub, hbu⟩ := hb'.contDiffOn le_rfl (by simp)
    obtain ⟨O, hOsub, hOopen, hξO⟩ := mem_nhds_iff.mp (Filter.inter_mem hua hub)
    have haO : ContDiffOn ℝ k a O := hau.mono (fun x hx => (hOsub hx).1)
    have hbO : ContDiffOn ℝ k b O := hbu.mono (fun x hx => (hOsub hx).2)
    have l1 := leib O k hOopen hξO a b haO hbO
    have l1' : NB h (fun η => a η * b η) k ξ ≤ ∑ i ∈ Finset.range (k + 1),
        (k.choose i : ℝ) * NB h a i ξ * NB h b (k - i) ξ := l1
    refine le_trans l1' ?_
    calc ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB h a i ξ * NB h b (k - i) ξ
        ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * A * E := by
          apply Finset.sum_le_sum
          intro i hi
          have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          exact mul_le_mul (mul_le_mul_of_nonneg_left (hA i hik) (Nat.cast_nonneg _))
            (hE _ (Nat.sub_le k i)) (hNBnn _ _) (mul_nonneg (Nat.cast_nonneg _) hA0)
      _ = A * E * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) := by
          rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro i _; ring
      _ = 2 ^ k * A * E := by
          have hs : ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) = 2 ^ k := by
            exact_mod_cast Nat.sum_range_choose k
          rw [hs]; ring
  have nbaff : ∀ (h : ℝ) (ψ : ℝ → ℝ) (lam : Cyl →L[ℝ] ℝ) (d : ℝ) (ξ : Cyl) (n : ℕ) (K c : ℝ),
      ContDiff ℝ ∞ ψ → (∀ x : ℝ, ‖iteratedFDeriv ℝ n ψ x‖ ≤ K) → 0 ≤ c →
      (∀ w : Cyl, |lam (Lnorm h ξ w)| ≤ c * ‖w‖) → NB h (fun η : Cyl => ψ (lam η + d)) n ξ ≤ K * c ^ n := by
    intro h ψ lam d ξ n K c hψ hK hc hlam
    have hg : ContDiff ℝ ∞ (fun y : ℝ => ψ (y + d)) := hψ.comp (contDiff_id.add contDiff_const)
    have hfun : (fun η : Cyl => ψ (lam η + d)) = (fun y : ℝ => ψ (y + d)) ∘ ⇑lam := rfl
    have h2 : iteratedFDeriv ℝ n (fun η : Cyl => ψ (lam η + d)) ξ =
        (iteratedFDeriv ℝ n (fun y : ℝ => ψ (y + d)) (lam ξ)).compContinuousLinearMap
          (fun _ => lam) := by
      rw [hfun]
      exact lam.iteratedFDeriv_comp_right hg ξ (by exact_mod_cast le_top)
    have h3 : iteratedFDeriv ℝ n (fun y : ℝ => ψ (y + d)) (lam ξ) =
        iteratedFDeriv ℝ n ψ (lam ξ + d) := iteratedFDeriv_comp_add_right n d (lam ξ)
    set M := iteratedFDeriv ℝ n ψ (lam ξ + d) with hM
    set T : Cyl →L[ℝ] ℝ := lam.comp (Lnorm h ξ) with hT
    have e : (M.compContinuousLinearMap (fun _ => lam)).compContinuousLinearMap
        (fun _ => Lnorm h ξ) = M.compContinuousLinearMap (fun _ => T) := by
      ext v
      rfl
    have h4 : NB h (fun η : Cyl => ψ (lam η + d)) n ξ =
        ‖M.compContinuousLinearMap (fun _ => T)‖ := by
      unfold NB
      rw [h2, h3, e]
    have h5 : ‖M.compContinuousLinearMap (fun _ => T)‖ ≤ ‖M‖ * ∏ _i : Fin n, ‖T‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    have h6 : ‖T‖ ≤ c := by
      refine ContinuousLinearMap.opNorm_le_bound _ hc (fun w => ?_)
      rw [hT, ContinuousLinearMap.comp_apply, Real.norm_eq_abs]
      exact hlam w
    have hprod : ∏ _i : Fin n, ‖T‖ = ‖T‖ ^ n := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    have hpow : ‖T‖ ^ n ≤ c ^ n := pow_le_pow_left₀ (norm_nonneg _) h6 n
    have hMK : ‖M‖ ≤ K := hK _
    rw [h4]
    refine h5.trans ?_
    rw [hprod]
    exact mul_le_mul hMK hpow (pow_nonneg (norm_nonneg _) n) ((norm_nonneg _).trans hMK)
  obtain ⟨lb, hband⟩ := band_gap B.h hh hh1
  choose Cq hCq using tnq B.h hh hh1 hS

  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ℝ → ℝ, Θ = fun x => Real.smoothTransition (5/2 - 15/(4*G.r0) * |x|) :=
    ⟨_, rfl⟩
  have hΘ1 : ∀ x : ℝ, |x| < 2*G.r0/5 → Θ x = 1 := by
    intro x hx
    rw [hΘ]
    apply Real.smoothTransition.one_of_one_le
    have : 15/(4*G.r0) * |x| < 3/2 := by
      rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]; linarith
    linarith
  have hΘ0 : ∀ x : ℝ, 2*G.r0/3 ≤ |x| → Θ x = 0 := by
    intro x hx
    rw [hΘ]
    apply Real.smoothTransition.zero_of_nonpos
    have : 5/2 ≤ 15/(4*G.r0) * |x| := by
      rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]; linarith
    linarith
  have hΘs : ContDiff ℝ ∞ Θ := by
    rw [contDiff_iff_contDiffAt]
    intro x
    by_cases hx : |x| < 2*G.r0/5
    · have hev : Θ =ᶠ[nhds x] fun _ => (1:ℝ) :=
        Filter.eventuallyEq_of_mem ((isOpen_lt continuous_abs continuous_const).mem_nhds hx)
          (fun y hy => hΘ1 y hy)
      exact contDiffAt_const.congr_of_eventuallyEq hev
    · have hx0 : x ≠ 0 := by
        rintro rfl; apply hx; rw [abs_zero]; positivity
      rw [hΘ]
      have ha : ContDiffAt ℝ ∞ (fun y : ℝ => 5/2 - 15/(4*G.r0) * |y|) x :=
        contDiffAt_const.sub (contDiffAt_const.mul (contDiffAt_abs hx0))
      exact (Real.smoothTransition.contDiff (n := ⊤)).comp_contDiffAt x ha
  have hΘK : ∀ n : ℕ, ∃ K : ℝ, ∀ x : ℝ, ‖iteratedFDeriv ℝ n Θ x‖ ≤ K := by
    intro n
    have hcs : HasCompactSupport Θ :=
      HasCompactSupport.intro (isCompact_closedBall (0:ℝ) (2*G.r0/3)) (fun x hx => by
        apply hΘ0
        rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs, not_le] at hx
        exact hx.le)
    exact (hΘs.continuous_iteratedFDeriv (by exact_mod_cast le_top)).bounded_above_of_compact_support
      (hcs.iteratedFDeriv n)
  choose K hK using hΘK

  have hs : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
  have hs2 : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
  have hT1 : (1:ℝ) < Tgc := by unfold Tgc; linarith
  have hT0 : (0:ℝ) < Tgc := by linarith
  have hL : Lgc ≠ 0 := by unfold Lgc; intro h0; linarith
  have hT : Tgc ≠ 0 := hT0.ne'
  have hbgc : 0 ≤ bgc ∧ bgc < 1/2 := by
    unfold bgc
    constructor <;> nlinarith
  have hDen : (1 + bgc ^ 2) ≠ 0 := by positivity
  have hDpos : (0:ℝ) < 1 + bgc ^ 2 := by positivity
  have c1 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).1 = Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) * bgc := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have c2 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).2 = -(Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) * bgc) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have hcomp : ∀ (m n : ℤ) (Y : ℝ × ℝ), Jpow m (Jpow n Y) = Jpow (m + n) Y := by
    intro m n Y
    refine Prod.ext ?_ ?_
    · rw [c1 m, c1 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
      field_simp
      ring
    · rw [c2 m, c2 (m + n), c1 n, c2 n, zpow_add₀ hL, zpow_add₀ hT]
      field_simp
      ring
  have hid : ∀ Y : ℝ × ℝ, Jpow 0 Y = Y := by
    intro Y
    refine Prod.ext ?_ ?_
    · rw [c1, zpow_zero, zpow_zero]
      field_simp
      ring
    · rw [c2, zpow_zero, zpow_zero]
      field_simp
      ring
  have hNinv : ∀ x : ℝ, x / (1 + bgc ^ 2) = x * (2 + Real.sqrt 2) / 4 := by
    intro x
    rw [div_eq_div_iff hDen (by norm_num)]
    unfold bgc
    linear_combination (-x * Real.sqrt 2) * hs
  have hJ1 : ∀ Y : ℝ × ℝ, Jpow 1 Y = (3 * Y.1 + Y.2, Y.1 + 5 * Y.2) := by
    intro Y
    refine Prod.ext ?_ ?_
    · rw [c1, zpow_one, zpow_one, hNinv, hNinv]
      unfold Lgc Tgc bgc
      linear_combination ((Real.sqrt 2 ^ 2 + 4 * Real.sqrt 2 - 2) * Y.1 + 2 * (Real.sqrt 2 + 1) * Y.2) / 4 * hs
    · rw [c2, zpow_one, zpow_one, hNinv, hNinv]
      unfold Lgc Tgc bgc
      linear_combination (2 * (Real.sqrt 2 + 1) * Y.1 - (Real.sqrt 2 ^ 2 - 4 * Real.sqrt 2 - 2) * Y.2) / 4 * hs
  have hint : ∀ k : ℕ, ∀ i j : ℤ, ∃ i' j' : ℤ,
      Jpow (k : ℤ) ((i : ℝ), (j : ℝ)) = ((i' : ℝ), (j' : ℝ)) := by
    intro k
    induction k with
    | zero => intro i j; exact ⟨i, j, by rw [Nat.cast_zero, hid]⟩
    | succ k ih =>
      intro i j
      obtain ⟨i', j', h'⟩ := ih i j
      refine ⟨3 * i' + j', i' + 5 * j', ?_⟩
      have e : ((k + 1 : ℕ) : ℤ) = 1 + (k : ℤ) := by push_cast; ring
      rw [e, ← hcomp 1 k, h', hJ1]
      push_cast
      rfl
  have hJadd : ∀ (n : ℤ) (Y W : ℝ × ℝ), Jpow n (Y + W) = Jpow n Y + Jpow n W := by
    intro n Y W
    refine Prod.ext ?_ ?_
    · rw [Prod.fst_add, c1 n (Y + W), c1 n Y, c1 n W, Prod.fst_add, Prod.snd_add]
      ring
    · rw [Prod.snd_add, c2 n (Y + W), c2 n Y, c2 n W, Prod.fst_add, Prod.snd_add]
      ring
  have hfrI : ∀ (y : ℝ × ℝ) (a b : ℤ), frac0 (y + ((a : ℝ), (b : ℝ))) = frac0 y := by
    intro y a b
    have e1 : (y + ((a : ℝ), (b : ℝ))).1 = y.1 + (a : ℝ) := rfl
    have e2 : (y + ((a : ℝ), (b : ℝ))).2 = y.2 + (b : ℝ) := rfl
    unfold frac0
    rw [e1, e2, round_add_intCast, round_add_intCast]
    refine Prod.ext ?_ ?_
    · show y.1 + (a : ℝ) - (((round y.1 + a : ℤ)) : ℝ) = y.1 - ((round y.1 : ℤ) : ℝ)
      push_cast
      ring
    · show y.2 + (b : ℝ) - (((round y.2 + b : ℤ)) : ℝ) = y.2 - ((round y.2 : ℤ) : ℝ)
      push_cast
      ring
  have hlin : ∀ (n : ℤ) (y : ℝ × ℝ), lamT (Jpow n y) = Tgc ^ n * lamT y := by
    intro n y
    unfold lamT Jpow vrv vtv
    simp only [Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    rw [div_eq_iff hDen]
    ring
  have hTsub : ∀ u v : ℝ × ℝ, lamT (u - v) = lamT u - lamT v := by
    intro u v; unfold lamT; simp only [Prod.fst_sub, Prod.snd_sub]; ring
  have hTadd : ∀ u v : ℝ × ℝ, lamT (u + v) = lamT u + lamT v := by
    intro u v; unfold lamT; simp only [Prod.fst_add, Prod.snd_add]; ring
  have hTsm : ∀ (s : ℝ) (u : ℝ × ℝ), lamT (s • u) = s * lamT u := by
    intro s u; unfold lamT; simp only [Prod.smul_fst, Prod.smul_snd, smul_eq_mul]; ring
  have hJL : ∀ (N : ℤ) (y : ℝ × ℝ), lamT (JpowL N y) = Tgc ^ N * lamT y := by
    intro N y
    have e : JpowL N y = y.1 • Jpow N (1, 0) + y.2 • Jpow N (0, 1) := by
      simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
        ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd']
    rw [e, hTadd, hTsm, hTsm, hlin, hlin]
    unfold lamT
    dsimp only
    ring
  have hlamb : ∀ y : ℝ × ℝ, |lamT y| ≤ 3/2 * ‖y‖ := by
    intro y
    have h1 : |y.1| ≤ ‖y‖ := by rw [← Real.norm_eq_abs]; exact norm_fst_le y
    have h2 : |y.2| ≤ ‖y‖ := by rw [← Real.norm_eq_abs]; exact norm_snd_le y
    have hD1 : 1 ≤ 1 + bgc ^ 2 := by nlinarith [sq_nonneg bgc]
    unfold lamT
    rw [abs_div, abs_of_pos hDpos, div_le_iff₀ hDpos]
    have h3 : |bgc * y.1 + y.2| ≤ bgc * |y.1| + |y.2| := by
      calc |bgc * y.1 + y.2| ≤ |bgc * y.1| + |y.2| := abs_add_le _ _
        _ = bgc * |y.1| + |y.2| := by rw [abs_mul, abs_of_nonneg hbgc.1]
    have h4 : bgc * |y.1| ≤ 1/2 * ‖y‖ := mul_le_mul hbgc.2.le h1 (abs_nonneg _) (by norm_num)
    have h5 : 3/2 * ‖y‖ ≤ 3/2 * ‖y‖ * (1 + bgc ^ 2) :=
      le_mul_of_one_le_right (by positivity) hD1
    linarith

  have hcibpos : ∀ l : ℕ, 0 < cib B.h l := by
    intro l
    unfold cib
    exact mul_pos (zpow_pos hT0 _) (Real.rpow_pos_of_pos (by unfold Qb; exact Real.rpow_pos_of_pos two_pos _) _)
  have hpsi : ∀ (γ : Lab) (η : Cyl), psiW B G γ η = Θ (etG B.h γ (G.ctr γ) η.2.2.2) := by
    intro γ η
    have hκ := hcibpos γ.1
    unfold psiW psiT Lsb vco
    rw [hΘ]
    dsimp only
    congr 1
    generalize etG B.h γ (G.ctr γ) η.2.2.2 = e
    generalize cib B.h γ.1 = κ at hκ
    have e1 : (e + G.r0) / κ - 2 * G.r0 / κ / 2 = e / κ := by field_simp; ring
    rw [e1, abs_div, abs_of_pos hκ]
    field_simp
    ring

  have hNBnn : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (i : ℕ) (ξ : Cyl),
      0 ≤ NB B.h f i ξ := fun f i ξ => norm_nonneg _
  have hNBev : ∀ (f g : Cyl → ℝ) (i : ℕ) (ξ : Cyl), f =ᶠ[nhds ξ] g → NB B.h f i ξ = NB B.h g i ξ := by
    intro f g i ξ hfg
    unfold NB
    rw [(hfg.iteratedFDeriv ℝ i).eq_of_nhds]
  have hNBsmul : ∀ (a : ℝ) (f : Cyl → ℝ) (i : ℕ) (ξ : Cyl), ContDiffAt ℝ ∞ f ξ →
      NB B.h (fun η => a * f η) i ξ = |a| * NB B.h f i ξ := by
    intro a f i ξ hf
    have e : (fun η => a * f η) = a • f := by funext η; rfl
    unfold NB
    rw [e, iteratedFDeriv_const_smul_apply (hf.of_le (by exact_mod_cast le_top))]
    have e2 : (a • iteratedFDeriv ℝ i f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
        a • (iteratedFDeriv ℝ i f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2, norm_smul, Real.norm_eq_abs]
  have hcast : ∀ (f : Cyl → ℝ) (ξ : Cyl), ContDiffAt ℝ ∞ f ξ →
      ContDiffAt ℝ ∞ (fun η => ((f η : ℝ) : ℂ)) ξ ∧
      ∀ i : ℕ, NB B.h (fun η => ((f η : ℝ) : ℂ)) i ξ ≤ NB B.h f i ξ := by
    intro f ξ hf
    have e : (fun η => ((f η : ℝ) : ℂ)) = ⇑Complex.ofRealCLM ∘ f := by
      funext η; simp [Complex.ofRealCLM_apply]
    refine ⟨?_, fun i => ?_⟩
    · rw [e]; exact Complex.ofRealCLM.contDiff.comp_contDiffAt ξ hf
    · unfold NB
      rw [e, ContinuousLinearMap.iteratedFDeriv_comp_left _ hf (by exact_mod_cast le_top)]
      have e2 : (Complex.ofRealCLM.compContinuousMultilinearMap (iteratedFDeriv ℝ i f ξ)).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) = Complex.ofRealCLM.compContinuousMultilinearMap
          ((iteratedFDeriv ℝ i f ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
        ext m; rfl
      rw [e2]
      refine (ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _).trans ?_
      rw [Complex.ofRealCLM_norm, one_mul]

  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqpos : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h' =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hUt : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
  have hQbpos : ∀ l : ℕ, 0 < Qb l := fun l => by unfold Qb; exact Real.rpow_pos_of_pos two_pos _

  obtain ⟨Mρ, hMρ⟩ : ∃ Mρ : ℝ → ℕ → ℝ, Mρ = fun p k =>
      ∑ j ∈ Finset.range (k + 1), |Cq p j| * ((4:ℝ) ^ p + (1/4:ℝ) ^ p) := ⟨_, rfl⟩
  have hMρ0 : ∀ p k, 0 ≤ Mρ p k := by
    intro p k; rw [hMρ]
    exact Finset.sum_nonneg (fun j _ => mul_nonneg (abs_nonneg _)
      (add_pos (Real.rpow_pos_of_pos (by norm_num) _) (Real.rpow_pos_of_pos (by norm_num) _)).le)
  have hrho : ∀ (p : ℝ) (k : ℕ) (γ : Lab) (ξ : Cyl), ξ.2.2.1 < 1 → qC B.h ξ ≤ 1 →
      1/4 < rhoQ B γ ξ → rhoQ B γ ξ < 4 →
      ContDiffAt ℝ ∞ (fun η => rhoQ B γ η ^ p) ξ ∧
      ∀ i : ℕ, i ≤ k → NB B.h (fun η => rhoQ B γ η ^ p) i ξ ≤ Mρ p k := by
    intro p k γ ξ ht hq1 hr1 hr2
    have hQ := hQbpos γ.1
    have hq0 := hqpos ξ ht
    have hqCat : ContDiffAt ℝ ∞ (fun η : Cyl => qC B.h η) ξ := hqC.contDiffAt (hUt.mem_nhds ht)
    have hρs : ContDiffAt ℝ ∞ (fun η => rhoQ B γ η) ξ := by
      unfold rhoQ; exact hqCat.div_const _
    have hqp : ContDiffAt ℝ ∞ (fun η => qC B.h η ^ p) ξ := hqCat.rpow_const_of_ne hq0.ne'
    refine ⟨hρs.rpow_const_of_ne (by linarith), fun i hi => ?_⟩
    have hev : (fun η => rhoQ B γ η ^ p) =ᶠ[nhds ξ] (fun η => (Qb γ.1 ^ p)⁻¹ * qC B.h η ^ p) :=
      Filter.eventuallyEq_of_mem (hUt.mem_nhds ht) (fun η hη => by
        show (qC B.h η / Qb γ.1) ^ p = _
        rw [Real.div_rpow (hqpos η hη).le hQ.le, div_eq_inv_mul])
    have hQp : 0 < (Qb γ.1 ^ p)⁻¹ := inv_pos.mpr (Real.rpow_pos_of_pos hQ _)
    have hval : rhoQ B γ ξ ^ p = (Qb γ.1 ^ p)⁻¹ * qC B.h ξ ^ p := hev.eq_of_nhds
    have hBp : rhoQ B γ ξ ^ p ≤ (4:ℝ) ^ p + (1/4:ℝ) ^ p := by
      have p4 : 0 < (4:ℝ) ^ p := Real.rpow_pos_of_pos (by norm_num) _
      have p14 : 0 < (1/4:ℝ) ^ p := Real.rpow_pos_of_pos (by norm_num) _
      rcases le_or_gt 0 p with hp | hp
      · have := Real.rpow_le_rpow (by linarith) hr2.le hp; linarith
      · have := Real.rpow_le_rpow_of_nonpos (by norm_num) hr1.le hp.le; linarith
    have hC := hCq p i ξ ht hq1
    have hqpn : 0 ≤ qC B.h ξ ^ p := Real.rpow_nonneg hq0.le _
    rw [hNBev _ _ i ξ hev, hNBsmul _ _ i ξ hqp, abs_of_pos hQp]
    calc (Qb γ.1 ^ p)⁻¹ * NB B.h (fun η => qC B.h η ^ p) i ξ
        ≤ (Qb γ.1 ^ p)⁻¹ * (|Cq p i| * qC B.h ξ ^ p) :=
          mul_le_mul_of_nonneg_left (hC.trans (mul_le_mul_of_nonneg_right (le_abs_self _) hqpn)) hQp.le
      _ = |Cq p i| * rhoQ B γ ξ ^ p := by rw [hval]; ring
      _ ≤ |Cq p i| * ((4:ℝ) ^ p + (1/4:ℝ) ^ p) := mul_le_mul_of_nonneg_left hBp (abs_nonneg _)
      _ ≤ Mρ p k := by
          rw [hMρ]
          exact Finset.single_le_sum (f := fun j => |Cq p j| * ((4:ℝ) ^ p + (1/4:ℝ) ^ p))
            (fun j _ => mul_nonneg (abs_nonneg _)
              (add_pos (Real.rpow_pos_of_pos (by norm_num) _) (Real.rpow_pos_of_pos (by norm_num) _)).le)
            (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))

  obtain ⟨Mψ, hMψ⟩ : ∃ Mψ : ℕ → ℝ, Mψ = fun k =>
      ∑ j ∈ Finset.range (k + 1), |K j| * (2 * Tgc ^ 3) ^ j := ⟨_, rfl⟩
  have hMψ0 : ∀ k, 0 ≤ Mψ k := by
    intro k; rw [hMψ]
    exact Finset.sum_nonneg (fun j _ => mul_nonneg (abs_nonneg _) (by positivity))
  have hpsiA : ∀ (k l0 : ℕ), lb ≤ l0 → ∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0),
      1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 →
      |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 →
      ContDiffAt ℝ ∞ (psiW B G γ) ξ ∧ (∀ i : ℕ, i ≤ k → NB B.h (psiW B G γ) i ξ ≤ Mψ k) ∧
      ∀ c : ℝ × ℝ, IsDeck B.h (qC B.h ξ) c → psiW B G γ (shY ξ c) = psiW B G γ ξ := by
    intro k l0 hl0 γ ξ hξ hq1 hq2 hxi het
    have hξ' := hξ
    obtain ⟨-, hξt, hξq⟩ := hξ'
    have hq0 : 0 < qC B.h ξ := hqpos ξ hξt
    obtain ⟨hciN, hgap⟩ := hband γ.1 l0 (qC B.h ξ) hl0 hq0 hξq hq1 hq2

    obtain ⟨w, hw⟩ : ∃ w : ℝ × ℝ, w = rectW B.h γ (G.ctr γ) ξ.2.2.2 := ⟨_, rfl⟩
    have hxiw : |lamR w| < 1/8 := by rw [hw]; exact hxi
    have hetw : |lamT w| < 1/8 := by rw [hw]; exact het
    have hinv1 : w.1 = lamR w + bgc * lamT w := by
      have e : lamR w + bgc * lamT w = (w.1 - bgc * w.2 + bgc * (bgc * w.1 + w.2)) / (1 + bgc ^ 2) := by
        unfold lamR lamT; ring
      rw [e, eq_div_iff hDen]
      ring
    have hinv2 : w.2 = lamT w - bgc * lamR w := by
      have e : lamT w - bgc * lamR w = (bgc * w.1 + w.2 - bgc * (w.1 - bgc * w.2)) / (1 + bgc ^ 2) := by
        unfold lamR lamT; ring
      rw [e, eq_div_iff hDen]
      ring
    have hb1 : bgc * |lamT w| ≤ 1/16 := by
      calc bgc * |lamT w| ≤ (1/2) * (1/8) := mul_le_mul hbgc.2.le hetw.le (abs_nonneg _) (by norm_num)
        _ = 1/16 := by norm_num
    have hb2 : bgc * |lamR w| ≤ 1/16 := by
      calc bgc * |lamR w| ≤ (1/2) * (1/8) := mul_le_mul hbgc.2.le hxiw.le (abs_nonneg _) (by norm_num)
        _ = 1/16 := by norm_num
    have hb1' : |bgc * lamT w| ≤ 1/16 := by rw [abs_mul, abs_of_nonneg hbgc.1]; exact hb1
    have hb2' : |bgc * lamR w| ≤ 1/16 := by rw [abs_mul, abs_of_nonneg hbgc.1]; exact hb2
    have hw1 : |w.1| < 1/2 := by
      rw [hinv1]
      obtain ⟨a1, a2⟩ := abs_lt.mp hxiw
      obtain ⟨c1', c2'⟩ := abs_le.mp hb1'
      exact abs_lt.mpr ⟨by linarith, by linarith⟩
    have hw2 : |w.2| < 1/2 := by
      rw [hinv2]
      obtain ⟨a1, a2⟩ := abs_lt.mp hetw
      obtain ⟨c1', c2'⟩ := abs_le.mp hb2'
      exact abs_lt.mpr ⟨by linarith, by linarith⟩
    obtain ⟨K1, hK1⟩ : ∃ K : ℤ, K = round ((Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).1) := ⟨_, rfl⟩
    obtain ⟨K2, hK2⟩ : ∃ K : ℤ, K = round ((Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).2) := ⟨_, rfl⟩
    have hw1e : w.1 = (Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).1 - (K1 : ℝ) := by
      rw [hw, hK1]; rfl
    have hw2e : w.2 = (Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).2 - (K2 : ℝ) := by
      rw [hw, hK2]; rfl
    have hround : ∀ (x : ℝ) (K : ℤ), |x - (K : ℝ)| < 1/2 → round x = K := by
      intro x K hx
      rw [round_eq, Int.floor_eq_iff]
      obtain ⟨a, b⟩ := abs_lt.mp hx
      constructor <;> linarith
    have hJc : Continuous (fun Y' : ℝ × ℝ => Jpow (bandIdx B.h γ.1) Y' - G.ctr γ) := by
      unfold Jpow; fun_prop
    obtain ⟨V, hV⟩ : ∃ V : Set (ℝ × ℝ), V =
        {Y' : ℝ × ℝ | |(Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).1 - (K1 : ℝ)| < 1/2} ∩
        {Y' : ℝ × ℝ | |(Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).2 - (K2 : ℝ)| < 1/2} := ⟨_, rfl⟩
    have hVo : IsOpen V := by
      rw [hV]
      exact (isOpen_lt ((hJc.fst).sub continuous_const).abs continuous_const).inter
        (isOpen_lt ((hJc.snd).sub continuous_const).abs continuous_const)
    have hYV : ξ.2.2.2 ∈ V := by
      rw [hV]
      refine ⟨?_, ?_⟩
      · show |(Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).1 - (K1 : ℝ)| < 1/2
        rw [← hw1e]; exact hw1
      · show |(Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ).2 - (K2 : ℝ)| < 1/2
        rw [← hw2e]; exact hw2
    have hfr : ∀ Y' ∈ V, rectW B.h γ (G.ctr γ) Y' =
        Jpow (bandIdx B.h γ.1) Y' - G.ctr γ - ((K1 : ℝ), (K2 : ℝ)) := by
      intro Y' hY'
      rw [hV] at hY'
      have r1 : round ((Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).1) = K1 := hround _ _ hY'.1
      have r2 : round ((Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).2) = K2 := hround _ _ hY'.2
      unfold rectW frac0
      rw [r1, r2]
      ext <;> simp
    obtain ⟨d0, hd0⟩ : ∃ d0 : ℝ, d0 = -(lamT (G.ctr γ) + lamT ((K1 : ℝ), (K2 : ℝ))) := ⟨_, rfl⟩
    have haff : ∀ Y' ∈ V, etG B.h γ (G.ctr γ) Y' = Tgc ^ (bandIdx B.h γ.1) * lamT Y' + d0 := by
      intro Y' hY'
      unfold etG
      rw [hfr Y' hY', hTsub, hTsub, hlin, hd0]
      ring
    obtain ⟨lT, hlTd⟩ : ∃ f : ℝ × ℝ →L[ℝ] ℝ, f = (1 / (1 + bgc ^ 2)) •
        (bgc • ContinuousLinearMap.fst ℝ ℝ ℝ + ContinuousLinearMap.snd ℝ ℝ ℝ) := ⟨_, rfl⟩
    have hlT : ∀ y, lT y = lamT y := by
      intro y; rw [hlTd]
      simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', smul_eq_mul]
      unfold lamT; ring
    obtain ⟨Λ, hΛd⟩ : ∃ f : Cyl →L[ℝ] ℝ, f = Tgc ^ (bandIdx B.h γ.1) • lT.comp
        ((ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)).comp
        ((ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × ℝ)).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × ℝ × ℝ)))) :=
      ⟨_, rfl⟩
    have hΛ : ∀ v : Cyl, Λ v = Tgc ^ (bandIdx B.h γ.1) * lamT v.2.2.2 := by
      intro v; rw [hΛd]
      simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearMap.coe_snd', smul_eq_mul, hlT]
    obtain ⟨U, hU⟩ : ∃ U : Set Cyl, U = (fun η : Cyl => η.2.2.2) ⁻¹' V := ⟨_, rfl⟩
    have hUo : IsOpen U := by rw [hU]; exact hVo.preimage (by fun_prop)
    have hξU : ξ ∈ U := by rw [hU]; exact hYV
    have hev : psiW B G γ =ᶠ[nhds ξ] (fun η : Cyl => Θ (Λ η + d0)) :=
      Filter.eventuallyEq_of_mem (hUo.mem_nhds hξU) (fun η hη => by
        rw [hU] at hη
        show psiW B G γ η = Θ (Λ η + d0)
        rw [hpsi, haff η.2.2.2 hη, hΛ])
    have hgs : ContDiff ℝ ∞ (fun η : Cyl => Θ (Λ η + d0)) :=
      hΘs.comp (Λ.contDiff.add contDiff_const)
    have hLn : ∀ v : Cyl, (Lnorm B.h ξ v).2.2.2 = JpowL (-coarseIdx B.h (qC B.h ξ)) v.2.2.2 :=
      fun v => rfl
    have hslope : ∀ v : Cyl, |Λ (Lnorm B.h ξ v)| ≤ 2 * Tgc ^ 3 * ‖v‖ := by
      intro v
      rw [hΛ, hLn, hJL, ← mul_assoc, ← zpow_add₀ hT, abs_mul, abs_of_pos (zpow_pos hT0 _)]
      have hz3 : Tgc ^ (bandIdx B.h γ.1 + -coarseIdx B.h (qC B.h ξ)) ≤ Tgc ^ (3:ℤ) :=
        zpow_le_zpow_right₀ hT1.le (by omega)
      have h3 : Tgc ^ (3:ℤ) = Tgc ^ 3 := zpow_natCast Tgc 3
      have hY : ‖v.2.2.2‖ ≤ ‖v‖ :=
        (norm_snd_le _).trans ((norm_snd_le _).trans (norm_snd_le _))
      have hX : |lamT v.2.2.2| ≤ 3/2 * ‖v‖ := by linarith [hlamb v.2.2.2]
      have hT3 : 0 ≤ Tgc ^ 3 := by positivity
      calc Tgc ^ (bandIdx B.h γ.1 + -coarseIdx B.h (qC B.h ξ)) * |lamT v.2.2.2|
          ≤ Tgc ^ 3 * (3/2 * ‖v‖) := by
            rw [← h3]; exact mul_le_mul hz3 hX (abs_nonneg _) (by rw [h3]; exact hT3)
        _ ≤ 2 * Tgc ^ 3 * ‖v‖ := by nlinarith [norm_nonneg v]
    refine ⟨hgs.contDiffAt.congr_of_eventuallyEq hev, fun i hi => ?_, fun c hc => ?_⟩
    · rw [hNBev _ _ i ξ hev]
      refine (nbaff B.h Θ Λ d0 ξ i (K i) (2 * Tgc ^ 3) hΘs (hK i) (by positivity) hslope).trans ?_
      calc K i * (2 * Tgc ^ 3) ^ i ≤ |K i| * (2 * Tgc ^ 3) ^ i :=
            mul_le_mul_of_nonneg_right (le_abs_self _) (by positivity)
        _ ≤ Mψ k := by
            rw [hMψ]
            exact Finset.single_le_sum (f := fun j => |K j| * (2 * Tgc ^ 3) ^ j)
              (fun j _ => mul_nonneg (abs_nonneg _) (by positivity))
              (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    · obtain ⟨a0, b0, hab⟩ := hc
      obtain ⟨kk, hkk⟩ := Int.le.dest hciN
      have hJk : Jpow (bandIdx B.h γ.1) c = Jpow (kk : ℤ) (Jpow (coarseIdx B.h (qC B.h ξ)) c) := by
        rw [hcomp, ← hkk, add_comm]
      obtain ⟨a1, b1, hJk'⟩ := hint kk a0 b0
      have hJc' : Jpow (bandIdx B.h γ.1) c = ((a1 : ℝ), (b1 : ℝ)) := by
        rw [hJk, hab, hJk']
      have hrect : rectW B.h γ (G.ctr γ) (ξ.2.2.2 + c) = rectW B.h γ (G.ctr γ) ξ.2.2.2 := by
        unfold rectW
        rw [hJadd, hJc']
        have e : Jpow (bandIdx B.h γ.1) ξ.2.2.2 + ((a1 : ℝ), (b1 : ℝ)) - G.ctr γ =
            (Jpow (bandIdx B.h γ.1) ξ.2.2.2 - G.ctr γ) + ((a1 : ℝ), (b1 : ℝ)) := by abel
        rw [e, hfrI]
      rw [hpsi, hpsi]
      congr 1
      unfold etG
      rw [show (shY ξ c).2.2.2 = ξ.2.2.2 + c from rfl, hrect]

  refine ⟨lb, fun k => ⟨Mρ (Aex B.h + 1/2) k +
    4 ^ k * Mρ (Aex B.h + 1/2) k * Mψ k * Mρ (-(Aex B.h + 1)) k, 0, ?_⟩⟩
  intro l0 hl0 γ _ _ ξ hξ r1 r2 e1 e2
  have hξ' := hξ
  obtain ⟨-, ht, hqs⟩ := hξ'
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  have hq1 : qC B.h ξ ≤ 1 := by linarith
  obtain ⟨hs1, hb1⟩ := hrho (Aex B.h + 1/2) k γ ξ ht hq1 r1 r2
  obtain ⟨hs2, hb2⟩ := hrho (-(Aex B.h + 1)) k γ ξ ht hq1 r1 r2
  obtain ⟨hps, hpb, hdk⟩ := hpsiA k l0 hl0 γ ξ hξ r1 r2 e1 e2
  have hP : ContDiffAt ℝ ∞ (fun η => rhoQ B γ η ^ (Aex B.h + 1/2) * psiW B G γ η) ξ := hs1.mul hps
  have hR : ContDiffAt ℝ ∞ (fun η => rhoQ B γ η ^ (Aex B.h + 1/2) * psiW B G γ η *
      rhoQ B γ η ^ (-(Aex B.h + 1))) ξ := hP.mul hs2
  have hA0 := hMρ0 (Aex B.h + 1/2) k
  have hE0 := hMψ0 k
  have hF0 := hMρ0 (-(Aex B.h + 1)) k
  have hPb : ∀ i : ℕ, i ≤ k → NB B.h (fun η => rhoQ B γ η ^ (Aex B.h + 1/2) * psiW B G γ η) i ξ ≤
      2 ^ k * Mρ (Aex B.h + 1/2) k * Mψ k := by
    intro i hi
    refine (nbmul B.h ξ _ _ i _ _ hs1 hps (fun j hj => hb1 j (hj.trans hi))
      (fun j hj => hpb j (hj.trans hi))).trans ?_
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right
      (pow_le_pow_right₀ (by norm_num) hi) hA0) hE0
  have hRb := nbmul B.h ξ _ _ k _ _ hP hs2 hPb (fun j hj => hb2 j hj)
  have e4 : (4:ℝ) ^ k = 2 ^ k * 2 ^ k := by rw [← mul_pow]; norm_num
  have hX0 : 0 ≤ 4 ^ k * Mρ (Aex B.h + 1/2) k * Mψ k * Mρ (-(Aex B.h + 1)) k := by positivity
  rw [Real.rpow_zero, mul_one]
  refine ⟨(hcast _ ξ hs1).1, (hcast _ ξ hR).1, ?_, ?_, hdk⟩
  · exact ((hcast _ ξ hs1).2 k).trans ((hb1 k le_rfl).trans (le_add_of_nonneg_right hX0))
  · refine ((hcast _ ξ hR).2 k).trans (hRb.trans ?_)
    rw [e4]
    have : 2 ^ k * (2 ^ k * Mρ (Aex B.h + 1/2) k * Mψ k) * Mρ (-(Aex B.h + 1)) k =
        2 ^ k * 2 ^ k * Mρ (Aex B.h + 1/2) k * Mψ k * Mρ (-(Aex B.h + 1)) k := by ring
    rw [this]
    exact le_add_of_nonneg_left hA0

theorem pulse_pr_class_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (α : ℝ) (f tw : WC), InWg5 B G (qsOf l0) α f → InWg5 B G (qsOf l0) α (cutA B G tw) →
    InWg5 B G (qsOf l0) (α + 1/2) (cutS B G (pulsePr5 B G f tw)) :=
by
  intro B G hok hG
  obtain ⟨ls, hsg⟩ := pulse_support_good_v5 B G hok hG
  obtain ⟨lp, hpm⟩ := pres_mult_coeffs_v5 B G hok hG
  obtain ⟨lq, hqm⟩ := pulse_mult_coeffs_v5 B G hok hG
  obtain ⟨lw, hwt⟩ := pulse_pr_weights_v5 B G hok hG
  refine ⟨ls + lp + lq + lw, ?_⟩
  intro l0 hl0 α f tw hf hA
  have hh0 : 0 ≤ B.h := hok.2.1.1.le
  have hXa : 0 < B.Xa := hok.2.1.2.2.1

  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hDq : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 ∧ 1 ≤ SC B.h ξ := by
    have hqs1 : qsOf l0 ≤ 1 := by
      show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
      exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
    intro ξ hξ
    obtain ⟨-, e2, e3⟩ := hξ
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    refine ⟨hq0, by linarith, ?_⟩
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hDsh : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ a, shY ξ a ∈ DomC B.h (qsOf l0) := fun ξ hξ _ => hξ
  have hEdge : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X ∧
      0 < edgeDist B.Xa B.Xb X ∧ edgeDist B.Xa B.Xb X ≤ 1 := by
    intro X e1 e2
    refine ⟨?_, ?_, min_le_left _ _⟩
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · have hX : 0 < X := lt_trans hXa e1
      have l1 : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr e1)
      have l2 : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX).mpr e2)
      exact lt_min one_pos (lt_min l1 l2)
  have hW : ∀ (q Sv E e P C1 C2 b1 b2 d1 d2 α α1 α2 N1 N2 : ℝ), 0 < q → q ≤ 1 → 1 ≤ Sv → 0 ≤ E →
      0 < e → e ≤ 1 → 0 ≤ P → α ≤ α1 → α ≤ α2 →
      N1 ≤ C1 * q ^ (B.h * α1) * Sv ^ b1 * E * e ^ (-d1) * P →
      N2 ≤ C2 * q ^ (B.h * α2) * Sv ^ b2 * E * e ^ (-d2) * P →
      N1 + N2 ≤ (|C1| + |C2|) * q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P := by
    intro q Sv E e P C1 C2 b1 b2 d1 d2 α α1 α2 N1 N2 hq0 hq1 hS1 hE he0 he1 hP0 ha1 ha2 hN1 hN2
    have key : ∀ (C b d αi N : ℝ), α ≤ αi → N ≤ C * q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P →
        b ≤ max b1 b2 → d ≤ max d1 d2 →
        N ≤ |C| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by
      intro C b d αi N hα hN hb hd
      have f1 : q ^ (B.h * αi) ≤ q ^ (B.h * α) :=
        Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (mul_le_mul_of_nonneg_left hα hh0)
      have f2 : Sv ^ b ≤ Sv ^ (max b1 b2) := Real.rpow_le_rpow_of_exponent_le hS1 hb
      have f3 : e ^ (-d) ≤ e ^ (-(max d1 d2)) :=
        Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hd)
      have p1 : 0 ≤ q ^ (B.h * αi) := Real.rpow_nonneg hq0.le _
      have p2 : 0 ≤ Sv ^ b := Real.rpow_nonneg (by linarith) _
      have p3 : 0 ≤ e ^ (-d) := Real.rpow_nonneg he0.le _
      have p1' : 0 ≤ q ^ (B.h * α) := Real.rpow_nonneg hq0.le _
      have p2' : 0 ≤ Sv ^ (max b1 b2) := Real.rpow_nonneg (by linarith) _
      have m1 : q ^ (B.h * αi) * Sv ^ b ≤ q ^ (B.h * α) * Sv ^ (max b1 b2) := mul_le_mul f1 f2 p2 p1'
      have m2 : q ^ (B.h * αi) * Sv ^ b * E ≤ q ^ (B.h * α) * Sv ^ (max b1 b2) * E :=
        mul_le_mul_of_nonneg_right m1 hE
      have m3 : q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) ≤
          q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) :=
        mul_le_mul m2 f3 p3 (mul_nonneg (mul_nonneg p1' p2') hE)
      have hWi := mul_le_mul_of_nonneg_right m3 hP0
      have hWi0 : 0 ≤ q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P :=
        mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg p1 p2) hE) p3) hP0
      calc N ≤ C * q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P := hN
        _ = C * (q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P) := by ring
        _ ≤ |C| * (q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P) :=
            mul_le_mul_of_nonneg_right (le_abs_self C) hWi0
        _ ≤ |C| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) :=
            mul_le_mul_of_nonneg_left hWi (abs_nonneg C)
    have k1 := key C1 b1 d1 α1 N1 ha1 hN1 (le_max_left _ _) (le_max_left _ _)
    have k2 := key C2 b2 d2 α2 N2 ha2 hN2 (le_max_right _ _) (le_max_right _ _)
    have e : (|C1| + |C2|) * q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P =
        |C1| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) +
        |C2| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by ring
    rw [e]
    linarith
  have hNB : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f1 f2 g : Cyl → V) (k : ℕ) (ξ : Cyl),
      ξ ∈ DomC B.h (qsOf l0) → ContDiffOn ℝ ∞ f1 (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ f2 (DomC B.h (qsOf l0)) →
      (∀ η ∈ DomC B.h (qsOf l0), g η = f1 η + f2 η) → NB B.h g k ξ ≤ NB B.h f1 k ξ + NB B.h f2 k ξ := by
    intro V _ _ f1 f2 g k ξ hξ hf1 hf2 heq
    have hn : DomC B.h (qsOf l0) ∈ nhds ξ := hDopen.mem_nhds hξ
    have hev : g =ᶠ[nhds ξ] f1 + f2 := Filter.eventuallyEq_of_mem hn (fun η hη => heq η hη)
    have e1 : iteratedFDeriv ℝ k g ξ = iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ := by
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      exact iteratedFDeriv_add_apply ((hf1.contDiffAt hn).of_le (by exact_mod_cast le_top))
        ((hf2.contDiffAt hn).of_le (by exact_mod_cast le_top))
    unfold NB
    rw [e1]
    have e2 : (iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) =
        (iteratedFDeriv ℝ k f1 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) +
        (iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    exact norm_add_le _ _
  have hInWg : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (α α1 α2 : ℝ)
      (a b c : Lab → ℤ → Cyl → V),
      InWg5 B G (qsOf l0) α1 a → InWg5 B G (qsOf l0) α2 b → α ≤ α1 → α ≤ α2 →
      (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → c γ m = 0) →
      (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), c γ m ξ = a γ m ξ + b γ m ξ) → InWg5 B G (qsOf l0) α c := by
    intro V _ _ α α1 α2 a b c ea eb ha1 ha2 hHc heq
    obtain ⟨-, sa, da, pa, ba⟩ := ea
    obtain ⟨-, sb, db, pb, bb⟩ := eb
    refine ⟨hHc, fun γ m => ((sa γ m).add (sb γ m)).congr (heq γ m), ?_, ?_, ?_⟩
    · intro γ m ξ hξ c' hc
      rw [heq γ m _ (hDsh ξ hξ c'), heq γ m ξ hξ, da γ m ξ hξ c' hc, db γ m ξ hξ c' hc]
    · intro γ m ξ hξ hne
      rw [heq γ m ξ hξ] at hne
      by_cases hA : a γ m ξ = 0
      · rw [hA, zero_add] at hne
        exact pb γ m ξ hξ hne
      · exact pa γ m ξ hξ hA
    · intro k
      obtain ⟨C1, c1, e1, hb1⟩ := ba k
      obtain ⟨C2, c2, e2, hb2⟩ := bb k
      refine ⟨|C1| + |C2|, max c1 c2, max e1 e2, fun γ m ξ hξ hX1 hX2 => ?_⟩
      obtain ⟨hq0, hq1, hS1⟩ := hDq ξ hξ
      obtain ⟨hE, he0, he1⟩ := hEdge _ hX1 hX2
      have hn := hNB (a γ m) (b γ m) (c γ m) k ξ hξ (sa γ m) (sb γ m) (heq γ m)
      have hP0 : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
        unfold Penv5
        exact (Real.exp_pos _).le
      exact le_trans hn (hW _ _ _ _ _ C1 C2 c1 c2 e1 e2 α α1 α2 _ _ hq0 hq1 hS1 (Real.sqrt_nonneg _)
        he0 he1 hP0 ha1 ha2 (hb1 γ m ξ hξ hX1 hX2) (hb2 γ m ξ hξ hX1 hX2))

  obtain ⟨A1, hA1d⟩ : ∃ A1 : WC, A1 = fun γ m ξ =>
      ((rhoQ B γ ξ ^ (Aex B.h + 1/2) : ℝ) : ℂ) • cutA B G tw γ m ξ := ⟨_, rfl⟩
  obtain ⟨F1, hF1d⟩ : ∃ F1 : WC, F1 = fun γ m ξ =>
      ((rhoQ B γ ξ ^ (Aex B.h + 1/2) * psiW B G γ ξ * rhoQ B γ ξ ^ (-(Aex B.h + 1)) : ℝ) : ℂ) •
        f γ m ξ := ⟨_, rfl⟩
  have hA1 : InWg5 B G (qsOf l0) α A1 := by
    have e : α = α + 0 := (add_zero α).symm
    rw [e, hA1d]
    refine inWg5_smul_mult B G l0 hok α 0 (cutA B G tw)
      (fun γ η => ((rhoQ B γ η ^ (Aex B.h + 1/2) : ℝ) : ℂ)) hA ?_ ?_ ?_
    · intro γ m ξ hξ hts
      obtain ⟨-, hAct, hlg, r1, r2, -, -, e1, e2⟩ := hsg l0 (by omega) α (cutA B G tw) hA γ m ξ hξ hts
      obtain ⟨C, b, hC⟩ := hwt 0
      exact (hC l0 (by omega) γ hAct hlg ξ hξ r1 r2 e1 e2).1
    · intro γ m ξ hξ hne c hc
      have hr : rhoQ B γ (shY ξ c) = rhoQ B γ ξ := rfl
      simp only [hr]
    · intro k
      obtain ⟨C, b, hC⟩ := hwt k
      refine ⟨C, b, fun γ m ξ hξ hts _ _ => ?_⟩
      obtain ⟨-, hAct, hlg, r1, r2, -, -, e1, e2⟩ := hsg l0 (by omega) α (cutA B G tw) hA γ m ξ hξ hts
      rw [mul_zero, Real.rpow_zero, mul_one]
      exact (hC l0 (by omega) γ hAct hlg ξ hξ r1 r2 e1 e2).2.2.1
  have hF1 : InWg5 B G (qsOf l0) α F1 := by
    have e : α = α + 0 := (add_zero α).symm
    rw [e, hF1d]
    refine inWg5_smul_mult B G l0 hok α 0 f
      (fun γ η => ((rhoQ B γ η ^ (Aex B.h + 1/2) * psiW B G γ η * rhoQ B γ η ^ (-(Aex B.h + 1)) : ℝ) : ℂ))
      hf ?_ ?_ ?_
    · intro γ m ξ hξ hts
      obtain ⟨-, hAct, hlg, r1, r2, -, -, e1, e2⟩ := hsg l0 (by omega) α f hf γ m ξ hξ hts
      obtain ⟨C, b, hC⟩ := hwt 0
      exact (hC l0 (by omega) γ hAct hlg ξ hξ r1 r2 e1 e2).2.1
    · intro γ m ξ hξ hne c hc
      have hts : ξ ∈ tsupport (f γ m) := subset_tsupport _ (Function.mem_support.2 hne)
      obtain ⟨-, hAct, hlg, r1, r2, -, -, e1, e2⟩ := hsg l0 (by omega) α f hf γ m ξ hξ hts
      obtain ⟨C, b, hC⟩ := hwt 0
      have hdeck := (hC l0 (by omega) γ hAct hlg ξ hξ r1 r2 e1 e2).2.2.2.2 c hc
      have hr : rhoQ B γ (shY ξ c) = rhoQ B γ ξ := rfl
      simp only [hr, hdeck]
    · intro k
      obtain ⟨C, b, hC⟩ := hwt k
      refine ⟨C, b, fun γ m ξ hξ hts _ _ => ?_⟩
      obtain ⟨-, hAct, hlg, r1, r2, -, -, e1, e2⟩ := hsg l0 (by omega) α f hf γ m ξ hξ hts
      rw [mul_zero, Real.rpow_zero, mul_one]
      exact (hC l0 (by omega) γ hAct hlg ξ hξ r1 r2 e1 e2).2.2.2.1

  have hT1 : InWg5 B G (qsOf l0) (α + 1/2)
      (fun γ m ξ => dotProduct (presMult5 B G γ m ξ) (A1 γ m ξ)) := by
    refine inWg5_dot_mult B G l0 hok α (1/2) A1 (presMult5 B G) hA1 ?_ ?_ ?_
    · intro γ m ξ hξ hts
      obtain ⟨-, hAct, hlg, r1, r2, x1, x2, e1, e2⟩ := hsg l0 (by omega) α A1 hA1 γ m ξ hξ hts
      obtain ⟨C, b, hC⟩ := hpm 0
      exact (hC l0 (by omega) γ m hAct hlg ξ hξ r1 r2 x1 x2 e1 e2).1
    · intro γ m ξ hξ hne c hc
      have hts : ξ ∈ tsupport (A1 γ m) := subset_tsupport _ (Function.mem_support.2 hne)
      obtain ⟨-, hAct, hlg, r1, r2, x1, x2, e1, e2⟩ := hsg l0 (by omega) α A1 hA1 γ m ξ hξ hts
      obtain ⟨C, b, hC⟩ := hpm 0
      exact (hC l0 (by omega) γ m hAct hlg ξ hξ r1 r2 x1 x2 e1 e2).2.2 c hc
    · intro k
      obtain ⟨C, b, hC⟩ := hpm k
      refine ⟨C, b, fun γ m ξ hξ hts _ _ => ?_⟩
      obtain ⟨-, hAct, hlg, r1, r2, x1, x2, e1, e2⟩ := hsg l0 (by omega) α A1 hA1 γ m ξ hξ hts
      exact (hC l0 (by omega) γ m hAct hlg ξ hξ r1 r2 x1 x2 e1 e2).2.1
  have hT2 : InWg5 B G (qsOf l0) (α + 1/2)
      (fun γ m ξ => dotProduct (pulseMult5 B G γ m ξ) (F1 γ m ξ)) := by
    refine inWg5_dot_mult B G l0 hok α (1/2) F1 (pulseMult5 B G) hF1 ?_ ?_ ?_
    · intro γ m ξ hξ hts
      obtain ⟨-, hAct, hlg, r1, r2, x1, x2, e1, e2⟩ := hsg l0 (by omega) α F1 hF1 γ m ξ hξ hts
      obtain ⟨C, b, hC⟩ := hqm 0
      exact (hC l0 (by omega) γ m hAct hlg ξ hξ r1 r2 x1 x2 e1 e2).2.1
    · intro γ m ξ hξ hne c hc
      have hts : ξ ∈ tsupport (F1 γ m) := subset_tsupport _ (Function.mem_support.2 hne)
      obtain ⟨-, hAct, hlg, r1, r2, x1, x2, e1, e2⟩ := hsg l0 (by omega) α F1 hF1 γ m ξ hξ hts
      obtain ⟨C, b, hC⟩ := hqm 0
      exact (hC l0 (by omega) γ m hAct hlg ξ hξ r1 r2 x1 x2 e1 e2).2.2.2 c hc
    · intro k
      obtain ⟨C, b, hC⟩ := hqm k
      refine ⟨C, b, fun γ m ξ hξ hts _ _ => ?_⟩
      obtain ⟨-, hAct, hlg, r1, r2, x1, x2, e1, e2⟩ := hsg l0 (by omega) α F1 hF1 γ m ξ hξ hts
      exact (hC l0 (by omega) γ m hAct hlg ξ hξ r1 r2 x1 x2 e1 e2).2.2.1

  have hid : cutS B G (pulsePr5 B G f tw) = fun γ m ξ =>
      dotProduct (presMult5 B G γ m ξ) (A1 γ m ξ) + dotProduct (pulseMult5 B G γ m ξ) (F1 γ m ξ) := by
    funext γ m ξ
    rw [hA1d, hF1d]
    by_cases hm : m = 0
    · simp [cutS, pulsePr5, presMult5, pulseMult5, hm]
    · simp only [cutS, pulsePr5, presMult5, pulseMult5, if_neg hm, nsqC5, srcHat, cutA]
      generalize dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) = ν
      generalize rhoQ B γ ξ ^ (Aex B.h + 1/2) = R
      generalize rhoQ B γ ξ ^ (-(Aex B.h + 1)) = s
      generalize psiW B G γ ξ = ps
      simp only [dotProduct, Fin.sum_univ_three, Matrix.mulVec, Matrix.vecMul, pulseMatC, Matrix.map_apply,
        Pi.smul_apply, smul_eq_mul, Pi.sub_apply, nPhiC5]
      push_cast
      ring
  rw [hid]
  obtain ⟨H1, H10, H1v⟩ := hT1.1
  obtain ⟨H2, H20, H2v⟩ := hT2.1
  refine hInWg (α + 1/2) (α + 1/2) (α + 1/2) _ _ _ hT1 hT2 le_rfl le_rfl
    ⟨H1 ∪ H2, by simp [H10, H20], fun γ m hm => ?_⟩ (fun γ m ξ _ => rfl)
  have e1 := H1v γ m (fun h => hm (Finset.mem_union_left _ h))
  have e2 := H2v γ m (fun h => hm (Finset.mem_union_right _ h))
  funext ξ
  have e1' := congrFun e1 ξ
  have e2' := congrFun e2 ξ
  simp only [Pi.zero_apply] at e1' e2' ⊢
  rw [e1', e2', add_zero]

theorem theta_profile_v5 : ∀ r0 : ℝ, 0 < r0 → ContDiff ℝ ∞ (fun x : ℝ => 1 - Real.smoothTransition (5/2 - 15 / (4 * r0) * |x|)) ∧ (∀ n : ℕ, ∃ K : ℝ, ∀ x : ℝ, ‖iteratedFDeriv ℝ n (fun x : ℝ => 1 - Real.smoothTransition (5/2 - 15 / (4 * r0) * |x|)) x‖ ≤ K) ∧ ∀ x : ℝ, |x| < 2 * r0 / 5 → Real.smoothTransition (5/2 - 15 / (4 * r0) * |x|) = 1 :=
by
  intro r0 hr0
  set F : ℝ → ℝ := fun x : ℝ => 1 - Real.smoothTransition (5/2 - 15 / (4 * r0) * |x|) with hF
  have ha : (0:ℝ) ≤ 15 / (4 * r0) := by positivity
  have hle1 : ∀ y : ℝ, |y| ≤ 2 * r0 / 5 → 1 ≤ 5/2 - 15 / (4 * r0) * |y| := by
    intro y hy
    have h1 : 15 / (4 * r0) * |y| ≤ 15 / (4 * r0) * (2 * r0 / 5) :=
      mul_le_mul_of_nonneg_left hy ha
    have h2 : 15 / (4 * r0) * (2 * r0 / 5) = 3/2 := by field_simp; ring
    linarith
  have hle0 : ∀ y : ℝ, 2 * r0 / 3 ≤ |y| → 5/2 - 15 / (4 * r0) * |y| ≤ 0 := by
    intro y hy
    have h1 : 15 / (4 * r0) * (2 * r0 / 3) ≤ 15 / (4 * r0) * |y| :=
      mul_le_mul_of_nonneg_left hy ha
    have h2 : 15 / (4 * r0) * (2 * r0 / 3) = 5/2 := by field_simp; ring
    linarith
  have hC : ∀ x : ℝ, |x| < 2 * r0 / 5 → Real.smoothTransition (5/2 - 15 / (4 * r0) * |x|) = 1 :=
    fun x hx => Real.smoothTransition.one_of_one_le (hle1 x hx.le)
  have hU0 : IsOpen {y : ℝ | |y| < 2 * r0 / 5} := isOpen_lt continuous_abs continuous_const
  have hU1 : IsOpen {y : ℝ | 2 * r0 / 3 < |y|} := isOpen_lt continuous_const continuous_abs
  have h0mem : (0:ℝ) ∈ {y : ℝ | |y| < 2 * r0 / 5} := by
    show |(0:ℝ)| < 2 * r0 / 5
    rw [abs_zero]; positivity
  have hF0 : F =ᶠ[nhds 0] fun _ => (0:ℝ) := by
    refine Filter.eventuallyEq_of_mem (hU0.mem_nhds h0mem) ?_
    intro y hy
    show 1 - Real.smoothTransition (5/2 - 15 / (4 * r0) * |y|) = 0
    rw [hC y hy, sub_self]
  have hF1 : ∀ x : ℝ, 2 * r0 / 3 < |x| → F =ᶠ[nhds x] fun _ => (1:ℝ) := by
    intro x hx
    refine Filter.eventuallyEq_of_mem (hU1.mem_nhds hx) ?_
    intro y hy
    have hy' : 2 * r0 / 3 < |y| := hy
    show 1 - Real.smoothTransition (5/2 - 15 / (4 * r0) * |y|) = 1
    rw [Real.smoothTransition.zero_of_nonpos (hle0 y hy'.le), sub_zero]
  have hA : ContDiff ℝ ∞ F := by
    rw [contDiff_iff_contDiffAt]
    intro x
    by_cases hx : x = 0
    · subst hx
      exact contDiffAt_const.congr_of_eventuallyEq hF0
    · have habs : ContDiffAt ℝ ∞ (fun y : ℝ => |y|) x := contDiffAt_abs hx
      have hg : ContDiffAt ℝ ∞ (fun y : ℝ => 5/2 - 15 / (4 * r0) * |y|) x :=
        contDiffAt_const.sub (contDiffAt_const.mul habs)
      have hS : ContDiffAt ℝ ∞
          (fun y : ℝ => Real.smoothTransition (5/2 - 15 / (4 * r0) * |y|)) x :=
        Real.smoothTransition.contDiff.contDiffAt.comp x hg
      exact contDiffAt_const.sub hS
  have hB : ∀ n : ℕ, ∃ K : ℝ, ∀ x : ℝ, ‖iteratedFDeriv ℝ n F x‖ ≤ K := by
    intro n
    have hcont : Continuous (fun x => iteratedFDeriv ℝ n F x) :=
      hA.continuous_iteratedFDeriv (by exact_mod_cast le_top)
    obtain ⟨C, hCb⟩ :=
      (isCompact_closedBall (0:ℝ) r0).exists_bound_of_continuousOn hcont.continuousOn
    refine ⟨max C 1, fun x => ?_⟩
    by_cases hx : |x| ≤ r0
    · have hmem : x ∈ Metric.closedBall (0:ℝ) r0 := by
        rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs]; exact hx
      exact (hCb x hmem).trans (le_max_left _ _)
    · have hx' : 2 * r0 / 3 < |x| := by
        have : r0 < |x| := lt_of_not_ge hx
        linarith
      rw [((hF1 x hx').iteratedFDeriv ℝ n).eq_of_nhds]
      rcases Nat.eq_zero_or_pos n with hn | hn
      · subst hn
        rw [norm_iteratedFDeriv_zero, norm_one]
        exact le_max_right _ _
      · rw [iteratedFDeriv_const_of_ne (by omega : n ≠ 0)]
        rw [Pi.zero_apply, norm_zero]
        exact le_trans zero_le_one (le_max_right _ _)
  exact ⟨hA, hB, hC⟩

theorem etG_local_affine_v5 : ∀ (h : ℝ) (γ : Lab) (c Y₀ : ℝ × ℝ), |xiG h γ c Y₀| < 1/8 → |etG h γ c Y₀| < 1/8 → ∃ (W : Set (ℝ × ℝ)) (d : ℝ), IsOpen W ∧ Y₀ ∈ W ∧ ∀ Y ∈ W, etG h γ c Y = Tgc ^ (bandIdx h γ.1) * lamT Y - d :=
by
  intro h γ c Y₀ hxi het
  have hbgc : 0 ≤ bgc ∧ bgc < 1/2 := by
    have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
    have hs2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    unfold bgc
    constructor <;> nlinarith
  have hDen : (1 + bgc ^ 2) ≠ 0 := by positivity
  obtain ⟨w, hw⟩ : ∃ w : ℝ × ℝ, w = rectW h γ c Y₀ := ⟨_, rfl⟩
  have hxiw : |lamR w| < 1/8 := by rw [hw]; exact hxi
  have hetw : |lamT w| < 1/8 := by rw [hw]; exact het
  have hinv1 : w.1 = lamR w + bgc * lamT w := by
    have e : lamR w + bgc * lamT w = (w.1 - bgc * w.2 + bgc * (bgc * w.1 + w.2)) / (1 + bgc ^ 2) := by
      unfold lamR lamT; ring
    rw [e, eq_div_iff hDen]
    ring
  have hinv2 : w.2 = lamT w - bgc * lamR w := by
    have e : lamT w - bgc * lamR w = (bgc * w.1 + w.2 - bgc * (w.1 - bgc * w.2)) / (1 + bgc ^ 2) := by
      unfold lamR lamT; ring
    rw [e, eq_div_iff hDen]
    ring
  have hb1 : bgc * |lamT w| ≤ 1/16 := by
    calc bgc * |lamT w| ≤ (1/2) * (1/8) := mul_le_mul hbgc.2.le hetw.le (abs_nonneg _) (by norm_num)
      _ = 1/16 := by norm_num
  have hb2 : bgc * |lamR w| ≤ 1/16 := by
    calc bgc * |lamR w| ≤ (1/2) * (1/8) := mul_le_mul hbgc.2.le hxiw.le (abs_nonneg _) (by norm_num)
      _ = 1/16 := by norm_num
  have hb1' : |bgc * lamT w| ≤ 1/16 := by rw [abs_mul, abs_of_nonneg hbgc.1]; exact hb1
  have hb2' : |bgc * lamR w| ≤ 1/16 := by rw [abs_mul, abs_of_nonneg hbgc.1]; exact hb2
  have hw1 : |w.1| < 1/2 := by
    rw [hinv1]
    obtain ⟨a1, a2⟩ := abs_lt.mp hxiw
    obtain ⟨c1, c2⟩ := abs_le.mp hb1'
    exact abs_lt.mpr ⟨by linarith, by linarith⟩
  have hw2 : |w.2| < 1/2 := by
    rw [hinv2]
    obtain ⟨a1, a2⟩ := abs_lt.mp hetw
    obtain ⟨c1, c2⟩ := abs_le.mp hb2'
    exact abs_lt.mpr ⟨by linarith, by linarith⟩
  obtain ⟨K1, hK1⟩ : ∃ K : ℤ, K = round ((Jpow (bandIdx h γ.1) Y₀ - c).1) := ⟨_, rfl⟩
  obtain ⟨K2, hK2⟩ : ∃ K : ℤ, K = round ((Jpow (bandIdx h γ.1) Y₀ - c).2) := ⟨_, rfl⟩
  have hw1e : w.1 = (Jpow (bandIdx h γ.1) Y₀ - c).1 - (K1 : ℝ) := by
    rw [hw, hK1]; rfl
  have hw2e : w.2 = (Jpow (bandIdx h γ.1) Y₀ - c).2 - (K2 : ℝ) := by
    rw [hw, hK2]; rfl
  have hround : ∀ (x : ℝ) (K : ℤ), |x - (K : ℝ)| < 1/2 → round x = K := by
    intro x K hx
    rw [round_eq, Int.floor_eq_iff]
    obtain ⟨a, b⟩ := abs_lt.mp hx
    constructor <;> linarith
  have hJc : Continuous (fun Y' : ℝ × ℝ => Jpow (bandIdx h γ.1) Y' - c) := by
    unfold Jpow; fun_prop
  obtain ⟨V, hV⟩ : ∃ V : Set (ℝ × ℝ), V =
      {Y' : ℝ × ℝ | |(Jpow (bandIdx h γ.1) Y' - c).1 - (K1 : ℝ)| < 1/2} ∩
      {Y' : ℝ × ℝ | |(Jpow (bandIdx h γ.1) Y' - c).2 - (K2 : ℝ)| < 1/2} := ⟨_, rfl⟩
  have hVo : IsOpen V := by
    rw [hV]
    exact (isOpen_lt ((hJc.fst).sub continuous_const).abs continuous_const).inter
      (isOpen_lt ((hJc.snd).sub continuous_const).abs continuous_const)
  have hYV : Y₀ ∈ V := by
    rw [hV]
    refine ⟨?_, ?_⟩
    · show |(Jpow (bandIdx h γ.1) Y₀ - c).1 - (K1 : ℝ)| < 1/2
      rw [← hw1e]; exact hw1
    · show |(Jpow (bandIdx h γ.1) Y₀ - c).2 - (K2 : ℝ)| < 1/2
      rw [← hw2e]; exact hw2
  have hfr : ∀ Y' ∈ V, rectW h γ c Y' =
      Jpow (bandIdx h γ.1) Y' - c - ((K1 : ℝ), (K2 : ℝ)) := by
    intro Y' hY'
    rw [hV] at hY'
    have r1 : round ((Jpow (bandIdx h γ.1) Y' - c).1) = K1 := hround _ _ hY'.1
    have r2 : round ((Jpow (bandIdx h γ.1) Y' - c).2) = K2 := hround _ _ hY'.2
    unfold rectW frac0
    rw [r1, r2]
    ext <;> simp
  have hlamT_lin : ∀ a b : ℝ × ℝ, lamT (a - b) = lamT a - lamT b := by
    intro a b
    simp only [lamT, Prod.fst_sub, Prod.snd_sub]
    ring
  have hlamJ : ∀ Y' : ℝ × ℝ, lamT (Jpow (bandIdx h γ.1) Y') = Tgc ^ bandIdx h γ.1 * lamT Y' := by
    intro Y'
    simp only [lamT, Jpow, vrv, vtv, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    field_simp
    ring
  refine ⟨V, lamT c + lamT ((K1 : ℝ), (K2 : ℝ)), hVo, hYV, fun Y hY => ?_⟩
  simp only [etG]
  rw [hfr _ hY, hlamT_lin, hlamT_lin, hlamJ]
  ring

theorem lnorm_lamT_slope_v5 : ∀ (h : ℝ) (ξ : Cyl) (l : ℕ), h ≤ 1 → 1 ≤ l → 0 ≤ coarseIdx h (qC h ξ) → ∀ w : Cyl, |Tgc ^ (bandIdx h l) * lamT ((Lnorm h ξ w).2.2.2)| ≤ 2 * (4:ℝ) ^ l * ‖w‖ :=
by
  intro h ξ l hh hl hci w
  have hs2 : Real.sqrt 2 < 2 := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
  have hs1 : 1 < Real.sqrt 2 := Real.one_lt_sqrt_two
  have hb0 : 0 ≤ bgc := by unfold bgc; linarith
  have hb1 : bgc ≤ 1 := by unfold bgc; linarith
  have hc1 : 1 ≤ 1 + bgc ^ 2 := le_add_of_nonneg_right (sq_nonneg _)
  have hc0 : 0 < 1 + bgc ^ 2 := by linarith
  have hcne : 1 + bgc ^ 2 ≠ 0 := hc0.ne'
  have hT1 : 1 < Tgc := by unfold Tgc; linarith
  have hTpos : 0 < Tgc := by linarith
  have hTne1 : Tgc ≠ 1 := hT1.ne'

  have hJ1 : ∀ (m : ℤ) (Y : ℝ × ℝ), (JpowL m Y).1 =
      Y.1 * (Jpow m (1, 0)).1 + Y.2 * (Jpow m (0, 1)).1 := by
    intro m Y
    simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
      ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Prod.fst_add, Prod.smul_fst,
      smul_eq_mul]
  have hJ2 : ∀ (m : ℤ) (Y : ℝ × ℝ), (JpowL m Y).2 =
      Y.1 * (Jpow m (1, 0)).2 + Y.2 * (Jpow m (0, 1)).2 := by
    intro m Y
    simp only [JpowL, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
      ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', Prod.snd_add, Prod.smul_snd,
      smul_eq_mul]
  have c1 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).1 =
      Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) + Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) * bgc := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have c2 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).2 =
      -(Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) * bgc) + Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk]
    ring
  have heig : ∀ (m : ℤ) (Y : ℝ × ℝ), lamT (JpowL m Y) = Tgc ^ m * lamT Y := by
    intro m Y
    unfold lamT
    rw [hJ1, hJ2, c1, c1, c2, c2]
    field_simp
    ring
  have hY : (Lnorm h ξ w).2.2.2 = JpowL (-(coarseIdx h (qC h ξ))) w.2.2.2 := rfl
  set ci := coarseIdx h (qC h ξ) with hci_def
  set N := bandIdx h l with hN
  set v := w.2.2.2 with hv
  have hLHS : Tgc ^ N * lamT ((Lnorm h ξ w).2.2.2) = Tgc ^ (N - ci) * lamT v := by
    rw [hY, heig, ← mul_assoc, ← zpow_add₀ hTpos.ne', sub_eq_add_neg]

  have hpow1 : Tgc ^ (N - ci) ≤ Tgc ^ N :=
    zpow_le_zpow_right₀ hT1.le (by linarith)
  have hpos : 0 < Tgc ^ (N - ci) := zpow_pos hTpos _
  have hl1 : (1 : ℝ) ≤ (l : ℝ) := Nat.one_le_cast.mpr hl
  have hl2 : (1 : ℝ) ≤ (l : ℝ) ^ 2 := one_le_pow₀ hl1
  have hx : 0 < (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) :=
    div_pos (Real.rpow_pos_of_pos two_pos _) (by positivity)
  have hfl : (N : ℝ) ≤ Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2)) := by
    rw [hN]; unfold bandIdx; exact Int.floor_le _
  have hpow2 : Tgc ^ N ≤ (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) := by
    rw [← Real.rpow_intCast]
    calc Tgc ^ (N : ℝ) ≤ Tgc ^ (Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2))) :=
          Real.rpow_le_rpow_of_exponent_le hT1.le hfl
      _ = _ := Real.rpow_logb hTpos hTne1 hx
  have hpow3 : (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) ≤ (2:ℝ) ^ ((1 + h) * (l:ℝ)) :=
    div_le_self (Real.rpow_pos_of_pos two_pos _).le hl2
  have hpow4 : (2:ℝ) ^ ((1 + h) * (l:ℝ)) ≤ (2:ℝ) ^ ((2:ℝ) * (l:ℝ)) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num)
      (mul_le_mul_of_nonneg_right (by linarith) (by linarith))
  have hpow5 : (2:ℝ) ^ ((2:ℝ) * (l:ℝ)) = (4:ℝ) ^ l := by
    rw [Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2), Real.rpow_two, Real.rpow_natCast]
    norm_num
  have hP : Tgc ^ (N - ci) ≤ (4:ℝ) ^ l := by
    linarith

  have hv1 : |v.1| ≤ ‖v‖ := by rw [← Real.norm_eq_abs]; exact norm_fst_le v
  have hv2 : |v.2| ≤ ‖v‖ := by rw [← Real.norm_eq_abs]; exact norm_snd_le v
  have hvw : ‖v‖ ≤ ‖w‖ := ((norm_snd_le w.2.2).trans (norm_snd_le w.2)).trans (norm_snd_le w)
  have hlam : |lamT v| ≤ 2 * ‖w‖ := by
    unfold lamT
    rw [abs_div, abs_of_pos hc0]
    have hnum : |bgc * v.1 + v.2| ≤ 2 * ‖w‖ := by
      have ha := abs_add_le (bgc * v.1) v.2
      rw [abs_mul, abs_of_nonneg hb0] at ha
      have hbv : bgc * |v.1| ≤ ‖v‖ := by
        calc bgc * |v.1| ≤ 1 * |v.1| := mul_le_mul_of_nonneg_right hb1 (abs_nonneg _)
          _ ≤ ‖v‖ := by linarith
      linarith
    exact (div_le_self (abs_nonneg _) hc1).trans hnum
  rw [hLHS, abs_mul, abs_of_pos hpos]
  calc Tgc ^ (N - ci) * |lamT v| ≤ (4:ℝ) ^ l * (2 * ‖w‖) :=
        mul_le_mul hP hlam (abs_nonneg _) (by positivity)
    _ = 2 * (4:ℝ) ^ l * ‖w‖ := by ring

theorem src_coeff_nb_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → (∀ (γ : Lab) (ξ : Cyl), 1 ≤ γ.1 → 0 < ξ.1 → ξ.2.2.1 < 1 → qC B.h ξ ≤ 1/256 → 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → ∃ O : Set Cyl, IsOpen O ∧ ξ ∈ O ∧ ContDiffOn ℝ ∞ (fun η : Cyl => (1 - psiW B G γ η) * rhoQ B γ η ^ (-(Aex B.h + 1))) O ∧ (|vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 - Lsb B.h G.r0 γ.1 / 2| < Lsb B.h G.r0 γ.1 / 5 → ∀ η ∈ O, psiW B G γ η = 1)) ∧ ∀ i : ℕ, ∃ K : ℝ, ∀ (γ : Lab) (ξ : Cyl), 1 ≤ γ.1 → 0 < ξ.1 → ξ.2.2.1 < 1 → qC B.h ξ ≤ 1/256 → 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → NB B.h (fun η : Cyl => (1 - psiW B G γ η) * rhoQ B γ η ^ (-(Aex B.h + 1))) i ξ ≤ K * (4:ℝ) ^ (i * γ.1) :=
by
  intro B G hok hG
  have h0 : 0 < B.h := hok.2.1.1
  have h1 : B.h < 1/100 := hok.2.1.2.1
  have hr0 : 0 < G.r0 := hG.1.1
  have hcibpos : ∀ l : ℕ, 0 < cib B.h l := fun l =>
    mul_pos (zpow_pos (by unfold Tgc; positivity) _) (Real.rpow_pos_of_pos (by unfold Qb; positivity) _)

  have hclosed : ∀ (γ : Lab) (η : Cyl), psiW B G γ η =
      Real.smoothTransition (5/2 - 15 / (4 * G.r0) * |etG B.h γ (G.ctr γ) η.2.2.2|) := by
    intro γ η
    have hk := hcibpos γ.1
    have hk0 : cib B.h γ.1 ≠ 0 := hk.ne'
    have hr00 : G.r0 ≠ 0 := hr0.ne'
    unfold psiW psiT Lsb vco
    congr 1
    have e1 : (etG B.h γ (G.ctr γ) η.2.2.2 + G.r0) / cib B.h γ.1 - 2 * G.r0 / cib B.h γ.1 / 2 =
        etG B.h γ (G.ctr γ) η.2.2.2 / cib B.h γ.1 := by field_simp; ring
    rw [e1, abs_div, abs_of_pos hk]
    field_simp
    ring
  have hplat_iff : ∀ (γ : Lab) (Y : ℝ × ℝ),
      |vco B.h G.r0 γ (G.ctr γ) Y - Lsb B.h G.r0 γ.1 / 2| < Lsb B.h G.r0 γ.1 / 5 →
      |etG B.h γ (G.ctr γ) Y| < 2 * G.r0 / 5 := by
    intro γ Y hP
    have hk := hcibpos γ.1
    have hk0 : cib B.h γ.1 ≠ 0 := hk.ne'
    unfold vco Lsb at hP
    have e1 : (etG B.h γ (G.ctr γ) Y + G.r0) / cib B.h γ.1 - 2 * G.r0 / cib B.h γ.1 / 2 =
        etG B.h γ (G.ctr γ) Y / cib B.h γ.1 := by field_simp; ring
    have e2 : 2 * G.r0 / cib B.h γ.1 / 5 = (2 * G.r0 / 5) / cib B.h γ.1 := by ring
    rw [e1, abs_div, abs_of_pos hk, e2] at hP
    exact (div_lt_div_iff_of_pos_right hk).mp hP

  obtain ⟨Λ, hΛ⟩ : ∃ Λ : ℤ → Cyl →L[ℝ] ℝ, ∀ (N : ℤ) (η : Cyl), Λ N η = Tgc ^ N * lamT η.2.2.2 := by
    refine ⟨fun N => (Tgc ^ N) • ((((bgc / (1 + bgc ^ 2)) • ContinuousLinearMap.fst ℝ ℝ ℝ +
      (1 / (1 + bgc ^ 2)) • ContinuousLinearMap.snd ℝ ℝ ℝ)).comp
      ((ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
        (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))))), fun N η => ?_⟩
    simp [lamT]
    ring

  have hloc : ∀ (γ : Lab) (ξ : Cyl), ξ.2.2.1 < 1 → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 →
      |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 →
      ∃ (Ω : Set Cyl) (d : ℝ), IsOpen Ω ∧ ξ ∈ Ω ∧ (∀ η ∈ Ω, η.2.2.1 < 1) ∧
        ∀ η ∈ Ω, etG B.h γ (G.ctr γ) η.2.2.2 = Λ (bandIdx B.h γ.1) η + (-d) := by
    intro γ ξ ht hxi het
    obtain ⟨W, d, hWo, hξW, hW⟩ := etG_local_affine_v5 B.h γ (G.ctr γ) ξ.2.2.2 hxi het
    refine ⟨{η : Cyl | η.2.2.2 ∈ W} ∩ {η : Cyl | η.2.2.1 < 1}, d, ?_, ⟨hξW, ht⟩,
      fun η hη => hη.2, fun η hη => ?_⟩
    · exact (hWo.preimage (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    · rw [hW _ hη.1, hΛ]
      ring
  obtain ⟨hΦs, hΦb, hΘ1⟩ := theta_profile_v5 G.r0 hr0
  obtain ⟨hρs, hρb⟩ := rhoQ_rpow_nb_v5 B hok (-(Aex B.h + 1))
  have hF1 : ∀ (N : ℤ) (d : ℝ), ContDiff ℝ ∞
      (fun η : Cyl => 1 - Real.smoothTransition (5/2 - 15 / (4 * G.r0) * |Λ N η + (-d)|)) :=
    fun N d => hΦs.comp ((Λ N).contDiff.add contDiff_const)
  have hcontA : ∀ (N : ℤ) (d : ℝ), Continuous (fun η : Cyl => |Λ N η + (-d)|) :=
    fun N d => continuous_abs.comp ((Λ N).continuous.add continuous_const)
  refine ⟨?_, ?_⟩
  · intro γ ξ hγ1 hξ1 hξ2 hq256 hr1 hr2 hxi het
    obtain ⟨Ω, d, hΩo, hξΩ, hΩt, hΩe⟩ := hloc γ ξ hξ2 hxi het
    have hpsiΩ : ∀ η ∈ Ω, psiW B G γ η =
        Real.smoothTransition (5/2 - 15 / (4 * G.r0) * |Λ (bandIdx B.h γ.1) η + (-d)|) := by
