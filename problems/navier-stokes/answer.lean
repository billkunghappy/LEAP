          _ = φ x ^ 3 * ‖w x‖ ^ 2 + φ x ^ 3 * v x := by ring
          _ ≤ _ := by have := mul_le_of_le_one_left (hv0 x) hp1; linarith
      calc _ ≤ ENNReal.ofReal ((φ x ^ 3 * ‖w x‖ ^ 2 + v x) ^ ((4:ℝ)/3)) :=
            ENNReal.ofReal_le_ofReal
              (Real.rpow_le_rpow (mul_nonneg hp0 (abs_nonneg _)) hle (by norm_num))
