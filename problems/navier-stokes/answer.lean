      rw [hιa]
      have ha1 : ‖a.1‖ ≤ ‖a‖ := norm_fst_le a
      have ha2 : ‖a.2.1‖ ≤ ‖a‖ := (norm_fst_le a.2).trans (norm_snd_le a)
      have ha3 : ‖a.2.2‖ ≤ ‖a‖ := (norm_snd_le a.2).trans (norm_snd_le a)
      have hn : 0 ≤ ‖a‖ := norm_nonneg a
      have hm1 : 1 ≤ max 1 u := le_max_left _ _
      have hmu : u ≤ max 1 u := le_max_right _ _
      have hb1 : ‖u * a.1‖ ≤ max 1 u * ‖a‖ := by
        rw [norm_mul, Real.norm_of_nonneg hu.le]
        exact mul_le_mul hmu ha1 (norm_nonneg _) hM0u
      have hb2 : ‖a.2.1‖ ≤ max 1 u * ‖a‖ :=
        ha2.trans (le_mul_of_one_le_left hn hm1)
      have hb3 : ‖a.2.2‖ ≤ max 1 u * ‖a‖ :=
        ha3.trans (le_mul_of_one_le_left hn hm1)
      have hb4 : ‖(0 : ℝ × ℝ)‖ ≤ max 1 u * ‖a‖ := by
        rw [norm_zero]; exact mul_nonneg hM0u hn
      exact norm_prod_le_iff.mpr ⟨hb1, norm_prod_le_iff.mpr ⟨hb2, norm_prod_le_iff.mpr ⟨hb3, hb4⟩⟩⟩
    rw [hgfun, e1, hfac]
    calc ‖((iteratedFDeriv ℝ i F ξu).compContinuousLinearMap (fun _ => Lnorm B.h ξu)).compContinuousLinearMap
          (fun _ => ι)‖
