        intro x _; rw [Finset.sum_const, nsmul_eq_mul]
      rw [Finset.sum_product]
      dsimp only
      rw [Finset.sum_congr rfl hinner, ← Finset.mul_sum, ← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
