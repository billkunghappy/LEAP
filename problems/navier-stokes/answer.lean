    calc q * (E * (b * w2) + X3 * (b * ws)) = q * (b * (E * w2 + X3 * ws)) := by ring
      _ ≤ P * (b * (2 * (B2 + B1))) :=
          mul_le_mul hqP (mul_le_mul_of_nonneg_left hs hb') (mul_nonneg hb' (add_nonneg hE hX))
            (le_trans hq hqP)
      _ = _ := by ring
  rw [hb2, hb4]
  rw [show 2 * ((48 * Real.pi * c) ^ ((3:ℝ)/4) / Real.pi) * (8 * c) * (2 * (C₀ + 2 * M * (V + C₀))
      * C₀ ^ ((1:ℝ)/8) * K ^ ((3:ℝ)/4) + 2 ^ ((1:ℝ)/4) * (2 * C₀ ^ ((9:ℝ)/8) * K ^ ((3:ℝ)/4)
      + 2 * M * (V + C₀) ^ ((3:ℝ)/4) * C₀ ^ ((1:ℝ)/2))) / R * (1 + I ^ ((3:ℝ)/4))
      = ((48 * Real.pi * c) ^ ((3:ℝ)/4) / Real.pi) * (8 * c / R) *
        (2 * (2 * (C₀ + 2 * M * (V + C₀)) * C₀ ^ ((1:ℝ)/8) * K ^ ((3:ℝ)/4) * (1 + I ^ ((3:ℝ)/4))
          + 2 ^ ((1:ℝ)/4) * (2 * C₀ ^ ((9:ℝ)/8) * K ^ ((3:ℝ)/4)
            + 2 * M * (V + C₀) ^ ((3:ℝ)/4) * C₀ ^ ((1:ℝ)/2)) * (1 + I ^ ((3:ℝ)/4)))) by ring]
  exact alg _ _ _ _ _ _ _ _ _ hQ hq0 hb hT1n hT2n hT1 hT2

theorem flux_commutator_estimate : ∀ (C₀ M Ru K c₁ : ℝ), 0 < c₁ → ∃ C₂ : ℝ, 0 ≤ C₂ ∧ ∀ (w u : ℝ³ → ℝ³) (φ β : ℝ³ → ℝ) (R I : ℝ) (i j : Fin 3), 1 ≤ R → 0 ≤ I → Continuous w → Continuous u → Continuous φ → HasCompactSupport φ → (∀ x, 0 ≤ φ x ∧ φ x ≤ 1) → Continuous β → MemLp w 2 → (∫ x, ‖w x‖ ^ 2) ≤ C₀ → (∀ x, ‖u x‖ ≤ M) → (∀ x, Ru ≤ ‖x‖ → u x = 0) → (∀ x, |β x| ≤ 8 * c₁ / R * φ x * ‖w x‖) → (∀ x y, |φ y ^ 6 - φ x ^ 6| ≤ min 1 (3 * c₁ / R * ‖x - y‖) * (φ x ^ 3 + φ y ^ 3)) → (∫ x, φ x ^ 24 * ‖w x‖ ^ 6) ^ ((1 : ℝ) / 6) ≤ K * (1 + I ^ ((1 : ℝ) / 2)) → (∫⁻ x, ‖w x i * w x j + w x i * u x j + u x i * w x j‖ₑ * ∫⁻ y, ENNReal.ofReal (Real.pi⁻¹ * (‖x - y‖⁻¹) ^ 3 * |φ y ^ 6 - φ x ^ 6| * |β y|)) ≤ ENNReal.ofReal (C₂ / R * (1 + I ^ ((3 : ℝ) / 4))) :=
