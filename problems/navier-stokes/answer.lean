    have eP : (fun Y => P Y η) =
        (fun w : ℝ × ℝ × ℝ => P w.2.1 w.2.2) ∘ (fun Y : ℝ => (Real.log q, Y, η)) := rfl
    have dG : HasDerivAt (fun Y => G q Y η)
        (fderiv ℝ (logLift G) (Real.log q, X, η) ((0:ℝ), (1:ℝ), (0:ℝ))) X := by
      rw [eG]; exact hG.hasFDerivAt.comp_hasDerivAt X hμ
    have dP : HasDerivAt (fun Y => P Y η)
        (fderiv ℝ (fun w : ℝ × ℝ × ℝ => P w.2.1 w.2.2) (Real.log q, X, η) ((0:ℝ), (1:ℝ), (0:ℝ))) X := by
      rw [eP]; exact hP.hasFDerivAt.comp_hasDerivAt X hμ
    have hD : DifferentiableAt ℝ (fun w : ℝ × ℝ × ℝ => logLift G w - P w.2.1 w.2.2) (Real.log q, X, η) :=
      hG.sub hP
    have dD : HasDerivAt (fun Y => G q Y η - P Y η)
        (fderiv ℝ (fun w : ℝ × ℝ × ℝ => logLift G w - P w.2.1 w.2.2) (Real.log q, X, η)
          ((0:ℝ), (1:ℝ), (0:ℝ))) X := by
      have e : (fun Y => G q Y η - P Y η) =
          (fun w : ℝ × ℝ × ℝ => logLift G w - P w.2.1 w.2.2) ∘ (fun Y : ℝ => (Real.log q, Y, η)) := by
        funext Y; simp [logLift, Real.exp_log hq]
