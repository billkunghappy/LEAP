theorem pulse_tw_star_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (α : ℝ) (f : WC), InWg5 B G (qsOf l0) α f → ∀ k : ℕ, ∃ C b d : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), ξ ∈ tsupport (pulseTw5 B G f γ m) → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → 0 < vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 → vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 < Lsb B.h G.r0 γ.1 → NB B.h (pulseTw5 B G f γ m) k ξ ≤ C * qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ b * Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) * Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) :=
