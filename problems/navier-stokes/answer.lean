          rw [uIoc_of_le hab] at hy
          rw [Real.norm_eq_abs]; exact hB y hy.1.le hy.2)
      rw [Real.norm_eq_abs, abs_of_nonneg (sub_nonneg.mpr hab)] at this
      linarith

  have hIccS : Icc (-1:ℝ) 1 ⊆ Ioo (-1 - rP) (1 + rP) :=
    fun x hx => ⟨by linarith [hx.1], by linarith [hx.2]⟩
  obtain ⟨B0, hB0⟩ := isCompact_Icc.exists_bound_of_continuousOn (hPax.continuousOn.mono hIccS)
  obtain ⟨B1, hB1⟩ := isCompact_Icc.exists_bound_of_continuousOn
