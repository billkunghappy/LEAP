  have hV : ∀ (γ : Lab) (m : ℤ) (ξ : Cyl), ξ ∉ tsupport (a γ m) →
      (fun η => dotProduct (N γ m η) (a γ m η)) =ᶠ[nhds ξ] fun _ => (0 : ℂ) := by
    intro γ m ξ hξ
