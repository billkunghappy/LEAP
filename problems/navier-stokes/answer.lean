            (nhdsWithin ξ.1 (Iio ξ.1)) (nhds 0) := tendsto_const_nhds.congr' hev.symm
        exact tendsto_nhds_unique h1 h2
    · rcases hX.lt_or_eq with hlt | heq
      · exact hstrict i ξ hξ (Or.inr hlt)
      · have hev : (fun s : ℝ => iteratedFDeriv ℝ i F ((s, ξ.2) : Cyl)) =ᶠ[nhdsWithin ξ.1 (Ioi ξ.1)]
            (fun _ => 0) := by
          filter_upwards [Ioo_mem_nhdsGT (show ξ.1 < ξ.1 + 1 by linarith)] with s hs
          apply hstrict i _ (hγmem s (lt_trans hr hs.1))
          right
          rw [hXCs, heq, hXCξ]
          exact div_lt_div_of_pos_right (pow_lt_pow_left₀ hs.1 hr.le two_ne_zero) (by linarith)
        have h1 := hT.mono_left (nhdsWithin_le_nhds (s := Ioi ξ.1))
        have h2 : Filter.Tendsto (fun s : ℝ => iteratedFDeriv ℝ i F ((s, ξ.2) : Cyl))
            (nhdsWithin ξ.1 (Ioi ξ.1)) (nhds 0) := tendsto_const_nhds.congr' hev.symm
        exact tendsto_nhds_unique h1 h2

  refine ⟨C0, b, d, hd0, ?_⟩
  intro ξ0 hξ0 c c' D hc hcc' hc'D
