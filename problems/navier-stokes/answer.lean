theorem rfp_inter_scalar : ∀ lam Pst y2 y η N E Q : ℝ, 0 < lam → 1 ≤ Pst → y2 + 1 ≤ y → lam * (y - y2 + 1) ≤ 1 → 10 ^ 7 * Pst ^ 2 * lam * (1 + y) ^ 2 ≤ 1 → |N| ≤ 200 * Pst ^ 2 * (1 + y) * |η| * Real.exp (-y) → Pst * Real.exp (-(y / 2) - lam * (y - y2)) / 2 ≤ E → lam / 16 + 3 / 10 * η ^ 2 + Real.exp (-y2 - (1 - lam) * (y - y2 - 1)) / 10 ≤ Q → lam * (N / (E * Q)) ^ 2 ≤ 1 / 2 :=
