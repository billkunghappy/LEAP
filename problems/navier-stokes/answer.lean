    have hDb := Dbd Q H (c q) _ (h u) hQpos hx2 (hhlow u) (hhH u)
    have hD1 : |Dn q u| ≤ 2 + H / Real.sqrt Q := by rw [hDn]; exact hDb.1
    have hcD : -1 ≤ c q * Dn q u := by rw [hDn]; exact hDb.2 hcQ

    have hTτ : |ts q + s q * Dn q u| ≤ τ := by
      have hb' : |ts q| ≤ A / μ := by
        rw [htsq, abs_neg, abs_div, abs_of_pos ha]
