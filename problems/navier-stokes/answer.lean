    (contDiffOn_const.mul hKW).add (contDiffOn_const.mul hDW)
  refine ⟨?_, ?_, ?_⟩
  ·
    rw [hf]
    exact (hrW.mul hgW).contDiffAt (hWo.mem_nhds hξW)
  ·
    have hra : ∀ i' : ℕ, i' ≤ k → NB B.h (fun η => (qC B.h η / Qb γ.1) ^ (1 + B.h)) i' ξ ≤ Arc := by
      intro i' hi'
      have h1 := hKr i' (Qb γ.1) hQ ξ hξ1
      have h2 : Krf i' ≤ ∑ j ∈ Finset.range (k + 1), Krf j :=
