  have t_main : ∀ (Xi : ℝ) (r : ℝ → ℝ → ℝ), 0 < Xi → BgHolo Xi r →
      ∀ (kk : ℝ → ℝ), ContinuousOn kk (Ioc 0 1) → IntervalIntegrable kk volume 0 1 →
      BgHolo Xi (bgKer kk r) ∧ ∀ X η : ℝ, 0 < X → X < Xi → -1 < η → η < 1 →
        pdE (bgKer kk r) X η = bgKer kk (pdE r) X η := by
    intro Xi r hXi hr kk hkc hki
