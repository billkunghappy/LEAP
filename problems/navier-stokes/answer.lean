        (volume.restrict (Iic (Real.log x))) := (iB2 3).const_mul _
    have j4 : Integrable (fun y => (((1 + e ^ 2)⁻¹) ^ 2 * P.c2 e ^ 2) *
        (Real.exp (y + 2 * rfpLam P y) * rfpBmp (y - rfpY4 P.Md P.lam + 1) ^ 2))
