  have hEs' : ∀ (γ : Lab) (N : ℤ), ContDiffOn ℝ ∞ (E γ N) (DomC B.h (qsOf l0)) := by
    subst hEd; exact hEs
  have hEb' : ∀ k : ℕ, ∃ C b d : ℝ, ∀ (γ : Lab) (N : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ →
      XC B.h ξ < B.Xb → NB B.h (E γ N) k ξ ≤ C * qC B.h ξ ^ (B.h * (Bo + Bo - kapS)) * SC B.h ξ ^ b *
        Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)) * edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-d) *
        Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
