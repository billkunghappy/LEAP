    have hT1 : 1 < Tgc := by unfold Tgc; linarith
    have hT0 : Tgc ≠ 0 := by linarith
    have hJ : ∀ (n : ℤ) (s : ℝ), JpowL n (s • vtv) = (s * Tgc ^ n) • vtv := by
