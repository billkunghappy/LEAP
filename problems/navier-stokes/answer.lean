        apply integral_mono_of_nonneg
        · exact ae_of_all _ (fun y => hf0 y)
        · exact (by fun_prop : Continuous fun y : ℝ =>
            11 * (A * Real.exp K) * Real.exp (s * (y - y0))).integrableOn_Icc
        · rw [Filter.EventuallyLE, ae_restrict_iff' measurableSet_Icc]
