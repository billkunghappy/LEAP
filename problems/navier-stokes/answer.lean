    obtain ⟨gC, hgC⟩ : ∃ g : ℝ →L[ℝ] (Fin 3 → ℂ), ∀ x : ℝ, g x = ![0, 0, -(x:ℂ) / 2] :=
      ⟨(ContinuousLinearMap.id ℝ ℝ).smulRight ![0, 0, (-1/2 : ℂ)], fun x => by
