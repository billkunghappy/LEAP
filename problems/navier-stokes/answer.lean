    fun γ m ξ hξ hts => h2 l0 (by omega) α (cutA B G tw) ha γ m ξ hξ hts
  have hcoef : ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      ξ ∈ tsupport (cutA B G tw γ m) →
      dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) ≠ 0 ∧ ContDiffAt ℝ ∞ (pulseMult5 B G γ m) ξ ∧
      NB B.h (pulseMult5 B G γ m) k ξ ≤ C * qC B.h ξ ^ (B.h * (1/2)) * SC B.h ξ ^ b ∧
      ∀ c : ℝ × ℝ, IsDeck B.h (qC B.h ξ) c → pulseMult5 B G γ m (shY ξ c) = pulseMult5 B G γ m ξ := by
    intro k
    obtain ⟨C, b, hC⟩ := h3 k
    refine ⟨C, b, fun γ m ξ hξ hts => ?_⟩
    obtain ⟨-, hA, hl, q1, q2, x1, x2, e1, e2⟩ := hgood γ m ξ hξ hts
    exact hC l0 (by omega) γ m hA hl ξ hξ q1 q2 x1 x2 e1 e2

  have hrep : potOf5 B G tw = fun γ m ξ => crossC (pulseMult5 B G γ m ξ) (cutA B G tw γ m ξ) := by
    funext γ m ξ
    by_cases hm : m = 0
    · funext i
      fin_cases i <;> simp [potOf5, pulseMult5, hm, crossC]
    · funext i
      fin_cases i <;> simp [potOf5, pulseMult5, hm, crossC, cutA] <;> ring

  have hD : InWg5 B G (qsOf l0) (α + 1/2) (potOf5 B G tw) := by
    rw [hrep]
    refine inWg5_cross_mult B G l0 hok α (1/2) (cutA B G tw) (pulseMult5 B G) ha ?_ ?_ ?_
    · intro γ m ξ hξ hts
      obtain ⟨C, b, hC⟩ := hcoef 0
      exact (hC γ m ξ hξ hts).2.1
    · intro γ m ξ hξ hne c hc
      obtain ⟨C, b, hC⟩ := hcoef 0
      exact (hC γ m ξ hξ (subset_tsupport _ hne)).2.2.2 c hc
    · intro k
      obtain ⟨C, b, hC⟩ := hcoef k
      exact ⟨C, b, fun γ m ξ hξ hts _ _ => (hC γ m ξ hξ hts).2.2.1⟩

  have hR : InWg5 B G (qsOf l0) (α + 1/2 - kapS) (velRem5 B (potOf5 B G tw)) :=
    h4 l0 (by omega) (α + 1/2) (potOf5 B G tw) hD

  have hstruct : ∀ (D : WC) (γ : Lab) (m : ℤ) (ξ : Cyl), velW5 B G D γ m ξ =
      (Complex.I * ((kb B.h γ.1 : ℂ) * (m : ℂ))) • crossC (nPhiC5 B G γ ξ) (D γ m ξ) + velRem5 B D γ m ξ := by
    intro D γ m ξ
    funext i
    fin_cases i <;> simp [velW5, velC5, velRem5, crossC, nPhiC5] <;> ring

  have alg : ∀ (K s c : ℂ) (n a : Fin 3 → ℂ), c * (K * s) = Complex.I →
      s = n 0 * n 0 + n 1 * n 1 + n 2 * n 2 → n 0 * a 0 + n 1 * a 1 + n 2 * a 2 = 0 →
      (Complex.I * K) • crossC n (c • crossC n a) = a := by
    intro K s c n a hc hs hd
    have e0 : ((Complex.I * K) • crossC n (c • crossC n a)) 0 = a 0 := by
      simp [crossC]
      linear_combination (Complex.I * K * c * n 0) * hd + (-Complex.I * a 0) * hc +
        (Complex.I * K * c * a 0) * hs - a 0 * Complex.I_mul_I
    have e1 : ((Complex.I * K) • crossC n (c • crossC n a)) 1 = a 1 := by
      simp [crossC]
      linear_combination (Complex.I * K * c * n 1) * hd + (-Complex.I * a 1) * hc +
        (Complex.I * K * c * a 1) * hs - a 1 * Complex.I_mul_I
    have e2 : ((Complex.I * K) • crossC n (c • crossC n a)) 2 = a 2 := by
      simp [crossC]
      linear_combination (Complex.I * K * c * n 2) * hd + (-Complex.I * a 2) * hc +
        (Complex.I * K * c * a 2) * hs - a 2 * Complex.I_mul_I
    funext i
    fin_cases i
    · exact e0
    · exact e1
    · exact e2

  have hprin : ∀ (γ : Lab) (m : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      velW5 B G (potOf5 B G tw) γ m ξ = cutA B G tw γ m ξ + velRem5 B (potOf5 B G tw) γ m ξ := by
    intro γ m ξ hξ
    rw [hstruct]
    congr 1
    by_cases ha0 : cutA B G tw γ m ξ = 0
    · have hD0 : potOf5 B G tw γ m ξ = 0 := by
        rw [hrep]
        show crossC (pulseMult5 B G γ m ξ) (cutA B G tw γ m ξ) = 0
        rw [ha0]
        funext i
        fin_cases i <;> simp [crossC]
      rw [hD0, ha0]
      funext i
      fin_cases i <;> simp [crossC]
    · have hm : m ≠ 0 := by
        intro hm
        apply ha0
        rw [show cutA B G tw γ m ξ = ((psiW B G γ ξ : ℝ) : ℂ) • tw γ m ξ from rfl, (h3c γ m hm).1]
        simp
      obtain ⟨C, b, hC⟩ := hcoef 0
      have hns : dotProduct (nPhi5 B G γ ξ) (nPhi5 B G γ ξ) ≠ 0 :=
        (hC γ m ξ hξ (subset_tsupport _ ha0)).1
      have hnsC : nsqC5 B G γ ξ ≠ 0 := by
        simp only [nsqC5]
        exact_mod_cast hns
      have hkb : (kb B.h γ.1 : ℂ) ≠ 0 := by
        have : 0 < kb B.h γ.1 := by
          unfold kb epsb Qb
          exact Nat.ceil_pos.mpr
            (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos two_pos _) _) _)
        exact_mod_cast this.ne'
      have hmC : (m : ℂ) ≠ 0 := Int.cast_ne_zero.mpr hm
      have hK : (kb B.h γ.1 : ℂ) * (m : ℂ) * nsqC5 B G γ ξ ≠ 0 :=
        mul_ne_zero (mul_ne_zero hkb hmC) hnsC
      have hc : Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ) * nsqC5 B G γ ξ) *
          ((kb B.h γ.1 : ℂ) * (m : ℂ) * nsqC5 B G γ ξ) = Complex.I := div_mul_cancel₀ _ hK
      have hpot : potOf5 B G tw γ m ξ = (Complex.I / ((kb B.h γ.1 : ℂ) * (m : ℂ) * nsqC5 B G γ ξ)) •
          crossC (nPhiC5 B G γ ξ) (cutA B G tw γ m ξ) := by
        simp only [potOf5, cutA, hm, ↓reduceIte]
      have hs : nsqC5 B G γ ξ = nPhiC5 B G γ ξ 0 * nPhiC5 B G γ ξ 0 + nPhiC5 B G γ ξ 1 * nPhiC5 B G γ ξ 1 +
          nPhiC5 B G γ ξ 2 * nPhiC5 B G γ ξ 2 := by
        simp only [nsqC5, nPhiC5, dotProduct, Fin.sum_univ_three]
        push_cast
        ring
      have hd : nPhiC5 B G γ ξ 0 * cutA B G tw γ m ξ 0 + nPhiC5 B G γ ξ 1 * cutA B G tw γ m ξ 1 +
          nPhiC5 B G γ ξ 2 * cutA B G tw γ m ξ 2 = 0 := by
        have h0 := h4c γ m ξ hξ
        simp only [dotProduct, Fin.sum_univ_three] at h0
        simp only [cutA, Pi.smul_apply, smul_eq_mul]
        linear_combination ((psiW B G γ ξ : ℝ) : ℂ) * h0
      rw [hpot]
      exact alg ((kb B.h γ.1 : ℂ) * (m : ℂ)) (nsqC5 B G γ ξ) _ (nPhiC5 B G γ ξ) (cutA B G tw γ m ξ) hc hs hd

  have hh0 : 0 ≤ B.h := hok.2.1.1.le
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hDq : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 ∧ 1 ≤ SC B.h ξ := by
    have hqs1 : qsOf l0 ≤ 1 := by
      show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
      exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
    intro ξ hξ
    obtain ⟨-, e2, e3⟩ := hξ
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    refine ⟨hq0, by linarith, ?_⟩
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hDsh : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ a, shY ξ a ∈ DomC B.h (qsOf l0) := fun ξ hξ _ => hξ
  have hEdge : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X ∧
      0 < edgeDist B.Xa B.Xb X ∧ edgeDist B.Xa B.Xb X ≤ 1 := by
    intro X e1 e2
    refine ⟨?_, ?_, min_le_left _ _⟩
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · have hX : 0 < X := lt_trans hXa e1
      have l1 : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr e1)
      have l2 : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX).mpr e2)
      exact lt_min one_pos (lt_min l1 l2)
  have hW : ∀ (q Sv E e P C1 C2 b1 b2 d1 d2 α α1 α2 N1 N2 : ℝ), 0 < q → q ≤ 1 → 1 ≤ Sv → 0 ≤ E →
      0 < e → e ≤ 1 → 0 ≤ P → α ≤ α1 → α ≤ α2 →
      N1 ≤ C1 * q ^ (B.h * α1) * Sv ^ b1 * E * e ^ (-d1) * P →
      N2 ≤ C2 * q ^ (B.h * α2) * Sv ^ b2 * E * e ^ (-d2) * P →
      N1 + N2 ≤ (|C1| + |C2|) * q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P := by
    intro q Sv E e P C1 C2 b1 b2 d1 d2 α α1 α2 N1 N2 hq0 hq1 hS1 hE he0 he1 hP0 ha1 ha2 hN1 hN2
    have key : ∀ (C b d αi N : ℝ), α ≤ αi → N ≤ C * q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P →
        b ≤ max b1 b2 → d ≤ max d1 d2 →
        N ≤ |C| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by
      intro C b d αi N hα hN hb hd
      have f1 : q ^ (B.h * αi) ≤ q ^ (B.h * α) :=
        Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (mul_le_mul_of_nonneg_left hα hh0)
      have f2 : Sv ^ b ≤ Sv ^ (max b1 b2) := Real.rpow_le_rpow_of_exponent_le hS1 hb
      have f3 : e ^ (-d) ≤ e ^ (-(max d1 d2)) :=
        Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hd)
      have p1 : 0 ≤ q ^ (B.h * αi) := Real.rpow_nonneg hq0.le _
      have p2 : 0 ≤ Sv ^ b := Real.rpow_nonneg (by linarith) _
      have p3 : 0 ≤ e ^ (-d) := Real.rpow_nonneg he0.le _
      have p1' : 0 ≤ q ^ (B.h * α) := Real.rpow_nonneg hq0.le _
      have p2' : 0 ≤ Sv ^ (max b1 b2) := Real.rpow_nonneg (by linarith) _
      have m1 : q ^ (B.h * αi) * Sv ^ b ≤ q ^ (B.h * α) * Sv ^ (max b1 b2) := mul_le_mul f1 f2 p2 p1'
      have m2 : q ^ (B.h * αi) * Sv ^ b * E ≤ q ^ (B.h * α) * Sv ^ (max b1 b2) * E :=
        mul_le_mul_of_nonneg_right m1 hE
      have m3 : q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) ≤
          q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) :=
        mul_le_mul m2 f3 p3 (mul_nonneg (mul_nonneg p1' p2') hE)
      have hWi := mul_le_mul_of_nonneg_right m3 hP0
      have hWi0 : 0 ≤ q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P :=
        mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg p1 p2) hE) p3) hP0
      calc N ≤ C * q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P := hN
        _ = C * (q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P) := by ring
        _ ≤ |C| * (q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P) :=
            mul_le_mul_of_nonneg_right (le_abs_self C) hWi0
        _ ≤ |C| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) :=
            mul_le_mul_of_nonneg_left hWi (abs_nonneg C)
    have k1 := key C1 b1 d1 α1 N1 ha1 hN1 (le_max_left _ _) (le_max_left _ _)
    have k2 := key C2 b2 d2 α2 N2 ha2 hN2 (le_max_right _ _) (le_max_right _ _)
    have e : (|C1| + |C2|) * q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P =
        |C1| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) +
        |C2| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by ring
    rw [e]
    linarith
  have hNB : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f1 f2 g : Cyl → V) (k : ℕ) (ξ : Cyl),
      ξ ∈ DomC B.h (qsOf l0) → ContDiffOn ℝ ∞ f1 (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ f2 (DomC B.h (qsOf l0)) →
      (∀ η ∈ DomC B.h (qsOf l0), g η = f1 η + f2 η) → NB B.h g k ξ ≤ NB B.h f1 k ξ + NB B.h f2 k ξ := by
    intro V _ _ f1 f2 g k ξ hξ hf1 hf2 heq
    have hn : DomC B.h (qsOf l0) ∈ nhds ξ := hDopen.mem_nhds hξ
    have hev : g =ᶠ[nhds ξ] f1 + f2 := Filter.eventuallyEq_of_mem hn (fun η hη => heq η hη)
    have e1 : iteratedFDeriv ℝ k g ξ = iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ := by
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      exact iteratedFDeriv_add_apply ((hf1.contDiffAt hn).of_le (by exact_mod_cast le_top))
        ((hf2.contDiffAt hn).of_le (by exact_mod_cast le_top))
    unfold NB
    rw [e1]
    have e2 : (iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) =
        (iteratedFDeriv ℝ k f1 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) +
        (iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    exact norm_add_le _ _
  have hInWg : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (α α1 α2 : ℝ)
      (a b c : Lab → ℤ → Cyl → V),
      InWg5 B G (qsOf l0) α1 a → InWg5 B G (qsOf l0) α2 b → α ≤ α1 → α ≤ α2 →
      (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → c γ m = 0) →
      (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), c γ m ξ = a γ m ξ + b γ m ξ) → InWg5 B G (qsOf l0) α c := by
    intro V _ _ α α1 α2 a b c ea eb ha1 ha2 hHc heq
    obtain ⟨-, sa, da, pa, ba⟩ := ea
    obtain ⟨-, sb, db, pb, bb⟩ := eb
    refine ⟨hHc, fun γ m => ((sa γ m).add (sb γ m)).congr (heq γ m), ?_, ?_, ?_⟩
    · intro γ m ξ hξ c' hc
      rw [heq γ m _ (hDsh ξ hξ c'), heq γ m ξ hξ, da γ m ξ hξ c' hc, db γ m ξ hξ c' hc]
    · intro γ m ξ hξ hne
      rw [heq γ m ξ hξ] at hne
      by_cases hA : a γ m ξ = 0
      · rw [hA, zero_add] at hne
        exact pb γ m ξ hξ hne
      · exact pa γ m ξ hξ hA
    · intro k
      obtain ⟨C1, c1, e1, hb1⟩ := ba k
      obtain ⟨C2, c2, e2, hb2⟩ := bb k
      refine ⟨|C1| + |C2|, max c1 c2, max e1 e2, fun γ m ξ hξ hX1 hX2 => ?_⟩
      obtain ⟨hq0, hq1, hS1⟩ := hDq ξ hξ
      obtain ⟨hE, he0, he1⟩ := hEdge _ hX1 hX2
      have hn := hNB (a γ m) (b γ m) (c γ m) k ξ hξ (sa γ m) (sb γ m) (heq γ m)
      have hP0 : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
        unfold Penv5
        exact (Real.exp_pos _).le
      exact le_trans hn (hW _ _ _ _ _ C1 C2 c1 c2 e1 e2 α α1 α2 _ _ hq0 hq1 hS1 (Real.sqrt_nonneg _)
        he0 he1 hP0 ha1 ha2 (hb1 γ m ξ hξ hX1 hX2) (hb2 γ m ξ hξ hX1 hX2))
  have hvz : ∀ (a : WC) (γ : Lab) (m : ℤ), a γ m = 0 → velW5 B G a γ m = 0 := by
    intro a γ m h
    funext ξ j
    fin_cases j <;> simp [velW5, velC5, DrC, DzC, dR, dZ, h]
  obtain ⟨H, H0, Hv⟩ := hD.1
  refine ⟨hD, ?_⟩
  exact hInWg α α (α + 1/2 - kapS) (cutA B G tw) (velRem5 B (potOf5 B G tw)) (velW5 B G (potOf5 B G tw))
    ha hR le_rfl (by rw [hk]; linarith) ⟨H, H0, fun γ m hm => hvz _ γ m (Hv γ m hm)⟩ hprin

theorem psi5_state_fields_smooth : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (α1 α2 β1 β2 : ℝ) (Y₀ : ℝ × ℝ), B.ok → GeomPrim5 B G → qsOf l0 ≤ B.qB → InWg5 B G (qsOf l0) α1 S.Aw → InWg5 B G (qsOf l0) α2 S.pw → InM B (qsOf l0) β1 S.Psi → InM B (qsOf l0) β2 S.bdir → ContDiffOn ℝ ∞ (pmP5 B G l0 S) (DomC B.h (qsOf l0)) → ContDiffOn ℝ ∞ (↿(evOff B.h (AX5 B G l0 S) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} ∧ ContDiffOn ℝ ∞ (↿(evOff B.h (uX5 B G l0 S) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} ∧ ContDiffOn ℝ ∞ (↿(evOff B.h (PX5 B G l0 S) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} :=
by
  intro B G l0 S α1 α2 β1 β2 Y₀ hok hG hqsB hAw hpw hPsi hbdir hpm
  obtain ⟨hΩo, hΨ, hQs, hrad, heR, heTh⟩ := corr_domain_v5 B l0 Y₀ hok
  set Ω : Set (ℝ³ × ℝ) := {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} with hΩdef
  set Ψ : ℝ³ × ℝ → Cyl := fun w => ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y₀) with hΨdef
  have hSP : SimScaleProps B.h := hok.1
  have hBP := hok.2
  unfold BackgroundProps at hBP
  obtain ⟨-, -, -, ⟨hABs, hBvBs, hPBs⟩, -, -⟩ := hBP
  have hΩmem : ∀ w ∈ Ω, corrOn B l0 w.1 w.2 := fun w hw => hw
  have hΩsub : Ω ⊆ simDomain B.h B.qB := fun w hw =>
    ⟨(hΩmem w hw).2.1, lt_of_lt_of_le (hΩmem w hw).2.2 hqsB⟩
  have hΨmaps : MapsTo Ψ Ω (DomC B.h (qsOf l0)) := fun w hw => hw
  have hQpos : ∀ w ∈ Ω, 0 < simScale B.h (w.1 2) (1 - w.2) := fun w hw =>
    (hSP.1 (w.1 2) (1 - w.2) (by linarith [(hΩmem w hw).2.1])).1
  have hQΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) Ω :=
    hQs.mono (fun w hw => (hΩmem w hw).2.1)
  have hQp : ∀ p : ℝ, ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2) ^ p) Ω :=
    fun p => hQΩ.rpow_const_of_ne (fun w hw => (hQpos w hw).ne')
  have heRΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => eR w.1) Ω :=
    heR.comp contDiff_fst.contDiffOn (fun w hw => (hΩmem w hw).1)
  have heThΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => eTh w.1) Ω :=
    heTh.comp contDiff_fst.contDiffOn (fun w hw => (hΩmem w hw).1)
  have hbase : ∀ (l : ℕ) (i : Fin 3), ContDiffOn ℝ ∞ (fun ξ => baseC B l ξ i) (DomC B.h (qsOf l0)) := by
    intro l i
    have h1 := (geom_slow_base_smooth_v5 B hok).2 l i
    have hp : ContDiff ℝ ∞ (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) :=
      contDiff_fst.prodMk ((contDiff_fst.comp contDiff_snd).prodMk
        (contDiff_fst.comp (contDiff_snd.comp contDiff_snd)))
    have hmaps : MapsTo (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) (DomC B.h (qsOf l0))
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
      intro ξ hξ
      have h3 : qC B.h ξ < B.qB := lt_of_lt_of_le hξ.2.2 hqsB
      exact ⟨hξ.1, hξ.2.1, h3⟩
    have hcomp := h1.comp hp.contDiffOn hmaps
    refine hcomp.congr (fun ξ _ => ?_)
    simp only [Function.comp_apply, baseC]
  have hwave : ∀ a : WS, (∃ H : Finset ℤ, ∀ γ m, m ∉ H → a γ m = 0) →
      (∀ γ m, ContDiffOn ℝ ∞ (a γ m) (DomC B.h (qsOf l0))) →
      (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → a γ m ξ ≠ 0 → SuppW B G γ ξ) →
      ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => waveS5 B G a (thetaOf w.1) (Ψ w)) Ω := by
    intro a hHa ha hsupp
    obtain ⟨H, hH⟩ := hHa
    have hfac : ∀ w : ℝ³ × ℝ, waveS5 B G a (thetaOf w.1) (Ψ w) =
        (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, a γ m (Ψ w) * Complex.exp (Complex.I * (m : ℂ) *
          ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (Ψ w) : ℂ))) *
          Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf w.1 : ℂ))).re := by
      intro w
      unfold waveS5
      congr 1
      refine finsum_congr (fun γ => finsum_congr (fun m => ?_))
      unfold ephase5
      have key : Complex.I * (m : ℂ) * ((pint5 B G γ : ℂ) * (thetaOf w.1 : ℂ) +
          (kb B.h γ.1 : ℂ) * (phiL5 B G γ (Ψ w) : ℂ)) =
          Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (Ψ w) : ℂ)) +
          Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf w.1 : ℂ) := by
        push_cast; ring
      rw [key, Complex.exp_add]
      ring
    refine (wave_sum_assembly Ω (DomC B.h (qsOf l0)) Ψ
      (fun γ m ξ => a γ m ξ * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))
      (fun γ m => m * pint5 B G γ) H hΩo (fun w hw => (hΩmem w hw).1) hΨ hΨmaps ?_ ?_
      (fun γ m => wave_coef_phase_smooth_v5 B G (qsOf l0) a hG hbase ha hsupp γ m)).congr
      (fun w _ => hfac w)
    · intro γ m hm ξ _
      simp [hH γ m hm]
    · intro ξ₀ hξ₀
      obtain ⟨U, hU, hξU, T, hT⟩ := etaL_locfin B.h (qsOf l0) hSP ξ₀ hξ₀
      refine ⟨U, hU, hξU, T, fun γ hγ m ξ hξ => ?_⟩
      by_contra hne
      have ha0 : a γ m ξ ≠ 0 := fun h0 => hne (by simp [h0])
      exact hT γ hγ ξ hξ.1 (hsupp γ m ξ hξ.2 ha0).2.1
  obtain ⟨HA, -, hHA⟩ := hAw.1
  have hW : ∀ i : Fin 3, ContDiffOn ℝ ∞
      (fun w : ℝ³ × ℝ => waveS5 B G (fun γ m ξ => S.Aw γ m ξ i) (thetaOf w.1) (Ψ w)) Ω := by
    intro i
    refine hwave (fun γ m ξ => S.Aw γ m ξ i) ⟨HA, fun γ m hm => ?_⟩
      (fun γ m => contDiffOn_pi.mp (hAw.2.1 γ m) i) (fun γ m ξ hξ hne => ?_)
    · funext ξ
      simp [hHA γ m hm]
    · exact hAw.2.2.2.1 γ m ξ hξ (fun h0 => hne (by simp [h0]))
  obtain ⟨HP, -, hHP⟩ := hpw.1
  have hWp : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => waveS5 B G S.pw (thetaOf w.1) (Ψ w)) Ω :=
    hwave S.pw ⟨HP, hHP⟩ hpw.2.1 hpw.2.2.2.1
  have hAeq : ∀ w ∈ Ω, (↿(evOff B.h (AX5 B G l0 S) Y₀)) w = B.AB w.1 w.2 +
      simScale B.h (w.1 2) (1 - w.2) ^ (1/2 - Aex B.h) •
        (waveS5 B G (fun γ m ξ => S.Aw γ m ξ 0) (thetaOf w.1) (Ψ w) • eR w.1 +
         waveS5 B G (fun γ m ξ => S.Aw γ m ξ 1) (thetaOf w.1) (Ψ w) • eTh w.1 +
         waveS5 B G (fun γ m ξ => S.Aw γ m ξ 2) (thetaOf w.1) (Ψ w) • eZ +
         S.Psi (Ψ w) • eTh w.1) := by
    intro w hw
    have hw' : corrOn B l0 w.1 w.2 := hw
    change B.AB w.1 w.2 + _ = _
    rw [if_pos hw']
    all_goals rfl
  have hBeq : ∀ w ∈ Ω, (↿(evOff B.h (BX B G l0 S) Y₀)) w = B.BvB w.1 w.2 +
      (simScale B.h (w.1 2) (1 - w.2) ^ (-Aex B.h) * S.bdir (Ψ w)) • eTh w.1 := by
    intro w hw
    have hw' : corrOn B l0 w.1 w.2 := hw
    change B.BvB w.1 w.2 + _ = _
    rw [if_pos hw']
    all_goals rfl
  have hPeq : ∀ w ∈ Ω, (↿(evOff B.h (PX5 B G l0 S) Y₀)) w = B.PB w.1 w.2 +
      (pmP5 B G l0 S (Ψ w) +
       simScale B.h (w.1 2) (1 - w.2) ^ (-2 * Aex B.h) * waveS5 B G S.pw (thetaOf w.1) (Ψ w)) := by
    intro w hw
    have hw' : corrOn B l0 w.1 w.2 := hw
    change B.PB w.1 w.2 + _ = _
    rw [if_pos hw']
    all_goals rfl
  have hAsm : ContDiffOn ℝ ∞ (↿(evOff B.h (AX5 B G l0 S) Y₀)) Ω :=
    ContDiffOn.congr ((hABs.mono hΩsub).add ((hQp (1/2 - Aex B.h)).smul
      (((((hW 0).smul heRΩ).add ((hW 1).smul heThΩ)).add ((hW 2).smul (contDiffOn_const (c := eZ)))).add
        ((hPsi.1.comp hΨ hΨmaps).smul heThΩ)))) hAeq
  have hBsm : ContDiffOn ℝ ∞ (↿(evOff B.h (BX B G l0 S) Y₀)) Ω :=
    ContDiffOn.congr ((hBvBs.mono hΩsub).add
      (((hQp (-Aex B.h)).mul (hbdir.1.comp hΨ hΨmaps)).smul heThΩ)) hBeq
  have hPsm : ContDiffOn ℝ ∞ (↿(evOff B.h (PX5 B G l0 S) Y₀)) Ω :=
    ContDiffOn.congr ((hPBs.mono hΩsub).add ((hpm.comp hΨ hΨmaps).add
      ((hQp (-2 * Aex B.h)).mul hWp))) hPeq
  have hUeq : evOff B.h (uX5 B G l0 S) Y₀ = fun y s =>
      curl3 (fun w => evOff B.h (AX5 B G l0 S) Y₀ w s) y + evOff B.h (BX B G l0 S) Y₀ y s := by
    funext y s
    simp only [evOff, uX5, curlX, add_sub_cancel_left]
  refine ⟨hAsm, ?_, hPsm⟩
  rw [hUeq]
  exact (curl_field_contDiffOn_bounded _ _ Ω Ω hΩo subset_rfl hAsm hBsm).1

theorem psi5_incr_fields_smooth : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (D : WC) (E : WS) (β β' : ℝ) (Y₀ : ℝ × ℝ), B.ok → GeomPrim5 B G → qsOf l0 ≤ B.qB → InWg5 B G (qsOf l0) β D → InWg5 B G (qsOf l0) β' E → ContDiffOn ℝ ∞ (↿(evOff B.h (AincX5 B G l0 D) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} ∧ ContDiffOn ℝ ∞ (↿(evOff B.h (wIncX5 B G l0 D) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} ∧ ContDiffOn ℝ ∞ (↿(evOff B.h (pwIncX5 B G l0 E) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} :=
by
  intro B G l0 D E β β' Y₀ hok hG hqsB hD hE
  obtain ⟨hΩo, hΨ, hQs, -, heR, heTh⟩ := corr_domain_v5 B l0 Y₀ hok
  set Ω : Set (ℝ³ × ℝ) := {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} with hΩdef
  set Ψ : ℝ³ × ℝ → Cyl := fun w => ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y₀) with hΨdef
  have hSP : SimScaleProps B.h := hok.1
  have hΩmem : ∀ w ∈ Ω, corrOn B l0 w.1 w.2 := fun w hw => hw
  have hΨmaps : MapsTo Ψ Ω (DomC B.h (qsOf l0)) := fun w hw => hw
  have hQpos : ∀ w ∈ Ω, 0 < simScale B.h (w.1 2) (1 - w.2) := fun w hw =>
    (hSP.1 (w.1 2) (1 - w.2) (by linarith [(hΩmem w hw).2.1])).1
  have hQΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) Ω :=
    hQs.mono (fun w hw => (hΩmem w hw).2.1)
  have hQp : ∀ p : ℝ, ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2) ^ p) Ω :=
    fun p => hQΩ.rpow_const_of_ne (fun w hw => (hQpos w hw).ne')
  have heRΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => eR w.1) Ω :=
    heR.comp contDiff_fst.contDiffOn (fun w hw => (hΩmem w hw).1)
  have heThΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => eTh w.1) Ω :=
    heTh.comp contDiff_fst.contDiffOn (fun w hw => (hΩmem w hw).1)
  have hbase : ∀ (l : ℕ) (i : Fin 3), ContDiffOn ℝ ∞ (fun ξ => baseC B l ξ i) (DomC B.h (qsOf l0)) := by
    intro l i
    have h1 := (geom_slow_base_smooth_v5 B hok).2 l i
    have hp : ContDiff ℝ ∞ (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) :=
      contDiff_fst.prodMk ((contDiff_fst.comp contDiff_snd).prodMk
        (contDiff_fst.comp (contDiff_snd.comp contDiff_snd)))
    have hmaps : MapsTo (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) (DomC B.h (qsOf l0))
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
      intro ξ hξ
      have h3 : qC B.h ξ < B.qB := lt_of_lt_of_le hξ.2.2 hqsB
      exact ⟨hξ.1, hξ.2.1, h3⟩
    have hcomp := h1.comp hp.contDiffOn hmaps
    refine hcomp.congr (fun ξ _ => ?_)
    simp only [Function.comp_apply, baseC]
  have hwave : ∀ a : WS, (∃ H : Finset ℤ, ∀ γ m, m ∉ H → a γ m = 0) →
      (∀ γ m, ContDiffOn ℝ ∞ (a γ m) (DomC B.h (qsOf l0))) →
      (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → a γ m ξ ≠ 0 → SuppW B G γ ξ) →
      ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => waveS5 B G a (thetaOf w.1) (Ψ w)) Ω := by
    intro a hHa ha hsupp
    obtain ⟨H, hH⟩ := hHa
    have hfac : ∀ w : ℝ³ × ℝ, waveS5 B G a (thetaOf w.1) (Ψ w) =
        (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, a γ m (Ψ w) * Complex.exp (Complex.I * (m : ℂ) *
          ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (Ψ w) : ℂ))) *
          Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf w.1 : ℂ))).re := by
      intro w
      unfold waveS5
      congr 1
      refine finsum_congr (fun γ => finsum_congr (fun m => ?_))
      unfold ephase5
      have key : Complex.I * (m : ℂ) * ((pint5 B G γ : ℂ) * (thetaOf w.1 : ℂ) +
          (kb B.h γ.1 : ℂ) * (phiL5 B G γ (Ψ w) : ℂ)) =
          Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (Ψ w) : ℂ)) +
          Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf w.1 : ℂ) := by
        push_cast; ring
      rw [key, Complex.exp_add]
      ring
    refine (wave_sum_assembly Ω (DomC B.h (qsOf l0)) Ψ
      (fun γ m ξ => a γ m ξ * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))
      (fun γ m => m * pint5 B G γ) H hΩo (fun w hw => (hΩmem w hw).1) hΨ hΨmaps ?_ ?_
      (fun γ m => wave_coef_phase_smooth_v5 B G (qsOf l0) a hG hbase ha hsupp γ m)).congr
      (fun w _ => hfac w)
    · intro γ m hm ξ _
      simp [hH γ m hm]
    · intro ξ₀ hξ₀
      obtain ⟨U, hU, hξU, T, hT⟩ := etaL_locfin B.h (qsOf l0) hSP ξ₀ hξ₀
      refine ⟨U, hU, hξU, T, fun γ hγ m ξ hξ => ?_⟩
      by_contra hne
      have ha0 : a γ m ξ ≠ 0 := fun h0 => hne (by simp [h0])
      exact hT γ hγ ξ hξ.1 (hsupp γ m ξ hξ.2 ha0).2.1
  obtain ⟨HA, -, hHA⟩ := hD.1
  have hW : ∀ i : Fin 3, ContDiffOn ℝ ∞
      (fun w : ℝ³ × ℝ => waveS5 B G (fun γ m ξ => D γ m ξ i) (thetaOf w.1) (Ψ w)) Ω := by
    intro i
    refine hwave (fun γ m ξ => D γ m ξ i) ⟨HA, fun γ m hm => ?_⟩
      (fun γ m => contDiffOn_pi.mp (hD.2.1 γ m) i) (fun γ m ξ hξ hne => ?_)
    · funext ξ
      simp [hHA γ m hm]
    · exact hD.2.2.2.1 γ m ξ hξ (fun h0 => hne (by simp [h0]))
  obtain ⟨HP, -, hHP⟩ := hE.1
  have hWp : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => waveS5 B G E (thetaOf w.1) (Ψ w)) Ω :=
    hwave E ⟨HP, hHP⟩ hE.2.1 hE.2.2.2.1

  have hAeq : ∀ w ∈ Ω, (↿(evOff B.h (AincX5 B G l0 D) Y₀)) w =
      simScale B.h (w.1 2) (1 - w.2) ^ (1/2 - Aex B.h) •
        (waveS5 B G (fun γ m ξ => D γ m ξ 0) (thetaOf w.1) (Ψ w) • eR w.1 +
         waveS5 B G (fun γ m ξ => D γ m ξ 1) (thetaOf w.1) (Ψ w) • eTh w.1 +
         waveS5 B G (fun γ m ξ => D γ m ξ 2) (thetaOf w.1) (Ψ w) • eZ) := by
    intro w hw
    have hw' : corrOn B l0 w.1 w.2 := hw
    show AincX5 B G l0 D w.1 w.2 (Yph B.h (rad w.1) w.2 + Y₀) = _
    unfold AincX5
    rw [if_pos hw']
    rfl
  have hAsm : ContDiffOn ℝ ∞ (↿(evOff B.h (AincX5 B G l0 D) Y₀)) Ω :=
    ContDiffOn.congr ((hQp (1/2 - Aex B.h)).smul
      ((((hW 0).smul heRΩ).add ((hW 1).smul heThΩ)).add ((hW 2).smul (contDiffOn_const (c := eZ))))) hAeq

  have hWeq : evOff B.h (wIncX5 B G l0 D) Y₀ = fun y s =>
      curl3 (fun w => evOff B.h (AincX5 B G l0 D) Y₀ w s) y + (fun (_ : ℝ³) (_ : ℝ) => (0:ℝ³)) y s := by
    funext y s
    simp only [evOff, wIncX5, curlX, add_sub_cancel_left, add_zero]
  have h0sm : ContDiffOn ℝ ∞ (↿(fun (_ : ℝ³) (_ : ℝ) => (0:ℝ³))) Ω :=
    (contDiffOn_const (c := (0:ℝ³))).congr (fun _ _ => rfl)
  have hWsm : ContDiffOn ℝ ∞ (↿(evOff B.h (wIncX5 B G l0 D) Y₀)) Ω := by
    rw [hWeq]
    exact (curl_field_contDiffOn_bounded _ _ Ω Ω hΩo subset_rfl hAsm h0sm).1

  have hPeq : ∀ w ∈ Ω, (↿(evOff B.h (pwIncX5 B G l0 E) Y₀)) w =
      simScale B.h (w.1 2) (1 - w.2) ^ (-2 * Aex B.h) *
        waveS5 B G E (thetaOf w.1) (Ψ w) := by
    intro w hw
    have hw' : corrOn B l0 w.1 w.2 := hw
    show pwIncX5 B G l0 E w.1 w.2 (Yph B.h (rad w.1) w.2 + Y₀) = _
    unfold pwIncX5
    rw [if_pos hw']
    rfl
  have hPsm : ContDiffOn ℝ ∞ (↿(evOff B.h (pwIncX5 B G l0 E) Y₀)) Ω :=
    ContDiffOn.congr ((hQp (-2 * Aex B.h)).mul hWp) hPeq
  exact ⟨hAsm, hWsm, hPsm⟩

theorem psi5_pointwise_split : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (D : WC) (E : WS), IsOpen {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} → (∀ (u₁ u₂ : ℝ³ → ℝ → ℝ³) (p₁ p₂ : ℝ³ → ℝ → ℝ) (O : Set (ℝ³ × ℝ)), IsOpen O → (∀ z ∈ O, (↿u₁) z = (↿u₂) z) → (∀ z ∈ O, (↿p₁) z = (↿p₂) z) → ∀ z ∈ O, (↿(nsResidual 1 u₁ p₁)) z = (↿(nsResidual 1 u₂ p₂)) z) → (∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (↿(evOff B.h (AX5 B G l0 S) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2}) → (∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (↿(evOff B.h (uX5 B G l0 S) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2}) → (∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (↿(evOff B.h (PX5 B G l0 S) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2}) → (∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (↿(evOff B.h (AincX5 B G l0 D) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2}) → (∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (↿(evOff B.h (wIncX5 B G l0 D) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2}) → (∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (↿(evOff B.h (pwIncX5 B G l0 E) Y₀)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2}) → (∀ (x : ℝ³) (t : ℝ), corrOn B l0 x t → DifferentiableAt ℝ (fun y => uB B y t) x) → (∀ (x : ℝ³) (t : ℝ) (Y : ℝ × ℝ), AX5 B G l0 (waveAdd S D E) x t Y = AX5 B G l0 S x t Y + AincX5 B G l0 D x t Y) → (∀ (x : ℝ³) (t : ℝ) (Y : ℝ × ℝ), corrOn B l0 x t → DifferentiableAt ℝ (fun y => PX5 B G l0 (waveAdd S D E) y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t)) - PX5 B G l0 S y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t)) - pwIncX5 B G l0 E y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t))) x) → ∀ x t Y, corrOn B l0 x t → resX B.h (uX5 B G l0 (waveAdd S D E)) (PX5 B G l0 (waveAdd S D E)) x t Y = resX B.h (uX5 B G l0 S) (PX5 B G l0 S) x t Y + LinT5 B G l0 D E x t Y + CrT5 B G l0 S D x t Y + SfT5 B G l0 D x t Y + gradient (fun y => PX5 B G l0 (waveAdd S D E) y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t)) - PX5 B G l0 S y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t)) - pwIncX5 B G l0 E y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t))) x :=
by
  classical
  intro B G l0 S D E hCO hloc hA hU hP hAi hW hPi huBd hAadd hMd x t Y hxt
  have hxC : ((x, t) : ℝ³ × ℝ) ∈ {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} := hxt

  have hsl : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ → ℝ → F)
      (O : Set (ℝ³ × ℝ)) (y : ℝ³) (s : ℝ), IsOpen O → ContDiffOn ℝ ∞ (↿f) O → (y, s) ∈ O →
      DifferentiableAt ℝ (fun w => f w s) y := by
    intro F _ _ f O y s hO hf hys
    exact ((hf.contDiffAt (hO.mem_nhds hys)).comp y
      ((contDiff_id.prodMk contDiff_const).contDiffAt)).differentiableAt (by simp)

  have hcurl_add : ∀ (F₁ F₂ : ℝ³ → ℝ³) (y : ℝ³), DifferentiableAt ℝ F₁ y →
      DifferentiableAt ℝ F₂ y → curl3 (fun w => F₁ w + F₂ w) y = curl3 F₁ y + curl3 F₂ y := by
    intro F₁ F₂ y h1 h2
    unfold curl3
    rw [fderiv_fun_add h1 h2]
    simp only [ContinuousLinearMap.add_apply, PiLp.add_apply, add_sub_add_comm, add_smul]
    abel

  have hexp : ∀ (u w : ℝ³ → ℝ → ℝ³) (p π₁ π₂ : ℝ³ → ℝ → ℝ), ContDiffAt ℝ 2 (↿u) (x, t) →
      ContDiffAt ℝ 2 (↿w) (x, t) → DifferentiableAt ℝ (fun y => p y t) x →
      DifferentiableAt ℝ (fun y => π₁ y t) x → DifferentiableAt ℝ (fun y => π₂ y t) x →
      nsResidual 1 (fun y s => u y s + w y s) (fun y s => p y s + π₁ y s + π₂ y s) x t =
        nsResidual 1 u p x t + nsResidual 1 w π₁ x t + gradient (fun y => π₂ y t) x +
          fderiv ℝ (fun y => w y t) x (u x t) + fderiv ℝ (fun y => u y t) x (w x t) := by
    intro u w p π₁ π₂ hu hw hp h1 h2
    have hus : ContDiffAt ℝ 2 (fun y => u y t) x :=
      hu.comp x ((contDiff_id.prodMk contDiff_const).contDiffAt)
    have hws : ContDiffAt ℝ 2 (fun y => w y t) x :=
      hw.comp x ((contDiff_id.prodMk contDiff_const).contDiffAt)
    have hut : DifferentiableAt ℝ (fun s => u x s) t :=
      (hu.comp t ((contDiff_const.prodMk contDiff_id).contDiffAt)).differentiableAt (by simp)
    have hwt : DifferentiableAt ℝ (fun s => w x s) t :=
      (hw.comp t ((contDiff_const.prodMk contDiff_id).contDiffAt)).differentiableAt (by simp)
    have hud : DifferentiableAt ℝ (fun y => u y t) x := hus.differentiableAt (by simp)
    have hwd : DifferentiableAt ℝ (fun y => w y t) x := hws.differentiableAt (by simp)
    have hL : Δ (fun y => u y t + w y t) x = Δ (fun y => u y t) x + Δ (fun y => w y t) x :=
      hus.laplacian_add hws
    have hG : gradient (fun y => p y t + π₁ y t + π₂ y t) x =
        gradient (fun y => p y t) x + gradient (fun y => π₁ y t) x + gradient (fun y => π₂ y t) x := by
      simp only [gradient, fderiv_fun_add (hp.fun_add h1) h2, fderiv_fun_add hp h1, map_add]
    simp only [nsResidual]
    rw [deriv_fun_add hut hwt, fderiv_fun_add hud hwd, hL, hG]
    simp only [ContinuousLinearMap.add_apply, map_add, smul_add]
    abel

  show nsResidual 1 (evOff B.h (uX5 B G l0 (waveAdd S D E)) (Y - Yph B.h (rad x) t))
      (evOff B.h (PX5 B G l0 (waveAdd S D E)) (Y - Yph B.h (rad x) t)) x t =
    nsResidual 1 (evOff B.h (uX5 B G l0 S) (Y - Yph B.h (rad x) t))
      (evOff B.h (PX5 B G l0 S) (Y - Yph B.h (rad x) t)) x t +
    (nsResidual 1 (evOff B.h (wIncX5 B G l0 D) (Y - Yph B.h (rad x) t))
        (evOff B.h (pwIncX5 B G l0 E) (Y - Yph B.h (rad x) t)) x t
      - fderiv ℝ (fun y => evOff B.h (wIncX5 B G l0 D) (Y - Yph B.h (rad x) t) y t) x
          (evOff B.h (wIncX5 B G l0 D) (Y - Yph B.h (rad x) t) x t)
      + fderiv ℝ (fun y => evOff B.h (wIncX5 B G l0 D) (Y - Yph B.h (rad x) t) y t) x (uB B x t)
      + fderiv ℝ (fun y => uB B y t) x (evOff B.h (wIncX5 B G l0 D) (Y - Yph B.h (rad x) t) x t)) +
    (fderiv ℝ (fun y => evOff B.h (wIncX5 B G l0 D) (Y - Yph B.h (rad x) t) y t) x
        (evOff B.h (uX5 B G l0 S) (Y - Yph B.h (rad x) t) x t - uB B x t)
      + fderiv ℝ (fun y => evOff B.h (uX5 B G l0 S) (Y - Yph B.h (rad x) t) y t - uB B y t) x
        (evOff B.h (wIncX5 B G l0 D) (Y - Yph B.h (rad x) t) x t)) +
    fderiv ℝ (fun y => evOff B.h (wIncX5 B G l0 D) (Y - Yph B.h (rad x) t) y t) x
      (evOff B.h (wIncX5 B G l0 D) (Y - Yph B.h (rad x) t) x t) +
    gradient (fun y => PX5 B G l0 (waveAdd S D E) y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t))
      - PX5 B G l0 S y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t))
      - pwIncX5 B G l0 E y t (Yph B.h (rad y) t + (Y - Yph B.h (rad x) t))) x
  have hMx := hMd x t Y hxt
  obtain ⟨Y', hY'⟩ : ∃ Y' : ℝ × ℝ, Y - Yph B.h (rad x) t = Y' := ⟨_, rfl⟩
  rw [hY']
  rw [hY'] at hMx

  have hUs : ∀ z ∈ {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2},
      (↿(evOff B.h (uX5 B G l0 (waveAdd S D E)) Y')) z =
        (↿(fun y s => evOff B.h (uX5 B G l0 S) Y' y s + evOff B.h (wIncX5 B G l0 D) Y' y s)) z := by
    rintro ⟨y, s⟩ hz
    have hd1 : DifferentiableAt ℝ (fun w => evOff B.h (AX5 B G l0 S) Y' w s) y :=
      hsl _ _ y s hCO (hA Y') hz
    have hd2 : DifferentiableAt ℝ (fun w => evOff B.h (AincX5 B G l0 D) Y' w s) y :=
      hsl _ _ y s hCO (hAi Y') hz
    have e1 : evOff B.h (uX5 B G l0 (waveAdd S D E)) Y' y s =
        curl3 (fun w => AX5 B G l0 (waveAdd S D E) w s (Yph B.h (rad w) s + Y')) y +
          BX B G l0 (waveAdd S D E) y s (Yph B.h (rad y) s + Y') := by
      show curl3 (fun w => AX5 B G l0 (waveAdd S D E) w s
          (Yph B.h (rad w) s + (Yph B.h (rad y) s + Y' - Yph B.h (rad y) s))) y +
          BX B G l0 (waveAdd S D E) y s (Yph B.h (rad y) s + Y') = _
      rw [add_sub_cancel_left]
    have e1S : evOff B.h (uX5 B G l0 S) Y' y s =
        curl3 (fun w => evOff B.h (AX5 B G l0 S) Y' w s) y +
          BX B G l0 S y s (Yph B.h (rad y) s + Y') := by
      show curl3 (fun w => AX5 B G l0 S w s
          (Yph B.h (rad w) s + (Yph B.h (rad y) s + Y' - Yph B.h (rad y) s))) y +
          BX B G l0 S y s (Yph B.h (rad y) s + Y') = _
      rw [add_sub_cancel_left]
      rfl
    have e2 : evOff B.h (wIncX5 B G l0 D) Y' y s =
        curl3 (fun w => evOff B.h (AincX5 B G l0 D) Y' w s) y := by
      show curl3 (fun w => AincX5 B G l0 D w s
          (Yph B.h (rad w) s + (Yph B.h (rad y) s + Y' - Yph B.h (rad y) s))) y = _
      rw [add_sub_cancel_left]
      rfl
    have hfA : (fun w => AX5 B G l0 (waveAdd S D E) w s (Yph B.h (rad w) s + Y')) =
        fun w => evOff B.h (AX5 B G l0 S) Y' w s + evOff B.h (AincX5 B G l0 D) Y' w s := by
      funext w
      exact hAadd w s _
    have hcA : curl3 (fun w => evOff B.h (AX5 B G l0 S) Y' w s + evOff B.h (AincX5 B G l0 D) Y' w s) y =
        curl3 (fun w => evOff B.h (AX5 B G l0 S) Y' w s) y +
          curl3 (fun w => evOff B.h (AincX5 B G l0 D) Y' w s) y :=
      hcurl_add _ _ y hd1 hd2
    have hBX : BX B G l0 (waveAdd S D E) y s (Yph B.h (rad y) s + Y') =
        BX B G l0 S y s (Yph B.h (rad y) s + Y') := rfl
    show evOff B.h (uX5 B G l0 (waveAdd S D E)) Y' y s =
      evOff B.h (uX5 B G l0 S) Y' y s + evOff B.h (wIncX5 B G l0 D) Y' y s
    rw [e1, e1S, e2, hfA, hcA, hBX]
    abel

  have hPr : ∀ z ∈ {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2},
      (↿(evOff B.h (PX5 B G l0 (waveAdd S D E)) Y')) z =
        (↿(fun y s => evOff B.h (PX5 B G l0 S) Y' y s + evOff B.h (pwIncX5 B G l0 E) Y' y s +
          (PX5 B G l0 (waveAdd S D E) y s (Yph B.h (rad y) s + Y')
            - PX5 B G l0 S y s (Yph B.h (rad y) s + Y')
            - pwIncX5 B G l0 E y s (Yph B.h (rad y) s + Y')))) z := by
    rintro ⟨y, s⟩ _
    show PX5 B G l0 (waveAdd S D E) y s (Yph B.h (rad y) s + Y') =
      PX5 B G l0 S y s (Yph B.h (rad y) s + Y') + pwIncX5 B G l0 E y s (Yph B.h (rad y) s + Y') +
        (PX5 B G l0 (waveAdd S D E) y s (Yph B.h (rad y) s + Y')
          - PX5 B G l0 S y s (Yph B.h (rad y) s + Y')
          - pwIncX5 B G l0 E y s (Yph B.h (rad y) s + Y'))
    ring
  have hL0 := hloc _ _ _ _ _ hCO hUs hPr (x, t) hxC
  have hL1 : nsResidual 1 (evOff B.h (uX5 B G l0 (waveAdd S D E)) Y')
      (evOff B.h (PX5 B G l0 (waveAdd S D E)) Y') x t =
      nsResidual 1 (fun y s => evOff B.h (uX5 B G l0 S) Y' y s + evOff B.h (wIncX5 B G l0 D) Y' y s)
        (fun y s => evOff B.h (PX5 B G l0 S) Y' y s + evOff B.h (pwIncX5 B G l0 E) Y' y s +
          (PX5 B G l0 (waveAdd S D E) y s (Yph B.h (rad y) s + Y')
            - PX5 B G l0 S y s (Yph B.h (rad y) s + Y')
            - pwIncX5 B G l0 E y s (Yph B.h (rad y) s + Y'))) x t := hL0

  have hu2 : ContDiffAt ℝ 2 (↿(evOff B.h (uX5 B G l0 S) Y')) (x, t) :=
    ((hU Y').contDiffAt (hCO.mem_nhds hxC)).of_le (by norm_num)
  have hw2 : ContDiffAt ℝ 2 (↿(evOff B.h (wIncX5 B G l0 D) Y')) (x, t) :=
    ((hW Y').contDiffAt (hCO.mem_nhds hxC)).of_le (by norm_num)
  have hp1 : DifferentiableAt ℝ (fun y => evOff B.h (PX5 B G l0 S) Y' y t) x :=
    hsl _ _ x t hCO (hP Y') hxC
  have hp2 : DifferentiableAt ℝ (fun y => evOff B.h (pwIncX5 B G l0 E) Y' y t) x :=
    hsl _ _ x t hCO (hPi Y') hxC
  have hE : nsResidual 1 (fun y s => evOff B.h (uX5 B G l0 S) Y' y s + evOff B.h (wIncX5 B G l0 D) Y' y s)
      (fun y s => evOff B.h (PX5 B G l0 S) Y' y s + evOff B.h (pwIncX5 B G l0 E) Y' y s +
          (PX5 B G l0 (waveAdd S D E) y s (Yph B.h (rad y) s + Y')
            - PX5 B G l0 S y s (Yph B.h (rad y) s + Y')
            - pwIncX5 B G l0 E y s (Yph B.h (rad y) s + Y'))) x t =
      nsResidual 1 (evOff B.h (uX5 B G l0 S) Y') (evOff B.h (PX5 B G l0 S) Y') x t +
        nsResidual 1 (evOff B.h (wIncX5 B G l0 D) Y') (evOff B.h (pwIncX5 B G l0 E) Y') x t +
        gradient (fun y => PX5 B G l0 (waveAdd S D E) y t (Yph B.h (rad y) t + Y')
          - PX5 B G l0 S y t (Yph B.h (rad y) t + Y')
          - pwIncX5 B G l0 E y t (Yph B.h (rad y) t + Y')) x +
        fderiv ℝ (fun y => evOff B.h (wIncX5 B G l0 D) Y' y t) x (evOff B.h (uX5 B G l0 S) Y' x t) +
        fderiv ℝ (fun y => evOff B.h (uX5 B G l0 S) Y' y t) x (evOff B.h (wIncX5 B G l0 D) Y' x t) :=
    hexp (evOff B.h (uX5 B G l0 S) Y') (evOff B.h (wIncX5 B G l0 D) Y') (evOff B.h (PX5 B G l0 S) Y')
      (evOff B.h (pwIncX5 B G l0 E) Y')
      (fun y s => PX5 B G l0 (waveAdd S D E) y s (Yph B.h (rad y) s + Y')
        - PX5 B G l0 S y s (Yph B.h (rad y) s + Y')
        - pwIncX5 B G l0 E y s (Yph B.h (rad y) s + Y')) hu2 hw2 hp1 hp2 hMx

  have hUd : DifferentiableAt ℝ (fun y => evOff B.h (uX5 B G l0 S) Y' y t) x :=
    hsl _ _ x t hCO (hU Y') hxC
  have hBd : DifferentiableAt ℝ (fun y => uB B y t) x := huBd x t hxt
  have hC1 : fderiv ℝ (fun y => evOff B.h (uX5 B G l0 S) Y' y t - uB B y t) x =
      fderiv ℝ (fun y => evOff B.h (uX5 B G l0 S) Y' y t) x - fderiv ℝ (fun y => uB B y t) x :=
    fderiv_fun_sub hUd hBd
  have hC2 : fderiv ℝ (fun y => evOff B.h (wIncX5 B G l0 D) Y' y t) x
      (evOff B.h (uX5 B G l0 S) Y' x t - uB B x t) =
      fderiv ℝ (fun y => evOff B.h (wIncX5 B G l0 D) Y' y t) x (evOff B.h (uX5 B G l0 S) Y' x t) -
        fderiv ℝ (fun y => evOff B.h (wIncX5 B G l0 D) Y' y t) x (uB B x t) := map_sub _ _ _
  rw [hL1, hE, hC1, ContinuousLinearMap.sub_apply, hC2]
  abel

theorem psi5_pm_grad_frame : ∀ (B : BG) (l0 : ℕ) (g : Cyl → ℝ) (Mf : Ext ℝ), B.ok → (∀ ξ ∈ DomC B.h (qsOf l0), DifferentiableAt ℝ g ξ) → (∀ (y : ℝ³) (s : ℝ) (Y'' : ℝ × ℝ), corrOn B l0 y s → Mf y s Y'' = g (ptOf y s Y'')) → (∀ (y : ℝ³) (s : ℝ) (Y'' : ℝ × ℝ), ¬ corrOn B l0 y s → Mf y s Y'' = 0) → ∀ (x : ℝ³) (t : ℝ) (Y : ℝ × ℝ), corrOn B l0 x t → ∃ c0 c2 : ℝ, ∀ y : ℝ³, rad y = rad x → y 2 = x 2 → DifferentiableAt ℝ (fun w => Mf w t (Yph B.h (rad w) t + (Y - Yph B.h (rad y) t))) y ∧ gradient (fun w => Mf w t (Yph B.h (rad w) t + (Y - Yph B.h (rad y) t))) y = c0 • eR y + c2 • eZ :=
by
  classical
  intro B l0 g Mf hok hg hon hoff x t Y hxt
  obtain ⟨hr, ht, hs⟩ := hxt

  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : ℝ → ℝ → ℝ, ∀ a b, Φ a b =
      if (0 < a ∧ t < 1 ∧ simScale B.h b (1 - t) < qsOf l0) then
        g (a, b, t, Yph B.h a t + (Y - Yph B.h (rad x) t)) else 0 :=
    ⟨fun a b => if (0 < a ∧ t < 1 ∧ simScale B.h b (1 - t) < qsOf l0) then
        g (a, b, t, Yph B.h a t + (Y - Yph B.h (rad x) t)) else 0,
      fun _ _ => rfl⟩

  obtain ⟨κ, hκdef⟩ : ∃ κ : ℝ × ℝ → Cyl,
      κ = fun p => (p.1, p.2, t, Yph B.h p.1 t + (Y - Yph B.h (rad x) t)) := ⟨_, rfl⟩
  have hκd : DifferentiableAt ℝ κ (rad x, x 2) := by
    have h1 : DifferentiableAt ℝ (fun p : ℝ × ℝ => p.1 ^ drx B.h) (rad x, x 2) :=
      differentiableAt_fst.rpow_const (Or.inl hr.ne')
    have h2 : DifferentiableAt ℝ (fun p : ℝ × ℝ => Yph B.h p.1 t + (Y - Yph B.h (rad x) t))
        (rad x, x 2) := by
      unfold Yph
      exact ((h1.smul_const vrv).add_const _).add_const _
    rw [hκdef]
    exact differentiableAt_fst.prodMk (differentiableAt_snd.prodMk
      ((differentiableAt_const t).prodMk h2))
  have hmem : κ (rad x, x 2) ∈ DomC B.h (qsOf l0) := by
    rw [hκdef]
    show 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0
    exact ⟨hr, ht, hs⟩
  have hcompd : DifferentiableAt ℝ (g ∘ κ) (rad x, x 2) :=
    (hg _ hmem).comp _ hκd
  have hcont : Continuous (fun p : ℝ × ℝ => simScale B.h p.2 (1 - t)) := by
    have := hok.1.2.2.2.1.continuousOn.comp_continuous (f := fun p : ℝ × ℝ => (p.2, 1 - t))
      (by fun_prop) (fun p => ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩)
    exact this
  have hU : IsOpen ({p : ℝ × ℝ | 0 < p.1} ∩ {p : ℝ × ℝ | simScale B.h p.2 (1 - t) < qsOf l0}) :=
    (isOpen_lt continuous_const continuous_fst).inter (isOpen_lt hcont continuous_const)
  have hΦd : DifferentiableAt ℝ (fun p : ℝ × ℝ => Φ p.1 p.2) (rad x, x 2) := by
    refine hcompd.congr_of_eventuallyEq ?_
    have hin : ((rad x, x 2) : ℝ × ℝ) ∈ ({p : ℝ × ℝ | 0 < p.1} ∩
        {p : ℝ × ℝ | simScale B.h p.2 (1 - t) < qsOf l0}) := ⟨hr, hs⟩
    filter_upwards [hU.mem_nhds hin] with p hp
    obtain ⟨hp1, hp2⟩ := hp
    have hp1' : 0 < p.1 := hp1
    have hp2' : simScale B.h p.2 (1 - t) < qsOf l0 := hp2
    rw [hΦdef, if_pos ⟨hp1', ht, hp2'⟩, hκdef]
    rfl
  obtain ⟨L, hLdef⟩ : ∃ L : ℝ × ℝ →L[ℝ] ℝ,
      L = fderiv ℝ (fun p : ℝ × ℝ => Φ p.1 p.2) (rad x, x 2) := ⟨_, rfl⟩
  have hlin : ∀ a b : ℝ, L (a, b) = a * L (1, 0) + b * L (0, 1) := by
    intro a b
    have e : ((a, b) : ℝ × ℝ) = a • ((1:ℝ), (0:ℝ)) + b • ((0:ℝ), (1:ℝ)) := by
      ext <;> simp
    rw [e, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
  refine ⟨L (1, 0), L (0, 1), fun y hy hz => ?_⟩
  have hry : 0 < rad y := by rw [hy]; exact hr

  have hfun : (fun w => Mf w t (Yph B.h (rad w) t + (Y - Yph B.h (rad y) t))) =
      fun w => Φ (rad w) (w 2) := by
    funext w
    rw [hy, hΦdef]
    by_cases hc : corrOn B l0 w t
    · have hc' : 0 < rad w ∧ t < 1 ∧ simScale B.h (w 2) (1 - t) < qsOf l0 := hc
      rw [if_pos hc', hon w t _ hc]
      rfl
    · have hc' : ¬ (0 < rad w ∧ t < 1 ∧ simScale B.h (w 2) (1 - t) < qsOf l0) := hc
      rw [if_neg hc', hoff w t _ hc]

  obtain ⟨D, hDdef⟩ : ∃ D : ℝ³ →L[ℝ] ℝ, D = (rad y)⁻¹ •
      ((y 0) • (EuclideanSpace.proj (0:Fin 3) : ℝ³ →L[ℝ] ℝ)
        + (y 1) • (EuclideanSpace.proj (1:Fin 3) : ℝ³ →L[ℝ] ℝ)) := ⟨_, rfl⟩
  have hD : HasFDerivAt rad D y := by
    have hpos : 0 < y 0 ^ 2 + y 1 ^ 2 := Real.sqrt_pos.mp hry
    have h0 := ((EuclideanSpace.proj (0:Fin 3) : ℝ³ →L[ℝ] ℝ).hasFDerivAt (x := y)).pow 2
    have h1 := ((EuclideanSpace.proj (1:Fin 3) : ℝ³ →L[ℝ] ℝ).hasFDerivAt (x := y)).pow 2
    have hsq := (h0.add h1).sqrt (by exact hpos.ne')
    refine hsq.congr_fderiv ?_
    rw [hDdef]
    refine ContinuousLinearMap.ext fun v => ?_
    have hp : ∀ i, (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ) v = v i := fun i => rfl
    have hq : ∀ i, (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ) y = y i := fun i => rfl
    have hr2 : Real.sqrt (y 0 ^ 2 + y 1 ^ 2) = rad y := rfl
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply, smul_eq_mul, hp, hq,
      Pi.add_apply, hr2]
    field_simp
    ring
  have hψ : HasFDerivAt (fun w : ℝ³ => (rad w, w 2))
      (D.prod (EuclideanSpace.proj (2:Fin 3) : ℝ³ →L[ℝ] ℝ)) y :=
    hD.prodMk ((EuclideanSpace.proj (2:Fin 3) : ℝ³ →L[ℝ] ℝ).hasFDerivAt (x := y))
  have hpt : ((rad y, y 2) : ℝ × ℝ) = (rad x, x 2) := by rw [hy, hz]
  have hL : HasFDerivAt (fun p : ℝ × ℝ => Φ p.1 p.2) L (rad y, y 2) := by
    rw [hpt, hLdef]
    exact hΦd.hasFDerivAt
  have hcomp := hL.comp y hψ
  have hF : HasFDerivAt (fun w => Φ (rad w) (w 2))
      (InnerProductSpace.toDual ℝ ℝ³ (L (1, 0) • eR y + L (0, 1) • eZ)) y := by
    refine hcomp.congr_fderiv ?_
    refine ContinuousLinearMap.ext fun v => ?_
    rw [InnerProductSpace.toDual_apply_apply]
    have hDv : D v = (rad y)⁻¹ * (y 0 * v 0 + y 1 * v 1) := by rw [hDdef]; rfl
    have hP2 : (EuclideanSpace.proj (2:Fin 3) : ℝ³ →L[ℝ] ℝ) v = v 2 := rfl
    rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.prod_apply, hDv, hP2, hlin]
    unfold eR radVec eZ
    simp only [inner_add_left, real_inner_smul_left, EuclideanSpace.inner_single_left, map_one,
      one_mul]
    ring
  rw [hfun]
  refine ⟨hF.differentiableAt, ?_⟩
  exact (hasGradientAt_iff_hasFDerivAt.mpr hF).gradient

theorem nsResidual_local_and_zero : (∀ (ν : ℝ) (u₁ u₂ : ℝ³ → ℝ → ℝ³) (p₁ p₂ : ℝ³ → ℝ → ℝ) (O : Set (ℝ³ × ℝ)), IsOpen O → (∀ z ∈ O, (↿u₁) z = (↿u₂) z) → (∀ z ∈ O, (↿p₁) z = (↿p₂) z) → ∀ z ∈ O, (↿(nsResidual ν u₁ p₁)) z = (↿(nsResidual ν u₂ p₂)) z) ∧ (∀ (ν : ℝ) (x : ℝ³) (t : ℝ), nsResidual ν (fun _ _ => (0 : ℝ³)) (fun _ _ => (0 : ℝ)) x t = 0) :=
by
  refine ⟨?_, ?_⟩
  · rintro ν u₁ u₂ p₁ p₂ O hO hu hp ⟨x, t⟩ hz
    have hNt : {s : ℝ | ((x, s) : ℝ³ × ℝ) ∈ O} ∈ nhds t :=
      (hO.preimage (continuous_const.prodMk continuous_id)).mem_nhds hz
    have hNx : {y : ℝ³ | ((y, t) : ℝ³ × ℝ) ∈ O} ∈ nhds x :=
      (hO.preimage (continuous_id.prodMk continuous_const)).mem_nhds hz
    have E1 : (fun s => u₁ x s) =ᶠ[nhds t] (fun s => u₂ x s) :=
      Filter.eventuallyEq_of_mem hNt (fun s hs => hu (x, s) hs)
    have E2 : (fun y => u₁ y t) =ᶠ[nhds x] (fun y => u₂ y t) :=
      Filter.eventuallyEq_of_mem hNx (fun y hy => hu (y, t) hy)
    have E3 : (fun y => p₁ y t) =ᶠ[nhds x] (fun y => p₂ y t) :=
      Filter.eventuallyEq_of_mem hNx (fun y hy => hp (y, t) hy)
    have E0 : u₁ x t = u₂ x t := hu (x, t) hz
    have h4 : deriv (fun s => u₁ x s) t = deriv (fun s => u₂ x s) t := E1.deriv_eq
    have h5 : fderiv ℝ (fun y => u₁ y t) x = fderiv ℝ (fun y => u₂ y t) x := E2.fderiv_eq
    have h6 : Δ (fun y => u₁ y t) x = Δ (fun y => u₂ y t) x :=
      (InnerProductSpace.laplacian_congr_nhds E2).eq_of_nhds
    have h7 : gradient (fun y => p₁ y t) x = gradient (fun y => p₂ y t) x := E3.gradient_eq
    show nsResidual ν u₁ p₁ x t = nsResidual ν u₂ p₂ x t
    unfold nsResidual
    rw [h4, h5, h6, h7, E0]
  · intro ν x t
    unfold nsResidual
    have h1 : Δ (fun _ : ℝ³ => (0 : ℝ³)) = 0 := InnerProductSpace.laplacian_const
    simp [h1, gradient_fun_const]

theorem pulse_split_identity_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 →
    ∀ (S : CState) (D : WC) (E : WS) (β β' : ℝ), InWg5 B G (qsOf l0) 1 S.Aw → InWg5 B G (qsOf l0) 1 S.pw →
    InM B (qsOf l0) (1/2) S.Psi → InM B (qsOf l0) (1/2) S.bdir → InWg5 B G (qsOf l0) β D →
    InWg5 B G (qsOf l0) β' E → ContDiffOn ℝ ∞ (pmP5 B G l0 S) (DomC B.h (qsOf l0)) →
    ContDiffOn ℝ ∞ (pmP5 B G l0 (waveAdd S D E)) (DomC B.h (qsOf l0)) →
    ∀ x t Y, corrOn B l0 x t →
      resX B.h (uX5 B G l0 (waveAdd S D E)) (PX5 B G l0 (waveAdd S D E)) x t Y
        - thAvgVec (resX B.h (uX5 B G l0 (waveAdd S D E)) (PX5 B G l0 (waveAdd S D E))) x t Y =
      (resX B.h (uX5 B G l0 S) (PX5 B G l0 S) x t Y - thAvgVec (resX B.h (uX5 B G l0 S) (PX5 B G l0 S)) x t Y)
        + (LinT5 B G l0 D E x t Y - thAvgVec (LinT5 B G l0 D E) x t Y)
        + (CrT5 B G l0 S D x t Y - thAvgVec (CrT5 B G l0 S D) x t Y)
        + (SfT5 B G l0 D x t Y - thAvgVec (SfT5 B G l0 D) x t Y) :=
by
  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, hqB1, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 S D E β β' hAw hpw hPsi hbd hD hE hpmS hpmS' => ?_⟩
  intro x t Y hxt
  have hxt' : 0 < rad x ∧ t < 1 ∧ simScale B.h (x 2) (1 - t) < qsOf l0 := hxt

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le

  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hS : SimScaleProps B.h := hok.1
  have hc3 : ∀ i : Fin 3, ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => w.1 i) := fun i =>
    (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).contDiff.comp contDiff_fst
  have hψ : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
    (hc3 2).prodMk (contDiff_const.sub contDiff_snd)
  have hqH : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} :=
    hS.2.2.2.1.comp hψ.contDiffOn (fun w hw =>
      ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by linarith [show w.2 < 1 from hw]⟩)
  have hHo : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  have hradc : Continuous (fun w : ℝ³ × ℝ => rad w.1) := by
    unfold rad
    fun_prop
  have hCO : IsOpen {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} := by
    have h1 : IsOpen {w : ℝ³ × ℝ | 0 < rad w.1} := isOpen_lt continuous_const hradc
    have h2 : IsOpen ({w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0)) :=
      hqH.continuousOn.isOpen_inter_preimage hHo isOpen_Iio
    have e : {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} = {w : ℝ³ × ℝ | 0 < rad w.1} ∩
        ({w : ℝ³ × ℝ | w.2 < 1} ∩
          (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0)) := by
      ext w; rfl
    rw [e]; exact h1.inter h2
  have hsubCO : {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} ⊆ simDomain B.h B.qB :=
    fun z hz => ⟨hz.2.1, lt_of_lt_of_le hz.2.2 hqsB⟩

  obtain ⟨hDo, hub, -, -, -⟩ := bg_flow_props B hok
  have huBd : ∀ (y : ℝ³) (s : ℝ), corrOn B l0 y s → DifferentiableAt ℝ (fun w => uB B w s) y := by
    intro y s hc
    have hmemD : ((y, s) : ℝ³ × ℝ) ∈ simDomain B.h B.qB := hsubCO hc
    exact ((hub.contDiffAt (hDo.mem_nhds hmemD)).comp y
      ((contDiff_id.prodMk contDiff_const).contDiffAt)).differentiableAt (by simp)

  have hfsV : ∀ (α : ℝ) (a : WC), InWg5 B G (qsOf l0) α a → ∀ ξ ∈ DomC B.h (qsOf l0), ∀ (θ : ℝ) (i : Fin 3),
      (∀ γ, Function.HasFiniteSupport (fun m : ℤ => a γ m ξ i * ephase5 B G γ m θ ξ)) ∧
      Function.HasFiniteSupport (fun γ : Lab => ∑ᶠ m : ℤ, a γ m ξ i * ephase5 B G γ m θ ξ) := by
    intro α a ea ξ hξ θ i
    obtain ⟨H, -, hH⟩ := ea.1
    obtain ⟨N, hN, Γ, hΓ⟩ := etaL_local_finite_v5 B.h hok.1 ξ hξ.2.1
    refine ⟨fun γ => ?_, ?_⟩
    · refine Set.Finite.subset H.finite_toSet (fun m hm => ?_)
      by_contra hmH
      apply hm
      simp [hH γ m hmH]
    · refine Set.Finite.subset Γ.finite_toSet (fun γ hγ => ?_)
      by_contra hγΓ
      apply hγ
      apply finsum_eq_zero_of_forall_eq_zero
      intro m
      have h0 : a γ m ξ = 0 := by
        by_contra hne
        exact hγΓ (hΓ γ ξ (mem_of_mem_nhds hN) (ea.2.2.2.1 γ m ξ hξ hne).2.1)
      simp [h0]
  have hfsS : ∀ (α : ℝ) (a : WS), InWg5 B G (qsOf l0) α a → ∀ ξ ∈ DomC B.h (qsOf l0), ∀ (θ : ℝ),
      (∀ γ, Function.HasFiniteSupport (fun m : ℤ => a γ m ξ * ephase5 B G γ m θ ξ)) ∧
      Function.HasFiniteSupport (fun γ : Lab => ∑ᶠ m : ℤ, a γ m ξ * ephase5 B G γ m θ ξ) := by
    intro α a ea ξ hξ θ
    obtain ⟨H, -, hH⟩ := ea.1
    obtain ⟨N, hN, Γ, hΓ⟩ := etaL_local_finite_v5 B.h hok.1 ξ hξ.2.1
    refine ⟨fun γ => ?_, ?_⟩
    · refine Set.Finite.subset H.finite_toSet (fun m hm => ?_)
      by_contra hmH
      apply hm
      simp [hH γ m hmH]
    · refine Set.Finite.subset Γ.finite_toSet (fun γ hγ => ?_)
      by_contra hγΓ
      apply hγ
      apply finsum_eq_zero_of_forall_eq_zero
      intro m
      have h0 : a γ m ξ = 0 := by
        by_contra hne
        exact hγΓ (hΓ γ ξ (mem_of_mem_nhds hN) (ea.2.2.2.1 γ m ξ hξ hne).2.1)
      simp [h0]
  have hwV : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ θ : ℝ,
      waveV5 B G (S.Aw + D) θ ξ = waveV5 B G S.Aw θ ξ + waveV5 B G D θ ξ := by
    intro ξ hξ θ
    funext i
    obtain ⟨ha1, ha2⟩ := hfsV 1 S.Aw hAw ξ hξ θ i
    obtain ⟨hb1, hb2⟩ := hfsV β D hD ξ hξ θ i
    show (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, (S.Aw + D) γ m ξ i * ephase5 B G γ m θ ξ).re =
      (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, S.Aw γ m ξ i * ephase5 B G γ m θ ξ).re +
        (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, D γ m ξ i * ephase5 B G γ m θ ξ).re
    rw [← Complex.add_re, ← finsum_add_distrib ha2 hb2]
    congr 1
    refine finsum_congr (fun γ => ?_)
    rw [← finsum_add_distrib (ha1 γ) (hb1 γ)]
    refine finsum_congr (fun m => ?_)
    simp only [Pi.add_apply, add_mul]
  have hwS : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ θ : ℝ,
      waveS5 B G (S.pw + E) θ ξ = waveS5 B G S.pw θ ξ + waveS5 B G E θ ξ := by
    intro ξ hξ θ
    obtain ⟨ha1, ha2⟩ := hfsS 1 S.pw hpw ξ hξ θ
    obtain ⟨hb1, hb2⟩ := hfsS β' E hE ξ hξ θ
    show (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, (S.pw + E) γ m ξ * ephase5 B G γ m θ ξ).re =
      (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, S.pw γ m ξ * ephase5 B G γ m θ ξ).re +
        (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, E γ m ξ * ephase5 B G γ m θ ξ).re
    rw [← Complex.add_re, ← finsum_add_distrib ha2 hb2]
    congr 1
    refine finsum_congr (fun γ => ?_)
    rw [← finsum_add_distrib (ha1 γ) (hb1 γ)]
    refine finsum_congr (fun m => ?_)
    simp only [Pi.add_apply, add_mul]
  have hcyl : ∀ (y : ℝ³) (u v : Fin 3 → ℝ), cyl2cart y (u + v) = cyl2cart y u + cyl2cart y v := by
    intro y u v
    simp only [cyl2cart, Pi.add_apply, add_smul]
    abel

  have hAadd : ∀ (y : ℝ³) (s : ℝ) (Z : ℝ × ℝ),
      AX5 B G l0 (waveAdd S D E) y s Z = AX5 B G l0 S y s Z + AincX5 B G l0 D y s Z := by
    intro y s Z
    by_cases hc : corrOn B l0 y s
    · have hmem : ptOf y s Z ∈ DomC B.h (qsOf l0) := hc
      simp only [AX5, AincX5, waveAdd, if_pos hc]
      rw [hwV _ hmem, hcyl]
      simp only [smul_add]
      abel
    · simp only [AX5, AincX5, if_neg hc, add_zero]

  have hgd : ∀ ξ ∈ DomC B.h (qsOf l0),
      DifferentiableAt ℝ (fun η => pmP5 B G l0 (waveAdd S D E) η - pmP5 B G l0 S η) ξ := by
    intro ξ hξ
    exact ((hpmS'.contDiffAt (hDopen.mem_nhds hξ)).differentiableAt (by simp)).sub
      ((hpmS.contDiffAt (hDopen.mem_nhds hξ)).differentiableAt (by simp))
  have hMon : ∀ (y : ℝ³) (s : ℝ) (Y'' : ℝ × ℝ), corrOn B l0 y s →
      (fun y s Y'' => PX5 B G l0 (waveAdd S D E) y s Y'' - PX5 B G l0 S y s Y''
        - pwIncX5 B G l0 E y s Y'') y s Y'' =
      (fun η => pmP5 B G l0 (waveAdd S D E) η - pmP5 B G l0 S η) (ptOf y s Y'') := by
    intro y s Y'' hc
    have hmem : ptOf y s Y'' ∈ DomC B.h (qsOf l0) := hc
    simp only [PX5, pwIncX5, waveAdd, if_pos hc]
    rw [hwS _ hmem]
    ring
  have hMoff : ∀ (y : ℝ³) (s : ℝ) (Y'' : ℝ × ℝ), ¬ corrOn B l0 y s →
      (fun y s Y'' => PX5 B G l0 (waveAdd S D E) y s Y'' - PX5 B G l0 S y s Y''
        - pwIncX5 B G l0 E y s Y'') y s Y'' = 0 := by
    intro y s Y'' hc
    simp only [PX5, pwIncX5, if_neg hc]
    ring
  have hs4 := psi5_pm_grad_frame B l0 (fun η => pmP5 B G l0 (waveAdd S D E) η - pmP5 B G l0 S η)
    (fun y s Y'' => PX5 B G l0 (waveAdd S D E) y s Y'' - PX5 B G l0 S y s Y''
      - pwIncX5 B G l0 E y s Y'') hok hgd hMon hMoff
  have hMd : ∀ (y : ℝ³) (s : ℝ) (Z : ℝ × ℝ), corrOn B l0 y s →
      DifferentiableAt ℝ (fun w => PX5 B G l0 (waveAdd S D E) w s (Yph B.h (rad w) s + (Z - Yph B.h (rad y) s))
        - PX5 B G l0 S w s (Yph B.h (rad w) s + (Z - Yph B.h (rad y) s))
        - pwIncX5 B G l0 E w s (Yph B.h (rad w) s + (Z - Yph B.h (rad y) s))) y := by
    intro y s Z hc
    obtain ⟨c0, c2, h⟩ := hs4 y s Z hc
    exact (h y rfl rfl).1

  have hF1 := fun Y₀ => psi5_state_fields_smooth B G l0 S 1 1 (1/2) (1/2) Y₀ hok hG hqsB hAw hpw hPsi hbd hpmS
  have hF2 := fun Y₀ => psi5_incr_fields_smooth B G l0 D E β β' Y₀ hok hG hqsB hD hE

  have hsplit := psi5_pointwise_split B G l0 S D E hCO (nsResidual_local_and_zero.1 1)
    (fun Y₀ => (hF1 Y₀).1) (fun Y₀ => (hF1 Y₀).2.1) (fun Y₀ => (hF1 Y₀).2.2)
    (fun Y₀ => (hF2 Y₀).1) (fun Y₀ => (hF2 Y₀).2.1) (fun Y₀ => (hF2 Y₀).2.2) huBd hAadd hMd

  have hr0 : 0 < rad x := hxt'.1
  have hrot : ∀ θ : ℝ, rad (rotPt (rad x) θ (x 2)) = rad x ∧ (rotPt (rad x) θ (x 2)) 2 = x 2 := by
    intro θ
    have e0 : (rotPt (rad x) θ (x 2)) 0 = rad x * Real.cos θ := by simp [rotPt]
    have e1 : (rotPt (rad x) θ (x 2)) 1 = rad x * Real.sin θ := by simp [rotPt]
    have e2 : (rotPt (rad x) θ (x 2)) 2 = x 2 := by simp [rotPt]
    refine ⟨?_, e2⟩
    have hsq : (rad x * Real.cos θ) ^ 2 + (rad x * Real.sin θ) ^ 2 = rad x ^ 2 := by
      have hcs := Real.cos_sq_add_sin_sq θ
      calc (rad x * Real.cos θ) ^ 2 + (rad x * Real.sin θ) ^ 2
          = rad x ^ 2 * (Real.cos θ ^ 2 + Real.sin θ ^ 2) := by ring
        _ = rad x ^ 2 := by rw [hcs, mul_one]
    rw [show rad (rotPt (rad x) θ (x 2)) =
        Real.sqrt ((rotPt (rad x) θ (x 2)) 0 ^ 2 + (rotPt (rad x) θ (x 2)) 1 ^ 2) from rfl, e0, e1, hsq,
      Real.sqrt_sq hr0.le]
  have hcirc : ∀ θ : ℝ, corrOn B l0 (rotPt (rad x) θ (x 2)) t := by
    intro θ
    obtain ⟨e1, e2⟩ := hrot θ
    show 0 < rad (rotPt (rad x) θ (x 2)) ∧ t < 1 ∧ simScale B.h ((rotPt (rad x) θ (x 2)) 2) (1 - t) < qsOf l0
    rw [e1, e2]
    exact hxt'
  obtain ⟨Z0, hZ0⟩ : ∃ Z0 : ℝ × ℝ, Y - Yph B.h (rad x) t = Z0 := ⟨_, rfl⟩
  have hoff : ∀ θ : ℝ, Yph B.h (rad (rotPt (rad x) θ (x 2))) t + Z0 = Y := by
    intro θ
    rw [← hZ0, (hrot θ).1]
    abel

  obtain ⟨FG, hFGv⟩ : ∃ F : Ext ℝ³, ∀ y s Y0, F y s Y0 =
      gradient (fun w => PX5 B G l0 (waveAdd S D E) w s (Yph B.h (rad w) s + (Y0 - Yph B.h (rad y) s))
        - PX5 B G l0 S w s (Yph B.h (rad w) s + (Y0 - Yph B.h (rad y) s))
        - pwIncX5 B G l0 E w s (Yph B.h (rad w) s + (Y0 - Yph B.h (rad y) s))) y :=
    ⟨fun y s Y0 => gradient (fun w => PX5 B G l0 (waveAdd S D E) w s (Yph B.h (rad w) s + (Y0 - Yph B.h (rad y) s))
        - PX5 B G l0 S w s (Yph B.h (rad w) s + (Y0 - Yph B.h (rad y) s))
        - pwIncX5 B G l0 E w s (Yph B.h (rad w) s + (Y0 - Yph B.h (rad y) s))) y, fun _ _ _ => rfl⟩
  have hR : ∀ y, corrOn B l0 y t →
      resX B.h (uX5 B G l0 (waveAdd S D E)) (PX5 B G l0 (waveAdd S D E)) y t Y =
        resX B.h (uX5 B G l0 S) (PX5 B G l0 S) y t Y + LinT5 B G l0 D E y t Y + CrT5 B G l0 S D y t Y
          + SfT5 B G l0 D y t Y + FG y t Y := by
    intro y hy
    rw [hFGv]
    exact hsplit y t Y hy
  obtain ⟨d0, d2, hgf⟩ := hs4 x t Y hxt
  obtain ⟨hFGavg, hFGint⟩ := pws_frame_avg FG x t Y d0 0 d2 hr0 (fun θ => by
    obtain ⟨e1, e2⟩ := hrot θ
    rw [hFGv, zero_smul, add_zero]
    exact (hgf _ e1 e2).2)

  have hcontTr : ∀ (u w : ℝ³ → ℝ → ℝ³), ContDiffOn ℝ ∞ (↿u) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} →
      ContDiffOn ℝ ∞ (↿w) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} →
      ContinuousOn (fun y => fderiv ℝ (fun y' => w y' t) y (u y t)) {y : ℝ³ | corrOn B l0 y t} := by
    intro u w hu hw
    have hι : ContDiff ℝ ∞ (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) := contDiff_id.prodMk contDiff_const
    have hOt : IsOpen {y : ℝ³ | corrOn B l0 y t} :=
      hCO.preimage (continuous_id.prodMk continuous_const)
    have hmaps : Set.MapsTo (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) {y : ℝ³ | corrOn B l0 y t}
        {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} := fun y hy => hy
    have hw' : ContDiffOn ℝ ∞ (fun y' => w y' t) {y : ℝ³ | corrOn B l0 y t} :=
      hw.comp hι.contDiffOn hmaps
    have hu' : ContDiffOn ℝ ∞ (fun y' => u y' t) {y : ℝ³ | corrOn B l0 y t} :=
      hu.comp hι.contDiffOn hmaps
    exact (hw'.continuousOn_fderiv_of_isOpen hOt (by simp)).clm_apply hu'.continuousOn
  have hcontGen : ∀ F : ℝ³ → ℝ → ℝ³, ContDiffOn ℝ ∞ (↿F) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} →
      ContinuousOn (fun y => F y t) {y : ℝ³ | corrOn B l0 y t} := fun F hF =>
    hF.continuousOn.comp (f := fun y : ℝ³ => ((y, t) : ℝ³ × ℝ))
      (continuous_id.prodMk continuous_const).continuousOn (fun y hy => hy)
  have hcontRes : ∀ (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ),
      ContDiffOn ℝ ∞ (↿u) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} →
      ContDiffOn ℝ ∞ (↿p) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} →
      ContinuousOn (fun y => nsResidual 1 u p y t) {y : ℝ³ | corrOn B l0 y t} := fun u p hu hp =>
    hcontGen (nsResidual 1 u p) (nsResidual_contDiffOn_eq_jet 1 u p _ hCO hu hp).1
  have hint : ∀ F : Ext ℝ³, ContinuousOn (fun y => F y t (Yph B.h (rad y) t + Z0)) {y : ℝ³ | corrOn B l0 y t} →
      ∀ a : Fin 3, IntervalIntegrable (fun θ => inner ℝ (F (rotPt (rad x) θ (x 2)) t Y)
        (frameAt θ (ptOf x t Y) a)) MeasureTheory.volume 0 (2 * Real.pi) := by
    intro F hF a
    have h0 := pws_circle_integrable (fun y s (_ : ℝ × ℝ) => F y s (Yph B.h (rad y) s + Z0)) x t Y
      {y : ℝ³ | corrOn B l0 y t} hr0 hF hcirc a
    have e : (fun θ => inner ℝ (F (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) =
        (fun θ => inner ℝ ((fun y s (_ : ℝ × ℝ) => F y s (Yph B.h (rad y) s + Z0))
          (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) := by
      funext θ
      simp only [hoff θ]
    rw [e]
    exact h0
  have huBCO : ContDiffOn ℝ ∞ (↿(evOff B.h (pwrUB B) Z0)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} :=
    (hub.mono hsubCO).congr (fun z _ => rfl)
  have hW := (hF2 Z0).2.1
  have hPi := (hF2 Z0).2.2
  have hUd : ContDiffOn ℝ ∞ (↿(evOff B.h (dUX5 B G l0 S) Z0)) {z : ℝ³ × ℝ | corrOn B l0 z.1 z.2} :=
    ((hF1 Z0).2.1.sub huBCO).congr (fun z _ => rfl)
  have hRint := hint (resX B.h (uX5 B G l0 S) (PX5 B G l0 S))
    ((hcontRes _ _ (hF1 Z0).2.1 (hF1 Z0).2.2).congr (fun y _ => by
      simp only [resX, add_sub_cancel_left]))
  have hLint := hint (LinT5 B G l0 D E)
    ((((hcontRes _ _ hW hPi).sub (hcontTr _ _ hW hW)).add (hcontTr _ _ huBCO hW)).add
      (hcontTr _ _ hW huBCO) |>.congr (fun y _ => by
      simp only [LinT5, resX, pwrTr, add_sub_cancel_left, Pi.add_apply, Pi.sub_apply]))
  have hCint := hint (CrT5 B G l0 S D)
    (((hcontTr _ _ hUd hW).add (hcontTr _ _ hW hUd)).congr (fun y _ => by
      simp only [CrT5, pwrTr, add_sub_cancel_left, Pi.add_apply]))
  have hSint := hint (SfT5 B G l0 D)
    ((hcontTr _ _ hW hW).congr (fun y _ => by
      simp only [SfT5, pwrTr, add_sub_cancel_left]))

  have hsum := pws_avg_add5 (resX B.h (uX5 B G l0 (waveAdd S D E)) (PX5 B G l0 (waveAdd S D E)))
    (resX B.h (uX5 B G l0 S) (PX5 B G l0 S)) (LinT5 B G l0 D E) (CrT5 B G l0 S D) (SfT5 B G l0 D) FG
    x t Y (fun θ => hR _ (hcirc θ)) hRint hLint hCint hSint hFGint
  have hFGx : thAvgVec FG x t Y = FG x t Y := by
    rw [hFGavg, zero_smul, add_zero, hFGv]
    exact (hgf x rfl rfl).2.symm
  rw [hsum, hR x hxt, hFGx]
  abel

theorem slin5_mode_rep : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (D : WC) (E : WS) (α β : ℝ), InWg5 B G (qsOf l0) α D → InWg5 B G (qsOf l0) β E → ∀ x t Y, corrOn B l0 x t → sw5L B G l0 D E x t Y = qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2)) • cyl2cart x (waveV5 B G (linG5 B G D E) (thetaOf x) (ptOf x t Y)) :=
by

  have cofS : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ l0 : ℕ, qsOf l0 ≤ B.qB →
      ∀ (D : WC) (E : WS) (α β : ℝ), InWg5 B G (qsOf l0) α D → InWg5 B G (qsOf l0) β E →
      ∀ (γ : Lab) (m : ℤ), ContDiffOn ℝ ∞ (cofAG5 B G D γ m) (DomC B.h (qsOf l0)) ∧
        ContDiffOn ℝ ∞ (cofPG5 B G E γ m) (DomC B.h (qsOf l0)) := by
    intro B G hok hG l0 hqs D E α β hDw hEw γ m
    have hqsm : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h (qsOf l0)) := by
      have h4' : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
        hok.1.2.2.2.1
      have hφ : ContDiff ℝ ∞ (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
      have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
          (DomC B.h (qsOf l0)) (univ ×ˢ Ioi 0) := by
        intro ξ hξ
        have h' : ξ.2.2.1 < 1 := hξ.2.1
        exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
      exact (h4'.comp hφ.contDiffOn hmaps).congr (fun ξ _ => rfl)
    have hqpos : ∀ η ∈ DomC B.h (qsOf l0), 0 < qC B.h η := by
      intro η hη
      have h' : η.2.2.1 < 1 := hη.2.1
      exact (hok.1.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
    have hqpow : ∀ c : ℝ, ContDiffOn ℝ ∞ (fun η : Cyl => ((qC B.h η ^ c : ℝ) : ℂ))
        (DomC B.h (qsOf l0)) := by
      intro c
      have hr : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η ^ c) (DomC B.h (qsOf l0)) :=
        hqsm.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')
      exact (Complex.ofRealCLM.contDiff.comp_contDiffOn hr).congr
        (fun η _ => by simp only [Function.comp_apply, Complex.ofRealCLM_apply])
    have K : ∀ f : Cyl → ℂ, ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) →
        (∀ ξ ∈ DomC B.h (qsOf l0), f ξ ≠ 0 → SuppW B G γ ξ) →
        ContDiffOn ℝ ∞ (fun η => f η *
          Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))))
          (DomC B.h (qsOf l0)) := by
      intro f hf hsupp
      set v : Cyl → ℝ × ℝ := fun η => Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ with hv
      have hvc : Continuous v := by
        rw [hv]
        unfold Jpow
        fun_prop
      have hbase : ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => baseC B γ.1 η j)
          (DomC B.h (qsOf l0)) := by
        intro j
        obtain ⟨_, hsm⟩ := geom_slow_base_smooth_v5 B hok
        have hπ : ContDiff ℝ ∞ (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) :=
          contDiff_fst.prodMk (contDiff_snd.fst.prodMk contDiff_snd.snd.fst)
        have hc := (hsm γ.1 j).comp hπ.contDiffOn
          (fun ξ (hξ : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0) =>
            (⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqs⟩ : ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ) ∈
              {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}))
        exact hc.congr (fun ξ _ => rfl)
      have hZ : ContDiff ℝ ∞ (fun η : Cyl => chartZ B.h γ.1 η) := by
        unfold chartZ
        exact contDiff_snd.fst.div_const _
      have hRC : ContDiff ℝ ∞ (fun η : Cyl => RC γ.1 η) := by
        unfold RC
        exact contDiff_fst.div_const _
      have hRCpos : ∀ η ∈ DomC B.h (qsOf l0), RC γ.1 η ≠ 0 := by
        intro η hη
        have hr : 0 < η.1 := hη.1
        have : 0 < RC γ.1 η :=
          div_pos hr (Real.sqrt_pos.mpr (Real.rpow_pos_of_pos (by norm_num) _))
        exact this.ne'
      have hF : ContDiffOn ℝ ∞ (fun η : Cyl => Fang B γ.1 η) (DomC B.h (qsOf l0)) :=
        ((hbase 1).div hRC.contDiffOn hRCpos).congr (fun η _ => rfl)
      apply contDiffOn_of_locally_contDiffOn
      intro ξ₀ _
      set U' : Set Cyl := {η | |(v η).1 - (v ξ₀).1| < 1/8} ∩ {η | |(v η).2 - (v ξ₀).2| < 1/8}
        with hU'
      have hU'o : IsOpen U' :=
        (isOpen_lt ((hvc.fst.sub continuous_const).abs) continuous_const).inter
          (isOpen_lt ((hvc.snd.sub continuous_const).abs) continuous_const)
      have hξU : ξ₀ ∈ U' := by
        refine ⟨?_, ?_⟩
        · show |(v ξ₀).1 - (v ξ₀).1| < 1/8
          rw [sub_self, abs_zero]; norm_num
        · show |(v ξ₀).2 - (v ξ₀).2| < 1/8
          rw [sub_self, abs_zero]; norm_num
      refine ⟨U', hU'o, hξU, ?_⟩
      by_cases hA : ∀ η ∈ DomC B.h (qsOf l0) ∩ U', f η = 0
      · refine (contDiffOn_const (c := (0:ℂ))).congr (fun p hp => ?_)
        have h0 := hA p hp
        simp [h0]
      · push_neg at hA
        obtain ⟨η1, ⟨hη1D, hη1U⟩, hη1⟩ := hA
        obtain ⟨-, -, hxi, het, -, -⟩ := hsupp η1 hη1D hη1
        have hr0 : G.r0 ≤ 1/100 := hG.1.2.1
        have hb0 : 0 ≤ bgc := by unfold bgc; linarith [Real.one_lt_sqrt_two]
        have hb1 : bgc ≤ 1 := by
          unfold bgc
          nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
        have hden : (1 + bgc ^ 2) * (1 + bgc ^ 2)⁻¹ = 1 := mul_inv_cancel₀ (by positivity)
        have id1 : ∀ w : ℝ × ℝ, w.1 = lamR w + bgc * lamT w := by
          intro w
          simp only [lamR, lamT, div_eq_mul_inv]
          linear_combination (-w.1) * hden
        have id2 : ∀ w : ℝ × ℝ, w.2 = -(bgc * lamR w) + lamT w := by
          intro w
          simp only [lamR, lamT, div_eq_mul_inv]
          linear_combination (-w.2) * hden
        have key : ∀ (R T : ℝ), |R| ≤ G.r0 / 4 → |T| ≤ G.r0 →
            |R + bgc * T| ≤ 1/80 ∧ |-(bgc * R) + T| ≤ 1/80 := by
          intro R T hR hT
          obtain ⟨hR1, hR2⟩ := abs_le.mp hR
          obtain ⟨hT1, hT2⟩ := abs_le.mp hT
          have hr0n : 0 ≤ G.r0 := le_trans (abs_nonneg _) hT
          have e1 : bgc * T ≤ G.r0 := by
            nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hT2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
          have e2 : -G.r0 ≤ bgc * T := by
            nlinarith [mul_nonneg hb0 (show 0 ≤ T + G.r0 by linarith),
              mul_nonneg (sub_nonneg.mpr hb1) hr0n]
          have e3 : bgc * R ≤ G.r0 / 4 := by
            nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hR2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
          have e4 : -(G.r0 / 4) ≤ bgc * R := by
            nlinarith [mul_nonneg hb0 (show 0 ≤ R + G.r0 / 4 by linarith),
              mul_nonneg (sub_nonneg.mpr hb1) hr0n]
          exact ⟨abs_le.mpr ⟨by linarith, by linarith⟩, abs_le.mpr ⟨by linarith, by linarith⟩⟩
        have hround : ∀ (x : ℝ) (k : ℤ), |x - k| < 1/2 → round x = k := by
          intro x k hk
          rw [round_eq, Int.floor_eq_iff]
          obtain ⟨h1, h2⟩ := abs_lt.mp hk
          constructor <;> linarith
        have hw1 : |lamR (frac0 (v η1))| ≤ G.r0 / 4 := hxi
        have hw2 : |lamT (frac0 (v η1))| ≤ G.r0 := het
        have hw := key _ _ hw1 hw2
        have ex1 : (v η1).1 - ((round (v η1).1 : ℤ) : ℝ) =
            lamR (frac0 (v η1)) + bgc * lamT (frac0 (v η1)) := id1 (frac0 (v η1))
        have ex2 : (v η1).2 - ((round (v η1).2 : ℤ) : ℝ) =
            -(bgc * lamR (frac0 (v η1))) + lamT (frac0 (v η1)) := id2 (frac0 (v η1))
        have hx1 : |(v η1).1 - ((round (v η1).1 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex1]; exact hw.1
        have hx2 : |(v η1).2 - ((round (v η1).2 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex2]; exact hw.2
        obtain ⟨kk, hkk⟩ : ∃ kk : ℝ × ℝ,
            kk = (((round (v η1).1 : ℤ) : ℝ), ((round (v η1).2 : ℤ) : ℝ)) := ⟨_, rfl⟩
        have hfr : ∀ η ∈ U', frac0 (v η) = v η - kk := by
          intro η hη
          have h1 : |(v η).1 - (v ξ₀).1| < 1/8 := hη.1
          have h2 : |(v η).2 - (v ξ₀).2| < 1/8 := hη.2
          have g1 : |(v η1).1 - (v ξ₀).1| < 1/8 := hη1U.1
          have g2 : |(v η1).2 - (v ξ₀).2| < 1/8 := hη1U.2
          obtain ⟨a1, a2⟩ := abs_lt.mp h1
          obtain ⟨a3, a4⟩ := abs_lt.mp h2
          obtain ⟨b1, b2⟩ := abs_lt.mp g1
          obtain ⟨b3, b4⟩ := abs_lt.mp g2
          obtain ⟨c1, c2⟩ := abs_le.mp hx1
          obtain ⟨c3, c4⟩ := abs_le.mp hx2
          have r1 : round (v η).1 = round (v η1).1 :=
            hround _ _ (abs_lt.mpr ⟨by linarith, by linarith⟩)
          have r2 : round (v η).2 = round (v η1).2 :=
            hround _ _ (abs_lt.mpr ⟨by linarith, by linarith⟩)
          rw [hkk]
          unfold frac0
          rw [r1, r2]
          rfl
        have hT : ContDiff ℝ ∞ (fun η : Cyl => lamT (v η - kk)) := by
          simp only [hv, lamT, Jpow, div_eq_mul_inv]
          fun_prop
