  have hpt : ∀ y ∈ Iic (rfpY4 P.Md P.lam), Real.exp y * (rfpU P (Real.exp y) η *
        (2 * Real.exp y * rfpF P (Real.exp y) η)) =
      (η * (1 + η ^ 2)⁻¹) * (Real.sqrt 2 * Real.exp (3 / 2 * y + rfpLam P y) * rfpK P.Md y)
      + (((1 + η ^ 2)⁻¹) ^ 2 * P.Amp η) * (Real.sqrt 2 * Real.exp (3 / 2 * y + 2 * rfpLam P y) *
          rfpR0 (P.lam * (y - rfpY3 P.Md P.lam)))
      + (((1 + η ^ 2)⁻¹) ^ 2 * P.c1 η) * (Real.sqrt 2 * Real.exp (3 / 2 * y + 2 * rfpLam P y) *
          rfpBmp (y - rfpY4 P.Md P.lam + 3))
      + (((1 + η ^ 2)⁻¹) ^ 2 * P.c2 η) * (Real.sqrt 2 * Real.exp (3 / 2 * y + 2 * rfpLam P y) *
