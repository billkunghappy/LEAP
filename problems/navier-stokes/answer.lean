      =ᶠ[nhds ξ] fun η => fderiv ℝ (fun η' : Cyl => F (η'.1, η'.2.1, η'.2.2.1)) η (Lnorm B.h ξ wZ) := by
    refine Filter.eventuallyEq_of_mem (hD.mem_nhds hξB) (fun η hη => ?_)
    rw [hcomp η hη, hvZ, ContinuousLinearMap.map_smul, smul_eq_mul]
  have hR2 : Real.sqrt (Qb l) / Real.sqrt (qC B.h ξ) ≤ 2 := by
    rw [div_le_iff₀ hsq]; exact hsqrt2
  have hpp : qC B.h ξ ^ B.h * qC B.h ξ ^ (1/2 - B.h) = Real.sqrt (qC B.h ξ) := by
    rw [← Real.rpow_add hq0, Real.sqrt_eq_rpow]
    congr 1
    ring
  have hZ2 : Real.sqrt (Qb l) / qC B.h ξ ^ (1/2 - B.h) ≤ 2 * qC B.h ξ ^ B.h := by
    rw [div_le_iff₀ hp0, mul_assoc, hpp]; exact hsqrt2
  have haR : 0 ≤ Real.sqrt (Qb l) / Real.sqrt (qC B.h ξ) := by positivity
  have haZ : 0 ≤ Real.sqrt (Qb l) / qC B.h ξ ^ (1/2 - B.h) := by positivity
  have hqh : 0 ≤ qC B.h ξ ^ B.h := Real.rpow_nonneg hq0.le _
  have hnR : ‖wR‖ ≤ 2 := by
    rw [hwR]
    simp only [Prod.norm_def, norm_zero, max_self, Prod.fst_zero, Prod.snd_zero, Real.norm_eq_abs,
      abs_of_nonneg haR]
    exact max_le hR2 (by norm_num)
  have hnZ : ‖wZ‖ ≤ 2 * qC B.h ξ ^ B.h := by
    rw [hwZ]
    simp only [Prod.norm_def, norm_zero, max_self, Prod.fst_zero, Prod.snd_zero, Real.norm_eq_abs,
      abs_of_nonneg haZ, abs_zero]
    exact max_le (by positivity) (max_le hZ2 (by positivity))
  have hNk : NB B.h (fun η : Cyl => F (η.1, η.2.1, η.2.2.1)) k ξ ≤ Ck := by
    have hc := hCk l ξ hξ hw1 hw2 hX1 hX2
    rcases hF with rfl | rfl
    · exact hc.1
    · exact hc.2
  have hNk1 : NB B.h (fun η : Cyl => F (η.1, η.2.1, η.2.2.1)) (k + 1) ξ ≤ max C3 0 := by
    have hc := hC3 l ξ hξ hw1 hw2 hX1 hX2
    rcases hF with rfl | rfl
    · exact hc.1.trans (le_max_left _ _)
    · exact hc.2.trans (le_max_left _ _)
  have hN0 : 0 ≤ NB B.h (fun η : Cyl => F (η.1, η.2.1, η.2.2.1)) (k + 1) ξ := by
    unfold NB; exact norm_nonneg _
  have hC0 : 0 ≤ max C3 0 := le_max_right _ _
  refine ⟨hNk.trans (le_max_left _ _), ?_, ?_⟩
  · rw [hNBeq _ _ hgermR]
    calc _ ≤ ‖wR‖ * NB B.h (fun η : Cyl => F (η.1, η.2.1, η.2.2.1)) (k + 1) ξ :=
          nbdir B.h _ ξ _ wR hD hξB hGs k
      _ ≤ 2 * max C3 0 := mul_le_mul hnR hNk1 hN0 (by norm_num)
      _ ≤ max Ck (2 * max C3 0) := le_max_right _ _
  · rw [hNBeq _ _ hgermZ]
    calc _ ≤ ‖wZ‖ * NB B.h (fun η : Cyl => F (η.1, η.2.1, η.2.2.1)) (k + 1) ξ :=
          nbdir B.h _ ξ _ wZ hD hξB hGs k
      _ ≤ (2 * qC B.h ξ ^ B.h) * max C3 0 := mul_le_mul hnZ hNk1 hN0 (by positivity)
      _ = 2 * max C3 0 * qC B.h ξ ^ B.h := by ring
      _ ≤ max Ck (2 * max C3 0) * qC B.h ξ ^ B.h :=
          mul_le_mul_of_nonneg_right (le_max_right _ _) hqh

theorem pulse5_consts_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ C : ℝ, 0 < C ∧ ∀ γ : Lab, ActiveL4 B G γ → |Bs5 B G γ| ≤ C ∧ |pzr5 B G γ| ≤ C ∧ |pang5 B G γ| ≤ C ∧ |c0f5 B G γ| ≤ C ∧ 1 ≤ epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2 ∧ epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2 ≤ 4 ∧ epsb B.h γ.1 ≤ 4 * pang5 B G γ ^ 2 :=
by
  intro B G hB hG

  have s2 : ∀ (h : ℝ) (l : ℕ), 0 ≤ h → 0 < epsb h l ∧ 1 ≤ ((kb h l : ℕ) : ℝ) ∧
      1 ≤ epsb h l * ((kb h l : ℕ) : ℝ) ^ 2 ∧ epsb h l * ((kb h l : ℕ) : ℝ) ^ 2 ≤ 4 := by
    intro h l hh
    have hQ0 : 0 < Qb l := Real.rpow_pos_of_pos two_pos _
    have hQ1 : Qb l ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
    have he0 : 0 < epsb h l := Real.rpow_pos_of_pos hQ0 _
    have he1 : epsb h l ≤ 1 := Real.rpow_le_one hQ0.le hQ1 hh
    have hx1 : 1 ≤ epsb h l ^ (-(1/2:ℝ)) :=
      Real.one_le_rpow_of_pos_of_le_one_of_nonpos he0 he1 (by norm_num)
    have hxx : epsb h l * (epsb h l ^ (-(1/2:ℝ))) ^ 2 = 1 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul he0.le]
      have e : (-(1/2:ℝ)) * ((2:ℕ):ℝ) = -1 := by norm_num
      rw [e, Real.rpow_neg_one, mul_inv_cancel₀ he0.ne']
    have hk1 : epsb h l ^ (-(1/2:ℝ)) ≤ ((kb h l : ℕ) : ℝ) := Nat.le_ceil _
    have hk2 : ((kb h l : ℕ) : ℝ) < epsb h l ^ (-(1/2:ℝ)) + 1 := Nat.ceil_lt_add_one (by linarith)
    refine ⟨he0, by linarith, ?_, ?_⟩
    · have hsq : (epsb h l ^ (-(1/2:ℝ))) ^ 2 ≤ ((kb h l : ℕ) : ℝ) ^ 2 :=
        pow_le_pow_left₀ (by linarith) hk1 2
      calc (1:ℝ) = epsb h l * (epsb h l ^ (-(1/2:ℝ))) ^ 2 := hxx.symm
        _ ≤ epsb h l * ((kb h l : ℕ) : ℝ) ^ 2 := mul_le_mul_of_nonneg_left hsq he0.le
    · have hk0 : (0:ℝ) ≤ ((kb h l : ℕ) : ℝ) := Nat.cast_nonneg _
      have hsq : ((kb h l : ℕ) : ℝ) ^ 2 ≤ (2 * epsb h l ^ (-(1/2:ℝ))) ^ 2 :=
        pow_le_pow_left₀ hk0 (by linarith) 2
      calc epsb h l * ((kb h l : ℕ) : ℝ) ^ 2 ≤ epsb h l * (2 * epsb h l ^ (-(1/2:ℝ))) ^ 2 :=
            mul_le_mul_of_nonneg_left hsq he0.le
        _ = 4 * (epsb h l * (epsb h l ^ (-(1/2:ℝ))) ^ 2) := by ring
        _ = 4 := by rw [hxx]; ring

  have s3 : ∀ (k p : ℝ) (z : ℤ), 1 ≤ k → (z = 1 ∨ z = round (k * p)) → z ≠ 0 →
      |(z : ℝ) / k| ≤ |p| + 1 ∧ 1 / k ^ 2 ≤ ((z : ℝ) / k) ^ 2 := by
    intro k p z hk hz hz0
    have hk0 : 0 < k := by linarith
    refine ⟨?_, ?_⟩
    · rw [abs_div, abs_of_pos hk0, div_le_iff₀ hk0]
      rcases hz with rfl | rfl
      · push_cast
        rw [abs_one]
        nlinarith [abs_nonneg p]
      · have h1 := abs_sub_round (k * p)
        have h3 := abs_sub_abs_le_abs_sub ((round (k * p) : ℤ) : ℝ) (k * p)
        rw [abs_sub_comm] at h3
        rw [abs_mul, abs_of_pos hk0] at h3
        nlinarith [abs_nonneg p]
    · have hz1 : (1:ℤ) ≤ |z| := Int.one_le_abs hz0
      have hz1' : (1:ℝ) ≤ |(z:ℝ)| := by
        rw [← Int.cast_abs]; exact_mod_cast hz1
      have hzz : (1:ℝ) ≤ (z:ℝ) ^ 2 := by
        rw [← sq_abs]; nlinarith
      rw [div_pow]
      exact div_le_div_of_nonneg_right hzz (by positivity)

  have s5 : ∀ (u r0 cf ci E x σ : ℝ), 0 < u → 0 < r0 → 0 < cf → cf ≤ E → |x| ≤ E → 0 < ci →
      ci ≤ 1 → |σ| = 1 → |σ * u * x / (2 * r0 / ci * E ^ 2)| ≤ u / (2 * r0 * cf) := by
    intro u r0 cf ci E x σ hu hr0 hcf hcE hxE hci hci1 hσ
    have hE0 : 0 < E := lt_of_lt_of_le hcf hcE
    have hLs0 : 0 < 2 * r0 / ci := div_pos (by linarith) hci
    have hD0 : 0 < 2 * r0 / ci * E ^ 2 := mul_pos hLs0 (by positivity)
    have hLs : 2 * r0 ≤ 2 * r0 / ci := by
      rw [le_div_iff₀ hci]
      nlinarith
    rw [abs_div, abs_mul, abs_mul, hσ, abs_of_pos hu, abs_of_pos hD0,
      div_le_div_iff₀ hD0 (by positivity)]
    have h1 : |x| * cf ≤ E * E := mul_le_mul hxE hcE hcf.le hE0.le
    have h2 : 2 * r0 * E ^ 2 ≤ 2 * r0 / ci * E ^ 2 :=
      mul_le_mul_of_nonneg_right hLs (by positivity)
    have h3 : 1 * u * |x| * (2 * r0 * cf) = u * (2 * r0) * (|x| * cf) := by ring
    rw [h3]
    have h4 : u * (2 * r0) * (|x| * cf) ≤ u * (2 * r0) * (E * E) :=
      mul_le_mul_of_nonneg_left h1 (by positivity)
    have h5 : u * (2 * r0 * E ^ 2) ≤ u * (2 * r0 / ci * E ^ 2) :=
      mul_le_mul_of_nonneg_left h2 hu.le
    nlinarith

  have s4 : ∀ g : ℝ × ℝ, 0 < eN g → |g.1| ≤ eN g ∧ |g.2| ≤ eN g ∧ |((eN g)⁻¹ • g).1| ≤ 1 ∧
      |((eN g)⁻¹ • g).2| ≤ 1 := by
    intro g hE
    have a1 : |g.1| ≤ eN g := Real.abs_le_sqrt (by nlinarith [sq_nonneg g.2])
    have a2 : |g.2| ≤ eN g := Real.abs_le_sqrt (by nlinarith [sq_nonneg g.1])
    refine ⟨a1, a2, ?_, ?_⟩
    · rw [Prod.smul_fst, smul_eq_mul, abs_mul, abs_inv, abs_of_pos hE, inv_mul_le_iff₀ hE]
      linarith
    · rw [Prod.smul_snd, smul_eq_mul, abs_mul, abs_inv, abs_of_pos hE, inv_mul_le_iff₀ hE]
      linarith

  obtain ⟨cf, Cf, hcf, hF⟩ := frame5_consts B G hB hG
  obtain ⟨hh, -, hXa, -⟩ := hB.2.1
  obtain ⟨hr0, -, hu, -, hlmin⟩ := hG.1
  obtain ⟨-, -, hrep, -⟩ := hG
  have hDu : 1 ≤ (1 + G.ustar ^ 2) ^ (3/2:ℝ) :=
    Real.one_le_rpow (by nlinarith [sq_nonneg G.ustar]) (by norm_num)
  have hw0 : 0 ≤ Real.sqrt (4 * B.Xb) := Real.sqrt_nonneg _
  have hs0 : 0 ≤ Real.sqrt |Cf| := Real.sqrt_nonneg _
  have hsl0 : 0 ≤ G.ustar / (2 * G.r0 * cf) := by positivity
  set P : ℝ := Real.sqrt |Cf| * (1 + G.ustar / (2 * G.r0 * cf)) with hPdef
  have hP0 : Real.sqrt |Cf| ≤ P := by
    rw [hPdef]; nlinarith [mul_nonneg hs0 hsl0]
  have hP0' : 0 ≤ P := le_trans hs0 hP0
  have hWP : 0 ≤ Real.sqrt (4 * B.Xb) * P := mul_nonneg hw0 hP0'
  have hCf0 : 0 ≤ |Cf| := abs_nonneg _
  refine ⟨1 + |Cf| + P + Real.sqrt (4 * B.Xb) * P, by linarith, ?_⟩
  intro γ hA
  obtain ⟨-, -, hE, -, -, hlam, hlamC, hc0u, hc0l, -⟩ := hF γ hA
  obtain ⟨hX0a, hX0b, -, hρ1, hρ2, -⟩ := hrep γ hA
  have hl1 : 1 ≤ γ.1 := le_trans (by norm_num) (le_trans hlmin hA.1)
  have hL1 : (1:ℝ) ≤ (γ.1:ℝ) := by exact_mod_cast hl1
  have hE0 : 0 < eN (g0r5 B G γ) := lt_of_lt_of_le hcf hE
  obtain ⟨he0, hk1, hP1, hP4⟩ := s2 B.h γ.1 hh.le

  have s1 : ∀ (h : ℝ) (l : ℕ), 1 ≤ l → 0 < cib h l ∧ cib h l * (l : ℝ) ^ 2 ≤ 1 := by
    intro h l hl
    have hL2 : (0:ℝ) < (l:ℝ) ^ 2 := by
      have : (1:ℝ) ≤ (l:ℝ) := by exact_mod_cast hl
      positivity
    have hT1 : (1:ℝ) < Tgc := by
      unfold Tgc
      have := Real.sqrt_nonneg 2
      linarith
    have hT0 : (0:ℝ) < Tgc := by linarith
    have hy0 : (0:ℝ) < (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) :=
      div_pos (Real.rpow_pos_of_pos two_pos _) hL2
    have hQ0 : 0 < Qb l := Real.rpow_pos_of_pos two_pos _
    have hQp : 0 < Qb l ^ (1 + h) := Real.rpow_pos_of_pos hQ0 _
    have hfl : ((bandIdx h l : ℤ) : ℝ) ≤
        Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2)) := Int.floor_le _
    have hz : Tgc ^ (bandIdx h l) ≤ (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) := by
      rw [← Real.rpow_intCast]
      calc Tgc ^ ((bandIdx h l : ℤ) : ℝ)
          ≤ Tgc ^ (Real.logb Tgc ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2))) :=
            Real.rpow_le_rpow_of_exponent_le hT1.le hfl
        _ = (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) := Real.rpow_logb hT0 hT1.ne' hy0
    have hQe : Qb l ^ (1 + h) * (2:ℝ) ^ ((1 + h) * (l:ℝ)) = 1 := by
      unfold Qb
      rw [← Real.rpow_mul (by norm_num), ← Real.rpow_add two_pos]
      have e : -(l:ℝ) * (1 + h) + (1 + h) * (l:ℝ) = 0 := by ring
      rw [e, Real.rpow_zero]
    have hyL : (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) * (l:ℝ) ^ 2 =
        (2:ℝ) ^ ((1 + h) * (l:ℝ)) := div_mul_cancel₀ _ hL2.ne'
    refine ⟨mul_pos (zpow_pos hT0 _) hQp, ?_⟩
    unfold cib
    calc Tgc ^ (bandIdx h l) * Qb l ^ (1 + h) * (l:ℝ) ^ 2
        ≤ (2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) * Qb l ^ (1 + h) * (l:ℝ) ^ 2 := by
          have := mul_le_mul_of_nonneg_right hz hQp.le
          exact mul_le_mul_of_nonneg_right this hL2.le
      _ = ((2:ℝ) ^ ((1 + h) * (l:ℝ)) / ((l : ℝ) ^ 2) * (l:ℝ) ^ 2) * Qb l ^ (1 + h) := by ring
      _ = 1 := by rw [hyL, mul_comm]; exact hQe
  obtain ⟨hci0, hciL⟩ := s1 B.h γ.1 hl1
  have hci1 : cib B.h γ.1 ≤ 1 := by
    have hl2 : (1:ℝ) ≤ (γ.1:ℝ) ^ 2 := one_le_pow₀ hL1
    nlinarith

  have hPn : (0:ℝ) ≤ epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2 := by linarith
  have hBsU : Bs5 B G γ ≤ Real.sqrt |Cf| := by
    unfold Bs5
    apply Real.sqrt_le_sqrt
    have hD1 : 1 ≤ epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2 * (1 + G.ustar ^ 2) ^ (3/2:ℝ) := by
      have := mul_le_mul hP1 hDu zero_le_one hPn
      linarith
    calc lam0_5 B G γ / (epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2 * (1 + G.ustar ^ 2) ^ (3/2:ℝ))
        ≤ lam0_5 B G γ := div_le_self (by linarith) hD1
      _ ≤ Cf := hlamC
      _ ≤ |Cf| := le_abs_self _
  have hBs0 : 0 ≤ Bs5 B G γ := Real.sqrt_nonneg _

  obtain ⟨hg1, hg2, hn1, hn2⟩ := s4 (g0r5 B G γ) hE0
  have hN1a : |(Nfr5 B G γ).1| ≤ 1 := hn1
  have hN2a : |(Nfr5 B G γ).2| ≤ 1 := hn2
  have hsg : |sgn γ.2.2| = 1 := by
    unfold sgn
    split_ifs <;> simp
  obtain ⟨sz, hpzE, hszb⟩ : ∃ sz : ℝ, pzr5 B G γ = Bs5 B G γ * ((Nfr5 B G γ).1 - sz) ∧
      |sz| ≤ G.ustar / (2 * G.r0 * cf) :=
    ⟨_, rfl, s5 G.ustar G.r0 cf (cib B.h γ.1) (eN (g0r5 B G γ)) _ (sgn γ.2.2) hu hr0 hcf hE hg2
      hci0 hci1 hsg⟩
  obtain ⟨sr, hptE, hsrb⟩ : ∃ sr : ℝ, ptil5 B G γ = R0r B G γ * Bs5 B G γ * (-(Nfr5 B G γ).2 - sr) ∧
      |sr| ≤ G.ustar / (2 * G.r0 * cf) :=
    ⟨_, rfl, s5 G.ustar G.r0 cf (cib B.h γ.1) (eN (g0r5 B G γ)) _ (sgn γ.2.2) hu hr0 hcf hE hg1
      hci0 hci1 hsg⟩

  have hupz : |(Nfr5 B G γ).1 - sz| ≤ 1 + G.ustar / (2 * G.r0 * cf) :=
    le_trans (abs_sub _ _) (by linarith)
  have hpz_up : |pzr5 B G γ| ≤ P := by
    rw [hpzE, abs_mul, abs_of_nonneg hBs0, hPdef]
    exact mul_le_mul hBsU hupz (abs_nonneg _) hs0

  have hR0 : 0 ≤ R0r B G γ := Real.sqrt_nonneg _
  have hRb : R0r B G γ ≤ Real.sqrt (4 * B.Xb) := by
    unfold R0r
    apply Real.sqrt_le_sqrt
    have hX0 : 0 ≤ (G.rep γ).1 := by linarith
    have := mul_le_mul_of_nonneg_left hρ2 hX0
    nlinarith
  have hupr : |-(Nfr5 B G γ).2 - sr| ≤ 1 + G.ustar / (2 * G.r0 * cf) := by
    refine le_trans (abs_sub _ _) ?_
    rw [abs_neg]; linarith
  have hpt : |ptil5 B G γ| ≤ Real.sqrt (4 * B.Xb) * P := by
    rw [hptE, abs_mul, abs_mul, abs_of_nonneg hR0, abs_of_nonneg hBs0, hPdef, ← mul_assoc]
    exact mul_le_mul (mul_le_mul hRb hBsU hBs0 hw0) hupr (abs_nonneg _) (mul_nonneg hw0 hs0)

  have hor : pint5 B G γ = 1 ∨ pint5 B G γ = round (((kb B.h γ.1 : ℕ) : ℝ) * ptil5 B G γ) := by
    unfold pint5
    split_ifs
    · exact Or.inl rfl
    · exact Or.inr rfl
  have hne : pint5 B G γ ≠ 0 := by
    unfold pint5
    split_ifs with hc
    · exact one_ne_zero
    · exact hc
  obtain ⟨hpang, hpsq⟩ := s3 ((kb B.h γ.1 : ℕ) : ℝ) (ptil5 B G γ) (pint5 B G γ) hk1 hor hne
  have hpangE : pang5 B G γ = (pint5 B G γ : ℝ) / ((kb B.h γ.1 : ℕ) : ℝ) := rfl
  rw [← hpangE] at hpang hpsq
  have hk2 : 0 < ((kb B.h γ.1 : ℕ) : ℝ) ^ 2 := by positivity
  have heps : epsb B.h γ.1 ≤ 4 * pang5 B G γ ^ 2 := by
    have e1 : epsb B.h γ.1 = epsb B.h γ.1 * ((kb B.h γ.1 : ℕ) : ℝ) ^ 2 *
        (1 / ((kb B.h γ.1 : ℕ) : ℝ) ^ 2) := by
      field_simp
    rw [e1]
    have h1 : 0 ≤ 1 / ((kb B.h γ.1 : ℕ) : ℝ) ^ 2 := by positivity
    have := mul_le_mul hP4 hpsq h1 (by norm_num)
    linarith

  have hc0 : |c0f5 B G γ| ≤ Cf := by
    rw [abs_of_neg (by linarith)]; linarith
  refine ⟨?_, ?_, ?_, ?_, hP1, hP4, heps⟩
  · rw [abs_of_nonneg hBs0]; linarith
  · linarith
  · linarith
  · linarith [le_abs_self Cf]

theorem pcA5_const_v5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (s : ℝ × ℝ × ℝ), pcA5 B G γ s 0 = sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 ∧ pcA5 B G γ s 2 = pzr5 B G γ :=
by
  intro B G γ s
  have hQ : 0 < Qb γ.1 := by unfold Qb; exact Real.rpow_pos_of_pos (by norm_num) _
  have hsQ : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr hQ
  have hAE : Qb γ.1 ^ (1/2 - B.h) * epsb B.h γ.1 = Real.sqrt (Qb γ.1) := by
    unfold epsb
    rw [← Real.rpow_add hQ, Real.sqrt_eq_rpow]
    congr 1
    ring
  let Λ : ℝ × ℝ × ℝ →L[ℝ] ℝ :=
    (pzr5 B G γ / (Qb γ.1 ^ (1/2 - B.h) * epsb B.h γ.1)) •
        ((ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)))
      + (sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 / Real.sqrt (Qb γ.1)) •
        ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)
  have hΛv : ∀ y : ℝ × ℝ × ℝ, Λ y =
      pzr5 B G γ / (Qb γ.1 ^ (1/2 - B.h) * epsb B.h γ.1) * y.2.1 +
        sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 / Real.sqrt (Qb γ.1) * y.1 := by
    intro y
