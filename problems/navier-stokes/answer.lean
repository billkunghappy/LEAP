      funext fun Y => hF (ξ.1, ξ.2.1, ξ.2.2.1, Y) (hfib ξ hξ Y)
    rw [e, MeasureTheory.integral_neg, h1, neg_zero]

  have hP := tn_smooth_commute_v5 _ (nrm B (2 * Aex B.h + 1/2) E) hDopen hDsh hf1 hfper
  have hφs : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-(1 + B.h))) (DomC B.h (qsOf l0)) :=
    hqsm.rpow_const_of_ne (fun ξ hξ => (hqpos ξ hξ).ne')
  have hN : ∀ ξ ∈ DomC B.h (qsOf l0), nrm B (Aex B.h) (shInd B (fun ξ => -TN E ξ)) ξ =
      -(qC B.h ξ ^ (-(1 + B.h)) * TN (nrm B (2 * Aex B.h + 1/2) E) ξ) := by
    intro ξ hξ
    have h2 : TN (nrm B (2 * Aex B.h + 1/2) E) ξ = qC B.h ξ ^ (2 * Aex B.h + 1/2) * TN E ξ :=
      (tn_fibre_props_v5 E (fun η => qC B.h η ^ (2 * Aex B.h + 1/2)) ξ).2.1 (fun Y => rfl)
    have hexp : qC B.h ξ ^ (-(1 + B.h)) * qC B.h ξ ^ (2 * Aex B.h + 1/2) = qC B.h ξ ^ (Aex B.h) := by
      rw [← Real.rpow_add (hqpos ξ hξ)]; congr 1; unfold Aex; ring
    show qC B.h ξ ^ (Aex B.h) * shInd B (fun ξ => -TN E ξ) ξ = _
    rw [hF ξ hξ, h2, ← hexp]
    ring
  have hNs : ContDiffOn ℝ ∞ (nrm B (Aex B.h) (shInd B (fun ξ => -TN E ξ))) (DomC B.h (qsOf l0)) :=
    ((hφs.mul hP.1).neg).congr hN
  have hNdeck : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ a, IsDeck B.h (qC B.h ξ) a →
      nrm B (Aex B.h) (shInd B (fun ξ => -TN E ξ)) (shY ξ a) =
        nrm B (Aex B.h) (shInd B (fun ξ => -TN E ξ)) ξ := by
    intro ξ hξ a ha
    have hfs : ContDiff ℝ ∞ (fun Y : ℝ × ℝ => E (ξ.1, ξ.2.1, ξ.2.2.1, Y)) := by
      have hc : ContDiff ℝ ∞ (fun Y : ℝ × ℝ => ((ξ.1, ξ.2.1, ξ.2.2.1, Y) : Cyl)) :=
        contDiff_const.prodMk (contDiff_const.prodMk (contDiff_const.prodMk contDiff_id))
      exact contDiffOn_univ.mp (hEs.comp hc.contDiffOn (fun Y _ => hfib ξ hξ Y))
    have hT : TN E (shY ξ a) = TN E ξ :=
      (tn_fibre_props_v5 E E ξ).2.2 a hfs
        (fun n m Y => hEper (ξ.1, ξ.2.1, ξ.2.2.1, Y) (hfib ξ hξ Y) n m)
        (fun Y => hEdeck (ξ.1, ξ.2.1, ξ.2.2.1, Y) (hfib ξ hξ Y) a ha)
    show qC B.h ξ ^ (Aex B.h) * shInd B (fun ξ => -TN E ξ) (shY ξ a) =
      qC B.h ξ ^ (Aex B.h) * shInd B (fun ξ => -TN E ξ) ξ
    rw [hF _ (hDsh ξ hξ a), hF ξ hξ, hT]
  have hNz : ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) →
      nrm B (Aex B.h) (shInd B (fun ξ => -TN E ξ)) ξ = 0 := by
    intro ξ hξ hX
    have hn : ¬ (B.Xa < XC B.h ξ ∧ XC B.h ξ < B.Xb) := by
      rintro ⟨e1, e2⟩; rcases hX with e | e <;> linarith
    simp only [nrm, shInd, if_neg hn, mul_zero]

  have leibR : ∀ (f1 g1 : Cyl → ℝ), ContDiffOn ℝ ∞ f1 (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ g1 (DomC B.h (qsOf l0)) → ∀ ξ ∈ DomC B.h (qsOf l0), ∀ k : ℕ,
      NB B.h (fun η => f1 η * g1 η) k ξ ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB B.h f1 i ξ * NB B.h g1 (k - i) ξ := by
    intro f1 g1 hf' hg' ξ hξ k
    unfold NB
    generalize Lnorm B.h ξ = L
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' (DomC B.h (qsOf l0)) :=
      ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hDopen.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ DomC B.h (qsOf l0); rw [add_zero]; exact hξ
    have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
    have hsm : ∀ F : Cyl → ℝ, ContDiffOn ℝ ∞ F (DomC B.h (qsOf l0)) →
        ContDiffOn ℝ ∞ (fun z => F (ξ + z)) s := by
      intro F hF'
      exact hF'.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ F : Cyl → ℝ, ContDiffOn ℝ ∞ F (DomC B.h (qsOf l0)) →
        ContDiffOn ℝ ∞ (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
      intro F hF'
      exact (hsm F hF').comp L.contDiff.contDiffOn (fun z hz => hz)
    have key : ∀ F : Cyl → ℝ, ContDiffOn ℝ ∞ F (DomC B.h (qsOf l0)) → ∀ i : ℕ,
        iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
          (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
      intro F hF' i
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF') hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast le_top)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
      calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
              (fun _ => L) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
              (fun _ => L) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
              (fun _ => L) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
    have hfg : ContDiffOn ℝ ∞ (fun η => f1 η * g1 η) (DomC B.h (qsOf l0)) := hf'.mul hg'
    have leib := norm_iteratedFDerivWithin_mul_le (hsmO f1 hf') (hsmO g1 hg') hO.uniqueDiffOn h0O
      (n := k) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => f1 (ξ + L y) * g1 (ξ + L y)) k hO h0O] at leib
    rw [← key _ hfg k]
    calc ‖iteratedFDeriv ℝ k (fun z => (fun η => f1 η * g1 η) (ξ + L z)) 0‖
        = ‖iteratedFDeriv ℝ k (fun y => f1 (ξ + L y) * g1 (ξ + L y)) 0‖ := rfl
      _ ≤ _ := leib
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i _
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f1 (ξ + L z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g1 (ξ + L z)) (k - i) hO h0O,
          key f1 hf' i, key g1 hg' (k - i)]
  choose C6 hC6 using fun j : ℕ => tn_qpow_normalized_v5 B.h hh hh1 hok.1 (-(1 + B.h)) j
  choose C10 b10 d10 hC10 using tn_descent_bound_v5 B hok l0 hl0 α _ hf
  have hTgc : 0 < Tgc := by unfold Tgc; positivity
  have hT1 : InM B (qsOf l0) α (nrm B (Aex B.h) (shInd B (fun ξ => -TN E ξ))) := by
    refine ⟨hNs, hNdeck, hNz, fun k => ?_⟩
    refine ⟨(∑ j ∈ Finset.range (k + 1), (k.choose j : ℝ) * |C6 j| * |C10 (k - j)| *
        (2 ^ 5 * Tgc / Real.log 2 ^ 2)),
      (∑ i ∈ Finset.range (k + 1), |b10 i|) + 1, ∑ i ∈ Finset.range (k + 1), |d10 i|, ?_⟩
    intro ξ hξ hX1 hX2
    have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
    have hq1 : qC B.h ξ ≤ 1 := by linarith [hq256 ξ hξ]
    have hS1 : 1 ≤ SC B.h ξ := by
      unfold SC
      exact one_le_pow₀ (by linarith [abs_nonneg (Real.log (qC B.h ξ))])
    have hS0 : 0 < SC B.h ξ := by linarith
    have hW0 : 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) := by
      unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    have he0 : 0 < edgeDist B.Xa B.Xb (XC B.h ξ) := by
      have hX : 0 < XC B.h ξ := lt_trans hXa hX1
      unfold edgeDist
      exact lt_min one_pos (lt_min (Real.log_pos ((one_lt_div hXa).mpr hX1))
        (Real.log_pos ((one_lt_div hX).mpr hX2)))
    have he1 : edgeDist B.Xa B.Xb (XC B.h ξ) ≤ 1 := min_le_left _ _
    have hK : qC B.h ξ ^ (-(1 + B.h)) * Tgc ^ (-(coarseIdx B.h (qC B.h ξ))) ≤
        2 ^ 5 * Tgc / Real.log 2 ^ 2 * SC B.h ξ := by
      have h9 := L9 _ hq0 (hq256 ξ hξ)
      have hinv : qC B.h ξ ^ (-(1 + B.h)) * qC B.h ξ ^ (1 + B.h) = 1 := by
        rw [← Real.rpow_add hq0]; simp
      have hpos : 0 ≤ qC B.h ξ ^ (-(1 + B.h)) := (Real.rpow_pos_of_pos hq0 _).le
      calc qC B.h ξ ^ (-(1 + B.h)) * Tgc ^ (-(coarseIdx B.h (qC B.h ξ)))
          ≤ qC B.h ξ ^ (-(1 + B.h)) * (2 ^ 5 * Tgc / Real.log 2 ^ 2 * qC B.h ξ ^ (1 + B.h) *
              (1 + |Real.log (qC B.h ξ)|) ^ 2) := mul_le_mul_of_nonneg_left h9 hpos
        _ = 2 ^ 5 * Tgc / Real.log 2 ^ 2 * SC B.h ξ *
              (qC B.h ξ ^ (-(1 + B.h)) * qC B.h ξ ^ (1 + B.h)) := by unfold SC; ring
        _ = _ := by rw [hinv, mul_one]
    have hterm : ∀ j ∈ Finset.range (k + 1),
        (k.choose j : ℝ) * NB B.h (fun η => qC B.h η ^ (-(1 + B.h))) j ξ *
          NB B.h (TN (nrm B (2 * Aex B.h + 1/2) E)) (k - j) ξ ≤
        ((k.choose j : ℝ) * |C6 j| * |C10 (k - j)| * (2 ^ 5 * Tgc / Real.log 2 ^ 2)) *
          (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ ((∑ i ∈ Finset.range (k + 1), |b10 i|) + 1) *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(∑ i ∈ Finset.range (k + 1), |d10 i|))) := by
      intro j hj
      have hkj : k - j ∈ Finset.range (k + 1) := Finset.mem_range.mpr (by omega)
      have a0 := hC10 (k - j) ξ hξ hX1 hX2
      have a1' := hC6 j ξ hξ.2.1 hq1
      set T := Tgc ^ (-(coarseIdx B.h (qC B.h ξ))) with hTdef
      set qa := qC B.h ξ ^ (B.h * α) with hqa
      set qm := qC B.h ξ ^ (-(1 + B.h)) with hqm
      set S := SC B.h ξ with hSdef
      set W := edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) with hWdef
      set e := edgeDist B.Xa B.Xb (XC B.h ξ) with hedef
      set bs := ∑ i ∈ Finset.range (k + 1), |b10 i| with hbs
      set ds := ∑ i ∈ Finset.range (k + 1), |d10 i| with hds
      set K := 2 ^ 5 * Tgc / Real.log 2 ^ 2 with hKdef
      have hT0 : 0 < T := zpow_pos hTgc _
      have hqa0 : 0 < qa := Real.rpow_pos_of_pos hq0 _
      have hqm0 : 0 < qm := Real.rpow_pos_of_pos hq0 _
      have hbi : b10 (k - j) ≤ bs := le_trans (le_abs_self _)
        (Finset.single_le_sum (f := fun i => |b10 i|) (fun i _ => abs_nonneg _) hkj)
      have hdi : d10 (k - j) ≤ ds := le_trans (le_abs_self _)
        (Finset.single_le_sum (f := fun i => |d10 i|) (fun i _ => abs_nonneg _) hkj)
      have hSb : S ^ (b10 (k - j)) ≤ S ^ bs := Real.rpow_le_rpow_of_exponent_le hS1 hbi
      have hSb0 : 0 ≤ S ^ (b10 (k - j)) := Real.rpow_nonneg hS0.le _
      have hed : e ^ (-(d10 (k - j))) ≤ e ^ (-ds) :=
        Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hdi)
      have hed0 : 0 ≤ e ^ (-(d10 (k - j))) := Real.rpow_nonneg he0.le _
      have hSbs0 : 0 ≤ S ^ bs := Real.rpow_nonneg hS0.le _
      have hds0 : 0 ≤ e ^ (-ds) := Real.rpow_nonneg he0.le _
      have a1 : NB B.h (fun η => qC B.h η ^ (-(1 + B.h))) j ξ ≤ |C6 j| * qm :=
        le_trans a1' (mul_le_mul_of_nonneg_right (le_abs_self _) hqm0.le)
      have m1 : T * qa * S ^ (b10 (k - j)) ≤ T * qa * S ^ bs :=
        mul_le_mul_of_nonneg_left hSb (mul_nonneg hT0.le hqa0.le)
      have m2 : T * qa * S ^ (b10 (k - j)) * W ≤ T * qa * S ^ bs * W :=
        mul_le_mul_of_nonneg_right m1 hW0
      have m3 : T * qa * S ^ (b10 (k - j)) * W * e ^ (-(d10 (k - j))) ≤
          T * qa * S ^ bs * W * e ^ (-ds) :=
        mul_le_mul m2 hed hed0 (mul_nonneg (mul_nonneg (mul_nonneg hT0.le hqa0.le) hSbs0) hW0)
      have hpos1 : 0 ≤ T * qa * S ^ (b10 (k - j)) * W * e ^ (-(d10 (k - j))) :=
        mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hT0.le hqa0.le) hSb0) hW0) hed0
      have a2 : NB B.h (TN (nrm B (2 * Aex B.h + 1/2) E)) (k - j) ξ ≤
          |C10 (k - j)| * (T * qa * S ^ bs * W * e ^ (-ds)) := by
        calc _ ≤ C10 (k - j) * T * qa * S ^ (b10 (k - j)) * W * e ^ (-(d10 (k - j))) := a0
          _ = C10 (k - j) * (T * qa * S ^ (b10 (k - j)) * W * e ^ (-(d10 (k - j)))) := by ring
          _ ≤ |C10 (k - j)| * (T * qa * S ^ (b10 (k - j)) * W * e ^ (-(d10 (k - j)))) :=
              mul_le_mul_of_nonneg_right (le_abs_self _) hpos1
          _ ≤ _ := mul_le_mul_of_nonneg_left m3 (abs_nonneg _)
      have hNB0 : 0 ≤ NB B.h (TN (nrm B (2 * Aex B.h + 1/2) E)) (k - j) ξ := by
        unfold NB; exact norm_nonneg _
      have hch : (0:ℝ) ≤ (k.choose j : ℝ) := Nat.cast_nonneg _
      have hSS : S * S ^ bs = S ^ (bs + 1) := by
        rw [Real.rpow_add hS0, Real.rpow_one]; ring
      calc _ ≤ (k.choose j : ℝ) * (|C6 j| * qm) * (|C10 (k - j)| * (T * qa * S ^ bs * W * e ^ (-ds))) :=
            mul_le_mul (mul_le_mul_of_nonneg_left a1 hch) a2 hNB0
              (mul_nonneg hch (mul_nonneg (abs_nonneg _) hqm0.le))
        _ = ((k.choose j : ℝ) * |C6 j| * |C10 (k - j)|) * (qm * T) * (qa * S ^ bs * W * e ^ (-ds)) := by
            ring
        _ ≤ ((k.choose j : ℝ) * |C6 j| * |C10 (k - j)|) * (K * S) * (qa * S ^ bs * W * e ^ (-ds)) := by
            apply mul_le_mul_of_nonneg_right _ (mul_nonneg (mul_nonneg (mul_nonneg hqa0.le hSbs0) hW0) hds0)
            exact mul_le_mul_of_nonneg_left hK (mul_nonneg (mul_nonneg hch (abs_nonneg _)) (abs_nonneg _))
        _ = ((k.choose j : ℝ) * |C6 j| * |C10 (k - j)| * K) * (qa * (S * S ^ bs) * W * e ^ (-ds)) := by
            ring
        _ = _ := by rw [hSS]
    have hev : nrm B (Aex B.h) (shInd B (fun ξ => -TN E ξ)) =ᶠ[nhds ξ]
        fun η => -(qC B.h η ^ (-(1 + B.h)) * TN (nrm B (2 * Aex B.h + 1/2) E) η) :=
      Filter.eventuallyEq_of_mem (hDopen.mem_nhds hξ) hN
    have hNBeq : NB B.h (nrm B (Aex B.h) (shInd B (fun ξ => -TN E ξ))) k ξ =
        NB B.h (fun η => qC B.h η ^ (-(1 + B.h)) * TN (nrm B (2 * Aex B.h + 1/2) E) η) k ξ := by
      unfold NB
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      have e1 : iteratedFDeriv ℝ k
          (fun η => -(qC B.h η ^ (-(1 + B.h)) * TN (nrm B (2 * Aex B.h + 1/2) E) η)) ξ =
          -iteratedFDeriv ℝ k
            (fun η => qC B.h η ^ (-(1 + B.h)) * TN (nrm B (2 * Aex B.h + 1/2) E) η) ξ :=
        iteratedFDeriv_neg_apply
          (f := fun η => qC B.h η ^ (-(1 + B.h)) * TN (nrm B (2 * Aex B.h + 1/2) E) η)
      rw [e1]
      have e2 : ∀ (M : ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) ℝ),
          (-M).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
            -(M.compContinuousLinearMap (fun _ => Lnorm B.h ξ)) := by
        intro M; ext m; simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      rw [e2, norm_neg]
    rw [hNBeq]
    calc _ ≤ ∑ j ∈ Finset.range (k + 1), (k.choose j : ℝ) *
          NB B.h (fun η => qC B.h η ^ (-(1 + B.h))) j ξ *
          NB B.h (TN (nrm B (2 * Aex B.h + 1/2) E)) (k - j) ξ := leibR _ _ hφs hP.1 ξ hξ k
      _ ≤ ∑ j ∈ Finset.range (k + 1),
          ((k.choose j : ℝ) * |C6 j| * |C10 (k - j)| * (2 ^ 5 * Tgc / Real.log 2 ^ 2)) *
          (qC B.h ξ ^ (B.h * α) * SC B.h ξ ^ ((∑ i ∈ Finset.range (k + 1), |b10 i|) + 1) *
            edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ) *
            edgeDist B.Xa B.Xb (XC B.h ξ) ^ (-(∑ i ∈ Finset.range (k + 1), |d10 i|))) :=
          Finset.sum_le_sum hterm
      _ = _ := by rw [← Finset.sum_mul]; ring
  exact ⟨hT1, hT2, hT3⟩

theorem tprim_shInd_eq_v5 : ∀ (B : BG) (qs : ℝ) (g : Cyl → ℝ), B.ok → 0 < qs → qs ≤ 1 →
    ContDiffOn ℝ ∞ g (DomC B.h qs) → ShellSupp B g →
    ∀ ξ ∈ DomC B.h qs, shInd B (Tprim B 1 g) ξ = Tprim B 1 g ξ :=
by
  intro B qs g hok hqs0 hqs1 hgs hsh ξ hξ
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
  have hr : 0 < ξ.1 := hξ'.1
  have hq : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  obtain ⟨_, _, _, hXam1, hm12, hm2Xb, -⟩ := hok.2.1
  unfold shInd
  by_cases hin : B.Xa < XC B.h ξ ∧ XC B.h ξ < B.Xb
  · rw [if_pos hin]
  rw [if_neg hin]
  have hcase : XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ := by
    rcases not_and_or.mp hin with h | h
    · exact Or.inl (not_lt.mp h)
    · exact Or.inr (not_lt.mp h)
  have hXp : ∀ r' : ℝ, XC B.h (pathPt B.h ξ r') = r' ^ 2 / (2 * qC B.h ξ) := fun r' => rfl
  have hXξ : XC B.h ξ = ξ.1 ^ 2 / (2 * qC B.h ξ) := rfl
  have h2q : 0 < 2 * qC B.h ξ := by linarith
  set F : ℝ → ℝ := fun r' => (pathPt B.h ξ r').1 ^ ((1:ℕ):ℝ) * g (pathPt B.h ξ r') with hF
  have hIc : Icut B (fun η : Cyl => η.1 ^ ((1:ℕ):ℝ) * g η) ξ =
      (∫ r' in Set.Ioc (0:ℝ) ξ.1, F r') - chiM B (XC B.h ξ) * ∫ r' in Set.Ioi (0:ℝ), F r' := by
    show (∫ r' in (0:ℝ)..ξ.1, F r') - chiM B (XC B.h ξ) * (∫ r' in Set.Ioi (0:ℝ), F r') = _
    rw [intervalIntegral.integral_of_le hr.le]
  have hI0 : Icut B (fun η : Cyl => η.1 ^ ((1:ℕ):ℝ) * g η) ξ = 0 := by
    rw [hIc]
    rcases hcase with hc | hc
    · have hchi : chiM B (XC B.h ξ) = 0 := by
        unfold chiM
        apply Real.smoothTransition.zero_of_nonpos
        exact div_nonpos_iff.mpr (Or.inr ⟨by linarith, by linarith⟩)
      have h1 : (∫ r' in Set.Ioc (0:ℝ) ξ.1, F r') = 0 := by
        apply MeasureTheory.setIntegral_eq_zero_of_forall_eq_zero
        intro r' hr'
        obtain ⟨h0, hle⟩ := hr'
        have hsq : r' ^ 2 ≤ ξ.1 ^ 2 := pow_le_pow_left₀ h0.le hle 2
        have hX : XC B.h (pathPt B.h ξ r') ≤ B.Xa := by
          rw [hXp]
          calc r' ^ 2 / (2 * qC B.h ξ) ≤ ξ.1 ^ 2 / (2 * qC B.h ξ) :=
                div_le_div_of_nonneg_right hsq h2q.le
            _ = XC B.h ξ := hXξ.symm
            _ ≤ B.Xa := hc
        show (pathPt B.h ξ r').1 ^ ((1:ℕ):ℝ) * g (pathPt B.h ξ r') = 0
        rw [hsh _ (Or.inl hX), mul_zero]
      rw [h1, hchi]
      ring
    · have hchi : chiM B (XC B.h ξ) = 1 := by
        unfold chiM
        apply Real.smoothTransition.one_of_one_le
        rw [le_div_iff₀ (by linarith)]
        linarith
      have h2 : (∫ r' in Set.Ioi (0:ℝ), F r') = ∫ r' in Set.Ioc (0:ℝ) ξ.1, F r' := by
        apply MeasureTheory.setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi
          Set.Ioc_subset_Ioi_self
        intro r' hr'
        obtain ⟨h0, hn⟩ := hr'
        have h0' : (0:ℝ) < r' := h0
        have hlt : ξ.1 < r' := by
          by_contra hh
          exact hn ⟨h0', not_lt.mp hh⟩
        have hsq : ξ.1 ^ 2 ≤ r' ^ 2 := pow_le_pow_left₀ hr.le hlt.le 2
        have hX : B.Xb ≤ XC B.h (pathPt B.h ξ r') := by
          rw [hXp]
          calc B.Xb ≤ XC B.h ξ := hc
            _ = ξ.1 ^ 2 / (2 * qC B.h ξ) := hXξ
            _ ≤ r' ^ 2 / (2 * qC B.h ξ) := div_le_div_of_nonneg_right hsq h2q.le
        show (pathPt B.h ξ r').1 ^ ((1:ℕ):ℝ) * g (pathPt B.h ξ r') = 0
        rw [hsh _ (Or.inr hX), mul_zero]
      rw [h2, hchi]
      ring
  show (0:ℝ) = ξ.1 ^ (-((1:ℕ):ℝ)) * Icut B (fun η : Cyl => η.1 ^ ((1:ℕ):ℝ) * g η) ξ
  rw [hI0, mul_zero]

theorem dR_chiM_XC_v5 : ∀ (B : BG) (ξ : Cyl), B.ok → 0 < ξ.1 → ξ.2.2.1 < 1 →
    dR B.h (fun η => chiM B (XC B.h η)) ξ = deriv (chiM B) (XC B.h ξ) * (ξ.1 / qC B.h ξ) :=
by
  intro B ξ hok hr ht
  have hq : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
  have hq0 : qC B.h ξ ≠ 0 := hq.ne'

  have hS : DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (ξ.2.1, 1 - ξ.2.2.1) := by
    have hmem : ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) :=
      ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    exact (hok.1.2.2.2.1.contDiffAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds hmem)).differentiableAt
      (by simp)
  have hπ : DifferentiableAt ℝ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) ξ := by fun_prop
  have hqd : DifferentiableAt ℝ (qC B.h) ξ := by
    have e : qC B.h = (fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by
      funext η; rfl
    rw [e]
    exact hS.comp ξ hπ
  have hXd : DifferentiableAt ℝ (XC B.h) ξ := by
    have e : XC B.h = fun η : Cyl => η.1 ^ 2 * (2 * qC B.h η)⁻¹ := by
      funext η; exact div_eq_mul_inv _ _
    rw [e]
    have h1 : DifferentiableAt ℝ (fun η : Cyl => η.1 ^ 2) ξ := differentiableAt_fst.pow 2
    have h2 : DifferentiableAt ℝ (fun η : Cyl => 2 * qC B.h η) ξ := hqd.const_mul 2
    have h3 : DifferentiableAt ℝ (fun η : Cyl => (2 * qC B.h η)⁻¹) ξ :=
      h2.inv (mul_ne_zero two_ne_zero hq0)
    exact h1.mul h3

  have hchi : Differentiable ℝ (chiM B) := by
    have e : chiM B = Real.smoothTransition ∘ (fun X : ℝ => (X - B.m1) / (B.m2 - B.m1)) := by
      funext X; rfl
    rw [e]
    exact ((Real.smoothTransition.contDiff (n := 1)).differentiable (by norm_num)).comp
      ((differentiable_id.sub_const _).div_const _)
  obtain ⟨v, hv⟩ : ∃ v : Cyl, v = (1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) := ⟨_, rfl⟩
  have hFd : DifferentiableAt ℝ (fun η => chiM B (XC B.h η)) ξ := (hchi _).comp ξ hXd
  have hγ : HasDerivAt (fun s : ℝ => ξ + s • v) v 0 := by
    simpa using ((hasDerivAt_id (0:ℝ)).smul_const v).const_add ξ
  have h7 : HasDerivAt ((fun η => chiM B (XC B.h η)) ∘ (fun s : ℝ => ξ + s • v))
      (fderiv ℝ (fun η => chiM B (XC B.h η)) ξ v) 0 :=
    HasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) hFd.hasFDerivAt hγ (by simp)
  have h8 : ((fun η => chiM B (XC B.h η)) ∘ (fun s : ℝ => ξ + s • v)) =
      fun s => chiM B ((ξ.1 + s) ^ 2 / (2 * qC B.h ξ)) := by
    funext s
    have e1 : (ξ + s • v).1 = ξ.1 + s := by simp [hv]
    have e2 : (ξ + s • v).2.1 = ξ.2.1 := by simp [hv]
    have e3 : (ξ + s • v).2.2.1 = ξ.2.2.1 := by simp [hv]
    have eq : qC B.h (ξ + s • v) = qC B.h ξ := by
      unfold qC
      rw [e2, e3]
    show chiM B (XC B.h (ξ + s • v)) = _
    unfold XC
    rw [eq, e1]
  have hu : HasDerivAt (fun s : ℝ => (ξ.1 + s) ^ 2 / (2 * qC B.h ξ)) (2 * ξ.1 / (2 * qC B.h ξ)) 0 := by
    have := (((hasDerivAt_id' (x := (0:ℝ))).const_add ξ.1).pow 2).div_const (2 * qC B.h ξ)
    convert this using 1
    simp
  have hc := HasDerivAt.comp_of_eq (0:ℝ) (hchi (XC B.h ξ)).hasDerivAt hu
    (by show XC B.h ξ = (ξ.1 + 0) ^ 2 / (2 * qC B.h ξ); rw [add_zero]; rfl)
  have h9 : HasDerivAt (fun s => chiM B ((ξ.1 + s) ^ 2 / (2 * qC B.h ξ)))
      (deriv (chiM B) (XC B.h ξ) * (ξ.1 / qC B.h ξ)) 0 := by
    have e : deriv (chiM B) (XC B.h ξ) * (2 * ξ.1 / (2 * qC B.h ξ)) =
        deriv (chiM B) (XC B.h ξ) * (ξ.1 / qC B.h ξ) := by
      congr 1
      exact mul_div_mul_left _ _ (two_ne_zero' ℝ)
    rw [e] at hc
    exact hc
  rw [h8] at h7
  have hfin := h7.unique h9
  show fderiv ℝ (fun η => chiM B (XC B.h η)) ξ (1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) = _
  rw [← hv]
  exact hfin

theorem tprim_identity_v5 : ∀ (B : BG) (qs : ℝ) (g : Cyl → ℝ), B.ok → 0 < qs → qs ≤ 1 →
    ContDiffOn ℝ ∞ g (DomC B.h qs) → ShellSupp B g →
    ∀ ξ ∈ DomC B.h qs, dR B.h (shInd B (Tprim B 1 g)) ξ + shInd B (Tprim B 1 g) ξ / ξ.1 = g ξ - Arem B 1 g ξ :=
by
  intro B qs g hok hqs0 hqs1 hgs hsh ξ hξ
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
  have hr : 0 < ξ.1 := hξ'.1
  have hr0 : ξ.1 ≠ 0 := hr.ne'
  obtain ⟨hDopen, hqCs, hqpos, -, -, -⟩ := domc_open_calculus B qs hok
  have hq : 0 < qC B.h ξ := hqpos ξ hξ
  have hq0 : qC B.h ξ ≠ 0 := hq.ne'

  obtain ⟨G, hGdef⟩ : ∃ G : Cyl → ℝ, G = fun η => η.1 ^ (1:ℝ) * g η := ⟨_, rfl⟩
  have hG1 : G = fun η : Cyl => η.1 * g η := by
    funext η
    simp only [hGdef, Real.rpow_one]
  have hGs : ContDiffOn ℝ ∞ G (DomC B.h qs) := by
    rw [hG1]
    exact contDiff_fst.contDiffOn.mul hgs
  have hGsh : ∀ η ∈ DomC B.h qs, (XC B.h η ≤ B.Xa ∨ B.Xb ≤ XC B.h η) → G η = 0 := by
    intro η _ h
    simp only [hGdef, hsh η h, mul_zero]
  have hTp : Tprim B 1 g = fun η : Cyl => η.1 ^ (-(1:ℝ)) * Icut B G η := by
    funext η
    simp only [hGdef, Tprim, Nat.cast_one]
  have PS := path_integral_smooth_v5 B qs G hok hqs0 hqs1 hGs hGsh

  have hΩ : IsOpen {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} := by
    have hc : Continuous (fun ζ : ℝ × ℝ × (ℝ × ℝ) => (((1:ℝ), ζ) : Cyl)) :=
      continuous_const.prodMk continuous_id
    have e : {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} =
        (fun ζ : ℝ × ℝ × (ℝ × ℝ) => (((1:ℝ), ζ) : Cyl)) ⁻¹' DomC B.h qs := by
      ext ζ
      constructor
      · rintro ⟨h1, h2⟩
        exact ⟨one_pos, h1, h2⟩
      · rintro ⟨-, h1, h2⟩
        exact ⟨h1, h2⟩
    rw [e]
    exact hDopen.preimage hc
  have hmem : ((ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) : ℝ × ℝ × (ℝ × ℝ)) ∈
      {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} :=
    ⟨hξ'.2.1, hξ'.2.2⟩
  have hP : DifferentiableAt ℝ (fun ζ : ℝ × ℝ × (ℝ × ℝ) =>
      ∫ r in Set.Ioi (0:ℝ), G (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv))
      (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) :=
    (PS.1.contDiffAt (hΩ.mem_nhds hmem)).differentiableAt (by simp)
  obtain ⟨hQ, hD⟩ := PS.2.2.2.2 (ξ.2.1, ξ.2.2.1, ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) ξ.1
    hξ'.2.1 hξ'.2.2 hr
  have h3 : HasDerivAt (fun p : ℝ => ∫ r in (0:ℝ)..p,
      G (r, ξ.2.1, ξ.2.2.1, (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv)) (G ξ) ξ.1 := by
    have e : G ξ = G (ξ.1, ξ.2.1, ξ.2.2.1, (ξ.2.2.2 - (ξ.1 ^ drx B.h) • vrv) + (ξ.1 ^ drx B.h) • vrv) := by
      rw [sub_add_cancel]
    rw [e]
    exact hD
  have hformula := dR_Icut_formula_v5 B G ξ hok hr hξ'.2.1 hP hQ h3

  have hdec : Icut B G = fun η : Cyl =>
      (fun pζ : ℝ × (ℝ × ℝ × (ℝ × ℝ)) =>
        ∫ r in (0:ℝ)..pζ.1, G (r, pζ.2.1, pζ.2.2.1, pζ.2.2.2 + (r ^ drx B.h) • vrv))
        (η.1, (η.2.1, η.2.2.1, η.2.2.2 - (η.1 ^ drx B.h) • vrv))
      - chiM B (XC B.h η) *
        (fun ζ : ℝ × ℝ × (ℝ × ℝ) => ∫ r in Set.Ioi (0:ℝ), G (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv))
          (η.2.1, η.2.2.1, η.2.2.2 - (η.1 ^ drx B.h) • vrv) := by
    funext η
    have hpath : ∀ r : ℝ, pathPt B.h η r =
        (r, η.2.1, η.2.2.1, (η.2.2.2 - (η.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv) := by
      intro r
      have e : η.2.2.2 + (r ^ drx B.h - η.1 ^ drx B.h) • vrv =
          (η.2.2.2 - (η.1 ^ drx B.h) • vrv) + (r ^ drx B.h) • vrv := by
        rw [sub_smul]
        abel
      simp only [pathPt, e]
    show (∫ r' in (0:ℝ)..η.1, G (pathPt B.h η r')) -
        chiM B (XC B.h η) * (∫ r' in Set.Ioi (0:ℝ), G (pathPt B.h η r')) = _
    simp only [hpath]
  have hπ : DifferentiableAt ℝ (fun η : Cyl =>
      ((η.2.1, η.2.2.1, η.2.2.2 - (η.1 ^ drx B.h) • vrv) : ℝ × ℝ × (ℝ × ℝ))) ξ := by
    have h1 : DifferentiableAt ℝ (fun η : Cyl => η.1 ^ drx B.h) ξ :=
      DifferentiableAt.rpow_const differentiableAt_fst (Or.inl hr0)
    have h2 : DifferentiableAt ℝ (fun η : Cyl => η.2.1) ξ := differentiableAt_snd.fst
    have h3 : DifferentiableAt ℝ (fun η : Cyl => η.2.2.1) ξ := differentiableAt_snd.snd.fst
    have h4 : DifferentiableAt ℝ (fun η : Cyl => η.2.2.2) ξ := differentiableAt_snd.snd.snd
    exact h2.prodMk (h3.prodMk (h4.sub (h1.smul_const vrv)))
  have hσ : DifferentiableAt ℝ (fun η : Cyl =>
      ((η.1, (η.2.1, η.2.2.1, η.2.2.2 - (η.1 ^ drx B.h) • vrv)) : ℝ × (ℝ × ℝ × (ℝ × ℝ)))) ξ :=
    differentiableAt_fst.prodMk hπ
  have hqd : DifferentiableAt ℝ (qC B.h) ξ :=
    (hqCs.contDiffAt (hDopen.mem_nhds hξ)).differentiableAt (by simp)
  have hXd : DifferentiableAt ℝ (XC B.h) ξ := by
    have e : XC B.h = fun η : Cyl => η.1 ^ 2 * (2 * qC B.h η)⁻¹ := by
      funext η; exact div_eq_mul_inv _ _
    rw [e]
    have h1 : DifferentiableAt ℝ (fun η : Cyl => η.1 ^ 2) ξ := differentiableAt_fst.pow 2
    have h2 : DifferentiableAt ℝ (fun η : Cyl => 2 * qC B.h η) ξ := hqd.const_mul 2
    have h3 : DifferentiableAt ℝ (fun η : Cyl => (2 * qC B.h η)⁻¹) ξ :=
      h2.inv (mul_ne_zero two_ne_zero hq0)
    exact h1.mul h3
  have hchi : Differentiable ℝ (chiM B) := by
    have e : chiM B = Real.smoothTransition ∘ (fun X : ℝ => (X - B.m1) / (B.m2 - B.m1)) := by
      funext X; rfl
    rw [e]
    exact ((Real.smoothTransition.contDiff (n := 1)).differentiable (by norm_num)).comp
      ((differentiable_id.sub_const _).div_const _)
  have hIcd : DifferentiableAt ℝ (Icut B G) ξ := by
    rw [hdec]
    exact (hQ.comp ξ hσ).sub (((hchi _).comp ξ hXd).mul (hP.comp ξ hπ))

  have hcF : HasFDerivAt (fun η : Cyl => η.1 ^ (-(1:ℝ)))
      (((-(1:ℝ)) * ξ.1 ^ (-(1:ℝ) - 1)) • ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) ξ :=
    (Real.hasDerivAt_rpow_const (Or.inl hr0)).comp_hasFDerivAt ξ hasFDerivAt_fst
  have hprod : dR B.h (fun η : Cyl => η.1 ^ (-(1:ℝ)) * Icut B G η) ξ =
      ξ.1 ^ (-(1:ℝ)) * dR B.h (Icut B G) ξ + Icut B G ξ * ((-(1:ℝ)) * ξ.1 ^ (-(1:ℝ) - 1)) := by
    have hm : HasFDerivAt (fun η : Cyl => η.1 ^ (-(1:ℝ)) * Icut B G η)
        (ξ.1 ^ (-(1:ℝ)) • fderiv ℝ (Icut B G) ξ +
          Icut B G ξ • ((-(1:ℝ)) * ξ.1 ^ (-(1:ℝ) - 1)) • ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) ξ :=
      hcF.mul hIcd.hasFDerivAt
    unfold dR
    rw [hm.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_fst', smul_eq_mul]
    ring

  have hs1 := tprim_shInd_eq_v5 B qs g hok hqs0 hqs1 hgs hsh
  have hev : shInd B (Tprim B 1 g) =ᶠ[nhds ξ] Tprim B 1 g :=
    Filter.eventuallyEq_of_mem (hDopen.mem_nhds hξ) hs1
  have hdR1 : dR B.h (shInd B (Tprim B 1 g)) ξ = dR B.h (Tprim B 1 g) ξ := by
    unfold dR
    rw [hev.fderiv_eq]

  have hJ : (∫ r in Set.Ioi (0:ℝ), G (pathPt B.h ξ r)) =
      ∫ r' in Set.Ioi (0:ℝ), r' ^ (1:ℝ) * g (pathPt B.h ξ r') := by
    simp only [hGdef, pathPt]
  have hArem : Arem B 1 g ξ = ξ.1 ^ (-(1:ℝ)) * (deriv (chiM B) (XC B.h ξ) * (ξ.1 / qC B.h ξ)) *
      ∫ r in Set.Ioi (0:ℝ), G (pathPt B.h ξ r) := by
    rw [hJ]
    simp only [Arem, Nat.cast_one]
    rw [dR_chiM_XC_v5 B ξ hok hr hξ'.2.1]
  have hGξ : G ξ = ξ.1 * g ξ := by
    rw [hG1]
  rw [hdR1, hs1 ξ hξ, hTp]
  beta_reduce
  rw [hprod, hformula, hArem, hGξ, Real.rpow_sub_one hr0, Real.rpow_neg_one]
  first
    | (field_simp; ring)
    | field_simp

theorem inM_qpow_rpow_mul_v5 : ∀ (B : BG) (qs : ℝ), B.ok → SimNorm B.h → 0 < qs → qs ≤ 1 →
    ∀ (c e α : ℝ) (f : Cyl → ℝ), InM B qs α f →
    InM B qs (α + (c + e / 2) / B.h) (fun η => qC B.h η ^ c * η.1 ^ e * f η) :=
by
  intro B qs hok hSN hqs0 hqs1 c e α f hf
  have hS : SimScaleProps B.h := hok.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1

  have key : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (F : E → G) (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  have hU : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
  have hqCU : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqposU : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hDsub : DomC B.h qs ⊆ {η : Cyl | η.2.2.1 < 1} := fun η hη => hη.2.1
  have hDo : IsOpen (DomC B.h qs) := by
    have h1 : IsOpen ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Set.Iio qs) :=
      hqCU.continuousOn.isOpen_inter_preimage hU isOpen_Iio
    have h2 : IsOpen {η : Cyl | 0 < η.1} := isOpen_lt continuous_const continuous_fst
    have e : DomC B.h qs =
        {η : Cyl | 0 < η.1} ∩ ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Set.Iio qs) := by
      ext η
      simp only [DomC, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iio]
    rw [e]; exact h2.inter h1
  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) (DomC B.h qs) := hqCU.mono hDsub
  have hqpos : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ := fun ξ hξ => hqposU ξ (hDsub hξ)

  have hmul : ∀ (U : Set Cyl) (f g : Cyl → ℝ), IsOpen U → ContDiffOn ℝ ∞ f U →
      ContDiffOn ℝ ∞ g U → ∀ ξ ∈ U, ∀ k : ℕ,
        NB B.h (fun η => f η * g η) k ξ ≤
          ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB B.h f i ξ * NB B.h g (k - i) ξ := by
    intro U f g hU' hf hg ξ hξ k
    have hfg : ContDiffOn ℝ ∞ (fun η => f η * g η) U := hf.mul hg
    have kf := key f U ξ (Lnorm B.h ξ) hU' hf hξ
    have kg := key g U ξ (Lnorm B.h ξ) hU' hg hξ
    have kfg := key (fun η => f η * g η) U ξ (Lnorm B.h ξ) hU' hfg hξ k
    unfold NB
    obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = (fun v => ξ + Lnorm B.h ξ v) ⁻¹' U := ⟨_, rfl⟩
    have hO : IsOpen O := by
      rw [hOdef]; exact hU'.preimage (continuous_const.add (Lnorm B.h ξ).continuous)
    have h0O : (0 : Cyl) ∈ O := by
      rw [hOdef]; show ξ + Lnorm B.h ξ 0 ∈ U; rw [map_zero, add_zero]; exact hξ
    have hsmO : ∀ F : Cyl → ℝ, ContDiffOn ℝ ∞ F U →
        ContDiffOn ℝ ∞ (fun z => F (ξ + Lnorm B.h ξ z)) O := by
      intro F hF
      exact hF.comp (contDiff_const.add (Lnorm B.h ξ).contDiff).contDiffOn
        (fun z hz => by rw [hOdef] at hz; exact hz)
    have leib := norm_iteratedFDerivWithin_mul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
      (n := k) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen
      (f := fun y => f (ξ + Lnorm B.h ξ y) * g (ξ + Lnorm B.h ξ y)) k hO h0O] at leib
    rw [← kfg]
    calc ‖iteratedFDeriv ℝ k (fun z => (fun η => f η * g η) (ξ + Lnorm B.h ξ z)) 0‖
        = ‖iteratedFDeriv ℝ k (fun y => f (ξ + Lnorm B.h ξ y) * g (ξ + Lnorm B.h ξ y)) 0‖ := rfl
      _ ≤ _ := leib
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i _
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + Lnorm B.h ξ z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + Lnorm B.h ξ z)) (k - i) hO h0O,
          kf i, kg (k - i)]

  have hqpow : ∀ (c : ℝ) (j : ℕ), ∃ C : ℝ, ∀ ξ ∈ DomC B.h qs,
      NB B.h (fun η => qC B.h η ^ c) j ξ ≤ C * qC B.h ξ ^ c := by
    intro c j
    have hN := hSN
    unfold SimNorm at hN
    choose C hC using hN
    obtain ⟨A, hAdef⟩ : ∃ A : ℝ,
        A = ∑ i ∈ Finset.range (j + 1), |Polynomial.eval c (descPochhammer ℝ i)| := ⟨_, rfl⟩
    obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = 1 + ∑ i ∈ Finset.range (j + 1), |C i| := ⟨_, rfl⟩
    have hD1 : 1 ≤ D := by
      have := Finset.sum_nonneg (fun k (_ : k ∈ Finset.range (j + 1)) => abs_nonneg (C k))
      rw [hDdef]; linarith
    refine ⟨(j.factorial : ℝ) * A * D ^ j, ?_⟩
    intro ξ hξD
    have hξD' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξD
    have hξ : ξ.2.2.1 < 1 := hξD'.2.1
    have hq1 : qC B.h ξ ≤ 1 := le_trans hξD'.2.2.le hqs1
    have hq0 : 0 < qC B.h ξ := hqposU ξ hξ
    obtain ⟨F, hFdef⟩ : ∃ F : Cyl → ℝ, F = fun η : Cyl => qC B.h η ^ c := ⟨_, rfl⟩
    obtain ⟨a, hadef⟩ : ∃ a : ℝ, a = qC B.h ξ ^ c := ⟨_, rfl⟩
    suffices hmain : NB B.h F j ξ ≤ (j.factorial : ℝ) * A * D ^ j * a by
      rw [hFdef, hadef] at hmain; exact hmain
    have ha0 : 0 ≤ a := by rw [hadef]; exact Real.rpow_nonneg hq0.le _
    have hFU : ContDiffOn ℝ ∞ F {η : Cyl | η.2.2.1 < 1} := by
      rw [hFdef]
      exact hqCU.rpow_const_of_ne (fun η hη => (hqposU η hη).ne')
    obtain ⟨Pm, hPmdef⟩ : ∃ Pm : Cyl →L[ℝ] ℝ × ℝ,
        Pm = ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))).prod
          (-((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
            (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))))) := ⟨_, rfl⟩
    have hPapp : ∀ η : Cyl, Pm η = (η.2.1, -η.2.2.1) := by
      intro η; rw [hPmdef]; simp
    have hP1 : ‖Pm‖ ≤ 1 := by
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
      rw [hPapp η, one_mul, Prod.norm_def (η.2.1, -η.2.2.1)]
      refine max_le ?_ ?_
      · exact (norm_fst_le η.2).trans (norm_snd_le η)
      · exact (norm_neg η.2.2.1).trans_le
          (((norm_fst_le η.2.2).trans (norm_snd_le η.2)).trans (norm_snd_le η))
    obtain ⟨Mq, hMqdef⟩ : ∃ Mq : ℝ × ℝ →L[ℝ] ℝ × ℝ,
        Mq = (qC B.h ξ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
          (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ) := ⟨_, rfl⟩
    obtain ⟨T, hTdef⟩ : ∃ T : Cyl →L[ℝ] ℝ × ℝ, T = Mq.comp Pm := ⟨_, rfl⟩
    obtain ⟨w0, hw0def⟩ : ∃ w0 : ℝ × ℝ, w0 = (ξ.2.1, 1 - ξ.2.2.1) := ⟨_, rfl⟩
    have hW : IsOpen (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
    have hw0 : w0 ∈ (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := by
      rw [hw0def]; exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hid : ∀ v : Cyl, qC B.h (ξ + Lnorm B.h ξ v) = simScale B.h (w0 + T v).1 (w0 + T v).2 := by
      intro v
      have e1 : (Lnorm B.h ξ v).2.1 = qC B.h ξ ^ (1/2 - B.h) * v.2.1 := by
        simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have e2 : (Lnorm B.h ξ v).2.2.1 = qC B.h ξ * v.2.2.1 := by
        simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      have e3 : T v = (qC B.h ξ ^ (1/2 - B.h) * v.2.1, qC B.h ξ * (-v.2.2.1)) := by
        rw [hTdef, ContinuousLinearMap.comp_apply, hPapp v, hMqdef]
        simp [ContinuousLinearMap.coe_prodMap']
      rw [e3, hw0def]
      show simScale B.h (ξ.2.1 + (Lnorm B.h ξ v).2.1) (1 - (ξ.2.2.1 + (Lnorm B.h ξ v).2.2.1)) =
        simScale B.h (ξ.2.1 + qC B.h ξ ^ (1/2 - B.h) * v.2.1) ((1 - ξ.2.2.1) + qC B.h ξ * (-v.2.2.1))
      rw [e1, e2]
      congr 1
      ring
    obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = {v : Cyl | (ξ + Lnorm B.h ξ v).2.2.1 < 1} := ⟨_, rfl⟩
    have hOmem : ∀ v, v ∈ O ↔ (ξ + Lnorm B.h ξ v).2.2.1 < 1 := by
      intro v; rw [hOdef]; rfl
    have hcontO : Continuous (fun v : Cyl => (ξ + Lnorm B.h ξ v).2.2.1) :=
      ((continuous_const.add (Lnorm B.h ξ).continuous).snd.snd.fst)
    have hO : IsOpen O := by rw [hOdef]; exact isOpen_lt hcontO continuous_const
    have h0O : (0 : Cyl) ∈ O := by
      rw [hOmem, map_zero, add_zero]; exact hξ
    obtain ⟨ψ, hψdef⟩ : ∃ ψ : Cyl → ℝ, ψ = fun v => qC B.h (ξ + Lnorm B.h ξ v) / qC B.h ξ :=
      ⟨_, rfl⟩
    have hψ : ContDiffOn ℝ ∞ ψ O := by
      rw [hψdef]
      exact (hqCU.comp (contDiff_const.add (Lnorm B.h ξ).contDiff).contDiffOn
        (fun v hv => (hOmem v).1 hv)).div_const _
    have hψpos : ∀ v ∈ O, 0 < ψ v := by
      intro v hv; rw [hψdef]; exact div_pos (hqposU _ ((hOmem v).1 hv)) hq0
    have hψ0 : ψ 0 = 1 := by
      rw [hψdef]
      show qC B.h (ξ + Lnorm B.h ξ 0) / qC B.h ξ = 1
      rw [map_zero, add_zero]; exact div_self hq0.ne'
    have hψeq : ψ = (qC B.h ξ)⁻¹ • (fun z : Cyl => simScale B.h (w0 + T z).1 (w0 + T z).2) := by
      rw [hψdef]; funext v
      show qC B.h (ξ + Lnorm B.h ξ v) / qC B.h ξ =
        (qC B.h ξ)⁻¹ * simScale B.h (w0 + T v).1 (w0 + T v).2
      rw [hid v, div_eq_inv_mul]
    have hΦ : ContDiffAt ℝ ∞ (fun z : Cyl => simScale B.h (w0 + T z).1 (w0 + T z).2) 0 := by
      have h1 : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (w0 + T 0) := by
        rw [map_zero, add_zero]; exact hS.2.2.2.1.contDiffAt (hW.mem_nhds hw0)
      exact ContDiffAt.comp (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2) (f := fun z : Cyl => w0 + T z)
        (0 : Cyl) h1 (contDiff_const.add T.contDiff).contDiffAt
    have hDψ : ∀ i : ℕ, 1 ≤ i → i ≤ j → ‖iteratedFDerivWithin ℝ i ψ O 0‖ ≤ D ^ i := by
      intro i hi1 hij
      have hcomp : (iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq.comp Pm) =
          ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
            (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm) := by
        ext m; rfl
      have hCi : ‖(iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)‖ ≤ C i * qC B.h ξ := by
        rw [hMqdef, hw0def]; exact hC i ξ.2.1 (1 - ξ.2.2.1) (by linarith) hq1
      have hprod : ∏ k : Fin i, ‖Pm‖ ≤ 1 := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        exact pow_le_one₀ (norm_nonneg _) hP1
      have hb1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
        ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)) (fun _ : Fin i => Pm)
      have hb2 := hb1.trans ((mul_le_of_le_one_right (norm_nonneg _) hprod).trans hCi)
      have hCiD : C i ≤ D := by
        have h2 : |C i| ≤ ∑ k ∈ Finset.range (j + 1), |C k| :=
          Finset.single_le_sum (f := fun k => |C k|) (fun k _ => abs_nonneg _)
            (Finset.mem_range.mpr (Nat.lt_succ_of_le hij))
        have h3 := le_abs_self (C i)
        rw [hDdef]; linarith
      rw [iteratedFDerivWithin_of_isOpen i hO h0O, hψeq,
        iteratedFDeriv_const_smul_apply (hΦ.of_le (by exact_mod_cast le_top)),
        key (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) w0 T hW hS.2.2.2.1 hw0 i,
        norm_smul, hTdef, hcomp, Real.norm_of_nonneg (inv_nonneg.mpr hq0.le)]
      calc (qC B.h ξ)⁻¹ * ‖((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
            (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm)‖
          ≤ (qC B.h ξ)⁻¹ * (C i * qC B.h ξ) :=
            mul_le_mul_of_nonneg_left hb2 (inv_nonneg.mpr hq0.le)
        _ = C i := by rw [mul_comm (C i), ← mul_assoc, inv_mul_cancel₀ hq0.ne', one_mul]
        _ ≤ D := hCiD
        _ ≤ D ^ i := le_self_pow₀ hD1 (by omega)
    have hg : ContDiffOn ℝ ∞ (fun x : ℝ => x ^ c) (Set.Ioi 0) :=
      (contDiffOn_id (s := Set.Ioi (0:ℝ))).rpow_const_of_ne (fun x hx => ne_of_gt hx)
    have hψmaps : Set.MapsTo ψ O (Set.Ioi 0) := fun v hv => hψpos v hv
    have hCg : ∀ i ≤ j, ‖iteratedFDerivWithin ℝ i (fun x : ℝ => x ^ c) (Set.Ioi 0) (ψ 0)‖ ≤ A := by
      intro i hi
      rw [hψ0, iteratedFDerivWithin_of_isOpen i isOpen_Ioi (Set.mem_Ioi.mpr (zero_lt_one' ℝ)),
        norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
        Real.iter_deriv_rpow_const, Real.one_rpow, mul_one, Real.norm_eq_abs, hAdef]
      exact Finset.single_le_sum (f := fun i => |Polynomial.eval c (descPochhammer ℝ i)|)
        (fun i _ => abs_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    have hFdB := norm_iteratedFDerivWithin_comp_le hg hψ (by exact_mod_cast le_top)
      isOpen_Ioi.uniqueDiffOn hO.uniqueDiffOn hψmaps h0O (C := A) (D := D) hCg hDψ
    obtain ⟨gl, hgldef⟩ : ∃ gl : ℝ →L[ℝ] ℝ, gl = a • ContinuousLinearMap.id ℝ ℝ := ⟨_, rfl⟩
    have hgl : ‖gl‖ ≤ a := ContinuousLinearMap.opNorm_le_bound _ ha0 (fun x => le_of_eq (by
      rw [hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, norm_smul,
        Real.norm_of_nonneg ha0]))
    have hEq : Set.EqOn (fun z => F (ξ + Lnorm B.h ξ z)) (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O := by
      intro z hz
      have hψz := hψpos z hz
      have e : qC B.h (ξ + Lnorm B.h ξ z) = qC B.h ξ * ψ z := by
        rw [hψdef]
        show _ = qC B.h ξ * (qC B.h (ξ + Lnorm B.h ξ z) / qC B.h ξ)
        field_simp
      show F (ξ + Lnorm B.h ξ z) = gl (ψ z ^ c)
      rw [hFdef, hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, smul_eq_mul]
      show qC B.h (ξ + Lnorm B.h ξ z) ^ c = a * ψ z ^ c
      rw [e, Real.mul_rpow hq0.le hψz.le, ← hadef]
    have hgψ : ContDiffOn ℝ ∞ ((fun x : ℝ => x ^ c) ∘ ψ) O := hg.comp hψ hψmaps
    have hNB : NB B.h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := by
      unfold NB
      rw [key F {η : Cyl | η.2.2.1 < 1} ξ (Lnorm B.h ξ) hU hFU hξ j]
    calc NB B.h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := hNB
      _ = ‖iteratedFDerivWithin ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) O 0‖ := by
          rw [iteratedFDerivWithin_of_isOpen j hO h0O]
      _ = ‖iteratedFDerivWithin ℝ j (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O 0‖ := by
          rw [iteratedFDerivWithin_congr hEq h0O j]
      _ = ‖gl.compContinuousMultilinearMap
            (iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0)‖ := by
          rw [ContinuousLinearMap.iteratedFDerivWithin_comp_left gl (hgψ.contDiffWithinAt h0O)
            hO.uniqueDiffOn h0O (i := j) (by exact_mod_cast le_top)]
      _ ≤ ‖gl‖ * ‖iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ a * ((j.factorial : ℝ) * A * D ^ j) := mul_le_mul hgl hFdB (norm_nonneg _) ha0
      _ = (j.factorial : ℝ) * A * D ^ j * a := by ring

  have hprof : ∀ (φ : ℝ → ℝ) (c : ℝ), ContDiffOn ℝ ∞ φ (Set.Ioi 0) →
      ContDiffOn ℝ ∞ (fun η => qC B.h η ^ c * φ (XC B.h η)) (DomC B.h qs) ∧
      ∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h qs, B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
        NB B.h (fun η => qC B.h η ^ c * φ (XC B.h η)) k ξ ≤ C * qC B.h ξ ^ c := by
    intro φ c hφ
    have hf0 : ContDiff ℝ ∞ (fun η : Cyl => η.1 ^ 2 / 2) := (contDiff_fst.pow 2).div_const 2
    have hqm1 : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-1:ℝ)) (DomC B.h qs) :=
      hqC.rpow_const_of_ne (fun x hx => (hqpos x hx).ne')
    have hXCdef : XC B.h = fun η => η.1 ^ 2 / 2 * qC B.h η ^ (-1:ℝ) := by
      funext η
      show η.1 ^ 2 / (2 * qC B.h η) = η.1 ^ 2 / 2 * qC B.h η ^ (-1:ℝ)
      rw [Real.rpow_neg_one]
      ring
    have hXCs : ContDiffOn ℝ ∞ (XC B.h) (DomC B.h qs) := by
      rw [hXCdef]; exact hf0.contDiffOn.mul hqm1
    have hXCpos : ∀ η ∈ DomC B.h qs, 0 < XC B.h η := by
      intro η hη
      have hη' : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < qs := hη
      exact div_pos (pow_pos hη'.1 2) (by linarith [hqpos η hη])
    have hqcs : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ c) (DomC B.h qs) :=
      hqC.rpow_const_of_ne (fun x hx => (hqpos x hx).ne')
    have hgs : ContDiffOn ℝ ∞ (fun η => φ (XC B.h η)) (DomC B.h qs) :=
      hφ.comp hXCs (fun η hη => hXCpos η hη)

    have hfsq : ∀ ξ : Cyl, 0 < qC B.h ξ → ∀ a : ℕ,
        NB B.h (fun η : Cyl => η.1 ^ 2 / 2) a ξ ≤ ξ.1 ^ 2 + qC B.h ξ := by
      intro ξ hq a
      obtain ⟨q, hqd⟩ : ∃ q : ℝ, q = qC B.h ξ := ⟨_, rfl⟩
      obtain ⟨s, hsd⟩ : ∃ s : ℝ, s = Real.sqrt q := ⟨_, rfl⟩
      have hq' : 0 < q := by rw [hqd]; exact hq
      have hs2 : s ^ 2 = q := by rw [hsd]; exact Real.sq_sqrt hq'.le
      obtain ⟨p, hpdef⟩ : ∃ p : ℝ → ℝ, p = fun x => ξ.1 ^ 2 / 2 + ξ.1 * s * x + q / 2 * (x * x) :=
        ⟨_, rfl⟩
      have hp : ContDiff ℝ ∞ p := by
        rw [hpdef]
        exact (contDiff_const.add (contDiff_const.mul contDiff_id)).add
          (contDiff_const.mul (contDiff_id.mul contDiff_id))
