        ∫ v in (y5 + 1)..z, Real.exp (3 / 2 * v) * E v := by
      have h := intervalIntegral.integral_mono_on (show y5 + 1 ≤ z by linarith)
        (continuous_const.intervalIntegrable _ _) (hii _ _) (fun v hv => hwin v hv.1 hv.2)
      rw [intervalIntegral.integral_const, smul_eq_mul] at h
      exact h
    have h12 : 12 * (Real.exp (3 / 2 * z) * E z) ≤ (z - (y5 + 1)) * (Real.exp (3 / 2 * z) * E z) :=
      mul_le_mul_of_nonneg_right (by linarith) (hΦpos z).le
    have h4 : (1 + lam / 4) * (Real.exp (3 / 2 * y) * E y) ≤ 4 * (Real.exp (3 / 2 * y) * E y) :=
      mul_le_mul_of_nonneg_right (by linarith) (hΦpos y).le
    linarith

theorem rfp_ext_regionA : rfpPref (fun P => ∀ x η : ℝ, rfpXv P ≤ x → x ≤ Real.exp (rfpY6 P) → -1 ≤ η → η ≤ 1 → 2 < shearA (rfpF P) x η ∧ 0 < rfpExtQ P x η ∧ (shearA (rfpF P) x η - 2) * (rfpExtN P x η / (Real.sqrt (2 * x) * rfpF P x η * rfpExtQ P x η)) ^ 2 ≤ 1) :=
