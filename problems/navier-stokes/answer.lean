    have hN : 0 ≤ |p0| * |a - b| := by positivity
    nlinarith
  rw [hid]
  calc |(p - p0) / a + p0 * (b - a) / (a * b)|
      ≤ |(p - p0) / a| + |p0 * (b - a) / (a * b)| := abs_add_le _ _
    _ ≤ 5 * |p - p0| + 18 * |p0| * |a - b| := by linarith

