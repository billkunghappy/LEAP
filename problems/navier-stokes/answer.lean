      filter_upwards [self_mem_nhdsWithin] with y hy
      exact ((((hW23ev y hy).iteratedFDeriv ℝ k).eq_of_nhds).trans (hz0 k y)).symm
    refine (h1.sup h2').mono_left ?_
    rw [← nhdsWithin_union]
    exact nhdsWithin_mono x hsub

  have hVU : V ⊆ DomC B.h (qsOf l0) := by
    intro η hη
    rw [hVdef] at hη
    exact hη.1
  obtain ⟨hsmU, hjet⟩ := flat_zero_extension_cyl (DomC B.h (qsOf l0)) V (W0c4 B G γ) hUo hVo hVU
    hsmV (fun x hx hxV => (hUV x hx hxV).1) hlim
  refine ⟨hsmU, fun ξ hξ he k => ?_⟩
  by_cases hξV : ξ ∈ V
  · have hξV' := hξV
    rw [hVdef] at hξV'
    obtain ⟨-, h⟩ := hξV'
    rcases h with ⟨hne, -, -⟩ | h
    · exact absurd he hne
    · have hξW : ξ ∈ W23 := by rw [hWdef]; exact ⟨hξ, h⟩
      rw [((hW23ev ξ hξW).iteratedFDeriv ℝ k).eq_of_nhds]
      exact hz0 k ξ
  · exact hjet ξ hξ hξV k

theorem prim_amplitude_class_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (lN : ℕ) (c : ℝ), 0 < c →
    PrimNondegAt4 B G lN c → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → InWg5 B G (qsOf l0) (1/2) (W0h4 B G) ∧
    (∀ (γ : Lab), ∀ ξ ∈ DomC B.h (qsOf l0), dotProduct (nPhi5 B G γ ξ) (W0c4 B G γ ξ) = 0) :=
by
  intro B G hok hG lN c hc hND
  have hS := hok.1
  have hh : 0 < B.h := hok.2.1.1
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  obtain ⟨-, -, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  have hP2 := And.intro (pulse_profile_smooth_v5 B G hok hG) (pulse_profile_bound_v5 B G hok hG)
  obtain ⟨lP, hPb⟩ := hP2.2
  obtain ⟨hEsm, -, -, hEb⟩ := etaL_class_v5 B hok
