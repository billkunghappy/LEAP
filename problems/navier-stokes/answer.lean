  have hNa : ‖(2 * ↑Real.pi * Complex.I * ((m.1 : ℂ) * ((((1:ℝ), (0:ℝ)) : ℝ × ℝ).1 : ℂ) +
      (m.2 : ℂ) * ((((1:ℝ), (0:ℝ)) : ℝ × ℝ).2 : ℂ)))‖ = 2 * Real.pi * |(m.1:ℝ)| := by
    rw [hN]; simp
  have hNb : ‖(2 * ↑Real.pi * Complex.I * ((m.1 : ℂ) * ((((0:ℝ), (1:ℝ)) : ℝ × ℝ).1 : ℂ) +
      (m.2 : ℂ) * ((((0:ℝ), (1:ℝ)) : ℝ × ℝ).2 : ℂ)))‖ = 2 * Real.pi * |(m.2:ℝ)| := by
    rw [hN]; simp

  have arith : ∀ (X x y c : ℝ), 0 ≤ X → 0 ≤ x → 0 ≤ y → 1 ≤ c → X ≤ M → (c * x) ^ P * X ≤ M →
      (c * y) ^ P * X ≤ M → (c * x) ^ P * ((c * y) ^ P * X) ≤ M →
      X ≤ 4 ^ P * M / ((1 + x) ^ P * (1 + y) ^ P) := by
    intro X x y c hX hx hy hc h00 h10 h01 h11
    have hxy : 0 < (1 + x) ^ P * (1 + y) ^ P := by positivity
    rw [le_div_iff₀ hxy]
    have hA : ∃ A : ℝ, 0 ≤ A ∧ 1 + x ≤ 2 * A ∧ (A = 1 ∨ A = c * x) := by
      have hcx : x ≤ c * x := le_mul_of_one_le_left hx hc
      by_cases h : 1 ≤ c * x
      · exact ⟨c * x, by linarith, by linarith, Or.inr rfl⟩
      · exact ⟨1, zero_le_one, by linarith, Or.inl rfl⟩
    have hB : ∃ B : ℝ, 0 ≤ B ∧ 1 + y ≤ 2 * B ∧ (B = 1 ∨ B = c * y) := by
      have hcy : y ≤ c * y := le_mul_of_one_le_left hy hc
      by_cases h : 1 ≤ c * y
      · exact ⟨c * y, by linarith, by linarith, Or.inr rfl⟩
      · exact ⟨1, zero_le_one, by linarith, Or.inl rfl⟩
    obtain ⟨A, hA0, hA1, hA2⟩ := hA
    obtain ⟨B, hB0, hB1, hB2⟩ := hB
    have hAB : A ^ P * (B ^ P * X) ≤ M := by
      rcases hA2 with rfl | rfl <;> rcases hB2 with rfl | rfl
      · simpa using h00
      · simpa using h01
      · simpa using h10
      · exact h11
    have e1 : (1 + x) ^ P ≤ 2 ^ P * A ^ P := by
      rw [← mul_pow]; exact pow_le_pow_left₀ (by linarith) hA1 P
    have e2 : (1 + y) ^ P ≤ 2 ^ P * B ^ P := by
      rw [← mul_pow]; exact pow_le_pow_left₀ (by linarith) hB1 P
    have h4 : (4:ℝ) ^ P = 2 ^ P * 2 ^ P := by rw [← mul_pow]; norm_num
    calc X * ((1 + x) ^ P * (1 + y) ^ P) ≤ X * ((2 ^ P * A ^ P) * (2 ^ P * B ^ P)) := by
          apply mul_le_mul_of_nonneg_left _ hX
          exact mul_le_mul e1 e2 (by positivity) (by positivity)
      _ = 4 ^ P * (A ^ P * (B ^ P * X)) := by rw [h4]; ring
      _ ≤ 4 ^ P * M := mul_le_mul_of_nonneg_left hAB (by positivity)

  refine ⟨?_, ?_⟩
  · rw [hfeq]; exact hcont
  · intro j hj s
    rw [hfeq, hid j]
    obtain ⟨hH1, hH2, hH3⟩ := iter _ j G hes hG
    have hHp := hH3 hper
    have bd : ∀ a b : ℕ, a ≤ P → b ≤ P → (2 * Real.pi * |(m.1:ℝ)|) ^ a *
