    exact (continuousAt_const.mul (hW.add (hnum.div hden hden0))).div hLc hL
  have hs3 : ∀ X η0 : ℝ, 0 < X → Fn X η0 ≠ 0 → 1 - 2 * h * η0 ^ 2 ≠ 0 →
      ContinuousAt (fun e => Fn X e) η0 →
      ContinuousAt (fun e => profRadInt Un X e) η0 →
      ContinuousAt (fun e => profEtaD (profRadInt Un) X e) η0 →
      ContinuousAt (fun e => profRadInt (fun x e => 2 * x * Fn x e) X e) η0 →
