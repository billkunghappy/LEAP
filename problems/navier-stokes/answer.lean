  obtain ⟨l5, h5⟩ := tdg_ubase0_mul_v5 B hok hSN
  obtain ⟨l7, h7⟩ := tdg_inm_dT_v5 B hok hSN
  refine ⟨l3 + l4 + l5 + l7, ?_⟩
  intro l0 hl0 S hv hγ hβ hW
  have hl3 : l3 ≤ l0 := by omega
  have hl4 : l4 ≤ l0 := by omega
  have hl5 : l5 ≤ l0 := by omega
  have hl7 : l7 ≤ l0 := by omega
  have hqs0 : 0 < qsOf l0 := by unfold qsOf Qb; positivity
  have hqs1 : qsOf l0 ≤ 1 := by
    unfold qsOf Qb
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  obtain ⟨hMc, -⟩ := mom_class_algebra_v4 B (qsOf l0) hok hqs0 hqs1
  have hk : kapS = 1 / 100000 := rfl

  have hexp : ∀ (c e e' : ℝ) (f : Cyl → ℝ), InM B (qsOf l0) c (nrm B e f) → e = e' →
      InM B (qsOf l0) c (nrm B e' f) := by
    intro c e e' f hf he
    subst he
    exact hf
  have hlin : ∀ (c1 c2 c e a b : ℝ) (f g k : Cyl → ℝ), InM B (qsOf l0) c1 (nrm B e f) →
      InM B (qsOf l0) c2 (nrm B e g) → c ≤ c1 → c ≤ c2 →
      (∀ ξ ∈ DomC B.h (qsOf l0), k ξ = a * f ξ + b * g ξ) → InM B (qsOf l0) c (nrm B e k) := by
    intro c1 c2 c e a b f g k hf1 hf2 hc1 hc2 hkk
    exact hMc c1 c2 c a b _ _ _ hf1 hf2 hc1 hc2 (fun ξ hξ => by simp only [nrm]; rw [hkk ξ hξ]; ring)
  have hmono : ∀ (c c' e : ℝ) (f : Cyl → ℝ), InM B (qsOf l0) c (nrm B e f) → c' ≤ c →
