    exact hφ.contDiffAt (isOpen_Ioo.mem_nhds ⟨h1, h2⟩)
  have hj : ∀ (j : ℕ) (x η : ℝ), a ≤ x → -1 < η → η < 1 →
      |iteratedDeriv j (fun η' => q e x η') η| ≤ |C j| * (e / x) := by
    intro j x η hx h1 h2
    have hx0 : 0 < x := ha.trans_le hx
    have hu0 : 0 ≤ e / x := div_nonneg he.le hx0.le
