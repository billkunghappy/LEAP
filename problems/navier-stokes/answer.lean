      · rw [e1, hu1]; simp
      · rw [e2, hu1]; simp
      · rw [e3, hu1]
        exact map_zero _
    have hLu2 : Lnorm B.h ξ u2 = ((0, 0, 0, drx B.h • vrv) : Cyl) := by
      refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
      · rw [e0, hu2]; simp
      · rw [e1, hu2]; simp
      · rw [e2, hu2]; simp
      · rw [e3, hu2]
        show JpowL (-coarseIdx B.h (qC B.h ξ)) ((Λ * drx B.h) • vrv) = drx B.h • vrv
        rw [hJ, hΛ]
        congr 1
        rw [zpow_neg, ← mul_assoc, inv_mul_cancel₀ (zpow_pos hsL _).ne', one_mul]
    have hnu1 : ‖u1‖ = (Real.sqrt (qC B.h ξ))⁻¹ := by
      have hsi : 0 < (Real.sqrt (qC B.h ξ))⁻¹ := inv_pos.mpr hs0
      rw [hu1]
      simp only [Prod.norm_def, norm_zero, Real.norm_eq_abs, abs_of_pos hsi, max_self]
      rw [max_eq_left hsi.le]
    have hnu2 : ‖u2‖ = Λ * (|drx B.h| * ‖vrv‖) := by
      rw [hu2, Prod.norm_mk, Prod.norm_mk, Prod.norm_mk]
      simp only [norm_zero, norm_nonneg, max_eq_right]
      rw [norm_smul, Real.norm_eq_abs, abs_mul, abs_of_pos hΛ0]
      ring
    have hv : ∀ η : Cyl, ((1, 0, 0, (drx B.h * η.1 ^ (drx B.h - 1)) • vrv) : Cyl) =
        Lnorm B.h ξ u1 + η.1 ^ (drx B.h - 1) • Lnorm B.h ξ u2 := by
      intro η
      rw [hLu1, hLu2]
      refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
      · simp
      · simp
      · simp
      · simp [smul_smul, mul_comm]
    have hRe : dR B.h F =
        fun η => fderiv ℝ F η (Lnorm B.h ξ u1) + η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2) := by
      funext η
      show fderiv ℝ F η ((1, 0, 0, (drx B.h * η.1 ^ (drx B.h - 1)) • vrv) : Cyl) = _
      rw [hv η, map_add, map_smul]
    have hFd : ContDiffOn ℝ ∞ (fderiv ℝ F) U :=
      hF.fderiv_of_isOpen hUo (by exact_mod_cast le_top)
    have hG1 : ContDiffOn ℝ ∞ (fun η => fderiv ℝ F η (Lnorm B.h ξ u1)) U :=
      hFd.clm_apply contDiffOn_const
    have hG2 : ContDiffOn ℝ ∞ (fun η => fderiv ℝ F η (Lnorm B.h ξ u2)) U :=
      hFd.clm_apply contDiffOn_const
    have hφ : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ (drx B.h - 1)) U :=
      contDiff_fst.contDiffOn.rpow_const_of_ne (fun η hη => ne_of_gt (hUpos η hη))
    have hφG : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) U :=
      hφ.smul hG2
    have hsub : NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u1) +
          η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) k ξ ≤
        NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u1)) k ξ +
        NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) k ξ := by
      have hn : U ∈ nhds ξ := hUo.mem_nhds hξ
      have hfun : (fun η => fderiv ℝ F η (Lnorm B.h ξ u1) +
          η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) =
          (fun η => fderiv ℝ F η (Lnorm B.h ξ u1)) +
          (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) := by
        funext η; rfl
      have ea : iteratedFDeriv ℝ k (fun η => fderiv ℝ F η (Lnorm B.h ξ u1) +
          η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) ξ =
          iteratedFDeriv ℝ k (fun η => fderiv ℝ F η (Lnorm B.h ξ u1)) ξ +
          iteratedFDeriv ℝ k (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) ξ := by
        rw [hfun]
        exact iteratedFDeriv_add_apply ((hG1.contDiffAt hn).of_le (by exact_mod_cast le_top))
          ((hφG.contDiffAt hn).of_le (by exact_mod_cast le_top))
      unfold NB
      rw [ea]
      have eb : (iteratedFDeriv ℝ k (fun η => fderiv ℝ F η (Lnorm B.h ξ u1)) ξ +
          iteratedFDeriv ℝ k (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) ξ
            ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) =
          (iteratedFDeriv ℝ k (fun η => fderiv ℝ F η (Lnorm B.h ξ u1)) ξ).compContinuousLinearMap
            (fun _ => Lnorm B.h ξ) +
          (iteratedFDeriv ℝ k (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2))
            ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
        ext m
        simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
      rw [eb]
      exact norm_add_le _ _
    have hG1b : Real.sqrt (qC B.h ξ) * NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u1)) k ξ ≤ Q * T := by
      have h1 := nbdirR B.h U ξ F u1 hUo hξ hF k
      rw [hnu1] at h1
      calc Real.sqrt (qC B.h ξ) * NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u1)) k ξ
          ≤ Real.sqrt (qC B.h ξ) * ((Real.sqrt (qC B.h ξ))⁻¹ * NB B.h F (k + 1) ξ) :=
            mul_le_mul_of_nonneg_left h1 hs0.le
        _ = NB B.h F (k + 1) ξ := by rw [← mul_assoc, mul_inv_cancel₀ hs0.ne', one_mul]
        _ ≤ T := hNT (k + 1) le_rfl
        _ ≤ Q * T := le_mul_of_one_le_left hT0 hQ1
    have hl := leib ξ U k hUo hξ (fun η : Cyl => η.1 ^ (drx B.h - 1))
      (fun η => fderiv ℝ F η (Lnorm B.h ξ u2)) (hφ.of_le (by exact_mod_cast le_top))
      (hG2.of_le (by exact_mod_cast le_top))
    have hX : ξ.1 ^ 2 = 2 * qC B.h ξ * XC B.h ξ := by
      have : XC B.h ξ = ξ.1 ^ 2 / (2 * qC B.h ξ) := rfl
      rw [this]
      field_simp
    have hterm : ∀ i ∈ Finset.range (k + 1), Real.sqrt (qC B.h ξ) * ((k.choose i : ℝ) *
        NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1)) i ξ *
        NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u2)) (k - i) ξ) ≤
        (k.choose i : ℝ) * (Kf i * (|drx B.h| * ‖vrv‖)) * Ef i * (Q * T) := by
      intro i hi
      have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hC0 : (0:ℝ) ≤ (k.choose i : ℝ) := Nat.cast_nonneg _
      have hKi : Kf i = |Polynomial.eval (drx B.h - 1) (descPochhammer ℝ i)| := by rw [hKf]
      have hEi : (2 * (B.Xa / 2)) ^ ((drx B.h - 1 - (i:ℝ)) / 2) +
          (2 * (2 * B.Xb)) ^ ((drx B.h - 1 - (i:ℝ)) / 2) ≤ Ef i := by
        rw [hEf]; exact add_le_add (le_abs_self _) (le_abs_self _)
      have b1 : NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1)) i ξ ≤
          Kf i * Real.sqrt (qC B.h ξ) ^ i * ξ.1 ^ (drx B.h - 1 - (i:ℝ)) := by
        rw [hKi]; exact hphi (drx B.h - 1) i ξ hr
      have hA0 : 0 ≤ Kf i * Real.sqrt (qC B.h ξ) ^ i * ξ.1 ^ (drx B.h - 1 - (i:ℝ)) :=
        mul_nonneg (mul_nonneg (hK0 i) (pow_nonneg hs0.le _)) (Real.rpow_nonneg hr.le _)
      have b2 : NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u2)) (k - i) ξ ≤
          Λ * (|drx B.h| * ‖vrv‖) * T := by
        have h2 := nbdirR B.h U ξ F u2 hUo hξ hF (k - i)
        rw [hnu2] at h2
        exact h2.trans (mul_le_mul_of_nonneg_left (hNT (k - i + 1) (by omega))
          (mul_nonneg hΛ0.le (mul_nonneg (abs_nonneg _) (norm_nonneg _))))
      have b3 : Real.sqrt (qC B.h ξ) * (Λ * Real.sqrt (qC B.h ξ) ^ i * ξ.1 ^ (drx B.h - 1 - (i:ℝ))) ≤
          Ef i * Q := by
        have hsh := hshell (drx B.h) (B.h * kapS) (qC B.h ξ) ξ.1 (XC B.h ξ) Λ (B.Xa / 2) (2 * B.Xb)
          (drx B.h - 1 - (i:ℝ)) i rfl hq0 (by linarith) hX1 hX2 hr hX hΛ0.le
          (by rw [hΛ]; exact hcoarse B.h (qC B.h ξ) hh.le hq0 hq1)
        rw [← hQ] at hsh
        exact hsh.trans (mul_le_mul_of_nonneg_right hEi (by linarith))
      have hP0 : 0 ≤ (k.choose i : ℝ) * Kf i * (|drx B.h| * ‖vrv‖) * T :=
        mul_nonneg (mul_nonneg (mul_nonneg hC0 (hK0 i)) (mul_nonneg (abs_nonneg _) (norm_nonneg _))) hT0
      calc Real.sqrt (qC B.h ξ) * ((k.choose i : ℝ) *
            NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1)) i ξ *
            NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u2)) (k - i) ξ)
          ≤ Real.sqrt (qC B.h ξ) * ((k.choose i : ℝ) *
            (Kf i * Real.sqrt (qC B.h ξ) ^ i * ξ.1 ^ (drx B.h - 1 - (i:ℝ))) *
            (Λ * (|drx B.h| * ‖vrv‖) * T)) :=
            mul_le_mul_of_nonneg_left (mul_le_mul (mul_le_mul_of_nonneg_left b1 hC0) b2
              (norm_nonneg _) (mul_nonneg hC0 hA0)) hs0.le
        _ = ((k.choose i : ℝ) * Kf i * (|drx B.h| * ‖vrv‖) * T) *
            (Real.sqrt (qC B.h ξ) * (Λ * Real.sqrt (qC B.h ξ) ^ i * ξ.1 ^ (drx B.h - 1 - (i:ℝ)))) := by
            ring
        _ ≤ ((k.choose i : ℝ) * Kf i * (|drx B.h| * ‖vrv‖) * T) * (Ef i * Q) :=
            mul_le_mul_of_nonneg_left b3 hP0
        _ = (k.choose i : ℝ) * (Kf i * (|drx B.h| * ‖vrv‖)) * Ef i * (Q * T) := by ring
    have hLb : Real.sqrt (qC B.h ξ) *
        NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) k ξ ≤
        S * (Q * T) := by
      calc Real.sqrt (qC B.h ξ) *
            NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) k ξ
          ≤ Real.sqrt (qC B.h ξ) * ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) *
            NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1)) i ξ *
            NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u2)) (k - i) ξ :=
            mul_le_mul_of_nonneg_left hl hs0.le
        _ = ∑ i ∈ Finset.range (k + 1), Real.sqrt (qC B.h ξ) * ((k.choose i : ℝ) *
            NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1)) i ξ *
            NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u2)) (k - i) ξ) := by rw [Finset.mul_sum]
        _ ≤ ∑ i ∈ Finset.range (k + 1),
            (k.choose i : ℝ) * (Kf i * (|drx B.h| * ‖vrv‖)) * Ef i * (Q * T) :=
            Finset.sum_le_sum hterm
        _ = S * (Q * T) := by rw [hS, Finset.sum_mul]
    rw [← hQ, ← hT, hRe]
    calc Real.sqrt (qC B.h ξ) * NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u1) +
          η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) k ξ
        ≤ Real.sqrt (qC B.h ξ) * (NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u1)) k ξ +
          NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) k ξ) :=
          mul_le_mul_of_nonneg_left hsub hs0.le
      _ = Real.sqrt (qC B.h ξ) * NB B.h (fun η => fderiv ℝ F η (Lnorm B.h ξ u1)) k ξ +
          Real.sqrt (qC B.h ξ) *
            NB B.h (fun η : Cyl => η.1 ^ (drx B.h - 1) • fderiv ℝ F η (Lnorm B.h ξ u2)) k ξ :=
          mul_add _ _ _
      _ ≤ Q * T + S * (Q * T) := add_le_add hG1b hLb
      _ = (1 + S) * Q * T := by ring

  have nb_dZ_open_v5 : ∀ (h : ℝ) (U : Set Cyl) (F : Cyl → ℝ) (ξ : Cyl), IsOpen U → ξ ∈ U → ContDiffOn ℝ ∞ F U → 0 < qC h ξ → ∀ k : ℕ, NB h (dZ F) k ξ ≤ qC h ξ ^ (-(1/2 - h)) * NB h F (k + 1) ξ := by
    intro h U F ξ hU hξ hF hq0 k
    obtain ⟨uz, huz⟩ : ∃ uz : Cyl,
        uz = ((0:ℝ), qC h ξ ^ (-(1/2 - h)), (0:ℝ), (0 : ℝ × ℝ)) := ⟨_, rfl⟩
    have e0 : ∀ v : Cyl, (Lnorm h ξ v).1 = Real.sqrt (qC h ξ) * v.1 := by
      intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e1 : ∀ v : Cyl, (Lnorm h ξ v).2.1 = qC h ξ ^ (1/2 - h) * v.2.1 := by
      intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e2 : ∀ v : Cyl, (Lnorm h ξ v).2.2.1 = qC h ξ * v.2.2.1 := by
      intro v; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e3 : ∀ v : Cyl, (Lnorm h ξ v).2.2.2 = JpowL (-coarseIdx h (qC h ξ)) v.2.2.2 := by
      intro v; rfl
    have hLuz : Lnorm h ξ uz = ((0, 1, 0, 0) : Cyl) := by
      refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
      · rw [e0, huz]; simp
      · rw [e1, huz]
        show qC h ξ ^ (1/2 - h) * qC h ξ ^ (-(1/2 - h)) = 1
        rw [Real.rpow_neg hq0.le, mul_inv_cancel₀ (Real.rpow_pos_of_pos hq0 _).ne']
      · rw [e2, huz]; simp
      · rw [e3, huz]
        exact map_zero _
    have hnuz : ‖uz‖ = qC h ξ ^ (-(1/2 - h)) := by
      have hzp : 0 < qC h ξ ^ (-(1/2 - h)) := Real.rpow_pos_of_pos hq0 _
      rw [huz, Prod.norm_mk, Prod.norm_mk, Prod.norm_mk]
      simp only [norm_zero, norm_nonneg, max_eq_right, max_eq_left]
      rw [Real.norm_eq_abs, abs_of_pos hzp]
      simp only [max_self]
      rw [max_eq_left hzp.le, max_eq_right hzp.le]
    have hfun : dZ F = fun η => fderiv ℝ F η (Lnorm h ξ uz) := by
      funext η; rw [hLuz]; rfl
    rw [hfun]
    have h1 := nbdirR h U ξ F uz hU hξ hF k
    rwa [hnuz] at h1

  have dvF5_local_rep_v5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (U : Set Cyl), IsOpen U → (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => nPhi5 B G γ η i) U) → ∀ η ∈ U, dvF5 B G γ η = (Real.sqrt (Qb γ.1))⁻¹ * dR B.h (fun η' : Cyl => nPhi5 B G γ η' 0) η + (Real.sqrt (Qb γ.1))⁻¹ ^ 2 * (nPhi5 B G γ η 0 * (Real.sqrt (Qb γ.1) / η.1)) + (Real.sqrt (Qb γ.1))⁻¹ * dZ (fun η' : Cyl => nPhi5 B G γ η' 2) η := by
    intro B G γ U hU hn η hη
    have h0 : ∀ y : Cyl, nPhi5 B G γ y 0 = Real.sqrt (Qb γ.1) * dR B.h (phiL5 B G γ) y := by
      intro y; first | rfl | simp [nPhi5, DrC, smul_eq_mul]
    have h2 : ∀ y : Cyl, nPhi5 B G γ y 2 = Real.sqrt (Qb γ.1) * dZ (phiL5 B G γ) y := by
      intro y; first | rfl | simp [nPhi5, DzC, smul_eq_mul]
    obtain ⟨sQ, hsQd⟩ : ∃ x : ℝ, x = Real.sqrt (Qb γ.1) := ⟨_, rfl⟩
    rw [← hsQd] at h0 h2 ⊢
    have hQ0 : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
    have hne : sQ ≠ 0 := by rw [hsQd]; exact (Real.sqrt_pos.mpr hQ0).ne'
    have hss : sQ⁻¹ * sQ = 1 := inv_mul_cancel₀ hne
    have hR : (fun y : Cyl => dR B.h (phiL5 B G γ) y) = fun y => sQ⁻¹ * nPhi5 B G γ y 0 := by
      funext y; rw [h0, ← mul_assoc, hss, one_mul]
    have hZ : (fun y : Cyl => dZ (phiL5 B G γ) y) = fun y => sQ⁻¹ * nPhi5 B G γ y 2 := by
      funext y; rw [h2, ← mul_assoc, hss, one_mul]
    have hd0 : DifferentiableAt ℝ (fun y : Cyl => nPhi5 B G γ y 0) η :=
      ((hn 0).contDiffAt (hU.mem_nhds hη)).differentiableAt (by simp)
    have hd2 : DifferentiableAt ℝ (fun y : Cyl => nPhi5 B G γ y 2) η :=
      ((hn 2).contDiffAt (hU.mem_nhds hη)).differentiableAt (by simp)
    have e1 : dR B.h (fun y : Cyl => dR B.h (phiL5 B G γ) y) η =
        sQ⁻¹ * dR B.h (fun η' : Cyl => nPhi5 B G γ η' 0) η := by
      rw [hR]
      unfold dR
      rw [(hd0.hasFDerivAt.const_mul sQ⁻¹).fderiv]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    have e3 : dZ (fun y : Cyl => dZ (phiL5 B G γ) y) η =
        sQ⁻¹ * dZ (fun η' : Cyl => nPhi5 B G γ η' 2) η := by
      rw [hZ]
      unfold dZ
      rw [(hd2.hasFDerivAt.const_mul sQ⁻¹).fderiv]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    have em : dR B.h (phiL5 B G γ) η / η.1 = sQ⁻¹ ^ 2 * (nPhi5 B G γ η 0 * (sQ / η.1)) := by
      rw [h0 η, div_eq_mul_inv, div_eq_mul_inv]
      calc dR B.h (phiL5 B G γ) η * η.1⁻¹
          = (sQ⁻¹ * sQ) ^ 2 * (dR B.h (phiL5 B G γ) η * η.1⁻¹) := by rw [hss]; ring
        _ = _ := by ring
    show dR B.h (fun y : Cyl => dR B.h (phiL5 B G γ) y) η + dR B.h (phiL5 B G γ) η / η.1 +
        dZ (fun y : Cyl => dZ (phiL5 B G γ) y) η = _
    rw [e1, em, e3]

  have dvF5_deck_v5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (n0 : ℤ) (c : ℝ × ℝ), n0 ≤ bandIdx B.h γ.1 → (∃ a b : ℤ, Jpow n0 c = ((a : ℝ), (b : ℝ))) → ∀ ξ : Cyl, dvF5 B G γ (shY ξ c) = dvF5 B G γ ξ := by
    intro B G γ n0 c hn hc ξ
    have hN := nPhi5_deck_v5 B G γ n0 c hn hc
    obtain ⟨a, ha⟩ : ∃ a : Cyl, a = ((0:ℝ), (0:ℝ), (0:ℝ), c) := ⟨_, rfl⟩
    have hsh : ∀ y : Cyl, shY y c = y + a := by
      intro y
      rw [ha]
      refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_)) <;> simp [shY]
    have h1 : (ξ + a).1 = ξ.1 := by rw [ha]; simp
    have h0 : ∀ y : Cyl, nPhi5 B G γ y 0 = Real.sqrt (Qb γ.1) * dR B.h (phiL5 B G γ) y := by
      intro y; first | rfl | simp [nPhi5, DrC, smul_eq_mul]
    have h2 : ∀ y : Cyl, nPhi5 B G γ y 2 = Real.sqrt (Qb γ.1) * dZ (phiL5 B G γ) y := by
      intro y; first | rfl | simp [nPhi5, DzC, smul_eq_mul]
    have hQ0 : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
    have hne : Real.sqrt (Qb γ.1) ≠ 0 := (Real.sqrt_pos.mpr hQ0).ne'
    have hFR : ∀ y : Cyl, dR B.h (phiL5 B G γ) (y + a) = dR B.h (phiL5 B G γ) y := by
      intro y
      have k1 : dR B.h (phiL5 B G γ) (y + a) =
          (Real.sqrt (Qb γ.1))⁻¹ * nPhi5 B G γ (y + a) 0 := by
        rw [h0, ← mul_assoc, inv_mul_cancel₀ hne, one_mul]
      have k2 : dR B.h (phiL5 B G γ) y = (Real.sqrt (Qb γ.1))⁻¹ * nPhi5 B G γ y 0 := by
        rw [h0, ← mul_assoc, inv_mul_cancel₀ hne, one_mul]
      rw [k1, k2, ← hsh y, hN y]
    have hFZ : ∀ y : Cyl, dZ (phiL5 B G γ) (y + a) = dZ (phiL5 B G γ) y := by
      intro y
