      intro k x η hx h1 h2
      have hev : (↿g) =ᶠ[nhds (x, η)] fun _ => (0:ℝ) := by
        have hmem : Ioi Xb ×ˢ Ioo (-1:ℝ) 1 ∈ nhds (x, η) :=
          (isOpen_Ioi.prod isOpen_Ioo).mem_nhds ⟨hx, h1, h2⟩
        filter_upwards [hmem] with q hq
        exact hz q.1 q.2 hq.1 hq.2.1 hq.2.2
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_zero]
      rfl
    intro k x η hx h1 h2
    rcases hx.lt_or_eq with hx | hx
    · exact hgt k x η hx h1 h2
    · subst hx
      have hc : ContinuousOn (iteratedFDeriv ℝ k (↿g)) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
        have := hg.continuousOn_iteratedFDerivWithin (m := k) (by exact_mod_cast le_top)
          hO.uniqueDiffOn
        exact this.congr (fun q hq => (iteratedFDerivWithin_of_isOpen k hO hq).symm)
      have hcat : ContinuousAt (iteratedFDeriv ℝ k (↿g)) (Xb, η) :=
        hc.continuousAt (hO.mem_nhds ⟨show -ε < Xb by linarith, h1, h2⟩)
      have hφ : ContinuousAt (fun t : ℝ => iteratedFDeriv ℝ k (↿g) (Xb + t, η)) 0 := by
        have : ContinuousAt (fun t : ℝ => ((Xb + t, η) : ℝ × ℝ)) 0 := by fun_prop
        exact ContinuousAt.comp_of_eq hcat this (by simp)
      have ht1 := hφ.tendsto.mono_left (nhdsWithin_le_nhds (s := Ioi 0))
      have ht2 : Filter.Tendsto (fun t : ℝ => iteratedFDeriv ℝ k (↿g) (Xb + t, η))
          (nhdsWithin 0 (Ioi 0)) (nhds 0) := by
        apply tendsto_const_nhds.congr'
        filter_upwards [self_mem_nhdsWithin] with t ht
        have ht' : (0:ℝ) < t := ht
        exact (hgt k (Xb + t) η (by linarith) h1 h2).symm
      have := tendsto_nhds_unique ht1 ht2
      simpa using this

  intro Xa Xb aa ab Xm ε r1 r2 hXa hXam hXmb haa hab hε hr1 hr2 hin hout hint hbd m
  have hU : IsOpen (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hO : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hXb0 : 0 < Xb := by linarith
  have hew_nn : ∀ y, 0 ≤ edgeWeight Xa Xb aa ab y := by
    intro y; unfold edgeWeight; split_ifs <;> positivity
  have hed_pos : ∀ y, Xa < y → y < Xb → 0 < edgeDist Xa Xb y := by
    intro y h1 h2
    unfold edgeDist
    exact lt_min one_pos (lt_min (Real.log_pos (by rw [lt_div_iff₀ hXa]; linarith))
      (Real.log_pos (by rw [lt_div_iff₀ (by linarith)]; linarith)))
  have hed_le : ∀ y, edgeDist Xa Xb y ≤ 1 := fun y => min_le_left _ _
  have hW_nn : ∀ (N y : ℝ), Xa < y → y < Xb →
