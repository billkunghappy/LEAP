      calc κ ^ 2 * |d i| ≤ κm ^ 2 * ‖d‖ := mul_le_mul hκsq (hd i) (abs_nonneg _) (sq_nonneg _)
        _ ≤ K * ‖d‖ := mul_le_mul_of_nonneg_right hKb hD
    have hlinb : ∀ i, |κ * d i| ≤ K * ‖d‖ := by
      intro i
      rw [abs_mul, abs_of_nonneg hκ0]
      calc κ * |d i| ≤ κm * ‖d‖ := mul_le_mul hκ1 (hd i) (abs_nonneg _) hκm0.le
        _ ≤ K * ‖d‖ := mul_le_mul_of_nonneg_right hKa hD
    refine (pi_norm_le_iff_of_nonneg (mul_nonneg hK0.le hD)).2 (fun i => ?_)
    rw [Real.norm_eq_abs]
    rcases hF5 i with rfl | rfl | rfl | rfl | rfl
    all_goals simp only [hzf, ← hκ, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
