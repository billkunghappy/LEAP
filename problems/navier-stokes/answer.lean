    have h2 : IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1} := isOpen_lt continuous_const continuous_fst
    have e : {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} =
        {s : ℝ × ℝ × ℝ | 0 < s.1} ∩ ({s : ℝ × ℝ × ℝ | s.2.2 < 1} ∩
          ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun s : ℝ × ℝ × ℝ => (s.2.1, 1 - s.2.2))) ⁻¹'
            Iio B.qB) := by
      ext s
      simp only [mem_setOf_eq, mem_inter_iff, mem_preimage, mem_Iio, Function.comp]
    rw [e]
    exact h2.inter h1

  have hD : IsOpen (simDomain B.h B.qB) := by
    have hm : Continuous (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)) := by fun_prop
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2)))
        {w : ℝ³ × ℝ | w.2 < 1} := by
      refine hsc.comp hm.continuousOn ?_
      intro w hw
      have hw' : w.2 < 1 := hw
      exact ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by linarith⟩
    have hU : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
    have h1 := hc.isOpen_inter_preimage hU (isOpen_Iio (a := B.qB))
    have e : simDomain B.h B.qB = {w : ℝ³ × ℝ | w.2 < 1} ∩
        ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘ (fun w : ℝ³ × ℝ => (w.1 2, 1 - w.2))) ⁻¹' Iio B.qB := by
      ext w
      simp only [simDomain, mem_setOf_eq, mem_inter_iff, mem_preimage, mem_Iio, Function.comp]
    rw [e]
    exact h1

  have hu : ContDiffOn ℝ ∞ (↿(uB B)) (simDomain B.h B.qB) := by
    have hAB : ContDiffOn ℝ ∞ (↿B.AB) (simDomain B.h B.qB) := hBP.2.2.2.1.1
    have hBv : ContDiffOn ℝ ∞ (↿B.BvB) (simDomain B.h B.qB) := hBP.2.2.2.1.2.1
    have hDA : ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z) (simDomain B.h B.qB) :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hAB).2
    have hc : ∀ (v : ℝ³) (j : Fin 3),
        ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z (v, (0:ℝ)) j) (simDomain B.h B.qB) := by
      intro v j
      have h1 : ContDiffOn ℝ ∞ (fun z => fderiv ℝ (↿B.AB) z (v, (0:ℝ))) (simDomain B.h B.qB) :=
        hDA.clm_apply contDiffOn_const
      exact (EuclideanSpace.proj j : ℝ³ →L[ℝ] ℝ).contDiff.comp_contDiffOn h1
    let e0 : ℝ³ := EuclideanSpace.single 0 1
    let e1 : ℝ³ := EuclideanSpace.single 1 1
    let e2 : ℝ³ := EuclideanSpace.single 2 1
    have hg : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ =>
        (fderiv ℝ (↿B.AB) z (e1, (0:ℝ)) 2 - fderiv ℝ (↿B.AB) z (e2, (0:ℝ)) 1) •
            EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
        (fderiv ℝ (↿B.AB) z (e2, (0:ℝ)) 0 - fderiv ℝ (↿B.AB) z (e0, (0:ℝ)) 2) •
            EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
        (fderiv ℝ (↿B.AB) z (e0, (0:ℝ)) 1 - fderiv ℝ (↿B.AB) z (e1, (0:ℝ)) 0) •
            EuclideanSpace.single (2 : Fin 3) (1 : ℝ) + (↿B.BvB) z) (simDomain B.h B.qB) := by
      refine ((((hc e1 2).sub (hc e2 1)).smul contDiffOn_const).add
        (((hc e2 0).sub (hc e0 2)).smul contDiffOn_const)).add
        (((hc e0 1).sub (hc e1 0)).smul contDiffOn_const) |>.add hBv
    refine hg.congr ?_
    rintro ⟨y, s⟩ hz
    have hdiff : DifferentiableAt ℝ (↿B.AB) (y, s) :=
      (hAB.contDiffAt (hD.mem_nhds hz)).differentiableAt (by norm_num)
    have hpart : fderiv ℝ (fun w => B.AB w s) y =
        (fderiv ℝ (↿B.AB) (y, s)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := by
      have h1 : HasFDerivAt (fun w : ℝ³ => (w, s)) (ContinuousLinearMap.inl ℝ ℝ³ ℝ) y :=
        hasFDerivAt_prodMk_left y s
      have h2 : HasFDerivAt ((↿B.AB) ∘ (fun w : ℝ³ => (w, s)))
          ((fderiv ℝ (↿B.AB) (y, s)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ)) y :=
        HasFDerivAt.comp (g := ↿B.AB) y hdiff.hasFDerivAt h1
      exact h2.fderiv
    show curl3 (fun w => B.AB w s) y + B.BvB y s = _
    unfold curl3
    rw [hpart]
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.inl_apply]
    rfl

  have frame : ∀ r z : ℝ, 0 < r → (rotPt r 0 z) 2 = z ∧
      eR (rotPt r 0 z) = EuclideanSpace.single (0 : Fin 3) (1 : ℝ) ∧
      eTh (rotPt r 0 z) = EuclideanSpace.single (1 : Fin 3) (1 : ℝ) := by
    intro r z hr
    have h0 : (rotPt r 0 z) 0 = r := by simp [rotPt]
    have h1 : (rotPt r 0 z) 1 = 0 := by simp [rotPt]
    have h2 : (rotPt r 0 z) 2 = z := by simp [rotPt]
    have hrad : rad (rotPt r 0 z) = r := by
      unfold rad
      rw [h0, h1]
      simp [Real.sqrt_sq hr.le]
    refine ⟨h2, ?_, ?_⟩
    · unfold eR radVec
      rw [hrad, h0, h1, zero_smul, add_zero, smul_smul, inv_mul_cancel₀ hr.ne', one_smul]
    · unfold eTh azVec
      rw [hrad, h0, h1, neg_zero, zero_smul, zero_add, smul_smul, inv_mul_cancel₀ hr.ne', one_smul]

  let ψ : ℝ × ℝ × ℝ → ℝ³ × ℝ := fun s => (rotPt s.1 0 s.2.1, s.2.2)
  have hψ : ContDiff ℝ ∞ ψ := by
    have hr : ContDiff ℝ ∞ (fun s : ℝ × ℝ × ℝ => rotPt s.1 0 s.2.1) := by
      unfold rotPt
      fun_prop
    exact hr.prodMk (contDiff_snd.comp contDiff_snd)
  have hmaps : MapsTo ψ {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}
      (simDomain B.h B.qB) := by
    intro s hs
    obtain ⟨h1, h2, h3⟩ := hs
    show s.2.2 < 1 ∧ simScale B.h ((rotPt s.1 0 s.2.1) 2) (1 - s.2.2) < B.qB
    rw [(frame s.1 s.2.1 h1).1]
    exact ⟨h2, h3⟩
  refine ⟨hA, fun l i => ?_⟩
  have hcomp : ContDiffOn ℝ ∞ ((↿(uB B)) ∘ ψ)
      {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} :=
    hu.comp hψ.contDiffOn hmaps
  have hg : ContDiffOn ℝ ∞ (fun s => Qb l ^ (1/2 + B.h) * inner ℝ (((↿(uB B)) ∘ ψ) s)
      ((![EuclideanSpace.single (0 : Fin 3) (1 : ℝ), EuclideanSpace.single (1 : Fin 3) (1 : ℝ), eZ] :
        Fin 3 → ℝ³) i))
      {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} :=
    contDiffOn_const.mul (ContDiffOn.inner ℝ hcomp contDiffOn_const)
  refine hg.congr ?_
  intro s hs
  obtain ⟨_, f2, f3⟩ := frame s.1 s.2.1 hs.1
  show Qb l ^ (1/2 + B.h) * inner ℝ (uB B (rotPt s.1 0 s.2.1) s.2.2)
      (![eR (rotPt s.1 0 s.2.1), eTh (rotPt s.1 0 s.2.1), eZ] i) = _
  rw [f2, f3]
  rfl

theorem geom_pulse_coeff_v5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab), B.ok → 0 < G.r0 → G.r0 ≤ 1/100 →
    IsOpen {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} →
    (∀ (l : ℕ) (i : Fin 3), ContDiffOn ℝ ∞ (fun s : ℝ × ℝ × ℝ => baseC B l (s.1, s.2.1, s.2.2, ((0:ℝ), (0:ℝ))) i)
      {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}) →
    ∃ (M : ℝ × ℝ × ℝ → ℝ → Fin 3 → Fin 3 → ℝ) (z0 : ℝ × ℝ × ℝ → Fin 3 → ℝ),
      ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => M w.1 w.2)
        ({s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} ×ˢ Set.univ) ∧
      ContDiffOn ℝ ∞ z0 {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} ∧
      ∀ ξ ∈ DomC B.h B.qB, inRect B.h γ (G.ctr γ) G.r0 ξ.2.2.2 →
        (∀ z : Fin 3 → ℝ, Matrix.mulVec (M (ξ.1, ξ.2.1, ξ.2.2.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) z =
          (APhi5 B G γ ξ).mulVec z - dDamp5 B G γ ξ • z) ∧
        (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 = 0 → z0 (ξ.1, ξ.2.1, ξ.2.2.1) = Penv5 B G γ 0 • Bcol5 B G γ ξ 1) :=
by
  intro B G γ hB hr0 hr0' hΩ hbase
  set Ω := {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} with hΩe

  have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have hsQ : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr hQ
  have hs2 := Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num)
  have hs0 := Real.sqrt_nonneg 2
  have hbgc0 : 0 < bgc := by unfold bgc; nlinarith
  have hbgc1 : bgc < 1 := by unfold bgc; nlinarith
  have hb2 : (1 + bgc ^ 2) ≠ 0 := by positivity
  have hT : 0 < Tgc := by unfold Tgc; positivity
  have hci : 0 < cib B.h γ.1 := mul_pos (zpow_pos hT _) (Real.rpow_pos_of_pos hQ _)
  have hkb : (0:ℝ) < (kb B.h γ.1 : ℝ) := by
    have : 0 < kb B.h γ.1 := Nat.ceil_pos.mpr (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos hQ _) _)
    exact_mod_cast this
  have hpint : pint5 B G γ ≠ 0 := by
    unfold pint5; split_ifs with h
    · exact one_ne_zero
    · exact h
  have hpang : pang5 B G γ ≠ 0 := div_ne_zero (Int.cast_ne_zero.mpr hpint) hkb.ne'
  have hlamR : ∀ a : ℝ, lamT (a • vrv) = 0 := by
    intro a; simp only [lamT, vrv, Prod.smul_mk, smul_eq_mul]; rw [div_eq_iff hb2]; ring
  have hlamV : ∀ a : ℝ, lamT (a • vtv) = a := by
    intro a; simp only [lamT, vtv, Prod.smul_mk, smul_eq_mul]; rw [div_eq_iff hb2]; ring

  have hRC : ∀ s ∈ Ω, pcRC5 γ.1 s ≠ 0 := fun s hs => div_ne_zero (ne_of_gt hs.1) hsQ.ne'
  have hRCs : ContDiff ℝ ∞ (pcRC5 γ.1) := by unfold pcRC5; fun_prop
  have hb : ∀ i, ContDiffOn ℝ ∞ (pcB5 B γ.1 i) Ω := fun i => hbase γ.1 i
  have hFa : ContDiffOn ℝ ∞ (pcFa5 B γ.1) Ω := (hb 1).div hRCs.contDiffOn hRC
  have hP1 : ContDiff ℝ ∞ (pcPhi1_5 B G γ) := by unfold pcPhi1_5 pcRC5; fun_prop
  have hP1on : ContDiffOn ℝ ∞ (pcPhi1_5 B G γ) Ω := hP1.contDiffOn
  have hP2 : ContDiffOn ℝ ∞ (pcPhi2_5 B G γ) Ω := (contDiffOn_const.mul hFa).add (contDiffOn_const.mul (hb 2))
  have hD : ∀ f : ℝ × ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ f Ω → ∀ e : ℝ × ℝ × ℝ,
      ContDiffOn ℝ ∞ (fun s => fderiv ℝ f s e) Ω := by
    intro f hf e
    first
    | exact ((contDiffOn_infty_iff_fderiv_of_isOpen hΩ).1 hf).2.clm_apply contDiffOn_const
    | exact (hf.fderiv_of_isOpen hΩ (by simp)).clm_apply contDiffOn_const
    | exact (hf.fderiv_of_isOpen hΩ le_rfl).clm_apply contDiffOn_const
  have hA : ∀ i, ContDiffOn ℝ ∞ (fun s => pcA5 B G γ s i) Ω := by
    intro i; fin_cases i
    · exact (contDiffOn_const.mul (hD _ hP1on _) : ContDiffOn ℝ ∞
        (fun s => Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi1_5 B G γ) s ((1:ℝ), (0:ℝ), (0:ℝ))) Ω)
    · exact (contDiffOn_const.div hRCs.contDiffOn hRC : ContDiffOn ℝ ∞
        (fun s => pang5 B G γ / pcRC5 γ.1 s) Ω)
    · exact (contDiffOn_const.mul (hD _ hP1on _) : ContDiffOn ℝ ∞
        (fun s => Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi1_5 B G γ) s ((0:ℝ), (1:ℝ), (0:ℝ))) Ω)
  have hPs : ∀ i, ContDiffOn ℝ ∞ (fun s => pcPsi5 B G γ s i) Ω := by
    intro i; fin_cases i
    · exact (contDiffOn_const.mul (hD _ hP2 _) : ContDiffOn ℝ ∞
        (fun s => Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) s ((1:ℝ), (0:ℝ), (0:ℝ))) Ω)
    · exact (contDiffOn_const : ContDiffOn ℝ ∞ (fun _ : ℝ × ℝ × ℝ => (0:ℝ)) Ω)
    · exact (contDiffOn_const.mul (hD _ hP2 _) : ContDiffOn ℝ ∞
        (fun s => Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) s ((0:ℝ), (1:ℝ), (0:ℝ))) Ω)
  have hKm : ∀ k j, ContDiffOn ℝ ∞ (fun s => pcKm5 B γ.1 s k j) Ω := by
    intro k j
    fin_cases k <;> fin_cases j <;>
    first
    | exact (contDiffOn_const : ContDiffOn ℝ ∞ (fun _ : ℝ × ℝ × ℝ => (0:ℝ)) Ω)
    | exact (contDiffOn_const.mul hFa : ContDiffOn ℝ ∞ (fun s => -2 * pcFa5 B γ.1 s) Ω)
    | exact ((contDiffOn_const.mul hFa).add (hRCs.contDiffOn.mul (contDiffOn_const.mul (hD _ hFa _))) :
        ContDiffOn ℝ ∞ (fun s => 2 * pcFa5 B γ.1 s + pcRC5 γ.1 s *
          (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) s ((1:ℝ), (0:ℝ), (0:ℝ)))) Ω)
    | exact (contDiffOn_const.mul (hD _ (hb 2) _) : ContDiffOn ℝ ∞
        (fun s => Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) s ((1:ℝ), (0:ℝ), (0:ℝ))) Ω)
  have hN1 : ∀ s v, pcN5 B G γ s v 1 = pang5 B G γ / pcRC5 γ.1 s := by
    intro s v; show pang5 B G γ / pcRC5 γ.1 s - v * 0 = _; ring

  let Mf : ℝ × ℝ × ℝ → ℝ → Fin 3 → Fin 3 → ℝ := fun s v => pcM5 B G γ s v
  have hMs : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => Mf w.1 w.2) (Ω ×ˢ Set.univ) := by
    have hmaps : Set.MapsTo Prod.fst (Ω ×ˢ (Set.univ : Set ℝ)) Ω := fun w hw => hw.1
    have hKw : ∀ k j, ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => pcKm5 B γ.1 w.1 k j) (Ω ×ˢ Set.univ) :=
      fun k j => (hKm k j).comp contDiffOn_fst hmaps
    have hPw : ∀ k, ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => pcPsi5 B G γ w.1 k) (Ω ×ˢ Set.univ) :=
      fun k => (hPs k).comp contDiffOn_fst hmaps
    have hNw : ∀ k, ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => pcN5 B G γ w.1 w.2 k) (Ω ×ˢ Set.univ) :=
      fun k => ((hA k).comp contDiffOn_fst hmaps).sub (contDiffOn_snd.mul (hPw k))
    have hdot : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ =>
        dotProduct (pcN5 B G γ w.1 w.2) (pcN5 B G γ w.1 w.2)) (Ω ×ˢ Set.univ) := by
      show ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ =>
        ∑ k, pcN5 B G γ w.1 w.2 k * pcN5 B G γ w.1 w.2 k) (Ω ×ˢ Set.univ)
      exact ContDiffOn.sum (fun k _ => (hNw k).mul (hNw k))
    have hne : ∀ w ∈ Ω ×ˢ (Set.univ : Set ℝ),
        dotProduct (pcN5 B G γ w.1 w.2) (pcN5 B G γ w.1 w.2) ≠ 0 := by
      intro w hw
      have h1 : pcN5 B G γ w.1 w.2 1 ≠ 0 := by
        rw [hN1]; exact div_ne_zero hpang (hRC _ hw.1)
      have q1 := mul_self_pos.2 h1
      have q0 := mul_self_nonneg (pcN5 B G γ w.1 w.2 0)
      have q2 := mul_self_nonneg (pcN5 B G γ w.1 w.2 2)
      rw [dotProduct, Fin.sum_univ_three]
      exact ne_of_gt (by linarith)
    have hinv := hdot.inv hne
    rw [contDiffOn_pi]; intro i; rw [contDiffOn_pi]; intro j
    have hdK : ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ =>
        dotProduct (pcN5 B G γ w.1 w.2) (fun k => pcKm5 B γ.1 w.1 k j)) (Ω ×ˢ Set.univ) := by
      show ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ =>
        ∑ k, pcN5 B G γ w.1 w.2 k * pcKm5 B γ.1 w.1 k j) (Ω ×ˢ Set.univ)
      exact ContDiffOn.sum (fun k _ => (hNw k).mul (hKw k j))
    show ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => -pcKm5 B γ.1 w.1 i j +
      (dotProduct (pcN5 B G γ w.1 w.2) (pcN5 B G γ w.1 w.2))⁻¹ * (pcN5 B G γ w.1 w.2 i *
        (dotProduct (pcN5 B G γ w.1 w.2) (fun k => pcKm5 B γ.1 w.1 k j) - -pcPsi5 B G γ w.1 j)) -
      epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * dotProduct (pcN5 B G γ w.1 w.2) (pcN5 B G γ w.1 w.2) *
        (1 : Matrix (Fin 3) (Fin 3) ℝ) i j) (Ω ×ˢ Set.univ)
    exact (((hKw i j).neg).add (hinv.mul ((hNw i).mul (hdK.sub (hPw j).neg)))).sub
      ((contDiffOn_const.mul hdot).mul contDiffOn_const)

  have hZs : ContDiffOn ℝ ∞ (pcZ0_5 B G γ) Ω := by
    have hN0 : ∀ k, ContDiffOn ℝ ∞ (fun s => pcN5 B G γ s 0 k) Ω :=
      fun k => (hA k).sub (contDiffOn_const.mul (hPs k))
    have hpos : ∀ s ∈ Ω, 0 < pcN5 B G γ s 0 1 ^ 2 + pcN5 B G γ s 0 2 ^ 2 := by
      intro s hs
      have h1 : pcN5 B G γ s 0 1 ≠ 0 := by rw [hN1]; exact div_ne_zero hpang (hRC _ hs)
      have := pow_pos (abs_pos.mpr h1) 2
      rw [sq_abs] at this
      nlinarith [sq_nonneg (pcN5 B G γ s 0 2)]
    have hNt : ContDiffOn ℝ ∞ (pcNt5 B G γ) Ω :=
      (((hN0 1).pow 2).add ((hN0 2).pow 2)).sqrt (fun s hs => (hpos s hs).ne')
    have hNt0 : ∀ s ∈ Ω, pcNt5 B G γ s ≠ 0 := fun s hs => (Real.sqrt_pos.mpr (hpos s hs)).ne'
    have hKa : ContDiffOn ℝ ∞ (pcKa5 B G γ) Ω := by
      rw [contDiffOn_pi]; intro i; fin_cases i
      · exact (contDiffOn_const : ContDiffOn ℝ ∞ (fun _ : ℝ × ℝ × ℝ => (0:ℝ)) Ω)
      · exact ((hN0 1).div hNt hNt0 : ContDiffOn ℝ ∞ (fun s => pcN5 B G γ s 0 1 / pcNt5 B G γ s) Ω)
      · exact ((hN0 2).div hNt hNt0 : ContDiffOn ℝ ∞ (fun s => pcN5 B G γ s 0 2 / pcNt5 B G γ s) Ω)
    have hKa' : ∀ k, ContDiffOn ℝ ∞ (fun s => pcKa5 B G γ s k) Ω := contDiffOn_pi.1 hKa
    have hWv : ContDiffOn ℝ ∞ (fun s => (![0, pcKa5 B G γ s 2, -(pcKa5 B G γ s 1)] : Fin 3 → ℝ)) Ω := by
      rw [contDiffOn_pi]; intro i; fin_cases i
      · exact (contDiffOn_const : ContDiffOn ℝ ∞ (fun _ : ℝ × ℝ × ℝ => (0:ℝ)) Ω)
      · exact (hKa' 2 : ContDiffOn ℝ ∞ (fun s => pcKa5 B G γ s 2) Ω)
      · exact ((hKa' 1).neg : ContDiffOn ℝ ∞ (fun s => -pcKa5 B G γ s 1) Ω)
    exact (contDiffOn_const (c := Penv5 B G γ 0)).smul ((contDiffOn_const.sub (((hN0 0).div hNt hNt0).smul hKa)).add
      ((contDiffOn_const (c := (1 * c0f5 B G γ * Real.sqrt (1 + sco B G γ 0 ^ 2) : ℝ))).smul hWv))

  have hfrac : ∀ f : ℝ × ℝ, |lamR f| ≤ G.r0 → |lamT f| ≤ G.r0 → |f.1| < 1/2 ∧ |f.2| < 1/2 := by
    intro f h1 h2
    have e1 : lamR f + bgc * lamT f = f.1 := by
      unfold lamR lamT; field_simp; ring
    have e2 : -bgc * lamR f + lamT f = f.2 := by
      unfold lamR lamT; field_simp; ring
    obtain ⟨a1, a2⟩ := abs_le.mp h1
    obtain ⟨b1, b2⟩ := abs_le.mp h2
    have k1 := mul_nonneg hbgc0.le (sub_nonneg.2 a2)
    have k2 := mul_nonneg hbgc0.le (show 0 ≤ lamR f + G.r0 by linarith)
    have k3 := mul_nonneg hbgc0.le (sub_nonneg.2 b2)
    have k4 := mul_nonneg hbgc0.le (show 0 ≤ lamT f + G.r0 by linarith)
    have k5 := mul_nonneg (sub_nonneg.2 hbgc1.le) hr0.le
    rw [← e1, ← e2]
    refine ⟨abs_lt.mpr ⟨?_, ?_⟩, abs_lt.mpr ⟨?_, ?_⟩⟩ <;> nlinarith
  have hs1 : ∀ Y : ℝ × ℝ, inRect B.h γ (G.ctr γ) G.r0 Y → ∃ (U : Set (ℝ × ℝ)) (C : ℝ), IsOpen U ∧ Y ∈ U ∧
      ∀ Y' ∈ U, vco B.h G.r0 γ (G.ctr γ) Y' = (Tgc ^ bandIdx B.h γ.1 * lamT Y' + C) / cib B.h γ.1 := by
    intro Y hR
    obtain ⟨hf1, hf2⟩ := hfrac _ hR.1 hR.2
    refine ⟨{Y' | |(Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).1 -
          ((round (Jpow (bandIdx B.h γ.1) Y - G.ctr γ).1 : ℤ) : ℝ)| < 1/2 ∧
        |(Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).2 - ((round (Jpow (bandIdx B.h γ.1) Y - G.ctr γ).2 : ℤ) : ℝ)| < 1/2},
      G.r0 - (bgc * ((G.ctr γ).1 + ((round (Jpow (bandIdx B.h γ.1) Y - G.ctr γ).1 : ℤ) : ℝ)) +
        ((G.ctr γ).2 + ((round (Jpow (bandIdx B.h γ.1) Y - G.ctr γ).2 : ℤ) : ℝ))) / (1 + bgc ^ 2),
      ?_, (show _ ∧ _ from ⟨hf1, hf2⟩), ?_⟩
    · have hJ : Continuous (fun Y' : ℝ × ℝ => Jpow (bandIdx B.h γ.1) Y' - G.ctr γ) := by
        unfold Jpow; fun_prop
      exact (isOpen_lt (continuous_abs.comp ((hJ.fst).sub continuous_const)) continuous_const).inter
        (isOpen_lt (continuous_abs.comp ((hJ.snd).sub continuous_const)) continuous_const)
    · rintro Y' ⟨h1, h2⟩
      have r1 : round (Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).1 = round (Jpow (bandIdx B.h γ.1) Y - G.ctr γ).1 := by
        rw [round_eq, Int.floor_eq_iff]; obtain ⟨a, b⟩ := abs_lt.mp h1; constructor <;> linarith
      have r2 : round (Jpow (bandIdx B.h γ.1) Y' - G.ctr γ).2 = round (Jpow (bandIdx B.h γ.1) Y - G.ctr γ).2 := by
        rw [round_eq, Int.floor_eq_iff]; obtain ⟨a, b⟩ := abs_lt.mp h2; constructor <;> linarith
      simp only [vco, etG, rectW, frac0, r1, r2]
      simp only [Jpow, lamT, vrv, vtv, Prod.fst_sub, Prod.snd_sub, Prod.fst_add, Prod.snd_add,
        Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
      field_simp
      ring

  let sl : Cyl →L[ℝ] ℝ × ℝ × ℝ :=
    (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))).prod
      (((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))).prod
        ((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))))))
  have hslA : ∀ η : Cyl, HasFDerivAt (fun x : Cyl => (x.1, x.2.1, x.2.2.1)) sl η := fun η => sl.hasFDerivAt
  let lT : ℝ × ℝ →L[ℝ] ℝ :=
    (1 + bgc ^ 2)⁻¹ • (bgc • ContinuousLinearMap.fst ℝ ℝ ℝ + ContinuousLinearMap.snd ℝ ℝ ℝ)
  let Yp : Cyl →L[ℝ] ℝ × ℝ := (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)).comp
    ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))))
  let VL : Cyl →L[ℝ] ℝ := (Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1) • (lT.comp Yp)
  have hVL : ∀ η : Cyl, VL η = Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1 * lamT η.2.2.2 := by
    intro η
    show Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1 * ((1 + bgc ^ 2)⁻¹ * (bgc * η.2.2.2.1 + η.2.2.2.2)) = _
    unfold lamT; ring
  have hcomp : ∀ (f : ℝ × ℝ × ℝ → ℝ) (η : Cyl), (η.1, η.2.1, η.2.2.1) ∈ Ω → ContDiffOn ℝ ∞ f Ω →
      ∀ d : Cyl, fderiv ℝ (fun η' : Cyl => f (η'.1, η'.2.1, η'.2.2.1)) η d =
        fderiv ℝ f (η.1, η.2.1, η.2.2.1) (d.1, d.2.1, d.2.2.1) := by
    intro f η hη h1 d
    have d1 := ((h1.contDiffAt (hΩ.mem_nhds hη)).differentiableAt (by simp)).hasFDerivAt
    have h' : HasFDerivAt (fun η' : Cyl => f (η'.1, η'.2.1, η'.2.2.1)) _ η := d1.comp η (hslA η)
    rw [h'.fderiv]
    rfl

  refine ⟨Mf, pcZ0_5 B G γ, hMs, hZs, ?_⟩
  intro ξ hξ hR
  have hs : (ξ.1, ξ.2.1, ξ.2.2.1) ∈ Ω := hξ
  obtain ⟨U, C, hU, hYU, hUv⟩ := hs1 ξ.2.2.2 hR
  have hV : ∀ η : Cyl, η.2.2.2 ∈ U → vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = VL η + C / cib B.h γ.1 := by
    intro η h; rw [hUv _ h, hVL]; ring
  have tmpl : ∀ (f1 f2 : ℝ × ℝ × ℝ → ℝ) (η : Cyl), (η.1, η.2.1, η.2.2.1) ∈ Ω → ContDiffOn ℝ ∞ f1 Ω →
      ContDiffOn ℝ ∞ f2 Ω → ∀ d : Cyl,
      fderiv ℝ (fun η' : Cyl => f1 (η'.1, η'.2.1, η'.2.2.1) - (VL η' + C / cib B.h γ.1) *
          f2 (η'.1, η'.2.1, η'.2.2.1)) η d =
        fderiv ℝ f1 (η.1, η.2.1, η.2.2.1) (d.1, d.2.1, d.2.2.1) - ((VL η + C / cib B.h γ.1) *
          fderiv ℝ f2 (η.1, η.2.1, η.2.2.1) (d.1, d.2.1, d.2.2.1) + f2 (η.1, η.2.1, η.2.2.1) * VL d) := by
    intro f1 f2 η hη h1 h2 d
    have d1 := ((h1.contDiffAt (hΩ.mem_nhds hη)).differentiableAt (by simp)).hasFDerivAt
    have d2 := ((h2.contDiffAt (hΩ.mem_nhds hη)).differentiableAt (by simp)).hasFDerivAt
    have h' : HasFDerivAt (fun η' : Cyl => f1 (η'.1, η'.2.1, η'.2.2.1) - (VL η' + C / cib B.h γ.1) *
          f2 (η'.1, η'.2.1, η'.2.2.1)) _ η :=
      (d1.comp η (hslA η)).sub ((VL.hasFDerivAt.add_const (C / cib B.h γ.1)).mul (d2.comp η (hslA η)))
    rw [h'.fderiv]
    rfl
  have hWo : ∀ η : Cyl, (η.1, η.2.1, η.2.2.1) ∈ Ω → η.2.2.2 ∈ U →
      {η' : Cyl | (η'.1, η'.2.1, η'.2.2.1) ∈ Ω ∧ η'.2.2.2 ∈ U} ∈ nhds η := by
    intro η hη hηU
    refine IsOpen.mem_nhds ?_ ⟨hη, hηU⟩
    exact (hΩ.preimage (show Continuous (fun η : Cyl => (η.1, η.2.1, η.2.2.1)) by fun_prop)).inter
      (hU.preimage (show Continuous (fun η : Cyl => η.2.2.2) by fun_prop))

  have hN : ∀ η : Cyl, (η.1, η.2.1, η.2.2.1) ∈ Ω → η.2.2.2 ∈ U →
      nPhi5 B G γ η = pcN5 B G γ (η.1, η.2.1, η.2.2.1) (vco B.h G.r0 γ (G.ctr γ) η.2.2.2) := by
    intro η hη hηU
    have hev : phiL5 B G γ =ᶠ[nhds η] (fun η' : Cyl => pcPhi1_5 B G γ (η'.1, η'.2.1, η'.2.2.1) -
        (VL η' + C / cib B.h γ.1) * pcPhi2_5 B G γ (η'.1, η'.2.1, η'.2.2.1)) :=
      Filter.eventuallyEq_of_mem (hWo η hη hηU) (fun η' hη' => by
        show pcPhi1_5 B G γ (η'.1, η'.2.1, η'.2.2.1) - vco B.h G.r0 γ (G.ctr γ) η'.2.2.2 *
          pcPhi2_5 B G γ (η'.1, η'.2.1, η'.2.2.1) = _
        rw [hV η' hη'.2])
    have hfd := hev.fderiv_eq (𝕜 := ℝ)
    have hv := hV η hηU
    have hVR : VL (1, 0, 0, (drx B.h * η.1 ^ (drx B.h - 1)) • vrv) = 0 := by
      rw [hVL]; show _ * lamT (_ • vrv) = 0; rw [hlamR, mul_zero]
    have hVZ : VL (0, 1, 0, 0) = 0 := by
      rw [hVL]; show _ * lamT (0 : ℝ × ℝ) = 0; simp [lamT]
    funext i
    fin_cases i
    · show Real.sqrt (Qb γ.1) * fderiv ℝ (phiL5 B G γ) η (1, 0, 0, (drx B.h * η.1 ^ (drx B.h - 1)) • vrv) =
        Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi1_5 B G γ) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) -
          vco B.h G.r0 γ (G.ctr γ) η.2.2.2 *
            (Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)))
      rw [hfd, tmpl _ _ η hη hP1on hP2, hVR, hv]
      dsimp only
      ring
    · show pang5 B G γ / pcRC5 γ.1 (η.1, η.2.1, η.2.2.1) =
        pang5 B G γ / pcRC5 γ.1 (η.1, η.2.1, η.2.2.1) - vco B.h G.r0 γ (G.ctr γ) η.2.2.2 * 0
      ring
    · show Real.sqrt (Qb γ.1) * fderiv ℝ (phiL5 B G γ) η (0, 1, 0, 0) =
        Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi1_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)) -
          vco B.h G.r0 γ (G.ctr γ) η.2.2.2 *
            (Real.sqrt (Qb γ.1) * fderiv ℝ (pcPhi2_5 B G γ) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)))
      rw [hfd, tmpl _ _ η hη hP1on hP2, hVZ, hv]
      dsimp only
      ring

  have hNP : nPhiP5 B G γ ξ = -pcPsi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) := by
    funext i
    have hev : (fun η => nPhi5 B G γ η i) =ᶠ[nhds ξ] (fun η' : Cyl => pcA5 B G γ (η'.1, η'.2.1, η'.2.2.1) i -
        (VL η' + C / cib B.h γ.1) * pcPsi5 B G γ (η'.1, η'.2.1, η'.2.2.1) i) :=
      Filter.eventuallyEq_of_mem (hWo ξ hs hYU) (fun η' hη' => by
        show nPhi5 B G γ η' i = _
        rw [hN η' hη'.1 hη'.2, hV η' hη'.2]; rfl)
    have hVd : VL (dVdir B.h γ.1) = 1 := by
      rw [hVL]
      show Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1 *
        lamT ((cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) • vtv) = 1
      rw [hlamV, zpow_neg]
      have e : Tgc ^ bandIdx B.h γ.1 / cib B.h γ.1 * (cib B.h γ.1 * (Tgc ^ bandIdx B.h γ.1)⁻¹) =
          (Tgc ^ bandIdx B.h γ.1 * (Tgc ^ bandIdx B.h γ.1)⁻¹) * (cib B.h γ.1 / cib B.h γ.1) := by ring
      rw [e, mul_inv_cancel₀ (zpow_ne_zero _ hT.ne'), div_self hci.ne', mul_one]
    have hd0 : ((dVdir B.h γ.1).1, (dVdir B.h γ.1).2.1, (dVdir B.h γ.1).2.2.1) = (0 : ℝ × ℝ × ℝ) := rfl
    show fderiv ℝ (fun η => nPhi5 B G γ η i) ξ (dVdir B.h γ.1) = -pcPsi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) i
    rw [hev.fderiv_eq, tmpl (fun s => pcA5 B G γ s i) (fun s => pcPsi5 B G γ s i) ξ hs (hA i) (hPs i),
      hVd, hd0, map_zero, map_zero]
    ring

  have hK : Kmat B G γ ξ = pcKm5 B γ.1 (ξ.1, ξ.2.1, ξ.2.2.1) := by
    have e1 : DrC B γ.1 (Fang B γ.1) ξ = Real.sqrt (Qb γ.1) *
        fderiv ℝ (pcFa5 B γ.1) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) :=
      congrArg (Real.sqrt (Qb γ.1) * ·) (hcomp (pcFa5 B γ.1) ξ hs hFa (1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv))
    have e2 : DrC B γ.1 (fun η => baseC B γ.1 η 2) ξ = Real.sqrt (Qb γ.1) *
        fderiv ℝ (pcB5 B γ.1 2) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) :=
      congrArg (Real.sqrt (Qb γ.1) * ·) (hcomp (pcB5 B γ.1 2) ξ hs (hb 2) (1, 0, 0, (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv))
    unfold Kmat
    rw [e1, e2]
    rfl
  have hNξ := hN ξ hs hYU
  refine ⟨fun z => ?_, fun hv => ?_⟩
  · have hM : pcM5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) =
        APhi5 B G γ ξ - dDamp5 B G γ ξ • (1 : Matrix (Fin 3) (Fin 3) ℝ) := by
      unfold pcM5 APhi5 dDamp5
      rw [hNξ, hNP, hK]
    show (pcM5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)).mulVec z = _
    rw [hM, Matrix.sub_mulVec]
    first
    | rw [Matrix.smul_mulVec_assoc, Matrix.one_mulVec]
    | rw [Matrix.smul_mulVec, Matrix.one_mulVec]
    | simp
  · rw [hv] at hNξ
    simp only [Bcol5, ntan5, hNξ, hv] <;> rfl

theorem linear_ode_global_exists : ∀ (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] (B : ℝ → E →L[ℝ] E) (g : ℝ → E) (x0 : E), Continuous B → Continuous g → ∃ y : ℝ → E, y 0 = x0 ∧ ∀ v : ℝ, HasDerivAt y (B v (y v) + g v) v :=
by
  intro E _ _ _ B g x0 hB hg
  have : CompleteSpace E := FiniteDimensional.complete ℝ E

  have retr : ∀ R : ℝ, 0 < R → ∃ ρ : E → E, (∀ x y, ‖ρ x - ρ y‖ ≤ 2 * ‖x - y‖) ∧
      (∀ x, ‖ρ x‖ ≤ ‖x‖) ∧ (∀ x, ‖ρ x‖ ≤ R) ∧ (∀ x, ‖x‖ ≤ R → ρ x = x) := by
    intro R hR
    refine ⟨fun x => (R / max ‖x‖ R) • x, ?_, ?_, ?_, ?_⟩
    · intro x y
      have hmx : 0 < max ‖x‖ R := lt_max_of_lt_right hR
      have hmy : 0 < max ‖y‖ R := lt_max_of_lt_right hR
      obtain ⟨a, ha⟩ : ∃ a : ℝ, a = R / max ‖x‖ R := ⟨_, rfl⟩
      obtain ⟨b, hb⟩ : ∃ b : ℝ, b = R / max ‖y‖ R := ⟨_, rfl⟩
      have ha0 : 0 ≤ a := by rw [ha]; exact div_nonneg hR.le hmx.le
      have ha1 : a ≤ 1 := by rw [ha]; exact (div_le_one hmx).2 (le_max_right _ _)
      have hyb : ‖y‖ ≤ max ‖y‖ R := le_max_left _ _
      have hab : |a - b| * ‖y‖ ≤ ‖x - y‖ := by
        have e : a - b = a * (max ‖y‖ R - max ‖x‖ R) / max ‖y‖ R := by
          rw [ha, hb]; field_simp
        have hm := abs_max_sub_max_le_abs ‖y‖ ‖x‖ R
        have hn := abs_norm_sub_norm_le y x
        rw [norm_sub_rev] at hn
        rw [e, abs_div, abs_mul, abs_of_nonneg ha0, abs_of_pos hmy]
        have e2 : a * |max ‖y‖ R - max ‖x‖ R| / max ‖y‖ R * ‖y‖ =
            (a * (‖y‖ / max ‖y‖ R)) * |max ‖y‖ R - max ‖x‖ R| := by ring
        rw [e2]
        have h1 : ‖y‖ / max ‖y‖ R ≤ 1 := (div_le_one hmy).2 hyb
        have h2 : 0 ≤ ‖y‖ / max ‖y‖ R := div_nonneg (norm_nonneg _) hmy.le
        have h3 : a * (‖y‖ / max ‖y‖ R) ≤ 1 := by nlinarith
        calc a * (‖y‖ / max ‖y‖ R) * |max ‖y‖ R - max ‖x‖ R|
            ≤ 1 * |max ‖y‖ R - max ‖x‖ R| := mul_le_mul_of_nonneg_right h3 (abs_nonneg _)
          _ ≤ ‖x - y‖ := by linarith
      have e2 : a • x - b • y = a • (x - y) + (a - b) • y := by
        rw [smul_sub, sub_smul]; abel
      show ‖(R / max ‖x‖ R) • x - (R / max ‖y‖ R) • y‖ ≤ 2 * ‖x - y‖
      rw [← ha, ← hb, e2]
      calc ‖a • (x - y) + (a - b) • y‖ ≤ ‖a • (x - y)‖ + ‖(a - b) • y‖ := norm_add_le _ _
        _ = a * ‖x - y‖ + |a - b| * ‖y‖ := by
            rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg ha0]
        _ ≤ 1 * ‖x - y‖ + ‖x - y‖ :=
            add_le_add (mul_le_mul_of_nonneg_right ha1 (norm_nonneg _)) hab
        _ = 2 * ‖x - y‖ := by ring
    · intro x
      have hmx : 0 < max ‖x‖ R := lt_max_of_lt_right hR
      show ‖(R / max ‖x‖ R) • x‖ ≤ ‖x‖
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (div_nonneg hR.le hmx.le)]
      have ha1 : R / max ‖x‖ R ≤ 1 := (div_le_one hmx).2 (le_max_right _ _)
      calc R / max ‖x‖ R * ‖x‖ ≤ 1 * ‖x‖ := mul_le_mul_of_nonneg_right ha1 (norm_nonneg _)
        _ = ‖x‖ := one_mul _
    · intro x
      have hmx : 0 < max ‖x‖ R := lt_max_of_lt_right hR
      show ‖(R / max ‖x‖ R) • x‖ ≤ R
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (div_nonneg hR.le hmx.le)]
      rw [div_mul_eq_mul_div, div_le_iff₀ hmx]
      exact mul_le_mul_of_nonneg_left (le_max_left _ _) hR.le
    · intro x hx
      show (R / max ‖x‖ R) • x = x
      rw [max_eq_right hx, div_self hR.ne', one_smul]

  have fwd : ∀ (r F : ℝ → E) (K ε T : ℝ), 0 ≤ K → 0 ≤ ε → 0 ≤ T →
      (∀ v ∈ Set.Icc (-T) T, HasDerivWithinAt r (F v) (Set.Icc (-T) T) v) →
      (∀ v ∈ Set.Icc (-T) T, ‖F v‖ ≤ K * ‖r v‖ + ε) →
      ∀ v ∈ Set.Icc (0:ℝ) T, ‖r v‖ ≤ (‖r 0‖ + ε * T) * Real.exp (K * T) := by
    intro r F K ε T hK hε hT hd hbd v hv
    have hcont : ContinuousOn r (Set.Icc 0 T) := fun x hx =>
      ((hd x ⟨by linarith [hx.1], hx.2⟩).continuousWithinAt).mono
        (Set.Icc_subset_Icc (by linarith) le_rfl)
    have h1 := norm_le_gronwallBound_of_norm_deriv_right_le (f := r) (f' := F)
      (δ := ‖r 0‖) (K := K) (ε := ε) (a := 0) (b := T) hcont
      (fun x hx => (hd x ⟨by linarith [hx.1], hx.2.le⟩).mono_of_mem_nhdsWithin
        (Icc_mem_nhdsGE_of_mem ⟨by linarith [hx.1], hx.2⟩)) le_rfl
      (fun x hx => hbd x ⟨by linarith [hx.1], hx.2.le⟩)
      v hv
    rw [sub_zero] at h1
    refine h1.trans ?_
    have hv0 : 0 ≤ v := hv.1
    have hvT : v ≤ T := hv.2
    have hδ : 0 ≤ ‖r 0‖ := norm_nonneg _
    have key : gronwallBound ‖r 0‖ K ε v ≤ (‖r 0‖ + ε * v) * Real.exp (K * v) := by
      rcases hK.eq_or_lt with h | h
      · subst h
        rw [gronwallBound_K0]
        simp
      · rw [gronwallBound_of_K_ne_0 h.ne']
        have hp := Real.exp_pos (K * v)
        have e1 : Real.exp (K * v) * Real.exp (-(K * v)) = 1 := by
          rw [← Real.exp_add]; simp
        have e2 := Real.add_one_le_exp (-(K * v))
        have e2' := mul_le_mul_of_nonneg_left e2 hp.le
        have e3 : Real.exp (K * v) - 1 ≤ K * v * Real.exp (K * v) := by
          nlinarith
        have hc : ε / K * K = ε := div_mul_cancel₀ ε h.ne'
        have e4 : ε / K * (Real.exp (K * v) - 1) ≤ ε * v * Real.exp (K * v) := by
          calc ε / K * (Real.exp (K * v) - 1) ≤ ε / K * (K * v * Real.exp (K * v)) :=
                mul_le_mul_of_nonneg_left e3 (div_nonneg hε h.le)
            _ = ε / K * K * (v * Real.exp (K * v)) := by ring
            _ = ε * v * Real.exp (K * v) := by rw [hc]; ring
        nlinarith
    refine key.trans ?_
    apply mul_le_mul
    · nlinarith
    · exact Real.exp_le_exp.mpr (by nlinarith)
    · exact (Real.exp_pos _).le
    · nlinarith

  have gron : ∀ (r F : ℝ → E) (K ε T : ℝ), 0 ≤ K → 0 ≤ ε → 0 ≤ T →
      (∀ v ∈ Set.Icc (-T) T, HasDerivWithinAt r (F v) (Set.Icc (-T) T) v) →
      (∀ v ∈ Set.Icc (-T) T, ‖F v‖ ≤ K * ‖r v‖ + ε) →
      ∀ v ∈ Set.Icc (-T) T, ‖r v‖ ≤ (‖r 0‖ + ε * T) * Real.exp (K * T) := by
    intro r F K ε T hK hε hT hd hbd v hv
    rcases le_or_gt 0 v with h0 | h0
    · exact fwd r F K ε T hK hε hT hd hbd v ⟨h0, hv.2⟩
    · have hmaps : Set.MapsTo (Neg.neg : ℝ → ℝ) (Set.Icc (-T) T) (Set.Icc (-T) T) :=
        fun u hu => ⟨by linarith [hu.2], by linarith [hu.1]⟩
      have hd' : ∀ u ∈ Set.Icc (-T) T, HasDerivWithinAt (fun u => r (-u))
          ((fun u => -F (-u)) u) (Set.Icc (-T) T) u := by
        intro u hu
        have h2 : HasDerivWithinAt (r ∘ Neg.neg) ((-1:ℝ) • F (-u)) (Set.Icc (-T) T) u :=
          (hd (-u) (hmaps hu)).scomp u (hasDerivWithinAt_neg u (Set.Icc (-T) T)) hmaps
        have h3 : (-1:ℝ) • F (-u) = -F (-u) := by simp
        rw [h3] at h2
        exact h2
      have hbd' : ∀ u ∈ Set.Icc (-T) T, ‖(fun u => -F (-u)) u‖ ≤
          K * ‖(fun u => r (-u)) u‖ + ε := by
        intro u hu
        simp only [norm_neg]
        exact hbd (-u) (hmaps hu)
      have := fwd (fun u => r (-u)) (fun u => -F (-u)) K ε T hK hε hT hd' hbd' (-v)
        ⟨by linarith, by linarith [hv.1]⟩
      simpa only [neg_neg, neg_zero] using this

  have exI : ∀ T : ℝ, 0 < T → ∃ α : ℝ → E, α 0 = x0 ∧
      ∀ t ∈ Set.Icc (-T) T, HasDerivWithinAt α (B t (α t) + g t) (Set.Icc (-T) T) t := by
    intro T hT
    obtain ⟨CB, hCB⟩ := (isCompact_Icc (a := -T) (b := T)).exists_bound_of_continuousOn
      hB.continuousOn
    obtain ⟨Cg, hCg⟩ := (isCompact_Icc (a := -T) (b := T)).exists_bound_of_continuousOn
      hg.continuousOn
    obtain ⟨K, hKdef⟩ : ∃ K : ℝ, K = max CB 0 + 1 := ⟨_, rfl⟩
    obtain ⟨G, hGdef⟩ : ∃ G : ℝ, G = max Cg 0 := ⟨_, rfl⟩
    have hK : 0 < K := by rw [hKdef]; linarith [le_max_right CB 0]
    have hG : 0 ≤ G := by rw [hGdef]; exact le_max_right _ _
    have hBK : ∀ t ∈ Set.Icc (-T) T, ‖B t‖ ≤ K := fun t ht => by
      rw [hKdef]; linarith [hCB t ht, le_max_left CB 0]
    have hgG : ∀ t ∈ Set.Icc (-T) T, ‖g t‖ ≤ G := fun t ht => by
      rw [hGdef]; exact (hCg t ht).trans (le_max_left _ _)
    obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = (‖x0‖ + G * T) * Real.exp (K * T) + 1 := ⟨_, rfl⟩
    have hR : 0 < R := by
      rw [hRdef]
      have h1 := Real.exp_pos (K * T)
      have h2 : 0 ≤ ‖x0‖ + G * T := add_nonneg (norm_nonneg _) (mul_nonneg hG hT.le)
      have h3 := mul_nonneg h2 h1.le
      linarith
    obtain ⟨ρ, hρL, hρn, hρR, hρid⟩ := retr R hR
    have hL0 : 0 ≤ K * R + G := add_nonneg (mul_nonneg hK.le hR.le) hG
    have t0mem : (0:ℝ) ∈ Set.Icc (-T) T := ⟨by linarith, hT.le⟩
    have hPL : IsPicardLindelof (fun t x => B t (ρ x) + g t) (⟨0, t0mem⟩ : Set.Icc (-T) T) x0
        ((K * R + G) * T).toNNReal 0 (K * R + G).toNNReal (2 * K).toNNReal := by
      apply IsPicardLindelof.mk
      · intro t ht
        apply LipschitzWith.lipschitzOnWith
        rw [lipschitzWith_iff_norm_sub_le]
        intro x y
        rw [Real.coe_toNNReal _ (by linarith)]
        show ‖B t (ρ x) + g t - (B t (ρ y) + g t)‖ ≤ 2 * K * ‖x - y‖
        rw [add_sub_add_right_eq_sub, ← map_sub]
        calc ‖B t (ρ x - ρ y)‖ ≤ ‖B t‖ * ‖ρ x - ρ y‖ := (B t).le_opNorm _
          _ ≤ K * (2 * ‖x - y‖) := mul_le_mul (hBK t ht) (hρL x y) (norm_nonneg _) hK.le
          _ = 2 * K * ‖x - y‖ := by ring
      · intro x _
        exact ((hB.clm_apply continuous_const).add hg).continuousOn
      · intro t ht x _
        rw [Real.coe_toNNReal _ hL0]
        calc ‖B t (ρ x) + g t‖ ≤ ‖B t (ρ x)‖ + ‖g t‖ := norm_add_le _ _
          _ ≤ ‖B t‖ * ‖ρ x‖ + ‖g t‖ := add_le_add ((B t).le_opNorm _) le_rfl
          _ ≤ K * R + G := add_le_add (mul_le_mul (hBK t ht) (hρR x) (norm_nonneg _) hK.le)
              (hgG t ht)
      · rw [Real.coe_toNNReal _ hL0, Real.coe_toNNReal _ (mul_nonneg hL0 hT.le)]
        have hmax : max (T - (0:ℝ)) ((0:ℝ) - -T) = T := by simp
        show (K * R + G) * max (T - (0:ℝ)) ((0:ℝ) - -T) ≤ (K * R + G) * T - ((0 : NNReal) : ℝ)
        rw [hmax, NNReal.coe_zero, sub_zero]
    obtain ⟨α, hα0, hα⟩ := hPL.exists_eq_forall_mem_Icc_hasDerivWithinAt₀
    have hα0' : α 0 = x0 := hα0
    have hbound := gron α (fun t => B t (ρ (α t)) + g t) K G T hK.le hG hT.le hα
      (fun t ht => by
        calc ‖B t (ρ (α t)) + g t‖ ≤ ‖B t (ρ (α t))‖ + ‖g t‖ := norm_add_le _ _
          _ ≤ ‖B t‖ * ‖ρ (α t)‖ + ‖g t‖ := add_le_add ((B t).le_opNorm _) le_rfl
          _ ≤ K * ‖α t‖ + G := add_le_add (mul_le_mul (hBK t ht) (hρn _) (norm_nonneg _) hK.le)
              (hgG t ht))
    rw [hα0'] at hbound
    refine ⟨α, hα0', fun t ht => ?_⟩
    have hin : ‖α t‖ ≤ R := by linarith [hbound t ht]
    have h2 : HasDerivWithinAt α (B t (ρ (α t)) + g t) (Set.Icc (-T) T) t := hα t ht
    rw [hρid _ hin] at h2
    exact h2

  have uniq : ∀ T : ℝ, 0 < T → ∀ α β : ℝ → E,
      (∀ t ∈ Set.Icc (-T) T, HasDerivWithinAt α (B t (α t) + g t) (Set.Icc (-T) T) t) →
      (∀ t ∈ Set.Icc (-T) T, HasDerivWithinAt β (B t (β t) + g t) (Set.Icc (-T) T) t) →
      α 0 = β 0 → ∀ t ∈ Set.Icc (-T) T, α t = β t := by
    intro T hT α β hα hβ h0
    obtain ⟨C, hC⟩ := (isCompact_Icc (a := -T) (b := T)).exists_bound_of_continuousOn
      hB.continuousOn
    have hlip : ∀ t ∈ Set.Ioo (-T) T,
        LipschitzOnWith C.toNNReal (fun x => B t x + g t) Set.univ := by
      intro t ht
      apply LipschitzWith.lipschitzOnWith
      rw [lipschitzWith_iff_norm_sub_le]
      intro x y
      show ‖B t x + g t - (B t y + g t)‖ ≤ (C.toNNReal : ℝ) * ‖x - y‖
      rw [add_sub_add_right_eq_sub, ← map_sub]
      exact ((B t).le_opNorm _).trans (mul_le_mul_of_nonneg_right
        ((hC t (Set.Ioo_subset_Icc_self ht)).trans (Real.le_coe_toNNReal C)) (norm_nonneg _))
    have hcα : ContinuousOn α (Set.Icc (-T) T) := fun t ht => (hα t ht).continuousWithinAt
    have hcβ : ContinuousOn β (Set.Icc (-T) T) := fun t ht => (hβ t ht).continuousWithinAt
    exact ODE_solution_unique_of_mem_Icc (v := fun t x => B t x + g t) (s := fun _ => Set.univ)
      hlip ⟨by linarith, hT⟩ hcα
      (fun t ht => (hα t (Set.Ioo_subset_Icc_self ht)).hasDerivAt (Icc_mem_nhds ht.1 ht.2))
      (fun _ _ => Set.mem_univ _) hcβ
      (fun t ht => (hβ t (Set.Ioo_subset_Icc_self ht)).hasDerivAt (Icc_mem_nhds ht.1 ht.2))
      (fun _ _ => Set.mem_univ _) h0

  choose α hα0 hα using fun n : ℕ => exI ((n:ℝ) + 1) (by positivity)
  have agree : ∀ n m : ℕ, n ≤ m → ∀ t : ℝ, |t| ≤ (n:ℝ) + 1 → α n t = α m t := by
    intro n m hnm t ht
    have hnm' : (n:ℝ) ≤ m := Nat.cast_le.mpr hnm
    have hsub : Set.Icc (-((n:ℝ) + 1)) ((n:ℝ) + 1) ⊆ Set.Icc (-((m:ℝ) + 1)) ((m:ℝ) + 1) :=
      Set.Icc_subset_Icc (by linarith) (by linarith)
    exact uniq ((n:ℝ) + 1) (by positivity) (α n) (α m) (hα n)
      (fun s hs => (hα m s (hsub hs)).mono hsub) ((hα0 n).trans (hα0 m).symm) t (abs_le.mp ht)
  refine ⟨fun t => α ⌈|t|⌉₊ t, hα0 _, fun v => ?_⟩
  obtain ⟨n0, hn0⟩ : ∃ n0 : ℕ, n0 = ⌈|v|⌉₊ := ⟨_, rfl⟩
  have hv : |v| ≤ (n0:ℝ) := by rw [hn0]; exact Nat.le_ceil _
  have hvlt := abs_lt.mp (show |v| < (n0:ℝ) + 1 by linarith)
  have hev : (fun t => α ⌈|t|⌉₊ t) =ᶠ[nhds v] α n0 := by
    filter_upwards [Ioo_mem_nhds hvlt.1 hvlt.2] with t ht
    have htl : |t| < (n0:ℝ) + 1 := abs_lt.mpr ht
    have hk : |t| ≤ ((⌈|t|⌉₊ : ℕ) : ℝ) := Nat.le_ceil _
    rcases le_total ⌈|t|⌉₊ n0 with h | h
    · exact agree _ _ h t (by linarith)
    · exact (agree _ _ h t htl.le).symm
  have hd : HasDerivAt (α n0) (B v (α n0 v) + g v) v :=
    (hα n0 v ⟨hvlt.1.le, hvlt.2.le⟩).hasDerivAt (Icc_mem_nhds hvlt.1 hvlt.2)
  show HasDerivAt (fun t => α ⌈|t|⌉₊ t) (B v (α ⌈|v|⌉₊ v) + g v) v
  rw [← hn0]
  exact hd.congr_of_eventuallyEq hev

theorem linear_ode_param_continuous : ∀ (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] (U : Set (ℝ × ℝ × ℝ)) (A : (ℝ × ℝ × ℝ) × ℝ → E →L[ℝ] E) (b : (ℝ × ℝ × ℝ) × ℝ → E) (z0 : ℝ × ℝ × ℝ → E) (z : ℝ × ℝ × ℝ → ℝ → E), IsOpen U → ContinuousOn A (U ×ˢ Set.univ) → ContinuousOn b (U ×ˢ Set.univ) → ContinuousOn z0 U → (∀ s ∈ U, z s 0 = z0 s ∧ ∀ v : ℝ, HasDerivAt (z s) (A (s, v) (z s v) + b (s, v)) v) → ContinuousOn (fun w : (ℝ × ℝ × ℝ) × ℝ => z w.1 w.2) (U ×ˢ Set.univ) :=
by
  intro E _ _ _ U A b z0 z hU hA hb hz0 hsol

  have fwd : ∀ (r : ℝ → E) (B : ℝ → E →L[ℝ] E) (g : ℝ → E) (K ε T : ℝ), 0 ≤ K → 0 ≤ ε → 0 ≤ T →
      (∀ v : ℝ, HasDerivAt r (B v (r v) + g v) v) → (∀ v ∈ Set.Icc (-T) T, ‖B v‖ ≤ K ∧ ‖g v‖ ≤ ε) →
      ∀ v ∈ Set.Icc (0:ℝ) T, ‖r v‖ ≤ (‖r 0‖ + ε * T) * Real.exp (K * T) := by
    intro r B g K ε T hK hε hT hd hbd v hv
    have hcont : ContinuousOn r (Set.Icc 0 T) := fun x _ => (hd x).continuousAt.continuousWithinAt
    have h1 := norm_le_gronwallBound_of_norm_deriv_right_le (f := r) (f' := fun x => B x (r x) + g x)
      (δ := ‖r 0‖) (K := K) (ε := ε) (a := 0) (b := T) hcont
      (fun x _ => (hd x).hasDerivWithinAt) le_rfl
      (fun x hx => by
        obtain ⟨hB, hg⟩ := hbd x ⟨by linarith [hx.1], hx.2.le⟩
        calc ‖B x (r x) + g x‖ ≤ ‖B x (r x)‖ + ‖g x‖ := norm_add_le _ _
          _ ≤ ‖B x‖ * ‖r x‖ + ‖g x‖ := add_le_add ((B x).le_opNorm _) le_rfl
          _ ≤ K * ‖r x‖ + ε := add_le_add (mul_le_mul_of_nonneg_right hB (norm_nonneg _)) hg)
      v hv
    rw [sub_zero] at h1
    refine h1.trans ?_
    have hv0 : 0 ≤ v := hv.1
    have hvT : v ≤ T := hv.2
    have hδ : 0 ≤ ‖r 0‖ := norm_nonneg _
    have key : gronwallBound ‖r 0‖ K ε v ≤ (‖r 0‖ + ε * v) * Real.exp (K * v) := by
      rcases hK.eq_or_lt with h | h
      · subst h
        rw [gronwallBound_K0]
        simp
      · rw [gronwallBound_of_K_ne_0 h.ne']
        have hp := Real.exp_pos (K * v)
        have e1 : Real.exp (K * v) * Real.exp (-(K * v)) = 1 := by
          rw [← Real.exp_add]; simp
        have e2 := Real.add_one_le_exp (-(K * v))
        have e2' := mul_le_mul_of_nonneg_left e2 hp.le
        have e3 : Real.exp (K * v) - 1 ≤ K * v * Real.exp (K * v) := by
          nlinarith
        have hc : ε / K * K = ε := div_mul_cancel₀ ε h.ne'
        have e4 : ε / K * (Real.exp (K * v) - 1) ≤ ε * v * Real.exp (K * v) := by
          calc ε / K * (Real.exp (K * v) - 1) ≤ ε / K * (K * v * Real.exp (K * v)) :=
                mul_le_mul_of_nonneg_left e3 (div_nonneg hε h.le)
            _ = ε / K * K * (v * Real.exp (K * v)) := by ring
            _ = ε * v * Real.exp (K * v) := by rw [hc]; ring
        nlinarith
    refine key.trans ?_
    apply mul_le_mul
    · nlinarith
    · exact Real.exp_le_exp.mpr (by nlinarith)
    · exact (Real.exp_pos _).le
    · nlinarith

  have gron : ∀ (r : ℝ → E) (B : ℝ → E →L[ℝ] E) (g : ℝ → E) (K ε T : ℝ), 0 ≤ K → 0 ≤ ε → 0 ≤ T →
      (∀ v : ℝ, HasDerivAt r (B v (r v) + g v) v) → (∀ v ∈ Set.Icc (-T) T, ‖B v‖ ≤ K ∧ ‖g v‖ ≤ ε) →
      ∀ v ∈ Set.Icc (-T) T, ‖r v‖ ≤ (‖r 0‖ + ε * T) * Real.exp (K * T) := by
    intro r B g K ε T hK hε hT hd hbd v hv
    rcases le_or_gt 0 v with h0 | h0
    · exact fwd r B g K ε T hK hε hT hd hbd v ⟨h0, hv.2⟩
    · have hd' : ∀ u : ℝ, HasDerivAt (fun u => r (-u))
          ((fun u => -B (-u)) u ((fun u => r (-u)) u) + (fun u => -g (-u)) u) u := by
        intro u
        have h2 : HasDerivAt (r ∘ Neg.neg) ((-1:ℝ) • (B (-u) (r (-u)) + g (-u))) u :=
          (hd (-u)).scomp u (hasDerivAt_neg u)
        have h3 : (-1:ℝ) • (B (-u) (r (-u)) + g (-u)) = (-B (-u)) (r (-u)) + -g (-u) := by
          simp
        rw [h3] at h2
        exact h2
      have hbd' : ∀ u ∈ Set.Icc (-T) T, ‖(fun u => -B (-u)) u‖ ≤ K ∧ ‖(fun u => -g (-u)) u‖ ≤ ε := by
        intro u hu
        simp only [norm_neg]
        exact hbd (-u) ⟨by linarith [hu.2], by linarith [hu.1]⟩
      have := fwd (fun u => r (-u)) (fun u => -B (-u)) (fun u => -g (-u)) K ε T hK hε hT hd' hbd' (-v)
        ⟨by linarith, by linarith [hv.1]⟩
      simpa only [neg_neg, neg_zero] using this

  have slice : ∀ (F : Type) [NormedAddCommGroup F] (f : (ℝ × ℝ × ℝ) × ℝ → F) (s0 : ℝ × ℝ × ℝ) (T : ℝ),
      ContinuousOn f (U ×ˢ Set.univ) → s0 ∈ U → ∃ ρ > 0, ∃ L : ℝ, 0 ≤ L ∧ Metric.ball s0 ρ ⊆ U ∧
      (∀ s ∈ Metric.ball s0 ρ, ∀ t ∈ Set.Icc (-T) T, ‖f (s, t)‖ ≤ L) ∧
      ∀ ε > 0, ∃ δ > 0, δ ≤ ρ ∧ ∀ s : ℝ × ℝ × ℝ, dist s s0 < δ → ∀ t ∈ Set.Icc (-T) T,
        ‖f (s, t) - f (s0, t)‖ < ε := by
    intro F _ f s0 T hf hs0
    obtain ⟨ρ₀, hρ₀, hball⟩ := Metric.isOpen_iff.mp hU s0 hs0
    have hρ : 0 < ρ₀ / 2 := by linarith
    have hcl : Metric.closedBall s0 (ρ₀ / 2) ⊆ U :=
      (Metric.closedBall_subset_ball (by linarith)).trans hball
    have hK : IsCompact (Metric.closedBall s0 (ρ₀ / 2) ×ˢ Set.Icc (-T) T) :=
      (isCompact_closedBall s0 _).prod isCompact_Icc
    have hsub : Metric.closedBall s0 (ρ₀ / 2) ×ˢ Set.Icc (-T) T ⊆ U ×ˢ Set.univ :=
      fun w hw => ⟨hcl hw.1, Set.mem_univ _⟩
    have hfK := hf.mono hsub
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hfK
    have huc := Metric.uniformContinuousOn_iff.mp (hK.uniformContinuousOn_of_continuous hfK)
    refine ⟨ρ₀ / 2, hρ, max C 0, le_max_right _ _, Metric.ball_subset_closedBall.trans hcl, ?_, ?_⟩
    · intro s hs t ht
      exact (hC (s, t) ⟨Metric.ball_subset_closedBall hs, ht⟩).trans (le_max_left _ _)
    · intro ε hε
      obtain ⟨δ₀, hδ₀, hδ⟩ := huc ε hε
      refine ⟨min δ₀ (ρ₀ / 2), lt_min hδ₀ hρ, min_le_right _ _, ?_⟩
      intro s hs t ht
      have hs' : s ∈ Metric.closedBall s0 (ρ₀ / 2) :=
        Metric.mem_closedBall.mpr (hs.le.trans (min_le_right _ _))
      have hs0' : s0 ∈ Metric.closedBall s0 (ρ₀ / 2) := Metric.mem_closedBall_self hρ.le
      have hdeq : dist (s, t) (s0, t) = dist s s0 := by
        rw [Prod.dist_eq]; simp [dist_nonneg]
      have hd : dist (s, t) (s0, t) < δ₀ := by
        rw [hdeq]; exact hs.trans_le (min_le_left _ _)
      have := hδ (s, t) ⟨hs', ht⟩ (s0, t) ⟨hs0', ht⟩ hd
      rwa [dist_eq_norm] at this

  intro w hw
  obtain ⟨s0, v0⟩ := w
  have hs0 : s0 ∈ U := hw.1
  apply ContinuousAt.continuousWithinAt
  rw [Metric.continuousAt_iff]
  intro η hη
  obtain ⟨T, hTdef⟩ : ∃ T : ℝ, T = |v0| + 1 := ⟨_, rfl⟩
  have hT : 0 ≤ T := by rw [hTdef]; positivity
  have hy : Continuous (z s0) :=
    continuous_iff_continuousAt.mpr (fun t => ((hsol s0 hs0).2 t).continuousAt)
  obtain ⟨Y0, hY0⟩ := (isCompact_Icc (a := -T) (b := T)).exists_bound_of_continuousOn hy.continuousOn
  obtain ⟨Y, hYdef⟩ : ∃ Y : ℝ, Y = max Y0 0 := ⟨_, rfl⟩
  have hY : 0 ≤ Y := by rw [hYdef]; exact le_max_right _ _
  have hYb : ∀ t ∈ Set.Icc (-T) T, ‖z s0 t‖ ≤ Y := fun t ht => by
    rw [hYdef]; exact (hY0 t ht).trans (le_max_left _ _)
  obtain ⟨ρA, hρA, L, hL, hballA, hLb, hAc⟩ := slice (E →L[ℝ] E) A s0 T hA hs0
  obtain ⟨_, _, _, _, _, _, hbc⟩ := slice E b s0 T hb hs0
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = 2 * (1 + (Y + 1) * T) * Real.exp (L * T) := ⟨_, rfl⟩
  have hD1 : 0 < 1 + (Y + 1) * T := by nlinarith
  have hD : 0 < D := by rw [hDdef]; exact mul_pos (mul_pos two_pos hD1) (Real.exp_pos _)
  obtain ⟨η', hη'def⟩ : ∃ η' : ℝ, η' = η / D := ⟨_, rfl⟩
  have hη' : 0 < η' := by rw [hη'def]; exact div_pos hη hD
  have hkey : (η' + η' * (Y + 1) * T) * Real.exp (L * T) = η / 2 := by
    have e : (η' + η' * (Y + 1) * T) * Real.exp (L * T) = η' * D / 2 := by rw [hDdef]; ring
    rw [e, hη'def, div_mul_cancel₀ η hD.ne']
  obtain ⟨δA, hδA, hδAρ, hδA'⟩ := hAc η' hη'
  obtain ⟨δb, hδb, -, hδb'⟩ := hbc η' hη'
  obtain ⟨δ0, hδ0, hδ0'⟩ := Metric.continuousAt_iff.mp (hz0.continuousAt (hU.mem_nhds hs0)) η' hη'
  obtain ⟨δt, hδt, hδt'⟩ := Metric.continuousAt_iff.mp hy.continuousAt (η / 2) (by linarith)
  refine ⟨min (min δA δb) (min δ0 (min δt 1)),
    lt_min (lt_min hδA hδb) (lt_min hδ0 (lt_min hδt one_pos)), ?_⟩
  rintro ⟨s, t⟩ hd
  rw [Prod.dist_eq] at hd
  have hds : dist s s0 < min (min δA δb) (min δ0 (min δt 1)) := lt_of_le_of_lt (le_max_left _ _) hd
  have hdt : dist t v0 < min (min δA δb) (min δ0 (min δt 1)) := lt_of_le_of_lt (le_max_right _ _) hd
  have hsA : dist s s0 < δA := hds.trans_le ((min_le_left _ _).trans (min_le_left _ _))
  have hsb : dist s s0 < δb := hds.trans_le ((min_le_left _ _).trans (min_le_right _ _))
  have hs00 : dist s s0 < δ0 := hds.trans_le ((min_le_right _ _).trans (min_le_left _ _))
  have htt : dist t v0 < δt :=
    hdt.trans_le ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _)))
  have ht1 : dist t v0 < 1 :=
    hdt.trans_le ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_right _ _)))
  have hsball : s ∈ Metric.ball s0 ρA := Metric.mem_ball.mpr (hsA.trans_le hδAρ)
  have hsU : s ∈ U := hballA hsball
  have htT : t ∈ Set.Icc (-T) T := by
    rw [Real.dist_eq] at ht1
    have h1 := abs_lt.mp ht1
    have h2 := neg_abs_le v0
    have h3 := le_abs_self v0
    constructor <;> linarith
  have hw' : ∀ u : ℝ, HasDerivAt (fun u => z s u - z s0 u)
      ((fun u => A (s, u)) u ((fun u => z s u - z s0 u) u) +
        (fun u => (A (s, u) - A (s0, u)) (z s0 u) + (b (s, u) - b (s0, u))) u) u := by
    intro u
    have h := ((hsol s hsU).2 u).sub ((hsol s0 hs0).2 u)
    refine h.congr_deriv ?_
    simp only [map_sub, sub_apply]
    abel
  have hgb : ∀ u ∈ Set.Icc (-T) T, ‖(fun u => A (s, u)) u‖ ≤ L ∧
      ‖(fun u => (A (s, u) - A (s0, u)) (z s0 u) + (b (s, u) - b (s0, u))) u‖ ≤ η' * (Y + 1) := by
    intro u hu
    refine ⟨hLb s hsball u hu, ?_⟩
    have e1 := (hδA' s hsA u hu).le
    have e2 := (hδb' s hsb u hu).le
    show ‖(A (s, u) - A (s0, u)) (z s0 u) + (b (s, u) - b (s0, u))‖ ≤ η' * (Y + 1)
    calc ‖(A (s, u) - A (s0, u)) (z s0 u) + (b (s, u) - b (s0, u))‖
        ≤ ‖(A (s, u) - A (s0, u)) (z s0 u)‖ + ‖b (s, u) - b (s0, u)‖ := norm_add_le _ _
      _ ≤ ‖A (s, u) - A (s0, u)‖ * ‖z s0 u‖ + ‖b (s, u) - b (s0, u)‖ :=
          add_le_add (ContinuousLinearMap.le_opNorm _ _) le_rfl
      _ ≤ η' * Y + η' := add_le_add (mul_le_mul e1 (hYb u hu) (norm_nonneg _) hη'.le) e2
      _ = η' * (Y + 1) := by ring
  have hG := gron (fun u => z s u - z s0 u) (fun u => A (s, u))
    (fun u => (A (s, u) - A (s0, u)) (z s0 u) + (b (s, u) - b (s0, u))) L (η' * (Y + 1)) T hL
    (mul_nonneg hη'.le (by linarith)) hT hw' hgb t htT
  have h0 : ‖z s 0 - z s0 0‖ ≤ η' := by
    rw [(hsol s hsU).1, (hsol s0 hs0).1, ← dist_eq_norm]
    exact (hδ0' hs00).le
  have hwt : ‖z s t - z s0 t‖ ≤ η / 2 := by
    rw [← hkey]
    calc ‖z s t - z s0 t‖ ≤ (‖z s 0 - z s0 0‖ + η' * (Y + 1) * T) * Real.exp (L * T) := hG
      _ ≤ (η' + η' * (Y + 1) * T) * Real.exp (L * T) :=
          mul_le_mul_of_nonneg_right (add_le_add h0 le_rfl) (Real.exp_pos _).le
  have hyt : ‖z s0 t - z s0 v0‖ < η / 2 := by
    rw [← dist_eq_norm]; exact hδt' htt
  show dist (z s t) (z s0 v0) < η
  rw [dist_eq_norm]
  calc ‖z s t - z s0 v0‖ = ‖(z s t - z s0 t) + (z s0 t - z s0 v0)‖ := by rw [sub_add_sub_cancel]
    _ ≤ ‖z s t - z s0 t‖ + ‖z s0 t - z s0 v0‖ := norm_add_le _ _
    _ < η / 2 + η / 2 := by linarith
    _ = η := by ring

theorem linear_ode_param_hasFDerivAt : ∀ (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] (U : Set (ℝ × ℝ × ℝ)) (A : (ℝ × ℝ × ℝ) × ℝ → E →L[ℝ] E) (b : (ℝ × ℝ × ℝ) × ℝ → E) (z0 : ℝ × ℝ × ℝ → E) (z : ℝ × ℝ × ℝ → ℝ → E) (W : ℝ × ℝ × ℝ → ℝ → (ℝ × ℝ × ℝ) →L[ℝ] E), IsOpen U → ContDiffOn ℝ 1 A (U ×ˢ Set.univ) → ContDiffOn ℝ 1 b (U ×ˢ Set.univ) → ContDiffOn ℝ 1 z0 U → ContinuousOn (fun w : (ℝ × ℝ × ℝ) × ℝ => z w.1 w.2) (U ×ˢ Set.univ) → ContinuousOn (fun w : (ℝ × ℝ × ℝ) × ℝ => W w.1 w.2) (U ×ˢ Set.univ) → (∀ s ∈ U, z s 0 = z0 s ∧ ∀ v : ℝ, HasDerivAt (z s) (A (s, v) (z s v) + b (s, v)) v) → (∀ s ∈ U, W s 0 = fderiv ℝ z0 s ∧ ∀ v : ℝ, HasDerivAt (W s) ((A (s, v)).comp (W s v) + (fderiv ℝ A (s, v) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ).flip (z s v) + fderiv ℝ b (s, v) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ) v) → ∀ s ∈ U, ∀ v : ℝ, HasFDerivAt (fun w : (ℝ × ℝ × ℝ) × ℝ => z w.1 w.2) ((W s v).comp (ContinuousLinearMap.fst ℝ (ℝ × ℝ × ℝ) ℝ) + (ContinuousLinearMap.snd ℝ (ℝ × ℝ × ℝ) ℝ).smulRight (A (s, v) (z s v) + b (s, v))) (s, v) :=
by
  intro E _ _ _ U A b z0 z W hU hA hb hz0 hzc _ hsol hWsol s hs v

  have fwd : ∀ (r : ℝ → E) (B : ℝ → E →L[ℝ] E) (g : ℝ → E) (K ε T : ℝ), 0 ≤ K → 0 ≤ ε → 0 ≤ T →
      (∀ v : ℝ, HasDerivAt r (B v (r v) + g v) v) → (∀ v ∈ Set.Icc (-T) T, ‖B v‖ ≤ K ∧ ‖g v‖ ≤ ε) →
      ∀ v ∈ Set.Icc (0:ℝ) T, ‖r v‖ ≤ (‖r 0‖ + ε * T) * Real.exp (K * T) := by
    intro r B g K ε T hK hε hT hd hbd v hv
    have hcont : ContinuousOn r (Set.Icc 0 T) := fun x _ => (hd x).continuousAt.continuousWithinAt
    have h1 := norm_le_gronwallBound_of_norm_deriv_right_le (f := r) (f' := fun x => B x (r x) + g x)
      (δ := ‖r 0‖) (K := K) (ε := ε) (a := 0) (b := T) hcont
      (fun x _ => (hd x).hasDerivWithinAt) le_rfl
      (fun x hx => by
        obtain ⟨hB, hg⟩ := hbd x ⟨by linarith [hx.1], hx.2.le⟩
        calc ‖B x (r x) + g x‖ ≤ ‖B x (r x)‖ + ‖g x‖ := norm_add_le _ _
          _ ≤ ‖B x‖ * ‖r x‖ + ‖g x‖ := add_le_add ((B x).le_opNorm _) le_rfl
          _ ≤ K * ‖r x‖ + ε := add_le_add (mul_le_mul_of_nonneg_right hB (norm_nonneg _)) hg)
      v hv
    rw [sub_zero] at h1
    refine h1.trans ?_
    have hv0 : 0 ≤ v := hv.1
    have hvT : v ≤ T := hv.2
    have hδ : 0 ≤ ‖r 0‖ := norm_nonneg _
    have key : gronwallBound ‖r 0‖ K ε v ≤ (‖r 0‖ + ε * v) * Real.exp (K * v) := by
      rcases hK.eq_or_lt with h | h
      · subst h
        rw [gronwallBound_K0]
        simp
      · rw [gronwallBound_of_K_ne_0 h.ne']
        have hp := Real.exp_pos (K * v)
        have e1 : Real.exp (K * v) * Real.exp (-(K * v)) = 1 := by
          rw [← Real.exp_add]; simp
        have e2 := Real.add_one_le_exp (-(K * v))
        have e2' := mul_le_mul_of_nonneg_left e2 hp.le
        have e3 : Real.exp (K * v) - 1 ≤ K * v * Real.exp (K * v) := by
          nlinarith
        have hc : ε / K * K = ε := div_mul_cancel₀ ε h.ne'
        have e4 : ε / K * (Real.exp (K * v) - 1) ≤ ε * v * Real.exp (K * v) := by
          calc ε / K * (Real.exp (K * v) - 1) ≤ ε / K * (K * v * Real.exp (K * v)) :=
                mul_le_mul_of_nonneg_left e3 (div_nonneg hε h.le)
            _ = ε / K * K * (v * Real.exp (K * v)) := by ring
            _ = ε * v * Real.exp (K * v) := by rw [hc]; ring
        nlinarith
    refine key.trans ?_
    apply mul_le_mul
    · nlinarith
    · exact Real.exp_le_exp.mpr (by nlinarith)
    · exact (Real.exp_pos _).le
    · nlinarith

  have gron : ∀ (r : ℝ → E) (B : ℝ → E →L[ℝ] E) (g : ℝ → E) (K ε T : ℝ), 0 ≤ K → 0 ≤ ε → 0 ≤ T →
      (∀ v : ℝ, HasDerivAt r (B v (r v) + g v) v) → (∀ v ∈ Set.Icc (-T) T, ‖B v‖ ≤ K ∧ ‖g v‖ ≤ ε) →
      ∀ v ∈ Set.Icc (-T) T, ‖r v‖ ≤ (‖r 0‖ + ε * T) * Real.exp (K * T) := by
    intro r B g K ε T hK hε hT hd hbd v hv
    rcases le_or_gt 0 v with h0 | h0
    · exact fwd r B g K ε T hK hε hT hd hbd v ⟨h0, hv.2⟩
    · have hd' : ∀ u : ℝ, HasDerivAt (fun u => r (-u))
          ((fun u => -B (-u)) u ((fun u => r (-u)) u) + (fun u => -g (-u)) u) u := by
        intro u
        have h2 : HasDerivAt (r ∘ Neg.neg) ((-1:ℝ) • (B (-u) (r (-u)) + g (-u))) u :=
          (hd (-u)).scomp u (hasDerivAt_neg u)
        have h3 : (-1:ℝ) • (B (-u) (r (-u)) + g (-u)) = (-B (-u)) (r (-u)) + -g (-u) := by
          simp
        rw [h3] at h2
        exact h2
      have hbd' : ∀ u ∈ Set.Icc (-T) T, ‖(fun u => -B (-u)) u‖ ≤ K ∧ ‖(fun u => -g (-u)) u‖ ≤ ε := by
        intro u hu
        simp only [norm_neg]
        exact hbd (-u) ⟨by linarith [hu.2], by linarith [hu.1]⟩
      have := fwd (fun u => r (-u)) (fun u => -B (-u)) (fun u => -g (-u)) K ε T hK hε hT hd' hbd' (-v)
        ⟨by linarith, by linarith [hv.1]⟩
      simpa only [neg_neg, neg_zero] using this

  obtain ⟨ρ₀, hρ₀, hball⟩ := Metric.isOpen_iff.mp hU s hs
  obtain ⟨T, hTdef⟩ : ∃ T : ℝ, T = |v| + 1 := ⟨_, rfl⟩
  have hT : 0 ≤ T := by rw [hTdef]; positivity
  have hρ : 0 < ρ₀ / 2 := by linarith
  have hcl : Metric.closedBall s (ρ₀ / 2) ⊆ U :=
    (Metric.closedBall_subset_ball (by linarith)).trans hball
  have hKc : IsCompact (Metric.closedBall s (ρ₀ / 2) ×ˢ Set.Icc (-T) T) :=
    (isCompact_closedBall s _).prod isCompact_Icc
  have hKsub : Metric.closedBall s (ρ₀ / 2) ×ˢ Set.Icc (-T) T ⊆ U ×ˢ Set.univ :=
    fun w hw => ⟨hcl hw.1, Set.mem_univ _⟩
  have hO : IsOpen (U ×ˢ (Set.univ : Set ℝ)) := hU.prod isOpen_univ
  have hmemK : ∀ (h : ℝ × ℝ × ℝ) (t : ℝ), ‖h‖ ≤ ρ₀ / 2 → t ∈ Set.Icc (-T) T →
      ((s + h, t) : (ℝ × ℝ × ℝ) × ℝ) ∈ Metric.closedBall s (ρ₀ / 2) ×ˢ Set.Icc (-T) T := by
    intro h t hh ht
    refine ⟨?_, ht⟩
    rw [Metric.mem_closedBall, dist_eq_norm, add_sub_cancel_left]
    exact hh
  have hs0K : ∀ t : ℝ, t ∈ Set.Icc (-T) T →
      ((s, t) : (ℝ × ℝ × ℝ) × ℝ) ∈ Metric.closedBall s (ρ₀ / 2) ×ˢ Set.Icc (-T) T :=
    fun t ht => ⟨Metric.mem_closedBall_self hρ.le, ht⟩
  have hdistK : ∀ (h : ℝ × ℝ × ℝ) (u : ℝ), dist ((s + h, u) : (ℝ × ℝ × ℝ) × ℝ) (s, u) = ‖h‖ := by
    intro h u
    rw [Prod.dist_eq]
    simp only [dist_self, dist_eq_norm, add_sub_cancel_left]
    exact max_eq_left (norm_nonneg _)

  have c2 : ∀ (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] (G : (ℝ × ℝ × ℝ) × ℝ → F),
      ContDiffOn ℝ 1 G (U ×ˢ Set.univ) → ∃ C : ℝ, 0 ≤ C ∧ ∀ η : ℝ, 0 < η → ∃ δ : ℝ, 0 < δ ∧
        ∀ (h : ℝ × ℝ × ℝ) (t : ℝ), ‖h‖ < δ → t ∈ Set.Icc (-T) T →
          ‖G (s + h, t) - G (s, t)‖ ≤ C * ‖h‖ ∧
          ‖G (s + h, t) - G (s, t) - (fderiv ℝ G (s, t) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ) h‖
            ≤ η * ‖h‖ := by
    intro F _ _ G hG
    have hdiff : ∀ w ∈ U ×ˢ (Set.univ : Set ℝ), HasFDerivAt G (fderiv ℝ G w) w := fun w hw =>
      (((hG.differentiableOn one_ne_zero) w hw).differentiableAt (hO.mem_nhds hw)).hasFDerivAt
    have hDc : ContinuousOn (fun w => fderiv ℝ G w ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ)
        (U ×ˢ Set.univ) :=
      (hG.continuousOn_fderiv_of_isOpen hO le_rfl).clm_comp continuousOn_const
    have hDK := hDc.mono hKsub
    obtain ⟨C₀, hC₀⟩ := hKc.exists_bound_of_continuousOn hDK
    have huc := Metric.uniformContinuousOn_iff.mp (hKc.uniformContinuousOn_of_continuous hDK)
    have hslice : ∀ (t : ℝ) (x : ℝ × ℝ × ℝ), ‖x‖ ≤ ρ₀ / 2 → t ∈ Set.Icc (-T) T →
        HasFDerivAt (fun x' : ℝ × ℝ × ℝ => G (s + x', t))
          (fderiv ℝ G (s + x, t) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ) x := by
      intro t x hx ht
      have h1 : HasFDerivAt (fun x' : ℝ × ℝ × ℝ => ((s + x', t) : (ℝ × ℝ × ℝ) × ℝ))
          (ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ) x :=
        ((hasFDerivAt_id x).const_add s).prodMk (hasFDerivAt_const t x)
      exact (hdiff _ (hKsub (hmemK x t hx ht))).comp x h1
    refine ⟨max C₀ 0, le_max_right _ _, fun η hη => ?_⟩
    obtain ⟨δu, hδu, hδu'⟩ := huc η hη
    refine ⟨min (ρ₀ / 2) δu, lt_min hρ hδu, fun h t hh ht => ?_⟩
    have hhρ : ‖h‖ < ρ₀ / 2 := hh.trans_le (min_le_left _ _)
    have hhu : ‖h‖ < δu := hh.trans_le (min_le_right _ _)
    have hball' : ∀ x ∈ Metric.closedBall (0 : ℝ × ℝ × ℝ) ‖h‖, ‖x‖ ≤ ‖h‖ := fun x hx => by
      rwa [Metric.mem_closedBall, dist_zero_right] at hx
    have hderiv : ∀ x ∈ Metric.closedBall (0 : ℝ × ℝ × ℝ) ‖h‖,
        HasFDerivWithinAt (fun x' : ℝ × ℝ × ℝ => G (s + x', t))
          (fderiv ℝ G (s + x, t) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ)
          (Metric.closedBall 0 ‖h‖) x := fun x hx =>
      (hslice t x ((hball' x hx).trans hhρ.le) ht).hasFDerivWithinAt
    have h0mem : (0 : ℝ × ℝ × ℝ) ∈ Metric.closedBall (0 : ℝ × ℝ × ℝ) ‖h‖ :=
      Metric.mem_closedBall_self (norm_nonneg _)
    have hhmem : h ∈ Metric.closedBall (0 : ℝ × ℝ × ℝ) ‖h‖ := by
      rw [Metric.mem_closedBall, dist_zero_right]
    constructor
    · have hbound : ∀ x ∈ Metric.closedBall (0 : ℝ × ℝ × ℝ) ‖h‖,
          ‖fderiv ℝ G (s + x, t) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ‖ ≤ max C₀ 0 :=
        fun x hx => (hC₀ _ (hmemK x t ((hball' x hx).trans hhρ.le) ht)).trans (le_max_left _ _)
      have := Convex.norm_image_sub_le_of_norm_hasFDerivWithin_le hderiv hbound
        (convex_closedBall _ _) h0mem hhmem
      simpa only [add_zero, sub_zero] using this
    · have hbound : ∀ x ∈ Metric.closedBall (0 : ℝ × ℝ × ℝ) ‖h‖,
          ‖fderiv ℝ G (s + x, t) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ -
            fderiv ℝ G (s, t) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ‖ ≤ η := by
        intro x hx
        have hx1 := hball' x hx
        have hd : dist ((s + x, t) : (ℝ × ℝ × ℝ) × ℝ) (s, t) < δu := by
          rw [hdistK]; exact lt_of_le_of_lt hx1 hhu
        have := hδu' _ (hmemK x t (hx1.trans hhρ.le) ht) _ (hs0K t ht) hd
        rw [dist_eq_norm] at this
        exact this.le
      have := Convex.norm_image_sub_le_of_norm_hasFDerivWithin_le' hderiv hbound
        (convex_closedBall _ _) h0mem hhmem
      simpa only [add_zero, sub_zero] using this

  obtain ⟨CA, hCA, hcA⟩ := c2 (E →L[ℝ] E) A hA
  obtain ⟨_, _, hcb⟩ := c2 E b hb
  have hAc : Continuous (fun u : ℝ => A (s, u)) :=
    hA.continuousOn.comp_continuous (continuous_const.prodMk continuous_id)
      (fun u => ⟨hs, Set.mem_univ _⟩)
  obtain ⟨L0, hL0⟩ := (isCompact_Icc (a := -T) (b := T)).exists_bound_of_continuousOn hAc.continuousOn
  obtain ⟨L, hLdef⟩ : ∃ L : ℝ, L = max L0 0 := ⟨_, rfl⟩
  have hL : 0 ≤ L := by rw [hLdef]; exact le_max_right _ _
  have hLb : ∀ u ∈ Set.Icc (-T) T, ‖A (s, u)‖ ≤ L := fun u hu => by
    rw [hLdef]; exact (hL0 u hu).trans (le_max_left _ _)
  have hy : Continuous (z s) :=
    continuous_iff_continuousAt.mpr (fun t => ((hsol s hs).2 t).continuousAt)
  obtain ⟨Y0, hY0⟩ := (isCompact_Icc (a := -T) (b := T)).exists_bound_of_continuousOn hy.continuousOn
  obtain ⟨Y, hYdef⟩ : ∃ Y : ℝ, Y = max Y0 0 := ⟨_, rfl⟩
  have hY : 0 ≤ Y := by rw [hYdef]; exact le_max_right _ _
  have hYb : ∀ t ∈ Set.Icc (-T) T, ‖z s t‖ ≤ Y := fun t ht => by
    rw [hYdef]; exact (hY0 t ht).trans (le_max_left _ _)
  have hzK := hzc.mono hKsub
  have hzuc := Metric.uniformContinuousOn_iff.mp (hKc.uniformContinuousOn_of_continuous hzK)
  have hz0d : HasFDerivAt z0 (fderiv ℝ z0 s) s :=
    (((hz0.differentiableOn one_ne_zero) s hs).differentiableAt (hU.mem_nhds hs)).hasFDerivAt

  have hkey : ∀ η : ℝ, 0 < η → ∃ δ : ℝ, 0 < δ ∧ ∀ (h : ℝ × ℝ × ℝ) (t : ℝ), ‖h‖ < δ → |t - v| < δ →
      ‖z (s + h) t - z s t - W s t h‖ ≤ η * ‖h‖ := by
    intro η hη
    obtain ⟨C1, hC1def⟩ : ∃ C1 : ℝ, C1 = (1 + (CA + Y + 1) * T) * Real.exp (L * T) := ⟨_, rfl⟩
    have hC1 : 0 < C1 := by
      rw [hC1def]
      have : 0 < 1 + (CA + Y + 1) * T := by nlinarith
      exact mul_pos this (Real.exp_pos _)
    obtain ⟨η', hη'def⟩ : ∃ η' : ℝ, η' = η / C1 := ⟨_, rfl⟩
    have hη' : 0 < η' := by rw [hη'def]; exact div_pos hη hC1
    obtain ⟨δA, hδA, hδA'⟩ := hcA η' hη'
    obtain ⟨δb, hδb, hδb'⟩ := hcb η' hη'
    obtain ⟨δz, hδz, hδz'⟩ := hzuc η' hη'
    obtain ⟨δ₀, hδ₀, hδ₀'⟩ := Metric.eventually_nhds_iff.mp
      ((Asymptotics.isLittleO_iff.mp (hasFDerivAt_iff_isLittleO_nhds_zero.mp hz0d)) hη')
    refine ⟨min (min δA δb) (min (min δz δ₀) (min (ρ₀ / 2) 1)),
      lt_min (lt_min hδA hδb) (lt_min (lt_min hδz hδ₀) (lt_min hρ one_pos)), ?_⟩
    intro h t hh ht
    have hhA : ‖h‖ < δA := hh.trans_le ((min_le_left _ _).trans (min_le_left _ _))
    have hhb : ‖h‖ < δb := hh.trans_le ((min_le_left _ _).trans (min_le_right _ _))
    have hhz : ‖h‖ < δz :=
      hh.trans_le ((min_le_right _ _).trans ((min_le_left _ _).trans (min_le_left _ _)))
    have hh0 : ‖h‖ < δ₀ :=
      hh.trans_le ((min_le_right _ _).trans ((min_le_left _ _).trans (min_le_right _ _)))
    have hhρ : ‖h‖ < ρ₀ / 2 :=
      hh.trans_le ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _)))
    have ht1 : |t - v| < 1 :=
      ht.trans_le ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_right _ _)))
    have htT : t ∈ Set.Icc (-T) T := by
      have h1 := abs_lt.mp ht1
      have h2 := neg_abs_le v
      have h3 := le_abs_self v
      rw [hTdef]
      constructor <;> linarith
    have hsh : s + h ∈ U := hcl (by
      rw [Metric.mem_closedBall, dist_eq_norm, add_sub_cancel_left]; exact hhρ.le)
    obtain ⟨g, hgdef⟩ : ∃ g : ℝ → E, g = fun u =>
        (A (s + h, u) - A (s, u)) (z (s + h) u - z s u) +
        (A (s + h, u) - A (s, u) - (fderiv ℝ A (s, u) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ) h)
          (z s u) +
        (b (s + h, u) - b (s, u) - (fderiv ℝ b (s, u) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ) h) :=
      ⟨_, rfl⟩
    have hr : ∀ u : ℝ, HasDerivAt (fun u => z (s + h) u - z s u - W s u h)
        ((fun u => A (s, u)) u ((fun u => z (s + h) u - z s u - W s u h) u) + g u) u := by
      intro u
      have h1 := (hsol (s + h) hsh).2 u
      have h2 := (hsol s hs).2 u
      have h3 := ((hWsol s hs).2 u).clm_apply (hasDerivAt_const u h)
      refine ((h1.sub h2).sub h3).congr_deriv ?_
      rw [hgdef]
      simp only [map_sub, sub_apply, add_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearMap.flip_apply, map_zero, add_zero]
      abel
    have hgb : ∀ u ∈ Set.Icc (-T) T, ‖(fun u => A (s, u)) u‖ ≤ L ∧
        ‖g u‖ ≤ η' * (CA + Y + 1) * ‖h‖ := by
      intro u hu
      refine ⟨hLb u hu, ?_⟩
      obtain ⟨eA1, eA2⟩ := hδA' h u hhA hu
      obtain ⟨-, eb2⟩ := hδb' h u hhb hu
      have hdz : dist ((s + h, u) : (ℝ × ℝ × ℝ) × ℝ) (s, u) < δz := by rw [hdistK]; exact hhz
      have ez := hδz' _ (hmemK h u hhρ.le hu) _ (hs0K u hu) hdz
      rw [dist_eq_norm] at ez
      have ez' : ‖z (s + h) u - z s u‖ ≤ η' := ez.le
      rw [hgdef]
      calc ‖(A (s + h, u) - A (s, u)) (z (s + h) u - z s u) +
            (A (s + h, u) - A (s, u) - (fderiv ℝ A (s, u) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ) h)
              (z s u) +
            (b (s + h, u) - b (s, u) - (fderiv ℝ b (s, u) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ) h)‖
          ≤ ‖(A (s + h, u) - A (s, u)) (z (s + h) u - z s u)‖ +
            ‖(A (s + h, u) - A (s, u) - (fderiv ℝ A (s, u) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ) h)
              (z s u)‖ +
            ‖b (s + h, u) - b (s, u) - (fderiv ℝ b (s, u) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ) h‖ :=
            norm_add₃_le
        _ ≤ ‖A (s + h, u) - A (s, u)‖ * ‖z (s + h) u - z s u‖ +
            ‖A (s + h, u) - A (s, u) - (fderiv ℝ A (s, u) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ) h‖ *
              ‖z s u‖ +
            ‖b (s + h, u) - b (s, u) - (fderiv ℝ b (s, u) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ) h‖ :=
            add_le_add (add_le_add (ContinuousLinearMap.le_opNorm _ _)
              (ContinuousLinearMap.le_opNorm _ _)) le_rfl
        _ ≤ (CA * ‖h‖) * η' + (η' * ‖h‖) * Y + η' * ‖h‖ :=
            add_le_add (add_le_add
              (mul_le_mul eA1 ez' (norm_nonneg _) (mul_nonneg hCA (norm_nonneg _)))
              (mul_le_mul eA2 (hYb u hu) (norm_nonneg _) (mul_nonneg hη'.le (norm_nonneg _)))) eb2
        _ = η' * (CA + Y + 1) * ‖h‖ := by ring
    have hε : 0 ≤ η' * (CA + Y + 1) * ‖h‖ :=
      mul_nonneg (mul_nonneg hη'.le (by linarith)) (norm_nonneg _)
    have hG : ‖z (s + h) t - z s t - W s t h‖ ≤
        (‖z (s + h) 0 - z s 0 - W s 0 h‖ + η' * (CA + Y + 1) * ‖h‖ * T) * Real.exp (L * T) :=
      gron (fun u => z (s + h) u - z s u - W s u h) (fun u => A (s, u)) g L
        (η' * (CA + Y + 1) * ‖h‖) T hL hε hT hr hgb t htT
    have h0 : ‖z (s + h) 0 - z s 0 - W s 0 h‖ ≤ η' * ‖h‖ := by
      rw [(hsol (s + h) hsh).1, (hsol s hs).1, (hWsol s hs).1]
      have hd0 : dist h 0 < δ₀ := by rw [dist_zero_right]; exact hh0
      exact hδ₀' hd0
    calc ‖z (s + h) t - z s t - W s t h‖
        ≤ (‖z (s + h) 0 - z s 0 - W s 0 h‖ + η' * (CA + Y + 1) * ‖h‖ * T) * Real.exp (L * T) := hG
      _ ≤ (η' * ‖h‖ + η' * (CA + Y + 1) * ‖h‖ * T) * Real.exp (L * T) :=
          mul_le_mul_of_nonneg_right (by linarith) (Real.exp_pos _).le
      _ = η' * C1 * ‖h‖ := by rw [hC1def]; ring
      _ = η * ‖h‖ := by rw [hη'def, div_mul_cancel₀ η hC1.ne']

  have hWcont : ContinuousAt (W s) v := ((hWsol s hs).2 v).continuousAt
  have hzder : HasDerivAt (z s) (A (s, v) (z s v) + b (s, v)) v := (hsol s hs).2 v
  rw [hasFDerivAt_iff_isLittleO_nhds_zero, Asymptotics.isLittleO_iff]
  intro c hc
  have hc3 : 0 < c / 3 := by linarith
  obtain ⟨δ₁, hδ₁, hδ₁'⟩ := hkey (c / 3) hc3
  obtain ⟨δ₂, hδ₂, hδ₂'⟩ := Metric.continuousAt_iff.mp hWcont (c / 3) hc3
  obtain ⟨δ₃, hδ₃, hδ₃'⟩ := Metric.eventually_nhds_iff.mp
    ((Asymptotics.isLittleO_iff.mp (hasDerivAt_iff_isLittleO_nhds_zero.mp hzder)) hc3)
  rw [Metric.eventually_nhds_iff]
  refine ⟨min δ₁ (min δ₂ δ₃), lt_min hδ₁ (lt_min hδ₂ hδ₃), ?_⟩
  rintro ⟨h, k⟩ hp
  rw [dist_zero_right] at hp
  have hh : ‖h‖ ≤ ‖(h, k)‖ := norm_fst_le (h, k)
  have hk : ‖k‖ ≤ ‖(h, k)‖ := norm_snd_le (h, k)
  have hp1 : ‖(h, k)‖ < δ₁ := hp.trans_le (min_le_left _ _)
  have hp2 : ‖(h, k)‖ < δ₂ := hp.trans_le ((min_le_right _ _).trans (min_le_left _ _))
  have hp3 : ‖(h, k)‖ < δ₃ := hp.trans_le ((min_le_right _ _).trans (min_le_right _ _))
  have hkk : |v + k - v| = ‖k‖ := by rw [add_sub_cancel_left, Real.norm_eq_abs]
  have e1 := hδ₁' h (v + k) (lt_of_le_of_lt hh hp1) (by rw [hkk]; exact lt_of_le_of_lt hk hp1)
  have e2 : ‖W s (v + k) - W s v‖ < c / 3 := by
    rw [← dist_eq_norm]
    apply hδ₂'
    rw [Real.dist_eq, hkk]
    exact lt_of_le_of_lt hk hp2
  have e3 : ‖z s (v + k) - z s v - k • (A (s, v) (z s v) + b (s, v))‖ ≤ c / 3 * ‖k‖ := by
    have hd3 : dist k 0 < δ₃ := by rw [dist_zero_right]; exact lt_of_le_of_lt hk hp3
    exact hδ₃' hd3
  have e2' : ‖(W s (v + k) - W s v) h‖ ≤ c / 3 * ‖h‖ :=
    ((W s (v + k) - W s v).le_opNorm h).trans (mul_le_mul_of_nonneg_right e2.le (norm_nonneg _))
  have hid : z (s + h) (v + k) - z s v - (W s v h + k • (A (s, v) (z s v) + b (s, v))) =
      (z (s + h) (v + k) - z s (v + k) - W s (v + k) h) + (W s (v + k) - W s v) h +
        (z s (v + k) - z s v - k • (A (s, v) (z s v) + b (s, v))) := by
    rw [sub_apply]; abel
  show ‖z (s + h) (v + k) - z s v - (W s v h + k • (A (s, v) (z s v) + b (s, v)))‖ ≤ c * ‖(h, k)‖
  rw [hid]
  have m1 := mul_le_mul_of_nonneg_left hh hc3.le
  have m2 := mul_le_mul_of_nonneg_left hk hc3.le
  calc _ ≤ ‖z (s + h) (v + k) - z s (v + k) - W s (v + k) h‖ + ‖(W s (v + k) - W s v) h‖ +
        ‖z s (v + k) - z s v - k • (A (s, v) (z s v) + b (s, v))‖ := norm_add₃_le
    _ ≤ c / 3 * ‖h‖ + c / 3 * ‖h‖ + c / 3 * ‖k‖ := add_le_add (add_le_add e1 e2') e3
    _ ≤ c * ‖(h, k)‖ := by linarith

theorem linear_ode_param_smooth_v5 : ∀ (U : Set (ℝ × ℝ × ℝ)) (M : ℝ × ℝ × ℝ → ℝ → Fin 3 → Fin 3 → ℝ)
    (z0 : ℝ × ℝ × ℝ → Fin 3 → ℝ), IsOpen U →
    ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => M w.1 w.2) (U ×ˢ Set.univ) → ContDiffOn ℝ ∞ z0 U →
    ∃ z : ℝ × ℝ × ℝ → ℝ → Fin 3 → ℝ, ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => z w.1 w.2) (U ×ˢ Set.univ) ∧
      ∀ s ∈ U, z s 0 = z0 s ∧ ∀ v : ℝ, HasDerivAt (z s) (Matrix.mulVec (M s v) (z s v)) v :=
by
  intro U M z0 hU hM hz0
  have hO : IsOpen (U ×ˢ (Set.univ : Set ℝ)) := hU.prod isOpen_univ
  have Q : ∀ k : ℕ, ∀ (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
      (A : (ℝ × ℝ × ℝ) × ℝ → E →L[ℝ] E) (b : (ℝ × ℝ × ℝ) × ℝ → E) (y0 : ℝ × ℝ × ℝ → E)
      (z : ℝ × ℝ × ℝ → ℝ → E),
      ContDiffOn ℝ k A (U ×ˢ Set.univ) → ContDiffOn ℝ k b (U ×ˢ Set.univ) → ContDiffOn ℝ k y0 U →
      (∀ s ∈ U, z s 0 = y0 s ∧ ∀ v : ℝ, HasDerivAt (z s) (A (s, v) (z s v) + b (s, v)) v) →
      ContDiffOn ℝ k (fun w : (ℝ × ℝ × ℝ) × ℝ => z w.1 w.2) (U ×ˢ Set.univ) := by
    intro k
    induction k with
    | zero =>
      intro E _ _ _ A b y0 z hA hb hy0 hsol
      simp only [Nat.cast_zero, contDiffOn_zero] at hA hb hy0 ⊢
      exact linear_ode_param_continuous E U A b y0 z hU hA hb hy0 hsol
    | succ k ih =>
      intro E _ _ _ A b y0 z hA hb hy0 hsol
      rw [Nat.cast_succ] at hA hb hy0 ⊢
      have hle : (k : WithTop ℕ∞) ≤ (k : WithTop ℕ∞) + 1 := le_self_add
      have h1le : (1 : WithTop ℕ∞) ≤ (k : WithTop ℕ∞) + 1 := le_add_self

      have hz : ContDiffOn ℝ k (fun w : (ℝ × ℝ × ℝ) × ℝ => z w.1 w.2) (U ×ˢ Set.univ) :=
        ih E A b y0 z (hA.of_le hle) (hb.of_le hle) (hy0.of_le hle) hsol

      obtain ⟨A', hA'eq⟩ : ∃ A' : (ℝ × ℝ × ℝ) × ℝ → ((ℝ × ℝ × ℝ) →L[ℝ] E) →L[ℝ] ((ℝ × ℝ × ℝ) →L[ℝ] E),
          ∀ w, A' w = ContinuousLinearMap.compL ℝ (ℝ × ℝ × ℝ) E E (A w) := ⟨_, fun _ => rfl⟩
      obtain ⟨b', hb'eq⟩ : ∃ b' : (ℝ × ℝ × ℝ) × ℝ → ((ℝ × ℝ × ℝ) →L[ℝ] E),
          ∀ w, b' w = (fderiv ℝ A w ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ).flip (z w.1 w.2) +
            fderiv ℝ b w ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ := ⟨_, fun _ => rfl⟩
      have hA' : ContDiffOn ℝ k A' (U ×ˢ Set.univ) := by
        rw [contDiffOn_clm_apply]
        intro V
        refine ((hA.of_le hle).clm_comp (contDiffOn_const (c := V))).congr (fun w _ => ?_)
        rw [hA'eq]
        rfl
      have hb' : ContDiffOn ℝ k b' (U ×ˢ Set.univ) := by
        have hdA : ContDiffOn ℝ k (fun w => fderiv ℝ A w) (U ×ˢ Set.univ) := hA.fderiv_of_isOpen hO le_rfl
        have hdb : ContDiffOn ℝ k (fun w => fderiv ℝ b w) (U ×ˢ Set.univ) := hb.fderiv_of_isOpen hO le_rfl
        have h1 : ContDiffOn ℝ k (fun w => fderiv ℝ A w ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ)
            (U ×ˢ Set.univ) := hdA.clm_comp contDiffOn_const
        have h2 : ContDiffOn ℝ k (fun w => fderiv ℝ b w ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ)
            (U ×ˢ Set.univ) := hdb.clm_comp contDiffOn_const
        rw [contDiffOn_clm_apply]
        intro p
        have h3 := ((h1.clm_apply (contDiffOn_const (c := p))).clm_apply hz).add
          (h2.clm_apply (contDiffOn_const (c := p)))
        refine h3.congr (fun w _ => ?_)
        rw [hb'eq]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.flip_apply]

      have hW_ex : ∀ s, ∃ Ws : ℝ → ((ℝ × ℝ × ℝ) →L[ℝ] E), s ∈ U →
          (Ws 0 = fderiv ℝ y0 s ∧ ∀ v : ℝ, HasDerivAt Ws (A' (s, v) (Ws v) + b' (s, v)) v) := by
        intro s
        by_cases hs : s ∈ U
        · have hc : Continuous (fun t : ℝ => ((s, t) : (ℝ × ℝ × ℝ) × ℝ)) :=
            continuous_const.prodMk continuous_id
          have hmem : ∀ t : ℝ, ((s, t) : (ℝ × ℝ × ℝ) × ℝ) ∈ U ×ˢ (Set.univ : Set ℝ) :=
            fun t => ⟨hs, Set.mem_univ _⟩
          obtain ⟨y, hy0, hy⟩ := linear_ode_global_exists ((ℝ × ℝ × ℝ) →L[ℝ] E) (fun t => A' (s, t))
            (fun t => b' (s, t)) (fderiv ℝ y0 s) (hA'.continuousOn.comp_continuous hc hmem)
            (hb'.continuousOn.comp_continuous hc hmem)
          exact ⟨y, fun _ => ⟨hy0, hy⟩⟩
        · exact ⟨0, fun h => absurd h hs⟩
      choose W hW using hW_ex

      have hdy0 : ContDiffOn ℝ k (fun s => fderiv ℝ y0 s) U := hy0.fderiv_of_isOpen hU le_rfl
      have hWc : ContDiffOn ℝ k (fun w : (ℝ × ℝ × ℝ) × ℝ => W w.1 w.2) (U ×ˢ Set.univ) :=
        ih ((ℝ × ℝ × ℝ) →L[ℝ] E) A' b' (fun s => fderiv ℝ y0 s) W hA' hb' hdy0 (fun s hs => hW s hs)

      have hWsol : ∀ s ∈ U, W s 0 = fderiv ℝ y0 s ∧ ∀ v : ℝ, HasDerivAt (W s)
          ((A (s, v)).comp (W s v) + (fderiv ℝ A (s, v) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ).flip (z s v)
            + fderiv ℝ b (s, v) ∘L ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ) v := by
        intro s hs
        refine ⟨(hW s hs).1, fun v => ?_⟩
        have h := (hW s hs).2 v
        rw [hA'eq, hb'eq, ← add_assoc] at h
        exact h

      have hD : ∀ w ∈ U ×ˢ (Set.univ : Set ℝ), HasFDerivAt (fun w : (ℝ × ℝ × ℝ) × ℝ => z w.1 w.2)
          ((W w.1 w.2).comp (ContinuousLinearMap.fst ℝ (ℝ × ℝ × ℝ) ℝ) +
            (ContinuousLinearMap.snd ℝ (ℝ × ℝ × ℝ) ℝ).smulRight (A w (z w.1 w.2) + b w)) w := by
        rintro ⟨s, v⟩ ⟨hs, -⟩
        exact linear_ode_param_hasFDerivAt E U A b y0 z W hU (hA.of_le h1le) (hb.of_le h1le)
          (hy0.of_le h1le) hz.continuousOn hWc.continuousOn hsol hWsol s hs v

      have hDk : ContDiffOn ℝ k (fun w : (ℝ × ℝ × ℝ) × ℝ =>
          (W w.1 w.2).comp (ContinuousLinearMap.fst ℝ (ℝ × ℝ × ℝ) ℝ) +
            (ContinuousLinearMap.snd ℝ (ℝ × ℝ × ℝ) ℝ).smulRight (A w (z w.1 w.2) + b w)) (U ×ˢ Set.univ) :=
        (hWc.clm_comp contDiffOn_const).add
          (contDiffOn_const.smulRight (((hA.of_le hle).clm_apply hz).add (hb.of_le hle)))

      rw [contDiffOn_succ_iff_fderiv_of_isOpen hO]
      refine ⟨fun w hw => (hD w hw).differentiableAt.differentiableWithinAt, fun h => ?_, ?_⟩
      · exact absurd h (by simp)
      · exact hDk.congr (fun w hw => (hD w hw).fderiv)

  obtain ⟨A, hAeq⟩ : ∃ A : (ℝ × ℝ × ℝ) × ℝ → (Fin 3 → ℝ) →L[ℝ] (Fin 3 → ℝ),
      ∀ w y, A w y = Matrix.mulVec (M w.1 w.2) y :=
    ⟨fun w => LinearMap.toContinuousLinearMap (Matrix.mulVecLin (M w.1 w.2)), fun w y => rfl⟩
  have hAs : ContDiffOn ℝ ∞ A (U ×ˢ Set.univ) := by
    rw [contDiffOn_clm_apply]
    intro y
    simp only [hAeq]
    rw [contDiffOn_pi]
    intro i
    have hMij : ∀ i j, ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => M w.1 w.2 i j) (U ×ˢ Set.univ) :=
      fun i j => contDiffOn_pi.1 (contDiffOn_pi.1 hM i) j
    simp only [Matrix.mulVec, dotProduct]
    exact ContDiffOn.sum (fun j _ => (hMij i j).mul contDiffOn_const)
  have hz_ex : ∀ s, ∃ y : ℝ → (Fin 3 → ℝ), s ∈ U →
      (y 0 = z0 s ∧ ∀ v : ℝ, HasDerivAt y (A (s, v) (y v) + (0 : Fin 3 → ℝ)) v) := by
    intro s
    by_cases hs : s ∈ U
    · obtain ⟨y, h0, hy⟩ := linear_ode_global_exists (Fin 3 → ℝ) (fun t => A (s, t))
        (fun _ => (0 : Fin 3 → ℝ)) (z0 s)
        (hAs.continuousOn.comp_continuous (continuous_const.prodMk continuous_id)
          (fun t => ⟨hs, Set.mem_univ _⟩)) continuous_const
      exact ⟨y, fun _ => ⟨h0, hy⟩⟩
    · exact ⟨0, fun h => absurd h hs⟩
  choose z hz using hz_ex
  refine ⟨z, ?_, fun s hs => ⟨(hz s hs).1, fun v => ?_⟩⟩
  · rw [contDiffOn_infty]
    intro n
    exact Q n (Fin 3 → ℝ) A (fun _ => (0 : Fin 3 → ℝ)) z0 z (contDiffOn_infty.1 hAs n) contDiffOn_const
      (contDiffOn_infty.1 hz0 n) (fun s hs => hz s hs)
  · have h := (hz s hs).2 v
    rw [add_zero, hAeq] at h
    exact h

theorem correction_geometry_v5 : ∀ B : BG, B.ok → ∃ G : CorrGeom, GeomPrim5 B G :=
by
  intro B hB
  obtain ⟨_, _, hXa, hXam1, hm12, hm2Xb, -, -, -, -, -, -, -⟩ := hB.2.1
  have hXb : 0 < B.Xb := by linarith
  have hCr : (0:ℝ) < 600 * (1 + B.Xb) := by positivity
  obtain ⟨L₀, hL₀40, hrepS⟩ := geom_rep_choice_v5 B hB
  obtain ⟨L₁, us, ηm, hus, hηm, hcone⟩ := geom_cone_margin_v5 B hB (600 * (1 + B.Xb)) hCr
  obtain ⟨hΩ, hbase⟩ := geom_slow_base_smooth_v5 B hB

  have hrep_ex : ∀ γ : Lab, ∃ c : ℝ × ℝ × ℝ, L₀ ≤ γ.1 →
      (∃ ξ ∈ DomC B.h B.qB, etaL B.h γ ξ ≠ 0 ∧ B.Xa ≤ XC B.h ξ ∧ XC B.h ξ ≤ B.Xb) →
      B.Xa < c.1 ∧ c.1 < B.Xb ∧ |c.2.1| ≤ 1 - Sb γ.1 ^ (-3:ℤ) ∧ 1/2 ≤ c.2.2 ∧ c.2.2 ≤ 2 ∧
      ∀ ξ ∈ DomC B.h B.qB, etaL B.h γ ξ ≠ 0 →
        |XC B.h ξ - c.1| + |etaC B.h ξ - c.2.1| + |qC B.h ξ / Qb γ.1 - c.2.2| ≤
          600 * (1 + B.Xb) * Sb γ.1 ^ (-3:ℤ) := by
    intro γ
    by_cases hc : L₀ ≤ γ.1 ∧ (∃ ξ ∈ DomC B.h B.qB, etaL B.h γ ξ ≠ 0 ∧ B.Xa ≤ XC B.h ξ ∧ XC B.h ξ ≤ B.Xb)
    · obtain ⟨c, hc'⟩ := hrepS γ hc.1 hc.2
      exact ⟨c, fun _ _ => hc'⟩
    · exact ⟨0, fun h1 h2 => absurd ⟨h1, h2⟩ hc⟩
  choose rep hrep using hrep_ex
  obtain ⟨lmin, hlmin⟩ : ∃ n : ℕ, n = max 40 (max L₀ L₁) := ⟨_, rfl⟩
  have h40 : 40 ≤ lmin := by rw [hlmin]; exact le_max_left _ _
  have hL0 : L₀ ≤ lmin := by rw [hlmin]; exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hL1 : L₁ ≤ lmin := by rw [hlmin]; exact le_trans (le_max_right _ _) (le_max_right _ _)

  let G₀ : CorrGeom := ⟨lmin, 1/100000, geomCtr5, rep, us, 600 * (1 + B.Xb), fun _ _ _ => 0⟩
  have hr0pos : (0:ℝ) < G₀.r0 := by show (0:ℝ) < 1/100000; norm_num
  have hr0le : G₀.r0 ≤ 1/100 := by show (1/100000:ℝ) ≤ 1/100; norm_num

  have hz_ex : ∀ γ : Lab, ∃ z : ℝ × ℝ × ℝ → ℝ → (Fin 3 → ℝ),
      (¬ ActiveL4 B G₀ γ → ∀ s v, z s v = 0) ∧
      ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => z w.1 w.2)
        ({s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} ×ˢ Set.univ) ∧
      (ActiveL4 B G₀ γ → ∀ ξ ∈ DomC B.h B.qB, inRect B.h γ (G₀.ctr γ) G₀.r0 ξ.2.2.2 →
        HasDerivAt (z (ξ.1, ξ.2.1, ξ.2.2.1))
          ((APhi5 B G₀ γ ξ).mulVec (z (ξ.1, ξ.2.1, ξ.2.2.1) (vco B.h G₀.r0 γ (G₀.ctr γ) ξ.2.2.2))
            - dDamp5 B G₀ γ ξ • z (ξ.1, ξ.2.1, ξ.2.2.1) (vco B.h G₀.r0 γ (G₀.ctr γ) ξ.2.2.2))
          (vco B.h G₀.r0 γ (G₀.ctr γ) ξ.2.2.2) ∧
        (vco B.h G₀.r0 γ (G₀.ctr γ) ξ.2.2.2 = 0 →
          z (ξ.1, ξ.2.1, ξ.2.2.1) 0 = Penv5 B G₀ γ 0 • Bcol5 B G₀ γ ξ 1)) := by
    intro γ
    by_cases hact : ActiveL4 B G₀ γ
    · obtain ⟨M, z0, hM, hz0, hid⟩ := geom_pulse_coeff_v5 B G₀ γ hB hr0pos hr0le hΩ hbase
      obtain ⟨z, hzs, hz⟩ := linear_ode_param_smooth_v5 _ M z0 hΩ hM hz0
      refine ⟨z, fun h => absurd hact h, hzs, fun _ ξ hξ hr => ?_⟩
      have hs : (ξ.1, ξ.2.1, ξ.2.2.1) ∈
          {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := hξ
      obtain ⟨hz0s, hder⟩ := hz _ hs
      obtain ⟨hmul, hinit⟩ := hid ξ hξ hr
      refine ⟨?_, fun hv => ?_⟩
      · have h1 := hder (vco B.h G₀.r0 γ (G₀.ctr γ) ξ.2.2.2)
        rw [hmul] at h1
        exact h1
      · rw [hz0s]
        exact hinit hv
    · exact ⟨fun _ _ => 0, fun _ _ _ => rfl, contDiffOn_const, fun h => absurd h hact⟩
  choose z hz using hz_ex
  let G : CorrGeom := ⟨lmin, 1/100000, geomCtr5, rep, us, 600 * (1 + B.Xb), z⟩
  refine ⟨G, ?_⟩
  unfold GeomPrim5
  refine ⟨⟨hr0pos, hr0le, hus, hCr, h40⟩, ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro γ γ' hne h1 h2 hex
    exact geom_separation_v5 B G hB hr0pos (by show (1/100000:ℝ) ≤ 1/100000; exact le_rfl) h40
      (fun _ => rfl) γ γ' hne h1 h2 hex
  ·
    intro γ hγ
    obtain ⟨a1, a2, a3, a4, a5, a6⟩ := hrep γ (le_trans hL0 hγ.1) hγ.2
    exact ⟨a1.le, a2.le, a3, a4, a5, a6⟩
  ·
    refine ⟨ηm, hηm, fun γ hγ ξ hξ hη hX1 hX2 => ?_⟩
    obtain ⟨a1, a2, a3, a4, _, a6⟩ := hrep γ (le_trans hL0 hγ.1) hγ.2
    have hγ40 : (40:ℝ) ≤ (γ.1 : ℝ) := by exact_mod_cast le_trans h40 hγ.1
    have hS : 0 < Sb γ.1 := by unfold Sb; positivity
    have hSz : 0 < Sb γ.1 ^ (-3:ℤ) := zpow_pos hS _
    have hη1 : |(G.rep γ).2.1| < 1 := by
      show |(rep γ).2.1| < 1
      linarith
    have hρ : 0 < (G.rep γ).2.2 := by
      show 0 < (rep γ).2.2
      linarith
    have hclose : |XC B.h ξ - (G.rep γ).1| + |etaC B.h ξ - (G.rep γ).2.1| ≤
        600 * (1 + B.Xb) * Sb γ.1 ^ (-3:ℤ) :=
      le_trans (le_add_of_nonneg_right (abs_nonneg _)) (a6 ξ hξ hη)
    exact hcone G rfl γ (le_trans hL1 hγ.1) a1 a2 hη1 hρ ξ hξ hX1 hX2 hclose
  ·
    intro γ hγ s v
    exact (hz γ).1 hγ s v
  ·
    intro γ hγ ξ hξ _ hr
    exact (hz γ).2.2 hγ ξ hξ hr
  ·
    intro γ
    have e : {w : (ℝ × ℝ × ℝ) × ℝ | 0 < w.1.1 ∧ w.1.2.2 < 1 ∧ simScale B.h w.1.2.1 (1 - w.1.2.2) < B.qB} =
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} ×ˢ Set.univ :=
      Set.ext fun w => ⟨fun h => ⟨h, Set.mem_univ _⟩, fun h => h.1⟩
    rw [e]
    exact (hz γ).2.1

theorem rotavg_flat : ∀ (h qs : ℝ) (E : ℝ³ → ℝ → ℝ³), SimScaleProps h → 0 < qs →
    ContDiffOn ℝ ∞ (↿E) (simDomain h qs) →
    (∀ m N : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain h qs →
      ‖iteratedFDeriv ℝ m (↿E) (x, t)‖ ≤ C * simScale h (x 2) (1 - t) ^ (N : ℝ)) →
    ∀ m N : ℕ, ∃ C : ℝ, ∀ x t, (x, t) ∈ simDomain h qs →
      ‖iteratedFDeriv ℝ m (↿(fun y s => thAvgVec (fun x' t' (_ : ℝ × ℝ) => E x' t') y s 0)) (x, t)‖ ≤
        C * simScale h (x 2) (1 - t) ^ (N : ℝ) :=
by
  intro h qs E hS _hqs hE hflat m N

  set U := simDomain h qs with hUdef
  have hrot2 : ∀ (φ : ℝ) (v : ℝ³), (rotZ φ v) 2 = v 2 := by
    intro φ v; simp [rotZ]
  have hinv : ∀ (φ : ℝ) (v : ℝ³) (s : ℝ), (v, s) ∈ U → (rotZ φ v, s) ∈ U := by
    intro φ v s hv
    refine ⟨hv.1, ?_⟩
    show simScale h ((rotZ φ v) 2) (1 - s) < qs
    rw [hrot2]; exact hv.2
  have hUo : IsOpen U := by
    have hc : ContinuousOn (fun w : ℝ³ × ℝ => simScale h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} := by
      have hp : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) := by fun_prop
      exact hS.2.2.2.1.continuousOn.comp hp.continuousOn
        (fun w hw => ⟨mem_univ _, by simp only [mem_Ioi]; simp at hw; linarith⟩)
    exact hc.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) (isOpen_Iio (a := qs))

  have t1 : ContDiff ℝ ∞ (fun p : ℝ × (ℝ³ × ℝ) => rotZ p.1 p.2.1) := by
    unfold rotZ; fun_prop
  have t2 : ContDiff ℝ ∞ (fun p : ℝ × (ℝ³ × ℝ) => ((rotZ p.1 p.2.1, p.2.2) : ℝ³ × ℝ)) :=
    t1.prodMk (contDiff_snd.comp contDiff_snd)
  have t3 : ContDiff ℝ ∞ (fun q : ℝ × ℝ³ => rotZ (-q.1) q.2) := by
    unfold rotZ; fun_prop

  set G : ℝ × (ℝ³ × ℝ) → ℝ³ := fun p => rotZ (-p.1) (E (rotZ p.1 p.2.1) p.2.2) with hGdef
  have hG : ContDiffOn ℝ ∞ G (univ ×ˢ U) := by
    have hmaps : MapsTo (fun p : ℝ × (ℝ³ × ℝ) => ((rotZ p.1 p.2.1, p.2.2) : ℝ³ × ℝ)) (univ ×ˢ U) U :=
      fun p hp => hinv p.1 p.2.1 p.2.2 hp.2
    have h4 : ContDiffOn ℝ ∞ (fun p : ℝ × (ℝ³ × ℝ) => E (rotZ p.1 p.2.1) p.2.2) (univ ×ˢ U) :=
      hE.comp t2.contDiffOn hmaps
    have h5 : ContDiffOn ℝ ∞ (fun p : ℝ × (ℝ³ × ℝ) => ((p.1, E (rotZ p.1 p.2.1) p.2.2) : ℝ × ℝ³))
        (univ ×ˢ U) := contDiffOn_fst.prodMk h4
    have h6 := t3.comp_contDiffOn h5
    exact h6

  obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ → (ℝ³ ≃ₗᵢ[ℝ] ℝ³), ∀ φ v, ρ φ v = rotZ φ v :=
    ⟨fun φ =>
      { toFun := rotZ φ
        invFun := rotZ (-φ)
        map_add' := by
          intro u v; ext i; fin_cases i <;> simp [rotZ] <;> ring
        map_smul' := by
          intro c v; ext i; fin_cases i <;> simp [rotZ] <;> ring
        left_inv := by
          intro v; ext i; fin_cases i <;> simp [rotZ, Real.cos_neg, Real.sin_neg]
          · linear_combination (v 0) * Real.sin_sq_add_cos_sq φ
          · linear_combination (v 1) * Real.sin_sq_add_cos_sq φ
        right_inv := by
          intro v; ext i; fin_cases i <;> simp [rotZ, Real.cos_neg, Real.sin_neg]
          · linear_combination (v 0) * Real.sin_sq_add_cos_sq φ
          · linear_combination (v 1) * Real.sin_sq_add_cos_sq φ
        norm_map' := by
          intro v
          simp only [EuclideanSpace.norm_eq, Fin.sum_univ_three]
          congr 1
          simp [rotZ]
          linear_combination (v 0 ^ 2 + v 1 ^ 2) * Real.sin_sq_add_cos_sq φ }, fun _ _ => rfl⟩
  obtain ⟨τ, hτ⟩ : ∃ τ : ℝ → ((ℝ³ × ℝ) ≃ₗᵢ[ℝ] (ℝ³ × ℝ)), ∀ φ w, τ φ w = (rotZ φ w.1, w.2) :=
    ⟨fun φ =>
      { toLinearEquiv := (ρ φ).toLinearEquiv.prodCongr (LinearEquiv.refl ℝ ℝ)
        norm_map' := by
          intro w
          simp [Prod.norm_def] }, fun φ w => by simp [hρ]⟩
  have hs3 : ∀ (φ : ℝ) (w : ℝ³ × ℝ),
      ‖iteratedFDeriv ℝ m (fun w' : ℝ³ × ℝ => G (φ, w')) w‖ =
        ‖iteratedFDeriv ℝ m (↿E) (rotZ φ w.1, w.2)‖ := by
    intro φ w
    have e : (fun w' : ℝ³ × ℝ => G (φ, w')) = (ρ (-φ)) ∘ ((↿E) ∘ (τ φ)) := by
      funext w'
      simp only [Function.comp, hρ, hτ, hGdef]
      rfl
    rw [e, LinearIsometryEquiv.norm_iteratedFDeriv_comp_left,
      LinearIsometryEquiv.norm_iteratedFDeriv_comp_right, hτ]

  have param_fderiv : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
      (H : ℝ × (ℝ³ × ℝ) → F), ContDiffOn ℝ ∞ H (univ ×ˢ U) →
      ContDiffOn ℝ ∞ (fun p : ℝ × (ℝ³ × ℝ) => fderiv ℝ (fun w' => H (p.1, w')) p.2) (univ ×ˢ U) := by
    intro F _ _ H hH p hp
    have hO : IsOpen ((univ : Set ℝ) ×ˢ U) := isOpen_univ.prod hUo
    have hHa : ContDiffAt ℝ ∞ H p := hH.contDiffAt (hO.mem_nhds hp)
    apply ContDiffAt.contDiffWithinAt
    have h1 : ContDiffAt ℝ ∞ (Function.uncurry (fun (q : ℝ × (ℝ³ × ℝ)) (w' : ℝ³ × ℝ) => H (q.1, w')))
        (p, p.2) := by
      have e : Function.uncurry (fun (q : ℝ × (ℝ³ × ℝ)) (w' : ℝ³ × ℝ) => H (q.1, w')) =
          H ∘ (fun z : (ℝ × (ℝ³ × ℝ)) × (ℝ³ × ℝ) => (z.1.1, z.2)) := rfl
      rw [e]
      apply ContDiffAt.comp (g := H) (p, p.2)
      · simpa using hHa
      · fun_prop
    exact ContDiffAt.fderiv (f := fun (q : ℝ × (ℝ³ × ℝ)) (w' : ℝ³ × ℝ) => H (q.1, w'))
      (g := Prod.snd) h1 contDiffAt_snd (le_of_eq ENat.coe_top_add_one)
  have param_hasFDeriv : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (H : ℝ × (ℝ³ × ℝ) → F), ContDiffOn ℝ ∞ H (univ ×ˢ U) → ∀ w ∈ U,
      HasFDerivAt (fun w' => ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w'))
        (∫ φ in (0:ℝ)..(2 * Real.pi), fderiv ℝ (fun w' => H (φ, w')) w) w := by
    intro F _ _ _ H hH w hw
    have hO : IsOpen ((univ : Set ℝ) ×ˢ U) := isOpen_univ.prod hUo
    have hHs := param_fderiv H hH
    obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hUo w hw
    set s := Metric.closedBall w (δ / 2) with hs
    have hsU : s ⊆ U := (Metric.closedBall_subset_ball (by linarith)).trans hball
    have hsn : s ∈ nhds w := Metric.closedBall_mem_nhds w (by linarith)
    have hK : IsCompact (Icc (0:ℝ) (2 * Real.pi) ×ˢ s) := isCompact_Icc.prod (isCompact_closedBall _ _)
    have hKsub : Icc (0:ℝ) (2 * Real.pi) ×ˢ s ⊆ univ ×ˢ U := fun z hz => ⟨mem_univ _, hsU hz.2⟩
    obtain ⟨B, hB⟩ := hK.exists_bound_of_continuousOn (hHs.continuousOn.mono hKsub)
    have hcontφ : ∀ x ∈ U, Continuous (fun φ : ℝ => H (φ, x)) := by
      intro x hx
      exact hH.continuousOn.comp_continuous (by fun_prop) (fun φ => ⟨mem_univ _, hx⟩)
    have hcontφ' : ∀ x ∈ U, Continuous (fun φ : ℝ => fderiv ℝ (fun w' => H (φ, w')) x) := by
      intro x hx
      exact hHs.continuousOn.comp_continuous (f := fun φ : ℝ => ((φ, x) : ℝ × (ℝ³ × ℝ))) (by fun_prop)
        (fun φ => ⟨mem_univ _, hx⟩)
    have hpi : (0:ℝ) ≤ 2 * Real.pi := by positivity
    refine intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := volume)
      (F := fun x φ => H (φ, x)) (F' := fun x φ => fderiv ℝ (fun w' => H (φ, w')) x)
      (bound := fun _ => B) hsn ?_ ?_ ?_ ?_ ?_ ?_
    · filter_upwards [hUo.mem_nhds hw] with x hx
      exact (hcontφ x hx).aestronglyMeasurable
    · exact (hcontφ w hw).intervalIntegrable _ _
    · exact (hcontφ' w hw).aestronglyMeasurable
    · refine ae_of_all _ (fun φ hφ x hx => ?_)
      rw [Set.uIoc_of_le hpi] at hφ
      exact hB (φ, x) ⟨Set.Ioc_subset_Icc_self hφ, hx⟩
    · exact intervalIntegrable_const
    · refine ae_of_all _ (fun φ _ x hx => ?_)
      have hxU : x ∈ U := hsU hx
      have hHa : ContDiffAt ℝ ∞ H (φ, x) := hH.contDiffAt (hO.mem_nhds ⟨mem_univ _, hxU⟩)
      have : ContDiffAt ℝ ∞ (fun w' => H (φ, w')) x :=
        hHa.comp x (by fun_prop : ContDiffAt ℝ ∞ (fun w' : ℝ³ × ℝ => ((φ, w') : ℝ × (ℝ³ × ℝ))) x)
      exact (this.differentiableAt (by simp)).hasFDerivAt
  have param_bound : ∀ (n : ℕ) {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
      [CompleteSpace F] (H : ℝ × (ℝ³ × ℝ) → F),
      ContDiffOn ℝ ∞ H (univ ×ˢ U) → ∀ w ∈ U, ∀ M : ℝ,
      (∀ φ : ℝ, ‖iteratedFDeriv ℝ n (fun w' => H (φ, w')) w‖ ≤ M) →
      ‖iteratedFDeriv ℝ n (fun w' => (2 * Real.pi)⁻¹ • ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w')) w‖ ≤ M := by
    intro n
    induction n with
    | zero =>
      intro F _ _ _ H _ w _ M hM
      simp only [norm_iteratedFDeriv_zero] at hM ⊢
      have hpi : (0:ℝ) < 2 * Real.pi := by positivity
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpi)]
      have h1 := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := 2 * Real.pi)
        (f := fun φ => H (φ, w)) (C := M) (fun φ _ => hM φ)
      rw [sub_zero, abs_of_pos hpi] at h1
      calc (2 * Real.pi)⁻¹ * ‖∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w)‖
          ≤ (2 * Real.pi)⁻¹ * (M * (2 * Real.pi)) :=
            mul_le_mul_of_nonneg_left h1 (inv_nonneg.mpr hpi.le)
        _ = M := by field_simp
    | succ n ih =>
      intro F _ _ _ H hH w hw M hM
      set Hs : ℝ × (ℝ³ × ℝ) → ((ℝ³ × ℝ) →L[ℝ] F) :=
        fun p => fderiv ℝ (fun w' => H (p.1, w')) p.2 with hHs_def
      have hHs : ContDiffOn ℝ ∞ Hs (univ ×ˢ U) := param_fderiv H hH
      have hMs : ∀ φ : ℝ, ‖iteratedFDeriv ℝ n (fun w' => Hs (φ, w')) w‖ ≤ M := by
        intro φ
        have : (fun w' => Hs (φ, w')) = fderiv ℝ (fun w' => H (φ, w')) := rfl
        rw [this, norm_iteratedFDeriv_fderiv]
        exact hM φ
      have hIH := ih Hs hHs w hw M hMs
      have hev : fderiv ℝ (fun w' => (2 * Real.pi)⁻¹ • ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w')) =ᶠ[nhds w]
          (fun w' => (2 * Real.pi)⁻¹ • ∫ φ in (0:ℝ)..(2 * Real.pi), Hs (φ, w')) := by
        filter_upwards [hUo.mem_nhds hw] with x hx
        exact ((param_hasFDeriv H hH x hx).const_smul ((2 * Real.pi)⁻¹)).fderiv
      rw [← norm_iteratedFDeriv_fderiv, (hev.iteratedFDeriv ℝ n).eq_of_nhds]
      exact hIH

  have hs2 : ∀ (x : ℝ³) (t : ℝ), Continuous (fun φ : ℝ => E (rotZ φ x) t) →
      thAvgVec (fun x' t' (_ : ℝ × ℝ) => E x' t') x t 0 =
        (2 * Real.pi)⁻¹ • ∫ φ in (0:ℝ)..(2 * Real.pi), rotZ (-φ) (E (rotZ φ x) t) := by
    intro x t hcont
    have hr0 : 0 ≤ rad x := Real.sqrt_nonneg _
    have hradrot : ∀ θ, rad (rotPt (rad x) θ (x 2)) = rad x := by
      intro θ
      have e0 : rotPt (rad x) θ (x 2) 0 = rad x * Real.cos θ := by simp [rotPt]
      have e1 : rotPt (rad x) θ (x 2) 1 = rad x * Real.sin θ := by simp [rotPt]
      have e : (rad x * Real.cos θ) ^ 2 + (rad x * Real.sin θ) ^ 2 = rad x ^ 2 := by
        linear_combination (rad x) ^ 2 * Real.cos_sq_add_sin_sq θ
      show Real.sqrt ((rotPt (rad x) θ (x 2)) 0 ^ 2 + (rotPt (rad x) θ (x 2)) 1 ^ 2) = rad x
      rw [e0, e1, e, Real.sqrt_sq hr0]
    have hunf : thAvgVec (fun x' t' (_ : ℝ × ℝ) => E x' t') x t 0 =
        (2 * Real.pi)⁻¹ • ((∫ θ in (0:ℝ)..(2 * Real.pi), inner ℝ (E (rotPt (rad x) θ (x 2)) t)
            (eR (rotPt (rad x) θ (x 2)))) • eR x +
          (∫ θ in (0:ℝ)..(2 * Real.pi), inner ℝ (E (rotPt (rad x) θ (x 2)) t)
            (eTh (rotPt (rad x) θ (x 2)))) • eTh x +
          (∫ θ in (0:ℝ)..(2 * Real.pi), inner ℝ (E (rotPt (rad x) θ (x 2)) t) eZ) • eZ) := by
      simp only [thAvgVec, cyl2cart, thA, frameAt, ptOf, smul_add, smul_smul]
      rfl
    rw [hunf]
    rcases eq_or_lt_of_le hr0 with hr | hr
    ·
      have hr' : rad x = 0 := hr.symm
      have hsq : x 0 ^ 2 + x 1 ^ 2 ≤ 0 := (Real.sqrt_eq_zero').mp hr'
      have hx0 : x 0 = 0 := by nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]
      have hx1 : x 1 = 0 := by nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]
      have hxr : ∀ φ, rotZ φ x = x := by
        intro φ; ext i; fin_cases i <;> simp [rotZ, hx0, hx1]
      have hP : ∀ θ, rotPt (rad x) θ (x 2) = x := by
        intro θ; ext i; fin_cases i <;> simp [rotPt, hr', hx0, hx1]
      have heR : eR x = 0 := by simp [eR, hr']
      have heTh : eTh x = 0 := by simp [eTh, hr']
      simp only [hP, hxr, heR, heTh, smul_zero, zero_add, intervalIntegral.integral_const]
      set v := E x t with hv
      have hdec : ∀ φ : ℝ, rotZ (-φ) v = Real.cos φ • (v 0 • EuclideanSpace.single 0 1 +
          v 1 • EuclideanSpace.single 1 1)
          + Real.sin φ • (v 1 • EuclideanSpace.single 0 1 - v 0 • EuclideanSpace.single 1 1) + v 2 • eZ := by
        intro φ; ext i; fin_cases i <;> simp [rotZ, eZ, Real.cos_neg, Real.sin_neg] <;> ring
      simp only [hdec]
      rw [intervalIntegral.integral_add, intervalIntegral.integral_add, intervalIntegral.integral_smul_const,
        intervalIntegral.integral_smul_const, intervalIntegral.integral_const, integral_cos, integral_sin]
      · ext i
        fin_cases i <;> simp [eZ, EuclideanSpace.inner_single_right]
      all_goals (apply Continuous.intervalIntegrable; fun_prop)
    ·
      have hnw : ‖(⟨x 0, x 1⟩ : ℂ)‖ = rad x := by
        rw [Complex.norm_def, Complex.normSq_mk, rad]; congr 1; ring
      obtain ⟨θ₀, hθ₀⟩ : ∃ θ₀, θ₀ = Complex.arg ⟨x 0, x 1⟩ := ⟨_, rfl⟩
      have hx0 : x 0 = rad x * Real.cos θ₀ := by
        have := Complex.norm_mul_cos_arg (⟨x 0, x 1⟩ : ℂ)
        rw [hnw, ← hθ₀] at this; exact this.symm
      have hx1 : x 1 = rad x * Real.sin θ₀ := by
        have := Complex.norm_mul_sin_arg (⟨x 0, x 1⟩ : ℂ)
        rw [hnw, ← hθ₀] at this; exact this.symm
      have hrot : ∀ θ, rotPt (rad x) θ (x 2) = rotZ (θ - θ₀) x := by
        intro θ
        ext i; fin_cases i
        · simp [rotPt, rotZ, Real.cos_sub, Real.sin_sub]
          rw [hx0, hx1]
          linear_combination (-(rad x * Real.cos θ)) * Real.sin_sq_add_cos_sq θ₀
        · simp [rotPt, rotZ, Real.cos_sub, Real.sin_sub]
          rw [hx0, hx1]
          linear_combination (-(rad x * Real.sin θ)) * Real.sin_sq_add_cos_sq θ₀
        · simp [rotPt, rotZ]
      have hrne : rad x ≠ 0 := hr.ne'
      have key : ∀ (w : ℝ³) (θ : ℝ),
          inner ℝ w (eR (rotPt (rad x) θ (x 2))) • eR x + inner ℝ w (eTh (rotPt (rad x) θ (x 2))) • eTh x
            + inner ℝ w eZ • eZ = rotZ (-(θ - θ₀)) w := by
        intro w θ
        simp only [eR, eTh, hradrot]
        ext i; fin_cases i
        · simp [radVec, azVec, rotPt, rotZ, eZ, inner_add_right, inner_smul_right, inner_neg_right,
            EuclideanSpace.inner_single_right, Real.cos_sub, Real.sin_sub]
          rw [hx0, hx1]
          field_simp
          ring
        · simp [radVec, azVec, rotPt, rotZ, eZ, inner_add_right, inner_smul_right, inner_neg_right,
            EuclideanSpace.inner_single_right, Real.cos_sub, Real.sin_sub]
          rw [hx0, hx1]
          field_simp
          ring
        · simp [radVec, azVec, rotPt, rotZ, eZ, inner_add_right, inner_smul_right, inner_neg_right,
            EuclideanSpace.inner_single_right]
      have hcE : Continuous (fun θ => E (rotPt (rad x) θ (x 2)) t) := by
        simp_rw [hrot]
        exact hcont.comp (continuous_id.sub continuous_const)
      have heRc : Continuous (fun θ => eR (rotPt (rad x) θ (x 2))) := by
        simp_rw [eR, hradrot]
        unfold radVec rotPt
        fun_prop
      have heThc : Continuous (fun θ => eTh (rotPt (rad x) θ (x 2))) := by
        simp_rw [eTh, hradrot]
        unfold azVec rotPt
        fun_prop
      have hc1 : Continuous (fun θ => inner ℝ (E (rotPt (rad x) θ (x 2)) t)
          (eR (rotPt (rad x) θ (x 2))) • eR x) :=
        Continuous.smul (Continuous.inner (𝕜 := ℝ) hcE heRc) (continuous_const : Continuous fun _ : ℝ => eR x)
      have hc2 : Continuous (fun θ => inner ℝ (E (rotPt (rad x) θ (x 2)) t)
          (eTh (rotPt (rad x) θ (x 2))) • eTh x) :=
        Continuous.smul (Continuous.inner (𝕜 := ℝ) hcE heThc) (continuous_const : Continuous fun _ : ℝ => eTh x)
      have hc3 : Continuous (fun θ => inner ℝ (E (rotPt (rad x) θ (x 2)) t) eZ • eZ) :=
        Continuous.smul (Continuous.inner (𝕜 := ℝ) hcE (continuous_const : Continuous fun _ : ℝ => eZ))
          (continuous_const : Continuous fun _ : ℝ => eZ)
      have hc12 : Continuous (fun θ => inner ℝ (E (rotPt (rad x) θ (x 2)) t)
          (eR (rotPt (rad x) θ (x 2))) • eR x +
          inner ℝ (E (rotPt (rad x) θ (x 2)) t) (eTh (rotPt (rad x) θ (x 2))) • eTh x) := hc1.add hc2
      rw [← intervalIntegral.integral_smul_const, ← intervalIntegral.integral_smul_const,
        ← intervalIntegral.integral_smul_const, ← intervalIntegral.integral_add (hc1.intervalIntegrable _ _)
          (hc2.intervalIntegrable _ _),
        ← intervalIntegral.integral_add (hc12.intervalIntegrable _ _) (hc3.intervalIntegrable _ _)]
      congr 1
      have hH : ∀ θ, inner ℝ (E (rotPt (rad x) θ (x 2)) t) (eR (rotPt (rad x) θ (x 2))) • eR x +
          inner ℝ (E (rotPt (rad x) θ (x 2)) t) (eTh (rotPt (rad x) θ (x 2))) • eTh x +
          inner ℝ (E (rotPt (rad x) θ (x 2)) t) eZ • eZ =
          (fun φ => rotZ (-φ) (E (rotZ φ x) t)) (θ - θ₀) := by
        intro θ
        rw [key]
        simp only [hrot]
      simp only [hH]
      have hper : Function.Periodic (fun φ => rotZ (-φ) (E (rotZ φ x) t)) (2 * Real.pi) := by
        intro φ
        have h1 : rotZ (φ + 2 * Real.pi) = rotZ φ := by
          funext y; simp [rotZ, Real.cos_add_two_pi, Real.sin_add_two_pi]
        have h2 : rotZ (-(φ + 2 * Real.pi)) = rotZ (-φ) := by
          rw [show -(φ + 2 * Real.pi) = -φ - 2 * Real.pi by ring]
          funext y; simp only [rotZ, Real.cos_sub_two_pi, Real.sin_sub_two_pi]
        simp only [h1, h2]
      rw [intervalIntegral.integral_comp_sub_right (fun φ => rotZ (-φ) (E (rotZ φ x) t)) θ₀]
      have := hper.intervalIntegral_add_eq (-θ₀) 0
      rw [show (0:ℝ) - θ₀ = -θ₀ by ring, show 2 * Real.pi - θ₀ = -θ₀ + 2 * Real.pi by ring, this, zero_add]

  obtain ⟨C, hC⟩ := hflat m N
  refine ⟨C, fun x t hxt => ?_⟩
  have hcirc : ∀ w ∈ U, Continuous (fun φ : ℝ => E (rotZ φ w.1) w.2) := by
    intro w hw
    have hc0 : Continuous (fun φ : ℝ => rotZ φ w.1) := by
      unfold rotZ; fun_prop
    have hc : Continuous (fun φ : ℝ => ((rotZ φ w.1, w.2) : ℝ³ × ℝ)) :=
      hc0.prodMk continuous_const
    have hres := hE.continuousOn.comp_continuous hc (fun φ => hinv φ w.1 w.2 hw)
    exact hres
  have hev : (↿(fun y s => thAvgVec (fun x' t' (_ : ℝ × ℝ) => E x' t') y s 0)) =ᶠ[nhds (x, t)]
      (fun w' => (2 * Real.pi)⁻¹ • ∫ φ in (0:ℝ)..(2 * Real.pi), G (φ, w')) := by
    filter_upwards [hUo.mem_nhds hxt] with w hw
    exact hs2 w.1 w.2 (hcirc w hw)
  rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
  refine param_bound m G hG (x, t) hxt _ (fun φ => ?_)
  rw [hs3 φ (x, t)]
  have := hC (rotZ φ x) t (hinv φ x t hxt)
  rw [hrot2] at this
  exact this

theorem bg_flow_props : ∀ B : BG, B.ok →
    IsOpen (simDomain B.h B.qB) ∧ ContDiffOn ℝ ∞ (↿(uB B)) (simDomain B.h B.qB) ∧
    ContDiffOn ℝ ∞ (↿B.PB) (simDomain B.h B.qB) ∧
    (∀ x t, (x, t) ∈ simDomain B.h B.qB → divergence (fun y => uB B y t) x = 0) ∧
    ContDiffOn ℝ ∞ (↿(mriE B)) (simDomain B.h B.qB) :=
by
  intro B hok
  have hS : SimScaleProps B.h := hok.1
  have hBP := hok.2
  unfold BackgroundProps at hBP
  obtain ⟨⟨-, -, hXa, -⟩, -, -, ⟨hAB, hBvB, hPB⟩, hB4, -, -, -, ⟨hTth, hTz, hvan, -⟩, -, -, -⟩ := hBP

  have hjet : ∀ (ν : ℝ) (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (O : Set (ℝ³ × ℝ)), IsOpen O →
      ContDiffOn ℝ ∞ (↿u) O → ContDiffOn ℝ ∞ (↿p) O → ContDiffOn ℝ ∞ (↿(nsResidual ν u p)) O := by
    intro ν u p O hO hu hp
    have s1 : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (x : ℝ³)
        (t : ℝ), DifferentiableAt ℝ f (x, t) →
        deriv (fun s => f (x, s)) t = fderiv ℝ f (x, t) ((0 : ℝ³), (1 : ℝ)) ∧
        fderiv ℝ (fun y => f (y, t)) x =
          (fderiv ℝ f (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := by
      intro F _ _ f x t hf
      constructor
      · have hγ : HasDerivAt (fun s : ℝ => ((x, s) : ℝ³ × ℝ)) ((0 : ℝ³), (1 : ℝ)) t :=
          (hasDerivAt_const t x).prodMk (hasDerivAt_id t)
        exact (hf.hasFDerivAt.comp_hasDerivAt t hγ).deriv
      · exact (hf.hasFDerivAt.comp x (hasFDerivAt_prodMk_left x t)).fderiv
    have s2 : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (x : ℝ³)
        (t : ℝ), ContDiffOn ℝ ∞ f O → (x, t) ∈ O → ∀ a b : ℝ³,
        fderiv ℝ (fderiv ℝ (fun y => f (y, t))) x a b =
          fderiv ℝ (fderiv ℝ f) (x, t) (a, (0 : ℝ)) (b, (0 : ℝ)) := by
      intro F _ _ f x t hf hxt a b
      have hemb : Continuous (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) :=
        continuous_id.prodMk continuous_const
      have hN : {y : ℝ³ | (y, t) ∈ O} ∈ nhds x := (hO.preimage hemb).mem_nhds hxt
      let Φ : (ℝ³ × ℝ →L[ℝ] F) →L[ℝ] (ℝ³ →L[ℝ] F) :=
        (ContinuousLinearMap.compL ℝ ℝ³ (ℝ³ × ℝ) F).flip (ContinuousLinearMap.inl ℝ ℝ³ ℝ)
      have hΦ : ∀ M, Φ M = M.comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := fun M => rfl
      have hev : fderiv ℝ (fun y => f (y, t)) =ᶠ[nhds x] fun y => Φ (fderiv ℝ f (y, t)) := by
        filter_upwards [hN] with y hy
        have hd : DifferentiableAt ℝ f (y, t) :=
          (hf.contDiffAt (hO.mem_nhds hy)).differentiableAt (by simp)
        rw [hΦ]
        exact (s1 f y t hd).2
      have hDf : ContDiffOn ℝ ∞ (fderiv ℝ f) O :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hf).2
      have hD2 : HasFDerivAt (fderiv ℝ f) (fderiv ℝ (fderiv ℝ f) (x, t)) (x, t) :=
        ((hDf.contDiffAt (hO.mem_nhds hxt)).differentiableAt (by simp)).hasFDerivAt
      have hg : HasFDerivAt (fun y => Φ (fderiv ℝ f (y, t)))
          (Φ.comp ((fderiv ℝ (fderiv ℝ f) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ))) x :=
        Φ.hasFDerivAt.comp x (hD2.comp x (hasFDerivAt_prodMk_left x t))
      rw [hev.fderiv_eq, hg.fderiv]
      rfl
    have s3 : ∀ (g : ℝ³ → ℝ) (x : ℝ³), gradient g x = ∑ i : Fin 3,
        fderiv ℝ g x (EuclideanSpace.single i (1 : ℝ)) • EuclideanSpace.single i (1 : ℝ) := by
      intro g x
      have h := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr' (gradient g x)
      rw [← h]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [EuclideanSpace.basisFun_apply]
      congr 1
      rw [real_inner_comm]
      exact InnerProductSpace.toDual_symm_apply
    have s4 : ∀ (g : ℝ³ → ℝ³) (x : ℝ³), Δ g x = ∑ i : Fin 3,
        fderiv ℝ (fderiv ℝ g) x (EuclideanSpace.single i (1 : ℝ)) (EuclideanSpace.single i (1 : ℝ)) := by
      intro g x
      have h := congrFun (InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis g
        (EuclideanSpace.basisFun (Fin 3) ℝ)) x
      rw [h]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [iteratedFDeriv_two_apply]
      simp [EuclideanSpace.basisFun_apply]
    have hDu : ContDiffOn ℝ ∞ (fderiv ℝ (↿u)) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hu).2
    have hD2u : ContDiffOn ℝ ∞ (fderiv ℝ (fderiv ℝ (↿u))) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hDu).2
    have hDp : ContDiffOn ℝ ∞ (fderiv ℝ (↿p)) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hp).2
    have hT3 : ContDiffOn ℝ ∞ (fun z => ∑ i : Fin 3, fderiv ℝ (fderiv ℝ (↿u)) z
        (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) (EuclideanSpace.single i (1 : ℝ), (0 : ℝ))) O :=
      ContDiffOn.sum fun i _ => (hD2u.clm_apply contDiffOn_const).clm_apply contDiffOn_const
    have hT4 : ContDiffOn ℝ ∞ (fun z => ∑ i : Fin 3, fderiv ℝ (↿p) z
        (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) • EuclideanSpace.single i (1 : ℝ)) O :=
      ContDiffOn.sum fun i _ => (hDp.clm_apply contDiffOn_const).smul contDiffOn_const
    have hJ : ContDiffOn ℝ ∞ (nsJet ν u p) O := by
      unfold nsJet
      exact (((hDu.clm_apply contDiffOn_const).add
        (hDu.clm_apply (hu.prodMk contDiffOn_const))).sub (hT3.const_smul ν)).add hT4
    have hid : ∀ z ∈ O, (↿(nsResidual ν u p)) z = nsJet ν u p z := by
      rintro ⟨x, t⟩ hz
      have hu' : DifferentiableAt ℝ (↿u) (x, t) :=
        (hu.contDiffAt (hO.mem_nhds hz)).differentiableAt (by simp)
      have hp' : DifferentiableAt ℝ (↿p) (x, t) :=
        (hp.contDiffAt (hO.mem_nhds hz)).differentiableAt (by simp)
      have e1 : deriv (fun s => u x s) t = fderiv ℝ (↿u) (x, t) ((0 : ℝ³), (1 : ℝ)) :=
        (s1 (↿u) x t hu').1
      have e2 : fderiv ℝ (fun y => u y t) x (u x t) =
          fderiv ℝ (↿u) (x, t) ((↿u) (x, t), (0 : ℝ)) := by
        have h2 : fderiv ℝ (fun y => u y t) x =
            (fderiv ℝ (↿u) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := (s1 (↿u) x t hu').2
        rw [h2]
        rfl
      have e3 : Δ (fun y => u y t) x = ∑ i : Fin 3, fderiv ℝ (fderiv ℝ (↿u)) (x, t)
          (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) := by
        rw [s4]
        exact Finset.sum_congr rfl (fun i _ => s2 (↿u) x t hu hz _ _)
      have e4 : gradient (fun y => p y t) x = ∑ i : Fin 3, fderiv ℝ (↿p) (x, t)
          (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) • EuclideanSpace.single i (1 : ℝ) := by
        have h2 : fderiv ℝ (fun y => p y t) x =
            (fderiv ℝ (↿p) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := (s1 (↿p) x t hp').2
        rw [s3, h2]
        rfl
      show nsResidual ν u p x t = nsJet ν u p (x, t)
      rw [nsResidual, e1, e2, e3, e4]
      rfl
    exact hJ.congr hid

  have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => w.1 i) := fun i =>
    (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).contDiff.comp contDiff_fst
  have hR : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => w.1 0 ^ 2 + w.1 1 ^ 2) :=
    ((hc 0).pow 2).add ((hc 1).pow 2)
  have hψ : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
    (hc 2).prodMk (contDiff_const.sub contDiff_snd)
  have hqH : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} :=
    hS.2.2.2.1.comp hψ.contDiffOn (fun w hw =>
      ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by linarith [show w.2 < 1 from hw]⟩)
  have hHo : IsOpen {w : ℝ³ × ℝ | w.2 < 1} := isOpen_lt continuous_snd continuous_const
  have hDo : IsOpen (simDomain B.h B.qB) := by
    have e : simDomain B.h B.qB = {w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio B.qB := Set.ext fun _ => Iff.rfl
    rw [e]
    exact hqH.continuousOn.isOpen_inter_preimage hHo isOpen_Iio
  have hqD : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      (simDomain B.h B.qB) := hqH.mono (fun w hw => hw.1)
  have hqpos : ∀ w ∈ simDomain B.h B.qB, 0 < simScale B.h (w.1 2) (1 - w.2) := fun w hw =>
    (hS.1 (w.1 2) (1 - w.2) (by linarith [hw.1])).1
  have hqbd : ∀ w ∈ simDomain B.h B.qB,
      (w.1 2) ^ 2 < simScale B.h (w.1 2) (1 - w.2) ^ (1 - 2 * B.h) := fun w hw =>
    (hS.2.1 (w.1 2) (1 - w.2) (by linarith [hw.1])).2
  have heta : ∀ w ∈ simDomain B.h B.qB, -1 < simEta B.h w.1 w.2 ∧ simEta B.h w.1 w.2 < 1 := by
    intro w hw
    have hq := hqpos w hw
    have hz := hqbd w hw
    have hp : 0 < simScale B.h (w.1 2) (1 - w.2) ^ (1 - 2 * B.h) := Real.rpow_pos_of_pos hq _
    have ha : (simScale B.h (w.1 2) (1 - w.2) ^ (-(1/2 - B.h))) ^ 2 =
        (simScale B.h (w.1 2) (1 - w.2) ^ (1 - 2 * B.h))⁻¹ := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hq.le, ← Real.rpow_neg hq.le]
      congr 1; push_cast; ring
    have hsq : (simEta B.h w.1 w.2) ^ 2 < 1 := by
      show (w.1 2 * simScale B.h (w.1 2) (1 - w.2) ^ (-(1/2 - B.h))) ^ 2 < 1
      rw [mul_pow, ha, ← div_eq_mul_inv, div_lt_one hp]
      exact hz
    exact abs_lt.1 ((sq_lt_one_iff_abs_lt_one _).1 hsq)

  have huB : ContDiffOn ℝ ∞ (↿(uB B)) (simDomain B.h B.qB) := by
    let ev : Fin 3 → Fin 3 → ((ℝ³ × ℝ) →L[ℝ] ℝ³) →L[ℝ] ℝ := fun a b =>
      (EuclideanSpace.proj b).comp
        (ContinuousLinearMap.apply ℝ ℝ³ ((EuclideanSpace.single a (1:ℝ) : ℝ³), (0:ℝ)))
    let L : ((ℝ³ × ℝ) →L[ℝ] ℝ³) →L[ℝ] ℝ³ :=
      (ev 1 2 - ev 2 1).smulRight (EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) +
      (ev 2 0 - ev 0 2).smulRight (EuclideanSpace.single (1 : Fin 3) (1 : ℝ)) +
      (ev 0 1 - ev 1 0).smulRight (EuclideanSpace.single (2 : Fin 3) (1 : ℝ))
    have hLapp : ∀ Φ : (ℝ³ × ℝ) →L[ℝ] ℝ³, L Φ =
        (Φ (EuclideanSpace.single 1 1, 0) 2 - Φ (EuclideanSpace.single 2 1, 0) 1) •
            EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
          (Φ (EuclideanSpace.single 2 1, 0) 0 - Φ (EuclideanSpace.single 0 1, 0) 2) •
            EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
          (Φ (EuclideanSpace.single 0 1, 0) 1 - Φ (EuclideanSpace.single 1 1, 0) 0) •
            EuclideanSpace.single (2 : Fin 3) (1 : ℝ) := by
      intro Φ
      rfl
    have hslice : ∀ z ∈ simDomain B.h B.qB, ∀ v : ℝ³,
        fderiv ℝ (fun w => B.AB w z.2) z.1 v = fderiv ℝ (↿B.AB) z (v, 0) := by
      intro z hz v
      have hd : DifferentiableAt ℝ (↿B.AB) z :=
        (hAB.contDiffAt (hDo.mem_nhds hz)).differentiableAt (by simp)
      have hd' : DifferentiableAt ℝ (↿B.AB) (z.1, z.2) := hd
      have he : (fun w => B.AB w z.2) = (↿B.AB) ∘ (fun w : ℝ³ => (w, z.2)) := rfl
      rw [he, fderiv_comp z.1 hd' (hasFDerivAt_prodMk_left z.1 z.2).differentiableAt,
        (hasFDerivAt_prodMk_left z.1 z.2).fderiv]
      rfl
    have hE : ∀ z ∈ simDomain B.h B.qB, (↿(uB B)) z = L (fderiv ℝ (↿B.AB) z) + (↿B.BvB) z := by
      intro z hz
      show curl3 (fun w => B.AB w z.2) z.1 + B.BvB z.1 z.2 = L (fderiv ℝ (↿B.AB) z) + B.BvB z.1 z.2
      rw [hLapp]
      simp only [curl3, hslice z hz]
    have hfd : ContDiffOn ℝ ∞ (fderiv ℝ (↿B.AB)) (simDomain B.h B.qB) :=
      hAB.fderiv_of_isOpen hDo (by simp)
    exact ((hfd.continuousLinearMap_comp L).add hBvB).congr hE

  have hcurl : ∀ (F : ℝ³ → ℝ³) (x : ℝ³), ContDiffAt ℝ 2 F x →
      DifferentiableAt ℝ (curl3 F) x ∧ divergence (curl3 F) x = 0 := by
    intro F x hF
    have h1 : HasFDerivAt (fderiv ℝ F) (fderiv ℝ (fderiv ℝ F) x) x :=
      ((hF.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)).hasFDerivAt
    have hsymm : ∀ v w, fderiv ℝ (fderiv ℝ F) x v w = fderiv ℝ (fderiv ℝ F) x w v := by
      have := hF.isSymmSndFDerivAt (by simp [minSmoothness_of_isRCLikeNormedField])
      intro v w; exact this v w
    have hg : ∀ a b : Fin 3, HasFDerivAt (fun y => fderiv ℝ F y (EuclideanSpace.single a 1) b)
        (((EuclideanSpace.proj b).comp
          (ContinuousLinearMap.apply ℝ ℝ³ (EuclideanSpace.single a (1:ℝ)))).comp
            (fderiv ℝ (fderiv ℝ F) x)) x := by
      intro a b
      have := (((EuclideanSpace.proj b).comp
          (ContinuousLinearMap.apply ℝ ℝ³ (EuclideanSpace.single a (1:ℝ)))).hasFDerivAt
          (x := fderiv ℝ F x)).comp x h1
      exact this
    have hc := ((((hg 1 2).fun_sub (hg 2 1)).smul_const (EuclideanSpace.single (0 : Fin 3) (1 : ℝ))).fun_add
      (((hg 2 0).fun_sub (hg 0 2)).smul_const (EuclideanSpace.single (1 : Fin 3) (1 : ℝ)))).fun_add
      (((hg 0 1).fun_sub (hg 1 0)).smul_const (EuclideanSpace.single (2 : Fin 3) (1 : ℝ)))
    have hc' : HasFDerivAt (curl3 F) _ x := hc
    refine ⟨hc'.differentiableAt, ?_⟩
    rw [divergence, hc'.fderiv, LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin 3) ℝ)]
    simp [Fin.sum_univ_three, EuclideanSpace.basisFun_apply, EuclideanSpace.inner_single_left]
    rw [hsymm (EuclideanSpace.single 1 1) (EuclideanSpace.single 0 1),
      hsymm (EuclideanSpace.single 2 1) (EuclideanSpace.single 1 1),
      hsymm (EuclideanSpace.single 2 1) (EuclideanSpace.single 0 1)]
    ring
  have hdiv : ∀ x t, (x, t) ∈ simDomain B.h B.qB → divergence (fun y => uB B y t) x = 0 := by
    intro x t hxt
    have hsl : ∀ G : ℝ³ → ℝ → ℝ³, ContDiffOn ℝ ∞ (↿G) (simDomain B.h B.qB) →
        ContDiffAt ℝ ∞ (fun w => G w t) x := fun G hG =>
      (hG.contDiffAt (hDo.mem_nhds hxt)).comp x ((contDiff_id.prodMk contDiff_const).contDiffAt)
    obtain ⟨hcd, hcdiv⟩ := hcurl (fun w => B.AB w t) x
      ((hsl B.AB hAB).of_le (by norm_num))
    have hBx : DifferentiableAt ℝ (fun w => B.BvB w t) x :=
      (hsl B.BvB hBvB).differentiableAt (by norm_num)
    have hfun : (fun y => uB B y t) = fun y => curl3 (fun w => B.AB w t) y + B.BvB y t := rfl
    rw [hfun, divergence_add hcd hBx, hcdiv, (hB4 x t hxt).1, add_zero]

  have hVo : IsOpen (Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) :=
    isOpen_Iio.prod (isOpen_Ioi.prod isOpen_Ioo)
  have hder : ∀ (f : ℝ → ℝ → ℝ → ℝ),
      ContDiffOn ℝ ∞ (logLift f) (Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) →
      ∀ q X η : ℝ, 0 < q →
      ((Real.log q, X, η) : ℝ × ℝ × ℝ) ∈ Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) →
      deriv (fun Y => f q Y η) X =
        fderiv ℝ (logLift f) (Real.log q, X, η) ((0:ℝ), (1:ℝ), (0:ℝ)) := by
    intro f hf q X η hq hm
    have hcv : HasDerivAt (fun Y : ℝ => ((Real.log q, Y, η) : ℝ × ℝ × ℝ)) ((0:ℝ), (1:ℝ), (0:ℝ)) X :=
      (hasDerivAt_const X (Real.log q)).prodMk ((hasDerivAt_id X).prodMk (hasDerivAt_const X η))
    have hF : HasFDerivAt (logLift f) (fderiv ℝ (logLift f) (Real.log q, X, η)) (Real.log q, X, η) :=
      ((hf.contDiffAt (hVo.mem_nhds hm)).differentiableAt (by simp)).hasFDerivAt
    have h2 := hF.comp_hasDerivAt X hcv
    have he : (logLift f ∘ fun Y : ℝ => ((Real.log q, Y, η) : ℝ × ℝ × ℝ)) = fun Y => f q Y η := by
      funext Y
      simp [Function.comp, logLift, Real.exp_log hq]
    rw [he] at h2
    exact h2.deriv

  have hoff : ContDiffOn ℝ ∞ (↿(stressDivField B.h B.Tth B.Tz))
      (simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2}) := by
    have hQ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
        (simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2}) := hqD.mono inter_subset_left
    have hQne : ∀ w ∈ simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2},
        simScale B.h (w.1 2) (1 - w.2) ≠ 0 := fun w hw => (hqpos w hw.1).ne'
    have hXpos : ∀ w ∈ simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2},
        0 < simX B.h w.1 w.2 := fun w hw => div_pos hw.2 (mul_pos two_pos (hqpos w hw.1))
    have hX : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simX B.h w.1 w.2)
        (simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2}) := by
      have : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ =>
          (w.1 0 ^ 2 + w.1 1 ^ 2) / (2 * simScale B.h (w.1 2) (1 - w.2)))
          (simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2}) :=
        hR.contDiffOn.div (contDiffOn_const.mul hQ) (fun w hw => (mul_pos two_pos (hqpos w hw.1)).ne')
      exact this
    have h2X : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => 2 * simX B.h w.1 w.2)
        (simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2}) := contDiffOn_const.mul hX
    have hE : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simEta B.h w.1 w.2)
        (simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2}) := by
      have : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ =>
          w.1 2 * simScale B.h (w.1 2) (1 - w.2) ^ (-(1/2 - B.h)))
          (simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2}) :=
        (hc 2).contDiffOn.mul (hQ.rpow_const_of_ne hQne)
      exact this
    have hΦ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => ((Real.log (simScale B.h (w.1 2) (1 - w.2)),
        simX B.h w.1 w.2, simEta B.h w.1 w.2) : ℝ × ℝ × ℝ))
        (simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2}) :=
      (hQ.log hQne).prodMk (hX.prodMk hE)
    have hmaps : MapsTo (fun w : ℝ³ × ℝ => ((Real.log (simScale B.h (w.1 2) (1 - w.2)),
        simX B.h w.1 w.2, simEta B.h w.1 w.2) : ℝ × ℝ × ℝ))
        (simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2})
        (Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) := fun w hw =>
      ⟨Real.log_lt_log (hqpos w hw.1) hw.1.2, hXpos w hw, heta w hw.1⟩
    have hL : ∀ f : ℝ → ℝ → ℝ → ℝ,
        ContDiffOn ℝ ∞ (logLift f) (Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) →
        ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => logLift f (Real.log (simScale B.h (w.1 2) (1 - w.2)),
          simX B.h w.1 w.2, simEta B.h w.1 w.2))
          (simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2}) ∧
        ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => fderiv ℝ (logLift f)
          (Real.log (simScale B.h (w.1 2) (1 - w.2)), simX B.h w.1 w.2, simEta B.h w.1 w.2)
          ((0:ℝ), (1:ℝ), (0:ℝ)))
          (simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2}) := fun f hf =>
      ⟨hf.comp hΦ hmaps,
        ((((contDiffOn_infty_iff_fderiv_of_isOpen hVo).1 hf).2).comp hΦ hmaps).clm_apply
          contDiffOn_const⟩
    have haz : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => azVec w.1) := by
      have : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => -(w.1 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
          w.1 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) :=
        ((hc 1).neg.smul contDiff_const).add ((hc 0).smul contDiff_const)
      exact this
    obtain ⟨hT1, hT2⟩ := hL B.Tth hTth
    obtain ⟨hZ1, hZ2⟩ := hL B.Tz hTz
    have hXne : ∀ w ∈ simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2},
        simX B.h w.1 w.2 ≠ 0 := fun w hw => (hXpos w hw).ne'
    have h2Xne : ∀ w ∈ simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2},
        2 * simX B.h w.1 w.2 ≠ 0 := fun w hw => (mul_pos two_pos (hXpos w hw)).ne'
    have ha : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => -(simScale B.h (w.1 2) (1 - w.2) ^ (-(2 + B.h)) *
        (fderiv ℝ (logLift B.Tth)
          (Real.log (simScale B.h (w.1 2) (1 - w.2)), simX B.h w.1 w.2, simEta B.h w.1 w.2)
          ((0:ℝ), (1:ℝ), (0:ℝ)) +
         logLift B.Tth (Real.log (simScale B.h (w.1 2) (1 - w.2)), simX B.h w.1 w.2,
          simEta B.h w.1 w.2) / simX B.h w.1 w.2)))
        (simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2}) :=
      ((hQ.rpow_const_of_ne hQne).mul (hT2.add (hT1.div hX hXne))).neg
    have hb : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => -(Real.sqrt (2 * simX B.h w.1 w.2) *
        simScale B.h (w.1 2) (1 - w.2) ^ (-(3 / 2 + B.h)) *
        (fderiv ℝ (logLift B.Tz)
          (Real.log (simScale B.h (w.1 2) (1 - w.2)), simX B.h w.1 w.2, simEta B.h w.1 w.2)
          ((0:ℝ), (1:ℝ), (0:ℝ)) +
         logLift B.Tz (Real.log (simScale B.h (w.1 2) (1 - w.2)), simX B.h w.1 w.2,
          simEta B.h w.1 w.2) / (2 * simX B.h w.1 w.2))))
        (simDomain B.h B.qB ∩ {w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2}) :=
      (((h2X.sqrt h2Xne).mul (hQ.rpow_const_of_ne hQne)).mul (hZ2.add (hZ1.div h2X h2Xne))).neg
    have hG := (ha.smul haz.contDiffOn).add
      (hb.smul (contDiffOn_const (c := EuclideanSpace.single (2 : Fin 3) (1:ℝ))))
    refine hG.congr ?_
    rintro ⟨x, t⟩ hw
    have hq : 0 < simScale B.h (x 2) (1 - t) := hqpos _ hw.1
    have hm : ((Real.log (simScale B.h (x 2) (1 - t)), simX B.h x t, simEta B.h x t) : ℝ × ℝ × ℝ) ∈
        Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := hmaps hw
    have hd1 := hder B.Tth hTth (simScale B.h (x 2) (1 - t)) (simX B.h x t) (simEta B.h x t) hq hm
    have hd2 := hder B.Tz hTz (simScale B.h (x 2) (1 - t)) (simX B.h x t) (simEta B.h x t) hq hm
    have hv1 : B.Tth (simScale B.h (x 2) (1 - t)) (simX B.h x t) (simEta B.h x t) =
        logLift B.Tth (Real.log (simScale B.h (x 2) (1 - t)), simX B.h x t, simEta B.h x t) := by
      simp only [logLift, Real.exp_log hq]
    have hv2 : B.Tz (simScale B.h (x 2) (1 - t)) (simX B.h x t) (simEta B.h x t) =
        logLift B.Tz (Real.log (simScale B.h (x 2) (1 - t)), simX B.h x t, simEta B.h x t) := by
      simp only [logLift, Real.exp_log hq]
    show stressDivField B.h B.Tth B.Tz x t = _
    simp only [Pi.add_apply, Pi.smul_apply', stressDivField, hd1, hd2, hv1, hv2]

  have hU2o : IsOpen (simDomain B.h B.qB ∩ (fun w : ℝ³ × ℝ =>
      2 * B.Xa * simScale B.h (w.1 2) (1 - w.2) - (w.1 0 ^ 2 + w.1 1 ^ 2)) ⁻¹' Ioi 0) :=
    ((contDiffOn_const.mul hqD).sub hR.contDiffOn).continuousOn.isOpen_inter_preimage hDo isOpen_Ioi
  have hnear : ContDiffOn ℝ ∞ (↿(stressDivField B.h B.Tth B.Tz))
      (simDomain B.h B.qB ∩ (simDomain B.h B.qB ∩ (fun w : ℝ³ × ℝ =>
        2 * B.Xa * simScale B.h (w.1 2) (1 - w.2) - (w.1 0 ^ 2 + w.1 1 ^ 2)) ⁻¹' Ioi 0)) := by
    refine (contDiffOn_const (c := (0:ℝ³))).congr ?_
    rintro ⟨x, t⟩ ⟨hD, -, hk⟩
    have hq : 0 < simScale B.h (x 2) (1 - t) := hqpos _ hD
    have hk' : 0 < 2 * B.Xa * simScale B.h (x 2) (1 - t) - (x 0 ^ 2 + x 1 ^ 2) := hk
    have hX : simX B.h x t < B.Xa := by
      show (x 0 ^ 2 + x 1 ^ 2) / (2 * simScale B.h (x 2) (1 - t)) < B.Xa
      rw [div_lt_iff₀ (mul_pos two_pos hq)]
      nlinarith
    have hz : ∀ f : ℝ → ℝ → ℝ → ℝ, (∀ q X η : ℝ, X ≤ B.Xa → f q X η = 0) →
        deriv (fun Y => f (simScale B.h (x 2) (1 - t)) Y (simEta B.h x t)) (simX B.h x t) = 0 ∧
        f (simScale B.h (x 2) (1 - t)) (simX B.h x t) (simEta B.h x t) = 0 := by
      intro f hf
      refine ⟨?_, hf _ _ _ hX.le⟩
      have hev : (fun Y => f (simScale B.h (x 2) (1 - t)) Y (simEta B.h x t)) =ᶠ[nhds (simX B.h x t)]
          fun _ => (0:ℝ) :=
        Filter.eventuallyEq_of_mem (isOpen_Iio.mem_nhds hX) (fun Y hY => hf _ _ _ (le_of_lt hY))
      rw [hev.deriv_eq, deriv_const]
    obtain ⟨hd1, hv1⟩ := hz B.Tth (fun q X η h => (hvan q X η (Or.inl h)).1)
    obtain ⟨hd2, hv2⟩ := hz B.Tz (fun q X η h => (hvan q X η (Or.inl h)).2)
    show stressDivField B.h B.Tth B.Tz x t = 0
    simp only [stressDivField, hd1, hv1, hd2, hv2, zero_div, add_zero, mul_zero, neg_zero, zero_smul]

  have hSD : ContDiffOn ℝ ∞ (↿(stressDivField B.h B.Tth B.Tz)) (simDomain B.h B.qB) := by
    apply contDiffOn_of_locally_contDiffOn
    intro w hw
    by_cases hr : 0 < w.1 0 ^ 2 + w.1 1 ^ 2
    · exact ⟨{w : ℝ³ × ℝ | 0 < w.1 0 ^ 2 + w.1 1 ^ 2}, isOpen_lt continuous_const hR.continuous,
        hr, hoff⟩
    · refine ⟨simDomain B.h B.qB ∩ (fun w : ℝ³ × ℝ =>
        2 * B.Xa * simScale B.h (w.1 2) (1 - w.2) - (w.1 0 ^ 2 + w.1 1 ^ 2)) ⁻¹' Ioi 0,
        hU2o, ⟨hw, ?_⟩, hnear⟩
      have h0 : w.1 0 ^ 2 + w.1 1 ^ 2 = 0 := le_antisymm (not_lt.1 hr) (by positivity)
      show 0 < 2 * B.Xa * simScale B.h (w.1 2) (1 - w.2) - (w.1 0 ^ 2 + w.1 1 ^ 2)
      rw [h0, sub_zero]
      exact mul_pos (mul_pos two_pos hXa) (hqpos w hw)
  have hNS := hjet 1 (uB B) B.PB _ hDo huB hPB
  exact ⟨hDo, huB, hPB, hdiv, (hNS.sub hSD).congr (fun z _ => rfl)⟩

theorem bg_mean_residual : ∀ B : BG, B.ok → (∀ ξ : Cyl, sBase B 0 ξ = 0) ∧
    ∀ (ξ : Cyl) (a : Fin 3), 0 < ξ.1 → ξ.2.2.1 < 1 → simScale B.h ξ.2.1 (1 - ξ.2.2.1) < B.qB →
      mriRes (uB B) B.PB a (ξ.1, ξ.2.1, ξ.2.2.1) =
        sBase B a ξ + thA (fun θ => inner ℝ (mriE B (rotPt ξ.1 θ ξ.2.1) ξ.2.2.1) (frameAt θ ξ a)) :=
by
  intro B hok

  have K : ∀ (y : ℝ³) (α β : ℝ) (a : Fin 3),
      inner ℝ (α • azVec y + β • EuclideanSpace.single (2 : Fin 3) (1:ℝ)) (![eR y, eTh y, eZ] a) =
        ![0, α * ((rad y)⁻¹ * (y 0 ^ 2 + y 1 ^ 2)), β] a := by
    intro y α β a
    fin_cases a <;>
      simp [eR, eTh, eZ, azVec, radVec, inner_add_left, inner_add_right, real_inner_smul_left,
        real_inner_smul_right, EuclideanSpace.inner_single_left, EuclideanSpace.inner_single_right] <;>
      ring

  have hinv : ∀ (x x' : ℝ³) (t : ℝ) (a : Fin 3), x 0 ^ 2 + x 1 ^ 2 = x' 0 ^ 2 + x' 1 ^ 2 → x 2 = x' 2 →
      inner ℝ (stressDivField B.h B.Tth B.Tz x t) (![eR x, eTh x, eZ] a) =
        inner ℝ (stressDivField B.h B.Tth B.Tz x' t) (![eR x', eTh x', eZ] a) := by
    intro x x' t a hρ hz
    have hX : simX B.h x t = simX B.h x' t := by unfold simX; rw [hρ, hz]
    have hE : simEta B.h x t = simEta B.h x' t := by unfold simEta; rw [hz]
    have hq : simScale B.h (x 2) (1 - t) = simScale B.h (x' 2) (1 - t) := by rw [hz]
    have hr : rad x = rad x' := by unfold rad; rw [hρ]
    unfold stressDivField
    rw [K, K, hX, hE, hq, hr, hρ]
  refine ⟨fun ξ => ?_, ?_⟩
  · show inner ℝ (stressDivField B.h B.Tth B.Tz (rotPt ξ.1 0 ξ.2.1) ξ.2.2.1)
        (![eR (rotPt ξ.1 0 ξ.2.1), eTh (rotPt ξ.1 0 ξ.2.1), eZ] 0) = 0
    unfold stressDivField
    rw [K]
    rfl


  have hcurl : ∀ (A Bv : ℝ³ → ℝ → ℝ³) (O : Set (ℝ³ × ℝ)), IsOpen O → ContDiffOn ℝ ∞ (↿A) O →
      ContDiffOn ℝ ∞ (↿Bv) O → ContDiffOn ℝ ∞ (↿(fun y s => curl3 (fun w => A w s) y + Bv y s)) O := by
    intro A Bv O hO hA hB
    let ev : Fin 3 → Fin 3 → ((ℝ³ × ℝ) →L[ℝ] ℝ³) →L[ℝ] ℝ := fun a b =>
      (EuclideanSpace.proj b).comp
        (ContinuousLinearMap.apply ℝ ℝ³ ((EuclideanSpace.single a (1:ℝ) : ℝ³), (0:ℝ)))
    let L : ((ℝ³ × ℝ) →L[ℝ] ℝ³) →L[ℝ] ℝ³ :=
      (ev 1 2 - ev 2 1).smulRight (EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) +
      (ev 2 0 - ev 0 2).smulRight (EuclideanSpace.single (1 : Fin 3) (1 : ℝ)) +
      (ev 0 1 - ev 1 0).smulRight (EuclideanSpace.single (2 : Fin 3) (1 : ℝ))
    have hLapp : ∀ Φ : (ℝ³ × ℝ) →L[ℝ] ℝ³, L Φ =
        (Φ (EuclideanSpace.single 1 1, 0) 2 - Φ (EuclideanSpace.single 2 1, 0) 1) •
            EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
          (Φ (EuclideanSpace.single 2 1, 0) 0 - Φ (EuclideanSpace.single 0 1, 0) 2) •
            EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
          (Φ (EuclideanSpace.single 0 1, 0) 1 - Φ (EuclideanSpace.single 1 1, 0) 0) •
            EuclideanSpace.single (2 : Fin 3) (1 : ℝ) := by
      intro Φ
      rfl
    have hslice : ∀ z ∈ O, ∀ v : ℝ³,
        fderiv ℝ (fun w => A w z.2) z.1 v = fderiv ℝ (↿A) z (v, 0) := by
      intro z hz v
      have hd : DifferentiableAt ℝ (↿A) z :=
        (hA.contDiffAt (hO.mem_nhds hz)).differentiableAt (by simp)
      have hd' : DifferentiableAt ℝ (↿A) (z.1, z.2) := hd
      have he : (fun w => A w z.2) = (↿A) ∘ (fun w : ℝ³ => (w, z.2)) := rfl
      rw [he, fderiv_comp z.1 hd' (hasFDerivAt_prodMk_left z.1 z.2).differentiableAt,
        (hasFDerivAt_prodMk_left z.1 z.2).fderiv]
      rfl
    let G : ℝ³ × ℝ → ℝ³ := fun z => L (fderiv ℝ (↿A) z) + (↿Bv) z
    have hE : ∀ z ∈ O, (↿(fun y s => curl3 (fun w => A w s) y + Bv y s)) z = G z := by
      intro z hz
      show curl3 (fun w => A w z.2) z.1 + Bv z.1 z.2 = L (fderiv ℝ (↿A) z) + Bv z.1 z.2
      rw [hLapp]
      simp only [curl3, hslice z hz]
    have hfd : ContDiffOn ℝ ∞ (fderiv ℝ (↿A)) O := hA.fderiv_of_isOpen hO (by simp)
    have hLf : ContDiffOn ℝ ∞ (fun z => L (fderiv ℝ (↿A) z)) O := hfd.continuousLinearMap_comp L
    have hGs : ContDiffOn ℝ ∞ G O := hLf.add hB
    exact hGs.congr hE
  have hjet : ∀ (ν : ℝ) (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (O : Set (ℝ³ × ℝ)), IsOpen O →
      ContDiffOn ℝ ∞ (↿u) O → ContDiffOn ℝ ∞ (↿p) O → ContDiffOn ℝ ∞ (↿(nsResidual ν u p)) O := by
    intro ν u p O hO hu hp
    have s1 : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (x : ℝ³)
        (t : ℝ), DifferentiableAt ℝ f (x, t) →
        deriv (fun s => f (x, s)) t = fderiv ℝ f (x, t) ((0 : ℝ³), (1 : ℝ)) ∧
        fderiv ℝ (fun y => f (y, t)) x =
          (fderiv ℝ f (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := by
      intro F _ _ f x t hf
      constructor
      · have hγ : HasDerivAt (fun s : ℝ => ((x, s) : ℝ³ × ℝ)) ((0 : ℝ³), (1 : ℝ)) t :=
          (hasDerivAt_const t x).prodMk (hasDerivAt_id t)
        exact (hf.hasFDerivAt.comp_hasDerivAt t hγ).deriv
      · exact (hf.hasFDerivAt.comp x (hasFDerivAt_prodMk_left x t)).fderiv
    have s2 : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : ℝ³ × ℝ → F) (x : ℝ³)
        (t : ℝ), ContDiffOn ℝ ∞ f O → (x, t) ∈ O → ∀ a b : ℝ³,
        fderiv ℝ (fderiv ℝ (fun y => f (y, t))) x a b =
          fderiv ℝ (fderiv ℝ f) (x, t) (a, (0 : ℝ)) (b, (0 : ℝ)) := by
      intro F _ _ f x t hf hxt a b
      have hemb : Continuous (fun y : ℝ³ => ((y, t) : ℝ³ × ℝ)) :=
        continuous_id.prodMk continuous_const
      have hN : {y : ℝ³ | (y, t) ∈ O} ∈ nhds x := (hO.preimage hemb).mem_nhds hxt
      let Φ : (ℝ³ × ℝ →L[ℝ] F) →L[ℝ] (ℝ³ →L[ℝ] F) :=
        (ContinuousLinearMap.compL ℝ ℝ³ (ℝ³ × ℝ) F).flip (ContinuousLinearMap.inl ℝ ℝ³ ℝ)
      have hΦ : ∀ M, Φ M = M.comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := fun M => rfl
      have hev : fderiv ℝ (fun y => f (y, t)) =ᶠ[nhds x] fun y => Φ (fderiv ℝ f (y, t)) := by
        filter_upwards [hN] with y hy
        have hd : DifferentiableAt ℝ f (y, t) :=
          (hf.contDiffAt (hO.mem_nhds hy)).differentiableAt (by simp)
        rw [hΦ]
        exact (s1 f y t hd).2
      have hDf : ContDiffOn ℝ ∞ (fderiv ℝ f) O :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hf).2
      have hD2 : HasFDerivAt (fderiv ℝ f) (fderiv ℝ (fderiv ℝ f) (x, t)) (x, t) :=
        ((hDf.contDiffAt (hO.mem_nhds hxt)).differentiableAt (by simp)).hasFDerivAt
      have hg : HasFDerivAt (fun y => Φ (fderiv ℝ f (y, t)))
          (Φ.comp ((fderiv ℝ (fderiv ℝ f) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ))) x :=
        Φ.hasFDerivAt.comp x (hD2.comp x (hasFDerivAt_prodMk_left x t))
      rw [hev.fderiv_eq, hg.fderiv]
      rfl
    have s3 : ∀ (g : ℝ³ → ℝ) (x : ℝ³), gradient g x = ∑ i : Fin 3,
        fderiv ℝ g x (EuclideanSpace.single i (1 : ℝ)) • EuclideanSpace.single i (1 : ℝ) := by
      intro g x
      have h := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr' (gradient g x)
      rw [← h]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [EuclideanSpace.basisFun_apply]
      congr 1
      rw [real_inner_comm]
      exact InnerProductSpace.toDual_symm_apply
    have s4 : ∀ (g : ℝ³ → ℝ³) (x : ℝ³), Δ g x = ∑ i : Fin 3,
        fderiv ℝ (fderiv ℝ g) x (EuclideanSpace.single i (1 : ℝ)) (EuclideanSpace.single i (1 : ℝ)) := by
      intro g x
      have h := congrFun (InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis g
        (EuclideanSpace.basisFun (Fin 3) ℝ)) x
      rw [h]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [iteratedFDeriv_two_apply]
      simp [EuclideanSpace.basisFun_apply]
    have hDu : ContDiffOn ℝ ∞ (fderiv ℝ (↿u)) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hu).2
    have hD2u : ContDiffOn ℝ ∞ (fderiv ℝ (fderiv ℝ (↿u))) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hDu).2
    have hDp : ContDiffOn ℝ ∞ (fderiv ℝ (↿p)) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hp).2
    have hT3 : ContDiffOn ℝ ∞ (fun z => ∑ i : Fin 3, fderiv ℝ (fderiv ℝ (↿u)) z
        (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) (EuclideanSpace.single i (1 : ℝ), (0 : ℝ))) O :=
      ContDiffOn.sum fun i _ => (hD2u.clm_apply contDiffOn_const).clm_apply contDiffOn_const
    have hT4 : ContDiffOn ℝ ∞ (fun z => ∑ i : Fin 3, fderiv ℝ (↿p) z
        (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) • EuclideanSpace.single i (1 : ℝ)) O :=
      ContDiffOn.sum fun i _ => (hDp.clm_apply contDiffOn_const).smul contDiffOn_const
    have hJ : ContDiffOn ℝ ∞ (nsJet ν u p) O := by
      unfold nsJet
      exact (((hDu.clm_apply contDiffOn_const).add
        (hDu.clm_apply (hu.prodMk contDiffOn_const))).sub (hT3.const_smul ν)).add hT4
    have hid : ∀ z ∈ O, (↿(nsResidual ν u p)) z = nsJet ν u p z := by
      rintro ⟨x, t⟩ hz
      have hu' : DifferentiableAt ℝ (↿u) (x, t) :=
        (hu.contDiffAt (hO.mem_nhds hz)).differentiableAt (by simp)
      have hp' : DifferentiableAt ℝ (↿p) (x, t) :=
        (hp.contDiffAt (hO.mem_nhds hz)).differentiableAt (by simp)
      have e1 : deriv (fun s => u x s) t = fderiv ℝ (↿u) (x, t) ((0 : ℝ³), (1 : ℝ)) :=
        (s1 (↿u) x t hu').1
      have e2 : fderiv ℝ (fun y => u y t) x (u x t) =
          fderiv ℝ (↿u) (x, t) ((↿u) (x, t), (0 : ℝ)) := by
        have h2 : fderiv ℝ (fun y => u y t) x =
            (fderiv ℝ (↿u) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := (s1 (↿u) x t hu').2
        rw [h2]
        rfl
      have e3 : Δ (fun y => u y t) x = ∑ i : Fin 3, fderiv ℝ (fderiv ℝ (↿u)) (x, t)
          (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) := by
        rw [s4]
        exact Finset.sum_congr rfl (fun i _ => s2 (↿u) x t hu hz _ _)
      have e4 : gradient (fun y => p y t) x = ∑ i : Fin 3, fderiv ℝ (↿p) (x, t)
          (EuclideanSpace.single i (1 : ℝ), (0 : ℝ)) • EuclideanSpace.single i (1 : ℝ) := by
        have h2 : fderiv ℝ (fun y => p y t) x =
            (fderiv ℝ (↿p) (x, t)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ) := (s1 (↿p) x t hp').2
        rw [s3, h2]
        rfl
      show nsResidual ν u p x t = nsJet ν u p (x, t)
      rw [nsResidual, e1, e2, e3, e4]
      rfl
    exact hJ.congr hid

  have hO : IsOpen (simDomain B.h B.qB) := by
    have hS4 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1
    have hcoord : Continuous (fun y : ℝ³ => y 2) := (EuclideanSpace.proj (2 : Fin 3)).continuous
    have hφ : Continuous (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
      (hcoord.comp continuous_fst).prodMk (continuous_const.sub continuous_snd)
    have hFc : ContinuousOn (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} :=
      hS4.continuousOn.comp hφ.continuousOn (fun w hw => ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by
        have hw' : w.2 < 1 := hw
        linarith⟩)
    have he : simDomain B.h B.qB = {w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio B.qB := Set.ext fun _ => Iff.rfl
    rw [he]
    exact hFc.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
  have hB3 := hok.2.2.2.2.1
  have hu : ContDiffOn ℝ ∞ (↿(uB B)) (simDomain B.h B.qB) := hcurl B.AB B.BvB _ hO hB3.1 hB3.2.1
  have hres : ContinuousOn (↿(nsResidual 1 (uB B) B.PB)) (simDomain B.h B.qB) :=
    (hjet 1 (uB B) B.PB _ hO hu hB3.2.2).continuousOn

  have tavg : ∀ (N g : ℝ → ℝ) (c : ℝ), Continuous N → (∀ θ, g θ = N θ - c) → thA N = c + thA g := by
    intro N g c hN hg
    unfold thA
    simp only [hg]
    rw [intervalIntegral.integral_sub (hN.intervalIntegrable _ _) intervalIntegrable_const,
      intervalIntegral.integral_const, smul_eq_mul]
    have hpi : (2 * Real.pi) ≠ 0 := by positivity
    field_simp
    ring
  have tcirc : ∀ (r z t : ℝ) (Y : ℝ × ℝ) (a : Fin 3), 0 < r → ∀ (g : ℝ³ × ℝ → ℝ³) (O : Set (ℝ³ × ℝ)),
      ContinuousOn g O → (∀ θ : ℝ, ((rotPt r θ z, t) : ℝ³ × ℝ) ∈ O) →
      Continuous (fun θ => inner ℝ (g (rotPt r θ z, t)) (frameAt θ (r, z, t, Y) a)) := by
    intro r z t Y a hr g O hres hmem
    have hc0 : ∀ θ, (rotPt r θ z) 0 = r * Real.cos θ := fun θ => by simp [rotPt]
    have hc1 : ∀ θ, (rotPt r θ z) 1 = r * Real.sin θ := fun θ => by simp [rotPt]
    have hsq : ∀ θ, (rotPt r θ z) 0 ^ 2 + (rotPt r θ z) 1 ^ 2 = r ^ 2 := fun θ => by
      rw [hc0, hc1]; linear_combination r ^ 2 * Real.cos_sq_add_sin_sq θ
    have hR : ∀ θ, rad (rotPt r θ z) = r := fun θ => by
      unfold rad; rw [hsq, Real.sqrt_sq hr.le]
    have hγ : Continuous (fun θ : ℝ => ((rotPt r θ z, t) : ℝ³ × ℝ)) := by
      refine Continuous.prodMk ?_ continuous_const
      unfold rotPt
      fun_prop
    have h1 : Continuous (fun θ => g (rotPt r θ z, t)) := hres.comp_continuous hγ hmem
    have hfa : (fun θ => frameAt θ (r, z, t, Y) a) = fun θ =>
        ![r⁻¹ • ((r * Real.cos θ) • EuclideanSpace.single (0:Fin 3) (1:ℝ) +
            (r * Real.sin θ) • EuclideanSpace.single (1:Fin 3) (1:ℝ)),
          r⁻¹ • (-(r * Real.sin θ) • EuclideanSpace.single (0:Fin 3) (1:ℝ) +
            (r * Real.cos θ) • EuclideanSpace.single (1:Fin 3) (1:ℝ)), eZ] a := by
      funext θ
      show ![eR (rotPt r θ z), eTh (rotPt r θ z), eZ] a = _
      unfold eR eTh radVec azVec
      rw [hR, hc0, hc1]
    have h2 : Continuous (fun θ => frameAt θ (r, z, t, Y) a) := by
      rw [hfa]
      fin_cases a <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
        Matrix.tail_cons] <;> fun_prop
    exact h1.inner h2
  rintro ⟨r, z, t, Y⟩ a hr ht hq
  change 0 < r at hr
  change t < 1 at ht
  change simScale B.h z (1 - t) < B.qB at hq
  have hc0 : ∀ θ, (rotPt r θ z) 0 = r * Real.cos θ := fun θ => by simp [rotPt]
  have hc1 : ∀ θ, (rotPt r θ z) 1 = r * Real.sin θ := fun θ => by simp [rotPt]
  have hc2 : ∀ θ, (rotPt r θ z) 2 = z := fun θ => by simp [rotPt]
  have hsq : ∀ θ, (rotPt r θ z) 0 ^ 2 + (rotPt r θ z) 1 ^ 2 = r ^ 2 := fun θ => by
    rw [hc0, hc1]; linear_combination r ^ 2 * Real.cos_sq_add_sin_sq θ
  have hmem : ∀ θ : ℝ, ((rotPt r θ z, t) : ℝ³ × ℝ) ∈ simDomain B.h B.qB := fun θ => by
    show t < 1 ∧ simScale B.h ((rotPt r θ z) 2) (1 - t) < B.qB
    rw [hc2]
    exact ⟨ht, hq⟩
  have hNc : Continuous (fun θ => inner ℝ ((↿(nsResidual 1 (uB B) B.PB)) (rotPt r θ z, t))
      (frameAt θ (r, z, t, Y) a)) :=
    tcirc r z t Y a hr (↿(nsResidual 1 (uB B) B.PB)) (simDomain B.h B.qB) hres hmem
  have hS : ∀ θ, inner ℝ (stressDivField B.h B.Tth B.Tz (rotPt r θ z) t)
      (![eR (rotPt r θ z), eTh (rotPt r θ z), eZ] a) =
      inner ℝ (stressDivField B.h B.Tth B.Tz (rotPt r 0 z) t)
      (![eR (rotPt r 0 z), eTh (rotPt r 0 z), eZ] a) :=
    fun θ => hinv (rotPt r θ z) (rotPt r 0 z) t a (by rw [hsq, hsq]) (by rw [hc2, hc2])
  have hint : ∀ θ, inner ℝ (mriE B (rotPt r θ z) t) (frameAt θ (r, z, t, Y) a) =
      inner ℝ ((↿(nsResidual 1 (uB B) B.PB)) (rotPt r θ z, t)) (frameAt θ (r, z, t, Y) a) -
        sBase B a (r, z, t, Y) := by
    intro θ
    have e : mriE B (rotPt r θ z) t = (↿(nsResidual 1 (uB B) B.PB)) (rotPt r θ z, t) -
        stressDivField B.h B.Tth B.Tz (rotPt r θ z) t := rfl
    have e2 : sBase B a (r, z, t, Y) = inner ℝ (stressDivField B.h B.Tth B.Tz (rotPt r 0 z) t)
        (![eR (rotPt r 0 z), eTh (rotPt r 0 z), eZ] a) := rfl
    have e3 : frameAt θ (r, z, t, Y) a = ![eR (rotPt r θ z), eTh (rotPt r θ z), eZ] a := rfl
    rw [e, e2, e3, inner_sub_left, hS θ]
  have key := tavg _ _ (sBase B a (r, z, t, Y)) hNc hint
  have hf : ∀ θ, frameAt θ (r, z, t, 0) a = frameAt θ (r, z, t, Y) a := fun θ => rfl
  show thA (fun θ => inner ℝ ((↿(nsResidual 1 (uB B) B.PB)) (rotPt r θ z, t)) (frameAt θ (r, z, t, 0) a)) =
    sBase B a (r, z, t, Y) + thA (fun θ => inner ℝ (mriE B (rotPt r θ z) t) (frameAt θ (r, z, t, Y) a))
  simp only [hf]
  exact key

theorem curl3_differentiable_divergence_zero : ∀ (F : ℝ³ → ℝ³) (x : ℝ³), ContDiffAt ℝ 2 F x → DifferentiableAt ℝ (curl3 F) x ∧ divergence (curl3 F) x = 0 :=
by
  intro F x hF
  have h1 : HasFDerivAt (fderiv ℝ F) (fderiv ℝ (fderiv ℝ F) x) x :=
    ((hF.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)).hasFDerivAt
  have hsymm : ∀ v w, fderiv ℝ (fderiv ℝ F) x v w = fderiv ℝ (fderiv ℝ F) x w v := by
    have := hF.isSymmSndFDerivAt (by simp [minSmoothness_of_isRCLikeNormedField])
    intro v w; exact this v w
  have hg : ∀ a b : Fin 3, HasFDerivAt (fun y => fderiv ℝ F y (EuclideanSpace.single a 1) b)
      (((EuclideanSpace.proj b).comp
        (ContinuousLinearMap.apply ℝ ℝ³ (EuclideanSpace.single a (1:ℝ)))).comp
          (fderiv ℝ (fderiv ℝ F) x)) x := by
    intro a b
    have := (((EuclideanSpace.proj b).comp
        (ContinuousLinearMap.apply ℝ ℝ³ (EuclideanSpace.single a (1:ℝ)))).hasFDerivAt
        (x := fderiv ℝ F x)).comp x h1
    exact this
  have hc := ((((hg 1 2).fun_sub (hg 2 1)).smul_const (EuclideanSpace.single (0 : Fin 3) (1 : ℝ))).fun_add
    (((hg 2 0).fun_sub (hg 0 2)).smul_const (EuclideanSpace.single (1 : Fin 3) (1 : ℝ)))).fun_add
    (((hg 0 1).fun_sub (hg 1 0)).smul_const (EuclideanSpace.single (2 : Fin 3) (1 : ℝ)))
  have hc' : HasFDerivAt (curl3 F) _ x := hc
  refine ⟨hc'.differentiableAt, ?_⟩
  rw [divergence, hc'.fderiv, LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin 3) ℝ)]
  simp [Fin.sum_univ_three, EuclideanSpace.basisFun_apply, EuclideanSpace.inner_single_left]
  rw [hsymm (EuclideanSpace.single 1 1) (EuclideanSpace.single 0 1),
    hsymm (EuclideanSpace.single 2 1) (EuclideanSpace.single 1 1),
    hsymm (EuclideanSpace.single 2 1) (EuclideanSpace.single 0 1)]
  ring

theorem corr_domain_v5 : ∀ (B : BG) (l0 : ℕ) (Y₀ : ℝ × ℝ), B.ok →
    IsOpen {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} ∧
    ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y₀))
      {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} ∧
    ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) {w : ℝ³ × ℝ | w.2 < 1} ∧
    ContDiffOn ℝ ∞ rad {x : ℝ³ | 0 < rad x} ∧ ContDiffOn ℝ ∞ eR {x : ℝ³ | 0 < rad x} ∧
    ContDiffOn ℝ ∞ eTh {x : ℝ³ | 0 < rad x} :=
by
  intro B l0 Y₀ hok
  have hσ : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) := hok.1.2.2.2.1
  have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun x : ℝ³ => x i) := fun i => contDiff_piLp_apply 2
  have hC3 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2))
      {w : ℝ³ × ℝ | w.2 < 1} := by
    have hg : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) :=
      ((hc 2).comp contDiff_fst).prodMk (contDiff_const.sub contDiff_snd)
    have hmaps : MapsTo (fun w : ℝ³ × ℝ => ((w.1 2, 1 - w.2) : ℝ × ℝ)) {w : ℝ³ × ℝ | w.2 < 1}
        (univ ×ˢ Ioi 0) := by
      intro w hw
      have hw' : w.2 < 1 := hw
      exact ⟨mem_univ _, show (0:ℝ) < 1 - w.2 by linarith⟩
    exact hσ.comp hg.contDiffOn hmaps
  have hf : ContDiff ℝ ∞ (fun x : ℝ³ => x 0 ^ 2 + x 1 ^ 2) := ((hc 0).pow 2).add ((hc 1).pow 2)
  have hC4 : ContDiffOn ℝ ∞ rad {x : ℝ³ | 0 < rad x} := by
    have h := hf.contDiffOn.sqrt (s := {x : ℝ³ | 0 < rad x}) (fun x hx => by
      have hx' : 0 < Real.sqrt (x 0 ^ 2 + x 1 ^ 2) := hx
      exact (Real.sqrt_pos.mp hx').ne')
    exact h
  have hinv : ContDiffOn ℝ ∞ (fun x => (rad x)⁻¹) {x : ℝ³ | 0 < rad x} :=
    hC4.inv (fun x hx => ne_of_gt hx)
  have hrv : ContDiff ℝ ∞ radVec := by
    have h : ContDiff ℝ ∞ (fun x : ℝ³ => x 0 • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        x 1 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) :=
      ((hc 0).smul contDiff_const).add ((hc 1).smul contDiff_const)
    exact h
  have haz : ContDiff ℝ ∞ azVec := by
    have h : ContDiff ℝ ∞ (fun x : ℝ³ => -(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) :=
      ((hc 1).neg.smul contDiff_const).add ((hc 0).smul contDiff_const)
    exact h
  have hC5 : ContDiffOn ℝ ∞ eR {x : ℝ³ | 0 < rad x} := hinv.smul hrv.contDiffOn
  have hC6 : ContDiffOn ℝ ∞ eTh {x : ℝ³ | 0 < rad x} := hinv.smul haz.contDiffOn
  have hradc : Continuous (fun w : ℝ³ × ℝ => rad w.1) :=
    Real.continuous_sqrt.comp (hf.continuous.comp continuous_fst)
  have hC1 : IsOpen {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} := by
    have h1 : IsOpen {w : ℝ³ × ℝ | 0 < rad w.1} := isOpen_lt continuous_const hradc
    have h2 : IsOpen ({w : ℝ³ × ℝ | w.2 < 1} ∩
        (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0)) :=
      hC3.continuousOn.isOpen_inter_preimage (isOpen_lt continuous_snd continuous_const) isOpen_Iio
    have e : {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} = {w : ℝ³ × ℝ | 0 < rad w.1} ∩
        ({w : ℝ³ × ℝ | w.2 < 1} ∩
          (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) ⁻¹' Iio (qsOf l0)) := by
      ext w; rfl
    rw [e]; exact h1.inter h2
  have hmapsR : MapsTo (fun w : ℝ³ × ℝ => w.1) {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2}
      {x : ℝ³ | 0 < rad x} := fun w hw => hw.1
  have c1 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => rad w.1) {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} :=
    hC4.comp contDiff_fst.contDiffOn hmapsR
  have c2 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => w.1 2) {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} :=
    ((hc 2).comp contDiff_fst).contDiffOn
  have c3 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => w.2) {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} :=
    contDiff_snd.contDiffOn
  have c4 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => Yph B.h (rad w.1) w.2 + Y₀)
      {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} := by
    have hp := c1.rpow_const_of_ne (p := drx B.h) (fun w hw => ne_of_gt hw.1)
    exact ((hp.smul contDiffOn_const).add (c3.smul contDiffOn_const)).add contDiffOn_const
  have hC2 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y₀))
      {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} :=
    c1.prodMk (c2.prodMk (c3.prodMk c4))
  exact ⟨hC1, hC2, hC3, hC4, hC5, hC6⟩

theorem etaL_locfin : ∀ (h qs : ℝ), SimScaleProps h → ∀ ξ₀ ∈ DomC h qs, ∃ U : Set Cyl, IsOpen U ∧ ξ₀ ∈ U ∧
    ∃ T : Finset Lab, ∀ γ : Lab, γ ∉ T → ∀ ξ ∈ U, ξ ∉ tsupport (etaL h γ) :=
by
  have hloc : ∀ (h : ℝ), SimScaleProps h → ∀ ξ0 : Cyl, ξ0.2.2.1 < 1 → ∃ N ∈ nhds ξ0, ∃ Γ : Finset Lab, ∀ (γ : Lab) (ξ : Cyl), ξ ∈ N → ξ ∈ tsupport (etaL h γ) → γ ∈ Γ := by
    intro h hS ξ0 hξ0

    have hLc : ∀ ξ : Cyl, ξ.2.2.1 < 1 → ContinuousAt (fun η => Real.logb 2 (qC h η)) ξ := by
      intro ξ hξ
      have hτ : 0 < 1 - ξ.2.2.1 := by linarith
      have hqpos : 0 < qC h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
      have hqcont : ContinuousAt (qC h) ξ := by
        have hU : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
        have hp : ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) :=
          ⟨trivial, hτ⟩
        have hg : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (ξ.2.1, 1 - ξ.2.2.1) :=
          hS.2.2.2.1.continuousOn.continuousAt (hU.mem_nhds hp)
        have hk : ContinuousAt (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) ξ := by fun_prop
        have he : qC h = (fun w : ℝ × ℝ => simScale h w.1 w.2) ∘
            (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by
          funext η; rfl
        rw [he]
        exact ContinuousAt.comp hg hk
      exact hqcont.logb hqpos.ne'

    have hwin : ∀ (ξ : Cyl) (γ : Lab), ξ.2.2.1 < 1 → ξ ∈ tsupport (etaL h γ) →
        |Real.logb 2 (qC h ξ) + (γ.1:ℝ)| ≤ 1 ∧
        |chartR h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1:ℝ)| ≤ 1 ∧
        |chartZ h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.1:ℝ)| ≤ 1 ∧
        |chartT h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2:ℝ)| ≤ 1 := by
      intro ξ γ hξ hγ
      have s1 : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ → 1 < |φ ξ / μ - (j : ℝ)| →
          ∀ᶠ η in nhds ξ, sqPart μ j (φ η) = 0 := by
        intro μ j φ hφ h1
        have hψ : ContinuousAt (fun η => |φ η / μ - (j : ℝ)|) ξ :=
          ((hφ.div_const μ).sub continuousAt_const).abs
        have hev := (continuousAt_const : ContinuousAt (fun _ : Cyl => (1:ℝ)) ξ).eventually_lt hψ h1
        filter_upwards [hev] with η hη
        have hsq : 1 < (φ η / μ - (j : ℝ)) ^ 2 := (one_lt_sq_iff_one_lt_abs _).mpr hη
        unfold sqPart bumpR
        rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_div]
      have key : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ →
          (∀ η, sqPart μ j (φ η) = 0 → etaL h γ η = 0) → |φ ξ / μ - (j:ℝ)| ≤ 1 := by
        intro μ j φ hφ himp
        by_contra hc
        push_neg at hc
        have hev := s1 μ j φ hφ hc
        apply (notMem_tsupport_iff_eventuallyEq.mpr _) hγ
        filter_upwards [hev] with η hη
        exact himp η hη
      refine ⟨?_, ?_, ?_, ?_⟩
      · have := key 1 (-(γ.1:ℤ)) (fun η => Real.logb 2 (qC h η)) (hLc ξ hξ)
          (fun η hη => by simp only [etaL, hη, zero_mul])
        simpa [div_one, sub_neg_eq_add] using this
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.1 (chartR h γ.1) (by unfold chartR; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.1 (chartZ h γ.1) (by unfold chartZ; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.2 (chartT h γ.1) (by unfold chartT; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])

    obtain ⟨L0, hL0⟩ : ∃ L0 : ℝ, L0 = Real.logb 2 (qC h ξ0) := ⟨_, rfl⟩
    have hfin : (⋃ n ∈ Set.Iic ⌊2 - L0⌋₊, ({n} : Set ℕ) ×ˢ
        ((Set.Icc ⌈chartR h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartR h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋ ×ˢ
          Set.Icc ⌈chartZ h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartZ h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋ ×ˢ
          Set.Icc ⌈chartT h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartT h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋) ×ˢ
          (Set.univ : Set Bool))).Finite := by
      refine Set.Finite.biUnion (Set.finite_Iic _) (fun n _ => ?_)
      exact (Set.finite_singleton n).prod (((Set.finite_Icc _ _).prod
        ((Set.finite_Icc _ _).prod (Set.finite_Icc _ _))).prod Set.finite_univ)
    have hI : ∀ (x c : ℝ) (j : ℤ), |x - (j:ℝ)| ≤ 1 → |x - c| < 1 → j ∈ Set.Icc ⌈c - 2⌉ ⌊c + 2⌋ := by
      intro x c j hj hc
      rw [abs_le] at hj
      rw [abs_lt] at hc
      exact ⟨Int.ceil_le.mpr (by linarith [hj.2, hc.1]), Int.le_floor.mpr (by linarith [hj.1, hc.2])⟩

    have hcR : ∀ n : ℕ, ContinuousAt (chartR h n) ξ0 := fun n => by unfold chartR; fun_prop
    have hcZ : ∀ n : ℕ, ContinuousAt (chartZ h n) ξ0 := fun n => by unfold chartZ; fun_prop
    have hcT : ∀ n : ℕ, ContinuousAt (chartT h n) ξ0 := fun n => by unfold chartT; fun_prop
    have hch : ∀ (φ : Cyl → ℝ) (μ : ℝ), ContinuousAt φ ξ0 →
        ∀ᶠ ξ in nhds ξ0, |φ ξ / μ - φ ξ0 / μ| < 1 := by
      intro φ μ hφ
      exact (((hφ.div_const μ).sub continuousAt_const).abs).eventually_lt continuousAt_const
        (by simp)
    have e1 : ∀ᶠ ξ in nhds ξ0, ξ.2.2.1 < 1 :=
      (show ContinuousAt (fun ξ : Cyl => ξ.2.2.1) ξ0 by fun_prop).eventually_lt
        continuousAt_const hξ0
    have e2 : ∀ᶠ ξ in nhds ξ0, |Real.logb 2 (qC h ξ) - L0| < 1 :=
      (((hLc ξ0 hξ0).sub continuousAt_const).abs).eventually_lt continuousAt_const
        (by simp [hL0])
    have e3 : ∀ᶠ ξ in nhds ξ0, ∀ n ∈ Finset.range (⌊2 - L0⌋₊ + 1),
        |chartR h n ξ / Sb n ^ (-3:ℤ) - chartR h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartZ h n ξ / Sb n ^ (-3:ℤ) - chartZ h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartT h n ξ / Sb n ^ (-3:ℤ) - chartT h n ξ0 / Sb n ^ (-3:ℤ)| < 1 := by
      rw [Filter.eventually_all_finset]
      intro n _
      exact (hch _ _ (hcR n)).and ((hch _ _ (hcZ n)).and (hch _ _ (hcT n)))
    refine ⟨{ξ | ξ.2.2.1 < 1 ∧ |Real.logb 2 (qC h ξ) - L0| < 1 ∧
        ∀ n ∈ Finset.range (⌊2 - L0⌋₊ + 1),
        |chartR h n ξ / Sb n ^ (-3:ℤ) - chartR h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartZ h n ξ / Sb n ^ (-3:ℤ) - chartZ h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartT h n ξ / Sb n ^ (-3:ℤ) - chartT h n ξ0 / Sb n ^ (-3:ℤ)| < 1}, ?_,
      hfin.toFinset, ?_⟩
    · filter_upwards [e1, e2, e3] with ξ h1 h2 h3
      exact ⟨h1, h2, h3⟩

    rintro ⟨n, ⟨a, b, c⟩, σ⟩ ξ ⟨ht, hL, hC⟩ hγ
    obtain ⟨w0, wR, wZ, wT⟩ := hwin ξ _ ht hγ
    simp only at w0 wR wZ wT
    rw [abs_le] at w0
    rw [abs_lt] at hL
    have hn : n ≤ ⌊2 - L0⌋₊ := Nat.le_floor (by linarith [w0.2, hL.1])
    obtain ⟨cR, cZ, cT⟩ := hC n (Finset.mem_range.mpr (Nat.lt_succ_of_le hn))
    rw [Set.Finite.mem_toFinset]
    refine Set.mem_iUnion₂.mpr ⟨n, hn, ?_⟩
    exact ⟨rfl, ⟨hI _ _ _ wR cR, hI _ _ _ wZ cZ, hI _ _ _ wT cT⟩, trivial⟩
  intro h qs hS ξ₀ hξ₀
  have ht : ξ₀.2.2.1 < 1 := hξ₀.2.1
  obtain ⟨N, hN, Γ, hΓ⟩ := hloc h hS ξ₀ ht
  obtain ⟨U, hUN, hUo, hξU⟩ := mem_nhds_iff.mp hN
  exact ⟨U, hUo, hξU, Γ, fun γ hγ ξ hξ hsupp => hγ (hΓ γ ξ (hUN hξ) hsupp)⟩

theorem wave_coef_phase_smooth_v5 : ∀ (B : BG) (G : CorrGeom) (qs : ℝ) (a : WS), GeomPrim5 B G →
    (∀ (l : ℕ) (i : Fin 3), ContDiffOn ℝ ∞ (fun ξ => baseC B l ξ i) (DomC B.h qs)) →
    (∀ γ m, ContDiffOn ℝ ∞ (a γ m) (DomC B.h qs)) →
    (∀ γ m ξ, ξ ∈ DomC B.h qs → a γ m ξ ≠ 0 → SuppW B G γ ξ) →
    ∀ (γ : Lab) (m : ℤ), ContDiffOn ℝ ∞ (fun ξ => a γ m ξ * Complex.exp (Complex.I * (m : ℂ) *
      ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)))) (DomC B.h qs) :=
by
  intro B G qs a hG hb ha hs γ m
  set v : Cyl → ℝ × ℝ := fun η => Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ with hv
  have hvc : Continuous v := by
    rw [hv]
    unfold Jpow
    fun_prop

  have hb0 : 0 ≤ bgc := by unfold bgc; linarith [Real.one_lt_sqrt_two]
  have hb1 : bgc ≤ 1 := by
    unfold bgc
    nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
  have hden : (1 + bgc ^ 2) * (1 + bgc ^ 2)⁻¹ = 1 := mul_inv_cancel₀ (by positivity)
  have id1 : ∀ w : ℝ × ℝ, w.1 = lamR w + bgc * lamT w := by
    intro w
    simp only [lamR, lamT, div_eq_mul_inv]
    linear_combination (-w.1) * hden
  have id2 : ∀ w : ℝ × ℝ, w.2 = -(bgc * lamR w) + lamT w := by
    intro w
    simp only [lamR, lamT, div_eq_mul_inv]
    linear_combination (-w.2) * hden
  have hr0 : G.r0 ≤ 1/100 := hG.1.2.1
  have key : ∀ (R T : ℝ), |R| ≤ G.r0 / 4 → |T| ≤ G.r0 →
      |R + bgc * T| ≤ 1/80 ∧ |-(bgc * R) + T| ≤ 1/80 := by
    intro R T hR hT
    obtain ⟨hR1, hR2⟩ := abs_le.mp hR
    obtain ⟨hT1, hT2⟩ := abs_le.mp hT
    have hr0n : 0 ≤ G.r0 := le_trans (abs_nonneg _) hT
    have e1 : bgc * T ≤ G.r0 := by
      nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hT2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
    have e2 : -G.r0 ≤ bgc * T := by
      nlinarith [mul_nonneg hb0 (show 0 ≤ T + G.r0 by linarith),
        mul_nonneg (sub_nonneg.mpr hb1) hr0n]
    have e3 : bgc * R ≤ G.r0 / 4 := by
      nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hR2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
    have e4 : -(G.r0 / 4) ≤ bgc * R := by
      nlinarith [mul_nonneg hb0 (show 0 ≤ R + G.r0 / 4 by linarith),
        mul_nonneg (sub_nonneg.mpr hb1) hr0n]
    exact ⟨abs_le.mpr ⟨by linarith, by linarith⟩, abs_le.mpr ⟨by linarith, by linarith⟩⟩
  have hround : ∀ (x : ℝ) (k : ℤ), |x - k| < 1/2 → round x = k := by
    intro x k hk
    rw [round_eq, Int.floor_eq_iff]
    obtain ⟨h1, h2⟩ := abs_lt.mp hk
    constructor <;> linarith

  have hZ : ContDiffOn ℝ ∞ (fun η : Cyl => chartZ B.h γ.1 η) (DomC B.h qs) := by
    have : ContDiff ℝ ∞ (fun η : Cyl => chartZ B.h γ.1 η) := by
      simp only [chartZ, div_eq_mul_inv]
      fun_prop
    exact this.contDiffOn
  have hRCd : ContDiff ℝ ∞ (fun η : Cyl => RC γ.1 η) := by
    simp only [RC, div_eq_mul_inv]
    fun_prop
  have hRC : ContDiffOn ℝ ∞ (fun η : Cyl => RC γ.1 η) (DomC B.h qs) := hRCd.contDiffOn
  have hRC0 : ∀ η ∈ DomC B.h qs, RC γ.1 η ≠ 0 := by
    intro η hη
    have : 0 < RC γ.1 η :=
      div_pos hη.1 (Real.sqrt_pos.mpr (Real.rpow_pos_of_pos (by norm_num) _))
    exact this.ne'
  have hFang : ContDiffOn ℝ ∞ (fun η : Cyl => Fang B γ.1 η) (DomC B.h qs) := by
    simp only [Fang, div_eq_mul_inv]
    exact (hb γ.1 1).mul (hRC.inv hRC0)
  apply contDiffOn_of_locally_contDiffOn
  intro ξ₀ hξ₀
  refine ⟨{η | |(v η).1 - (v ξ₀).1| < 1/8} ∩ {η | |(v η).2 - (v ξ₀).2| < 1/8}, ?_, ?_, ?_⟩
  · exact (isOpen_lt ((hvc.fst.sub continuous_const).abs) continuous_const).inter
      (isOpen_lt ((hvc.snd.sub continuous_const).abs) continuous_const)
  · refine ⟨?_, ?_⟩
    · show |(v ξ₀).1 - (v ξ₀).1| < 1/8
      rw [sub_self, abs_zero]; norm_num
    · show |(v ξ₀).2 - (v ξ₀).2| < 1/8
      rw [sub_self, abs_zero]; norm_num
  · by_cases hA : ∀ η ∈ DomC B.h qs ∩ ({η | |(v η).1 - (v ξ₀).1| < 1/8} ∩
        {η | |(v η).2 - (v ξ₀).2| < 1/8}), a γ m η = 0
    ·
      exact (contDiffOn_const (c := (0:ℂ))).congr (fun η hη => by simp [hA η hη])
    ·
      push_neg at hA
      obtain ⟨η1, hη1U, hη1⟩ := hA
      obtain ⟨-, -, hxi, het, -, -⟩ := hs γ m η1 hη1U.1 hη1
      have hw1 : |lamR (frac0 (v η1))| ≤ G.r0 / 4 := hxi
      have hw2 : |lamT (frac0 (v η1))| ≤ G.r0 := het
      have hw := key _ _ hw1 hw2
      have ex1 : (v η1).1 - ((round (v η1).1 : ℤ) : ℝ) =
          lamR (frac0 (v η1)) + bgc * lamT (frac0 (v η1)) := id1 (frac0 (v η1))
      have ex2 : (v η1).2 - ((round (v η1).2 : ℤ) : ℝ) =
          -(bgc * lamR (frac0 (v η1))) + lamT (frac0 (v η1)) := id2 (frac0 (v η1))
      have hx1 : |(v η1).1 - ((round (v η1).1 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex1]; exact hw.1
      have hx2 : |(v η1).2 - ((round (v η1).2 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex2]; exact hw.2
      obtain ⟨kk, hkk⟩ : ∃ kk : ℝ × ℝ,
          kk = (((round (v η1).1 : ℤ) : ℝ), ((round (v η1).2 : ℤ) : ℝ)) := ⟨_, rfl⟩
      have hfr : ∀ η ∈ DomC B.h qs ∩ ({η | |(v η).1 - (v ξ₀).1| < 1/8} ∩
          {η | |(v η).2 - (v ξ₀).2| < 1/8}), frac0 (v η) = v η - kk := by
        intro η hη
        have h1 : |(v η).1 - (v ξ₀).1| < 1/8 := hη.2.1
        have h2 : |(v η).2 - (v ξ₀).2| < 1/8 := hη.2.2
        have g1 : |(v η1).1 - (v ξ₀).1| < 1/8 := hη1U.2.1
        have g2 : |(v η1).2 - (v ξ₀).2| < 1/8 := hη1U.2.2
        obtain ⟨a1, a2⟩ := abs_lt.mp h1
        obtain ⟨a3, a4⟩ := abs_lt.mp h2
        obtain ⟨b1, b2⟩ := abs_lt.mp g1
        obtain ⟨b3, b4⟩ := abs_lt.mp g2
        obtain ⟨c1, c2⟩ := abs_le.mp hx1
        obtain ⟨c3, c4⟩ := abs_le.mp hx2
        have r1 : round (v η).1 = round (v η1).1 :=
          hround _ _ (abs_lt.mpr ⟨by linarith, by linarith⟩)
        have r2 : round (v η).2 = round (v η1).2 :=
          hround _ _ (abs_lt.mpr ⟨by linarith, by linarith⟩)
        rw [hkk]
        unfold frac0
        rw [r1, r2]
        rfl
      have hT : ContDiffOn ℝ ∞ (fun η : Cyl => lamT (v η - kk)) (DomC B.h qs) := by
        have : ContDiff ℝ ∞ (fun η : Cyl => lamT (v η - kk)) := by
          simp only [hv, lamT, Jpow, div_eq_mul_inv]
          fun_prop
        exact this.contDiffOn
      obtain ⟨M, hM⟩ : ∃ M : Cyl → ℝ, M = fun η : Cyl =>
          pzr5 B G γ * chartZ B.h γ.1 η / epsb B.h γ.1 + sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 * RC γ.1 η
          - (lamT (v η - kk) + G.r0) / cib B.h γ.1 *
            (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2) := ⟨_, rfl⟩
      have hmd : ContDiffOn ℝ ∞ M (DomC B.h qs) := by
        rw [hM]
        simp only [div_eq_mul_inv]
        exact (((contDiffOn_const.mul hZ).mul contDiffOn_const).add (contDiffOn_const.mul hRC)).sub
          (((hT.add contDiffOn_const).mul contDiffOn_const).mul
            ((contDiffOn_const.mul hFang).add (contDiffOn_const.mul (hb γ.1 2))))
      have hmodel : ∀ η ∈ DomC B.h qs ∩ ({η | |(v η).1 - (v ξ₀).1| < 1/8} ∩
          {η | |(v η).2 - (v ξ₀).2| < 1/8}), phiL5 B G γ η = M η := by
        intro η hη
        have hvco : vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = (lamT (v η - kk) + G.r0) / cib B.h γ.1 := by
          show (lamT (frac0 (v η)) + G.r0) / cib B.h γ.1 = _
          rw [hfr η hη]
        rw [hM]
        show phiL5 B G γ η = _
        unfold phiL5
        rw [hvco]
      have hc : ContDiffOn ℝ ∞ (fun η : Cyl => ((M η : ℝ) : ℂ)) (DomC B.h qs) :=
        Complex.ofRealCLM.contDiff.comp_contDiffOn hmd
      have hE : ContDiffOn ℝ ∞ (fun η : Cyl =>
          Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * ((M η : ℝ) : ℂ)))) (DomC B.h qs) :=
        (contDiffOn_const.mul (contDiffOn_const.mul hc)).cexp
      have hFt := ((ha γ m).mul hE).mono (inter_subset_left (s := DomC B.h qs)
        (t := {η | |(v η).1 - (v ξ₀).1| < 1/8} ∩ {η | |(v η).2 - (v ξ₀).2| < 1/8}))
      refine hFt.congr (fun η hη => ?_)
      show a γ m η * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ η : ℂ))) =
        a γ m η * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * ((M η : ℝ) : ℂ)))
      rw [hmodel η hη]

theorem wave_sum_assembly : ∀ (Ω : Set (ℝ³ × ℝ)) (D : Set Cyl) (Ψ : ℝ³ × ℝ → Cyl) (c : Lab → ℤ → Cyl → ℂ)
    (N : Lab → ℤ → ℤ) (H : Finset ℤ), IsOpen Ω → (∀ w ∈ Ω, 0 < rad w.1) → ContDiffOn ℝ ∞ Ψ Ω →
    MapsTo Ψ Ω D → (∀ γ m, m ∉ H → ∀ ξ ∈ D, c γ m ξ = 0) →
    (∀ ξ₀ ∈ D, ∃ U : Set Cyl, IsOpen U ∧ ξ₀ ∈ U ∧ ∃ T : Finset Lab, ∀ γ, γ ∉ T → ∀ m, ∀ ξ ∈ U ∩ D,
      c γ m ξ = 0) →
    (∀ γ m, ContDiffOn ℝ ∞ (c γ m) D) →
    ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, c γ m (Ψ w) *
      Complex.exp (Complex.I * (N γ m : ℂ) * (thetaOf w.1 : ℂ))).re) Ω :=
by
  intro Ω D Ψ c N H hΩ hrad hΨ hmaps hH hloc hc
  set Z : ℝ³ → ℂ := fun y => (⟨y 0, y 1⟩ : ℂ) with hZdef
  have hp0 : ContDiff ℝ ∞ (fun y : ℝ³ => y 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).contDiff
  have hp1 : ContDiff ℝ ∞ (fun y : ℝ³ => y 1) :=
    (EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ).contDiff
  have hZeq : Z = fun y => Complex.ofRealCLM (y 0) + Complex.ofRealCLM (y 1) * Complex.I := by
    funext y; apply Complex.ext <;> simp [hZdef]
  have hZ : ContDiff ℝ ∞ Z := by
    rw [hZeq]
    exact (Complex.ofRealCLM.contDiff.comp hp0).add
      ((Complex.ofRealCLM.contDiff.comp hp1).mul contDiff_const)
  have hnorm : ∀ y : ℝ³, ‖Z y‖ = rad y := by
    intro y
    rw [Complex.norm_eq_sqrt_sq_add_sq]
    rfl
  have hZne : ∀ y : ℝ³, 0 < rad y → Z y ≠ 0 := by
    intro y hy h
    rw [← hnorm y, h, norm_zero] at hy
    exact lt_irrefl _ hy

  have hR : ContDiffOn ℝ ∞ (fun y : ℝ³ => ((rad y : ℝ) : ℂ)) {y : ℝ³ | 0 < rad y} := by
    intro y hy
    have h1 : ContDiffAt ℝ ∞ (fun y => ‖Z y‖) y :=
      (contDiffAt_norm ℝ (hZne y hy)).comp y hZ.contDiffAt
    have h2 : ContDiffAt ℝ ∞ (fun y => Complex.ofRealCLM ‖Z y‖) y :=
      Complex.ofRealCLM.contDiff.contDiffAt.comp y h1
    have e : (fun y => Complex.ofRealCLM ‖Z y‖) = fun y : ℝ³ => ((rad y : ℝ) : ℂ) := by
      funext y; simp [hnorm]
    rw [e] at h2
    exact h2.contDiffWithinAt
  obtain ⟨u, hu_def⟩ : ∃ u : ℝ³ → ℂ, u = fun y => ((rad y : ℝ) : ℂ)⁻¹ * Z y := ⟨_, rfl⟩
  have hu : ContDiffOn ℝ ∞ u {y : ℝ³ | 0 < rad y} := by
    rw [hu_def]
    exact (hR.inv (fun y hy => Complex.ofReal_ne_zero.mpr (ne_of_gt hy))).mul hZ.contDiffOn
  have hune : ∀ y ∈ {y : ℝ³ | 0 < rad y}, u y ≠ 0 := by
    intro y hy
    rw [hu_def]
    exact mul_ne_zero (inv_ne_zero (Complex.ofReal_ne_zero.mpr (ne_of_gt hy))) (hZne y hy)

  have hE : ∀ K : ℤ, ContDiffOn ℝ ∞
      (fun y : ℝ³ => Complex.exp (Complex.I * (K : ℂ) * (thetaOf y : ℂ))) {y : ℝ³ | 0 < rad y} := by
    intro K
    have hid : ∀ y ∈ {y : ℝ³ | 0 < rad y},
        Complex.exp (Complex.I * (K : ℂ) * (thetaOf y : ℂ)) = u y ^ K := by
      intro y hy
      have h1 := Complex.norm_mul_exp_arg_mul_I (Z y)
      have hth : thetaOf y = Complex.arg (Z y) := rfl
      have hr : ((‖Z y‖ : ℝ) : ℂ) ≠ 0 := by
        rw [hnorm y]; exact Complex.ofReal_ne_zero.mpr (ne_of_gt hy)
      have h2 : Complex.exp ((thetaOf y : ℂ) * Complex.I) = u y := by
        rw [hth, hu_def]
        show _ = ((rad y : ℝ) : ℂ)⁻¹ * Z y
        rw [← hnorm y, eq_inv_mul_iff_mul_eq₀ hr]
        exact h1
      rw [show Complex.I * (K : ℂ) * (thetaOf y : ℂ) = (K : ℂ) * ((thetaOf y : ℂ) * Complex.I) by ring,
        Complex.exp_int_mul, h2]
    refine ContDiffOn.congr ?_ hid
    cases K with
    | ofNat n =>
      refine (hu.pow n).congr (fun y _ => ?_)
      simp
    | negSucc n =>
      refine ((hu.pow (n + 1)).inv (fun y hy => pow_ne_zero _ (hune y hy))).congr (fun y _ => ?_)
      exact zpow_negSucc _ _

  have hF : ∀ T : Finset Lab, ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => (∑ γ ∈ T, ∑ m ∈ H, c γ m (Ψ w) *
      Complex.exp (Complex.I * (N γ m : ℂ) * (thetaOf w.1 : ℂ))).re) Ω := by
    intro T
    have hs : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => ∑ γ ∈ T, ∑ m ∈ H, c γ m (Ψ w) *
        Complex.exp (Complex.I * (N γ m : ℂ) * (thetaOf w.1 : ℂ))) Ω := by
      apply ContDiffOn.sum
      intro γ _
      apply ContDiffOn.sum
      intro m _
      exact ((hc γ m).comp hΨ hmaps).mul
        ((hE (N γ m)).comp contDiff_fst.contDiffOn (fun w hw => hrad w hw))
    refine (Complex.reCLM.contDiff.comp_contDiffOn hs).congr (fun w _ => ?_)
    simp

  apply contDiffOn_of_locally_contDiffOn
  intro w₀ hw₀
  obtain ⟨U, hU, hξU, T, hT⟩ := hloc (Ψ w₀) (hmaps hw₀)
  refine ⟨Ω ∩ Ψ ⁻¹' U, hΨ.continuousOn.isOpen_inter_preimage hΩ hU, ⟨hw₀, hξU⟩, ?_⟩
  refine ((hF T).mono inter_subset_left).congr (fun w hw => ?_)
  have hwΩ : w ∈ Ω := hw.1
  have hwU : Ψ w ∈ U := hw.2.2
  have hwD : Ψ w ∈ D := hmaps hwΩ
  congr 1
  have hin : ∀ γ : Lab, ∑ᶠ m : ℤ, c γ m (Ψ w) *
      Complex.exp (Complex.I * (N γ m : ℂ) * (thetaOf w.1 : ℂ)) =
      ∑ m ∈ H, c γ m (Ψ w) * Complex.exp (Complex.I * (N γ m : ℂ) * (thetaOf w.1 : ℂ)) := by
    intro γ
    apply finsum_eq_sum_of_support_subset
    intro m hm
    by_contra hmH
    exact hm (by simp [hH γ m hmH (Ψ w) hwD])
  rw [finsum_congr hin]
  apply finsum_eq_sum_of_support_subset
  intro γ hγ
  by_contra hγT
  apply hγ
  apply Finset.sum_eq_zero
  intro m _
  simp [hT γ hγT m (Ψ w) ⟨hwU, hwD⟩]

theorem swirl_div_zero : ∀ (G : ℝ × ℝ → ℝ) (φ : ℝ³ → ℝ) (x : ℝ³), (∀ y, φ y = G (rad y, y 2)) →
    DifferentiableAt ℝ φ x →
    DifferentiableAt ℝ (fun y => φ y • azVec y) x ∧ divergence (fun y => φ y • azVec y) x = 0 :=
by
  intro G φ x hG hφ

  set L : ℝ³ →L[ℝ] ℝ³ :=
    (-(EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ)).smulRight (EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) +
    (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).smulRight (EuclideanSpace.single (1 : Fin 3) (1 : ℝ))
    with hLdef
  have hL : (⇑L : ℝ³ → ℝ³) = azVec := by
    funext y
    simp only [hLdef, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply,
      ContinuousLinearMap.neg_apply]
    unfold azVec
    simp
  have hA : DifferentiableAt ℝ azVec x := by
    rw [← hL]; exact L.differentiableAt
  have hdivA : divergence azVec x = 0 := by
    unfold divergence
    rw [← hL, ContinuousLinearMap.fderiv]
    have e : ((L : ℝ³ →L[ℝ] ℝ³) : ℝ³ →ₗ[ℝ] ℝ³) =
        ((-(EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ)) : ℝ³ →ₗ[ℝ] ℝ).smulRight
          (EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) +
        ((EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ) : ℝ³ →ₗ[ℝ] ℝ).smulRight
          (EuclideanSpace.single (1 : Fin 3) (1 : ℝ)) := rfl
    rw [e, map_add, LinearMap.trace_smulRight, LinearMap.trace_smulRight]
    simp

  have hrot : fderiv ℝ φ x (azVec x) = 0 := by
    set w : ℝ³ := x 0 • EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
      x 1 • EuclideanSpace.single (1 : Fin 3) (1 : ℝ) with hw
    set a : ℝ³ := azVec x with ha
    set c : ℝ → ℝ³ := fun θ => x + ((Real.cos θ - 1) • w + Real.sin θ • a) with hc
    have ha0 : a 0 = -(x 1) := by rw [ha]; unfold azVec; simp
    have ha1 : a 1 = x 0 := by rw [ha]; unfold azVec; simp
    have ha2 : a 2 = 0 := by rw [ha]; unfold azVec; simp
    have hc0 : ∀ θ, c θ 0 = x 0 * Real.cos θ - x 1 * Real.sin θ := by
      intro θ
      simp only [hc, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, ha0, hw]
      simp
      ring
    have hc1 : ∀ θ, c θ 1 = x 1 * Real.cos θ + x 0 * Real.sin θ := by
      intro θ
      simp only [hc, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, ha1, hw]
      simp
      ring
    have hc2 : ∀ θ, c θ 2 = x 2 := by
      intro θ
      simp only [hc, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, ha2, hw]
      simp
    have hrad : ∀ θ, rad (c θ) = rad x := by
      intro θ
      unfold rad
      rw [hc0, hc1]
      congr 1
      linear_combination (x 0 ^ 2 + x 1 ^ 2) * Real.cos_sq_add_sin_sq θ
    have hconst : (φ ∘ c) = fun _ => φ x := by
      funext θ
      simp only [Function.comp_apply]
      rw [hG (c θ), hG x, hrad θ, hc2 θ]
    have hd1 : HasDerivAt (φ ∘ c) 0 0 := by
      rw [hconst]; exact hasDerivAt_const _ _
    have hcd : HasDerivAt c a 0 := by
      have h1 : HasDerivAt (fun θ => (Real.cos θ - 1) • w) ((-Real.sin 0) • w) 0 :=
        ((Real.hasDerivAt_cos 0).sub_const 1).smul_const w
      have h2 : HasDerivAt (fun θ => Real.sin θ • a) (Real.cos 0 • a) 0 :=
        (Real.hasDerivAt_sin 0).smul_const a
      have h3 := (h1.add h2).const_add x
      simp only [Real.sin_zero, Real.cos_zero, neg_zero, zero_smul, one_smul, zero_add] at h3
      exact h3
    have hcx : x = c 0 := by simp [hc]
    have hd2 : HasDerivAt (φ ∘ c) (fderiv ℝ φ x a) 0 :=
      HasFDerivAt.comp_hasDerivAt_of_eq 0 hφ.hasFDerivAt hcd hcx
    exact hd2.unique hd1
  refine ⟨hφ.smul hA, ?_⟩
  unfold divergence at hdivA ⊢
  have hfd : HasFDerivAt (fun y => φ y • azVec y)
      (φ x • fderiv ℝ azVec x + (fderiv ℝ φ x).smulRight (azVec x)) x :=
    hφ.hasFDerivAt.smul hA.hasFDerivAt
  rw [hfd.fderiv]
  have e : ((φ x • fderiv ℝ azVec x + (fderiv ℝ φ x).smulRight (azVec x) : ℝ³ →L[ℝ] ℝ³) :
      ℝ³ →ₗ[ℝ] ℝ³) = φ x • ((fderiv ℝ azVec x : ℝ³ →L[ℝ] ℝ³) : ℝ³ →ₗ[ℝ] ℝ³) +
        (fderiv ℝ φ x : ℝ³ →ₗ[ℝ] ℝ).smulRight (azVec x) := rfl
  rw [e, map_add, map_smul, LinearMap.trace_smulRight, hdivA, smul_zero, zero_add]
  exact hrot

theorem state_flow_props_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (bw ca cm cd : ℝ), B.ok →
    GeomPrim5 B G → qsOf l0 ≤ B.qB → StOrd5 B G l0 S bw ca cm cd → ∀ Y₀ : ℝ × ℝ,
    IsOpen {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} ∧
    ContDiffOn ℝ ∞ (↿(evOff B.h (uX5 B G l0 S) Y₀)) {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} ∧
    ContDiffOn ℝ ∞ (↿(evOff B.h (PX5 B G l0 S) Y₀)) {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} ∧
    ∀ x t, corrOn B l0 x t → divergence (fun y => evOff B.h (uX5 B G l0 S) Y₀ y t) x = 0 :=
by
  intro B G l0 S bw ca cm cd hok hG hqsB hSt Y₀
  obtain ⟨hΩo, hΨ, hQs, hrad, heR, heTh⟩ := corr_domain_v5 B l0 Y₀ hok
  set Ω : Set (ℝ³ × ℝ) := {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} with hΩdef
  set Ψ : ℝ³ × ℝ → Cyl := fun w => ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y₀) with hΨdef
  have hSP : SimScaleProps B.h := hok.1
  have hBP := hok.2
  unfold BackgroundProps at hBP
  obtain ⟨-, -, -, ⟨hABs, hBvBs, hPBs⟩, hB4, -⟩ := hBP
  obtain ⟨hAw, hpw, hPsi, hbdir, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hpm, -, -, -⟩ := hSt
  have hΩmem : ∀ w ∈ Ω, corrOn B l0 w.1 w.2 := fun w hw => hw
  have hΩsub : Ω ⊆ simDomain B.h B.qB := fun w hw =>
    ⟨(hΩmem w hw).2.1, lt_of_lt_of_le (hΩmem w hw).2.2 hqsB⟩
  have hΨmaps : MapsTo Ψ Ω (DomC B.h (qsOf l0)) := fun w hw => hw
  have hQpos : ∀ w ∈ Ω, 0 < simScale B.h (w.1 2) (1 - w.2) := fun w hw =>
    (hSP.1 (w.1 2) (1 - w.2) (by linarith [(hΩmem w hw).2.1])).1
  have hQΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2)) Ω :=
    hQs.mono (fun w hw => (hΩmem w hw).2.1)
  have hQp : ∀ p : ℝ, ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => simScale B.h (w.1 2) (1 - w.2) ^ p) Ω :=
    fun p => hQΩ.rpow_const_of_ne (fun w hw => (hQpos w hw).ne')
  have heRΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => eR w.1) Ω :=
    heR.comp contDiff_fst.contDiffOn (fun w hw => (hΩmem w hw).1)
  have heThΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => eTh w.1) Ω :=
    heTh.comp contDiff_fst.contDiffOn (fun w hw => (hΩmem w hw).1)
  have hradΩ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => rad w.1) Ω :=
    hrad.comp contDiff_fst.contDiffOn (fun w hw => (hΩmem w hw).1)
  have hbase : ∀ (l : ℕ) (i : Fin 3), ContDiffOn ℝ ∞ (fun ξ => baseC B l ξ i) (DomC B.h (qsOf l0)) := by
    intro l i
    have h1 := (geom_slow_base_smooth_v5 B hok).2 l i
    have hp : ContDiff ℝ ∞ (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) :=
      contDiff_fst.prodMk ((contDiff_fst.comp contDiff_snd).prodMk
        (contDiff_fst.comp (contDiff_snd.comp contDiff_snd)))
    have hmaps : MapsTo (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) (DomC B.h (qsOf l0))
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} := by
      intro ξ hξ
      have h3 : qC B.h ξ < B.qB := lt_of_lt_of_le hξ.2.2 hqsB
      exact ⟨hξ.1, hξ.2.1, h3⟩
    have hcomp := h1.comp hp.contDiffOn hmaps
    refine hcomp.congr (fun ξ _ => ?_)
    simp only [Function.comp_apply, baseC]
  have hwave : ∀ a : WS, (∃ H : Finset ℤ, ∀ γ m, m ∉ H → a γ m = 0) →
      (∀ γ m, ContDiffOn ℝ ∞ (a γ m) (DomC B.h (qsOf l0))) →
      (∀ γ m ξ, ξ ∈ DomC B.h (qsOf l0) → a γ m ξ ≠ 0 → SuppW B G γ ξ) →
      ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => waveS5 B G a (thetaOf w.1) (Ψ w)) Ω := by
    intro a hHa ha hsupp
    obtain ⟨H, hH⟩ := hHa
    have hfac : ∀ w : ℝ³ × ℝ, waveS5 B G a (thetaOf w.1) (Ψ w) =
        (∑ᶠ γ : Lab, ∑ᶠ m : ℤ, a γ m (Ψ w) * Complex.exp (Complex.I * (m : ℂ) *
          ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (Ψ w) : ℂ))) *
          Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf w.1 : ℂ))).re := by
      intro w
      unfold waveS5
      congr 1
      refine finsum_congr (fun γ => finsum_congr (fun m => ?_))
      unfold ephase5
      have key : Complex.I * (m : ℂ) * ((pint5 B G γ : ℂ) * (thetaOf w.1 : ℂ) +
          (kb B.h γ.1 : ℂ) * (phiL5 B G γ (Ψ w) : ℂ)) =
          Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ (Ψ w) : ℂ)) +
          Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (thetaOf w.1 : ℂ) := by
        push_cast; ring
      rw [key, Complex.exp_add]
      ring
    refine (wave_sum_assembly Ω (DomC B.h (qsOf l0)) Ψ
      (fun γ m ξ => a γ m ξ * Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))))
      (fun γ m => m * pint5 B G γ) H hΩo (fun w hw => (hΩmem w hw).1) hΨ hΨmaps ?_ ?_
      (fun γ m => wave_coef_phase_smooth_v5 B G (qsOf l0) a hG hbase ha hsupp γ m)).congr
      (fun w _ => hfac w)
    · intro γ m hm ξ _
      simp [hH γ m hm]
    · intro ξ₀ hξ₀
      obtain ⟨U, hU, hξU, T, hT⟩ := etaL_locfin B.h (qsOf l0) hSP ξ₀ hξ₀
      refine ⟨U, hU, hξU, T, fun γ hγ m ξ hξ => ?_⟩
      by_contra hne
      have ha0 : a γ m ξ ≠ 0 := fun h0 => hne (by simp [h0])
      exact hT γ hγ ξ hξ.1 (hsupp γ m ξ hξ.2 ha0).2.1
  obtain ⟨HA, -, hHA⟩ := hAw.1
  have hW : ∀ i : Fin 3, ContDiffOn ℝ ∞
      (fun w : ℝ³ × ℝ => waveS5 B G (fun γ m ξ => S.Aw γ m ξ i) (thetaOf w.1) (Ψ w)) Ω := by
    intro i
    refine hwave (fun γ m ξ => S.Aw γ m ξ i) ⟨HA, fun γ m hm => ?_⟩
      (fun γ m => contDiffOn_pi.mp (hAw.2.1 γ m) i) (fun γ m ξ hξ hne => ?_)
    · funext ξ
      simp [hHA γ m hm]
    · exact hAw.2.2.2.1 γ m ξ hξ (fun h0 => hne (by simp [h0]))
  obtain ⟨HP, -, hHP⟩ := hpw.1
  have hWp : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => waveS5 B G S.pw (thetaOf w.1) (Ψ w)) Ω :=
    hwave S.pw ⟨HP, hHP⟩ hpw.2.1 hpw.2.2.2.1
  have hAeq : ∀ w ∈ Ω, (↿(evOff B.h (AX5 B G l0 S) Y₀)) w = B.AB w.1 w.2 +
      simScale B.h (w.1 2) (1 - w.2) ^ (1/2 - Aex B.h) •
        (waveS5 B G (fun γ m ξ => S.Aw γ m ξ 0) (thetaOf w.1) (Ψ w) • eR w.1 +
         waveS5 B G (fun γ m ξ => S.Aw γ m ξ 1) (thetaOf w.1) (Ψ w) • eTh w.1 +
         waveS5 B G (fun γ m ξ => S.Aw γ m ξ 2) (thetaOf w.1) (Ψ w) • eZ +
         S.Psi (Ψ w) • eTh w.1) := by
    intro w hw
    have hw' : corrOn B l0 w.1 w.2 := hw
    change B.AB w.1 w.2 + _ = _
    rw [if_pos hw']
    all_goals rfl
  have hBeq : ∀ w ∈ Ω, (↿(evOff B.h (BX B G l0 S) Y₀)) w = B.BvB w.1 w.2 +
      (simScale B.h (w.1 2) (1 - w.2) ^ (-Aex B.h) * S.bdir (Ψ w)) • eTh w.1 := by
    intro w hw
    have hw' : corrOn B l0 w.1 w.2 := hw
    change B.BvB w.1 w.2 + _ = _
    rw [if_pos hw']
    all_goals rfl
  have hPeq : ∀ w ∈ Ω, (↿(evOff B.h (PX5 B G l0 S) Y₀)) w = B.PB w.1 w.2 +
      (simScale B.h (w.1 2) (1 - w.2) ^ (-(2 * Aex B.h)) * nrm B (2 * Aex B.h) (pmP5 B G l0 S) (Ψ w) +
       simScale B.h (w.1 2) (1 - w.2) ^ (-2 * Aex B.h) * waveS5 B G S.pw (thetaOf w.1) (Ψ w)) := by
    intro w hw
    have hw' : corrOn B l0 w.1 w.2 := hw
    have hq := hQpos w hw
    have e : pmP5 B G l0 S (Ψ w) =
        simScale B.h (w.1 2) (1 - w.2) ^ (-(2 * Aex B.h)) * nrm B (2 * Aex B.h) (pmP5 B G l0 S) (Ψ w) := by
      show pmP5 B G l0 S (Ψ w) = simScale B.h (w.1 2) (1 - w.2) ^ (-(2 * Aex B.h)) *
        (simScale B.h (w.1 2) (1 - w.2) ^ (2 * Aex B.h) * pmP5 B G l0 S (Ψ w))
      rw [← mul_assoc, ← Real.rpow_add hq, neg_add_cancel, Real.rpow_zero, one_mul]
    change B.PB w.1 w.2 + _ = _
    rw [if_pos hw', ← e]
    all_goals rfl
  have hAsm : ContDiffOn ℝ ∞ (↿(evOff B.h (AX5 B G l0 S) Y₀)) Ω :=
    ContDiffOn.congr ((hABs.mono hΩsub).add ((hQp (1/2 - Aex B.h)).smul
      (((((hW 0).smul heRΩ).add ((hW 1).smul heThΩ)).add ((hW 2).smul (contDiffOn_const (c := eZ)))).add
        ((hPsi.1.comp hΨ hΨmaps).smul heThΩ)))) hAeq
  have hBsm : ContDiffOn ℝ ∞ (↿(evOff B.h (BX B G l0 S) Y₀)) Ω :=
    ContDiffOn.congr ((hBvBs.mono hΩsub).add
      (((hQp (-Aex B.h)).mul (hbdir.1.comp hΨ hΨmaps)).smul heThΩ)) hBeq
  have hPsm : ContDiffOn ℝ ∞ (↿(evOff B.h (PX5 B G l0 S) Y₀)) Ω :=
    ContDiffOn.congr ((hPBs.mono hΩsub).add (((hQp (-(2 * Aex B.h))).mul (hpm.1.comp hΨ hΨmaps)).add
      ((hQp (-2 * Aex B.h)).mul hWp))) hPeq
  have hUeq : evOff B.h (uX5 B G l0 S) Y₀ = fun y s =>
      curl3 (fun w => evOff B.h (AX5 B G l0 S) Y₀ w s) y + evOff B.h (BX B G l0 S) Y₀ y s := by
    funext y s
    simp only [evOff, uX5, curlX, add_sub_cancel_left]
  refine ⟨hΩo, ?_, hPsm, ?_⟩
  · rw [hUeq]
    exact (curl_field_contDiffOn_bounded _ _ Ω Ω hΩo subset_rfl hAsm hBsm).1
  · intro x t hxt
    have hxtΩ : (x, t) ∈ Ω := hxt
    have hnhds : Ω ∈ nhds (x, t) := hΩo.mem_nhds hxtΩ
    have hemb : ContDiff ℝ ∞ (fun y : ℝ³ => (y, t)) := contDiff_id.prodMk contDiff_const
    have hsl : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (g : ℝ³ × ℝ → F),
        ContDiffOn ℝ ∞ g Ω → ContDiffAt ℝ ∞ (fun y => g (y, t)) x :=
      fun g hg => (hg.contDiffAt hnhds).comp x hemb.contDiffAt
    have hAat : ContDiffAt ℝ ∞ (fun y => evOff B.h (AX5 B G l0 S) Y₀ y t) x := by
      have := hsl _ hAsm; exact this
    have hcurl := curl3_differentiable_divergence_zero (fun w => evOff B.h (AX5 B G l0 S) Y₀ w t) x
      (hAat.of_le (by norm_num))
    have hBd : DifferentiableAt ℝ (fun y => evOff B.h (BX B G l0 S) Y₀ y t) x := by
      have := (hsl _ hBsm).differentiableAt (by norm_num); exact this
    have hBvBd : DifferentiableAt ℝ (fun y => B.BvB y t) x := by
      have := (hsl _ (hBvBs.mono hΩsub)).differentiableAt (by norm_num); exact this
    set φ : ℝ³ → ℝ := fun y => simScale B.h (y 2) (1 - t) ^ (-Aex B.h) * S.bdir (Ψ (y, t)) * (rad y)⁻¹
      with hφdef
    have hf : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ =>
        simScale B.h (w.1 2) (1 - w.2) ^ (-Aex B.h) * S.bdir (Ψ w) * (rad w.1)⁻¹) Ω :=
      ((hQp (-Aex B.h)).mul (hbdir.1.comp hΨ hΨmaps)).mul
        (hradΩ.inv (fun w hw => (hΩmem w hw).1.ne'))
    have hφd : DifferentiableAt ℝ φ x := by
      have := (hsl _ hf).differentiableAt (by norm_num); exact this
    obtain ⟨hsd, hsdiv⟩ := swirl_div_zero
      (fun p : ℝ × ℝ => simScale B.h p.2 (1 - t) ^ (-Aex B.h) *
        S.bdir (p.1, p.2, t, Yph B.h p.1 t + Y₀) * p.1⁻¹)
      φ x (fun y => rfl) hφd
    have hBloc : (fun y => evOff B.h (BX B G l0 S) Y₀ y t) =ᶠ[nhds x]
        (fun y => B.BvB y t + φ y • azVec y) := by
      have hO : {y : ℝ³ | (y, t) ∈ Ω} ∈ nhds x :=
        hemb.continuous.continuousAt.preimage_mem_nhds hnhds
      filter_upwards [hO] with y hy
      have e1 := hBeq (y, t) hy
      have e2 : eTh y = (rad y)⁻¹ • azVec y := rfl
      exact e1.trans (by rw [e2, smul_smul])
    have hdivB : divergence (fun y => evOff B.h (BX B G l0 S) Y₀ y t) x = 0 := by
      have e : divergence (fun y => evOff B.h (BX B G l0 S) Y₀ y t) x =
          divergence (fun y => B.BvB y t + φ y • azVec y) x := by
        unfold divergence
        rw [hBloc.fderiv_eq]
      rw [e, divergence_add hBvBd hsd, (hB4 x t (hΩsub hxtΩ)).1, hsdiv, add_zero]
    rw [hUeq]
    show divergence (fun y => curl3 (fun w => evOff B.h (AX5 B G l0 S) Y₀ w t) y +
      evOff B.h (BX B G l0 S) Y₀ y t) x = 0
    rw [divergence_add hcurl.1 hBd, hcurl.2, hdivB, add_zero]

theorem cyl_param_integral_contDiffOn : ∀ (U : Set Cyl) (g : ℝ × Cyl → ℝ), IsOpen U →
    ContDiffOn ℝ ∞ g (univ ×ˢ U) →
    ContDiffOn ℝ ∞ (fun ξ : Cyl => ∫ θ in (0:ℝ)..(2 * Real.pi), g (θ, ξ)) U :=
by
  intro U g hUo hg
  have hO : IsOpen ((univ : Set ℝ) ×ˢ U) := isOpen_univ.prod hUo
  have param_fderiv : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
      (H : ℝ × Cyl → F), ContDiffOn ℝ ∞ H (univ ×ˢ U) →
      ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => fderiv ℝ (fun w' => H (p.1, w')) p.2) (univ ×ˢ U) := by
    intro F _ _ H hH p hp
    have hHa : ContDiffAt ℝ ∞ H p := hH.contDiffAt (hO.mem_nhds hp)
    apply ContDiffAt.contDiffWithinAt
    have h1 : ContDiffAt ℝ ∞ (Function.uncurry (fun (q : ℝ × Cyl) (w' : Cyl) => H (q.1, w')))
        (p, p.2) := by
      have e : Function.uncurry (fun (q : ℝ × Cyl) (w' : Cyl) => H (q.1, w')) =
          H ∘ (fun z : (ℝ × Cyl) × Cyl => (z.1.1, z.2)) := rfl
      rw [e]
      apply ContDiffAt.comp (g := H) (p, p.2)
      · simpa using hHa
      · fun_prop
    exact ContDiffAt.fderiv (f := fun (q : ℝ × Cyl) (w' : Cyl) => H (q.1, w'))
      (g := Prod.snd) h1 contDiffAt_snd (le_of_eq ENat.coe_top_add_one)
  have param_hasFDeriv : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (H : ℝ × Cyl → F), ContDiffOn ℝ ∞ H (univ ×ˢ U) → ∀ w ∈ U,
      HasFDerivAt (fun w' => ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w'))
        (∫ φ in (0:ℝ)..(2 * Real.pi), fderiv ℝ (fun w' => H (φ, w')) w) w := by
    intro F _ _ _ H hH w hw
    have hHs := param_fderiv H hH
    obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hUo w hw
    set s := Metric.closedBall w (δ / 2) with hs
    have hsU : s ⊆ U := (Metric.closedBall_subset_ball (by linarith)).trans hball
    have hsn : s ∈ nhds w := Metric.closedBall_mem_nhds w (by linarith)
    have hK : IsCompact (Icc (0:ℝ) (2 * Real.pi) ×ˢ s) := isCompact_Icc.prod (isCompact_closedBall _ _)
    have hKsub : Icc (0:ℝ) (2 * Real.pi) ×ˢ s ⊆ univ ×ˢ U := fun z hz => ⟨mem_univ _, hsU hz.2⟩
    obtain ⟨B, hB⟩ := hK.exists_bound_of_continuousOn (hHs.continuousOn.mono hKsub)
    have hcontφ : ∀ x ∈ U, Continuous (fun φ : ℝ => H (φ, x)) := by
      intro x hx
      exact hH.continuousOn.comp_continuous (by fun_prop) (fun φ => ⟨mem_univ _, hx⟩)
    have hcontφ' : ∀ x ∈ U, Continuous (fun φ : ℝ => fderiv ℝ (fun w' => H (φ, w')) x) := by
      intro x hx
      exact hHs.continuousOn.comp_continuous (f := fun φ : ℝ => ((φ, x) : ℝ × Cyl)) (by fun_prop)
        (fun φ => ⟨mem_univ _, hx⟩)
    have hpi : (0:ℝ) ≤ 2 * Real.pi := by positivity
    refine intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := volume)
      (F := fun x φ => H (φ, x)) (F' := fun x φ => fderiv ℝ (fun w' => H (φ, w')) x)
      (bound := fun _ => B) hsn ?_ ?_ ?_ ?_ ?_ ?_
    · filter_upwards [hUo.mem_nhds hw] with x hx
      exact (hcontφ x hx).aestronglyMeasurable
    · exact (hcontφ w hw).intervalIntegrable _ _
    · exact (hcontφ' w hw).aestronglyMeasurable
    · refine ae_of_all _ (fun φ hφ x hx => ?_)
      rw [Set.uIoc_of_le hpi] at hφ
      exact hB (φ, x) ⟨Set.Ioc_subset_Icc_self hφ, hx⟩
    · exact intervalIntegrable_const
    · refine ae_of_all _ (fun φ _ x hx => ?_)
      have hxU : x ∈ U := hsU hx
      have hHa : ContDiffAt ℝ ∞ H (φ, x) := hH.contDiffAt (hO.mem_nhds ⟨mem_univ _, hxU⟩)
      have : ContDiffAt ℝ ∞ (fun w' => H (φ, w')) x :=
        hHa.comp x (by fun_prop : ContDiffAt ℝ ∞ (fun w' : Cyl => ((φ, w') : ℝ × Cyl)) x)
      exact (this.differentiableAt (by simp)).hasFDerivAt
  have param_nat : ∀ (k : ℕ) {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
      [CompleteSpace F] (H : ℝ × Cyl → F), ContDiffOn ℝ ∞ H (univ ×ˢ U) →
      ContDiffOn ℝ k (fun w' => ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w')) U := by
    intro k
    induction k with
    | zero =>
      intro F _ _ _ H hH
      have hD : DifferentiableOn ℝ (fun w' => ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w')) U :=
        fun w hw => (param_hasFDeriv H hH w hw).differentiableAt.differentiableWithinAt
      rw [Nat.cast_zero]
      exact contDiffOn_zero.mpr hD.continuousOn
    | succ k ih =>
      intro F _ _ _ H hH
      have hD : DifferentiableOn ℝ (fun w' => ∫ φ in (0:ℝ)..(2 * Real.pi), H (φ, w')) U :=
        fun w hw => (param_hasFDeriv H hH w hw).differentiableAt.differentiableWithinAt
      have hCS : CompleteSpace (Cyl →L[ℝ] F) := ContinuousLinearMap.instCompleteSpace (E := Cyl)
      have hIH := @ih (Cyl →L[ℝ] F) _ _ hCS
        (fun p : ℝ × Cyl => fderiv ℝ (fun w' => H (p.1, w')) p.2) (param_fderiv H hH)
      rw [Nat.cast_succ]
      refine (contDiffOn_succ_iff_fderiv_of_isOpen hUo).mpr ⟨hD, fun h => ?_, ?_⟩
      · exact absurd h (by simp)
      · refine hIH.congr (fun w hw => ?_)
        exact (param_hasFDeriv H hH w hw).fderiv
  exact contDiffOn_infty.mpr (fun k => param_nat k g hg)

theorem wave5_locfin : ∀ (B : BG) (G : CorrGeom) (qs α : ℝ) (a : WC), B.ok → InWg5 B G qs α a →
    ∀ ξ₀ ∈ DomC B.h qs, ∃ N : Set Cyl, IsOpen N ∧ ξ₀ ∈ N ∧ ∃ (Γ : Finset Lab) (H : Finset ℤ),
      ∀ ξ ∈ N ∩ DomC B.h qs, ∀ (γ : Lab) (m : ℤ), a γ m ξ ≠ 0 → γ ∈ Γ ∧ m ∈ H :=
by
  intro B G qs α a hok hW ξ₀ hξ₀
  have hξ₀' : 0 < ξ₀.1 ∧ ξ₀.2.2.1 < 1 ∧ qC B.h ξ₀ < qs := hξ₀
  have hS : SimScaleProps B.h := hok.1
  obtain ⟨⟨H, -, hH⟩, -, -, hsupp, -⟩ := hW

  have etaL_loc : ∀ (h : ℝ), SimScaleProps h → ∀ ξ0 : Cyl, ξ0.2.2.1 < 1 → ∃ N ∈ nhds ξ0,
      ∃ Γ : Finset Lab, ∀ (γ : Lab) (ξ : Cyl), ξ ∈ N → ξ ∈ tsupport (etaL h γ) → γ ∈ Γ := by
    intro h hS ξ0 hξ0
    have hLc : ∀ ξ : Cyl, ξ.2.2.1 < 1 → ContinuousAt (fun η => Real.logb 2 (qC h η)) ξ := by
      intro ξ hξ
      have hτ : 0 < 1 - ξ.2.2.1 := by linarith
      have hqpos : 0 < qC h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
      have hqcont : ContinuousAt (qC h) ξ := by
        have hU : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
        have hp : ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) :=
          ⟨trivial, hτ⟩
        have hg : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (ξ.2.1, 1 - ξ.2.2.1) :=
          hS.2.2.2.1.continuousOn.continuousAt (hU.mem_nhds hp)
        have hk : ContinuousAt (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) ξ := by fun_prop
        have he : qC h = (fun w : ℝ × ℝ => simScale h w.1 w.2) ∘
            (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by
          funext η; rfl
        rw [he]
        exact ContinuousAt.comp hg hk
      exact hqcont.logb hqpos.ne'
    have hwin : ∀ (ξ : Cyl) (γ : Lab), ξ.2.2.1 < 1 → ξ ∈ tsupport (etaL h γ) →
        |Real.logb 2 (qC h ξ) + (γ.1:ℝ)| ≤ 1 ∧
        |chartR h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1:ℝ)| ≤ 1 ∧
        |chartZ h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.1:ℝ)| ≤ 1 ∧
        |chartT h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2:ℝ)| ≤ 1 := by
      intro ξ γ hξ hγ
      have s1 : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ → 1 < |φ ξ / μ - (j : ℝ)| →
          ∀ᶠ η in nhds ξ, sqPart μ j (φ η) = 0 := by
        intro μ j φ hφ h1
        have hψ : ContinuousAt (fun η => |φ η / μ - (j : ℝ)|) ξ :=
          ((hφ.div_const μ).sub continuousAt_const).abs
        have hev := (continuousAt_const : ContinuousAt (fun _ : Cyl => (1:ℝ)) ξ).eventually_lt hψ h1
        filter_upwards [hev] with η hη
        have hsq : 1 < (φ η / μ - (j : ℝ)) ^ 2 := (one_lt_sq_iff_one_lt_abs _).mpr hη
        unfold sqPart bumpR
        rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_div]
      have key : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ →
          (∀ η, sqPart μ j (φ η) = 0 → etaL h γ η = 0) → |φ ξ / μ - (j:ℝ)| ≤ 1 := by
        intro μ j φ hφ himp
        by_contra hc
        push_neg at hc
        have hev := s1 μ j φ hφ hc
        apply (notMem_tsupport_iff_eventuallyEq.mpr _) hγ
        filter_upwards [hev] with η hη
        exact himp η hη
      refine ⟨?_, ?_, ?_, ?_⟩
      · have := key 1 (-(γ.1:ℤ)) (fun η => Real.logb 2 (qC h η)) (hLc ξ hξ)
          (fun η hη => by simp only [etaL, hη, zero_mul])
        simpa [div_one, sub_neg_eq_add] using this
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.1 (chartR h γ.1) (by unfold chartR; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.1 (chartZ h γ.1) (by unfold chartZ; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
      · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.2 (chartT h γ.1) (by unfold chartT; fun_prop)
          (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
    obtain ⟨L0, hL0⟩ : ∃ L0 : ℝ, L0 = Real.logb 2 (qC h ξ0) := ⟨_, rfl⟩
    have hfin : (⋃ n ∈ Set.Iic ⌊2 - L0⌋₊, ({n} : Set ℕ) ×ˢ
        ((Set.Icc ⌈chartR h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartR h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋ ×ˢ
          Set.Icc ⌈chartZ h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartZ h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋ ×ˢ
          Set.Icc ⌈chartT h n ξ0 / Sb n ^ (-3:ℤ) - 2⌉ ⌊chartT h n ξ0 / Sb n ^ (-3:ℤ) + 2⌋) ×ˢ
          (Set.univ : Set Bool))).Finite := by
      refine Set.Finite.biUnion (Set.finite_Iic _) (fun n _ => ?_)
      exact (Set.finite_singleton n).prod (((Set.finite_Icc _ _).prod
        ((Set.finite_Icc _ _).prod (Set.finite_Icc _ _))).prod Set.finite_univ)
    have hI : ∀ (x c : ℝ) (j : ℤ), |x - (j:ℝ)| ≤ 1 → |x - c| < 1 → j ∈ Set.Icc ⌈c - 2⌉ ⌊c + 2⌋ := by
      intro x c j hj hc
      rw [abs_le] at hj
      rw [abs_lt] at hc
      exact ⟨Int.ceil_le.mpr (by linarith [hj.2, hc.1]), Int.le_floor.mpr (by linarith [hj.1, hc.2])⟩
    have hcR : ∀ n : ℕ, ContinuousAt (chartR h n) ξ0 := fun n => by unfold chartR; fun_prop
    have hcZ : ∀ n : ℕ, ContinuousAt (chartZ h n) ξ0 := fun n => by unfold chartZ; fun_prop
    have hcT : ∀ n : ℕ, ContinuousAt (chartT h n) ξ0 := fun n => by unfold chartT; fun_prop
    have hch : ∀ (φ : Cyl → ℝ) (μ : ℝ), ContinuousAt φ ξ0 →
        ∀ᶠ ξ in nhds ξ0, |φ ξ / μ - φ ξ0 / μ| < 1 := by
      intro φ μ hφ
      exact (((hφ.div_const μ).sub continuousAt_const).abs).eventually_lt continuousAt_const
        (by simp)
    have e1 : ∀ᶠ ξ in nhds ξ0, ξ.2.2.1 < 1 :=
      (show ContinuousAt (fun ξ : Cyl => ξ.2.2.1) ξ0 by fun_prop).eventually_lt
        continuousAt_const hξ0
    have e2 : ∀ᶠ ξ in nhds ξ0, |Real.logb 2 (qC h ξ) - L0| < 1 :=
      (((hLc ξ0 hξ0).sub continuousAt_const).abs).eventually_lt continuousAt_const
        (by simp [hL0])
    have e3 : ∀ᶠ ξ in nhds ξ0, ∀ n ∈ Finset.range (⌊2 - L0⌋₊ + 1),
        |chartR h n ξ / Sb n ^ (-3:ℤ) - chartR h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartZ h n ξ / Sb n ^ (-3:ℤ) - chartZ h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartT h n ξ / Sb n ^ (-3:ℤ) - chartT h n ξ0 / Sb n ^ (-3:ℤ)| < 1 := by
      rw [Filter.eventually_all_finset]
      intro n _
      exact (hch _ _ (hcR n)).and ((hch _ _ (hcZ n)).and (hch _ _ (hcT n)))
    refine ⟨{ξ | ξ.2.2.1 < 1 ∧ |Real.logb 2 (qC h ξ) - L0| < 1 ∧
        ∀ n ∈ Finset.range (⌊2 - L0⌋₊ + 1),
        |chartR h n ξ / Sb n ^ (-3:ℤ) - chartR h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartZ h n ξ / Sb n ^ (-3:ℤ) - chartZ h n ξ0 / Sb n ^ (-3:ℤ)| < 1 ∧
        |chartT h n ξ / Sb n ^ (-3:ℤ) - chartT h n ξ0 / Sb n ^ (-3:ℤ)| < 1}, ?_,
      hfin.toFinset, ?_⟩
    · filter_upwards [e1, e2, e3] with ξ h1 h2 h3
      exact ⟨h1, h2, h3⟩
    rintro ⟨n, ⟨a, b, c⟩, σ⟩ ξ ⟨ht, hL, hC⟩ hγ
    obtain ⟨w0, wR, wZ, wT⟩ := hwin ξ _ ht hγ
    simp only at w0 wR wZ wT
    rw [abs_le] at w0
    rw [abs_lt] at hL
    have hn : n ≤ ⌊2 - L0⌋₊ := Nat.le_floor (by linarith [w0.2, hL.1])
    obtain ⟨cR, cZ, cT⟩ := hC n (Finset.mem_range.mpr (Nat.lt_succ_of_le hn))
    rw [Set.Finite.mem_toFinset]
    refine Set.mem_iUnion₂.mpr ⟨n, hn, ?_⟩
    exact ⟨rfl, ⟨hI _ _ _ wR cR, hI _ _ _ wZ cZ, hI _ _ _ wT cT⟩, trivial⟩
  obtain ⟨N₀, hN₀, Γ, hΓ⟩ := etaL_loc B.h hS ξ₀ hξ₀'.2.1
  refine ⟨interior N₀, isOpen_interior, mem_interior_iff_mem_nhds.mpr hN₀, Γ, H, ?_⟩
  rintro ξ ⟨hξN, hξD⟩ γ m hne
  refine ⟨?_, ?_⟩
  · have hs := hsupp γ m ξ hξD hne
    exact hΓ γ ξ (interior_subset hξN) hs.2.1
  · by_contra hm
    apply hne
    rw [hH γ m hm]
    rfl

theorem wave5_term_contDiffOn : ∀ (B : BG) (G : CorrGeom) (qs α : ℝ) (a : WC), B.ok → GeomPrim5 B G →
    qs ≤ B.qB → InWg5 B G qs α a → ∀ (γ : Lab) (m : ℤ) (i : Fin 3),
      ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => a γ m p.2 i * ephase5 B G γ m p.1 p.2) (univ ×ˢ DomC B.h qs) :=
by
  intro B G qs α a hok hG hqs ha γ m i

  have hamp : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => a γ m p.2 i) (univ ×ˢ DomC B.h qs) := by
    have h1 : ContDiffOn ℝ ∞ (fun η => a γ m η i) (DomC B.h qs) := contDiffOn_pi.1 (ha.2.1 γ m) i
    exact h1.comp contDiff_snd.contDiffOn (fun p hp => hp.2)

  set v : Cyl → ℝ × ℝ := fun η => Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ with hv
  have hvc : Continuous v := by
    rw [hv]
    unfold Jpow
    fun_prop

  have hbase : ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun η : Cyl => baseC B γ.1 η j) (DomC B.h qs) := by
    intro j
    obtain ⟨_, hsm⟩ := geom_slow_base_smooth_v5 B hok
    have hπ : ContDiff ℝ ∞ (fun ξ : Cyl => ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ)) :=
      contDiff_fst.prodMk (contDiff_snd.fst.prodMk contDiff_snd.snd.fst)
    have hc := (hsm γ.1 j).comp hπ.contDiffOn
      (fun ξ (hξ : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs) =>
        (⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqs⟩ : ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ) ∈
          {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}))
    exact hc.congr (fun ξ _ => rfl)
  have hZ : ContDiff ℝ ∞ (fun η : Cyl => chartZ B.h γ.1 η) := by
    unfold chartZ
    exact contDiff_snd.fst.div_const _
  have hRC : ContDiff ℝ ∞ (fun η : Cyl => RC γ.1 η) := by
    unfold RC
    exact contDiff_fst.div_const _
  have hRCpos : ∀ η ∈ DomC B.h qs, RC γ.1 η ≠ 0 := by
    intro η hη
    have hr : 0 < η.1 := hη.1
    have : 0 < RC γ.1 η :=
      div_pos hr (Real.sqrt_pos.mpr (Real.rpow_pos_of_pos (by norm_num) _))
    exact this.ne'
  have hF : ContDiffOn ℝ ∞ (fun η : Cyl => Fang B γ.1 η) (DomC B.h qs) :=
    ((hbase 1).div hRC.contDiffOn hRCpos).congr (fun η _ => rfl)
  have hθ : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => ((p.1 : ℝ) : ℂ)) (univ ×ˢ DomC B.h qs) :=
    (Complex.ofRealCLM.contDiff.comp contDiff_fst).contDiffOn.congr
      (fun p _ => by simp only [Function.comp_apply, Complex.ofRealCLM_apply])
  apply contDiffOn_of_locally_contDiffOn
  rintro ⟨θ₀, ξ₀⟩ ⟨-, hξ₀⟩
  set U' : Set Cyl := {η | |(v η).1 - (v ξ₀).1| < 1/8} ∩ {η | |(v η).2 - (v ξ₀).2| < 1/8} with hU'
  have hU'o : IsOpen U' :=
    (isOpen_lt ((hvc.fst.sub continuous_const).abs) continuous_const).inter
      (isOpen_lt ((hvc.snd.sub continuous_const).abs) continuous_const)
  have hξU : ξ₀ ∈ U' := by
    refine ⟨?_, ?_⟩
    · show |(v ξ₀).1 - (v ξ₀).1| < 1/8
      rw [sub_self, abs_zero]; norm_num
    · show |(v ξ₀).2 - (v ξ₀).2| < 1/8
      rw [sub_self, abs_zero]; norm_num
  refine ⟨univ ×ˢ U', isOpen_univ.prod hU'o, ⟨mem_univ _, hξU⟩, ?_⟩
  by_cases hA : ∀ η ∈ DomC B.h qs ∩ U', a γ m η = 0
  ·
    refine (contDiffOn_const (c := (0:ℂ))).congr (fun p hp => ?_)
    have h0 := hA p.2 ⟨hp.1.2, hp.2.2⟩
    simp [h0]
  ·
    push_neg at hA
    obtain ⟨η1, ⟨hη1D, hη1U⟩, hη1⟩ := hA
    obtain ⟨-, -, hxi, het, -, -⟩ := ha.2.2.2.1 γ m η1 hη1D hη1
    have hr0 : G.r0 ≤ 1/100 := hG.1.2.1
    have hb0 : 0 ≤ bgc := by unfold bgc; linarith [Real.one_lt_sqrt_two]
    have hb1 : bgc ≤ 1 := by
      unfold bgc
      nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
    have hden : (1 + bgc ^ 2) * (1 + bgc ^ 2)⁻¹ = 1 := mul_inv_cancel₀ (by positivity)
    have id1 : ∀ w : ℝ × ℝ, w.1 = lamR w + bgc * lamT w := by
      intro w
      simp only [lamR, lamT, div_eq_mul_inv]
      linear_combination (-w.1) * hden
    have id2 : ∀ w : ℝ × ℝ, w.2 = -(bgc * lamR w) + lamT w := by
      intro w
      simp only [lamR, lamT, div_eq_mul_inv]
      linear_combination (-w.2) * hden
    have key : ∀ (R T : ℝ), |R| ≤ G.r0 / 4 → |T| ≤ G.r0 →
        |R + bgc * T| ≤ 1/80 ∧ |-(bgc * R) + T| ≤ 1/80 := by
      intro R T hR hT
      obtain ⟨hR1, hR2⟩ := abs_le.mp hR
      obtain ⟨hT1, hT2⟩ := abs_le.mp hT
      have hr0n : 0 ≤ G.r0 := le_trans (abs_nonneg _) hT
      have e1 : bgc * T ≤ G.r0 := by
        nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hT2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
      have e2 : -G.r0 ≤ bgc * T := by
        nlinarith [mul_nonneg hb0 (show 0 ≤ T + G.r0 by linarith),
          mul_nonneg (sub_nonneg.mpr hb1) hr0n]
      have e3 : bgc * R ≤ G.r0 / 4 := by
        nlinarith [mul_nonneg hb0 (sub_nonneg.mpr hR2), mul_nonneg (sub_nonneg.mpr hb1) hr0n]
      have e4 : -(G.r0 / 4) ≤ bgc * R := by
        nlinarith [mul_nonneg hb0 (show 0 ≤ R + G.r0 / 4 by linarith),
          mul_nonneg (sub_nonneg.mpr hb1) hr0n]
      exact ⟨abs_le.mpr ⟨by linarith, by linarith⟩, abs_le.mpr ⟨by linarith, by linarith⟩⟩
    have hround : ∀ (x : ℝ) (k : ℤ), |x - k| < 1/2 → round x = k := by
      intro x k hk
      rw [round_eq, Int.floor_eq_iff]
      obtain ⟨h1, h2⟩ := abs_lt.mp hk
      constructor <;> linarith
    have hw1 : |lamR (frac0 (v η1))| ≤ G.r0 / 4 := hxi
    have hw2 : |lamT (frac0 (v η1))| ≤ G.r0 := het
    have hw := key _ _ hw1 hw2
    have ex1 : (v η1).1 - ((round (v η1).1 : ℤ) : ℝ) =
        lamR (frac0 (v η1)) + bgc * lamT (frac0 (v η1)) := id1 (frac0 (v η1))
    have ex2 : (v η1).2 - ((round (v η1).2 : ℤ) : ℝ) =
        -(bgc * lamR (frac0 (v η1))) + lamT (frac0 (v η1)) := id2 (frac0 (v η1))
    have hx1 : |(v η1).1 - ((round (v η1).1 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex1]; exact hw.1
    have hx2 : |(v η1).2 - ((round (v η1).2 : ℤ) : ℝ)| ≤ 1/80 := by rw [ex2]; exact hw.2
    obtain ⟨kk, hkk⟩ : ∃ kk : ℝ × ℝ,
        kk = (((round (v η1).1 : ℤ) : ℝ), ((round (v η1).2 : ℤ) : ℝ)) := ⟨_, rfl⟩
    have hfr : ∀ η ∈ U', frac0 (v η) = v η - kk := by
      intro η hη
      have h1 : |(v η).1 - (v ξ₀).1| < 1/8 := hη.1
      have h2 : |(v η).2 - (v ξ₀).2| < 1/8 := hη.2
      have g1 : |(v η1).1 - (v ξ₀).1| < 1/8 := hη1U.1
      have g2 : |(v η1).2 - (v ξ₀).2| < 1/8 := hη1U.2
      obtain ⟨a1, a2⟩ := abs_lt.mp h1
      obtain ⟨a3, a4⟩ := abs_lt.mp h2
      obtain ⟨b1, b2⟩ := abs_lt.mp g1
      obtain ⟨b3, b4⟩ := abs_lt.mp g2
      obtain ⟨c1, c2⟩ := abs_le.mp hx1
      obtain ⟨c3, c4⟩ := abs_le.mp hx2
      have r1 : round (v η).1 = round (v η1).1 :=
        hround _ _ (abs_lt.mpr ⟨by linarith, by linarith⟩)
      have r2 : round (v η).2 = round (v η1).2 :=
        hround _ _ (abs_lt.mpr ⟨by linarith, by linarith⟩)
      rw [hkk]
      unfold frac0
      rw [r1, r2]
      rfl

    have hT : ContDiff ℝ ∞ (fun η : Cyl => lamT (v η - kk)) := by
      simp only [hv, lamT, Jpow, div_eq_mul_inv]
      fun_prop
    obtain ⟨M, hMdef⟩ : ∃ M : Cyl → ℝ, M = fun η : Cyl =>
        pzr5 B G γ * chartZ B.h γ.1 η / epsb B.h γ.1 + sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 * RC γ.1 η
        - (lamT (v η - kk) + G.r0) / cib B.h γ.1 *
          (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2) := ⟨_, rfl⟩
    have hM : ContDiffOn ℝ ∞ M (DomC B.h qs) := by
      rw [hMdef]
      exact ((((contDiffOn_const (c := pzr5 B G γ)).mul hZ.contDiffOn).div_const (epsb B.h γ.1)).add
        ((contDiffOn_const (c := sgn γ.2.2 * Bs5 B G γ * G.ustar / 2)).mul hRC.contDiffOn)).sub
        (((hT.contDiffOn.add (contDiffOn_const (c := G.r0))).div_const (cib B.h γ.1)).mul
          (((contDiffOn_const (c := pang5 B G γ)).mul hF).add
            ((contDiffOn_const (c := pzr5 B G γ)).mul (hbase 2))))
    have hmod : ∀ η ∈ U', phiL5 B G γ η = M η := by
      intro η hη
      have hvco : vco B.h G.r0 γ (G.ctr γ) η.2.2.2 = (lamT (v η - kk) + G.r0) / cib B.h γ.1 := by
        show (lamT (frac0 (v η)) + G.r0) / cib B.h γ.1 = _
        rw [hfr η hη]
      rw [hMdef]
      show phiL5 B G γ η = _
      unfold phiL5
      rw [hvco]
    have hMp : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => ((M p.2 : ℝ) : ℂ)) (univ ×ˢ DomC B.h qs) :=
      (Complex.ofRealCLM.contDiff.comp_contDiffOn
        (hM.comp contDiff_snd.contDiffOn (fun p hp => hp.2))).congr
        (fun p _ => by simp only [Function.comp_apply, Complex.ofRealCLM_apply])
    have hE : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => Complex.exp (Complex.I * (m : ℂ) *
        ((pint5 B G γ : ℂ) * ((p.1 : ℝ) : ℂ) + (kb B.h γ.1 : ℂ) * ((M p.2 : ℝ) : ℂ))))
        (univ ×ˢ DomC B.h qs) :=
      ((contDiffOn_const (c := Complex.I * (m : ℂ))).mul
        (((contDiffOn_const (c := (pint5 B G γ : ℂ))).mul hθ).add
          ((contDiffOn_const (c := (kb B.h γ.1 : ℂ))).mul hMp))).cexp
    refine ((hamp.mul hE).mono inter_subset_left).congr (fun p hp => ?_)
    have hpU : p.2 ∈ U' := hp.2.2
    show a γ m p.2 i * ephase5 B G γ m p.1 p.2 = _
    unfold ephase5
    rw [hmod p.2 hpU]

theorem thetaOf_periodic_comp : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (V : Set E) (Φ : ℝ × E → ℝ),
    ContDiffOn ℝ ∞ Φ (univ ×ˢ V) → (∀ (θ : ℝ) (e : E), Φ (θ + 2 * Real.pi, e) = Φ (θ, e)) →
    ContDiffOn ℝ ∞ (fun p : ℝ³ × E => Φ (thetaOf p.1, p.2)) ({y : ℝ³ | 0 < rad y} ×ˢ V) :=
by
  intro E _ _ V Φ hΦ hper
  set Z : ℝ³ → ℂ := fun y => (⟨y 0, y 1⟩ : ℂ) with hZdef
  have hp0 : ContDiff ℝ ∞ (fun y : ℝ³ => y 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).contDiff
  have hp1 : ContDiff ℝ ∞ (fun y : ℝ³ => y 1) :=
    (EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ).contDiff
  have hZeq : Z = fun y => Complex.ofRealCLM (y 0) + Complex.ofRealCLM (y 1) * Complex.I := by
    funext y; apply Complex.ext <;> simp [hZdef]
  have hZ : ContDiff ℝ ∞ Z := by
    rw [hZeq]
    exact (Complex.ofRealCLM.contDiff.comp hp0).add
      ((Complex.ofRealCLM.contDiff.comp hp1).mul contDiff_const)

  have harg : ∀ z : ℂ, z ∈ Complex.slitPlane → ContDiffAt ℝ ∞ Complex.arg z := by
    intro z hz
    have h1 : ContDiffAt ℝ ∞ Complex.log z := (Complex.contDiffAt_log hz).restrict_scalars ℝ
    have h2 : ContDiffAt ℝ ∞ (fun w => (Complex.log w).im) z :=
      Complex.imCLM.contDiff.contDiffAt.comp z h1
    have e : (fun w => (Complex.log w).im) = Complex.arg := by
      funext w; exact Complex.log_im w
    rwa [e] at h2

  have hbr : ∀ z : ℂ, z ≠ 0 → ∀ e : E,
      Φ (Complex.arg z, e) = Φ (Complex.arg (-z) + Real.pi, e) := by
    intro z hz e
    rcases lt_trichotomy z.im 0 with h | h | h
    · rw [Complex.arg_neg_eq_arg_add_pi_of_im_neg h,
        show z.arg + Real.pi + Real.pi = z.arg + 2 * Real.pi by ring, hper]
    · have hre : z.re ≠ 0 := by
        intro hr; apply hz; exact Complex.ext (by simp [hr]) (by simp [h])
      rcases lt_or_gt_of_ne hre with hr | hr
      · have h1 : z.arg = Real.pi := Complex.arg_eq_pi_iff.mpr ⟨hr, h⟩
        have h2 : (-z).arg = 0 :=
          Complex.arg_eq_zero_iff.mpr ⟨by simp only [Complex.neg_re]; linarith, by simp [h]⟩
        rw [h1, h2, zero_add]
      · have h1 : z.arg = 0 := Complex.arg_eq_zero_iff.mpr ⟨hr.le, h⟩
        have h2 : (-z).arg = Real.pi :=
          Complex.arg_eq_pi_iff.mpr ⟨by simp only [Complex.neg_re]; linarith, by simp [h]⟩
        rw [h1, h2, show Real.pi + Real.pi = 0 + 2 * Real.pi by ring, hper]
    · rw [Complex.arg_neg_eq_arg_sub_pi_of_im_pos h, sub_add_cancel]

  have hZne : ∀ y : ℝ³, 0 < rad y → Z y ≠ 0 := by
    intro y hy h
    have h0 : y 0 = 0 := by
      have := congrArg Complex.re h; simpa [hZdef] using this
    have h1 : y 1 = 0 := by
      have := congrArg Complex.im h; simpa [hZdef] using this
    simp [rad, h0, h1] at hy

  set N₁ : Set ℝ³ := Z ⁻¹' Complex.slitPlane with hN₁def
  set N₂ : Set ℝ³ := (fun y => -Z y) ⁻¹' Complex.slitPlane with hN₂def
  have hN₁ : IsOpen N₁ := Complex.isOpen_slitPlane.preimage hZ.continuous
  have hN₂ : IsOpen N₂ := Complex.isOpen_slitPlane.preimage hZ.continuous.neg
  have hcov : ∀ y : ℝ³, 0 < rad y → y ∈ N₁ ∨ y ∈ N₂ := by
    intro y hy
    by_cases h : Z y ∈ Complex.slitPlane
    · exact Or.inl h
    · right
      rw [Complex.mem_slitPlane_iff] at h
      push_neg at h
      have hre : (Z y).re ≠ 0 := fun hr =>
        hZne y hy (Complex.ext (by simp [hr]) (by simp [h.2]))
      show -Z y ∈ Complex.slitPlane
      rw [Complex.mem_slitPlane_iff]
      left
      simp only [Complex.neg_re]
      exact neg_pos.mpr (lt_of_le_of_ne h.1 hre)

  have hα₁ : ContDiffOn ℝ ∞ (fun y => Complex.arg (Z y)) N₁ := fun y hy =>
    ((harg _ hy).comp y hZ.contDiffAt).contDiffWithinAt
  have hα₂ : ContDiffOn ℝ ∞ (fun y => Complex.arg (-Z y) + Real.pi) N₂ := fun y hy =>
    (((harg _ hy).comp y hZ.neg.contDiffAt).add contDiffAt_const).contDiffWithinAt
  have hcomp : ∀ (α : ℝ³ → ℝ) (N : Set ℝ³), ContDiffOn ℝ ∞ α N →
      ContDiffOn ℝ ∞ (fun p : ℝ³ × E => Φ (α p.1, p.2)) (N ×ˢ V) := by
    intro α N hα
    have hψ : ContDiffOn ℝ ∞ (fun p : ℝ³ × E => (α p.1, p.2)) (N ×ˢ V) :=
      (hα.comp contDiff_fst.contDiffOn (fun p hp => hp.1)).prodMk contDiff_snd.contDiffOn
    exact hΦ.comp hψ (fun p hp => ⟨mem_univ _, hp.2⟩)

  apply contDiffOn_of_locally_contDiffOn
  rintro ⟨y, e⟩ ⟨hy, he⟩
  rcases hcov y hy with h | h
  · refine ⟨N₁ ×ˢ univ, hN₁.prod isOpen_univ, ⟨h, mem_univ _⟩, ?_⟩
    exact ((hcomp _ N₁ hα₁).mono (fun q hq => ⟨hq.2.1, hq.1.2⟩)).congr (fun q _ => rfl)
  · refine ⟨N₂ ×ˢ univ, hN₂.prod isOpen_univ, ⟨h, mem_univ _⟩, ?_⟩
    refine ((hcomp _ N₂ hα₂).mono (fun q hq => ⟨hq.2.1, hq.1.2⟩)).congr (fun q hq => ?_)
    exact hbr (Z q.1) (hZne q.1 hq.1.1) q.2

theorem ax5_lift_contDiffOn : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState), B.ok → qsOf l0 ≤ B.qB →
    InM B (qsOf l0) (1/2) S.Psi →
    (∀ i : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ³ × Cyl => waveV5 B G S.Aw (thetaOf p.1) p.2 i)
      ({y : ℝ³ | 0 < rad y} ×ˢ DomC B.h (qsOf l0))) →
    ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => AX5 B G l0 S w.1 w.2.1 (Yph B.h (rad w.1) w.2.1 + w.2.2))
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} :=
by
  intro B G l0 S hok hqB hPsi hW
  have hσ : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
    hok.1.2.2.2.1
  have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun x : ℝ³ => x i) := fun i => contDiff_piLp_apply 2

  have hf : ContDiff ℝ ∞ (fun x : ℝ³ => x 0 ^ 2 + x 1 ^ 2) := ((hc 0).pow 2).add ((hc 1).pow 2)
  have hrad : ContDiffOn ℝ ∞ rad {x : ℝ³ | 0 < rad x} := by
    have h := hf.contDiffOn.sqrt (s := {x : ℝ³ | 0 < rad x}) (fun x hx => by
      have hx' : 0 < Real.sqrt (x 0 ^ 2 + x 1 ^ 2) := hx
      exact (Real.sqrt_pos.mp hx').ne')
    exact h
  have hinv : ContDiffOn ℝ ∞ (fun x => (rad x)⁻¹) {x : ℝ³ | 0 < rad x} :=
    hrad.inv (fun x hx => ne_of_gt hx)
  have hrv : ContDiff ℝ ∞ radVec := by
    have h : ContDiff ℝ ∞ (fun x : ℝ³ => x 0 • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        x 1 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) :=
      ((hc 0).smul contDiff_const).add ((hc 1).smul contDiff_const)
    exact h
  have haz : ContDiff ℝ ∞ azVec := by
    have h : ContDiff ℝ ∞ (fun x : ℝ³ => -(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) :=
      ((hc 1).neg.smul contDiff_const).add ((hc 0).smul contDiff_const)
    exact h
  have heR : ContDiffOn ℝ ∞ eR {x : ℝ³ | 0 < rad x} := hinv.smul hrv.contDiffOn
  have heTh : ContDiffOn ℝ ∞ eTh {x : ℝ³ | 0 < rad x} := hinv.smul haz.contDiffOn

  have hfst : MapsTo (fun w : ℝ³ × ℝ × (ℝ × ℝ) => w.1) {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1}
      {x : ℝ³ | 0 < rad x} := fun w hw => hw.1
  have c1 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => rad w.1)
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} :=
    hrad.comp contDiff_fst.contDiffOn hfst
  have c2 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => w.1 2)
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} :=
    ((hc 2).comp contDiff_fst).contDiffOn
  have c3 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => w.2.1)
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} :=
    contDiff_snd.fst.contDiffOn
  have c4 : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => Yph B.h (rad w.1) w.2.1 + w.2.2)
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} := by
    have hp := c1.rpow_const_of_ne (p := drx B.h) (fun w hw => ne_of_gt hw.1)
    exact ((hp.smul contDiffOn_const).add (c3.smul contDiffOn_const)).add contDiff_snd.snd.contDiffOn
  have hξ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => ptOf w.1 w.2.1 (Yph B.h (rad w.1) w.2.1 + w.2.2))
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} :=
    c1.prodMk (c2.prodMk (c3.prodMk c4))
  have hmap : MapsTo (fun w : ℝ³ × ℝ × (ℝ × ℝ) => ptOf w.1 w.2.1 (Yph B.h (rad w.1) w.2.1 + w.2.2))
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} (DomC B.h (qsOf l0)) :=
    fun w hw => ⟨hw.1, hw.2.1, hw.2.2⟩

  have hq : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => simScale B.h (w.1 2) (1 - w.2.1))
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} := by
    have hg : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => ((w.1 2, 1 - w.2.1) : ℝ × ℝ)) :=
      ((hc 2).comp contDiff_fst).prodMk (contDiff_const.sub contDiff_snd.fst)
    exact hσ.comp hg.contDiffOn (fun w hw =>
      ⟨mem_univ _, show (0:ℝ) < 1 - w.2.1 by linarith [hw.2.1]⟩)
  have hpref : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) =>
      simScale B.h (w.1 2) (1 - w.2.1) ^ (1/2 - Aex B.h))
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} :=
    hq.rpow_const_of_ne (fun w hw =>
      ((hok.1.1 (w.1 2) (1 - w.2.1) (by linarith [hw.2.1])).1).ne')

  have hBP := hok.2
  unfold BackgroundProps at hBP
  obtain ⟨-, -, -, ⟨hAB0, -, -⟩, -⟩ := hBP
  have hABc : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => B.AB w.1 w.2.1)
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} := by
    have hg : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => ((w.1, w.2.1) : ℝ³ × ℝ)) :=
      contDiff_fst.prodMk contDiff_snd.fst
    exact hAB0.comp hg.contDiffOn (fun w hw => ⟨hw.2.1, lt_of_lt_of_le hw.2.2 hqB⟩)

  have hwave : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) =>
      waveV5 B G S.Aw (thetaOf w.1) (ptOf w.1 w.2.1 (Yph B.h (rad w.1) w.2.1 + w.2.2)) i)
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} := fun i =>
    (hW i).comp (contDiff_fst.contDiffOn.prodMk hξ) (fun w hw => ⟨hw.1, hmap hw⟩)
  have hPs : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) =>
      S.Psi (ptOf w.1 w.2.1 (Yph B.h (rad w.1) w.2.1 + w.2.2)))
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} :=
    hPsi.1.comp hξ hmap
  have heRc : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => eR w.1)
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} :=
    heR.comp contDiff_fst.contDiffOn hfst
  have heThc : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => eTh w.1)
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} :=
    heTh.comp contDiff_fst.contDiffOn hfst
  have hinner := ((((hwave 0).smul heRc).add ((hwave 1).smul heThc)).add
    ((hwave 2).smul (contDiffOn_const (c := eZ)))).add (hPs.smul heThc)
  have hall := hABc.add (hpref.smul hinner)
  refine hall.congr (fun w hw => ?_)
  have hw' : corrOn B l0 w.1 w.2.1 := hw
  simp only [AX5, cyl2cart, if_pos hw'] <;> rfl

theorem ucyl5_of_ax5_lift : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState), B.ok → qsOf l0 ≤ B.qB →
    InM B (qsOf l0) (1/2) S.bdir →
    ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => AX5 B G l0 S w.1 w.2.1 (Yph B.h (rad w.1) w.2.1 + w.2.2))
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} →
    ∀ a : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => ucyl5 B G l0 S p.1 p.2 a) (univ ×ˢ DomC B.h (qsOf l0)) :=
by
  intro B G l0 S hok hqB hbdir hF a
  generalize hFdef : (fun w : ℝ³ × ℝ × (ℝ × ℝ) =>
    AX5 B G l0 S w.1 w.2.1 (Yph B.h (rad w.1) w.2.1 + w.2.2)) = F at hF
  have hS := hok.1
  have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun x : ℝ³ => x i) := fun i => contDiff_piLp_apply 2

  have hrot0 : ∀ r θ z : ℝ, rotPt r θ z 0 = r * Real.cos θ := by intro r θ z; simp [rotPt]
  have hrot1 : ∀ r θ z : ℝ, rotPt r θ z 1 = r * Real.sin θ := by intro r θ z; simp [rotPt]
  have hrot2 : ∀ r θ z : ℝ, rotPt r θ z 2 = z := by intro r θ z; simp [rotPt]
  have hradrot : ∀ r θ z : ℝ, 0 < r → rad (rotPt r θ z) = r := by
    intro r θ z hr
    show Real.sqrt ((rotPt r θ z) 0 ^ 2 + (rotPt r θ z) 1 ^ 2) = r
    rw [hrot0, hrot1]
    have e : (r * Real.cos θ) ^ 2 + (r * Real.sin θ) ^ 2 = r ^ 2 := by
      linear_combination r ^ 2 * Real.cos_sq_add_sin_sq θ
    rw [e, Real.sqrt_sq hr.le]

  have hf : ContDiff ℝ ∞ (fun x : ℝ³ => x 0 ^ 2 + x 1 ^ 2) := ((hc 0).pow 2).add ((hc 1).pow 2)
  have hradS : ContDiffOn ℝ ∞ rad {x : ℝ³ | 0 < rad x} := by
    have h := hf.contDiffOn.sqrt (s := {x : ℝ³ | 0 < rad x}) (fun x hx => by
      have hx' : 0 < Real.sqrt (x 0 ^ 2 + x 1 ^ 2) := hx
      exact (Real.sqrt_pos.mp hx').ne')
    exact h
  have hinv : ContDiffOn ℝ ∞ (fun x => (rad x)⁻¹) {x : ℝ³ | 0 < rad x} :=
    hradS.inv (fun x hx => ne_of_gt hx)
  have hrv : ContDiff ℝ ∞ radVec := by
    have h : ContDiff ℝ ∞ (fun x : ℝ³ => x 0 • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        x 1 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) :=
      ((hc 0).smul contDiff_const).add ((hc 1).smul contDiff_const)
    exact h
  have haz : ContDiff ℝ ∞ azVec := by
    have h : ContDiff ℝ ∞ (fun x : ℝ³ => -(x 1) • EuclideanSpace.single (0 : Fin 3) (1:ℝ) +
        x 0 • EuclideanSpace.single (1 : Fin 3) (1:ℝ)) :=
      ((hc 1).neg.smul contDiff_const).add ((hc 0).smul contDiff_const)
    exact h
  have heR : ContDiffOn ℝ ∞ eR {x : ℝ³ | 0 < rad x} := hinv.smul hrv.contDiffOn
  have heTh : ContDiffOn ℝ ∞ eTh {x : ℝ³ | 0 < rad x} := hinv.smul haz.contDiffOn
  have hradc : Continuous rad := Real.continuous_sqrt.comp hf.continuous
  have hΩ : IsOpen {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} := by
    have hR : IsOpen {w : ℝ³ × ℝ × (ℝ × ℝ) | 0 < rad w.1} :=
      isOpen_lt continuous_const (hradc.comp continuous_fst)
    have hT : IsOpen {w : ℝ³ × ℝ × (ℝ × ℝ) | w.2.1 < 1} :=
      isOpen_lt continuous_snd.fst continuous_const
    have hφ : ContinuousOn (fun w : ℝ³ × ℝ × (ℝ × ℝ) => simScale B.h (w.1 2) (1 - w.2.1))
        {w : ℝ³ × ℝ × (ℝ × ℝ) | w.2.1 < 1} := by
      have hg : ContDiff ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => ((w.1 2, 1 - w.2.1) : ℝ × ℝ)) :=
        ((hc 2).comp contDiff_fst).prodMk (contDiff_const.sub contDiff_snd.fst)
      exact (hS.2.2.2.1.comp hg.contDiffOn (fun w (hw : w.2.1 < 1) =>
        (⟨mem_univ _, show (0:ℝ) < 1 - w.2.1 by linarith⟩ :
          ((w.1 2, 1 - w.2.1) : ℝ × ℝ) ∈ univ ×ˢ Ioi (0:ℝ)))).continuousOn
    have h2 := hφ.isOpen_inter_preimage hT (isOpen_Iio (a := qsOf l0))
    have e : {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} =
        {w : ℝ³ × ℝ × (ℝ × ℝ) | 0 < rad w.1} ∩ ({w : ℝ³ × ℝ × (ℝ × ℝ) | w.2.1 < 1} ∩
          (fun w : ℝ³ × ℝ × (ℝ × ℝ) => simScale B.h (w.1 2) (1 - w.2.1)) ⁻¹' Iio (qsOf l0)) := by
      ext w; exact Iff.rfl
    rw [e]; exact hR.inter h2
  have hrotS : ContDiff ℝ ∞ (fun p : ℝ × Cyl => rotPt p.2.1 p.1 p.2.2.1) := by
    have h : ContDiff ℝ ∞ (fun p : ℝ × Cyl =>
        (p.2.1 * Real.cos p.1) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
        (p.2.1 * Real.sin p.1) • EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
        p.2.2.1 • EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) :=
      (((contDiff_snd.fst.mul (Real.contDiff_cos.comp contDiff_fst)).smul contDiff_const).add
        ((contDiff_snd.fst.mul (Real.contDiff_sin.comp contDiff_fst)).smul contDiff_const)).add
        (contDiff_snd.snd.fst.smul contDiff_const)
    exact h
  have hrpos : MapsTo (fun p : ℝ × Cyl => rotPt p.2.1 p.1 p.2.2.1) (univ ×ˢ DomC B.h (qsOf l0))
      {x : ℝ³ | 0 < rad x} := by
    intro p hp
    have hr0 : 0 < p.2.1 := hp.2.1
    show 0 < rad (rotPt p.2.1 p.1 p.2.2.1)
    rw [hradrot _ _ _ hr0]
    exact hr0

  have hpw : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => p.2.1 ^ drx B.h) (univ ×ˢ DomC B.h (qsOf l0)) :=
    contDiff_snd.fst.contDiffOn.rpow_const_of_ne (fun p hp => ne_of_gt hp.2.1)
  have hYo : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
      (univ ×ˢ DomC B.h (qsOf l0)) :=
    contDiff_snd.snd.snd.snd.contDiffOn.sub ((hpw.smul contDiffOn_const).add
      (contDiff_snd.snd.snd.fst.contDiffOn.smul contDiffOn_const))
  have hι : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => ((rotPt p.2.1 p.1 p.2.2.1,
      p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1) : ℝ³ × ℝ × (ℝ × ℝ)))
      (univ ×ˢ DomC B.h (qsOf l0)) :=
    hrotS.contDiffOn.prodMk (contDiff_snd.snd.snd.fst.contDiffOn.prodMk hYo)
  have hmaps : MapsTo (fun p : ℝ × Cyl => ((rotPt p.2.1 p.1 p.2.2.1,
      p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1) : ℝ³ × ℝ × (ℝ × ℝ)))
      (univ ×ˢ DomC B.h (qsOf l0)) {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} := by
    intro p hp
    have hr0 : 0 < p.2.1 := hp.2.1
    have ht : p.2.2.2.1 < 1 := hp.2.2.1
    have hq : simScale B.h p.2.2.1 (1 - p.2.2.2.1) < qsOf l0 := hp.2.2.2
    show 0 < rad (rotPt p.2.1 p.1 p.2.2.1) ∧ p.2.2.2.1 < 1 ∧
      simScale B.h ((rotPt p.2.1 p.1 p.2.2.1) 2) (1 - p.2.2.2.1) < qsOf l0
    rw [hradrot _ _ _ hr0, hrot2]
    exact ⟨hr0, ht, hq⟩

  have hDF : ContDiffOn ℝ ∞ (fderiv ℝ F) {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} :=
    ((contDiffOn_infty_iff_fderiv_of_isOpen hΩ).1 hF).2
  have hDι := hDF.comp hι hmaps
  have hG : ∀ (v : ℝ³) (k : Fin 3), ContDiffOn ℝ ∞ (fun p : ℝ × Cyl =>
      fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
        (v, (0 : ℝ × (ℝ × ℝ))) k) (univ ×ˢ DomC B.h (qsOf l0)) := by
    intro v k
    have h1 : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl =>
        fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (v, (0 : ℝ × (ℝ × ℝ)))) (univ ×ˢ DomC B.h (qsOf l0)) :=
      hDι.clm_apply contDiffOn_const
    exact (hc k).comp_contDiffOn h1
  have hCur : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl =>
      (fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (EuclideanSpace.single 1 1, (0 : ℝ × (ℝ × ℝ))) 2 -
        fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (EuclideanSpace.single 2 1, (0 : ℝ × (ℝ × ℝ))) 1) •
          EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
      (fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (EuclideanSpace.single 2 1, (0 : ℝ × (ℝ × ℝ))) 0 -
        fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (EuclideanSpace.single 0 1, (0 : ℝ × (ℝ × ℝ))) 2) •
          EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
      (fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (EuclideanSpace.single 0 1, (0 : ℝ × (ℝ × ℝ))) 1 -
        fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (EuclideanSpace.single 1 1, (0 : ℝ × (ℝ × ℝ))) 0) •
          EuclideanSpace.single (2 : Fin 3) (1 : ℝ)) (univ ×ˢ DomC B.h (qsOf l0)) :=
    ((((hG _ 2).sub (hG _ 1)).smul contDiffOn_const).add
      (((hG _ 0).sub (hG _ 2)).smul contDiffOn_const)).add
      (((hG _ 1).sub (hG _ 0)).smul contDiffOn_const)

  have hcurl : ∀ p ∈ univ ×ˢ DomC B.h (qsOf l0),
      curlX B.h (AX5 B G l0 S) (rotPt p.2.1 p.1 p.2.2.1) p.2.2.2.1 p.2.2.2.2 =
      (fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (EuclideanSpace.single 1 1, (0 : ℝ × (ℝ × ℝ))) 2 -
        fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (EuclideanSpace.single 2 1, (0 : ℝ × (ℝ × ℝ))) 1) •
          EuclideanSpace.single (0 : Fin 3) (1 : ℝ) +
      (fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (EuclideanSpace.single 2 1, (0 : ℝ × (ℝ × ℝ))) 0 -
        fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (EuclideanSpace.single 0 1, (0 : ℝ × (ℝ × ℝ))) 2) •
          EuclideanSpace.single (1 : Fin 3) (1 : ℝ) +
      (fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (EuclideanSpace.single 0 1, (0 : ℝ × (ℝ × ℝ))) 1 -
        fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (EuclideanSpace.single 1 1, (0 : ℝ × (ℝ × ℝ))) 0) •
          EuclideanSpace.single (2 : Fin 3) (1 : ℝ) := by
    intro p hp
    have hr0 : 0 < p.2.1 := hp.2.1
    have hw := hmaps hp
    have hFd : DifferentiableAt ℝ F
        (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1) :=
      (hF.contDiffAt (hΩ.mem_nhds hw)).differentiableAt (by simp)
    have hsl : HasFDerivAt (fun y : ℝ³ => F (y, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1))
        ((fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)).comp
          (ContinuousLinearMap.inl ℝ ℝ³ (ℝ × (ℝ × ℝ)))) (rotPt p.2.1 p.1 p.2.2.1) :=
      HasFDerivAt.comp (rotPt p.2.1 p.1 p.2.2.1) hFd.hasFDerivAt
        (hasFDerivAt_prodMk_left (rotPt p.2.1 p.1 p.2.2.1)
          ((p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1) : ℝ × (ℝ × ℝ)))
    have hfd : ∀ v : ℝ³, fderiv ℝ (fun y : ℝ³ => F (y, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1))
        (rotPt p.2.1 p.1 p.2.2.1) v =
        fderiv ℝ F (rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1)
          (v, (0 : ℝ × (ℝ × ℝ))) := by
      intro v
      rw [hsl.fderiv]
      rfl
    have heq : curlX B.h (AX5 B G l0 S) (rotPt p.2.1 p.1 p.2.2.1) p.2.2.2.1 p.2.2.2.2 =
        curl3 (fun y : ℝ³ => F (y, p.2.2.2.1, p.2.2.2.2 - Yph B.h p.2.1 p.2.2.2.1))
          (rotPt p.2.1 p.1 p.2.2.1) := by
      show curl3 (fun y => evOff B.h (AX5 B G l0 S)
        (p.2.2.2.2 - Yph B.h (rad (rotPt p.2.1 p.1 p.2.2.1)) p.2.2.2.1) y p.2.2.2.1)
          (rotPt p.2.1 p.1 p.2.2.1) = _
      rw [hradrot _ _ _ hr0, ← hFdef]
      rfl
    rw [heq]
    simp only [curl3, hfd]

  have hBXeq : ∀ p ∈ univ ×ˢ DomC B.h (qsOf l0),
      BX B G l0 S (rotPt p.2.1 p.1 p.2.2.1) p.2.2.2.1 p.2.2.2.2 =
      B.BvB (rotPt p.2.1 p.1 p.2.2.1) p.2.2.2.1 +
        (qC B.h p.2 ^ (-Aex B.h) * S.bdir p.2) • eTh (rotPt p.2.1 p.1 p.2.2.1) := by
    intro p hp
    have hw : corrOn B l0 (rotPt p.2.1 p.1 p.2.2.1) p.2.2.2.1 := hmaps hp
    have hpt : ptOf (rotPt p.2.1 p.1 p.2.2.1) p.2.2.2.1 p.2.2.2.2 = p.2 := by
      show (rad (rotPt p.2.1 p.1 p.2.2.1), (rotPt p.2.1 p.1 p.2.2.1) 2, p.2.2.2.1, p.2.2.2.2) = p.2
      rw [hradrot _ _ _ hp.2.1, hrot2]
    simp only [BX, if_pos hw, hpt]
  have hBP := hok.2
  unfold BackgroundProps at hBP
  obtain ⟨-, -, -, ⟨-, hBv0, -⟩, -⟩ := hBP
  have hBvc : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => B.BvB (rotPt p.2.1 p.1 p.2.2.1) p.2.2.2.1)
      (univ ×ˢ DomC B.h (qsOf l0)) := by
    have hg : ContDiff ℝ ∞ (fun p : ℝ × Cyl => ((rotPt p.2.1 p.1 p.2.2.1, p.2.2.2.1) : ℝ³ × ℝ)) :=
      hrotS.prodMk contDiff_snd.snd.snd.fst
    refine hBv0.comp hg.contDiffOn (fun p hp => ?_)
    have ht : p.2.2.2.1 < 1 := hp.2.2.1
    have hq : simScale B.h p.2.2.1 (1 - p.2.2.2.1) < qsOf l0 := hp.2.2.2
    show p.2.2.2.1 < 1 ∧ simScale B.h ((rotPt p.2.1 p.1 p.2.2.1) 2) (1 - p.2.2.2.1) < B.qB
    rw [hrot2]
    exact ⟨ht, lt_of_lt_of_le hq hqB⟩
  have hqC : ContDiffOn ℝ ∞ (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have hπq : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
      contDiff_snd.fst.prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact hS.2.2.2.1.comp hπq.contDiffOn (fun ξ (hξ : ξ.2.2.1 < 1) =>
      (⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩ : (ξ.2.1, 1 - ξ.2.2.1) ∈ univ ×ˢ Ioi (0:ℝ)))
  have hq1 : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => qC B.h p.2) (univ ×ˢ DomC B.h (qsOf l0)) :=
    hqC.comp contDiff_snd.contDiffOn (fun p hp => hp.2.2.1)
  have hq2 : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => qC B.h p.2 ^ (-Aex B.h)) (univ ×ˢ DomC B.h (qsOf l0)) :=
    hq1.rpow_const_of_ne (fun p hp => by
      have ht : p.2.2.2.1 < 1 := hp.2.2.1
      exact (hS.1 p.2.2.1 (1 - p.2.2.2.1) (by linarith)).1.ne')
  have hbd : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => S.bdir p.2) (univ ×ˢ DomC B.h (qsOf l0)) :=
    hbdir.1.comp contDiff_snd.contDiffOn (fun p hp => hp.2)
  have heRc : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => eR (rotPt p.2.1 p.1 p.2.2.1))
      (univ ×ˢ DomC B.h (qsOf l0)) := heR.comp hrotS.contDiffOn hrpos
  have heThc : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => eTh (rotPt p.2.1 p.1 p.2.2.1))
      (univ ×ˢ DomC B.h (qsOf l0)) := heTh.comp hrotS.contDiffOn hrpos
  have hBXs := hBvc.add ((hq2.mul hbd).smul heThc)

  have hfr : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => frameAt p.1 p.2 a) (univ ×ˢ DomC B.h (qsOf l0)) := by
    fin_cases a
    · exact heRc
    · exact heThc
    · exact contDiffOn_const

  have hsum := (hCur.add hBXs).inner ℝ hfr
  refine hsum.congr (fun p hp => ?_)
  have h1 := hcurl p hp
  have h2 := hBXeq p hp
  simp only [ucyl5, uX5, h1, h2] <;> rfl

theorem state_cyl_smooth_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (bw ca cm cd : ℝ), B.ok →
    GeomPrim5 B G → qsOf l0 ≤ B.qB → StOrd5 B G l0 S bw ca cm cd →
    IsOpen (DomC B.h (qsOf l0)) ∧
    (∀ a : Fin 3, ContDiffOn ℝ ∞ (fun ξ => ubase B ξ a) (DomC B.h (qsOf l0))) ∧
    (∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 S a) (DomC B.h (qsOf l0))) ∧
    (∀ a b : Fin 3, ContDiffOn ℝ ∞ (Wcov5 B G l0 S a b) (DomC B.h (qsOf l0))) ∧
    ContDiffOn ℝ ∞ (pmP5 B G l0 S) (DomC B.h (qsOf l0)) :=
by
  intro B G l0 S bw ca cm cd hok hG hqB hSt
  have hS := hok.1

  have hT : IsOpen {ξ : Cyl | ξ.2.2.1 < 1} :=
    isOpen_lt continuous_snd.snd.fst continuous_const
  have hπq : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
    contDiff_snd.fst.prodMk (contDiff_const.sub contDiff_snd.snd.fst)
  have hqC : ContDiffOn ℝ ∞ (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have h4 := hS.2.2.2.1
    have hc := h4.comp hπq.contDiffOn (fun ξ (hξ : ξ.2.2.1 < 1) =>
      (⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩ : (ξ.2.1, 1 - ξ.2.2.1) ∈ univ ×ˢ Ioi (0:ℝ)))
    exact hc
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have h1 : IsOpen {ξ : Cyl | 0 < ξ.1} := isOpen_lt continuous_const continuous_fst
    have h2 := hqC.continuousOn.isOpen_inter_preimage hT (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Iio (qsOf l0)) := by
      ext ξ; exact Iff.rfl
    rw [e]; exact h1.inter h2
  have hqpos : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ := by
    intro ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    exact (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have hqCD : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h (qsOf l0)) :=
    hqC.mono (fun ξ (hξ : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0) => hξ.2.1)

  have hbase : ∀ (l : ℕ) (i : Fin 3), ContDiffOn ℝ ∞ (fun ξ : Cyl => baseC B l ξ i) (DomC B.h (qsOf l0)) := by
    intro l i
    have h := (geom_slow_base_smooth_v5 B hok).2 l i
    have hπ : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.1, ξ.2.1, ξ.2.2.1)) :=
      contDiff_fst.prodMk (contDiff_snd.fst.prodMk contDiff_snd.snd.fst)
    have hc := h.comp hπ.contDiffOn (fun ξ (hξ : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0) =>
      (⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqB⟩ : (ξ.1, ξ.2.1, ξ.2.2.1) ∈
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}))
    exact hc.congr (fun ξ _ => rfl)
  have hub : ∀ a : Fin 3, ContDiffOn ℝ ∞ (fun ξ => ubase B ξ a) (DomC B.h (qsOf l0)) := by
    intro a
    refine (hbase 0 a).congr (fun ξ _ => ?_)
    have hQ : Qb 0 = 1 := by simp [Qb]
    simp only [baseC, ubase, frameAt, hQ, Real.one_rpow, one_mul]

  unfold StOrd5 at hSt
  obtain ⟨c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21,
    c22, c23⟩ := hSt
  have hunnorm : ∀ (e : ℝ) (f : Cyl → ℝ), ContDiffOn ℝ ∞ (nrm B e f) (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) := by
    intro e f hf
    have hneg : ContDiffOn ℝ ∞ (fun ξ => qC B.h ξ ^ (-e)) (DomC B.h (qsOf l0)) :=
      hqCD.rpow_const_of_ne (fun ξ hξ => (hqpos ξ hξ).ne')
    refine (hneg.mul hf).congr (fun ξ hξ => ?_)
    have hp := hqpos ξ hξ
    simp only [nrm]
    rw [← mul_assoc, ← Real.rpow_add hp, neg_add_cancel, Real.rpow_zero, one_mul]
  have hmc : ∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 S a) (DomC B.h (qsOf l0)) := by
    intro a
    fin_cases a
    · exact hunnorm _ _ c21.1
    · exact hunnorm _ _ c18.1
    · exact hunnorm _ _ c19.1
  have hpm : ContDiffOn ℝ ∞ (pmP5 B G l0 S) (DomC B.h (qsOf l0)) := hunnorm _ _ c20.1

  have hper_e : ∀ (γ : Lab) (m : ℤ) (θ : ℝ) (ξ : Cyl),
      ephase5 B G γ m (θ + 2 * Real.pi) ξ = ephase5 B G γ m θ ξ := by
    intro γ m θ ξ
    simp only [ephase5]
    have e : Complex.I * (m : ℂ) * ((pint5 B G γ : ℂ) * ((θ + 2 * Real.pi : ℝ) : ℂ) +
        (kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)) =
        Complex.I * (m : ℂ) * ((pint5 B G γ : ℂ) * (θ : ℂ) + (kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)) +
        ((m * pint5 B G γ : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
      push_cast; ring
    rw [e, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]
  have hper_w : ∀ (θ : ℝ) (ξ : Cyl) (i : Fin 3),
      waveV5 B G S.Aw (θ + 2 * Real.pi) ξ i = waveV5 B G S.Aw θ ξ i := by
    intro θ ξ i
    simp only [waveV5, hper_e]
  have hterm := wave5_term_contDiffOn B G (qsOf l0) 1 S.Aw hok hG hqB c1
  have hwave : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => waveV5 B G S.Aw p.1 p.2 i)
      (univ ×ˢ DomC B.h (qsOf l0)) := by
    intro i
    apply contDiffOn_of_locally_contDiffOn
    rintro ⟨θ₀, ξ₀⟩ ⟨-, hξ₀⟩
    obtain ⟨N, hNo, hξN, Γ, H, hΓ⟩ := wave5_locfin B G (qsOf l0) 1 S.Aw hok c1 ξ₀ hξ₀
    refine ⟨univ ×ˢ N, isOpen_univ.prod hNo, ⟨mem_univ _, hξN⟩, ?_⟩
    have h1 : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl =>
        ∑ γ ∈ Γ, ∑ m ∈ H, S.Aw γ m p.2 i * ephase5 B G γ m p.1 p.2) (univ ×ˢ DomC B.h (qsOf l0)) :=
      ContDiffOn.sum (fun γ _ => ContDiffOn.sum (fun m _ => hterm γ m i))
    have hsum := Complex.reCLM.contDiff.comp_contDiffOn h1
    refine (hsum.mono inter_subset_left).congr ?_
    rintro ⟨θ, ξ⟩ ⟨⟨-, hξD⟩, ⟨-, hξN'⟩⟩
    have hmem : ξ ∈ N ∩ DomC B.h (qsOf l0) := ⟨hξN', hξD⟩
    simp only [waveV5, Function.comp_apply, Complex.reCLM_apply]
    congr 1
    have hin : ∀ γ, ∑ᶠ m : ℤ, S.Aw γ m ξ i * ephase5 B G γ m θ ξ =
        ∑ m ∈ H, S.Aw γ m ξ i * ephase5 B G γ m θ ξ := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      rw [Function.mem_support] at hm
      have hne : S.Aw γ m ξ ≠ 0 := by
        intro h0; apply hm; simp [h0]
      exact Finset.mem_coe.mpr (hΓ ξ hmem γ m hne).2
    rw [finsum_congr hin]
    apply finsum_eq_sum_of_support_subset
    intro γ hγ
    rw [Function.mem_support] at hγ
    apply Finset.mem_coe.mpr
    by_contra hnot
    apply hγ
    apply Finset.sum_eq_zero
    intro m _
    have h0 : S.Aw γ m ξ = 0 := by
      by_contra h0
      exact hnot (hΓ ξ hmem γ m h0).1
    simp [h0]

  have hwθ : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ³ × Cyl => waveV5 B G S.Aw (thetaOf p.1) p.2 i)
      ({y : ℝ³ | 0 < rad y} ×ˢ DomC B.h (qsOf l0)) := fun i =>
    thetaOf_periodic_comp (DomC B.h (qsOf l0)) (fun q : ℝ × Cyl => waveV5 B G S.Aw q.1 q.2 i) (hwave i)
      (fun θ e => hper_w θ e i)
  have hAX := ax5_lift_contDiffOn B G l0 S hok hqB c3 hwθ
  have hucyl := ucyl5_of_ax5_lift B G l0 S hok hqB c4 hAX
  have hW : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (Wcov5 B G l0 S a b) (DomC B.h (qsOf l0)) := by
    intro a b
    have hMp : ∀ c : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => mcor5 B G l0 S c p.2 + ubase B p.2 c)
        (univ ×ˢ DomC B.h (qsOf l0)) :=
      fun c => ((hmc c).add (hub c)).comp contDiff_snd.contDiffOn (fun p hp => hp.2)
    have hg : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl =>
        (ucyl5 B G l0 S p.1 p.2 a - (mcor5 B G l0 S a p.2 + ubase B p.2 a)) *
        (ucyl5 B G l0 S p.1 p.2 b - (mcor5 B G l0 S b p.2 + ubase B p.2 b))) (univ ×ˢ DomC B.h (qsOf l0)) :=
      ((hucyl a).sub (hMp a)).mul ((hucyl b).sub (hMp b))
    have hI := cyl_param_integral_contDiffOn (DomC B.h (qsOf l0)) _ hDopen hg
    refine ((contDiffOn_const (c := (2 * Real.pi)⁻¹)).mul hI).congr (fun ξ _ => ?_)
    simp only [Wcov5, thA, mcor5, sub_add_cancel]
  exact ⟨hDopen, hub, hmc, hW, hpm⟩

theorem etaL_tsupport_finite : ∀ (h : ℝ) (ξ : Cyl), SimScaleProps h → ξ.2.2.1 < 1 →
    {γ : Lab | ξ ∈ tsupport (etaL h γ)}.Finite :=
by
  intro h ξ hS hξ

  have s1 : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ → 1 < |φ ξ / μ - (j : ℝ)| →
      ∀ᶠ η in nhds ξ, sqPart μ j (φ η) = 0 := by
    intro μ j φ hφ h1
    have hψ : ContinuousAt (fun η => |φ η / μ - (j : ℝ)|) ξ :=
      ((hφ.div_const μ).sub continuousAt_const).abs
    have hev := (continuousAt_const : ContinuousAt (fun _ : Cyl => (1:ℝ)) ξ).eventually_lt hψ h1
    filter_upwards [hev] with η hη
    have hsq : 1 < (φ η / μ - (j : ℝ)) ^ 2 := (one_lt_sq_iff_one_lt_abs _).mpr hη
    unfold sqPart bumpR
    rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_div]

  have hτ : 0 < 1 - ξ.2.2.1 := by linarith
  have hqpos : 0 < qC h ξ := (hS.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
  have hqcont : ContinuousAt (qC h) ξ := by
    have hU : IsOpen (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
    have hp : ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ) ∈ (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) :=
      ⟨trivial, hτ⟩
    have hg : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (ξ.2.1, 1 - ξ.2.2.1) :=
      hS.2.2.2.1.continuousOn.continuousAt (hU.mem_nhds hp)
    have hk : ContinuousAt (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) ξ := by fun_prop
    have he : qC h = (fun w : ℝ × ℝ => simScale h w.1 w.2) ∘
        (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) := by
      funext η; rfl
    rw [he]
    exact ContinuousAt.comp hg hk
  have hLc : ContinuousAt (fun η => Real.logb 2 (qC h η)) ξ := hqcont.logb hqpos.ne'

  have hwin : ∀ γ : Lab, ξ ∈ tsupport (etaL h γ) →
      |Real.logb 2 (qC h ξ) + (γ.1:ℝ)| ≤ 1 ∧
      |chartR h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1:ℝ)| ≤ 1 ∧
      |chartZ h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.1:ℝ)| ≤ 1 ∧
      |chartT h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2:ℝ)| ≤ 1 := by
    intro γ hγ
    have key : ∀ (μ : ℝ) (j : ℤ) (φ : Cyl → ℝ), ContinuousAt φ ξ →
        (∀ η, sqPart μ j (φ η) = 0 → etaL h γ η = 0) → |φ ξ / μ - (j:ℝ)| ≤ 1 := by
      intro μ j φ hφ himp
      by_contra hc
      push_neg at hc
      have hev := s1 μ j φ hφ hc
      apply (notMem_tsupport_iff_eventuallyEq.mpr _) hγ
      filter_upwards [hev] with η hη
      exact himp η hη
    refine ⟨?_, ?_, ?_, ?_⟩
    · have := key 1 (-(γ.1:ℤ)) (fun η => Real.logb 2 (qC h η)) hLc
        (fun η hη => by simp only [etaL, hη, zero_mul])
      simpa [div_one, sub_neg_eq_add] using this
    · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.1 (chartR h γ.1) (by unfold chartR; fun_prop)
        (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
    · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.1 (chartZ h γ.1) (by unfold chartZ; fun_prop)
        (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])
    · exact key (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.2 (chartT h γ.1) (by unfold chartT; fun_prop)
        (fun η hη => by simp only [etaL, hη, zero_mul, mul_zero])

  have hI : ∀ (c : ℝ) (j : ℤ), |c - (j:ℝ)| ≤ 1 → j ∈ Set.Icc ⌈c - 1⌉ ⌊c + 1⌋ := by
    intro c j hj
    rw [abs_le] at hj
    exact ⟨Int.ceil_le.mpr (by linarith [hj.2]), Int.le_floor.mpr (by linarith [hj.1])⟩
  have hfin : (⋃ n ∈ Set.Iic ⌊1 - Real.logb 2 (qC h ξ)⌋₊, ({n} : Set ℕ) ×ˢ
      ((Set.Icc ⌈chartR h n ξ / Sb n ^ (-3:ℤ) - 1⌉ ⌊chartR h n ξ / Sb n ^ (-3:ℤ) + 1⌋ ×ˢ
        Set.Icc ⌈chartZ h n ξ / Sb n ^ (-3:ℤ) - 1⌉ ⌊chartZ h n ξ / Sb n ^ (-3:ℤ) + 1⌋ ×ˢ
        Set.Icc ⌈chartT h n ξ / Sb n ^ (-3:ℤ) - 1⌉ ⌊chartT h n ξ / Sb n ^ (-3:ℤ) + 1⌋) ×ˢ
        (Set.univ : Set Bool))).Finite := by
    refine Set.Finite.biUnion (Set.finite_Iic _) (fun n _ => ?_)
    exact (Set.finite_singleton n).prod (((Set.finite_Icc _ _).prod
      ((Set.finite_Icc _ _).prod (Set.finite_Icc _ _))).prod Set.finite_univ)
  refine hfin.subset ?_
  rintro ⟨n, ⟨a, b, c⟩, σ⟩ hγ
  obtain ⟨h1, h2, h3, h4⟩ := hwin _ hγ
  rw [abs_le] at h1
  refine Set.mem_iUnion₂.mpr ⟨n, Nat.le_floor (by simp only at h1; linarith [h1.2]), ?_⟩
  exact ⟨rfl, ⟨hI _ _ h2, hI _ _ h3, hI _ _ h4⟩, trivial⟩

theorem waveS5_circle_mean_zero : ∀ (B : BG) (G : CorrGeom) (a : WS) (ξ : Cyl) (r z : ℝ) (H : Finset ℤ)
    (T : Finset Lab), 0 < r → (0 : ℤ) ∉ H → (∀ γ m, m ∉ H → a γ m ξ = 0) → (∀ γ m, γ ∉ T → a γ m ξ = 0) →
    Continuous (fun θ : ℝ => waveS5 B G a (thetaOf (rotPt r θ z)) ξ) ∧
    thA (fun θ : ℝ => waveS5 B G a (thetaOf (rotPt r θ z)) ξ) = 0 :=
by
  intro B G a ξ r z H T hr hH0 hH hT

  have hpint : ∀ γ : Lab, pint5 B G γ ≠ 0 := by
    intro γ
    unfold pint5
    split_ifs with h
    · exact one_ne_zero
    · exact h

  have hphase : ∀ (γ : Lab) (m : ℤ) (θ : ℝ), ephase5 B G γ m (thetaOf (rotPt r θ z)) ξ =
      Complex.exp (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) *
        Complex.exp (Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) := by
    intro γ m θ
    have e0 : rotPt r θ z 0 = r * Real.cos θ := by simp [rotPt]
    have e1 : rotPt r θ z 1 = r * Real.sin θ := by simp [rotPt]
    have hc : (⟨rotPt r θ z 0, rotPt r θ z 1⟩ : ℂ) =
        (r : ℂ) * (Complex.cos (θ : ℂ) + Complex.sin (θ : ℂ) * Complex.I) := by
      rw [e0, e1]
      apply Complex.ext <;> simp [Complex.cos_ofReal_re, Complex.sin_ofReal_re]
    have hth : thetaOf (rotPt r θ z) = toIocMod Real.two_pi_pos (-Real.pi) θ := by
      unfold thetaOf
      rw [hc]
      exact Complex.arg_mul_cos_add_sin_mul_I_eq_toIocMod hr θ
    have hn := self_sub_toIocMod Real.two_pi_pos (-Real.pi) θ
    have hmod : toIocMod Real.two_pi_pos (-Real.pi) θ =
        θ - ((toIocDiv Real.two_pi_pos (-Real.pi) θ : ℤ) : ℝ) * (2 * Real.pi) := by
      rw [zsmul_eq_mul] at hn
      linarith
    have hth' : ((thetaOf (rotPt r θ z) : ℝ) : ℂ) =
        (θ : ℂ) - ((toIocDiv Real.two_pi_pos (-Real.pi) θ : ℤ) : ℂ) * (2 * (Real.pi : ℂ)) := by
      rw [hth, hmod]
      push_cast
      ring
    have key : Complex.I * (m : ℂ) * ((pint5 B G γ : ℂ) *
          ((θ : ℂ) - ((toIocDiv Real.two_pi_pos (-Real.pi) θ : ℤ) : ℂ) * (2 * (Real.pi : ℂ))) +
          (kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)) =
        (Complex.I * (m : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)) +
          Complex.I * ((m * pint5 B G γ : ℤ) : ℂ) * (θ : ℂ)) +
        ((-(m * pint5 B G γ * toIocDiv Real.two_pi_pos (-Real.pi) θ) : ℤ) : ℂ) *
          (2 * (Real.pi : ℂ) * Complex.I) := by
      push_cast
      ring
    unfold ephase5
    rw [hth', key, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one, Complex.exp_add]

  have hgen : ∀ (s : Finset (Lab × ℤ)) (c : Lab × ℤ → ℂ) (k : Lab × ℤ → ℤ), (∀ i ∈ s, k i ≠ 0) →
      Continuous (fun θ : ℝ => (∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))).re) ∧
      ∫ θ in (0:ℝ)..(2 * Real.pi),
        (∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))).re = 0 := by
    intro s c k hk
    have hcont : ∀ i, Continuous (fun θ : ℝ => c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))) :=
      fun i => continuous_const.mul (Complex.continuous_exp.comp
        (continuous_const.mul Complex.continuous_ofReal))
    have hF : Continuous (fun θ : ℝ => ∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))) :=
      continuous_finsetSum _ (fun i _ => hcont i)
    refine ⟨Complex.continuous_re.comp hF, ?_⟩
    have h1 : ∫ θ in (0:ℝ)..(2 * Real.pi),
          (∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))).re =
        (∫ θ in (0:ℝ)..(2 * Real.pi),
          ∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))).re := by
      have := ContinuousLinearMap.intervalIntegral_comp_comm Complex.reCLM
        (hF.intervalIntegrable (μ := MeasureTheory.volume) 0 (2 * Real.pi))
      simpa only [Complex.reCLM_apply] using this
    rw [h1, intervalIntegral.integral_finsetSum (fun i _ => (hcont i).intervalIntegrable _ _)]
    rw [Finset.sum_eq_zero, Complex.zero_re]
    intro i hi
    rw [intervalIntegral.integral_const_mul]
    have hw : Complex.I * (k i : ℂ) ≠ 0 :=
      mul_ne_zero Complex.I_ne_zero (Int.cast_ne_zero.mpr (hk i hi))
    rw [integral_exp_mul_complex hw]
    have e2 : Complex.I * (k i : ℂ) * ((2 * Real.pi : ℝ) : ℂ) =
        (k i : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
      push_cast
      ring
    rw [e2, Complex.exp_int_mul_two_pi_mul_I]
    simp

  have hfin : ∀ θ' : ℝ, waveS5 B G a θ' ξ =
      (∑ p ∈ T ×ˢ H, a p.1 p.2 ξ * ephase5 B G p.1 p.2 θ' ξ).re := by
    intro θ'
    unfold waveS5
    congr 1
    have hin : ∀ γ : Lab, ∑ᶠ m : ℤ, a γ m ξ * ephase5 B G γ m θ' ξ =
        ∑ m ∈ H, a γ m ξ * ephase5 B G γ m θ' ξ := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      by_contra hmH
      exact (Function.mem_support.mp hm)
        (by rw [hH γ m (fun h => hmH (Finset.mem_coe.mpr h)), zero_mul])
    rw [finsum_congr hin, finsum_eq_sum_of_support_subset (s := T)]
    · exact (Finset.sum_product T H (fun p : Lab × ℤ => a p.1 p.2 ξ * ephase5 B G p.1 p.2 θ' ξ)).symm
    · intro γ hγ
      by_contra hγT
      apply Function.mem_support.mp hγ
      exact Finset.sum_eq_zero (fun m _ => by
        rw [hT γ m (fun h => hγT (Finset.mem_coe.mpr h)), zero_mul])

  have hfun : (fun θ : ℝ => waveS5 B G a (thetaOf (rotPt r θ z)) ξ) = fun θ : ℝ =>
      (∑ p ∈ T ×ˢ H, (a p.1 p.2 ξ * Complex.exp (Complex.I * (p.2 : ℂ) *
        ((kb B.h p.1.1 : ℂ) * (phiL5 B G p.1 ξ : ℂ)))) *
        Complex.exp (Complex.I * ((p.2 * pint5 B G p.1 : ℤ) : ℂ) * (θ : ℂ))).re := by
    funext θ
    rw [hfin]
    congr 1
    apply Finset.sum_congr rfl
    intro p _
    rw [hphase]
    ring

  have hk : ∀ p ∈ T ×ˢ H, p.2 * pint5 B G p.1 ≠ 0 := by
    intro p hp
    have hp2 : p.2 ∈ H := (Finset.mem_product.mp hp).2
    have hne : p.2 ≠ 0 := fun h => hH0 (h ▸ hp2)
    exact mul_ne_zero hne (hpint p.1)

  obtain ⟨hC, hI⟩ := hgen (T ×ˢ H)
    (fun p => a p.1 p.2 ξ * Complex.exp (Complex.I * (p.2 : ℂ) *
      ((kb B.h p.1.1 : ℂ) * (phiL5 B G p.1 ξ : ℂ))))
    (fun p => p.2 * pint5 B G p.1) hk
  rw [hfun]
  refine ⟨hC, ?_⟩
  simp only [thA, hI, mul_zero]

theorem state_mean_moments_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (bw ca cm cd : ℝ), B.ok →
    GeomPrim5 B G → qsOf l0 ≤ B.qB → StOrd5 B G l0 S bw ca cm cd →
    ∀ (Y₀ : ℝ × ℝ) (w : ℝ × ℝ × ℝ), mriPath B.h Y₀ w ∈ DomC B.h (qsOf l0) →
      (∀ a : Fin 3, mriM (evOff B.h (uX5 B G l0 S) Y₀) a w - mriM (uB B) a w =
        mcor5 B G l0 S a (mriPath B.h Y₀ w)) ∧
      (∀ a b : Fin 3, mriQ (evOff B.h (uX5 B G l0 S) Y₀) a b w - mriQ (uB B) a b w =
        mriDq5 B G l0 S a b (mriPath B.h Y₀ w)) ∧
      mriPm (evOff B.h (PX5 B G l0 S) Y₀) w - mriPm B.PB w = pmP5 B G l0 S (mriPath B.h Y₀ w) :=
by
  intro B G l0 S bw ca cm cd hok hG hq hSt Y₀ w hD
  obtain ⟨r, z, t⟩ := w
  obtain ⟨hr, ht, hqs⟩ : 0 < r ∧ t < 1 ∧ simScale B.h z (1 - t) < qsOf l0 := hD
  set ξ : Cyl := mriPath B.h Y₀ (r, z, t) with hξ

  have hBP := hok.2
  unfold BackgroundProps at hBP
  obtain ⟨-, -, -, ⟨-, -, hPBs⟩, -, hB5, -, -, -, -, -, -⟩ := hBP

  have e0 : ∀ θ : ℝ, rotPt r θ z 0 = r * Real.cos θ := fun θ => by simp [rotPt]
  have e1 : ∀ θ : ℝ, rotPt r θ z 1 = r * Real.sin θ := fun θ => by simp [rotPt]
  have e2 : ∀ θ : ℝ, rotPt r θ z 2 = z := fun θ => by simp [rotPt]
  have hss : ∀ θ : ℝ, rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2 = r ^ 2 := by
    intro θ
    rw [e0, e1]
    linear_combination r ^ 2 * Real.cos_sq_add_sin_sq θ
  have hrad : ∀ θ : ℝ, rad (rotPt r θ z) = r := by
    intro θ
    show Real.sqrt (rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2) = r
    rw [hss θ, Real.sqrt_sq hr.le]
  have hcorr : ∀ θ : ℝ, corrOn B l0 (rotPt r θ z) t := by
    intro θ
    show 0 < rad (rotPt r θ z) ∧ t < 1 ∧ simScale B.h (rotPt r θ z 2) (1 - t) < qsOf l0
    rw [hrad θ, e2 θ]
    exact ⟨hr, ht, hqs⟩
  have hsimB : ∀ θ : ℝ, (rotPt r θ z, t) ∈ simDomain B.h B.qB := by
    intro θ
    show t < 1 ∧ simScale B.h (rotPt r θ z 2) (1 - t) < B.qB
    rw [e2 θ]
    exact ⟨ht, lt_of_lt_of_le hqs hq⟩
  have hpt : ∀ θ : ℝ, ptOf (rotPt r θ z) t (Yph B.h (rad (rotPt r θ z)) t + Y₀) = ξ := by
    intro θ
    show (rad (rotPt r θ z), rotPt r θ z 2, t, Yph B.h (rad (rotPt r θ z)) t + Y₀) =
      (r, z, t, Yph B.h r t + Y₀)
    rw [hrad θ, e2 θ]
  have hrotc : Continuous (fun θ : ℝ => rotPt r θ z) := by
    unfold rotPt
    fun_prop

  have hpi : (2 * Real.pi) ≠ 0 := by positivity
  have thA_const : ∀ c : ℝ, thA (fun _ => c) = c := by
    intro c
    unfold thA
    rw [intervalIntegral.integral_const, smul_eq_mul, sub_zero, ← mul_assoc, inv_mul_cancel₀ hpi, one_mul]
  have thA_add : ∀ f g : ℝ → ℝ, Continuous f → Continuous g →
      thA (fun θ => f θ + g θ) = thA f + thA g := by
    intro f g hf hg
    unfold thA
    rw [intervalIntegral.integral_add (hf.intervalIntegrable _ _) (hg.intervalIntegrable _ _), mul_add]
  have thA_smul : ∀ (c : ℝ) (f : ℝ → ℝ), thA (fun θ => c * f θ) = c * thA f := by
    intro c f
    unfold thA
    rw [intervalIntegral.integral_const_mul]
    ring
  have thA_cov : ∀ f g : ℝ → ℝ, Continuous f → Continuous g →
      thA (fun θ => (f θ - thA f) * (g θ - thA g)) = thA (fun θ => f θ * g θ) - thA f * thA g := by
    intro f g hf hg
    have e : (fun θ => (f θ - thA f) * (g θ - thA g)) =
        fun θ => (f θ * g θ + (-thA g) * f θ) + ((-thA f) * g θ + thA f * thA g) := by
      funext θ
      ring
    have h1 : thA (fun θ => (f θ * g θ + (-thA g) * f θ) + ((-thA f) * g θ + thA f * thA g)) =
        thA (fun θ => f θ * g θ + (-thA g) * f θ) + thA (fun θ => (-thA f) * g θ + thA f * thA g) :=
      thA_add _ _ ((hf.mul hg).add (continuous_const.mul hf)) ((continuous_const.mul hg).add continuous_const)
    have h2 : thA (fun θ => f θ * g θ + (-thA g) * f θ) =
        thA (fun θ => f θ * g θ) + thA (fun θ => (-thA g) * f θ) :=
      thA_add _ _ (hf.mul hg) (continuous_const.mul hf)
    have h3 : thA (fun θ => (-thA f) * g θ + thA f * thA g) =
        thA (fun θ => (-thA f) * g θ) + thA (fun _ => thA f * thA g) :=
      thA_add _ _ (continuous_const.mul hg) continuous_const
    rw [e, h1, h2, h3, thA_smul (-thA g) f, thA_smul (-thA f) g, thA_const (thA f * thA g)]
    ring

  have hu : ∀ θ : ℝ, uB B (rotPt r θ z) t =
      curl3 (fun w => B.AB w t) (rotPt r θ z) + B.BvB (rotPt r θ z) t := fun θ => rfl
  have hpos : ∀ φ : ℝ, 0 < rotPt r φ z 0 ^ 2 + rotPt r φ z 1 ^ 2 := fun φ => by
    rw [hss φ]; exact pow_pos hr 2
  have hUB : ∀ (θ : ℝ) (a : Fin 3), inner ℝ (uB B (rotPt r θ z) t) (frameAt θ (r, z, t, (0 : ℝ × ℝ)) a) =
      ubase B ξ a := by
    intro θ a
    obtain ⟨hA1, hA2, hA3⟩ := hB5 (rotPt r θ z) t (hsimB θ) (hpos θ)
    obtain ⟨hZ1, hZ2, hZ3⟩ := hB5 (rotPt r 0 z) t (hsimB 0) (hpos 0)
    show _ = inner ℝ (uB B (rotPt r 0 z) t) (frameAt 0 (r, z, t, (0 : ℝ × ℝ)) a)
    fin_cases a
    · show inner ℝ (uB B (rotPt r θ z) t) (eR (rotPt r θ z)) =
        inner ℝ (uB B (rotPt r 0 z) t) (eR (rotPt r 0 z))
      rw [eR, eR, real_inner_smul_right, real_inner_smul_right, hu θ, hu 0, hA3, hZ3, hrad θ, hrad 0]
      simp only [simX, simEta, hss θ, hss 0, e2 θ, e2 0]
    · show inner ℝ (uB B (rotPt r θ z) t) (eTh (rotPt r θ z)) =
        inner ℝ (uB B (rotPt r 0 z) t) (eTh (rotPt r 0 z))
      rw [eTh, eTh, real_inner_smul_right, real_inner_smul_right, hu θ, hu 0, hA1, hZ1, hrad θ, hrad 0]
      simp only [simX, simEta, hss θ, hss 0, e2 θ, e2 0]
    · show inner ℝ (uB B (rotPt r θ z) t) eZ = inner ℝ (uB B (rotPt r 0 z) t) eZ
      simp only [eZ, EuclideanSpace.inner_single_right, one_mul, conj_trivial]
      rw [hu θ, hu 0, hA2, hZ2]
      simp only [simX, simEta, hss θ, hss 0, e2 θ, e2 0]

  have hSF := state_flow_props_v5 B G l0 S bw ca cm cd hok hG hq hSt Y₀
  have hUc : Continuous (fun θ : ℝ => (↿(evOff B.h (uX5 B G l0 S) Y₀)) (rotPt r θ z, t)) :=
    hSF.2.1.continuousOn.comp_continuous (hrotc.prodMk continuous_const) (fun θ => hcorr θ)
  have hEc : ∀ a : Fin 3, Continuous (fun θ : ℝ => frameAt θ ξ a) := by
    intro a
    fin_cases a
    · show Continuous fun θ : ℝ => eR (rotPt r θ z)
      have e : (fun θ : ℝ => eR (rotPt r θ z)) = fun θ : ℝ => r⁻¹ • ((r * Real.cos θ) •
          EuclideanSpace.single (0 : Fin 3) (1 : ℝ) + (r * Real.sin θ) • EuclideanSpace.single (1 : Fin 3) (1 : ℝ)) := by
        funext θ
        rw [eR, hrad θ, radVec, e0 θ, e1 θ]
      rw [e]
      fun_prop
    · show Continuous fun θ : ℝ => eTh (rotPt r θ z)
      have e : (fun θ : ℝ => eTh (rotPt r θ z)) = fun θ : ℝ => r⁻¹ • (-(r * Real.sin θ) •
          EuclideanSpace.single (0 : Fin 3) (1 : ℝ) + (r * Real.cos θ) • EuclideanSpace.single (1 : Fin 3) (1 : ℝ)) := by
        funext θ
        rw [eTh, hrad θ, azVec, e0 θ, e1 θ]
      rw [e]
      fun_prop
    · show Continuous fun _ : ℝ => eZ
      exact continuous_const
  have hfc : ∀ a : Fin 3, Continuous (fun θ : ℝ => ucyl5 B G l0 S θ ξ a) := by
    intro a
    have e : (fun θ : ℝ => ucyl5 B G l0 S θ ξ a) =
        fun θ : ℝ => inner ℝ ((↿(evOff B.h (uX5 B G l0 S) Y₀)) (rotPt r θ z, t)) (frameAt θ ξ a) := by
      funext θ
      show inner ℝ (uX5 B G l0 S (rotPt r θ z) t (Yph B.h r t + Y₀)) (frameAt θ ξ a) =
        inner ℝ (uX5 B G l0 S (rotPt r θ z) t (Yph B.h (rad (rotPt r θ z)) t + Y₀)) (frameAt θ ξ a)
      rw [hrad θ]
    rw [e]
    exact hUc.inner (hEc a)

  have hMtot : ∀ a : Fin 3, mriM (evOff B.h (uX5 B G l0 S) Y₀) a (r, z, t) =
      thA (fun θ => ucyl5 B G l0 S θ ξ a) := by
    intro a
    show thA _ = thA _
    refine congrArg thA (funext fun θ => ?_)
    show inner ℝ (uX5 B G l0 S (rotPt r θ z) t (Yph B.h (rad (rotPt r θ z)) t + Y₀))
        (frameAt θ (r, z, t, (0 : ℝ × ℝ)) a) =
      inner ℝ (uX5 B G l0 S (rotPt r θ z) t (Yph B.h r t + Y₀)) (frameAt θ (r, z, t, (0 : ℝ × ℝ)) a)
    rw [hrad θ]
  have hMbase : ∀ a : Fin 3, mriM (uB B) a (r, z, t) = ubase B ξ a := by
    intro a
    have e : mriM (uB B) a (r, z, t) = thA (fun _ => ubase B ξ a) := by
      show thA _ = thA _
      exact congrArg thA (funext fun θ => hUB θ a)
    rw [e, thA_const]

  have hQtot : ∀ a b : Fin 3, mriQ (evOff B.h (uX5 B G l0 S) Y₀) a b (r, z, t) =
      thA (fun θ => ucyl5 B G l0 S θ ξ a * ucyl5 B G l0 S θ ξ b) := by
    intro a b
    show thA _ = thA _
    refine congrArg thA (funext fun θ => ?_)
    show inner ℝ (uX5 B G l0 S (rotPt r θ z) t (Yph B.h (rad (rotPt r θ z)) t + Y₀))
        (frameAt θ (r, z, t, (0 : ℝ × ℝ)) a) *
        inner ℝ (uX5 B G l0 S (rotPt r θ z) t (Yph B.h (rad (rotPt r θ z)) t + Y₀))
        (frameAt θ (r, z, t, (0 : ℝ × ℝ)) b) =
      inner ℝ (uX5 B G l0 S (rotPt r θ z) t (Yph B.h r t + Y₀)) (frameAt θ (r, z, t, (0 : ℝ × ℝ)) a) *
        inner ℝ (uX5 B G l0 S (rotPt r θ z) t (Yph B.h r t + Y₀)) (frameAt θ (r, z, t, (0 : ℝ × ℝ)) b)
    rw [hrad θ]
  have hQbase : ∀ a b : Fin 3, mriQ (uB B) a b (r, z, t) = ubase B ξ a * ubase B ξ b := by
    intro a b
    have e : mriQ (uB B) a b (r, z, t) = thA (fun _ => ubase B ξ a * ubase B ξ b) := by
      show thA _ = thA _
      exact congrArg thA (funext fun θ => by rw [hUB θ a, hUB θ b])
    rw [e, thA_const]

  have hPX : ∀ θ : ℝ, evOff B.h (PX5 B G l0 S) Y₀ (rotPt r θ z) t =
      B.PB (rotPt r θ z) t + (pmP5 B G l0 S ξ +
        qC B.h ξ ^ (-2 * Aex B.h) * waveS5 B G S.pw (thetaOf (rotPt r θ z)) ξ) := by
    intro θ
    simp only [evOff, PX5]
    rw [if_pos (hcorr θ), hpt θ]
  obtain ⟨H, hH0, hHz⟩ := hSt.2.1.1
  have hT := etaL_tsupport_finite B.h ξ hok.1 ht
  have hHz' : ∀ γ m, m ∉ H → S.pw γ m ξ = 0 := by
    intro γ m hm
    rw [hHz γ m hm]
    rfl
  have hTz : ∀ γ m, γ ∉ hT.toFinset → S.pw γ m ξ = 0 := by
    intro γ m hγ
    by_contra hne
    exact hγ (hT.mem_toFinset.mpr (hSt.2.1.2.2.2.1 γ m ξ (show ξ ∈ DomC B.h (qsOf l0) from ⟨hr, ht, hqs⟩) hne).2.1)
  obtain ⟨hWc, hWm⟩ := waveS5_circle_mean_zero B G S.pw ξ r z H hT.toFinset hr hH0 hHz' hTz
  have hPBc : Continuous (fun θ : ℝ => B.PB (rotPt r θ z) t) :=
    hPBs.continuousOn.comp_continuous (hrotc.prodMk continuous_const) hsimB
  have hP1 : mriPm (evOff B.h (PX5 B G l0 S) Y₀) (r, z, t) =
      thA (fun θ => B.PB (rotPt r θ z) t + (pmP5 B G l0 S ξ +
        qC B.h ξ ^ (-2 * Aex B.h) * waveS5 B G S.pw (thetaOf (rotPt r θ z)) ξ)) := by
    show thA _ = thA _
    exact congrArg thA (funext hPX)
  have hP2 : mriPm B.PB (r, z, t) = thA (fun θ => B.PB (rotPt r θ z) t) := rfl
  have hsplit : thA (fun θ => B.PB (rotPt r θ z) t + (pmP5 B G l0 S ξ +
        qC B.h ξ ^ (-2 * Aex B.h) * waveS5 B G S.pw (thetaOf (rotPt r θ z)) ξ)) =
      thA (fun θ => B.PB (rotPt r θ z) t) + thA (fun θ => pmP5 B G l0 S ξ +
        qC B.h ξ ^ (-2 * Aex B.h) * waveS5 B G S.pw (thetaOf (rotPt r θ z)) ξ) :=
    thA_add _ _ hPBc (continuous_const.add (continuous_const.mul hWc))
  have hsplit2 : thA (fun θ => pmP5 B G l0 S ξ +
        qC B.h ξ ^ (-2 * Aex B.h) * waveS5 B G S.pw (thetaOf (rotPt r θ z)) ξ) =
      thA (fun _ => pmP5 B G l0 S ξ) +
        thA (fun θ => qC B.h ξ ^ (-2 * Aex B.h) * waveS5 B G S.pw (thetaOf (rotPt r θ z)) ξ) :=
    thA_add _ _ continuous_const (continuous_const.mul hWc)

  refine ⟨fun a => ?_, fun a b => ?_, ?_⟩
  · rw [hMtot a, hMbase a]
    rfl
  · rw [hQtot a b, hQbase a b]
    have hW : Wcov5 B G l0 S a b ξ = thA (fun θ => ucyl5 B G l0 S θ ξ a * ucyl5 B G l0 S θ ξ b) -
        thA (fun θ => ucyl5 B G l0 S θ ξ a) * thA (fun θ => ucyl5 B G l0 S θ ξ b) :=
      thA_cov _ _ (hfc a) (hfc b)
    simp only [mriDq5, mcor5]
    rw [hW]
    ring
  · rw [hP1, hP2, hsplit, hsplit2, thA_const (pmP5 B G l0 S ξ),
      thA_smul (qC B.h ξ ^ (-2 * Aex B.h)) (fun θ => waveS5 B G S.pw (thetaOf (rotPt r θ z)) ξ), hWm]
    ring

theorem cyl_lift_smooth : ∀ (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (O : Set (ℝ³ × ℝ)), IsOpen O →
    ContDiffOn ℝ ∞ (↿u) O → ContDiffOn ℝ ∞ (↿p) O →
    IsOpen {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} ∧
    (∀ a : Fin 3, ContDiffOn ℝ ∞ (crU u a)
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O}) ∧
    ContDiffOn ℝ ∞ (crP p) {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} ∧
    (∀ (a : Fin 3) (v : ℝ × ℝ × ℝ × ℝ), crU u a (v.1, v.2.1 + 2 * Real.pi, v.2.2.1, v.2.2.2) = crU u a v) ∧
    (∀ v : ℝ × ℝ × ℝ × ℝ, crP p (v.1, v.2.1 + 2 * Real.pi, v.2.2.1, v.2.2.2) = crP p v) :=
by
  intro u p O hO hu hp
  have hL : ContDiff ℝ ∞ (fun v : ℝ × ℝ × ℝ × ℝ => ((rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) : ℝ³ × ℝ)) := by
    unfold rotPt
    fun_prop
  have hSo : IsOpen {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} := by
    have h := (isOpen_lt (continuous_const : Continuous fun _ : ℝ × ℝ × ℝ × ℝ => (0 : ℝ))
      continuous_fst).inter (hO.preimage hL.continuous)
    exact h
  have hmaps : Set.MapsTo (fun v : ℝ × ℝ × ℝ × ℝ => ((rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) : ℝ³ × ℝ))
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} O :=
    fun v hv => hv.2
  have hg : ContDiffOn ℝ ∞ (fun v : ℝ × ℝ × ℝ × ℝ => u (rotPt v.1 v.2.1 v.2.2.1) v.2.2.2)
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} :=
    (hu.comp hL.contDiffOn hmaps).congr (fun v _ => rfl)
  have hpS : ContDiffOn ℝ ∞ (crP p)
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} :=
    (hp.comp hL.contDiffOn hmaps).congr (fun v _ => rfl)
  have hrot : ∀ r θ z : ℝ, rotPt r (θ + 2 * Real.pi) z = rotPt r θ z := by
    intro r θ z
    simp only [rotPt, Real.cos_add_two_pi, Real.sin_add_two_pi]
  have hfr : ∀ (θ : ℝ) (ξ : Cyl), frameAt (θ + 2 * Real.pi) ξ = frameAt θ ξ := by
    intro θ ξ
    simp only [frameAt, hrot]
  have hframe : ∀ (r θ z s : ℝ), 0 < r →
      frameAt θ (r, z, s, 0) 0 = Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) ∧
      frameAt θ (r, z, s, 0) 1 = (-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) ∧
      frameAt θ (r, z, s, 0) 2 = (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³) := by
    intro r θ z s hr
    have e0 : rotPt r θ z 0 = r * Real.cos θ := by simp [rotPt]
    have e1 : rotPt r θ z 1 = r * Real.sin θ := by simp [rotPt]
    have hrad : rad (rotPt r θ z) = r := by
      have e : (r * Real.cos θ) ^ 2 + (r * Real.sin θ) ^ 2 = r ^ 2 := by
        linear_combination r ^ 2 * Real.cos_sq_add_sin_sq θ
      show Real.sqrt ((rotPt r θ z) 0 ^ 2 + (rotPt r θ z) 1 ^ 2) = r
      rw [e0, e1, e, Real.sqrt_sq hr.le]
    have hr0 : r ≠ 0 := hr.ne'
    refine ⟨?_, ?_, ?_⟩
    · show eR (rotPt r θ z) = _
      rw [eR, hrad, radVec, e0, e1, smul_add, smul_smul, smul_smul,
        inv_mul_cancel_left₀ hr0, inv_mul_cancel_left₀ hr0]
    · show eTh (rotPt r θ z) = _
      rw [eTh, hrad, azVec, e0, e1, smul_add, smul_smul, smul_smul, mul_neg,
        inv_mul_cancel_left₀ hr0, inv_mul_cancel_left₀ hr0]
    · rfl
  have hU : ∀ a : Fin 3, ContDiffOn ℝ ∞ (crU u a)
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} := by
    intro a
    obtain ⟨F, hFs, hFe⟩ : ∃ F : ℝ × ℝ × ℝ × ℝ → ℝ³, ContDiff ℝ ∞ F ∧
        ∀ v ∈ {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O},
          frameAt v.2.1 (v.1, v.2.2.1, v.2.2.2, 0) a = F v := by
      fin_cases a
      · exact ⟨fun v => Real.cos v.2.1 • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.sin v.2.1 • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³), by fun_prop,
          fun v hv => (hframe v.1 v.2.1 v.2.2.1 v.2.2.2 hv.1).1⟩
      · exact ⟨fun v => (-Real.sin v.2.1) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.cos v.2.1 • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³), by fun_prop,
          fun v hv => (hframe v.1 v.2.1 v.2.2.1 v.2.2.2 hv.1).2.1⟩
      · exact ⟨fun _ => (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³), contDiff_const,
          fun v hv => (hframe v.1 v.2.1 v.2.2.1 v.2.2.2 hv.1).2.2⟩
    refine (hg.inner ℝ hFs.contDiffOn).congr (fun v hv => ?_)
    simp only [crU, hFe v hv]
  refine ⟨hSo, hU, hpS, ?_, ?_⟩
  · intro a v
    simp only [crU, hrot, hfr]
  · intro v
    simp only [crP, hrot]

theorem cyl_tube : ∀ (O : Set (ℝ³ × ℝ)) (r z t : ℝ), IsOpen O → 0 < r → (∀ θ : ℝ, (rotPt r θ z, t) ∈ O) →
    ∃ W : Set (ℝ × ℝ × ℝ), IsOpen W ∧ (r, z, t) ∈ W ∧ (∀ w ∈ W, 0 < w.1) ∧
      ∀ w ∈ W, ∀ θ : ℝ, (rotPt w.1 θ w.2.1, w.2.2) ∈ O :=
by
  intro O r z t hO hr hc
  have hΨ : Continuous (fun p : (ℝ × ℝ × ℝ) × ℝ => (rotPt p.1.1 p.2 p.1.2.1, p.1.2.2)) := by
    unfold rotPt; fun_prop
  have hN : IsOpen ((fun p : (ℝ × ℝ × ℝ) × ℝ => (rotPt p.1.1 p.2 p.1.2.1, p.1.2.2)) ⁻¹' O) :=
    hO.preimage hΨ
  have hsub : ({(r, z, t)} : Set (ℝ × ℝ × ℝ)) ×ˢ Set.Icc (0:ℝ) (2 * Real.pi) ⊆
      (fun p : (ℝ × ℝ × ℝ) × ℝ => (rotPt p.1.1 p.2 p.1.2.1, p.1.2.2)) ⁻¹' O := by
    rintro ⟨w, θ⟩ ⟨hw, -⟩
    rw [Set.mem_singleton_iff] at hw
    subst hw
    exact hc θ
  obtain ⟨u, v, hu, hv, hsu, htv, huv⟩ :=
    generalized_tube_lemma isCompact_singleton isCompact_Icc hN hsub
  refine ⟨u ∩ {w | 0 < w.1}, hu.inter (isOpen_lt continuous_const continuous_fst),
    ⟨hsu (Set.mem_singleton _), hr⟩, fun w hw => hw.2, ?_⟩
  intro w hw θ
  obtain ⟨θ', n, hmem, hθ⟩ : ∃ θ' : ℝ, ∃ n : ℤ, θ' ∈ Set.Icc (0:ℝ) (2 * Real.pi) ∧
      θ = θ' + (n : ℝ) * (2 * Real.pi) := by
    refine ⟨toIcoMod Real.two_pi_pos 0 θ, toIcoDiv Real.two_pi_pos 0 θ, ?_, ?_⟩
    · have h1 := toIcoMod_mem_Ico Real.two_pi_pos 0 θ
      rw [zero_add] at h1
      exact Set.Ico_subset_Icc_self h1
    · rw [← zsmul_eq_mul, toIcoMod_add_toIcoDiv_zsmul]
  subst hθ
  have hrot : rotPt w.1 (θ' + (n : ℝ) * (2 * Real.pi)) w.2.1 = rotPt w.1 θ' w.2.1 := by
    simp only [rotPt, Real.cos_add_int_mul_two_pi, Real.sin_add_int_mul_two_pi]
  rw [hrot]
  have hfin := huv (Set.mk_mem_prod hw.1 (htv hmem))
  exact hfin

theorem cyl_frame_tp : ∀ (u : ℝ³ → ℝ → ℝ³) (p : ℝ³ → ℝ → ℝ) (O : Set (ℝ³ × ℝ)) (r θ z t : ℝ), IsOpen O →
    ContDiffOn ℝ ∞ (↿u) O → ContDiffOn ℝ ∞ (↿p) O → 0 < r → (rotPt r θ z, t) ∈ O →
    (∀ a : Fin 3, inner ℝ (deriv (fun s => u (rotPt r θ z) s) t) (frameAt θ (r, z, t, 0) a) =
      cpS (crU u a) (r, θ, z, t)) ∧
    inner ℝ (gradient (fun y => p y t) (rotPt r θ z)) (frameAt θ (r, z, t, 0) 0) = cpR (crP p) (r, θ, z, t) ∧
    inner ℝ (gradient (fun y => p y t) (rotPt r θ z)) (frameAt θ (r, z, t, 0) 1) =
      cpTh (crP p) (r, θ, z, t) / r ∧
    inner ℝ (gradient (fun y => p y t) (rotPt r θ z)) (frameAt θ (r, z, t, 0) 2) = cpZ (crP p) (r, θ, z, t) :=
by
  intro u p O r θ z t hO hu hp hr hmem
  have hL : ContDiff ℝ ∞ (fun v : ℝ × ℝ × ℝ × ℝ => ((rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) : ℝ³ × ℝ)) := by
    unfold rotPt
    fun_prop
  have hSo : IsOpen {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} := by
    have h := (isOpen_lt (continuous_const : Continuous fun _ : ℝ × ℝ × ℝ × ℝ => (0 : ℝ))
      continuous_fst).inter (hO.preimage hL.continuous)
    exact h
  have hmaps : Set.MapsTo (fun v : ℝ × ℝ × ℝ × ℝ => ((rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) : ℝ³ × ℝ))
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} O :=
    fun v hv => hv.2
  have hgU : ContDiffOn ℝ ∞ (fun v : ℝ × ℝ × ℝ × ℝ => u (rotPt v.1 v.2.1 v.2.2.1) v.2.2.2)
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} :=
    (hu.comp hL.contDiffOn hmaps).congr (fun v _ => rfl)
  have hPs : ContDiffOn ℝ ∞ (crP p)
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} :=
    (hp.comp hL.contDiffOn hmaps).congr (fun v _ => rfl)
  have hframeG : ∀ (r θ z s : ℝ), 0 < r →
      frameAt θ (r, z, s, 0) 0 = Real.cos θ • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.sin θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) ∧
      frameAt θ (r, z, s, 0) 1 = (-Real.sin θ) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
        Real.cos θ • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³) ∧
      frameAt θ (r, z, s, 0) 2 = (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³) := by
    intro r θ z s hr
    have e0 : rotPt r θ z 0 = r * Real.cos θ := by simp [rotPt]
    have e1 : rotPt r θ z 1 = r * Real.sin θ := by simp [rotPt]
    have hrad : rad (rotPt r θ z) = r := by
      have e : (r * Real.cos θ) ^ 2 + (r * Real.sin θ) ^ 2 = r ^ 2 := by
        linear_combination r ^ 2 * Real.cos_sq_add_sin_sq θ
      show Real.sqrt ((rotPt r θ z) 0 ^ 2 + (rotPt r θ z) 1 ^ 2) = r
      rw [e0, e1, e, Real.sqrt_sq hr.le]
    have hr0 : r ≠ 0 := hr.ne'
    refine ⟨?_, ?_, ?_⟩
    · show eR (rotPt r θ z) = _
      rw [eR, hrad, radVec, e0, e1, smul_add, smul_smul, smul_smul,
        inv_mul_cancel_left₀ hr0, inv_mul_cancel_left₀ hr0]
    · show eTh (rotPt r θ z) = _
      rw [eTh, hrad, azVec, e0, e1, smul_add, smul_smul, smul_smul, mul_neg,
        inv_mul_cancel_left₀ hr0, inv_mul_cancel_left₀ hr0]
    · rfl
  have hUs : ∀ a : Fin 3, ContDiffOn ℝ ∞ (crU u a)
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} := by
    intro a
    obtain ⟨F, hFs, hFe⟩ : ∃ F : ℝ × ℝ × ℝ × ℝ → ℝ³, ContDiff ℝ ∞ F ∧
        ∀ v ∈ {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O},
          frameAt v.2.1 (v.1, v.2.2.1, v.2.2.2, 0) a = F v := by
      fin_cases a
      · exact ⟨fun v => Real.cos v.2.1 • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.sin v.2.1 • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³), by fun_prop,
          fun v hv => (hframeG v.1 v.2.1 v.2.2.1 v.2.2.2 hv.1).1⟩
      · exact ⟨fun v => (-Real.sin v.2.1) • (EuclideanSpace.single (0 : Fin 3) (1 : ℝ) : ℝ³) +
          Real.cos v.2.1 • (EuclideanSpace.single (1 : Fin 3) (1 : ℝ) : ℝ³), by fun_prop,
          fun v hv => (hframeG v.1 v.2.1 v.2.2.1 v.2.2.2 hv.1).2.1⟩
      · exact ⟨fun _ => (EuclideanSpace.single (2 : Fin 3) (1 : ℝ) : ℝ³), contDiff_const,
          fun v hv => (hframeG v.1 v.2.1 v.2.2.1 v.2.2.2 hv.1).2.2⟩
    refine (hgU.inner ℝ hFs.contDiffOn).congr (fun v hv => ?_)
    simp only [crU, hFe v hv]
  have hv : ((r, θ, z, t) : ℝ × ℝ × ℝ × ℝ) ∈
      {v : ℝ × ℝ × ℝ × ℝ | 0 < v.1 ∧ (rotPt v.1 v.2.1 v.2.2.1, v.2.2.2) ∈ O} := ⟨hr, hmem⟩
  have hdU : ∀ a : Fin 3, DifferentiableAt ℝ (crU u a) (r, θ, z, t) := fun a =>
    ((hUs a).contDiffAt (hSo.mem_nhds hv)).differentiableAt (by simp)
  have hdP : DifferentiableAt ℝ (crP p) (r, θ, z, t) :=
    (hPs.contDiffAt (hSo.mem_nhds hv)).differentiableAt (by simp)
  have hdu : DifferentiableAt ℝ (↿u) (rotPt r θ z, t) :=
    (hu.contDiffAt (hO.mem_nhds hmem)).differentiableAt (by simp)
  have hdp : DifferentiableAt ℝ (↿p) (rotPt r θ z, t) :=
    (hp.contDiffAt (hO.mem_nhds hmem)).differentiableAt (by simp)

  have hframe := hframeG r θ z t hr

  have hT : ∀ a : Fin 3, inner ℝ (deriv (fun s => u (rotPt r θ z) s) t) (frameAt θ (r, z, t, 0) a) =
      cpS (crU u a) (r, θ, z, t) := by
    intro a
    have hκ : HasDerivAt (fun s : ℝ => ((rotPt r θ z, s) : ℝ³ × ℝ)) ((0 : ℝ³), (1 : ℝ)) t :=
