          have e : ((0 : Cyl → ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) ℝ) ξ).compContinuousLinearMap
              (fun _ => Lnorm B.h ξ) = 0 := by
            ext v
            simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
          rw [e, norm_zero]
        simp only
        rw [h0]
        split_ifs
        · exact hM0
        · exact le_rfl
    have hsum : ∑ p ∈ Γ ×ˢ Ha, (if ξ ∈ tsupport (etaL B.h p.1) then M else 0) ≤ 162 * (Ha.card : ℝ) * M := by
      have hinner : ∀ x ∈ Γ, (∑ _y ∈ Ha, if ξ ∈ tsupport (etaL B.h x) then M else 0) =
