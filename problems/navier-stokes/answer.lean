  · refine (hslice _ _ t hWsm hWsm).congr (fun y _ => ?_)
    simp only [evOff, pwrQ, pwrTr, add_sub_cancel_left]

theorem grP5_contDiffOn_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState), IsOpen (DomC B.h (qsOf l0)) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (fun ξ => ubase B ξ a) (DomC B.h (qsOf l0))) → (∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 S a) (DomC B.h (qsOf l0))) → (∀ a b : Fin 3, ContDiffOn ℝ ∞ (Wcov5 B G l0 S a b) (DomC B.h (qsOf l0))) → ContDiffOn ℝ ∞ (grP5 B G l0 S) (DomC B.h (qsOf l0)) :=
by
  intro B G l0 S hD hub hmc hW
  have hcl : ∀ f : Cyl → ℝ, ContDiffOn ℝ ∞ f (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ (dR B.h f) (DomC B.h (qsOf l0)) ∧ ContDiffOn ℝ ∞ (dZ f) (DomC B.h (qsOf l0)) ∧
        ContDiffOn ℝ ∞ (dT f) (DomC B.h (qsOf l0)) := by
    intro f hf
    have hDf : ContDiffOn ℝ ∞ (fderiv ℝ f) (DomC B.h (qsOf l0)) :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hf).2
    have hpow : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1 ^ (drx B.h - 1)) (DomC B.h (qsOf l0)) :=
      contDiff_fst.contDiffOn.rpow_const_of_ne
        (fun ξ (hξ : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0) => hξ.1.ne')
    have hY : ContDiffOn ℝ ∞ (fun ξ : Cyl => (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)
        (DomC B.h (qsOf l0)) :=
      (contDiffOn_const.mul hpow).smul_const _
    have hvR : ContDiffOn ℝ ∞ (fun ξ : Cyl =>
        ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) (DomC B.h (qsOf l0)) :=
      contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk hY))
    refine ⟨?_, ?_, ?_⟩
    · exact (hDf.clm_apply hvR).congr (fun ξ _ => rfl)
    · exact (hDf.clm_apply contDiffOn_const).congr (fun ξ _ => rfl)
    · exact (hDf.clm_apply contDiffOn_const).congr (fun ξ _ => rfl)
  have hne : ∀ ξ ∈ DomC B.h (qsOf l0), ξ.1 ≠ 0 := by
    intro ξ hξ
    have h : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    exact h.1.ne'
  have hne2 : ∀ ξ ∈ DomC B.h (qsOf l0), ξ.1 ^ 2 ≠ 0 := fun ξ hξ => pow_ne_zero 2 (hne ξ hξ)
  have hfst : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1) (DomC B.h (qsOf l0)) := contDiff_fst.contDiffOn
  have hβs : ContDiffOn ℝ ∞ (mcor5 B G l0 S 0) (DomC B.h (qsOf l0)) := hmc 0
  have hvs : ContDiffOn ℝ ∞ (mcor5 B G l0 S 1) (DomC B.h (qsOf l0)) := hmc 1
  have hγs : ContDiffOn ℝ ∞ (mcor5 B G l0 S 2) (DomC B.h (qsOf l0)) := hmc 2
  have hF0s : ContDiffOn ℝ ∞ (fun η => 2 * ubase B η 0 * mcor5 B G l0 S 0 η + mcor5 B G l0 S 0 η ^ 2
      + Wcov5 B G l0 S 0 0 η) (DomC B.h (qsOf l0)) := by
    have h := ((((contDiffOn_const (c := (2:ℝ))).mul (hub 0)).mul hβs).add (hβs.pow 2)).add (hW 0 0)
    exact h
  have hF2s : ContDiffOn ℝ ∞ (fun η => ubase B η 0 * mcor5 B G l0 S 2 η + ubase B η 2 * mcor5 B G l0 S 0 η
      + mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 2 0 η) (DomC B.h (qsOf l0)) := by
    have h := ((((hub 0).mul hγs).add ((hub 2).mul hβs)).add (hβs.mul hγs)).add (hW 2 0)
    exact h
  have hF11 : ContDiffOn ℝ ∞ (fun η => 2 * ubase B η 1 * mcor5 B G l0 S 1 η + mcor5 B G l0 S 1 η ^ 2
      + Wcov5 B G l0 S 1 1 η) (DomC B.h (qsOf l0)) := by
    have h := ((((contDiffOn_const (c := (2:ℝ))).mul (hub 1)).mul hvs).add (hvs.pow 2)).add (hW 1 1)
    exact h
  have hdβ := hcl _ hβs
  have hdRRβ := (hcl _ hdβ.1).1
  have hdZZβ := (hcl _ hdβ.2.1).2.1
  have hdRF0 := (hcl _ hF0s).1
  have hdZF2 := (hcl _ hF2s).2.1
  have hR := (((((contDiffOn_const (c := (0:ℝ))).sub hdβ.2.2).sub (hdRF0.add (hF0s.div hfst hne))).sub
    hdZF2).add (hF11.div hfst hne)).add
    (((hdRRβ.add (hdβ.1.div hfst hne)).add hdZZβ).sub (hβs.div (hfst.pow 2) hne2))
  exact hR.congr (fun ξ _ => rfl)

theorem domc_open_calculus : ∀ (B : BG) (qs : ℝ), B.ok → IsOpen (DomC B.h qs) ∧ ContDiffOn ℝ ∞ (qC B.h) (DomC B.h qs) ∧ (∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ) ∧ ContinuousOn (XC B.h) (DomC B.h qs) ∧ (∀ f : Cyl → ℝ, ContDiffOn ℝ ∞ f (DomC B.h qs) → ContDiffOn ℝ ∞ (dR B.h f) (DomC B.h qs) ∧ ContDiffOn ℝ ∞ (dZ f) (DomC B.h qs) ∧ ContDiffOn ℝ ∞ (dT f) (DomC B.h qs)) ∧ (∀ f : Cyl → ℝ, (∀ ξ ∈ DomC B.h qs, (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → f ξ = 0) → ∀ ξ ∈ DomC B.h qs, (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → dR B.h f ξ = 0 ∧ dZ f ξ = 0 ∧ dT f ξ = 0) :=
by
  intro B qs hok
  have hS := hok.1
  have hT : IsOpen {ξ : Cyl | ξ.2.2.1 < 1} :=
    isOpen_lt continuous_snd.snd.fst continuous_const
  have hπq : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
    contDiff_snd.fst.prodMk (contDiff_const.sub contDiff_snd.snd.fst)
  have hqC : ContDiffOn ℝ ∞ (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have h4 := hS.2.2.2.1
    have hc := h4.comp hπq.contDiffOn (fun ξ (hξ : ξ.2.2.1 < 1) =>
      (⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩ : (ξ.2.1, 1 - ξ.2.2.1) ∈ univ ×ˢ Ioi (0:ℝ)))
    exact hc
  have hDopen : IsOpen (DomC B.h qs) := by
    have h1 : IsOpen {ξ : Cyl | 0 < ξ.1} := isOpen_lt continuous_const continuous_fst
    have h2 := hqC.continuousOn.isOpen_inter_preimage hT (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Iio qs) := by
      ext ξ; exact Iff.rfl
    rw [e]; exact h1.inter h2
  have hqpos : ∀ ξ ∈ DomC B.h qs, 0 < qC B.h ξ := by
    intro ξ hξ
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξ
    exact (hS.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have hqCD : ContDiffOn ℝ ∞ (qC B.h) (DomC B.h qs) :=
    hqC.mono (fun ξ (hξ : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs) => hξ.2.1)
  have hXC : ContinuousOn (XC B.h) (DomC B.h qs) := by
    have hnum : ContinuousOn (fun ξ : Cyl => ξ.1 ^ 2) (DomC B.h qs) :=
      (continuous_fst.pow 2).continuousOn
    have hden : ContinuousOn (fun ξ : Cyl => 2 * qC B.h ξ) (DomC B.h qs) :=
      continuousOn_const.mul hqCD.continuousOn
    have h := hnum.div hden (fun ξ hξ => by have := hqpos ξ hξ; positivity)
    exact h.congr (fun ξ _ => rfl)
  refine ⟨hDopen, hqCD, hqpos, hXC, ?_, ?_⟩
  · intro f hf
    have hDf : ContDiffOn ℝ ∞ (fderiv ℝ f) (DomC B.h qs) :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hDopen).1 hf).2
    have hpow : ContDiffOn ℝ ∞ (fun ξ : Cyl => ξ.1 ^ (drx B.h - 1)) (DomC B.h qs) :=
      contDiff_fst.contDiffOn.rpow_const_of_ne
        (fun ξ (hξ : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs) => hξ.1.ne')
    have hY : ContDiffOn ℝ ∞ (fun ξ : Cyl => (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) (DomC B.h qs) :=
      (contDiffOn_const.mul hpow).smul_const _
    have hvR : ContDiffOn ℝ ∞ (fun ξ : Cyl =>
        ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) (DomC B.h qs) :=
      contDiffOn_const.prodMk (contDiffOn_const.prodMk (contDiffOn_const.prodMk hY))
    refine ⟨?_, ?_, ?_⟩
    · exact (hDf.clm_apply hvR).congr (fun ξ _ => rfl)
    · exact (hDf.clm_apply contDiffOn_const).congr (fun ξ _ => rfl)
    · exact (hDf.clm_apply contDiffOn_const).congr (fun ξ _ => rfl)
  · intro f hz ξ hξ hX
    have hO : IsOpen (DomC B.h qs ∩ XC B.h ⁻¹' (Iio B.Xa ∪ Ioi B.Xb)) :=
      hXC.isOpen_inter_preimage hDopen (isOpen_Iio.union isOpen_Ioi)
    have hξO : ξ ∈ DomC B.h qs ∩ XC B.h ⁻¹' (Iio B.Xa ∪ Ioi B.Xb) := ⟨hξ, hX⟩
    have hev : f =ᶠ[nhds ξ] (fun _ => (0:ℝ)) :=
      Filter.eventuallyEq_of_mem (hO.mem_nhds hξO) (fun η hη => hz η hη.1 hη.2)
    have hd : fderiv ℝ f ξ = 0 := by
      rw [hev.fderiv_eq]; exact fderiv_const_apply _
    refine ⟨?_, ?_, ?_⟩
    · unfold dR; rw [hd]; rfl
    · unfold dZ; rw [hd]; rfl
    · unfold dT; rw [hd]; rfl

theorem grP5_shell_vanish_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState), B.ok → (∀ a : Fin 3, ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → mcor5 B G l0 S a ξ = 0) → (∀ a c : Fin 3, ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → Wcov5 B G l0 S a c ξ = 0) → ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → grP5 B G l0 S ξ = 0 :=
by
  intro B G l0 S hok hm hWv ξ hξ hX
  obtain ⟨-, -, -, -, -, hsv⟩ := domc_open_calculus B (qsOf l0) hok
  have SV0 := hm 0
  have SV1 := hm 1
  have SV2 := hm 2
  have SVF0 : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) →
      (fun η => 2 * ubase B η 0 * mcor5 B G l0 S 0 η + mcor5 B G l0 S 0 η ^ 2
        + Wcov5 B G l0 S 0 0 η) η = 0 := by
    intro η hη hX'
    simp only [SV0 η hη hX', hWv 0 0 η hη hX']
    ring
  have SVF2 : ∀ η ∈ DomC B.h (qsOf l0), (XC B.h η < B.Xa ∨ B.Xb < XC B.h η) →
      (fun η => ubase B η 0 * mcor5 B G l0 S 2 η + ubase B η 2 * mcor5 B G l0 S 0 η
        + mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 2 0 η) η = 0 := by
    intro η hη hX'
    simp only [SV0 η hη hX', SV2 η hη hX', hWv 2 0 η hη hX']
    ring
  have hRF0 := (hsv _ SVF0 ξ hξ hX).1
  have hZF2 := (hsv _ SVF2 ξ hξ hX).2.1
  have hb3 := hsv (mcor5 B G l0 S 0) SV0
  obtain ⟨hRβ, -, hTβ⟩ := hb3 ξ hξ hX
  have hRR := (hsv (dR B.h (mcor5 B G l0 S 0)) (fun η hη hX' => (hb3 η hη hX').1) ξ hξ hX).1
  have hZZ := (hsv (dZ (mcor5 B G l0 S 0)) (fun η hη hX' => (hb3 η hη hX').2.1) ξ hξ hX).2.1
  show (0:ℝ) - dT (mcor5 B G l0 S 0) ξ
      - (dR B.h (fun η => 2 * ubase B η 0 * mcor5 B G l0 S 0 η + mcor5 B G l0 S 0 η ^ 2
          + Wcov5 B G l0 S 0 0 η) ξ
        + (2 * ubase B ξ 0 * mcor5 B G l0 S 0 ξ + mcor5 B G l0 S 0 ξ ^ 2 + Wcov5 B G l0 S 0 0 ξ) / ξ.1)
      - dZ (fun η => ubase B η 0 * mcor5 B G l0 S 2 η + ubase B η 2 * mcor5 B G l0 S 0 η
          + mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η + Wcov5 B G l0 S 2 0 η) ξ
      + (2 * ubase B ξ 1 * mcor5 B G l0 S 1 ξ + mcor5 B G l0 S 1 ξ ^ 2 + Wcov5 B G l0 S 1 1 ξ) / ξ.1
      + ((dR B.h (dR B.h (mcor5 B G l0 S 0)) ξ + dR B.h (mcor5 B G l0 S 0) ξ / ξ.1
          + dZ (dZ (mcor5 B G l0 S 0)) ξ) - mcor5 B G l0 S 0 ξ / ξ.1 ^ 2) = 0
  rw [hTβ, hRF0, hZF2, hRR, hRβ, hZZ, SV0 ξ hξ hX, SV1 ξ hξ hX, hWv 0 0 ξ hξ hX, hWv 1 1 ξ hξ hX]
  simp

theorem pws_prim_grP_regular : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → InWg5 B G (qsOf l0) 1 (primState5 B G).Aw → (∀ (a : Fin 3), ∀ ξ ∈ DomC B.h (qsOf l0), mcor5 B G l0 (primState5 B G) a ξ = 0) → ContDiffOn ℝ ∞ (grP5 B G l0 (primState5 B G)) (DomC B.h (qsOf l0)) ∧ ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) → grP5 B G l0 (primState5 B G) ξ = 0 :=
by
  intro B G hok hG
  obtain ⟨-, -, -, -, -, -, -, hqB0, hqB1, -, -, -, -⟩ := hok.2.1
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, fun l0 hl0 hAw hm0 => ?_⟩
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) hl0) hn0.le
  have hS := hok.1

  have hT : IsOpen {ξ : Cyl | ξ.2.2.1 < 1} :=
    isOpen_lt continuous_snd.snd.fst continuous_const
  have hπq : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.2.1, 1 - ξ.2.2.1)) :=
    contDiff_snd.fst.prodMk (contDiff_const.sub contDiff_snd.snd.fst)
  have hqC : ContDiffOn ℝ ∞ (qC B.h) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have h4 := hS.2.2.2.1
    have hc := h4.comp hπq.contDiffOn (fun ξ (hξ : ξ.2.2.1 < 1) =>
      (⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩ : (ξ.2.1, 1 - ξ.2.2.1) ∈ univ ×ˢ Ioi (0:ℝ)))
    exact hc
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have h1 : IsOpen {ξ : Cyl | 0 < ξ.1} := isOpen_lt continuous_const continuous_fst
    have h2 := hqC.continuousOn.isOpen_inter_preimage hT (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        {ξ : Cyl | 0 < ξ.1} ∩ ({ξ : Cyl | ξ.2.2.1 < 1} ∩ qC B.h ⁻¹' Iio (qsOf l0)) := by
      ext ξ; exact Iff.rfl
    rw [e]; exact h1.inter h2

  have hub : ∀ a : Fin 3, ContDiffOn ℝ ∞ (fun ξ => ubase B ξ a) (DomC B.h (qsOf l0)) := by
    intro a
    have h := (geom_slow_base_smooth_v5 B hok).2 0 a
    have hπ : ContDiff ℝ ∞ (fun ξ : Cyl => (ξ.1, ξ.2.1, ξ.2.2.1)) :=
      contDiff_fst.prodMk (contDiff_snd.fst.prodMk contDiff_snd.snd.fst)
    have hc := h.comp hπ.contDiffOn (fun ξ (hξ : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0) =>
      (⟨hξ.1, hξ.2.1, lt_of_lt_of_le hξ.2.2 hqB⟩ : (ξ.1, ξ.2.1, ξ.2.2.1) ∈
        {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}))
    refine hc.congr (fun ξ _ => ?_)
    have hQ : Qb 0 = 1 := by simp [Qb]
    simp only [Function.comp_apply, baseC, ubase, frameAt, hQ, Real.one_rpow, one_mul]

  have hmc : ∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 (primState5 B G) a) (DomC B.h (qsOf l0)) :=
    fun a => (contDiffOn_const (c := (0:ℝ))).congr (fun ξ hξ => hm0 a ξ hξ)

  have hZ : InM B (qsOf l0) (1/2) (fun _ : Cyl => (0:ℝ)) := by
    refine ⟨contDiffOn_const, fun _ _ _ _ => rfl, fun _ _ _ => rfl, fun k => ⟨0, 0, 0, fun ξ _ _ _ => ?_⟩⟩
    have hz : iteratedFDeriv ℝ k (fun _ : Cyl => (0:ℝ)) ξ = 0 := by
      have h := (iteratedFDeriv_fun_zero : iteratedFDeriv ℝ k (fun _ : Cyl => (0:ℝ)) = 0)
      exact congrFun h ξ
    unfold NB
    rw [hz]
    have h0 : ((0 : ContinuousMultilinearMap ℝ (fun _ : Fin k => Cyl) ℝ).compContinuousLinearMap
        fun _ => Lnorm B.h ξ) = 0 := by
      ext v
      simp
    rw [h0]
    simp

  have wsm : ∀ S : CState, InWg5 B G (qsOf l0) 1 S.Aw → InM B (qsOf l0) (1/2) S.Psi →
      InM B (qsOf l0) (1/2) S.bdir →
      (∀ a : Fin 3, ContDiffOn ℝ ∞ (mcor5 B G l0 S a) (DomC B.h (qsOf l0))) →
      ∀ a b : Fin 3, ContDiffOn ℝ ∞ (Wcov5 B G l0 S a b) (DomC B.h (qsOf l0)) := by
    intro S c1 c3 c4 hmcS
    have hper_e : ∀ (γ : Lab) (m : ℤ) (θ : ℝ) (ξ : Cyl),
        ephase5 B G γ m (θ + 2 * Real.pi) ξ = ephase5 B G γ m θ ξ := by
      intro γ m θ ξ
      simp only [ephase5]
      have e : Complex.I * (m : ℂ) * ((pint5 B G γ : ℂ) * ((θ + 2 * Real.pi : ℝ) : ℂ) +
          (kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)) =
          Complex.I * (m : ℂ) * ((pint5 B G γ : ℂ) * (θ : ℂ) + (kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ)) +
          ((m * pint5 B G γ : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
        push_cast; ring
      rw [e, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]
    have hper_w : ∀ (θ : ℝ) (ξ : Cyl) (i : Fin 3),
        waveV5 B G S.Aw (θ + 2 * Real.pi) ξ i = waveV5 B G S.Aw θ ξ i := by
      intro θ ξ i
      simp only [waveV5, hper_e]
    have hterm := wave5_term_contDiffOn B G (qsOf l0) 1 S.Aw hok hG hqB c1
    have hwave : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => waveV5 B G S.Aw p.1 p.2 i)
        (univ ×ˢ DomC B.h (qsOf l0)) := by
      intro i
      apply contDiffOn_of_locally_contDiffOn
      rintro ⟨θ₀, ξ₀⟩ ⟨-, hξ₀⟩
      obtain ⟨N, hNo, hξN, Γ, H, hΓ⟩ := wave5_locfin B G (qsOf l0) 1 S.Aw hok c1 ξ₀ hξ₀
      refine ⟨univ ×ˢ N, isOpen_univ.prod hNo, ⟨mem_univ _, hξN⟩, ?_⟩
      have h1 : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl =>
          ∑ γ ∈ Γ, ∑ m ∈ H, S.Aw γ m p.2 i * ephase5 B G γ m p.1 p.2) (univ ×ˢ DomC B.h (qsOf l0)) :=
        ContDiffOn.sum (fun γ _ => ContDiffOn.sum (fun m _ => hterm γ m i))
      have hsum := Complex.reCLM.contDiff.comp_contDiffOn h1
      refine (hsum.mono inter_subset_left).congr ?_
      rintro ⟨θ, ξ⟩ ⟨⟨-, hξD⟩, ⟨-, hξN'⟩⟩
      have hmem : ξ ∈ N ∩ DomC B.h (qsOf l0) := ⟨hξN', hξD⟩
      simp only [waveV5, Function.comp_apply, Complex.reCLM_apply]
      congr 1
      have hin : ∀ γ, ∑ᶠ m : ℤ, S.Aw γ m ξ i * ephase5 B G γ m θ ξ =
          ∑ m ∈ H, S.Aw γ m ξ i * ephase5 B G γ m θ ξ := by
        intro γ
        apply finsum_eq_sum_of_support_subset
        intro m hm
        rw [Function.mem_support] at hm
        have hne : S.Aw γ m ξ ≠ 0 := by
          intro h0; apply hm; simp [h0]
        exact Finset.mem_coe.mpr (hΓ ξ hmem γ m hne).2
      rw [finsum_congr hin]
      apply finsum_eq_sum_of_support_subset
      intro γ hγ
      rw [Function.mem_support] at hγ
      apply Finset.mem_coe.mpr
      by_contra hnot
      apply hγ
      apply Finset.sum_eq_zero
      intro m _
      have h0 : S.Aw γ m ξ = 0 := by
        by_contra h0
        exact hnot (hΓ ξ hmem γ m h0).1
      simp [h0]
    have hwθ : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ³ × Cyl => waveV5 B G S.Aw (thetaOf p.1) p.2 i)
        ({y : ℝ³ | 0 < rad y} ×ˢ DomC B.h (qsOf l0)) := fun i =>
      thetaOf_periodic_comp (DomC B.h (qsOf l0)) (fun q : ℝ × Cyl => waveV5 B G S.Aw q.1 q.2 i) (hwave i)
        (fun θ e => hper_w θ e i)
    have hAX := ax5_lift_contDiffOn B G l0 S hok hqB c3 hwθ
    have hucyl := ucyl5_of_ax5_lift B G l0 S hok hqB c4 hAX
    intro a b
    have hMp : ∀ c : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ × Cyl => mcor5 B G l0 S c p.2 + ubase B p.2 c)
        (univ ×ˢ DomC B.h (qsOf l0)) :=
      fun c => ((hmcS c).add (hub c)).comp contDiff_snd.contDiffOn (fun p hp => hp.2)
    have hg : ContDiffOn ℝ ∞ (fun p : ℝ × Cyl =>
        (ucyl5 B G l0 S p.1 p.2 a - (mcor5 B G l0 S a p.2 + ubase B p.2 a)) *
        (ucyl5 B G l0 S p.1 p.2 b - (mcor5 B G l0 S b p.2 + ubase B p.2 b))) (univ ×ˢ DomC B.h (qsOf l0)) :=
      ((hucyl a).sub (hMp a)).mul ((hucyl b).sub (hMp b))
    have hI := cyl_param_integral_contDiffOn (DomC B.h (qsOf l0)) _ hDopen hg
    refine ((contDiffOn_const (c := (2 * Real.pi)⁻¹)).mul hI).congr (fun ξ _ => ?_)
    simp only [Wcov5, thA, mcor5, sub_add_cancel]

  have wsh : ∀ S : CState, InWg5 B G (qsOf l0) 1 S.Aw → ShellSupp B S.Psi → ShellSupp B S.bdir →
      ∀ a c : Fin 3, ∀ ξ ∈ DomC B.h (qsOf l0), (XC B.h ξ < B.Xa ∨ B.Xb < XC B.h ξ) →
        Wcov5 B G l0 S a c ξ = 0 := by
    intro S hAw hShP hShb a c ξ hξ hsh
    have hqsB := hqB
    obtain ⟨r, z, t, Y⟩ := ξ
    obtain ⟨hr, ht, hqs⟩ : 0 < r ∧ t < 1 ∧ qC B.h (r, z, t, Y) < qsOf l0 := hξ
    obtain ⟨hS1, -, -, hS4, -⟩ := hok.1
    obtain ⟨-, -, -, -, -, hVel, -⟩ := hok.2
    have hτ : 0 < 1 - t := by linarith
    obtain ⟨q, hqdef⟩ : ∃ q : ℝ, q = qC B.h (r, z, t, Y) := ⟨_, rfl⟩
    have hq : 0 < q := by rw [hqdef]; exact (hS1 z (1 - t) hτ).1
    have hqs' : q < qsOf l0 := by rw [hqdef]; exact hqs
    have hXC : XC B.h (r, z, t, Y) = r ^ 2 / (2 * q) := by rw [hqdef]; rfl
    have hc0 : ∀ ρ θ ζ : ℝ, rotPt ρ θ ζ 0 = ρ * Real.cos θ := by intro ρ θ ζ; simp [rotPt]
    have hc1 : ∀ ρ θ ζ : ℝ, rotPt ρ θ ζ 1 = ρ * Real.sin θ := by intro ρ θ ζ; simp [rotPt]
    have hc2 : ∀ ρ θ ζ : ℝ, rotPt ρ θ ζ 2 = ζ := by intro ρ θ ζ; simp [rotPt]
    have hsq : ∀ θ : ℝ, rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2 = r ^ 2 := by
      intro θ; rw [hc0, hc1]; linear_combination r ^ 2 * Real.cos_sq_add_sin_sq θ
    have hrad : ∀ θ : ℝ, rad (rotPt r θ z) = r := by
      intro θ
      show Real.sqrt (rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2) = r
      rw [hsq, Real.sqrt_sq hr.le]
    have hsx : ∀ θ : ℝ, simScale B.h (rotPt r θ z 2) (1 - t) = q := by
      intro θ; rw [hc2, hqdef]; rfl
    have hco : ∀ i : Fin 3, Continuous fun w : ℝ³ => w i := by
      intro i
      have h0 : Continuous (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) i) := ContinuousLinearMap.continuous _
      rwa [EuclideanSpace.coe_proj] at h0
    have hscont : Continuous fun y : ℝ³ => simScale B.h (y 2) (1 - t) := by
      have hg : Continuous fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ) := (hco 2).prodMk continuous_const
      exact hS4.continuousOn.comp_continuous hg (fun y => ⟨mem_univ _, hτ⟩)
    have hsum : Continuous fun y : ℝ³ => y 0 ^ 2 + y 1 ^ 2 := ((hco 0).pow 2).add ((hco 1).pow 2)
    obtain ⟨N, hN⟩ : ∃ N : Set ℝ³, N = {y | y 0 ^ 2 + y 1 ^ 2 < 2 * B.Xa * simScale B.h (y 2) (1 - t)} ∪
        {y | 2 * B.Xb * simScale B.h (y 2) (1 - t) < y 0 ^ 2 + y 1 ^ 2} := ⟨_, rfl⟩
    have hNo : IsOpen N := by
      rw [hN]
      exact (isOpen_lt hsum (continuous_const.mul hscont)).union (isOpen_lt (continuous_const.mul hscont) hsum)
    have hxN : ∀ θ : ℝ, rotPt r θ z ∈ N := by
      intro θ
      rw [hN]
      rcases hsh with h | h
      · refine Set.mem_union_left _ ?_
        show rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2 < 2 * B.Xa * simScale B.h (rotPt r θ z 2) (1 - t)
        rw [hsq, hsx]
        rw [hXC, div_lt_iff₀ (by linarith)] at h
        linarith
      · refine Set.mem_union_right _ ?_
        show 2 * B.Xb * simScale B.h (rotPt r θ z 2) (1 - t) < rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2
        rw [hsq, hsx]
        rw [hXC, lt_div_iff₀ (by linarith)] at h
        linarith
    have hshell : ∀ y ∈ N, ∀ Y' : ℝ × ℝ, corrOn B l0 y t →
        ptOf y t Y' ∈ DomC B.h (qsOf l0) ∧
          (XC B.h (ptOf y t Y') < B.Xa ∨ B.Xb < XC B.h (ptOf y t Y')) := by
      intro y hy Y' hc
      obtain ⟨hc1, hc2', hc3⟩ := hc
      refine ⟨(show ptOf y t Y' ∈ DomC B.h (qsOf l0) from ⟨hc1, hc2', hc3⟩), ?_⟩
      have hsy : 0 < simScale B.h (y 2) (1 - t) := (hS1 (y 2) (1 - t) hτ).1
      have hXy : XC B.h (ptOf y t Y') = (y 0 ^ 2 + y 1 ^ 2) / (2 * simScale B.h (y 2) (1 - t)) := by
        show rad y ^ 2 / (2 * simScale B.h (y 2) (1 - t)) = _
        rw [rad, Real.sq_sqrt (by positivity)]
      rw [hXy]
      rw [hN] at hy
      rcases hy with h | h
      · have h' : y 0 ^ 2 + y 1 ^ 2 < 2 * B.Xa * simScale B.h (y 2) (1 - t) := h
        left
        rw [div_lt_iff₀ (by linarith)]
        linarith
      · have h' : 2 * B.Xb * simScale B.h (y 2) (1 - t) < y 0 ^ 2 + y 1 ^ 2 := h
        right
        rw [lt_div_iff₀ (by linarith)]
        linarith
    have hAX : ∀ y ∈ N, ∀ Y' : ℝ × ℝ, AX5 B G l0 S y t Y' = B.AB y t := by
      intro y hy Y'
      unfold AX5
      by_cases hc : corrOn B l0 y t
      · rw [if_pos hc]
        obtain ⟨hD, hsh'⟩ := hshell y hy Y' hc
        have hz : ∀ γ m, S.Aw γ m (ptOf y t Y') = 0 := by
          intro γ m
          by_contra hne
          have hW := hAw.2.2.2.1 γ m (ptOf y t Y') hD hne
          obtain ⟨-, -, -, -, h5, h6⟩ := hW
          rcases hsh' with h | h <;> linarith
        have hwave : waveV5 B G S.Aw (thetaOf y) (ptOf y t Y') = 0 := by
          funext i
          simp only [waveV5, hz, Pi.zero_apply, zero_mul, finsum_zero, Complex.zero_re]
        have hpsi : S.Psi (ptOf y t Y') = 0 := hShP _ (hsh'.imp le_of_lt le_of_lt)
        rw [hwave, hpsi]
        simp [cyl2cart]
      · rw [if_neg hc, add_zero]
    have hcurl : ∀ θ : ℝ, curlX B.h (AX5 B G l0 S) (rotPt r θ z) t Y =
        curl3 (fun w => B.AB w t) (rotPt r θ z) := by
      intro θ
      have hev : (fun y => evOff B.h (AX5 B G l0 S) (Y - Yph B.h (rad (rotPt r θ z)) t) y t)
          =ᶠ[nhds (rotPt r θ z)] (fun w => B.AB w t) :=
        Filter.eventuallyEq_of_mem (hNo.mem_nhds (hxN θ)) (fun y hy => by
          show AX5 B G l0 S y t _ = B.AB y t
          exact hAX y hy _)
      show curl3 (fun y => evOff B.h (AX5 B G l0 S) (Y - Yph B.h (rad (rotPt r θ z)) t) y t) (rotPt r θ z) = _
      simp only [curl3, hev.fderiv_eq]
    have hptx : ∀ θ : ℝ, ptOf (rotPt r θ z) t Y = (r, z, t, Y) := by
      intro θ
      show (rad (rotPt r θ z), rotPt r θ z 2, t, Y) = _
      rw [hrad, hc2]
    have hbd : S.bdir (r, z, t, Y) = 0 := hShb _ (hsh.imp le_of_lt le_of_lt)
    have hBX : ∀ θ : ℝ, BX B G l0 S (rotPt r θ z) t Y = B.BvB (rotPt r θ z) t := by
      intro θ
      unfold BX
      rw [hptx θ, hbd, mul_zero, zero_smul, ite_self, add_zero]
    have huX : ∀ θ : ℝ, uX5 B G l0 S (rotPt r θ z) t Y = uB B (rotPt r θ z) t := by
      intro θ
      show curlX B.h (AX5 B G l0 S) (rotPt r θ z) t Y + BX B G l0 S (rotPt r θ z) t Y = _
      rw [hcurl θ, hBX θ]
      rfl
    have hX : ∀ θ : ℝ, simX B.h (rotPt r θ z) t = r ^ 2 / (2 * q) := by
      intro θ; unfold simX; rw [hsx, hsq]
    have hE : ∀ θ : ℝ, simEta B.h (rotPt r θ z) t = z * q ^ (-(1/2 - B.h)) := by
      intro θ; unfold simEta; rw [hsx, hc2]
    have hmem : ∀ θ : ℝ, (rotPt r θ z, t) ∈ simDomain B.h B.qB := by
      intro θ
      show t < 1 ∧ simScale B.h (rotPt r θ z 2) (1 - t) < B.qB
      rw [hsx]
      exact ⟨ht, lt_of_lt_of_le hqs' hqsB⟩
    have hpos : ∀ θ : ℝ, 0 < rotPt r θ z 0 ^ 2 + rotPt r θ z 1 ^ 2 := by
      intro θ; rw [hsq]; positivity
    have key : ∀ θ : ℝ,
        inner ℝ (uB B (rotPt r θ z) t) (frameAt θ (r, z, t, Y) 0) =
            r⁻¹ * B.Vb q (r ^ 2 / (2 * q)) (z * q ^ (-(1/2 - B.h))) ∧
        inner ℝ (uB B (rotPt r θ z) t) (frameAt θ (r, z, t, Y) 1) =
            r⁻¹ * (r * q ^ (-(1/2 + B.h)) * B.Eb q (r ^ 2 / (2 * q)) (z * q ^ (-(1/2 - B.h)))) ∧
        inner ℝ (uB B (rotPt r θ z) t) (frameAt θ (r, z, t, Y) 2) =
            q ^ (-(1/2 + B.h)) * B.Ub q (r ^ 2 / (2 * q)) (z * q ^ (-(1/2 - B.h))) := by
      intro θ
      obtain ⟨hEq, hUq, hVq⟩ := hVel (rotPt r θ z) t (hmem θ) (hpos θ)
      simp only [hsx, hX, hE] at hEq hUq hVq
      rw [hsq, Real.sqrt_sq hr.le] at hEq
      refine ⟨?_, ?_, ?_⟩
      · have hf : frameAt θ (r, z, t, Y) 0 = (rad (rotPt r θ z))⁻¹ • radVec (rotPt r θ z) := rfl
        rw [hf, real_inner_smul_right, hrad]
        exact congrArg (fun v => r⁻¹ * v) hVq
      · have hf : frameAt θ (r, z, t, Y) 1 = (rad (rotPt r θ z))⁻¹ • azVec (rotPt r θ z) := rfl
        rw [hf, real_inner_smul_right, hrad]
        exact congrArg (fun v => r⁻¹ * v) hEq
      · have hf : frameAt θ (r, z, t, Y) 2 = EuclideanSpace.single 2 1 := rfl
        rw [hf, EuclideanSpace.inner_single_right, conj_trivial, one_mul]
        exact hUq
    have hind : ∀ (θ : ℝ) (b : Fin 3),
        inner ℝ (uB B (rotPt r θ z) t) (frameAt θ (r, z, t, Y) b) = ubase B (r, z, t, Y) b := by
      intro θ b
      obtain ⟨k0, k1, k2⟩ := key θ
      obtain ⟨m0, m1, m2⟩ := key 0
      obtain rfl | rfl | rfl : b = 0 ∨ b = 1 ∨ b = 2 := by fin_cases b <;> simp
      · exact k0.trans m0.symm
      · exact k1.trans m1.symm
      · exact k2.trans m2.symm
    have hu : ∀ (θ : ℝ) (b : Fin 3), ucyl5 B G l0 S θ (r, z, t, Y) b = ubase B (r, z, t, Y) b := by
      intro θ b
      show inner ℝ (uX5 B G l0 S (rotPt r θ z) t Y) (frameAt θ (r, z, t, Y) b) = _
      rw [huX θ]
      exact hind θ b
    have hthc : ∀ c0 : ℝ, thA (fun _ => c0) = c0 := by
      intro c0
      simp only [thA]
      have hπ : (2 * Real.pi) ≠ 0 := by positivity
      rw [intervalIntegral.integral_const, smul_eq_mul, sub_zero, ← mul_assoc, inv_mul_cancel₀ hπ, one_mul]
    show thA (fun θ => (ucyl5 B G l0 S θ (r, z, t, Y) a - thA (fun θ' => ucyl5 B G l0 S θ' (r, z, t, Y) a)) *
        (ucyl5 B G l0 S θ (r, z, t, Y) c - thA (fun θ' => ucyl5 B G l0 S θ' (r, z, t, Y) c))) = 0
    simp only [hu, hthc, sub_self, mul_zero]

  have hWs := wsm (primState5 B G) hAw hZ hZ hmc
  have hWv := wsh (primState5 B G) hAw (fun _ _ => rfl) (fun _ _ => rfl)
  exact ⟨grP5_contDiffOn_v5 B G l0 (primState5 B G) hDopen hub hmc hWs,
    grP5_shell_vanish_v5 B G l0 (primState5 B G) hok (fun a ξ hξ _ => hm0 a ξ hξ) hWv⟩

theorem path_integral_smooth_v5 : ∀ (B : BG) (qs : ℝ) (g : Cyl → ℝ), B.ok → 0 < qs → qs ≤ 1 → ContDiffOn ℝ ∞ g (DomC B.h qs) → (∀ ξ ∈ DomC B.h qs, (XC B.h ξ ≤ B.Xa ∨ B.Xb ≤ XC B.h ξ) → g ξ = 0) → ContDiffOn ℝ ∞ (fun ζ : ℝ × ℝ × (ℝ × ℝ) => ∫ r in Set.Ioi (0:ℝ), g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv)) {ζ | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} ∧ (∀ (k : ℕ) (ζ : ℝ × ℝ × (ℝ × ℝ)), ζ.2.1 < 1 → simScale B.h ζ.1 (1 - ζ.2.1) < qs → ∀ v : Fin k → ℝ × ℝ × (ℝ × ℝ), iteratedFDeriv ℝ k (fun ζ' : ℝ × ℝ × (ℝ × ℝ) => ∫ r in Set.Ioi (0:ℝ), g (r, ζ'.1, ζ'.2.1, ζ'.2.2 + (r ^ drx B.h) • vrv)) ζ v = ∫ r in Set.Ioi (0:ℝ), iteratedFDeriv ℝ k g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv) (fun i => ((0:ℝ), (v i).1, (v i).2.1, (v i).2.2))) ∧ ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => ∫ r in Set.Ioi (0:ℝ), ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (r, w.1, w.2, Y)) {w | w.2 < 1 ∧ simScale B.h w.1 (1 - w.2) < qs} ∧ (∀ (k : ℕ) (w : ℝ × ℝ), w.2 < 1 → simScale B.h w.1 (1 - w.2) < qs → ∀ v : Fin k → ℝ × ℝ, iteratedFDeriv ℝ k (fun w' : ℝ × ℝ => ∫ r in Set.Ioi (0:ℝ), ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, g (r, w'.1, w'.2, Y)) w v = ∫ r in Set.Ioi (0:ℝ), ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, iteratedFDeriv ℝ k g (r, w.1, w.2, Y) (fun i => ((0:ℝ), (v i).1, (v i).2, (0 : ℝ × ℝ)))) ∧ (∀ (ζ : ℝ × ℝ × (ℝ × ℝ)) (p : ℝ), ζ.2.1 < 1 → simScale B.h ζ.1 (1 - ζ.2.1) < qs → 0 < p → DifferentiableAt ℝ (fun pζ : ℝ × (ℝ × ℝ × (ℝ × ℝ)) => ∫ r in (0:ℝ)..pζ.1, g (r, pζ.2.1, pζ.2.2.1, pζ.2.2.2 + (r ^ drx B.h) • vrv)) (p, ζ) ∧ HasDerivAt (fun p' : ℝ => ∫ r in (0:ℝ)..p', g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv)) (g (p, ζ.1, ζ.2.1, ζ.2.2 + (p ^ drx B.h) • vrv)) p) :=
by
  intro B qs g hok hqs0 hqs1 hgs hgz


  have engine : ∀ {H A : Type} [NormedAddCommGroup H] [NormedSpace ℝ H] [FiniteDimensional ℝ H]
      [NormedAddCommGroup A] [NormedSpace ℝ A] [FiniteDimensional ℝ A] [MeasurableSpace A] [BorelSpace A]
      (μ : Measure A) [IsFiniteMeasureOnCompacts μ] (Ω : Set H) (W S : Set A) (F : H → A → ℝ),
      IsOpen Ω → IsOpen W → MeasurableSet S → S ⊆ W →
      ContDiffOn ℝ ∞ (fun p : H × A => F p.1 p.2) (Ω ×ˢ W) →
      (∀ x₀ ∈ Ω, ∃ (U : Set H) (K : Set A), IsOpen U ∧ x₀ ∈ U ∧ U ⊆ Ω ∧ IsCompact K ∧ K ⊆ W ∧
        ∀ x ∈ U, ∀ a ∈ S, a ∉ K → F x a = 0) →
      ContDiffOn ℝ ∞ (fun x : H => ∫ a in S, F x a ∂μ) Ω ∧
      (∀ x ∈ Ω, IntegrableOn (fun a => F x a) S μ) ∧
      ∀ (k : ℕ) (x : H), x ∈ Ω → ∀ v : Fin k → H,
        IntegrableOn (fun a => iteratedFDeriv ℝ k (fun x' : H => F x' a) x v) S μ ∧
        iteratedFDeriv ℝ k (fun x' : H => ∫ a in S, F x' a ∂μ) x v =
          ∫ a in S, iteratedFDeriv ℝ k (fun x' : H => F x' a) x v ∂μ := by
    intro H A _ _ _ _ _ _ _ _ μ _ Ω W S F hΩ hW hS hSW hF hloc
    choose! U K hUo hxU hUΩ hKc hKW hFz using hloc
    have hΩW : IsOpen (Ω ×ˢ W) := hΩ.prod hW
    have d1 : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (Ψ : H × A → E),
        ContDiffOn ℝ ∞ Ψ (Ω ×ˢ W) →
        ContDiffOn ℝ ∞ (fun p : H × A => fderiv ℝ (fun x' => Ψ (x', p.2)) p.1) (Ω ×ˢ W) := by
      intro E _ _ Ψ hΨ p hp
      have hΨa : ContDiffAt ℝ ∞ Ψ p := hΨ.contDiffAt (hΩW.mem_nhds hp)
      apply ContDiffAt.contDiffWithinAt
      have h1 : ContDiffAt ℝ ∞ (Function.uncurry (fun (q : H × A) (x' : H) => Ψ (x', q.2))) (p, p.1) := by
        have e : Function.uncurry (fun (q : H × A) (x' : H) => Ψ (x', q.2)) =
            Ψ ∘ (fun z : (H × A) × H => (z.2, z.1.2)) := rfl
        rw [e]
        apply ContDiffAt.comp (g := Ψ) (p, p.1)
        · simpa using hΨa
        · fun_prop
      exact ContDiffAt.fderiv (f := fun (q : H × A) (x' : H) => Ψ (x', q.2))
        (g := Prod.fst) h1 contDiffAt_fst (le_of_eq ENat.coe_top_add_one)
    have d2 : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (Ψ : H × A → E),
        (∀ x₀ ∈ Ω, ∀ x ∈ U x₀, ∀ a ∈ S, a ∉ K x₀ → Ψ (x, a) = 0) →
        ∀ x₀ ∈ Ω, ∀ x ∈ U x₀, ∀ a ∈ S, a ∉ K x₀ → fderiv ℝ (fun x' => Ψ (x', a)) x = 0 := by
      intro E _ _ Ψ hZ x₀ hx₀ x hx a ha haK
      have hev : (fun x' => Ψ (x', a)) =ᶠ[nhds x] fun _ => (0 : E) :=
        Filter.eventuallyEq_of_mem ((hUo x₀ hx₀).mem_nhds hx) (fun x' hx' => hZ x₀ hx₀ x' hx' a ha haK)
      rw [hev.fderiv_eq]
      exact fderiv_const_apply _
    have d3 : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (Ψ : H × A → E),
        ContDiffOn ℝ ∞ Ψ (Ω ×ˢ W) → (∀ x₀ ∈ Ω, ∀ x ∈ U x₀, ∀ a ∈ S, a ∉ K x₀ → Ψ (x, a) = 0) →
        ∀ x ∈ Ω, IntegrableOn (fun a => Ψ (x, a)) S μ := by
      intro E _ _ Ψ hΨ hZ x hx
      have hc : ContinuousOn (fun a => Ψ (x, a)) W :=
        hΨ.continuousOn.comp (Continuous.continuousOn (by fun_prop)) (fun a ha => ⟨hx, ha⟩)
      exact (ContinuousOn.integrableOn_compact (hKc x hx) (hc.mono (hKW x hx))).of_forall_sdiff_eq_zero hS
        (fun a ha => hZ x hx x (hxU x hx) a ha.1 ha.2)
    have d4 : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] (Ψ : H × A → E),
        ContDiffOn ℝ ∞ Ψ (Ω ×ˢ W) → (∀ x₀ ∈ Ω, ∀ x ∈ U x₀, ∀ a ∈ S, a ∉ K x₀ → Ψ (x, a) = 0) →
        ∀ x₀ ∈ Ω, HasFDerivAt (fun x => ∫ a in S, Ψ (x, a) ∂μ)
          (∫ a in S, fderiv ℝ (fun x' => Ψ (x', a)) x₀ ∂μ) x₀ := by
      intro E _ _ _ Ψ hΨ hZ x₀ hx₀
      have hD := d1 Ψ hΨ
      have hDZ := d2 Ψ hZ
      obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp (hUo x₀ hx₀) x₀ (hxU x₀ hx₀)
      have hsU : Metric.closedBall x₀ (δ / 2) ⊆ U x₀ :=
        (Metric.closedBall_subset_ball (by linarith)).trans hball
      have hsΩ : Metric.closedBall x₀ (δ / 2) ⊆ Ω := hsU.trans (hUΩ x₀ hx₀)
      have hsn : Metric.closedBall x₀ (δ / 2) ∈ nhds x₀ := Metric.closedBall_mem_nhds x₀ (by linarith)
      have hKK : IsCompact (Metric.closedBall x₀ (δ / 2) ×ˢ K x₀) :=
        (isCompact_closedBall _ _).prod (hKc x₀ hx₀)
      have hKsub : Metric.closedBall x₀ (δ / 2) ×ˢ K x₀ ⊆ Ω ×ˢ W := prod_mono hsΩ (hKW x₀ hx₀)
      obtain ⟨C, hC⟩ := hKK.exists_bound_of_continuousOn (hD.continuousOn.mono hKsub)
      have hcW : ∀ x ∈ Ω, ContinuousOn (fun a => Ψ (x, a)) W := fun x hx =>
        hΨ.continuousOn.comp (Continuous.continuousOn (by fun_prop)) (fun a ha => ⟨hx, ha⟩)
      have hcW' : ContinuousOn (fun a => fderiv ℝ (fun x' => Ψ (x', a)) x₀) W :=
        hD.continuousOn.comp (f := fun a : A => ((x₀, a) : H × A))
          (Continuous.continuousOn (by fun_prop)) (fun a ha => ⟨hx₀, ha⟩)
      have hKm : MeasurableSet (K x₀) := (hKc x₀ hx₀).isClosed.measurableSet
      refine hasFDerivAt_integral_of_dominated_of_fderiv_le (μ := μ.restrict S)
        (F := fun x a => Ψ (x, a)) (F' := fun x a => fderiv ℝ (fun x' => Ψ (x', a)) x)
        (bound := (K x₀).indicator (fun _ => C)) hsn ?_ ?_ ?_ ?_ ?_ ?_
      · filter_upwards [hΩ.mem_nhds hx₀] with x hx
        exact ((hcW x hx).mono hSW).aestronglyMeasurable hS
      · exact d3 Ψ hΨ hZ x₀ hx₀
      · exact (hcW'.mono hSW).aestronglyMeasurable hS
      · refine ae_restrict_of_forall_mem hS (fun a ha x hx => ?_)
        by_cases haK : a ∈ K x₀
        · rw [indicator_of_mem haK]
          exact hC (x, a) ⟨hx, haK⟩
        · rw [indicator_of_notMem haK, hDZ x₀ hx₀ x (hsU hx) a ha haK, norm_zero]
      · exact ((integrable_indicator_iff hKm).2
          (integrableOn_const (hKc x₀ hx₀).measure_lt_top.ne)).integrableOn
      · refine ae_restrict_of_forall_mem hS (fun a ha x hx => ?_)
        have hxa : (x, a) ∈ Ω ×ˢ W := ⟨hsΩ hx, hSW ha⟩
        have hΨa : ContDiffAt ℝ ∞ Ψ (x, a) := hΨ.contDiffAt (hΩW.mem_nhds hxa)
        have : ContDiffAt ℝ ∞ (fun x' => Ψ (x', a)) x :=
          hΨa.comp x (by fun_prop : ContDiffAt ℝ ∞ (fun x' : H => ((x', a) : H × A)) x)
        exact (this.differentiableAt (by simp)).hasFDerivAt
    have d5 : ∀ (k : ℕ) {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
        (Ψ : H × A → E), ContDiffOn ℝ ∞ Ψ (Ω ×ˢ W) →
        (∀ x₀ ∈ Ω, ∀ x ∈ U x₀, ∀ a ∈ S, a ∉ K x₀ → Ψ (x, a) = 0) →
        ∀ x ∈ Ω, ∀ v : Fin k → H,
        IntegrableOn (fun a => iteratedFDeriv ℝ k (fun x' => Ψ (x', a)) x v) S μ ∧
        iteratedFDeriv ℝ k (fun x' => ∫ a in S, Ψ (x', a) ∂μ) x v =
          ∫ a in S, iteratedFDeriv ℝ k (fun x' => Ψ (x', a)) x v ∂μ := by
      intro k
      induction k with
      | zero =>
        intro E _ _ _ Ψ hΨ hZ x hx v
        simp only [iteratedFDeriv_zero_apply, and_true]
        exact d3 Ψ hΨ hZ x hx
      | succ k ih =>
        intro E _ _ _ Ψ hΨ hZ x hx v
        obtain ⟨Ψ', hΨ'⟩ : ∃ Ψ' : H × A → (H →L[ℝ] E),
            Ψ' = fun p => fderiv ℝ (fun x' => Ψ (x', p.2)) p.1 := ⟨_, rfl⟩
        have hfun : ∀ (a : A) (y : H), Ψ' (y, a) = fderiv ℝ (fun x' => Ψ (x', a)) y := by
          intro a y; rw [hΨ']
        have hD : ContDiffOn ℝ ∞ Ψ' (Ω ×ˢ W) := by rw [hΨ']; exact d1 Ψ hΨ
        have hDZ : ∀ x₀ ∈ Ω, ∀ y ∈ U x₀, ∀ a ∈ S, a ∉ K x₀ → Ψ' (y, a) = 0 := by
          intro x₀ hx₀ y hy a ha haK
          rw [hfun]; exact d2 Ψ hZ x₀ hx₀ y hy a ha haK
        obtain ⟨hI, hEq⟩ := ih Ψ' hD hDZ x hx (Fin.init v)
        have hpt : ∀ a, iteratedFDeriv ℝ (k + 1) (fun x' => Ψ (x', a)) x v =
            iteratedFDeriv ℝ k (fun x' => Ψ' (x', a)) x (Fin.init v) (v (Fin.last k)) := by
          intro a
          rw [iteratedFDeriv_succ_apply_right]
          simp only [hfun]
        have hev : fderiv ℝ (fun x' => ∫ a in S, Ψ (x', a) ∂μ) =ᶠ[nhds x]
            (fun x' => ∫ a in S, Ψ' (x', a) ∂μ) := by
          filter_upwards [hΩ.mem_nhds hx] with y hy
          rw [(d4 Ψ hΨ hZ y hy).fderiv]
          simp only [hfun]
        refine ⟨?_, ?_⟩
        · simp only [hpt]
          exact hI.apply_continuousLinearMap _
        · rw [iteratedFDeriv_succ_apply_right, (hev.iteratedFDeriv ℝ k).eq_of_nhds, hEq,
            ContinuousLinearMap.integral_apply hI]
          simp only [hpt]
    have d6 : ∀ (n : ℕ) {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
        (Ψ : H × A → E), ContDiffOn ℝ ∞ Ψ (Ω ×ˢ W) →
        (∀ x₀ ∈ Ω, ∀ x ∈ U x₀, ∀ a ∈ S, a ∉ K x₀ → Ψ (x, a) = 0) →
        ContDiffOn ℝ n (fun x => ∫ a in S, Ψ (x, a) ∂μ) Ω := by
      intro n
      induction n with
      | zero =>
        intro E _ _ _ Ψ hΨ hZ
        rw [Nat.cast_zero, contDiffOn_zero]
        exact fun x hx => (d4 Ψ hΨ hZ x hx).differentiableAt.continuousAt.continuousWithinAt
      | succ n ih =>
        intro E _ _ _ Ψ hΨ hZ
        obtain ⟨Ψ', hΨ'⟩ : ∃ Ψ' : H × A → (H →L[ℝ] E),
            Ψ' = fun p => fderiv ℝ (fun x' => Ψ (x', p.2)) p.1 := ⟨_, rfl⟩
