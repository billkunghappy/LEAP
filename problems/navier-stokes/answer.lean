    constructor
    · unfold axShearA
      rw [hθ z hz1, hl1, hp]
      ring
    · unfold axSlopeU
      rw [hβ z hz1, hl2]
      exact alg2 _ _ _ _ _ _ _ hL (Real.sqrt_pos.mpr (by positivity)) hf
        (Real.mul_self_sqrt (by positivity)) hTz'

  have hV : MapsTo (fun z : ℝ => 4 / Λ * Real.exp z) (Icc 0 (2 * t1)) (Ioo (-1 / Λ) (5 / Λ)) := by
    intro z hz
    obtain ⟨a1, a2⟩ := hXz z hz.1 hz.2
    exact ⟨by linarith, by linarith⟩
  have heI : e ∈ Ioo (-1 - ρ1) (1 + ρ1) := ⟨by linarith, by linarith⟩
  have hmapsY : MapsTo (fun Y : ℝ => (Y, e)) (Ioo (-1 / Λ) (5 / Λ))
