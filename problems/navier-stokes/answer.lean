        have := hs.1
        intro h
        linarith
      fin_cases i
      · show |nPhiP5 B G γ (pulsePth5 B G γ ξ t) 0| ≤ _
        have := hbd t 0 0 0 _ hV
          (fun s hs => by rw [(hN _ (hJ s hs).1 (hJ s hs).2).1]; ring)
        rw [abs_zero] at this
        linarith
      · show |nPhiP5 B G γ (pulsePth5 B G γ ξ t) 1| ≤ _
        have := hb1 t
        linarith
      · show |nPhiP5 B G γ (pulsePth5 B G γ ξ t) 2| ≤ _
        have := hbd t 2 0 0 _ hV
          (fun s hs => by rw [(hN _ (hJ s hs).1 (hJ s hs).2).2]; ring)
        rw [abs_zero] at this
        linarith

theorem pulse_zero_src_v5 : ∀ (B : BG) (G : CorrGeom) (f : WC) (γ : Lab) (m : ℤ) (ξ : Cyl), B.ok → GeomPrim5 B G → (∀ w ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), srcHat B f γ m (pulsePth5 B G γ ξ w) = 0) → pulseTw5 B G f γ m ξ = 0 :=
