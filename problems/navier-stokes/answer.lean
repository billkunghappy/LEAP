  have hshift : ∀ (κ : ℤ × ℤ) (a : ℝ × ℝ) (y : Cyl),
      fourY F (y + ((0:ℝ), (0:ℝ), (0:ℝ), a)) κ *
        Complex.exp ((2 * Real.pi * Complex.I) * ((κ.1 : ℂ) * ((y + ((0:ℝ), (0:ℝ), (0:ℝ), a)).2.2.2.1 : ℂ) +
