theorem ax_ff_stress_alg : ∀ (h : ℝ) (Pax : ℝ → ℝ) (F U F' U' : ℝ → ℝ → ℝ) (X η e R1 R2 R3 D0 D1 D2 D3 D4 dD0 dD1 dD2 dD3 dD4 : ℝ), 0 < h → h < 1 / 100 → 0 < X → -1 < η → η < 1 → 0 < F X η → 0 < F' X η → F' X η = F X η * (1 + e * R1) → (F' X η)⁻¹ = (F X η)⁻¹ * (1 + e * R2) → U' X η = U X η - e * R3 → profRadInt U' X η = profRadInt U X η + e * D0 → profEtaD (profRadInt U') X η = profEtaD (profRadInt U) X η + e * dD0 → profRadInt (fun x e => 2 * x * F' x e) X η = profRadInt (fun x e => 2 * x * F x e) X η + e * D1 → profEtaD (profRadInt (fun x e => 2 * x * F' x e)) X η = profEtaD (profRadInt (fun x e => 2 * x * F x e)) X η + e * dD1 → profRadInt (fun x e => U' x e * (2 * x * F' x e)) X η = profRadInt (fun x e => U x e * (2 * x * F x e)) X η + e * D2 → profEtaD (profRadInt (fun x e => U' x e * (2 * x * F' x e))) X η = profEtaD (profRadInt (fun x e => U x e * (2 * x * F x e))) X η + e * dD2 → profRadInt (fun x e => U' x e ^ 2 - x * F' x e ^ 2) X η = profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2) X η + e * D3 → profEtaD (profRadInt (fun x e => U' x e ^ 2 - x * F' x e ^ 2)) X η = profEtaD (profRadInt (fun x e => U x e ^ 2 - x * F x e ^ 2)) X η + e * dD3 → axPi Pax F' X η = axPi Pax F X η + e * D4 → profEtaD (axPi Pax F') X η = profEtaD (axPi Pax F) X η + e * dD4 → shearA F' X η = (1 - e) * shearA F X η → shearB F' U' X η = (1 - e) * shearB F U X η * F X η / F' X η → leadStressTh h F U X η = 0 → axTz h Pax F U X η = 0 → leadStressTh h F' U' X η = e * (F' X η * (shearA F X η + X * ((2 * (1 / 2 - h) * η * D0 + (1 - η ^ 2) * dD0) / X + (((1 - h) * D1 - (1 / 2 - h) * η * dD1 - (1 - η ^ 2) * dD2 + 2 * (h - (1 / 2 - h)) * η * D2) * (1 + e * R2) + ((1 - h) * profRadInt (fun x e => 2 * x * F x e) X η - (1 / 2 - h) * η * profEtaD (profRadInt (fun x e => 2 * x * F x e)) X η - (1 - η ^ 2) * profEtaD (profRadInt (fun x e => U x e * (2 * x * F x e))) X η + 2 * (h - (1 / 2 - h)) * η * profRadInt (fun x e => U x e * (2 * x * F x e)) X η) * R2) / (2 * X ^ 2 * F X η)) / (1 - 2 * h * η ^ 2))) ∧ axTz h Pax F' U' X η = e * (X * (leadW h U X η * R3 + (2 * (1 / 2 - h) * η * D0 + (1 - η ^ 2) * dD0) / X * U X η - e * ((2 * (1 / 2 - h) * η * D0 + (1 - η ^ 2) * dD0) / X) * R3 + ((1 / 2 - h) * (D0 - η * dD0) + 4 * h * η * D3 - (1 - η ^ 2) * dD3) / X + 4 * (1 / 2 + h) * η * D4 - (1 - η ^ 2) * dD4) / ((1 - 2 * h * η ^ 2) * Real.sqrt (2 * X)) - F X η * shearB F U X η) :=
by
  intro h Pax F U F' U' X η e R1 R2 R3 D0 D1 D2 D3 D4 dD0 dD1 dD2 dD3 dD4 hh0 hh1 hX hη1 hη2
    hF hF' _hR1 hR2 hU3 hD0 hdD0 hD1 hdD1 hD2 hdD2 hD3 hdD3 hD4 hdD4 hshA hshB hz1 hz2
  have hXne : X ≠ 0 := hX.ne'
  have hFne : F X η ≠ 0 := hF.ne'
  have hF'ne : F' X η ≠ 0 := hF'.ne'
  have hη2' : η ^ 2 < 1 := by nlinarith
  have hhη : h * η ^ 2 ≤ h := by nlinarith
  have hL : 1 - 2 * h * η ^ 2 ≠ 0 := by
    have : 0 < 1 - 2 * h * η ^ 2 := by linarith
    exact this.ne'
  have hs : Real.sqrt (2 * X) ≠ 0 := (Real.sqrt_pos.mpr (by linarith)).ne'
  have hlead : ∀ V : ℝ → ℝ → ℝ, leadW h V X η = 1 - 2 * (1 / 2 - h) * η *
      (X⁻¹ * profRadInt V X η) - (1 - η ^ 2) * (X⁻¹ * profEtaD (profRadInt V) X η) := by
    intro V
    have havg : ∀ e : ℝ, profRadAvg V X e = X⁻¹ * profRadInt V X e := by
      intro e
      unfold profRadAvg profRadInt
      have := intervalIntegral.integral_comp_mul_right (fun x => V x e) hXne (a := 0) (b := 1)
      simp only [zero_mul, one_mul, smul_eq_mul] at this
      exact this
    have hfun : (fun e => profRadAvg V X e) = fun e => X⁻¹ * profRadInt V X e := funext havg
    have hd : profEtaD (profRadAvg V) X η = X⁻¹ * profEtaD (profRadInt V) X η := by
      unfold profEtaD
      rw [hfun]
      exact congrFun (deriv_const_mul_field' (v := fun e => profRadInt V X e) X⁻¹) η
    unfold leadW
    rw [havg η, hd]
  have hW' : leadW h U' X η = leadW h U X η -
      e * ((2 * (1 / 2 - h) * η * D0 + (1 - η ^ 2) * dD0) / X) := by
    rw [hlead U', hlead U, hD0, hdD0]
    field_simp
    ring
  have hA : shearA F X η = X * leadQs h F U X η / (1 - 2 * h * η ^ 2) := by
    unfold leadStressTh at hz1
    rcases mul_eq_zero.mp hz1 with h0 | h0
    · exact absurd h0 hFne
