    simp only [zero_add]
  have hg0 : ∀ γ η, g γ 0 η = 0 := by
    intro γ η; rw [hgv]; simp [pchG5]
  obtain ⟨HP, hP0, hPv⟩ := hP.1
  have hPair0 : ∀ γ N η, (∀ p ∈ HP, ∀ q ∈ HP, p + q ≠ N) → (∀ p ∈ HP, ∀ q ∈ HP, q - p ≠ N) →
