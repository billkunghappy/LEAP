  obtain ⟨c1, hc1⟩ : ∃ c : ℝ, c = a ^ (-(1 + h) + 1) / (1 + h - 1) := ⟨_, rfl⟩
  obtain ⟨c2, hc2⟩ : ∃ c : ℝ, c = a ^ (-(2 + 2 * h) + 1) / (2 + 2 * h - 1) := ⟨_, rfl⟩
  obtain ⟨c3, hc3⟩ : ∃ c : ℝ, c = a ^ (-(3 + 2 * h) + 1) / (3 + 2 * h - 1) := ⟨_, rfl⟩
  have hc10 : 0 ≤ c1 := by rw [hc1]; exact div_nonneg (Real.rpow_nonneg ha.le _) (by linarith)
  have hc20 : 0 ≤ c2 := by rw [hc2]; exact div_nonneg (Real.rpow_nonneg ha.le _) (by linarith)
  have hc30 : 0 ≤ c3 := by rw [hc3]; exact div_nonneg (Real.rpow_nonneg ha.le _) (by linarith)
