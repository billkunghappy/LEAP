  have hM0 := abs_nonneg (M 0)
  have hM1 := abs_nonneg (M 1)
  refine ⟨?_, ?_, hdA, ?_, hdB, ?_⟩
  · have h1 : ‖∫ y in (0:ℝ)..axLogY Λ X, axShearA h Λ t1 κ0 om Fn Un y η‖ ≤
