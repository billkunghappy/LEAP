    obtain ⟨cJ1, dJ1⟩ := hD _ (slice U hU).2 e0 he0
    obtain ⟨cJ2, dJ2⟩ := hD _ (slice _ hg3).2 e0 he0
    obtain ⟨cP, dP⟩ := hD _ hPi e0 he0
