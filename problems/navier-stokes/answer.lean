    rw [hgerm _ _ hPsi0e]
    refine (hlin _ _ (hDv _ hFa ((1:ℝ), (0:ℝ), (0:ℝ))) (hDv _ (hb 2) ((1:ℝ), (0:ℝ), (0:ℝ)))
      (pang5 B G γ) (pzr5 B G γ)).trans ?_
    have h1 := mul_le_mul hpa (hFF _ (Or.inl rfl) j hj).2.1 (hNB0 _ _) hC₁0.le
    have h2 := mul_le_mul hpz (hFF _ (Or.inr rfl) j hj).2.1 (hNB0 _ _) hC₁0.le
    rw [hPp]; linarith
  have hPs2 : ContDiffOn ℝ ∞ (fun η : Cyl => pcPsi5 B G γ (η.1, η.2.1, η.2.2.1) 2) (DomC B.h B.qB) ∧
      NB B.h (fun η : Cyl => pcPsi5 B G γ (η.1, η.2.1, η.2.2.1) 2) j ξ ≤ Pp := by
    have hc : ContDiffOn ℝ ∞ (fun η : Cyl =>
        pang5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))) +
        pzr5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (η.1, η.2.1, η.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ))))
        (DomC B.h B.qB) :=
      (contDiffOn_const.mul (hDv _ hFa _)).add (contDiffOn_const.mul (hDv _ (hb 2) _))
    refine ⟨hc.congr hPsi2e, ?_⟩
    rw [hgerm _ _ hPsi2e]
    refine (hlin _ _ (hDv _ hFa ((0:ℝ), (1:ℝ), (0:ℝ))) (hDv _ (hb 2) ((0:ℝ), (1:ℝ), (0:ℝ)))
      (pang5 B G γ) (pzr5 B G γ)).trans ?_
    have h1 := mul_le_mul hpa (hFF _ (Or.inl rfl) j hj).2.2 (hNB0 _ _) hC₁0.le
    have h2 := mul_le_mul hpz (hFF _ (Or.inr rfl) j hj).2.2 (hNB0 _ _) hC₁0.le
    rw [hPp]; linarith
  have hPs1 : ContDiffOn ℝ ∞ (fun η : Cyl => pcPsi5 B G γ (η.1, η.2.1, η.2.2.1) 1) (DomC B.h B.qB) ∧
      NB B.h (fun η : Cyl => pcPsi5 B G γ (η.1, η.2.1, η.2.2.1) 1) j ξ ≤ Pp := by
    show ContDiffOn ℝ ∞ (fun _ : Cyl => (0:ℝ)) (DomC B.h B.qB) ∧ NB B.h (fun _ : Cyl => (0:ℝ)) j ξ ≤ Pp
    exact ⟨contDiffOn_const, (hconst 0).trans (by rw [abs_zero]; exact hPp0)⟩
  have hPsi : ∀ i : Fin 3,
      ContDiffOn ℝ ∞ (fun η : Cyl => pcPsi5 B G γ (η.1, η.2.1, η.2.2.1) i) (DomC B.h B.qB) ∧
      NB B.h (fun η : Cyl => pcPsi5 B G γ (η.1, η.2.1, η.2.2.1) i) j ξ ≤ Pp := by
    intro i
    fin_cases i
    · exact hPs0
    · exact hPs1
    · exact hPs2

  have hK0 : NB B.h (fun _ : Cyl => (0:ℝ)) j ξ ≤ Kk :=
    (hconst 0).trans (by rw [abs_zero]; exact hKk0)
  have hK01 : NB B.h (fun η : Cyl => pcKm5 B γ.1 (η.1, η.2.1, η.2.2.1) 0 1) j ξ ≤ Kk := by
    show NB B.h (fun η : Cyl => -2 * pcFa5 B γ.1 (η.1, η.2.1, η.2.2.1)) j ξ ≤ Kk
    refine (hsc _ (hP _ hFa) (-2)).trans ?_
    rw [abs_neg, abs_two]
    have := (hFF _ (Or.inl rfl) j hj).1
    have := mul_nonneg (mul_nonneg (pow_nonneg (by norm_num : (0:ℝ) ≤ 2) k) hR0) hS20
    rw [hKk]; linarith
  have hK10 : NB B.h (fun η : Cyl => pcKm5 B γ.1 (η.1, η.2.1, η.2.2.1) 1 0) j ξ ≤ Kk := by
    have e : (fun η : Cyl => pcKm5 B γ.1 (η.1, η.2.1, η.2.2.1) 1 0) =
        fun η => 2 * pcFa5 B γ.1 (η.1, η.2.1, η.2.2.1) + 1 * (RC γ.1 η *
          (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)))) := by
      funext η
      rw [one_mul]
      rfl
    rw [e]
    have hprodc : ContDiffOn ℝ ∞ (fun η : Cyl => RC γ.1 η *
        (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ))))
        (DomC B.h B.qB) := hRCc.contDiffOn.mul (hDv _ hFa _)
    have hprod := nb_real_mul_le_v5 B.h ξ (fun η : Cyl => RC γ.1 η)
      (fun η : Cyl => Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) (η.1, η.2.1, η.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)))
      j R S2 (hat _ hRCc.contDiffOn) (hat _ (hDv _ hFa _)) (fun i _ => hRCb i)
      (fun i hi => (hFF _ (Or.inl rfl) i (hi.trans hj)).2.1)
    refine (hlin _ _ (hP _ hFa) hprodc 2 1).trans ?_
    rw [abs_two, abs_one]
    have h2k : (2:ℝ) ^ j ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hj
    have h3 : (2:ℝ) ^ j * R * S2 ≤ 2 ^ k * R * S2 :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right h2k hR0) hS20
    have := (hFF _ (Or.inl rfl) j hj).1
    rw [hKk]; linarith
  have hK20 : NB B.h (fun η : Cyl => pcKm5 B γ.1 (η.1, η.2.1, η.2.2.1) 2 0) j ξ ≤ Kk := by
    show NB B.h (fun η : Cyl => Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) (η.1, η.2.1, η.2.2.1)
      ((1:ℝ), (0:ℝ), (0:ℝ))) j ξ ≤ Kk
    have := (hFF _ (Or.inr rfl) j hj).2.1
    have := mul_nonneg (mul_nonneg (pow_nonneg (by norm_num : (0:ℝ) ≤ 2) k) hR0) hS20
    rw [hKk]; linarith
  have hDSC : Aa + Pp + Kk ≤ (Aa + Pp + Kk) * SC B.h ξ := le_mul_of_one_le_right (by linarith) hSC1
  have hKD : Kk ≤ (Aa + Pp + Kk) * SC B.h ξ := by linarith
  refine ⟨?_, ?_, ?_⟩
  · intro i
    have eN : (fun η : Cyl => pcN5 B G γ (η.1, η.2.1, η.2.2.1) v i) =
        fun η => 1 * pcA5 B G γ (η.1, η.2.1, η.2.2.1) i + (-v) * pcPsi5 B G γ (η.1, η.2.1, η.2.2.1) i := by
      funext η
      show pcA5 B G γ _ i - v * pcPsi5 B G γ _ i = _
      ring
    rw [eN]
    obtain ⟨hAc, hAb⟩ := hA i
    obtain ⟨hPc, hPb⟩ := hPsi i
    refine (hlin _ _ hAc hPc 1 (-v)).trans ?_
    rw [abs_one, abs_neg, abs_of_nonneg hv.1]
    have h1 := le_mul_of_one_le_right hAa0 hSC1
    have h2 := mul_le_mul_of_nonneg_right hvSC hPp0
    have h3 := mul_le_mul_of_nonneg_left hPb hv.1
    have h4 : 0 ≤ Kk * SC B.h ξ := mul_nonneg hKk0 (by linarith)
    nlinarith
  · intro i
    exact (hPsi i).2.trans (by linarith)
  · intro i i'
    fin_cases i <;> fin_cases i'
    · exact hK0.trans hKD
    · exact hK01.trans hKD
    · exact hK0.trans hKD
    · exact hK10.trans hKD
    · exact hK0.trans hKD
    · exact hK0.trans hKD
    · exact hK20.trans hKD
    · exact hK0.trans hKD
    · exact hK0.trans hKD

theorem chart_profile_nb_v5 : ∀ B : BG, B.ok → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C : ℝ, ∀ (l l0 : ℕ), l1 ≤ l0 → l0 ≤ l → ∀ ξ ∈ DomC B.h (qsOf l0), 1/4 < qC B.h ξ / Qb l → qC B.h ξ / Qb l < 4 → B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → NB B.h (fun η : Cyl => pcFa5 B l (η.1, η.2.1, η.2.2.1)) k ξ ≤ C ∧ NB B.h (fun η : Cyl => pcB5 B l 2 (η.1, η.2.1, η.2.2.1)) k ξ ≤ C :=
by
  intro B hB
  obtain ⟨hh0, hh1, hXa, -, -, -, -, hqB0, hqB1, -, -, -, -⟩ := hB.2.1
  obtain ⟨-, -, -, -, -, hc6, ⟨hGE, hGU, -, -⟩, -⟩ := hB.2
  have hS : SimScaleProps B.h := hB.1
  have SN : SimNorm B.h := simscale_normalized_v4 B.h hh0 hh1 hS
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨n0, ?_⟩
  intro k

  have hqpos : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hqC' : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) (DomC B.h B.qB) :=
    hqC'.mono (fun η hη => hη.2.1)
  have hDo : IsOpen (DomC B.h B.qB) := by
    have hT : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
    have h1 : IsOpen ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Iio B.qB) :=
      hqC'.continuousOn.isOpen_inter_preimage hT isOpen_Iio
    have h2 : IsOpen {η : Cyl | 0 < η.1} := isOpen_lt continuous_const continuous_fst
    have e : DomC B.h B.qB = {η : Cyl | 0 < η.1} ∩
        ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Iio B.qB) := by
      ext η
      exact ⟨fun h => ⟨h.1, h.2.1, h.2.2⟩, fun h => ⟨h.1, h.2.1, h.2.2⟩⟩
    rw [e]; exact h2.inter h1
  have hne : ∀ η ∈ DomC B.h B.qB, qC B.h η ≠ 0 := fun η hη => (hqpos η hη.2.1).ne'
  have hφ1 : ContDiffOn ℝ ∞ (fun η : Cyl => Real.log (qC B.h η)) (DomC B.h B.qB) := hqC.log hne
  have hφ2 : ContDiffOn ℝ ∞ (XC B.h) (DomC B.h B.qB) := by
    have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => η.1 ^ 2) (DomC B.h B.qB) :=
      (contDiff_fst.pow 2).contDiffOn
    have h2 : ContDiffOn ℝ ∞ (fun η : Cyl => 2 * qC B.h η) (DomC B.h B.qB) :=
      contDiffOn_const.mul hqC
    exact (h1.div h2 (fun η hη => mul_ne_zero two_ne_zero (hne η hη))).congr (fun η _ => rfl)
  have hφ3 : ContDiffOn ℝ ∞ (etaC B.h) (DomC B.h B.qB) := by
    have h1 : ContDiffOn ℝ ∞ (fun η : Cyl => η.2.1) (DomC B.h B.qB) := contDiff_snd.fst.contDiffOn
    exact (h1.mul (hqC.rpow_const_of_ne (p := -(1/2 - B.h)) hne)).congr (fun η _ => rfl)
  have hWo : IsOpen (Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1)) :=
    isOpen_Iio.prod (isOpen_Ioi.prod isOpen_Ioo)
  have hmaps : ∀ η ∈ DomC B.h B.qB, (Real.log (qC B.h η), XC B.h η, etaC B.h η) ∈
      Iio (Real.log B.qB) ×ˢ (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := by
    intro η hη
    have hqη := hqpos η hη.2.1
    have hs : 0 < qC B.h η ^ (1/2 - B.h) := Real.rpow_pos_of_pos hqη _
    have hs2 : (qC B.h η ^ (1/2 - B.h)) ^ 2 = qC B.h η ^ (1 - 2 * B.h) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hqη.le]; congr 1; push_cast; ring
    have hz : η.2.1 ^ 2 < (qC B.h η ^ (1/2 - B.h)) ^ 2 := by
      rw [hs2]; exact (hS.2.1 η.2.1 (1 - η.2.2.1) (by linarith [hη.2.1])).2
    have habs := abs_lt.mp (abs_lt_of_sq_lt_sq hz hs.le)
    have he : etaC B.h η = η.2.1 / qC B.h η ^ (1/2 - B.h) := by
      unfold etaC; rw [Real.rpow_neg hqη.le]; exact (div_eq_mul_inv _ _).symm
    refine Set.mk_mem_prod (Set.mem_Iio.mpr (Real.log_lt_log hqη hη.2.2))
      (Set.mk_mem_prod (Set.mem_Ioi.mpr ?_) (Set.mem_Ioo.mpr ⟨?_, ?_⟩))
    · exact div_pos (pow_pos hη.1 2) (mul_pos two_pos hqη)
    · rw [he, lt_div_iff₀ hs]; linarith
    · rw [he, div_lt_iff₀ hs]; linarith
  have hqp : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η ^ (-(1/2 + B.h))) (DomC B.h B.qB) :=
    hqC.rpow_const_of_ne hne
  have hGEs : ContDiffOn ℝ ∞ (fun η : Cyl => logLift B.Eb (Real.log (qC B.h η), XC B.h η, etaC B.h η))
      (DomC B.h B.qB) := hGE.comp (hφ1.prodMk (hφ2.prodMk hφ3)) hmaps
  have hGUs : ContDiffOn ℝ ∞ (fun η : Cyl => logLift B.Ub (Real.log (qC B.h η), XC B.h η, etaC B.h η))
      (DomC B.h B.qB) := hGU.comp (hφ1.prodMk (hφ2.prodMk hφ3)) hmaps

  choose Cq hCq using nb_qpow_v4 B B.qB (-(1/2 + B.h)) hB SN hqB0 hqB1
  choose C3 hC3 using outer_profile_bounds_v5 B hB
  have h4 : ∀ i : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h B.qB, 1 ≤ i →
      NB B.h (fun η : Cyl => Real.log (qC B.h η)) i ξ ≤ C := by
    intro i
    rcases Nat.eq_zero_or_pos i with hi | hi
    · exact ⟨0, fun ξ _ h => absurd h (by omega)⟩
    · obtain ⟨C, hC⟩ := logqC_nb_v5 B hB i hi
      exact ⟨C, fun ξ hξ _ => hC ξ hξ⟩
  choose C4 hC4 using h4
  choose C5 hC5 using xc_etac_nb_v5 B hB
  choose C10 hC10 using inv_r_nb_v5 B hB
  have hsum : ∀ (f : ℕ → ℝ) (j : ℕ), j ≤ k → |f j| ≤ ∑ i ∈ Finset.range (k + 1), |f i| :=
    fun f j hj => Finset.single_le_sum (f := fun i => |f i|) (fun i _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  have hs0 : ∀ f : ℕ → ℝ, 0 ≤ ∑ i ∈ Finset.range (k + 1), |f i| :=
    fun f => Finset.sum_nonneg (fun i _ => abs_nonneg _)
  obtain ⟨Aq, hAq⟩ : ∃ A : ℝ, A = 4 * ∑ i ∈ Finset.range (k + 1), |Cq i| := ⟨_, rfl⟩
  obtain ⟨SG, hSG⟩ : ∃ A : ℝ, A = ∑ i ∈ Finset.range (k + 1), |C3 i| := ⟨_, rfl⟩
  obtain ⟨D, hD⟩ : ∃ A : ℝ, A = 1 + ∑ i ∈ Finset.range (k + 1), |C4 i| +
      ∑ i ∈ Finset.range (k + 1), |C5 i| := ⟨_, rfl⟩
  obtain ⟨Sr, hSr⟩ : ∃ A : ℝ, A = ∑ i ∈ Finset.range (k + 1), |C10 i| := ⟨_, rfl⟩
  have hAq0 : 0 ≤ Aq := by rw [hAq]; linarith [hs0 Cq]
  have hSG0 : 0 ≤ SG := by rw [hSG]; exact hs0 C3
  have hD1 : 1 ≤ D := by rw [hD]; linarith [hs0 C4, hs0 C5]
  have hSr0 : 0 ≤ Sr := by rw [hSr]; exact hs0 C10
  obtain ⟨E, hE⟩ : ∃ A : ℝ, A = (k.factorial : ℝ) * SG * (3 * D) ^ k := ⟨_, rfl⟩
  have hE0 : 0 ≤ E := by
    rw [hE]; exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hSG0) (pow_nonneg (by linarith) _)
  obtain ⟨MB, hMB⟩ : ∃ A : ℝ, A = 2 ^ k * Aq * E := ⟨_, rfl⟩
  have hMB0 : 0 ≤ MB := by
    rw [hMB]; exact mul_nonneg (mul_nonneg (pow_nonneg (by norm_num) _) hAq0) hE0
  refine ⟨MB + 2 ^ k * MB * Sr, ?_⟩
  intro l l0 hl1 _ ξ hξ hw1 hw2 hX1 hX2

  have hrep : ∀ η ∈ DomC B.h B.qB,
      pcB5 B l 1 (η.1, η.2.1, η.2.2.1) = Qb l ^ (1/2 + B.h) * qC B.h η ^ (-(1/2 + B.h)) *
        logLift B.Eb (Real.log (qC B.h η), XC B.h η, etaC B.h η) ∧
      pcB5 B l 2 (η.1, η.2.1, η.2.2.1) = Qb l ^ (1/2 + B.h) * qC B.h η ^ (-(1/2 + B.h)) *
        logLift B.Ub (Real.log (qC B.h η), XC B.h η, etaC B.h η) := by
    intro η hη
    have hqη : 0 < qC B.h η := hqpos η hη.2.1
    have hr0 : η.1 ≠ 0 := ne_of_gt hη.1
    have hx0 : (rotPt η.1 0 η.2.1) 0 = η.1 := by simp [rotPt]
    have hx1 : (rotPt η.1 0 η.2.1) 1 = 0 := by simp [rotPt]
    have hx2 : (rotPt η.1 0 η.2.1) 2 = η.2.1 := by simp [rotPt]
    have hsq : (rotPt η.1 0 η.2.1) 0 ^ 2 + (rotPt η.1 0 η.2.1) 1 ^ 2 = η.1 ^ 2 := by
      rw [hx0, hx1]; ring
    have hrad : rad (rotPt η.1 0 η.2.1) = η.1 := by
      unfold rad; rw [hsq]; exact Real.sqrt_sq hη.1.le
    have hS2 : simScale B.h ((rotPt η.1 0 η.2.1) 2) (1 - η.2.2.1) = qC B.h η := by
      rw [hx2]; rfl
    have hmem : ((rotPt η.1 0 η.2.1), η.2.2.1) ∈ simDomain B.h B.qB :=
      ⟨hη.2.1, by show simScale B.h ((rotPt η.1 0 η.2.1) 2) (1 - η.2.2.1) < B.qB; rw [hS2]; exact hη.2.2⟩
    have hpos : 0 < (rotPt η.1 0 η.2.1) 0 ^ 2 + (rotPt η.1 0 η.2.1) 1 ^ 2 := by
      rw [hsq]; exact pow_pos hη.1 2
    obtain ⟨h6a, h6b, -⟩ := hc6 (rotPt η.1 0 η.2.1) η.2.2.1 hmem hpos
    have hsX : simX B.h (rotPt η.1 0 η.2.1) η.2.2.1 = XC B.h η := by
      unfold simX XC; rw [hsq, hS2]
    have hsE : simEta B.h (rotPt η.1 0 η.2.1) η.2.2.1 = etaC B.h η := by
      unfold simEta etaC; rw [hS2, hx2]
    rw [hS2, hsX, hsE, hsq, Real.sqrt_sq hη.1.le] at h6a
    rw [hS2, hsX, hsE] at h6b
    have hl : ∀ f : ℝ → ℝ → ℝ → ℝ, logLift f (Real.log (qC B.h η), XC B.h η, etaC B.h η) =
        f (qC B.h η) (XC B.h η) (etaC B.h η) := by
      intro f; unfold logLift; rw [Real.exp_log hqη]
    rw [hl, hl]
    have e1 : pcB5 B l 1 (η.1, η.2.1, η.2.2.1) = Qb l ^ (1/2 + B.h) *
        inner ℝ (curl3 (fun w => B.AB w η.2.2.1) (rotPt η.1 0 η.2.1) + B.BvB (rotPt η.1 0 η.2.1) η.2.2.1)
          (eTh (rotPt η.1 0 η.2.1)) := rfl
    have e2 : pcB5 B l 2 (η.1, η.2.1, η.2.2.1) = Qb l ^ (1/2 + B.h) *
        inner ℝ (curl3 (fun w => B.AB w η.2.2.1) (rotPt η.1 0 η.2.1) + B.BvB (rotPt η.1 0 η.2.1) η.2.2.1)
          eZ := rfl
    rw [e1, e2]
    constructor
    · rw [eTh, real_inner_smul_right, h6a, hrad, mul_assoc η.1, ← mul_assoc η.1⁻¹,
        inv_mul_cancel₀ hr0, one_mul, mul_assoc]
    · have hz : ∀ v : ℝ³, inner ℝ v eZ = v 2 := by
        intro v; simp [eZ, EuclideanSpace.inner_single_right]
      rw [hz, h6b, mul_assoc]

  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hqsB : qsOf l0 ≤ B.qB := by
