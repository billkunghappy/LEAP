        _ = iteratedFDeriv ℝ k Γ (Pr (Pr η)) (fun i => Pr (u i)) := by
            rw [hc, ContinuousMultilinearMap.compContinuousLinearMap_apply]
        _ = iteratedFDeriv ℝ k Γ (Pr η) (fun i => Pr (u i)) := by rw [hPP]
    have hfin := hchain v
