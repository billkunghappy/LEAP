  have h2xf : ContDiffOn ℝ ∞ (fun y : ℝ => 2 * y * f0 y) (Ioi 0) :=
    (contDiffOn_const.mul contDiffOn_id).mul hf0sm
  have hfUsm : ∀ i, ContDiffOn ℝ ∞ (fU i) (Ioi 0) := by
    intro i
    rcases hF2 i with rfl | rfl
    · have e : fU 0 = fun _ => (1 : ℝ) := funext hfU0
      rw [e]; exact contDiffOn_const
    · have e : fU 1 = fun y => 2 * y * f0 y := funext hfU1
      rw [e]; exact h2xf
  have hWsm : ∀ i, ContDiffOn ℝ ∞ (W i) (Ioi 0) := by
    intro i
    rcases hF3 i with rfl | rfl | rfl
    · have e : W 0 = fun y => 2 * y := funext hW0
      rw [e]; exact contDiffOn_const.mul contDiffOn_id
    · have e : W 1 = fun y => 2 * y * f0 y := funext hW1
      rw [e]; exact h2xf
    · have e : W 2 = fun y => 2 * f0 y := funext hW2
      rw [e]; exact contDiffOn_const.mul hf0sm

  obtain ⟨ψU, hψU⟩ : ∃ ψ : ℝ → ℝ,
      ψ = fun x => Real.smoothTransition (x - pA) * Real.smoothTransition (pB - x) := ⟨_, rfl⟩
  obtain ⟨ψE, hψE⟩ : ∃ ψ : ℝ → ℝ,
      ψ = fun x => Real.smoothTransition (x - pB) * Real.smoothTransition (pC - x) := ⟨_, rfl⟩
  obtain ⟨hψUc, -, hψUz, hψUb, hψUp⟩ :=
    hbump pA pB (fun _ => (1 : ℝ)) hpA0 hAB contDiffOn_const
  obtain ⟨hψEc, -, hψEz, hψEb, hψEp⟩ :=
    hbump pB pC (fun _ => (1 : ℝ)) hpB0 hBC contDiffOn_const
  have hψUc' : Continuous ψU := by rw [hψU]; exact hψUc.continuous
  have hψEc' : Continuous ψE := by rw [hψE]; exact hψEc.continuous
  have hψUz' : ∀ x, (x ≤ pA ∨ pB ≤ x) → ψU x = 0 := fun x hx => by rw [hψU]; exact hψUz x hx
  have hψEz' : ∀ x, (x ≤ pB ∨ pC ≤ x) → ψE x = 0 := fun x hx => by rw [hψE]; exact hψEz x hx
  have hψUb' : ∀ x, 0 ≤ ψU x ∧ ψU x ≤ 1 := fun x => by rw [hψU]; exact hψUb x
  have hψEb' : ∀ x, 0 ≤ ψE x ∧ ψE x ≤ 1 := fun x => by rw [hψE]; exact hψEb x
  have hψUp' : ∀ x, pA < x → x < pB → 0 < ψU x := fun x h1 h2 => by rw [hψU]; exact hψUp x h1 h2
  have hψEp' : ∀ x, pB < x → x < pC → 0 < ψE x := fun x h1 h2 => by rw [hψE]; exact hψEp x h1 h2
  obtain ⟨β, hβ⟩ : ∃ β : Fin 2 → ℝ → ℝ, β = fun i x => fU i x * ψU x := ⟨_, rfl⟩
  obtain ⟨γ, hγ⟩ : ∃ γ : Fin 3 → ℝ → ℝ, γ = fun j x => W j x * ψE x := ⟨_, rfl⟩
  have hβx : ∀ i x, β i x = fU i x * ψU x := fun i x => by rw [hβ]
  have hγx : ∀ j x, γ j x = W j x * ψE x := fun j x => by rw [hγ]
  have hβsm : ∀ i, ContDiff ℝ ∞ (β i) := by
    intro i
    have h := (hbump pA pB (fU i) hpA0 hAB (hfUsm i)).2.1
    have e : β i = fun x => fU i x * (Real.smoothTransition (x - pA) * Real.smoothTransition (pB - x)) := by
      funext x; rw [hβx, hψU]
    rw [e]; exact h
  have hγsm : ∀ j, ContDiff ℝ ∞ (γ j) := by
    intro j
    have h := (hbump pB pC (W j) hpB0 hBC (hWsm j)).2.1
    have e : γ j = fun x => W j x * (Real.smoothTransition (x - pB) * Real.smoothTransition (pC - x)) := by
      funext x; rw [hγx, hψE]
    rw [e]; exact h
  have hdisj : ∀ i j x, β i x * γ j x = 0 := by
    intro i j x
    rcases le_total x pB with h | h
    · rw [hγx, hψEz' x (Or.inl h)]; ring
    · rw [hβx, hψUz' x (Or.inr h)]; ring

  have hindU : ∀ v : Fin 2 → ℝ, (∀ x ∈ Ioo pA pB, ∑ j, v j * fU j x = 0) → v = 0 := by
    intro v hv
    have hE : ∀ y : ℝ, pA < y → y < pB → v 0 * y ^ lam + Real.sqrt 2 * v 1 = 0 := by
      intro y hy1 hy2
      have hy : 0 < y := lt_trans hpA0 hy1
      have e := hv y ⟨hy1, hy2⟩
      rw [Fin.sum_univ_two, hfU0, hfU1, hkey y hy] at e
      have hq : 0 < y ^ lam := Real.rpow_pos_of_pos hy _
      have h1 := inv_mul_cancel₀ hq.ne'
      linear_combination y ^ lam * e - Real.sqrt 2 * v 1 * h1
    have hpBA : pB = pA + 2 * ℓ := by rw [hpA, hpB]; ring
    have E1 := hE (pA + ℓ / 2) (by linarith) (by linarith)
    have E2 := hE (pA + ℓ) (by linarith) (by linarith)
    have hlt : (pA + ℓ / 2) ^ lam < (pA + ℓ) ^ lam :=
      Real.rpow_lt_rpow (by linarith) (by linarith) hlam
    have hv0 : v 0 = 0 := by
      have h : v 0 * ((pA + ℓ) ^ lam - (pA + ℓ / 2) ^ lam) = 0 := by linear_combination E2 - E1
      rcases mul_eq_zero.1 h with h | h
      · exact h
      · linarith
    have hv1 : v 1 = 0 := by
      have h : Real.sqrt 2 * v 1 = 0 := by linear_combination E1 - (pA + ℓ / 2) ^ lam * hv0
      rcases mul_eq_zero.1 h with h | h
      · linarith
      · exact h
    funext i
    rcases hF2 i with rfl | rfl
    · exact hv0
    · exact hv1
  have hindE : ∀ v : Fin 3 → ℝ, (∀ x ∈ Ioo pB pC, ∑ j, v j * W j x = 0) → v = 0 := by
    intro v hv
    have hE : ∀ y : ℝ, pB < y → y < pC →
        2 * v 0 * (y ^ 2 * y ^ lam) + Real.sqrt 2 * v 1 * y + Real.sqrt 2 * v 2 = 0 := by
      intro y hy1 hy2
      have hy : 0 < y := lt_trans hpB0 hy1
      have e := hv y ⟨hy1, hy2⟩
      rw [Fin.sum_univ_three, hW0, hW1, hW2, hkey y hy, hkey2 y hy] at e
      have hq : 0 < y ^ lam := Real.rpow_pos_of_pos hy _
      have h1 := inv_mul_cancel₀ hq.ne'
      have h2 := inv_mul_cancel₀ hy.ne'
      linear_combination (y * y ^ lam) * e - Real.sqrt 2 * v 1 * y * h1 -
        Real.sqrt 2 * v 2 * (h1 + (y ^ lam)⁻¹ * y ^ lam * h2)
    have hpCB : pC = pB + 2 * ℓ := by rw [hpB, hpC]; ring
    obtain ⟨y1, hy1⟩ : ∃ y : ℝ, y = pB + ℓ / 2 := ⟨_, rfl⟩
    obtain ⟨y2, hy2⟩ : ∃ y : ℝ, y = pB + ℓ := ⟨_, rfl⟩
    obtain ⟨y3, hy3⟩ : ∃ y : ℝ, y = pB + 3 * ℓ / 2 := ⟨_, rfl⟩
    have E1 := hE y1 (by rw [hy1]; linarith) (by rw [hy1]; linarith)
    have E2 := hE y2 (by rw [hy2]; linarith) (by rw [hy2]; linarith)
    have E3 := hE y3 (by rw [hy3]; linarith) (by rw [hy3]; linarith)
    have hy10 : 0 < y1 := by rw [hy1]; linarith
    have hy20 : 0 < y2 := by rw [hy2]; linarith
    have hy30 : 0 < y3 := by rw [hy3]; linarith
    have hpw : ∀ y : ℝ, 0 < y → y ^ (2 + lam) = y ^ 2 * y ^ lam := by
      intro y hy; rw [Real.rpow_add hy, Real.rpow_two]
    have hsc := strictConvexOn_rpow (show (1:ℝ) < 2 + lam by linarith)
    have hconv := hsc.2 (show y1 ∈ Ici (0:ℝ) from le_of_lt hy10)
      (show y3 ∈ Ici (0:ℝ) from le_of_lt hy30) (by rw [hy1, hy3]; intro h; linarith)
      (show (0:ℝ) < 1 / 2 by norm_num) (show (0:ℝ) < 1 / 2 by norm_num) (by norm_num)
    simp only [smul_eq_mul] at hconv
    rw [show (1:ℝ) / 2 * y1 + 1 / 2 * y3 = y2 by rw [hy1, hy2, hy3]; ring,
      hpw y1 hy10, hpw y2 hy20, hpw y3 hy30] at hconv
    have hv0 : v 0 = 0 := by
      have hm : y1 + y3 = 2 * y2 := by rw [hy1, hy2, hy3]; ring
      have hlin : 2 * v 0 * ((y1 ^ 2 * y1 ^ lam) + (y3 ^ 2 * y3 ^ lam) - 2 * (y2 ^ 2 * y2 ^ lam))
          = 0 := by
        linear_combination E1 + E3 - 2 * E2 - Real.sqrt 2 * v 1 * hm
      rcases mul_eq_zero.1 hlin with h | h
      · linarith
      · linarith
    have hv1 : v 1 = 0 := by
      have h : Real.sqrt 2 * v 1 * (y1 - y2) = 0 := by
        linear_combination E1 - E2 - (2 * (y1 ^ 2 * y1 ^ lam) - 2 * (y2 ^ 2 * y2 ^ lam)) * hv0
      rcases mul_eq_zero.1 h with h | h
      · rcases mul_eq_zero.1 h with h | h
        · linarith
        · exact h
      · rw [hy1, hy2] at h; linarith
    have hv2 : v 2 = 0 := by
      have h : Real.sqrt 2 * v 2 = 0 := by
        linear_combination E1 - 2 * (y1 ^ 2 * y1 ^ lam) * hv0 - Real.sqrt 2 * y1 * hv1
      rcases mul_eq_zero.1 h with h | h
      · linarith
      · exact h
    funext i
    rcases hF3 i with rfl | rfl | rfl
    · exact hv0
    · exact hv1
    · exact hv2

  have hsubI : Icc r1 r2 ⊆ Ioi 0 := fun x hx => lt_of_lt_of_le hr1 hx.1
  have hU : uIcc r1 r2 ⊆ Ioi 0 := by rw [uIcc_of_le hr12.le]; exact hsubI
  obtain ⟨G, hG⟩ : ∃ G : Fin 2 → Fin 2 → ℝ,
      G = fun i j => ∫ x in r1..r2, fU i x * (fU j x * ψU x) := ⟨_, rfl⟩
  obtain ⟨GE, hGE⟩ : ∃ G : Fin 3 → Fin 3 → ℝ,
      G = fun i j => ∫ x in r1..r2, W i x * (W j x * ψE x) := ⟨_, rfl⟩
  obtain ⟨P, hPd⟩ : ∃ P : Fin 2 → Fin 2 → ℝ, P = fun i i' => ∫ x in r1..r2, β i x * β i' x :=
    ⟨_, rfl⟩
  obtain ⟨T, hTd⟩ : ∃ Q : Fin 3 → Fin 3 → ℝ, Q = fun j l => ∫ x in r1..r2, x * (γ j x * γ l x) :=
    ⟨_, rfl⟩
  obtain ⟨V, hVd⟩ : ∃ Q : Fin 3 → Fin 3 → ℝ, Q = fun j l => ∫ x in r1..r2, γ j x * γ l x :=
    ⟨_, rfl⟩
  have hGij : ∀ i j, (∫ x in r1..r2, fU i x * (fU j x * ψU x)) = G i j := fun i j => by rw [hG]
  have hGEij : ∀ i j, (∫ x in r1..r2, W i x * (W j x * ψE x)) = GE i j := fun i j => by rw [hGE]
  have hPij : ∀ i i', (∫ x in r1..r2, β i x * β i' x) = P i i' := fun i i' => by rw [hPd]
  have hTij : ∀ j l, (∫ x in r1..r2, x * (γ j x * γ l x)) = T j l := fun j l => by rw [hTd]
  have hVij : ∀ j l, (∫ x in r1..r2, γ j x * γ l x) = V j l := fun j l => by rw [hVd]
  have hI0 : ∀ j, (∫ x in r1..r2, β j x) = G 0 j := by
    intro j; rw [hG]; simp only [hβx, hfU0, one_mul]
  have hI1 : ∀ j, (∫ x in r1..r2, 2 * x * f0 x * β j x) = G 1 j := by
    intro j; rw [hG]; simp only [hβx, hfU1]
  have hJ0 : ∀ j, (∫ x in r1..r2, 2 * x * γ j x) = GE 0 j := by
    intro j; rw [hGE]; simp only [hγx, hW0]
  have hJ1 : ∀ j, (∫ x in r1..r2, 2 * x * f0 x * γ j x) = GE 1 j := by
    intro j; rw [hGE]; simp only [hγx, hW1]
  have hJ2 : ∀ j, (∫ x in r1..r2, 2 * f0 x * γ j x) = GE 2 j := by
    intro j; rw [hGE]; simp only [hγx, hW2]

  have cf0 : ContinuousOn f0 (uIcc r1 r2) := hf0sm.continuousOn.mono hU
  have hβc : ∀ i, Continuous (β i) := fun i => (hβsm i).continuous
  have hγc : ∀ j, Continuous (γ j) := fun j => (hγsm j).continuous
  have hIo : ∀ f : ℝ → ℝ, ContinuousOn f (uIcc r1 r2) →
      IntervalIntegrable f MeasureTheory.volume r1 r2 := fun f hf => hf.intervalIntegrable
  have H1 : ∀ (n : ℕ) (u : Fin n → ℝ) (f : Fin n → ℝ → ℝ),
      (∀ i, ContinuousOn (f i) (uIcc r1 r2)) →
      ∫ x in r1..r2, ∑ i, u i * f i x = ∑ i, u i * ∫ x in r1..r2, f i x := by
    intro n u f hf
    rw [intervalIntegral.integral_finsetSum (fun i _ => (hIo _ (hf i)).const_mul (u i))]
    simp only [intervalIntegral.integral_const_mul]
  have H2 : ∀ (n : ℕ) (u : Fin n → ℝ) (f : Fin n → Fin n → ℝ → ℝ),
      (∀ i j, ContinuousOn (f i j) (uIcc r1 r2)) →
      ∫ x in r1..r2, ∑ i, ∑ j, u i * u j * f i j x =
        ∑ i, ∑ j, u i * u j * ∫ x in r1..r2, f i j x := by
    intro n u f hf
    have hi : ∀ i ∈ (Finset.univ : Finset (Fin n)), IntervalIntegrable
        (fun x => ∑ j, u i * u j * f i j x) MeasureTheory.volume r1 r2 := by
      intro i _
      exact hIo _ (continuousOn_finset_sum _ (fun j _ => continuousOn_const.mul (hf i j)))
    rw [intervalIntegral.integral_finsetSum hi]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [intervalIntegral.integral_finsetSum
      (fun j _ => (hIo _ (hf i j)).const_mul (u i * u j))]
    simp only [intervalIntegral.integral_const_mul]
  have cA : ∀ i, ContinuousOn (fun x => 2 * x * f0 x * β i x) (uIcc r1 r2) := fun i =>
    ((continuousOn_const.mul continuousOn_id).mul cf0).mul (hβc i).continuousOn
  have cC : ∀ j, ContinuousOn (fun x => 2 * x * f0 x * γ j x) (uIcc r1 r2) := fun j =>
    ((continuousOn_const.mul continuousOn_id).mul cf0).mul (hγc j).continuousOn
  have cD : ∀ j, ContinuousOn (fun x => 2 * f0 x * γ j x) (uIcc r1 r2) := fun j =>
    (continuousOn_const.mul cf0).mul (hγc j).continuousOn
  have cE0 : ∀ j, ContinuousOn (fun x => 2 * x * γ j x) (uIcc r1 r2) := fun j =>
    ((continuous_const.mul continuous_id).mul (hγc j)).continuousOn

  have hexp : ∀ (c : Fin 5 → ℝ) (η : ℝ),
      (∫ x in r1..r2, repU β c x) = ∑ i, (![c 0, c 1] : Fin 2 → ℝ) i * G 0 i ∧
      (∫ x in r1..r2, 2 * x * (repF lam cpatch γ c η x - patchF0 lam cpatch η x)) =
        ∑ j, (![c 2, c 3, c 4] : Fin 3 → ℝ) j * GE 0 j ∧
      (∫ x in r1..r2, repU β c x * (2 * x * repF lam cpatch γ c η x)) =
        cpatch * (1 + η ^ 2)⁻¹ * ∑ i, (![c 0, c 1] : Fin 2 → ℝ) i * G 1 i ∧
      (∫ x in r1..r2, (repU β c x ^ 2 - x * repF lam cpatch γ c η x ^ 2
          + x * patchF0 lam cpatch η x ^ 2)) =
        ∑ i, ∑ i', (![c 0, c 1] : Fin 2 → ℝ) i * (![c 0, c 1] : Fin 2 → ℝ) i' * P i i'
        - cpatch * (1 + η ^ 2)⁻¹ * ∑ j, (![c 2, c 3, c 4] : Fin 3 → ℝ) j * GE 1 j
        - ∑ j, ∑ l, (![c 2, c 3, c 4] : Fin 3 → ℝ) j * (![c 2, c 3, c 4] : Fin 3 → ℝ) l * T j l ∧
      (∫ x in r1..r2, (repF lam cpatch γ c η x ^ 2 - patchF0 lam cpatch η x ^ 2)) =
        cpatch * (1 + η ^ 2)⁻¹ * ∑ j, (![c 2, c 3, c 4] : Fin 3 → ℝ) j * GE 2 j
        + ∑ j, ∑ l, (![c 2, c 3, c 4] : Fin 3 → ℝ) j * (![c 2, c 3, c 4] : Fin 3 → ℝ) l * V j l := by
    intro c η
    obtain ⟨cU, hcU⟩ : ∃ v : Fin 2 → ℝ, v = ![c 0, c 1] := ⟨_, rfl⟩
    obtain ⟨cE, hcE⟩ : ∃ v : Fin 3 → ℝ, v = ![c 2, c 3, c 4] := ⟨_, rfl⟩
    rw [← hcU, ← hcE]
    obtain ⟨k, hk⟩ : ∃ t : ℝ, t = cpatch * (1 + η ^ 2)⁻¹ := ⟨_, rfl⟩
    rw [← hk]
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simp only [← hI0]
      rw [← H1 2 cU β (fun i => (hβc i).continuousOn)]
      refine intervalIntegral.integral_congr (fun x _ => ?_)
      simp only [hcU, repU, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.head_cons]
    · simp only [← hJ0]
      have h : ∫ x in r1..r2, ∑ j, cE j * (2 * x * γ j x) =
          ∑ j, cE j * ∫ x in r1..r2, 2 * x * γ j x := H1 3 cE (fun j x => 2 * x * γ j x) cE0
      rw [← h]
      refine intervalIntegral.integral_congr (fun x _ => ?_)
      simp only [hcE, repF, Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
      ring
    · simp only [← hI1]
      have h : ∫ x in r1..r2, ∑ i, cU i * (2 * x * f0 x * β i x) =
          ∑ i, cU i * ∫ x in r1..r2, 2 * x * f0 x * β i x :=
        H1 2 cU (fun i x => 2 * x * f0 x * β i x) cA
      rw [← h, ← intervalIntegral.integral_const_mul]
      refine intervalIntegral.integral_congr (fun x _ => ?_)
      simp only [hcU, repU, repF, hpf, ← hk, Fin.sum_univ_two, Matrix.cons_val_zero,
        Matrix.cons_val_one, Matrix.head_cons]
      linear_combination 2 * x * (c 0 * c 2 * hdisj 0 0 x + c 0 * c 3 * hdisj 0 1 x +
        c 0 * c 4 * hdisj 0 2 x + c 1 * c 2 * hdisj 1 0 x + c 1 * c 3 * hdisj 1 1 x +
        c 1 * c 4 * hdisj 1 2 x)
    · simp only [← hPij, ← hJ1, ← hTij]
      have hB : ∫ x in r1..r2, ∑ i, ∑ i', cU i * cU i' * (β i x * β i' x) =
          ∑ i, ∑ i', cU i * cU i' * ∫ x in r1..r2, β i x * β i' x :=
        H2 2 cU (fun i i' x => β i x * β i' x) (fun i i' => ((hβc i).mul (hβc i')).continuousOn)
      have hC : ∫ x in r1..r2, ∑ j, cE j * (2 * x * f0 x * γ j x) =
          ∑ j, cE j * ∫ x in r1..r2, 2 * x * f0 x * γ j x :=
        H1 3 cE (fun j x => 2 * x * f0 x * γ j x) cC
      have hD : ∫ x in r1..r2, ∑ j, ∑ l, cE j * cE l * (x * (γ j x * γ l x)) =
          ∑ j, ∑ l, cE j * cE l * ∫ x in r1..r2, x * (γ j x * γ l x) :=
        H2 3 cE (fun j l x => x * (γ j x * γ l x))
          (fun j l => (continuous_id.mul ((hγc j).mul (hγc l))).continuousOn)
      have iB : IntervalIntegrable (fun x => ∑ i, ∑ i', cU i * cU i' * (β i x * β i' x))
          MeasureTheory.volume r1 r2 :=
        hIo _ (continuousOn_finset_sum _ (fun i _ => continuousOn_finset_sum _
          (fun i' _ => continuousOn_const.mul ((hβc i).mul (hβc i')).continuousOn)))
      have iC : IntervalIntegrable (fun x => k * ∑ j, cE j * (2 * x * f0 x * γ j x))
          MeasureTheory.volume r1 r2 :=
        hIo _ (continuousOn_const.mul (continuousOn_finset_sum _
          (fun j _ => continuousOn_const.mul (cC j))))
      have iD : IntervalIntegrable (fun x => ∑ j, ∑ l, cE j * cE l * (x * (γ j x * γ l x)))
          MeasureTheory.volume r1 r2 :=
        hIo _ (continuousOn_finset_sum _ (fun j _ => continuousOn_finset_sum _
          (fun l _ => continuousOn_const.mul
            (continuous_id.mul ((hγc j).mul (hγc l))).continuousOn)))
      rw [← hB, ← hC, ← hD, ← intervalIntegral.integral_const_mul,
        ← intervalIntegral.integral_sub iB iC, ← intervalIntegral.integral_sub (iB.sub iC) iD]
      refine intervalIntegral.integral_congr (fun x _ => ?_)
      simp only [hcU, hcE, repU, repF, hpf, ← hk, Fin.sum_univ_two, Fin.sum_univ_three,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
        Matrix.tail_cons]
      ring
    · simp only [← hJ2, ← hVij]
      have hP' : ∫ x in r1..r2, ∑ j, cE j * (2 * f0 x * γ j x) =
          ∑ j, cE j * ∫ x in r1..r2, 2 * f0 x * γ j x :=
        H1 3 cE (fun j x => 2 * f0 x * γ j x) cD
      have hQ : ∫ x in r1..r2, ∑ j, ∑ l, cE j * cE l * (γ j x * γ l x) =
          ∑ j, ∑ l, cE j * cE l * ∫ x in r1..r2, γ j x * γ l x :=
        H2 3 cE (fun j l x => γ j x * γ l x) (fun j l => ((hγc j).mul (hγc l)).continuousOn)
      have iP : IntervalIntegrable (fun x => k * ∑ j, cE j * (2 * f0 x * γ j x))
          MeasureTheory.volume r1 r2 :=
        hIo _ (continuousOn_const.mul (continuousOn_finset_sum _
          (fun j _ => continuousOn_const.mul (cD j))))
      have iQ : IntervalIntegrable (fun x => ∑ j, ∑ l, cE j * cE l * (γ j x * γ l x))
          MeasureTheory.volume r1 r2 :=
        hIo _ (continuousOn_finset_sum _ (fun j _ => continuousOn_finset_sum _
