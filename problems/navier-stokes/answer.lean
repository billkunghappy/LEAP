          thAvgVec (sw5L B G l0 (potW5 B G (LSc5 B G l0 S)) (pwScale B (presW5 B G (LSc5 B G l0 S)))) x t Y =
        (qC B.h (ptOf x t Y) ^ (-(2 * Aex B.h + 1/2))) • cyl2cart x (waveV5 B G g (thetaOf x) (ptOf x t Y))
          + Fl x t Y :=
by
