    funext y
    rw [hfin, smul_eq_mul, hf]
  have hInt : Integrable (fun z : ℝ³ => f ‖z‖) := by
    have h := (integrable_fun_norm_addHaar (volume : Measure ℝ³) (f := f)).2
    rw [hshape] at h
    exact h hI
  have hvol : (volume : Measure ℝ³).real (Metric.ball 0 1) = Real.pi * 4 / 3 := by
    rw [Measure.real_def, EuclideanSpace.volume_ball_fin_three, ENNReal.ofReal_one, one_pow,
      one_mul, ENNReal.toReal_ofReal (by positivity)]
  have hval : ∫ z : ℝ³, f ‖z‖ = 16 * Real.pi * a := by
    have h := integral_fun_norm_addHaar (volume : Measure ℝ³) f
    rw [hshape, hJ, hvol, hfin, smul_eq_mul, nsmul_eq_mul] at h
    rw [h]
    push_cast
    ring
  have hnn : 0 ≤ᵐ[(volume : Measure ℝ³)] (fun z : ℝ³ => f ‖z‖) :=
    Filter.Eventually.of_forall fun z => by
      show (0:ℝ) ≤ f ‖z‖
      rw [hf]
      exact Real.rpow_nonneg
        (mul_nonneg (pow_nonneg (inv_nonneg.2 (norm_nonneg z)) 3)
          (le_min zero_le_one (mul_nonneg ha.le (norm_nonneg z)))) _
  have key := ofReal_integral_eq_lintegral_ofReal hInt hnn
  rw [hval] at key
  rw [key]
  exact lintegral_congr fun z => by rw [hf]

theorem flux_comm_g_moments : ∀ (M Ru : ℝ) (w u : ℝ³ → ℝ³) (φ : ℝ³ → ℝ) (i j : Fin 3), Continuous w → Continuous u → Continuous φ → HasCompactSupport φ → (∀ x, 0 ≤ φ x ∧ φ x ≤ 1) → MemLp w 2 → (∀ x, ‖u x‖ ≤ M) → (∀ x, Ru ≤ ‖x‖ → u x = 0) → (∫⁻ x, ENNReal.ofReal |w x i * w x j + w x i * u x j + u x i * w x j| ≤ ENNReal.ofReal ((∫ x, ‖w x‖ ^ 2) + 2 * M * ((volume (Metric.ball (0:ℝ³) Ru)).toReal + ∫ x, ‖w x‖ ^ 2))) ∧ (∫⁻ x, ENNReal.ofReal ((φ x ^ 3 * |w x i * w x j + w x i * u x j + u x i * w x j|) ^ ((4:ℝ)/3)) ≤ ENNReal.ofReal (2 ^ ((1:ℝ)/3) * ((∫ x, ‖w x‖ ^ 2) ^ ((5:ℝ)/6) * (∫ x, φ x ^ 24 * ‖w x‖ ^ 6) ^ ((1:ℝ)/6) + (2 * M) ^ ((4:ℝ)/3) * ((volume (Metric.ball (0:ℝ³) Ru)).toReal + ∫ x, ‖w x‖ ^ 2)))) :=
by
  intro M Ru w u φ i j hw hu hφ hφcs hφ01 hwL2 hM hu0
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  have h2M : 0 ≤ 2 * M := by linarith
  have habs : ∀ (v : ℝ³ → ℝ³) (k : Fin 3) (x : ℝ³), |v x k| ≤ ‖v x‖ := fun v k x => by
    have := PiLp.norm_apply_le (v x) k
    simpa [Real.norm_eq_abs] using this
  have hWint : Integrable (fun x => ‖w x‖ ^ 2) := hwL2.integrable_norm_pow two_ne_zero
  have hScs : HasCompactSupport (fun x => φ x ^ 24 * ‖w x‖ ^ 6) :=
    HasCompactSupport.mul_right (f' := fun x => ‖w x‖ ^ 6)
      (hφcs.comp_left (g := fun t : ℝ => t ^ 24) (by norm_num))
  have hSint : Integrable (fun x => φ x ^ 24 * ‖w x‖ ^ 6) :=
    (by fun_prop : Continuous (fun x => φ x ^ 24 * ‖w x‖ ^ 6)).integrable_of_hasCompactSupport hScs
  have hS0' : ∀ x, 0 ≤ φ x ^ 24 * ‖w x‖ ^ 6 := fun x =>
    mul_nonneg (pow_nonneg (hφ01 x).1 24) (by positivity)
  set V := (volume (Metric.ball (0:ℝ³) Ru)).toReal with hVdef
  set W := ∫ x, ‖w x‖ ^ 2 with hWdef
  set S := ∫ x, φ x ^ 24 * ‖w x‖ ^ 6 with hSdef
  have hV0 : 0 ≤ V := ENNReal.toReal_nonneg
  have hW0 : 0 ≤ W := integral_nonneg fun x => by positivity
  have hS0 : 0 ≤ S := integral_nonneg hS0'
  have hWlin : ∫⁻ x, ENNReal.ofReal (‖w x‖ ^ 2) = ENNReal.ofReal W :=
    (ofReal_integral_eq_lintegral_ofReal hWint (ae_of_all _ fun x => by positivity)).symm
  have hSlin : ∫⁻ x, ENNReal.ofReal (φ x ^ 24 * ‖w x‖ ^ 6) = ENNReal.ofReal S :=
    (ofReal_integral_eq_lintegral_ofReal hSint (ae_of_all _ hS0')).symm

  obtain ⟨v, hvdef⟩ : ∃ v : ℝ³ → ℝ,
      v = (Metric.ball (0:ℝ³) Ru).indicator (fun y => 2 * M * ‖w y‖) := ⟨_, rfl⟩
  have hv0 : ∀ x, 0 ≤ v x := fun x => by
    rw [hvdef]
    exact Set.indicator_nonneg (fun y _ => mul_nonneg h2M (norm_nonneg _)) x

  have hg : ∀ x, |w x i * w x j + w x i * u x j + u x i * w x j| ≤ ‖w x‖ ^ 2 + v x := by
    intro x
