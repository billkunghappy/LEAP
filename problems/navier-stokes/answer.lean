  have hinv : 1 / (1 - h) ≤ 2 := by
    rw [div_le_iff₀ ha0]; linarith
  have hinv0 : 0 < 1 / (1 - h) := by positivity

  have hea : Real.exp (1 - h) ≤ 3 := by
    have := Real.exp_le_exp.2 ha1; linarith
  have hea0 : 0 < Real.exp (1 - h) := Real.exp_pos _
  have hI1 : Real.exp (1 - h) / (1 - h) ≤ 6 := by
    rw [div_le_iff₀ ha0]; linarith
  have hI1' : 0 ≤ Real.exp (1 - h) / (1 - h) := by positivity
  have he3a : Real.exp (3 * (1 - h)) ≤ 21 := by
    have := Real.exp_le_exp.2 (show 3 * (1 - h) ≤ 3 by linarith); linarith
