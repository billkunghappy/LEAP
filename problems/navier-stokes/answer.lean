    · linarith [abs_nonneg CA, abs_nonneg CP]
    · linarith [abs_nonneg CA, abs_nonneg CB]
  ·
    intro x t hxt hr
    obtain ⟨e1, e2, e3⟩ := hO4 x t hxt.1 hr
    have hq := hQpos x t hxt
    have hXp : Xp ≤ simX h x t := by
      unfold simX
      rw [le_div_iff₀ (by positivity)]
      have := mul_lt_mul_of_pos_right hpb (by positivity : (0:ℝ) < 2 * simScale h (x 2) (1 - t))
      linarith
    have zA : ∀ j : ℕ, simCut h (a (j + 1)) x t • bgAn h (j + 1) (S (j + 1)) x t = 0 := fun j => by
      unfold bgAn
      rw [(hvanXp (j + 1) (by omega) _ _ hXp).1, mul_zero, zero_smul, smul_zero]
    have zB : ∀ j : ℕ, simCut h (a (j + 1)) x t • bgBn h (j + 1) (G (j + 1)) x t = 0 := fun j => by
      unfold bgBn
      rw [(hvanXp (j + 1) (by omega) _ _ hXp).2.1, mul_zero, zero_smul, smul_zero]
    have zP : ∀ j : ℕ, simCut h (a (j + 1)) x t • bgPn h (j + 1) (W (j + 1)) x t = 0 := fun j => by
      unfold bgPn
      rw [(hvanXp (j + 1) (by omega) _ _ hXp).2.2.2.2, mul_zero, smul_zero]
    refine ⟨?_, ?_, ?_⟩
    · simp only [cutSum, zA, tsum_zero, add_zero]
      rw [hS0]; exact e1
    · simp only [cutSum, zB, tsum_zero, add_zero]
      rw [hG0]; exact e2
    · simp only [cutSum, zP, tsum_zero, add_zero]
      rw [hW0]; exact e3

theorem background_of_leading_profile : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ), SimScaleProps h → LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → ∃ (qB : ℝ) (AB BvB : ℝ³ → ℝ → ℝ³) (PB : ℝ³ → ℝ → ℝ) (Eb Ub Vb Tth Tz : ℝ → ℝ → ℝ → ℝ), BackgroundProps h Xa Xb Xb m1 m2 lam cpatch qB (2 ^ (1 / 2 + h) * cinf) aa ab F U T0th T0z AB BvB PB Eb Ub Vb Tth Tz :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hS hL
  obtain ⟨S, G, Uc, Vc, W, Tth, Tz, hP⟩ :=
    bg_positive_expansion h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hS hL
  have hO := bg_order_zero h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hS hL
  exact bg_summation h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z
    S G Uc Vc W Tth Tz hS hL hO hP

theorem ns_background_exists : ∃ (h Xa Xb Xext m1 m2 lam cpatch qB c aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) (AB BvB : ℝ³ → ℝ → ℝ³) (PB : ℝ³ → ℝ → ℝ) (Eb Ub Vb Tth Tz : ℝ → ℝ → ℝ → ℝ), BackgroundProps h Xa Xb Xext m1 m2 lam cpatch qB c aa ab F U T0th T0z AB BvB PB Eb Ub Vb Tth Tz :=
by
  obtain ⟨h, lam, cinf, cpatch, Xa, Xb, Xv, Xc, p1, p2, m1, m2, aa, ab, F, U, T0th, T0z, hL⟩ :=
    leading_profile_exists
  have hL' := hL
  unfold LeadingProfile at hL'
  obtain ⟨⟨h0, h1, -⟩, -⟩ := hL'
  have hS : SimScaleProps h := simScale_props h h0 (by linarith)
  obtain ⟨qB, AB, BvB, PB, Eb, Ub, Vb, Tth, Tz, hB⟩ :=
    background_of_leading_profile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hS hL
  exact ⟨h, Xa, Xb, Xb, m1, m2, lam, cpatch, qB, 2 ^ (1 / 2 + h) * cinf, aa, ab, F, U, T0th, T0z,
    AB, BvB, PB, Eb, Ub, Vb, Tth, Tz, hB⟩

theorem incr_trans_v5 : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S S' S'' : CState) (o o' o'' : ℝ), B.ok →
    Incr5 B G l0 S S' o → Incr5 B G l0 S' S'' o' → o'' ≤ o → o'' ≤ o' → Incr5 B G l0 S S'' o'' :=
by
  intro B G l0 S S' S'' o o' o'' hok hI1 hI2 ho ho'
  have hh0 : 0 ≤ B.h := hok.2.1.1.le
  have hXa : 0 < B.Xa := hok.2.1.2.2.1

  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg _))
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have hU : IsOpen ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) :=
      (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
    have h4 : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3 := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ξ
      constructor
      · rintro ⟨h1, h2, h3⟩
        exact ⟨⟨h1, h2⟩, h3⟩
      · rintro ⟨⟨h1, h2⟩, h3⟩
        exact ⟨h1, h2, h3⟩
    rw [e]
    exact h3
  have hDq : ∀ ξ ∈ DomC B.h (qsOf l0), 0 < qC B.h ξ ∧ qC B.h ξ ≤ 1 ∧ 1 ≤ SC B.h ξ := by
    intro ξ hξ
    obtain ⟨-, h2, h3⟩ := hξ
    have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith)).1
    refine ⟨hq0, by linarith, ?_⟩
    unfold SC
    have : (1:ℝ) ≤ 1 + |Real.log (qC B.h ξ)| := by linarith [abs_nonneg (Real.log (qC B.h ξ))]
    exact one_le_pow₀ this
  have hDsh : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ a, shY ξ a ∈ DomC B.h (qsOf l0) := fun ξ hξ _ => hξ

  have hEdge : ∀ X : ℝ, B.Xa < X → X < B.Xb → 0 ≤ edgeWeight B.Xa B.Xb B.aa B.ab X ∧
      0 < edgeDist B.Xa B.Xb X ∧ edgeDist B.Xa B.Xb X ≤ 1 := by
    intro X h1 h2
    refine ⟨?_, ?_, min_le_left _ _⟩
    · unfold edgeWeight
      split_ifs
      · exact (Real.exp_pos _).le
      · exact le_rfl
    · have hX : 0 < X := lt_trans hXa h1
      have l1 : 0 < Real.log (X / B.Xa) := Real.log_pos ((one_lt_div hXa).mpr h1)
      have l2 : 0 < Real.log (B.Xb / X) := Real.log_pos ((one_lt_div hX).mpr h2)
      exact lt_min one_pos (lt_min l1 l2)

  have hW : ∀ (q Sv E e P C1 C2 b1 b2 d1 d2 α α1 α2 N1 N2 : ℝ), 0 < q → q ≤ 1 → 1 ≤ Sv → 0 ≤ E →
      0 < e → e ≤ 1 → 0 ≤ P → α ≤ α1 → α ≤ α2 →
      N1 ≤ C1 * q ^ (B.h * α1) * Sv ^ b1 * E * e ^ (-d1) * P →
      N2 ≤ C2 * q ^ (B.h * α2) * Sv ^ b2 * E * e ^ (-d2) * P →
      N1 + N2 ≤ (|C1| + |C2|) * q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P := by
    intro q Sv E e P C1 C2 b1 b2 d1 d2 α α1 α2 N1 N2 hq0 hq1 hS1 hE he0 he1 hP ha1 ha2 hN1 hN2
    have key : ∀ (C b d αi N : ℝ), α ≤ αi → N ≤ C * q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P →
        b ≤ max b1 b2 → d ≤ max d1 d2 →
        N ≤ |C| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by
      intro C b d αi N hα hN hb hd
      have f1 : q ^ (B.h * αi) ≤ q ^ (B.h * α) :=
        Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (mul_le_mul_of_nonneg_left hα hh0)
      have f2 : Sv ^ b ≤ Sv ^ (max b1 b2) := Real.rpow_le_rpow_of_exponent_le hS1 hb
      have f3 : e ^ (-d) ≤ e ^ (-(max d1 d2)) :=
        Real.rpow_le_rpow_of_exponent_ge he0 he1 (neg_le_neg hd)
      have p1 : 0 ≤ q ^ (B.h * αi) := Real.rpow_nonneg hq0.le _
      have p2 : 0 ≤ Sv ^ b := Real.rpow_nonneg (by linarith) _
      have p3 : 0 ≤ e ^ (-d) := Real.rpow_nonneg he0.le _
      have p1' : 0 ≤ q ^ (B.h * α) := Real.rpow_nonneg hq0.le _
      have p2' : 0 ≤ Sv ^ (max b1 b2) := Real.rpow_nonneg (by linarith) _
      have m1 : q ^ (B.h * αi) * Sv ^ b ≤ q ^ (B.h * α) * Sv ^ (max b1 b2) := mul_le_mul f1 f2 p2 p1'
      have m2 : q ^ (B.h * αi) * Sv ^ b * E ≤ q ^ (B.h * α) * Sv ^ (max b1 b2) * E :=
        mul_le_mul_of_nonneg_right m1 hE
      have m3 : q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) ≤
          q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) :=
        mul_le_mul m2 f3 p3 (mul_nonneg (mul_nonneg p1' p2') hE)
      have hWi := mul_le_mul_of_nonneg_right m3 hP
      have hWi0 : 0 ≤ q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P :=
        mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg p1 p2) hE) p3) hP
      calc N ≤ C * q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P := hN
        _ = C * (q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P) := by ring
        _ ≤ |C| * (q ^ (B.h * αi) * Sv ^ b * E * e ^ (-d) * P) :=
            mul_le_mul_of_nonneg_right (le_abs_self C) hWi0
        _ ≤ |C| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) :=
            mul_le_mul_of_nonneg_left hWi (abs_nonneg C)
    have k1 := key C1 b1 d1 α1 N1 ha1 hN1 (le_max_left _ _) (le_max_left _ _)
    have k2 := key C2 b2 d2 α2 N2 ha2 hN2 (le_max_right _ _) (le_max_right _ _)
    have e : (|C1| + |C2|) * q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P =
        |C1| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) +
        |C2| * (q ^ (B.h * α) * Sv ^ (max b1 b2) * E * e ^ (-(max d1 d2)) * P) := by ring
    rw [e]
    linarith

  have hNB : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f1 f2 g : Cyl → V) (k : ℕ) (ξ : Cyl),
      ξ ∈ DomC B.h (qsOf l0) → ContDiffOn ℝ ∞ f1 (DomC B.h (qsOf l0)) →
      ContDiffOn ℝ ∞ f2 (DomC B.h (qsOf l0)) →
      (∀ η ∈ DomC B.h (qsOf l0), g η = f1 η + f2 η) → NB B.h g k ξ ≤ NB B.h f1 k ξ + NB B.h f2 k ξ := by
    intro V _ _ f1 f2 g k ξ hξ hf1 hf2 heq
    have hn : DomC B.h (qsOf l0) ∈ nhds ξ := hDopen.mem_nhds hξ
    have hev : g =ᶠ[nhds ξ] f1 + f2 := Filter.eventuallyEq_of_mem hn (fun η hη => heq η hη)
    have e1 : iteratedFDeriv ℝ k g ξ = iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ := by
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      exact iteratedFDeriv_add_apply ((hf1.contDiffAt hn).of_le (by exact_mod_cast le_top))
        ((hf2.contDiffAt hn).of_le (by exact_mod_cast le_top))
    unfold NB
    rw [e1]
    have e2 : (iteratedFDeriv ℝ k f1 ξ + iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) =
        (iteratedFDeriv ℝ k f1 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) +
        (iteratedFDeriv ℝ k f2 ξ).compContinuousLinearMap (fun _ => Lnorm B.h ξ) := by
      ext m
      simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    exact norm_add_le _ _

  have hvel_add : ∀ (a1 a2 : WC) (γ : Lab) (m : ℤ) (ξ : Cyl),
      (∀ i, DifferentiableAt ℝ (fun η => a1 γ m η i) ξ) →
      (∀ i, DifferentiableAt ℝ (fun η => a2 γ m η i) ξ) →
      velW5 B G (a1 + a2) γ m ξ = velW5 B G a1 γ m ξ + velW5 B G a2 γ m ξ := by
    intro a1 a2 γ m ξ hd1 hd2
    have hfd : ∀ (i : Fin 3) (v : Cyl), fderiv ℝ (fun η => a1 γ m η i + a2 γ m η i) ξ v =
        fderiv ℝ (fun η => a1 γ m η i) ξ v + fderiv ℝ (fun η => a2 γ m η i) ξ v := by
      intro i v
      rw [fderiv_fun_add (hd1 i) (hd2 i), ContinuousLinearMap.add_apply]
    funext j
    fin_cases j <;> simp [velW5, velC5, DrC, DzC, dR, dZ, hfd, hd1, hd2] <;> ring
  have hvel_zero : ∀ (a : WC) (γ : Lab) (m : ℤ), a γ m = 0 → velW5 B G a γ m = 0 := by
    intro a γ m h0
    funext ξ j
    fin_cases j <;> simp [velW5, velC5, DrC, DzC, dR, dZ, h0]

  have hInM : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (α α1 α2 : ℝ) (f1 f2 g : Cyl → V),
      InM B (qsOf l0) α1 f1 → InM B (qsOf l0) α2 f2 → α ≤ α1 → α ≤ α2 →
      (∀ ξ ∈ DomC B.h (qsOf l0), g ξ = f1 ξ + f2 ξ) → InM B (qsOf l0) α g := by
    intro V _ _ α α1 α2 f1 f2 g h1 h2 ha1 ha2 heq
    obtain ⟨s1, d1, z1, b1⟩ := h1
    obtain ⟨s2, d2, z2, b2⟩ := h2
    refine ⟨(s1.add s2).congr heq, ?_, ?_, ?_⟩
    · intro ξ hξ a ha
      rw [heq _ (hDsh ξ hξ a), heq ξ hξ, d1 ξ hξ a ha, d2 ξ hξ a ha]
    · intro ξ hξ hX
      rw [heq ξ hξ, z1 ξ hξ hX, z2 ξ hξ hX, add_zero]
    · intro k
      obtain ⟨C1, c1, e1, hb1⟩ := b1 k
      obtain ⟨C2, c2, e2, hb2⟩ := b2 k
      refine ⟨|C1| + |C2|, max c1 c2, max e1 e2, fun ξ hξ hX1 hX2 => ?_⟩
      obtain ⟨hq0, hq1, hS1⟩ := hDq ξ hξ
      obtain ⟨hE, he0, he1⟩ := hEdge _ hX1 hX2
      have hn := hNB f1 f2 g k ξ hξ s1 s2 heq
      have := hW (qC B.h ξ) (SC B.h ξ) (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ))
        (edgeDist B.Xa B.Xb (XC B.h ξ)) 1 C1 C2 c1 c2 e1 e2 α α1 α2 (NB B.h f1 k ξ) (NB B.h f2 k ξ)
        hq0 hq1 hS1 hE he0 he1 zero_le_one ha1 ha2
        (le_of_le_of_eq (hb1 ξ hξ hX1 hX2) (mul_one _).symm)
        (le_of_le_of_eq (hb2 ξ hξ hX1 hX2) (mul_one _).symm)
      exact le_trans hn (le_of_le_of_eq this (mul_one _))

  have hInWg : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (α α1 α2 : ℝ)
      (a1 a2 c : Lab → ℤ → Cyl → V),
      InWg5 B G (qsOf l0) α1 a1 → InWg5 B G (qsOf l0) α2 a2 → α ≤ α1 → α ≤ α2 →
      (∃ H : Finset ℤ, (0 : ℤ) ∉ H ∧ ∀ γ m, m ∉ H → c γ m = 0) →
      (∀ γ m, ∀ ξ ∈ DomC B.h (qsOf l0), c γ m ξ = a1 γ m ξ + a2 γ m ξ) → InWg5 B G (qsOf l0) α c := by
    intro V _ _ α α1 α2 a1 a2 c h1 h2 ha1 ha2 hfr heq
    obtain ⟨-, s1, d1, u1, b1⟩ := h1
    obtain ⟨-, s2, d2, u2, b2⟩ := h2
    refine ⟨hfr, fun γ m => ((s1 γ m).add (s2 γ m)).congr (heq γ m), ?_, ?_, ?_⟩
    · intro γ m ξ hξ a ha
      rw [heq γ m _ (hDsh ξ hξ a), heq γ m ξ hξ, d1 γ m ξ hξ a ha, d2 γ m ξ hξ a ha]
    · intro γ m ξ hξ hne
      rw [heq γ m ξ hξ] at hne
      by_cases h : a1 γ m ξ = 0
      · rw [h, zero_add] at hne
        exact u2 γ m ξ hξ hne
      · exact u1 γ m ξ hξ h
    · intro k
      obtain ⟨C1, c1, e1, hb1⟩ := b1 k
      obtain ⟨C2, c2, e2, hb2⟩ := b2 k
      refine ⟨|C1| + |C2|, max c1 c2, max e1 e2, fun γ m ξ hξ hX1 hX2 => ?_⟩
      obtain ⟨hq0, hq1, hS1⟩ := hDq ξ hξ
      obtain ⟨hE, he0, he1⟩ := hEdge _ hX1 hX2
      have hn := hNB (a1 γ m) (a2 γ m) (c γ m) k ξ hξ (s1 γ m) (s2 γ m) (heq γ m)
      have hP : 0 ≤ Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) := by
        unfold Penv5
        exact (Real.exp_pos _).le
      have := hW (qC B.h ξ) (SC B.h ξ) (Real.sqrt (edgeWeight B.Xa B.Xb B.aa B.ab (XC B.h ξ)))
        (edgeDist B.Xa B.Xb (XC B.h ξ)) (Penv5 B G γ (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2))
        C1 C2 c1 c2 e1 e2 α α1 α2 _ _ hq0 hq1 hS1 (Real.sqrt_nonneg _) he0 he1 hP ha1 ha2
        (hb1 γ m ξ hξ hX1 hX2) (hb2 γ m ξ hξ hX1 hX2)
      exact le_trans hn this

  obtain ⟨A1, V1, P1, Ps1, Bd1, Pm1, M01, M21⟩ := hI1
  obtain ⟨A2, V2, P2, Ps2, Bd2, Pm2, M02, M22⟩ := hI2
  obtain ⟨H1, h01, hH1⟩ := A1.1
  obtain ⟨H2, h02, hH2⟩ := A2.1
  have h0H : (0:ℤ) ∉ H1 ∪ H2 := by
    rw [Finset.mem_union, not_or]
    exact ⟨h01, h02⟩
  have hfrAw : ∀ γ m, m ∉ H1 ∪ H2 → (S''.Aw - S.Aw) γ m = 0 := by
    intro γ m hm
    rw [Finset.mem_union, not_or] at hm
    have e1 := hH1 γ m hm.1
    have e2 := hH2 γ m hm.2
    have : (S''.Aw - S.Aw) γ m = (S''.Aw - S'.Aw) γ m + (S'.Aw - S.Aw) γ m := by
      simp only [Pi.sub_apply]
      abel
    rw [this, e1, e2, add_zero]
  have I1 : InWg5 B G (qsOf l0) o'' (S''.Aw - S.Aw) :=
    hInWg o'' o o' (S'.Aw - S.Aw) (S''.Aw - S'.Aw) (S''.Aw - S.Aw) A1 A2 ho ho'
      ⟨H1 ∪ H2, h0H, hfrAw⟩ (fun γ m ξ _ => by simp only [Pi.sub_apply]; abel)
  have hsum : S''.Aw - S.Aw = (S'.Aw - S.Aw) + (S''.Aw - S'.Aw) := by abel
  have I2 : InWg5 B G (qsOf l0) o'' (velW5 B G (S''.Aw - S.Aw)) := by
    refine hInWg o'' o o' (velW5 B G (S'.Aw - S.Aw)) (velW5 B G (S''.Aw - S'.Aw)) _ V1 V2 ho ho'
      ⟨H1 ∪ H2, h0H, fun γ m hm => hvel_zero _ γ m (hfrAw γ m hm)⟩ ?_
    intro γ m ξ hξ
    rw [hsum]
    apply hvel_add
    · intro i
      exact differentiableAt_pi.mp
        (((A1.2.1 γ m).differentiableOn (by simp)).differentiableAt (hDopen.mem_nhds hξ)) i
    · intro i
      exact differentiableAt_pi.mp
        (((A2.2.1 γ m).differentiableOn (by simp)).differentiableAt (hDopen.mem_nhds hξ)) i
  obtain ⟨G1, g01, hG1⟩ := P1.1
  obtain ⟨G2, g02, hG2⟩ := P2.1
  have I3 : InWg5 B G (qsOf l0) o'' (S''.pw - S.pw) := by
    refine hInWg o'' o o' (S'.pw - S.pw) (S''.pw - S'.pw) (S''.pw - S.pw) P1 P2 ho ho'
      ⟨G1 ∪ G2, ?_, ?_⟩ (fun γ m ξ _ => by simp only [Pi.sub_apply]; abel)
    · rw [Finset.mem_union, not_or]
      exact ⟨g01, g02⟩
    · intro γ m hm
      rw [Finset.mem_union, not_or] at hm
      have e1 := hG1 γ m hm.1
      have e2 := hG2 γ m hm.2
      have : (S''.pw - S.pw) γ m = (S''.pw - S'.pw) γ m + (S'.pw - S.pw) γ m := by
        simp only [Pi.sub_apply]
        abel
      rw [this, e1, e2, add_zero]
  have I4 : InM B (qsOf l0) o'' (S''.Psi - S.Psi) :=
    hInM o'' o o' (S'.Psi - S.Psi) (S''.Psi - S'.Psi) (S''.Psi - S.Psi) Ps1 Ps2 ho ho'
      (fun ξ _ => by simp only [Pi.sub_apply]; ring)
  have I5 : InM B (qsOf l0) o'' (S''.bdir - S.bdir) :=
    hInM o'' o o' (S'.bdir - S.bdir) (S''.bdir - S'.bdir) (S''.bdir - S.bdir) Bd1 Bd2 ho ho'
      (fun ξ _ => by simp only [Pi.sub_apply]; ring)
  have I6 : InM B (qsOf l0) o'' (nrm B (2 * Aex B.h) (fun ξ => pmP5 B G l0 S'' ξ - pmP5 B G l0 S ξ)) :=
    hInM o'' o o' _ _ _ Pm1 Pm2 ho ho' (fun ξ _ => by simp only [nrm]; ring)
  have I7 : InM B (qsOf l0) (o'' + 1)
      (nrm B (Aex B.h) (fun ξ => mcor5 B G l0 S'' 0 ξ - mcor5 B G l0 S 0 ξ)) :=
    hInM (o'' + 1) (o + 1) (o' + 1) _ _ _ M01 M02 (by linarith) (by linarith)
      (fun ξ _ => by simp only [nrm]; ring)
  have I8 : InM B (qsOf l0) o'' (nrm B (Aex B.h) (fun ξ => mcor5 B G l0 S'' 2 ξ - mcor5 B G l0 S 2 ξ)) :=
    hInM o'' o o' _ _ _ M21 M22 ho ho' (fun ξ _ => by simp only [nrm]; ring)
  exact ⟨I1, I2, I3, I4, I5, I6, I7, I8⟩

theorem geom_separation_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → 0 < G.r0 → G.r0 ≤ 1/100000 → 40 ≤ G.lmin →
    (∀ γ : Lab, G.ctr γ = geomCtr5 γ) → ∀ γ γ' : Lab, γ ≠ γ' → G.lmin ≤ γ.1 → G.lmin ≤ γ'.1 →
    (∃ ξ ∈ DomC B.h B.qB, etaL B.h γ ξ ≠ 0 ∧ etaL B.h γ' ξ ≠ 0) →
    Disjoint (closure (rectAbs B G γ (2 * G.r0))) (closure (rectAbs B G γ' (2 * G.r0))) :=
by
  intro B G hB hr0 hr0' h40 hctr γ γ' hne hl hl' hex
  obtain ⟨ξ, -, hη, hη'⟩ := hex
  have hh0 : 0 < B.h := hB.2.1.1
  have hh1 : B.h < 1/100 := hB.2.1.2.1

  have hs : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
  have hs1 : 1 < Real.sqrt 2 := Real.one_lt_sqrt_two
  have hs2 : Real.sqrt 2 < 3/2 := by nlinarith
  have hb0 : 0 < bgc := by unfold bgc; linarith
  have hb1 : bgc < 1/2 := by unfold bgc; linarith
  have hDpos : 0 < 1 + bgc ^ 2 := by positivity
  have hDne : 1 + bgc ^ 2 ≠ 0 := hDpos.ne'
  have hD1 : 1 ≤ 1 + bgc ^ 2 := by nlinarith [sq_nonneg bgc]
  have hLpos : 0 < Lgc := by unfold Lgc; linarith
  have hTpos : 0 < Tgc := by unfold Tgc; linarith

  have hJ1 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).1 = Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) * bgc := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.fst_add, Prod.smul_fst, smul_eq_mul, mul_one]
  have hJ2 : ∀ (n : ℤ) (Y : ℝ × ℝ), (Jpow n Y).2 = Lgc ^ n * ((Y.1 - bgc * Y.2) / (1 + bgc ^ 2)) * (-bgc) +
      Tgc ^ n * ((bgc * Y.1 + Y.2) / (1 + bgc ^ 2)) := by
    intro n Y
    simp only [Jpow, vrv, vtv, Prod.snd_add, Prod.smul_snd, smul_eq_mul, mul_one]

  have hJs : ∀ (n : ℤ) (Y : ℝ × ℝ), Jpow (n + 1) Y =
      (3 * (Jpow n Y).1 + (Jpow n Y).2, (Jpow n Y).1 + 5 * (Jpow n Y).2) := by
    intro n Y
    have hL0 : Lgc ≠ 0 := hLpos.ne'
    have hT0 : Tgc ≠ 0 := hTpos.ne'
    refine Prod.ext ?_ ?_
    · show (Jpow (n + 1) Y).1 = 3 * (Jpow n Y).1 + (Jpow n Y).2
      rw [hJ1, hJ1, hJ2, zpow_add_one₀ hL0, zpow_add_one₀ hT0]
      generalize (Y.1 - bgc * Y.2) / (1 + bgc ^ 2) = A
      generalize (bgc * Y.1 + Y.2) / (1 + bgc ^ 2) = C
      generalize Lgc ^ n = P
      generalize Tgc ^ n = Q
      unfold Lgc Tgc bgc
      linear_combination (Q * C) * hs
    · show (Jpow (n + 1) Y).2 = (Jpow n Y).1 + 5 * (Jpow n Y).2
      rw [hJ2, hJ1, hJ2, zpow_add_one₀ hL0, zpow_add_one₀ hT0]
      generalize (Y.1 - bgc * Y.2) / (1 + bgc ^ 2) = A
      generalize (bgc * Y.1 + Y.2) / (1 + bgc ^ 2) = C
      generalize Lgc ^ n = P
      generalize Tgc ^ n = Q
      unfold Lgc Tgc bgc
      linear_combination (P * A) * hs

  have hrec : ∀ p : ℝ × ℝ, p.1 = lamR p + bgc * lamT p ∧ p.2 = -bgc * lamR p + lamT p := by
    intro p
    unfold lamR lamT
    constructor
    · field_simp
      ring
    · field_simp
      ring
  have hcomp : ∀ (p : ℝ × ℝ) (σ : ℝ), |lamR p| ≤ σ → |lamT p| ≤ σ → |p.1| ≤ 2 * σ ∧ |p.2| ≤ 2 * σ := by
    intro p σ hR hT
    have hσ : 0 ≤ σ := le_trans (abs_nonneg _) hR
    obtain ⟨r1, r2⟩ := abs_le.mp hR
    obtain ⟨t1, t2⟩ := abs_le.mp hT
    obtain ⟨e1, e2⟩ := hrec p
    have k1 : bgc * lamT p ≤ σ := by nlinarith
    have k2 : -σ ≤ bgc * lamT p := by nlinarith
    have k3 : bgc * lamR p ≤ σ := by nlinarith
    have k4 : -σ ≤ bgc * lamR p := by nlinarith
    constructor
    · rw [abs_le]; constructor <;> linarith
    · rw [abs_le]; constructor <;> linarith

  have hsq : ∀ (μ : ℝ) (j : ℤ) (s : ℝ), sqPart μ j s ≠ 0 → |s / μ - j| < 1 := by
    intro μ j s hne0
    have hnum : bumpR (s / μ - j) ≠ 0 := by
      intro h0; apply hne0; unfold sqPart; rw [h0, zero_div]
    unfold bumpR at hnum
    have hlt : ¬ (1 - (s / μ - j) ^ 2 ≤ 0) := fun hle => hnum (Real.smoothTransition.zero_of_nonpos hle)
    exact (sq_lt_one_iff_abs_lt_one _).mp (by linarith [not_le.mp hlt])
  have hint : ∀ (x : ℝ) (a a' : ℤ), |x - a| < 1 → |x - a'| < 1 → |a - a'| ≤ 1 := by
    intro x a a' h h'
    rw [abs_lt] at h h'
    have u1 : ((a - a' : ℤ) : ℝ) < 2 := by push_cast; linarith
    have u2 : ((a' - a : ℤ) : ℝ) < 2 := by push_cast; linarith
    have v1 : a - a' < 2 := by exact_mod_cast u1
    have v2 : a' - a < 2 := by exact_mod_cast u2
    rw [abs_le]; constructor <;> omega

  unfold etaL at hη hη'
  obtain ⟨hA1, hB1⟩ := mul_ne_zero_iff.mp hη
  obtain ⟨hB1', hC1⟩ := mul_ne_zero_iff.mp hB1
  obtain ⟨hR1, hZ1⟩ := mul_ne_zero_iff.mp hB1'
  obtain ⟨hA2, hB2⟩ := mul_ne_zero_iff.mp hη'
  obtain ⟨hB2', hC2⟩ := mul_ne_zero_iff.mp hB2
  obtain ⟨hR2, hZ2⟩ := mul_ne_zero_iff.mp hB2'
  have e1 := abs_lt.mp (hsq _ _ _ hA1)
  have e2 := abs_lt.mp (hsq _ _ _ hA2)
  simp only [div_one, Int.cast_neg, Int.cast_natCast] at e1 e2
  have hll1 : γ.1 ≤ γ'.1 + 1 := by
    have h3 : (γ.1 : ℝ) < γ'.1 + 2 := by linarith [e1.1, e1.2, e2.1, e2.2]
    have h4 : γ.1 < γ'.1 + 2 := by exact_mod_cast h3
    omega
  have hll2 : γ'.1 ≤ γ.1 + 1 := by
    have h3 : (γ'.1 : ℝ) < γ.1 + 2 := by linarith [e1.1, e1.2, e2.1, e2.2]
    have h4 : γ'.1 < γ.1 + 2 := by exact_mod_cast h3
    omega
  have hbox : γ.1 = γ'.1 → |γ.2.1.1 - γ'.2.1.1| ≤ 1 ∧ |γ.2.1.2.1 - γ'.2.1.2.1| ≤ 1 ∧
      |γ.2.1.2.2 - γ'.2.1.2.2| ≤ 1 := by
    intro he
    rw [← he] at hR2 hZ2 hC2
    exact ⟨hint _ _ _ (hsq _ _ _ hR1) (hsq _ _ _ hR2), hint _ _ _ (hsq _ _ _ hZ1) (hsq _ _ _ hZ2),
      hint _ _ _ (hsq _ _ _ hC1) (hsq _ _ _ hC2)⟩

  have hcode_rng : ∀ γ : Lab, 0 ≤ geomCode5 γ ∧ geomCode5 γ ≤ 107 := by
    rintro ⟨l, ⟨a1, a2, a3⟩, σ⟩
    unfold geomCode5
    cases σ <;> simp <;> omega
  have hcode_ne : ∀ γ γ' : Lab, γ ≠ γ' → γ.1 ≤ γ'.1 + 1 → γ'.1 ≤ γ.1 + 1 →
      (γ.1 = γ'.1 → |γ.2.1.1 - γ'.2.1.1| ≤ 1 ∧ |γ.2.1.2.1 - γ'.2.1.2.1| ≤ 1 ∧
        |γ.2.1.2.2 - γ'.2.1.2.2| ≤ 1) → geomCode5 γ ≠ geomCode5 γ' := by
    rintro ⟨l, ⟨a1, a2, a3⟩, σ⟩ ⟨l', ⟨b1, b2, b3⟩, σ'⟩ hne0 hl1 hl2 hbx heq
    try dsimp only at hl1 hl2 hbx
    apply hne0
    unfold geomCode5 at heq
    have hll : l = l' := by
      cases σ <;> cases σ' <;> simp at heq <;> omega
    subst hll
    obtain ⟨h1, h2, h3⟩ := hbx rfl
    rw [abs_le] at h1 h2 h3
    cases σ <;> cases σ' <;> simp at heq ⊢ <;> omega

  have hfl : ∀ a δ : ℝ, 0 ≤ δ → δ < 1 → ⌊a + δ⌋ = ⌊a⌋ ∨ ⌊a + δ⌋ = ⌊a⌋ + 1 := by
    intro a δ h0 h1
    have u1 : ⌊a⌋ ≤ ⌊a + δ⌋ := Int.floor_le_floor (by linarith)
    have u2 : (⌊a + δ⌋ : ℝ) < ⌊a⌋ + 2 := by linarith [Int.floor_le (a + δ), Int.lt_floor_add_one a]
    have u3 : ⌊a + δ⌋ < ⌊a⌋ + 2 := by exact_mod_cast u2
    omega
  have hband : ∀ l : ℕ, 40 ≤ l → bandIdx B.h (l + 1) = bandIdx B.h l ∨
      bandIdx B.h (l + 1) = bandIdx B.h l + 1 := by
    intro l hl0
    have hlR : (40:ℝ) ≤ l := by exact_mod_cast hl0
    have hlpos : (0:ℝ) < l := by linarith
    have hl1pos : (0:ℝ) < (l:ℝ) + 1 := by linarith
    have hlog2 := Real.log_two_gt_d9
    have hTgt4 : (4:ℝ) < Tgc := by unfold Tgc; linarith
    have hlogT4 : Real.log 4 < Real.log Tgc := Real.log_lt_log (by norm_num) hTgt4
    have hlog4 : Real.log 4 = 2 * Real.log 2 := by
      rw [show (4:ℝ) = 2 * 2 by norm_num, Real.log_mul two_ne_zero two_ne_zero]; ring
    have hlogTpos : 0 < Real.log Tgc := by linarith
    have hf : ∀ x : ℝ, 0 < x → Real.logb Tgc ((2:ℝ) ^ ((1 + B.h) * x) / x ^ 2) =
        ((1 + B.h) * x * Real.log 2 - 2 * Real.log x) / Real.log Tgc := by
      intro x hx
      rw [Real.logb, Real.log_div (Real.rpow_pos_of_pos two_pos _).ne' (pow_pos hx 2).ne',
        Real.log_rpow two_pos, Real.log_pow]
      norm_num
    have hd0 : Real.log (l:ℝ) ≤ Real.log ((l:ℝ) + 1) := Real.log_le_log hlpos (by linarith)
    have hd1 : Real.log ((l:ℝ) + 1) - Real.log l ≤ 1/40 := by
      rw [← Real.log_div hl1pos.ne' hlpos.ne']
      have w1 := Real.log_le_sub_one_of_pos (div_pos hl1pos hlpos)
      have w2 : ((l:ℝ) + 1) / l - 1 = 1 / l := by
        rw [eq_div_iff hlpos.ne', sub_mul, div_mul_cancel₀ _ hlpos.ne']; ring
      have w3 : 1 / (l:ℝ) ≤ 1 / 40 := one_div_le_one_div_of_le (by norm_num) hlR
      linarith
    have key : ((1 + B.h) * ((l:ℝ) + 1) * Real.log 2 - 2 * Real.log ((l:ℝ) + 1)) / Real.log Tgc =
        ((1 + B.h) * (l:ℝ) * Real.log 2 - 2 * Real.log (l:ℝ)) / Real.log Tgc +
        ((1 + B.h) * Real.log 2 - 2 * (Real.log ((l:ℝ) + 1) - Real.log l)) / Real.log Tgc := by
      rw [← add_div]; congr 1; ring
    have hN0 : 0 ≤ (1 + B.h) * Real.log 2 - 2 * (Real.log ((l:ℝ) + 1) - Real.log l) := by
      nlinarith [mul_nonneg hh0.le (show (0:ℝ) ≤ Real.log 2 by linarith)]
    have hN1 : (1 + B.h) * Real.log 2 - 2 * (Real.log ((l:ℝ) + 1) - Real.log l) < Real.log Tgc := by
      nlinarith [mul_pos (show (0:ℝ) < 1 - B.h by linarith) (show (0:ℝ) < Real.log 2 by linarith)]
    unfold bandIdx
    simp only [Nat.cast_add, Nat.cast_one]
    rw [hf ((l:ℝ) + 1) hl1pos, hf (l:ℝ) hlpos, key]
    exact hfl _ _ (div_nonneg hN0 hlogTpos.le) ((div_lt_one hlogTpos).mpr hN1)

  have hsmall : ∀ x y ε : ℝ, |x| < ε → |y| < ε →
      |(x - bgc * y) / (1 + bgc ^ 2)| < 2 * ε ∧ |(bgc * x + y) / (1 + bgc ^ 2)| < 2 * ε := by
    intro x y ε hx hy
    have hby : |bgc * y| ≤ |y| := by
      rw [abs_mul, abs_of_pos hb0]; exact mul_le_of_le_one_left (abs_nonneg _) (by linarith)
    have hbx : |bgc * x| ≤ |x| := by
      rw [abs_mul, abs_of_pos hb0]; exact mul_le_of_le_one_left (abs_nonneg _) (by linarith)
    have s1 : |x - bgc * y| ≤ |x| + |bgc * y| := by
      have := abs_add_le x (-(bgc * y)); rwa [abs_neg, ← sub_eq_add_neg] at this
    have s2 : |bgc * x + y| ≤ |bgc * x| + |y| := abs_add_le _ _
    constructor
    · rw [abs_div, abs_of_pos hDpos]
      exact lt_of_le_of_lt (div_le_self (abs_nonneg _) hD1) (by linarith)
    · rw [abs_div, abs_of_pos hDpos]
      exact lt_of_le_of_lt (div_le_self (abs_nonneg _) hD1) (by linarith)
  have hcl0 : ∀ (n : ℤ) (c Y Y₁ : ℝ × ℝ) (ρ ε : ℝ), 2 * (Lgc ^ n + Tgc ^ n) * ε = ρ →
      |lamR (frac0 (Jpow n Y₁ - c))| ≤ ρ → |lamT (frac0 (Jpow n Y₁ - c))| ≤ ρ →
      |Y.1 - Y₁.1| < ε → |Y.2 - Y₁.2| < ε →
      |lamR (Jpow n Y - c - (((round (Jpow n Y₁ - c).1 : ℤ) : ℝ), ((round (Jpow n Y₁ - c).2 : ℤ) : ℝ)))| ≤ 2 * ρ ∧
      |lamT (Jpow n Y - c - (((round (Jpow n Y₁ - c).1 : ℤ) : ℝ), ((round (Jpow n Y₁ - c).2 : ℤ) : ℝ)))| ≤ 2 * ρ := by
    intro n c Y Y₁ ρ ε hερ hm1 hm2 hd1 hd2
    have hL : 0 < Lgc ^ n := zpow_pos hLpos n
    have hT : 0 < Tgc ^ n := zpow_pos hTpos n
    have hε0 : 0 < ε := lt_of_le_of_lt (abs_nonneg _) hd1
    have iR : lamR (Jpow n Y - c - (((round (Jpow n Y₁ - c).1 : ℤ) : ℝ), ((round (Jpow n Y₁ - c).2 : ℤ) : ℝ))) =
        lamR (frac0 (Jpow n Y₁ - c)) + Lgc ^ n * (((Y.1 - Y₁.1) - bgc * (Y.2 - Y₁.2)) / (1 + bgc ^ 2)) := by
      unfold lamR frac0
      simp only [Prod.fst_sub, Prod.snd_sub, hJ1, hJ2]
      field_simp
      ring
    have iT : lamT (Jpow n Y - c - (((round (Jpow n Y₁ - c).1 : ℤ) : ℝ), ((round (Jpow n Y₁ - c).2 : ℤ) : ℝ))) =
        lamT (frac0 (Jpow n Y₁ - c)) + Tgc ^ n * ((bgc * (Y.1 - Y₁.1) + (Y.2 - Y₁.2)) / (1 + bgc ^ 2)) := by
      unfold lamT frac0
      simp only [Prod.fst_sub, Prod.snd_sub, hJ1, hJ2]
      field_simp
      ring
    obtain ⟨u1, u2⟩ := hsmall _ _ _ hd1 hd2
    have bR : |Lgc ^ n * (((Y.1 - Y₁.1) - bgc * (Y.2 - Y₁.2)) / (1 + bgc ^ 2))| ≤ ρ := by
      rw [abs_mul, abs_of_pos hL]
      nlinarith [mul_le_mul_of_nonneg_left u1.le hL.le, mul_nonneg hT.le hε0.le]
    have bT : |Tgc ^ n * ((bgc * (Y.1 - Y₁.1) + (Y.2 - Y₁.2)) / (1 + bgc ^ 2))| ≤ ρ := by
      rw [abs_mul, abs_of_pos hT]
      nlinarith [mul_le_mul_of_nonneg_left u2.le hT.le, mul_nonneg hL.le hε0.le]
    constructor
    · rw [iR]; exact (abs_add_le _ _).trans (by linarith)
    · rw [iT]; exact (abs_add_le _ _).trans (by linarith)
  have hclos : ∀ (γ : Lab) (ρ : ℝ), 0 < ρ → ∀ Y ∈ closure (rectAbs B G γ ρ), ∃ k1 k2 : ℤ,
      |lamR (Jpow (bandIdx B.h γ.1) Y - G.ctr γ - ((k1:ℝ), (k2:ℝ)))| ≤ 2 * ρ ∧
      |lamT (Jpow (bandIdx B.h γ.1) Y - G.ctr γ - ((k1:ℝ), (k2:ℝ)))| ≤ 2 * ρ := by
    intro γ ρ hρ Y hY
    have hL : 0 < Lgc ^ (bandIdx B.h γ.1) := zpow_pos hLpos _
    have hT : 0 < Tgc ^ (bandIdx B.h γ.1) := zpow_pos hTpos _
    have hLT : 0 < 2 * (Lgc ^ (bandIdx B.h γ.1) + Tgc ^ (bandIdx B.h γ.1)) := by linarith
    obtain ⟨Y₁, hY₁, hd⟩ := Metric.mem_closure_iff.mp hY
      (ρ / (2 * (Lgc ^ (bandIdx B.h γ.1) + Tgc ^ (bandIdx B.h γ.1)))) (div_pos hρ hLT)
    rw [Prod.dist_eq, max_lt_iff, Real.dist_eq, Real.dist_eq] at hd
    have hm : inRect B.h γ (G.ctr γ) ρ Y₁ := hY₁
    have hερ : 2 * (Lgc ^ (bandIdx B.h γ.1) + Tgc ^ (bandIdx B.h γ.1)) *
        (ρ / (2 * (Lgc ^ (bandIdx B.h γ.1) + Tgc ^ (bandIdx B.h γ.1)))) = ρ := by
      field_simp
    exact ⟨_, _, hcl0 (bandIdx B.h γ.1) (G.ctr γ) Y Y₁ ρ _ hερ hm.1 hm.2 hd.1 hd.2⟩

  have hsame : ∀ (W : ℝ × ℝ) (d d' k1 k2 k1' k2' : ℤ) (σ : ℝ), σ ≤ 4 / 100000 → 0 ≤ d → d ≤ 107 →
      0 ≤ d' → d' ≤ 107 →
      |lamR (W - (((d : ℝ) + 1) / 1000, (0 : ℝ)) - ((k1 : ℝ), (k2 : ℝ)))| ≤ σ →
      |lamT (W - (((d : ℝ) + 1) / 1000, (0 : ℝ)) - ((k1 : ℝ), (k2 : ℝ)))| ≤ σ →
      |lamR (W - (((d' : ℝ) + 1) / 1000, (0 : ℝ)) - ((k1' : ℝ), (k2' : ℝ)))| ≤ σ →
      |lamT (W - (((d' : ℝ) + 1) / 1000, (0 : ℝ)) - ((k1' : ℝ), (k2' : ℝ)))| ≤ σ → d = d' := by
    intro W d d' k1 k2 k1' k2' σ hσ hd0 hd1 hd0' hd1' h1 h2 h3 h4
    have q1 := abs_le.mp (hcomp _ σ h1 h2).1
    have q2 := abs_le.mp (hcomp _ σ h3 h4).1
    simp only [Prod.fst_sub] at q1 q2
    have u1 : ((d' - d + 1000 * (k1' - k1) : ℤ) : ℝ) < 1 := by
      push_cast; linarith [q1.1, q1.2, q2.1, q2.2]
    have u2 : (-1 : ℝ) < ((d' - d + 1000 * (k1' - k1) : ℤ) : ℝ) := by
      push_cast; linarith [q1.1, q1.2, q2.1, q2.2]
