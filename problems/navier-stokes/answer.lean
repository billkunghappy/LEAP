  obtain ⟨F2, hF2⟩ : ∃ f : Cyl → ℝ, f = fun η => ubase B η 0 * mcor5 B G l0 S 2 η +
      ubase B η 2 * mcor5 B G l0 S 0 η + mcor5 B G l0 S 0 η * mcor5 B G l0 S 2 η +
      Wcov5 B G l0 S 2 0 η := ⟨_, rfl⟩
  have hF2C : InM B (qsOf l0) 1 (nrm B (Aex B.h + Aex B.h) F2) := by
    have a1 := h5 l0 hl5 (9/10) (Aex B.h) (mcor5 B G l0 S 2) hγ
