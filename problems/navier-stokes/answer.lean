      let Ws : ℂ := 1 - 4 * d - 2 * D * (η : ℂ) * Us
      let δ0 : ℕ → ℂ := fun i => if i = 0 then 1 else 0
      let Uc : ℕ → ℂ := fun i => δ0 i * Us + axVn h j0 Λ C χc ζc ℓc zc Ξ i (η : ℂ) / (Λ : ℂ)
      let Bc : ℕ → ℂ := fun i => -(2 * D * (η : ℂ) * axVn h j0 Λ C χc ζc ℓc zc Ξ i (η : ℂ) +
        d * deriv (axVn h j0 Λ C χc ζc ℓc zc Ξ i) (η : ℂ)) / ((i : ℂ) + 1)
      let Wc : ℕ → ℂ := fun i => δ0 i * Ws + Bc i / (Λ : ℂ)
      let Hc : ℕ → ℂ := fun i => δ0 i * H + d * axVn h j0 Λ C χc ζc ℓc zc Ξ i (η : ℂ) / (Λ : ℂ)
      axPn h j0 Λ C χc ζc ℓc zc Ξ (n + 1) (η : ℂ) =
        (-χc (η : ℂ) * axPn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ) + ℓc (η : ℂ) * (∑ i ∈ Finset.range (n + 1),
          ((Wc i + (h : ℂ) * δ0 i - 2 * (h : ℂ) * (η : ℂ) * Uc i + d * ζc (η : ℂ) *
              axVn h j0 Λ C χc ζc ℓc zc Ξ i (η : ℂ)) * axPn h j0 Λ C χc ζc ℓc zc Ξ (n - i) (η : ℂ)
            + ((n - i : ℕ) : ℂ) * Wc i * axPn h j0 Λ C χc ζc ℓc zc Ξ (n - i) (η : ℂ) +
            Hc i * deriv (axPn h j0 Λ C χc ζc ℓc zc Ξ (n - i)) (η : ℂ))) / (Λ : ℂ)) /
          (2 * ((n : ℂ) + 1) * ((n : ℂ) + 2)) := by
    intro n
    rw [show axPn h j0 Λ C χc ζc ℓc zc Ξ (n + 1) =
        (axRecStep h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ)
          (fun i => axRecPV h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) i) n).1 from by
      unfold axPn; rw [hs1]]
    rfl
  have hrecV : ∀ n : ℕ,
      let D : ℂ := 1 / 2 - (h : ℂ)
      let Ah : ℂ := 1 / 2 + (h : ℂ)
      let d : ℂ := 1 - (η : ℂ) ^ 2
      let Us : ℂ := 4 * (η : ℂ) + (j0 : ℂ)
      let H : ℂ := D * (η : ℂ) + d * Us
      let Ws : ℂ := 1 - 4 * d - 2 * D * (η : ℂ) * Us
      let δ0 : ℕ → ℂ := fun i => if i = 0 then 1 else 0
      let Bc : ℕ → ℂ := fun i => -(2 * D * (η : ℂ) * axVn h j0 Λ C χc ζc ℓc zc Ξ i (η : ℂ) +
        d * deriv (axVn h j0 Λ C χc ζc ℓc zc Ξ i) (η : ℂ)) / ((i : ℂ) + 1)
      let Wc : ℕ → ℂ := fun i => δ0 i * Ws + Bc i / (Λ : ℂ)
      let gc : ℂ := if n = 0 then 0 else axGain Λ C Ξ (η : ℂ) ^ 2 * ∑ i ∈ Finset.range (n - 1 + 1),
        axPn h j0 Λ C χc ζc ℓc zc Ξ i (η : ℂ) * axPn h j0 Λ C χc ζc ℓc zc Ξ (n - 1 - i) (η : ℂ)
      let S : ℂ :=
        -(∑ i ∈ Finset.range (n + 1), ((n - i : ℕ) : ℂ) * Wc i * axVn h j0 Λ C χc ζc ℓc zc Ξ (n - i) (η : ℂ))
          - Ah * (1 - 4 * (η : ℂ) * Us) * axVn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)
          + 2 * Ah * (η : ℂ) / (Λ : ℂ) * (∑ i ∈ Finset.range (n + 1),
              axVn h j0 Λ C χc ζc ℓc zc Ξ i (η : ℂ) * axVn h j0 Λ C χc ζc ℓc zc Ξ (n - i) (η : ℂ))
          - H * deriv (axVn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ) - 4 * d * axVn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)
          - d / (Λ : ℂ) * (∑ i ∈ Finset.range (n + 1),
              axVn h j0 Λ C χc ζc ℓc zc Ξ i (η : ℂ) * deriv (axVn h j0 Λ C χc ζc ℓc zc Ξ (n - i)) (η : ℂ))
          - d * deriv (axQn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ)
          + 4 * Ah * (η : ℂ) * axQn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ) + 2 * (η : ℂ) * gc
      axVn h j0 Λ C χc ζc ℓc zc Ξ (n + 1) (η : ℂ) =
        (-(δ0 n * zc (η : ℂ)) - ℓc (η : ℂ) * S / (Λ : ℂ)) / (2 * ((n : ℂ) + 1) ^ 2) := by
    intro n
    rw [show axVn h j0 Λ C χc ζc ℓc zc Ξ (n + 1) =
        (axRecStep h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ)
          (fun i => axRecPV h j0 Λ χc ζc ℓc zc (axGain Λ C Ξ) i) n).2 from by
      unfold axVn; rw [hs1]]
    rfl

  obtain ⟨hbdL, hFc, hFxc, hFxxc, hFec, hUc, hUxc, hUxxc, hUec⟩ :=
    ax_ode_local_calc h j0 σ ρ Pc Pax r M Λ0 A χc ζc ℓc zc Ξ hCD
      hMaj Λ C X η hΛ0 hC hX0 hX1 hη1 hη2
  obtain ⟨hbdQ, hWc, hPIc, v, hv, hvc⟩ :=
    ax_ode_nonlocal_calc h j0 σ ρ Pc Pax r M Λ0 A χc ζc ℓc zc Ξ hCD
      hMaj Λ C X η hΛ0 hC hX0 hX1 hη1 hη2

  have p1 : 0 ≤ 8 / r * A := by positivity
  have p2 : 0 ≤ 10 * A ^ 2 := by positivity
  have p3 : 0 ≤ 80 / r * A ^ 2 := by positivity
  set B : ℝ := A + 8 / r * A + 10 * A ^ 2 + 80 / r * A ^ 2 with hBdef
  have hB0 : 0 ≤ B := by linarith
  have lift : ∀ (c x : ℝ) (n : ℕ), c ≤ B → x ≤ c * (1 / 10) ^ n → x ≤ B * (1 / 10) ^ n :=
    fun c x n hc hx => le_trans hx (mul_le_mul_of_nonneg_right hc (by positivity))
  have k1 : A ≤ B := by linarith
  have k2 : 8 / r * A ≤ B := by linarith
  have k3 : 10 * A ^ 2 ≤ B := by linarith
  have k4 : 80 / r * A ^ 2 ≤ B := by linarith
  have hbdP : ∀ n : ℕ, ‖axPn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)‖ ≤ B * (1 / 10) ^ n ∧
      ‖deriv (axPn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ)‖ ≤ B * (1 / 10) ^ n ∧
      ‖axVn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)‖ ≤ B * (1 / 10) ^ n ∧
      ‖deriv (axVn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ)‖ ≤ B * (1 / 10) ^ n := by
    intro n
    obtain ⟨b1, b2, b3, b4⟩ := hbdL n
    exact ⟨lift _ _ n k1 b1, lift _ _ n k2 b2, lift _ _ n k1 b3, lift _ _ n k2 b4⟩
  have hbdV : ∀ n : ℕ, ‖axPn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)‖ ≤ B * (1 / 10) ^ n ∧
      ‖axVn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)‖ ≤ B * (1 / 10) ^ n ∧
      ‖deriv (axVn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ)‖ ≤ B * (1 / 10) ^ n ∧
      ‖axQn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ)‖ ≤ B * (1 / 10) ^ n ∧
      ‖deriv (axQn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ)‖ ≤ B * (1 / 10) ^ n := by
    intro n
    obtain ⟨b1, -, b3, b4⟩ := hbdL n
    obtain ⟨q1, q2⟩ := hbdQ n
    exact ⟨lift _ _ n k1 b1, lift _ _ n k1 b3, lift _ _ n k2 b4, lift _ _ n k3 q1, lift _ _ n k4 q2⟩

  have key1 := ax_ode_match_P h j0 Λ X (η : ℂ) (χc (η : ℂ)) (ζc (η : ℂ)) (ℓc (η : ℂ))
    (fun n => axPn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ))
    (fun n => deriv (axPn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ))
    (fun n => axVn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ))
    (fun n => deriv (axVn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ)) B hΛ1 hX0 hΛX hB0 hbdP hℓ hHζ hrecP
  have key2 := ax_ode_match_V h j0 Λ X (η : ℂ) (axGain Λ C Ξ (η : ℂ)) (zc (η : ℂ)) (ℓc (η : ℂ))
    ((Pax η : ℝ) : ℂ) ((deriv Pax η : ℝ) : ℂ)
    (fun n => axPn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ))
    (fun n => axVn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ))
    (fun n => deriv (axVn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ))
    (fun n => axQn h j0 Λ C χc ζc ℓc zc Ξ n (η : ℂ))
    (fun n => deriv (axQn h j0 Λ C χc ζc ℓc zc Ξ n) (η : ℂ)) B hΛ1 hX0 hΛX hB0 hbdV hℓ hz hrecV
  dsimp only at key1 key2
  constructor
  ·
    have e1 : axSq h (axFnDef h j0 Λ C χc ζc ℓc zc Ξ) (axUnDef h j0 Λ C χc ζc ℓc zc Ξ) X η *
          axFnDef h j0 Λ C χc ζc ℓc zc Ξ X η =
        -leadW h (axUnDef h j0 Λ C χc ζc ℓc zc Ξ) X η *
            (axFnDef h j0 Λ C χc ζc ℓc zc Ξ X η + X * deriv (fun Y => axFnDef h j0 Λ C χc ζc ℓc zc Ξ Y η) X)
          - h * (1 - 2 * η * axUnDef h j0 Λ C χc ζc ℓc zc Ξ X η) * axFnDef h j0 Λ C χc ζc ℓc zc Ξ X η
          - ((1 / 2 - h) * η + (1 - η ^ 2) * axUnDef h j0 Λ C χc ζc ℓc zc Ξ X η) *
            deriv (fun e => axFnDef h j0 Λ C χc ζc ℓc zc Ξ X e) η := by
      unfold axSq
      field_simp
    rw [e1]
    apply Complex.ofReal_injective
    push_cast
    rw [hFxxc, hFxc, hFec, hFc, hUc, hWc]
    linear_combination axGain Λ C Ξ (η : ℂ) * key1
  ·
    have hdPi : deriv (fun e => axPi Pax (axFnDef h j0 Λ C χc ζc ℓc zc Ξ) X e) η = deriv Pax η + v := by
      unfold axPi
      exact (hPaxd.hasDerivAt.add hv).deriv
    unfold axSn
    rw [hdPi]
    unfold axPi
    apply Complex.ofReal_injective
    push_cast
    rw [hUxxc, hUxc, hUec, hUc, hWc, hPIc, hvc, hFc]
