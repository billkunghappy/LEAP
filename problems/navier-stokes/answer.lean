  obtain ⟨U2, -, hη2, -, hU2⟩ := nPhiP5_local_model_v5 B G γ η hB hηD hxi het
  have hP1 := hU2 η hη2
  rw [hproj] at hP1
  have hPv : nPhiP5 B G γ η = p := by rw [hP1, hpD, hDr, hDz]
  have hK1 := kmat_slow_form_v5 B G γ hB η hηD
  rw [hproj] at hK1
  have hKv : Kmat B G γ η = Km := by rw [hK1, hKm]
  unfold APhi5 dDamp5
  rw [hNv, hPv, hKv]
  have key := rank1 A N CD 4 ν (epsb B.h γ.1 * ((kb B.h γ.1 : ℝ)) ^ 2) Km (a + v • p) p y hν
    (by linarith) hE4 hKmb hnb hν1' hpb
  refine key.trans (mul_le_mul_of_nonneg_right ?_ (norm_nonneg _))
  rw [← hΛ1]
  exact (le_max_left _ _).trans (le_max_left _ _)

theorem forced_duhamel_within5 : ∀ (A0 : ℝ → Matrix (Fin 3) (Fin 3) ℝ) (P : ℝ → ℝ) (L K F : ℝ) (y r : ℝ → (Fin 3 → ℝ)), Continuous A0 → (∀ v, 0 < P v) → 0 ≤ K → 0 ≤ F → (∀ (x : ℝ → (Fin 3 → ℝ)) (w : ℝ), 0 ≤ w → w ≤ L → (∀ v ∈ Set.Icc w L, HasDerivAt x ((A0 v).mulVec (x v)) v) → ∀ v ∈ Set.Icc w L, ‖x v‖ ≤ K * (P v / P w) * ‖x w‖) → (∀ v ∈ Set.Icc (0:ℝ) L, HasDerivWithinAt y ((A0 v).mulVec (y v) + r v) (Set.Icc (0:ℝ) L) v) → (∀ v ∈ Set.Icc (0:ℝ) L, ‖r v‖ ≤ F * P v) → ∀ v ∈ Set.Icc (0:ℝ) L, ‖y v‖ ≤ K * P v * (‖y 0‖ / P 0 + F * v) :=
by
  have lode : ∀ (E : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] (B : ℝ → E →L[ℝ] E) (g : ℝ → E) (x0 : E), Continuous B → Continuous g → ∃ y : ℝ → E, y 0 = x0 ∧ ∀ v : ℝ, HasDerivAt y (B v (y v) + g v) v := by
    intro E _ _ _ B g x0 hB hg
    have : CompleteSpace E := FiniteDimensional.complete ℝ E

    have retr : ∀ R : ℝ, 0 < R → ∃ ρ : E → E, (∀ x y, ‖ρ x - ρ y‖ ≤ 2 * ‖x - y‖) ∧
        (∀ x, ‖ρ x‖ ≤ ‖x‖) ∧ (∀ x, ‖ρ x‖ ≤ R) ∧ (∀ x, ‖x‖ ≤ R → ρ x = x) := by
      intro R hR
      refine ⟨fun x => (R / max ‖x‖ R) • x, ?_, ?_, ?_, ?_⟩
      · intro x y
        have hmx : 0 < max ‖x‖ R := lt_max_of_lt_right hR
        have hmy : 0 < max ‖y‖ R := lt_max_of_lt_right hR
        obtain ⟨a, ha⟩ : ∃ a : ℝ, a = R / max ‖x‖ R := ⟨_, rfl⟩
        obtain ⟨b, hb⟩ : ∃ b : ℝ, b = R / max ‖y‖ R := ⟨_, rfl⟩
        have ha0 : 0 ≤ a := by rw [ha]; exact div_nonneg hR.le hmx.le
        have ha1 : a ≤ 1 := by rw [ha]; exact (div_le_one hmx).2 (le_max_right _ _)
        have hyb : ‖y‖ ≤ max ‖y‖ R := le_max_left _ _
        have hab : |a - b| * ‖y‖ ≤ ‖x - y‖ := by
          have e : a - b = a * (max ‖y‖ R - max ‖x‖ R) / max ‖y‖ R := by
            rw [ha, hb]; field_simp
          have hm := abs_max_sub_max_le_abs ‖y‖ ‖x‖ R
          have hn := abs_norm_sub_norm_le y x
          rw [norm_sub_rev] at hn
          rw [e, abs_div, abs_mul, abs_of_nonneg ha0, abs_of_pos hmy]
          have e2 : a * |max ‖y‖ R - max ‖x‖ R| / max ‖y‖ R * ‖y‖ =
              (a * (‖y‖ / max ‖y‖ R)) * |max ‖y‖ R - max ‖x‖ R| := by ring
          rw [e2]
          have h1 : ‖y‖ / max ‖y‖ R ≤ 1 := (div_le_one hmy).2 hyb
          have h2 : 0 ≤ ‖y‖ / max ‖y‖ R := div_nonneg (norm_nonneg _) hmy.le
          have h3 : a * (‖y‖ / max ‖y‖ R) ≤ 1 := by nlinarith
          calc a * (‖y‖ / max ‖y‖ R) * |max ‖y‖ R - max ‖x‖ R|
              ≤ 1 * |max ‖y‖ R - max ‖x‖ R| := mul_le_mul_of_nonneg_right h3 (abs_nonneg _)
            _ ≤ ‖x - y‖ := by linarith
        have e2 : a • x - b • y = a • (x - y) + (a - b) • y := by
          rw [smul_sub, sub_smul]; abel
        show ‖(R / max ‖x‖ R) • x - (R / max ‖y‖ R) • y‖ ≤ 2 * ‖x - y‖
        rw [← ha, ← hb, e2]
        calc ‖a • (x - y) + (a - b) • y‖ ≤ ‖a • (x - y)‖ + ‖(a - b) • y‖ := norm_add_le _ _
          _ = a * ‖x - y‖ + |a - b| * ‖y‖ := by
              rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg ha0]
          _ ≤ 1 * ‖x - y‖ + ‖x - y‖ :=
              add_le_add (mul_le_mul_of_nonneg_right ha1 (norm_nonneg _)) hab
          _ = 2 * ‖x - y‖ := by ring
      · intro x
        have hmx : 0 < max ‖x‖ R := lt_max_of_lt_right hR
        show ‖(R / max ‖x‖ R) • x‖ ≤ ‖x‖
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (div_nonneg hR.le hmx.le)]
        have ha1 : R / max ‖x‖ R ≤ 1 := (div_le_one hmx).2 (le_max_right _ _)
        calc R / max ‖x‖ R * ‖x‖ ≤ 1 * ‖x‖ := mul_le_mul_of_nonneg_right ha1 (norm_nonneg _)
          _ = ‖x‖ := one_mul _
      · intro x
        have hmx : 0 < max ‖x‖ R := lt_max_of_lt_right hR
        show ‖(R / max ‖x‖ R) • x‖ ≤ R
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (div_nonneg hR.le hmx.le)]
        rw [div_mul_eq_mul_div, div_le_iff₀ hmx]
        exact mul_le_mul_of_nonneg_left (le_max_left _ _) hR.le
      · intro x hx
        show (R / max ‖x‖ R) • x = x
        rw [max_eq_right hx, div_self hR.ne', one_smul]

    have fwd : ∀ (r F : ℝ → E) (K ε T : ℝ), 0 ≤ K → 0 ≤ ε → 0 ≤ T →
        (∀ v ∈ Set.Icc (-T) T, HasDerivWithinAt r (F v) (Set.Icc (-T) T) v) →
        (∀ v ∈ Set.Icc (-T) T, ‖F v‖ ≤ K * ‖r v‖ + ε) →
        ∀ v ∈ Set.Icc (0:ℝ) T, ‖r v‖ ≤ (‖r 0‖ + ε * T) * Real.exp (K * T) := by
      intro r F K ε T hK hε hT hd hbd v hv
      have hcont : ContinuousOn r (Set.Icc 0 T) := fun x hx =>
        ((hd x ⟨by linarith [hx.1], hx.2⟩).continuousWithinAt).mono
          (Set.Icc_subset_Icc (by linarith) le_rfl)
      have h1 := norm_le_gronwallBound_of_norm_deriv_right_le (f := r) (f' := F)
        (δ := ‖r 0‖) (K := K) (ε := ε) (a := 0) (b := T) hcont
        (fun x hx => (hd x ⟨by linarith [hx.1], hx.2.le⟩).mono_of_mem_nhdsWithin
          (Icc_mem_nhdsGE_of_mem ⟨by linarith [hx.1], hx.2⟩)) le_rfl
        (fun x hx => hbd x ⟨by linarith [hx.1], hx.2.le⟩)
        v hv
      rw [sub_zero] at h1
      refine h1.trans ?_
      have hv0 : 0 ≤ v := hv.1
      have hvT : v ≤ T := hv.2
      have hδ : 0 ≤ ‖r 0‖ := norm_nonneg _
      have key : gronwallBound ‖r 0‖ K ε v ≤ (‖r 0‖ + ε * v) * Real.exp (K * v) := by
        rcases hK.eq_or_lt with h | h
        · subst h
          rw [gronwallBound_K0]
          simp
        · rw [gronwallBound_of_K_ne_0 h.ne']
          have hp := Real.exp_pos (K * v)
          have e1 : Real.exp (K * v) * Real.exp (-(K * v)) = 1 := by
            rw [← Real.exp_add]; simp
          have e2 := Real.add_one_le_exp (-(K * v))
          have e2' := mul_le_mul_of_nonneg_left e2 hp.le
          have e3 : Real.exp (K * v) - 1 ≤ K * v * Real.exp (K * v) := by
            nlinarith
          have hc : ε / K * K = ε := div_mul_cancel₀ ε h.ne'
          have e4 : ε / K * (Real.exp (K * v) - 1) ≤ ε * v * Real.exp (K * v) := by
            calc ε / K * (Real.exp (K * v) - 1) ≤ ε / K * (K * v * Real.exp (K * v)) :=
                  mul_le_mul_of_nonneg_left e3 (div_nonneg hε h.le)
              _ = ε / K * K * (v * Real.exp (K * v)) := by ring
              _ = ε * v * Real.exp (K * v) := by rw [hc]; ring
          nlinarith
      refine key.trans ?_
      apply mul_le_mul
      · nlinarith
      · exact Real.exp_le_exp.mpr (by nlinarith)
      · exact (Real.exp_pos _).le
      · nlinarith

    have gron : ∀ (r F : ℝ → E) (K ε T : ℝ), 0 ≤ K → 0 ≤ ε → 0 ≤ T →
        (∀ v ∈ Set.Icc (-T) T, HasDerivWithinAt r (F v) (Set.Icc (-T) T) v) →
        (∀ v ∈ Set.Icc (-T) T, ‖F v‖ ≤ K * ‖r v‖ + ε) →
        ∀ v ∈ Set.Icc (-T) T, ‖r v‖ ≤ (‖r 0‖ + ε * T) * Real.exp (K * T) := by
      intro r F K ε T hK hε hT hd hbd v hv
      rcases le_or_gt 0 v with h0 | h0
      · exact fwd r F K ε T hK hε hT hd hbd v ⟨h0, hv.2⟩
      · have hmaps : Set.MapsTo (Neg.neg : ℝ → ℝ) (Set.Icc (-T) T) (Set.Icc (-T) T) :=
          fun u hu => ⟨by linarith [hu.2], by linarith [hu.1]⟩
        have hd' : ∀ u ∈ Set.Icc (-T) T, HasDerivWithinAt (fun u => r (-u))
            ((fun u => -F (-u)) u) (Set.Icc (-T) T) u := by
          intro u hu
          have h2 : HasDerivWithinAt (r ∘ Neg.neg) ((-1:ℝ) • F (-u)) (Set.Icc (-T) T) u :=
            (hd (-u) (hmaps hu)).scomp u (hasDerivWithinAt_neg u (Set.Icc (-T) T)) hmaps
          have h3 : (-1:ℝ) • F (-u) = -F (-u) := by simp
          rw [h3] at h2
          exact h2
        have hbd' : ∀ u ∈ Set.Icc (-T) T, ‖(fun u => -F (-u)) u‖ ≤
            K * ‖(fun u => r (-u)) u‖ + ε := by
          intro u hu
          simp only [norm_neg]
          exact hbd (-u) (hmaps hu)
        have := fwd (fun u => r (-u)) (fun u => -F (-u)) K ε T hK hε hT hd' hbd' (-v)
          ⟨by linarith, by linarith [hv.1]⟩
        simpa only [neg_neg, neg_zero] using this

    have exI : ∀ T : ℝ, 0 < T → ∃ α : ℝ → E, α 0 = x0 ∧
        ∀ t ∈ Set.Icc (-T) T, HasDerivWithinAt α (B t (α t) + g t) (Set.Icc (-T) T) t := by
      intro T hT
      obtain ⟨CB, hCB⟩ := (isCompact_Icc (a := -T) (b := T)).exists_bound_of_continuousOn
        hB.continuousOn
      obtain ⟨Cg, hCg⟩ := (isCompact_Icc (a := -T) (b := T)).exists_bound_of_continuousOn
        hg.continuousOn
      obtain ⟨K, hKdef⟩ : ∃ K : ℝ, K = max CB 0 + 1 := ⟨_, rfl⟩
      obtain ⟨G, hGdef⟩ : ∃ G : ℝ, G = max Cg 0 := ⟨_, rfl⟩
      have hK : 0 < K := by rw [hKdef]; linarith [le_max_right CB 0]
      have hG : 0 ≤ G := by rw [hGdef]; exact le_max_right _ _
      have hBK : ∀ t ∈ Set.Icc (-T) T, ‖B t‖ ≤ K := fun t ht => by
        rw [hKdef]; linarith [hCB t ht, le_max_left CB 0]
      have hgG : ∀ t ∈ Set.Icc (-T) T, ‖g t‖ ≤ G := fun t ht => by
        rw [hGdef]; exact (hCg t ht).trans (le_max_left _ _)
      obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = (‖x0‖ + G * T) * Real.exp (K * T) + 1 := ⟨_, rfl⟩
      have hR : 0 < R := by
        rw [hRdef]
        have h1 := Real.exp_pos (K * T)
        have h2 : 0 ≤ ‖x0‖ + G * T := add_nonneg (norm_nonneg _) (mul_nonneg hG hT.le)
        have h3 := mul_nonneg h2 h1.le
        linarith
      obtain ⟨ρ, hρL, hρn, hρR, hρid⟩ := retr R hR
      have hL0 : 0 ≤ K * R + G := add_nonneg (mul_nonneg hK.le hR.le) hG
      have t0mem : (0:ℝ) ∈ Set.Icc (-T) T := ⟨by linarith, hT.le⟩
      have hPL : IsPicardLindelof (fun t x => B t (ρ x) + g t) (⟨0, t0mem⟩ : Set.Icc (-T) T) x0
          ((K * R + G) * T).toNNReal 0 (K * R + G).toNNReal (2 * K).toNNReal := by
        apply IsPicardLindelof.mk
        · intro t ht
          apply LipschitzWith.lipschitzOnWith
          rw [lipschitzWith_iff_norm_sub_le]
          intro x y
          rw [Real.coe_toNNReal _ (by linarith)]
          show ‖B t (ρ x) + g t - (B t (ρ y) + g t)‖ ≤ 2 * K * ‖x - y‖
          rw [add_sub_add_right_eq_sub, ← map_sub]
          calc ‖B t (ρ x - ρ y)‖ ≤ ‖B t‖ * ‖ρ x - ρ y‖ := (B t).le_opNorm _
            _ ≤ K * (2 * ‖x - y‖) := mul_le_mul (hBK t ht) (hρL x y) (norm_nonneg _) hK.le
            _ = 2 * K * ‖x - y‖ := by ring
        · intro x _
          exact ((hB.clm_apply continuous_const).add hg).continuousOn
        · intro t ht x _
          rw [Real.coe_toNNReal _ hL0]
          calc ‖B t (ρ x) + g t‖ ≤ ‖B t (ρ x)‖ + ‖g t‖ := norm_add_le _ _
            _ ≤ ‖B t‖ * ‖ρ x‖ + ‖g t‖ := add_le_add ((B t).le_opNorm _) le_rfl
            _ ≤ K * R + G := add_le_add (mul_le_mul (hBK t ht) (hρR x) (norm_nonneg _) hK.le)
                (hgG t ht)
        · rw [Real.coe_toNNReal _ hL0, Real.coe_toNNReal _ (mul_nonneg hL0 hT.le)]
          have hmax : max (T - (0:ℝ)) ((0:ℝ) - -T) = T := by simp
          show (K * R + G) * max (T - (0:ℝ)) ((0:ℝ) - -T) ≤ (K * R + G) * T - ((0 : NNReal) : ℝ)
          rw [hmax, NNReal.coe_zero, sub_zero]
      obtain ⟨α, hα0, hα⟩ := hPL.exists_eq_forall_mem_Icc_hasDerivWithinAt₀
      have hα0' : α 0 = x0 := hα0
      have hbound := gron α (fun t => B t (ρ (α t)) + g t) K G T hK.le hG hT.le hα
        (fun t ht => by
          calc ‖B t (ρ (α t)) + g t‖ ≤ ‖B t (ρ (α t))‖ + ‖g t‖ := norm_add_le _ _
            _ ≤ ‖B t‖ * ‖ρ (α t)‖ + ‖g t‖ := add_le_add ((B t).le_opNorm _) le_rfl
            _ ≤ K * ‖α t‖ + G := add_le_add (mul_le_mul (hBK t ht) (hρn _) (norm_nonneg _) hK.le)
                (hgG t ht))
      rw [hα0'] at hbound
      refine ⟨α, hα0', fun t ht => ?_⟩
      have hin : ‖α t‖ ≤ R := by linarith [hbound t ht]
      have h2 : HasDerivWithinAt α (B t (ρ (α t)) + g t) (Set.Icc (-T) T) t := hα t ht
      rw [hρid _ hin] at h2
      exact h2

    have uniq : ∀ T : ℝ, 0 < T → ∀ α β : ℝ → E,
        (∀ t ∈ Set.Icc (-T) T, HasDerivWithinAt α (B t (α t) + g t) (Set.Icc (-T) T) t) →
        (∀ t ∈ Set.Icc (-T) T, HasDerivWithinAt β (B t (β t) + g t) (Set.Icc (-T) T) t) →
        α 0 = β 0 → ∀ t ∈ Set.Icc (-T) T, α t = β t := by
      intro T hT α β hα hβ h0
      obtain ⟨C, hC⟩ := (isCompact_Icc (a := -T) (b := T)).exists_bound_of_continuousOn
        hB.continuousOn
      have hlip : ∀ t ∈ Set.Ioo (-T) T,
          LipschitzOnWith C.toNNReal (fun x => B t x + g t) Set.univ := by
        intro t ht
        apply LipschitzWith.lipschitzOnWith
        rw [lipschitzWith_iff_norm_sub_le]
        intro x y
        show ‖B t x + g t - (B t y + g t)‖ ≤ (C.toNNReal : ℝ) * ‖x - y‖
        rw [add_sub_add_right_eq_sub, ← map_sub]
        exact ((B t).le_opNorm _).trans (mul_le_mul_of_nonneg_right
          ((hC t (Set.Ioo_subset_Icc_self ht)).trans (Real.le_coe_toNNReal C)) (norm_nonneg _))
      have hcα : ContinuousOn α (Set.Icc (-T) T) := fun t ht => (hα t ht).continuousWithinAt
      have hcβ : ContinuousOn β (Set.Icc (-T) T) := fun t ht => (hβ t ht).continuousWithinAt
      exact ODE_solution_unique_of_mem_Icc (v := fun t x => B t x + g t) (s := fun _ => Set.univ)
        hlip ⟨by linarith, hT⟩ hcα
        (fun t ht => (hα t (Set.Ioo_subset_Icc_self ht)).hasDerivAt (Icc_mem_nhds ht.1 ht.2))
        (fun _ _ => Set.mem_univ _) hcβ
        (fun t ht => (hβ t (Set.Ioo_subset_Icc_self ht)).hasDerivAt (Icc_mem_nhds ht.1 ht.2))
        (fun _ _ => Set.mem_univ _) h0

    choose α hα0 hα using fun n : ℕ => exI ((n:ℝ) + 1) (by positivity)
    have agree : ∀ n m : ℕ, n ≤ m → ∀ t : ℝ, |t| ≤ (n:ℝ) + 1 → α n t = α m t := by
      intro n m hnm t ht
      have hnm' : (n:ℝ) ≤ m := Nat.cast_le.mpr hnm
      have hsub : Set.Icc (-((n:ℝ) + 1)) ((n:ℝ) + 1) ⊆ Set.Icc (-((m:ℝ) + 1)) ((m:ℝ) + 1) :=
        Set.Icc_subset_Icc (by linarith) (by linarith)
      exact uniq ((n:ℝ) + 1) (by positivity) (α n) (α m) (hα n)
        (fun s hs => (hα m s (hsub hs)).mono hsub) ((hα0 n).trans (hα0 m).symm) t (abs_le.mp ht)
    refine ⟨fun t => α ⌈|t|⌉₊ t, hα0 _, fun v => ?_⟩
    obtain ⟨n0, hn0⟩ : ∃ n0 : ℕ, n0 = ⌈|v|⌉₊ := ⟨_, rfl⟩
    have hv : |v| ≤ (n0:ℝ) := by rw [hn0]; exact Nat.le_ceil _
    have hvlt := abs_lt.mp (show |v| < (n0:ℝ) + 1 by linarith)
    have hev : (fun t => α ⌈|t|⌉₊ t) =ᶠ[nhds v] α n0 := by
      filter_upwards [Ioo_mem_nhds hvlt.1 hvlt.2] with t ht
      have htl : |t| < (n0:ℝ) + 1 := abs_lt.mpr ht
      have hk : |t| ≤ ((⌈|t|⌉₊ : ℕ) : ℝ) := Nat.le_ceil _
      rcases le_total ⌈|t|⌉₊ n0 with h | h
      · exact agree _ _ h t (by linarith)
      · exact (agree _ _ h t htl.le).symm
    have hd : HasDerivAt (α n0) (B v (α n0 v) + g v) v :=
      (hα n0 v ⟨hvlt.1.le, hvlt.2.le⟩).hasDerivAt (Icc_mem_nhds hvlt.1 hvlt.2)
    show HasDerivAt (fun t => α ⌈|t|⌉₊ t) (B v (α ⌈|v|⌉₊ v) + g v) v
    rw [← hn0]
    exact hd.congr_of_eventuallyEq hev
  intro A0 P L K F y r hA0 hP hK hF hprop hy hr v hv

  have through : ∀ (M : ℝ → Matrix (Fin 3) (Fin 3) ℝ) (s : ℝ) (b : Fin 3 → ℝ), Continuous M →
      ∃ x : ℝ → (Fin 3 → ℝ), x s = b ∧ ∀ t : ℝ, HasDerivAt x (Matrix.mulVec (M t) (x t)) t := by
    intro M s b hM
    obtain ⟨z, hz0, hz⟩ := lode (Fin 3 → ℝ)
      (fun τ => LinearMap.toContinuousLinearMap (Matrix.toLin' (M (τ + s)))) (fun _ => 0) b
      (by
        rw [continuous_clm_apply]
        intro u
        simp only [LinearMap.coe_toContinuousLinearMap', Matrix.toLin'_apply]
        exact (hM.comp (continuous_id.add continuous_const)).matrix_mulVec continuous_const)
      continuous_const
    refine ⟨fun t => z (t - s), by simp [hz0], fun t => ?_⟩
    have h1 := (hz (t - s)).comp_sub_const t s
    simp only [LinearMap.coe_toContinuousLinearMap', Matrix.toLin'_apply, sub_add_cancel,
      add_zero] at h1
    exact h1

  have dotd : ∀ (p q : ℝ → (Fin 3 → ℝ)) (p' q' : Fin 3 → ℝ) (t : ℝ), HasDerivAt p p' t →
      HasDerivAt q q' t →
      HasDerivAt (fun τ => dotProduct (p τ) (q τ)) (dotProduct p' (q t) + dotProduct (p t) q') t := by
    intro p q p' q' t hp hq
    have hp' := hasDerivAt_pi.1 hp
    have hq' := hasDerivAt_pi.1 hq
    have h := HasDerivAt.fun_sum (u := Finset.univ) (fun a _ => (hp' a).mul (hq' a))
    have e : dotProduct p' (q t) + dotProduct (p t) q' =
        ∑ a : Fin 3, (p' a * q t a + p t a * q' a) := by
      simp only [dotProduct, Finset.sum_add_distrib]
    rw [e]
    exact h
  have dotdW : ∀ (p q : ℝ → (Fin 3 → ℝ)) (p' q' : Fin 3 → ℝ) (S : Set ℝ) (t : ℝ),
      HasDerivWithinAt p p' S t → HasDerivWithinAt q q' S t →
      HasDerivWithinAt (fun τ => dotProduct (p τ) (q τ))
        (dotProduct p' (q t) + dotProduct (p t) q') S t := by
    intro p q p' q' S t hp hq
    have hp' := hasDerivWithinAt_pi.1 hp
    have hq' := hasDerivWithinAt_pi.1 hq
    have h := HasDerivWithinAt.fun_sum (u := Finset.univ) (fun a _ => (hp' a).mul (hq' a))
    have e : dotProduct p' (q t) + dotProduct (p t) q' =
        ∑ a : Fin 3, (p' a * q t a + p t a * q' a) := by
      simp only [dotProduct, Finset.sum_add_distrib]
    rw [e]
    exact h

  have alg : ∀ (M : Matrix (Fin 3) (Fin 3) ℝ) (ψ z : Fin 3 → ℝ),
      dotProduct (Matrix.mulVec (-(Matrix.transpose M)) ψ) z + dotProduct ψ (Matrix.mulVec M z) = 0 := by
    intro M ψ z
    rw [Matrix.neg_mulVec, Matrix.mulVec_transpose, neg_dotProduct, Matrix.dotProduct_mulVec]
    exact neg_add_cancel _
  have hv0 : 0 ≤ v := hv.1
  have hvL : v ≤ L := hv.2
  have hPv := hP v
  have hR0 : 0 ≤ K * P v * (‖y 0‖ / P 0 + F * v) := by
    apply mul_nonneg (mul_nonneg hK hPv.le)
    exact add_nonneg (div_nonneg (norm_nonneg _) (hP 0).le) (mul_nonneg hF hv0)
  refine (pi_norm_le_iff_of_nonneg hR0).2 (fun i => ?_)
  have hMc : Continuous (fun t => -(Matrix.transpose (A0 t))) :=
    (Continuous.matrix_transpose (A := fun t => A0 t) hA0).neg
  obtain ⟨ψ, hψv, hψ⟩ := through (fun t => -(Matrix.transpose (A0 t)))
    v (Pi.single i 1) hMc

  have star : ∀ s : ℝ, 0 ≤ s → s ≤ v → ∀ b : Fin 3 → ℝ,
      |dotProduct (ψ s) b| ≤ K * (P v / P s) * ‖b‖ := by
    intro s hs0 hsv b
    obtain ⟨x, hxs, hx⟩ := through (fun t => A0 t) s b hA0
    have hd : ∀ τ : ℝ, HasDerivAt (fun τ => dotProduct (ψ τ) (x τ)) 0 τ := by
      intro τ
      exact (dotd ψ x _ _ τ (hψ τ) (hx τ)).congr_deriv (alg (A0 τ) (ψ τ) (x τ))
    have hconst : ∀ a c : ℝ, dotProduct (ψ a) (x a) = dotProduct (ψ c) (x c) :=
      is_const_of_deriv_eq_zero (fun τ => (hd τ).differentiableAt) (fun τ => (hd τ).deriv)
    have e1 : dotProduct (ψ s) b = x v i := by
      rw [← hxs, hconst s v, hψv, single_dotProduct, one_mul]
    have hb := hprop x s hs0 (le_trans hsv hvL) (fun t _ => hx t) v ⟨hsv, hvL⟩
    rw [hxs] at hb
    rw [e1, ← Real.norm_eq_abs]
    exact le_trans (norm_le_pi_norm (x v) i) hb

  have hGd : ∀ t ∈ Set.Icc (0:ℝ) v, HasDerivWithinAt (fun τ => dotProduct (ψ τ) (y τ))
      (dotProduct (ψ t) (r t)) (Set.Icc 0 v) t := by
    intro t ht
    have htL : t ∈ Set.Icc (0:ℝ) L := ⟨ht.1, le_trans ht.2 hvL⟩
    have hsub : Set.Icc (0:ℝ) v ⊆ Set.Icc (0:ℝ) L := Set.Icc_subset_Icc le_rfl hvL
    have h := dotdW ψ y _ _ (Set.Icc (0:ℝ) v) t (hψ t).hasDerivWithinAt ((hy t htL).mono hsub)
    have e : dotProduct (Matrix.mulVec (-(Matrix.transpose (A0 t))) (ψ t))
        (y t) + dotProduct (ψ t) (Matrix.mulVec (A0 t) (y t) + r t) = dotProduct (ψ t) (r t) := by
      have h0 := alg (A0 t) (ψ t) (y t)
      rw [dotProduct_add]
      linarith
    exact h.congr_deriv e

  have hGb : ∀ t ∈ Set.Ico (0:ℝ) v, ‖dotProduct (ψ t) (r t)‖ ≤ K * F * P v := by
    intro t ht
    have htL : t ∈ Set.Icc (0:ℝ) L := ⟨ht.1, le_trans ht.2.le hvL⟩
    have hPt := hP t
    have h1 := star t ht.1 ht.2.le (r t)
    have h2 : K * (P v / P t) * ‖r t‖ ≤ K * (P v / P t) * (F * P t) :=
      mul_le_mul_of_nonneg_left (hr t htL) (mul_nonneg hK (div_nonneg hPv.le hPt.le))
    have hc : P v / P t * P t = P v := div_mul_cancel₀ _ hPt.ne'
    have h3 : K * (P v / P t) * (F * P t) = K * F * P v := by
      calc K * (P v / P t) * (F * P t) = K * F * (P v / P t * P t) := by ring
        _ = K * F * P v := by rw [hc]
    rw [Real.norm_eq_abs]
    linarith

  have hmvt : ‖dotProduct (ψ v) (y v) - dotProduct (ψ 0) (y 0)‖ ≤ K * F * P v * (v - 0) :=
    norm_image_sub_le_of_norm_deriv_le_segment' hGd hGb v ⟨hv0, le_rfl⟩

  have hG0 := star 0 le_rfl hv0 (y 0)
  have hGv : dotProduct (ψ v) (y v) = y v i := by rw [hψv, single_dotProduct, one_mul]
  rw [hGv, Real.norm_eq_abs] at hmvt
  rw [Real.norm_eq_abs]
  have htri := abs_sub_abs_le_abs_sub (y v i) (dotProduct (ψ 0) (y 0))
  have e : K * (P v / P 0) * ‖y 0‖ + K * F * P v * (v - 0) =
      K * P v * (‖y 0‖ / P 0 + F * v) := by ring
  linarith

theorem pulse5_propagator : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ C b : ℝ, 0 ≤ b ∧ ∀ (γ : Lab) (ξ : Cyl), ActiveL4 B G γ → ξ ∈ DomC B.h B.qB → etaL B.h γ ξ ≠ 0 → B.Xa < XC B.h ξ → XC B.h ξ < B.Xb → ∀ (z f : ℝ → Fin 3 → ℝ) (F : ℝ), 0 ≤ F → (∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), HasDerivWithinAt z ((APhi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv))).mulVec (z v) - dDamp5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) • z v + f v) (Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1)) v) → (∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), ‖f v‖ ≤ F * Penv5 B G γ v) → ‖z 0‖ ≤ F * Penv5 B G γ 0 → ∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), ‖z v‖ ≤ C * SC B.h ξ ^ b * F * Penv5 B G γ v :=
by
  intro B G hB hG
  obtain ⟨lP, CP, bP, hPP⟩ := pulse_propagator_v5 B G hB hG
  obtain ⟨Λ, hΛ0, hsc⟩ := pulse_small_coeff5 B G hB hG lP
  have hr0 : 0 < G.r0 := hG.1.1
  have hr01 : G.r0 ≤ 1/100 := hG.1.2.1
  have hlmin : 40 ≤ G.lmin := hG.1.2.2.2.2
  have hTgc : 0 < Tgc := by unfold Tgc; positivity
  obtain ⟨e, he⟩ : ∃ e : ℝ, e = |bP| + 2 := ⟨_, rfl⟩
  have he0 : 0 ≤ e := by rw [he]; linarith [abs_nonneg bP]
  obtain ⟨Ks, hKs⟩ : ∃ x : ℝ, x = Real.exp (2 * Λ * (Tgc * (lP : ℝ) ^ 2)) := ⟨_, rfl⟩
  have hKs0 : 0 < Ks := by rw [hKs]; exact Real.exp_pos _
  obtain ⟨C1, hC1⟩ : ∃ x : ℝ, x = Ks * (1 + Tgc * (lP : ℝ) ^ 2) := ⟨_, rfl⟩
  obtain ⟨C2, hC2⟩ : ∃ x : ℝ, x = |CP| * (1 + Tgc) * (2:ℝ) ^ e := ⟨_, rfl⟩
  have hC1n : 0 ≤ C1 := by rw [hC1]; positivity
  refine ⟨max C1 C2, e / 2, by linarith, ?_⟩
  intro γ ξ hact hdom hη hXa hXb z f F hF hz hf h0 v hv

  have hP : ∀ s, 0 < Penv5 B G γ s := fun s => by unfold Penv5; exact Real.exp_pos _
  have hlN : 40 ≤ γ.1 := le_trans hlmin hact.1
  obtain ⟨ℓ, hℓ⟩ : ∃ x : ℝ, x = (γ.1 : ℝ) := ⟨_, rfl⟩
  have hℓ1 : 1 ≤ ℓ := by
    rw [hℓ]; have : (40:ℝ) ≤ (γ.1 : ℝ) := by exact_mod_cast hlN
    linarith
  have hℓ0 : 0 < ℓ := by linarith
  have hτ : 0 < 1 - ξ.2.2.1 := by linarith [hdom.2.1]
  have hq : 0 < qC B.h ξ := (hB.1.1 ξ.2.1 (1 - ξ.2.2.1) hτ).1
  have hwin := etaL_band_window_v5 B.h γ ξ hq hη
  have hQbpos : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have hq2 : qC B.h ξ < 2 * Qb γ.1 := by
    have := hwin.2; rwa [div_lt_iff₀ hQbpos] at this
  have hlogq : Real.log (qC B.h ξ) < (1 - ℓ) * Real.log 2 := by
    have h1 := Real.log_lt_log hq hq2
    have hQ : Real.log (Qb γ.1) = -(γ.1 : ℝ) * Real.log 2 := by
      show Real.log ((2:ℝ) ^ (-(γ.1 : ℝ))) = _
      rw [Real.log_rpow (by norm_num)]
    rw [Real.log_mul (by norm_num) hQbpos.ne', hQ, ← hℓ] at h1
    linarith
  obtain ⟨t, ht⟩ : ∃ x : ℝ, x = 1 + |Real.log (qC B.h ξ)| := ⟨_, rfl⟩
  have ht1 : 1 ≤ t := by rw [ht]; linarith [abs_nonneg (Real.log (qC B.h ξ))]
  have ht0 : 0 ≤ t := by linarith
  have hlog2 := Real.log_two_gt_d9
  have hℓt : ℓ ≤ 2 * t := by
    have h1 := neg_abs_le (Real.log (qC B.h ξ))
    have h2 : (ℓ - 1) * 0.6931471803 ≤ (ℓ - 1) * Real.log 2 :=
      mul_le_mul_of_nonneg_left hlog2.le (by linarith)
    rw [ht]
    nlinarith
  have hSC : SC B.h ξ = t ^ 2 := by rw [ht]; rfl
  have hSC1 : 1 ≤ SC B.h ξ := by rw [hSC]; nlinarith
  have hSCb : SC B.h ξ ^ (e / 2) = t ^ e := by
    rw [hSC, ← Real.rpow_two, ← Real.rpow_mul ht0]
    congr 1; ring
  have hSCb1 : 1 ≤ SC B.h ξ ^ (e / 2) := Real.one_le_rpow hSC1 (by linarith)

  have hcib := cib_band_bounds5 B.h γ.1 (by omega)
  rw [← hℓ] at hcib
  have hcib0 : 0 < cib B.h γ.1 := lt_trans (by positivity) hcib.1
  have hLle : Lsb B.h G.r0 γ.1 ≤ Tgc * ℓ ^ 2 := by
    show 2 * G.r0 / cib B.h γ.1 ≤ Tgc * ℓ ^ 2
    rw [div_le_iff₀ hcib0]
    have h1 := hcib.1
    rw [div_lt_iff₀ (by positivity)] at h1
    nlinarith
  have hL0 : 0 ≤ Lsb B.h G.r0 γ.1 := le_trans hv.1 hv.2

  obtain ⟨Mu, hMuc, hMu⟩ := pulse_line_cont5 B G γ ξ hB hr0 hr01 hdom
  have hz' : ∀ s ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1),
      HasDerivWithinAt z ((Mu s).mulVec (z s) + f s) (Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1)) s := by
    intro s hs
    rw [hMu s hs (z s)]
    exact hz s hs

  have final : ∀ K : ℝ, 0 ≤ K →
      (∀ (x : ℝ → (Fin 3 → ℝ)) (w : ℝ), 0 ≤ w → w ≤ Lsb B.h G.r0 γ.1 →
        (∀ s ∈ Set.Icc w (Lsb B.h G.r0 γ.1), HasDerivAt x ((Mu s).mulVec (x s)) s) →
        ∀ s ∈ Set.Icc w (Lsb B.h G.r0 γ.1), ‖x s‖ ≤ K * (Penv5 B G γ s / Penv5 B G γ w) * ‖x w‖) →
      K * (1 + v) ≤ max C1 C2 * SC B.h ξ ^ (e / 2) →
      ‖z v‖ ≤ max C1 C2 * SC B.h ξ ^ (e / 2) * F * Penv5 B G γ v := by
    intro K hK0 hhom hKC
    have hD := forced_duhamel_within5 Mu (Penv5 B G γ) (Lsb B.h G.r0 γ.1) K F z f hMuc hP hK0 hF
      hhom hz' hf v hv
    have hz0 : ‖z 0‖ / Penv5 B G γ 0 ≤ F := by
      rw [div_le_iff₀ (hP 0)]; exact h0
    calc ‖z v‖ ≤ K * Penv5 B G γ v * (‖z 0‖ / Penv5 B G γ 0 + F * v) := hD
      _ ≤ K * Penv5 B G γ v * (F + F * v) :=
          mul_le_mul_of_nonneg_left (by linarith) (mul_nonneg hK0 (hP v).le)
      _ = (K * (1 + v)) * (F * Penv5 B G γ v) := by ring
      _ ≤ (max C1 C2 * SC B.h ξ ^ (e / 2)) * (F * Penv5 B G γ v) :=
          mul_le_mul_of_nonneg_right hKC (mul_nonneg hF (hP v).le)
      _ = max C1 C2 * SC B.h ξ ^ (e / 2) * F * Penv5 B G γ v := by ring
  by_cases hl : lP ≤ γ.1
  ·
    obtain ⟨hrect, hline⟩ := pulse_line_base5 B.h G.r0 γ (G.ctr γ) hr0 hr01
    have hK0 : 0 ≤ |CP| * ℓ ^ |bP| := mul_nonneg (abs_nonneg _) (Real.rpow_nonneg hℓ0.le _)
    refine final (|CP| * ℓ ^ |bP|) hK0 ?_ ?_
    · intro x w hw0 hwL hx s hs
      have hx' : ∀ s' ∈ Set.Icc w (Lsb B.h G.r0 γ.1), HasDerivAt x
          ((APhi5 B G γ (((ξ.1, ξ.2.1, ξ.2.2.1, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ - G.r0 • vtv)) : Cyl) +
            (s' - vco B.h G.r0 γ (G.ctr γ) (Jpow (-(bandIdx B.h γ.1)) (G.ctr γ - G.r0 • vtv))) •
              dVdir B.h γ.1)).mulVec (x s') -
            dDamp5 B G γ (((ξ.1, ξ.2.1, ξ.2.2.1, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ - G.r0 • vtv)) : Cyl) +
            (s' - vco B.h G.r0 γ (G.ctr γ) (Jpow (-(bandIdx B.h γ.1)) (G.ctr γ - G.r0 • vtv))) •
              dVdir B.h γ.1) • x s') s' := by
        intro s' hs'
        rw [hline ξ s', ← hMu s' ⟨le_trans hw0 hs'.1, hs'.2⟩ (x s')]
        exact hx s' hs'
      have hb := hPP γ ((ξ.1, ξ.2.1, ξ.2.2.1, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ - G.r0 • vtv)) : Cyl)
        hl hact hη hdom hXa.le hXb.le hrect x w hw0 hwL hx' s hs
      rw [← hℓ] at hb
      have hnn : 0 ≤ Penv5 B G γ s / Penv5 B G γ w * ‖x w‖ :=
        mul_nonneg (div_pos (hP s) (hP w)).le (norm_nonneg _)
      have hc : CP * ℓ ^ bP ≤ |CP| * ℓ ^ |bP| :=
        le_trans (mul_le_mul_of_nonneg_right (le_abs_self CP) (Real.rpow_nonneg hℓ0.le _))
          (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hℓ1 (le_abs_self bP))
            (abs_nonneg _))
      calc ‖x s‖ ≤ CP * ℓ ^ bP * (Penv5 B G γ s / Penv5 B G γ w) * ‖x w‖ := hb
        _ = (CP * ℓ ^ bP) * (Penv5 B G γ s / Penv5 B G γ w * ‖x w‖) := by ring
        _ ≤ (|CP| * ℓ ^ |bP|) * (Penv5 B G γ s / Penv5 B G γ w * ‖x w‖) :=
            mul_le_mul_of_nonneg_right hc hnn
        _ = |CP| * ℓ ^ |bP| * (Penv5 B G γ s / Penv5 B G γ w) * ‖x w‖ := by ring
    · have hv1 : 1 + v ≤ (1 + Tgc) * ℓ ^ 2 := by
        have : 1 ≤ ℓ ^ 2 := by nlinarith
        nlinarith [hv.2]
      have hpow : ℓ ^ |bP| * ℓ ^ 2 = ℓ ^ e := by
        rw [he, Real.rpow_add hℓ0, Real.rpow_two]
      have hle : ℓ ^ e ≤ (2:ℝ) ^ e * t ^ e := by
        rw [← Real.mul_rpow (by norm_num) ht0]
        exact Real.rpow_le_rpow hℓ0.le hℓt he0
      have hA : 0 ≤ |CP| * (1 + Tgc) := mul_nonneg (abs_nonneg _) (by linarith)
      calc |CP| * ℓ ^ |bP| * (1 + v) ≤ |CP| * ℓ ^ |bP| * ((1 + Tgc) * ℓ ^ 2) :=
            mul_le_mul_of_nonneg_left hv1 hK0
        _ = |CP| * (1 + Tgc) * (ℓ ^ |bP| * ℓ ^ 2) := by ring
        _ = |CP| * (1 + Tgc) * ℓ ^ e := by rw [hpow]
        _ ≤ |CP| * (1 + Tgc) * ((2:ℝ) ^ e * t ^ e) := mul_le_mul_of_nonneg_left hle hA
        _ = C2 * SC B.h ξ ^ (e / 2) := by rw [hSCb, hC2]; ring
        _ ≤ max C1 C2 * SC B.h ξ ^ (e / 2) :=
            mul_le_mul_of_nonneg_right (le_max_right _ _) (by linarith)
  ·
    push_neg at hl
    have hlP : ℓ ^ 2 ≤ (lP : ℝ) ^ 2 := by
      have : ℓ ≤ (lP : ℝ) := by rw [hℓ]; exact_mod_cast hl.le
      exact pow_le_pow_left₀ hℓ0.le this 2
    have hLP : Lsb B.h G.r0 γ.1 ≤ Tgc * (lP : ℝ) ^ 2 :=
      le_trans hLle (mul_le_mul_of_nonneg_left hlP hTgc.le)
    obtain ⟨a, ha⟩ : ∃ a : ℝ → ℝ, a = fun w => lam0_5 B G γ / Real.sqrt (1 + sco B G γ w ^ 2) -
        epsb B.h γ.1 * ((kb B.h γ.1 : ℝ))^2 * Bs5 B G γ ^ 2 * (1 + sco B G γ w ^ 2) := ⟨_, rfl⟩
    have hPe : ∀ s, Penv5 B G γ s = Real.exp (∫ u in Lsb B.h G.r0 γ.1 / 2..s, a u) := by
      intro s; rw [ha]; rfl
    have hsco : Continuous (sco B G γ) := by
      unfold sco; fun_prop
    have hac : Continuous a := by
      rw [ha]
      refine Continuous.sub (Continuous.div continuous_const
        (Real.continuous_sqrt.comp (continuous_const.add (hsco.pow 2))) ?_) ?_
      · intro w; exact (Real.sqrt_pos.2 (by positivity)).ne'
      · exact continuous_const.mul (continuous_const.add (hsco.pow 2))
    have hratio : ∀ w s, 0 ≤ w → w ≤ s → s ≤ Lsb B.h G.r0 γ.1 →
        Real.exp (-(Λ * (s - w))) ≤ Penv5 B G γ s / Penv5 B G γ w := by
      intro w s hw hws hsL
      rw [hPe s, hPe w, ← Real.exp_sub,
        intervalIntegral.integral_interval_sub_left (hac.intervalIntegrable _ _)
          (hac.intervalIntegrable _ _)]
      apply Real.exp_le_exp.2
      have hb : ‖∫ u in w..s, a u‖ ≤ Λ * |s - w| := by
        apply intervalIntegral.norm_integral_le_of_norm_le_const
        intro u hu
        rw [Set.uIoc_of_le hws] at hu
        have := (hsc γ ξ hact hl hdom hη hXa hXb u ⟨by linarith [hu.1], le_trans hu.2 hsL⟩).2
        rw [Real.norm_eq_abs, ha]
        exact this
      rw [Real.norm_eq_abs, abs_of_nonneg (by linarith : (0:ℝ) ≤ s - w)] at hb
      linarith [neg_abs_le (∫ u in w..s, a u)]
    refine final Ks hKs0.le ?_ ?_
    · intro x w hw0 hwL hx s hs
      have hcont : ContinuousOn x (Set.Icc w (Lsb B.h G.r0 γ.1)) :=
        fun s' hs' => (hx s' hs').continuousAt.continuousWithinAt
      have hder : ∀ s' ∈ Set.Ico w (Lsb B.h G.r0 γ.1),
          HasDerivWithinAt x ((Mu s').mulVec (x s')) (Set.Ici s') s' :=
        fun s' hs' => (hx s' (Set.Ico_subset_Icc_self hs')).hasDerivWithinAt
      have hbd : ∀ s' ∈ Set.Ico w (Lsb B.h G.r0 γ.1), ‖(Mu s').mulVec (x s')‖ ≤ Λ * ‖x s'‖ + 0 := by
        intro s' hs'
        have hs'' : s' ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1) := ⟨le_trans hw0 hs'.1, hs'.2.le⟩
        rw [add_zero, hMu s' hs'' (x s')]
        exact (hsc γ ξ hact hl hdom hη hXa hXb s' hs'').1 (x s')
      have hg := norm_le_gronwallBound_of_norm_deriv_right_le hcont hder le_rfl hbd s hs
      rw [gronwallBound_ε0] at hg
      have hr := hratio w s hw0 hs.1 hs.2
      have hd0 : 0 ≤ s - w := by linarith [hs.1]
      have hdL : s - w ≤ Tgc * (lP : ℝ) ^ 2 := by linarith [hs.2]
      have hexp : Real.exp (Λ * (s - w)) ≤ Ks * Real.exp (-(Λ * (s - w))) := by
        rw [hKs, ← Real.exp_add]
        apply Real.exp_le_exp.2
        have := mul_le_mul_of_nonneg_left hdL hΛ0
        linarith
      calc ‖x s‖ ≤ ‖x w‖ * Real.exp (Λ * (s - w)) := hg
        _ ≤ ‖x w‖ * (Ks * Real.exp (-(Λ * (s - w)))) := mul_le_mul_of_nonneg_left hexp (norm_nonneg _)
        _ ≤ ‖x w‖ * (Ks * (Penv5 B G γ s / Penv5 B G γ w)) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hr hKs0.le) (norm_nonneg _)
        _ = Ks * (Penv5 B G γ s / Penv5 B G γ w) * ‖x w‖ := by ring
    · have hv1 : 1 + v ≤ 1 + Tgc * (lP : ℝ) ^ 2 := by linarith [hv.2]
      calc Ks * (1 + v) ≤ Ks * (1 + Tgc * (lP : ℝ) ^ 2) := mul_le_mul_of_nonneg_left hv1 hKs0.le
        _ = C1 := hC1.symm
        _ ≤ max C1 C2 := le_max_left _ _
        _ ≤ max C1 C2 * SC B.h ξ ^ (e / 2) :=
            le_mul_of_one_le_right (le_trans hC1n (le_max_left _ _)) hSCb1

theorem sqPart_profile_v5 : ∃ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ ∧ (∀ (μ : ℝ) (j : ℤ) (s : ℝ), sqPart μ j s = ψ (s / μ - j)) ∧ (∀ x : ℝ, 1 ≤ |x| → ψ x = 0) ∧ (∀ n : ℕ, ∃ K : ℝ, ∀ x : ℝ, ‖iteratedFDeriv ℝ n ψ x‖ ≤ K) ∧ (∀ x : ℝ, ψ x = 0 → ∀ n : ℕ, iteratedFDeriv ℝ n ψ x = 0) :=
by

  have hb1 : ContDiff ℝ ∞ bumpR := by
    show ContDiff ℝ ∞ (fun s : ℝ => Real.smoothTransition (1 - s ^ 2))
    exact Real.smoothTransition.contDiff.comp (contDiff_const.sub (contDiff_id.pow 2))
  have hb2 : ∀ y : ℝ, 1 ≤ |y| → bumpR y = 0 := by
    intro y hy
    show Real.smoothTransition (1 - y ^ 2) = 0
    apply Real.smoothTransition.zero_of_nonpos
    have : 1 ≤ y ^ 2 := by nlinarith [sq_abs y, abs_nonneg y]
    linarith
  have hb4 : ∀ y : ℝ, |y| < 1 → 0 < bumpR y := by
    intro y hy
    show 0 < Real.smoothTransition (1 - y ^ 2)
    apply Real.smoothTransition.pos_of_pos
    have : y ^ 2 < 1 := by nlinarith [sq_abs y, abs_nonneg y]
    linarith

  have hwin : ∀ x0 x : ℝ, |x - x0| < 1 → ∀ n : ℤ, n ∉ Finset.Icc (⌊x0⌋ - 1) (⌊x0⌋ + 2) →
      bumpR (x - n) ^ 2 = 0 := by
    intro x0 x hx n hn
    have h1 := Int.floor_le x0
    have h2 := Int.lt_floor_add_one x0
    rw [Finset.mem_Icc, not_and_or, not_le, not_le] at hn
    have hx' := abs_lt.mp hx
    suffices h : 1 ≤ |x - n| by rw [hb2 _ h]; ring
    rcases hn with hn | hn
    · have hc : (n : ℝ) ≤ (⌊x0⌋ : ℝ) - 2 := by
        have : n ≤ ⌊x0⌋ - 2 := by omega
        exact_mod_cast this
      rw [abs_of_pos (by linarith)]
      linarith
    · have hc : (⌊x0⌋ : ℝ) + 3 ≤ (n : ℝ) := by
        have : ⌊x0⌋ + 3 ≤ n := by omega
        exact_mod_cast this
      rw [abs_of_neg (by linarith)]
      linarith
  have hloc : ∀ x0 x : ℝ, |x - x0| < 1 → ∑' n : ℤ, bumpR (x - n) ^ 2 =
      ∑ n ∈ Finset.Icc (⌊x0⌋ - 1) (⌊x0⌋ + 2), bumpR (x - n) ^ 2 := by
    intro x0 x hx
    exact tsum_eq_sum (fun n hn => hwin x0 x hx n hn)
  have hSigC : ContDiff ℝ ∞ (fun x : ℝ => ∑' n : ℤ, bumpR (x - n) ^ 2) := by
    rw [contDiff_iff_contDiffAt]
    intro x0
    have hfin : ContDiff ℝ ∞ (fun x : ℝ =>
        ∑ n ∈ Finset.Icc (⌊x0⌋ - 1) (⌊x0⌋ + 2), bumpR (x - n) ^ 2) := by
      apply ContDiff.sum
      intro n _
      exact (hb1.comp (contDiff_id.sub (contDiff_const (c := (n : ℝ))))).pow 2
    apply hfin.contDiffAt.congr_of_eventuallyEq
    filter_upwards [Metric.ball_mem_nhds x0 one_pos] with x hx
    rw [Metric.mem_ball, Real.dist_eq] at hx
    exact hloc x0 x hx
  have hSigpos : ∀ x : ℝ, 0 < ∑' n : ℤ, bumpR (x - n) ^ 2 := by
    intro x
    have hsum : Summable (fun n : ℤ => bumpR (x - n) ^ 2) :=
      summable_of_ne_finset_zero (s := Finset.Icc (⌊x⌋ - 1) (⌊x⌋ + 2))
        (fun n hn => hwin x x (by simp) n hn)
    have hr : |x - (round x : ℝ)| < 1 := lt_of_le_of_lt (abs_sub_round x) (by norm_num)
    have hp : 0 < bumpR (x - round x) ^ 2 := pow_pos (hb4 _ hr) 2
    exact lt_of_lt_of_le hp (hsum.le_tsum (round x) (fun _ _ => sq_nonneg _))
  have hsqrtC : ContDiff ℝ ∞ (fun x : ℝ => Real.sqrt (∑' n : ℤ, bumpR (x - n) ^ 2)) :=
    hSigC.sqrt (fun x => (hSigpos x).ne')
  have hsqne : ∀ x : ℝ, Real.sqrt (∑' n : ℤ, bumpR (x - n) ^ 2) ≠ 0 := fun x =>
    (Real.sqrt_pos.mpr (hSigpos x)).ne'
  have hψC : ContDiff ℝ ∞ (fun x : ℝ => bumpR x / Real.sqrt (∑' n : ℤ, bumpR (x - n) ^ 2)) :=
    hb1.div hsqrtC hsqne

  have hid : ∀ (μ : ℝ) (j : ℤ) (s : ℝ), sqPart μ j s =
      (fun x : ℝ => bumpR x / Real.sqrt (∑' n : ℤ, bumpR (x - n) ^ 2)) (s / μ - j) := by
    intro μ j s
    have key : ∑' n : ℤ, bumpR (s / μ - n) ^ 2 = ∑' n : ℤ, bumpR (s / μ - j - n) ^ 2 := by
      rw [← (Equiv.addLeft j).tsum_eq (fun m : ℤ => bumpR (s / μ - m) ^ 2)]
      apply tsum_congr
      intro c
      simp only [Equiv.coe_addLeft, Int.cast_add, sub_add_eq_sub_sub]
    show bumpR (s / μ - j) / Real.sqrt (∑' n : ℤ, bumpR (s / μ - n) ^ 2) =
      bumpR (s / μ - j) / Real.sqrt (∑' n : ℤ, bumpR (s / μ - j - n) ^ 2)
    rw [key]

  have hsupp : ∀ x : ℝ, 1 ≤ |x| →
      (fun x : ℝ => bumpR x / Real.sqrt (∑' n : ℤ, bumpR (x - n) ^ 2)) x = 0 := by
    intro x hx
    show bumpR x / Real.sqrt (∑' n : ℤ, bumpR (x - n) ^ 2) = 0
    rw [hb2 x hx, zero_div]

  have hgen : ∀ φ : ℝ → ℝ, ContDiff ℝ ∞ φ → (∀ x : ℝ, 1 ≤ |x| → φ x = 0) →
      (∀ n : ℕ, ∃ K : ℝ, ∀ x : ℝ, ‖iteratedFDeriv ℝ n φ x‖ ≤ K) ∧
      (∀ x : ℝ, 1 ≤ |x| → ∀ n : ℕ, iteratedFDeriv ℝ n φ x = 0) := by
    intro φ hφ hzero
    have hcont : ∀ n : ℕ, Continuous (fun x => iteratedFDeriv ℝ n φ x) := fun n =>
      hφ.continuous_iteratedFDeriv (by exact_mod_cast le_top)
    have hcs : HasCompactSupport φ := by
      apply HasCompactSupport.intro (isCompact_Icc (a := (-1:ℝ)) (b := 1))
      intro x hx
      apply hzero
      rw [Set.mem_Icc, not_and_or, not_le, not_le] at hx
      rcases hx with hx | hx
      · rw [abs_of_neg (by linarith)]; linarith
      · rw [abs_of_pos (by linarith)]; linarith
    refine ⟨fun n => ?_, fun x hx n => ?_⟩
    · obtain ⟨K, hK⟩ := (hcont n).bounded_above_of_compact_support (hcs.iteratedFDeriv n)
      exact ⟨K, hK⟩
    · have hopen : ∀ y : ℝ, 1 < |y| → iteratedFDeriv ℝ n φ y = 0 := by
        intro y hy
        have hO : IsOpen {z : ℝ | 1 < |z|} := isOpen_lt continuous_const continuous_abs
        have hev : φ =ᶠ[nhds y] fun _ => (0:ℝ) :=
          Filter.eventuallyEq_of_mem (hO.mem_nhds hy) (fun z (hz : 1 < |z|) => hzero z hz.le)
        have e := (hev.iteratedFDeriv ℝ n).eq_of_nhds
        rw [e, iteratedFDeriv_fun_zero]
        try rfl
      have hZ : IsClosed {y : ℝ | iteratedFDeriv ℝ n φ y = 0} :=
        isClosed_eq (hcont n) continuous_const
      have ht : Filter.Tendsto (fun m : ℕ => (1 + 1 / ((m:ℝ) + 1)) * x) Filter.atTop (nhds x) := by
        have h1 := (tendsto_one_div_add_atTop_nhds_zero_nat).const_add (1:ℝ)
        have h2 := h1.mul_const x
        rw [add_zero, one_mul] at h2
        exact h2
      refine hZ.mem_of_tendsto ht (Filter.Eventually.of_forall fun m => ?_)
      have hm : (0:ℝ) < 1 / ((m:ℝ) + 1) := by positivity
      refine hopen _ ?_
      rw [abs_mul, abs_of_pos (by linarith : (0:ℝ) < 1 + 1 / ((m:ℝ)+1))]
      nlinarith [mul_pos hm (by linarith : (0:ℝ) < |x|)]
  obtain ⟨hK, hF⟩ := hgen _ hψC hsupp
  refine ⟨fun x => bumpR x / Real.sqrt (∑' n : ℤ, bumpR (x - n) ^ 2), hψC, hid, hsupp, hK, ?_⟩
  intro x hx n
  apply hF x _ n
  by_contra hlt
  push_neg at hlt
  have hp : 0 < bumpR x / Real.sqrt (∑' n : ℤ, bumpR (x - n) ^ 2) :=
    div_pos (hb4 x hlt) (Real.sqrt_pos.mpr (hSigpos x))
  exact hp.ne' hx

theorem flat_jet_v5 : ∀ (U : Set Cyl), IsOpen U → ∀ ξ ∈ U, (∀ (ψ : ℝ → ℝ) (a : Cyl → ℝ), ContDiff ℝ ∞ ψ → ContDiffOn ℝ ∞ a U → (∀ n : ℕ, iteratedFDeriv ℝ n ψ (a ξ) = 0) → ∀ n : ℕ, iteratedFDeriv ℝ n (fun η => ψ (a η)) ξ = 0) ∧ (∀ (f g : Cyl → ℝ), ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ g U → (∀ n : ℕ, iteratedFDeriv ℝ n f ξ = 0) → ∀ n : ℕ, iteratedFDeriv ℝ n (fun η => f η * g η) ξ = 0 ∧ iteratedFDeriv ℝ n (fun η => g η * f η) ξ = 0) :=
by
  intro U hU ξ hξ
  have hUD : UniqueDiffOn ℝ U := hU.uniqueDiffOn
  refine ⟨?_, ?_⟩
  · intro ψ a hψ ha hflat n
    have hle : (n : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
    set D : ℝ := 1 + ∑ j ∈ Finset.range (n + 1), ‖iteratedFDerivWithin ℝ j a U ξ‖ with hD
    have hD1 : 1 ≤ D := by
      have : 0 ≤ ∑ j ∈ Finset.range (n + 1), ‖iteratedFDerivWithin ℝ j a U ξ‖ :=
        Finset.sum_nonneg (fun j _ => norm_nonneg _)
      linarith
    have hbound := norm_iteratedFDerivWithin_comp_le (g := ψ) (f := a) (t := Set.univ) (s := U)
      (x := ξ) (n := n) hψ.contDiffOn ha hle uniqueDiffOn_univ hUD (fun _ _ => Set.mem_univ _) hξ
      (C := 0) (D := D)
      (fun i _ => by rw [iteratedFDerivWithin_univ, hflat i, norm_zero])
      (fun i hi1 hin => by
        have h1 : ‖iteratedFDerivWithin ℝ i a U ξ‖ ≤
            ∑ j ∈ Finset.range (n + 1), ‖iteratedFDerivWithin ℝ j a U ξ‖ :=
          Finset.single_le_sum (f := fun j => ‖iteratedFDerivWithin ℝ j a U ξ‖)
            (fun j _ => norm_nonneg _) (Finset.mem_range.mpr (by omega))
        have h2 : D ≤ D ^ i := le_self_pow₀ hD1 (by omega)
        linarith)
    rw [mul_zero, zero_mul] at hbound
    have h0 : iteratedFDerivWithin ℝ n (ψ ∘ a) U ξ = 0 := norm_le_zero_iff.mp hbound
    rw [← iteratedFDerivWithin_of_isOpen n hU hξ]
    exact h0
  · intro f g hf hg hflat n
    have hle : (n : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
    have key : ∀ i : ℕ, iteratedFDerivWithin ℝ i f U ξ = 0 := fun i => by
      rw [iteratedFDerivWithin_of_isOpen i hU hξ]; exact hflat i
    have hfg : iteratedFDeriv ℝ n (fun η => f η * g η) ξ = 0 := by
      have hb := norm_iteratedFDerivWithin_mul_le hf hg hUD hξ hle
      simp only [key, norm_zero, mul_zero, zero_mul, Finset.sum_const_zero] at hb
      rw [← iteratedFDerivWithin_of_isOpen n hU hξ]
      exact norm_le_zero_iff.mp hb
    refine ⟨hfg, ?_⟩
    have e : (fun η => g η * f η) = (fun η => f η * g η) := funext fun η => mul_comm _ _
    rw [e]
    exact hfg

theorem nb_comp_affine_v5 : ∀ (h : ℝ) (ψ : ℝ → ℝ) (lam : Cyl →L[ℝ] ℝ) (d : ℝ) (ξ : Cyl) (n : ℕ) (K c : ℝ), ContDiff ℝ ∞ ψ → (∀ x : ℝ, ‖iteratedFDeriv ℝ n ψ x‖ ≤ K) → 0 ≤ c → (∀ w : Cyl, |lam (Lnorm h ξ w)| ≤ c * ‖w‖) → NB h (fun η : Cyl => ψ (lam η + d)) n ξ ≤ K * c ^ n :=
by
  intro h ψ lam d ξ n K c hψ hK hc hlam
  have hg : ContDiff ℝ ∞ (fun y : ℝ => ψ (y + d)) := hψ.comp (contDiff_id.add contDiff_const)
  have hfun : (fun η : Cyl => ψ (lam η + d)) = (fun y : ℝ => ψ (y + d)) ∘ ⇑lam := rfl
  have h2 : iteratedFDeriv ℝ n (fun η : Cyl => ψ (lam η + d)) ξ =
      (iteratedFDeriv ℝ n (fun y : ℝ => ψ (y + d)) (lam ξ)).compContinuousLinearMap
        (fun _ => lam) := by
    rw [hfun]
    exact lam.iteratedFDeriv_comp_right hg ξ (by exact_mod_cast le_top)
  have h3 : iteratedFDeriv ℝ n (fun y : ℝ => ψ (y + d)) (lam ξ) =
      iteratedFDeriv ℝ n ψ (lam ξ + d) := iteratedFDeriv_comp_add_right n d (lam ξ)
  set M := iteratedFDeriv ℝ n ψ (lam ξ + d) with hM
  set T : Cyl →L[ℝ] ℝ := lam.comp (Lnorm h ξ) with hT
  have e : (M.compContinuousLinearMap (fun _ => lam)).compContinuousLinearMap
      (fun _ => Lnorm h ξ) = M.compContinuousLinearMap (fun _ => T) := by
    ext v
    rfl
  have h4 : NB h (fun η : Cyl => ψ (lam η + d)) n ξ =
      ‖M.compContinuousLinearMap (fun _ => T)‖ := by
    unfold NB
    rw [h2, h3, e]
  have h5 : ‖M.compContinuousLinearMap (fun _ => T)‖ ≤ ‖M‖ * ∏ _i : Fin n, ‖T‖ :=
    ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
  have h6 : ‖T‖ ≤ c := by
    refine ContinuousLinearMap.opNorm_le_bound _ hc (fun w => ?_)
    rw [hT, ContinuousLinearMap.comp_apply, Real.norm_eq_abs]
    exact hlam w
  have hprod : ∏ _i : Fin n, ‖T‖ = ‖T‖ ^ n := by
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  have hpow : ‖T‖ ^ n ≤ c ^ n := pow_le_pow_left₀ (norm_nonneg _) h6 n
  have hMK : ‖M‖ ≤ K := hK _
  rw [h4]
  refine h5.trans ?_
  rw [hprod]
  exact mul_le_mul hMK hpow (pow_nonneg (norm_nonneg _) n) ((norm_nonneg _).trans hMK)

theorem logq_factor_nb_v5 : ∀ (B : BG), B.ok → ∀ (ψ : ℝ → ℝ), ContDiff ℝ ∞ ψ → (∀ n : ℕ, ∃ K : ℝ, ∀ x : ℝ, ‖iteratedFDeriv ℝ n ψ x‖ ≤ K) → ∀ n : ℕ, ∃ M : ℝ, ∀ (c : ℝ), ∀ ξ ∈ DomC B.h B.qB, NB B.h (fun η : Cyl => ψ (Real.logb 2 (qC B.h η) + c)) n ξ ≤ M :=
by
  intro B hok ψ hψ hK n
  have hS : SimScaleProps B.h := hok.1
  obtain ⟨-, -, -, -, -, -, -, -, hqB1, -, -, -, -⟩ := hok.2.1

  have simN : ∀ h : ℝ, SimScaleProps h → SimNorm h := by
    intro h hS
    obtain ⟨hS1, -, -, -, hS5⟩ := hS
    open Pointwise in
    have hom : ∀ μ z τ : ℝ, 0 < μ →
        simScale h (μ ^ (1/2 - h) * z) (μ * τ) = μ * simScale h z τ := by
      intro μ z τ hμ
      have key : ∀ p : ℝ, 0 < p → μ * p - (μ ^ (1/2 - h) * z) ^ 2 * (μ * p) ^ (2 * h) =
          μ * (p - z ^ 2 * p ^ (2 * h)) := by
        intro p hp
        have sq : (μ ^ (1/2 - h)) ^ 2 = μ ^ (1 - 2 * h) := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul hμ.le]
          congr 1
          push_cast
          ring
        have split : μ ^ (1 - 2 * h) * μ ^ (2 * h) = μ := by
          rw [← Real.rpow_add hμ]
          have e : 1 - 2 * h + 2 * h = 1 := by ring
          rw [e, Real.rpow_one]
        rw [mul_pow, sq, Real.mul_rpow hμ.le hp.le]
        linear_combination (-(z ^ 2 * p ^ (2 * h))) * split
      have hset : {q : ℝ | 0 < q ∧ μ * τ ≤ q - (μ ^ (1/2 - h) * z) ^ 2 * q ^ (2 * h)} =
          μ • {p : ℝ | 0 < p ∧ τ ≤ p - z ^ 2 * p ^ (2 * h)} := by
        ext q
        rw [Set.mem_smul_set_iff_inv_smul_mem₀ hμ.ne', smul_eq_mul]
        simp only [Set.mem_setOf_eq]
        have hq : q = μ * (μ⁻¹ * q) := by field_simp
        constructor
        · rintro ⟨hq0, hle⟩
          have hp : 0 < μ⁻¹ * q := mul_pos (inv_pos.mpr hμ) hq0
          refine ⟨hp, ?_⟩
          rw [hq, key _ hp] at hle
          exact le_of_mul_le_mul_left hle hμ
        · rintro ⟨hp, hle⟩
          refine ⟨by rw [hq]; exact mul_pos hμ hp, ?_⟩
          rw [hq, key _ hp]
          exact mul_le_mul_of_nonneg_left hle hμ.le
      unfold simScale
      rw [hset, Real.sInf_smul_of_nonneg hμ.le, smul_eq_mul]
    intro k
    obtain ⟨C, hC⟩ : ∃ C : ℝ, ∀ Z T : ℝ, 0 < T → simScale h Z T = 1 →
        ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (Z, T)‖ ≤ C := by
      rcases Nat.eq_zero_or_pos k with hk | hk
      · subst hk
        refine ⟨1, fun Z T _ h1 => ?_⟩
        rw [norm_iteratedFDeriv_zero]
        show ‖simScale h Z T‖ ≤ 1
        rw [h1, norm_one]
      · obtain ⟨C, hC⟩ := hS5 k hk
        refine ⟨C, fun Z T hT h1 => ?_⟩
        have := hC Z T hT h1.le
        rwa [h1, Real.one_rpow, mul_one] at this
    refine ⟨C, fun z τ hτ _ => ?_⟩
    obtain ⟨hQ0, -⟩ := hS1 z τ hτ
    obtain ⟨Q, hQd⟩ : ∃ Q, Q = simScale h z τ := ⟨_, rfl⟩
    rw [← hQd] at hQ0 ⊢
    obtain ⟨Z, hZ⟩ : ∃ Z : ℝ, Z = Q ^ (-(1/2 - h)) * z := ⟨_, rfl⟩
    obtain ⟨T, hT⟩ : ∃ T : ℝ, T = Q⁻¹ * τ := ⟨_, rfl⟩
    have hT0 : 0 < T := by rw [hT]; exact mul_pos (inv_pos.mpr hQ0) hτ
    have hZT : simScale h Z T = 1 := by
      have := hom Q⁻¹ z τ (inv_pos.mpr hQ0)
      rw [Real.inv_rpow hQ0.le, ← Real.rpow_neg hQ0.le, ← hQd, inv_mul_cancel₀ hQ0.ne'] at this
      rw [hZ, hT]
      exact this
    have hzb : Q ^ (1/2 - h) * Z = z := by
      rw [hZ, ← mul_assoc, ← Real.rpow_add hQ0]
      simp
    have hτb : Q * T = τ := by
      rw [hT]
      exact mul_inv_cancel_left₀ hQ0.ne' τ
    have hpa : 0 < Q ^ (1/2 - h) := Real.rpow_pos_of_pos hQ0 _
    let e₁ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 (Q ^ (1/2 - h)) hpa.ne')
    let e₂ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 Q hQ0.ne')
    let L : (ℝ × ℝ) ≃L[ℝ] (ℝ × ℝ) := e₁.prodCongr e₂
    let M : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 Q hQ0.ne')
    have hL : ∀ x : ℝ × ℝ, L x = (Q ^ (1/2 - h) * x.1, Q * x.2) := by
      intro x
      simp [L, e₁, e₂, mul_comm]
    have hM : ∀ y : ℝ, M y = Q * y := by
      intro y
      simp [M, mul_comm]
    have hfun : (fun w : ℝ × ℝ => simScale h w.1 w.2) ∘ L =
        M ∘ (fun w : ℝ × ℝ => simScale h w.1 w.2) := by
      funext w
      simp only [Function.comp, hL, hM]
      exact hom Q w.1 w.2 hQ0
    have hLclm : (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)) =
        (Q ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap (Q • ContinuousLinearMap.id ℝ ℝ) := by
      apply ContinuousLinearMap.ext
      intro x
      apply Prod.ext
      · simp [hL]
      · simp [hL]
    have hLv : L (Z, T) = (z, τ) := by
      rw [hL]
      exact Prod.ext hzb hτb
    have hcomp : iteratedFDeriv ℝ k ((fun w : ℝ × ℝ => simScale h w.1 w.2) ∘ L) (Z, T) =
        (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (L (Z, T))).compContinuousLinearMap
          (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) := by
      have := L.iteratedFDerivWithin_comp_right (fun w : ℝ × ℝ => simScale h w.1 w.2)
        uniqueDiffOn_univ (mem_univ (L (Z, T))) k
      rwa [preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at this
    have key : (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, τ)).compContinuousLinearMap
          (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) =
        (M : ℝ →L[ℝ] ℝ).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (Z, T)) := by
      rw [← hLv, ← hcomp, hfun, M.iteratedFDeriv_comp_left]
    have hMn : ‖(M : ℝ →L[ℝ] ℝ)‖ ≤ Q := by
      refine ContinuousLinearMap.opNorm_le_bound _ hQ0.le fun y => ?_
      show ‖M y‖ ≤ Q * ‖y‖
      rw [hM, norm_mul, Real.norm_eq_abs Q, abs_of_pos hQ0]
    rw [← hLclm, key]
    calc _ ≤ ‖(M : ℝ →L[ℝ] ℝ)‖ *
            ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (Z, T)‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ Q * C := mul_le_mul hMn (hC Z T hT0 hZT) (norm_nonneg _) hQ0.le
      _ = C * Q := mul_comm _ _
  have hN := simN B.h hS
  unfold SimNorm at hN
  choose C hC using hN

  have key : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (F : E → G) (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  choose K hK' using hK
  obtain ⟨Kb, hKb⟩ : ∃ x : ℝ, x = ∑ j ∈ Finset.range (n + 1), |K j| := ⟨_, rfl⟩
  have hKb0 : 0 ≤ Kb := by rw [hKb]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
  have hKi : ∀ j, j ≤ n → K j ≤ Kb := fun j hj => by
    rw [hKb]
    exact (le_abs_self _).trans (Finset.single_le_sum (f := fun j => |K j|)
      (fun j _ => abs_nonneg _) (Finset.mem_range.mpr (by omega)))
  obtain ⟨D0, hD0⟩ : ∃ x : ℝ, x = 1 + ∑ j ∈ Finset.range (n + 1),
      ‖iteratedFDerivWithin ℝ j (fun x : ℝ => Real.logb 2 x) (Set.Ioi 0) 1‖ := ⟨_, rfl⟩
  have hD01 : 1 ≤ D0 := by
    have := Finset.sum_nonneg (fun j (_ : j ∈ Finset.range (n + 1)) =>
      norm_nonneg (iteratedFDerivWithin ℝ j (fun x : ℝ => Real.logb 2 x) (Set.Ioi 0) 1))
    rw [hD0]; linarith
  have hlog : ContDiffOn ℝ ∞ (fun x : ℝ => Real.logb 2 x) (Set.Ioi 0) :=
    (Real.contDiffOn_log.mono (fun x (hx : x ∈ Set.Ioi (0:ℝ)) =>
      Set.mem_compl_singleton_iff.mpr (ne_of_gt hx))).div_const (Real.log 2)
  have hGb : ∀ (c' : ℝ) (i : ℕ), i ≤ n →
      ‖iteratedFDerivWithin ℝ i (fun x : ℝ => ψ (Real.logb 2 x + c')) (Set.Ioi 0) 1‖ ≤
        (n.factorial : ℝ) * Kb * D0 ^ n := by
    intro c' i hi
    have hg : ContDiffOn ℝ ∞ (fun y : ℝ => ψ (y + c')) Set.univ :=
      (hψ.comp (contDiff_id.add contDiff_const)).contDiffOn
    have hCl : ∀ j ≤ i, ‖iteratedFDerivWithin ℝ j (fun y : ℝ => ψ (y + c')) Set.univ
        (Real.logb 2 1)‖ ≤ Kb := by
      intro j hj
      rw [iteratedFDerivWithin_univ, iteratedFDeriv_comp_add_right]
      exact (hK' j _).trans (hKi j (hj.trans hi))
    have hDl : ∀ j, 1 ≤ j → j ≤ i →
        ‖iteratedFDerivWithin ℝ j (fun x : ℝ => Real.logb 2 x) (Set.Ioi 0) 1‖ ≤ D0 ^ j := by
      intro j hj1 hji
      have h1 : ‖iteratedFDerivWithin ℝ j (fun x : ℝ => Real.logb 2 x) (Set.Ioi 0) 1‖ ≤
          ∑ k ∈ Finset.range (n + 1),
            ‖iteratedFDerivWithin ℝ k (fun x : ℝ => Real.logb 2 x) (Set.Ioi 0) 1‖ :=
        Finset.single_le_sum
          (f := fun k => ‖iteratedFDerivWithin ℝ k (fun x : ℝ => Real.logb 2 x) (Set.Ioi 0) 1‖)
          (fun k _ => norm_nonneg _) (Finset.mem_range.mpr (by omega))
      calc ‖iteratedFDerivWithin ℝ j (fun x : ℝ => Real.logb 2 x) (Set.Ioi 0) 1‖ ≤ D0 := by
            rw [hD0]; linarith
        _ ≤ D0 ^ j := le_self_pow₀ hD01 (by omega)
    have hF := norm_iteratedFDerivWithin_comp_le hg hlog (by exact_mod_cast le_top)
      uniqueDiffOn_univ isOpen_Ioi.uniqueDiffOn (Set.mapsTo_univ _ _)
      (Set.mem_Ioi.mpr (zero_lt_one' ℝ)) (C := Kb) (D := D0) hCl hDl
    have e : ((fun y : ℝ => ψ (y + c')) ∘ (fun x : ℝ => Real.logb 2 x)) =
        (fun x : ℝ => ψ (Real.logb 2 x + c')) := rfl
    rw [e] at hF
    refine hF.trans ?_
    have hf : (i.factorial : ℝ) ≤ n.factorial := by exact_mod_cast Nat.factorial_le hi
    have hp : D0 ^ i ≤ D0 ^ n := pow_le_pow_right₀ hD01 hi
    exact mul_le_mul (mul_le_mul_of_nonneg_right hf hKb0) hp (pow_nonneg (by linarith) i)
      (mul_nonneg (Nat.cast_nonneg _) hKb0)

  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = 1 + ∑ i ∈ Finset.range (n + 1), |C i| := ⟨_, rfl⟩
  have hD1 : 1 ≤ D := by
    have := Finset.sum_nonneg (fun k (_ : k ∈ Finset.range (n + 1)) => abs_nonneg (C k))
    rw [hDdef]; linarith
  refine ⟨(n.factorial : ℝ) * ((n.factorial : ℝ) * Kb * D0 ^ n) * D ^ n, ?_⟩
  intro c ξ hξD
  have hξD' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < B.qB := hξD
  have hξ : ξ.2.2.1 < 1 := hξD'.2.1
  have hq1 : qC B.h ξ ≤ 1 := le_trans hξD'.2.2.le hqB1

  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqpos : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
  have hU : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const

  obtain ⟨F, hFdef⟩ : ∃ F : Cyl → ℝ, F = fun η : Cyl => ψ (Real.logb 2 (qC B.h η) + c) :=
    ⟨_, rfl⟩
  suffices hmain : NB B.h F n ξ ≤
      (n.factorial : ℝ) * ((n.factorial : ℝ) * Kb * D0 ^ n) * D ^ n by
    rw [hFdef] at hmain; exact hmain
  have hFU : ContDiffOn ℝ ∞ F {η : Cyl | η.2.2.1 < 1} := by
    rw [hFdef]
    exact hψ.comp_contDiffOn (((hqC.log (fun η hη => (hqpos η hη).ne')).div_const
      (Real.log 2)).add contDiffOn_const)

  obtain ⟨Pm, hPmdef⟩ : ∃ Pm : Cyl →L[ℝ] ℝ × ℝ,
      Pm = ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
        (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))).prod
        (-((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))))) := ⟨_, rfl⟩
  have hPapp : ∀ η : Cyl, Pm η = (η.2.1, -η.2.2.1) := by
    intro η; rw [hPmdef]; simp
  have hP1 : ‖Pm‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
    rw [hPapp η, one_mul, Prod.norm_def (η.2.1, -η.2.2.1)]
    refine max_le ?_ ?_
    · exact (norm_fst_le η.2).trans (norm_snd_le η)
    · exact (norm_neg η.2.2.1).trans_le
        (((norm_fst_le η.2.2).trans (norm_snd_le η.2)).trans (norm_snd_le η))
  obtain ⟨Mq, hMqdef⟩ : ∃ Mq : ℝ × ℝ →L[ℝ] ℝ × ℝ,
      Mq = (qC B.h ξ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
        (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ) := ⟨_, rfl⟩
  obtain ⟨T, hTdef⟩ : ∃ T : Cyl →L[ℝ] ℝ × ℝ, T = Mq.comp Pm := ⟨_, rfl⟩
  obtain ⟨w0, hw0def⟩ : ∃ w0 : ℝ × ℝ, w0 = (ξ.2.1, 1 - ξ.2.2.1) := ⟨_, rfl⟩
  have hW : IsOpen (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
  have hw0 : w0 ∈ (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := by
    rw [hw0def]; exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩

  have hid : ∀ v : Cyl, qC B.h (ξ + Lnorm B.h ξ v) = simScale B.h (w0 + T v).1 (w0 + T v).2 := by
    intro v
    have e1 : (Lnorm B.h ξ v).2.1 = qC B.h ξ ^ (1/2 - B.h) * v.2.1 := by
      simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e2 : (Lnorm B.h ξ v).2.2.1 = qC B.h ξ * v.2.2.1 := by
      simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e3 : T v = (qC B.h ξ ^ (1/2 - B.h) * v.2.1, qC B.h ξ * (-v.2.2.1)) := by
      rw [hTdef, ContinuousLinearMap.comp_apply, hPapp v, hMqdef]
      simp [ContinuousLinearMap.coe_prodMap']
    rw [e3, hw0def]
    show simScale B.h (ξ.2.1 + (Lnorm B.h ξ v).2.1) (1 - (ξ.2.2.1 + (Lnorm B.h ξ v).2.2.1)) =
      simScale B.h (ξ.2.1 + qC B.h ξ ^ (1/2 - B.h) * v.2.1) ((1 - ξ.2.2.1) + qC B.h ξ * (-v.2.2.1))
    rw [e1, e2]
    congr 1
    ring

  obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = {v : Cyl | (ξ + Lnorm B.h ξ v).2.2.1 < 1} := ⟨_, rfl⟩
  have hOmem : ∀ v, v ∈ O ↔ (ξ + Lnorm B.h ξ v).2.2.1 < 1 := by
    intro v; rw [hOdef]; rfl
  have hcontO : Continuous (fun v : Cyl => (ξ + Lnorm B.h ξ v).2.2.1) :=
    ((continuous_const.add (Lnorm B.h ξ).continuous).snd.snd.fst)
  have hO : IsOpen O := by rw [hOdef]; exact isOpen_lt hcontO continuous_const
  have h0O : (0 : Cyl) ∈ O := by
    rw [hOmem, map_zero, add_zero]; exact hξ
  obtain ⟨R, hRdef⟩ : ∃ R : Cyl → ℝ, R = fun v => qC B.h (ξ + Lnorm B.h ξ v) / qC B.h ξ :=
    ⟨_, rfl⟩
  have hR : ContDiffOn ℝ ∞ R O := by
    rw [hRdef]
    exact (hqC.comp (contDiff_const.add (Lnorm B.h ξ).contDiff).contDiffOn
      (fun v hv => (hOmem v).1 hv)).div_const _
  have hRpos : ∀ v ∈ O, 0 < R v := by
    intro v hv; rw [hRdef]; exact div_pos (hqpos _ ((hOmem v).1 hv)) hq0
  have hR0 : R 0 = 1 := by
    rw [hRdef]
    show qC B.h (ξ + Lnorm B.h ξ 0) / qC B.h ξ = 1
    rw [map_zero, add_zero]; exact div_self hq0.ne'
  have hReq : R = (qC B.h ξ)⁻¹ • (fun z : Cyl => simScale B.h (w0 + T z).1 (w0 + T z).2) := by
    rw [hRdef]; funext v
    show qC B.h (ξ + Lnorm B.h ξ v) / qC B.h ξ =
      (qC B.h ξ)⁻¹ * simScale B.h (w0 + T v).1 (w0 + T v).2
    rw [hid v, div_eq_inv_mul]
  have hΦ : ContDiffAt ℝ ∞ (fun z : Cyl => simScale B.h (w0 + T z).1 (w0 + T z).2) 0 := by
    have h1 : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (w0 + T 0) := by
      rw [map_zero, add_zero]; exact hS.2.2.2.1.contDiffAt (hW.mem_nhds hw0)
    exact ContDiffAt.comp (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2) (f := fun z : Cyl => w0 + T z)
      (0 : Cyl) h1 (contDiff_const.add T.contDiff).contDiffAt

  have hDR : ∀ i : ℕ, 1 ≤ i → i ≤ n → ‖iteratedFDerivWithin ℝ i R O 0‖ ≤ D ^ i := by
    intro i hi1 hij
    have hcomp : (iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq.comp Pm) =
        ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm) := by
      ext m; rfl
    have hCi : ‖(iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq)‖ ≤ C i * qC B.h ξ := by
      rw [hMqdef, hw0def]; exact hC i ξ.2.1 (1 - ξ.2.2.1) (by linarith) hq1
    have hprod : ∏ k : Fin i, ‖Pm‖ ≤ 1 := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_one₀ (norm_nonneg _) hP1
    have hb1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
      ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq)) (fun _ : Fin i => Pm)
    have hb2 := hb1.trans ((mul_le_of_le_one_right (norm_nonneg _) hprod).trans hCi)
    have hCiD : C i ≤ D := by
      have h2 : |C i| ≤ ∑ k ∈ Finset.range (n + 1), |C k| :=
        Finset.single_le_sum (f := fun k => |C k|) (fun k _ => abs_nonneg _)
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hij))
      have h3 := le_abs_self (C i)
      rw [hDdef]; linarith
    rw [iteratedFDerivWithin_of_isOpen i hO h0O, hReq,
      iteratedFDeriv_const_smul_apply (hΦ.of_le (by exact_mod_cast le_top)),
      key (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) w0 T hW hS.2.2.2.1 hw0 i,
      norm_smul, hTdef, hcomp, Real.norm_of_nonneg (inv_nonneg.mpr hq0.le)]
    calc (qC B.h ξ)⁻¹ * ‖((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm)‖
        ≤ (qC B.h ξ)⁻¹ * (C i * qC B.h ξ) :=
          mul_le_mul_of_nonneg_left hb2 (inv_nonneg.mpr hq0.le)
      _ = C i := by rw [mul_comm (C i), ← mul_assoc, inv_mul_cancel₀ hq0.ne', one_mul]
      _ ≤ D := hCiD
      _ ≤ D ^ i := le_self_pow₀ hD1 (by omega)

  have hg : ContDiffOn ℝ ∞ (fun x : ℝ => ψ (Real.logb 2 x + (Real.logb 2 (qC B.h ξ) + c)))
      (Set.Ioi 0) := hψ.comp_contDiffOn (hlog.add contDiffOn_const)
  have hRmaps : Set.MapsTo R O (Set.Ioi 0) := fun v hv => hRpos v hv
  have hEq : Set.EqOn (fun z => F (ξ + Lnorm B.h ξ z))
      ((fun x : ℝ => ψ (Real.logb 2 x + (Real.logb 2 (qC B.h ξ) + c))) ∘ R) O := by
    intro z hz
    have hRz := hRpos z hz
    have e : qC B.h (ξ + Lnorm B.h ξ z) = qC B.h ξ * R z := by
      rw [hRdef]
      show _ = qC B.h ξ * (qC B.h (ξ + Lnorm B.h ξ z) / qC B.h ξ)
      field_simp
    show F (ξ + Lnorm B.h ξ z) = ψ (Real.logb 2 (R z) + (Real.logb 2 (qC B.h ξ) + c))
    rw [hFdef]
    show ψ (Real.logb 2 (qC B.h (ξ + Lnorm B.h ξ z)) + c) =
      ψ (Real.logb 2 (R z) + (Real.logb 2 (qC B.h ξ) + c))
    rw [e, Real.logb_mul hq0.ne' hRz.ne']
    congr 1
    ring

  have hCg : ∀ i ≤ n, ‖iteratedFDerivWithin ℝ i
      (fun x : ℝ => ψ (Real.logb 2 x + (Real.logb 2 (qC B.h ξ) + c))) (Set.Ioi 0) (R 0)‖ ≤
        (n.factorial : ℝ) * Kb * D0 ^ n := by
    intro i hi
    rw [hR0]
    exact hGb _ i hi
  have hFdB := norm_iteratedFDerivWithin_comp_le hg hR (by exact_mod_cast le_top)
    isOpen_Ioi.uniqueDiffOn hO.uniqueDiffOn hRmaps h0O
    (C := (n.factorial : ℝ) * Kb * D0 ^ n) (D := D) hCg hDR
  have hNB : NB B.h F n ξ = ‖iteratedFDeriv ℝ n (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := by
    unfold NB
    rw [key F {η : Cyl | η.2.2.1 < 1} ξ (Lnorm B.h ξ) hU hFU hξ n]
  calc NB B.h F n ξ = ‖iteratedFDeriv ℝ n (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := hNB
    _ = ‖iteratedFDerivWithin ℝ n (fun z => F (ξ + Lnorm B.h ξ z)) O 0‖ := by
        rw [iteratedFDerivWithin_of_isOpen n hO h0O]
    _ = ‖iteratedFDerivWithin ℝ n
          ((fun x : ℝ => ψ (Real.logb 2 x + (Real.logb 2 (qC B.h ξ) + c))) ∘ R) O 0‖ := by
        rw [iteratedFDerivWithin_congr hEq h0O n]
    _ ≤ _ := hFdB

theorem etaL_class_v5 : ∀ (B : BG), B.ok → (∀ γ : Lab, ContDiffOn ℝ ∞ (etaL B.h γ) (DomC B.h B.qB)) ∧ (∀ (γ : Lab), ∀ ξ ∈ DomC B.h B.qB, etaL B.h γ ξ = 0 → ∀ k : ℕ, iteratedFDeriv ℝ k (etaL B.h γ) ξ = 0) ∧ (∀ (γ : Lab) (ξ : Cyl) (a : ℝ × ℝ), etaL B.h γ (shY ξ a) = etaL B.h γ ξ) ∧ ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (ξ : Cyl), 1 ≤ γ.1 → ξ ∈ DomC B.h B.qB → etaL B.h γ ξ ≠ 0 → NB B.h (etaL B.h γ) k ξ ≤ C * SC B.h ξ ^ b :=
by
  intro B hok
  obtain ⟨ψ, hψ, hid, hsupp, hK, hflat⟩ := sqPart_profile_v5
  have hS := hok.1
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, hqB1, -, -, -, -⟩ := hok.2.1

  obtain ⟨V, hV⟩ : ∃ V : Set Cyl, V = {η : Cyl | η.2.2.1 < 1} := ⟨_, rfl⟩
  have hVo : IsOpen V := by
    rw [hV]
    exact isOpen_lt (continuous_fst.comp (continuous_snd.comp continuous_snd)) continuous_const
  have hDV : DomC B.h B.qB ⊆ V := by
    intro ξ hξ
    rw [hV]
    exact hξ.2.1
  have hqpos : ∀ η ∈ V, 0 < qC B.h η := by
    intro η hη
    rw [hV] at hη
    have hη' : η.2.2.1 < 1 := hη
    exact (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hqC : ContDiffOn ℝ ∞ (qC B.h) V := by
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => (η.2.1, 1 - η.2.2.1)) :=
      contDiff_snd.fst.prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    have := hS.2.2.2.1.comp (h2.contDiffOn (s := V)) (fun η hη => by
      rw [hV] at hη
      have hη' : η.2.2.1 < 1 := hη
      exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - η.2.2.1 by linarith⟩)
    exact this
  have hlogV : ∀ c : ℝ, ContDiffOn ℝ ∞ (fun η : Cyl => Real.logb 2 (qC B.h η) + c) V := by
    intro c
    refine ContDiffOn.add ?_ contDiffOn_const
    exact (hqC.log (fun η hη => (hqpos η hη).ne')).div_const (Real.log 2)

  obtain ⟨lam2, hlam2⟩ : ∃ f : Lab → Cyl →L[ℝ] ℝ, ∀ (γ : Lab) (η : Cyl),
      f γ η = (Sb γ.1 ^ (-3:ℤ))⁻¹ * (Real.sqrt (Qb γ.1))⁻¹ * η.1 :=
    ⟨fun γ => ((Sb γ.1 ^ (-3:ℤ))⁻¹ * (Real.sqrt (Qb γ.1))⁻¹) •
      ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)), fun γ η => rfl⟩
  obtain ⟨lam3, hlam3⟩ : ∃ f : Lab → Cyl →L[ℝ] ℝ, ∀ (γ : Lab) (η : Cyl),
      f γ η = (Sb γ.1 ^ (-3:ℤ))⁻¹ * (Qb γ.1 ^ (1/2 - B.h))⁻¹ * η.2.1 :=
    ⟨fun γ => ((Sb γ.1 ^ (-3:ℤ))⁻¹ * (Qb γ.1 ^ (1/2 - B.h))⁻¹) •
      ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
        (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))), fun γ η => rfl⟩
  obtain ⟨lam4, hlam4⟩ : ∃ f : Lab → Cyl →L[ℝ] ℝ, ∀ (γ : Lab) (η : Cyl),
      f γ η = -((Sb γ.1 ^ (-3:ℤ))⁻¹ * (Qb γ.1)⁻¹) * η.2.2.1 :=
    ⟨fun γ => (-((Sb γ.1 ^ (-3:ℤ))⁻¹ * (Qb γ.1)⁻¹)) •
      ((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp
        ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))))), fun γ η => rfl⟩
  obtain ⟨d2, hd2⟩ : ∃ d : Lab → ℝ, ∀ γ : Lab, d γ = -(γ.2.1.1 : ℝ) :=
    ⟨fun γ => -(γ.2.1.1 : ℝ), fun γ => rfl⟩
  obtain ⟨d3, hd3⟩ : ∃ d : Lab → ℝ, ∀ γ : Lab, d γ = -(γ.2.1.2.1 : ℝ) :=
    ⟨fun γ => -(γ.2.1.2.1 : ℝ), fun γ => rfl⟩
  obtain ⟨d4, hd4⟩ : ∃ d : Lab → ℝ, ∀ γ : Lab,
      d γ = (Sb γ.1 ^ (-3:ℤ))⁻¹ * (Qb γ.1)⁻¹ - (γ.2.1.2.2 : ℝ) :=
    ⟨fun γ => (Sb γ.1 ^ (-3:ℤ))⁻¹ * (Qb γ.1)⁻¹ - (γ.2.1.2.2 : ℝ), fun γ => rfl⟩

  have hfac : ∀ γ : Lab, etaL B.h γ = fun η => ψ (Real.logb 2 (qC B.h η) + (γ.1:ℝ)) *
      (ψ (lam2 γ η + d2 γ) * ψ (lam3 γ η + d3 γ) * ψ (lam4 γ η + d4 γ)) := by
    intro γ
    funext η
    show sqPart 1 (-(γ.1:ℤ)) (Real.logb 2 (qC B.h η)) *
      (sqPart (Sb γ.1 ^ (-3:ℤ)) γ.2.1.1 (η.1 / Real.sqrt (Qb γ.1)) *
        sqPart (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.1 (η.2.1 / Qb γ.1 ^ (1/2 - B.h)) *
        sqPart (Sb γ.1 ^ (-3:ℤ)) γ.2.1.2.2 ((1 - η.2.2.1) / Qb γ.1)) = _
    rw [hid, hid, hid, hid, hlam2, hlam3, hlam4, hd2, hd3, hd4]
    refine congrArg₂ (· * ·) (congrArg ψ ?_)
      (congrArg₂ (· * ·) (congrArg₂ (· * ·) (congrArg ψ ?_) (congrArg ψ ?_)) (congrArg ψ ?_))
    · push_cast; ring
    · ring
    · ring
    · ring

  have hF1 : ∀ γ : Lab, ContDiffOn ℝ ∞ (fun η : Cyl => ψ (Real.logb 2 (qC B.h η) + (γ.1:ℝ))) V :=
    fun γ => hψ.comp_contDiffOn (hlogV (γ.1:ℝ))
  have hF2 : ∀ γ : Lab, ContDiff ℝ ∞ (fun η : Cyl => ψ (lam2 γ η + d2 γ)) :=
    fun γ => hψ.comp ((lam2 γ).contDiff.add contDiff_const)
  have hF3 : ∀ γ : Lab, ContDiff ℝ ∞ (fun η : Cyl => ψ (lam3 γ η + d3 γ)) :=
    fun γ => hψ.comp ((lam3 γ).contDiff.add contDiff_const)
  have hF4 : ∀ γ : Lab, ContDiff ℝ ∞ (fun η : Cyl => ψ (lam4 γ η + d4 γ)) :=
    fun γ => hψ.comp ((lam4 γ).contDiff.add contDiff_const)
  have hcoef : ∀ (a x c : ℝ) (w : Cyl), 0 ≤ a → a ≤ c → |x| ≤ ‖w‖ → |a * x| ≤ c * ‖w‖ := by
    intro a x c w ha hac hx
    rw [abs_mul, abs_of_nonneg ha]
    exact mul_le_mul hac hx (abs_nonneg _) (ha.trans hac)
  have hm6 : ∀ γ : Lab, (Sb γ.1 ^ (-3:ℤ))⁻¹ = (γ.1:ℝ) ^ 6 := by
    intro γ
    have e : ((γ.1:ℝ) ^ 2) ^ (3:ℤ) = (γ.1:ℝ) ^ 6 := by
      rw [show (3:ℤ) = ((3:ℕ):ℤ) from rfl, zpow_natCast, ← pow_mul]
    rw [Sb, zpow_neg, inv_inv, e]
  refine ⟨?_, ?_, ?_, ?_⟩
  ·
    intro γ
    rw [hfac γ]
    exact ((hF1 γ).mul ((((hF2 γ).mul (hF3 γ)).mul (hF4 γ)).contDiffOn)).mono hDV
  ·
    intro γ ξ hξ h0 k
    have hξV := hDV hξ
    have fl := flat_jet_v5 V hVo ξ hξV
    have h0' : ψ (Real.logb 2 (qC B.h ξ) + (γ.1:ℝ)) *
        (ψ (lam2 γ ξ + d2 γ) * ψ (lam3 γ ξ + d3 γ) * ψ (lam4 γ ξ + d4 γ)) = 0 := by
      rw [hfac γ] at h0
      exact h0
    rw [hfac γ]
    have c1 := hF1 γ
    have c2 : ContDiffOn ℝ ∞ (fun η : Cyl => ψ (lam2 γ η + d2 γ)) V := (hF2 γ).contDiffOn
    have c3 : ContDiffOn ℝ ∞ (fun η : Cyl => ψ (lam3 γ η + d3 γ)) V := (hF3 γ).contDiffOn
    have c4 : ContDiffOn ℝ ∞ (fun η : Cyl => ψ (lam4 γ η + d4 γ)) V := (hF4 γ).contDiffOn
    have c23 := c2.mul c3
    have c234 := c23.mul c4
    have flA : ∀ (lam : Cyl →L[ℝ] ℝ) (d : ℝ), ψ (lam ξ + d) = 0 →
        ∀ n : ℕ, iteratedFDeriv ℝ n (fun η : Cyl => ψ (lam η + d)) ξ = 0 :=
      fun lam d hz => fl.1 ψ (fun η => lam η + d) hψ (lam.contDiff.add contDiff_const).contDiffOn
        (hflat _ hz)
    have fin234 : (∀ n : ℕ, iteratedFDeriv ℝ n (fun η : Cyl =>
        ψ (lam2 γ η + d2 γ) * ψ (lam3 γ η + d3 γ) * ψ (lam4 γ η + d4 γ)) ξ = 0) →
        iteratedFDeriv ℝ k (fun η : Cyl => ψ (Real.logb 2 (qC B.h η) + (γ.1:ℝ)) *
          (ψ (lam2 γ η + d2 γ) * ψ (lam3 γ η + d3 γ) * ψ (lam4 γ η + d4 γ))) ξ = 0 :=
      fun hfl => (fl.2 _ _ c234 c1 hfl k).2
