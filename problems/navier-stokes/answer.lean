theorem ax_real_series : ∀ (B : ℝ) (b : ℕ → ℝ), (∀ n : ℕ, |b n| ≤ B * (1 / 10) ^ n) → ∀ y : ℝ, |y| < 5 → Summable (fun n : ℕ => b n * y ^ n) ∧ Summable (fun n : ℕ => (n : ℝ) * b n * y ^ (n - 1)) ∧ HasDerivAt (fun x : ℝ => ∑' n : ℕ, b n * x ^ n) (∑' n : ℕ, (n : ℝ) * b n * y ^ (n - 1)) y ∧ |∑' n : ℕ, b n * y ^ n| ≤ 2 * B ∧ |∑' n : ℕ, (n : ℝ) * b n * y ^ (n - 1)| ≤ B :=
by
  intro B b hb y hy
  have hB : 0 ≤ B := by
    have h0 := hb 0
    rw [pow_zero, mul_one] at h0
    linarith [abs_nonneg (b 0)]
  have hval : ∀ x : ℝ, |x| ≤ 5 → ∀ n : ℕ, ‖b n * x ^ n‖ ≤ B * (1 / 2 : ℝ) ^ n := by
    intro x hx n
    rw [Real.norm_eq_abs, abs_mul, abs_pow]
    have h1 : |x| ^ n ≤ (5 : ℝ) ^ n := pow_le_pow_left₀ (abs_nonneg x) hx n
    have h2 : 0 ≤ B * (1 / 10 : ℝ) ^ n := by positivity
    calc |b n| * |x| ^ n ≤ B * (1 / 10 : ℝ) ^ n * 5 ^ n :=
          mul_le_mul (hb n) h1 (by positivity) h2
      _ = B * (1 / 2 : ℝ) ^ n := by rw [mul_assoc, ← mul_pow]; norm_num
  have hder : ∀ x : ℝ, |x| ≤ 5 → ∀ n : ℕ,
      ‖(n : ℝ) * b n * x ^ (n - 1)‖ ≤ B / 5 * ((n : ℝ) * (1 / 2 : ℝ) ^ n) := by
    intro x hx n
    cases n with
    | zero => simp
    | succ k =>
      simp only [Nat.add_sub_cancel]
      push_cast
      rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_pow,
        abs_of_nonneg (by positivity : (0 : ℝ) ≤ (k : ℝ) + 1)]
      have h1 : |x| ^ k ≤ (5 : ℝ) ^ k := pow_le_pow_left₀ (abs_nonneg x) hx k
      have h2 : |b (k + 1)| * |x| ^ k ≤ B * (1 / 10 : ℝ) ^ (k + 1) * 5 ^ k :=
        mul_le_mul (hb (k + 1)) h1 (by positivity) (by positivity)
      have h4 : (1 / 10 : ℝ) ^ k * 5 ^ k = (1 / 2 : ℝ) ^ k := by
        rw [← mul_pow]; norm_num
      have h3 : B * (1 / 10 : ℝ) ^ (k + 1) * 5 ^ k = B / 5 * (1 / 2 : ℝ) ^ (k + 1) := by
        rw [pow_succ, pow_succ]
        linear_combination (B / 10) * h4
      have hk : (0 : ℝ) ≤ (k : ℝ) + 1 := by positivity
      calc ((k : ℝ) + 1) * |b (k + 1)| * |x| ^ k = ((k : ℝ) + 1) * (|b (k + 1)| * |x| ^ k) := by
            ring
        _ ≤ ((k : ℝ) + 1) * (B / 5 * (1 / 2 : ℝ) ^ (k + 1)) :=
            mul_le_mul_of_nonneg_left (h2.trans h3.le) hk
        _ = B / 5 * (((k : ℝ) + 1) * (1 / 2 : ℝ) ^ (k + 1)) := by ring
  have hg : HasSum (fun n : ℕ => B * (1 / 2 : ℝ) ^ n) (B * 2) := by
    have := (hasSum_geometric_of_lt_one (r := (1 / 2 : ℝ)) (by norm_num) (by norm_num)).mul_left B
    convert this using 1
    norm_num
  have hu : HasSum (fun n : ℕ => B / 5 * ((n : ℝ) * (1 / 2 : ℝ) ^ n)) (B / 5 * 2) := by
    have := (hasSum_coe_mul_geometric_of_norm_lt_one (r := (1 / 2 : ℝ)) (by norm_num)).mul_left (B / 5)
    convert this using 1
    norm_num
  have hyt : y ∈ Set.Ioo (-5 : ℝ) 5 := ⟨(abs_lt.mp hy).1, (abs_lt.mp hy).2⟩
  have hle : ∀ x ∈ Set.Ioo (-5 : ℝ) 5, |x| ≤ 5 := fun x hx => (abs_lt.mpr ⟨hx.1, hx.2⟩).le
  have hy5 : |y| ≤ 5 := hy.le
  have V1 : Summable (fun n : ℕ => b n * y ^ n) :=
