  obtain ⟨P1, hP1⟩ : ∃ f : Cyl → ℝ, f = fun η => Ut0 η * Rt η := ⟨_, rfl⟩
  obtain ⟨P2, hP2⟩ : ∃ f : Cyl → ℝ, f = fun η => Ut2 η * Zt η := ⟨_, rfl⟩
  obtain ⟨Y, hY⟩ : ∃ f : Cyl → ℝ, f = fun η => 1 * P1 η + Qb γ.1 ^ (-B.h) * P2 η := ⟨_, rfl⟩
  obtain ⟨X, hX⟩ : ∃ f : Cyl → ℝ, f = fun η => 1 * Tt η + 1 * Y η := ⟨_, rfl⟩
  obtain ⟨W, hW⟩ : ∃ f : Cyl → ℝ, f = fun η => va η * X η := ⟨_, rfl⟩
  obtain ⟨K0, hK0⟩ : ∃ K : ℝ, K = sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 := ⟨_, rfl⟩
  obtain ⟨Br, hBr⟩ : ∃ f : Cyl → ℝ, f = fun η => K0 * Ut0 η + (-1) * W η := ⟨_, rfl⟩

  have hvaS : ContDiff ℝ ∞ va := by rw [hva]; unfold lamT; fun_prop
  have hUt0s : ContDiffOn ℝ ∞ Ut0 U := by
    rw [hUt0]; exact contDiffOn_const.mul (hU0s.mono hUsubB)
  have hUt2s : ContDiffOn ℝ ∞ Ut2 U := by
