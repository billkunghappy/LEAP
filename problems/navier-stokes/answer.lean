        have := abs_le.mp hD
        rw [abs_le]; constructor <;> linarith
      have e2 : deriv (fun e => U0 y e) η * U0 y η + U0 y η * deriv (fun e => U0 y e) η
            - 16 * (1 * η + η * 1) =
          2 * ((U0 y η - 4 * η) * deriv (fun e => U0 y e) η) +
            8 * (η * (deriv (fun e => U0 y e) η - 4)) := by ring
      rw [e2]
      have t1 : |2 * ((U0 y η - 4 * η) * deriv (fun e => U0 y e) η)| =
          2 * (|U0 y η - 4 * η| * |deriv (fun e => U0 y e) η|) := by
        rw [abs_mul, abs_mul, abs_two]
      have t2 : |8 * (η * (deriv (fun e => U0 y e) η - 4))| =
          8 * (|η| * |deriv (fun e => U0 y e) η - 4|) := by
        rw [abs_mul, abs_mul]; norm_num
      have m1 := mul_le_mul ha hD5 (abs_nonneg _) hε0
      have m2 := mul_le_mul hη hD (abs_nonneg _) zero_le_one
