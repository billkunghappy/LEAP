      _ ≤ R ^ (1:ℝ) := Real.rpow_le_rpow_of_exponent_le hR (by linarith)
      _ = R := Real.rpow_one R
  have h2i : (2:ℝ) ^ i ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hi
  calc sJet5 (fun x => Bil (Qp x) ((T0p ∘ w) x)) (ξ.1, ξ.2.1, ξ.2.2.1) (DqS5 B.h ξ) i
