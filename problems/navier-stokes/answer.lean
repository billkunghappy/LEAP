theorem outer_core_construction : ∀ ρ0 ε0 X0 : ℝ → ℝ, (∀ h, 0 < ρ0 h ∧ 0 < ε0 h ∧ 0 < X0 h) → ∃ (h lam Pst Rst : ℝ) (c ϑ : ℝ → ℝ), 0 < h ∧ h < 1 / 100 ∧ 0 < lam ∧ Real.exp 10 < Pst ∧ 0 < Rst ∧ ShapeData Pst c ϑ ∧ ∀ XR : ℝ, Rst ≤ XR → ∃ (cpatch cinf ρ Xg Xg2 r1 r2 p1 p2 m1 m2 Xv Xc Xb : ℝ) (Fo Uo : ℝ → ℝ → ℝ), 0 < ρ ∧ ρ ≤ ρ0 h ∧ X0 h ≤ Xb ∧ Xb * Real.exp (-(5 / 2)) < Xc ∧ (0 < cpatch ∧ 0 < cinf ∧ 0 < XR ∧ XR < Xg ∧ Xg < Xg2 ∧ Xg2 < r1 ∧ r1 < r2 ∧ r2 < p1 ∧ p1 < p2 ∧ p2 < m1 ∧ m1 < m2 ∧ m2 < Xv ∧ Xv < Xc ∧ Xc < Xb) ∧ (∀ X₀ X₁ : ℝ, 0 < X₀ → ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, X₀ ≤ X → X ≤ X₁ → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿Fo) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿Uo) (X, η)‖ ≤ C) ∧ (∀ X η : ℝ, 0 < X → X ≤ XR → -1 < η → η < 1 → Uo X η = 4 * η ∧ Fo X η = refFin Pst XR X η) ∧ (∀ X η : ℝ, ((r1 ≤ X ∧ X ≤ r2) ∨ (p1 ≤ X ∧ X ≤ p2) ∨ (m1 ≤ X ∧ X ≤ m2)) → -1 < η → η < 1 → Uo X η = 0 ∧ Real.sqrt (2 * X) * Fo X η = cpatch * (1 + η ^ 2)⁻¹ * X ^ (-(1 / 2 + lam))) ∧ (∀ X η : ℝ, Xv ≤ X → -1 < η → η < 1 → Uo X η = 0 ∧ profRadInt Uo X η = 0) ∧ (∀ η : ℝ, -1 < η → η < 1 → leadPi Fo 0 η = shapeDatum c ϑ η) ∧ TailForm h cinf ρ Xb Fo Uo ∧ (∀ X η : ℝ, Xb * Real.exp (-(11 / 4)) ≤ X → X < Xb → -1 < η → η < 1 → Real.sqrt (2 * X) * Fo X η ≤ ε0 h) ∧ (∀ m : ℕ, ∃ C : ℝ, ∀ x η : ℝ, 0 < x → -1 < η → η < 1 → |iteratedDeriv m (fun e => Fo x e) η| ≤ C * x ^ (-(2 / 5 : ℝ)) * (1 + x) ^ (-(3 / 5 + h)) ∧ |iteratedDeriv m (fun e => Uo x e) η| ≤ C) ∧ AdmBlk h (fun X => Real.exp (-(4 / Real.log (Xb / X) ^ 2))) (fun X => min 1 (Real.log (Xb / X))) (Ico Xg (Xb * Real.exp (-(5 / 2)))) Fo Uo ∧ (∃ μ : ℝ, 0 < μ ∧ RelaxCone h μ (Icc (XR * Real.exp (-5)) Xg2) Fo Uo) :=
by
  intro ρ0 ε0 X0 hpos
