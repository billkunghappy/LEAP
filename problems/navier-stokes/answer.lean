  · positivity
  intro w u φ β R I i j hR hI hw hu hφ hφc hφ01 hβ hwL2 hW hM hu0 hβb hsplit hSob
  have hR0 : (0:ℝ) < R := lt_of_lt_of_le one_pos hR
  have hpi : (0:ℝ) ≤ Real.pi⁻¹ := inv_nonneg.mpr Real.pi_pos.le
  have ha : (0:ℝ) < 3 * c₁ / R := by positivity
  have hA8 : (0:ℝ) ≤ 8 * c₁ / R := by positivity
  have hW0 : 0 ≤ ∫ x, ‖w x‖ ^ 2 := integral_nonneg fun x => by positivity
  have hS0 : 0 ≤ ∫ x, φ x ^ 24 * ‖w x‖ ^ 6 :=
    integral_nonneg fun x => mul_nonneg (pow_nonneg (hφ01 x).1 _) (by positivity)
  have hJ0 : (0:ℝ) ≤ 1 + I ^ ((1:ℝ)/2) := add_nonneg zero_le_one (Real.rpow_nonneg hI _)

  obtain ⟨hg1, hg2⟩ := flux_comm_g_moments (max M 0) Ru w u φ i j hw hu hφ hφc hφ01 hwL2
    (fun x => (hM x).trans (le_max_left _ _)) hu0
  obtain ⟨hb1, hb2⟩ := flux_beta_moments (8 * c₁ / R) w φ β hA8 hw hφ hβ hφc hφ01 hwL2 hβb
  have hk3 := kernel_four_thirds_integral (3 * c₁ / R) ha
  have harith := flux_comm_arith (max C₀ 0) (max M 0) (max K 0) c₁
    (volume (Metric.ball (0:ℝ³) Ru)).toReal R (∫ x, ‖w x‖ ^ 2) (∫ x, φ x ^ 24 * ‖w x‖ ^ 6) I
    hC' hM' hK' hc₁ hV0 hR hW0 (hW.trans (le_max_left _ _)) hS0 hI
    (hSob.trans (mul_le_mul_of_nonneg_right (le_max_left _ _) hJ0))

  obtain ⟨g, hgdef⟩ : ∃ g : ℝ³ → ℝ, ∀ x, g x = w x i * w x j + w x i * u x j + u x i * w x j :=
    ⟨_, fun x => rfl⟩
  simp only [← hgdef] at hg1 hg2 ⊢
  have hcomp : ∀ (v : ℝ³ → ℝ³) (k : Fin 3), Continuous v → Continuous (fun y => v y k) :=
    fun v k hv => (EuclideanSpace.proj k : ℝ³ →L[ℝ] ℝ).continuous.comp hv
  have hgc : Continuous g := by
    have e : g = fun x => w x i * w x j + w x i * u x j + u x i * w x j := funext hgdef
    rw [e]
    exact (((hcomp w i hw).mul (hcomp w j hw)).add ((hcomp w i hw).mul (hcomp u j hu))).add
      ((hcomp u i hu).mul (hcomp w j hw))

  obtain ⟨kk, hkk⟩ : ∃ kk : ℝ³ → ENNReal, ∀ z,
      kk z = ENNReal.ofReal ((‖z‖⁻¹) ^ 3 * min 1 (3 * c₁ / R * ‖z‖)) := ⟨_, fun z => rfl⟩
  have hE : ∀ z : ℝ³, 0 ≤ (‖z‖⁻¹) ^ 3 * min 1 (3 * c₁ / R * ‖z‖) := fun z =>
    mul_nonneg (pow_nonneg (inv_nonneg.mpr (norm_nonneg _)) 3)
      (le_min zero_le_one (mul_nonneg ha.le (norm_nonneg _)))
  have hkm : Measurable kk := by
    have e : kk = fun z => ENNReal.ofReal ((‖z‖⁻¹) ^ 3 * min 1 (3 * c₁ / R * ‖z‖)) := funext hkk
    rw [e]
    exact (((measurable_norm.inv).pow_const 3).mul
      (measurable_const.min (measurable_const.mul measurable_norm))).ennreal_ofReal
  have hFm : Measurable fun x => ENNReal.ofReal (φ x ^ 3 * |g x|) :=
    ((hφ.pow 3).mul hgc.abs).measurable.ennreal_ofReal
  have hGm : Measurable fun x => ENNReal.ofReal |g x| := hgc.abs.measurable.ennreal_ofReal
  have hH1m : Measurable fun y => ENNReal.ofReal |β y| := hβ.abs.measurable.ennreal_ofReal
  have hH2m : Measurable fun y => ENNReal.ofReal (φ y ^ 3 * |β y|) :=
    ((hφ.pow 3).mul hβ.abs).measurable.ennreal_ofReal

  have hpt : ∀ x y, ‖g x‖ₑ * ENNReal.ofReal (Real.pi⁻¹ * (‖x - y‖⁻¹) ^ 3 * |φ y ^ 6 - φ x ^ 6| * |β y|)
      ≤ ENNReal.ofReal Real.pi⁻¹ * (ENNReal.ofReal (φ x ^ 3 * |g x|) * kk (x - y) * ENNReal.ofReal |β y|
        + ENNReal.ofReal |g x| * kk (x - y) * ENNReal.ofReal (φ y ^ 3 * |β y|)) := by
    intro x y
    have hP : 0 ≤ φ x ^ 3 := pow_nonneg (hφ01 x).1 3
    have hQ : 0 ≤ φ y ^ 3 := pow_nonneg (hφ01 y).1 3
    have hγ : 0 ≤ |g x| := abs_nonneg _
    have hb : 0 ≤ |β y| := abs_nonneg _
    have hEm := hE (x - y)
    have hreal : |g x| * (Real.pi⁻¹ * (‖x - y‖⁻¹) ^ 3 * |φ y ^ 6 - φ x ^ 6| * |β y|)
        ≤ Real.pi⁻¹ * ((φ x ^ 3 * |g x|) * ((‖x - y‖⁻¹) ^ 3 * min 1 (3 * c₁ / R * ‖x - y‖)) * |β y|
          + |g x| * ((‖x - y‖⁻¹) ^ 3 * min 1 (3 * c₁ / R * ‖x - y‖)) * (φ y ^ 3 * |β y|)) := by
      have h1 := hsplit x y
      have h2 : |g x| * (Real.pi⁻¹ * (‖x - y‖⁻¹) ^ 3 * |φ y ^ 6 - φ x ^ 6| * |β y|)
          ≤ |g x| * (Real.pi⁻¹ * (‖x - y‖⁻¹) ^ 3 *
            (min 1 (3 * c₁ / R * ‖x - y‖) * (φ x ^ 3 + φ y ^ 3)) * |β y|) := by
        gcongr
      calc _ ≤ _ := h2
        _ = _ := by ring
    calc ‖g x‖ₑ * ENNReal.ofReal (Real.pi⁻¹ * (‖x - y‖⁻¹) ^ 3 * |φ y ^ 6 - φ x ^ 6| * |β y|)
        = ENNReal.ofReal (|g x| * (Real.pi⁻¹ * (‖x - y‖⁻¹) ^ 3 * |φ y ^ 6 - φ x ^ 6| * |β y|)) := by
          rw [Real.enorm_eq_ofReal_abs, ENNReal.ofReal_mul hγ]
      _ ≤ ENNReal.ofReal (Real.pi⁻¹ * ((φ x ^ 3 * |g x|) * ((‖x - y‖⁻¹) ^ 3 * min 1 (3 * c₁ / R * ‖x - y‖)) * |β y|
          + |g x| * ((‖x - y‖⁻¹) ^ 3 * min 1 (3 * c₁ / R * ‖x - y‖)) * (φ y ^ 3 * |β y|))) :=
          ENNReal.ofReal_le_ofReal hreal
      _ = _ := by
          rw [hkk, ENNReal.ofReal_mul hpi,
            ENNReal.ofReal_add (mul_nonneg (mul_nonneg (mul_nonneg hP hγ) hEm) hb)
              (mul_nonneg (mul_nonneg hγ hEm) (mul_nonneg hQ hb)),
            ENNReal.ofReal_mul (mul_nonneg (mul_nonneg hP hγ) hEm), ENNReal.ofReal_mul (mul_nonneg hP hγ),
            ENNReal.ofReal_mul (mul_nonneg hγ hEm), ENNReal.ofReal_mul hγ]

  have hstep1 : (∫⁻ x, ‖g x‖ₑ * ∫⁻ y, ENNReal.ofReal (Real.pi⁻¹ * (‖x - y‖⁻¹) ^ 3 * |φ y ^ 6 - φ x ^ 6| * |β y|))
      ≤ ∫⁻ x, ∫⁻ y, ENNReal.ofReal Real.pi⁻¹ * (ENNReal.ofReal (φ x ^ 3 * |g x|) * kk (x - y) * ENNReal.ofReal |β y|
        + ENNReal.ofReal |g x| * kk (x - y) * ENNReal.ofReal (φ y ^ 3 * |β y|)) := by
    refine lintegral_mono fun x => ?_
    try dsimp only
    rw [← lintegral_const_mul' (‖g x‖ₑ) _ enorm_ne_top]
    exact lintegral_mono fun y => hpt x y
  have hA : ∀ x, Measurable fun y => ENNReal.ofReal (φ x ^ 3 * |g x|) * kk (x - y) * ENNReal.ofReal |β y| :=
    fun x => (measurable_const.mul (hkm.comp (measurable_const.sub measurable_id))).mul hH1m
  have hIA : Measurable fun x => ∫⁻ y, ENNReal.ofReal (φ x ^ 3 * |g x|) * kk (x - y) * ENNReal.ofReal |β y| :=
    Measurable.lintegral_prod_right'
      (f := fun p : ℝ³ × ℝ³ => ENNReal.ofReal (φ p.1 ^ 3 * |g p.1|) * kk (p.1 - p.2) * ENNReal.ofReal |β p.2|)
      (((hFm.comp measurable_fst).mul (hkm.comp (measurable_fst.sub measurable_snd))).mul
        (hH1m.comp measurable_snd))
  have hstep2 : (∫⁻ x, ∫⁻ y, ENNReal.ofReal Real.pi⁻¹ * (ENNReal.ofReal (φ x ^ 3 * |g x|) * kk (x - y) * ENNReal.ofReal |β y|
        + ENNReal.ofReal |g x| * kk (x - y) * ENNReal.ofReal (φ y ^ 3 * |β y|)))
      = ENNReal.ofReal Real.pi⁻¹ * ((∫⁻ x, ∫⁻ y, ENNReal.ofReal (φ x ^ 3 * |g x|) * kk (x - y) * ENNReal.ofReal |β y|)
        + ∫⁻ x, ∫⁻ y, ENNReal.ofReal |g x| * kk (x - y) * ENNReal.ofReal (φ y ^ 3 * |β y|)) := by
    calc _ = ∫⁻ x, ENNReal.ofReal Real.pi⁻¹ * ((∫⁻ y, ENNReal.ofReal (φ x ^ 3 * |g x|) * kk (x - y) * ENNReal.ofReal |β y|)
          + ∫⁻ y, ENNReal.ofReal |g x| * kk (x - y) * ENNReal.ofReal (φ y ^ 3 * |β y|)) :=
          lintegral_congr fun x => by
            rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, lintegral_add_left (hA x)]
      _ = ENNReal.ofReal Real.pi⁻¹ * ∫⁻ x, ((∫⁻ y, ENNReal.ofReal (φ x ^ 3 * |g x|) * kk (x - y) * ENNReal.ofReal |β y|)
          + ∫⁻ y, ENNReal.ofReal |g x| * kk (x - y) * ENNReal.ofReal (φ y ^ 3 * |β y|)) :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      _ = _ := by rw [lintegral_add_left hIA]

  have hKk : (∫⁻ z, kk z ^ ((4:ℝ)/3)) = ENNReal.ofReal (16 * Real.pi * (3 * c₁ / R)) := by
    rw [← hk3]
    exact lintegral_congr fun z => by rw [hkk, ENNReal.ofReal_rpow_of_nonneg (hE z) (by norm_num)]
  have hF43eq : (∫⁻ x, ENNReal.ofReal (φ x ^ 3 * |g x|) ^ ((4:ℝ)/3))
      = ∫⁻ x, ENNReal.ofReal ((φ x ^ 3 * |g x|) ^ ((4:ℝ)/3)) :=
    lintegral_congr fun x =>
      ENNReal.ofReal_rpow_of_nonneg (mul_nonneg (pow_nonneg (hφ01 x).1 3) (abs_nonneg _)) (by norm_num)
  have hH1eq : (∫⁻ y, ENNReal.ofReal |β y| ^ (2:ℝ)) = ∫⁻ y, ENNReal.ofReal (β y ^ 2) :=
    lintegral_congr fun y => by
      rw [ENNReal.ofReal_rpow_of_nonneg (abs_nonneg _) (by norm_num), Real.rpow_two, sq_abs]
  have hH2eq : (∫⁻ y, ENNReal.ofReal (φ y ^ 3 * |β y|) ^ (4:ℝ))
      = ∫⁻ y, ENNReal.ofReal ((φ y ^ 3 * |β y|) ^ 4) :=
    lintegral_congr fun y => by
      rw [ENNReal.ofReal_rpow_of_nonneg (mul_nonneg (pow_nonneg (hφ01 y).1 3) (abs_nonneg _)) (by norm_num)]
      congr 1
      rw [show (4:ℝ) = ((4:ℕ):ℝ) by norm_num, Real.rpow_natCast]
  have hTa := trilinear_young_four_thirds (fun x => ENNReal.ofReal (φ x ^ 3 * |g x|)) kk
    (fun y => ENNReal.ofReal |β y|) hFm hkm hH1m
  have hTb := trilinear_holder_one_four (fun x => ENNReal.ofReal |g x|) kk
    (fun y => ENNReal.ofReal (φ y ^ 3 * |β y|)) hGm hkm hH2m
  have hTa' := hTa.trans (mul_le_mul' (mul_le_mul'
    (ENNReal.rpow_le_rpow (hF43eq.le.trans hg2) (by norm_num : (0:ℝ) ≤ (3:ℝ)/4))
    (ENNReal.rpow_le_rpow hKk.le (by norm_num : (0:ℝ) ≤ (3:ℝ)/4)))
    (ENNReal.rpow_le_rpow (hH1eq.le.trans hb1) (by norm_num : (0:ℝ) ≤ (1:ℝ)/2)))
  have hTb' := hTb.trans (mul_le_mul' (mul_le_mul' hg1
    (ENNReal.rpow_le_rpow hKk.le (by norm_num : (0:ℝ) ≤ (3:ℝ)/4)))
    (ENNReal.rpow_le_rpow (hH2eq.le.trans hb2) (by norm_num : (0:ℝ) ≤ (1:ℝ)/4)))
  have key : ∀ (Ta Tb : ENNReal) (X5 X3 Y2 Y4 Kc : ℝ), 0 ≤ X5 → 0 ≤ X3 → 0 ≤ Y2 → 0 ≤ Y4 → 0 ≤ Kc →
      Ta ≤ ENNReal.ofReal X5 ^ ((3:ℝ)/4) * ENNReal.ofReal Kc ^ ((3:ℝ)/4) * ENNReal.ofReal Y2 ^ ((1:ℝ)/2) →
      Tb ≤ ENNReal.ofReal X3 * ENNReal.ofReal Kc ^ ((3:ℝ)/4) * ENNReal.ofReal Y4 ^ ((1:ℝ)/4) →
      ENNReal.ofReal Real.pi⁻¹ * (Ta + Tb) ≤ ENNReal.ofReal (Real.pi⁻¹ * Kc ^ ((3:ℝ)/4) *
        (X5 ^ ((3:ℝ)/4) * Y2 ^ ((1:ℝ)/2) + X3 * Y4 ^ ((1:ℝ)/4))) := by
    intro Ta Tb X5 X3 Y2 Y4 Kc h5 h3 h2 h4 hk hTa hTb
    have e : Real.pi⁻¹ * Kc ^ ((3:ℝ)/4) * (X5 ^ ((3:ℝ)/4) * Y2 ^ ((1:ℝ)/2) + X3 * Y4 ^ ((1:ℝ)/4))
        = Real.pi⁻¹ * (X5 ^ ((3:ℝ)/4) * Kc ^ ((3:ℝ)/4) * Y2 ^ ((1:ℝ)/2)
          + X3 * Kc ^ ((3:ℝ)/4) * Y4 ^ ((1:ℝ)/4)) := by ring
    have p5 := Real.rpow_nonneg h5 ((3:ℝ)/4)
    have pk := Real.rpow_nonneg hk ((3:ℝ)/4)
    have p2 := Real.rpow_nonneg h2 ((1:ℝ)/2)
    have p4 := Real.rpow_nonneg h4 ((1:ℝ)/4)
    rw [e, ENNReal.ofReal_mul hpi,
      ENNReal.ofReal_add (mul_nonneg (mul_nonneg p5 pk) p2) (mul_nonneg (mul_nonneg h3 pk) p4),
      ENNReal.ofReal_mul (mul_nonneg p5 pk), ENNReal.ofReal_mul p5,
      ENNReal.ofReal_mul (mul_nonneg h3 pk), ENNReal.ofReal_mul h3,
      ← ENNReal.ofReal_rpow_of_nonneg (p := (3:ℝ)/4) h5 (by norm_num),
      ← ENNReal.ofReal_rpow_of_nonneg (p := (3:ℝ)/4) hk (by norm_num),
      ← ENNReal.ofReal_rpow_of_nonneg (p := (1:ℝ)/2) h2 (by norm_num),
      ← ENNReal.ofReal_rpow_of_nonneg (p := (1:ℝ)/4) h4 (by norm_num)]
    exact mul_le_mul' le_rfl (add_le_add hTa hTb)
  have hX5 : 0 ≤ 2 ^ ((1:ℝ)/3) * ((∫ x, ‖w x‖ ^ 2) ^ ((5:ℝ)/6) * (∫ x, φ x ^ 24 * ‖w x‖ ^ 6) ^ ((1:ℝ)/6)
      + (2 * max M 0) ^ ((4:ℝ)/3) * ((volume (Metric.ball (0:ℝ³) Ru)).toReal + ∫ x, ‖w x‖ ^ 2)) :=
    mul_nonneg (Real.rpow_nonneg (by norm_num) _)
      (add_nonneg (mul_nonneg (Real.rpow_nonneg hW0 _) (Real.rpow_nonneg hS0 _))
        (mul_nonneg (Real.rpow_nonneg (mul_nonneg two_pos.le hM') _) (add_nonneg hV0 hW0)))
  have hX3 : 0 ≤ (∫ x, ‖w x‖ ^ 2) + 2 * max M 0 * ((volume (Metric.ball (0:ℝ³) Ru)).toReal + ∫ x, ‖w x‖ ^ 2) :=
    add_nonneg hW0 (mul_nonneg (mul_nonneg two_pos.le hM') (add_nonneg hV0 hW0))
  have hY2 : 0 ≤ (8 * c₁ / R) ^ 2 * ∫ x, ‖w x‖ ^ 2 := mul_nonneg (sq_nonneg _) hW0
  have hY4 : 0 ≤ (8 * c₁ / R) ^ 4 * ((∫ x, ‖w x‖ ^ 2) ^ ((1:ℝ)/2) * (∫ x, φ x ^ 24 * ‖w x‖ ^ 6) ^ ((1:ℝ)/2)) :=
    mul_nonneg (pow_nonneg hA8 4) (mul_nonneg (Real.rpow_nonneg hW0 _) (Real.rpow_nonneg hS0 _))
  have hKc : (0:ℝ) ≤ 16 * Real.pi * (3 * c₁ / R) := by positivity

  calc _ ≤ _ := hstep1
    _ = _ := hstep2
    _ ≤ _ := key _ _ _ _ _ _ _ hX5 hX3 hY2 hY4 hKc hTa' hTb'
    _ ≤ _ := ENNReal.ofReal_le_ofReal harith

theorem stress_pressure_flux_bound : ∀ (C₀ M Ru K : ℝ), ∃ C : ℝ, ∀ (w u : ℝ³ → ℝ³), ContDiff ℝ ∞ w → ContDiff ℝ ∞ u → MemLp w 2 → (∫ x, ‖w x‖ ^ 2) ≤ C₀ → (∀ x, ‖u x‖ ≤ M) → (∀ x, Ru ≤ ‖x‖ → u x = 0) → (∀ R : ℝ, 1 ≤ R → (∫ x, cutPhi R x ^ 24 * ‖w x‖ ^ 6) ^ ((1 : ℝ) / 6) ≤ K * (1 + (∫ x, cutPhi R x ^ 8 * ∑ k, ‖fderiv ℝ w x (EuclideanSpace.single k 1)‖ ^ 2) ^ ((1 : ℝ) / 2))) → ∀ R : ℝ, 1 ≤ R → Ru ≤ R → |∫ x, stressPressure (fun i j y => w y i * w y j + w y i * u y j + u y i * w y j) x * inner ℝ (w x) (gradient (fun y => cutPhi R y ^ 8) x)| ≤ C / R * (1 + (∫ x, cutPhi R x ^ 8 * ∑ k, ‖fderiv ℝ w x (EuclideanSpace.single k 1)‖ ^ 2) ^ ((3 : ℝ) / 4)) :=
by
  intro C₀ M Ru K
  obtain ⟨c₁, hc₁, hcut⟩ := flux_cutoff_beta
  obtain ⟨C₁, hC₁0, hC₁⟩ := flux_main_term_estimate C₀ M Ru K c₁ hc₁
  obtain ⟨C₂, hC₂0, hC₂⟩ := flux_commutator_estimate C₀ M Ru K c₁ hc₁
  refine ⟨9 * (C₁ + C₂), ?_⟩
  intro w u hw hu hwL2 hW hM hu0 hSob R hR _hRu
  have hR0 : (0 : ℝ) < R := lt_of_lt_of_le one_pos hR
  obtain ⟨hlip, hβ⟩ := hcut R hR
  obtain ⟨hβs, hβc, hβb, hinner⟩ := hβ w hw

  have hφs : ContDiff ℝ ∞ (cutPhi R) := by
    show ContDiff ℝ ∞ (fun x : ℝ³ => bump12 (R⁻¹ • x))
    exact bump12.contDiff.comp (contDiff_const_smul R⁻¹)
  have hφcs : HasCompactSupport (cutPhi R) :=
    bump12.hasCompactSupport.comp_smul (inv_ne_zero hR0.ne')
  have hφ01 : ∀ x, 0 ≤ cutPhi R x ∧ cutPhi R x ≤ 1 := fun x => ⟨bump12.nonneg, bump12.le_one⟩
  have hφcont : Continuous (cutPhi R) := hφs.continuous

  have hbs : ContDiff ℝ ∞ (fun x => cutPhi R x ^ 6 * fluxBeta R w x) := (hφs.pow 6).mul hβs
  have hbc : HasCompactSupport (fun x => cutPhi R x ^ 6 * fluxBeta R w x) := hβc.mul_left

  have hcomp : ∀ (v : ℝ³ → ℝ³) (k : Fin 3), ContDiff ℝ ∞ v → ContDiff ℝ ∞ (fun y => v y k) :=
    fun v k hv => (EuclideanSpace.proj k : ℝ³ →L[ℝ] ℝ).contDiff.comp hv
  have hgs : ∀ i j : Fin 3,
      ContDiff ℝ ∞ (fun y => w y i * w y j + w y i * u y j + u y i * w y j) :=
    fun i j => (((hcomp w i hw).mul (hcomp w j hw)).add ((hcomp w i hw).mul (hcomp u j hu))).add
      ((hcomp u i hu).mul (hcomp w j hw))
  have hucs : HasCompactSupport u := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : ℝ³) Ru) (fun x hx => hu0 x ?_)
    rw [Metric.mem_closedBall, dist_zero_right, not_le] at hx
    exact hx.le
  have hwk : ∀ k : Fin 3, MemLp (fun y => w y k) 2 := fun k =>
    (EuclideanSpace.proj k : ℝ³ →L[ℝ] ℝ).comp_memLp' hwL2
  have huk : ∀ k : Fin 3, MemLp (fun y => u y k) 2 := fun k =>
    (hcomp u k hu).continuous.memLp_of_hasCompactSupport
      (hucs.comp_left (g := fun v : ℝ³ => v k) (by simp))
  have hgi : ∀ i j : Fin 3,
      Integrable (fun y => w y i * w y j + w y i * u y j + u y i * w y j) :=
    fun i j => (((hwk i).integrable_mul (hwk j)).add ((hwk i).integrable_mul (huk j))).add
      ((huk i).integrable_mul (hwk j))

  have hI : 0 ≤ ∫ x, cutPhi R x ^ 8 * ∑ k, ‖fderiv ℝ w x (EuclideanSpace.single k 1)‖ ^ 2 :=
    integral_nonneg fun x => mul_nonneg (pow_nonneg (hφ01 x).1 8)
      (Finset.sum_nonneg fun k _ => sq_nonneg _)
  have hSobR := hSob R hR
  generalize (∫ x, cutPhi R x ^ 8 * ∑ k, ‖fderiv ℝ w x (EuclideanSpace.single k 1)‖ ^ 2) = I
    at hI hSobR ⊢
  have hJ : 0 ≤ 1 + I ^ ((3 : ℝ) / 4) := by
    have := Real.rpow_nonneg hI ((3 : ℝ) / 4)
    linarith

  simp only [hinner]
  rw [show (∫ x, stressPressure (fun i j y => w y i * w y j + w y i * u y j + u y i * w y j) x *
      (cutPhi R x ^ 6 * fluxBeta R w x)) = ∑ i, ∑ j, ∫ x,
        (w x i * w x j + w x i * u x j + u x i * w x j) *
          pd i (pd j (newtonPot (fun x => cutPhi R x ^ 6 * fluxBeta R w x))) x from
    stressPressure_duality (fun i j y => w y i * w y j + w y i * u y j + u y i * w y j)
      (fun x => cutPhi R x ^ 6 * fluxBeta R w x) hgs hgi hbs hbc]

  have key : ∀ i j : Fin 3, |∫ x, (w x i * w x j + w x i * u x j + u x i * w x j) *
      pd i (pd j (newtonPot (fun x => cutPhi R x ^ 6 * fluxBeta R w x))) x| ≤
      (C₁ + C₂) / R * (1 + I ^ ((3 : ℝ) / 4)) := by
    intro i j
    obtain ⟨hτL2, hτle⟩ := newton_hessian_L2_bound (fluxBeta R w) hβs hβc i j
    have hcomm := newton_commutator_pointwise (fun y => cutPhi R y ^ 6) (fluxBeta R w)
      (hφs.pow 6) hβs hβc i j
    have hmain := hC₁ w u (cutPhi R) (fluxBeta R w) (pd i (pd j (newtonPot (fluxBeta R w))))
      R I i j hR hI hw.continuous hu.continuous hφcont hφcs hφ01 hβs.continuous hwL2 hW hM hu0
      hβb hτL2 hτle hSobR
    have hcom := hC₂ w u (cutPhi R) (fluxBeta R w) R I i j hR hI hw.continuous hu.continuous
      hφcont hφcs hφ01 hβs.continuous hwL2 hW hM hu0 hβb hlip hSobR
    have hpt : ∀ x, ‖(w x i * w x j + w x i * u x j + u x i * w x j) *
        pd i (pd j (newtonPot (fun x => cutPhi R x ^ 6 * fluxBeta R w x))) x‖ₑ ≤
        ‖w x i * w x j + w x i * u x j + u x i * w x j‖ₑ *
          ‖cutPhi R x ^ 6 * pd i (pd j (newtonPot (fluxBeta R w))) x‖ₑ +
        ‖w x i * w x j + w x i * u x j + u x i * w x j‖ₑ *
          ∫⁻ y, ENNReal.ofReal (Real.pi⁻¹ * (‖x - y‖⁻¹) ^ 3 *
            |cutPhi R y ^ 6 - cutPhi R x ^ 6| * |fluxBeta R w y|) := by
      intro x
      have hT : ‖pd i (pd j (newtonPot (fun x => cutPhi R x ^ 6 * fluxBeta R w x))) x‖ₑ ≤
          ‖cutPhi R x ^ 6 * pd i (pd j (newtonPot (fluxBeta R w))) x‖ₑ +
          ∫⁻ y, ENNReal.ofReal (Real.pi⁻¹ * (‖x - y‖⁻¹) ^ 3 *
            |cutPhi R y ^ 6 - cutPhi R x ^ 6| * |fluxBeta R w y|) := by
        calc ‖pd i (pd j (newtonPot (fun x => cutPhi R x ^ 6 * fluxBeta R w x))) x‖ₑ
            = ‖cutPhi R x ^ 6 * pd i (pd j (newtonPot (fluxBeta R w))) x +
                (pd i (pd j (newtonPot (fun x => cutPhi R x ^ 6 * fluxBeta R w x))) x -
                  cutPhi R x ^ 6 * pd i (pd j (newtonPot (fluxBeta R w))) x)‖ₑ := by
              congr 1; ring
          _ ≤ ‖cutPhi R x ^ 6 * pd i (pd j (newtonPot (fluxBeta R w))) x‖ₑ +
                ‖pd i (pd j (newtonPot (fun x => cutPhi R x ^ 6 * fluxBeta R w x))) x -
                  cutPhi R x ^ 6 * pd i (pd j (newtonPot (fluxBeta R w))) x‖ₑ := enorm_add_le _ _
          _ ≤ _ := add_le_add le_rfl (hcomm x)
      calc _ = ‖w x i * w x j + w x i * u x j + u x i * w x j‖ₑ *
            ‖pd i (pd j (newtonPot (fun x => cutPhi R x ^ 6 * fluxBeta R w x))) x‖ₑ := enorm_mul _ _
        _ ≤ ‖w x i * w x j + w x i * u x j + u x i * w x j‖ₑ *
            (‖cutPhi R x ^ 6 * pd i (pd j (newtonPot (fluxBeta R w))) x‖ₑ +
              ∫⁻ y, ENNReal.ofReal (Real.pi⁻¹ * (‖x - y‖⁻¹) ^ 3 *
                |cutPhi R y ^ 6 - cutPhi R x ^ 6| * |fluxBeta R w y|)) := by gcongr
        _ = _ := mul_add _ _ _
    have hmeas : AEMeasurable (fun x => ‖w x i * w x j + w x i * u x j + u x i * w x j‖ₑ *
        ‖cutPhi R x ^ 6 * pd i (pd j (newtonPot (fluxBeta R w))) x‖ₑ) :=
      ((hgs i j).continuous.aestronglyMeasurable.enorm).mul
        (((hφcont.pow 6).aestronglyMeasurable.mul hτL2.aestronglyMeasurable).enorm)
    have hint : ∫⁻ x, ‖(w x i * w x j + w x i * u x j + u x i * w x j) *
        pd i (pd j (newtonPot (fun x => cutPhi R x ^ 6 * fluxBeta R w x))) x‖ₑ ≤
        ENNReal.ofReal ((C₁ + C₂) / R * (1 + I ^ ((3 : ℝ) / 4))) := by
      calc _ ≤ _ := lintegral_mono hpt
        _ = _ := lintegral_add_left' hmeas _
        _ ≤ ENNReal.ofReal (C₁ / R * (1 + I ^ ((3 : ℝ) / 4))) +
              ENNReal.ofReal (C₂ / R * (1 + I ^ ((3 : ℝ) / 4))) := add_le_add hmain hcom
        _ = _ := by
          rw [← ENNReal.ofReal_add (mul_nonneg (div_nonneg hC₁0 hR0.le) hJ)
            (mul_nonneg (div_nonneg hC₂0 hR0.le) hJ)]
          congr 1
          ring
    have h1 := (enorm_integral_le_lintegral_enorm _).trans hint
    have h2 := ENNReal.toReal_mono ENNReal.ofReal_ne_top h1
    rw [toReal_enorm, ENNReal.toReal_ofReal
      (mul_nonneg (div_nonneg (add_nonneg hC₁0 hC₂0) hR0.le) hJ)] at h2
    rwa [Real.norm_eq_abs] at h2

  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  refine (Finset.sum_le_sum fun i _ => Finset.abs_sum_le_sum_abs _ _).trans ?_
  refine (Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => key i j).trans ?_
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  apply le_of_eq
  push_cast
  ring

theorem cutoff_profile : ∃ c₁ : ℝ, 0 ≤ c₁ ∧ ∀ R : ℝ, 1 ≤ R → ContDiff ℝ ∞ (cutPhi R) ∧ HasCompactSupport (cutPhi R) ∧ (∀ x, 0 ≤ cutPhi R x ∧ cutPhi R x ≤ 1) ∧ (∀ x, ‖x‖ ≤ R → cutPhi R x = 1) ∧ (∀ x, 2 * R ≤ ‖x‖ → cutPhi R x = 0) ∧ ContDiff ℝ ∞ (fun y => cutPhi R y ^ 8) ∧ HasCompactSupport (fun y => cutPhi R y ^ 8) ∧ (∀ x, ‖fderiv ℝ (fun y => cutPhi R y ^ 8) x‖ ≤ 8 * c₁ / R * cutPhi R x ^ 7) ∧ (∀ x, ‖x‖ < R → fderiv ℝ (fun y => cutPhi R y ^ 8) x = 0) :=
by
  have hbC : ContDiff ℝ ∞ (⇑bump12) := bump12.contDiff
  have hbS : HasCompactSupport (⇑bump12) := bump12.hasCompactSupport
  have hDc : Continuous (fderiv ℝ (⇑bump12)) := hbC.continuous_fderiv (by simp)
  have hDS : HasCompactSupport (fderiv ℝ (⇑bump12)) := hbS.fderiv ℝ
  obtain ⟨c, hc⟩ := hDS.exists_bound_of_continuous hDc
  refine ⟨max c 0, le_max_right _ _, fun R hR => ?_⟩
  have hc' : ∀ y, ‖fderiv ℝ (⇑bump12) y‖ ≤ max c 0 :=
    fun y => le_trans (hc y) (le_max_left _ _)
  have hRpos : 0 < R := by linarith
  have hRinv : 0 < R⁻¹ := inv_pos.mpr hRpos
  have hnorm : ∀ x : ℝ³, ‖R⁻¹ • x‖ = R⁻¹ * ‖x‖ := fun x => by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hRinv]
  have hφeq : cutPhi R = fun x => bump12 (R⁻¹ • x) := rfl
  have hφC : ContDiff ℝ ∞ (cutPhi R) := by
    rw [hφeq]; exact hbC.comp (contDiff_const_smul R⁻¹)
  have hφS : HasCompactSupport (cutPhi R) := by
    rw [hφeq]; exact hbS.comp_smul (inv_ne_zero hRpos.ne')
  have hφb : ∀ x, 0 ≤ cutPhi R x ∧ cutPhi R x ≤ 1 :=
    fun x => ⟨bump12.nonneg, bump12.le_one⟩
  have hφ1 : ∀ x, ‖x‖ ≤ R → cutPhi R x = 1 := by
    intro x hx
    show bump12 (R⁻¹ • x) = 1
    apply bump12.one_of_mem_closedBall
    rw [Metric.mem_closedBall, dist_zero_right, hnorm]
    show R⁻¹ * ‖x‖ ≤ 1
    rw [inv_mul_le_iff₀ hRpos, mul_one]
    exact hx
  have hφ0 : ∀ x, 2 * R ≤ ‖x‖ → cutPhi R x = 0 := by
    intro x hx
    show bump12 (R⁻¹ • x) = 0
    apply bump12.zero_of_le_dist
    rw [dist_zero_right, hnorm]
    show (2:ℝ) ≤ R⁻¹ * ‖x‖
    rw [le_inv_mul_iff₀ hRpos]
    linarith
  have hχC : ContDiff ℝ ∞ (fun y => cutPhi R y ^ 8) := hφC.pow 8
  have hχS : HasCompactSupport (fun y => cutPhi R y ^ 8) :=
    hφS.comp_left (g := fun t : ℝ => t ^ 8) (by norm_num)
  have hDφ : ∀ x, ‖fderiv ℝ (cutPhi R) x‖ ≤ max c 0 / R := by
    intro x
    rw [hφeq, fderiv_comp_smul, norm_smul, Real.norm_eq_abs, abs_of_pos hRinv, div_eq_inv_mul]
    exact mul_le_mul_of_nonneg_left (hc' _) hRinv.le
  have hχd : ∀ x, ‖fderiv ℝ (fun y => cutPhi R y ^ 8) x‖ ≤ 8 * max c 0 / R * cutPhi R x ^ 7 := by
    intro x
    have hd : DifferentiableAt ℝ (cutPhi R) x := hφC.differentiable (by simp) x
    have h0 : 0 ≤ cutPhi R x := (hφb x).1
    have h7 : 0 ≤ cutPhi R x ^ 7 := pow_nonneg h0 7
    have hfd : fderiv ℝ (fun y => cutPhi R y ^ 8) x = (8 * cutPhi R x ^ 7) • fderiv ℝ (cutPhi R) x := by
      rw [(hd.hasFDerivAt.pow 8).fderiv]
      norm_num
    rw [hfd, norm_smul, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    calc 8 * cutPhi R x ^ 7 * ‖fderiv ℝ (cutPhi R) x‖ ≤ 8 * cutPhi R x ^ 7 * (max c 0 / R) :=
          mul_le_mul_of_nonneg_left (hDφ x) (by positivity)
      _ = 8 * max c 0 / R * cutPhi R x ^ 7 := by ring
  have hχz : ∀ x, ‖x‖ < R → fderiv ℝ (fun y => cutPhi R y ^ 8) x = 0 := by
    intro x hx
    have hU : Metric.ball (0:ℝ³) R ∈ nhds x :=
      Metric.isOpen_ball.mem_nhds (by rw [Metric.mem_ball, dist_zero_right]; exact hx)
    have hev : (fun y => cutPhi R y ^ 8) =ᶠ[nhds x] (fun _ => (1:ℝ)) := by
      filter_upwards [hU] with y hy
      rw [Metric.mem_ball, dist_zero_right] at hy
      rw [hφ1 y hy.le, one_pow]
    rw [hev.fderiv_eq]
    exact fderiv_const_apply _
  exact ⟨hφC, hφS, hφb, hφ1, hφ0, hχC, hχS, hχd, hχz⟩

theorem weighted_energy_regularity : ∀ (χ : ℝ³ → ℝ) (g : ℝ³ → ℝ → ℝ³) (T : ℝ), 0 < T → Continuous χ → HasCompactSupport χ → ContDiffOn ℝ ∞ (↿g) (univ ×ˢ Icc 0 T) → ContinuousOn (fun s => ∫ x, χ x * ‖g x s‖ ^ 2) (Icc 0 T) ∧ ContinuousOn (fun s => ∫ x, χ x * (2 * inner ℝ (g x s) (deriv (fun r => g x r) s))) (Ioo 0 T) ∧ ∀ s ∈ Ioo 0 T, HasDerivAt (fun s => ∫ x, χ x * ‖g x s‖ ^ 2) (∫ x, χ x * (2 * inner ℝ (g x s) (deriv (fun r => g x r) s))) s :=
by
  intro χ g T hT hχ hχs hg
  have hOopen : IsOpen ((univ : Set ℝ³) ×ˢ Ioo (0:ℝ) T) := isOpen_univ.prod isOpen_Ioo
  have hO : ContDiffOn ℝ ∞ (↿g) ((univ : Set ℝ³) ×ˢ Ioo (0:ℝ) T) :=
    hg.mono (fun z hz => ⟨hz.1, Ioo_subset_Icc_self hz.2⟩)
  obtain ⟨e, he⟩ : ∃ e : ℝ³ × ℝ, e = ((0 : ℝ³), (1 : ℝ)) := ⟨_, rfl⟩
  have s1 : ∀ x : ℝ³, ∀ s ∈ Ioo (0:ℝ) T,
      HasDerivAt (fun r => g x r) (fderiv ℝ (↿g) (x, s) e) s := by
    intro x s hs
    have hd : DifferentiableAt ℝ (↿g) (x, s) :=
      (hO.differentiableOn (by simp)).differentiableAt (hOopen.mem_nhds ⟨mem_univ x, hs⟩)
    have hγ : HasDerivAt (fun r : ℝ => (x, r)) e s := by
      rw [he]
      exact (hasDerivAt_const s x).prodMk (hasDerivAt_id s)
    exact hd.hasFDerivAt.comp_hasDerivAt s hγ
  have hcont_fd : ContinuousOn (fun z => fderiv ℝ (↿g) z e) ((univ : Set ℝ³) ×ˢ Ioo (0:ℝ) T) :=
    (hO.continuousOn_fderiv_of_isOpen hOopen (by simp)).clm_apply continuousOn_const
  have s2 : ∀ (h : ℝ → ℝ³ → ℝ) (S : Set ℝ), ContinuousOn (Function.uncurry h) (S ×ˢ univ) →
      ContinuousOn (fun s => ∫ x, χ x * h s x) S := by
    intro h S hh
    apply continuousOn_integral_of_compact_support hχs.isCompact
    · have : ContinuousOn (fun p : ℝ × ℝ³ => χ p.2 * Function.uncurry h p) (S ×ˢ univ) :=
        (hχ.comp continuous_snd).continuousOn.mul hh
      exact this
    · intro p x _ hx
      simp [image_eq_zero_of_notMem_tsupport hx]
  have hA : ContinuousOn (fun s => ∫ x, χ x * ‖g x s‖ ^ 2) (Icc 0 T) := by
    apply s2 (fun s x => ‖g x s‖ ^ 2) (Icc 0 T)
    have h1 : ContinuousOn (fun p : ℝ × ℝ³ => (↿g) p.swap) (Icc 0 T ×ˢ univ) :=
      hg.continuousOn.comp continuous_swap.continuousOn (fun p hp => ⟨mem_univ _, hp.1⟩)
    exact h1.norm.pow 2
  have hB : ContinuousOn (fun s => ∫ x, χ x * (2 * inner ℝ (g x s) (deriv (fun r => g x r) s)))
      (Ioo 0 T) := by
    apply s2 (fun s x => 2 * inner ℝ (g x s) (deriv (fun r => g x r) s)) (Ioo 0 T)
    have hmap : MapsTo Prod.swap (Ioo (0:ℝ) T ×ˢ (univ : Set ℝ³))
        ((univ : Set ℝ³) ×ˢ Ioo (0:ℝ) T) := fun p hp => ⟨mem_univ _, hp.1⟩
    have h1 : ContinuousOn (fun p : ℝ × ℝ³ => (↿g) p.swap) (Ioo 0 T ×ˢ univ) :=
      hO.continuousOn.comp continuous_swap.continuousOn hmap
    have h2 : ContinuousOn (fun p : ℝ × ℝ³ => fderiv ℝ (↿g) p.swap e) (Ioo 0 T ×ˢ univ) :=
      hcont_fd.comp continuous_swap.continuousOn hmap
    have h3 : ContinuousOn (fun p : ℝ × ℝ³ =>
        2 * inner ℝ ((↿g) p.swap) (fderiv ℝ (↿g) p.swap e)) (Ioo 0 T ×ˢ univ) :=
      continuousOn_const.mul (h1.inner h2)
    refine h3.congr ?_
    rintro ⟨s, x⟩ ⟨hs, -⟩
    simp only [Function.uncurry_apply_pair]
    rw [(s1 x s hs).deriv]
    rfl
  have hC : ∀ s ∈ Ioo 0 T, HasDerivAt (fun s => ∫ x, χ x * ‖g x s‖ ^ 2)
      (∫ x, χ x * (2 * inner ℝ (g x s) (deriv (fun r => g x r) s))) s := by
    intro s₀ hs₀
    obtain ⟨h0, hT0⟩ := hs₀
    obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = min s₀ (T - s₀) / 2 := ⟨_, rfl⟩
    have hmin : 0 < min s₀ (T - s₀) := lt_min h0 (by linarith)
    have hδpos : 0 < δ := by rw [hδ]; linarith
    have hJ : Metric.closedBall s₀ δ ⊆ Ioo 0 T := by
      intro s hs
      rw [Metric.mem_closedBall, Real.dist_eq, abs_le] at hs
      have h1 := min_le_left s₀ (T - s₀)
      have h2 := min_le_right s₀ (T - s₀)
      constructor <;> linarith [hs.1, hs.2]
    have hball : Metric.ball s₀ δ ⊆ Ioo 0 T := Metric.ball_subset_closedBall.trans hJ
    have hKcc : IsCompact (tsupport χ ×ˢ Metric.closedBall s₀ δ) :=
      hχs.isCompact.prod (isCompact_closedBall s₀ δ)
    have hKcO : tsupport χ ×ˢ Metric.closedBall s₀ δ ⊆ (univ : Set ℝ³) ×ˢ Ioo (0:ℝ) T :=
      fun z hz => ⟨mem_univ _, hJ hz.2⟩
    obtain ⟨M, hM⟩ := hKcc.exists_bound_of_continuousOn (hO.continuousOn.mono hKcO)
    obtain ⟨M', hM'⟩ := hKcc.exists_bound_of_continuousOn (hcont_fd.mono hKcO)
    have hbint : Integrable (fun x => 2 * M * M' * |χ x|) := by
      have : Integrable (fun x => ‖χ x‖) := (hχ.norm).integrable_of_hasCompactSupport hχs.norm
      simpa [Real.norm_eq_abs] using this.const_mul (2 * M * M')
    have hslice : ∀ s ∈ Icc (0:ℝ) T, Continuous (fun x => g x s) := fun s hs =>
      hg.continuousOn.comp_continuous (continuous_id.prodMk continuous_const)
        (fun x => ⟨mem_univ x, hs⟩)
    have hFcont : ∀ s ∈ Icc (0:ℝ) T, Continuous (fun x => χ x * ‖g x s‖ ^ 2) := fun s hs =>
      hχ.mul ((hslice s hs).norm.pow 2)
    have hF's0 : (fun x => χ x * (2 * inner ℝ (g x s₀) (deriv (fun r => g x r) s₀)))
        = fun x => χ x * (2 * inner ℝ (g x s₀) (fderiv ℝ (↿g) (x, s₀) e)) := by
      funext x; rw [(s1 x s₀ ⟨h0, hT0⟩).deriv]
    have hfdcont : Continuous (fun x => fderiv ℝ (↿g) (x, s₀) e) :=
      hcont_fd.comp_continuous (continuous_id.prodMk continuous_const)
        (fun x => ⟨mem_univ x, ⟨h0, hT0⟩⟩)
    have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume)
      (F := fun s x => χ x * ‖g x s‖ ^ 2)
      (F' := fun s x => χ x * (2 * inner ℝ (g x s) (deriv (fun r => g x r) s)))
      (bound := fun x => 2 * M * M' * |χ x|)
      (Metric.ball_mem_nhds s₀ hδpos) ?_ ?_ ?_ ?_ hbint ?_
    · exact key.2
    · filter_upwards [Metric.ball_mem_nhds s₀ hδpos] with s hs
      exact (hFcont s (Ioo_subset_Icc_self (hball hs))).aestronglyMeasurable
    · exact (hFcont s₀ ⟨h0.le, hT0.le⟩).integrable_of_hasCompactSupport hχs.mul_right
    · show AEStronglyMeasurable
        (fun x => χ x * (2 * inner ℝ (g x s₀) (deriv (fun r => g x r) s₀))) volume
      rw [hF's0]
      exact (hχ.mul (continuous_const.mul
        ((hslice s₀ ⟨h0.le, hT0.le⟩).inner hfdcont))).aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun x s hs => ?_)
      show ‖χ x * (2 * inner ℝ (g x s) (deriv (fun r => g x r) s))‖ ≤ 2 * M * M' * |χ x|
      rw [(s1 x s (hball hs)).deriv]
      by_cases hx : x ∈ tsupport χ
      · have hz : (x, s) ∈ tsupport χ ×ˢ Metric.closedBall s₀ δ :=
          ⟨hx, Metric.ball_subset_closedBall hs⟩
        have h1 : ‖g x s‖ ≤ M := hM (x, s) hz
        have h2 : ‖fderiv ℝ (↿g) (x, s) e‖ ≤ M' := hM' (x, s) hz
        have h3 := abs_real_inner_le_norm (g x s) (fderiv ℝ (↿g) (x, s) e)
        have h4 : ‖g x s‖ * ‖fderiv ℝ (↿g) (x, s) e‖ ≤ M * M' :=
          mul_le_mul h1 h2 (norm_nonneg _) (le_trans (norm_nonneg _) h1)
        simp only [norm_mul, Real.norm_eq_abs, abs_two]
        have h5 : |χ x| * (2 * |inner ℝ (g x s) (fderiv ℝ (↿g) (x, s) e)|)
            ≤ |χ x| * (2 * (M * M')) :=
          mul_le_mul_of_nonneg_left (by linarith) (abs_nonneg _)
        linarith
      · rw [image_eq_zero_of_notMem_tsupport hx]; simp
    · refine Filter.Eventually.of_forall (fun x s hs => ?_)
      have hd := s1 x s (hball hs)
      have := (hd.norm_sq).const_mul (χ x)
      show HasDerivAt (fun s => χ x * ‖g x s‖ ^ 2)
        (χ x * (2 * inner ℝ (g x s) (deriv (fun r => g x r) s))) s
      rw [hd.deriv]
      exact this
  exact ⟨hA, hB, hC⟩

theorem transport_term_bound : ∀ (φ : ℝ³ → ℝ) (w : ℝ³ → ℝ³) (c₁ R : ℝ), 0 < R → 0 ≤ c₁ → ContDiff ℝ ∞ φ → HasCompactSupport φ → (∀ x, 0 ≤ φ x ∧ φ x ≤ 1) → (∀ x, ‖fderiv ℝ (fun y => φ y ^ 8) x‖ ≤ 8 * c₁ / R * φ x ^ 7) → ContDiff ℝ ∞ w → MemLp w 2 → |∫ x, (‖w x‖ ^ 2 / 2) * fderiv ℝ (fun y => φ y ^ 8) x (w x)| ≤ 4 * c₁ / R * ((∫ x, ‖w x‖ ^ 2) ^ ((3 : ℝ) / 4) * (∫ x, φ x ^ 24 * ‖w x‖ ^ 6) ^ ((1 : ℝ) / 4)) :=
by
  intro φ w c₁ R hR hc₁ hφ hφS hφb hχd hw hwL
  have hφc : Continuous φ := hφ.continuous
  have hwc : Continuous w := hw.continuous
  have hk0 : 0 ≤ 4 * c₁ / R := div_nonneg (by positivity) hR.le

  have hcs : ∀ F : ℝ³ → ℝ, (∀ x, φ x = 0 → F x = 0) → HasCompactSupport F := by
    intro F hF
    apply hφS.mono
    intro x hx h0
    exact hx (hF x h0)

  have CS : ∀ g : ℝ³ → ℝ, Continuous g → HasCompactSupport g → (∀ x, 0 ≤ g x) →
      ∫ x, ‖w x‖ * g x ≤ (∫ x, ‖w x‖ ^ 2) ^ ((1 : ℝ) / 2) * (∫ x, g x ^ 2) ^ ((1 : ℝ) / 2) := by
    intro g hgc hgS hg0
    have h := MeasureTheory.integral_mul_le_Lp_mul_Lq_of_nonneg (μ := volume)
      Real.HolderConjugate.two_two
      (Filter.Eventually.of_forall (fun x => norm_nonneg (w x)))
      (Filter.Eventually.of_forall hg0)
      (by rw [ENNReal.ofReal_ofNat]; exact hwL.norm)
      (hgc.memLp_of_hasCompactSupport hgS)
    simpa only [Real.rpow_two] using h

  have chain : ∀ (S X Y Z : ℝ), 0 ≤ S → 0 ≤ X → 0 ≤ Z →
      Y ≤ S ^ ((1 : ℝ) / 2) * Z ^ ((1 : ℝ) / 2) → Z ≤ S ^ ((1 : ℝ) / 2) * X ^ ((1 : ℝ) / 2) →
      Y ≤ S ^ ((3 : ℝ) / 4) * X ^ ((1 : ℝ) / 4) := by
    intro S X Y Z hS hX hZ h1 h2
    have a : Z ^ ((1 : ℝ) / 2) ≤ (S ^ ((1 : ℝ) / 2) * X ^ ((1 : ℝ) / 2)) ^ ((1 : ℝ) / 2) :=
      Real.rpow_le_rpow hZ h2 (by norm_num)
    have q : (1 : ℝ) / 2 * ((1 : ℝ) / 2) = (1 : ℝ) / 4 := by norm_num
    rw [Real.mul_rpow (Real.rpow_nonneg hS _) (Real.rpow_nonneg hX _), ← Real.rpow_mul hS,
      ← Real.rpow_mul hX, q] at a
    have e : S ^ ((3 : ℝ) / 4) = S ^ ((1 : ℝ) / 2) * S ^ ((1 : ℝ) / 4) := by
      rw [← Real.rpow_add' hS (by norm_num)]; norm_num
    calc Y ≤ S ^ ((1 : ℝ) / 2) * Z ^ ((1 : ℝ) / 2) := h1
      _ ≤ S ^ ((1 : ℝ) / 2) * (S ^ ((1 : ℝ) / 4) * X ^ ((1 : ℝ) / 4)) :=
          mul_le_mul_of_nonneg_left a (Real.rpow_nonneg hS _)
      _ = S ^ ((3 : ℝ) / 4) * X ^ ((1 : ℝ) / 4) := by rw [e, mul_assoc]

  have hpt : ∀ x, ‖(‖w x‖ ^ 2 / 2) * fderiv ℝ (fun y => φ y ^ 8) x (w x)‖
      ≤ 4 * c₁ / R * (φ x ^ 6 * ‖w x‖ ^ 3) := by
    intro x
    obtain ⟨h0, h1⟩ := hφb x
    have hL := (fderiv ℝ (fun y => φ y ^ 8) x).le_opNorm (w x)
    have hd := hχd x
    have hp : φ x ^ 7 ≤ φ x ^ 6 := pow_le_pow_of_le_one h0 h1 (by norm_num)
    have ha := norm_nonneg (w x)
    rw [norm_mul, Real.norm_eq_abs (‖w x‖ ^ 2 / 2), abs_of_nonneg (by positivity)]
    calc ‖w x‖ ^ 2 / 2 * ‖fderiv ℝ (fun y => φ y ^ 8) x (w x)‖
        ≤ ‖w x‖ ^ 2 / 2 * (‖fderiv ℝ (fun y => φ y ^ 8) x‖ * ‖w x‖) :=
          mul_le_mul_of_nonneg_left hL (by positivity)
      _ ≤ ‖w x‖ ^ 2 / 2 * ((8 * c₁ / R * φ x ^ 7) * ‖w x‖) := by gcongr
      _ = 4 * c₁ / R * (φ x ^ 7 * ‖w x‖ ^ 3) := by ring
      _ ≤ 4 * c₁ / R * (φ x ^ 6 * ‖w x‖ ^ 3) := by gcongr

  have hg0c : Continuous (fun x => 4 * c₁ / R * (φ x ^ 6 * ‖w x‖ ^ 3)) := by fun_prop
  have hint : Integrable (fun x => 4 * c₁ / R * (φ x ^ 6 * ‖w x‖ ^ 3)) :=
    hg0c.integrable_of_hasCompactSupport (hcs _ (fun x h => by simp [h]))
  have hY : |∫ x, (‖w x‖ ^ 2 / 2) * fderiv ℝ (fun y => φ y ^ 8) x (w x)|
      ≤ ∫ x, 4 * c₁ / R * (φ x ^ 6 * ‖w x‖ ^ 3) := by
    rw [← Real.norm_eq_abs]
    exact norm_integral_le_of_norm_le hint (ae_of_all _ hpt)
  rw [integral_const_mul] at hY

  have hS0 : 0 ≤ ∫ x, ‖w x‖ ^ 2 := integral_nonneg (fun x => by positivity)
  have hX0 : 0 ≤ ∫ x, φ x ^ 24 * ‖w x‖ ^ 6 :=
    integral_nonneg (fun x => by have := (hφb x).1; positivity)
  have hZ0 : 0 ≤ ∫ x, φ x ^ 12 * ‖w x‖ ^ 4 :=
    integral_nonneg (fun x => by have := (hφb x).1; positivity)
  have h1 : (∫ x, φ x ^ 6 * ‖w x‖ ^ 3)
      ≤ (∫ x, ‖w x‖ ^ 2) ^ ((1 : ℝ) / 2) * (∫ x, φ x ^ 12 * ‖w x‖ ^ 4) ^ ((1 : ℝ) / 2) := by
    have h := CS (fun x => φ x ^ 6 * ‖w x‖ ^ 2) (by fun_prop) (hcs _ (fun x h => by simp [h]))
      (fun x => by have := (hφb x).1; positivity)
    have e1 : (∫ x, φ x ^ 6 * ‖w x‖ ^ 3) = ∫ x, ‖w x‖ * (φ x ^ 6 * ‖w x‖ ^ 2) := by
      congr 1; funext x; ring
    have e2 : (∫ x, φ x ^ 12 * ‖w x‖ ^ 4) = ∫ x, (φ x ^ 6 * ‖w x‖ ^ 2) ^ 2 := by
      congr 1; funext x; ring
    rw [e1, e2]; exact h
  have h2 : (∫ x, φ x ^ 12 * ‖w x‖ ^ 4)
      ≤ (∫ x, ‖w x‖ ^ 2) ^ ((1 : ℝ) / 2) * (∫ x, φ x ^ 24 * ‖w x‖ ^ 6) ^ ((1 : ℝ) / 2) := by
    have h := CS (fun x => φ x ^ 12 * ‖w x‖ ^ 3) (by fun_prop) (hcs _ (fun x h => by simp [h]))
      (fun x => by have := (hφb x).1; positivity)
    have e1 : (∫ x, φ x ^ 12 * ‖w x‖ ^ 4) = ∫ x, ‖w x‖ * (φ x ^ 12 * ‖w x‖ ^ 3) := by
      congr 1; funext x; ring
    have e2 : (∫ x, φ x ^ 24 * ‖w x‖ ^ 6) = ∫ x, (φ x ^ 12 * ‖w x‖ ^ 3) ^ 2 := by
      congr 1; funext x; ring
    rw [e1, e2]; exact h

  have hYX := chain _ _ _ _ hS0 hX0 hZ0 h1 h2
  exact hY.trans (mul_le_mul_of_nonneg_left hYX hk0)

theorem localized_energy_identity : ∀ (ν c : ℝ) (w u D : ℝ³ → ℝ³) (π q χ : ℝ³ → ℝ), ContDiff ℝ ∞ w → ContDiff ℝ ∞ u → ContDiff ℝ ∞ π → ContDiff ℝ ∞ χ → HasCompactSupport χ → (∀ x, divergence w x = 0) → (∀ x, divergence u x = 0) → (∀ x, fderiv ℝ χ x (u x) = 0) → (∀ x, π x = q x + c) → (∀ x, D x + fderiv ℝ w x (w x + u x) + fderiv ℝ u x (w x) = ν • Δ w x - gradient π x) → ∫ x, χ x * (2 * inner ℝ (w x) (D x)) = 2 * ((∫ x, (‖w x‖ ^ 2 / 2) * fderiv ℝ χ x (w x)) + (∫ x, q x * inner ℝ (w x) (gradient χ x)) - ν * (∫ x, ∑ j : Fin 3, inner ℝ (fderiv ℝ w x (EuclideanSpace.single j 1)) (w x) * fderiv ℝ χ x (EuclideanSpace.single j 1)) - ν * (∫ x, χ x * ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2) - (∫ x, χ x * inner ℝ (w x) (fderiv ℝ u x (w x)))) :=
by
  intro ν c w u D π q χ hw hu hπ hχ hχS hdivw hdivu hχu hπq hD

  have hχ1 : ContDiff ℝ 1 χ := hχ.of_le (by simp)
  have hw1 : ContDiff ℝ 1 w := hw.of_le (by simp)
  have hu1 : ContDiff ℝ 1 u := hu.of_le (by simp)
  have hπ1 : ContDiff ℝ 1 π := hπ.of_le (by simp)
  have hDw1 : ContDiff ℝ 1 (fderiv ℝ w) := hw.fderiv_right (by simp)
  have hχd : Differentiable ℝ χ := hχ1.differentiable one_ne_zero
  have hDχc : Continuous (fderiv ℝ χ) := hχ1.continuous_fderiv one_ne_zero
  have hDwc : ∀ j : Fin 3, Continuous (fun x => fderiv ℝ w x (EuclideanSpace.single j 1)) :=
    fun j => (hw1.continuous_fderiv one_ne_zero).clm_apply continuous_const
  have hqeq : q = fun x => π x - c := funext fun x => by rw [hπq x]; ring
  have hqc : Continuous q := by rw [hqeq]; exact hπ.continuous.sub continuous_const

  have hsuppD : ∀ G : ℝ³ → ℝ, (∀ x, fderiv ℝ χ x = 0 → G x = 0) → HasCompactSupport G := by
    intro G hG
    apply hχS.mono'
    intro x hx
    apply support_fderiv_subset ℝ
    exact Function.mem_support.mpr (fun h0 => (Function.mem_support.mp hx) (hG x h0))
  have intχ : ∀ g : ℝ³ → ℝ, Continuous g → Integrable (fun x => χ x * g x) := fun g hg =>
    (hχ1.continuous.mul hg).integrable_of_hasCompactSupport hχS.mul_right
  have intD : ∀ (g : ℝ³ → ℝ) (v : ℝ³ → ℝ³), Continuous g → Continuous v →
      Integrable (fun x => g x * fderiv ℝ χ x (v x)) := by
    intro g v hg hv
    refine (hg.mul (hDχc.clm_apply hv)).integrable_of_hasCompactSupport (hsuppD _ ?_)
    intro x h0
    simp [h0]

  have hsum : ∀ v : ℝ³, ∑ k : Fin 3, v k • EuclideanSpace.single k (1:ℝ) = v := fun v => by
    have h := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr v
    simpa [EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply] using h

  have ibp : ∀ Φ : ℝ³ → ℝ³, ContDiff ℝ 1 Φ →
      Integrable (fun x => χ x * divergence Φ x) ∧
        ∫ x, χ x * divergence Φ x = -∫ x, fderiv ℝ χ x (Φ x) := by
    intro Φ hΦ
    have hΦd : Differentiable ℝ Φ := hΦ.differentiable one_ne_zero
    have hcoordC : ∀ k : Fin 3, ContDiff ℝ 1 (fun y => Φ y k) := fun k =>
      (EuclideanSpace.proj k : ℝ³ →L[ℝ] ℝ).contDiff.comp hΦ
    have hfd : ∀ k : Fin 3, ∀ x, fderiv ℝ (fun y => Φ y k) x (EuclideanSpace.single k 1)
        = (fderiv ℝ Φ x (EuclideanSpace.single k 1)) k := by
      intro k x
      have h : HasFDerivAt (fun y => Φ y k)
          ((EuclideanSpace.proj k : ℝ³ →L[ℝ] ℝ).comp (fderiv ℝ Φ x)) x :=
        (EuclideanSpace.proj k : ℝ³ →L[ℝ] ℝ).hasFDerivAt.comp x (hΦd x).hasFDerivAt
      rw [h.fderiv]
      rfl
    have hdiv : ∀ x, divergence Φ x
        = ∑ k : Fin 3, fderiv ℝ (fun y => Φ y k) x (EuclideanSpace.single k 1) := by
      intro x
      unfold divergence
      rw [LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin 3) ℝ)]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [hfd k x, EuclideanSpace.basisFun_apply, EuclideanSpace.inner_single_left]
      simp
    have hexp : ∀ x, fderiv ℝ χ x (Φ x)
        = ∑ k : Fin 3, fderiv ℝ χ x (EuclideanSpace.single k 1) * Φ x k := by
      intro x
      conv_lhs => rw [← hsum (Φ x)]
      rw [map_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [map_smul, smul_eq_mul, mul_comm]
    have hk : ∀ k : Fin 3,
        Integrable (fun x => χ x * fderiv ℝ (fun y => Φ y k) x (EuclideanSpace.single k 1)) ∧
        Integrable (fun x => fderiv ℝ χ x (EuclideanSpace.single k 1) * Φ x k) ∧
        ∫ x, χ x * fderiv ℝ (fun y => Φ y k) x (EuclideanSpace.single k 1)
          = -∫ x, fderiv ℝ χ x (EuclideanSpace.single k 1) * Φ x k := by
      intro k
      have hc1 : Continuous (fun x => fderiv ℝ (fun y => Φ y k) x (EuclideanSpace.single k 1)) :=
        ((hcoordC k).continuous_fderiv one_ne_zero).clm_apply continuous_const
      have I1 := intχ _ hc1
      have I2 : Integrable (fun x => fderiv ℝ χ x (EuclideanSpace.single k 1) * Φ x k) := by
        have := intD (fun x => Φ x k) (fun _ => EuclideanSpace.single k 1)
          (hcoordC k).continuous continuous_const
        exact this.congr (Filter.Eventually.of_forall (fun x => mul_comm _ _))
      have I3 := intχ _ (hcoordC k).continuous
      refine ⟨I1, I2, ?_⟩
      exact integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable I2 I1 I3
        (fun x _ => hχd x) (fun x _ => (hcoordC k).differentiable one_ne_zero x)
    have hP : (fun x => χ x * divergence Φ x)
        = fun x => ∑ k : Fin 3, χ x * fderiv ℝ (fun y => Φ y k) x (EuclideanSpace.single k 1) := by
      funext x
      rw [hdiv x, Finset.mul_sum]
    have hE : (fun x => fderiv ℝ χ x (Φ x))
        = fun x => ∑ k : Fin 3, fderiv ℝ χ x (EuclideanSpace.single k 1) * Φ x k := funext hexp
    refine ⟨?_, ?_⟩
    · rw [hP]
      exact integrable_finsetSum _ (fun k _ => (hk k).1)
    · rw [hP, hE, integral_finsetSum _ (fun k _ => (hk k).1),
        integral_finsetSum _ (fun k _ => (hk k).2.1), ← Finset.sum_neg_distrib]
      exact Finset.sum_congr rfl (fun k _ => (hk k).2.2)

  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ℝ³ → ℝ³, Ψ = fun y => (‖w y‖ ^ 2 / 2) • (w y + u y) + π y • w y
      - ν • ∑ j : Fin 3, (inner ℝ (fderiv ℝ w y (EuclideanSpace.single j 1)) (w y))
          • EuclideanSpace.single j 1 := ⟨_, rfl⟩
  have hΨ1 : ContDiff ℝ 1 Ψ := by
    have h3 : ContDiff ℝ 1 (fun y => ∑ j : Fin 3, (inner ℝ (fderiv ℝ w y
        (EuclideanSpace.single j 1)) (w y)) • (EuclideanSpace.single j 1 : ℝ³)) := by
      apply ContDiff.sum
      intro j _
      exact ((hDw1.clm_apply contDiff_const).inner ℝ hw1).smul contDiff_const
    rw [hΨ]
    exact ((((hw1.norm_sq ℝ).div_const 2).smul (hw1.add hu1)).add (hπ1.smul hw1)).sub
      (h3.const_smul ν)

  have eflux : ∀ (V w : ℝ³ → ℝ³) (q : ℝ³ → ℝ) (x : ℝ³), ContDiff ℝ ∞ V → ContDiff ℝ ∞ w →
      ContDiff ℝ ∞ q → inner ℝ (w x) (-(fderiv ℝ w x (V x)) + ν • Δ w x - gradient q x)
        = -divergence (fun y => (‖w y‖ ^ 2 / 2) • V y + q y • w y - ν • ∑ j : Fin 3,
          (inner ℝ (fderiv ℝ w y (EuclideanSpace.single j 1)) (w y)) • EuclideanSpace.single j 1) x
          - ν * ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2
          + (‖w x‖ ^ 2 / 2) * divergence V x + q x * divergence w x := by
    intro V w q x hV hw hq
    have hVd : Differentiable ℝ V := hV.differentiable (by simp)
    have hwd : Differentiable ℝ w := hw.differentiable (by simp)
    have hqd : Differentiable ℝ q := hq.differentiable (by simp)
    have hD1 : ContDiff ℝ 1 (fderiv ℝ w) := hw.fderiv_right (by simp)
    have hDd : Differentiable ℝ (fderiv ℝ w) := hD1.differentiable (by simp)
    have c1 : ∀ (a : ℝ³ → ℝ) (F : ℝ³ → ℝ³), DifferentiableAt ℝ a x → DifferentiableAt ℝ F x →
        divergence (fun y => a y • F y) x = fderiv ℝ a x (F x) + a x * divergence F x := by
      intro a F ha hF
      unfold divergence
      rw [fderiv_fun_smul ha hF]
      simp only [ContinuousLinearMap.coe_add, ContinuousLinearMap.coe_smul,
        ContinuousLinearMap.coe_smulRight, map_add, map_smul, LinearMap.trace_smulRight, smul_eq_mul,
        ContinuousLinearMap.coe_coe]
      ring
    have c2 : ∀ (c : Fin 3 → ℝ³ → ℝ), (∀ j, DifferentiableAt ℝ (c j) x) →
        divergence (fun y => ∑ j : Fin 3, c j y • EuclideanSpace.single j (1:ℝ)) x
          = ∑ j : Fin 3, fderiv ℝ (c j) x (EuclideanSpace.single j 1) := by
      intro c hc
      unfold divergence
      rw [fderiv_fun_sum (A := fun j y => c j y • EuclideanSpace.single j (1:ℝ))
        (fun j _ => (hc j).smul_const _)]
      have h : ∀ j, fderiv ℝ (fun y => c j y • EuclideanSpace.single j (1:ℝ)) x
          = (fderiv ℝ (c j) x).smulRight (EuclideanSpace.single j (1:ℝ)) :=
        fun j => fderiv_smul_const (hc j) _
      simp only [h, ContinuousLinearMap.coe_sum, ContinuousLinearMap.coe_smulRight, map_sum,
        LinearMap.trace_smulRight, ContinuousLinearMap.coe_coe]
    have c6 : ∀ (A B C : ℝ³ → ℝ³), DifferentiableAt ℝ A x → DifferentiableAt ℝ B x →
        DifferentiableAt ℝ C x →
        divergence (fun y => A y + B y - ν • C y) x
          = divergence A x + divergence B x - ν * divergence C x := by
      intro A B C hA hB hC
      unfold divergence
      have hAB : DifferentiableAt ℝ (fun y => A y + B y) x := hA.add hB
      have hνC : DifferentiableAt ℝ (fun y => ν • C y) x := hC.const_smul ν
      rw [fderiv_fun_sub hAB hνC, fderiv_fun_add hA hB, fderiv_fun_const_smul hC ν]
      simp only [ContinuousLinearMap.coe_sub, ContinuousLinearMap.coe_add,
        ContinuousLinearMap.coe_smul, map_sub, map_add, map_smul, smul_eq_mul]
    have c4 : ∀ h : ℝ³, fderiv ℝ (fun y => ‖w y‖ ^ 2 / 2) x h = inner ℝ (w x) (fderiv ℝ w x h) := by
      intro h
      have H : HasFDerivAt (fun y => ‖w y‖ ^ 2 * 2⁻¹)
          ((2⁻¹ : ℝ) • (2 • (innerSL ℝ (w x)).comp (fderiv ℝ w x))) x :=
        ((hwd x).hasFDerivAt.norm_sq).mul_const _
      have e : (fun y => ‖w y‖ ^ 2 / 2) = fun y => ‖w y‖ ^ 2 * 2⁻¹ := by
        funext y; ring
      rw [e, H.fderiv]
      simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.comp_apply,
        innerSL_apply_apply, smul_eq_mul, nsmul_eq_mul]
      ring
    have c5 : ∀ u h : ℝ³, fderiv ℝ (fun y => inner ℝ (fderiv ℝ w y u) (w y)) x h
        = inner ℝ (fderiv ℝ (fun y => fderiv ℝ w y u) x h) (w x)
          + inner ℝ (fderiv ℝ w x u) (fderiv ℝ w x h) := by
      intro u h
      have hf : DifferentiableAt ℝ (fun y => fderiv ℝ w y u) x :=
        (hDd x).clm_apply (differentiableAt_const u)
      rw [fderiv_inner_apply ℝ hf (hwd x) h]
      ring
    have c3 : Δ w x = ∑ j : Fin 3, fderiv ℝ (fun y => fderiv ℝ w y (EuclideanSpace.single j 1)) x
        (EuclideanSpace.single j 1) := by
      rw [congrFun (InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis w
        (EuclideanSpace.basisFun (Fin 3) ℝ)) x]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [iteratedFDeriv_two_apply, EuclideanSpace.basisFun_apply]
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      rw [fderiv_clm_apply (hDd x) (differentiableAt_const _)]
      simp
    have hcj : ∀ j : Fin 3, DifferentiableAt ℝ
        (fun y => inner ℝ (fderiv ℝ w y (EuclideanSpace.single j 1)) (w y)) x :=
      fun j => ((hDd x).clm_apply (differentiableAt_const _)).inner ℝ (hwd x)
    have hN : DifferentiableAt ℝ (fun y => ‖w y‖ ^ 2 / 2) x :=
      (((hw.of_le (by simp) : ContDiff ℝ 1 w).norm_sq ℝ).div_const 2).differentiable (by simp) x
    have hA : DifferentiableAt ℝ (fun y => (‖w y‖ ^ 2 / 2) • V y) x := hN.smul (hVd x)
    have hB : DifferentiableAt ℝ (fun y => q y • w y) x := (hqd x).smul (hwd x)
    have hC : DifferentiableAt ℝ (fun y => ∑ j : Fin 3,
        (inner ℝ (fderiv ℝ w y (EuclideanSpace.single j 1)) (w y)) • EuclideanSpace.single j (1:ℝ)) x := by
      exact DifferentiableAt.fun_sum (fun j _ => (hcj j).smul_const _)
    have hgq : fderiv ℝ q x (w x) = inner ℝ (gradient q x) (w x) := (inner_gradient_left).symm
    rw [c6 _ _ _ hA hB hC, c1 _ _ hN (hVd x), c1 _ _ (hqd x) (hwd x), c2 _ hcj, c4, hgq]
    simp only [c5]
    rw [Finset.sum_add_distrib, ← sum_inner, ← c3]
    simp only [real_inner_self_eq_norm_sq, inner_add_right, inner_sub_right, inner_neg_right,
      real_inner_smul_right]
    rw [real_inner_comm (w x) (gradient q x), real_inner_comm (w x) (Δ w x)]
    ring

  have hpt : ∀ x, inner ℝ (w x) (D x) = -divergence Ψ x
      - ν * ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2
      - inner ℝ (w x) (fderiv ℝ u x (w x)) := by
    intro x
    have hflux := eflux (fun y => w y + u y) w π x (hw.add hu) hw hπ
    have hdivwu : divergence (fun y => w y + u y) x = 0 := by
      rw [divergence_add (hw1.differentiable one_ne_zero x) (hu1.differentiable one_ne_zero x),
        hdivw x, hdivu x, add_zero]
    have hDx : D x = (-(fderiv ℝ w x (w x + u x)) + ν • Δ w x - gradient π x)
        - fderiv ℝ u x (w x) := by
      have h := hD x
      calc D x = (D x + fderiv ℝ w x (w x + u x) + fderiv ℝ u x (w x))
            - fderiv ℝ w x (w x + u x) - fderiv ℝ u x (w x) := by abel
        _ = _ := by rw [h]; abel
    have hflux' : inner ℝ (w x) (-(fderiv ℝ w x (w x + u x)) + ν • Δ w x - gradient π x)
        = -divergence Ψ x - ν * ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2
          + (‖w x‖ ^ 2 / 2) * divergence (fun y => w y + u y) x + π x * divergence w x := by
      rw [hΨ]
      exact hflux
    rw [hDx, inner_sub_right, hflux', hdivwu, hdivw x]
    ring

  have hgradχ : ∀ x, inner ℝ (w x) (gradient χ x) = fderiv ℝ χ x (w x) := fun x => by
    rw [real_inner_comm, inner_gradient_left]
  have hQ : ∀ x, fderiv ℝ χ x (Ψ x) = (‖w x‖ ^ 2 / 2) * fderiv ℝ χ x (w x)
      + q x * inner ℝ (w x) (gradient χ x) + c * fderiv ℝ χ x (w x)
      - ν * ∑ j : Fin 3, inner ℝ (fderiv ℝ w x (EuclideanSpace.single j 1)) (w x)
          * fderiv ℝ χ x (EuclideanSpace.single j 1) := by
    intro x
    rw [hΨ, hgradχ x]
    simp only [map_sub, map_add, map_smul, map_sum, smul_eq_mul, hχu x, hπq x]
    ring

  obtain ⟨IΨ, eqΨ⟩ := ibp Ψ hΨ1
  have Zw : ∫ x, fderiv ℝ χ x (w x) = 0 := by
    have h := (ibp w hw1).2
    simp only [hdivw, mul_zero, integral_zero] at h
    linarith

  have IS : Integrable (fun x => χ x * ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2) :=
    intχ _ (continuous_finsetSum _ (fun j _ => ((hDwc j).norm).pow 2))
  have IL : Integrable (fun x => χ x * inner ℝ (w x) (fderiv ℝ u x (w x))) :=
    intχ _ (hw.continuous.inner ((hu1.continuous_fderiv one_ne_zero).clm_apply hw.continuous))
  have Itr : Integrable (fun x => (‖w x‖ ^ 2 / 2) * fderiv ℝ χ x (w x)) :=
    intD (fun x => ‖w x‖ ^ 2 / 2) w ((hw.continuous.norm.pow 2).div_const 2) hw.continuous
  have Ip : Integrable (fun x => q x * inner ℝ (w x) (gradient χ x)) := by
    have := intD q w hqc hw.continuous
    refine this.congr (Filter.Eventually.of_forall (fun x => ?_))
    simp only [hgradχ x]
  have Ic : Integrable (fun x => c * fderiv ℝ χ x (w x)) :=
    intD (fun _ => c) w continuous_const hw.continuous
  have Iv : Integrable (fun x => ∑ j : Fin 3, inner ℝ (fderiv ℝ w x (EuclideanSpace.single j 1)) (w x)
      * fderiv ℝ χ x (EuclideanSpace.single j 1)) :=
    integrable_finsetSum _ (fun j _ => intD (fun x => inner ℝ (fderiv ℝ w x
      (EuclideanSpace.single j 1)) (w x)) (fun _ => EuclideanSpace.single j 1)
      ((hDwc j).inner hw.continuous) continuous_const)

  have hL : (fun x => χ x * (2 * inner ℝ (w x) (D x)))
      = fun x => (-2) * (χ x * divergence Ψ x)
        - (2 * ν) * (χ x * ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2)
        - 2 * (χ x * inner ℝ (w x) (fderiv ℝ u x (w x))) := by
    funext x
    rw [hpt x]
    ring
  have I1 : Integrable (fun x => (-2) * (χ x * divergence Ψ x)
      - (2 * ν) * (χ x * ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2)) :=
    (IΨ.const_mul _).sub (IS.const_mul _)
  have e1 : ∫ x, χ x * (2 * inner ℝ (w x) (D x))
      = (-2) * (∫ x, χ x * divergence Ψ x)
        - (2 * ν) * (∫ x, χ x * ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2)
        - 2 * (∫ x, χ x * inner ℝ (w x) (fderiv ℝ u x (w x))) := by
    rw [hL, integral_sub I1 (IL.const_mul _), integral_sub (IΨ.const_mul _) (IS.const_mul _),
      integral_const_mul, integral_const_mul, integral_const_mul]
  have hR : (fun x => fderiv ℝ χ x (Ψ x)) = fun x => (‖w x‖ ^ 2 / 2) * fderiv ℝ χ x (w x)
      + q x * inner ℝ (w x) (gradient χ x) + c * fderiv ℝ χ x (w x)
      - ν * ∑ j : Fin 3, inner ℝ (fderiv ℝ w x (EuclideanSpace.single j 1)) (w x)
          * fderiv ℝ χ x (EuclideanSpace.single j 1) := funext hQ
  have I12 : Integrable (fun x => (‖w x‖ ^ 2 / 2) * fderiv ℝ χ x (w x)
      + q x * inner ℝ (w x) (gradient χ x)) := Itr.add Ip
  have I123 : Integrable (fun x => (‖w x‖ ^ 2 / 2) * fderiv ℝ χ x (w x)
      + q x * inner ℝ (w x) (gradient χ x) + c * fderiv ℝ χ x (w x)) := I12.add Ic
  have e2 : ∫ x, fderiv ℝ χ x (Ψ x)
      = (∫ x, (‖w x‖ ^ 2 / 2) * fderiv ℝ χ x (w x)) + (∫ x, q x * inner ℝ (w x) (gradient χ x))
        + c * (∫ x, fderiv ℝ χ x (w x))
        - ν * (∫ x, ∑ j : Fin 3, inner ℝ (fderiv ℝ w x (EuclideanSpace.single j 1)) (w x)
          * fderiv ℝ χ x (EuclideanSpace.single j 1)) := by
    rw [hR, integral_sub I123 (Iv.const_mul ν), integral_add I12 Ic, integral_add Itr Ip,
      integral_const_mul, integral_const_mul]
  rw [e1, eqΨ, e2, Zw]
  ring

theorem viscous_cross_term_bound : ∀ (φ : ℝ³ → ℝ) (w : ℝ³ → ℝ³) (c₁ R ν : ℝ), 0 < R → 0 ≤ ν → ContDiff ℝ ∞ φ → HasCompactSupport φ → (∀ x, 0 ≤ φ x ∧ φ x ≤ 1) → (∀ x, ‖fderiv ℝ (fun y => φ y ^ 8) x‖ ≤ 8 * c₁ / R * φ x ^ 7) → ContDiff ℝ ∞ w → MemLp w 2 → |ν * ∫ x, ∑ j : Fin 3, inner ℝ (fderiv ℝ w x (EuclideanSpace.single j 1)) (w x) * fderiv ℝ (fun y => φ y ^ 8) x (EuclideanSpace.single j 1)| ≤ ν * ((1 / 4) * (∫ x, φ x ^ 8 * ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2) + 192 * c₁ ^ 2 / R ^ 2 * ∫ x, ‖w x‖ ^ 2) :=
by
  intro φ w c₁ R ν hR hν hφC hφS hφb hχd hwC hw2

  have hterm : ∀ (x : ℝ³) (j : Fin 3),
      |inner ℝ (fderiv ℝ w x (EuclideanSpace.single j 1)) (w x) *
          fderiv ℝ (fun y => φ y ^ 8) x (EuclideanSpace.single j 1)| ≤
        (1 / 4) * φ x ^ 8 * ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2 +
          64 * c₁ ^ 2 / R ^ 2 * ‖w x‖ ^ 2 := by
    intro x j
    have ha₀ : 0 ≤ ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ := norm_nonneg _
    have hN : 0 ≤ ‖w x‖ := norm_nonneg _
    have hp0 : 0 ≤ φ x := (hφb x).1
    have hp1 : φ x ≤ 1 := (hφb x).2
    have hin : |inner ℝ (fderiv ℝ w x (EuclideanSpace.single j 1)) (w x)| ≤
        ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ * ‖w x‖ := abs_real_inner_le_norm _ _
    have hsingle : ‖(EuclideanSpace.single j (1:ℝ) : ℝ³)‖ = 1 := by simp
    have hD : |fderiv ℝ (fun y => φ y ^ 8) x (EuclideanSpace.single j 1)| ≤
        8 * c₁ / R * φ x ^ 7 := by
      rw [← Real.norm_eq_abs]
      calc ‖fderiv ℝ (fun y => φ y ^ 8) x (EuclideanSpace.single j 1)‖
          ≤ ‖fderiv ℝ (fun y => φ y ^ 8) x‖ * ‖(EuclideanSpace.single j (1:ℝ) : ℝ³)‖ :=
            ContinuousLinearMap.le_opNorm _ _
        _ = ‖fderiv ℝ (fun y => φ y ^ 8) x‖ := by rw [hsingle, mul_one]
        _ ≤ 8 * c₁ / R * φ x ^ 7 := hχd x
    have h1 : |inner ℝ (fderiv ℝ w x (EuclideanSpace.single j 1)) (w x) *
          fderiv ℝ (fun y => φ y ^ 8) x (EuclideanSpace.single j 1)| ≤
        ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ * ‖w x‖ * (8 * c₁ / R * φ x ^ 7) := by
      rw [abs_mul]
      exact mul_le_mul hin hD (abs_nonneg _) (mul_nonneg ha₀ hN)
    have alg : ∀ a N p k : ℝ, 0 ≤ p → p ≤ 1 →
        a * N * (k * p ^ 7) ≤ (1 / 4) * p ^ 8 * a ^ 2 + k ^ 2 * N ^ 2 := by
      intro a N p k hp0 hp1
      have h2 : a * N * (k * p ^ 7) ≤ (1 / 4) * p ^ 8 * a ^ 2 + k ^ 2 * p ^ 6 * N ^ 2 := by
        nlinarith [sq_nonneg (p ^ 4 * a / 2 - k * p ^ 3 * N)]
      have hp6 : p ^ 6 ≤ 1 := pow_le_one₀ hp0 hp1
      have hkN : 0 ≤ k ^ 2 * N ^ 2 := by positivity
      have h3 : k ^ 2 * p ^ 6 * N ^ 2 ≤ k ^ 2 * N ^ 2 := by
        have := mul_le_mul_of_nonneg_left hp6 hkN
        nlinarith
      linarith
    have hk : (8 * c₁ / R) ^ 2 = 64 * c₁ ^ 2 / R ^ 2 := by
      rw [div_pow]; ring
    have := alg ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ‖w x‖ (φ x) (8 * c₁ / R) hp0 hp1
    rw [hk] at this
    linarith

  have hpt : ∀ x : ℝ³,
      |∑ j : Fin 3, inner ℝ (fderiv ℝ w x (EuclideanSpace.single j 1)) (w x) *
          fderiv ℝ (fun y => φ y ^ 8) x (EuclideanSpace.single j 1)| ≤
        (1 / 4) * (φ x ^ 8 * ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2) +
          192 * c₁ ^ 2 / R ^ 2 * ‖w x‖ ^ 2 := by
    intro x
    refine (Finset.abs_sum_le_sum_abs _ _).trans
      ((Finset.sum_le_sum (fun j _ => hterm x j)).trans (le_of_eq ?_))
    simp only [Fin.sum_univ_three]
    ring

  have hA : Integrable (fun x : ℝ³ =>
      φ x ^ 8 * ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2) := by
    apply Continuous.integrable_of_hasCompactSupport
    · have hfd : Continuous (fderiv ℝ w) := hwC.continuous_fderiv (by simp)
      refine (hφC.continuous.pow 8).mul ?_
      refine continuous_finset_sum _ (fun j _ => ?_)
      exact ((hfd.clm_apply continuous_const).norm).pow 2
    · have h8 : HasCompactSupport (fun x => φ x ^ 8) :=
        hφS.comp_left (g := fun t : ℝ => t ^ 8) (by norm_num)
      exact h8.mul_right
        (f' := fun x => ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2)
  have hB : Integrable (fun x : ℝ³ => ‖w x‖ ^ 2) :=
    (memLp_two_iff_integrable_sq_norm hw2.aestronglyMeasurable).mp hw2
  have hg : Integrable (fun x : ℝ³ =>
      (1 / 4) * (φ x ^ 8 * ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2) +
        192 * c₁ ^ 2 / R ^ 2 * ‖w x‖ ^ 2) :=
    (hA.const_mul _).add (hB.const_mul _)

  have hmono := integral_mono_of_nonneg
    (Filter.Eventually.of_forall (fun x => abs_nonneg
      (∑ j : Fin 3, inner ℝ (fderiv ℝ w x (EuclideanSpace.single j 1)) (w x) *
          fderiv ℝ (fun y => φ y ^ 8) x (EuclideanSpace.single j 1)))) hg
    (Filter.Eventually.of_forall hpt)
  rw [integral_add (hA.const_mul _) (hB.const_mul _), integral_const_mul,
    integral_const_mul] at hmono

  rw [abs_mul, abs_of_nonneg hν]
  apply mul_le_mul_of_nonneg_left _ hν
  exact (abs_integral_le_integral_abs).trans hmono

theorem linear_term_bound : ∀ (χ : ℝ³ → ℝ) (w u : ℝ³ → ℝ³) (L : ℝ), Continuous χ → HasCompactSupport χ → (∀ x, 0 ≤ χ x) → ContDiff ℝ ∞ w → ContDiff ℝ ∞ u → (∀ x, ‖fderiv ℝ u x‖ ≤ L) → |∫ x, χ x * inner ℝ (w x) (fderiv ℝ u x (w x))| ≤ L * ∫ x, χ x * ‖w x‖ ^ 2 :=
by
  intro χ w u L hχc hχs hχ0 hw hu hL
  have hwc : Continuous w := hw.continuous
  have hgc : Continuous (fun x => L * (χ x * ‖w x‖ ^ 2)) :=
    continuous_const.mul (hχc.mul (hwc.norm.pow 2))
  have hgs : HasCompactSupport (fun x => L * (χ x * ‖w x‖ ^ 2)) :=
    (hχs.mul_right (f' := fun x => ‖w x‖ ^ 2)).mul_left
  have hgi : Integrable (fun x => L * (χ x * ‖w x‖ ^ 2)) :=
    hgc.integrable_of_hasCompactSupport hgs
  have hpt : ∀ x, ‖χ x * inner ℝ (w x) (fderiv ℝ u x (w x))‖ ≤ L * (χ x * ‖w x‖ ^ 2) := by
    intro x
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hχ0 x)]
    have h1 : |inner ℝ (w x) (fderiv ℝ u x (w x))| ≤ ‖w x‖ * ‖fderiv ℝ u x (w x)‖ :=
      abs_real_inner_le_norm _ _
    have h2 : ‖fderiv ℝ u x (w x)‖ ≤ L * ‖w x‖ :=
      le_trans ((fderiv ℝ u x).le_opNorm (w x))
        (mul_le_mul_of_nonneg_right (hL x) (norm_nonneg _))
    have h3 : ‖w x‖ * ‖fderiv ℝ u x (w x)‖ ≤ ‖w x‖ * (L * ‖w x‖) :=
      mul_le_mul_of_nonneg_left h2 (norm_nonneg _)
    calc χ x * |inner ℝ (w x) (fderiv ℝ u x (w x))|
        ≤ χ x * (‖w x‖ * (L * ‖w x‖)) :=
          mul_le_mul_of_nonneg_left (le_trans h1 h3) (hχ0 x)
      _ = L * (χ x * ‖w x‖ ^ 2) := by ring
  have hmain := norm_integral_le_of_norm_le hgi (Filter.Eventually.of_forall hpt)
  rw [integral_const_mul] at hmain
  rw [← Real.norm_eq_abs]
  exact hmain

theorem energy_scalar_closure : ∀ (ν c₁ C₀ C K L R E a X S Jtr Jp Jvc Jlin : ℝ), 0 < ν → 0 ≤ c₁ → 1 ≤ R → 0 ≤ a → 0 ≤ X → 0 ≤ S → S ≤ C₀ → X ^ ((1 : ℝ) / 6) ≤ K * (1 + a ^ ((1 : ℝ) / 2)) → |Jtr| ≤ 4 * c₁ / R * (S ^ ((3 : ℝ) / 4) * X ^ ((1 : ℝ) / 4)) → |Jp| ≤ C / R * (1 + a ^ ((3 : ℝ) / 4)) → |Jvc| ≤ ν * ((1 / 4) * a + 192 * c₁ ^ 2 / R ^ 2 * S) → |Jlin| ≤ L * E → 4 * (8 * c₁ * C₀ ^ ((3 : ℝ) / 4) * K ^ 2 + max C 0) / (3 * ν) ≤ R → 2 * (Jtr + Jp - Jvc - ν * a - Jlin) ≤ 2 * L * E + 2 * (4 * c₁ * C₀ ^ ((3 : ℝ) / 4) * (1 + 2 * K ^ 2) + 2 * max C 0 + 192 * ν * c₁ ^ 2 * C₀) / R :=
by
  intro ν c₁ C₀ C K L R E a X S Jtr Jp Jvc Jlin hν hc₁ hR ha hX hS hSC h8 h9 h10 h11 h12 h13
  have hRpos : 0 < R := by linarith

  have s1 : a ^ ((3 : ℝ) / 4) ≤ 1 + a := by
    rcases le_total a 1 with h | h
    · have := Real.rpow_le_one ha h (by norm_num : (0:ℝ) ≤ 3 / 4)
      linarith
    · have := Real.rpow_le_rpow_of_exponent_le h (by norm_num : (3:ℝ) / 4 ≤ 1)
      rw [Real.rpow_one] at this
      linarith

  have hy0 : 0 ≤ X ^ ((1 : ℝ) / 6) := Real.rpow_nonneg hX _
  have hy2 : (X ^ ((1 : ℝ) / 6)) ^ 2 = X ^ ((1 : ℝ) / 3) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hX]; norm_num
  have hs2 : (a ^ ((1 : ℝ) / 2)) ^ 2 = a := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul ha]; norm_num
  have hq : X ^ ((1 : ℝ) / 4) ≤ 1 + X ^ ((1 : ℝ) / 3) := by
    have h3 : 0 ≤ X ^ ((1 : ℝ) / 3) := Real.rpow_nonneg hX _
    rcases le_total X 1 with h | h
    · have := Real.rpow_le_one hX h (by norm_num : (0:ℝ) ≤ 1 / 4)
      linarith
    · have := Real.rpow_le_rpow_of_exponent_le h (by norm_num : (1:ℝ) / 4 ≤ 1 / 3)
      linarith
  have hyK : (X ^ ((1 : ℝ) / 6)) ^ 2 ≤ (K * (1 + a ^ ((1 : ℝ) / 2))) ^ 2 :=
    pow_le_pow_left₀ hy0 h8 2
  have hK2 : (K * (1 + a ^ ((1 : ℝ) / 2))) ^ 2 ≤ 2 * K ^ 2 * (1 + a) := by
    set s := a ^ ((1 : ℝ) / 2) with hs
    have e1 : K ^ 2 * s ^ 2 = K ^ 2 * a := by rw [hs2]
    nlinarith [mul_nonneg (sq_nonneg K) (sq_nonneg (s - 1)), e1]
  have hQ : X ^ ((1 : ℝ) / 4) ≤ 1 + 2 * K ^ 2 * (1 + a) := by linarith

  have hP : S ^ ((3 : ℝ) / 4) ≤ C₀ ^ ((3 : ℝ) / 4) := Real.rpow_le_rpow hS hSC (by norm_num)
  have hS34 : 0 ≤ S ^ ((3 : ℝ) / 4) := Real.rpow_nonneg hS _
  have hX14 : 0 ≤ X ^ ((1 : ℝ) / 4) := Real.rpow_nonneg hX _
  have hPQ : S ^ ((3 : ℝ) / 4) * X ^ ((1 : ℝ) / 4)
      ≤ C₀ ^ ((3 : ℝ) / 4) * (1 + 2 * K ^ 2 * (1 + a)) :=
    mul_le_mul hP hQ hX14 (le_trans hS34 hP)
  have hc : 0 ≤ 4 * c₁ / R := by positivity
  have hTr : Jtr ≤ 4 * c₁ / R * (C₀ ^ ((3 : ℝ) / 4) * (1 + 2 * K ^ 2 * (1 + a))) :=
    le_trans (le_abs_self _) (le_trans h9 (mul_le_mul_of_nonneg_left hPQ hc))

  have hM : C ≤ max C 0 := le_max_left _ _
  have hM0 : 0 ≤ max C 0 := le_max_right _ _
  have ha34 : 0 ≤ a ^ ((3 : ℝ) / 4) := Real.rpow_nonneg ha _
  have hPr : Jp ≤ max C 0 / R * (2 + a) := by
    have h1 : C / R * (1 + a ^ ((3 : ℝ) / 4)) ≤ max C 0 / R * (1 + a ^ ((3 : ℝ) / 4)) := by
      apply mul_le_mul_of_nonneg_right _ (by linarith)
      exact div_le_div_of_nonneg_right hM hRpos.le
    have h2 : max C 0 / R * (1 + a ^ ((3 : ℝ) / 4)) ≤ max C 0 / R * (2 + a) :=
      mul_le_mul_of_nonneg_left (by linarith) (by positivity)
    linarith [le_abs_self Jp]

  have hV : -Jvc ≤ ν * ((1 / 4) * a + 192 * c₁ ^ 2 * C₀ / R) := by
    have h1 : 192 * c₁ ^ 2 / R ^ 2 * S ≤ 192 * c₁ ^ 2 * C₀ / R := by
      rw [div_mul_eq_mul_div, div_le_div_iff₀ (by positivity) hRpos]
      have hc2 : 0 ≤ 192 * c₁ ^ 2 := by positivity
      have hC0 : 0 ≤ C₀ := le_trans hS hSC
      have a1 : 192 * c₁ ^ 2 * S ≤ 192 * c₁ ^ 2 * C₀ := mul_le_mul_of_nonneg_left hSC hc2
      have a2 : R ≤ R ^ 2 := by nlinarith
      calc 192 * c₁ ^ 2 * S * R ≤ 192 * c₁ ^ 2 * C₀ * R :=
            mul_le_mul_of_nonneg_right a1 hRpos.le
        _ ≤ 192 * c₁ ^ 2 * C₀ * R ^ 2 := mul_le_mul_of_nonneg_left a2 (by positivity)
    have h2 := mul_le_mul_of_nonneg_left (add_le_add_left h1 ((1 / 4) * a)) hν.le
    linarith [neg_le_abs Jvc]

  have hLin : -Jlin ≤ L * E := le_trans (neg_le_abs Jlin) h12

  have h3ν : 0 < 3 * ν := by linarith
  have hZ : 4 * (8 * c₁ * C₀ ^ ((3 : ℝ) / 4) * K ^ 2 + max C 0) ≤ R * (3 * ν) :=
    (div_le_iff₀ h3ν).mp h13
  have hZa : (8 * c₁ * C₀ ^ ((3 : ℝ) / 4) * K ^ 2 + max C 0) / R * a ≤ 3 * ν / 4 * a := by
    apply mul_le_mul_of_nonneg_right _ ha
    rw [div_le_iff₀ hRpos]; linarith

  have e1 : 4 * c₁ / R * (C₀ ^ ((3 : ℝ) / 4) * (1 + 2 * K ^ 2 * (1 + a)))
      + max C 0 / R * (2 + a) + ν * ((1 / 4) * a + 192 * c₁ ^ 2 * C₀ / R)
      = (4 * c₁ * C₀ ^ ((3 : ℝ) / 4) * (1 + 2 * K ^ 2) + 2 * max C 0
          + 192 * ν * c₁ ^ 2 * C₀) / R
        + (8 * c₁ * C₀ ^ ((3 : ℝ) / 4) * K ^ 2 + max C 0) / R * a + ν * (1 / 4) * a := by
    field_simp
    ring
  have e2 : 2 * (4 * c₁ * C₀ ^ ((3 : ℝ) / 4) * (1 + 2 * K ^ 2) + 2 * max C 0
      + 192 * ν * c₁ ^ 2 * C₀) / R = 2 * ((4 * c₁ * C₀ ^ ((3 : ℝ) / 4) * (1 + 2 * K ^ 2)
      + 2 * max C 0 + 192 * ν * c₁ ^ 2 * C₀) / R) := by ring
  rw [e2]
  linarith [hTr, hPr, hV, hLin, hZa, e1]

theorem ae_nonpos_of_continuousOn : ∀ (f : ℝ → ℝ) (a b : ℝ), ContinuousOn f (Ioo a b) → (∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo a b → f t ≤ 0) → ∀ t ∈ Ioo a b, f t ≤ 0 :=
by
  intro f a b hf hae t0 ht0
  by_contra hpos
  push_neg at hpos
  have hU : IsOpen (Ioo a b ∩ f ⁻¹' Ioi 0) :=
    hf.isOpen_inter_preimage isOpen_Ioo isOpen_Ioi
  have hne : (volume : Measure ℝ) (Ioo a b ∩ f ⁻¹' Ioi 0) ≠ 0 :=
    hU.measure_ne_zero volume ⟨t0, ht0, hpos⟩
  have hnull : (volume : Measure ℝ) {t | ¬ (t ∈ Ioo a b → f t ≤ 0)} = 0 := ae_iff.mp hae
  apply hne
  apply measure_mono_null _ hnull
  intro t ht
  simp only [mem_setOf_eq, not_imp, not_le]
  exact ⟨ht.1, ht.2⟩

theorem linear_gronwall_bound : ∀ (E E' : ℝ → ℝ) (T α β : ℝ), 0 ≤ α → 0 ≤ β → ContinuousOn E (Icc 0 T) → (∀ s ∈ Ioo 0 T, HasDerivAt E (E' s) s) → (∀ s ∈ Ioo 0 T, E' s ≤ α * E s + β) → E 0 ≤ 0 → ∀ s ∈ Icc 0 T, E s ≤ β * T * Real.exp (α * T) :=
by
  intro E E' T α β hα hβ hcont hderiv hle h0 s hs
  set G : ℝ → ℝ := fun r => Real.exp (-(α * r)) * E r - β * r with hGdef
  set G' : ℝ → ℝ := fun r => Real.exp (-(α * r)) * (-(α * 1)) * E r
    + Real.exp (-(α * r)) * E' r - β * 1 with hG'def
  have hGc : ContinuousOn G (Icc 0 T) := by
    have h1 : Continuous (fun r : ℝ => Real.exp (-(α * r))) := by fun_prop
    have h2 : Continuous (fun r : ℝ => β * r) := by fun_prop
    exact (h1.continuousOn.mul hcont).sub h2.continuousOn
  have hGd : ∀ r ∈ interior (Icc 0 T), HasDerivWithinAt G (G' r) (interior (Icc 0 T)) r := by
    intro r hr
    rw [interior_Icc] at hr
    have he : HasDerivAt (fun r : ℝ => Real.exp (-(α * r)))
        (Real.exp (-(α * r)) * (-(α * 1))) r :=
      (((hasDerivAt_id r).const_mul α).neg).exp
    have hm := (he.mul (hderiv r hr)).sub ((hasDerivAt_id r).const_mul β)
    exact hm.hasDerivWithinAt
  have hGn : ∀ r ∈ interior (Icc 0 T), G' r ≤ 0 := by
    intro r hr
    rw [interior_Icc] at hr
    have hepos : 0 < Real.exp (-(α * r)) := Real.exp_pos _
    have hele : Real.exp (-(α * r)) ≤ 1 := by
      rw [Real.exp_le_one_iff]
      have : 0 ≤ α * r := mul_nonneg hα hr.1.le
      linarith
    have hl := hle r hr
    simp only [hG'def]
    nlinarith [mul_nonneg hepos.le (sub_nonneg.mpr hl), mul_nonneg (sub_nonneg.mpr hele) hβ]
  have hanti : AntitoneOn G (Icc 0 T) :=
    antitoneOn_of_hasDerivWithinAt_nonpos (convex_Icc 0 T) hGc hGd hGn
  have hT : 0 ≤ T := le_trans hs.1 hs.2
  have h0mem : (0:ℝ) ∈ Icc 0 T := ⟨le_rfl, hT⟩
  have hGs : G s ≤ G 0 := hanti h0mem hs hs.1
  have hG0 : G 0 = E 0 := by simp [hGdef]
  have hkey : Real.exp (-(α * s)) * E s ≤ β * s := by
    have : G s ≤ 0 := by linarith
    simp only [hGdef] at this
    linarith
  have hprod : Real.exp (α * s) * Real.exp (-(α * s)) = 1 := by
    rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
  have hexpos : 0 < Real.exp (α * s) := Real.exp_pos _
  have hEs : E s ≤ β * s * Real.exp (α * s) := by
    have h := mul_le_mul_of_nonneg_left hkey hexpos.le
    calc E s = Real.exp (α * s) * (Real.exp (-(α * s)) * E s) := by
            rw [← mul_assoc, hprod, one_mul]
      _ ≤ Real.exp (α * s) * (β * s) := h
      _ = β * s * Real.exp (α * s) := by ring
  have hbs : β * s ≤ β * T := mul_le_mul_of_nonneg_left hs.2 hβ
  have hexp : Real.exp (α * s) ≤ Real.exp (α * T) :=
    Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hs.2 hα)
  have hfin : β * s * Real.exp (α * s) ≤ β * T * Real.exp (α * T) :=
    mul_le_mul hbs hexp hexpos.le (mul_nonneg hβ hT)
  linarith

theorem localized_energy_uniqueness : ∀ (ν T₁ C₀ C Ru L K : ℝ) (w u : ℝ³ → ℝ → ℝ³) (π Q : ℝ³ → ℝ → ℝ), 0 < ν → 0 < T₁ → 1 ≤ Ru → (∀ t ∈ Icc 0 T₁, ∀ R : ℝ, 1 ≤ R → (∫ x, cutPhi R x ^ 24 * ‖w x t‖ ^ 6) ^ ((1 : ℝ) / 6) ≤ K * (1 + (∫ x, cutPhi R x ^ 8 * ∑ k, ‖fderiv ℝ (fun y => w y t) x (EuclideanSpace.single k 1)‖ ^ 2) ^ ((1 : ℝ) / 2))) → ContDiffOn ℝ ∞ (↿w) (univ ×ˢ Icc 0 T₁) → ContDiffOn ℝ ∞ (↿u) (univ ×ˢ Icc 0 T₁) → ContDiffOn ℝ ∞ (↿π) (univ ×ˢ Icc 0 T₁) → (∀ t ∈ Icc 0 T₁, ContDiff ℝ ∞ (fun y => w y t) ∧ ContDiff ℝ ∞ (fun y => u y t) ∧ ContDiff ℝ ∞ (fun y => π y t)) → (∀ x t, t ∈ Icc 0 T₁ → Ru ≤ ‖x‖ → u x t = 0) → (∀ x t, t ∈ Icc 0 T₁ → ‖fderiv ℝ (fun y => u y t) x‖ ≤ L) → (∀ x t, t ∈ Icc 0 T₁ → derivWithin (w x ·) (Ici 0) t + fderiv ℝ (fun y => w y t) x (w x t + u x t) + fderiv ℝ (fun y => u y t) x (w x t) = ν • Δ (fun y => w y t) x - gradient (fun y => π y t) x) → (∀ x t, t ∈ Icc 0 T₁ → divergence (fun y => w y t) x = 0) → (∀ x t, t ∈ Icc 0 T₁ → divergence (fun y => u y t) x = 0) → (∀ x, w x 0 = 0) → (∀ t ∈ Icc 0 T₁, MemLp (fun x => w x t) 2 ∧ (∫ x, ‖w x t‖ ^ 2) ≤ C₀) → (∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo 0 T₁ → ∃ c : ℝ, ∀ x, π x t = Q x t + c) → (∀ t ∈ Ioo 0 T₁, ∀ R : ℝ, 1 ≤ R → Ru ≤ R → |∫ x, Q x t * inner ℝ (w x t) (gradient (fun y => cutPhi R y ^ 8) x)| ≤ C / R * (1 + (∫ x, cutPhi R x ^ 8 * ∑ k, ‖fderiv ℝ (fun y => w y t) x (EuclideanSpace.single k 1)‖ ^ 2) ^ ((3 : ℝ) / 4))) → ∀ x t, t ∈ Icc 0 T₁ → w x t = 0 :=
by
  intro ν T₁ C₀ C Ru L K w u π Q hν hT hRu hSob hw hu hπ hslice hvan hL heq hdivw hdivu hinit hL2 hident hflux
  have h0I : (0:ℝ) ∈ Icc 0 T₁ := ⟨le_rfl, hT.le⟩
  have hL0 : 0 ≤ L := le_trans (norm_nonneg _) (hL 0 0 h0I)
  have hC₀ : 0 ≤ C₀ := le_trans (integral_nonneg (fun x => by positivity)) (hL2 0 h0I).2
  obtain ⟨c₁, hc₁, hcut⟩ := cutoff_profile
  have hP0 : 0 ≤ C₀ ^ ((3:ℝ)/4) := Real.rpow_nonneg hC₀ _
  have hCp : 0 ≤ max C 0 := le_max_right _ _
  obtain ⟨D₀, hD₀⟩ : ∃ D : ℝ, D = 4 * c₁ * C₀ ^ ((3 : ℝ) / 4) * (1 + 2 * K ^ 2) + 2 * max C 0
      + 192 * ν * c₁ ^ 2 * C₀ := ⟨_, rfl⟩
  have hD₀0 : 0 ≤ D₀ := by
    have h1 : 0 ≤ 4 * c₁ * C₀ ^ ((3 : ℝ) / 4) * (1 + 2 * K ^ 2) := by positivity
    have h2 : 0 ≤ 192 * ν * c₁ ^ 2 * C₀ := by positivity
    rw [hD₀]; linarith
  obtain ⟨R₀, hR₀⟩ : ∃ R₀ : ℝ, R₀ = max (max Ru 1)
      (4 * (8 * c₁ * C₀ ^ ((3 : ℝ) / 4) * K ^ 2 + max C 0) / (3 * ν)) := ⟨_, rfl⟩

  have key : ∀ R : ℝ, R₀ ≤ R → ∀ s ∈ Icc 0 T₁,
      (∫ x, cutPhi R x ^ 8 * ‖w x s‖ ^ 2) ≤ 2 * D₀ / R * T₁ * Real.exp (2 * L * T₁) := by
    intro R hR
    rw [hR₀] at hR
    have hR1 : 1 ≤ R := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hR
    have hRu' : Ru ≤ R := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hR
    have hRth : 4 * (8 * c₁ * C₀ ^ ((3 : ℝ) / 4) * K ^ 2 + max C 0) / (3 * ν) ≤ R :=
      le_trans (le_max_right _ _) hR
    have hRpos : 0 < R := by linarith
    obtain ⟨hφC, hφS, hφb, hφ1, hφ0, hχC, hχS, hχd, hχz⟩ := hcut R hR1
    obtain ⟨hEc, hE'c, hEd⟩ :=
      weighted_energy_regularity (fun y => cutPhi R y ^ 8) w T₁ hT hχC.continuous hχS hw
    have hEc' : ContinuousOn (fun s => ∫ x, cutPhi R x ^ 8 * ‖w x s‖ ^ 2) (Icc 0 T₁) := hEc
    have hE'c' : ContinuousOn (fun s => ∫ x, cutPhi R x ^ 8 *
        (2 * inner ℝ (w x s) (deriv (fun r => w x r) s))) (Ioo 0 T₁) := hE'c
    have hEd' : ∀ s ∈ Ioo 0 T₁, HasDerivAt (fun s => ∫ x, cutPhi R x ^ 8 * ‖w x s‖ ^ 2)
        (∫ x, cutPhi R x ^ 8 * (2 * inner ℝ (w x s) (deriv (fun r => w x r) s))) s := hEd
    have hae : ∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo 0 T₁ →
        (∫ x, cutPhi R x ^ 8 * (2 * inner ℝ (w x t) (deriv (fun r => w x r) t)))
          - (2 * L * (∫ x, cutPhi R x ^ 8 * ‖w x t‖ ^ 2) + 2 * D₀ / R) ≤ 0 := by
      filter_upwards [hident] with t ht htI
      obtain ⟨c, hc⟩ := ht htI
      have htI' : t ∈ Icc 0 T₁ := ⟨htI.1.le, htI.2.le⟩
      obtain ⟨hwt, hut, hπt⟩ := hslice t htI'
      have hD : ∀ x, deriv (fun r => w x r) t + fderiv ℝ (fun y => w y t) x (w x t + u x t)
          + fderiv ℝ (fun y => u y t) x (w x t)
          = ν • Δ (fun y => w y t) x - gradient (fun y => π y t) x := by
        intro x
        rw [← derivWithin_of_mem_nhds (Ici_mem_nhds htI.1)]
        exact heq x t htI'
      have hχu : ∀ x, fderiv ℝ (fun y => cutPhi R y ^ 8) x (u x t) = 0 := by
        intro x
        by_cases hx : ‖x‖ < R
        · rw [hχz x hx]; rfl
        · rw [hvan x t htI' (le_trans hRu' (not_lt.mp hx)), map_zero]
      have hid := localized_energy_identity ν c (fun y => w y t) (fun y => u y t)
        (fun x => deriv (fun r => w x r) t) (fun y => π y t) (fun y => Q y t)
        (fun y => cutPhi R y ^ 8) hwt hut hπt hχC hχS (fun x => hdivw x t htI')
        (fun x => hdivu x t htI') hχu (fun x => hc x) hD
      have h3 := transport_term_bound (cutPhi R) (fun y => w y t) c₁ R hRpos hc₁ hφC hφS hφb hχd
        hwt (hL2 t htI').1
      have h5 := viscous_cross_term_bound (cutPhi R) (fun y => w y t) c₁ R ν hRpos hν.le hφC hφS
        hφb hχd hwt (hL2 t htI').1
      have h6 := linear_term_bound (fun y => cutPhi R y ^ 8) (fun y => w y t) (fun y => u y t) L
        hχC.continuous hχS (fun x => by positivity) hwt hut (fun x => hL x t htI')
      have hp := hflux t htI R hR1 hRu'
      have hs := hSob t htI' R hR1
      have hA : 0 ≤ ∫ x, cutPhi R x ^ 8 *
          ∑ k, ‖fderiv ℝ (fun y => w y t) x (EuclideanSpace.single k 1)‖ ^ 2 :=
        integral_nonneg (fun x => by positivity)
      have hX : 0 ≤ ∫ x, cutPhi R x ^ 24 * ‖w x t‖ ^ 6 := integral_nonneg (fun x => by positivity)
      have hS : 0 ≤ ∫ x, ‖w x t‖ ^ 2 := integral_nonneg (fun x => by positivity)
      have hcl := energy_scalar_closure ν c₁ C₀ C K L R (∫ x, cutPhi R x ^ 8 * ‖w x t‖ ^ 2)
        _ _ _ _ _ _ _ hν hc₁ hR1 hA hX hS (hL2 t htI').2 hs h3 hp h5 h6 hRth
      rw [← hD₀] at hcl
      linarith [hid, hcl]
    have hall := ae_nonpos_of_continuousOn
      (fun s => (∫ x, cutPhi R x ^ 8 * (2 * inner ℝ (w x s) (deriv (fun r => w x r) s)))
        - (2 * L * (∫ x, cutPhi R x ^ 8 * ‖w x s‖ ^ 2) + 2 * D₀ / R)) 0 T₁
      (hE'c'.sub ((continuousOn_const.mul (hEc'.mono Ioo_subset_Icc_self)).add continuousOn_const))
      hae
    have hE0 : (fun s => ∫ x, cutPhi R x ^ 8 * ‖w x s‖ ^ 2) 0 ≤ 0 := by
      simp [hinit]
    have hα : 0 ≤ 2 * L := by positivity
    have hβ : 0 ≤ 2 * D₀ / R := by positivity
    exact linear_gronwall_bound (fun s => ∫ x, cutPhi R x ^ 8 * ‖w x s‖ ^ 2)
      (fun s => ∫ x, cutPhi R x ^ 8 * (2 * inner ℝ (w x s) (deriv (fun r => w x r) s)))
      T₁ (2 * L) (2 * D₀ / R) hα hβ hEc' hEd' (fun s hs => by have := hall s hs; linarith) hE0

  intro x₀ t ht
  by_contra hne
  obtain ⟨R₁, hR₁⟩ : ∃ R₁ : ℝ, R₁ = max 1 ‖x₀‖ := ⟨_, rfl⟩
  have hR₁1 : 1 ≤ R₁ := hR₁ ▸ le_max_left _ _
  have hx₀R₁ : ‖x₀‖ ≤ R₁ := hR₁ ▸ le_max_right _ _
  obtain ⟨_, _, hφb1, hφ11, hφ01, hχC1, hχS1, _, _⟩ := hcut R₁ hR₁1
  have hwc : Continuous (fun x => w x t) := (hslice t ht).1.continuous
  obtain ⟨η, hηdef⟩ : ∃ η : ℝ, η = ∫ x, cutPhi R₁ x ^ 8 * ‖w x t‖ ^ 2 := ⟨_, rfl⟩
  have hη : 0 < η := by
    rw [hηdef]
    apply Continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero (x := x₀)
    · exact hχC1.continuous.mul (hwc.norm.pow 2)
    · exact hχS1.mul_right
    · intro x; simp only [Pi.zero_apply]; positivity
    · rw [hφ11 x₀ hx₀R₁]; simp [hne]
  obtain ⟨K₂, hK₂⟩ : ∃ K₂ : ℝ, K₂ = 2 * D₀ * T₁ * Real.exp (2 * L * T₁) := ⟨_, rfl⟩
  obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = max (max R₀ (2 * R₁)) (K₂ / η + 1) := ⟨_, rfl⟩
  have hRR₀ : R₀ ≤ R := hRdef ▸ le_trans (le_max_left _ _) (le_max_left _ _)
  have hR2 : 2 * R₁ ≤ R := hRdef ▸ le_trans (le_max_right _ _) (le_max_left _ _)
  have hRK : K₂ / η + 1 ≤ R := hRdef ▸ le_max_right _ _
  have hRpos : 0 < R := by linarith
  have hR1 : 1 ≤ R := by linarith
  obtain ⟨_, _, hφbR, hφ1R, _, hχCR, hχSR, _, _⟩ := hcut R hR1
  have hbound := key R hRR₀ t ht
  have hmono : η ≤ ∫ x, cutPhi R x ^ 8 * ‖w x t‖ ^ 2 := by
    rw [hηdef]
    apply integral_mono
    · exact (hχC1.continuous.mul (hwc.norm.pow 2)).integrable_of_hasCompactSupport hχS1.mul_right
    · exact (hχCR.continuous.mul (hwc.norm.pow 2)).integrable_of_hasCompactSupport hχSR.mul_right
    · intro x
      have hle : cutPhi R₁ x ^ 8 ≤ cutPhi R x ^ 8 := by
        by_cases hx : 2 * R₁ ≤ ‖x‖
        · rw [hφ01 x hx]; norm_num; positivity
        · rw [hφ1R x (by linarith)]
          rw [one_pow]
          exact pow_le_one₀ (hφb1 x).1 (hφb1 x).2
      exact mul_le_mul_of_nonneg_right hle (by positivity)
  have heqK : 2 * D₀ / R * T₁ * Real.exp (2 * L * T₁) = K₂ / R := by
    rw [hK₂]; ring
  have h1 : K₂ / η < R := by linarith
  have h2 : K₂ < R * η := (div_lt_iff₀ hη).mp h1
  have h3 : K₂ / R < η := (div_lt_iff₀ hRpos).mpr (by linarith)
  linarith

theorem cutoff_sobolev_bound : ∀ (C₀ : ℝ), ∃ K : ℝ, ∀ (w : ℝ³ → ℝ³), ContDiff ℝ ∞ w → MemLp w 2 → (∫ x, ‖w x‖ ^ 2) ≤ C₀ → ∀ R : ℝ, 1 ≤ R → (∫ x, cutPhi R x ^ 24 * ‖w x‖ ^ 6) ^ ((1 : ℝ) / 6) ≤ K * (1 + (∫ x, cutPhi R x ^ 8 * ∑ k, ‖fderiv ℝ w x (EuclideanSpace.single k 1)‖ ^ 2) ^ ((1 : ℝ) / 2)) :=
by

  have s1 : ∃ c₁ : ℝ, 0 ≤ c₁ ∧ ∀ R : ℝ, 1 ≤ R → ContDiff ℝ ∞ (cutPhi R) ∧ HasCompactSupport (cutPhi R) ∧ (∀ x, 0 ≤ cutPhi R x ∧ cutPhi R x ≤ 1) ∧ (∀ x, ‖fderiv ℝ (cutPhi R) x‖ ≤ c₁) := by
    obtain ⟨c, hc⟩ := Continuous.bounded_above_of_compact_support
      ((bump12.contDiff (n := 1)).continuous_fderiv (by simp)) (bump12.hasCompactSupport.fderiv ℝ)
    refine ⟨max c 0, le_max_right _ _, fun R hR => ?_⟩
    have hR0 : R ≠ 0 := by positivity
    have hRi : R⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hR
    have hRi0 : 0 < R⁻¹ := by positivity
    refine ⟨?_, ?_, ?_, ?_⟩
    · show ContDiff ℝ ∞ (fun x => (bump12 : ℝ³ → ℝ) (R⁻¹ • x))
      exact (bump12.contDiff (n := ⊤)).comp (contDiff_const_smul R⁻¹)
    · show HasCompactSupport (fun x => (bump12 : ℝ³ → ℝ) (R⁻¹ • x))
      exact bump12.hasCompactSupport.comp_smul (inv_ne_zero hR0)
    · intro x
      exact ⟨bump12.nonneg, bump12.le_one⟩
    · intro x
      have : fderiv ℝ (cutPhi R) x = R⁻¹ • fderiv ℝ (bump12 : ℝ³ → ℝ) (R⁻¹ • x) :=
        fderiv_comp_smul (f := (bump12 : ℝ³ → ℝ)) R⁻¹
      rw [this, norm_smul, Real.norm_eq_abs, abs_of_pos hRi0]
      calc R⁻¹ * ‖fderiv ℝ (bump12 : ℝ³ → ℝ) (R⁻¹ • x)‖ ≤ 1 * max c 0 := by
            apply mul_le_mul hRi (le_trans (hc _) (le_max_left _ _)) (norm_nonneg _) zero_le_one
        _ = max c 0 := one_mul _

  have s3 : ∀ A : ℝ³ →L[ℝ] ℝ³, ‖A‖ ≤ Real.sqrt (∑ k : Fin 3, ‖A (EuclideanSpace.single k 1)‖ ^ 2) := by
    intro A
    refine ContinuousLinearMap.opNorm_le_bound A (Real.sqrt_nonneg _) (fun h => ?_)
    have hexp : h = ∑ k : Fin 3, h k • EuclideanSpace.single k (1:ℝ) := by
      have := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr h
      simpa [EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr] using this.symm
    have hAh : A h = ∑ k : Fin 3, h k • A (EuclideanSpace.single k (1:ℝ)) := by
      conv_lhs => rw [hexp]
      simp [map_sum, map_smul]
    rw [hAh]
    calc ‖∑ k : Fin 3, h k • A (EuclideanSpace.single k (1:ℝ))‖
        ≤ ∑ k : Fin 3, ‖h k • A (EuclideanSpace.single k (1:ℝ))‖ := norm_sum_le _ _
      _ = ∑ k : Fin 3, ‖A (EuclideanSpace.single k (1:ℝ))‖ * ‖h k‖ := by
          refine Finset.sum_congr rfl (fun k _ => ?_)
          rw [norm_smul, mul_comm]
      _ ≤ Real.sqrt (∑ k : Fin 3, ‖A (EuclideanSpace.single k 1)‖ ^ 2) * Real.sqrt (∑ k : Fin 3, ‖h k‖ ^ 2) :=
          Real.sum_mul_le_sqrt_mul_sqrt _ _ _
      _ = Real.sqrt (∑ k : Fin 3, ‖A (EuclideanSpace.single k 1)‖ ^ 2) * ‖h‖ := by
          rw [EuclideanSpace.norm_eq]

  have s4 : ∃ C : ℝ, 0 ≤ C ∧ ∀ f : ℝ³ → ℝ³, ContDiff ℝ 1 f → HasCompactSupport f → (∫ x, ‖f x‖ ^ 6) ^ ((1 : ℝ) / 6) ≤ C * (∫ x, ‖fderiv ℝ f x‖ ^ 2) ^ ((1 : ℝ) / 2) := by
    refine ⟨(eLpNormLESNormFDerivOfEqInnerConst (volume : Measure ℝ³) ((2 : NNReal) : ℝ) : ℝ),
      NNReal.coe_nonneg _, fun f hf hfc => ?_⟩
    have key := eLpNorm_le_eLpNorm_fderiv_of_eq_inner (volume : Measure ℝ³) hf hfc
      (p := 2) (p' := 6) (by norm_num) (by simp) (by rw [finrank_euclideanSpace_fin]; norm_num)
    have m6 : MemLp f ((6 : NNReal) : ENNReal) volume := hf.continuous.memLp_of_hasCompactSupport hfc
    have m2 : MemLp (fderiv ℝ f) ((2 : NNReal) : ENNReal) volume :=
      (hf.continuous_fderiv one_ne_zero).memLp_of_hasCompactSupport (hfc.fderiv ℝ)
    rw [m6.eLpNorm_eq_integral_rpow_norm (by simp) (by simp),
      m2.eLpNorm_eq_integral_rpow_norm (by simp) (by simp)] at key
    have e6 : ∀ a : ℝ, a ^ ((((6 : NNReal) : ENNReal)).toReal) = a ^ (6:ℕ) := fun a => by
      rw [show (((6 : NNReal) : ENNReal)).toReal = ((6:ℕ):ℝ) by norm_num, Real.rpow_natCast]
    have e2 : ∀ a : ℝ, a ^ ((((2 : NNReal) : ENNReal)).toReal) = a ^ (2:ℕ) := fun a => by
      rw [show (((2 : NNReal) : ENNReal)).toReal = ((2:ℕ):ℝ) by norm_num, Real.rpow_natCast]
    have i6 : (((6 : NNReal) : ENNReal)).toReal⁻¹ = (1:ℝ)/6 := by norm_num
    have i2 : (((2 : NNReal) : ENNReal)).toReal⁻¹ = (1:ℝ)/2 := by norm_num
    simp only [e6, e2, i6, i2] at key
    rw [← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (NNReal.coe_nonneg _),
      ENNReal.ofReal_le_ofReal_iff (mul_nonneg (NNReal.coe_nonneg _)
        (Real.rpow_nonneg (integral_nonneg (fun _ => by positivity)) _))] at key
    exact key

  obtain ⟨c₁, hc₁, hφ⟩ := s1
  obtain ⟨CS, hCS, hgns⟩ := s4
  intro C₀
  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = Real.sqrt (32 * c₁ ^ 2 * max C₀ 0) := ⟨_, rfl⟩
  have hB0 : 0 ≤ B := by rw [hBdef]; exact Real.sqrt_nonneg _
  have hBsq : B ^ 2 = 32 * c₁ ^ 2 * max C₀ 0 := by
    rw [hBdef, Real.sq_sqrt]; positivity
  refine ⟨CS * (Real.sqrt 2 + B), ?_⟩
  intro w hw hwL2 hwC R hR
  obtain ⟨hφs, hφc, hφb, hφd⟩ := hφ R hR
  have hfs : ContDiff ℝ ∞ (fun y => cutPhi R y ^ 4 • w y) := (hφs.pow 4).smul hw
  have hfc : HasCompactSupport (fun y => cutPhi R y ^ 4 • w y) := by
    have h1 : HasCompactSupport (fun y => cutPhi R y ^ 4) :=
      hφc.comp_left (g := fun t : ℝ => t ^ 4) (by norm_num)
    exact h1.smul_right (f' := w)
  have hf1 : ContDiff ℝ 1 (fun y => cutPhi R y ^ 4 • w y) := hfs.of_le (by simp)

  have hLHS : (fun x => cutPhi R x ^ 24 * ‖w x‖ ^ 6) = fun x => ‖cutPhi R x ^ 4 • w x‖ ^ 6 := by
    funext x
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (hφb x).1 4)]
    ring
  have hG := hgns _ hf1 hfc
  rw [← hLHS] at hG

  have hdb : ∀ x, ‖fderiv ℝ (fun y => cutPhi R y ^ 4 • w y) x‖ ≤
      cutPhi R x ^ 4 * Real.sqrt (∑ k, ‖fderiv ℝ w x (EuclideanSpace.single k 1)‖ ^ 2) + 4 * c₁ * ‖w x‖ := by
    intro x
    have h0 := (hφb x).1
    have h1 := (hφb x).2
    have hφx : DifferentiableAt ℝ (cutPhi R) x := (hφs.differentiable (by simp)) x
    have hwx : DifferentiableAt ℝ w x := (hw.differentiable (by simp)) x
    have hφ4 : DifferentiableAt ℝ (fun y => cutPhi R y ^ 4) x := hφx.pow 4
    rw [fderiv_fun_smul hφ4 hwx, fderiv_fun_pow 4 hφx]
    refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
    · rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (pow_nonneg h0 4)]
      exact mul_le_mul_of_nonneg_left (s3 _) (pow_nonneg h0 4)
    · rw [ContinuousLinearMap.norm_smulRight_apply, norm_smul]
      have h3 : ‖((4:ℕ) • cutPhi R x ^ (4 - 1) : ℝ)‖ ≤ 4 := by
        have : ((4:ℕ) • cutPhi R x ^ (4 - 1) : ℝ) = 4 * cutPhi R x ^ 3 := by
          rw [nsmul_eq_mul]; norm_num
        rw [this, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        nlinarith [pow_le_one₀ (n := 3) h0 h1]
      exact mul_le_mul_of_nonneg_right (mul_le_mul h3 (hφd x) (norm_nonneg _) (by norm_num))
        (norm_nonneg _)

  have hS0 : ∀ x, 0 ≤ ∑ k, ‖fderiv ℝ w x (EuclideanSpace.single k 1)‖ ^ 2 :=
    fun x => Finset.sum_nonneg (fun k _ => by positivity)
  have hpt : ∀ x, ‖fderiv ℝ (fun y => cutPhi R y ^ 4 • w y) x‖ ^ 2 ≤
      2 * (cutPhi R x ^ 8 * ∑ k, ‖fderiv ℝ w x (EuclideanSpace.single k 1)‖ ^ 2) + 32 * c₁ ^ 2 * ‖w x‖ ^ 2 := by
    intro x
    have hsq := pow_le_pow_left₀ (norm_nonneg _) (hdb x) 2
    have ha : (cutPhi R x ^ 4 * Real.sqrt (∑ k, ‖fderiv ℝ w x (EuclideanSpace.single k 1)‖ ^ 2)) ^ 2
        = cutPhi R x ^ 8 * ∑ k, ‖fderiv ℝ w x (EuclideanSpace.single k 1)‖ ^ 2 := by
      rw [mul_pow, ← pow_mul, Real.sq_sqrt (hS0 x)]
    nlinarith [sq_nonneg (cutPhi R x ^ 4 * Real.sqrt (∑ k, ‖fderiv ℝ w x (EuclideanSpace.single k 1)‖ ^ 2) - 4 * c₁ * ‖w x‖)]
  have hintg : Integrable (fun x => ‖fderiv ℝ (fun y => cutPhi R y ^ 4 • w y) x‖ ^ 2) volume := by
    apply Continuous.integrable_of_hasCompactSupport
    · exact ((hf1.continuous_fderiv one_ne_zero).norm.pow 2)
    · exact (hfc.fderiv ℝ).comp_left (g := fun T => ‖T‖ ^ 2) (by simp)
  have hinta : Integrable (fun x => cutPhi R x ^ 8 * ∑ k, ‖fderiv ℝ w x (EuclideanSpace.single k 1)‖ ^ 2) volume := by
    apply Continuous.integrable_of_hasCompactSupport
    · exact (hφs.continuous.pow 8).mul (continuous_finsetSum _ (fun k _ =>
        (((hw.continuous_fderiv (by simp)).clm_apply continuous_const).norm.pow 2)))
    · exact (hφc.comp_left (g := fun t : ℝ => t ^ 8) (by norm_num)).mul_right
  have hwL2' : MemLp w ((2:ℕ) : ENNReal) volume := by simpa using hwL2
  have hintw : Integrable (fun x => ‖w x‖ ^ 2) volume := hwL2'.integrable_norm_pow two_ne_zero
  obtain ⟨I, hIdef⟩ : ∃ I : ℝ, I = ∫ x, cutPhi R x ^ 8 * ∑ k, ‖fderiv ℝ w x (EuclideanSpace.single k 1)‖ ^ 2 :=
    ⟨_, rfl⟩
  obtain ⟨J, hJdef⟩ : ∃ J : ℝ, J = ∫ x, ‖fderiv ℝ (fun y => cutPhi R y ^ 4 • w y) x‖ ^ 2 := ⟨_, rfl⟩
  have hI0 : 0 ≤ I := by
    rw [hIdef]; exact integral_nonneg (fun x => mul_nonneg (pow_nonneg (hφb x).1 8) (hS0 x))
  have hJ0 : 0 ≤ J := by rw [hJdef]; exact integral_nonneg (fun x => by positivity)
  have hJ : J ≤ 2 * I + B ^ 2 := by
    have h1 : J ≤ 2 * I + 32 * c₁ ^ 2 * ∫ x, ‖w x‖ ^ 2 := by
      rw [hJdef, hIdef, ← integral_const_mul, ← integral_const_mul,
        ← integral_add (hinta.const_mul 2) (hintw.const_mul _)]
      exact integral_mono hintg ((hinta.const_mul 2).add (hintw.const_mul _)) (fun x => hpt x)
    have h2 : 32 * c₁ ^ 2 * ∫ x, ‖w x‖ ^ 2 ≤ 32 * c₁ ^ 2 * max C₀ 0 :=
      mul_le_mul_of_nonneg_left (hwC.trans (le_max_left _ _)) (by positivity)
    rw [hBsq]; linarith

  have hs2 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg _
  have hsI : 0 ≤ Real.sqrt I := Real.sqrt_nonneg _
  have hs2sq : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hsIsq : Real.sqrt I ^ 2 = I := Real.sq_sqrt hI0
  have hsqJ : Real.sqrt J ≤ Real.sqrt 2 * Real.sqrt I + B := by
    rw [Real.sqrt_le_iff]
    refine ⟨by positivity, ?_⟩
    have h22 : (Real.sqrt 2 * Real.sqrt I) ^ 2 = 2 * I := by rw [mul_pow, hs2sq, hsIsq]
    nlinarith [mul_nonneg (mul_nonneg hs2 hsI) hB0]
  have hfin : Real.sqrt J ≤ (Real.sqrt 2 + B) * (1 + Real.sqrt I) := by
    nlinarith [mul_nonneg hB0 hsI]
  rw [← hJdef, ← Real.sqrt_eq_rpow] at hG
  rw [← hIdef, ← Real.sqrt_eq_rpow]
  calc _ ≤ CS * Real.sqrt J := hG
    _ ≤ CS * ((Real.sqrt 2 + B) * (1 + Real.sqrt I)) := mul_le_mul_of_nonneg_left hfin hCS
    _ = CS * (Real.sqrt 2 + B) * (1 + Real.sqrt I) := by ring

theorem rn_weak_strong_uniqueness : ∀ (ν T R : ℝ) (u v : ℝ³ → ℝ → ℝ³) (p P : ℝ³ → ℝ → ℝ) (f : ℝ³ → ℝ → ℝ³), 0 < ν → 0 < T → ContDiffOn ℝ ∞ (↿u) (univ ×ˢ Iio T) → ContDiffOn ℝ ∞ (↿p) (univ ×ˢ Iio T) → (∀ x t, t < T → R ≤ ‖x‖ → u x t = 0 ∧ p x t = 0) → (∀ x t, 0 ≤ t → t < T → nsResidual ν u p x t = f x t) → (∀ x t, 0 ≤ t → t < T → divergence (fun y => u y t) x = 0) → ContDiffOn ℝ ∞ (↿v) (univ ×ˢ Ici 0) → ContDiffOn ℝ ∞ (↿P) (univ ×ˢ Ici 0) → (∀ x, ∀ t ≥ 0, derivWithin (v x ·) (Ici 0) t + fderiv ℝ (v · t) x (v x t) = ν • Δ (v · t) x - gradient (P · t) x + f x t) → (∀ x, ∀ t ≥ 0, divergence (v · t) x = 0) → (∀ t ≥ 0, MemLp (fun x => ‖v x t‖) 2) → (∃ E, ∀ t ≥ 0, (∫ x, ‖v x t‖ ^ 2) < E) → (∀ x, v x 0 = u x 0) → ∀ x t, 0 ≤ t → t < T → v x t = u x t :=
by
  intro ν T R u v p P f hν hT hu hp hvan hres hdivu hv hP hns hdivv hL2 hEx hinit x₀ t₀ ht₀ ht₀T
  obtain ⟨E, hE⟩ := hEx

  obtain ⟨T₁, hT₁pos, hT₁T, ht₀T₁⟩ : ∃ T₁ : ℝ, 0 < T₁ ∧ T₁ < T ∧ t₀ ≤ T₁ :=
    ⟨(t₀ + T) / 2, by linarith, by linarith, by linarith⟩
  have hsubIio : (univ : Set ℝ³) ×ˢ Icc 0 T₁ ⊆ (univ : Set ℝ³) ×ˢ Iio T :=
    fun z hz => ⟨mem_univ _, lt_of_le_of_lt hz.2.2 hT₁T⟩
  have hsubIci : (univ : Set ℝ³) ×ˢ Icc 0 T₁ ⊆ (univ : Set ℝ³) ×ˢ Ici 0 :=
    fun z hz => ⟨mem_univ _, hz.2.1⟩
  have huI : ContDiffOn ℝ ∞ (↿u) (univ ×ˢ Icc 0 T₁) := hu.mono hsubIio
  have hpI : ContDiffOn ℝ ∞ (↿p) (univ ×ˢ Icc 0 T₁) := hp.mono hsubIio
  have hvI : ContDiffOn ℝ ∞ (↿v) (univ ×ˢ Icc 0 T₁) := hv.mono hsubIci
  have hPI : ContDiffOn ℝ ∞ (↿P) (univ ×ˢ Icc 0 T₁) := hP.mono hsubIci
  have hwI : ContDiffOn ℝ ∞ (↿(fun x t => v x t - u x t)) (univ ×ˢ Icc 0 T₁) := hvI.sub huI
  have hπI : ContDiffOn ℝ ∞ (↿(fun x t => P x t - p x t)) (univ ×ˢ Icc 0 T₁) := hPI.sub hpI
  have slice : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (G : ℝ³ → ℝ → F)
      (S : Set ℝ) (t : ℝ), ContDiffOn ℝ ∞ (↿G) (univ ×ˢ S) → t ∈ S →
      ContDiff ℝ ∞ (fun y => G y t) := by
    intro F _ _ G S t hG ht
    have h1 : ContDiff ℝ ∞ (fun y : ℝ³ => (y, t)) := contDiff_id.prodMk contDiff_const
    exact contDiffOn_univ.mp (hG.comp h1.contDiffOn (fun y _ => ⟨mem_univ _, ht⟩))
  have hcomp : ∀ i : Fin 3, ∀ G : ℝ³ → ℝ → ℝ³, ContDiffOn ℝ ∞ (↿G) (univ ×ˢ Icc 0 T₁) →
      ContDiffOn ℝ ∞ (↿(fun y s => G y s i)) (univ ×ˢ Icc 0 T₁) := by
    intro i G hG
    exact (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).contDiff.comp_contDiffOn hG
  have hgI : ∀ i j : Fin 3, ContDiffOn ℝ ∞
      (↿(fun y s => v y s i * v y s j - u y s i * u y s j)) (univ ×ˢ Icc 0 T₁) := by
    intro i j
    exact (((hcomp i v hvI).mul (hcomp j v hvI)).sub ((hcomp i u huI).mul (hcomp j u huI)))
  have hIT : ∀ t, t ∈ Icc 0 T₁ → t < T := fun t ht => lt_of_le_of_lt ht.2 hT₁T

  have hD := rn_difference_equations ν T R u v p P f hT hu hp hres hdivu hv hP hns hdivv

  obtain ⟨M, L, C₀, C₁, hM, hL, hC₀, hC₁⟩ := rn_uniform_bounds T₁ T R E u v hT₁pos hT₁T hu
    (fun x t ht hx => (hvan x t ht hx).1) hv hL2 hE

  have hcons : ∀ x t, t ∈ Ioo 0 T₁ → ∀ i : Fin 3,
      deriv (fun s => (v x s - u x s) i) t
        + ∑ j, pd j (fun y => v y t i * v y t j - u y t i * u y t j) x
        = ν * (Δ (fun y => v y t - u y t) x) i - pd i (fun y => P y t - p y t) x := by
    intro x t ht i
    exact (hD x t ht.1.le (lt_trans ht.2 hT₁T)).2.1 ht.1 i
  have hdivw : ∀ x t, t ∈ Icc 0 T₁ → divergence (fun y => v y t - u y t) x = 0 :=
    fun x t ht => (hD x t ht.1 (hIT t ht)).2.2
  have hS4 := stress_pressure_identification ν T₁ C₀ C₁ (fun x t => v x t - u x t)
    (fun x t => P x t - p x t) (fun i j y s => v y s i * v y s j - u y s i * u y s j)
    hT₁pos hwI hπI hgI hcons hdivw hC₀ hC₁
  have hQ : ∀ t : ℝ, stressPressure (fun i j y => v y t i * v y t j - u y t i * u y t j)
      = stressPressure (fun i j y => (v y t - u y t) i * (v y t - u y t) j
          + (v y t - u y t) i * u y t j + u y t i * (v y t - u y t) j) := by
    intro t
    congr 1
    funext i j y
    simp only [PiLp.sub_apply]
    ring
  have hident : ∀ᵐ t ∂(volume : Measure ℝ), t ∈ Ioo 0 T₁ → ∃ c : ℝ, ∀ x,
      P x t - p x t = stressPressure (fun i j y => (v y t - u y t) i * (v y t - u y t) j
          + (v y t - u y t) i * u y t j + u y t i * (v y t - u y t) j) x + c := by
    filter_upwards [hS4] with t ht htI
    obtain ⟨c, hc⟩ := ht htI
    exact ⟨c, fun x => by rw [hc x, hQ t]⟩

  obtain ⟨K, hK⟩ := cutoff_sobolev_bound C₀
  have hwslice : ∀ t ∈ Icc 0 T₁, ContDiff ℝ ∞ (fun y => v y t - u y t) :=
    fun t ht => slice (fun x t => v x t - u x t) _ t hwI ht
  have huslice : ∀ t ∈ Icc 0 T₁, ContDiff ℝ ∞ (fun y => u y t) :=
    fun t ht => slice u _ t huI ht
  have hπslice : ∀ t ∈ Icc 0 T₁, ContDiff ℝ ∞ (fun y => P y t - p y t) :=
    fun t ht => slice (fun x t => P x t - p x t) _ t hπI ht
  have hSob : ∀ t ∈ Icc 0 T₁, ∀ R : ℝ, 1 ≤ R →
      (∫ x, cutPhi R x ^ 24 * ‖v x t - u x t‖ ^ 6) ^ ((1 : ℝ) / 6) ≤ K * (1 + (∫ x, cutPhi R x ^ 8
        * ∑ k, ‖fderiv ℝ (fun y => v y t - u y t) x (EuclideanSpace.single k 1)‖ ^ 2)
          ^ ((1 : ℝ) / 2)) :=
    fun t ht => hK (fun y => v y t - u y t) (hwslice t ht) (hC₀ t ht).1 (hC₀ t ht).2

  obtain ⟨C, hC⟩ := stress_pressure_flux_bound C₀ M (max R 1) K
  have hvanI : ∀ x t, t ∈ Icc 0 T₁ → max R 1 ≤ ‖x‖ → u x t = 0 :=
    fun x t ht hx => (hvan x t (hIT t ht) (le_trans (le_max_left _ _) hx)).1
  have hflux : ∀ t ∈ Ioo 0 T₁, ∀ R' : ℝ, 1 ≤ R' → max R 1 ≤ R' →
      |∫ x, stressPressure (fun i j y => (v y t - u y t) i * (v y t - u y t) j
          + (v y t - u y t) i * u y t j + u y t i * (v y t - u y t) j) x
          * inner ℝ (v x t - u x t) (gradient (fun y => cutPhi R' y ^ 8) x)|
        ≤ C / R' * (1 + (∫ x, cutPhi R' x ^ 8
          * ∑ k, ‖fderiv ℝ (fun y => v y t - u y t) x (EuclideanSpace.single k 1)‖ ^ 2)
            ^ ((3 : ℝ) / 4)) := by
    intro t ht R' hR'1 hR'u
    have htI : t ∈ Icc 0 T₁ := ⟨ht.1.le, ht.2.le⟩
    exact hC (fun y => v y t - u y t) (fun y => u y t) (hwslice t htI) (huslice t htI)
      (hC₀ t htI).1 (hC₀ t htI).2 (fun x => hM x t htI) (fun x hx => hvanI x t htI hx)
      (hSob t htI) R' hR'1 hR'u

  have hadv : ∀ x t, t ∈ Icc 0 T₁ →
      derivWithin (fun s => v x s - u x s) (Ici 0) t
        + fderiv ℝ (fun y => v y t - u y t) x ((v x t - u x t) + u x t)
        + fderiv ℝ (fun y => u y t) x (v x t - u x t)
        = ν • Δ (fun y => v y t - u y t) x - gradient (fun y => P y t - p y t) x := by
    intro x t ht
    rw [sub_add_cancel]
    exact (hD x t ht.1 (hIT t ht)).1
  have hfin := localized_energy_uniqueness ν T₁ C₀ C (max R 1) L K (fun x t => v x t - u x t) u
    (fun x t => P x t - p x t)
    (fun x t => stressPressure (fun i j y => (v y t - u y t) i * (v y t - u y t) j
          + (v y t - u y t) i * u y t j + u y t i * (v y t - u y t) j) x)
    hν hT₁pos (le_max_right _ _) hSob hwI huI hπI
    (fun t ht => ⟨hwslice t ht, huslice t ht, hπslice t ht⟩) hvanI hL hadv hdivw
    (fun x t ht => hdivu x t ht.1 (hIT t ht)) (fun x => sub_eq_zero.mpr (hinit x)) hC₀
    hident hflux
  exact sub_eq_zero.mp (hfin x₀ t₀ ⟨ht₀, ht₀T₁⟩)

theorem ns_difference_equation : ∀ (ν T : ℝ) (U v : ℝ³ → ℝ → ℝ³) (Pu P : ℝ³ → ℝ → ℝ) (f : ℝ³ → ℝ → ℝ³), ContDiffOn ℝ ∞ (↿U) (univ ×ˢ Iio T) → ContDiffOn ℝ ∞ (↿Pu) (univ ×ˢ Iio T) → ContDiffOn ℝ ∞ (↿v) (univ ×ˢ Ici 0) → ContDiffOn ℝ ∞ (↿P) (univ ×ˢ Ici 0) → (∀ x t, 0 ≤ t → t < T → nsResidual ν U Pu x t = f x t) → (∀ x, ∀ t ≥ 0, derivWithin (v x ·) (Ici 0) t + fderiv ℝ (v · t) x (v x t) = ν • Δ (v · t) x - gradient (P · t) x + f x t) → ∀ x s, 0 < s → s < T → deriv (fun r => v x r - U x r) s = -(fderiv ℝ (fun y => v y s - U y s) x (v x s)) - fderiv ℝ (fun y => U y s) x (v x s - U x s) + ν • Δ (fun y => v y s - U y s) x - gradient (fun y => P y s - Pu y s) x :=
by
  intro ν T U v Pu P f hU hPu hv hP hres hNS x s hs hsT
  have hN1 : (univ : Set ℝ³) ×ˢ Ici (0:ℝ) ∈ nhds (x, s) :=
    prod_mem_nhds Filter.univ_mem (Ici_mem_nhds hs)
  have hN2 : (univ : Set ℝ³) ×ˢ Iio T ∈ nhds (x, s) :=
    prod_mem_nhds Filter.univ_mem (Iio_mem_nhds hsT)
  have hγ : DifferentiableAt ℝ (fun r : ℝ => (x, r)) s :=
    (differentiableAt_const x).prodMk differentiableAt_id
  have hvd : DifferentiableAt ℝ (fun r => v x r) s :=
    ((hv.contDiffAt hN1).differentiableAt (by simp)).comp s hγ
  have hUd : DifferentiableAt ℝ (fun r => U x r) s :=
    ((hU.contDiffAt hN2).differentiableAt (by simp)).comp s hγ
  have slice : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (g : ℝ³ → ℝ → F) (S : Set ℝ),
      ContDiffOn ℝ ∞ (↿g) (univ ×ˢ S) → s ∈ S → ContDiff ℝ ∞ (fun y => g y s) := by
    intro F _ _ g S hg hs'
    have h : ContDiffOn ℝ ∞ ((↿g) ∘ (fun y : ℝ³ => (y, s))) univ :=
      hg.comp (contDiff_id.prodMk contDiff_const).contDiffOn (fun y _ => ⟨mem_univ _, hs'⟩)
    exact contDiffOn_univ.mp h
  have hs0 : s ∈ Ici (0:ℝ) := le_of_lt hs
  have hV : ContDiff ℝ ∞ (fun y => v y s) := slice v (Ici 0) hv hs0
  have hUs : ContDiff ℝ ∞ (fun y => U y s) := slice U (Iio T) hU hsT
  have hPs : ContDiff ℝ ∞ (fun y => P y s) := slice P (Ici 0) hP hs0
  have hPus : ContDiff ℝ ∞ (fun y => Pu y s) := slice Pu (Iio T) hPu hsT
  have e1 : derivWithin (fun r => v x r) (Ici 0) s = deriv (fun r => v x r) s :=
    derivWithin_of_mem_nhds (Ici_mem_nhds hs)
  have e2 : deriv (fun r => v x r - U x r) s = deriv (fun r => v x r) s - deriv (fun r => U x r) s :=
    deriv_fun_sub hvd hUd
  have e3 : fderiv ℝ (fun y => v y s - U y s) x
      = fderiv ℝ (fun y => v y s) x - fderiv ℝ (fun y => U y s) x :=
    fderiv_fun_sub (hV.differentiable (by simp) x) (hUs.differentiable (by simp) x)
  have e4 : Δ (fun y => v y s - U y s) x = Δ (fun y => v y s) x - Δ (fun y => U y s) x :=
    ContDiffAt.laplacian_sub (hV.contDiffAt.of_le (by simp)) (hUs.contDiffAt.of_le (by simp))
  have e5 : gradient (fun y => P y s - Pu y s) x
      = gradient (fun y => P y s) x - gradient (fun y => Pu y s) x := by
    simp only [gradient]
    rw [fderiv_fun_sub (hPs.differentiable (by simp) x) (hPus.differentiable (by simp) x), map_sub]
  have h1 := hNS x s hs.le
  rw [e1] at h1
  have h2 := hres x s hs.le hsT
  unfold nsResidual at h2
  have ha : deriv (fun r => v x r) s
      = ν • Δ (fun y => v y s) x - gradient (fun y => P y s) x + f x s
        - fderiv ℝ (fun y => v y s) x (v x s) := eq_sub_of_add_eq h1
  have hb : deriv (fun r => U x r) s
      = f x s - fderiv ℝ (fun y => U y s) x (U x s) + ν • Δ (fun y => U y s) x
        - gradient (fun y => Pu y s) x := by
    rw [← h2]; abel
  rw [e2, e3, e4, e5, ContinuousLinearMap.sub_apply, map_sub, smul_sub, ha, hb]
  abel

theorem energy_flux_identity : ∀ (ν : ℝ) (V w : ℝ³ → ℝ³) (q : ℝ³ → ℝ) (x : ℝ³), ContDiff ℝ ∞ V → ContDiff ℝ ∞ w → ContDiff ℝ ∞ q → inner ℝ (w x) (-(fderiv ℝ w x (V x)) + ν • Δ w x - gradient q x) = -divergence (fun y => (‖w y‖ ^ 2 / 2) • V y + q y • w y - ν • ∑ j : Fin 3, (inner ℝ (fderiv ℝ w y (EuclideanSpace.single j 1)) (w y)) • EuclideanSpace.single j 1) x - ν * ∑ j : Fin 3, ‖fderiv ℝ w x (EuclideanSpace.single j 1)‖ ^ 2 + (‖w x‖ ^ 2 / 2) * divergence V x + q x * divergence w x :=
by
  intro ν V w q x hV hw hq
  have hVd : Differentiable ℝ V := hV.differentiable (by simp)
  have hwd : Differentiable ℝ w := hw.differentiable (by simp)
  have hqd : Differentiable ℝ q := hq.differentiable (by simp)
  have hD1 : ContDiff ℝ 1 (fderiv ℝ w) := hw.fderiv_right (by simp)
  have hDd : Differentiable ℝ (fderiv ℝ w) := hD1.differentiable (by simp)

  have c1 : ∀ (a : ℝ³ → ℝ) (F : ℝ³ → ℝ³), DifferentiableAt ℝ a x → DifferentiableAt ℝ F x →
      divergence (fun y => a y • F y) x = fderiv ℝ a x (F x) + a x * divergence F x := by
    intro a F ha hF
    unfold divergence
    rw [fderiv_fun_smul ha hF]
    simp only [ContinuousLinearMap.coe_add, ContinuousLinearMap.coe_smul,
      ContinuousLinearMap.coe_smulRight, map_add, map_smul, LinearMap.trace_smulRight, smul_eq_mul,
      ContinuousLinearMap.coe_coe]
    ring

  have c2 : ∀ (c : Fin 3 → ℝ³ → ℝ), (∀ j, DifferentiableAt ℝ (c j) x) →
      divergence (fun y => ∑ j : Fin 3, c j y • EuclideanSpace.single j (1:ℝ)) x
        = ∑ j : Fin 3, fderiv ℝ (c j) x (EuclideanSpace.single j 1) := by
    intro c hc
    unfold divergence
    rw [fderiv_fun_sum (A := fun j y => c j y • EuclideanSpace.single j (1:ℝ))
      (fun j _ => (hc j).smul_const _)]
    have h : ∀ j, fderiv ℝ (fun y => c j y • EuclideanSpace.single j (1:ℝ)) x
        = (fderiv ℝ (c j) x).smulRight (EuclideanSpace.single j (1:ℝ)) :=
      fun j => fderiv_smul_const (hc j) _
    simp only [h, ContinuousLinearMap.coe_sum, ContinuousLinearMap.coe_smulRight, map_sum,
      LinearMap.trace_smulRight, ContinuousLinearMap.coe_coe]

  have c6 : ∀ (A B C : ℝ³ → ℝ³), DifferentiableAt ℝ A x → DifferentiableAt ℝ B x →
      DifferentiableAt ℝ C x →
      divergence (fun y => A y + B y - ν • C y) x
        = divergence A x + divergence B x - ν * divergence C x := by
    intro A B C hA hB hC
    unfold divergence
    have hAB : DifferentiableAt ℝ (fun y => A y + B y) x := hA.add hB
    have hνC : DifferentiableAt ℝ (fun y => ν • C y) x := hC.const_smul ν
    rw [fderiv_fun_sub hAB hνC, fderiv_fun_add hA hB, fderiv_fun_const_smul hC ν]
    simp only [ContinuousLinearMap.coe_sub, ContinuousLinearMap.coe_add,
      ContinuousLinearMap.coe_smul, map_sub, map_add, map_smul, smul_eq_mul]

  have c4 : ∀ h : ℝ³, fderiv ℝ (fun y => ‖w y‖ ^ 2 / 2) x h = inner ℝ (w x) (fderiv ℝ w x h) := by
    intro h
    have H : HasFDerivAt (fun y => ‖w y‖ ^ 2 * 2⁻¹)
        ((2⁻¹ : ℝ) • (2 • (innerSL ℝ (w x)).comp (fderiv ℝ w x))) x :=
      ((hwd x).hasFDerivAt.norm_sq).mul_const _
    have e : (fun y => ‖w y‖ ^ 2 / 2) = fun y => ‖w y‖ ^ 2 * 2⁻¹ := by
      funext y; ring
    rw [e, H.fderiv]
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.comp_apply,
      innerSL_apply_apply, smul_eq_mul, nsmul_eq_mul]
    ring

  have c5 : ∀ u h : ℝ³, fderiv ℝ (fun y => inner ℝ (fderiv ℝ w y u) (w y)) x h
      = inner ℝ (fderiv ℝ (fun y => fderiv ℝ w y u) x h) (w x)
        + inner ℝ (fderiv ℝ w x u) (fderiv ℝ w x h) := by
    intro u h
    have hf : DifferentiableAt ℝ (fun y => fderiv ℝ w y u) x :=
      (hDd x).clm_apply (differentiableAt_const u)
    rw [fderiv_inner_apply ℝ hf (hwd x) h]
    ring

  have c3 : Δ w x = ∑ j : Fin 3, fderiv ℝ (fun y => fderiv ℝ w y (EuclideanSpace.single j 1)) x
      (EuclideanSpace.single j 1) := by
    rw [congrFun (InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis w
      (EuclideanSpace.basisFun (Fin 3) ℝ)) x]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [iteratedFDeriv_two_apply, EuclideanSpace.basisFun_apply]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    rw [fderiv_clm_apply (hDd x) (differentiableAt_const _)]
    simp

  have hcj : ∀ j : Fin 3, DifferentiableAt ℝ
      (fun y => inner ℝ (fderiv ℝ w y (EuclideanSpace.single j 1)) (w y)) x :=
    fun j => ((hDd x).clm_apply (differentiableAt_const _)).inner ℝ (hwd x)
  have hN : DifferentiableAt ℝ (fun y => ‖w y‖ ^ 2 / 2) x := (((hw.of_le (by simp) : ContDiff ℝ 1 w).norm_sq ℝ).div_const 2).differentiable (by simp) x
  have hA : DifferentiableAt ℝ (fun y => (‖w y‖ ^ 2 / 2) • V y) x := hN.smul (hVd x)
  have hB : DifferentiableAt ℝ (fun y => q y • w y) x := (hqd x).smul (hwd x)
  have hC : DifferentiableAt ℝ (fun y => ∑ j : Fin 3,
      (inner ℝ (fderiv ℝ w y (EuclideanSpace.single j 1)) (w y)) • EuclideanSpace.single j (1:ℝ)) x := by
    exact DifferentiableAt.fun_sum (fun j _ => (hcj j).smul_const _)
  have hgq : fderiv ℝ q x (w x) = inner ℝ (gradient q x) (w x) := (inner_gradient_left).symm
  rw [c6 _ _ _ hA hB hC, c1 _ _ hN (hVd x), c1 _ _ (hqd x) (hwd x), c2 _ hcj, c4, hgq]
  simp only [c5]
  rw [Finset.sum_add_distrib, ← sum_inner, ← c3]
  simp only [real_inner_self_eq_norm_sq, inner_add_right, inner_sub_right, inner_neg_right,
    real_inner_smul_right]
  rw [real_inner_comm (w x) (gradient q x), real_inner_comm (w x) (Δ w x)]
  ring

theorem periodic_divergence_integral_zero : ∀ Φ : ℝ³ → ℝ³, ContDiff ℝ 1 Φ → IsOnePeriodic Φ → IntegrableOn (fun y => divergence Φ (WithLp.toLp 2 y)) (Icc (0 : Fin 3 → ℝ) 1) ∧ ∫ y in Icc (0 : Fin 3 → ℝ) 1, divergence Φ (WithLp.toLp 2 y) = 0 :=
by
  intro Φ hΦ hper
  set eO : EuclideanSpace ℝ (Fin 3) ≃L[ℝ] (Fin 3 → ℝ) :=
    PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin 3 => ℝ) with heO
  set f : (Fin 3 → ℝ) → (Fin 3 → ℝ) := fun y => eO (Φ (eO.symm y)) with hfdef
  have hfC : ContDiff ℝ 1 f := eO.contDiff.comp (hΦ.comp eO.symm.contDiff)
  have hΦd : Differentiable ℝ Φ := hΦ.differentiable one_ne_zero
  have hfd : ∀ y, HasFDerivAt f ((eO : EuclideanSpace ℝ (Fin 3) →L[ℝ] (Fin 3 → ℝ)).comp
      ((fderiv ℝ Φ (eO.symm y)).comp
        (eO.symm : (Fin 3 → ℝ) →L[ℝ] EuclideanSpace ℝ (Fin 3)))) y := by
    intro y
    exact eO.hasFDerivAt.comp y ((hΦd _).hasFDerivAt.comp y eO.symm.hasFDerivAt)
  have hsingle : ∀ i : Fin 3, eO.symm (Pi.single i 1) = EuclideanSpace.single i 1 := by
    intro i
    rfl
  have hG : ∀ y, ∑ i : Fin 3, fderiv ℝ f y (Pi.single i 1) i
      = divergence Φ (WithLp.toLp 2 y) := by
    intro y
    rw [(hfd y).fderiv]
    unfold divergence
    rw [LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin 3) ℝ)]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [EuclideanSpace.basisFun_apply, EuclideanSpace.inner_single_left]
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe, hsingle,
      ContinuousLinearMap.coe_coe, map_one, one_mul]
    rfl
  have hfper : ∀ y (i : Fin 3), f (y + Pi.single i 1) = f y := by
    intro y i
    simp only [hfdef, map_add, hsingle]
    rw [hper]
  have hGc : Continuous (fun y => ∑ i : Fin 3, fderiv ℝ f y (Pi.single i 1) i) := by
    have hc : Continuous (fderiv ℝ f) := hfC.continuous_fderiv one_ne_zero
    exact continuous_finset_sum _ (fun i _ =>
      (continuous_apply i).comp (hc.clm_apply continuous_const))
  have hInt : IntegrableOn (fun y => ∑ i : Fin 3, fderiv ℝ f y (Pi.single i 1) i)
      (Icc (0 : Fin 3 → ℝ) 1) := hGc.integrableOn_Icc
  have key := MeasureTheory.integral_divergence_of_hasFDerivAt_off_countable (n := 2)
    (0 : Fin 3 → ℝ) 1 (fun _ => zero_le_one) f (fderiv ℝ f) ∅ countable_empty
    hfC.continuous.continuousOn
    (fun x _ => (hfC.differentiable one_ne_zero x).hasFDerivAt) hInt
  have hface : ∀ i : Fin 3, ∀ z : Fin 2 → ℝ,
      f (Fin.insertNth (α := fun _ => ℝ) i ((1 : Fin 3 → ℝ) i) z)
        = f (Fin.insertNth (α := fun _ => ℝ) i ((0 : Fin 3 → ℝ) i) z) := by
    intro i z
    have h := Fin.insertNth_add (α := fun _ => ℝ) i (0 : ℝ) (1 : ℝ) z 0
    rw [Fin.insertNth_zero_right, zero_add, add_zero] at h
    have e : Fin.insertNth (α := fun _ => ℝ) i ((1 : Fin 3 → ℝ) i) z
        = Fin.insertNth (α := fun _ => ℝ) i ((0 : Fin 3 → ℝ) i) z + Pi.single i 1 := by
      simpa using h
    rw [e, hfper]
  have hGfun : (fun y => divergence Φ (WithLp.toLp 2 y))
      = fun y => ∑ i : Fin 3, fderiv ℝ f y (Pi.single i 1) i :=
    funext fun y => (hG y).symm
  refine ⟨?_, ?_⟩
  · rw [hGfun]; exact hInt
  · rw [hGfun, key]
    simp_rw [hface, sub_self]
    simp

theorem slice_energy_hasDerivAt : ∀ (g : ℝ³ → ℝ → ℝ³) (a b : ℝ), a < b → ContinuousOn (↿g) (univ ×ˢ Icc a b) → ContDiffOn ℝ ∞ (↿g) (univ ×ˢ Ioo a b) → ContinuousOn (fun s => ∫ y in Icc (0 : Fin 3 → ℝ) 1, ‖g (WithLp.toLp 2 y) s‖ ^ 2) (Icc a b) ∧ ∀ s ∈ Ioo a b, IntegrableOn (fun y => 2 * inner ℝ (g (WithLp.toLp 2 y) s) (deriv (fun r => g (WithLp.toLp 2 y) r) s)) (Icc (0 : Fin 3 → ℝ) 1) ∧ HasDerivAt (fun s => ∫ y in Icc (0 : Fin 3 → ℝ) 1, ‖g (WithLp.toLp 2 y) s‖ ^ 2) (∫ y in Icc (0 : Fin 3 → ℝ) 1, 2 * inner ℝ (g (WithLp.toLp 2 y) s) (deriv (fun r => g (WithLp.toLp 2 y) r) s)) s :=
by
  intro g a b hab hc hd
  have hφ : Continuous (fun p : (Fin 3 → ℝ) × ℝ => ((WithLp.toLp 2 p.1 : ℝ³), p.2)) :=
    ((PiLp.continuous_toLp 2 _).comp continuous_fst).prodMk continuous_snd
  have hG : ContinuousOn (fun p : (Fin 3 → ℝ) × ℝ => g (WithLp.toLp 2 p.1) p.2) (univ ×ˢ Icc a b) :=
    hc.comp hφ.continuousOn (fun p hp => ⟨mem_univ _, hp.2⟩)
  have hslice : ∀ s ∈ Icc a b, Continuous (fun y : Fin 3 → ℝ => g (WithLp.toLp 2 y) s) := by
    intro s hs
    have h : ContinuousOn (fun y : Fin 3 → ℝ => g (WithLp.toLp 2 y) s) univ :=
      hG.comp (continuous_id.prodMk continuous_const).continuousOn (fun y _ => ⟨mem_univ _, hs⟩)
    exact continuousOn_univ.mp h
  have htime : ∀ y : Fin 3 → ℝ, ContinuousOn (fun s => g (WithLp.toLp 2 y) s) (Icc a b) := by
    intro y
    exact hG.comp (continuous_const.prodMk continuous_id).continuousOn (fun s hs => ⟨mem_univ _, hs⟩)
  refine ⟨?_, ?_⟩
  · obtain ⟨C, hC⟩ := (isCompact_Icc.prod isCompact_Icc :
        IsCompact ((Icc (0 : Fin 3 → ℝ) 1) ×ˢ Icc a b)).exists_bound_of_continuousOn
        (hG.mono (prod_mono (subset_univ _) subset_rfl))
    refine continuousOn_of_dominated (F := fun s y => ‖g (WithLp.toLp 2 y) s‖ ^ 2)
      (bound := fun _ => C ^ 2) ?_ ?_ ?_ ?_
    · intro s hs
      exact (((hslice s hs).norm.pow 2).continuousOn).aestronglyMeasurable measurableSet_Icc
    · intro s hs
      refine ae_restrict_of_forall_mem measurableSet_Icc (fun y hy => ?_)
      have h1 : ‖g (WithLp.toLp 2 y) s‖ ≤ C := hC (y, s) ⟨hy, hs⟩
      show ‖‖g (WithLp.toLp 2 y) s‖ ^ 2‖ ≤ C ^ 2
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      exact pow_le_pow_left₀ (norm_nonneg _) h1 2
    · exact continuousOn_const.integrableOn_compact isCompact_Icc
    · exact Filter.Eventually.of_forall (fun y => ((htime y).norm.pow 2))
  · intro s₀ hs₀
    have hO : IsOpen ((univ : Set ℝ³) ×ˢ Ioo a b) := isOpen_univ.prod isOpen_Ioo
    have hdiff : ∀ (x : ℝ³), ∀ r ∈ Ioo a b, DifferentiableAt ℝ (↿g) (x, r) := fun x r hr =>
      (hd.contDiffAt (hO.mem_nhds ⟨mem_univ _, hr⟩)).differentiableAt (by simp)
    have s2 : ∀ (x : ℝ³), ∀ r ∈ Ioo a b,
        HasDerivAt (fun r => g x r) (fderiv ℝ (↿g) (x, r) ((0 : ℝ³), (1 : ℝ))) r := by
      intro x r hr
      have hγ : HasDerivAt (fun r' : ℝ => (x, r')) ((0 : ℝ³), (1 : ℝ)) r :=
        (hasDerivAt_const r x).prodMk (hasDerivAt_id' r)
      exact (hdiff x r hr).hasFDerivAt.comp_hasDerivAt r hγ
    have s3 : ContinuousOn (fun p : (Fin 3 → ℝ) × ℝ =>
        fderiv ℝ (↿g) (WithLp.toLp 2 p.1, p.2) ((0 : ℝ³), (1 : ℝ))) (univ ×ˢ Ioo a b) := by
      have h1 : ContinuousOn (fderiv ℝ (↿g)) ((univ : Set ℝ³) ×ˢ Ioo a b) :=
        hd.continuousOn_fderiv_of_isOpen hO (by simp)
      have h2 : ContinuousOn (fun p : (Fin 3 → ℝ) × ℝ => fderiv ℝ (↿g) (WithLp.toLp 2 p.1, p.2))
          (univ ×ˢ Ioo a b) :=
        h1.comp hφ.continuousOn (fun p (hp : p ∈ (univ : Set (Fin 3 → ℝ)) ×ˢ Ioo a b) =>
          ⟨mem_univ _, hp.2⟩)
      exact h2.clm_apply continuousOn_const
    obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = min (s₀ - a) (b - s₀) / 2 := ⟨_, rfl⟩
    have hm1 := min_le_left (s₀ - a) (b - s₀)
    have hm2 := min_le_right (s₀ - a) (b - s₀)
    have hδpos : 0 < δ := by
      have := lt_min (sub_pos.mpr hs₀.1) (sub_pos.mpr hs₀.2)
      linarith
    have hJsub : Icc (s₀ - δ) (s₀ + δ) ⊆ Ioo a b := by
      intro r hr
      have := hs₀.1
      have := hs₀.2
      exact ⟨by linarith [hr.1], by linarith [hr.2]⟩
    have hJ : Icc (s₀ - δ) (s₀ + δ) ∈ nhds s₀ := Icc_mem_nhds (by linarith) (by linarith)
    have hH : ContinuousOn (fun p : (Fin 3 → ℝ) × ℝ => 2 * inner ℝ (g (WithLp.toLp 2 p.1) p.2)
        (fderiv ℝ (↿g) (WithLp.toLp 2 p.1, p.2) ((0 : ℝ³), (1 : ℝ)))) (univ ×ˢ Ioo a b) :=
      continuousOn_const.mul ((hG.mono (prod_mono subset_rfl Ioo_subset_Icc_self)).inner s3)
    obtain ⟨C', hC'⟩ := (isCompact_Icc.prod isCompact_Icc :
        IsCompact ((Icc (0 : Fin 3 → ℝ) 1) ×ˢ Icc (s₀ - δ) (s₀ + δ))).exists_bound_of_continuousOn
        (hH.mono (prod_mono (subset_univ _) hJsub))
    have hF'eq : ∀ r ∈ Ioo a b, ∀ y : Fin 3 → ℝ,
        2 * inner ℝ (g (WithLp.toLp 2 y) r) (deriv (fun r => g (WithLp.toLp 2 y) r) r)
          = 2 * inner ℝ (g (WithLp.toLp 2 y) r)
              (fderiv ℝ (↿g) (WithLp.toLp 2 y, r) ((0 : ℝ³), (1 : ℝ))) := by
      intro r hr y
      rw [(s2 _ r hr).deriv]
    refine hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (μ := volume.restrict (Icc (0 : Fin 3 → ℝ) 1)) (x₀ := s₀)
      (F := fun r y => ‖g (WithLp.toLp 2 y) r‖ ^ 2)
      (F' := fun r y => 2 * inner ℝ (g (WithLp.toLp 2 y) r) (deriv (fun r => g (WithLp.toLp 2 y) r) r))
      (bound := fun _ => C') hJ ?_ ?_ ?_ ?_ ?_ ?_
    · exact Filter.eventually_of_mem hJ (fun r hr =>
        (((hslice r (Ioo_subset_Icc_self (hJsub hr))).norm.pow 2).continuousOn).aestronglyMeasurable
          measurableSet_Icc)
    · exact ((hslice s₀ (Ioo_subset_Icc_self hs₀)).norm.pow 2).continuousOn.integrableOn_compact
        isCompact_Icc
    · have heq : (fun y : Fin 3 → ℝ => 2 * inner ℝ (g (WithLp.toLp 2 y) s₀)
            (deriv (fun r => g (WithLp.toLp 2 y) r) s₀))
          = fun y => (fun p : (Fin 3 → ℝ) × ℝ => 2 * inner ℝ (g (WithLp.toLp 2 p.1) p.2)
              (fderiv ℝ (↿g) (WithLp.toLp 2 p.1, p.2) ((0 : ℝ³), (1 : ℝ)))) (y, s₀) :=
        funext (fun y => hF'eq s₀ hs₀ y)
      show AEStronglyMeasurable (fun y : Fin 3 → ℝ => 2 * inner ℝ (g (WithLp.toLp 2 y) s₀)
            (deriv (fun r => g (WithLp.toLp 2 y) r) s₀)) _
      rw [heq]
      exact (hH.comp (continuous_id.prodMk continuous_const).continuousOn
        (fun y _ => ⟨mem_univ _, hs₀⟩)).aestronglyMeasurable measurableSet_Icc
    · refine ae_restrict_of_forall_mem measurableSet_Icc (fun y hy r hr => ?_)
      show ‖2 * inner ℝ (g (WithLp.toLp 2 y) r) (deriv (fun r => g (WithLp.toLp 2 y) r) r)‖ ≤ C'
      rw [hF'eq r (hJsub hr) y]
      exact hC' (y, r) ⟨hy, hr⟩
    · exact continuousOn_const.integrableOn_compact isCompact_Icc
    · refine Filter.Eventually.of_forall (fun y r hr => ?_)
      exact ((s2 _ r (hJsub hr)).differentiableAt.hasDerivAt).norm_sq

theorem gronwall_zero : ∀ (E E' : ℝ → ℝ) (K t : ℝ), ContinuousOn E (Icc 0 t) → (∀ s ∈ Ioo 0 t, HasDerivAt E (E' s) s) → (∀ s ∈ Ioo 0 t, E' s ≤ K * E s) → E 0 = 0 → (∀ s ∈ Icc 0 t, 0 ≤ E s) → ∀ s ∈ Icc 0 t, E s = 0 :=
by
  intro E E' K t hc hd hle h0 hnn s hs
  set G : ℝ → ℝ := fun r => Real.exp (-K * r) * E r with hG
  set G' : ℝ → ℝ := fun r => Real.exp (-K * r) * (E' r - K * E r) with hG'
  have hGc : ContinuousOn G (Icc 0 t) := by
    have he : Continuous (fun r : ℝ => Real.exp (-K * r)) := by fun_prop
    exact he.continuousOn.mul hc
  have hGd : ∀ r ∈ Ioo 0 t, HasDerivAt G (G' r) r := by
    intro r hr
    have h1 : HasDerivAt (fun r : ℝ => -K * r) (-K) r := by
      simpa using (hasDerivAt_id r).const_mul (-K)
    have h2 := h1.exp.mul (hd r hr)
    convert h2 using 1
    simp only [hG']
    ring
  have hGn : ∀ r ∈ Ioo 0 t, G' r ≤ 0 := by
    intro r hr
    exact mul_nonpos_of_nonneg_of_nonpos (Real.exp_pos _).le (sub_nonpos.mpr (hle r hr))
  have hanti : AntitoneOn G (Icc 0 t) := by
    apply antitoneOn_of_hasDerivWithinAt_nonpos (convex_Icc 0 t) hGc
    · intro x hx
      rw [interior_Icc] at hx ⊢
      exact (hGd x hx).hasDerivWithinAt
    · intro x hx
      rw [interior_Icc] at hx
      exact hGn x hx
  have h0mem : (0 : ℝ) ∈ Icc 0 t := ⟨le_rfl, hs.1.trans hs.2⟩
  have hle0 : G s ≤ G 0 := hanti h0mem hs hs.1
  have hG0 : G 0 = 0 := by simp [hG, h0]
  rw [hG0] at hle0
  have hpos := Real.exp_pos (-K * s)
  have hEs : E s ≤ 0 := by
    by_contra hcon
    have : 0 < G s := mul_pos hpos (not_le.mp hcon)
    linarith
  exact le_antisymm hEs (hnn s hs)

theorem periodic_zero_of_integral_sq_zero : ∀ h : ℝ³ → ℝ³, Continuous h → IsOnePeriodic h → ∫ y in Icc (0 : Fin 3 → ℝ) 1, ‖h (WithLp.toLp 2 y)‖ ^ 2 = 0 → ∀ x, h x = 0 :=
by
  intro h hcont hper hint x

  have hshift : ∀ (i : Fin 3) (k : ℤ) (z : ℝ³),
      h (z + (k : ℝ) • EuclideanSpace.single i (1 : ℝ)) = h z := by
    intro i k
    induction k using Int.induction_on with
    | zero => intro z; simp
    | succ n ih =>
      intro z
      have e : z + (((n : ℤ) + 1 : ℤ) : ℝ) • EuclideanSpace.single i (1 : ℝ)
          = (z + ((n : ℤ) : ℝ) • EuclideanSpace.single i (1 : ℝ)) + EuclideanSpace.single i 1 := by
        push_cast
        rw [add_smul, one_smul, add_assoc]
      rw [e, hper, ih]
    | pred n ih =>
      intro z
      have e : z + ((-(n : ℤ) - 1 : ℤ) : ℝ) • EuclideanSpace.single i (1 : ℝ)
          + EuclideanSpace.single i 1 = z + ((-(n : ℤ) : ℤ) : ℝ) • EuclideanSpace.single i (1 : ℝ) := by
        push_cast
        rw [sub_smul, one_smul]
        abel
      have e2 := hper (z + ((-(n : ℤ) - 1 : ℤ) : ℝ) • EuclideanSpace.single i (1 : ℝ)) i
      rw [e] at e2
      rw [← e2, ih]

  have hdec : x = ((WithLp.toLp 2 (fun j => Int.fract (x.ofLp j))
      + ((⌊x.ofLp 0⌋ : ℤ) : ℝ) • EuclideanSpace.single 0 (1 : ℝ))
      + ((⌊x.ofLp 1⌋ : ℤ) : ℝ) • EuclideanSpace.single 1 (1 : ℝ))
      + ((⌊x.ofLp 2⌋ : ℤ) : ℝ) • EuclideanSpace.single 2 (1 : ℝ) := by
    ext j
    fin_cases j <;> simp
  have hx : h x = h (WithLp.toLp 2 (fun j => Int.fract (x.ofLp j))) := by
    calc h x = h (((WithLp.toLp 2 (fun j => Int.fract (x.ofLp j))
          + ((⌊x.ofLp 0⌋ : ℤ) : ℝ) • EuclideanSpace.single 0 (1 : ℝ))
          + ((⌊x.ofLp 1⌋ : ℤ) : ℝ) • EuclideanSpace.single 1 (1 : ℝ))
          + ((⌊x.ofLp 2⌋ : ℤ) : ℝ) • EuclideanSpace.single 2 (1 : ℝ)) := congrArg h hdec
      _ = _ := by rw [hshift, hshift, hshift]
  have hyIcc : (fun j => Int.fract (x.ofLp j)) ∈ Icc (0 : Fin 3 → ℝ) 1 :=
    ⟨fun j => Int.fract_nonneg _, fun j => (Int.fract_lt_one _).le⟩

  have hF : Continuous (fun y : Fin 3 → ℝ => ‖h (WithLp.toLp 2 y)‖ ^ 2) :=
    ((hcont.comp (PiLp.continuous_toLp 2 _)).norm).pow 2
  have hInt : IntegrableOn (fun y : Fin 3 → ℝ => ‖h (WithLp.toLp 2 y)‖ ^ 2) (Icc 0 1) :=
    hF.continuousOn.integrableOn_compact isCompact_Icc
  have hae := (setIntegral_eq_zero_iff_of_nonneg_ae
    (Filter.Eventually.of_forall (fun y => by positivity)) hInt).mp hint
  have hsub : Icc (0 : Fin 3 → ℝ) 1 ⊆ closure (interior (Icc 0 1)) := by
    rw [← Set.pi_univ_Icc, interior_pi_set Set.finite_univ, closure_pi_set]
    intro z hz
    simp only [Set.mem_pi, Set.mem_univ, true_implies, Pi.zero_apply, Pi.one_apply] at hz ⊢
    intro j
    rw [interior_Icc, closure_Ioo zero_ne_one]
    exact hz j
  have heq := Measure.eqOn_of_ae_eq hae hF.continuousOn continuous_zero.continuousOn hsub
  have h0 := heq hyIcc
  simp only [Pi.zero_apply] at h0
  rw [hx]
  exact norm_eq_zero.mp (pow_eq_zero_iff two_ne_zero |>.mp h0)

theorem spatial_fderiv_bound_on_cube : ∀ (U : ℝ³ → ℝ → ℝ³) (T t : ℝ), ContDiffOn ℝ ∞ (↿U) (univ ×ˢ Iio T) → t < T → ∃ L : ℝ, ∀ y ∈ Icc (0 : Fin 3 → ℝ) 1, ∀ s ∈ Icc 0 t, ‖fderiv ℝ (fun z => U z s) (WithLp.toLp 2 y)‖ ≤ L :=
by
  intro U T t hU htT
  have hΩ : IsOpen ((univ : Set ℝ³) ×ˢ Iio T) := isOpen_univ.prod isOpen_Iio
  have hDc : ContinuousOn (fderiv ℝ (↿U)) ((univ : Set ℝ³) ×ˢ Iio T) :=
    hU.continuousOn_fderiv_of_isOpen hΩ (by simp)
  have hDiff : DifferentiableOn ℝ (↿U) ((univ : Set ℝ³) ×ˢ Iio T) :=
    hU.differentiableOn (by simp)
  have hchain : ∀ (z : ℝ³) (s : ℝ), s < T →
      ‖fderiv ℝ (fun z' => U z' s) z‖ ≤ ‖fderiv ℝ (↿U) (z, s)‖ := by
    intro z s hs
    have hmem : (z, s) ∈ (univ : Set ℝ³) ×ˢ Iio T := ⟨mem_univ _, hs⟩
    have hA : HasFDerivAt (↿U) (fderiv ℝ (↿U) (z, s)) (z, s) :=
      (hDiff.differentiableAt (hΩ.mem_nhds hmem)).hasFDerivAt
    have hB : HasFDerivAt (fun e : ℝ³ => (e, s)) (ContinuousLinearMap.inl ℝ ℝ³ ℝ) z :=
      hasFDerivAt_prodMk_left z s
    have hC : HasFDerivAt (fun z' => U z' s)
        ((fderiv ℝ (↿U) (z, s)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ)) z :=
      by
        have h := hA.comp z hB
        exact h
    rw [hC.fderiv]
    calc ‖(fderiv ℝ (↿U) (z, s)).comp (ContinuousLinearMap.inl ℝ ℝ³ ℝ)‖
        ≤ ‖fderiv ℝ (↿U) (z, s)‖ * ‖ContinuousLinearMap.inl ℝ ℝ³ ℝ‖ :=
          ContinuousLinearMap.opNorm_comp_le _ _
      _ ≤ ‖fderiv ℝ (↿U) (z, s)‖ * 1 :=
          mul_le_mul_of_nonneg_left (ContinuousLinearMap.norm_inl_le_one ℝ ℝ³ ℝ) (norm_nonneg _)
      _ = ‖fderiv ℝ (↿U) (z, s)‖ := mul_one _
  have hK : IsCompact (Icc (0 : Fin 3 → ℝ) 1 ×ˢ Icc (0 : ℝ) t) := isCompact_Icc.prod isCompact_Icc
  have hι : Continuous (fun p : (Fin 3 → ℝ) × ℝ => ((WithLp.toLp 2 p.1 : ℝ³), p.2)) :=
    ((PiLp.continuous_toLp 2 _).comp continuous_fst).prodMk continuous_snd
  have hmaps : MapsTo (fun p : (Fin 3 → ℝ) × ℝ => ((WithLp.toLp 2 p.1 : ℝ³), p.2))
      (Icc (0 : Fin 3 → ℝ) 1 ×ˢ Icc (0 : ℝ) t) ((univ : Set ℝ³) ×ˢ Iio T) :=
    fun p hp => ⟨mem_univ _, lt_of_le_of_lt hp.2.2 htT⟩
  obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn (hDc.comp hι.continuousOn hmaps)
  refine ⟨C, fun y hy s hs => ?_⟩
  exact (hchain _ s (lt_of_le_of_lt hs.2 htT)).trans (hC (y, s) ⟨hy, hs⟩)

theorem torus_energy_uniqueness : ∀ (ν T : ℝ) (U v : ℝ³ → ℝ → ℝ³) (Pu P : ℝ³ → ℝ → ℝ) (f : ℝ³ → ℝ → ℝ³), 0 < ν → 0 < T → ContDiffOn ℝ ∞ (↿U) (univ ×ˢ Iio T) → ContDiffOn ℝ ∞ (↿Pu) (univ ×ˢ Iio T) → (∀ t, 0 ≤ t → t < T → IsOnePeriodic (fun x => U x t)) → (∀ t, 0 ≤ t → t < T → IsOnePeriodic (fun x => Pu x t)) → (∀ x t, 0 ≤ t → t < T → nsResidual ν U Pu x t = f x t) → (∀ x t, 0 ≤ t → t < T → divergence (fun y => U y t) x = 0) → ContDiffOn ℝ ∞ (↿v) (univ ×ˢ Ici 0) → ContDiffOn ℝ ∞ (↿P) (univ ×ˢ Ici 0) → (∀ t ≥ 0, IsOnePeriodic (v · t)) → (∀ t ≥ 0, IsOnePeriodic (P · t)) → (∀ x, ∀ t ≥ 0, derivWithin (v x ·) (Ici 0) t + fderiv ℝ (v · t) x (v x t) = ν • Δ (v · t) x - gradient (P · t) x + f x t) → (∀ x, ∀ t ≥ 0, divergence (v · t) x = 0) → (∀ x, v x 0 = U x 0) → ∀ x t, 0 ≤ t → t < T → v x t = U x t :=
by
  intro ν T U v Pu P f hν hT hU hPu hUper hPuper hres hdivU hv hP hvper hPper hNS hdivv hinit x₀ t ht0 htT
  rcases eq_or_lt_of_le ht0 with h0 | htpos
  · subst h0
    exact hinit x₀

  have slice : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (g : ℝ³ → ℝ → F) (S : Set ℝ),
      ContDiffOn ℝ ∞ (↿g) (univ ×ˢ S) → ∀ s ∈ S, ContDiff ℝ ∞ (fun y => g y s) := by
    intro F _ _ g S hg s hs
    have h : ContDiffOn ℝ ∞ ((↿g) ∘ (fun y : ℝ³ => (y, s))) univ :=
      hg.comp (contDiff_id.prodMk contDiff_const).contDiffOn (fun y _ => ⟨mem_univ _, hs⟩)
    exact contDiffOn_univ.mp h

  obtain ⟨g, hg⟩ : ∃ g : ℝ³ → ℝ → ℝ³, g = fun x r => v x r - U x r := ⟨_, rfl⟩
  have hgxr : ∀ x r, g x r = v x r - U x r := fun x r => by rw [hg]
  have h1 : (univ : Set ℝ³) ×ˢ Icc (0 : ℝ) t ⊆ univ ×ˢ Ici 0 := prod_mono subset_rfl Icc_subset_Ici_self
  have h2 : (univ : Set ℝ³) ×ˢ Icc (0 : ℝ) t ⊆ univ ×ˢ Iio T :=
    prod_mono subset_rfl (fun r hr => lt_of_le_of_lt hr.2 htT)
  have hgcd : ContDiffOn ℝ ∞ (↿g) (univ ×ˢ Icc 0 t) := by
    rw [hg]
    exact (hv.mono h1).sub (hU.mono h2)
  have hgc : ContinuousOn (↿g) (univ ×ˢ Icc 0 t) := hgcd.continuousOn
  have hgcd' : ContDiffOn ℝ ∞ (↿g) (univ ×ˢ Ioo 0 t) :=
    hgcd.mono (prod_mono subset_rfl Ioo_subset_Icc_self)

  obtain ⟨hEcont, hEder⟩ := slice_energy_hasDerivAt g 0 t htpos hgc hgcd'

  obtain ⟨L₀, hL₀⟩ := spatial_fderiv_bound_on_cube U T t hU htT
  set L : ℝ := max L₀ 0 with hLdef

  have hineq : ∀ s ∈ Ioo 0 t,
      (∫ y in Icc (0 : Fin 3 → ℝ) 1, 2 * inner ℝ (g (WithLp.toLp 2 y) s) (deriv (fun r => g (WithLp.toLp 2 y) r) s))
        ≤ 2 * L * ∫ y in Icc (0 : Fin 3 → ℝ) 1, ‖g (WithLp.toLp 2 y) s‖ ^ 2 := by
    intro s hs
    have hs0 : 0 ≤ s := hs.1.le
    have hsT : s < T := lt_trans hs.2 htT
    have hV : ContDiff ℝ ∞ (fun y => v y s) := slice v (Ici 0) hv s hs0
    have hUb : ContDiff ℝ ∞ (fun y => U y s) := slice U (Iio T) hU s hsT
    have hPs : ContDiff ℝ ∞ (fun y => P y s) := slice P (Ici 0) hP s hs0
    have hPus : ContDiff ℝ ∞ (fun y => Pu y s) := slice Pu (Iio T) hPu s hsT
    have hW : ContDiff ℝ ∞ (fun y => v y s - U y s) := hV.sub hUb
    have hq : ContDiff ℝ ∞ (fun y => P y s - Pu y s) := hPs.sub hPus
    have hdivW : ∀ x, divergence (fun y => v y s - U y s) x = 0 := by
      intro x
      have e1 : divergence (fun y => v y s) x = 0 := hdivv x s hs0
      have e2 : divergence (fun y => U y s) x = 0 := hdivU x s hs0 hsT
      unfold divergence at e1 e2 ⊢
      rw [fderiv_fun_sub (hV.differentiable (by simp) x) (hUb.differentiable (by simp) x)]
      simp only [ContinuousLinearMap.coe_sub, map_sub, e1, e2, sub_zero]
    obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ℝ³ → ℝ³, Ψ = fun y => (‖v y s - U y s‖ ^ 2 / 2) • v y s
        + (P y s - Pu y s) • (v y s - U y s)
        - ν • ∑ j : Fin 3, (inner ℝ (fderiv ℝ (fun z => v z s - U z s) y (EuclideanSpace.single j 1))
            (v y s - U y s)) • EuclideanSpace.single j 1 := ⟨_, rfl⟩

    have flux : ∀ x, inner ℝ (v x s - U x s) (-(fderiv ℝ (fun y => v y s - U y s) x (v x s))
        + ν • Δ (fun y => v y s - U y s) x - gradient (fun y => P y s - Pu y s) x)
        = -divergence Ψ x - ν * ∑ j : Fin 3, ‖fderiv ℝ (fun y => v y s - U y s) x (EuclideanSpace.single j 1)‖ ^ 2
          + (‖v x s - U x s‖ ^ 2 / 2) * divergence (fun y => v y s) x
          + (P x s - Pu x s) * divergence (fun y => v y s - U y s) x := by
      intro x
      rw [hΨ]
      exact energy_flux_identity ν (fun y => v y s) (fun y => v y s - U y s) (fun y => P y s - Pu y s) x hV hW hq

    have hpt : ∀ x : ℝ³, ‖fderiv ℝ (fun z => U z s) x‖ ≤ L →
        2 * inner ℝ (v x s - U x s) (deriv (fun r => v x r - U x r) s)
          ≤ 2 * L * ‖v x s - U x s‖ ^ 2 - 2 * divergence Ψ x := by
      intro x hbx
      rw [ns_difference_equation ν T U v Pu P f hU hPu hv hP hres hNS x s hs.1 hsT]
      have e1 : -(fderiv ℝ (fun y => v y s - U y s) x (v x s)) - fderiv ℝ (fun y => U y s) x (v x s - U x s)
            + ν • Δ (fun y => v y s - U y s) x - gradient (fun y => P y s - Pu y s) x
          = (-(fderiv ℝ (fun y => v y s - U y s) x (v x s)) + ν • Δ (fun y => v y s - U y s) x
            - gradient (fun y => P y s - Pu y s) x) - fderiv ℝ (fun y => U y s) x (v x s - U x s) := by
        abel
      rw [e1, inner_sub_right, flux x, hdivv x s hs0, hdivW x]
      have hS : 0 ≤ ν * ∑ j : Fin 3, ‖fderiv ℝ (fun y => v y s - U y s) x (EuclideanSpace.single j 1)‖ ^ 2 :=
        mul_nonneg hν.le (Finset.sum_nonneg fun j _ => sq_nonneg _)
      have hC : ‖fderiv ℝ (fun y => U y s) x (v x s - U x s)‖ ≤ L * ‖v x s - U x s‖ :=
        ((fderiv ℝ (fun y => U y s) x).le_opNorm _).trans
          (mul_le_mul_of_nonneg_right hbx (norm_nonneg _))
      have hI : -(inner ℝ (v x s - U x s) (fderiv ℝ (fun y => U y s) x (v x s - U x s)))
          ≤ ‖v x s - U x s‖ * (L * ‖v x s - U x s‖) :=
        (neg_le_abs _).trans ((abs_real_inner_le_norm _ _).trans
          (mul_le_mul_of_nonneg_left hC (norm_nonneg _)))
      have hsq : ‖v x s - U x s‖ * (L * ‖v x s - U x s‖) = L * ‖v x s - U x s‖ ^ 2 := by ring
      linarith

    have hW1 : ContDiff ℝ 1 (fun y => v y s - U y s) := hW.of_le (by simp)
    have hD1 : ContDiff ℝ 1 (fderiv ℝ (fun y => v y s - U y s)) := hW.fderiv_right (by simp)
    have hΨC : ContDiff ℝ 1 Ψ := by
      have h3 : ContDiff ℝ 1 (fun y => ∑ j : Fin 3, (inner ℝ (fderiv ℝ (fun z => v z s - U z s) y
          (EuclideanSpace.single j 1)) (v y s - U y s)) • (EuclideanSpace.single j 1 : ℝ³)) := by
        apply ContDiff.sum
        intro j _
        exact ((hD1.clm_apply contDiff_const).inner ℝ hW1).smul contDiff_const
      rw [hΨ]
      exact ((((hW1.norm_sq ℝ).div_const 2).smul (hV.of_le (by simp))).add
        ((hq.of_le (by simp)).smul hW1)).sub (h3.const_smul ν)
    have hΨper : IsOnePeriodic Ψ := by
      intro x i
      have hv' : ∀ z, v (z + EuclideanSpace.single i 1) s = v z s := fun z => hvper s hs0 z i
      have hU' : ∀ z, U (z + EuclideanSpace.single i 1) s = U z s := fun z => hUper s hs0 hsT z i
      have hP' : ∀ z, P (z + EuclideanSpace.single i 1) s = P z s := fun z => hPper s hs0 z i
      have hPu' : ∀ z, Pu (z + EuclideanSpace.single i 1) s = Pu z s := fun z => hPuper s hs0 hsT z i
      have hD' : fderiv ℝ (fun z => v z s - U z s) (x + EuclideanSpace.single i 1)
          = fderiv ℝ (fun z => v z s - U z s) x := by
        rw [← fderiv_comp_add_right]
        congr 1
        funext z
        simp only [hv', hU']
      rw [hΨ]
      simp only [hv', hU', hP', hPu', hD']
    obtain ⟨hdivInt, hdivZero⟩ := periodic_divergence_integral_zero Ψ hΨC hΨper

    have hcont2 : Continuous (fun y : Fin 3 → ℝ => ‖g (WithLp.toLp 2 y) s‖ ^ 2) := by
      simp only [hgxr]
      exact (hW.continuous.comp (PiLp.continuous_toLp 2 _)).norm.pow 2
    have hInt2 : IntegrableOn (fun y : Fin 3 → ℝ => ‖g (WithLp.toLp 2 y) s‖ ^ 2) (Icc (0 : Fin 3 → ℝ) 1) :=
      hcont2.continuousOn.integrableOn_compact isCompact_Icc
    have hIntR : IntegrableOn (fun y : Fin 3 → ℝ => 2 * L * ‖g (WithLp.toLp 2 y) s‖ ^ 2
        - 2 * divergence Ψ (WithLp.toLp 2 y)) (Icc (0 : Fin 3 → ℝ) 1) :=
      (hInt2.const_mul (2 * L)).sub (hdivInt.const_mul 2)
    have hptQ : ∀ y ∈ Icc (0 : Fin 3 → ℝ) 1,
        2 * inner ℝ (g (WithLp.toLp 2 y) s) (deriv (fun r => g (WithLp.toLp 2 y) r) s)
          ≤ 2 * L * ‖g (WithLp.toLp 2 y) s‖ ^ 2 - 2 * divergence Ψ (WithLp.toLp 2 y) := by
      intro y hy
      simp only [hgxr]
      exact hpt _ ((hL₀ y hy s ⟨hs0, hs.2.le⟩).trans (le_max_left _ _))
    calc (∫ y in Icc (0 : Fin 3 → ℝ) 1, 2 * inner ℝ (g (WithLp.toLp 2 y) s) (deriv (fun r => g (WithLp.toLp 2 y) r) s))
        ≤ ∫ y in Icc (0 : Fin 3 → ℝ) 1, (2 * L * ‖g (WithLp.toLp 2 y) s‖ ^ 2
            - 2 * divergence Ψ (WithLp.toLp 2 y)) :=
          setIntegral_mono_on (hEder s hs).1 hIntR measurableSet_Icc hptQ
      _ = 2 * L * (∫ y in Icc (0 : Fin 3 → ℝ) 1, ‖g (WithLp.toLp 2 y) s‖ ^ 2)
            - 2 * ∫ y in Icc (0 : Fin 3 → ℝ) 1, divergence Ψ (WithLp.toLp 2 y) := by
          rw [integral_sub (hInt2.const_mul (2 * L)) (hdivInt.const_mul 2), integral_const_mul,
            integral_const_mul]
      _ = 2 * L * ∫ y in Icc (0 : Fin 3 → ℝ) 1, ‖g (WithLp.toLp 2 y) s‖ ^ 2 := by
          rw [hdivZero, mul_zero, sub_zero]

  have hE0 : (∫ y in Icc (0 : Fin 3 → ℝ) 1, ‖g (WithLp.toLp 2 y) 0‖ ^ 2) = 0 := by
    simp [hgxr, hinit]
  have hEnn : ∀ s ∈ Icc (0 : ℝ) t, 0 ≤ ∫ y in Icc (0 : Fin 3 → ℝ) 1, ‖g (WithLp.toLp 2 y) s‖ ^ 2 :=
    fun s _ => setIntegral_nonneg measurableSet_Icc (fun y _ => by positivity)
  have hEt : (∫ y in Icc (0 : Fin 3 → ℝ) 1, ‖g (WithLp.toLp 2 y) t‖ ^ 2) = 0 :=
    gronwall_zero (fun s => ∫ y in Icc (0 : Fin 3 → ℝ) 1, ‖g (WithLp.toLp 2 y) s‖ ^ 2)
      (fun s => ∫ y in Icc (0 : Fin 3 → ℝ) 1,
        2 * inner ℝ (g (WithLp.toLp 2 y) s) (deriv (fun r => g (WithLp.toLp 2 y) r) s))
      (2 * L) t hEcont (fun s hs => (hEder s hs).2) hineq hE0 hEnn t ⟨ht0, le_rfl⟩
  have hct : Continuous (fun y => g y t) := by
    simp only [hgxr]
    exact (slice v (Ici 0) hv t ht0).continuous.sub (slice U (Iio T) hU t htT).continuous
  have hpert : IsOnePeriodic (fun y => g y t) := by
    intro x i
    show g (x + EuclideanSpace.single i 1) t = g x t
    rw [hgxr, hgxr]
    have a1 : v (x + EuclideanSpace.single i 1) t = v x t := hvper t ht0 x i
    have a2 : U (x + EuclideanSpace.single i 1) t = U x t := hUper t ht0 htT x i
    rw [a1, a2]
  have hz : g x₀ t = 0 := periodic_zero_of_integral_sq_zero (fun y => g y t) hct hpert hEt x₀
  rw [hgxr] at hz
  exact sub_eq_zero.mp hz

theorem navier_stokes_breakdown (nu : ℝ) (hnu : nu > 0) :
    (∃ (u₀ : ℝ³ → ℝ³) (f : ℝ³ → ℝ → ℝ³),
      InitialVelocityConditionDecay u₀ ∧ ForceConditionDecay f ∧
      ¬ (∃ v p, NavierStokesExistenceAndSmoothnessRn nu u₀ f v p)) ∧
    (∃ (u₀ : ℝ³ → ℝ³) (f : ℝ³ → ℝ → ℝ³),
      InitialVelocityConditionPeriodic u₀ ∧ ForceConditionPeriodic f ∧
      ¬ (∃ v p, NavierStokesExistenceAndSmoothnessPeriodic nu u₀ f v p)) :=
by

  have hIC : InitialVelocityCondition (0 : ℝ³ → ℝ³) :=
    ⟨fun x => divergence_zero x, contDiff_const⟩
  have hdec : InitialVelocityConditionDecay (0 : ℝ³ → ℝ³) := by
    refine ⟨hIC, ?_⟩
    intro m K
    refine ⟨0, fun x => ?_⟩
    have : iteratedFDeriv ℝ m (0 : ℝ³ → ℝ³) x = 0 := by
      have h : iteratedFDeriv ℝ m (fun _ : ℝ³ => (0 : ℝ³)) = 0 := iteratedFDeriv_fun_zero
      exact congrFun h x
    rw [this, norm_zero, zero_div]
  have hper : InitialVelocityConditionPeriodic (0 : ℝ³ → ℝ³) := ⟨hIC, fun _ _ => rfl⟩

  obtain ⟨R₁, u₁, p₁, hR₁, hu₁, hp₁, hvan₁, hdiv₁, hunb₁, hGs, hGvan, hGc⟩ :=
    ns_blowup_flat_residual
  obtain ⟨F₁, hF₁s, hF₁eq, hF₁R, hF₁S⟩ :=
    smooth_extension_past_terminal_time 1 R₁ (nsResidual 1 u₁ p₁) hGs
      (fun x t ht hx => hGvan x t ht (Or.inl hx)) hGc
  have hpkg : BlowupPackage 1 1 R₁ u₁ p₁ F₁ := by
    refine ⟨one_pos, hR₁, hu₁, hp₁, hF₁s, fun x t ht hx => hvan₁ x t ht (Or.inl hx),
      fun x => (hvan₁ x 0 one_pos (Or.inr le_rfl)).1, ?_, hF₁S,
      fun x t ht => (hF₁eq x t ht).symm, hdiv₁, hunb₁⟩
    intro x t h
    rcases h with h | h
    · exact hF₁R x t h
    · have ht : t < 1 := lt_of_le_of_lt h one_pos
      rw [hF₁eq x t ht]
      exact hGvan x t ht (Or.inr h)

  have hC : ∃ (u₀ : ℝ³ → ℝ³) (f : ℝ³ → ℝ → ℝ³),
      InitialVelocityConditionDecay u₀ ∧ ForceConditionDecay f ∧
      ¬ (∃ v p, NavierStokesExistenceAndSmoothnessRn nu u₀ f v p) := by
    obtain ⟨T, u, p, f, hpk⟩ :=
      blowup_package_rescale 1 nu 1 R₁ u₁ p₁ F₁ one_pos hnu hpkg 1 one_pos
    obtain ⟨hT, _, hu, hp, hf, hvan, hinit, hfvan, ⟨S, hfS⟩, hres, hdiv, hunb⟩ := hpk
    refine ⟨0, f, hdec,
      force_decay_of_compact_support f 1 S hf (fun x t hx => hfvan x t (Or.inl hx)) hfS, ?_⟩
    rintro ⟨v, P, h⟩
    have heq := rn_weak_strong_uniqueness nu T 1 u v p P f hnu hT hu hp hvan
      (fun x t _ ht => hres x t ht) (fun x t _ ht => hdiv x t ht)
      h.velocity_smooth h.pressure_smooth h.navier_stokes h.div_free h.integrable
      h.globally_bounded_energy (fun x => by simp [h.initial_condition x, hinit x])
    have hK : IsCompact (Metric.closedBall (0 : ℝ³) 1 ×ˢ Icc (0 : ℝ) T) :=
      (isCompact_closedBall 0 1).prod isCompact_Icc
    have hsub : Metric.closedBall (0 : ℝ³) 1 ×ˢ Icc (0 : ℝ) T ⊆ univ ×ˢ Ici 0 :=
      fun z hz => ⟨mem_univ _, hz.2.1⟩
    obtain ⟨M, hM⟩ := hK.exists_bound_of_continuousOn (h.velocity_smooth.continuousOn.mono hsub)
    have hM0 : 0 ≤ M := le_trans (norm_nonneg _)
      (hM ((0 : ℝ³), (0 : ℝ)) ⟨Metric.mem_closedBall_self zero_le_one, le_rfl, hT.le⟩)
    obtain ⟨x, t, ht0, htT, hgt⟩ := hunb M
    by_cases hx : 1 ≤ ‖x‖
    · rw [(hvan x t htT hx).1, norm_zero] at hgt
      linarith
    · have hmem : (x, t) ∈ Metric.closedBall (0 : ℝ³) 1 ×ˢ Icc (0 : ℝ) T := by
        refine ⟨?_, ht0, htT.le⟩
        rw [Metric.mem_closedBall, dist_zero_right]
        linarith
      have hb : ‖v x t‖ ≤ M := hM (x, t) hmem
      rw [← heq x t ht0 htT] at hgt
      exact (not_le.mpr hgt) hb

  have hD : ∃ (u₀ : ℝ³ → ℝ³) (f : ℝ³ → ℝ → ℝ³),
      InitialVelocityConditionPeriodic u₀ ∧ ForceConditionPeriodic f ∧
      ¬ (∃ v p, NavierStokesExistenceAndSmoothnessPeriodic nu u₀ f v p) := by
    obtain ⟨T, u, p, f, hpk⟩ :=
      blowup_package_rescale 1 nu 1 R₁ u₁ p₁ F₁ one_pos hnu hpkg (1/4) (by norm_num)
    have hT : 0 < T := hpk.1
    obtain ⟨U, Pu, F, S, hU, hPu, hF, hUper, hPuper, hFper, hUinit, hres, hdiv, hFS, hFbd,
      hunb⟩ := periodize_blowup_package nu T u p f hpk
    refine ⟨0, F, hper, force_periodic_of_bounded_derivs F S hF hFper hFS hFbd, ?_⟩
    rintro ⟨v, P, h⟩
    have heq := torus_energy_uniqueness nu T U v Pu P F hnu hT hU hPu
      (fun t _ ht => hUper t ht) (fun t _ ht => hPuper t ht)
      (fun x t _ ht => hres x t ht) (fun x t _ ht => hdiv x t ht)
      h.velocity_smooth h.pressure_smooth h.isOnePeriodic_velocity h.isOnePeriodic_pressure
      h.navier_stokes h.div_free (fun x => by simp [h.initial_condition x, hUinit x])
    have hK : IsCompact (Metric.closedBall (0 : ℝ³) (1/4) ×ˢ Icc (0 : ℝ) T) :=
      (isCompact_closedBall 0 (1/4)).prod isCompact_Icc
    have hsub : Metric.closedBall (0 : ℝ³) (1/4) ×ˢ Icc (0 : ℝ) T ⊆ univ ×ˢ Ici 0 :=
      fun z hz => ⟨mem_univ _, hz.2.1⟩
    obtain ⟨M, hM⟩ := hK.exists_bound_of_continuousOn (h.velocity_smooth.continuousOn.mono hsub)
    obtain ⟨x, t, ht0, htT, hx, hgt⟩ := hunb M
    have hmem : (x, t) ∈ Metric.closedBall (0 : ℝ³) (1/4) ×ˢ Icc (0 : ℝ) T := by
      refine ⟨?_, ht0, htT.le⟩
      rw [Metric.mem_closedBall, dist_zero_right]
      exact hx
    have hb : ‖v x t‖ ≤ M := hM (x, t) hmem
    rw [← heq x t ht0 htT] at hgt
    exact (not_le.mpr hgt) hb
  exact ⟨hC, hD⟩

