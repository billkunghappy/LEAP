          yAvg (fun η => fderiv ℝ f η ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) ξ := rfl
      have rhs : dR B.h (yAvg f) ξ =
          fderiv ℝ (yAvg f) ξ ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) := rfl
      rw [lhs, rhs, hsplit, LIN _ _ 1 _ (hfg.clm_apply continuousOn_const) (hfg.clm_apply continuousOn_const)
