    have hφ : Continuous (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ξ hξ
      have h' : ξ.2.2.1 < 1 := hξ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩
    have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)))
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := h4'.comp hφ.continuousOn hmaps
    have hcont : ContinuousOn (qC B.h) ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) := hc
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qs))
    have e : DomC B.h qs =
        ({ξ : Cyl | 0 < ξ.1} ∩ {ξ : Cyl | ξ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio qs := by
      ext ξ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  set q := simScale B.h z (1 - t) with hqdef
  have hq0 : 0 < q := (hok.1.1 z (1 - t) (by linarith)).1
  set ρ := Real.sqrt q with hρdef
  have hρ : 0 < ρ := Real.sqrt_pos.mpr hq0
  have hρsq : ρ ^ 2 = q := Real.sq_sqrt hq0.le
  have hs1 : 0 < Real.sqrt (2 * B.Xa) := Real.sqrt_pos.mpr (by linarith)
  have hs2 : 0 < Real.sqrt (2 * B.Xb) := Real.sqrt_pos.mpr (by linarith)

  have hmem : ∀ (s : ℝ) (Y : ℝ × ℝ), 0 < s → ((ρ * s, z, t, Y) : Cyl) ∈ DomC B.h qs := by
    intro s Y hs
    exact ⟨mul_pos hρ hs, ht, hq⟩

  have hXC : ∀ (s : ℝ) (Y : ℝ × ℝ), XC B.h ((ρ * s, z, t, Y) : Cyl) = s ^ 2 / 2 := by
    intro s Y
    show (ρ * s) ^ 2 / (2 * q) = s ^ 2 / 2
    rw [mul_pow, hρsq, div_eq_div_iff (mul_pos two_pos hq0).ne' two_ne_zero]
    ring

  have hFz : ∀ (s : ℝ) (Y : ℝ × ℝ), (s ≤ Real.sqrt (2 * B.Xa) ∨ Real.sqrt (2 * B.Xb) ≤ s) →
      F (s, Y) = 0 := by
    intro s Y hsY
    rw [hF]
    dsimp only
    by_cases hs : 0 < s
    · rw [if_pos hs]
      have hz : iteratedFDeriv ℝ k f ((ρ * s, z, t, Y) : Cyl) = 0 := by
        apply hZ _ (hmem s Y hs)
        rw [hXC]
        rcases hsY with h1 | h1
        · left
          have h2 : s ^ 2 ≤ Real.sqrt (2 * B.Xa) ^ 2 := pow_le_pow_left₀ hs.le h1 2
          rw [Real.sq_sqrt (by linarith)] at h2
          linarith
        · right
          have h2 : Real.sqrt (2 * B.Xb) ^ 2 ≤ s ^ 2 := pow_le_pow_left₀ hs2.le h1 2
          rw [Real.sq_sqrt (by linarith)] at h2
          linarith
      rw [hz]
      simp
    · rw [if_neg hs]

  set G : ℝ × (ℝ × ℝ) → ℝ := fun x => iteratedFDeriv ℝ k f ((ρ * x.1, z, t, x.2) : Cyl) v with hGdef
  have hU0 : IsOpen {x : ℝ × (ℝ × ℝ) | x.1 < Real.sqrt (2 * B.Xa)} :=
    isOpen_lt continuous_fst continuous_const
  have hUp : IsOpen {x : ℝ × (ℝ × ℝ) | 0 < x.1} := isOpen_lt continuous_const continuous_fst
  have hev0 : ∀ x : ℝ × (ℝ × ℝ), x.1 < Real.sqrt (2 * B.Xa) → F =ᶠ[nhds x] fun _ => (0:ℝ) := by
    intro x hx
    refine Filter.eventuallyEq_of_mem (hU0.mem_nhds hx) (fun y hy => ?_)
    show F y = 0
    exact hFz y.1 y.2 (Or.inl (le_of_lt hy))
  have hevp : ∀ x : ℝ × (ℝ × ℝ), 0 < x.1 → F =ᶠ[nhds x] G := by
    intro x hx
    refine Filter.eventuallyEq_of_mem (hUp.mem_nhds hx) (fun y hy => ?_)
    exact (hF y).trans (if_pos (show 0 < y.1 from hy))

  have hGsm : ∀ x : ℝ × (ℝ × ℝ), 0 < x.1 → ContDiffAt ℝ ∞ G x := by
    intro x hx
    have hLx := hmem x.1 x.2 hx
    have hfx : ContDiffAt ℝ ∞ f ((ρ * x.1, z, t, x.2) : Cyl) :=
      hf.1.contDiffAt (hDopen.mem_nhds hLx)
    have hDk : ContDiffAt ℝ ∞ (iteratedFDeriv ℝ k f) ((ρ * x.1, z, t, x.2) : Cyl) :=
      hfx.iteratedFDeriv_right (by simp)
    have hL : ContDiff ℝ ∞ (fun x : ℝ × (ℝ × ℝ) => ((ρ * x.1, z, t, x.2) : Cyl)) := by fun_prop
    have hcomp : ContDiffAt ℝ ∞
        (fun x : ℝ × (ℝ × ℝ) => iteratedFDeriv ℝ k f ((ρ * x.1, z, t, x.2) : Cyl)) x :=
      hDk.comp x hL.contDiffAt
    exact ((ContinuousMultilinearMap.apply ℝ (fun _ : Fin k => Cyl) ℝ v).contDiff.contDiffAt).comp
      x hcomp
  have hFsm : ContDiff ℝ ∞ F := by
    rw [contDiff_iff_contDiffAt]
    intro x
    by_cases hx : 0 < x.1
    · exact (hGsm x hx).congr_of_eventuallyEq (hevp x hx)
    · exact contDiffAt_const.congr_of_eventuallyEq (hev0 x (by push_neg at hx; linarith))

  have hper : ∀ (s : ℝ) (Y c : ℝ × ℝ), (∃ i j : ℤ, Jpow (coarseIdx B.h q) c = ((i:ℝ), (j:ℝ))) →
      F (s, Y + c) = F (s, Y) := by
    intro s Y c hc
    rw [hF, hF]
    dsimp only
    by_cases hs : 0 < s
    · rw [if_pos hs, if_pos hs]
      have h1 := hdeck ((ρ * s, z, t, Y) : Cyl) (hmem s Y hs) c hc
      exact congrArg (fun T => T v) h1
    · rw [if_neg hs, if_neg hs]

  have hRHS : 0 ≤ C * q ^ (B.h * α - 2 * (k:ℝ)) * (1 + |Real.log q|) ^ b * ∏ i, ‖v i‖ := by
    apply mul_nonneg (mul_nonneg (mul_nonneg hC0 (Real.rpow_nonneg hq0.le _))
      (Real.rpow_nonneg (by positivity) _))
    exact Finset.prod_nonneg (fun i _ => norm_nonneg _)
  refine ⟨hFsm, hper, hFz, ?_⟩
  intro j hj s Y
  by_cases hs : 0 < s
  · rw [((hevp (s, Y) hs).iteratedFDeriv ℝ j).eq_of_nhds]
    exact hCb z t v ht hq j hj s Y hs
  · have hx : (s, Y).1 < Real.sqrt (2 * B.Xa) := by
      show s < _
      push_neg at hs
      linarith
    rw [((hev0 (s, Y) hx).iteratedFDeriv ℝ j).eq_of_nhds, iteratedFDeriv_fun_zero]
    refine le_trans (le_of_eq ?_) hRHS
    rw [norm_eq_zero]
    ext m
    simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]

theorem path_functional_flat_v5 : ∀ (B : BG) (l0 : ℕ) (g : Cyl → ℝ) (α : ℝ), B.ok → 10 ≤ l0 → InM B (qsOf l0) α (nrm B (2 * Aex B.h + 1/2) g) → ContDiffOn ℝ ∞ (fun ζ : ℝ × ℝ × (ℝ × ℝ) => (∫ r in Set.Ioi (0:ℝ), g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv)) - radMom g 0 ζ.1 ζ.2.1) {ζ | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qsOf l0} ∧ ∀ k N : ℕ, ∃ C : ℝ, ∀ ζ : ℝ × ℝ × (ℝ × ℝ), ζ.2.1 < 1 → simScale B.h ζ.1 (1 - ζ.2.1) < qsOf l0 → ‖iteratedFDeriv ℝ k (fun ζ' : ℝ × ℝ × (ℝ × ℝ) => (∫ r in Set.Ioi (0:ℝ), g (r, ζ'.1, ζ'.2.1, ζ'.2.2 + (r ^ drx B.h) • vrv)) - radMom g 0 ζ'.1 ζ'.2.1) ζ‖ ≤ C * simScale B.h ζ.1 (1 - ζ.2.1) ^ (N : ℝ) :=
by
  intro B l0 g α hok hl0 hg
  obtain ⟨hh0, hh1, hXa, hXm1, hm12, hm2Xb, -⟩ := hok.2.1
  have hS : SimScaleProps B.h := hok.1
  have hqs0 : 0 < qsOf l0 := by
    show (0:ℝ) < (2:ℝ) ^ (-(l0:ℝ))
    positivity
  have hqs10 : qsOf l0 ≤ (2:ℝ) ^ (-(10:ℝ)) := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ (2:ℝ) ^ (-(10:ℝ))
    apply Real.rpow_le_rpow_of_exponent_le (by norm_num)
    have : (10:ℝ) ≤ l0 := by exact_mod_cast hl0
    linarith
  have hqs1 : qsOf l0 ≤ 1 :=
    le_trans hqs10 (Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by norm_num))

  have t10 : ∀ a m : ℝ, 0 < a → 0 ≤ m → ∀ q : ℝ, 0 < q → q ≤ 1 →
      q ^ a * (1 + |Real.log q|) ^ m ≤ (1 + (m + 1) / a) ^ m := by
    intro a m ha hm q hq0 hq1
    have hlog : Real.log q ≤ 0 := Real.log_nonpos hq0.le hq1
    obtain ⟨x, hx⟩ : ∃ x : ℝ, x = -Real.log q := ⟨_, rfl⟩
    have hx0 : 0 ≤ x := by rw [hx]; linarith
    have habs : |Real.log q| = x := by rw [abs_of_nonpos hlog, hx]
    obtain ⟨c, hc⟩ : ∃ c : ℝ, c = a / (m + 1) := ⟨_, rfl⟩
    have hc0 : 0 < c := by rw [hc]; positivity
    have e2 : (m + 1) / a = 1 / c := by rw [hc]; field_simp
    have h1 : 1 + x ≤ (1 + (m + 1) / a) * Real.exp (c * x) := by
      rw [e2]
      have e1 := Real.add_one_le_exp (c * x)
      have hcx : 0 ≤ c * x := mul_nonneg hc0.le hx0
      have hic : 0 ≤ 1 / c := by positivity
      have e3 : (1 + 1 / c) * (c * x + 1) = 1 + x + c * x + 1 / c := by field_simp; ring
      calc 1 + x ≤ (1 + 1 / c) * (c * x + 1) := by rw [e3]; linarith
        _ ≤ (1 + 1 / c) * Real.exp (c * x) := mul_le_mul_of_nonneg_left e1 (by positivity)
    have hK : 0 ≤ 1 + (m + 1) / a := by positivity
    have hcm : c * m ≤ a := by
      rw [hc, div_mul_eq_mul_div, div_le_iff₀ (by linarith)]
      nlinarith
    have h2 : (1 + x) ^ m ≤ (1 + (m + 1) / a) ^ m * Real.exp (a * x) := by
      calc (1 + x) ^ m ≤ ((1 + (m + 1) / a) * Real.exp (c * x)) ^ m :=
            Real.rpow_le_rpow (by linarith) h1 hm
        _ = (1 + (m + 1) / a) ^ m * Real.exp (c * x * m) := by
            rw [Real.mul_rpow hK (Real.exp_pos _).le, Real.exp_mul (c * x) m]
        _ ≤ (1 + (m + 1) / a) ^ m * Real.exp (a * x) := by
            apply mul_le_mul_of_nonneg_left _ (Real.rpow_nonneg hK _)
            apply Real.exp_le_exp.mpr
            nlinarith [mul_le_mul_of_nonneg_right hcm hx0]
    have h3 : q ^ a = Real.exp (-(a * x)) := by
      rw [Real.rpow_def_of_pos hq0, hx]
      congr 1
      ring
    rw [habs, h3]
    calc Real.exp (-(a * x)) * (1 + x) ^ m
        ≤ Real.exp (-(a * x)) * ((1 + (m + 1) / a) ^ m * Real.exp (a * x)) :=
          mul_le_mul_of_nonneg_left h2 (Real.exp_pos _).le
      _ = (1 + (m + 1) / a) ^ m := by
          rw [mul_left_comm, ← Real.exp_add, neg_add_cancel, Real.exp_zero, mul_one]

  have hdeck := (deck_deriv_invariant_v5 B (qsOf l0) α _ hok hqs0 hqs10 hg).1
  have hper : ∀ ξ ∈ DomC B.h (qsOf l0), ∀ i j : ℤ,
      nrm B (2 * Aex B.h + 1/2) g (shY ξ ((i:ℝ), (j:ℝ))) = nrm B (2 * Aex B.h + 1/2) g ξ :=
    fun ξ hξ i j => hg.2.1 ξ hξ _ (hdeck ξ hξ i j)
  have h4 := path_functional_deriv_formula_v5 B (qsOf l0) _ hok hqs0 hqs1 hg.1 hg.2.2.1 hper

  have hflatN : ∀ k Nn : ℕ, ∃ C : ℝ, ∀ ζ : ℝ × ℝ × (ℝ × ℝ), ζ.2.1 < 1 →
      simScale B.h ζ.1 (1 - ζ.2.1) < qsOf l0 →
      ‖iteratedFDeriv ℝ k (fun ζ' : ℝ × ℝ × (ℝ × ℝ) =>
          (∫ r in Set.Ioi (0:ℝ), nrm B (2 * Aex B.h + 1/2) g (r, ζ'.1, ζ'.2.1, ζ'.2.2 + (r ^ drx B.h) • vrv))
            - radMom (nrm B (2 * Aex B.h + 1/2) g) 0 ζ'.1 ζ'.2.1) ζ‖
        ≤ C * simScale B.h ζ.1 (1 - ζ.2.1) ^ (Nn : ℝ) := by
    intro k Nn
    have hd := coarseIdx_arith_v5 B.h hh0 hh1
    have hκ0 : 0 < B.h * kapS := mul_pos hh0 (by norm_num [kapS])
    have hT : 0 < Tgc := by unfold Tgc; positivity
    have h64' : (0:ℝ) ≤ 64 * Tgc := by linarith
    have hLgc : 0 < Lgc := by
      unfold Lgc
      nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
    obtain ⟨p, hpdef⟩ : ∃ p : ℕ, p = ⌈((Nn:ℝ) + 2 * k + |B.h * α| + 1) / (B.h * kapS)⌉₊ := ⟨_, rfl⟩
    have hp : (Nn:ℝ) + 2 * k + |B.h * α| + 1 ≤ B.h * kapS * p := by
      have h1 := Nat.le_ceil (((Nn:ℝ) + 2 * k + |B.h * α| + 1) / (B.h * kapS))
      rw [← hpdef, div_le_iff₀ hκ0] at h1
      linarith [mul_comm (p:ℝ) (B.h * kapS)]
    have hs1 : 0 < Real.sqrt (2 * B.Xa) := Real.sqrt_pos.mpr (by linarith)
    have hs12 : Real.sqrt (2 * B.Xa) < Real.sqrt (2 * B.Xb) :=
      Real.sqrt_lt_sqrt (by linarith) (by linarith)
    obtain ⟨Cp, hCp⟩ := torus_path_oscillation_v5 (drx B.h) (Real.sqrt (2 * B.Xa)) (Real.sqrt (2 * B.Xb))
      hd.1.1 hd.1.2 hs1 hs12 p
    obtain ⟨C8, b, hC80, hC8⟩ := slice_s3_hypotheses_v5 B (qsOf l0) α _ hok hqs0 hqs10 hg k (3 * p + 6)
    obtain ⟨a, hadef⟩ : ∃ a : ℝ, a = B.h * α - 2 * k + B.h * kapS * p - Nn := ⟨_, rfl⟩
    have ha1 : 1 ≤ a := by rw [hadef]; linarith [neg_abs_le (B.h * α)]
    have ha0 : 0 < a := by linarith
    obtain ⟨m, hmdef⟩ : ∃ m : ℝ, m = max b 0 + 2 * (p:ℝ) := ⟨_, rfl⟩
    have hm0 : 0 ≤ m := by
      rw [hmdef]
      have := le_max_right b 0
      have := (Nat.cast_nonneg p : (0:ℝ) ≤ p)
      linarith
    have hC10 : 0 ≤ (1 + (m + 1) / a) ^ m := Real.rpow_nonneg (by positivity) _
    have h64 : 0 ≤ (64 * Tgc) ^ (p:ℝ) := Real.rpow_nonneg h64' _
    refine ⟨|Cp| * C8 * (64 * Tgc) ^ (p:ℝ) * (1 + (m + 1) / a) ^ m, fun ζ ht hq => ?_⟩
    have hq0 : 0 < simScale B.h ζ.1 (1 - ζ.2.1) := (hS.1 _ _ (by linarith)).1
    have hq1 : simScale B.h ζ.1 (1 - ζ.2.1) ≤ 1 := le_trans hq.le hqs1
    have hq10 : simScale B.h ζ.1 (1 - ζ.2.1) < (2:ℝ) ^ (-(10:ℝ)) := lt_of_lt_of_le hq hqs10
    have h6all := hd.2 _ hq0 hq10
    obtain ⟨n, hnc⟩ : ∃ n : ℕ, (n:ℤ) = coarseIdx B.h (simScale B.h ζ.1 (1 - ζ.2.1)) :=
      ⟨_, Int.toNat_of_nonneg h6all.1⟩
    refine ContinuousMultilinearMap.opNorm_le_bound
      (mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (abs_nonneg _) hC80) h64) hC10)
        (Real.rpow_nonneg hq0.le _)) (fun v => ?_)
    rw [h4.2 k ζ ht hq v]
    set q := simScale B.h ζ.1 (1 - ζ.2.1) with hqdef
    set L := 1 + |Real.log q| with hLdef
    have hL1 : 1 ≤ L := by rw [hLdef]; linarith [abs_nonneg (Real.log q)]
    have hL0 : 0 < L := by linarith
    set ρ := Real.sqrt q with hρdef
    have hρ : 0 < ρ := Real.sqrt_pos.mpr hq0
    have hρ1 : ρ ≤ 1 := Real.sqrt_le_one.mpr hq1
    set vh : Fin k → Cyl := fun i => ((0:ℝ), (v i).1, (v i).2.1, (v i).2.2) with hvh
    have hP : ∏ i, ‖vh i‖ = ∏ i, ‖v i‖ := Finset.prod_congr rfl (fun i _ => by
      show ‖((0:ℝ), (v i).1, (v i).2.1, (v i).2.2)‖ = ‖v i‖
      rw [Prod.norm_def, norm_zero, max_eq_right (norm_nonneg _)])
    set F : ℝ × (ℝ × ℝ) → ℝ := fun x => if 0 < x.1 then
      iteratedFDeriv ℝ k (nrm B (2 * Aex B.h + 1/2) g) (ρ * x.1, ζ.1, ζ.2.1, x.2) vh else 0 with hFdef
    obtain ⟨hFs, hFper, hFsupp, hFbd⟩ := hC8 ζ.1 ζ.2.1 vh F ht hq (fun x => rfl)
    set M := C8 * q ^ (B.h * α - 2 * (k:ℝ)) * L ^ b * ∏ i, ‖vh i‖ with hMdef
    have hM0 : 0 ≤ M := mul_nonneg (mul_nonneg (mul_nonneg hC80 (Real.rpow_nonneg hq0.le _))
      (Real.rpow_nonneg hL0.le _)) (Finset.prod_nonneg fun i _ => norm_nonneg _)
    set A : ℝ → ℝ := fun r => iteratedFDeriv ℝ k (nrm B (2 * Aex B.h + 1/2) g)
        (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv) vh -
      ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
        iteratedFDeriv ℝ k (nrm B (2 * Aex B.h + 1/2) g) (r, ζ.1, ζ.2.1, Y) vh with hAdef
    change ‖∫ r in Set.Ioi (0:ℝ), A r‖ ≤ _
    have hAs : ∀ s : ℝ, 0 < s → A (ρ * s) = F (s, ζ.2.2 + (ρ ^ drx B.h * s ^ drx B.h) • vrv) -
        ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, F (s, Y) := by
      intro s hs
      simp only [hAdef, hFdef, if_pos hs, Real.mul_rpow hρ.le hs.le]

    have hres1 : ∫ r in Set.Ioi (0:ℝ), A r = ρ * ∫ x in Set.Ioi (0:ℝ), A (ρ * x) := by
      rw [integral_comp_mul_left_Ioi A 0 hρ, mul_zero, smul_eq_mul, ← mul_assoc,
        mul_inv_cancel₀ hρ.ne', one_mul]
    have hres2 : ∫ x in Set.Ioi (0:ℝ), A (ρ * x) =
        ∫ x in Set.Ioc (Real.sqrt (2 * B.Xa)) (Real.sqrt (2 * B.Xb)), A (ρ * x) := by
      refine setIntegral_eq_of_subset_of_forall_diff_eq_zero measurableSet_Ioi
        (fun x hx => lt_trans hs1 hx.1) (fun x hx => ?_)
      have hx0 : (0:ℝ) < x := hx.1
      have hx2 : x ≤ Real.sqrt (2 * B.Xa) ∨ Real.sqrt (2 * B.Xb) ≤ x := by
        by_contra hc
        push_neg at hc
        exact hx.2 ⟨hc.1, hc.2.le⟩
      have h0 : ∀ Y, F (x, Y) = 0 := fun Y => hFsupp x Y hx2
      rw [hAs x hx0]
      simp [h0]
    have hres4 : ∫ x in (Real.sqrt (2 * B.Xa))..(Real.sqrt (2 * B.Xb)), A (ρ * x) =
        ∫ s in (Real.sqrt (2 * B.Xa))..(Real.sqrt (2 * B.Xb)),
          (F (s, ζ.2.2 + (ρ ^ drx B.h * s ^ drx B.h) • vrv) -
            ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, F (s, Y)) := by
      refine intervalIntegral.integral_congr (fun x hx => hAs x ?_)
      rw [uIcc_of_le hs12.le] at hx
      exact lt_of_lt_of_le hs1 hx.1
    rw [hres1, hres2, ← intervalIntegral.integral_of_le hs12.le, hres4, Real.norm_eq_abs, abs_mul,
      abs_of_pos hρ]

    have hI := hCp n ρ M F ζ.2.2 hρ hFs
      (fun s Y c hc => hFper s Y c (by rw [hnc] at hc; exact hc)) hFsupp
      (fun j hj s Y => by rw [hnc]; exact hFbd j hj s Y)

    have h6 := h6all.2.2.1
    rw [← hnc, zpow_natCast] at h6
    have hρd : ρ ^ drx B.h = q ^ (drx B.h / 2) := by
      show Real.sqrt q ^ drx B.h = _
      rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hq0.le]
      congr 1
      ring
    rw [← hρd] at h6
    have hX0 : 0 ≤ Lgc ^ n * ρ ^ drx B.h := mul_nonneg (pow_nonneg hLgc.le _) (Real.rpow_nonneg hρ.le _)
    have hQ0 : 0 < 64 * Tgc * q ^ (B.h * kapS) * L ^ (2:ℝ) :=
      mul_pos (mul_pos (by linarith) (Real.rpow_pos_of_pos hq0 _)) (Real.rpow_pos_of_pos hL0 _)
    have hQinv : (64 * Tgc * q ^ (B.h * kapS) * L ^ (2:ℝ))⁻¹ =
        (64 * Tgc)⁻¹ * q ^ (-(B.h * kapS)) * L ^ (-(2:ℝ)) := by
      rw [Real.rpow_neg hq0.le, Real.rpow_neg hL0.le]
      simp only [mul_inv]
    have hXQ : (64 * Tgc * q ^ (B.h * kapS) * L ^ (2:ℝ))⁻¹ ≤ Lgc ^ n * ρ ^ drx B.h := by
      rw [hQinv]; exact h6
    have hqk0 : 0 ≤ q ^ (B.h * kapS) := Real.rpow_nonneg hq0.le _
    have hXp : (Lgc ^ n * ρ ^ drx B.h) ^ (-(p:ℝ)) ≤
        (64 * Tgc) ^ (p:ℝ) * q ^ (B.h * kapS * p) * L ^ (2 * (p:ℝ)) := by
      calc (Lgc ^ n * ρ ^ drx B.h) ^ (-(p:ℝ))
          ≤ ((64 * Tgc * q ^ (B.h * kapS) * L ^ (2:ℝ))⁻¹) ^ (-(p:ℝ)) :=
            Real.rpow_le_rpow_of_nonpos (inv_pos.mpr hQ0) hXQ (neg_nonpos.mpr (Nat.cast_nonneg p))
        _ = (64 * Tgc * q ^ (B.h * kapS) * L ^ (2:ℝ)) ^ (p:ℝ) := by
            rw [Real.rpow_neg (inv_nonneg.mpr hQ0.le), Real.inv_rpow hQ0.le, inv_inv]
        _ = (64 * Tgc) ^ (p:ℝ) * q ^ (B.h * kapS * p) * L ^ (2 * (p:ℝ)) := by
            rw [Real.mul_rpow (mul_nonneg h64' hqk0) (Real.rpow_nonneg hL0.le (2:ℝ)),
              Real.mul_rpow h64' hqk0, ← Real.rpow_mul hq0.le, ← Real.rpow_mul hL0.le]
    have hLb : L ^ b * L ^ (2 * (p:ℝ)) ≤ L ^ m := by
      rw [hmdef, Real.rpow_add hL0]
      exact mul_le_mul_of_nonneg_right (Real.rpow_le_rpow_of_exponent_le hL1 (le_max_left _ _))
        (Real.rpow_nonneg hL0.le _)
    have key : q ^ (B.h * α - 2 * (k:ℝ)) * q ^ (B.h * kapS * p) = q ^ (Nn:ℝ) * q ^ a := by
      rw [← Real.rpow_add hq0, ← Real.rpow_add hq0, hadef]
      congr 1
      ring
    have h10 : q ^ a * L ^ m ≤ (1 + (m + 1) / a) ^ m := t10 a m ha0 hm0 q hq0 hq1
    have hK0 : 0 ≤ |Cp| * C8 * (64 * Tgc) ^ (p:ℝ) * ∏ i, ‖vh i‖ :=
      mul_nonneg (mul_nonneg (mul_nonneg (abs_nonneg _) hC80) h64)
        (Finset.prod_nonneg fun i _ => norm_nonneg _)
    calc ρ * |∫ s in (Real.sqrt (2 * B.Xa))..(Real.sqrt (2 * B.Xb)),
          (F (s, ζ.2.2 + (ρ ^ drx B.h * s ^ drx B.h) • vrv) -
            ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, F (s, Y))|
        ≤ |∫ s in (Real.sqrt (2 * B.Xa))..(Real.sqrt (2 * B.Xb)),
          (F (s, ζ.2.2 + (ρ ^ drx B.h * s ^ drx B.h) • vrv) -
            ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1, F (s, Y))| :=
          mul_le_of_le_one_left (abs_nonneg _) hρ1
      _ ≤ |Cp| * M * (Lgc ^ n * ρ ^ drx B.h) ^ (-(p:ℝ)) :=
          le_trans hI (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (le_abs_self _) hM0)
            (Real.rpow_nonneg hX0 _))
      _ ≤ |Cp| * M * ((64 * Tgc) ^ (p:ℝ) * q ^ (B.h * kapS * p) * L ^ (2 * (p:ℝ))) :=
          mul_le_mul_of_nonneg_left hXp (mul_nonneg (abs_nonneg _) hM0)
      _ = (|Cp| * C8 * (64 * Tgc) ^ (p:ℝ) * ∏ i, ‖vh i‖) *
            (q ^ (B.h * α - 2 * (k:ℝ)) * q ^ (B.h * kapS * p)) * (L ^ b * L ^ (2 * (p:ℝ))) := by
          rw [hMdef]; ring
      _ ≤ (|Cp| * C8 * (64 * Tgc) ^ (p:ℝ) * ∏ i, ‖vh i‖) *
            (q ^ (B.h * α - 2 * (k:ℝ)) * q ^ (B.h * kapS * p)) * L ^ m :=
          mul_le_mul_of_nonneg_left hLb (mul_nonneg hK0
            (mul_nonneg (Real.rpow_nonneg hq0.le _) (Real.rpow_nonneg hq0.le _)))
      _ = (|Cp| * C8 * (64 * Tgc) ^ (p:ℝ) * ∏ i, ‖vh i‖) * q ^ (Nn:ℝ) * (q ^ a * L ^ m) := by
          rw [key]; ring
      _ ≤ (|Cp| * C8 * (64 * Tgc) ^ (p:ℝ) * ∏ i, ‖vh i‖) * q ^ (Nn:ℝ) * (1 + (m + 1) / a) ^ m :=
          mul_le_mul_of_nonneg_left h10 (mul_nonneg hK0 (Real.rpow_nonneg hq0.le _))
      _ = |Cp| * C8 * (64 * Tgc) ^ (p:ℝ) * (1 + (m + 1) / a) ^ m * q ^ (Nn:ℝ) * ∏ i, ‖v i‖ := by
          rw [hP]; ring
  have ht1 := simWeight_mul_flat_v5 B.h (qsOf l0) (2 * Aex B.h + 1/2) _ hS hqs0 hqs1 h4.1 hflatN

  have ha1 : ∀ ζ : ℝ × ℝ × (ℝ × ℝ), ζ.2.1 < 1 →
      (∫ r in Set.Ioi (0:ℝ), g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv)) - radMom g 0 ζ.1 ζ.2.1 =
        simScale B.h ζ.1 (1 - ζ.2.1) ^ (-(2 * Aex B.h + 1/2)) *
          ((∫ r in Set.Ioi (0:ℝ), nrm B (2 * Aex B.h + 1/2) g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv))
            - radMom (nrm B (2 * Aex B.h + 1/2) g) 0 ζ.1 ζ.2.1) := by
    intro ζ ht
    have hq : 0 < simScale B.h ζ.1 (1 - ζ.2.1) := (hS.1 _ _ (by linarith)).1
    have hpt : ∀ (r : ℝ) (Y : ℝ × ℝ), g (r, ζ.1, ζ.2.1, Y) =
        simScale B.h ζ.1 (1 - ζ.2.1) ^ (-(2 * Aex B.h + 1/2)) *
          nrm B (2 * Aex B.h + 1/2) g (r, ζ.1, ζ.2.1, Y) := by
      intro r Y
      show _ = _ * (simScale B.h ζ.1 (1 - ζ.2.1) ^ (2 * Aex B.h + 1/2) * g (r, ζ.1, ζ.2.1, Y))
      rw [← mul_assoc, ← Real.rpow_add hq, neg_add_cancel, Real.rpow_zero, one_mul]
    have h1 : (∫ r in Set.Ioi (0:ℝ), g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv)) =
        simScale B.h ζ.1 (1 - ζ.2.1) ^ (-(2 * Aex B.h + 1/2)) *
          ∫ r in Set.Ioi (0:ℝ), nrm B (2 * Aex B.h + 1/2) g (r, ζ.1, ζ.2.1, ζ.2.2 + (r ^ drx B.h) • vrv) := by
      rw [← integral_const_mul]
      congr 1
      funext r
      exact hpt _ _
    have h2 : radMom g 0 ζ.1 ζ.2.1 = simScale B.h ζ.1 (1 - ζ.2.1) ^ (-(2 * Aex B.h + 1/2)) *
        radMom (nrm B (2 * Aex B.h + 1/2) g) 0 ζ.1 ζ.2.1 := by
      unfold radMom yAvg
      rw [← integral_const_mul]
      congr 1
      funext r
      rw [mul_left_comm]
      congr 1
      rw [← integral_const_mul]
      congr 1
      funext Y
      exact hpt _ _
    rw [h1, h2, mul_sub]
  have hU : IsOpen {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1} := isOpen_lt (by fun_prop) continuous_const
  refine ⟨ht1.1.congr (fun ζ hζ => ha1 ζ hζ.1), fun k Nn => ?_⟩
  obtain ⟨C, hC⟩ := ht1.2 k Nn
  refine ⟨C, fun ζ ht hq => ?_⟩
  have hev : (fun ζ' : ℝ × ℝ × (ℝ × ℝ) =>
      (∫ r in Set.Ioi (0:ℝ), g (r, ζ'.1, ζ'.2.1, ζ'.2.2 + (r ^ drx B.h) • vrv)) - radMom g 0 ζ'.1 ζ'.2.1)
      =ᶠ[nhds ζ] (fun ζ' : ℝ × ℝ × (ℝ × ℝ) => simScale B.h ζ'.1 (1 - ζ'.2.1) ^ (-(2 * Aex B.h + 1/2)) *
          ((∫ r in Set.Ioi (0:ℝ), nrm B (2 * Aex B.h + 1/2) g (r, ζ'.1, ζ'.2.1, ζ'.2.2 + (r ^ drx B.h) • vrv))
            - radMom (nrm B (2 * Aex B.h + 1/2) g) 0 ζ'.1 ζ'.2.1)) :=
    Filter.eventuallyEq_of_mem (hU.mem_nhds (show ζ ∈ {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1} from ht))
      (fun ζ' h => ha1 ζ' h)
  rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
  exact hC ζ ht hq

theorem chiM_psi_props_v5 : ∀ B : BG, B.ok → ContDiff ℝ ∞ (fun u : ℝ => deriv (chiM B) u * Real.sqrt (2 * u)) ∧ (∀ i : ℕ, ∃ K : ℝ, ∀ u : ℝ, ‖iteratedFDeriv ℝ i (fun u : ℝ => deriv (chiM B) u * Real.sqrt (2 * u)) u‖ ≤ K) ∧ ∀ u : ℝ, (u ≤ B.m1 ∨ B.m2 ≤ u) → deriv (chiM B) u * Real.sqrt (2 * u) = 0 :=
by
  intro B hok
  have hXa : 0 < B.Xa := hok.2.1.2.2.1
  have hXm : B.Xa < B.m1 := hok.2.1.2.2.2.1
  have hm12 : B.m1 < B.m2 := hok.2.1.2.2.2.2.1
  have hm1 : 0 < B.m1 := lt_trans hXa hXm
  have hd : 0 < B.m2 - B.m1 := sub_pos.mpr hm12
  have hχ : ContDiff ℝ ∞ (chiM B) := by
    have hin : ContDiff ℝ ∞ (fun u : ℝ => (u - B.m1) / (B.m2 - B.m1)) :=
      (contDiff_id.sub contDiff_const).div_const _
    exact (Real.smoothTransition.contDiff (n := ⊤)).comp hin
  have hχ' : ContDiff ℝ ∞ (deriv (chiM B)) := (contDiff_infty_iff_deriv.mp hχ).2
  have hχ'c : Continuous (deriv (chiM B)) := hχ'.continuous
  have hlt : ∀ v : ℝ, v < B.m1 → deriv (chiM B) v = 0 := by
    intro v hv
    have hev : chiM B =ᶠ[nhds v] fun _ => (0:ℝ) := by
      refine Filter.eventuallyEq_of_mem (Iio_mem_nhds hv) (fun w hw => ?_)
      have hw' : w < B.m1 := hw
      show Real.smoothTransition ((w - B.m1) / (B.m2 - B.m1)) = 0
      exact Real.smoothTransition.zero_of_nonpos
        (div_nonpos_of_nonpos_of_nonneg (by linarith) hd.le)
    rw [hev.deriv_eq, deriv_const]
  have hgt : ∀ v : ℝ, B.m2 < v → deriv (chiM B) v = 0 := by
    intro v hv
    have hev : chiM B =ᶠ[nhds v] fun _ => (1:ℝ) := by
      refine Filter.eventuallyEq_of_mem (Ioi_mem_nhds hv) (fun w hw => ?_)
      have hw' : B.m2 < w := hw
      show Real.smoothTransition ((w - B.m1) / (B.m2 - B.m1)) = 1
      exact Real.smoothTransition.one_of_one_le ((one_le_div hd).mpr (by linarith))
    rw [hev.deriv_eq, deriv_const]
  have hZ : IsClosed {v : ℝ | deriv (chiM B) v = 0} := isClosed_eq hχ'c continuous_const
  have hle : ∀ v : ℝ, v ≤ B.m1 → deriv (chiM B) v = 0 := by
    intro v hv
    have hsub : closure (Iio B.m1) ⊆ {v : ℝ | deriv (chiM B) v = 0} :=
      (IsClosed.closure_subset_iff hZ).mpr (fun w hw => hlt w hw)
    rw [closure_Iio] at hsub
    exact hsub hv
  have hge : ∀ v : ℝ, B.m2 ≤ v → deriv (chiM B) v = 0 := by
    intro v hv
    have hsub : closure (Ioi B.m2) ⊆ {v : ℝ | deriv (chiM B) v = 0} :=
      (IsClosed.closure_subset_iff hZ).mpr (fun w hw => hgt w hw)
    rw [closure_Ioi] at hsub
    exact hsub hv
  have hz : ∀ u : ℝ, (u ≤ B.m1 ∨ B.m2 ≤ u) → deriv (chiM B) u * Real.sqrt (2 * u) = 0 := by
    intro u hu
    rcases hu with hu | hu
    · rw [hle u hu, zero_mul]
    · rw [hge u hu, zero_mul]
  have hψ : ContDiff ℝ ∞ (fun u : ℝ => deriv (chiM B) u * Real.sqrt (2 * u)) := by
    rw [contDiff_iff_contDiffAt]
    intro u
    by_cases hu : u < B.m1
    · have hev : (fun u : ℝ => deriv (chiM B) u * Real.sqrt (2 * u)) =ᶠ[nhds u]
          fun _ => (0:ℝ) :=
        Filter.eventuallyEq_of_mem (Iio_mem_nhds hu)
          (fun w hw => hz w (Or.inl (le_of_lt hw)))
      exact contDiffAt_const.congr_of_eventuallyEq hev
    · have hu' : 0 < u := lt_of_lt_of_le hm1 (not_lt.mp hu)
      have h2 : ContDiffAt ℝ ∞ (fun v : ℝ => 2 * v) u :=
        (contDiff_const.mul contDiff_id).contDiffAt
      have hs : ContDiffAt ℝ ∞ (fun v : ℝ => Real.sqrt (2 * v)) u :=
        h2.sqrt (by positivity)
      exact hχ'.contDiffAt.mul hs
  have hcs : HasCompactSupport (fun u : ℝ => deriv (chiM B) u * Real.sqrt (2 * u)) := by
    refine HasCompactSupport.intro (K := Icc B.m1 B.m2) isCompact_Icc (fun x hx => ?_)
    rw [Set.mem_Icc, not_and_or, not_le, not_le] at hx
    rcases hx with hx | hx
    · exact hz x (Or.inl hx.le)
    · exact hz x (Or.inr hx.le)
  refine ⟨hψ, fun i => ?_, hz⟩
  have hcont : Continuous (iteratedFDeriv ℝ i
      (fun u : ℝ => deriv (chiM B) u * Real.sqrt (2 * u))) :=
    hψ.continuous_iteratedFDeriv (by exact_mod_cast le_top)
  exact hcont.bounded_above_of_compact_support (hcs.iteratedFDeriv i)

theorem radial_cutoff_comp_bounds_v5 : ∀ (O : Set (ℝ³ × ℝ)) (Q : ℝ³ × ℝ → ℝ) (ψ : ℝ → ℝ) (M2 : ℝ), IsOpen O → ContDiffOn ℝ ∞ Q O → (∀ p ∈ O, 0 < Q p) → (∀ j : ℕ, ∃ C : ℝ, ∀ p ∈ O, Q p ≤ 1 → ‖iteratedFDeriv ℝ j (fun p => Q p ^ (-1 : ℝ)) p‖ ≤ C * Q p ^ (-1 - 2 * (j : ℝ))) → ContDiff ℝ ∞ ψ → (∀ i : ℕ, ∃ K : ℝ, ∀ u : ℝ, ‖iteratedFDeriv ℝ i ψ u‖ ≤ K) → (∀ u : ℝ, M2 ≤ u → ψ u = 0) → ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ => ψ (rad p.1 ^ 2 / (2 * Q p))) O ∧ ∀ j : ℕ, ∃ C : ℝ, ∀ p ∈ O, Q p ≤ 1 → ‖iteratedFDeriv ℝ j (fun p : ℝ³ × ℝ => ψ (rad p.1 ^ 2 / (2 * Q p))) p‖ ≤ C * Q p ^ (-(3 * (j : ℝ))) :=
by
  intro O Q ψ M2 hO hQs hQpos hW hψs hψb hψz

  obtain ⟨π0, hπ0⟩ : ∃ π : ℝ³ × ℝ →L[ℝ] ℝ, ∀ p : ℝ³ × ℝ, π p = p.1 0 :=
    ⟨(EuclideanSpace.proj (0 : Fin 3)).comp (ContinuousLinearMap.fst ℝ ℝ³ ℝ), fun p => rfl⟩
  obtain ⟨π1, hπ1⟩ : ∃ π : ℝ³ × ℝ →L[ℝ] ℝ, ∀ p : ℝ³ × ℝ, π p = p.1 1 :=
    ⟨(EuclideanSpace.proj (1 : Fin 3)).comp (ContinuousLinearMap.fst ℝ ℝ³ ℝ), fun p => rfl⟩

  have hlin : ∀ (π : ℝ³ × ℝ →L[ℝ] ℝ) (b : ℕ) (p : ℝ³ × ℝ),
      ‖iteratedFDeriv ℝ b π p‖ ≤ ‖π p‖ + ‖π‖ := by
    intro π b p
    rcases b with _ | b
    · rw [norm_iteratedFDeriv_zero]; linarith [norm_nonneg π]
    · rw [← norm_iteratedFDeriv_fderiv]
      have hf : fderiv ℝ π = fun _ => π := funext (fun x => π.fderiv)
      rw [hf]
      rcases b with _ | b
      · rw [norm_iteratedFDeriv_zero]; linarith [norm_nonneg (π p)]
      · rw [iteratedFDeriv_const_of_ne (Nat.succ_ne_zero b)]
        simp only [Pi.zero_apply, norm_zero]
        positivity

  have hsq : ∀ (π : ℝ³ × ℝ →L[ℝ] ℝ) (a : ℕ) (p : ℝ³ × ℝ),
      ‖iteratedFDeriv ℝ a (fun p => π p * π p) p‖ ≤ 2 ^ a * (‖π p‖ + ‖π‖) ^ 2 := by
    intro π a p
    have h1 := norm_iteratedFDeriv_mul_le (N := ⊤) π.contDiff π.contDiff p (n := a) le_top
    refine h1.trans ?_
    have hT : 0 ≤ ‖π p‖ + ‖π‖ := by positivity
    calc ∑ i ∈ Finset.range (a + 1), (a.choose i : ℝ) * ‖iteratedFDeriv ℝ i π p‖ *
          ‖iteratedFDeriv ℝ (a - i) π p‖
        ≤ ∑ i ∈ Finset.range (a + 1), (a.choose i : ℝ) * (‖π p‖ + ‖π‖) ^ 2 := by
          apply Finset.sum_le_sum
          intro i _
          rw [sq, ← mul_assoc]
          exact mul_le_mul (mul_le_mul_of_nonneg_left (hlin π i p) (Nat.cast_nonneg _))
            (hlin π (a - i) p) (norm_nonneg _) (mul_nonneg (Nat.cast_nonneg _) hT)
      _ = 2 ^ a * (‖π p‖ + ‖π‖) ^ 2 := by
          rw [← Finset.sum_mul]
          congr 1
          exact_mod_cast Nat.sum_range_choose a

  obtain ⟨S2, hS2⟩ : ∃ S2 : ℝ³ × ℝ → ℝ,
      S2 = (1/2 : ℝ) • ((fun p => π0 p * π0 p) + (fun p => π1 p * π1 p)) := ⟨_, rfl⟩
  have hS2s : ContDiff ℝ ∞ S2 := by
    rw [hS2]
    exact ((π0.contDiff.mul π0.contDiff).add (π1.contDiff.mul π1.contDiff)).const_smul (1/2 : ℝ)
  have hS2b : ∀ (a : ℕ) (p : ℝ³ × ℝ),
      ‖iteratedFDeriv ℝ a S2 p‖ ≤ 2 ^ a * (‖π0 p‖ + ‖π0‖ + (‖π1 p‖ + ‖π1‖)) ^ 2 := by
    intro a p
    have hc0 : ContDiffAt ℝ (a : ℕ∞ω) (fun p => π0 p * π0 p) p :=
      (π0.contDiff.mul π0.contDiff).contDiffAt
    have hc1 : ContDiffAt ℝ (a : ℕ∞ω) (fun p => π1 p * π1 p) p :=
      (π1.contDiff.mul π1.contDiff).contDiffAt
    rw [hS2, iteratedFDeriv_const_smul_apply
      (f := (fun p => π0 p * π0 p) + (fun p => π1 p * π1 p)) (hc0.add hc1),
      iteratedFDeriv_add_apply hc0 hc1, norm_smul]
    have h0 := hsq π0 a p
    have h1 := hsq π1 a p
    have h2 := norm_add_le (iteratedFDeriv ℝ a (fun p => π0 p * π0 p) p)
      (iteratedFDeriv ℝ a (fun p => π1 p * π1 p) p)
    have hn : ‖(1/2 : ℝ)‖ = 1/2 := by norm_num
    rw [hn]
    have t0 : 0 ≤ ‖π0 p‖ + ‖π0‖ := by positivity
    have t1 : 0 ≤ ‖π1 p‖ + ‖π1‖ := by positivity
    have h2a : (0:ℝ) ≤ 2 ^ a := by positivity
    nlinarith [mul_nonneg h2a (mul_nonneg t0 t1), mul_nonneg h2a (sq_nonneg (‖π0 p‖ + ‖π0‖)),
      mul_nonneg h2a (sq_nonneg (‖π1 p‖ + ‖π1‖))]

  obtain ⟨Xf, hXf⟩ : ∃ X : ℝ³ × ℝ → ℝ, X = fun p => rad p.1 ^ 2 / (2 * Q p) := ⟨_, rfl⟩
  have e : (fun p : ℝ³ × ℝ => ψ (rad p.1 ^ 2 / (2 * Q p))) = ψ ∘ Xf := by rw [hXf]; rfl
  have hXeq : Xf = fun p => S2 p * Q p ^ (-1 : ℝ) := by
    funext p
    rw [hXf, hS2]
    simp only [Pi.smul_apply, Pi.add_apply, smul_eq_mul, hπ0, hπ1, Real.rpow_neg_one]
    unfold rad
    rw [Real.sq_sqrt (by positivity)]
    ring
  have hWs : ContDiffOn ℝ ∞ (fun p => Q p ^ (-1 : ℝ)) O :=
    hQs.rpow_const_of_ne (fun p hp => (hQpos p hp).ne')
  have hXs : ContDiffOn ℝ ∞ Xf O := by
    rw [hXeq]; exact hS2s.contDiffOn.mul hWs
  refine ⟨?_, fun j => ?_⟩
  · rw [e]; exact hψs.comp_contDiffOn hXs
  choose Cw hCw using hW

  have hXb : ∀ i : ℕ, ∃ Cx : ℝ, 0 ≤ Cx ∧ ∀ p ∈ O, Q p ≤ 1 →
      ‖iteratedFDeriv ℝ i Xf p‖ ≤
        Cx * ((‖π0 p‖ + ‖π0‖ + (‖π1 p‖ + ‖π1‖)) ^ 2 * Q p ^ (-1 - 2 * (i : ℝ))) := by
    intro i
    refine ⟨∑ b ∈ Finset.range (i + 1), (i.choose b : ℝ) * 2 ^ b * |Cw (i - b)|,
      Finset.sum_nonneg (fun b _ => by positivity), fun p hp hq1 => ?_⟩
    have hu := hQpos p hp
    have hL := norm_iteratedFDerivWithin_mul_le (hS2s.contDiffOn (s := O)) hWs hO.uniqueDiffOn hp
      (n := i) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen i hO hp] at hL
    rw [hXeq]
    refine hL.trans ?_
    rw [Finset.sum_mul]
    apply Finset.sum_le_sum
    intro b _
    rw [iteratedFDerivWithin_of_isOpen b hO hp, iteratedFDerivWithin_of_isOpen (i - b) hO hp]
    have e1 := hS2b b p
    have e2 := hCw (i - b) p hp hq1
    have hexp : Q p ^ (-1 - 2 * ((i - b : ℕ) : ℝ)) ≤ Q p ^ (-1 - 2 * (i : ℝ)) := by
      apply Real.rpow_le_rpow_of_exponent_ge hu hq1
      have : ((i - b : ℕ) : ℝ) ≤ i := by exact_mod_cast Nat.sub_le i b
      linarith
    have e3 : ‖iteratedFDeriv ℝ (i - b) (fun p => Q p ^ (-1 : ℝ)) p‖ ≤
        |Cw (i - b)| * Q p ^ (-1 - 2 * (i : ℝ)) :=
      e2.trans (mul_le_mul (le_abs_self _) hexp (Real.rpow_nonneg hu.le _) (abs_nonneg _))
    have hA : 0 ≤ (‖π0 p‖ + ‖π0‖ + (‖π1 p‖ + ‖π1‖)) ^ 2 := by positivity
    calc (i.choose b : ℝ) * ‖iteratedFDeriv ℝ b S2 p‖ *
          ‖iteratedFDeriv ℝ (i - b) (fun p => Q p ^ (-1 : ℝ)) p‖
        ≤ (i.choose b : ℝ) * (2 ^ b * (‖π0 p‖ + ‖π0‖ + (‖π1 p‖ + ‖π1‖)) ^ 2) *
          (|Cw (i - b)| * Q p ^ (-1 - 2 * (i : ℝ))) := by
          apply mul_le_mul (mul_le_mul_of_nonneg_left e1 (Nat.cast_nonneg _)) e3 (norm_nonneg _)
          positivity
      _ = (i.choose b : ℝ) * 2 ^ b * |Cw (i - b)| *
          ((‖π0 p‖ + ‖π0‖ + (‖π1 p‖ + ‖π1‖)) ^ 2 * Q p ^ (-1 - 2 * (i : ℝ))) := by ring
  choose Cx hCx0 hCx using hXb
  choose Kψ hKψ using hψb
  obtain ⟨K', hK'⟩ : ∃ K' : ℝ, K' = ∑ i ∈ Finset.range (j + 1), |Kψ i| := ⟨_, rfl⟩
  have hK'0 : 0 ≤ K' := by rw [hK']; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  obtain ⟨R, hR⟩ : ∃ R : ℝ, R = Real.sqrt (2 * |M2|) := ⟨_, rfl⟩
  obtain ⟨A0, hA0⟩ : ∃ A0 : ℝ, A0 = (2 * R + ‖π0‖ + ‖π1‖) ^ 2 := ⟨_, rfl⟩
  have hA00 : 0 ≤ A0 := by rw [hA0]; positivity
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = 1 + ∑ i ∈ Finset.range (j + 1), Cx i * A0 := ⟨_, rfl⟩
  have hsum0 : 0 ≤ ∑ i ∈ Finset.range (j + 1), Cx i * A0 :=
    Finset.sum_nonneg (fun i _ => mul_nonneg (hCx0 i) hA00)
  have hc1 : 1 ≤ c := by rw [hc]; linarith
  have hc0 : 0 ≤ c := by linarith
  have hC0 : 0 ≤ (j.factorial : ℝ) * K' * c ^ j :=
    mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hK'0) (pow_nonneg hc0 _)
  refine ⟨(j.factorial : ℝ) * K' * c ^ j, fun p hp hq1 => ?_⟩
  have hu := hQpos p hp
  rw [e]
  have hpow : ∀ i : ℕ, Q p ^ (-(3 * (i : ℝ))) = ((Q p ^ 3) ^ i)⁻¹ := by
    intro i
    rw [Real.rpow_neg hu.le, show (3 * (i : ℝ)) = ((3 * i : ℕ) : ℝ) by push_cast; ring,
      Real.rpow_natCast, pow_mul]
  by_cases hcase : M2 < Xf p
  · have hN : IsOpen (O ∩ Xf ⁻¹' Set.Ioi M2) :=
      hXs.continuousOn.isOpen_inter_preimage hO isOpen_Ioi
    have hev : (ψ ∘ Xf) =ᶠ[nhds p] fun _ => (0:ℝ) :=
      Filter.eventuallyEq_of_mem (hN.mem_nhds ⟨hp, hcase⟩)
        (fun q hq => hψz _ (le_of_lt (show M2 < Xf q from hq.2)))
    rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds, iteratedFDeriv_fun_zero]
    simp only [Pi.zero_apply, norm_zero]
    exact mul_nonneg hC0 (Real.rpow_nonneg hu.le _)
  · replace hcase : Xf p ≤ M2 := not_lt.mp hcase
    have hu' : Q p ≠ 0 := hu.ne'
    have hX0 : 0 ≤ Xf p := by
      rw [hXf]
      exact div_nonneg (sq_nonneg _) (by linarith)
    have hM0 : 0 ≤ M2 := le_trans hX0 hcase
    have hrad : rad p.1 ^ 2 = 2 * Q p * Xf p := by
      rw [hXf]
      field_simp
    have hrad2 : p.1 0 ^ 2 + p.1 1 ^ 2 = rad p.1 ^ 2 := by
      unfold rad
      rw [Real.sq_sqrt (by positivity)]
    have hle : p.1 0 ^ 2 + p.1 1 ^ 2 ≤ 2 * |M2| := by
      rw [abs_of_nonneg hM0, hrad2, hrad]
      nlinarith
    have hy0 : |p.1 0| ≤ R := by
      rw [hR]; exact Real.abs_le_sqrt (by nlinarith [sq_nonneg (p.1 1)])
    have hy1 : |p.1 1| ≤ R := by
      rw [hR]; exact Real.abs_le_sqrt (by nlinarith [sq_nonneg (p.1 0)])
    have hAp : (‖π0 p‖ + ‖π0‖ + (‖π1 p‖ + ‖π1‖)) ^ 2 ≤ A0 := by
      rw [hA0, hπ0, hπ1, Real.norm_eq_abs, Real.norm_eq_abs]
      apply pow_le_pow_left₀ (by positivity)
      linarith
    have hψbd : ∀ i ≤ j, ‖iteratedFDerivWithin ℝ i ψ Set.univ (Xf p)‖ ≤ K' := by
      intro i hi
      rw [iteratedFDerivWithin_univ]
      refine (hKψ i (Xf p)).trans ((le_abs_self _).trans ?_)
      rw [hK']
      exact Finset.single_le_sum (f := fun i => |Kψ i|) (fun i _ => abs_nonneg _)
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    have hXd : ∀ i : ℕ, 1 ≤ i → i ≤ j → ‖iteratedFDerivWithin ℝ i Xf O p‖ ≤ (c / Q p ^ 3) ^ i := by
      intro i hi1 hij
      rw [iteratedFDerivWithin_of_isOpen i hO hp]
      have h1 := hCx i p hp hq1
      have hexp : Q p ^ (-1 - 2 * (i : ℝ)) ≤ Q p ^ (-(3 * (i : ℝ))) := by
        apply Real.rpow_le_rpow_of_exponent_ge hu hq1
        have : (1:ℝ) ≤ i := by exact_mod_cast hi1
        linarith
      have hCi : Cx i * A0 ≤ c ^ i := by
        have h3 := Finset.single_le_sum (f := fun i => Cx i * A0)
          (fun i _ => mul_nonneg (hCx0 i) hA00) (Finset.mem_range.mpr (Nat.lt_succ_of_le hij))
        have h4 := le_self_pow₀ hc1 (by omega : i ≠ 0)
        linarith
      have hqi : 0 ≤ ((Q p ^ 3) ^ i)⁻¹ := by positivity
      calc ‖iteratedFDeriv ℝ i Xf p‖
          ≤ Cx i * ((‖π0 p‖ + ‖π0‖ + (‖π1 p‖ + ‖π1‖)) ^ 2 * Q p ^ (-1 - 2 * (i : ℝ))) := h1
        _ ≤ Cx i * (A0 * Q p ^ (-(3 * (i : ℝ)))) := by
            apply mul_le_mul_of_nonneg_left _ (hCx0 i)
            exact mul_le_mul hAp hexp (Real.rpow_nonneg hu.le _) hA00
        _ = Cx i * A0 * ((Q p ^ 3) ^ i)⁻¹ := by rw [hpow i]; ring
        _ ≤ c ^ i * ((Q p ^ 3) ^ i)⁻¹ := mul_le_mul_of_nonneg_right hCi hqi
        _ = (c / Q p ^ 3) ^ i := by rw [div_pow, div_eq_mul_inv]
    have key := norm_iteratedFDerivWithin_comp_le (g := ψ) (f := Xf) (t := Set.univ) (s := O)
      (n := j) (N := ∞) hψs.contDiffOn hXs (by exact_mod_cast le_top) uniqueDiffOn_univ
      hO.uniqueDiffOn (Set.mapsTo_univ _ _) hp hψbd hXd
    rw [iteratedFDerivWithin_of_isOpen j hO hp] at key
    refine key.trans (le_of_eq ?_)
    rw [hpow j, div_pow]
    ring

theorem flat_affine_comp_v5 : ∀ (B : BG) (qs : ℝ) (Φ : ℝ × ℝ × (ℝ × ℝ) → ℝ), B.ok → ContDiffOn ℝ ∞ Φ {ζ | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} → (∀ k N : ℕ, ∃ C : ℝ, ∀ ζ : ℝ × ℝ × (ℝ × ℝ), ζ.2.1 < 1 → simScale B.h ζ.1 (1 - ζ.2.1) < qs → ‖iteratedFDeriv ℝ k Φ ζ‖ ≤ C * simScale B.h ζ.1 (1 - ζ.2.1) ^ (N : ℝ)) → (∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ => Φ (p.1 2, p.2, p.2 • vtv + Y₀)) (simDomain B.h qs)) ∧ ∀ k N : ℕ, ∃ C : ℝ, ∀ (Y₀ : ℝ × ℝ) (p : ℝ³ × ℝ), p ∈ simDomain B.h qs → ‖iteratedFDeriv ℝ k (fun p : ℝ³ × ℝ => Φ (p.1 2, p.2, p.2 • vtv + Y₀)) p‖ ≤ C * simScale B.h (p.1 2) (1 - p.2) ^ (N : ℝ) :=
by
  intro B qs Φ hok hΦs hΦb

  have hO3 : IsOpen {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1} :=
    isOpen_lt (by fun_prop) continuous_const
  have h4 : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
    hok.1.2.2.2.1.continuousOn
  have hφ : Continuous (fun ζ : ℝ × ℝ × (ℝ × ℝ) => ((ζ.1, 1 - ζ.2.1) : ℝ × ℝ)) := by fun_prop
  have hmaps : Set.MapsTo (fun ζ : ℝ × ℝ × (ℝ × ℝ) => ((ζ.1, 1 - ζ.2.1) : ℝ × ℝ))
      {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1} (univ ×ˢ Ioi 0) := by
    intro ζ hζ
    have h' : ζ.2.1 < 1 := hζ
    exact ⟨mem_univ _, show (0:ℝ) < 1 - ζ.2.1 by linarith⟩
  have hc : ContinuousOn ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
      (fun ζ : ℝ × ℝ × (ℝ × ℝ) => ((ζ.1, 1 - ζ.2.1) : ℝ × ℝ)))
      {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1} := h4.comp hφ.continuousOn hmaps
  have hΩ : IsOpen {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} := by
    have h3 := hc.isOpen_inter_preimage hO3 (isOpen_Iio (a := qs))
    have e : {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} =
        {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1} ∩ ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
          (fun ζ : ℝ × ℝ × (ℝ × ℝ) => ((ζ.1, 1 - ζ.2.1) : ℝ × ℝ))) ⁻¹' Iio qs := by
      ext ζ
      exact Iff.rfl
    rw [e]
    exact h3
  set Ω := {ζ : ℝ × ℝ × (ℝ × ℝ) | ζ.2.1 < 1 ∧ simScale B.h ζ.1 (1 - ζ.2.1) < qs} with hΩdef

  obtain ⟨L, hL⟩ : ∃ L : ℝ³ × ℝ →L[ℝ] ℝ × ℝ × (ℝ × ℝ),
      L = ((EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).comp
        (ContinuousLinearMap.fst ℝ ℝ³ ℝ)).prod ((ContinuousLinearMap.snd ℝ ℝ³ ℝ).prod
          ((ContinuousLinearMap.snd ℝ ℝ³ ℝ).smulRight vtv)) := ⟨_, rfl⟩
  have hI : ∀ (Y₀ : ℝ × ℝ) (p : ℝ³ × ℝ),
      L p + ((0:ℝ), (0:ℝ), Y₀) = (p.1 2, p.2, p.2 • vtv + Y₀) := by
    intro Y₀ p
    rw [hL]
    simp
  have hT : ∀ Y₀ : ℝ × ℝ,
      IsOpen ((fun z : ℝ × ℝ × (ℝ × ℝ) => z + ((0:ℝ), (0:ℝ), Y₀)) ⁻¹' Ω) := fun Y₀ =>
    hΩ.preimage (continuous_id.add continuous_const)
  have hfc : ∀ Y₀ : ℝ × ℝ, ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × (ℝ × ℝ) => Φ (z + ((0:ℝ), (0:ℝ), Y₀)))
      ((fun z : ℝ × ℝ × (ℝ × ℝ) => z + ((0:ℝ), (0:ℝ), Y₀)) ⁻¹' Ω) := fun Y₀ =>
    hΦs.comp (contDiff_id.add contDiff_const).contDiffOn (fun w hw => hw)
  have hpre : ∀ Y₀ : ℝ × ℝ,
      ⇑L ⁻¹' ((fun z : ℝ × ℝ × (ℝ × ℝ) => z + ((0:ℝ), (0:ℝ), Y₀)) ⁻¹' Ω) = simDomain B.h qs := by
    intro Y₀
    ext p
    show L p + ((0:ℝ), (0:ℝ), Y₀) ∈ Ω ↔ _
    rw [hI Y₀ p]
    exact Iff.rfl
  have hfun : ∀ Y₀ : ℝ × ℝ, (fun p : ℝ³ × ℝ => Φ (p.1 2, p.2, p.2 • vtv + Y₀)) =
      (fun z : ℝ × ℝ × (ℝ × ℝ) => Φ (z + ((0:ℝ), (0:ℝ), Y₀))) ∘ ⇑L := by
    intro Y₀
    funext p
    show _ = Φ (L p + ((0:ℝ), (0:ℝ), Y₀))
    rw [hI Y₀ p]
  refine ⟨fun Y₀ => ?_, fun k N => ?_⟩
  · rw [hfun Y₀, ← hpre Y₀]
    exact (hfc Y₀).comp L.contDiff.contDiffOn (fun p hp => hp)
  · obtain ⟨C₀, hC₀⟩ := hΦb k N
    refine ⟨C₀ * ‖L‖ ^ k, fun Y₀ p hp => ?_⟩
    have hSo : IsOpen (⇑L ⁻¹' ((fun z : ℝ × ℝ × (ℝ × ℝ) => z + ((0:ℝ), (0:ℝ), Y₀)) ⁻¹' Ω)) :=
      (hT Y₀).preimage L.continuous
    have hpS : p ∈ ⇑L ⁻¹' ((fun z : ℝ × ℝ × (ℝ × ℝ) => z + ((0:ℝ), (0:ℝ), Y₀)) ⁻¹' Ω) := by
      rw [hpre Y₀]; exact hp
    have hLp : L p ∈ (fun z : ℝ × ℝ × (ℝ × ℝ) => z + ((0:ℝ), (0:ℝ), Y₀)) ⁻¹' Ω := hpS
    have e1 : iteratedFDerivWithin ℝ k
        ((fun z : ℝ × ℝ × (ℝ × ℝ) => Φ (z + ((0:ℝ), (0:ℝ), Y₀))) ∘ ⇑L)
        (⇑L ⁻¹' ((fun z : ℝ × ℝ × (ℝ × ℝ) => z + ((0:ℝ), (0:ℝ), Y₀)) ⁻¹' Ω)) p =
        iteratedFDeriv ℝ k ((fun z : ℝ × ℝ × (ℝ × ℝ) => Φ (z + ((0:ℝ), (0:ℝ), Y₀))) ∘ ⇑L) p :=
      iteratedFDerivWithin_of_isOpen k hSo hpS
    have e2 := L.iteratedFDerivWithin_comp_right (hfc Y₀) (hT Y₀).uniqueDiffOn hSo.uniqueDiffOn hLp
      (i := k) (by exact_mod_cast le_top)
    have e3 : iteratedFDerivWithin ℝ k (fun z : ℝ × ℝ × (ℝ × ℝ) => Φ (z + ((0:ℝ), (0:ℝ), Y₀)))
        ((fun z : ℝ × ℝ × (ℝ × ℝ) => z + ((0:ℝ), (0:ℝ), Y₀)) ⁻¹' Ω) (L p) =
        iteratedFDeriv ℝ k (fun z : ℝ × ℝ × (ℝ × ℝ) => Φ (z + ((0:ℝ), (0:ℝ), Y₀))) (L p) :=
      iteratedFDerivWithin_of_isOpen k (hT Y₀) hLp
    have e4 : iteratedFDeriv ℝ k (fun z : ℝ × ℝ × (ℝ × ℝ) => Φ (z + ((0:ℝ), (0:ℝ), Y₀))) (L p) =
        iteratedFDeriv ℝ k Φ (L p + ((0:ℝ), (0:ℝ), Y₀)) :=
      iteratedFDeriv_comp_add_right k ((0:ℝ), (0:ℝ), Y₀) (L p)
    have key : iteratedFDeriv ℝ k (fun p : ℝ³ × ℝ => Φ (p.1 2, p.2, p.2 • vtv + Y₀)) p =
        (iteratedFDeriv ℝ k Φ ((p.1 2, p.2, p.2 • vtv + Y₀) : ℝ × ℝ × (ℝ × ℝ))).compContinuousLinearMap
          (fun _ => L) := by
      rw [hfun Y₀, ← e1, e2, e3, e4, hI Y₀ p]
    rw [key]
    have hp' : p.2 < 1 ∧ simScale B.h (p.1 2) (1 - p.2) < qs := hp
    have hb := hC₀ ((p.1 2, p.2, p.2 • vtv + Y₀) : ℝ × ℝ × (ℝ × ℝ)) hp'.1 hp'.2
    calc ‖(iteratedFDeriv ℝ k Φ ((p.1 2, p.2, p.2 • vtv + Y₀) : ℝ × ℝ × (ℝ × ℝ))).compContinuousLinearMap
          (fun _ => L)‖
        ≤ ‖iteratedFDeriv ℝ k Φ ((p.1 2, p.2, p.2 • vtv + Y₀) : ℝ × ℝ × (ℝ × ℝ))‖ * ∏ _i : Fin k, ‖L‖ :=
          ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
      _ = ‖iteratedFDeriv ℝ k Φ ((p.1 2, p.2, p.2 • vtv + Y₀) : ℝ × ℝ × (ℝ × ℝ))‖ * ‖L‖ ^ k := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      _ ≤ (C₀ * simScale B.h (p.1 2) (1 - p.2) ^ (N : ℝ)) * ‖L‖ ^ k :=
          mul_le_mul_of_nonneg_right hb (pow_nonneg (norm_nonneg _) _)
      _ = C₀ * ‖L‖ ^ k * simScale B.h (p.1 2) (1 - p.2) ^ (N : ℝ) := by ring

theorem weight_leibniz_calculus_v5 : ∀ (U : Set (ℝ³ × ℝ)) (w : ℝ³ × ℝ → ℝ), IsOpen U → (∀ p ∈ U, 0 < w p ∧ w p ≤ 1) → (∀ f1 f2 : ℝ³ × ℝ → ℝ, ContDiffOn ℝ ∞ f1 U → ContDiffOn ℝ ∞ f2 U → (∀ j : ℕ, ∃ C a : ℝ, ∀ p ∈ U, ‖iteratedFDeriv ℝ j f1 p‖ ≤ C * w p ^ (-a)) → (∀ j : ℕ, ∃ C a : ℝ, ∀ p ∈ U, ‖iteratedFDeriv ℝ j f2 p‖ ≤ C * w p ^ (-a)) → ∀ j : ℕ, ∃ C a : ℝ, ∀ p ∈ U, ‖iteratedFDeriv ℝ j (fun p => f1 p * f2 p) p‖ ≤ C * w p ^ (-a)) ∧ (∀ f : ℝ³ × ℝ → ℝ, ContDiffOn ℝ ∞ f U → (∀ j : ℕ, ∃ C a : ℝ, ∀ p ∈ U, ‖iteratedFDeriv ℝ j f p‖ ≤ C * w p ^ (-a)) → ∀ (Cg : ℕ → ℕ → ℝ) (j N : ℕ), ∃ C : ℝ, ∀ g : ℝ³ × ℝ → ℝ, ContDiffOn ℝ ∞ g U → (∀ (i M : ℕ) (p : ℝ³ × ℝ), p ∈ U → ‖iteratedFDeriv ℝ i g p‖ ≤ Cg i M * w p ^ (M : ℝ)) → ∀ p ∈ U, ‖iteratedFDeriv ℝ j (fun p => f p * g p) p‖ ≤ C * w p ^ (N : ℝ)) :=
by
  intro U w hU hw
  have leib : ∀ (f g : ℝ³ × ℝ → ℝ), ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ g U → ∀ p ∈ U, ∀ n : ℕ,
      ‖iteratedFDeriv ℝ n (fun p => f p * g p) p‖ ≤ ∑ i ∈ Finset.range (n + 1),
        (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i f p‖ * ‖iteratedFDeriv ℝ (n - i) g p‖ := by
    intro f g hf hg p hp n
    have h := norm_iteratedFDerivWithin_mul_le hf hg hU.uniqueDiffOn hp (n := n)
      (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen n hU hp] at h
    refine h.trans (le_of_eq (Finset.sum_congr rfl fun i _ => ?_))
    rw [iteratedFDerivWithin_of_isOpen i hU hp, iteratedFDerivWithin_of_isOpen (n - i) hU hp]
  have unif : ∀ (F : ℕ → ℝ³ × ℝ → ℝ), (∀ i : ℕ, ∃ C a : ℝ, ∀ p ∈ U, F i p ≤ C * w p ^ (-a)) →
      ∀ n : ℕ, ∃ C A : ℝ, 0 ≤ C ∧ 0 ≤ A ∧ ∀ i ≤ n, ∀ p ∈ U, F i p ≤ C * w p ^ (-A) := by
    intro F hF n
    choose Cf af hFb using hF
    refine ⟨∑ i ∈ Finset.range (n+1), |Cf i|, ∑ i ∈ Finset.range (n+1), |af i|,
      Finset.sum_nonneg (fun i _ => abs_nonneg _), Finset.sum_nonneg (fun i _ => abs_nonneg _), ?_⟩
    intro i hi p hp
    obtain ⟨hw0, hw1⟩ := hw p hp
    have hmem : i ∈ Finset.range (n+1) := Finset.mem_range.mpr (by omega)
    have hC : |Cf i| ≤ ∑ i ∈ Finset.range (n+1), |Cf i| :=
      Finset.single_le_sum (f := fun i => |Cf i|) (fun i _ => abs_nonneg _) hmem
    have hA : |af i| ≤ ∑ i ∈ Finset.range (n+1), |af i| :=
      Finset.single_le_sum (f := fun i => |af i|) (fun i _ => abs_nonneg _) hmem
    have hpow : w p ^ (-af i) ≤ w p ^ (-(∑ i ∈ Finset.range (n+1), |af i|)) :=
      Real.rpow_le_rpow_of_exponent_ge hw0 hw1 (by linarith [le_abs_self (af i)])
    calc F i p ≤ Cf i * w p ^ (-af i) := hFb i p hp
      _ ≤ |Cf i| * w p ^ (-af i) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg hw0.le _)
      _ ≤ |Cf i| * w p ^ (-(∑ i ∈ Finset.range (n+1), |af i|)) :=
          mul_le_mul_of_nonneg_left hpow (abs_nonneg _)
      _ ≤ _ := mul_le_mul_of_nonneg_right hC (Real.rpow_nonneg hw0.le _)
  refine ⟨?_, ?_⟩
  · intro f1 f2 hf1 hf2 hb1 hb2 j
