  have hBint : IntegrableOn (fun r : ℝ => ∫ Y in Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1,
      iteratedFDeriv ℝ k f (r, ζ.1, ζ.2.1, Y) (fun i => ((0:ℝ), (v i).1, (v i).2.1, (0 : ℝ × ℝ))))
      (Set.Ioi 0) := by
    refine hBc.integrableOn_Icc.of_forall_sdiff_eq_zero measurableSet_Ioi (fun r hr => ?_)
    obtain ⟨hr0, hab⟩ := hnot r hr
    have h0 : ∀ Y : ℝ × ℝ, iteratedFDeriv ℝ k f (r, ζ.1, ζ.2.1, Y)
