        φ η * (x ^ (-lam) * cb 0 x) + φ η * (x ^ (1 - lam) * deriv (cb 0) x) := by
      intro x hx
      rw [uIcc_of_le (by linarith)] at hx
      have hx0 : 0 < x := by linarith [hx.1]
      by_cases hxp : p1 ≤ x
      · rw [hPF2 x η hxp hx.2 e1 e2]
        have r1 : x * x ^ (-1 - lam) = x ^ (-lam) := by
          rw [mul_comm, ← Real.rpow_add_one hx0.ne']; congr 1; ring
        have r2 : x * (x * x ^ (-1 - lam)) = x ^ (1 - lam) := by
          rw [r1, mul_comm, ← Real.rpow_add_one hx0.ne']; congr 1; ring
        linear_combination (φ η * cb 0 x) * r1 + (φ η * deriv (cb 0) x) * r2
      · push_neg at hxp
        rw [hcbz 0 x (Or.inl hxp.le), hcbd0 x (Or.inl hxp)]; ring
    rw [intervalIntegral.integral_congr (fun x hx => hpt x hx)]
    have hcpow : ∀ q : ℝ, ContinuousOn (fun x : ℝ => x ^ q) (Icc Xi p2) := fun q =>
      ContinuousOn.rpow_const (f := fun x : ℝ => x) (p := q) continuousOn_id
        (fun x (hx : x ∈ Icc Xi p2) => Or.inl (show (0:ℝ) < x by linarith [hx.1]).ne')
    have i1 : IntervalIntegrable (fun x => φ η * (x ^ (-lam) * cb 0 x)) volume Xi p2 :=
      (continuousOn_const.mul ((hcpow _).mul hcbc.continuousOn)).intervalIntegrable_of_Icc (by linarith)
    have i2 : IntervalIntegrable (fun x => φ η * (x ^ (1 - lam) * deriv (cb 0) x)) volume Xi p2 :=
      (continuousOn_const.mul ((hcpow _).mul hcbdc.continuousOn)).intervalIntegrable_of_Icc (by linarith)
    rw [intervalIntegral.integral_add i1 i2, intervalIntegral.integral_const_mul,
      intervalIntegral.integral_const_mul]
    have hI1 : ∫ x in Xi..p2, x ^ (-lam) * cb 0 x = 1 :=
      (hsupp (fun x => x ^ (-lam) * cb 0 x) Xi p1 pb p2 hXip1.le hp1pb.le hpbp2.le
        ((hcpow _).mul hcbc.continuousOn) (fun x hx => by simp only [hcbz 0 x hx, mul_zero])).trans hcI
    have hI2 : ∫ x in Xi..p2, x ^ (1 - lam) * deriv (cb 0) x = -((1 - lam) * 1) := by
      have hu : ∀ x ∈ uIcc Xi p2, HasDerivAt (fun x : ℝ => x ^ (1 - lam)) ((1 - lam) * x ^ (-lam)) x := by
        intro x hx
        rw [uIcc_of_le (by linarith)] at hx
        have := Real.hasDerivAt_rpow_const (x := x) (p := 1 - lam)
          (Or.inl (show (0:ℝ) < x by linarith [hx.1]).ne')
        rwa [show (1:ℝ) - lam - 1 = -lam by ring] at this
      have hpp := intervalIntegral.integral_mul_deriv_eq_deriv_mul hu (fun x _ => hcbhd x)
        ((continuousOn_const.mul (hcpow (-lam))).intervalIntegrable_of_Icc (by linarith))
        (hcbdc.continuousOn.intervalIntegrable_of_Icc (by linarith))
      have hth : ∫ x in Xi..p2, (1 - lam) * x ^ (-lam) * cb 0 x =
          (1 - lam) * ∫ x in Xi..p2, x ^ (-lam) * cb 0 x := by
        rw [← intervalIntegral.integral_const_mul]; congr 1; funext x; ring
      rw [hpp, hcbz 0 Xi (Or.inl hXip1.le), hcbz 0 p2 (Or.inr hpbp2.le), hth, hI1]; ring
    rw [hI1, hI2]; ring
  have hm4 : ∀ η, -1 < η → η < 1 →
      (∫ X in Ioi (0:ℝ), X * ∑ i ∈ Finset.range (n + 1), bgUz (S' i) X η * G' (n - i) X η) = 0 := by
    intro η e1 e2
    rw [hIoi (fun x => x * ∑ i ∈ Finset.range (n + 1), bgUz (S' i) x η * G' (n - i) x η)
      (fun x hx => by
        simp only [hsum0 (fun i => bgUz (S' i) x η) (fun i => G' i x η)
          (fun i a b => hUz0 (S' i) Xs (fun X η h => (hS'z i a b X η h.le).1) x η hx)
          (fun i a b => (hS'z i a b x η hx.le).2), mul_zero])]
    rw [intervalIntegral.integral_congr (g := fun x =>
        x * ∑ i ∈ Finset.range (n + 1), bgUz (S0' i) x η * G0' (n - i) x η +
          α η * (x * ((cb 0 x + x * deriv (cb 0) x) * F x η)))
      (fun x hx => by
        have hx0 : -ε < x := by rw [uIcc_of_le hXs0.le] at hx; linarith [hx.1]
        rw [hA2 x η hx0 e1 e2]; ring)]
    have i1 := hIIg _ gI4 η e1 e2 0 Xs (by linarith) (by linarith)
    have i2 : IntervalIntegrable (fun x => α η * (x * ((cb 0 x + x * deriv (cb 0) x) * F x η)))
        volume 0 Xs :=
      (hII _ (continuousOn_id.mul (((hcbc.add (continuous_id.mul hcbdc)).continuousOn).mul
        (hcFη η e1 e2))) 0 Xs (by linarith) (by linarith)).const_mul _
    rw [intervalIntegral.integral_add i1 i2, intervalIntegral.integral_const_mul, hK η e1 e2]
    have hmz : m4z η = ∫ x in (0:ℝ)..Xs,
        x * ∑ i ∈ Finset.range (n + 1), bgUz (S0' i) x η * G0' (n - i) x η := by simp only [hm4z]
    rw [← hmz]
    have hl1 : (-1 / lam) * lam = -1 := by field_simp
    have hl2 := hφψ η
    have hαd : α η = m4z η * ψ η * (-1 / lam) := by simp only [hα]
    rw [hαd]
    linear_combination (m4z η * ψ η * φ η) * hl1 - m4z η * hl2
  have gUU : bgCoefGood ε (fun X η =>
      ∑ i ∈ Finset.range (n + 1), bgUz (S' i) X η * bgUz (S' (n - i)) X η) :=
    hcSum _ (fun i X η => bgUz (S' i) X η * bgUz (S' (n - i)) X η)
      (fun i hi => gmul _ _ (gUz _ (gS' i (by simp at hi; omega))) (gUz _ (gS' _ (by omega))))
  have gXs0 : bgCoefGood ε (fun X η => X * src0 X η) := gmul (fun X _ => X) src0 hcX gsrc0
  have gXFe : ∀ j, bgCoefGood ε (fun X η => X * F X η * eb j X) := fun j =>
    gmul _ (fun X _ => eb j X) (gmul (fun X _ => X) F hcX gF) (geb j)
  have hm5 : ∀ η, -1 < η → η < 1 → (∫ X in Ioi (0:ℝ),
      ((∑ i ∈ Finset.range (n + 1), bgUz (S' i) X η * bgUz (S' (n - i)) X η) + Wn X η)) = 0 := by
    intro η e1 e2
    rw [hIoi (fun x => (∑ i ∈ Finset.range (n + 1), bgUz (S' i) x η * bgUz (S' (n - i)) x η) + Wn x η)
      (fun x hx => by
        simp only [hsum0 (fun i => bgUz (S' i) x η) (fun i => bgUz (S' i) x η)
          (fun i a b => hUz0 (S' i) Xs (fun X η h => (hS'z i a b X η h.le).1) x η hx)
          (fun i a b => hUz0 (S' i) Xs (fun X η h => (hS'z i a b X η h.le).1) x η hx),
          hWn0 x η hx.le, add_zero])]
    have iU := hIIg _ gUU η e1 e2 0 Xs (by linarith) (by linarith)
    have iW := hIIg _ gWn η e1 e2 0 Xs (by linarith) (by linarith)
    rw [intervalIntegral.integral_add iU iW]
    have hbp := intervalIntegral.integral_mul_deriv_eq_deriv_mul (u := fun x => x) (u' := fun _ => 1)
      (v := fun x => Wn x η) (v' := fun x => src x η)
      (fun x _ => hasDerivAt_id' x)
      (fun x hx => hWnder x η (by rw [uIcc_of_le hXs0.le] at hx; linarith [hx.1]) e1 e2)
      (continuous_const.intervalIntegrable 0 Xs) (hIIg src gsrc η e1 e2 0 Xs (by linarith) (by linarith))
    simp only [one_mul, zero_mul, sub_zero] at hbp
    rw [hWn0 Xs η le_rfl] at hbp
    have hxs : ∫ x in (0:ℝ)..Xs, x * src x η = (∫ x in (0:ℝ)..Xs, x * src0 x η) + (2 * β3 η) * φ η := by
      rw [intervalIntegral.integral_congr (g := fun x => x * src0 x η + (2 * β1 η) * (x * F x η * eb 0 x) +
        (2 * β2 η) * (x * F x η * eb 1 x) + (2 * β3 η) * (x * F x η * eb 2 x))
        (fun x _ => by rw [hA1 x η]; ring)]
      rw [hInt4 _ _ _ _ gXs0 (gXFe 0) (gXFe 1) (gXFe 2) _ _ _ η 0 Xs e1 e2 (by linarith) (by linarith),
        hXFe η e1 e2 0, hXFe η e1 e2 1, hXFe η e1 e2 2, he20, he21, he22]
      ring
    have hm5d : m5z η = (∫ x in (0:ℝ)..Xs,
        ∑ i ∈ Finset.range (n + 1), bgUz (S' i) x η * bgUz (S' (n - i)) x η) -
          ∫ x in (0:ℝ)..Xs, x * src0 x η := by
      simp only [hm5z]
      exact intervalIntegral.integral_sub iU (hIIg _ gXs0 η e1 e2 0 Xs (by linarith) (by linarith))
    have h4 : β3 η * φ η = m5z η * (1 / 2) := by
      calc β3 η * φ η = m5z η * (φ η * ψ η) * (1 / 2) := by simp only [hβ3]; ring
        _ = _ := by rw [hφψ]; ring
    linarith [hbp, hxs, hm5d, h4]

  refine ⟨Sn, Gn, Wn, ?_, ?_⟩
  · rw [← hS', ← hG', ← hW']
    unfold BgOrdPre
    rw [hS'n, hG'n, hW'n]
    refine ⟨⟨gSn.1, gGn.1, gWn.1⟩, ?_,
      fun X η hX => ⟨hSn0 X η (by linarith), hGn0 X η (by linarith), hWn0 X η hX⟩,
      fun X η h1 _ => ⟨hGn0 X η (by linarith), hUz0 Sn p2 (fun X η h => hSn0 X η h.le) X η (by linarith)⟩,
      ?_, ?_, ?_, ?_, ?_⟩
    · intro m
      obtain ⟨C1, hC1⟩ := gSn.2 Xs m
      obtain ⟨C2, hC2⟩ := gGn.2 Xs m
      obtain ⟨C3, hC3⟩ := gWn.2 Xs m
      refine ⟨max (max C1 (max C2 C3)) 0, fun X η hX e1 e2 => ?_⟩
      have l1 : C1 ≤ max (max C1 (max C2 C3)) 0 := (le_max_left _ _).trans (le_max_left _ _)
      have l2 : C2 ≤ max (max C1 (max C2 C3)) 0 :=
        ((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_left _ _)
      have l3 : C3 ≤ max (max C1 (max C2 C3)) 0 :=
        ((le_max_right _ _).trans (le_max_right _ _)).trans (le_max_left _ _)
      have l0 : (0:ℝ) ≤ max (max C1 (max C2 C3)) 0 := le_max_right _ _
      by_cases hXs : X ≤ Xs
      · exact ⟨(hC1 X η hX hXs e1 e2).trans l1, (hC2 X η hX hXs e1 e2).trans l2,
          (hC3 X η hX hXs e1 e2).trans l3⟩
      · push_neg at hXs
        rw [hloc0 Sn (fun X η h => hSn0 X η (by linarith)) m X η hXs,
          hloc0 Gn (fun X η h => hGn0 X η (by linarith)) m X η hXs,
          hloc0 Wn (fun X η h => hWn0 X η h.le) m X η hXs]
        exact ⟨l0, l0, l0⟩
    · intro X η hX e1 e2
      rw [hRad, hW'n, (show pdX Wn X η = src X η from (hWnder X η (by linarith) e1 e2).deriv)]
      simp only [hsrc]; ring
    · intro X η h0 h1 e1 e2
      have hl := bgRes_local h S' G' W' (Function.update S n Si) (Function.update G n Gi)
        (Function.update W n Wi) n _ hO (by rw [hW']; exact hagr Wn hWW) (X, η)
        ⟨⟨h0, by linarith⟩, e1, e2⟩
      dsimp only at hl
      obtain ⟨-, a, b⟩ := hres X η h0 (by linarith) e1 e2
      exact ⟨hl.1.trans a, hl.2.1.trans b⟩
    · intro η e1 e2
      rw [hIoi (fun x => x * Gn x η) (fun x hx => by simp only [hGn0 x η (by linarith), mul_zero])]
      rw [intervalIntegral.integral_congr (g := fun x => x * (κ x * Gi x η) + β1 η * (x * eb 0 x) +
          β2 η * (x * eb 1 x) + β3 η * (x * eb 2 x))
        (fun x _ => by simp only [hGn, hEb]; ring)]
      rw [hInt4 (fun X η => X * (κ X * Gi X η)) (fun X _ => X * eb 0 X) (fun X _ => X * eb 1 X)
          (fun X _ => X * eb 2 X) (gmul (fun X _ => X) _ hcX gκGi) (gmul (fun X _ => X) _ hcX (geb 0))
          (gmul (fun X _ => X) _ hcX (geb 1)) (gmul (fun X _ => X) _ hcX (geb 2)) _ _ _ η 0 Xs e1 e2
          (by linarith) (by linarith),
        hXe 0 η e1 e2, hXe 1 η e1 e2, hXe 2 η e1 e2, he00, he01, he02]
      simp only [hβ1]; ring
    · exact bgAnalytic_cutoff Xi κ Si Sn hXi0 hκs hSi hASi (fun X η h0 h1 => by
        simp only [hSn, hcbz 0 X (Or.inl (by linarith))]; ring)
    · exact bgAnalytic_cutoff Xi κ Gi Gn hXi0 hκs hGi hAGi (fun X η h0 h1 => by
        simp only [hGn, hEb0 X η (Or.inl (by linarith))]; ring)
  · rw [← hS', ← hG', ← hW']
    intro η e1 e2
    rw [hW'n]
    exact ⟨hm4 η e1 e2, hm5 η e1 e2⟩

theorem lead_F_axial_null_ext : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ), LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → ∀ Y e : ℝ, Xb < Y → -1 < e → e < 1 → simZop h (-(1 + h)) F Y e = 0 :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hL Y e hY he1 he2
  unfold LeadingProfile at hL
  obtain ⟨⟨hh0, -, -, hcinf, -, -, -, hXa0, hXap1, hp12, hp2m1, hm12, hm2v, hXvc, hXcb⟩,
    ⟨hFs, -, -, -⟩, -, -, -, -, hL7, -, -, -, -⟩ := hL
  have hXb0 : 0 < Xb := by linarith
  have hFd : ∀ Y : ℝ, 0 < Y → DifferentiableAt ℝ (fun Y' => F Y' 0) Y := by
    intro Y hY
    have hmem : (Y, (0:ℝ)) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := ⟨hY, by norm_num, by norm_num⟩
    have hopen : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
    have hc := (hFs.contDiffAt (hopen.mem_nhds hmem)).differentiableAt (by simp)
    have h2 : DifferentiableAt ℝ (fun Y' : ℝ => (Y', (0:ℝ))) Y :=
      differentiableAt_id.prodMk (differentiableAt_const _)
    exact DifferentiableAt.comp (g := ↿F) Y hc h2
  have hFeq : ∀ Y e : ℝ, Xb < Y → -1 < e → e < 1 →
      F Y e = cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * heatProfile h (2 * (1 - e ^ 2) / Y) := by
    intro Y e hY he1 he2
    have hY0 : 0 < Y := by linarith
    have hL := (hL7 Y e hY.le he1 he2).2
    have hs2 : 0 < Real.sqrt 2 := by positivity
    have hsY : 0 < Real.sqrt Y := Real.sqrt_pos.mpr hY0
    have hsq : Real.sqrt (2 * Y) = Real.sqrt 2 * Real.sqrt Y := Real.sqrt_mul (by norm_num) Y
    have hpow : Y ^ (-(1 / 2 + h)) = Y ^ (-(1 + h)) * Real.sqrt Y := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_add hY0]
      congr 1
      ring
    rw [hsq, hpow] at hL
    have e1 : F Y e = (Real.sqrt 2 * Real.sqrt Y * F Y e) / (Real.sqrt 2 * Real.sqrt Y) := by
      field_simp
    rw [e1, hL]
    field_simp
  have hHd : ∀ z : ℝ, 0 < z → z < 2 / Xb → DifferentiableAt ℝ (heatProfile h) z := by
    intro z hz hzb
    have h2z : 0 < 2 / z := by positivity
    have hgd : DifferentiableAt ℝ
        (fun w : ℝ => Real.sqrt 2 / cinf * (2 / w) ^ (1 + h) * F (2 / w) 0) z := by
      have hd1 : DifferentiableAt ℝ (fun w : ℝ => 2 / w) z :=
        (differentiableAt_const _).div differentiableAt_id hz.ne'
      have hd2 : DifferentiableAt ℝ (fun w : ℝ => (2 / w) ^ (1 + h)) z :=
        hd1.rpow_const (Or.inl h2z.ne')
      have hd3 : DifferentiableAt ℝ (fun w : ℝ => F (2 / w) 0) z :=
        (hFd (2 / z) h2z).comp z hd1
      exact (hd2.const_mul _).mul hd3
    apply hgd.congr_of_eventuallyEq
    filter_upwards [Ioo_mem_nhds hz hzb] with w hw
    have hw0 : 0 < w := hw.1
    have hY : Xb < 2 / w := by
      rw [lt_div_iff₀ hw0]
      have := (lt_div_iff₀ hXb0).mp hw.2
      linarith
    have hFw := hFeq (2 / w) 0 hY (by norm_num) (by norm_num)
    have harg : 2 * (1 - (0:ℝ) ^ 2) / (2 / w) = w := by
      rw [show (1:ℝ) - 0 ^ 2 = 1 by norm_num]
      field_simp
    rw [harg] at hFw
    rw [hFw]
    have hp : 0 < (2 / w) ^ (1 + h) := Real.rpow_pos_of_pos (by positivity) _
    rw [Real.rpow_neg (by positivity)]
    have hs2 : 0 < Real.sqrt 2 := by positivity
    field_simp
  have hY0 : 0 < Y := by linarith
  have hd : 0 < 1 - e ^ 2 := by nlinarith
  have hz : 0 < 2 * (1 - e ^ 2) / Y := by positivity
  have hzb : 2 * (1 - e ^ 2) / Y < 2 / Xb := by
    rw [div_lt_div_iff₀ hY0 hXb0]
    have he2' : 0 ≤ e ^ 2 := sq_nonneg e
    nlinarith
  obtain ⟨H', hH⟩ : ∃ H', HasDerivAt (heatProfile h) H' (2 * (1 - e ^ 2) / Y) :=
    ⟨_, (hHd _ hz hzb).hasDerivAt⟩
  have hX1 : HasDerivAt (fun Y' : ℝ => 2 * (1 - e ^ 2) / Y')
      ((0 * Y - 2 * (1 - e ^ 2) * 1) / Y ^ 2) Y :=
    (hasDerivAt_const Y (2 * (1 - e ^ 2))).div (hasDerivAt_id' Y) hY0.ne'
  have hX2 : HasDerivAt (fun Y' : ℝ => Y' ^ (-(1 + h))) (-(1 + h) * Y ^ (-(1 + h) - 1)) Y :=
    Real.hasDerivAt_rpow_const (Or.inl hY0.ne')
  have hXF : HasDerivAt
      (fun Y' : ℝ => cinf / Real.sqrt 2 * Y' ^ (-(1 + h)) * heatProfile h (2 * (1 - e ^ 2) / Y'))
      (cinf / Real.sqrt 2 * (-(1 + h) * Y ^ (-(1 + h) - 1)) * heatProfile h (2 * (1 - e ^ 2) / Y) +
        cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * (H' * ((0 * Y - 2 * (1 - e ^ 2) * 1) / Y ^ 2))) Y :=
    (hX2.const_mul (cinf / Real.sqrt 2)).mul (hH.comp Y hX1)
  have hE1 : HasDerivAt (fun e' : ℝ => 2 * (1 - e' ^ 2) / Y) (-(4 * e) / Y) e := by
    have := (((hasDerivAt_pow 2 e).const_sub 1).const_mul 2).div_const Y
    convert this using 1
    norm_num
    ring
  have hEF : HasDerivAt
      (fun e' : ℝ => cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * heatProfile h (2 * (1 - e' ^ 2) / Y))
      (cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * (H' * (-(4 * e) / Y))) e :=
    (hH.comp e hE1).const_mul _
  have hpdX : pdX F Y e =
      cinf / Real.sqrt 2 * (-(1 + h) * Y ^ (-(1 + h) - 1)) * heatProfile h (2 * (1 - e ^ 2) / Y) +
        cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * (H' * ((0 * Y - 2 * (1 - e ^ 2) * 1) / Y ^ 2)) := by
    unfold pdX
    have hev : (fun Y' => F Y' e) =ᶠ[nhds Y]
        (fun Y' : ℝ => cinf / Real.sqrt 2 * Y' ^ (-(1 + h)) * heatProfile h (2 * (1 - e ^ 2) / Y')) := by
      filter_upwards [Ioi_mem_nhds hY] with Y' hY'
      exact hFeq Y' e hY' he1 he2
    rw [hev.deriv_eq]
    exact hXF.deriv
  have hpdE : pdE F Y e = cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * (H' * (-(4 * e) / Y)) := by
    unfold pdE
    have hev : (fun e' => F Y e') =ᶠ[nhds e]
        (fun e' : ℝ => cinf / Real.sqrt 2 * Y ^ (-(1 + h)) * heatProfile h (2 * (1 - e' ^ 2) / Y)) := by
      filter_upwards [Ioo_mem_nhds he1 he2] with e' he'
      exact hFeq Y e' hY he'.1 he'.2
    rw [hev.deriv_eq]
    exact hEF.deriv
  unfold simZop
  rw [hpdX, hpdE, hFeq Y e hY he1 he2, Real.rpow_sub_one hY0.ne']
  rw [div_eq_zero_iff]
  left
  field_simp
  ring

theorem heatProfile_near_one : ∀ h : ℝ, 0 < h → h ≤ 1 → ContinuousOn (heatProfile h) (Ioi 0) ∧ ∀ Z : ℝ, 0 ≤ Z → |heatProfile h Z - 1| ≤ h * (1 + h) * Z :=
by
  intro h hh0 hh1

  have pw : ∀ Z v : ℝ, 0 ≤ Z → 0 ≤ v →
      0 < (1 + Z * v) ^ (-h) ∧ (1 + Z * v) ^ (-h) ≤ 1 ∧ 1 - (1 + Z * v) ^ (-h) ≤ h * (Z * v) := by
    intro Z v hZ hv
    have hs : 0 ≤ Z * v := mul_nonneg hZ hv
    have hp1 : 1 ≤ (1 + Z * v) ^ h := Real.one_le_rpow (by linarith) hh0.le
    have hp2 : (1 + Z * v) ^ h ≤ 1 + h * (Z * v) :=
      rpow_one_add_le_one_add_mul_self (by linarith) hh0.le hh1
    have hk : (1 + Z * v) ^ (-h) = ((1 + Z * v) ^ h)⁻¹ := Real.rpow_neg (by linarith) h
    rw [hk]
    have hp0 : 0 < (1 + Z * v) ^ h := by linarith
    refine ⟨inv_pos.mpr hp0, inv_le_one_of_one_le₀ hp1, ?_⟩
    have key : 1 - ((1 + Z * v) ^ h)⁻¹ ≤ (1 + Z * v) ^ h - 1 := by
      rw [show 1 - ((1 + Z * v) ^ h)⁻¹ = ((1 + Z * v) ^ h - 1) / (1 + Z * v) ^ h by
        field_simp]
      rw [div_le_iff₀ hp0]
      nlinarith [sq_nonneg ((1 + Z * v) ^ h - 1)]
    linarith
  have hw0 : ∀ v : ℝ, 0 ≤ v → 0 ≤ Real.exp (-v) * v ^ h := fun v hv =>
    mul_nonneg (Real.exp_pos _).le (Real.rpow_nonneg hv _)
  have hwint : IntegrableOn (fun v : ℝ => Real.exp (-v) * v ^ h) (Ioi 0) := by
    have := Real.GammaIntegral_convergent (show 0 < 1 + h by linarith)
    rw [show (1 + h) - 1 = h by ring] at this
    exact this
  have hG1 : Real.Gamma (1 + h) = ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ h := by
    rw [Real.Gamma_eq_integral (by linarith), show (1 + h) - 1 = h by ring]

  have hcont : ∀ Z : ℝ, 0 ≤ Z →
      ContinuousOn (fun v : ℝ => Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h)) (Ioi 0) := by
    intro Z hZ
    refine ContinuousOn.mul (ContinuousOn.mul (Real.continuous_exp.comp continuous_neg).continuousOn ?_) ?_
    · exact ContinuousOn.rpow_const continuousOn_id (fun x hx => Or.inl (ne_of_gt (mem_Ioi.mp hx)))
    · refine ContinuousOn.rpow_const (continuousOn_const.add (continuousOn_const.mul continuousOn_id)) ?_
      intro x hx
      left
      have hx0 : 0 < x := mem_Ioi.mp hx
      have : 0 ≤ Z * x := mul_nonneg hZ hx0.le
      show 1 + Z * x ≠ 0
      linarith

  have hdom : ∀ Z v : ℝ, 0 ≤ Z → 0 ≤ v →
      ‖Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h)‖ ≤ Real.exp (-v) * v ^ h := by
    intro Z v hZ hv
    obtain ⟨k0, k1, -⟩ := pw Z v hZ hv
    have hw := hw0 v hv
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hw k0.le)]
    calc Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h) ≤ Real.exp (-v) * v ^ h * 1 :=
          mul_le_mul_of_nonneg_left k1 hw
      _ = Real.exp (-v) * v ^ h := mul_one _
  have hint : ∀ Z : ℝ, 0 ≤ Z →
      IntegrableOn (fun v : ℝ => Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h)) (Ioi 0) := by
    intro Z hZ
    exact Integrable.mono' hwint ((hcont Z hZ).aestronglyMeasurable measurableSet_Ioi)
      (ae_restrict_of_forall_mem measurableSet_Ioi (fun v hv => hdom Z v hZ (le_of_lt hv)))

  have hb : ∀ Z : ℝ, 0 ≤ Z → 0 ≤ 1 - heatProfile h Z ∧ 1 - heatProfile h Z ≤ h * (1 + h) * Z := by
    intro Z hZ
    have hFint := hint Z hZ
    have hΓpos : 0 < Real.Gamma (1 + h) := Real.Gamma_pos_of_pos (by linarith)
    obtain ⟨I, hI⟩ : ∃ I : ℝ,
        I = ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h) := ⟨_, rfl⟩
    have hH : heatProfile h Z = (Real.Gamma (1 + h))⁻¹ * I := by rw [hI]; rfl
    have hdiff : Real.Gamma (1 + h) - I = ∫ v in Ioi (0:ℝ),
        (Real.exp (-v) * v ^ h - Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h)) := by
      rw [integral_sub hwint hFint, hG1, hI]
    have hlow : 0 ≤ Real.Gamma (1 + h) - I := by
      rw [hdiff]
      refine setIntegral_nonneg measurableSet_Ioi (fun v hv => ?_)
      have hv' : 0 ≤ v := le_of_lt hv
      have k1 := (pw Z v hZ hv').2.1
      have hw := hw0 v hv'
      have := mul_le_mul_of_nonneg_left k1 hw
      linarith
    have hint2 : IntegrableOn (fun v : ℝ => h * Z * (Real.exp (-v) * v ^ (1 + h))) (Ioi 0) := by
      have := Real.GammaIntegral_convergent (show 0 < 2 + h by linarith)
      rw [show (2 + h) - 1 = 1 + h by ring] at this
      exact this.const_mul (h * Z)
    have hG2 : Real.Gamma (2 + h) = ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ (1 + h) := by
      rw [Real.Gamma_eq_integral (by linarith), show (2 + h) - 1 = 1 + h by ring]
    have hrec : Real.Gamma (2 + h) = (1 + h) * Real.Gamma (1 + h) := by
      rw [show 2 + h = (1 + h) + 1 by ring]
      exact Real.Gamma_add_one (by linarith)
    have hup : Real.Gamma (1 + h) - I ≤ h * Z * Real.Gamma (2 + h) := by
      rw [hdiff, hG2, ← integral_const_mul]
      refine setIntegral_mono_on (hwint.sub hFint) hint2 measurableSet_Ioi (fun v hv => ?_)
      have hv0 : 0 < v := hv
      have k2 := (pw Z v hZ hv0.le).2.2
      have hw := hw0 v hv0.le
      have e : v ^ (1 + h) = v ^ h * v := by rw [add_comm, Real.rpow_add_one hv0.ne']
      rw [e]
      calc Real.exp (-v) * v ^ h - Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h)
          = Real.exp (-v) * v ^ h * (1 - (1 + Z * v) ^ (-h)) := by ring
        _ ≤ Real.exp (-v) * v ^ h * (h * (Z * v)) := mul_le_mul_of_nonneg_left k2 hw
        _ = h * Z * (Real.exp (-v) * (v ^ h * v)) := by ring
    have hval : 1 - heatProfile h Z = (Real.Gamma (1 + h))⁻¹ * (Real.Gamma (1 + h) - I) := by
      rw [hH, mul_sub, inv_mul_cancel₀ hΓpos.ne']
    rw [hval]
    refine ⟨mul_nonneg (inv_nonneg.mpr hΓpos.le) hlow, ?_⟩
    calc (Real.Gamma (1 + h))⁻¹ * (Real.Gamma (1 + h) - I)
        ≤ (Real.Gamma (1 + h))⁻¹ * (h * Z * Real.Gamma (2 + h)) :=
          mul_le_mul_of_nonneg_left hup (inv_nonneg.mpr hΓpos.le)
      _ = h * (1 + h) * Z * ((Real.Gamma (1 + h))⁻¹ * Real.Gamma (1 + h)) := by rw [hrec]; ring
      _ = h * (1 + h) * Z := by rw [inv_mul_cancel₀ hΓpos.ne', mul_one]

  have hJ : ContinuousOn
      (fun Z : ℝ => ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h)) (Ioi 0) := by
    refine continuousOn_of_dominated (bound := fun v => Real.exp (-v) * v ^ h) ?_ ?_ hwint ?_
    · intro Z hZ
      exact (hcont Z (le_of_lt hZ)).aestronglyMeasurable measurableSet_Ioi
    · intro Z hZ
      exact ae_restrict_of_forall_mem measurableSet_Ioi
        (fun v hv => hdom Z v (le_of_lt hZ) (le_of_lt hv))
    · refine ae_restrict_of_forall_mem measurableSet_Ioi (fun v hv => ?_)
      have hv0 : 0 < v := hv
      refine continuousOn_const.mul (ContinuousOn.rpow_const
        (continuousOn_const.add (continuousOn_id.mul continuousOn_const)) ?_)
      intro Z hZ
      left
      have hZ0 : 0 < Z := hZ
      have := mul_pos hZ0 hv0
      show 1 + Z * v ≠ 0
      linarith
  refine ⟨?_, fun Z hZ => ?_⟩
  · show ContinuousOn (fun Z : ℝ => (Real.Gamma (1 + h))⁻¹ *
      ∫ v in Ioi (0:ℝ), Real.exp (-v) * v ^ h * (1 + Z * v) ^ (-h)) (Ioi 0)
    exact continuousOn_const.mul hJ
  · obtain ⟨b1, b2⟩ := hb Z hZ
    rw [abs_sub_comm, abs_of_nonneg b1]
    exact b2

theorem tail_scaling_hasDerivAt : ∀ (h R C : ℝ) (g : ℝ → ℝ), 0 < h → h < 1 → 0 < R → 0 ≤ C → ContinuousOn g (Ioi 0) → (∀ Z : ℝ, 0 ≤ Z → |g Z - 1| ≤ C * Z) → ∀ a : ℝ, 0 < a → HasDerivAt (fun a' : ℝ => ∫ x in Ioi R, x ^ (-h) * (g (2 * a' / x) - 1)) (((1 - h) * (∫ x in Ioi R, x ^ (-h) * (g (2 * a / x) - 1)) + R ^ (1 - h) * (g (2 * a / R) - 1)) / a) a :=
by
  intro h R C g hh _ hR hC hg hb a ha
  set k : ℝ → ℝ := fun y => y ^ (-h) * (g (2 / y) - 1) with hk_def
  have hkc : ContinuousOn k (Ioi 0) := by
    apply ContinuousOn.mul
    · exact continuousOn_id.rpow_const (fun y hy => Or.inl (ne_of_gt hy))
    · apply ContinuousOn.sub _ continuousOn_const
      apply hg.comp (continuousOn_const.div continuousOn_id (fun y hy => ne_of_gt hy))
      intro y hy
      have hy' : (0:ℝ) < y := hy
      show (0:ℝ) < 2 / y
      exact div_pos two_pos hy'
  have hki : ∀ d : ℝ, 0 < d → IntegrableOn k (Ioi d) := by
    intro d hd
    have hG : IntegrableOn (fun y : ℝ => (2 * C) * y ^ (-h - 1)) (Ioi d) :=
      (integrableOn_Ioi_rpow_of_lt (by linarith) hd).const_mul _
    refine hG.mono' ((hkc.mono (Ioi_subset_Ioi hd.le)).aestronglyMeasurable measurableSet_Ioi) ?_
    refine (ae_restrict_iff' measurableSet_Ioi).mpr (Filter.Eventually.of_forall fun y hy => ?_)
    have hy0 : 0 < y := lt_trans hd hy
    have hp : 0 < y ^ (-h) := Real.rpow_pos_of_pos hy0 _
    have hbd := hb (2 / y) (div_pos two_pos hy0).le
    have e : y ^ (-h - 1) = y ^ (-h) / y := Real.rpow_sub_one hy0.ne' _
    show ‖y ^ (-h) * (g (2 / y) - 1)‖ ≤ 2 * C * y ^ (-h - 1)
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos hp, e]
    calc y ^ (-h) * |g (2 / y) - 1| ≤ y ^ (-h) * (C * (2 / y)) :=
          mul_le_mul_of_nonneg_left hbd hp.le
      _ = 2 * C * (y ^ (-h) / y) := by ring
  have hΨ : ∀ c : ℝ, 0 < c → HasDerivAt (fun c' : ℝ => ∫ y in Ioi c', k y) (-(k c)) c := by
    intro c hc
    have hd : 0 < c / 2 := by linarith
    have hII : IntervalIntegrable k volume (c / 2) c := by
      apply ContinuousOn.intervalIntegrable
      apply hkc.mono
      rw [uIcc_of_le (by linarith)]
      intro y hy
      exact lt_of_lt_of_le hd hy.1
    have hF : HasDerivAt (fun u => ∫ y in (c / 2)..u, k y) (k c) c :=
      intervalIntegral.integral_hasDerivAt_right hII
        (hkc.stronglyMeasurableAtFilter isOpen_Ioi c hc) (hkc.continuousAt (Ioi_mem_nhds hc))
    have hev : (fun c' : ℝ => ∫ y in Ioi c', k y) =ᶠ[nhds c]
        (fun c' => (∫ y in Ioi (c / 2), k y) - ∫ y in (c / 2)..c', k y) := by
      filter_upwards [Ioi_mem_nhds (show c / 2 < c by linarith)] with c' hc'
      have hc'0 : 0 < c' := lt_trans hd hc'
      have hsplit : (∫ y in Ioi (c / 2), k y) = (∫ y in Ioc (c / 2) c', k y) + ∫ y in Ioi c', k y := by
        rw [← Ioc_union_Ioi_eq_Ioi hc'.le]
        exact setIntegral_union Ioc_disjoint_Ioi_same measurableSet_Ioi
          ((hki _ hd).mono_set Ioc_subset_Ioi_self) (hki _ hc'0)
      rw [intervalIntegral.integral_of_le hc'.le, hsplit]
      ring
    exact (hF.const_sub _).congr_of_eventuallyEq hev
  have hscale : ∀ b : ℝ, 0 < b → (∫ x in Ioi R, x ^ (-h) * (g (2 * b / x) - 1)) =
      b ^ (1 - h) * ∫ y in Ioi (R / b), k y := by
    intro b hb0
    have h1 : (∫ y in Ioi (R / b), (b * y) ^ (-h) * (g (2 * b / (b * y)) - 1)) =
        b⁻¹ * ∫ x in Ioi R, x ^ (-h) * (g (2 * b / x) - 1) := by
      have := integral_comp_mul_left_Ioi (fun x => x ^ (-h) * (g (2 * b / x) - 1)) (R / b) hb0
      rw [mul_div_cancel₀ R hb0.ne', smul_eq_mul] at this
      exact this
    have h2 : (∫ y in Ioi (R / b), (b * y) ^ (-h) * (g (2 * b / (b * y)) - 1)) =
        b ^ (-h) * ∫ y in Ioi (R / b), k y := by
      rw [← integral_const_mul]
      refine setIntegral_congr_fun measurableSet_Ioi (fun y hy => ?_)
      have hy0 : 0 < y := lt_trans (div_pos hR hb0) hy
      have e : 2 * b / (b * y) = 2 / y := by field_simp
      simp only [hk_def]
      rw [Real.mul_rpow hb0.le hy0.le, e]
      ring
    have h3 : b ^ (1 - h) = b * b ^ (-h) := by
      rw [sub_eq_add_neg, Real.rpow_add hb0, Real.rpow_one]
    calc (∫ x in Ioi R, x ^ (-h) * (g (2 * b / x) - 1))
        = b * (b⁻¹ * ∫ x in Ioi R, x ^ (-h) * (g (2 * b / x) - 1)) := by
          rw [← mul_assoc, mul_inv_cancel₀ hb0.ne', one_mul]
      _ = b * (b ^ (-h) * ∫ y in Ioi (R / b), k y) := by rw [← h1, h2]
      _ = _ := by rw [h3]; ring
  have hc : HasDerivAt (fun a' : ℝ => R / a') (-(R / a ^ 2)) a := by
    have := (hasDerivAt_inv ha.ne').const_mul R
    convert this using 1
    · funext a'
      rw [div_eq_mul_inv]
    · field_simp
  have hp : HasDerivAt (fun a' : ℝ => a' ^ (1 - h)) ((1 - h) * a ^ (1 - h - 1)) a :=
    Real.hasDerivAt_rpow_const (Or.inl ha.ne')
  have hprod := hp.mul ((hΨ (R / a) (div_pos hR ha)).comp a hc)
  have hev : (fun a' : ℝ => ∫ x in Ioi R, x ^ (-h) * (g (2 * a' / x) - 1)) =ᶠ[nhds a]
      (fun a' => a' ^ (1 - h) *
        ((fun c' : ℝ => ∫ y in Ioi c', k y) ∘ (fun a' : ℝ => R / a')) a') := by
    filter_upwards [Ioi_mem_nhds ha] with a' ha'
    simp only [Function.comp_apply]
    exact hscale a' ha'
  refine (hprod.congr_of_eventuallyEq hev).congr_deriv ?_
  rw [hscale a ha]
  have hu : 0 < a ^ (-h) := Real.rpow_pos_of_pos ha _
  have hv : 0 < R ^ (-h) := Real.rpow_pos_of_pos hR _
  have e1 : a ^ (1 - h - 1) = a ^ (-h) := by congr 1; ring
  have e2 : a ^ (1 - h) = a * a ^ (-h) := by
    rw [sub_eq_add_neg, Real.rpow_add ha, Real.rpow_one]
  have e3 : R ^ (1 - h) = R * R ^ (-h) := by
    rw [sub_eq_add_neg, Real.rpow_add hR, Real.rpow_one]
  have e4 : (R / a) ^ (-h) = R ^ (-h) / a ^ (-h) := Real.div_rpow hR.le ha.le _
  have e5 : 2 / (R / a) = 2 * a / R := by field_simp
  simp only [Function.comp_apply]
  generalize (∫ y in Ioi (R / a), k y) = P
  simp only [hk_def, e1, e2, e3, e4, e5]
  generalize a ^ (-h) = u at hu ⊢
  generalize R ^ (-h) = v at hv ⊢
  field_simp

theorem zop_first_moment_reduce : ∀ (h b ε R η : ℝ) (F : ℝ → ℝ → ℝ), 0 < ε → 0 < R → ContDiffOn ℝ ∞ (↿F) (Ioi (-ε) ×ˢ Ioo (-1) 1) → -1 < η → η < 1 → (∀ X : ℝ, R < X → simZop h b F X η = 0) → HasDerivAt (fun e : ℝ => ∫ x in (0:ℝ)..R, x * F x e) (∫ x in (0:ℝ)..R, x * pdE F x η) η ∧ (∫ X in Ioi (0:ℝ), X * simZop h b F X η) = (2 * (b + 2) * η * (∫ x in (0:ℝ)..R, x * F x η) + (1 - η ^ 2) * (∫ x in (0:ℝ)..R, x * pdE F x η) - 2 * η * R ^ 2 * F R η) / (1 - 2 * h * η ^ 2) :=
by
  intro h b ε R η F hε hR hF hη1 hη2 hvan
  have hO : IsOpen (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hsub : ∀ x e : ℝ, 0 ≤ x → -1 < e → e < 1 → (x, e) ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 :=
    fun x e hx h1 h2 => mem_prod.mpr ⟨mem_Ioi.mpr (by linarith), h1, h2⟩

  have hFC : ContinuousOn (↿F) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := hF.continuousOn
  have hL : ContinuousOn (fderiv ℝ (↿F)) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) :=
    hF.continuousOn_fderiv_of_isOpen hO (by simp)
  have hfd : ∀ q ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1, HasFDerivAt (↿F) (fderiv ℝ (↿F) q) q := fun q hq =>
    ((hF.contDiffAt (hO.mem_nhds hq)).differentiableAt (by simp)).hasFDerivAt
  have hsX : ∀ X e : ℝ, (X, e) ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 →
      HasDerivAt (fun Y => F Y e) (fderiv ℝ (↿F) (X, e) ((1:ℝ), (0:ℝ))) X := by
    intro X e hq
    have h1 : HasDerivAt (fun Y : ℝ => (Y, e)) ((1:ℝ), (0:ℝ)) X :=
      (hasDerivAt_id' X).prodMk (hasDerivAt_const X e)
    exact (hfd (X, e) hq).comp_hasDerivAt X h1
  have hsE : ∀ X e : ℝ, (X, e) ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 →
      HasDerivAt (fun e' => F X e') (fderiv ℝ (↿F) (X, e) ((0:ℝ), (1:ℝ))) e := by
    intro X e hq
    have h1 : HasDerivAt (fun e' : ℝ => (X, e')) ((0:ℝ), (1:ℝ)) e :=
      (hasDerivAt_const e X).prodMk (hasDerivAt_id' e)
    exact (hfd (X, e) hq).comp_hasDerivAt e h1
  have hpdX : ∀ X e : ℝ, (X, e) ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 →
      pdX F X e = fderiv ℝ (↿F) (X, e) ((1:ℝ), (0:ℝ)) := fun X e hq => (hsX X e hq).deriv
  have hpdE : ∀ X e : ℝ, (X, e) ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 →
      pdE F X e = fderiv ℝ (↿F) (X, e) ((0:ℝ), (1:ℝ)) := fun X e hq => (hsE X e hq).deriv
  have hXd : ∀ X e : ℝ, (X, e) ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 →
      HasDerivAt (fun Y => F Y e) (pdX F X e) X := fun X e hq => by
    rw [hpdX X e hq]; exact hsX X e hq
  have hEd : ∀ X e : ℝ, (X, e) ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 →
      HasDerivAt (fun e' => F X e') (pdE F X e) e := fun X e hq => by
    rw [hpdE X e hq]; exact hsE X e hq
  have hCX : ContinuousOn (↿(pdX F)) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
    refine (hL.clm_apply (continuousOn_const (c := ((1:ℝ), (0:ℝ))))).congr ?_
    intro q hq
    exact hpdX q.1 q.2 hq
  have hCE : ContinuousOn (↿(pdE F)) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
    refine (hL.clm_apply (continuousOn_const (c := ((0:ℝ), (1:ℝ))))).congr ?_
    intro q hq
    exact hpdE q.1 q.2 hq
  have slice : ∀ (G : ℝ → ℝ → ℝ) (e : ℝ), -1 < e → e < 1 →
      ContinuousOn (↿G) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) → ContinuousOn (fun x => G x e) (Icc 0 R) := by
    intro G e h1 h2 hG
    exact hG.comp (continuousOn_id.prodMk continuousOn_const) (fun x hx => hsub x e hx.1 h1 h2)
  have hR' : uIoc 0 R = Ioc 0 R := uIoc_of_le hR.le

  have hA : HasDerivAt (fun e : ℝ => ∫ x in (0:ℝ)..R, x * F x e)
      (∫ x in (0:ℝ)..R, x * pdE F x η) η := by
    obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = min (η + 1) (1 - η) / 2 := ⟨_, rfl⟩
    have hm1 := min_le_left (η + 1) (1 - η)
    have hm2 := min_le_right (η + 1) (1 - η)
    have hm0 : 0 < min (η + 1) (1 - η) := lt_min (by linarith) (by linarith)
    have hδ0 : 0 < δ := by rw [hδ]; linarith
    have hδ1 : δ < η + 1 := by rw [hδ]; linarith
    have hδ2 : δ < 1 - η := by rw [hδ]; linarith
    have hK : IsCompact (Icc 0 R ×ˢ Icc (η - δ) (η + δ)) := isCompact_Icc.prod isCompact_Icc
    have hKO : Icc 0 R ×ˢ Icc (η - δ) (η + δ) ⊆ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 := by
      intro q hq
      exact hsub q.1 q.2 hq.1.1 (by linarith [hq.2.1]) (by linarith [hq.2.2])
    have hcK : ContinuousOn (fun q : ℝ × ℝ => q.1 * pdE F q.1 q.2) (Icc 0 R ×ˢ Icc (η - δ) (η + δ)) :=
      continuousOn_fst.mul (hCE.mono hKO)
    obtain ⟨B, hB⟩ := hK.exists_bound_of_continuousOn hcK
    have hmeasF : ∀ e : ℝ, -1 < e → e < 1 →
        AEStronglyMeasurable (fun x => x * F x e) (volume.restrict (uIoc 0 R)) := by
      intro e h1 h2
      rw [hR']
      exact ((continuousOn_id.mul (slice F e h1 h2 hFC)).mono Ioc_subset_Icc_self).aestronglyMeasurable
        measurableSet_Ioc
    have hmeasE : AEStronglyMeasurable (fun x => x * pdE F x η) (volume.restrict (uIoc 0 R)) := by
      rw [hR']
      exact ((continuousOn_id.mul (slice (pdE F) η hη1 hη2 hCE)).mono Ioc_subset_Icc_self).aestronglyMeasurable
        measurableSet_Ioc
    refine (intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (𝕜 := ℝ) (μ := volume) (a := 0) (b := R) (bound := fun _ => B)
      (F := fun e x => x * F x e) (F' := fun e x => x * pdE F x e) (x₀ := η)
      (s := Ioo (η - δ) (η + δ)) (Ioo_mem_nhds (by linarith) (by linarith))
      ?_ ?_ hmeasE ?_ ?_ ?_).2
    · exact Filter.eventually_of_mem (Ioo_mem_nhds hη1 hη2) (fun e he => hmeasF e he.1 he.2)
    · exact (continuousOn_id.mul (slice F η hη1 hη2 hFC)).intervalIntegrable_of_Icc hR.le
    · refine ae_of_all _ (fun x hx e he => ?_)
      rw [hR'] at hx
      exact hB (x, e) ⟨⟨hx.1.le, hx.2⟩, he.1.le, he.2.le⟩
    · exact intervalIntegrable_const
    · refine ae_of_all _ (fun x hx e he => ?_)
      rw [hR'] at hx
      exact (hEd x e (hsub x e hx.1.le (by linarith [he.1]) (by linarith [he.2]))).const_mul x

  have hFη : ContinuousOn (fun x => F x η) (Icc 0 R) := slice F η hη1 hη2 hFC
  have hXη : ContinuousOn (fun x => pdX F x η) (Icc 0 R) := slice (pdX F) η hη1 hη2 hCX
  have hEη : ContinuousOn (fun x => pdE F x η) (Icc 0 R) := slice (pdE F) η hη1 hη2 hCE
  have hp1 : ContinuousOn (fun x => x * F x η) (Icc 0 R) := continuousOn_id.mul hFη
  have hp2 : ContinuousOn (fun x => x * pdE F x η) (Icc 0 R) := continuousOn_id.mul hEη
  have hp3 : ContinuousOn (fun x => x ^ 2 * pdX F x η) (Icc 0 R) := (continuousOn_id.pow 2).mul hXη
  have hI1 : IntervalIntegrable (fun x => x * F x η) volume 0 R := hp1.intervalIntegrable_of_Icc hR.le
  have hI2 : IntervalIntegrable (fun x => x * pdE F x η) volume 0 R :=
    hp2.intervalIntegrable_of_Icc hR.le
  have hI3 : IntervalIntegrable (fun x => x ^ 2 * pdX F x η) volume 0 R :=
    hp3.intervalIntegrable_of_Icc hR.le
  have hpt : ∀ X : ℝ, X * simZop h b F X η = (2 * b * η * (X * F X η) + (1 - η ^ 2) * (X * pdE F X η)
      - 2 * η * (X ^ 2 * pdX F X η)) / (1 - 2 * h * η ^ 2) := by
    intro X
    simp only [simZop]
    ring
  have hfC : ContinuousOn (fun X => X * simZop h b F X η) (Icc 0 R) := by
    have hc : ContinuousOn (fun X => (2 * b * η * (X * F X η) + (1 - η ^ 2) * (X * pdE F X η)
        - 2 * η * (X ^ 2 * pdX F X η)) / (1 - 2 * h * η ^ 2)) (Icc 0 R) :=
      (((continuousOn_const.mul hp1).add (continuousOn_const.mul hp2)).sub
        (continuousOn_const.mul hp3)).div_const _
    refine hc.congr ?_
    intro X _
    exact hpt X
  have hint1 : IntegrableOn (fun X => X * simZop h b F X η) (Ioc 0 R) :=
    hfC.integrableOn_Icc.mono_set Ioc_subset_Icc_self
  have hzero : ∀ X ∈ Ioi R, X * simZop h b F X η = 0 := fun X hX => by
    rw [hvan X hX, mul_zero]
  have hint2 : IntegrableOn (fun X => X * simZop h b F X η) (Ioi R) :=
    integrableOn_zero.congr_fun (fun X hX => (hzero X hX).symm) measurableSet_Ioi
  have hsplit : (∫ X in Ioi (0:ℝ), X * simZop h b F X η) = ∫ x in (0:ℝ)..R, x * simZop h b F x η := by
    rw [← Ioc_union_Ioi_eq_Ioi hR.le, setIntegral_union Ioc_disjoint_Ioi_same measurableSet_Ioi hint1 hint2,
      setIntegral_eq_zero_of_forall_eq_zero hzero, add_zero, intervalIntegral.integral_of_le hR.le]
  have hlin : (∫ x in (0:ℝ)..R, x * simZop h b F x η) =
      (2 * b * η * (∫ x in (0:ℝ)..R, x * F x η) + (1 - η ^ 2) * (∫ x in (0:ℝ)..R, x * pdE F x η)
        - 2 * η * (∫ x in (0:ℝ)..R, x ^ 2 * pdX F x η)) / (1 - 2 * h * η ^ 2) := by
    simp_rw [hpt]
    rw [intervalIntegral.integral_div,
      intervalIntegral.integral_sub ((hI1.const_mul _).add (hI2.const_mul _)) (hI3.const_mul _),
      intervalIntegral.integral_add (hI1.const_mul _) (hI2.const_mul _),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
      intervalIntegral.integral_const_mul]
  have hftc : (∫ x in (0:ℝ)..R, (2 * (x * F x η) + x ^ 2 * pdX F x η)) =
      R ^ 2 * F R η - (0:ℝ) ^ 2 * F 0 η := by
    apply intervalIntegral.integral_eq_sub_of_hasDerivAt (f := fun x => x ^ 2 * F x η)
    · intro x hx
      rw [uIcc_of_le hR.le] at hx
      have H := (hasDerivAt_pow 2 x).mul (hXd x η (hsub x η hx.1 hη1 hη2))
      convert H using 1
      norm_num
      ring
    · exact (hI1.const_mul 2).add hI3
  have hE : (∫ x in (0:ℝ)..R, x ^ 2 * pdX F x η) = R ^ 2 * F R η - 2 * (∫ x in (0:ℝ)..R, x * F x η) := by
    rw [intervalIntegral.integral_add (hI1.const_mul 2) hI3, intervalIntegral.integral_const_mul] at hftc
    have h00 : (0:ℝ) ^ 2 * F 0 η = 0 := by ring
    rw [h00, sub_zero] at hftc
    linarith
  refine ⟨hA, ?_⟩
  rw [hsplit, hlin, hE]
  ring

theorem lead_tail_moment_formula : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab C : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ), LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → 0 ≤ C → (∀ Z : ℝ, 0 ≤ Z → |heatProfile h Z - 1| ≤ C * Z) → ∀ η : ℝ, -1 < η → η < 1 → 2 * (∫ x in (0:ℝ)..(Xb + 1), x * F x η) = Real.sqrt 2 * cinf * ((Xb + 1) ^ (1 - h) / (1 - h) - ∫ x in Ioi (Xb + 1), x ^ (-h) * (heatProfile h (2 * (1 - η ^ 2) / x) - 1)) :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab C F U T0th T0z hLP hC hHb η hη1 hη2
  have hLP' := hLP
  unfold LeadingProfile at hLP'
  obtain ⟨⟨hh0, hh1, -, hcinf, -, -, -, hXa, hXap1, hp12, hp2m1, hm12, hm2Xv, hXvXc, hXcXb⟩, -, -, -,
    ⟨ε, hε, hFε, -, -, -⟩, -, hTail, -, -, hMom, -⟩ := hLP'
  have hXb0 : 0 < Xb := by linarith
  have hR : (0:ℝ) < Xb + 1 := by linarith
  have hR0 : (0:ℝ) ≤ Xb + 1 := hR.le
  have ha : 0 ≤ 1 - η ^ 2 := by nlinarith
  obtain ⟨c, hcdef⟩ : ∃ c : ℝ, c = Real.sqrt 2 * cinf := ⟨_, rfl⟩
  have hc : 0 ≤ c := by rw [hcdef]; exact mul_nonneg (Real.sqrt_nonneg _) hcinf.le

  have hsq : ∀ x : ℝ, 0 < x → Real.sqrt (2 * x) * x ^ (-(1 / 2 + h)) = Real.sqrt 2 * x ^ (-h) := by
    intro x hx
    rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2) x, Real.sqrt_eq_rpow x, mul_assoc,
      ← Real.rpow_add hx]
    congr 1
    congr 1
    ring
  obtain ⟨m, hmdef⟩ : ∃ m : ℝ → ℝ,
      m = fun x => 2 * x * F x η - Real.sqrt (2 * x) * cinf * x ^ (-(1 / 2 + h)) := ⟨_, rfl⟩

  have hm1 : ∀ x : ℝ, 0 < x → m x = 2 * x * F x η - c * x ^ (-h) := by
    intro x hx
    have hq := hsq x hx
    simp only [hmdef, hcdef]
    linear_combination (-cinf) * hq
  have hm2 : ∀ x : ℝ, Xb ≤ x →
      m x = c * (x ^ (-h) * (heatProfile h (2 * (1 - η ^ 2) / x) - 1)) := by
    intro x hx
    have hx0 : 0 < x := by linarith
    have hT := (hTail x η hx hη1 hη2).2
    have hs : Real.sqrt (2 * x) * Real.sqrt (2 * x) = 2 * x := Real.mul_self_sqrt (by linarith)
    have hq := hsq x hx0
    rw [hm1 x hx0]
    linear_combination (-F x η) * hs + Real.sqrt (2 * x) * hT
      + (cinf * heatProfile h (2 * (1 - η ^ 2) / x)) * hq
      - (x ^ (-h) * heatProfile h (2 * (1 - η ^ 2) / x)) * hcdef

  have hFs : ContinuousOn (fun x => F x η) (Ioi (-ε)) :=
    hFε.continuousOn.comp (continuousOn_id.prodMk continuousOn_const) (fun x hx => ⟨hx, hη1, hη2⟩)
  have hg1 : ContinuousOn (fun x => 2 * x * F x η) (Ioi (-ε)) :=
    (continuousOn_const.mul continuousOn_id).mul hFs
  have hsubIcc : Icc 0 (Xb + 1) ⊆ Ioi (-ε) := fun x hx => by
    simp only [mem_Ioi]; linarith [hx.1]
  have hsubIoi : Ioi (Xb + 1) ⊆ Ioi (-ε) := fun x hx => by
    simp only [mem_Ioi] at hx ⊢; linarith

  have hint1 : IntegrableOn (fun x => 2 * x * F x η) (Ioc 0 (Xb + 1)) :=
    ((hg1.mono hsubIcc).integrableOn_Icc).mono_set Ioc_subset_Icc_self
  have hrp : IntegrableOn (fun x : ℝ => x ^ (-h)) (Ioc 0 (Xb + 1)) :=
    (intervalIntegrable_iff_integrableOn_Ioc_of_le hR0).1
      (intervalIntegral.intervalIntegrable_rpow' (by linarith))
  have hrpv : (∫ x in Ioc (0:ℝ) (Xb + 1), x ^ (-h)) = (Xb + 1) ^ (1 - h) / (1 - h) := by
    rw [← intervalIntegral.integral_of_le hR0, integral_rpow (Or.inl (by linarith)),
      Real.zero_rpow (by intro h'; linarith), sub_zero, show -h + 1 = 1 - h by ring]
  have hrpc : Integrable (fun x : ℝ => c * x ^ (-h)) (volume.restrict (Ioc 0 (Xb + 1))) :=
    Integrable.const_mul hrp c
  have hEq1 : EqOn ((fun x => 2 * x * F x η) - fun x : ℝ => c * x ^ (-h)) m (Ioc 0 (Xb + 1)) :=
    fun x hx => by simp only [Pi.sub_apply]; exact (hm1 x hx.1).symm
  have hI1 : IntegrableOn m (Ioc 0 (Xb + 1)) :=
    IntegrableOn.congr_fun (Integrable.sub hint1 hrpc) hEq1 measurableSet_Ioc

  have hmc : ContinuousOn m (Ioi (Xb + 1)) := by
    rw [hmdef]
    refine (hg1.mono hsubIoi).sub ?_
    refine (((continuousOn_const.mul continuousOn_id).sqrt).mul continuousOn_const).mul ?_
    exact continuousOn_id.rpow_const (fun x hx => Or.inl (lt_trans hR hx).ne')
  have hbound : ∀ x ∈ Ioi (Xb + 1), ‖m x‖ ≤ (c * C * (2 * (1 - η ^ 2))) * x ^ (-1 - h) := by
    intro x hx
    have hxR : Xb + 1 < x := hx
    have hx0 : 0 < x := lt_trans hR hxR
    have hZ : 0 ≤ 2 * (1 - η ^ 2) / x := div_nonneg (by linarith) hx0.le
    have hH := hHb _ hZ
    have hxp : 0 < x ^ (-h) := Real.rpow_pos_of_pos hx0 _
    have hpow : x ^ (-1 - h) = x ^ (-h) * x⁻¹ := by
      rw [show (-1 - h) = -h + -1 by ring, Real.rpow_add hx0, Real.rpow_neg_one]
    rw [Real.norm_eq_abs, hm2 x (by linarith), abs_mul, abs_mul, abs_of_nonneg hc,
      abs_of_pos hxp, hpow]
    calc c * (x ^ (-h) * |heatProfile h (2 * (1 - η ^ 2) / x) - 1|)
        ≤ c * (x ^ (-h) * (C * (2 * (1 - η ^ 2) / x))) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hH hxp.le) hc
      _ = c * C * (2 * (1 - η ^ 2)) * (x ^ (-h) * x⁻¹) := by rw [div_eq_mul_inv]; ring
  have hI2 : IntegrableOn m (Ioi (Xb + 1)) := by
    have hp : IntegrableOn (fun x : ℝ => x ^ (-1 - h)) (Ioi (Xb + 1)) :=
      integrableOn_Ioi_rpow_of_lt (by linarith) hR
    exact Integrable.mono' (Integrable.const_mul hp (c * C * (2 * (1 - η ^ 2))))
      (hmc.aestronglyMeasurable measurableSet_Ioi)
      (ae_restrict_of_forall_mem measurableSet_Ioi hbound)

  have hMom' : ∫ x in Ioi (0:ℝ), m x = 0 := by
    rw [hmdef]
    exact (hMom η hη1 hη2).2.2
  have hsplit : (∫ x in Ioc (0:ℝ) (Xb + 1), m x) + (∫ x in Ioi (Xb + 1), m x) = 0 := by
    rw [← setIntegral_union Ioc_disjoint_Ioi_same measurableSet_Ioi hI1 hI2,
      Ioc_union_Ioi_eq_Ioi hR0]
    exact hMom'

  have e1 : (∫ x in Ioc (0:ℝ) (Xb + 1), m x) =
      ∫ x in Ioc (0:ℝ) (Xb + 1), (2 * x * F x η - c * x ^ (-h)) :=
    setIntegral_congr_fun measurableSet_Ioc (fun x hx => hm1 x hx.1)
  have e2 : (∫ x in Ioc (0:ℝ) (Xb + 1), 2 * x * F x η) =
      2 * ∫ x in (0:ℝ)..(Xb + 1), x * F x η := by
    rw [intervalIntegral.integral_of_le hR0, ← integral_const_mul]
    congr 1
    funext x
    ring
  have hI1v : (∫ x in Ioc (0:ℝ) (Xb + 1), m x) =
      2 * (∫ x in (0:ℝ)..(Xb + 1), x * F x η) - c * ((Xb + 1) ^ (1 - h) / (1 - h)) := by
    rw [e1, integral_sub hint1 hrpc, integral_const_mul, hrpv, e2]

  have hI2v : (∫ x in Ioi (Xb + 1), m x) =
      c * ∫ x in Ioi (Xb + 1), x ^ (-h) * (heatProfile h (2 * (1 - η ^ 2) / x) - 1) := by
    rw [← integral_const_mul]
    exact setIntegral_congr_fun measurableSet_Ioi
      (fun x hx => hm2 x (by have := mem_Ioi.mp hx; linarith))

  rw [hI1v, hI2v] at hsplit
  linear_combination hsplit + ((Xb + 1) ^ (1 - h) / (1 - h) -
    ∫ x in Ioi (Xb + 1), x ^ (-h) * (heatProfile h (2 * (1 - η ^ 2) / x) - 1)) * hcdef

theorem lead_compensated_moment : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ), LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → ∀ η : ℝ, -1 < η → η < 1 → (∫ X in Ioi (0:ℝ), X * simZop h (-(1 + h)) F X η) = 0 :=
by
  intro h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hLP η hη1 hη2
  have hLP' := hLP
  unfold LeadingProfile at hLP'
  obtain ⟨⟨hh0, hh1, -, hcinf, -, -, -, hXa, hXap1, hp12, hp2m1, hm12, hm2Xv, hXvXc, hXcXb⟩, -, -, -,
    ⟨ε, hε, hFε, -, -, -⟩, -, hTail, -⟩ := hLP'
  have hXb0 : 0 < Xb := by linarith
  have hR : (0:ℝ) < Xb + 1 := by linarith
  have h1h : (1:ℝ) - h ≠ 0 := by intro h'; linarith
  have ha : 0 < 1 - η ^ 2 := by nlinarith
  have hvan : ∀ X : ℝ, Xb + 1 < X → simZop h (-(1 + h)) F X η = 0 := fun X hX =>
    lead_F_axial_null_ext h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z hLP X η
      (by linarith) hη1 hη2
  obtain ⟨hMd, hred⟩ := zop_first_moment_reduce h (-(1 + h)) ε (Xb + 1) η F hε hR hFε hη1 hη2 hvan
  obtain ⟨hHc, hHb⟩ := heatProfile_near_one h hh0 (by linarith)
  have hC0 : 0 ≤ h * (1 + h) := by positivity
  have hM := lead_tail_moment_formula h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab (h * (1 + h))
    F U T0th T0z hLP hC0 hHb
  have hΦ := tail_scaling_hasDerivAt h (Xb + 1) (h * (1 + h)) (heatProfile h) hh0 (by linarith) hR
    hC0 hHc hHb (1 - η ^ 2) ha
  have hq : HasDerivAt (fun e : ℝ => 1 - e ^ 2) (-(2 * η)) η := by
    convert (hasDerivAt_pow 2 η).const_sub 1 using 1
    norm_num
  have hcomp := ((((hΦ.comp η hq).const_sub ((Xb + 1) ^ (1 - h) / (1 - h))).const_mul
    (Real.sqrt 2 * cinf)).div_const 2)
  have hcongr : (fun e : ℝ => ∫ x in (0:ℝ)..(Xb + 1), x * F x e) =ᶠ[nhds η]
      (fun e : ℝ => Real.sqrt 2 * cinf * ((Xb + 1) ^ (1 - h) / (1 - h) -
        ((fun a' : ℝ => ∫ x in Ioi (Xb + 1), x ^ (-h) * (heatProfile h (2 * a' / x) - 1)) ∘
          (fun e : ℝ => 1 - e ^ 2)) e) / 2) := by
    filter_upwards [Ioo_mem_nhds hη1 hη2] with e he
    have := hM e he.1 he.2
    simp only [Function.comp_apply]
    linarith
  have hD := hMd.unique (hcomp.congr_of_eventuallyEq hcongr)
  have hT := (hTail (Xb + 1) η (by linarith) hη1 hη2).2
  have e1 : Real.sqrt (2 * (Xb + 1)) = Real.sqrt 2 * (Xb + 1) ^ (1 / (2:ℝ)) := by
    rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 2) (Xb + 1), Real.sqrt_eq_rpow (Xb + 1)]
  have e2 : (Xb + 1) * (Xb + 1) ^ (1 / (2:ℝ)) * (Xb + 1) ^ (-(1 / 2 + h)) = (Xb + 1) ^ (1 - h) := by
    calc (Xb + 1) * (Xb + 1) ^ (1 / (2:ℝ)) * (Xb + 1) ^ (-(1 / 2 + h))
        = (Xb + 1) ^ (1:ℝ) * (Xb + 1) ^ (1 / (2:ℝ)) * (Xb + 1) ^ (-(1 / 2 + h)) := by
          rw [Real.rpow_one]
      _ = (Xb + 1) ^ ((1:ℝ) + 1 / 2 + -(1 / 2 + h)) := by
          rw [Real.rpow_add hR, Real.rpow_add hR]
      _ = (Xb + 1) ^ (1 - h) := by congr 1; ring
  have hs : Real.sqrt (2 * (Xb + 1)) * Real.sqrt (2 * (Xb + 1)) = 2 * (Xb + 1) :=
    Real.mul_self_sqrt (by linarith)
  have hB : 2 * (Xb + 1) ^ 2 * F (Xb + 1) η = Real.sqrt 2 * cinf * (Xb + 1) ^ (1 - h) *
      heatProfile h (2 * (1 - η ^ 2) / (Xb + 1)) := by
    calc 2 * (Xb + 1) ^ 2 * F (Xb + 1) η
        = (Xb + 1) * Real.sqrt (2 * (Xb + 1)) * (Real.sqrt (2 * (Xb + 1)) * F (Xb + 1) η) := by
          linear_combination (-((Xb + 1) * F (Xb + 1) η)) * hs
      _ = (Xb + 1) * Real.sqrt (2 * (Xb + 1)) * (cinf * (Xb + 1) ^ (-(1 / 2 + h)) *
            heatProfile h (2 * (1 - η ^ 2) / (Xb + 1))) := by rw [hT]
      _ = Real.sqrt 2 * cinf * ((Xb + 1) * (Xb + 1) ^ (1 / (2:ℝ)) * (Xb + 1) ^ (-(1 / 2 + h))) *
            heatProfile h (2 * (1 - η ^ 2) / (Xb + 1)) := by rw [e1]; ring
      _ = _ := by rw [e2]
  have hM2 := hM η hη1 hη2
  have hM' : (1 - h) * (2 * (∫ x in (0:ℝ)..(Xb + 1), x * F x η)) = Real.sqrt 2 * cinf *
      ((Xb + 1) ^ (1 - h) - (1 - h) *
        ∫ x in Ioi (Xb + 1), x ^ (-h) * (heatProfile h (2 * (1 - η ^ 2) / x) - 1)) := by
    rw [hM2]
    field_simp
  have hD' : (1 - η ^ 2) * (∫ x in (0:ℝ)..(Xb + 1), x * pdE F x η) = Real.sqrt 2 * cinf * η *
      ((1 - h) * (∫ x in Ioi (Xb + 1), x ^ (-h) * (heatProfile h (2 * (1 - η ^ 2) / x) - 1)) +
        (Xb + 1) ^ (1 - h) * (heatProfile h (2 * (1 - η ^ 2) / (Xb + 1)) - 1)) := by
    rw [hD]
    field_simp
  rw [hred]
  have hN : 2 * (-(1 + h) + 2) * η * (∫ x in (0:ℝ)..(Xb + 1), x * F x η) +
      (1 - η ^ 2) * (∫ x in (0:ℝ)..(Xb + 1), x * pdE F x η) -
      2 * η * (Xb + 1) ^ 2 * F (Xb + 1) η = 0 := by
    linear_combination η * hM' + hD' - η * hB
  rw [hN, zero_div]

theorem bg_conservation : ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab ε Xm Xs Xi : ℝ) (F U T0th T0z : ℝ → ℝ → ℝ) (S G W : ℕ → ℝ → ℝ → ℝ) (n : ℕ), SimScaleProps h → LeadingProfile h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab F U T0th T0z → 0 < ε → Xv < Xs → Xs < Xb → 1 ≤ n → BgLower h ε Xm Xs Xi m1 m2 F U S G W n → BgOrdPre h ε Xm Xs Xi m1 m2 S G W n → BgMom S G W n → ∀ η : ℝ, -1 < η → η < 1 → (∫ X in Ioi (0:ℝ), X * bgResTh h S G W n X η) = 0 ∧ (∫ X in Ioi (0:ℝ), bgResZ h S G W n X η) = 0 :=
by

  have bg_pd_smooth : ∀ (h e b : ℝ) (i : ℕ) (f : ℝ → ℝ → ℝ), 0 < h → h < 1 / 2 → 0 < e → ContDiffOn ℝ ∞ (↿f) (Ioi (-e) ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿(pdX f)) (Ioi (-e) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(pdE f)) (Ioi (-e) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(bgUz f)) (Ioi (-e) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(bgVx h i f)) (Ioi (-e) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(simTop h b f)) (Ioi (-e) ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(simZop h b f)) (Ioi (-e) ×ˢ Ioo (-1) 1) := by
    intro h e b i f hh0 hh2 he0 hf
    set O : Set (ℝ × ℝ) := Ioi (-e) ×ˢ Ioo (-1) 1 with hOdef
    have hO : IsOpen O := isOpen_Ioi.prod isOpen_Ioo
    have hD : ContDiffOn ℝ ∞ (fun p => fderiv ℝ (↿f) p) O :=
      hf.fderiv_of_isOpen hO (by simp)
    have hfd : ∀ p ∈ O, HasFDerivAt (↿f) (fderiv ℝ (↿f) p) p := fun p hp =>
      ((hf.contDiffAt (hO.mem_nhds hp)).differentiableAt (by simp)).hasFDerivAt
    have hX : ContDiffOn ℝ ∞ (↿(pdX f)) O := by
      refine (hD.clm_apply (contDiffOn_const (c := ((1:ℝ), (0:ℝ))))).congr ?_
      intro p hp
      have h1 : HasDerivAt (fun Y : ℝ => (Y, p.2)) ((1:ℝ), (0:ℝ)) p.1 :=
        (hasDerivAt_id p.1).prodMk (hasDerivAt_const p.1 p.2)
      have h2 := (hfd p hp).comp_hasDerivAt p.1 h1
      exact h2.deriv
    have hE : ContDiffOn ℝ ∞ (↿(pdE f)) O := by
      refine (hD.clm_apply (contDiffOn_const (c := ((0:ℝ), (1:ℝ))))).congr ?_
      intro p hp
      have h1 : HasDerivAt (fun e' : ℝ => (p.1, e')) ((0:ℝ), (1:ℝ)) p.2 :=
        (hasDerivAt_const p.2 p.1).prodMk (hasDerivAt_id p.2)
      have h2 := (hfd p hp).comp_hasDerivAt p.2 h1
      exact h2.deriv
    have hf' : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => f p.1 p.2) O := hf
    have hX' : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => pdX f p.1 p.2) O := hX
    have hE' : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => pdE f p.1 p.2) O := hE
    have hL : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 1 - 2 * h * p.2 ^ 2) O :=
      contDiffOn_const.sub (contDiffOn_const.mul (contDiffOn_snd.pow 2))
    have hL0 : ∀ p ∈ O, 1 - 2 * h * p.2 ^ 2 ≠ 0 := by
      intro p hp
      obtain ⟨-, h1, h2⟩ := hp
      have : p.2 ^ 2 < 1 := by nlinarith
      nlinarith
    have hU : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => bgUz f p.1 p.2) O :=
      hf'.add (contDiffOn_fst.mul hX')
    refine ⟨hX, hE, hU, ?_, ?_, ?_⟩
    · show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => bgVx h i f p.1 p.2) O
      unfold bgVx
      refine ContDiffOn.div ?_ hL hL0
      exact (((contDiffOn_const.mul contDiffOn_snd).mul hU).sub
        ((contDiffOn_const.mul contDiffOn_snd).mul hf')).sub
        ((contDiffOn_const.sub (contDiffOn_snd.pow 2)).mul hE')
    · show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => simTop h b f p.1 p.2) O
      unfold simTop
      refine ContDiffOn.div ?_ hL hL0
      exact ((contDiffOn_const.mul hf').add ((contDiffOn_const.mul contDiffOn_snd).mul hE')).add
        (contDiffOn_fst.mul hX')
    · show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => simZop h b f p.1 p.2) O
      unfold simZop
      refine ContDiffOn.div ?_ hL hL0
      exact (((contDiffOn_const.mul contDiffOn_snd).mul hf').add
        ((contDiffOn_const.sub (contDiffOn_snd.pow 2)).mul hE')).sub
        (((contDiffOn_const.mul contDiffOn_snd).mul contDiffOn_fst).mul hX')

  have bgVx_incompressible : ∀ (h e : ℝ) (i : ℕ) (S : ℝ → ℝ → ℝ), 0 < h → h < 1 / 2 → 0 < e → ContDiffOn ℝ ∞ (↿S) (Ioi (-e) ×ˢ Ioo (-1) 1) → ∀ X η : ℝ, -e < X → -1 < η → η < 1 → HasDerivAt (fun Y => Y * bgVx h i S Y η) (-simZop h (-(1 / 2 + h) + 2 * (i : ℝ) * h) (bgUz S) X η) X := by
    intro h e i S hh0 hh2 he0 hS X η hX e1 e2
    set O : Set (ℝ × ℝ) := Ioi (-e) ×ˢ Ioo (-1) 1 with hOdef
    have hO : IsOpen O := isOpen_Ioi.prod isOpen_Ioo
    have hp : ((X, η) : ℝ × ℝ) ∈ O := ⟨hX, e1, e2⟩
    have hpx : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) O → ∀ q ∈ O,
        HasDerivAt (fun Y => g Y q.2) (fderiv ℝ (↿g) q ((1:ℝ), (0:ℝ))) q.1 := by
      intro g hg q hq
      have hfd : HasFDerivAt (↿g) (fderiv ℝ (↿g) q) q :=
        ((hg.contDiffAt (hO.mem_nhds hq)).differentiableAt (by simp)).hasFDerivAt
      have h1 : HasDerivAt (fun Y : ℝ => (Y, q.2)) ((1:ℝ), (0:ℝ)) q.1 :=
        (hasDerivAt_id q.1).prodMk (hasDerivAt_const q.1 q.2)
      exact hfd.comp_hasDerivAt q.1 h1
    have hpe : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) O → ∀ q ∈ O,
        HasDerivAt (fun e' => g q.1 e') (fderiv ℝ (↿g) q ((0:ℝ), (1:ℝ))) q.2 := by
      intro g hg q hq
      have hfd : HasFDerivAt (↿g) (fderiv ℝ (↿g) q) q :=
        ((hg.contDiffAt (hO.mem_nhds hq)).differentiableAt (by simp)).hasFDerivAt
      have h1 : HasDerivAt (fun e' : ℝ => (q.1, e')) ((0:ℝ), (1:ℝ)) q.2 :=
        (hasDerivAt_const q.2 q.1).prodMk (hasDerivAt_id q.2)
      exact hfd.comp_hasDerivAt q.2 h1
    have hsx : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) O →
        HasDerivAt (fun Y => g Y η) (pdX g X η) X := by
      intro g hg
      have := hpx g hg (X, η) hp
      unfold pdX
      rw [this.deriv]
      exact this
    have hse : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) O →
        HasDerivAt (fun e' => g X e') (pdE g X η) η := by
      intro g hg
      have := hpe g hg (X, η) hp
      unfold pdE
      rw [this.deriv]
      exact this
    obtain ⟨hSX, hSE, -⟩ := bg_pd_smooth h e 0 0 S hh0 hh2 he0 hS
    have hD : ContDiffOn ℝ ∞ (fun q => fderiv ℝ (↿S) q) O := hS.fderiv_of_isOpen hO (by simp)
    have hD1 : DifferentiableAt ℝ (fun q => fderiv ℝ (↿S) q) (X, η) :=
      (hD.contDiffAt (hO.mem_nhds hp)).differentiableAt (by simp)
    have hsym : IsSymmSndFDerivAt ℝ (↿S) (X, η) :=
      (hS.contDiffAt (hO.mem_nhds hp)).isSymmSndFDerivAt (by simp [minSmoothness_of_isRCLikeNormedField])
    have eE : (↿(pdE S)) =ᶠ[nhds ((X, η) : ℝ × ℝ)] (fun q => fderiv ℝ (↿S) q ((0:ℝ), (1:ℝ))) := by
      filter_upwards [hO.mem_nhds hp] with q hq
      exact (hpe S hS q hq).deriv
    have eX : (↿(pdX S)) =ᶠ[nhds ((X, η) : ℝ × ℝ)] (fun q => fderiv ℝ (↿S) q ((1:ℝ), (0:ℝ))) := by
      filter_upwards [hO.mem_nhds hp] with q hq
      exact (hpx S hS q hq).deriv
    have hmix : pdX (pdE S) X η = pdE (pdX S) X η := by
      rw [(hsx (pdE S) hSE).deriv.symm.trans (hpx (pdE S) hSE (X, η) hp).deriv,
        (hse (pdX S) hSX).deriv.symm.trans (hpe (pdX S) hSX (X, η) hp).deriv,
        eE.fderiv_eq, eX.fderiv_eq, fderiv_clm_apply hD1 (differentiableAt_const _),
        fderiv_clm_apply hD1 (differentiableAt_const _)]
      simp
      exact hsym _ _
    have hA := hsx S hS
    have hB := hsx (pdX S) hSX
    have hC := hsx (pdE S) hSE
    have hAe := hse S hS
    have hBe := hse (pdX S) hSX
    have hUX : pdX (bgUz S) X η = pdX S X η + (1 * pdX S X η + X * pdX (pdX S) X η) :=
      (hA.add ((hasDerivAt_id' X).mul hB)).deriv
    have hUE : pdE (bgUz S) X η = pdE S X η + X * pdE (pdX S) X η :=
      (hAe.add (hBe.const_mul X)).deriv
    have hL0 : 1 - 2 * h * η ^ 2 ≠ 0 := by
      have : η ^ 2 < 1 := by nlinarith
      nlinarith
    have H := (hasDerivAt_id' X).mul
      (((((hA.add ((hasDerivAt_id' X).mul hB)).const_mul (2 * η)).sub
        (hA.const_mul (2 * (1 / 2 - h + 2 * (i : ℝ) * h) * η))).sub
        (hC.const_mul (1 - η ^ 2))).div_const (1 - 2 * h * η ^ 2))
    refine H.congr_deriv ?_
    simp only [Pi.add_apply, Pi.mul_apply, Pi.sub_apply]
    unfold simZop
    rw [hUX, hUE, hmix]
    simp only [bgUz]
    field_simp
    ring

  have bg_pd_vanish : ∀ (h b R : ℝ) (i : ℕ) (f : ℝ → ℝ → ℝ),
      (∀ X η : ℝ, R ≤ X → -1 < η → η < 1 → f X η = 0) → ∀ X η : ℝ, R < X → -1 < η → η < 1 →
      pdX f X η = 0 ∧ pdE f X η = 0 ∧ bgUz f X η = 0 ∧ bgVx h i f X η = 0 ∧
      simTop h b f X η = 0 ∧ simZop h b f X η = 0 := by
    intro h b R i f hf X η hX e1 e2
    have h0 : f X η = 0 := hf X η hX.le e1 e2
    have hx : pdX f X η = 0 := by
      have hev : (fun Y => f Y η) =ᶠ[nhds X] fun _ => (0:ℝ) := by
        filter_upwards [Ioi_mem_nhds hX] with Y hY
        exact hf Y η (le_of_lt hY) e1 e2
      unfold pdX
      rw [hev.deriv_eq]
      simp
    have he : pdE f X η = 0 := by
      have hev : (fun e => f X e) =ᶠ[nhds η] fun _ => (0:ℝ) := by
        filter_upwards [Ioo_mem_nhds e1 e2] with e he
        exact hf X e hX.le he.1 he.2
      unfold pdE
      rw [hev.deriv_eq]
      simp
    have hu : bgUz f X η = 0 := by simp [bgUz, h0, hx]
    refine ⟨hx, he, hu, ?_, ?_, ?_⟩
    · simp [bgVx, hu, h0, he]
    · simp [simTop, h0, he, hx]
    · simp [simZop, h0, he, hx]

  have slice_ftc_zero : ∀ (φ : ℝ → ℝ) (e R : ℝ), 0 < e → 0 < R → ContDiffOn ℝ 1 φ (Ioi (-e)) →
      φ 0 = 0 → (∀ X : ℝ, R ≤ X → φ X = 0) →
      IntegrableOn (fun X => deriv φ X) (Ioi 0) ∧ (∫ X in Ioi (0:ℝ), deriv φ X) = 0 := by
    intro φ e R he hR hφ h0 hv
    have hop : IsOpen (Ioi (-e)) := isOpen_Ioi
    have hcont : ContinuousOn (deriv φ) (Ioi (-e)) :=
      hφ.continuousOn_deriv_of_isOpen hop le_rfl
    have hdiff : ∀ x ∈ Ioi (-e), HasDerivAt φ (deriv φ x) x := fun x hx =>
      (((hφ.differentiableOn (by norm_num)) x hx).differentiableAt (hop.mem_nhds hx)).hasDerivAt
    have hz : ∀ x ∈ Ioi R, deriv φ x = 0 := by
      intro x hx
      have hev : φ =ᶠ[nhds x] fun _ => (0:ℝ) := by
        filter_upwards [Ioi_mem_nhds hx] with Y hY
        exact hv Y (le_of_lt hY)
      rw [hev.deriv_eq]
      simp
    have hsub : Icc (0:ℝ) R ⊆ Ioi (-e) := fun x hx => by
      simp only [mem_Ioi]; linarith [hx.1]
    have hII : IntegrableOn (deriv φ) (Ioc 0 R) :=
      ((hcont.mono hsub).integrableOn_Icc).mono_set Ioc_subset_Icc_self
    have hIR : IntegrableOn (deriv φ) (Ioi R) :=
      (integrableOn_zero).congr_fun (fun x hx => (hz x hx).symm) measurableSet_Ioi
    have hU : Ioc (0:ℝ) R ∪ Ioi R = Ioi 0 := Ioc_union_Ioi_eq_Ioi hR.le
    have hInt : IntegrableOn (deriv φ) (Ioi 0) := by
      rw [← hU]; exact hII.union hIR
    refine ⟨hInt, ?_⟩
    rw [← hU, setIntegral_union (Set.disjoint_left.mpr (fun x h1 h2 => by
        simp only [mem_Ioc, mem_Ioi] at h1 h2; linarith [h1.2])) measurableSet_Ioi hII hIR]
    have h2 : (∫ x in Ioi R, deriv φ x) = 0 := by
      rw [setIntegral_congr_fun measurableSet_Ioi hz]; simp
    rw [h2, add_zero, ← intervalIntegral.integral_of_le hR.le]
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x hx => hdiff x (hsub (by
        rw [uIcc_of_le hR.le] at hx; exact hx)))
      ((hcont.mono hsub).intervalIntegrable_of_Icc hR.le)]
    rw [hv R le_rfl, h0]; ring

  have bg_moment_zero : ∀ (h e R b : ℝ) (p : ℕ) (g : ℝ → ℝ → ℝ), 0 < e → 0 < R → ContDiffOn ℝ ∞ (↿g) (Ioi (-e) ×ˢ Ioo (-1) 1) → (∀ X η : ℝ, R ≤ X → -1 < η → η < 1 → g X η = 0) → (∀ η : ℝ, -1 < η → η < 1 → (∫ X in Ioi (0:ℝ), X ^ p * g X η) = 0) → ∀ η : ℝ, -1 < η → η < 1 → IntegrableOn (fun X => X ^ p * simTop h b g X η) (Ioi 0) ∧ IntegrableOn (fun X => X ^ p * simZop h b g X η) (Ioi 0) ∧ (∫ X in Ioi (0:ℝ), X ^ p * simTop h b g X η) = 0 ∧ (∫ X in Ioi (0:ℝ), X ^ p * simZop h b g X η) = 0 := by
    intro h e R b p g he hR hg hv hm η e1 e2
    set O : Set (ℝ × ℝ) := Ioi (-e) ×ˢ Ioo (-1) 1 with hOdef
    have hO : IsOpen O := isOpen_Ioi.prod isOpen_Ioo
    obtain ⟨hgX, hgE, -⟩ := bg_pd_smooth (1 / 4) e 0 0 g (by norm_num) (by norm_num) he hg
    have hvan : ∀ X η : ℝ, R < X → -1 < η → η < 1 → pdX g X η = 0 ∧ pdE g X η = 0 :=
      fun X η' hX f1 f2 => let H := bg_pd_vanish 0 0 R 0 g hv X η' hX f1 f2; ⟨H.1, H.2.1⟩
    have hat : ∀ q ∈ O, HasDerivAt (fun Y => g Y q.2) (pdX g q.1 q.2) q.1 ∧
        HasDerivAt (fun e' => g q.1 e') (pdE g q.1 q.2) q.2 := by
      intro q hq
      have hfd : HasFDerivAt (↿g) (fderiv ℝ (↿g) q) q :=
        ((hg.contDiffAt (hO.mem_nhds hq)).differentiableAt (by simp)).hasFDerivAt
      have h1 : HasDerivAt (fun Y : ℝ => (Y, q.2)) ((1:ℝ), (0:ℝ)) q.1 :=
        (hasDerivAt_id q.1).prodMk (hasDerivAt_const q.1 q.2)
      have h2 : HasDerivAt (fun e' : ℝ => (q.1, e')) ((0:ℝ), (1:ℝ)) q.2 :=
        (hasDerivAt_const q.2 q.1).prodMk (hasDerivAt_id q.2)
      have k1 := hfd.comp_hasDerivAt q.1 h1
      have k2 := hfd.comp_hasDerivAt q.2 h2
      refine ⟨?_, ?_⟩
      · have : pdX g q.1 q.2 = fderiv ℝ (↿g) q ((1:ℝ), (0:ℝ)) := k1.deriv
        rw [this]; exact k1
      · have : pdE g q.1 q.2 = fderiv ℝ (↿g) q ((0:ℝ), (1:ℝ)) := k2.deriv
        rw [this]; exact k2
    have hIccO : ∀ η' : ℝ, -1 < η' → η' < 1 → ∀ X ∈ Icc (0:ℝ) R, ((X, η') : ℝ × ℝ) ∈ O :=
      fun η' f1 f2 X hX => ⟨show -e < X by linarith [hX.1], f1, f2⟩
    have scont : ∀ f : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿f) O → ∀ η' : ℝ, -1 < η' → η' < 1 →
        ContinuousOn (fun X => f X η') (Icc 0 R) := by
      intro f hf η' f1 f2
      exact hf.continuousOn.comp (continuous_id.prodMk continuous_const).continuousOn
        (fun X hX => hIccO η' f1 f2 X hX)
    have red : ∀ k : ℝ → ℝ, ContinuousOn k (Icc 0 R) → (∀ x ∈ Ioi R, k x = 0) →
        IntegrableOn k (Ioi 0) ∧ (∫ x in Ioi (0:ℝ), k x) = ∫ x in (0:ℝ)..R, k x := by
      intro k hk hz
      have hII : IntegrableOn k (Ioc 0 R) := hk.integrableOn_Icc.mono_set Ioc_subset_Icc_self
      have hIR : IntegrableOn k (Ioi R) :=
        (integrableOn_zero).congr_fun (fun x hx => (hz x hx).symm) measurableSet_Ioi
      have hU : Ioc (0:ℝ) R ∪ Ioi R = Ioi 0 := Ioc_union_Ioi_eq_Ioi hR.le
      refine ⟨by rw [← hU]; exact hII.union hIR, ?_⟩
      rw [← hU, setIntegral_union (Set.disjoint_left.mpr (fun x h1 h2 => by
          simp only [mem_Ioc, mem_Ioi] at h1 h2; linarith [h1.2])) measurableSet_Ioi hII hIR]
      have h2 : (∫ x in Ioi R, k x) = 0 := by
        rw [setIntegral_congr_fun measurableSet_Ioi hz]; simp
      rw [h2, add_zero, intervalIntegral.integral_of_le hR.le]
    have cA : ∀ η' : ℝ, -1 < η' → η' < 1 → ContinuousOn (fun X => X ^ p * g X η') (Icc 0 R) :=
      fun η' f1 f2 => (continuous_pow p).continuousOn.mul (scont g hg η' f1 f2)
    have zA : ∀ η' : ℝ, -1 < η' → η' < 1 → ∀ x ∈ Ioi R, x ^ p * g x η' = 0 :=
      fun η' f1 f2 x hx => by rw [hv x η' (le_of_lt hx) f1 f2, mul_zero]
    have rA := red _ (cA η e1 e2) (zA η e1 e2)
    have mA : ∀ η' : ℝ, -1 < η' → η' < 1 → (∫ x in (0:ℝ)..R, x ^ p * g x η') = 0 :=
      fun η' f1 f2 => (red _ (cA η' f1 f2) (zA η' f1 f2)).2 ▸ hm η' f1 f2
    have cB : ContinuousOn (fun X => X ^ p * pdE g X η) (Icc 0 R) :=
      (continuous_pow p).continuousOn.mul (scont _ hgE η e1 e2)
    have zB : ∀ x ∈ Ioi R, x ^ p * pdE g x η = 0 := fun x hx => by
      rw [(hvan x η hx e1 e2).2, mul_zero]
    have rB := red _ cB zB
    have mB : (∫ x in (0:ℝ)..R, x ^ p * pdE g x η) = 0 := by
      obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = min (η + 1) (1 - η) / 2 := ⟨_, rfl⟩
      have hδ1 : -1 < η - δ := by rw [hδ]; have := min_le_left (η + 1) (1 - η); linarith
      have hδ2 : η + δ < 1 := by rw [hδ]; have := min_le_right (η + 1) (1 - η); linarith
      have hδ0 : 0 < δ := by
        rw [hδ]; have := lt_min (show (0:ℝ) < η + 1 by linarith) (show (0:ℝ) < 1 - η by linarith); linarith
      set K : Set (ℝ × ℝ) := Icc (0:ℝ) R ×ˢ Icc (η - δ) (η + δ) with hK
      have hKO : K ⊆ O := fun q hq => ⟨show -e < q.1 by linarith [hq.1.1],
        show -1 < q.2 by linarith [hq.2.1], show q.2 < 1 by linarith [hq.2.2]⟩
      have hKc : IsCompact K := isCompact_Icc.prod isCompact_Icc
      have hcK : ContinuousOn (fun q : ℝ × ℝ => q.1 ^ p * pdE g q.1 q.2) K :=
        (continuous_fst.pow p).continuousOn.mul (hgE.continuousOn.mono hKO)
      obtain ⟨B0, hB0⟩ := hKc.exists_bound_of_continuousOn hcK
      have hu : uIoc (0:ℝ) R = Ioc 0 R := uIoc_of_le hR.le
      have hs : Ioo (η - δ) (η + δ) ∈ nhds η := Ioo_mem_nhds (by linarith) (by linarith)
      have L := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
        (μ := volume) (a := 0) (b := R) (bound := fun _ => B0)
        (F := fun x t => t ^ p * g t x) (F' := fun x t => t ^ p * pdE g t x) (x₀ := η) hs
        (by
          filter_upwards [Ioo_mem_nhds e1 e2] with x hx
          rw [hu]
          exact ((cA x hx.1 hx.2).mono Ioc_subset_Icc_self).aestronglyMeasurable measurableSet_Ioc)
        ((cA η e1 e2).intervalIntegrable_of_Icc hR.le)
        (by rw [hu]; exact (cB.mono Ioc_subset_Icc_self).aestronglyMeasurable measurableSet_Ioc)
        (Filter.Eventually.of_forall (fun t ht x hx => by
          rw [hu] at ht
          exact hB0 (t, x) ⟨Ioc_subset_Icc_self ht, hx.1.le, hx.2.le⟩))
        intervalIntegrable_const
        (Filter.Eventually.of_forall (fun t ht x hx => by
          rw [hu] at ht
          have hq : ((t, x) : ℝ × ℝ) ∈ O :=
            ⟨show -e < t by linarith [ht.1], show -1 < x by linarith [hx.1], show x < 1 by linarith [hx.2]⟩
