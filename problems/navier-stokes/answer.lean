theorem ax_raw_derivs : ∀ (h Pst : ℝ) (Pax : ℝ → ℝ) (j0 σ δ ρ : ℝ) (Pc : ℂ → ℂ) (r M Λ0 A : ℝ) (χc ζc ℓc zc Ξ : ℂ → ℂ), AxDatum h Pst Pax → 0 < j0 → j0 ≤ 1 / 20 → AxData h j0 σ δ ρ Pc Pax → AxCoefData h j0 σ ρ Pc Pax r M χc ζc ℓc zc Ξ → AxMajor h j0 r Λ0 A χc ζc ℓc zc → ∃ Λ1 : ℝ, ∀ Λ : ℝ, Λ1 ≤ Λ → ∃ Kder : ℕ → ℝ, ∀ C : ℝ, Real.exp (Λ * M) ≤ C →
    let Fn := axFnDef h j0 Λ C χc ζc ℓc zc Ξ
