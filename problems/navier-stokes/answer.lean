      have := hA6 X η hX (by linarith) hs1 hs2
      have e3 : 2 * K * (axChi h j0 σ η + 1 / Λ) = 2 * (K * (axChi h j0 σ η + 1 / Λ)) := by ring
      constructor
      · linarith [this.2.2.1]
      · linarith [this.2.2.2.1]
    · have hm1 : X1 ≤ min X X2 := le_min hXX hX12
      have hm2 : min X X2 ≤ X2 := min_le_right _ _
      have hmpos : 0 < min X X2 := by linarith
      have hf : (fun e => axRefF Λ t1 Fn X e) = fun e => axRefF Λ t1 Fn (min X X2) e :=
        funext fun e => (hcl X e).1
      have hqX : deriv (fun e => axRefF Λ t1 Fn X e) η / axRefF Λ t1 Fn X η =
          deriv (fun e => Real.log (axRefF Λ t1 Fn (min X X2) e)) η := by
        rw [hf, (hcl X η).1, hq _ hmpos]
      have hq1 : deriv (fun e => Real.log (axRefF Λ t1 Fn X1 e)) η =
          deriv (fun e => Fn X1 e) η / Fn X1 η := by
        have hf1 : (fun e => axRefF Λ t1 Fn X1 e) = fun e => Fn X1 e :=
          funext fun e => (hEq X1 e le_rfl).1
        rw [hq X1 hX1pos, hf1, (hEq X1 η le_rfl).1]
      have hT : |deriv (fun e => Real.log (axRefF Λ t1 Fn (min X X2) e)) η -
          deriv (fun e => Real.log (axRefF Λ t1 Fn X1 e)) η| ≤ B * (min X X2 - X1) :=
        eta_deriv_transfer (fun Y e => Real.log (axRefF Λ t1 Fn Y e))
          (fun Y e => deriv (fun Z => Fn Z e) Y / Fn Y e) _
          (fun Y => 1 - sigA ((axLogY Λ Y - t1) / t1)) X1 X2 η B hS
          ((R1.mono hSsub).log (fun p hp => (R3 p.1 p.2 (show (0:ℝ) < p.1 from hp.1).le
            hp.2.1 hp.2.2).ne')) hX12
          (fun Y hy1 _ => Set.mk_mem_prod (show (0:ℝ) < Y by linarith) ⟨hs1, hs2⟩)
          (fun Y e hy1 _ hm => by
            show deriv (fun X => Real.log (axRefF Λ t1 Fn X e)) Y =
              (1 - sigA ((axLogY Λ Y - t1) / t1)) * (deriv (fun Z => Fn Z e) Y / Fn Y e)
            have hYp : 0 < Y := by linarith
            have he1 : -1 - ρ1 < e := hm.2.1
            have he2 : e < 1 + ρ1 := hm.2.2
            have hFr := R3 Y e hYp.le he1 he2
            have hFn : 0 < Fn Y e := hA3 Y e hYp.le (by linarith) he1 he2
            rw [((slice_deriv_facts (axRefF Λ t1 Fn) _ Y e hOR R1
              (memOR Y e hYp.le he1 he2)).1.log hFr.ne').deriv]
            have hR := (R6 Y e hYp he1 he2).1
            field_simp
            have : Y * deriv (fun Y => axRefF Λ t1 Fn Y e) Y * Fn Y e =
                (1 - sigA ((axLogY Λ Y - t1) / t1)) * (Y * deriv (fun Y => Fn Y e) Y) *
                  axRefF Λ t1 Fn Y e := by
              rw [hR]; field_simp
            apply mul_left_cancel₀ hYp.ne'
            linear_combination this)
          (fun Y _ _ => hsabs Y)
          (fun Y hy1 hy2 => by
            show |deriv (fun e => deriv (fun Z => Fn Z e) Y / Fn Y e) η| ≤ B
            have hk := (hKB Y η (by linarith) (by linarith) hs1 hs2).2.2.2.2
            have ha : Kder 2 * Kder 0 ≤ |Kder 2| * |Kder 0| := by
              rw [← abs_mul]; exact le_abs_self _
            rw [← sq_abs (Kder 1), ← sq_abs (Kder 0)] at hk
            rw [hB]; linarith)
          (min X X2) hm1 hm2
      rw [hq1] at hT
      have hbd : B * (min X X2 - X1) ≤ 16 * (B * t1) / Λ := by
        calc B * (min X X2 - X1) ≤ B * (16 * t1 / Λ) := mul_le_mul_of_nonneg_left (by linarith) hB0
          _ = 16 * (B * t1) / Λ := by ring
      rw [hqX]
      have hA := hA6 X1 η hX1pos (by linarith) hs1 hs2
      exact arith _ _ _ _ hA.2.2.2.1 hA.2.2.1 (le_trans hT hbd) hH5
  exact ⟨hU0, hU1, hF0.1, hF0.2, fun hX => ⟨(hMon1 X hX).1, (hMon1 X hX).2, (hF1cd hX).1,
    (hF1cd hX).2⟩⟩

theorem ax_p1_lower : ∀ (h ε : ℝ) (Pax : ℝ → ℝ) (F U : ℝ → ℝ → ℝ) (η X s0 : ℝ), 0 < h → h < 1 / 2 → 0 < ε → ContDiffOn ℝ ∞ (↿F) (Ioi (-ε) ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿U) (Ioi (-ε) ×ˢ Ioo (-1) 1) → (∀ X η : ℝ, 0 ≤ X → -1 < η → η < 1 → 0 < F X η) → ContDiffOn ℝ ∞ Pax (Ioo (-1) 1) → -1 < η → η < 1 → 0 < X → 0 ≤ s0 → (∀ x : ℝ, 0 < x → x ≤ X → deriv (fun Y => F Y η) x ≤ 0) → (∀ x : ℝ, 0 < x → x ≤ X → s0 ≤ axSq h F U x η) → s0 * X / 2 ≤ psLead1 h F U X η :=
by
  intro h ε Pax F U η X s0 hh0 hh1 hε hF hU hFpos hPax hη1 hη2 hX hs0 hdF hSq
  have hSo : IsOpen (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo

  have hpdE : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) →
      ContDiffOn ℝ ∞ (↿(profEtaD g)) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
    intro g hg
    obtain ⟨hd, hG'⟩ := (contDiffOn_infty_iff_fderiv_of_isOpen hSo).1 hg
    refine (hG'.clm_apply (contDiffOn_const (c := ((0:ℝ), (1:ℝ))))).congr ?_
    intro p hp
    have hhas : HasFDerivAt (↿g) (fderiv ℝ (↿g) p) (p.1, p.2) :=
      ((hd p hp).differentiableAt (hSo.mem_nhds hp)).hasFDerivAt
    have hc : HasDerivAt (fun e : ℝ => (p.1, e)) ((0:ℝ), (1:ℝ)) p.2 :=
      (hasDerivAt_const p.2 p.1).prodMk (hasDerivAt_id' p.2)
    exact (hhas.comp_hasDerivAt p.2 hc).deriv

  have hrad : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) →
      ContDiffOn ℝ ∞ (↿(profRadInt g)) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
    intro g hg
    obtain ⟨hA, -, hId⟩ := profRadAvg_props g ε hε hg
    refine (contDiffOn_fst.mul hA).congr ?_
    intro p hp
    exact ((hId p.1 p.2 hp.1 hp.2.1 hp.2.2).1).symm
  have g2 : ContDiffOn ℝ ∞ (↿(fun x e : ℝ => 2 * x * F x e)) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 2 * p.1 * F p.1 p.2) _
    exact (contDiffOn_const.mul contDiffOn_fst).mul hF
  have g3 : ContDiffOn ℝ ∞ (↿(fun x e : ℝ => U x e * (2 * x * F x e)))
      (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
    show ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => U p.1 p.2 * (2 * p.1 * F p.1 p.2)) _
    exact hU.mul ((contDiffOn_const.mul contDiffOn_fst).mul hF)
  have a := (profRadAvg_props U ε hε hU).1
  have a' := hpdE _ a
  have I := hrad _ g2
  have I' := hpdE _ I
  have J := hrad _ g3
  have J' := hpdE _ J

  obtain ⟨Gf, hGfdef⟩ : ∃ Gf : ℝ × ℝ → ℝ, Gf = fun p : ℝ × ℝ =>
      -(1 - 2 * (1 / 2 - h) * p.2 * profRadAvg U p.1 p.2
        - (1 - p.2 ^ 2) * profEtaD (profRadAvg U) p.1 p.2) * (p.1 * (2 * p.1 * F p.1 p.2)) +
      ((1 - h) * profRadInt (fun x e => 2 * x * F x e) p.1 p.2
        - (1 / 2 - h) * p.2 * profEtaD (profRadInt (fun x e => 2 * x * F x e)) p.1 p.2
        - (1 - p.2 ^ 2) * profEtaD (profRadInt (fun x e => U x e * (2 * x * F x e))) p.1 p.2
        + 2 * (h - (1 / 2 - h)) * p.2 * profRadInt (fun x e => U x e * (2 * x * F x e)) p.1 p.2) :=
    ⟨_, rfl⟩
  have hG : ContDiffOn ℝ ∞ Gf (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := by
    have hW : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => 1 - 2 * (1 / 2 - h) * p.2 * profRadAvg U p.1 p.2
        - (1 - p.2 ^ 2) * profEtaD (profRadAvg U) p.1 p.2) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) :=
      (contDiffOn_const.sub ((contDiffOn_const.mul contDiffOn_snd).mul a)).sub
        ((contDiffOn_const.sub (contDiffOn_snd.pow 2)).mul a')
