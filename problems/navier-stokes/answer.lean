  obtain ⟨Fa, hFa⟩ : ∃ F : (ℝ × ℝ × ℝ × ℝ) × ℝ → ℝ, ∀ w, F w =
      w.1.1 * (1 + ts w.1 ^ 2 + s w.1 ^ 2) / (1 + (ts w.1 + s w.1 * Dn w.1 (θ w.1 w.2)) ^ 2) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨Fb, hFb⟩ : ∃ F : (ℝ × ℝ × ℝ × ℝ) × ℝ → ℝ, ∀ w, F w =
      -(ts w.1 + s w.1 * Dn w.1 (θ w.1 w.2)) * Fa w := ⟨_, fun _ => rfl⟩
  have hFa' : ∀ (p : ℝ × ℝ × ℝ × ℝ) (φ : ℝ), Fa (p, φ) =
      p.1 * (1 + ts p ^ 2 + s p ^ 2) / (1 + (ts p + s p * Dn p (θ p φ)) ^ 2) :=
