theorem ax_step_holo : ∀ (h j0 Λ r : ℝ) (χ ζ ℓ z g : ℂ → ℂ) (pv : ℕ → (ℂ → ℂ) × (ℂ → ℂ)) (n : ℕ), 0 < r → DifferentiableOn ℂ χ (axRect r) → DifferentiableOn ℂ ζ (axRect r) → DifferentiableOn ℂ ℓ (axRect r) → DifferentiableOn ℂ z (axRect r) → DifferentiableOn ℂ g (axRect r) → (∀ m ≤ n, DifferentiableOn ℂ (pv m).1 (axRect r) ∧ DifferentiableOn ℂ (pv m).2 (axRect r)) → DifferentiableOn ℂ (axRecStep h j0 Λ χ ζ ℓ z g pv n).1 (axRect r) ∧ DifferentiableOn ℂ (axRecStep h j0 Λ χ ζ ℓ z g pv n).2 (axRect r) :=
by
  intro h j0 Λ r χ ζ ℓ z g pv n _hr hχ hζ hℓ hz hg hpv
