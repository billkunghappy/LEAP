      e * (n 0 ζ * n 0 ζ + n 1 ζ * n 1 ζ + n 2 ζ * n 2 ζ) * (if a = b then (1:ℝ) else 0) := ⟨_, rfl⟩

  have hid : ∀ (ζ : Cyl) (a b : Fin 3),
      pulseAr5 B G γ m ζ a b = (1 - (m:ℝ) ^ 2) * E 0 a b ζ + (m:ℝ) ^ 2 * E ek a b ζ := by
    intro ζ a b
    simp only [hE, hn, hPs, hP, hK, hek, pulseAr5, APhi5, dDamp5, Matrix.sub_apply, Matrix.add_apply,
