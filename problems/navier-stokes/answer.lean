          ∫ Y in (Set.Icc (0:ℝ) 1 ×ˢ Set.Icc (0:ℝ) 1), (φ Y : ℂ) * E Y := by
      rw [fub2 _ (hPc _), fub2 _ hFc, ← MeasureTheory.integral_const_mul]
