  have hBvc : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => B.BvB w.1 w.2.1)
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} := hBvBs.comp hpr.contDiffOn hprm
  have hPBc : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ × (ℝ × ℝ) => B.PB w.1 w.2.1)
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} := hPBs.comp hpr.contDiffOn hprm
  have hBXeq : ∀ p ∈ {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1},
      BX B G l0 S p.1 p.2.1 p.2.2 = B.BvB p.1 p.2.1 +
        (simScale B.h (p.1 2) (1 - p.2.1) ^ (-Aex B.h) * S.bdir (ptOf p.1 p.2.1 p.2.2)) • eTh p.1 := by
    intro p hp
    have hw : corrOn B l0 p.1 p.2.1 := hp
    change B.BvB p.1 p.2.1 + _ = _
    rw [if_pos hw]
    all_goals rfl
  have hBXs : ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => B.BvB p.1 p.2.1 +
        (simScale B.h (p.1 2) (1 - p.2.1) ^ (-Aex B.h) * S.bdir (ptOf p.1 p.2.1 p.2.2)) • eTh p.1)
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} :=
    hBvc.add (((hQp (-Aex B.h)).mul (c4.1.comp hσ hσm)).smul heThΩ)
  have hC2 : ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => uX5 B G l0 S p.1 p.2.1 p.2.2)
      {p | corrOn B l0 p.1 p.2.1} := by
    refine (hCur.add hBXs).congr (fun p hp => ?_)
    show curlX B.h (AX5 B G l0 S) p.1 p.2.1 p.2.2 + BX B G l0 S p.1 p.2.1 p.2.2 = _
    rw [hcurl p hp, hBXeq p hp]

  obtain ⟨HP, -, hHP⟩ := c2.1
  have hWp : ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) =>
      waveS5 B G S.pw (thetaOf p.1) (ptOf p.1 p.2.1 p.2.2)) {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} :=
    (hwS S.pw ⟨HP, hHP⟩ c2.2.1 c2.2.2.2.1).comp hτ hτm
  have hPeq : ∀ p ∈ {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1},
      PX5 B G l0 S p.1 p.2.1 p.2.2 = B.PB p.1 p.2.1 +
        (pmP5 B G l0 S (ptOf p.1 p.2.1 p.2.2) +
          simScale B.h (p.1 2) (1 - p.2.1) ^ (-2 * Aex B.h) *
            waveS5 B G S.pw (thetaOf p.1) (ptOf p.1 p.2.1 p.2.2)) := by
    intro p hp
    have hw : corrOn B l0 p.1 p.2.1 := hp
    change B.PB p.1 p.2.1 + _ = _
    rw [if_pos hw]
    all_goals rfl
  have hC3 : ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => PX5 B G l0 S p.1 p.2.1 p.2.2)
      {p | corrOn B l0 p.1 p.2.1} :=
    (hPBc.add ((hpm.comp hσ hσm).add ((hQp (-2 * Aex B.h)).mul hWp))).congr hPeq

  obtain ⟨HV, -, hHV⟩ := c16.1
  have hofR : ∀ (f : Cyl → ℝ) (s : Set Cyl), ContDiffOn ℝ ∞ f s →
      ContDiffOn ℝ ∞ (fun ξ => ((f ξ : ℝ) : ℂ)) s := fun f s hf =>
    (Complex.ofRealCLM.contDiff.comp_contDiffOn hf).congr
      (fun ξ _ => by simp only [Function.comp_apply, Complex.ofRealCLM_apply])
  have hgO : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η ^ (-B.h)) {ξ : Cyl | ξ.2.2.1 < 1} :=
    hqC.rpow_const_of_ne (fun ξ hξ => (hqposO ξ hξ).ne')
  have hdg : ContDiffOn ℝ ∞ (fun ξ : Cyl => dZ (fun η => qC B.h η ^ (-B.h)) ξ) {ξ : Cyl | ξ.2.2.1 < 1} := by
    have h1 := ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hgO).2
    have h2 : ContDiffOn ℝ ∞ (fun ξ : Cyl => fderiv ℝ (fun η : Cyl => qC B.h η ^ (-B.h)) ξ
        ((0:ℝ), (1:ℝ), (0:ℝ), (0 : ℝ × ℝ))) {ξ : Cyl | ξ.2.2.1 < 1} :=
      h1.clm_apply contDiffOn_const
    exact h2.congr (fun ξ _ => rfl)
  have hVcomp : ∀ (γ : Lab) (m : ℤ) (i : Fin 3),
      ContDiffOn ℝ ∞ (fun ξ => VwT5 B G S γ m ξ i) (DomC B.h (qsOf l0)) := by
    intro γ m i
    have hc1 : ContDiffOn ℝ ∞ (fun ξ : Cyl => (((qC B.h ξ ^ (-B.h) * Qb γ.1 ^ (-(1/2:ℝ))) : ℝ) : ℂ))
        (DomC B.h (qsOf l0)) :=
      hofR _ _ ((hgO.mono hDO).mul contDiffOn_const)
    have hc2 : ContDiffOn ℝ ∞ (fun ξ : Cyl => ((dZ (fun η => qC B.h η ^ (-B.h)) ξ : ℝ) : ℂ))
        (DomC B.h (qsOf l0)) :=
      hofR _ _ (hdg.mono hDO)
    have hvel : ContDiffOn ℝ ∞ (fun ξ => velC5 B G S.Aw γ m ξ i) (DomC B.h (qsOf l0)) :=
      contDiffOn_pi.mp (c16.2.1 γ m) i
    have hA : ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun ξ => S.Aw γ m ξ j) (DomC B.h (qsOf l0)) :=
      fun j => contDiffOn_pi.mp (c1.2.1 γ m) j
    have hvec : ContDiffOn ℝ ∞ (fun ξ => (![-(S.Aw γ m ξ 1), S.Aw γ m ξ 0, 0] : Fin 3 → ℂ) i)
        (DomC B.h (qsOf l0)) := by
      fin_cases i
      · exact (hA 1).neg.congr (fun ξ _ => rfl)
      · exact (hA 0).congr (fun ξ _ => rfl)
      · exact contDiffOn_const.congr (fun ξ _ => rfl)
    refine ((hc1.mul hvel).add (hc2.mul hvec)).congr (fun ξ _ => ?_)
    simp only [VwT5, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  have hVH : ∀ (i : Fin 3) (γ : Lab) (m : ℤ), m ∉ HA ∪ HV → (fun ξ => VwT5 B G S γ m ξ i) = 0 := by
    intro i γ m hm
    have h1 : S.Aw γ m = 0 := hHA γ m (fun h => hm (Finset.mem_union_left _ h))
    have h2 : velW5 B G S.Aw γ m = 0 := hHV γ m (fun h => hm (Finset.mem_union_right _ h))
    funext ξ
    have h1' : S.Aw γ m ξ = 0 := congrFun h1 ξ
    have h2' : velC5 B G S.Aw γ m ξ = 0 := congrFun h2 ξ
    fin_cases i <;> simp [VwT5, h1', h2']
  have hVS : ∀ (i : Fin 3) (γ : Lab) (m : ℤ) (ξ : Cyl), ξ ∈ DomC B.h (qsOf l0) →
      VwT5 B G S γ m ξ i ≠ 0 → SuppW B G γ ξ := by
    intro i γ m ξ hξ hne
    by_contra hns
    apply hne
    have h1' : S.Aw γ m ξ = 0 := by
      by_contra h
      exact hns (c1.2.2.2.1 γ m ξ hξ h)
    have h2' : velC5 B G S.Aw γ m ξ = 0 := by
      by_contra h
      exact hns (c16.2.2.2.1 γ m ξ hξ h)
    fin_cases i <;> simp [VwT5, h1', h2']
  have hWV : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) =>
      waveV5 B G (VwT5 B G S) (thetaOf p.1) (ptOf p.1 p.2.1 p.2.2) i)
      {w : ℝ³ × ℝ × (ℝ × ℝ) | corrOn B l0 w.1 w.2.1} := by
    intro i
    have h := hwS (fun γ m ξ => VwT5 B G S γ m ξ i) ⟨HA ∪ HV, hVH i⟩ (fun γ m => hVcomp γ m i) (hVS i)
    exact (h.comp hτ hτm).congr (fun p _ => rfl)
  have hC4 : ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) =>
      cyl2cart p.1 (waveV5 B G (VwT5 B G S) (thetaOf p.1) (ptOf p.1 p.2.1 p.2.2)))
      {p | corrOn B l0 p.1 p.2.1} :=
    ((((hWV 0).smul heRΩ).add ((hWV 1).smul heThΩ)).add
      ((hWV 2).smul (contDiffOn_const (c := eZ)))).congr (fun p _ => rfl)
  exact ⟨hC1, hC2, hC3, hC4⟩

theorem twg5_increment_fields : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (α : ℝ) (dPsi dv : Cyl → ℝ), B.ok → InM B (qsOf l0) α dPsi → InM B (qsOf l0) α dv → (∀ (t : ℝ) (Y₀ : ℝ × ℝ) (x : ℝ³), corrOn B l0 x t → DifferentiableAt ℝ (fun y => AX5 B G l0 S y t (Yph B.h (rad y) t + Y₀)) x) → ∀ (Y₀ : ℝ × ℝ) (x : ℝ³) (t : ℝ), corrOn B l0 x t → evOff B.h (uX5 B G l0 (momUpd S dPsi dv)) Y₀ x t = evOff B.h (uX5 B G l0 S) Y₀ x t + evOff B.h (DXm5 B l0 dPsi dv) Y₀ x t ∧ evOff B.h (PX5 B G l0 (momUpd S dPsi dv)) Y₀ x t = evOff B.h (PX5 B G l0 S) Y₀ x t + (pmP5 B G l0 (momUpd S dPsi dv) (ptOf x t (Yph B.h (rad x) t + Y₀)) - pmP5 B G l0 S (ptOf x t (Yph B.h (rad x) t + Y₀))) :=
by
  intro B G l0 S α dPsi dv hok hPsi _hdv hA Y₀ x t hc
  have hr : 0 < rad x := hc.1
  have ht : t < 1 := hc.2.1
  have hr0 : rad x ≠ 0 := hr.ne'
  have hs : 0 < x 0 ^ 2 + x 1 ^ 2 := Real.sqrt_pos.mp hr
  have hr2 : rad x ^ 2 = x 0 ^ 2 + x 1 ^ 2 := Real.sq_sqrt hs.le
  have hu : (rad x)⁻¹ * rad x = 1 := inv_mul_cancel₀ hr0
  have hpj : ∀ i : Fin 3, HasFDerivAt (fun y : ℝ³ => y i) (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ) x := by
    intro i
    have := (EuclideanSpace.proj i : ℝ³ →L[ℝ] ℝ).hasFDerivAt (x := x)
    exact this

  obtain ⟨R', hR, hR0, hR1, hR2⟩ : ∃ R' : ℝ³ →L[ℝ] ℝ, HasFDerivAt rad R' x ∧
      R' (EuclideanSpace.single 0 1) = x 0 / rad x ∧ R' (EuclideanSpace.single 1 1) = x 1 / rad x ∧
      R' (EuclideanSpace.single 2 1) = 0 := by
    have hq := (((hpj 0).pow 2).add ((hpj 1).pow 2)).sqrt hs.ne'
    refine ⟨_, hq, ?_, ?_, ?_⟩
    · simp [rad]
      field_simp
    · simp [rad]
      field_simp
    · simp

  have hSC : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) := hok.1.2.2.2.1
  have hmemO : (univ ×ˢ Ioi (0:ℝ) : Set (ℝ × ℝ)) ∈ nhds ((x 2, 1 - t) : ℝ × ℝ) :=
    (isOpen_univ.prod isOpen_Ioi).mem_nhds ⟨mem_univ _, show (0:ℝ) < 1 - t by linarith⟩
  have hout : DifferentiableAt ℝ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) ((x 2, 1 - t) : ℝ × ℝ) :=
    (hSC.contDiffAt hmemO).differentiableAt (by norm_num)
  have hin : HasFDerivAt (fun y : ℝ³ => ((y 2, 1 - t) : ℝ × ℝ))
      ((EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).prod 0) x :=
    (hpj 2).prodMk (hasFDerivAt_const _ _)
  have hq : ContinuousAt (fun y : ℝ³ => simScale B.h (y 2) (1 - t)) x := by
    have := DifferentiableAt.comp x hout hin.differentiableAt
    exact this.continuousAt

  have hN : ∀ᶠ y in nhds x, corrOn B l0 y t := by
    filter_upwards [Filter.Tendsto.eventually_const_lt hr hR.continuousAt,
      Filter.Tendsto.eventually_lt_const hc.2.2 hq] with y h1 h2
    exact ⟨h1, ht, h2⟩

  have hinC : DifferentiableAt ℝ (fun ζ' : Cyl => ((ζ'.2.1, 1 - ζ'.2.2.1) : ℝ × ℝ))
      (ptOf x t (Yph B.h (rad x) t + Y₀)) := by fun_prop
  have hqC : DifferentiableAt ℝ (qC B.h) (ptOf x t (Yph B.h (rad x) t + Y₀)) := by
    have := hout.comp (ptOf x t (Yph B.h (rad x) t + Y₀)) hinC
    exact this
  have hqpos : 0 < qC B.h (ptOf x t (Yph B.h (rad x) t + Y₀)) :=
    (hok.1.1 (x 2) (1 - t) (by linarith)).1
  have hDom : DomC B.h (qsOf l0) ∈ nhds (ptOf x t (Yph B.h (rad x) t + Y₀)) := by
    have h1 : ∀ᶠ ζ' in nhds (ptOf x t (Yph B.h (rad x) t + Y₀)), 0 < ζ'.1 :=
      Filter.Tendsto.eventually_const_lt hr continuous_fst.continuousAt
    have h2 : ∀ᶠ ζ' in nhds (ptOf x t (Yph B.h (rad x) t + Y₀)), ζ'.2.2.1 < 1 :=
      Filter.Tendsto.eventually_lt_const ht
        (by fun_prop : Continuous fun ζ' : Cyl => ζ'.2.2.1).continuousAt
    have h3 : ∀ᶠ ζ' in nhds (ptOf x t (Yph B.h (rad x) t + Y₀)), qC B.h ζ' < qsOf l0 :=
      Filter.Tendsto.eventually_lt_const hc.2.2 hqC.continuousAt
    filter_upwards [h1, h2, h3] with ζ' a b c
    exact ⟨a, b, c⟩
  have hgd : DifferentiableAt ℝ (momPsP B dPsi) (ptOf x t (Yph B.h (rad x) t + Y₀)) := by
    have hdP : DifferentiableAt ℝ dPsi (ptOf x t (Yph B.h (rad x) t + Y₀)) :=
      (hPsi.1.contDiffAt hDom).differentiableAt (by norm_num)
    have hpow : DifferentiableAt ℝ (fun ξ => qC B.h ξ ^ (1/2 - Aex B.h))
        (ptOf x t (Yph B.h (rad x) t + Y₀)) :=
      hqC.rpow_const (Or.inl hqpos.ne')
    exact hpow.mul hdP

  have key : DifferentiableAt ℝ (fun y => momPsP B dPsi (ptOf y t (Yph B.h (rad y) t + Y₀)) • eTh y) x ∧
      curl3 (fun y => momPsP B dPsi (ptOf y t (Yph B.h (rad y) t + Y₀)) • eTh y) x =
        (-(dZ (momPsP B dPsi) (ptOf x t (Yph B.h (rad x) t + Y₀)))) • eR x +
        (dR B.h (momPsP B dPsi) (ptOf x t (Yph B.h (rad x) t + Y₀)) +
          momPsP B dPsi (ptOf x t (Yph B.h (rad x) t + Y₀)) / rad x) • eZ := by
    generalize momPsP B dPsi = g at hgd ⊢
    have hinv : HasFDerivAt (fun y => (rad y)⁻¹)
        ((ContinuousLinearMap.toSpanSingleton ℝ (-(rad x ^ 2)⁻¹)).comp R') x :=
      (hasFDerivAt_inv hr0).comp x hR
    have haz : HasFDerivAt azVec
        ((-(EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ)).smulRight (EuclideanSpace.single (0 : Fin 3) (1:ℝ)) +
          (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).smulRight (EuclideanSpace.single (1 : Fin 3) (1:ℝ))) x := by
      have := ((hpj 1).neg.smul_const (EuclideanSpace.single (0 : Fin 3) (1:ℝ))).add
        ((hpj 0).smul_const (EuclideanSpace.single (1 : Fin 3) (1:ℝ)))
      convert this using 1
      funext y
      simp [azVec]
    have heTh : HasFDerivAt eTh _ x := hinv.fun_smul haz
    obtain ⟨P', hP'⟩ : ∃ P' : ℝ³ →L[ℝ] Cyl, P' = R'.prod ((EuclideanSpace.proj (2 : Fin 3) : ℝ³ →L[ℝ] ℝ).prod
        ((0 : ℝ³ →L[ℝ] ℝ).prod (((drx B.h * rad x ^ (drx B.h - 1)) • R').smulRight vrv))) := ⟨_, rfl⟩
    have hP : HasFDerivAt (fun y => ptOf y t (Yph B.h (rad y) t + Y₀)) P' x := by
      have := hR.prodMk ((hpj 2).prodMk ((hasFDerivAt_const t x).prodMk
        ((((hR.rpow_const (p := drx B.h) (Or.inl hr0)).smul_const vrv).add_const (t • vtv)).add_const Y₀)))
      rw [hP']
      exact this
    obtain ⟨Φ', hΦ'⟩ : ∃ Φ' : ℝ³ →L[ℝ] ℝ,
        Φ' = (fderiv ℝ g (ptOf x t (Yph B.h (rad x) t + Y₀))).comp P' := ⟨_, rfl⟩
    have hΦ : HasFDerivAt (fun y => g (ptOf y t (Yph B.h (rad y) t + Y₀))) Φ' x := by
      rw [hΦ']
      exact hgd.hasFDerivAt.comp x hP
    have hz : Φ' (EuclideanSpace.single 2 1) = dZ g (ptOf x t (Yph B.h (rad x) t + Y₀)) := by
      rw [hΦ', ContinuousLinearMap.comp_apply]
      unfold dZ
      congr 1
      rw [hP']
      simp [hR2]
    have hS : x 0 * (x 0 / rad x) + x 1 * (x 1 / rad x) = rad x := by
      have e : x 0 * (x 0 / rad x) + x 1 * (x 1 / rad x) = (x 0 ^ 2 + x 1 ^ 2) / rad x := by ring
      rw [e, ← hr2, pow_two, mul_div_assoc, div_self hr0, mul_one]
    have hcmb : x 0 * Φ' (EuclideanSpace.single 0 1) + x 1 * Φ' (EuclideanSpace.single 1 1) =
        rad x * dR B.h g (ptOf x t (Yph B.h (rad x) t + Y₀)) := by
      have e1 : x 0 * Φ' (EuclideanSpace.single 0 1) + x 1 * Φ' (EuclideanSpace.single 1 1) =
          Φ' (x 0 • EuclideanSpace.single 0 1 + x 1 • EuclideanSpace.single 1 1) := by
        simp only [map_add, map_smul, smul_eq_mul]
      have e2 : P' (x 0 • EuclideanSpace.single 0 1 + x 1 • EuclideanSpace.single 1 1) =
          rad x • ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * rad x ^ (drx B.h - 1)) • vrv) := by
        rw [hP']
        simp only [map_add, map_smul]
        ext
        · simp [hR0, hR1]; linear_combination hS
        · simp
        · simp
        · simp [hR0, hR1]; linear_combination (drx B.h * rad x ^ (drx B.h - 1) * vrv.1) * hS
        · simp [hR0, hR1]; linear_combination (drx B.h * rad x ^ (drx B.h - 1) * vrv.2) * hS
      rw [e1, hΦ', ContinuousLinearMap.comp_apply, e2, map_smul, smul_eq_mul]
      rfl
    refine ⟨(hΦ.fun_smul heTh).differentiableAt, ?_⟩
    have hD := (hΦ.fun_smul heTh).fderiv
    unfold curl3
    rw [hD]
    ext i
    fin_cases i
    · simp [eR, eTh, eZ, azVec, radVec, hR0, hR1, hR2, hz]
    · simp [eR, eTh, eZ, azVec, radVec, hR0, hR1, hR2, hz]
    · simp [eR, eTh, eZ, azVec, radVec, hR0, hR1, hR2]
      linear_combination (rad x)⁻¹ * hcmb +
        (dR B.h g (ptOf x t (Yph B.h (rad x) t + Y₀)) -
          g (ptOf x t (Yph B.h (rad x) t + Y₀)) * (rad x)⁻¹ * (1 + (rad x)⁻¹ * rad x)) * hu +
        g (ptOf x t (Yph B.h (rad x) t + Y₀)) * (rad x)⁻¹ ^ 3 * hr2
  obtain ⟨hΔd, hΔc⟩ := key

  have hV2 : ∀ y, corrOn B l0 y t → AX5 B G l0 (momUpd S dPsi dv) y t (Yph B.h (rad y) t + Y₀) =
      AX5 B G l0 S y t (Yph B.h (rad y) t + Y₀) +
        momPsP B dPsi (ptOf y t (Yph B.h (rad y) t + Y₀)) • eTh y := by
    intro y hy
    simp only [AX5, if_pos hy, momUpd, momPsP, add_smul, smul_add, smul_smul]
    abel
  have hev : (fun y => AX5 B G l0 (momUpd S dPsi dv) y t (Yph B.h (rad y) t + Y₀)) =ᶠ[nhds x]
      (fun y => AX5 B G l0 S y t (Yph B.h (rad y) t + Y₀) +
        momPsP B dPsi (ptOf y t (Yph B.h (rad y) t + Y₀)) • eTh y) :=
    hN.mono (fun y hy => hV2 y hy)
  have hcurlX : ∀ T : CState, curlX B.h (AX5 B G l0 T) x t (Yph B.h (rad x) t + Y₀) =
      curl3 (fun y => AX5 B G l0 T y t (Yph B.h (rad y) t + Y₀)) x := by
    intro T
    show curl3 (fun y => evOff B.h (AX5 B G l0 T) (Yph B.h (rad x) t + Y₀ - Yph B.h (rad x) t) y t) x = _
    rw [add_sub_cancel_left]
    rfl
  have hcc : curl3 (fun y => AX5 B G l0 (momUpd S dPsi dv) y t (Yph B.h (rad y) t + Y₀)) x =
      curl3 (fun y => AX5 B G l0 S y t (Yph B.h (rad y) t + Y₀) +
        momPsP B dPsi (ptOf y t (Yph B.h (rad y) t + Y₀)) • eTh y) x := by
    unfold curl3
    rw [hev.fderiv_eq]
  have hsplit : curl3 (fun y => AX5 B G l0 S y t (Yph B.h (rad y) t + Y₀) +
        momPsP B dPsi (ptOf y t (Yph B.h (rad y) t + Y₀)) • eTh y) x =
      curl3 (fun y => AX5 B G l0 S y t (Yph B.h (rad y) t + Y₀)) x +
      curl3 (fun y => momPsP B dPsi (ptOf y t (Yph B.h (rad y) t + Y₀)) • eTh y) x := by
    unfold curl3
    rw [fderiv_fun_add (hA t Y₀ x hc) hΔd]
    first
      | (simp only [ContinuousLinearMap.add_apply, PiLp.add_apply]; module)
      | (ext i; fin_cases i <;> simp <;> ring)
  have hBX : BX B G l0 (momUpd S dPsi dv) x t (Yph B.h (rad x) t + Y₀) =
      BX B G l0 S x t (Yph B.h (rad x) t + Y₀) +
        momDvP B dv (ptOf x t (Yph B.h (rad x) t + Y₀)) • eTh x := by
    simp only [BX, if_pos hc, momUpd, momDvP, mul_add, add_smul]
    abel
  have hDX : DXm5 B l0 dPsi dv x t (Yph B.h (rad x) t + Y₀) =
      cyl2cart x (dUM5 B dPsi dv (ptOf x t (Yph B.h (rad x) t + Y₀))) := by
    simp only [DXm5, if_pos hc]
  have hcyl : cyl2cart x (dUM5 B dPsi dv (ptOf x t (Yph B.h (rad x) t + Y₀))) =
      (-(dZ (momPsP B dPsi) (ptOf x t (Yph B.h (rad x) t + Y₀)))) • eR x +
        momDvP B dv (ptOf x t (Yph B.h (rad x) t + Y₀)) • eTh x +
      (dR B.h (momPsP B dPsi) (ptOf x t (Yph B.h (rad x) t + Y₀)) +
          momPsP B dPsi (ptOf x t (Yph B.h (rad x) t + Y₀)) / rad x) • eZ := rfl
  refine ⟨?_, ?_⟩
  · show curlX B.h (AX5 B G l0 (momUpd S dPsi dv)) x t (Yph B.h (rad x) t + Y₀) +
        BX B G l0 (momUpd S dPsi dv) x t (Yph B.h (rad x) t + Y₀) =
      (curlX B.h (AX5 B G l0 S) x t (Yph B.h (rad x) t + Y₀) +
        BX B G l0 S x t (Yph B.h (rad x) t + Y₀)) + DXm5 B l0 dPsi dv x t (Yph B.h (rad x) t + Y₀)
    rw [hcurlX, hcurlX, hcc, hsplit, hΔc, hBX, hDX, hcyl]
    abel
  · show PX5 B G l0 (momUpd S dPsi dv) x t (Yph B.h (rad x) t + Y₀) =
      PX5 B G l0 S x t (Yph B.h (rad x) t + Y₀) + _
    simp only [PX5, if_pos hc, momUpd]
    ring

theorem mwh5_wave_velocity_rep : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (S : CState) (bw ca cm cd : ℝ), StOrd5 B G l0 S bw ca cm cd → (∀ ξ₀ ∈ DomC B.h (qsOf l0), ∃ (U : Set Cyl) (Γ : Finset Lab), IsOpen U ∧ ξ₀ ∈ U ∧ ∀ ξ ∈ U, ∀ γ, γ ∉ Γ → ¬ SuppW B G γ ξ) → ∀ x t Y, corrOn B l0 x t → wX5 B G l0 S x t Y = cyl2cart x (waveV5 B G (VwT5 B G S) (thetaOf x) (ptOf x t Y)) :=
by
  intro B G hok hG
  obtain ⟨l1, hsplit⟩ := wmo_velocity_split_v5 B G hok hG
  refine ⟨l1, fun l0 hl0 S bw ca cm cd hSt hLF x t Y hxt => ?_⟩
  have hSt' := hSt
  unfold StOrd5 at hSt'
  obtain ⟨c1, -, c3, c4, -, -, -, -, -, -, -, -, -, -, -, c16, -⟩ := hSt'
  have hξ : ptOf x t Y ∈ DomC B.h (qsOf l0) := ⟨hxt.1, hxt.2.1, hxt.2.2⟩
  have hq : 0 < qC B.h (ptOf x t Y) :=
    (hok.1.1 (ptOf x t Y).2.1 (1 - (ptOf x t Y).2.2.1) (by linarith [hξ.2.1])).1

  have hFc : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2)
      ((ptOf x t Y).2.1, 1 - (ptOf x t Y).2.2.1) :=
    hok.1.2.2.2.1.contDiffAt ((isOpen_univ.prod isOpen_Ioi).mem_nhds
      ⟨Set.mem_univ _, show (0:ℝ) < 1 - (ptOf x t Y).2.2.1 by linarith [hξ.2.1]⟩)
  have hqd : DifferentiableAt ℝ (qC B.h) (ptOf x t Y) := by
    have hg : DifferentiableAt ℝ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) (ptOf x t Y) := by
      fun_prop
    have hcomp : DifferentiableAt ℝ ((fun w : ℝ × ℝ => simScale B.h w.1 w.2) ∘
        (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ))) (ptOf x t Y) :=
      DifferentiableAt.comp (ptOf x t Y) (hFc.differentiableAt (by simp)) hg
    exact hcomp
  have hF := hqd.hasFDerivAt
  have hd1 : dZ (fun η => qC B.h η ^ (-B.h)) (ptOf x t Y) =
      (-B.h * qC B.h (ptOf x t Y) ^ (-B.h - 1)) * dZ (qC B.h) (ptOf x t Y) := by
    unfold dZ
    rw [(hF.rpow_const (p := -B.h) (Or.inl hq.ne')).fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hd2 : dZ (fun η => Real.log (qC B.h η)) (ptOf x t Y) =
      (qC B.h (ptOf x t Y))⁻¹ * dZ (qC B.h) (ptOf x t Y) := by
    unfold dZ
    rw [(hF.log hq.ne').fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hA : qC B.h (ptOf x t Y) ^ (-Aex B.h) * qC B.h (ptOf x t Y) ^ (1/2:ℝ) =
      qC B.h (ptOf x t Y) ^ (-B.h) := by
    rw [← Real.rpow_add hq]
    congr 1
    unfold Aex
    ring
  have hcoef : ∀ (γ : Lab) (m : ℤ) (i : Fin 3),
      ((qC B.h (ptOf x t Y) ^ (-Aex B.h) : ℝ) : ℂ) * wmoAmp5 B G S.Aw γ m (ptOf x t Y) i =
        VwT5 B G S γ m (ptOf x t Y) i := by
    intro γ m i
    have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
    have e1 : ((qC B.h (ptOf x t Y) ^ (-Aex B.h) : ℝ) : ℂ) *
        (((qC B.h (ptOf x t Y) / Qb γ.1) ^ (1/2:ℝ) : ℝ) : ℂ) =
        ((qC B.h (ptOf x t Y) ^ (-B.h) * Qb γ.1 ^ (-(1/2:ℝ)) : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul]
      congr 1
      rw [Real.div_rpow hq.le hQ.le, Real.rpow_neg hQ.le, div_eq_mul_inv, ← mul_assoc, hA]
    have e2 : ((qC B.h (ptOf x t Y) ^ (-Aex B.h) : ℝ) : ℂ) *
        ((B.h * qC B.h (ptOf x t Y) ^ (1/2:ℝ) * dZ (fun η => Real.log (qC B.h η)) (ptOf x t Y) : ℝ) : ℂ) =
        -((dZ (fun η => qC B.h η ^ (-B.h)) (ptOf x t Y) : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul, ← Complex.ofReal_neg]
      congr 1
      rw [hd1, hd2, Real.rpow_sub_one hq.ne']
      calc qC B.h (ptOf x t Y) ^ (-Aex B.h) *
            (B.h * qC B.h (ptOf x t Y) ^ (1/2:ℝ) * ((qC B.h (ptOf x t Y))⁻¹ * dZ (qC B.h) (ptOf x t Y)))
          = B.h * (qC B.h (ptOf x t Y) ^ (-Aex B.h) * qC B.h (ptOf x t Y) ^ (1/2:ℝ)) *
              (qC B.h (ptOf x t Y))⁻¹ * dZ (qC B.h) (ptOf x t Y) := by ring
        _ = _ := by rw [hA]; ring
    have hw : ∀ c : Fin 3 → ℂ, (![-(c 1), c 0, 0] : Fin 3 → ℂ) i = -(rotC c i) := by
      intro c
      fin_cases i <;> simp [rotC]
    simp only [wmoAmp5, VwT5, velW5, Pi.add_apply, Pi.smul_apply, smul_eq_mul, hw]
    linear_combination (velC5 B G S.Aw γ m (ptOf x t Y) i) * e1 + (rotC (S.Aw γ m (ptOf x t Y)) i) * e2
  have hwave : ∀ (θ : ℝ) (i : Fin 3),
      qC B.h (ptOf x t Y) ^ (-Aex B.h) * waveV5 B G (wmoAmp5 B G S.Aw) θ (ptOf x t Y) i =
        waveV5 B G (VwT5 B G S) θ (ptOf x t Y) i := by
    intro θ i
    simp only [waveV5]
    rw [← Complex.re_ofReal_mul, mul_finsum]
    congr 1
    refine finsum_congr (fun γ => ?_)
    rw [mul_finsum]
    refine finsum_congr (fun m => ?_)
    rw [← mul_assoc, hcoef γ m i]

  obtain ⟨H1, h0H1, hH1⟩ := c1.1
  obtain ⟨H2, h0H2, hH2⟩ := c16.1
  obtain ⟨U, Γ, -, hξU, hΓ⟩ := hLF (ptOf x t Y) hξ
  have hH0 : (0:ℤ) ∉ H1 ∪ H2 := by
    rw [Finset.mem_union]
    rintro (h | h)
    · exact h0H1 h
    · exact h0H2 h
  have hAw0 : ∀ γ m, (m ∉ H1 ∪ H2 ∨ γ ∉ Γ) → S.Aw γ m (ptOf x t Y) = 0 := by
    intro γ m h
    rcases h with h | h
    · have hm : m ∉ H1 := fun hm => h (Finset.mem_union_left _ hm)
      exact congrFun (hH1 γ m hm) _
    · by_contra hne
      exact hΓ (ptOf x t Y) hξU γ h (c1.2.2.2.1 γ m (ptOf x t Y) hξ hne)
  have hvel0 : ∀ γ m, (m ∉ H1 ∪ H2 ∨ γ ∉ Γ) → velW5 B G S.Aw γ m (ptOf x t Y) = 0 := by
    intro γ m h
    rcases h with h | h
    · have hm : m ∉ H2 := fun hm => h (Finset.mem_union_right _ hm)
      exact congrFun (hH2 γ m hm) _
    · by_contra hne
      exact hΓ (ptOf x t Y) hξU γ h (c16.2.2.2.1 γ m (ptOf x t Y) hξ hne)
  have hV0 : ∀ γ m (i : Fin 3), (m ∉ H1 ∪ H2 ∨ γ ∉ Γ) → VwT5 B G S γ m (ptOf x t Y) i = 0 := by
    intro γ m i h
    have e1 := hAw0 γ m h
    have e2 : velC5 B G S.Aw γ m (ptOf x t Y) = 0 := hvel0 γ m h
    fin_cases i <;> simp [VwT5, e1, e2]

  have hpint : ∀ γ : Lab, pint5 B G γ ≠ 0 := by
    intro γ
    unfold pint5
    split_ifs with h
    · exact one_ne_zero
    · exact h
  have hgen : ∀ (s : Finset (Lab × ℤ)) (c : Lab × ℤ → ℂ) (k : Lab × ℤ → ℤ), (∀ i ∈ s, k i ≠ 0) →
      Continuous (fun θ : ℝ => (∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))).re) ∧
      ∫ θ in (0:ℝ)..(2 * Real.pi),
        (∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))).re = 0 := by
    intro s c k hk
    have hcont : ∀ i, Continuous (fun θ : ℝ => c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))) :=
      fun i => continuous_const.mul (Complex.continuous_exp.comp
        (continuous_const.mul Complex.continuous_ofReal))
    have hF : Continuous (fun θ : ℝ => ∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))) :=
      continuous_finsetSum _ (fun i _ => hcont i)
    refine ⟨Complex.continuous_re.comp hF, ?_⟩
    have h1 : ∫ θ in (0:ℝ)..(2 * Real.pi),
          (∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))).re =
        (∫ θ in (0:ℝ)..(2 * Real.pi),
          ∑ i ∈ s, c i * Complex.exp (Complex.I * (k i : ℂ) * (θ : ℂ))).re := by
      have := ContinuousLinearMap.intervalIntegral_comp_comm Complex.reCLM
        (hF.intervalIntegrable (μ := MeasureTheory.volume) 0 (2 * Real.pi))
      simpa only [Complex.reCLM_apply] using this
    rw [h1, intervalIntegral.integral_finsetSum (fun i _ => (hcont i).intervalIntegrable _ _)]
    rw [Finset.sum_eq_zero, Complex.zero_re]
    intro i hi
    rw [intervalIntegral.integral_const_mul]
    have hw : Complex.I * (k i : ℂ) ≠ 0 :=
      mul_ne_zero Complex.I_ne_zero (Int.cast_ne_zero.mpr (hk i hi))
    rw [integral_exp_mul_complex hw]
    have e2 : Complex.I * (k i : ℂ) * ((2 * Real.pi : ℝ) : ℂ) =
        (k i : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
      push_cast
      ring
    rw [e2, Complex.exp_int_mul_two_pi_mul_I]
    simp
  have hfin : ∀ (θ' : ℝ) (i : Fin 3), waveV5 B G (VwT5 B G S) θ' (ptOf x t Y) i =
      (∑ p ∈ Γ ×ˢ (H1 ∪ H2), VwT5 B G S p.1 p.2 (ptOf x t Y) i *
        ephase5 B G p.1 p.2 θ' (ptOf x t Y)).re := by
    intro θ' i
    simp only [waveV5]
    congr 1
    have hin : ∀ γ : Lab, ∑ᶠ m : ℤ, VwT5 B G S γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) =
        ∑ m ∈ H1 ∪ H2, VwT5 B G S γ m (ptOf x t Y) i * ephase5 B G γ m θ' (ptOf x t Y) := by
      intro γ
      apply finsum_eq_sum_of_support_subset
      intro m hm
      by_contra hmH
      exact (Function.mem_support.mp hm)
        (by rw [hV0 γ m i (Or.inl (fun h => hmH (Finset.mem_coe.mpr h))), zero_mul])
    rw [finsum_congr hin, finsum_eq_sum_of_support_subset (s := Γ)]
    · exact (Finset.sum_product Γ (H1 ∪ H2) (fun p : Lab × ℤ =>
        VwT5 B G S p.1 p.2 (ptOf x t Y) i * ephase5 B G p.1 p.2 θ' (ptOf x t Y))).symm
    · intro γ hγ
      by_contra hγT
      apply Function.mem_support.mp hγ
      exact Finset.sum_eq_zero (fun m _ => by
        rw [hV0 γ m i (Or.inr (fun h => hγT (Finset.mem_coe.mpr h))), zero_mul])
  have hk : ∀ p ∈ Γ ×ˢ (H1 ∪ H2), p.2 * pint5 B G p.1 ≠ 0 := by
    intro p hp
    have hp2 : p.2 ∈ H1 ∪ H2 := (Finset.mem_product.mp hp).2
    have hne : p.2 ≠ 0 := fun h => hH0 (h ▸ hp2)
    exact mul_ne_zero hne (hpint p.1)
  have hfun : ∀ i : Fin 3, (fun θ : ℝ => waveV5 B G (VwT5 B G S) θ (ptOf x t Y) i) = fun θ : ℝ =>
      (∑ p ∈ Γ ×ˢ (H1 ∪ H2), (VwT5 B G S p.1 p.2 (ptOf x t Y) i * Complex.exp (Complex.I * (p.2 : ℂ) *
        ((kb B.h p.1.1 : ℂ) * (phiL5 B G p.1 (ptOf x t Y) : ℂ)))) *
        Complex.exp (Complex.I * ((p.2 * pint5 B G p.1 : ℤ) : ℂ) * (θ : ℂ))).re := by
    intro i
    funext θ
    rw [hfin]
    congr 1
    apply Finset.sum_congr rfl
    intro p _
    unfold ephase5
    rw [mul_assoc _ (Complex.exp _) (Complex.exp _), ← Complex.exp_add]
    congr 2
    push_cast
    ring
  have hVw : ∀ i : Fin 3, Continuous (fun θ : ℝ => waveV5 B G (VwT5 B G S) θ (ptOf x t Y) i) ∧
      ∫ θ in (0:ℝ)..(2 * Real.pi), waveV5 B G (VwT5 B G S) θ (ptOf x t Y) i = 0 := by
    intro i
    rw [hfun i]
    exact hgen _ _ (fun p => p.2 * pint5 B G p.1) hk

  have hrep : ∀ (θ : ℝ) (a : Fin 3), ucyl5 B G l0 S θ (ptOf x t Y) a =
      ucyl5 B G l0 (wmoBase S) 0 (ptOf x t Y) a + waveV5 B G (VwT5 B G S) θ (ptOf x t Y) a := by
    intro θ a
    rw [(hsplit l0 hl0 S S.Aw S.pw 1 1 c1 c1 c3 c4 (ptOf x t Y) hξ θ a).1, hwave θ a]
  have hmean : ∀ a : Fin 3, thA (fun θ => ucyl5 B G l0 S θ (ptOf x t Y) a) =
      ucyl5 B G l0 (wmoBase S) 0 (ptOf x t Y) a := by
    intro a
    have hfe : (fun θ => ucyl5 B G l0 S θ (ptOf x t Y) a) = fun θ =>
        ucyl5 B G l0 (wmoBase S) 0 (ptOf x t Y) a + waveV5 B G (VwT5 B G S) θ (ptOf x t Y) a :=
      funext (fun θ => hrep θ a)
    have hpi : (2 * Real.pi) ≠ 0 := by positivity
    unfold thA
    rw [hfe, intervalIntegral.integral_add (continuous_const.intervalIntegrable _ _)
      ((hVw a).1.intervalIntegrable _ _), intervalIntegral.integral_const, (hVw a).2, add_zero,
      smul_eq_mul, sub_zero, ← mul_assoc, inv_mul_cancel₀ hpi, one_mul]

  have hr : 0 < rad x := hxt.1
  have hn : ‖(⟨x 0, x 1⟩ : ℂ)‖ = rad x := by
    rw [Complex.norm_def, Complex.normSq_apply]
    show Real.sqrt (x 0 * x 0 + x 1 * x 1) = Real.sqrt (x 0 ^ 2 + x 1 ^ 2)
    ring_nf
  have hc : rad x * Real.cos (thetaOf x) = x 0 := by
    have h := Complex.norm_mul_cos_arg (⟨x 0, x 1⟩ : ℂ)
    rw [hn] at h
    exact h
  have hs : rad x * Real.sin (thetaOf x) = x 1 := by
    have h := Complex.norm_mul_sin_arg (⟨x 0, x 1⟩ : ℂ)
    rw [hn] at h
    exact h
  have hrot : rotPt (rad x) (thetaOf x) (x 2) = x := by
    ext j
    fin_cases j <;> simp [rotPt, hc, hs]
  have hr2 : rad x ^ 2 = x 0 ^ 2 + x 1 ^ 2 := Real.sq_sqrt (by positivity)
  have hinv : (rad x)⁻¹ ^ 2 * (x 0 ^ 2 + x 1 ^ 2) = 1 := by
    rw [← hr2]
    field_simp
  have hrec : ∀ v : ℝ³, cyl2cart x (fun a => inner ℝ v ((![eR x, eTh x, eZ] : Fin 3 → ℝ³) a)) = v := by
    intro v
    ext j
    fin_cases j
    · simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three]
      linear_combination (v 0) * hinv
    · simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three]
      linear_combination (v 1) * hinv
    · simp [cyl2cart, eR, eTh, eZ, radVec, azVec, PiLp.inner_apply, Fin.sum_univ_three]
  have hu : uX5 B G l0 S x t Y = cyl2cart x (fun a => ucyl5 B G l0 S (thetaOf x) (ptOf x t Y) a) := by
    have hfe : (fun a => ucyl5 B G l0 S (thetaOf x) (ptOf x t Y) a) =
        fun a => inner ℝ (uX5 B G l0 S x t Y) ((![eR x, eTh x, eZ] : Fin 3 → ℝ³) a) := by
      funext a
      show inner ℝ (uX5 B G l0 S (rotPt (rad x) (thetaOf x) (x 2)) t Y)
        ((![eR (rotPt (rad x) (thetaOf x) (x 2)), eTh (rotPt (rad x) (thetaOf x) (x 2)), eZ] :
          Fin 3 → ℝ³) a) = _
      rw [hrot]
    rw [hfe, hrec]
  have hav : thAvgVec (uX5 B G l0 S) x t Y =
      cyl2cart x (fun a => thA (fun θ => ucyl5 B G l0 S θ (ptOf x t Y) a)) := rfl
  have hfinal : wX5 B G l0 S x t Y = uX5 B G l0 S x t Y - thAvgVec (uX5 B G l0 S) x t Y := rfl
  rw [hfinal, hav, hu]
  simp only [hmean]
  simp only [hrep]
  simp only [cyl2cart, add_smul]
  abel

theorem rotZ_facts : ∀ α : ℝ, (∀ y, rad (rotZ α y) = rad y) ∧ (∀ y, rotZ α y 2 = y 2) ∧
    (∀ y, rotZ (-α) (rotZ α y) = y) ∧ (∀ u v, rotZ α (u + v) = rotZ α u + rotZ α v) ∧
    (∀ (c : ℝ) u, rotZ α (c • u) = c • rotZ α u) ∧
    (∀ u v, inner ℝ (rotZ α u) (rotZ α v) = (inner ℝ u v : ℝ)) ∧
    (∀ y, eR (rotZ α y) = rotZ α (eR y)) ∧ (∀ y, eTh (rotZ α y) = rotZ α (eTh y)) ∧ rotZ α eZ = eZ ∧
    (∀ r z, rotPt r α z = rotZ α (rotPt r 0 z)) ∧
    (∀ y, 0 < rad y → ∀ n : ℤ, Complex.exp (Complex.I * (n : ℂ) * (thetaOf (rotZ α y) : ℂ)) =
      Complex.exp (Complex.I * (n : ℂ) * (α : ℂ)) * Complex.exp (Complex.I * (n : ℂ) * (thetaOf y : ℂ))) :=
by
  intro α
  have hcs : Real.cos α ^ 2 + Real.sin α ^ 2 = 1 := Real.cos_sq_add_sin_sq α
  have hc0 : ∀ (β : ℝ) (y : ℝ³), rotZ β y 0 = Real.cos β * y 0 - Real.sin β * y 1 := by
    intro β y; simp [rotZ]
  have hc1 : ∀ (β : ℝ) (y : ℝ³), rotZ β y 1 = Real.sin β * y 0 + Real.cos β * y 1 := by
    intro β y; simp [rotZ]
  have hc2 : ∀ (β : ℝ) (y : ℝ³), rotZ β y 2 = y 2 := by
    intro β y; simp [rotZ]
  have hext : ∀ u v : ℝ³, u 0 = v 0 → u 1 = v 1 → u 2 = v 2 → u = v := by
    intro u v h0 h1 h2
    ext i
    fin_cases i
    · exact h0
    · exact h1
    · exact h2
  have hinner : ∀ u v : ℝ³, (inner ℝ u v : ℝ) = u 0 * v 0 + u 1 * v 1 + u 2 * v 2 := by
    intro u v
    simp [PiLp.inner_apply, Fin.sum_univ_three]
    ring
  have hrad : ∀ y, rad (rotZ α y) = rad y := by
    intro y
    unfold rad
    rw [hc0, hc1]
    congr 1
    linear_combination (y 0 ^ 2 + y 1 ^ 2) * hcs
  have hsm : ∀ (c : ℝ) u, rotZ α (c • u) = c • rotZ α u := by
    intro c u
    apply hext <;> simp [hc0, hc1, hc2] <;> ring
  refine ⟨hrad, hc2 α, ?_, ?_, hsm, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro y
    apply hext
    · rw [hc0, hc0, hc1, Real.cos_neg, Real.sin_neg]
      linear_combination y 0 * hcs
    · rw [hc1, hc0, hc1, Real.cos_neg, Real.sin_neg]
      linear_combination y 1 * hcs
    · rw [hc2, hc2]
  · intro u v
    apply hext <;> simp [hc0, hc1, hc2] <;> ring
  · intro u v
    rw [hinner, hinner, hc0, hc0, hc1, hc1, hc2, hc2]
    linear_combination (u 0 * v 0 + u 1 * v 1) * hcs
  · intro y
    have hv : radVec (rotZ α y) = rotZ α (radVec y) := by
      apply hext <;> simp [radVec, hc0, hc1, hc2]
    unfold eR
    rw [hrad, hv, hsm]
  · intro y
    have hv : azVec (rotZ α y) = rotZ α (azVec y) := by
      apply hext <;> simp [azVec, hc0, hc1, hc2] <;> ring
    unfold eTh
    rw [hrad, hv, hsm]
  · apply hext <;> simp [eZ, hc0, hc1, hc2]
  · intro r z
    apply hext <;> simp [rotPt, hc0, hc1, hc2] <;> ring
  · intro y hy n
    have hw : (⟨y 0, y 1⟩ : ℂ) ≠ 0 := by
      intro h
      have h0 : y 0 = 0 := congrArg Complex.re h
      have h1 : y 1 = 0 := congrArg Complex.im h
      simp [rad, h0, h1] at hy
    have hrot : (⟨rotZ α y 0, rotZ α y 1⟩ : ℂ) =
        Complex.exp ((α : ℂ) * Complex.I) * (⟨y 0, y 1⟩ : ℂ) := by
      apply Complex.ext
      · simp only [Complex.mul_re, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im, hc0]
      · simp only [Complex.mul_im, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im, hc1]
        ring
    have key : ∀ w : ℂ, w ≠ 0 →
        Complex.exp ((Complex.arg (Complex.exp ((α : ℂ) * Complex.I) * w) : ℂ) * Complex.I) =
          Complex.exp ((α : ℂ) * Complex.I) * Complex.exp ((Complex.arg w : ℂ) * Complex.I) := by
      intro w hw0
      have hu : ‖Complex.exp ((α : ℂ) * Complex.I)‖ = 1 := Complex.norm_exp_ofReal_mul_I α
      have hn : ‖Complex.exp ((α : ℂ) * Complex.I) * w‖ = ‖w‖ := by
        rw [norm_mul, hu, one_mul]
      have h1 := Complex.norm_mul_exp_arg_mul_I (Complex.exp ((α : ℂ) * Complex.I) * w)
      have h2 := Complex.norm_mul_exp_arg_mul_I w
      rw [hn] at h1
      have hw' : ((‖w‖ : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr hw0)
      apply mul_left_cancel₀ hw'
      rw [h1]
      calc Complex.exp ((α : ℂ) * Complex.I) * w
          = Complex.exp ((α : ℂ) * Complex.I) *
              ((‖w‖ : ℂ) * Complex.exp ((Complex.arg w : ℂ) * Complex.I)) := by rw [h2]
        _ = (‖w‖ : ℂ) * (Complex.exp ((α : ℂ) * Complex.I) *
              Complex.exp ((Complex.arg w : ℂ) * Complex.I)) := by ring
    have hthR : thetaOf (rotZ α y) =
        Complex.arg (Complex.exp ((α : ℂ) * Complex.I) * (⟨y 0, y 1⟩ : ℂ)) := by
      unfold thetaOf
      rw [hrot]
    have hth : thetaOf y = Complex.arg (⟨y 0, y 1⟩ : ℂ) := rfl
    rw [hthR, hth]
    have e : ∀ x : ℂ, Complex.I * (n : ℂ) * x = (n : ℂ) * (x * Complex.I) := fun x => by ring
    rw [e, e, e, Complex.exp_int_mul, Complex.exp_int_mul, Complex.exp_int_mul, key _ hw, mul_zpow]

theorem thp_ns_equivariant : ∀ (O : Set (ℝ³ × ℝ)) (v D : ℝ³ → ℝ → ℝ³) (q : ℝ³ → ℝ → ℝ), IsOpen O → (∀ (α : ℝ) (y : ℝ³) (s : ℝ), (y, s) ∈ O → (rotZ α y, s) ∈ O) → ContDiffOn ℝ ∞ (↿v) O → ContDiffOn ℝ ∞ (↿D) O → ContDiffOn ℝ ∞ (↿q) O → (∀ (α : ℝ) (y : ℝ³) (s : ℝ), (y, s) ∈ O → v (rotZ α y) s = rotZ α (v y s)) → (∀ (α : ℝ) (y : ℝ³) (s : ℝ), (y, s) ∈ O → D (rotZ α y) s = rotZ α (D y s)) → (∀ (α : ℝ) (y : ℝ³) (s : ℝ), (y, s) ∈ O → q (rotZ α y) s = q y s) → ∀ (α : ℝ) (y : ℝ³) (s : ℝ), (y, s) ∈ O → nsResidual 1 D q (rotZ α y) s + fderiv ℝ (fun w => v w s) (rotZ α y) (D (rotZ α y) s) + fderiv ℝ (fun w => D w s) (rotZ α y) (v (rotZ α y) s) = rotZ α (nsResidual 1 D q y s + fderiv ℝ (fun w => v w s) y (D y s) + fderiv ℝ (fun w => D w s) y (v y s)) :=
by
  intro O v D q hO _hOinv _hvs hDs _hqs hvR hDR hqR α y s hys

  have hc0 : ∀ (β : ℝ) (y : ℝ³), rotZ β y 0 = Real.cos β * y 0 - Real.sin β * y 1 := by
    intro β y; simp [rotZ]
  have hc1 : ∀ (β : ℝ) (y : ℝ³), rotZ β y 1 = Real.sin β * y 0 + Real.cos β * y 1 := by
    intro β y; simp [rotZ]
  have hc2 : ∀ (β : ℝ) (y : ℝ³), rotZ β y 2 = y 2 := by
    intro β y; simp [rotZ]
  have hext : ∀ u v : ℝ³, u 0 = v 0 → u 1 = v 1 → u 2 = v 2 → u = v := by
    intro u v h0 h1 h2
    ext i
    fin_cases i
    · exact h0
    · exact h1
    · exact h2
  have hinner : ∀ u v : ℝ³, (inner ℝ u v : ℝ) = u 0 * v 0 + u 1 * v 1 + u 2 * v 2 := by
    intro u v
    simp [PiLp.inner_apply, Fin.sum_univ_three]
    ring
  have Finv : ∀ (β : ℝ) (w : ℝ³), rotZ (-β) (rotZ β w) = w := by
    intro β w
    have hcs : Real.cos β ^ 2 + Real.sin β ^ 2 = 1 := Real.cos_sq_add_sin_sq β
    apply hext
    · rw [hc0, hc0, hc1, Real.cos_neg, Real.sin_neg]
      linear_combination w 0 * hcs
    · rw [hc1, hc0, hc1, Real.cos_neg, Real.sin_neg]
      linear_combination w 1 * hcs
    · rw [hc2, hc2]
  have F3 : ∀ w, rotZ (-α) (rotZ α w) = w := Finv α
  have F3' : ∀ w, rotZ α (rotZ (-α) w) = w := by
    intro w
    have := Finv (-α) w
    rwa [neg_neg] at this
  have F4 : ∀ u w : ℝ³, rotZ α (u + w) = rotZ α u + rotZ α w := by
    intro u w
    apply hext <;> simp [hc0, hc1, hc2] <;> ring
  have F5 : ∀ (c : ℝ) (u : ℝ³), rotZ α (c • u) = c • rotZ α u := by
    intro c u
    apply hext <;> simp [hc0, hc1, hc2] <;> ring
  have F6 : ∀ u w : ℝ³, inner ℝ (rotZ α u) (rotZ α w) = (inner ℝ u w : ℝ) := by
    intro u w
    have hcs : Real.cos α ^ 2 + Real.sin α ^ 2 = 1 := Real.cos_sq_add_sin_sq α
    rw [hinner, hinner, hc0, hc0, hc1, hc1, hc2, hc2]
    linear_combination (u 0 * w 0 + u 1 * w 1) * hcs
  let L : ℝ³ ≃ₗ[ℝ] ℝ³ :=
    { toFun := rotZ α
      invFun := rotZ (-α)
      map_add' := F4
      map_smul' := fun c u => by rw [RingHom.id_apply]; exact F5 c u
      left_inv := F3
      right_inv := F3' }
  let R : ℝ³ ≃ₗᵢ[ℝ] ℝ³ := L.isometryOfInner (fun a b => F6 a b)
  have hv' : ∀ w r, (w, r) ∈ O → v (R w) r = R (v w r) := fun w r h => hvR α w r h
  have hD' : ∀ w r, (w, r) ∈ O → D (R w) r = R (D w r) := fun w r h => hDR α w r h
  have hq' : ∀ w r, (w, r) ∈ O → q (R w) r = q w r := fun w r h => hqR α w r h
  show nsResidual 1 D q (R y) s + fderiv ℝ (fun w => v w s) (R y) (D (R y) s) +
      fderiv ℝ (fun w => D w s) (R y) (v (R y) s) =
    R (nsResidual 1 D q y s + fderiv ℝ (fun w => v w s) y (D y s) +
      fderiv ℝ (fun w => D w s) y (v y s))

  have hN : IsOpen {w : ℝ³ | (w, s) ∈ O} :=
    hO.preimage (Continuous.prodMk continuous_id continuous_const)
  have hT : IsOpen {r : ℝ | (y, r) ∈ O} :=
    hO.preimage (Continuous.prodMk continuous_const continuous_id)
  have eD : (fun w => D (R w) s) =ᶠ[nhds y] (fun w => R (D w s)) :=
    Filter.eventuallyEq_of_mem (hN.mem_nhds hys) (fun w hw => hD' w s hw)
  have ev : (fun w => v (R w) s) =ᶠ[nhds y] (fun w => R (v w s)) :=
    Filter.eventuallyEq_of_mem (hN.mem_nhds hys) (fun w hw => hv' w s hw)
  have eq : (fun w => q (R w) s) =ᶠ[nhds y] (fun w => q w s) :=
    Filter.eventuallyEq_of_mem (hN.mem_nhds hys) (fun w hw => hq' w s hw)
  have eT : (fun r => D (R y) r) =ᶠ[nhds s] (fun r => R (D y r)) :=
    Filter.eventuallyEq_of_mem (hT.mem_nhds hys) (fun r hr => hD' y r hr)

  have c2D : ContDiffAt ℝ 2 (fun w => D w s) y :=
    ((hDs.contDiffAt (hO.mem_nhds hys)).comp y
      ((contDiff_id.prodMk contDiff_const).contDiffAt)).of_le (by norm_num)
  have dDt : DifferentiableAt ℝ (fun r => D y r) s :=
    ((hDs.contDiffAt (hO.mem_nhds hys)).comp s
      ((contDiff_const.prodMk contDiff_id).contDiffAt)).differentiableAt (by norm_num)

  have key1 : ∀ (f : ℝ³ → ℝ³) (w : ℝ³), (fun x => f (R x)) =ᶠ[nhds y] (fun x => R (f x)) →
      fderiv ℝ f (R y) (R w) = R (fderiv ℝ f y w) := by
    intro f w h
    have h1 := (R.toContinuousLinearEquiv).comp_right_fderiv (f := f) (x := y)
    have h2 := R.comp_fderiv (f := f) (x := y)
    have h3 : fderiv ℝ (f ∘ R.toContinuousLinearEquiv) y = fderiv ℝ (R ∘ f) y := h.fderiv_eq
    have := DFunLike.congr_fun (h1.symm.trans (h3.trans h2)) w
    exact this

  have key2 : ∀ (g : ℝ³ → ℝ), (fun x => g (R x)) =ᶠ[nhds y] g →
      gradient g (R y) = R (gradient g y) := by
    intro g h
    have hfd : ∀ w, fderiv ℝ g (R y) (R w) = fderiv ℝ g y w := by
      intro w
      have h1 := (R.toContinuousLinearEquiv).comp_right_fderiv (f := g) (x := y)
      have h3 : fderiv ℝ (g ∘ R.toContinuousLinearEquiv) y = fderiv ℝ g y := h.fderiv_eq
      have := DFunLike.congr_fun (h1.symm.trans h3) w
      exact this
    apply ext_inner_right ℝ
    intro u
    obtain ⟨w, rfl⟩ : ∃ w, u = R w := ⟨R.symm u, (R.apply_symm_apply u).symm⟩
    rw [LinearIsometryEquiv.inner_map_map]
    simp only [gradient, InnerProductSpace.toDual_symm_apply]
    exact hfd w

  have key3 : ∀ (f : ℝ³ → ℝ³), ContDiffAt ℝ 2 f y →
      (fun x => f (R x)) =ᶠ[nhds y] (fun x => R (f x)) → Δ f (R y) = R (Δ f y) := by
    intro f hf h
    let e : ℝ³ ≃L[ℝ] ℝ³ := R.toContinuousLinearEquiv
    have hstar : iteratedFDeriv ℝ 2 (f ∘ e) y =
        (iteratedFDeriv ℝ 2 f (e y)).compContinuousLinearMap (fun _ => (e : ℝ³ →L[ℝ] ℝ³)) := by
      have := e.iteratedFDerivWithin_comp_right f (uniqueDiffOn_univ (𝕜 := ℝ)) (mem_univ (e y)) 2
      rwa [Set.preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at this
    let b := EuclideanSpace.basisFun (Fin 3) ℝ
    have d2 : Δ (f ∘ e) y = Δ f (R y) := by
      rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis (f ∘ e) b,
        InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis f (b.map R)]
      simp only [hstar, ContinuousMultilinearMap.compContinuousLinearMap_apply,
        OrthonormalBasis.map_apply]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      exact congrArg (iteratedFDeriv ℝ 2 f (R y)) (by funext j; fin_cases j <;> rfl)
    have d3 : Δ (f ∘ e) y = Δ (fun x => R (f x)) y :=
      (InnerProductSpace.laplacian_congr_nhds h).eq_of_nhds
    have d1 : Δ (fun x => R (f x)) y = R (Δ f y) :=
      ContDiffAt.laplacian_CLM_comp_left (l := (e : ℝ³ →L[ℝ] ℝ³)) hf
    rw [← d2, d3, d1]

  have T1 : deriv (fun r => D (R y) r) s = R (deriv (fun r => D y r) s) := by
    rw [eT.deriv_eq]
    exact (((R.toContinuousLinearEquiv : ℝ³ →L[ℝ] ℝ³).hasFDerivAt).comp_hasDerivAt s
      dDt.hasDerivAt).deriv
  have T2 : fderiv ℝ (fun w => D w s) (R y) (D (R y) s) =
      R (fderiv ℝ (fun w => D w s) y (D y s)) := by
    rw [hD' y s hys]; exact key1 (fun w => D w s) (D y s) eD
  have T3 : Δ (fun w => D w s) (R y) = R (Δ (fun w => D w s) y) :=
    key3 (fun w => D w s) c2D eD
  have T4 : gradient (fun w => q w s) (R y) = R (gradient (fun w => q w s) y) :=
    key2 (fun w => q w s) eq
  have T5 : fderiv ℝ (fun w => v w s) (R y) (D (R y) s) =
      R (fderiv ℝ (fun w => v w s) y (D y s)) := by
    rw [hD' y s hys]; exact key1 (fun w => v w s) (D y s) ev
  have T6 : fderiv ℝ (fun w => D w s) (R y) (v (R y) s) =
      R (fderiv ℝ (fun w => D w s) y (v y s)) := by
    rw [hv' y s hys]; exact key1 (fun w => D w s) (v y s) eD

  simp only [nsResidual]
  rw [T1, T2, T3, T4, T5, T6]
  simp only [map_add, map_sub, map_smul]

theorem thp_equiv_split : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S S' : CState) (Pi : Cyl → ℝ) (dU : Cyl → Fin 3 → ℝ) (W D : Ext ℝ³), B.ok → ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => uX5 B G l0 S p.1 p.2.1 p.2.2) {p | corrOn B l0 p.1 p.2.1} → ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => PX5 B G l0 S p.1 p.2.1 p.2.2) {p | corrOn B l0 p.1 p.2.1} → ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => W p.1 p.2.1 p.2.2) {p | corrOn B l0 p.1 p.2.1} → ContDiffOn ℝ ∞ dU (DomC B.h (qsOf l0)) → ContDiffOn ℝ ∞ Pi (DomC B.h (qsOf l0)) → (∀ x t Y, corrOn B l0 x t → D x t Y = cyl2cart x (dU (ptOf x t Y))) → (∀ x t Y, corrOn B l0 x t → wX5 B G l0 S x t Y = W x t Y) → (∀ (Y₀ : ℝ × ℝ) (x : ℝ³) (t : ℝ), corrOn B l0 x t → evOff B.h (uX5 B G l0 S') Y₀ x t = evOff B.h (uX5 B G l0 S) Y₀ x t + evOff B.h D Y₀ x t ∧ evOff B.h (PX5 B G l0 S') Y₀ x t = evOff B.h (PX5 B G l0 S) Y₀ x t + Pi (ptOf x t (Yph B.h (rad x) t + Y₀))) → ∀ x t Y, corrOn B l0 x t → ∃ c0 c1 c2 : ℝ, (∀ θ : ℝ, resX B.h (uX5 B G l0 S') (PX5 B G l0 S') (rotPt (rad x) θ (x 2)) t Y = resX B.h (uX5 B G l0 S) (PX5 B G l0 S) (rotPt (rad x) θ (x 2)) t Y + (c0 • eR (rotPt (rad x) θ (x 2)) + c1 • eTh (rotPt (rad x) θ (x 2)) + c2 • eZ) + crossXm B.h W D (rotPt (rad x) θ (x 2)) t Y) ∧ resX B.h (uX5 B G l0 S') (PX5 B G l0 S') x t Y = resX B.h (uX5 B G l0 S) (PX5 B G l0 S) x t Y + (c0 • eR x + c1 • eTh x + c2 • eZ) + crossXm B.h W D x t Y :=
by
  intro B G l0 S S' Pi dU W D hB huS hpS hW' hdU hPi hD hw hinc x t Y hxt
  have hr : 0 < rad x := hxt.1

  have hrot0 : ∀ r θ z : ℝ, rotPt r θ z 0 = r * Real.cos θ := by intro r θ z; simp [rotPt]
  have hrot1 : ∀ r θ z : ℝ, rotPt r θ z 1 = r * Real.sin θ := by intro r θ z; simp [rotPt]
  have hrot2 : ∀ r θ z : ℝ, rotPt r θ z 2 = z := by intro r θ z; simp [rotPt]
  have hradrot : ∀ r θ z : ℝ, 0 < r → rad (rotPt r θ z) = r := by
    intro r θ z hr0
    unfold rad
    rw [hrot0, hrot1]
    have h1 : (r * Real.cos θ) ^ 2 + (r * Real.sin θ) ^ 2 = r ^ 2 := by
      have := Real.cos_sq_add_sin_sq θ
      calc _ = r ^ 2 * (Real.cos θ ^ 2 + Real.sin θ ^ 2) := by ring
        _ = r ^ 2 := by rw [this, mul_one]
    rw [h1, Real.sqrt_sq hr0.le]
  have hxc : rotPt (rad x) (thetaOf x) (x 2) = x := by
    have hn : ‖(⟨x 0, x 1⟩ : ℂ)‖ = rad x := by
      rw [Complex.norm_def, Complex.normSq_mk]
      unfold rad
      congr 1
      ring
    have hc := Complex.norm_mul_cos_arg (⟨x 0, x 1⟩ : ℂ)
    have hs := Complex.norm_mul_sin_arg (⟨x 0, x 1⟩ : ℂ)
    rw [hn] at hc hs
    refine PiLp.ext (fun i => ?_)
    fin_cases i
    · simpa [rotPt, thetaOf] using hc
    · simpa [rotPt, thetaOf] using hs
    · simp [rotPt]

  have hframe : ∀ (v : ℝ³) (θ : ℝ), rotZ θ v = v 0 • eR (rotPt (rad x) θ (x 2)) +
      v 1 • eTh (rotPt (rad x) θ (x 2)) + v 2 • eZ := by
    intro v θ
    have hR := hradrot (rad x) θ (x 2) hr
    have hne : rad x ≠ 0 := hr.ne'
    refine PiLp.ext (fun i => ?_)
    fin_cases i
    · simp [rotZ, eR, eTh, eZ, radVec, azVec, hR, hrot0, hrot1]
      field_simp
      try ring
    · simp [rotZ, eR, eTh, eZ, radVec, azVec, hR, hrot0, hrot1]
      field_simp
      try ring
    · simp [rotZ, eR, eTh, eZ, radVec, azVec]

  have hpt : ∀ (α : ℝ) (y : ℝ³) (s : ℝ) (V : ℝ × ℝ), ptOf (rotZ α y) s V = ptOf y s V := by
    intro α y s V
    simp only [ptOf, (rotZ_facts α).1, (rotZ_facts α).2.1]
  have hcyl : ∀ (α : ℝ) (y : ℝ³) (c : Fin 3 → ℝ), cyl2cart (rotZ α y) c = rotZ α (cyl2cart y c) := by
    intro α y c
    obtain ⟨-, -, -, hadd, hsmul, -, heR, heTh, heZ, -, -⟩ := rotZ_facts α
    simp only [cyl2cart, heR, heTh, hadd, hsmul, heZ]
  have hthR : ∀ (F : Ext ℝ³) (α : ℝ) (y : ℝ³) (s : ℝ) (V : ℝ × ℝ),
      thAvgVec F (rotZ α y) s V = rotZ α (thAvgVec F y s V) := by
    intro F α y s V
    simp only [thAvgVec, hcyl, (rotZ_facts α).1, (rotZ_facts α).2.1, hpt]
  have hrotPt : ∀ θ : ℝ, rotPt (rad x) θ (x 2) = rotZ θ (rotPt (rad x) 0 (x 2)) := fun θ =>
    (rotZ_facts θ).2.2.2.2.2.2.2.2.2.1 (rad x) (x 2)

  set Y0 : ℝ × ℝ := Y - Yph B.h (rad x) t with hY0
  set O : Set (ℝ³ × ℝ) := {w : ℝ³ × ℝ | corrOn B l0 w.1 w.2} with hO
  have hOo : IsOpen O := (corr_domain_v5 B l0 Y0 hB).1
  have hOinv : ∀ (α : ℝ) (y : ℝ³) (s : ℝ), (y, s) ∈ O → (rotZ α y, s) ∈ O := by
    intro α y s hys
    have h' : corrOn B l0 y s := hys
    show corrOn B l0 (rotZ α y) s
    unfold corrOn at h' ⊢
    rw [(rotZ_facts α).1, (rotZ_facts α).2.1]
    exact h'
  have hmemθ : ∀ θ : ℝ, (rotPt (rad x) θ (x 2), t) ∈ O := by
    intro θ
    show corrOn B l0 (rotPt (rad x) θ (x 2)) t
    unfold corrOn
    rw [hradrot _ _ _ hr, hrot2]
    exact hxt

  set Dc : ℝ³ → ℝ → ℝ³ := fun y s => cyl2cart y (dU (ptOf y s (Yph B.h (rad y) s + Y0))) with hDc
  set Pc : ℝ³ → ℝ → ℝ := fun y s => Pi (ptOf y s (Yph B.h (rad y) s + Y0)) with hPc
  set ub : ℝ³ → ℝ → ℝ³ := fun y s => thAvgVec (uX5 B G l0 S) y s (Yph B.h (rad y) s + Y0) with hub
  have hDeq : ∀ y s, (y, s) ∈ O → evOff B.h D Y0 y s = Dc y s := fun y s hys =>
    hD y s (Yph B.h (rad y) s + Y0) hys
  have hubeq : ∀ y s, (y, s) ∈ O →
      ub y s = evOff B.h (uX5 B G l0 S) Y0 y s - evOff B.h W Y0 y s := by
    intro y s hys
    have hw' := hw y s (Yph B.h (rad y) s + Y0) hys
    simp only [wX5] at hw'
    show thAvgVec (uX5 B G l0 S) y s (Yph B.h (rad y) s + Y0) =
      uX5 B G l0 S y s (Yph B.h (rad y) s + Y0) - W y s (Yph B.h (rad y) s + Y0)
    rw [← hw']
    abel
  have hu'eq : ∀ y s, (y, s) ∈ O →
      evOff B.h (uX5 B G l0 S') Y0 y s = evOff B.h (uX5 B G l0 S) Y0 y s + Dc y s := by
    intro y s hys
    rw [(hinc Y0 y s hys).1, hDeq y s hys]
  have hp'eq : ∀ y s, (y, s) ∈ O →
      evOff B.h (PX5 B G l0 S') Y0 y s = evOff B.h (PX5 B G l0 S) Y0 y s + Pc y s := fun y s hys =>
    (hinc Y0 y s hys).2

  have hcd := corr_domain_v5 B l0 Y0 hB
  have hγ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y0)) O := hcd.2.1
  have hYs : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => Yph B.h (rad w.1) w.2 + Y0) O := hγ.snd.snd.snd
  have hψ : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => (w.1, w.2, Yph B.h (rad w.1) w.2 + Y0)) O :=
    contDiffOn_fst.prodMk (contDiffOn_snd.prodMk hYs)
  have hlift : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : Ext V),
      ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => F p.1 p.2.1 p.2.2) {p | corrOn B l0 p.1 p.2.1} →
      ContDiffOn ℝ ∞ (↿(evOff B.h F Y0)) O := by
    intro V _ _ F hF
    exact (hF.comp hψ (fun w hw => hw)).congr (fun w _ => rfl)
  have hγmap : MapsTo (fun w : ℝ³ × ℝ => ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + Y0)) O
      (DomC B.h (qsOf l0)) := fun w hw => ⟨hw.1, hw.2.1, hw.2.2⟩
  have hdUc := hdU.comp hγ hγmap
  have hPcs : ContDiffOn ℝ ∞ (↿Pc) O := (hPi.comp hγ hγmap).congr (fun w _ => rfl)
  have heRs : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => eR w.1) O :=
    (hcd.2.2.2.2.1.comp contDiffOn_fst (fun w hw => hw.1)).congr (fun w _ => rfl)
  have heThs : ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => eTh w.1) O :=
    (hcd.2.2.2.2.2.comp contDiffOn_fst (fun w hw => hw.1)).congr (fun w _ => rfl)
  have hDcs : ContDiffOn ℝ ∞ (↿Dc) O :=
    ((((contDiffOn_pi.mp hdUc 0).smul heRs).add ((contDiffOn_pi.mp hdUc 1).smul heThs)).add
      ((contDiffOn_pi.mp hdUc 2).smul (contDiffOn_const (c := eZ)))).congr (fun w _ => rfl)
  have hus : ContDiffOn ℝ ∞ (↿(evOff B.h (uX5 B G l0 S) Y0)) O := hlift _ huS
  have hps : ContDiffOn ℝ ∞ (↿(evOff B.h (PX5 B G l0 S) Y0)) O := hlift _ hpS
  have hWs : ContDiffOn ℝ ∞ (↿(evOff B.h W Y0)) O := hlift _ hW'
  have hubs : ContDiffOn ℝ ∞ (↿ub) O :=
    (hus.sub hWs).congr (fun w hwm => hubeq w.1 w.2 hwm)

  have hDcR : ∀ (α : ℝ) (y : ℝ³) (s : ℝ), Dc (rotZ α y) s = rotZ α (Dc y s) := by
    intro α y s
    show cyl2cart (rotZ α y) (dU (ptOf (rotZ α y) s (Yph B.h (rad (rotZ α y)) s + Y0))) =
      rotZ α (cyl2cart y (dU (ptOf y s (Yph B.h (rad y) s + Y0))))
    rw [(rotZ_facts α).1, hpt, hcyl]
  have hPcR : ∀ (α : ℝ) (y : ℝ³) (s : ℝ), Pc (rotZ α y) s = Pc y s := by
    intro α y s
    show Pi (ptOf (rotZ α y) s (Yph B.h (rad (rotZ α y)) s + Y0)) =
      Pi (ptOf y s (Yph B.h (rad y) s + Y0))
    rw [(rotZ_facts α).1, hpt]
  have hubR : ∀ (α : ℝ) (y : ℝ³) (s : ℝ), ub (rotZ α y) s = rotZ α (ub y s) := by
    intro α y s
    show thAvgVec (uX5 B G l0 S) (rotZ α y) s (Yph B.h (rad (rotZ α y)) s + Y0) =
      rotZ α (thAvgVec (uX5 B G l0 S) y s (Yph B.h (rad y) s + Y0))
    rw [(rotZ_facts α).1, hthR]
  have hequiv := thp_ns_equivariant O ub Dc Pc hOo hOinv hubs hDcs hPcs
    (fun α y s _ => hubR α y s) (fun α y s _ => hDcR α y s) (fun α y s _ => hPcR α y s)

  have tesStar : ∀ (u u' Wt ub Dc : ℝ³ → ℝ → ℝ³) (p p' Pc : ℝ³ → ℝ → ℝ),
      ContDiffOn ℝ ∞ (↿u) O → ContDiffOn ℝ ∞ (↿Wt) O → ContDiffOn ℝ ∞ (↿ub) O →
      ContDiffOn ℝ ∞ (↿Dc) O → ContDiffOn ℝ ∞ (↿p) O → ContDiffOn ℝ ∞ (↿Pc) O →
      (∀ y s, (y, s) ∈ O → ub y s = u y s - Wt y s) → (∀ y s, (y, s) ∈ O → u' y s = u y s + Dc y s) →
      (∀ y s, (y, s) ∈ O → p' y s = p y s + Pc y s) → ∀ y s, (y, s) ∈ O →
      nsResidual 1 u' p' y s = nsResidual 1 u p y s + (nsResidual 1 Dc Pc y s +
        fderiv ℝ (fun w => ub w s) y (Dc y s) + fderiv ℝ (fun w => Dc w s) y (ub y s)) +
        (fderiv ℝ (fun w => Wt w s) y (Dc y s) + fderiv ℝ (fun w => Dc w s) y (Wt y s)) := by
    intro u u' Wt ub Dc p p' Pc hu hW hub hD' hp hP hubE hu'E hp'E y s hys
    have hN : IsOpen {w : ℝ³ | (w, s) ∈ O} :=
      hOo.preimage (Continuous.prodMk continuous_id continuous_const)
    have hT : IsOpen {r : ℝ | (y, r) ∈ O} :=
      hOo.preimage (Continuous.prodMk continuous_const continuous_id)
    have hsl : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : ℝ³ → ℝ → V),
        ContDiffOn ℝ ∞ (↿F) O → ContDiffAt ℝ ∞ (fun w => F w s) y := by
      intro V _ _ F hF
      exact (hF.contDiffAt (hOo.mem_nhds hys)).comp y ((contDiff_id.prodMk contDiff_const).contDiffAt)
    have htl : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F : ℝ³ → ℝ → V),
        ContDiffOn ℝ ∞ (↿F) O → DifferentiableAt ℝ (fun r => F y r) s := by
      intro V _ _ F hF
      exact ((hF.contDiffAt (hOo.mem_nhds hys)).comp s
        ((contDiff_const.prodMk contDiff_id).contDiffAt)).differentiableAt (by norm_num)
    have du : DifferentiableAt ℝ (fun w => u w s) y := (hsl u hu).differentiableAt (by norm_num)
    have dD : DifferentiableAt ℝ (fun w => Dc w s) y := (hsl Dc hD').differentiableAt (by norm_num)
    have dub : DifferentiableAt ℝ (fun w => ub w s) y := (hsl ub hub).differentiableAt (by norm_num)
    have dW : DifferentiableAt ℝ (fun w => Wt w s) y := (hsl Wt hW).differentiableAt (by norm_num)
    have dp : DifferentiableAt ℝ (fun w => p w s) y := (hsl p hp).differentiableAt (by norm_num)
    have dP : DifferentiableAt ℝ (fun w => Pc w s) y := (hsl Pc hP).differentiableAt (by norm_num)
    have c2u : ContDiffAt ℝ 2 (fun w => u w s) y := (hsl u hu).of_le (by norm_num)
    have c2D : ContDiffAt ℝ 2 (fun w => Dc w s) y := (hsl Dc hD').of_le (by norm_num)
    have eNu : (fun w => u' w s) =ᶠ[nhds y] (fun w => u w s + Dc w s) :=
      Filter.eventuallyEq_of_mem (hN.mem_nhds hys) (fun w hw => hu'E w s hw)
    have eNp : (fun w => p' w s) =ᶠ[nhds y] (fun w => p w s + Pc w s) :=
      Filter.eventuallyEq_of_mem (hN.mem_nhds hys) (fun w hw => hp'E w s hw)
    have eTu : (fun r => u' y r) =ᶠ[nhds s] (fun r => u y r + Dc y r) :=
      Filter.eventuallyEq_of_mem (hT.mem_nhds hys) (fun r hr => hu'E y r hr)
    have eNub : (fun w => u w s) =ᶠ[nhds y] (fun w => ub w s + Wt w s) :=
      Filter.eventuallyEq_of_mem (hN.mem_nhds hys) (fun w hw => by rw [hubE w s hw]; abel)
    have hdt : deriv (fun r => u' y r) s = deriv (fun r => u y r) s + deriv (fun r => Dc y r) s := by
      rw [eTu.deriv_eq, deriv_fun_add (htl u hu) (htl Dc hD')]
    have hfd : fderiv ℝ (fun w => u' w s) y =
        fderiv ℝ (fun w => u w s) y + fderiv ℝ (fun w => Dc w s) y := by
      rw [eNu.fderiv_eq, fderiv_fun_add du dD]
    have hfu : fderiv ℝ (fun w => u w s) y =
        fderiv ℝ (fun w => ub w s) y + fderiv ℝ (fun w => Wt w s) y := by
      rw [eNub.fderiv_eq, fderiv_fun_add dub dW]
    have hlap : Δ (fun w => u' w s) y = Δ (fun w => u w s) y + Δ (fun w => Dc w s) y := by
      rw [(InnerProductSpace.laplacian_congr_nhds eNu).eq_of_nhds]
      exact ContDiffAt.laplacian_add c2u c2D
    have hgrad : gradient (fun w => p' w s) y =
        gradient (fun w => p w s) y + gradient (fun w => Pc w s) y := by
      simp only [gradient]
      rw [eNp.fderiv_eq, fderiv_fun_add dp dP, map_add]
    have hv : u' y s = ub y s + Wt y s + Dc y s := by rw [hu'E y s hys, hubE y s hys]; abel
    have hv0 : u y s = ub y s + Wt y s := by rw [hubE y s hys]; abel
    simp only [nsResidual]
    rw [hdt, hfd, hlap, hgrad, hv, hv0, hfu]
    simp only [ContinuousLinearMap.add_apply, map_add, smul_add, one_smul]
    abel
  have hstar := tesStar (evOff B.h (uX5 B G l0 S) Y0) (evOff B.h (uX5 B G l0 S') Y0)
    (evOff B.h W Y0) ub Dc (evOff B.h (PX5 B G l0 S) Y0) (evOff B.h (PX5 B G l0 S') Y0) Pc
    hus hWs hubs hDcs hps hPcs hubeq hu'eq hp'eq

  have hT1 : ∀ (F : Ext ℝ³) (P : Ext ℝ) (y : ℝ³), rad y = rad x →
      resX B.h F P y t Y = nsResidual 1 (evOff B.h F Y0) (evOff B.h P Y0) y t := by
    intro F P y hy
    simp only [resX, hy, ← hY0]
  have hT2 : ∀ y : ℝ³, rad y = rad x → (y, t) ∈ O →
      crossXm B.h W D y t Y = fderiv ℝ (fun w => evOff B.h W Y0 w t) y (Dc y t) +
        fderiv ℝ (fun w => Dc w t) y (evOff B.h W Y0 y t) := by
    intro y hy hyO
    have hU : IsOpen {w : ℝ³ | (w, t) ∈ O} :=
      hOo.preimage (Continuous.prodMk continuous_id continuous_const)
    have hev : (fun w => evOff B.h D Y0 w t) =ᶠ[nhds y] (fun w => Dc w t) :=
      Filter.eventuallyEq_of_mem (hU.mem_nhds hyO) (fun w hwm => hDeq w t hwm)
    simp only [crossXm, hy, ← hY0]
    rw [hev.fderiv_eq, hDeq y t hyO]

  have hy₀O : (rotPt (rad x) 0 (x 2), t) ∈ O := hmemθ 0
  set Ebv : ℝ³ := nsResidual 1 Dc Pc (rotPt (rad x) 0 (x 2)) t +
    fderiv ℝ (fun w => ub w t) (rotPt (rad x) 0 (x 2)) (Dc (rotPt (rad x) 0 (x 2)) t) +
    fderiv ℝ (fun w => Dc w t) (rotPt (rad x) 0 (x 2)) (ub (rotPt (rad x) 0 (x 2)) t) with hEbv
  have hEθ : ∀ θ : ℝ, nsResidual 1 Dc Pc (rotPt (rad x) θ (x 2)) t +
      fderiv ℝ (fun w => ub w t) (rotPt (rad x) θ (x 2)) (Dc (rotPt (rad x) θ (x 2)) t) +
      fderiv ℝ (fun w => Dc w t) (rotPt (rad x) θ (x 2)) (ub (rotPt (rad x) θ (x 2)) t) =
      rotZ θ Ebv := by
    intro θ
    rw [hrotPt θ]
    exact hequiv θ _ t hy₀O
  have hcirc : ∀ θ : ℝ, resX B.h (uX5 B G l0 S') (PX5 B G l0 S') (rotPt (rad x) θ (x 2)) t Y =
      resX B.h (uX5 B G l0 S) (PX5 B G l0 S) (rotPt (rad x) θ (x 2)) t Y +
        (Ebv 0 • eR (rotPt (rad x) θ (x 2)) + Ebv 1 • eTh (rotPt (rad x) θ (x 2)) + Ebv 2 • eZ) +
        crossXm B.h W D (rotPt (rad x) θ (x 2)) t Y := by
    intro θ
    have hy := hradrot (rad x) θ (x 2) hr
    have hm := hmemθ θ
    rw [hT1 _ _ _ hy, hT1 _ _ _ hy, hT2 _ hy hm, hstar _ _ hm, ← hframe Ebv θ, hEθ θ]
  refine ⟨Ebv 0, Ebv 1, Ebv 2, hcirc, ?_⟩
  have h := hcirc (thetaOf x)
  rw [hxc] at h
  exact h

theorem thp_cross_avg_zero : ∀ (B : BG) (G : CorrGeom) (l0 : ℕ) (S : CState) (dU : Cyl → Fin 3 → ℝ) (W D : Ext ℝ³), B.ok → ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => uX5 B G l0 S p.1 p.2.1 p.2.2) {p | corrOn B l0 p.1 p.2.1} → ContDiffOn ℝ ∞ (fun p : ℝ³ × ℝ × (ℝ × ℝ) => W p.1 p.2.1 p.2.2) {p | corrOn B l0 p.1 p.2.1} → ContDiffOn ℝ ∞ dU (DomC B.h (qsOf l0)) → (∀ x t Y, corrOn B l0 x t → D x t Y = cyl2cart x (dU (ptOf x t Y))) → (∀ x t Y, corrOn B l0 x t → wX5 B G l0 S x t Y = W x t Y) → ∀ x t Y, corrOn B l0 x t → thAvgVec (crossXm B.h W D) x t Y = 0 ∧ ∀ a : Fin 3, IntervalIntegrable (fun θ => inner ℝ (crossXm B.h W D (rotPt (rad x) θ (x 2)) t Y) (frameAt θ (ptOf x t Y) a)) MeasureTheory.volume 0 (2 * Real.pi) :=
by
  intro B G l0 S dU W D hB huS hW' hdU hD hw



  have hc0 : ∀ (β : ℝ) (y : ℝ³), rotZ β y 0 = Real.cos β * y 0 - Real.sin β * y 1 := by
    intro β y; simp [rotZ]
  have hc1 : ∀ (β : ℝ) (y : ℝ³), rotZ β y 1 = Real.sin β * y 0 + Real.cos β * y 1 := by
    intro β y; simp [rotZ]
  have hc2 : ∀ (β : ℝ) (y : ℝ³), rotZ β y 2 = y 2 := by
    intro β y; simp [rotZ]
  have hp0 : ∀ ρ ψ ζ : ℝ, rotPt ρ ψ ζ 0 = ρ * Real.cos ψ := by intro ρ ψ ζ; simp [rotPt]
  have hp1 : ∀ ρ ψ ζ : ℝ, rotPt ρ ψ ζ 1 = ρ * Real.sin ψ := by intro ρ ψ ζ; simp [rotPt]
  have hp2 : ∀ ρ ψ ζ : ℝ, rotPt ρ ψ ζ 2 = ζ := by intro ρ ψ ζ; simp [rotPt]
  have hext : ∀ u v : ℝ³, u 0 = v 0 → u 1 = v 1 → u 2 = v 2 → u = v := by
    intro u v h0 h1 h2
    ext i
    fin_cases i
    · exact h0
    · exact h1
    · exact h2
  have hinner : ∀ u v : ℝ³, (inner ℝ u v : ℝ) = u 0 * v 0 + u 1 * v 1 + u 2 * v 2 := by
    intro u v
    simp [PiLp.inner_apply, Fin.sum_univ_three]
    ring
  have hradrot : ∀ α y, rad (rotZ α y) = rad y := by
    intro α y
    unfold rad
    rw [hc0, hc1]
    congr 1
    linear_combination (y 0 ^ 2 + y 1 ^ 2) * Real.cos_sq_add_sin_sq α
  have hrotadd : ∀ α u v, rotZ α (u + v) = rotZ α u + rotZ α v := by
    intro α u v
    apply hext <;> simp [hc0, hc1, hc2] <;> ring
  have hrotsmul : ∀ α (c : ℝ) u, rotZ α (c • u) = c • rotZ α u := by
    intro α c u
    apply hext <;> simp [hc0, hc1, hc2] <;> ring
  have hrotinv : ∀ α u, rotZ α (rotZ (-α) u) = u := by
    intro α u
    apply hext
    · rw [hc0, hc0, hc1, Real.cos_neg, Real.sin_neg]
      linear_combination u 0 * Real.cos_sq_add_sin_sq α
    · rw [hc1, hc0, hc1, Real.cos_neg, Real.sin_neg]
      linear_combination u 1 * Real.cos_sq_add_sin_sq α
    · rw [hc2, hc2]
  have hrotinner : ∀ α u v, (inner ℝ (rotZ α u) (rotZ α v) : ℝ) = inner ℝ u v := by
    intro α u v
    rw [hinner, hinner, hc0, hc0, hc1, hc1, hc2, hc2]
    linear_combination (u 0 * v 0 + u 1 * v 1) * Real.cos_sq_add_sin_sq α
  have hrotcomp : ∀ α β (u : ℝ³), rotZ α (rotZ β u) = rotZ (α + β) u := by
    intro α β u
    apply hext
    · rw [hc0, hc0, hc1, hc0, Real.cos_add, Real.sin_add]; ring
    · rw [hc1, hc0, hc1, hc1, Real.cos_add, Real.sin_add]; ring
    · rw [hc2, hc2, hc2]
  have hrotper : ∀ α (u : ℝ³), rotZ (α + 2 * Real.pi) u = rotZ α u := by
    intro α u; unfold rotZ; rw [Real.cos_add_two_pi, Real.sin_add_two_pi]
  have hptper : ∀ ρ ψ ζ : ℝ, rotPt ρ (ψ + 2 * Real.pi) ζ = rotPt ρ ψ ζ := by
    intro ρ ψ ζ; unfold rotPt; rw [Real.cos_add_two_pi, Real.sin_add_two_pi]
  have hrotpt : ∀ θ ρ φ ζ : ℝ, rotZ θ (rotPt ρ φ ζ) = rotPt ρ (θ + φ) ζ := by
    intro θ ρ φ ζ
    apply hext
    · rw [hc0, hp0, hp0, hp1, Real.cos_add]; ring
    · rw [hc1, hp0, hp1, hp1, Real.sin_add]; ring
    · rw [hc2, hp2, hp2]
  have hradpt : ∀ ρ ψ ζ : ℝ, 0 < ρ → rad (rotPt ρ ψ ζ) = ρ := by
    intro ρ ψ ζ hρ
    unfold rad
    rw [hp0, hp1]
    rw [show (ρ * Real.cos ψ) ^ 2 + (ρ * Real.sin ψ) ^ 2 = ρ ^ 2 by
      linear_combination ρ ^ 2 * Real.cos_sq_add_sin_sq ψ]
    exact Real.sqrt_sq hρ.le
  have hframe : ∀ ρ ψ ζ : ℝ, 0 < ρ → eR (rotPt ρ ψ ζ) = rotZ ψ (EuclideanSpace.single 0 1) ∧
      eTh (rotPt ρ ψ ζ) = rotZ ψ (EuclideanSpace.single 1 1) ∧ eZ = rotZ ψ (EuclideanSpace.single 2 1) := by
    intro ρ ψ ζ hρ
    have hr := hradpt ρ ψ ζ hρ
    have hne : ρ ≠ 0 := hρ.ne'
    refine ⟨?_, ?_, ?_⟩
    · apply hext <;> simp [eR, radVec, hr, hc0, hc1, hc2, hp0, hp1] <;> field_simp
    · apply hext <;> simp [eTh, azVec, hr, hc0, hc1, hc2, hp0, hp1] <;> field_simp
    · apply hext <;> simp [eZ, hc0, hc1, hc2]
  have hframeAt : ∀ (ψ : ℝ) (η : Cyl) (a : Fin 3), 0 < η.1 →
      frameAt ψ η a = rotZ ψ (EuclideanSpace.single a 1) := by
    intro ψ η a hη
    obtain ⟨h0, h1, h2⟩ := hframe η.1 ψ η.2.1 hη
    fin_cases a
    · exact h0
    · exact h1
    · exact h2
  have hcyl : ∀ α w (k : Fin 3 → ℝ), cyl2cart (rotZ α w) k = rotZ α (cyl2cart w k) := by
    intro α w k
    apply hext <;> simp [cyl2cart, eR, eTh, eZ, radVec, azVec, hradrot, hc0, hc1, hc2] <;> ring
  have hpolar : ∀ w : ℝ³, rotPt (rad w) (thetaOf w) (w 2) = w := by
    intro w
    have hn : ‖(⟨w 0, w 1⟩ : ℂ)‖ = rad w := by
      rw [Complex.norm_def, Complex.normSq_mk]
      unfold rad
      congr 1
      ring
    have h0 := Complex.norm_mul_cos_arg (⟨w 0, w 1⟩ : ℂ)
    have h1 := Complex.norm_mul_sin_arg (⟨w 0, w 1⟩ : ℂ)
    rw [hn] at h0 h1
    apply hext
    · rw [hp0]; exact h0
    · rw [hp1]; exact h1
    · rw [hp2]
  have hrotc : ∀ u : ℝ³, Continuous (fun θ : ℝ => rotZ θ u) := by
    intro u; unfold rotZ; fun_prop
  have hptc : ∀ ρ ζ : ℝ, Continuous (fun ψ : ℝ => rotPt ρ ψ ζ) := by
    intro ρ ζ; unfold rotPt; fun_prop



  have core1 : ∀ (U : Set ℝ³) (Wf : ℝ³ → ℝ³) (y v c : ℝ³), IsOpen U → (∀ (α : ℝ) (w : ℝ³), w ∈ U → rotZ α w ∈ U) →
