    have e := pull (fun s : ℝ × ℝ × ℝ => M γ s v) (ξ.1, ξ.2.1, ξ.2.2.1) Af U
      (ξ.1, ξ.2.1, ξ.2.2.1, ξ.2.2.2 + (v - y0) • d)
      (Lι.comp (ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ)) hUo hAU hξU hev k
    rw [e]
    have hRi : ‖R.comp (ContinuousLinearMap.inl ℝ (ℝ × ℝ × ℝ) ℝ)‖ ≤ 1 := by
