      intervalIntegral.continuous_primitive hsigi 0

  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = Pst ^ 2 * Real.exp (6 / 5 * (1 - rfpSigI 1)) := ⟨_, rfl⟩
  have hCpos : ∀ y, 0 < rinC Md Pst lam y := by
    intro y; unfold rinC; exact mul_pos hPst0 (Real.exp_pos _)
  have hCid : ∀ y, rinC Md Pst lam y ^ 2 * Real.exp y =
      Pst ^ 2 * Real.exp (6 / 5 * (y - rfpSigI y) - 2 * lam * rfpSigI (y - rfpY2 Md)) := by
    intro y
    have e1 : Real.exp (y / 10 - 3 / 5 * rfpSigI y - lam * rfpSigI (y - rfpY2 Md)) ^ 2 * Real.exp y =
        Real.exp (6 / 5 * (y - rfpSigI y) - 2 * lam * rfpSigI (y - rfpY2 Md)) := by
      rw [sq, ← Real.exp_add, ← Real.exp_add]; congr 1; ring
    unfold rinC
    rw [mul_pow, mul_assoc, e1]
  have hg : ∀ y, y - rfpSigI y ≤ 1 - rfpSigI 1 := by
    intro y
    rcases le_total y 0 with h | h
    · rw [hS0 y h]; linarith
    · rcases le_total y 1 with h' | h'
      · linarith [hSsub y h h']
      · rw [hSlin y h']; linarith
  have hCK1 : ∀ y, rinC Md Pst lam y ^ 2 * Real.exp y ≤ K := by
    intro y; rw [hCid, hK]
    apply mul_le_mul_of_nonneg_left _ (sq_nonneg Pst)
    apply Real.exp_le_exp.2
    nlinarith [hg y, mul_nonneg hlam0.le (hSnn (y - rfpY2 Md))]
  have hCneg : ∀ y, y ≤ 0 → rinC Md Pst lam y ^ 2 ≤ Pst ^ 2 := by
    intro y hy
    have hE : Real.exp (y / 10 - 3 / 5 * rfpSigI y - lam * rfpSigI (y - rfpY2 Md)) ≤ 1 := by
      rw [Real.exp_le_one_iff, hS0 y hy]
      nlinarith [mul_nonneg hlam0.le (hSnn (y - rfpY2 Md))]
    have hC1 : rinC Md Pst lam y ≤ Pst := by
      unfold rinC; exact mul_le_of_le_one_right hPst0.le hE
    exact pow_le_pow_left₀ (hCpos y).le hC1 2
  have hCeq : ∀ y, 1 ≤ y → y ≤ rfpY2 Md → rinC Md Pst lam y ^ 2 * Real.exp y = K := by
    intro y h1 h2
    rw [hCid, hSlin y h1, hS0 (y - rfpY2 Md) (by linarith), hK]
    congr 1; rw [Real.exp_eq_exp]; ring
  have hPK : Pst ^ 2 ≤ K := by
    rw [hK]
    exact le_mul_of_one_le_right (sq_nonneg _) (Real.one_le_exp (by linarith [hS1.2]))
  have hK0 : 0 ≤ K := le_trans (sq_nonneg _) hPK
  have hCK : ∀ y, rinC Md Pst lam y ^ 2 ≤ K := by
    intro y
    rcases le_total y 0 with h | h
    · exact le_trans (hCneg y h) hPK
    · exact le_trans (le_mul_of_one_le_right (sq_nonneg _) (Real.one_le_exp h)) (hCK1 y)
  have hCy2 : rinC Md Pst lam (rfpY2 Md) =
      Pst * Real.exp (3 / 5 * (1 - rfpSigI 1) - rfpY2 Md / 2) := by
    unfold rinC
    rw [show rfpY2 Md - rfpY2 Md = 0 from sub_self _, hS0 0 le_rfl, hSlin (rfpY2 Md) (by linarith)]
    congr 1; rw [Real.exp_eq_exp]; ring
  have hCrange : ∀ y, rfpY2 Md ≤ y → y ≤ rfpY2 Md + 2 →
      rinC Md Pst lam (rfpY2 Md) * Real.exp (-(51 / 50)) ≤ rinC Md Pst lam y ∧
        rinC Md Pst lam y ≤ rinC Md Pst lam (rfpY2 Md) := by
    intro y h1 h2
    have hd := hSpos (y - rfpY2 Md) (by linarith)
    have hrel : rinC Md Pst lam y = rinC Md Pst lam (rfpY2 Md) *
        Real.exp (-(y - rfpY2 Md) / 2 - lam * rfpSigI (y - rfpY2 Md)) := by
      rw [hCy2]; unfold rinC
      rw [hSlin y (by linarith), mul_assoc Pst, ← Real.exp_add]
      congr 1; rw [Real.exp_eq_exp]; ring
    have hlS : lam * rfpSigI (y - rfpY2 Md) ≤ 1 / 100 * 2 :=
      mul_le_mul hlam1 (by linarith [hd.2]) hd.1 (by norm_num)
    have hlS0 : 0 ≤ lam * rfpSigI (y - rfpY2 Md) := mul_nonneg hlam0.le hd.1
    have hCy2pos := hCpos (rfpY2 Md)
    rw [hrel]
    constructor
    · apply mul_le_mul_of_nonneg_left _ hCy2pos.le
      apply Real.exp_le_exp.2; linarith
    · apply mul_le_of_le_one_right hCy2pos.le
      rw [Real.exp_le_one_iff]; linarith
  have hD1 : 1 ≤ rinC Md Pst lam (rfpY2 Md) := by
    rw [hCy2]
    have h1 : Real.exp (rfpY2 Md - 1) * Real.exp (-(rfpY2 Md) / 2) ≤
        Pst * Real.exp (3 / 5 * (1 - rfpSigI 1) - rfpY2 Md / 2) :=
      mul_le_mul hPst.le (Real.exp_le_exp.2 (by linarith [hS1.2])) (Real.exp_pos _).le hPst0.le
    have h2 : Real.exp (rfpY2 Md - 1) * Real.exp (-(rfpY2 Md) / 2) = Real.exp (rfpY2 Md / 2 - 1) := by
      rw [← Real.exp_add]; congr 1; ring
    have h3 : 1 ≤ Real.exp (rfpY2 Md / 2 - 1) := Real.one_le_exp (by linarith)
    linarith
  have hD2 : rinC Md Pst lam (rfpY2 Md) ≤ 6 / 5 * Pst := by
    rw [hCy2]
    have h1 : Real.exp (3 / 5 * (1 - rfpSigI 1) - rfpY2 Md / 2) ≤ 1 :=
      Real.exp_le_one_iff.2 (by linarith [hS1.1])
    have h2 := mul_le_of_le_one_right hPst0.le h1
    linarith

  have hCc : Continuous (rinC Md Pst lam) :=
    show Continuous (fun y => Pst * Real.exp (y / 10 - 3 / 5 * rfpSigI y - lam * rfpSigI (y - rfpY2 Md))) from
      continuous_const.mul (Real.continuous_exp.comp (((continuous_id.div_const 10).sub
        (continuous_const.mul hSc)).sub (continuous_const.mul (hSc.comp (continuous_id.sub continuous_const)))))
  have hgm : Measurable (fun x => rinC Md Pst lam (Real.log x) ^ 2 / 2) :=
    ((hCc.measurable.comp Real.measurable_log).pow_const 2).div_const 2
  have hint : ∀ a b : ℝ, IntervalIntegrable (fun x => rinC Md Pst lam (Real.log x) ^ 2 / 2)
      MeasureTheory.volume a b := by
    intro a b
    refine (intervalIntegrable_const (c := K / 2)).mono_fun hgm.aestronglyMeasurable ?_
    refine Filter.Eventually.of_forall (fun x => ?_)
    show ‖rinC Md Pst lam (Real.log x) ^ 2 / 2‖ ≤ ‖K / 2‖
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (by positivity), abs_of_nonneg (by linarith)]
    linarith [hCK (Real.log x)]
  have hstar : ∀ X, 1 ≤ X → rinMom (fun x => rinC Md Pst lam (Real.log x) ^ 2 / 2) X ≤
      Pst ^ 2 / 2 + K / 2 * Real.log X := by
    intro X hX
    unfold rinMom
    rw [← intervalIntegral.integral_add_adjacent_intervals (hint 0 1) (hint 1 X)]
    have h1 : ∫ x in (0:ℝ)..1, rinC Md Pst lam (Real.log x) ^ 2 / 2 ≤ ∫ x in (0:ℝ)..1, Pst ^ 2 / 2 := by
      apply intervalIntegral.integral_mono_on zero_le_one (hint 0 1) intervalIntegrable_const
      intro x hx
      have := hCneg (Real.log x) (Real.log_nonpos hx.1 hx.2)
      linarith
    have h2 : ∫ x in (1:ℝ)..X, rinC Md Pst lam (Real.log x) ^ 2 / 2 ≤ ∫ x in (1:ℝ)..X, K / 2 * x⁻¹ := by
      apply intervalIntegral.integral_mono_on hX (hint 1 X)
      · apply ContinuousOn.intervalIntegrable
        apply ContinuousOn.mul continuousOn_const
        refine continuousOn_inv₀.mono (fun x hx => ?_)
        rw [Set.uIcc_of_le hX] at hx
        simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
        linarith [hx.1]
      · intro x hx
        have hx0 : 0 < x := by linarith [hx.1]
        have := hCK1 (Real.log x)
        rw [Real.exp_log hx0] at this
        rw [← div_eq_mul_inv, le_div_iff₀ hx0]
        linarith
    have e1 : ∫ x in (0:ℝ)..1, Pst ^ 2 / 2 = Pst ^ 2 / 2 := by simp
    have e2 : ∫ x in (1:ℝ)..X, K / 2 * x⁻¹ = K / 2 * Real.log X := by
      rw [intervalIntegral.integral_const_mul, integral_inv_of_pos one_pos (by linarith), div_one]
    linarith

  have hk : ∀ y, 0 ≤ rfpK Md y ∧ rfpK Md y ≤ 4 := by
    intro y; unfold rfpK
    split_ifs
    · norm_num
    · have := hsig (Real.log y / Md); constructor <;> linarith
  refine ⟨fun X hX => ⟨?_, ?_, ?_, ?_, ?_⟩, fun X h1 h2 => ?_, fun X h1 h2 => ?_, hD1, hD2⟩
  · unfold rinMom; exact intervalIntegral.integral_nonneg hX.le (fun u _ => (hk _).1)
  · unfold rinMom
    have h1 : ‖∫ x in (0:ℝ)..X, rfpK Md (Real.log x)‖ ≤ 4 * |X - 0| :=
      intervalIntegral.norm_integral_le_of_norm_le_const (fun x _ => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hk _).1]; exact (hk _).2)
    rw [Real.norm_eq_abs, sub_zero, abs_of_pos hX] at h1
    exact le_trans (le_abs_self _) h1
  · unfold rinMom; exact intervalIntegral.integral_nonneg hX.le (fun u _ => sq_nonneg _)
  · unfold rinMom
    have h1 : ‖∫ x in (0:ℝ)..X, rfpK Md (Real.log x) ^ 2‖ ≤ 16 * |X - 0| :=
      intervalIntegral.norm_integral_le_of_norm_le_const (fun x _ => by
        rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
        nlinarith [hk (Real.log x)])
    rw [Real.norm_eq_abs, sub_zero, abs_of_pos hX] at h1
    exact le_trans (le_abs_self _) h1
  · unfold rinMom; exact intervalIntegral.integral_nonneg hX.le (fun u _ => by positivity)
  · have hX0 : 0 < X := lt_of_lt_of_le (Real.exp_pos 1) h1
    have hy1 : 1 ≤ Real.log X := (Real.le_log_iff_exp_le hX0).2 h1
    have hy2' : Real.log X ≤ rfpY2 Md := (Real.log_le_iff_le_exp hX0).2 h2
    have hX1 : 1 ≤ X := le_trans (Real.one_le_exp zero_le_one) h1
    have heq := hCeq (Real.log X) hy1 hy2'
    rw [Real.exp_log hX0] at heq
    constructor
    · have hs := hstar X hX1
      rw [show (Real.log X + 2) * rinC Md Pst lam (Real.log X) ^ 2 * X / 2 =
        (Real.log X + 2) * (rinC Md Pst lam (Real.log X) ^ 2 * X) / 2 by ring, heq]
      nlinarith
    · rw [div_le_iff₀ hX0]; linarith
  · have hX0 : 0 < X := lt_of_lt_of_le (Real.exp_pos _) h1
    have hy1 : rfpY2 Md ≤ Real.log X := (Real.le_log_iff_exp_le hX0).2 h1
    have hy2' : Real.log X ≤ rfpY2 Md + 2 := (Real.log_le_iff_le_exp hX0).2 h2
    have hX1 : 1 ≤ X := le_trans (Real.one_le_exp (by linarith)) h1
    have heq := hCeq (rfpY2 Md) (by linarith) le_rfl
    have hKX : K ≤ rinC Md Pst lam (rfpY2 Md) ^ 2 * X := by
      rw [← heq]; exact mul_le_mul_of_nonneg_left h1 (sq_nonneg _)
    refine ⟨?_, hCrange (Real.log X) hy1 hy2'⟩
    have hs := hstar X hX1
    have h3 : K / 2 * (Real.log X + 1) ≤ K / 2 * (rfpY2 Md + 3) :=
      mul_le_mul_of_nonneg_left (by linarith) (by linarith)
    have h4 : (rfpY2 Md + 3) * K ≤ (rfpY2 Md + 3) * (rinC Md Pst lam (rfpY2 Md) ^ 2 * X) :=
      mul_le_mul_of_nonneg_left hKX (by linarith)
    nlinarith

theorem rfp_inner_kC_facts : (∃ Sm : ℝ, 0 ≤ Sm ∧ ∀ Md : ℝ, 0 < Md → ∀ y : ℝ, 1 ≤ y → |deriv (rfpK Md) y| ≤ Sm / (Md * y)) ∧ ∀ Md Pst lam : ℝ, 0 < Md → 0 < Pst → Differentiable ℝ (rfpK Md) ∧ (∀ y, 0 ≤ rfpK Md y ∧ rfpK Md y ≤ 4) ∧ (∀ y, y ≤ 1 → rfpK Md y = 4 ∧ deriv (rfpK Md) y = 0) ∧ (∀ y, Real.exp Md ≤ y → rfpK Md y = 0 ∧ deriv (rfpK Md) y = 0) ∧ (∀ y, 0 < rinC Md Pst lam y ∧ HasDerivAt (rinC Md Pst lam) ((1 / 10 - 3 / 5 * sigA y - lam * sigA (y - rfpY2 Md)) * rinC Md Pst lam y) y) ∧ (∀ Y : ℝ, ∃ M : ℝ, ∀ y, y ≤ Y → |rinC Md Pst lam y| ≤ M) :=
by

  have hσC : ContDiff ℝ 1 sigA := by
    have hm : ∀ y : ℝ, HasDerivAt (fun w : ℝ => w * |w|) (2 * |y|) y := by
      intro y
      rcases lt_trichotomy y 0 with hy | hy | hy
      · have h1 : HasDerivAt (fun w : ℝ => -(w ^ 2)) (2 * |y|) y := by
          have := (hasDerivAt_pow 2 y).neg
          convert this using 1
          rw [abs_of_neg hy]; push_cast; ring
        refine h1.congr_of_eventuallyEq ?_
        filter_upwards [Iio_mem_nhds hy] with w hw
        rw [abs_of_neg hw]; ring
      · subst hy
        rw [hasDerivAt_iff_isLittleO, Asymptotics.isLittleO_iff]
        intro c hc
        filter_upwards [Metric.ball_mem_nhds (0:ℝ) hc] with w hw
        rw [Metric.mem_ball, Real.dist_eq, sub_zero] at hw
        simp only [abs_zero, mul_zero, sub_zero, smul_zero, Real.norm_eq_abs, abs_mul, abs_abs]
        exact mul_le_mul_of_nonneg_right hw.le (abs_nonneg w)
      · have h1 : HasDerivAt (fun w : ℝ => w ^ 2) (2 * |y|) y := by
          convert hasDerivAt_pow 2 y using 1
          rw [abs_of_pos hy]; push_cast; ring
        refine h1.congr_of_eventuallyEq ?_
        filter_upwards [Ioi_mem_nhds hy] with w hw
        rw [abs_of_pos hw]; ring
    have hmC : ContDiff ℝ 1 (fun w : ℝ => w * |w|) := by
      rw [contDiff_one_iff_deriv]
      refine ⟨fun y => (hm y).differentiableAt, ?_⟩
      have hd : deriv (fun w : ℝ => w * |w|) = fun y => 2 * |y| := funext fun y => (hm y).deriv
      rw [hd]
      exact continuous_const.mul continuous_abs
    obtain ⟨q, hq_def⟩ : ∃ q : ℝ → ℝ, q = fun y => expNegInvGlue (y * |y|) := ⟨_, rfl⟩
    have hqC : ContDiff ℝ 1 q := by
      rw [hq_def]
      exact expNegInvGlue.contDiff.comp hmC
    have hq1C : ContDiff ℝ 1 (fun y => q (1 - y)) := hqC.comp (contDiff_const.sub contDiff_id)
    have hDC : ContDiff ℝ 1 (fun y => q y + q (1 - y)) := hqC.add hq1C
    have qpos_arg : ∀ y : ℝ, 0 < y → 0 < y * |y| := fun y hy => by
      rw [abs_of_pos hy]; exact mul_pos hy hy
    have qa : ∀ y : ℝ, y ≤ 0 → q y = 0 := fun y hy => by
      rw [hq_def]
      exact expNegInvGlue.zero_of_nonpos (mul_nonpos_of_nonpos_of_nonneg hy (abs_nonneg y))
    have qb : ∀ y : ℝ, 0 < y → 0 < q y := fun y hy => by
      rw [hq_def]
      exact expNegInvGlue.pos_of_pos (qpos_arg y hy)
    have qc : ∀ y : ℝ, 0 ≤ q y := fun y => by
      rw [hq_def]
      exact expNegInvGlue.nonneg _
    have qd : ∀ y : ℝ, 0 < y → q y = Real.exp (-1 / y ^ 2) := by
      intro y hy
      rw [hq_def]
      show expNegInvGlue (y * |y|) = _
      rw [expNegInvGlue, if_neg (not_le.mpr (qpos_arg y hy)), abs_of_pos hy]
      congr 1
      rw [neg_div, one_div, sq]
    have hDpos : ∀ y : ℝ, 0 < q y + q (1 - y) := by
      intro y
      by_cases hy : 0 < y
      · exact add_pos_of_pos_of_nonneg (qb y hy) (qc _)
      · exact add_pos_of_nonneg_of_pos (qc y) (qb _ (by linarith [not_lt.mp hy]))
    have heq : sigA = fun y => q y / (q y + q (1 - y)) := by
      funext y
      unfold sigA
      split_ifs with h1 h2
      · rw [qa y h1, zero_div]
      · have hy : 0 < y := not_le.mp h1
        rw [qa (1 - y) (by linarith), add_zero, div_self (qb y hy).ne']
      · have hy : 0 < y := not_le.mp h1
        rw [qd y hy, qd (1 - y) (by linarith [not_le.mp h2])]
    rw [heq]
    exact hqC.div hDC (fun y => (hDpos y).ne')

  have sig0 : ∀ t : ℝ, t ≤ 0 → sigA t = 0 := fun t ht => by unfold sigA; simp [ht]
  have sig1 : ∀ t : ℝ, 1 ≤ t → sigA t = 1 := fun t ht => by
    unfold sigA; rw [if_neg (by linarith), if_pos ht]
  have sigR : ∀ t : ℝ, 0 ≤ sigA t ∧ sigA t ≤ 1 := by
    intro t
    unfold sigA
    split_ifs
    · norm_num
    · norm_num
    · have ha := Real.exp_pos (-1 / t ^ 2)
      have hb := Real.exp_pos (-1 / (1 - t) ^ 2)
      exact ⟨div_nonneg ha.le (by linarith), (div_le_one (by linarith)).2 (by linarith)⟩
  have hσd : Differentiable ℝ sigA := hσC.differentiable (by norm_num)
  have hσc : Continuous sigA := hσC.continuous

  have hdσ0 : ∀ t : ℝ, 1 ≤ t → deriv sigA t = 0 := by
    intro t ht
    apply IsLocalMax.deriv_eq_zero
    exact Filter.Eventually.of_forall (fun s => by rw [sig1 t ht]; exact (sigR s).2)
  obtain ⟨B, hB⟩ := isCompact_Icc.exists_bound_of_continuousOn
      ((hσC.continuous_deriv le_rfl).continuousOn (s := Icc (0:ℝ) 1))
  have hσb : ∀ t : ℝ, 0 ≤ t → |deriv sigA t| ≤ max B 0 := by
    intro t ht
    rcases le_total t 1 with h1 | h1
    · have := hB t ⟨ht, h1⟩
      rw [Real.norm_eq_abs] at this
      exact this.trans (le_max_left _ _)
    · rw [hdσ0 t h1, abs_zero]; exact le_max_right _ _

  have kform : ∀ Md : ℝ, 0 < Md → ∀ z : ℝ, 0 < z →
      rfpK Md z = 4 * (1 - sigA (Real.log z / Md)) := by
    intro Md hMd z hz
    unfold rfpK
    split_ifs with h
    · rw [sig0 _ (div_nonpos_of_nonpos_of_nonneg (Real.log_nonpos hz.le h) hMd.le)]; ring
    · rfl
  have kder : ∀ Md : ℝ, 0 < Md → ∀ y : ℝ, 0 < y →
      HasDerivAt (rfpK Md) (4 * (-(deriv sigA (Real.log y / Md) * (y⁻¹ / Md)))) y := by
    intro Md hMd y hy
    have h1 : HasDerivAt (fun z => Real.log z / Md) (y⁻¹ / Md) y :=
      (Real.hasDerivAt_log hy.ne').div_const Md
    have h2 : HasDerivAt (fun z => sigA (Real.log z / Md))
        (deriv sigA (Real.log y / Md) * (y⁻¹ / Md)) y :=
      (hσd _).hasDerivAt.comp y h1
    have h3 := (h2.const_sub 1).const_mul 4
    refine h3.congr_of_eventuallyEq ?_
    filter_upwards [isOpen_Ioi.mem_nhds hy] with z hz
    exact kform Md hMd z hz
  have kle1 : ∀ Md y : ℝ, y ≤ 1 → rfpK Md y = 4 := fun Md y hy => by
    unfold rfpK; rw [if_pos hy]
  have kR : ∀ Md y : ℝ, 0 ≤ rfpK Md y ∧ rfpK Md y ≤ 4 := by
    intro Md y
    unfold rfpK
    split_ifs
    · norm_num
    · constructor <;> nlinarith [sigR (Real.log y / Md)]
  have kdiff : ∀ Md : ℝ, 0 < Md → Differentiable ℝ (rfpK Md) := by
    intro Md hMd y
    rcases lt_or_ge 0 y with hy | hy
    · exact (kder Md hMd y hy).differentiableAt
    · have hev : rfpK Md =ᶠ[nhds y] fun _ => (4:ℝ) := by
        filter_upwards [isOpen_Iio.mem_nhds (show y < 1 by linarith)] with z hz
        exact kle1 Md z (le_of_lt hz)
      exact ((hasDerivAt_const y (4:ℝ)).congr_of_eventuallyEq hev).differentiableAt
  refine ⟨⟨4 * max B 0, mul_nonneg (by norm_num) (le_max_right _ _), ?_⟩, ?_⟩
  · intro Md hMd y hy
    have hy0 : 0 < y := by linarith
    have hMy : 0 < Md * y := mul_pos hMd hy0
    rw [(kder Md hMd y hy0).deriv]
    have ht : 0 ≤ Real.log y / Md := div_nonneg (Real.log_nonneg hy) hMd.le
    have hb := hσb _ ht
    have e : 4 * (-(deriv sigA (Real.log y / Md) * (y⁻¹ / Md))) =
        -(4 * deriv sigA (Real.log y / Md)) / (Md * y) := by
      field_simp
    rw [e, abs_div, abs_neg, abs_mul, abs_of_pos hMy, abs_of_pos (by norm_num : (0:ℝ) < 4)]
    exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hb (by norm_num)) hMy.le
  intro Md Pst lam hMd hPst
  refine ⟨kdiff Md hMd, kR Md, ?_, ?_, ?_⟩
  · intro y hy
    refine ⟨kle1 Md y hy, ?_⟩
    apply IsLocalMax.deriv_eq_zero
    exact Filter.Eventually.of_forall (fun s => by rw [kle1 Md y hy]; exact (kR Md s).2)
  · intro y hy
    have he1 : 1 < Real.exp Md := by linarith [Real.add_one_le_exp Md]
    have hlog : Md ≤ Real.log y := by
      have := Real.log_le_log (Real.exp_pos Md) hy
      rwa [Real.log_exp] at this
    have hk0 : rfpK Md y = 0 := by
      unfold rfpK
      rw [if_neg (by linarith), sig1 _ (by rw [le_div_iff₀ hMd]; linarith)]
      ring
    refine ⟨hk0, ?_⟩
    apply IsLocalMin.deriv_eq_zero
    exact Filter.Eventually.of_forall (fun s => by rw [hk0]; exact (kR Md s).1)

  have hSI : ∀ t : ℝ, HasDerivAt rfpSigI (sigA t) t := fun t =>
    (hσc.integral_hasStrictDerivAt 0 t).hasDerivAt
  have hint : ∀ a b : ℝ, IntervalIntegrable sigA MeasureTheory.volume a b :=
    fun a b => hσc.intervalIntegrable a b
  have hI0 : ∀ t : ℝ, t ≤ 0 → rfpSigI t = 0 := by
