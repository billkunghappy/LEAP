          C1 * Real.exp (-a2 * (v - Lsb B.h G.r0 γ.1 / 2) ^ 2 / Lsb B.h G.r0 γ.1) ∧
        |G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 1 - G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 *
            (c0f5 B G γ * Real.sqrt (1 + G.ustar ^ 2) * (Nfr5 B G γ).1 + sgn γ.2.2 * G.ustar * (Nfr5 B G γ).2)| ≤
          G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 *
            (Ct / Sb γ.1 + Cw * |v - Lsb B.h G.r0 γ.1 / 2| / Lsb B.h G.r0 γ.1) ∧
        |G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 2 - G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 *
            (c0f5 B G γ * Real.sqrt (1 + G.ustar ^ 2) * (Nfr5 B G γ).2 - sgn γ.2.2 * G.ustar * (Nfr5 B G γ).1)| ≤
          G.tH γ (ξ.1, ξ.2.1, ξ.2.2.1) v 0 *
            (Ct / Sb γ.1 + Cw * |v - Lsb B.h G.r0 γ.1 / 2| / Lsb B.h G.r0 γ.1) :=
by
  intro B G hB hG
  obtain ⟨cf, Cf, hcf, hFr⟩ := frame5_consts B G hB hG
  have hh0 : 0 < B.h := hB.2.1.1
  have hh1 : B.h < 1 / 100 := hB.2.1.2.1
  have hr0 : 0 < G.r0 := hG.1.1
  have hr1 : G.r0 ≤ 1 / 100 := hG.1.2.1
  have hu : 0 < G.ustar := hG.1.2.2.1
  obtain ⟨W, hW⟩ : ∃ W : ℝ, W = (1 + G.ustar ^ 2) ^ (3/2:ℝ) := ⟨_, rfl⟩
