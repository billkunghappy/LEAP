      constructor
      · positivity
      · rw [div_le_one (by linarith)]
        linarith
  refine ⟨hf.continuousOn_deriv_of_isOpen isOpen_Ioi le_rfl, fun x hx => ⟨?_, ?_, ?_, ?_⟩⟩
  · exact ((hf.contDiffAt (Ioi_mem_nhds hx)).differentiableAt (by simp)).hasDerivAt
  · obtain ⟨a, b⟩ := hσb ((Real.log (x / Xb) + 2) / 2)
    unfold tailFac
    nlinarith [mul_nonneg hρ0 (sub_nonneg.2 b), mul_nonneg hρ0 a]
  · obtain ⟨a, b⟩ := hσb ((Real.log (x / Xb) + 2) / 2)
    unfold tailFac
    nlinarith [mul_nonneg hρ0 (sub_nonneg.2 b), mul_nonneg hρ0 a]
  · intro hXx
    have hl : 0 ≤ Real.log (x / Xb) := Real.log_nonneg ((one_le_div hXb).2 hXx)
    have hu1 : 1 ≤ (Real.log (x / Xb) + 2) / 2 := by linarith
    have hd := ((((hasDerivAt_id x).div_const Xb).log (div_pos hx hXb).ne').add_const 2).div_const 2
    have h2 := (sigA_flat _ hu1).comp x hd
    have h3 := ((h2.const_sub 1).const_mul ρ).const_sub 1
    have h4 : HasDerivAt (tailFac ρ Xb) _ x := h3
