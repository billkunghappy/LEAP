theorem ax_ratio_perturb : ∀ a b p p0 : ℝ, 53 / 200 ≤ b → |a - b| ≤ 1 / 20 → |p / a - p0 / b| ≤ 5 * |p - p0| + 18 * |p0| * |a - b| :=
