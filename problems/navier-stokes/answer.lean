      ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.coe_fst',
      ContinuousLinearMap.coe_snd', Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk, Prod.mk.injEq]
    constructor <;> field_simp <;> ring
  refine ⟨((0:ℝ), (0:ℝ), (0:ℝ), (cib h l * Tgc ^ (coarseIdx h (qC h ξ) - bandIdx h l)) • vtv),
