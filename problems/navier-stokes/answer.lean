      (by exact (hU.pow 2).sub (contDiffOn_fst.mul (hF.pow 2)))).deriv]
    refine cb _ _ (fun x hx0 hxX => ?_)
    have hm := memS x η hx0 hη1 hη2
    have hUd := slice U hU x η hm
    have hFd := slice F hF x η hm
    have hd : HasDerivAt (fun e => U x e ^ 2 - x * F x e ^ 2)
        (2 * U x η * deriv (fun e => U x e) η - x * (2 * F x η * deriv (fun e => F x e) η)) η := by
      rw [hUd.deriv, hFd.deriv]
      have := (hUd.mul hUd).sub ((hFd.mul hFd).const_mul x)
