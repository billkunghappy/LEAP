  have hyD2 := (h6 l0 (by omega) _ _ _ (hDc 0 2)).2.2.2.1
  have RyD2 := h6 l0 (by omega) _ _ _ hyD2
  have RyZ := h6 l0 (by omega) _ _ _ RZ.2.2.2.1
  have hyD2reg := (g_regular_of_nrm_InM_v5 B _ _ _ _ hok hyD2).1
  have hshell2 : ∀ ξ ∈ DomC B.h (qsOf l0), B.Xa < XC B.h ξ → XC B.h ξ < B.Xb →
      yAvg (EzP5 B G l0 S) ξ = (dR B.h (pmrTh B B.T0z) ξ + pmrTh B B.T0z ξ / ξ.1 + sBase B 2 ξ) +
        dR B.h (yAvg (Dv 0 2)) ξ + yAvg (Dv 0 2) ξ / ξ.1 +
        dZ (yAvg (fun η => Wcov5 B G l0 S 2 2 η + pmP5 B G l0 S η)) ξ := by
