  have hq4 : q < 4 * Qb l := by
    have := (div_lt_iff₀ hQ0).mp hw
    linarith
  have hlog4 : Real.log (4 * Qb l) = (2 - (l:ℝ)) * Real.log 2 := by
    rw [Real.log_mul (by norm_num) hQ0.ne']
    unfold Qb
