  have hJ : ∀ (m : ℤ) (Y : ℝ × ℝ), Jpow m Y = (Lgc ^ m * lamR Y) • vrv + (Tgc ^ m * lamT Y) • vtv :=
    fun _ _ => rfl
  have comp : ∀ X : ℝ × ℝ, Jpow n (Jpow (-n) X) = X := by
    intro X
    rw [hJ n (Jpow (-n) X), hJ (-n) X, (hcoord _ _).1, (hcoord _ _).2, ← mul_assoc, ← mul_assoc,
      hLn, hTn, one_mul, one_mul, hdec]

  have s2 : ∀ (m : ℤ) (Z : ℝ × ℝ) (a : ℝ), Jpow m (Z + a • vtv) = Jpow m Z + (Tgc ^ m * a) • vtv := by
    intro m Z a
    have hc1 : (Z.1 + a * bgc - bgc * (Z.2 + a)) / (1 + bgc ^ 2) = (Z.1 - bgc * Z.2) / (1 + bgc ^ 2) := by
      congr 1; ring
    have hc2 : (bgc * (Z.1 + a * bgc) + (Z.2 + a)) / (1 + bgc ^ 2) =
        (bgc * Z.1 + Z.2) / (1 + bgc ^ 2) + a := by
      field_simp; ring
    unfold Jpow
    rw [hvtv1, hvtv2, hc1, hc2, mul_add, add_smul]
    abel

  have hround : ∀ (x : ℝ) (m : ℤ), |x - m| < 1/2 → round x = m := by
    intro x m hx
    obtain ⟨h1, h2⟩ := abs_lt.mp hx
    rw [round_eq, Int.floor_eq_iff]
    constructor <;> linarith
  set Y0 : ℝ × ℝ := Jpow (-n) (c - r0 • vtv) with hY0
  have e1 : (c - r0 • vtv - c).1 = -(r0 * bgc) := by simp [vtv]
  have e2 : (c - r0 • vtv - c).2 = -r0 := by simp [vtv]
  have hrb : r0 * bgc ≤ r0 := by
    have := mul_le_mul_of_nonneg_left hb1 hr0.le; linarith
  have hrb0 : 0 ≤ r0 * bgc := mul_nonneg hr0.le hb0
  have q1 : round (-(r0 * bgc)) = 0 := by
    apply hround
    rw [Int.cast_zero, sub_zero, abs_neg, abs_of_nonneg hrb0]; linarith
  have q2 : round (-r0) = 0 := by
    apply hround
    rw [Int.cast_zero, sub_zero, abs_neg, abs_of_pos hr0]; linarith
  have hrw : rectW h γ c Y0 = (-(r0 * bgc), -r0) := by
    unfold rectW frac0
    rw [← hn, hY0, comp, e1, e2, q1, q2]
    simp
  have hxi : xiG h γ c Y0 = 0 := by
    unfold xiG
    rw [hrw]
    show (-(r0 * bgc) - bgc * -r0) / (1 + bgc ^ 2) = 0
    rw [show -(r0 * bgc) - bgc * -r0 = 0 by ring, zero_div]
  have het : etG h γ c Y0 = -r0 := by
    unfold etG
    rw [hrw]
    show (bgc * -(r0 * bgc) + -r0) / (1 + bgc ^ 2) = -r0
    rw [div_eq_iff hDne]; ring
  have hvco : vco h r0 γ c Y0 = 0 := by
    unfold vco
    rw [het, neg_add_cancel, zero_div]
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · rw [hxi, abs_zero]; exact hr0.le
  · rw [het, abs_neg, abs_of_pos hr0]
  · intro ξ v
    have key : Jpow (-n) (c + (v * cib h γ.1 - r0) • vtv) =
        Y0 + v • ((cib h γ.1 * Tgc ^ (-n)) • vtv) := by
      rw [show c + (v * cib h γ.1 - r0) • vtv = (c - r0 • vtv) + (v * cib h γ.1) • vtv by
        rw [sub_smul]; abel, s2, smul_smul, hY0]
      congr 2; ring
    rw [hvco, sub_zero, key]
    unfold dVdir
    rw [← hn]
    simp only [Prod.smul_mk, Prod.mk_add_mk, smul_zero, add_zero]

theorem pulse_line_cont5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl), B.ok → 0 < G.r0 → G.r0 ≤ 1/100 → ξ ∈ DomC B.h B.qB → ∃ Mu : ℝ → Matrix (Fin 3) (Fin 3) ℝ, Continuous Mu ∧ ∀ v ∈ Set.Icc (0:ℝ) (Lsb B.h G.r0 γ.1), ∀ y : Fin 3 → ℝ, (Mu v).mulVec y = (APhi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv))).mulVec y - dDamp5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1, Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) • y :=
by
  intro B G γ ξ hB hr0 hr01 hξ
  obtain ⟨Dr, hDr⟩ : ∃ x : ℝ, x = Real.sqrt (Qb γ.1) *
      fderiv ℝ (pcPhi2_5 B G γ) (ξ.1, ξ.2.1, ξ.2.2.1) ((1:ℝ), (0:ℝ), (0:ℝ)) := ⟨_, rfl⟩
  obtain ⟨Dz, hDz⟩ : ∃ x : ℝ, x = Real.sqrt (Qb γ.1) *
      fderiv ℝ (pcPhi2_5 B G γ) (ξ.1, ξ.2.1, ξ.2.2.1) ((0:ℝ), (1:ℝ), (0:ℝ)) := ⟨_, rfl⟩
  obtain ⟨a, ha⟩ : ∃ a : Fin 3 → ℝ,
      a = ![sgn γ.2.2 * Bs5 B G γ * G.ustar / 2, pang5 B G γ / RC γ.1 ξ, pzr5 B G γ] := ⟨_, rfl⟩
  obtain ⟨p, hp⟩ : ∃ p : Fin 3 → ℝ, p = ![-Dr, 0, -Dz] := ⟨_, rfl⟩
  obtain ⟨Km, hKm⟩ : ∃ K : Matrix (Fin 3) (Fin 3) ℝ, K = pcKm5 B γ.1 (ξ.1, ξ.2.1, ξ.2.2.1) :=
    ⟨_, rfl⟩
  obtain ⟨E, hE⟩ : ∃ x : ℝ, x = epsb B.h γ.1 * ((kb B.h γ.1 : ℝ)) ^ 2 := ⟨_, rfl⟩
  have hp1 : p 1 = 0 := by rw [hp]; rfl
  have hQ : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
  have ha1 : a 1 ≠ 0 := by
    have e : a 1 = pang5 B G γ / RC γ.1 ξ := by rw [ha]; rfl
    rw [e]
    have hRC : RC γ.1 ξ ≠ 0 := by
      unfold RC
      exact (div_pos hξ.1 (Real.sqrt_pos.2 hQ)).ne'
    have hpint : (pint5 B G γ : ℝ) ≠ 0 := by
      rw [Int.cast_ne_zero]
      unfold pint5
      split_ifs with h
      · exact one_ne_zero
      · exact h
    have hkb : (kb B.h γ.1 : ℝ) ≠ 0 := by
      have h1 : 0 < epsb B.h γ.1 := by unfold epsb; exact Real.rpow_pos_of_pos hQ _
      have h2 : 0 < epsb B.h γ.1 ^ (-(1/2:ℝ)) := Real.rpow_pos_of_pos h1 _
      have h3 : 0 < kb B.h γ.1 := by unfold kb; exact Nat.ceil_pos.2 h2
      exact_mod_cast h3.ne'
    have hpang : pang5 B G γ ≠ 0 := by unfold pang5; exact div_ne_zero hpint hkb
    exact div_ne_zero hpang hRC
  have hN : Continuous (fun v : ℝ => a + v • p) :=
    continuous_const.add (continuous_id.smul continuous_const)
  have hd : Continuous (fun v : ℝ => dotProduct (a + v • p) (a + v • p)) := hN.dotProduct hN
  have hpos : ∀ v : ℝ, 0 < dotProduct (a + v • p) (a + v • p) := by
    intro v
    have e1 : (a + v • p) 1 = a 1 := by simp [hp1]
    have hs : dotProduct (a + v • p) (a + v • p) = (a + v • p) 0 * (a + v • p) 0 +
        (a + v • p) 1 * (a + v • p) 1 + (a + v • p) 2 * (a + v • p) 2 := by
      simp only [dotProduct, Fin.sum_univ_three]
    rw [hs, e1]
    have t1 := mul_self_pos.2 ha1
    have t2 := mul_self_nonneg ((a + v • p) 0)
    have t3 := mul_self_nonneg ((a + v • p) 2)
    linarith
  have hinv : Continuous (fun v : ℝ => (dotProduct (a + v • p) (a + v • p))⁻¹) :=
    hd.inv₀ (fun v => (hpos v).ne')
  have hR : Continuous (fun v : ℝ =>
      Matrix.vecMulVec (a + v • p) (Matrix.vecMul (a + v • p) Km - p)) :=
    hN.matrix_vecMulVec ((hN.matrix_vecMul continuous_const).sub continuous_const)
  refine ⟨fun v => -Km + (dotProduct (a + v • p) (a + v • p))⁻¹ •
      Matrix.vecMulVec (a + v • p) (Matrix.vecMul (a + v • p) Km - p) -
      (E * dotProduct (a + v • p) (a + v • p)) • (1 : Matrix (Fin 3) (Fin 3) ℝ), ?_, ?_⟩
  · exact (continuous_const.add (hinv.smul hR)).sub ((continuous_const.mul hd).smul continuous_const)
  · intro v hv y
    obtain ⟨hrect, hline⟩ := pulse_line_base5 B.h G.r0 γ (G.ctr γ) hr0 hr01
    obtain ⟨hvco, hin, -⟩ := pulse_line_rect5 B.h G.r0 γ (G.ctr γ)
      (Jpow (-(bandIdx B.h γ.1)) (G.ctr γ - G.r0 • vtv)) hr0 hr01 hrect v hv.1 hv.2
    have h4 : Jpow (-(bandIdx B.h γ.1)) (G.ctr γ - G.r0 • vtv) +
        (v - vco B.h G.r0 γ (G.ctr γ) (Jpow (-(bandIdx B.h γ.1)) (G.ctr γ - G.r0 • vtv))) •
          ((cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) • vtv) =
        Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv) := by
      have := congrArg (fun z : Cyl => z.2.2.2) (hline ξ v)
      exact this
    rw [h4] at hvco hin
    obtain ⟨η, hηdef⟩ : ∃ η : Cyl, η = (ξ.1, ξ.2.1, ξ.2.2.1,
        Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv)) := ⟨_, rfl⟩
    rw [← hηdef]
    have hη4 : η.2.2.2 = Jpow (-(bandIdx B.h γ.1)) (G.ctr γ + (v * cib B.h γ.1 - G.r0) • vtv) := by
      subst hηdef; rfl
    have hproj : ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ) = (ξ.1, ξ.2.1, ξ.2.2.1) := by
      subst hηdef; rfl
    have hRCe : RC γ.1 η = RC γ.1 ξ := by subst hηdef; rfl
    have hηD : η ∈ DomC B.h B.qB := by subst hηdef; exact hξ
    have hxi : |xiG B.h γ (G.ctr γ) η.2.2.2| < 1/8 := by
      rw [hη4]; have := hin.1; linarith
    have het : |etG B.h γ (G.ctr γ) η.2.2.2| < 1/8 := by
      rw [hη4]; have := hin.2; linarith
    obtain ⟨U, c', -, hηU, -, hU⟩ := nPhi5_local_model_v5 B G γ η hB hηD hxi het
    have hN1 := (hU η hηU).2
    rw [hη4, hvco, hproj, hRCe] at hN1
    have hNv : nPhi5 B G γ η = a + v • p := by
      rw [hN1, ha, hp, hDr, hDz]
      funext i
      fin_cases i <;> simp <;> ring
    obtain ⟨U2, -, hη2, -, hU2⟩ := nPhiP5_local_model_v5 B G γ η hB hηD hxi het
    have hP1 := hU2 η hη2
    rw [hproj] at hP1
    have hPv : nPhiP5 B G γ η = p := by rw [hP1, hp, hDr, hDz]
    have hK1 := kmat_slow_form_v5 B G γ hB η hηD
    rw [hproj] at hK1
    have hKv : Kmat B G γ η = Km := by rw [hK1, hKm]
    unfold APhi5 dDamp5
    rw [hNv, hPv, hKv]
    dsimp only
    rw [Matrix.sub_mulVec, Matrix.smul_mulVec, Matrix.one_mulVec, hE]

theorem nb_qpow_v4 : ∀ (B : BG) (qs c : ℝ), B.ok → SimNorm B.h → 0 < qs → qs ≤ 1 → ∀ k : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h qs, NB B.h (fun η => qC B.h η ^ c) k ξ ≤ C * qC B.h ξ ^ c :=
by
  intro B qs c hB hN hqs0 hqs1 j
  have hS : SimScaleProps B.h := hB.1
  unfold SimNorm at hN
  choose C hC using hN

  have key : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (F : E → G) (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  obtain ⟨A, hAdef⟩ : ∃ A : ℝ,
      A = ∑ i ∈ Finset.range (j + 1), |Polynomial.eval c (descPochhammer ℝ i)| := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by rw [hAdef]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = 1 + ∑ i ∈ Finset.range (j + 1), |C i| := ⟨_, rfl⟩
  have hD1 : 1 ≤ D := by
    have := Finset.sum_nonneg (fun k (_ : k ∈ Finset.range (j + 1)) => abs_nonneg (C k))
    rw [hDdef]; linarith
  refine ⟨(j.factorial : ℝ) * A * D ^ j, ?_⟩
  intro ξ hξD
  have hξD' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qs := hξD
  have hξ : ξ.2.2.1 < 1 := hξD'.2.1
  have hq1 : qC B.h ξ ≤ 1 := le_trans hξD'.2.2.le hqs1

  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqpos : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
  have hU : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const

  obtain ⟨F, hFdef⟩ : ∃ F : Cyl → ℝ, F = fun η : Cyl => qC B.h η ^ c := ⟨_, rfl⟩
  obtain ⟨a, hadef⟩ : ∃ a : ℝ, a = qC B.h ξ ^ c := ⟨_, rfl⟩
  suffices hmain : NB B.h F j ξ ≤ (j.factorial : ℝ) * A * D ^ j * a by
    rw [hFdef, hadef] at hmain; exact hmain
  have ha0 : 0 ≤ a := by rw [hadef]; exact Real.rpow_nonneg hq0.le _
  have hFU : ContDiffOn ℝ ∞ F {η : Cyl | η.2.2.1 < 1} := by
    rw [hFdef]
    exact hqC.rpow_const_of_ne (fun η hη => (hqpos η hη).ne')

  obtain ⟨Pm, hPmdef⟩ : ∃ Pm : Cyl →L[ℝ] ℝ × ℝ,
      Pm = ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
        (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))).prod
        (-((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))))) := ⟨_, rfl⟩
  have hPapp : ∀ η : Cyl, Pm η = (η.2.1, -η.2.2.1) := by
    intro η; rw [hPmdef]; simp
  have hP1 : ‖Pm‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
    rw [hPapp η, one_mul, Prod.norm_def (η.2.1, -η.2.2.1)]
    refine max_le ?_ ?_
    · exact (norm_fst_le η.2).trans (norm_snd_le η)
    · exact (norm_neg η.2.2.1).trans_le
        (((norm_fst_le η.2.2).trans (norm_snd_le η.2)).trans (norm_snd_le η))
  obtain ⟨Mq, hMqdef⟩ : ∃ Mq : ℝ × ℝ →L[ℝ] ℝ × ℝ,
      Mq = (qC B.h ξ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
        (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ) := ⟨_, rfl⟩
  obtain ⟨T, hTdef⟩ : ∃ T : Cyl →L[ℝ] ℝ × ℝ, T = Mq.comp Pm := ⟨_, rfl⟩
  obtain ⟨w0, hw0def⟩ : ∃ w0 : ℝ × ℝ, w0 = (ξ.2.1, 1 - ξ.2.2.1) := ⟨_, rfl⟩
  have hW : IsOpen (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
  have hw0 : w0 ∈ (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := by
    rw [hw0def]; exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩

  have hid : ∀ v : Cyl, qC B.h (ξ + Lnorm B.h ξ v) = simScale B.h (w0 + T v).1 (w0 + T v).2 := by
    intro v
    have e1 : (Lnorm B.h ξ v).2.1 = qC B.h ξ ^ (1/2 - B.h) * v.2.1 := by
      simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e2 : (Lnorm B.h ξ v).2.2.1 = qC B.h ξ * v.2.2.1 := by
      simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e3 : T v = (qC B.h ξ ^ (1/2 - B.h) * v.2.1, qC B.h ξ * (-v.2.2.1)) := by
      rw [hTdef, ContinuousLinearMap.comp_apply, hPapp v, hMqdef]
      simp [ContinuousLinearMap.coe_prodMap']
    rw [e3, hw0def]
    show simScale B.h (ξ.2.1 + (Lnorm B.h ξ v).2.1) (1 - (ξ.2.2.1 + (Lnorm B.h ξ v).2.2.1)) =
      simScale B.h (ξ.2.1 + qC B.h ξ ^ (1/2 - B.h) * v.2.1) ((1 - ξ.2.2.1) + qC B.h ξ * (-v.2.2.1))
    rw [e1, e2]
    congr 1
    ring

  obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = {v : Cyl | (ξ + Lnorm B.h ξ v).2.2.1 < 1} := ⟨_, rfl⟩
  have hOmem : ∀ v, v ∈ O ↔ (ξ + Lnorm B.h ξ v).2.2.1 < 1 := by
    intro v; rw [hOdef]; rfl
  have hcontO : Continuous (fun v : Cyl => (ξ + Lnorm B.h ξ v).2.2.1) :=
    ((continuous_const.add (Lnorm B.h ξ).continuous).snd.snd.fst)
  have hO : IsOpen O := by rw [hOdef]; exact isOpen_lt hcontO continuous_const
  have h0O : (0 : Cyl) ∈ O := by
    rw [hOmem, map_zero, add_zero]; exact hξ
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : Cyl → ℝ, ψ = fun v => qC B.h (ξ + Lnorm B.h ξ v) / qC B.h ξ :=
    ⟨_, rfl⟩
  have hψ : ContDiffOn ℝ ∞ ψ O := by
    rw [hψdef]
    exact (hqC.comp (contDiff_const.add (Lnorm B.h ξ).contDiff).contDiffOn
      (fun v hv => (hOmem v).1 hv)).div_const _
  have hψpos : ∀ v ∈ O, 0 < ψ v := by
    intro v hv; rw [hψdef]; exact div_pos (hqpos _ ((hOmem v).1 hv)) hq0
  have hψ0 : ψ 0 = 1 := by
    rw [hψdef]
    show qC B.h (ξ + Lnorm B.h ξ 0) / qC B.h ξ = 1
    rw [map_zero, add_zero]; exact div_self hq0.ne'
  have hψeq : ψ = (qC B.h ξ)⁻¹ • (fun z : Cyl => simScale B.h (w0 + T z).1 (w0 + T z).2) := by
    rw [hψdef]; funext v
    show qC B.h (ξ + Lnorm B.h ξ v) / qC B.h ξ =
      (qC B.h ξ)⁻¹ * simScale B.h (w0 + T v).1 (w0 + T v).2
    rw [hid v, div_eq_inv_mul]
  have hΦ : ContDiffAt ℝ ∞ (fun z : Cyl => simScale B.h (w0 + T z).1 (w0 + T z).2) 0 := by
    have h1 : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (w0 + T 0) := by
      rw [map_zero, add_zero]; exact hS.2.2.2.1.contDiffAt (hW.mem_nhds hw0)
    exact ContDiffAt.comp (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2) (f := fun z : Cyl => w0 + T z)
      (0 : Cyl) h1 (contDiff_const.add T.contDiff).contDiffAt

  have hDψ : ∀ i : ℕ, 1 ≤ i → i ≤ j → ‖iteratedFDerivWithin ℝ i ψ O 0‖ ≤ D ^ i := by
    intro i hi1 hij
    have hcomp : (iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq.comp Pm) =
        ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm) := by
      ext m; rfl
    have hCi : ‖(iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq)‖ ≤ C i * qC B.h ξ := by
      rw [hMqdef, hw0def]; exact hC i ξ.2.1 (1 - ξ.2.2.1) (by linarith) hq1
    have hprod : ∏ k : Fin i, ‖Pm‖ ≤ 1 := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_one₀ (norm_nonneg _) hP1
    have hb1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
      ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq)) (fun _ : Fin i => Pm)
    have hb2 := hb1.trans ((mul_le_of_le_one_right (norm_nonneg _) hprod).trans hCi)
    have hCiD : C i ≤ D := by
      have h2 : |C i| ≤ ∑ k ∈ Finset.range (j + 1), |C k| :=
        Finset.single_le_sum (f := fun k => |C k|) (fun k _ => abs_nonneg _)
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hij))
      have h3 := le_abs_self (C i)
      rw [hDdef]; linarith
    rw [iteratedFDerivWithin_of_isOpen i hO h0O, hψeq,
      iteratedFDeriv_const_smul_apply (hΦ.of_le (by exact_mod_cast le_top)),
      key (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) w0 T hW hS.2.2.2.1 hw0 i,
      norm_smul, hTdef, hcomp, Real.norm_of_nonneg (inv_nonneg.mpr hq0.le)]
    calc (qC B.h ξ)⁻¹ * ‖((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm)‖
        ≤ (qC B.h ξ)⁻¹ * (C i * qC B.h ξ) :=
          mul_le_mul_of_nonneg_left hb2 (inv_nonneg.mpr hq0.le)
      _ = C i := by rw [mul_comm (C i), ← mul_assoc, inv_mul_cancel₀ hq0.ne', one_mul]
      _ ≤ D := hCiD
      _ ≤ D ^ i := le_self_pow₀ hD1 (by omega)

  have hg : ContDiffOn ℝ ∞ (fun x : ℝ => x ^ c) (Set.Ioi 0) :=
    (contDiffOn_id (s := Set.Ioi (0:ℝ))).rpow_const_of_ne (fun x hx => ne_of_gt hx)
  have hψmaps : Set.MapsTo ψ O (Set.Ioi 0) := fun v hv => hψpos v hv
  have hCg : ∀ i ≤ j, ‖iteratedFDerivWithin ℝ i (fun x : ℝ => x ^ c) (Set.Ioi 0) (ψ 0)‖ ≤ A := by
    intro i hi
    rw [hψ0, iteratedFDerivWithin_of_isOpen i isOpen_Ioi (Set.mem_Ioi.mpr (zero_lt_one' ℝ)),
      norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_eq_iterate,
      Real.iter_deriv_rpow_const, Real.one_rpow, mul_one, Real.norm_eq_abs, hAdef]
    exact Finset.single_le_sum (f := fun i => |Polynomial.eval c (descPochhammer ℝ i)|)
      (fun i _ => abs_nonneg _) (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  have hFdB := norm_iteratedFDerivWithin_comp_le hg hψ (by exact_mod_cast le_top)
    isOpen_Ioi.uniqueDiffOn hO.uniqueDiffOn hψmaps h0O (C := A) (D := D) hCg hDψ

  obtain ⟨gl, hgldef⟩ : ∃ gl : ℝ →L[ℝ] ℝ, gl = a • ContinuousLinearMap.id ℝ ℝ := ⟨_, rfl⟩
  have hgl : ‖gl‖ ≤ a := ContinuousLinearMap.opNorm_le_bound _ ha0 (fun x => le_of_eq (by
    rw [hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, norm_smul,
      Real.norm_of_nonneg ha0]))
  have hEq : Set.EqOn (fun z => F (ξ + Lnorm B.h ξ z)) (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O := by
    intro z hz
    have hψz := hψpos z hz
    have e : qC B.h (ξ + Lnorm B.h ξ z) = qC B.h ξ * ψ z := by
      rw [hψdef]
      show _ = qC B.h ξ * (qC B.h (ξ + Lnorm B.h ξ z) / qC B.h ξ)
      field_simp
    show F (ξ + Lnorm B.h ξ z) = gl (ψ z ^ c)
    rw [hFdef, hgldef, ContinuousLinearMap.smul_apply, ContinuousLinearMap.id_apply, smul_eq_mul]
    show qC B.h (ξ + Lnorm B.h ξ z) ^ c = a * ψ z ^ c
    rw [e, Real.mul_rpow hq0.le hψz.le, ← hadef]
  have hgψ : ContDiffOn ℝ ∞ ((fun x : ℝ => x ^ c) ∘ ψ) O := hg.comp hψ hψmaps
  have hNB : NB B.h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := by
    unfold NB
    rw [key F {η : Cyl | η.2.2.1 < 1} ξ (Lnorm B.h ξ) hU hFU hξ j]
  calc NB B.h F j ξ = ‖iteratedFDeriv ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := hNB
    _ = ‖iteratedFDerivWithin ℝ j (fun z => F (ξ + Lnorm B.h ξ z)) O 0‖ := by
        rw [iteratedFDerivWithin_of_isOpen j hO h0O]
    _ = ‖iteratedFDerivWithin ℝ j (⇑gl ∘ ((fun x : ℝ => x ^ c) ∘ ψ)) O 0‖ := by
        rw [iteratedFDerivWithin_congr hEq h0O j]
    _ = ‖gl.compContinuousMultilinearMap
          (iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0)‖ := by
        rw [ContinuousLinearMap.iteratedFDerivWithin_comp_left gl (hgψ.contDiffWithinAt h0O)
          hO.uniqueDiffOn h0O (i := j) (by exact_mod_cast le_top)]
    _ ≤ ‖gl‖ * ‖iteratedFDerivWithin ℝ j ((fun x : ℝ => x ^ c) ∘ ψ) O 0‖ :=
        ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
    _ ≤ a * ((j.factorial : ℝ) * A * D ^ j) := mul_le_mul hgl hFdB (norm_nonneg _) ha0
    _ = (j.factorial : ℝ) * A * D ^ j * a := by ring

theorem outer_profile_bounds_v5 : ∀ B : BG, B.ok → ∀ m : ℕ, ∃ C : ℝ, ∀ q X η : ℝ, 0 < q → q < B.qB → B.Xa / 2 ≤ X → X ≤ 2 * B.Xb → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (logLift B.Eb) (Real.log q, X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (logLift B.Ub) (Real.log q, X, η)‖ ≤ C :=
by
  intro B hok m
  obtain ⟨⟨hh0, -, hXa, -, -, -, -, hqB0, hqB1, -, -, -, -⟩, ⟨hFs, hUs, -, hFb⟩, -, -, -, -,
    ⟨hEs, hUbs, -, hdev⟩, -, -, -, -, -⟩ := hok.2
  have hS : IsOpen (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hWo : IsOpen (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) :=
    isOpen_Iio.prod hS
  have hX0 : 0 < B.Xa / 2 := by linarith

  have hpt : ∀ p : ℝ × ℝ, p.1 ≠ 0 → ContDiffAt ℝ ∞ (fun p : ℝ × ℝ => Real.sqrt (2 * p.1)) p := by
    intro p hp
    exact (contDiffAt_const.mul contDiffAt_fst).sqrt (mul_ne_zero two_ne_zero hp)
  have hsqS : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Real.sqrt (2 * p.1))
      (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) :=
    fun p hp => (hpt p (ne_of_gt hp.1)).contDiffWithinAt
  have hMs : ∀ k : ℕ, ∃ M : ℝ, ∀ p ∈ Set.Icc (B.Xa / 2) (2 * B.Xb) ×ˢ Set.Icc (-1:ℝ) 1,
      ‖iteratedFDeriv ℝ k (fun p : ℝ × ℝ => Real.sqrt (2 * p.1)) p‖ ≤ M := by
    intro k
    have hK : IsCompact (Set.Icc (B.Xa / 2) (2 * B.Xb) ×ˢ Set.Icc (-1:ℝ) 1) :=
      isCompact_Icc.prod isCompact_Icc
    have hc : ContinuousOn (iteratedFDeriv ℝ k (fun p : ℝ × ℝ => Real.sqrt (2 * p.1)))
        (Set.Icc (B.Xa / 2) (2 * B.Xb) ×ˢ Set.Icc (-1:ℝ) 1) := by
      refine continuousOn_of_forall_continuousAt (fun p hp => ?_)
      exact (hpt p (ne_of_gt (lt_of_lt_of_le hX0 hp.1.1))).continuousAt_iteratedFDeriv
        (by exact_mod_cast le_top)
    exact hK.exists_bound_of_continuousOn hc
  choose Ms hMs using hMs
  choose MF hMF using hFb (B.Xa / 2) (2 * B.Xb) hX0
  obtain ⟨C7, hC7⟩ := hdev (B.Xa / 2) (2 * B.Xb) hX0 m
  have hsum0 : 0 ≤ ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * |Ms i| * |MF (m - i)| :=
    Finset.sum_nonneg (fun i _ => by positivity)
  obtain ⟨C1, hC1⟩ : ∃ C : ℝ,
      C = ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * |Ms i| * |MF (m - i)| + |MF m| := ⟨_, rfl⟩

  have hP2s : ContDiffOn ℝ ∞ (fun p : ℝ × ℝ => Real.sqrt (2 * p.1) * (↿B.F) p)
      (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) := hsqS.mul hFs
  have hP2b : ∀ X η : ℝ, B.Xa / 2 ≤ X → X ≤ 2 * B.Xb → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (fun p : ℝ × ℝ => Real.sqrt (2 * p.1) * (↿B.F) p) (X, η)‖ ≤ C1 := by
    intro X η h1 h2 h3 h4
    have hpS : ((X, η) : ℝ × ℝ) ∈ Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1 :=
      ⟨lt_of_lt_of_le hX0 h1, h3, h4⟩
    have hL : ‖iteratedFDerivWithin ℝ m (fun p : ℝ × ℝ => Real.sqrt (2 * p.1) * (↿B.F) p)
        (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) (X, η)‖ ≤
        ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) *
          ‖iteratedFDerivWithin ℝ i (fun p : ℝ × ℝ => Real.sqrt (2 * p.1))
            (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) (X, η)‖ *
          ‖iteratedFDerivWithin ℝ (m - i) (↿B.F) (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) (X, η)‖ :=
      norm_iteratedFDerivWithin_mul_le hsqS hFs hS.uniqueDiffOn hpS (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen m hS hpS] at hL
    have hterm : ∀ i ∈ Finset.range (m + 1), (m.choose i : ℝ) *
          ‖iteratedFDerivWithin ℝ i (fun p : ℝ × ℝ => Real.sqrt (2 * p.1))
            (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) (X, η)‖ *
          ‖iteratedFDerivWithin ℝ (m - i) (↿B.F) (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) (X, η)‖ ≤
        (m.choose i : ℝ) * |Ms i| * |MF (m - i)| := by
      intro i _
      rw [iteratedFDerivWithin_of_isOpen i hS hpS, iteratedFDerivWithin_of_isOpen (m - i) hS hpS]
      have a := (hMs i (X, η) ⟨⟨h1, h2⟩, h3.le, h4.le⟩).trans (le_abs_self _)
      have b := ((hMF (m - i) X η h1 h2 h3 h4).1).trans (le_abs_self _)
      have c : (0:ℝ) ≤ (m.choose i : ℝ) := Nat.cast_nonneg _
      exact mul_le_mul (mul_le_mul_of_nonneg_left a c) b (norm_nonneg _)
        (mul_nonneg c (abs_nonneg _))
    calc _ ≤ _ := hL
      _ ≤ _ := Finset.sum_le_sum hterm
      _ ≤ C1 := by rw [hC1]; linarith [abs_nonneg (MF m)]

  have hproj : ∀ (f : ℝ × ℝ → ℝ), ContDiffOn ℝ ∞ f (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) → ∀ (m : ℕ)
      (w : ℝ × ℝ × ℝ), w.2 ∈ Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1 →
      ‖iteratedFDeriv ℝ m (fun w : ℝ × ℝ × ℝ => f w.2) w‖ ≤ ‖iteratedFDeriv ℝ m f w.2‖ := by
    intro f hf m w hw
    let π := ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)
    have hU : IsOpen (π ⁻¹' (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) := hS.preimage π.continuous
    have hwU : w ∈ π ⁻¹' (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) := hw
    have h1 := ContinuousLinearMap.iteratedFDerivWithin_comp_right π hf hS.uniqueDiffOn
      hU.uniqueDiffOn hwU (n := ∞) (i := m) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen m hU hwU,
      iteratedFDerivWithin_of_isOpen m hS (show π w ∈ Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1 from hw)] at h1
    have e : (fun w : ℝ × ℝ × ℝ => f w.2) = f ∘ π := rfl
    rw [e, h1]
    refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
    have hp : ∏ _i : Fin m, ‖π‖ ≤ 1 := by
      rw [Finset.prod_const]
      exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_snd_le ℝ ℝ (ℝ × ℝ))
    calc ‖iteratedFDeriv ℝ m f (π w)‖ * ∏ _i : Fin m, ‖π‖ ≤ ‖iteratedFDeriv ℝ m f (π w)‖ * 1 :=
          mul_le_mul_of_nonneg_left hp (norm_nonneg _)
      _ = ‖iteratedFDeriv ℝ m f w.2‖ := mul_one _

  refine ⟨|C7| + C1, ?_⟩
  intro q X η hq hqB hX1 hX2 hη1 hη2
  have hw : ((Real.log q, X, η) : ℝ × ℝ × ℝ) ∈
      Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) :=
    ⟨Real.log_lt_log hq hqB, lt_of_lt_of_le hX0 hX1, hη1, hη2⟩
  have hnhds := hWo.mem_nhds hw
  have hsnd : Set.MapsTo (Prod.snd : ℝ × ℝ × ℝ → ℝ × ℝ)
      (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1))
      (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1) := fun w hw => hw.2
  have hPE : ContDiffOn ℝ ∞ (fun v : ℝ × ℝ × ℝ => Real.sqrt (2 * v.2.1) * B.F v.2.1 v.2.2)
      (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) :=
    hP2s.comp contDiff_snd.contDiffOn hsnd
  have hPU : ContDiffOn ℝ ∞ (fun v : ℝ × ℝ × ℝ => B.U v.2.1 v.2.2)
      (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) :=
    hUs.comp contDiff_snd.contDiffOn hsnd
  have hqp0 : 0 ≤ q ^ (2 * B.h) := Real.rpow_nonneg hq.le _
  have hqp1 : q ^ (2 * B.h) ≤ 1 := Real.rpow_le_one hq.le (hqB.le.trans hqB1) (by linarith)
  have hC7a : C7 * q ^ (2 * B.h) ≤ |C7| :=
    (mul_le_mul_of_nonneg_right (le_abs_self _) hqp0).trans
      (mul_le_of_le_one_right (abs_nonneg _) hqp1)
  obtain ⟨hdE, hdU, -⟩ := hC7 q X η hq hqB hX1 hX2 hη1 hη2
  have hsplit : ∀ (L P : ℝ × ℝ × ℝ → ℝ),
      ContDiffOn ℝ ∞ L (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) →
      ContDiffOn ℝ ∞ P (Set.Iio (Real.log B.qB) ×ˢ (Set.Ioi (0:ℝ) ×ˢ Set.Ioo (-1:ℝ) 1)) →
      ‖iteratedFDeriv ℝ m (fun w => L w - P w) (Real.log q, X, η)‖ ≤ C7 * q ^ (2 * B.h) →
      ‖iteratedFDeriv ℝ m P (Real.log q, X, η)‖ ≤ C1 →
      ‖iteratedFDeriv ℝ m L (Real.log q, X, η)‖ ≤ |C7| + C1 := by
    intro L P hL hP h1 h2
    have e : L = (fun w => L w - P w) + P := by
      funext w
      simp
    rw [e, iteratedFDeriv_add_apply (((hL.sub hP).contDiffAt hnhds).of_le (by exact_mod_cast le_top))
      ((hP.contDiffAt hnhds).of_le (by exact_mod_cast le_top))]
    exact (norm_add_le _ _).trans (add_le_add (h1.trans hC7a) h2)
  refine ⟨hsplit _ _ hEs hPE hdE ?_, hsplit _ _ hUbs hPU hdU ?_⟩
  · exact (hproj _ hP2s m _ hw.2).trans (hP2b X η hX1 hX2 hη1 hη2)
  · refine (hproj _ hUs m _ hw.2).trans (((hMF m X η hX1 hX2 hη1 hη2).2).trans ?_)
    rw [hC1]
    linarith [le_abs_self (MF m)]

theorem logqC_nb_v5 : ∀ B : BG, B.ok → ∀ i : ℕ, 1 ≤ i → ∃ C : ℝ, ∀ ξ ∈ DomC B.h B.qB, NB B.h (fun η : Cyl => Real.log (qC B.h η)) i ξ ≤ C :=
by
  intro B hok n hn
  have hS : SimScaleProps B.h := hok.1
  obtain ⟨-, -, -, -, -, -, -, -, hqB1, -, -, -, -⟩ := hok.2.1

  have simN : ∀ h : ℝ, SimScaleProps h → SimNorm h := by
    intro h hS
    obtain ⟨hS1, -, -, -, hS5⟩ := hS
    open Pointwise in
    have hom : ∀ μ z τ : ℝ, 0 < μ →
        simScale h (μ ^ (1/2 - h) * z) (μ * τ) = μ * simScale h z τ := by
      intro μ z τ hμ
      have key : ∀ p : ℝ, 0 < p → μ * p - (μ ^ (1/2 - h) * z) ^ 2 * (μ * p) ^ (2 * h) =
          μ * (p - z ^ 2 * p ^ (2 * h)) := by
        intro p hp
        have sq : (μ ^ (1/2 - h)) ^ 2 = μ ^ (1 - 2 * h) := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul hμ.le]
          congr 1
          push_cast
          ring
        have split : μ ^ (1 - 2 * h) * μ ^ (2 * h) = μ := by
          rw [← Real.rpow_add hμ]
          have e : 1 - 2 * h + 2 * h = 1 := by ring
          rw [e, Real.rpow_one]
        rw [mul_pow, sq, Real.mul_rpow hμ.le hp.le]
        linear_combination (-(z ^ 2 * p ^ (2 * h))) * split
      have hset : {q : ℝ | 0 < q ∧ μ * τ ≤ q - (μ ^ (1/2 - h) * z) ^ 2 * q ^ (2 * h)} =
          μ • {p : ℝ | 0 < p ∧ τ ≤ p - z ^ 2 * p ^ (2 * h)} := by
        ext q
        rw [Set.mem_smul_set_iff_inv_smul_mem₀ hμ.ne', smul_eq_mul]
        simp only [Set.mem_setOf_eq]
        have hq : q = μ * (μ⁻¹ * q) := by field_simp
        constructor
        · rintro ⟨hq0, hle⟩
          have hp : 0 < μ⁻¹ * q := mul_pos (inv_pos.mpr hμ) hq0
          refine ⟨hp, ?_⟩
          rw [hq, key _ hp] at hle
          exact le_of_mul_le_mul_left hle hμ
        · rintro ⟨hp, hle⟩
          refine ⟨by rw [hq]; exact mul_pos hμ hp, ?_⟩
          rw [hq, key _ hp]
          exact mul_le_mul_of_nonneg_left hle hμ.le
      unfold simScale
      rw [hset, Real.sInf_smul_of_nonneg hμ.le, smul_eq_mul]
    intro k
    obtain ⟨C, hC⟩ : ∃ C : ℝ, ∀ Z T : ℝ, 0 < T → simScale h Z T = 1 →
        ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (Z, T)‖ ≤ C := by
      rcases Nat.eq_zero_or_pos k with hk | hk
      · subst hk
        refine ⟨1, fun Z T _ h1 => ?_⟩
        rw [norm_iteratedFDeriv_zero]
        show ‖simScale h Z T‖ ≤ 1
        rw [h1, norm_one]
      · obtain ⟨C, hC⟩ := hS5 k hk
        refine ⟨C, fun Z T hT h1 => ?_⟩
        have := hC Z T hT h1.le
        rwa [h1, Real.one_rpow, mul_one] at this
    refine ⟨C, fun z τ hτ _ => ?_⟩
    obtain ⟨hQ0, -⟩ := hS1 z τ hτ
    obtain ⟨Q, hQd⟩ : ∃ Q, Q = simScale h z τ := ⟨_, rfl⟩
    rw [← hQd] at hQ0 ⊢
    obtain ⟨Z, hZ⟩ : ∃ Z : ℝ, Z = Q ^ (-(1/2 - h)) * z := ⟨_, rfl⟩
    obtain ⟨T, hT⟩ : ∃ T : ℝ, T = Q⁻¹ * τ := ⟨_, rfl⟩
    have hT0 : 0 < T := by rw [hT]; exact mul_pos (inv_pos.mpr hQ0) hτ
    have hZT : simScale h Z T = 1 := by
      have := hom Q⁻¹ z τ (inv_pos.mpr hQ0)
      rw [Real.inv_rpow hQ0.le, ← Real.rpow_neg hQ0.le, ← hQd, inv_mul_cancel₀ hQ0.ne'] at this
      rw [hZ, hT]
      exact this
    have hzb : Q ^ (1/2 - h) * Z = z := by
      rw [hZ, ← mul_assoc, ← Real.rpow_add hQ0]
      simp
    have hτb : Q * T = τ := by
      rw [hT]
      exact mul_inv_cancel_left₀ hQ0.ne' τ
    have hpa : 0 < Q ^ (1/2 - h) := Real.rpow_pos_of_pos hQ0 _
    let e₁ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 (Q ^ (1/2 - h)) hpa.ne')
    let e₂ : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 Q hQ0.ne')
    let L : (ℝ × ℝ) ≃L[ℝ] (ℝ × ℝ) := e₁.prodCongr e₂
    let M : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 Q hQ0.ne')
    have hL : ∀ x : ℝ × ℝ, L x = (Q ^ (1/2 - h) * x.1, Q * x.2) := by
      intro x
      simp [L, e₁, e₂, mul_comm]
    have hM : ∀ y : ℝ, M y = Q * y := by
      intro y
      simp [M, mul_comm]
    have hfun : (fun w : ℝ × ℝ => simScale h w.1 w.2) ∘ L =
        M ∘ (fun w : ℝ × ℝ => simScale h w.1 w.2) := by
      funext w
      simp only [Function.comp, hL, hM]
      exact hom Q w.1 w.2 hQ0
    have hLclm : (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)) =
        (Q ^ (1/2 - h) • ContinuousLinearMap.id ℝ ℝ).prodMap (Q • ContinuousLinearMap.id ℝ ℝ) := by
      apply ContinuousLinearMap.ext
      intro x
      apply Prod.ext
      · simp [hL]
      · simp [hL]
    have hLv : L (Z, T) = (z, τ) := by
      rw [hL]
      exact Prod.ext hzb hτb
    have hcomp : iteratedFDeriv ℝ k ((fun w : ℝ × ℝ => simScale h w.1 w.2) ∘ L) (Z, T) =
        (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (L (Z, T))).compContinuousLinearMap
          (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) := by
      have := L.iteratedFDerivWithin_comp_right (fun w : ℝ × ℝ => simScale h w.1 w.2)
        uniqueDiffOn_univ (mem_univ (L (Z, T))) k
      rwa [preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at this
    have key : (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (z, τ)).compContinuousLinearMap
          (fun _ => (L : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ))) =
        (M : ℝ →L[ℝ] ℝ).compContinuousMultilinearMap
          (iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (Z, T)) := by
      rw [← hLv, ← hcomp, hfun, M.iteratedFDeriv_comp_left]
    have hMn : ‖(M : ℝ →L[ℝ] ℝ)‖ ≤ Q := by
      refine ContinuousLinearMap.opNorm_le_bound _ hQ0.le fun y => ?_
      show ‖M y‖ ≤ Q * ‖y‖
      rw [hM, norm_mul, Real.norm_eq_abs Q, abs_of_pos hQ0]
    rw [← hLclm, key]
    calc _ ≤ ‖(M : ℝ →L[ℝ] ℝ)‖ *
            ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => simScale h w.1 w.2) (Z, T)‖ :=
          ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
      _ ≤ Q * C := mul_le_mul hMn (hC Z T hT0 hZT) (norm_nonneg _) hQ0.le
      _ = C * Q := mul_comm _ _
  have hN := simN B.h hS
  unfold SimNorm at hN
  choose C hC using hN

  have key : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (F : E → G) (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  obtain ⟨D0, hD0⟩ : ∃ x : ℝ, x = ∑ j ∈ Finset.range (n + 1),
      ‖iteratedFDerivWithin ℝ j Real.log (Set.Ioi 0) 1‖ := ⟨_, rfl⟩
  have hlog : ContDiffOn ℝ ∞ Real.log (Set.Ioi 0) :=
    Real.contDiffOn_log.mono (fun x (hx : x ∈ Set.Ioi (0:ℝ)) =>
      Set.mem_compl_singleton_iff.mpr (ne_of_gt hx))
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = 1 + ∑ i ∈ Finset.range (n + 1), |C i| := ⟨_, rfl⟩
  have hD1 : 1 ≤ D := by
    have := Finset.sum_nonneg (fun k (_ : k ∈ Finset.range (n + 1)) => abs_nonneg (C k))
    rw [hDdef]; linarith
  refine ⟨(n.factorial : ℝ) * D0 * D ^ n, ?_⟩
  intro ξ hξD
  have hξD' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < B.qB := hξD
  have hξ : ξ.2.2.1 < 1 := hξD'.2.1
  have hq1 : qC B.h ξ ≤ 1 := le_trans hξD'.2.2.le hqB1

  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqpos : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
  have hU : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const

  obtain ⟨F, hFdef⟩ : ∃ F : Cyl → ℝ, F = fun η : Cyl => Real.log (qC B.h η) := ⟨_, rfl⟩
  suffices hmain : NB B.h F n ξ ≤ (n.factorial : ℝ) * D0 * D ^ n by
    rw [hFdef] at hmain; exact hmain
  have hFU : ContDiffOn ℝ ∞ F {η : Cyl | η.2.2.1 < 1} := by
    rw [hFdef]
    exact hqC.log (fun η hη => (hqpos η hη).ne')

  obtain ⟨Pm, hPmdef⟩ : ∃ Pm : Cyl →L[ℝ] ℝ × ℝ,
      Pm = ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
        (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))).prod
        (-((ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).comp ((ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × ℝ))).comp
          (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ))))))) := ⟨_, rfl⟩
  have hPapp : ∀ η : Cyl, Pm η = (η.2.1, -η.2.2.1) := by
    intro η; rw [hPmdef]; simp
  have hP1 : ‖Pm‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
    rw [hPapp η, one_mul, Prod.norm_def (η.2.1, -η.2.2.1)]
    refine max_le ?_ ?_
    · exact (norm_fst_le η.2).trans (norm_snd_le η)
    · exact (norm_neg η.2.2.1).trans_le
        (((norm_fst_le η.2.2).trans (norm_snd_le η.2)).trans (norm_snd_le η))
  obtain ⟨Mq, hMqdef⟩ : ∃ Mq : ℝ × ℝ →L[ℝ] ℝ × ℝ,
      Mq = (qC B.h ξ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap
        (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ) := ⟨_, rfl⟩
  obtain ⟨T, hTdef⟩ : ∃ T : Cyl →L[ℝ] ℝ × ℝ, T = Mq.comp Pm := ⟨_, rfl⟩
  obtain ⟨w0, hw0def⟩ : ∃ w0 : ℝ × ℝ, w0 = (ξ.2.1, 1 - ξ.2.2.1) := ⟨_, rfl⟩
  have hW : IsOpen (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := isOpen_univ.prod isOpen_Ioi
  have hw0 : w0 ∈ (Set.univ ×ˢ Set.Ioi (0:ℝ) : Set (ℝ × ℝ)) := by
    rw [hw0def]; exact ⟨Set.mem_univ _, show (0:ℝ) < 1 - ξ.2.2.1 by linarith⟩

  have hid : ∀ v : Cyl, qC B.h (ξ + Lnorm B.h ξ v) = simScale B.h (w0 + T v).1 (w0 + T v).2 := by
    intro v
    have e1 : (Lnorm B.h ξ v).2.1 = qC B.h ξ ^ (1/2 - B.h) * v.2.1 := by
      simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e2 : (Lnorm B.h ξ v).2.2.1 = qC B.h ξ * v.2.2.1 := by
      simp [Lnorm, ContinuousLinearMap.coe_prodMap']
    have e3 : T v = (qC B.h ξ ^ (1/2 - B.h) * v.2.1, qC B.h ξ * (-v.2.2.1)) := by
      rw [hTdef, ContinuousLinearMap.comp_apply, hPapp v, hMqdef]
      simp [ContinuousLinearMap.coe_prodMap']
    rw [e3, hw0def]
    show simScale B.h (ξ.2.1 + (Lnorm B.h ξ v).2.1) (1 - (ξ.2.2.1 + (Lnorm B.h ξ v).2.2.1)) =
      simScale B.h (ξ.2.1 + qC B.h ξ ^ (1/2 - B.h) * v.2.1) ((1 - ξ.2.2.1) + qC B.h ξ * (-v.2.2.1))
    rw [e1, e2]
    congr 1
    ring

  obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = {v : Cyl | (ξ + Lnorm B.h ξ v).2.2.1 < 1} := ⟨_, rfl⟩
  have hOmem : ∀ v, v ∈ O ↔ (ξ + Lnorm B.h ξ v).2.2.1 < 1 := by
    intro v; rw [hOdef]; rfl
  have hcontO : Continuous (fun v : Cyl => (ξ + Lnorm B.h ξ v).2.2.1) :=
    ((continuous_const.add (Lnorm B.h ξ).continuous).snd.snd.fst)
  have hO : IsOpen O := by rw [hOdef]; exact isOpen_lt hcontO continuous_const
  have h0O : (0 : Cyl) ∈ O := by
    rw [hOmem, map_zero, add_zero]; exact hξ
  obtain ⟨R, hRdef⟩ : ∃ R : Cyl → ℝ, R = fun v => qC B.h (ξ + Lnorm B.h ξ v) / qC B.h ξ :=
    ⟨_, rfl⟩
  have hR : ContDiffOn ℝ ∞ R O := by
    rw [hRdef]
    exact (hqC.comp (contDiff_const.add (Lnorm B.h ξ).contDiff).contDiffOn
      (fun v hv => (hOmem v).1 hv)).div_const _
  have hRpos : ∀ v ∈ O, 0 < R v := by
    intro v hv; rw [hRdef]; exact div_pos (hqpos _ ((hOmem v).1 hv)) hq0
  have hR0 : R 0 = 1 := by
    rw [hRdef]
    show qC B.h (ξ + Lnorm B.h ξ 0) / qC B.h ξ = 1
    rw [map_zero, add_zero]; exact div_self hq0.ne'
  have hReq : R = (qC B.h ξ)⁻¹ • (fun z : Cyl => simScale B.h (w0 + T z).1 (w0 + T z).2) := by
    rw [hRdef]; funext v
    show qC B.h (ξ + Lnorm B.h ξ v) / qC B.h ξ =
      (qC B.h ξ)⁻¹ * simScale B.h (w0 + T v).1 (w0 + T v).2
    rw [hid v, div_eq_inv_mul]
  have hΦ : ContDiffAt ℝ ∞ (fun z : Cyl => simScale B.h (w0 + T z).1 (w0 + T z).2) 0 := by
    have h1 : ContDiffAt ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (w0 + T 0) := by
      rw [map_zero, add_zero]; exact hS.2.2.2.1.contDiffAt (hW.mem_nhds hw0)
    exact ContDiffAt.comp (g := fun w : ℝ × ℝ => simScale B.h w.1 w.2) (f := fun z : Cyl => w0 + T z)
      (0 : Cyl) h1 (contDiff_const.add T.contDiff).contDiffAt

  have hDR : ∀ i : ℕ, 1 ≤ i → i ≤ n → ‖iteratedFDerivWithin ℝ i R O 0‖ ≤ D ^ i := by
    intro i hi1 hij
    have hcomp : (iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq.comp Pm) =
        ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm) := by
      ext m; rfl
    have hCi : ‖(iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq)‖ ≤ C i * qC B.h ξ := by
      rw [hMqdef, hw0def]; exact hC i ξ.2.1 (1 - ξ.2.2.1) (by linarith) hq1
    have hprod : ∏ k : Fin i, ‖Pm‖ ≤ 1 := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_one₀ (norm_nonneg _) hP1
    have hb1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
      ((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
        (fun _ => Mq)) (fun _ : Fin i => Pm)
    have hb2 := hb1.trans ((mul_le_of_le_one_right (norm_nonneg _) hprod).trans hCi)
    have hCiD : C i ≤ D := by
      have h2 : |C i| ≤ ∑ k ∈ Finset.range (n + 1), |C k| :=
        Finset.single_le_sum (f := fun k => |C k|) (fun k _ => abs_nonneg _)
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hij))
      have h3 := le_abs_self (C i)
      rw [hDdef]; linarith
    rw [iteratedFDerivWithin_of_isOpen i hO h0O, hReq,
      iteratedFDeriv_const_smul_apply (hΦ.of_le (by exact_mod_cast le_top)),
      key (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) w0 T hW hS.2.2.2.1 hw0 i,
      norm_smul, hTdef, hcomp, Real.norm_of_nonneg (inv_nonneg.mpr hq0.le)]
    calc (qC B.h ξ)⁻¹ * ‖((iteratedFDeriv ℝ i (fun w : ℝ × ℝ => simScale B.h w.1 w.2) w0).compContinuousLinearMap
          (fun _ => Mq)).compContinuousLinearMap (fun _ => Pm)‖
        ≤ (qC B.h ξ)⁻¹ * (C i * qC B.h ξ) :=
          mul_le_mul_of_nonneg_left hb2 (inv_nonneg.mpr hq0.le)
      _ = C i := by rw [mul_comm (C i), ← mul_assoc, inv_mul_cancel₀ hq0.ne', one_mul]
      _ ≤ D := hCiD
      _ ≤ D ^ i := le_self_pow₀ hD1 (by omega)

  have hRmaps : Set.MapsTo R O (Set.Ioi 0) := fun v hv => hRpos v hv
  have hEq : Set.EqOn (fun z => F (ξ + Lnorm B.h ξ z))
      ((fun _ : Cyl => Real.log (qC B.h ξ)) + Real.log ∘ R) O := by
    intro z hz
    have hRz := hRpos z hz
    have e : qC B.h (ξ + Lnorm B.h ξ z) = qC B.h ξ * R z := by
      rw [hRdef]
      show _ = qC B.h ξ * (qC B.h (ξ + Lnorm B.h ξ z) / qC B.h ξ)
      field_simp
    show F (ξ + Lnorm B.h ξ z) = Real.log (qC B.h ξ) + Real.log (R z)
    rw [hFdef]
    show Real.log (qC B.h (ξ + Lnorm B.h ξ z)) = Real.log (qC B.h ξ) + Real.log (R z)
    rw [e, Real.log_mul hq0.ne' hRz.ne']
  have hlogR : ContDiffOn ℝ ∞ (Real.log ∘ R) O := hlog.comp hR hRmaps
  have hsplit : iteratedFDerivWithin ℝ n ((fun _ : Cyl => Real.log (qC B.h ξ)) + Real.log ∘ R) O 0 =
      iteratedFDerivWithin ℝ n (Real.log ∘ R) O 0 := by
    rw [iteratedFDerivWithin_add_apply contDiffWithinAt_const
      ((hlogR.contDiffWithinAt h0O).of_le (by exact_mod_cast le_top)) hO.uniqueDiffOn h0O,
      iteratedFDerivWithin_const_of_ne (by omega : n ≠ 0)]
    simp only [Pi.zero_apply, zero_add]
  have hCg : ∀ j ≤ n, ‖iteratedFDerivWithin ℝ j Real.log (Set.Ioi 0) (R 0)‖ ≤ D0 := by
    intro j hj
    rw [hR0, hD0]
    exact Finset.single_le_sum (f := fun k => ‖iteratedFDerivWithin ℝ k Real.log (Set.Ioi 0) 1‖)
      (fun k _ => norm_nonneg _) (Finset.mem_range.mpr (by omega))
  have hFdB := norm_iteratedFDerivWithin_comp_le hlog hR (by exact_mod_cast le_top)
    isOpen_Ioi.uniqueDiffOn hO.uniqueDiffOn hRmaps h0O (C := D0) (D := D) hCg hDR
  have hNB : NB B.h F n ξ = ‖iteratedFDeriv ℝ n (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := by
    unfold NB
    rw [key F {η : Cyl | η.2.2.1 < 1} ξ (Lnorm B.h ξ) hU hFU hξ n]
  calc NB B.h F n ξ = ‖iteratedFDeriv ℝ n (fun z => F (ξ + Lnorm B.h ξ z)) 0‖ := hNB
    _ = ‖iteratedFDerivWithin ℝ n (fun z => F (ξ + Lnorm B.h ξ z)) O 0‖ := by
        rw [iteratedFDerivWithin_of_isOpen n hO h0O]
    _ = ‖iteratedFDerivWithin ℝ n ((fun _ : Cyl => Real.log (qC B.h ξ)) + Real.log ∘ R) O 0‖ := by
        rw [iteratedFDerivWithin_congr hEq h0O n]
    _ = ‖iteratedFDerivWithin ℝ n (Real.log ∘ R) O 0‖ := by rw [hsplit]
    _ ≤ _ := hFdB

theorem nb_real_algebra_v5 : ∀ (h : ℝ) (U : Set Cyl) (ξ : Cyl), IsOpen U → ξ ∈ U → ∀ (f g : Cyl → ℝ), ContDiffOn ℝ ∞ f U → ContDiffOn ℝ ∞ g U → ∀ k : ℕ, NB h (fun η => f η * g η) k ξ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * NB h f i ξ * NB h g (k - i) ξ ∧ (∀ a b : ℝ, NB h (fun η => a * f η + b * g η) k ξ ≤ |a| * NB h f k ξ + |b| * NB h g k ξ) ∧ (∀ a : ℝ, NB h (fun _ : Cyl => a) k ξ ≤ if k = 0 then |a| else 0) :=
by
  intro h U ξ hU hξ f g hf hg k

  have leib : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (U : Set Cyl) (n : ℕ),
      IsOpen U → ξ ∈ U → ∀ (f : Cyl → ℝ) (g : Cyl → V), ContDiffOn ℝ n f U → ContDiffOn ℝ n g U →
      NB h (fun η => f η • g η) n ξ ≤
        ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * NB h f i ξ * NB h g (n - i) ξ := by
    intro V _ _ U n hU hξ f g hf hg
    unfold NB
    generalize Lnorm h ξ = L
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
    have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + z)) s := by
      intro W _ _ F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
      intro W _ _ F hF
      exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
    have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ∀ i : ℕ, i ≤ n →
        iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
          (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
      intro W _ _ F hF i hi
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
      calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
              (fun _ => L) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
              (fun _ => L) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
              (fun _ => L) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
    have hfg : ContDiffOn ℝ n (fun η => f η • g η) U := hf.smul hg
    have hl := norm_iteratedFDerivWithin_smul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
      (n := n) le_rfl
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) • g (ξ + L y)) n hO h0O] at hl
    rw [← key _ hfg n le_rfl]
    calc ‖iteratedFDeriv ℝ n (fun z => (fun η => f η • g η) (ξ + L z)) 0‖
        = ‖iteratedFDeriv ℝ n (fun y => f (ξ + L y) • g (ξ + L y)) 0‖ := rfl
      _ ≤ _ := hl
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (n - i) hO h0O,
          key f hf i hik, key g hg (n - i) (Nat.sub_le n i)]
  have hfk : ContDiffOn ℝ k f U := hf.of_le (by exact_mod_cast le_top)
  have hgk : ContDiffOn ℝ k g U := hg.of_le (by exact_mod_cast le_top)
  have hfa : ContDiffAt ℝ k f ξ := hfk.contDiffAt (hU.mem_nhds hξ)
  have hga : ContDiffAt ℝ k g ξ := hgk.contDiffAt (hU.mem_nhds hξ)
  refine ⟨?_, fun a b => ?_, fun a => ?_⟩
  ·
    have l1 := leib U k hU hξ f g hfk hgk
    have l1' : NB h (fun η => f η * g η) k ξ ≤ ∑ i ∈ Finset.range (k + 1),
        (k.choose i : ℝ) * NB h f i ξ * NB h g (k - i) ξ := l1
    exact l1'
  ·
    unfold NB
    have hfa' : ContDiffAt ℝ k (fun η => a * f η) ξ := contDiffAt_const.mul hfa
    have hga' : ContDiffAt ℝ k (fun η => b * g η) ξ := contDiffAt_const.mul hga
    have e0 : iteratedFDeriv ℝ k (fun η => a * f η + b * g η) ξ =
        iteratedFDeriv ℝ k (fun η => a * f η) ξ + iteratedFDeriv ℝ k (fun η => b * g η) ξ :=
      iteratedFDeriv_add_apply hfa' hga'
    have ea : iteratedFDeriv ℝ k (fun η => a * f η) ξ = a • iteratedFDeriv ℝ k f ξ := by
      have := iteratedFDeriv_const_smul_apply (a := a) hfa
      exact this
    have eb : iteratedFDeriv ℝ k (fun η => b * g η) ξ = b • iteratedFDeriv ℝ k g ξ := by
      have := iteratedFDeriv_const_smul_apply (a := b) hga
      exact this
    rw [e0, ea, eb]
    have e2 : (a • iteratedFDeriv ℝ k f ξ + b • iteratedFDeriv ℝ k g ξ).compContinuousLinearMap
        (fun _ => Lnorm h ξ) =
        a • (iteratedFDeriv ℝ k f ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) +
        b • (iteratedFDeriv ℝ k g ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) := by
      ext m; simp [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    rw [e2]
    refine (norm_add_le _ _).trans (le_of_eq ?_)
    rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
  ·
    unfold NB
    have hle := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
      (iteratedFDeriv ℝ k (fun _ : Cyl => a) ξ) (fun _ : Fin k => Lnorm h ξ)
    split_ifs with hk
    · subst hk
      rw [Fin.prod_univ_zero, mul_one, norm_iteratedFDeriv_zero, Real.norm_eq_abs] at hle
      exact hle
    · have hz : iteratedFDeriv ℝ k (fun _ : Cyl => a) ξ = 0 := by
        rw [iteratedFDeriv_const_of_ne hk a]; rfl
      rw [hz] at hle ⊢
      rw [norm_zero, zero_mul] at hle
      exact hle

theorem xc_etac_nb_v5 : ∀ B : BG, B.ok → ∀ i : ℕ, ∃ C : ℝ, ∀ ξ ∈ DomC B.h B.qB, XC B.h ξ < 2 * B.Xb → NB B.h (XC B.h) i ξ ≤ C ∧ NB B.h (etaC B.h) i ξ ≤ C :=
by
  intro B hB i
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, hqB1, -, -, -, -⟩ := hB.2.1
  have hS : SimScaleProps B.h := hB.1
  have SN : SimNorm B.h := simscale_normalized_v4 B.h hh0 hh1 hS
  have hqpos' : ∀ η : Cyl, η.2.2.1 < 1 → 0 < qC B.h η := fun η h =>
    (hS.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
  have hqC' : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) {η : Cyl | η.2.2.1 < 1} := by
    have h1 : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (Set.univ ×ˢ Set.Ioi 0) :=
      hS.2.2.2.1
    have h2 : ContDiff ℝ ∞ (fun η : Cyl => ((η.2.1, 1 - η.2.2.1) : ℝ × ℝ)) :=
      (contDiff_snd.fst).prodMk (contDiff_const.sub contDiff_snd.snd.fst)
    exact h1.comp h2.contDiffOn (fun η (hη : η.2.2.1 < 1) =>
      ⟨Set.mem_univ _, Set.mem_Ioi.mpr (by linarith)⟩)
  have hqC : ContDiffOn ℝ ∞ (fun η : Cyl => qC B.h η) (DomC B.h B.qB) :=
    hqC'.mono (fun η hη => hη.2.1)
  have hDo : IsOpen (DomC B.h B.qB) := by
    have hT : IsOpen {η : Cyl | η.2.2.1 < 1} := isOpen_lt continuous_snd.snd.fst continuous_const
    have h1 : IsOpen ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Set.Iio B.qB) :=
      hqC'.continuousOn.isOpen_inter_preimage hT isOpen_Iio
    have h2 : IsOpen {η : Cyl | 0 < η.1} := isOpen_lt continuous_const continuous_fst
    have e : DomC B.h B.qB = {η : Cyl | 0 < η.1} ∩
        ({η : Cyl | η.2.2.1 < 1} ∩ (fun η : Cyl => qC B.h η) ⁻¹' Set.Iio B.qB) := by
      ext η
      exact ⟨fun h => ⟨h.1, h.2.1, h.2.2⟩, fun h => ⟨h.1, h.2.1, h.2.2⟩⟩
    rw [e]; exact h2.inter h1
  have hqpos : ∀ η ∈ DomC B.h B.qB, 0 < qC B.h η := fun η hη => hqpos' η hη.2.1
  choose C1 hC1 using nb_qpow_v4 B B.qB (-1) hB SN hqB0 hqB1
  choose C2 hC2 using nb_qpow_v4 B B.qB (-(1/2 - B.h)) hB SN hqB0 hqB1

  have key : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (F : E → G) (V : Set E) (a : E) (T : Cyl →L[ℝ] E), IsOpen V →
      ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro E G _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]

  have hf0 : ContDiff ℝ ∞ (fun η : Cyl => η.1 ^ 2 / 2) := (contDiff_fst.pow 2).div_const 2
  have hfsq : ∀ ξ : Cyl, 0 < qC B.h ξ → ∀ a : ℕ,
      NB B.h (fun η : Cyl => η.1 ^ 2 / 2) a ξ ≤ ξ.1 ^ 2 + qC B.h ξ := by
    intro ξ hq a
    obtain ⟨q, hqd⟩ : ∃ q : ℝ, q = qC B.h ξ := ⟨_, rfl⟩
    obtain ⟨s, hsd⟩ : ∃ s : ℝ, s = Real.sqrt q := ⟨_, rfl⟩
    have hq' : 0 < q := by rw [hqd]; exact hq
    have hs2 : s ^ 2 = q := by rw [hsd]; exact Real.sq_sqrt hq'.le
    obtain ⟨p, hpdef⟩ : ∃ p : ℝ → ℝ, p = fun x => ξ.1 ^ 2 / 2 + ξ.1 * s * x + q / 2 * (x * x) :=
      ⟨_, rfl⟩
    have hp : ContDiff ℝ ∞ p := by
      rw [hpdef]
      exact (contDiff_const.add (contDiff_const.mul contDiff_id)).add
        (contDiff_const.mul (contDiff_id.mul contDiff_id))
    have hcomp : (fun v : Cyl => (ξ + Lnorm B.h ξ v).1 ^ 2 / 2) =
        p ∘ ⇑(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) := by
      funext v
      have e1 : (Lnorm B.h ξ v).1 = s * v.1 := by
        rw [hsd, hqd]; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      rw [hpdef]
      simp only [Function.comp_apply, ContinuousLinearMap.coe_fst', Prod.fst_add, e1]
      linear_combination (v.1 ^ 2 / 2) * hs2
    have e : iteratedFDeriv ℝ a (p ∘ ⇑(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))) 0 =
        (iteratedFDeriv ℝ a (fun η : Cyl => η.1 ^ 2 / 2) ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) := by
      rw [← hcomp]
      exact key (fun η : Cyl => η.1 ^ 2 / 2) Set.univ ξ (Lnorm B.h ξ) isOpen_univ hf0.contDiffOn
        (Set.mem_univ _) a
    unfold NB
    rw [← e, ContinuousLinearMap.iteratedFDeriv_comp_right
      (ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))) hp (0 : Cyl) (i := a)
      (by exact_mod_cast le_top), map_zero]
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    have hprod : ∏ _i : Fin a, ‖ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ))‖ ≤ 1 := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_one₀ (norm_nonneg _) (ContinuousLinearMap.norm_fst_le _ _ _)
    refine (mul_le_of_le_one_right (norm_nonneg _) hprod).trans ?_
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, ← hqd]
    have hd1 : deriv p = fun x => ξ.1 * s + q * x := by
      funext x
      rw [hpdef]
      have h := (((hasDerivAt_id' x).const_mul (ξ.1 * s)).const_add (ξ.1 ^ 2 / 2)).add
        (((hasDerivAt_id' x).mul (hasDerivAt_id' x)).const_mul (q / 2))
      have h' : HasDerivAt (fun x => ξ.1 ^ 2 / 2 + ξ.1 * s * x + q / 2 * (x * x))
          (ξ.1 * s + q * x) x := by
        convert h using 1; ring
      exact h'.deriv
    have hd2 : deriv (fun x : ℝ => ξ.1 * s + q * x) = fun _ => q := by
      funext x
      have h := ((hasDerivAt_id' x).const_mul q).const_add (ξ.1 * s)
      have h' : HasDerivAt (fun x : ℝ => ξ.1 * s + q * x) q x := by
        convert h using 1; ring
      exact h'.deriv
    have hd3 : deriv (fun _ : ℝ => q) = fun _ => (0:ℝ) := by
      funext x; exact deriv_const x q
    rcases a with _ | _ | _ | n
    · rw [iteratedDeriv_zero, hpdef]
      show |ξ.1 ^ 2 / 2 + ξ.1 * s * 0 + q / 2 * (0 * 0)| ≤ ξ.1 ^ 2 + q
      rw [abs_le]; constructor <;> nlinarith [sq_nonneg ξ.1]
    · rw [iteratedDeriv_succ', iteratedDeriv_zero, hd1]
      show |ξ.1 * s + q * 0| ≤ ξ.1 ^ 2 + q
      rw [abs_le]; constructor <;> nlinarith [sq_nonneg (ξ.1 - s), sq_nonneg (ξ.1 + s), sq_nonneg ξ.1]
    · rw [iteratedDeriv_succ', iteratedDeriv_succ', iteratedDeriv_zero, hd1, hd2]
      show |q| ≤ ξ.1 ^ 2 + q
      rw [abs_of_pos hq']; nlinarith [sq_nonneg ξ.1]
    · rw [iteratedDeriv_succ', iteratedDeriv_succ', iteratedDeriv_succ', hd1, hd2, hd3,
        iteratedDeriv_const]
      simp only [ite_self, abs_zero]
      exact add_nonneg (sq_nonneg _) hq'.le

  have hz0 : ContDiff ℝ ∞ (fun η : Cyl => η.2.1) := contDiff_snd.fst
  obtain ⟨π, hπdef⟩ : ∃ π : Cyl →L[ℝ] ℝ, π = (ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
      (ContinuousLinearMap.snd ℝ ℝ (ℝ × (ℝ × (ℝ × ℝ)))) := ⟨_, rfl⟩
  have hπapp : ∀ η : Cyl, π η = η.2.1 := by intro η; rw [hπdef]; simp
  have hπ1 : ‖π‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun η => ?_)
    rw [hπapp η, one_mul]
    exact (norm_fst_le η.2).trans (norm_snd_le η)
  have hzc : ∀ ξ : Cyl, 0 < qC B.h ξ → ∀ a : ℕ,
      NB B.h (fun η : Cyl => η.2.1) a ξ ≤ |ξ.2.1| + qC B.h ξ ^ (1/2 - B.h) := by
    intro ξ hq a
    obtain ⟨s, hsd⟩ : ∃ s : ℝ, s = qC B.h ξ ^ (1/2 - B.h) := ⟨_, rfl⟩
    have hs0 : 0 ≤ s := by rw [hsd]; exact Real.rpow_nonneg hq.le _
    obtain ⟨p, hpdef⟩ : ∃ p : ℝ → ℝ, p = fun x => ξ.2.1 + s * x := ⟨_, rfl⟩
    have hp : ContDiff ℝ ∞ p := by
      rw [hpdef]; exact contDiff_const.add (contDiff_const.mul contDiff_id)
    have hcomp : (fun v : Cyl => (ξ + Lnorm B.h ξ v).2.1) = p ∘ ⇑π := by
      funext v
      have e1 : (Lnorm B.h ξ v).2.1 = s * v.2.1 := by
        rw [hsd]; simp [Lnorm, ContinuousLinearMap.coe_prodMap']
      rw [hpdef]
      simp only [Function.comp_apply, hπapp, Prod.snd_add, Prod.fst_add, e1]
    have e : iteratedFDeriv ℝ a (p ∘ ⇑π) 0 =
        (iteratedFDeriv ℝ a (fun η : Cyl => η.2.1) ξ).compContinuousLinearMap
          (fun _ => Lnorm B.h ξ) := by
      rw [← hcomp]
      exact key (fun η : Cyl => η.2.1) Set.univ ξ (Lnorm B.h ξ) isOpen_univ hz0.contDiffOn
        (Set.mem_univ _) a
    unfold NB
    rw [← e, ContinuousLinearMap.iteratedFDeriv_comp_right π hp (0 : Cyl) (i := a)
      (by exact_mod_cast le_top), map_zero]
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    have hprod : ∏ _i : Fin a, ‖π‖ ≤ 1 := by
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      exact pow_le_one₀ (norm_nonneg _) hπ1
    refine (mul_le_of_le_one_right (norm_nonneg _) hprod).trans ?_
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, ← hsd]
    have hd1 : deriv p = fun _ => s := by
      funext x
      rw [hpdef]
      have h := ((hasDerivAt_id' x).const_mul s).const_add ξ.2.1
      have h' : HasDerivAt (fun x => ξ.2.1 + s * x) s x := by
        convert h using 1; ring
      exact h'.deriv
    have hd2 : deriv (fun _ : ℝ => s) = fun _ => (0:ℝ) := by
      funext x; exact deriv_const x s
    rcases a with _ | _ | n
    · rw [iteratedDeriv_zero, hpdef]
      show |ξ.2.1 + s * 0| ≤ |ξ.2.1| + s
      rw [mul_zero, add_zero]; linarith
    · rw [iteratedDeriv_succ', iteratedDeriv_zero, hd1]
      show |s| ≤ |ξ.2.1| + s
      rw [abs_of_nonneg hs0]; linarith [abs_nonneg ξ.2.1]
    · rw [iteratedDeriv_succ', iteratedDeriv_succ', hd1, hd2, iteratedDeriv_const]
      simp only [ite_self, abs_zero]
      exact add_nonneg (abs_nonneg _) hs0

  have hne : ∀ η ∈ DomC B.h B.qB, qC B.h η ≠ 0 := fun η hη => (hqpos η hη).ne'
  have hqm1 : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-1:ℝ)) (DomC B.h B.qB) :=
    hqC.rpow_const_of_ne hne
  have hqe : ContDiffOn ℝ ∞ (fun η => qC B.h η ^ (-(1/2 - B.h))) (DomC B.h B.qB) :=
    hqC.rpow_const_of_ne hne
  have hXCdef : XC B.h = fun η => η.1 ^ 2 / 2 * qC B.h η ^ (-1:ℝ) := by
    funext η
    show η.1 ^ 2 / (2 * qC B.h η) = η.1 ^ 2 / 2 * qC B.h η ^ (-1:ℝ)
    rw [Real.rpow_neg_one]
    ring
  have hetadef : etaC B.h = fun η => η.2.1 * qC B.h η ^ (-(1/2 - B.h)) := by
    funext η; rfl
  obtain ⟨S1, hS1⟩ : ∃ S : ℝ, S = ∑ a ∈ Finset.range (i + 1), (i.choose a : ℝ) * |C1 (i - a)| :=
    ⟨_, rfl⟩
  obtain ⟨S2, hS2⟩ : ∃ S : ℝ, S = ∑ a ∈ Finset.range (i + 1), (i.choose a : ℝ) * |C2 (i - a)| :=
    ⟨_, rfl⟩
  have hS10 : 0 ≤ S1 := by
    rw [hS1]; exact Finset.sum_nonneg (fun a _ => mul_nonneg (Nat.cast_nonneg _) (abs_nonneg _))
  have hS20 : 0 ≤ S2 := by
    rw [hS2]; exact Finset.sum_nonneg (fun a _ => mul_nonneg (Nat.cast_nonneg _) (abs_nonneg _))
  refine ⟨(4 * |B.Xb| + 1) * S1 + 2 * S2, ?_⟩
  intro ξ hξ hX
  have hq := hqpos ξ hξ
  have hXb0 : 0 ≤ 4 * |B.Xb| + 1 := by positivity
  constructor
  · have hprod := (nb_real_algebra_v5 B.h (DomC B.h B.qB) ξ hDo hξ (fun η : Cyl => η.1 ^ 2 / 2)
      (fun η => qC B.h η ^ (-1:ℝ)) hf0.contDiffOn hqm1 i).1
    have hr2 : ξ.1 ^ 2 + qC B.h ξ ≤ (4 * |B.Xb| + 1) * qC B.h ξ := by
      have h' : ξ.1 ^ 2 / (2 * qC B.h ξ) < 2 * B.Xb := hX
      rw [div_lt_iff₀ (by linarith)] at h'
      have := mul_le_mul_of_nonneg_right (le_abs_self B.Xb) hq.le
      nlinarith
    have hmain : NB B.h (XC B.h) i ξ ≤ (4 * |B.Xb| + 1) * S1 := by
      rw [hXCdef, hS1]
      refine hprod.trans ?_
      rw [Finset.mul_sum]
      refine Finset.sum_le_sum (fun a _ => ?_)
      have h1 := hfsq ξ hq a
      have h2 : NB B.h (fun η => qC B.h η ^ (-1:ℝ)) (i - a) ξ ≤ |C1 (i - a)| * (qC B.h ξ)⁻¹ := by
        refine (hC1 (i - a) ξ hξ).trans ?_
        rw [Real.rpow_neg_one]
        exact mul_le_mul_of_nonneg_right (le_abs_self _) (inv_nonneg.mpr hq.le)
      calc (i.choose a : ℝ) * NB B.h (fun η : Cyl => η.1 ^ 2 / 2) a ξ *
            NB B.h (fun η => qC B.h η ^ (-1:ℝ)) (i - a) ξ
          ≤ (i.choose a : ℝ) * (ξ.1 ^ 2 + qC B.h ξ) * (|C1 (i - a)| * (qC B.h ξ)⁻¹) :=
            mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) h2 (norm_nonneg _)
              (mul_nonneg (Nat.cast_nonneg _) (add_nonneg (sq_nonneg _) hq.le))
        _ ≤ (i.choose a : ℝ) * ((4 * |B.Xb| + 1) * qC B.h ξ) * (|C1 (i - a)| * (qC B.h ξ)⁻¹) :=
            mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hr2 (Nat.cast_nonneg _))
              (mul_nonneg (abs_nonneg _) (inv_nonneg.mpr hq.le))
        _ = (4 * |B.Xb| + 1) * ((i.choose a : ℝ) * |C1 (i - a)|) * (qC B.h ξ * (qC B.h ξ)⁻¹) := by
            ring
        _ = (4 * |B.Xb| + 1) * ((i.choose a : ℝ) * |C1 (i - a)|) := by
            rw [mul_inv_cancel₀ hq.ne', mul_one]
    linarith
  · have hs : 0 < qC B.h ξ ^ (1/2 - B.h) := Real.rpow_pos_of_pos hq _
    have hs2 : (qC B.h ξ ^ (1/2 - B.h)) ^ 2 = qC B.h ξ ^ (1 - 2 * B.h) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hq.le]; congr 1; push_cast; ring
    have hz : ξ.2.1 ^ 2 < (qC B.h ξ ^ (1/2 - B.h)) ^ 2 := by
      rw [hs2]; exact (hS.2.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ.2.1])).2
    have habs : |ξ.2.1| < qC B.h ξ ^ (1/2 - B.h) := abs_lt_of_sq_lt_sq hz hs.le
    have hprod := (nb_real_algebra_v5 B.h (DomC B.h B.qB) ξ hDo hξ (fun η : Cyl => η.2.1)
      (fun η => qC B.h η ^ (-(1/2 - B.h))) hz0.contDiffOn hqe i).1
    have hinv : qC B.h ξ ^ (-(1/2 - B.h)) = (qC B.h ξ ^ (1/2 - B.h))⁻¹ := Real.rpow_neg hq.le _
    have hmain : NB B.h (etaC B.h) i ξ ≤ 2 * S2 := by
      rw [hetadef, hS2]
      refine hprod.trans ?_
      rw [Finset.mul_sum]
      refine Finset.sum_le_sum (fun a _ => ?_)
      have h1 := hzc ξ hq a
      have h2 : NB B.h (fun η => qC B.h η ^ (-(1/2 - B.h))) (i - a) ξ ≤
          |C2 (i - a)| * (qC B.h ξ ^ (1/2 - B.h))⁻¹ := by
        refine (hC2 (i - a) ξ hξ).trans ?_
        rw [hinv]
        exact mul_le_mul_of_nonneg_right (le_abs_self _) (inv_nonneg.mpr hs.le)
      have h1' : NB B.h (fun η : Cyl => η.2.1) a ξ ≤ 2 * qC B.h ξ ^ (1/2 - B.h) := by linarith
      calc (i.choose a : ℝ) * NB B.h (fun η : Cyl => η.2.1) a ξ *
            NB B.h (fun η => qC B.h η ^ (-(1/2 - B.h))) (i - a) ξ
          ≤ (i.choose a : ℝ) * (2 * qC B.h ξ ^ (1/2 - B.h)) *
              (|C2 (i - a)| * (qC B.h ξ ^ (1/2 - B.h))⁻¹) :=
            mul_le_mul (mul_le_mul_of_nonneg_left h1' (Nat.cast_nonneg _)) h2 (norm_nonneg _)
              (mul_nonneg (Nat.cast_nonneg _) (by positivity))
        _ = 2 * ((i.choose a : ℝ) * |C2 (i - a)|) *
              (qC B.h ξ ^ (1/2 - B.h) * (qC B.h ξ ^ (1/2 - B.h))⁻¹) := by ring
        _ = 2 * ((i.choose a : ℝ) * |C2 (i - a)|) := by
            rw [mul_inv_cancel₀ hs.ne', mul_one]
    have : 0 ≤ (4 * |B.Xb| + 1) * S1 := mul_nonneg hXb0 hS10
    linarith

theorem nb_comp3_v5 : ∀ (h : ℝ) (U : Set Cyl) (W : Set (ℝ × ℝ × ℝ)) (ξ : Cyl) (G : ℝ × ℝ × ℝ → ℝ) (φ₁ φ₂ φ₃ : Cyl → ℝ) (k : ℕ) (C D : ℝ), IsOpen U → IsOpen W → ξ ∈ U → ContDiffOn ℝ ∞ G W → ContDiffOn ℝ ∞ φ₁ U → ContDiffOn ℝ ∞ φ₂ U → ContDiffOn ℝ ∞ φ₃ U → (∀ η ∈ U, (φ₁ η, φ₂ η, φ₃ η) ∈ W) → 1 ≤ D → (∀ i : ℕ, i ≤ k → ‖iteratedFDeriv ℝ i G (φ₁ ξ, φ₂ ξ, φ₃ ξ)‖ ≤ C) → (∀ i : ℕ, 1 ≤ i → i ≤ k → NB h φ₁ i ξ ≤ D ∧ NB h φ₂ i ξ ≤ D ∧ NB h φ₃ i ξ ≤ D) → NB h (fun η => G (φ₁ η, φ₂ η, φ₃ η)) k ξ ≤ (k.factorial : ℝ) * C * (3 * D) ^ k :=
by
  intro h U W ξ G φ₁ φ₂ φ₃ k C D hU hW hξ hG hφ₁ hφ₂ hφ₃ hmaps hD hGb hNB
  have key : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (F' : Cyl → V),
      ContDiffOn ℝ ∞ F' U → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F' (ξ + Lnorm h ξ z)) 0 =
        (iteratedFDeriv ℝ i F' ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) := by
    intro V _ _ F' hF i
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑(Lnorm h ξ) ⁻¹' s) := hs.preimage (Lnorm h ξ).continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hT0s : Lnorm h ξ 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑(Lnorm h ξ) ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F' (ξ + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F' (ξ + Lnorm h ξ z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right (Lnorm h ξ) hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F' (ξ + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F') i ξ 0
    calc iteratedFDeriv ℝ i (fun z => F' (ξ + Lnorm h ξ z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F' (ξ + z)) ∘ ⇑(Lnorm h ξ)) (⇑(Lnorm h ξ) ⁻¹' s) 0 :=
          e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F' (ξ + z)) s (Lnorm h ξ 0)).compContinuousLinearMap
            (fun _ => Lnorm h ξ) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F' (ξ + z)) s 0).compContinuousLinearMap
            (fun _ => Lnorm h ξ) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F' (ξ + z)) 0).compContinuousLinearMap
            (fun _ => Lnorm h ξ) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F' ξ).compContinuousLinearMap (fun _ => Lnorm h ξ) := by
          rw [e4, add_zero]
  have hΦ : ContDiffOn ℝ ∞ (fun η => (φ₁ η, φ₂ η, φ₃ η)) U := hφ₁.prodMk (hφ₂.prodMk hφ₃)
  have hF : ContDiffOn ℝ ∞ (fun η => G (φ₁ η, φ₂ η, φ₃ η)) U :=
    hG.comp hΦ (fun η hη => hmaps η hη)
  obtain ⟨O, hOdef⟩ : ∃ O : Set Cyl, O = (fun z => ξ + Lnorm h ξ z) ⁻¹' U := ⟨_, rfl⟩
  have hO : IsOpen O := by
    rw [hOdef]; exact hU.preimage (continuous_const.add (Lnorm h ξ).continuous)
  have h0O : (0 : Cyl) ∈ O := by
    rw [hOdef]; show ξ + Lnorm h ξ 0 ∈ U; rw [map_zero, add_zero]; exact hξ
  have hsub : ∀ ψ : Cyl → ℝ, ContDiffOn ℝ ∞ ψ U →
      ContDiffOn ℝ ∞ (fun z => ψ (ξ + Lnorm h ξ z)) O := by
    intro ψ hψ
    rw [hOdef]
    exact hψ.comp (contDiff_const.add (Lnorm h ξ).contDiff).contDiffOn (fun z hz => hz)
  have hat : ∀ ψ : Cyl → ℝ, ContDiffOn ℝ ∞ ψ U →
      ContDiffAt ℝ ∞ (fun z => ψ (ξ + Lnorm h ξ z)) 0 :=
    fun ψ hψ => (hsub ψ hψ).contDiffAt (hO.mem_nhds h0O)
  have hnb : ∀ ψ : Cyl → ℝ, ContDiffOn ℝ ∞ ψ U → ∀ i : ℕ,
      ‖iteratedFDeriv ℝ i (fun z => ψ (ξ + Lnorm h ξ z)) 0‖ = NB h ψ i ξ := by
    intro ψ hψ i; unfold NB; rw [key ψ hψ i]
  obtain ⟨f, hfdef⟩ : ∃ f : Cyl → ℝ × ℝ × ℝ,
      f = fun z => (φ₁ (ξ + Lnorm h ξ z), φ₂ (ξ + Lnorm h ξ z), φ₃ (ξ + Lnorm h ξ z)) := ⟨_, rfl⟩
  have hf : ContDiffOn ℝ ∞ f O := by
    rw [hfdef]; exact (hsub φ₁ hφ₁).prodMk ((hsub φ₂ hφ₂).prodMk (hsub φ₃ hφ₃))
  have hmapsf : Set.MapsTo f O W := by
    intro z hz; rw [hfdef]; rw [hOdef] at hz; exact hmaps _ hz
  have hf0 : f 0 = (φ₁ ξ, φ₂ ξ, φ₃ ξ) := by
    rw [hfdef]; simp only [map_zero, add_zero]
  have hCw : ∀ i ≤ k, ‖iteratedFDerivWithin ℝ i G W (f 0)‖ ≤ C := by
    intro i hi
    rw [hf0, iteratedFDerivWithin_of_isOpen i hW (hmaps ξ hξ)]
    exact hGb i hi
  have hDw : ∀ i, 1 ≤ i → i ≤ k → ‖iteratedFDerivWithin ℝ i f O 0‖ ≤ (3 * D) ^ i := by
    intro i hi1 hik
    rw [iteratedFDerivWithin_of_isOpen i hO h0O, hfdef]
    have e1 := iteratedFDeriv_prodMk (hat φ₁ hφ₁) ((hat φ₂ hφ₂).prodMk (hat φ₃ hφ₃))
      (i := i) (by exact_mod_cast le_top)
    have e2 := iteratedFDeriv_prodMk (hat φ₂ hφ₂) (hat φ₃ hφ₃) (i := i) (by exact_mod_cast le_top)
    rw [e1, ContinuousMultilinearMap.opNorm_prod, e2, ContinuousMultilinearMap.opNorm_prod,
      hnb φ₁ hφ₁, hnb φ₂ hφ₂, hnb φ₃ hφ₃]
    obtain ⟨b1, b2, b3⟩ := hNB i hi1 hik
    have h3 : (1:ℝ) ≤ 3 * D := by linarith
    have hDD : D ≤ (3 * D) ^ i := le_trans (by linarith) (le_self_pow₀ h3 (by omega))
    exact max_le (b1.trans hDD) (max_le (b2.trans hDD) (b3.trans hDD))
  have hFdB := norm_iteratedFDerivWithin_comp_le hG hf (by exact_mod_cast le_top)
    hW.uniqueDiffOn hO.uniqueDiffOn hmapsf h0O (C := C) (D := 3 * D) hCw hDw
  have hEq : (fun z => G (φ₁ (ξ + Lnorm h ξ z), φ₂ (ξ + Lnorm h ξ z), φ₃ (ξ + Lnorm h ξ z))) =
      G ∘ f := by
    rw [hfdef]; rfl
  rw [← hnb _ hF k]
  calc ‖iteratedFDeriv ℝ k (fun z => G (φ₁ (ξ + Lnorm h ξ z), φ₂ (ξ + Lnorm h ξ z),
          φ₃ (ξ + Lnorm h ξ z))) 0‖
      = ‖iteratedFDeriv ℝ k (G ∘ f) 0‖ := by rw [hEq]
    _ = ‖iteratedFDerivWithin ℝ k (G ∘ f) O 0‖ := by
        rw [iteratedFDerivWithin_of_isOpen k hO h0O]
    _ ≤ (k.factorial : ℝ) * C * (3 * D) ^ k := hFdB

theorem nb_real_mul_le_v5 : ∀ (h : ℝ) (ξ : Cyl) (a b : Cyl → ℝ) (k : ℕ) (A E : ℝ), ContDiffAt ℝ ∞ a ξ → ContDiffAt ℝ ∞ b ξ → (∀ i : ℕ, i ≤ k → NB h a i ξ ≤ A) → (∀ i : ℕ, i ≤ k → NB h b i ξ ≤ E) → NB h (fun η => a η * b η) k ξ ≤ 2 ^ k * A * E :=
by
  intro h ξ a b k A E ha hb hA hE
  have hNBnn : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : Cyl → V) (i : ℕ),
      0 ≤ NB h f i ξ := fun f i => norm_nonneg _

  have leib : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (U : Set Cyl) (n : ℕ),
      IsOpen U → ξ ∈ U → ∀ (f : Cyl → ℝ) (g : Cyl → V), ContDiffOn ℝ n f U → ContDiffOn ℝ n g U →
      NB h (fun η => f η • g η) n ξ ≤
        ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * NB h f i ξ * NB h g (n - i) ξ := by
    intro V _ _ U n hU hξ f g hf hg
    unfold NB
    generalize Lnorm h ξ = L
    obtain ⟨s, hs_def⟩ : ∃ s : Set Cyl, s = (fun z : Cyl => ξ + z) ⁻¹' U := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hU.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑L ⁻¹' s) := hs.preimage L.continuous
    have h0s : (0 : Cyl) ∈ s := by
      rw [hs_def]; show ξ + 0 ∈ U; rw [add_zero]; exact hξ
    have hL0s : L 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : Cyl) ∈ ⇑L ⁻¹' s := hL0s
    have hsm : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + z)) s := by
      intro W _ _ F hF
      exact hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have hsmO : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ContDiffOn ℝ n (fun z => F (ξ + L z)) (⇑L ⁻¹' s) := by
      intro W _ _ F hF
      exact (hsm F hF).comp L.contDiff.contDiffOn (fun z hz => hz)
    have key : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (F : Cyl → W),
        ContDiffOn ℝ n F U → ∀ i : ℕ, i ≤ n →
        iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0 =
          (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by
      intro W _ _ F hF i hi
      have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + L z)) i hO h0O
      have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right L (hsm F hF) hs.uniqueDiffOn
        hO.uniqueDiffOn hL0s (i := i) (by exact_mod_cast hi)
      have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (ξ + z)) i hs h0s
      have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i ξ 0
      calc iteratedFDeriv ℝ i (fun z => F (ξ + L z)) 0
          = iteratedFDerivWithin ℝ i ((fun z => F (ξ + z)) ∘ ⇑L) (⇑L ⁻¹' s) 0 := e1.symm
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s (L 0)).compContinuousLinearMap
              (fun _ => L) := e2
        _ = (iteratedFDerivWithin ℝ i (fun z => F (ξ + z)) s 0).compContinuousLinearMap
              (fun _ => L) := by rw [map_zero]
        _ = (iteratedFDeriv ℝ i (fun z => F (ξ + z)) 0).compContinuousLinearMap
              (fun _ => L) := by rw [e3]
        _ = (iteratedFDeriv ℝ i F ξ).compContinuousLinearMap (fun _ => L) := by rw [e4, add_zero]
    have hfg : ContDiffOn ℝ n (fun η => f η • g η) U := hf.smul hg
    have hl := norm_iteratedFDerivWithin_smul_le (hsmO f hf) (hsmO g hg) hO.uniqueDiffOn h0O
      (n := n) le_rfl
    rw [iteratedFDerivWithin_of_isOpen (f := fun y => f (ξ + L y) • g (ξ + L y)) n hO h0O] at hl
    rw [← key _ hfg n le_rfl]
    calc ‖iteratedFDeriv ℝ n (fun z => (fun η => f η • g η) (ξ + L z)) 0‖
        = ‖iteratedFDeriv ℝ n (fun y => f (ξ + L y) • g (ξ + L y)) 0‖ := rfl
      _ ≤ _ := hl
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [iteratedFDerivWithin_of_isOpen (f := fun z => f (ξ + L z)) i hO h0O,
          iteratedFDerivWithin_of_isOpen (f := fun z => g (ξ + L z)) (n - i) hO h0O,
          key f hf i hik, key g hg (n - i) (Nat.sub_le n i)]
  have hA0 : 0 ≤ A := le_trans (hNBnn a 0) (hA 0 (Nat.zero_le k))
  have hE0 : 0 ≤ E := le_trans (hNBnn b 0) (hE 0 (Nat.zero_le k))

  have ha' : ContDiffAt ℝ k a ξ := ha.of_le (by exact_mod_cast le_top)
  have hb' : ContDiffAt ℝ k b ξ := hb.of_le (by exact_mod_cast le_top)
  obtain ⟨ua, hua, hau⟩ := ha'.contDiffOn le_rfl (by simp)
  obtain ⟨ub, hub, hbu⟩ := hb'.contDiffOn le_rfl (by simp)
  obtain ⟨O, hOsub, hOopen, hξO⟩ := mem_nhds_iff.mp (Filter.inter_mem hua hub)
  have haO : ContDiffOn ℝ k a O := hau.mono (fun x hx => (hOsub hx).1)
  have hbO : ContDiffOn ℝ k b O := hbu.mono (fun x hx => (hOsub hx).2)
  have l1 := leib O k hOopen hξO a b haO hbO
  have l1' : NB h (fun η => a η * b η) k ξ ≤ ∑ i ∈ Finset.range (k + 1),
      (k.choose i : ℝ) * NB h a i ξ * NB h b (k - i) ξ := l1
  refine le_trans l1' ?_
