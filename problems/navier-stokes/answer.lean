  have hRC : 1 / A ≤ pcRC5 γ.1 s := by
    have h1 : 1 / A ≤ Real.sqrt B.Xa / 2 := by
      have := one_div_le_one_div_of_le h2s hAs
      rwa [one_div_div] at this
    have h2 := (abs_le.mp H4').1
    linarith

  have hpang : |pang5 B G γ - ptil5 B G γ| ≤ eps := by
    rw [heps]; unfold pang5
    exact hround (kb B.h γ.1) (ptil5 B G γ) (pint5 B G γ) hkb1
      (fun h => by unfold pint5; rw [if_pos h]) (fun h => by unfold pint5; rw [if_neg h])
  have hptil : ptil5 B G γ = R0r B G γ * (Bs5 B G γ * (-((eN (g0r5 B G γ))⁻¹ * (g0r5 B G γ).2) -
      sgn γ.2.2 * G.ustar * (g0r5 B G γ).1 / (Lsb B.h G.r0 γ.1 * eN (g0r5 B G γ) ^ 2))) := by
    unfold ptil5 Kfr5 Nfr5; simp only [Prod.smul_snd, Prod.smul_fst, smul_eq_mul]; ring
  have hpz : pzr5 B G γ = Bs5 B G γ * ((eN (g0r5 B G γ))⁻¹ * (g0r5 B G γ).1 -
      sgn γ.2.2 * G.ustar * (g0r5 B G γ).2 / (Lsb B.h G.r0 γ.1 * eN (g0r5 B G γ) ^ 2)) := by
    unfold pzr5 Kfr5 Nfr5; simp only [Prod.smul_snd, Prod.smul_fst, smul_eq_mul]; try ring
  have hK1 : (Kfr5 B G γ).1 = -((eN (g0r5 B G γ))⁻¹ * (g0r5 B G γ).2) := rfl
  have hK2 : (Kfr5 B G γ).2 = (eN (g0r5 B G γ))⁻¹ * (g0r5 B G γ).1 := rfl
  have H4r : |R0r B G γ - pcRC5 γ.1 s| ≤ E := by rw [abs_sub_comm]; exact H4'

  obtain ⟨c1, c2, -, -, -⟩ := line_alg5 A (eN (g0r5 B G γ)) (g0r5 B G γ).1 (g0r5 B G γ).2 (Bs5 B G γ)
    G.ustar (sgn γ.2.2) (Lsb B.h G.r0 γ.1) (Lsb B.h G.r0 γ.1) (pcRC5 γ.1 s) (R0r B G γ) _ _ _ _
    (pang5 B G γ) (ptil5 B G γ) (pzr5 B G γ) eps E hA1 heg0 hegsq hegA' hegA hBsA huA hsg hL1
    hL0.le le_rfl hRC hR0A heps0 heps1 hE0 hE1 hptil hpz hpang H4r H2' H3' H5' H6'
  obtain ⟨-, -, c3, -, -⟩ := line_alg5 A (eN (g0r5 B G γ)) (g0r5 B G γ).1 (g0r5 B G γ).2 (Bs5 B G γ)
    G.ustar (sgn γ.2.2) (Lsb B.h G.r0 γ.1) 0 (pcRC5 γ.1 s) (R0r B G γ) _ _ _ _
    (pang5 B G γ) (ptil5 B G γ) (pzr5 B G γ) eps E hA1 heg0 hegsq hegA' hegA hBsA huA hsg hL1
    le_rfl hL0.le hRC hR0A heps0 heps1 hE0 hE1 hptil hpz hpang H4r H2' H3' H5' H6'
  have hin : ∀ X : ℝ, sgn γ.2.2 * Bs5 B G γ * G.ustar / 2 - Lsb B.h G.r0 γ.1 * X -
      Bs5 B G γ * (sgn γ.2.2 * (G.ustar / 2 + G.ustar * Lsb B.h G.r0 γ.1 / Lsb B.h G.r0 γ.1)) =
      -(Lsb B.h G.r0 γ.1 * (X + sgn γ.2.2 * Bs5 B G γ * G.ustar / Lsb B.h G.r0 γ.1)) := by
    intro X; field_simp; ring
  rw [hin, abs_neg, abs_mul, abs_of_pos hL0] at c1
  rw [zero_mul, sub_zero] at c3
  have hdivL := one_div_mul_cancel hLne

  have hA0' : |pcA5 B G γ s 0 - sgn γ.2.2 * Bs5 B G γ * G.ustar / 2| ≤ M0 / Lsb B.h G.r0 γ.1 := by
    rw [hAc.1, sub_self, abs_zero]; exact div_nonneg hM00 hL0.le
  have hA1' : |pcA5 B G γ s 1 - Bs5 B G γ * (Kfr5 B G γ).1| ≤ M0 / Lsb B.h G.r0 γ.1 := by
    rw [show pcA5 B G γ s 1 = pang5 B G γ / pcRC5 γ.1 s from rfl, hK1, le_div_iff₀ hL0]
    calc _ ≤ 30 * A ^ 5 * (eps + E + 1 / Lsb B.h G.r0 γ.1) * Lsb B.h G.r0 γ.1 :=
          mul_le_mul_of_nonneg_right c2 hL0.le
      _ = 30 * A ^ 5 * (eps * Lsb B.h G.r0 γ.1 + E * Lsb B.h G.r0 γ.1 + 1) := by
          linear_combination (30 * A ^ 5) * hdivL
      _ ≤ 30 * A ^ 5 * (3 / 2 * Kc + 3 * |M| * Kc + 1) := by
          apply mul_le_mul_of_nonneg_left _ hT0
          have := mul_le_mul_of_nonneg_left hLL heps0
          have := mul_le_mul_of_nonneg_left hLL hE0
          linarith
      _ ≤ M0 := by rw [hM0]; linarith [p1, p2, p3, hA5]
  have hA2' : |pcA5 B G γ s 2 - Bs5 B G γ * (Kfr5 B G γ).2| ≤ M0 / Lsb B.h G.r0 γ.1 := by
    rw [hAc.2, hK2, le_div_iff₀ hL0]
    calc _ ≤ 30 * A ^ 5 * (1 / Lsb B.h G.r0 γ.1 + Lsb B.h G.r0 γ.1 * E) * Lsb B.h G.r0 γ.1 :=
          mul_le_mul_of_nonneg_right c3 hL0.le
      _ = 30 * A ^ 5 * (1 + E * Lsb B.h G.r0 γ.1 ^ 2) := by
          linear_combination (30 * A ^ 5) * hdivL
      _ ≤ 30 * A ^ 5 * (1 + 3 * |M| * Kc) := by
          apply mul_le_mul_of_nonneg_left _ hT0; linarith
      _ ≤ M0 := by rw [hM0]; linarith [p1, p2, p3, hA5]
  have hPsi0 : |pang5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) s ((1:ℝ), (0:ℝ), (0:ℝ))) +
      pzr5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) s ((1:ℝ), (0:ℝ), (0:ℝ))) +
      sgn γ.2.2 * Bs5 B G γ * G.ustar / Lsb B.h G.r0 γ.1| ≤ 30 * A ^ 5 * (eps + E) := by
    have h : Lsb B.h G.r0 γ.1 * |pang5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) s ((1:ℝ), (0:ℝ), (0:ℝ))) +
      pzr5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) s ((1:ℝ), (0:ℝ), (0:ℝ))) +
      sgn γ.2.2 * Bs5 B G γ * G.ustar / Lsb B.h G.r0 γ.1| ≤ Lsb B.h G.r0 γ.1 * (30 * A ^ 5 * (eps + E)) := by
      linarith [c1]
    exact le_of_mul_le_mul_left h hL0
  have hP0' : |pcPsi5 B G γ s 0 - -(sgn γ.2.2 * Bs5 B G γ * G.ustar / Lsb B.h G.r0 γ.1)| ≤
      M0 / Lsb B.h G.r0 γ.1 ^ 2 := by
    rw [hP.1, sub_neg_eq_add, le_div_iff₀ hL2]
    calc _ ≤ 30 * A ^ 5 * (eps + E) * Lsb B.h G.r0 γ.1 ^ 2 := mul_le_mul_of_nonneg_right hPsi0 hL2.le
      _ = 30 * A ^ 5 * (eps * Lsb B.h G.r0 γ.1 ^ 2 + E * Lsb B.h G.r0 γ.1 ^ 2) := by ring
      _ ≤ 30 * A ^ 5 * (3 / 2 * Kc + 3 * |M| * Kc) :=
          mul_le_mul_of_nonneg_left (add_le_add hepsL hEL) hT0
      _ ≤ M0 := by rw [hM0]; linarith [p1, p2, p3, hA5]
  have hP1' : |pcPsi5 B G γ s 1 - 0| ≤ M0 / Lsb B.h G.r0 γ.1 ^ 2 := by
    rw [show pcPsi5 B G γ s 1 = 0 from rfl, sub_zero, abs_zero]; exact div_nonneg hM00 hL2.le
  have hP2' : |pcPsi5 B G γ s 2 - 0| ≤ M0 / Lsb B.h G.r0 γ.1 ^ 2 := by
    rw [hP.2, sub_zero, le_div_iff₀ hL2]
    have ha : |pang5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) s ((0:ℝ), (1:ℝ), (0:ℝ)))| ≤ A * E := by
      rw [abs_mul]; exact mul_le_mul hpangA H5' (abs_nonneg _) hA0.le
    have hb : |pzr5 B G γ * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) s ((0:ℝ), (1:ℝ), (0:ℝ)))| ≤ A * E := by
      rw [abs_mul]; exact mul_le_mul hpzA H6' (abs_nonneg _) hA0.le
    calc _ ≤ (A * E + A * E) * Lsb B.h G.r0 γ.1 ^ 2 :=
          mul_le_mul_of_nonneg_right ((abs_add_le _ _).trans (add_le_add ha hb)) hL2.le
      _ = 2 * A * (E * Lsb B.h G.r0 γ.1 ^ 2) := by ring
      _ ≤ 2 * A * (3 * |M| * Kc) := mul_le_mul_of_nonneg_left hEL (by linarith)
      _ ≤ M0 := by rw [hM0]; linarith [p1, p2, p3, p4, hA5]
  have h3E : 3 * E ≤ M0 / Lsb B.h G.r0 γ.1 := by
    rw [le_div_iff₀ hL0]
    have := mul_le_mul_of_nonneg_left hLL hE0
    calc 3 * E * Lsb B.h G.r0 γ.1 ≤ 3 * (E * Lsb B.h G.r0 γ.1 ^ 2) := by linarith
      _ ≤ 3 * (3 * |M| * Kc) := by linarith
      _ ≤ M0 := by rw [hM0]; linarith [p1, p2, p3, p5, hA5]
  have hKgen : ∀ (b d g' b' d' g'' bd : ℝ), 0 ≤ bd → |b - b'| ≤ bd → |d - d'| ≤ bd → |g' - g''| ≤ bd →
      ∀ i j : Fin 3, |!![0, b, 0; d, 0, 0; g', 0, 0] i j - !![0, b', 0; d', 0, 0; g'', 0, 0] i j| ≤ bd := by
    intro b d g' b' d' g'' bd h0 hb hd hg i j
    fin_cases i <;> fin_cases j <;> simp [h0, hb, hd, hg]
  have e1 := abs_le.mp H1'
  have e2 := abs_le.mp H2'
  have e3 := abs_le.mp H3'
  have hKb : |-2 * pcFa5 B γ.1 s - -2 * F0r5 B G γ| ≤ M0 / Lsb B.h G.r0 γ.1 :=
    abs_le.mpr ⟨by linarith, by linarith⟩
  have hKd : |2 * pcFa5 B γ.1 s + pcRC5 γ.1 s * (Real.sqrt (Qb γ.1) * fderiv ℝ (pcFa5 B γ.1) s ((1:ℝ), (0:ℝ), (0:ℝ))) -
      (2 * F0r5 B G γ + (g0r5 B G γ).1)| ≤ M0 / Lsb B.h G.r0 γ.1 :=
    abs_le.mpr ⟨by linarith, by linarith⟩
  have hKg : |Real.sqrt (Qb γ.1) * fderiv ℝ (pcB5 B γ.1 2) s ((1:ℝ), (0:ℝ), (0:ℝ)) - (g0r5 B G γ).2| ≤
      M0 / Lsb B.h G.r0 γ.1 :=
    abs_le.mpr ⟨by linarith, by linarith⟩
  refine ⟨fun i => ?_, fun i => ?_, fun i j => ?_⟩
  · fin_cases i
    · exact hA0'
    · exact hA1'
    · exact hA2'
  · fin_cases i
    · exact hP0'
    · exact hP1'
    · exact hP2'
  · unfold pcKm5
    exact hKgen _ _ _ _ _ _ _ (div_nonneg hM00 hL0.le) hKb hKd hKg i j

theorem ptm_refid5 : ∀ (F0 E N1 N2 Bs s ek : ℝ) (t : Fin 3 → ℝ), N1 ^ 2 + N2 ^ 2 = 1 → Bs ≠ 0 → ((-!![0, -2 * F0, 0; 2 * F0 + E * N1, 0, 0; E * N2, 0, 0] + (dotProduct ![Bs * s, Bs * (-N2), Bs * N1] ![Bs * s, Bs * (-N2), Bs * N1])⁻¹ • Matrix.vecMulVec ![Bs * s, Bs * (-N2), Bs * N1] (Matrix.vecMul ![Bs * s, Bs * (-N2), Bs * N1] !![0, -2 * F0, 0; 2 * F0 + E * N1, 0, 0; E * N2, 0, 0])).mulVec t - (ek * dotProduct ![Bs * s, Bs * (-N2), Bs * N1] ![Bs * s, Bs * (-N2), Bs * N1]) • t) 0 = 2 * F0 * N1 / (1 + s ^ 2) * (N1 * t 1 + N2 * t 2) - 2 * F0 * N2 / (1 + s ^ 2) * ((-N2 * t 1 + N1 * t 2) + s * t 0) - ek * (Bs ^ 2 * (1 + s ^ 2)) * t 0 ∧ N1 * ((-!![0, -2 * F0, 0; 2 * F0 + E * N1, 0, 0; E * N2, 0, 0] + (dotProduct ![Bs * s, Bs * (-N2), Bs * N1] ![Bs * s, Bs * (-N2), Bs * N1])⁻¹ • Matrix.vecMulVec ![Bs * s, Bs * (-N2), Bs * N1] (Matrix.vecMul ![Bs * s, Bs * (-N2), Bs * N1] !![0, -2 * F0, 0; 2 * F0 + E * N1, 0, 0; E * N2, 0, 0])).mulVec t - (ek * dotProduct ![Bs * s, Bs * (-N2), Bs * N1] ![Bs * s, Bs * (-N2), Bs * N1]) • t) 1 + N2 * ((-!![0, -2 * F0, 0; 2 * F0 + E * N1, 0, 0; E * N2, 0, 0] + (dotProduct ![Bs * s, Bs * (-N2), Bs * N1] ![Bs * s, Bs * (-N2), Bs * N1])⁻¹ • Matrix.vecMulVec ![Bs * s, Bs * (-N2), Bs * N1] (Matrix.vecMul ![Bs * s, Bs * (-N2), Bs * N1] !![0, -2 * F0, 0; 2 * F0 + E * N1, 0, 0; E * N2, 0, 0])).mulVec t - (ek * dotProduct ![Bs * s, Bs * (-N2), Bs * N1] ![Bs * s, Bs * (-N2), Bs * N1]) • t) 2 = -(2 * F0 * N1 + E) * t 0 - ek * (Bs ^ 2 * (1 + s ^ 2)) * (N1 * t 1 + N2 * t 2) :=
by
  intro F0 E N1 N2 Bs s ek t hNN hBs
  have hd : dotProduct ![Bs * s, Bs * (-N2), Bs * N1] ![Bs * s, Bs * (-N2), Bs * N1] = Bs ^ 2 * (1 + s ^ 2) := by
    simp only [dotProduct, Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    linear_combination Bs ^ 2 * hNN
  have hs : (1 + s ^ 2) ≠ 0 := by positivity
  have h1 : Bs * Bs⁻¹ = 1 := mul_inv_cancel₀ hBs
  have h2 : (1 + s ^ 2) * (1 + s ^ 2)⁻¹ = 1 := mul_inv_cancel₀ hs
  have hDi : (Bs ^ 2 * (1 + s ^ 2))⁻¹ = Bs⁻¹ * Bs⁻¹ * (1 + s ^ 2)⁻¹ := by
    rw [mul_inv, sq, mul_inv]
  rw [hd, hDi]
  constructor
  · simp only [Matrix.mulVec, dotProduct, Matrix.vecMul, Matrix.vecMulVec_apply, Fin.sum_univ_three,
      Matrix.add_apply, Matrix.neg_apply, Matrix.smul_apply, Pi.sub_apply, Pi.smul_apply,
      Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_fin_const,
      smul_eq_mul]
    linear_combination (-2 * F0 * s * (1 + s ^ 2)⁻¹ * (N2 * t 0 + s * t 1) * (Bs * Bs⁻¹ + 1)) * h1
      + (-2 * F0 * (1 + s ^ 2)⁻¹ * t 1) * hNN + (-2 * F0 * t 1) * h2
  · simp only [Matrix.mulVec, dotProduct, Matrix.vecMul, Matrix.vecMulVec_apply, Fin.sum_univ_three,
      Matrix.add_apply, Matrix.neg_apply, Matrix.smul_apply, Pi.sub_apply, Pi.smul_apply,
      Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_fin_const,
      smul_eq_mul]
    linear_combination (-E * t 0) * hNN

theorem ptm_pert5 : ∀ (B1 c δ ek : ℝ) (n nr ψ t : Fin 3 → ℝ) (K Kr : Matrix (Fin 3) (Fin 3) ℝ), 0 ≤ B1 → 0 < c → 0 ≤ δ → δ ≤ 1 → δ ≤ c / (6 * (2 * B1 + 1)) → 0 ≤ ek → ek ≤ 4 → (∀ i, |nr i| ≤ B1) → (∀ i j, |Kr i j| ≤ B1) → c ≤ dotProduct nr nr → (∀ i, |n i - nr i| ≤ δ) → (∀ i, |ψ i| ≤ δ) → (∀ i j, |K i j - Kr i j| ≤ δ) → ∀ i : Fin 3, |((-K + (dotProduct n n)⁻¹ • Matrix.vecMulVec n (Matrix.vecMul n K + ψ)).mulVec t - (ek * dotProduct n n) • t) i - ((-Kr + (dotProduct nr nr)⁻¹ • Matrix.vecMulVec nr (Matrix.vecMul nr Kr)).mulVec t - (ek * dotProduct nr nr) • t) i| ≤ (1 + 12 * (2 * B1 + 1) + 2 / c * (3 * (B1 + 1) ^ 2 + 1 + B1 * (6 * B1 + 4)) + 6 * B1 * (3 * (B1 + 1) ^ 2 + 1) * (2 * B1 + 1) / c ^ 2) * δ * (|t 0| + |t 1| + |t 2|) :=
by
  intro B1 c δ ek n nr ψ t K Kr hB1 hc hδ0 hδ1 hδc hek0 hek4 hnr hKr hcν hn hψ hK i
  obtain ⟨T, hT⟩ : ∃ T : ℝ, T = |t 0| + |t 1| + |t 2| := ⟨_, rfl⟩
  have hti : |t i| ≤ T := by
    have h0 := abs_nonneg (t 0)
    have h1 := abs_nonneg (t 1)
    have h2 := abs_nonneg (t 2)
    rw [hT]
    fin_cases i
    · show |t 0| ≤ _; linarith
    · show |t 1| ≤ _; linarith
    · show |t 2| ≤ _; linarith
  rw [← hT]
  have hadd : ∀ a b : ℝ, |a + b| ≤ |a| + |b| := fun a b => abs_add_le a b
  have hsub : ∀ a b : ℝ, |a - b| ≤ |a| + |b| := fun a b => by
    have := hadd a (-b)
    rwa [← sub_eq_add_neg, abs_neg] at this
  have habs3 : ∀ a b d : ℝ, |a + b + d| ≤ |a| + |b| + |d| := fun a b d => by
    have h1 := hadd (a + b) d
    have h2 := hadd a b
    linarith
  have hmulle : ∀ a b x y : ℝ, |a| ≤ x → |b| ≤ y → |a * b| ≤ x * y := by
    intro a b x y ha hb
    rw [abs_mul]
    exact mul_le_mul ha hb (abs_nonneg _) ((abs_nonneg _).trans ha)
  have hdot : ∀ (w : Fin 3 → ℝ) (M : ℝ), (∀ j, |w j| ≤ M) → |dotProduct w t| ≤ M * T := by
    intro w M hw
    have e : dotProduct w t = w 0 * t 0 + w 1 * t 1 + w 2 * t 2 := by
      simp only [dotProduct, Fin.sum_univ_three]
    rw [e, hT]
    have h0 := hmulle _ _ _ _ (hw 0) (le_refl |t 0|)
    have h1 := hmulle _ _ _ _ (hw 1) (le_refl |t 1|)
    have h2 := hmulle _ _ _ _ (hw 2) (le_refl |t 2|)
    have h3 := habs3 (w 0 * t 0) (w 1 * t 1) (w 2 * t 2)
    linarith
  have hnb : ∀ j, |n j| ≤ B1 + 1 := fun j => by
    have h := hadd (n j - nr j) (nr j)
    rw [sub_add_cancel] at h
    linarith [hn j, hnr j]
  have hKb : ∀ a b, |K a b| ≤ B1 + 1 := fun a b => by
    have h := hadd (K a b - Kr a b) (Kr a b)
    rw [sub_add_cancel] at h
    linarith [hK a b, hKr a b]
  have hs2 : ∀ j, |n j + nr j| ≤ 2 * B1 + 1 := fun j => by
    have h := hadd (n j) (nr j)
    linarith [hnb j, hnr j]

  have hνd : |dotProduct n n - dotProduct nr nr| ≤ 3 * δ * (2 * B1 + 1) := by
    have e : dotProduct n n - dotProduct nr nr = (n 0 - nr 0) * (n 0 + nr 0) +
        (n 1 - nr 1) * (n 1 + nr 1) + (n 2 - nr 2) * (n 2 + nr 2) := by
      simp only [dotProduct, Fin.sum_univ_three]; ring
    rw [e]
    have h0 := hmulle _ _ _ _ (hn 0) (hs2 0)
    have h1 := hmulle _ _ _ _ (hn 1) (hs2 1)
    have h2 := hmulle _ _ _ _ (hn 2) (hs2 2)
    have h3 := habs3 ((n 0 - nr 0) * (n 0 + nr 0)) ((n 1 - nr 1) * (n 1 + nr 1))
      ((n 2 - nr 2) * (n 2 + nr 2))
    linarith
  have h6 : 6 * δ * (2 * B1 + 1) ≤ c := by
    have hpos : (0:ℝ) < 6 * (2 * B1 + 1) := by positivity
    rw [le_div_iff₀ hpos] at hδc
    linarith
  have hνlow : c / 2 ≤ dotProduct n n := by
    have := (abs_le.mp hνd).1
    linarith
  have hνpos : 0 < dotProduct n n := by linarith
  have hνrpos : 0 < dotProduct nr nr := by linarith
  have hinv1 : |(dotProduct n n)⁻¹| ≤ 2 / c := by
    rw [abs_of_pos (inv_pos.mpr hνpos)]
    have := inv_anti₀ (by positivity : (0:ℝ) < c / 2) hνlow
    rwa [inv_div] at this
  have hinv2 : |(dotProduct nr nr)⁻¹| ≤ c⁻¹ := by
    rw [abs_of_pos (inv_pos.mpr hνrpos)]
    exact inv_anti₀ hc hcν

  have hr : ∀ j, (Matrix.vecMul n K + ψ) j = n 0 * K 0 j + n 1 * K 1 j + n 2 * K 2 j + ψ j := by
    intro j
    simp only [Pi.add_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_three]
  have hrr : ∀ j, Matrix.vecMul nr Kr j = nr 0 * Kr 0 j + nr 1 * Kr 1 j + nr 2 * Kr 2 j := by
    intro j
    simp only [Matrix.vecMul, dotProduct, Fin.sum_univ_three]
  have hrd : ∀ j, |(Matrix.vecMul n K + ψ - Matrix.vecMul nr Kr) j| ≤ δ * (6 * B1 + 4) := by
    intro j
    rw [Pi.sub_apply, hr j, hrr j]
    have e : n 0 * K 0 j + n 1 * K 1 j + n 2 * K 2 j + ψ j -
        (nr 0 * Kr 0 j + nr 1 * Kr 1 j + nr 2 * Kr 2 j)
        = ((n 0 - nr 0) * K 0 j + nr 0 * (K 0 j - Kr 0 j)) +
          ((n 1 - nr 1) * K 1 j + nr 1 * (K 1 j - Kr 1 j)) +
          ((n 2 - nr 2) * K 2 j + nr 2 * (K 2 j - Kr 2 j)) + ψ j := by ring
    rw [e]
    have hX : ∀ a, |(n a - nr a) * K a j + nr a * (K a j - Kr a j)| ≤ δ * (B1 + 1) + B1 * δ :=
      fun a => by
        have h1 := hmulle _ _ _ _ (hn a) (hKb a j)
        have h2 := hmulle _ _ _ _ (hnr a) (hK a j)
        have h3 := hadd ((n a - nr a) * K a j) (nr a * (K a j - Kr a j))
        linarith
    have h0 := hX 0
    have h1 := hX 1
    have h2 := hX 2
    have h3 := hadd (((n 0 - nr 0) * K 0 j + nr 0 * (K 0 j - Kr 0 j)) +
          ((n 1 - nr 1) * K 1 j + nr 1 * (K 1 j - Kr 1 j)) +
          ((n 2 - nr 2) * K 2 j + nr 2 * (K 2 j - Kr 2 j))) (ψ j)
    have h4 := habs3 ((n 0 - nr 0) * K 0 j + nr 0 * (K 0 j - Kr 0 j))
      ((n 1 - nr 1) * K 1 j + nr 1 * (K 1 j - Kr 1 j))
      ((n 2 - nr 2) * K 2 j + nr 2 * (K 2 j - Kr 2 j))
    have h5 := hψ j
    linarith
  have hrb : ∀ j, |(Matrix.vecMul n K + ψ) j| ≤ 3 * (B1 + 1) ^ 2 + 1 := by
    intro j
    rw [hr j]
    have h0 := hmulle _ _ _ _ (hnb 0) (hKb 0 j)
    have h1 := hmulle _ _ _ _ (hnb 1) (hKb 1 j)
    have h2 := hmulle _ _ _ _ (hnb 2) (hKb 2 j)
    have h3 := hadd (n 0 * K 0 j + n 1 * K 1 j + n 2 * K 2 j) (ψ j)
    have h4 := habs3 (n 0 * K 0 j) (n 1 * K 1 j) (n 2 * K 2 j)
    have h5 := hψ j
    nlinarith
  have hrrb : ∀ j, |Matrix.vecMul nr Kr j| ≤ 3 * (B1 + 1) ^ 2 + 1 := by
    intro j
    rw [hrr j]
    have h0 := hmulle _ _ _ _ (hnr 0) (hKr 0 j)
    have h1 := hmulle _ _ _ _ (hnr 1) (hKr 1 j)
    have h2 := hmulle _ _ _ _ (hnr 2) (hKr 2 j)
    have h4 := habs3 (nr 0 * Kr 0 j) (nr 1 * Kr 1 j) (nr 2 * Kr 2 j)
    nlinarith
  have hDd : |dotProduct (Matrix.vecMul n K + ψ) t - dotProduct (Matrix.vecMul nr Kr) t|
      ≤ δ * (6 * B1 + 4) * T := by
    rw [← sub_dotProduct]
    exact hdot _ _ hrd
  have hDb : |dotProduct (Matrix.vecMul n K + ψ) t| ≤ (3 * (B1 + 1) ^ 2 + 1) * T := hdot _ _ hrb
  have hDrb : |dotProduct (Matrix.vecMul nr Kr) t| ≤ (3 * (B1 + 1) ^ 2 + 1) * T := hdot _ _ hrrb
  have hKp : |dotProduct (fun j => K i j - Kr i j) t| ≤ δ * T := hdot _ _ (fun j => hK i j)

  have hexp : ((-K + (dotProduct n n)⁻¹ • Matrix.vecMulVec n (Matrix.vecMul n K + ψ)).mulVec t -
      (ek * dotProduct n n) • t) i - ((-Kr + (dotProduct nr nr)⁻¹ •
      Matrix.vecMulVec nr (Matrix.vecMul nr Kr)).mulVec t - (ek * dotProduct nr nr) • t) i
      = -(dotProduct (fun j => K i j - Kr i j) t) +
        ((dotProduct n n)⁻¹ * (n i * dotProduct (Matrix.vecMul n K + ψ) t) -
          (dotProduct nr nr)⁻¹ * (nr i * dotProduct (Matrix.vecMul nr Kr) t)) -
        ek * (dotProduct n n - dotProduct nr nr) * t i := by
    simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Matrix.mulVec, dotProduct,
      Fin.sum_univ_three, Matrix.add_apply, Matrix.neg_apply, Matrix.smul_apply,
      Matrix.vecMulVec_apply, Matrix.vecMul, Pi.add_apply]
    ring
  rw [hexp]
  set ν := dotProduct n n with hν
  set νr := dotProduct nr nr with hνr
  set D := dotProduct (Matrix.vecMul n K + ψ) t with hD
  set Dr := dotProduct (Matrix.vecMul nr Kr) t with hDr
  set Kp := dotProduct (fun j => K i j - Kr i j) t with hKp'
  have hPd : |n i * D - nr i * Dr| ≤
      δ * ((3 * (B1 + 1) ^ 2 + 1) * T) + B1 * (δ * (6 * B1 + 4) * T) := by
    have e : n i * D - nr i * Dr = (n i - nr i) * D + nr i * (D - Dr) := by ring
    rw [e]
    have h1 := hmulle _ _ _ _ (hn i) hDb
    have h2 := hmulle _ _ _ _ (hnr i) hDd
    have h3 := hadd ((n i - nr i) * D) (nr i * (D - Dr))
    linarith
  have hPr : |nr i * Dr| ≤ B1 * ((3 * (B1 + 1) ^ 2 + 1) * T) := hmulle _ _ _ _ (hnr i) hDrb
  have hQ : |ν⁻¹ * (n i * D) - νr⁻¹ * (nr i * Dr)| ≤
      2 / c * (δ * ((3 * (B1 + 1) ^ 2 + 1) * T) + B1 * (δ * (6 * B1 + 4) * T)) +
      B1 * ((3 * (B1 + 1) ^ 2 + 1) * T) * (3 * δ * (2 * B1 + 1)) * (2 / c * c⁻¹) := by
    have h1 : ν * ν⁻¹ = 1 := mul_inv_cancel₀ hνpos.ne'
    have h2 : νr * νr⁻¹ = 1 := mul_inv_cancel₀ hνrpos.ne'
    have e : ν⁻¹ * (n i * D) - νr⁻¹ * (nr i * Dr) =
        ν⁻¹ * (n i * D - nr i * Dr) + nr i * Dr * (νr - ν) * (ν⁻¹ * νr⁻¹) := by
      linear_combination (-(nr i * Dr) * ν⁻¹) * h2 + (nr i * Dr * νr⁻¹) * h1
    rw [e]
    have hνd' : |νr - ν| ≤ 3 * δ * (2 * B1 + 1) := by rw [abs_sub_comm]; exact hνd
    have k1 := hmulle _ _ _ _ hinv1 hPd
    have k2 := hmulle _ _ _ _ hinv1 hinv2
    have k3 := hmulle _ _ _ _ hPr hνd'
    have k4 := hmulle _ _ _ _ k3 k2
    have k5 := hadd (ν⁻¹ * (n i * D - nr i * Dr)) (nr i * Dr * (νr - ν) * (ν⁻¹ * νr⁻¹))
    linarith
  have hek : |ek| ≤ 4 := by rw [abs_of_nonneg hek0]; exact hek4
  have hE : |ek * (ν - νr) * t i| ≤ 4 * (3 * δ * (2 * B1 + 1)) * T :=
    hmulle _ _ _ _ (hmulle _ _ _ _ hek hνd) hti
  have hfin := hsub (-Kp + (ν⁻¹ * (n i * D) - νr⁻¹ * (nr i * Dr))) (ek * (ν - νr) * t i)
  have hfin2 := hadd (-Kp) (ν⁻¹ * (n i * D) - νr⁻¹ * (nr i * Dr))
  rw [abs_neg] at hfin2
  calc _ ≤ δ * T + (2 / c * (δ * ((3 * (B1 + 1) ^ 2 + 1) * T) + B1 * (δ * (6 * B1 + 4) * T)) +
      B1 * ((3 * (B1 + 1) ^ 2 + 1) * T) * (3 * δ * (2 * B1 + 1)) * (2 / c * c⁻¹)) +
      4 * (3 * δ * (2 * B1 + 1)) * T := by linarith
    _ = _ := by ring

theorem ptm_trans5 : ∀ (κ S Bs s N1 N2 δ : ℝ) (n t : Fin 3 → ℝ), 0 < κ → 0 ≤ S → κ ≤ Bs → |s| ≤ S → N1 ^ 2 + N2 ^ 2 = 1 → 0 ≤ δ → δ ≤ κ / (4 * (1 + S)) → |n 0 - Bs * s| ≤ δ → |n 1 - Bs * (-N2)| ≤ δ → |n 2 - Bs * N1| ≤ δ → dotProduct n t = 0 → |(-N2 * t 1 + N1 * t 2) + s * t 0| ≤ 2 * (3 + 2 * S) / κ * δ * (|t 0| + |N1 * t 1 + N2 * t 2|) ∧ |t 0| + |t 1| + |t 2| ≤ (5 + 2 * S) * (|t 0| + |N1 * t 1 + N2 * t 2|) :=
by
  intro κ S Bs s N1 N2 δ n t hκ hS hBs hs hN hδ0 hδ h0 h1 h2 hdot
  have hdot' : n 0 * t 0 + n 1 * t 1 + n 2 * t 2 = 0 := by
    simpa [dotProduct, Fin.sum_univ_three] using hdot
  have habs : ∀ a b : ℝ, |a - b| ≤ |a| + |b| := fun a b =>
    abs_le.mpr ⟨by linarith [neg_abs_le a, le_abs_self b], by linarith [le_abs_self a, neg_abs_le b]⟩
  have hadd : ∀ a b : ℝ, |a + b| ≤ |a| + |b| := fun a b =>
    abs_le.mpr ⟨by linarith [neg_abs_le a, neg_abs_le b], by linarith [le_abs_self a, le_abs_self b]⟩
  have hBpos : 0 < Bs := lt_of_lt_of_le hκ hBs

  have hid : Bs * ((-N2 * t 1 + N1 * t 2) + s * t 0) =
      -((n 0 - Bs * s) * t 0 + (n 1 - Bs * (-N2)) * t 1 + (n 2 - Bs * N1) * t 2) := by
    linear_combination hdot'
  have hBZ : Bs * |(-N2 * t 1 + N1 * t 2) + s * t 0| ≤ δ * (|t 0| + |t 1| + |t 2|) := by
    have e1 : Bs * |(-N2 * t 1 + N1 * t 2) + s * t 0| =
        |(n 0 - Bs * s) * t 0 + (n 1 - Bs * (-N2)) * t 1 + (n 2 - Bs * N1) * t 2| := by
      have : |Bs * ((-N2 * t 1 + N1 * t 2) + s * t 0)| =
          |-((n 0 - Bs * s) * t 0 + (n 1 - Bs * (-N2)) * t 1 + (n 2 - Bs * N1) * t 2)| := by
        rw [hid]
      rw [abs_mul, abs_of_pos hBpos, abs_neg] at this
      exact this
    rw [e1]
    have a1 := hadd ((n 0 - Bs * s) * t 0 + (n 1 - Bs * (-N2)) * t 1) ((n 2 - Bs * N1) * t 2)
    have a2 := hadd ((n 0 - Bs * s) * t 0) ((n 1 - Bs * (-N2)) * t 1)
    simp only [abs_mul] at a1 a2
    have m0 := mul_le_mul_of_nonneg_right h0 (abs_nonneg (t 0))
    have m1 := mul_le_mul_of_nonneg_right h1 (abs_nonneg (t 1))
    have m2 := mul_le_mul_of_nonneg_right h2 (abs_nonneg (t 2))
    nlinarith
  have hκZ : κ * |(-N2 * t 1 + N1 * t 2) + s * t 0| ≤ δ * (|t 0| + |t 1| + |t 2|) :=
    le_trans (mul_le_mul_of_nonneg_right hBs (abs_nonneg _)) hBZ

  have hN1 : |N1| ≤ 1 := abs_le.mpr ⟨by nlinarith [sq_nonneg N2, sq_nonneg (N1 + 1)],
    by nlinarith [sq_nonneg N2, sq_nonneg (N1 - 1)]⟩
  have hN2 : |N2| ≤ 1 := abs_le.mpr ⟨by nlinarith [sq_nonneg N1, sq_nonneg (N2 + 1)],
    by nlinarith [sq_nonneg N1, sq_nonneg (N2 - 1)]⟩
  have ht1e : t 1 = N1 * (N1 * t 1 + N2 * t 2) - N2 * (-N2 * t 1 + N1 * t 2) := by
    linear_combination (-(t 1)) * hN
  have ht2e : t 2 = N2 * (N1 * t 1 + N2 * t 2) + N1 * (-N2 * t 1 + N1 * t 2) := by
    linear_combination (-(t 2)) * hN
  have hm : ∀ a b : ℝ, |a| ≤ 1 → |a * b| ≤ |b| := fun a b ha => by
    rw [abs_mul]; exact mul_le_of_le_one_left (abs_nonneg _) ha
  have ht1b : |t 1| ≤ |N1 * t 1 + N2 * t 2| + |-N2 * t 1 + N1 * t 2| := by
    have := habs (N1 * (N1 * t 1 + N2 * t 2)) (N2 * (-N2 * t 1 + N1 * t 2))
    rw [← ht1e] at this
    linarith [hm N1 (N1 * t 1 + N2 * t 2) hN1, hm N2 (-N2 * t 1 + N1 * t 2) hN2]
  have ht2b : |t 2| ≤ |N1 * t 1 + N2 * t 2| + |-N2 * t 1 + N1 * t 2| := by
    have := hadd (N2 * (N1 * t 1 + N2 * t 2)) (N1 * (-N2 * t 1 + N1 * t 2))
    rw [← ht2e] at this
    linarith [hm N2 (N1 * t 1 + N2 * t 2) hN2, hm N1 (-N2 * t 1 + N1 * t 2) hN1]
  have hsx : |s * t 0| ≤ S * |t 0| := by
    rw [abs_mul]; exact mul_le_mul_of_nonneg_right hs (abs_nonneg _)
  have hwb : |-N2 * t 1 + N1 * t 2| ≤ |(-N2 * t 1 + N1 * t 2) + s * t 0| + |s * t 0| :=
    abs_le.mpr ⟨by linarith [neg_abs_le ((-N2 * t 1 + N1 * t 2) + s * t 0), le_abs_self (s * t 0)],
      by linarith [le_abs_self ((-N2 * t 1 + N1 * t 2) + s * t 0), neg_abs_le (s * t 0)]⟩
  have hT : |t 0| + |t 1| + |t 2| ≤ (1 + 2 * S) * |t 0| + 2 * |N1 * t 1 + N2 * t 2| +
      2 * |(-N2 * t 1 + N1 * t 2) + s * t 0| := by
    linarith

  have h4 : δ * (4 * (1 + S)) ≤ κ := (le_div_iff₀ (by positivity)).mp hδ
  have h4' : 4 * δ ≤ κ := by nlinarith [mul_nonneg hδ0 hS]
  have hZ0 := abs_nonneg ((-N2 * t 1 + N1 * t 2) + s * t 0)
  have hx0 := abs_nonneg (t 0)
  have hy0 := abs_nonneg (N1 * t 1 + N2 * t 2)
  have hA : κ * |(-N2 * t 1 + N1 * t 2) + s * t 0| ≤
      2 * (3 + 2 * S) * δ * (|t 0| + |N1 * t 1 + N2 * t 2|) := by
    have p1 := mul_le_mul_of_nonneg_left hT hδ0
    have p2 := mul_le_mul_of_nonneg_right h4' hZ0
    nlinarith [mul_nonneg hδ0 hx0, mul_nonneg hδ0 hy0, mul_nonneg (mul_nonneg hδ0 hS) hx0,
      mul_nonneg (mul_nonneg hδ0 hS) hy0]
  refine ⟨?_, ?_⟩
  · rw [show 2 * (3 + 2 * S) / κ * δ * (|t 0| + |N1 * t 1 + N2 * t 2|) =
        (2 * (3 + 2 * S) * δ * (|t 0| + |N1 * t 1 + N2 * t 2|)) / κ by ring, le_div_iff₀ hκ]
    linarith
  · have h5 : 4 * δ * (3 + 2 * S) ≤ 3 * κ := by nlinarith [mul_nonneg hδ0 hS]
    have hY0 : 0 ≤ |t 0| + |N1 * t 1 + N2 * t 2| := by linarith
    have p3 := mul_le_mul_of_nonneg_right h5 hY0
    have hk : κ * (2 * |(-N2 * t 1 + N1 * t 2) + s * t 0|) ≤
        κ * (3 * (|t 0| + |N1 * t 1 + N2 * t 2|)) := by nlinarith
    have h2Z := le_of_mul_le_mul_left hk hκ
    nlinarith [mul_nonneg hS hy0, mul_nonneg hS hx0]

theorem ptm_init5 : ∀ (κ D S R Bs s c N1 N2 δ P0 : ℝ) (a t : Fin 3 → ℝ), 0 < κ → κ ≤ Bs → Bs ≤ D → 0 ≤ S → |s| ≤ S → |c| ≤ R → N1 ^ 2 + N2 ^ 2 = 1 → 0 ≤ δ → δ ≤ κ / 4 → |a 0 - Bs * s| ≤ δ → |a 1 - Bs * (-N2)| ≤ δ → |a 2 - Bs * N1| ≤ δ → 0 < P0 → t = P0 • ((![1, 0, 0] - (a 0 / Real.sqrt (a 1 ^ 2 + a 2 ^ 2)) • ![0, a 1 / Real.sqrt (a 1 ^ 2 + a 2 ^ 2), a 2 / Real.sqrt (a 1 ^ 2 + a 2 ^ 2)]) + c • ![0, a 2 / Real.sqrt (a 1 ^ 2 + a 2 ^ 2), -(a 1 / Real.sqrt (a 1 ^ 2 + a 2 ^ 2))]) → t 0 = P0 ∧ |N1 * t 1 + N2 * t 2 - c * P0| ≤ (8 * (D * S + κ) / κ ^ 2 + 4 * R / κ) * δ * P0 :=
by
  intro κ D S R Bs s c N1 N2 δ P0 a t hκ hκB hBD hS hs hc hN hδ0 hδ ha0 ha1 ha2 hP0 ht
  obtain ⟨n, hn⟩ : ∃ n, n = Real.sqrt (a 1 ^ 2 + a 2 ^ 2) := ⟨_, rfl⟩
  rw [← hn] at ht
  have ht0 : t 0 = P0 := by rw [ht]; simp
  have ht1 : t 1 = P0 * (-(a 0 / n * (a 1 / n)) + c * (a 2 / n)) := by
    rw [ht]; simp <;> ring
  have ht2 : t 2 = P0 * (-(a 0 / n * (a 2 / n)) + c * (-(a 1 / n))) := by
    rw [ht]; simp <;> ring
  refine ⟨ht0, ?_⟩
  have hN1 : |N1| ≤ 1 := by
    rw [← sq_le_one_iff_abs_le_one]; nlinarith [sq_nonneg N2]
  have hN2 : |N2| ≤ 1 := by
    rw [← sq_le_one_iff_abs_le_one]; nlinarith [sq_nonneg N1]
  have hprod : ∀ x y : ℝ, |x| ≤ 1 → |y| ≤ δ → -δ ≤ x * y ∧ x * y ≤ δ := by
    intro x y hx hy
    have : |x * y| ≤ δ := by
      rw [abs_mul]
      nlinarith [abs_nonneg x, abs_nonneg y, mul_nonneg (sub_nonneg.2 hx) (abs_nonneg y)]
    exact abs_le.mp this
  have he1 : |a 1 + Bs * N2| ≤ δ := by
    have h := ha1
    rwa [show a 1 - Bs * (-N2) = a 1 + Bs * N2 by ring] at h
  obtain ⟨p, hp⟩ : ∃ p, p = N1 * a 2 - N2 * a 1 := ⟨_, rfl⟩
  obtain ⟨m, hm⟩ : ∃ m, m = N1 * a 1 + N2 * a 2 := ⟨_, rfl⟩
  have hp_eq : p = Bs + N1 * (a 2 - Bs * N1) - N2 * (a 1 + Bs * N2) := by
    rw [hp]; linear_combination Bs * hN
  have hm_eq : m = N1 * (a 1 + Bs * N2) + N2 * (a 2 - Bs * N1) := by
    rw [hm]; ring
  obtain ⟨q1, q2⟩ := hprod N1 _ hN1 ha2
  obtain ⟨q3, q4⟩ := hprod N2 _ hN2 he1
  obtain ⟨q5, q6⟩ := hprod N1 _ hN1 he1
  obtain ⟨q7, q8⟩ := hprod N2 _ hN2 ha2
  have hp_lb : κ / 2 ≤ p := by rw [hp_eq]; linarith
  have hm_lb : -(2 * δ) ≤ m := by rw [hm_eq]; linarith
  have hm_ub : m ≤ 2 * δ := by rw [hm_eq]; linarith
  have hm_abs : |m| ≤ 2 * δ := abs_le.mpr ⟨hm_lb, hm_ub⟩
  have hm2 : m ^ 2 ≤ κ * δ := by
    nlinarith [mul_nonneg (sub_nonneg.2 hm_ub) (by linarith : (0:ℝ) ≤ 2 * δ + m),
      mul_nonneg hδ0 (by linarith : (0:ℝ) ≤ κ - 4 * δ)]
  have hsum : a 1 ^ 2 + a 2 ^ 2 = p ^ 2 + m ^ 2 := by
    rw [hp, hm]; linear_combination (-(a 1 ^ 2 + a 2 ^ 2)) * hN
  have hnsq : n ^ 2 = a 1 ^ 2 + a 2 ^ 2 := by
    rw [hn]; exact Real.sq_sqrt (by positivity)
  have hp0 : 0 ≤ p := by linarith
  have hn0 : 0 ≤ n := by rw [hn]; exact Real.sqrt_nonneg _
  have hkey : (p - n) * (p + n) = -(m ^ 2) := by linear_combination -hsum - hnsq
  have hpn : p ≤ n := by
    by_contra hcon
    rw [not_le] at hcon
    have h1 := mul_pos (sub_pos.2 hcon) (by linarith : (0:ℝ) < p + n)
    rw [hkey] at h1
    linarith [sq_nonneg m]
  have hn_lb : κ / 2 ≤ n := le_trans hp_lb hpn
  have hnpos : 0 < n := by linarith
  have hnne : n ≠ 0 := hnpos.ne'
  have hn2 : κ ^ 2 / 4 ≤ n ^ 2 := by
    have h1 : (κ / 2) ^ 2 ≤ n ^ 2 := pow_le_pow_left₀ (by linarith) hn_lb 2
    have h2 : (κ / 2) ^ 2 = κ ^ 2 / 4 := by ring
    linarith
  have hn2pos : 0 < n ^ 2 := by positivity
  have hid : N1 * t 1 + N2 * t 2 - c * P0 = P0 * (-(a 0 * m) - c * ((n - p) * n)) / n ^ 2 := by
    rw [ht1, ht2, hp, hm]
    field_simp
    ring

  have hBs0 : 0 < Bs := by linarith
  have hBss : |Bs * s| ≤ D * S := by
    rw [abs_mul, abs_of_pos hBs0]
    calc Bs * |s| ≤ Bs * S := mul_le_mul_of_nonneg_left hs hBs0.le
      _ ≤ D * S := mul_le_mul_of_nonneg_right hBD hS
  have ha0b : |a 0| ≤ D * S + κ := by
    have h1 := abs_le.mp ha0
    have h2 := abs_le.mp hBss
    rw [abs_le]; constructor <;> linarith
  have hDS : 0 ≤ D * S + κ := by
    have : 0 ≤ D * S := mul_nonneg (by linarith) hS
    linarith
  have hA : |a 0 * m| ≤ (D * S + κ) * (2 * δ) := by
    rw [abs_mul]; exact mul_le_mul ha0b hm_abs (abs_nonneg _) hDS
  have hq0 : 0 ≤ (n - p) * n := mul_nonneg (by linarith) hnpos.le
  have hq : (n - p) * n ≤ κ * δ := by
    have h1 : (n - p) * n ≤ (n - p) * (n + p) :=
      mul_le_mul_of_nonneg_left (by linarith) (by linarith)
    have h2 : (n - p) * (n + p) = m ^ 2 := by linear_combination hnsq + hsum
    linarith
  have hR0 : 0 ≤ R := le_trans (abs_nonneg c) hc
  have hC : |c * ((n - p) * n)| ≤ R * (κ * δ) := by
    rw [abs_mul, abs_of_nonneg hq0]; exact mul_le_mul hc hq hq0 hR0
  have hnum : |-(a 0 * m) - c * ((n - p) * n)| ≤ (D * S + κ) * (2 * δ) + R * (κ * δ) := by
    have h1 := abs_le.mp hA
    have h2 := abs_le.mp hC
    rw [abs_le]; constructor <;> linarith
  have hK : (8 * (D * S + κ) / κ ^ 2 + 4 * R / κ) * κ ^ 2 = 8 * (D * S + κ) + 4 * R * κ := by
    field_simp
  have hK0 : 0 ≤ 8 * (D * S + κ) / κ ^ 2 + 4 * R / κ :=
    add_nonneg (div_nonneg (by linarith) (by positivity)) (div_nonneg (by linarith) hκ.le)
  rw [hid, abs_div, abs_mul, abs_of_pos hP0, abs_of_pos hn2pos, div_le_iff₀ hn2pos]
  calc P0 * |-(a 0 * m) - c * ((n - p) * n)|
      ≤ P0 * ((D * S + κ) * (2 * δ) + R * (κ * δ)) := mul_le_mul_of_nonneg_left hnum hP0.le
    _ = (8 * (D * S + κ) / κ ^ 2 + 4 * R / κ) * δ * P0 * (κ ^ 2 / 4) := by
        linear_combination (-(δ * P0 / 4)) * hK
    _ ≤ (8 * (D * S + κ) / κ ^ 2 + 4 * R / κ) * δ * P0 * n ^ 2 :=
        mul_le_mul_of_nonneg_left hn2 (mul_nonneg (mul_nonneg hK0 hδ0) hP0.le)

theorem ptm_coef5 : ∀ (κ D F0 E N1 lam S s ek Bs : ℝ), 0 < κ → κ ≤ F0 → F0 ≤ D → κ ≤ E → E ≤ D → N1 ≤ -κ → N1 ^ 2 ≤ 1 → lam = Real.sqrt (-(2 * F0 * N1) * (2 * F0 * N1 + E)) → κ ≤ lam → 0 ≤ S → |s| ≤ S → 0 ≤ ek → ek ≤ 4 → |Bs| ≤ D → 2 * F0 * N1 / (1 + s ^ 2) * (lam / (2 * F0 * N1) * Real.sqrt (1 + s ^ 2)) = lam / Real.sqrt (1 + s ^ 2) ∧ -(2 * F0 * N1 + E) = lam / Real.sqrt (1 + s ^ 2) * (lam / (2 * F0 * N1) * Real.sqrt (1 + s ^ 2)) ∧ κ / (1 + S) ≤ lam / Real.sqrt (1 + s ^ 2) ∧ |2 * F0 * N1 / (1 + s ^ 2)| ≤ 2 * D ∧ |lam / (2 * F0 * N1)| ≤ D / κ ^ 2 ∧ |lam / (2 * F0 * N1) * Real.sqrt (1 + s ^ 2)| ≤ D / κ ^ 2 * (1 + S) ∧ |2 * F0 * N1 + E| ≤ 3 * D ∧ 0 ≤ ek * (Bs ^ 2 * (1 + s ^ 2)) ∧ ek * (Bs ^ 2 * (1 + s ^ 2)) ≤ 4 * D ^ 2 * (1 + S ^ 2) :=
