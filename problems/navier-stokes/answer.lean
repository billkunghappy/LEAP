theorem ptrack_closed_form5 : ∀ (B : BG) (G : CorrGeom) (γ : Lab) (ξ : Cyl), B.ok → ξ ∈ DomC B.h B.qB → (∃ k : ℝ × ℝ, ∀ᶠ Y' in nhds ξ.2.2.2, rectW B.h γ (G.ctr γ) Y' = Jpow (bandIdx B.h γ.1) Y' - G.ctr γ - k) → nPhi5 B G γ ξ = pcN5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2) ∧ nPhiP5 B G γ ξ = -pcPsi5 B G γ (ξ.1, ξ.2.1, ξ.2.2.1) ∧ Kmat B G γ ξ = pcKm5 B γ.1 (ξ.1, ξ.2.1, ξ.2.2.1) :=
