    integral_rpow (Or.inl (by linarith : (-1:ℝ) < -h))]
  have h1 : -h + 1 = 1 - h := by ring
  rw [h1, Real.zero_rpow (sub_pos.mpr hh1).ne']
  ring

theorem rfp_T_root_numeric : ∀ h ρ T1 S1 Kp : ℝ, 0 < h → h ≤ 1 / 10000 → 0 < ρ → ρ ≤ h / 800 → 4 * Real.log (1 / h) ≤ T1 → 0 ≤ S1 → S1 ≤ 1 → 0 ≤ Kp → Kp ≤ 3 → Real.exp ((1 - h) * S1) * (1 / (1 - h) + ρ / (1 - ρ) * (Real.exp (1 - h) / (1 - h) + Real.exp (3 * (1 - h)) * Kp)) ≤ T1 :=
