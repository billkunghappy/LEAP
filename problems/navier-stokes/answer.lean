      ContinuousAt (fun e => profRadInt (fun x e => Un x e * (2 * x * Fn x e)) X e) η0 →
      ContinuousAt (fun e => profEtaD (profRadInt (fun x e => Un x e * (2 * x * Fn x e))) X e) η0 →
