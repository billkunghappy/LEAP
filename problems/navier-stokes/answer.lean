      (fun p : ℝ³ × ℝ => simScale B.h (p.1 2) (1 - p.2)) p ≤ 1 :=
    fun p hp => ⟨hQpos p hp.1, le_trans hp.2.le hqs1⟩
  obtain ⟨h6i, h6ii⟩ := weight_leibniz_calculus_v5 (simDomain B.h qs)
