      have hqc : ContinuousAt (qC B.h) ξ := hqCs.continuousOn.continuousAt (hDo.mem_nhds hξ)
      have hrc : ContinuousAt (fun η => K k * qC B.h η ^ (B.h * α - 2 * (k : ℝ) - 1)) ξ :=
        continuousAt_const.mul (hqc.rpow_const (Or.inl q0.ne'))
      have hev : ∀ᶠ η in nhds ξ,
          K k * qC B.h η ^ (B.h * α - 2 * (k : ℝ) - 1) < ‖iteratedFDeriv ℝ k (a γ m) η‖ :=
        hrc.eventually_lt hcont.norm hcon
      have hfr : ∃ᶠ η in nhds ξ, η ∈ Function.support (a γ m) := mem_closure_iff_frequently.mp hts
      obtain ⟨η, hηs, hηlt, hηD⟩ := (hfr.and_eventually (hev.and (hDo.mem_nhds hξ))).exists
      have := hpt k γ m η hηD hηs
      linarith
    · rw [notMem_tsupport_iff_eventuallyEq] at hts
      rw [(hts.iteratedFDeriv ℝ k).eq_of_nhds]
      show ‖iteratedFDeriv ℝ k (fun _ : Cyl => (0 : Fin 3 → ℂ)) ξ‖ ≤ _
      rw [iteratedFDeriv_fun_zero]
      simp only [Pi.zero_apply, norm_zero]
      exact hR0

  obtain ⟨C, hC⟩ : ∃ C : ℝ, C = ∑ i ∈ Finset.range (n + 1), K i := ⟨_, rfl⟩
  refine ⟨C, fun γ m ξ hξ j hj => ?_⟩
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  have q0 := hqpos ξ hξ
  have q1 : qC B.h ξ ≤ 1 := le_trans hξ'.2.2.le hqs1
  have hKC : K j ≤ C := by
    rw [hC]
    exact Finset.single_le_sum (f := K) (fun i _ => hK0 i) (Finset.mem_range.mpr (by omega))
  have hjn : (j : ℝ) ≤ n := by exact_mod_cast hj
  have hpow : qC B.h ξ ^ (B.h * α - 2 * (j : ℝ) - 1) ≤ qC B.h ξ ^ (B.h * α - 2 * (n : ℝ) - 1) :=
    Real.rpow_le_rpow_of_exponent_ge q0 q1 (by linarith)
  calc ‖iteratedFDeriv ℝ j (a γ m) ξ‖ ≤ K j * qC B.h ξ ^ (B.h * α - 2 * (j : ℝ) - 1) :=
        hext j γ m ξ hξ
    _ ≤ C * qC B.h ξ ^ (B.h * α - 2 * (n : ℝ) - 1) :=
        mul_le_mul hKC hpow (Real.rpow_nonneg q0.le _) (le_trans (hK0 j) hKC)

theorem wv5_frame_bounds : ∀ (B : BG) (l0 : ℕ) (e : ℝ), B.ok → ContDiffOn ℝ ∞ (wv5Frame B e) {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} ∧ ∀ k : ℕ, ∃ C K : ℝ, ∀ z ∈ {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)}, ‖iteratedFDeriv ℝ k (wv5Frame B e) z‖ ≤ C * simScale B.h (z.1 2) (1 - z.2) ^ (-K) :=
by
  intro B l0 e hok
  obtain ⟨-, hWo, -, -, sTh, sQ, hcb⟩ := ipb5_mean_coord_bounds B l0 e hok
  set W : Set (ℝ³ × ℝ) := {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧
    B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧
    rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} with hWdef
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hq : ∀ z ∈ W, 0 < simScale B.h (z.1 2) (1 - z.2) ∧ simScale B.h (z.1 2) (1 - z.2) ≤ 1 := by
    intro z hz
    have h1 : z.2 < 1 ∧ simScale B.h (z.1 2) (1 - z.2) < qsOf l0 := hz.1
    exact ⟨(hok.1.1 (z.1 2) (1 - z.2) (by linarith [h1.1])).1, le_trans h1.2.le hqs1⟩
  have key2 : ∀ (C a b q : ℝ), 0 < q → q ≤ 1 → b ≤ a → C * q ^ a ≤ |C| * q ^ b := by
    intro C a b q hq0 hq1 hba
    calc C * q ^ a ≤ |C| * q ^ a :=
          mul_le_mul_of_nonneg_right (le_abs_self C) (Real.rpow_nonneg hq0.le _)
      _ ≤ |C| * q ^ b :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hq0 hq1 hba) (abs_nonneg C)
  have hmle : ∀ k : ℕ, ((k : ℕ) : WithTop ℕ∞) ≤ ∞ := fun k => by exact_mod_cast le_top

  obtain ⟨J, hJ⟩ : ∃ J : ℝ³ →L[ℝ] ℝ³, ∀ v : ℝ³,
      J v = v 1 • EuclideanSpace.single (0 : Fin 3) (1 : ℝ) - v 0 • EuclideanSpace.single (1 : Fin 3) (1 : ℝ) :=
    ⟨(EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ).smulRight (EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) -
      (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).smulRight (EuclideanSpace.single (1 : Fin 3) (1 : ℝ)),
      fun v => rfl⟩
  have hrot : ∀ x : ℝ³, J (eTh x) = eR x := by
    intro x
    rw [hJ]
    ext i
    fin_cases i <;> simp [eR, eTh, radVec, azVec] <;> ring
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ³ →L[ℝ] ((Fin 3 → ℝ) →L[ℝ] ℝ³), ∀ (v : ℝ³) (c : Fin 3 → ℝ),
      Φ v c = c 0 • J v + c 1 • v :=
    ⟨(ContinuousLinearMap.smulRightL ℝ (Fin 3 → ℝ) ℝ³
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℝ) 0)).comp J +
      ContinuousLinearMap.smulRightL ℝ (Fin 3 → ℝ) ℝ³
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℝ) 1), fun v c => rfl⟩
  obtain ⟨Lz, hLz⟩ : ∃ Lz : ℝ →L[ℝ] ((Fin 3 → ℝ) →L[ℝ] ℝ³), ∀ (r : ℝ) (c : Fin 3 → ℝ),
      Lz r c = r • (c 2 • eZ) :=
    ⟨(ContinuousLinearMap.id ℝ ℝ).smulRight
        ((ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℝ) 2).smulRight eZ), fun r c => rfl⟩
  obtain ⟨Bil, hBil⟩ : ∃ Bil : ℝ →L[ℝ] ((Fin 3 → ℝ) →L[ℝ] ℝ³) →L[ℝ] ((Fin 3 → ℝ) →L[ℝ] ℝ³),
      ∀ (r : ℝ) (M : (Fin 3 → ℝ) →L[ℝ] ℝ³), Bil r M = r • M :=
    ⟨ContinuousLinearMap.lsmul ℝ ℝ, fun r M => rfl⟩

  have hF : wv5Frame B e = fun z => Bil (simScale B.h (z.1 2) (1 - z.2) ^ e) (Φ (eTh z.1)) +
      Lz (simScale B.h (z.1 2) (1 - z.2) ^ e) := by
    funext z
    ext c : 1
    simp only [wv5Frame, ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.proj_apply, hBil, hΦ, hLz, hrot]
    simp only [smul_add]

  have sG : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => Φ (eTh z.1)) W := Φ.contDiff.comp_contDiffOn sTh
  have hgb : ∀ k : ℕ, ∃ C K : ℝ, ∀ z ∈ W,
      ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => Φ (eTh z.1)) z‖ ≤
        C * simScale B.h (z.1 2) (1 - z.2) ^ (-K) := by
    intro k
    obtain ⟨C, K, hC⟩ := hcb k
    refine ⟨‖Φ‖ * C, K, fun z hz => ?_⟩
    have h1 : ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => Φ (eTh z.1)) z‖ ≤
        ‖Φ‖ * ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => eTh z.1) z‖ :=
      Φ.norm_iteratedFDeriv_comp_left (sTh.contDiffAt (hWo.mem_nhds hz)) (hmle k)
    calc ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => Φ (eTh z.1)) z‖
        ≤ ‖Φ‖ * ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => eTh z.1) z‖ := h1
      _ ≤ ‖Φ‖ * (C * simScale B.h (z.1 2) (1 - z.2) ^ (-K)) :=
          mul_le_mul_of_nonneg_left (hC z hz).2.1 (ContinuousLinearMap.opNorm_nonneg Φ)
      _ = ‖Φ‖ * C * simScale B.h (z.1 2) (1 - z.2) ^ (-K) := by ring

  have hAB := wt_bilinear_bound Bil (fun z : ℝ³ × ℝ => simScale B.h (z.1 2) (1 - z.2) ^ e)
    (fun z : ℝ³ × ℝ => Φ (eTh z.1)) (fun z : ℝ³ × ℝ => simScale B.h (z.1 2) (1 - z.2)) W W hWo
    subset_rfl hq sQ sG
    (fun k => by
      obtain ⟨C, K, hC⟩ := hcb k
      exact ⟨C, K, fun z hz => (hC z hz).2.2⟩) hgb
  have sA : ContDiffOn ℝ ∞
      (fun z : ℝ³ × ℝ => Bil (simScale B.h (z.1 2) (1 - z.2) ^ e) (Φ (eTh z.1))) W := hAB.1
  have hAb : ∀ k : ℕ, ∃ C K : ℝ, ∀ z ∈ W,
      ‖iteratedFDeriv ℝ k
        (fun z : ℝ³ × ℝ => Bil (simScale B.h (z.1 2) (1 - z.2) ^ e) (Φ (eTh z.1))) z‖ ≤
        C * simScale B.h (z.1 2) (1 - z.2) ^ (-K) := hAB.2

  have sB : ContDiffOn ℝ ∞ (fun z : ℝ³ × ℝ => Lz (simScale B.h (z.1 2) (1 - z.2) ^ e)) W :=
    Lz.contDiff.comp_contDiffOn sQ
  have hBb : ∀ k : ℕ, ∃ C K : ℝ, ∀ z ∈ W,
      ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => Lz (simScale B.h (z.1 2) (1 - z.2) ^ e)) z‖ ≤
        C * simScale B.h (z.1 2) (1 - z.2) ^ (-K) := by
    intro k
    obtain ⟨C, K, hC⟩ := hcb k
    refine ⟨‖Lz‖ * C, K, fun z hz => ?_⟩
    have h1 : ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => Lz (simScale B.h (z.1 2) (1 - z.2) ^ e)) z‖ ≤
        ‖Lz‖ * ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => simScale B.h (z.1 2) (1 - z.2) ^ e) z‖ :=
      Lz.norm_iteratedFDeriv_comp_left (sQ.contDiffAt (hWo.mem_nhds hz)) (hmle k)
    calc ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => Lz (simScale B.h (z.1 2) (1 - z.2) ^ e)) z‖
        ≤ ‖Lz‖ * ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => simScale B.h (z.1 2) (1 - z.2) ^ e) z‖ := h1
      _ ≤ ‖Lz‖ * (C * simScale B.h (z.1 2) (1 - z.2) ^ (-K)) :=
          mul_le_mul_of_nonneg_left (hC z hz).2.2 (ContinuousLinearMap.opNorm_nonneg Lz)
      _ = ‖Lz‖ * C * simScale B.h (z.1 2) (1 - z.2) ^ (-K) := by ring

  rw [hF]
  refine ⟨sA.add sB, fun k => ?_⟩
  obtain ⟨C1, K1, hC1⟩ := hAb k
  obtain ⟨C2, K2, hC2⟩ := hBb k
  refine ⟨|C1| + |C2|, max K1 K2, fun z hz => ?_⟩
  obtain ⟨q0, q1⟩ := hq z hz
  have hnh : W ∈ nhds z := hWo.mem_nhds hz
  have hsum : iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => Bil (simScale B.h (z.1 2) (1 - z.2) ^ e) (Φ (eTh z.1)) +
        Lz (simScale B.h (z.1 2) (1 - z.2) ^ e)) z =
      iteratedFDeriv ℝ k
        (fun z : ℝ³ × ℝ => Bil (simScale B.h (z.1 2) (1 - z.2) ^ e) (Φ (eTh z.1))) z +
      iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => Lz (simScale B.h (z.1 2) (1 - z.2) ^ e)) z :=
    iteratedFDeriv_add_apply ((sA.contDiffAt hnh).of_le (hmle k)) ((sB.contDiffAt hnh).of_le (hmle k))
  rw [hsum]
  have f1 := le_trans (hC1 z hz) (key2 C1 _ _ _ q0 q1 (show -max K1 K2 ≤ -K1 by linarith [le_max_left K1 K2]))
  have f2 := le_trans (hC2 z hz) (key2 C2 _ _ _ q0 q1 (show -max K1 K2 ≤ -K2 by linarith [le_max_right K1 K2]))
  calc _ ≤ ‖iteratedFDeriv ℝ k
        (fun z : ℝ³ × ℝ => Bil (simScale B.h (z.1 2) (1 - z.2) ^ e) (Φ (eTh z.1))) z‖ +
      ‖iteratedFDeriv ℝ k (fun z : ℝ³ × ℝ => Lz (simScale B.h (z.1 2) (1 - z.2) ^ e)) z‖ :=
        norm_add_le _ _
    _ ≤ |C1| * simScale B.h (z.1 2) (1 - z.2) ^ (-max K1 K2) +
        |C2| * simScale B.h (z.1 2) (1 - z.2) ^ (-max K1 K2) := add_le_add f1 f2
    _ = (|C1| + |C2|) * simScale B.h (z.1 2) (1 - z.2) ^ (-max K1 K2) := by ring

theorem wv5_suppW_closure_window : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (l0 : ℕ) (γ : Lab) (ξ : Cyl), ξ ∈ DomC B.h (qsOf l0) → ξ ∈ closure {η : Cyl | η ∈ DomC B.h (qsOf l0) ∧ SuppW B G γ η} → (∃ η : Cyl, η ∈ DomC B.h (qsOf l0) ∧ SuppW B G γ η) ∧ l0 ≤ γ.1 ∧ |Real.logb 2 (qC B.h ξ) + (γ.1 : ℝ)| ≤ 1 ∧ 1/4 < qC B.h ξ / Qb γ.1 ∧ qC B.h ξ / Qb γ.1 < 4 ∧ B.Xa ≤ XC B.h ξ ∧ XC B.h ξ ≤ B.Xb ∧ |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 ∧ |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 :=
by
  intro B G hok hG l0 γ ξ hξ hcl
  have hU : IsOpen ({ζ : Cyl | 0 < ζ.1} ∩ {ζ : Cyl | ζ.2.2.1 < 1}) :=
    (isOpen_lt continuous_const (by fun_prop)).inter (isOpen_lt (by fun_prop) continuous_const)
  have hcont : ContinuousOn (qC B.h) ({ζ : Cyl | 0 < ζ.1} ∩ {ζ : Cyl | ζ.2.2.1 < 1}) := by
    have h4' : ContinuousOn (fun w : ℝ × ℝ => simScale B.h w.1 w.2) (univ ×ˢ Ioi 0) :=
      hok.1.2.2.2.1.continuousOn
    have hφ : Continuous (fun ζ : Cyl => ((ζ.2.1, 1 - ζ.2.2.1) : ℝ × ℝ)) := by fun_prop
    have hmaps : Set.MapsTo (fun ζ : Cyl => ((ζ.2.1, 1 - ζ.2.2.1) : ℝ × ℝ))
        ({ζ : Cyl | 0 < ζ.1} ∩ {ζ : Cyl | ζ.2.2.1 < 1}) (univ ×ˢ Ioi 0) := by
      intro ζ hζ
      have h' : ζ.2.2.1 < 1 := hζ.2
      exact ⟨mem_univ _, show (0:ℝ) < 1 - ζ.2.2.1 by linarith⟩
    exact h4'.comp hφ.continuousOn hmaps
  have hDopen : IsOpen (DomC B.h (qsOf l0)) := by
    have h3' := hcont.isOpen_inter_preimage hU (isOpen_Iio (a := qsOf l0))
    have e : DomC B.h (qsOf l0) =
        ({ζ : Cyl | 0 < ζ.1} ∩ {ζ : Cyl | ζ.2.2.1 < 1}) ∩ qC B.h ⁻¹' Iio (qsOf l0) := by
      ext ζ
      constructor
      · rintro ⟨e1, e2, e3⟩
        exact ⟨⟨e1, e2⟩, e3⟩
      · rintro ⟨⟨e1, e2⟩, e3⟩
        exact ⟨e1, e2, e3⟩
    rw [e]
    exact h3'
  have hqpos : ∀ η ∈ DomC B.h (qsOf l0), 0 < qC B.h η := by
    intro η hη
    have hη' : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC B.h η < qsOf l0 := hη
    exact (hok.1.1 η.2.1 (1 - η.2.2.1) (by linarith [hη'.2.1])).1
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  have hqcont : ContinuousAt (qC B.h) ξ := hcont.continuousAt (hU.mem_nhds ⟨hξ'.1, hξ'.2.1⟩)
  have hXCc : ContinuousAt (XC B.h) ξ := by
    have h1 : ContinuousAt (fun η : Cyl => η.1 ^ 2) ξ := (continuous_fst.pow 2).continuousAt
    have h2 : ContinuousAt (fun η : Cyl => 2 * qC B.h η) ξ := continuousAt_const.mul hqcont
    have h3 : 2 * qC B.h ξ ≠ 0 := by have := hqpos ξ hξ; positivity
    exact h1.div h2 h3

  have lim : ∀ {Y : Type} [TopologicalSpace Y] (g : Cyl → Y) (S' : Set Cyl) (T : Set Y),
      ContinuousAt g ξ → ξ ∈ closure S' → IsClosed T → (∀ η ∈ S', g η ∈ T) → g ξ ∈ T := by
    intro Y _ g S' T hg hcl' hT hmap
    have := hg.continuousWithinAt.mem_closure hcl' hmap
    rwa [hT.closure_eq] at this
  set S : Set Cyl := {η : Cyl | η ∈ DomC B.h (qsOf l0) ∧ SuppW B G γ η} with hSdef
  have hSS : ∀ η ∈ S, SuppW B G γ η := fun η hη => hη.2
  obtain ⟨η0, hη0⟩ := Set.Nonempty.of_closure ⟨ξ, hcl⟩
  have hne : ∃ η : Cyl, η ∈ DomC B.h (qsOf l0) ∧ SuppW B G γ η := ⟨η0, hη0.1, hη0.2⟩

  have htsE : ξ ∈ tsupport (etaL B.h γ) :=
    closure_minimal (fun η hη => (hSS η hη).2.1) (isClosed_tsupport _) hcl

  have hXa' : B.Xa ≤ XC B.h ξ :=
    lim (XC B.h) _ (Set.Ici B.Xa) hXCc hcl isClosed_Ici (fun η hη => (hSS η hη).2.2.2.2.1)
  have hXb' : XC B.h ξ ≤ B.Xb :=
    lim (XC B.h) _ (Set.Iic B.Xb) hXCc hcl isClosed_Iic (fun η hη => (hSS η hη).2.2.2.2.2)

  have hr0 : 0 < G.r0 := hG.1.1
  have hr1 : G.r0 ≤ 1/100 := hG.1.2.1
  have hbgc0 : 0 ≤ bgc := by
    unfold bgc; nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
  have hbgc1 : bgc ≤ 1 := by
    unfold bgc; nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
  have hinv : ∀ v : ℝ × ℝ, v.1 = lamR v + bgc * lamT v ∧ v.2 = -bgc * lamR v + lamT v := by
    intro v
    have hd : (1 + bgc ^ 2) ≠ 0 := by positivity
    unfold lamR lamT
    constructor
    · field_simp; ring
    · field_simp; ring
  have hsmall : ∀ v : ℝ × ℝ, |lamR v| ≤ G.r0 / 4 → |lamT v| ≤ G.r0 →
      |v.1| ≤ 1/80 ∧ |v.2| ≤ 1/80 := by
    intro v h1 h2
    obtain ⟨e1, e2⟩ := hinv v
    rw [abs_le] at h1 h2
    have p1 : bgc * lamT v ≤ bgc * G.r0 := mul_le_mul_of_nonneg_left h2.2 hbgc0
    have p2 : bgc * (-G.r0) ≤ bgc * lamT v := mul_le_mul_of_nonneg_left h2.1 hbgc0
    have p3 : bgc * lamR v ≤ bgc * (G.r0/4) := mul_le_mul_of_nonneg_left h1.2 hbgc0
    have p4 : bgc * (-(G.r0/4)) ≤ bgc * lamR v := mul_le_mul_of_nonneg_left h1.1 hbgc0
    have p5 : bgc * G.r0 ≤ G.r0 := by nlinarith [mul_nonneg (sub_nonneg.mpr hbgc1) hr0.le]
    have p6 : bgc * (G.r0/4) ≤ G.r0/4 := by nlinarith [mul_nonneg (sub_nonneg.mpr hbgc1) hr0.le]
    constructor
    · rw [abs_le]; constructor <;> nlinarith
    · rw [abs_le]; constructor <;> nlinarith
  have R : ∀ (x : ℝ) (j : ℤ), |x - j| < 1/2 → round x = j := by
    intro x j hx
    rw [round_eq, Int.floor_eq_iff]
    rw [abs_lt] at hx
    constructor <;> linarith
  obtain ⟨w, hw⟩ : ∃ w : Cyl → ℝ × ℝ, w = fun η => Jpow (bandIdx B.h γ.1) η.2.2.2 - G.ctr γ :=
    ⟨_, rfl⟩
  have hwc : Continuous w := by rw [hw]; unfold Jpow; fun_prop
  have hxiw : ∀ η : Cyl, xiG B.h γ (G.ctr γ) η.2.2.2 = lamR (frac0 (w η)) := by
    intro η; rw [hw]; rfl
  have hetw : ∀ η : Cyl, etG B.h γ (G.ctr γ) η.2.2.2 = lamT (frac0 (w η)) := by
    intro η; rw [hw]; rfl
  have hNo : IsOpen {η : Cyl | |(w η).1 - (w ξ).1| < 1/4 ∧ |(w η).2 - (w ξ).2| < 1/4} := by
    have h1 : IsOpen {η : Cyl | |(w η).1 - (w ξ).1| < 1/4} :=
      isOpen_lt (by fun_prop) continuous_const
    have h2 : IsOpen {η : Cyl | |(w η).2 - (w ξ).2| < 1/4} :=
      isOpen_lt (by fun_prop) continuous_const
    exact h1.inter h2
  have hξN : ξ ∈ closure ({η : Cyl | |(w η).1 - (w ξ).1| < 1/4 ∧ |(w η).2 - (w ξ).2| < 1/4} ∩ S) :=
    hNo.inter_closure ⟨by simp, hcl⟩
  have hfreeze : ∀ η ∈ {η : Cyl | |(w η).1 - (w ξ).1| < 1/4 ∧ |(w η).2 - (w ξ).2| < 1/4} ∩ S,
      frac0 (w η) = ((w η).1 - ((round (w ξ).1 : ℤ) : ℝ), (w η).2 - ((round (w ξ).2 : ℤ) : ℝ)) := by
    rintro η ⟨⟨hN1, hN2⟩, hηS⟩
    have hs := hSS η hηS
    have h1 := hs.2.2.1
    have h2 := hs.2.2.2.1
    rw [hxiw] at h1
    rw [hetw] at h2
    obtain ⟨b1, b2⟩ := hsmall _ h1 h2
    have b1' : |(w η).1 - ((round (w η).1 : ℤ) : ℝ)| ≤ 1/80 := b1
    have b2' : |(w η).2 - ((round (w η).2 : ℤ) : ℝ)| ≤ 1/80 := b2
    have r1 : round (w ξ).1 = round (w η).1 := by
      apply R
      rw [abs_lt] at hN1 ⊢
      rw [abs_le] at b1'
      constructor <;> linarith [hN1.1, hN1.2, b1'.1, b1'.2]
    have r2 : round (w ξ).2 = round (w η).2 := by
      apply R
      rw [abs_lt] at hN2 ⊢
      rw [abs_le] at b2'
      constructor <;> linarith [hN2.1, hN2.2, b2'.1, b2'.2]
    unfold frac0
    rw [r1, r2]
  have hu : frac0 (w ξ) =
      ((w ξ).1 - ((round (w ξ).1 : ℤ) : ℝ), (w ξ).2 - ((round (w ξ).2 : ℤ) : ℝ)) := rfl
  have hxi : |xiG B.h γ (G.ctr γ) ξ.2.2.2| ≤ G.r0 / 4 := by
    rw [hxiw, hu]
    refine lim (fun η => |lamR ((w η).1 - ((round (w ξ).1 : ℤ) : ℝ),
      (w η).2 - ((round (w ξ).2 : ℤ) : ℝ))|) _ (Set.Iic (G.r0/4)) ?_ hξN isClosed_Iic ?_
    · apply Continuous.continuousAt; unfold lamR; fun_prop
    · intro η hη
      simp only [Set.mem_Iic]
      rw [← hfreeze η hη]
      have := (hSS η hη.2).2.2.1
      rw [hxiw] at this
      exact this
  have het : |etG B.h γ (G.ctr γ) ξ.2.2.2| ≤ G.r0 := by
    rw [hetw, hu]
    refine lim (fun η => |lamT ((w η).1 - ((round (w ξ).1 : ℤ) : ℝ),
      (w η).2 - ((round (w ξ).2 : ℤ) : ℝ))|) _ (Set.Iic G.r0) ?_ hξN isClosed_Iic ?_
    · apply Continuous.continuousAt; unfold lamT; fun_prop
    · intro η hη
      simp only [Set.mem_Iic]
      rw [← hfreeze η hη]
      have := (hSS η hη.2).2.2.2.1
      rw [hetw] at this
      exact this

  have hq1 : ∀ l : ℕ, (2:ℝ) ^ (1 - (l:ℝ)) = 2 * Qb l := by
    intro l
    rw [sub_eq_add_neg, Real.rpow_add two_pos, Real.rpow_one]; rfl
  have hq2 : ∀ l : ℕ, (2:ℝ) ^ (-1 - (l:ℝ)) = Qb l / 2 := by
    intro l
    rw [sub_eq_add_neg, Real.rpow_add two_pos, Real.rpow_neg_one]; unfold Qb; ring
  have band_pt : ∀ η ∈ DomC B.h (qsOf l0), etaL B.h γ η ≠ 0 →
      Qb γ.1 / 2 < qC B.h η ∧ qC B.h η < 2 * Qb γ.1 := by
    intro η hη hne
    have hq := hqpos η hη
    have h1 : sqPart 1 (-(γ.1:ℤ)) (Real.logb 2 (qC B.h η)) ≠ 0 := left_ne_zero_of_mul hne
    unfold sqPart at h1
    have h2 := (div_ne_zero_iff.mp h1).1
    unfold bumpR at h2
    have h3 : 0 < 1 - (Real.logb 2 (qC B.h η) / 1 - ((-(γ.1:ℤ) : ℤ) : ℝ)) ^ 2 := by
      by_contra hcon
      exact h2 (Real.smoothTransition.zero_of_nonpos (not_lt.mp hcon))
    have h4 : (Real.logb 2 (qC B.h η) / 1 - ((-(γ.1:ℤ) : ℤ) : ℝ)) =
        Real.logb 2 (qC B.h η) + (γ.1 : ℝ) := by
      push_cast; ring
    rw [h4] at h3
    have h5 : |Real.logb 2 (qC B.h η) + (γ.1 : ℝ)| < 1 :=
      (sq_lt_one_iff_abs_lt_one _).mp (by linarith)
    rw [abs_lt] at h5
    have e1 : Real.logb 2 (qC B.h η) < 1 - (γ.1:ℝ) := by linarith
    have e2 : -1 - (γ.1:ℝ) < Real.logb 2 (qC B.h η) := by linarith
    rw [Real.logb_lt_iff_lt_rpow one_lt_two hq, hq1] at e1
    rw [Real.lt_logb_iff_rpow_lt one_lt_two hq, hq2] at e2
    exact ⟨e2, e1⟩
  have hξE : ξ ∈ closure (DomC B.h (qsOf l0) ∩ Function.support (etaL B.h γ)) :=
    hDopen.inter_closure ⟨hξ, htsE⟩
  have hband : qC B.h ξ ∈ Set.Icc (Qb γ.1 / 2) (2 * Qb γ.1) :=
    lim (qC B.h) _ _ hqcont hξE isClosed_Icc
      (fun η hη => ⟨(band_pt η hη.1 hη.2).1.le, (band_pt η hη.1 hη.2).2.le⟩)
  have hQpos : 0 < Qb γ.1 := Real.rpow_pos_of_pos two_pos _
  have hq0 : 0 < qC B.h ξ := hqpos ξ hξ
  have hl : l0 ≤ γ.1 := by
    have h1 : (2:ℝ) ^ (-1 - (γ.1:ℝ)) < (2:ℝ) ^ (-(l0:ℝ)) := by
      calc (2:ℝ) ^ (-1 - (γ.1:ℝ)) = Qb γ.1 / 2 := hq2 _
        _ ≤ qC B.h ξ := hband.1
        _ < qsOf l0 := hξ'.2.2
        _ = (2:ℝ) ^ (-(l0:ℝ)) := rfl
    rw [Real.rpow_lt_rpow_left_iff one_lt_two] at h1
    have h2 : (l0:ℝ) < (γ.1:ℝ) + 1 := by linarith
    have h3 : l0 < γ.1 + 1 := by exact_mod_cast h2
    omega
  have hlog : |Real.logb 2 (qC B.h ξ) + (γ.1 : ℝ)| ≤ 1 := by
    have e1 : Real.logb 2 (qC B.h ξ) ≤ 1 - (γ.1:ℝ) := by
      rw [Real.logb_le_iff_le_rpow one_lt_two hq0, hq1]; exact hband.2
    have e2 : -1 - (γ.1:ℝ) ≤ Real.logb 2 (qC B.h ξ) := by
      rw [Real.le_logb_iff_rpow_le one_lt_two hq0, hq2]; exact hband.1
    rw [abs_le]; constructor <;> linarith
  refine ⟨hne, hl, hlog, ?_, ?_, hXa', hXb', ?_, ?_⟩
  · rw [lt_div_iff₀ hQpos]; linarith [hband.1]
  · rw [div_lt_iff₀ hQpos]; linarith [hband.2]
  · linarith
  · linarith

theorem wv5_activeL4_of_suppW : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (γ : Lab) (η : Cyl), η ∈ DomC B.h (qsOf l0) → SuppW B G γ η → ActiveL4 B G γ :=
by
  have key : ∀ (h Xa Xb qB : ℝ), SimScaleProps h → 0 < h → h < 1/100 → 0 < Xa → 0 < qB →
      ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (γ : Lab) (η : Cyl), η ∈ DomC h (qsOf l0) →
        η ∈ tsupport (etaL h γ) → Xa ≤ XC h η → ∀ ξ' : Cyl, etaL h γ ξ' ≠ 0 → Xa ≤ XC h ξ' →
        XC h ξ' ≤ Xb → ∃ ξ ∈ DomC h qB, etaL h γ ξ ≠ 0 ∧ Xa ≤ XC h ξ ∧ XC h ξ ≤ Xb := by
    intro h Xa Xb qB hSim hh0 hh1 hXa hqB

    have hbump : ∀ x : ℝ, bumpR x ≠ 0 ↔ |x| < 1 := by
      intro x
      unfold bumpR
      constructor
      · intro hx
        by_contra hc
        push_neg at hc
        apply hx
        apply Real.smoothTransition.zero_of_nonpos
        have : 1 ≤ x ^ 2 := by rw [← sq_abs]; nlinarith
        linarith
      · intro hx
        apply ne_of_gt
        apply Real.smoothTransition.pos_of_pos
        have := (sq_lt_one_iff_abs_lt_one x).mpr hx
        linarith
    have hsq : ∀ (μ : ℝ) (j : ℤ) (s : ℝ), sqPart μ j s ≠ 0 ↔ |s / μ - j| < 1 := by
      intro μ j s
      unfold sqPart
      constructor
      · intro hx
        by_contra hc
        apply hx
        have h0 : bumpR (s / μ - j) = 0 := by
          by_contra h'
          exact hc ((hbump _).mp h')
        rw [h0, zero_div]
      · intro hx
        have hb := (hbump _).mpr hx
        apply div_ne_zero hb
        rw [Real.sqrt_ne_zero']
        have hsum : Summable (fun n : ℤ => bumpR (s / μ - n) ^ 2) := by
          apply summable_of_ne_finset_zero (s := Finset.Icc (⌊s / μ⌋ - 1) (⌊s / μ⌋ + 1))
          intro n hn
          by_contra hne
          apply hn
          have hb' : bumpR (s / μ - n) ≠ 0 := fun h0 => hne (by rw [h0]; norm_num)
          have habs := (hbump _).mp hb'
          rw [abs_lt] at habs
          have f1 := Int.floor_le (s / μ)
          have f2 := Int.lt_floor_add_one (s / μ)
          have g1 : (n : ℝ) < ((⌊s / μ⌋ + 2 : ℤ) : ℝ) := by push_cast; linarith
          have g2 : ((⌊s / μ⌋ - 1 : ℤ) : ℝ) < n := by push_cast; linarith
          have g1' : n < ⌊s / μ⌋ + 2 := by exact_mod_cast g1
          have g2' : ⌊s / μ⌋ - 1 < n := by exact_mod_cast g2
          rw [Finset.mem_Icc]
          constructor <;> omega
        calc (0:ℝ) < bumpR (s / μ - j) ^ 2 := lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 hb))
          _ ≤ ∑' n : ℤ, bumpR (s / μ - n) ^ 2 := hsum.le_tsum j (fun _ _ => sq_nonneg _)
    have heta : ∀ (γ : Lab) (ξ : Cyl), etaL h γ ξ ≠ 0 ↔ (|Real.logb 2 (qC h ξ) + (γ.1 : ℝ)| < 1 ∧
        |chartR h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1 : ℝ)| < 1 ∧
        |chartZ h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.1 : ℝ)| < 1 ∧
        |chartT h γ.1 ξ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2 : ℝ)| < 1) := by
      intro γ ξ
      unfold etaL
      have e : Real.logb 2 (qC h ξ) / 1 - (((-(γ.1:ℤ)) : ℤ) : ℝ) = Real.logb 2 (qC h ξ) + (γ.1 : ℝ) := by
        push_cast; ring
      rw [mul_ne_zero_iff, mul_ne_zero_iff, mul_ne_zero_iff, hsq, hsq, hsq, hsq, e]
      tauto

    have hneg : ∀ z τ : ℝ, τ < 0 → simScale h z τ = 0 := by
      intro z τ hτ
      apply le_antisymm _ (Real.sInf_nonneg (fun x hx => hx.1.le))
      by_contra hs
      push_neg at hs
      have hc : Filter.Tendsto (fun p : ℝ => z ^ 2 * p ^ (2 * h)) (nhds 0) (nhds (z ^ 2 * (0:ℝ) ^ (2 * h))) :=
        (continuousAt_const.mul (Real.continuousAt_rpow_const 0 (2 * h) (Or.inr (by linarith)))).tendsto
      rw [Real.zero_rpow (by positivity), mul_zero] at hc
      have e1 : ∀ᶠ p in nhdsWithin (0:ℝ) (Ioi 0), z ^ 2 * p ^ (2 * h) < -τ :=
        (hc.eventually (gt_mem_nhds (by linarith))).filter_mono nhdsWithin_le_nhds
      have e2 : ∀ᶠ p in nhdsWithin (0:ℝ) (Ioi 0), p < simScale h z τ :=
        (gt_mem_nhds hs).filter_mono nhdsWithin_le_nhds
      have e3 : ∀ᶠ p in nhdsWithin (0:ℝ) (Ioi 0), 0 < p := self_mem_nhdsWithin
      obtain ⟨p, hp1, hp2, hp3⟩ := (e1.and (e2.and e3)).exists
      have : simScale h z τ ≤ p := csInf_le ⟨0, fun x hx => hx.1.le⟩ ⟨hp3, by linarith⟩
      linarith
    have hcont : ∀ z : ℝ, Filter.Tendsto (fun δ : ℝ => simScale h z δ) (nhdsWithin 0 (Ioi 0))
        (nhds (simScale h z 0)) := by
      intro z
      have hbdd : BddBelow {q : ℝ | 0 < q ∧ (0:ℝ) ≤ q - z ^ 2 * q ^ (2 * h)} := ⟨0, fun x hx => hx.1.le⟩
      have h12 : 0 < 1 - 2 * h := by linarith
      have hlow : ∀ δ : ℝ, 0 < δ → simScale h z 0 ≤ simScale h z δ := by
        intro δ hδ
        obtain ⟨hp, he⟩ := hSim.1 z δ hδ
        exact csInf_le hbdd ⟨hp, by linarith⟩
      have hup : ∀ δ : ℝ, 0 < δ → simScale h z δ ≤ simScale h z 0 + δ / (1 - 2 * h) := by
        intro δ hδ
        obtain ⟨hp, he⟩ := hSim.1 z δ hδ
        have hne : ({q : ℝ | 0 < q ∧ (0:ℝ) ≤ q - z ^ 2 * q ^ (2 * h)}).Nonempty :=
          ⟨simScale h z δ, hp, by linarith⟩
        have key : simScale h z δ - δ / (1 - 2 * h) ≤ simScale h z 0 := by
          apply le_csInf hne
          rintro p ⟨hp0, hp1⟩
          have hp2h : 0 < p ^ (2 * h) := Real.rpow_pos_of_pos hp0 _
          have hsplit : p ^ (1 - 2 * h) * p ^ (2 * h) = p := by
            rw [← Real.rpow_add hp0]; simp
          have hz : z ^ 2 ≤ p ^ (1 - 2 * h) := by
            by_contra hc
            push_neg at hc
            have := mul_lt_mul_of_pos_right hc hp2h
            linarith
          have hqd : 0 ≤ simScale h z δ ^ (2 * h) := Real.rpow_nonneg hp.le _
          have m1 : z ^ 2 * simScale h z δ ^ (2 * h) ≤ p ^ (1 - 2 * h) * simScale h z δ ^ (2 * h) :=
            mul_le_mul_of_nonneg_right hz hqd
          have m2 := Real.geom_mean_le_arith_mean2_weighted (w₁ := 1 - 2 * h) (w₂ := 2 * h)
            (p₁ := p) (p₂ := simScale h z δ) (by linarith) (by linarith) hp0.le hp.le (by ring)
          have m3 : (simScale h z δ - p) * (1 - 2 * h) ≤ δ := by nlinarith
          have m4 : simScale h z δ - p ≤ δ / (1 - 2 * h) := by rw [le_div_iff₀ h12]; exact m3
          linarith
        linarith
      have hu : Filter.Tendsto (fun δ : ℝ => simScale h z 0 + δ / (1 - 2 * h)) (nhdsWithin 0 (Ioi 0))
          (nhds (simScale h z 0)) := by
        have : Filter.Tendsto (fun δ : ℝ => simScale h z 0 + δ / (1 - 2 * h)) (nhds 0)
            (nhds (simScale h z 0 + 0 / (1 - 2 * h))) :=
          (continuous_const.add (continuous_id.div_const _)).tendsto 0
        rw [zero_div, add_zero] at this
        exact this.mono_left nhdsWithin_le_nhds
      exact tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hu
        (Filter.eventually_of_mem self_mem_nhdsWithin (fun δ hδ => hlow δ hδ))
        (Filter.eventually_of_mem self_mem_nhdsWithin (fun δ hδ => hup δ hδ))

    obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one (show 0 < qB / 2 by linarith)
      (show (1/2:ℝ) < 1 by norm_num)
    refine ⟨n0 + ⌈4 / Xa⌉₊ + 1, fun l0 hl0 γ η hηD hts hXaη ξ' hne' hXa' hXb' => ?_⟩
    have hQ : ∀ n : ℕ, Qb n = (1/2:ℝ) ^ n := by
      intro n
      show (2:ℝ) ^ (-(n:ℝ)) = _
      rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
    have hQpos : ∀ n : ℕ, 0 < Qb n := fun n => by rw [hQ n]; positivity
    have h2 : (1:ℝ) < 2 := one_lt_two
    have hηD' : 0 < η.1 ∧ η.2.2.1 < 1 ∧ qC h η < qsOf l0 := hηD
    obtain ⟨hrη, htη, hqηs⟩ := hηD'
    have hqη : 0 < qC h η := (hSim.1 η.2.1 (1 - η.2.2.1) (by linarith)).1
    have hqCc : ContinuousAt (qC h) η := by
      have c1 : ContinuousAt (fun w : ℝ × ℝ => simScale h w.1 w.2) (η.2.1, 1 - η.2.2.1) :=
        hSim.2.2.2.1.continuousOn.continuousAt
          ((isOpen_univ.prod isOpen_Ioi).mem_nhds ⟨mem_univ _, sub_pos.mpr htη⟩)
      have c2 : ContinuousAt (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ)) η := by fun_prop
      show ContinuousAt ((fun w : ℝ × ℝ => simScale h w.1 w.2) ∘
        (fun ξ : Cyl => ((ξ.2.1, 1 - ξ.2.2.1) : ℝ × ℝ))) η
      exact ContinuousAt.comp (g := fun w : ℝ × ℝ => simScale h w.1 w.2) c1 c2
    have hclosed : ∀ f : Cyl → ℝ, ContinuousAt f η → (∀ ζ, etaL h γ ζ ≠ 0 → f ζ < 1) → f η ≤ 1 := by
      intro f hf hlt
      by_contra hc
      push_neg at hc
      have hev : ∀ᶠ ζ in nhds η, 1 < f ζ := Filter.Tendsto.eventually hf (lt_mem_nhds hc)
      obtain ⟨ζ, hζ1, hζ2⟩ := mem_closure_iff_nhds.mp hts _ hev
      exact absurd (hlt ζ hζ2) (not_lt.mpr (le_of_lt hζ1))
    have hb1 : |Real.logb 2 (qC h η) + (γ.1 : ℝ)| ≤ 1 := by
      apply hclosed (fun ζ => |Real.logb 2 (qC h ζ) + (γ.1 : ℝ)|)
      · exact (((Real.continuousAt_logb (b := 2) hqη.ne').comp hqCc).add continuousAt_const).abs
      · intro ζ hζ; exact ((heta γ ζ).mp hζ).1
    have hb2 : |chartR h γ.1 η / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1 : ℝ)| ≤ 1 := by
      apply hclosed (fun ζ => |chartR h γ.1 ζ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1 : ℝ)|)
      · have : Continuous (fun ζ : Cyl => |chartR h γ.1 ζ / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1 : ℝ)|) := by
          unfold chartR; fun_prop
        exact this.continuousAt
      · intro ζ hζ; exact ((heta γ ζ).mp hζ).2.1
    rw [abs_le] at hb1
    have hlow : (2:ℝ) ^ (-(γ.1:ℝ) - 1) ≤ qC h η :=
      (Real.le_logb_iff_rpow_le h2 hqη).mp (by linarith [hb1.1])
    have hQhalf : (2:ℝ) ^ (-(γ.1:ℝ) - 1) = Qb γ.1 / 2 := by
      rw [Real.rpow_sub two_pos, Real.rpow_one]; rfl
    have hll : l0 ≤ γ.1 := by
      have h3 : (2:ℝ) ^ (-(γ.1:ℝ) - 1) < (2:ℝ) ^ (-(l0:ℝ)) := lt_of_le_of_lt hlow hqηs
      rw [Real.rpow_lt_rpow_left_iff h2] at h3
      have h4 : (l0:ℝ) < γ.1 + 1 := by linarith
      have h5 : l0 < γ.1 + 1 := by exact_mod_cast h4
      omega
    rw [hQhalf] at hlow
    have hl1R : (1:ℝ) ≤ γ.1 := by exact_mod_cast (show 1 ≤ γ.1 by omega)
    have hlXa : 4 < Xa * γ.1 := by
      have hc := Nat.le_ceil (4 / Xa)
      have h6 : ((⌈4 / Xa⌉₊ : ℕ) : ℝ) + 1 ≤ γ.1 := by
        exact_mod_cast (show ⌈4 / Xa⌉₊ + 1 ≤ γ.1 by omega)
      have h7 : 4 / Xa < γ.1 := by linarith
      rw [div_lt_iff₀ hXa] at h7
      linarith
    have h2Q : 2 * Qb γ.1 < qB := by
      rw [hQ]
      have : (1/2:ℝ) ^ γ.1 ≤ (1/2) ^ n0 := pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
      linarith

    have hμ : Sb γ.1 ^ (-3:ℤ) = (((γ.1:ℝ) ^ 2) ^ 3)⁻¹ := by
      unfold Sb; rw [zpow_neg]; norm_num
    obtain ⟨L, hL⟩ : ∃ L : ℝ, L = ((γ.1:ℝ) ^ 2) ^ 3 := ⟨_, rfl⟩
    have hLl : (γ.1:ℝ) ≤ L := by
      have a : (γ.1:ℝ) ≤ (γ.1:ℝ) ^ 2 := by nlinarith
      have b : (γ.1:ℝ) ^ 2 ≤ ((γ.1:ℝ) ^ 2) ^ 3 := le_self_pow₀ (by nlinarith) (by norm_num)
      rw [hL]; linarith
    have hLpos : 0 < L := by linarith
    have hdivμ : ∀ x : ℝ, x / Sb γ.1 ^ (-3:ℤ) = x * L := by
      intro x; rw [hμ, div_inv_eq_mul, hL]

    have hXη : 2 * qC h η * Xa ≤ η.1 ^ 2 := by
      have h8 : Xa ≤ η.1 ^ 2 / (2 * qC h η) := hXaη
      rw [le_div_iff₀ (by positivity)] at h8
      linarith
    have hsQ : 0 < Real.sqrt (Qb γ.1) := Real.sqrt_pos.mpr (hQpos _)
    have hcpos : 0 < chartR h γ.1 η := div_pos hrη hsQ
    have hc2 : Xa ≤ (chartR h γ.1 η) ^ 2 := by
      unfold chartR
      rw [div_pow, Real.sq_sqrt (hQpos _).le, le_div_iff₀ (hQpos _)]
      nlinarith [mul_le_mul_of_nonneg_right hlow hXa.le]
    have hcL : 2 < chartR h γ.1 η * L := by
      have hsq4 : 4 < (chartR h γ.1 η * L) ^ 2 := by
        have i1 : Xa * L ^ 2 ≤ (chartR h γ.1 η) ^ 2 * L ^ 2 :=
          mul_le_mul_of_nonneg_right hc2 (by positivity)
        have i2 : Xa * γ.1 ≤ Xa * L ^ 2 := by
          apply mul_le_mul_of_nonneg_left _ hXa.le
          nlinarith
        nlinarith
      nlinarith [mul_pos hcpos hLpos]
    rw [abs_le, hdivμ] at hb2
    have ha1 : (1:ℝ) < γ.2.1.1 := by linarith [hb2.1, hb2.2]

    obtain ⟨c1, c2, c3, c4⟩ := (heta γ ξ').mp hne'
    have c2' := c2
    rw [abs_lt, hdivμ] at c2'
    have hcR' : 0 < chartR h γ.1 ξ' := by
      by_contra hc
      push_neg at hc
      have hm := mul_le_mul_of_nonneg_right hc hLpos.le
      rw [zero_mul] at hm
      linarith [c2'.1]
    have hr' : 0 < ξ'.1 := by
      have h9 : 0 < ξ'.1 / Real.sqrt (Qb γ.1) := hcR'
      exact (div_pos_iff_of_pos_right hsQ).mp h9
    have hq'0 : 0 ≤ qC h ξ' := by
      unfold qC simScale; exact Real.sInf_nonneg (fun x hx => hx.1.le)
    have hq'ne : qC h ξ' ≠ 0 := by
      intro h0
      have c1z := c1
      rw [h0, Real.logb_zero, zero_add, abs_lt] at c1z
      linarith [c1z.2]
    have hq'pos : 0 < qC h ξ' := lt_of_le_of_ne hq'0 (Ne.symm hq'ne)
    have hq'B : qC h ξ' < qB := by
      have c1z := c1
      rw [abs_lt] at c1z
      have h10 : Real.logb 2 (qC h ξ') < 1 - γ.1 := by linarith [c1z.2]
      rw [Real.logb_lt_iff_lt_rpow h2 hq'pos] at h10
      have e : (2:ℝ) ^ ((1:ℝ) - γ.1) = 2 * Qb γ.1 := by
        rw [show (1:ℝ) - γ.1 = -(γ.1:ℝ) + 1 by ring, Real.rpow_add two_pos, Real.rpow_one]
        unfold Qb; ring
      linarith

    rcases lt_trichotomy ξ'.2.2.1 1 with ht | ht | ht
    · have hD : ξ' ∈ DomC h qB := show 0 < ξ'.1 ∧ ξ'.2.2.1 < 1 ∧ qC h ξ' < qB from ⟨hr', ht, hq'B⟩
      exact ⟨ξ', hD, hne', hXa', hXb'⟩
    · obtain ⟨r', z', t', Y'⟩ := ξ'
      change t' = 1 at ht
      subst ht
      have hq0 : qC h (r', z', 1, Y') = simScale h z' 0 := by
        show simScale h z' (1 - 1) = _
        rw [sub_self]
      have hq0pos : 0 < simScale h z' 0 := by rw [← hq0]; exact hq'pos
      have hq0B : simScale h z' 0 < qB := by rw [← hq0]; exact hq'B
      have hc1 : |Real.logb 2 (simScale h z' 0) + (γ.1:ℝ)| < 1 := by rw [← hq0]; exact c1
      obtain ⟨X', hX'⟩ : ∃ X' : ℝ, X' = XC h (r', z', 1, Y') := ⟨_, rfl⟩
      rw [← hX'] at hXa' hXb'
      have hX'pos : 0 < X' := lt_of_lt_of_le hXa hXa'
      have hrq : Real.sqrt (2 * simScale h z' 0 * X') = r' := by
        have h11 : 2 * simScale h z' 0 * X' = r' ^ 2 := by
          rw [hX']
          unfold XC
          rw [hq0]
          field_simp
        rw [h11, Real.sqrt_sq hr'.le]
      have T := hcont z'
      have E1 : ∀ᶠ δ in nhdsWithin (0:ℝ) (Ioi 0), 0 < δ := self_mem_nhdsWithin
      have E2 : ∀ᶠ δ in nhdsWithin (0:ℝ) (Ioi 0), simScale h z' δ < qB := T.eventually (gt_mem_nhds hq0B)
      have E3 : ∀ᶠ δ in nhdsWithin (0:ℝ) (Ioi 0), |Real.logb 2 (simScale h z' δ) + (γ.1:ℝ)| < 1 := by
        have hg : ContinuousAt (fun q : ℝ => |Real.logb 2 q + (γ.1:ℝ)|) (simScale h z' 0) :=
          ((Real.continuousAt_logb (b := 2) hq0pos.ne').add continuousAt_const).abs
        exact (hg.tendsto.comp T).eventually (gt_mem_nhds hc1)
      have E4 : ∀ᶠ δ in nhdsWithin (0:ℝ) (Ioi 0),
          |Real.sqrt (2 * simScale h z' δ * X') / Real.sqrt (Qb γ.1) / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1:ℝ)| < 1 := by
        have hg : Continuous (fun q : ℝ =>
            |Real.sqrt (2 * q * X') / Real.sqrt (Qb γ.1) / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.1:ℝ)|) := by fun_prop
        have hv : |Real.sqrt (2 * simScale h z' 0 * X') / Real.sqrt (Qb γ.1) / Sb γ.1 ^ (-3:ℤ) -
            (γ.2.1.1:ℝ)| < 1 := by
          rw [hrq]; exact c2
        exact ((hg.tendsto _).comp T).eventually (gt_mem_nhds hv)
      have E5 : ∀ᶠ δ in nhdsWithin (0:ℝ) (Ioi 0),
          |(1 - (1 - δ)) / Qb γ.1 / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2:ℝ)| < 1 := by
        have hg : Continuous (fun δ : ℝ =>
            |(1 - (1 - δ)) / Qb γ.1 / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2:ℝ)|) := by fun_prop
        have hv : |(1 - (1 - (0:ℝ))) / Qb γ.1 / Sb γ.1 ^ (-3:ℤ) - (γ.2.1.2.2:ℝ)| < 1 := by
          have h12 : (1 - (1 - (0:ℝ))) = 1 - 1 := by ring
          rw [h12]; exact c4
        exact ((hg.tendsto 0).mono_left nhdsWithin_le_nhds).eventually (gt_mem_nhds hv)
      obtain ⟨δ, hδ, hδB, hδ3, hδ4, hδ5⟩ := (E1.and (E2.and (E3.and (E4.and E5)))).exists
      have hqd : qC h (Real.sqrt (2 * simScale h z' δ * X'), z', 1 - δ, Y') = simScale h z' δ := by
        show simScale h z' (1 - (1 - δ)) = _
        rw [sub_sub_cancel]
      have hqdpos : 0 < simScale h z' δ := (hSim.1 z' δ hδ).1
      have hprod : 0 < 2 * simScale h z' δ * X' := mul_pos (mul_pos two_pos hqdpos) hX'pos
      have hXd : XC h (Real.sqrt (2 * simScale h z' δ * X'), z', 1 - δ, Y') = X' := by
        unfold XC
        rw [hqd]
        show Real.sqrt (2 * simScale h z' δ * X') ^ 2 / (2 * simScale h z' δ) = X'
        rw [Real.sq_sqrt hprod.le]
        have := hqdpos.ne'
        field_simp
      have hD : (Real.sqrt (2 * simScale h z' δ * X'), z', 1 - δ, Y') ∈ DomC h qB :=
        show 0 < Real.sqrt (2 * simScale h z' δ * X') ∧ 1 - δ < 1 ∧
            qC h (Real.sqrt (2 * simScale h z' δ * X'), z', 1 - δ, Y') < qB from
          ⟨Real.sqrt_pos.mpr hprod, by linarith, by rw [hqd]; exact hδB⟩
      refine ⟨_, hD, ?_, by rw [hXd]; exact hXa', by rw [hXd]; exact hXb'⟩
      rw [heta]
      exact ⟨by rw [hqd]; exact hδ3, hδ4, c3, hδ5⟩
    · exfalso
      exact hq'ne (hneg ξ'.2.1 (1 - ξ'.2.2.1) (by linarith))
  intro B G hok hG
  obtain ⟨hSim, hBP⟩ := hok
  obtain ⟨⟨hh0, hh1, hXa, -, -, -, -, hqB, -⟩, -⟩ := hBP
  obtain ⟨l1, hl1⟩ := key B.h B.Xa B.Xb B.qB hSim hh0 hh1 hXa hqB
  refine ⟨l1, fun l0 hl0 γ η hηD hS => ?_⟩
  obtain ⟨⟨hlmin, ξ', hne', hXa', hXb'⟩, hts, -, -, hXaη, -⟩ := hS
  obtain ⟨ξ, hξD, hne, hx1, hx2⟩ := hl1 l0 hl0 γ η hηD hts hXaη ξ' hne' hXa' hXb'
  exact ⟨hlmin, ξ, hξD, hne, hx1, hx2⟩

theorem wv5_phiL5_window_jet : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C M : ℝ, 0 ≤ M ∧ ∀ (l0 : ℕ) (γ : Lab) (ξ : Cyl), l1 ≤ l0 → ActiveL4 B G γ → l0 ≤ γ.1 → ξ ∈ DomC B.h (qsOf l0) → 1/4 < qC B.h ξ / Qb γ.1 → qC B.h ξ / Qb γ.1 < 4 → B.Xa / 2 < XC B.h ξ → XC B.h ξ < 2 * B.Xb → |xiG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → |etG B.h γ (G.ctr γ) ξ.2.2.2| < 1/8 → (∃ U : Set Cyl, IsOpen U ∧ ξ ∈ U ∧ ContDiffOn ℝ ∞ (phiL5 B G γ) U) ∧ (1 ≤ k → (kb B.h γ.1 : ℝ) * ‖iteratedFDeriv ℝ k (phiL5 B G γ) ξ‖ ≤ C * qC B.h ξ ^ (-M)) :=
by
  intro B G hok hG
  obtain ⟨hh0, hh1, -, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨hr0, hr01, hu, -, -⟩ := hG.1
  obtain ⟨C0, hC0, hconv⟩ := nbg5_plain_le_nb B.h hh0 hh1
  obtain ⟨lr, cr, Cr, -, hR⟩ := rep_consts_v5 B G hok hG
  obtain ⟨lv, Cv, hV⟩ := vco_nb_v5 B hok
  obtain ⟨lcp, hCP⟩ := chart_profile_nb_v5 B hok
  choose Ccp hCcp using hCP
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  obtain ⟨hDo, -, -, -, -, -⟩ := domc_open_calculus B B.qB hok
  obtain ⟨-, hBsm⟩ := geom_slow_base_smooth_v5 B hok
  have hQb : ∀ l : ℕ, Qb l = (1/2:ℝ) ^ l := fun l => by
    show (2:ℝ) ^ (-(l:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  refine ⟨lr + lv + lcp + n0, fun k => ?_⟩
  obtain ⟨E, hE⟩ : ∃ E : ℝ, E = ∑ j ∈ Finset.range (k + 1), |Ccp j| := ⟨_, rfl⟩
  have hCE : ∀ j, j ≤ k → |Ccp j| ≤ E := by
    intro j hj
    rw [hE]
    exact Finset.single_le_sum (f := fun j => |Ccp j|) (fun i _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  obtain ⟨C4, hC4def⟩ : ∃ C4 : ℝ, C4 = 2 ^ k * Cv * (2 * |Cr| * E) := ⟨_, rfl⟩
  refine ⟨10 * |Cr| * (2 + G.ustar) + 80 * C0 ^ k * |C4|, ((3 * k + 3 : ℕ) : ℝ), Nat.cast_nonneg _, ?_⟩
  intro l0 γ ξ hl0 hAct hl0γ hξ hb1 hb2 hX1 hX2 hxi het8
  have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
  have hq0 : 0 < qC B.h ξ := (hok.1.1 ξ.2.1 (1 - ξ.2.2.1) (by linarith [hξ'.2.1])).1
  have hqs : qsOf l0 = (1/2:ℝ) ^ l0 := hQb l0
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hqs]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le
  have hq1 : qC B.h ξ < 1 :=
    lt_of_lt_of_le hξ'.2.2 (by rw [hqs]; exact pow_le_one₀ (by norm_num) (by norm_num))
  have hξB : ξ ∈ DomC B.h B.qB := ⟨hξ'.1, hξ'.2.1, lt_of_lt_of_le hξ'.2.2 hqsB⟩
  have hQ0 : 0 < Qb γ.1 := by rw [hQb]; positivity
  have hQ1 : Qb γ.1 ≤ 1 := by rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  obtain ⟨⟨U, hUo, hξU, hφU⟩, hVc⟩ := phiL5_local_form_v5 B G γ ξ hok hξB hxi het8
  refine ⟨⟨U, hUo, hξU, hφU⟩, fun hk => ?_⟩

  have hRc := hR γ hAct (by omega)
  have hpa : |pang5 B G γ| ≤ |Cr| := hRc.2.2.1.trans (le_abs_self _)
  have hpz : |pzr5 B G γ| ≤ |Cr| := hRc.2.1.trans (le_abs_self _)
  have hBs : |Bs5 B G γ| ≤ Cr := hRc.2.2.2

  have hVb : ∀ i, NB B.h (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2) i ξ ≤ Cv * (γ.1 : ℝ) ^ 2 :=
    fun i => hV γ G.r0 (G.ctr γ) l0 hr0.le hr01 (by omega) hl0γ ξ hξ hb1 hb2 hxi het8 i
  set Ω : Set (ℝ × ℝ × ℝ) := {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}
    with hΩ
  have hB2 : ContDiffOn ℝ ∞ (pcB5 B γ.1 2) Ω := hBsm γ.1 2
  have hB1 : ContDiffOn ℝ ∞ (pcB5 B γ.1 1) Ω := hBsm γ.1 1
  have hRC : ContDiffOn ℝ ∞ (pcRC5 γ.1) Ω := by
    have : ContDiff ℝ ∞ (pcRC5 γ.1) := by unfold pcRC5; fun_prop
    exact this.contDiffOn
  have hFa : ContDiffOn ℝ ∞ (pcFa5 B γ.1) Ω := by
    have := hB1.div hRC (fun s hs => by
      unfold pcRC5
      exact div_ne_zero (ne_of_gt hs.1) (Real.sqrt_pos.mpr hQ0).ne')
    exact this
  have hmaps : Set.MapsTo (fun η : Cyl => ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ)) (DomC B.h B.qB) Ω := by
    intro η hη
    simp only [hΩ, Set.mem_setOf_eq]
    exact ⟨hη.1, hη.2.1, hη.2.2⟩
  have hπ : ContDiff ℝ ∞ (fun η : Cyl => ((η.1, η.2.1, η.2.2.1) : ℝ × ℝ × ℝ)) := by fun_prop
  have eFa : Fang B γ.1 = fun η : Cyl => pcFa5 B γ.1 (η.1, η.2.1, η.2.2.1) := rfl
  have eB2 : (fun η : Cyl => baseC B γ.1 η 2) = fun η : Cyl => pcB5 B γ.1 2 (η.1, η.2.1, η.2.2.1) := rfl
  have hFaD : ContDiffOn ℝ ∞ (Fang B γ.1) (DomC B.h B.qB) := by
    rw [eFa]; exact hFa.comp hπ.contDiffOn hmaps
  have hB2D : ContDiffOn ℝ ∞ (fun η : Cyl => baseC B γ.1 η 2) (DomC B.h B.qB) := by
    rw [eB2]; exact hB2.comp hπ.contDiffOn hmaps
  have hPD : ContDiffOn ℝ ∞ (fun η : Cyl => pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2)
      (DomC B.h B.qB) := (contDiffOn_const.mul hFaD).add (contDiffOn_const.mul hB2D)
  have hPc := hPD.contDiffAt (hDo.mem_nhds hξB)
  have hPb : ∀ i, i ≤ k →
      NB B.h (fun η : Cyl => pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2) i ξ ≤
        2 * |Cr| * E := by
    intro i hi
    have hlin := (nb_real_algebra_v5 B.h (DomC B.h B.qB) ξ hDo hξB (Fang B γ.1)
      (fun η : Cyl => baseC B γ.1 η 2) hFaD hB2D i).2.1 (pang5 B G γ) (pzr5 B G γ)
    refine hlin.trans ?_
    obtain ⟨a1, a2⟩ := hCcp i γ.1 l0 (by omega) hl0γ ξ hξ hb1 hb2 hX1 hX2
    have hc := hCE i hi
    have f1 : NB B.h (Fang B γ.1) i ξ ≤ E := by
      rw [eFa]; exact a1.trans ((le_abs_self _).trans hc)
    have f2 : NB B.h (fun η : Cyl => baseC B γ.1 η 2) i ξ ≤ E := by
      rw [eB2]; exact a2.trans ((le_abs_self _).trans hc)
    have m1 : |pang5 B G γ| * NB B.h (Fang B γ.1) i ξ ≤ |Cr| * E :=
      mul_le_mul hpa f1 (norm_nonneg _) (abs_nonneg _)
    have m2 : |pzr5 B G γ| * NB B.h (fun η : Cyl => baseC B γ.1 η 2) i ξ ≤ |Cr| * E :=
      mul_le_mul hpz f2 (norm_nonneg _) (abs_nonneg _)
    linarith
  have hprod := nb_real_mul_le_v5 B.h ξ (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2)
    (fun η : Cyl => pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2) k
    (Cv * (γ.1 : ℝ) ^ 2) (2 * |Cr| * E) hVc hPc (fun i _ => hVb i) hPb
  have hVP : NB B.h (fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2 *
      (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2)) k ξ ≤ C4 * (γ.1 : ℝ) ^ 2 := by
    refine hprod.trans (le_of_eq ?_)
    rw [hC4def]
    ring

  obtain ⟨x, hxdef⟩ : ∃ x : ℝ, x = (qC B.h ξ)⁻¹ := ⟨_, rfl⟩
  have hx0 : 0 < x := by rw [hxdef]; exact inv_pos.2 hq0
  have hx1 : 1 ≤ x := by rw [hxdef]; exact (one_le_inv₀ hq0).2 hq1.le
  have hQinv : (Qb γ.1)⁻¹ < 4 * x := by
    have e : (qC B.h ξ)⁻¹ * (qC B.h ξ / Qb γ.1) = (Qb γ.1)⁻¹ := by
      rw [div_eq_mul_inv, ← mul_assoc, inv_mul_cancel₀ hq0.ne', one_mul]
    rw [← e, hxdef]
    have := mul_lt_mul_of_pos_left hb2 (inv_pos.2 hq0)
    linarith
  have hkb : (kb B.h γ.1 : ℝ) ≤ 5 * x := by
    have hep : 0 ≤ epsb B.h γ.1 := Real.rpow_nonneg hQ0.le _
    have hE' : epsb B.h γ.1 ^ (-(1/2:ℝ)) ≤ (Qb γ.1)⁻¹ := by
      rw [epsb, ← Real.rpow_mul hQ0.le, ← Real.rpow_neg_one]
      exact Real.rpow_le_rpow_of_exponent_ge hQ0 hQ1 (by linarith)
    have hc := Nat.ceil_lt_add_one (Real.rpow_nonneg hep (-(1/2:ℝ)))
    unfold kb
    linarith
  have hℓ : (γ.1 : ℝ) ^ 2 ≤ 16 * x ^ 2 := by
    have h1 : (γ.1 : ℝ) < 2 ^ γ.1 := by exact_mod_cast (Nat.lt_two_pow_self : γ.1 < 2 ^ γ.1)
    have h2 : (2:ℝ) ^ γ.1 = (Qb γ.1)⁻¹ := by rw [hQb, one_div, inv_pow, inv_inv]
    have h3 : (γ.1 : ℝ) ≤ 4 * x := by linarith
    have h0 : (0:ℝ) ≤ γ.1 := Nat.cast_nonneg _
    calc (γ.1 : ℝ) ^ 2 = (γ.1 : ℝ) * γ.1 := sq _
      _ ≤ (4 * x) * (4 * x) := mul_le_mul h3 h3 h0 (by linarith)
      _ = 16 * x ^ 2 := by ring

  obtain ⟨A1, hA1⟩ : ∃ A1 : ℝ, A1 = pzr5 B G γ * (Qb γ.1 ^ (1/2 - B.h) * epsb B.h γ.1)⁻¹ := ⟨_, rfl⟩
  obtain ⟨A2, hA2⟩ : ∃ A2 : ℝ, A2 = (sgn γ.2.2 * Bs5 B G γ * G.ustar / 2) * (Real.sqrt (Qb γ.1))⁻¹ :=
    ⟨_, rfl⟩
  obtain ⟨Lc, hLc⟩ : ∃ Lc : Cyl →L[ℝ] ℝ, ∀ v : Cyl, Lc v = A1 * v.2.1 + A2 * v.1 :=
    ⟨A1 • ((ContinuousLinearMap.fst ℝ ℝ (ℝ × (ℝ × ℝ))).comp
        (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)))) +
      A2 • ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ × (ℝ × ℝ)), fun v => by simp⟩
  obtain ⟨Wf, hWf⟩ : ∃ Wf : Cyl → ℝ, Wf = fun η => Lc η - phiL5 B G γ η := ⟨_, rfl⟩
  have hWeq : Wf = fun η : Cyl => vco B.h G.r0 γ (G.ctr γ) η.2.2.2 *
      (pang5 B G γ * Fang B γ.1 η + pzr5 B G γ * baseC B γ.1 η 2) := by
    rw [hWf]
    funext η
    rw [hLc]
    simp only [phiL5, chartZ, RC, hA1, hA2]
    ring
  have hsplit : phiL5 B G γ = ⇑Lc - Wf := by
    funext η
    rw [hWf]
    simp only [Pi.sub_apply]
    ring
  have hφc : ContDiffAt ℝ ∞ (phiL5 B G γ) ξ := hφU.contDiffAt (hUo.mem_nhds hξU)
  have hLcc : ContDiffAt ℝ ∞ (⇑Lc) ξ := Lc.contDiff.contDiffAt
  have hWc : ContDiffAt ℝ ∞ Wf ξ := by rw [hWf]; exact hLcc.sub hφc
  have hDk : ‖iteratedFDeriv ℝ k (phiL5 B G γ) ξ‖ ≤
      ‖iteratedFDeriv ℝ k (⇑Lc) ξ‖ + ‖iteratedFDeriv ℝ k Wf ξ‖ := by
    rw [hsplit, iteratedFDeriv_sub_apply (hLcc.of_le (by exact_mod_cast le_top))
      (hWc.of_le (by exact_mod_cast le_top))]
    exact norm_sub_le _ _

  have hDL : ‖iteratedFDeriv ℝ k (⇑Lc) ξ‖ ≤ ‖Lc‖ := by
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    rw [← norm_iteratedFDeriv_fderiv]
    have hfd : fderiv ℝ (⇑Lc) = fun _ => Lc := funext (fun y => Lc.fderiv)
    rw [hfd]
    rcases Nat.eq_zero_or_pos j with hj | hj
    · subst hj
      rw [norm_iteratedFDeriv_zero]
    · rw [iteratedFDeriv_const_of_ne (by omega) Lc]
      simp
  have hLcn : ‖Lc‖ ≤ ‖A1‖ + ‖A2‖ := by
    refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun v => ?_)
    rw [hLc]
    have h1 : ‖v.2.1‖ ≤ ‖v‖ := (norm_fst_le v.2).trans (norm_snd_le v)
    have h2 : ‖v.1‖ ≤ ‖v‖ := norm_fst_le v
    calc ‖A1 * v.2.1 + A2 * v.1‖ ≤ ‖A1 * v.2.1‖ + ‖A2 * v.1‖ := norm_add_le _ _
      _ = ‖A1‖ * ‖v.2.1‖ + ‖A2‖ * ‖v.1‖ := by rw [norm_mul, norm_mul]
      _ ≤ ‖A1‖ * ‖v‖ + ‖A2‖ * ‖v‖ :=
          add_le_add (mul_le_mul_of_nonneg_left h1 (norm_nonneg _))
            (mul_le_mul_of_nonneg_left h2 (norm_nonneg _))
      _ = (‖A1‖ + ‖A2‖) * ‖v‖ := by ring
  have hD1 : Qb γ.1 ^ (1/2 - B.h) * epsb B.h γ.1 = Qb γ.1 ^ (1/2:ℝ) := by
    rw [epsb, ← Real.rpow_add hQ0]
    congr 1
    ring
  have hQhalf : Qb γ.1 ≤ Qb γ.1 ^ (1/2:ℝ) := by
    have := Real.rpow_le_rpow_of_exponent_ge hQ0 hQ1 (by norm_num : (1/2:ℝ) ≤ 1)
    rwa [Real.rpow_one] at this
  have hD1pos : 0 < Qb γ.1 ^ (1/2 - B.h) * epsb B.h γ.1 := by
    rw [hD1]; exact Real.rpow_pos_of_pos hQ0 _
  have hD1inv : (Qb γ.1 ^ (1/2 - B.h) * epsb B.h γ.1)⁻¹ ≤ (Qb γ.1)⁻¹ := by
    rw [hD1]; exact inv_anti₀ hQ0 hQhalf
  have hsq : Qb γ.1 ≤ Real.sqrt (Qb γ.1) := by
    rw [Real.le_sqrt hQ0.le hQ0.le, sq]
    exact mul_le_of_le_one_left hQ0.le hQ1
  have hsqinv : (Real.sqrt (Qb γ.1))⁻¹ ≤ (Qb γ.1)⁻¹ := inv_anti₀ hQ0 hsq
  have hA1b : ‖A1‖ ≤ |Cr| * (4 * x) := by
    rw [hA1, norm_mul, Real.norm_of_nonneg (inv_nonneg.2 hD1pos.le), Real.norm_eq_abs]
    exact mul_le_mul hpz (hD1inv.trans hQinv.le)
      (inv_nonneg.2 hD1pos.le) (abs_nonneg _)
  have hsgn : |sgn γ.2.2| = 1 := by
    unfold sgn
    split_ifs <;> simp
  have hA2b : ‖A2‖ ≤ |Cr| * G.ustar / 2 * (4 * x) := by
    have e : |sgn γ.2.2 * Bs5 B G γ * G.ustar / 2| = |Bs5 B G γ| * G.ustar / 2 := by
      rw [abs_div, abs_mul, abs_mul, hsgn, one_mul, abs_of_pos hu, abs_two]
    have hB2' : |Bs5 B G γ| * G.ustar / 2 ≤ |Cr| * G.ustar / 2 :=
      div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_right (hBs.trans (le_abs_self _)) hu.le) (by norm_num)
    rw [hA2, norm_mul, Real.norm_of_nonneg (inv_nonneg.2 (Real.sqrt_nonneg _)), Real.norm_eq_abs, e]
    exact mul_le_mul hB2' (hsqinv.trans hQinv.le) (inv_nonneg.2 (Real.sqrt_nonneg _))
      (by have := abs_nonneg Cr; positivity)
  have hDLb : ‖iteratedFDeriv ℝ k (⇑Lc) ξ‖ ≤ 2 * |Cr| * (2 + G.ustar) * x := by
    have := hDL.trans (hLcn.trans (add_le_add hA1b hA2b))
    calc _ ≤ |Cr| * (4 * x) + |Cr| * G.ustar / 2 * (4 * x) := this
      _ = 2 * |Cr| * (2 + G.ustar) * x := by ring

  have hq3 : qC B.h ξ ^ (-3:ℝ) = x ^ 3 := by
    rw [show (-3:ℝ) = -((3:ℕ):ℝ) by norm_num, Real.rpow_neg hq0.le, Real.rpow_natCast, hxdef, inv_pow]
  have hNB : NB B.h Wf k ξ ≤ |C4| * (16 * x ^ 2) := by
    rw [hWeq]
    refine hVP.trans ?_
    exact (mul_le_mul_of_nonneg_right (le_abs_self _) (sq_nonneg _)).trans
      (mul_le_mul_of_nonneg_left hℓ (abs_nonneg _))
  have hDW : ‖iteratedFDeriv ℝ k Wf ξ‖ ≤ (C0 * x ^ 3) ^ k * (|C4| * (16 * x ^ 2)) := by
    have hc := hconv ξ hq0 hq1 Wf k
    rw [hq3] at hc
    exact hc.trans (mul_le_mul_of_nonneg_left hNB
      (pow_nonneg (mul_nonneg (by linarith) (pow_nonneg hx0.le 3)) k))

  have hnorm : ‖iteratedFDeriv ℝ k (phiL5 B G γ) ξ‖ ≤
      2 * |Cr| * (2 + G.ustar) * x + (C0 * x ^ 3) ^ k * (|C4| * (16 * x ^ 2)) :=
    hDk.trans (add_le_add hDLb hDW)
  have hx2 : x ^ 2 ≤ x ^ (3 * k + 3) := pow_le_pow_right₀ hx1 (by omega)
  have hL0 : 0 ≤ 10 * (|Cr| * (2 + G.ustar)) :=
    mul_nonneg (by norm_num) (mul_nonneg (abs_nonneg _) (by linarith))
  have hqM : qC B.h ξ ^ (-((3 * k + 3 : ℕ) : ℝ)) = x ^ (3 * k + 3) := by
    rw [Real.rpow_neg hq0.le, Real.rpow_natCast, hxdef, inv_pow]
  rw [hqM]
  calc (kb B.h γ.1 : ℝ) * ‖iteratedFDeriv ℝ k (phiL5 B G γ) ξ‖
      ≤ (5 * x) * (2 * |Cr| * (2 + G.ustar) * x + (C0 * x ^ 3) ^ k * (|C4| * (16 * x ^ 2))) :=
        mul_le_mul hkb hnorm (norm_nonneg _) (by linarith)
    _ = 10 * (|Cr| * (2 + G.ustar)) * x ^ 2 + 80 * C0 ^ k * |C4| * x ^ (3 * k + 3) := by
        rw [mul_pow, ← pow_mul]
        ring
    _ ≤ 10 * (|Cr| * (2 + G.ustar)) * x ^ (3 * k + 3) + 80 * C0 ^ k * |C4| * x ^ (3 * k + 3) :=
        add_le_add (mul_le_mul_of_nonneg_left hx2 hL0) le_rfl
    _ = (10 * |Cr| * (2 + G.ustar) + 80 * C0 ^ k * |C4|) * x ^ (3 * k + 3) := by ring

theorem wv5_angular_bound : ∀ (B : BG) (l0 : ℕ), B.ok → ∀ k : ℕ, ∃ C K : ℝ, 1 ≤ C ∧ 0 ≤ K ∧ ∀ N : ℤ, ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => Complex.exp (Complex.I * (N : ℂ) * (thetaOf w.1 : ℂ))) {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} ∧ ∀ z ∈ {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)}, ∀ j : ℕ, j ≤ k → ‖iteratedFDeriv ℝ j (fun w : ℝ³ × ℝ => Complex.exp (Complex.I * (N : ℂ) * (thetaOf w.1 : ℂ))) z‖ ≤ ((1 + |(N : ℝ)|) * (C * simScale B.h (z.1 2) (1 - z.2) ^ (-K))) ^ j :=
by
  intro B l0 hok k
  obtain ⟨-, hWo, -, -, sE, -, hcb⟩ := ipb5_mean_coord_bounds B l0 0 hok
  set W : Set (ℝ³ × ℝ) := {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧
    B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧
    rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} with hWdef

  have hgen : ∀ (Ω : Set (ℝ³ × ℝ)) (v : ℝ³ × ℝ → ℂ) (x : ℝ³ × ℝ) (kk : ℕ) (D : ℝ), IsOpen Ω →
      ContDiffOn ℝ ∞ v Ω → x ∈ Ω → 0 ≤ D → ‖v x‖ ≤ 1 →
      (∀ i : ℕ, 1 ≤ i → i ≤ kk → ‖iteratedFDeriv ℝ i v x‖ ≤ D ^ i) →
      ∀ n : ℕ, ∀ j : ℕ, j ≤ kk → ‖iteratedFDeriv ℝ j (fun y => v y ^ n) x‖ ≤ ((1 + (n : ℝ)) * D) ^ j := by
    intro Ω v x kk D hΩ hv hx hD hv1 hvb n
    induction n with
    | zero =>
      intro j hj
      simp only [pow_zero]
      rcases Nat.eq_zero_or_pos j with rfl | hj0
      · simp
      · rw [iteratedFDeriv_const_of_ne (by omega : j ≠ 0) (1:ℂ)]
        simp only [Pi.zero_apply, norm_zero]
        positivity
    | succ n ih =>
      intro j hj
      have hfun : (fun y => v y ^ (n+1)) = fun y => v y * v y ^ n := by funext y; ring
      rw [hfun]
      have h := norm_iteratedFDerivWithin_mul_le hv (hv.pow n) hΩ.uniqueDiffOn hx (n := j)
        (by exact_mod_cast le_top)
      rw [iteratedFDerivWithin_of_isOpen j hΩ hx] at h
      refine h.trans ?_
      have hvi : ∀ i, i ≤ kk → ‖iteratedFDeriv ℝ i v x‖ ≤ D ^ i := by
        intro i hi
        rcases Nat.eq_zero_or_pos i with rfl | hi0
        · simpa [norm_iteratedFDeriv_zero] using hv1
        · exact hvb i hi0 hi
      calc ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * ‖iteratedFDerivWithin ℝ i v Ω x‖ *
            ‖iteratedFDerivWithin ℝ (j - i) (fun y => v y ^ n) Ω x‖
          ≤ ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * D ^ i * ((1 + (n:ℝ)) * D) ^ (j - i) := by
            apply Finset.sum_le_sum
            intro i hi
            have hij : i ≤ j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
            rw [iteratedFDerivWithin_of_isOpen i hΩ hx, iteratedFDerivWithin_of_isOpen (j - i) hΩ hx]
            exact mul_le_mul (mul_le_mul_of_nonneg_left (hvi i (by omega)) (Nat.cast_nonneg _))
              (ih (j - i) (by omega)) (norm_nonneg _)
              (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hD _))
        _ = (D + (1 + (n:ℝ)) * D) ^ j := by
            rw [add_pow]
            apply Finset.sum_congr rfl
            intro i _
            ring
        _ = ((1 + ((n + 1 : ℕ) : ℝ)) * D) ^ j := by push_cast; ring

  obtain ⟨Lp, hLp⟩ : ∃ L : ℝ³ →L[ℝ] ℂ, ∀ v : ℝ³, L v = (v 1 : ℂ) - (v 0 : ℂ) * Complex.I :=
    ⟨(EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ).smulRight (1 : ℂ) +
      (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).smulRight (-Complex.I), fun v => by
        simp [Complex.real_smul]; ring⟩
  obtain ⟨Lm, hLm⟩ : ∃ L : ℝ³ →L[ℝ] ℂ, ∀ v : ℝ³, L v = (v 1 : ℂ) + (v 0 : ℂ) * Complex.I :=
    ⟨(EuclideanSpace.proj (1 : Fin 3) : ℝ³ →L[ℝ] ℝ).smulRight (1 : ℂ) +
      (EuclideanSpace.proj (0 : Fin 3) : ℝ³ →L[ℝ] ℝ).smulRight Complex.I, fun v => by
        simp [Complex.real_smul]⟩

  have hangle : ∀ x : ℝ³, 0 < rad x →
      Complex.exp ((thetaOf x : ℂ) * Complex.I) = Lp (eTh x) ∧
      Complex.exp (((-thetaOf x : ℝ) : ℂ) * Complex.I) = Lm (eTh x) := by
    intro x hr
    have hnorm : ‖(⟨x 0, x 1⟩ : ℂ)‖ = rad x := by
      rw [Complex.norm_def, Complex.normSq_mk]
      unfold rad
      congr 1
      ring
    have hζ0 : (⟨x 0, x 1⟩ : ℂ) ≠ 0 := by
      intro h
      rw [h, norm_zero] at hnorm
      linarith
    have h0 : eTh x 0 = -(x 1) / rad x := by
      simp [eTh, azVec]
      ring
    have h1 : eTh x 1 = x 0 / rad x := by
      simp [eTh, azVec]
      ring
    have hc : Real.cos (thetaOf x) = x 0 / rad x := by
      unfold thetaOf
      rw [Complex.cos_arg hζ0, hnorm]
    have hs : Real.sin (thetaOf x) = x 1 / rad x := by
      unfold thetaOf
      rw [Complex.sin_arg, hnorm]
    rw [hLp, hLm, h0, h1]
    constructor
    · rw [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, hc, hs]
      push_cast
      ring
    · rw [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_neg,
        Real.sin_neg, hc, hs]
      push_cast
      ring

  choose Cc Kc hcK using hcb
  obtain ⟨Kb, hKb⟩ : ∃ K : ℝ, K = ∑ i ∈ Finset.range (k + 1), |Kc i| := ⟨_, rfl⟩
  obtain ⟨Cb, hCb⟩ : ∃ C : ℝ, C = 1 + ∑ i ∈ Finset.range (k + 1), |Cc i| := ⟨_, rfl⟩
  have hKb0 : 0 ≤ Kb := by rw [hKb]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have hKle : ∀ i, i ≤ k → |Kc i| ≤ Kb := fun i hi => by
    rw [hKb]
    exact Finset.single_le_sum (f := fun i => |Kc i|) (fun i _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  have hCle : ∀ i, i ≤ k → |Cc i| ≤ Cb := fun i hi => by
    have : |Cc i| ≤ ∑ j ∈ Finset.range (k + 1), |Cc j| :=
      Finset.single_le_sum (f := fun j => |Cc j|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.mpr (by omega))
    rw [hCb]; linarith
  have hCb1 : 1 ≤ Cb := by
    have : 0 ≤ ∑ j ∈ Finset.range (k + 1), |Cc j| := Finset.sum_nonneg (fun j _ => abs_nonneg _)
    rw [hCb]; linarith
  have hnLp := norm_nonneg Lp
  have hnLm := norm_nonneg Lm
  have hC1 : 1 ≤ (1 + ‖Lp‖ + ‖Lm‖) * Cb :=
    one_le_mul_of_one_le_of_one_le (by linarith) hCb1
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hq : ∀ z ∈ W, 0 < simScale B.h (z.1 2) (1 - z.2) ∧ simScale B.h (z.1 2) (1 - z.2) ≤ 1 := by
    intro z hz
    have h1 : z.2 < 1 ∧ simScale B.h (z.1 2) (1 - z.2) < qsOf l0 := hz.1
    exact ⟨(hok.1.1 (z.1 2) (1 - z.2) (by linarith [h1.1])).1, le_trans h1.2.le hqs1⟩
  have hvsm : ∀ L : ℝ³ →L[ℝ] ℂ, ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => L (eTh w.1)) W :=
    fun L => L.contDiff.comp_contDiffOn sE
  have hvb : ∀ L : ℝ³ →L[ℝ] ℂ, ‖L‖ ≤ 1 + ‖Lp‖ + ‖Lm‖ → ∀ z ∈ W, ∀ i : ℕ, i ≤ k →
      ‖iteratedFDeriv ℝ i (fun w : ℝ³ × ℝ => L (eTh w.1)) z‖ ≤
        (1 + ‖Lp‖ + ‖Lm‖) * Cb * simScale B.h (z.1 2) (1 - z.2) ^ (-Kb) := by
    intro L hL z hz i hi
    obtain ⟨q0, q1⟩ := hq z hz
    have hca : ContDiffAt ℝ ∞ (fun w : ℝ³ × ℝ => eTh w.1) z := sE.contDiffAt (hWo.mem_nhds hz)
    have h1 : ‖iteratedFDeriv ℝ i (fun w : ℝ³ × ℝ => L (eTh w.1)) z‖ ≤
        ‖L‖ * ‖iteratedFDeriv ℝ i (fun w : ℝ³ × ℝ => eTh w.1) z‖ :=
      L.norm_iteratedFDeriv_comp_left hca (by exact_mod_cast le_top)
    have e1 := (hcK i z hz).2.1
    have hKi : -Kb ≤ -Kc i := by linarith [le_abs_self (Kc i), hKle i hi]
    have e2 : simScale B.h (z.1 2) (1 - z.2) ^ (-Kc i) ≤ simScale B.h (z.1 2) (1 - z.2) ^ (-Kb) :=
      Real.rpow_le_rpow_of_exponent_ge q0 q1 hKi
    have hp : 0 ≤ simScale B.h (z.1 2) (1 - z.2) ^ (-Kc i) := Real.rpow_nonneg q0.le _
    have hp' : 0 ≤ simScale B.h (z.1 2) (1 - z.2) ^ (-Kb) := Real.rpow_nonneg q0.le _
    have e3 : ‖iteratedFDeriv ℝ i (fun w : ℝ³ × ℝ => eTh w.1) z‖ ≤
        Cb * simScale B.h (z.1 2) (1 - z.2) ^ (-Kb) :=
      calc _ ≤ Cc i * simScale B.h (z.1 2) (1 - z.2) ^ (-Kc i) := e1
        _ ≤ |Cc i| * simScale B.h (z.1 2) (1 - z.2) ^ (-Kc i) :=
            mul_le_mul_of_nonneg_right (le_abs_self _) hp
        _ ≤ Cb * simScale B.h (z.1 2) (1 - z.2) ^ (-Kb) :=
            mul_le_mul (hCle i hi) e2 hp (by linarith)
    calc _ ≤ ‖L‖ * ‖iteratedFDeriv ℝ i (fun w : ℝ³ × ℝ => eTh w.1) z‖ := h1
      _ ≤ (1 + ‖Lp‖ + ‖Lm‖) * (Cb * simScale B.h (z.1 2) (1 - z.2) ^ (-Kb)) :=
          mul_le_mul hL e3 (norm_nonneg _) (by linarith)
      _ = _ := by ring
  refine ⟨(1 + ‖Lp‖ + ‖Lm‖) * Cb, Kb, hC1, hKb0, fun N => ?_⟩
  obtain ⟨n, hn⟩ := Int.eq_nat_or_neg N
  have fin : ∀ L : ℝ³ →L[ℝ] ℂ, ‖L‖ ≤ 1 + ‖Lp‖ + ‖Lm‖ →
      (∀ w ∈ W, Complex.exp (Complex.I * (N : ℂ) * (thetaOf w.1 : ℂ)) = L (eTh w.1) ^ n) →
      (∀ w ∈ W, ‖L (eTh w.1)‖ = 1) → |(N : ℝ)| = (n : ℝ) →
      ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => Complex.exp (Complex.I * (N : ℂ) * (thetaOf w.1 : ℂ))) W ∧
      ∀ z ∈ W, ∀ j : ℕ, j ≤ k →
        ‖iteratedFDeriv ℝ j (fun w : ℝ³ × ℝ => Complex.exp (Complex.I * (N : ℂ) * (thetaOf w.1 : ℂ))) z‖ ≤
          ((1 + |(N : ℝ)|) * ((1 + ‖Lp‖ + ‖Lm‖) * Cb * simScale B.h (z.1 2) (1 - z.2) ^ (-Kb))) ^ j := by
    intro L hL hid hunit hNn
    refine ⟨((hvsm L).pow n).congr hid, fun z hz j hj => ?_⟩
    obtain ⟨q0, q1⟩ := hq z hz
    have hS1 : 1 ≤ simScale B.h (z.1 2) (1 - z.2) ^ (-Kb) :=
      Real.one_le_rpow_of_pos_of_le_one_of_nonpos q0 q1 (by linarith)
    have hD1 : 1 ≤ (1 + ‖Lp‖ + ‖Lm‖) * Cb * simScale B.h (z.1 2) (1 - z.2) ^ (-Kb) :=
      one_le_mul_of_one_le_of_one_le hC1 hS1
    have hev : (fun w : ℝ³ × ℝ => Complex.exp (Complex.I * (N : ℂ) * (thetaOf w.1 : ℂ))) =ᶠ[nhds z]
        (fun y : ℝ³ × ℝ => L (eTh y.1) ^ n) :=
      Filter.eventuallyEq_of_mem (hWo.mem_nhds hz) hid
    rw [(hev.iteratedFDeriv ℝ j).eq_of_nhds, hNn]
    exact hgen W (fun w => L (eTh w.1)) z k
      ((1 + ‖Lp‖ + ‖Lm‖) * Cb * simScale B.h (z.1 2) (1 - z.2) ^ (-Kb)) hWo (hvsm L) hz
      (by linarith) (le_of_eq (hunit z hz))
      (fun i hi1 hik => (hvb L hL z hz i hik).trans (le_self_pow₀ hD1 (by omega))) n j hj
  rcases hn with hn | hn
  · refine fin Lp (by linarith) (fun w hw => ?_) (fun w hw => ?_) (by rw [hn]; simp)
    · rw [← (hangle w.1 hw.2.1).1, ← Complex.exp_nat_mul, hn]
      congr 1
      push_cast
      ring
    · rw [← (hangle w.1 hw.2.1).1]
      exact Complex.norm_exp_ofReal_mul_I _
  · refine fin Lm (by linarith) (fun w hw => ?_) (fun w hw => ?_) (by rw [hn]; simp)
    · rw [← (hangle w.1 hw.2.1).2, ← Complex.exp_nat_mul, hn]
      congr 1
      push_cast
      ring
    · rw [← (hangle w.1 hw.2.1).2]
      exact Complex.norm_exp_ofReal_mul_I _

theorem ipb5_wexp_comp : ∀ {E F G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G] [NormedSpace ℝ G] (g : F → G) (f : E → F) (Ω : Set E) (T : Set F), IsOpen Ω → IsOpen T → Set.MapsTo f Ω T → ContDiffOn ℝ ∞ g T → ContDiffOn ℝ ∞ f Ω → ∀ (n : ℕ) (w : E) (ρ a Cg Cf K : ℝ), w ∈ Ω → 0 < ρ → ρ ≤ 1 → 0 ≤ K → (∀ i : ℕ, i ≤ n → ‖iteratedFDeriv ℝ i g (f w)‖ ≤ Cg * ρ ^ a) → (∀ i : ℕ, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i f w‖ ≤ Cf * ρ ^ (-K)) → ‖iteratedFDeriv ℝ n (g ∘ f) w‖ ≤ (n.factorial : ℝ) * Cg * (max 1 Cf) ^ n * ρ ^ (a - (n : ℝ) * K) :=
by
  intro E F G _ _ _ _ _ _ g f Ω T hΩ hT hmaps hg hf n w ρ a Cg Cf K hw hr0 hr1 hK hGb hFb
  have hfw : f w ∈ T := hmaps hw
  have hpos : ∀ c : ℝ, 0 ≤ ρ ^ c := fun c => (Real.rpow_pos_of_pos hr0 c).le
  have hP1 : 1 ≤ ρ ^ (-K) :=
    Real.one_le_rpow_of_pos_of_le_one_of_nonpos hr0 hr1 (by linarith)
  have hM1 : (1 : ℝ) ≤ max 1 Cf := le_max_left _ _
  have hD1 : 1 ≤ max 1 Cf * ρ ^ (-K) := one_le_mul_of_one_le_of_one_le hM1 hP1
  have hgbound : ∀ i ≤ n, ‖iteratedFDerivWithin ℝ i g T (f w)‖ ≤ Cg * ρ ^ a := by
    intro i hi
    rw [iteratedFDerivWithin_of_isOpen i hT hfw]
    exact hGb i hi
  have hfbound : ∀ i, 1 ≤ i → i ≤ n →
      ‖iteratedFDerivWithin ℝ i f Ω w‖ ≤ (max 1 Cf * ρ ^ (-K)) ^ i := by
    intro i hi1 hi
    rw [iteratedFDerivWithin_of_isOpen i hΩ hw]
    calc ‖iteratedFDeriv ℝ i f w‖ ≤ Cf * ρ ^ (-K) := hFb i hi1 hi
      _ ≤ max 1 Cf * ρ ^ (-K) := mul_le_mul_of_nonneg_right (le_max_right _ _) (hpos _)
      _ ≤ (max 1 Cf * ρ ^ (-K)) ^ i := le_self_pow₀ hD1 (by omega)
  have hle : ((n : ℕ∞) : WithTop ℕ∞) ≤ (∞ : WithTop ℕ∞) := by exact_mod_cast le_top
  have hFdB := norm_iteratedFDerivWithin_comp_le hg hf hle hT.uniqueDiffOn
    hΩ.uniqueDiffOn hmaps hw hgbound hfbound
  rw [iteratedFDerivWithin_of_isOpen n hΩ hw] at hFdB
  refine hFdB.trans (le_of_eq ?_)
  have e1 : (ρ ^ (-K)) ^ n = ρ ^ (-((n : ℝ) * K)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hr0.le]
    congr 1 <;> ring
  have e2 : ρ ^ a * ρ ^ (-((n : ℝ) * K)) = ρ ^ (a - (n : ℝ) * K) := by
    rw [← Real.rpow_add hr0]; congr 1 <;> ring
  rw [mul_pow, e1, ← e2]; ring

theorem wv5_slow_factor : ∀ (B : BG) (l0 : ℕ), B.ok → ∀ k : ℕ, ∃ CX KX : ℝ, 1 ≤ CX ∧ 0 ≤ KX ∧ ∀ (φ : Cyl → ℝ) (U : Set Cyl) (z : ℝ³ × ℝ) (Cφ M : ℝ), IsOpen U → z ∈ {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} → ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0) ∈ U → ContDiffOn ℝ ∞ φ U → 1 ≤ Cφ → 0 ≤ M → (∀ i : ℕ, 1 ≤ i → i ≤ k → ‖iteratedFDeriv ℝ i φ (ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0))‖ ≤ Cφ * simScale B.h (z.1 2) (1 - z.2) ^ (-M)) → ∃ V : Set (ℝ³ × ℝ), IsOpen V ∧ z ∈ V ∧ V ⊆ {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} ∧ ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => Complex.exp (Complex.I * (φ (ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0)) : ℂ))) V ∧ ∀ j : ℕ, j ≤ k → ‖iteratedFDeriv ℝ j (fun w : ℝ³ × ℝ => Complex.exp (Complex.I * (φ (ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0)) : ℂ))) z‖ ≤ ((k.factorial : ℝ) ^ 2) * (Cφ * CX * simScale B.h (z.1 2) (1 - z.2) ^ (-(M + KX))) ^ j :=
by
  intro B l0 hok k

  have hcexp : ∀ (i : ℕ) (y : ℝ), ContDiff ℝ ∞ (fun s : ℝ => Complex.exp (Complex.I * (s : ℂ))) ∧
      ‖iteratedFDeriv ℝ i (fun s : ℝ => Complex.exp (Complex.I * (s : ℂ))) y‖ ≤ 1 := by
    intro i y
    set g : ℝ → ℂ := fun s : ℝ => Complex.exp (Complex.I * (s : ℂ)) with hg
    have hsm : ContDiff ℝ ∞ g := by
      have h1 : ContDiff ℝ ∞ (fun s : ℝ => Complex.I * (s : ℂ)) :=
        contDiff_const.mul Complex.ofRealCLM.contDiff
      exact h1.cexp
    have hder : ∀ s : ℝ, HasDerivAt g (Complex.I * g s) s := by
      intro s
      have h := (((hasDerivAt_id s).ofReal_comp).const_mul Complex.I).cexp
      have e : Complex.exp (Complex.I * ((id s : ℝ) : ℂ)) * (Complex.I * ((1 : ℝ) : ℂ)) =
          Complex.I * g s := by
        rw [hg]; simp only [id, Complex.ofReal_one, mul_one]; ring
      rw [e] at h
      exact h
    have hit : ∀ n : ℕ, iteratedDeriv n g = fun s => Complex.I ^ n * g s := by
      intro n
      induction n with
      | zero => funext s; simp
      | succ n ih =>
        rw [iteratedDeriv_succ, ih]
        funext s
        have := ((hder s).const_mul (Complex.I ^ n)).deriv
        rw [this]
        ring
    refine ⟨hsm, ?_⟩
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, hit i]
    simp only [hg, norm_mul, norm_pow, Complex.norm_I, one_pow, one_mul]
    rw [mul_comm, Complex.norm_exp_ofReal_mul_I]
  obtain ⟨-, hWo, -, sXi, -, -, hcb⟩ := ipb5_mean_coord_bounds B l0 0 hok
  choose Cc Kc hcK using hcb
  set W : Set (ℝ³ × ℝ) := {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧
    B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧
    rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} with hWdef
  set Ξ : ℝ³ × ℝ → Cyl := fun w : ℝ³ × ℝ => ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0) with hΞdef
  obtain ⟨KX, hKX⟩ : ∃ K : ℝ, K = ∑ i ∈ Finset.range (k + 1), |Kc i| := ⟨_, rfl⟩
  obtain ⟨CX, hCX⟩ : ∃ C : ℝ, C = max 1 (∑ i ∈ Finset.range (k + 1), |Cc i|) := ⟨_, rfl⟩
  have hCX1 : 1 ≤ CX := by rw [hCX]; exact le_max_left _ _
  have hKX0 : 0 ≤ KX := by rw [hKX]; exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  have hKle : ∀ i, i ≤ k → |Kc i| ≤ KX := fun i hi => by
    rw [hKX]
    exact Finset.single_le_sum (f := fun i => |Kc i|) (fun j _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  have hCle : ∀ i, i ≤ k → |Cc i| ≤ CX := fun i hi => by
    rw [hCX]
    exact le_trans (Finset.single_le_sum (f := fun i => |Cc i|) (fun j _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))) (le_max_right _ _)
  refine ⟨CX, KX, hCX1, hKX0, ?_⟩
  intro φ U z Cφ M hU hz hzU hφs hCφ hM hφb
  set ρ := simScale B.h (z.1 2) (1 - z.2) with hρ
  have h1 : z.2 < 1 ∧ ρ < qsOf l0 := hz.1
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have ρ0 : 0 < ρ := (hok.1.1 (z.1 2) (1 - z.2) (by linarith [h1.1])).1
  have ρ1 : ρ ≤ 1 := le_trans h1.2.le hqs1
  have hXi : ∀ i, 1 ≤ i → i ≤ k → ‖iteratedFDeriv ℝ i Ξ z‖ ≤ CX * ρ ^ (-KX) := by
    intro i _ hi
    have hK : -KX ≤ -Kc i := by linarith [le_abs_self (Kc i), hKle i hi]
    calc ‖iteratedFDeriv ℝ i Ξ z‖ ≤ Cc i * ρ ^ (-Kc i) := (hcK i z hz).1
      _ ≤ |Cc i| * ρ ^ (-Kc i) :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (Real.rpow_nonneg ρ0.le _)
      _ ≤ |Cc i| * ρ ^ (-KX) :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge ρ0 ρ1 hK) (abs_nonneg _)
      _ ≤ CX * ρ ^ (-KX) := mul_le_mul_of_nonneg_right (hCle i hi) (Real.rpow_nonneg ρ0.le _)
  set V : Set (ℝ³ × ℝ) := W ∩ Ξ ⁻¹' U with hVdef
  have hVo : IsOpen V := sXi.continuousOn.isOpen_inter_preimage hWo hU
  have hzV : z ∈ V := ⟨hz, hzU⟩
  have hVmap : Set.MapsTo Ξ V U := fun w hw => hw.2
  set g : ℝ → ℂ := fun s : ℝ => Complex.exp (Complex.I * (s : ℂ)) with hg
  have hgs : ContDiff ℝ ∞ g := (hcexp 0 0).1
  have sE : ContDiffOn ℝ ∞ (g ∘ φ) U := hgs.comp_contDiffOn hφs
  have sXiV : ContDiffOn ℝ ∞ Ξ V := sXi.mono Set.inter_subset_left
  have hPM : 1 ≤ ρ ^ (-M) := Real.one_le_rpow_of_pos_of_le_one_of_nonpos ρ0 ρ1 (by linarith)
  have hΛ : 1 ≤ Cφ * ρ ^ (-M) := one_le_mul_of_one_le_of_one_le hCφ hPM
  have hpow : ∀ (K : ℝ) (n : ℕ), ρ ^ ((0:ℝ) - (n:ℝ) * K) = (ρ ^ (-K)) ^ n := by
    intro K n
    rw [show (0:ℝ) - (n:ℝ) * K = (-K) * (n:ℝ) by ring, Real.rpow_mul ρ0.le, Real.rpow_natCast]
  have hinner : ∀ i j : ℕ, i ≤ j → j ≤ k →
      ‖iteratedFDeriv ℝ i (g ∘ φ) (Ξ z)‖ ≤ (j.factorial : ℝ) * (Cφ * ρ ^ (-M)) ^ j := by
    intro i j hij hjk
    have h := ipb5_wexp_comp g φ U Set.univ hU isOpen_univ (Set.mapsTo_univ φ U) hgs.contDiffOn hφs
      i (Ξ z) ρ 0 1 Cφ M hzU ρ0 ρ1 hM
      (fun i' _ => by rw [Real.rpow_zero, mul_one]; exact (hcexp i' _).2)
      (fun i' h1 h2 => hφb i' h1 (by omega))
    rw [max_eq_right hCφ, hpow] at h
    refine h.trans ?_
    rw [show (i.factorial : ℝ) * 1 * Cφ ^ i * (ρ ^ (-M)) ^ i =
      (i.factorial : ℝ) * (Cφ * ρ ^ (-M)) ^ i by ring]
    have f1 : (i.factorial : ℝ) ≤ j.factorial := by exact_mod_cast Nat.factorial_le hij
    have f2 : (Cφ * ρ ^ (-M)) ^ i ≤ (Cφ * ρ ^ (-M)) ^ j := pow_le_pow_right₀ hΛ hij
    exact mul_le_mul f1 f2 (pow_nonneg (by linarith) _) (Nat.cast_nonneg _)
  have hfun : (fun w : ℝ³ × ℝ => Complex.exp (Complex.I * (φ (Ξ w) : ℂ))) = (g ∘ φ) ∘ Ξ := rfl
  refine ⟨V, hVo, hzV, Set.inter_subset_left, ?_, ?_⟩
  · rw [hfun]; exact sE.comp sXiV hVmap
  · intro j hjk
    rw [hfun]
    have h := ipb5_wexp_comp (g ∘ φ) Ξ V U hVo hU hVmap sE sXiV j z ρ 0
      ((j.factorial : ℝ) * (Cφ * ρ ^ (-M)) ^ j) CX KX hzV ρ0 ρ1 hKX0
      (fun i hi => by rw [Real.rpow_zero, mul_one]; exact hinner i j hi hjk)
      (fun i h1 h2 => hXi i h1 (by omega))
    rw [max_eq_right hCX1, hpow] at h
    refine h.trans ?_
    have hsplit : ρ ^ (-(M + KX)) = ρ ^ (-M) * ρ ^ (-KX) := by rw [neg_add, Real.rpow_add ρ0]
    rw [hsplit]
    have hfac : ((j.factorial : ℝ)) ^ 2 ≤ (k.factorial : ℝ) ^ 2 :=
      pow_le_pow_left₀ (Nat.cast_nonneg _) (by exact_mod_cast Nat.factorial_le hjk) 2
    have hnn : 0 ≤ (Cφ * CX * (ρ ^ (-M) * ρ ^ (-KX))) ^ j :=
      pow_nonneg (mul_nonneg (mul_nonneg (by linarith) (by linarith))
        (mul_nonneg (Real.rpow_nonneg ρ0.le _) (Real.rpow_nonneg ρ0.le _))) _
    calc (j.factorial : ℝ) * ((j.factorial : ℝ) * (Cφ * ρ ^ (-M)) ^ j) * CX ^ j * (ρ ^ (-KX)) ^ j
        = (j.factorial : ℝ) ^ 2 * (Cφ * CX * (ρ ^ (-M) * ρ ^ (-KX))) ^ j := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_right hfac hnn

theorem wv5_phase_bound : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ k : ℕ, ∃ C K : ℝ, ∀ (γ : Lab) (m : ℤ) (z : ℝ³ × ℝ), z ∈ {z : ℝ³ × ℝ | z ∈ simDomain B.h (qsOf l0) ∧ 0 < rad z.1 ∧ B.Xa * simScale B.h (z.1 2) (1 - z.2) < 2 * rad z.1 ^ 2 ∧ rad z.1 ^ 2 < 8 * B.Xb * simScale B.h (z.1 2) (1 - z.2)} → ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0) ∈ closure {ξ : Cyl | ξ ∈ DomC B.h (qsOf l0) ∧ SuppW B G γ ξ} → ∃ U : Set (ℝ³ × ℝ), IsOpen U ∧ z ∈ U ∧ ContDiffOn ℝ ∞ (fun w : ℝ³ × ℝ => ephase5 B G γ m (thetaOf w.1) (ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0))) U ∧ ∀ i : ℕ, i ≤ k → ‖iteratedFDeriv ℝ i (fun w : ℝ³ × ℝ => ephase5 B G γ m (thetaOf w.1) (ptOf w.1 w.2 (Yph B.h (rad w.1) w.2 + 0))) z‖ ≤ C * (1 + |(m : ℝ)|) ^ k * simScale B.h (z.1 2) (1 - z.2) ^ (-K) :=
by
  intro B G hok hG
  obtain ⟨la, hla⟩ := wv5_activeL4_of_suppW B G hok hG
  obtain ⟨l5, h5⟩ := wv5_phiL5_window_jet B G hok hG
  obtain ⟨Kp, hKp0, hKp⟩ := wpf_pint_bound B G hok hG
  choose C5 M5 hM5 h5' using h5
  refine ⟨la + l5, fun l0 hl0 k => ?_⟩
  obtain ⟨CX, KX, hCX1, hKX0, hs9⟩ := wv5_slow_factor B l0 hok k
  obtain ⟨CA, KA, hCA1, hKA0, hs7⟩ := wv5_angular_bound B l0 hok k
  obtain ⟨Ch, hChdef⟩ : ∃ c : ℝ, c = 1 + ∑ i ∈ Finset.range (k + 1), |C5 i| := ⟨_, rfl⟩
  obtain ⟨Mh, hMhdef⟩ : ∃ c : ℝ, c = ∑ i ∈ Finset.range (k + 1), M5 i := ⟨_, rfl⟩
  have hCh1 : 1 ≤ Ch := by
    have : 0 ≤ ∑ i ∈ Finset.range (k + 1), |C5 i| := Finset.sum_nonneg (fun i _ => abs_nonneg _)
    rw [hChdef]; linarith
  have hMh0 : 0 ≤ Mh := by rw [hMhdef]; exact Finset.sum_nonneg (fun i _ => hM5 i)
  have hCle : ∀ i, i ≤ k → |C5 i| ≤ Ch := by
    intro i hi
    have : |C5 i| ≤ ∑ j ∈ Finset.range (k + 1), |C5 j| :=
      Finset.single_le_sum (f := fun j => |C5 j|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.mpr (by omega))
    rw [hChdef]; linarith
  have hMle : ∀ i, i ≤ k → M5 i ≤ Mh := fun i hi => by
    rw [hMhdef]
    exact Finset.single_le_sum (f := fun j => M5 j) (fun j _ => hM5 j) (Finset.mem_range.mpr (by omega))
  obtain ⟨X0, hX0⟩ : ∃ c : ℝ, c = (1 + Kp) * CA := ⟨_, rfl⟩
  obtain ⟨aX, haX⟩ : ∃ c : ℝ, c = 1 + KA := ⟨_, rfl⟩
  obtain ⟨Y0, hY0⟩ : ∃ c : ℝ, c = Ch * CX := ⟨_, rfl⟩
  obtain ⟨aY, haY⟩ : ∃ c : ℝ, c = Mh + KX := ⟨_, rfl⟩
  have hX01 : 1 ≤ X0 := by
    have : 1 * 1 ≤ (1 + Kp) * CA := mul_le_mul (by linarith) hCA1 zero_le_one (by linarith)
    rw [hX0]; linarith
  have hY00 : 0 ≤ Y0 := by rw [hY0]; exact mul_nonneg (by linarith) (by linarith)
  have haX0 : 0 ≤ aX := by rw [haX]; linarith
  have haY0 : 0 ≤ aY := by rw [haY]; linarith
  refine ⟨((k.factorial : ℝ) ^ 2) * (X0 + Y0) ^ k, (k : ℝ) * (aX + aY), ?_⟩
  intro γ m z hz hcl
  have h1 : z.2 < 1 ∧ simScale B.h (z.1 2) (1 - z.2) < qsOf l0 := hz.1
  have hrad : 0 < rad z.1 := hz.2.1
  have hqs1 : qsOf l0 ≤ 1 := by
    show (2:ℝ) ^ (-(l0:ℝ)) ≤ 1
    exact Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) (by simp)
  have hq0 : 0 < simScale B.h (z.1 2) (1 - z.2) :=
    (hok.1.1 (z.1 2) (1 - z.2) (by linarith [h1.1])).1
  have hq1 : simScale B.h (z.1 2) (1 - z.2) ≤ 1 := le_trans h1.2.le hqs1
  have hξD : ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0) ∈ DomC B.h (qsOf l0) := by
    show 0 < rad z.1 ∧ z.2 < 1 ∧ qC B.h (ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) < qsOf l0
    exact ⟨hrad, h1.1, h1.2⟩
  have hqC : qC B.h (ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) = simScale B.h (z.1 2) (1 - z.2) := rfl

  obtain ⟨⟨η, hηD, hηS⟩, hll, hband, hb1, hb2, hXa, hXb, hxi, het⟩ :=
    wv5_suppW_closure_window B G hok hG l0 γ _ hξD hcl
  have hact : ActiveL4 B G γ := hla l0 (by omega) γ η hηD hηS
  have hXa0 : 0 < B.Xa := hok.2.1.2.2.1
  have hXa2 : B.Xa / 2 < XC B.h (ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) := by linarith
  have hXb2 : XC B.h (ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) < 2 * B.Xb := by linarith
  have hJ := fun i => h5' i l0 γ _ (by omega) hact hll hξD hb1 hb2 hXa2 hXb2 hxi het
  obtain ⟨U0, hU0o, hξU0, hU0s⟩ := (hJ 0).1

  have hkb0 : (0:ℝ) ≤ (kb B.h γ.1 : ℝ) := Nat.cast_nonneg _
  have hP0 : 0 ≤ simScale B.h (z.1 2) (1 - z.2) ^ (-Mh) := Real.rpow_nonneg hq0.le _
  have hφb : ∀ i : ℕ, 1 ≤ i → i ≤ k →
      ‖iteratedFDeriv ℝ i (fun η : Cyl => ((m : ℝ) * (kb B.h γ.1 : ℝ)) * phiL5 B G γ η)
        (ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0))‖ ≤
      ((1 + |(m:ℝ)|) * Ch) * simScale B.h (z.1 2) (1 - z.2) ^ (-Mh) := by
    intro i hi1 hik
    have hca : ContDiffAt ℝ (i : ℕ) (phiL5 B G γ) (ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0)) :=
      (hU0s.contDiffAt (hU0o.mem_nhds hξU0)).of_le (by exact_mod_cast le_top)
    have hfeq : (fun η : Cyl => ((m : ℝ) * (kb B.h γ.1 : ℝ)) * phiL5 B G γ η) =
        ((m : ℝ) * (kb B.h γ.1 : ℝ)) • phiL5 B G γ := by
      funext η; simp [smul_eq_mul]
    rw [hfeq, iteratedFDeriv_const_smul_apply hca, norm_smul, Real.norm_eq_abs, abs_mul,
      abs_of_nonneg hkb0]
    have hb := (hJ i).2 hi1
    rw [hqC] at hb
    have hpw : simScale B.h (z.1 2) (1 - z.2) ^ (-M5 i) ≤ simScale B.h (z.1 2) (1 - z.2) ^ (-Mh) :=
      Real.rpow_le_rpow_of_exponent_ge hq0 hq1 (by linarith [hMle i hik])
    have hp0 : 0 ≤ simScale B.h (z.1 2) (1 - z.2) ^ (-M5 i) := Real.rpow_nonneg hq0.le _
    have h2 : (kb B.h γ.1 : ℝ) *
        ‖iteratedFDeriv ℝ i (phiL5 B G γ) (ptOf z.1 z.2 (Yph B.h (rad z.1) z.2 + 0))‖
