  have hint : ∀ v' ∈ Set.Ioo 0 (Lsb B.h G.r0 γ.1),
      ‖(iteratedFDeriv ℝ k (fun w : (ℝ × ℝ × ℝ) × ℝ => M γ w.1 w.2) ((ξ.1, ξ.2.1, ξ.2.2.1), v')).compContinuousLinearMap
        (fun _ => ((Real.sqrt (qC B.h ξ) • ContinuousLinearMap.id ℝ ℝ).prodMap
