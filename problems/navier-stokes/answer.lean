        _ ≤ Cb := hb
    · exact intervalIntegrable_const
    · refine ae_of_all _ (fun t _ x hx => ?_)
      have hxm : x ∈ Ioo c d := hsub ⟨hx.1.le, hx.2.le⟩
      show HasDerivAt (fun e => G t e) (deriv (fun e => G t e) x) x
      rw [(hpd t x hxm).deriv]; exact hpd t x hxm

  have hsplit : ∀ (g k : ℝ → ℝ) (S B : ℝ), 0 ≤ S → 0 ≤ B → Continuous g →
      (∀ y, 0 < y → y ≤ S → |g y| ≤ k y * B) → (∀ y, 0 < y → y ≤ S → k y ≤ 1) →
      (∀ y, t1 ≤ y → y ≤ S → k y = κ0) → |∫ y in (0:ℝ)..S, g y| ≤ (t1 + κ0 * S) * B := by
    intro g k S B hS hB hg hb hk1 hkk
    obtain ⟨m, hm⟩ : ∃ m : ℝ, m = min S t1 := ⟨_, rfl⟩
    have hm0 : 0 ≤ m := by rw [hm]; exact le_min hS ht1.le
    have hmS : m ≤ S := by rw [hm]; exact min_le_left _ _
    have hmt : m ≤ t1 := by rw [hm]; exact min_le_right _ _
    rw [← intervalIntegral.integral_add_adjacent_intervals (hg.intervalIntegrable 0 m)
