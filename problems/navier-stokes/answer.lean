theorem cr5_wavewave_class : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∃ l1 : ℕ, ∀ l0 : ℕ, l1 ≤ l0 → ∀ (S : CState) (bw ca cm cd β : ℝ) (D : WC) (H : Finset ℤ), StOrd5 B G l0 S bw ca cm cd → InWg5 B G (qsOf l0) (β + 1/2) D → InWg5 B G (qsOf l0) β (velW5 B G D) → (∀ γ m, m ∉ H → S.Aw γ m = 0 ∧ D γ m = 0) → InWg5 B G (qsOf l0) (β + 1/2 - kapS) (cr5Osc (cr5WW B G H (cr5Vel B G S.Aw) (cr5Vel B G D) + cr5WW B G H (cr5Vel B G D) (cr5Vel B G S.Aw))) :=
by
  intro B G hok hG
  obtain ⟨hh0, -, hXa, -, -, -, -, hqB0, -, -, -, -, -⟩ := hok.2.1
  obtain ⟨lA, hA⟩ := wmo_amp_class_v5 B G hok hG
  obtain ⟨lP, hP⟩ := pq5_prod_class B G hok hG
  obtain ⟨lR, hR⟩ := pq5_dR_class B G hok hG
  obtain ⟨lZ, hZ⟩ := pq5_dZ_class B G hok hG
  obtain ⟨lM, hM⟩ := pq5_mult_class B G hok hG
  obtain ⟨lN, hN⟩ := ssh5_ndot_class B G hok hG
  obtain ⟨lV, hV⟩ := velRem5_class B G hok hG
  obtain ⟨n0, hn0⟩ := exists_pow_lt_of_lt_one hqB0 (by norm_num : (1/2:ℝ) < 1)
  refine ⟨lA + lP + lR + lZ + lM + lN + lV + n0, fun l0 hl0 S bw ca cm cd β D H hSt hD hvD _hH => ?_⟩
  have hk : kapS = 1 / 100000 := rfl
  have hκ : 0 < kapS := by rw [hk]; norm_num
  have hQb : qsOf l0 = (1/2:ℝ) ^ l0 := by
    show (2:ℝ) ^ (-(l0:ℝ)) = _
    rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]
  have hq1 : qsOf l0 ≤ 1 := by
    rw [hQb]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have hqsB : qsOf l0 ≤ B.qB := by
    rw [hQb]
    exact le_trans (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega : n0 ≤ l0)) hn0.le



  have hPF : ∀ (c1 c2 : WC) (α : ℝ), InWg5 B G (qsOf l0) α (wmoAmp5 B G c2) →
      ∀ (γ : Lab) (M : ℤ), ∀ ξ ∈ DomC B.h (qsOf l0),
      cr5WW B G H (cr5Vel B G c1) (cr5Vel B G c2) γ M ξ =
        ∑ m ∈ H, ∑ m' ∈ H,
          ((if m + m' = M then (1/2 : ℂ) • pq5T B G γ m' (wmoAmp5 B G c1 γ m ξ) (wmoAmp5 B G c2 γ m') ξ
              else 0) +
           (if m' - m = M then (1/2 : ℂ) • pq5T B G γ m' (fun i => starRingEnd ℂ (wmoAmp5 B G c1 γ m ξ i))
              (wmoAmp5 B G c2 γ m') ξ else 0)) := by
    intro c1 c2 α hW γ M ξ hξ
    obtain ⟨hΩ, hqC, hqpos, -, -, -⟩ := domc_open_calculus B (qsOf l0) hok
    have hQb : 0 < Qb γ.1 := Real.rpow_pos_of_pos (by norm_num) _
    have hξ' : 0 < ξ.1 ∧ ξ.2.2.1 < 1 ∧ qC B.h ξ < qsOf l0 := hξ
    have hq0 := hqpos ξ hξ
    have hne : qC B.h ξ ≠ 0 := hq0.ne'
    have hd : HasFDerivAt (qC B.h) (fderiv ℝ (qC B.h) ξ) ξ :=
      ((hqC.contDiffAt (hΩ.mem_nhds hξ)).differentiableAt (by norm_num)).hasFDerivAt
    have hR0 : fderiv ℝ (qC B.h) ξ ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) = 0 := by
      have hL : HasDerivAt (fun t : ℝ => ξ + t • ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv))
          ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) 0 := by
        have h0 := ((hasDerivAt_id (0:ℝ)).smul_const
          ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)).const_add ξ
        simpa using h0
      have hd' : HasFDerivAt (qC B.h) (fderiv ℝ (qC B.h) ξ)
          (ξ + (0:ℝ) • ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) := by
        rw [zero_smul, add_zero]; exact hd
      have h1 := hd'.comp_hasDerivAt (0:ℝ) hL
      have hc : (qC B.h ∘ fun t : ℝ => ξ + t • ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)) =
          fun _ => qC B.h ξ := by
        funext t
        simp [qC]
      rw [hc] at h1
      exact h1.unique (hasDerivAt_const _ _)
    have hgq : HasFDerivAt (fun η => qC B.h η ^ (-Aex B.h))
        ((-Aex B.h * qC B.h ξ ^ (-Aex B.h - 1)) • fderiv ℝ (qC B.h) ξ) ξ :=
      hd.rpow_const (Or.inl hne)
    have hgC : HasFDerivAt (fun η => ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ))
        (Complex.ofRealCLM.comp ((-Aex B.h * qC B.h ξ ^ (-Aex B.h - 1)) • fderiv ℝ (qC B.h) ξ)) ξ := by
      have h0 := Complex.ofRealCLM.hasFDerivAt.comp ξ hgq
      exact h0
    have hZw : -Aex B.h * qC B.h ξ ^ (-Aex B.h - 1) * fderiv ℝ (qC B.h) ξ ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) =
        -(qC B.h ξ ^ (-Aex B.h) * (Aex B.h * dZ (fun η => Real.log (qC B.h η)) ξ)) := by
      unfold dZ
      rw [(hd.log hne).fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul, Real.rpow_sub_one hne]
      ring
    have hjet : ∀ (m : ℤ) (i : Fin 3),
        dR B.h (modeCoef5 B G (cr5Vel B G c2) γ m) ξ i =
          ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * dR B.h (fun η => modeCoef5 B G (wmoAmp5 B G c2) γ m η i) ξ ∧
        dZ (modeCoef5 B G (cr5Vel B G c2) γ m) ξ i =
          ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * (dZ (fun η => modeCoef5 B G (wmoAmp5 B G c2) γ m η i) ξ -
            ((Aex B.h * dZ (fun η => Real.log (qC B.h η)) ξ : ℝ) : ℂ) *
              modeCoef5 B G (wmoAmp5 B G c2) γ m ξ i) := by
      intro m i
      have hEq0 : modeCoef5 B G (cr5Vel B G c2) γ m =
          (fun η => ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ)) • modeCoef5 B G (wmoAmp5 B G c2) γ m := by
        funext η j
        simp only [modeCoef5, cr5Vel, Pi.smul_apply', Pi.smul_apply, smul_eq_mul]
        ring
      have hEq : modeCoef5 B G (cr5Vel B G c2) γ m =ᶠ[nhds ξ]
          (fun η => ((qC B.h η ^ (-Aex B.h) : ℝ) : ℂ)) • modeCoef5 B G (wmoAmp5 B G c2) γ m :=
        Filter.Eventually.of_forall (congrFun hEq0)
      have hF : HasFDerivAt (modeCoef5 B G (wmoAmp5 B G c2) γ m)
          (fderiv ℝ (modeCoef5 B G (wmoAmp5 B G c2) γ m) ξ) ξ :=
        (modeCoef5_differentiable_v5 B G hok hG (qsOf l0) α (wmoAmp5 B G c2) hqsB hW γ m ξ hξ).hasFDerivAt
      have hFi := (hasFDerivAt_pi'.1 hF i).fderiv
      have hfd := (hEq.fderiv_eq).trans (hgC.smul hF).fderiv
      constructor
      · show fderiv ℝ (modeCoef5 B G (cr5Vel B G c2) γ m) ξ
            ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv) i =
          ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * fderiv ℝ (fun η => modeCoef5 B G (wmoAmp5 B G c2) γ m η i) ξ
            ((1:ℝ), (0:ℝ), (0:ℝ), (drx B.h * ξ.1 ^ (drx B.h - 1)) • vrv)
        rw [hfd, hFi]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
          ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.comp_apply, ContinuousLinearMap.proj_apply,
          Complex.ofRealCLM_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul, hR0, mul_zero,
          Complex.ofReal_zero, zero_mul, add_zero]
      · show fderiv ℝ (modeCoef5 B G (cr5Vel B G c2) γ m) ξ ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) i =
          ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) * (fderiv ℝ (fun η => modeCoef5 B G (wmoAmp5 B G c2) γ m η i) ξ
            ((0:ℝ), (1:ℝ), (0:ℝ), (0:ℝ × ℝ)) -
            ((Aex B.h * dZ (fun η => Real.log (qC B.h η)) ξ : ℝ) : ℂ) * modeCoef5 B G (wmoAmp5 B G c2) γ m ξ i)
        rw [hfd, hFi]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
          ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.comp_apply, ContinuousLinearMap.proj_apply,
          Complex.ofRealCLM_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
        rw [hZw]
        push_cast
        ring
    obtain ⟨E, hE⟩ : ∃ E : ℤ → ℂ, ∀ k : ℤ,
        E k = Complex.exp (Complex.I * (k : ℂ) * ((kb B.h γ.1 : ℂ) * (phiL5 B G γ ξ : ℂ))) := ⟨_, fun k => rfl⟩
    obtain ⟨s, hs⟩ : ∃ s : ℂ, s = ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) := ⟨_, rfl⟩
    have hval : ∀ (c : WC) (m : ℤ) (i : Fin 3), modeCoef5 B G (cr5Vel B G c) γ m ξ i =
        s * (wmoAmp5 B G c γ m ξ i * E m) := by
      intro c m i
      rw [hE, hs]
      show (((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) • wmoAmp5 B G c γ m ξ) i * _ = _
      rw [Pi.smul_apply, smul_eq_mul, mul_assoc]
    have hdR' : ∀ (m : ℤ) (i : Fin 3), dR B.h (modeCoef5 B G (cr5Vel B G c2) γ m) ξ i =
        s * ((dR B.h (fun η => wmoAmp5 B G c2 γ m η i) ξ + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) *
          ((dR B.h (phiL5 B G γ) ξ : ℝ) : ℂ) * wmoAmp5 B G c2 γ m ξ i) * E m) := by
      intro m i
      rw [(hjet m i).1, (wmo_phase_deriv_v5 B G hok hG (qsOf l0) α (wmoAmp5 B G c2) hqsB hW γ m ξ hξ i).1,
        hE, hs]
    have hdZ' : ∀ (m : ℤ) (i : Fin 3), dZ (modeCoef5 B G (cr5Vel B G c2) γ m) ξ i =
        s * ((dZ (fun η => wmoAmp5 B G c2 γ m η i) ξ + Complex.I * (m : ℂ) * (kb B.h γ.1 : ℂ) *
          ((dZ (phiL5 B G γ) ξ : ℝ) : ℂ) * wmoAmp5 B G c2 γ m ξ i) * E m -
          ((Aex B.h * dZ (fun η => Real.log (qC B.h η)) ξ : ℝ) : ℂ) * (wmoAmp5 B G c2 γ m ξ i * E m)) := by
      intro m i
      rw [(hjet m i).2, (wmo_phase_deriv_v5 B G hok hG (qsOf l0) α (wmoAmp5 B G c2) hqsB hW γ m ξ hξ i).2,
        hE, hs]
      rfl
    have hEadd : ∀ a b : ℤ, E (a + b) = E a * E b := by
      intro a b
      rw [hE, hE, hE, ← Complex.exp_add]
      congr 1
      push_cast
      ring
    have hconj : ∀ (c : WC) (m : ℤ) (i : Fin 3), starRingEnd ℂ (modeCoef5 B G (cr5Vel B G c) γ m ξ i) =
        s * (starRingEnd ℂ (wmoAmp5 B G c γ m ξ i) * E (-m)) := by
      intro c m i
      have hsr : starRingEnd ℂ s = s := by rw [hs, Complex.conj_ofReal]
      have hEc : starRingEnd ℂ (E m) = E (-m) := by
        rw [hE, hE, ← Complex.exp_conj]
        congr 1
        simp only [map_mul, Complex.conj_I, Complex.conj_ofReal, map_intCast, map_natCast]
        push_cast
        ring
      rw [hval, map_mul, map_mul, hsr, hEc]
    have hkb : 0 < kb B.h γ.1 := by
      unfold kb epsb
      exact Nat.ceil_pos.2 (Real.rpow_pos_of_pos (Real.rpow_pos_of_pos hQb _) _)
    have hK : (kb B.h γ.1 : ℂ) ≠ 0 := by exact_mod_cast hkb.ne'
    have hr0 : (ξ.1 : ℂ) ≠ 0 := by exact_mod_cast hξ'.1.ne'
    have hQh : ((Real.sqrt (Qb γ.1) : ℝ) : ℂ) ≠ 0 := by exact_mod_cast (Real.sqrt_pos.2 hQb).ne'
    have hs0 : s ≠ 0 := by rw [hs]; exact_mod_cast (Real.rpow_pos_of_pos hq0 _).ne'
    have hE0 : ∀ k, E k ≠ 0 := fun k => by rw [hE]; exact Complex.exp_ne_zero _
    have hQi : Qb γ.1 ^ (-(1/2:ℝ)) = (Real.sqrt (Qb γ.1))⁻¹ := by
      rw [Real.rpow_neg hQb.le, Real.sqrt_eq_rpow]
    have hPC : (1/2 : ℂ) * ((qC B.h ξ ^ (2 * Aex B.h + 1/2) : ℝ) : ℂ) =
        ((Real.sqrt (qC B.h ξ) : ℝ) : ℂ) / (2 * (s * s)) := by
      have hP : qC B.h ξ ^ (2 * Aex B.h + 1/2) * (qC B.h ξ ^ (-Aex B.h) * qC B.h ξ ^ (-Aex B.h)) =
          Real.sqrt (qC B.h ξ) := by
        rw [← Real.rpow_add hq0, ← Real.rpow_add hq0, Real.sqrt_eq_rpow]
        congr 1
        ring
      have ha : ((qC B.h ξ ^ (-Aex B.h) : ℝ) : ℂ) ≠ 0 := by rw [← hs]; exact hs0
      rw [← hP, hs]
      push_cast
      field_simp
    have hpair : ∀ (σ m' : ℤ) (u U : Fin 3 → ℂ), σ + m' = M → (∀ i, U i = s * (u i * E σ)) →
        ((1/2 : ℂ) * cr5Ph B G γ M ξ) •
          pq5TrM B.h (m' * pint5 B G γ) U (modeCoef5 B G (cr5Vel B G c2) γ m') ξ =
        (1/2 : ℂ) • pq5T B G γ m' u (wmoAmp5 B G c2 γ m') ξ := by
      intro σ m' u U hσ hU
      have h1 := hE0 σ
      have h2 := hE0 m'
      unfold cr5Ph
      rw [← mul_assoc, hPC, ← hE M, ← hσ, hEadd]
      funext i
      fin_cases i <;>
