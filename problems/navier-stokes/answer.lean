theorem ax_shear_U_facts : ∀ (h Pst : ℝ) (Pax : ℝ → ℝ) (ε Bd C T θ Kb Ks MP s1 s2 : ℝ) (β : Fin 2 → ℝ → ℝ) (γ : Fin 3 → ℝ → ℝ) (c : ℝ → Fin 5 → ℝ) (Xa Xan Xa1 Xa2 aa τ : ℝ) (ℓ G : ℝ → ℝ) (F U : ℝ → ℝ → ℝ), AxGlue h Pst Pax ε Bd C T θ Kb Ks MP s1 s2 β γ c Xa Xan Xa1 Xa2 aa τ ℓ G F U → (∀ X η : ℝ, 0 ≤ X → -1 < η → η < 1 → |axUm Pst C G U β c X η - 4 * η| ≤ ε + 2 * θ * Kb ∧ |deriv (fun e => axUm Pst C G U β c X e) η - 4| ≤ ε + 2 * θ * Kb) ∧ (∀ X η : ℝ, 110 ≤ X → X < 110 * (C * Pst) ^ 10 * Real.exp (-8) → -1 < η → η < 1 → deriv (fun Y => axUm Pst C G U β c Y η) X = 0) ∧ (∀ X η : ℝ, 110 * (C * Pst) ^ 10 * Real.exp (-8) ≤ X → -1 < η → η < 1 → |X * deriv (fun Y => axUm Pst C G U β c Y η) X| ≤ Ks * ε + 2 * θ * Kb) :=
