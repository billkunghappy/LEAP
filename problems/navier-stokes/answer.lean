    have hfd : ContinuousOn (fderiv ℝ (↿g)) (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) :=
      hg.continuousOn_fderiv_of_isOpen hS (by simp)
    obtain ⟨M0, hM0⟩ := hK.exists_bound_of_continuousOn (hfd.mono hKsub)
    have hpt : ∀ t e : ℝ, (t, e) ∈ Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 →
        HasDerivAt (fun e' => g t e') (fderiv ℝ (↿g) (t, e) ((0:ℝ), (1:ℝ))) e := by
      intro t e hte
      have h1 : ContDiffAt ℝ ∞ (↿g) (t, e) := hg.contDiffAt (hS.mem_nhds hte)
      have hd : DifferentiableAt ℝ (↿g) (t, e) := h1.differentiableAt (by simp)
      have hcv : HasDerivAt (fun e' : ℝ => (t, e')) ((0:ℝ), (1:ℝ)) e :=
        (hasDerivAt_const e t).prodMk (hasDerivAt_id' e)
      exact hd.hasFDerivAt.comp_hasDerivAt e hcv
    have hcont_slice : ∀ e : ℝ, -1 < e → e < 1 → ContinuousOn (fun t => g t e) (Icc 0 x) := by
      intro e he1 he2
      have : ContinuousOn (fun t : ℝ => (↿g) (t, e)) (Icc 0 x) :=
        hg.continuousOn.comp (continuous_id.prodMk continuous_const).continuousOn
          (fun t ht => ⟨show -ε < t by linarith [ht.1], he1, he2⟩)
      exact this
    have hcont_d : ContinuousOn (fun t => fderiv ℝ (↿g) (t, η) ((0:ℝ), (1:ℝ))) (Icc 0 x) := by
      have : ContinuousOn (fun t : ℝ => fderiv ℝ (↿g) (t, η)) (Icc 0 x) :=
        hfd.comp (continuous_id.prodMk continuous_const).continuousOn
          (fun t ht => ⟨show -ε < t by linarith [ht.1], hη1, hη2⟩)
      exact this.clm_apply continuousOn_const
    have huIoc : uIoc 0 x = Ioc 0 x := uIoc_of_le hx.le
    have huIcc : uIcc 0 x = Icc 0 x := uIcc_of_le hx.le
    have hs : Ioo (η - r) (η + r) ∈ nhds η := Ioo_mem_nhds (by linarith) (by linarith)
    show DifferentiableAt ℝ (fun e => ∫ t in (0:ℝ)..x, g t e) η
    refine (intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (μ := volume) (a := 0) (b := x) (x₀ := η) (s := Ioo (η - r) (η + r))
      (F := fun e t => g t e) (F' := fun e t => fderiv ℝ (↿g) (t, e) ((0:ℝ), (1:ℝ)))
      (bound := fun _ => M0) hs ?_ ?_ ?_ ?_ ?_ ?_).2.differentiableAt
    · filter_upwards [hs] with e he
      rw [huIoc]
      exact ((hcont_slice e (by linarith [he.1]) (by linarith [he.2])).mono
        Ioc_subset_Icc_self).aestronglyMeasurable measurableSet_Ioc
    · apply ContinuousOn.intervalIntegrable
      rw [huIcc]
      exact hcont_slice η hη1 hη2
    · rw [huIoc]
      exact (hcont_d.mono Ioc_subset_Icc_self).aestronglyMeasurable measurableSet_Ioc
    · refine MeasureTheory.ae_of_all _ (fun t ht e he => ?_)
      rw [huIoc] at ht
      have hmem : (t, e) ∈ Icc 0 x ×ˢ Icc (η - r) (η + r) :=
        ⟨Ioc_subset_Icc_self ht, he.1.le, he.2.le⟩
      calc ‖fderiv ℝ (↿g) (t, e) ((0:ℝ), (1:ℝ))‖
          ≤ ‖fderiv ℝ (↿g) (t, e)‖ * ‖((0:ℝ), (1:ℝ))‖ := ContinuousLinearMap.le_opNorm _ _
        _ = ‖fderiv ℝ (↿g) (t, e)‖ := by simp [Prod.norm_def]
        _ ≤ M0 := hM0 _ hmem
    · exact intervalIntegrable_const
    · refine MeasureTheory.ae_of_all _ (fun t ht e he => ?_)
      rw [huIoc] at ht
      exact hpt t e ⟨show -ε < t by linarith [ht.1], by linarith [he.1], by linarith [he.2]⟩

  have hshift : ∀ G : ℝ → ℝ → ℝ, ∀ e : ℝ, IntegrableOn (fun y => G y e ^ 2) (Ioi 0) →
      leadPi G x e = leadPi G 0 e + profRadInt (fun y e => G y e ^ 2) x e := by
    intro G e hint
    have h2 : IntegrableOn (fun y => G y e ^ 2) (Ioi x) := hint.mono_set (Ioi_subset_Ioi hx.le)
    have h3 := intervalIntegral.integral_interval_add_Ioi hint h2
    show -(∫ y in Ioi x, G y e ^ 2) = -(∫ y in Ioi 0, G y e ^ 2) + ∫ y in (0:ℝ)..x, G y e ^ 2
    linarith
  have hO : IsOpen (Ioo (-1:ℝ) 1) := isOpen_Ioo
  have hηO : η ∈ Ioo (-1:ℝ) 1 := ⟨hη1, hη2⟩
  have ev1 : (fun e => leadPi F x e) =ᶠ[nhds η]
      (fun e => leadPi F 0 e + profRadInt (fun y e => F y e ^ 2) x e) :=
    Filter.eventuallyEq_of_mem (hO.mem_nhds hηO) (fun e he => hshift F e (H1 e he.1 he.2).1)
  have ev2 : (fun e => leadPi F' x e) =ᶠ[nhds η]
      (fun e => leadPi F 0 e + profRadInt (fun y e => F' y e ^ 2) x e) :=
    Filter.eventuallyEq_of_mem (hO.mem_nhds hηO) (fun e he => by
      rw [hshift F' e (H1 e he.1 he.2).2.1, (H1 e he.1 he.2).2.2.1])
  have sq : ∀ P : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿P) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿(fun (y e : ℝ) => P y e ^ 2)) (Ioi (-ε) ×ˢ Ioo (-1) 1) :=
    fun P hP => hP.pow 2
  have D1 := hdiff (fun y e => F y e ^ 2) (sq F smF)
  have D2 := hdiff (fun y e => F' y e ^ 2) (sq F' smF')
  obtain ⟨i1, i2, i3, i4, i5⟩ := H1 η hη1 hη2
  obtain ⟨j1, j2, j3, j4⟩ := H2 η hη1 hη2
  unfold profEtaD at j2 j4
  have v1 := hshift F η i1
  have v2 : leadPi F' x η = leadPi F 0 η + profRadInt (fun y e => F' y e ^ 2) x η := by
    rw [hshift F' η i2, i3]
  have hMA : 0 ≤ M + A := by
    linarith [abs_nonneg (leadPi F 0 η), abs_nonneg (profRadInt (fun y e => F y e ^ 2) x η)]
  have hε' : 0 ≤ ε' := le_trans (abs_nonneg _) j3
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [v1]
    exact (abs_add_le _ _).trans (by linarith)
  · unfold profEtaD
    by_cases hPd : DifferentiableAt ℝ (fun e => leadPi F 0 e) η
    · rw [ev1.deriv_eq, deriv_fun_add hPd D1]
      exact (abs_add_le _ _).trans (by linarith)
    · have hnd : ¬ DifferentiableAt ℝ (fun e => leadPi F x e) η := by
        intro hd
        apply hPd
        have h3 := (hd.congr_of_eventuallyEq ev1.symm).sub D1
        convert h3 using 1
        funext e
        simp
      rw [deriv_zero_of_not_differentiableAt hnd]
      simpa using hMA
  · rw [v1, v2, add_sub_add_left_eq_sub]
    exact j3
  · unfold profEtaD
    by_cases hPd : DifferentiableAt ℝ (fun e => leadPi F 0 e) η
    · rw [ev2.deriv_eq, ev1.deriv_eq, deriv_fun_add hPd D2, deriv_fun_add hPd D1,
        add_sub_add_left_eq_sub]
      exact j4
    · have hnd1 : ¬ DifferentiableAt ℝ (fun e => leadPi F x e) η := by
        intro hd
        apply hPd
        have h3 := (hd.congr_of_eventuallyEq ev1.symm).sub D1
        convert h3 using 1
        funext e
        simp
      have hnd2 : ¬ DifferentiableAt ℝ (fun e => leadPi F' x e) η := by
        intro hd
        apply hPd
        have h3 := (hd.congr_of_eventuallyEq ev2.symm).sub D2
        convert h3 using 1
        funext e
        simp
      rw [deriv_zero_of_not_differentiableAt hnd1, deriv_zero_of_not_differentiableAt hnd2]
      simpa using hε'

theorem ps_perturbation : PsPerturbation :=
by
  intro h cinf Xb ε X₁ X₂ c F U hh0 hh1 hXb hε hX1 hX12 hc hPR hcF
  have hPR0 := hPR
  obtain ⟨smF, smU, -, bdd, intF, -⟩ := hPR
  have hX2 : 0 < X₂ := lt_of_lt_of_le hX1 hX12
  have hΩ : IsOpen (Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo

  have hs1 : ∀ g : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿g) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
      ∀ X e : ℝ, -ε < X → -1 < e → e < 1 →
      DifferentiableAt ℝ (fun t => g X t) e ∧ |g X e| ≤ ‖iteratedFDeriv ℝ 0 (↿g) (X, e)‖ ∧
      |deriv (fun t => g X t) e| ≤ ‖iteratedFDeriv ℝ 1 (↿g) (X, e)‖ := by
    intro g hg X e hX he1 he2
    have h1 : ContDiffAt ℝ ∞ (↿g) (X, e) := hg.contDiffAt (hΩ.mem_nhds ⟨hX, he1, he2⟩)
    have hd : DifferentiableAt ℝ (↿g) (X, e) := h1.differentiableAt (by simp)
    have hcv : HasDerivAt (fun t : ℝ => (X, t)) ((0:ℝ), (1:ℝ)) e :=
      (hasDerivAt_const e X).prodMk (hasDerivAt_id' e)
    have hcomp : HasDerivAt (fun t => g X t) (fderiv ℝ (↿g) (X, e) ((0:ℝ), (1:ℝ))) e :=
      hd.hasFDerivAt.comp_hasDerivAt e hcv
    refine ⟨hcomp.differentiableAt, ?_, ?_⟩
    · rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs]
      exact le_rfl
    · rw [hcomp.deriv, norm_iteratedFDeriv_one, ← Real.norm_eq_abs]
      calc ‖fderiv ℝ (↿g) (X, e) ((0:ℝ), (1:ℝ))‖
          ≤ ‖fderiv ℝ (↿g) (X, e)‖ * ‖((0:ℝ), (1:ℝ))‖ := ContinuousLinearMap.le_opNorm _ _
        _ = ‖fderiv ℝ (↿g) (X, e)‖ := by simp [Prod.norm_def]

  obtain ⟨C0, hC0⟩ := bdd X₂ 0
  obtain ⟨C1, hC1⟩ := bdd X₂ 1
  obtain ⟨B, hB⟩ : ∃ B : ℝ, B = |C0| + |C1| := ⟨_, rfl⟩
  have hB0 : 0 ≤ B := by rw [hB]; positivity
  have hFB : ∀ X e : ℝ, 0 ≤ X → X ≤ X₂ → -1 < e → e < 1 →
      DifferentiableAt ℝ (fun t => F X t) e ∧ DifferentiableAt ℝ (fun t => U X t) e ∧
      |F X e| ≤ B ∧ |U X e| ≤ B ∧ |deriv (fun t => F X t) e| ≤ B ∧
      |deriv (fun t => U X t) e| ≤ B := by
    intro X e hX0 hXX he1 he2
    have hXe : -ε < X := by linarith
    obtain ⟨dF, vF, dF1⟩ := hs1 F smF X e hXe he1 he2
    obtain ⟨dU, vU, dU1⟩ := hs1 U smU X e hXe he1 he2
    obtain ⟨a0, b0⟩ := hC0 X e hX0 hXX he1 he2
    obtain ⟨a1, b1⟩ := hC1 X e hX0 hXX he1 he2
    have e0 := le_abs_self C0
    have e1 := le_abs_self C1
    have e2 := abs_nonneg C0
    have e3 := abs_nonneg C1
    refine ⟨dF, dU, by linarith, by linarith, by linarith, by linarith⟩

  obtain ⟨MP, hMP⟩ := pp_axis_datum_bounds h cinf Xb ε F U hh0 hXb hε hPR0

  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = (B + 1) * (1 + X₂) := ⟨_, rfl⟩
  obtain ⟨w, hw⟩ : ∃ w : ℝ, w = (1 + X₂)⁻¹ := ⟨_, rfl⟩
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = 16 * (K + 1) ^ 2 := ⟨_, rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : ℝ, Q = |MP| + A * (1 + X₂) + B := ⟨_, rfl⟩
  obtain ⟨D, hD⟩ : ∃ D : ℝ, D = A * (1 + X₂) / (B + 1) + 1 := ⟨_, rfl⟩
  have hX21 : 1 ≤ 1 + X₂ := by linarith
  have hX2ne : 1 + X₂ ≠ 0 := by linarith
  have hKw : K * w = B + 1 := by
    rw [hK, hw, mul_assoc, mul_inv_cancel₀ hX2ne, mul_one]
  have hBK : B + 1 ≤ K := by
    rw [hK]; nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ B + 1) hX2.le]
  have hK0 : 0 ≤ K := by linarith
  have hw0 : 0 < w := by rw [hw]; exact inv_pos.mpr (by linarith)
  have hw1 : w ≤ 1 := by rw [hw]; exact inv_le_one_of_one_le₀ hX21
  have hyw : ∀ y : ℝ, 0 < y → y ≤ X₂ → y * w ≤ 1 := by
    intro y hy hyX
    rw [hw, ← div_eq_mul_inv, div_le_one (by linarith)]
    linarith
  have hyw2 : ∀ y : ℝ, 0 < y → y ≤ X₂ → y * w ^ 2 ≤ 1 := by
    intro y hy hyX
    have h1 := hyw y hy hyX
    have h2 : y * w ^ 2 = (y * w) * w := by ring
    rw [h2]
    calc (y * w) * w ≤ 1 * 1 := mul_le_mul h1 hw1 hw0.le zero_le_one
      _ = 1 := by ring
  have hA0 : 0 ≤ A := by rw [hA]; positivity
  have hA1 : 1 ≤ A := by rw [hA]; nlinarith [sq_nonneg K]
  have hAw2 : A * w ^ 2 ≤ A := mul_le_of_le_one_right hA0 (pow_le_one₀ hw0.le hw1)
  have hAX : 0 ≤ A * (1 + X₂) := mul_nonneg hA0 (by linarith)
  have hAA : A ≤ A * (1 + X₂) := le_mul_of_one_le_right hA0 hX21
  have hMP0 := abs_nonneg MP
  have hMP1 := le_abs_self MP
  have hQA : A * (1 + X₂) ≤ Q := by rw [hQ]; linarith
  have hQB : B ≤ Q := by rw [hQ]; linarith
  have hQ0 : 0 < Q := by linarith
  have hB1 : 0 < B + 1 := by linarith
  have hD1 : 1 ≤ D := by
    rw [hD]
    have : 0 ≤ A * (1 + X₂) / (B + 1) := div_nonneg hAX hB1.le
    linarith
  have hD0 : 0 < D := by linarith
  have hc2 : 0 < c / 2 := by linarith
  obtain ⟨L1, hL1⟩ := cone_alg_ps1 h (c / 2) Q X₁ X₂ hh0 hh1 hc2 hX1 hX12
  obtain ⟨L2, hL2⟩ := cone_alg_ps2 h (c / 2) Q X₁ X₂ hh0 hh1 hc2 hX1 hX12
  refine ⟨(|L1| + |L2|) * D, min 1 (min (c / 2) (Q / D)),
    lt_min one_pos (lt_min hc2 (div_pos hQ0 hD0)), ?_⟩

  intro F' U' δ hPR' hδ hax hW x η hx1 hx2 hη1 hη2
  obtain ⟨smF', smU', -, -, intF', -⟩ := hPR'
  have hδ0 : 0 ≤ δ :=
    le_trans (abs_nonneg _) (hW 0 0 le_rfl hX2.le (by norm_num) (by norm_num)).1
  have hδQ : δ ≤ Q / D := hδ.trans ((min_le_right _ _).trans (min_le_right _ _))
  have hδc : δ ≤ c / 2 := hδ.trans ((min_le_right _ _).trans (min_le_left _ _))
  have hδ1 : δ ≤ 1 := hδ.trans (min_le_left _ _)
  have hx0 : 0 < x := lt_of_lt_of_le hX1 hx1
  obtain ⟨es, hes⟩ : ∃ es : ℝ, es = δ / (B + 1) := ⟨_, rfl⟩
  have hes0 : 0 ≤ es := by rw [hes]; exact div_nonneg hδ0 hB1.le
  have hes1 : es ≤ 1 := by rw [hes, div_le_one hB1]; linarith
  have hesB : es * (B + 1) = δ := by rw [hes]; field_simp
  have hesK : δ ≤ es * K := by rw [← hesB]; exact mul_le_mul_of_nonneg_left hBK hes0
  have hesKw : δ ≤ es * (K * w) := le_of_eq (by rw [hKw, hesB])
  have hδD : δ ≤ D * δ := le_mul_of_one_le_left hδ0 hD1
  have hDQ : D * δ ≤ Q := by
    calc D * δ ≤ D * (Q / D) := mul_le_mul_of_nonneg_left hδQ hD0.le
      _ = Q := by field_simp
  have hDδ0 : 0 ≤ D * δ := mul_nonneg hD0.le hδ0
  have hesA : ∀ t : ℝ, 0 ≤ t → t ≤ 1 + X₂ → es * (A * t) ≤ D * δ := by
    intro t ht0 ht1
    have e1 : es * (A * (1 + X₂)) + δ = D * δ := by
      rw [hD, ← hesB]; field_simp
    have e2 : es * (A * t) ≤ es * (A * (1 + X₂)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left ht1 hA0) hes0
    linarith

  have hW8 : ∀ y e : ℝ, 0 < y → y ≤ X₂ → -1 < e → e < 1 →
      DifferentiableAt ℝ (fun t => F y t) e ∧ DifferentiableAt ℝ (fun t => U y t) e ∧
      DifferentiableAt ℝ (fun t => F' y t) e ∧ DifferentiableAt ℝ (fun t => U' y t) e ∧
      |F y e| ≤ K * w ∧ |deriv (fun t => F y t) e| ≤ K * w ∧ |U y e| ≤ K ∧
      |deriv (fun t => U y t) e| ≤ K ∧
      |F' y e - F y e| ≤ es * (K * w) ∧ |deriv (fun t => F' y t - F y t) e| ≤ es * (K * w) ∧
      |U' y e - U y e| ≤ es * K ∧ |deriv (fun t => U' y t - U y t) e| ≤ es * K := by
    intro y e hy hyX he1 he2
    obtain ⟨dF, dU, vF, vU, vF1, vU1⟩ := hFB y e hy.le hyX he1 he2
    have hye : -ε < y := by linarith
    have dF' := (hs1 F' smF' y e hye he1 he2).1
    have dU' := (hs1 U' smU' y e hye he1 he2).1
    obtain ⟨w1, w2, w3, w4⟩ := hW y e hy.le hyX he1 he2
    have hBKw : B ≤ K * w := by rw [hKw]; linarith
    have hBK' : B ≤ K := by linarith
    refine ⟨dF, dU, dF', dU', vF.trans hBKw, vF1.trans hBKw, vU.trans hBK', vU1.trans hBK',
      w1.trans hesKw, ?_, w2.trans hesK, ?_⟩
    · rw [deriv_fun_sub dF' dF]; exact w3.trans hesKw
    · rw [deriv_fun_sub dU' dU]; exact w4.trans hesK
  have hslice := fun (y e : ℝ) (hy : 0 < y) (hyX : y ≤ X₂) (he1 : -1 < e) (he2 : e < 1) =>
    slice_integrand_bounds (fun t => F y t) (fun t => U y t) (fun t => F' y t) (fun t => U' y t)
      y e K es w hy hes0 hes1 hw0.le (hyw y hy hyX) (hyw2 y hy hyX)
      (hW8 y e hy hyX he1 he2).1 (hW8 y e hy hyX he1 he2).2.1
      (hW8 y e hy hyX he1 he2).2.2.1 (hW8 y e hy hyX he1 he2).2.2.2.1
      (hW8 y e hy hyX he1 he2).2.2.2.2.1 (hW8 y e hy hyX he1 he2).2.2.2.2.2.1
      (hW8 y e hy hyX he1 he2).2.2.2.2.2.2.1 (hW8 y e hy hyX he1 he2).2.2.2.2.2.2.2.1
      (hW8 y e hy hyX he1 he2).2.2.2.2.2.2.2.2.1 (hW8 y e hy hyX he1 he2).2.2.2.2.2.2.2.2.2.1
      (hW8 y e hy hyX he1 he2).2.2.2.2.2.2.2.2.2.2.1
      (hW8 y e hy hyX he1 he2).2.2.2.2.2.2.2.2.2.2.2

  have hsub : Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi (-ε) ×ˢ Ioo (-1) 1 :=
    prod_mono (Ioi_subset_Ioi (by linarith)) subset_rfl
  have F0 := smF.mono hsub
  have U0 := smU.mono hsub
  have F0' := smF'.mono hsub
  have U0' := smU'.mono hsub
  have sm1 : ∀ P : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿P) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿(fun (y e : ℝ) => 2 * y * P y e)) (Ioi 0 ×ˢ Ioo (-1) 1) :=
    fun P hP => (contDiffOn_const.mul contDiffOn_fst).mul hP
  have sm2 : ∀ P R : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿P) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿R) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿(fun (y e : ℝ) => R y e * (2 * y * P y e))) (Ioi 0 ×ˢ Ioo (-1) 1) :=
    fun P R hP hR => hR.mul ((contDiffOn_const.mul contDiffOn_fst).mul hP)
  have sm3 : ∀ P R : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿P) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿R) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿(fun (y e : ℝ) => R y e ^ 2 - y * P y e ^ 2)) (Ioi 0 ×ˢ Ioo (-1) 1) :=
    fun P R hP hR => (hR.pow 2).sub (contDiffOn_fst.mul (hP.pow 2))
  have sm4 : ∀ P : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿P) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿(fun (y e : ℝ) => P y e ^ 2)) (Ioi 0 ×ˢ Ioo (-1) 1) :=
    fun P hP => hP.pow 2
  have smavg : ∀ P : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿P) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿(fun (s e : ℝ) => P (s * x) e)) (Ioi 0 ×ˢ Ioo (-1) 1) := by
    intro P hP
    have hm : ContDiff ℝ ∞ (fun p : ℝ × ℝ => (p.1 * x, p.2)) :=
      (contDiff_fst.mul contDiff_const).prodMk contDiff_snd
    exact hP.comp hm.contDiffOn (fun p hp => ⟨mul_pos hp.1 hx0, hp.2⟩)

  have hAx : A * x ≤ Q := (mul_le_mul_of_nonneg_left (by linarith : x ≤ 1 + X₂) hA0).trans hQA
  have hA1Q : A * 1 ≤ Q := by rw [mul_one]; exact hAA.trans hQA
  have hMPQ : MP + A * x ≤ Q := by
    have : A * x ≤ A * (1 + X₂) := mul_le_mul_of_nonneg_left (by linarith) hA0
    rw [hQ]; linarith
  have hdA : es * (A * x) ≤ D * δ := hesA x hx0.le (by linarith)
  have hdA1 : es * (A * 1) ≤ D * δ := hesA 1 zero_le_one hX21

  obtain ⟨a1, a2, a3, a4⟩ := radint_pair_bound (fun s e => U (s * x) e) (fun s e => U' (s * x) e)
    1 A es one_pos hA0 hes0 (smavg U U0) (smavg U' U0')
    (fun s e hs hs1 he1 he2 => by
      have hsx : s * x ≤ X₂ := (mul_le_of_le_one_left hx0.le hs1).trans hx2
      have := (hslice (s * x) e (mul_pos hs hx0) hsx he1 he2).1
      rw [← hA] at this
      exact this) η hη1 hη2

  obtain ⟨b1, b2, b3, b4⟩ := radint_pair_bound (fun y e => 2 * y * F y e)
    (fun y e => 2 * y * F' y e) x A es hx0 hA0 hes0 (sm1 F F0) (sm1 F' F0')
    (fun y e hy hyx he1 he2 => by
      have := (hslice y e hy (hyx.trans hx2) he1 he2).2.1
      rw [← hA] at this
      exact this) η hη1 hη2

  obtain ⟨c1, c2, c3, c4⟩ := radint_pair_bound (fun y e => U y e * (2 * y * F y e))
    (fun y e => U' y e * (2 * y * F' y e)) x A es hx0 hA0 hes0 (sm2 F U F0 U0) (sm2 F' U' F0' U0')
    (fun y e hy hyx he1 he2 => by
      have := (hslice y e hy (hyx.trans hx2) he1 he2).2.2.1
      rw [← hA] at this
      exact this) η hη1 hη2

  obtain ⟨d1, d2, d3, d4⟩ := radint_pair_bound U U' x A es hx0 hA0 hes0 U0 U0'
    (fun y e hy hyx he1 he2 => by
      have := (hslice y e hy (hyx.trans hx2) he1 he2).1
      rw [← hA] at this
      exact this) η hη1 hη2

  obtain ⟨e1, e2, e3, e4⟩ := radint_pair_bound (fun y e => U y e ^ 2 - y * F y e ^ 2)
    (fun y e => U' y e ^ 2 - y * F' y e ^ 2) x A es hx0 hA0 hes0 (sm3 F U F0 U0) (sm3 F' U' F0' U0')
    (fun y e hy hyx he1 he2 => by
      have := (hslice y e hy (hyx.trans hx2) he1 he2).2.2.2.1
      rw [← hA] at this
      exact this) η hη1 hη2

  have R6 := radint_pair_bound (fun y e => F y e ^ 2) (fun y e => F' y e ^ 2) x A es hx0 hA0 hes0
    (sm4 F F0) (sm4 F' F0')
    (fun y e hy hyx he1 he2 => by
      have := (hslice y e hy (hyx.trans hx2) he1 he2).2.2.2.2
      rw [← hA] at this
      obtain ⟨q1, q2, q3, q4⟩ := this
      exact ⟨q1.trans hAw2, q2.trans hAw2, q3.trans (mul_le_mul_of_nonneg_left hAw2 hes0),
        q4.trans (mul_le_mul_of_nonneg_left hAw2 hes0)⟩)

  obtain ⟨p1, p2, p3, p4⟩ := pp_leadPi_pair F F' ε x MP (A * x) (es * (A * x)) hε hx0 smF smF'
    (fun e he1 he2 => ⟨intF e he1 he2, intF' e he1 he2, hax e he1 he2, (hMP e he1 he2).1,
      (hMP e he1 he2).2⟩) R6 η hη1 hη2

  obtain ⟨hwF, hwU, -, -⟩ := hW x η hx0.le hx2 hη1 hη2
  have hcF0 : c ≤ F x η := hcF x η hx1 hx2 hη1 hη2
  have hcf : c / 2 ≤ F x η := by linarith
  have hcf' : c / 2 ≤ F' x η := by
    have := (abs_le.mp hwF).1
    linarith
  have hu : |U x η| ≤ Q := (hFB x η hx0.le hx2 hη1 hη2).2.2.2.1.trans hQB

  have r3 := hL1 x η (D * δ) (F x η) (profRadAvg U x η) (profEtaD (profRadAvg U) x η)
    (profRadInt (fun y e => 2 * y * F y e) x η)
    (profEtaD (profRadInt (fun y e => 2 * y * F y e)) x η)
    (profRadInt (fun y e => U y e * (2 * y * F y e)) x η)
    (profEtaD (profRadInt (fun y e => U y e * (2 * y * F y e))) x η)
    (F' x η) (profRadAvg U' x η) (profEtaD (profRadAvg U') x η)
    (profRadInt (fun y e => 2 * y * F' y e) x η)
    (profEtaD (profRadInt (fun y e => 2 * y * F' y e)) x η)
    (profRadInt (fun y e => U' y e * (2 * y * F' y e)) x η)
    (profEtaD (profRadInt (fun y e => U' y e * (2 * y * F' y e))) x η)
    hx1 hx2 hη1 hη2 hDδ0 hcf hcf' (b1.trans hAx) (b2.trans hAx) (c1.trans hAx) (c2.trans hAx)
    (hwF.trans hδD) (a3.trans hdA1) (a4.trans hdA1) (b3.trans hdA) (b4.trans hdA)
    (c3.trans hdA) (c4.trans hdA)
  have r4 := hL2 x η (D * δ) (F x η) (U x η) (profRadAvg U x η) (profEtaD (profRadAvg U) x η)
    (profRadInt U x η) (profEtaD (profRadInt U) x η)
    (profRadInt (fun y e => U y e ^ 2 - y * F y e ^ 2) x η)
    (profEtaD (profRadInt (fun y e => U y e ^ 2 - y * F y e ^ 2)) x η)
    (leadPi F x η) (profEtaD (leadPi F) x η)
    (F' x η) (U' x η) (profRadAvg U' x η) (profEtaD (profRadAvg U') x η)
    (profRadInt U' x η) (profEtaD (profRadInt U') x η)
    (profRadInt (fun y e => U' y e ^ 2 - y * F' y e ^ 2) x η)
    (profEtaD (profRadInt (fun y e => U' y e ^ 2 - y * F' y e ^ 2)) x η)
    (leadPi F' x η) (profEtaD (leadPi F') x η)
    hx1 hx2 hη1 hη2 hDδ0 hDQ hcf hcf' hu (a1.trans hA1Q) (a2.trans hA1Q) (d1.trans hAx)
    (d2.trans hAx) (e1.trans hAx) (e2.trans hAx) (p1.trans hMPQ) (p2.trans hMPQ)
    (hwF.trans hδD) (hwU.trans hδD) (a3.trans hdA1) (a4.trans hdA1) (d3.trans hdA)
    (d4.trans hdA) (e3.trans hdA) (e4.trans hdA) (p3.trans hdA) (p4.trans hdA)
  have aL1 := abs_nonneg L1
  have aL2 := abs_nonneg L2
  have hfin : ∀ L : ℝ, |L| ≤ |L1| + |L2| → L * (D * δ) ≤ (|L1| + |L2|) * D * δ := by
    intro L hL
    have h1 : L * (D * δ) ≤ |L| * (D * δ) := mul_le_mul_of_nonneg_right (le_abs_self L) hDδ0
    have h2 : |L| * (D * δ) ≤ (|L1| + |L2|) * (D * δ) := mul_le_mul_of_nonneg_right hL hDδ0
    have h3 : (|L1| + |L2|) * (D * δ) = (|L1| + |L2|) * D * δ := by ring
    linarith
  exact ⟨r3.trans (hfin L1 (by linarith)), r4.trans (hfin L2 (by linarith))⟩

theorem cone_gap_quadratic : ConeGapQuadratic :=
by
  unfold ConeGapQuadratic

  have root : ∀ P J : ℝ, 2 ≤ P →
      0 ≤ P - coneUp P J ∧
      2 * (P - coneUp P J) ^ 2 + J ^ 2 * (P - coneUp P J) = (P - 2) * J ^ 2 := by
    intro P J hP
    have hS : 0 ≤ (P - 2) / 2 + J ^ 2 / 16 := by nlinarith [sq_nonneg J]
    obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = Real.sqrt ((P - 2) / 2 + J ^ 2 / 16) := ⟨_, rfl⟩
    have hR0 : 0 ≤ R := by rw [hRdef]; exact Real.sqrt_nonneg _
    have hR2 : R ^ 2 = (P - 2) / 2 + J ^ 2 / 16 := by rw [hRdef]; exact Real.sq_sqrt hS
    have ha0 : 0 ≤ |J| := abs_nonneg J
    have ha2 : |J| ^ 2 = J ^ 2 := sq_abs J
    have hu : P - coneUp P J = |J| * R - J ^ 2 / 4 := by
      unfold coneUp
      rw [← hRdef]
      ring
    have haR : |J| / 4 ≤ R := by
      by_contra hc
      push_neg at hc
      nlinarith [mul_self_lt_mul_self hR0 hc]
    refine ⟨?_, ?_⟩
    · rw [hu]
      have e : |J| * R - J ^ 2 / 4 = |J| * (R - |J| / 4) := by rw [← ha2]; ring
      rw [e]
      exact mul_nonneg ha0 (by linarith)
    · rw [hu]
      linear_combination (2 * |J| ^ 2) * hR2 + (P - 2 + J ^ 2 / 8) * ha2
  refine ⟨?_, ?_⟩
  ·
    intro κ W P J v hκ hP hv hW
    obtain ⟨hu0, hG⟩ := root P J (by linarith)
    obtain ⟨u, hudef⟩ : ∃ u : ℝ, u = P - coneUp P J := ⟨_, rfl⟩
    rw [← hudef] at hu0 hG
    have hcone : coneUp P J = P - u := by linarith
    rw [hcone] at hv
    obtain ⟨w, hwdef⟩ : ∃ w : ℝ, w = P - v := ⟨_, rfl⟩
    have hvw : v = P - w := by linarith
    subst hvw
    have e : P - (P - w) = w := by ring
    rw [e] at hW ⊢
    have hwu : κ ≤ w - u := by linarith
    have hwpos : 0 < w := by linarith
    have hW0 : 0 < W := by linarith
    refine ⟨by linarith, ?_⟩
    have hθ : min 1 (2 * κ ^ 2 / W ^ 2) ≤ 2 * κ ^ 2 / W ^ 2 := min_le_right _ _
    have hwW2 : w ^ 2 ≤ W ^ 2 := pow_le_pow_left₀ hwpos.le hW 2
    have h1 : 2 * κ ^ 2 / W ^ 2 * w ^ 2 ≤ 2 * κ ^ 2 := by
      rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
      nlinarith [sq_nonneg κ]
    have h2 : min 1 (2 * κ ^ 2 / W ^ 2) * w ^ 2 ≤ 2 * κ ^ 2 / W ^ 2 * w ^ 2 :=
      mul_le_mul_of_nonneg_right hθ (sq_nonneg w)
    have hD : 2 * w ≤ 2 * w + 2 * u + J ^ 2 := by nlinarith [sq_nonneg J]
    have h3 : κ * (2 * w) ≤ (w - u) * (2 * w + 2 * u + J ^ 2) :=
      mul_le_mul hwu hD (by linarith) (by linarith)
    have h4 : 2 * κ ^ 2 ≤ κ * (2 * w) := by nlinarith
    have key : (2 - min 1 (2 * κ ^ 2 / W ^ 2)) * w ^ 2 - (P - w - 2) * J ^ 2 =
        (w - u) * (2 * w + 2 * u + J ^ 2) - min 1 (2 * κ ^ 2 / W ^ 2) * w ^ 2 := by
      linear_combination hG
    linarith
  ·
    intro κ W P J v hκ _hκ2 hP hw hconeq hW hJ
    obtain ⟨hu0, hG⟩ := root P J hP
    obtain ⟨u, hudef⟩ : ∃ u : ℝ, u = P - coneUp P J := ⟨_, rfl⟩
    rw [← hudef] at hu0 hG
    have hcone : coneUp P J = P - u := by linarith
    rw [hcone]
    obtain ⟨w, hwdef⟩ : ∃ w : ℝ, w = P - v := ⟨_, rfl⟩
    have hvw : v = P - w := by linarith
    subst hvw
    have e : P - (P - w) = w := by ring
    rw [e] at hW hw hconeq
    have hwpos : 0 < w := by linarith
    have hW0 : 0 < W := by linarith
    have key : (2 - κ) * w ^ 2 - (P - w - 2) * J ^ 2 =
        (w - u) * (2 * w + 2 * u + J ^ 2) - κ * w ^ 2 := by
      linear_combination hG
    have hGw : κ * w ^ 2 ≤ (w - u) * (2 * w + 2 * u + J ^ 2) := by linarith
    have hkw : 0 < κ * w ^ 2 := by positivity
    have hD : 2 * w ≤ 2 * w + 2 * u + J ^ 2 := by nlinarith [sq_nonneg J]
    have hwu : 0 < w - u := by
      by_contra hc
      push_neg at hc
      have : (w - u) * (2 * w + 2 * u + J ^ 2) ≤ 0 :=
        mul_nonpos_of_nonpos_of_nonneg hc (by linarith)
      linarith
    have hJ2 : J ^ 2 ≤ W ^ 2 := by
      have := pow_le_pow_left₀ (abs_nonneg J) hJ 2
      rwa [sq_abs] at this
    have hE : 2 * w + 2 * u + J ^ 2 ≤ 4 * W + W ^ 2 := by linarith
    have hE0 : 0 < 4 * W + W ^ 2 := by positivity
    have h5 : (w - u) * (2 * w + 2 * u + J ^ 2) ≤ (w - u) * (4 * W + W ^ 2) :=
      mul_le_mul_of_nonneg_left hE hwu.le
    have h6 : κ * κ ^ 2 ≤ κ * w ^ 2 :=
      mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hκ.le hw 2) hκ.le
    rw [div_le_iff₀ hE0]
    have e2 : P - u - (P - w) = w - u := by ring
    rw [e2]
    nlinarith

theorem periodic_primitive_smooth : ∀ (V : Set (ℝ × ℝ × ℝ × ℝ)) (g : ℝ × ℝ × ℝ × ℝ → ℝ → ℝ), IsOpen V → ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => g z.1 z.2) (V ×ˢ univ) → (∀ p ∈ V, ∀ s : ℝ, g p (s + 1) = g p s) → (∀ p ∈ V, (∫ s in (0:ℝ)..1, g p s) = 0) → ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => ∫ s in (0:ℝ)..z.2, g z.1 s) (V ×ˢ univ) ∧ (∀ p ∈ V, ∀ φ : ℝ, HasDerivAt (fun ψ => ∫ s in (0:ℝ)..ψ, g p s) (g p φ) φ) ∧ ∀ K : Set (ℝ × ℝ × ℝ × ℝ), IsCompact K → K ⊆ V → ∀ m : ℕ, ∃ C : ℝ, ∀ p ∈ K, ∀ φ : ℝ, ‖iteratedFDeriv ℝ m (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => ∫ s in (0:ℝ)..z.2, g z.1 s) (p, φ)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => g z.1 z.2) (p, φ)‖ ≤ C :=
by
  intro V g hV hG hper hmean
  have hO : IsOpen (V ×ˢ (univ : Set ℝ)) := hV.prod isOpen_univ
  have hOO : IsOpen ((V ×ˢ (univ : Set ℝ)) ×ˢ (univ : Set ℝ)) := hO.prod isOpen_univ

  have hsm' : ∀ (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] (H : ((ℝ × ℝ × ℝ × ℝ) × ℝ) × ℝ → F),
      ContDiffOn ℝ ∞ H ((V ×ˢ (univ : Set ℝ)) ×ˢ (univ : Set ℝ)) →
      ContDiffOn ℝ ∞ (fun w => (fderiv ℝ H w).comp
        (ContinuousLinearMap.inl ℝ ((ℝ × ℝ × ℝ × ℝ) × ℝ) ℝ)) ((V ×ˢ (univ : Set ℝ)) ×ˢ (univ : Set ℝ)) := by
    intro F _ _ H hH
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ H) ((V ×ˢ (univ : Set ℝ)) ×ˢ (univ : Set ℝ)) :=
      hH.fderiv_of_isOpen hOO (by simp)
    exact h1.clm_comp contDiffOn_const

  have hderiv : ∀ (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (H : ((ℝ × ℝ × ℝ × ℝ) × ℝ) × ℝ → F),
      ContDiffOn ℝ ∞ H ((V ×ˢ (univ : Set ℝ)) ×ˢ (univ : Set ℝ)) →
      ∀ x₀ ∈ V ×ˢ (univ : Set ℝ), HasFDerivAt (fun x => ∫ t in (0:ℝ)..1, H (x, t))
        (∫ t in (0:ℝ)..1, (fderiv ℝ H (x₀, t)).comp
          (ContinuousLinearMap.inl ℝ ((ℝ × ℝ × ℝ × ℝ) × ℝ) ℝ)) x₀ := by
    intro F _ _ _ H hH x₀ hx₀
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hO x₀ hx₀
    have hsub : Metric.closedBall x₀ (ε / 2) ⊆ V ×ˢ (univ : Set ℝ) :=
      (Metric.closedBall_subset_ball (half_lt_self hε)).trans hball
    have hS : IsCompact (Metric.closedBall x₀ (ε / 2) ×ˢ Icc (0:ℝ) 1) :=
      (isCompact_closedBall _ _).prod isCompact_Icc
    have hH' := hsm' F H hH
    obtain ⟨C, hC⟩ := hS.exists_bound_of_continuousOn
      (hH'.continuousOn.mono (fun w hw => ⟨hsub hw.1, mem_univ _⟩))
    have hcont : ∀ x ∈ V ×ˢ (univ : Set ℝ), Continuous (fun t : ℝ => H (x, t)) := fun x hx =>
      hH.continuousOn.comp_continuous (continuous_const.prodMk continuous_id)
        (fun t => ⟨hx, mem_univ t⟩)
    have hcont' : ∀ x ∈ V ×ˢ (univ : Set ℝ), Continuous (fun t : ℝ => (fderiv ℝ H (x, t)).comp
        (ContinuousLinearMap.inl ℝ ((ℝ × ℝ × ℝ × ℝ) × ℝ) ℝ)) := fun x hx =>
      hH'.continuousOn.comp_continuous (continuous_const.prodMk continuous_id)
        (fun t => ⟨hx, mem_univ t⟩)
    have hdiff : ∀ x ∈ V ×ˢ (univ : Set ℝ), ∀ t : ℝ, HasFDerivAt (fun y => H (y, t))
        ((fderiv ℝ H (x, t)).comp (ContinuousLinearMap.inl ℝ ((ℝ × ℝ × ℝ × ℝ) × ℝ) ℝ)) x := by
      intro x hx t
      have hd : DifferentiableAt ℝ H (x, t) :=
        (hH.differentiableOn (by simp)).differentiableAt (hOO.mem_nhds ⟨hx, mem_univ t⟩)
      exact hd.hasFDerivAt.comp x (hasFDerivAt_prodMk_left x t)
    refine intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := volume)
      (E := F) (H := (ℝ × ℝ × ℝ × ℝ) × ℝ) (F := fun x t => H (x, t))
      (F' := fun x t => (fderiv ℝ H (x, t)).comp
        (ContinuousLinearMap.inl ℝ ((ℝ × ℝ × ℝ × ℝ) × ℝ) ℝ))
      (bound := fun _ => C)
      (Metric.closedBall_mem_nhds x₀ (half_pos hε)) ?_ ?_ ?_ ?_ intervalIntegrable_const ?_
    · filter_upwards [hO.mem_nhds hx₀] with x hx
      exact (hcont x hx).aestronglyMeasurable
    · exact (hcont x₀ hx₀).intervalIntegrable 0 1
    · exact (hcont' x₀ hx₀).aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun t ht x hx => hC (x, t) ⟨hx, ?_⟩)
      rw [uIoc_of_le zero_le_one] at ht
      exact Ioc_subset_Icc_self ht
    · exact Filter.Eventually.of_forall (fun t _ x hx => hdiff x (hsub hx) t)

  have hcomp : ∀ (E F : Type) [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F]
      [NormedSpace ℝ F] [CompleteSpace F], CompleteSpace (E →L[ℝ] F) :=
    fun _ _ _ _ _ _ _ => inferInstance
  have key : ∀ n : ℕ, ∀ (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (H : ((ℝ × ℝ × ℝ × ℝ) × ℝ) × ℝ → F),
      ContDiffOn ℝ ∞ H ((V ×ˢ (univ : Set ℝ)) ×ˢ (univ : Set ℝ)) →
      ContDiffOn ℝ n (fun x => ∫ t in (0:ℝ)..1, H (x, t)) (V ×ˢ (univ : Set ℝ)) := by
    intro n
    induction n with
    | zero =>
      intro F _ _ _ H hH
      rw [Nat.cast_zero, contDiffOn_zero]
      exact fun x hx => (hderiv F H hH x hx).continuousAt.continuousWithinAt
    | succ k ih =>
      intro F _ _ _ H hH
      have e : ((k + 1 : ℕ) : WithTop ℕ∞) = (k : WithTop ℕ∞) + 1 := by push_cast; rfl
      rw [e, contDiffOn_succ_iff_fderiv_of_isOpen hO]
      refine ⟨fun x hx => (hderiv F H hH x hx).differentiableAt.differentiableWithinAt,
        fun h => absurd h (by simp), ?_⟩
      haveI : CompleteSpace ((ℝ × ℝ × ℝ × ℝ) × ℝ →L[ℝ] F) := hcomp _ F
      exact (ih ((ℝ × ℝ × ℝ × ℝ) × ℝ →L[ℝ] F) _ (hsm' F H hH)).congr
        (fun x hx => (hderiv F H hH x hx).fderiv)

  have hgc : ∀ p ∈ V, Continuous (g p) := fun p hp =>
    hG.continuousOn.comp_continuous (continuous_const.prodMk continuous_id)
      (fun s => ⟨hp, mem_univ s⟩)

  have hQper : ∀ p ∈ V, ∀ φ : ℝ, (∫ s in (0:ℝ)..(φ + 1), g p s) = ∫ s in (0:ℝ)..φ, g p s := by
    intro p hp φ
    rw [← intervalIntegral.integral_add_adjacent_intervals ((hgc p hp).intervalIntegrable 0 φ)
      ((hgc p hp).intervalIntegrable φ (φ + 1))]
    have h1 : (∫ s in φ..(φ + 1), g p s) = ∫ s in (0:ℝ)..(0 + 1), g p s :=
      Function.Periodic.intervalIntegral_add_eq (hper p hp) φ 0
    rw [h1, zero_add, hmean p hp, add_zero]

  have hstar : (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => ∫ s in (0:ℝ)..z.2, g z.1 s) =
      fun z => z.2 * ∫ t in (0:ℝ)..1, g z.1 (z.2 * t) := by
    funext z
    have := intervalIntegral.smul_integral_comp_mul_left (a := 0) (b := 1) (g z.1) z.2
    rw [mul_zero, mul_one, smul_eq_mul] at this
    exact this.symm
  have hHs : ContDiffOn ℝ ∞ (fun w : ((ℝ × ℝ × ℝ × ℝ) × ℝ) × ℝ => g w.1.1 (w.1.2 * w.2))
      ((V ×ˢ (univ : Set ℝ)) ×ˢ (univ : Set ℝ)) := by
    have hψ : ContDiff ℝ ∞ (fun w : ((ℝ × ℝ × ℝ × ℝ) × ℝ) × ℝ => (w.1.1, w.1.2 * w.2)) := by
      fun_prop
    exact hG.comp hψ.contDiffOn (fun w hw => ⟨hw.1.1, mem_univ _⟩)
  have hI : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => ∫ t in (0:ℝ)..1, g z.1 (z.2 * t))
      (V ×ˢ (univ : Set ℝ)) :=
    contDiffOn_infty.mpr (fun n => key n ℝ _ hHs)
  have hQs : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => ∫ s in (0:ℝ)..z.2, g z.1 s)
      (V ×ˢ univ) := by
    rw [hstar]
    exact contDiff_snd.contDiffOn.mul hI

  have hbound : ∀ F : (ℝ × ℝ × ℝ × ℝ) × ℝ → ℝ, ContDiffOn ℝ ∞ F (V ×ˢ univ) →
      (∀ p ∈ V, ∀ φ : ℝ, F (p, φ + 1) = F (p, φ)) → ∀ K : Set (ℝ × ℝ × ℝ × ℝ), IsCompact K →
      K ⊆ V → ∀ m : ℕ, ∃ C : ℝ, ∀ p ∈ K, ∀ φ : ℝ, ‖iteratedFDeriv ℝ m F (p, φ)‖ ≤ C := by
    intro F hF hFp K hK hKV m
    have hc : ContinuousOn (iteratedFDeriv ℝ m F) (V ×ˢ univ) :=
      (hF.continuousOn_iteratedFDerivWithin (by exact_mod_cast le_top) hO.uniqueDiffOn).congr
        (fun w hw => (iteratedFDerivWithin_of_isOpen m hO hw).symm)
    obtain ⟨C, hC⟩ := (hK.prod (isCompact_Icc (a := (0:ℝ)) (b := 1))).exists_bound_of_continuousOn
      (hc.mono (fun w hw => ⟨hKV hw.1, mem_univ _⟩))
    have htr : ∀ p ∈ V, ∀ φ : ℝ,
        iteratedFDeriv ℝ m F (p, φ + 1) = iteratedFDeriv ℝ m F (p, φ) := by
      intro p hp φ
      have e1 := iteratedFDeriv_comp_add_right (𝕜 := ℝ) (f := F) m
        ((0 : ℝ × ℝ × ℝ × ℝ), (1:ℝ)) (p, φ)
      have e2 : ((p, φ) : (ℝ × ℝ × ℝ × ℝ) × ℝ) + ((0 : ℝ × ℝ × ℝ × ℝ), (1:ℝ)) = (p, φ + 1) := by
        simp
      rw [e2] at e1
      rw [← e1]
      have hev : (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => F (z + ((0 : ℝ × ℝ × ℝ × ℝ), (1:ℝ))))
          =ᶠ[nhds (p, φ)] F := by
        filter_upwards [hO.mem_nhds (show ((p, φ) : (ℝ × ℝ × ℝ × ℝ) × ℝ) ∈ V ×ˢ univ from
          ⟨hp, mem_univ _⟩)] with z hz
        have hz2 : z + ((0 : ℝ × ℝ × ℝ × ℝ), (1:ℝ)) = (z.1, z.2 + 1) :=
          Prod.ext (by simp) (by simp)
        rw [hz2, hFp z.1 hz.1 z.2]
      exact (hev.iteratedFDeriv ℝ m).eq_of_nhds
    refine ⟨C, fun p hp φ => ?_⟩
    obtain ⟨y, hy, hφy⟩ := Function.Periodic.exists_mem_Ico₀
      (f := fun φ => iteratedFDeriv ℝ m F (p, φ)) (c := (1:ℝ))
      (fun φ => htr p (hKV hp) φ) one_pos φ
    have hφy' : iteratedFDeriv ℝ m F (p, φ) = iteratedFDeriv ℝ m F (p, y) := hφy
    rw [hφy']
    exact hC (p, y) ⟨hp, Ico_subset_Icc_self hy⟩
  refine ⟨hQs, fun p hp φ => ((hgc p hp).integral_hasStrictDerivAt 0 φ).hasDerivAt, ?_⟩
  intro K hK hKV m
  obtain ⟨C1, hC1⟩ := hbound _ hQs (fun p hp φ => hQper p hp φ) K hK hKV m
  obtain ⟨C2, hC2⟩ := hbound _ hG (fun p hp φ => hper p hp φ) K hK hKV m
  exact ⟨max C1 C2, fun p hp φ =>
    ⟨(hC1 p hp φ).trans (le_max_left _ _), (hC2 p hp φ).trans (le_max_right _ _)⟩⟩

theorem shear_jet_bounds : ∀ (F U : ℝ → ℝ → ℝ) (X₁ X₂ c : ℝ), 0 < X₁ → 0 < c → ContDiffOn ℝ ∞ (↿F) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿U) (Ioi 0 ×ˢ Ioo (-1) 1) → (∀ X η : ℝ, 0 < X → -1 < η → η < 1 → 0 < F X η) → (∀ X η : ℝ, X₁ ≤ X → X ≤ X₂ → -1 < η → η < 1 → c ≤ F X η) → (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, X₁ ≤ X → X ≤ X₂ → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿F) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿U) (X, η)‖ ≤ C) → ContDiffOn ℝ ∞ (↿(shearA F)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(shearB F U)) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, X₁ ≤ X → X ≤ X₂ → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿(shearA F)) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(shearB F U)) (X, η)‖ ≤ C :=
by
  intro F U X₁ X₂ c hX₁ hc hFs hUs hFpos hFc hbd
  set Ω : Set (ℝ × ℝ) := Ioi 0 ×ˢ Ioo (-1) 1 with hΩdef
  set S : Set (ℝ × ℝ) := Icc X₁ X₂ ×ˢ Ioo (-1) 1 with hSdef
  have hΩ : IsOpen Ω := isOpen_Ioi.prod isOpen_Ioo
  have hSΩ : S ⊆ Ω := fun z hz => ⟨lt_of_lt_of_le hX₁ hz.1.1, hz.2⟩
  have hU' : UniqueDiffOn ℝ Ω := hΩ.uniqueDiffOn
  have hle : ∀ n : ℕ, (n : WithTop ℕ∞) ≤ ∞ := fun n => by exact_mod_cast le_top
  have hwin : ∀ (f : ℝ × ℝ → ℝ) (n : ℕ) (z : ℝ × ℝ), z ∈ Ω →
      iteratedFDeriv ℝ n f z = iteratedFDerivWithin ℝ n f Ω z :=
    fun f n z hz => (iteratedFDerivWithin_of_isOpen n hΩ hz).symm

  have hmul : ∀ f g : ℝ × ℝ → ℝ, axgeGood Ω S f → axgeGood Ω S g →
      axgeGood Ω S (fun z => f z * g z) := by
    intro f g hf hg
    refine ⟨hf.1.mul hg.1, ?_⟩
    choose Cf hCf using hf.2
    choose Cg hCg using hg.2
    intro n
    refine ⟨∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * Cf i * Cg (n - i), fun z hz => ?_⟩
    rw [hwin _ n z (hSΩ hz)]
    refine (norm_iteratedFDerivWithin_mul_le hf.1 hg.1 hU' (hSΩ hz) (hle n)).trans ?_
    refine Finset.sum_le_sum (fun i _ => ?_)
    have h1 := hCf i z hz
    have h2 := hCg (n - i) z hz
    rw [hwin f i z (hSΩ hz)] at h1
    rw [hwin g (n - i) z (hSΩ hz)] at h2
    exact mul_le_mul (mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg _)) h2 (norm_nonneg _)
      (mul_nonneg (Nat.cast_nonneg _) ((norm_nonneg _).trans h1))

  have hinv : ∀ f : ℝ × ℝ → ℝ, axgeGood Ω S f → (∀ z ∈ Ω, 0 < f z) → (∀ z ∈ S, c ≤ f z) →
      axgeGood Ω S (fun z => (f z)⁻¹) := by
    intro f hf hpos hcf
    refine ⟨hf.1.inv (fun z hz => (hpos z hz).ne'), ?_⟩
    choose Cf hCf using hf.2
    have hT : IsOpen (Ioi (0:ℝ)) := isOpen_Ioi
    have hinvT : ContDiffOn ℝ ∞ (Inv.inv : ℝ → ℝ) (Ioi 0) :=
      (contDiffOn_inv ℝ).mono (fun y (hy : (0:ℝ) < y) => (show y ≠ 0 from hy.ne'))
    have hJ : ∀ i : ℕ, ∃ B : ℝ, ∀ y ∈ Icc c (max c (Cf 0)),
        ‖iteratedFDerivWithin ℝ i (Inv.inv : ℝ → ℝ) (Ioi 0) y‖ ≤ B := by
      intro i
      have hcont := hinvT.continuousOn_iteratedFDerivWithin (hle i) hT.uniqueDiffOn
      exact isCompact_Icc.exists_bound_of_continuousOn
        (hcont.mono (fun y hy => (show (0:ℝ) < y from lt_of_lt_of_le hc hy.1)))
    choose B hB using hJ
    have hfS : ∀ z ∈ S, f z ∈ Icc c (max c (Cf 0)) := by
      intro z hz
      refine ⟨hcf z hz, le_max_of_le_right ?_⟩
      have := hCf 0 z hz
      rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at this
      exact (le_abs_self _).trans this
    intro n
    refine ⟨(n.factorial : ℝ) * (∑ i ∈ Finset.range (n + 1), |B i|) *
      (1 + ∑ i ∈ Finset.range (n + 1), |Cf i|) ^ n, fun z hz => ?_⟩
    have hzΩ := hSΩ hz
    rw [hwin _ n z hzΩ]
    show ‖iteratedFDerivWithin ℝ n ((Inv.inv : ℝ → ℝ) ∘ f) Ω z‖ ≤ _
    refine norm_iteratedFDerivWithin_comp_le hinvT hf.1 (hle n) hT.uniqueDiffOn hU'
      (fun w hw => hpos w hw) hzΩ ?_ ?_
    · intro i hi
      refine (hB i (f z) (hfS z hz)).trans ((le_abs_self _).trans ?_)
      exact Finset.single_le_sum (f := fun j => |B j|) (fun j _ => abs_nonneg _)
        (Finset.mem_range.2 (Nat.lt_succ_of_le hi))
    · intro i hi1 hin
      have hsum0 : 0 ≤ ∑ i ∈ Finset.range (n + 1), |Cf i| :=
        Finset.sum_nonneg (fun j _ => abs_nonneg _)
      have hD1 : 1 ≤ 1 + ∑ i ∈ Finset.range (n + 1), |Cf i| := by linarith
      have hci := hCf i z hz
      rw [hwin f i z hzΩ] at hci
      refine hci.trans ((le_abs_self _).trans ?_)
      refine le_trans ?_ (le_self_pow₀ hD1 (by omega))
      have : |Cf i| ≤ ∑ i ∈ Finset.range (n + 1), |Cf i| :=
        Finset.single_le_sum (f := fun j => |Cf j|) (fun j _ => abs_nonneg _)
          (Finset.mem_range.2 (Nat.lt_succ_of_le hin))
      linarith

  have hcoef : ∀ g : ℝ → ℝ, ContDiffOn ℝ ∞ g (Ioi 0) → axgeGood Ω S (fun z => g z.1) := by
    intro g hg
    have hGs : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ => g z.1) Ω :=
      hg.comp contDiffOn_fst (fun z hz => hz.1)
    refine ⟨hGs, fun n => ?_⟩
    have hcont : ContinuousOn (iteratedFDeriv ℝ n (fun z : ℝ × ℝ => g z.1)) Ω :=
      (hGs.continuousOn_iteratedFDerivWithin (hle n) hU').congr (fun z hz => hwin _ n z hz)
    have hK : IsCompact (Icc X₁ X₂ ×ˢ ({0} : Set ℝ)) := isCompact_Icc.prod isCompact_singleton
    have hKΩ : Icc X₁ X₂ ×ˢ ({0} : Set ℝ) ⊆ Ω := by
      rintro ⟨X, η⟩ ⟨hX, hη⟩
      have hη0 : η = 0 := hη
      subst hη0
      exact ⟨lt_of_lt_of_le hX₁ hX.1, by norm_num, by norm_num⟩
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn (hcont.mono hKΩ)
    refine ⟨C, ?_⟩
    rintro ⟨X, η⟩ ⟨hX, -⟩
    have htr := iteratedFDeriv_comp_add_right (𝕜 := ℝ) (f := fun z : ℝ × ℝ => g z.1) n
      ((0:ℝ), η) (X, (0:ℝ))
    have e1 : (fun z : ℝ × ℝ => g (z + ((0:ℝ), η)).1) = fun z => g z.1 := by
      funext z; simp
    have e2 : ((X, (0:ℝ)) + ((0:ℝ), η) : ℝ × ℝ) = (X, η) := by simp
    rw [e1, e2] at htr
    rw [← htr]
    exact hC _ ⟨hX, rfl⟩

  have hpart : ∀ G : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿G) Ω →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿G) z‖ ≤ C) →
      (∀ X η : ℝ, (X, η) ∈ Ω →
        deriv (fun Y => G Y η) X = fderiv ℝ (↿G) (X, η) ((1:ℝ), (0:ℝ))) ∧
      axgeGood Ω S (fun z => fderiv ℝ (↿G) z ((1:ℝ), (0:ℝ))) := by
    intro G hG hGb
    have hfd : ContDiffOn ℝ ∞ (fderiv ℝ (↿G)) Ω :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hΩ).1 hG).2
    refine ⟨fun X η hz => ?_, hfd.clm_apply contDiffOn_const, fun n => ?_⟩
    · have hd : DifferentiableAt ℝ (↿G) (X, η) :=
        (hG.contDiffAt (hΩ.mem_nhds hz)).differentiableAt (by simp)
      have hγ : HasDerivAt (fun Y : ℝ => (Y, η)) ((1:ℝ), (0:ℝ)) X :=
        (hasDerivAt_id X).prodMk (hasDerivAt_const X η)
      exact (hd.hasFDerivAt.comp_hasDerivAt X hγ).deriv
    · obtain ⟨C, hC⟩ := hGb (n + 1)
      refine ⟨‖ContinuousLinearMap.apply ℝ ℝ ((1:ℝ), (0:ℝ))‖ * C, fun z hz => ?_⟩
      have e : (fun z => fderiv ℝ (↿G) z ((1:ℝ), (0:ℝ))) =
          (ContinuousLinearMap.apply ℝ ℝ ((1:ℝ), (0:ℝ))) ∘ fderiv ℝ (↿G) := by
        funext z; simp
      rw [e]
      refine (ContinuousLinearMap.norm_iteratedFDeriv_comp_left _
        (hfd.contDiffAt (hΩ.mem_nhds (hSΩ hz))) (hle n)).trans ?_
      rw [norm_iteratedFDeriv_fderiv]
      exact mul_le_mul_of_nonneg_left (hC z hz) (norm_nonneg _)

  have hfin : ∀ H GH : ℝ × ℝ → ℝ, axgeGood Ω S GH → (∀ z ∈ Ω, H z = GH z) →
      axgeGood Ω S H := by
    intro H GH hG hEq
    refine ⟨hG.1.congr hEq, fun n => ?_⟩
    obtain ⟨C, hC⟩ := hG.2 n
    refine ⟨C, fun z hz => ?_⟩
    have hev : H =ᶠ[nhds z] GH := Filter.eventuallyEq_of_mem (hΩ.mem_nhds (hSΩ hz)) hEq
    rw [(hev.iteratedFDeriv ℝ n).eq_of_nhds]
    exact hC z hz

  have hbdF : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿F) z‖ ≤ C := by
    intro k
    obtain ⟨C, hC⟩ := hbd k
    exact ⟨C, fun z hz => (hC z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).1⟩
  have hbdU : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (↿U) z‖ ≤ C := by
    intro k
    obtain ⟨C, hC⟩ := hbd k
    exact ⟨C, fun z hz => (hC z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2).2⟩
  obtain ⟨hidF, hDF⟩ := hpart F hFs hbdF
  obtain ⟨hidU, hDU⟩ := hpart U hUs hbdU
  have hFg : axgeGood Ω S (↿F) := ⟨hFs, hbdF⟩
  have hiF := hinv (↿F) hFg (fun z hz => hFpos z.1 z.2 hz.1 hz.2.1 hz.2.2)
    (fun z hz => hFc z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2)
  have hlin : ContDiffOn ℝ ∞ (fun X : ℝ => -2 * X) (Ioi 0) :=
    (contDiff_const.mul contDiff_id).contDiffOn
  have hsq : ContDiffOn ℝ ∞ (fun X : ℝ => Real.sqrt (2 * X)) (Ioi 0) :=
    ContDiffOn.sqrt (f := fun X : ℝ => 2 * X) (contDiff_const.mul contDiff_id).contDiffOn
      (fun x hx => by
        have hx' : (0:ℝ) < x := hx
        show 2 * x ≠ 0
        positivity)
  have ha := hcoef _ hlin
  have hr := hcoef _ hsq
  have hGA := hmul _ _ ha (hmul _ _ hDF hiF)
  have hGB := hmul _ _ hr (hmul _ _ hDU hiF)
  have hA := hfin (↿(shearA F)) _ hGA (by
    rintro ⟨X, η⟩ hz
    show shearA F X η = -2 * X * (fderiv ℝ (↿F) (X, η) ((1:ℝ), (0:ℝ)) * (F X η)⁻¹)
    unfold shearA
    rw [hidF X η hz]
    ring)
  have hB := hfin (↿(shearB F U)) _ hGB (by
    rintro ⟨X, η⟩ hz
    show shearB F U X η = Real.sqrt (2 * X) * (fderiv ℝ (↿U) (X, η) ((1:ℝ), (0:ℝ)) * (F X η)⁻¹)
    unfold shearB
    rw [hidU X η hz]
    ring)
  refine ⟨hA.1, hB.1, fun m => ?_⟩
  obtain ⟨C1, h1⟩ := hA.2 m
  obtain ⟨C2, h2⟩ := hB.2 m
  exact ⟨max C1 C2, fun X η a b d e =>
    ⟨(h1 (X, η) ⟨⟨a, b⟩, d, e⟩).trans (le_max_left _ _),
      (h2 (X, η) ⟨⟨a, b⟩, d, e⟩).trans (le_max_right _ _)⟩⟩

theorem gap_stability : ∀ κL A' P0 : ℝ, 0 < κL → 0 < A' → 0 < P0 → ∃ τ : ℝ, 0 < τ ∧ τ ≤ 1 ∧ ∀ a b a' b' p1 p2 : ℝ, κL ≤ a → a ≤ A' → |b| ≤ A' → |p1| ≤ P0 → |p2| ≤ P0 → κL ≤ a * (1 + (b / a) ^ 2) - 2 → κL ≤ p1 - b / a * p2 - 2 → κL ≤ coneUp (p1 - b / a * p2) (p2 + b / a * p1) - a * (1 + (b / a) ^ 2) → |a' - a| ≤ τ → |b' - b| ≤ τ → κL / 2 ≤ a' ∧ κL / 2 ≤ a' * (1 + (b' / a') ^ 2) - 2 ∧ κL / 2 ≤ p1 - b' / a' * p2 - 2 ∧ κL / 2 ≤ coneUp (p1 - b' / a' * p2) (p2 + b' / a' * p1) - a' * (1 + (b' / a') ^ 2) :=
by
  intro κL A' P0 hκ hA hP
  have margin : ∀ (R : Set (ℝ × ℝ × ℝ × ℝ)) (g : ℝ × ℝ × ℝ × ℝ → ℝ), IsCompact R →
      ContinuousOn g R → ∃ δ : ℝ, 0 < δ ∧ ∀ x ∈ R, ∀ y ∈ R, dist x y ≤ δ → g x - κL / 2 ≤ g y := by
    intro R g hR hg
    have hu := hR.uniformContinuousOn_of_continuous hg
    rw [Metric.uniformContinuousOn_iff_le] at hu
    obtain ⟨δ, hδ, h⟩ := hu (κL / 2) (by linarith)
    refine ⟨δ, hδ, fun x hx y hy hxy => ?_⟩
    have := h x hx y hy hxy
    rw [Real.dist_eq, abs_le] at this
    linarith [this.2]
  obtain ⟨R, hRdef⟩ : ∃ R : Set (ℝ × ℝ × ℝ × ℝ), R = Set.Icc (κL / 2) (A' + 1) ×ˢ
      (Set.Icc (-(A' + 1)) (A' + 1) ×ˢ (Set.Icc (-P0) P0 ×ˢ Set.Icc (-P0) P0)) := ⟨_, rfl⟩
  have hRc : IsCompact R := by
    rw [hRdef]
    exact isCompact_Icc.prod (isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc))
  have hne : ∀ x ∈ R, x.1 ≠ 0 := by
    intro x hx
    rw [hRdef] at hx
    have := hx.1.1
    exact ne_of_gt (by linarith)
  have hq : ContinuousOn (fun x : ℝ × ℝ × ℝ × ℝ => x.2.1 / x.1) R :=
    (continuous_snd.fst.continuousOn).div continuous_fst.continuousOn hne
  have hc : Continuous (fun z : ℝ × ℝ => coneUp z.1 z.2) := by
    unfold coneUp
    fun_prop
  have hg2 : ContinuousOn (fun x : ℝ × ℝ × ℝ × ℝ => x.1 * (1 + (x.2.1 / x.1) ^ 2) - 2) R :=
    (continuous_fst.continuousOn.mul (continuousOn_const.add (hq.pow 2))).sub continuousOn_const
  have hg3 : ContinuousOn (fun x : ℝ × ℝ × ℝ × ℝ => x.2.2.1 - x.2.1 / x.1 * x.2.2.2 - 2) R :=
    ((continuous_snd.snd.fst.continuousOn).sub
      (hq.mul continuous_snd.snd.snd.continuousOn)).sub continuousOn_const
  have hg4 : ContinuousOn (fun x : ℝ × ℝ × ℝ × ℝ => coneUp (x.2.2.1 - x.2.1 / x.1 * x.2.2.2)
      (x.2.2.2 + x.2.1 / x.1 * x.2.2.1) - x.1 * (1 + (x.2.1 / x.1) ^ 2)) R := by
    have hin : ContinuousOn (fun x : ℝ × ℝ × ℝ × ℝ =>
        ((x.2.2.1 - x.2.1 / x.1 * x.2.2.2), (x.2.2.2 + x.2.1 / x.1 * x.2.2.1))) R :=
      ((continuous_snd.snd.fst.continuousOn).sub (hq.mul continuous_snd.snd.snd.continuousOn)).prodMk
        ((continuous_snd.snd.snd.continuousOn).add (hq.mul continuous_snd.snd.fst.continuousOn))
    exact (hc.comp_continuousOn hin).sub
      (continuous_fst.continuousOn.mul (continuousOn_const.add (hq.pow 2)))
  obtain ⟨δ2, hδ2, h2⟩ := margin R _ hRc hg2
  obtain ⟨δ3, hδ3, h3⟩ := margin R _ hRc hg3
  obtain ⟨δ4, hδ4, h4⟩ := margin R _ hRc hg4
  obtain ⟨τ, hτpos, t1, t2, t3, t4, t5⟩ : ∃ τ : ℝ, 0 < τ ∧ τ ≤ δ2 ∧ τ ≤ δ3 ∧ τ ≤ δ4 ∧
      τ ≤ κL / 2 ∧ τ ≤ 1 :=
    ⟨min (min δ2 (min δ3 δ4)) (min (κL / 2) 1),
      lt_min (lt_min hδ2 (lt_min hδ3 hδ4)) (lt_min (by linarith) one_pos),
      le_trans (min_le_left _ _) (min_le_left _ _),
      le_trans (min_le_left _ _) (le_trans (min_le_right _ _) (min_le_left _ _)),
      le_trans (min_le_left _ _) (le_trans (min_le_right _ _) (min_le_right _ _)),
      le_trans (min_le_right _ _) (min_le_left _ _),
      le_trans (min_le_right _ _) (min_le_right _ _)⟩
  refine ⟨τ, hτpos, t5, ?_⟩
  intro a b a' b' p1 p2 ha1 ha2 hb hp1 hp2 G2 G3 G4 ha' hb'
  obtain ⟨ha'1, ha'2⟩ := abs_le.mp ha'
  obtain ⟨hb'1, hb'2⟩ := abs_le.mp hb'
  obtain ⟨hb1, hb2⟩ := abs_le.mp hb
  obtain ⟨hp11, hp12⟩ := abs_le.mp hp1
  obtain ⟨hp21, hp22⟩ := abs_le.mp hp2
  have hx : ((a, b, p1, p2) : ℝ × ℝ × ℝ × ℝ) ∈ R := by
    rw [hRdef]
    exact ⟨⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩, ⟨hp11, hp12⟩, ⟨hp21, hp22⟩⟩
  have hy : ((a', b', p1, p2) : ℝ × ℝ × ℝ × ℝ) ∈ R := by
    rw [hRdef]
    exact ⟨⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩, ⟨hp11, hp12⟩, ⟨hp21, hp22⟩⟩
  have hd : dist ((a, b, p1, p2) : ℝ × ℝ × ℝ × ℝ) (a', b', p1, p2) ≤ τ := by
    rw [Prod.dist_eq, Prod.dist_eq, Prod.dist_eq, dist_self, dist_self, Real.dist_eq,
      Real.dist_eq, abs_sub_comm a, abs_sub_comm b]
    exact max_le ha' (max_le hb' (max_le hτpos.le hτpos.le))
  refine ⟨by linarith, ?_, ?_, ?_⟩
  · have := h2 _ hx _ hy (hd.trans t1)
    dsimp only at this
    linarith
  · have := h3 _ hx _ hy (hd.trans t2)
    dsimp only at this
    linarith
  · have := h4 _ hx _ hy (hd.trans t3)
    dsimp only at this
    linarith

theorem phase_compose : ∀ (w1 w2 w3 w4 : ℝ → ℝ → ℝ) (Ω S : Set (ℝ × ℝ)) (V K : Set (ℝ × ℝ × ℝ × ℝ)) (Q : ℝ × ℝ × ℝ × ℝ → ℝ → ℝ), IsOpen Ω → S ⊆ Ω → IsOpen V → K ⊆ V → ContDiffOn ℝ ∞ (↿w1) Ω → ContDiffOn ℝ ∞ (↿w2) Ω → ContDiffOn ℝ ∞ (↿w3) Ω → ContDiffOn ℝ ∞ (↿w4) Ω → (∀ z ∈ Ω, (w1 z.1 z.2, w2 z.1 z.2, w3 z.1 z.2, w4 z.1 z.2) ∈ V) → (∀ z ∈ S, (w1 z.1 z.2, w2 z.1 z.2, w3 z.1 z.2, w4 z.1 z.2) ∈ K) → (∀ m : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ m (↿w1) z‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿w2) z‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿w3) z‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿w4) z‖ ≤ C) → ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => Q z.1 z.2) (V ×ˢ univ) → (∀ m : ℕ, ∃ C : ℝ, ∀ p ∈ K, ∀ φ : ℝ, ‖iteratedFDeriv ℝ m (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => Q z.1 z.2) (p, φ)‖ ≤ C) → ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ => Q (w1 z.1 z.2.1, w2 z.1 z.2.1, w3 z.1 z.2.1, w4 z.1 z.2.1) z.2.2) {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ω} ∧ ∀ m : ℕ, ∃ C : ℝ, ∀ z : ℝ × ℝ × ℝ, (z.1, z.2.1) ∈ S → ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ × ℝ => Q (w1 z.1 z.2.1, w2 z.1 z.2.1, w3 z.1 z.2.1, w4 z.1 z.2.1) z.2.2) z‖ ≤ C :=
by
  intro w1 w2 w3 w4 Ω S V K Q hΩ hSΩ hV hKV hw1 hw2 hw3 hw4 hwV hwK hwb hQs hQb
  have hle : ∀ k : ℕ, ((k : WithTop ℕ∞)) ≤ ∞ := fun k => by exact_mod_cast le_top
  obtain ⟨pr, hpr⟩ : ∃ pr : ℝ × ℝ × ℝ →L[ℝ] ℝ × ℝ, ∀ z, pr z = (z.1, z.2.1) :=
    ⟨(ContinuousLinearMap.fst ℝ ℝ (ℝ × ℝ)).prod
      ((ContinuousLinearMap.fst ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ))), fun z => rfl⟩
  obtain ⟨L, hL⟩ : ∃ L : ℝ × ℝ × ℝ →L[ℝ] ℝ, ∀ z, L z = z.2.2 :=
    ⟨(ContinuousLinearMap.snd ℝ ℝ ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × ℝ)), fun z => rfl⟩
  have hprn : ‖pr‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound pr zero_le_one (fun z => ?_)
    rw [hpr, one_mul, norm_prod_le_iff]
    exact ⟨norm_fst_le z, (norm_fst_le z.2).trans (norm_snd_le z)⟩
  have hLn : ‖L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound L zero_le_one (fun z => ?_)
    rw [hL, one_mul]
    exact (norm_snd_le z.2).trans (norm_snd_le z)
  have hΩ'eq : {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ω} = pr ⁻¹' Ω := by
    ext z
    rw [mem_preimage, hpr]
    exact Iff.rfl
  have hO' : IsOpen (pr ⁻¹' Ω) := hΩ.preimage pr.continuous
  have hO : IsOpen {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ω} := by rw [hΩ'eq]; exact hO'
  have hT : IsOpen ((V ×ˢ univ) : Set ((ℝ × ℝ × ℝ × ℝ) × ℝ)) := hV.prod isOpen_univ

  have hslice : ∀ (a : ℝ × ℝ → ℝ), ContDiffOn ℝ ∞ a Ω → ∀ (i : ℕ) (z : ℝ × ℝ × ℝ),
      (z.1, z.2.1) ∈ Ω →
      ‖iteratedFDeriv ℝ i (fun z : ℝ × ℝ × ℝ => a (z.1, z.2.1)) z‖ ≤
        ‖iteratedFDeriv ℝ i a (z.1, z.2.1)‖ := by
    intro a ha i z hz
    have hfun : (fun z : ℝ × ℝ × ℝ => a (z.1, z.2.1)) = a ∘ pr := by
      funext y; simp only [Function.comp_apply, hpr]
    have hz' : pr z ∈ Ω := by rw [hpr]; exact hz
    have hzp : z ∈ pr ⁻¹' Ω := hz'
    rw [hfun, ← iteratedFDerivWithin_of_isOpen i hO' hzp,
      ContinuousLinearMap.iteratedFDerivWithin_comp_right pr ha hΩ.uniqueDiffOn hO'.uniqueDiffOn hz'
        (hle i),
      iteratedFDerivWithin_of_isOpen i hΩ hz', hpr]
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    exact mul_le_of_le_one_right (norm_nonneg _)
      (Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) (fun _ _ => hprn))

  have hLd : ∀ (i : ℕ) (z : ℝ × ℝ × ℝ), 1 ≤ i → ‖iteratedFDeriv ℝ i (⇑L) z‖ ≤ 1 := by
    intro i z hi
    obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
    rw [← norm_iteratedFDeriv_fderiv]
    have hfd : fderiv ℝ (⇑L) = fun _ => L := by funext y; exact L.fderiv
    rw [hfd]
    rcases Nat.eq_zero_or_pos j with hj | hj
    · subst hj; rw [norm_iteratedFDeriv_zero]; exact hLn
    · rw [iteratedFDeriv_const_of_ne (by omega : j ≠ 0)]; simp

  have hpair : ∀ {F1 F2 : Type} [NormedAddCommGroup F1] [NormedSpace ℝ F1] [NormedAddCommGroup F2]
      [NormedSpace ℝ F2] (a : ℝ × ℝ × ℝ → F1) (b : ℝ × ℝ × ℝ → F2) (x : ℝ × ℝ × ℝ) (i : ℕ),
      ContDiffAt ℝ ∞ a x → ContDiffAt ℝ ∞ b x →
      ‖iteratedFDeriv ℝ i (fun y => (a y, b y)) x‖ =
        max ‖iteratedFDeriv ℝ i a x‖ ‖iteratedFDeriv ℝ i b x‖ := by
    intro F1 F2 _ _ _ _ a b x i ha hb
    rw [iteratedFDeriv_prodMk ha hb (hle i)]
    exact ContinuousMultilinearMap.opNorm_prod _ _

  have hpc : ContDiff ℝ ∞ (fun z : ℝ × ℝ × ℝ => ((z.1, z.2.1) : ℝ × ℝ)) := by fun_prop
  have hmp : MapsTo (fun z : ℝ × ℝ × ℝ => ((z.1, z.2.1) : ℝ × ℝ))
      {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ω} Ω := fun z hz => hz
  have ha1 : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ => w1 z.1 z.2.1)
      {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ω} := hw1.comp hpc.contDiffOn hmp
  have ha2 : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ => w2 z.1 z.2.1)
      {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ω} := hw2.comp hpc.contDiffOn hmp
  have ha3 : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ => w3 z.1 z.2.1)
      {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ω} := hw3.comp hpc.contDiffOn hmp
  have ha4 : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ => w4 z.1 z.2.1)
      {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ω} := hw4.comp hpc.contDiffOn hmp
  have hLs : ContDiff ℝ ∞ (fun z : ℝ × ℝ × ℝ => z.2.2) := by fun_prop
  have hf : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ =>
      ((w1 z.1 z.2.1, w2 z.1 z.2.1, w3 z.1 z.2.1, w4 z.1 z.2.1), z.2.2))
      {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ω} :=
    (ha1.prodMk (ha2.prodMk (ha3.prodMk ha4))).prodMk hLs.contDiffOn
  have hfm : MapsTo (fun z : ℝ × ℝ × ℝ =>
      ((w1 z.1 z.2.1, w2 z.1 z.2.1, w3 z.1 z.2.1, w4 z.1 z.2.1), z.2.2))
      {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ω} (V ×ˢ univ) :=
    fun z hz => ⟨hwV (z.1, z.2.1) hz, mem_univ _⟩
  have hcomp : (fun z : ℝ × ℝ × ℝ => Q (w1 z.1 z.2.1, w2 z.1 z.2.1, w3 z.1 z.2.1, w4 z.1 z.2.1) z.2.2)
      = (fun y : (ℝ × ℝ × ℝ × ℝ) × ℝ => Q y.1 y.2) ∘ (fun z : ℝ × ℝ × ℝ =>
      ((w1 z.1 z.2.1, w2 z.1 z.2.1, w3 z.1 z.2.1, w4 z.1 z.2.1), z.2.2)) := rfl
  refine ⟨?_, ?_⟩
  · rw [hcomp]; exact hQs.comp hf hfm
  · intro m
    choose Cg hCg using hQb
    choose Cw hCw using hwb
    refine ⟨(m.factorial : ℝ) * (∑ i ∈ Finset.range (m + 1), |Cg i|) *
      (1 + ∑ i ∈ Finset.range (m + 1), |max (Cw i) 1|) ^ m, ?_⟩
    intro z hzS
    have hz : z ∈ {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ω} := hSΩ hzS
    have hpz : ((z.1, z.2.1) : ℝ × ℝ) ∈ Ω := hSΩ hzS
    have hzn : {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ω} ∈ nhds z := hO.mem_nhds hz
    have hfz := hfm hz
    have hgb : ∀ i ≤ m, ‖iteratedFDerivWithin ℝ i (fun y : (ℝ × ℝ × ℝ × ℝ) × ℝ => Q y.1 y.2)
        (V ×ˢ univ) ((w1 z.1 z.2.1, w2 z.1 z.2.1, w3 z.1 z.2.1, w4 z.1 z.2.1), z.2.2)‖ ≤
        ∑ i ∈ Finset.range (m + 1), |Cg i| := by
      intro i hi
      rw [iteratedFDerivWithin_of_isOpen i hT hfz]
      exact (hCg i _ (hwK (z.1, z.2.1) hzS) z.2.2).trans ((le_abs_self _).trans
        (Finset.single_le_sum (f := fun i => |Cg i|) (fun _ _ => abs_nonneg _)
          (Finset.mem_range.mpr (by omega))))
    have hfb : ∀ i, 1 ≤ i → ‖iteratedFDeriv ℝ i (fun z : ℝ × ℝ × ℝ =>
        ((w1 z.1 z.2.1, w2 z.1 z.2.1, w3 z.1 z.2.1, w4 z.1 z.2.1), z.2.2)) z‖ ≤ max (Cw i) 1 := by
      intro i hi
      have c1 := ha1.contDiffAt hzn
      have c2 := ha2.contDiffAt hzn
      have c3 := ha3.contDiffAt hzn
      have c4 := ha4.contDiffAt hzn
      rw [hpair _ _ z i (c1.prodMk (c2.prodMk (c3.prodMk c4))) hLs.contDiffAt,
        hpair _ _ z i c1 (c2.prodMk (c3.prodMk c4)), hpair _ _ z i c2 (c3.prodMk c4),
        hpair _ _ z i c3 c4]
      obtain ⟨b1, b2, b3, b4⟩ := hCw i (z.1, z.2.1) hzS
      have e1 := (hslice (↿w1) hw1 i z hpz).trans b1
      have e2 := (hslice (↿w2) hw2 i z hpz).trans b2
      have e3 := (hslice (↿w3) hw3 i z hpz).trans b3
      have e4 := (hslice (↿w4) hw4 i z hpz).trans b4
      have eL : ‖iteratedFDeriv ℝ i (fun z : ℝ × ℝ × ℝ => z.2.2) z‖ ≤ 1 := by
        have : (fun z : ℝ × ℝ × ℝ => z.2.2) = ⇑L := funext fun y => (hL y).symm
        rw [this]; exact hLd i z hi
      exact max_le (max_le (e1.trans (le_max_left _ _)) (max_le (e2.trans (le_max_left _ _))
        (max_le (e3.trans (le_max_left _ _)) (e4.trans (le_max_left _ _)))))
        (eL.trans (le_max_right _ _))
    have hD1 : (1 : ℝ) ≤ 1 + ∑ i ∈ Finset.range (m + 1), |max (Cw i) 1| := by
      have := Finset.sum_nonneg (s := Finset.range (m + 1)) (fun i _ => abs_nonneg (max (Cw i) 1))
      linarith
    have hfb' : ∀ i, 1 ≤ i → i ≤ m → ‖iteratedFDerivWithin ℝ i (fun z : ℝ × ℝ × ℝ =>
        ((w1 z.1 z.2.1, w2 z.1 z.2.1, w3 z.1 z.2.1, w4 z.1 z.2.1), z.2.2))
        {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ω} z‖ ≤
        (1 + ∑ i ∈ Finset.range (m + 1), |max (Cw i) 1|) ^ i := by
      intro i hi1 him
      rw [iteratedFDerivWithin_of_isOpen i hO hz]
      have hs : |max (Cw i) 1| ≤ ∑ i ∈ Finset.range (m + 1), |max (Cw i) 1| :=
        Finset.single_le_sum (f := fun i => |max (Cw i) 1|) (fun _ _ => abs_nonneg _)
          (Finset.mem_range.mpr (by omega))
      calc _ ≤ max (Cw i) 1 := hfb i hi1
        _ ≤ |max (Cw i) 1| := le_abs_self _
        _ ≤ 1 + ∑ i ∈ Finset.range (m + 1), |max (Cw i) 1| := by linarith
        _ ≤ _ := le_self_pow₀ hD1 (by omega)
    have key := norm_iteratedFDerivWithin_comp_le hQs hf (hle m) hT.uniqueDiffOn hO.uniqueDiffOn
      hfm hz hgb hfb'
    rw [iteratedFDerivWithin_of_isOpen m hO hz] at key
    rw [hcomp]
    exact key

theorem wt_comp_bound : ∀ {E F G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G] [NormedSpace ℝ G] (g : F → G) (f : E → F) (ρ : E → ℝ) (Ω S : Set E) (T : Set F), IsOpen Ω → IsOpen T → S ⊆ Ω → MapsTo f Ω T → (∀ w ∈ S, 0 < ρ w ∧ ρ w ≤ 1) → ContDiffOn ℝ ∞ g T → ContDiffOn ℝ ∞ f Ω → (∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k g (f w)‖ ≤ C * ρ w ^ (-K)) → (∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k f w‖ ≤ C * ρ w ^ (-K)) → ContDiffOn ℝ ∞ (g ∘ f) Ω ∧ ∀ k : ℕ, ∃ C K : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k (g ∘ f) w‖ ≤ C * ρ w ^ (-K) :=
by
  intro E F G _ _ _ _ _ _ g f ρ Ω S T hΩ hT hSΩ hmaps hρ hg hf hgb hfb
  refine ⟨hg.comp hf hmaps, ?_⟩
  choose Cg Kg hCg using hgb
  choose Cf Kf hCf using hfb
  intro k
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = ∑ i ∈ Finset.range (k + 1), |Cg i| := ⟨_, rfl⟩
  obtain ⟨K₁, hK₁⟩ : ∃ K₁ : ℝ, K₁ = ∑ i ∈ Finset.range (k + 1), |Kg i| := ⟨_, rfl⟩
  obtain ⟨B, hB⟩ : ∃ B : ℝ, B = 1 + ∑ i ∈ Finset.range (k + 1), |Cf i| := ⟨_, rfl⟩
  obtain ⟨K₂, hK₂⟩ : ∃ K₂ : ℝ, K₂ = ∑ i ∈ Finset.range (k + 1), |Kf i| := ⟨_, rfl⟩
  have hsingle : ∀ (c : ℕ → ℝ) (i : ℕ), i ≤ k →
      |c i| ≤ ∑ j ∈ Finset.range (k + 1), |c j| := by
    intro c i hi
    exact Finset.single_le_sum (f := fun j => |c j|) (fun j _ => abs_nonneg _)
      (Finset.mem_range.mpr (by omega))
  have hK₂0 : 0 ≤ K₂ := by rw [hK₂]; exact Finset.sum_nonneg (fun j _ => abs_nonneg _)
  have hB1 : 1 ≤ B := by
    have : 0 ≤ ∑ i ∈ Finset.range (k + 1), |Cf i| :=
      Finset.sum_nonneg (fun j _ => abs_nonneg _)
    linarith
  refine ⟨(k.factorial : ℝ) * A * B ^ k, K₁ + (k : ℝ) * K₂, fun w hw => ?_⟩
  obtain ⟨hr0, hr1⟩ := hρ w hw
  have hwΩ : w ∈ Ω := hSΩ hw
  have hfw : f w ∈ T := hmaps hwΩ
  have hmono : ∀ a b : ℝ, a ≤ b → ρ w ^ (-a) ≤ ρ w ^ (-b) := fun a b hab =>
    Real.rpow_le_rpow_of_exponent_ge hr0 hr1 (by linarith)
  have hpos : ∀ c : ℝ, 0 ≤ ρ w ^ c := fun c => (Real.rpow_pos_of_pos hr0 c).le
  have hgbound : ∀ i ≤ k, ‖iteratedFDerivWithin ℝ i g T (f w)‖ ≤ A * ρ w ^ (-K₁) := by
    intro i hi
    have hA' : |Cg i| ≤ A := by rw [hA]; exact hsingle Cg i hi
    have hK' : Kg i ≤ K₁ := by rw [hK₁]; exact (le_abs_self _).trans (hsingle Kg i hi)
    rw [iteratedFDerivWithin_of_isOpen i hT hfw]
    calc ‖iteratedFDeriv ℝ i g (f w)‖ ≤ Cg i * ρ w ^ (-(Kg i)) := hCg i w hw
      _ ≤ |Cg i| * ρ w ^ (-(Kg i)) := mul_le_mul_of_nonneg_right (le_abs_self _) (hpos _)
      _ ≤ |Cg i| * ρ w ^ (-K₁) :=
          mul_le_mul_of_nonneg_left (hmono _ _ hK') (abs_nonneg _)
      _ ≤ A * ρ w ^ (-K₁) := mul_le_mul_of_nonneg_right hA' (hpos _)
  have hD1 : 1 ≤ B * ρ w ^ (-K₂) := by
    have : 1 ≤ ρ w ^ (-K₂) :=
      Real.one_le_rpow_of_pos_of_le_one_of_nonpos hr0 hr1 (by linarith)
    nlinarith
  have hfbound : ∀ i, 1 ≤ i → i ≤ k →
      ‖iteratedFDerivWithin ℝ i f Ω w‖ ≤ (B * ρ w ^ (-K₂)) ^ i := by
    intro i hi1 hi
    have hB' : |Cf i| ≤ B := by rw [hB]; linarith [hsingle Cf i hi]
    have hK' : Kf i ≤ K₂ := by rw [hK₂]; exact (le_abs_self _).trans (hsingle Kf i hi)
    rw [iteratedFDerivWithin_of_isOpen i hΩ hwΩ]
    calc ‖iteratedFDeriv ℝ i f w‖ ≤ Cf i * ρ w ^ (-(Kf i)) := hCf i w hw
      _ ≤ |Cf i| * ρ w ^ (-(Kf i)) := mul_le_mul_of_nonneg_right (le_abs_self _) (hpos _)
      _ ≤ |Cf i| * ρ w ^ (-K₂) :=
          mul_le_mul_of_nonneg_left (hmono _ _ hK') (abs_nonneg _)
      _ ≤ B * ρ w ^ (-K₂) := mul_le_mul_of_nonneg_right hB' (hpos _)
      _ ≤ (B * ρ w ^ (-K₂)) ^ i := le_self_pow₀ hD1 (by omega)
  have hle : ((k : ℕ∞) : WithTop ℕ∞) ≤ (∞ : WithTop ℕ∞) := by exact_mod_cast le_top
  have hFdB := norm_iteratedFDerivWithin_comp_le hg hf hle hT.uniqueDiffOn
    hΩ.uniqueDiffOn hmaps hwΩ hgbound hfbound
  rw [iteratedFDerivWithin_of_isOpen k hΩ hwΩ] at hFdB
  refine hFdB.trans (le_of_eq ?_)
  have e1 : (ρ w ^ (-K₂)) ^ k = ρ w ^ (-((k : ℝ) * K₂)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hr0.le]
    congr 1; ring
  have e2 : ρ w ^ (-K₁) * ρ w ^ (-((k : ℝ) * K₂)) = ρ w ^ (-(K₁ + (k : ℝ) * K₂)) := by
    rw [← Real.rpow_add hr0]; congr 1; ring
  rw [mul_pow, e1, ← e2]; ring

theorem modulation_regularity : ∀ (F U : ℝ → ℝ → ℝ) (Pa Pb : ℝ → ℝ → ℝ → ℝ) (Xm Xm2 Xp2 Xp : ℝ), 0 < Xm → Xm < Xm2 → Xm2 < Xp2 → Xp2 < Xp → ContDiffOn ℝ ∞ (↿F) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿U) (Ioi 0 ×ˢ Ioo (-1) 1) → (∀ X η : ℝ, 0 < X → -1 < η → η < 1 → 0 < F X η) → (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿F) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿U) (X, η)‖ ≤ C) → ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) (Ioo Xm Xp ×ˢ Ioo (-1) 1 ×ˢ univ) → ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) (Ioo Xm Xp ×ˢ Ioo (-1) 1 ×ˢ univ) → (∀ m : ℕ, ∃ C : ℝ, ∀ z : ℝ × ℝ × ℝ, Xm2 ≤ z.1 → z.1 ≤ Xp2 → -1 < z.2.1 → z.2.1 < 1 → ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) z‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) z‖ ≤ C) → (∀ X η φ : ℝ, (X ≤ Xm2 ∨ Xp2 ≤ X) → Pa X η φ = 0 ∧ Pb X η φ = 0) → ∀ N : ℕ, 1 ≤ N → (∀ X η : ℝ, (X ≤ Xm2 ∨ Xp2 ≤ X) → F X η * Real.exp (-Pa X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ))) = F X η ∧ U X η + Real.sqrt (2 * X) * F X η * Pb X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ)) = U X η) ∧ ContDiffOn ℝ ∞ (↿(fun X η : ℝ => F X η * Real.exp (-Pa X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ))))) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(fun X η : ℝ => U X η + Real.sqrt (2 * X) * F X η * Pb X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ)))) (Ioi 0 ×ˢ Ioo (-1) 1) ∧ (∀ X η : ℝ, 0 < X → -1 < η → η < 1 → 0 < F X η * Real.exp (-Pa X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ)))) ∧ ∀ m : ℕ, ∃ C' : ℝ, ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿(fun X η : ℝ => F X η * Real.exp (-Pa X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ))))) (X, η)‖ ≤ C' ∧ ‖iteratedFDeriv ℝ m (↿(fun X η : ℝ => U X η + Real.sqrt (2 * X) * F X η * Pb X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ)))) (X, η)‖ ≤ C' :=
by
  intro F U Pa Pb Xm Xm2 Xp2 Xp hXm hXm2 hX2 hXp hF hU hFpos hB hPa hPb hPB hvan N _hN

  have hoff : ∀ X η : ℝ, (X ≤ Xm2 ∨ Xp2 ≤ X) →
      F X η * Real.exp (-Pa X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ))) = F X η ∧
      U X η + Real.sqrt (2 * X) * F X η * Pb X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ)) = U X η := by
    intro X η hc
    obtain ⟨h1, h2⟩ := hvan X η ((N : ℝ) * Real.log X) hc
    rw [h1, h2]
    simp

  have hcpt : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (f : E → G) (V K : Set E), IsOpen V → IsCompact K → K ⊆ V →
      ContDiffOn ℝ ∞ f V → ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ K, ‖iteratedFDeriv ℝ k f z‖ ≤ C := by
    intro E G _ _ _ _ f V K hV hK hKV hf k
    have h1 : ContinuousOn (iteratedFDerivWithin ℝ k f V) V :=
      hf.continuousOn_iteratedFDerivWithin (by exact_mod_cast le_top) hV.uniqueDiffOn
    have h2 : ContinuousOn (iteratedFDeriv ℝ k f) V :=
      h1.congr (fun z hz => (iteratedFDerivWithin_of_isOpen k hV hz).symm)
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn (h2.mono hKV)
    exact ⟨C, hC⟩
  have hcomp : ∀ {E G H : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup G]
      [NormedSpace ℝ G] [NormedAddCommGroup H] [NormedSpace ℝ H] (g : G → H) (f : E → G)
      (V S : Set E) (T : Set G), IsOpen V → IsOpen T → S ⊆ V → MapsTo f V T →
      ContDiffOn ℝ ∞ g T → ContDiffOn ℝ ∞ f V →
      (∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k g (f w)‖ ≤ C) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k f w‖ ≤ C) →
      ContDiffOn ℝ ∞ (g ∘ f) V ∧ ∀ k : ℕ, ∃ C : ℝ, ∀ w ∈ S, ‖iteratedFDeriv ℝ k (g ∘ f) w‖ ≤ C := by
    intro E G H _ _ _ _ _ _ g f V S T hV hT hSV hM hg hf hgb hfb
    have key := wt_comp_bound g f (fun _ => (1:ℝ)) V S T hV hT hSV hM
      (fun _ _ => ⟨one_pos, le_rfl⟩) hg hf
      (fun k => by
        obtain ⟨C, hC⟩ := hgb k
        exact ⟨C, 0, fun w hw => by simpa using hC w hw⟩)
      (fun k => by
        obtain ⟨C, hC⟩ := hfb k
        exact ⟨C, 0, fun w hw => by simpa using hC w hw⟩)
    refine ⟨key.1, fun k => ?_⟩
    obtain ⟨C, K, hC⟩ := key.2 k
    exact ⟨C, fun w hw => by simpa using hC w hw⟩
  have hmul : ∀ (f g : ℝ × ℝ → ℝ) (V S : Set (ℝ × ℝ)), IsOpen V → S ⊆ V →
      ContDiffOn ℝ ∞ f V → ContDiffOn ℝ ∞ g V →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k f z‖ ≤ C) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k g z‖ ≤ C) →
      ContDiffOn ℝ ∞ (fun z => f z * g z) V ∧
        ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (fun z => f z * g z) z‖ ≤ C := by
    intro f g V S hV hSV hf hg hfb hgb
    refine ⟨hf.mul hg, ?_⟩
    have := iteratedFDeriv_bilinear_bounded_on (ContinuousLinearMap.mul ℝ ℝ) f g V S hV hSV hf hg
      hfb hgb
    simpa only [ContinuousLinearMap.mul_apply'] using this
  have hadd : ∀ (f g : ℝ × ℝ → ℝ) (V S : Set (ℝ × ℝ)), IsOpen V → S ⊆ V →
      ContDiffOn ℝ ∞ f V → ContDiffOn ℝ ∞ g V →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k f z‖ ≤ C) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k g z‖ ≤ C) →
      ContDiffOn ℝ ∞ (fun z => f z + g z) V ∧
        ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S, ‖iteratedFDeriv ℝ k (fun z => f z + g z) z‖ ≤ C := by
    intro f g V S hV hSV hf hg hfb hgb
    refine ⟨hf.add hg, fun k => ?_⟩
    obtain ⟨C1, h1⟩ := hfb k
    obtain ⟨C2, h2⟩ := hgb k
    refine ⟨C1 + C2, fun z hz => ?_⟩
    have hz' : V ∈ nhds z := hV.mem_nhds (hSV hz)
    have e : iteratedFDeriv ℝ k (fun z => f z + g z) z =
        iteratedFDeriv ℝ k f z + iteratedFDeriv ℝ k g z :=
      iteratedFDeriv_add_apply ((hf.contDiffAt hz').of_le (by exact_mod_cast le_top))
        ((hg.contDiffAt hz').of_le (by exact_mod_cast le_top))
    rw [e]
    exact (norm_add_le _ _).trans (add_le_add (h1 z hz) (h2 z hz))

  set Ω : Set (ℝ × ℝ) := Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1 with hΩdef
  set S0 : Set (ℝ × ℝ) := Icc Xm2 Xp2 ×ˢ Ioo (-1:ℝ) 1 with hS0def
  set W : Set (ℝ × ℝ) := {w : ℝ × ℝ | w.1 < Xm2} ∪ {w : ℝ × ℝ | Xp2 < w.1} with hWdef
  have hΩo : IsOpen Ω := isOpen_Ioo.prod isOpen_Ioo
  have hS0Ω : S0 ⊆ Ω := fun z hz =>
    ⟨⟨lt_of_lt_of_le hXm2 hz.1.1, lt_of_le_of_lt hz.1.2 hXp⟩, hz.2⟩
  have hΩs : Ω ⊆ Ioi 0 ×ˢ Ioo (-1) 1 := fun z hz =>
    ⟨show (0:ℝ) < z.1 from lt_trans hXm hz.1.1, hz.2⟩
  have hΩ'o : IsOpen (Ioi (0:ℝ) ×ˢ (univ : Set ℝ)) := isOpen_Ioi.prod isOpen_univ
  have hK0c : IsCompact (Icc Xm2 Xp2 ×ˢ Icc (-1:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
  have hK0Ω' : Icc Xm2 Xp2 ×ˢ Icc (-1:ℝ) 1 ⊆ Ioi (0:ℝ) ×ˢ (univ : Set ℝ) := fun z hz =>
    ⟨show (0:ℝ) < z.1 from lt_of_lt_of_le (lt_trans hXm hXm2) hz.1.1, mem_univ _⟩
  have hS0K0 : S0 ⊆ Icc Xm2 Xp2 ×ˢ Icc (-1:ℝ) 1 := prod_mono subset_rfl Ioo_subset_Icc_self
  have hΩΩ' : Ω ⊆ Ioi (0:ℝ) ×ˢ (univ : Set ℝ) := fun z hz =>
    ⟨show (0:ℝ) < z.1 from lt_trans hXm hz.1.1, mem_univ _⟩
  have hW : IsOpen W :=
    (isOpen_lt continuous_fst continuous_const).union (isOpen_lt continuous_const continuous_fst)
  have hWoff : ∀ w ∈ W, (w.1 ≤ Xm2 ∨ Xp2 ≤ w.1) := fun w hw =>
    hw.elim (fun h => Or.inl (le_of_lt h)) (fun h => Or.inr (le_of_lt h))

  have hjF : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => F w.1 w.2) Ω := hF.mono hΩs
  have hjU : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => U w.1 w.2) Ω := hU.mono hΩs
  have hFb : ∀ k : ℕ, ∃ C : ℝ, ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => F w.1 w.2) (X, η)‖ ≤ C := fun k =>
    (hB k).imp (fun C hC X η a b c d => (hC X η a b c d).1)
  have hUb : ∀ k : ℕ, ∃ C : ℝ, ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => U w.1 w.2) (X, η)‖ ≤ C := fun k =>
    (hB k).imp (fun C hC X η a b c d => (hC X η a b c d).2)
  have hjFb : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S0, ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => F w.1 w.2) z‖ ≤ C := by
    intro k
    obtain ⟨C, hC⟩ := hFb k
    refine ⟨C, fun z hz => ?_⟩
    obtain ⟨X, η⟩ := z
    exact hC X η (le_trans hXm2.le hz.1.1) (le_trans hz.1.2 hXp.le) hz.2.1 hz.2.2
  have hjUb : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S0, ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => U w.1 w.2) z‖ ≤ C := by
    intro k
    obtain ⟨C, hC⟩ := hUb k
    refine ⟨C, fun z hz => ?_⟩
    obtain ⟨X, η⟩ := z
    exact hC X η (le_trans hXm2.le hz.1.1) (le_trans hz.1.2 hXp.le) hz.2.1 hz.2.2

  have hι : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => ((w.1, w.2, (N:ℝ) * Real.log w.1) : ℝ × ℝ × ℝ))
      (Ioi (0:ℝ) ×ˢ (univ : Set ℝ)) :=
    contDiffOn_fst.prodMk (contDiffOn_snd.prodMk (contDiffOn_const.mul
      (contDiffOn_fst.log (fun w hw => (show (0:ℝ) < w.1 from hw.1).ne'))))
  have hιb : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S0,
      ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => ((w.1, w.2, (N:ℝ) * Real.log w.1) : ℝ × ℝ × ℝ)) z‖ ≤ C := by
    intro k
    obtain ⟨C, hC⟩ := hcpt _ _ _ hΩ'o hK0c hK0Ω' hι k
    exact ⟨C, fun z hz => hC z (hS0K0 hz)⟩
  have hphase : ∀ G : ℝ → ℝ → ℝ → ℝ,
      ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ => G z.1 z.2.1 z.2.2) (Ioo Xm Xp ×ˢ Ioo (-1) 1 ×ˢ univ) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z : ℝ × ℝ × ℝ, Xm2 ≤ z.1 → z.1 ≤ Xp2 → -1 < z.2.1 → z.2.1 < 1 →
        ‖iteratedFDeriv ℝ k (fun z : ℝ × ℝ × ℝ => G z.1 z.2.1 z.2.2) z‖ ≤ C) →
      ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => G w.1 w.2 ((N:ℝ) * Real.log w.1)) Ω ∧
        ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S0,
          ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => G w.1 w.2 ((N:ℝ) * Real.log w.1)) z‖ ≤ C := by
    intro G hG hGb
    exact hcomp (fun z : ℝ × ℝ × ℝ => G z.1 z.2.1 z.2.2)
      (fun w : ℝ × ℝ => ((w.1, w.2, (N:ℝ) * Real.log w.1) : ℝ × ℝ × ℝ)) Ω S0
      (Ioo Xm Xp ×ˢ Ioo (-1) 1 ×ˢ univ) hΩo (isOpen_Ioo.prod (isOpen_Ioo.prod isOpen_univ)) hS0Ω
      (fun w hw => ⟨hw.1, hw.2, mem_univ _⟩) hG (hι.mono hΩΩ')
      (fun k => by
        obtain ⟨C, hC⟩ := hGb k
        exact ⟨C, fun w hw => hC _ hw.1.1 hw.1.2 hw.2.1 hw.2.2⟩) hιb
  have hga := hphase Pa hPa (fun k => (hPB k).imp (fun C hC z a b c d => (hC z a b c d).1))
  have hgb := hphase Pb hPb (fun k => (hPB k).imp (fun C hC z a b c d => (hC z a b c d).2))

  have houter : ∀ (ψ : ℝ → ℝ) (g : ℝ × ℝ → ℝ), ContDiff ℝ ∞ ψ → ContDiffOn ℝ ∞ g Ω →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S0, ‖iteratedFDeriv ℝ k g z‖ ≤ C) →
      ContDiffOn ℝ ∞ (ψ ∘ g) Ω ∧ ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S0, ‖iteratedFDeriv ℝ k (ψ ∘ g) z‖ ≤ C := by
    intro ψ g hψ hg hgb'
    obtain ⟨C0, hC0⟩ := hgb' 0
    have hψb : ∀ k : ℕ, ∃ C : ℝ, ∀ y ∈ Icc (-C0) C0, ‖iteratedFDeriv ℝ k ψ y‖ ≤ C :=
      hcpt ψ univ (Icc (-C0) C0) isOpen_univ isCompact_Icc (subset_univ _) hψ.contDiffOn
    exact hcomp ψ g Ω S0 univ hΩo isOpen_univ hS0Ω (mapsTo_univ _ _) hψ.contDiffOn hg
      (fun k => by
        obtain ⟨C, hC⟩ := hψb k
        refine ⟨C, fun w hw => hC _ ?_⟩
        have := hC0 w hw
        rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at this
        exact abs_le.mp this) hgb'
  have hψ : ContDiff ℝ ∞ (fun t : ℝ => Real.exp (-t / (2 * (N:ℝ)))) := by fun_prop
  have hEa := houter (fun t : ℝ => Real.exp (-t / (2 * (N:ℝ))))
    (fun w : ℝ × ℝ => Pa w.1 w.2 ((N:ℝ) * Real.log w.1)) hψ hga.1 hga.2

  have hsq' : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => Real.sqrt (2 * w.1) / (2 * (N:ℝ)))
      (Ioi (0:ℝ) ×ˢ (univ : Set ℝ)) :=
    ((contDiffOn_const.mul contDiffOn_fst).sqrt (fun w hw => by
      have : (0:ℝ) < w.1 := hw.1
      positivity)).div_const _
  have hsqb : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S0,
      ‖iteratedFDeriv ℝ k (fun w : ℝ × ℝ => Real.sqrt (2 * w.1) / (2 * (N:ℝ))) z‖ ≤ C := by
    intro k
    obtain ⟨C, hC⟩ := hcpt _ _ _ hΩ'o hK0c hK0Ω' hsq' k
    exact ⟨C, fun z hz => hC z (hS0K0 hz)⟩

  have hFNp := hmul (fun w : ℝ × ℝ => F w.1 w.2)
    ((fun t : ℝ => Real.exp (-t / (2 * (N:ℝ)))) ∘ (fun w : ℝ × ℝ => Pa w.1 w.2 ((N:ℝ) * Real.log w.1)))
    Ω S0 hΩo hS0Ω hjF hEa.1 hjFb hEa.2
  have hT1 := hmul (fun w : ℝ × ℝ => Real.sqrt (2 * w.1) / (2 * (N:ℝ))) (fun w : ℝ × ℝ => F w.1 w.2)
    Ω S0 hΩo hS0Ω (hsq'.mono hΩΩ') hjF hsqb hjFb
  have hTb := hmul (fun w : ℝ × ℝ => Real.sqrt (2 * w.1) / (2 * (N:ℝ)) * F w.1 w.2)
    (fun w : ℝ × ℝ => Pb w.1 w.2 ((N:ℝ) * Real.log w.1)) Ω S0 hΩo hS0Ω hT1.1 hgb.1 hT1.2 hgb.2
  have hUNp := hadd (fun w : ℝ × ℝ => U w.1 w.2)
    (fun w : ℝ × ℝ => Real.sqrt (2 * w.1) / (2 * (N:ℝ)) * F w.1 w.2 *
      Pb w.1 w.2 ((N:ℝ) * Real.log w.1)) Ω S0 hΩo hS0Ω hjU hTb.1 hjUb hTb.2
  have hUNeq : (fun w : ℝ × ℝ => U w.1 w.2 + Real.sqrt (2 * w.1) * F w.1 w.2 *
      Pb w.1 w.2 ((N:ℝ) * Real.log w.1) / (2 * (N:ℝ))) =
      (fun w : ℝ × ℝ => U w.1 w.2 + Real.sqrt (2 * w.1) / (2 * (N:ℝ)) * F w.1 w.2 *
      Pb w.1 w.2 ((N:ℝ) * Real.log w.1)) := by
    funext w; ring
  have hUNs : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => U w.1 w.2 + Real.sqrt (2 * w.1) * F w.1 w.2 *
      Pb w.1 w.2 ((N:ℝ) * Real.log w.1) / (2 * (N:ℝ))) Ω := by
    rw [hUNeq]; exact hUNp.1
  have hUNb : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S0, ‖iteratedFDeriv ℝ k
      (fun w : ℝ × ℝ => U w.1 w.2 + Real.sqrt (2 * w.1) * F w.1 w.2 *
        Pb w.1 w.2 ((N:ℝ) * Real.log w.1) / (2 * (N:ℝ))) z‖ ≤ C := by
    rw [hUNeq]; exact hUNp.2
  have hFNs : ContDiffOn ℝ ∞ (fun w : ℝ × ℝ => F w.1 w.2 *
      Real.exp (-Pa w.1 w.2 ((N:ℝ) * Real.log w.1) / (2 * (N:ℝ)))) Ω := hFNp.1
  have hFNb : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S0, ‖iteratedFDeriv ℝ k
      (fun w : ℝ × ℝ => F w.1 w.2 *
        Real.exp (-Pa w.1 w.2 ((N:ℝ) * Real.log w.1) / (2 * (N:ℝ)))) z‖ ≤ C := hFNp.2

  have hglue : ∀ (G G0 : ℝ × ℝ → ℝ), ContDiffOn ℝ ∞ G Ω →
      ContDiffOn ℝ ∞ G0 (Ioi 0 ×ˢ Ioo (-1) 1) → (∀ w ∈ W, G w = G0 w) →
      ContDiffOn ℝ ∞ G (Ioi 0 ×ˢ Ioo (-1) 1) := by
    intro G G0 hG hG0 heq
    apply contDiffOn_of_locally_contDiffOn
    intro x hx
    by_cases hin : Xm < x.1 ∧ x.1 < Xp
    · refine ⟨Ioo Xm Xp ×ˢ univ, isOpen_Ioo.prod isOpen_univ, ⟨hin, mem_univ _⟩, hG.mono ?_⟩
      intro z hz
      exact ⟨hz.2.1, hz.1.2⟩
    · refine ⟨W, hW, ?_, (hG0.mono inter_subset_left).congr (fun z hz => heq z hz.2)⟩
      rcases not_and_or.mp hin with h | h
      · exact Or.inl (lt_of_le_of_lt (not_lt.mp h) hXm2)
      · exact Or.inr (lt_of_lt_of_le hXp (not_lt.mp h))
  have hbound : ∀ (G G0 : ℝ × ℝ → ℝ), (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ S0, ‖iteratedFDeriv ℝ k G z‖ ≤ C) →
      (∀ w ∈ W, G w = G0 w) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ k G0 (X, η)‖ ≤ C) →
      ∀ k : ℕ, ∃ C : ℝ, ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ k G (X, η)‖ ≤ C := by
    intro G G0 hGb heq hG0b k
    obtain ⟨C1, h1⟩ := hGb k
    obtain ⟨C2, h2⟩ := hG0b k
    refine ⟨max C1 C2, fun X η hX1 hX2 hη1 hη2 => ?_⟩
    by_cases hin : Xm2 ≤ X ∧ X ≤ Xp2
    · exact (h1 (X, η) ⟨hin, hη1, hη2⟩).trans (le_max_left _ _)
    · have hmem : (X, η) ∈ W := by
        rcases not_and_or.mp hin with h | h
        · exact Or.inl (not_le.mp h)
        · exact Or.inr (not_le.mp h)
      have hev : G =ᶠ[nhds (X, η)] G0 := Filter.eventuallyEq_of_mem (hW.mem_nhds hmem) heq
      rw [(hev.iteratedFDeriv ℝ k).eq_of_nhds]
      exact (h2 X η hX1 hX2 hη1 hη2).trans (le_max_right _ _)
  have hFNoff : ∀ w ∈ W, (fun w : ℝ × ℝ => F w.1 w.2 *
      Real.exp (-Pa w.1 w.2 ((N:ℝ) * Real.log w.1) / (2 * (N:ℝ)))) w = (fun w : ℝ × ℝ => F w.1 w.2) w :=
    fun w hw => (hoff w.1 w.2 (hWoff w hw)).1
  have hUNoff : ∀ w ∈ W, (fun w : ℝ × ℝ => U w.1 w.2 + Real.sqrt (2 * w.1) * F w.1 w.2 *
      Pb w.1 w.2 ((N:ℝ) * Real.log w.1) / (2 * (N:ℝ))) w = (fun w : ℝ × ℝ => U w.1 w.2) w :=
    fun w hw => (hoff w.1 w.2 (hWoff w hw)).2
  refine ⟨hoff, hglue _ _ hFNs hF hFNoff, hglue _ _ hUNs hU hUNoff,
    fun X η hX h1 h2 => mul_pos (hFpos X η hX h1 h2) (Real.exp_pos _), ?_⟩
  intro m
  obtain ⟨C1, h1⟩ := hbound _ _ hFNb hFNoff hFb m
  obtain ⟨C2, h2⟩ := hbound _ _ hUNb hUNoff hUb m
  exact ⟨max C1 C2, fun X η a b c d =>
    ⟨(h1 X η a b c d).trans (le_max_left _ _), (h2 X η a b c d).trans (le_max_right _ _)⟩⟩

theorem modulation_errors : ∀ (F U : ℝ → ℝ → ℝ) (Pa Pb : ℝ → ℝ → ℝ → ℝ) (Xm Xm2 Xp2 Xp c : ℝ), 0 < Xm → Xm < Xm2 → Xm2 < Xp2 → Xp2 < Xp → 0 < c → ContDiffOn ℝ ∞ (↿F) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿U) (Ioi 0 ×ˢ Ioo (-1) 1) → (∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 → c ≤ F X η) → (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿F) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿U) (X, η)‖ ≤ C) → ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) (Ioo Xm Xp ×ˢ Ioo (-1) 1 ×ˢ univ) → ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) (Ioo Xm Xp ×ˢ Ioo (-1) 1 ×ˢ univ) → (∀ m : ℕ, ∃ C : ℝ, ∀ z : ℝ × ℝ × ℝ, Xm2 ≤ z.1 → z.1 ≤ Xp2 → -1 < z.2.1 → z.2.1 < 1 → ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) z‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) z‖ ≤ C) → (∀ X η φ : ℝ, (X ≤ Xm2 ∨ Xp2 ≤ X) → Pa X η φ = 0 ∧ Pb X η φ = 0) → ∃ C : ℝ, ∀ N : ℕ, 1 ≤ N → ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 → |F X η * Real.exp (-Pa X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ))) - F X η| ≤ C / (N : ℝ) ∧ |U X η + Real.sqrt (2 * X) * F X η * Pb X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ)) - U X η| ≤ C / (N : ℝ) ∧ |deriv (fun e => F X e * Real.exp (-Pa X e ((N : ℝ) * Real.log X) / (2 * (N : ℝ)))) η - deriv (fun e => F X e) η| ≤ C / (N : ℝ) ∧ |deriv (fun e => U X e + Real.sqrt (2 * X) * F X e * Pb X e ((N : ℝ) * Real.log X) / (2 * (N : ℝ))) η - deriv (fun e => U X e) η| ≤ C / (N : ℝ) ∧ |shearA (fun X η : ℝ => F X η * Real.exp (-Pa X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ)))) X η - (shearA F X η + deriv (fun φ => Pa X η φ) ((N : ℝ) * Real.log X))| ≤ C / (N : ℝ) ∧ |shearB (fun X η : ℝ => F X η * Real.exp (-Pa X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ)))) (fun X η : ℝ => U X η + Real.sqrt (2 * X) * F X η * Pb X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ))) X η - (shearB F U X η + deriv (fun φ => Pb X η φ) ((N : ℝ) * Real.log X))| ≤ C / (N : ℝ) :=
by
  intro F U Pa Pb Xm Xm2 Xp2 Xp c hXm hXm2 hX2 hXp hc hFs hUs hFc hFUbd hPaS hPbS hPbd hPvan

  have t_exp : ∀ (P M n : ℝ), |P| ≤ M → 1 ≤ n → 0 < Real.exp (-P / (2 * n)) ∧
      Real.exp (-P / (2 * n)) ≤ Real.exp (M / 2) ∧ (Real.exp (-P / (2 * n)))⁻¹ ≤ Real.exp (M / 2) ∧
      |Real.exp (-P / (2 * n)) - 1| ≤ Real.exp (M / 2) * M / (2 * n) ∧
      |(Real.exp (-P / (2 * n)))⁻¹ - 1| ≤ Real.exp (M / 2) * M / (2 * n) := by
    intro P M n hP hn
    have hn0 : 0 < n := by linarith
    have hM : 0 ≤ M := le_trans (abs_nonneg _) hP
    have hta : |-P / (2 * n)| ≤ M / (2 * n) := by
      rw [abs_div, abs_neg, abs_of_pos (by positivity : (0:ℝ) < 2 * n)]
      exact div_le_div_of_nonneg_right hP (by positivity)
    set t := -P / (2 * n) with ht
    have hM2 : M / (2 * n) ≤ M / 2 := div_le_div_of_nonneg_left hM (by norm_num) (by linarith)
    have key : ∀ s : ℝ, |Real.exp s - 1| ≤ |s| * Real.exp |s| := by
      intro s
      rcases le_total 0 s with hs | hs
      · have h1 := Real.add_one_le_exp (-s)
        have h2 : 1 ≤ Real.exp s := Real.one_le_exp hs
        have h3 : Real.exp (-s) * Real.exp s = 1 := by rw [← Real.exp_add]; simp
        rw [abs_of_nonneg (by linarith), abs_of_nonneg hs]
        nlinarith [mul_le_mul_of_nonneg_right h1 (Real.exp_pos s).le]
      · have h1 := Real.add_one_le_exp s
        have h2 : Real.exp s ≤ 1 := by
          have := Real.exp_le_exp.mpr hs
          rwa [Real.exp_zero] at this
        have h4 : 1 ≤ Real.exp (-s) := Real.one_le_exp (by linarith)
        rw [abs_of_nonpos (by linarith), abs_of_nonpos hs]
        nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ -s) (by linarith : (0:ℝ) ≤ Real.exp (-s) - 1)]
    have hE : Real.exp |t| ≤ Real.exp (M/2) := Real.exp_le_exp.mpr (hta.trans hM2)
    refine ⟨Real.exp_pos _, ?_, ?_, ?_, ?_⟩
    · exact (Real.exp_le_exp.mpr (le_abs_self t)).trans hE
    · rw [← Real.exp_neg]; exact (Real.exp_le_exp.mpr (neg_le_abs t)).trans hE
    · calc |Real.exp t - 1| ≤ |t| * Real.exp |t| := key t
        _ ≤ (M / (2*n)) * Real.exp (M/2) := mul_le_mul hta hE (Real.exp_pos _).le (by positivity)
        _ = _ := by ring
    · rw [← Real.exp_neg]
      calc |Real.exp (-t) - 1| ≤ |-t| * Real.exp |-t| := key (-t)
        _ = |t| * Real.exp |t| := by rw [abs_neg]
        _ ≤ (M / (2*n)) * Real.exp (M/2) := mul_le_mul hta hE (Real.exp_pos _).le (by positivity)
        _ = _ := by ring

  have t_val : ∀ (f fe u ue Q a2 b2 E s n B M K sig : ℝ), 1 ≤ n → 0 < E → E ≤ K →
      |E - 1| ≤ K * M / (2 * n) → 0 ≤ s → s ≤ sig → |f| ≤ B → |fe| ≤ B → |Q| ≤ M → |a2| ≤ M →
      |b2| ≤ M → |f * E - f| ≤ (B * M * K + sig * B * M) / n ∧
      |u + s * f * Q / (2 * n) - u| ≤ (B * M * K + sig * B * M) / n ∧
      |fe * E - f * E * a2 / (2 * n) - fe| ≤ (B * M * K + sig * B * M) / n ∧
      |ue + s * (fe * Q + f * b2) / (2 * n) - ue| ≤ (B * M * K + sig * B * M) / n := by
    intro f fe u ue Q a2 b2 E s n B M K sig hn hE hEK hE1 hs hsig hf hfe hQ ha2 hb2
    have hn0 : 0 < n := by linarith
    have hB : 0 ≤ B := le_trans (abs_nonneg _) hf
    have hM : 0 ≤ M := le_trans (abs_nonneg _) hQ
    have hK : 0 ≤ K := by linarith
    have hsg : 0 ≤ sig := by linarith
    have hd : |(E - 1) * n| ≤ K * M / 2 := by
      rw [abs_mul, abs_of_pos hn0]
      have := mul_le_mul_of_nonneg_right hE1 hn0.le
      rwa [show K * M / (2 * n) * n = K * M / 2 by field_simp] at this
    have hBMK : 0 ≤ B * M * K := by positivity
    have hsBM : 0 ≤ sig * B * M := by positivity
    have fin : ∀ x y : ℝ, x * n = y → |y| ≤ B * M * K + sig * B * M →
        |x| ≤ (B * M * K + sig * B * M) / n := by
      intro x y hxy hy
      rw [le_div_iff₀ hn0]
      have : |x| * n = |y| := by rw [← hxy, abs_mul, abs_of_pos hn0]
      rw [this]; exact hy
    refine ⟨?_, ?_, ?_, ?_⟩
    · refine fin _ (f * ((E - 1) * n)) (by ring) ?_
      rw [abs_mul]
      calc |f| * |(E - 1) * n| ≤ B * (K * M / 2) := mul_le_mul hf hd (abs_nonneg _) hB
        _ ≤ _ := by nlinarith
    · refine fin _ (s * f * Q / 2) (by field_simp; ring) ?_
      rw [abs_div, abs_mul, abs_mul, abs_of_nonneg hs, abs_two]
      have h1 : s * |f| ≤ sig * B := mul_le_mul hsig hf (abs_nonneg _) hsg
      have h2 : s * |f| * |Q| ≤ sig * B * M := mul_le_mul h1 hQ (abs_nonneg _) (by positivity)
      nlinarith
    · refine fin _ (fe * ((E - 1) * n) - f * E * a2 / 2) (by field_simp; ring) ?_
      have h1 : |fe * ((E - 1) * n)| ≤ B * (K * M / 2) := by
        rw [abs_mul]; exact mul_le_mul hfe hd (abs_nonneg _) hB
      have h2 : |f * E * a2 / 2| ≤ B * K * M / 2 := by
        rw [abs_div, abs_mul, abs_mul, abs_of_pos hE, abs_two]
        have h3 : |f| * E ≤ B * K := mul_le_mul hf hEK hE.le hB
        have h4 : |f| * E * |a2| ≤ B * K * M := mul_le_mul h3 ha2 (abs_nonneg _) (by positivity)
        linarith
      calc |fe * ((E - 1) * n) - f * E * a2 / 2| ≤ |fe * ((E - 1) * n)| + |f * E * a2 / 2| :=
            abs_sub _ _
        _ ≤ _ := by nlinarith
    · refine fin _ (s * (fe * Q + f * b2) / 2) (by field_simp; ring) ?_
      have h1 : |fe * Q + f * b2| ≤ B * M + B * M := by
        calc |fe * Q + f * b2| ≤ |fe * Q| + |f * b2| := abs_add_le _ _
          _ ≤ B * M + B * M := by
            rw [abs_mul, abs_mul]
            exact add_le_add (mul_le_mul hfe hQ (abs_nonneg _) hB)
              (mul_le_mul hf hb2 (abs_nonneg _) hB)
      rw [abs_div, abs_mul, abs_of_nonneg hs, abs_two]
      have h2 : s * |fe * Q + f * b2| ≤ sig * (B * M + B * M) :=
        mul_le_mul hsig h1 (abs_nonneg _) hsg
      nlinarith

  have t_shear : ∀ (X Xp c f fX uX E s n B M K sig a1 a3 b1 b3 Q : ℝ), 0 < X → X ≤ Xp → 0 < c →
      c ≤ f → |fX| ≤ B → |uX| ≤ B → 1 ≤ n → 0 < E → E⁻¹ ≤ K → |E⁻¹ - 1| ≤ K * M / (2 * n) →
      s = Real.sqrt (2 * X) → s ≤ sig → |a1| ≤ M → |a3| ≤ M → |b1| ≤ M → |b3| ≤ M → |Q| ≤ M →
      |-2 * X * (fX * E - f * E * (a1 + n / X * a3) / (2 * n)) / (f * E) - (-2 * X * fX / f + a3)| ≤
        (Xp * M + M * K * (sig * B / c + M) + K * (M + 2 * Xp * B * M / c + 2 * Xp * M)) / n ∧
      |s * (uX + (f * Q / s + s * fX * Q + s * f * (b1 + n / X * b3)) / (2 * n)) / (f * E) -
          (s * uX / f + b3)| ≤
        (Xp * M + M * K * (sig * B / c + M) + K * (M + 2 * Xp * B * M / c + 2 * Xp * M)) / n := by
    intro X Xp c f fX uX E s n B M K sig a1 a3 b1 b3 Q hX hXp hc hcf hfX huX hn hE hEK hE1 hs hsig
      ha1 ha3 hb1 hb3 hQ
    have hn0 : 0 < n := by linarith
    have hf0 : 0 < f := lt_of_lt_of_le hc hcf
    have hB : 0 ≤ B := le_trans (abs_nonneg _) hfX
    have hM : 0 ≤ M := le_trans (abs_nonneg _) hQ
    have hEi : 0 < E⁻¹ := inv_pos.mpr hE
    have hK : 0 ≤ K := by linarith
    have hs0 : 0 < s := by rw [hs]; exact Real.sqrt_pos.mpr (by linarith)
    have hss : s * s = 2 * X := by rw [hs]; exact Real.mul_self_sqrt (by linarith)
    have hsg : 0 ≤ sig := by linarith
    have hXp0 : 0 ≤ Xp := by linarith
    set C6 := Xp * M + M * K * (sig * B / c + M) + K * (M + 2 * Xp * B * M / c + 2 * Xp * M)
      with hC6
    have t1 : 0 ≤ Xp * M := by positivity
    have t2 : 0 ≤ M * K * (sig * B / c + M) := by positivity
    have t3 : 0 ≤ K * (M + 2 * Xp * B * M / c + 2 * Xp * M) := by positivity
    have fin : ∀ x y : ℝ, x * n = y → |y| ≤ C6 → |x| ≤ C6 / n := by
      intro x y hxy hy
      rw [le_div_iff₀ hn0]
      have : |x| * n = |y| := by rw [← hxy, abs_mul, abs_of_pos hn0]
      rw [this]; exact hy
    have hdf : ∀ w : ℝ, |w| ≤ B → |w / f| ≤ B / c := by
      intro w hw
      rw [abs_div, abs_of_pos hf0]
      calc |w| / f ≤ B / f := div_le_div_of_nonneg_right hw hf0.le
        _ ≤ B / c := div_le_div_of_nonneg_left hB hc hcf
    constructor
    · refine fin _ (X * a1) ?_ ?_
      · field_simp
        ring
      · rw [abs_mul, abs_of_pos hX]
        calc X * |a1| ≤ Xp * M := mul_le_mul hXp ha1 (abs_nonneg _) hXp0
          _ ≤ C6 := by linarith
    · have hd : |(E⁻¹ - 1) * n| ≤ K * M / 2 := by
        rw [abs_mul, abs_of_pos hn0]
        have := mul_le_mul_of_nonneg_right hE1 hn0.le
        rwa [show K * M / (2 * n) * n = K * M / 2 by field_simp] at this
      set T := s * (uX / f) + b3 with hT
      set W := Q + 2 * X * (fX / f) * Q + 2 * X * b1 with hW
      refine fin _ ((E⁻¹ - 1) * n * T + E⁻¹ * W / 2) ?_ ?_
      · rw [hT, hW]
        have hX2 : X = s * s / 2 := by linarith
        field_simp
        rw [hX2]
        field_simp
        ring
      · have hTb : |T| ≤ sig * B / c + M := by
          calc |T| ≤ |s * (uX / f)| + |b3| := abs_add_le _ _
            _ ≤ sig * (B / c) + M := by
              rw [abs_mul, abs_of_pos hs0]
              exact add_le_add (mul_le_mul hsig (hdf uX huX) (abs_nonneg _) hsg) hb3
            _ = _ := by ring
        have hWb : |W| ≤ M + 2 * Xp * B * M / c + 2 * Xp * M := by
          have e1 : |2 * X * (fX / f) * Q| ≤ 2 * Xp * (B / c) * M := by
            rw [abs_mul, abs_mul, abs_of_pos (by linarith : (0:ℝ) < 2 * X)]
            have := mul_le_mul (by linarith : 2 * X ≤ 2 * Xp) (hdf fX hfX) (abs_nonneg _)
              (by linarith)
            exact mul_le_mul this hQ (abs_nonneg _) (by positivity)
          have e2 : |2 * X * b1| ≤ 2 * Xp * M := by
            rw [abs_mul, abs_of_pos (by linarith : (0:ℝ) < 2 * X)]
            exact mul_le_mul (by linarith) hb1 (abs_nonneg _) (by linarith)
          calc |W| ≤ |Q + 2 * X * (fX / f) * Q| + |2 * X * b1| := abs_add_le _ _
            _ ≤ |Q| + |2 * X * (fX / f) * Q| + |2 * X * b1| := by
                have := abs_add_le Q (2 * X * (fX / f) * Q); linarith
            _ ≤ M + 2 * Xp * (B / c) * M + 2 * Xp * M := by linarith
            _ = _ := by ring
        have p1 : |(E⁻¹ - 1) * n * T| ≤ K * M / 2 * (sig * B / c + M) := by
          rw [abs_mul]; exact mul_le_mul hd hTb (abs_nonneg _) (by positivity)
        have p2 : |E⁻¹ * W / 2| ≤ K * (M + 2 * Xp * B * M / c + 2 * Xp * M) / 2 := by
          rw [abs_div, abs_mul, abs_of_pos hEi, abs_two]
          have := mul_le_mul hEK hWb (abs_nonneg _) hK
          linarith
        calc |(E⁻¹ - 1) * n * T + E⁻¹ * W / 2| ≤ |(E⁻¹ - 1) * n * T| + |E⁻¹ * W / 2| :=
              abs_add_le _ _
          _ ≤ _ := by nlinarith

  have hfd2 : ∀ (g : ℝ × ℝ → ℝ) (z v : ℝ × ℝ), ‖v‖ ≤ 1 →
      |fderiv ℝ g z v| ≤ ‖iteratedFDeriv ℝ 1 g z‖ := by
    intro g z v hv
    rw [norm_iteratedFDeriv_one, ← Real.norm_eq_abs]
    calc ‖fderiv ℝ g z v‖ ≤ ‖fderiv ℝ g z‖ * ‖v‖ := (fderiv ℝ g z).le_opNorm v
      _ ≤ ‖fderiv ℝ g z‖ * 1 := mul_le_mul_of_nonneg_left hv (norm_nonneg _)
      _ = _ := mul_one _
  have hfd3 : ∀ (g : ℝ × ℝ × ℝ → ℝ) (z v : ℝ × ℝ × ℝ), ‖v‖ ≤ 1 →
      |fderiv ℝ g z v| ≤ ‖iteratedFDeriv ℝ 1 g z‖ := by
    intro g z v hv
    rw [norm_iteratedFDeriv_one, ← Real.norm_eq_abs]
    calc ‖fderiv ℝ g z v‖ ≤ ‖fderiv ℝ g z‖ * ‖v‖ := (fderiv ℝ g z).le_opNorm v
      _ ≤ ‖fderiv ℝ g z‖ * 1 := mul_le_mul_of_nonneg_left hv (norm_nonneg _)
      _ = _ := mul_one _
  have hv10 : ‖((1:ℝ), (0:ℝ))‖ ≤ 1 := by simp [Prod.norm_def]
  have hv01 : ‖((0:ℝ), (1:ℝ))‖ ≤ 1 := by simp [Prod.norm_def]
  have hv100 : ‖((1:ℝ), (0:ℝ), (0:ℝ))‖ ≤ 1 := by simp [Prod.norm_def]
  have hv010 : ‖((0:ℝ), (1:ℝ), (0:ℝ))‖ ≤ 1 := by simp [Prod.norm_def]
  have hv001 : ‖((0:ℝ), (0:ℝ), (1:ℝ))‖ ≤ 1 := by simp [Prod.norm_def]

  obtain ⟨C0, hC0⟩ := hFUbd 0
  obtain ⟨C1, hC1⟩ := hFUbd 1
  obtain ⟨D0, hD0⟩ := hPbd 0
  obtain ⟨D1, hD1⟩ := hPbd 1
  obtain ⟨B, hBC0, hBC1, hB⟩ : ∃ B : ℝ, C0 ≤ B ∧ C1 ≤ B ∧ 0 ≤ B :=
    ⟨|C0| + |C1|, by linarith [le_abs_self C0, abs_nonneg C1],
      by linarith [le_abs_self C1, abs_nonneg C0], by positivity⟩
  obtain ⟨M, hMD0, hMD1, hM⟩ : ∃ M : ℝ, D0 ≤ M ∧ D1 ≤ M ∧ 0 ≤ M :=
    ⟨|D0| + |D1|, by linarith [le_abs_self D0, abs_nonneg D1],
      by linarith [le_abs_self D1, abs_nonneg D0], by positivity⟩
  have hK : 0 < Real.exp (M / 2) := Real.exp_pos _
  have hsig : 0 ≤ Real.sqrt (2 * Xp) := Real.sqrt_nonneg _
  have hXp0 : 0 < Xp := by linarith
  have hC2 : 0 ≤ B * M * Real.exp (M / 2) + Real.sqrt (2 * Xp) * B * M := by positivity
  have hC6 : 0 ≤ Xp * M + M * Real.exp (M / 2) * (Real.sqrt (2 * Xp) * B / c + M) +
      Real.exp (M / 2) * (M + 2 * Xp * B * M / c + 2 * Xp * M) := by positivity
  obtain ⟨C, hCdef⟩ : ∃ C : ℝ, C = (B * M * Real.exp (M / 2) + Real.sqrt (2 * Xp) * B * M) +
      (Xp * M + M * Real.exp (M / 2) * (Real.sqrt (2 * Xp) * B / c + M) +
        Real.exp (M / 2) * (M + 2 * Xp * B * M / c + 2 * Xp * M)) := ⟨_, rfl⟩
  have hCnn : 0 ≤ C := by rw [hCdef]; linarith

  have key : ∀ n : ℝ, 1 ≤ n → ∀ X η : ℝ, Xm2 ≤ X → X ≤ Xp2 → -1 < η → η < 1 →
      |F X η * Real.exp (-Pa X η (n * Real.log X) / (2 * n)) - F X η| ≤ C / n ∧
      |U X η + Real.sqrt (2 * X) * F X η * Pb X η (n * Real.log X) / (2 * n) - U X η| ≤ C / n ∧
      |deriv (fun e => F X e * Real.exp (-Pa X e (n * Real.log X) / (2 * n))) η -
          deriv (fun e => F X e) η| ≤ C / n ∧
      |deriv (fun e => U X e + Real.sqrt (2 * X) * F X e * Pb X e (n * Real.log X) / (2 * n)) η -
          deriv (fun e => U X e) η| ≤ C / n ∧
      |shearA (fun X η : ℝ => F X η * Real.exp (-Pa X η (n * Real.log X) / (2 * n))) X η -
          (shearA F X η + deriv (fun φ => Pa X η φ) (n * Real.log X))| ≤ C / n ∧
      |shearB (fun X η : ℝ => F X η * Real.exp (-Pa X η (n * Real.log X) / (2 * n)))
          (fun X η : ℝ => U X η + Real.sqrt (2 * X) * F X η * Pb X η (n * Real.log X) / (2 * n)) X η -
          (shearB F U X η + deriv (fun φ => Pb X η φ) (n * Real.log X))| ≤ C / n := by
    intro n hn X η h1 h2 h3 h4
    have hn0 : 0 < n := by linarith
    have hX : 0 < X := by linarith
    have hXp' : X ≤ Xp := by linarith
    have hXm' : Xm ≤ X := by linarith
    have hS2 : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
    have hFd : DifferentiableAt ℝ (↿F) (X, η) :=
      (hFs.differentiableOn (by simp)).differentiableAt (hS2.mem_nhds ⟨hX, h3, h4⟩)
    have hUd : DifferentiableAt ℝ (↿U) (X, η) :=
      (hUs.differentiableOn (by simp)).differentiableAt (hS2.mem_nhds ⟨hX, h3, h4⟩)
    have hO3 : IsOpen (Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1 ×ˢ (univ : Set ℝ)) :=
      isOpen_Ioo.prod (isOpen_Ioo.prod isOpen_univ)
    have hz0 : ((X, η, n * Real.log X) : ℝ × ℝ × ℝ) ∈ Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1 ×ˢ (univ : Set ℝ) :=
      ⟨⟨by linarith, by linarith⟩, ⟨h3, h4⟩, mem_univ _⟩
    have hPad : DifferentiableAt ℝ (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) (X, η, n * Real.log X) :=
      (hPaS.differentiableOn (by simp)).differentiableAt (hO3.mem_nhds hz0)
    have hPbd' : DifferentiableAt ℝ (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) (X, η, n * Real.log X) :=
      (hPbS.differentiableOn (by simp)).differentiableAt (hO3.mem_nhds hz0)

    have hFX : HasDerivAt (fun Y => F Y η) (fderiv ℝ (↿F) (X, η) ((1:ℝ), (0:ℝ))) X :=
      hFd.hasFDerivAt.comp_hasDerivAt (f := fun Y : ℝ => ((Y, η) : ℝ × ℝ)) X
        ((hasDerivAt_id' X).prodMk (hasDerivAt_const X η))
    have hFe : HasDerivAt (fun e => F X e) (fderiv ℝ (↿F) (X, η) ((0:ℝ), (1:ℝ))) η :=
      hFd.hasFDerivAt.comp_hasDerivAt (f := fun e : ℝ => ((X, e) : ℝ × ℝ)) η
        ((hasDerivAt_const η X).prodMk (hasDerivAt_id' η))
    have hUX : HasDerivAt (fun Y => U Y η) (fderiv ℝ (↿U) (X, η) ((1:ℝ), (0:ℝ))) X :=
      hUd.hasFDerivAt.comp_hasDerivAt (f := fun Y : ℝ => ((Y, η) : ℝ × ℝ)) X
        ((hasDerivAt_id' X).prodMk (hasDerivAt_const X η))
    have hUe : HasDerivAt (fun e => U X e) (fderiv ℝ (↿U) (X, η) ((0:ℝ), (1:ℝ))) η :=
      hUd.hasFDerivAt.comp_hasDerivAt (f := fun e : ℝ => ((X, e) : ℝ × ℝ)) η
        ((hasDerivAt_const η X).prodMk (hasDerivAt_id' η))
    have hcurve : HasDerivAt (fun Y : ℝ => ((Y, η, n * Real.log Y) : ℝ × ℝ × ℝ))
        ((1:ℝ), (0:ℝ), n * X⁻¹) X :=
      (hasDerivAt_id' X).prodMk ((hasDerivAt_const X η).prodMk
        ((Real.hasDerivAt_log hX.ne').const_mul n))
    have hlin : ∀ L : ℝ × ℝ × ℝ →L[ℝ] ℝ, L ((1:ℝ), (0:ℝ), n * X⁻¹) =
        L ((1:ℝ), (0:ℝ), (0:ℝ)) + n / X * L ((0:ℝ), (0:ℝ), (1:ℝ)) := by
      intro L
      have : ((1:ℝ), (0:ℝ), n * X⁻¹) = ((1:ℝ), (0:ℝ), (0:ℝ)) + (n / X) • ((0:ℝ), (0:ℝ), (1:ℝ)) := by
        ext <;> simp [div_eq_mul_inv]
      rw [this, map_add, map_smul, smul_eq_mul]
    have hPaX : HasDerivAt (fun Y => Pa Y η (n * Real.log Y))
        (fderiv ℝ (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) (X, η, n * Real.log X)
          ((1:ℝ), (0:ℝ), n * X⁻¹)) X :=
      hPad.hasFDerivAt.comp_hasDerivAt (f := fun Y : ℝ => ((Y, η, n * Real.log Y) : ℝ × ℝ × ℝ)) X
        hcurve
    have hPbX : HasDerivAt (fun Y => Pb Y η (n * Real.log Y))
        (fderiv ℝ (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) (X, η, n * Real.log X)
          ((1:ℝ), (0:ℝ), n * X⁻¹)) X :=
      hPbd'.hasFDerivAt.comp_hasDerivAt (f := fun Y : ℝ => ((Y, η, n * Real.log Y) : ℝ × ℝ × ℝ)) X
        hcurve
    have hPae : HasDerivAt (fun e => Pa X e (n * Real.log X))
        (fderiv ℝ (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) (X, η, n * Real.log X)
          ((0:ℝ), (1:ℝ), (0:ℝ))) η :=
      hPad.hasFDerivAt.comp_hasDerivAt (f := fun e : ℝ => ((X, e, n * Real.log X) : ℝ × ℝ × ℝ)) η
        ((hasDerivAt_const η X).prodMk ((hasDerivAt_id' η).prodMk (hasDerivAt_const η _)))
    have hPbe : HasDerivAt (fun e => Pb X e (n * Real.log X))
        (fderiv ℝ (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) (X, η, n * Real.log X)
          ((0:ℝ), (1:ℝ), (0:ℝ))) η :=
      hPbd'.hasFDerivAt.comp_hasDerivAt (f := fun e : ℝ => ((X, e, n * Real.log X) : ℝ × ℝ × ℝ)) η
        ((hasDerivAt_const η X).prodMk ((hasDerivAt_id' η).prodMk (hasDerivAt_const η _)))
    have hPaφ : HasDerivAt (fun φ => Pa X η φ)
        (fderiv ℝ (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) (X, η, n * Real.log X)
          ((0:ℝ), (0:ℝ), (1:ℝ))) (n * Real.log X) :=
      hPad.hasFDerivAt.comp_hasDerivAt (f := fun φ : ℝ => ((X, η, φ) : ℝ × ℝ × ℝ)) (n * Real.log X)
        ((hasDerivAt_const _ X).prodMk ((hasDerivAt_const _ η).prodMk (hasDerivAt_id' _)))
    have hPbφ : HasDerivAt (fun φ => Pb X η φ)
        (fderiv ℝ (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) (X, η, n * Real.log X)
          ((0:ℝ), (0:ℝ), (1:ℝ))) (n * Real.log X) :=
      hPbd'.hasFDerivAt.comp_hasDerivAt (f := fun φ : ℝ => ((X, η, φ) : ℝ × ℝ × ℝ)) (n * Real.log X)
        ((hasDerivAt_const _ X).prodMk ((hasDerivAt_const _ η).prodMk (hasDerivAt_id' _)))
    have hsq : HasDerivAt (fun Y => Real.sqrt (2 * Y)) (2 * 1 / (2 * Real.sqrt (2 * X))) X :=
      ((hasDerivAt_id' X).const_mul 2).sqrt (by positivity)
    have hs0 : 0 < Real.sqrt (2 * X) := Real.sqrt_pos.mpr (by linarith)
    set DF := fderiv ℝ (↿F) (X, η) with hDF
    set DU := fderiv ℝ (↿U) (X, η) with hDU
    set DA := fderiv ℝ (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) (X, η, n * Real.log X) with hDA
    set DB := fderiv ℝ (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) (X, η, n * Real.log X) with hDB
    have dFe : deriv (fun e => F X e * Real.exp (-Pa X e (n * Real.log X) / (2 * n))) η =
        DF ((0:ℝ), (1:ℝ)) * Real.exp (-Pa X η (n * Real.log X) / (2 * n)) -
          F X η * Real.exp (-Pa X η (n * Real.log X) / (2 * n)) * DA ((0:ℝ), (1:ℝ), (0:ℝ)) /
            (2 * n) := by
      have h : HasDerivAt (fun e => F X e * Real.exp (-Pa X e (n * Real.log X) / (2 * n))) _ η :=
        hFe.mul (hPae.neg.div_const (2 * n)).exp
      rw [h.deriv]
      try simp only [Pi.neg_apply, Pi.mul_apply]
      ring
    have dUe : deriv (fun e => U X e + Real.sqrt (2 * X) * F X e * Pb X e (n * Real.log X) / (2 * n))
        η = DU ((0:ℝ), (1:ℝ)) + Real.sqrt (2 * X) *
          (DF ((0:ℝ), (1:ℝ)) * Pb X η (n * Real.log X) + F X η * DB ((0:ℝ), (1:ℝ), (0:ℝ))) /
            (2 * n) := by
      have h : HasDerivAt
          (fun e => U X e + Real.sqrt (2 * X) * F X e * Pb X e (n * Real.log X) / (2 * n)) _ η :=
        hUe.add (((hFe.const_mul (Real.sqrt (2 * X))).mul hPbe).div_const (2 * n))
      rw [h.deriv]
      try simp only [Pi.mul_apply]
      ring
    have dFX : deriv (fun Y => F Y η * Real.exp (-Pa Y η (n * Real.log Y) / (2 * n))) X =
        DF ((1:ℝ), (0:ℝ)) * Real.exp (-Pa X η (n * Real.log X) / (2 * n)) -
          F X η * Real.exp (-Pa X η (n * Real.log X) / (2 * n)) *
            (DA ((1:ℝ), (0:ℝ), (0:ℝ)) + n / X * DA ((0:ℝ), (0:ℝ), (1:ℝ))) / (2 * n) := by
      have h : HasDerivAt (fun Y => F Y η * Real.exp (-Pa Y η (n * Real.log Y) / (2 * n))) _ X :=
        hFX.mul (hPaX.neg.div_const (2 * n)).exp
      rw [h.deriv, hlin]
      try simp only [Pi.neg_apply, Pi.mul_apply]
      ring
    have dUX : deriv (fun Y => U Y η + Real.sqrt (2 * Y) * F Y η * Pb Y η (n * Real.log Y) / (2 * n))
        X = DU ((1:ℝ), (0:ℝ)) + (F X η * Pb X η (n * Real.log X) / Real.sqrt (2 * X) +
          Real.sqrt (2 * X) * DF ((1:ℝ), (0:ℝ)) * Pb X η (n * Real.log X) +
          Real.sqrt (2 * X) * F X η *
            (DB ((1:ℝ), (0:ℝ), (0:ℝ)) + n / X * DB ((0:ℝ), (0:ℝ), (1:ℝ)))) / (2 * n) := by
      have h : HasDerivAt
          (fun Y => U Y η + Real.sqrt (2 * Y) * F Y η * Pb Y η (n * Real.log Y) / (2 * n)) _ X :=
        hUX.add (((hsq.mul hFX).mul hPbX).div_const (2 * n))
      rw [h.deriv, hlin]
      try simp only [Pi.mul_apply]
      field_simp
      try ring

    have bF0 : |F X η| ≤ B := by
      have := (hC0 X η hXm' hXp' h3 h4).1
      rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at this
      exact this.trans hBC0
    have bFX : |DF ((1:ℝ), (0:ℝ))| ≤ B :=
      (hfd2 (↿F) (X, η) _ hv10).trans ((hC1 X η hXm' hXp' h3 h4).1.trans hBC1)
    have bFe : |DF ((0:ℝ), (1:ℝ))| ≤ B :=
      (hfd2 (↿F) (X, η) _ hv01).trans ((hC1 X η hXm' hXp' h3 h4).1.trans hBC1)
    have bUX : |DU ((1:ℝ), (0:ℝ))| ≤ B :=
      (hfd2 (↿U) (X, η) _ hv10).trans ((hC1 X η hXm' hXp' h3 h4).2.trans hBC1)
    have bUe : |DU ((0:ℝ), (1:ℝ))| ≤ B :=
      (hfd2 (↿U) (X, η) _ hv01).trans ((hC1 X η hXm' hXp' h3 h4).2.trans hBC1)
    have bP : |Pa X η (n * Real.log X)| ≤ M := by
      have := (hD0 (X, η, n * Real.log X) h1 h2 h3 h4).1
      rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at this
      exact this.trans hMD0
    have bQ : |Pb X η (n * Real.log X)| ≤ M := by
      have := (hD0 (X, η, n * Real.log X) h1 h2 h3 h4).2
      rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at this
      exact this.trans hMD0
    have hA1 := (hD1 (X, η, n * Real.log X) h1 h2 h3 h4).1
    have hB1 := (hD1 (X, η, n * Real.log X) h1 h2 h3 h4).2
    have ba1 : |DA ((1:ℝ), (0:ℝ), (0:ℝ))| ≤ M :=
      (hfd3 (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) _ _ hv100).trans (hA1.trans hMD1)
    have ba2 : |DA ((0:ℝ), (1:ℝ), (0:ℝ))| ≤ M :=
      (hfd3 (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) _ _ hv010).trans (hA1.trans hMD1)
    have ba3 : |DA ((0:ℝ), (0:ℝ), (1:ℝ))| ≤ M :=
      (hfd3 (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) _ _ hv001).trans (hA1.trans hMD1)
    have bb1 : |DB ((1:ℝ), (0:ℝ), (0:ℝ))| ≤ M :=
      (hfd3 (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) _ _ hv100).trans (hB1.trans hMD1)
    have bb2 : |DB ((0:ℝ), (1:ℝ), (0:ℝ))| ≤ M :=
      (hfd3 (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) _ _ hv010).trans (hB1.trans hMD1)
    have bb3 : |DB ((0:ℝ), (0:ℝ), (1:ℝ))| ≤ M :=
      (hfd3 (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) _ _ hv001).trans (hB1.trans hMD1)
    obtain ⟨hE0, hEK, hEiK, hE1, hEi1⟩ := t_exp (Pa X η (n * Real.log X)) M n bP hn
    have hsX : Real.sqrt (2 * X) ≤ Real.sqrt (2 * Xp) := Real.sqrt_le_sqrt (by linarith)
    have tv := t_val (F X η) (DF ((0:ℝ), (1:ℝ))) (U X η) (DU ((0:ℝ), (1:ℝ)))
      (Pb X η (n * Real.log X)) (DA ((0:ℝ), (1:ℝ), (0:ℝ))) (DB ((0:ℝ), (1:ℝ), (0:ℝ)))
      (Real.exp (-Pa X η (n * Real.log X) / (2 * n))) (Real.sqrt (2 * X)) n B M (Real.exp (M / 2))
      (Real.sqrt (2 * Xp)) hn hE0 hEK hE1 (Real.sqrt_nonneg _) hsX bF0 bFe bQ ba2 bb2
    have ts := t_shear X Xp c (F X η) (DF ((1:ℝ), (0:ℝ))) (DU ((1:ℝ), (0:ℝ)))
      (Real.exp (-Pa X η (n * Real.log X) / (2 * n))) (Real.sqrt (2 * X)) n B M (Real.exp (M / 2))
      (Real.sqrt (2 * Xp)) (DA ((1:ℝ), (0:ℝ), (0:ℝ))) (DA ((0:ℝ), (0:ℝ), (1:ℝ)))
      (DB ((1:ℝ), (0:ℝ), (0:ℝ))) (DB ((0:ℝ), (0:ℝ), (1:ℝ))) (Pb X η (n * Real.log X))
      hX hXp' hc (hFc X η hXm' hXp' h3 h4) bFX bUX hn hE0 hEiK hEi1 rfl hsX ba1 ba3 bb1 bb3 bQ
    have hle2 : (B * M * Real.exp (M / 2) + Real.sqrt (2 * Xp) * B * M) / n ≤ C / n :=
      div_le_div_of_nonneg_right (by rw [hCdef]; linarith) hn0.le
    have hle6 : (Xp * M + M * Real.exp (M / 2) * (Real.sqrt (2 * Xp) * B / c + M) +
        Real.exp (M / 2) * (M + 2 * Xp * B * M / c + 2 * Xp * M)) / n ≤ C / n :=
      div_le_div_of_nonneg_right (by rw [hCdef]; linarith) hn0.le
    refine ⟨tv.1.trans hle2, tv.2.1.trans hle2, ?_, ?_, ?_, ?_⟩
    · rw [dFe, hFe.deriv]; exact tv.2.2.1.trans hle2
    · rw [dUe, hUe.deriv]; exact tv.2.2.2.trans hle2
    · simp only [shearA]
      rw [dFX, hFX.deriv, hPaφ.deriv]
      exact ts.1.trans hle6
    · simp only [shearB]
      rw [dUX, hUX.deriv, hPbφ.deriv]
      exact ts.2.trans hle6
  refine ⟨C, fun N hN X η h1 h2 h3 h4 => ?_⟩
  have hn1 : (1:ℝ) ≤ (N:ℝ) := Nat.one_le_cast.mpr hN
  have hn0 : (0:ℝ) < (N:ℝ) := by linarith
  by_cases hoff : X < Xm2 ∨ Xp2 < X
  ·
    have hvan : ∀ Y e φ : ℝ, (Y < Xm2 ∨ Xp2 < Y) → Pa Y e φ = 0 ∧ Pb Y e φ = 0 := by
      intro Y e φ hY
      exact hPvan Y e φ (hY.imp le_of_lt le_of_lt)
    have hW : ∀ᶠ Y in nhds X, Y < Xm2 ∨ Xp2 < Y := by
      rcases hoff with h | h
      · exact Filter.mem_of_superset (Iio_mem_nhds h) fun Y hY => Or.inl hY
      · exact Filter.mem_of_superset (Ioi_mem_nhds h) fun Y hY => Or.inr hY
    have hFN : ∀ Y e : ℝ, (Y < Xm2 ∨ Xp2 < Y) →
        F Y e * Real.exp (-Pa Y e ((N:ℝ) * Real.log Y) / (2 * (N:ℝ))) = F Y e := by
      intro Y e hY
      rw [(hvan Y e ((N:ℝ) * Real.log Y) hY).1]
      simp
    have hUN : ∀ Y e : ℝ, (Y < Xm2 ∨ Xp2 < Y) →
        U Y e + Real.sqrt (2 * Y) * F Y e * Pb Y e ((N:ℝ) * Real.log Y) / (2 * (N:ℝ)) = U Y e := by
      intro Y e hY
      rw [(hvan Y e ((N:ℝ) * Real.log Y) hY).2]
      simp
    have e3 : deriv (fun e => F X e * Real.exp (-Pa X e ((N:ℝ) * Real.log X) / (2 * (N:ℝ)))) η =
        deriv (fun e => F X e) η :=
      congrArg (fun g => deriv g η) (funext fun e => hFN X e hoff)
    have e4 : deriv (fun e => U X e + Real.sqrt (2 * X) * F X e * Pb X e ((N:ℝ) * Real.log X) /
        (2 * (N:ℝ))) η = deriv (fun e => U X e) η :=
      congrArg (fun g => deriv g η) (funext fun e => hUN X e hoff)
    have e5 : deriv (fun Y => F Y η * Real.exp (-Pa Y η ((N:ℝ) * Real.log Y) / (2 * (N:ℝ)))) X =
        deriv (fun Y => F Y η) X :=
      Filter.EventuallyEq.deriv_eq (hW.mono fun Y hY => hFN Y η hY)
    have e6 : deriv (fun Y => U Y η + Real.sqrt (2 * Y) * F Y η * Pb Y η ((N:ℝ) * Real.log Y) /
        (2 * (N:ℝ))) X = deriv (fun Y => U Y η) X :=
      Filter.EventuallyEq.deriv_eq (hW.mono fun Y hY => hUN Y η hY)
    have e7 : deriv (fun φ => Pa X η φ) ((N:ℝ) * Real.log X) = 0 := by
      have : (fun φ => Pa X η φ) = fun _ => (0:ℝ) := funext fun φ => (hvan X η φ hoff).1
      rw [this, deriv_const]
    have e8 : deriv (fun φ => Pb X η φ) ((N:ℝ) * Real.log X) = 0 := by
      have : (fun φ => Pb X η φ) = fun _ => (0:ℝ) := funext fun φ => (hvan X η φ hoff).2
      rw [this, deriv_const]
    have hz : 0 ≤ C / (N:ℝ) := div_nonneg hCnn hn0.le
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [hFN X η hoff, sub_self, abs_zero]; exact hz
    · rw [hUN X η hoff, sub_self, abs_zero]; exact hz
    · rw [e3, sub_self, abs_zero]; exact hz
    · rw [e4, sub_self, abs_zero]; exact hz
    · simp only [shearA]
      rw [e5, e7, hFN X η hoff, add_zero, sub_self, abs_zero]; exact hz
    · simp only [shearB]
      rw [e6, e8, hFN X η hoff, add_zero, sub_self, abs_zero]; exact hz
  · push_neg at hoff
    exact key (N:ℝ) hn1 X η hoff.1 hoff.2 h3 h4

theorem modulation_family : LoopProperty → LeadPsRegularity → ∀ (h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xan Xm Xm2 Xp2 Xp r1 r2 : ℝ) (F U : ℝ → ℝ → ℝ), JoinProf h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xan Xm Xm2 Xp2 Xp r1 r2 F U → ∃ FN UN : ℕ → ℝ → ℝ → ℝ, ModulatedFamily h Xm Xp F U FN UN :=
by
  intro hLoop hLPR h lam cinf cpatch Xa Xb Xv Xc p1 p2 m1 m2 aa ab Xan Xm Xm2 Xp2 Xp r1 r2 F U hJ
  obtain ⟨⟨hh0, hh1, _hlam, _hcinf, _hcp, _haa, _hab, hXa, hXap1, hp12, hp2m1, hm12, hm2Xv, hXvXc,
      hXcXb, hXaXan, hXanXm, hXmXm2, hXm2Xp2, hXp2Xp, hXpr1, hr12, hr2p1⟩, _hr, _hst, hAdm,
      ⟨μ, hμ, hRC⟩, hInt, ⟨hFs, hUs, hFpos, hFbd⟩, ⟨ε, hε, hFε, hUε, hF0, hbdε⟩, _hAn, hExt,
      _hXv, _hpatch, _hmom, _hedge⟩ := hJ
  obtain ⟨_, _, ⟨κa, hκa, _hκa2, hκaS⟩⟩ := hAdm
  have hXm0 : 0 < Xm := by linarith
  have hXpXb : Xp < Xb := by linarith
  have hXb0 : 0 < Xb := by linarith

  have hPR : ProfileReg h cinf Xb ε F U := by
    refine ⟨hFε, hUε, ?_, hbdε, fun η h1 h2 => (hInt η h1 h2).1, hExt⟩
    intro X η hX h1 h2
    rcases eq_or_lt_of_le hX with hX0 | hX0
    · rw [← hX0]; exact hF0 η h1 h2
    · exact hFpos X η hX0 h1 h2
  have hFμ : ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 → μ ≤ F X η :=
    fun X η h1 h2 h3 h4 => (hRC X ⟨h1, h2⟩ η h3 h4).1
  obtain ⟨⟨_hP1s, _hP2s, _, _⟩, hPbd0⟩ := hLPR h cinf Xb ε F U hh0 hh1 hXb0 hε hPR
  have hPbd := hPbd0 Xm Xp μ hXm0 hμ hFμ
  have hFUbd := hFbd Xm Xp hXm0
  obtain ⟨hAs, hBs, hABbd⟩ := shear_jet_bounds F U Xm Xp μ hXm0 hμ hFs hUs hFpos hFμ hFUbd
  have hP1s := _hP1s
  have hP2s := _hP2s

  obtain ⟨Ca, hCa⟩ := hABbd 0
  obtain ⟨Cp, hCp⟩ := hPbd 0
  set A : ℝ := |Ca| + |Cp| + 1 with hAdef
  have hApos : 0 < A := by positivity
  have hw : ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 →
      μ ≤ shearA F X η ∧ shearA F X η ≤ A ∧ |shearB F U X η| ≤ A ∧ |psLead1 h F U X η| ≤ A ∧
        |psLead2 h F U X η| ≤ A := by
    intro X η h1 h2 h3 h4
    have hA1 : |shearA F X η| ≤ Ca := by
      have := (hCa X η h1 h2 h3 h4).1
      rwa [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at this
    have hA2 : |shearB F U X η| ≤ Ca := by
      have := (hCa X η h1 h2 h3 h4).2
      rwa [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at this
    have hB1 : |psLead1 h F U X η| ≤ Cp := by
      have := (hCp X η h1 h2 h3 h4).1
      rwa [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at this
    have hB2 : |psLead2 h F U X η| ≤ Cp := by
      have := (hCp X η h1 h2 h3 h4).2.1
      rwa [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at this
    have e1 := le_abs_self Ca
    have e2 := le_abs_self Cp
    have e3 := abs_nonneg Ca
    have e4 := abs_nonneg Cp
    have e5 := le_abs_self (shearA F X η)
    refine ⟨(hRC X ⟨h1, h2⟩ η h3 h4).2.1, ?_, ?_, ?_, ?_⟩ <;> linarith

  obtain ⟨κL, hκL, aL, bL, hsmA, hsmB, hper, hmarg⟩ := hLoop μ A κa hμ hApos hκa
  obtain ⟨V, hV⟩ : ∃ V : Set (ℝ × ℝ × ℝ × ℝ), V = {p | μ / 2 < p.1 ∧ |p.2.2.2| < 2 * A} :=
    ⟨_, rfl⟩
  have hVo : IsOpen V := by
    rw [hV, Set.setOf_and]
    exact IsOpen.inter (isOpen_lt (by fun_prop) (by fun_prop)) (isOpen_lt (by fun_prop) (by fun_prop))
  obtain ⟨ga, hga⟩ : ∃ ga : ℝ × ℝ × ℝ × ℝ → ℝ → ℝ,
      ga = fun p s => aL p.1 p.2.1 p.2.2.1 p.2.2.2 s - p.1 := ⟨_, rfl⟩
  obtain ⟨gb, hgb⟩ : ∃ gb : ℝ × ℝ × ℝ × ℝ → ℝ → ℝ,
      gb = fun p s => bL p.1 p.2.1 p.2.2.1 p.2.2.2 s - p.2.1 := ⟨_, rfl⟩
  have hemb : ContDiff ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ =>
      ((z.1.1, z.1.2.1, z.1.2.2.1, z.1.2.2.2, z.2) : ℝ × ℝ × ℝ × ℝ × ℝ)) := by fun_prop
  have hembM : MapsTo (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ =>
      ((z.1.1, z.1.2.1, z.1.2.2.1, z.1.2.2.2, z.2) : ℝ × ℝ × ℝ × ℝ × ℝ)) (V ×ˢ univ)
      {z : ℝ × ℝ × ℝ × ℝ × ℝ | μ / 2 < z.1 ∧ |z.2.2.2.1| < 2 * A} := by
    intro z hz
    rw [hV] at hz
    exact hz.1
  have hfst1 : ContDiff ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => z.1.1) := by fun_prop
  have hfst2 : ContDiff ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => z.1.2.1) := by fun_prop
  have hgaS : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => ga z.1 z.2) (V ×ˢ univ) := by
    rw [hga]
    exact (hsmA.comp hemb.contDiffOn hembM).sub hfst1.contDiffOn
  have hgbS : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => gb z.1 z.2) (V ×ˢ univ) := by
    rw [hgb]
    exact (hsmB.comp hemb.contDiffOn hembM).sub hfst2.contDiffOn
  have hcontA : ∀ p ∈ V, Continuous (fun s => aL p.1 p.2.1 p.2.2.1 p.2.2.2 s) := by
    intro p hp
    rw [hV] at hp
    exact hsmA.continuousOn.comp_continuous
      (f := fun s : ℝ => ((p.1, p.2.1, p.2.2.1, p.2.2.2, s) : ℝ × ℝ × ℝ × ℝ × ℝ)) (by fun_prop)
      (fun s => hp)
  have hcontB : ∀ p ∈ V, Continuous (fun s => bL p.1 p.2.1 p.2.2.1 p.2.2.2 s) := by
    intro p hp
    rw [hV] at hp
    exact hsmB.continuousOn.comp_continuous
      (f := fun s : ℝ => ((p.1, p.2.1, p.2.2.1, p.2.2.2, s) : ℝ × ℝ × ℝ × ℝ × ℝ)) (by fun_prop)
      (fun s => hp)
  have hgaP : ∀ p ∈ V, ∀ s : ℝ, ga p (s + 1) = ga p s := by
    intro p hp s
    have hp' := hp
    rw [hV] at hp'
    simp only [hga, ((hper p.1 p.2.1 p.2.2.1 p.2.2.2 hp'.1 hp'.2).1 s).1]
  have hgbP : ∀ p ∈ V, ∀ s : ℝ, gb p (s + 1) = gb p s := by
    intro p hp s
    have hp' := hp
    rw [hV] at hp'
    simp only [hgb, ((hper p.1 p.2.1 p.2.2.1 p.2.2.2 hp'.1 hp'.2).1 s).2]
  have hgaM : ∀ p ∈ V, (∫ s in (0:ℝ)..1, ga p s) = 0 := by
    intro p hp
    have hp' := hp
    rw [hV] at hp'
    simp only [hga]
    rw [intervalIntegral.integral_sub ((hcontA p hp).intervalIntegrable 0 1) intervalIntegrable_const,
      (hper p.1 p.2.1 p.2.2.1 p.2.2.2 hp'.1 hp'.2).2.1]
    simp
  have hgbM : ∀ p ∈ V, (∫ s in (0:ℝ)..1, gb p s) = 0 := by
    intro p hp
    have hp' := hp
    rw [hV] at hp'
    simp only [hgb]
    rw [intervalIntegral.integral_sub ((hcontB p hp).intervalIntegrable 0 1) intervalIntegrable_const,
      (hper p.1 p.2.1 p.2.2.1 p.2.2.2 hp'.1 hp'.2).2.2.1]
    simp

  obtain ⟨hQaS0, hQaD, hQaB⟩ := periodic_primitive_smooth V ga hVo hgaS hgaP hgaM
  obtain ⟨hQbS0, hQbD, hQbB⟩ := periodic_primitive_smooth V gb hVo hgbS hgbP hgbM
  obtain ⟨K, hK⟩ : ∃ K : Set (ℝ × ℝ × ℝ × ℝ),
      K = Icc μ A ×ˢ Icc (-A) A ×ˢ Icc (-A) A ×ˢ Icc (-A) A := ⟨_, rfl⟩
  have hKc : IsCompact K := by
    rw [hK]
    exact isCompact_Icc.prod (isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc))
  have hKV : K ⊆ V := by
    intro p hp
    rw [hK] at hp
    rw [hV]
    have := abs_le.mpr hp.2.2.2
    show μ / 2 < p.1 ∧ |p.2.2.2| < 2 * A
    constructor
    · linarith [hp.1.1]
    · linarith
  obtain ⟨C1a, hC1a⟩ := hQaB K hKc hKV 0
  obtain ⟨C1b, hC1b⟩ := hQbB K hKc hKV 0
  have hgaK : ∀ p ∈ K, ∀ φ : ℝ, |ga p φ| ≤ C1a := by
    intro p hp φ
    have := (hC1a p hp φ).2
    simpa only [norm_iteratedFDeriv_zero, Real.norm_eq_abs] using this
  have hgbK : ∀ p ∈ K, ∀ φ : ℝ, |gb p φ| ≤ C1b := by
    intro p hp φ
    have := (hC1b p hp φ).2
    simpa only [norm_iteratedFDeriv_zero, Real.norm_eq_abs] using this
  obtain ⟨Qa, hQa⟩ : ∃ Qa : ℝ × ℝ × ℝ × ℝ → ℝ → ℝ, Qa = fun p φ => ∫ s in (0:ℝ)..φ, ga p s :=
    ⟨_, rfl⟩
  obtain ⟨Qb, hQb⟩ : ∃ Qb : ℝ × ℝ × ℝ × ℝ → ℝ → ℝ, Qb = fun p φ => ∫ s in (0:ℝ)..φ, gb p s :=
    ⟨_, rfl⟩
  have hQaS : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => Qa z.1 z.2) (V ×ˢ univ) := by
    rw [hQa]; exact hQaS0
  have hQbS : ContDiffOn ℝ ∞ (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => Qb z.1 z.2) (V ×ˢ univ) := by
    rw [hQb]; exact hQbS0
  have hQaBd : ∀ m : ℕ, ∃ C : ℝ, ∀ p ∈ K, ∀ φ : ℝ,
      ‖iteratedFDeriv ℝ m (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => Qa z.1 z.2) (p, φ)‖ ≤ C := by
    intro m
    obtain ⟨C, hC⟩ := hQaB K hKc hKV m
    refine ⟨C, fun p hp φ => ?_⟩
    rw [hQa]; exact (hC p hp φ).1
  have hQbBd : ∀ m : ℕ, ∃ C : ℝ, ∀ p ∈ K, ∀ φ : ℝ,
      ‖iteratedFDeriv ℝ m (fun z : (ℝ × ℝ × ℝ × ℝ) × ℝ => Qb z.1 z.2) (p, φ)‖ ≤ C := by
    intro m
    obtain ⟨C, hC⟩ := hQbB K hKc hKV m
    refine ⟨C, fun p hp φ => ?_⟩
    rw [hQb]; exact (hC p hp φ).1

  have hΩo : IsOpen (Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioo.prod isOpen_Ioo
  have hSΩ : Icc Xm2 Xp2 ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1 := by
    intro z hz
    exact ⟨⟨by linarith [hz.1.1], by linarith [hz.1.2]⟩, hz.2⟩
  have hΩsub : Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi 0 ×ˢ Ioo (-1) 1 := by
    intro z hz
    exact ⟨show (0:ℝ) < z.1 by linarith [hz.1.1], hz.2⟩
  have hwV : ∀ z ∈ Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1, (shearA F z.1 z.2, shearB F U z.1 z.2,
      psLead1 h F U z.1 z.2, psLead2 h F U z.1 z.2) ∈ V := by
    intro z hz
    obtain ⟨w1, _, _, _, w5⟩ := hw z.1 z.2 hz.1.1.le hz.1.2.le hz.2.1 hz.2.2
    rw [hV]
    show μ / 2 < shearA F z.1 z.2 ∧ |psLead2 h F U z.1 z.2| < 2 * A
    constructor <;> linarith
  have hwK : ∀ z ∈ Icc Xm2 Xp2 ×ˢ Ioo (-1:ℝ) 1, (shearA F z.1 z.2, shearB F U z.1 z.2,
      psLead1 h F U z.1 z.2, psLead2 h F U z.1 z.2) ∈ K := by
    intro z hz
    have h1 : Xm ≤ z.1 := by linarith [hz.1.1]
    have h2 : z.1 ≤ Xp := by linarith [hz.1.2]
    obtain ⟨w1, w2, w3, w4, w5⟩ := hw z.1 z.2 h1 h2 hz.2.1 hz.2.2
    rw [hK]
    exact ⟨⟨w1, w2⟩, abs_le.mp w3, abs_le.mp w4, abs_le.mp w5⟩
  have hwbd : ∀ m : ℕ, ∃ C : ℝ, ∀ z ∈ Icc Xm2 Xp2 ×ˢ Ioo (-1:ℝ) 1,
      ‖iteratedFDeriv ℝ m (↿(shearA F)) z‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(shearB F U)) z‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (↿(psLead1 h F U)) z‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (↿(psLead2 h F U)) z‖ ≤ C := by
    intro m
    obtain ⟨C1, hC1⟩ := hABbd m
    obtain ⟨C2, hC2⟩ := hPbd m
    refine ⟨max C1 C2, fun z hz => ?_⟩
    have h1 : Xm ≤ z.1 := by linarith [hz.1.1]
    have h2 : z.1 ≤ Xp := by linarith [hz.1.2]
    obtain ⟨a1, a2⟩ := hC1 z.1 z.2 h1 h2 hz.2.1 hz.2.2
    obtain ⟨b1, b2, _, _⟩ := hC2 z.1 z.2 h1 h2 hz.2.1 hz.2.2
    exact ⟨a1.trans (le_max_left _ _), a2.trans (le_max_left _ _), b1.trans (le_max_right _ _),
      b2.trans (le_max_right _ _)⟩
  obtain ⟨hQawS, hQawB⟩ := phase_compose (shearA F) (shearB F U) (psLead1 h F U) (psLead2 h F U)
    (Ioo Xm Xp ×ˢ Ioo (-1) 1) (Icc Xm2 Xp2 ×ˢ Ioo (-1) 1) V K Qa hΩo hSΩ hVo hKV
    (hAs.mono hΩsub) (hBs.mono hΩsub) (hP1s.mono hΩsub) (hP2s.mono hΩsub) hwV hwK hwbd hQaS hQaBd
  obtain ⟨hQbwS, hQbwB⟩ := phase_compose (shearA F) (shearB F U) (psLead1 h F U) (psLead2 h F U)
    (Ioo Xm Xp ×ˢ Ioo (-1) 1) (Icc Xm2 Xp2 ×ˢ Ioo (-1) 1) V K Qb hΩo hSΩ hVo hKV
    (hAs.mono hΩsub) (hBs.mono hΩsub) (hP1s.mono hΩsub) (hP2s.mono hΩsub) hwV hwK hwbd hQbS hQbBd

  have hT : ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 → (X ≤ Xm2 ∨ Xp2 ≤ X) → ∀ s : ℝ,
      aL (shearA F X η) (shearB F U X η) (psLead1 h F U X η) (psLead2 h F U X η) s = shearA F X η ∧
      bL (shearA F X η) (shearB F U X η) (psLead1 h F U X η) (psLead2 h F U X η) s =
        shearB F U X η := by
    intro X η h1 h2 h3 h4 hc s
    obtain ⟨w1, _, _, _, w5⟩ := hw X η h1 h2 h3 h4
    have hmem : X ∈ Ioc Xa Xm2 ∪ Ico Xp2 Xb := by
      rcases hc with hc | hc
      · exact Or.inl ⟨by linarith, hc⟩
      · exact Or.inr ⟨hc, by linarith⟩
    have hk := (hκaS X hmem η h3 h4).2.2.1
    exact (hper _ _ _ _ (by linarith) (by linarith)).2.2.2 (by linarith) s
  have hQT : ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 → (X ≤ Xm2 ∨ Xp2 ≤ X) → ∀ φ : ℝ,
      Qa (shearA F X η, shearB F U X η, psLead1 h F U X η, psLead2 h F U X η) φ = 0 ∧
      Qb (shearA F X η, shearB F U X η, psLead1 h F U X η, psLead2 h F U X η) φ = 0 := by
    intro X η h1 h2 h3 h4 hc φ
    have ea : ∀ s : ℝ,
        ga (shearA F X η, shearB F U X η, psLead1 h F U X η, psLead2 h F U X η) s = 0 := by
      intro s
      simp only [hga, (hT X η h1 h2 h3 h4 hc s).1, sub_self]
    have eb : ∀ s : ℝ,
        gb (shearA F X η, shearB F U X η, psLead1 h F U X η, psLead2 h F U X η) s = 0 := by
      intro s
      simp only [hgb, (hT X η h1 h2 h3 h4 hc s).2, sub_self]
    simp only [hQa, hQb, ea, eb, intervalIntegral.integral_zero, and_self]

  obtain ⟨Pa, hPa⟩ : ∃ Pa : ℝ → ℝ → ℝ → ℝ, Pa = fun X η φ => if Xm2 < X ∧ X < Xp2 then
      Qa (shearA F X η, shearB F U X η, psLead1 h F U X η, psLead2 h F U X η) φ else 0 := ⟨_, rfl⟩
  obtain ⟨Pb, hPb⟩ : ∃ Pb : ℝ → ℝ → ℝ → ℝ, Pb = fun X η φ => if Xm2 < X ∧ X < Xp2 then
      Qb (shearA F X η, shearB F U X η, psLead1 h F U X η, psLead2 h F U X η) φ else 0 := ⟨_, rfl⟩
  have hPvan : ∀ X η φ : ℝ, (X ≤ Xm2 ∨ Xp2 ≤ X) → Pa X η φ = 0 ∧ Pb X η φ = 0 := by
    intro X η φ hc
    have hin : ¬ (Xm2 < X ∧ X < Xp2) := by
      rintro ⟨h1, h2⟩
      rcases hc with hc | hc <;> linarith
    simp only [hPa, hPb, if_neg hin, and_self]
  have hPaEq : ∀ X η φ : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 →
      Pa X η φ = Qa (shearA F X η, shearB F U X η, psLead1 h F U X η, psLead2 h F U X η) φ ∧
      Pb X η φ = Qb (shearA F X η, shearB F U X η, psLead1 h F U X η, psLead2 h F U X η) φ := by
    intro X η φ h1 h2 h3 h4
    by_cases hin : Xm2 < X ∧ X < Xp2
    · simp only [hPa, hPb, if_pos hin, and_self]
    · have hc : X ≤ Xm2 ∨ Xp2 ≤ X := by
        rcases not_and_or.mp hin with hc | hc
        · exact Or.inl (not_lt.mp hc)
        · exact Or.inr (not_lt.mp hc)
      obtain ⟨q1, q2⟩ := hQT X η h1 h2 h3 h4 hc φ
      rw [q1, q2]
      exact hPvan X η φ hc
  have hO3 : IsOpen (Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1 ×ˢ (univ : Set ℝ)) :=
    isOpen_Ioo.prod (isOpen_Ioo.prod isOpen_univ)
  have hO3sub : Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1 ×ˢ (univ : Set ℝ) ⊆
      {z : ℝ × ℝ × ℝ | (z.1, z.2.1) ∈ Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1} :=
    fun z hz => show (z.1, z.2.1) ∈ Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1 from ⟨hz.1, hz.2.1⟩
  have hPaO : ∀ z ∈ Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1 ×ˢ (univ : Set ℝ), Pa z.1 z.2.1 z.2.2 =
      Qa (shearA F z.1 z.2.1, shearB F U z.1 z.2.1, psLead1 h F U z.1 z.2.1,
        psLead2 h F U z.1 z.2.1) z.2.2 :=
    fun z hz => (hPaEq z.1 z.2.1 z.2.2 hz.1.1.le hz.1.2.le hz.2.1.1 hz.2.1.2).1
  have hPbO : ∀ z ∈ Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1 ×ˢ (univ : Set ℝ), Pb z.1 z.2.1 z.2.2 =
      Qb (shearA F z.1 z.2.1, shearB F U z.1 z.2.1, psLead1 h F U z.1 z.2.1,
        psLead2 h F U z.1 z.2.1) z.2.2 :=
    fun z hz => (hPaEq z.1 z.2.1 z.2.2 hz.1.1.le hz.1.2.le hz.2.1.1 hz.2.1.2).2
  have hPaS : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2)
      (Ioo Xm Xp ×ˢ Ioo (-1) 1 ×ˢ univ) := (hQawS.mono hO3sub).congr hPaO
  have hPbS : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2)
      (Ioo Xm Xp ×ˢ Ioo (-1) 1 ×ˢ univ) := (hQbwS.mono hO3sub).congr hPbO
  have hPabd : ∀ m : ℕ, ∃ C : ℝ, ∀ z : ℝ × ℝ × ℝ, Xm2 ≤ z.1 → z.1 ≤ Xp2 → -1 < z.2.1 →
      z.2.1 < 1 → ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) z‖ ≤ C ∧
      ‖iteratedFDeriv ℝ m (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) z‖ ≤ C := by
    intro m
    obtain ⟨C1, hC1⟩ := hQawB m
    obtain ⟨C2, hC2⟩ := hQbwB m
    refine ⟨max C1 C2, fun z h1 h2 h3 h4 => ?_⟩
    have hz : z ∈ Ioo Xm Xp ×ˢ Ioo (-1:ℝ) 1 ×ˢ (univ : Set ℝ) :=
      ⟨⟨by linarith, by linarith⟩, ⟨h3, h4⟩, mem_univ _⟩
    have hzS : (z.1, z.2.1) ∈ Icc Xm2 Xp2 ×ˢ Ioo (-1:ℝ) 1 := ⟨⟨h1, h2⟩, h3, h4⟩
    have ev1 : (fun z : ℝ × ℝ × ℝ => Pa z.1 z.2.1 z.2.2) =ᶠ[nhds z]
        (fun z : ℝ × ℝ × ℝ => Qa (shearA F z.1 z.2.1, shearB F U z.1 z.2.1, psLead1 h F U z.1 z.2.1,
          psLead2 h F U z.1 z.2.1) z.2.2) := Filter.eventuallyEq_of_mem (hO3.mem_nhds hz) hPaO
    have ev2 : (fun z : ℝ × ℝ × ℝ => Pb z.1 z.2.1 z.2.2) =ᶠ[nhds z]
        (fun z : ℝ × ℝ × ℝ => Qb (shearA F z.1 z.2.1, shearB F U z.1 z.2.1, psLead1 h F U z.1 z.2.1,
          psLead2 h F U z.1 z.2.1) z.2.2) := Filter.eventuallyEq_of_mem (hO3.mem_nhds hz) hPbO
    rw [(ev1.iteratedFDeriv ℝ m).eq_of_nhds, (ev2.iteratedFDeriv ℝ m).eq_of_nhds]
    exact ⟨(hC1 z hzS).trans (le_max_left _ _), (hC2 z hzS).trans (le_max_right _ _)⟩

  have hsid : ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 → ∀ φ : ℝ,
      shearA F X η + deriv (fun φ => Pa X η φ) φ =
        aL (shearA F X η) (shearB F U X η) (psLead1 h F U X η) (psLead2 h F U X η) φ ∧
      shearB F U X η + deriv (fun φ => Pb X η φ) φ =
        bL (shearA F X η) (shearB F U X η) (psLead1 h F U X η) (psLead2 h F U X η) φ := by
    intro X η h1 h2 h3 h4 φ
    by_cases hin : Xm2 < X ∧ X < Xp2
    · have hwv : (shearA F X η, shearB F U X η, psLead1 h F U X η, psLead2 h F U X η) ∈ V :=
        hwV (X, η) ⟨⟨by linarith, by linarith⟩, h3, h4⟩
      have ea : (fun φ => Pa X η φ) = fun ψ => ∫ s in (0:ℝ)..ψ,
          ga (shearA F X η, shearB F U X η, psLead1 h F U X η, psLead2 h F U X η) s := by
        funext ψ
        simp only [hPa, hQa, if_pos hin]
      have eb : (fun φ => Pb X η φ) = fun ψ => ∫ s in (0:ℝ)..ψ,
          gb (shearA F X η, shearB F U X η, psLead1 h F U X η, psLead2 h F U X η) s := by
        funext ψ
        simp only [hPb, hQb, if_pos hin]
      rw [ea, eb, (hQaD _ hwv φ).deriv, (hQbD _ hwv φ).deriv]
      simp only [hga, hgb]
      constructor <;> ring
    · have hc : X ≤ Xm2 ∨ Xp2 ≤ X := by
        rcases not_and_or.mp hin with hc | hc
        · exact Or.inl (not_lt.mp hc)
        · exact Or.inr (not_lt.mp hc)
      obtain ⟨e1, e2⟩ := hT X η h1 h2 h3 h4 hc φ
      have ea : (fun φ => Pa X η φ) = fun _ => (0:ℝ) := by
        funext ψ; exact (hPvan X η ψ hc).1
      have eb : (fun φ => Pb X η φ) = fun _ => (0:ℝ) := by
        funext ψ; exact (hPvan X η ψ hc).2
      rw [ea, eb, deriv_const, e1, e2]
      constructor <;> ring

  obtain ⟨C5, hC5⟩ := modulation_errors F U Pa Pb Xm Xm2 Xp2 Xp μ hXm0 hXmXm2 hXm2Xp2 hXp2Xp hμ
    hFs hUs hFμ hFUbd hPaS hPbS hPabd hPvan
  set A' : ℝ := A + |C1a| + |C1b| + 1 with hA'def
  have hA'pos : 0 < A' := by positivity
  obtain ⟨τ, hτ0, hτ1, hgap⟩ := gap_stability κL A' A hκL hA'pos hApos
  set C : ℝ := max C5 0 with hCdef
  set κ : ℝ := min (κL / 2) (1 / (A' + 1)) with hκdef
  have hκpos : 0 < κ := lt_min (by linarith) (by positivity)
  have hκ1 : κ ≤ κL / 2 := min_le_left _ _
  have hκ2 : κ ≤ 1 / (A' + 1) := min_le_right _ _
  have hinvκ : A' + 1 ≤ 1 / κ := by
    rw [le_div_iff₀ hκpos, mul_comm]
    exact (le_div_iff₀ (by positivity)).mp hκ2
  refine ⟨fun N X η => F X η * Real.exp (-Pa X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ))),
    fun N X η => U X η + Real.sqrt (2 * X) * F X η * Pb X η ((N : ℝ) * Real.log X) / (2 * (N : ℝ)),
    Xm2, Xp2, κ, C, ⌈C / τ⌉₊ + 1, hXmXm2, hXm2Xp2, hXp2Xp, hκpos, by omega, ?_⟩
  intro N hN
  beta_reduce
  have hN1 : 1 ≤ N := le_trans (by omega) hN
  have hNpos : (0:ℝ) < N := by exact_mod_cast (by omega : 0 < N)
  have hCN : C / N ≤ τ := by
    have hc1 : C / τ ≤ (⌈C / τ⌉₊ : ℝ) := Nat.le_ceil _
    have hc2 : ((⌈C / τ⌉₊ + 1 : ℕ) : ℝ) ≤ N := by exact_mod_cast hN
    push_cast at hc2
    have hc3 : C / τ ≤ N := by linarith
    rw [div_le_iff₀ hNpos, mul_comm]
    exact (div_le_iff₀ hτ0).mp hc3
  have hCC : C5 / N ≤ C / N := div_le_div_of_nonneg_right (le_max_left _ _) hNpos.le
  obtain ⟨hoff, hFNs, hUNs, hFNpos, hFNbd⟩ := modulation_regularity F U Pa Pb Xm Xm2 Xp2 Xp hXm0
    hXmXm2 hXm2Xp2 hXp2Xp hFs hUs hFpos hFUbd hPaS hPbS hPabd hPvan N hN1
  refine ⟨hoff, hFNs, hUNs, hFNpos, hFNbd, ?_⟩
  intro X η h1 h2 h3 h4
  obtain ⟨e1, e2, e3, e4, e5, e6⟩ := hC5 N hN1 X η h1 h2 h3 h4
  obtain ⟨w1, w2, w3, w4, w5⟩ := hw X η h1 h2 h3 h4
  obtain ⟨_, _, rc3, rc4⟩ := hRC X ⟨h1, h2⟩ η h3 h4
  obtain ⟨sa, sb⟩ := hsid X η h1 h2 h3 h4 ((N : ℝ) * Real.log X)
  rw [sa] at e5
  rw [sb] at e6
  obtain ⟨g1, g2, g3, g4⟩ := hmarg (shearA F X η) (shearB F U X η) (psLead1 h F U X η)
    (psLead2 h F U X η) ((N : ℝ) * Real.log X) w1 w2 w3 w4 w5 rc3 rc4
  have hmemK : (shearA F X η, shearB F U X η, psLead1 h F U X η, psLead2 h F U X η) ∈ K := by
    rw [hK]
    exact ⟨⟨w1, w2⟩, abs_le.mp w3, abs_le.mp w4, abs_le.mp w5⟩
  have ga1 := hgaK _ hmemK ((N : ℝ) * Real.log X)
  have gb1 := hgbK _ hmemK ((N : ℝ) * Real.log X)
  simp only [hga, hgb] at ga1 gb1
  have hαA : aL (shearA F X η) (shearB F U X η) (psLead1 h F U X η) (psLead2 h F U X η)
      ((N : ℝ) * Real.log X) ≤ A' := by
    have := (abs_le.mp ga1).2
    have := le_abs_self C1a
    have := abs_nonneg C1b
    linarith
  have hβA : |bL (shearA F X η) (shearB F U X η) (psLead1 h F U X η) (psLead2 h F U X η)
      ((N : ℝ) * Real.log X)| ≤ A' := by
    have i1 := abs_le.mp gb1
    have i2 := abs_le.mp w3
    have := le_abs_self C1b
    have := abs_nonneg C1a
    rw [abs_le]
    constructor <;> linarith
  have habs1 := e5.trans (hCC.trans hCN)
  have habs2 := e6.trans (hCC.trans hCN)
  obtain ⟨r1, r2, r3, r4⟩ := hgap _ _ _ _ _ _ g1 hαA hβA w4 w5 g2 g3 g4 habs1 habs2
  refine ⟨e1.trans hCC, e2.trans hCC, e3.trans hCC, e4.trans hCC, le_trans hκ1 r1, ?_, ?_,
    le_trans hκ1 r2, le_trans hκ1 r3, le_trans hκ1 r4⟩
  · have := (abs_le.mp habs1).2
    linarith
  · have := abs_le.mp habs2
    rw [abs_le] at hβA ⊢
    constructor <;> linarith

theorem rc_discrepancy_jets : ∀ (Xm Xp a b B e : ℝ) (F U G V : ℝ → ℝ → ℝ), 0 < Xm → Xm < a → a < b → b < Xp → 0 ≤ B → 0 ≤ e → e ≤ 1 → ContDiffOn ℝ ∞ (↿F) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿U) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿G) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿V) (Ioi 0 ×ˢ Ioo (-1) 1) → (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿F) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿U) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿G) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿V) (X, η)‖ ≤ C) → (∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 → |F X η| ≤ B ∧ |U X η| ≤ B ∧ |deriv (fun e' => F X e') η| ≤ B ∧ |deriv (fun e' => U X e') η| ≤ B ∧ |G X η - F X η| ≤ e ∧ |V X η - U X η| ≤ e ∧ |deriv (fun e' => G X e') η - deriv (fun e' => F X e') η| ≤ e ∧ |deriv (fun e' => V X e') η - deriv (fun e' => U X e') η| ≤ e) → ContDiffOn ℝ ∞ (rcDisc a b F U G V) (Ioo (-1) 1) ∧ (∀ m : ℕ, ∃ K : ℝ, ∀ η : ℝ, -1 < η → η < 1 → ‖iteratedDeriv m (rcDisc a b F U G V) η‖ ≤ K) ∧ ∀ η : ℝ, -1 < η → η < 1 → ‖rcDisc a b F U G V η‖ ≤ (b - a) * (8 * (1 + Xp) * (B + 1) ^ 2) * e ∧ ‖deriv (rcDisc a b F U G V) η‖ ≤ (b - a) * (8 * (1 + Xp) * (B + 1) ^ 2) * e :=
by
  intro Xm Xp a b B ε F U G V hXm hXma hab hbXp hB he0 he1 hFs hUs hGs hVs hjet hpt
  have hO : IsOpen (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) := isOpen_Ioi.prod isOpen_Ioo
  have hSO : Icc Xm Xp ×ˢ Ioo (-1:ℝ) 1 ⊆ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 :=
    fun z hz => ⟨lt_of_lt_of_le hXm hz.1.1, hz.2⟩
  have hXp0 : 0 < Xp := by linarith
  have hkinf : ∀ k : ℕ, ((k : ℕ) : WithTop ℕ∞) ≤ ∞ := fun k => by exact_mod_cast le_top



  have L1 : ∀ (g : ℝ × ℝ → ℝ) (W : Set (ℝ × ℝ)) (x : ℝ), IsOpen W → ContDiffOn ℝ ∞ g W →
      ∀ (k : ℕ) (s : ℝ), (x, s) ∈ W →
        |iteratedDeriv k (fun t => g (x, t)) s| ≤ ‖iteratedFDeriv ℝ k g (x, s)‖ := by
    intro g W x hW hg
    have hT : IsOpen {t : ℝ | (x, t) ∈ W} := hW.preimage (continuous_const.prodMk continuous_id)
    have hP : ∀ k : ℕ, ∀ s : ℝ, (x, s) ∈ W →
        iteratedDeriv k (fun t => g (x, t)) s =
          iteratedFDeriv ℝ k g (x, s) (fun _ => ((0:ℝ), (1:ℝ))) := by
      intro k
      induction k with
      | zero => intro s hs; simp
      | succ k ih =>
        intro s hs
        rw [iteratedDeriv_succ]
        have hev : iteratedDeriv k (fun t => g (x, t)) =ᶠ[nhds s]
            fun s' => iteratedFDeriv ℝ k g (x, s') (fun _ => ((0:ℝ), (1:ℝ))) :=
          Filter.eventuallyEq_of_mem (hT.mem_nhds hs) (fun s' hs' => ih s' hs')
        rw [hev.deriv_eq]
        have hcd : ContDiffAt ℝ ∞ g (x, s) := hg.contDiffAt (hW.mem_nhds hs)
        have h1 : ContDiffAt ℝ 1 (iteratedFDeriv ℝ k g) (x, s) :=
          hcd.iteratedFDeriv_right (by exact_mod_cast le_top)
        have hd : DifferentiableAt ℝ (iteratedFDeriv ℝ k g) (x, s) :=
          h1.differentiableAt (by norm_num)
        have hιd : HasDerivAt (fun t : ℝ => (x, t)) ((0:ℝ), (1:ℝ)) s :=
          (hasDerivAt_const s x).prodMk (hasDerivAt_id s)
        have h2 := hd.hasFDerivAt.comp_hasDerivAt s hιd
        have h3 := (ContinuousMultilinearMap.apply ℝ (fun _ : Fin k => ℝ × ℝ) ℝ
          (fun _ => ((0:ℝ), (1:ℝ)))).hasFDerivAt.comp_hasDerivAt s h2
        have h4 : HasDerivAt (fun s' => iteratedFDeriv ℝ k g (x, s') (fun _ => ((0:ℝ), (1:ℝ))))
            (fderiv ℝ (iteratedFDeriv ℝ k g) (x, s) ((0:ℝ), (1:ℝ)) (fun _ => ((0:ℝ), (1:ℝ)))) s :=
          h3
        rw [h4.deriv, iteratedFDeriv_succ_apply_left]
        rfl
    intro k s hs
    rw [hP k s hs, ← Real.norm_eq_abs]
    refine (ContinuousMultilinearMap.le_opNorm _ _).trans ?_
    have hv : ‖((0:ℝ), (1:ℝ))‖ = 1 := by simp [Prod.norm_def]
    simp [hv]



  have gglob : ∀ φ : ℝ × ℝ → ℝ, ContDiff ℝ ∞ φ →
      axgeGood (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) (Icc Xm Xp ×ˢ Ioo (-1:ℝ) 1) φ := by
    intro φ hφ
    refine ⟨hφ.contDiffOn, fun k => ?_⟩
    have hK : IsCompact (Icc Xm Xp ×ˢ Icc (-1:ℝ) 1) := isCompact_Icc.prod isCompact_Icc
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn
      (ContDiff.continuous_iteratedFDeriv (m := k) (hkinf k) hφ).continuousOn
    exact ⟨C, fun z hz => hC z ⟨hz.1, Ioo_subset_Icc_self hz.2⟩⟩
  have gmul : ∀ φ χ : ℝ × ℝ → ℝ,
      axgeGood (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) (Icc Xm Xp ×ˢ Ioo (-1:ℝ) 1) φ →
      axgeGood (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) (Icc Xm Xp ×ˢ Ioo (-1:ℝ) 1) χ →
      axgeGood (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) (Icc Xm Xp ×ˢ Ioo (-1:ℝ) 1) (fun z => φ z * χ z) := by
    intro φ χ hφ hχ
    refine ⟨hφ.1.mul hχ.1, fun k => ?_⟩
    obtain ⟨C, hC⟩ := iteratedFDeriv_bilinear_bounded_on (ContinuousLinearMap.mul ℝ ℝ) φ χ _ _ hO hSO
      hφ.1 hχ.1 hφ.2 hχ.2 k
    have hfun : (fun z => (ContinuousLinearMap.mul ℝ ℝ) (φ z) (χ z)) = fun z => φ z * χ z :=
      funext fun z => ContinuousLinearMap.mul_apply' ℝ ℝ (φ z) (χ z)
    rw [hfun] at hC
    exact ⟨C, hC⟩
  have gsub : ∀ φ χ : ℝ × ℝ → ℝ,
      axgeGood (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) (Icc Xm Xp ×ˢ Ioo (-1:ℝ) 1) φ →
      axgeGood (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) (Icc Xm Xp ×ˢ Ioo (-1:ℝ) 1) χ →
      axgeGood (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) (Icc Xm Xp ×ˢ Ioo (-1:ℝ) 1) (fun z => φ z - χ z) := by
    intro φ χ hφ hχ
    refine ⟨hφ.1.sub hχ.1, fun k => ?_⟩
    obtain ⟨C1, h1⟩ := hφ.2 k
    obtain ⟨C2, h2⟩ := hχ.2 k
    refine ⟨C1 + C2, fun z hz => ?_⟩
    have hzO := hO.mem_nhds (hSO hz)
    have e1 : iteratedFDeriv ℝ k (fun z => φ z - χ z) z =
        iteratedFDeriv ℝ k φ z - iteratedFDeriv ℝ k χ z :=
      iteratedFDeriv_sub_apply ((hφ.1.contDiffAt hzO).of_le (hkinf k))
        ((hχ.1.contDiffAt hzO).of_le (hkinf k))
    rw [e1]
    exact (norm_sub_le _ _).trans (add_le_add (h1 z hz) (h2 z hz))
  have gsq : ∀ φ : ℝ × ℝ → ℝ,
      axgeGood (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) (Icc Xm Xp ×ˢ Ioo (-1:ℝ) 1) φ →
      axgeGood (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) (Icc Xm Xp ×ˢ Ioo (-1:ℝ) 1) (fun z => φ z ^ 2) := by
    intro φ hφ
    have e1 : (fun z => φ z ^ 2) = fun z => φ z * φ z := funext fun z => sq (φ z)
    rw [e1]
    exact gmul φ φ hφ hφ
  have gbase : ∀ H : ℝ → ℝ → ℝ, ContDiffOn ℝ ∞ (↿H) (Ioi 0 ×ˢ Ioo (-1) 1) →
      (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 →
        ‖iteratedFDeriv ℝ m (↿H) (X, η)‖ ≤ C) →
      axgeGood (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) (Icc Xm Xp ×ˢ Ioo (-1:ℝ) 1) (↿H) := by
    intro H hH hb
    refine ⟨hH, fun k => ?_⟩
    obtain ⟨C, hC⟩ := hb k
    exact ⟨C, fun z hz => hC z.1 z.2 hz.1.1 hz.1.2 hz.2.1 hz.2.2⟩
  have gF := gbase F hFs (fun m => (hjet m).imp fun C hC X η h1 h2 h3 h4 => (hC X η h1 h2 h3 h4).1)
  have gU := gbase U hUs (fun m => (hjet m).imp fun C hC X η h1 h2 h3 h4 => (hC X η h1 h2 h3 h4).2.1)
  have gG := gbase G hGs (fun m => (hjet m).imp fun C hC X η h1 h2 h3 h4 => (hC X η h1 h2 h3 h4).2.2.1)
  have gV := gbase V hVs (fun m => (hjet m).imp fun C hC X η h1 h2 h3 h4 => (hC X η h1 h2 h3 h4).2.2.2)
  have gfst := gglob (fun z => z.1) contDiff_fst
  have g2x := gglob (fun z => 2 * z.1) (contDiff_const.mul contDiff_fst)



  have hsq : ∀ (f : ℝ → ℝ) (f' s : ℝ), HasDerivAt f f' s →
      HasDerivAt (fun t => f t ^ 2) (2 * f s * f') s := by
    intro f f' s h; convert h.pow 2 using 1; norm_num
  have hprod : ∀ s t S T : ℝ, |s| ≤ S → |t| ≤ T → |s * t| ≤ S * T := by
    intro s t S T hs ht
    rw [abs_mul]
    exact mul_le_mul hs ht (abs_nonneg _) ((abs_nonneg _).trans hs)
  have pw : ∀ y η : ℝ, a ≤ y → y ≤ b → -1 < η → η < 1 →
      (|V y η - U y η| ≤ 8 * (1 + Xp) * (B + 1) ^ 2 * ε ∧
        |deriv (fun t => V y t - U y t) η| ≤ 8 * (1 + Xp) * (B + 1) ^ 2 * ε) ∧
      (|2 * y * (G y η - F y η)| ≤ 8 * (1 + Xp) * (B + 1) ^ 2 * ε ∧
        |deriv (fun t => 2 * y * (G y t - F y t)) η| ≤ 8 * (1 + Xp) * (B + 1) ^ 2 * ε) ∧
      (|V y η * (2 * y * G y η) - U y η * (2 * y * F y η)| ≤ 8 * (1 + Xp) * (B + 1) ^ 2 * ε ∧
        |deriv (fun t => V y t * (2 * y * G y t) - U y t * (2 * y * F y t)) η| ≤
          8 * (1 + Xp) * (B + 1) ^ 2 * ε) ∧
      (|(V y η ^ 2 - y * G y η ^ 2) - (U y η ^ 2 - y * F y η ^ 2)| ≤ 8 * (1 + Xp) * (B + 1) ^ 2 * ε ∧
        |deriv (fun t => (V y t ^ 2 - y * G y t ^ 2) - (U y t ^ 2 - y * F y t ^ 2)) η| ≤
          8 * (1 + Xp) * (B + 1) ^ 2 * ε) ∧
      (|G y η ^ 2 - F y η ^ 2| ≤ 8 * (1 + Xp) * (B + 1) ^ 2 * ε ∧
        |deriv (fun t => G y t ^ 2 - F y t ^ 2) η| ≤ 8 * (1 + Xp) * (B + 1) ^ 2 * ε) := by
    intro y η hy1 hy2 h1 h2
    have hyX1 : Xm ≤ y := by linarith
    have hyX2 : y ≤ Xp := by linarith
    have hy0 : 0 ≤ y := by linarith
    have hmem : (y, η) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := ⟨show (0:ℝ) < y by linarith, h1, h2⟩
    have hF := (slice_deriv_facts F _ y η hO hFs hmem).2.1
    have hU := (slice_deriv_facts U _ y η hO hUs hmem).2.1
    have hG := (slice_deriv_facts G _ y η hO hGs hmem).2.1
    have hV := (slice_deriv_facts V _ y η hO hVs hmem).2.1
    obtain ⟨bF, bU, bF1, bU1, bp, bq, bp1, bq1⟩ := hpt y η hyX1 hyX2 h1 h2
    have d0 : deriv (fun t => V y t - U y t) η =
        deriv (fun t => V y t) η - deriv (fun t => U y t) η := (hV.sub hU).deriv
    have d1 : deriv (fun t => 2 * y * (G y t - F y t)) η =
        2 * y * (deriv (fun t => G y t) η - deriv (fun t => F y t) η) :=
      ((hG.sub hF).const_mul (2 * y)).deriv
    have d2 : deriv (fun t => V y t * (2 * y * G y t) - U y t * (2 * y * F y t)) η =
        deriv (fun t => V y t) η * (2 * y * G y η) + V y η * (2 * y * deriv (fun t => G y t) η) -
          (deriv (fun t => U y t) η * (2 * y * F y η) + U y η * (2 * y * deriv (fun t => F y t) η)) :=
      ((hV.mul (hG.const_mul (2 * y))).sub (hU.mul (hF.const_mul (2 * y)))).deriv
    have d3 : deriv (fun t => (V y t ^ 2 - y * G y t ^ 2) - (U y t ^ 2 - y * F y t ^ 2)) η =
        2 * V y η * deriv (fun t => V y t) η - y * (2 * G y η * deriv (fun t => G y t) η) -
          (2 * U y η * deriv (fun t => U y t) η - y * (2 * F y η * deriv (fun t => F y t) η)) :=
      (((hsq _ _ _ hV).sub ((hsq _ _ _ hG).const_mul y)).sub
        ((hsq _ _ _ hU).sub ((hsq _ _ _ hF).const_mul y))).deriv
    have d4 : deriv (fun t => G y t ^ 2 - F y t ^ 2) η =
        2 * G y η * deriv (fun t => G y t) η - 2 * F y η * deriv (fun t => F y t) η :=
      ((hsq _ _ _ hG).sub (hsq _ _ _ hF)).deriv
    rw [d0, d1, d2, d3, d4]
    set F0 := F y η with hF0
    set U0 := U y η with hU0
    set G0 := G y η with hG0
    set V0 := V y η with hV0
    set F1 := deriv (fun t => F y t) η with hF1
    set U1 := deriv (fun t => U y t) η with hU1
    set G1 := deriv (fun t => G y t) η with hG1
    set V1 := deriv (fun t => V y t) η with hV1
    have bG : |G0| ≤ B + 1 := by
      have := abs_add_le (G0 - F0) F0; rw [sub_add_cancel] at this; linarith
    have bV : |V0| ≤ B + 1 := by
      have := abs_add_le (V0 - U0) U0; rw [sub_add_cancel] at this; linarith
    have bG1 : |G1| ≤ B + 1 := by
      have := abs_add_le (G1 - F1) F1; rw [sub_add_cancel] at this; linarith
    have bV1 : |V1| ≤ B + 1 := by
      have := abs_add_le (V1 - U1) U1; rw [sub_add_cancel] at this; linarith
    have bVU : |V0 + U0| ≤ 2 * B + 1 := by have := abs_add_le V0 U0; linarith
    have bGF : |G0 + F0| ≤ 2 * B + 1 := by have := abs_add_le G0 F0; linarith
    have h2y : |2 * y| ≤ 2 * Xp := by rw [abs_of_nonneg (by linarith)]; linarith
    have hny : |-y| ≤ Xp := by rw [abs_neg, abs_of_nonneg hy0]; exact hyX2
    have hn2y : |-2 * y| ≤ 2 * Xp := by rw [abs_of_nonpos (by linarith)]; linarith
    have h2a : |(2:ℝ)| ≤ 2 := by norm_num
    have n1 : 0 ≤ ε * B := mul_nonneg he0 hB
    have n2 : 0 ≤ ε * B ^ 2 := mul_nonneg he0 (sq_nonneg B)
    have n3 : 0 ≤ Xp * ε := mul_nonneg hXp0.le he0
    have n4 : 0 ≤ Xp * ε * B := mul_nonneg n3 hB
    have n5 : 0 ≤ Xp * ε * B ^ 2 := mul_nonneg n3 (sq_nonneg B)
    have hK : 8 * (1 + Xp) * (B + 1) ^ 2 * ε = 8 * ε + 16 * (ε * B) + 8 * (ε * B ^ 2) +
        8 * (Xp * ε) + 16 * (Xp * ε * B) + 8 * (Xp * ε * B ^ 2) := by ring
    rw [hK]
    refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
    · linarith
    · linarith
    · have t1 := hprod _ _ _ _ h2y bp
      linarith
    · have t1 := hprod _ _ _ _ h2y bp1
      linarith
    · rw [show V0 * (2 * y * G0) - U0 * (2 * y * F0) =
          2 * y * ((V0 - U0) * G0) + 2 * y * (U0 * (G0 - F0)) by ring]
      have t1 := hprod _ _ _ _ h2y (hprod _ _ _ _ bq bG)
      have t2 := hprod _ _ _ _ h2y (hprod _ _ _ _ bU bp)
      have s1 := abs_add_le (2 * y * ((V0 - U0) * G0)) (2 * y * (U0 * (G0 - F0)))
      linarith
    · rw [show V1 * (2 * y * G0) + V0 * (2 * y * G1) - (U1 * (2 * y * F0) + U0 * (2 * y * F1)) =
          2 * y * ((V1 - U1) * G0) + 2 * y * (U1 * (G0 - F0)) + 2 * y * ((V0 - U0) * G1) +
            2 * y * (U0 * (G1 - F1)) by ring]
      have t1 := hprod _ _ _ _ h2y (hprod _ _ _ _ bq1 bG)
      have t2 := hprod _ _ _ _ h2y (hprod _ _ _ _ bU1 bp)
      have t3 := hprod _ _ _ _ h2y (hprod _ _ _ _ bq bG1)
      have t4 := hprod _ _ _ _ h2y (hprod _ _ _ _ bU bp1)
      have s1 := abs_add_le (2 * y * ((V1 - U1) * G0) + 2 * y * (U1 * (G0 - F0)) +
        2 * y * ((V0 - U0) * G1)) (2 * y * (U0 * (G1 - F1)))
      have s2 := abs_add_le (2 * y * ((V1 - U1) * G0) + 2 * y * (U1 * (G0 - F0)))
        (2 * y * ((V0 - U0) * G1))
      have s3 := abs_add_le (2 * y * ((V1 - U1) * G0)) (2 * y * (U1 * (G0 - F0)))
      linarith
    · rw [show (V0 ^ 2 - y * G0 ^ 2) - (U0 ^ 2 - y * F0 ^ 2) =
          (V0 - U0) * (V0 + U0) + -y * ((G0 - F0) * (G0 + F0)) by ring]
      have t1 := hprod _ _ _ _ bq bVU
      have t2 := hprod _ _ _ _ hny (hprod _ _ _ _ bp bGF)
      have s1 := abs_add_le ((V0 - U0) * (V0 + U0)) (-y * ((G0 - F0) * (G0 + F0)))
      linarith
    · rw [show 2 * V0 * V1 - y * (2 * G0 * G1) - (2 * U0 * U1 - y * (2 * F0 * F1)) =
          2 * ((V0 - U0) * V1) + 2 * (U0 * (V1 - U1)) + -2 * y * ((G0 - F0) * G1) +
            -2 * y * (F0 * (G1 - F1)) by ring]
      have t1 := hprod _ _ _ _ h2a (hprod _ _ _ _ bq bV1)
      have t2 := hprod _ _ _ _ h2a (hprod _ _ _ _ bU bq1)
      have t3 := hprod _ _ _ _ hn2y (hprod _ _ _ _ bp bG1)
      have t4 := hprod _ _ _ _ hn2y (hprod _ _ _ _ bF bp1)
      have s1 := abs_add_le (2 * ((V0 - U0) * V1) + 2 * (U0 * (V1 - U1)) +
        -2 * y * ((G0 - F0) * G1)) (-2 * y * (F0 * (G1 - F1)))
      have s2 := abs_add_le (2 * ((V0 - U0) * V1) + 2 * (U0 * (V1 - U1)))
        (-2 * y * ((G0 - F0) * G1))
      have s3 := abs_add_le (2 * ((V0 - U0) * V1)) (2 * (U0 * (V1 - U1)))
      linarith
    · rw [show G0 ^ 2 - F0 ^ 2 = (G0 - F0) * (G0 + F0) by ring]
      have t1 := hprod _ _ _ _ bp bGF
      linarith
    · rw [show 2 * G0 * G1 - 2 * F0 * F1 = 2 * ((G0 - F0) * G1) + 2 * (F0 * (G1 - F1)) by ring]
      have t1 := hprod _ _ _ _ h2a (hprod _ _ _ _ bp bG1)
      have t2 := hprod _ _ _ _ h2a (hprod _ _ _ _ bF bp1)
      have s1 := abs_add_le (2 * ((G0 - F0) * G1)) (2 * (F0 * (G1 - F1)))
      linarith



  have key : ∀ ψ : ℝ → ℝ → ℝ,
      axgeGood (Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1) (Icc Xm Xp ×ˢ Ioo (-1:ℝ) 1) (↿ψ) →
      (∀ y η : ℝ, a ≤ y → y ≤ b → -1 < η → η < 1 →
        |ψ y η| ≤ 8 * (1 + Xp) * (B + 1) ^ 2 * ε ∧
        |deriv (fun t => ψ y t) η| ≤ 8 * (1 + Xp) * (B + 1) ^ 2 * ε) →
      EtaJet ((b - a) * (8 * (1 + Xp) * (B + 1) ^ 2) * ε) (fun η => -∫ x in a..b, ψ x η) := by
    intro ψ hψ hpw
    have hsm : ContDiffOn ℝ ∞ (↿ψ) (Ioo Xm Xp ×ˢ Ioo (-1) 1) :=
      hψ.1.mono (fun z hz => ⟨lt_trans hXm hz.1.1, hz.2⟩)
    obtain ⟨hs, hbd⟩ := param_int_eta_jet ψ Xm a b Xp (-1) 1 hXma hab.le hbXp (by norm_num) hsm
    refine ⟨hs.neg, fun m => ?_, fun η h1 h2 => ?_⟩
    · obtain ⟨C, hC⟩ := hψ.2 m
      refine ⟨(b - a) * C, fun η h1 h2 => ?_⟩
      have hm := hbd m η C h1 h2 (fun y hy1 hy2 =>
        (L1 (↿ψ) _ y hO hψ.1 m η ⟨show (0:ℝ) < y by linarith, h1, h2⟩).trans
          (hC (y, η) ⟨⟨by linarith, by linarith⟩, h1, h2⟩))
      show |iteratedDeriv m (-(fun η => ∫ x in a..b, ψ x η)) η| ≤ _
      rw [iteratedDeriv_neg, abs_neg]
      exact hm
    · have hb0 := hbd 0 η (8 * (1 + Xp) * (B + 1) ^ 2 * ε) h1 h2 (fun y hy1 hy2 => by
        rw [iteratedDeriv_zero]; exact (hpw y η hy1 hy2 h1 h2).1)
      have hb1 := hbd 1 η (8 * (1 + Xp) * (B + 1) ^ 2 * ε) h1 h2 (fun y hy1 hy2 => by
        rw [iteratedDeriv_one]; exact (hpw y η hy1 hy2 h1 h2).2)
      rw [iteratedDeriv_zero] at hb0
      have hab' : 0 ≤ b - a := by linarith
      refine ⟨?_, ?_⟩
      · show |-(∫ x in a..b, ψ x η)| ≤ _
        rw [abs_neg]
        have h0 : |∫ x in a..b, ψ x η| ≤ (b - a) * (8 * (1 + Xp) * (B + 1) ^ 2 * ε) := hb0
        linarith
      · have e1 : deriv (fun η => -∫ x in a..b, ψ x η) η =
            -(iteratedDeriv 1 (fun η => ∫ x in a..b, ψ x η) η) := by
          show deriv (-(fun η => ∫ x in a..b, ψ x η)) η = _
          rw [← iteratedDeriv_one, iteratedDeriv_neg]
        rw [e1, abs_neg]
        linarith



  have J0 := key (fun x t => V x t - U x t) (gsub (↿V) (↿U) gV gU)
    (fun y η h1 h2 h3 h4 => (pw y η h1 h2 h3 h4).1)
  have J1 := key (fun x t => 2 * x * (G x t - F x t))
    (gmul (fun z => 2 * z.1) (fun z => (↿G) z - (↿F) z) g2x (gsub (↿G) (↿F) gG gF))
    (fun y η h1 h2 h3 h4 => (pw y η h1 h2 h3 h4).2.1)
  have J2 := key (fun x t => V x t * (2 * x * G x t) - U x t * (2 * x * F x t))
    (gsub (fun z => (↿V) z * (2 * z.1 * (↿G) z)) (fun z => (↿U) z * (2 * z.1 * (↿F) z))
      (gmul (↿V) (fun z => 2 * z.1 * (↿G) z) gV (gmul (fun z => 2 * z.1) (↿G) g2x gG))
      (gmul (↿U) (fun z => 2 * z.1 * (↿F) z) gU (gmul (fun z => 2 * z.1) (↿F) g2x gF)))
    (fun y η h1 h2 h3 h4 => (pw y η h1 h2 h3 h4).2.2.1)
  have J3 := key (fun x t => (V x t ^ 2 - x * G x t ^ 2) - (U x t ^ 2 - x * F x t ^ 2)) (by
      have e : (↿(fun x t : ℝ => (V x t ^ 2 - x * G x t ^ 2) - (U x t ^ 2 - x * F x t ^ 2))) =
          fun z : ℝ × ℝ => ((↿V) z ^ 2 - z.1 * (↿G) z ^ 2) - ((↿U) z ^ 2 - z.1 * (↿F) z ^ 2) := by
        funext z
        rfl
      rw [e]
      exact gsub (fun z => (↿V) z ^ 2 - z.1 * (↿G) z ^ 2) (fun z => (↿U) z ^ 2 - z.1 * (↿F) z ^ 2)
        (gsub (fun z => (↿V) z ^ 2) (fun z => z.1 * (↿G) z ^ 2) (gsq (↿V) gV)
          (gmul (fun z => z.1) (fun z => (↿G) z ^ 2) gfst (gsq (↿G) gG)))
        (gsub (fun z => (↿U) z ^ 2) (fun z => z.1 * (↿F) z ^ 2) (gsq (↿U) gU)
          (gmul (fun z => z.1) (fun z => (↿F) z ^ 2) gfst (gsq (↿F) gF))))
    (fun y η h1 h2 h3 h4 => (pw y η h1 h2 h3 h4).2.2.2.1)
  have J4 := key (fun x t => G x t ^ 2 - F x t ^ 2) (by
      have e : (↿(fun x t : ℝ => G x t ^ 2 - F x t ^ 2)) =
          fun z : ℝ × ℝ => (↿G) z ^ 2 - (↿F) z ^ 2 := by
        funext z
        rfl
      rw [e]
      exact gsub (fun z => (↿G) z ^ 2) (fun z => (↿F) z ^ 2) (gsq (↿G) gG) (gsq (↿F) gF))
    (fun y η h1 h2 h3 h4 => (pw y η h1 h2 h3 h4).2.2.2.2)
  have hM : 0 ≤ (b - a) * (8 * (1 + Xp) * (B + 1) ^ 2) * ε :=
    mul_nonneg (mul_nonneg (by linarith) (mul_nonneg (mul_nonneg (by norm_num) (by linarith))
      (sq_nonneg _))) he0
  obtain ⟨hbd, hsm, hjt⟩ := fin5_vector_jets _ (rcDisc a b F U G V) _ _ _ _ _ hM J0 J1 J2 J3 J4
    (fun η _ _ => ⟨rfl, rfl, rfl, rfl, rfl⟩)
  exact ⟨hsm, hjt, hbd⟩

theorem rc_bump_regular : ∀ (s1 s2 : ℝ) (β : Fin 2 → ℝ → ℝ) (γ : Fin 3 → ℝ → ℝ), (∀ i, ContDiff ℝ ∞ (β i)) → (∀ j, ContDiff ℝ ∞ (γ j)) → (∀ i x, (x ≤ s1 ∨ s2 ≤ x) → β i x = 0) → (∀ j x, (x ≤ s1 ∨ s2 ≤ x) → γ j x = 0) → ∃ Γ : ℝ, 0 ≤ Γ ∧ ∀ (θ : ℝ) (c : ℝ → Fin 5 → ℝ), AxCoef θ c → ContDiffOn ℝ ∞ (↿(rcRF γ c)) (univ ×ˢ Ioo (-1) 1) ∧ ContDiffOn ℝ ∞ (↿(rcRU β c)) (univ ×ˢ Ioo (-1) 1) ∧ (∀ m : ℕ, ∃ C : ℝ, ∀ z ∈ (univ : Set ℝ) ×ˢ Ioo (-1 : ℝ) 1, ‖iteratedFDeriv ℝ m (↿(rcRF γ c)) z‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿(rcRU β c)) z‖ ≤ C) ∧ ∀ X η : ℝ, -1 < η → η < 1 → HasDerivAt (fun e => rcRF γ c X e) (deriv (fun e => rcRF γ c X e) η) η ∧ HasDerivAt (fun e => rcRU β c X e) (deriv (fun e => rcRU β c X e) η) η ∧ HasDerivAt (fun Y => rcRF γ c Y η) (deriv (fun Y => rcRF γ c Y η) X) X ∧ HasDerivAt (fun Y => rcRU β c Y η) (deriv (fun Y => rcRU β c Y η) X) X ∧ |rcRF γ c X η| ≤ Γ * θ ∧ |rcRU β c X η| ≤ Γ * θ ∧ |deriv (fun e => rcRF γ c X e) η| ≤ Γ * θ ∧ |deriv (fun e => rcRU β c X e) η| ≤ Γ * θ ∧ |deriv (fun Y => rcRF γ c Y η) X| ≤ Γ * θ ∧ |deriv (fun Y => rcRU β c Y η) X| ≤ Γ * θ :=
by
  intro s1 s2 β γ hβs hγs hβ0 hγ0
  have hout : ∀ x : ℝ, x ∉ Icc s1 s2 → (x ≤ s1 ∨ s2 ≤ x) := by
    intro x hx
    by_contra h
    push_neg at h
    exact hx ⟨h.1.le, h.2.le⟩

  have hsup : ∀ g : ℝ → ℝ, ContDiff ℝ ∞ g → (∀ x, (x ≤ s1 ∨ s2 ≤ x) → g x = 0) →
      ∃ A : ℝ, 0 ≤ A ∧ ∀ x, |g x| ≤ A ∧ |deriv g x| ≤ A := by
    intro g hg hg0
    have hcs : HasCompactSupport g :=
      HasCompactSupport.intro (isCompact_Icc (a := s1) (b := s2)) (fun x hx => hg0 x (hout x hx))
    obtain ⟨M0, hM0⟩ := hg.continuous.bounded_above_of_compact_support hcs
    obtain ⟨M1, hM1⟩ :=
      (hg.continuous_deriv (by exact_mod_cast le_top)).bounded_above_of_compact_support hcs.deriv
    refine ⟨max (max M0 M1) 0, le_max_right _ _, fun x => ⟨?_, ?_⟩⟩
    · rw [← Real.norm_eq_abs]; exact (hM0 x).trans ((le_max_left _ _).trans (le_max_left _ _))
    · rw [← Real.norm_eq_abs]; exact (hM1 x).trans ((le_max_right _ _).trans (le_max_left _ _))

  have hGjet : ∀ (n : ℕ) (g : Fin n → ℝ → ℝ), (∀ j, ContDiff ℝ ∞ (g j)) →
      (∀ j x, (x ≤ s1 ∨ s2 ≤ x) → g j x = 0) →
      ContDiff ℝ ∞ (fun z : ℝ × ℝ => fun j => g j z.1) ∧
        ∀ k : ℕ, ∃ C : ℝ, ∀ z : ℝ × ℝ, ‖iteratedFDeriv ℝ k (fun z : ℝ × ℝ => fun j => g j z.1) z‖ ≤ C := by
    intro n g hg hg0
    obtain ⟨G, hG⟩ : ∃ G : ℝ → Fin n → ℝ, G = fun x j => g j x := ⟨_, rfl⟩
    have hGs : ContDiff ℝ ∞ G := by rw [hG]; exact contDiff_pi.2 hg
    obtain ⟨L, hL⟩ : ∃ L : ℝ × ℝ →L[ℝ] ℝ, L = ContinuousLinearMap.fst ℝ ℝ ℝ := ⟨_, rfl⟩
    have hLz : ∀ z : ℝ × ℝ, L z = z.1 := by intro z; rw [hL]; rfl
    have e1 : (fun z : ℝ × ℝ => fun j => g j z.1) = G ∘ L := by
      funext z; simp only [Function.comp, hLz, hG]
    have hcs : HasCompactSupport G := by
      refine HasCompactSupport.intro (isCompact_Icc (a := s1) (b := s2)) (fun x hx => ?_)
      rw [hG]
      funext j
      exact hg0 j x (hout x hx)
    rw [e1]
    refine ⟨hGs.comp L.contDiff, fun k => ?_⟩
    obtain ⟨C, hC⟩ := (ContDiff.continuous_iteratedFDeriv (m := k) (by exact_mod_cast le_top)
      hGs).bounded_above_of_compact_support (hcs.iteratedFDeriv k)
    refine ⟨C, fun z => ?_⟩
    rw [ContinuousLinearMap.iteratedFDeriv_comp_right L hGs z (by exact_mod_cast le_top)]
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    have hp : ∏ _i : Fin k, ‖L‖ ≤ 1 := Finset.prod_le_one₀ (fun _ _ => norm_nonneg _)
      (fun _ _ => by rw [hL]; exact ContinuousLinearMap.norm_fst_le ℝ ℝ ℝ)
    calc ‖iteratedFDeriv ℝ k G (L z)‖ * ∏ _i : Fin k, ‖L‖ ≤ ‖iteratedFDeriv ℝ k G (L z)‖ * 1 :=
          mul_le_mul_of_nonneg_left hp (norm_nonneg _)
      _ ≤ C := by rw [mul_one]; exact hC _

  obtain ⟨A1, hA1, hb1⟩ := hsup (β 0) (hβs 0) (hβ0 0)
  obtain ⟨A2, hA2, hb2⟩ := hsup (β 1) (hβs 1) (hβ0 1)
  obtain ⟨A3, hA3, hg1⟩ := hsup (γ 0) (hγs 0) (hγ0 0)
  obtain ⟨A4, hA4, hg2⟩ := hsup (γ 1) (hγs 1) (hγ0 1)
  obtain ⟨A5, hA5, hg3⟩ := hsup (γ 2) (hγs 2) (hγ0 2)
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = max (max (max (max A1 A2) A3) A4) A5 := ⟨_, rfl⟩
  have e1 : A1 ≤ A := by
    rw [hA]; exact le_max_of_le_left (le_max_of_le_left (le_max_of_le_left (le_max_left _ _)))
  have e2 : A2 ≤ A := by
    rw [hA]; exact le_max_of_le_left (le_max_of_le_left (le_max_of_le_left (le_max_right _ _)))
  have e3 : A3 ≤ A := by
    rw [hA]; exact le_max_of_le_left (le_max_of_le_left (le_max_right _ _))
  have e4 : A4 ≤ A := by
    rw [hA]; exact le_max_of_le_left (le_max_right _ _)
  have e5 : A5 ≤ A := by
    rw [hA]; exact le_max_right _ _
  have hA0 : 0 ≤ A := hA1.trans e1
  refine ⟨3 * A, by linarith, ?_⟩
  intro θ c hAx
  obtain ⟨hcs, hcjet, hcθ⟩ := hAx
  set O : Set (ℝ × ℝ) := (univ : Set ℝ) ×ˢ Ioo (-1 : ℝ) 1 with hOdef
  have hO : IsOpen O := isOpen_univ.prod isOpen_Ioo

  have hbil : ∀ {F G : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G]
      [NormedSpace ℝ G] (B : F →L[ℝ] G →L[ℝ] ℝ) (f : ℝ × ℝ → F) (g : ℝ × ℝ → G),
      ContDiffOn ℝ ∞ f O → ContDiffOn ℝ ∞ g O →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ O, ‖iteratedFDeriv ℝ k f z‖ ≤ C) →
      (∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ O, ‖iteratedFDeriv ℝ k g z‖ ≤ C) →
      ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ O, ‖iteratedFDeriv ℝ k (fun z => B (f z) (g z)) z‖ ≤ C := by
    intro F G _ _ _ _ B f g hf hg hbf hbg k
    choose Cf hCf using hbf
    choose Cg hCg using hbg
    refine ⟨‖B‖ * ∑ i ∈ Finset.range (k + 1),
        (k.choose i : ℝ) * max (Cf i) 0 * max (Cg (k - i)) 0, fun z hz => ?_⟩
    have hU : UniqueDiffOn ℝ O := hO.uniqueDiffOn
    have key := ContinuousLinearMap.norm_iteratedFDerivWithin_le_of_bilinear B hf hg hU hz
      (n := k) (by exact_mod_cast le_top)
    rw [iteratedFDerivWithin_of_isOpen k hO hz] at key
    refine key.trans ?_
    refine mul_le_mul_of_nonneg_left ?_ (ContinuousLinearMap.opNorm_nonneg B)
    refine Finset.sum_le_sum fun i _ => ?_
    rw [iteratedFDerivWithin_of_isOpen i hO hz, iteratedFDerivWithin_of_isOpen (k - i) hO hz]
    have h1 : ‖iteratedFDeriv ℝ i f z‖ ≤ max (Cf i) 0 := (hCf i z hz).trans (le_max_left _ _)
    have h2 : ‖iteratedFDeriv ℝ (k - i) g z‖ ≤ max (Cg (k - i)) 0 :=
      (hCg (k - i) z hz).trans (le_max_left _ _)
    have h0 : (0 : ℝ) ≤ k.choose i := Nat.cast_nonneg _
    exact mul_le_mul (mul_le_mul_of_nonneg_left h1 h0) h2 (norm_nonneg _)
      (mul_nonneg h0 (le_max_right _ _))

  have hf : ContDiffOn ℝ ∞ (fun z : ℝ × ℝ => c z.2) O :=
    hcs.comp contDiff_snd.contDiffOn (fun z hz => hz.2)
  have hfjet : ∀ k : ℕ, ∃ C : ℝ, ∀ z ∈ O, ‖iteratedFDeriv ℝ k (fun z : ℝ × ℝ => c z.2) z‖ ≤ C := by
    intro k
    obtain ⟨K, hK⟩ := hcjet k
    refine ⟨K, fun z hz => ?_⟩
    obtain ⟨L, hL⟩ : ∃ L : ℝ × ℝ →L[ℝ] ℝ, L = ContinuousLinearMap.snd ℝ ℝ ℝ := ⟨_, rfl⟩
    have hLz : ∀ z : ℝ × ℝ, L z = z.2 := by intro z; rw [hL]; rfl
    have hPo : IsOpen (L ⁻¹' Ioo (-1:ℝ) 1) := isOpen_Ioo.preimage L.continuous
    have hz2 : L z ∈ Ioo (-1:ℝ) 1 := by rw [hLz]; exact hz.2
    have hzP : z ∈ L ⁻¹' Ioo (-1:ℝ) 1 := hz2
    have e0 : (fun z : ℝ × ℝ => c z.2) = c ∘ L := by funext z; simp only [Function.comp, hLz]
    rw [e0, ← iteratedFDerivWithin_of_isOpen k hPo hzP,
      ContinuousLinearMap.iteratedFDerivWithin_comp_right L hcs isOpen_Ioo.uniqueDiffOn
        hPo.uniqueDiffOn hz2 (by exact_mod_cast le_top),
      iteratedFDerivWithin_of_isOpen k isOpen_Ioo hz2]
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    have hp : ∏ _i : Fin k, ‖L‖ ≤ 1 := Finset.prod_le_one₀ (fun _ _ => norm_nonneg _)
      (fun _ _ => by rw [hL]; exact ContinuousLinearMap.norm_snd_le ℝ ℝ ℝ)
    calc ‖iteratedFDeriv ℝ k c (L z)‖ * ∏ _i : Fin k, ‖L‖ ≤ ‖iteratedFDeriv ℝ k c (L z)‖ * 1 :=
          mul_le_mul_of_nonneg_left hp (norm_nonneg _)
      _ = ‖iteratedDeriv k c (L z)‖ := by rw [mul_one, norm_iteratedFDeriv_eq_norm_iteratedDeriv]
      _ ≤ K := hK _ hz2.1 hz2.2

  obtain ⟨BF, hBF⟩ : ∃ BF : (Fin 5 → ℝ) →L[ℝ] (Fin 3 → ℝ) →L[ℝ] ℝ,
      ∀ a b, BF a b = a 2 * b 0 + a 3 * b 1 + a 4 * b 2 :=
    ⟨(ContinuousLinearMap.mul ℝ ℝ).bilinearComp
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 5 => ℝ) 2)
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℝ) 0) +
      (ContinuousLinearMap.mul ℝ ℝ).bilinearComp
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 5 => ℝ) 3)
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℝ) 1) +
      (ContinuousLinearMap.mul ℝ ℝ).bilinearComp
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 5 => ℝ) 4)
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℝ) 2),
      fun a b => by
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.bilinearComp_apply,
          ContinuousLinearMap.proj_apply, ContinuousLinearMap.mul_apply']⟩
  obtain ⟨BU, hBU⟩ : ∃ BU : (Fin 5 → ℝ) →L[ℝ] (Fin 2 → ℝ) →L[ℝ] ℝ,
      ∀ a b, BU a b = a 0 * b 0 + a 1 * b 1 :=
    ⟨(ContinuousLinearMap.mul ℝ ℝ).bilinearComp
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 5 => ℝ) 0)
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 2 => ℝ) 0) +
      (ContinuousLinearMap.mul ℝ ℝ).bilinearComp
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 5 => ℝ) 1)
        (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 2 => ℝ) 1),
      fun a b => by
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.bilinearComp_apply,
          ContinuousLinearMap.proj_apply, ContinuousLinearMap.mul_apply']⟩
  have hRF : (↿(rcRF γ c)) = fun z : ℝ × ℝ => BF (c z.2) (fun j => γ j z.1) := by
    funext z; rw [hBF]; rfl
  have hRU : (↿(rcRU β c)) = fun z : ℝ × ℝ => BU (c z.2) (fun i => β i z.1) := by
    funext z; rw [hBU]; rfl
  obtain ⟨hGγs, hGγj⟩ := hGjet 3 γ hγs hγ0
  obtain ⟨hGβs, hGβj⟩ := hGjet 2 β hβs hβ0
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hRF]
    exact (BF.contDiff.comp_contDiffOn hf).clm_apply hGγs.contDiffOn
  · rw [hRU]
    exact (BU.contDiff.comp_contDiffOn hf).clm_apply hGβs.contDiffOn
  · intro m
    obtain ⟨C1, hC1⟩ := hbil BF (fun z : ℝ × ℝ => c z.2) (fun z : ℝ × ℝ => fun j => γ j z.1) hf
      hGγs.contDiffOn hfjet (fun k => (hGγj k).imp fun C hC z _ => hC z) m
    obtain ⟨C2, hC2⟩ := hbil BU (fun z : ℝ × ℝ => c z.2) (fun z : ℝ × ℝ => fun i => β i z.1) hf
      hGβs.contDiffOn hfjet (fun k => (hGβj k).imp fun C hC z _ => hC z) m
    refine ⟨max C1 C2, fun z hz => ⟨?_, ?_⟩⟩
    · rw [hRF]; exact (hC1 z hz).trans (le_max_left _ _)
    · rw [hRU]; exact (hC2 z hz).trans (le_max_right _ _)
  · intro X η h1 h2
    obtain ⟨hcn, hcd⟩ := hcθ η h1 h2
    have hθ : 0 ≤ θ := (norm_nonneg _).trans hcn
    have hck : ∀ k, |c η k| ≤ θ := fun k => by
      rw [← Real.norm_eq_abs]; exact (norm_le_pi_norm (c η) k).trans hcn
    have hcdk : ∀ k, |deriv c η k| ≤ θ := fun k => by
      rw [← Real.norm_eq_abs]; exact (norm_le_pi_norm (deriv c η) k).trans hcd
    have hcdiff : DifferentiableAt ℝ c η :=
      (hcs.contDiffAt (Ioo_mem_nhds h1 h2)).differentiableAt (by simp)
    have hcD : ∀ k, HasDerivAt (fun e => c e k) (deriv c η k) η :=
      fun k => hasDerivAt_pi.1 hcdiff.hasDerivAt k
    have hβd : ∀ i, HasDerivAt (β i) (deriv (β i) X) X :=
      fun i => ((hβs i).differentiable (by simp) X).hasDerivAt
    have hγd : ∀ j, HasDerivAt (γ j) (deriv (γ j) X) X :=
      fun j => ((hγs j).differentiable (by simp) X).hasDerivAt
    have dF1 : HasDerivAt (fun e => rcRF γ c X e)
        (deriv c η 2 * γ 0 X + deriv c η 3 * γ 1 X + deriv c η 4 * γ 2 X) η :=
      (((hcD 2).mul_const (γ 0 X)).add ((hcD 3).mul_const (γ 1 X))).add ((hcD 4).mul_const (γ 2 X))
    have dU1 : HasDerivAt (fun e => rcRU β c X e) (deriv c η 0 * β 0 X + deriv c η 1 * β 1 X) η :=
      ((hcD 0).mul_const (β 0 X)).add ((hcD 1).mul_const (β 1 X))
    have dF2 : HasDerivAt (fun Y => rcRF γ c Y η)
        (c η 2 * deriv (γ 0) X + c η 3 * deriv (γ 1) X + c η 4 * deriv (γ 2) X) X :=
      (((hγd 0).const_mul (c η 2)).add ((hγd 1).const_mul (c η 3))).add ((hγd 2).const_mul (c η 4))
    have dU2 : HasDerivAt (fun Y => rcRU β c Y η) (c η 0 * deriv (β 0) X + c η 1 * deriv (β 1) X) X :=
      ((hβd 0).const_mul (c η 0)).add ((hβd 1).const_mul (c η 1))
    have tri : ∀ a1 a2 a3 b1 b2 b3 : ℝ, |a1| ≤ θ → |a2| ≤ θ → |a3| ≤ θ → |b1| ≤ A → |b2| ≤ A →
        |b3| ≤ A → |a1 * b1 + a2 * b2 + a3 * b3| ≤ 3 * A * θ := by
      intro a1 a2 a3 b1 b2 b3 k1 k2 k3 l1 l2 l3
      have m1 : |a1 * b1| ≤ θ * A := by rw [abs_mul]; exact mul_le_mul k1 l1 (abs_nonneg _) hθ
      have m2 : |a2 * b2| ≤ θ * A := by rw [abs_mul]; exact mul_le_mul k2 l2 (abs_nonneg _) hθ
      have m3 : |a3 * b3| ≤ θ * A := by rw [abs_mul]; exact mul_le_mul k3 l3 (abs_nonneg _) hθ
      have := abs_add_three (a1 * b1) (a2 * b2) (a3 * b3)
      linarith
    have duo : ∀ a1 a2 b1 b2 : ℝ, |a1| ≤ θ → |a2| ≤ θ → |b1| ≤ A → |b2| ≤ A →
        |a1 * b1 + a2 * b2| ≤ 3 * A * θ := by
      intro a1 a2 b1 b2 k1 k2 l1 l2
      have m1 : |a1 * b1| ≤ θ * A := by rw [abs_mul]; exact mul_le_mul k1 l1 (abs_nonneg _) hθ
      have m2 : |a2 * b2| ≤ θ * A := by rw [abs_mul]; exact mul_le_mul k2 l2 (abs_nonneg _) hθ
      have := abs_add_le (a1 * b1) (a2 * b2)
      have : 0 ≤ θ * A := mul_nonneg hθ hA0
      linarith
    rw [dF1.deriv, dU1.deriv, dF2.deriv, dU2.deriv]
    refine ⟨dF1, dU1, dF2, dU2, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · exact tri _ _ _ _ _ _ (hck 2) (hck 3) (hck 4) ((hg1 X).1.trans e3) ((hg2 X).1.trans e4)
        ((hg3 X).1.trans e5)
    · exact duo _ _ _ _ (hck 0) (hck 1) ((hb1 X).1.trans e1) ((hb2 X).1.trans e2)
    · exact tri _ _ _ _ _ _ (hcdk 2) (hcdk 3) (hcdk 4) ((hg1 X).1.trans e3) ((hg2 X).1.trans e4)
        ((hg3 X).1.trans e5)
    · exact duo _ _ _ _ (hcdk 0) (hcdk 1) ((hb1 X).1.trans e1) ((hb2 X).1.trans e2)
    · exact tri _ _ _ _ _ _ (hck 2) (hck 3) (hck 4) ((hg1 X).2.trans e3) ((hg2 X).2.trans e4)
        ((hg3 X).2.trans e5)
    · exact duo _ _ _ _ (hck 0) (hck 1) ((hb1 X).2.trans e1) ((hb2 X).2.trans e2)

theorem rc_moment_window : ∀ (f u g v rF rU f0 fP : ℝ → ℝ) (a b r1 s2 r2 : ℝ) (d : Fin 5 → ℝ), 0 < a → a < b → b < r1 → r1 < s2 → s2 < r2 → ContinuousOn f (Icc 0 r2) → ContinuousOn u (Icc 0 r2) → ContinuousOn g (Icc a b) → ContinuousOn v (Icc a b) → Continuous rF → Continuous rU → (∀ x : ℝ, (x ≤ a ∨ b ≤ x) → g x = f x ∧ v x = u x) → (∀ x : ℝ, (x ≤ r1 ∨ s2 ≤ x) → rF x = 0 ∧ rU x = 0) → (∀ x : ℝ, r1 ≤ x → x ≤ r2 → u x = 0 ∧ f x = f0 x) → (∀ x : ℝ, fP x = f0 x + rF x) → IntegrableOn (fun x => f x ^ 2) (Ioi 0) → d 0 = -∫ x in a..b, (v x - u x) → d 1 = -∫ x in a..b, 2 * x * (g x - f x) → d 2 = -∫ x in a..b, (v x * (2 * x * g x) - u x * (2 * x * f x)) → d 3 = -∫ x in a..b, ((v x ^ 2 - x * g x ^ 2) - (u x ^ 2 - x * f x ^ 2)) → d 4 = -∫ x in a..b, (g x ^ 2 - f x ^ 2) → (∫ x in r1..r2, rU x) = d 0 → (∫ x in r1..r2, 2 * x * (fP x - f0 x)) = d 1 → (∫ x in r1..r2, rU x * (2 * x * fP x)) = d 2 → (∫ x in r1..r2, (rU x ^ 2 - x * fP x ^ 2 + x * f0 x ^ 2)) = d 3 → (∫ x in r1..r2, (fP x ^ 2 - f0 x ^ 2)) = d 4 → (∫ x in (0:ℝ)..s2, (v x + rU x)) = (∫ x in (0:ℝ)..s2, u x) ∧ (∫ x in (0:ℝ)..s2, 2 * x * (g x + rF x)) = (∫ x in (0:ℝ)..s2, 2 * x * f x) ∧ (∫ x in (0:ℝ)..s2, (v x + rU x) * (2 * x * (g x + rF x))) = (∫ x in (0:ℝ)..s2, u x * (2 * x * f x)) ∧ (∫ x in (0:ℝ)..s2, ((v x + rU x) ^ 2 - x * (g x + rF x) ^ 2)) = (∫ x in (0:ℝ)..s2, (u x ^ 2 - x * f x ^ 2)) ∧ IntegrableOn (fun x => (g x + rF x) ^ 2) (Ioi 0) ∧ (∫ x in Ioi (0:ℝ), (g x + rF x) ^ 2) = ∫ x in Ioi (0:ℝ), f x ^ 2 :=
by
  intro f u g v rF rU f0 fP a b r1 s2 r2 d ha hab hbr1 hr1s2 hs2r2 hf hu hg hv hrF hrU hW hZ hP hfP
    hInt hd0 hd1 hd2 hd3 hd4 hR0 hR1 hR2 hR3 hR4

  have glue : ∀ (F G : ℝ → ℝ), ContinuousOn F (Icc 0 r2) → ContinuousOn G (Icc a b) →
      (∀ x : ℝ, (x ≤ a ∨ b ≤ x) → G x = F x) → ContinuousOn G (Icc 0 r2) := by
    intro F G hF hG hGF
    have h1 : ContinuousOn G (Icc 0 a) :=
      (hF.mono (Icc_subset_Icc le_rfl (by linarith))).congr (fun x hx => hGF x (Or.inl hx.2))
    have h3 : ContinuousOn G (Icc b r2) :=
      (hF.mono (Icc_subset_Icc (by linarith) le_rfl)).congr (fun x hx => hGF x (Or.inr hx.1))
    have h12 : ContinuousOn G (Icc 0 b) := by
      rw [← Icc_union_Icc_eq_Icc ha.le hab.le]
      exact h1.union_of_isClosed hG isClosed_Icc isClosed_Icc
    rw [← Icc_union_Icc_eq_Icc (by linarith : (0:ℝ) ≤ b) (by linarith : b ≤ r2)]
    exact h12.union_of_isClosed h3 isClosed_Icc isClosed_Icc
  have hsub : Icc (0:ℝ) s2 ⊆ Icc 0 r2 := Icc_subset_Icc le_rfl hs2r2.le
  have hg2 : ContinuousOn g (Icc 0 s2) := (glue f g hf hg (fun x hx => (hW x hx).1)).mono hsub
  have hv2 : ContinuousOn v (Icc 0 s2) := (glue u v hu hv (fun x hx => (hW x hx).2)).mono hsub
  have hf2 : ContinuousOn f (Icc 0 s2) := hf.mono hsub
  have hu2 : ContinuousOn u (Icc 0 s2) := hu.mono hsub
  have hrF2 : ContinuousOn rF (Icc 0 s2) := hrF.continuousOn
  have hrU2 : ContinuousOn rU (Icc 0 s2) := hrU.continuousOn
  have hrF1 : ContinuousOn rF (Icc r1 r2) := hrF.continuousOn
  have hrU1 : ContinuousOn rU (Icc r1 r2) := hrU.continuousOn
  have hf01 : ContinuousOn f0 (Icc r1 r2) :=
    (hf.mono (Icc_subset_Icc (by linarith) le_rfl)).congr (fun x hx => (hP x hx.1 hx.2).2.symm)
  have hfP1 : ContinuousOn fP (Icc r1 r2) :=
    (hf01.add hrF1).congr (fun x _ => hfP x)
  have II0 : ∀ φ : ℝ → ℝ, ContinuousOn φ (Icc 0 s2) → IntervalIntegrable φ volume 0 s2 := by
    intro φ hφ
    apply ContinuousOn.intervalIntegrable
    rw [uIcc_of_le (by linarith)]
    exact hφ
  have II1 : ∀ φ : ℝ → ℝ, ContinuousOn φ (Icc r1 r2) → IntervalIntegrable φ volume r1 r2 := by
    intro φ hφ
    apply ContinuousOn.intervalIntegrable
    rw [uIcc_of_le (by linarith)]
    exact hφ

  have split : ∀ (D Q P : ℝ → ℝ), IntervalIntegrable D volume 0 s2 →
      IntervalIntegrable P volume r1 r2 →
      (∀ x : ℝ, 0 ≤ x → x ≤ a → D x = 0) → (∀ x : ℝ, a ≤ x → x ≤ b → D x = Q x) →
      (∀ x : ℝ, b ≤ x → x ≤ r1 → D x = 0) → (∀ x : ℝ, r1 ≤ x → x ≤ s2 → D x = P x) →
      (∀ x : ℝ, s2 ≤ x → x ≤ r2 → P x = 0) →
      (∫ x in (0:ℝ)..s2, D x) = (∫ x in a..b, Q x) + ∫ x in r1..r2, P x := by
    intro D Q P hD hPi h1 h2 h3 h4 h5
    have m : ∀ p q : ℝ, 0 ≤ p → p ≤ q → q ≤ s2 → IntervalIntegrable D volume p q := by
      intro p q hp hpq hq
      apply hD.mono_set
      rw [uIcc_of_le hpq, uIcc_of_le (by linarith)]
      exact Icc_subset_Icc hp hq
    have mP : ∀ p q : ℝ, r1 ≤ p → p ≤ q → q ≤ r2 → IntervalIntegrable P volume p q := by
      intro p q hp hpq hq
      apply hPi.mono_set
      rw [uIcc_of_le hpq, uIcc_of_le (by linarith)]
      exact Icc_subset_Icc hp hq
    have e1 := intervalIntegral.integral_add_adjacent_intervals (m 0 a le_rfl ha.le (by linarith))
      (m a b ha.le hab.le (by linarith))
    have e2 := intervalIntegral.integral_add_adjacent_intervals
      (m 0 b le_rfl (by linarith) (by linarith)) (m b r1 (by linarith) hbr1.le (by linarith))
    have e3 := intervalIntegral.integral_add_adjacent_intervals
      (m 0 r1 le_rfl (by linarith) (by linarith)) (m r1 s2 (by linarith) hr1s2.le le_rfl)
    have e4 := intervalIntegral.integral_add_adjacent_intervals
      (mP r1 s2 le_rfl hr1s2.le hs2r2.le) (mP s2 r2 hr1s2.le hs2r2.le le_rfl)
    have z1 : (∫ x in (0:ℝ)..a, D x) = ∫ x in (0:ℝ)..a, (0:ℝ) := by
      apply intervalIntegral.integral_congr
      intro x hx
      rw [uIcc_of_le ha.le] at hx
      exact h1 x hx.1 hx.2
    have z2 : (∫ x in a..b, D x) = ∫ x in a..b, Q x := by
      apply intervalIntegral.integral_congr
      intro x hx
      rw [uIcc_of_le hab.le] at hx
      exact h2 x hx.1 hx.2
    have z3 : (∫ x in b..r1, D x) = ∫ x in b..r1, (0:ℝ) := by
      apply intervalIntegral.integral_congr
      intro x hx
      rw [uIcc_of_le hbr1.le] at hx
      exact h3 x hx.1 hx.2
    have z4 : (∫ x in r1..s2, D x) = ∫ x in r1..s2, P x := by
      apply intervalIntegral.integral_congr
      intro x hx
      rw [uIcc_of_le hr1s2.le] at hx
      exact h4 x hx.1 hx.2
    have z5 : (∫ x in s2..r2, P x) = ∫ x in s2..r2, (0:ℝ) := by
      apply intervalIntegral.integral_congr
      intro x hx
      rw [uIcc_of_le hs2r2.le] at hx
      exact h5 x hx.1 hx.2
    simp only [intervalIntegral.integral_zero] at z1 z3 z5
    linarith

  have k0 : (∫ x in (0:ℝ)..s2, ((v x + rU x) - u x)) =
      (∫ x in a..b, (v x - u x)) + ∫ x in r1..r2, rU x := by
    refine split (fun x => (v x + rU x) - u x) (fun x => v x - u x) (fun x => rU x)
      (II0 _ (by fun_prop)) (II1 _ (by fun_prop)) ?_ ?_ ?_ ?_ ?_
    · intro x _ hx
      obtain ⟨e1, e2⟩ := hW x (Or.inl hx)
      obtain ⟨z1, z2⟩ := hZ x (Or.inl (by linarith))
      simp only [e1, e2, z1, z2] <;> ring
    · intro x _ hx
      obtain ⟨z1, z2⟩ := hZ x (Or.inl (by linarith))
      simp only [z1, z2] <;> ring
    · intro x hx hx'
      obtain ⟨e1, e2⟩ := hW x (Or.inr hx)
      obtain ⟨z1, z2⟩ := hZ x (Or.inl hx')
      simp only [e1, e2, z1, z2] <;> ring
    · intro x hx hx'
      obtain ⟨e1, e2⟩ := hW x (Or.inr (by linarith))
      obtain ⟨p1, p2⟩ := hP x hx (by linarith)
      simp only [e1, e2, p1, p2, hfP x] <;> ring
    · intro x hx _
      obtain ⟨z1, z2⟩ := hZ x (Or.inr hx)
      simp only [z1, z2, hfP x] <;> ring
  have k1 : (∫ x in (0:ℝ)..s2, (2 * x * (g x + rF x) - 2 * x * f x)) =
      (∫ x in a..b, 2 * x * (g x - f x)) + ∫ x in r1..r2, 2 * x * (fP x - f0 x) := by
    refine split (fun x => 2 * x * (g x + rF x) - 2 * x * f x) (fun x => 2 * x * (g x - f x))
      (fun x => 2 * x * (fP x - f0 x)) (II0 _ (by fun_prop)) (II1 _ (by fun_prop)) ?_ ?_ ?_ ?_ ?_
    · intro x _ hx
      obtain ⟨e1, e2⟩ := hW x (Or.inl hx)
      obtain ⟨z1, z2⟩ := hZ x (Or.inl (by linarith))
      simp only [e1, e2, z1, z2] <;> ring
    · intro x _ hx
      obtain ⟨z1, z2⟩ := hZ x (Or.inl (by linarith))
      simp only [z1, z2] <;> ring
    · intro x hx hx'
      obtain ⟨e1, e2⟩ := hW x (Or.inr hx)
      obtain ⟨z1, z2⟩ := hZ x (Or.inl hx')
      simp only [e1, e2, z1, z2] <;> ring
    · intro x hx hx'
      obtain ⟨e1, e2⟩ := hW x (Or.inr (by linarith))
      obtain ⟨p1, p2⟩ := hP x hx (by linarith)
      simp only [e1, e2, p1, p2, hfP x] <;> ring
    · intro x hx _
      obtain ⟨z1, z2⟩ := hZ x (Or.inr hx)
      simp only [z1, z2, hfP x] <;> ring
  have k2 : (∫ x in (0:ℝ)..s2, ((v x + rU x) * (2 * x * (g x + rF x)) - u x * (2 * x * f x))) =
      (∫ x in a..b, (v x * (2 * x * g x) - u x * (2 * x * f x))) +
        ∫ x in r1..r2, rU x * (2 * x * fP x) := by
    refine split (fun x => (v x + rU x) * (2 * x * (g x + rF x)) - u x * (2 * x * f x))
      (fun x => v x * (2 * x * g x) - u x * (2 * x * f x))
      (fun x => rU x * (2 * x * fP x)) (II0 _ (by fun_prop)) (II1 _ (by fun_prop)) ?_ ?_ ?_ ?_ ?_
    · intro x _ hx
      obtain ⟨e1, e2⟩ := hW x (Or.inl hx)
      obtain ⟨z1, z2⟩ := hZ x (Or.inl (by linarith))
      simp only [e1, e2, z1, z2] <;> ring
    · intro x _ hx
      obtain ⟨z1, z2⟩ := hZ x (Or.inl (by linarith))
      simp only [z1, z2] <;> ring
    · intro x hx hx'
      obtain ⟨e1, e2⟩ := hW x (Or.inr hx)
      obtain ⟨z1, z2⟩ := hZ x (Or.inl hx')
      simp only [e1, e2, z1, z2] <;> ring
    · intro x hx hx'
      obtain ⟨e1, e2⟩ := hW x (Or.inr (by linarith))
      obtain ⟨p1, p2⟩ := hP x hx (by linarith)
      simp only [e1, e2, p1, p2, hfP x] <;> ring
    · intro x hx _
      obtain ⟨z1, z2⟩ := hZ x (Or.inr hx)
      simp only [z1, z2, hfP x] <;> ring
  have k3 : (∫ x in (0:ℝ)..s2, (((v x + rU x) ^ 2 - x * (g x + rF x) ^ 2) - (u x ^ 2 - x * f x ^ 2))) =
      (∫ x in a..b, ((v x ^ 2 - x * g x ^ 2) - (u x ^ 2 - x * f x ^ 2))) +
        ∫ x in r1..r2, (rU x ^ 2 - x * fP x ^ 2 + x * f0 x ^ 2) := by
    refine split (fun x => ((v x + rU x) ^ 2 - x * (g x + rF x) ^ 2) - (u x ^ 2 - x * f x ^ 2))
      (fun x => (v x ^ 2 - x * g x ^ 2) - (u x ^ 2 - x * f x ^ 2))
      (fun x => rU x ^ 2 - x * fP x ^ 2 + x * f0 x ^ 2) (II0 _ (by fun_prop)) (II1 _ (by fun_prop))
      ?_ ?_ ?_ ?_ ?_
    · intro x _ hx
      obtain ⟨e1, e2⟩ := hW x (Or.inl hx)
      obtain ⟨z1, z2⟩ := hZ x (Or.inl (by linarith))
      simp only [e1, e2, z1, z2] <;> ring
    · intro x _ hx
      obtain ⟨z1, z2⟩ := hZ x (Or.inl (by linarith))
      simp only [z1, z2] <;> ring
    · intro x hx hx'
      obtain ⟨e1, e2⟩ := hW x (Or.inr hx)
      obtain ⟨z1, z2⟩ := hZ x (Or.inl hx')
      simp only [e1, e2, z1, z2] <;> ring
    · intro x hx hx'
      obtain ⟨e1, e2⟩ := hW x (Or.inr (by linarith))
      obtain ⟨p1, p2⟩ := hP x hx (by linarith)
      simp only [e1, e2, p1, p2, hfP x] <;> ring
    · intro x hx _
      obtain ⟨z1, z2⟩ := hZ x (Or.inr hx)
      simp only [z1, z2, hfP x] <;> ring
  have k4 : (∫ x in (0:ℝ)..s2, ((g x + rF x) ^ 2 - f x ^ 2)) =
      (∫ x in a..b, (g x ^ 2 - f x ^ 2)) + ∫ x in r1..r2, (fP x ^ 2 - f0 x ^ 2) := by
    refine split (fun x => (g x + rF x) ^ 2 - f x ^ 2) (fun x => g x ^ 2 - f x ^ 2)
      (fun x => fP x ^ 2 - f0 x ^ 2) (II0 _ (by fun_prop)) (II1 _ (by fun_prop)) ?_ ?_ ?_ ?_ ?_
    · intro x _ hx
      obtain ⟨e1, e2⟩ := hW x (Or.inl hx)
      obtain ⟨z1, z2⟩ := hZ x (Or.inl (by linarith))
      simp only [e1, e2, z1, z2] <;> ring
    · intro x _ hx
      obtain ⟨z1, z2⟩ := hZ x (Or.inl (by linarith))
      simp only [z1, z2] <;> ring
    · intro x hx hx'
      obtain ⟨e1, e2⟩ := hW x (Or.inr hx)
      obtain ⟨z1, z2⟩ := hZ x (Or.inl hx')
      simp only [e1, e2, z1, z2] <;> ring
    · intro x hx hx'
      obtain ⟨e1, e2⟩ := hW x (Or.inr (by linarith))
      obtain ⟨p1, p2⟩ := hP x hx (by linarith)
      simp only [e1, e2, p1, p2, hfP x] <;> ring
    · intro x hx _
      obtain ⟨z1, z2⟩ := hZ x (Or.inr hx)
      simp only [z1, z2, hfP x] <;> ring

  have s0 : (∫ x in (0:ℝ)..s2, ((v x + rU x) - u x)) =
      (∫ x in (0:ℝ)..s2, (v x + rU x)) - ∫ x in (0:ℝ)..s2, u x :=
    intervalIntegral.integral_sub (II0 _ (by fun_prop)) (II0 _ (by fun_prop))
  have s1 : (∫ x in (0:ℝ)..s2, (2 * x * (g x + rF x) - 2 * x * f x)) =
      (∫ x in (0:ℝ)..s2, 2 * x * (g x + rF x)) - ∫ x in (0:ℝ)..s2, 2 * x * f x :=
    intervalIntegral.integral_sub (II0 _ (by fun_prop)) (II0 _ (by fun_prop))
  have s2' : (∫ x in (0:ℝ)..s2, ((v x + rU x) * (2 * x * (g x + rF x)) - u x * (2 * x * f x))) =
      (∫ x in (0:ℝ)..s2, (v x + rU x) * (2 * x * (g x + rF x))) -
        ∫ x in (0:ℝ)..s2, u x * (2 * x * f x) :=
    intervalIntegral.integral_sub (II0 _ (by fun_prop)) (II0 _ (by fun_prop))
  have s3 : (∫ x in (0:ℝ)..s2, (((v x + rU x) ^ 2 - x * (g x + rF x) ^ 2) - (u x ^ 2 - x * f x ^ 2))) =
      (∫ x in (0:ℝ)..s2, ((v x + rU x) ^ 2 - x * (g x + rF x) ^ 2)) -
        ∫ x in (0:ℝ)..s2, (u x ^ 2 - x * f x ^ 2) :=
    intervalIntegral.integral_sub (II0 _ (by fun_prop)) (II0 _ (by fun_prop))
  have s4 : (∫ x in (0:ℝ)..s2, ((g x + rF x) ^ 2 - f x ^ 2)) =
      (∫ x in (0:ℝ)..s2, (g x + rF x) ^ 2) - ∫ x in (0:ℝ)..s2, f x ^ 2 :=
    intervalIntegral.integral_sub (II0 _ (by fun_prop)) (II0 _ (by fun_prop))

  have hs20 : (0:ℝ) ≤ s2 := by linarith
  have hφc : ContinuousOn (fun x => (g x + rF x) ^ 2) (Icc 0 s2) := by fun_prop
  have heq : ∀ x : ℝ, s2 < x → (g x + rF x) ^ 2 = f x ^ 2 := by
    intro x hx
    rw [(hW x (Or.inr (by linarith))).1, (hZ x (Or.inr hx.le)).1, add_zero]
  have hφIoc : IntegrableOn (fun x => (g x + rF x) ^ 2) (Ioc 0 s2) :=
    hφc.integrableOn_Icc.mono_set Ioc_subset_Icc_self
  have hψIoi : IntegrableOn (fun x => f x ^ 2) (Ioi s2) := hInt.mono_set (Ioi_subset_Ioi hs20)
  have hφIoi : IntegrableOn (fun x => (g x + rF x) ^ 2) (Ioi s2) :=
    hψIoi.congr_fun (fun x hx => (heq x hx).symm) measurableSet_Ioi
  have hψIoc : IntegrableOn (fun x => f x ^ 2) (Ioc 0 s2) := hInt.mono_set Ioc_subset_Ioi_self
  have hU : Ioi (0:ℝ) = Ioc 0 s2 ∪ Ioi s2 := (Ioc_union_Ioi_eq_Ioi hs20).symm
  have hφint : IntegrableOn (fun x => (g x + rF x) ^ 2) (Ioi 0) := by
    rw [hU]; exact hφIoc.union hφIoi
  refine ⟨by linarith, by linarith, by linarith, by linarith, hφint, ?_⟩
  rw [hU, setIntegral_union Ioc_disjoint_Ioi_same measurableSet_Ioi hφIoc hφIoi,
    setIntegral_union Ioc_disjoint_Ioi_same measurableSet_Ioi hψIoc hψIoi,
    ← intervalIntegral.integral_of_le hs20, ← intervalIntegral.integral_of_le hs20,
    setIntegral_congr_fun measurableSet_Ioi (fun x hx => heq x hx)]
  linarith

theorem rc_profilereg_transfer : ∀ (h cinf Xb ε Xm Xp a b : ℝ) (F U G V RF RU F' U' : ℝ → ℝ → ℝ), 0 < ε → 0 < Xm → Xm < a → a < b → b < Xp → Xp < Xb → ProfileReg h cinf Xb ε F U → (∀ X η : ℝ, (X ≤ a ∨ b ≤ X) → G X η = F X η ∧ V X η = U X η) → ContDiffOn ℝ ∞ (↿G) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿V) (Ioi 0 ×ˢ Ioo (-1) 1) → (∀ m : ℕ, ∃ C : ℝ, ∀ X η : ℝ, Xm ≤ X → X ≤ Xp → -1 < η → η < 1 → ‖iteratedFDeriv ℝ m (↿G) (X, η)‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿V) (X, η)‖ ≤ C) → ContDiffOn ℝ ∞ (↿RF) (univ ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿RU) (univ ×ˢ Ioo (-1) 1) → (∀ m : ℕ, ∃ C : ℝ, ∀ z ∈ (univ : Set ℝ) ×ˢ Ioo (-1 : ℝ) 1, ‖iteratedFDeriv ℝ m (↿RF) z‖ ≤ C ∧ ‖iteratedFDeriv ℝ m (↿RU) z‖ ≤ C) → (∀ X η : ℝ, (X ≤ a ∨ Xb ≤ X) → RF X η = 0 ∧ RU X η = 0) → (∀ X η : ℝ, F' X η = G X η + RF X η ∧ U' X η = V X η + RU X η) → (∀ X η : ℝ, 0 < X → -1 < η → η < 1 → 0 < F' X η) → (∀ η : ℝ, -1 < η → η < 1 → IntegrableOn (fun x => F' x η ^ 2) (Ioi 0)) → ProfileReg h cinf Xb ε F' U' :=
by
  intro h cinf Xb ε Xm Xp a b F U G V RF RU F' U' hε hXm hXma hab hbXp hXpXb hPR hAgr hGs hVs hGbd
    hRFs hRUs hRbd hRvan hDef hPos hInt
  obtain ⟨hFs, hUs, hFpos, hFbd, hFint, hheat⟩ := hPR
  have ha0 : 0 < a := by linarith
  have hL : ∀ X η : ℝ, X ≤ a → F' X η = F X η ∧ U' X η = U X η := by
    intro X η hX
    obtain ⟨g1, g2⟩ := hAgr X η (Or.inl hX)
    obtain ⟨r1, r2⟩ := hRvan X η (Or.inl hX)
    rw [(hDef X η).1, (hDef X η).2, g1, g2, r1, r2]
    simp
  have hR : ∀ X η : ℝ, Xb ≤ X → F' X η = F X η ∧ U' X η = U X η := by
    intro X η hX
    obtain ⟨g1, g2⟩ := hAgr X η (Or.inr (by linarith))
    obtain ⟨r1, r2⟩ := hRvan X η (Or.inr hX)
    rw [(hDef X η).1, (hDef X η).2, g1, g2, r1, r2]
    simp
  have hsmooth : ∀ (P Q R P' : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿P) (Ioi (-ε) ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿Q) (Ioi 0 ×ˢ Ioo (-1) 1) → ContDiffOn ℝ ∞ (↿R) (univ ×ˢ Ioo (-1) 1) →
      (∀ X η : ℝ, X ≤ a → P' X η = P X η) → (∀ X η : ℝ, P' X η = Q X η + R X η) →
      ContDiffOn ℝ ∞ (↿P') (Ioi (-ε) ×ˢ Ioo (-1) 1) := by
    intro P Q R P' hP hQ hR' hloc hsum
    apply contDiffOn_of_locally_contDiffOn
    intro z hz
    by_cases hza : z.1 < a
    · refine ⟨Iio a ×ˢ univ, isOpen_Iio.prod isOpen_univ, ⟨hza, mem_univ _⟩, ?_⟩
      exact (hP.mono inter_subset_left).congr (fun w hw => hloc w.1 w.2 (le_of_lt hw.2.1))
    · have hz0 : (0:ℝ) < z.1 := by push_neg at hza; linarith
      refine ⟨Ioi 0 ×ˢ univ, isOpen_Ioi.prod isOpen_univ, ⟨hz0, mem_univ _⟩, ?_⟩
      have hsub1 : Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 ∩ Ioi 0 ×ˢ univ ⊆ Ioi 0 ×ˢ Ioo (-1:ℝ) 1 :=
        fun w hw => ⟨hw.2.1, hw.1.2⟩
      have hsub2 : Ioi (-ε) ×ˢ Ioo (-1:ℝ) 1 ∩ Ioi 0 ×ˢ univ ⊆ univ ×ˢ Ioo (-1:ℝ) 1 :=
        fun w hw => ⟨mem_univ _, hw.1.2⟩
      exact ((hQ.mono hsub1).add (hR'.mono hsub2)).congr (fun w _ => hsum w.1 w.2)
  have hjet : ∀ (P Q R P' : ℝ → ℝ → ℝ), ContDiffOn ℝ ∞ (↿Q) (Ioi 0 ×ˢ Ioo (-1) 1) →
      ContDiffOn ℝ ∞ (↿R) (univ ×ˢ Ioo (-1) 1) →
      (∀ X η : ℝ, X ≤ a → P' X η = P X η) → (∀ X η : ℝ, b ≤ X → Q X η = P X η) →
      (∀ X η : ℝ, P' X η = Q X η + R X η) →
      ∀ (m : ℕ) (CF CG CR X η : ℝ), 0 ≤ X → -1 < η → η < 1 →
      ‖iteratedFDeriv ℝ m (↿P) (X, η)‖ ≤ CF →
      (Xm ≤ X → X ≤ Xp → ‖iteratedFDeriv ℝ m (↿Q) (X, η)‖ ≤ CG) →
      ‖iteratedFDeriv ℝ m (↿R) (X, η)‖ ≤ CR →
      ‖iteratedFDeriv ℝ m (↿P') (X, η)‖ ≤ |CF| + |CG| + |CR| := by
    intro P Q R P' hQ hR' hloc hQP hsum m CF CG CR X η hX0 e1 e2 hCF hCG hCR
    have a1 := le_abs_self CF
    have a2 := le_abs_self CG
    have a3 := le_abs_self CR
    have b1 := abs_nonneg CF
    have b2 := abs_nonneg CG
    have b3 := abs_nonneg CR
    by_cases hA : X < a
    · have hmemA : ((X, η) : ℝ × ℝ) ∈ Iio a ×ˢ (univ : Set ℝ) := ⟨hA, mem_univ _⟩
      have hev : (↿P') =ᶠ[nhds ((X, η) : ℝ × ℝ)] (↿P) :=
        Filter.eventuallyEq_of_mem ((isOpen_Iio.prod isOpen_univ).mem_nhds hmemA)
          (fun w hw => hloc w.1 w.2 (le_of_lt hw.1))
      rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
      linarith
    · push_neg at hA
      have hmem : ((X, η) : ℝ × ℝ) ∈ Ioi (0:ℝ) ×ˢ Ioo (-1:ℝ) 1 := ⟨show (0:ℝ) < X by linarith, e1, e2⟩
      have hmem2 : ((X, η) : ℝ × ℝ) ∈ (univ : Set ℝ) ×ˢ Ioo (-1:ℝ) 1 := ⟨mem_univ _, e1, e2⟩
      have hQa : ContDiffAt ℝ m (↿Q) (X, η) :=
        (hQ.contDiffAt ((isOpen_Ioi.prod isOpen_Ioo).mem_nhds hmem)).of_le (by exact_mod_cast le_top)
      have hRa : ContDiffAt ℝ m (↿R) (X, η) :=
        (hR'.contDiffAt ((isOpen_univ.prod isOpen_Ioo).mem_nhds hmem2)).of_le
          (by exact_mod_cast le_top)
      have hPe : (↿P') = (↿Q) + (↿R) := by
        funext z
        exact hsum z.1 z.2
      rw [hPe, iteratedFDeriv_add_apply hQa hRa]
      have hn := norm_add_le (iteratedFDeriv ℝ m (↿Q) (X, η)) (iteratedFDeriv ℝ m (↿R) (X, η))
      by_cases hB : X ≤ Xp
      · have := hCG (by linarith) hB
        linarith
      · push_neg at hB
        have hmemB : ((X, η) : ℝ × ℝ) ∈ Ioi b ×ˢ (univ : Set ℝ) :=
          ⟨show b < X by linarith, mem_univ _⟩
        have hev : (↿Q) =ᶠ[nhds ((X, η) : ℝ × ℝ)] (↿P) :=
          Filter.eventuallyEq_of_mem ((isOpen_Ioi.prod isOpen_univ).mem_nhds hmemB)
            (fun w hw => hQP w.1 w.2 (le_of_lt hw.1))
        have hq : ‖iteratedFDeriv ℝ m (↿Q) (X, η)‖ = ‖iteratedFDeriv ℝ m (↿P) (X, η)‖ := by
          rw [(hev.iteratedFDeriv ℝ m).eq_of_nhds]
        linarith
  refine ⟨hsmooth F G RF F' hFs hGs hRFs (fun X η hX => (hL X η hX).1) (fun X η => (hDef X η).1),
    hsmooth U V RU U' hUs hVs hRUs (fun X η hX => (hL X η hX).2) (fun X η => (hDef X η).2),
    ?_, ?_, hInt, ?_⟩
  · intro X η hX e1 e2
    by_cases hXa : X ≤ a
    · rw [(hL X η hXa).1]
      exact hFpos X η hX e1 e2
    · exact hPos X η (by linarith [not_le.mp hXa]) e1 e2
  · intro X₁ m
    obtain ⟨CF, hCF⟩ := hFbd X₁ m
    obtain ⟨CG, hCG⟩ := hGbd m
    obtain ⟨CR, hCR⟩ := hRbd m
    refine ⟨|CF| + |CG| + |CR|, fun X η hX0 hX1 e1 e2 => ⟨?_, ?_⟩⟩
    · exact hjet F G RF F' hGs hRFs (fun X η hX => (hL X η hX).1)
        (fun X η hX => (hAgr X η (Or.inr hX)).1) (fun X η => (hDef X η).1) m CF CG CR X η hX0 e1 e2
        (hCF X η hX0 hX1 e1 e2).1 (fun h1 h2 => (hCG X η h1 h2 e1 e2).1)
        (hCR (X, η) ⟨mem_univ _, e1, e2⟩).1
    · exact hjet U V RU U' hVs hRUs (fun X η hX => (hL X η hX).2)
        (fun X η hX => (hAgr X η (Or.inr hX)).2) (fun X η => (hDef X η).2) m CF CG CR X η hX0 e1 e2
        (hCF X η hX0 hX1 e1 e2).2 (fun h1 h2 => (hCG X η h1 h2 e1 e2).2)
        (hCR (X, η) ⟨mem_univ _, e1, e2⟩).2
  · intro X η hX e1 e2
    rw [(hR X η hX).1, (hR X η hX).2]
    exact hheat X η hX e1 e2

