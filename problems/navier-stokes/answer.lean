theorem tHjet_coef_bound_v5 : ∀ (B : BG) (G : CorrGeom), B.ok → GeomPrim5 B G → ∀ (M : Lab → ℝ × ℝ × ℝ → ℝ → Fin 3 → Fin 3 → ℝ), (∀ γ : Lab, ContDiffOn ℝ ∞ (fun w : (ℝ × ℝ × ℝ) × ℝ => M γ w.1 w.2) ({s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB} ×ˢ Set.univ)) → (∀ (γ : Lab), ∀ ξ ∈ DomC B.h B.qB, inRect B.h γ (G.ctr γ) G.r0 ξ.2.2.2 → ∀ z : Fin 3 → ℝ, Matrix.mulVec (M γ (ξ.1, ξ.2.1, ξ.2.2.1) (vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2)) z = (APhi5 B G γ ξ).mulVec z - dDamp5 B G γ ξ • z) → ∃ l1 : ℕ, ∀ k : ℕ, ∃ C b : ℝ, ∀ (γ : Lab) (ξ : Cyl) (v : ℝ), l1 ≤ γ.1 → ActiveL4 B G γ → etaL B.h γ ξ ≠ 0 → ξ ∈ DomC B.h B.qB → B.Xa ≤ XC B.h ξ → XC B.h ξ ≤ B.Xb → inRect B.h γ (G.ctr γ) G.r0 ξ.2.2.2 → 0 ≤ v → v ≤ Lsb B.h G.r0 γ.1 → ‖(iteratedFDeriv ℝ k (fun w : (ℝ × ℝ × ℝ) × ℝ => M γ w.1 w.2) ((ξ.1, ξ.2.1, ξ.2.2.1), v)).compContinuousLinearMap (fun _ => ((Real.sqrt (qC B.h ξ) • ContinuousLinearMap.id ℝ ℝ).prodMap ((qC B.h ξ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ))).prodMap (ContinuousLinearMap.id ℝ ℝ))‖ ≤ C * SC B.h ξ ^ b ∧ ‖(iteratedFDeriv ℝ k (fun s : ℝ × ℝ × ℝ => M γ s v) (ξ.1, ξ.2.1, ξ.2.2.1)).compContinuousLinearMap (fun _ => (Real.sqrt (qC B.h ξ) • ContinuousLinearMap.id ℝ ℝ).prodMap ((qC B.h ξ ^ (1/2 - B.h) • ContinuousLinearMap.id ℝ ℝ).prodMap (qC B.h ξ • ContinuousLinearMap.id ℝ ℝ)))‖ ≤ C * SC B.h ξ ^ b :=
by
  intro B G hB hG M hMs hM

  have key : ∀ {D E W : Type} [NormedAddCommGroup D] [NormedSpace ℝ D] [NormedAddCommGroup E]
      [NormedSpace ℝ E] [NormedAddCommGroup W] [NormedSpace ℝ W] (F : E → W) (V : Set E) (a : E)
      (T : D →L[ℝ] E), IsOpen V → ContDiffOn ℝ ∞ F V → a ∈ V → ∀ i : ℕ,
      iteratedFDeriv ℝ i (fun z => F (a + T z)) 0 =
        (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro D E W _ _ _ _ _ _ F V a T hV hF ha i
    obtain ⟨s, hs_def⟩ : ∃ s : Set E, s = (fun z : E => a + z) ⁻¹' V := ⟨_, rfl⟩
    have hs : IsOpen s := by
      rw [hs_def]; exact hV.preimage (continuous_const.add continuous_id)
    have hO : IsOpen (⇑T ⁻¹' s) := hs.preimage T.continuous
    have h0s : (0 : E) ∈ s := by
      rw [hs_def]; show a + 0 ∈ V; rw [add_zero]; exact ha
    have hT0s : T 0 ∈ s := by rw [map_zero]; exact h0s
    have h0O : (0 : D) ∈ ⇑T ⁻¹' s := hT0s
    have hsm : ContDiffOn ℝ ∞ (fun z => F (a + z)) s :=
      hF.comp (contDiff_const.add contDiff_id).contDiffOn
        (fun z hz => by rw [hs_def] at hz; exact hz)
    have e1 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + T z)) i hO h0O
    have e2 := ContinuousLinearMap.iteratedFDerivWithin_comp_right T hsm hs.uniqueDiffOn
      hO.uniqueDiffOn hT0s (i := i) (by exact_mod_cast le_top)
    have e3 := iteratedFDerivWithin_of_isOpen (𝕜 := ℝ) (f := fun z => F (a + z)) i hs h0s
    have e4 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := F) i a 0
    calc iteratedFDeriv ℝ i (fun z => F (a + T z)) 0
        = iteratedFDerivWithin ℝ i ((fun z => F (a + z)) ∘ ⇑T) (⇑T ⁻¹' s) 0 := e1.symm
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s (T 0)).compContinuousLinearMap
            (fun _ => T) := e2
      _ = (iteratedFDerivWithin ℝ i (fun z => F (a + z)) s 0).compContinuousLinearMap
            (fun _ => T) := by rw [map_zero]
      _ = (iteratedFDeriv ℝ i (fun z => F (a + z)) 0).compContinuousLinearMap
            (fun _ => T) := by rw [e3]
      _ = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by rw [e4, add_zero]
  have pull : ∀ {D E W : Type} [NormedAddCommGroup D] [NormedSpace ℝ D] [NormedAddCommGroup E]
      [NormedSpace ℝ E] [NormedAddCommGroup W] [NormedSpace ℝ W] (f : D → W) (x : D) (F : E → W)
      (V : Set E) (a : E) (T : D →L[ℝ] E), IsOpen V → ContDiffOn ℝ ∞ F V → a ∈ V →
      ((fun z => f (x + z)) =ᶠ[nhds (0:D)] (fun z => F (a + T z))) → ∀ i : ℕ,
      iteratedFDeriv ℝ i f x = (iteratedFDeriv ℝ i F a).compContinuousLinearMap (fun _ => T) := by
    intro D E W _ _ _ _ _ _ f x F V a T hV hF ha hfe i
    have h1 := iteratedFDeriv_comp_add_left (𝕜 := ℝ) (f := f) i x 0
    rw [add_zero] at h1
    rw [← h1, (hfe.iteratedFDeriv ℝ i).eq_of_nhds]
    exact key F V a T hV hF ha i
  have cmp : ∀ {D E W : Type} [NormedAddCommGroup D] [NormedSpace ℝ D] [NormedAddCommGroup E]
      [NormedSpace ℝ E] [NormedAddCommGroup W] [NormedSpace ℝ W] {n : ℕ}
      (Φ : ContinuousMultilinearMap ℝ (fun _ : Fin n => E) W) (T : D →L[ℝ] E) (Λ : D →L[ℝ] D)
      (Ln : E →L[ℝ] E) (R : D →L[ℝ] E), (∀ w, T (Λ w) = Ln (R w)) → ‖R‖ ≤ 1 →
      ‖(Φ.compContinuousLinearMap (fun _ => T)).compContinuousLinearMap (fun _ => Λ)‖ ≤
        ‖Φ.compContinuousLinearMap (fun _ => Ln)‖ := by
    intro D E W _ _ _ _ _ _ n Φ T Λ Ln R hTR hR
    have hc : (Φ.compContinuousLinearMap (fun _ => T)).compContinuousLinearMap (fun _ => Λ) =
        (Φ.compContinuousLinearMap (fun _ => Ln)).compContinuousLinearMap (fun _ => R) := by
      ext m
      simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply, hTR]
    rw [hc]
    refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    exact mul_le_of_le_one_right (norm_nonneg _) (pow_le_one₀ (norm_nonneg _) hR)

  obtain ⟨hΩo, -⟩ := geom_slow_base_smooth_v5 B hB
  obtain ⟨lA, hAc⟩ := aphi5_mat_nb_v5 B G hB hG
  obtain ⟨lR, hRc⟩ := pulse_dir_lnorm_factor_v5 B hB
  have hr0 : 0 < G.r0 := hG.1.1
  have hr0' : G.r0 ≤ 1/100 := hG.1.2.1
  have hTg0 : (0:ℝ) < Tgc := by unfold Tgc; positivity
  refine ⟨lA + lR, fun k => ?_⟩
  obtain ⟨C, b, hCb⟩ := hAc k
  refine ⟨C, b, ?_⟩
  intro γ ξ v hl hAct heta hD hX1 hX2 hR hv0 hvL
  set Ω : Set (ℝ × ℝ × ℝ) := {s : ℝ × ℝ × ℝ | 0 < s.1 ∧ s.2.2 < 1 ∧ simScale B.h s.2.1 (1 - s.2.2) < B.qB}
    with hΩdef
  have hs0 : ((ξ.1, ξ.2.1, ξ.2.2.1) : ℝ × ℝ × ℝ) ∈ Ω := hD
  obtain ⟨d, hd⟩ : ∃ d : ℝ × ℝ, d = (cib B.h γ.1 * Tgc ^ (-(bandIdx B.h γ.1))) • vtv := ⟨_, rfl⟩
  obtain ⟨y0, hy0⟩ : ∃ y0 : ℝ, y0 = vco B.h G.r0 γ (G.ctr γ) ξ.2.2.2 := ⟨_, rfl⟩
  obtain ⟨Af, hAf⟩ : ∃ Af : Cyl → Fin 3 → Fin 3 → ℝ, Af = (fun η : Cyl => fun a c : Fin 3 =>
      APhi5 B G γ η a c - (if a = c then dDamp5 B G γ η else 0)) := ⟨_, rfl⟩
  have hci : 0 < cib B.h γ.1 := by
    unfold cib
    have hQ : (0:ℝ) < Qb γ.1 := by unfold Qb; positivity
