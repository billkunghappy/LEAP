  obtain ⟨le, h7⟩ := pch5_coeff_struct B G hok hG
  obtain ⟨lf, h8⟩ := pch5_coeff_bound B G hok hG
  obtain ⟨lw, hw⟩ := wmo_amp_class_v5 B G hok hG
  refine ⟨la + lb + lc + ld + le + lf + lw, ?_⟩
  intro l0 hl0 S Bo D hBo hS hD hDv
  have hS' := hS
  unfold StOrd5 at hS'
  obtain ⟨c1, -, -, -, -, -, -, -, -, -, -, -, -, -, -, c16, -, c18, c19, -, c21, -, -⟩ := hS'
  have hM0 := (g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) 1.9 (mcor5 B G l0 S 0) hok c21).1
  have hM1 := (g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) 0.9 (mcor5 B G l0 S 1) hok c18).1
  have hM2 := (g_regular_of_nrm_InM_v5 B (qsOf l0) (Aex B.h) 0.9 (mcor5 B G l0 S 2) hok c19).1
  have hMn : ContDiffOn ℝ ∞ (fun ξ a => mcor5 B G l0 S a ξ) (DomC B.h (qsOf l0)) := by
    rw [contDiffOn_pi]
    intro a
    fin_cases a
    · exact hM0
    · exact hM1
    · exact hM2
  obtain ⟨hwA, -⟩ := hw l0 (by omega)
  have hc1' : InWg5 B G (qsOf l0) (1/2 + 1/2) S.Aw := by
    have e : (1/2 + 1/2 : ℝ) = 1 := by norm_num
    rw [e]
    exact c1
  have hP := hwA S.Aw (1/2) hc1' c16
  have hQ := hwA D Bo hD hDv
  have hU := h1 l0 (by omega) S Bo (Bo + 1/2) (Bo + 1/2) (Bo + 1/2) hS
  have hV := h2 l0 (by omega) D Bo hD hDv
  have hT := h5 l0 (by omega) (fun ξ a => mcor5 B G l0 S a ξ) (wmoAmp5 B G S.Aw) (wmoAmp5 B G D) (1/2) Bo
    (dUX5 B G l0 S) (wIncX5 B G l0 D) hMn hP hQ hU hV
  obtain ⟨s1, s2, s3, s4⟩ := h7 l0 (by omega) S Bo (Bo + 1/2) (Bo + 1/2) (Bo + 1/2) Bo D hS hD hDv
  have s5 := h8 l0 (by omega) S Bo (Bo + 1/2) (Bo + 1/2) (Bo + 1/2) Bo D hS hD hDv
  have hg : InWg5 B G (qsOf l0) (Bo + 2/5)
      (pchG5 B G (fun ξ a => mcor5 B G l0 S a ξ) (wmoAmp5 B G S.Aw) (wmoAmp5 B G D)) :=
    ⟨s1, s2, s3, s4, s5⟩
  have hTh := h6 l0 (by omega) (pchG5 B G (fun ξ a => mcor5 B G l0 S a ξ) (wmoAmp5 B G S.Aw) (wmoAmp5 B G D))
    (Bo + 2/5) (pchZ5 B G (fun ξ a => mcor5 B G l0 S a ξ) (wmoAmp5 B G S.Aw) (wmoAmp5 B G D))
    (CrT5 B G l0 S D) hg (fun x t Y hc => hT x t Y hc)
  refine ⟨pchG5 B G (fun ξ a => mcor5 B G l0 S a ξ) (wmoAmp5 B G S.Aw) (wmoAmp5 B G D),
    fun _ _ _ => (0 : ℝ³), hg, ?_, ?_⟩
  · refine ⟨?_, ?_, ?_⟩
    · intro m N
      refine ⟨0, fun Y₀ x t _ => ?_⟩
      show ‖iteratedFDeriv ℝ m (fun _ : ℝ³ × ℝ => (0 : ℝ³)) (x, t)‖ ≤ 0 * _
