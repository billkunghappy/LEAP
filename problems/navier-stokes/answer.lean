  have hAvg : ∀ e, profRadAvg (rfpU P) x e = x⁻¹ * profRadInt (rfpU P) x e := by
    intro e
    unfold profRadAvg profRadInt
    have := intervalIntegral.integral_comp_mul_right (fun t => rfpU P t e) hx0.ne' (a := 0) (b := 1)
    simp only [zero_mul, one_mul, smul_eq_mul] at this
    exact this
  have W1 : profRadInt (rfpU P) x η =
      η * KB + (1 + η ^ 2)⁻¹ * (P.Amp η * M0 + P.c1 η * M1 + P.c2 η * M2) := hMom1 η
  have W2 : profEtaD (profRadInt (rfpU P)) x η =
      KB + (-(2 * η) * ((1 + η ^ 2)⁻¹) ^ 2) * (P.Amp η * M0 + P.c1 η * M1 + P.c2 η * M2)
