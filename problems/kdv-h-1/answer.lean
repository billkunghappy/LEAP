    simp only [← hΛ, map_add]
  have htsub : ∀ a b : 𝓢(ℝ, ℝ), toHm1 (a - b) = toHm1 a - toHm1 b := fun a b => by
    simp only [← hΛ, map_sub]
  have htsmul : ∀ (c : ℝ) (a : 𝓢(ℝ, ℝ)), toHm1 (c • a) = c • toHm1 a := fun c a => by
    simp only [← hΛ, map_smul]
  have hιadd : ∀ a b : 𝓢(ℝ, ℝ), ι (a + b) = ι a + ι b := fun a b => Subtype.ext (htadd a b)
  have hιsub : ∀ a b : 𝓢(ℝ, ℝ), ι (a - b) = ι a - ι b := fun a b => Subtype.ext (htsub a b)
  have hιsmul : ∀ (c : ℝ) (a : 𝓢(ℝ, ℝ)), ι (c • a) = c • ι a := fun c a =>
    Subtype.ext (htsmul c a)
  
  
  
  have hI0 : ∀ h : 𝓢(ℝ, ℝ), Integrable (fun x => h x ^ 2) volume :=
