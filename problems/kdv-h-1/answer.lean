theorem riccatiK_sub_congr (κ : ℝ) (hκ : 0 < κ) :
    (∀ f g : ℝ → ℝ, Integrable f (volume : Measure ℝ) → Integrable g (volume : Measure ℝ) →
      ∀ x : ℝ, riccatiK κ (fun y => f y - g y) x = riccatiK κ f x - riccatiK κ g x) ∧
    (∀ f g : ℝ → ℝ, f =ᵐ[(volume : Measure ℝ)] g → ∀ x : ℝ, riccatiK κ f x = riccatiK κ g x) :=
by
  have hint : ∀ h : ℝ → ℝ, Integrable h (volume : Measure ℝ) → ∀ x : ℝ,
      Integrable (fun y => Real.exp (2 * κ * (x - y)) * h y)
        ((volume : Measure ℝ).restrict (Set.Ici x)) := by
    intro h hh x
    have hcont : Continuous fun y : ℝ => Real.exp (2 * κ * (x - y)) := by fun_prop
    refine Integrable.bdd_mul (c := 1) hh.restrict hcont.aestronglyMeasurable ?_
    filter_upwards [ae_restrict_mem measurableSet_Ici] with y hy
    have hxy : x ≤ y := hy
    have h1 : 2 * κ * (x - y) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (by linarith) (by linarith)
    rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
    exact Real.exp_le_one_iff.2 h1
  refine ⟨fun f g hf hg x => ?_, fun f g hfg x => ?_⟩
  · unfold riccatiK
    have e : (fun y => Real.exp (2 * κ * (x - y)) * (f y - g y)) =
        fun y => Real.exp (2 * κ * (x - y)) * f y - Real.exp (2 * κ * (x - y)) * g y := by
      funext y; ring
    rw [e, integral_sub (hint f hf x) (hint g hg x)]
    ring
  · unfold riccatiK
    congr 1
    refine integral_congr_ae ?_
    filter_upwards [ae_restrict_of_ae hfg] with y hy
    rw [hy]

theorem riccatiK_mul_bound (κ : ℝ) (hκ : 1 ≤ κ) (g h : ℝ → ℝ)
    (hg : MemLp g 2 (volume : Measure ℝ)) (hh : MemLp h 2 (volume : Measure ℝ)) :
    MemLp (riccatiK κ (fun y => g y * h y)) 2 (volume : Measure ℝ) ∧
    ∫ x : ℝ, riccatiK κ (fun y => g y * h y) x ^ 2 ≤
      1 / 4 * ((∫ y : ℝ, g y ^ 2) * (∫ y : ℝ, h y ^ 2)) :=
by
  have hκ0 : (0 : ℝ) < κ := by linarith
  
  have CS : ∀ (μ : Measure ℝ) (u v : ℝ → ℝ), MemLp u 2 μ → MemLp v 2 μ →
      (∫ a, u a * v a ∂μ) ^ 2 ≤ (∫ a, u a ^ 2 ∂μ) * (∫ a, v a ^ 2 ∂μ) := by
    intro μ u v hu hv
    have hA := hu.integrable_sq
    have hB := hv.integrable_sq
    have hC : Integrable (fun a => u a * v a) μ := hu.integrable_mul hv
    have key : ∀ t : ℝ, 0 ≤ (∫ a, u a ^ 2 ∂μ) * (t * t) + (2 * ∫ a, u a * v a ∂μ) * t +
        ∫ a, v a ^ 2 ∂μ := by
      intro t
      have h0 : 0 ≤ ∫ a, (t * u a + v a) ^ 2 ∂μ := integral_nonneg (fun a => sq_nonneg _)
      have heq : (fun a => (t * u a + v a) ^ 2) =
          fun a => (t * t) * u a ^ 2 + ((2 * t) * (u a * v a) + v a ^ 2) := by
        funext a; ring
      have i1 : Integrable (fun a => (t * t) * u a ^ 2) μ := hA.const_mul _
      have i2 : Integrable (fun a => (2 * t) * (u a * v a)) μ := hC.const_mul _
      have i23 : Integrable (fun a => (2 * t) * (u a * v a) + v a ^ 2) μ := i2.add hB
      rw [heq, integral_add i1 i23, integral_add i2 hB, integral_const_mul,
        integral_const_mul] at h0
      nlinarith
    have hd := discrim_le_zero key
    unfold discrim at hd
    nlinarith
  
  have hS : MeasurableSet {p : ℝ × ℝ | p.1 ≤ p.2} := measurableSet_le measurable_fst measurable_snd
  have hident : ∀ (c : ℝ) (φ : ℝ → ℝ) (x : ℝ),
      ∫ y in Set.Ici x, Real.exp (c * (x - y)) * φ y =
        ∫ y, ({p : ℝ × ℝ | p.1 ≤ p.2}.indicator
          (fun p => Real.exp (c * (p.1 - p.2)) * φ p.2)) (x, y) := by
    intro c φ x
    rw [← integral_indicator measurableSet_Ici]
    congr 1
  have hFmeas : ∀ (c : ℝ) (φ : ℝ → ℝ), AEStronglyMeasurable φ volume →
      AEStronglyMeasurable ({p : ℝ × ℝ | p.1 ≤ p.2}.indicator
        (fun p => Real.exp (c * (p.1 - p.2)) * φ p.2)) ((volume : Measure ℝ).prod volume) := by
    intro c φ hφ
    refine AEStronglyMeasurable.indicator ?_ hS
    have h1 : Continuous fun p : ℝ × ℝ => Real.exp (c * (p.1 - p.2)) := by fun_prop
    exact h1.aestronglyMeasurable.mul hφ.comp_snd
  
  have hmeas : AEStronglyMeasurable (riccatiK κ (fun y => g y * h y)) volume := by
    have h1 := (hFmeas (2 * κ) (fun y => g y * h y) (hg.1.mul hh.1)).integral_prod_right'
    have h2 : riccatiK κ (fun y => g y * h y) = fun x => -∫ y, ({p : ℝ × ℝ | p.1 ≤ p.2}.indicator
          (fun p => Real.exp (2 * κ * (p.1 - p.2)) * (g p.2 * h p.2))) (x, y) := by
      funext x
      unfold riccatiK
      rw [hident (2 * κ) (fun y => g y * h y) x]
    rw [h2]
    exact h1.neg
  
  have hpt : ∀ x, riccatiK κ (fun y => g y * h y) x ^ 2 ≤
      (∫ y, g y ^ 2) * ∫ y in Set.Ici x, Real.exp (4 * κ * (x - y)) * h y ^ 2 := by
    intro x
    have hv : MemLp (fun y => Real.exp (2 * κ * (x - y)) * h y) 2
        ((volume : Measure ℝ).restrict (Set.Ici x)) := by
      refine MemLp.of_le (hh.restrict _) ?_ ?_
      · have hc : Continuous fun y : ℝ => Real.exp (2 * κ * (x - y)) := by fun_prop
        exact hc.aestronglyMeasurable.mul hh.1.restrict
      · refine ae_restrict_of_forall_mem measurableSet_Ici (fun y hy => ?_)
        have hy' : x ≤ y := hy
        have hle : Real.exp (2 * κ * (x - y)) ≤ 1 := Real.exp_le_one_iff.2 (by nlinarith)
        rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_of_pos (Real.exp_pos _)]
        exact mul_le_of_le_one_left (abs_nonneg _) hle
    have hcs := CS _ g (fun y => Real.exp (2 * κ * (x - y)) * h y) (hg.restrict _) hv
    have e1 : riccatiK κ (fun y => g y * h y) x ^ 2 =
        (∫ y in Set.Ici x, g y * (Real.exp (2 * κ * (x - y)) * h y)) ^ 2 := by
      have hfun : (fun y => Real.exp (2 * κ * (x - y)) * (g y * h y)) =
          fun y => g y * (Real.exp (2 * κ * (x - y)) * h y) := by
        funext y; ring
      show (-∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * (g y * h y)) ^ 2 = _
      rw [neg_sq, hfun]
    have e2 : ∫ y in Set.Ici x, (Real.exp (2 * κ * (x - y)) * h y) ^ 2 =
        ∫ y in Set.Ici x, Real.exp (4 * κ * (x - y)) * h y ^ 2 := by
      congr 1
      funext y
      have hexp : 2 * κ * (x - y) + 2 * κ * (x - y) = 4 * κ * (x - y) := by ring
      rw [mul_pow, sq (Real.exp _), ← Real.exp_add, hexp]
    have e3 : ∫ y in Set.Ici x, g y ^ 2 ≤ ∫ y, g y ^ 2 :=
      setIntegral_le_integral hg.integrable_sq (Filter.Eventually.of_forall fun y => sq_nonneg (g y))
    have e4 : 0 ≤ ∫ y in Set.Ici x, Real.exp (4 * κ * (x - y)) * h y ^ 2 :=
      integral_nonneg (fun y => mul_nonneg (Real.exp_pos _).le (sq_nonneg _))
    rw [e1]
    rw [e2] at hcs
    exact le_trans hcs (mul_le_mul_of_nonneg_right e3 e4)
  
  have h4κ : (0 : ℝ) < 4 * κ := by linarith
  obtain ⟨F, hF⟩ : ∃ F : ℝ × ℝ → ℝ, F = {p : ℝ × ℝ | p.1 ≤ p.2}.indicator
      (fun p => Real.exp (4 * κ * (p.1 - p.2)) * h p.2 ^ 2) := ⟨_, rfl⟩
  have hFnn : ∀ p, 0 ≤ F p := by
    intro p
    rw [hF]
    exact Set.indicator_nonneg (fun p _ => mul_nonneg (Real.exp_pos _).le (sq_nonneg _)) p
  have hFm : AEStronglyMeasurable F ((volume : Measure ℝ).prod volume) := by
    rw [hF]
    exact hFmeas (4 * κ) (fun y => h y ^ 2) (hh.1.pow 2)
  have hslice_pt : ∀ x y : ℝ, F (x, y) = (Set.Iic y).indicator
      (fun x => Real.exp (4 * κ * x) * (Real.exp (-(4 * κ * y)) * h y ^ 2)) x := by
    intro x y
    rw [hF]
    by_cases hxy : x ≤ y
    · have h1 : (x, y) ∈ {p : ℝ × ℝ | p.1 ≤ p.2} := hxy
      have h2 : x ∈ Set.Iic y := hxy
      rw [Set.indicator_of_mem h1, Set.indicator_of_mem h2]
      show Real.exp (4 * κ * (x - y)) * h y ^ 2 =
        Real.exp (4 * κ * x) * (Real.exp (-(4 * κ * y)) * h y ^ 2)
      rw [← mul_assoc, ← Real.exp_add]
      congr 2
      ring
    · have h1 : (x, y) ∉ {p : ℝ × ℝ | p.1 ≤ p.2} := hxy
      have h2 : x ∉ Set.Iic y := hxy
      rw [Set.indicator_of_notMem h1, Set.indicator_of_notMem h2]
  have hslice_int : ∀ y : ℝ, Integrable (fun x => F (x, y)) volume := by
    intro y
    have he : (fun x => F (x, y)) = (Set.Iic y).indicator
        (fun x => Real.exp (4 * κ * x) * (Real.exp (-(4 * κ * y)) * h y ^ 2)) :=
      funext fun x => hslice_pt x y
    rw [he]
    have hon : IntegrableOn
        (fun x => Real.exp (4 * κ * x) * (Real.exp (-(4 * κ * y)) * h y ^ 2)) (Set.Iic y) :=
      Integrable.mul_const (integrableOn_exp_mul_Iic h4κ y) _
    exact hon.integrable_indicator measurableSet_Iic
  have hslice_val : ∀ y : ℝ, ∫ x, F (x, y) = 1 / (4 * κ) * h y ^ 2 := by
    intro y
    have he : (fun x => F (x, y)) = (Set.Iic y).indicator
        (fun x => Real.exp (4 * κ * x) * (Real.exp (-(4 * κ * y)) * h y ^ 2)) :=
      funext fun x => hslice_pt x y
    rw [he, integral_indicator measurableSet_Iic, integral_mul_const, integral_exp_mul_Iic h4κ y,
      Real.exp_neg]
    field_simp
  have hFint : Integrable F ((volume : Measure ℝ).prod volume) := by
    rw [integrable_prod_iff' hFm]
    refine ⟨Filter.Eventually.of_forall hslice_int, ?_⟩
    have he : (fun y => ∫ x, ‖F (x, y)‖) = fun y => 1 / (4 * κ) * h y ^ 2 := by
      funext y
      have hn : (fun x => ‖F (x, y)‖) = fun x => F (x, y) :=
        funext fun x => Real.norm_of_nonneg (hFnn _)
      rw [hn, hslice_val]
    rw [he]
    exact hh.integrable_sq.const_mul _
  have hHeq : (fun x => ∫ y in Set.Ici x, Real.exp (4 * κ * (x - y)) * h y ^ 2) =
      fun x => ∫ y, F (x, y) := by
    funext x
    rw [hident (4 * κ) (fun y => h y ^ 2) x, hF]
  have hHint : Integrable (fun x => ∫ y in Set.Ici x, Real.exp (4 * κ * (x - y)) * h y ^ 2)
      volume := by
    rw [hHeq]
    exact hFint.integral_prod_left
  have hHval : ∫ x, (∫ y in Set.Ici x, Real.exp (4 * κ * (x - y)) * h y ^ 2) =
      1 / (4 * κ) * ∫ y, h y ^ 2 := by
    rw [hHeq, ← integral_prod F hFint, integral_prod_symm F hFint]
    simp_rw [hslice_val]
    rw [integral_const_mul]
  
  have hG : 0 ≤ ∫ y, g y ^ 2 := integral_nonneg (fun y => sq_nonneg _)
  have hHh : 0 ≤ ∫ y, h y ^ 2 := integral_nonneg (fun y => sq_nonneg _)
  have hint : Integrable (fun x => riccatiK κ (fun y => g y * h y) x ^ 2) volume := by
    refine (hHint.const_mul (∫ y, g y ^ 2)).mono'
      ((continuous_pow 2).comp_aestronglyMeasurable hmeas) (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    exact hpt x
  refine ⟨(memLp_two_iff_integrable_sq hmeas).2 hint, ?_⟩
  have hmono := integral_mono hint (hHint.const_mul (∫ y, g y ^ 2)) hpt
  rw [integral_const_mul, hHval] at hmono
  have hk : 1 / (4 * κ) ≤ 1 / 4 := by
    rw [div_le_div_iff₀ h4κ (by norm_num)]
    linarith
  have := mul_le_mul_of_nonneg_right hk (mul_nonneg hG hHh)
  nlinarith

theorem riccati_exists_small (κ : ℝ) (hκ : 1 ≤ κ) (a : ℝ → ℝ)
    (ha : MemLp a 2 (volume : Measure ℝ)) (hsmall : ∫ x : ℝ, a x ^ 2 ≤ 1 / 64) :
    ∃ w : ℝ → ℝ, MemLp w 2 (volume : Measure ℝ) ∧ (∫ x : ℝ, w x ^ 2) ≤ 1 / 16 ∧
      ∀ x : ℝ, w x = a x - riccatiK κ (fun y => w y ^ 2) x :=
by
  have hκ0 : (0 : ℝ) < κ := by linarith
  obtain ⟨hsub, hcongr⟩ := riccatiK_sub_congr κ hκ0
  
  have normsq : ∀ F : Lp ℝ 2 (volume : Measure ℝ), ‖F‖ ^ 2 = ∫ x : ℝ, (F : ℝ → ℝ) x ^ 2 := by
    intro F
    rw [← real_inner_self_eq_norm_sq, MeasureTheory.L2.inner_def]
    congr 1
    funext x
    rw [real_inner_self_eq_norm_sq, Real.norm_eq_abs, sq_abs]
  have normsq_toLp : ∀ (f : ℝ → ℝ) (hf : MemLp f 2 (volume : Measure ℝ)),
      ‖hf.toLp f‖ ^ 2 = ∫ x : ℝ, f x ^ 2 := by
    intro f hf
    rw [normsq]
    apply integral_congr_ae
    filter_upwards [hf.coeFn_toLp] with x hx
    rw [hx]
  have dist_toLp : ∀ (f g : ℝ → ℝ) (hf : MemLp f 2 (volume : Measure ℝ))
      (hg : MemLp g 2 (volume : Measure ℝ)),
      ‖hf.toLp f - hg.toLp g‖ ^ 2 = ∫ x : ℝ, (f x - g x) ^ 2 := by
    intro f g hf hg
    rw [← MemLp.toLp_sub hf hg, normsq_toLp _ (hf.sub hg)]
    rfl
  have sq_le_of : ∀ n m : ℝ, 0 ≤ n → 0 ≤ m → n ^ 2 ≤ m ^ 2 → n ≤ m := by
    intro n m hn hm h
    nlinarith
  
  have hK : ∀ W : Lp ℝ 2 (volume : Measure ℝ),
      MemLp (riccatiK κ (fun y => (W : ℝ → ℝ) y ^ 2)) 2 (volume : Measure ℝ) ∧
      (∫ x : ℝ, riccatiK κ (fun y => (W : ℝ → ℝ) y ^ 2) x ^ 2) ≤ 1 / 4 * (‖W‖ ^ 2 * ‖W‖ ^ 2) := by
    intro W
    have e : (fun y => (W : ℝ → ℝ) y ^ 2) = (fun y => (W : ℝ → ℝ) y * (W : ℝ → ℝ) y) :=
      funext fun y => sq _
    have hb := riccatiK_mul_bound κ hκ _ _ (Lp.memLp W) (Lp.memLp W)
    rw [← e, ← normsq W] at hb
    exact hb
  have hKdiff : ∀ W V : Lp ℝ 2 (volume : Measure ℝ),
      (∫ x : ℝ, (riccatiK κ (fun y => (W : ℝ → ℝ) y ^ 2) x -
          riccatiK κ (fun y => (V : ℝ → ℝ) y ^ 2) x) ^ 2) ≤
        1 / 4 * (‖W - V‖ ^ 2 * ‖W + V‖ ^ 2) := by
    intro W V
    have hW := Lp.memLp W
    have hV := Lp.memLp V
    have hpt : ∀ x, riccatiK κ (fun y => (W : ℝ → ℝ) y ^ 2) x -
        riccatiK κ (fun y => (V : ℝ → ℝ) y ^ 2) x =
        riccatiK κ (fun y => ((W : ℝ → ℝ) y - (V : ℝ → ℝ) y) *
          ((W : ℝ → ℝ) y + (V : ℝ → ℝ) y)) x := by
      intro x
      rw [← hsub _ _ hW.integrable_sq hV.integrable_sq x]
      congr 1
      funext y
      ring
    have hb := riccatiK_mul_bound κ hκ (fun y => (W : ℝ → ℝ) y - (V : ℝ → ℝ) y)
      (fun y => (W : ℝ → ℝ) y + (V : ℝ → ℝ) y) (hW.sub hV) (hW.add hV)
    have e1 : (∫ y : ℝ, ((W : ℝ → ℝ) y - (V : ℝ → ℝ) y) ^ 2) = ‖W - V‖ ^ 2 := by
      rw [normsq]
      apply integral_congr_ae
      filter_upwards [Lp.coeFn_sub W V] with y hy
      rw [hy, Pi.sub_apply]
    have e2 : (∫ y : ℝ, ((W : ℝ → ℝ) y + (V : ℝ → ℝ) y) ^ 2) = ‖W + V‖ ^ 2 := by
      rw [normsq]
      apply integral_congr_ae
      filter_upwards [Lp.coeFn_add W V] with y hy
      rw [hy, Pi.add_apply]
    rw [e1, e2] at hb
    have e3 : (fun x => (riccatiK κ (fun y => (W : ℝ → ℝ) y ^ 2) x -
          riccatiK κ (fun y => (V : ℝ → ℝ) y ^ 2) x) ^ 2) =
        (fun x => riccatiK κ (fun y => ((W : ℝ → ℝ) y - (V : ℝ → ℝ) y) *
          ((W : ℝ → ℝ) y + (V : ℝ → ℝ) y)) x ^ 2) := by
      funext x
      rw [hpt x]
    rw [e3]
    exact hb.2
  
  obtain ⟨T, hT⟩ : ∃ T : Lp ℝ 2 (volume : Measure ℝ) → Lp ℝ 2 (volume : Measure ℝ),
      ∀ W, T W = ha.toLp a - (hK W).1.toLp (riccatiK κ (fun y => (W : ℝ → ℝ) y ^ 2)) :=
    ⟨_, fun W => rfl⟩
  have ha_norm : ‖ha.toLp a‖ ≤ 1 / 8 := by
    have h1 := normsq_toLp a ha
    exact sq_le_of _ _ (norm_nonneg _) (by norm_num) (by rw [h1]; linarith)
  have hmaps : ∀ W : Lp ℝ 2 (volume : Measure ℝ), ‖W‖ ≤ 1 / 4 → ‖T W‖ ≤ 1 / 4 := by
    intro W hW
    have hW2 : ‖W‖ ^ 2 ≤ 1 / 16 := by nlinarith [norm_nonneg W]
    have hW4 : ‖W‖ ^ 2 * ‖W‖ ^ 2 ≤ 1 / 256 := by nlinarith [sq_nonneg ‖W‖]
    have hk := normsq_toLp _ (hK W).1
    have hk2 := (hK W).2
    have hkn : ‖(hK W).1.toLp (riccatiK κ (fun y => (W : ℝ → ℝ) y ^ 2))‖ ≤ 1 / 32 :=
      sq_le_of _ _ (norm_nonneg _) (by norm_num) (by rw [hk]; linarith)
    rw [hT W]
    have := norm_sub_le (ha.toLp a) ((hK W).1.toLp (riccatiK κ (fun y => (W : ℝ → ℝ) y ^ 2)))
    linarith
  have hlip : ∀ W V : Lp ℝ 2 (volume : Measure ℝ), ‖W‖ ≤ 1 / 4 → ‖V‖ ≤ 1 / 4 →
      ‖T W - T V‖ ≤ 1 / 4 * ‖W - V‖ := by
    intro W V hW hV
    rw [hT W, hT V, sub_sub_sub_cancel_left]
    have h1 := dist_toLp _ _ (hK V).1 (hK W).1
    have h2 := hKdiff V W
    have h3 : ‖V + W‖ ≤ 1 / 2 := by
      have := norm_add_le V W
      linarith
    have h4 : ‖V + W‖ ^ 2 ≤ 1 / 4 := by nlinarith [norm_nonneg (V + W)]
    have h5 : ‖V - W‖ = ‖W - V‖ := norm_sub_rev V W
    rw [h5] at h2
    refine sq_le_of _ _ (norm_nonneg _) (by positivity) ?_
    rw [h1]
    have h6 : ‖W - V‖ ^ 2 * ‖V + W‖ ^ 2 ≤ ‖W - V‖ ^ 2 * (1 / 4) :=
      mul_le_mul_of_nonneg_left h4 (sq_nonneg _)
    nlinarith
  
  have fixpt : ∃ W : Lp ℝ 2 (volume : Measure ℝ), ‖W‖ ≤ 1 / 4 ∧ T W = W := by
    have hsc : IsComplete (Metric.closedBall (0 : Lp ℝ 2 (volume : Measure ℝ)) (1 / 4)) :=
      Metric.isClosed_closedBall.isComplete
    have hsf : Set.MapsTo T (Metric.closedBall (0 : Lp ℝ 2 (volume : Measure ℝ)) (1 / 4))
        (Metric.closedBall (0 : Lp ℝ 2 (volume : Measure ℝ)) (1 / 4)) := by
      intro W hW
      rw [Metric.mem_closedBall, dist_zero_right] at hW ⊢
      exact hmaps W hW
    have hC : ContractingWith (1 / 4 : NNReal) (hsf.restrict T _ _) := by
      refine ⟨by rw [← NNReal.coe_lt_coe]; norm_num, LipschitzWith.of_dist_le_mul fun x y => ?_⟩
      have hx : ‖(x : Lp ℝ 2 (volume : Measure ℝ))‖ ≤ 1 / 4 := by
        have := x.2
        rwa [Metric.mem_closedBall, dist_zero_right] at this
      have hy : ‖(y : Lp ℝ 2 (volume : Measure ℝ))‖ ≤ 1 / 4 := by
        have := y.2
        rwa [Metric.mem_closedBall, dist_zero_right] at this
      rw [Subtype.dist_eq, Subtype.dist_eq, Set.MapsTo.val_restrict_apply,
        Set.MapsTo.val_restrict_apply, dist_eq_norm, dist_eq_norm]
      have := hlip _ _ hx hy
      have e : ((1 / 4 : NNReal) : ℝ) = 1 / 4 := by norm_num
      rw [e]
      exact this
    obtain ⟨y, hy, hfix, -⟩ := ContractingWith.exists_fixedPoint' hsc hsf hC
      (x := 0) (by rw [Metric.mem_closedBall, dist_self]; norm_num) (edist_ne_top _ _)
    refine ⟨y, ?_, hfix⟩
    rwa [Metric.mem_closedBall, dist_zero_right] at hy
  
  obtain ⟨W, hWb, hfix⟩ := fixpt
  obtain ⟨w, hw⟩ : ∃ w : ℝ → ℝ,
      w = fun x => a x - riccatiK κ (fun y => (W : ℝ → ℝ) y ^ 2) x := ⟨_, rfl⟩
  have hwm : MemLp w 2 (volume : Measure ℝ) := by
    rw [hw]
    exact ha.sub (hK W).1
  have hae : w =ᵐ[volume] (W : ℝ → ℝ) := by
    have e := Lp.coeFn_sub (ha.toLp a)
      ((hK W).1.toLp (riccatiK κ (fun y => (W : ℝ → ℝ) y ^ 2)))
    have hW' : ha.toLp a - (hK W).1.toLp (riccatiK κ (fun y => (W : ℝ → ℝ) y ^ 2)) = W :=
      (hT W).symm.trans hfix
    rw [hW'] at e
    filter_upwards [e, ha.coeFn_toLp, (hK W).1.coeFn_toLp] with x h1 h2 h3
    rw [h1, Pi.sub_apply, h2, h3, hw]
  have hsq : (fun y => w y ^ 2) =ᵐ[volume] (fun y => (W : ℝ → ℝ) y ^ 2) := by
    filter_upwards [hae] with y hy
    rw [hy]
  refine ⟨w, hwm, ?_, ?_⟩
  · have e : (∫ x : ℝ, w x ^ 2) = ∫ x : ℝ, (W : ℝ → ℝ) x ^ 2 := integral_congr_ae hsq
    rw [e, ← normsq W]
    nlinarith [norm_nonneg W]
  · intro x
    rw [hcongr _ _ hsq x, hw]

theorem riccati_fixed_point (κ : ℝ) (hκ : 1 ≤ κ) (q : 𝓢(ℝ, ℝ))
    (hmem : MemLp (riccatiK κ q) 2 (volume : Measure ℝ))
    (hsmall : ∫ x : ℝ, riccatiK κ q x ^ 2 ≤ 1 / 64) :
    (∃ w : ℝ → ℝ, IsRiccatiSol κ q w) ∧
    (∀ w v : ℝ → ℝ, IsRiccatiSol κ q w → IsRiccatiSol κ q v → w = v) ∧
    (∀ w : ℝ → ℝ, IsRiccatiSol κ q w → riccatiAlpha κ q = ∫ x : ℝ, w x ^ 2) ∧
    49 / 64 * riccatiAlpha κ q ≤ ∫ x : ℝ, riccatiK κ q x ^ 2 ∧
    ∫ x : ℝ, riccatiK κ q x ^ 2 ≤ 81 / 64 * riccatiAlpha κ q :=
by
  have hκ0 : (0 : ℝ) < κ := by linarith
  obtain ⟨hsub, hcongr⟩ := riccatiK_sub_congr κ hκ0
  
  have huniq : ∀ w v : ℝ → ℝ, IsRiccatiSol κ q w → IsRiccatiSol κ q v → w = v := by
    intro w v hw hv
    obtain ⟨hwm, hw2, hwe⟩ := hw
    obtain ⟨hvm, hv2, hve⟩ := hv
    have hdiff : ∀ x, w x - v x = riccatiK κ (fun y => (v y - w y) * (v y + w y)) x := by
      intro x
      have h1 := hsub (fun y => v y ^ 2) (fun y => w y ^ 2) hvm.integrable_sq
        hwm.integrable_sq x
      beta_reduce at h1
      have h2 : (fun y => (v y - w y) * (v y + w y)) = (fun y => v y ^ 2 - w y ^ 2) := by
        funext y; ring
      rw [h2, h1]
      linarith [hwe x, hve x]
    obtain ⟨-, hK⟩ := riccatiK_mul_bound κ hκ (fun y => v y - w y) (fun y => v y + w y)
      (hvm.sub hwm) (hvm.add hwm)
    have hE : ∫ x, riccatiK κ (fun y => (v y - w y) * (v y + w y)) x ^ 2 =
        ∫ x, (w x - v x) ^ 2 := by
      congr 1; funext x; rw [hdiff x]
    have hg2 : ∫ y, (v y - w y) ^ 2 = ∫ x, (w x - v x) ^ 2 := by
      congr 1; funext y; ring
    have hH : ∫ y, (v y + w y) ^ 2 ≤ 1 / 4 := by
      have hint1 : Integrable (fun y => (v y + w y) ^ 2) volume := (hvm.add hwm).integrable_sq
      have hint2 : Integrable (fun y => 2 * v y ^ 2 + 2 * w y ^ 2) volume :=
        (hvm.integrable_sq.const_mul 2).add (hwm.integrable_sq.const_mul 2)
      have hmono : ∫ y, (v y + w y) ^ 2 ≤ ∫ y, (2 * v y ^ 2 + 2 * w y ^ 2) :=
        integral_mono hint1 hint2 (fun y => by
          show (v y + w y) ^ 2 ≤ 2 * v y ^ 2 + 2 * w y ^ 2
          nlinarith [sq_nonneg (v y - w y)])
      rw [integral_add (hvm.integrable_sq.const_mul 2) (hwm.integrable_sq.const_mul 2),
        integral_const_mul, integral_const_mul] at hmono
      linarith
    rw [hE, hg2] at hK
    have hE0nn : 0 ≤ ∫ x, (w x - v x) ^ 2 := integral_nonneg (fun x => sq_nonneg _)
    have hHnn : 0 ≤ ∫ y, (v y + w y) ^ 2 := integral_nonneg (fun x => sq_nonneg _)
    have hE0le : ∫ x, (w x - v x) ^ 2 ≤ 0 := by
      nlinarith [mul_nonneg hE0nn (sub_nonneg.2 hH)]
    have hE0z : ∫ x, (w x - v x) ^ 2 = 0 := le_antisymm hE0le hE0nn
    have hnn : (0 : ℝ → ℝ) ≤ fun x => (w x - v x) ^ 2 := fun x => sq_nonneg _
    have hae := (integral_eq_zero_iff_of_nonneg hnn (hwm.sub hvm).integrable_sq).1 hE0z
    have hwv : w =ᵐ[volume] v := by
      filter_upwards [hae] with x hx
      have h3 : (w x - v x) ^ 2 = 0 := hx
      exact sub_eq_zero.1 (pow_eq_zero_iff two_ne_zero |>.1 h3)
    have hsq : (fun y => w y ^ 2) =ᵐ[volume] (fun y => v y ^ 2) := by
      filter_upwards [hwv] with y hy
      rw [hy]
    funext x
    linarith [hwe x, hve x, hcongr _ _ hsq x]
  
  obtain ⟨w, hwm, hw2, hwe⟩ := riccati_exists_small κ hκ (riccatiK κ q) hmem hsmall
  have hw0 : IsRiccatiSol κ q w := ⟨hwm, hw2, hwe⟩
  
  have halpha : ∀ w : ℝ → ℝ, IsRiccatiSol κ q w → riccatiAlpha κ q = ∫ x : ℝ, w x ^ 2 := by
    intro w hw
    have h : ∃ w : ℝ → ℝ, IsRiccatiSol κ q w := ⟨w, hw⟩
    unfold riccatiAlpha
    rw [dif_pos h, huniq _ _ (Classical.choose_spec h) hw]
  
  have hsqf : (fun y => w y ^ 2) = (fun y => w y * w y) := by funext y; ring
  have hbounds : 49 / 64 * (∫ x : ℝ, w x ^ 2) ≤ ∫ x : ℝ, riccatiK κ q x ^ 2 ∧
      ∫ x : ℝ, riccatiK κ q x ^ 2 ≤ 81 / 64 * ∫ x : ℝ, w x ^ 2 := by
    obtain ⟨hd, hd2⟩ := riccatiK_mul_bound κ hκ w w hwm hwm
    have hsum : ∀ x, riccatiK κ q x = w x + riccatiK κ (fun y => w y * w y) x := by
      intro x
      have h1 := hwe x
      rw [hsqf] at h1
      linarith
    generalize riccatiK κ (fun y => w y * w y) = d at hd hd2 hsum
    generalize riccatiK κ q = a at hmem hsum ⊢
    have hia := hmem.integrable_sq
    have hiw := hwm.integrable_sq
    have hid := hd.integrable_sq
    have hαnn : 0 ≤ ∫ x, w x ^ 2 := integral_nonneg (fun x => sq_nonneg _)
    have hDle : ∫ x, d x ^ 2 ≤ 1 / 64 * ∫ x, w x ^ 2 := by
      nlinarith [mul_le_mul_of_nonneg_left hw2 hαnn]
    have hlow : ∫ x, (7 / 8 * w x ^ 2 - 7 * d x ^ 2) ≤ ∫ x, a x ^ 2 :=
      integral_mono ((hiw.const_mul (7 / 8)).sub (hid.const_mul 7)) hia (fun x => by
        show 7 / 8 * w x ^ 2 - 7 * d x ^ 2 ≤ a x ^ 2
        rw [hsum x]
        nlinarith [sq_nonneg (w x + 8 * d x)])
    have hhigh : ∫ x, a x ^ 2 ≤ ∫ x, (9 / 8 * w x ^ 2 + 9 * d x ^ 2) :=
      integral_mono hia ((hiw.const_mul (9 / 8)).add (hid.const_mul 9)) (fun x => by
        show a x ^ 2 ≤ 9 / 8 * w x ^ 2 + 9 * d x ^ 2
        rw [hsum x]
        nlinarith [sq_nonneg (w x - 8 * d x)])
    rw [integral_sub (hiw.const_mul (7 / 8)) (hid.const_mul 7), integral_const_mul,
      integral_const_mul] at hlow
    rw [integral_add (hiw.const_mul (9 / 8)) (hid.const_mul 9), integral_const_mul,
      integral_const_mul] at hhigh
    constructor <;> linarith
  refine ⟨⟨w, hw0⟩, huniq, halpha, ?_, ?_⟩
  · rw [halpha w hw0]; exact hbounds.1
  · rw [halpha w hw0]; exact hbounds.2

theorem riccatiK_sqrt_bounds (κ : ℝ) (hκ : 1 ≤ κ) :
    (∀ f : ℝ → ℝ, MemLp f 2 (volume : Measure ℝ) →
      MemLp (riccatiK κ f) 2 (volume : Measure ℝ) ∧
      Real.sqrt (∫ x : ℝ, riccatiK κ f x ^ 2) ≤ 1 / 2 * Real.sqrt (∫ x : ℝ, f x ^ 2)) ∧
    (∀ f g : ℝ → ℝ, MemLp f 2 (volume : Measure ℝ) → MemLp g 2 (volume : Measure ℝ) →
      MemLp (riccatiK κ (fun y => f y * g y)) 2 (volume : Measure ℝ) ∧
      Real.sqrt (∫ x : ℝ, riccatiK κ (fun y => f y * g y) x ^ 2) ≤
        1 / 2 * (Real.sqrt (∫ x : ℝ, f x ^ 2) * Real.sqrt (∫ x : ℝ, g x ^ 2))) :=
by
  have hκ0 : (0 : ℝ) < κ := by linarith
  have h2κ : (0 : ℝ) < 2 * κ := by linarith
  
  have CS : ∀ (μ : Measure ℝ) (u v : ℝ → ℝ), MemLp u 2 μ → MemLp v 2 μ →
      (∫ a, u a * v a ∂μ) ^ 2 ≤ (∫ a, u a ^ 2 ∂μ) * (∫ a, v a ^ 2 ∂μ) := by
    intro μ u v hu hv
    have hA := hu.integrable_sq
    have hB := hv.integrable_sq
    have hC : Integrable (fun a => u a * v a) μ := hu.integrable_mul hv
    have key : ∀ t : ℝ, 0 ≤ (∫ a, u a ^ 2 ∂μ) * (t * t) + (2 * ∫ a, u a * v a ∂μ) * t +
        ∫ a, v a ^ 2 ∂μ := by
      intro t
      have h0 : 0 ≤ ∫ a, (t * u a + v a) ^ 2 ∂μ := integral_nonneg (fun a => sq_nonneg _)
      have heq : (fun a => (t * u a + v a) ^ 2) =
          fun a => (t * t) * u a ^ 2 + ((2 * t) * (u a * v a) + v a ^ 2) := by
        funext a; ring
      have i0 : Integrable (fun a => t * t * u a ^ 2) μ := hA.const_mul (t * t)
      have i2 : Integrable (fun a => 2 * t * (u a * v a)) μ := hC.const_mul (2 * t)
      have i1 : Integrable (fun a => 2 * t * (u a * v a) + v a ^ 2) μ := i2.add hB
      rw [heq, integral_add i0 i1, integral_add i2 hB, integral_const_mul,
        integral_const_mul] at h0
      nlinarith
    have hd := discrim_le_zero key
    unfold discrim at hd
    nlinarith
  
  have hS : MeasurableSet {p : ℝ × ℝ | p.1 ≤ p.2} :=
    measurableSet_le measurable_fst measurable_snd
  have hident : ∀ (c : ℝ) (φ : ℝ → ℝ) (x : ℝ),
      ∫ y in Set.Ici x, Real.exp (c * (x - y)) * φ y =
        ∫ y, ({p : ℝ × ℝ | p.1 ≤ p.2}.indicator
          (fun p => Real.exp (c * (p.1 - p.2)) * φ p.2)) (x, y) := by
    intro c φ x
    rw [← integral_indicator measurableSet_Ici]
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    by_cases hxy : x ≤ y
    · have h1 : (x, y) ∈ {p : ℝ × ℝ | p.1 ≤ p.2} := hxy
      have h2 : y ∈ Set.Ici x := hxy
      simp only [Set.indicator_of_mem h1, Set.indicator_of_mem h2]
    · have h1 : (x, y) ∉ {p : ℝ × ℝ | p.1 ≤ p.2} := hxy
      have h2 : y ∉ Set.Ici x := hxy
      simp only [Set.indicator_of_notMem h1, Set.indicator_of_notMem h2]
  have hFmeas : ∀ (c : ℝ) (φ : ℝ → ℝ), AEStronglyMeasurable φ volume →
      AEStronglyMeasurable ({p : ℝ × ℝ | p.1 ≤ p.2}.indicator
        (fun p => Real.exp (c * (p.1 - p.2)) * φ p.2)) ((volume : Measure ℝ).prod volume) := by
    intro c φ hφ
    refine AEStronglyMeasurable.indicator ?_ hS
    have h1 : Continuous fun p : ℝ × ℝ => Real.exp (c * (p.1 - p.2)) := by fun_prop
    exact h1.aestronglyMeasurable.mul hφ.comp_snd
  refine ⟨fun f hf => ?_, fun f g hf hg => ?_⟩
  · 
    have hmeas : AEStronglyMeasurable (riccatiK κ f) volume := by
      have h1 := (hFmeas (2 * κ) f hf.1).integral_prod_right'
      have h2 : riccatiK κ f = fun x => -∫ y, ({p : ℝ × ℝ | p.1 ≤ p.2}.indicator
            (fun p => Real.exp (2 * κ * (p.1 - p.2)) * f p.2)) (x, y) := by
        funext x
        unfold riccatiK
        rw [hident (2 * κ) f x]
      rw [h2]
      exact h1.neg
    
    have hker : ∀ x : ℝ, IntegrableOn (fun y => Real.exp (2 * κ * (x - y))) (Set.Ici x) ∧
        ∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) = 1 / (2 * κ) := by
      intro x
      have hfe : (fun y => Real.exp (2 * κ * (x - y))) =
          fun y => Real.exp (2 * κ * x) * Real.exp ((-(2 * κ)) * y) := by
        funext y
        rw [← Real.exp_add]
        congr 1
        ring
      have hneg : -(2 * κ) < 0 := by linarith
      have hne : Real.exp (2 * κ * x) ≠ 0 := (Real.exp_pos _).ne'
      rw [hfe]
      constructor
      · rw [integrableOn_Ici_iff_integrableOn_Ioi]
        exact (integrableOn_exp_mul_Ioi hneg x).const_mul _
      · rw [integral_Ici_eq_integral_Ioi, integral_const_mul, integral_exp_mul_Ioi hneg x,
          show -(2 * κ) * x = -(2 * κ * x) by ring, Real.exp_neg]
        field_simp
    
    have hpt : ∀ x, riccatiK κ f x ^ 2 ≤
        1 / (2 * κ) * ∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * f y ^ 2 := by
      intro x
      obtain ⟨hki, hkv⟩ := hker x
      have hc : Continuous fun y : ℝ => Real.exp (κ * (x - y)) := by fun_prop
      have hsq : ∀ y : ℝ, Real.exp (κ * (x - y)) ^ 2 = Real.exp (2 * κ * (x - y)) := by
        intro y
        rw [sq, ← Real.exp_add]
        congr 1
        ring
      have hu : MemLp (fun y => Real.exp (κ * (x - y))) 2
          ((volume : Measure ℝ).restrict (Set.Ici x)) := by
        refine (memLp_two_iff_integrable_sq hc.aestronglyMeasurable).2 ?_
        have he : (fun y => Real.exp (κ * (x - y)) ^ 2) =
            fun y => Real.exp (2 * κ * (x - y)) := funext hsq
        rw [he]
        exact hki
      have hv : MemLp (fun y => Real.exp (κ * (x - y)) * f y) 2
          ((volume : Measure ℝ).restrict (Set.Ici x)) := by
        refine MemLp.of_le (hf.restrict _) ?_ ?_
        · exact hc.aestronglyMeasurable.mul hf.1.restrict
        · refine ae_restrict_of_forall_mem measurableSet_Ici (fun y hy => ?_)
          have hy' : x ≤ y := hy
          have hle : Real.exp (κ * (x - y)) ≤ 1 := Real.exp_le_one_iff.2 (by nlinarith)
          rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_of_pos (Real.exp_pos _)]
          exact mul_le_of_le_one_left (abs_nonneg _) hle
      have hcs := CS _ _ _ hu hv
      have e1 : riccatiK κ f x ^ 2 =
          (∫ y in Set.Ici x, Real.exp (κ * (x - y)) * (Real.exp (κ * (x - y)) * f y)) ^ 2 := by
        have hfun : (fun y => Real.exp (2 * κ * (x - y)) * f y) =
            fun y => Real.exp (κ * (x - y)) * (Real.exp (κ * (x - y)) * f y) := by
          funext y
          rw [← mul_assoc, ← sq, hsq]
        show (-∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * f y) ^ 2 = _
        rw [neg_sq, hfun]
      have e2 : ∫ y in Set.Ici x, Real.exp (κ * (x - y)) ^ 2 = 1 / (2 * κ) := by
        rw [← hkv]
        congr 1
        funext y
        exact hsq y
      have e3 : ∫ y in Set.Ici x, (Real.exp (κ * (x - y)) * f y) ^ 2 =
          ∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * f y ^ 2 := by
        congr 1
        funext y
        rw [mul_pow, hsq]
      rw [e1]
      rw [e2, e3] at hcs
      exact hcs
    
    obtain ⟨F, hF⟩ : ∃ F : ℝ × ℝ → ℝ, F = {p : ℝ × ℝ | p.1 ≤ p.2}.indicator
        (fun p => Real.exp (2 * κ * (p.1 - p.2)) * f p.2 ^ 2) := ⟨_, rfl⟩
    have hFnn : ∀ p, 0 ≤ F p := by
      intro p
      rw [hF]
      exact Set.indicator_nonneg (fun p _ => mul_nonneg (Real.exp_pos _).le (sq_nonneg _)) p
    have hFm : AEStronglyMeasurable F ((volume : Measure ℝ).prod volume) := by
      rw [hF]
      exact hFmeas (2 * κ) (fun y => f y ^ 2) (hf.1.pow 2)
    have hslice_pt : ∀ x y : ℝ, F (x, y) = (Set.Iic y).indicator
        (fun x => Real.exp (2 * κ * x) * (Real.exp (-(2 * κ * y)) * f y ^ 2)) x := by
      intro x y
      rw [hF]
      by_cases hxy : x ≤ y
      · have h1 : (x, y) ∈ {p : ℝ × ℝ | p.1 ≤ p.2} := hxy
        have h2 : x ∈ Set.Iic y := hxy
        rw [Set.indicator_of_mem h1, Set.indicator_of_mem h2]
        show Real.exp (2 * κ * (x - y)) * f y ^ 2 =
          Real.exp (2 * κ * x) * (Real.exp (-(2 * κ * y)) * f y ^ 2)
        rw [← mul_assoc, ← Real.exp_add]
        congr 2
        ring
      · have h1 : (x, y) ∉ {p : ℝ × ℝ | p.1 ≤ p.2} := hxy
        have h2 : x ∉ Set.Iic y := hxy
        rw [Set.indicator_of_notMem h1, Set.indicator_of_notMem h2]
    have hslice_int : ∀ y : ℝ, Integrable (fun x => F (x, y)) volume := by
      intro y
      have he : (fun x => F (x, y)) = (Set.Iic y).indicator
          (fun x => Real.exp (2 * κ * x) * (Real.exp (-(2 * κ * y)) * f y ^ 2)) :=
        funext fun x => hslice_pt x y
      rw [he]
      exact IntegrableOn.integrable_indicator
        (Integrable.mul_const (integrableOn_exp_mul_Iic h2κ y) _) measurableSet_Iic
    have hslice_val : ∀ y : ℝ, ∫ x, F (x, y) = 1 / (2 * κ) * f y ^ 2 := by
      intro y
      have he : (fun x => F (x, y)) = (Set.Iic y).indicator
          (fun x => Real.exp (2 * κ * x) * (Real.exp (-(2 * κ * y)) * f y ^ 2)) :=
        funext fun x => hslice_pt x y
      rw [he, integral_indicator measurableSet_Iic, integral_mul_const,
        integral_exp_mul_Iic h2κ y, Real.exp_neg]
      field_simp
    have hFint : Integrable F ((volume : Measure ℝ).prod volume) := by
      rw [integrable_prod_iff' hFm]
      refine ⟨Filter.Eventually.of_forall hslice_int, ?_⟩
      have he : (fun y => ∫ x, ‖F (x, y)‖) = fun y => 1 / (2 * κ) * f y ^ 2 := by
        funext y
        have hn : (fun x => ‖F (x, y)‖) = fun x => F (x, y) :=
          funext fun x => Real.norm_of_nonneg (hFnn _)
        rw [hn, hslice_val]
      rw [he]
      exact hf.integrable_sq.const_mul _
    have hHeq : (fun x => ∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * f y ^ 2) =
        fun x => ∫ y, F (x, y) := by
      funext x
      rw [hident (2 * κ) (fun y => f y ^ 2) x, hF]
    have hHint : Integrable (fun x => ∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * f y ^ 2)
        volume := by
      rw [hHeq]
      exact hFint.integral_prod_left
    have hHval : ∫ x, (∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * f y ^ 2) =
        1 / (2 * κ) * ∫ y, f y ^ 2 := by
      rw [hHeq, ← integral_prod F hFint, integral_prod_symm F hFint]
      simp_rw [hslice_val]
      rw [integral_const_mul]
    
    have hA : 0 ≤ ∫ y, f y ^ 2 := integral_nonneg (fun y => sq_nonneg _)
    have hint : Integrable (fun x => riccatiK κ f x ^ 2) volume := by
      refine (hHint.const_mul (1 / (2 * κ))).mono'
        ((continuous_pow 2).comp_aestronglyMeasurable hmeas)
        (Filter.Eventually.of_forall fun x => ?_)
      rw [Real.norm_of_nonneg (sq_nonneg _)]
      exact hpt x
    refine ⟨(memLp_two_iff_integrable_sq hmeas).2 hint, ?_⟩
    have hmono := integral_mono hint (hHint.const_mul (1 / (2 * κ))) hpt
    rw [integral_const_mul, hHval] at hmono
    have hk : 1 / (2 * κ) ≤ 1 / 2 := by
      rw [div_le_div_iff₀ h2κ (by norm_num)]
      linarith
    have hk0 : 0 ≤ 1 / (2 * κ) := by positivity
    have hB : ∫ x, riccatiK κ f x ^ 2 ≤ (1 / 2) ^ 2 * ∫ y, f y ^ 2 := by
      have h1 : 1 / (2 * κ) * (1 / (2 * κ)) ≤ 1 / 2 * (1 / 2) :=
        mul_le_mul hk hk hk0 (by norm_num)
      have h2 := mul_le_mul_of_nonneg_right h1 hA
      nlinarith
    calc Real.sqrt (∫ x, riccatiK κ f x ^ 2) ≤ Real.sqrt ((1 / 2) ^ 2 * ∫ y, f y ^ 2) :=
          Real.sqrt_le_sqrt hB
      _ = 1 / 2 * Real.sqrt (∫ x, f x ^ 2) := by
          rw [Real.sqrt_mul' _ hA, Real.sqrt_sq (by norm_num)]
  · 
    obtain ⟨hm, hle⟩ := riccatiK_mul_bound κ hκ f g hf hg
    refine ⟨hm, ?_⟩
    have hA : 0 ≤ ∫ y, f y ^ 2 := integral_nonneg (fun y => sq_nonneg _)
    have hB : 0 ≤ ∫ y, g y ^ 2 := integral_nonneg (fun y => sq_nonneg _)
    calc Real.sqrt (∫ x, riccatiK κ (fun y => f y * g y) x ^ 2)
        ≤ Real.sqrt (1 / 4 * ((∫ y, f y ^ 2) * (∫ y, g y ^ 2))) := Real.sqrt_le_sqrt hle
      _ = 1 / 2 * (Real.sqrt (∫ x, f x ^ 2) * Real.sqrt (∫ x, g x ^ 2)) := by
          rw [Real.sqrt_mul' _ (mul_nonneg hA hB), Real.sqrt_mul hA,
            show (1 / 4 : ℝ) = (1 / 2) ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]

theorem schwartz_curve_L2_deriv (u : ℝ → 𝓢(ℝ, ℝ)) (v : 𝓢(ℝ, ℝ)) (t : ℝ)
    (hu : HasDerivAt u v t) :
    Filter.Tendsto (fun s : ℝ => ∫ x : ℝ, (u s x - u t x) ^ 2) (nhds t) (nhds 0) ∧
    Filter.Tendsto (fun s : ℝ => ∫ x : ℝ, ((s - t)⁻¹ * (u s x - u t x) - v x) ^ 2)
      (nhdsWithin t {t}ᶜ) (nhds 0) :=
by
  
  have hbound : ∀ f : 𝓢(ℝ, ℝ), ∫ x : ℝ, f x ^ 2 ≤
      Real.pi * (SchwartzMap.seminorm ℝ 0 0 f ^ 2 + SchwartzMap.seminorm ℝ 1 0 f ^ 2) := by
    intro f
    set A := SchwartzMap.seminorm ℝ 0 0 f with hAdef
    set B := SchwartzMap.seminorm ℝ 1 0 f with hBdef
    have hpt : ∀ x : ℝ, f x ^ 2 ≤ (A ^ 2 + B ^ 2) * (1 + x ^ 2)⁻¹ := by
      intro x
      have h1 : ‖f x‖ ≤ A := SchwartzMap.norm_le_seminorm ℝ f x
      have h2 : |x| ^ 1 * ‖iteratedDeriv 0 (⇑f) x‖ ≤ B := SchwartzMap.le_seminorm' ℝ 1 0 f x
      rw [iteratedDeriv_zero, pow_one, Real.norm_eq_abs] at h2
      rw [Real.norm_eq_abs] at h1
      have h1' : |f x| ^ 2 ≤ A ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h1 2
      have h2' : (|x| * |f x|) ^ 2 ≤ B ^ 2 := pow_le_pow_left₀ (by positivity) h2 2
      have hid : (1 + x ^ 2) * f x ^ 2 = |f x| ^ 2 + (|x| * |f x|) ^ 2 := by
        rw [mul_pow, sq_abs, sq_abs]; ring
      have hpos : 0 < 1 + x ^ 2 := by positivity
      rw [le_mul_inv_iff₀ hpos]
      nlinarith
    calc ∫ x : ℝ, f x ^ 2 ≤ ∫ x : ℝ, (A ^ 2 + B ^ 2) * (1 + x ^ 2)⁻¹ :=
          integral_mono_of_nonneg (Filter.Eventually.of_forall fun x => sq_nonneg _)
            (integrable_inv_one_add_sq.const_mul _) (Filter.Eventually.of_forall hpt)
      _ = Real.pi * (A ^ 2 + B ^ 2) := by
          rw [integral_const_mul, integral_univ_inv_one_add_sq, mul_comm]
  
  have hsq : ∀ {α : Type} (l : Filter α) (F : α → 𝓢(ℝ, ℝ)), Filter.Tendsto F l (nhds 0) →
      Filter.Tendsto (fun a => ∫ x : ℝ, F a x ^ 2) l (nhds 0) := by
    intro α l F hF
    have hc : ∀ k n : ℕ,
        Filter.Tendsto (fun a => SchwartzMap.seminorm ℝ k n (F a)) l (nhds 0) := by
      intro k n
      have h : Filter.Tendsto (SchwartzMap.seminorm ℝ k n) (nhds 0)
          (nhds (SchwartzMap.seminorm ℝ k n 0)) :=
        ((schwartz_withSeminorms ℝ ℝ ℝ).continuous_seminorm (k, n)).tendsto 0
      rw [map_zero] at h
      exact h.comp hF
    have hg := (((hc 0 0).pow 2).add ((hc 1 0).pow 2)).const_mul Real.pi
    simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, add_zero,
      mul_zero] at hg
    exact squeeze_zero (fun a => integral_nonneg fun x => sq_nonneg _)
      (fun a => hbound (F a)) hg
  
  have h2 : Filter.Tendsto (fun s : ℝ => (s - t)⁻¹ • (u s - u t - (s - t) • v))
      (nhds t) (nhds 0) := by
    have := (HasFDerivAtFilter.isLittleOTVS hu.hasFDerivAt).tendsto_inv_smul
    simpa only [ContinuousLinearMap.toSpanSingleton_apply] using this
  have hA : Filter.Tendsto (fun s : ℝ => u s - u t) (nhds t) (nhds 0) := by
    have h3 : Filter.Tendsto (fun s : ℝ => s - t) (nhds t) (nhds 0) :=
      tendsto_sub_nhds_zero_iff.2 Filter.tendsto_id
    have h5 := h3.smul h2
    rw [zero_smul] at h5
    have h6 := h3.smul (tendsto_const_nhds (x := v))
    rw [zero_smul] at h6
    have h7 := h5.add h6
    rw [add_zero] at h7
    refine h7.congr (fun s => ?_)
    by_cases hs : s = t
    · subst hs; simp
    · rw [smul_inv_smul₀ (sub_ne_zero.2 hs), sub_add_cancel]
  have hB : Filter.Tendsto (fun s : ℝ => (s - t)⁻¹ • (u s - u t) - v)
      (nhdsWithin t {t}ᶜ) (nhds 0) := by
    refine (h2.mono_left nhdsWithin_le_nhds).congr' ?_
    filter_upwards [self_mem_nhdsWithin] with s hs
    rw [smul_sub, inv_smul_smul₀ (sub_ne_zero.2 hs)]
  refine ⟨?_, ?_⟩
  · have := hsq _ _ hA
    simpa only [SchwartzMap.sub_apply] using this
  · have := hsq _ _ hB
    simpa only [SchwartzMap.sub_apply, SchwartzMap.smul_apply, smul_eq_mul] using this

theorem riccati_linear_solve (κ : ℝ) (hκ : 1 ≤ κ) (w g : ℝ → ℝ)
    (hw2 : MemLp w 2 (volume : Measure ℝ)) (hw : ∫ x : ℝ, w x ^ 2 ≤ 1 / 16)
    (hg : MemLp g 2 (volume : Measure ℝ)) :
    ∃ z : ℝ → ℝ, MemLp z 2 (volume : Measure ℝ) ∧
      ∀ x : ℝ, z x = g x - riccatiK κ (fun y => 2 * w y * z y) x :=
by
  classical
  have hκ0 : 0 < κ := by linarith
  
  have hnormF : ∀ F : Lp ℝ 2 (volume : Measure ℝ),
      ‖F‖ ^ 2 = ∫ x : ℝ, (F : ℝ → ℝ) x ^ 2 := by
    intro F
    rw [← real_inner_self_eq_norm_sq, MeasureTheory.L2.inner_def]
    congr 1
    funext x
    rw [real_inner_self_eq_norm_sq, Real.norm_eq_abs, sq_abs]
  have hnormf : ∀ (f : ℝ → ℝ) (hf : MemLp f 2 (volume : Measure ℝ)),
      ‖MemLp.toLp f hf‖ ^ 2 = ∫ x : ℝ, f x ^ 2 := by
    intro f hf
    rw [hnormF]
    apply integral_congr_ae
    filter_upwards [MemLp.coeFn_toLp hf] with x hx
    rw [hx]
  
  have hm : MemLp (fun y => 2 * w y) 2 (volume : Measure ℝ) := hw2.const_mul 2
  have hmsq : (∫ y : ℝ, (2 * w y) ^ 2) ≤ 1 / 4 := by
    have hA : (∫ y : ℝ, (2 * w y) ^ 2) = 4 * ∫ y : ℝ, w y ^ 2 := by
      rw [← integral_const_mul]
      congr 1
      funext y
      ring
    rw [hA]
    linarith
  have hmsq0 : 0 ≤ ∫ y : ℝ, (2 * w y) ^ 2 := integral_nonneg fun y => sq_nonneg _
  have hdiff : ∀ Z₁ Z₂ : ℝ → ℝ, MemLp Z₁ 2 (volume : Measure ℝ) →
      MemLp Z₂ 2 (volume : Measure ℝ) →
      MemLp (riccatiK κ (fun y => 2 * w y * Z₁ y)) 2 (volume : Measure ℝ) ∧
      ∫ x : ℝ, (riccatiK κ (fun y => 2 * w y * Z₁ y) x -
          riccatiK κ (fun y => 2 * w y * Z₂ y) x) ^ 2 ≤
        1 / 16 * ∫ x : ℝ, (Z₁ x - Z₂ x) ^ 2 := by
    intro Z₁ Z₂ h₁ h₂
    have hK1 : MemLp (riccatiK κ (fun y => 2 * w y * Z₁ y)) 2 (volume : Measure ℝ) :=
      (riccatiK_mul_bound κ hκ (fun y => 2 * w y) Z₁ hm h₁).1
    refine ⟨hK1, ?_⟩
    have hi₁ : Integrable (fun y => 2 * w y * Z₁ y) (volume : Measure ℝ) := hm.integrable_mul h₁
    have hi₂ : Integrable (fun y => 2 * w y * Z₂ y) (volume : Measure ℝ) := hm.integrable_mul h₂
    have hpt : ∀ x, riccatiK κ (fun y => 2 * w y * Z₁ y) x -
        riccatiK κ (fun y => 2 * w y * Z₂ y) x =
        riccatiK κ (fun y => (2 * w y) * (Z₁ y - Z₂ y)) x := by
      intro x
      rw [← (riccatiK_sub_congr κ hκ0).1 _ _ hi₁ hi₂ x]
      congr 1
      funext y
      ring
    have hD : MemLp (fun y => Z₁ y - Z₂ y) 2 (volume : Measure ℝ) := h₁.sub h₂
    have hb : ∫ x : ℝ, riccatiK κ (fun y => (2 * w y) * (Z₁ y - Z₂ y)) x ^ 2 ≤
        1 / 4 * ((∫ y : ℝ, (2 * w y) ^ 2) * (∫ y : ℝ, (Z₁ y - Z₂ y) ^ 2)) :=
      (riccatiK_mul_bound κ hκ (fun y => 2 * w y) (fun y => Z₁ y - Z₂ y) hm hD).2
    have hB : 0 ≤ ∫ y : ℝ, (Z₁ y - Z₂ y) ^ 2 := integral_nonneg fun y => sq_nonneg _
    have heq : (∫ x : ℝ, (riccatiK κ (fun y => 2 * w y * Z₁ y) x -
          riccatiK κ (fun y => 2 * w y * Z₂ y) x) ^ 2) =
        ∫ x : ℝ, riccatiK κ (fun y => (2 * w y) * (Z₁ y - Z₂ y)) x ^ 2 := by
      congr 1
      funext x
      rw [hpt x]
    rw [heq]
    have hmul := mul_le_mul_of_nonneg_right hmsq hB
    nlinarith
  
  have hψ : ∀ Z : Lp ℝ 2 (volume : Measure ℝ), MemLp
      (fun x => g x - riccatiK κ (fun y => 2 * w y * (Z : ℝ → ℝ) y) x) 2
      (volume : Measure ℝ) :=
    fun Z => hg.sub (hdiff Z Z (Lp.memLp Z) (Lp.memLp Z)).1
  obtain ⟨T, hTdef⟩ : ∃ T : Lp ℝ 2 (volume : Measure ℝ) → Lp ℝ 2 (volume : Measure ℝ),
      ∀ Z, T Z = MemLp.toLp _ (hψ Z) := ⟨fun Z => MemLp.toLp _ (hψ Z), fun Z => rfl⟩
  have hlip : ∀ Z₁ Z₂ : Lp ℝ 2 (volume : Measure ℝ),
      dist (T Z₁) (T Z₂) ≤ ((1 / 4 : NNReal) : ℝ) * dist Z₁ Z₂ := by
    intro Z₁ Z₂
    rw [dist_eq_norm, dist_eq_norm]
    have h1 : T Z₁ - T Z₂ = MemLp.toLp _ ((hψ Z₁).sub (hψ Z₂)) := by
      rw [hTdef, hTdef]
      exact (MemLp.toLp_sub (hψ Z₁) (hψ Z₂)).symm
    have e := (hdiff Z₁ Z₂ (Lp.memLp Z₁) (Lp.memLp Z₂)).2
    have e2 : (∫ x : ℝ, ((Z₁ : ℝ → ℝ) x - (Z₂ : ℝ → ℝ) x) ^ 2) =
        ∫ x : ℝ, ((Z₁ - Z₂ : Lp ℝ 2 (volume : Measure ℝ)) : ℝ → ℝ) x ^ 2 := by
      apply integral_congr_ae
      filter_upwards [Lp.coeFn_sub Z₁ Z₂] with x hx
      rw [hx]
      rfl
    have h2 : ‖T Z₁ - T Z₂‖ ^ 2 ≤ 1 / 16 * ‖Z₁ - Z₂‖ ^ 2 := by
      rw [h1, hnormf, hnormF, ← e2]
      refine le_trans (le_of_eq ?_) e
      congr 1
      funext x
      simp only [Pi.sub_apply]
      ring
    have h3 : (1 / 16 : ℝ) * ‖Z₁ - Z₂‖ ^ 2 = (1 / 4 * ‖Z₁ - Z₂‖) ^ 2 := by ring
    rw [h3] at h2
    have h4 := abs_le_of_sq_le_sq' h2 (by positivity)
    have hc : ((1 / 4 : NNReal) : ℝ) = 1 / 4 := by norm_num
    rw [hc]
    linarith [h4.2]
  have hT : ContractingWith (1 / 4 : NNReal) T := by
    refine ⟨?_, LipschitzWith.of_dist_le_mul hlip⟩
    rw [← NNReal.coe_lt_coe]
    norm_num
  obtain ⟨Zs, hfix⟩ : ∃ Zs : Lp ℝ 2 (volume : Measure ℝ), T Zs = Zs :=
    ⟨_, ContractingWith.fixedPoint_isFixedPt hT⟩
  
  obtain ⟨z, hzdef⟩ : ∃ z : ℝ → ℝ,
      z = fun x => g x - riccatiK κ (fun y => 2 * w y * (Zs : ℝ → ℝ) y) x := ⟨_, rfl⟩
  have hz2 : MemLp z 2 (volume : Measure ℝ) := by
    rw [hzdef]
    exact hψ Zs
  have hae : (Zs : ℝ → ℝ) =ᵐ[volume] z := by
    have h := MemLp.coeFn_toLp (hψ Zs)
    rw [← hTdef, hfix] at h
    rw [hzdef]
    exact h
  have hK : ∀ x, riccatiK κ (fun y => 2 * w y * z y) x =
      riccatiK κ (fun y => 2 * w y * (Zs : ℝ → ℝ) y) x :=
    (riccatiK_sub_congr κ hκ0).2 _ _ (hae.mono fun y hy => by
      show 2 * w y * z y = 2 * w y * (Zs : ℝ → ℝ) y
      rw [hy])
  refine ⟨z, hz2, fun x => ?_⟩
  rw [hK x, hzdef]

theorem riccati_sol_L2_lipschitz (κ : ℝ) (hκ : 1 ≤ κ) (q₁ q₂ : 𝓢(ℝ, ℝ)) (w₁ w₂ : ℝ → ℝ)
    (h₁ : IsRiccatiSol κ q₁ w₁) (h₂ : IsRiccatiSol κ q₂ w₂) :
    ∫ x : ℝ, (w₁ x - w₂ x) ^ 2 ≤ 4 / 9 * ∫ x : ℝ, (q₁ x - q₂ x) ^ 2 :=
by
  have hκ0 : (0 : ℝ) < κ := by linarith
  obtain ⟨hm₁, hs₁, he₁⟩ := h₁
  obtain ⟨hm₂, hs₂, he₂⟩ := h₂
  obtain ⟨hsub, -⟩ := riccatiK_sub_congr κ hκ0
  
  have hdiff : ∀ x, w₁ x - w₂ x = riccatiK κ (fun y => q₁ y - q₂ y) x -
      riccatiK κ (fun y => (w₁ y + w₂ y) * (w₁ y - w₂ y)) x := by
    intro x
    have hq := hsub (⇑q₁) (⇑q₂) (SchwartzMap.integrable q₁) (SchwartzMap.integrable q₂) x
    have hw := hsub (fun y => w₁ y ^ 2) (fun y => w₂ y ^ 2) hm₁.integrable_sq
      hm₂.integrable_sq x
    beta_reduce at hw
    have hfun : (fun y => (w₁ y + w₂ y) * (w₁ y - w₂ y)) = (fun y => w₁ y ^ 2 - w₂ y ^ 2) := by
      funext y; ring
    rw [hfun, hw, hq]
    linarith [he₁ x, he₂ x]
  
  have hdq : MemLp (fun y => q₁ y - q₂ y) 2 (volume : Measure ℝ) := (q₁.memLp 2).sub (q₂.memLp 2)
  have hp : MemLp (fun y => w₁ y + w₂ y) 2 (volume : Measure ℝ) := hm₁.add hm₂
  have he : MemLp (fun y => w₁ y - w₂ y) 2 (volume : Measure ℝ) := hm₁.sub hm₂
  obtain ⟨hK1, hK2⟩ := riccatiK_sqrt_bounds κ hκ
  obtain ⟨ha, hCs⟩ := hK1 _ hdq
  obtain ⟨hb, hDs⟩ := hK2 _ _ hp he
  generalize riccatiK κ (fun y => q₁ y - q₂ y) = a at ha hCs hdiff
  generalize riccatiK κ (fun y => (w₁ y + w₂ y) * (w₁ y - w₂ y)) = b at hb hDs hdiff
  have hA0 : 0 ≤ ∫ x, (w₁ x - w₂ x) ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  have hB0 : 0 ≤ ∫ x, (q₁ x - q₂ x) ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  have hC0 : 0 ≤ ∫ x, a x ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  have hD0 : 0 ≤ ∫ x, b x ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  have hP0 : 0 ≤ ∫ x, (w₁ x + w₂ x) ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  have hCle : ∫ x, a x ^ 2 ≤ 1 / 4 * ∫ x, (q₁ x - q₂ x) ^ 2 := by
    have h := pow_le_pow_left₀ (Real.sqrt_nonneg _) hCs 2
    rw [mul_pow, Real.sq_sqrt hC0, Real.sq_sqrt hB0] at h
    linarith
  have hDle : ∫ x, b x ^ 2 ≤ 1 / 4 * ((∫ x, (w₁ x + w₂ x) ^ 2) * ∫ x, (w₁ x - w₂ x) ^ 2) := by
    have h := pow_le_pow_left₀ (Real.sqrt_nonneg _) hDs 2
    rw [mul_pow, mul_pow, Real.sq_sqrt hD0, Real.sq_sqrt hP0, Real.sq_sqrt hA0] at h
    linarith
  
  have hP : ∫ y, (w₁ y + w₂ y) ^ 2 ≤ 1 / 4 := by
    have hint1 : Integrable (fun y => (w₁ y + w₂ y) ^ 2) volume := (hm₁.add hm₂).integrable_sq
    have hint2 : Integrable (fun y => 2 * w₁ y ^ 2 + 2 * w₂ y ^ 2) volume :=
      (hm₁.integrable_sq.const_mul 2).add (hm₂.integrable_sq.const_mul 2)
    have hmono : ∫ y, (w₁ y + w₂ y) ^ 2 ≤ ∫ y, (2 * w₁ y ^ 2 + 2 * w₂ y ^ 2) :=
      integral_mono hint1 hint2 (fun y => by
        show (w₁ y + w₂ y) ^ 2 ≤ 2 * w₁ y ^ 2 + 2 * w₂ y ^ 2
        nlinarith [sq_nonneg (w₁ y - w₂ y)])
    rw [integral_add (hm₁.integrable_sq.const_mul 2) (hm₂.integrable_sq.const_mul 2),
      integral_const_mul, integral_const_mul] at hmono
    linarith
  
  have hAeq : ∫ x, (w₁ x - w₂ x) ^ 2 = ∫ x, (a x - b x) ^ 2 := by
    congr 1; funext x; rw [hdiff x]
  have hia := ha.integrable_sq
  have hib := hb.integrable_sq
  have hmono : ∫ x, (a x - b x) ^ 2 ≤ ∫ x, (4 / 3 * a x ^ 2 + 4 * b x ^ 2) :=
    integral_mono (ha.sub hb).integrable_sq ((hia.const_mul (4 / 3)).add (hib.const_mul 4))
      (fun x => by
        show (a x - b x) ^ 2 ≤ 4 / 3 * a x ^ 2 + 4 * b x ^ 2
        nlinarith [sq_nonneg (a x + 3 * b x)])
  rw [integral_add (hia.const_mul (4 / 3)) (hib.const_mul 4), integral_const_mul,
    integral_const_mul, ← hAeq] at hmono
  
  have hPA := mul_le_mul_of_nonneg_right hP hA0
  linarith

theorem riccati_quotient_L2_estimate (κ : ℝ) (hκ : 1 ≤ κ) (q₁ q₂ v : 𝓢(ℝ, ℝ)) (h : ℝ)
    (w₁ w₂ z : ℝ → ℝ) (h₁ : IsRiccatiSol κ q₁ w₁) (h₂ : IsRiccatiSol κ q₂ w₂)
    (hz2 : MemLp z 2 (volume : Measure ℝ))
    (hz : ∀ x : ℝ, z x = riccatiK κ v x - riccatiK κ (fun y => 2 * w₂ y * z y) x) :
    Real.sqrt (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) ^ 2) ≤
      2 / 3 * (Real.sqrt (∫ x : ℝ, (h⁻¹ * (q₁ x - q₂ x) - v x) ^ 2) +
        Real.sqrt (∫ x : ℝ, (w₁ x - w₂ x) ^ 2) * Real.sqrt (∫ x : ℝ, z x ^ 2)) :=
by
  have hκ0 : 0 < κ := by linarith
  obtain ⟨S, -⟩ := riccatiK_sub_congr κ hκ0
  
  have hscale : ∀ (c : ℝ) (f : ℝ → ℝ) (x : ℝ),
      riccatiK κ (fun y => c * f y) x = c * riccatiK κ f x := by
    intro c f x
    unfold riccatiK
    have e : (fun y => Real.exp (2 * κ * (x - y)) * (c * f y)) =
        fun y => c * (Real.exp (2 * κ * (x - y)) * f y) := by
      funext y; ring
    rw [e, integral_const_mul]
    ring
  
  have hN : ∀ (f : ℝ → ℝ) (hf : MemLp f 2 (volume : Measure ℝ)),
      ‖hf.toLp f‖ = Real.sqrt (∫ x : ℝ, f x ^ 2) := by
    intro f hf
    rw [Lp.norm_toLp, hf.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    have h2 : (2 : ENNReal).toReal = 2 := by norm_num
    have hint : ∫ a, ‖f a‖ ^ (2 : ℝ) = ∫ a, f a ^ 2 := by
      congr 1; funext a; rw [Real.rpow_two, Real.norm_eq_abs, sq_abs]
    rw [h2, hint, Real.sqrt_eq_rpow, one_div, ENNReal.toReal_ofReal]
    exact Real.rpow_nonneg (integral_nonneg fun _ => sq_nonneg _) _
  
  have hsub : ∀ f g : ℝ → ℝ, MemLp f 2 (volume : Measure ℝ) → MemLp g 2 (volume : Measure ℝ) →
      Real.sqrt (∫ x : ℝ, (f x - g x) ^ 2) ≤
        Real.sqrt (∫ x : ℝ, f x ^ 2) + Real.sqrt (∫ x : ℝ, g x ^ 2) := by
    intro f g hf hg
    have e := hN (f - g) (hf.sub hg)
    rw [MemLp.toLp_sub hf hg] at e
    simp only [Pi.sub_apply] at e
    calc Real.sqrt (∫ x : ℝ, (f x - g x) ^ 2) = ‖hf.toLp f - hg.toLp g‖ := e.symm
      _ ≤ ‖hf.toLp f‖ + ‖hg.toLp g‖ := norm_sub_le _ _
      _ = _ := by rw [hN f hf, hN g hg]
  have hadd : ∀ f g : ℝ → ℝ, MemLp f 2 (volume : Measure ℝ) → MemLp g 2 (volume : Measure ℝ) →
      Real.sqrt (∫ x : ℝ, (f x + g x) ^ 2) ≤
        Real.sqrt (∫ x : ℝ, f x ^ 2) + Real.sqrt (∫ x : ℝ, g x ^ 2) := by
    intro f g hf hg
    have e := hN (f + g) (hf.add hg)
    rw [MemLp.toLp_add hf hg] at e
    simp only [Pi.add_apply] at e
    calc Real.sqrt (∫ x : ℝ, (f x + g x) ^ 2) = ‖hf.toLp f + hg.toLp g‖ := e.symm
      _ ≤ ‖hf.toLp f‖ + ‖hg.toLp g‖ := norm_add_le _ _
      _ = _ := by rw [hN f hf, hN g hg]
  
  have imul : ∀ f g : ℝ → ℝ, MemLp f 2 (volume : Measure ℝ) → MemLp g 2 (volume : Measure ℝ) →
      Integrable (fun y => f y * g y) (volume : Measure ℝ) :=
    fun f g hf hg => hf.integrable_mul hg
  have iq₁ : Integrable (q₁ : ℝ → ℝ) (volume : Measure ℝ) := q₁.integrable
  have iq₂ : Integrable (q₂ : ℝ → ℝ) (volume : Measure ℝ) := q₂.integrable
  have iv : Integrable (v : ℝ → ℝ) (volume : Measure ℝ) := v.integrable
  have iw₁ : Integrable (fun y => w₁ y ^ 2) (volume : Measure ℝ) := h₁.1.integrable_sq
  have iw₂ : Integrable (fun y => w₂ y ^ 2) (volume : Measure ℝ) := h₂.1.integrable_sq
  have mR : MemLp (fun y => h⁻¹ * (q₁ y - q₂ y) - v y) 2 (volume : Measure ℝ) :=
    (((q₁.memLp 2).sub (q₂.memLp 2)).const_mul h⁻¹).sub (v.memLp 2)
  have mδ : MemLp (fun y => h⁻¹ * (w₁ y - w₂ y) - z y) 2 (volume : Measure ℝ) :=
    ((h₁.1.sub h₂.1).const_mul h⁻¹).sub hz2
  have mP : MemLp (fun y => w₁ y + w₂ y) 2 (volume : Measure ℝ) := h₁.1.add h₂.1
  have mE : MemLp (fun y => w₁ y - w₂ y) 2 (volume : Measure ℝ) := h₁.1.sub h₂.1
  have m2w : MemLp (fun y => 2 * w₂ y) 2 (volume : Measure ℝ) := h₂.1.const_mul 2
  have iR : Integrable (fun y => h⁻¹ * (q₁ y - q₂ y) - v y) (volume : Measure ℝ) :=
    ((iq₁.sub iq₂).const_mul h⁻¹).sub iv
  have iPD : Integrable (fun y => (w₁ y + w₂ y) * (h⁻¹ * (w₁ y - w₂ y) - z y))
      (volume : Measure ℝ) := imul _ _ mP mδ
  have iEZ : Integrable (fun y => (w₁ y - w₂ y) * z y) (volume : Measure ℝ) := imul _ _ mE hz2
  have i2wz : Integrable (fun y => 2 * w₂ y * z y) (volume : Measure ℝ) := imul _ _ m2w hz2
  
  have key : ∀ x : ℝ, h⁻¹ * (w₁ x - w₂ x) - z x =
      riccatiK κ (fun y => h⁻¹ * (q₁ y - q₂ y) - v y) x
        - riccatiK κ (fun y => (w₁ y + w₂ y) * (h⁻¹ * (w₁ y - w₂ y) - z y)) x
        - riccatiK κ (fun y => (w₁ y - w₂ y) * z y) x := by
    intro x
    have e1 : riccatiK κ (fun y => (h⁻¹ * (q₁ y - q₂ y) - v y)
          - (w₁ y + w₂ y) * (h⁻¹ * (w₁ y - w₂ y) - z y)) x =
        riccatiK κ (fun y => h⁻¹ * (q₁ y - q₂ y) - v y) x
          - riccatiK κ (fun y => (w₁ y + w₂ y) * (h⁻¹ * (w₁ y - w₂ y) - z y)) x :=
      S _ _ iR iPD x
    have e2 : riccatiK κ (fun y => ((h⁻¹ * (q₁ y - q₂ y) - v y)
          - (w₁ y + w₂ y) * (h⁻¹ * (w₁ y - w₂ y) - z y)) - (w₁ y - w₂ y) * z y) x =
        riccatiK κ (fun y => (h⁻¹ * (q₁ y - q₂ y) - v y)
          - (w₁ y + w₂ y) * (h⁻¹ * (w₁ y - w₂ y) - z y)) x
          - riccatiK κ (fun y => (w₁ y - w₂ y) * z y) x :=
      S _ _ (iR.sub iPD) iEZ x
    have hfun : (fun y => ((h⁻¹ * (q₁ y - q₂ y) - v y)
          - (w₁ y + w₂ y) * (h⁻¹ * (w₁ y - w₂ y) - z y)) - (w₁ y - w₂ y) * z y) =
        fun y => h⁻¹ * ((q₁ y - w₁ y ^ 2) - (q₂ y - w₂ y ^ 2)) - (v y - 2 * w₂ y * z y) := by
      funext y; ring
    rw [hfun] at e2
    have e3 : riccatiK κ
          (fun y => h⁻¹ * ((q₁ y - w₁ y ^ 2) - (q₂ y - w₂ y ^ 2)) - (v y - 2 * w₂ y * z y)) x =
        riccatiK κ (fun y => h⁻¹ * ((q₁ y - w₁ y ^ 2) - (q₂ y - w₂ y ^ 2))) x
          - riccatiK κ (fun y => v y - 2 * w₂ y * z y) x :=
      S _ _ (((iq₁.sub iw₁).sub (iq₂.sub iw₂)).const_mul h⁻¹) (iv.sub i2wz) x
    have e4 : riccatiK κ (fun y => h⁻¹ * ((q₁ y - w₁ y ^ 2) - (q₂ y - w₂ y ^ 2))) x =
        h⁻¹ * riccatiK κ (fun y => (q₁ y - w₁ y ^ 2) - (q₂ y - w₂ y ^ 2)) x :=
      hscale _ _ x
    have e5 : riccatiK κ (fun y => (q₁ y - w₁ y ^ 2) - (q₂ y - w₂ y ^ 2)) x =
        riccatiK κ (fun y => q₁ y - w₁ y ^ 2) x - riccatiK κ (fun y => q₂ y - w₂ y ^ 2) x :=
      S _ _ (iq₁.sub iw₁) (iq₂.sub iw₂) x
    have e6 : riccatiK κ (fun y => q₁ y - w₁ y ^ 2) x =
        riccatiK κ q₁ x - riccatiK κ (fun y => w₁ y ^ 2) x := S _ _ iq₁ iw₁ x
    have e7 : riccatiK κ (fun y => q₂ y - w₂ y ^ 2) x =
        riccatiK κ q₂ x - riccatiK κ (fun y => w₂ y ^ 2) x := S _ _ iq₂ iw₂ x
    have e8 : riccatiK κ (fun y => v y - 2 * w₂ y * z y) x =
        riccatiK κ v x - riccatiK κ (fun y => 2 * w₂ y * z y) x := S _ _ iv i2wz x
    have hw1 := h₁.2.2 x
    have hw2 := h₂.2.2 x
    have hzx := hz x
    linear_combination h⁻¹ * hw1 - h⁻¹ * hw2 - hzx + e1 + e2 - e3 + e8 - e4
      - h⁻¹ * e5 - h⁻¹ * e6 + h⁻¹ * e7
  
  have K := riccatiK_sqrt_bounds κ hκ
  have mA : MemLp (riccatiK κ (fun y => h⁻¹ * (q₁ y - q₂ y) - v y)) 2 (volume : Measure ℝ) :=
    (K.1 _ mR).1
  have bA : Real.sqrt (∫ x : ℝ, riccatiK κ (fun y => h⁻¹ * (q₁ y - q₂ y) - v y) x ^ 2) ≤
      1 / 2 * Real.sqrt (∫ x : ℝ, (h⁻¹ * (q₁ x - q₂ x) - v x) ^ 2) := (K.1 _ mR).2
  have mB : MemLp (riccatiK κ (fun y => (w₁ y + w₂ y) * (h⁻¹ * (w₁ y - w₂ y) - z y))) 2
      (volume : Measure ℝ) := (K.2 _ _ mP mδ).1
  have bB : Real.sqrt (∫ x : ℝ,
        riccatiK κ (fun y => (w₁ y + w₂ y) * (h⁻¹ * (w₁ y - w₂ y) - z y)) x ^ 2) ≤
      1 / 2 * (Real.sqrt (∫ x : ℝ, (w₁ x + w₂ x) ^ 2) *
        Real.sqrt (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) ^ 2)) := (K.2 _ _ mP mδ).2
  have mC : MemLp (riccatiK κ (fun y => (w₁ y - w₂ y) * z y)) 2 (volume : Measure ℝ) :=
    (K.2 _ _ mE hz2).1
  have bC : Real.sqrt (∫ x : ℝ, riccatiK κ (fun y => (w₁ y - w₂ y) * z y) x ^ 2) ≤
      1 / 2 * (Real.sqrt (∫ x : ℝ, (w₁ x - w₂ x) ^ 2) * Real.sqrt (∫ x : ℝ, z x ^ 2)) :=
    (K.2 _ _ mE hz2).2
  
  have hsmall : ∀ w : ℝ → ℝ, (∫ x : ℝ, w x ^ 2) ≤ 1 / 16 →
      Real.sqrt (∫ x : ℝ, w x ^ 2) ≤ 1 / 4 := by
    intro w hw
    calc Real.sqrt (∫ x : ℝ, w x ^ 2) ≤ Real.sqrt (1 / 16) := Real.sqrt_le_sqrt hw
      _ = 1 / 4 := by
        rw [show (1 / 16 : ℝ) = (1 / 4) ^ 2 by norm_num]
        exact Real.sqrt_sq (by norm_num)
  have hP : Real.sqrt (∫ x : ℝ, (w₁ x + w₂ x) ^ 2) ≤ 1 / 2 := by
    have := hadd w₁ w₂ h₁.1 h₂.1
    have := hsmall w₁ h₁.2.1
    have := hsmall w₂ h₂.2.1
    linarith
  generalize riccatiK κ (fun y => h⁻¹ * (q₁ y - q₂ y) - v y) = A at key mA bA
  generalize riccatiK κ (fun y => (w₁ y + w₂ y) * (h⁻¹ * (w₁ y - w₂ y) - z y)) = B at key mB bB
  generalize riccatiK κ (fun y => (w₁ y - w₂ y) * z y) = C at key mC bC
  have hδeq : (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) ^ 2) = ∫ x : ℝ, (A x - B x - C x) ^ 2 := by
    congr 1; funext x; rw [key x]
  have m1 : Real.sqrt (∫ x : ℝ, (A x - B x - C x) ^ 2) ≤
      Real.sqrt (∫ x : ℝ, (A x - B x) ^ 2) + Real.sqrt (∫ x : ℝ, C x ^ 2) :=
    hsub (fun x => A x - B x) C (mA.sub mB) mC
  have m2 : Real.sqrt (∫ x : ℝ, (A x - B x) ^ 2) ≤
      Real.sqrt (∫ x : ℝ, A x ^ 2) + Real.sqrt (∫ x : ℝ, B x ^ 2) := hsub A B mA mB
  have hprod : Real.sqrt (∫ x : ℝ, (w₁ x + w₂ x) ^ 2) *
        Real.sqrt (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) ^ 2) ≤
      1 / 2 * Real.sqrt (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) ^ 2) :=
    mul_le_mul_of_nonneg_right hP (Real.sqrt_nonneg _)
  rw [hδeq] at hprod bB ⊢
  linarith

theorem riccati_slope_estimate (h : ℝ) (w₁ w₂ z : ℝ → ℝ)
    (h₁ : MemLp w₁ 2 (volume : Measure ℝ)) (h₂ : MemLp w₂ 2 (volume : Measure ℝ))
    (hz : MemLp z 2 (volume : Measure ℝ)) :
    |((∫ x : ℝ, w₁ x ^ 2) - ∫ x : ℝ, w₂ x ^ 2) / h - 2 * ∫ x : ℝ, w₂ x * z x| ≤
      Real.sqrt (∫ x : ℝ, (w₁ x - w₂ x) ^ 2) *
          (Real.sqrt (∫ x : ℝ, z x ^ 2) +
            Real.sqrt (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) ^ 2)) +
        2 * Real.sqrt (∫ x : ℝ, w₂ x ^ 2) *
          Real.sqrt (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) ^ 2) :=
by
  
  have cs : ∀ f g : ℝ → ℝ, MemLp f 2 (volume : Measure ℝ) → MemLp g 2 (volume : Measure ℝ) →
      |∫ x : ℝ, f x * g x| ≤ Real.sqrt (∫ x : ℝ, f x ^ 2) * Real.sqrt (∫ x : ℝ, g x ^ 2) := by
    intro f g hf hg
    have hF : MemLp (fun x => |f x|) (ENNReal.ofReal 2) (volume : Measure ℝ) := by
      rw [ENNReal.ofReal_ofNat]; exact hf.abs
    have hG : MemLp (fun x => |g x|) (ENNReal.ofReal 2) (volume : Measure ℝ) := by
      rw [ENNReal.ofReal_ofNat]; exact hg.abs
    have hH := integral_mul_le_Lp_mul_Lq_of_nonneg Real.HolderConjugate.two_two
      (Filter.Eventually.of_forall (fun x => abs_nonneg (f x)))
      (Filter.Eventually.of_forall (fun x => abs_nonneg (g x))) hF hG
    have e1 : ∀ k : ℝ → ℝ, (∫ x : ℝ, |k x| ^ (2:ℝ)) = ∫ x : ℝ, k x ^ 2 := by
      intro k
      congr 1
      funext x
      rw [Real.rpow_two, sq_abs]
    rw [e1 f, e1 g, ← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow] at hH
    calc |∫ x : ℝ, f x * g x| ≤ ∫ x : ℝ, |f x * g x| := abs_integral_le_integral_abs
      _ = ∫ x : ℝ, |f x| * |g x| := by
        congr 1
        funext x
        exact abs_mul _ _
      _ ≤ _ := hH
  have hδ : MemLp (fun x => w₁ x - w₂ x) 2 (volume : Measure ℝ) := h₁.sub h₂
  have he : MemLp (fun x => h⁻¹ * (w₁ x - w₂ x) - z x) 2 (volume : Measure ℝ) :=
    (hδ.const_mul h⁻¹).sub hz
  have I1 : Integrable (fun x => w₁ x ^ 2) (volume : Measure ℝ) := h₁.integrable_sq
  have I2 : Integrable (fun x => w₂ x ^ 2) (volume : Measure ℝ) := h₂.integrable_sq
  have I3 : Integrable (fun x => w₂ x * z x) (volume : Measure ℝ) := h₂.integrable_mul hz
  have I4 : Integrable (fun x => (h⁻¹ * (w₁ x - w₂ x) - z x) * (w₁ x - w₂ x))
      (volume : Measure ℝ) := he.integrable_mul hδ
  have I5 : Integrable (fun x => z x * (w₁ x - w₂ x)) (volume : Measure ℝ) :=
    hz.integrable_mul hδ
  have I6 : Integrable (fun x => (h⁻¹ * (w₁ x - w₂ x) - z x) * w₂ x) (volume : Measure ℝ) :=
    he.integrable_mul h₂
  have J1 : Integrable (fun x => h⁻¹ * (w₁ x ^ 2 - w₂ x ^ 2)) (volume : Measure ℝ) :=
    (I1.sub I2).const_mul _
  have J2 : Integrable (fun x => 2 * (w₂ x * z x)) (volume : Measure ℝ) := I3.const_mul _
  have J3 : Integrable (fun x => (h⁻¹ * (w₁ x - w₂ x) - z x) * (w₁ x - w₂ x) +
      z x * (w₁ x - w₂ x)) (volume : Measure ℝ) := I4.add I5
  have J4 : Integrable (fun x => 2 * ((h⁻¹ * (w₁ x - w₂ x) - z x) * w₂ x))
      (volume : Measure ℝ) := I6.const_mul _
  have L : (∫ x : ℝ, (h⁻¹ * (w₁ x ^ 2 - w₂ x ^ 2) - 2 * (w₂ x * z x))) =
      ((∫ x : ℝ, w₁ x ^ 2) - ∫ x : ℝ, w₂ x ^ 2) / h - 2 * ∫ x : ℝ, w₂ x * z x := by
    rw [integral_sub J1 J2, integral_const_mul, integral_const_mul, integral_sub I1 I2,
      div_eq_inv_mul]
  have R : (∫ x : ℝ, ((h⁻¹ * (w₁ x - w₂ x) - z x) * (w₁ x - w₂ x) + z x * (w₁ x - w₂ x) +
      2 * ((h⁻¹ * (w₁ x - w₂ x) - z x) * w₂ x))) =
      (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) * (w₁ x - w₂ x)) +
        (∫ x : ℝ, z x * (w₁ x - w₂ x)) +
        2 * ∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) * w₂ x := by
    rw [integral_add J3 J4, integral_add I4 I5, integral_const_mul]
  have key : ((∫ x : ℝ, w₁ x ^ 2) - ∫ x : ℝ, w₂ x ^ 2) / h - 2 * ∫ x : ℝ, w₂ x * z x =
      (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) * (w₁ x - w₂ x)) +
        (∫ x : ℝ, z x * (w₁ x - w₂ x)) +
        2 * ∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) * w₂ x := by
    rw [← L, ← R]
    congr 1
    funext x
    ring
  rw [key]
  have c1 := cs _ _ he hδ
  have c2 := cs _ _ hz hδ
  have c3 := cs _ _ he h₂
  beta_reduce at c1 c2 c3
  have tri := abs_add_three (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) * (w₁ x - w₂ x))
    (∫ x : ℝ, z x * (w₁ x - w₂ x)) (2 * ∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) * w₂ x)
  rw [abs_mul, abs_two] at tri
  have hring : Real.sqrt (∫ x : ℝ, (w₁ x - w₂ x) ^ 2) *
          (Real.sqrt (∫ x : ℝ, z x ^ 2) +
            Real.sqrt (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) ^ 2)) +
        2 * Real.sqrt (∫ x : ℝ, w₂ x ^ 2) *
          Real.sqrt (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) ^ 2) =
      Real.sqrt (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) ^ 2) *
          Real.sqrt (∫ x : ℝ, (w₁ x - w₂ x) ^ 2) +
        Real.sqrt (∫ x : ℝ, z x ^ 2) * Real.sqrt (∫ x : ℝ, (w₁ x - w₂ x) ^ 2) +
        2 * (Real.sqrt (∫ x : ℝ, (h⁻¹ * (w₁ x - w₂ x) - z x) ^ 2) *
          Real.sqrt (∫ x : ℝ, w₂ x ^ 2)) := by ring
  rw [hring]
  linarith

theorem riccati_alpha_hasDerivAt (κ : ℝ) (hκ : 1 ≤ κ) (u : ℝ → 𝓢(ℝ, ℝ)) (v : 𝓢(ℝ, ℝ)) (t : ℝ)
    (hu : HasDerivAt u v t)
    (hsol : ∀ᶠ s in nhds t, ∃ ws : ℝ → ℝ, IsRiccatiSol κ (u s) ws ∧
      riccatiAlpha κ (u s) = ∫ x : ℝ, ws x ^ 2) :
    ∃ w z : ℝ → ℝ, IsRiccatiSol κ (u t) w ∧ MemLp z 2 (volume : Measure ℝ) ∧
      (∀ x : ℝ, z x = riccatiK κ v x - riccatiK κ (fun y => 2 * w y * z y) x) ∧
      HasDerivAt (fun s : ℝ => riccatiAlpha κ (u s)) (2 * ∫ x : ℝ, w x * z x) t :=
by
  classical
  
  obtain ⟨w, hw, hαt⟩ := hsol.self_of_nhds
  have hv2 : MemLp (⇑v) 2 (volume : Measure ℝ) := v.memLp 2
  have hKv : MemLp (riccatiK κ v) 2 (volume : Measure ℝ) :=
    ((riccatiK_sqrt_bounds κ hκ).1 v hv2).1
  obtain ⟨z, hz2, hz⟩ := riccati_linear_solve κ hκ w (riccatiK κ v) hw.1 hw.2.1 hKv
  refine ⟨w, z, hw, hz2, hz, ?_⟩
  
  have hex : ∀ s : ℝ, ∃ ws : ℝ → ℝ,
      (∃ ws : ℝ → ℝ, IsRiccatiSol κ (u s) ws ∧ riccatiAlpha κ (u s) = ∫ x : ℝ, ws x ^ 2) →
        IsRiccatiSol κ (u s) ws ∧ riccatiAlpha κ (u s) = ∫ x : ℝ, ws x ^ 2 := by
    intro s
    by_cases h : ∃ ws : ℝ → ℝ, IsRiccatiSol κ (u s) ws ∧ riccatiAlpha κ (u s) = ∫ x : ℝ, ws x ^ 2
    · obtain ⟨ws, hws⟩ := h
      exact ⟨ws, fun _ => hws⟩
    · exact ⟨fun _ => 0, fun h' => absurd h' h⟩
  choose W hWs using hex
  have hW : ∀ᶠ s in nhds t, IsRiccatiSol κ (u s) (W s) ∧
      riccatiAlpha κ (u s) = ∫ x : ℝ, W s x ^ 2 := hsol.mono fun s hs => hWs s hs
  
  obtain ⟨hB, hC⟩ := schwartz_curve_L2_deriv u v t hu
  obtain ⟨Nz, hNz⟩ : ∃ c : ℝ, c = Real.sqrt (∫ x : ℝ, z x ^ 2) := ⟨_, rfl⟩
  obtain ⟨Nw, hNw⟩ : ∃ c : ℝ, c = Real.sqrt (∫ x : ℝ, w x ^ 2) := ⟨_, rfl⟩
  have hNz0 : 0 ≤ Nz := by rw [hNz]; exact Real.sqrt_nonneg _
  have hNw0 : 0 ≤ Nw := by rw [hNw]; exact Real.sqrt_nonneg _
  obtain ⟨ah, hah⟩ : ∃ f : ℝ → ℝ, ∀ s, f s = Real.sqrt (4 / 9 * ∫ x : ℝ, (u s x - u t x) ^ 2) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨sc, hsc⟩ : ∃ f : ℝ → ℝ, ∀ s,
      f s = Real.sqrt (∫ x : ℝ, ((s - t)⁻¹ * (u s x - u t x) - v x) ^ 2) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨dh, hdh⟩ : ∃ f : ℝ → ℝ, ∀ s, f s = 2 / 3 * (sc s + ah s * Nz) := ⟨_, fun _ => rfl⟩
  obtain ⟨β, hβ⟩ : ∃ f : ℝ → ℝ, ∀ s, f s = ah s * (Nz + dh s) + 2 * Nw * dh s :=
    ⟨_, fun _ => rfl⟩
  
  have hbound : ∀ᶠ s in nhdsWithin t {t}ᶜ,
      |slope (fun s : ℝ => riccatiAlpha κ (u s)) t s - 2 * ∫ x : ℝ, w x * z x| ≤ β s := by
    filter_upwards [eventually_nhdsWithin_of_eventually_nhds hW] with s hs
    obtain ⟨hWs', hαs⟩ := hs
    have e7 := riccati_sol_L2_lipschitz κ hκ (u s) (u t) (W s) w hWs' hw
    have e8 := riccati_quotient_L2_estimate κ hκ (u s) (u t) v (s - t) (W s) w z hWs' hw hz2 hz
    have e9 := riccati_slope_estimate (s - t) (W s) w z hWs'.1 hw.1 hz2
    rw [← hNz, ← hNw] at e9
    rw [← hNz, ← hsc] at e8
    obtain ⟨a, ha⟩ : ∃ c : ℝ, c = Real.sqrt (∫ x : ℝ, (W s x - w x) ^ 2) := ⟨_, rfl⟩
    obtain ⟨d, hd⟩ : ∃ c : ℝ,
        c = Real.sqrt (∫ x : ℝ, ((s - t)⁻¹ * (W s x - w x) - z x) ^ 2) := ⟨_, rfl⟩
    rw [← ha, ← hd] at e9
    rw [← ha, ← hd] at e8
    have ha0 : 0 ≤ a := by rw [ha]; exact Real.sqrt_nonneg _
    have hd0 : 0 ≤ d := by rw [hd]; exact Real.sqrt_nonneg _
    have hsc0 : 0 ≤ sc s := by rw [hsc]; exact Real.sqrt_nonneg _
    have haa : a ≤ ah s := by
      rw [ha, hah]
      exact Real.sqrt_le_sqrt e7
    have hdd : d ≤ dh s := by
      have h1 : a * Nz ≤ ah s * Nz := mul_le_mul_of_nonneg_right haa hNz0
      rw [hdh]
      linarith
    have hslope : slope (fun s : ℝ => riccatiAlpha κ (u s)) t s =
        ((∫ x : ℝ, W s x ^ 2) - ∫ x : ℝ, w x ^ 2) / (s - t) := by
      rw [slope_def_field, hαs, hαt]
    rw [hslope, hβ]
    refine le_trans e9 ?_
    have h2 : a * (Nz + d) ≤ ah s * (Nz + dh s) :=
      mul_le_mul haa (by linarith) (by positivity) (le_trans ha0 haa)
    have h3 : 2 * Nw * d ≤ 2 * Nw * dh s := mul_le_mul_of_nonneg_left hdd (by positivity)
    linarith
  
  have hB' := hB.mono_left (nhdsWithin_le_nhds (s := {t}ᶜ))
  have hah_t : Filter.Tendsto ah (nhdsWithin t {t}ᶜ) (nhds 0) := by
    have h1 := (hB'.const_mul (4 / 9)).sqrt
    rw [mul_zero, Real.sqrt_zero] at h1
    exact h1.congr (fun s => (hah s).symm)
  have hsc_t : Filter.Tendsto sc (nhdsWithin t {t}ᶜ) (nhds 0) := by
    have h1 := hC.sqrt
    rw [Real.sqrt_zero] at h1
    exact h1.congr (fun s => (hsc s).symm)
  have hdh_t : Filter.Tendsto dh (nhdsWithin t {t}ᶜ) (nhds 0) := by
    have h1 := (hsc_t.add (hah_t.mul_const Nz)).const_mul (2 / 3)
    simp only [zero_mul, add_zero, mul_zero] at h1
    exact h1.congr (fun s => (hdh s).symm)
  have hβ_t : Filter.Tendsto β (nhdsWithin t {t}ᶜ) (nhds 0) := by
    have h1 := (hah_t.mul (tendsto_const_nhds (x := Nz) |>.add hdh_t)).add
      ((tendsto_const_nhds (x := 2 * Nw)).mul hdh_t)
    simp only [zero_mul, add_zero, mul_zero] at h1
    exact h1.congr (fun s => (hβ s).symm)
  
  have hsq : Filter.Tendsto
      (fun s => |slope (fun s : ℝ => riccatiAlpha κ (u s)) t s - 2 * ∫ x : ℝ, w x * z x|)
      (nhdsWithin t {t}ᶜ) (nhds 0) :=
    squeeze_zero' (Filter.Eventually.of_forall fun s => abs_nonneg _) hbound hβ_t
  rw [hasDerivAt_iff_tendsto_slope, tendsto_iff_norm_sub_tendsto_zero]
  simpa only [Real.norm_eq_abs] using hsq

theorem riccati_sol_regularity (κ : ℝ) (hκ : 0 < κ) (q : 𝓢(ℝ, ℝ)) (w : ℝ → ℝ)
    (hw : IsRiccatiSol κ q w) :
    Continuous w ∧ (∃ C : ℝ, ∀ x : ℝ, |w x| ≤ C) ∧
    Filter.Tendsto w Filter.atTop (nhds 0) ∧ Filter.Tendsto w Filter.atBot (nhds 0) ∧
    ∀ x : ℝ, HasDerivAt w (q x + 2 * κ * w x - w x ^ 2) x :=
by
  have h2κ : (0 : ℝ) < 2 * κ := by linarith
  obtain ⟨F, hF⟩ : ∃ F : (ℝ → ℝ) → ℝ → ℝ → ℝ, ∀ f x y,
      F f x y = (Set.Ici x).indicator (fun y => Real.exp (2 * κ * (x - y)) * f y) y :=
    ⟨_, fun _ _ _ => rfl⟩
  
  have hD : ∀ (f : ℝ → ℝ) (x y : ℝ), ‖F f x y‖ ≤ |f y| := by
    intro f x y
    rw [hF]
    by_cases hy : y ∈ Set.Ici x
    · rw [Set.indicator_of_mem hy, norm_mul, Real.norm_eq_abs, Real.norm_eq_abs,
        abs_of_pos (Real.exp_pos _)]
      have hxy : x ≤ y := hy
      have h1 : Real.exp (2 * κ * (x - y)) ≤ 1 := Real.exp_le_one_iff.2 (by nlinarith)
      exact mul_le_of_le_one_left (abs_nonneg _) h1
    · rw [Set.indicator_of_notMem hy, norm_zero]; exact abs_nonneg _
  
  have hM : ∀ (f : ℝ → ℝ), Integrable f (volume : Measure ℝ) → ∀ x : ℝ,
      AEStronglyMeasurable (F f x) (volume : Measure ℝ) := by
    intro f hf x
    have e : F f x = (Set.Ici x).indicator (fun y => Real.exp (2 * κ * (x - y)) * f y) :=
      funext (hF f x)
    rw [e]
    exact ((by fun_prop : Continuous fun y : ℝ => Real.exp (2 * κ * (x - y))).aestronglyMeasurable.mul
      hf.aestronglyMeasurable).indicator measurableSet_Ici
  
  have hR0 : ∀ (f : ℝ → ℝ), riccatiK κ f = fun x => -∫ y, F f x y := by
    intro f
    funext x
    have e : (fun y => F f x y) =
        (Set.Ici x).indicator (fun y => Real.exp (2 * κ * (x - y)) * f y) := funext (hF f x)
    rw [e, integral_indicator measurableSet_Ici]
    rfl
  
  have s1 : ∀ f : ℝ → ℝ, Integrable f (volume : Measure ℝ) →
      (∀ x, |riccatiK κ f x| ≤ ∫ y, |f y|) ∧
      Filter.Tendsto (riccatiK κ f) Filter.atTop (nhds 0) ∧
      Filter.Tendsto (riccatiK κ f) Filter.atBot (nhds 0) := by
    intro f hf
    rw [hR0 f]
    refine ⟨fun x => ?_, ?_, ?_⟩
    · show |-∫ y, F f x y| ≤ ∫ y, |f y|
      rw [abs_neg, ← Real.norm_eq_abs]
      exact norm_integral_le_of_norm_le hf.abs (Filter.Eventually.of_forall (hD f x))
    · have hlim : ∀ y : ℝ, Filter.Tendsto (fun x => F f x y) Filter.atTop (nhds 0) := by
        intro y
        apply tendsto_const_nhds.congr'
        filter_upwards [Filter.eventually_gt_atTop y] with x hx
        rw [hF, Set.indicator_of_notMem (by simp only [Set.mem_Ici, not_le]; exact hx)]
      have h := tendsto_integral_filter_of_dominated_convergence (fun y => |f y|)
        (l := Filter.atTop) (F := fun x y => F f x y) (f := fun _ => (0 : ℝ))
        (Filter.Eventually.of_forall (hM f hf))
        (Filter.Eventually.of_forall fun x => Filter.Eventually.of_forall (hD f x)) hf.abs
        (Filter.Eventually.of_forall hlim)
      have h2 := h.neg
      simp only [integral_zero, neg_zero] at h2
      exact h2
    · have hlim : ∀ y : ℝ, Filter.Tendsto (fun x => F f x y) Filter.atBot (nhds 0) := by
        intro y
        have h1 : Filter.Tendsto (fun x : ℝ => 2 * κ * (x - y)) Filter.atBot Filter.atBot := by
          have h0 : Filter.Tendsto (fun x : ℝ => x + -y) Filter.atBot Filter.atBot :=
            Filter.tendsto_atBot_add_const_right _ (-y) Filter.tendsto_id
          refine Filter.Tendsto.congr (fun x => ?_) (h0.const_mul_atBot h2κ)
          ring
        have h3 := (Real.tendsto_exp_atBot.comp h1).mul_const (f y)
        rw [zero_mul] at h3
        apply h3.congr'
        filter_upwards [Filter.eventually_le_atBot y] with x hx
        rw [hF, Set.indicator_of_mem (show y ∈ Set.Ici x from hx)]
        rfl
      have h := tendsto_integral_filter_of_dominated_convergence (fun y => |f y|)
        (l := Filter.atBot) (F := fun x y => F f x y) (f := fun _ => (0 : ℝ))
        (Filter.Eventually.of_forall (hM f hf))
        (Filter.Eventually.of_forall fun x => Filter.Eventually.of_forall (hD f x)) hf.abs
        (Filter.Eventually.of_forall hlim)
      have h2 := h.neg
      simp only [integral_zero, neg_zero] at h2
      exact h2
  
  have s2 : ∀ f : ℝ → ℝ, Integrable f (volume : Measure ℝ) → Continuous (riccatiK κ f) := by
    intro f hf
    rw [hR0 f]
    refine Continuous.neg (continuous_iff_continuousAt.2 fun x₀ => ?_)
    refine continuousAt_of_dominated (bound := fun y => |f y|)
      (Filter.Eventually.of_forall (hM f hf))
      (Filter.Eventually.of_forall fun x => Filter.Eventually.of_forall (hD f x)) hf.abs ?_
    filter_upwards [Measure.ae_ne volume x₀] with y hy
    rcases lt_or_gt_of_ne hy with h | h
    · apply (continuousAt_const (y := (0 : ℝ))).congr
      filter_upwards [Ioi_mem_nhds h] with x hx
      rw [hF, Set.indicator_of_notMem (by simp only [Set.mem_Ici, not_le]; exact hx)]
    · apply (show Continuous fun x => Real.exp (2 * κ * (x - y)) * f y by fun_prop).continuousAt.congr
      filter_upwards [Iio_mem_nhds h] with x hx
      rw [hF, Set.indicator_of_mem (show y ∈ Set.Ici x from le_of_lt (show x < y from hx))]
  
  have s3 : ∀ f : ℝ → ℝ, Integrable f (volume : Measure ℝ) → Continuous f → ∀ x₀ : ℝ,
      HasDerivAt (riccatiK κ f) (2 * κ * riccatiK κ f x₀ + f x₀) x₀ := by
    intro f hf hfc x₀
    obtain ⟨a, ha⟩ : ∃ a : ℝ, a = x₀ - 1 := ⟨_, rfl⟩
    have hax₀ : a < x₀ := by rw [ha]; linarith
    obtain ⟨g, hg⟩ : ∃ g : ℝ → ℝ, ∀ y, g y = Real.exp (-(2 * κ) * y) * f y :=
      ⟨_, fun _ => rfl⟩
    have hge : g = fun y => Real.exp (-(2 * κ) * y) * f y := funext hg
    have hgc : Continuous g := by rw [hge]; fun_prop
    have hgi : IntegrableOn g (Set.Ioi a) := by
      rw [hge]
      refine Integrable.bdd_mul (c := Real.exp (-(2 * κ) * a)) hf.integrableOn ?_ ?_
      · exact (by fun_prop : Continuous fun y : ℝ => Real.exp (-(2 * κ) * y)).aestronglyMeasurable
      · refine (ae_restrict_iff' measurableSet_Ioi).2 (Filter.Eventually.of_forall fun y hy => ?_)
        have hay : a < y := hy
        show ‖Real.exp (-(2 * κ) * y)‖ ≤ Real.exp (-(2 * κ) * a)
        rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
        exact Real.exp_le_exp.2 (by nlinarith)
    have hsplit : ∀ x, riccatiK κ f x = -(Real.exp (2 * κ * x) * ∫ y in Set.Ioi x, g y) := by
      intro x
      show -∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * f y = _
      rw [integral_Ici_eq_integral_Ioi, ← integral_const_mul]
      refine congrArg Neg.neg (congrArg (integral _) (funext fun y => ?_))
      rw [hg y, ← mul_assoc, ← Real.exp_add]
      rw [show 2 * κ * x + -(2 * κ) * y = 2 * κ * (x - y) by ring]
    have hhalf : ∀ x, a ≤ x →
        ∫ y in Set.Ioi x, g y = (∫ y in Set.Ioi a, g y) - ∫ y in a..x, g y := by
      intro x hax
      rw [intervalIntegral.integral_of_le hax, ← Set.Ioc_union_Ioi_eq_Ioi hax,
        setIntegral_union (Set.Ioc_disjoint_Ioi le_rfl) measurableSet_Ioi
          (hgi.mono_set Set.Ioc_subset_Ioi_self) (hgi.mono_set (Set.Ioi_subset_Ioi hax))]
      ring
    have hP : HasDerivAt (fun x => ∫ y in a..x, g y) (g x₀) x₀ :=
      intervalIntegral.integral_hasDerivAt_right (hgc.intervalIntegrable a x₀)
        (hgc.stronglyMeasurableAtFilter volume (nhds x₀)) hgc.continuousAt
    have hE := ((hasDerivAt_id' x₀).const_mul (2 * κ)).exp
    have hR := (hE.mul ((hasDerivAt_const x₀ (∫ y in Set.Ioi a, g y)).sub hP)).neg
    have hev : riccatiK κ f =ᶠ[nhds x₀] fun x =>
        -(Real.exp (2 * κ * x) * ((∫ y in Set.Ioi a, g y) - ∫ y in a..x, g y)) := by
      filter_upwards [Ioi_mem_nhds hax₀] with x hx
      rw [hsplit x, hhalf x (le_of_lt hx)]
    have hR' := hR.congr_of_eventuallyEq hev
    refine hR'.congr_deriv ?_
    have he : Real.exp (2 * κ * x₀) * Real.exp (-(2 * κ) * x₀) = 1 := by
      rw [← Real.exp_add, show 2 * κ * x₀ + -(2 * κ) * x₀ = 0 by ring, Real.exp_zero]
    rw [hsplit x₀, hhalf x₀ hax₀.le, hg x₀]
    simp only [Pi.sub_apply]
    linear_combination (f x₀) * he
  
  have hq : Integrable (⇑q) (volume : Measure ℝ) := q.integrable
  have hw2 : Integrable (fun y => w y ^ 2) (volume : Measure ℝ) := hw.1.integrable_sq
  have hwx := hw.2.2
  have hwe : w = fun x => riccatiK κ q x - riccatiK κ (fun y => w y ^ 2) x := funext hwx
  obtain ⟨bq, tq1, tq2⟩ := s1 q hq
  obtain ⟨bw, tw1, tw2⟩ := s1 _ hw2
  have hwc : Continuous w := by rw [hwe]; exact (s2 q hq).sub (s2 _ hw2)
  refine ⟨hwc, ⟨(∫ y, |q y|) + ∫ y, |w y ^ 2|, fun x => ?_⟩, ?_, ?_, fun x => ?_⟩
  · rw [hwx x]; exact (abs_sub _ _).trans (add_le_add (bq x) (bw x))
  · have h := tq1.sub tw1
    rw [sub_zero] at h
    rw [hwe]; exact h
  · have h := tq2.sub tw2
    rw [sub_zero] at h
    rw [hwe]; exact h
  · have hA := s3 q hq q.continuous x
    have hB := s3 _ hw2 (hwc.pow 2) x
    have h := (hA.sub hB).congr_of_eventuallyEq (Filter.Eventually.of_forall hwx)
    refine h.congr_deriv ?_
    linear_combination (-(2 * κ)) * hwx x

theorem riccati_linear_unique (κ : ℝ) (hκ : 1 ≤ κ) (w f z₁ z₂ : ℝ → ℝ)
    (hw : MemLp w 2 (volume : Measure ℝ)) (hw16 : ∫ x : ℝ, w x ^ 2 ≤ 1 / 16)
    (h₁ : MemLp z₁ 2 (volume : Measure ℝ)) (h₂ : MemLp z₂ 2 (volume : Measure ℝ))
    (hz₁ : ∀ x : ℝ, z₁ x = riccatiK κ f x - riccatiK κ (fun y => 2 * w y * z₁ y) x)
    (hz₂ : ∀ x : ℝ, z₂ x = riccatiK κ f x - riccatiK κ (fun y => 2 * w y * z₂ y) x) :
    z₁ =ᵐ[volume] z₂ :=
by
  have hκ0 : (0 : ℝ) < κ := by linarith
  
  have hKsub : ∀ (f g : ℝ → ℝ), Integrable f (volume : Measure ℝ) →
      Integrable g (volume : Measure ℝ) → ∀ x : ℝ,
      riccatiK κ (fun y => f y - g y) x = riccatiK κ f x - riccatiK κ g x := by
    have hwt : ∀ (x : ℝ) (h : ℝ → ℝ), Integrable h (volume : Measure ℝ) →
        IntegrableOn (fun y => Real.exp (2 * κ * (x - y)) * h y) (Set.Ici x) := by
      intro x h hh
      refine Integrable.bdd_mul (c := 1) hh.integrableOn ?_ ?_
      · exact (by fun_prop : Continuous fun y : ℝ =>
          Real.exp (2 * κ * (x - y))).aestronglyMeasurable
      · refine (ae_restrict_iff' measurableSet_Ici).2 (Filter.Eventually.of_forall fun y hy => ?_)
        have hxy : x ≤ y := hy
        show ‖Real.exp (2 * κ * (x - y))‖ ≤ 1
        rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), Real.exp_le_one_iff]
        nlinarith
    intro f g hf hg x
    show -∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * (f y - g y) =
      (-∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * f y) -
        -∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * g y
    have e : (fun y => Real.exp (2 * κ * (x - y)) * (f y - g y)) =
        fun y => Real.exp (2 * κ * (x - y)) * f y - Real.exp (2 * κ * (x - y)) * g y := by
      funext y; ring
    rw [e, integral_sub (hwt x f hf) (hwt x g hg)]
    ring
  
  have mulb : ∀ (g h : ℝ → ℝ), MemLp g 2 (volume : Measure ℝ) →
      MemLp h 2 (volume : Measure ℝ) →
      ∫ x : ℝ, riccatiK κ (fun y => g y * h y) x ^ 2 ≤
        1 / 4 * ((∫ y : ℝ, g y ^ 2) * (∫ y : ℝ, h y ^ 2)) := by
    intro g h hg hh
    have CS : ∀ (μ : Measure ℝ) (u v : ℝ → ℝ), MemLp u 2 μ → MemLp v 2 μ →
        (∫ a, u a * v a ∂μ) ^ 2 ≤ (∫ a, u a ^ 2 ∂μ) * (∫ a, v a ^ 2 ∂μ) := by
      intro μ u v hu hv
      have hA := hu.integrable_sq
      have hB := hv.integrable_sq
      have hC : Integrable (fun a => u a * v a) μ := hu.integrable_mul hv
      have key : ∀ t : ℝ, 0 ≤ (∫ a, u a ^ 2 ∂μ) * (t * t) + (2 * ∫ a, u a * v a ∂μ) * t +
          ∫ a, v a ^ 2 ∂μ := by
        intro t
        have h0 : 0 ≤ ∫ a, (t * u a + v a) ^ 2 ∂μ := integral_nonneg (fun a => sq_nonneg _)
        have heq : (fun a => (t * u a + v a) ^ 2) =
            fun a => (t * t) * u a ^ 2 + ((2 * t) * (u a * v a) + v a ^ 2) := by
          funext a; ring
        have i1 : Integrable (fun a => (t * t) * u a ^ 2) μ := hA.const_mul _
        have i2 : Integrable (fun a => (2 * t) * (u a * v a)) μ := hC.const_mul _
        have i23 : Integrable (fun a => (2 * t) * (u a * v a) + v a ^ 2) μ := i2.add hB
        rw [heq, integral_add i1 i23, integral_add i2 hB, integral_const_mul,
          integral_const_mul] at h0
        nlinarith
      have hd := discrim_le_zero key
      unfold discrim at hd
      nlinarith
    have hS : MeasurableSet {p : ℝ × ℝ | p.1 ≤ p.2} :=
      measurableSet_le measurable_fst measurable_snd
    have hident : ∀ (c : ℝ) (φ : ℝ → ℝ) (x : ℝ),
        ∫ y in Set.Ici x, Real.exp (c * (x - y)) * φ y =
          ∫ y, ({p : ℝ × ℝ | p.1 ≤ p.2}.indicator
            (fun p => Real.exp (c * (p.1 - p.2)) * φ p.2)) (x, y) := by
      intro c φ x
      rw [← integral_indicator measurableSet_Ici]
      congr 1
    have hFmeas : ∀ (c : ℝ) (φ : ℝ → ℝ), AEStronglyMeasurable φ volume →
        AEStronglyMeasurable ({p : ℝ × ℝ | p.1 ≤ p.2}.indicator
          (fun p => Real.exp (c * (p.1 - p.2)) * φ p.2)) ((volume : Measure ℝ).prod volume) := by
      intro c φ hφ
      refine AEStronglyMeasurable.indicator ?_ hS
      have h1 : Continuous fun p : ℝ × ℝ => Real.exp (c * (p.1 - p.2)) := by fun_prop
      exact h1.aestronglyMeasurable.mul hφ.comp_snd
    have hmeas : AEStronglyMeasurable (riccatiK κ (fun y => g y * h y)) volume := by
      have h1 := (hFmeas (2 * κ) (fun y => g y * h y) (hg.1.mul hh.1)).integral_prod_right'
      have h2 : riccatiK κ (fun y => g y * h y) = fun x => -∫ y, ({p : ℝ × ℝ | p.1 ≤ p.2}.indicator
            (fun p => Real.exp (2 * κ * (p.1 - p.2)) * (g p.2 * h p.2))) (x, y) := by
        funext x
        unfold riccatiK
        rw [hident (2 * κ) (fun y => g y * h y) x]
      rw [h2]
      exact h1.neg
    have hpt : ∀ x, riccatiK κ (fun y => g y * h y) x ^ 2 ≤
        (∫ y, g y ^ 2) * ∫ y in Set.Ici x, Real.exp (4 * κ * (x - y)) * h y ^ 2 := by
      intro x
      have hv : MemLp (fun y => Real.exp (2 * κ * (x - y)) * h y) 2
          ((volume : Measure ℝ).restrict (Set.Ici x)) := by
        refine MemLp.of_le (hh.restrict _) ?_ ?_
        · have hc : Continuous fun y : ℝ => Real.exp (2 * κ * (x - y)) := by fun_prop
          exact hc.aestronglyMeasurable.mul hh.1.restrict
        · refine ae_restrict_of_forall_mem measurableSet_Ici (fun y hy => ?_)
          have hy' : x ≤ y := hy
          have hle : Real.exp (2 * κ * (x - y)) ≤ 1 := Real.exp_le_one_iff.2 (by nlinarith)
          rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_of_pos (Real.exp_pos _)]
          exact mul_le_of_le_one_left (abs_nonneg _) hle
      have hcs := CS _ g (fun y => Real.exp (2 * κ * (x - y)) * h y) (hg.restrict _) hv
      have e1 : riccatiK κ (fun y => g y * h y) x ^ 2 =
          (∫ y in Set.Ici x, g y * (Real.exp (2 * κ * (x - y)) * h y)) ^ 2 := by
        have hfun : (fun y => Real.exp (2 * κ * (x - y)) * (g y * h y)) =
            fun y => g y * (Real.exp (2 * κ * (x - y)) * h y) := by
          funext y; ring
        show (-∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * (g y * h y)) ^ 2 = _
        rw [neg_sq, hfun]
      have e2 : ∫ y in Set.Ici x, (Real.exp (2 * κ * (x - y)) * h y) ^ 2 =
          ∫ y in Set.Ici x, Real.exp (4 * κ * (x - y)) * h y ^ 2 := by
        congr 1
        funext y
        have hexp : 2 * κ * (x - y) + 2 * κ * (x - y) = 4 * κ * (x - y) := by ring
        rw [mul_pow, sq (Real.exp _), ← Real.exp_add, hexp]
      have e3 : ∫ y in Set.Ici x, g y ^ 2 ≤ ∫ y, g y ^ 2 :=
        setIntegral_le_integral hg.integrable_sq
          (Filter.Eventually.of_forall fun y => sq_nonneg (g y))
      have e4 : 0 ≤ ∫ y in Set.Ici x, Real.exp (4 * κ * (x - y)) * h y ^ 2 :=
        integral_nonneg (fun y => mul_nonneg (Real.exp_pos _).le (sq_nonneg _))
      rw [e1]
      rw [e2] at hcs
      exact le_trans hcs (mul_le_mul_of_nonneg_right e3 e4)
    have h4κ : (0 : ℝ) < 4 * κ := by linarith
    obtain ⟨F, hF⟩ : ∃ F : ℝ × ℝ → ℝ, F = {p : ℝ × ℝ | p.1 ≤ p.2}.indicator
        (fun p => Real.exp (4 * κ * (p.1 - p.2)) * h p.2 ^ 2) := ⟨_, rfl⟩
    have hFnn : ∀ p, 0 ≤ F p := by
      intro p
      rw [hF]
      exact Set.indicator_nonneg (fun p _ => mul_nonneg (Real.exp_pos _).le (sq_nonneg _)) p
    have hFm : AEStronglyMeasurable F ((volume : Measure ℝ).prod volume) := by
      rw [hF]
      exact hFmeas (4 * κ) (fun y => h y ^ 2) (hh.1.pow 2)
    have hslice_pt : ∀ x y : ℝ, F (x, y) = (Set.Iic y).indicator
        (fun x => Real.exp (4 * κ * x) * (Real.exp (-(4 * κ * y)) * h y ^ 2)) x := by
      intro x y
      rw [hF]
      by_cases hxy : x ≤ y
      · have h1 : (x, y) ∈ {p : ℝ × ℝ | p.1 ≤ p.2} := hxy
        have h2 : x ∈ Set.Iic y := hxy
        rw [Set.indicator_of_mem h1, Set.indicator_of_mem h2]
        show Real.exp (4 * κ * (x - y)) * h y ^ 2 =
          Real.exp (4 * κ * x) * (Real.exp (-(4 * κ * y)) * h y ^ 2)
        rw [← mul_assoc, ← Real.exp_add]
        congr 2
        ring
      · have h1 : (x, y) ∉ {p : ℝ × ℝ | p.1 ≤ p.2} := hxy
        have h2 : x ∉ Set.Iic y := hxy
        rw [Set.indicator_of_notMem h1, Set.indicator_of_notMem h2]
    have hslice_int : ∀ y : ℝ, Integrable (fun x => F (x, y)) volume := by
      intro y
      have he : (fun x => F (x, y)) = (Set.Iic y).indicator
          (fun x => Real.exp (4 * κ * x) * (Real.exp (-(4 * κ * y)) * h y ^ 2)) :=
        funext fun x => hslice_pt x y
      rw [he]
      have hon : IntegrableOn
          (fun x => Real.exp (4 * κ * x) * (Real.exp (-(4 * κ * y)) * h y ^ 2)) (Set.Iic y) :=
        Integrable.mul_const (integrableOn_exp_mul_Iic h4κ y) _
      exact hon.integrable_indicator measurableSet_Iic
    have hslice_val : ∀ y : ℝ, ∫ x, F (x, y) = 1 / (4 * κ) * h y ^ 2 := by
      intro y
      have he : (fun x => F (x, y)) = (Set.Iic y).indicator
          (fun x => Real.exp (4 * κ * x) * (Real.exp (-(4 * κ * y)) * h y ^ 2)) :=
        funext fun x => hslice_pt x y
      rw [he, integral_indicator measurableSet_Iic, integral_mul_const,
        integral_exp_mul_Iic h4κ y, Real.exp_neg]
      field_simp
    have hFint : Integrable F ((volume : Measure ℝ).prod volume) := by
      rw [integrable_prod_iff' hFm]
      refine ⟨Filter.Eventually.of_forall hslice_int, ?_⟩
      have he : (fun y => ∫ x, ‖F (x, y)‖) = fun y => 1 / (4 * κ) * h y ^ 2 := by
        funext y
        have hn : (fun x => ‖F (x, y)‖) = fun x => F (x, y) :=
          funext fun x => Real.norm_of_nonneg (hFnn _)
        rw [hn, hslice_val]
      rw [he]
      exact hh.integrable_sq.const_mul _
    have hHeq : (fun x => ∫ y in Set.Ici x, Real.exp (4 * κ * (x - y)) * h y ^ 2) =
        fun x => ∫ y, F (x, y) := by
      funext x
      rw [hident (4 * κ) (fun y => h y ^ 2) x, hF]
    have hHint : Integrable (fun x => ∫ y in Set.Ici x, Real.exp (4 * κ * (x - y)) * h y ^ 2)
        volume := by
      rw [hHeq]
      exact hFint.integral_prod_left
    have hHval : ∫ x, (∫ y in Set.Ici x, Real.exp (4 * κ * (x - y)) * h y ^ 2) =
        1 / (4 * κ) * ∫ y, h y ^ 2 := by
      rw [hHeq, ← integral_prod F hFint, integral_prod_symm F hFint]
      simp_rw [hslice_val]
      rw [integral_const_mul]
    have hG : 0 ≤ ∫ y, g y ^ 2 := integral_nonneg (fun y => sq_nonneg _)
    have hHh : 0 ≤ ∫ y, h y ^ 2 := integral_nonneg (fun y => sq_nonneg _)
    have hint : Integrable (fun x => riccatiK κ (fun y => g y * h y) x ^ 2) volume := by
      refine (hHint.const_mul (∫ y, g y ^ 2)).mono'
        ((continuous_pow 2).comp_aestronglyMeasurable hmeas)
        (Filter.Eventually.of_forall fun x => ?_)
      rw [Real.norm_of_nonneg (sq_nonneg _)]
      exact hpt x
    have hmono := integral_mono hint (hHint.const_mul (∫ y, g y ^ 2)) hpt
    rw [integral_const_mul, hHval] at hmono
    have hk : 1 / (4 * κ) ≤ 1 / 4 := by
      rw [div_le_div_iff₀ h4κ (by norm_num)]
      linarith
    have := mul_le_mul_of_nonneg_right hk (mul_nonneg hG hHh)
    nlinarith
  have I₁ : Integrable (fun y => 2 * w y * z₁ y) (volume : Measure ℝ) := by
    have h := (hw.integrable_mul h₁).const_mul 2
    refine h.congr (Filter.Eventually.of_forall fun y => ?_)
    simp only [Pi.mul_apply]; ring
  have I₂ : Integrable (fun y => 2 * w y * z₂ y) (volume : Measure ℝ) := by
    have h := (hw.integrable_mul h₂).const_mul 2
    refine h.congr (Filter.Eventually.of_forall fun y => ?_)
    simp only [Pi.mul_apply]; ring
  have hd : ∀ x, z₁ x - z₂ x = riccatiK κ (fun y => 2 * w y * (z₂ y - z₁ y)) x := by
    intro x
    have hs := hKsub (fun y => 2 * w y * z₂ y)
      (fun y => 2 * w y * z₁ y) I₂ I₁ x
    have e : (fun y => 2 * w y * (z₂ y - z₁ y)) =
        (fun y => 2 * w y * z₂ y - 2 * w y * z₁ y) := by
      funext y; ring
    rw [e, hs, hz₁ x, hz₂ x]
    ring
  have hg : MemLp (fun y => 2 * w y) 2 (volume : Measure ℝ) := hw.const_mul 2
  have hh : MemLp (fun y => z₂ y - z₁ y) 2 (volume : Measure ℝ) := h₂.sub h₁
  have hb := mulb (fun y => 2 * w y) (fun y => z₂ y - z₁ y) hg hh
  have e1 : (fun x => riccatiK κ (fun y => 2 * w y * (z₂ y - z₁ y)) x ^ 2) =
      fun x => (z₁ x - z₂ x) ^ 2 := by
    funext x; rw [← hd x]
  have e2 : (∫ y : ℝ, (2 * w y) ^ 2) = 4 * ∫ y : ℝ, w y ^ 2 := by
    have : (fun y : ℝ => (2 * w y) ^ 2) = fun y => 4 * w y ^ 2 := by
      funext y; ring
    rw [this, integral_const_mul]
  have e3 : (∫ y : ℝ, (z₂ y - z₁ y) ^ 2) = ∫ y : ℝ, (z₁ y - z₂ y) ^ 2 := by
    congr 1; funext y; ring
  simp only [] at hb
  rw [e1, e2, e3] at hb
  have hD0 : 0 ≤ ∫ x : ℝ, (z₁ x - z₂ x) ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  have hA0 : 0 ≤ ∫ x : ℝ, w x ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  have hprod := mul_le_mul_of_nonneg_right hw16 hD0
  have hD : ∫ x : ℝ, (z₁ x - z₂ x) ^ 2 = 0 := by nlinarith
  have hint : Integrable (fun x => (z₁ x - z₂ x) ^ 2) (volume : Measure ℝ) :=
    (h₁.sub h₂).integrable_sq
  have hae := (integral_eq_zero_iff_of_nonneg (fun x => sq_nonneg (z₁ x - z₂ x)) hint).1 hD
  filter_upwards [hae] with x hx
  have hx' : (z₁ x - z₂ x) ^ 2 = 0 := hx
  have := pow_eq_zero_iff (n := 2) two_ne_zero |>.1 hx'
  linarith

theorem riccati_kdv_orthogonal (κ : ℝ) (hκ : 1 ≤ κ) (q : 𝓢(ℝ, ℝ)) (w z : ℝ → ℝ)
    (hw : IsRiccatiSol κ q w) (hz2 : MemLp z 2 (volume : Measure ℝ))
    (hz : ∀ x : ℝ, z x = riccatiK κ (kdvRHS q) x - riccatiK κ (fun y => 2 * w y * z y) x) :
    ∫ x : ℝ, w x * z x = 0 :=
by
  have hκ0 : (0 : ℝ) < κ := by linarith
  have h2κ : (0 : ℝ) < 2 * κ := by linarith
  
  have hwt : ∀ (x : ℝ) (h : ℝ → ℝ), Integrable h (volume : Measure ℝ) →
      IntegrableOn (fun y => Real.exp (2 * κ * (x - y)) * h y) (Set.Ici x) := by
    intro x h hh
    refine Integrable.bdd_mul (c := 1) hh.integrableOn ?_ ?_
    · exact (by fun_prop : Continuous fun y : ℝ => Real.exp (2 * κ * (x - y))).aestronglyMeasurable
    · refine (ae_restrict_iff' measurableSet_Ici).2 (Filter.Eventually.of_forall fun y hy => ?_)
      have hxy : x ≤ y := hy
      show ‖Real.exp (2 * κ * (x - y))‖ ≤ 1
      rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), Real.exp_le_one_iff]
      nlinarith
  have hKsub : ∀ (f g : ℝ → ℝ), Integrable f (volume : Measure ℝ) →
      Integrable g (volume : Measure ℝ) → ∀ x : ℝ,
      riccatiK κ (fun y => f y - g y) x = riccatiK κ f x - riccatiK κ g x := by
    intro f g hf hg x
    show -∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * (f y - g y) =
      (-∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * f y) -
        -∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * g y
    have e : (fun y => Real.exp (2 * κ * (x - y)) * (f y - g y)) =
        fun y => Real.exp (2 * κ * (x - y)) * f y - Real.exp (2 * κ * (x - y)) * g y := by
      funext y; ring
    rw [e, integral_sub (hwt x f hf) (hwt x g hg)]
    ring
  
  have hderS : ∀ (p : 𝓢(ℝ, ℝ)) (x : ℝ), HasDerivAt (⇑p) (SchwartzMap.derivCLM ℝ ℝ p x) x := by
    intro p x
    rw [SchwartzMap.derivCLM_apply]
    exact p.differentiableAt.hasDerivAt
  have hderS' : ∀ p : 𝓢(ℝ, ℝ), deriv (⇑p) = ⇑(SchwartzMap.derivCLM ℝ ℝ p) := by
    intro p; funext x; rw [SchwartzMap.derivCLM_apply]
  obtain ⟨q1, hq1⟩ : ∃ q1 : 𝓢(ℝ, ℝ), q1 = SchwartzMap.derivCLM ℝ ℝ q := ⟨_, rfl⟩
  obtain ⟨q2, hq2⟩ : ∃ q2 : 𝓢(ℝ, ℝ), q2 = SchwartzMap.derivCLM ℝ ℝ q1 := ⟨_, rfl⟩
  obtain ⟨q3, hq3⟩ : ∃ q3 : 𝓢(ℝ, ℝ), q3 = SchwartzMap.derivCLM ℝ ℝ q2 := ⟨_, rfl⟩
  have hd0 : ∀ x, HasDerivAt (⇑q) (q1 x) x := by intro x; rw [hq1]; exact hderS q x
  have hd1 : ∀ x, HasDerivAt (⇑q1) (q2 x) x := by intro x; rw [hq2]; exact hderS q1 x
  have hd2 : ∀ x, HasDerivAt (⇑q2) (q3 x) x := by intro x; rw [hq3]; exact hderS q2 x
  have hX : ∀ x, kdvRHS q x = -q3 x + 6 * q x * q1 x := by
    intro x
    have e3 : iteratedDeriv 3 (⇑q) = ⇑q3 := by
      rw [iteratedDeriv_succ, iteratedDeriv_succ, iteratedDeriv_one, hderS', ← hq1, hderS', ← hq2,
        hderS', ← hq3]
    unfold kdvRHS
    rw [e3, hderS', ← hq1]
  have hXint : Integrable (kdvRHS q) (volume : Measure ℝ) := by
    have h := (q3.integrable (μ := volume)).neg.add
      ((Integrable.bdd_mul (c := SchwartzMap.seminorm ℝ 0 0 q) (q1.integrable (μ := volume))
        q.continuous.aestronglyMeasurable
        (Filter.Eventually.of_forall fun x => SchwartzMap.norm_le_seminorm ℝ q x)).const_mul 6)
    refine h.congr (Filter.Eventually.of_forall fun x => ?_)
    simp only [Pi.add_apply, Pi.neg_apply]
    rw [hX x]; ring
  
  have hS : ∀ p : 𝓢(ℝ, ℝ), Continuous (⇑p) ∧ (∀ x, |p x| ≤ SchwartzMap.seminorm ℝ 0 0 p) ∧
      MemLp (⇑p) 2 (volume : Measure ℝ) ∧ Filter.Tendsto (⇑p) Filter.atTop (nhds 0) ∧
      Filter.Tendsto (⇑p) Filter.atBot (nhds 0) := by
    intro p
    have hc : Filter.Tendsto (⇑p) (Filter.cocompact ℝ) (nhds 0) := by
      have h := p.toZeroAtInfty.zero_at_infty'
      first
        | exact h
        | (convert h using 1; funext x; exact (SchwartzMap.toZeroAtInfty_apply p x).symm)
    rw [cocompact_eq_atBot_atTop] at hc
    refine ⟨p.continuous, fun x => ?_, p.memLp 2, hc.mono_left le_sup_right,
      hc.mono_left le_sup_left⟩
    rw [← Real.norm_eq_abs]
    exact SchwartzMap.norm_le_seminorm ℝ p x
  
  obtain ⟨hwc, ⟨Cw, hCw⟩, hwtop, hwbot, hwd⟩ := riccati_sol_regularity κ hκ0 q w hw
  obtain ⟨hc0, hb0, hm0, ht0, hl0⟩ := hS q
  obtain ⟨hc1, hb1, hm1, ht1, hl1⟩ := hS q1
  obtain ⟨hc2, hb2, hm2, ht2, hl2⟩ := hS q2
  obtain ⟨hc3, hb3, hm3, ht3, hl3⟩ := hS q3
  have hw2 : MemLp w 2 (volume : Measure ℝ) := hw.1
  
  obtain ⟨φ, hφ⟩ : ∃ φ : ℝ → ℝ, ∀ y, φ y = -q2 y + 2 * q1 y * (w y - κ) +
      (2 * q y - 4 * κ ^ 2) * (q y + 2 * κ * w y - w y ^ 2) := ⟨_, fun _ => rfl⟩
  obtain ⟨ψ, hψ⟩ : ∃ ψ : ℝ → ℝ, ∀ y,
      ψ y = -q3 y + 6 * q y * q1 y + 2 * κ * φ y - 2 * w y * φ y := ⟨_, fun _ => rfl⟩
  obtain ⟨H, hH⟩ : ∃ H : ℝ → ℝ, ∀ y, H y = -q2 y + 3 * q y ^ 2 +
      2 * κ * (-q1 y + (2 * q y - 4 * κ ^ 2) * (w y - κ)) - φ y := ⟨_, fun _ => rfl⟩
  
  have hφd : ∀ x, HasDerivAt φ (ψ x) x := by
    intro x
    have h := ((hd2 x).neg.add (((hd1 x).const_mul 2).mul ((hwd x).sub_const κ))).add
      ((((hd0 x).const_mul 2).sub_const (4 * κ ^ 2)).mul
        (((hd0 x).add ((hwd x).const_mul (2 * κ))).sub ((hwd x).mul (hwd x))))
    convert h using 1
    · funext y
      simp only [hφ, Pi.add_apply, Pi.sub_apply, Pi.mul_apply, Pi.neg_apply]; ring
    · simp only [hψ, hφ, Pi.add_apply, Pi.sub_apply, Pi.mul_apply, Pi.neg_apply]; ring
  have hHd : ∀ x, HasDerivAt H (2 * w x * φ x) x := by
    intro x
    have h := (((hd2 x).neg.add (((hd0 x).mul (hd0 x)).const_mul 3)).add
      (((hd1 x).neg.add ((((hd0 x).const_mul 2).sub_const (4 * κ ^ 2)).mul
        ((hwd x).sub_const κ))).const_mul (2 * κ))).sub (hφd x)
    convert h using 1
    · funext y
      simp only [hH, Pi.add_apply, Pi.sub_apply, Pi.mul_apply, Pi.neg_apply]; ring
    · simp only [hψ, hφ, Pi.add_apply, Pi.sub_apply, Pi.mul_apply, Pi.neg_apply]; ring
  
  have hφc : Continuous φ := continuous_iff_continuousAt.2 fun x => (hφd x).continuousAt
  have hψc : Continuous ψ := by
    have e : ψ = fun y => -q3 y + 6 * q y * q1 y + 2 * κ * φ y - 2 * w y * φ y := funext hψ
    rw [e]; fun_prop
  have hlim : ∀ l : Filter ℝ, Filter.Tendsto (⇑q) l (nhds 0) → Filter.Tendsto (⇑q1) l (nhds 0) →
      Filter.Tendsto (⇑q2) l (nhds 0) → Filter.Tendsto (⇑q3) l (nhds 0) →
      Filter.Tendsto w l (nhds 0) →
      Filter.Tendsto φ l (nhds 0) ∧ Filter.Tendsto ψ l (nhds 0) ∧
      Filter.Tendsto H l (nhds (8 * κ ^ 4)) := by
    intro l t0 t1 t2 t3 tw
    have tφ : Filter.Tendsto φ l (nhds 0) := by
      have h := (t2.neg.add ((t1.const_mul 2).mul (tw.sub_const κ))).add
        (((t0.const_mul 2).sub_const (4 * κ ^ 2)).mul
          ((t0.add (tw.const_mul (2 * κ))).sub (tw.mul tw)))
      convert h using 1
      · funext y; simp only [hφ]; ring
      · congr 1; ring
    have tψ : Filter.Tendsto ψ l (nhds 0) := by
      have h := ((t3.neg.add ((t0.const_mul 6).mul t1)).add (tφ.const_mul (2 * κ))).sub
        ((tw.const_mul 2).mul tφ)
      convert h using 1
      · funext y; simp only [hψ]
      · congr 1; ring
    refine ⟨tφ, tψ, ?_⟩
    have h := ((t2.neg.add ((t0.mul t0).const_mul 3)).add
      ((t1.neg.add (((t0.const_mul 2).sub_const (4 * κ ^ 2)).mul (tw.sub_const κ))).const_mul
        (2 * κ))).sub tφ
    convert h using 1
    · funext y; simp only [hH]; ring
    · congr 1; ring
  have bdd0 : ∀ f : ℝ → ℝ, Continuous f → Filter.Tendsto f Filter.atTop (nhds 0) →
      Filter.Tendsto f Filter.atBot (nhds 0) → ∃ C, ∀ x, |f x| ≤ C := by
    intro f hf ht hb
    let F : ZeroAtInftyContinuousMap ℝ ℝ :=
      ⟨⟨f, hf⟩, by rw [cocompact_eq_atBot_atTop]; exact hb.sup ht⟩
    refine ⟨‖F.toBCF‖, fun x => ?_⟩
    have := F.toBCF.norm_coe_le_norm x
