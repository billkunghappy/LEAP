        c * ∫ ξ : ℝ, ((4 + ξ ^ 2) / (ξ ^ 2 + 4 * κ ^ 2)) *
          ‖((ι (u (c ^ 3 * s)) : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 := by
    intro s κ hκ
    have h := Hm1_weight_scaling c (c * κ) hc0 (mul_pos hc0 hκ) (u (c ^ 3 * s)) (v s) (hvx s)
    rw [mul_div_cancel_left₀ κ hc0.ne'] at h
    exact h
  have hnorm : ∀ r : 𝓢(ℝ, ℝ), ‖ι r‖ = ‖(ι r : Lp ℂ 2 (volume : Measure ℝ))‖ := fun r => rfl
  have hu0' : ‖(ι (u 0) : Lp ℂ 2 (volume : Measure ℝ))‖ ≤ R := by rw [← hnorm]; exact hu0
  have hu0sq : ‖(ι (u 0) : Lp ℂ 2 (volume : Measure ℝ))‖ ^ 2 ≤ R ^ 2 :=
