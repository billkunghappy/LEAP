      simpa [mul_assoc] using this
    have hg : Integrable (fun t => f t - 2 * w t * y t) (volume : Measure ℝ) :=
      (f.integrable).sub hwy
    have hy0 : Filter.Tendsto (y : ℝ → ℝ) Filter.atTop (nhds 0) :=
      (y.toZeroAtInfty.zero_at_infty').mono_left atTop_le_cocompact
