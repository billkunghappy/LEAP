          (g t₀ - g t₀ - (t₀ - t₀) * g' t₀) = g (t₀ + h) - g t₀ - h * g' t₀ := by ring
      have h2 : |g (t₀ + h) - g t₀ - h * g' t₀| ≤ B * |h| * |h| := by
        rw [← e]; exact h1
      calc |g (t₀ + h) - g t₀ - h * g' t₀| ≤ B * |h| * |h| := h2
        _ = B * h ^ 2 := by rw [mul_assoc, abs_mul_abs_self, sq]
    have hDs := hpart V hV ((1:ℝ), (0:ℝ))
    have hD₂c := (hpart (fun p => fderiv ℝ V p ((1:ℝ), (0:ℝ))) hDs ((1:ℝ), (0:ℝ))).continuous
    have hDper : ∀ t x : ℝ, (fun p => fderiv ℝ V p ((1:ℝ), (0:ℝ))) (t, x + 1) =
        (fun p => fderiv ℝ V p ((1:ℝ), (0:ℝ))) (t, x) := fun t x => hperD V hVp _ t x
    have hD₂per : ∀ t x : ℝ,
        (fun p => fderiv ℝ (fun p => fderiv ℝ V p ((1:ℝ), (0:ℝ))) p ((1:ℝ), (0:ℝ))) (t, x + 1) =
        (fun p => fderiv ℝ (fun p => fderiv ℝ V p ((1:ℝ), (0:ℝ))) p ((1:ℝ), (0:ℝ))) (t, x) :=
