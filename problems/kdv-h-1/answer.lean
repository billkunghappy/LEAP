theorem ell2_weight_tools_T : (∃ M : lp (fun _ : ℤ => ℂ) 2 →L[ℝ] lp (fun _ : ℤ => ℂ) 2, ∀ f, ‖M f‖ ^ 2 = ∑' n : ℤ, ‖f n‖ ^ 2 / (4 + (2 * π * n) ^ 2)) ∧ (∀ a : lp (fun _ : ℤ => ℂ) 2, Summable (fun n : ℤ => (4 + (2 * π * n) ^ 2) ^ 2 * ‖a n‖ ^ 2) → ∀ K ≥ (1 : ℝ), (∑' n : ℤ, (4 + (2 * π * n) ^ 2) ^ 2 * ‖a n‖ ^ 2) ≤ (4 + 4 * K ^ 2) ^ 3 * (∑' n : ℤ, ‖a n‖ ^ 2 / (4 + (2 * π * n) ^ 2)) + 2 * ∑' n : ℤ, ((2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * (4 + (2 * π * n) ^ 2) ^ 2 * ‖a n‖ ^ 2) ∧ (∀ a b : lp (fun _ : ℤ => ℂ) 2, Summable (fun n : ℤ => (4 + (2 * π * n) ^ 2) ^ 2 * ‖a n‖ ^ 2) → Summable (fun n : ℤ => (4 + (2 * π * n) ^ 2) ^ 2 * ‖b n‖ ^ 2) → ∀ K ≥ (1 : ℝ), (∑' n : ℤ, ((2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * (4 + (2 * π * n) ^ 2) ^ 2 * ‖(a - b) n‖ ^ 2) ≤ 2 * (∑' n : ℤ, ((2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * (4 + (2 * π * n) ^ 2) ^ 2 * ‖a n‖ ^ 2) + 2 * ∑' n : ℤ, ((2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * (4 + (2 * π * n) ^ 2) ^ 2 * ‖b n‖ ^ 2) :=
by
