  have hW1s : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) W1 := hpart K hKs _
  have hW2s : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) W2 := hpart W1 hW1s _
  have hform : ∀ t x : ℝ, kdvRHS (fun y => U (t, y)) x =
      -(V3 (t, x)) + 6 * U (t, x) * V1 (t, x) := by
    intro t x
    have d1 : deriv (fun y => U (t, y)) = fun y => V1 (t, y) :=
      funext fun y => (hlineX U hU t y).deriv
    have d2 : deriv (fun y => V1 (t, y)) = fun y => V2 (t, y) :=
      funext fun y => (hlineX V1 hV1s t y).deriv
    have d3 : deriv (fun y => V2 (t, y)) = fun y => V3 (t, y) :=
      funext fun y => (hlineX V2 hV2s t y).deriv
    unfold kdvRHS
    rw [hit3, d1, d2, d3]
  refine ⟨?_, ?_⟩
  · have e : (fun p : ℝ × ℝ => kdvRHS (fun y => U (p.1, y)) p.2) =
        fun p => -(V3 p) + 6 * U p * V1 p := by
      funext p
      exact hform p.1 p.2
    rw [e]
    exact hV3s.neg.add ((contDiff_const.mul hU).mul hV1s)
  · intro t x
    have hc1 : ∀ p, fderiv ℝ V1 p ((1:ℝ), (0:ℝ)) = W1 p := fun p => hsymm U hU p
    have hc1f : (fun p => fderiv ℝ V1 p ((1:ℝ), (0:ℝ))) = W1 := funext hc1
    have hc2 : ∀ p, fderiv ℝ V2 p ((1:ℝ), (0:ℝ)) = W2 p := by
      intro p
      have h := hsymm V1 hV1s p
      rw [hc1f] at h
      exact h
    have hc2f : (fun p => fderiv ℝ V2 p ((1:ℝ), (0:ℝ))) = W2 := funext hc2
    have hc3 : ∀ p, fderiv ℝ V3 p ((1:ℝ), (0:ℝ)) = W3 p := by
      intro p
      have h := hsymm V2 hV2s p
      rw [hc2f] at h
      exact h
    have hT3 := hlineT V3 hV3s t x
    have hTU := hlineT U hU t x
    have hT1 := hlineT V1 hV1s t x
    have hd := hT3.neg.add ((hTU.const_mul 6).mul hT1)
    have e : (fun s => kdvRHS (fun y => U (s, y)) x) =
        fun s => -(V3 (s, x)) + 6 * U (s, x) * V1 (s, x) := funext fun s => hform s x
    have i3 : iteratedDeriv 3 (fun y => fderiv ℝ U (t, y) ((1:ℝ), (0:ℝ))) x = W3 (t, x) := by
      have d1 : deriv (fun y => K (t, y)) = fun y => W1 (t, y) :=
        funext fun y => (hlineX K hKs t y).deriv
      have d2 : deriv (fun y => W1 (t, y)) = fun y => W2 (t, y) :=
        funext fun y => (hlineX W1 hW1s t y).deriv
      have d3 : deriv (fun y => W2 (t, y)) = fun y => W3 (t, y) :=
        funext fun y => (hlineX W2 hW2s t y).deriv
      rw [hit3]
      show deriv (deriv (deriv (fun y => K (t, y)))) x = W3 (t, x)
      rw [d1, d2, d3]
    have dUK : deriv (fun y => U (t, y) * fderiv ℝ U (t, y) ((1:ℝ), (0:ℝ))) x =
        V1 (t, x) * K (t, x) + U (t, x) * W1 (t, x) :=
      ((hlineX U hU t x).mul (hlineX K hKs t x)).deriv
    rw [e, i3, dUK]
    refine hd.congr_deriv ?_
    rw [hc1 (t, x), hc3 (t, x)]
    show -(W3 (t, x)) + (6 * fderiv ℝ U (t, x) ((1:ℝ), (0:ℝ)) * V1 (t, x) + 6 * U (t, x) * W1 (t, x)) =
      -(W3 (t, x)) + 6 * (V1 (t, x) * fderiv ℝ U (t, x) ((1:ℝ), (0:ℝ)) + U (t, x) * W1 (t, x))
    ring

theorem green_kdv_commutator_T : ∀ (κ : ℝ) (q g : ℝ → ℝ), ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) q → IsGreenT κ q g → ∀ x : ℝ, -(iteratedDeriv 3 (fun y => 16 * κ ^ 5 * deriv g y + 4 * κ ^ 2 * deriv q y) x) + 6 * deriv (fun y => q y * (16 * κ ^ 5 * deriv g y + 4 * κ ^ 2 * deriv q y)) x = 16 * κ ^ 5 * deriv (fun y => -2 * deriv q y * g y + 2 * q y * deriv g y - 4 * κ ^ 2 * deriv g y) x + 4 * κ ^ 2 * deriv (kdvRHS q) x :=
by
  intro κ q g hq hG x
  obtain ⟨hg, -, hpos, hFI⟩ := hG
  have hD : ∀ f : ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f →
      Differentiable ℝ f ∧ ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (deriv f) :=
    fun f hf => contDiff_infty_iff_deriv.1 hf
  obtain ⟨dg0, hg1⟩ := hD g hg
  obtain ⟨dg1, hg2⟩ := hD _ hg1
  obtain ⟨dg2, hg3⟩ := hD _ hg2
  obtain ⟨dg3, -⟩ := hD _ hg3
  obtain ⟨dq0, hq1⟩ := hD q hq
  obtain ⟨dq1, hq2⟩ := hD _ hq1
  obtain ⟨dq2, hq3⟩ := hD _ hq2
  obtain ⟨dq3, -⟩ := hD _ hq3
  have i2 : ∀ f : ℝ → ℝ, iteratedDeriv 2 f = deriv (deriv f) := fun f => by
    simp [iteratedDeriv_eq_iterate]
  have i3 : ∀ f : ℝ → ℝ, iteratedDeriv 3 f = deriv (deriv (deriv f)) := fun f => by
    simp [iteratedDeriv_eq_iterate]
  
  have s1 : ∀ y, deriv (deriv (deriv g)) y =
      2 * deriv q y * g y + 4 * (κ ^ 2 + q y) * deriv g y := by
    intro y
    have hΦ : HasDerivAt (fun y => deriv g y ^ 2 - 2 * g y * deriv (deriv g) y +
        4 * (κ ^ 2 + q y) * g y ^ 2) 0 y := by
      have e : (fun y => deriv g y ^ 2 - 2 * g y * deriv (deriv g) y +
          4 * (κ ^ 2 + q y) * g y ^ 2) = fun _ => (1:ℝ) := by
        funext z
        rw [← i2]
        exact hFI z
      rw [e]
      exact hasDerivAt_const _ _
    have a0 := (dg0 y).hasDerivAt
    have a1 := (dg1 y).hasDerivAt
    have a2 := (dg2 y).hasDerivAt
    have b0 := (dq0 y).hasDerivAt
    have hΦ' := ((a1.pow 2).sub ((a0.const_mul 2).mul a2)).add
      ((((hasDerivAt_const y (κ ^ 2)).add b0).const_mul 4).mul (a0.pow 2))
    have hu := hΦ.unique hΦ'
    norm_num at hu
    have hgy := hpos y
    have h2 : (2 * g y) * deriv (deriv (deriv g)) y =
        (2 * g y) * (2 * deriv q y * g y + 4 * (κ ^ 2 + q y) * deriv g y) := by
      linear_combination hu
    exact mul_left_cancel₀ (by positivity) h2
  
  have s1f : deriv (deriv (deriv g)) =
      fun y => 2 * deriv q y * g y + 4 * (κ ^ 2 + q y) * deriv g y := funext s1
  have e2 : deriv (deriv (deriv (deriv g))) x = 2 * deriv (deriv q) x * g x +
      6 * deriv q x * deriv g x + 4 * (κ ^ 2 + q x) * deriv (deriv g) x := by
    rw [s1f]
    refine ((((dq1 x).hasDerivAt.const_mul 2).mul (dg0 x).hasDerivAt).add
      ((((hasDerivAt_const x (κ ^ 2)).add (dq0 x).hasDerivAt).const_mul 4).mul
        (dg1 x).hasDerivAt)).deriv.trans ?_
    simp only [Pi.add_apply]
    ring
  
  have kf : kdvRHS q = fun y => -(deriv (deriv (deriv q)) y) + 6 * q y * deriv q y := by
    funext y
    unfold kdvRHS
    rw [i3]
  have e3 : deriv (kdvRHS q) x = -(deriv (deriv (deriv (deriv q))) x) +
      6 * deriv q x ^ 2 + 6 * q x * deriv (deriv q) x := by
    rw [kf]
    refine ((dq3 x).hasDerivAt.neg.add
      (((dq0 x).hasDerivAt.const_mul 6).mul (dq1 x).hasDerivAt)).deriv.trans ?_
    ring
  
  have lin : ∀ (a b : ℝ) (f₁ f₂ : ℝ → ℝ), Differentiable ℝ f₁ → Differentiable ℝ f₂ →
      deriv (fun y => a * f₁ y + b * f₂ y) = fun y => a * deriv f₁ y + b * deriv f₂ y := by
    intro a b f₁ f₂ h₁ h₂
    funext y
    exact (((h₁ y).hasDerivAt.const_mul a).add ((h₂ y).hasDerivAt.const_mul b)).deriv
  have e4 : iteratedDeriv 3 (fun y => 16 * κ ^ 5 * deriv g y + 4 * κ ^ 2 * deriv q y) x =
      16 * κ ^ 5 * deriv (deriv (deriv (deriv g))) x +
        4 * κ ^ 2 * deriv (deriv (deriv (deriv q))) x := by
    rw [i3, lin (16 * κ ^ 5) (4 * κ ^ 2) _ _ dg1 dq1, lin (16 * κ ^ 5) (4 * κ ^ 2) _ _ dg2 dq2,
      lin (16 * κ ^ 5) (4 * κ ^ 2) _ _ dg3 dq3]
  
  have eP : deriv (fun y => q y * (16 * κ ^ 5 * deriv g y + 4 * κ ^ 2 * deriv q y)) x =
      deriv q x * (16 * κ ^ 5 * deriv g x + 4 * κ ^ 2 * deriv q x) +
        q x * (16 * κ ^ 5 * deriv (deriv g) x + 4 * κ ^ 2 * deriv (deriv q) x) := by
    refine ((dq0 x).hasDerivAt.mul (((dg1 x).hasDerivAt.const_mul (16 * κ ^ 5)).add
      ((dq1 x).hasDerivAt.const_mul (4 * κ ^ 2)))).deriv.trans ?_
    simp only [Pi.add_apply]
  have eZ : deriv (fun y => -2 * deriv q y * g y + 2 * q y * deriv g y -
      4 * κ ^ 2 * deriv g y) x =
      -2 * deriv (deriv q) x * g x + -2 * deriv q x * deriv g x +
        (2 * deriv q x * deriv g x + 2 * q x * deriv (deriv g) x) -
          4 * κ ^ 2 * deriv (deriv g) x := by
    refine (((((dq1 x).hasDerivAt.const_mul (-2)).mul (dg0 x).hasDerivAt).add
      (((dq0 x).hasDerivAt.const_mul 2).mul (dg1 x).hasDerivAt)).sub
        ((dg1 x).hasDerivAt.const_mul (4 * κ ^ 2))).deriv.trans ?_
    ring
  
  rw [e4, eP, eZ, e3, e2]
  ring

theorem hk_first_variation_T : ∀ R ≥ (0 : ℝ), ∃ κ₀ ≥ (1 : ℝ), ∀ κ ≥ κ₀, ∃ A ≥ (0 : ℝ), ∃ B ≥ (0 : ℝ), ∀ a b : ℝ → CinfT, IsHkSolutionT κ a → IsHkSolutionT κ b → ‖ιT (a 0)‖ ≤ R → ‖ιT (b 0)‖ ≤ R → ∀ (h τ Λ : ℝ) (e₀ e : CinfT), (∀ x : ℝ, (e₀ : ℝ → ℝ) x = kdvRHS (b 0 : ℝ → ℝ) x) → (∀ x : ℝ, (e : ℝ → ℝ) x = kdvRHS (b τ : ℝ → ℝ) x) → (∀ ρ : ℝ, |ρ| ≤ |τ| → ‖ιT (a ρ) - ιT (b ρ)‖ ≤ Λ) → ‖ιT (a τ) - ιT (b τ) - h • ιT e‖ ≤ Real.exp (A * |τ|) * (‖ιT (a 0) - ιT (b 0) - h • ιT e₀‖ + B * (1 + |τ|) * Λ ^ 2) :=
by
  classical
  intro R hR
  obtain ⟨C, hC1, κ₁, hκ₁, hctl⟩ := hk_solution_T_control R hR
  refine ⟨max κ₁ (1024 * C * R ^ 2), le_trans hκ₁ (le_max_left _ _), ?_⟩
  intro κ hκ
  have hκ1 : κ₁ ≤ κ := le_trans (le_max_left _ _) hκ
  have hκR : 1024 * C * R ^ 2 ≤ κ := le_trans (le_max_right _ _) hκ
  have hκone : 1 ≤ κ := le_trans hκ₁ hκ1
  have hκ0 : 0 < κ := by linarith
  refine ⟨64 * κ ^ 5 + 1, by positivity, 480 * κ ^ 6, by positivity, ?_⟩
  intro a b ha hb ha0 hb0 h τ Λ e₀ e he₀ he hΛ
  obtain ⟨hlin, hbd⟩ := toHm1T_basic
  
  
  
  have hreg : ∀ c : ℝ → CinfT, IsHkSolutionT κ c → ‖ιT (c 0)‖ ≤ R → ∀ ρ : ℝ,
      WT κ ((ιT (c ρ) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ≤ κ / 1024 := by
    intro c hc hc0 ρ
    have h1 := (hctl κ hκ1 c hc hc0 ρ).2 κ hκ1
    have h2 := (weight_compare_T ((ιT (c 0) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) κ hκone).2.1
    have h3 : ‖((ιT (c 0) : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ≤ R := hc0
    have h4 : ‖((ιT (c 0) : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ^ 2 ≤ R ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) h3 2
    have h2' : WT κ ((ιT (c 0) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ≤ R ^ 2 :=
      le_trans h2 h4
    have hC0 : (0:ℝ) ≤ C := by linarith
    have h5 : C * WT κ ((ιT (c 0) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ≤ C * R ^ 2 :=
      mul_le_mul_of_nonneg_left h2' hC0
    linarith
  
  
  
  have hGa : ∀ ρ, IsGreenT κ (a ρ : ℝ → ℝ) (greenT κ (a ρ : ℝ → ℝ)) := fun ρ =>
    (green_T_small_lipschitz κ hκone (a ρ) (b ρ) (hreg a ha ha0 ρ) (hreg b hb hb0 ρ)).1
  have hGb : ∀ ρ, IsGreenT κ (b ρ : ℝ → ℝ) (greenT κ (b ρ : ℝ → ℝ)) := fun ρ =>
    (green_T_small_lipschitz κ hκone (b ρ) (a ρ) (hreg b hb hb0 ρ) (hreg a ha ha0 ρ)).1
  
  
  
  have hsd : ∀ f : ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f →
      ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (deriv f) :=
    fun f hf => (contDiff_infty_iff_deriv.1 hf).2
  have hdiff : ∀ f : ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f → ∀ x,
      HasDerivAt f (deriv f x) x :=
    fun f hf x => ((hf.differentiable (by simp)) x).hasDerivAt
  have hpd : ∀ f : ℝ → ℝ, Function.Periodic f 1 → Function.Periodic (deriv f) 1 := by
    intro f hf x
    have e1 : (fun y => f (y + 1)) = f := funext hf
    rw [← deriv_comp_add_const, e1]
  have hit3 : ∀ f : ℝ → ℝ, iteratedDeriv 3 f = deriv (deriv (deriv f)) := fun f => by
    simp [iteratedDeriv_eq_iterate]
  have hpartT : ∀ V : ℝ × ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) V → ∀ ρ x : ℝ,
      HasDerivAt (fun σ : ℝ => V (σ, x)) (fderiv ℝ V (ρ, x) ((1:ℝ), (0:ℝ))) ρ := by
    intro V hV ρ x
    have hd : Differentiable ℝ V := hV.differentiable (by simp)
    exact (hd (ρ, x)).hasFDerivAt.comp_hasDerivAt ρ
      ((hasDerivAt_id' ρ).prodMk (hasDerivAt_const ρ x))
  have hcomb : ∀ (p q : CinfT) (c₁ c₂ : ℝ), ∃ r : CinfT,
      ∀ x, (r : ℝ → ℝ) x = c₁ * (p : ℝ → ℝ) x + c₂ * (q : ℝ → ℝ) x := by
    intro p q c₁ c₂
    refine ⟨⟨fun x => c₁ * (p : ℝ → ℝ) x + c₂ * (q : ℝ → ℝ) x, ?_, ?_⟩, fun x => rfl⟩
    · exact (contDiff_const.mul p.2.1).add (contDiff_const.mul q.2.1)
    · intro x
      simp only [p.2.2 x, q.2.2 x]
  
  
  
  have hXs : ∀ ρ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (kdvRHS (b ρ : ℝ → ℝ)) := by
    intro ρ
    have hb0s := (b ρ).2.1
    have e1 : kdvRHS (b ρ : ℝ → ℝ) = fun x => -(deriv (deriv (deriv (b ρ : ℝ → ℝ))) x) +
        6 * (b ρ : ℝ → ℝ) x * deriv (b ρ : ℝ → ℝ) x := by
      funext x; unfold kdvRHS; rw [hit3]
    rw [e1]
    exact (hsd _ (hsd _ (hsd _ hb0s))).neg.add ((contDiff_const.mul hb0s).mul (hsd _ hb0s))
  have hXp : ∀ ρ, Function.Periodic (kdvRHS (b ρ : ℝ → ℝ)) 1 := by
    intro ρ x
    have hp := (b ρ).2.2
    unfold kdvRHS
    rw [hit3, hpd _ (hpd _ (hpd _ hp)) x, hp x, hpd _ hp x]
  have hζs : ∀ ρ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun y => -2 * deriv (b ρ : ℝ → ℝ) y *
      greenT κ (b ρ : ℝ → ℝ) y + 2 * (b ρ : ℝ → ℝ) y * deriv (greenT κ (b ρ : ℝ → ℝ)) y -
      4 * κ ^ 2 * deriv (greenT κ (b ρ : ℝ → ℝ)) y) := by
    intro ρ
    have h1 := (b ρ).2.1
    have h2 := (hGb ρ).1
    exact (((contDiff_const.mul (hsd _ h1)).mul h2).add ((contDiff_const.mul h1).mul
      (hsd _ h2))).sub (contDiff_const.mul (hsd _ h2))
  have hEex : ∀ ρ, ∃ r : CinfT, (r : ℝ → ℝ) = fun x => (a ρ : ℝ → ℝ) x - (b ρ : ℝ → ℝ) x -
      h * kdvRHS (b ρ : ℝ → ℝ) x := by
    intro ρ
    refine ⟨⟨fun x => (a ρ : ℝ → ℝ) x - (b ρ : ℝ → ℝ) x - h * kdvRHS (b ρ : ℝ → ℝ) x,
      ?_, ?_⟩, rfl⟩
    · exact ((a ρ).2.1.sub (b ρ).2.1).sub (contDiff_const.mul (hXs ρ))
    · intro x
      simp only [(a ρ).2.2 x, (b ρ).2.2 x, hXp ρ x]
  choose E hE using hEex
  have hFex : ∀ ρ, ∃ r : CinfT, (r : ℝ → ℝ) = fun x => 16 * κ ^ 5 *
      (greenT κ (a ρ : ℝ → ℝ) x - greenT κ (b ρ : ℝ → ℝ) x -
        h * (-2 * deriv (b ρ : ℝ → ℝ) x * greenT κ (b ρ : ℝ → ℝ) x +
          2 * (b ρ : ℝ → ℝ) x * deriv (greenT κ (b ρ : ℝ → ℝ)) x -
          4 * κ ^ 2 * deriv (greenT κ (b ρ : ℝ → ℝ)) x)) := by
    intro ρ
    refine ⟨⟨fun x => 16 * κ ^ 5 *
      (greenT κ (a ρ : ℝ → ℝ) x - greenT κ (b ρ : ℝ → ℝ) x -
        h * (-2 * deriv (b ρ : ℝ → ℝ) x * greenT κ (b ρ : ℝ → ℝ) x +
          2 * (b ρ : ℝ → ℝ) x * deriv (greenT κ (b ρ : ℝ → ℝ)) x -
          4 * κ ^ 2 * deriv (greenT κ (b ρ : ℝ → ℝ)) x)), ?_, ?_⟩, rfl⟩
    · exact contDiff_const.mul (((hGa ρ).1.sub (hGb ρ).1).sub (contDiff_const.mul (hζs ρ)))
    · intro x
      simp only [(hGa ρ).2.1 x, (hGb ρ).2.1 x, (b ρ).2.2 x, hpd _ (b ρ).2.2 x,
        hpd _ (hGb ρ).2.1 x]
  choose eF heF using hFex
  
  
  
  have hEs : ContDiff ℝ 2 (fun p : ℝ × ℝ => (E p.1 : ℝ → ℝ) p.2) := by
    have e1 : (fun p : ℝ × ℝ => (E p.1 : ℝ → ℝ) p.2) = fun p : ℝ × ℝ =>
        (a p.1 : ℝ → ℝ) p.2 - (b p.1 : ℝ → ℝ) p.2 -
          h * kdvRHS (fun y => (fun q : ℝ × ℝ => (b q.1 : ℝ → ℝ) q.2) (p.1, y)) p.2 := by
      funext p; rw [hE p.1]
    rw [e1]
    have hk := (kdvRHS_jointly_smooth_T (fun q : ℝ × ℝ => (b q.1 : ℝ → ℝ) q.2) hb.1).1
    exact ((ha.1.sub hb.1).sub (contDiff_const.mul hk)).of_le (WithTop.coe_le_coe.2 le_top)
  
  
  
  have htr : ∀ ρ x : ℝ, HasDerivAt (fun s : ℝ => (E s : ℝ → ℝ) x)
      (deriv (eF ρ : ℝ → ℝ) x + 4 * κ ^ 2 * deriv (E ρ : ℝ → ℝ) x) ρ := by
    intro ρ x
    have hK : ∀ y, fderiv ℝ (fun q : ℝ × ℝ => (b q.1 : ℝ → ℝ) q.2) (ρ, y) ((1:ℝ), (0:ℝ)) =
        16 * κ ^ 5 * deriv (greenT κ (b ρ : ℝ → ℝ)) y + 4 * κ ^ 2 * deriv (b ρ : ℝ → ℝ) y :=
      fun y => (hpartT _ hb.1 ρ y).unique (hb.2 ρ y)
    have hs4 := (kdvRHS_jointly_smooth_T (fun q : ℝ × ℝ => (b q.1 : ℝ → ℝ) q.2) hb.1).2 ρ x
    simp only [hK] at hs4
    rw [green_kdv_commutator_T κ (b ρ : ℝ → ℝ) (greenT κ (b ρ : ℝ → ℝ)) (b ρ).2.1 (hGb ρ) x]
      at hs4
    have hsum := ((ha.2 ρ x).sub (hb.2 ρ x)).sub (hs4.const_mul h)
    have e1 : (fun s : ℝ => (E s : ℝ → ℝ) x) = fun s => (a s : ℝ → ℝ) x - (b s : ℝ → ℝ) x -
        h * kdvRHS (b s : ℝ → ℝ) x := by
      funext s; rw [hE s]
    rw [e1]
    refine hsum.congr_deriv ?_
    have hga := hdiff _ (hGa ρ).1 x
    have hgb := hdiff _ (hGb ρ).1 x
    have hzz := hdiff _ (hζs ρ) x
    have hav := hdiff _ (a ρ).2.1 x
    have hbv := hdiff _ (b ρ).2.1 x
    have hxv := hdiff _ (hXs ρ) x
    have dF : deriv (eF ρ : ℝ → ℝ) x = 16 * κ ^ 5 * (deriv (greenT κ (a ρ : ℝ → ℝ)) x -
        deriv (greenT κ (b ρ : ℝ → ℝ)) x - h * deriv (fun y => -2 * deriv (b ρ : ℝ → ℝ) y *
          greenT κ (b ρ : ℝ → ℝ) y + 2 * (b ρ : ℝ → ℝ) y * deriv (greenT κ (b ρ : ℝ → ℝ)) y -
          4 * κ ^ 2 * deriv (greenT κ (b ρ : ℝ → ℝ)) y) x) := by
      rw [heF ρ]
      exact (((hga.sub hgb).sub (hzz.const_mul h)).const_mul (16 * κ ^ 5)).deriv
    have dE : deriv (E ρ : ℝ → ℝ) x = deriv (a ρ : ℝ → ℝ) x - deriv (b ρ : ℝ → ℝ) x -
        h * deriv (kdvRHS (b ρ : ℝ → ℝ)) x := by
      rw [hE ρ]
      exact ((hav.sub hbv).sub (hxv.const_mul h)).deriv
    rw [dF, dE]
    unfold hkRHST
    ring
  
  
  
  have hL2 : ∀ t : ℝ, |t| ≤ |τ| → (∫ x in (0:ℝ)..1, (eF t : ℝ → ℝ) x ^ 2) ≤
      (32 * κ ^ 5 * ‖ιT (E t)‖ + 240 * κ ^ 6 * Λ ^ 2) ^ 2 := by
    intro t ht
    have hs2 := green_first_variation_T κ hκone (b t) (a t) (E t) h (hreg b hb hb0 t)
      (hreg a ha ha0 t) (fun x => by rw [hE t])
    have hD := hΛ t ht
    have hD0 : 0 ≤ ‖ιT (a t) - ιT (b t)‖ := norm_nonneg _
    have hD2 : ‖ιT (a t) - ιT (b t)‖ ^ 2 ≤ Λ ^ 2 := pow_le_pow_left₀ hD0 hD 2
    have hN0 : 0 ≤ ‖ιT (E t)‖ := norm_nonneg _
    have hbase : 2 * ‖ιT (E t)‖ + 15 * κ * ‖ιT (a t) - ιT (b t)‖ ^ 2 ≤
        2 * ‖ιT (E t)‖ + 15 * κ * Λ ^ 2 := by nlinarith
    have hsq : (2 * ‖ιT (E t)‖ + 15 * κ * ‖ιT (a t) - ιT (b t)‖ ^ 2) ^ 2 ≤
        (2 * ‖ιT (E t)‖ + 15 * κ * Λ ^ 2) ^ 2 :=
      pow_le_pow_left₀ (by positivity) hbase 2
    have eint : (∫ x in (0:ℝ)..1, (eF t : ℝ → ℝ) x ^ 2) = (16 * κ ^ 5) ^ 2 *
        ∫ x in (0:ℝ)..1, (greenT κ (a t : ℝ → ℝ) x - greenT κ (b t : ℝ → ℝ) x -
          h * (-2 * deriv (b t : ℝ → ℝ) x * greenT κ (b t : ℝ → ℝ) x +
            2 * (b t : ℝ → ℝ) x * deriv (greenT κ (b t : ℝ → ℝ)) x -
            4 * κ ^ 2 * deriv (greenT κ (b t : ℝ → ℝ)) x)) ^ 2 := by
      simp only [heF t]
      rw [← intervalIntegral.integral_const_mul]
      congr 1
      funext x
      ring
    rw [eint]
    have hk0 : 0 ≤ (16 * κ ^ 5) ^ 2 := by positivity
    calc _ ≤ (16 * κ ^ 5) ^ 2 * (2 * ‖ιT (E t)‖ + 15 * κ * ‖ιT (a t) - ιT (b t)‖ ^ 2) ^ 2 :=
          mul_le_mul_of_nonneg_left hs2 hk0
      _ ≤ (16 * κ ^ 5) ^ 2 * (2 * ‖ιT (E t)‖ + 15 * κ * Λ ^ 2) ^ 2 :=
          mul_le_mul_of_nonneg_left hsq hk0
      _ = _ := by ring
  
  
  
  have hG := hm1T_transport_gronwall_inhom E eF (4 * κ ^ 2) (32 * κ ^ 5)
    (240 * κ ^ 6 * Λ ^ 2) |τ| (by positivity) (by positivity) hEs htr hL2 τ le_rfl
  
  
  
  have hid : ∀ (ρ : ℝ) (f : CinfT), (∀ x, (f : ℝ → ℝ) x = kdvRHS (b ρ : ℝ → ℝ) x) →
      ιT (E ρ) = ιT (a ρ) - ιT (b ρ) - h • ιT f := by
    intro ρ f hf
    obtain ⟨r, hr⟩ := hcomb (a ρ) (b ρ) 1 (-1)
    have h1 : ιT r = (1:ℝ) • ιT (a ρ) + (-1:ℝ) • ιT (b ρ) :=
      Subtype.ext (hlin _ _ r 1 (-1) hr)
    have h2 : ιT (E ρ) = (1:ℝ) • ιT r + (-h) • ιT f := by
      apply Subtype.ext
      apply hlin
      intro x
      simp only [hE ρ, hr x, hf x]
      ring
    rw [h2, h1]
    simp only [one_smul, neg_smul]
    abel
  rw [hid τ e he, hid 0 e₀ he₀] at hG
  have c1 : (2 * (32 * κ ^ 5) + 1) * |τ| = (64 * κ ^ 5 + 1) * |τ| := by ring
  have c2 : 2 * (240 * κ ^ 6 * Λ ^ 2) * (1 + |τ|) = 480 * κ ^ 6 * (1 + |τ|) * Λ ^ 2 := by ring
  rw [c1, c2] at hG
  exact hG

theorem kdv_hk_commute_curve_T : ∀ R ≥ (0 : ℝ), ∃ κ₀ ≥ (1 : ℝ), ∀ κ ≥ κ₀, ∀ v : ℝ → CinfT,
    IsSmoothSolutionT v → (∀ σ : ℝ, ‖ιT (v σ)‖ ≤ R) → ∀ c : ℝ → ℝ → CinfT,
      (∀ σ : ℝ, IsHkSolutionT κ (c σ) ∧ c σ 0 = v σ) → ∀ t s : ℝ, ∃ r : CinfT,
        (∀ x : ℝ, (r : ℝ → ℝ) x =
          kdvRHS (c s (t - s) : ℝ → ℝ) x - hkRHST κ (c s (t - s) : ℝ → ℝ) x) ∧
        HasDerivAt (fun σ : ℝ => ιT (c σ (t - σ))) (ιT r) s :=
by
  classical
  intro R hR
  obtain ⟨κF, hκF1, hFV⟩ := hk_first_variation_T R hR
  obtain ⟨κL, hκL1, hLip⟩ := hk_solution_T_lipschitz R hR
  refine ⟨max κF κL, le_trans hκF1 (le_max_left _ _), ?_⟩
  intro κ hκ v hv hRv c hc t s
  obtain ⟨A, hA, B, hB, hfv⟩ := hFV κ (le_trans (le_max_left _ _) hκ)
  obtain ⟨Λ₀, hΛ₀, hlip⟩ := hLip κ (le_trans (le_max_right _ _) hκ)
  obtain ⟨hlin, hbd⟩ := toHm1T_basic
  have hv0 : ∀ σ, c σ 0 = v σ := fun σ => (hc σ).2
  
  
  
  have hcomb : ∀ (a b : CinfT) (c₁ c₂ : ℝ), ∃ r : CinfT,
      ∀ x, (r : ℝ → ℝ) x = c₁ * (a : ℝ → ℝ) x + c₂ * (b : ℝ → ℝ) x := by
    intro a b c₁ c₂
    refine ⟨⟨fun x => c₁ * (a : ℝ → ℝ) x + c₂ * (b : ℝ → ℝ) x, ?_, ?_⟩, fun x => rfl⟩
    · exact (contDiff_const.mul a.2.1).add (contDiff_const.mul b.2.1)
    · intro x
      simp only [a.2.2 x, b.2.2 x]
  have hιlin : ∀ (q₁ q₂ r : CinfT) (c₁ c₂ : ℝ),
      (∀ x, (r : ℝ → ℝ) x = c₁ * (q₁ : ℝ → ℝ) x + c₂ * (q₂ : ℝ → ℝ) x) →
      ιT r = c₁ • ιT q₁ + c₂ • ιT q₂ := by
    intro q₁ q₂ r c₁ c₂ h
    apply Subtype.ext
    exact hlin q₁ q₂ r c₁ c₂ h
  have hιbd : ∀ (q : CinfT) (M : ℝ), (∀ x, |(q : ℝ → ℝ) x| ≤ M) → ‖ιT q‖ ≤ M :=
    fun q M h => hbd q M h
  have h2bd : ∀ (q₁ q₂ : CinfT) (c₁ c₂ M : ℝ),
      (∀ x, |c₁ * (q₁ : ℝ → ℝ) x + c₂ * (q₂ : ℝ → ℝ) x| ≤ M) →
      ‖c₁ • ιT q₁ + c₂ • ιT q₂‖ ≤ M := by
    intro q₁ q₂ c₁ c₂ M h
    obtain ⟨r, hr⟩ := hcomb q₁ q₂ c₁ c₂
    rw [← hιlin q₁ q₂ r c₁ c₂ hr]
    exact hιbd r M (fun x => by rw [hr x]; exact h x)
  have h3bd : ∀ (q₁ q₂ q₃ : CinfT) (c₁ c₂ c₃ M : ℝ),
      (∀ x, |c₁ * (q₁ : ℝ → ℝ) x + c₂ * (q₂ : ℝ → ℝ) x + c₃ * (q₃ : ℝ → ℝ) x| ≤ M) →
      ‖c₁ • ιT q₁ + c₂ • ιT q₂ + c₃ • ιT q₃‖ ≤ M := by
    intro q₁ q₂ q₃ c₁ c₂ c₃ M h
    obtain ⟨r, hr⟩ := hcomb q₁ q₂ c₁ c₂
    have e := hιlin q₁ q₂ r c₁ c₂ hr
    have h1 := h2bd r q₃ 1 c₃ M (fun x => by rw [hr x, one_mul]; exact h x)
    rwa [one_smul, e] at h1
  
  
  
  have hpart : ∀ V : ℝ × ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) V → ∀ w : ℝ × ℝ,
