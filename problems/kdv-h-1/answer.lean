        intro s hs
        have h0' : HasDerivAt (fun s : ℝ => -(2 * K + 1) * s) (-(2 * K + 1)) s := by
          simpa using (hasDerivAt_id' s).const_mul (-(2 * K + 1))
        exact (h0'.exp.mul (hφ s (hsT s hs))).sub ((hasDerivAt_id' s).const_mul (B ^ 2))
      have hanti : AntitoneOn (fun s => Real.exp (-(2 * K + 1) * s) * ‖R s‖ ^ 2 - B ^ 2 * s)
          (Set.Icc 0 τ) := by
        apply antitoneOn_of_deriv_nonpos (convex_Icc 0 τ)
        · intro s hs; exact (hψ s hs).continuousAt.continuousWithinAt
        · intro s hs
          rw [interior_Icc] at hs
          exact (hψ s (Set.Ioo_subset_Icc_self hs)).differentiableAt.differentiableWithinAt
        · intro s hs
          rw [interior_Icc] at hs
          have hs' := Set.Ioo_subset_Icc_self hs
          rw [(hψ s hs').deriv]
          have hb := hbd s (hsT s hs')
          have he := Real.exp_pos (-(2 * K + 1) * s)
          have he1 : Real.exp (-(2 * K + 1) * s) ≤ 1 :=
            Real.exp_le_one_iff.2 (by nlinarith [hs.1])
          have h1 := (le_abs_self (2 * inner ℝ (R s) (R' s))).trans hb
