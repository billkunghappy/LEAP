    simp only [Pi.add_apply, Pi.sub_apply, Pi.neg_apply]
    rw [hφ y]; ring
  have hwφ : Integrable (fun y => 2 * w y * φ y) (volume : Measure ℝ) := by
    have h := (hw2.integrable_mul hφ2).const_mul 2
    refine h.congr (Filter.Eventually.of_forall fun y => ?_)
    simp only [Pi.mul_apply]; ring
  
  have hK9 : ∀ x, riccatiK κ (fun y => ψ y - 2 * κ * φ y) x = φ x := by
    intro x
    have hsplit : ∀ y : ℝ, Real.exp (2 * κ * (x - y)) =
        Real.exp (2 * κ * x) * Real.exp (-(2 * κ) * y) := by
      intro y; rw [← Real.exp_add]; congr 1; ring
    have hG : ∀ y ∈ Set.Ici x, HasDerivAt (fun y => Real.exp (2 * κ * (x - y)) * φ y)
        (Real.exp (2 * κ * (x - y)) * (ψ y - 2 * κ * φ y)) y := by
      intro y _
      have h := ((((hasDerivAt_id' y).const_sub x).const_mul (2 * κ)).exp).mul (hφd y)
      convert h using 1
      ring
    have hGi : IntegrableOn (fun y => Real.exp (2 * κ * (x - y)) * (ψ y - 2 * κ * φ y))
        (Set.Ioi x) := by
      have hI := (exp_neg_integrableOn_Ioi x h2κ).const_mul
        (Real.exp (2 * κ * x) * (Cψ + 2 * κ * Cφ))
      refine Integrable.mono' hI ?_ (Filter.Eventually.of_forall fun y => ?_)
      · exact (by fun_prop : Continuous fun y =>
          Real.exp (2 * κ * (x - y)) * (ψ y - 2 * κ * φ y)).aestronglyMeasurable
      · show ‖Real.exp (2 * κ * (x - y)) * (ψ y - 2 * κ * φ y)‖ ≤
          Real.exp (2 * κ * x) * (Cψ + 2 * κ * Cφ) * Real.exp (-(2 * κ) * y)
        rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), hsplit y]
        have h1 : |ψ y - 2 * κ * φ y| ≤ Cψ + 2 * κ * Cφ := by
          have e1 := hCψ y
          have e2 := hCφ y
          calc |ψ y - 2 * κ * φ y| ≤ |ψ y| + |2 * κ * φ y| := abs_sub _ _
