        have e2 : riccatiK κ (fun y => q₂ y - w₂ y ^ 2) x =
            riccatiK κ q₂ x - riccatiK κ (fun y => w₂ y ^ 2) x := S _ _ iq₂ iw₂ x
        have e3 : riccatiK κ (fun y => (q₁ y - w₁ y ^ 2) - (q₂ y - w₂ y ^ 2)) x =
