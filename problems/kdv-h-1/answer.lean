    rw [le_div_iff₀ (by positivity)] at h1
    nlinarith
  obtain ⟨κ₀, hκ₀c⟩ : ∃ κ₀ : ℝ, c * κ₀ = 1 := ⟨1 / c, by field_simp⟩
  have hκ₀pos : 0 < κ₀ := by
    by_contra h
    push_neg at h
    nlinarith
