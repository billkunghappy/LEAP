theorem hk_flow_Hm1_continuity : ∃ δ > (0 : ℝ), ∀ κ ≥ (1 : ℝ), ∀ a : ℕ → 𝓢(ℝ, ℝ), (∀ n, ‖ι (a n)‖ ≤ δ) →
