        convert h2 using 1
        ring
      have hbd : ∀ t ∈ Set.Ioi x, ‖Real.exp (2 * κ * (x - t)) * (f t - 2 * w t * y t)‖ ≤
          ‖f t - 2 * w t * y t‖ := by
        intro t ht
        have ht' : x < t := ht
        have he : Real.exp (2 * κ * (x - t)) ≤ 1 := by
          rw [Real.exp_le_one_iff]
          nlinarith
        rw [norm_mul, Real.norm_of_nonneg (Real.exp_pos _).le]
        exact mul_le_of_le_one_left (norm_nonneg _) he
      have hint : IntegrableOn (fun t => Real.exp (2 * κ * (x - t)) * (f t - 2 * w t * y t))
