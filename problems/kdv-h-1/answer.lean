            SchwartzMap.seminorm ℝ 0 (n - i) (g a)) +
          ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * SchwartzMap.seminorm ℝ k i f₀ *
            SchwartzMap.seminorm ℝ 0 (n - i) (g a - g₀)) l (nhds 0) := by
      have h := (tendsto_finset_sum (Finset.range (n + 1)) fun i _ =>
          ((tendsto_const_nhds (x := (n.choose i : ℝ))).mul
            (((hcs k i).tendsto 0).comp hf0)).mul (((hcs 0 (n - i)).tendsto g₀).comp hg)).add
        (tendsto_finset_sum (Finset.range (n + 1)) fun i _ =>
          (tendsto_const_nhds (x := (n.choose i : ℝ) * SchwartzMap.seminorm ℝ k i f₀)).mul
            (((hcs 0 (n - i)).tendsto 0).comp hg0))
      simpa using h
    have hbound : ∀ a, SchwartzMap.seminorm ℝ k n (M (f a) (g a) - M f₀ g₀) ≤
        (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * SchwartzMap.seminorm ℝ k i (f a - f₀) *
            SchwartzMap.seminorm ℝ 0 (n - i) (g a)) +
          ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * SchwartzMap.seminorm ℝ k i f₀ *
            SchwartzMap.seminorm ℝ 0 (n - i) (g a - g₀) := by
      intro a
      have heq : M (f a) (g a) - M f₀ g₀ = M (f a - f₀) (g a) + M f₀ (g a - g₀) := by
        ext x
        simp only [SchwartzMap.sub_apply, SchwartzMap.add_apply, hM]
        ring
      rw [heq]
      exact le_trans (map_add_le_add _ _ _)
        (add_le_add (P _ _ _ (hM _ _) k n) (P _ _ _ (hM _ _) k n))
    filter_upwards [(tendsto_order.1 hS).2 ε hε] with a ha
    simp only [SchwartzMap.schwartzSeminormFamily_apply]
    exact lt_of_le_of_lt (hbound a) ha
  
  obtain ⟨L, hL⟩ := toHm1_clm
  have hmem : ∀ q : 𝓢(ℝ, ℝ), L q ∈ Hm1 := fun q => by rw [hL]; exact (ι q).2
  obtain ⟨Lι, hι⟩ : ∃ Lι : 𝓢(ℝ, ℝ) →L[ℝ] Hm1, ∀ q : 𝓢(ℝ, ℝ), Lι q = ι q :=
    ⟨L.codRestrict Hm1 hmem, fun q => Subtype.ext (by
      rw [ContinuousLinearMap.coe_codRestrict_apply, hL]; rfl)⟩
  refine ⟨fun p => ⟨-(D (D (D p))) + (6 : ℝ) • M p (D p), fun x => ?_⟩, ?_⟩
  · rw [hK]
    simp only [SchwartzMap.add_apply, SchwartzMap.neg_apply, SchwartzMap.smul_apply, smul_eq_mul,
      hM]
    ring
  intro b c b' τ hb hc
  
  have h2 := (HasFDerivAtFilter.isLittleOTVS hb.hasFDerivAt).tendsto_inv_smul
  simp only [ContinuousLinearMap.toSpanSingleton_apply] at h2
  have hbt : Filter.Tendsto b (nhds τ) (nhds (b τ)) := by
    have h3 : Filter.Tendsto (fun x : ℝ => x - τ) (nhds τ) (nhds 0) :=
      tendsto_sub_nhds_zero_iff.2 Filter.tendsto_id
    have h4 : ∀ x : ℝ, b x - b τ - (x - τ) • b' =
        (x - τ) • ((x - τ)⁻¹ • (b x - b τ - (x - τ) • b')) := by
      intro x
      by_cases hx : x = τ
      · subst hx
        simp
      · rw [smul_inv_smul₀ (sub_ne_zero.2 hx)]
    have h5 : Filter.Tendsto (fun x : ℝ => b x - b τ - (x - τ) • b') (nhds τ) (nhds 0) := by
      have := h3.smul h2
      rw [smul_zero] at this
      exact this.congr (fun x => (h4 x).symm)
    have h6 : Filter.Tendsto (fun x : ℝ => (x - τ) • b') (nhds τ) (nhds 0) := by
      have := h3.smul (tendsto_const_nhds (x := b'))
      rwa [zero_smul] at this
    have h7 := h5.add h6
    rw [add_zero] at h7
    have h8 : Filter.Tendsto (fun x : ℝ => b x - b τ) (nhds τ) (nhds 0) :=
      h7.congr (fun x => sub_add_cancel _ _)
    exact tendsto_sub_nhds_zero_iff.1 h8
  have hdt : Filter.Tendsto (fun r : ℝ => (r - τ)⁻¹ • (b r - b τ)) (nhdsWithin τ {τ}ᶜ)
      (nhds b') := by
    have h := (h2.mono_left (nhdsWithin_le_nhds (s := {τ}ᶜ))).add (tendsto_const_nhds (x := b'))
    rw [zero_add] at h
    refine h.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with r hr
    have hr' : r - τ ≠ 0 := sub_ne_zero.2 hr
    rw [smul_sub (r - τ)⁻¹ (b r - b τ), smul_smul, inv_mul_cancel₀ hr', one_smul, sub_add_cancel]
  have hbt' : Filter.Tendsto b (nhdsWithin τ {τ}ᶜ) (nhds (b τ)) := hbt.mono_left nhdsWithin_le_nhds
  
  refine ⟨-(D (D (D b'))) + (6 : ℝ) • (M b' (D (b τ)) + M (b τ) (D b')), fun x => ?_, ?_⟩
  · rw [hD3, hprod]
    simp only [SchwartzMap.add_apply, SchwartzMap.neg_apply, SchwartzMap.smul_apply, smul_eq_mul,
      hM]
    ring
  
  have hQ : ∀ r : ℝ, (r - τ)⁻¹ • (c r - c τ) =
      -(D (D (D ((r - τ)⁻¹ • (b r - b τ))))) + (6 : ℝ) •
        (M ((r - τ)⁻¹ • (b r - b τ)) (D (b r)) + M (b τ) (D ((r - τ)⁻¹ • (b r - b τ)))) := by
    intro r
    ext x
    simp only [map_smul, map_sub, SchwartzMap.add_apply, SchwartzMap.neg_apply,
      SchwartzMap.smul_apply, SchwartzMap.sub_apply, smul_eq_mul, hM, hc, hK]
    ring
  have hDc := D.continuous
  have hQt : Filter.Tendsto (fun r : ℝ =>
      -(D (D (D ((r - τ)⁻¹ • (b r - b τ))))) + (6 : ℝ) •
        (M ((r - τ)⁻¹ • (b r - b τ)) (D (b r)) + M (b τ) (D ((r - τ)⁻¹ • (b r - b τ)))))
      (nhdsWithin τ {τ}ᶜ)
      (nhds (-(D (D (D b'))) + (6 : ℝ) • (M b' (D (b τ)) + M (b τ) (D b')))) := by
    have t1 : Filter.Tendsto (fun r : ℝ => D (D (D ((r - τ)⁻¹ • (b r - b τ)))))
        (nhdsWithin τ {τ}ᶜ) (nhds (D (D (D b')))) :=
      ((hDc.comp (hDc.comp hDc)).tendsto b').comp hdt
    have t2 := JC _ _ _ _ _ hdt (((hDc.tendsto _).comp hbt'))
    have t3 := JC _ (fun _ => b τ) _ _ _ tendsto_const_nhds ((hDc.tendsto _).comp hdt)
    exact t1.neg.add ((t2.add t3).const_smul (6 : ℝ))
  have hS := (Lι.continuous.tendsto _).comp hQt
  rw [hasDerivAt_iff_tendsto_slope, ← hι]
  refine hS.congr (fun r => ?_)
  simp only [Function.comp_apply]
  rw [slope_def_module, ← hQ r, map_smul, map_sub, hι, hι]

theorem hk_flow_lipschitz : ∃ δ > (0 : ℝ), ∀ κ ≥ (1 : ℝ), ∃ Λ ≥ (0 : ℝ), ∀ p q : 𝓢(ℝ, ℝ),
    ‖ι p‖ ≤ δ → ‖ι q‖ ≤ δ → ∀ τ : ℝ,
      ‖ι (hkFlow κ τ q) - ι (hkFlow κ τ p)‖ ≤ Real.exp (Λ * |τ|) * ‖ι q - ι p‖ :=
by
  classical
  obtain ⟨Lc, hLc⟩ := toHm1_clm
  
  
  
  have hn : ∀ (q : 𝓢(ℝ, ℝ)) (ξ x : ℝ),
      ‖Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((q x : ℝ) : ℂ)‖ = ‖q x‖ := by
    intro q ξ x
    rw [norm_mul, Complex.norm_real]
    have : -((ξ : ℂ) * (x : ℂ)) * I = ((-(ξ * x) : ℝ) : ℂ) * I := by push_cast; ring
    rw [this, Complex.norm_exp_ofReal_mul_I, one_mul]
  have hcx : ∀ (q : 𝓢(ℝ, ℝ)) (ξ : ℝ),
      Continuous (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((q x : ℝ) : ℂ)) := by
    intro q ξ
    fun_prop
  have hqi : ∀ q : 𝓢(ℝ, ℝ), Integrable (fun x : ℝ => ‖q x‖) volume :=
    fun q => (q.integrable (μ := volume)).norm
  have hint : ∀ (q : 𝓢(ℝ, ℝ)) (ξ : ℝ),
      Integrable (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((q x : ℝ) : ℂ)) volume :=
    fun q ξ => Integrable.mono' (hqi q) (hcx q ξ).aestronglyMeasurable
      (ae_of_all _ fun x => (hn q ξ x).le)
  have hsq : ∀ a : ℝ, 0 < a → Continuous (fun ξ : ℝ => (Real.sqrt (a + ξ ^ 2))⁻¹) := by
    intro a ha
    exact (Real.continuous_sqrt.comp (by fun_prop)).inv₀
      (fun ξ => (Real.sqrt_pos.2 (by positivity)).ne')
  have hcont : ∀ q : 𝓢(ℝ, ℝ), Continuous (hm1Profile ⇑q) := by
    intro q
    have h1 : Continuous (fun ξ : ℝ => ((Real.sqrt (4 + ξ ^ 2) : ℝ) : ℂ)⁻¹) := by
      have := Complex.continuous_ofReal.comp (hsq 4 (by norm_num))
      refine this.congr fun ξ => ?_
      simp
    have h2 : Continuous (fun ξ : ℝ =>
        ∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((q x : ℝ) : ℂ)) := by
      refine continuous_of_dominated (bound := fun x => ‖q x‖)
        (fun ξ => (hcx q ξ).aestronglyMeasurable) (fun ξ => ae_of_all _ fun x => (hn q ξ x).le)
        (hqi q) (ae_of_all _ fun x => ?_)
      fun_prop
    have : hm1Profile ⇑q = fun ξ => ((Real.sqrt (4 + ξ ^ 2) : ℝ) : ℂ)⁻¹ *
        (((Real.sqrt (2 * π) : ℝ) : ℂ)⁻¹ *
          ∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((q x : ℝ) : ℂ)) := rfl
    rw [this]
    exact h1.mul (continuous_const.mul h2)
  have hpt : ∀ (q : 𝓢(ℝ, ℝ)) (ξ : ℝ), ‖hm1Profile ⇑q ξ‖ ≤
      ((Real.sqrt (2 * π))⁻¹ * ∫ x : ℝ, ‖q x‖) * (Real.sqrt (1 + ξ ^ 2))⁻¹ := by
    intro q ξ
    have hI : ‖∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((q x : ℝ) : ℂ)‖ ≤
        ∫ x : ℝ, ‖q x‖ := by
      refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
      congr 1
      funext x
      exact hn q ξ x
    have hw : (Real.sqrt (4 + ξ ^ 2))⁻¹ ≤ (Real.sqrt (1 + ξ ^ 2))⁻¹ := by
      apply inv_anti₀ (Real.sqrt_pos.2 (by positivity))
      exact Real.sqrt_le_sqrt (by linarith)
    have hA : 0 ≤ ∫ x : ℝ, ‖q x‖ := integral_nonneg fun _ => norm_nonneg _
    show ‖((Real.sqrt (4 + ξ ^ 2) : ℝ) : ℂ)⁻¹ *
        (((Real.sqrt (2 * π) : ℝ) : ℂ)⁻¹ *
          ∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((q x : ℝ) : ℂ))‖ ≤ _
    rw [norm_mul, norm_mul, norm_inv, norm_inv, Complex.norm_real, Complex.norm_real,
      Real.norm_of_nonneg (Real.sqrt_nonneg _), Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    calc (Real.sqrt (4 + ξ ^ 2))⁻¹ * ((Real.sqrt (2 * π))⁻¹ *
          ‖∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((q x : ℝ) : ℂ)‖)
        ≤ (Real.sqrt (1 + ξ ^ 2))⁻¹ * ((Real.sqrt (2 * π))⁻¹ * ∫ x : ℝ, ‖q x‖) :=
          mul_le_mul hw (mul_le_mul_of_nonneg_left hI (by positivity))
            (mul_nonneg (by positivity) (norm_nonneg _)) (by positivity)
      _ = ((Real.sqrt (2 * π))⁻¹ * ∫ x : ℝ, ‖q x‖) * (Real.sqrt (1 + ξ ^ 2))⁻¹ := by ring
  have hwL2 : MemLp (fun ξ : ℝ => (Real.sqrt (1 + ξ ^ 2))⁻¹) 2 volume := by
    rw [memLp_two_iff_integrable_sq (hsq 1 one_pos).aestronglyMeasurable]
    refine integrable_inv_one_add_sq.congr (ae_of_all _ fun ξ => ?_)
    simp only
    rw [inv_pow, Real.sq_sqrt (by positivity)]
  have hmem : ∀ q : 𝓢(ℝ, ℝ), MemLp (hm1Profile ⇑q) 2 volume := by
    intro q
    have hA : 0 ≤ (Real.sqrt (2 * π))⁻¹ * ∫ x : ℝ, ‖q x‖ :=
      mul_nonneg (by positivity) (integral_nonneg fun _ => norm_nonneg _)
    refine MemLp.of_le (hwL2.const_mul ((Real.sqrt (2 * π))⁻¹ * ∫ x : ℝ, ‖q x‖))
      (hcont q).aestronglyMeasurable (ae_of_all _ fun ξ => ?_)
    refine (hpt q ξ).trans (le_of_eq ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hA (by positivity))]
  have hT : ∀ q : 𝓢(ℝ, ℝ), toHm1 q = (hmem q).toLp _ := by
    intro q
    unfold toHm1
    rw [dif_pos (hmem q)]
  
  
  
  have s5 : ∀ f w : 𝓢(ℝ, ℝ), (∀ x : ℝ, w x = deriv (f : ℝ → ℝ) x) →
      (toHm1 w : ℝ → ℂ) =ᵐ[volume] fun ξ : ℝ => ((ξ : ℂ) * I) * (toHm1 f : ℝ → ℂ) ξ := by
    intro f w hw
    have key : ∀ ξ : ℝ,
        (∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((w x : ℝ) : ℂ)) =
          ((ξ : ℂ) * I) * ∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((f x : ℝ) : ℂ) := by
      intro ξ
      have hu : ∀ x : ℝ, HasDerivAt (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I))
          (Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (-(ξ : ℂ) * I)) x := by
        intro x
        have h0 : HasDerivAt (fun x : ℝ => -((ξ : ℂ) * (x : ℂ)) * I) (-(ξ : ℂ) * I) x := by
          have := (((hasDerivAt_id x).ofReal_comp).const_mul (ξ : ℂ)).neg.mul_const I
          simpa using this
        exact h0.cexp
      have hv : ∀ x : ℝ, HasDerivAt (fun x : ℝ => ((f x : ℝ) : ℂ)) ((w x : ℝ) : ℂ) x := by
        intro x
        rw [hw x]
        exact (f.differentiableAt.hasDerivAt).ofReal_comp
      have hint2 : Integrable (fun x : ℝ =>
          (Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (-(ξ : ℂ) * I)) * ((f x : ℝ) : ℂ)) volume := by
        refine ((hint f ξ).const_mul (-(ξ : ℂ) * I)).congr (ae_of_all _ fun x => ?_)
        simp only
        ring
      have hibp := integral_mul_deriv_eq_deriv_mul_of_integrable hu hv (hint w ξ) hint2 (hint f ξ)
      rw [hibp]
      have : (fun x : ℝ =>
          (Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (-(ξ : ℂ) * I)) * ((f x : ℝ) : ℂ)) =
          fun x : ℝ => (-(ξ : ℂ) * I) *
            (Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((f x : ℝ) : ℂ)) := by
        funext x; ring
      rw [this, integral_const_mul]
      ring
    have hprof : ∀ ξ : ℝ, hm1Profile w ξ = ((ξ : ℂ) * I) * hm1Profile f ξ := by
      intro ξ
      simp only [hm1Profile, fourierLine]
      rw [key ξ]
      ring
    rw [hT w, hT f]
    filter_upwards [MemLp.coeFn_toLp (hmem w), MemLp.coeFn_toLp (hmem f)] with ξ h1 h2
    rw [h1, h2]
    exact hprof ξ
  
  
  
  have s6 : ∀ u v : Lp ℂ 2 (volume : Measure ℝ),
      (v : ℝ → ℂ) =ᵐ[volume] (fun ξ : ℝ => ((ξ : ℂ) * I) * (u : ℝ → ℂ) ξ) →
      inner ℝ u v = 0 := by
    intro u v h
    rw [MeasureTheory.L2.inner_def]
    have h0 : (fun ξ : ℝ => inner ℝ ((u : ℝ → ℂ) ξ) ((v : ℝ → ℂ) ξ)) =ᵐ[volume]
        fun _ => (0 : ℝ) := by
      filter_upwards [h] with ξ hξ
      rw [hξ]
      simp [Complex.inner, Complex.mul_re, Complex.mul_im]
      ring
    rw [integral_congr_ae h0, integral_zero]
  
  
  
  have s7 : ∀ (D D' : ℝ → ℝ) (Λ : ℝ), (∀ t : ℝ, HasDerivAt D (D' t) t) →
      (∀ t : ℝ, |D' t| ≤ Λ * D t) → ∀ t : ℝ, D t ≤ Real.exp (Λ * |t|) * D 0 := by
    intro D D' Λ hD hb t
    rcases le_or_gt 0 t with ht | ht
    · have hE : ∀ s : ℝ, HasDerivAt (fun s => Real.exp (-Λ * s) * D s)
          (Real.exp (-Λ * s) * (-Λ) * D s + Real.exp (-Λ * s) * D' s) s := by
        intro s
        have h0 : HasDerivAt (fun s : ℝ => -Λ * s) (-Λ) s := by
          have := (hasDerivAt_id' s).const_mul (-Λ)
          rwa [mul_one] at this
        exact h0.exp.mul (hD s)
      have hanti : Antitone (fun s => Real.exp (-Λ * s) * D s) := by
        apply antitone_of_deriv_nonpos (fun s => (hE s).differentiableAt)
        intro s
        rw [(hE s).deriv]
        have hpos := Real.exp_pos (-Λ * s)
        have h1 := (le_abs_self (D' s)).trans (hb s)
        nlinarith [mul_nonneg hpos.le (sub_nonneg.2 h1)]
      have h := hanti ht
      simp only [mul_zero, Real.exp_zero, one_mul] at h
      rw [abs_of_nonneg ht]
      have e : Real.exp (Λ * t) * Real.exp (-Λ * t) = 1 := by
        rw [← Real.exp_add]; ring_nf; exact Real.exp_zero
      have hp := Real.exp_pos (Λ * t)
      calc D t = Real.exp (Λ * t) * (Real.exp (-Λ * t) * D t) := by
            rw [← mul_assoc, e, one_mul]
        _ ≤ Real.exp (Λ * t) * D 0 := mul_le_mul_of_nonneg_left h hp.le
    · have hF : ∀ s : ℝ, HasDerivAt (fun s => Real.exp (Λ * s) * D s)
          (Real.exp (Λ * s) * Λ * D s + Real.exp (Λ * s) * D' s) s := by
        intro s
        have h0 : HasDerivAt (fun s : ℝ => Λ * s) Λ s := by
          have := (hasDerivAt_id' s).const_mul Λ
          rwa [mul_one] at this
        exact h0.exp.mul (hD s)
      have hmono : Monotone (fun s => Real.exp (Λ * s) * D s) := by
        apply monotone_of_deriv_nonneg (fun s => (hF s).differentiableAt)
        intro s
        rw [(hF s).deriv]
        have hpos := Real.exp_pos (Λ * s)
        have h1 := (neg_le_abs (D' s)).trans (hb s)
        nlinarith [mul_nonneg hpos.le (sub_nonneg.2 h1)]
      have h := hmono ht.le
      simp only [mul_zero, Real.exp_zero, one_mul] at h
      rw [abs_of_neg ht]
      have e : Real.exp (Λ * -t) * Real.exp (Λ * t) = 1 := by
        rw [← Real.exp_add]; ring_nf; exact Real.exp_zero
      have hp := Real.exp_pos (Λ * -t)
      calc D t = Real.exp (Λ * -t) * (Real.exp (Λ * t) * D t) := by
            rw [← mul_assoc, e, one_mul]
        _ ≤ Real.exp (Λ * -t) * D 0 := mul_le_mul_of_nonneg_left h hp.le
  
  
  
  have s8 : ∀ (u : ℝ → 𝓢(ℝ, ℝ)) (v : 𝓢(ℝ, ℝ)) (t : ℝ), HasDerivAt u v t →
      HasDerivAt (fun s => Lc (u s)) (Lc v) t := by
    intro u v t hu
    have h0 := HasFDerivAtFilter.isLittleOTVS hu
    have h1 := h0.tendsto_inv_smul
    have h2 : Filter.Tendsto (fun x : ℝ => Lc ((x - t)⁻¹ • (u x - u t - (x - t) • v)))
        (nhds t) (nhds 0) := by
      have := (Lc.continuous.tendsto 0).comp h1
      rw [map_zero] at this
      refine this.congr (fun x => ?_)
      simp only [Function.comp, ContinuousLinearMap.toSpanSingleton_apply]
    rw [hasDerivAt_iff_tendsto_slope]
    have h3 : Filter.Tendsto (fun x : ℝ => Lc ((x - t)⁻¹ • (u x - u t - (x - t) • v)) + Lc v)
        (nhdsWithin t {t}ᶜ) (nhds (0 + Lc v)) :=
      (h2.mono_left nhdsWithin_le_nhds).add tendsto_const_nhds
    rw [zero_add] at h3
    refine h3.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with x hx
    have hx' : x - t ≠ 0 := sub_ne_zero.2 hx
    rw [slope_def_module]
    simp only [map_smul, map_sub, smul_sub, smul_smul, inv_mul_cancel₀ hx', one_smul]
    abel
  
  
  
  obtain ⟨δE, hδE, hE⟩ := hk_flow_exists
  obtain ⟨δW, hδW, CW, hCW, hW⟩ := hk_flow_weight_control
  obtain ⟨δU, hδU, hU⟩ := green_exists_unique
  obtain ⟨δG, hδG, hG⟩ := green_solution_deriv_lipschitz
  obtain ⟨δs, hδsdef⟩ : ∃ δs : ℝ, δs = min δU δG := ⟨_, rfl⟩
  have hδs : 0 < δs := by rw [hδsdef]; exact lt_min hδU hδG
  have hsU : δs ≤ δU := by rw [hδsdef]; exact min_le_left _ _
  have hsG : δs ≤ δG := by rw [hδsdef]; exact min_le_right _ _
  have hCW0 : 0 < CW := by linarith
  refine ⟨min δE (min δW (δs / CW)), lt_min hδE (lt_min hδW (div_pos hδs hCW0)), ?_⟩
  intro κ hκ
  obtain ⟨Lk, hLk0, hGk⟩ := hG κ hκ
  have hκ0 : 0 < κ := by linarith
  obtain ⟨Λ₂, hΛ₂def⟩ : ∃ Λ₂ : ℝ, Λ₂ = 32 * κ ^ 5 * Lk := ⟨_, rfl⟩
  refine ⟨16 * κ ^ 5 * Lk, by positivity, ?_⟩
  intro p q hp hq τ
  have hpE : ‖ι p‖ ≤ δE := le_trans hp (min_le_left _ _)
  have hqE : ‖ι q‖ ≤ δE := le_trans hq (min_le_left _ _)
  have hpW : ‖ι p‖ ≤ δW := le_trans hp (le_trans (min_le_right _ _) (min_le_left _ _))
  have hqW : ‖ι q‖ ≤ δW := le_trans hq (le_trans (min_le_right _ _) (min_le_left _ _))
  have hpS : ‖ι p‖ ≤ δs / CW := le_trans hp (le_trans (min_le_right _ _) (min_le_right _ _))
  have hqS : ‖ι q‖ ≤ δs / CW := le_trans hq (le_trans (min_le_right _ _) (min_le_right _ _))
  
  
  
  have hkFlow_zero : ∀ r : 𝓢(ℝ, ℝ), hkFlow κ 0 r = r := by
    intro r
    unfold hkFlow
    split_ifs with h
    · exact (Classical.choose_spec h).2
    · rfl
  have hdist : ∀ a b : 𝓢(ℝ, ℝ), dist (ι a) (ι b) = ‖toHm1 a - toHm1 b‖ := by
    intro a b
    rw [dist_eq_norm]
    rfl
  
  
  
  have hsmall : ∀ r : 𝓢(ℝ, ℝ), ‖ι r‖ ≤ δW → ‖ι r‖ ≤ δs / CW →
      ∀ t : ℝ, ‖ι (hkFlow κ t r)‖ ≤ δs := by
    intro r hrW hrS t
    have h1 := hW κ hκ r hrW t 1 le_rfl
    rw [(Hm1_weight_basic _).1, (Hm1_weight_basic _).1] at h1
    have h2 : ‖(ι r : Lp ℂ 2 (volume : Measure ℝ))‖ ^ 2 ≤ (δs / CW) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) hrS 2
    have h3 : CW * (δs / CW) ^ 2 ≤ δs ^ 2 := by
      rw [div_pow, mul_div_assoc', div_le_iff₀ (by positivity)]
      nlinarith [mul_nonneg (mul_nonneg hCW0.le (sq_nonneg δs)) (sub_nonneg.2 hCW)]
    have h4 : ‖(ι (hkFlow κ t r) : Lp ℂ 2 (volume : Measure ℝ))‖ ^ 2 ≤ δs ^ 2 := by
      nlinarith [mul_le_mul_of_nonneg_left h2 hCW0.le]
    exact (abs_le_of_sq_le_sq' h4 hδs.le).2
  
  
  
  have hgreen : ∀ r : 𝓢(ℝ, ℝ), ‖ι r‖ ≤ δU → GreenODE κ r (greenOffset κ r) := by
    intro r hr
    have hex := (hU κ hκ r hr).exists
    unfold greenOffset
    rw [dif_pos hex]
    exact Classical.choose_spec hex
  
  
  
  have hE1 : ∀ t : ℝ, ∃ v : 𝓢(ℝ, ℝ), HasDerivAt (fun t => hkFlow κ t q) v t ∧
      ∀ x : ℝ, v x = hkRHS κ (hkFlow κ t q) x := hE κ hκ q hqE
  have hE2 : ∀ t : ℝ, ∃ v : 𝓢(ℝ, ℝ), HasDerivAt (fun t => hkFlow κ t p) v t ∧
      ∀ x : ℝ, v x = hkRHS κ (hkFlow κ t p) x := hE κ hκ p hpE
  choose V₁ hV₁d hV₁e using hE1
  choose V₂ hV₂d hV₂e using hE2
  have hD : ∀ s : ℝ, HasDerivAt
      (fun s => ‖toHm1 (hkFlow κ s q) - toHm1 (hkFlow κ s p)‖ ^ 2)
      (2 * inner ℝ (toHm1 (hkFlow κ s q) - toHm1 (hkFlow κ s p))
        (toHm1 (V₁ s) - toHm1 (V₂ s))) s := by
    intro s
    have h1 := s8 _ _ s (hV₁d s)
    have h2 := s8 _ _ s (hV₂d s)
    simp only [hLc] at h1 h2
    exact (h1.sub h2).norm_sq
  have hbd : ∀ s : ℝ, |2 * inner ℝ (toHm1 (hkFlow κ s q) - toHm1 (hkFlow κ s p))
        (toHm1 (V₁ s) - toHm1 (V₂ s))| ≤
      Λ₂ * ‖toHm1 (hkFlow κ s q) - toHm1 (hkFlow κ s p)‖ ^ 2 := by
    intro s
    have e1 := hV₁e s
    have e2 := hV₂e s
    have hp₁s := hsmall q hqW hqS s
    have hp₂s := hsmall p hpW hpS s
    generalize hkFlow κ s q = p₁ at e1 hp₁s ⊢
    generalize hkFlow κ s p = p₂ at e2 hp₂s ⊢
    obtain ⟨w, hwdef⟩ : ∃ w : 𝓢(ℝ, ℝ),
        w = SchwartzMap.derivCLM ℝ ℝ (greenOffset κ p₁ - greenOffset κ p₂) := ⟨_, rfl⟩
    obtain ⟨f', hf'def⟩ : ∃ f' : 𝓢(ℝ, ℝ), f' = SchwartzMap.derivCLM ℝ ℝ (p₁ - p₂) :=
      ⟨_, rfl⟩
    have hw : ∀ x : ℝ, w x = deriv (greenOffset κ p₁ : ℝ → ℝ) x -
        deriv (greenOffset κ p₂ : ℝ → ℝ) x := by
      intro x
      rw [hwdef, SchwartzMap.derivCLM_apply]
      have : ((greenOffset κ p₁ - greenOffset κ p₂ : 𝓢(ℝ, ℝ)) : ℝ → ℝ) =
          fun y => greenOffset κ p₁ y - greenOffset κ p₂ y := by
        funext y; simp
      rw [this]
      exact deriv_sub (greenOffset κ p₁).differentiableAt (greenOffset κ p₂).differentiableAt
    have hf'2 : ∀ x : ℝ, f' x = deriv ((p₁ - p₂ : 𝓢(ℝ, ℝ)) : ℝ → ℝ) x := by
      intro x
      rw [hf'def, SchwartzMap.derivCLM_apply]
    have hf' : ∀ x : ℝ, f' x = deriv (p₁ : ℝ → ℝ) x - deriv (p₂ : ℝ → ℝ) x := by
      intro x
      rw [hf'2]
      have : ((p₁ - p₂ : 𝓢(ℝ, ℝ)) : ℝ → ℝ) = fun y => p₁ y - p₂ y := by
        funext y; simp
      rw [this]
      exact deriv_sub p₁.differentiableAt p₂.differentiableAt
    have hVdiff : V₁ s - V₂ s = (16 * κ ^ 5) • w + (4 * κ ^ 2) • f' := by
      ext x
      simp only [SchwartzMap.sub_apply, SchwartzMap.add_apply, SchwartzMap.smul_apply,
        smul_eq_mul]
      rw [e1 x, e2 x, hw x, hf' x]
      simp only [hkRHS]
      ring
    have hLV : toHm1 (V₁ s) - toHm1 (V₂ s) =
        (16 * κ ^ 5) • toHm1 w + (4 * κ ^ 2) • toHm1 f' := by
      have := congrArg Lc hVdiff
      rw [map_sub, map_add, map_smul, map_smul] at this
      simp only [hLc] at this
      exact this
    have hLx : toHm1 p₁ - toHm1 p₂ = toHm1 (p₁ - p₂) := by
      have := (map_sub Lc p₁ p₂).symm
      simp only [hLc] at this
      exact this
    have htr : inner ℝ (toHm1 (p₁ - p₂)) (toHm1 f') = 0 := s6 _ _ (s5 (p₁ - p₂) f' hf'2)
    have hwb : ‖toHm1 w‖ ≤ Lk * ‖toHm1 p₁ - toHm1 p₂‖ := by
      have := hGk p₁ p₂ (greenOffset κ p₁) (greenOffset κ p₂) w (le_trans hp₁s hsG)
        (le_trans hp₂s hsG) (hgreen p₁ (le_trans hp₁s hsU)) (hgreen p₂ (le_trans hp₂s hsU)) hw
      rw [hdist] at this
      exact this
    rw [hLV, inner_add_right, real_inner_smul_right, real_inner_smul_right, hLx, htr, ← hLx,
      mul_zero, add_zero, hΛ₂def]
    have hk5 : 0 ≤ 16 * κ ^ 5 := by positivity
    rw [abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2), abs_of_nonneg hk5]
    have hx0 := norm_nonneg (toHm1 p₁ - toHm1 p₂)
    have hin := abs_real_inner_le_norm (toHm1 p₁ - toHm1 p₂) (toHm1 w)
    calc 2 * (16 * κ ^ 5 * |inner ℝ (toHm1 p₁ - toHm1 p₂) (toHm1 w)|)
        ≤ 2 * (16 * κ ^ 5 * (‖toHm1 p₁ - toHm1 p₂‖ * (Lk * ‖toHm1 p₁ - toHm1 p₂‖))) := by
          gcongr
          exact hin.trans (mul_le_mul_of_nonneg_left hwb hx0)
      _ = 32 * κ ^ 5 * Lk * ‖toHm1 p₁ - toHm1 p₂‖ ^ 2 := by ring
  have hg := s7 (fun s => ‖toHm1 (hkFlow κ s q) - toHm1 (hkFlow κ s p)‖ ^ 2)
    (fun s => 2 * inner ℝ (toHm1 (hkFlow κ s q) - toHm1 (hkFlow κ s p))
        (toHm1 (V₁ s) - toHm1 (V₂ s))) Λ₂ hD hbd τ
  simp only [hkFlow_zero] at hg
  
  
  
  have hexp : Real.exp (Λ₂ * |τ|) =
      Real.exp (16 * κ ^ 5 * Lk * |τ|) * Real.exp (16 * κ ^ 5 * Lk * |τ|) := by
    rw [← Real.exp_add, hΛ₂def]; ring_nf
  rw [hexp] at hg
  have hY := norm_nonneg (toHm1 q - toHm1 p)
  have hEp := Real.exp_pos (16 * κ ^ 5 * Lk * |τ|)
  have hsq2 : ‖toHm1 (hkFlow κ τ q) - toHm1 (hkFlow κ τ p)‖ ^ 2 ≤
      (Real.exp (16 * κ ^ 5 * Lk * |τ|) * ‖toHm1 q - toHm1 p‖) ^ 2 := by
    calc _ ≤ _ := hg
      _ = _ := by ring
  have hfin := (abs_le_of_sq_le_sq' hsq2 (mul_nonneg hEp.le hY)).2
  rw [← dist_eq_norm, ← dist_eq_norm, hdist, hdist]
  exact hfin

theorem linear_ode_decay_solution (c : ℝ) (hc : c ≠ 0) (a b : 𝓢(ℝ, ℝ)) :
    ∃ z : ℝ → ℝ, (∀ x : ℝ, HasDerivAt z ((c + a x) * z x + b x) x) ∧
      ∀ k : ℕ, ∃ C : ℝ, ∀ x : ℝ, |x| ^ k * |z x| ≤ C :=
by
  have key : ∀ l : ℝ, 0 < l → ∀ f g : ℝ → ℝ, Continuous f → Integrable f (volume : Measure ℝ) →
      Continuous g → (∀ k : ℕ, ∃ C : ℝ, ∀ x : ℝ, |x| ^ k * |g x| ≤ C) →
      ∃ z : ℝ → ℝ, (∀ x : ℝ, HasDerivAt z ((-l + f x) * z x + g x) x) ∧
        ∀ k : ℕ, ∃ C : ℝ, ∀ x : ℝ, |x| ^ k * |z x| ≤ C := by
    intro l hl f g hf hfi hg hdec
    have hl0 : l ≠ 0 := hl.ne'
    obtain ⟨C₀, hC₀⟩ := hdec 0
    have hg0 : ∀ y, |g y| ≤ C₀ := fun y => by simpa using hC₀ y
    have hC₀0 : 0 ≤ C₀ := le_trans (abs_nonneg _) (hg0 0)
    have hkc : Continuous (fun y => Real.exp (l * y) * |g y|) := by fun_prop
    have hint : ∀ x : ℝ, IntegrableOn (fun y => Real.exp (l * y) * |g y|) (Set.Iic x) volume := by
      intro x
      refine Integrable.mono' ((integrableOn_exp_mul_Iic hl x).const_mul C₀)
        hkc.aestronglyMeasurable (ae_of_all _ fun y => ?_)
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (Real.exp_pos _).le (abs_nonneg _)),
        mul_comm C₀]
      exact mul_le_mul_of_nonneg_left (hg0 y) (Real.exp_pos _).le
    
    have hdecK : ∀ k : ℕ, ∃ K : ℝ, ∀ x : ℝ,
        |x| ^ k * (Real.exp (-l * x) * ∫ y in Set.Iic x, Real.exp (l * y) * |g y|) ≤ K := by
      intro k
      obtain ⟨Ck, hCk⟩ := hdec k
      have hCk0 : 0 ≤ Ck :=
        le_trans (mul_nonneg (pow_nonneg (abs_nonneg _) _) (abs_nonneg _)) (hCk 0)
      have h2l : (0 : ℝ) ≤ (2 / l) ^ k := pow_nonneg (div_nonneg (by norm_num) hl.le) k
      obtain ⟨F, hF⟩ : ∃ F : ℝ, F = (k.factorial : ℝ) * (2 / l) ^ k := ⟨_, rfl⟩
      have hF0 : 0 ≤ F := by rw [hF]; exact mul_nonneg (Nat.cast_nonneg _) h2l
      obtain ⟨D, hD⟩ : ∃ D : ℝ, D = 2 ^ (k - 1) * (Ck + C₀ * F) := ⟨_, rfl⟩
      have hpow : (0 : ℝ) ≤ 2 ^ (k - 1) := by positivity
      have hD0 : 0 ≤ D := by
        rw [hD]; exact mul_nonneg hpow (add_nonneg hCk0 (mul_nonneg hC₀0 hF0))
      refine ⟨2 * D / l, fun x => ?_⟩
      have hpt : ∀ y ∈ Set.Iic x, |x| ^ k * (Real.exp (l * y) * |g y|) ≤
          D * Real.exp (l / 2 * x) * Real.exp (l / 2 * y) := by
        intro y hy
        have hy' : y ≤ x := hy
        have ht : 0 ≤ x - y := by linarith
        have hax : |x| ≤ |y| + (x - y) := by
          have h := abs_add_le y (x - y)
          rw [show y + (x - y) = x by ring, abs_of_nonneg ht] at h
          exact h
        have hpe : |x| ^ k ≤ 2 ^ (k - 1) * (|y| ^ k + (x - y) ^ k) :=
          (pow_le_pow_left₀ (abs_nonneg x) hax k).trans (add_pow_le (abs_nonneg y) ht k)
        have hlt : 0 ≤ l * (x - y) := mul_nonneg hl.le ht
        have hfac : (x - y) ^ k ≤ F * Real.exp (l * (x - y) / 2) := by
          have h1 := Real.pow_div_factorial_le_exp (l * (x - y) / 2) (div_nonneg hlt (by norm_num : (0 : ℝ) ≤ 2)) k
          have hf : (0 : ℝ) < k.factorial := by exact_mod_cast Nat.factorial_pos k
          rw [div_le_iff₀ hf] at h1
          have h2 : (l * (x - y) / 2) ^ k = (l / 2) ^ k * (x - y) ^ k := by
            rw [← mul_pow]; ring
          have h3 : (2 / l) ^ k * (l / 2) ^ k = 1 := by
            rw [← mul_pow, show 2 / l * (l / 2) = 1 by field_simp, one_pow]
          calc (x - y) ^ k = (2 / l) ^ k * ((l / 2) ^ k * (x - y) ^ k) := by
                rw [← mul_assoc, h3, one_mul]
            _ ≤ (2 / l) ^ k * (Real.exp (l * (x - y) / 2) * k.factorial) := by
                rw [← h2]; exact mul_le_mul_of_nonneg_left h1 h2l
            _ = F * Real.exp (l * (x - y) / 2) := by rw [hF]; ring
        have hA : |x| ^ k * |g y| ≤ 2 ^ (k - 1) * (Ck + C₀ * F * Real.exp (l * (x - y) / 2)) := by
          have h0 := mul_le_mul_of_nonneg_right hpe (abs_nonneg (g y))
          have h1 : |y| ^ k * |g y| ≤ Ck := hCk y
          have h2 : (x - y) ^ k * |g y| ≤ (F * Real.exp (l * (x - y) / 2)) * C₀ :=
            mul_le_mul hfac (hg0 y) (abs_nonneg _) (mul_nonneg hF0 (Real.exp_pos _).le)
          calc |x| ^ k * |g y| ≤ 2 ^ (k - 1) * (|y| ^ k + (x - y) ^ k) * |g y| := h0
            _ = 2 ^ (k - 1) * (|y| ^ k * |g y| + (x - y) ^ k * |g y|) := by ring
            _ ≤ 2 ^ (k - 1) * (Ck + (F * Real.exp (l * (x - y) / 2)) * C₀) :=
                mul_le_mul_of_nonneg_left (add_le_add h1 h2) hpow
            _ = _ := by ring
        have hd : Real.exp (l * y) = Real.exp (l * x) * Real.exp (-(l * (x - y))) := by
          rw [← Real.exp_add]; congr 1; ring
        have h12 : Real.exp (l * (x - y) / 2) * Real.exp (-(l * (x - y))) =
            Real.exp (-(l * (x - y)) / 2) := by
          rw [← Real.exp_add]; congr 1; ring
        have h23 : Real.exp (-(l * (x - y))) ≤ Real.exp (-(l * (x - y)) / 2) := by
          apply Real.exp_le_exp.2
          linarith
        have h3P : Real.exp (-(l * (x - y)) / 2) * Real.exp (l * x) =
            Real.exp (l / 2 * x) * Real.exp (l / 2 * y) := by
          rw [← Real.exp_add, ← Real.exp_add]; congr 1; ring
        have hP := Real.exp_pos (l * x)
        have he2 := Real.exp_pos (-(l * (x - y)))
        have hCe := mul_le_mul_of_nonneg_left h23 hCk0
        calc |x| ^ k * (Real.exp (l * y) * |g y|)
            = (|x| ^ k * |g y|) * (Real.exp (l * x) * Real.exp (-(l * (x - y)))) := by
              rw [hd]; ring
          _ ≤ (2 ^ (k - 1) * (Ck + C₀ * F * Real.exp (l * (x - y) / 2))) *
                (Real.exp (l * x) * Real.exp (-(l * (x - y)))) :=
              mul_le_mul_of_nonneg_right hA (mul_pos hP he2).le
          _ = 2 ^ (k - 1) * (Ck * Real.exp (-(l * (x - y))) + C₀ * F *
                (Real.exp (l * (x - y) / 2) * Real.exp (-(l * (x - y))))) *
                Real.exp (l * x) := by ring
          _ = 2 ^ (k - 1) * (Ck * Real.exp (-(l * (x - y))) + C₀ * F *
                Real.exp (-(l * (x - y)) / 2)) * Real.exp (l * x) := by rw [h12]
          _ ≤ 2 ^ (k - 1) * (Ck * Real.exp (-(l * (x - y)) / 2) + C₀ * F *
                Real.exp (-(l * (x - y)) / 2)) * Real.exp (l * x) := by
              apply mul_le_mul_of_nonneg_right _ hP.le
              apply mul_le_mul_of_nonneg_left _ hpow
              linarith
          _ = D * (Real.exp (-(l * (x - y)) / 2) * Real.exp (l * x)) := by rw [hD]; ring
          _ = D * Real.exp (l / 2 * x) * Real.exp (l / 2 * y) := by rw [h3P]; ring
      have hl2 : 0 < l / 2 := half_pos hl
      have hmono := setIntegral_mono_on ((hint x).const_mul (|x| ^ k))
        ((integrableOn_exp_mul_Iic hl2 x).const_mul (D * Real.exp (l / 2 * x)))
        measurableSet_Iic hpt
      rw [integral_const_mul, integral_const_mul, integral_exp_mul_Iic hl2 x] at hmono
      have hE := Real.exp_pos (-l * x)
      have h1 : Real.exp (-l * x) * (Real.exp (l / 2 * x) * Real.exp (l / 2 * x)) = 1 := by
        rw [← Real.exp_add, ← Real.exp_add, show -l * x + (l / 2 * x + l / 2 * x) = 0 by ring,
          Real.exp_zero]
      calc |x| ^ k * (Real.exp (-l * x) * ∫ y in Set.Iic x, Real.exp (l * y) * |g y|)
          = Real.exp (-l * x) * (|x| ^ k * ∫ y in Set.Iic x, Real.exp (l * y) * |g y|) := by
            ring
        _ ≤ Real.exp (-l * x) * (D * Real.exp (l / 2 * x) * (Real.exp (l / 2 * x) / (l / 2))) :=
            mul_le_mul_of_nonneg_left hmono hE.le
        _ = D * (Real.exp (-l * x) * (Real.exp (l / 2 * x) * Real.exp (l / 2 * x))) * (2 / l) := by
            ring
        _ = 2 * D / l := by rw [h1]; ring
    
    obtain ⟨A, hA⟩ : ∃ A : ℝ → ℝ, ∀ t, A t = ∫ y in (0 : ℝ)..t, f y := ⟨_, fun _ => rfl⟩
    obtain ⟨α, hα⟩ : ∃ α : ℝ, α = ∫ y, ‖f y‖ := ⟨_, rfl⟩
    have hAf : A = fun t => ∫ y in (0 : ℝ)..t, f y := funext hA
    have hAd : ∀ t, HasDerivAt A (f t) t := by
      intro t; rw [hAf]; exact (hf.integral_hasStrictDerivAt 0 t).hasDerivAt
    have hAc : Continuous A := by
      rw [hAf]; exact intervalIntegral.continuous_primitive (fun u v => hf.intervalIntegrable u v) 0
    have hAb : ∀ y, |A y| ≤ α := by
      intro y
      rw [hA, ← Real.norm_eq_abs, hα]
      refine (intervalIntegral.norm_integral_le_integral_norm_uIoc).trans ?_
      exact setIntegral_le_integral hfi.norm (ae_of_all _ fun _ => norm_nonneg _)
    obtain ⟨F, hF⟩ : ∃ F : ℝ → ℝ, ∀ y, F y = Real.exp (l * y - A y) * g y := ⟨_, fun _ => rfl⟩
    have hFf : F = fun y => Real.exp (l * y - A y) * g y := funext hF
    have hFc : Continuous F := by rw [hFf]; fun_prop
    have hFb : ∀ y, ‖F y‖ ≤ Real.exp α * (Real.exp (l * y) * |g y|) := by
      intro y
      rw [hF, Real.norm_eq_abs, abs_mul, Real.abs_exp, ← mul_assoc, ← Real.exp_add]
      apply mul_le_mul_of_nonneg_right _ (abs_nonneg _)
      apply Real.exp_le_exp.2
      have := (abs_le.1 (hAb y)).1
      linarith
    have hFint : ∀ x, IntegrableOn F (Set.Iic x) := fun x =>
      Integrable.mono' ((hint x).const_mul (Real.exp α)) hFc.aestronglyMeasurable
        (ae_of_all _ hFb)
    obtain ⟨J, hJ⟩ : ∃ J : ℝ → ℝ, ∀ t, J t = ∫ y in Set.Iic t, F y := ⟨_, fun _ => rfl⟩
    have hJd : ∀ x, HasDerivAt J (F x) x := by
      intro x
      have hJf : J = fun t => J 0 + ∫ y in (0 : ℝ)..t, F y := by
        funext t
        have := intervalIntegral.integral_Iic_sub_Iic (hFint 0) (hFint t)
        rw [hJ t, hJ 0]
        linarith
      rw [hJf]
      exact ((hFc.integral_hasStrictDerivAt 0 x).hasDerivAt).const_add _
    obtain ⟨E, hE⟩ : ∃ E : ℝ → ℝ, ∀ t, E t = Real.exp (-l * t + A t) := ⟨_, fun _ => rfl⟩
    have hEf : E = fun t => Real.exp (-l * t + A t) := funext hE
    have hEd : ∀ x, HasDerivAt E (E x * (-l + f x)) x := by
      intro x
      have h0 : HasDerivAt (fun t => -l * t + A t) (-l + f x) x :=
        (((hasDerivAt_id' x).const_mul (-l)).add (hAd x)).congr_deriv (by ring)
      rw [hEf]
      exact h0.exp
    have hEF : ∀ x, E x * Real.exp (l * x - A x) = 1 := by
      intro x
      rw [hE, ← Real.exp_add, show -l * x + A x + (l * x - A x) = 0 by ring, Real.exp_zero]
    refine ⟨fun t => E t * J t, fun x => ?_, fun k => ?_⟩
    · exact ((hEd x).mul (hJd x)).congr_deriv (by rw [hF]; linear_combination (g x) * hEF x)
    · obtain ⟨K, hK⟩ := hdecK k
      refine ⟨Real.exp α * Real.exp α * K, fun x => ?_⟩
      show |x| ^ k * |E x * J x| ≤ Real.exp α * Real.exp α * K
      have hJb : |J x| ≤ Real.exp α * ∫ y in Set.Iic x, Real.exp (l * y) * |g y| := by
        rw [hJ, ← Real.norm_eq_abs, ← integral_const_mul]
        exact norm_integral_le_of_norm_le ((hint x).const_mul _) (ae_of_all _ hFb)
      have hEb : E x ≤ Real.exp α * Real.exp (-l * x) := by
        rw [hE, ← Real.exp_add]
        apply Real.exp_le_exp.2
        have := (abs_le.1 (hAb x)).2
        linarith
      have hEpos : 0 < E x := by rw [hE]; exact Real.exp_pos _
      have hzb : |E x * J x| ≤ Real.exp α * Real.exp α *
          (Real.exp (-l * x) * ∫ y in Set.Iic x, Real.exp (l * y) * |g y|) := by
        rw [abs_mul, abs_of_pos hEpos]
        calc E x * |J x| ≤ (Real.exp α * Real.exp (-l * x)) *
              (Real.exp α * ∫ y in Set.Iic x, Real.exp (l * y) * |g y|) :=
            mul_le_mul hEb hJb (abs_nonneg _) (by positivity)
          _ = _ := by ring
      have hxk : 0 ≤ |x| ^ k := by positivity
      have hM : 0 ≤ Real.exp α * Real.exp α := by positivity
      calc |x| ^ k * |E x * J x| ≤ |x| ^ k * (Real.exp α * Real.exp α *
            (Real.exp (-l * x) * ∫ y in Set.Iic x, Real.exp (l * y) * |g y|)) :=
          mul_le_mul_of_nonneg_left hzb hxk
        _ = Real.exp α * Real.exp α * (|x| ^ k *
            (Real.exp (-l * x) * ∫ y in Set.Iic x, Real.exp (l * y) * |g y|)) := by ring
        _ ≤ Real.exp α * Real.exp α * K := mul_le_mul_of_nonneg_left (hK x) hM
  
  have hS : ∀ s : 𝓢(ℝ, ℝ), ∀ k : ℕ, ∃ C : ℝ, ∀ x : ℝ, |x| ^ k * |s x| ≤ C := by
    intro s k
    obtain ⟨C, -, hC⟩ := s.decay k 0
    refine ⟨C, fun x => ?_⟩
    have := hC x
    rwa [norm_iteratedFDeriv_zero, Real.norm_eq_abs, Real.norm_eq_abs] at this
  rcases lt_or_gt_of_ne hc with hneg | hpos
  · obtain ⟨z, hz, hzd⟩ := key (-c) (by linarith) a b a.continuous (a.integrable (μ := volume))
      b.continuous (hS b)
    refine ⟨z, fun x => ?_, hzd⟩
    have := hz x
    rwa [neg_neg] at this
  · have hbd : ∀ k : ℕ, ∃ C : ℝ, ∀ x : ℝ, |x| ^ k * |(fun y => -b (-y)) x| ≤ C := by
      intro k
      obtain ⟨C, hC⟩ := hS b k
      refine ⟨C, fun x => ?_⟩
      have := hC (-x)
      rw [abs_neg] at this
      simpa only [abs_neg] using this
    obtain ⟨Z, hZ, hZd⟩ := key c hpos (fun y => -a (-y)) (fun y => -b (-y))
      (a.continuous.comp continuous_neg).neg ((a.integrable (μ := volume)).comp_neg.neg)
      (b.continuous.comp continuous_neg).neg hbd
    refine ⟨fun x => Z (-x), fun x => ?_, fun k => ?_⟩
    · have h := (hZ (-x)).comp x (hasDerivAt_neg x)
      refine h.congr_deriv ?_
      simp only [neg_neg]
      ring
    · obtain ⟨C, hC⟩ := hZd k
      refine ⟨C, fun x => ?_⟩
      have := hC (-x)
      rwa [abs_neg] at this

theorem green_linearized_bound : ∃ δ > (0 : ℝ), ∀ κ ≥ (1 : ℝ), ∃ L ≥ (0 : ℝ), ∀ q : 𝓢(ℝ, ℝ),
    ‖ι q‖ ≤ δ → ∀ f : 𝓢(ℝ, ℝ), (∃ e : 𝓢(ℝ, ℝ), LinGreenODE κ q f e) ∧
    ∀ e : 𝓢(ℝ, ℝ), LinGreenODE κ q f e → ‖ι (SchwartzMap.derivCLM ℝ ℝ e)‖ ≤ L * ‖ι f‖ :=
by
  classical
  obtain ⟨δU, hδU, hU⟩ := green_exists_unique
  refine ⟨min (1 / 8) δU, lt_min (by norm_num) hδU, ?_⟩
  intro κ hκ
  refine ⟨3, by norm_num, ?_⟩
  intro q hq f
  have hκ0 : (0 : ℝ) < κ := by linarith
  have hq8 : ‖toHm1 q‖ ≤ 1 / 8 := le_trans hq (min_le_left _ _)
  have hqU : ‖ι q‖ ≤ δU := le_trans hq (min_le_right _ _)
  
  have hG0 : GreenODE κ q (greenOffset κ q) := by
    have hex := (hU κ hκ q hqU).exists
    unfold greenOffset
    rw [dif_pos hex]
    exact Classical.choose_spec hex
  obtain ⟨γ, hγdef⟩ : ∃ γ : 𝓢(ℝ, ℝ), γ = greenOffset κ q := ⟨_, rfl⟩
  have hG : GreenODE κ q γ := by rw [hγdef]; exact hG0
  
  obtain ⟨hKqm, hKqeq⟩ := riccatiK_sq_integral κ hκ0 q
  have hsK : ∫ x : ℝ, riccatiK κ q x ^ 2 ≤ 1 / 64 := by
    rw [hKqeq]
    have h1 := ((Hm1_weight_basic (toHm1 q)).2 κ hκ).2.1
    have h3 : ‖toHm1 q‖ ^ 2 ≤ (1 / 8) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hq8 2
    have h4 : ((1 : ℝ) / 8) ^ 2 = 1 / 64 := by norm_num
    linarith
  obtain ⟨⟨ρ, hρ⟩, -⟩ := riccati_fixed_point κ hκ q hKqm hsK
  obtain ⟨hρc, hρb, hρtop, hρbot, hρd⟩ := riccati_sol_regularity κ hκ0 q ρ hρ
  
  have hsq16 : Real.sqrt (1 / 16) = 1 / 4 := by
    rw [show (1 / 16 : ℝ) = (1 / 4) ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
  have hSρ : Real.sqrt (∫ x : ℝ, ρ x ^ 2) ≤ 1 / 4 := by
    rw [← hsq16]
    exact Real.sqrt_le_sqrt hρ.2.1
  have hscale : ∀ (c : ℝ) (g : ℝ → ℝ), 0 ≤ c →
      Real.sqrt (∫ x : ℝ, (c * g x) ^ 2) = c * Real.sqrt (∫ x : ℝ, g x ^ 2) := by
    intro c g hc
    have : (fun x : ℝ => (c * g x) ^ 2) = fun x : ℝ => c ^ 2 * g x ^ 2 := by
      funext x; ring
    rw [this, integral_const_mul, Real.sqrt_mul (sq_nonneg c), Real.sqrt_sq hc]
  have hkinv0 : 0 ≤ κ⁻¹ := inv_nonneg.2 hκ0.le
  have hkinv1 : κ⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hκ
  have hscaleK : ∀ g : ℝ → ℝ, Real.sqrt (∫ x : ℝ, (κ⁻¹ * g x) ^ 2) ≤
      Real.sqrt (∫ x : ℝ, g x ^ 2) := by
    intro g
    rw [hscale _ _ hkinv0]
    have := Real.sqrt_nonneg (∫ x : ℝ, g x ^ 2)
    nlinarith
  have hdecay : ∀ F : 𝓢(ℝ, ℝ), Filter.Tendsto (⇑F) Filter.atTop (nhds 0) ∧
      Filter.Tendsto (⇑F) Filter.atBot (nhds 0) := by
    intro F
    have h := F.toZeroAtInfty.zero_at_infty'
    rw [cocompact_eq_atBot_atTop, Filter.tendsto_sup] at h
    exact ⟨h.2, h.1⟩
  have ode_zero : ∀ (m v u : ℝ → ℝ), Continuous m → (∀ x : ℝ, HasDerivAt v (u x) x) →
      (∀ x : ℝ, HasDerivAt u (m x * u x) x) → Filter.Tendsto v Filter.atTop (nhds 0) →
      Filter.Tendsto v Filter.atBot (nhds 0) → ∀ x : ℝ, v x = 0 := by
    intro m v u hm hv hu htop hbot
    obtain ⟨P, hP⟩ : ∃ P : ℝ → ℝ, ∀ x : ℝ, HasDerivAt P (m x) x :=
      ⟨fun x => ∫ t in (0 : ℝ)..x, m t, fun x => (hm.integral_hasStrictDerivAt 0 x).hasDerivAt⟩
    have hΦ : ∀ x : ℝ, HasDerivAt (fun y => u y * Real.exp (-P y)) 0 x := by
      intro x
      have := (hu x).mul ((hP x).neg.exp)
      convert this using 1
      ring
    have hconst : ∀ x : ℝ, u x * Real.exp (-P x) = u 0 * Real.exp (-P 0) := by
      intro x
      exact is_const_of_deriv_eq_zero (fun y => (hΦ y).differentiableAt)
        (fun y => (hΦ y).deriv) x 0
    obtain ⟨c, hc⟩ : ∃ c : ℝ, c = u 0 * Real.exp (-P 0) := ⟨_, rfl⟩
    have hu_eq : ∀ x : ℝ, u x = c * Real.exp (P x) := by
      intro x
      have h1 := hconst x
      have h2 : Real.exp (-P x) * Real.exp (P x) = 1 := by
        rw [← Real.exp_add]; simp
      calc u x = u x * Real.exp (-P x) * Real.exp (P x) := by rw [mul_assoc, h2, mul_one]
        _ = c * Real.exp (P x) := by rw [h1, hc]
    intro x
    rcases le_total 0 c with hc0 | hc0
    · have hmono : Monotone v := monotone_of_deriv_nonneg (fun y => (hv y).differentiableAt)
        (fun y => by rw [(hv y).deriv, hu_eq y]; exact mul_nonneg hc0 (Real.exp_pos _).le)
      have h1 := hmono.ge_of_tendsto htop x
      have h2 := hmono.le_of_tendsto hbot x
      linarith
    · have hanti : Antitone v := antitone_of_deriv_nonpos (fun y => (hv y).differentiableAt)
        (fun y => by
          rw [(hv y).deriv, hu_eq y]
          exact mul_nonpos_of_nonpos_of_nonneg hc0 (Real.exp_pos _).le)
      have h1 := hanti.le_of_tendsto htop x
      have h2 := hanti.ge_of_tendsto hbot x
      linarith
  have hN : ∀ (g : ℝ → ℝ) (hg : MemLp g 2 (volume : Measure ℝ)),
      ‖hg.toLp g‖ = Real.sqrt (∫ x : ℝ, g x ^ 2) := by
    intro g hg
    rw [Lp.norm_toLp, hg.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    have h2 : (2 : ENNReal).toReal = 2 := by norm_num
    have hint : ∫ a, ‖g a‖ ^ (2 : ℝ) = ∫ a, g a ^ 2 := by
      congr 1; funext a; rw [Real.rpow_two, Real.norm_eq_abs, sq_abs]
    rw [h2, hint, Real.sqrt_eq_rpow, one_div, ENNReal.toReal_ofReal]
    exact Real.rpow_nonneg (integral_nonneg fun _ => sq_nonneg _) _
  have hadd : ∀ g h : ℝ → ℝ, MemLp g 2 (volume : Measure ℝ) → MemLp h 2 (volume : Measure ℝ) →
      Real.sqrt (∫ x : ℝ, (g x + h x) ^ 2) ≤
        Real.sqrt (∫ x : ℝ, g x ^ 2) + Real.sqrt (∫ x : ℝ, h x ^ 2) := by
    intro g h hg hh
    have e := hN (g + h) (hg.add hh)
    rw [MemLp.toLp_add hg hh] at e
    simp only [Pi.add_apply] at e
    calc Real.sqrt (∫ x : ℝ, (g x + h x) ^ 2) = ‖hg.toLp g + hh.toLp h‖ := e.symm
      _ ≤ ‖hg.toLp g‖ + ‖hh.toLp h‖ := norm_add_le _ _
      _ = _ := by rw [hN g hg, hN h hh]
  have hnegI : ∀ g : ℝ → ℝ, ∫ x : ℝ, (-g x) ^ 2 = ∫ x : ℝ, g x ^ 2 := by
    intro g; congr 1; funext x; ring
  
  have hlinear : ∀ y a b e h : ℝ → ℝ,
      (∀ x : ℝ, HasDerivAt y (a x * y x + b x + e x * h x - 2 * κ * y x) x) →
      Filter.Tendsto y Filter.atBot (nhds 0) →
      MemLp y 2 (volume : Measure ℝ) → MemLp a 2 (volume : Measure ℝ) →
      MemLp b 2 (volume : Measure ℝ) → MemLp e 2 (volume : Measure ℝ) →
      MemLp h 2 (volume : Measure ℝ) →
      Real.sqrt (∫ x : ℝ, y x ^ 2) ≤
        1 / 2 * (Real.sqrt (∫ x : ℝ, a x ^ 2) * Real.sqrt (∫ x : ℝ, y x ^ 2)) +
        1 / 2 * Real.sqrt (∫ x : ℝ, b x ^ 2) +
        1 / 2 * (Real.sqrt (∫ x : ℝ, e x ^ 2) * Real.sqrt (∫ x : ℝ, h x ^ 2)) := by
    intro y a b e h hy hybot hy2 ha hb he hh
    have habsI : ∀ g : ℝ → ℝ, ∫ s : ℝ, |g s| ^ 2 = ∫ s : ℝ, g s ^ 2 := by
      intro g; congr 1; funext s; exact sq_abs _
    have key : ∀ Y A B E H : ℝ → ℝ,
        (∀ s, HasDerivAt Y (2 * κ * Y s - (A s * Y s + B s + E s * H s)) s) →
        Filter.Tendsto Y Filter.atTop (nhds 0) →
        MemLp Y 2 (volume : Measure ℝ) → MemLp A 2 (volume : Measure ℝ) →
        MemLp B 2 (volume : Measure ℝ) → MemLp E 2 (volume : Measure ℝ) →
        MemLp H 2 (volume : Measure ℝ) →
        Real.sqrt (∫ x : ℝ, Y x ^ 2) ≤
          1 / 2 * (Real.sqrt (∫ x : ℝ, A x ^ 2) * Real.sqrt (∫ x : ℝ, Y x ^ 2)) +
          1 / 2 * Real.sqrt (∫ x : ℝ, B x ^ 2) +
          1 / 2 * (Real.sqrt (∫ x : ℝ, E x ^ 2) * Real.sqrt (∫ x : ℝ, H x ^ 2)) := by
      intro Y A B E H hY hYtop hY2 hA hB hE hH
      have hYc : Continuous Y := continuous_iff_continuousAt.2 fun s => (hY s).continuousAt
      have hYn : Filter.Tendsto (fun s => ‖Y s‖) Filter.atTop (nhds 0) := by
        simpa using hYtop.norm
      have mA : AEStronglyMeasurable (fun s => |A s|) volume :=
        continuous_abs.comp_aestronglyMeasurable hA.1
      have mB : AEStronglyMeasurable (fun s => |B s|) volume :=
        continuous_abs.comp_aestronglyMeasurable hB.1
      have mE : AEStronglyMeasurable (fun s => |E s|) volume :=
        continuous_abs.comp_aestronglyMeasurable hE.1
      have mH : AEStronglyMeasurable (fun s => |H s|) volume :=
        continuous_abs.comp_aestronglyMeasurable hH.1
      have mY : AEStronglyMeasurable (fun s => |Y s|) volume :=
        continuous_abs.comp_aestronglyMeasurable hY2.1
      have iAY : Integrable (fun s => A s * Y s) volume := hA.integrable_mul hY2
      have iEH : Integrable (fun s => E s * H s) volume := hE.integrable_mul hH
      have hpt : ∀ x : ℝ, |Y x| ≤
          -riccatiK κ (fun s => |A s| * |Y s|) x + -riccatiK κ (fun s => |B s|) x +
            -riccatiK κ (fun s => |E s| * |H s|) x := by
        intro x
        have cex : Continuous (fun s : ℝ => Real.exp (2 * κ * (x - s))) := by fun_prop
        have hEx : ∀ s ∈ Set.Ioi x, ‖Real.exp (2 * κ * (x - s))‖ ≤ 1 := by
          intro s hs
          rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
          apply Real.exp_le_one_iff.2
          have : x < s := hs
          nlinarith
        have I1 : IntegrableOn (fun s => Real.exp (2 * κ * (x - s)) * (|A s| * |Y s|))
            (Set.Ioi x) := by
          refine Integrable.mono' iAY.norm.integrableOn
            ((cex.aestronglyMeasurable.mul (mA.mul mY)).restrict) ?_
          refine (ae_restrict_mem measurableSet_Ioi).mono fun s hs => ?_
          have h1 := hEx s hs
          rw [Real.norm_eq_abs] at h1
          simp only [Real.norm_eq_abs, abs_mul, abs_abs]
          exact mul_le_of_le_one_left (by positivity) h1
        have I3 : IntegrableOn (fun s => Real.exp (2 * κ * (x - s)) * (|E s| * |H s|))
            (Set.Ioi x) := by
          refine Integrable.mono' iEH.norm.integrableOn
            ((cex.aestronglyMeasurable.mul (mE.mul mH)).restrict) ?_
          refine (ae_restrict_mem measurableSet_Ioi).mono fun s hs => ?_
          have h1 := hEx s hs
          rw [Real.norm_eq_abs] at h1
          simp only [Real.norm_eq_abs, abs_mul, abs_abs]
          exact mul_le_of_le_one_left (by positivity) h1
        have I2 : IntegrableOn (fun s => Real.exp (2 * κ * (x - s)) * |B s|) (Set.Ioi x) := by
          have ib : IntegrableOn (fun s => Real.exp (4 * κ * x) * Real.exp (-(4 * κ) * s)
              + B s ^ 2) (Set.Ioi x) :=
            ((exp_neg_integrableOn_Ioi x (by positivity : (0 : ℝ) < 4 * κ)).const_mul
              (Real.exp (4 * κ * x))).add hB.integrable_sq.integrableOn
          refine Integrable.mono' ib ((cex.aestronglyMeasurable.mul mB).restrict) ?_
          refine Filter.Eventually.of_forall fun s => ?_
          have ht := Real.exp_pos (2 * κ * (x - s))
          have hsq : Real.exp (2 * κ * (x - s)) ^ 2 =
              Real.exp (4 * κ * x) * Real.exp (-(4 * κ) * s) := by
            rw [sq, ← Real.exp_add, ← Real.exp_add]; congr 1; ring
          rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_abs, abs_of_pos ht, ← hsq]
          nlinarith [sq_nonneg (Real.exp (2 * κ * (x - s)) - |B s|), sq_abs (B s),
            abs_nonneg (B s)]
        have Ig : IntegrableOn (fun s => Real.exp (2 * κ * (x - s)) *
            (|A s| * |Y s| + |B s| + |E s| * |H s|)) (Set.Ioi x) := by
          refine IntegrableOn.congr_fun ((I1.add I2).add I3) (fun s _ => ?_) measurableSet_Ioi
          simp only [Pi.add_apply]
          ring
        have mF : AEStronglyMeasurable (fun s => A s * Y s + B s + E s * H s) volume :=
          ((hA.1.mul hY2.1).add hB.1).add (hE.1.mul hH.1)
        have hFle : ∀ s, ‖Real.exp (2 * κ * (x - s)) * (A s * Y s + B s + E s * H s)‖ ≤
            Real.exp (2 * κ * (x - s)) * (|A s| * |Y s| + |B s| + |E s| * |H s|) := by
          intro s
          rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
          refine mul_le_mul_of_nonneg_left ?_ (Real.exp_pos _).le
          calc |A s * Y s + B s + E s * H s| ≤ |A s * Y s + B s| + |E s * H s| :=
                abs_add_le _ _
            _ ≤ |A s * Y s| + |B s| + |E s * H s| := by
                have := abs_add_le (A s * Y s) (B s); linarith
            _ = |A s| * |Y s| + |B s| + |E s| * |H s| := by rw [abs_mul, abs_mul]
        have IF : IntegrableOn (fun s => -(Real.exp (2 * κ * (x - s)) *
            (A s * Y s + B s + E s * H s))) (Set.Ioi x) := by
          refine Integrable.mono' Ig ((cex.aestronglyMeasurable.mul mF).neg.restrict) ?_
          refine Filter.Eventually.of_forall fun s => ?_
          rw [norm_neg]
          exact hFle s
        have hG' : ∀ s ∈ Set.Ioi x, HasDerivAt (fun s => Real.exp (2 * κ * (x - s)) * Y s)
            (-(Real.exp (2 * κ * (x - s)) * (A s * Y s + B s + E s * H s))) s := by
          intro s _
          have h1 : HasDerivAt (fun s => Real.exp (2 * κ * (x - s)))
              (Real.exp (2 * κ * (x - s)) * (2 * κ * (-1))) s :=
            (((hasDerivAt_id' s).const_sub x).const_mul (2 * κ)).exp
          convert h1.mul (hY s) using 1
          ring
        have hGc : ContinuousWithinAt (fun s => Real.exp (2 * κ * (x - s)) * Y s)
            (Set.Ici x) x := (cex.mul hYc).continuousWithinAt
        have hGlim : Filter.Tendsto (fun s => Real.exp (2 * κ * (x - s)) * Y s)
            Filter.atTop (nhds 0) := by
          refine squeeze_zero_norm' ?_ hYn
          filter_upwards [Filter.eventually_gt_atTop x] with s hs
          rw [norm_mul]
          exact mul_le_of_le_one_left (norm_nonneg _) (hEx s hs)
        have hftc := integral_Ioi_of_hasDerivAt_of_tendsto hGc hG' IF hGlim
        rw [integral_neg] at hftc
        simp only [sub_self, mul_zero, Real.exp_zero, one_mul, zero_sub, neg_inj] at hftc
        have hbound : ‖∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) *
            (A s * Y s + B s + E s * H s)‖ ≤ ∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) *
            (|A s| * |Y s| + |B s| + |E s| * |H s|) :=
          norm_integral_le_of_norm_le Ig (Filter.Eventually.of_forall hFle)
        have hsplit : ∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) *
            (|A s| * |Y s| + |B s| + |E s| * |H s|) =
            (∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) * (|A s| * |Y s|)) +
            (∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) * |B s|) +
            (∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) * (|E s| * |H s|)) := by
          calc ∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) *
                (|A s| * |Y s| + |B s| + |E s| * |H s|)
              = ∫ s in Set.Ioi x, (Real.exp (2 * κ * (x - s)) * (|A s| * |Y s|) +
                  Real.exp (2 * κ * (x - s)) * |B s| +
                  Real.exp (2 * κ * (x - s)) * (|E s| * |H s|)) := by
                congr 1; funext s; ring
            _ = (∫ s in Set.Ioi x, (Real.exp (2 * κ * (x - s)) * (|A s| * |Y s|) +
                  Real.exp (2 * κ * (x - s)) * |B s|)) +
                  ∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) * (|E s| * |H s|) :=
                integral_add (I1.add I2) I3
            _ = _ := by rw [integral_add I1 I2]
        have hK : ∀ g : ℝ → ℝ, -riccatiK κ g x =
            ∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) * g s := by
          intro g
          unfold riccatiK
          rw [integral_Ici_eq_integral_Ioi, neg_neg]
