              ‖((ι (u t) : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 ≤
            C * ∫ ξ : ℝ, ((4 + ξ ^ 2) / (ξ ^ 2 + 4 * κ ^ 2)) *
              ‖((ι (u 0) : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 :=
by
  obtain ⟨δ, hδ, C₀, hC₀, hsmall⟩ := kdv_small_data_weight_control h_exists h_unique
  intro R hR
  
  obtain ⟨c, hc0, hc1, hcR⟩ : ∃ c : ℝ, 0 < c ∧ c ≤ 1 ∧ c * R ^ 2 ≤ δ ^ 2 := by
    refine ⟨min 1 (δ ^ 2 / (R ^ 2 + 1)),
