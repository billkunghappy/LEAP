    (fun x _ => sq_nonneg _)) (fun σ => ?_) h3
  exact hbound σ

theorem hm1T_hasDerivAt_of_L2_slopes_T : ∀ (u : ℝ → CinfT) (D : CinfT) (s : ℝ) (Wp Wm : ℝ → ℝ → ℝ) (Yp Ym : ℝ → ℝ), (∀ σ, Continuous (Wp σ)) → (∀ σ, Continuous (Wm σ)) → Continuous Yp → Continuous Ym → (∀ σ x, (u σ : ℝ → ℝ) x = (Wm σ x - Wp σ x) / 2) → (∀ x, (D : ℝ → ℝ) x = (Ym x - Yp x) / 2) → Filter.Tendsto (fun σ : ℝ => ∫ x in (0:ℝ)..1, ((σ - s)⁻¹ * (Wp σ x - Wp s x) - Yp x) ^ 2) (nhdsWithin s {s}ᶜ) (nhds 0) → Filter.Tendsto (fun σ : ℝ => ∫ x in (0:ℝ)..1, ((σ - s)⁻¹ * (Wm σ x - Wm s x) - Ym x) ^ 2) (nhdsWithin s {s}ᶜ) (nhds 0) → HasDerivAt (fun σ : ℝ => ιT (u σ)) (ιT D) s :=
by
  intro u D s Wp Wm Yp Ym hWp hWm hYp hYm hu hD hp hm
  
  have hL2 : ∀ f : CinfT, ‖ιT f‖ ^ 2 ≤ (1 / 4) * ∫ x in (0:ℝ)..1, (f : ℝ → ℝ) x ^ 2 := by
    intro f
    obtain ⟨⟨v, hvP, hvD⟩, huniq⟩ :=
      periodic_resolvent_T 1 le_rfl (f : ℝ → ℝ) f.2.1.continuous f.2.2
    have hb := (huniq v hvP hvD).2.2.1
    have hpv := periodic_resolvent_parseval_T 1 le_rfl f v hvP hvD
    have hw := (weight_compare_T ((ιT f : Hm1T) : lp (fun _ : ℤ => ℂ) 2) 1 le_rfl).2.2
    have hn : ‖ιT f‖ = ‖((ιT f : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ := rfl
    rw [hn]
    rw [← hpv, one_pow, one_mul] at hw
    rw [one_pow, mul_one] at hb
    linarith
  have pw : ∀ a b : ℝ, ((b - a) / 2) ^ 2 ≤ a ^ 2 / 2 + b ^ 2 / 2 := fun a b => by
    nlinarith [sq_nonneg (a + b)]
  
  have key : ∀ σ : ℝ, ‖slope (fun σ : ℝ => ιT (u σ)) s σ - ιT D‖ ^ 2 ≤
      ((∫ x in (0:ℝ)..1, ((σ - s)⁻¹ * (Wp σ x - Wp s x) - Yp x) ^ 2) +
        (∫ x in (0:ℝ)..1, ((σ - s)⁻¹ * (Wm σ x - Wm s x) - Ym x) ^ 2)) / 8 := by
    intro σ
    obtain ⟨A, hA⟩ : ∃ A : CinfT, ∀ x, (A : ℝ → ℝ) x =
        (σ - s)⁻¹ * (u σ : ℝ → ℝ) x + (-(σ - s)⁻¹) * (u s : ℝ → ℝ) x :=
      ⟨⟨fun x => (σ - s)⁻¹ * (u σ : ℝ → ℝ) x + (-(σ - s)⁻¹) * (u s : ℝ → ℝ) x,
        (contDiff_const.mul (u σ).2.1).add (contDiff_const.mul (u s).2.1),
        fun x => by simp only [(u σ).2.2 x, (u s).2.2 x]⟩, fun x => rfl⟩
    obtain ⟨G, hG⟩ : ∃ G : CinfT, ∀ x, (G : ℝ → ℝ) x =
        1 * (A : ℝ → ℝ) x + (-1) * (D : ℝ → ℝ) x :=
      ⟨⟨fun x => 1 * (A : ℝ → ℝ) x + (-1) * (D : ℝ → ℝ) x,
        (contDiff_const.mul A.2.1).add (contDiff_const.mul D.2.1),
        fun x => by simp only [A.2.2 x, D.2.2 x]⟩, fun x => rfl⟩
    have hAT := toHm1T_basic.1 (u σ) (u s) A (σ - s)⁻¹ (-(σ - s)⁻¹) hA
    have hGT := toHm1T_basic.1 A D G 1 (-1) hG
    have heq : slope (fun σ : ℝ => ιT (u σ)) s σ - ιT D = ιT G := by
      rw [slope_def_module]
      apply Subtype.ext
      show (σ - s)⁻¹ • (toHm1T (u σ) - toHm1T (u s)) - toHm1T D = toHm1T G
      rw [hGT, hAT]
      module
    have hGx : ∀ x, (G : ℝ → ℝ) x =
        (((σ - s)⁻¹ * (Wm σ x - Wm s x) - Ym x) - ((σ - s)⁻¹ * (Wp σ x - Wp s x) - Yp x)) / 2 := by
      intro x
      rw [hG x, hA x, hu σ x, hu s x, hD x]
      ring
    have cp : Continuous (fun x => (σ - s)⁻¹ * (Wp σ x - Wp s x) - Yp x) :=
      (continuous_const.mul ((hWp σ).sub (hWp s))).sub hYp
    have cm : Continuous (fun x => (σ - s)⁻¹ * (Wm σ x - Wm s x) - Ym x) :=
      (continuous_const.mul ((hWm σ).sub (hWm s))).sub hYm
    have i1 : IntervalIntegrable (fun x => ((σ - s)⁻¹ * (Wp σ x - Wp s x) - Yp x) ^ 2 / 2)
        MeasureTheory.volume 0 1 := ((cp.pow 2).div_const 2).intervalIntegrable 0 1
    have i2 : IntervalIntegrable (fun x => ((σ - s)⁻¹ * (Wm σ x - Wm s x) - Ym x) ^ 2 / 2)
        MeasureTheory.volume 0 1 := ((cm.pow 2).div_const 2).intervalIntegrable 0 1
    have hmono : (∫ x in (0:ℝ)..1, (G : ℝ → ℝ) x ^ 2) ≤
        ∫ x in (0:ℝ)..1, (((σ - s)⁻¹ * (Wp σ x - Wp s x) - Yp x) ^ 2 / 2 +
          ((σ - s)⁻¹ * (Wm σ x - Wm s x) - Ym x) ^ 2 / 2) :=
      intervalIntegral.integral_mono_on zero_le_one
        ((G.2.1.continuous.pow 2).intervalIntegrable 0 1) (i1.add i2)
        (fun x _ => by rw [hGx x]; exact pw _ _)
    rw [intervalIntegral.integral_add i1 i2, intervalIntegral.integral_div,
      intervalIntegral.integral_div] at hmono
    rw [heq]
    have := hL2 G
    linarith
  
  rw [hasDerivAt_iff_tendsto_slope, tendsto_iff_norm_sub_tendsto_zero]
  have hB : Filter.Tendsto (fun σ : ℝ =>
      Real.sqrt (((∫ x in (0:ℝ)..1, ((σ - s)⁻¹ * (Wp σ x - Wp s x) - Yp x) ^ 2) +
        (∫ x in (0:ℝ)..1, ((σ - s)⁻¹ * (Wm σ x - Wm s x) - Ym x) ^ 2)) / 8))
      (nhdsWithin s {s}ᶜ) (nhds 0) := by
    have h := ((hp.add hm).div_const 8).sqrt
    have h0 : Real.sqrt (((0:ℝ) + 0) / 8) = 0 := by norm_num
    rw [h0] at h
    exact h
  refine squeeze_zero (fun σ => norm_nonneg _) (fun σ => ?_) hB
  have h1 := Real.sqrt_le_sqrt (key σ)
  rw [Real.sqrt_sq (norm_nonneg _)] at h1
  exact h1

theorem good_unknown_difference_derivative_T : ∀ R ≥ (0 : ℝ), ∃ ϰ₀ ≥ (1 : ℝ), ∀ ϰ ≥ ϰ₀, ∃ κ₀ ≥ 2 * ϰ, ∀ κ ≥ κ₀, ∀ r u : ℝ → CinfT, (∀ s : ℝ, ∃ v : CinfT, (∀ x : ℝ, (v : ℝ → ℝ) x = kdvRHS (r s : ℝ → ℝ) x - hkRHST κ (r s : ℝ → ℝ) x) ∧ HasDerivAt (fun σ : ℝ => ιT (r σ)) (ιT v) s) → (∀ s : ℝ, ‖ιT (r s)‖ ≤ R) → (∀ σ x : ℝ, (u σ : ℝ → ℝ) x = 1 / (2 * greenT ϰ (r σ : ℝ → ℝ) x) - ϰ) → ∀ s : ℝ, ∃ F D : CinfT, (∀ x : ℝ, (F : ℝ → ℝ) x = ((r s : ℝ → ℝ) x + (4 * κ ^ 5 / (κ ^ 2 - ϰ ^ 2)) * (greenT κ (r s : ℝ → ℝ) x - 1 / (2 * κ)) - (4 * ϰ ^ 5 / (κ ^ 2 - ϰ ^ 2)) * (greenT ϰ (r s : ℝ → ℝ) x - 1 / (2 * ϰ))) / greenT ϰ (r s : ℝ → ℝ) x) ∧ (∀ x : ℝ, (D : ℝ → ℝ) x = deriv (F : ℝ → ℝ) x) ∧ HasDerivAt (fun σ : ℝ => ιT (u σ)) (ιT D) s :=
by
  intro R hR
  refine ⟨max 1 (1024 * R ^ 2), le_max_left _ _, ?_⟩
  intro ϰ hϰ
  refine ⟨2 * ϰ, le_refl _, ?_⟩
  intro κ hκ r u hH1 hH2 hH3 s
  have hϰ1 : 1 ≤ ϰ := le_trans (le_max_left _ _) hϰ
  have hϰR : 1024 * R ^ 2 ≤ ϰ := le_trans (le_max_right _ _) hϰ
  have hϰpos : 0 < ϰ := by linarith
  have hκϰ : 2 * ϰ ≤ κ := hκ
  have hκ1 : 1 ≤ κ := by linarith
  have hκpos : 0 < κ := by linarith
  have hκR : 1024 * R ^ 2 ≤ κ := by linarith
  have hM : 0 < κ ^ 2 - ϰ ^ 2 := by nlinarith
  have hMne : κ ^ 2 - ϰ ^ 2 ≠ 0 := hM.ne'
  have hκne : κ ≠ 0 := hκpos.ne'
  have hϰne : ϰ ≠ 0 := hϰpos.ne'
  have hcont : ∀ (f F : ℝ → ℝ), (∀ x, HasDerivAt f (F x) x) → Continuous f :=
    fun f F h => continuous_iff_continuousAt.2 fun x => (h x).continuousAt
  
  have hsmall : ∀ (lam : ℝ), 1 ≤ lam → 1024 * R ^ 2 ≤ lam → ∀ p : CinfT, ‖ιT p‖ ≤ R →
      WT lam ((ιT p : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ≤ lam / 1024 := by
    intro lam hl1 hlR p hp
    have h1 := (weight_compare_T ((ιT p : Hm1T) : lp (fun _ : ℤ => ℂ) 2) lam hl1).2.1
    have h2 : ‖((ιT p : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ≤ R := hp
    have h3 : ‖((ιT p : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ^ 2 ≤ R ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) h2 2
    unfold WT
    linarith
  
  choose Wp Wm hWpP hWmP hWpD hWmD hWpI hWmI hWd using
    fun σ => riccati_pair_T ϰ hϰ1 (r σ) (hsmall ϰ hϰ1 hϰR (r σ) (hH2 σ))
  have hPpos : ∀ σ x, 0 < 2 * ϰ + Wm σ x - Wp σ x := by
    intro σ x
    have := (abs_le.1 (hWd σ x)).1
    linarith
  have hG : ∀ σ, IsGreenT ϰ (r σ : ℝ → ℝ) (greenT ϰ (r σ : ℝ → ℝ)) ∧
      ∀ x, greenT ϰ (r σ : ℝ → ℝ) x = 1 / (2 * ϰ + Wm σ x - Wp σ x) :=
    fun σ => greenT_eq_of_riccati_pair_T ϰ (r σ) (Wp σ) (Wm σ) (hWpP σ) (hWmP σ)
      (hWpD σ) (hWmD σ) (hPpos σ)
  have hu : ∀ σ x, (u σ : ℝ → ℝ) x = (Wm σ x - Wp σ x) / 2 := by
    intro σ x
    rw [hH3 σ x, (hG σ).2 x]
    have := (hPpos σ x).ne'
    field_simp
    ring
  
  obtain ⟨wpk, wmk, hwpkP, hwmkP, hwpkD, hwmkD, -, -, hwkd⟩ :=
    riccati_pair_T κ hκ1 (r s) (hsmall κ hκ1 hκR (r s) (hH2 s))
  have hPk : ∀ x, 0 < 2 * κ + wmk x - wpk x := by
    intro x
    have := (abs_le.1 (hwkd x)).1
    linarith
  have hGk := (greenT_eq_of_riccati_pair_T κ (r s) wpk wmk hwpkP hwmkP hwpkD hwmkD hPk).1
  have hGs := hG s
  obtain ⟨v, hv, hvd⟩ := hH1 s
  set q : ℝ → ℝ := (r s : ℝ → ℝ) with hqdef
  set g : ℝ → ℝ := greenT κ q with hgdef
  set gk : ℝ → ℝ := greenT ϰ q with hgkdef
  have hqC : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) q := (r s).2.1
  have hqP : Function.Periodic q 1 := (r s).2.2
  have hgC : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) g := hGk.1
  have hgP : Function.Periodic g 1 := hGk.2.1
  have hgkC : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) gk := hGs.1.1
  have hgkP : Function.Periodic gk 1 := hGs.1.2.1
  have hgkpos : ∀ x, 0 < gk x := hGs.1.2.2.1
  have hq1 : ∀ x, HasDerivAt q (deriv q x) x := fun x =>
    ((contDiff_infty_iff_deriv.1 hqC).1 x).hasDerivAt
  have hgd := contDiff_infty_iff_deriv.1 hgC
  have hgdd := contDiff_infty_iff_deriv.1 hgd.2
  have hgddd := contDiff_infty_iff_deriv.1 hgdd.2
  have hg1 : ∀ x, HasDerivAt g (deriv g x) x := fun x => (hgd.1 x).hasDerivAt
  have hg2 : ∀ x, HasDerivAt (deriv g) (deriv (deriv g) x) x := fun x => (hgdd.1 x).hasDerivAt
  have hg3 : ∀ x, HasDerivAt (deriv (deriv g)) (deriv (deriv (deriv g)) x) x :=
    fun x => (hgddd.1 x).hasDerivAt
  have hi2 : iteratedDeriv 2 g = deriv (deriv g) := by
    rw [iteratedDeriv_succ, iteratedDeriv_one]
  have hi3 : iteratedDeriv 3 g = deriv (deriv (deriv g)) := by
    rw [iteratedDeriv_succ, hi2]
  
  have hthird : ∀ x, iteratedDeriv 3 g x = 2 * deriv q x * g x + 4 * (κ ^ 2 + q x) * deriv g x := by
    intro x
    have hΦ := (((hg2 x).mul (hg2 x)).sub (((hg1 x).const_mul 2).mul (hg3 x))).add
      ((((hq1 x).const_add (κ ^ 2)).const_mul 4).mul ((hg1 x).mul (hg1 x)))
    have hfun : (fun y => deriv g y * deriv g y - 2 * g y * deriv (deriv g) y +
        4 * (κ ^ 2 + q y) * (g y * g y)) = fun _ => (1 : ℝ) := by
      funext y
      have h := hGk.2.2.2 y
      rw [hi2] at h
      rw [← h]
      ring
    have hΦ' : HasDerivAt (fun y => deriv g y * deriv g y - 2 * g y * deriv (deriv g) y +
        4 * (κ ^ 2 + q y) * (g y * g y)) _ x := hΦ
    rw [hfun] at hΦ'
    have h0 := hΦ'.unique (hasDerivAt_const x (1 : ℝ))
    simp only [Pi.mul_apply] at h0
    have key : g x * (deriv (deriv (deriv g)) x -
        (2 * deriv q x * g x + 4 * (κ ^ 2 + q x) * deriv g x)) = 0 := by
      linear_combination (-1 / 2 : ℝ) * h0
    have hgx := hGk.2.2.1 x
    have := (mul_eq_zero.1 key).resolve_left hgx.ne'
    rw [hi3]
    linarith
  
  have hvform : ∀ x, (v : ℝ → ℝ) x = -(iteratedDeriv 3 q x) + 6 * q x * deriv q x -
      (16 * κ ^ 5 * deriv g x + 4 * κ ^ 2 * deriv q x) := by
    intro x
    rw [hv x]
    unfold kdvRHS hkRHST
    ring
  
  let H : ℝ → ℝ := fun x => -2 * deriv q x + (2 * q x - 4 * ϰ ^ 2 - 4 * κ ^ 2) * (Wm s x + Wp s x) -
    (8 * κ ^ 5 / (κ ^ 2 - ϰ ^ 2)) * (deriv g x - g x * (Wm s x + Wp s x))
  let Zp : ℝ → ℝ := fun x => (deriv H x + H x * (2 * ϰ + Wm s x - Wp s x)) / 2
  let Zm : ℝ → ℝ := fun x => (deriv H x - H x * (2 * ϰ + Wm s x - Wp s x)) / 2
  obtain ⟨hZpD, hZmD, hZpP, hZmP⟩ := good_unknown_jet_ode_T ϰ κ hMne q (Wp s) (Wm s) g H Zp Zm
    (v : ℝ → ℝ) hqC hgC hqP (hWpP s) (hWmP s) hgP (hWpD s) (hWmD s) hthird (fun x => rfl)
    (fun x => rfl) (fun x => rfl) hvform
  
  let Ff : ℝ → ℝ := fun x => (q x + (4 * κ ^ 5 / (κ ^ 2 - ϰ ^ 2)) * (g x - 1 / (2 * κ)) -
    (4 * ϰ ^ 5 / (κ ^ 2 - ϰ ^ 2)) * (gk x - 1 / (2 * ϰ))) / gk x
  have hFfC : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) Ff := by
    refine ContDiff.div ?_ hgkC (fun x => (hgkpos x).ne')
    exact (hqC.add (contDiff_const.mul (hgC.sub contDiff_const))).sub
      (contDiff_const.mul (hgkC.sub contDiff_const))
  have hFfP : Function.Periodic Ff 1 := by
    intro x
    show (q (x + 1) + (4 * κ ^ 5 / (κ ^ 2 - ϰ ^ 2)) * (g (x + 1) - 1 / (2 * κ)) -
      (4 * ϰ ^ 5 / (κ ^ 2 - ϰ ^ 2)) * (gk (x + 1) - 1 / (2 * ϰ))) / gk (x + 1) = Ff x
    rw [hqP x, hgP x, hgkP x]
  have hFd : ∀ x, HasDerivAt Ff ((Zm x - Zp x) / 2) x := by
    intro x
    have eP : HasDerivAt (fun y => 2 * ϰ + Wm s y - Wp s y)
        ((q x - 2 * ϰ * Wm s x - Wm s x ^ 2) - (q x + 2 * ϰ * Wp s x - Wp s x ^ 2)) x := by
      have h := ((hWmD s x).const_add (2 * ϰ)).sub (hWpD s x)
      refine h.congr_of_eventuallyEq (Filter.Eventually.of_forall fun y => ?_)
      simp only [Pi.sub_apply]
    have hpoly := (((((hq1 x).add ((hg1 x).const_mul (4 * κ ^ 5 / (κ ^ 2 - ϰ ^ 2)))).sub_const
      ((4 * κ ^ 5 / (κ ^ 2 - ϰ ^ 2)) / (2 * κ))).mul eP).sub_const
      (4 * ϰ ^ 5 / (κ ^ 2 - ϰ ^ 2))).add (eP.const_mul ((4 * ϰ ^ 5 / (κ ^ 2 - ϰ ^ 2)) / (2 * ϰ)))
    refine (hpoly.congr_of_eventuallyEq (Filter.Eventually.of_forall fun y => ?_)).congr_deriv ?_
    · have hPy := (hPpos s y).ne'
      show (q y + (4 * κ ^ 5 / (κ ^ 2 - ϰ ^ 2)) * (g y - 1 / (2 * κ)) -
        (4 * ϰ ^ 5 / (κ ^ 2 - ϰ ^ 2)) * (gk y - 1 / (2 * ϰ))) / gk y =
        (q y + (4 * κ ^ 5 / (κ ^ 2 - ϰ ^ 2)) * g y - (4 * κ ^ 5 / (κ ^ 2 - ϰ ^ 2)) / (2 * κ)) *
          (2 * ϰ + Wm s y - Wp s y) - (4 * ϰ ^ 5 / (κ ^ 2 - ϰ ^ 2)) +
          (4 * ϰ ^ 5 / (κ ^ 2 - ϰ ^ 2)) / (2 * ϰ) * (2 * ϰ + Wm s y - Wp s y)
      rw [hGs.2 y]
      generalize 2 * ϰ + Wm s y - Wp s y = P at hPy ⊢
      field_simp
      ring
    · show (deriv q x + (4 * κ ^ 5 / (κ ^ 2 - ϰ ^ 2)) * deriv g x) * (2 * ϰ + Wm s x - Wp s x) +
          (q x + (4 * κ ^ 5 / (κ ^ 2 - ϰ ^ 2)) * g x - (4 * κ ^ 5 / (κ ^ 2 - ϰ ^ 2)) / (2 * κ)) *
            ((q x - 2 * ϰ * Wm s x - Wm s x ^ 2) - (q x + 2 * ϰ * Wp s x - Wp s x ^ 2)) +
          (4 * ϰ ^ 5 / (κ ^ 2 - ϰ ^ 2)) / (2 * ϰ) *
            ((q x - 2 * ϰ * Wm s x - Wm s x ^ 2) - (q x + 2 * ϰ * Wp s x - Wp s x ^ 2)) =
        ((deriv H x - H x * (2 * ϰ + Wm s x - Wp s x)) / 2 -
          (deriv H x + H x * (2 * ϰ + Wm s x - Wp s x)) / 2) / 2
      have hHx : H x = -2 * deriv q x + (2 * q x - 4 * ϰ ^ 2 - 4 * κ ^ 2) * (Wm s x + Wp s x) -
          (8 * κ ^ 5 / (κ ^ 2 - ϰ ^ 2)) * (deriv g x - g x * (Wm s x + Wp s x)) := rfl
      rw [hHx]
      field_simp
      ring
  have hdF : deriv Ff = fun x => (Zm x - Zp x) / 2 := funext fun x => (hFd x).deriv
  let F : CinfT := ⟨Ff, hFfC, hFfP⟩
  have hDC : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (deriv Ff) := (contDiff_infty_iff_deriv.1 hFfC).2
  have hDP : Function.Periodic (deriv Ff) 1 := by
    intro x
    rw [hdF]
    show (Zm (x + 1) - Zp (x + 1)) / 2 = (Zm x - Zp x) / 2
    rw [hZpP x, hZmP x]
  let D : CinfT := ⟨deriv Ff, hDC, hDP⟩
  
  have hSp := riccati_L2_slope_T 1 (Or.inl rfl) ϰ hϰ1 r v s hvd Wp Zp hWpP
    (fun σ x => (hWpD σ x).congr_deriv (by ring)) hWpI hZpP
    (fun x => (hZpD x).congr_deriv (by ring))
  have hSm := riccati_L2_slope_T (-1) (Or.inr rfl) ϰ hϰ1 r v s hvd Wm Zm hWmP
    (fun σ x => (hWmD σ x).congr_deriv (by ring)) hWmI hZmP
    (fun x => (hZmD x).congr_deriv (by ring))
  
  have hder := hm1T_hasDerivAt_of_L2_slopes_T u D s Wp Wm Zp Zm
    (fun σ => hcont _ _ (hWpD σ)) (fun σ => hcont _ _ (hWmD σ))
    (hcont _ _ hZpD) (hcont _ _ hZmD) hu
    (fun x => by show deriv Ff x = _; rw [hdF]) hSp hSm
  exact ⟨F, D, fun x => rfl, fun x => rfl, hder⟩

theorem hm1T_h1_parseval_T : (∀ f : CinfT, Summable (fun n : ℤ => (4 + (2 * π * n) ^ 2) ^ 2 * ‖((ιT f : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2) ∧ (∑' n : ℤ, (4 + (2 * π * n) ^ 2) ^ 2 * ‖((ιT f : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2) = ∫ x in (0:ℝ)..1, (deriv (f : ℝ → ℝ) x) ^ 2 + 4 * ((f : ℝ → ℝ) x) ^ 2) ∧ (∀ F D : CinfT, (∀ x, (D : ℝ → ℝ) x = deriv (F : ℝ → ℝ) x) → (∑' n : ℤ, ‖((ιT D : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2 / (4 + (2 * π * n) ^ 2)) ≤ ‖ιT F‖ ^ 2) :=
by
  have hab : (0:ℝ) < 1 := one_pos
  
  have pars : ∀ v : ℝ → ℝ, Continuous v →
      HasSum (fun n : ℤ => ‖fourierCircle v n‖ ^ 2) (∫ x in (0:ℝ)..1, v x ^ 2) := by
    intro v hvc
    have hFc : Continuous (fun x : ℝ => (v x : ℂ)) := Complex.continuous_ofReal.comp hvc
    have hid : ∀ n : ℤ, fourierCoeffOn hab (fun x : ℝ => (v x : ℂ)) n = fourierCircle v n := by
      intro n
      rw [fourierCoeffOn_eq_integral]
      unfold fourierCircle
      rw [sub_zero, div_one, one_smul]
      apply intervalIntegral.integral_congr
      intro x _
      simp only [fourier_coe_apply, smul_eq_mul]
      congr 2
      push_cast
      ring
    have hL2 : MemLp (fun x : ℝ => (v x : ℂ)) 2 (volume.restrict (Set.Ioc (0:ℝ) 1)) := by
      haveI : IsFiniteMeasure (volume.restrict (Set.Ioc (0:ℝ) 1)) :=
        isFiniteMeasure_restrict.2 measure_Ioc_lt_top.ne
      obtain ⟨C, hC⟩ := IsCompact.exists_bound_of_continuousOn (isCompact_Icc (a := (0:ℝ)) (b := 1))
        hFc.continuousOn
      refine MemLp.of_bound hFc.aestronglyMeasurable C ?_
      filter_upwards [ae_restrict_mem measurableSet_Ioc] with x hx
      exact hC x (Set.Ioc_subset_Icc_self hx)
    have h := hasSum_sq_fourierCoeffOn hab hL2
    have hval : ((1:ℝ) - 0)⁻¹ • (∫ x in (0:ℝ)..1, ‖(v x : ℂ)‖ ^ 2) = ∫ x in (0:ℝ)..1, v x ^ 2 := by
      simp only [sub_zero, inv_one, one_smul, Complex.norm_real, Real.norm_eq_abs, sq_abs]
    rw [hval] at h
    simpa only [hid] using h
  
  have ibp : ∀ (F D : ℝ → ℝ), Function.Periodic F 1 → Continuous D →
      (∀ x, HasDerivAt F (D x) x) → ∀ n : ℤ,
        fourierCircle D n = ((2 * π * n : ℝ) : ℂ) * I * fourierCircle F n := by
    intro F D hper hDc hder n
    set c : ℂ := ((2 * π * n : ℝ) : ℂ) with hc
    set e : ℝ → ℂ := fun x => Complex.exp (-(c * (x : ℂ)) * I) with he
    have hed : ∀ x : ℝ, HasDerivAt e (e x * (-c * I)) x := by
      intro x
      have h1 : HasDerivAt (fun y : ℝ => (y : ℂ)) 1 x := (hasDerivAt_id x).ofReal_comp
      have h2 : HasDerivAt (fun y : ℝ => -(c * (y : ℂ)) * I) (-(c * 1) * I) x :=
        ((h1.const_mul c).neg).mul_const I
      have h3 := h2.cexp
      convert h3 using 1
      simp only [he]
      ring
    have hVd : ∀ x : ℝ, HasDerivAt (fun y => (F y : ℂ)) ((D x : ℝ) : ℂ) x :=
      fun x => (hder x).ofReal_comp
    have hec : Continuous e := by
      simp only [he]
      fun_prop
    have hV'c : Continuous (fun x : ℝ => ((D x : ℝ) : ℂ)) := Complex.continuous_ofReal.comp hDc
    have hibp := intervalIntegral.integral_mul_deriv_eq_deriv_mul (a := (0:ℝ)) (b := 1)
      (fun x _ => hed x) (fun x _ => hVd x)
      ((hec.mul continuous_const).intervalIntegrable _ _) (hV'c.intervalIntegrable _ _)
    have he0 : e 0 = 1 := by simp [he]
    have he1 : e 1 = 1 := by
      simp only [he]
      have : -(c * ((1:ℝ) : ℂ)) * I = ((-n : ℤ) : ℂ) * (2 * π * I) := by
        rw [hc]; push_cast; ring
      rw [this]
      exact Complex.exp_int_mul_two_pi_mul_I (-n)
    have hv1 : ((F 1 : ℝ) : ℂ) = ((F 0 : ℝ) : ℂ) := by rw [hper.eq]
    have hFv : fourierCircle F n = ∫ x in (0:ℝ)..1, e x * (F x : ℂ) := rfl
    have hFD : fourierCircle D n = ∫ x in (0:ℝ)..1, e x * (D x : ℂ) := rfl
    have hright : (∫ x in (0:ℝ)..1, e x * (-c * I) * (F x : ℂ)) = (-c * I) * fourierCircle F n := by
      rw [hFv, ← intervalIntegral.integral_const_mul]
      apply intervalIntegral.integral_congr
      intro x _
      simp only
      ring
    simp only at hibp
    rw [← hFD, hright, he0, he1] at hibp
    linear_combination hibp + hv1
  
  have hcoe : ∀ q : CinfT, ∀ n : ℤ, ‖((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2 =
      ‖fourierCircle (q : ℝ → ℝ) n‖ ^ 2 / (4 + (2 * π * n) ^ 2) := by
    intro q
    have hterm : ∀ m : ℤ, ‖hm1ProfileT (q : ℝ → ℝ) m‖ ^ 2 =
        ‖fourierCircle (q : ℝ → ℝ) m‖ ^ 2 / (4 + (2 * π * m) ^ 2) := by
      intro m
      have ha : 0 < 4 + (2 * π * (m:ℝ)) ^ 2 := by positivity
      unfold hm1ProfileT
      rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (Real.sqrt_nonneg _), mul_pow, inv_pow, Real.sq_sqrt ha.le]
      field_simp
    have hmem : Memℓp (hm1ProfileT (q : ℝ → ℝ)) 2 := by
      have hp : (0 : ℝ) < (2 : ENNReal).toReal := by norm_num
      refine (memℓp_gen_iff hp).2 ?_
      simp only [ENNReal.toReal_ofNat, Real.rpow_two]
      refine Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_)
        (pars (q : ℝ → ℝ) q.2.1.continuous).summable
      rw [hterm n]
      have ha : 1 ≤ 4 + (2 * π * (n:ℝ)) ^ 2 := by nlinarith [sq_nonneg (2 * π * (n:ℝ))]
      exact div_le_self (sq_nonneg _) ha
    intro n
    have h : ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n = hm1ProfileT (q : ℝ → ℝ) n := by
      show toHm1T q n = _
      unfold toHm1T
      rw [dif_pos hmem]
    rw [h, hterm n]
  
  have hreg : ∀ f : CinfT, Continuous (f : ℝ → ℝ) ∧ Continuous (deriv (f : ℝ → ℝ)) ∧
      ∀ x, HasDerivAt (f : ℝ → ℝ) (deriv (f : ℝ → ℝ) x) x := by
    intro f
    have hf := f.2.1
    refine ⟨hf.continuous, hf.continuous_deriv (by simp), fun x => ?_⟩
    exact ((hf.differentiable (by simp)) x).hasDerivAt
  refine ⟨fun f => ?_, fun F D hD => ?_⟩
  · obtain ⟨hfc, hf1c, hder⟩ := hreg f
    have hDf := ibp (f : ℝ → ℝ) (deriv (f : ℝ → ℝ)) f.2.2 hf1c hder
    have hnormD : ∀ n : ℤ, ‖fourierCircle (deriv (f : ℝ → ℝ)) n‖ ^ 2 =
        (2 * π * n) ^ 2 * ‖fourierCircle (f : ℝ → ℝ) n‖ ^ 2 := by
      intro n
      rw [hDf n, norm_mul, norm_mul, Complex.norm_real, Complex.norm_I, mul_one,
        Real.norm_eq_abs, mul_pow, sq_abs]
    have h1 := (pars (deriv (f : ℝ → ℝ)) hf1c).add ((pars (f : ℝ → ℝ) hfc).mul_left 4)
    have hint : (∫ x in (0:ℝ)..1, (deriv (f : ℝ → ℝ) x) ^ 2 + 4 * ((f : ℝ → ℝ) x) ^ 2) =
        (∫ x in (0:ℝ)..1, (deriv (f : ℝ → ℝ) x) ^ 2) + 4 * ∫ x in (0:ℝ)..1, ((f : ℝ → ℝ) x) ^ 2 := by
      rw [intervalIntegral.integral_add, intervalIntegral.integral_const_mul]
      · exact (hf1c.pow 2).intervalIntegrable _ _
      · exact (continuous_const.mul (hfc.pow 2)).intervalIntegrable _ _
    have H : HasSum (fun n : ℤ => (4 + (2 * π * n) ^ 2) ^ 2 *
        ‖((ιT f : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2)
        (∫ x in (0:ℝ)..1, (deriv (f : ℝ → ℝ) x) ^ 2 + 4 * ((f : ℝ → ℝ) x) ^ 2) := by
      rw [hint]
      convert h1 using 1
      funext n
      rw [hcoe f n, hnormD n]
      have ha : 0 < 4 + (2 * π * (n:ℝ)) ^ 2 := by positivity
      field_simp
      ring
    exact ⟨H.summable, H.tsum_eq⟩
  · obtain ⟨hFc, -, hFd⟩ := hreg F
    have hder : ∀ x, HasDerivAt (F : ℝ → ℝ) ((D : ℝ → ℝ) x) x := fun x => by
      rw [hD x]; exact hFd x
    have hDF := ibp (F : ℝ → ℝ) (D : ℝ → ℝ) F.2.2 D.2.1.continuous hder
    have hp : (0 : ℝ) < (2 : ENNReal).toReal := by norm_num
    have hnorm : ‖ιT F‖ ^ 2 = ∑' n : ℤ, ‖((ιT F : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2 := by
      have h := lp.norm_rpow_eq_tsum hp ((ιT F : Hm1T) : lp (fun _ : ℤ => ℂ) 2)
      simp only [ENNReal.toReal_ofNat, Real.rpow_two] at h
      rw [← h]
      rfl
    have hle : ∀ n : ℤ, ‖((ιT D : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2 / (4 + (2 * π * n) ^ 2) ≤
        ‖((ιT F : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2 := by
      intro n
      rw [hcoe D n, hcoe F n, hDF n, norm_mul, norm_mul, Complex.norm_real, Complex.norm_I,
        mul_one, Real.norm_eq_abs, mul_pow, sq_abs]
      have ha : 0 < 4 + (2 * π * (n:ℝ)) ^ 2 := by positivity
      have hB := sq_nonneg ‖fourierCircle (F : ℝ → ℝ) n‖
      rw [div_div, div_le_div_iff₀ (by positivity) ha]
      nlinarith [mul_nonneg hB ha.le, sq_nonneg (2 * π * (n:ℝ))]
    have hgs : Summable (fun n : ℤ => ‖((ιT F : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2) := by
      refine Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_)
        (pars (F : ℝ → ℝ) hFc).summable
      rw [hcoe F n]
      have ha : 1 ≤ 4 + (2 * π * (n:ℝ)) ^ 2 := by nlinarith [sq_nonneg (2 * π * (n:ℝ))]
      exact div_le_self (sq_nonneg _) ha
    have hls : Summable (fun n : ℤ =>
        ‖((ιT D : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2 / (4 + (2 * π * n) ^ 2)) :=
      Summable.of_nonneg_of_le (fun n => by positivity) hle hgs
    rw [hnorm]
    exact Summable.tsum_le_tsum hle hls hgs

theorem toHm1T_translate_T : ∀ (q qh : CinfT) (h : ℝ), (∀ x, (qh : ℝ → ℝ) x = (q : ℝ → ℝ) (x + h)) → (∀ n : ℤ, toHm1T qh n = Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) * toHm1T q n) ∧ ‖ιT qh - ιT q‖ ^ 2 = translateDiffSqT (toHm1T q) h :=
by
  intro q qh h hqh
  have hqper : Function.Periodic (q : ℝ → ℝ) 1 := q.2.2
  have hF : ∀ n : ℤ, fourierCircle (qh : ℝ → ℝ) n =
      Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) * fourierCircle (q : ℝ → ℝ) n := by
    intro n
    set E := Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) with hE
    set g : ℝ → ℂ := fun y =>
      Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (y : ℂ)) * I) * ((q : ℝ → ℝ) y : ℂ) with hgdef
    have hg : Function.Periodic g 1 := by
      intro y
      simp only [hgdef]
      rw [hqper y]
      congr 1
      have harg : -(((2 * π * n : ℝ) : ℂ) * (((y + 1 : ℝ)) : ℂ)) * I =
          -(((2 * π * n : ℝ) : ℂ) * (y : ℂ)) * I + ((-n : ℤ) : ℂ) * (2 * π * I) := by
        push_cast; ring
      rw [harg, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]
    have hpt : ∀ x : ℝ, Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) *
        ((qh : ℝ → ℝ) x : ℂ) = E * g (x + h) := by
      intro x
      simp only [hgdef, hE]
      rw [hqh x, ← mul_assoc, ← Complex.exp_add]
      congr 2
      push_cast; ring
    have hL : fourierCircle (qh : ℝ → ℝ) n = ∫ x in (0:ℝ)..1, E * g (x + h) := by
      unfold fourierCircle
      exact intervalIntegral.integral_congr (fun x _ => hpt x)
    have hR : fourierCircle (q : ℝ → ℝ) n = ∫ x in (0:ℝ)..1, g x := rfl
    rw [hL, hR, intervalIntegral.integral_const_mul, intervalIntegral.integral_comp_add_right g h,
      zero_add, add_comm 1 h, hg.intervalIntegral_add_eq h 0, zero_add]
  have hE1 : ∀ n : ℤ, ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I)‖ = 1 := by
    intro n
    rw [show ((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I = (((2 * π * n * h : ℝ)) : ℂ) * I by
      push_cast; ring]
    exact Complex.norm_exp_ofReal_mul_I _
  have hprof : ∀ n : ℤ, hm1ProfileT (qh : ℝ → ℝ) n =
      Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) * hm1ProfileT (q : ℝ → ℝ) n := by
    intro n
    unfold hm1ProfileT
    rw [hF n]
    ring
  have hnorm : ∀ n : ℤ, ‖hm1ProfileT (qh : ℝ → ℝ) n‖ = ‖hm1ProfileT (q : ℝ → ℝ) n‖ := by
    intro n
    rw [hprof n, norm_mul, hE1 n, one_mul]
  have h2pos : (0 : ℝ) < (2 : ENNReal).toReal := by norm_num
  have hmem : Memℓp (hm1ProfileT (qh : ℝ → ℝ)) 2 ↔ Memℓp (hm1ProfileT (q : ℝ → ℝ)) 2 := by
    rw [memℓp_gen_iff h2pos, memℓp_gen_iff h2pos]
    simp only [hnorm]
  have hA : ∀ n : ℤ, toHm1T qh n =
      Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) * toHm1T q n := by
    intro n
    unfold toHm1T
    by_cases hm : Memℓp (hm1ProfileT (q : ℝ → ℝ)) 2
    · rw [dif_pos hm, dif_pos (hmem.2 hm)]
      exact hprof n
    · rw [dif_neg hm, dif_neg (fun h' => hm (hmem.1 h'))]
      simp
  refine ⟨hA, ?_⟩
  have hnorm2 : ∀ f : lp (fun _ : ℤ => ℂ) 2, ‖f‖ ^ 2 = ∑' n : ℤ, ‖f n‖ ^ 2 := by
    intro f
    have := lp.norm_rpow_eq_tsum h2pos f
    simpa [ENNReal.toReal_ofNat, Real.rpow_two] using this
  have hco : ‖ιT qh - ιT q‖ = ‖toHm1T qh - toHm1T q‖ := rfl
  rw [hco, hnorm2]
  unfold translateDiffSqT
  apply tsum_congr
  intro n
  rw [lp.coeFn_sub, Pi.sub_apply, hA n]
  congr 2
  ring

theorem riccati_pair_h1_lipschitz_T : ∀ κ : ℝ, 1 ≤ κ → ∀ q p : CinfT, ∀ wp₁ wm₁ wp₂ wm₂ : ℝ → ℝ, Function.Periodic wp₁ 1 → Function.Periodic wm₁ 1 → Function.Periodic wp₂ 1 → Function.Periodic wm₂ 1 → (∀ x, HasDerivAt wp₁ ((q : ℝ → ℝ) x + 2 * κ * wp₁ x - wp₁ x ^ 2) x) → (∀ x, HasDerivAt wm₁ ((q : ℝ → ℝ) x - 2 * κ * wm₁ x - wm₁ x ^ 2) x) → (∀ x, HasDerivAt wp₂ ((p : ℝ → ℝ) x + 2 * κ * wp₂ x - wp₂ x ^ 2) x) → (∀ x, HasDerivAt wm₂ ((p : ℝ → ℝ) x - 2 * κ * wm₂ x - wm₂ x ^ 2) x) → (∫ x in (0:ℝ)..1, wp₁ x ^ 2) ≤ κ / 64 → (∫ x in (0:ℝ)..1, wm₁ x ^ 2) ≤ κ / 64 → (∫ x in (0:ℝ)..1, wp₂ x ^ 2) ≤ κ / 64 → (∫ x in (0:ℝ)..1, wm₂ x ^ 2) ≤ κ / 64 → (∀ x, |wm₁ x - wp₁ x| ≤ κ / 2) → ∀ d : CinfT, (∀ x, (d : ℝ → ℝ) x = ((wm₁ x - wp₁ x) - (wm₂ x - wp₂ x)) / 2) → (∫ x in (0:ℝ)..1, (deriv (d : ℝ → ℝ) x) ^ 2 + 4 * ((d : ℝ → ℝ) x) ^ 2) ≤ 64 * κ ^ 2 * ‖ιT q - ιT p‖ ^ 2 :=
by
  intro κ hκ q p wp₁ wm₁ wp₂ wm₂ hpp₁ hpm₁ hpp₂ hpm₂ hdp₁ hdm₁ hdp₂ hdm₂ hip₁ him₁ hip₂ him₂
    hb d hd
  have hκ0 : 0 < κ := by linarith
  have hκne : κ ≠ 0 := hκ0.ne'
  
  have hsq : ∀ a b : ℝ → ℝ, Continuous a → Continuous b →
      (∫ x in (0:ℝ)..1, (a x + b x) ^ 2) ≤
        2 * (∫ x in (0:ℝ)..1, a x ^ 2) + 2 * ∫ x in (0:ℝ)..1, b x ^ 2 := by
    intro a b ha hb'
    have h1 : (∫ x in (0:ℝ)..1, (a x + b x) ^ 2) ≤
        ∫ x in (0:ℝ)..1, (2 * a x ^ 2 + 2 * b x ^ 2) := by
      apply intervalIntegral.integral_mono_on zero_le_one
      · exact ((ha.add hb').pow 2).intervalIntegrable _ _
      · exact ((continuous_const.mul (ha.pow 2)).add
          (continuous_const.mul (hb'.pow 2))).intervalIntegrable _ _
      · intro x _
        nlinarith [sq_nonneg (a x - b x)]
    have h2 : (∫ x in (0:ℝ)..1, (2 * a x ^ 2 + 2 * b x ^ 2)) =
        2 * (∫ x in (0:ℝ)..1, a x ^ 2) + 2 * ∫ x in (0:ℝ)..1, b x ^ 2 := by
      rw [intervalIntegral.integral_add, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul]
      · exact (continuous_const.mul (ha.pow 2)).intervalIntegrable _ _
      · exact (continuous_const.mul (hb'.pow 2)).intervalIntegrable _ _
    linarith
  
  have hagmon : ∀ (f f' : ℝ → ℝ), Function.Periodic f 1 → Function.Periodic f' 1 →
      Continuous f' → (∀ x, HasDerivAt f (f' x) x) → ∀ t : ℝ, 0 < t → ∀ x : ℝ,
      f x ^ 2 ≤ (1 + 1 / t) * (∫ y in (0:ℝ)..1, f y ^ 2) + t * ∫ y in (0:ℝ)..1, f' y ^ 2 := by
    intro f f' hf hf' hc hder t ht x
    have hfc : Continuous f := continuous_iff_continuousAt.2 fun y => (hder y).continuousAt
    obtain ⟨x₀, _, hx₀min⟩ := isCompact_Icc.exists_isMinOn
      (Set.nonempty_Icc.2 (zero_le_one' ℝ)) (hfc.pow 2).continuousOn
    have hmin : f x₀ ^ 2 ≤ ∫ y in (0:ℝ)..1, f y ^ 2 := by
      have h : (∫ y in (0:ℝ)..1, f x₀ ^ 2) ≤ ∫ y in (0:ℝ)..1, f y ^ 2 := by
        apply intervalIntegral.integral_mono_on zero_le_one
        · exact intervalIntegrable_const
        · exact (hfc.pow 2).intervalIntegrable _ _
        · intro y hy
          exact isMinOn_iff.1 hx₀min y hy
      simpa using h
    obtain ⟨x', hx'⟩ : ∃ x', x' = x₀ + Int.fract (x - x₀) := ⟨_, rfl⟩
    have hx'1 : x₀ ≤ x' := by have := Int.fract_nonneg (x - x₀); linarith
    have hx'2 : x' ≤ x₀ + 1 := by have := Int.fract_lt_one (x - x₀); linarith
    have hfx : f x' = f x := by
      have e : x' = x - (⌊x - x₀⌋ : ℝ) * 1 := by
        rw [hx']; unfold Int.fract; ring
      rw [e, hf.sub_int_mul_eq]
    have hg : ∀ y, HasDerivAt (fun y => f y ^ 2) (2 * f y * f' y) y := by
      intro y
      have h := (hder y).pow 2
      convert h using 1
      norm_num
    have hcont2 : Continuous (fun y => 2 * f y * f' y) := (continuous_const.mul hfc).mul hc
    have hftc : (∫ y in x₀..x', 2 * f y * f' y) = f x' ^ 2 - f x₀ ^ 2 :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt (fun y _ => hg y)
        (hcont2.intervalIntegrable _ _)
    have hcont_h : Continuous (fun y => f y ^ 2 / t + t * f' y ^ 2) :=
      ((hfc.pow 2).div_const t).add (continuous_const.mul (hc.pow 2))
    have hyoung : (∫ y in x₀..x', 2 * f y * f' y) ≤
        ∫ y in x₀..x', (f y ^ 2 / t + t * f' y ^ 2) := by
      apply intervalIntegral.integral_mono_on hx'1 (hcont2.intervalIntegrable _ _)
        (hcont_h.intervalIntegrable _ _)
      intro y _
      have key : f y ^ 2 / t + t * f' y ^ 2 - 2 * f y * f' y = (f y - t * f' y) ^ 2 / t := by
        field_simp
        ring
      have : 0 ≤ (f y - t * f' y) ^ 2 / t := div_nonneg (sq_nonneg _) ht.le
      linarith
    have henl : (∫ y in x₀..x', (f y ^ 2 / t + t * f' y ^ 2)) ≤
        ∫ y in x₀..(x₀ + 1), (f y ^ 2 / t + t * f' y ^ 2) := by
      apply intervalIntegral.integral_mono_interval le_rfl hx'1 hx'2
      · exact Filter.Eventually.of_forall (fun y =>
          add_nonneg (div_nonneg (sq_nonneg (f y)) ht.le) (mul_nonneg ht.le (sq_nonneg (f' y))))
      · exact hcont_h.intervalIntegrable _ _
    have hper_h : Function.Periodic (fun y => f y ^ 2 / t + t * f' y ^ 2) 1 := by
      intro y
      simp only [hf y, hf' y]
    have hshift : (∫ y in x₀..(x₀ + 1), (f y ^ 2 / t + t * f' y ^ 2)) =
        ∫ y in (0:ℝ)..1, (f y ^ 2 / t + t * f' y ^ 2) := by
      have h := hper_h.intervalIntegral_add_eq x₀ 0
      rw [zero_add] at h
