theorem hm1_fourier_derivative_facts : (∀ f : 𝓢(ℝ, ℝ), Integrable (fun ξ : ℝ => (4 + ξ ^ 2) ^ 2 * ‖(toHm1 f : ℝ → ℂ) ξ‖ ^ 2) ∧
      ∫ ξ : ℝ, (4 + ξ ^ 2) ^ 2 * ‖(toHm1 f : ℝ → ℂ) ξ‖ ^ 2 =
        ∫ x : ℝ, (deriv (f : ℝ → ℝ) x) ^ 2 + 4 * (f x) ^ 2) ∧
    (∀ F D : 𝓢(ℝ, ℝ), (∀ x : ℝ, D x = deriv (F : ℝ → ℝ) x) →
      ∫ ξ : ℝ, ‖(toHm1 D : ℝ → ℂ) ξ‖ ^ 2 / (4 + ξ ^ 2) ≤ ‖toHm1 F‖ ^ 2) ∧
    (∀ f : Lp ℂ 2 (volume : Measure ℝ),
      Integrable (fun ξ : ℝ => (4 + ξ ^ 2) ^ 2 * ‖(f : ℝ → ℂ) ξ‖ ^ 2) → ∀ K ≥ (1 : ℝ),
        ∫ ξ : ℝ, (4 + ξ ^ 2) ^ 2 * ‖(f : ℝ → ℂ) ξ‖ ^ 2 ≤
          (4 + 4 * K ^ 2) ^ 3 * (∫ ξ : ℝ, ‖(f : ℝ → ℂ) ξ‖ ^ 2 / (4 + ξ ^ 2)) +
          2 * ∫ ξ : ℝ, (ξ ^ 2 / (ξ ^ 2 + 4 * K ^ 2)) * (4 + ξ ^ 2) ^ 2 * ‖(f : ℝ → ℂ) ξ‖ ^ 2) ∧
    (∀ f g : Lp ℂ 2 (volume : Measure ℝ),
      Integrable (fun ξ : ℝ => (4 + ξ ^ 2) ^ 2 * ‖(f : ℝ → ℂ) ξ‖ ^ 2) →
      Integrable (fun ξ : ℝ => (4 + ξ ^ 2) ^ 2 * ‖(g : ℝ → ℂ) ξ‖ ^ 2) → ∀ K ≥ (1 : ℝ),
        ∫ ξ : ℝ, (ξ ^ 2 / (ξ ^ 2 + 4 * K ^ 2)) * (4 + ξ ^ 2) ^ 2 *
            ‖((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 ≤
          2 * (∫ ξ : ℝ, (ξ ^ 2 / (ξ ^ 2 + 4 * K ^ 2)) * (4 + ξ ^ 2) ^ 2 * ‖(f : ℝ → ℂ) ξ‖ ^ 2) +
          2 * ∫ ξ : ℝ, (ξ ^ 2 / (ξ ^ 2 + 4 * K ^ 2)) * (4 + ξ ^ 2) ^ 2 * ‖(g : ℝ → ℂ) ξ‖ ^ 2) :=
by
  
  have hn : ∀ (r : 𝓢(ℝ, ℝ)) (ξ x : ℝ),
