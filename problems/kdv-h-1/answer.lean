  have hC₀0 : 0 ≤ C₀ := by linarith
  refine ⟨max C₀ (κ₀ * C₀ * R), le_trans hC₀0 (le_max_left _ _), κ₀, hκ₀1, ?_⟩
  intro u hu hu0 t
  obtain ⟨v, hv, hvx⟩ := kdv_scaling_solution c hc0 u hu
  
