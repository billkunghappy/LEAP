          ‖((ι u : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 ≤
        C * ∫ ξ : ℝ, ((4 + ξ ^ 2) / (ξ ^ 2 + 4 * K ^ 2)) *
          ‖((ι q : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 :=
by
  classical
  obtain ⟨Λc, hΛc⟩ := toHm1_clm
  obtain ⟨δ₂, hδ₂, hT⟩ := greenOffset_translate
  obtain ⟨δ₅, hδ₅, L, hL, hLip⟩ := good_unknown_h1_lipschitz
  obtain ⟨hFac, -⟩ := hm1_fourier_derivative_facts
  
  have htsub : ∀ a b : 𝓢(ℝ, ℝ), toHm1 (a - b) = toHm1 a - toHm1 b := fun a b => by
    simp only [← hΛc, map_sub]
  
  have hL2 : ∀ f : Lp ℂ 2 (volume : Measure ℝ), ∫ ξ : ℝ, ‖(f : ℝ → ℂ) ξ‖ ^ 2 = ‖f‖ ^ 2 := by
    intro f
    rw [norm_sq_eq_re_inner (𝕜 := ℂ) f, MeasureTheory.L2.inner_def,
      ← integral_re (MeasureTheory.L2.integrable_inner f f)]
    congr 1
    funext ξ
    exact (inner_self_eq_norm_sq _).symm
  
  have F2 : ∀ (f : 𝓢(ℝ, ℝ)) (k m : ℕ) (x : ℝ),
      |x| ^ k * |iteratedDeriv m (f : ℝ → ℝ) x| ≤ SchwartzMap.seminorm ℝ k m f := by
    intro f k m x
    have h := SchwartzMap.le_seminorm ℝ k m f x
    rwa [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, Real.norm_eq_abs] at h
  have hE2 : ∀ (a b : ℝ) (k : ℕ), 0 ≤ a → 0 ≤ b → (a + b) ^ k ≤ 2 ^ k * (a ^ k + b ^ k) := by
    intro a b k ha hb
    have h2 : (0 : ℝ) ≤ 2 ^ k := by positivity
    rcases le_total a b with hab | hab
    · calc (a + b) ^ k ≤ (2 * b) ^ k := pow_le_pow_left₀ (by linarith) (by linarith) k
        _ = 2 ^ k * b ^ k := mul_pow 2 b k
        _ ≤ 2 ^ k * (a ^ k + b ^ k) :=
          mul_le_mul_of_nonneg_left (by linarith [pow_nonneg ha k]) h2
    · calc (a + b) ^ k ≤ (2 * a) ^ k := pow_le_pow_left₀ (by linarith) (by linarith) k
        _ = 2 ^ k * a ^ k := mul_pow 2 a k
        _ ≤ 2 ^ k * (a ^ k + b ^ k) :=
          mul_le_mul_of_nonneg_left (by linarith [pow_nonneg hb k]) h2
