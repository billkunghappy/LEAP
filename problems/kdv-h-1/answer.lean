    refine ⟨M₂, hM₂0, fun h hh x => ?_⟩
    exact mvt2 (fun σ => V (σ, x)) (fun σ => fderiv ℝ V (σ, x) ((1:ℝ), (0:ℝ)))
      (fun σ => fderiv ℝ (fun p => fderiv ℝ V p ((1:ℝ), (0:ℝ))) (σ, x) ((1:ℝ), (0:ℝ))) M₂
      (fun σ => hlineT V hV σ x) (fun σ => hlineT _ hDs σ x)
      (fun σ hσ => hM₂ σ hσ x) h hh
  
  
  
  set U : ℝ × ℝ → ℝ := fun p => (c s p.1 : ℝ → ℝ) p.2 with hUdef
  have hbs : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) U := (hc s).1.1
  have hUp : ∀ t x : ℝ, U (t, x + 1) = U (t, x) := fun t x => (c s t).2.2 x
  set V1 : ℝ × ℝ → ℝ := fun p => fderiv ℝ U p ((0:ℝ), (1:ℝ)) with hV1def
  have hV1s : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) V1 := hpart U hbs _
  have hV1p : ∀ t x : ℝ, V1 (t, x + 1) = V1 (t, x) := fun t x => hperD U hUp _ t x
  set V2 : ℝ × ℝ → ℝ := fun p => fderiv ℝ V1 p ((0:ℝ), (1:ℝ)) with hV2def
  have hV2s : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) V2 := hpart V1 hV1s _
  have hV2p : ∀ t x : ℝ, V2 (t, x + 1) = V2 (t, x) := fun t x => hperD V1 hV1p _ t x
  set V3 : ℝ × ℝ → ℝ := fun p => fderiv ℝ V2 p ((0:ℝ), (1:ℝ)) with hV3def
  have hV3s : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) V3 := hpart V2 hV2s _
  have hV3p : ∀ t x : ℝ, V3 (t, x + 1) = V3 (t, x) := fun t x => hperD V2 hV2p _ t x
  set Kb : ℝ × ℝ → ℝ := fun p => fderiv ℝ U p ((1:ℝ), (0:ℝ)) with hKbdef
  have hKs : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) Kb := hpart U hbs _
  have hKp : ∀ t x : ℝ, Kb (t, x + 1) = Kb (t, x) := fun t x => hperD U hUp _ t x
  set Xb : ℝ × ℝ → ℝ := fun p => -(V3 p) + 6 * U p * V1 p with hXbdef
  have hXs : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) Xb :=
    hV3s.neg.add ((contDiff_const.mul hbs).mul hV1s)
  have hXp : ∀ t x : ℝ, Xb (t, x + 1) = Xb (t, x) := by
    intro t x
