          (toHm1 (V₁ s) - toHm1 (V₂ s))) s := by
      intro s
      have h1 := s8 _ _ s (hV₁d s)
      have h2 := s8 _ _ s (hV₂d s)
      simp only [hLc] at h1 h2
      exact (h1.sub h2).norm_sq
    have hbd : ∀ s : ℝ, |2 * inner ℝ (toHm1 (hkFlow κ s (a m)) - toHm1 (hkFlow κ s (a n)))
          (toHm1 (V₁ s) - toHm1 (V₂ s))| ≤
        Λ * ‖toHm1 (hkFlow κ s (a m)) - toHm1 (hkFlow κ s (a n))‖ ^ 2 := by
      intro s
      have e1 := hV₁e s
      have e2 := hV₂e s
      have hp₁s := hsmall m s
      have hp₂s := hsmall n s
      generalize hkFlow κ s (a m) = p₁ at e1 hp₁s ⊢
      generalize hkFlow κ s (a n) = p₂ at e2 hp₂s ⊢
      obtain ⟨w, hwdef⟩ : ∃ w : 𝓢(ℝ, ℝ),
          w = SchwartzMap.derivCLM ℝ ℝ (greenOffset κ p₁ - greenOffset κ p₂) := ⟨_, rfl⟩
      obtain ⟨f', hf'def⟩ : ∃ f' : 𝓢(ℝ, ℝ), f' = SchwartzMap.derivCLM ℝ ℝ (p₁ - p₂) :=
        ⟨_, rfl⟩
      have hw : ∀ x : ℝ, w x = deriv (greenOffset κ p₁ : ℝ → ℝ) x -
          deriv (greenOffset κ p₂ : ℝ → ℝ) x := by
        intro x
        rw [hwdef, SchwartzMap.derivCLM_apply]
        have : ((greenOffset κ p₁ - greenOffset κ p₂ : 𝓢(ℝ, ℝ)) : ℝ → ℝ) =
            fun y => greenOffset κ p₁ y - greenOffset κ p₂ y := by
          funext y; simp
        rw [this]
        exact deriv_sub (greenOffset κ p₁).differentiableAt (greenOffset κ p₂).differentiableAt
      have hf'2 : ∀ x : ℝ, f' x = deriv ((p₁ - p₂ : 𝓢(ℝ, ℝ)) : ℝ → ℝ) x := by
        intro x
        rw [hf'def, SchwartzMap.derivCLM_apply]
      have hf' : ∀ x : ℝ, f' x = deriv (p₁ : ℝ → ℝ) x - deriv (p₂ : ℝ → ℝ) x := by
        intro x
        rw [hf'2]
        have : ((p₁ - p₂ : 𝓢(ℝ, ℝ)) : ℝ → ℝ) = fun y => p₁ y - p₂ y := by
          funext y; simp
        rw [this]
        exact deriv_sub p₁.differentiableAt p₂.differentiableAt
      have hVdiff : V₁ s - V₂ s = (16 * κ ^ 5) • w + (4 * κ ^ 2) • f' := by
        ext x
        simp only [SchwartzMap.sub_apply, SchwartzMap.add_apply, SchwartzMap.smul_apply,
          smul_eq_mul]
        rw [e1 x, e2 x, hw x, hf' x]
        simp only [hkRHS]
        ring
      have hLV : toHm1 (V₁ s) - toHm1 (V₂ s) =
          (16 * κ ^ 5) • toHm1 w + (4 * κ ^ 2) • toHm1 f' := by
        have := congrArg Lc hVdiff
        rw [map_sub, map_add, map_smul, map_smul] at this
        simp only [hLc] at this
        exact this
      have hLx : toHm1 p₁ - toHm1 p₂ = toHm1 (p₁ - p₂) := by
        have := (map_sub Lc p₁ p₂).symm
        simp only [hLc] at this
        exact this
      have htr : inner ℝ (toHm1 (p₁ - p₂)) (toHm1 f') = 0 := s6 _ _ (s5 (p₁ - p₂) f' hf'2)
      have hwb : ‖toHm1 w‖ ≤ Lk * ‖toHm1 p₁ - toHm1 p₂‖ := by
        have := hGk p₁ p₂ (greenOffset κ p₁) (greenOffset κ p₂) w (le_trans hp₁s hsG)
          (le_trans hp₂s hsG) (hgreen p₁ (le_trans hp₁s hsU)) (hgreen p₂ (le_trans hp₂s hsU)) hw
        rw [hdist] at this
        exact this
      rw [hLV, inner_add_right, real_inner_smul_right, real_inner_smul_right, hLx, htr, ← hLx,
        mul_zero, add_zero, hΛdef]
      have hk5 : 0 ≤ 16 * κ ^ 5 := by positivity
      rw [abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2), abs_of_nonneg hk5]
      have hx0 := norm_nonneg (toHm1 p₁ - toHm1 p₂)
      have hin := abs_real_inner_le_norm (toHm1 p₁ - toHm1 p₂) (toHm1 w)
      calc 2 * (16 * κ ^ 5 * |inner ℝ (toHm1 p₁ - toHm1 p₂) (toHm1 w)|)
          ≤ 2 * (16 * κ ^ 5 * (‖toHm1 p₁ - toHm1 p₂‖ * (Lk * ‖toHm1 p₁ - toHm1 p₂‖))) := by
            gcongr
            exact hin.trans (mul_le_mul_of_nonneg_left hwb hx0)
        _ = 32 * κ ^ 5 * Lk * ‖toHm1 p₁ - toHm1 p₂‖ ^ 2 := by ring
    intro t
    have hg := s7 (fun s => ‖toHm1 (hkFlow κ s (a m)) - toHm1 (hkFlow κ s (a n))‖ ^ 2)
      (fun s => 2 * inner ℝ (toHm1 (hkFlow κ s (a m)) - toHm1 (hkFlow κ s (a n)))
          (toHm1 (V₁ s) - toHm1 (V₂ s))) Λ hD hbd t
    simp only [hkFlow_zero] at hg
    rw [hdist, hdist]
    exact hg
  
  
  
  have hM : 1 ≤ Real.exp (Λ * T) := Real.one_le_exp (mul_nonneg hΛ hT.le)
  have hM0 : 0 < Real.exp (Λ * T) := Real.exp_pos _
  obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.1 hc (ε / Real.exp (Λ * T)) (div_pos hε hM0)
  refine ⟨N, fun m hm n hn t ht => ?_⟩
  have h1 := hlip m n t
  have h2 : dist (ι (a m)) (ι (a n)) < ε / Real.exp (Λ * T) := hN m hm n hn
  have h3 : Real.exp (Λ * |t|) ≤ Real.exp (Λ * T) :=
    Real.exp_le_exp.2 (mul_le_mul_of_nonneg_left ht hΛ)
  have h4 : dist (ι (a m)) (ι (a n)) ^ 2 < (ε / Real.exp (Λ * T)) ^ 2 :=
    pow_lt_pow_left₀ h2 dist_nonneg two_ne_zero
  have h5 : Real.exp (Λ * T) * (ε / Real.exp (Λ * T)) ^ 2 ≤ ε ^ 2 := by
    rw [div_pow, mul_div_assoc', div_le_iff₀ (by positivity)]
    nlinarith [mul_nonneg (mul_nonneg hM0.le (sq_nonneg ε)) (sub_nonneg.2 hM)]
  have h6 : dist (ι (hkFlow κ t (a m))) (ι (hkFlow κ t (a n))) ^ 2 < ε ^ 2 := by
    calc dist (ι (hkFlow κ t (a m))) (ι (hkFlow κ t (a n))) ^ 2
        ≤ Real.exp (Λ * |t|) * dist (ι (a m)) (ι (a n)) ^ 2 := h1
      _ ≤ Real.exp (Λ * T) * dist (ι (a m)) (ι (a n)) ^ 2 :=
          mul_le_mul_of_nonneg_right h3 (sq_nonneg _)
      _ < Real.exp (Λ * T) * (ε / Real.exp (Λ * T)) ^ 2 := mul_lt_mul_of_pos_left h4 hM0
      _ ≤ ε ^ 2 := h5
  exact (abs_lt_of_sq_lt_sq' h6 hε.le).2

theorem kdvRHS_curve_hasDerivAt : (∀ p : 𝓢(ℝ, ℝ), ∃ c : 𝓢(ℝ, ℝ), ∀ x : ℝ, c x = kdvRHS p x) ∧
    ∀ (b c : ℝ → 𝓢(ℝ, ℝ)) (b' : 𝓢(ℝ, ℝ)) (τ : ℝ), HasDerivAt b b' τ →
      (∀ r x, c r x = kdvRHS (b r) x) →
      ∃ w : 𝓢(ℝ, ℝ), (∀ x : ℝ, w x = -iteratedDeriv 3 (b' : ℝ → ℝ) x
          + 6 * deriv (fun y : ℝ => b τ y * b' y) x) ∧
        HasDerivAt (fun r : ℝ => ι (c r)) (ι w) τ :=
by
  classical
  
  obtain ⟨D, hD⟩ : ∃ D : 𝓢(ℝ, ℝ) →L[ℝ] 𝓢(ℝ, ℝ), ∀ (f : 𝓢(ℝ, ℝ)) (x : ℝ), D f x = deriv f x :=
    ⟨SchwartzMap.derivCLM ℝ ℝ, fun f x => SchwartzMap.derivCLM_apply ℝ f x⟩
  obtain ⟨M, hM⟩ : ∃ M : 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ), ∀ (p q : 𝓢(ℝ, ℝ)) (x : ℝ),
      M p q x = p x * q x :=
    ⟨fun p q => SchwartzMap.bilinLeftCLM (ContinuousLinearMap.mul ℝ ℝ) q.hasTemperateGrowth p,
      fun p q x => by simp [SchwartzMap.bilinLeftCLM_apply]⟩
  have hd : ∀ f : 𝓢(ℝ, ℝ), deriv (f : ℝ → ℝ) = D f := fun f => funext fun x => (hD f x).symm
  have hD3 : ∀ (p : 𝓢(ℝ, ℝ)) (x : ℝ), iteratedDeriv 3 (p : ℝ → ℝ) x = D (D (D p)) x := by
    intro p x
    rw [iteratedDeriv_succ, iteratedDeriv_succ, iteratedDeriv_one, hd, hd, hd]
  have hK : ∀ (p : 𝓢(ℝ, ℝ)) (x : ℝ), kdvRHS p x = -(D (D (D p)) x) + 6 * p x * D p x := by
    intro p x
    unfold kdvRHS
    rw [hD3, hD p]
  have hprod : ∀ (p q : 𝓢(ℝ, ℝ)) (x : ℝ),
      deriv (fun y : ℝ => p y * q y) x = D p x * q x + p x * D q x := by
    intro p q x
    have e : (fun y : ℝ => p y * q y) = (⇑p * ⇑q) := rfl
    rw [e, deriv_mul (p.differentiableAt) (q.differentiableAt), hD, hD]
  
  have P : ∀ (u v w : 𝓢(ℝ, ℝ)), (∀ x : ℝ, w x = u x * v x) → ∀ k n : ℕ,
      SchwartzMap.seminorm ℝ k n w ≤ ∑ i ∈ Finset.range (n + 1),
        (n.choose i : ℝ) * SchwartzMap.seminorm ℝ k i u * SchwartzMap.seminorm ℝ 0 (n - i) v := by
    intro u v w huv k n
    have hw : (w : ℝ → ℝ) = fun y => u y * v y := funext huv
    refine SchwartzMap.seminorm_le_bound ℝ k n w
      (Finset.sum_nonneg fun i _ => mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (apply_nonneg _ _))
        (apply_nonneg _ _)) (fun x => ?_)
    rw [hw]
    have h1 := norm_iteratedFDeriv_mul_le (𝕜 := ℝ) (u.smooth ⊤) (v.smooth ⊤) x (n := n)
      (by exact_mod_cast le_top)
    calc ‖x‖ ^ k * ‖iteratedFDeriv ℝ n (fun y => u y * v y) x‖
        ≤ ‖x‖ ^ k * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
            ‖iteratedFDeriv ℝ i u x‖ * ‖iteratedFDeriv ℝ (n - i) v x‖ :=
          mul_le_mul_of_nonneg_left h1 (by positivity)
      _ = ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
            (‖x‖ ^ k * ‖iteratedFDeriv ℝ i u x‖) * ‖iteratedFDeriv ℝ (n - i) v x‖ := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          ring
      _ ≤ _ := by
          refine Finset.sum_le_sum fun i _ => ?_
