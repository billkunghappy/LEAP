      (hm : ∀ x : ℝ, HasDerivAt (Wm : ℝ → ℝ) (q x - 2 * Wm x - Wm x ^ 2) x)
      (hpos : ∀ x : ℝ, 0 < 2 + Wm x - Wp x)
      (hγ : ∀ x : ℝ, γ x = 1 / (2 + Wm x - Wp x) - 1 / 2)
      (hu : ∀ x : ℝ, u x = (Wm x - Wp x) / 2)
      (hH : ∀ x : ℝ, H x = -2 * deriv (q : ℝ → ℝ) x + (2 * q x - 4 - 4 * κ ^ 2) * (Wm x + Wp x)
          - c * (deriv (Γ : ℝ → ℝ) x - (1 / (2 * κ) + Γ x) * (Wm x + Wp x)))
      (hZp : ∀ x : ℝ, Zp x = (deriv (H : ℝ → ℝ) x + H x * (2 + Wm x - Wp x)) / 2)
      (hZm : ∀ x : ℝ, Zm x = (deriv (H : ℝ → ℝ) x - H x * (2 + Wm x - Wp x)) / 2)
