          ((hasDerivAt_id' τ).const_mul K).neg.exp
        exact (h1.mul (hE τ)).congr_deriv (by ring)
      have hanti : AntitoneOn (fun τ => Real.exp (-(K * τ)) * E τ) (Set.Icc 0 t) := by
