        ∫ ξ : ℝ, (4 + ξ ^ 2) ^ 2 *
          ‖(Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1) * (toHm1 u : ℝ → ℂ) ξ‖ ^ 2 := by
      apply integral_congr_ae
      rw [htsub]
      filter_upwards [Lp.coeFn_sub (toHm1 uh) (toHm1 u), hua] with ξ h1 h2
      rw [h1, Pi.sub_apply, h2, sub_one_mul]
    have hdist : dist (ι qh) (ι q) ^ 2 = translateDiffSq (toHm1 q) h := by
      rw [dist_eq_norm]
      show ‖toHm1 qh - toHm1 q‖ ^ 2 = _
      rw [← hL2]
      unfold translateDiffSq
      apply integral_congr_ae
      filter_upwards [Lp.coeFn_sub (toHm1 qh) (toHm1 q), hqa] with ξ h1 h2
      rw [h1, Pi.sub_apply, h2, sub_one_mul]
    rw [hLHS, hdist] at hlip
    exact hlip
  exact translation_average_transfer (toHm1 u) (toHm1 q) (L ^ 2) K (sq_nonneg L) hK0 hρ
    (fun ξ => (hEρ ξ).2) (hFac u).1 hfg

theorem good_unknown_inverse_lipschitz : ∃ δ > (0 : ℝ), ∃ L ≥ (0 : ℝ), ∀ q p u w : 𝓢(ℝ, ℝ), ‖ι q‖ ≤ δ → ‖ι p‖ ≤ δ →
      (∀ x : ℝ, u x = 1 / (1 + 2 * greenOffset 1 q x) - 1) →
      (∀ x : ℝ, w x = 1 / (1 + 2 * greenOffset 1 p x) - 1) →
      dist (ι q) (ι p) ≤ L * Real.sqrt (∫ x : ℝ,
        (deriv ((u - w : 𝓢(ℝ, ℝ)) : ℝ → ℝ) x) ^ 2 + 4 * ((u - w) x) ^ 2) :=
by
  classical
  obtain ⟨δ₁, hδ₁, L₁, hL₁, U, hU⟩ := green_one_good_unknown
  obtain ⟨δG, hδG, hEU⟩ := green_exists_unique
  obtain ⟨Λ, hΛ⟩ := toHm1_clm
  
  
  
  obtain ⟨Mul, hMul⟩ : ∃ Mul : 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ), ∀ (f g : 𝓢(ℝ, ℝ)) (x : ℝ),
      Mul f g x = f x * g x :=
    ⟨fun f g => SchwartzMap.bilinLeftCLM (ContinuousLinearMap.mul ℝ ℝ) g.hasTemperateGrowth f,
      fun f g x => by simp [SchwartzMap.bilinLeftCLM_apply]⟩
