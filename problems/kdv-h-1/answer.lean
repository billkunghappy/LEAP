      - 2 * Real.sqrt (∫ y : ℝ, h y ^ 2))]
  
  
  
  have hbridge : ∀ f : 𝓢(ℝ, ℝ), ‖ι f‖ = Real.sqrt (∫ x : ℝ, riccatiK 1 f x ^ 2) := by
    intro f
