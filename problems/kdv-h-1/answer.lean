  have hB : ∀ κ ≥ κ₀,
      (∫ ξ : ℝ, ((4 + ξ ^ 2) / (ξ ^ 2 + 4 * κ ^ 2)) *
          ‖((ι (u t) : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2) ≤
        C₀ * ∫ ξ : ℝ, ((4 + ξ ^ 2) / (ξ ^ 2 + 4 * κ ^ 2)) *
          ‖((ι (u 0) : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 := by
    intro κ hκ
    have hκpos : 0 < κ := lt_of_lt_of_le hκ₀pos hκ
    obtain ⟨s, hs⟩ : ∃ s : ℝ, c ^ 3 * s = t := ⟨t / c ^ 3, by field_simp⟩
    have hcκ : c * κ ≥ 1 := by
