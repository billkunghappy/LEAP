    · simpa only [pow_zero, one_mul] using F2 f 0 n (x + a)
  have hτex : ∀ (f : 𝓢(ℝ, ℝ)) (a : ℝ), ∃ g : 𝓢(ℝ, ℝ), ∀ x : ℝ, g x = f (x + a) := by
    intro f a
    refine ⟨SchwartzMap.mk (fun x => f (x + a))
      ((f.smooth ⊤).comp (contDiff_id.add contDiff_const)) ?_, fun x => rfl⟩
    intro k n
    refine ⟨2 ^ k * (SchwartzMap.seminorm ℝ k n f + |a| ^ k * SchwartzMap.seminorm ℝ 0 n f),
      fun x => ?_⟩
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, Real.norm_eq_abs]
    exact hP f a x k n
  
  refine ⟨min δ₂ δ₅, lt_min hδ₂ hδ₅, L ^ 2, sq_nonneg L, ?_⟩
  intro K hK q u hq hu
  have hK0 : 0 < K := by linarith
  have hq2 : ‖ι q‖ ≤ δ₂ := hq.trans (min_le_left _ _)
  have hq5 : ‖ι q‖ ≤ δ₅ := hq.trans (min_le_right _ _)
  obtain ⟨hρ, hEρ⟩ := exp_abs_average_identity K hK0
  
  have hfg : ∀ h : ℝ, (∫ ξ : ℝ, (4 + ξ ^ 2) ^ 2 *
      ‖(Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1) * (toHm1 u : ℝ → ℂ) ξ‖ ^ 2) ≤
        L ^ 2 * translateDiffSq (toHm1 q) h := by
    intro h
    obtain ⟨qh, hqh⟩ := hτex q h
    obtain ⟨uh, huh⟩ := hτex u h
    obtain ⟨hqa, hqn⟩ := toHm1_translate q qh h hqh
    obtain ⟨hua, -⟩ := toHm1_translate u uh h huh
    have hqhn : ‖ι qh‖ = ‖ι q‖ := by
      show ‖toHm1 qh‖ = ‖toHm1 q‖
      exact hqn
    have hgo := hT 1 le_rfl q qh h hqh hq2 (hqhn ▸ hq2)
    have huh' : ∀ x : ℝ, uh x = 1 / (1 + 2 * greenOffset 1 qh x) - 1 := by
      intro x
      rw [huh, hu, hgo]
    have hlip := hLip qh q uh u (hqhn ▸ hq5) hq5 huh' hu
    rw [← (hFac (uh - u)).2] at hlip
