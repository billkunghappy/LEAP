        intro s hs
        have h0' : HasDerivAt (fun s : ℝ => (2 * K + 1) * s) (2 * K + 1) s := by
          simpa using (hasDerivAt_id' s).const_mul (2 * K + 1)
        exact (h0'.exp.mul (hφ s (hsT s hs))).add ((hasDerivAt_id' s).const_mul (B ^ 2))
      have hmono : MonotoneOn (fun s => Real.exp ((2 * K + 1) * s) * ‖R s‖ ^ 2 + B ^ 2 * s)
