    have hSne : S.Nonempty := ⟨t₁, by rw [hS]; exact ⟨⟨ht₁, le_rfl⟩, hcon⟩⟩
    have hSb : BddBelow S := ⟨0, fun s hs => by rw [hS] at hs; exact hs.1.1⟩
    have hmem : sInf S ∈ S := hSc.csInf_mem hSne hSb
    obtain ⟨t₂, ht₂⟩ : ∃ t₂ : ℝ, t₂ = sInf S := ⟨_, rfl⟩
    rw [← ht₂] at hmem
    have hmem' : t₂ ∈ Set.Icc 0 t₁ ∩ φ ⁻¹' Set.Ici θ := by rw [← hS]; exact hmem
    have hθt₂ : θ ≤ φ t₂ := hmem'.2
    have ht₂0 : 0 ≤ t₂ := hmem'.1.1
    have ht₂1 : t₂ ≤ t₁ := hmem'.1.2
    have hlow : ∀ s, 0 ≤ s → s < t₂ → φ s < θ := by
      intro s hs0 hst
      by_contra hc
      push_neg at hc
      have hsS : s ∈ S := by rw [hS]; exact ⟨⟨hs0, by linarith⟩, hc⟩
      have := csInf_le hSb hsS
      linarith
    have ht₂pos : 0 < t₂ := by
      rcases eq_or_lt_of_le ht₂0 with h | h
      · exfalso
        rw [← h] at hθt₂
        linarith
      · exact h
    have hle : φ t₂ ≤ θ := by
      have hcl' : IsClosed {s | φ s ≤ θ} := isClosed_le hφ continuous_const
      have hsub : Set.Ico 0 t₂ ⊆ {s | φ s ≤ θ} := fun s hs => (hlow s hs.1 hs.2).le
      have hcs := hcl'.closure_subset_iff.2 hsub
      rw [closure_Ico ht₂pos.ne] at hcs
      exact hcs ⟨ht₂pos.le, le_rfl⟩
    have hderI : ∀ s ∈ Set.Icc 0 t₂, HasDerivAt α 0 s := by
      intro s hs
      rcases eq_or_lt_of_le hs.2 with h | h
      · rw [h]; exact hder _ hle
      · exact hder s (hlow s hs.1 h).le
    have hconst := constant_of_has_deriv_right_zero
      (fun s hs => (hderI s hs).continuousAt.continuousWithinAt)
      (fun s hs => (hderI s ⟨hs.1, hs.2.le⟩).hasDerivWithinAt) t₂ ⟨ht₂pos.le, le_rfl⟩
    have := hcl t₂ hle hconst
    linarith
  
  have boot : ∀ (φ α : ℝ → ℝ) (θ : ℝ), Continuous φ → φ 0 < θ →
      (∀ t, φ t ≤ θ → HasDerivAt α 0 t) → (∀ t, φ t ≤ θ → α t = α 0 → φ t < θ) →
