  have hφ0 : φ 0 ≤ 1 / 256 := by
    have h1 : ‖toHm1 (u 0)‖ ≤ 1 / 16 := h0
    have h2 := norm_nonneg (toHm1 (u 0))
    rw [hφ]
    nlinarith
  
  have hB : ∀ κ ≥ (1 : ℝ), ∀ s, MemLp (riccatiK κ (u s)) 2 (volume : Measure ℝ) ∧
      A κ s = W κ s ∧ W κ s ≤ φ s ∧ 0 ≤ W κ s := by
    intro κ hκ s
