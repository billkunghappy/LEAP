              - riccatiK κ (fun y => q₂ y - w₂ y ^ 2) x :=
          S _ _ (iq₁.sub iw₁) (iq₂.sub iw₂) x
        have e4 : riccatiK κ (fun y => (q₁ y - q₂ y) - (w₁ y + w₂ y) * (w₁ y - w₂ y)) x =
