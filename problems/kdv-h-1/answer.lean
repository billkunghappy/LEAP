    have hvpc := hcont vp _ hvpD
    have hvmc := hcont vm _ hvmD
    
    have hiso : (∫ x in (0:ℝ)..1, vm x ^ 2) = ∫ x in (0:ℝ)..1, vp x ^ 2 := by
      have hF : ∀ x ∈ Set.uIcc (0:ℝ) 1, HasDerivAt
          (fun y => -(1 / (4 * κ)) * ((vm y - vp y) * (vm y - vp y)))
          (vm x ^ 2 - vp x ^ 2) x := by
        intro x _
        have h1 := (((hvmD x).sub (hvpD x)).mul ((hvmD x).sub (hvpD x))).const_mul
          (-(1 / (4 * κ)))
        refine h1.congr_deriv ?_
        simp only [Pi.sub_apply]
        field_simp
        ring
      have hint : IntervalIntegrable (fun x => vm x ^ 2 - vp x ^ 2) MeasureTheory.volume 0 1 :=
        ((hvmc.pow 2).sub (hvpc.pow 2)).intervalIntegrable 0 1
      have h2 := intervalIntegral.integral_eq_sub_of_hasDerivAt hF hint
      rw [intervalIntegral.integral_sub ((hvmc.pow 2).intervalIntegrable 0 1)
        ((hvpc.pow 2).intervalIntegrable 0 1)] at h2
      have h3 : vm 1 = vm 0 := by simpa using hvmP 0
      have h4 : vp 1 = vp 0 := by simpa using hvpP 0
      rw [h3, h4, sub_self] at h2
      linarith
    have hvmr : (∫ x in (0:ℝ)..1, vm x ^ 2) = ∫ x in (0:ℝ)..1, vr x ^ 2 := by
      simp only [hvmx]
      exact hRsq vr hvrP
    have hvr2 : (∫ x in (0:ℝ)..1, vr x ^ 2) ≤ κ / 1024 := by linarith
    
    obtain ⟨wp, hwpP, hwpD, -, hwp2'⟩ :=
      periodic_riccati_exists_T κ hκ Q vp hQc hQp hvpP hvpD hvp2
    obtain ⟨wr, hwrP, hwrD, -, hwr2'⟩ :=
      periodic_riccati_exists_T κ hκ Qr vr hQrc hQrp hvrP hvrD hvr2
    obtain ⟨wm, hwm⟩ : ∃ wm : ℝ → ℝ, wm = fun y => -wr (-y) := ⟨_, rfl⟩
    have hwmx : ∀ x, wm x = -wr (-x) := fun x => by rw [hwm]
    have hwmP : Function.Periodic wm 1 := by rw [hwm]; exact hreflP wr hwrP
    have hwmD : ∀ x, HasDerivAt wm (Q x - 2 * κ * wm x - wm x ^ 2) x := by
      intro x
      rw [hwm]
      refine (hreflD wr _ hwrD x).congr_deriv ?_
      simp only [hQrx, neg_neg]
      ring
    have hwmr : (∫ x in (0:ℝ)..1, wm x ^ 2) = ∫ x in (0:ℝ)..1, wr x ^ 2 := by
      simp only [hwmx]
      exact hRsq wr hwrP
    have hwpW : (∫ x in (0:ℝ)..1, wp x ^ 2) ≤
        2 * WT κ ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) := by
      rw [hvpW] at hwp2'
      linarith
    have hvrW : (∫ x in (0:ℝ)..1, vr x ^ 2) =
        WT κ ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) := by
      rw [← hvmr, hiso, hvpW]
    have hwmW : (∫ x in (0:ℝ)..1, wm x ^ 2) ≤
        2 * WT κ ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) := by
      rw [hwmr]
      rw [hvrW] at hwr2'
      linarith
    have hwp64 : (∫ x in (0:ℝ)..1, wp x ^ 2) ≤ κ / 64 := by linarith
    have hwr64 : (∫ x in (0:ℝ)..1, wr x ^ 2) ≤ κ / 64 := by linarith
    
    have hdp : ∀ x, |wp x - vp x| ≤ κ / 32 := by
      intro x
      have h := hdiff Q vp wp hvpP hvpD hwpP hwpD x
      linarith
    have hdm : ∀ x, |wm x - vm x| ≤ κ / 32 := by
      intro x
      have h := hdiff Qr vr wr hvrP hvrD hwrP hwrD (-x)
      rw [hwmx, hvmx, show -wr (-x) - -vr (-x) = -(wr (-x) - vr (-x)) by ring, abs_neg]
      linarith
    
    have hsob : ∀ x, |vm x - vp x| ≤ κ / 4 := by
      intro x
      have hhc : Continuous (fun t => κ * (vm t - vp t) ^ 2 + 4 * κ * (vm t + vp t) ^ 2) :=
        (continuous_const.mul ((hvmc.sub hvpc).pow 2)).add
          (continuous_const.mul ((hvmc.add hvpc).pow 2))
      have hhp : Function.Periodic
          (fun t => κ * (vm t - vp t) ^ 2 + 4 * κ * (vm t + vp t) ^ 2) 1 := fun t => by
        simp only [hvmP t, hvpP t]
      have hh0 : ∀ t, 0 ≤ κ * (vm t - vp t) ^ 2 + 4 * κ * (vm t + vp t) ^ 2 := fun t => by
        positivity
      have hDc : Continuous (fun t => -4 * κ * ((vm t - vp t) * (vm t + vp t))) :=
        continuous_const.mul ((hvmc.sub hvpc).mul (hvmc.add hvpc))
      have hu2c : Continuous (fun t => (vm t - vp t) ^ 2) := (hvmc.sub hvpc).pow 2
      have hu2p : Function.Periodic (fun t => (vm t - vp t) ^ 2) 1 := fun t => by
        simp only [hvmP t, hvpP t]
      have hIh : (∫ t in (x - 1)..x, κ * (vm t - vp t) ^ 2 + 4 * κ * (vm t + vp t) ^ 2) =
          ∫ t in (0:ℝ)..1, κ * (vm t - vp t) ^ 2 + 4 * κ * (vm t + vp t) ^ 2 := by
        have h1 := hhp.intervalIntegral_add_eq (x - 1) 0
        rw [show x - 1 + 1 = x by ring, zero_add] at h1
        exact h1
      have hIu : (∫ t in (x - 1)..x, (vm t - vp t) ^ 2) =
          ∫ t in (0:ℝ)..1, (vm t - vp t) ^ 2 := by
        have h1 := hu2p.intervalIntegral_add_eq (x - 1) 0
        rw [show x - 1 + 1 = x by ring, zero_add] at h1
        exact h1
      set I := ∫ t in (0:ℝ)..1, κ * (vm t - vp t) ^ 2 + 4 * κ * (vm t + vp t) ^ 2 with hI
      have key : ∀ y ∈ Set.Icc (x - 1) x, (vm x - vp x) ^ 2 ≤ (vm y - vp y) ^ 2 + I := by
        intro y hy
        have hF : ∀ t ∈ Set.uIcc y x, HasDerivAt (fun s => (vm s - vp s) * (vm s - vp s))
            (-4 * κ * ((vm t - vp t) * (vm t + vp t))) t := by
          intro t _
          refine (((hvmD t).sub (hvpD t)).mul ((hvmD t).sub (hvpD t))).congr_deriv ?_
          simp only [Pi.sub_apply]
          ring
        have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hF
          (hDc.intervalIntegrable y x)
        have hmon := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) hy.2
          (hDc.intervalIntegrable y x)
          (hhc.intervalIntegrable y x) (fun t _ => by
            nlinarith [mul_nonneg hκ0.le (sq_nonneg ((vm t - vp t) + 2 * (vm t + vp t)))])
        have hadd := intervalIntegral.integral_add_adjacent_intervals (μ := MeasureTheory.volume)
          (hhc.intervalIntegrable (x - 1) y) (hhc.intervalIntegrable y x)
        have hnn := intervalIntegral.integral_nonneg (μ := MeasureTheory.volume) hy.1
          (fun t _ => hh0 t)
        rw [hIh] at hadd
        nlinarith
      have hmono := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume)
        (by linarith : x - 1 ≤ x)
        (f := fun _ => (vm x - vp x) ^ 2) (g := fun y => (vm y - vp y) ^ 2 + I)
        (continuous_const.intervalIntegrable _ _)
        ((hu2c.add continuous_const).intervalIntegrable _ _) key
      rw [intervalIntegral.integral_const, intervalIntegral.integral_add
        (hu2c.intervalIntegrable _ _) (continuous_const.intervalIntegrable _ _),
        intervalIntegral.integral_const, hIu] at hmono
      simp only [show x - (x - 1) = (1:ℝ) by ring, one_smul] at hmono
      have hA := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) zero_le_one
        (f := fun y => (vm y - vp y) ^ 2 + (κ * (vm y - vp y) ^ 2 + 4 * κ * (vm y + vp y) ^ 2))
        (g := fun y => 12 * κ * (vm y ^ 2 + vp y ^ 2))
        ((hu2c.add hhc).intervalIntegrable _ _)
        ((continuous_const.mul ((hvmc.pow 2).add (hvpc.pow 2))).intervalIntegrable _ _)
        (fun y _ => by
          nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ 3 * κ - 1) (sq_nonneg (vm y - vp y)),
            mul_nonneg hκ0.le (sq_nonneg (vm y)), mul_nonneg hκ0.le (sq_nonneg (vp y))])
      rw [intervalIntegral.integral_add (hu2c.intervalIntegrable _ _)
        (hhc.intervalIntegrable _ _),
        intervalIntegral.integral_const_mul, intervalIntegral.integral_add
        ((hvmc.pow 2).intervalIntegrable _ _) ((hvpc.pow 2).intervalIntegrable _ _)] at hA
      have hB : 12 * κ * ((∫ x in (0:ℝ)..1, vm x ^ 2) + ∫ x in (0:ℝ)..1, vp x ^ 2) ≤
          12 * κ * (κ / 1024 + κ / 1024) :=
        mul_le_mul_of_nonneg_left (by linarith) (by positivity)
      have hsq : (vm x - vp x) ^ 2 ≤ (κ / 4) ^ 2 := by nlinarith
      exact abs_le_of_sq_le_sq hsq (by positivity)
    refine ⟨wp, wm, hwpP, hwmP, hwpD, hwmD, hwpW, hwmW, fun x => ?_⟩
    have e1 := abs_le.1 (hsob x)
    have e2 := abs_le.1 (hdm x)
    have e3 := abs_le.1 (hdp x)
    rw [abs_le]
    constructor <;> linarith
  
  have boot : ∀ (β : ℝ) (w : ℝ → ℝ),
      (∀ x, HasDerivAt w ((q : ℝ → ℝ) x + β * w x - w x ^ 2) x) →
      ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) w := by
    intro β w hw
    have hdw : deriv w = fun x => (q : ℝ → ℝ) x + β * w x - w x ^ 2 :=
      funext fun x => (hw x).deriv
    have hdiff : Differentiable ℝ w := fun x => (hw x).differentiableAt
    have hn : ∀ n : ℕ, ContDiff ℝ n w := by
      intro n
      induction n with
      | zero => exact contDiff_zero.2 hdiff.continuous
      | succ n ih =>
        rw [Nat.cast_succ, contDiff_succ_iff_deriv]
        refine ⟨hdiff, fun h => absurd h (by simp), ?_⟩
        rw [hdw]
        have hq : ContDiff ℝ n (q : ℝ → ℝ) := contDiff_infty.1 q.2.1 n
        exact (hq.add (contDiff_const.mul ih)).sub (ih.pow 2)
    exact contDiff_infty.2 hn
  obtain ⟨wp, wm, hwpP, hwmP, hwpD, hwmD, hwp2, hwm2, hd⟩ := pair
  have hpos : ∀ x, 0 < 2 * κ + wm x - wp x := by
    intro x
    have h := (abs_le.1 (hd x)).1
    linarith
  obtain ⟨hG, hform⟩ := greenT_eq_of_riccati_pair_T κ q wp wm hwpP hwmP hwpD hwmD hpos
  have hsp := boot (2 * κ) wp hwpD
  have hsm := boot (-(2 * κ)) wm fun x => (hwmD x).congr_deriv (by ring)
  exact ⟨hG, wp, wm, hsp, hsm, hwpP, hwmP, hwpD, hwmD, hwp2, hwm2, hd, hform⟩

theorem good_unknown_T : ∀ R ≥ (0 : ℝ), ∃ ϰ₀ ≥ (1 : ℝ), ∀ ϰ ≥ ϰ₀, ∃ L ≥ (1 : ℝ), ∃ U : CinfT → CinfT, ∀ q : CinfT, ‖ιT q‖ ≤ R → (∀ x, (U q : ℝ → ℝ) x = 1 / (2 * greenT ϰ (q : ℝ → ℝ) x) - ϰ) ∧ (∫ x in (0:ℝ)..1, (deriv (U q : ℝ → ℝ) x) ^ 2 + 4 * ((U q : ℝ → ℝ) x) ^ 2) ≤ L ^ 2 :=
by
  intro R hR
  obtain ⟨κ₀, hκ₀, hs1⟩ := greenT_riccati_region_T R hR
  refine ⟨κ₀, hκ₀, fun ϰ hϰ => ?_⟩
  have hϰ1 : (1:ℝ) ≤ ϰ := le_trans hκ₀ hϰ
  have hϰpos : (0:ℝ) < ϰ := by linarith
  have hGprop : ∀ f : ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (greenT ϰ f) ∧
      Function.Periodic (greenT ϰ f) 1 ∧ ∀ x, 0 < greenT ϰ f x := by
    intro f
    unfold greenT
    split_ifs with h
    · obtain ⟨h1, h2, h3, -⟩ := Classical.choose_spec h
      exact ⟨h1, h2, h3⟩
    · exact ⟨contDiff_const, fun _ => rfl, fun _ => by positivity⟩
  let U : CinfT → CinfT := fun q => ⟨fun x => 1 / (2 * greenT ϰ (q : ℝ → ℝ) x) - ϰ, by
      have hG := hGprop (q : ℝ → ℝ)
      refine ⟨?_, ?_⟩
      · exact (contDiff_const.div (contDiff_const.mul hG.1)
          (fun x => (mul_pos two_pos (hG.2.2 x)).ne')).sub contDiff_const
      · intro x
        simp only [hG.2.1 x]⟩
  refine ⟨1 + (4 * ϰ + 3) * R, ?_, U, fun q hq => ⟨fun x => rfl, ?_⟩⟩
  · have : 0 ≤ (4 * ϰ + 3) * R := mul_nonneg (by linarith) hR
    linarith
  obtain ⟨-, wp, wm, hwpC, hwmC, -, -, hwp', hwm', hIp, hIm, hd, hg⟩ := hs1 ϰ hϰ q hq
  have hUx : ∀ x, (U q : ℝ → ℝ) x = (wm x - wp x) / 2 := by
    intro x
    show 1 / (2 * greenT ϰ (q : ℝ → ℝ) x) - ϰ = _
    rw [hg x]
    have hden : 0 < 2 * ϰ + wm x - wp x := by
      have := (abs_le.1 (hd x)).1
      linarith
    have hne : 2 * ϰ + wm x - wp x ≠ 0 := hden.ne'
    field_simp
    ring
  have hUfun : (U q : ℝ → ℝ) = fun x => (wm x - wp x) / 2 := funext hUx
  have hUd : ∀ x, deriv (U q : ℝ → ℝ) x =
      -(ϰ * (wm x + wp x)) + (wp x ^ 2 - wm x ^ 2) / 2 := by
    intro x
    rw [hUfun]
    have h := ((hwm' x).sub (hwp' x)).div_const 2
    exact h.deriv.trans (by ring)
  have hint : (∫ x in (0:ℝ)..1, (deriv (U q : ℝ → ℝ) x) ^ 2 + 4 * ((U q : ℝ → ℝ) x) ^ 2) =
      ∫ x in (0:ℝ)..1, ((-(ϰ * (wm x + wp x)) + (wp x ^ 2 - wm x ^ 2) / 2) ^ 2 +
        4 * ((wm x - wp x) / 2) ^ 2) := by
    apply intervalIntegral.integral_congr
    intro x _
    simp only [hUd x, hUx x]
  rw [hint]
  have hwpc := hwpC.continuous
  have hwmc := hwmC.continuous
  have hA : 0 ≤ 25 * ϰ ^ 2 / 8 + 2 := by positivity
  have hpt : ∀ x, ((-(ϰ * (wm x + wp x)) + (wp x ^ 2 - wm x ^ 2) / 2) ^ 2 +
      4 * ((wm x - wp x) / 2) ^ 2) ≤ (25 * ϰ ^ 2 / 8 + 2) * (wp x ^ 2 + wm x ^ 2) := by
    intro x
    obtain ⟨h1, h2⟩ := abs_le.1 (hd x)
    generalize wp x = a at h1 h2 ⊢
    generalize wm x = b at h1 h2 ⊢
    have hc0 : 0 ≤ ϰ + (b - a) / 2 := by linarith
    have hc1 : ϰ + (b - a) / 2 ≤ 5 * ϰ / 4 := by linarith
    have hcsq : (ϰ + (b - a) / 2) ^ 2 ≤ (5 * ϰ / 4) ^ 2 := pow_le_pow_left₀ hc0 hc1 2
    have hfac : (-(ϰ * (b + a)) + (a ^ 2 - b ^ 2) / 2) ^ 2 =
        (a + b) ^ 2 * (ϰ + (b - a) / 2) ^ 2 := by ring
    rw [hfac]
    have hab : (a + b) ^ 2 ≤ 2 * (a ^ 2 + b ^ 2) := by nlinarith [sq_nonneg (a - b)]
    have hk : (a + b) ^ 2 * (ϰ + (b - a) / 2) ^ 2 ≤ 2 * (a ^ 2 + b ^ 2) * (5 * ϰ / 4) ^ 2 :=
      mul_le_mul hab hcsq (sq_nonneg _) (by positivity)
    nlinarith [hk, sq_nonneg (a + b)]
  have hfI : IntervalIntegrable (fun x => (-(ϰ * (wm x + wp x)) + (wp x ^ 2 - wm x ^ 2) / 2) ^ 2 +
      4 * ((wm x - wp x) / 2) ^ 2) MeasureTheory.volume 0 1 := by
    apply Continuous.intervalIntegrable
    fun_prop
  have hgI : IntervalIntegrable (fun x => (25 * ϰ ^ 2 / 8 + 2) * (wp x ^ 2 + wm x ^ 2))
      MeasureTheory.volume 0 1 := by
    apply Continuous.intervalIntegrable
    fun_prop
  have hWdef : WT ϰ ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ≤
      ‖((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ^ 2 := by
    set f : lp (fun _ : ℤ => ℂ) 2 := ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) with hfdef
    have hnorm : ‖f‖ ^ 2 = ∑' n, ‖f n‖ ^ 2 := by
      have h := lp.norm_rpow_eq_tsum (p := 2) (by norm_num) f
      simpa using h
    have hs : Summable (fun n => ‖f n‖ ^ 2) := by
      have h := (lp.memℓp f).summable (by norm_num : 0 < (2:ENNReal).toReal)
      simpa using h
    have hle : ∀ n : ℤ, ((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * ϰ ^ 2)) * ‖f n‖ ^ 2 ≤
        ‖f n‖ ^ 2 := by
      intro n
      have hden : 0 < (2 * π * n) ^ 2 + 4 * ϰ ^ 2 := by positivity
      have hw : (4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * ϰ ^ 2) ≤ 1 := by
        rw [div_le_one hden]
        nlinarith
      calc _ ≤ 1 * ‖f n‖ ^ 2 := mul_le_mul_of_nonneg_right hw (sq_nonneg _)
        _ = _ := one_mul _
    have hnn : ∀ n : ℤ, 0 ≤ ((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * ϰ ^ 2)) *
        ‖f n‖ ^ 2 := fun n => mul_nonneg (by positivity) (sq_nonneg _)
    rw [hnorm]
    unfold WT
    exact Summable.tsum_le_tsum hle (Summable.of_nonneg_of_le hnn hle hs) hs
  have hn : ‖((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ = ‖ιT q‖ := rfl
  have hsq : ‖ιT q‖ ^ 2 ≤ R ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hq 2
  rw [hn] at hWdef
  calc (∫ x in (0:ℝ)..1, ((-(ϰ * (wm x + wp x)) + (wp x ^ 2 - wm x ^ 2) / 2) ^ 2 +
        4 * ((wm x - wp x) / 2) ^ 2))
      ≤ ∫ x in (0:ℝ)..1, (25 * ϰ ^ 2 / 8 + 2) * (wp x ^ 2 + wm x ^ 2) :=
        intervalIntegral.integral_mono_on zero_le_one hfI hgI (fun x _ => hpt x)
    _ = (25 * ϰ ^ 2 / 8 + 2) * ((∫ x in (0:ℝ)..1, wp x ^ 2) + ∫ x in (0:ℝ)..1, wm x ^ 2) := by
        rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_add]
        · exact (hwpc.pow 2).intervalIntegrable _ _
        · exact (hwmc.pow 2).intervalIntegrable _ _
    _ ≤ (25 * ϰ ^ 2 / 8 + 2) * (4 * R ^ 2) := by
        apply mul_le_mul_of_nonneg_left _ hA
        linarith
    _ ≤ (1 + (4 * ϰ + 3) * R) ^ 2 := by
        nlinarith [mul_nonneg hR hϰpos.le, mul_nonneg (sq_nonneg R) (sq_nonneg ϰ),
          mul_nonneg (sq_nonneg R) hϰpos.le, sq_nonneg R]

theorem kv46_T : ∀ R ≥ (0 : ℝ), ∃ κ₀ ≥ (1 : ℝ), ∃ C ≥ (0 : ℝ), ∀ κ ≥ κ₀, ∀ q p : CinfT, ‖ιT q‖ ≤ R → (∀ x, (p : ℝ → ℝ) x = (q : ℝ → ℝ) x + 4 * κ ^ 3 * (greenT κ (q : ℝ → ℝ) x - 1 / (2 * κ))) → ‖ιT p‖ ≤ C * (WT κ ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) + Real.sqrt (WT κ ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2))) :=
by
  classical
  intro R hR
  obtain ⟨hlin, -⟩ := toHm1T_basic
  obtain ⟨κ₁, hκ₁, H⟩ := greenT_riccati_region_T R hR
  
  have hL1 : ∀ h : CinfT, ‖ιT h‖ ≤ ∫ x in (0:ℝ)..1, |(h : ℝ → ℝ) x| := by
    intro h
    have hc : Continuous (h : ℝ → ℝ) := h.2.1.continuous
    obtain ⟨⟨v, hvper, hv⟩, hall⟩ := periodic_resolvent_T 1 le_rfl (h : ℝ → ℝ) hc h.2.2
    obtain ⟨-, -, -, hv2⟩ := hall v hvper hv
    have hpar := periodic_resolvent_parseval_T 1 le_rfl h v hvper hv
    obtain ⟨-, -, hwc⟩ := weight_compare_T ((ιT h : Hm1T) : lp (fun _ : ℤ => ℂ) 2) 1 le_rfl
    rw [← hpar, one_pow, one_mul] at hwc
    rw [div_one] at hv2
    have hnn : 0 ≤ ∫ x in (0:ℝ)..1, |(h : ℝ → ℝ) x| :=
      intervalIntegral.integral_nonneg zero_le_one (fun _ _ => abs_nonneg _)
    have hsq : ‖ιT h‖ ^ 2 ≤ (∫ x in (0:ℝ)..1, |(h : ℝ → ℝ) x|) ^ 2 := by
      have e : ‖ιT h‖ = ‖((ιT h : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ := rfl
      rw [e]
      linarith
    exact (abs_le_of_sq_le_sq' hsq hnn).2
  
  have hder : ∀ s A : CinfT, (∀ x, HasDerivAt (s : ℝ → ℝ) ((A : ℝ → ℝ) x) x) →
      ‖ιT A‖ ≤ 2 * Real.sqrt (∫ x in (0:ℝ)..1, (s : ℝ → ℝ) x ^ 2) := by
    intro s A hsA
    have hsc : Continuous (s : ℝ → ℝ) := s.2.1.continuous
    obtain ⟨⟨u, huper, hu⟩, hall⟩ := periodic_resolvent_T 1 le_rfl (s : ℝ → ℝ) hsc s.2.2
    obtain ⟨-, -, hu2, -⟩ := hall u huper hu
    have huc : Continuous u := continuous_iff_continuousAt.2 fun x => (hu x).continuousAt
    have hvper : Function.Periodic (fun x => (s : ℝ → ℝ) x + 2 * u x) 1 := by
      intro x
      simp only [s.2.2 x, huper x]
    have hv : ∀ x, HasDerivAt (fun x => (s : ℝ → ℝ) x + 2 * u x)
        (2 * 1 * ((s : ℝ → ℝ) x + 2 * u x) + (A : ℝ → ℝ) x) x := by
      intro x
      refine ((hsA x).add ((hu x).const_mul 2)).congr_deriv ?_
