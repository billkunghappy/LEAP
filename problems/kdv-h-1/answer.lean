      (∀ τ : ℝ, |τ| ≤ T → |inner ℝ (R τ) (R' τ)| ≤ K * ‖R τ‖ ^ 2 + B * ‖R τ‖) →
      ∀ τ : ℝ, |τ| ≤ T →
