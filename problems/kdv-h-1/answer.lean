  have riccati_curve_slope_L2 (κ : ℝ) (hκ : 1 ≤ κ) (r : ℝ → 𝓢(ℝ, ℝ)) (v : 𝓢(ℝ, ℝ)) (s : ℝ)
      (hslope : Filter.Tendsto (fun σ : ℝ => ‖toHm1 ((σ - s)⁻¹ • (r σ - r s) - v)‖)
