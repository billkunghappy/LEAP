  have hE := boot φ (fun s => riccatiAlpha 1 (u s)) (1 / 100) hφc (by linarith)
    (fun t ht => hC 1 le_rfl t (by linarith))
    (fun t ht hα => by
      obtain ⟨-, -, hhi_t⟩ := hD 1 le_rfl t (by linarith)
      obtain ⟨-, hlo_0, -⟩ := hD 1 le_rfl 0 (by linarith)
      obtain ⟨-, hAW_t, -, -⟩ := hB 1 le_rfl t
