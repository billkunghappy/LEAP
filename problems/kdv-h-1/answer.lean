  have hm2 := mul_le_mul_of_nonneg_right hk1 hδ0
  have hXY : X + 4 * Y ≤ 64 * κ ^ 2 * δ2 := by nlinarith
  
  have hfinal : (∫ x in (0:ℝ)..1, (deriv (d : ℝ → ℝ) x) ^ 2 + 4 * ((d : ℝ → ℝ) x) ^ 2) =
      X + 4 * Y := by
    have e : (∫ x in (0:ℝ)..1, (deriv (d : ℝ → ℝ) x) ^ 2 + 4 * ((d : ℝ → ℝ) x) ^ 2) =
        ∫ x in (0:ℝ)..1, (D x ^ 2 + 4 * ((d : ℝ → ℝ) x) ^ 2) := by
      apply intervalIntegral.integral_congr
      intro x _
      simp only [hderiv x]
    rw [e, intervalIntegral.integral_add, intervalIntegral.integral_const_mul, hX, hYd]
    · exact (cD.pow 2).intervalIntegrable _ _
    · exact (continuous_const.mul (cd.pow 2)).intervalIntegrable _ _
  rw [hfinal]
  exact hXY

theorem exp_weight_average_tsum_T : ∀ K : ℝ, 0 < K → ∀ c : ℤ → ℝ, (∀ n, 0 ≤ c n) → Summable c → MeasureTheory.IntegrableOn (fun h : ℝ => 2 * K * Real.exp (-2 * K * h) * ∑' n : ℤ, ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n) (Set.Ioi 0) ∧ (∫ h in Set.Ioi (0:ℝ), 2 * K * Real.exp (-2 * K * h) * ∑' n : ℤ, ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n) = ∑' n : ℤ, 2 * (2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2) * c n :=
by
  intro K hK c hc0 hc
  have s1 : ∀ ξ h : ℝ, ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 =
      2 - 2 * Real.cos (ξ * h) := by
    intro ξ h
    have e : (ξ : ℂ) * (h : ℂ) = ((ξ * h : ℝ) : ℂ) := by push_cast; ring
    rw [e, Complex.sq_norm, Complex.normSq_apply]
    simp only [Complex.sub_re, Complex.sub_im, Complex.exp_ofReal_mul_I_re,
      Complex.exp_ofReal_mul_I_im, Complex.one_re, Complex.one_im]
    linear_combination Real.cos_sq_add_sin_sq (ξ * h)
  have hE : IntegrableOn (fun t : ℝ => Real.exp (-2 * K * t)) (Set.Ioi 0) := by
    have := exp_neg_integrableOn_Ioi 0 (b := 2 * K) (by positivity)
    refine this.congr_fun (fun x _ => ?_) measurableSet_Ioi
    show Real.exp (-(2 * K) * x) = Real.exp (-2 * K * x)
    congr 1; ring
  have s3 : ∀ c' : ℝ,
      IntegrableOn (fun t : ℝ => Real.exp (-2 * K * t) * Real.cos (c' * t)) (Set.Ioi 0) ∧
      ∫ t in Set.Ioi 0, Real.exp (-2 * K * t) * Real.cos (c' * t) =
        2 * K / (c' ^ 2 + 4 * K ^ 2) := by
    intro c'
    obtain ⟨a, ha_def⟩ : ∃ a : ℂ, a = ((-2 * K : ℝ) : ℂ) + (c' : ℂ) * I := ⟨_, rfl⟩
    have hare : a.re = -2 * K := by rw [ha_def]; simp
    have haim : a.im = c' := by rw [ha_def]; simp
    have ha : a.re < 0 := by rw [hare]; linarith
    have hpt : ∀ t : ℝ, (Complex.exp (a * t)).re =
        Real.exp (-2 * K * t) * Real.cos (c' * t) := by
      intro t
      have hre : (a * (t : ℂ)).re = -2 * K * t := by
        rw [Complex.mul_re, hare, haim]; simp
      have him : (a * (t : ℂ)).im = c' * t := by
        rw [Complex.mul_im, hare, haim]; simp
      rw [Complex.exp_re, hre, him]
    have hI := integrableOn_exp_mul_complex_Ioi ha 0
    have hfeq : (fun t : ℝ => RCLike.re (Complex.exp (a * t))) =
        fun t : ℝ => Real.exp (-2 * K * t) * Real.cos (c' * t) := by
      funext t; rw [RCLike.re_to_complex, hpt]
    refine ⟨?_, ?_⟩
    · have := hI.re
      rw [hfeq] at this
      exact this
    · have h1 := integral_re hI
      rw [hfeq, integral_exp_mul_complex_Ioi ha 0] at h1
      rw [h1, RCLike.re_to_complex]
      have hnorm : Complex.normSq a = c' ^ 2 + 4 * K ^ 2 := by
        rw [Complex.normSq_apply, hare, haim]; ring
      have hpos : 0 < c' ^ 2 + 4 * K ^ 2 := by positivity
      simp only [Complex.ofReal_zero, mul_zero, Complex.exp_zero]
      rw [Complex.div_re, hnorm, hare, haim]
      simp
  have hEint : ∫ t in Set.Ioi 0, Real.exp (-2 * K * t) = 1 / (2 * K) := by
    rw [integral_exp_mul_Ioi (by linarith) 0]
    simp only [mul_zero, Real.exp_zero]
    field_simp
  
  have mode : ∀ ξ : ℝ, IntegrableOn (fun h : ℝ => 2 * K * Real.exp (-2 * K * h) *
      ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1‖ ^ 2) (Set.Ioi 0) ∧
      (∫ h in Set.Ioi (0:ℝ), 2 * K * Real.exp (-2 * K * h) *
        ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1‖ ^ 2) = 2 * ξ ^ 2 / (ξ ^ 2 + 4 * K ^ 2) := by
    intro ξ
    have hfun : (fun h : ℝ => 2 * K * Real.exp (-2 * K * h) *
        ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1‖ ^ 2) =
        fun h : ℝ => (4 * K) * Real.exp (-2 * K * h) -
          (4 * K) * (Real.exp (-2 * K * h) * Real.cos (ξ * h)) := by
      funext h; rw [s1]; ring
    rw [hfun]
    refine ⟨(hE.const_mul _).sub ((s3 ξ).1.const_mul _), ?_⟩
    rw [integral_sub (hE.const_mul _) ((s3 ξ).1.const_mul _), integral_const_mul,
      integral_const_mul, hEint, (s3 ξ).2]
    have hpos : 0 < ξ ^ 2 + 4 * K ^ 2 := by positivity
    field_simp
    ring
  
  have hφb : ∀ (n : ℤ) (h : ℝ),
      ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 ≤ 4 := by
    intro n h
    have h1 : ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I)‖ = 1 := by
      have e : ((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I = (((2 * π * n) * h : ℝ) : ℂ) * I := by
        push_cast; ring
      rw [e, Complex.norm_exp_ofReal_mul_I]
    have h2 : ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ≤ 2 := by
      calc _ ≤ ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I)‖ + ‖(1 : ℂ)‖ :=
            norm_sub_le _ _
        _ = 2 := by rw [h1, norm_one]; norm_num
    have h3 := pow_le_pow_left₀ (norm_nonneg _) h2 2
    calc _ ≤ (2 : ℝ) ^ 2 := h3
      _ = 4 := by norm_num
  have hterm0 : ∀ (n : ℤ) (h : ℝ),
      0 ≤ ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n :=
    fun n h => mul_nonneg (by positivity) (hc0 n)
  have htermle : ∀ (n : ℤ) (h : ℝ),
      ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n ≤ 4 * c n :=
    fun n h => mul_le_mul_of_nonneg_right (hφb n h) (hc0 n)
  have hc4 : Summable (fun n : ℤ => 4 * c n) := hc.mul_left 4
  have hScont : Continuous (fun h : ℝ => ∑' n : ℤ,
      ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n) := by
    refine continuous_tsum (f := fun (n : ℤ) (h : ℝ) =>
      ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n)
      (fun n => by fun_prop) hc4 (fun n h => ?_)
    rw [Real.norm_of_nonneg (hterm0 n h)]
    exact htermle n h
  have hSb : ∀ h : ℝ, 0 ≤ (∑' n : ℤ,
      ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n) ∧
      (∑' n : ℤ, ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n) ≤
        4 * ∑' n : ℤ, c n := by
    intro h
    refine ⟨tsum_nonneg (fun n => hterm0 n h), ?_⟩
    have hs : Summable (fun n : ℤ =>
        ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n) :=
      Summable.of_nonneg_of_le (fun n => hterm0 n h) (fun n => htermle n h) hc4
    rw [← tsum_mul_left]
    exact Summable.tsum_le_tsum (fun n => htermle n h) hs hc4
  
  have hInt : MeasureTheory.IntegrableOn (fun h : ℝ => 2 * K * Real.exp (-2 * K * h) *
      ∑' n : ℤ, ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n)
      (Set.Ioi 0) := by
    refine (hE.const_mul (2 * K * (4 * ∑' n : ℤ, c n))).mono' ?_ ?_
    · have hw : Continuous (fun h : ℝ => 2 * K * Real.exp (-2 * K * h)) := by fun_prop
      exact (hw.mul hScont).aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun h => ?_)
      have hw : 0 ≤ 2 * K * Real.exp (-2 * K * h) := by positivity
      rw [Real.norm_of_nonneg (mul_nonneg hw (hSb h).1)]
      have := mul_le_mul_of_nonneg_left (hSb h).2 hw
      calc _ ≤ 2 * K * Real.exp (-2 * K * h) * (4 * ∑' n : ℤ, c n) := this
        _ = _ := by ring
  refine ⟨hInt, ?_⟩
  
  have hGint : ∀ n : ℤ, Integrable (fun h : ℝ => 2 * K * Real.exp (-2 * K * h) *
      ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n)
      (volume.restrict (Set.Ioi (0:ℝ))) :=
    fun n => (mode (2 * π * n)).1.mul_const (c n)
  have hGval : ∀ n : ℤ, (∫ h in Set.Ioi (0:ℝ), 2 * K * Real.exp (-2 * K * h) *
      ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n) =
      2 * (2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2) * c n := by
    intro n
    rw [integral_mul_const, (mode (2 * π * n)).2]
  have hGnorm : ∀ n : ℤ, (∫ h in Set.Ioi (0:ℝ), ‖2 * K * Real.exp (-2 * K * h) *
      ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n‖) =
      2 * (2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2) * c n := by
    intro n
    rw [← hGval n]
    congr 1
    funext h
    exact Real.norm_of_nonneg (mul_nonneg (by positivity) (hc0 n))
  have hGsum : Summable (fun n : ℤ => ∫ h in Set.Ioi (0:ℝ), ‖2 * K * Real.exp (-2 * K * h) *
      ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n‖) := by
    rw [funext hGnorm]
    refine Summable.of_nonneg_of_le (fun n => mul_nonneg (by positivity) (hc0 n))
      (fun n => ?_) (hc.mul_left 2)
    apply mul_le_mul_of_nonneg_right _ (hc0 n)
    have hpos : 0 < (2 * π * (n : ℝ)) ^ 2 + 4 * K ^ 2 := by positivity
    rw [div_le_iff₀ hpos]
    nlinarith [sq_nonneg K]
  have hswap := MeasureTheory.integral_tsum_of_summable_integral_norm hGint hGsum
  have hpt : ∀ h : ℝ, (∑' n : ℤ, 2 * K * Real.exp (-2 * K * h) *
      ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n) =
      2 * K * Real.exp (-2 * K * h) *
        ∑' n : ℤ, ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n := by
    intro h
    rw [← tsum_mul_left]
    congr 1
    funext n
    ring
  calc (∫ h in Set.Ioi (0:ℝ), 2 * K * Real.exp (-2 * K * h) *
        ∑' n : ℤ, ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n)
      = ∫ h in Set.Ioi (0:ℝ), ∑' n : ℤ, 2 * K * Real.exp (-2 * K * h) *
          ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n := by
        congr 1
        funext h
        exact (hpt h).symm
    _ = ∑' n : ℤ, ∫ h in Set.Ioi (0:ℝ), 2 * K * Real.exp (-2 * K * h) *
          ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * c n := hswap.symm
    _ = _ := tsum_congr hGval

theorem good_unknown_tightness_T : ∀ R ≥ (0 : ℝ), ∃ ϰ₀ ≥ (1 : ℝ), ∀ ϰ ≥ ϰ₀, ∃ C ≥ (0 : ℝ), ∀ K ≥ (1 : ℝ), ∀ q u : CinfT, ‖ιT q‖ ≤ R → (∀ x, (u : ℝ → ℝ) x = 1 / (2 * greenT ϰ (q : ℝ → ℝ) x) - ϰ) → (∑' n : ℤ, ((2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * (4 + (2 * π * n) ^ 2) ^ 2 * ‖((ιT u : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2) ≤ C * WT K ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) :=
by
  classical
  intro R hR
  refine ⟨max 1 (1024 * R ^ 2), le_max_left _ _, ?_⟩
  intro ϰ hϰ
  have hϰ1 : 1 ≤ ϰ := le_trans (le_max_left _ _) hϰ
  have hϰR : 1024 * R ^ 2 ≤ ϰ := le_trans (le_max_right _ _) hϰ
  have hϰpos : 0 < ϰ := by linarith
  refine ⟨64 * ϰ ^ 2, by positivity, ?_⟩
  intro K hK q u hq hu
  have hKpos : 0 < K := by linarith
  obtain ⟨hlin, -⟩ := toHm1T_basic
  
  have hWq : WT ϰ ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ≤ ϰ / 1024 := by
    have h1 : WT ϰ ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ≤
        ‖((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ^ 2 := (weight_compare_T _ ϰ hϰ1).2.1
    have h2 : ‖((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ≤ R := by
      rw [← Submodule.coe_norm]; exact hq
    have h3 : ‖((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ^ 2 ≤ R ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) h2 2
    linarith
  obtain ⟨wp, wm, hpp, hpm, hdp, hdm, hip, him, hb⟩ := riccati_pair_T ϰ hϰ1 q hWq
  have hpos : ∀ x, 0 < 2 * ϰ + wm x - wp x := by
    intro x
    have := (abs_le.1 (hb x)).1
    linarith
  have hg := (greenT_eq_of_riccati_pair_T ϰ q wp wm hpp hpm hdp hdm hpos).2
  have hux : ∀ x, (u : ℝ → ℝ) x = (wm x - wp x) / 2 := by
    intro x
    rw [hu x, hg x]
    have hne : 2 * ϰ + wm x - wp x ≠ 0 := (hpos x).ne'
    field_simp
    ring
  
  have htr : ∀ (f : CinfT) (h : ℝ), ∃ g : CinfT, ∀ x, (g : ℝ → ℝ) x = (f : ℝ → ℝ) (x + h) := by
    intro f h
    refine ⟨⟨fun x => (f : ℝ → ℝ) (x + h), ?_, ?_⟩, fun x => rfl⟩
    · exact f.2.1.comp (contDiff_id.add contDiff_const)
    · exact f.2.2.add_const h
  have hcomb : ∀ (a b : CinfT) (c₁ c₂ : ℝ), ∃ r : CinfT,
      ∀ x, (r : ℝ → ℝ) x = c₁ * (a : ℝ → ℝ) x + c₂ * (b : ℝ → ℝ) x := by
    intro a b c₁ c₂
    refine ⟨⟨fun x => c₁ * (a : ℝ → ℝ) x + c₂ * (b : ℝ → ℝ) x, ?_, ?_⟩, fun x => rfl⟩
    · exact (contDiff_const.mul a.2.1).add (contDiff_const.mul b.2.1)
    · intro x
      simp only [a.2.2 x, b.2.2 x]
  have hshift : ∀ (f : ℝ → ℝ), Function.Periodic f 1 → ∀ h : ℝ,
      (∫ x in (0:ℝ)..1, f (x + h) ^ 2) = ∫ x in (0:ℝ)..1, f x ^ 2 := by
    intro f hf h
    have hf2 : Function.Periodic (fun x => f x ^ 2) 1 := fun x => by simp only [hf x]
    have e1 := intervalIntegral.integral_comp_add_right (fun x => f x ^ 2) (a := 0) (b := 1) h
    have e2 := hf2.intervalIntegral_add_eq h 0
    simp only [zero_add] at e1 e2
    rw [e1, add_comm 1 h, e2]
  
  obtain ⟨a, ha⟩ : ∃ a : ℤ → ℝ, a = fun n : ℤ =>
      (4 + (2 * π * n) ^ 2) ^ 2 * ‖((ιT u : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2 := ⟨_, rfl⟩
  obtain ⟨b, hbd⟩ : ∃ b : ℤ → ℝ, b = fun n : ℤ =>
      ‖((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2 := ⟨_, rfl⟩
  
  have hA : ∀ h : ℝ, (∑' n : ℤ, ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * a n) ≤
      64 * ϰ ^ 2 * ∑' n : ℤ, ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * b n := by
    intro h
    obtain ⟨qh, hqh⟩ := htr q h
    obtain ⟨uh, huh⟩ := htr u h
    obtain ⟨dh, hdh⟩ := hcomb uh u 1 (-1)
    have hc1q := toHm1T_translate_T q qh h hqh
    have hc1u := (toHm1T_translate_T u uh h huh).1
    have hdhx : ∀ x, (dh : ℝ → ℝ) x = ((wm (x + h) - wp (x + h)) - (wm x - wp x)) / 2 := by
      intro x
      rw [hdh x, huh x, hux (x + h), hux x]
      ring
    have hiph : (∫ x in (0:ℝ)..1, wp (x + h) ^ 2) ≤ ϰ / 64 := by
      rw [hshift wp hpp h]; exact hip
    have himh : (∫ x in (0:ℝ)..1, wm (x + h) ^ 2) ≤ ϰ / 64 := by
      rw [hshift wm hpm h]; exact him
    have hdph : ∀ x, HasDerivAt (fun x => wp (x + h))
        ((qh : ℝ → ℝ) x + 2 * ϰ * wp (x + h) - wp (x + h) ^ 2) x := by
      intro x
      have := (hdp (x + h)).comp_add_const x h
      rw [← hqh x] at this
      exact this
    have hdmh : ∀ x, HasDerivAt (fun x => wm (x + h))
        ((qh : ℝ → ℝ) x - 2 * ϰ * wm (x + h) - wm (x + h) ^ 2) x := by
      intro x
      have := (hdm (x + h)).comp_add_const x h
      rw [← hqh x] at this
      exact this
    have hN := riccati_pair_h1_lipschitz_T ϰ hϰ1 qh q (fun x => wp (x + h))
      (fun x => wm (x + h)) wp wm (hpp.add_const h) (hpm.add_const h) hpp hpm
      hdph hdmh hdp hdm hiph himh hip him (fun x => hb (x + h)) dh hdhx
    have hP := (hm1T_h1_parseval_T.1 dh).2
    have hdcoef : ∀ n : ℤ, toHm1T dh n =
        (Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1) * toHm1T u n := by
      intro n
      have hl := hlin uh u dh 1 (-1) hdh
      rw [hl]
      simp only [lp.coeFn_add, lp.coeFn_smul, Pi.add_apply, Pi.smul_apply, hc1u n,
        Complex.real_smul]
      push_cast
      ring
    have hLHS : (∑' n : ℤ, (4 + (2 * π * n) ^ 2) ^ 2 *
        ‖((ιT dh : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2) =
        ∑' n : ℤ, ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * a n := by
      apply tsum_congr
      intro n
      simp only [ha]
      show (4 + (2 * π * n) ^ 2) ^ 2 * ‖toHm1T dh n‖ ^ 2 =
        ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 *
          ((4 + (2 * π * n) ^ 2) ^ 2 * ‖toHm1T u n‖ ^ 2)
      rw [hdcoef n, norm_mul, mul_pow]
      ring
    have hRHS : ‖ιT qh - ιT q‖ ^ 2 =
        ∑' n : ℤ, ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * b n := by
      rw [hc1q.2]
      unfold translateDiffSqT
      apply tsum_congr
      intro n
      simp only [hbd]
      show ‖(Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1) * toHm1T q n‖ ^ 2 =
        ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 * ‖toHm1T q n‖ ^ 2
      rw [norm_mul, mul_pow]
    rw [← hLHS, hP, ← hRHS]
    exact hN
  
  have ha0 : ∀ n, 0 ≤ a n := fun n => by simp only [ha]; positivity
  have hb0 : ∀ n, 0 ≤ b n := fun n => by simp only [hbd]; positivity
  have hasum : Summable a := by
    rw [ha]; exact (hm1T_h1_parseval_T.1 u).1
  have hbsum : Summable b := by
    refine Summable.of_nonneg_of_le hb0 (fun n => ?_) (hm1T_h1_parseval_T.1 q).1
    simp only [hbd]
    have h16 : 1 ≤ (4 + (2 * π * (n : ℝ)) ^ 2) ^ 2 := by
      have := sq_nonneg (2 * π * (n : ℝ))
      nlinarith
    exact le_mul_of_one_le_left (sq_nonneg _) h16
  obtain ⟨hIa, hEa⟩ := exp_weight_average_tsum_T K hKpos a ha0 hasum
  obtain ⟨hIb, hEb⟩ := exp_weight_average_tsum_T K hKpos b hb0 hbsum
  have hmono := MeasureTheory.setIntegral_mono hIa
    (MeasureTheory.Integrable.const_mul hIb (64 * ϰ ^ 2)) (fun h => by
      dsimp only
      have hw : 0 ≤ 2 * K * Real.exp (-2 * K * h) := by positivity
      have := mul_le_mul_of_nonneg_left (hA h) hw
      linarith)
  rw [MeasureTheory.integral_const_mul, hEa, hEb] at hmono
  
  have hden : ∀ n : ℤ, 0 < (2 * π * (n : ℝ)) ^ 2 + 4 * K ^ 2 := fun n => by positivity
  have hSa : (∑' n : ℤ, 2 * (2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2) * a n) =
      2 * ∑' n : ℤ, ((2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * (4 + (2 * π * n) ^ 2) ^ 2 *
        ‖((ιT u : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2 := by
    rw [← tsum_mul_left]
    apply tsum_congr
    intro n
    simp only [ha]
    ring
  have hSb : (∑' n : ℤ, 2 * (2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2) * b n) =
      2 * ∑' n : ℤ, ((2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * b n := by
    rw [← tsum_mul_left]
    apply tsum_congr
    intro n
    ring
  have hcmp : (∑' n : ℤ, ((2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * b n) ≤
      WT K ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) := by
    have hle0 : ∀ n : ℤ, (2 * π * (n : ℝ)) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2) ≤ 1 := fun n => by
      rw [div_le_one (hden n)]; nlinarith
    have hle1 : ∀ n : ℤ, (4 + (2 * π * (n : ℝ)) ^ 2) / ((2 * π * n) ^ 2 + 4 * K ^ 2) ≤ 1 :=
      fun n => by rw [div_le_one (hden n)]; nlinarith
    have hs0 : Summable (fun n : ℤ => ((2 * π * n) ^ 2 / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * b n) :=
      Summable.of_nonneg_of_le (fun n => mul_nonneg (div_nonneg (sq_nonneg _) (hden n).le) (hb0 n))
        (fun n => mul_le_of_le_one_left (hb0 n) (hle0 n)) hbsum
    have hs1 : Summable (fun n : ℤ =>
        ((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * b n) :=
      Summable.of_nonneg_of_le (fun n => mul_nonneg (div_nonneg (by positivity) (hden n).le) (hb0 n))
        (fun n => mul_le_of_le_one_left (hb0 n) (hle1 n)) hbsum
    have hWK : WT K ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) =
        ∑' n : ℤ, ((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * b n := by
      unfold WT
      rw [hbd]
    rw [hWK]
    refine Summable.tsum_le_tsum (fun n => ?_) hs0 hs1
    apply mul_le_mul_of_nonneg_right _ (hb0 n)
    apply div_le_div_of_nonneg_right _ (hden n).le
    linarith
  have h64 : (0 : ℝ) ≤ 64 * ϰ ^ 2 := by positivity
  have k2 := mul_le_mul_of_nonneg_left hcmp h64
  rw [hSa, hSb] at hmono
  nlinarith [hmono, k2]

theorem hm1T_L2_L1_bounds_T : ∀ f : CinfT, 4 * ‖ιT f‖ ^ 2 ≤ (∫ x in (0:ℝ)..1, (f : ℝ → ℝ) x ^ 2) ∧ ‖ιT f‖ ≤ ∫ x in (0:ℝ)..1, |(f : ℝ → ℝ) x| :=
by
  intro f
  have hFc : Continuous (f : ℝ → ℝ) := f.2.1.continuous
  have hFp : Function.Periodic (f : ℝ → ℝ) 1 := f.2.2
  obtain ⟨⟨v, hvper, hvder⟩, hall⟩ := periodic_resolvent_T 1 le_rfl (f : ℝ → ℝ) hFc hFp
  obtain ⟨-, -, hA, hB⟩ := hall v hvper hvder
  have hP := periodic_resolvent_parseval_T 1 le_rfl f v hvper hvder
  have hW := (weight_compare_T ((ιT f : Hm1T) : lp (fun _ : ℤ => ℂ) 2) 1 le_rfl).2.2
  rw [← hP, one_pow, one_mul] at hW
  have hK : ‖ιT f‖ ^ 2 ≤ ∫ x in (0:ℝ)..1, v x ^ 2 := hW
  norm_num at hA
  rw [div_one] at hB
  have hI0 : 0 ≤ ∫ x in (0:ℝ)..1, |(f : ℝ → ℝ) x| :=
    intervalIntegral.integral_nonneg zero_le_one (fun x _ => abs_nonneg _)
  refine ⟨by linarith, ?_⟩
  exact (sq_le_sq₀ (norm_nonneg _) hI0).1 (le_trans hK hB)

theorem hm1T_deriv_L2_bound_T : ∀ ψ D : CinfT, (∀ x, (D : ℝ → ℝ) x = deriv (ψ : ℝ → ℝ) x) → ‖ιT D‖ ^ 2 ≤ ∫ x in (0:ℝ)..1, (ψ : ℝ → ℝ) x ^ 2 :=
by
  intro ψ D hD
  have hψc : Continuous (ψ : ℝ → ℝ) := ψ.2.1.continuous
  have hψd : Differentiable ℝ (ψ : ℝ → ℝ) := ψ.2.1.differentiable (by simp)
  obtain ⟨z, hzp, hz⟩ := (periodic_resolvent_T 1 le_rfl (fun x => 2 * (ψ : ℝ → ℝ) x)
    (continuous_const.mul hψc) (fun x => by simp only [ψ.2.2 x])).1
  have hz2 : ∀ x, HasDerivAt z (2 * z x + 2 * (ψ : ℝ → ℝ) x) x := by
    intro x
    have h := hz x
    simp only [mul_one] at h
    exact h
  obtain ⟨v, hv⟩ : ∃ v : ℝ → ℝ, v = fun x => z x + (ψ : ℝ → ℝ) x := ⟨_, rfl⟩
  have hvx : ∀ x, v x = z x + (ψ : ℝ → ℝ) x := fun x => by rw [hv]
  have hvp : Function.Periodic v 1 := fun x => by rw [hvx, hvx, hzp x, ψ.2.2 x]
  have hvd : ∀ x, HasDerivAt v (2 * 1 * v x + (D : ℝ → ℝ) x) x := by
    intro x
    have h := (hz2 x).add (hψd x).hasDerivAt
    have hfun : v = z + (ψ : ℝ → ℝ) := by rw [hv]; rfl
    have key : 2 * 1 * v x + (D : ℝ → ℝ) x =
        2 * z x + 2 * (ψ : ℝ → ℝ) x + deriv (ψ : ℝ → ℝ) x := by
      rw [hvx x, hD x]
      ring
    rw [key, hfun]
    exact h
  have hP := periodic_resolvent_parseval_T 1 le_rfl D v hvp hvd
  have hW := (weight_compare_T ((ιT D : Hm1T) : lp (fun _ : ℤ => ℂ) 2) 1 le_rfl).2.2
  have hN : ‖ιT D‖ ^ 2 ≤ ∫ x in (0:ℝ)..1, v x ^ 2 := by
    rw [hP]
    have e : ‖ιT D‖ = ‖((ιT D : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ := rfl
    rw [e]
    refine le_trans hW (le_of_eq ?_)
    rw [one_pow, one_mul]
  
  have hzc : Continuous z := continuous_iff_continuousAt.2 fun x => (hz2 x).continuousAt
  have hsq : ∀ x, HasDerivAt (fun y => z y ^ 2)
      (2 * z x * (2 * z x + 2 * (ψ : ℝ → ℝ) x)) x := by
    intro x
    convert (hz2 x).pow 2 using 1
    rw [show (2 : ℕ) - 1 = 1 from rfl, pow_one]
    push_cast
    ring
  have hhc : Continuous (fun x => 2 * z x * (2 * z x + 2 * (ψ : ℝ → ℝ) x)) :=
    (continuous_const.mul hzc).mul ((continuous_const.mul hzc).add (continuous_const.mul hψc))
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hsq x)
    (hhc.intervalIntegrable 0 1)
  have hz10 : z 1 = z 0 := by
    have h := hzp 0
    rw [zero_add] at h
    exact h
  simp only [hz10, sub_self] at hFTC
  have hvc : Continuous v := by rw [hv]; exact hzc.add hψc
  have hmono : (∫ x in (0:ℝ)..1, v x ^ 2) ≤ ∫ x in (0:ℝ)..1, ((ψ : ℝ → ℝ) x ^ 2 +
      (1 / 2) * (2 * z x * (2 * z x + 2 * (ψ : ℝ → ℝ) x))) := by
    apply intervalIntegral.integral_mono_on zero_le_one
    · exact (hvc.pow 2).intervalIntegrable 0 1
    · exact ((hψc.pow 2).add (continuous_const.mul hhc)).intervalIntegrable 0 1
    · intro x _
      rw [hvx x]
      nlinarith [sq_nonneg (z x)]
  rw [intervalIntegral.integral_add ((hψc.pow 2).intervalIntegrable 0 1)
    ((continuous_const.mul hhc).intervalIntegrable 0 1), intervalIntegral.integral_const_mul,
    hFTC, mul_zero, add_zero] at hmono
  exact le_trans hN hmono

theorem periodic_sup_sq_le_N1_T : ∀ f : ℝ → ℝ, ContDiff ℝ 1 f → Function.Periodic f 1 → ∀ x : ℝ, f x ^ 2 ≤ ∫ y in (0:ℝ)..1, (deriv f y) ^ 2 + 4 * (f y) ^ 2 :=
by
  intro f hf hper x
  have hdiff : Differentiable ℝ f := hf.differentiable one_ne_zero
  have hcd : Continuous (deriv f) := hf.continuous_deriv le_rfl
  have hc : Continuous f := hf.continuous
  have hg : ∀ t, HasDerivAt (fun s => f s ^ 2) (2 * f t * deriv f t) t := by
    intro t
    have h2 := (hdiff t).hasDerivAt.pow 2
    convert h2 using 1
    simp only [Nat.cast_ofNat, pow_one]
    norm_num
  obtain ⟨y, hy, hxy⟩ := hper.exists_mem_Ico₀ one_pos x
  rw [hxy]
  obtain ⟨a, ha, hamin⟩ := isCompact_Icc.exists_isMinOn
    (Set.nonempty_Icc.2 (zero_le_one : (0:ℝ) ≤ 1)) ((hc.pow 2).continuousOn)
  have hhc : Continuous (fun t => deriv f t ^ 2 + f t ^ 2) := (hcd.pow 2).add (hc.pow 2)
  have hgc : Continuous (fun t => 2 * f t * deriv f t) := (continuous_const.mul hc).mul hcd
  have hFTC : ∫ t in a..y, 2 * f t * deriv f t = f y ^ 2 - f a ^ 2 :=
    intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hg t)
      (hgc.intervalIntegrable _ _)
  have hpt : ∀ t, |2 * f t * deriv f t| ≤ deriv f t ^ 2 + f t ^ 2 := by
    intro t
    rw [abs_le]
    constructor
    · nlinarith [sq_nonneg (f t - deriv f t), sq_nonneg (f t + deriv f t)]
    · nlinarith [sq_nonneg (f t - deriv f t), sq_nonneg (f t + deriv f t)]
  have hnn : ∀ t, 0 ≤ deriv f t ^ 2 + f t ^ 2 := fun t => by positivity
  have hbound : f y ^ 2 - f a ^ 2 ≤ ∫ t in (0:ℝ)..1, deriv f t ^ 2 + f t ^ 2 := by
    rw [← hFTC]
    rcases le_total a y with hay | hya
    · calc ∫ t in a..y, 2 * f t * deriv f t ≤ ∫ t in a..y, deriv f t ^ 2 + f t ^ 2 :=
            intervalIntegral.integral_mono_on hay (hgc.intervalIntegrable _ _)
              (hhc.intervalIntegrable _ _) (fun t _ => (le_abs_self _).trans (hpt t))
        _ ≤ ∫ t in (0:ℝ)..1, deriv f t ^ 2 + f t ^ 2 :=
            intervalIntegral.integral_mono_interval ha.1 hay hy.2.le
              (Filter.Eventually.of_forall hnn) (hhc.intervalIntegrable _ _)
    · rw [intervalIntegral.integral_symm]
      calc -∫ t in y..a, 2 * f t * deriv f t = ∫ t in y..a, -(2 * f t * deriv f t) :=
            (intervalIntegral.integral_neg).symm
        _ ≤ ∫ t in y..a, deriv f t ^ 2 + f t ^ 2 :=
            intervalIntegral.integral_mono_on hya (hgc.neg.intervalIntegrable _ _)
              (hhc.intervalIntegrable _ _) (fun t _ => (neg_le_abs _).trans (hpt t))
        _ ≤ ∫ t in (0:ℝ)..1, deriv f t ^ 2 + f t ^ 2 :=
            intervalIntegral.integral_mono_interval hy.1 hya ha.2
              (Filter.Eventually.of_forall hnn) (hhc.intervalIntegrable _ _)
  have hmin : f a ^ 2 ≤ ∫ t in (0:ℝ)..1, f t ^ 2 := by
    have h1 : ∫ _ in (0:ℝ)..1, f a ^ 2 ≤ ∫ t in (0:ℝ)..1, f t ^ 2 :=
      intervalIntegral.integral_mono_on zero_le_one intervalIntegrable_const
        ((hc.pow 2).intervalIntegrable _ _) (fun t ht => hamin ht)
    simpa using h1
  have e1 : (∫ t in (0:ℝ)..1, deriv f t ^ 2 + f t ^ 2) =
      (∫ t in (0:ℝ)..1, deriv f t ^ 2) + ∫ t in (0:ℝ)..1, f t ^ 2 :=
    intervalIntegral.integral_add ((hcd.pow 2).intervalIntegrable _ _)
      ((hc.pow 2).intervalIntegrable _ _)
  have e2 : (∫ t in (0:ℝ)..1, deriv f t ^ 2 + 4 * f t ^ 2) =
      (∫ t in (0:ℝ)..1, deriv f t ^ 2) + 4 * ∫ t in (0:ℝ)..1, f t ^ 2 := by
    rw [intervalIntegral.integral_add ((hcd.pow 2).intervalIntegrable _ _)
      ((continuous_const.mul (hc.pow 2)).intervalIntegrable _ _),
      intervalIntegral.integral_const_mul]
  have hI : 0 ≤ ∫ t in (0:ℝ)..1, f t ^ 2 :=
    intervalIntegral.integral_nonneg zero_le_one (fun t _ => sq_nonneg _)
  rw [e2]
  linarith

theorem miura_inverse_T : ∀ (ϰ : ℝ) (q g a : ℝ → ℝ), IsGreenT ϰ q g → ContDiff ℝ 2 a → (∀ x, g x = 1 / (2 * a x)) → ∀ x, q x = a x ^ 2 - ϰ ^ 2 - deriv (fun y => deriv a y / (2 * a y)) x + (deriv a x / (2 * a x)) ^ 2 :=
by
  intro ϰ q g a hG ha hga x
  obtain ⟨-, -, hpos, hid⟩ := hG
  have hne : ∀ y, a y ≠ 0 := by
    intro y hy
    have h := hpos y
    rw [hga y, hy] at h
    simp at h
  have ha1 : Differentiable ℝ a := ha.differentiable (by norm_num)
  have hda : ContDiff ℝ 1 (deriv a) := ha.deriv'
  have ha2 : Differentiable ℝ (deriv a) := hda.differentiable (by norm_num)
  have hg : g = fun y => 1 / (2 * a y) := funext hga
  have hD1 : ∀ y, HasDerivAt g (-deriv a y / (2 * a y ^ 2)) y := by
    intro y
    have h := (hasDerivAt_const y (1:ℝ)).div ((ha1 y).hasDerivAt.const_mul 2)
      (mul_ne_zero two_ne_zero (hne y))
    rw [hg]
    convert h using 1
    have := hne y
    field_simp
    ring
  have hdg : deriv g = fun y => -deriv a y / (2 * a y ^ 2) := funext fun y => (hD1 y).deriv
  have hD2 : HasDerivAt (fun y => -deriv a y / (2 * a y ^ 2))
      (-deriv (deriv a) x / (2 * a x ^ 2) + deriv a x ^ 2 / a x ^ 3) x := by
    have hn := ((ha2 x).hasDerivAt).neg
    have hd := (((ha1 x).hasDerivAt).pow 2).const_mul (2:ℝ)
    have hax := hne x
    have h := hn.div hd (mul_ne_zero two_ne_zero (pow_ne_zero 2 hax))
    convert h using 1
    simp only [Pi.pow_apply, Pi.neg_apply]
    field_simp
    ring
  have hi2 : iteratedDeriv 2 g x = deriv (deriv g) x := by
    rw [iteratedDeriv_succ, iteratedDeriv_one]
  have e1 : deriv g x = -deriv a x / (2 * a x ^ 2) := (hD1 x).deriv
  have e2 : iteratedDeriv 2 g x = -deriv (deriv a) x / (2 * a x ^ 2) + deriv a x ^ 2 / a x ^ 3 := by
    rw [hi2, hdg]
    exact hD2.deriv
  have eS : deriv (fun y => deriv a y / (2 * a y)) x =
      deriv (deriv a) x / (2 * a x) - deriv a x ^ 2 / (2 * a x ^ 2) := by
    have hax := hne x
    have h := ((ha2 x).hasDerivAt).div ((ha1 x).hasDerivAt.const_mul (2:ℝ))
      (mul_ne_zero two_ne_zero hax)
    rw [show (fun y => deriv a y / (2 * a y)) = (deriv a / fun y => 2 * a y) from rfl, h.deriv]
    field_simp
  have h0 := hid x
  rw [e1, e2, hga x] at h0
  rw [eS]
  have hax := hne x
  linear_combination (norm := (field_simp; ring)) (a x) ^ 2 * h0

theorem inverse_lipschitz_calc_T : ∀ (ϰ L : ℝ), 1 ≤ ϰ → 0 ≤ L → ∀ a b d : ℝ → ℝ, ContDiff ℝ 1 a → ContDiff ℝ 1 b → (∀ x, 3 * ϰ / 4 ≤ a x ∧ a x ≤ 5 * ϰ / 4) → (∀ x, 3 * ϰ / 4 ≤ b x ∧ b x ≤ 5 * ϰ / 4) → (∫ x in (0:ℝ)..1, (deriv a x) ^ 2) ≤ L ^ 2 → (∫ x in (0:ℝ)..1, (deriv b x) ^ 2) ≤ L ^ 2 → (∀ x, d x = a x - b x) → (∀ x, d x ^ 2 ≤ ∫ y in (0:ℝ)..1, (deriv d y) ^ 2 + 4 * (d y) ^ 2) → (∫ x in (0:ℝ)..1, (deriv a x / (2 * a x) - deriv b x / (2 * b x)) ^ 2) ≤ (8 / (9 * ϰ ^ 2) + 128 * L ^ 2 / (81 * ϰ ^ 4)) * (∫ x in (0:ℝ)..1, (deriv d x) ^ 2 + 4 * (d x) ^ 2) ∧ (∫ x in (0:ℝ)..1, (deriv a x / (2 * a x) + deriv b x / (2 * b x)) ^ 2) ≤ 16 * L ^ 2 / (9 * ϰ ^ 2) ∧ (∫ x in (0:ℝ)..1, (d x * (a x + b x)) ^ 2) ≤ 25 * ϰ ^ 2 / 16 * (∫ x in (0:ℝ)..1, (deriv d x) ^ 2 + 4 * (d x) ^ 2) :=
by
  intro ϰ L hϰ hL a b d ha hb hA hB hLa hLb hd hN
  have hϰ0 : 0 < ϰ := by linarith
  have hapos : ∀ x, 0 < a x := fun x => by linarith [(hA x).1]
  have hbpos : ∀ x, 0 < b x := fun x => by linarith [(hB x).1]
  have ha2 : ∀ x, 2 * a x ≠ 0 := fun x => (mul_pos two_pos (hapos x)).ne'
  have hb2 : ∀ x, 2 * b x ≠ 0 := fun x => (mul_pos two_pos (hbpos x)).ne'
  have hdf : d = fun x => a x - b x := funext hd
  have hadiff : Differentiable ℝ a := ha.differentiable (by norm_num)
  have hbdiff : Differentiable ℝ b := hb.differentiable (by norm_num)
  have hac : Continuous a := ha.continuous
  have hbc : Continuous b := hb.continuous
  have hda : Continuous (deriv a) := ha.continuous_deriv le_rfl
  have hdb : Continuous (deriv b) := hb.continuous_deriv le_rfl
  have hdd : ∀ x, deriv d x = deriv a x - deriv b x := by
    intro x; rw [hdf]; exact deriv_sub (hadiff x) (hbdiff x)
  have hdc : Continuous d := by rw [hdf]; exact hac.sub hbc
  have hddc : Continuous (deriv d) := by
    have e : deriv d = fun x => deriv a x - deriv b x := funext hdd
    rw [e]; exact hda.sub hdb
  obtain ⟨N, hNdef⟩ : ∃ N : ℝ, N = ∫ y in (0:ℝ)..1, (deriv d y) ^ 2 + 4 * (d y) ^ 2 := ⟨_, rfl⟩
  rw [← hNdef] at hN ⊢
  have hN0 : 0 ≤ N := le_trans (sq_nonneg _) (hN 0)
  have hgc : Continuous (fun y => (deriv d y) ^ 2 + 4 * (d y) ^ 2) :=
    (hddc.pow 2).add (continuous_const.mul (hdc.pow 2))
  have hSa : Continuous (fun x => deriv a x / (2 * a x)) :=
    hda.div (continuous_const.mul hac) ha2
  have hSb : Continuous (fun x => deriv b x / (2 * b x)) :=
    hdb.div (continuous_const.mul hbc) hb2
  obtain ⟨K1, hK1⟩ : ∃ K1 : ℝ, K1 = 4 / (9 * ϰ ^ 2) := ⟨_, rfl⟩
  obtain ⟨K2, hK2⟩ : ∃ K2 : ℝ, K2 = 64 / (81 * ϰ ^ 4) := ⟨_, rfl⟩
  have hK1p : 0 ≤ K1 := by rw [hK1]; positivity
  have hK2p : 0 ≤ K2 := by rw [hK2]; positivity
  
  have hua : ∀ x (t : ℝ), (t / (2 * a x)) ^ 2 ≤ K1 * t ^ 2 := by
    intro x t
    have h1 : 9 * ϰ ^ 2 ≤ 16 * (a x) ^ 2 := by nlinarith [(hA x).1]
    have hp : 0 < (2 * a x) ^ 2 := pow_pos (mul_pos two_pos (hapos x)) 2
    rw [hK1, div_pow, div_mul_eq_mul_div, div_le_div_iff₀ hp (by positivity)]
    nlinarith [mul_le_mul_of_nonneg_left h1 (sq_nonneg t)]
  have hub : ∀ x (t : ℝ), (t / (2 * b x)) ^ 2 ≤ K1 * t ^ 2 := by
    intro x t
    have h1 : 9 * ϰ ^ 2 ≤ 16 * (b x) ^ 2 := by nlinarith [(hB x).1]
    have hp : 0 < (2 * b x) ^ 2 := pow_pos (mul_pos two_pos (hbpos x)) 2
    rw [hK1, div_pow, div_mul_eq_mul_div, div_le_div_iff₀ hp (by positivity)]
    nlinarith [mul_le_mul_of_nonneg_left h1 (sq_nonneg t)]
  have hv : ∀ x (s : ℝ), (s / (2 * a x * b x)) ^ 2 ≤ K2 * s ^ 2 := by
    intro x s
    have h0 : 9 * ϰ ^ 2 ≤ 16 * (a x * b x) := by
      have e1 : 3 * ϰ ≤ 4 * a x := by linarith [(hA x).1]
      have e2 : 3 * ϰ ≤ 4 * b x := by linarith [(hB x).1]
      have := mul_le_mul e1 e2 (by linarith) (by linarith [hapos x])
      nlinarith
    have h1 : 81 * ϰ ^ 4 ≤ 256 * (a x * b x) ^ 2 := by
      have := pow_le_pow_left₀ (by positivity) h0 2
      nlinarith
    have hp : 0 < (2 * a x * b x) ^ 2 :=
      pow_pos (mul_pos (mul_pos two_pos (hapos x)) (hbpos x)) 2
    rw [hK2, div_pow, div_mul_eq_mul_div, div_le_div_iff₀ hp (by positivity)]
    nlinarith [mul_le_mul_of_nonneg_left h1 (sq_nonneg s)]
  refine ⟨?_, ?_, ?_⟩
  · 
    have hpt : ∀ x, (deriv a x / (2 * a x) - deriv b x / (2 * b x)) ^ 2 ≤
        (2 * K1) * ((deriv d x) ^ 2 + 4 * (d x) ^ 2) + (2 * K2 * N) * (deriv b x) ^ 2 := by
      intro x
      have hid : deriv a x / (2 * a x) - deriv b x / (2 * b x) =
          deriv d x / (2 * a x) - (deriv b x * d x) / (2 * a x * b x) := by
        rw [hdd x, hd x]
        have := (hapos x).ne'
        have := (hbpos x).ne'
        field_simp
        ring
      rw [hid]
      have h1 := hua x (deriv d x)
      have h2 := hv x (deriv b x * d x)
      have h3 : K2 * (deriv b x * d x) ^ 2 ≤ K2 * ((deriv b x) ^ 2 * N) := by
        apply mul_le_mul_of_nonneg_left _ hK2p
        rw [mul_pow]
        exact mul_le_mul_of_nonneg_left (hN x) (sq_nonneg _)
      have h4 : 0 ≤ K1 * (d x) ^ 2 := mul_nonneg hK1p (sq_nonneg _)
      nlinarith [sq_nonneg (deriv d x / (2 * a x) + (deriv b x * d x) / (2 * a x * b x))]
    have hint1 : IntervalIntegrable (fun x => (deriv a x / (2 * a x) - deriv b x / (2 * b x)) ^ 2)
        MeasureTheory.volume 0 1 := ((hSa.sub hSb).pow 2).intervalIntegrable 0 1
    have hc1 : Continuous (fun x => (2 * K1) * ((deriv d x) ^ 2 + 4 * (d x) ^ 2)) :=
      continuous_const.mul hgc
    have hc2 : Continuous (fun x => (2 * K2 * N) * (deriv b x) ^ 2) :=
      continuous_const.mul (hdb.pow 2)
    have hmono := intervalIntegral.integral_mono_on zero_le_one hint1
      ((hc1.add hc2).intervalIntegrable 0 1) (fun x _ => hpt x)
    have e : (∫ x in (0:ℝ)..1, (2 * K1) * ((deriv d x) ^ 2 + 4 * (d x) ^ 2) +
        (2 * K2 * N) * (deriv b x) ^ 2) =
        (2 * K1) * N + (2 * K2 * N) * ∫ x in (0:ℝ)..1, (deriv b x) ^ 2 := by
      rw [intervalIntegral.integral_add (hc1.intervalIntegrable 0 1) (hc2.intervalIntegrable 0 1),
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul, ← hNdef]
    rw [e] at hmono
    have h5 : (2 * K2 * N) * (∫ x in (0:ℝ)..1, (deriv b x) ^ 2) ≤ (2 * K2 * N) * L ^ 2 :=
      mul_le_mul_of_nonneg_left hLb (by positivity)
    have e2 : (8 / (9 * ϰ ^ 2) + 128 * L ^ 2 / (81 * ϰ ^ 4)) * N =
        (2 * K1) * N + (2 * K2 * N) * L ^ 2 := by
      rw [hK1, hK2]; ring
    rw [e2]
    linarith
  · 
    have hpt : ∀ x, (deriv a x / (2 * a x) + deriv b x / (2 * b x)) ^ 2 ≤
        (2 * K1) * ((deriv a x) ^ 2 + (deriv b x) ^ 2) := by
      intro x
      have h1 := hua x (deriv a x)
      have h2 := hub x (deriv b x)
      nlinarith [sq_nonneg (deriv a x / (2 * a x) - deriv b x / (2 * b x))]
    have hint1 : IntervalIntegrable (fun x => (deriv a x / (2 * a x) + deriv b x / (2 * b x)) ^ 2)
        MeasureTheory.volume 0 1 := ((hSa.add hSb).pow 2).intervalIntegrable 0 1
    have hc1 : Continuous (fun x => (2 * K1) * ((deriv a x) ^ 2 + (deriv b x) ^ 2)) :=
      continuous_const.mul ((hda.pow 2).add (hdb.pow 2))
    have hmono := intervalIntegral.integral_mono_on zero_le_one hint1
      (hc1.intervalIntegrable 0 1) (fun x _ => hpt x)
    have e : (∫ x in (0:ℝ)..1, (2 * K1) * ((deriv a x) ^ 2 + (deriv b x) ^ 2)) =
        (2 * K1) * ((∫ x in (0:ℝ)..1, (deriv a x) ^ 2) + ∫ x in (0:ℝ)..1, (deriv b x) ^ 2) := by
      rw [intervalIntegral.integral_const_mul,
        intervalIntegral.integral_add ((hda.pow 2).intervalIntegrable 0 1)
          ((hdb.pow 2).intervalIntegrable 0 1)]
    rw [e] at hmono
    have h5 : (2 * K1) * ((∫ x in (0:ℝ)..1, (deriv a x) ^ 2) + ∫ x in (0:ℝ)..1, (deriv b x) ^ 2)
        ≤ (2 * K1) * (L ^ 2 + L ^ 2) :=
      mul_le_mul_of_nonneg_left (add_le_add hLa hLb) (by positivity)
    have e2 : 16 * L ^ 2 / (9 * ϰ ^ 2) = (2 * K1) * (L ^ 2 + L ^ 2) := by
      rw [hK1]; ring
    rw [e2]
    linarith
  · 
    have hpt : ∀ x, (d x * (a x + b x)) ^ 2 ≤
        25 * ϰ ^ 2 / 16 * ((deriv d x) ^ 2 + 4 * (d x) ^ 2) := by
      intro x
      have hs0 : 0 ≤ a x + b x := by linarith [hapos x, hbpos x]
      have hs1 : a x + b x ≤ 5 * ϰ / 2 := by linarith [(hA x).2, (hB x).2]
      have hs : (a x + b x) ^ 2 ≤ 25 * ϰ ^ 2 / 4 := by nlinarith
      have h1 := mul_le_mul_of_nonneg_left hs (sq_nonneg (d x))
      have h2 : 0 ≤ 25 * ϰ ^ 2 / 16 * (deriv d x) ^ 2 := by positivity
      rw [mul_pow]
      nlinarith
    have hint1 : IntervalIntegrable (fun x => (d x * (a x + b x)) ^ 2)
        MeasureTheory.volume 0 1 := ((hdc.mul (hac.add hbc)).pow 2).intervalIntegrable 0 1
    have hmono := intervalIntegral.integral_mono_on zero_le_one hint1
      ((continuous_const.mul hgc).intervalIntegrable 0 1) (fun x _ => hpt x)
    rw [intervalIntegral.integral_const_mul, ← hNdef] at hmono
    exact hmono

theorem good_unknown_inverse_lipschitz_T : ∀ R ≥ (0 : ℝ), ∃ ϰ₀ ≥ (1 : ℝ), ∀ ϰ ≥ ϰ₀, ∃ L ≥ (0 : ℝ), ∀ q p u w d : CinfT, ‖ιT q‖ ≤ R → ‖ιT p‖ ≤ R → (∀ x, (u : ℝ → ℝ) x = 1 / (2 * greenT ϰ (q : ℝ → ℝ) x) - ϰ) → (∀ x, (w : ℝ → ℝ) x = 1 / (2 * greenT ϰ (p : ℝ → ℝ) x) - ϰ) → (∀ x, (d : ℝ → ℝ) x = (u : ℝ → ℝ) x - (w : ℝ → ℝ) x) → dist (ιT q) (ιT p) ≤ L * Real.sqrt (∫ x in (0:ℝ)..1, (deriv (d : ℝ → ℝ) x) ^ 2 + 4 * ((d : ℝ → ℝ) x) ^ 2) :=
by
  classical
  intro R hR
  obtain ⟨hlin, -⟩ := toHm1T_basic
  obtain ⟨κ1, hκ1, hs1⟩ := greenT_riccati_region_T R hR
  obtain ⟨ϰ2, hϰ2, hs2⟩ := good_unknown_T R hR
  refine ⟨max κ1 ϰ2, le_trans hκ1 (le_max_left _ _), ?_⟩
  intro ϰ hϰ
  have hϰ1 : κ1 ≤ ϰ := le_trans (le_max_left _ _) hϰ
  have hϰ2' : ϰ2 ≤ ϰ := le_trans (le_max_right _ _) hϰ
  have hϰone : 1 ≤ ϰ := le_trans hκ1 hϰ1
  have hϰpos : 0 < ϰ := by linarith
  obtain ⟨L, hL1, U, hU⟩ := hs2 ϰ hϰ2'
  have hL0 : 0 ≤ L := by linarith
  obtain ⟨Cψ, hCψdef⟩ : ∃ C : ℝ,
      C = Real.sqrt (8 / (9 * ϰ ^ 2) + 128 * L ^ 2 / (81 * ϰ ^ 4)) := ⟨_, rfl⟩
  have hCψ0 : 0 ≤ Cψ := by rw [hCψdef]; exact Real.sqrt_nonneg _
  have hCψsq : Cψ ^ 2 = 8 / (9 * ϰ ^ 2) + 128 * L ^ 2 / (81 * ϰ ^ 4) := by
    rw [hCψdef]; exact Real.sq_sqrt (by positivity)
  obtain ⟨k, hkdef⟩ : ∃ k : ℝ, k = 4 * L / (3 * ϰ) := ⟨_, rfl⟩
  have hk0 : 0 ≤ k := by rw [hkdef]; positivity
  have hksq : k ^ 2 = 16 * L ^ 2 / (9 * ϰ ^ 2) := by rw [hkdef]; ring
  refine ⟨5 * ϰ / 8 + Cψ + Cψ * k, by positivity, ?_⟩
  intro q p u w d hq hp hu hw hd
  
  have hinf1 : (1 : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by exact_mod_cast le_top
  have hinf2 : (2 : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := WithTop.coe_le_coe.2 le_top
  have hderper : ∀ f : ℝ → ℝ, Function.Periodic f 1 → Function.Periodic (deriv f) 1 := by
    intro f hf x
    rw [← deriv_comp_add_const, hf.funext]
  have mk : ∀ f : ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f → Function.Periodic f 1 →
      ∃ F : CinfT, (F : ℝ → ℝ) = f := fun f h1 h2 => ⟨⟨f, h1, h2⟩, rfl⟩
  
  have region : ∀ (q u : CinfT), ‖ιT q‖ ≤ R →
      (∀ x, (u : ℝ → ℝ) x = 1 / (2 * greenT ϰ (q : ℝ → ℝ) x) - ϰ) →
      IsGreenT ϰ (q : ℝ → ℝ) (greenT ϰ (q : ℝ → ℝ)) ∧
      (∀ x, 3 * ϰ / 4 ≤ ϰ + (u : ℝ → ℝ) x ∧ ϰ + (u : ℝ → ℝ) x ≤ 5 * ϰ / 4) ∧
      (∀ x, greenT ϰ (q : ℝ → ℝ) x = 1 / (2 * (ϰ + (u : ℝ → ℝ) x))) ∧
      (∫ x in (0:ℝ)..1, (deriv (u : ℝ → ℝ) x) ^ 2) ≤ L ^ 2 := by
    intro q u hq hu
    obtain ⟨hG, wp, wm, -, -, -, -, -, -, -, -, hwd, hgf⟩ := hs1 ϰ hϰ1 q hq
    obtain ⟨hUq, hUL⟩ := hU q hq
    have hux : ∀ x, (u : ℝ → ℝ) x = (wm x - wp x) / 2 := by
      intro x
      rw [hu x, hgf x]
      have hdx := abs_le.1 (hwd x)
      have hpos : 0 < 2 * ϰ + wm x - wp x := by linarith
      have hne : 2 * ϰ + wm x - wp x ≠ 0 := hpos.ne'
      field_simp
      ring
    refine ⟨hG, fun x => ?_, fun x => ?_, ?_⟩
    · have hdx := abs_le.1 (hwd x)
      rw [hux x]
      constructor <;> linarith
    · rw [hux x, hgf x]
      congr 1
      ring
    · have hUeq : (U q : ℝ → ℝ) = (u : ℝ → ℝ) := funext fun x => by rw [hUq x, hu x]
      rw [hUeq] at hUL
      refine le_trans ?_ hUL
      have hc1 : Continuous (deriv (u : ℝ → ℝ)) := u.2.1.continuous_deriv hinf1
      have hc0 : Continuous (u : ℝ → ℝ) := u.2.1.continuous
      apply intervalIntegral.integral_mono_on zero_le_one
      · exact (hc1.pow 2).intervalIntegrable 0 1
      · exact ((hc1.pow 2).add (continuous_const.mul (hc0.pow 2))).intervalIntegrable 0 1
      · intro x _
        nlinarith [sq_nonneg ((u : ℝ → ℝ) x)]
  obtain ⟨hGq, hAq, hgq, hLq⟩ := region q u hq hu
  obtain ⟨hGp, hBp, hgp, hLp⟩ := region p w hp hw
  
  obtain ⟨a, ha⟩ : ∃ a : ℝ → ℝ, a = fun x => ϰ + (u : ℝ → ℝ) x := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : ℝ → ℝ, b = fun x => ϰ + (w : ℝ → ℝ) x := ⟨_, rfl⟩
  have hax : ∀ x, a x = ϰ + (u : ℝ → ℝ) x := fun x => by rw [ha]
