theorem kdv_small_data_weight_control (h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → IsSchwartzSolution v → u 0 = v 0 → u = v) :
    ∃ δ > (0 : ℝ), ∃ C ≥ (1 : ℝ), ∀ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u →
      ‖ι (u 0)‖ ≤ δ → ∀ κ ≥ (1 : ℝ), ∀ t : ℝ,
