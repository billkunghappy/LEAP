    have h1 : min 1 (δ ^ 2 / (R ^ 2 + 1)) ≤ δ ^ 2 / (R ^ 2 + 1) := min_le_right _ _
    have h2 : 0 < min 1 (δ ^ 2 / (R ^ 2 + 1)) :=
