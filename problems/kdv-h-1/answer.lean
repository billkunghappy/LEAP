theorem riccati_conservation_T : ∀ u : ℝ → CinfT, IsSmoothSolutionT u → ∀ κ : ℝ, 1 ≤ κ → ∀ (W : ℝ → ℝ → ℝ) (t₀ : ℝ), (∀ᶠ s in nhds t₀, Function.Periodic (W s) 1 ∧ (∀ x, HasDerivAt (W s) ((u s : ℝ → ℝ) x + 2 * κ * W s x - W s x ^ 2) x) ∧ (∫ x in (0:ℝ)..1, W s x ^ 2) ≤ κ / 256) → HasDerivAt (fun s => ∫ x in (0:ℝ)..1, W s x ^ 2) 0 t₀ :=
