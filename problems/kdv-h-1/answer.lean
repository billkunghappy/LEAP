  refine ⟨?_, ?_⟩
  · 
    have hBt := hB κ₀ le_rfl
    have e1 := ((Hm1_weight_basic ((ι (u t) : Lp ℂ 2 (volume : Measure ℝ)))).2 κ₀ hκ₀1).2.2
    have e3 := ((Hm1_weight_basic ((ι (u 0) : Lp ℂ 2 (volume : Measure ℝ)))).2 κ₀ hκ₀1).2.1
    have e2 := mul_le_mul_of_nonneg_left hBt (sq_nonneg κ₀)
    have e4 := mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_left (le_trans e3 hu0sq) hC₀0) (sq_nonneg κ₀)
    have hCC : C₀ ≤ C₀ ^ 2 := by nlinarith
    have e5 : κ₀ ^ 2 * (C₀ * R ^ 2) ≤ (κ₀ * C₀ * R) ^ 2 := by
