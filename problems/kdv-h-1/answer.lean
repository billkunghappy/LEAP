    intro φ D hD
    have hK : ∀ x : ℝ, riccatiK 1 D x = φ x + 2 * riccatiK 1 φ x := by
      intro x
      have hE : ∀ y : ℝ, HasDerivAt (fun y : ℝ => Real.exp (2 * 1 * (x - y)))
