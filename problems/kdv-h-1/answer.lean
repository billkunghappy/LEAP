          ‖((ι (r 0) : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 :=
    h₄ K₁ hK₁1 (r 0) (U (r 0)) ((hsmall 0).trans hδ4) (hu 0).1
  have hWt := mul_le_mul_of_nonneg_left (htight t ε₁ hε₁ K₁ hK₁K).le hC₄
  have hWo := mul_le_mul_of_nonneg_left (htight 0 ε₁ hε₁ K₁ hK₁K).le hC₄
  have hPW : P * (∫ ξ : ℝ, ‖(toHm1 (U (r t) - U (r 0)) : ℝ → ℂ) ξ‖ ^ 2 / (4 + ξ ^ 2))
      ≤ Θ / 4 := by
    calc _ ≤ P * (Θ / (4 * P)) := mul_le_mul_of_nonneg_left hWk hP.le
      _ = Θ / 4 := by field_simp
  have hN1lt : (∫ x : ℝ, (deriv ((U (r t) - U (r 0) : 𝓢(ℝ, ℝ)) : ℝ → ℝ) x) ^ 2
      + 4 * ((U (r t) - U (r 0)) x) ^ 2) < e₁ ^ 2 := by
    rw [← hΘdef, ← hA.2]
    linarith
  have hsq := (Real.sqrt_lt' he₁).2 hN1lt
  have h5 := h₅ (r t) (r 0) (U (r t)) (U (r 0)) ((hsmall t).trans hδ5) ((hsmall 0).trans hδ5)
    (hu t).1 (hu 0).1
  have h6 := mul_le_mul_of_nonneg_left hsq.le hL₅
  nlinarith

theorem kdv_Hm1_uniform_cauchy (h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → IsSchwartzSolution v → u 0 = v 0 → u = v) :
    ∀ u : ℕ → ℝ → 𝓢(ℝ, ℝ), (∀ n, IsSchwartzSolution (u n)) →
      CauchySeq (fun n => ι (u n 0)) →
      ∀ T > (0 : ℝ), ∀ ε > (0 : ℝ), ∃ N : ℕ, ∀ m ≥ N, ∀ n ≥ N, ∀ t : ℝ, |t| ≤ T →
        dist (ι (u m t)) (ι (u n t)) < ε :=
by
  classical
  obtain ⟨L, hL⟩ := toHm1_clm
  
  obtain ⟨W, hW⟩ : ∃ W : ℝ → Lp ℂ 2 (volume : Measure ℝ) → ℝ,
      ∀ (κ : ℝ) (f : Lp ℂ 2 (volume : Measure ℝ)),
        W κ f = ∫ ξ : ℝ, ((4 + ξ ^ 2) / (ξ ^ 2 + 4 * κ ^ 2)) * ‖(f : ℝ → ℂ) ξ‖ ^ 2 :=
    ⟨fun κ f => ∫ ξ : ℝ, ((4 + ξ ^ 2) / (ξ ^ 2 + 4 * κ ^ 2)) * ‖(f : ℝ → ℂ) ξ‖ ^ 2,
      fun _ _ => rfl⟩
  have hb1 : ∀ f : Lp ℂ 2 (volume : Measure ℝ), W 1 f = ‖f‖ ^ 2 := fun f => by
    rw [hW]; exact (Hm1_weight_basic f).1
  have hb : ∀ f : Lp ℂ 2 (volume : Measure ℝ), ∀ κ ≥ (1 : ℝ),
      0 ≤ W κ f ∧ W κ f ≤ ‖f‖ ^ 2 ∧ ‖f‖ ^ 2 ≤ κ ^ 2 * W κ f := fun f κ hκ => by
    simp only [hW]; exact (Hm1_weight_basic f).2 κ hκ
  
  have hcoe : ∀ q : 𝓢(ℝ, ℝ), ((ι q : Hm1) : Lp ℂ 2 (volume : Measure ℝ)) = toHm1 q :=
    fun q => rfl
  have hdist : ∀ a b : 𝓢(ℝ, ℝ), dist (ι a) (ι b) = ‖toHm1 (a - b)‖ := by
    intro a b
    rw [dist_eq_norm, Submodule.coe_norm, Submodule.coe_sub, hcoe, hcoe, ← hL a, ← hL b,
      ← map_sub, hL]
  
  have hkFlow_zero : ∀ (κ : ℝ) (q : 𝓢(ℝ, ℝ)), hkFlow κ 0 q = q := by
    intro κ q
    unfold hkFlow
    split_ifs with h
    · exact (Classical.choose_spec h).2
    · rfl
  
  obtain ⟨δ₄, hδ₄, C₄, hC₄, hS6⟩ := kdv_small_data_weight_control h_exists h_unique
  obtain ⟨δ₅, hδ₅, C₅, hC₅, hS7⟩ := hk_flow_weight_control
  obtain ⟨δ₆, hδ₆, hS8⟩ := hk_flow_Hm1_continuity
  obtain ⟨δ₇, hδ₇, hS9⟩ := kdv_hk_commute_curve h_exists h_unique
  obtain ⟨δ₈, hδ₈, hS10⟩ := hk_difference_curve_displacement
  have hS6' : ∀ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u → ‖ι (u 0)‖ ≤ δ₄ →
      ∀ κ ≥ (1 : ℝ), ∀ t : ℝ, W κ (ι (u t)) ≤ C₄ * W κ (ι (u 0)) := by
    intro u hu h0 κ hκ t
    simp only [hW]; exact hS6 u hu h0 κ hκ t
  have hS7' : ∀ κ ≥ (1 : ℝ), ∀ q : 𝓢(ℝ, ℝ), ‖ι q‖ ≤ δ₅ → ∀ t : ℝ, ∀ κ' ≥ (1 : ℝ),
      W κ' (ι (hkFlow κ t q)) ≤ C₅ * W κ' (ι q) := by
    intro κ hκ q hq t κ' hκ'
    simp only [hW]; exact hS7 κ hκ q hq t κ' hκ'
  obtain ⟨m₀, hm₀def⟩ : ∃ m₀ : ℝ, m₀ = min δ₄ (min δ₅ (min δ₆ (min δ₇ δ₈))) := ⟨_, rfl⟩
  have hm₀pos : 0 < m₀ := by
    rw [hm₀def]; exact lt_min hδ₄ (lt_min hδ₅ (lt_min hδ₆ (lt_min hδ₇ hδ₈)))
  have hm₄ : m₀ ≤ δ₄ := by rw [hm₀def]; exact min_le_left _ _
  have hm₅ : m₀ ≤ δ₅ := by
    rw [hm₀def]; exact le_trans (min_le_right _ _) (min_le_left _ _)
  have hm₆ : m₀ ≤ δ₆ := by
    rw [hm₀def]
    exact le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
  have hm₇ : m₀ ≤ δ₇ := by
    rw [hm₀def]
    exact le_trans (min_le_right _ _) (le_trans (min_le_right _ _)
      (le_trans (min_le_right _ _) (min_le_left _ _)))
  have hm₈ : m₀ ≤ δ₈ := by
    rw [hm₀def]
    exact le_trans (min_le_right _ _) (le_trans (min_le_right _ _)
      (le_trans (min_le_right _ _) (min_le_right _ _)))
  have hP1 : 1 ≤ C₄ * C₅ := by nlinarith
  have hPpos : 0 < C₄ * C₅ := by linarith
  obtain ⟨δ₀, hδ₀pos, hδ₀P⟩ : ∃ δ₀ : ℝ, 0 < δ₀ ∧ δ₀ * (C₄ * C₅) = m₀ :=
    ⟨m₀ / (C₄ * C₅), div_pos hm₀pos hPpos, div_mul_cancel₀ _ hPpos.ne'⟩
  have hδ₀m : δ₀ ≤ m₀ := by nlinarith
  have hδ₀sq : C₄ * C₅ * δ₀ ^ 2 ≤ m₀ ^ 2 := by
    calc C₄ * C₅ * δ₀ ^ 2 = m₀ * δ₀ := by rw [← hδ₀P]; ring
      _ ≤ m₀ * m₀ := mul_le_mul_of_nonneg_left hδ₀m hm₀pos.le
      _ = m₀ ^ 2 := by ring
  have hC4sq : C₄ * δ₀ ^ 2 ≤ m₀ ^ 2 := by
    have h1 : C₄ * δ₀ ^ 2 * 1 ≤ C₄ * δ₀ ^ 2 * C₅ :=
      mul_le_mul_of_nonneg_left hC₅ (mul_nonneg (by linarith) (sq_nonneg _))
    nlinarith
  
  
  
  have SD : ∀ v : ℕ → ℝ → 𝓢(ℝ, ℝ), (∀ n, IsSchwartzSolution (v n)) →
      (∀ n, ‖ι (v n 0)‖ ≤ δ₀) → CauchySeq (fun n => ι (v n 0)) →
      ∀ T > (0 : ℝ), ∀ ε > (0 : ℝ), ∃ N : ℕ, ∀ m ≥ N, ∀ n ≥ N, ∀ t : ℝ, |t| ≤ T →
        dist (ι (v m t)) (ι (v n t)) < ε := by
    intro v hv hv0 hvc T hT ε hε
    
    have hA : ∀ (n : ℕ) (σ : ℝ), ∀ κ' ≥ (1 : ℝ), W κ' (ι (v n σ)) ≤ C₄ * W κ' (ι (v n 0)) :=
      fun n σ κ' hκ' => hS6' (v n) (hv n) (le_trans (hv0 n) (le_trans hδ₀m hm₄)) κ' hκ' σ
    have hsq0 : ∀ n, ‖(ι (v n 0) : Lp ℂ 2 (volume : Measure ℝ))‖ ^ 2 ≤ δ₀ ^ 2 := by
      intro n
      have h := hv0 n
      rw [Submodule.coe_norm] at h
      exact pow_le_pow_left₀ (norm_nonneg _) h 2
    have hsmall : ∀ (n : ℕ) (σ : ℝ), ‖ι (v n σ)‖ ≤ m₀ := by
      intro n σ
      have h1 := hA n σ 1 le_rfl
      rw [hb1, hb1] at h1
      have h2 := mul_le_mul_of_nonneg_left (hsq0 n) (by linarith : (0 : ℝ) ≤ C₄)
      have h3 : ‖(ι (v n σ) : Lp ℂ 2 (volume : Measure ℝ))‖ ^ 2 ≤ m₀ ^ 2 := by linarith
      rw [Submodule.coe_norm]
      exact (abs_le_of_sq_le_sq' h3 hm₀pos.le).2
    
    have hcL : CauchySeq (fun n => ((ι (v n 0) : Hm1) : Lp ℂ 2 (volume : Measure ℝ))) := by
      have hvc2 := Metric.cauchySeq_iff.1 hvc
      rw [Metric.cauchySeq_iff]
      intro e he
      obtain ⟨N, hN⟩ := hvc2 e he
      refine ⟨N, fun m hm n hn => ?_⟩
      have h : dist (ι (v m 0)) (ι (v n 0)) < e := hN m hm n hn
      rw [dist_eq_norm, Submodule.coe_norm, Submodule.coe_sub] at h
      show dist ((ι (v m 0) : Hm1) : Lp ℂ 2 (volume : Measure ℝ))
        ((ι (v n 0) : Hm1) : Lp ℂ 2 (volume : Measure ℝ)) < e
      rw [dist_eq_norm]
      exact h
    obtain ⟨g, hg⟩ := cauchySeq_tendsto_of_complete hcL
    have hdec := Hm1_weight_uniform_decay _ g hg
    have hdec' : ∀ η > (0 : ℝ), ∃ K ≥ (1 : ℝ), ∀ κ ≥ K, ∀ n : ℕ, W κ (ι (v n 0)) < η := by
      intro η hη
      obtain ⟨K, hK1, hK⟩ := hdec η hη
      exact ⟨K, hK1, fun κ hκ n => by rw [hW]; exact hK κ hκ n⟩
    choose! Kf hKf1 hKf using hdec'
    
    obtain ⟨κ, hκ1, hκall⟩ :=
      hS10 (fun ε' => Kf (ε' / (C₄ * C₅))) T hT (ε / 3) (by linarith)
    have hκ' := hκall κ le_rfl
    have hdisp : ∀ (n : ℕ) (t : ℝ), |t| ≤ T →
        dist (ι (v n t)) (ι (hkFlow κ t (v n 0))) < ε / 3 := by
      intro n t ht
      
      have hFW : ∀ σ : ℝ, ∀ κ' ≥ (1 : ℝ),
          W κ' (ι (hkFlow κ (t - σ) (v n σ))) ≤ C₄ * C₅ * W κ' (ι (v n 0)) := by
        intro σ κ' hκ'1
        have e1 := hS7' κ hκ1 (v n σ) (le_trans (hsmall n σ) hm₅) (t - σ) κ' hκ'1
        have e2 := hA n σ κ' hκ'1
        have e3 := mul_le_mul_of_nonneg_left e2 (by linarith : (0 : ℝ) ≤ C₅)
        linarith
      have hderiv : ∀ s : ℝ, ∃ w : 𝓢(ℝ, ℝ),
          HasDerivAt (fun σ : ℝ => ι (hkFlow κ (t - σ) (v n σ))) (ι w) s ∧
          ∀ x : ℝ, w x = kdvRHS (hkFlow κ (t - s) (v n s)) x
            - hkRHS κ (hkFlow κ (t - s) (v n s)) x :=
        fun s => hS9 κ hκ1 (v n) (hv n) (fun s' => le_trans (hsmall n s') hm₇) t s
      have hsm : ∀ s : ℝ, ‖ι (hkFlow κ (t - s) (v n s))‖ ≤ δ₈ := by
        intro s
        have h1 := hFW s 1 le_rfl
        rw [hb1, hb1] at h1
        have h2 := mul_le_mul_of_nonneg_left (hsq0 n) hPpos.le
        have h3 : ‖(ι (hkFlow κ (t - s) (v n s)) : Lp ℂ 2 (volume : Measure ℝ))‖ ^ 2
            ≤ m₀ ^ 2 := by linarith
        rw [Submodule.coe_norm]
        exact le_trans (abs_le_of_sq_le_sq' h3 hm₀pos.le).2 hm₈
      have htight : ∀ s : ℝ, ∀ ε' > (0 : ℝ), ∀ κ' ≥ Kf (ε' / (C₄ * C₅)),
          ∫ ξ : ℝ, ((4 + ξ ^ 2) / (ξ ^ 2 + 4 * κ' ^ 2)) *
            ‖((ι (hkFlow κ (t - s) (v n s)) : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2
            < ε' := by
        intro s ε' hε' κ' hκ'
        have hη : 0 < ε' / (C₄ * C₅) := div_pos hε' hPpos
        have hκ'1 : κ' ≥ 1 := le_trans (hKf1 _ hη) hκ'
        have e1 := hFW s κ' hκ'1
        have e2 := hKf _ hη κ' hκ' n
        have e3 : C₄ * C₅ * (ε' / (C₄ * C₅)) = ε' := by
          rw [← mul_div_assoc, mul_div_cancel_left₀ _ hPpos.ne']
        have e4 := mul_lt_mul_of_pos_left e2 hPpos
        have key : W κ' (ι (hkFlow κ (t - s) (v n s))) < ε' := by linarith
        rw [hW] at key
        exact key
      have hfin := hκ' (fun σ => hkFlow κ (t - σ) (v n σ)) hderiv hsm htight t ht
      simpa only [sub_self, sub_zero, hkFlow_zero] using hfin
    
    obtain ⟨N, hN⟩ := hS8 κ hκ1 (fun n => v n 0)
      (fun n => le_trans (hv0 n) (le_trans hδ₀m hm₆)) hvc T hT (ε / 3) (by linarith)
    
    refine ⟨N, fun m hm n hn t ht => ?_⟩
    have e1 : dist (ι (v m t)) (ι (hkFlow κ t (v m 0))) < ε / 3 := hdisp m t ht
    have e2 : dist (ι (hkFlow κ t (v m 0))) (ι (hkFlow κ t (v n 0))) < ε / 3 :=
      hN m hm n hn t ht
    have e3 : dist (ι (v n t)) (ι (hkFlow κ t (v n 0))) < ε / 3 := hdisp n t ht
    rw [dist_comm] at e3
    calc dist (ι (v m t)) (ι (v n t))
        ≤ dist (ι (v m t)) (ι (hkFlow κ t (v m 0)))
          + dist (ι (hkFlow κ t (v m 0))) (ι (hkFlow κ t (v n 0)))
          + dist (ι (hkFlow κ t (v n 0))) (ι (v n t)) := dist_triangle4 _ _ _ _
      _ < ε := by linarith
  
  
  
  intro u hu hc T hT ε hε
  obtain ⟨R, hR⟩ := isBounded_iff_forall_norm_le.1 hc.isBounded_range
  have hR' : ∀ n, ‖toHm1 (u n 0)‖ ≤ max R 0 := by
    intro n
    have h := hR _ ⟨n, rfl⟩
    rw [Submodule.coe_norm, hcoe] at h
    exact le_trans h (le_max_left _ _)
  obtain ⟨c, hc0, hc1, hcR⟩ : ∃ c : ℝ, 0 < c ∧ c ≤ 1 ∧ c * (max R 0) ^ 2 ≤ δ₀ ^ 2 := by
    refine ⟨min 1 (δ₀ ^ 2 / ((max R 0) ^ 2 + 1)),
      lt_min one_pos (div_pos (pow_pos hδ₀pos 2) (by positivity)), min_le_left _ _, ?_⟩
    have h1 : min 1 (δ₀ ^ 2 / ((max R 0) ^ 2 + 1)) ≤ δ₀ ^ 2 / ((max R 0) ^ 2 + 1) :=
      min_le_right _ _
    have h2 : 0 < min 1 (δ₀ ^ 2 / ((max R 0) ^ 2 + 1)) :=
      lt_min one_pos (div_pos (pow_pos hδ₀pos 2) (by positivity))
    rw [le_div_iff₀ (by positivity)] at h1
    nlinarith
  choose v hv hvx using fun n => kdv_scaling_solution c hc0 (u n) (hu n)
  have hinv1 : (1 / c) ≥ 1 := by
    rw [ge_iff_le, le_div_iff₀ hc0]; linarith
  have hcc : c ^ 3 * (1 / c) ^ 2 = c := by
    calc c ^ 3 * (1 / c) ^ 2 = c * (c * (1 / c)) ^ 2 := by ring
      _ = c := by rw [mul_one_div_cancel hc0.ne', one_pow, mul_one]
  
  have hcmp : ∀ p q : 𝓢(ℝ, ℝ), (∀ x : ℝ, p x = c ^ 2 * q (c * x)) →
      c ^ 3 * ‖toHm1 q‖ ^ 2 ≤ ‖toHm1 p‖ ^ 2 ∧ ‖toHm1 p‖ ^ 2 ≤ c * ‖toHm1 q‖ ^ 2 := by
    intro p q hpq
    have hs : W 1 (toHm1 p) = c * W (1 / c) (toHm1 q) := by
      rw [hW, hW]; exact Hm1_weight_scaling c 1 hc0 one_pos q p hpq
    rw [hb1] at hs
    obtain ⟨_, h1, h2⟩ := hb (toHm1 q) (1 / c) hinv1
    constructor
    · have h3 := mul_le_mul_of_nonneg_left h2 (by positivity : (0 : ℝ) ≤ c ^ 3)
      rw [← mul_assoc, hcc] at h3
      linarith
    · have h3 := mul_le_mul_of_nonneg_left h1 hc0.le
      linarith
  
  have hv0 : ∀ n, ‖ι (v n 0)‖ ≤ δ₀ := by
    intro n
    obtain ⟨-, hp⟩ := hcmp (v n 0) (u n 0) (fun x => by rw [hvx, mul_zero])
    have hq : ‖toHm1 (u n 0)‖ ^ 2 ≤ (max R 0) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) (hR' n) 2
    have h2 := mul_le_mul_of_nonneg_left hq hc0.le
    have h3 : ‖toHm1 (v n 0)‖ ^ 2 ≤ δ₀ ^ 2 := by linarith
    rw [Submodule.coe_norm, hcoe]
    exact (abs_le_of_sq_le_sq' h3 hδ₀pos.le).2
  
  have hvc : CauchySeq (fun n => ι (v n 0)) := by
    rw [Metric.cauchySeq_iff] at hc ⊢
    intro e he
    obtain ⟨N, hN⟩ := hc e he
    refine ⟨N, fun m hm n hn => ?_⟩
    have hmn : dist (ι (u m 0)) (ι (u n 0)) < e := hN m hm n hn
    show dist (ι (v m 0)) (ι (v n 0)) < e
    rw [hdist] at hmn ⊢
    obtain ⟨-, hp⟩ := hcmp (v m 0 - v n 0) (u m 0 - u n 0) (fun x => by
      simp only [SchwartzMap.sub_apply, hvx, mul_zero]; ring)
    have h3 : c * ‖toHm1 (u m 0 - u n 0)‖ ^ 2 ≤ ‖toHm1 (u m 0 - u n 0)‖ ^ 2 := by
      have := mul_le_mul_of_nonneg_right hc1 (sq_nonneg ‖toHm1 (u m 0 - u n 0)‖)
      linarith
    have h4 : ‖toHm1 (v m 0 - v n 0)‖ ^ 2 ≤ ‖toHm1 (u m 0 - u n 0)‖ ^ 2 := by linarith
    have h5 := (abs_le_of_sq_le_sq' h4 (norm_nonneg _)).2
    linarith
  
  have hc3 : 0 < c ^ 3 := by positivity
  obtain ⟨N, hN⟩ := SD v hv hv0 hvc (T / c ^ 3) (div_pos hT hc3) (c ^ 2 * ε) (by positivity)
  refine ⟨N, fun m hm n hn t ht => ?_⟩
  have hs : |t / c ^ 3| ≤ T / c ^ 3 := by
    rw [abs_div, abs_of_pos hc3]
    exact div_le_div_of_nonneg_right ht hc3.le
  have hd : dist (ι (v m (t / c ^ 3))) (ι (v n (t / c ^ 3))) < c ^ 2 * ε :=
    hN m hm n hn _ hs
  have hct : c ^ 3 * (t / c ^ 3) = t := by field_simp
  obtain ⟨hq, -⟩ := hcmp (v m (t / c ^ 3) - v n (t / c ^ 3)) (u m t - u n t) (fun x => by
    simp only [SchwartzMap.sub_apply, hvx, hct]; ring)
  rw [hdist] at hd ⊢
  have h0 := norm_nonneg (toHm1 (v m (t / c ^ 3) - v n (t / c ^ 3)))
  have hp2 : ‖toHm1 (v m (t / c ^ 3) - v n (t / c ^ 3))‖ ^ 2 < (c ^ 2 * ε) ^ 2 := by
    nlinarith
  have h4 : c ^ 3 * ‖toHm1 (u m t - u n t)‖ ^ 2 < c ^ 3 * ε ^ 2 := by
    have h6 : (c ^ 2 * ε) ^ 2 ≤ c ^ 3 * ε ^ 2 := by
      have h7 : (c ^ 2 * ε) ^ 2 = c ^ 3 * ε ^ 2 * c := by ring
      rw [h7]
      have hh : 0 ≤ c ^ 3 * ε ^ 2 := by positivity
      nlinarith
    linarith
  have h5 : ‖toHm1 (u m t - u n t)‖ ^ 2 < ε ^ 2 := lt_of_mul_lt_mul_left h4 hc3.le
  exact (abs_lt_of_sq_lt_sq' h5 hε.le).2

/-! ## Main theorem, line case -/

/-- **Killip–Vişan, Theorem 1.1 (line case).** KdV is globally well-posed in `H⁻¹(ℝ)`:
assuming the classical Schwartz-class theory (global existence `h_exists` and uniqueness
`h_unique` of Schwartz solutions, which the paper takes for granted), the solution map
extends uniquely from Schwartz space to a jointly continuous map
`Φ : ℝ × H⁻¹(ℝ) → H⁻¹(ℝ)`. Moreover, for each `q ∈ H⁻¹(ℝ)` the orbit `{Φ(t, q) : t ∈ ℝ}` is
uniformly bounded and equicontinuous in `H⁻¹(ℝ)`. -/
theorem kdv_well_posed_H_minus_one
    (h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → IsSchwartzSolution v → u 0 = v 0 → u = v) :
    ∃ Φ : ℝ × Hm1 → Hm1,
      Continuous Φ ∧ ExtendsSchwartzFlow Φ ∧
      (∀ Ψ : ℝ × Hm1 → Hm1, Continuous Ψ → ExtendsSchwartzFlow Ψ → Ψ = Φ) ∧
      (∀ q : Hm1, Bornology.IsBounded (Set.range fun t : ℝ => Φ (t, q))) ∧
      (∀ q : Hm1, EquicontinuousHm1 (Set.range fun t : ℝ => Φ (t, q))) :=
by
  classical
  have H11 := kdv_orbit_control h_exists h_unique
  have H12 := kdv_Hm1_uniform_cauchy h_exists h_unique
  obtain ⟨L, hL⟩ := toHm1_clm
  choose sol hsol hsol0 using h_exists
  
  haveI : CompleteSpace Hm1 := by
    show CompleteSpace (Submodule.span ℝ (Set.range toHm1)).topologicalClosure
    infer_instance
  
  have hseq : ∀ x : Hm1, ∃ a : ℕ → 𝓢(ℝ, ℝ),
      Filter.Tendsto (fun n => ι (a n)) Filter.atTop (nhds x) := by
    intro x
    have h1 : ((LinearMap.range (L : 𝓢(ℝ, ℝ) →ₗ[ℝ] Lp ℂ 2 (volume : Measure ℝ))) :
        Set (Lp ℂ 2 (volume : Measure ℝ))) = Set.range toHm1 := by
      ext y
      simp only [LinearMap.coe_range, Set.mem_range, ContinuousLinearMap.coe_coe, hL]
    have hspan : Submodule.span ℝ (Set.range toHm1) =
        LinearMap.range (L : 𝓢(ℝ, ℝ) →ₗ[ℝ] Lp ℂ 2 (volume : Measure ℝ)) := by
      rw [← h1, Submodule.span_eq]
    have hmem : (x : Lp ℂ 2 (volume : Measure ℝ)) ∈
        (Submodule.span ℝ (Set.range toHm1)).topologicalClosure := x.2
    rw [← SetLike.mem_coe, Submodule.topologicalClosure_coe, hspan, h1] at hmem
    obtain ⟨b, hb, hbt⟩ := mem_closure_iff_seq_limit.1 hmem
    choose a ha using hb
    refine ⟨a, tendsto_subtype_rng.2 ?_⟩
    have hab : (fun n => ((ι (a n) : Hm1) : Lp ℂ 2 (volume : Measure ℝ))) = b :=
      funext fun n => ha n
    rw [hab]
    exact hbt
  have hdense : DenseRange ι := by
    intro x
    obtain ⟨a, ha⟩ := hseq x
    exact mem_closure_of_tendsto ha (Filter.Eventually.of_forall fun n => ⟨a n, rfl⟩)
  
  have hF_cont : ∀ a : 𝓢(ℝ, ℝ), Continuous fun t : ℝ => ι (sol a t) := by
    intro a
    have h1 := schwartz_curve_comp_clm_continuous L (sol a) (fun t => by
      obtain ⟨v, hv, -⟩ := hsol a t
      exact ⟨v, hv⟩)
    simp only [hL] at h1
    exact h1.subtype_mk _
  
  have hF_cauchy : ∀ a : ℕ → 𝓢(ℝ, ℝ), CauchySeq (fun n => ι (a n)) →
      ∀ T > (0 : ℝ), ∀ ε > (0 : ℝ), ∃ N : ℕ, ∀ m ≥ N, ∀ n ≥ N, ∀ t : ℝ, |t| ≤ T →
        dist (ι (sol (a m) t)) (ι (sol (a n) t)) < ε := by
    intro a ha
    have ha' : CauchySeq (fun n => ι (sol (a n) 0)) := by
      simpa only [hsol0] using ha
    exact H12 (fun n => sol (a n)) (fun n => hsol (a n)) ha'
  obtain ⟨Φ, hΦc, hΦe, hΦlim⟩ :=
    dense_extension_of_uniform_cauchy ι hdense (fun t a => ι (sol a t)) hF_cont hF_cauchy
  have hΦe' : ∀ (t : ℝ) (a : 𝓢(ℝ, ℝ)), Φ (t, ι a) = ι (sol a t) := hΦe
  have hΦlim' : ∀ (x : Hm1) (a : ℕ → 𝓢(ℝ, ℝ)),
      Filter.Tendsto (fun n => ι (a n)) Filter.atTop (nhds x) →
        ∀ t : ℝ, Filter.Tendsto (fun n => ι (sol (a n) t)) Filter.atTop (nhds (Φ (t, x))) :=
    hΦlim
  
  have horbit : ∀ x : Hm1, ∃ a : ℕ → 𝓢(ℝ, ℝ),
      Filter.Tendsto (fun n => ι (a n)) Filter.atTop (nhds x) ∧
      ∃ C ≥ (0 : ℝ), ∃ κ₀ ≥ (1 : ℝ), ∀ (n : ℕ) (t : ℝ),
        ‖ι (sol (a n) t)‖ ≤ C ∧ ∀ κ ≥ κ₀,
          ∫ ξ : ℝ, ((4 + ξ ^ 2) / (ξ ^ 2 + 4 * κ ^ 2)) *
              ‖((ι (sol (a n) t) : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 ≤
            C * ∫ ξ : ℝ, ((4 + ξ ^ 2) / (ξ ^ 2 + 4 * κ ^ 2)) *
              ‖((ι (a n) : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 := by
    intro x
    obtain ⟨a, ha⟩ := hseq x
    obtain ⟨R, hR⟩ := isBounded_iff_forall_norm_le.1 (Metric.isBounded_range_of_tendsto _ ha)
    obtain ⟨C, hC0, κ₀, hκ₀, hctrl⟩ := H11 (max R 0) (le_max_right _ _)
    refine ⟨a, ha, C, hC0, κ₀, hκ₀, fun n t => ?_⟩
    have h0 : ‖ι (sol (a n) 0)‖ ≤ max R 0 := by
      rw [hsol0]
      exact le_trans (hR _ ⟨n, rfl⟩) (le_max_left _ _)
    have hc := hctrl (sol (a n)) (hsol _) h0 t
    rw [hsol0] at hc
    exact hc
  refine ⟨Φ, hΦc, ?_, ?_, ?_, ?_⟩
  · 
    intro u hu t
    have heq : sol (u 0) = u := h_unique _ _ (hsol (u 0)) hu (hsol0 (u 0))
    rw [hΦe', heq]
  · 
    intro Ψ hΨc hΨe
    have hagree : ∀ (t : ℝ) (a : 𝓢(ℝ, ℝ)), Ψ (t, ι a) = Φ (t, ι a) := by
      intro t a
      have h1 := hΨe (sol a) (hsol a) t
      rw [hsol0] at h1
      rw [h1, hΦe']
    have hd : DenseRange (Prod.map id ι : ℝ × 𝓢(ℝ, ℝ) → ℝ × Hm1) :=
      DenseRange.prodMap denseRange_id hdense
    refine Continuous.ext_on hd hΨc hΦc ?_
    rintro _ ⟨⟨t, a⟩, rfl⟩
    exact hagree t a
  · 
    intro x
    obtain ⟨a, ha, C, hC0, κ₀, hκ₀, hctrl⟩ := horbit x
    have hbd : ∀ t : ℝ, ‖Φ (t, x)‖ ≤ C := by
      intro t
      refine le_of_tendsto' ((continuous_norm.tendsto _).comp (hΦlim' x a ha t)) ?_
      intro n
      exact (hctrl n t).1
    exact isBounded_iff_forall_norm_le.2 ⟨C, by rintro _ ⟨t, rfl⟩; exact hbd t⟩
  · 
    intro x ε hε
    obtain ⟨a, ha, C, hC0, κ₀, hκ₀, hctrl⟩ := horbit x
    have hf : Filter.Tendsto (fun n => ((ι (a n) : Hm1) : Lp ℂ 2 (volume : Measure ℝ)))
        Filter.atTop (nhds (x : Lp ℂ 2 (volume : Measure ℝ))) := tendsto_subtype_rng.1 ha
    have hC1 : 0 < C + 1 := by linarith
    have hη : 0 < ε / (80 * (C + 1)) := by positivity
    obtain ⟨K₁, hK₁, hW⟩ := Hm1_weight_uniform_decay _ _ hf (ε / (80 * (C + 1))) hη
    obtain ⟨K, hKK₁, hKκ⟩ : ∃ K : ℝ, K₁ ≤ K ∧ κ₀ ≤ K :=
      ⟨max K₁ κ₀, le_max_left _ _, le_max_right _ _⟩
    have hK1 : 1 ≤ K := le_trans hK₁ hKK₁
    have hD : 0 < K * (C + 1) := mul_pos (by linarith) hC1
    obtain ⟨δ, hδ, hδsq⟩ : ∃ δ > (0 : ℝ), δ ^ 2 * (K * (C + 1)) ^ 2 = ε / 4 := by
      refine ⟨Real.sqrt (ε / 4) / (K * (C + 1)),
        div_pos (Real.sqrt_pos.2 (by positivity)) hD, ?_⟩
      rw [div_pow, Real.sq_sqrt (by positivity), div_mul_cancel₀ _ (pow_pos hD 2).ne']
    refine ⟨δ, hδ, ?_⟩
    rintro _ ⟨t, rfl⟩ h hh
    show translateDiffSq ((Φ (t, x) : Hm1) : Lp ℂ 2 (volume : Measure ℝ)) h < ε
    have hh2 : h ^ 2 < δ ^ 2 := by
      have := abs_lt.1 hh
      exact sq_lt_sq' this.1 this.2
    have hCη : C * (ε / (80 * (C + 1))) ≤ ε / 80 := by
      rw [mul_div_assoc', div_le_div_iff₀ (by positivity) (by norm_num)]
      nlinarith
    have hn : ∀ n : ℕ,
        translateDiffSq ((ι (sol (a n) t) : Hm1) : Lp ℂ 2 (volume : Measure ℝ)) h ≤ ε / 2 := by
      intro n
      have hT := translateDiffSq_bounds.1
        ((ι (sol (a n) t) : Hm1) : Lp ℂ 2 (volume : Measure ℝ)) K hK1 h
      have hgC : ‖((ι (sol (a n) t) : Hm1) : Lp ℂ 2 (volume : Measure ℝ))‖ ≤ C :=
        (hctrl n t).1
      have hWg := (hctrl n t).2 K hKκ
      have hWf : (∫ ξ : ℝ, ((4 + ξ ^ 2) / (ξ ^ 2 + 4 * K ^ 2)) *
          ‖((ι (a n) : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2) <
            ε / (80 * (C + 1)) := hW K hKK₁ n
      have hg2 : ‖((ι (sol (a n) t) : Hm1) : Lp ℂ 2 (volume : Measure ℝ))‖ ^ 2 ≤ (C + 1) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) (by linarith) 2
      have e1 : K ^ 2 * h ^ 2 *
          ‖((ι (sol (a n) t) : Hm1) : Lp ℂ 2 (volume : Measure ℝ))‖ ^ 2 ≤ ε / 4 := by
        calc K ^ 2 * h ^ 2 * ‖((ι (sol (a n) t) : Hm1) : Lp ℂ 2 (volume : Measure ℝ))‖ ^ 2
            ≤ K ^ 2 * h ^ 2 * (C + 1) ^ 2 :=
              mul_le_mul_of_nonneg_left hg2 (by positivity)
          _ = h ^ 2 * (K * (C + 1)) ^ 2 := by ring
          _ ≤ δ ^ 2 * (K * (C + 1)) ^ 2 :=
              mul_le_mul_of_nonneg_right hh2.le (by positivity)
          _ = ε / 4 := hδsq
      have e2 := mul_le_mul_of_nonneg_left hWf.le hC0
      linarith
    have hlim : Filter.Tendsto
        (fun n => translateDiffSq ((ι (sol (a n) t) : Hm1) : Lp ℂ 2 (volume : Measure ℝ)) h)
        Filter.atTop
        (nhds (translateDiffSq ((Φ (t, x) : Hm1) : Lp ℂ 2 (volume : Measure ℝ)) h)) :=
      ((translateDiffSq_bounds.2 h).tendsto _).comp (tendsto_subtype_rng.1 (hΦlim' x a ha t))
    have hle := le_of_tendsto' hlim hn
    linarith

/-! # Part B. The circle `ℝ/ℤ`

## The phase space `C^∞(ℝ/ℤ)` and smooth solutions -/

open scoped ContDiff in
/-- `C^∞(ℝ/ℤ)`, the paper's "Schwartz space" on the circle, realised as the smooth 1-periodic
real-valued functions on `ℝ`. -/
def CinfT : Set (ℝ → ℝ) :=
  {f | ContDiff ℝ ∞ f ∧ Function.Periodic f 1}

open scoped ContDiff in
/-- A global smooth solution of (KdV) on the circle: a curve `u : ℝ → C^∞(ℝ/ℤ)` such that
`(t, x) ↦ u(t)(x)` is jointly `C^∞` on `ℝ × ℝ` (equivalently, since `ℝ/ℤ` is compact, `u` is
a `C^∞` curve in the Fréchet space `C^∞(ℝ/ℤ)`). It must satisfy
`∂ₜ u(t,x) = -∂ₓ³u(t,x) + 6 u(t,x) ∂ₓu(t,x)` at every `(t, x)`. -/
def IsSmoothSolutionT (u : ℝ → CinfT) : Prop :=
  ContDiff ℝ ∞ (fun p : ℝ × ℝ => (u p.1 : ℝ → ℝ) p.2) ∧
    ∀ t x : ℝ, HasDerivAt (fun s : ℝ => (u s : ℝ → ℝ) x) (kdvRHS (u t : ℝ → ℝ) x) t

/-! ## The space `H⁻¹(ℝ/ℤ)` -/

/-- The Fourier coefficient on the circle with the paper's normalisation
`q̂(ξ) = ∫₀¹ e^{-iξx} q(x) dx`, evaluated at `ξ = 2πn`. -/
def fourierCircle (q : ℝ → ℝ) (n : ℤ) : ℂ :=
  ∫ x in (0 : ℝ)..1, Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * (q x : ℂ)

/-- The `H⁻¹(ℝ/ℤ)` profile `n ↦ (4 + (2πn)²)^{-1/2} q̂(2πn)`. Its `ℓ²(ℤ)` norm is
`‖q‖_{H⁻¹(ℝ/ℤ)}`. -/
def hm1ProfileT (q : ℝ → ℝ) (n : ℤ) : ℂ :=
  ((Real.sqrt (4 + (2 * π * n) ^ 2))⁻¹ : ℂ) * fourierCircle q n

/-- The isometric embedding of a smooth periodic function into `ℓ²(ℤ; ℂ)` via its `H⁻¹`
profile (junk value `0` if the profile were not square summable, which never happens). -/
def toHm1T (q : CinfT) : lp (fun _ : ℤ => ℂ) 2 :=
  if h : Memℓp (hm1ProfileT (q : ℝ → ℝ)) 2 then ⟨hm1ProfileT (q : ℝ → ℝ), h⟩ else 0

/-- Real `H⁻¹(ℝ/ℤ)`, realised (isometrically) as the closure in `ℓ²(ℤ; ℂ)` of the `H⁻¹`
profiles of real smooth 1-periodic functions, i.e. the completion of `C^∞(ℝ/ℤ)` in the `H⁻¹`
norm. -/
def Hm1T : Submodule ℝ (lp (fun _ : ℤ => ℂ) 2) :=
  (Submodule.span ℝ (Set.range toHm1T)).topologicalClosure

/-- The embedding `C^∞(ℝ/ℤ) → H⁻¹(ℝ/ℤ)`. -/
def ιT (q : CinfT) : Hm1T :=
  ⟨toHm1T q, Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨q, rfl⟩)⟩

/-! ## Equicontinuity and the extension property -/

/-- `‖q(· + h) - q‖²_{H⁻¹(ℝ/ℤ)}` expressed through the `H⁻¹` profile `f` of `q`:
`∑ₙ |e^{2πinh} - 1|² |f(n)|²`. -/
def translateDiffSqT (f : lp (fun _ : ℤ => ℂ) 2) (h : ℝ) : ℝ :=
  ∑' n : ℤ, ‖(Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1) * f n‖ ^ 2

/-- Equicontinuity in `H⁻¹(ℝ/ℤ)` (paper Definition 4.1): `q(· + h) → q` in `H⁻¹` as
`h → 0`, uniformly for `q ∈ Q`. -/
def EquicontinuousHm1T (Q : Set Hm1T) : Prop :=
  ∀ ε > 0, ∃ δ > 0, ∀ q ∈ Q, ∀ h : ℝ, |h| < δ →
    translateDiffSqT (q : lp (fun _ : ℤ => ℂ) 2) h < ε

/-- `Φ` extends the smooth solution map: for every smooth solution `u`,
`Φ(t, u(0)) = u(t)` in `H⁻¹(ℝ/ℤ)` for all `t`. -/
def ExtendsSmoothFlowT (Φ : ℝ × Hm1T → Hm1T) : Prop :=
  ∀ u : ℝ → CinfT, IsSmoothSolutionT u → ∀ t : ℝ, Φ (t, ιT (u 0)) = ιT (u t)

/-! ## Auxiliary circle-case definitions -/

def WT (κ : ℝ) (f : lp (fun _ : ℤ => ℂ) 2) : ℝ :=
  ∑' n : ℤ, ((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * κ ^ 2)) * ‖f n‖ ^ 2

open scoped ContDiff in

def IsGreenT (κ : ℝ) (q g : ℝ → ℝ) : Prop :=
  ContDiff ℝ ∞ g ∧ Function.Periodic g 1 ∧ (∀ x, 0 < g x) ∧
    ∀ x, deriv g x ^ 2 - 2 * g x * iteratedDeriv 2 g x + 4 * (κ ^ 2 + q x) * g x ^ 2 = 1


def greenT (κ : ℝ) (q : ℝ → ℝ) : ℝ → ℝ :=
  if h : ∃ g : ℝ → ℝ, IsGreenT κ q g then Classical.choose h else fun _ => 1 / (2 * κ)


def hkRHST (κ : ℝ) (q : ℝ → ℝ) (x : ℝ) : ℝ :=
  16 * κ ^ 5 * deriv (greenT κ q) x + 4 * κ ^ 2 * deriv q x

open scoped ContDiff in

def IsHkSolutionT (κ : ℝ) (c : ℝ → CinfT) : Prop :=
  ContDiff ℝ ∞ (fun p : ℝ × ℝ => (c p.1 : ℝ → ℝ) p.2) ∧
    ∀ t x : ℝ, HasDerivAt (fun s : ℝ => (c s : ℝ → ℝ) x) (hkRHST κ (c t : ℝ → ℝ) x) t


def hkFlowT (κ t : ℝ) (q : CinfT) : CinfT :=
  if h : ∃ c : ℝ → CinfT, IsHkSolutionT κ c ∧ c 0 = q then Classical.choose h t else q
def rgreenT (κ : ℝ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  (1 - Real.exp (2 * (∫ y in (0:ℝ)..1, w y) - 2 * κ))⁻¹ *
    ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y)


def rgreenRT (κ : ℝ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  (1 - Real.exp (2 * (∫ y in (0:ℝ)..1, w y) - 2 * κ))⁻¹ *
    ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * ∫ y in x..(x + s), w y)


def wfieldT (κ : ℝ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  8 * κ ^ 5 * (rgreenT κ w x - rgreenRT κ w x)
def wfieldTclamp (κ ρ : ℝ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  8 * κ ^ 5 * (1 - Real.exp (2 * wclamp ρ (∫ y in (0:ℝ)..1, w y) - 2 * κ))⁻¹ *
    ((∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * wclamp ρ (∫ y in (x - s)..x, w y))) -
      ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * wclamp ρ (∫ y in x..(x + s), w y)))

theorem toHm1T_basic : (∀ (q₁ q₂ r : CinfT) (c₁ c₂ : ℝ),
      (∀ x, (r : ℝ → ℝ) x = c₁ * (q₁ : ℝ → ℝ) x + c₂ * (q₂ : ℝ → ℝ) x) →
      toHm1T r = c₁ • toHm1T q₁ + c₂ • toHm1T q₂) ∧
    (∀ (q : CinfT) (M : ℝ), (∀ x, |(q : ℝ → ℝ) x| ≤ M) → ‖toHm1T q‖ ≤ M) :=
by
  
  have hw : (Summable fun n : ℤ => 1 / (4 + (2 * π * (n : ℝ)) ^ 2)) ∧
      (∑' n : ℤ, 1 / (4 + (2 * π * (n : ℝ)) ^ 2)) ≤ 1 / 3 := by
    set b : ℤ → ℝ := fun n =>
      (if n = 0 then (1 / 4 : ℝ) else 0) + (1 / (4 * π ^ 2)) * (1 / (n : ℝ) ^ 2) with hb
    have hle : ∀ n : ℤ, 1 / (4 + (2 * π * (n : ℝ)) ^ 2) ≤ b n := by
      intro n
      by_cases hn : n = 0
      · subst hn
        simp [b]
      · have hn' : (n : ℝ) ≠ 0 := Int.cast_ne_zero.mpr hn
        have ht : 0 < 4 * π ^ 2 * (n : ℝ) ^ 2 := by positivity
        have e : b n = 1 / (4 * π ^ 2 * (n : ℝ) ^ 2) := by
          simp only [b, if_neg hn]
          field_simp
          ring
        rw [e]
        apply one_div_le_one_div_of_le ht
        nlinarith [sq_nonneg (n : ℝ)]
    have hnn : ∀ n : ℤ, 0 ≤ 1 / (4 + (2 * π * (n : ℝ)) ^ 2) := fun n => by positivity
    have hsum1 : HasSum (fun n : ℤ => 1 / (n : ℝ) ^ 2) (π ^ 2 / 6 + π ^ 2 / 6) := by
      apply HasSum.of_nat_of_neg_add_one
      · simpa using hasSum_zeta_two
      · have h := (hasSum_nat_add_iff' 1).2 hasSum_zeta_two
        convert h using 1
        · funext n
          push_cast
          ring
        · simp
    have hbsum : HasSum b (1 / 3) := by
      have h := (hasSum_ite_eq (0 : ℤ) (1 / 4 : ℝ)).add (hsum1.mul_left (1 / (4 * π ^ 2)))
      convert h using 1
      have hpi : π ≠ 0 := Real.pi_pos.ne'
      field_simp
      ring
    have hsw : Summable fun n : ℤ => 1 / (4 + (2 * π * (n : ℝ)) ^ 2) :=
      Summable.of_nonneg_of_le hnn hle hbsum.summable
    refine ⟨hsw, ?_⟩
    calc (∑' n : ℤ, 1 / (4 + (2 * π * (n : ℝ)) ^ 2)) ≤ ∑' n, b n :=
          Summable.tsum_le_tsum hle hsw hbsum.summable
      _ = 1 / 3 := hbsum.tsum_eq
  
  have hF : ∀ (q : ℝ → ℝ) (M : ℝ), (∀ x, |q x| ≤ M) → ∀ n : ℤ, ‖fourierCircle q n‖ ≤ M := by
    intro q M hq n
    unfold fourierCircle
    have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := (0 : ℝ)) (b := 1) (C := M)
      (f := fun x : ℝ => Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * (q x : ℂ)) ?_
    · simpa using h
    · intro x _
      rw [norm_mul]
      have e : -(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I = ((-(2 * π * n * x) : ℝ) : ℂ) * I := by
        push_cast
        ring
      rw [e, Complex.norm_exp_ofReal_mul_I, Complex.norm_real, Real.norm_eq_abs, one_mul]
      exact hq x
  have hP : ∀ (q : ℝ → ℝ) (M : ℝ), (∀ x, |q x| ≤ M) → ∀ n : ℤ,
      ‖hm1ProfileT q n‖ ^ 2 ≤ M ^ 2 * (1 / (4 + (2 * π * (n : ℝ)) ^ 2)) := by
    intro q M hq n
    have hFn := hF q M hq n
    have ha : 0 < 4 + (2 * π * (n : ℝ)) ^ 2 := by positivity
    unfold hm1ProfileT
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.sqrt_nonneg _), mul_pow, inv_pow, Real.sq_sqrt ha.le, one_div,
      mul_comm (M ^ 2)]
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) hFn 2) (by positivity)
  
  have hp : (0 : ℝ) < (2 : ENNReal).toReal := by norm_num
  have hL : ∀ (q : ℝ → ℝ) (M : ℝ), (∀ x, |q x| ≤ M) →
      Memℓp (hm1ProfileT q) 2 ∧ ∀ g : lp (fun _ : ℤ => ℂ) 2,
        (∀ n, g n = hm1ProfileT q n) → ‖g‖ ≤ M := by
    intro q M hq
    have hM : 0 ≤ M := le_trans (abs_nonneg _) (hq 0)
    have hs : Summable fun n => ‖hm1ProfileT q n‖ ^ 2 :=
      Summable.of_nonneg_of_le (fun n => by positivity) (hP q M hq) (hw.1.mul_left (M ^ 2))
    have htsum : (∑' n, ‖hm1ProfileT q n‖ ^ 2) ≤ M ^ 2 := by
      calc (∑' n, ‖hm1ProfileT q n‖ ^ 2)
          ≤ ∑' n : ℤ, M ^ 2 * (1 / (4 + (2 * π * (n : ℝ)) ^ 2)) :=
            Summable.tsum_le_tsum (hP q M hq) hs (hw.1.mul_left (M ^ 2))
        _ = M ^ 2 * ∑' n : ℤ, (1 / (4 + (2 * π * (n : ℝ)) ^ 2)) := tsum_mul_left
        _ ≤ M ^ 2 * 1 := by
            apply mul_le_mul_of_nonneg_left _ (sq_nonneg M)
            linarith [hw.2]
        _ = M ^ 2 := mul_one _
    refine ⟨?_, ?_⟩
    · refine (memℓp_gen_iff hp).2 ?_
      simpa only [ENNReal.toReal_ofNat, Real.rpow_two] using hs
    · intro g hg
      refine lp.norm_le_of_tsum_le hp hM ?_
      simp only [ENNReal.toReal_ofNat, Real.rpow_two, hg]
      exact htsum
  
  have hbdd : ∀ q : CinfT, ∃ M, ∀ x, |(q : ℝ → ℝ) x| ≤ M := by
    intro q
    have hc : Continuous (q : ℝ → ℝ) := q.2.1.continuous
    obtain ⟨C, hC⟩ := isBounded_iff_forall_norm_le.1
      (q.2.2.compact_of_continuous (one_ne_zero : (1 : ℝ) ≠ 0) hc).isBounded
    exact ⟨C, fun x => by rw [← Real.norm_eq_abs]; exact hC _ ⟨x, rfl⟩⟩
  
  have hcoe : ∀ (q : CinfT) (n : ℤ), toHm1T q n = hm1ProfileT (q : ℝ → ℝ) n := by
    intro q n
    obtain ⟨M, hM⟩ := hbdd q
    have hmem := (hL _ M hM).1
    unfold toHm1T
    rw [dif_pos hmem]
  
  have hlinF : ∀ (q₁ q₂ r : ℝ → ℝ) (c₁ c₂ : ℝ), Continuous q₁ → Continuous q₂ →
      (∀ x, r x = c₁ * q₁ x + c₂ * q₂ x) → ∀ n : ℤ,
      fourierCircle r n = (c₁ : ℂ) * fourierCircle q₁ n + (c₂ : ℂ) * fourierCircle q₂ n := by
    intro q₁ q₂ r c₁ c₂ h1 h2 hr n
    unfold fourierCircle
    have he : Continuous fun x : ℝ => Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) := by
      fun_prop
    have i1 : IntervalIntegrable
        (fun x : ℝ => Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * (q₁ x : ℂ))
        volume 0 1 :=
      (he.mul (Complex.continuous_ofReal.comp h1)).intervalIntegrable _ _
    have i2 : IntervalIntegrable
        (fun x : ℝ => Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * (q₂ x : ℂ))
        volume 0 1 :=
      (he.mul (Complex.continuous_ofReal.comp h2)).intervalIntegrable _ _
    rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_const_mul,
      ← intervalIntegral.integral_add (i1.const_mul _) (i2.const_mul _)]
    apply intervalIntegral.integral_congr
    intro x _
    simp only
    rw [hr x]
    push_cast
    ring
  refine ⟨?_, ?_⟩
  · intro q₁ q₂ r c₁ c₂ hr
    apply lp.ext
    funext n
    rw [lp.coeFn_add, Pi.add_apply, lp.coeFn_smul, lp.coeFn_smul, Pi.smul_apply, Pi.smul_apply,
      hcoe, hcoe, hcoe, Complex.real_smul, Complex.real_smul]
    unfold hm1ProfileT
    rw [hlinF _ _ _ c₁ c₂ q₁.2.1.continuous q₂.2.1.continuous hr n]
    ring
  · intro q M hq
    exact (hL _ M hq).2 (toHm1T q) (hcoe q)

theorem periodic_uniform_continuity (U : ℝ × ℝ → ℝ) (hU : Continuous U)
    (hper : ∀ t x : ℝ, U (t, x + 1) = U (t, x)) (t₀ ε : ℝ) (hε : 0 < ε) :
    ∃ η > 0, ∀ t : ℝ, |t - t₀| < η → ∀ x : ℝ, |U (t, x) - U (t₀, x)| < ε :=
by
  have hK : IsCompact (Set.Icc (t₀ - 1) (t₀ + 1) ×ˢ Set.Icc (0:ℝ) 1) :=
    isCompact_Icc.prod isCompact_Icc
  have huc := hK.uniformContinuousOn_of_continuous hU.continuousOn
  obtain ⟨δ, hδ, hD⟩ := Metric.uniformContinuousOn_iff.1 huc ε hε
  refine ⟨min δ 1, lt_min hδ one_pos, fun t ht x => ?_⟩
  have htδ : |t - t₀| < δ := lt_of_lt_of_le ht (min_le_left _ _)
  have ht1 : |t - t₀| < 1 := lt_of_lt_of_le ht (min_le_right _ _)
  have hper' : ∀ s : ℝ, U (s, x - (⌊x⌋ : ℝ)) = U (s, x) := by
    intro s
    have hp : Function.Periodic (fun y : ℝ => U (s, y)) 1 := fun y => hper s y
    have := hp.sub_int_mul_eq (x := x) ⌊x⌋
    simpa only [mul_one] using this
  have hfl1 := Int.floor_le x
  have hfl2 := Int.lt_floor_add_one x
  have hab := abs_lt.1 ht1
  have hm1 : ((t, x - (⌊x⌋ : ℝ)) : ℝ × ℝ) ∈ Set.Icc (t₀ - 1) (t₀ + 1) ×ˢ Set.Icc (0:ℝ) 1 := by
    refine Set.mem_prod.2 ⟨⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩⟩
  have hm2 : ((t₀, x - (⌊x⌋ : ℝ)) : ℝ × ℝ) ∈ Set.Icc (t₀ - 1) (t₀ + 1) ×ˢ Set.Icc (0:ℝ) 1 := by
    refine Set.mem_prod.2 ⟨⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩⟩
  have hdist : dist ((t, x - (⌊x⌋ : ℝ)) : ℝ × ℝ) (t₀, x - (⌊x⌋ : ℝ)) < δ := by
    rw [Prod.dist_eq, dist_self, Real.dist_eq, max_eq_left (abs_nonneg _)]
    exact htδ
  have h := hD _ hm1 _ hm2 hdist
  rw [Real.dist_eq, hper' t, hper' t₀] at h
  exact h

theorem cauchy_schwarz_unit_interval : ∀ (f g : ℝ → ℝ), Continuous f → Continuous g → (∫ x in (0:ℝ)..1, f x * g x) ^ 2 ≤ (∫ x in (0:ℝ)..1, f x ^ 2) * (∫ x in (0:ℝ)..1, g x ^ 2) :=
by
  intro f g hf hg
  have hq : ∀ t : ℝ, 0 ≤ (∫ x in (0:ℝ)..1, f x ^ 2) * (t * t) +
      (2 * ∫ x in (0:ℝ)..1, f x * g x) * t + (∫ x in (0:ℝ)..1, g x ^ 2) := by
    intro t
    have h0 : 0 ≤ ∫ x in (0:ℝ)..1, (t * f x + g x) ^ 2 :=
      intervalIntegral.integral_nonneg (by norm_num) (fun x _ => sq_nonneg _)
    have e : (∫ x in (0:ℝ)..1, (t * f x + g x) ^ 2) =
        ∫ x in (0:ℝ)..1, ((t * t) * f x ^ 2 + (2 * t) * (f x * g x) + g x ^ 2) := by
      congr 1; funext x; ring
    rw [e, intervalIntegral.integral_add, intervalIntegral.integral_add,
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul] at h0
    · linarith
    all_goals (apply Continuous.intervalIntegrable; fun_prop)
  have hd := discrim_le_zero hq
  unfold discrim at hd
  nlinarith [hd]

theorem weight_compare_T : ∀ (f : lp (fun _ : ℤ => ℂ) 2) (κ : ℝ), 1 ≤ κ → 0 ≤ (∑' n : ℤ, ((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * κ ^ 2)) * ‖f n‖ ^ 2) ∧ (∑' n : ℤ, ((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * κ ^ 2)) * ‖f n‖ ^ 2) ≤ ‖f‖ ^ 2 ∧ ‖f‖ ^ 2 ≤ κ ^ 2 * ∑' n : ℤ, ((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * κ ^ 2)) * ‖f n‖ ^ 2 :=
by
  intro f κ hκ
  have hκ2 : 1 ≤ κ ^ 2 := by nlinarith
  have hD : ∀ n : ℤ, 0 < (2 * π * (n : ℝ)) ^ 2 + 4 * κ ^ 2 := fun n => by
    nlinarith [sq_nonneg (2 * π * (n : ℝ))]
  have hW0 : ∀ n : ℤ,
      0 ≤ (4 + (2 * π * (n : ℝ)) ^ 2) / ((2 * π * (n : ℝ)) ^ 2 + 4 * κ ^ 2) := fun n => by
    positivity
  have hW1 : ∀ n : ℤ,
      (4 + (2 * π * (n : ℝ)) ^ 2) / ((2 * π * (n : ℝ)) ^ 2 + 4 * κ ^ 2) ≤ 1 := fun n => by
    rw [div_le_one (hD n)]; nlinarith
  have hWk : ∀ n : ℤ,
      1 ≤ κ ^ 2 * ((4 + (2 * π * (n : ℝ)) ^ 2) / ((2 * π * (n : ℝ)) ^ 2 + 4 * κ ^ 2)) :=
    fun n => by
      rw [← mul_div_assoc, one_le_div (hD n)]
      nlinarith [mul_nonneg (show 0 ≤ κ ^ 2 - 1 by linarith) (sq_nonneg (2 * π * (n : ℝ)))]
  have hp : 0 < (2 : ENNReal).toReal := by norm_num
  have hs := (lp.memℓp f).summable hp
  have he := lp.norm_rpow_eq_tsum hp f
  simp only [ENNReal.toReal_ofNat, Real.rpow_two] at hs he
  have hle : ∀ n : ℤ,
      (4 + (2 * π * (n : ℝ)) ^ 2) / ((2 * π * (n : ℝ)) ^ 2 + 4 * κ ^ 2) * ‖f n‖ ^ 2 ≤
        ‖f n‖ ^ 2 := fun n =>
    mul_le_of_le_one_left (sq_nonneg _) (hW1 n)
  have hnn : ∀ n : ℤ,
      0 ≤ (4 + (2 * π * (n : ℝ)) ^ 2) / ((2 * π * (n : ℝ)) ^ 2 + 4 * κ ^ 2) * ‖f n‖ ^ 2 :=
    fun n => mul_nonneg (hW0 n) (sq_nonneg _)
  have hg : Summable (fun n : ℤ =>
      (4 + (2 * π * (n : ℝ)) ^ 2) / ((2 * π * (n : ℝ)) ^ 2 + 4 * κ ^ 2) * ‖f n‖ ^ 2) :=
    Summable.of_nonneg_of_le hnn hle hs
  refine ⟨tsum_nonneg hnn, ?_, ?_⟩
  · rw [he]
    exact hg.tsum_le_tsum hle hs
  · rw [he, ← tsum_mul_left]
    refine hs.tsum_le_tsum (fun n => ?_) (hg.mul_left _)
    have h1 := mul_le_mul_of_nonneg_right (hWk n) (sq_nonneg ‖f n‖)
    rw [one_mul, mul_assoc] at h1
    exact h1

theorem periodic_resolvent_T : ∀ (κ : ℝ), 1 ≤ κ → ∀ (f : ℝ → ℝ), Continuous f → Function.Periodic f 1 → (∃ v : ℝ → ℝ, Function.Periodic v 1 ∧ ∀ x, HasDerivAt v (2 * κ * v x + f x) x) ∧ ∀ v : ℝ → ℝ, Function.Periodic v 1 → (∀ x, HasDerivAt v (2 * κ * v x + f x) x) → (∀ x, v x = -(1 - Real.exp (-(2 * κ)))⁻¹ * ∫ y in x..(x + 1), Real.exp (-(2 * κ) * (y - x)) * f y) ∧ (∀ x, |v x| ≤ 2 * ∫ y in (0:ℝ)..1, |f y|) ∧ (∫ x in (0:ℝ)..1, v x ^ 2) ≤ (∫ x in (0:ℝ)..1, f x ^ 2) / (4 * κ ^ 2) ∧ (∫ x in (0:ℝ)..1, v x ^ 2) ≤ (∫ x in (0:ℝ)..1, |f x|) ^ 2 / κ :=
by
  intro κ hκ f hf hfp
  have hκpos : 0 < κ := by linarith
  set e := Real.exp (-(2 * κ)) with he
  have he_pos : 0 < e := Real.exp_pos _
  have hee : e * Real.exp (2 * κ) = 1 := by
    rw [he, ← Real.exp_add]; simp
  have he_le : e ≤ 1 / 3 := by
    have h1 : 2 * κ + 1 ≤ Real.exp (2 * κ) := Real.add_one_le_exp _
    nlinarith
  have h1e : 0 < 1 - e := by linarith
  have hc : (1 - e)⁻¹ * (1 - e) = 1 := inv_mul_cancel₀ h1e.ne'
  have hc_pos : 0 < (1 - e)⁻¹ := inv_pos.2 h1e
  have hc_le : (1 - e)⁻¹ ≤ 2 := by nlinarith
  refine ⟨?_, ?_⟩
  · 
    obtain ⟨E, hE⟩ : ∃ E : ℝ → ℝ, ∀ y, E y = Real.exp (-(2 * κ) * y) * f y :=
      ⟨_, fun _ => rfl⟩
    have hEc : Continuous E := by
      have : E = fun y => Real.exp (-(2 * κ) * y) * f y := funext hE
      rw [this]; fun_prop
    obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ → ℝ, ∀ x, Φ x = ∫ y in (0:ℝ)..x, E y := ⟨_, fun _ => rfl⟩
    have hΦd : ∀ b, HasDerivAt Φ (E b) b := by
      intro b
      have : Φ = fun x => ∫ y in (0:ℝ)..x, E y := funext hΦ
      rw [this]
      exact (hEc.integral_hasStrictDerivAt 0 b).hasDerivAt
    have hEshift : ∀ z, E (z + 1) = e * E z := by
      intro z
      rw [hE, hE, hfp z, he, ← mul_assoc, ← Real.exp_add]
      congr 2; ring
    have hD : ∀ x, Φ (x + 1) - Φ x = ∫ y in x..(x + 1), E y := by
      intro x
      rw [hΦ, hΦ]
      exact intervalIntegral.integral_interval_sub_left (hEc.intervalIntegrable _ _)
        (hEc.intervalIntegrable _ _)
    have hDshift : ∀ x, Φ (x + 1 + 1) - Φ (x + 1) = e * (Φ (x + 1) - Φ x) := by
      intro x
      rw [hD, hD, ← intervalIntegral.integral_const_mul]
      have := intervalIntegral.integral_comp_add_right E (1:ℝ) (a := x) (b := x + 1)
      rw [← this]
      congr 1; funext y; exact hEshift y
    refine ⟨fun x => -(1 - e)⁻¹ * (Real.exp (2 * κ * x) * (Φ (x + 1) - Φ x)), ?_, ?_⟩
    · intro x
      show -(1 - e)⁻¹ * (Real.exp (2 * κ * (x + 1)) * (Φ (x + 1 + 1) - Φ (x + 1))) =
        -(1 - e)⁻¹ * (Real.exp (2 * κ * x) * (Φ (x + 1) - Φ x))
      rw [hDshift x]
      have : Real.exp (2 * κ * (x + 1)) * e = Real.exp (2 * κ * x) := by
        rw [he, ← Real.exp_add]; congr 1; ring
      rw [← this]; ring
    · intro x
      have h1 : HasDerivAt (fun x => Φ (x + 1)) (E (x + 1)) x := (hΦd (x + 1)).comp_add_const x 1
      have hexp : HasDerivAt (fun x => Real.exp (2 * κ * x)) (Real.exp (2 * κ * x) * (2 * κ * 1)) x :=
        ((hasDerivAt_id' x).const_mul (2 * κ)).exp
      have h2 := (hexp.mul (h1.sub (hΦd x))).const_mul (-(1 - e)⁻¹)
      refine h2.congr_deriv ?_
      have hab : Real.exp (2 * κ * x) * Real.exp (-(2 * κ) * x) = 1 := by
        rw [← Real.exp_add]; simp
      have hsh : Real.exp (-(2 * κ) * (x + 1)) = e * Real.exp (-(2 * κ) * x) := by
        rw [he, ← Real.exp_add]; congr 1; ring
      simp only [Pi.sub_apply]
      rw [hE, hE, hfp x, hsh]
      linear_combination (-(1 - e)⁻¹ * (e - 1) * f x) * hab + f x * hc
  · intro v hvp hv
    have hvc : Continuous v := continuous_iff_continuousAt.2 fun x => (hv x).continuousAt
    
    have formula : ∀ x, v x = -(1 - e)⁻¹ * ∫ y in x..(x + 1), Real.exp (-(2 * κ) * (y - x)) * f y := by
      intro x
      have hg : ∀ y, HasDerivAt (fun y => Real.exp (-(2 * κ) * (y - x)) * v y)
          (Real.exp (-(2 * κ) * (y - x)) * f y) y := by
        intro y
        have h1 : HasDerivAt (fun y => -(2 * κ) * (y - x)) (-(2 * κ) * 1) y :=
          ((hasDerivAt_id' y).sub_const x).const_mul (-(2 * κ))
        have h2 := (h1.exp).mul (hv y)
        refine h2.congr_deriv ?_
        ring
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun y _ => hg y)
        (by apply Continuous.intervalIntegrable; fun_prop)]
      have e1 : x + 1 - x = 1 := by ring
      rw [e1, sub_self, mul_zero, Real.exp_zero, one_mul, hvp x, mul_one]
      linear_combination (-v x) * hc
    
    have energy : 2 * κ * (∫ x in (0:ℝ)..1, v x ^ 2) + (∫ x in (0:ℝ)..1, f x * v x) = 0 := by
      have hg : ∀ y, HasDerivAt (fun y => v y * v y) (4 * κ * v y ^ 2 + 2 * (f y * v y)) y := by
        intro y
        refine ((hv y).mul (hv y)).congr_deriv ?_
        ring
      have hint := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := 0) (b := 1)
        (fun y _ => hg y) (by apply Continuous.intervalIntegrable; fun_prop)
      have hv1 : v 1 = v 0 := by simpa using hvp 0
      rw [hv1, sub_self, intervalIntegral.integral_add, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul] at hint
      · linarith
      all_goals (apply Continuous.intervalIntegrable; fun_prop)
    have hI0 : 0 ≤ ∫ y in (0:ℝ)..1, |f y| :=
      intervalIntegral.integral_nonneg (by norm_num) (fun y _ => abs_nonneg _)
    have sup : ∀ x, |v x| ≤ 2 * ∫ y in (0:ℝ)..1, |f y| := by
      intro x
      rw [formula x]
      have hJ : |∫ y in x..(x + 1), Real.exp (-(2 * κ) * (y - x)) * f y| ≤
          ∫ y in (0:ℝ)..1, |f y| := by
        refine le_trans (intervalIntegral.abs_integral_le_integral_abs (by linarith)) ?_
        have hper : ∫ y in x..(x + 1), |f y| = ∫ y in (0:ℝ)..1, |f y| := by
          have := Function.Periodic.intervalIntegral_add_eq (f := fun y => |f y|) (T := 1)
            (fun y => by simp only [hfp y]) x 0
          simpa using this
        rw [← hper]
        refine intervalIntegral.integral_mono_on (by linarith)
          (by apply Continuous.intervalIntegrable; fun_prop)
          (by apply Continuous.intervalIntegrable; fun_prop) ?_
        intro y hy
        rw [abs_mul, abs_of_pos (Real.exp_pos _)]
        have : Real.exp (-(2 * κ) * (y - x)) ≤ 1 := by
          rw [Real.exp_le_one_iff]; nlinarith [hy.1]
        exact mul_le_of_le_one_left (abs_nonneg _) this
      rw [abs_mul, abs_neg, abs_of_pos hc_pos]
      have := abs_nonneg (∫ y in x..(x + 1), Real.exp (-(2 * κ) * (y - x)) * f y)
      nlinarith
    refine ⟨formula, sup, ?_, ?_⟩
    · have hsq : 0 ≤ ∫ x in (0:ℝ)..1, (2 * κ * v x + f x) ^ 2 :=
        intervalIntegral.integral_nonneg (by norm_num) (fun y _ => sq_nonneg _)
      have hexp : (∫ x in (0:ℝ)..1, (2 * κ * v x + f x) ^ 2) =
          4 * κ ^ 2 * (∫ x in (0:ℝ)..1, v x ^ 2) + 4 * κ * (∫ x in (0:ℝ)..1, f x * v x) +
            ∫ x in (0:ℝ)..1, f x ^ 2 := by
        have e1 : (fun x => (2 * κ * v x + f x) ^ 2) =
            fun x => (4 * κ ^ 2 * v x ^ 2 + 4 * κ * (f x * v x)) + f x ^ 2 := by
          funext x; ring
        rw [e1, intervalIntegral.integral_add, intervalIntegral.integral_add,
          intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
        all_goals (apply Continuous.intervalIntegrable; fun_prop)
      rw [le_div_iff₀ (by positivity)]
      have hE' : 4 * κ * (∫ x in (0:ℝ)..1, f x * v x) =
          -(8 * κ ^ 2 * (∫ x in (0:ℝ)..1, v x ^ 2)) := by
        linear_combination 4 * κ * energy
      linarith
    · have hP : -(∫ x in (0:ℝ)..1, f x * v x) ≤
          (∫ x in (0:ℝ)..1, |f x|) * (2 * ∫ y in (0:ℝ)..1, |f y|) := by
        rw [← intervalIntegral.integral_neg, ← intervalIntegral.integral_mul_const]
        refine intervalIntegral.integral_mono_on (by norm_num)
          (by apply Continuous.intervalIntegrable; fun_prop)
          (by apply Continuous.intervalIntegrable; fun_prop) ?_
        intro y _
        calc -(f y * v y) ≤ |f y * v y| := neg_le_abs _
          _ = |f y| * |v y| := abs_mul _ _
          _ ≤ |f y| * (2 * ∫ y in (0:ℝ)..1, |f y|) :=
            mul_le_mul_of_nonneg_left (sup y) (abs_nonneg _)
      rw [le_div_iff₀ hκpos]
      nlinarith

theorem periodic_resolvent_parseval_T : ∀ (κ : ℝ), 1 ≤ κ → ∀ (q : CinfT) (v : ℝ → ℝ), Function.Periodic v 1 → (∀ x, HasDerivAt v (2 * κ * v x + (q : ℝ → ℝ) x) x) → (∫ x in (0:ℝ)..1, v x ^ 2) = ∑' n : ℤ, ((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * κ ^ 2)) * ‖((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2 :=
by
  intro κ hκ q v hper hder
  have hqc : Continuous (q : ℝ → ℝ) := q.2.1.continuous
  have hvc : Continuous v := continuous_iff_continuousAt.2 fun x => (hder x).continuousAt
  have hab : (0:ℝ) < 1 := zero_lt_one
  
  have hpars : HasSum (fun n : ℤ => ‖fourierCircle v n‖ ^ 2) (∫ x in (0:ℝ)..1, v x ^ 2) := by
    have hFc : Continuous (fun x : ℝ => (v x : ℂ)) := Complex.continuous_ofReal.comp hvc
    have hid : ∀ n : ℤ, fourierCoeffOn hab (fun x : ℝ => (v x : ℂ)) n = fourierCircle v n := by
      intro n
      rw [fourierCoeffOn_eq_integral]
      unfold fourierCircle
      rw [sub_zero, div_one, one_smul]
      apply intervalIntegral.integral_congr
      intro x _
      simp only [fourier_coe_apply, smul_eq_mul]
      congr 2
      push_cast
      ring
    have hL2 : MemLp (fun x : ℝ => (v x : ℂ)) 2 (volume.restrict (Set.Ioc (0:ℝ) 1)) := by
      haveI : IsFiniteMeasure (volume.restrict (Set.Ioc (0:ℝ) 1)) :=
        isFiniteMeasure_restrict.2 measure_Ioc_lt_top.ne
      obtain ⟨C, hC⟩ := IsCompact.exists_bound_of_continuousOn (isCompact_Icc (a := (0:ℝ)) (b := 1))
        hFc.continuousOn
      refine MemLp.of_bound hFc.aestronglyMeasurable C ?_
      filter_upwards [ae_restrict_mem measurableSet_Ioc] with x hx
      exact hC x (Set.Ioc_subset_Icc_self hx)
    have h := hasSum_sq_fourierCoeffOn hab hL2
    have hval : ((1:ℝ) - 0)⁻¹ • (∫ x in (0:ℝ)..1, ‖(v x : ℂ)‖ ^ 2) = ∫ x in (0:ℝ)..1, v x ^ 2 := by
      simp only [sub_zero, inv_one, one_smul, Complex.norm_real, Real.norm_eq_abs, sq_abs]
    rw [hval] at h
    simpa only [hid] using h
  
  have hres : ∀ n : ℤ, fourierCircle (q : ℝ → ℝ) n =
      (((2 * π * n : ℝ) : ℂ) * I - 2 * (κ : ℂ)) * fourierCircle v n := by
    intro n
    set c : ℂ := ((2 * π * n : ℝ) : ℂ) with hc
    set e : ℝ → ℂ := fun x => Complex.exp (-(c * (x : ℂ)) * I) with he
    have hed : ∀ x : ℝ, HasDerivAt e (e x * (-c * I)) x := by
      intro x
      have h1 : HasDerivAt (fun y : ℝ => (y : ℂ)) 1 x := (hasDerivAt_id x).ofReal_comp
      have h2 : HasDerivAt (fun y : ℝ => -(c * (y : ℂ)) * I) (-(c * 1) * I) x :=
        ((h1.const_mul c).neg).mul_const I
      have h3 := h2.cexp
      convert h3 using 1
      simp only [he]
      ring
    have hVd : ∀ x : ℝ, HasDerivAt (fun y => (v y : ℂ))
        (((2 * κ * v x + (q : ℝ → ℝ) x : ℝ)) : ℂ) x := fun x => (hder x).ofReal_comp
    have hec : Continuous e := by
      simp only [he]
      fun_prop
    have hV'c : Continuous (fun x : ℝ => (((2 * κ * v x + (q : ℝ → ℝ) x : ℝ)) : ℂ)) :=
      Complex.continuous_ofReal.comp ((continuous_const.mul hvc).add hqc)
    have hibp := intervalIntegral.integral_mul_deriv_eq_deriv_mul (a := (0:ℝ)) (b := 1)
      (fun x _ => hed x) (fun x _ => hVd x)
      ((hec.mul continuous_const).intervalIntegrable _ _) (hV'c.intervalIntegrable _ _)
    have he0 : e 0 = 1 := by simp [he]
    have he1 : e 1 = 1 := by
      simp only [he]
      have : -(c * ((1:ℝ) : ℂ)) * I = ((-n : ℤ) : ℂ) * (2 * π * I) := by
        rw [hc]; push_cast; ring
      rw [this]
      exact Complex.exp_int_mul_two_pi_mul_I (-n)
    have hv1 : ((v 1 : ℝ) : ℂ) = ((v 0 : ℝ) : ℂ) := by rw [hper.eq]
    have hFv : fourierCircle v n = ∫ x in (0:ℝ)..1, e x * (v x : ℂ) := rfl
    have hFq : fourierCircle (q : ℝ → ℝ) n = ∫ x in (0:ℝ)..1, e x * ((q : ℝ → ℝ) x : ℂ) := rfl
    have hsplit : (∫ x in (0:ℝ)..1, e x * (((2 * κ * v x + (q : ℝ → ℝ) x : ℝ)) : ℂ)) =
        2 * (κ : ℂ) * fourierCircle v n + fourierCircle (q : ℝ → ℝ) n := by
      rw [hFv, hFq, ← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_add]
      · apply intervalIntegral.integral_congr
        intro x _
        simp only
        push_cast
        ring
      · exact (continuous_const.mul (hec.mul (Complex.continuous_ofReal.comp hvc))).intervalIntegrable _ _
      · exact (hec.mul (Complex.continuous_ofReal.comp hqc)).intervalIntegrable _ _
    have hright : (∫ x in (0:ℝ)..1, e x * (-c * I) * (v x : ℂ)) = (-c * I) * fourierCircle v n := by
      rw [hFv, ← intervalIntegral.integral_const_mul]
      apply intervalIntegral.integral_congr
      intro x _
      simp only
      ring
    simp only at hibp
    rw [hsplit, hright, he0, he1] at hibp
    linear_combination hibp + hv1
  
  have hterm : ∀ n : ℤ, ‖hm1ProfileT (q : ℝ → ℝ) n‖ ^ 2 =
      ((2 * π * n) ^ 2 + 4 * κ ^ 2) / (4 + (2 * π * n) ^ 2) * ‖fourierCircle v n‖ ^ 2 := by
    intro n
    have ha : 0 < 4 + (2 * π * (n:ℝ)) ^ 2 := by positivity
    have hz : ‖((2 * π * n : ℝ) : ℂ) * I - 2 * (κ : ℂ)‖ ^ 2 = (2 * π * n) ^ 2 + 4 * κ ^ 2 := by
      rw [Complex.sq_norm]
      have : ((2 * π * n : ℝ) : ℂ) * I - 2 * (κ : ℂ) =
          ((-2 * κ : ℝ) : ℂ) + ((2 * π * n : ℝ) : ℂ) * I := by push_cast; ring
      rw [this, Complex.normSq_add_mul_I]
      ring
    unfold hm1ProfileT
    rw [hres n, norm_mul, norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.sqrt_nonneg _),
      show ∀ a b d : ℝ, (a⁻¹ * (b * d)) ^ 2 = (a ^ 2)⁻¹ * (b ^ 2 * d ^ 2) from
        fun a b d => by ring,
      Real.sq_sqrt ha.le, hz]
    field_simp
  
  have hmem : Memℓp (hm1ProfileT (q : ℝ → ℝ)) 2 := by
    have hp : (0 : ℝ) < (2 : ENNReal).toReal := by norm_num
    refine (memℓp_gen_iff hp).2 ?_
    simp only [ENNReal.toReal_ofNat, Real.rpow_two]
    refine Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_)
      (hpars.summable.mul_left (κ ^ 2))
    rw [hterm n]
    have ha : 0 < 4 + (2 * π * (n:ℝ)) ^ 2 := by positivity
    have hle : ((2 * π * n) ^ 2 + 4 * κ ^ 2) / (4 + (2 * π * n) ^ 2) ≤ κ ^ 2 := by
      rw [div_le_iff₀ ha]
      have hk2 : 1 ≤ κ ^ 2 := by nlinarith
      nlinarith [sq_nonneg (2 * π * (n:ℝ))]
    exact mul_le_mul_of_nonneg_right hle (sq_nonneg _)
  have hcoe : ∀ n : ℤ, ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n = hm1ProfileT (q : ℝ → ℝ) n := by
    intro n
    show toHm1T q n = _
    unfold toHm1T
    rw [dif_pos hmem]
  
  rw [← hpars.tsum_eq]
  apply tsum_congr
  intro n
  rw [hcoe n, hterm n]
  have ha : 0 < 4 + (2 * π * (n:ℝ)) ^ 2 := by positivity
  have hb : 0 < (2 * π * (n:ℝ)) ^ 2 + 4 * κ ^ 2 := by nlinarith [sq_nonneg (2 * π * (n:ℝ))]
  field_simp

theorem periodic_picard_iterates_T : ∀ (κ : ℝ), 1 ≤ κ → ∀ (q : ℝ → ℝ), Continuous q → Function.Periodic q 1 → ∃ w : ℕ → ℝ → ℝ, w 0 = 0 ∧ (∀ j, Continuous (w j)) ∧ (∀ j, Function.Periodic (w j) 1) ∧ (∀ j x, HasDerivAt (w (j + 1)) (q x + 2 * κ * w (j + 1) x - w j x ^ 2) x) :=
by
  intro κ hκ q hq hqper
  classical
  have hstep : ∀ g : ℝ → ℝ, Continuous g → Function.Periodic g 1 →
      ∃ v : ℝ → ℝ, Continuous v ∧ Function.Periodic v 1 ∧
        ∀ x, HasDerivAt v (q x + 2 * κ * v x - g x ^ 2) x := by
    intro g hg hgp
    have hf : Continuous (fun x => q x - g x ^ 2) := hq.sub (hg.pow 2)
    have hfp : Function.Periodic (fun x => q x - g x ^ 2) 1 := fun x => by
      show q (x + 1) - g (x + 1) ^ 2 = q x - g x ^ 2
      rw [hqper x, hgp x]
    obtain ⟨v, hvp, hvd⟩ := (periodic_resolvent_T κ hκ _ hf hfp).1
    refine ⟨v, continuous_iff_continuousAt.2 fun x => (hvd x).continuousAt, hvp, fun x => ?_⟩
    exact (hvd x).congr_deriv (by ring)
  obtain ⟨S, hS⟩ : ∃ S : (ℝ → ℝ) → (ℝ → ℝ), ∀ g (h : Continuous g ∧ Function.Periodic g 1),
      S g = Classical.choose (hstep g h.1 h.2) :=
    ⟨fun g => if h : Continuous g ∧ Function.Periodic g 1 then
      Classical.choose (hstep g h.1 h.2) else 0, fun g h => dif_pos h⟩
  have hSspec : ∀ g, Continuous g → Function.Periodic g 1 →
      Continuous (S g) ∧ Function.Periodic (S g) 1 ∧
        ∀ x, HasDerivAt (S g) (q x + 2 * κ * S g x - g x ^ 2) x := by
    intro g hg hgp
    rw [hS g ⟨hg, hgp⟩]
    exact Classical.choose_spec (hstep g hg hgp)
  obtain ⟨w, hw⟩ : ∃ w : ℕ → ℝ → ℝ, w = fun j => S^[j] 0 := ⟨_, rfl⟩
  have hw0 : w 0 = 0 := by rw [hw]; rfl
  have hws : ∀ j, w (j + 1) = S (w j) := by
    intro j
    rw [hw]
    exact Function.iterate_succ_apply' S j 0
  have hP : ∀ j, Continuous (w j) ∧ Function.Periodic (w j) 1 := by
    intro j
    induction j with
    | zero =>
      rw [hw0]
      exact ⟨continuous_const, fun x => rfl⟩
    | succ n ih =>
      rw [hws]
      exact ⟨(hSspec _ ih.1 ih.2).1, (hSspec _ ih.1 ih.2).2.1⟩
  refine ⟨w, hw0, fun j => (hP j).1, fun j => (hP j).2, fun j x => ?_⟩
  rw [hws]
  exact (hSspec _ (hP j).1 (hP j).2).2.2 x

theorem periodic_picard_bounds_T : ∀ (κ : ℝ), 1 ≤ κ → ∀ (q v : ℝ → ℝ) (w : ℕ → ℝ → ℝ), Function.Periodic v 1 → (∀ x, HasDerivAt v (2 * κ * v x + q x) x) → (∫ x in (0:ℝ)..1, v x ^ 2) ≤ κ / 1024 → w 0 = 0 → (∀ j, Continuous (w j)) → (∀ j, Function.Periodic (w j) 1) → (∀ j x, HasDerivAt (w (j + 1)) (q x + 2 * κ * w (j + 1) x - w j x ^ 2) x) → (∀ j, (∫ x in (0:ℝ)..1, w j x ^ 2) ≤ 4 * ∫ x in (0:ℝ)..1, v x ^ 2) ∧ (∀ j x, |w (j + 2) x - w (j + 1) x| ≤ 8 * (∫ x in (0:ℝ)..1, v x ^ 2) * (1 / 8) ^ j) :=
by
  intro κ hκ q v w hvper hvd hv hw0 hwc hwper hwd
  have hκ0 : 0 < κ := by linarith
  have hvc : Continuous v := continuous_iff_continuousAt.2 fun x => (hvd x).continuousAt
  obtain ⟨a2, ha2⟩ : ∃ a2 : ℝ, (∫ x in (0:ℝ)..1, v x ^ 2) = a2 := ⟨_, rfl⟩
  rw [ha2] at hv ⊢
  have ha0 : 0 ≤ a2 := by
    rw [← ha2]; exact intervalIntegral.integral_nonneg (by norm_num) (fun x _ => sq_nonneg _)
  have hstar : 1024 * a2 ≤ κ := by linarith
  have hw0x : ∀ x, w 0 x = 0 := fun x => by rw [hw0]; rfl
  
  have hom : ∀ d : ℝ → ℝ, Function.Periodic d 1 → (∀ x, HasDerivAt d (2 * κ * d x) x) →
      ∀ x, d x = 0 := by
    intro d hdp hdd x
    have hf : Continuous (fun _ : ℝ => (0:ℝ)) := continuous_const
    have hfp : Function.Periodic (fun _ : ℝ => (0:ℝ)) 1 := fun _ => rfl
    have hdd' : ∀ x, HasDerivAt d (2 * κ * d x + (fun _ : ℝ => (0:ℝ)) x) x := fun x => by
      simpa using hdd x
    obtain ⟨-, hsup, -, -⟩ := (periodic_resolvent_T κ hκ _ hf hfp).2 d hdp hdd'
    have h := hsup x
    simpa using h
  
  have energy : ∀ a b : ℝ → ℝ, Continuous a → Continuous b → Function.Periodic a 1 →
      Function.Periodic b 1 →
      (∀ x, HasDerivAt (fun y => b y - v y) (2 * κ * (b x - v x) + -(a x ^ 2)) x) →
      (∫ x in (0:ℝ)..1, a x ^ 2) ≤ 4 * a2 → (∫ x in (0:ℝ)..1, b x ^ 2) ≤ 4 * a2 := by
    intro a b ha hb hap hbp hd hA
    have hf : Continuous (fun y => -(a y ^ 2)) := (ha.pow 2).neg
    have hfp : Function.Periodic (fun y => -(a y ^ 2)) 1 := fun y => by
      show -(a (y + 1) ^ 2) = -(a y ^ 2)
      rw [hap y]
    have hdp : Function.Periodic (fun y => b y - v y) 1 := fun y => by
      show b (y + 1) - v (y + 1) = b y - v y
      rw [hbp y, hvper y]
    obtain ⟨-, -, -, hR5⟩ := (periodic_resolvent_T κ hκ _ hf hfp).2 _ hdp hd
    have hR5' : (∫ x in (0:ℝ)..1, (b x - v x) ^ 2) ≤
        (∫ x in (0:ℝ)..1, |-(a x ^ 2)|) ^ 2 / κ := hR5
    have habs : (∫ x in (0:ℝ)..1, |-(a x ^ 2)|) = ∫ x in (0:ℝ)..1, a x ^ 2 := by
      congr 1; funext x; rw [abs_neg, abs_of_nonneg (sq_nonneg _)]
    rw [habs] at hR5'
    have hAa0 : 0 ≤ ∫ x in (0:ℝ)..1, a x ^ 2 :=
      intervalIntegral.integral_nonneg (by norm_num) (fun x _ => sq_nonneg _)
    have hd2 : (∫ x in (0:ℝ)..1, (b x - v x) ^ 2) ≤ a2 / 64 := by
      refine le_trans hR5' ?_
      rw [div_le_iff₀ hκ0]
      have h1 : (∫ x in (0:ℝ)..1, a x ^ 2) ^ 2 ≤ (4 * a2) ^ 2 := pow_le_pow_left₀ hAa0 hA 2
      nlinarith [mul_le_mul_of_nonneg_left hstar ha0]
    have hpt : (∫ x in (0:ℝ)..1, b x ^ 2) ≤
        ∫ x in (0:ℝ)..1, (2 * v x ^ 2 + 2 * (b x - v x) ^ 2) :=
      intervalIntegral.integral_mono_on (by norm_num) ((hb.pow 2).intervalIntegrable _ _)
        (by apply Continuous.intervalIntegrable; fun_prop)
        (fun x _ => by nlinarith [sq_nonneg (b x - 2 * v x)])
    have hsplit : (∫ x in (0:ℝ)..1, (2 * v x ^ 2 + 2 * (b x - v x) ^ 2)) =
        2 * (∫ x in (0:ℝ)..1, v x ^ 2) + 2 * ∫ x in (0:ℝ)..1, (b x - v x) ^ 2 := by
      rw [intervalIntegral.integral_add, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul]
      all_goals (apply Continuous.intervalIntegrable; fun_prop)
    linarith
  
  have contr : ∀ (A : ℝ) (a b c : ℝ → ℝ), Continuous a → Continuous b → Continuous c →
      Function.Periodic a 1 → Function.Periodic b 1 → Function.Periodic c 1 →
      (∀ x, HasDerivAt (fun y => c y - b y) (2 * κ * (c x - b x) + (a x ^ 2 - b x ^ 2)) x) →
      (∫ x in (0:ℝ)..1, a x ^ 2) ≤ A → (∫ x in (0:ℝ)..1, b x ^ 2) ≤ A →
      (∫ x in (0:ℝ)..1, (c x - b x) ^ 2) ≤ (∫ x in (0:ℝ)..1, (b x - a x) ^ 2) * (4 * A) / κ ∧
      ∀ x, (c x - b x) ^ 2 ≤ 4 * ((∫ x in (0:ℝ)..1, (b x - a x) ^ 2) * (4 * A)) := by
    intro A a b c ha hb hc hap hbp hcp hd hA hB
    have hf : Continuous (fun y => a y ^ 2 - b y ^ 2) := (ha.pow 2).sub (hb.pow 2)
    have hfp : Function.Periodic (fun y => a y ^ 2 - b y ^ 2) 1 := fun y => by
      show a (y + 1) ^ 2 - b (y + 1) ^ 2 = a y ^ 2 - b y ^ 2
      rw [hap y, hbp y]
    have hep : Function.Periodic (fun y => c y - b y) 1 := fun y => by
      show c (y + 1) - b (y + 1) = c y - b y
      rw [hcp y, hbp y]
    obtain ⟨-, hsup, -, hR5⟩ := (periodic_resolvent_T κ hκ _ hf hfp).2 _ hep hd
    have hsup' : ∀ x, |c x - b x| ≤ 2 * ∫ y in (0:ℝ)..1, |a y ^ 2 - b y ^ 2| := hsup
    have hR5' : (∫ x in (0:ℝ)..1, (c x - b x) ^ 2) ≤
        (∫ x in (0:ℝ)..1, |a x ^ 2 - b x ^ 2|) ^ 2 / κ := hR5
    have hI : (∫ x in (0:ℝ)..1, |a x ^ 2 - b x ^ 2|) =
        ∫ x in (0:ℝ)..1, |b x - a x| * |b x + a x| := by
      congr 1; funext x
      have e : a x ^ 2 - b x ^ 2 = -((b x - a x) * (b x + a x)) := by ring
      rw [e, abs_neg, abs_mul]
    have hCS : (∫ x in (0:ℝ)..1, |b x - a x| * |b x + a x|) ^ 2 ≤
        (∫ x in (0:ℝ)..1, |b x - a x| ^ 2) * (∫ x in (0:ℝ)..1, |b x + a x| ^ 2) :=
      cauchy_schwarz_unit_interval (fun y => |b y - a y|) (fun y => |b y + a y|)
        (hb.sub ha).abs (hb.add ha).abs
    simp only [sq_abs] at hCS
    have hS : (∫ x in (0:ℝ)..1, (b x + a x) ^ 2) ≤ 4 * A := by
      have h1 : (∫ x in (0:ℝ)..1, (b x + a x) ^ 2) ≤
          ∫ x in (0:ℝ)..1, (2 * b x ^ 2 + 2 * a x ^ 2) :=
        intervalIntegral.integral_mono_on (by norm_num)
          (by apply Continuous.intervalIntegrable; fun_prop)
          (by apply Continuous.intervalIntegrable; fun_prop)
          (fun x _ => by nlinarith [sq_nonneg (b x - a x)])
      have h2 : (∫ x in (0:ℝ)..1, (2 * b x ^ 2 + 2 * a x ^ 2)) =
          2 * (∫ x in (0:ℝ)..1, b x ^ 2) + 2 * ∫ x in (0:ℝ)..1, a x ^ 2 := by
        rw [intervalIntegral.integral_add, intervalIntegral.integral_const_mul,
          intervalIntegral.integral_const_mul]
        all_goals (apply Continuous.intervalIntegrable; fun_prop)
      linarith
    have hD0 : 0 ≤ ∫ x in (0:ℝ)..1, (b x - a x) ^ 2 :=
      intervalIntegral.integral_nonneg (by norm_num) (fun x _ => sq_nonneg _)
    have hI2 : (∫ x in (0:ℝ)..1, |b x - a x| * |b x + a x|) ^ 2 ≤
        (∫ x in (0:ℝ)..1, (b x - a x) ^ 2) * (4 * A) :=
      le_trans hCS (mul_le_mul_of_nonneg_left hS hD0)
    rw [hI] at hsup' hR5'
    refine ⟨le_trans hR5' (div_le_div_of_nonneg_right hI2 hκ0.le), fun x => ?_⟩
    have h1 := hsup' x
    have h2 : |c x - b x| ^ 2 ≤ (2 * ∫ y in (0:ℝ)..1, |b y - a y| * |b y + a y|) ^ 2 :=
      pow_le_pow_left₀ (abs_nonneg _) h1 2
    rw [sq_abs] at h2
    nlinarith
  
  have hdv : ∀ j x, HasDerivAt (fun y => w (j + 1) y - v y)
      (2 * κ * (w (j + 1) x - v x) + -(w j x ^ 2)) x := by
    intro j x
    have h := (hwd j x).sub (hvd x)
    have e : (q x + 2 * κ * w (j + 1) x - w j x ^ 2) - (2 * κ * v x + q x) =
        2 * κ * (w (j + 1) x - v x) + -(w j x ^ 2) := by ring
    rw [e] at h
    exact h
  have hdw : ∀ j x, HasDerivAt (fun y => w (j + 2) y - w (j + 1) y)
      (2 * κ * (w (j + 2) x - w (j + 1) x) + (w j x ^ 2 - w (j + 1) x ^ 2)) x := by
    intro j x
    have h := (hwd (j + 1) x).sub (hwd j x)
    have e : (q x + 2 * κ * w (j + 1 + 1) x - w (j + 1) x ^ 2) -
        (q x + 2 * κ * w (j + 1) x - w j x ^ 2) =
        2 * κ * (w (j + 2) x - w (j + 1) x) + (w j x ^ 2 - w (j + 1) x ^ 2) := by ring
    rw [e] at h
    exact h
  
  have hw1 : ∀ x, w 1 x = v x := by
    intro x
    have hp : Function.Periodic (fun y => w 1 y - v y) 1 := fun y => by
      show w 1 (y + 1) - v (y + 1) = w 1 y - v y
      rw [hwper 1 y, hvper y]
    have hd : ∀ y, HasDerivAt (fun y => w 1 y - v y) (2 * κ * (w 1 y - v y)) y := by
      intro y
      have h : HasDerivAt (fun y => w 1 y - v y)
          (2 * κ * (w 1 y - v y) + -(w 0 y ^ 2)) y := hdv 0 y
      rw [hw0x y] at h
      have e : 2 * κ * (w 1 y - v y) + -((0:ℝ) ^ 2) = 2 * κ * (w 1 y - v y) := by ring
      rw [e] at h
      exact h
    exact sub_eq_zero.1 (hom _ hp hd x)
  
  have hE : ∀ j, (∫ x in (0:ℝ)..1, w j x ^ 2) ≤ 4 * a2 := by
    intro j
    induction j with
    | zero =>
      have h0 : (∫ x in (0:ℝ)..1, w 0 x ^ 2) = 0 := by simp [hw0x]
      rw [h0]; linarith
    | succ j ih =>
      exact energy (w j) (w (j + 1)) (hwc j) (hwc (j + 1)) (hwper j) (hwper (j + 1)) (hdv j) ih
  
  have hD : ∀ j, (∫ x in (0:ℝ)..1, (w (j + 1) x - w j x) ^ 2) ≤ a2 * (1 / 64) ^ j := by
    intro j
    induction j with
    | zero =>
      show (∫ x in (0:ℝ)..1, (w 1 x - w 0 x) ^ 2) ≤ a2 * (1 / 64) ^ 0
      have h0 : (∫ x in (0:ℝ)..1, (w 1 x - w 0 x) ^ 2) = a2 := by
        rw [← ha2]; congr 1; funext x; rw [hw1 x, hw0x x, sub_zero]
      rw [h0]; simp
    | succ j ih =>
      have h : (∫ x in (0:ℝ)..1, (w (j + 1 + 1) x - w (j + 1) x) ^ 2) ≤
          (∫ x in (0:ℝ)..1, (w (j + 1) x - w j x) ^ 2) * (4 * (4 * a2)) / κ :=
        (contr (4 * a2) (w j) (w (j + 1)) (w (j + 2)) (hwc j) (hwc (j + 1)) (hwc (j + 2))
          (hwper j) (hwper (j + 1)) (hwper (j + 2)) (hdw j) (hE j) (hE (j + 1))).1
      have hDj0 : 0 ≤ ∫ x in (0:ℝ)..1, (w (j + 1) x - w j x) ^ 2 :=
        intervalIntegral.integral_nonneg (by norm_num) (fun x _ => sq_nonneg _)
      have h2 : (∫ x in (0:ℝ)..1, (w (j + 1) x - w j x) ^ 2) * (4 * (4 * a2)) / κ ≤
          (∫ x in (0:ℝ)..1, (w (j + 1) x - w j x) ^ 2) / 64 := by
        rw [div_le_div_iff₀ hκ0 (by norm_num)]
        nlinarith [mul_le_mul_of_nonneg_left hstar hDj0]
      have e : a2 * (1 / 64 : ℝ) ^ (j + 1) = a2 * (1 / 64) ^ j / 64 := by
        rw [pow_succ]; ring
      rw [e]
      linarith
  
  refine ⟨hE, fun j x => ?_⟩
  have h : (w (j + 2) x - w (j + 1) x) ^ 2 ≤
      4 * ((∫ x in (0:ℝ)..1, (w (j + 1) x - w j x) ^ 2) * (4 * (4 * a2))) :=
    (contr (4 * a2) (w j) (w (j + 1)) (w (j + 2)) (hwc j) (hwc (j + 1)) (hwc (j + 2))
      (hwper j) (hwper (j + 1)) (hwper (j + 2)) (hdw j) (hE j) (hE (j + 1))).2 x
  have hDj := hD j
  have hpow : ((1:ℝ) / 64) ^ j = ((1 / 8 : ℝ) ^ j) ^ 2 := by
    rw [← pow_mul, mul_comm j 2, pow_mul]; norm_num
  rw [hpow] at hDj
  have hb : 0 ≤ 8 * a2 * (1 / 8 : ℝ) ^ j := by positivity
  apply abs_le_of_sq_le_sq _ hb
  nlinarith [mul_le_mul_of_nonneg_left hDj ha0]

theorem periodic_riccati_limit_T : ∀ (κ : ℝ), 1 ≤ κ → ∀ (B : ℝ) (q : ℝ → ℝ) (w : ℕ → ℝ → ℝ), Continuous q → Function.Periodic q 1 → (∀ j, Continuous (w j)) → (∀ j, Function.Periodic (w j) 1) → (∀ j x, HasDerivAt (w (j + 1)) (q x + 2 * κ * w (j + 1) x - w j x ^ 2) x) → (∀ j x, |w (j + 2) x - w (j + 1) x| ≤ B * (1 / 8) ^ j) → ∃ W : ℝ → ℝ, Function.Periodic W 1 ∧ (∀ x, HasDerivAt W (q x + 2 * κ * W x - W x ^ 2) x) ∧ ∀ A : ℝ, (∀ j, (∫ x in (0:ℝ)..1, w j x ^ 2) ≤ A) → (∫ x in (0:ℝ)..1, W x ^ 2) ≤ A :=
by
  intro κ _hκ B q w _hq _hqper hwc hwper hwd hgeo
  have hstep : ∀ x n, dist (w (n + 1) x) (w (n + 1 + 1) x) ≤ B * (1 / 8 : ℝ) ^ n := by
    intro x n
    rw [Real.dist_eq, abs_sub_comm]
    exact hgeo n x
  have hex : ∀ x, ∃ y, Filter.Tendsto (fun k => w (k + 1) x) Filter.atTop (nhds y) :=
    fun x => cauchySeq_tendsto_of_complete
      (cauchySeq_of_le_geometric (1 / 8 : ℝ) B (by norm_num) (hstep x))
  choose W hlim using hex
  obtain ⟨δ, hδdef⟩ : ∃ δ : ℕ → ℝ, δ = fun k => 8 / 7 * B * (1 / 8 : ℝ) ^ k := ⟨_, rfl⟩
  have hb : ∀ k x, |W x - w (k + 1) x| ≤ δ k := by
    intro k x
    have h := dist_le_of_le_geometric_of_tendsto (1 / 8 : ℝ) B (by norm_num) (hstep x) (hlim x) k
    rw [Real.dist_eq, abs_sub_comm] at h
    have e : B * (1 / 8 : ℝ) ^ k / (1 - 1 / 8) = 8 / 7 * B * (1 / 8 : ℝ) ^ k := by ring
    rw [hδdef]
    linarith
  have hδ0 : ∀ k, 0 ≤ δ k := fun k => le_trans (abs_nonneg _) (hb k 0)
  have hδ : Filter.Tendsto δ Filter.atTop (nhds 0) := by
    have := (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0:ℝ) ≤ 1 / 8)
      (by norm_num)).const_mul (8 / 7 * B)
    rw [mul_zero] at this
    rw [hδdef]
    exact this
  
  have hper : Function.Periodic W 1 := by
    intro x
    have h1 := hlim (x + 1)
    have e : (fun k => w (k + 1) (x + 1)) = (fun k => w (k + 1) x) :=
      funext fun k => hwper (k + 1) x
    rw [e] at h1
    exact tendsto_nhds_unique h1 (hlim x)
  
  obtain ⟨C, hC⟩ := isBounded_iff_forall_norm_le.1
    ((hwper 1).isBounded_of_continuous one_ne_zero (hwc 1))
  have hC' : ∀ x, |w 1 x| ≤ C := fun x => by
    have := hC (w 1 x) ⟨x, rfl⟩
    rwa [Real.norm_eq_abs] at this
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = C + δ 0 := ⟨_, rfl⟩
  have hM : ∀ x, |W x| ≤ M := by
    intro x
    have h0 := hb 0 x
    have h1 := abs_sub_abs_le_abs_sub (W x) (w (0 + 1) x)
    have h2 := hC' x
    rw [hMdef]
    linarith
  have hsum : ∀ n x, |W x + w (n + 1) x| ≤ 2 * M + δ n := by
    intro n x
    have e : W x + w (n + 1) x = 2 * W x - (W x - w (n + 1) x) := by ring
    rw [e]
    have h1 := abs_sub_le (2 * W x) 0 (W x - w (n + 1) x)
    simp only [sub_zero, zero_sub, abs_neg] at h1
    have h2 : |2 * W x| = 2 * |W x| := by rw [abs_mul, abs_two]
    linarith [hM x, hb n x]
  
  have key : ∀ n y, dist (q y + 2 * κ * W y - W y ^ 2)
      (q y + 2 * κ * w (n + 2) y - w (n + 1) y ^ 2) ≤
        2 * |κ| * δ (n + 1) + δ n * (2 * M + δ n) := by
    intro n y
    rw [Real.dist_eq]
    have ha : |W y - w (n + 2) y| ≤ δ (n + 1) := hb (n + 1) y
    have e : q y + 2 * κ * W y - W y ^ 2 - (q y + 2 * κ * w (n + 2) y - w (n + 1) y ^ 2) =
        2 * κ * (W y - w (n + 2) y) - (W y - w (n + 1) y) * (W y + w (n + 1) y) := by ring
    rw [e]
    have h1 := abs_sub_le (2 * κ * (W y - w (n + 2) y)) 0
      ((W y - w (n + 1) y) * (W y + w (n + 1) y))
    simp only [sub_zero, zero_sub, abs_neg] at h1
    have h2 : |2 * κ * (W y - w (n + 2) y)| = 2 * |κ| * |W y - w (n + 2) y| := by
      rw [abs_mul, abs_mul, abs_two]
    have h3 : |(W y - w (n + 1) y) * (W y + w (n + 1) y)| =
        |W y - w (n + 1) y| * |W y + w (n + 1) y| := abs_mul _ _
    have h4 : 2 * |κ| * |W y - w (n + 2) y| ≤ 2 * |κ| * δ (n + 1) :=
      mul_le_mul_of_nonneg_left ha (by positivity)
    have h5 : |W y - w (n + 1) y| * |W y + w (n + 1) y| ≤ δ n * (2 * M + δ n) :=
      mul_le_mul (hb n y) (hsum n y) (abs_nonneg _) (hδ0 n)
    linarith
  have hδ1 : Filter.Tendsto (fun n => δ (n + 1)) Filter.atTop (nhds 0) :=
    hδ.comp (Filter.tendsto_add_atTop_nat 1)
  have he : Filter.Tendsto (fun n => 2 * |κ| * δ (n + 1) + δ n * (2 * M + δ n))
      Filter.atTop (nhds 0) := by
    have := (hδ1.const_mul (2 * |κ|)).add (hδ.mul (hδ.const_add (2 * M)))
    have h0 : (2 * |κ| * 0 + 0 * (2 * M + 0) : ℝ) = 0 := by ring
    rw [h0] at this
    exact this
  have hW' : ∀ x, HasDerivAt W (q x + 2 * κ * W x - W x ^ 2) x := by
    intro x
    refine hasDerivAt_of_tendstoUniformly (l := Filter.atTop) (f := fun n => w (n + 2))
      (f' := fun n y => q y + 2 * κ * w (n + 2) y - w (n + 1) y ^ 2)
      (g' := fun y => q y + 2 * κ * W y - W y ^ 2) ?_ ?_ ?_ x
    · rw [Metric.tendstoUniformly_iff]
      intro ε hε
      filter_upwards [Filter.Tendsto.eventually_lt_const hε he] with n hn
      intro y
      exact lt_of_le_of_lt (key n y) hn
    · exact Filter.Eventually.of_forall fun n y => hwd (n + 1) y
    · intro y
      exact (hlim y).comp (Filter.tendsto_add_atTop_nat 1)
  have hWc : Continuous W := continuous_iff_continuousAt.2 fun x => (hW' x).continuousAt
  refine ⟨W, hper, hW', fun A hA => ?_⟩
  have hpt : ∀ n x, W x ^ 2 ≤ w (n + 1) x ^ 2 + δ n * (2 * M + δ n) := by
    intro n x
    have e : W x ^ 2 - w (n + 1) x ^ 2 = (W x - w (n + 1) x) * (W x + w (n + 1) x) := by ring
    have h2 : (W x - w (n + 1) x) * (W x + w (n + 1) x) ≤ δ n * (2 * M + δ n) := by
      calc (W x - w (n + 1) x) * (W x + w (n + 1) x)
          ≤ |(W x - w (n + 1) x) * (W x + w (n + 1) x)| := le_abs_self _
        _ = |W x - w (n + 1) x| * |W x + w (n + 1) x| := abs_mul _ _
        _ ≤ δ n * (2 * M + δ n) := mul_le_mul (hb n x) (hsum n x) (abs_nonneg _) (hδ0 n)
    linarith
  have hint : ∀ n, (∫ x in (0:ℝ)..1, W x ^ 2) ≤ A + δ n * (2 * M + δ n) := by
    intro n
    have hi1 : IntervalIntegrable (fun x => w (n + 1) x ^ 2) MeasureTheory.volume 0 1 :=
      ((hwc (n + 1)).pow 2).intervalIntegrable _ _
    calc (∫ x in (0:ℝ)..1, W x ^ 2)
        ≤ ∫ x in (0:ℝ)..1, (w (n + 1) x ^ 2 + δ n * (2 * M + δ n)) :=
          intervalIntegral.integral_mono_on (by norm_num) ((hWc.pow 2).intervalIntegrable _ _)
            ((((hwc (n + 1)).pow 2).add continuous_const).intervalIntegrable _ _)
            (fun x _ => hpt n x)
      _ = (∫ x in (0:ℝ)..1, w (n + 1) x ^ 2) + δ n * (2 * M + δ n) := by
          rw [intervalIntegral.integral_add hi1 intervalIntegrable_const]
          simp
      _ ≤ A + δ n * (2 * M + δ n) := by linarith [hA (n + 1)]
  have hc : Filter.Tendsto (fun n => A + δ n * (2 * M + δ n)) Filter.atTop (nhds A) := by
    have := (hδ.mul (hδ.const_add (2 * M))).const_add A
    rw [zero_mul, add_zero] at this
    exact this
  exact ge_of_tendsto' hc hint

theorem periodic_riccati_compare_T : ∀ (κ : ℝ), 1 ≤ κ → ∀ (q v w : ℝ → ℝ), Function.Periodic v 1 → (∀ x, HasDerivAt v (2 * κ * v x + q x) x) → (∫ x in (0:ℝ)..1, v x ^ 2) ≤ κ / 1024 → Function.Periodic w 1 → (∀ x, HasDerivAt w (q x + 2 * κ * w x - w x ^ 2) x) → (∫ x in (0:ℝ)..1, w x ^ 2) ≤ 4 * (∫ x in (0:ℝ)..1, v x ^ 2) → 3 / 4 * (∫ x in (0:ℝ)..1, v x ^ 2) ≤ (∫ x in (0:ℝ)..1, w x ^ 2) ∧ (∫ x in (0:ℝ)..1, w x ^ 2) ≤ 81 / 64 * (∫ x in (0:ℝ)..1, v x ^ 2) :=
by
  intro κ hκ q v w hvper hv hA hwper hw hBA
  have hκpos : (0:ℝ) < κ := by linarith
  have hvc : Continuous v := continuous_iff_continuousAt.2 fun x => (hv x).continuousAt
  have hwc : Continuous w := continuous_iff_continuousAt.2 fun x => (hw x).continuousAt
  have hfc : Continuous (fun x => -(w x ^ 2)) := (hwc.pow 2).neg
  have hfp : Function.Periodic (fun x => -(w x ^ 2)) 1 := fun x => by
    show -(w (x + 1) ^ 2) = -(w x ^ 2)
    rw [hwper x]
  have hdp : Function.Periodic (fun x => w x - v x) 1 := fun x => by
    show w (x + 1) - v (x + 1) = w x - v x
    rw [hwper x, hvper x]
  have hdd : ∀ x, HasDerivAt (fun y => w y - v y)
      (2 * κ * (fun y => w y - v y) x + (fun y => -(w y ^ 2)) x) x := by
    intro x
    have := (hw x).sub (hv x)
    convert this using 1
    simp only
    ring
  obtain ⟨-, -, -, hL⟩ := (periodic_resolvent_T κ hκ _ hfc hfp).2 _ hdp hdd
  have habs : (∫ x in (0:ℝ)..1, |(fun y => -(w y ^ 2)) x|) = ∫ x in (0:ℝ)..1, w x ^ 2 := by
    apply intervalIntegral.integral_congr
    intro x _
    simp only [abs_neg]
    exact abs_of_nonneg (sq_nonneg _)
  rw [habs] at hL
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = ∫ x in (0:ℝ)..1, v x ^ 2 := ⟨_, rfl⟩
  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = ∫ x in (0:ℝ)..1, w x ^ 2 := ⟨_, rfl⟩
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = ∫ x in (0:ℝ)..1, (w x - v x) ^ 2 := ⟨_, rfl⟩
  obtain ⟨C, hCdef⟩ : ∃ C : ℝ, C = ∫ x in (0:ℝ)..1, v x * (w x - v x) := ⟨_, rfl⟩
  have hD1 : D ≤ B ^ 2 / κ := by rw [hDdef, hBdef]; exact hL
  have hA0 : 0 ≤ A := by
    rw [hAdef]; exact intervalIntegral.integral_nonneg (by norm_num) (fun x _ => sq_nonneg _)
  have hB0 : 0 ≤ B := by
    rw [hBdef]; exact intervalIntegral.integral_nonneg (by norm_num) (fun x _ => sq_nonneg _)
  have hD0 : 0 ≤ D := by
    rw [hDdef]; exact intervalIntegral.integral_nonneg (by norm_num) (fun x _ => sq_nonneg _)
  rw [← hAdef] at hA hBA ⊢
  rw [← hBdef] at hBA ⊢
  have hκD : D * κ ≤ B ^ 2 := (le_div_iff₀ hκpos).1 hD1
  have hB2 : B ^ 2 ≤ (4 * A) ^ 2 := pow_le_pow_left₀ hB0 hBA 2
  have hA1024 : 1024 * A * A ≤ κ * A := by nlinarith
  have hD64 : D ≤ A / 64 := by
    by_contra hc
    push_neg at hc
    have : A / 64 * κ < D * κ := mul_lt_mul_of_pos_right hc hκpos
    nlinarith
  have hid : B = A + 2 * C + D := by
    rw [hBdef, hAdef, hCdef, hDdef]
    have e : (∫ x in (0:ℝ)..1, w x ^ 2) = ∫ x in (0:ℝ)..1,
        (v x ^ 2 + 2 * (v x * (w x - v x)) + (w x - v x) ^ 2) := by
      congr 1; funext x; ring
    rw [e, intervalIntegral.integral_add, intervalIntegral.integral_add,
      intervalIntegral.integral_const_mul]
    all_goals (apply Continuous.intervalIntegrable; fun_prop)
  have hCS : C ^ 2 ≤ A * D := by
    rw [hCdef, hAdef, hDdef]
    exact cauchy_schwarz_unit_interval v (fun x => w x - v x) hvc (hwc.sub hvc)
  have hC2 : C ^ 2 ≤ (A / 8) ^ 2 := by
    have : A * D ≤ A * (A / 64) := mul_le_mul_of_nonneg_left hD64 hA0
    nlinarith
  have hCabs := abs_le_of_sq_le_sq' hC2 (by linarith)
  constructor <;> linarith [hCabs.1, hCabs.2]

theorem periodic_riccati_exists_T : ∀ (κ : ℝ), 1 ≤ κ → ∀ (q v : ℝ → ℝ), Continuous q → Function.Periodic q 1 → Function.Periodic v 1 → (∀ x, HasDerivAt v (2 * κ * v x + q x) x) → (∫ x in (0:ℝ)..1, v x ^ 2) ≤ κ / 1024 → ∃ w : ℝ → ℝ, Function.Periodic w 1 ∧ (∀ x, HasDerivAt w (q x + 2 * κ * w x - w x ^ 2) x) ∧ 3 / 4 * (∫ x in (0:ℝ)..1, v x ^ 2) ≤ (∫ x in (0:ℝ)..1, w x ^ 2) ∧ (∫ x in (0:ℝ)..1, w x ^ 2) ≤ 81 / 64 * (∫ x in (0:ℝ)..1, v x ^ 2) :=
by
  intro κ hκ q v hq hqper hvper hvd hv
  obtain ⟨w, hw0, hwc, hwper, hwd⟩ := periodic_picard_iterates_T κ hκ q hq hqper
  obtain ⟨hE, hD⟩ := periodic_picard_bounds_T κ hκ q v w hvper hvd hv hw0 hwc hwper hwd
  obtain ⟨W, hWper, hWd, hWA⟩ :=
    periodic_riccati_limit_T κ hκ (8 * ∫ x in (0:ℝ)..1, v x ^ 2) q w hq hqper hwc hwper hwd hD
  have hWE : (∫ x in (0:ℝ)..1, W x ^ 2) ≤ 4 * ∫ x in (0:ℝ)..1, v x ^ 2 := hWA _ hE
  obtain ⟨hlo, hhi⟩ := periodic_riccati_compare_T κ hκ q v W hvper hvd hv hWper hWd hWE
  exact ⟨W, hWper, hWd, hlo, hhi⟩

theorem smooth_solution_time_taylor_T : ∀ u : ℝ → CinfT, IsSmoothSolutionT u → ∀ t₀ : ℝ, ∃ M ≥ (0:ℝ), ∀ h : ℝ, |h| ≤ 1 → ∀ x : ℝ, |(u (t₀ + h) : ℝ → ℝ) x - (u t₀ : ℝ → ℝ) x| ≤ M * |h| ∧ |(u (t₀ + h) : ℝ → ℝ) x - (u t₀ : ℝ → ℝ) x - h * kdvRHS (u t₀ : ℝ → ℝ) x| ≤ M * h ^ 2 :=
by
  intro u hu t₀
  obtain ⟨hU, hkdv⟩ := hu
  
  have bound : ∀ V : ℝ × ℝ → ℝ, Continuous V → (∀ t x : ℝ, V (t, x + 1) = V (t, x)) →
      ∃ B ≥ (0:ℝ), ∀ t ∈ Set.Icc (t₀ - 1) (t₀ + 1), ∀ x : ℝ, |V (t, x)| ≤ B := by
    intro V hV hper
    have hK : IsCompact (Set.Icc (t₀ - 1) (t₀ + 1) ×ˢ Set.Icc (0:ℝ) 1) :=
      isCompact_Icc.prod isCompact_Icc
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hV.continuousOn
    refine ⟨max C 0, le_max_right _ _, fun t ht x => ?_⟩
    have hp : Function.Periodic (fun y => V (t, y)) 1 := fun y => hper t y
    obtain ⟨y, hy, hxy⟩ := hp.exists_mem_Ico₀ zero_lt_one x
    have h1 := hC (t, y) (Set.mk_mem_prod ht (Set.Ico_subset_Icc_self hy))
    rw [Real.norm_eq_abs] at h1
    have hxy' : V (t, x) = V (t, y) := hxy
    rw [hxy']
    exact h1.trans (le_max_left _ _)
  
  have mvt2 : ∀ (g g' g'' : ℝ → ℝ) (A B : ℝ), (∀ s, HasDerivAt g (g' s) s) →
      (∀ s, HasDerivAt g' (g'' s) s) →
      (∀ s ∈ Set.Icc (t₀ - 1) (t₀ + 1), |g' s| ≤ A) →
      (∀ s ∈ Set.Icc (t₀ - 1) (t₀ + 1), |g'' s| ≤ B) →
      ∀ h : ℝ, |h| ≤ 1 → |g (t₀ + h) - g t₀| ≤ A * |h| ∧
        |g (t₀ + h) - g t₀ - h * g' t₀| ≤ B * h ^ 2 := by
    intro g g' g'' A B hg hg' hA hB h hh
    have hh' := abs_le.1 hh
    have hsub : Set.uIcc t₀ (t₀ + h) ⊆ Set.Icc (t₀ - 1) (t₀ + 1) := by
      intro σ hσ
      rcases Set.mem_uIcc.1 hσ with h1 | h1
      · exact ⟨by linarith [h1.1, h1.2], by linarith [h1.1, h1.2]⟩
      · exact ⟨by linarith [h1.1, h1.2], by linarith [h1.1, h1.2]⟩
    have hdist : ∀ σ ∈ Set.uIcc t₀ (t₀ + h), |σ - t₀| ≤ |h| := by
      intro σ hσ
      rcases Set.mem_uIcc.1 hσ with h1 | h1
      · exact abs_le.2 ⟨by linarith [h1.1, h1.2, neg_abs_le h, abs_nonneg h],
          by linarith [h1.1, h1.2, le_abs_self h, abs_nonneg h]⟩
      · exact abs_le.2 ⟨by linarith [h1.1, h1.2, neg_abs_le h, abs_nonneg h],
          by linarith [h1.1, h1.2, le_abs_self h, abs_nonneg h]⟩
    have hconv : Convex ℝ (Set.uIcc t₀ (t₀ + h)) := convex_uIcc _ _
    have ha : t₀ ∈ Set.uIcc t₀ (t₀ + h) := Set.left_mem_uIcc
    have hb : t₀ + h ∈ Set.uIcc t₀ (t₀ + h) := Set.right_mem_uIcc
    have hB0 : 0 ≤ B := le_trans (abs_nonneg _) (hB t₀ ⟨by linarith, by linarith⟩)
    constructor
    · have h1 := hconv.norm_image_sub_le_of_norm_hasDerivWithin_le (f := g) (f' := g') (C := A)
        (fun σ _ => (hg σ).hasDerivWithinAt)
        (fun σ hσ => by rw [Real.norm_eq_abs]; exact hA σ (hsub hσ)) ha hb
      rw [Real.norm_eq_abs, Real.norm_eq_abs, add_sub_cancel_left] at h1
      exact h1
    · have haux : ∀ σ ∈ Set.uIcc t₀ (t₀ + h), |g' σ - g' t₀| ≤ B * |h| := by
        intro σ hσ
        have h1 := hconv.norm_image_sub_le_of_norm_hasDerivWithin_le (f := g') (f' := g'')
          (C := B) (fun τ _ => (hg' τ).hasDerivWithinAt)
          (fun τ hτ => by rw [Real.norm_eq_abs]; exact hB τ (hsub hτ)) ha hσ
        rw [Real.norm_eq_abs, Real.norm_eq_abs] at h1
        exact h1.trans (mul_le_mul_of_nonneg_left (hdist σ hσ) hB0)
      have hψ : ∀ σ, HasDerivAt (fun τ => g τ - g t₀ - (τ - t₀) * g' t₀) (g' σ - g' t₀) σ := by
        intro σ
        have h1 := ((hg σ).sub_const (g t₀)).sub
          (((hasDerivAt_id' σ).sub_const t₀).mul_const (g' t₀))
        convert h1 using 1
        ring
      have h1 := hconv.norm_image_sub_le_of_norm_hasDerivWithin_le
        (f := fun τ => g τ - g t₀ - (τ - t₀) * g' t₀) (f' := fun σ => g' σ - g' t₀)
