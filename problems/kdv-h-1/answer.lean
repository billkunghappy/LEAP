        · intro s hs; exact (hχ s hs).continuousAt.continuousWithinAt
        · intro s hs
          rw [interior_Icc] at hs
          exact (hχ s (Set.Ioo_subset_Icc_self hs)).differentiableAt.differentiableWithinAt
        · intro s hs
          rw [interior_Icc] at hs
          have hs' := Set.Ioo_subset_Icc_self hs
          rw [(hχ s hs').deriv]
          have hb := hbd s (hsT s hs')
          have he := Real.exp_pos ((2 * K + 1) * s)
          have he1 : Real.exp ((2 * K + 1) * s) ≤ 1 :=
            Real.exp_le_one_iff.2 (by nlinarith [hs.2])
          have h1 := (neg_abs_le (2 * inner ℝ (R s) (R' s))).trans' (neg_le_neg hb)
          nlinarith [mul_le_mul_of_nonneg_left h1 he.le,
            mul_le_mul_of_nonneg_right he1 (sq_nonneg B)]
      have h := hmono ⟨le_refl τ, h0.le⟩ ⟨h0.le, le_refl 0⟩ h0.le
      simp only [mul_zero, Real.exp_zero, one_mul, add_zero] at h
