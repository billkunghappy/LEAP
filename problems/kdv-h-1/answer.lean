    · have hτ' : -τ ≤ T := by rw [abs_of_neg h0] at hτ; exact hτ
      have hsT : ∀ s ∈ Set.Icc τ 0, |s| ≤ T := fun s hs => by
        rw [abs_of_nonpos hs.2]; linarith [hs.1]
      have hχ : ∀ s ∈ Set.Icc τ 0,
