    · have hτ' : τ ≤ T := by rw [abs_of_nonneg h0] at hτ; exact hτ
      have hsT : ∀ s ∈ Set.Icc 0 τ, |s| ≤ T := fun s hs => by
        rw [abs_of_nonneg hs.1]; exact le_trans hs.2 hτ'
      have hψ : ∀ s ∈ Set.Icc 0 τ,
