theorem greenT_riccati_region_T : ∀ R ≥ (0 : ℝ), ∃ κ₀ ≥ (1 : ℝ), ∀ κ ≥ κ₀, ∀ q : CinfT, ‖ιT q‖ ≤ R → IsGreenT κ (q : ℝ → ℝ) (greenT κ (q : ℝ → ℝ)) ∧ ∃ wp wm : ℝ → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) wp ∧ ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) wm ∧ Function.Periodic wp 1 ∧ Function.Periodic wm 1 ∧ (∀ x, HasDerivAt wp ((q : ℝ → ℝ) x + 2 * κ * wp x - wp x ^ 2) x) ∧ (∀ x, HasDerivAt wm ((q : ℝ → ℝ) x - 2 * κ * wm x - wm x ^ 2) x) ∧ (∫ x in (0:ℝ)..1, wp x ^ 2) ≤ 2 * WT κ ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ∧ (∫ x in (0:ℝ)..1, wm x ^ 2) ≤ 2 * WT κ ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ∧ (∀ x, |wm x - wp x| ≤ κ / 2) ∧ ∀ x, greenT κ (q : ℝ → ℝ) x = 1 / (2 * κ + wm x - wp x) :=
by
