  obtain ⟨tφT, tψT, tHT⟩ := hlim Filter.atTop ht0 ht1 ht2 ht3 hwtop
  obtain ⟨tφB, tψB, tHB⟩ := hlim Filter.atBot hl0 hl1 hl2 hl3 hwbot
  obtain ⟨Cφ, hCφ⟩ := bdd0 φ hφc tφT tφB
  obtain ⟨Cψ, hCψ⟩ := bdd0 ψ hψc tψT tψB
  have hbm : ∀ (f g : ℝ → ℝ) (C : ℝ), Continuous f → (∀ x, |f x| ≤ C) →
