      rw [iteratedDeriv_succ, iteratedDeriv_succ, iteratedDeriv_succ, iteratedDeriv_zero]
    have c1 : deriv (fun y => q y * E y) x = deriv (⇑q) x * E x
        + q x * (2 * (ρ x - κ) * E x + 2 * R x * (1 / (2 * κ) + γ x)) :=
      ((q.differentiableAt (x := x)).hasDerivAt.mul (hEd x)).deriv
    have c2 : deriv (fun y => f y * (1 / (2 * κ) + γ y)) x = deriv (⇑f) x * (1 / (2 * κ) + γ x)
        + f x * (2 * (ρ x - κ) * (1 / (2 * κ) + γ x) + 1) :=
      ((f.differentiableAt (x := x)).hasDerivAt.mul (hg x)).deriv
    have c3 := (hlink x).deriv
    have c4 := (hEd x).deriv
    rw [← hγdef, hD3, c1, c2, c3, c4, hd1, hd2, hE2'.deriv]
    ring
  · 
    intro e he
    obtain ⟨hKfm, hKfeq⟩ := riccatiK_sq_integral κ hκ0 f
    have hSKf : Real.sqrt (∫ x : ℝ, riccatiK κ f x ^ 2) ≤ ‖ι f‖ := by
      rw [hKfeq]
      have h1 := ((Hm1_weight_basic (toHm1 f)).2 κ hκ).2.1
      calc _ ≤ Real.sqrt (‖toHm1 f‖ ^ 2) := Real.sqrt_le_sqrt h1
        _ = ‖toHm1 f‖ := Real.sqrt_sq (norm_nonneg _)
        _ = ‖ι f‖ := rfl
    obtain ⟨z, hz2, hzeq⟩ := riccati_linear_solve κ hκ ρ (riccatiK κ ⇑f) hρ.1 hρ.2.1 hKfm
    obtain ⟨-, -, hztop, hzbot, hzd⟩ := riccati_response_regularity κ hκ0 (⇑f) ρ z f.continuous
      (f.integrable (μ := volume)) hρc hρ.1 hz2 hzeq
    
    obtain ⟨-, hK2⟩ := riccatiK_sqrt_bounds κ hκ
    obtain ⟨hkm, hkb⟩ := hK2 (fun y => 2 * ρ y) z (hρ.1.const_mul 2) hz2
    have hSz0 := Real.sqrt_nonneg (∫ x : ℝ, z x ^ 2)
    have hSk : Real.sqrt (∫ x : ℝ, riccatiK κ (fun y => 2 * ρ y * z y) x ^ 2) ≤
        1 / 4 * Real.sqrt (∫ x : ℝ, z x ^ 2) := by
      nlinarith [mul_le_mul_of_nonneg_right hS2ρ hSz0]
    have hzsub : Real.sqrt (∫ x : ℝ, z x ^ 2) ≤ Real.sqrt (∫ x : ℝ, riccatiK κ f x ^ 2) +
        Real.sqrt (∫ x : ℝ, riccatiK κ (fun y => 2 * ρ y * z y) x ^ 2) := by
      have h := hadd (riccatiK κ ⇑f) (fun x => -riccatiK κ (fun y => 2 * ρ y * z y) x) hKfm hkm.neg
      beta_reduce at h
      rw [hnegI] at h
      have e1 : ∫ x : ℝ, z x ^ 2 = ∫ x : ℝ, (riccatiK κ (⇑f) x +
          -riccatiK κ (fun y => 2 * ρ y * z y) x) ^ 2 := by
        congr 1; funext x; rw [hzeq x]; ring
      rw [e1]
      exact h
    have hSz : Real.sqrt (∫ x : ℝ, z x ^ 2) ≤ 4 / 3 * Real.sqrt (∫ x : ℝ, riccatiK κ f x ^ 2) := by
      linarith
    
    have hfo : ∀ x : ℝ, deriv (⇑e) x = 2 * (ρ x - κ) * e x + 2 * z x * (1 / (2 * κ) + γ x) := by
      obtain ⟨E1, hE1⟩ : ∃ E1 : 𝓢(ℝ, ℝ), E1 = SchwartzMap.derivCLM ℝ ℝ e := ⟨_, rfl⟩
      obtain ⟨E2, hE2⟩ : ∃ E2 : 𝓢(ℝ, ℝ), E2 = SchwartzMap.derivCLM ℝ ℝ E1 := ⟨_, rfl⟩
      obtain ⟨E3, hE3⟩ : ∃ E3 : 𝓢(ℝ, ℝ), E3 = SchwartzMap.derivCLM ℝ ℝ E2 := ⟨_, rfl⟩
      have hd1 : deriv (⇑e) = ⇑E1 := by
        rw [hE1]; exact funext fun x => (SchwartzMap.derivCLM_apply ℝ e x).symm
      have hd2 : deriv (⇑E1) = ⇑E2 := by
        rw [hE2]; exact funext fun x => (SchwartzMap.derivCLM_apply ℝ E1 x).symm
      have hd3 : deriv (⇑E2) = ⇑E3 := by
        rw [hE3]; exact funext fun x => (SchwartzMap.derivCLM_apply ℝ E2 x).symm
      have h3 : iteratedDeriv 3 (⇑e) = ⇑E3 := by
        rw [iteratedDeriv_succ, iteratedDeriv_succ, iteratedDeriv_succ, iteratedDeriv_zero,
          hd1, hd2, hd3]
      have hE0d : ∀ y, HasDerivAt (⇑e) (E1 y) y := by
        intro y
        have := (e.differentiableAt (x := y)).hasDerivAt
        rwa [hd1] at this
      have hE1d : ∀ y, HasDerivAt (⇑E1) (E2 y) y := by
        intro y
        have := (E1.differentiableAt (x := y)).hasDerivAt
        rwa [hd2] at this
      have hE2d : ∀ y, HasDerivAt (⇑E2) (E3 y) y := by
        intro y
        have := (E2.differentiableAt (x := y)).hasDerivAt
        rwa [hd3] at this
      have he' : ∀ y, E3 y - 2 * (deriv (⇑q) y * e y + q y * E1 y) - 2 * q y * E1 y
          - 4 * κ ^ 2 * E1 y =
          2 * (deriv (⇑f) y * (1 / (2 * κ) + γ y)
            + f y * (2 * (ρ y - κ) * (1 / (2 * κ) + γ y) + 1))
          + 2 * f y * (2 * (ρ y - κ) * (1 / (2 * κ) + γ y) + 1) := by
        intro y
        have H := he y
        rw [← hγdef] at H
        have c1 : deriv (fun y => q y * e y) y = deriv (⇑q) y * e y + q y * E1 y :=
          ((q.differentiableAt (x := y)).hasDerivAt.mul (hE0d y)).deriv
        have c2 : deriv (fun y => f y * (1 / (2 * κ) + γ y)) y =
            deriv (⇑f) y * (1 / (2 * κ) + γ y)
              + f y * (2 * (ρ y - κ) * (1 / (2 * κ) + γ y) + 1) :=
          ((f.differentiableAt (x := y)).hasDerivAt.mul (hg y)).deriv
        have c3 := (hlink y).deriv
        rw [h3, c1, c2, c3, hd1] at H
        exact H
      have hVd : ∀ y, HasDerivAt
          (fun y => E1 y - 2 * (ρ y - κ) * e y - 2 * z y * (1 / (2 * κ) + γ y))
          (E2 y - 2 * (ρ y - κ) * E1 y - 2 * (q y + 2 * κ * ρ y - ρ y ^ 2) * e y
            - 2 * f y * (1 / (2 * κ) + γ y) - 2 * z y) y := by
        intro y
        have h := ((hE1d y).sub ((((hρd y).sub_const κ).const_mul 2).mul (hE0d y))).sub
          (((hzd y).const_mul 2).mul (hg y))
        convert h using 1
        ring
      have hUd : ∀ y, HasDerivAt
          (fun y => E2 y - 2 * (ρ y - κ) * E1 y - 2 * (q y + 2 * κ * ρ y - ρ y ^ 2) * e y
            - 2 * f y * (1 / (2 * κ) + γ y) - 2 * z y)
          (-2 * (ρ y - κ) * (E2 y - 2 * (ρ y - κ) * E1 y
            - 2 * (q y + 2 * κ * ρ y - ρ y ^ 2) * e y
            - 2 * f y * (1 / (2 * κ) + γ y) - 2 * z y)) y := by
        intro y
        have h := ((((hE2d y).sub ((((hρd y).sub_const κ).const_mul 2).mul (hE1d y))).sub
          (((hρ1d y).const_mul 2).mul (hE0d y))).sub
          ((((f.differentiableAt (x := y)).hasDerivAt).const_mul 2).mul (hg y))).sub
          ((hzd y).const_mul 2)
        convert h using 1
        linear_combination (-1 : ℝ) * he' y
      have e0 : (0 : ℝ) - 2 * (0 - κ) * 0 - 2 * 0 * (1 / (2 * κ) + 0) = 0 := by ring
      have hVtop : Filter.Tendsto
          (fun y => E1 y - 2 * (ρ y - κ) * e y - 2 * z y * (1 / (2 * κ) + γ y))
          Filter.atTop (nhds 0) := by
        have h := ((hdecay E1).1.sub (((hρtop.sub_const κ).const_mul 2).mul (hdecay e).1)).sub
          ((hztop.const_mul 2).mul ((hdecay γ).1.const_add (1 / (2 * κ))))
        rw [e0] at h
        exact h
      have hVbot : Filter.Tendsto
          (fun y => E1 y - 2 * (ρ y - κ) * e y - 2 * z y * (1 / (2 * κ) + γ y))
          Filter.atBot (nhds 0) := by
        have h := ((hdecay E1).2.sub (((hρbot.sub_const κ).const_mul 2).mul (hdecay e).2)).sub
          ((hzbot.const_mul 2).mul ((hdecay γ).2.const_add (1 / (2 * κ))))
        rw [e0] at h
        exact h
      have hm : Continuous (fun x => -2 * (ρ x - κ)) :=
        continuous_const.mul (hρc.sub continuous_const)
      have hv0 := ode_zero (fun x => -2 * (ρ x - κ))
        (fun y => E1 y - 2 * (ρ y - κ) * e y - 2 * z y * (1 / (2 * κ) + γ y))
        (fun y => E2 y - 2 * (ρ y - κ) * E1 y - 2 * (q y + 2 * κ * ρ y - ρ y ^ 2) * e y
            - 2 * f y * (1 / (2 * κ) + γ y) - 2 * z y)
        hm hVd hUd hVtop hVbot
      intro x
      have := hv0 x
      simp only at this
      rw [hd1]
      linarith
    
    have hSe := hlinear (⇑e) (fun x => 2 * ρ x) (fun x => κ⁻¹ * z x) z (fun x => 2 * γ x)
      (fun x => by
        have h := (e.differentiableAt (x := x)).hasDerivAt
        convert h using 1
        rw [hfo x]
        field_simp
        ring)
      (hdecay e).2 (e.memLp 2) (hρ.1.const_mul 2) (hz2.const_mul κ⁻¹) hz2
      ((γ.memLp 2).const_mul 2)
    have hbz := hscaleK z
    have hSe0 := Real.sqrt_nonneg (∫ x : ℝ, e x ^ 2)
    have hSe8 : Real.sqrt (∫ x : ℝ, e x ^ 2) ≤ 8 / 9 * Real.sqrt (∫ x : ℝ, z x ^ 2) := by
      nlinarith [mul_nonneg (sub_nonneg.2 hS2ρ) hSe0, mul_nonneg (sub_nonneg.2 hS2γ) hSz0]
    
    have hw := hHm1d e (SchwartzMap.derivCLM ℝ ℝ e)
      (fun x => SchwartzMap.derivCLM_apply ℝ e x)
    have hf0 := norm_nonneg (ι f)
    linarith

theorem lin_green_riccati_link (κ : ℝ) (hκ : 0 < κ) (q f e : 𝓢(ℝ, ℝ)) (ρ z : ℝ → ℝ)
    (hρc : Continuous ρ)
    (hρtop : Filter.Tendsto ρ Filter.atTop (nhds 0))
    (hρbot : Filter.Tendsto ρ Filter.atBot (nhds 0))
    (hρd : ∀ x : ℝ, HasDerivAt ρ (q x + 2 * κ * ρ x - ρ x ^ 2) x)
    (hztop : Filter.Tendsto z Filter.atTop (nhds 0))
    (hzbot : Filter.Tendsto z Filter.atBot (nhds 0))
    (hzd : ∀ x : ℝ, HasDerivAt z (2 * κ * z x + f x - 2 * ρ x * z x) x)
    (hlink : ∀ x : ℝ, deriv (⇑(greenOffset κ q)) x =
      2 * (ρ x - κ) * greenOffset κ q x + ρ x / κ)
    (hlin : LinGreenODE κ q f e) :
    ∀ x : ℝ, deriv (⇑e) x =
      2 * (ρ x - κ) * e x + 2 * z x * (1 / (2 * κ) + greenOffset κ q x) :=
by
  have hκne : κ ≠ 0 := hκ.ne'
  have hdecay : ∀ F : 𝓢(ℝ, ℝ), Filter.Tendsto (⇑F) Filter.atTop (nhds 0) ∧
      Filter.Tendsto (⇑F) Filter.atBot (nhds 0) := by
    intro F
    have h := F.toZeroAtInfty.zero_at_infty'
    rw [cocompact_eq_atBot_atTop, Filter.tendsto_sup] at h
    exact ⟨h.2, h.1⟩
  have ode_zero : ∀ (m v u : ℝ → ℝ), Continuous m → (∀ x : ℝ, HasDerivAt v (u x) x) →
      (∀ x : ℝ, HasDerivAt u (m x * u x) x) → Filter.Tendsto v Filter.atTop (nhds 0) →
      Filter.Tendsto v Filter.atBot (nhds 0) → ∀ x : ℝ, v x = 0 := by
    intro m v u hm hv hu htop hbot
    obtain ⟨P, hP⟩ : ∃ P : ℝ → ℝ, ∀ x : ℝ, HasDerivAt P (m x) x :=
      ⟨fun x => ∫ t in (0 : ℝ)..x, m t, fun x => (hm.integral_hasStrictDerivAt 0 x).hasDerivAt⟩
    have hΦ : ∀ x : ℝ, HasDerivAt (fun y => u y * Real.exp (-P y)) 0 x := by
      intro x
      have := (hu x).mul ((hP x).neg.exp)
      convert this using 1
      ring
    have hconst : ∀ x : ℝ, u x * Real.exp (-P x) = u 0 * Real.exp (-P 0) := by
      intro x
      exact is_const_of_deriv_eq_zero (fun y => (hΦ y).differentiableAt)
        (fun y => (hΦ y).deriv) x 0
    obtain ⟨c, hc⟩ : ∃ c : ℝ, c = u 0 * Real.exp (-P 0) := ⟨_, rfl⟩
    have hu_eq : ∀ x : ℝ, u x = c * Real.exp (P x) := by
      intro x
      have h1 := hconst x
      have h2 : Real.exp (-P x) * Real.exp (P x) = 1 := by
        rw [← Real.exp_add]; simp
      calc u x = u x * Real.exp (-P x) * Real.exp (P x) := by rw [mul_assoc, h2, mul_one]
        _ = c * Real.exp (P x) := by rw [h1, hc]
    intro x
    rcases le_total 0 c with hc0 | hc0
    · have hmono : Monotone v := monotone_of_deriv_nonneg (fun y => (hv y).differentiableAt)
        (fun y => by rw [(hv y).deriv, hu_eq y]; exact mul_nonneg hc0 (Real.exp_pos _).le)
      have h1 := hmono.ge_of_tendsto htop x
      have h2 := hmono.le_of_tendsto hbot x
      linarith
    · have hanti : Antitone v := antitone_of_deriv_nonpos (fun y => (hv y).differentiableAt)
        (fun y => by
          rw [(hv y).deriv, hu_eq y]
          exact mul_nonpos_of_nonpos_of_nonneg hc0 (Real.exp_pos _).le)
      have h1 := hanti.le_of_tendsto htop x
      have h2 := hanti.ge_of_tendsto hbot x
      linarith
  have hde : deriv (⇑e) = ⇑(SchwartzMap.derivCLM ℝ ℝ e) :=
    funext fun x => (SchwartzMap.derivCLM_apply ℝ e x).symm
  have hdDe : deriv (⇑(SchwartzMap.derivCLM ℝ ℝ e)) =
      ⇑(SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ e)) :=
    funext fun x => (SchwartzMap.derivCLM_apply ℝ _ x).symm
  have e2 : iteratedDeriv 2 (⇑e) =
      ⇑(SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ e)) := by
    rw [iteratedDeriv_succ, iteratedDeriv_one, hde, hdDe]
  have e3 : iteratedDeriv 3 (⇑e) = deriv (iteratedDeriv 2 (⇑e)) := iteratedDeriv_succ
  have hf : ∀ x : ℝ,
      HasDerivAt (fun y => deriv (⇑e) y - 2 * (ρ y - κ) * e y
          - 2 * z y * (1 / (2 * κ) + greenOffset κ q y))
        (iteratedDeriv 2 (⇑e) x - 2 * (ρ x - κ) * deriv (⇑e) x
          - 2 * (q x + 2 * κ * ρ x - ρ x ^ 2) * e x
          - 2 * f x * (1 / (2 * κ) + greenOffset κ q x) - 2 * z x) x ∧
      HasDerivAt (fun y => iteratedDeriv 2 (⇑e) y - 2 * (ρ y - κ) * deriv (⇑e) y
          - 2 * (q y + 2 * κ * ρ y - ρ y ^ 2) * e y
          - 2 * f y * (1 / (2 * κ) + greenOffset κ q y) - 2 * z y)
        (-2 * (ρ x - κ) * (iteratedDeriv 2 (⇑e) x - 2 * (ρ x - κ) * deriv (⇑e) x
          - 2 * (q x + 2 * κ * ρ x - ρ x ^ 2) * e x
          - 2 * f x * (1 / (2 * κ) + greenOffset κ q x) - 2 * z x)) x := by
    intro x
    have he1 : HasDerivAt (⇑e) (deriv (⇑e) x) x := (e.differentiableAt (x := x)).hasDerivAt
    have he2 : HasDerivAt (deriv (⇑e)) (iteratedDeriv 2 (⇑e) x) x := by
      rw [e2, hde]
      have := ((SchwartzMap.derivCLM ℝ ℝ e).differentiableAt (x := x)).hasDerivAt
      rwa [hdDe] at this
    have he3 : HasDerivAt (iteratedDeriv 2 (⇑e)) (iteratedDeriv 3 (⇑e) x) x := by
      rw [e3, e2]
      exact ((SchwartzMap.derivCLM ℝ ℝ
        (SchwartzMap.derivCLM ℝ ℝ e)).differentiableAt (x := x)).hasDerivAt
    have hq : HasDerivAt (⇑q) (deriv (⇑q) x) x := (q.differentiableAt (x := x)).hasDerivAt
    have hfd : HasDerivAt (⇑f) (deriv (⇑f) x) x := (f.differentiableAt (x := x)).hasDerivAt
    have hG : HasDerivAt (⇑(greenOffset κ q)) (deriv (⇑(greenOffset κ q)) x) x :=
      ((greenOffset κ q).differentiableAt (x := x)).hasDerivAt
    have hg : HasDerivAt (fun y => 1 / (2 * κ) + greenOffset κ q y)
        (deriv (⇑(greenOffset κ q)) x) x := hG.const_add _
    have hsq : HasDerivAt (fun y => ρ y ^ 2)
        (2 * ρ x * (q x + 2 * κ * ρ x - ρ x ^ 2)) x := by
      convert (hρd x).mul (hρd x) using 1
      · funext y; show ρ y ^ 2 = ρ y * ρ y; ring
      · ring
    have hW : HasDerivAt (fun y => q y + 2 * κ * ρ y - ρ y ^ 2)
        (deriv (⇑q) x + 2 * κ * (q x + 2 * κ * ρ x - ρ x ^ 2)
          - 2 * ρ x * (q x + 2 * κ * ρ x - ρ x ^ 2)) x :=
      (hq.add ((hρd x).const_mul (2 * κ))).sub hsq
    have hG1 : deriv (⇑(greenOffset κ q)) x =
        2 * (ρ x - κ) * (1 / (2 * κ) + greenOffset κ q x) + 1 := by
      rw [hlink x]
      field_simp
      ring
    have hqe : deriv (fun y => q y * e y) x = deriv (⇑q) x * e x + q x * deriv (⇑e) x :=
      (hq.mul he1).deriv
    have hfg : deriv (fun y => f y * (1 / (2 * κ) + greenOffset κ q y)) x =
        deriv (⇑f) x * (1 / (2 * κ) + greenOffset κ q x) +
          f x * deriv (⇑(greenOffset κ q)) x :=
      (hfd.mul hg).deriv
    have hL := hlin x
    rw [hqe, hfg, hG1] at hL
    constructor
    · have h := (he2.sub ((((hρd x).sub_const κ).const_mul 2).mul he1)).sub
        (((hzd x).const_mul 2).mul hg)
      convert h using 1
      rw [hG1]
      ring
    · have h := ((((he3.sub ((((hρd x).sub_const κ).const_mul 2).mul he2)).sub
        ((hW.const_mul 2).mul he1)).sub ((hfd.const_mul 2).mul hg)).sub ((hzd x).const_mul 2))
      convert h using 1
      rw [hG1]
      linear_combination (-1 : ℝ) * hL
  have e0 : (0 : ℝ) - 2 * (0 - κ) * 0 - 2 * 0 * (1 / (2 * κ) + 0) = 0 := by ring
  have htop : Filter.Tendsto (fun y => deriv (⇑e) y - 2 * (ρ y - κ) * e y
      - 2 * z y * (1 / (2 * κ) + greenOffset κ q y)) Filter.atTop (nhds 0) := by
    rw [hde]
    have h := (((hdecay (SchwartzMap.derivCLM ℝ ℝ e)).1.sub
      (((hρtop.sub_const κ).const_mul 2).mul (hdecay e).1)).sub
      ((hztop.const_mul 2).mul ((hdecay (greenOffset κ q)).1.const_add (1 / (2 * κ)))))
    rw [e0] at h
    exact h
  have hbot : Filter.Tendsto (fun y => deriv (⇑e) y - 2 * (ρ y - κ) * e y
      - 2 * z y * (1 / (2 * κ) + greenOffset κ q y)) Filter.atBot (nhds 0) := by
    rw [hde]
    have h := (((hdecay (SchwartzMap.derivCLM ℝ ℝ e)).2.sub
      (((hρbot.sub_const κ).const_mul 2).mul (hdecay e).2)).sub
      ((hzbot.const_mul 2).mul ((hdecay (greenOffset κ q)).2.const_add (1 / (2 * κ)))))
    rw [e0] at h
    exact h
  have hm : Continuous (fun x => -2 * (ρ x - κ)) :=
    continuous_const.mul (hρc.sub continuous_const)
  have hv0 := ode_zero (fun x => -2 * (ρ x - κ))
    (fun y => deriv (⇑e) y - 2 * (ρ y - κ) * e y
      - 2 * z y * (1 / (2 * κ) + greenOffset κ q y))
    (fun y => iteratedDeriv 2 (⇑e) y - 2 * (ρ y - κ) * deriv (⇑e) y
      - 2 * (q y + 2 * κ * ρ y - ρ y ^ 2) * e y
      - 2 * f y * (1 / (2 * κ) + greenOffset κ q y) - 2 * z y)
    hm (fun x => (hf x).1) (fun x => (hf x).2) htop hbot
  intro x
  have := hv0 x
  simp only at this
  linarith

theorem linear_decay_L2_bound2 (κ : ℝ) (hκ : 1 ≤ κ) (y a b e₁ h₁ e₂ h₂ : ℝ → ℝ)
    (hy : ∀ x : ℝ, HasDerivAt y
      (a x * y x + b x + e₁ x * h₁ x + e₂ x * h₂ x - 2 * κ * y x) x)
    (hybot : Filter.Tendsto y Filter.atBot (nhds 0))
    (hy2 : MemLp y 2 (volume : Measure ℝ)) (ha : MemLp a 2 (volume : Measure ℝ))
    (hb : MemLp b 2 (volume : Measure ℝ))
    (he₁ : MemLp e₁ 2 (volume : Measure ℝ)) (hh₁ : MemLp h₁ 2 (volume : Measure ℝ))
    (he₂ : MemLp e₂ 2 (volume : Measure ℝ)) (hh₂ : MemLp h₂ 2 (volume : Measure ℝ)) :
    Real.sqrt (∫ x : ℝ, y x ^ 2) ≤
      1 / 2 * (Real.sqrt (∫ x : ℝ, a x ^ 2) * Real.sqrt (∫ x : ℝ, y x ^ 2)) +
      1 / 2 * Real.sqrt (∫ x : ℝ, b x ^ 2) +
      1 / 2 * (Real.sqrt (∫ x : ℝ, e₁ x ^ 2) * Real.sqrt (∫ x : ℝ, h₁ x ^ 2)) +
      1 / 2 * (Real.sqrt (∫ x : ℝ, e₂ x ^ 2) * Real.sqrt (∫ x : ℝ, h₂ x ^ 2)) :=
by
  have hκ0 : (0 : ℝ) < κ := by linarith
  have hN : ∀ (f : ℝ → ℝ) (hf : MemLp f 2 (volume : Measure ℝ)),
      ‖hf.toLp f‖ = Real.sqrt (∫ x : ℝ, f x ^ 2) := by
    intro f hf
    rw [Lp.norm_toLp, hf.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    have h2 : (2 : ENNReal).toReal = 2 := by norm_num
    have hint : ∫ a, ‖f a‖ ^ (2 : ℝ) = ∫ a, f a ^ 2 := by
      congr 1; funext a; rw [Real.rpow_two, Real.norm_eq_abs, sq_abs]
    rw [h2, hint, Real.sqrt_eq_rpow, one_div, ENNReal.toReal_ofReal]
    exact Real.rpow_nonneg (integral_nonneg fun _ => sq_nonneg _) _
  have hadd : ∀ f g : ℝ → ℝ, MemLp f 2 (volume : Measure ℝ) → MemLp g 2 (volume : Measure ℝ) →
      Real.sqrt (∫ x : ℝ, (f x + g x) ^ 2) ≤
        Real.sqrt (∫ x : ℝ, f x ^ 2) + Real.sqrt (∫ x : ℝ, g x ^ 2) := by
    intro f g hf hg
    have e := hN (f + g) (hf.add hg)
    rw [MemLp.toLp_add hf hg] at e
    simp only [Pi.add_apply] at e
    calc Real.sqrt (∫ x : ℝ, (f x + g x) ^ 2) = ‖hf.toLp f + hg.toLp g‖ := e.symm
      _ ≤ ‖hf.toLp f‖ + ‖hg.toLp g‖ := norm_add_le _ _
      _ = _ := by rw [hN f hf, hN g hg]
  have hnegI : ∀ f : ℝ → ℝ, ∫ x : ℝ, (-f x) ^ 2 = ∫ x : ℝ, f x ^ 2 := by
    intro f; congr 1; funext x; ring
  have habsI : ∀ g : ℝ → ℝ, ∫ s : ℝ, |g s| ^ 2 = ∫ s : ℝ, g s ^ 2 := by
    intro g; congr 1; funext s; exact sq_abs _
  
  have key : ∀ Y A B E H E' H' : ℝ → ℝ,
      (∀ s, HasDerivAt Y (2 * κ * Y s - (A s * Y s + B s + E s * H s + E' s * H' s)) s) →
      Filter.Tendsto Y Filter.atTop (nhds 0) →
      MemLp Y 2 (volume : Measure ℝ) → MemLp A 2 (volume : Measure ℝ) →
      MemLp B 2 (volume : Measure ℝ) → MemLp E 2 (volume : Measure ℝ) →
      MemLp H 2 (volume : Measure ℝ) → MemLp E' 2 (volume : Measure ℝ) →
      MemLp H' 2 (volume : Measure ℝ) →
      Real.sqrt (∫ x : ℝ, Y x ^ 2) ≤
        1 / 2 * (Real.sqrt (∫ x : ℝ, A x ^ 2) * Real.sqrt (∫ x : ℝ, Y x ^ 2)) +
        1 / 2 * Real.sqrt (∫ x : ℝ, B x ^ 2) +
        1 / 2 * (Real.sqrt (∫ x : ℝ, E x ^ 2) * Real.sqrt (∫ x : ℝ, H x ^ 2)) +
        1 / 2 * (Real.sqrt (∫ x : ℝ, E' x ^ 2) * Real.sqrt (∫ x : ℝ, H' x ^ 2)) := by
    intro Y A B E H E' H' hY hYtop hY2 hA hB hE hH hE' hH'
    have hYc : Continuous Y := continuous_iff_continuousAt.2 fun s => (hY s).continuousAt
    have hYn : Filter.Tendsto (fun s => ‖Y s‖) Filter.atTop (nhds 0) := by
      simpa using hYtop.norm
    have mA : AEStronglyMeasurable (fun s => |A s|) volume :=
      continuous_abs.comp_aestronglyMeasurable hA.1
    have mB : AEStronglyMeasurable (fun s => |B s|) volume :=
      continuous_abs.comp_aestronglyMeasurable hB.1
    have mE : AEStronglyMeasurable (fun s => |E s|) volume :=
      continuous_abs.comp_aestronglyMeasurable hE.1
    have mH : AEStronglyMeasurable (fun s => |H s|) volume :=
      continuous_abs.comp_aestronglyMeasurable hH.1
    have mE' : AEStronglyMeasurable (fun s => |E' s|) volume :=
      continuous_abs.comp_aestronglyMeasurable hE'.1
    have mH' : AEStronglyMeasurable (fun s => |H' s|) volume :=
      continuous_abs.comp_aestronglyMeasurable hH'.1
    have mY : AEStronglyMeasurable (fun s => |Y s|) volume :=
      continuous_abs.comp_aestronglyMeasurable hY2.1
    have iAY : Integrable (fun s => A s * Y s) volume := hA.integrable_mul hY2
    have iEH : Integrable (fun s => E s * H s) volume := hE.integrable_mul hH
    have iEH' : Integrable (fun s => E' s * H' s) volume := hE'.integrable_mul hH'
    
    have hpt : ∀ x : ℝ, |Y x| ≤
        -riccatiK κ (fun s => |A s| * |Y s|) x + -riccatiK κ (fun s => |B s|) x +
          -riccatiK κ (fun s => |E s| * |H s|) x + -riccatiK κ (fun s => |E' s| * |H' s|) x := by
      intro x
      have cex : Continuous (fun s : ℝ => Real.exp (2 * κ * (x - s))) := by fun_prop
      have hEx : ∀ s ∈ Set.Ioi x, ‖Real.exp (2 * κ * (x - s))‖ ≤ 1 := by
        intro s hs
        rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
        apply Real.exp_le_one_iff.2
        have : x < s := hs
        nlinarith
      have I1 : IntegrableOn (fun s => Real.exp (2 * κ * (x - s)) * (|A s| * |Y s|))
          (Set.Ioi x) := by
        refine Integrable.mono' iAY.norm.integrableOn
          ((cex.aestronglyMeasurable.mul (mA.mul mY)).restrict) ?_
        refine (ae_restrict_mem measurableSet_Ioi).mono fun s hs => ?_
        have h1 := hEx s hs
        rw [Real.norm_eq_abs] at h1
        simp only [Real.norm_eq_abs, abs_mul, abs_abs]
        exact mul_le_of_le_one_left (by positivity) h1
      have I3 : IntegrableOn (fun s => Real.exp (2 * κ * (x - s)) * (|E s| * |H s|))
          (Set.Ioi x) := by
        refine Integrable.mono' iEH.norm.integrableOn
          ((cex.aestronglyMeasurable.mul (mE.mul mH)).restrict) ?_
        refine (ae_restrict_mem measurableSet_Ioi).mono fun s hs => ?_
        have h1 := hEx s hs
        rw [Real.norm_eq_abs] at h1
        simp only [Real.norm_eq_abs, abs_mul, abs_abs]
        exact mul_le_of_le_one_left (by positivity) h1
      have I4 : IntegrableOn (fun s => Real.exp (2 * κ * (x - s)) * (|E' s| * |H' s|))
          (Set.Ioi x) := by
        refine Integrable.mono' iEH'.norm.integrableOn
          ((cex.aestronglyMeasurable.mul (mE'.mul mH')).restrict) ?_
        refine (ae_restrict_mem measurableSet_Ioi).mono fun s hs => ?_
        have h1 := hEx s hs
        rw [Real.norm_eq_abs] at h1
        simp only [Real.norm_eq_abs, abs_mul, abs_abs]
        exact mul_le_of_le_one_left (by positivity) h1
      have I2 : IntegrableOn (fun s => Real.exp (2 * κ * (x - s)) * |B s|) (Set.Ioi x) := by
        have ib : IntegrableOn (fun s => Real.exp (4 * κ * x) * Real.exp (-(4 * κ) * s)
            + B s ^ 2) (Set.Ioi x) :=
          ((exp_neg_integrableOn_Ioi x (by linarith : (0 : ℝ) < 4 * κ)).const_mul
            (Real.exp (4 * κ * x))).add hB.integrable_sq.integrableOn
        refine Integrable.mono' ib ((cex.aestronglyMeasurable.mul mB).restrict) ?_
        refine Filter.Eventually.of_forall fun s => ?_
        have ht := Real.exp_pos (2 * κ * (x - s))
        have hsq : Real.exp (2 * κ * (x - s)) ^ 2 =
            Real.exp (4 * κ * x) * Real.exp (-(4 * κ) * s) := by
          rw [sq, ← Real.exp_add, ← Real.exp_add]; congr 1; ring
        rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_abs, abs_of_pos ht, ← hsq]
        nlinarith [sq_nonneg (Real.exp (2 * κ * (x - s)) - |B s|), sq_abs (B s),
          abs_nonneg (B s)]
      have Ig : IntegrableOn (fun s => Real.exp (2 * κ * (x - s)) *
          (|A s| * |Y s| + |B s| + |E s| * |H s| + |E' s| * |H' s|)) (Set.Ioi x) := by
        refine IntegrableOn.congr_fun (((I1.add I2).add I3).add I4) (fun s _ => ?_)
          measurableSet_Ioi
        simp only [Pi.add_apply]
        ring
      have mF : AEStronglyMeasurable
          (fun s => A s * Y s + B s + E s * H s + E' s * H' s) volume :=
        (((hA.1.mul hY2.1).add hB.1).add (hE.1.mul hH.1)).add (hE'.1.mul hH'.1)
      have hFle : ∀ s, ‖Real.exp (2 * κ * (x - s)) *
          (A s * Y s + B s + E s * H s + E' s * H' s)‖ ≤
          Real.exp (2 * κ * (x - s)) *
            (|A s| * |Y s| + |B s| + |E s| * |H s| + |E' s| * |H' s|) := by
        intro s
        rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
        refine mul_le_mul_of_nonneg_left ?_ (Real.exp_pos _).le
        have t1 := abs_add_le (A s * Y s + B s + E s * H s) (E' s * H' s)
        have t2 := abs_add_le (A s * Y s + B s) (E s * H s)
        have t3 := abs_add_le (A s * Y s) (B s)
        simp only [abs_mul] at t1 t2 t3
        linarith
      have IF : IntegrableOn (fun s => -(Real.exp (2 * κ * (x - s)) *
          (A s * Y s + B s + E s * H s + E' s * H' s))) (Set.Ioi x) := by
        refine Integrable.mono' Ig ((cex.aestronglyMeasurable.mul mF).neg.restrict) ?_
        refine Filter.Eventually.of_forall fun s => ?_
        rw [norm_neg]
        exact hFle s
      have hG : ∀ s ∈ Set.Ioi x, HasDerivAt (fun s => Real.exp (2 * κ * (x - s)) * Y s)
          (-(Real.exp (2 * κ * (x - s)) * (A s * Y s + B s + E s * H s + E' s * H' s))) s := by
        intro s _
        have h1 : HasDerivAt (fun s => Real.exp (2 * κ * (x - s)))
            (Real.exp (2 * κ * (x - s)) * (2 * κ * (-1))) s :=
          (((hasDerivAt_id' s).const_sub x).const_mul (2 * κ)).exp
        convert h1.mul (hY s) using 1
        ring
      have hGc : ContinuousWithinAt (fun s => Real.exp (2 * κ * (x - s)) * Y s)
          (Set.Ici x) x := (cex.mul hYc).continuousWithinAt
      have hGlim : Filter.Tendsto (fun s => Real.exp (2 * κ * (x - s)) * Y s)
          Filter.atTop (nhds 0) := by
        refine squeeze_zero_norm' ?_ hYn
        filter_upwards [Filter.eventually_gt_atTop x] with s hs
        rw [norm_mul]
        exact mul_le_of_le_one_left (norm_nonneg _) (hEx s hs)
      have hftc := integral_Ioi_of_hasDerivAt_of_tendsto hGc hG IF hGlim
      rw [integral_neg] at hftc
      simp only [sub_self, mul_zero, Real.exp_zero, one_mul, zero_sub, neg_inj] at hftc
      have hbound : ‖∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) *
          (A s * Y s + B s + E s * H s + E' s * H' s)‖ ≤
          ∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) *
          (|A s| * |Y s| + |B s| + |E s| * |H s| + |E' s| * |H' s|) :=
        norm_integral_le_of_norm_le Ig (Filter.Eventually.of_forall hFle)
      have hsplit : ∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) *
          (|A s| * |Y s| + |B s| + |E s| * |H s| + |E' s| * |H' s|) =
          (∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) * (|A s| * |Y s|)) +
          (∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) * |B s|) +
          (∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) * (|E s| * |H s|)) +
          (∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) * (|E' s| * |H' s|)) := by
        calc ∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) *
              (|A s| * |Y s| + |B s| + |E s| * |H s| + |E' s| * |H' s|)
            = ∫ s in Set.Ioi x, (Real.exp (2 * κ * (x - s)) * (|A s| * |Y s|) +
                Real.exp (2 * κ * (x - s)) * |B s| +
                Real.exp (2 * κ * (x - s)) * (|E s| * |H s|) +
                Real.exp (2 * κ * (x - s)) * (|E' s| * |H' s|)) := by
              congr 1; funext s; ring
          _ = (∫ s in Set.Ioi x, (Real.exp (2 * κ * (x - s)) * (|A s| * |Y s|) +
                Real.exp (2 * κ * (x - s)) * |B s| +
                Real.exp (2 * κ * (x - s)) * (|E s| * |H s|))) +
                ∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) * (|E' s| * |H' s|) :=
              integral_add ((I1.add I2).add I3) I4
          _ = (∫ s in Set.Ioi x, (Real.exp (2 * κ * (x - s)) * (|A s| * |Y s|) +
                Real.exp (2 * κ * (x - s)) * |B s|)) +
                (∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) * (|E s| * |H s|)) +
                ∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) * (|E' s| * |H' s|) := by
              congr 1; exact integral_add (I1.add I2) I3
          _ = _ := by rw [integral_add I1 I2]
      have hK : ∀ g : ℝ → ℝ, -riccatiK κ g x =
          ∫ s in Set.Ioi x, Real.exp (2 * κ * (x - s)) * g s := by
        intro g
        unfold riccatiK
        rw [integral_Ici_eq_integral_Ioi, neg_neg]
      rw [hK, hK, hK, hK, ← hsplit, ← hftc, ← Real.norm_eq_abs]
      exact hbound
    
    obtain ⟨hK1, hK2⟩ := riccatiK_sqrt_bounds κ hκ
    have aA : MemLp (fun s => |A s|) 2 (volume : Measure ℝ) := hA.abs
    have aB : MemLp (fun s => |B s|) 2 (volume : Measure ℝ) := hB.abs
    have aE : MemLp (fun s => |E s|) 2 (volume : Measure ℝ) := hE.abs
    have aH : MemLp (fun s => |H s|) 2 (volume : Measure ℝ) := hH.abs
    have aE' : MemLp (fun s => |E' s|) 2 (volume : Measure ℝ) := hE'.abs
    have aH' : MemLp (fun s => |H' s|) 2 (volume : Measure ℝ) := hH'.abs
    have aY : MemLp (fun s => |Y s|) 2 (volume : Measure ℝ) := hY2.abs
    obtain ⟨m1, b1⟩ := hK2 _ _ aA aY
    obtain ⟨m2, b2⟩ := hK1 _ aB
    obtain ⟨m3, b3⟩ := hK2 _ _ aE aH
    obtain ⟨m4, b4⟩ := hK2 _ _ aE' aH'
    rw [habsI, habsI] at b1 b3 b4
    rw [habsI] at b2
    have hint : ∫ x : ℝ, Y x ^ 2 ≤ ∫ x : ℝ, (-riccatiK κ (fun s => |A s| * |Y s|) x +
        -riccatiK κ (fun s => |B s|) x + -riccatiK κ (fun s => |E s| * |H s|) x +
        -riccatiK κ (fun s => |E' s| * |H' s|) x) ^ 2 := by
      refine integral_mono hY2.integrable_sq
        (((m1.neg.add m2.neg).add m3.neg).add m4.neg).integrable_sq ?_
      intro x
      have h1 := hpt x
      have h2 := pow_le_pow_left₀ (abs_nonneg (Y x)) h1 2
      rw [sq_abs] at h2
      exact h2
    have s0' := hadd (fun x => -riccatiK κ (fun s => |A s| * |Y s|) x +
        -riccatiK κ (fun s => |B s|) x + -riccatiK κ (fun s => |E s| * |H s|) x)
        (fun x => -riccatiK κ (fun s => |E' s| * |H' s|) x)
        ((m1.neg.add m2.neg).add m3.neg) m4.neg
    have s1 := hadd (fun x => -riccatiK κ (fun s => |A s| * |Y s|) x +
        -riccatiK κ (fun s => |B s|) x) (fun x => -riccatiK κ (fun s => |E s| * |H s|) x)
        (m1.neg.add m2.neg) m3.neg
    have s2 := hadd (fun x => -riccatiK κ (fun s => |A s| * |Y s|) x)
        (fun x => -riccatiK κ (fun s => |B s|) x) m1.neg m2.neg
    beta_reduce at s0' s1 s2
    rw [hnegI] at s0' s1
    rw [hnegI, hnegI] at s2
    have s0 := Real.sqrt_le_sqrt hint
    linarith
  
  have hmp : MeasurePreserving (fun s : ℝ => -s) volume volume :=
    Measure.measurePreserving_neg volume
  have hrefl : ∀ g : ℝ → ℝ, MemLp g 2 (volume : Measure ℝ) →
      MemLp (fun s => g (-s)) 2 (volume : Measure ℝ) :=
    fun g hg => hg.comp_measurePreserving hmp
  have hreflI : ∀ g : ℝ → ℝ, ∫ s : ℝ, g (-s) ^ 2 = ∫ s : ℝ, g s ^ 2 :=
    fun g => integral_neg_eq_self (fun s => g s ^ 2) volume
  have hk := key (fun s => y (-s)) (fun s => a (-s)) (fun s => b (-s)) (fun s => e₁ (-s))
    (fun s => h₁ (-s)) (fun s => e₂ (-s)) (fun s => h₂ (-s))
    (fun s => ((hy (-s)).comp s (hasDerivAt_neg s)).congr_deriv (by ring))
    (hybot.comp Filter.tendsto_neg_atTop_atBot)
    (hrefl y hy2) (hrefl a ha) (hrefl b hb) (hrefl e₁ he₁) (hrefl h₁ hh₁)
    (hrefl e₂ he₂) (hrefl h₂ hh₂)
  beta_reduce at hk
  rw [hreflI y, hreflI a, hreflI b, hreflI e₁, hreflI h₁, hreflI e₂, hreflI h₂] at hk
  exact hk

theorem riccati_quadratic_remainder (κ : ℝ) (hκ : 1 ≤ κ) (p q : 𝓢(ℝ, ℝ)) (ρp ρq z : ℝ → ℝ)
    (hp : IsRiccatiSol κ p ρp) (hq : IsRiccatiSol κ q ρq)
    (hz2 : MemLp z 2 (volume : Measure ℝ))
    (hz : ∀ x : ℝ, z x = riccatiK κ (fun y => p y - q y) x -
      riccatiK κ (fun y => 2 * ρq y * z y) x) :
    Real.sqrt (∫ x : ℝ, (ρp x - ρq x) ^ 2) ≤
        4 / 3 * Real.sqrt (∫ x : ℝ, riccatiK κ (fun y => p y - q y) x ^ 2) ∧
    Real.sqrt (∫ x : ℝ, (ρp x - ρq x - z x) ^ 2) ≤ 2 / 3 * ∫ x : ℝ, (ρp x - ρq x) ^ 2 :=
by
  have hκ0 : (0 : ℝ) < κ := by linarith
  obtain ⟨hmp, hsp, hep⟩ := hp
  obtain ⟨hmq, hsq, heq⟩ := hq
  obtain ⟨hsub, -⟩ := riccatiK_sub_congr κ hκ0
  
  have hΔm : MemLp (fun y => ρp y - ρq y) 2 (volume : Measure ℝ) := hmp.sub hmq
  have hSm : MemLp (fun y => ρp y + ρq y) 2 (volume : Measure ℝ) := hmp.add hmq
  have hrm : MemLp (fun y => ρp y - ρq y - z y) 2 (volume : Measure ℝ) := (hmp.sub hmq).sub hz2
  have hgm : MemLp (fun y => -2 * ρq y) 2 (volume : Measure ℝ) := hmq.const_mul (-2)
  have h2m : MemLp (fun y => 2 * ρq y) 2 (volume : Measure ℝ) := hmq.const_mul 2
  have i1 : Integrable (fun y => 2 * ρq y * z y) (volume : Measure ℝ) := h2m.integrable_mul hz2
  have i2 : Integrable (fun y => (ρp y + ρq y) * (ρp y - ρq y)) (volume : Measure ℝ) :=
    hSm.integrable_mul hΔm
  have i3 : Integrable (fun y => -2 * ρq y * (ρp y - ρq y - z y)) (volume : Measure ℝ) :=
    hgm.integrable_mul hrm
  have i4 : Integrable (fun y => (ρp y - ρq y) * (ρp y - ρq y)) (volume : Measure ℝ) :=
    hΔm.integrable_mul hΔm
  
  have hdiff : ∀ x, ρp x - ρq x = riccatiK κ (fun y => p y - q y) x -
      riccatiK κ (fun y => (ρp y + ρq y) * (ρp y - ρq y)) x := by
    intro x
    have hq' := hsub (⇑p) (⇑q) (SchwartzMap.integrable p) (SchwartzMap.integrable q) x
    have hw := hsub (fun y => ρp y ^ 2) (fun y => ρq y ^ 2) hmp.integrable_sq
      hmq.integrable_sq x
    beta_reduce at hw
    have hfun : (fun y => (ρp y + ρq y) * (ρp y - ρq y)) = (fun y => ρp y ^ 2 - ρq y ^ 2) := by
      funext y; ring
    rw [hfun, hw, hq']
    linarith [hep x, heq x]
  
  have hr : ∀ x, ρp x - ρq x - z x =
      riccatiK κ (fun y => -2 * ρq y * (ρp y - ρq y - z y)) x -
      riccatiK κ (fun y => (ρp y - ρq y) * (ρp y - ρq y)) x := by
    intro x
    have e1 := hdiff x
    have e2 := hz x
    have e3 := hsub (fun y => 2 * ρq y * z y) (fun y => (ρp y + ρq y) * (ρp y - ρq y)) i1 i2 x
    beta_reduce at e3
    have hfun2 : (fun y => 2 * ρq y * z y - (ρp y + ρq y) * (ρp y - ρq y)) =
        (fun y => -2 * ρq y * (ρp y - ρq y - z y) - (ρp y - ρq y) * (ρp y - ρq y)) := by
      funext y; ring
    rw [hfun2] at e3
    have e4 := hsub (fun y => -2 * ρq y * (ρp y - ρq y - z y))
      (fun y => (ρp y - ρq y) * (ρp y - ρq y)) i3 i4 x
    beta_reduce at e4
    linarith [e1, e2, e3, e4]
  
  obtain ⟨hb, hbB⟩ := riccatiK_mul_bound κ hκ _ _ hSm hΔm
  obtain ⟨hA, hAB⟩ := riccatiK_mul_bound κ hκ _ _ hgm hrm
  obtain ⟨hB, hBB⟩ := riccatiK_mul_bound κ hκ _ _ hΔm hΔm
  have ha : MemLp (riccatiK κ (fun y => p y - q y)) 2 (volume : Measure ℝ) := by
    have h := hΔm.add hb
    have hfeq : ((fun y => ρp y - ρq y) + riccatiK κ (fun y => (ρp y + ρq y) * (ρp y - ρq y))) =
        riccatiK κ (fun y => p y - q y) := by
      funext x
      simp only [Pi.add_apply]
      linarith [hdiff x]
    rw [hfeq] at h
    exact h
  generalize riccatiK κ (fun y => p y - q y) = a at ha hdiff ⊢
  generalize riccatiK κ (fun y => (ρp y + ρq y) * (ρp y - ρq y)) = b at hb hbB hdiff
  generalize riccatiK κ (fun y => -2 * ρq y * (ρp y - ρq y - z y)) = A at hA hAB hr
  generalize riccatiK κ (fun y => (ρp y - ρq y) * (ρp y - ρq y)) = B at hB hBB hr
  have D0 : 0 ≤ ∫ x, (ρp x - ρq x) ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  have R0 : 0 ≤ ∫ x, (ρp x - ρq x - z x) ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  have a0 : 0 ≤ ∫ x, a x ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  
  have hP : ∫ y, (ρp y + ρq y) ^ 2 ≤ 1 / 4 := by
    have hint1 : Integrable (fun y => (ρp y + ρq y) ^ 2) volume := hSm.integrable_sq
    have hint2 : Integrable (fun y => 2 * ρp y ^ 2 + 2 * ρq y ^ 2) volume :=
      (hmp.integrable_sq.const_mul 2).add (hmq.integrable_sq.const_mul 2)
    have hmono : ∫ y, (ρp y + ρq y) ^ 2 ≤ ∫ y, (2 * ρp y ^ 2 + 2 * ρq y ^ 2) :=
      integral_mono hint1 hint2 (fun y => by
        show (ρp y + ρq y) ^ 2 ≤ 2 * ρp y ^ 2 + 2 * ρq y ^ 2
        nlinarith [sq_nonneg (ρp y - ρq y)])
    rw [integral_add (hmp.integrable_sq.const_mul 2) (hmq.integrable_sq.const_mul 2),
      integral_const_mul, integral_const_mul] at hmono
    linarith
  have hG : ∫ y, (-2 * ρq y) ^ 2 ≤ 1 / 4 := by
    have : (fun y => (-2 * ρq y) ^ 2) = fun y => 4 * ρq y ^ 2 := by funext y; ring
    rw [this, integral_const_mul]
    linarith
  
  have hD : ∫ x, (ρp x - ρq x) ^ 2 ≤ 16 / 9 * ∫ x, a x ^ 2 := by
    have hDeq : ∫ x, (ρp x - ρq x) ^ 2 = ∫ x, (a x - b x) ^ 2 := by
      congr 1; funext x; rw [hdiff x]
    have hia := ha.integrable_sq
    have hib := hb.integrable_sq
    have hmono : ∫ x, (a x - b x) ^ 2 ≤ ∫ x, (4 / 3 * a x ^ 2 + 4 * b x ^ 2) :=
      integral_mono (ha.sub hb).integrable_sq ((hia.const_mul (4 / 3)).add (hib.const_mul 4))
        (fun x => by
          show (a x - b x) ^ 2 ≤ 4 / 3 * a x ^ 2 + 4 * b x ^ 2
          nlinarith [sq_nonneg (a x + 3 * b x)])
    rw [integral_add (hia.const_mul (4 / 3)) (hib.const_mul 4), integral_const_mul,
      integral_const_mul, ← hDeq] at hmono
    have hPD := mul_le_mul_of_nonneg_right hP D0
    nlinarith
  
  have hR : ∫ x, (ρp x - ρq x - z x) ^ 2 ≤ 4 / 9 * (∫ x, (ρp x - ρq x) ^ 2) ^ 2 := by
    have hReq : ∫ x, (ρp x - ρq x - z x) ^ 2 = ∫ x, (A x - B x) ^ 2 := by
      congr 1; funext x; rw [hr x]
    have hiA := hA.integrable_sq
    have hiB := hB.integrable_sq
    have hmono : ∫ x, (A x - B x) ^ 2 ≤ ∫ x, (4 * A x ^ 2 + 4 / 3 * B x ^ 2) :=
      integral_mono (hA.sub hB).integrable_sq ((hiA.const_mul 4).add (hiB.const_mul (4 / 3)))
        (fun x => by
          show (A x - B x) ^ 2 ≤ 4 * A x ^ 2 + 4 / 3 * B x ^ 2
          nlinarith [sq_nonneg (3 * A x + B x)])
    rw [integral_add (hiA.const_mul 4) (hiB.const_mul (4 / 3)), integral_const_mul,
      integral_const_mul, ← hReq] at hmono
    have hGR := mul_le_mul_of_nonneg_right hG R0
    nlinarith
  refine ⟨?_, ?_⟩
  · rw [Real.sqrt_le_iff]
    refine ⟨by positivity, ?_⟩
    rw [mul_pow, Real.sq_sqrt a0]
    linarith
  · rw [Real.sqrt_le_iff]
    refine ⟨by positivity, ?_⟩
    nlinarith

theorem green_quadratic_remainder : ∃ δ > (0 : ℝ), ∀ κ ≥ (1 : ℝ), ∃ M ≥ (0 : ℝ), ∀ p q : 𝓢(ℝ, ℝ),
    ‖ι p‖ ≤ δ → ‖ι q‖ ≤ δ → ∀ e : 𝓢(ℝ, ℝ), LinGreenODE κ q (p - q) e →
    ‖ι (SchwartzMap.derivCLM ℝ ℝ (greenOffset κ p - greenOffset κ q - e))‖ ≤ M * ‖ι p - ι q‖ ^ 2 :=
by
  classical
  obtain ⟨δU, hδU, hU⟩ := green_exists_unique
  refine ⟨min (1 / 8) δU, lt_min (by norm_num) hδU, ?_⟩
  intro κ hκ
  refine ⟨7, by norm_num, ?_⟩
  intro p q hp hq e he
  have hκ0 : (0 : ℝ) < κ := by linarith
  have hκne : κ ≠ 0 := hκ0.ne'
  have hp8 : ‖ι p‖ ≤ 1 / 8 := le_trans hp (min_le_left _ _)
  have hq8 : ‖ι q‖ ≤ 1 / 8 := le_trans hq (min_le_left _ _)
  have hpU : ‖ι p‖ ≤ δU := le_trans hp (min_le_right _ _)
  have hqU : ‖ι q‖ ≤ δU := le_trans hq (min_le_right _ _)
  
  have hsmallK : ∀ v : 𝓢(ℝ, ℝ), ‖ι v‖ ≤ 1 / 8 →
      MemLp (riccatiK κ v) 2 (volume : Measure ℝ) ∧ ∫ x : ℝ, riccatiK κ v x ^ 2 ≤ 1 / 64 := by
    intro v hv
    obtain ⟨hm, heq⟩ := riccatiK_sq_integral κ hκ0 v
    refine ⟨hm, ?_⟩
    rw [heq]
    have h1 := ((Hm1_weight_basic (toHm1 v)).2 κ hκ).2.1
    have h2 : ‖toHm1 v‖ ≤ 1 / 8 := hv
    have h3 : ‖toHm1 v‖ ^ 2 ≤ (1 / 8) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) h2 2
    have h4 : ((1 : ℝ) / 8) ^ 2 = 1 / 64 := by norm_num
    linarith
  obtain ⟨mp, sp⟩ := hsmallK p hp8
  obtain ⟨mq, sq⟩ := hsmallK q hq8
  obtain ⟨⟨ρp, hρp⟩, -⟩ := riccati_fixed_point κ hκ p mp sp
  obtain ⟨⟨ρq, hρq⟩, -⟩ := riccati_fixed_point κ hκ q mq sq
  have hgreen : ∀ v : 𝓢(ℝ, ℝ), ‖ι v‖ ≤ δU → GreenODE κ v (greenOffset κ v) := by
    intro v hv
    have hex := (hU κ hκ v hv).exists
    unfold greenOffset
    rw [dif_pos hex]
    exact Classical.choose_spec hex
  
  have hsq16 : Real.sqrt (1 / 16) = 1 / 4 := by
    rw [show (1 / 16 : ℝ) = (1 / 4) ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
  have hSρ : ∀ (v : 𝓢(ℝ, ℝ)) (ρ : ℝ → ℝ), IsRiccatiSol κ v ρ →
      Real.sqrt (∫ x : ℝ, ρ x ^ 2) ≤ 1 / 4 := by
    intro v ρ hρ
    rw [← hsq16]
    exact Real.sqrt_le_sqrt hρ.2.1
  have hscale : ∀ (c : ℝ) (f : ℝ → ℝ), 0 ≤ c →
      Real.sqrt (∫ x : ℝ, (c * f x) ^ 2) = c * Real.sqrt (∫ x : ℝ, f x ^ 2) := by
    intro c f hc
    have : (fun x : ℝ => (c * f x) ^ 2) = fun x : ℝ => c ^ 2 * f x ^ 2 := by
      funext x; ring
    rw [this, integral_const_mul, Real.sqrt_mul (sq_nonneg c), Real.sqrt_sq hc]
  have hkinv0 : 0 ≤ κ⁻¹ := inv_nonneg.2 hκ0.le
  have hkinv1 : κ⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hκ
  have hscaleK : ∀ f : ℝ → ℝ, Real.sqrt (∫ x : ℝ, (κ⁻¹ * f x) ^ 2) ≤
      Real.sqrt (∫ x : ℝ, f x ^ 2) := by
    intro f
    rw [hscale _ _ hkinv0]
    have := Real.sqrt_nonneg (∫ x : ℝ, f x ^ 2)
    nlinarith
  
  have hred : ∀ (q γ : 𝓢(ℝ, ℝ)), GreenODE κ q γ → ∀ x : ℝ, iteratedDeriv 3 (⇑γ) x =
      deriv (⇑q) x / κ + 2 * deriv (⇑q) x * γ x + 4 * q x * deriv (⇑γ) x +
        4 * κ ^ 2 * deriv (⇑γ) x := by
    intro q γ hγ x
    have h := hγ x
    have e1 : iteratedDeriv 3 (fun y => 1 / (2 * κ) + γ y) x = iteratedDeriv 3 (⇑γ) x := by
      rw [iteratedDeriv_const_add (by norm_num : 0 < 3)]
    have e2 : deriv (fun y => 1 / (2 * κ) + γ y) x = deriv (⇑γ) x := deriv_const_add _
    have e3 : deriv (fun y => q y * (1 / (2 * κ) + γ y)) x =
        deriv (⇑q) x * (1 / (2 * κ) + γ x) + q x * deriv (⇑γ) x := by
      have := ((q.differentiableAt (x := x)).hasDerivAt).mul
        (((γ.differentiableAt (x := x)).hasDerivAt).const_add (1 / (2 * κ)))
      exact this.deriv
    rw [e1, e2, e3] at h
    rw [h]
    field_simp
    ring
  
  have hdecay : ∀ F : 𝓢(ℝ, ℝ), Filter.Tendsto (⇑F) Filter.atTop (nhds 0) ∧
      Filter.Tendsto (⇑F) Filter.atBot (nhds 0) := by
    intro F
    have h := F.toZeroAtInfty.zero_at_infty'
    rw [cocompact_eq_atBot_atTop, Filter.tendsto_sup] at h
    exact ⟨h.2, h.1⟩
  
  have ode_zero : ∀ (m v u : ℝ → ℝ), Continuous m → (∀ x : ℝ, HasDerivAt v (u x) x) →
      (∀ x : ℝ, HasDerivAt u (m x * u x) x) → Filter.Tendsto v Filter.atTop (nhds 0) →
      Filter.Tendsto v Filter.atBot (nhds 0) → ∀ x : ℝ, v x = 0 := by
    intro m v u hm hv hu htop hbot
    obtain ⟨P, hP⟩ : ∃ P : ℝ → ℝ, ∀ x : ℝ, HasDerivAt P (m x) x :=
      ⟨fun x => ∫ t in (0 : ℝ)..x, m t, fun x => (hm.integral_hasStrictDerivAt 0 x).hasDerivAt⟩
    have hΦ : ∀ x : ℝ, HasDerivAt (fun y => u y * Real.exp (-P y)) 0 x := by
      intro x
      have := (hu x).mul ((hP x).neg.exp)
      convert this using 1
      ring
    have hconst : ∀ x : ℝ, u x * Real.exp (-P x) = u 0 * Real.exp (-P 0) := by
      intro x
      exact is_const_of_deriv_eq_zero (fun y => (hΦ y).differentiableAt)
        (fun y => (hΦ y).deriv) x 0
    obtain ⟨c, hc⟩ : ∃ c : ℝ, c = u 0 * Real.exp (-P 0) := ⟨_, rfl⟩
    have hu_eq : ∀ x : ℝ, u x = c * Real.exp (P x) := by
      intro x
      have h1 := hconst x
      have h2 : Real.exp (-P x) * Real.exp (P x) = 1 := by
        rw [← Real.exp_add]; simp
      calc u x = u x * Real.exp (-P x) * Real.exp (P x) := by rw [mul_assoc, h2, mul_one]
        _ = c * Real.exp (P x) := by rw [h1, hc]
    intro x
    rcases le_total 0 c with hc0 | hc0
    · have hmono : Monotone v := monotone_of_deriv_nonneg (fun y => (hv y).differentiableAt)
        (fun y => by rw [(hv y).deriv, hu_eq y]; exact mul_nonneg hc0 (Real.exp_pos _).le)
      have h1 := hmono.ge_of_tendsto htop x
      have h2 := hmono.le_of_tendsto hbot x
      linarith
    · have hanti : Antitone v := antitone_of_deriv_nonpos (fun y => (hv y).differentiableAt)
        (fun y => by
          rw [(hv y).deriv, hu_eq y]
          exact mul_nonpos_of_nonpos_of_nonneg hc0 (Real.exp_pos _).le)
      have h1 := hanti.le_of_tendsto htop x
      have h2 := hanti.ge_of_tendsto hbot x
      linarith
  
  have hlink : ∀ (q γ : 𝓢(ℝ, ℝ)) (ρ : ℝ → ℝ), GreenODE κ q γ → IsRiccatiSol κ q ρ →
      ∀ x : ℝ, deriv (⇑γ) x = 2 * (ρ x - κ) * γ x + ρ x / κ := by
    intro q γ ρ hγ hρ
    obtain ⟨hρc, -, hρtop, hρbot, hρd⟩ := riccati_sol_regularity κ hκ0 q ρ hρ
    have hdγ : deriv (⇑γ) = ⇑(SchwartzMap.derivCLM ℝ ℝ γ) :=
      funext fun x => (SchwartzMap.derivCLM_apply ℝ γ x).symm
    have hγ3 := hred q γ hγ
    have hdDγ : deriv (⇑(SchwartzMap.derivCLM ℝ ℝ γ)) =
        ⇑(SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ)) :=
      funext fun x => (SchwartzMap.derivCLM_apply ℝ _ x).symm
    have e2 : iteratedDeriv 2 (⇑γ) =
        ⇑(SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ)) := by
      rw [iteratedDeriv_succ, iteratedDeriv_one, hdγ, hdDγ]
    have e3 : iteratedDeriv 3 (⇑γ) = deriv (iteratedDeriv 2 (⇑γ)) := iteratedDeriv_succ
    have hf : ∀ x : ℝ,
        HasDerivAt (fun y => deriv (⇑γ) y - 2 * (ρ y - κ) * γ y - ρ y / κ)
          (iteratedDeriv 2 (⇑γ) x - 2 * (q x + 2 * κ * ρ x - ρ x ^ 2) * γ x
            - 2 * (ρ x - κ) * deriv (⇑γ) x - (q x + 2 * κ * ρ x - ρ x ^ 2) / κ) x ∧
        HasDerivAt (fun y => iteratedDeriv 2 (⇑γ) y - 2 * (q y + 2 * κ * ρ y - ρ y ^ 2) * γ y
            - 2 * (ρ y - κ) * deriv (⇑γ) y - (q y + 2 * κ * ρ y - ρ y ^ 2) / κ)
          (-2 * (ρ x - κ) * (iteratedDeriv 2 (⇑γ) x - 2 * (q x + 2 * κ * ρ x - ρ x ^ 2) * γ x
            - 2 * (ρ x - κ) * deriv (⇑γ) x - (q x + 2 * κ * ρ x - ρ x ^ 2) / κ)) x := by
      intro x
      have hγ1 : HasDerivAt (⇑γ) (deriv (⇑γ) x) x := (γ.differentiableAt (x := x)).hasDerivAt
      have hγ2 : HasDerivAt (deriv (⇑γ)) (iteratedDeriv 2 (⇑γ) x) x := by
        rw [e2, hdγ]
        have := ((SchwartzMap.derivCLM ℝ ℝ γ).differentiableAt (x := x)).hasDerivAt
        rwa [hdDγ] at this
      have hγ3' : HasDerivAt (iteratedDeriv 2 (⇑γ)) (iteratedDeriv 3 (⇑γ) x) x := by
        rw [e3, e2]
        exact ((SchwartzMap.derivCLM ℝ ℝ
          (SchwartzMap.derivCLM ℝ ℝ γ)).differentiableAt (x := x)).hasDerivAt
      have hq : HasDerivAt (⇑q) (deriv (⇑q) x) x := (q.differentiableAt (x := x)).hasDerivAt
      have hsq : HasDerivAt (fun y => ρ y ^ 2)
          (2 * ρ x * (q x + 2 * κ * ρ x - ρ x ^ 2)) x := by
        convert (hρd x).mul (hρd x) using 1
        · funext y; show ρ y ^ 2 = ρ y * ρ y; ring
        · ring
      have hW : HasDerivAt (fun y => q y + 2 * κ * ρ y - ρ y ^ 2)
          (deriv (⇑q) x + 2 * κ * (q x + 2 * κ * ρ x - ρ x ^ 2)
            - 2 * ρ x * (q x + 2 * κ * ρ x - ρ x ^ 2)) x :=
        (hq.add ((hρd x).const_mul (2 * κ))).sub hsq
      constructor
      · have h := (hγ2.sub ((((hρd x).sub_const κ).const_mul 2).mul hγ1)).sub
          ((hρd x).div_const κ)
        convert h using 1
        ring
      · have h := (((hγ3'.sub ((hW.const_mul 2).mul hγ1)).sub
          ((((hρd x).sub_const κ).const_mul 2).mul hγ2)).sub (hW.div_const κ))
        convert h using 1
        linear_combination (-1 : ℝ) * hγ3 x
    have e0 : (0 : ℝ) - 2 * (0 - κ) * 0 - 0 / κ = 0 := by ring
    have htop : Filter.Tendsto (fun y => deriv (⇑γ) y - 2 * (ρ y - κ) * γ y - ρ y / κ)
        Filter.atTop (nhds 0) := by
      rw [hdγ]
      have h := (((hdecay (SchwartzMap.derivCLM ℝ ℝ γ)).1.sub
        (((hρtop.sub_const κ).const_mul 2).mul (hdecay γ).1)).sub (hρtop.div_const κ))
      rw [e0] at h
      exact h
    have hbot : Filter.Tendsto (fun y => deriv (⇑γ) y - 2 * (ρ y - κ) * γ y - ρ y / κ)
        Filter.atBot (nhds 0) := by
      rw [hdγ]
      have h := (((hdecay (SchwartzMap.derivCLM ℝ ℝ γ)).2.sub
        (((hρbot.sub_const κ).const_mul 2).mul (hdecay γ).2)).sub (hρbot.div_const κ))
      rw [e0] at h
      exact h
    have hm : Continuous (fun x => -2 * (ρ x - κ)) :=
      continuous_const.mul (hρc.sub continuous_const)
    have hv0 := ode_zero (fun x => -2 * (ρ x - κ))
      (fun y => deriv (⇑γ) y - 2 * (ρ y - κ) * γ y - ρ y / κ)
      (fun y => iteratedDeriv 2 (⇑γ) y - 2 * (q y + 2 * κ * ρ y - ρ y ^ 2) * γ y
          - 2 * (ρ y - κ) * deriv (⇑γ) y - (q y + 2 * κ * ρ y - ρ y ^ 2) / κ)
      hm (fun x => (hf x).1) (fun x => (hf x).2) htop hbot
    intro x
    have := hv0 x
    simp only at this
    linarith
  have linkp := hlink p (greenOffset κ p) ρp (hgreen p hpU) hρp
  have linkq := hlink q (greenOffset κ q) ρq (hgreen q hqU) hρq
  
  obtain ⟨hρc, -, hρtop, hρbot, hρd⟩ := riccati_sol_regularity κ hκ0 q ρq hρq
  have hqfun : (⇑(p - q) : ℝ → ℝ) = fun y => p y - q y := by
    funext y; simp
  obtain ⟨mKf, hKfeq⟩ := riccatiK_sq_integral κ hκ0 (p - q)
  rw [hqfun] at mKf hKfeq
  obtain ⟨z, hz2, hz⟩ := riccati_linear_solve κ hκ ρq (riccatiK κ (fun y => p y - q y))
    hρq.1 hρq.2.1 mKf
  obtain ⟨-, -, hztop, hzbot, hzd⟩ := riccati_response_regularity κ hκ0 (fun y => p y - q y) ρq z
    (p.continuous.sub q.continuous) ((SchwartzMap.integrable p).sub (SchwartzMap.integrable q))
    hρc hρq.1 hz2 hz
  have hzd' : ∀ x : ℝ, HasDerivAt z (2 * κ * z x + (p - q) x - 2 * ρq x * z x) x := by
    intro x
    have h := hzd x
    simp only [SchwartzMap.sub_apply]
    exact h
  
  have elink := lin_green_riccati_link κ hκ0 q (p - q) e ρq z hρc hρtop hρbot hρd hztop hzbot
    hzd' linkq he
  obtain ⟨γp, hγp⟩ : ∃ g : 𝓢(ℝ, ℝ), g = greenOffset κ p := ⟨_, rfl⟩
  obtain ⟨γq, hγq⟩ : ∃ g : 𝓢(ℝ, ℝ), g = greenOffset κ q := ⟨_, rfl⟩
  rw [← hγp] at linkp ⊢
  rw [← hγq] at linkq elink ⊢
  
  have hSρp := hSρ p ρp hρp
  have hSρq := hSρ q ρq hρq
  have hγbd : ∀ (γ : 𝓢(ℝ, ℝ)) (ρ : ℝ → ℝ), MemLp ρ 2 (volume : Measure ℝ) →
      Real.sqrt (∫ x : ℝ, ρ x ^ 2) ≤ 1 / 4 →
      (∀ x : ℝ, deriv (⇑γ) x = 2 * (ρ x - κ) * γ x + ρ x / κ) →
      Real.sqrt (∫ x : ℝ, γ x ^ 2) ≤ 1 / 6 := by
    intro γ ρ hρ2 hSr hl
    have h := linear_decay_L2_bound2 κ hκ (⇑γ) ρ (fun x => κ⁻¹ * ρ x) ρ (fun x => 1 / 2 * γ x)
      ρ (fun x => 1 / 2 * γ x)
      (fun x => by
        have h := (γ.differentiableAt (x := x)).hasDerivAt
        convert h using 1
        rw [hl x]
        field_simp
        ring)
      (hdecay γ).2 (γ.memLp 2) hρ2 (hρ2.const_mul κ⁻¹) hρ2 ((γ.memLp 2).const_mul (1 / 2))
      hρ2 ((γ.memLp 2).const_mul (1 / 2))
    rw [hscale (1 / 2) _ (by norm_num)] at h
    have hb := hscaleK ρ
    have hSγ0 := Real.sqrt_nonneg (∫ x : ℝ, γ x ^ 2)
    have hSρ0 := Real.sqrt_nonneg (∫ x : ℝ, ρ x ^ 2)
    nlinarith [mul_nonneg (sub_nonneg.2 hSr) hSγ0]
  have hSγp := hγbd γp ρp hρp.1 hSρp linkp
  have hSγq := hγbd γq ρq hρq.1 hSρq linkq
  have hS2ρq : Real.sqrt (∫ x : ℝ, (2 * ρq x) ^ 2) ≤ 1 / 2 := by
    rw [hscale 2 _ (by norm_num)]
    linarith
  have hS2γq : Real.sqrt (∫ x : ℝ, (2 * γq x) ^ 2) ≤ 1 / 3 := by
    rw [hscale 2 _ (by norm_num)]
    linarith
  have hd := linear_decay_L2_bound2 κ hκ (fun x => γp x - γq x) (fun x => 2 * ρq x)
    (fun x => κ⁻¹ * (ρp x - ρq x)) (fun x => ρp x - ρq x) (⇑γp) (fun x => ρp x - ρq x) (⇑γp)
    (fun x => by
      have h := ((γp.differentiableAt (x := x)).hasDerivAt).sub
        ((γq.differentiableAt (x := x)).hasDerivAt)
      convert h using 1
      rw [linkp x, linkq x]
      field_simp
      ring)
    (by
      have h := (hdecay γp).2.sub (hdecay γq).2
      rw [sub_zero] at h
      exact h)
