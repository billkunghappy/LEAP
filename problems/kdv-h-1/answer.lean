      ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 ≤
        K ^ 2 * h ^ 2 + 20 * ((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * K ^ 2)) := by
    intro n K h hK
