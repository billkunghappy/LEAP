theorem periodic_lipschitz_flow_T : ∀ (G : (ℝ → ℝ) → ℝ → ℝ), (∀ w : ℝ → ℝ, Continuous w → Function.Periodic w 1 → Continuous (G w) ∧ Function.Periodic (G w) 1) → (∃ M : ℝ, ∀ w : ℝ → ℝ, Continuous w → Function.Periodic w 1 → ∀ x, |G w x| ≤ M) → (∃ L : ℝ, 0 ≤ L ∧ ∀ w₁ w₂ : ℝ → ℝ, Continuous w₁ → Function.Periodic w₁ 1 → Continuous w₂ → Function.Periodic w₂ 1 → ∀ D : ℝ, (∀ y, |w₁ y - w₂ y| ≤ D) → ∀ x, |G w₁ x - G w₂ x| ≤ L * D) → ∀ w₀ : ℝ → ℝ, Continuous w₀ → Function.Periodic w₀ 1 → ∃ V : ℝ → ℝ → ℝ, (∀ x, V 0 x = w₀ x) ∧ Continuous (fun p : ℝ × ℝ => V p.1 p.2) ∧ (∀ t, Function.Periodic (V t) 1) ∧ (∀ t x, HasDerivAt (fun s => V s x) (G (V t) x) t) ∧ (∀ t, HasDerivAt (fun s => ∫ x in (0:ℝ)..1, V s x ^ 2) (2 * ∫ x in (0:ℝ)..1, V t x * G (V t) x) t) :=
