      have h2 : (∫ x in (0:ℝ)..1, ((F (γS t) : S) : BoundedContinuousFunction ℝ ℝ) x * γ t x) =
          ∫ x in (0:ℝ)..1, γ t x * G ⇑(γ t) x := by
        rw [← h1]
        congr 1
        funext x
        ring
      rw [h1, h2]
      ring
    rw [e1, e2] at hB
    exact hB
  
  refine ⟨fun t x => γ t x, ?_, ?_, ?_, ?_, ?_⟩
  · intro x
    show (γS 0 : BoundedContinuousFunction ℝ ℝ) x = w₀ x
    rw [hγS0]
    rfl
  · exact continuous_eval.comp ((hγc.comp continuous_fst).prodMk continuous_snd)
  · intro t
    exact hper (γS t)
  · intro t x
    have h := (BoundedContinuousFunction.evalCLM ℝ x).hasFDerivAt.comp_hasDerivAt t (hγd t)
    exact h
  · intro t
    exact key t

theorem wfieldTclamp_continuous_periodic : ∀ (κ ρ : ℝ) (w : ℝ → ℝ), Continuous w → Continuous (wfieldTclamp κ ρ w) ∧ (Function.Periodic w 1 → Function.Periodic (wfieldTclamp κ ρ w) 1) :=
by
  intro κ ρ w hw
  have hii : ∀ a b : ℝ, IntervalIntegrable w MeasureTheory.volume a b :=
    fun a b => hw.intervalIntegrable a b
  set P : ℝ → ℝ := fun b => ∫ y in (0:ℝ)..b, w y with hPdef
  have hP : Continuous P := intervalIntegral.continuous_primitive hii 0
  have hwinA : ∀ x s : ℝ, (∫ y in (x - s)..x, w y) = P x - P (x - s) := by
    intro x s
    simp only [hPdef]
    rw [intervalIntegral.integral_interval_sub_left (hii 0 x) (hii 0 (x - s))]
  have hwinB : ∀ x s : ℝ, (∫ y in x..(x + s), w y) = P (x + s) - P x := by
    intro x s
    simp only [hPdef]
    rw [intervalIntegral.integral_interval_sub_left (hii 0 (x + s)) (hii 0 x)]
  have hcl : ∀ {g : ℝ × ℝ → ℝ}, Continuous g → Continuous fun p => wclamp ρ (g p) := by
    intro g hg
    unfold wclamp
    exact continuous_const.max (hg.min continuous_const)
  have hA : Continuous fun x : ℝ =>
      ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * wclamp ρ (∫ y in (x - s)..x, w y)) := by
    have hf : Continuous (Function.uncurry fun x s : ℝ =>
        Real.exp (-2 * κ * s + 2 * wclamp ρ (∫ y in (x - s)..x, w y))) := by
      have heq : (Function.uncurry fun x s : ℝ =>
          Real.exp (-2 * κ * s + 2 * wclamp ρ (∫ y in (x - s)..x, w y))) =
          fun p : ℝ × ℝ => Real.exp (-2 * κ * p.2 + 2 * wclamp ρ (P p.1 - P (p.1 - p.2))) := by
        funext p
        simp only [Function.uncurry, hwinA]
      rw [heq]
      have hg : Continuous fun p : ℝ × ℝ => P p.1 - P (p.1 - p.2) :=
        (hP.comp continuous_fst).sub (hP.comp (continuous_fst.sub continuous_snd))
      exact Real.continuous_exp.comp
        ((continuous_const.mul continuous_snd).add (continuous_const.mul (hcl hg)))
    exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hf 0 1
  have hB : Continuous fun x : ℝ =>
      ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * wclamp ρ (∫ y in x..(x + s), w y)) := by
    have hf : Continuous (Function.uncurry fun x s : ℝ =>
        Real.exp (-2 * κ * s + 2 * wclamp ρ (∫ y in x..(x + s), w y))) := by
      have heq : (Function.uncurry fun x s : ℝ =>
          Real.exp (-2 * κ * s + 2 * wclamp ρ (∫ y in x..(x + s), w y))) =
          fun p : ℝ × ℝ => Real.exp (-2 * κ * p.2 + 2 * wclamp ρ (P (p.1 + p.2) - P p.1)) := by
        funext p
        simp only [Function.uncurry, hwinB]
      rw [heq]
      have hg : Continuous fun p : ℝ × ℝ => P (p.1 + p.2) - P p.1 :=
        (hP.comp (continuous_fst.add continuous_snd)).sub (hP.comp continuous_fst)
      exact Real.continuous_exp.comp
        ((continuous_const.mul continuous_snd).add (continuous_const.mul (hcl hg)))
    exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hf 0 1
  refine ⟨?_, ?_⟩
  · unfold wfieldTclamp
    exact continuous_const.mul (hA.sub hB)
  · intro hp x
    have hp' : ∀ y : ℝ, w (y + 1) = w y := hp
    have hpA : ∀ s : ℝ, (∫ y in (x + 1 - s)..(x + 1), w y) = ∫ y in (x - s)..x, w y := by
      intro s
      have h1 := intervalIntegral.integral_comp_add_right w (a := x - s) (b := x) 1
      simp only [hp'] at h1
      rw [h1]
      congr 1
      ring
    have hpB : ∀ s : ℝ, (∫ y in (x + 1)..(x + 1 + s), w y) = ∫ y in x..(x + s), w y := by
      intro s
      have h1 := intervalIntegral.integral_comp_add_right w (a := x) (b := x + s) 1
      simp only [hp'] at h1
      rw [h1]
      congr 1
      ring
    unfold wfieldTclamp
    simp only [hpA, hpB]

theorem wfieldTclamp_bound_lipschitz : ∀ κ ≥ (1 : ℝ), ∀ ρ ≥ (0 : ℝ), 2 * ρ ≤ κ → (∀ w : ℝ → ℝ, Continuous w → ∀ x, |wfieldTclamp κ ρ w x| ≤ 16 * κ ^ 5 * Real.exp (2 * ρ)) ∧ (∀ w₁ w₂ : ℝ → ℝ, Continuous w₁ → Continuous w₂ → ∀ D : ℝ, (∀ y, |w₁ y - w₂ y| ≤ D) → ∀ x, |wfieldTclamp κ ρ w₁ x - wfieldTclamp κ ρ w₂ x| ≤ 128 * κ ^ 5 * Real.exp (2 * ρ) * D) :=
by
  intro κ hκ ρ hρ h2ρ
  have hk0 : (0 : ℝ) ≤ κ := by linarith
  have h8 : (0 : ℝ) ≤ 8 * κ ^ 5 := mul_nonneg (by norm_num) (pow_nonneg hk0 5)
  
  have exp_lip : ∀ p q m : ℝ, p ≤ m → q ≤ m →
      |Real.exp p - Real.exp q| ≤ Real.exp m * |p - q| := by
    have key : ∀ p q m : ℝ, q ≤ p → p ≤ m →
        |Real.exp p - Real.exp q| ≤ Real.exp m * |p - q| := by
      intro p q m hqp hpm
      have h1 : Real.exp q ≤ Real.exp p := Real.exp_le_exp.2 hqp
      rw [abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]
      have h2 : Real.exp q = Real.exp p * Real.exp (q - p) := by
        rw [← Real.exp_add]; congr 1; ring
      have h3 := Real.add_one_le_exp (q - p)
      have h4 : Real.exp p ≤ Real.exp m := Real.exp_le_exp.2 hpm
      have h5 := Real.exp_pos p
      rw [h2]
      nlinarith [mul_le_mul_of_nonneg_left h3 h5.le,
        mul_le_mul_of_nonneg_right h4 (sub_nonneg.2 hqp)]
    intro p q m hp hq
    rcases le_total q p with h | h
    · exact key p q m h hp
    · rw [abs_sub_comm, abs_sub_comm p q]; exact key q p m h hq
  
  have cl_le : ∀ a, wclamp ρ a ≤ ρ := fun a => max_le (by linarith) (min_le_right a ρ)
  have cl_lip : ∀ a b, |wclamp ρ a - wclamp ρ b| ≤ |a - b| := by
    intro a b
    have h1 := le_abs_self (a - b)
    have h2 := neg_abs_le (a - b)
    rw [abs_le]
    unfold wclamp
    constructor <;> (simp only [max_def, min_def]; split_ifs <;> linarith)
  have clcont : ∀ F : ℝ → ℝ, Continuous F → Continuous fun s => wclamp ρ (F s) := by
    intro F hF
    unfold wclamp
    exact continuous_const.max (hF.min continuous_const)
  
  have pre : ∀ a₁ a₂ : ℝ, a₁ ≤ -1 → a₂ ≤ -1 → 0 < (1 - Real.exp a₁)⁻¹ ∧
      (1 - Real.exp a₁)⁻¹ ≤ 2 ∧
      |(1 - Real.exp a₁)⁻¹ - (1 - Real.exp a₂)⁻¹| ≤ 4 * |a₁ - a₂| := by
    intro a₁ a₂ h₁ h₂
    have hh := Real.exp_neg_one_lt_half
    have e1 : Real.exp a₁ ≤ Real.exp (-1) := Real.exp_le_exp.2 h₁
    have e2 : Real.exp a₂ ≤ Real.exp (-1) := Real.exp_le_exp.2 h₂
    have p1 : 0 < 1 - Real.exp a₁ := by linarith
    have p2 : 0 < 1 - Real.exp a₂ := by linarith
    have b1 : (1 - Real.exp a₁)⁻¹ ≤ 2 := by
      rw [inv_le_iff_one_le_mul₀ p1]; linarith
    have b2 : (1 - Real.exp a₂)⁻¹ ≤ 2 := by
      rw [inv_le_iff_one_le_mul₀ p2]; linarith
    refine ⟨inv_pos.2 p1, b1, ?_⟩
    have hid : (1 - Real.exp a₁)⁻¹ - (1 - Real.exp a₂)⁻¹ =
        (Real.exp a₁ - Real.exp a₂) * ((1 - Real.exp a₁)⁻¹ * (1 - Real.exp a₂)⁻¹) := by
      field_simp; ring
    rw [hid, abs_mul, abs_of_pos (mul_pos (inv_pos.2 p1) (inv_pos.2 p2))]
    have hl := exp_lip a₁ a₂ 0 (by linarith) (by linarith)
    rw [Real.exp_zero, one_mul] at hl
    have q1 := inv_pos.2 p1
    have q2 := inv_pos.2 p2
    have hprod : (1 - Real.exp a₁)⁻¹ * (1 - Real.exp a₂)⁻¹ ≤ 4 := by
      nlinarith [mul_le_mul b1 b2 q2.le (by norm_num : (0:ℝ) ≤ 2)]
    calc |Real.exp a₁ - Real.exp a₂| * ((1 - Real.exp a₁)⁻¹ * (1 - Real.exp a₂)⁻¹)
        ≤ |a₁ - a₂| * 4 := mul_le_mul hl hprod (by positivity) (abs_nonneg _)
      _ = 4 * |a₁ - a₂| := by ring
  
  have intest : ∀ D : ℝ, ∀ g₁ g₂ : ℝ → ℝ, Continuous g₁ → Continuous g₂ →
      (∀ s, g₁ s ≤ ρ) → (∀ s, g₂ s ≤ ρ) → (∀ s ∈ Set.Icc (0:ℝ) 1, |g₁ s - g₂ s| ≤ D) →
      0 ≤ (∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * g₁ s)) ∧
      (∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * g₁ s)) ≤ Real.exp (2 * ρ) ∧
      |(∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * g₁ s)) -
        ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * g₂ s)| ≤ 2 * Real.exp (2 * ρ) * D := by
    intro D g₁ g₂ hg₁ hg₂ hb₁ hb₂ hD
    have hc₁ : Continuous fun s => Real.exp (-2 * κ * s + 2 * g₁ s) := by fun_prop
    have hc₂ : Continuous fun s => Real.exp (-2 * κ * s + 2 * g₂ s) := by fun_prop
    have hexp : ∀ g : ℝ → ℝ, (∀ s, g s ≤ ρ) → ∀ s ∈ Set.uIoc (0:ℝ) 1,
        -2 * κ * s + 2 * g s ≤ 2 * ρ := by
      intro g hg s hs
      rw [Set.uIoc_of_le zero_le_one, Set.mem_Ioc] at hs
      have := hg s
      nlinarith
    refine ⟨intervalIntegral.integral_nonneg zero_le_one (fun s _ => (Real.exp_pos _).le), ?_, ?_⟩
    · have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := 1)
        (C := Real.exp (2 * ρ)) (f := fun s => Real.exp (-2 * κ * s + 2 * g₁ s))
        (fun s hs => by
          dsimp only
          rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
          exact Real.exp_le_exp.2 (hexp g₁ hb₁ s hs))
      rw [sub_zero, abs_one, mul_one, Real.norm_eq_abs] at h
      exact le_trans (le_abs_self _) h
    · rw [← intervalIntegral.integral_sub (hc₁.intervalIntegrable 0 1) (hc₂.intervalIntegrable 0 1)]
      have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := 1)
        (C := 2 * Real.exp (2 * ρ) * D)
        (f := fun s => Real.exp (-2 * κ * s + 2 * g₁ s) - Real.exp (-2 * κ * s + 2 * g₂ s))
        (fun s hs => by
          dsimp only
          rw [Real.norm_eq_abs]
          have hl := exp_lip _ _ _ (hexp g₁ hb₁ s hs) (hexp g₂ hb₂ s hs)
          have hs' : s ∈ Set.Icc (0:ℝ) 1 := by
            rw [Set.uIoc_of_le zero_le_one] at hs; exact Set.Ioc_subset_Icc_self hs
          have e : -2 * κ * s + 2 * g₁ s - (-2 * κ * s + 2 * g₂ s) = 2 * (g₁ s - g₂ s) := by ring
          rw [e, abs_mul, abs_two] at hl
          have hE := Real.exp_pos (2 * ρ)
          have := mul_le_mul_of_nonneg_left (hD s hs') hE.le
          nlinarith)
      rw [sub_zero, abs_one, mul_one, Real.norm_eq_abs] at h
      exact h
  
  have innercont : ∀ w : ℝ → ℝ, Continuous w → ∀ x : ℝ,
      (Continuous fun s : ℝ => ∫ y in (x - s)..x, w y) ∧
      (Continuous fun s : ℝ => ∫ y in x..(x + s), w y) := by
    intro w hw x
    have hW : Continuous fun z => ∫ y in (0:ℝ)..z, w y :=
      intervalIntegral.continuous_primitive (fun a b => hw.intervalIntegrable a b) 0
    have e1 : (fun s : ℝ => ∫ y in (x - s)..x, w y) =
        fun s => (∫ y in (0:ℝ)..x, w y) - ∫ y in (0:ℝ)..(x - s), w y := by
      funext s
      exact (intervalIntegral.integral_interval_sub_left (hw.intervalIntegrable 0 x)
        (hw.intervalIntegrable 0 (x - s))).symm
    have e2 : (fun s : ℝ => ∫ y in x..(x + s), w y) =
        fun s => (∫ y in (0:ℝ)..(x + s), w y) - ∫ y in (0:ℝ)..x, w y := by
      funext s
      exact (intervalIntegral.integral_interval_sub_left (hw.intervalIntegrable 0 (x + s))
        (hw.intervalIntegrable 0 x)).symm
    rw [e1, e2]
    exact ⟨continuous_const.sub (hW.comp (continuous_const.sub continuous_id)),
      (hW.comp (continuous_const.add continuous_id)).sub continuous_const⟩
  have gen : ∀ w₁ w₂ : ℝ → ℝ, Continuous w₁ → Continuous w₂ → ∀ D : ℝ,
      (∀ y, |w₁ y - w₂ y| ≤ D) → ∀ a b : ℝ, |b - a| ≤ 1 →
      |(∫ y in a..b, w₁ y) - ∫ y in a..b, w₂ y| ≤ D := by
    intro w₁ w₂ h₁ h₂ D hD a b hab
    have hD0 : 0 ≤ D := le_trans (abs_nonneg _) (hD 0)
    rw [← intervalIntegral.integral_sub (h₁.intervalIntegrable a b) (h₂.intervalIntegrable a b)]
    have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := a) (b := b) (C := D)
      (f := fun y => w₁ y - w₂ y) (fun y _ => by dsimp only; rw [Real.norm_eq_abs]; exact hD y)
    rw [Real.norm_eq_abs] at h
    calc _ ≤ D * |b - a| := h
      _ ≤ D * 1 := mul_le_mul_of_nonneg_left hab hD0
      _ = D := mul_one D
  
  have comb : ∀ P₁ P₂ A₁ A₂ B₁ B₂ E D : ℝ, 0 ≤ D → 0 < P₁ → P₁ ≤ 2 → 0 < P₂ → P₂ ≤ 2 →
      0 ≤ A₁ → A₁ ≤ E → 0 ≤ B₁ → B₁ ≤ E → |P₁ - P₂| ≤ 8 * D → |A₁ - A₂| ≤ 2 * E * D →
      |B₁ - B₂| ≤ 2 * E * D → |P₁ * (A₁ - B₁) - P₂ * (A₂ - B₂)| ≤ 16 * E * D := by
    intro P₁ P₂ A₁ A₂ B₁ B₂ E D hD hP₁ hP₁2 hP₂ hP₂2 hA₁ hA₁E hB₁ hB₁E hP hA hB
    have hE : 0 ≤ E := le_trans hA₁ hA₁E
    have hAB : |A₁ - B₁| ≤ E := abs_sub_le_iff.2 ⟨by linarith, by linarith⟩
    have e : P₁ * (A₁ - B₁) - P₂ * (A₂ - B₂) =
        (P₁ - P₂) * (A₁ - B₁) + P₂ * ((A₁ - A₂) - (B₁ - B₂)) := by ring
    rw [e]
    have t1 : |(P₁ - P₂) * (A₁ - B₁)| ≤ 8 * D * E := by
      rw [abs_mul]; exact mul_le_mul hP hAB (abs_nonneg _) (by linarith)
    have t2 : |P₂ * ((A₁ - A₂) - (B₁ - B₂))| ≤ 2 * (2 * E * D + 2 * E * D) := by
      rw [abs_mul, abs_of_pos hP₂]
      have hs : |(A₁ - A₂) - (B₁ - B₂)| ≤ |A₁ - A₂| + |B₁ - B₂| := abs_sub _ _
      exact mul_le_mul hP₂2 (le_trans hs (add_le_add hA hB)) (abs_nonneg _) (by norm_num)
    calc _ ≤ |(P₁ - P₂) * (A₁ - B₁)| + |P₂ * ((A₁ - A₂) - (B₁ - B₂))| := abs_add_le _ _
      _ ≤ 8 * D * E + 2 * (2 * E * D + 2 * E * D) := add_le_add t1 t2
      _ = 16 * E * D := by ring
  
  obtain ⟨Pf, hPf⟩ : ∃ Pf : (ℝ → ℝ) → ℝ, ∀ w,
      Pf w = (1 - Real.exp (2 * wclamp ρ (∫ y in (0:ℝ)..1, w y) - 2 * κ))⁻¹ :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨Af, hAf⟩ : ∃ Af : (ℝ → ℝ) → ℝ → ℝ, ∀ w x,
      Af w x = ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * wclamp ρ (∫ y in (x - s)..x, w y)) :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨Bf, hBf⟩ : ∃ Bf : (ℝ → ℝ) → ℝ → ℝ, ∀ w x,
      Bf w x = ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * wclamp ρ (∫ y in x..(x + s), w y)) :=
    ⟨_, fun _ _ => rfl⟩
  have hrepr : ∀ w x, wfieldTclamp κ ρ w x = 8 * κ ^ 5 * (Pf w * (Af w x - Bf w x)) := by
    intro w x
    unfold wfieldTclamp
    rw [← hPf w, ← hAf w x, ← hBf w x]
    ring
  have datum : ∀ w : ℝ → ℝ, Continuous w → ∀ x : ℝ, 0 < Pf w ∧ Pf w ≤ 2 ∧
      0 ≤ Af w x ∧ Af w x ≤ Real.exp (2 * ρ) ∧ 0 ≤ Bf w x ∧ Bf w x ≤ Real.exp (2 * ρ) := by
    intro w hw x
    have hc := cl_le (∫ y in (0:ℝ)..1, w y)
    have hp := pre (2 * wclamp ρ (∫ y in (0:ℝ)..1, w y) - 2 * κ)
      (2 * wclamp ρ (∫ y in (0:ℝ)..1, w y) - 2 * κ) (by linarith) (by linarith)
    have hgL : Continuous fun s => wclamp ρ (∫ y in (x - s)..x, w y) :=
      clcont (fun s => ∫ y in (x - s)..x, w y) (innercont w hw x).1
    have hgR : Continuous fun s => wclamp ρ (∫ y in x..(x + s), w y) :=
      clcont (fun s => ∫ y in x..(x + s), w y) (innercont w hw x).2
    have hA := intest 0 _ _ hgL hgL (fun s => cl_le _) (fun s => cl_le _) (fun s _ => by simp)
    have hB := intest 0 _ _ hgR hgR (fun s => cl_le _) (fun s => cl_le _) (fun s _ => by simp)
    rw [hPf, hAf, hBf]
    exact ⟨hp.1, hp.2.1, hA.1, hA.2.1, hB.1, hB.2.1⟩
  refine ⟨?_, ?_⟩
  · intro w hw x
    obtain ⟨p, p', a, a', b, b'⟩ := datum w hw x
    rw [hrepr, abs_mul, abs_of_nonneg h8, abs_mul, abs_of_pos p]
    have hAB : |Af w x - Bf w x| ≤ Real.exp (2 * ρ) := abs_sub_le_iff.2 ⟨by linarith, by linarith⟩
    have hm := mul_le_mul p' hAB (abs_nonneg _) (by norm_num)
    calc 8 * κ ^ 5 * (Pf w * |Af w x - Bf w x|) ≤ 8 * κ ^ 5 * (2 * Real.exp (2 * ρ)) :=
          mul_le_mul_of_nonneg_left hm h8
      _ = 16 * κ ^ 5 * Real.exp (2 * ρ) := by ring
  · intro w₁ w₂ hw₁ hw₂ D hD x
    have hD0 : 0 ≤ D := le_trans (abs_nonneg _) (hD 0)
    obtain ⟨p1, p1', a1, a1', b1, b1'⟩ := datum w₁ hw₁ x
    obtain ⟨p2, p2', -, -, -, -⟩ := datum w₂ hw₂ x
    have hc := cl_lip (∫ y in (0:ℝ)..1, w₁ y) (∫ y in (0:ℝ)..1, w₂ y)
    have h01 := gen w₁ w₂ hw₁ hw₂ D hD 0 1 (by norm_num)
    have hPP : |Pf w₁ - Pf w₂| ≤ 8 * D := by
      rw [hPf, hPf]
      have hq := (pre (2 * wclamp ρ (∫ y in (0:ℝ)..1, w₁ y) - 2 * κ)
        (2 * wclamp ρ (∫ y in (0:ℝ)..1, w₂ y) - 2 * κ)
        (by linarith [cl_le (∫ y in (0:ℝ)..1, w₁ y)])
        (by linarith [cl_le (∫ y in (0:ℝ)..1, w₂ y)])).2.2
      have e : 2 * wclamp ρ (∫ y in (0:ℝ)..1, w₁ y) - 2 * κ -
          (2 * wclamp ρ (∫ y in (0:ℝ)..1, w₂ y) - 2 * κ) =
          2 * (wclamp ρ (∫ y in (0:ℝ)..1, w₁ y) - wclamp ρ (∫ y in (0:ℝ)..1, w₂ y)) := by ring
      rw [e, abs_mul, abs_two] at hq
      linarith
    have hAA : |Af w₁ x - Af w₂ x| ≤ 2 * Real.exp (2 * ρ) * D := by
      rw [hAf, hAf]
      exact (intest D _ _ (clcont _ (innercont w₁ hw₁ x).1) (clcont _ (innercont w₂ hw₂ x).1)
        (fun s => cl_le _) (fun s => cl_le _)
        (fun s hs => le_trans (cl_lip _ _) (gen w₁ w₂ hw₁ hw₂ D hD (x - s) x
          (abs_le.2 ⟨by linarith [hs.1, hs.2], by linarith [hs.1, hs.2]⟩)))).2.2
    have hBB : |Bf w₁ x - Bf w₂ x| ≤ 2 * Real.exp (2 * ρ) * D := by
      rw [hBf, hBf]
      exact (intest D _ _ (clcont _ (innercont w₁ hw₁ x).2) (clcont _ (innercont w₂ hw₂ x).2)
        (fun s => cl_le _) (fun s => cl_le _)
        (fun s hs => le_trans (cl_lip _ _) (gen w₁ w₂ hw₁ hw₂ D hD x (x + s)
          (abs_le.2 ⟨by linarith [hs.1, hs.2], by linarith [hs.1, hs.2]⟩)))).2.2
    have key := comb (Pf w₁) (Pf w₂) (Af w₁ x) (Af w₂ x) (Bf w₁ x) (Bf w₂ x)
      (Real.exp (2 * ρ)) D hD0 p1 p1' p2 p2' a1 a1' b1 b1' hPP hAA hBB
    rw [hrepr, hrepr, ← mul_sub, abs_mul, abs_of_nonneg h8]
    calc 8 * κ ^ 5 * |Pf w₁ * (Af w₁ x - Bf w₁ x) - Pf w₂ * (Af w₂ x - Bf w₂ x)|
        ≤ 8 * κ ^ 5 * (16 * Real.exp (2 * ρ) * D) := mul_le_mul_of_nonneg_left key h8
      _ = 128 * κ ^ 5 * Real.exp (2 * ρ) * D := by ring

theorem wfieldTclamp_eq_wfieldT : ∀ (κ ρ : ℝ), 0 ≤ ρ → ∀ w : ℝ → ℝ, Continuous w → Function.Periodic w 1 → (∫ x in (0:ℝ)..1, w x ^ 2) ≤ ρ ^ 2 → ∀ x, wfieldTclamp κ ρ w x = wfieldT κ w x :=
by
  intro κ ρ hρ w hw hp hE x
  have hg : Continuous (fun y => |w y|) := continuous_abs.comp hw
  have hgp : Function.Periodic (fun y => |w y|) 1 := fun y => by simp only [hp y]
  set m := ∫ y in (0:ℝ)..1, |w y| with hm
  
  have hvar : m ^ 2 ≤ ∫ y in (0:ℝ)..1, w y ^ 2 := by
    have h0 : 0 ≤ ∫ y in (0:ℝ)..1, (|w y| - m) ^ 2 :=
      intervalIntegral.integral_nonneg zero_le_one (fun y _ => sq_nonneg _)
    have hfun : (fun y => (|w y| - m) ^ 2) = fun y => (w y ^ 2 - (2 * m) * |w y|) + m ^ 2 := by
      funext y
      rw [sub_sq, sq_abs]
      ring
    have hi1 : IntervalIntegrable (fun y => w y ^ 2) MeasureTheory.volume 0 1 :=
      (hw.pow 2).intervalIntegrable 0 1
    have hi2 : IntervalIntegrable (fun y => (2 * m) * |w y|) MeasureTheory.volume 0 1 :=
      (continuous_const.mul hg).intervalIntegrable 0 1
    have hi3 : IntervalIntegrable (fun y => w y ^ 2 - (2 * m) * |w y|) MeasureTheory.volume 0 1 :=
      hi1.sub hi2
    have hcalc : (∫ y in (0:ℝ)..1, (|w y| - m) ^ 2) = (∫ y in (0:ℝ)..1, w y ^ 2) - m ^ 2 := by
      rw [hfun, intervalIntegral.integral_add hi3 intervalIntegrable_const,
        intervalIntegral.integral_sub hi1 hi2, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const]
      simp only [sub_zero, smul_eq_mul, one_mul]
      rw [← hm]
      ring
    linarith
  have hmρ : m ≤ ρ := (abs_le_of_sq_le_sq' (le_trans hvar hE) hρ).2
  
  have hwin : ∀ a b : ℝ, a ≤ b → b ≤ a + 1 → |∫ y in a..b, w y| ≤ ρ := by
    intro a b hab hb
    have h1 : |∫ y in a..b, w y| ≤ ∫ y in a..b, |w y| :=
      intervalIntegral.abs_integral_le_integral_abs hab
    have h2 : (∫ y in a..b, |w y|) ≤ ∫ y in a..(a + 1), |w y| :=
      intervalIntegral.integral_mono_interval (le_refl a) hab hb
        (Filter.Eventually.of_forall (fun y => abs_nonneg (w y))) (hg.intervalIntegrable _ _)
    have h3 : (∫ y in a..(a + 1), |w y|) = m := by
      rw [hgp.intervalIntegral_add_eq a 0, zero_add]
    linarith
  have hcl : ∀ t : ℝ, |t| ≤ ρ → wclamp ρ t = t := by
    intro t ht
    have h := abs_le.1 ht
    unfold wclamp
    rw [min_eq_left h.2, max_eq_right h.1]
  have hmean : wclamp ρ (∫ y in (0:ℝ)..1, w y) = ∫ y in (0:ℝ)..1, w y :=
    hcl _ (hwin 0 1 zero_le_one (by norm_num))
  have hleft : (∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * wclamp ρ (∫ y in (x - s)..x, w y))) =
      ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y) := by
    apply intervalIntegral.integral_congr
    intro s hs
    rw [Set.uIcc_of_le zero_le_one] at hs
    obtain ⟨hs0, hs1⟩ := hs
    simp only
    rw [hcl _ (hwin (x - s) x (by linarith) (by linarith))]
  have hright : (∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * wclamp ρ (∫ y in x..(x + s), w y))) =
      ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * ∫ y in x..(x + s), w y) := by
    apply intervalIntegral.integral_congr
    intro s hs
    rw [Set.uIcc_of_le zero_le_one] at hs
    obtain ⟨hs0, hs1⟩ := hs
    simp only
    rw [hcl _ (hwin x (x + s) (by linarith) (by linarith))]
  unfold wfieldTclamp wfieldT rgreenT rgreenRT
  rw [hmean, hleft, hright]
  ring

theorem wfieldT_energy_orthogonal : ∀ (κ : ℝ) (w : ℝ → ℝ), Continuous w → Function.Periodic w 1 → (∫ x in (0:ℝ)..1, w x * wfieldT κ w x) = 0 :=
by
  intro κ w hw hp
  
  obtain ⟨P, hPdef⟩ : ∃ P : ℝ → ℝ, P = fun u => ∫ y in (0 : ℝ)..u, w y := ⟨_, rfl⟩
  have hPd : ∀ u : ℝ, HasDerivAt P (w u) u := by
    intro u; rw [hPdef]; exact (hw.integral_hasStrictDerivAt 0 u).hasDerivAt
  have hPc : Continuous P := continuous_iff_continuousAt.2 fun u => (hPd u).continuousAt
  have hwin : ∀ a b : ℝ, ∫ y in a..b, w y = P b - P a := by
    intro a b
    rw [hPdef]
    exact (intervalIntegral.integral_interval_sub_left (hw.intervalIntegrable 0 b)
      (hw.intervalIntegrable 0 a)).symm
  have hP0 : P 0 = 0 := by rw [hPdef]; simp
  have hPper : ∀ z : ℝ, P (z + 1) = P z + P 1 := by
    intro z
    have h1 := hp.intervalIntegral_add_eq z 0
    rw [hwin, hwin, zero_add] at h1
    linarith
  
  have hslice : ∀ c s : ℝ, (∫ x in (0:ℝ)..1, w x * Real.exp (c + 2 * ∫ y in (x - s)..x, w y)) =
      ∫ x in (0:ℝ)..1, w x * Real.exp (c + 2 * ∫ y in x..(x + s), w y) := by
    intro c s
    obtain ⟨A, hAdef⟩ : ∃ A : ℝ → ℝ, A = fun x => ∫ y in (x - s)..x, w y := ⟨_, rfl⟩
    have hAe : ∀ x, A x = P x - P (x - s) := by intro x; rw [hAdef]; exact hwin _ _
    have hBe : ∀ x, (∫ y in x..(x + s), w y) = A (x + s) := by
      intro x; rw [hwin, hAe, add_sub_cancel_right]
    have hAper : Function.Periodic A 1 := by
      intro x
      rw [hAe, hAe, show x + 1 - s = (x - s) + 1 by ring, hPper, hPper]
      ring
    have hAd : ∀ x : ℝ, HasDerivAt A (w x - w (x - s)) x := by
      intro x
      have e : A = fun x => P x - P (x - s) := funext hAe
      rw [e]
      exact (hPd x).sub ((hPd (x - s)).comp_sub_const x s)
    have hAc : Continuous A := continuous_iff_continuousAt.2 fun x => (hAd x).continuousAt
    have hec : Continuous (fun x => Real.exp (c + 2 * A x)) :=
      Real.continuous_exp.comp (continuous_const.add (continuous_const.mul hAc))
    have hc1 : Continuous (fun x => w x * Real.exp (c + 2 * A x)) := hw.mul hec
    have hc2 : Continuous (fun x => w (x - s) * Real.exp (c + 2 * A x)) :=
      (hw.comp (continuous_id.sub continuous_const)).mul hec
    have hhd : ∀ x : ℝ, HasDerivAt (fun x => Real.exp (c + 2 * A x))
        (2 * (w x * Real.exp (c + 2 * A x)) - 2 * (w (x - s) * Real.exp (c + 2 * A x))) x := by
      intro x
      have := (((hAd x).const_mul 2).const_add c).exp
      convert this using 1
      ring
    have h2c : Continuous (fun _ : ℝ => (2:ℝ)) := continuous_const
    have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := (0:ℝ)) (b := 1)
      (fun x _ => hhd x) (((h2c.mul hc1).sub
        (h2c.mul hc2)).intervalIntegrable 0 1)
    rw [intervalIntegral.integral_sub ((h2c.mul hc1).intervalIntegrable 0 1)
      ((h2c.mul hc2).intervalIntegrable 0 1), intervalIntegral.integral_const_mul,
      intervalIntegral.integral_const_mul] at hftc
    have hA10 : A 1 = A 0 := by
      have := hAper 0
      rw [zero_add] at this
      exact this
    have key : (∫ x in (0:ℝ)..1, w x * Real.exp (c + 2 * A x)) =
        ∫ x in (0:ℝ)..1, w (x - s) * Real.exp (c + 2 * A x) := by
      simp only [hA10, sub_self] at hftc
      linarith
    obtain ⟨ψ, hψ⟩ : ∃ ψ : ℝ → ℝ, ψ = fun y => w y * Real.exp (c + 2 * A (y + s)) := ⟨_, rfl⟩
    have hψper : Function.Periodic ψ 1 := by
      intro y
      rw [hψ]
      simp only
      rw [hp y, show y + 1 + s = (y + s) + 1 by ring, hAper]
    have htr : (∫ x in (0:ℝ)..1, w (x - s) * Real.exp (c + 2 * A x)) =
        ∫ x in (0:ℝ)..1, ψ x := by
      have e : (fun x => w (x - s) * Real.exp (c + 2 * A x)) = fun x => ψ (x - s) := by
        funext x; rw [hψ]; simp only [sub_add_cancel]
      rw [e, intervalIntegral.integral_comp_sub_right ψ s]
      have := hψper.intervalIntegral_add_eq (0 - s) 0
      rw [show (0:ℝ) - s + 1 = 1 - s by ring, zero_add] at this
      exact this
    have hL : (fun x => w x * Real.exp (c + 2 * ∫ y in (x - s)..x, w y)) =
        fun x => w x * Real.exp (c + 2 * A x) := by rw [hAdef]
    have hR : (fun x => w x * Real.exp (c + 2 * ∫ y in x..(x + s), w y)) = ψ := by
      rw [hψ]; funext x; rw [hBe]
    rw [hL, hR, key, htr]
  
  have hswap : ∀ F : ℝ → ℝ → ℝ, Continuous (fun p : ℝ × ℝ => F p.1 p.2) →
      (∫ x in (0:ℝ)..1, ∫ s in (0:ℝ)..1, F x s) = ∫ s in (0:ℝ)..1, ∫ x in (0:ℝ)..1, F x s := by
    intro F hF
    have hint : Integrable (Function.uncurry F)
        ((volume.restrict (Set.Ioc (0:ℝ) 1)).prod (volume.restrict (Set.Ioc (0:ℝ) 1))) := by
      rw [Measure.prod_restrict, ← Measure.volume_eq_prod]
      exact (hF.continuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)).mono_set
        (Set.prod_mono Set.Ioc_subset_Icc_self Set.Ioc_subset_Icc_self)
    have := MeasureTheory.integral_integral_swap hint
    simp only [intervalIntegral.integral_of_le zero_le_one]
    exact this
  
  have hcA : Continuous (fun p : ℝ × ℝ => 2 * ∫ y in (p.1 - p.2)..p.1, w y) := by
    have e : (fun p : ℝ × ℝ => 2 * ∫ y in (p.1 - p.2)..p.1, w y) =
        fun p => 2 * (P p.1 - P (p.1 - p.2)) := by
      funext p; rw [hwin]
    rw [e]
    exact continuous_const.mul
      ((hPc.comp continuous_fst).sub (hPc.comp (continuous_fst.sub continuous_snd)))
  have hcB : Continuous (fun p : ℝ × ℝ => 2 * ∫ y in p.1..(p.1 + p.2), w y) := by
    have e : (fun p : ℝ × ℝ => 2 * ∫ y in p.1..(p.1 + p.2), w y) =
        fun p => 2 * (P (p.1 + p.2) - P p.1) := by
      funext p; rw [hwin]
    rw [e]
    exact continuous_const.mul
      ((hPc.comp (continuous_fst.add continuous_snd)).sub (hPc.comp continuous_fst))
  have hFa : Continuous (fun p : ℝ × ℝ =>
      w p.1 * Real.exp (-2 * κ * p.2 + 2 * ∫ y in (p.1 - p.2)..p.1, w y)) :=
    (hw.comp continuous_fst).mul
      (Real.continuous_exp.comp ((continuous_const.mul continuous_snd).add hcA))
  have hFb : Continuous (fun p : ℝ × ℝ =>
      w p.1 * Real.exp (-2 * κ * p.2 + 2 * ∫ y in p.1..(p.1 + p.2), w y)) :=
    (hw.comp continuous_fst).mul
      (Real.continuous_exp.comp ((continuous_const.mul continuous_snd).add hcB))
  obtain ⟨Q, hQ⟩ : ∃ Q : ℝ, Q = (1 - Real.exp (2 * (∫ y in (0:ℝ)..1, w y) - 2 * κ))⁻¹ :=
    ⟨_, rfl⟩
  have hpt : ∀ x : ℝ, w x * wfieldT κ w x = 8 * κ ^ 5 * Q * ∫ s in (0:ℝ)..1,
      (w x * Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y) -
        w x * Real.exp (-2 * κ * s + 2 * ∫ y in x..(x + s), w y)) := by
    intro x
    have ha : Continuous (fun s : ℝ =>
        w x * Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y)) :=
      hFa.comp (by fun_prop : Continuous fun s : ℝ => (x, s))
    have hb : Continuous (fun s : ℝ =>
        w x * Real.exp (-2 * κ * s + 2 * ∫ y in x..(x + s), w y)) :=
      hFb.comp (by fun_prop : Continuous fun s : ℝ => (x, s))
    rw [intervalIntegral.integral_sub (ha.intervalIntegrable 0 1) (hb.intervalIntegrable 0 1),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
    simp only [wfieldT, rgreenT, rgreenRT]
    rw [← hQ]
    ring
  have hcalc : (∫ x in (0:ℝ)..1, w x * wfieldT κ w x) = 8 * κ ^ 5 * Q *
      ∫ x in (0:ℝ)..1, ∫ s in (0:ℝ)..1,
        (w x * Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y) -
          w x * Real.exp (-2 * κ * s + 2 * ∫ y in x..(x + s), w y)) := by
    rw [← intervalIntegral.integral_const_mul]
    congr 1
    funext x
    exact hpt x
  have hs := hswap (fun x s => w x * Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y) -
    w x * Real.exp (-2 * κ * s + 2 * ∫ y in x..(x + s), w y)) (hFa.sub hFb)
  beta_reduce at hs
  rw [hcalc, hs]
  have hz : ∀ s : ℝ, (∫ x in (0:ℝ)..1,
      (w x * Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y) -
        w x * Real.exp (-2 * κ * s + 2 * ∫ y in x..(x + s), w y))) = 0 := by
    intro s
    have ha : Continuous (fun x : ℝ =>
        w x * Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y)) :=
      hFa.comp (by fun_prop : Continuous fun x : ℝ => (x, s))
    have hb : Continuous (fun x : ℝ =>
        w x * Real.exp (-2 * κ * s + 2 * ∫ y in x..(x + s), w y)) :=
      hFb.comp (by fun_prop : Continuous fun x : ℝ => (x, s))
    rw [intervalIntegral.integral_sub (ha.intervalIntegrable 0 1) (hb.intervalIntegrable 0 1),
      hslice, sub_self]
  simp only [hz, intervalIntegral.integral_zero, mul_zero]

theorem wflowT_exists : ∀ κ ≥ (1 : ℝ), ∀ ρ ≥ (0 : ℝ), 2 * ρ ≤ κ → ∀ w₀ : ℝ → ℝ, Continuous w₀ → Function.Periodic w₀ 1 → (∫ x in (0:ℝ)..1, w₀ x ^ 2) < ρ ^ 2 → ∃ V : ℝ → ℝ → ℝ, (∀ x, V 0 x = w₀ x) ∧ Continuous (fun p : ℝ × ℝ => V p.1 p.2) ∧ (∀ t, Function.Periodic (V t) 1) ∧ (∀ t, (∫ x in (0:ℝ)..1, V t x ^ 2) = ∫ x in (0:ℝ)..1, w₀ x ^ 2) ∧ ∀ t x, HasDerivAt (fun s => V s x) (wfieldT κ (V t) x) t :=
by
  intro κ hκ ρ hρ h2ρ w₀ hw₀c hw₀p hw₀E
  
  have hbootstrap : ∀ (g D : ℝ → ℝ) (c : ℝ), (∀ t : ℝ, HasDerivAt g (D t) t) → g 0 < c →
      (∀ t : ℝ, g t ≤ c → D t = 0) → ∀ t : ℝ, g t = g 0 := by
    intro g D c hg h0 hD
    have hcont : Continuous g := continuous_iff_continuousAt.2 fun t => (hg t).continuousAt
    have hclosed : IsClosed {t : ℝ | g t = g 0} := isClosed_eq hcont continuous_const
    have hopen : IsOpen {t : ℝ | g t = g 0} := by
      rw [Metric.isOpen_iff]
      intro t ht
      have ht' : g t = g 0 := ht
      have hlt : g t < c := by rw [ht']; exact h0
      have hev : ∀ᶠ s in nhds t, g s < c :=
        (hcont.continuousAt (x := t)).eventually (gt_mem_nhds hlt)
      obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff_ball.1 hev
      refine ⟨ε, hε, fun s hs => ?_⟩
      have key := (convex_ball t ε).norm_image_sub_le_of_norm_hasDerivWithin_le
        (f := g) (f' := D) (C := 0)
        (fun x _ => (hg x).hasDerivWithinAt)
        (fun x hx => by rw [hD x (hball x hx).le, norm_zero])
        (Metric.mem_ball_self hε) hs
      rw [zero_mul] at key
      have h2 : ‖g s - g t‖ = 0 := le_antisymm key (norm_nonneg _)
      rw [norm_eq_zero, sub_eq_zero] at h2
      show g s = g 0
      rw [h2, ht']
    have hclopen : IsClopen {t : ℝ | g t = g 0} := ⟨hclosed, hopen⟩
    have huniv : {t : ℝ | g t = g 0} = Set.univ := hclopen.eq_univ ⟨0, rfl⟩
    intro t
    have hmem : t ∈ {t : ℝ | g t = g 0} := by rw [huniv]; exact Set.mem_univ t
    exact hmem
  
  obtain ⟨hB, hL⟩ := wfieldTclamp_bound_lipschitz κ hκ ρ hρ h2ρ
  have hL0 : (0 : ℝ) ≤ 128 * κ ^ 5 * Real.exp (2 * ρ) := by
    have hk0 : (0 : ℝ) ≤ κ := by linarith
    positivity
  
  obtain ⟨V, hV0, hVc, hVp, hVd, hVE⟩ := periodic_lipschitz_flow_T (wfieldTclamp κ ρ)
    (fun w hw hwp => ⟨(wfieldTclamp_continuous_periodic κ ρ w hw).1,
      (wfieldTclamp_continuous_periodic κ ρ w hw).2 hwp⟩)
    ⟨16 * κ ^ 5 * Real.exp (2 * ρ), fun w hw _ x => hB w hw x⟩
    ⟨128 * κ ^ 5 * Real.exp (2 * ρ), hL0,
      fun w₁ w₂ h1 _ h2 _ D hD x => hL w₁ w₂ h1 h2 D hD x⟩
    w₀ hw₀c hw₀p
  have hVtc : ∀ t, Continuous (V t) := fun t =>
    hVc.comp (by fun_prop : Continuous fun x : ℝ => (t, x))
  have hg0 : (∫ x in (0:ℝ)..1, V 0 x ^ 2) = ∫ x in (0:ℝ)..1, w₀ x ^ 2 := by
    simp only [hV0]
  
  have hcons := hbootstrap (fun s => ∫ x in (0:ℝ)..1, V s x ^ 2)
    (fun t => 2 * ∫ x in (0:ℝ)..1, V t x * wfieldTclamp κ ρ (V t) x) (ρ ^ 2) hVE
    (by show (∫ x in (0:ℝ)..1, V 0 x ^ 2) < ρ ^ 2; rw [hg0]; exact hw₀E)
    (by
      intro t ht
      have ht' : (∫ x in (0:ℝ)..1, V t x ^ 2) ≤ ρ ^ 2 := ht
      have heq := wfieldTclamp_eq_wfieldT κ ρ hρ (V t) (hVtc t) (hVp t) ht'
      have hfun : (fun x => V t x * wfieldTclamp κ ρ (V t) x) =
          fun x => V t x * wfieldT κ (V t) x := by
        funext x; rw [heq x]
      show 2 * (∫ x in (0:ℝ)..1, V t x * wfieldTclamp κ ρ (V t) x) = 0
      rw [hfun, wfieldT_energy_orthogonal κ (V t) (hVtc t) (hVp t), mul_zero])
  have hE : ∀ t, (∫ x in (0:ℝ)..1, V t x ^ 2) = ∫ x in (0:ℝ)..1, w₀ x ^ 2 :=
    fun t => (hcons t).trans hg0
  refine ⟨V, hV0, hVc, hVp, hE, fun t x => ?_⟩
  have heq := wfieldTclamp_eq_wfieldT κ ρ hρ (V t) (hVtc t) (hVp t)
    (by rw [hE t]; exact hw₀E.le) x
  rw [← heq]
  exact hVd t x

theorem rgreenT_ode_T : ∀ (κ : ℝ) (w : ℝ → ℝ), Continuous w → Function.Periodic w 1 → (∫ y in (0:ℝ)..1, w y) < κ → (∀ x, HasDerivAt (rgreenT κ w) (2 * (w x - κ) * rgreenT κ w x + 1) x) ∧ (∀ x, HasDerivAt (rgreenRT κ w) (2 * (κ - w x) * rgreenRT κ w x - 1) x) ∧ Function.Periodic (rgreenT κ w) 1 ∧ Function.Periodic (rgreenRT κ w) 1 ∧ (∀ x, 0 < rgreenT κ w x) :=
by
  intro κ w hw hper hm
  have hFTC : ∀ f : ℝ → ℝ, Continuous f → ∀ a b : ℝ,
      (∫ y in a..b, f y) = (∫ y in (0:ℝ)..b, f y) - ∫ y in (0:ℝ)..a, f y := by
    intro f hf a b
    exact (intervalIntegral.integral_interval_sub_left (hf.intervalIntegrable 0 b)
      (hf.intervalIntegrable 0 a)).symm
  have hDer : ∀ f : ℝ → ℝ, Continuous f → ∀ u : ℝ,
      HasDerivAt (fun v => ∫ y in (0:ℝ)..v, f y) (f u) u :=
    fun f hf u => (hf.integral_hasStrictDerivAt 0 u).hasDerivAt
  obtain ⟨P, hPdef⟩ : ∃ P : ℝ → ℝ, P = fun x => ∫ y in (0:ℝ)..x, w y := ⟨_, rfl⟩
  have hP : ∀ x, HasDerivAt P (w x) x := by
    intro x
    rw [hPdef]
    exact hDer w hw x
  have hPc : Continuous P := continuous_iff_continuousAt.2 fun x => (hP x).continuousAt
  have hF3 : ∀ a b : ℝ, (∫ y in a..b, w y) = P b - P a := by
    intro a b
    rw [hPdef]
    exact hFTC w hw a b
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = ∫ y in (0:ℝ)..1, w y := ⟨_, rfl⟩
  have hinc : ∀ z, P (z + 1) = P z + M := by
    intro z
    have h := hper.intervalIntegral_add_eq z 0
    rw [zero_add, hF3 z (z + 1), ← hMdef] at h
    linarith
  have hMk : M < κ := by rw [hMdef]; exact hm
  obtain ⟨e, hedef⟩ : ∃ e : ℝ, e = Real.exp (2 * M - 2 * κ) := ⟨_, rfl⟩
  have he1 : e < 1 := by rw [hedef]; exact Real.exp_lt_one_iff.2 (by linarith)
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = (1 - e)⁻¹ := ⟨_, rfl⟩
  have hD : D * (1 - e) = 1 := by rw [hDdef]; exact inv_mul_cancel₀ (by linarith)
  have hDpos : 0 < D := by rw [hDdef]; exact inv_pos.2 (by linarith)
  obtain ⟨E, hEdef⟩ : ∃ E : ℝ → ℝ, E = fun y => Real.exp (2 * κ * y - 2 * P y) := ⟨_, rfl⟩
  obtain ⟨C, hCdef⟩ : ∃ C : ℝ → ℝ, C = fun y => Real.exp (2 * P y - 2 * κ * y) := ⟨_, rfl⟩
  have hEc : Continuous E := by
    rw [hEdef]
    exact Real.continuous_exp.comp
      ((continuous_const.mul continuous_id).sub (continuous_const.mul hPc))
  have hCc : Continuous C := by
    rw [hCdef]
    exact Real.continuous_exp.comp
      ((continuous_const.mul hPc).sub (continuous_const.mul continuous_id))
  have hCE : ∀ x, C x * E x = 1 := by
    intro x
    simp only [hCdef, hEdef]
    rw [← Real.exp_add, show 2 * P x - 2 * κ * x + (2 * κ * x - 2 * P x) = 0 by ring,
      Real.exp_zero]
  have hCE1 : ∀ x, C x * E (x - 1) = e := by
    intro x
    simp only [hCdef, hEdef]
    rw [← Real.exp_add, hedef]
    congr 1
    have h := hinc (x - 1)
    rw [sub_add_cancel] at h
    linear_combination 2 * h
  have hEC1 : ∀ x, E x * C (x + 1) = e := by
    intro x
    simp only [hCdef, hEdef]
    rw [← Real.exp_add, hedef]
    congr 1
    have h := hinc x
    linear_combination 2 * h
  have hCder : ∀ x, HasDerivAt C (C x * (2 * w x - 2 * κ)) x := by
    intro x
    have h := (((hP x).const_mul 2).sub ((hasDerivAt_id' x).const_mul (2 * κ))).exp
    simp only [hCdef]
    exact h.congr_deriv (by simp only [Pi.sub_apply]; ring)
  have hEder : ∀ x, HasDerivAt E (E x * (2 * κ - 2 * w x)) x := by
    intro x
    have h := (((hasDerivAt_id' x).const_mul (2 * κ)).sub ((hP x).const_mul 2)).exp
    simp only [hEdef]
    exact h.congr_deriv (by simp only [Pi.sub_apply]; ring)
  have hGrep : ∀ x, rgreenT κ w x = D * (C x * ∫ y in (x - 1)..x, E y) := by
    intro x
    unfold rgreenT
    rw [← hMdef, ← hedef, ← hDdef]
    congr 1
    have h1 : ∀ s, Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y) = C x * E (x - s) := by
      intro s
      rw [hF3]
      simp only [hCdef, hEdef]
      rw [← Real.exp_add]
      congr 1
      ring
    simp_rw [h1]
    rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_comp_sub_left E x,
      sub_zero]
  have hHrep : ∀ x, rgreenRT κ w x = D * (E x * ∫ y in x..(x + 1), C y) := by
    intro x
    unfold rgreenRT
    rw [← hMdef, ← hedef, ← hDdef]
    congr 1
    have h1 : ∀ s, Real.exp (-2 * κ * s + 2 * ∫ y in x..(x + s), w y) = E x * C (x + s) := by
      intro s
      rw [hF3]
      simp only [hCdef, hEdef]
      rw [← Real.exp_add]
      congr 1
      ring
    simp_rw [h1]
    rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_comp_add_left C x,
      add_zero]
  have hGfun : rgreenT κ w = fun x =>
      D * (C x * ((∫ y in (0:ℝ)..x, E y) - ∫ y in (0:ℝ)..(x - 1), E y)) := by
    funext x
    rw [hGrep, hFTC E hEc (x - 1) x]
  have hHfun : rgreenRT κ w = fun x =>
      D * (E x * ((∫ y in (0:ℝ)..(x + 1), C y) - ∫ y in (0:ℝ)..x, C y)) := by
    funext x
    rw [hHrep, hFTC C hCc x (x + 1)]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro x
    rw [hGfun]
    beta_reduce
    have hW := (hDer E hEc x).sub ((hDer E hEc (x - 1)).comp_sub_const x 1)
    refine (((hCder x).mul hW).const_mul D).congr_deriv ?_
    simp only [Pi.sub_apply]
    have h1 := hCE x
    have h2 := hCE1 x
    linear_combination D * h1 - D * h2 + hD
  · intro x
    rw [hHfun]
    beta_reduce
    have hW := ((hDer C hCc (x + 1)).comp_add_const x 1).sub (hDer C hCc x)
    refine (((hEder x).mul hW).const_mul D).congr_deriv ?_
    simp only [Pi.sub_apply]
    have h1 := hEC1 x
    have h2 := hCE x
    linear_combination D * h1 - D * h2 - hD
  · intro x
    unfold rgreenT
    congr 1
    apply intervalIntegral.integral_congr
    intro s _
    simp only [hF3]
    rw [show x + 1 - s = (x - s) + 1 by ring, hinc, hinc]
    congr 1
    ring
  · intro x
    unfold rgreenRT
    congr 1
    apply intervalIntegral.integral_congr
    intro s _
    simp only [hF3]
    rw [show x + 1 + s = (x + s) + 1 by ring, hinc, hinc]
    congr 1
    ring
  · intro x
    rw [hGrep]
    have hCpos : 0 < C x := by rw [hCdef]; exact Real.exp_pos _
    have hI : 0 < ∫ y in (x - 1)..x, E y :=
      intervalIntegral.intervalIntegral_pos_of_pos_on (hEc.intervalIntegrable _ _)
        (fun y _ => by rw [hEdef]; exact Real.exp_pos _) (by linarith)
    exact mul_pos hDpos (mul_pos hCpos hI)

theorem parametric_integral_contDiff_T {G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G] [CompleteSpace G] (n : ℕ) (F : (ℝ × ℝ) × ℝ → G) (hF : ContDiff ℝ n F) : ContDiff ℝ n (fun p : ℝ × ℝ => ∫ s in (0:ℝ)..1, F (p, s)) :=
by
  induction n generalizing G with
  | zero =>
    rw [Nat.cast_zero, contDiff_zero] at hF ⊢
    exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (f := fun p s => F (p, s)) hF 0 1
  | succ n ih =>
    have hF' : ContDiff ℝ ((n : WithTop ℕ∞) + 1) F := by
      rw [show ((n + 1 : ℕ) : WithTop ℕ∞) = (n : WithTop ℕ∞) + 1 by norm_cast] at hF
      exact hF
    have hDn : ContDiff ℝ n (fun q : (ℝ × ℝ) × ℝ =>
        (fderiv ℝ F q).comp (ContinuousLinearMap.inl ℝ (ℝ × ℝ) ℝ)) :=
      (hF'.fderiv_right (le_refl _)).clm_comp contDiff_const
    have hdiff : Differentiable ℝ F := hF'.differentiable (by simp)
    have hFD : ∀ (p : ℝ × ℝ) (s : ℝ), HasFDerivAt (fun x : ℝ × ℝ => F (x, s))
        ((fderiv ℝ F (p, s)).comp (ContinuousLinearMap.inl ℝ (ℝ × ℝ) ℝ)) p := by
      intro p s
      exact (hdiff (p, s)).hasFDerivAt.comp p (hasFDerivAt_prodMk_left p s)
    have hI := ih _ hDn
    have hFc : Continuous F := hF'.continuous
    have hDc := hDn.continuous
    rw [show ((n + 1 : ℕ) : WithTop ℕ∞) = (n : WithTop ℕ∞) + 1 by norm_cast,
      contDiff_succ_iff_hasFDerivAt]
    refine ⟨_, hI, fun p₀ => ?_⟩
    obtain ⟨C, hC⟩ := ((isCompact_closedBall p₀ 1).prod isCompact_Icc :
        IsCompact (Metric.closedBall p₀ 1 ×ˢ Set.Icc (0:ℝ) 1)).exists_bound_of_continuousOn
      hDc.continuousOn
    have hmem : ∀ t ∈ Set.uIoc (0:ℝ) 1, t ∈ Set.Icc (0:ℝ) 1 := by
      intro t ht
      rw [Set.uIoc_of_le zero_le_one] at ht
      exact ⟨ht.1.le, ht.2⟩
    haveI : SecondCountableTopologyEither ℝ ((ℝ × ℝ) →L[ℝ] G) :=
      secondCountableTopologyEither_of_left ℝ _
    have key := intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
      (μ := MeasureTheory.volume) (a := 0) (b := 1) (x₀ := p₀)
      (F := fun p s => F (p, s))
      (F' := fun p s => (fderiv ℝ F (p, s)).comp (ContinuousLinearMap.inl ℝ (ℝ × ℝ) ℝ))
      (bound := fun _ => C)
      (Metric.ball_mem_nhds p₀ one_pos)
      (Filter.Eventually.of_forall fun p =>
        (hFc.comp (continuous_const.prodMk continuous_id)).aestronglyMeasurable)
      ((hFc.comp (continuous_const.prodMk continuous_id)).intervalIntegrable _ _)
      ((hDc.comp (continuous_const.prodMk continuous_id)).aestronglyMeasurable)
      (MeasureTheory.ae_of_all _ fun t ht x hx =>
        hC (x, t) ⟨Metric.ball_subset_closedBall hx, hmem t ht⟩)
      intervalIntegrable_const
      (MeasureTheory.ae_of_all _ fun t _ x _ => hFD x t)
    exact key

theorem contDiff_of_partials_T (n : ℕ) (f A B : ℝ × ℝ → ℝ) (hA : ∀ t x : ℝ, HasDerivAt (fun s => f (s, x)) (A (t, x)) t) (hB : ∀ t x : ℝ, HasDerivAt (fun y => f (t, y)) (B (t, x)) x) (hAc : ContDiff ℝ n A) (hBc : ContDiff ℝ n B) : ContDiff ℝ ((n + 1 : ℕ) : WithTop ℕ∞) f :=
by
  have hBcont : Continuous B := hBc.continuous
  
  have s1 : ∀ t x : ℝ, ∀ ε > (0:ℝ), ∃ δ > (0:ℝ), ∀ h k : ℝ, |h| < δ → |k| < δ →
      |f (t + h, x + k) - f (t + h, x) - B (t, x) * k| ≤ ε * |k| := by
    intro t x ε hε
    obtain ⟨δ, hδ, hcont⟩ := Metric.continuousAt_iff.1 (hBcont.continuousAt (x := (t, x))) ε hε
    refine ⟨δ, hδ, fun h k hh hk => ?_⟩
    have hder : ∀ y ∈ Set.uIcc x (x + k), HasDerivWithinAt (fun y => f (t + h, y) - B (t, x) * y)
        (B (t + h, y) - B (t, x)) (Set.uIcc x (x + k)) y := by
      intro y _
      have h0 := (hB (t + h) y).sub ((hasDerivAt_id' y).const_mul (B (t, x)))
      rw [mul_one] at h0
      exact h0.hasDerivWithinAt
    have hbound : ∀ y ∈ Set.uIcc x (x + k), ‖B (t + h, y) - B (t, x)‖ ≤ ε := by
      intro y hy
      have h1 : |y - x| ≤ |x + k - x| := Set.abs_sub_left_of_mem_uIcc hy
      rw [add_sub_cancel_left] at h1
      have h2 : dist (t + h, y) (t, x) < δ := by
        rw [Prod.dist_eq, Real.dist_eq, Real.dist_eq, add_sub_cancel_left]
        exact max_lt hh (lt_of_le_of_lt h1 hk)
      have h3 := hcont h2
      rw [Real.dist_eq] at h3
      rw [Real.norm_eq_abs]
      exact h3.le
    have key := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le hder hbound
      (convex_uIcc x (x + k)) Set.left_mem_uIcc Set.right_mem_uIcc
    rw [Real.norm_eq_abs, Real.norm_eq_abs, add_sub_cancel_left] at key
    have e : f (t + h, x + k) - B (t, x) * (x + k) - (f (t + h, x) - B (t, x) * x) =
        f (t + h, x + k) - f (t + h, x) - B (t, x) * k := by ring
    rw [e] at key
    exact key
  
  have hd : ∀ p : ℝ × ℝ, HasFDerivAt f
      (A p • ContinuousLinearMap.fst ℝ ℝ ℝ + B p • ContinuousLinearMap.snd ℝ ℝ ℝ) p := by
    rintro ⟨t, x⟩
    have ha := hA t x
    rw [hasFDerivAt_iff_isLittleO_nhds_zero, Asymptotics.isLittleO_iff]
    intro c hc
    rw [hasDerivAt_iff_isLittleO_nhds_zero, Asymptotics.isLittleO_iff] at ha
    obtain ⟨δ₁, hδ₁, h1⟩ := Metric.eventually_nhds_iff.1 (ha (half_pos hc))
    obtain ⟨δ₂, hδ₂, h2⟩ := s1 t x (c / 2) (half_pos hc)
    rw [Metric.eventually_nhds_iff]
    refine ⟨min δ₁ δ₂, lt_min hδ₁ hδ₂, ?_⟩
    rintro ⟨h, k⟩ hv
    rw [dist_zero_right, Prod.norm_def, Real.norm_eq_abs, Real.norm_eq_abs] at hv
    have hm1 : |h| ≤ max |h| |k| := le_max_left _ _
    have hm2 : |k| ≤ max |h| |k| := le_max_right _ _
    have hmd1 : max |h| |k| < δ₁ := lt_of_lt_of_le hv (min_le_left _ _)
    have hmd2 : max |h| |k| < δ₂ := lt_of_lt_of_le hv (min_le_right _ _)
    have e1 := h1 (show dist h 0 < δ₁ by rw [Real.dist_eq, sub_zero]; linarith)
    simp only [Real.norm_eq_abs, smul_eq_mul] at e1
    have e2 := h2 h k (by linarith) (by linarith)
    simp only [Prod.mk_add_mk, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', smul_eq_mul, Prod.norm_def,
      Real.norm_eq_abs]
    have tri : |f (t + h, x + k) - f (t, x) - (A (t, x) * h + B (t, x) * k)| ≤
        |f (t + h, x + k) - f (t + h, x) - B (t, x) * k| + |f (t + h, x) - f (t, x) - h * A (t, x)| := by
      calc _ = |(f (t + h, x + k) - f (t + h, x) - B (t, x) * k) +
            (f (t + h, x) - f (t, x) - h * A (t, x))| := by congr 1; ring
        _ ≤ _ := abs_add_le _ _
    have m1 := mul_le_mul_of_nonneg_left hm1 (half_pos hc).le
    have m2 := mul_le_mul_of_nonneg_left hm2 (half_pos hc).le
    linarith
  
  have hdiff : Differentiable ℝ f := fun p => (hd p).differentiableAt
  have hfd : ∀ p y, fderiv ℝ f p y = A p * y.1 + B p * y.2 := by
    intro p y
    rw [(hd p).fderiv]
    simp
  rw [show ((n + 1 : ℕ) : WithTop ℕ∞) = (n : WithTop ℕ∞) + 1 by norm_cast,
    contDiff_succ_iff_fderiv_apply]
  refine ⟨hdiff, by simp, fun y => ?_⟩
  have hfun : (fun p => fderiv ℝ f p y) = fun p => A p * y.1 + B p * y.2 :=
    funext fun p => hfd p y
  rw [hfun]
  exact (hAc.mul contDiff_const).add (hBc.mul contDiff_const)

theorem rgreenT_joint_contDiff (n : ℕ) (κ : ℝ) (V : ℝ → ℝ → ℝ) (hV : ContDiff ℝ n (fun p : ℝ × ℝ => V p.1 p.2)) (hM : ∀ t, (∫ y in (0:ℝ)..1, V t y) < κ) : ContDiff ℝ n (fun p : ℝ × ℝ => rgreenT κ (V p.1) p.2) ∧ ContDiff ℝ n (fun p : ℝ × ℝ => rgreenRT κ (V p.1) p.2) :=
by
  have hVt : ∀ t, Continuous (V t) := fun t =>
    hV.continuous.comp (continuous_const.prodMk continuous_id)
  
  obtain ⟨P, hPdef⟩ : ∃ P : ℝ × ℝ → ℝ, P = fun p => ∫ y in (0:ℝ)..p.2, V p.1 y := ⟨_, rfl⟩
  have hPeq : P = fun p : ℝ × ℝ => p.2 * ∫ u in (0:ℝ)..1, V p.1 (p.2 * u) := by
    rw [hPdef]
    funext p
    have h := intervalIntegral.mul_integral_comp_mul_left (a := 0) (b := 1) (f := V p.1) p.2
    simp only [mul_zero, mul_one] at h
    exact h.symm
  have hP : ContDiff ℝ n P := by
    rw [hPeq]
    have hF0 : ContDiff ℝ n (fun q : (ℝ × ℝ) × ℝ => V q.1.1 (q.1.2 * q.2)) :=
      hV.comp (contDiff_fst.fst.prodMk (contDiff_fst.snd.mul contDiff_snd))
    exact contDiff_snd.mul (parametric_integral_contDiff_T n _ hF0)
  
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ × ℝ → ℝ,
      D = fun p => 1 - Real.exp (2 * P (p.1, 1) - 2 * κ) := ⟨_, rfl⟩
  have hD : ContDiff ℝ n D := by
    rw [hDdef]
    exact contDiff_const.sub (((contDiff_const.mul
      (hP.comp (contDiff_fst.prodMk contDiff_const))).sub contDiff_const).exp)
  have hDne : ∀ p, D p ≠ 0 := by
    intro p
    have h1 : P (p.1, 1) = ∫ y in (0:ℝ)..1, V p.1 y := by rw [hPdef]
    have h2 := hM p.1
    have h3 : Real.exp (2 * P (p.1, 1) - 2 * κ) < 1 :=
      Real.exp_lt_one_iff.2 (by rw [h1]; linarith)
    rw [hDdef]
    exact (sub_pos.2 h3).ne'
  
  have ha : ContDiff ℝ n (fun q : (ℝ × ℝ) × ℝ => P (q.1.1, q.1.2)) :=
    hP.comp (contDiff_fst.fst.prodMk contDiff_fst.snd)
  have hb : ContDiff ℝ n (fun q : (ℝ × ℝ) × ℝ => P (q.1.1, q.1.2 - q.2)) :=
    hP.comp (contDiff_fst.fst.prodMk (contDiff_fst.snd.sub contDiff_snd))
  have hc : ContDiff ℝ n (fun q : (ℝ × ℝ) × ℝ => P (q.1.1, q.1.2 + q.2)) :=
    hP.comp (contDiff_fst.fst.prodMk (contDiff_fst.snd.add contDiff_snd))
  have hF1 : ContDiff ℝ n (fun q : (ℝ × ℝ) × ℝ =>
      Real.exp (-2 * κ * q.2 + 2 * (P (q.1.1, q.1.2) - P (q.1.1, q.1.2 - q.2)))) :=
    ((contDiff_const.mul contDiff_snd).add (contDiff_const.mul (ha.sub hb))).exp
  have hF2 : ContDiff ℝ n (fun q : (ℝ × ℝ) × ℝ =>
      Real.exp (-2 * κ * q.2 + 2 * (P (q.1.1, q.1.2 + q.2) - P (q.1.1, q.1.2)))) :=
    ((contDiff_const.mul contDiff_snd).add (contDiff_const.mul (hc.sub ha))).exp
  have hI1 := parametric_integral_contDiff_T n _ hF1
  have hI2 := parametric_integral_contDiff_T n _ hF2
  
  have hG : ∀ p : ℝ × ℝ, rgreenT κ (V p.1) p.2 = (D p)⁻¹ *
      ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * (P (p.1, p.2) - P (p.1, p.2 - s))) := by
    intro p
    subst hPdef hDdef
    show (1 - Real.exp (2 * (∫ y in (0:ℝ)..1, V p.1 y) - 2 * κ))⁻¹ *
        ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * ∫ y in (p.2 - s)..p.2, V p.1 y) =
      (1 - Real.exp (2 * (∫ y in (0:ℝ)..1, V p.1 y) - 2 * κ))⁻¹ *
        ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s +
          2 * ((∫ y in (0:ℝ)..p.2, V p.1 y) - ∫ y in (0:ℝ)..(p.2 - s), V p.1 y))
    congr 1
    refine intervalIntegral.integral_congr (fun s _ => ?_)
    show Real.exp (-2 * κ * s + 2 * ∫ y in (p.2 - s)..p.2, V p.1 y) =
      Real.exp (-2 * κ * s +
          2 * ((∫ y in (0:ℝ)..p.2, V p.1 y) - ∫ y in (0:ℝ)..(p.2 - s), V p.1 y))
    rw [intervalIntegral.integral_interval_sub_left ((hVt p.1).intervalIntegrable 0 p.2)
      ((hVt p.1).intervalIntegrable 0 (p.2 - s))]
  have hH : ∀ p : ℝ × ℝ, rgreenRT κ (V p.1) p.2 = (D p)⁻¹ *
      ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * (P (p.1, p.2 + s) - P (p.1, p.2))) := by
    intro p
    subst hPdef hDdef
    show (1 - Real.exp (2 * (∫ y in (0:ℝ)..1, V p.1 y) - 2 * κ))⁻¹ *
        ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s + 2 * ∫ y in p.2..(p.2 + s), V p.1 y) =
      (1 - Real.exp (2 * (∫ y in (0:ℝ)..1, V p.1 y) - 2 * κ))⁻¹ *
        ∫ s in (0:ℝ)..1, Real.exp (-2 * κ * s +
          2 * ((∫ y in (0:ℝ)..(p.2 + s), V p.1 y) - ∫ y in (0:ℝ)..p.2, V p.1 y))
    congr 1
    refine intervalIntegral.integral_congr (fun s _ => ?_)
    show Real.exp (-2 * κ * s + 2 * ∫ y in p.2..(p.2 + s), V p.1 y) =
      Real.exp (-2 * κ * s +
          2 * ((∫ y in (0:ℝ)..(p.2 + s), V p.1 y) - ∫ y in (0:ℝ)..p.2, V p.1 y))
    rw [intervalIntegral.integral_interval_sub_left ((hVt p.1).intervalIntegrable 0 (p.2 + s))
      ((hVt p.1).intervalIntegrable 0 p.2)]
  refine ⟨?_, ?_⟩
  · rw [funext hG]
    exact (hD.inv hDne).mul hI1
  · rw [funext hH]
    exact (hD.inv hDne).mul hI2

theorem wflowT_smooth : ∀ κ ≥ (1 : ℝ), ∀ V : ℝ → ℝ → ℝ, ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) (V 0) → Continuous (fun p : ℝ × ℝ => V p.1 p.2) → (∀ t, Function.Periodic (V t) 1) → (∀ t, (∫ x in (0:ℝ)..1, V t x) ≤ κ / 2) → (∀ t x, HasDerivAt (fun s => V s x) (wfieldT κ (V t) x) t) → ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) (fun p : ℝ × ℝ => V p.1 p.2) :=
by
  intro κ hκ V hV0 hVc hVp hVm hVd
  
  have hM : ∀ t, (∫ y in (0:ℝ)..1, V t y) < κ := fun t => by linarith [hVm t]
  have hVt : ∀ t, Continuous (V t) := fun t =>
    hVc.comp (continuous_const.prodMk continuous_id)
  have hw0d : ∀ x, HasDerivAt (V 0) (deriv (V 0) x) x := fun x =>
    ((hV0.differentiable (by simp)) x).hasDerivAt
  have hdw : ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) (deriv (V 0)) :=
    (contDiff_infty_iff_deriv.1 hV0).2
  obtain ⟨G, hG⟩ : ∃ G : ℝ × ℝ → ℝ, G = fun p => rgreenT κ (V p.1) p.2 := ⟨_, rfl⟩
  obtain ⟨H, hH⟩ : ∃ H : ℝ × ℝ → ℝ, H = fun p => rgreenRT κ (V p.1) p.2 := ⟨_, rfl⟩
  obtain ⟨A, hA⟩ : ∃ A : ℝ × ℝ → ℝ, A = fun p => 8 * κ ^ 5 * (G p - H p) := ⟨_, rfl⟩
  obtain ⟨Fx, hFx⟩ : ∃ Fx : ℝ × ℝ → ℝ,
      Fx = fun p => 8 * κ ^ 5 * (2 * (V p.1 p.2 - κ) * (G p + H p) + 2) := ⟨_, rfl⟩
  obtain ⟨B, hB⟩ : ∃ B : ℝ × ℝ → ℝ,
      B = fun p => deriv (V 0) p.2 + p.1 * ∫ u in (0:ℝ)..1, Fx (p.1 * u, p.2) := ⟨_, rfl⟩
  have hAw : ∀ s y, A (s, y) = wfieldT κ (V s) y := by
    intro s y
    rw [hA, hG, hH]
    rfl
  
  have hGH : ∀ m : ℕ, ContDiff ℝ m (fun p : ℝ × ℝ => V p.1 p.2) →
      ContDiff ℝ m G ∧ ContDiff ℝ m H := by
    intro m hm
    rw [hG, hH]
    exact rgreenT_joint_contDiff m κ V hm hM
  have hAm : ∀ m : ℕ, ContDiff ℝ m (fun p : ℝ × ℝ => V p.1 p.2) → ContDiff ℝ m A := by
    intro m hm
    obtain ⟨hGm, hHm⟩ := hGH m hm
    rw [hA]
    exact contDiff_const.mul (hGm.sub hHm)
  have hFxm : ∀ m : ℕ, ContDiff ℝ m (fun p : ℝ × ℝ => V p.1 p.2) → ContDiff ℝ m Fx := by
    intro m hm
    obtain ⟨hGm, hHm⟩ := hGH m hm
    rw [hFx]
    exact contDiff_const.mul
      (((contDiff_const.mul (hm.sub contDiff_const)).mul (hGm.add hHm)).add contDiff_const)
  have hV0c : ContDiff ℝ ((0 : ℕ) : WithTop ℕ∞) (fun p : ℝ × ℝ => V p.1 p.2) := by
    rw [Nat.cast_zero]
    exact contDiff_zero.2 hVc
  have hAc : Continuous A := by
    have h := hAm 0 hV0c
    rw [Nat.cast_zero] at h
    exact contDiff_zero.1 h
  have hFxc : Continuous Fx := by
    have h := hFxm 0 hV0c
    rw [Nat.cast_zero] at h
    exact contDiff_zero.1 h
  
  have hd : ∀ s y : ℝ, HasDerivAt (fun z => A (s, z)) (Fx (s, y)) y := by
    intro s y
    obtain ⟨hg, hh, -⟩ := rgreenT_ode_T κ (V s) (hVt s) (hVp s) (hM s)
    have h1 := ((hg y).sub (hh y)).const_mul (8 * κ ^ 5)
    have hfun : (fun z => A (s, z)) = fun z => 8 * κ ^ 5 * (rgreenT κ (V s) z - rgreenRT κ (V s) z) := by
      funext z
      rw [hA, hG, hH]
    rw [hfun, hFx, hG, hH]
    convert h1 using 1
    ring
  
  have hDuh : ∀ t y : ℝ, V t y = V 0 y + ∫ s in (0:ℝ)..t, A (s, y) := by
    intro t y
    have hcont : Continuous fun s => A (s, y) := hAc.comp (continuous_id.prodMk continuous_const)
    have h := intervalIntegral.integral_eq_sub_of_hasDerivAt (f := fun s => V s y)
      (f' := fun s => A (s, y)) (a := 0) (b := t)
      (fun s _ => by
        show HasDerivAt (fun s => V s y) (A (s, y)) s
        rw [hAw]; exact hVd s y) (hcont.intervalIntegrable _ _)
    simp only at h
    linarith
  
  have hLeib : ∀ t x : ℝ, HasDerivAt (fun y => ∫ s in (0:ℝ)..t, A (s, y))
      (∫ s in (0:ℝ)..t, Fx (s, x)) x := by
    intro t x
    obtain ⟨C, hC⟩ := (isCompact_Icc.prod isCompact_Icc :
        IsCompact (Set.Icc (-|t|) |t| ×ˢ Set.Icc (x - 1) (x + 1))).exists_bound_of_continuousOn
      hFxc.continuousOn
    have hmem : ∀ s ∈ Set.uIoc (0:ℝ) t, ∀ y ∈ Metric.ball x 1,
        (s, y) ∈ Set.Icc (-|t|) |t| ×ˢ Set.Icc (x - 1) (x + 1) := by
      intro s hs y hy
      rw [Set.mem_uIoc] at hs
      rw [Metric.mem_ball, Real.dist_eq] at hy
      have hy' := abs_lt.1 hy
      refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
      · rcases hs with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
          rcases abs_cases t with ⟨h3, h4⟩ | ⟨h3, h4⟩ <;> linarith
      · rcases hs with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
          rcases abs_cases t with ⟨h3, h4⟩ | ⟨h3, h4⟩ <;> linarith
      · linarith
      · linarith
    have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (μ := MeasureTheory.volume) (a := 0) (b := t) (x₀ := x)
      (F := fun y s => A (s, y)) (F' := fun y s => Fx (s, y)) (bound := fun _ => C)
      (Metric.ball_mem_nhds x one_pos)
      (Filter.Eventually.of_forall fun y =>
        (hAc.comp (continuous_id.prodMk continuous_const)).aestronglyMeasurable)
      ((hAc.comp (continuous_id.prodMk continuous_const)).intervalIntegrable _ _)
      ((hFxc.comp (continuous_id.prodMk continuous_const)).aestronglyMeasurable)
      (MeasureTheory.ae_of_all _ fun s hs y hy => hC (s, y) (hmem s hs y hy))
      intervalIntegrable_const
      (MeasureTheory.ae_of_all _ fun s _ y _ => hd s y)
    exact key.2
  
  have hBd : ∀ t x : ℝ, HasDerivAt (fun y => (fun p : ℝ × ℝ => V p.1 p.2) (t, y)) (B (t, x)) x := by
    intro t x
    have hfun : (fun y => (fun p : ℝ × ℝ => V p.1 p.2) (t, y)) =
        fun y => V 0 y + ∫ s in (0:ℝ)..t, A (s, y) := funext fun y => hDuh t y
    rw [hfun]
    have h1 := (hw0d x).add (hLeib t x)
    have hsub : (∫ s in (0:ℝ)..t, Fx (s, x)) = t * ∫ u in (0:ℝ)..1, Fx (t * u, x) := by
      have := intervalIntegral.mul_integral_comp_mul_left (a := 0) (b := 1)
        (f := fun s => Fx (s, x)) t
      simp only [mul_zero, mul_one] at this
      exact this.symm
    rw [hsub] at h1
    rw [hB]
    exact h1
  
  have hind : ∀ m : ℕ, ContDiff ℝ m (fun p : ℝ × ℝ => V p.1 p.2) := by
    intro m
    induction m with
    | zero => exact hV0c
    | succ m ih =>
      have hBm : ContDiff ℝ m B := by
        have hdm : ContDiff ℝ m (deriv (V 0)) := hdw.of_le (by exact_mod_cast le_top)
        have hint := parametric_integral_contDiff_T m (fun q : (ℝ × ℝ) × ℝ => Fx (q.1.1 * q.2, q.1.2))
          ((hFxm m ih).comp ((contDiff_fst.fst.mul contDiff_snd).prodMk contDiff_fst.snd))
        rw [hB]
        exact (hdm.comp contDiff_snd).add (contDiff_fst.mul hint)
      exact contDiff_of_partials_T m (fun p : ℝ × ℝ => V p.1 p.2) A B
        (fun t x => by rw [hAw]; exact hVd t x) hBd (hAm m ih) hBm
  exact contDiff_infty.2 hind

theorem greenT_eq_of_riccati_pair_T : ∀ (κ : ℝ) (q : CinfT) (wp wm : ℝ → ℝ), Function.Periodic wp 1 → Function.Periodic wm 1 → (∀ x, HasDerivAt wp ((q : ℝ → ℝ) x + 2 * κ * wp x - wp x ^ 2) x) → (∀ x, HasDerivAt wm ((q : ℝ → ℝ) x - 2 * κ * wm x - wm x ^ 2) x) → (∀ x, 0 < 2 * κ + wm x - wp x) → IsGreenT κ (q : ℝ → ℝ) (greenT κ (q : ℝ → ℝ)) ∧ ∀ x, greenT κ (q : ℝ → ℝ) x = 1 / (2 * κ + wm x - wp x) :=
by
  intro κ q wp wm hwpP hwmP hwpD hwmD hpos
  
  have boot : ∀ (β : ℝ) (w : ℝ → ℝ),
      (∀ x, HasDerivAt w ((q : ℝ → ℝ) x + β * w x - w x ^ 2) x) → ∀ n : ℕ, ContDiff ℝ n w := by
    intro β w hw n
    have hdw : deriv w = fun x => (q : ℝ → ℝ) x + β * w x - w x ^ 2 :=
      funext fun x => (hw x).deriv
    have hdiff : Differentiable ℝ w := fun x => (hw x).differentiableAt
    induction n with
    | zero => exact contDiff_zero.2 hdiff.continuous
    | succ n ih =>
      rw [Nat.cast_succ, contDiff_succ_iff_deriv]
      refine ⟨hdiff, fun h => absurd h (by simp), ?_⟩
      rw [hdw]
      have hq : ContDiff ℝ n (q : ℝ → ℝ) := contDiff_infty.1 q.2.1 n
      exact (hq.add (contDiff_const.mul ih)).sub (ih.pow 2)
  have hwpS : ∀ n : ℕ, ContDiff ℝ n wp := boot (2 * κ) wp hwpD
  have hwmS : ∀ n : ℕ, ContDiff ℝ n wm :=
    boot (-(2 * κ)) wm fun x => (hwmD x).congr_deriv (by ring)
  have cwp : Continuous wp := continuous_iff_continuousAt.2 fun x => (hwpD x).continuousAt
  have cwm : Continuous wm := continuous_iff_continuousAt.2 fun x => (hwmD x).continuousAt
  
  have hcand : IsGreenT κ (q : ℝ → ℝ) (fun x => 1 / (2 * κ + wm x - wp x)) := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · exact contDiff_infty.2 fun n =>
        contDiff_const.div ((contDiff_const.add (hwmS n)).sub (hwpS n)) (fun x => (hpos x).ne')
    · intro x
      show 1 / (2 * κ + wm (x + 1) - wp (x + 1)) = 1 / (2 * κ + wm x - wp x)
      rw [hwpP x, hwmP x]
    · intro x
      exact one_div_pos.2 (hpos x)
    · intro x
      have hD : ∀ y, HasDerivAt (fun y => 2 * κ + wm y - wp y)
          (((q : ℝ → ℝ) y - 2 * κ * wm y - wm y ^ 2) -
            ((q : ℝ → ℝ) y + 2 * κ * wp y - wp y ^ 2)) y := by
        intro y
        have := ((hasDerivAt_const y (2 * κ)).add (hwmD y)).sub (hwpD y)
        simpa using this
      have hg : ∀ y, HasDerivAt (fun y => 1 / (2 * κ + wm y - wp y))
          ((wm y + wp y) * (1 / (2 * κ + wm y - wp y))) y := by
        intro y
        have hne := (hpos y).ne'
        have := (hasDerivAt_const y (1 : ℝ)).div (hD y) hne
        refine this.congr_deriv ?_
        field_simp
        ring
      have hdg : deriv (fun y => 1 / (2 * κ + wm y - wp y)) =
          fun y => (wm y + wp y) * (1 / (2 * κ + wm y - wp y)) :=
        funext fun y => (hg y).deriv
      have hs : HasDerivAt (fun y => wm y + wp y)
          (((q : ℝ → ℝ) x - 2 * κ * wm x - wm x ^ 2) +
            ((q : ℝ → ℝ) x + 2 * κ * wp x - wp x ^ 2)) x := (hwmD x).add (hwpD x)
      have h2 : iteratedDeriv 2 (fun y => 1 / (2 * κ + wm y - wp y)) x =
          (((q : ℝ → ℝ) x - 2 * κ * wm x - wm x ^ 2) +
            ((q : ℝ → ℝ) x + 2 * κ * wp x - wp x ^ 2)) * (1 / (2 * κ + wm x - wp x)) +
          (wm x + wp x) * ((wm x + wp x) * (1 / (2 * κ + wm x - wp x))) := by
        rw [iteratedDeriv_succ, iteratedDeriv_one, hdg]
        exact (hs.mul (hg x)).deriv
      rw [h2, hdg]
      have hne := (hpos x).ne'
      field_simp
      ring
  
  have expRep : ∀ (c F : ℝ → ℝ), Continuous c → (∀ x, HasDerivAt F (c x * F x) x) →
      ∀ x, F x = F 0 * Real.exp (∫ t in (0:ℝ)..x, c t) := by
    intro c F hc hF x
    have hC : ∀ y, HasDerivAt (fun z => ∫ t in (0:ℝ)..z, c t) (c y) y :=
      fun y => (hc.integral_hasStrictDerivAt 0 y).hasDerivAt
    have hG : ∀ y, HasDerivAt (fun z => F z * Real.exp (-(∫ t in (0:ℝ)..z, c t))) 0 y := by
      intro y
      have := (hF y).mul ((hC y).neg.exp)
      refine this.congr_deriv ?_
      ring
    have hconst := is_const_of_deriv_eq_zero (fun y => (hG y).differentiableAt)
      (fun y => (hG y).deriv) x 0
    simp only [intervalIntegral.integral_same, neg_zero, Real.exp_zero, mul_one] at hconst
    rw [← hconst, mul_assoc, ← Real.exp_add, neg_add_cancel, Real.exp_zero, mul_one]
  
  have dich : ∀ w : ℝ → ℝ, Function.Periodic w 1 →
      (∀ x, HasDerivAt w ((q : ℝ → ℝ) x + 2 * κ * w x - w x ^ 2) x) →
      w = wp ∨ w = fun x => wm x + 2 * κ := by
    intro w hwP hwD
    have cw : Continuous w := continuous_iff_continuousAt.2 fun x => (hwD x).continuousAt
    have hc1 : Continuous fun t => 2 * κ - w t - wp t := (continuous_const.sub cw).sub cwp
    have hc2 : Continuous fun t => -(w t + wm t) := (cw.add cwm).neg
    have rep1 : ∀ x, w x - wp x =
        (w 0 - wp 0) * Real.exp (∫ t in (0:ℝ)..x, (2 * κ - w t - wp t)) :=
      expRep (fun t => 2 * κ - w t - wp t) (fun x => w x - wp x) hc1
        (fun x => ((hwD x).sub (hwpD x)).congr_deriv (by ring))
    have rep2 : ∀ x, w x - (wm x + 2 * κ) =
        (w 0 - (wm 0 + 2 * κ)) * Real.exp (∫ t in (0:ℝ)..x, -(w t + wm t)) :=
      expRep (fun t => -(w t + wm t)) (fun x => w x - (wm x + 2 * κ)) hc2
        (fun x => ((hwD x).sub ((hwmD x).add_const (2 * κ))).congr_deriv (by ring))
    by_cases h1 : w 0 - wp 0 = 0
    · left
      funext x
      have := rep1 x
      rw [h1, zero_mul] at this
      linarith
    by_cases h2 : w 0 - (wm 0 + 2 * κ) = 0
    · right
      funext x
      have := rep2 x
      rw [h2, zero_mul] at this
      linarith
    exfalso
    have pw : w 1 = w 0 := by simpa using hwP 0
    have pp : wp 1 = wp 0 := by simpa using hwpP 0
    have pm : wm 1 = wm 0 := by simpa using hwmP 0
    have e1 := rep1 1
    have e2 := rep2 1
    rw [pw, pp] at e1
    rw [pw, pm] at e2
    have I1 : (∫ t in (0:ℝ)..1, (2 * κ - w t - wp t)) = 0 := by
      have : Real.exp (∫ t in (0:ℝ)..1, (2 * κ - w t - wp t)) = 1 := by
        apply mul_left_cancel₀ h1
        linarith
      exact Real.exp_eq_one_iff _ |>.1 this
    have I2 : (∫ t in (0:ℝ)..1, -(w t + wm t)) = 0 := by
      have : Real.exp (∫ t in (0:ℝ)..1, -(w t + wm t)) = 1 := by
        apply mul_left_cancel₀ h2
        linarith
      exact Real.exp_eq_one_iff _ |>.1 this
    have hsub := intervalIntegral.integral_sub
      (hc1.intervalIntegrable (μ := MeasureTheory.volume) 0 1)
      (hc2.intervalIntegrable (μ := MeasureTheory.volume) 0 1)
    rw [I1, I2, sub_zero] at hsub
    have hcongr : (∫ t in (0:ℝ)..1, ((2 * κ - w t - wp t) - -(w t + wm t))) =
        ∫ t in (0:ℝ)..1, (2 * κ + wm t - wp t) := by
      congr 1
      funext t
      ring
    rw [hcongr] at hsub
    have hposI : 0 < ∫ t in (0:ℝ)..1, (2 * κ + wm t - wp t) :=
      intervalIntegral.intervalIntegral_pos_of_pos
        (((continuous_const.add cwm).sub cwp).intervalIntegrable 0 1) hpos zero_lt_one
    linarith
  
  have uniq : ∀ g : ℝ → ℝ, IsGreenT κ (q : ℝ → ℝ) g → ∀ x, g x = 1 / (2 * κ + wm x - wp x) := by
    intro g ⟨hsm, hper, hgpos, hid⟩
    have hgd : Differentiable ℝ g := hsm.differentiable (by simp)
    have hg'd : Differentiable ℝ (deriv g) :=
      (contDiff_infty_iff_deriv.1 hsm).2.differentiable (by simp)
    have hdper : ∀ x, deriv g (x + 1) = deriv g x := by
      intro x
      have h1 : HasDerivAt (fun y => g (y + 1)) (deriv g (x + 1)) x :=
        HasDerivAt.comp_add_const x 1 (hgd (x + 1)).hasDerivAt
      have h2 : (fun y => g (y + 1)) = g := funext hper
      rw [h2] at h1
      exact h1.deriv.symm
    have hg2 : ∀ x, deriv (deriv g) x =
        (deriv g x ^ 2 + 4 * (κ ^ 2 + (q : ℝ → ℝ) x) * g x ^ 2 - 1) / (2 * g x) := by
      intro x
      have hne := (hgpos x).ne'
      have h := hid x
      rw [iteratedDeriv_succ, iteratedDeriv_one] at h
      field_simp
      linarith
    
    have lift : ∀ σ : ℝ, σ ^ 2 = 1 →
        Function.Periodic (fun x => κ + (deriv g x + σ) / (2 * g x)) 1 ∧
        ∀ x, HasDerivAt (fun y => κ + (deriv g y + σ) / (2 * g y))
          ((q : ℝ → ℝ) x + 2 * κ * (κ + (deriv g x + σ) / (2 * g x)) -
            (κ + (deriv g x + σ) / (2 * g x)) ^ 2) x := by
      intro σ hσ
      refine ⟨fun x => ?_, fun x => ?_⟩
      · show κ + (deriv g (x + 1) + σ) / (2 * g (x + 1)) = κ + (deriv g x + σ) / (2 * g x)
        rw [hdper x, hper x]
      · have hne := (hgpos x).ne'
        have hN : HasDerivAt (fun y => deriv g y + σ) (deriv (deriv g) x) x :=
          (hg'd x).hasDerivAt.add_const σ
        have hM : HasDerivAt (fun y => 2 * g y) (2 * deriv g x) x :=
          (hgd x).hasDerivAt.const_mul 2
        have := (hN.div hM (by positivity)).const_add κ
        refine this.congr_deriv ?_
        rw [hg2 x]
        field_simp
        linear_combination hσ
    obtain ⟨haP, haD⟩ := lift (-1) (by norm_num)
    obtain ⟨hcP, hcD⟩ := lift 1 (by norm_num)
    have hca : ∀ x, (κ + (deriv g x + 1) / (2 * g x)) - (κ + (deriv g x + -1) / (2 * g x)) =
        1 / g x := by
      intro x
      have hne := (hgpos x).ne'
      field_simp
      ring
    have hinv : ∀ x, 0 < 1 / g x := fun x => one_div_pos.2 (hgpos x)
    rcases dich _ haP haD with ha | ha <;> rcases dich _ hcP hcD with hc | hc
    · exfalso
      have e := hca 0
      have ea := congrFun ha 0
      have ec := congrFun hc 0
      simp only at ea ec
      rw [ea, ec, sub_self] at e
      linarith [hinv 0]
    · intro x
      have e := hca x
      have ea := congrFun ha x
      have ec := congrFun hc x
      simp only at ea ec
      rw [ea, ec] at e
      have hne := (hgpos x).ne'
      have hDx := (hpos x).ne'
      rw [eq_div_iff hDx]
      field_simp at e
      linarith
    · exfalso
      have e := hca 0
      have ea := congrFun ha 0
      have ec := congrFun hc 0
      simp only at ea ec
      rw [ea, ec] at e
      linarith [hinv 0, hpos 0]
    · exfalso
      have e := hca 0
      have ea := congrFun ha 0
      have ec := congrFun hc 0
      simp only at ea ec
      rw [ea, ec, sub_self] at e
      linarith [hinv 0]
  
  have hex : ∃ g : ℝ → ℝ, IsGreenT κ (q : ℝ → ℝ) g := ⟨_, hcand⟩
  have hGeq : greenT κ (q : ℝ → ℝ) = Classical.choose hex := by
    unfold greenT
    exact dif_pos hex
  have hG : IsGreenT κ (q : ℝ → ℝ) (greenT κ (q : ℝ → ℝ)) := by
    rw [hGeq]
    exact Classical.choose_spec hex
  exact ⟨hG, uniq _ hG⟩

theorem greenT_eq_rgreenT : ∀ κ ≥ (1 : ℝ), ∀ u : ℝ → ℝ, ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) u → Function.Periodic u 1 → (∫ x in (0:ℝ)..1, u x) < κ → greenT κ (fun x => deriv u x - 2 * κ * u x + u x ^ 2) = rgreenT κ u :=
by
  intro κ hκ u hu hup hM
  obtain ⟨hg, -, hgp, -, hgpos⟩ := rgreenT_ode_T κ u hu.continuous hup hM
  have hu1 : Differentiable ℝ u := (contDiff_infty_iff_deriv.1 hu).1
  have hdu : ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) (deriv u) := (contDiff_infty_iff_deriv.1 hu).2
  have hdup : Function.Periodic (deriv u) 1 := by
    intro y
    have h1 : (fun z => u (z + 1)) = u := funext fun z => hup z
    rw [← deriv_comp_add_const, h1]
  have hqC : (fun x => deriv u x - 2 * κ * u x + u x ^ 2) ∈ CinfT := by
    refine ⟨(hdu.sub (contDiff_const.mul hu)).add (hu.pow 2), ?_⟩
    intro y
    simp only [hdup y, hup y]
  let qT : CinfT := ⟨fun x => deriv u x - 2 * κ * u x + u x ^ 2, hqC⟩
  have hqT : ∀ x, (qT : ℝ → ℝ) x = deriv u x - 2 * κ * u x + u x ^ 2 := fun x => rfl
  set g := rgreenT κ u with hgdef
  let wm : ℝ → ℝ := fun y => (u y - 2 * κ) + (g y)⁻¹
  have hwmp : Function.Periodic wm 1 := by
    intro y
    simp only [wm, hup y, hgp y]
  have hwp : ∀ x, HasDerivAt u ((qT : ℝ → ℝ) x + 2 * κ * u x - u x ^ 2) x := by
    intro x
    refine (hu1 x).hasDerivAt.congr_deriv ?_
    rw [hqT]
    ring
  have hwm : ∀ x, HasDerivAt wm ((qT : ℝ → ℝ) x - 2 * κ * wm x - wm x ^ 2) x := by
    intro x
    have hG : g x ≠ 0 := (hgpos x).ne'
    have ha : HasDerivAt (fun y => u y - 2 * κ) (deriv u x) x :=
      (hu1 x).hasDerivAt.sub_const (2 * κ)
    have hb : HasDerivAt (fun y => (g y)⁻¹)
        (-(2 * (u x - κ) * g x + 1) / g x ^ 2) x := (hg x).inv hG
    refine (ha.add hb).congr_deriv ?_
    rw [hqT]
    simp only [wm]
    field_simp
    ring
  have hpos : ∀ x, 0 < 2 * κ + wm x - u x := by
    intro x
    have e : 2 * κ + wm x - u x = (g x)⁻¹ := by simp only [wm]; ring
    rw [e]
    exact inv_pos.2 (hgpos x)
  obtain ⟨-, hform⟩ := greenT_eq_of_riccati_pair_T κ qT u wm hup hwmp hwp hwm hpos
  funext x
  have e : 2 * κ + wm x - u x = (g x)⁻¹ := by simp only [wm]; ring
  change greenT κ (qT : ℝ → ℝ) x = g x
  rw [hform x, e, one_div, inv_inv]

theorem hk_solution_of_wflowT : ∀ κ ≥ (1 : ℝ), ∀ V : ℝ → ℝ → ℝ, ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) (fun p : ℝ × ℝ => V p.1 p.2) → (∀ t, Function.Periodic (V t) 1) → (∀ t, (∫ x in (0:ℝ)..1, V t x) ≤ κ / 2) → (∀ t x, HasDerivAt (fun s => V s x) (wfieldT κ (V t) x) t) → ∃ c : ℝ → CinfT, IsHkSolutionT κ c ∧ ∀ x, (c 0 : ℝ → ℝ) x = deriv (V 0) x - 2 * κ * V 0 x + V 0 x ^ 2 :=
by
  intro κ hκ V hV hVp hVm hVd
  
  have hpx : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (f : ℝ × ℝ → E),
      Differentiable ℝ f → ∀ t y : ℝ,
        HasDerivAt (fun z => f (t, z)) (fderiv ℝ f (t, y) ((0:ℝ), (1:ℝ))) y := by
    intro E _ _ f hf t y
    have h1 : HasDerivAt (fun z : ℝ => ((t, z) : ℝ × ℝ)) ((0:ℝ), (1:ℝ)) y :=
      (hasDerivAt_const y t).prodMk (hasDerivAt_id y)
    exact (hf (t, y)).hasFDerivAt.comp_hasDerivAt y h1
  have hpt : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] (f : ℝ × ℝ → E),
      Differentiable ℝ f → ∀ t y : ℝ,
        HasDerivAt (fun s => f (s, y)) (fderiv ℝ f (t, y) ((1:ℝ), (0:ℝ))) t := by
    intro E _ _ f hf t y
    have h1 : HasDerivAt (fun s : ℝ => ((s, y) : ℝ × ℝ)) ((1:ℝ), (0:ℝ)) t :=
      (hasDerivAt_id t).prodMk (hasDerivAt_const t y)
    exact (hf (t, y)).hasFDerivAt.comp_hasDerivAt t h1
  
  have hs4 : ∀ (f F : ℝ × ℝ → ℝ), ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) f →
      (∀ t y : ℝ, HasDerivAt (fun s => f (s, y)) (F (t, y)) t) → ∀ b t x : ℝ,
      HasDerivAt (fun s => f (s, x + b * s))
        (F (t, x + b * t) + b * deriv (fun y => f (t, y)) (x + b * t)) t := by
    intro f F hf hF b t x
    have hd : Differentiable ℝ f := (contDiff_infty_iff_fderiv.1 hf).1
    have h2 : HasDerivAt (fun s : ℝ => x + b * s) b t := by
      simpa using ((hasDerivAt_id t).const_mul b).const_add x
    have hγ : HasDerivAt (fun s : ℝ => ((s, x + b * s) : ℝ × ℝ)) ((1:ℝ), b) t :=
      (hasDerivAt_id t).prodMk h2
    have h1 := (hd (t, x + b * t)).hasFDerivAt.comp_hasDerivAt t hγ
    have hsplit : ((1:ℝ), b) = ((1:ℝ), (0:ℝ)) + b • ((0:ℝ), (1:ℝ)) := by
      ext <;> simp
    rw [hsplit, map_add, map_smul, smul_eq_mul] at h1
    have e1 : fderiv ℝ f (t, x + b * t) ((1:ℝ), (0:ℝ)) = F (t, x + b * t) :=
      (hpt f hd t (x + b * t)).unique (hF t (x + b * t))
    have e2 : fderiv ℝ f (t, x + b * t) ((0:ℝ), (1:ℝ)) =
        deriv (fun y => f (t, y)) (x + b * t) :=
      (hpx f hd t (x + b * t)).deriv.symm
    rw [e1, e2] at h1
    exact h1
  
  have hs5 : ∀ (f A : ℝ × ℝ → ℝ), ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) f →
      (∀ t x : ℝ, HasDerivAt (fun s => f (s, x)) (A (t, x)) t) → ∀ t x : ℝ,
      HasDerivAt (fun s => deriv (fun y => f (s, y)) x) (deriv (fun y => A (t, y)) x) t := by
    intro f A hf hA t x
    obtain ⟨hd, hL⟩ := contDiff_infty_iff_fderiv.1 hf
    have hLd : Differentiable ℝ (fderiv ℝ f) := (contDiff_infty_iff_fderiv.1 hL).1
    have hAeq : ∀ s y, A (s, y) = fderiv ℝ f (s, y) ((1:ℝ), (0:ℝ)) :=
      fun s y => (hA s y).unique (hpt f hd s y)
    have hdeq : ∀ s, deriv (fun y => f (s, y)) x = fderiv ℝ f (s, x) ((0:ℝ), (1:ℝ)) :=
      fun s => (hpx f hd s x).deriv
    have h2 : minSmoothness ℝ 2 ≤ (((⊤ : ℕ∞)) : WithTop ℕ∞) := by
      rw [minSmoothness_of_isRCLikeNormedField]
      exact WithTop.coe_le_coe.mpr (le_top : (2 : ℕ∞) ≤ ⊤)
    have hsymm : IsSymmSndFDerivAt ℝ f (t, x) := hf.contDiffAt.isSymmSndFDerivAt h2
    have hAy : HasDerivAt (fun y => A (t, y))
        (fderiv ℝ (fderiv ℝ f) (t, x) ((0:ℝ), (1:ℝ)) ((1:ℝ), (0:ℝ))) x := by
      have h3 := (hpx (fderiv ℝ f) hLd t x).clm_apply (hasDerivAt_const x ((1:ℝ), (0:ℝ)))
      simp only [map_zero, add_zero] at h3
      have hfun : (fun y => A (t, y)) = fun y => fderiv ℝ f (t, y) ((1:ℝ), (0:ℝ)) :=
        funext fun y => hAeq t y
      rw [hfun]
      exact h3
    have hs : HasDerivAt (fun s => fderiv ℝ f (s, x) ((0:ℝ), (1:ℝ)))
        (fderiv ℝ (fderiv ℝ f) (t, x) ((1:ℝ), (0:ℝ)) ((0:ℝ), (1:ℝ))) t := by
      have h3 := (hpt (fderiv ℝ f) hLd t x).clm_apply (hasDerivAt_const t ((0:ℝ), (1:ℝ)))
      simp only [map_zero, add_zero] at h3
      exact h3
    rw [hAy.deriv, ← hsymm ((1:ℝ), (0:ℝ)) ((0:ℝ), (1:ℝ))]
    have hfun : (fun s => deriv (fun y => f (s, y)) x) =
        fun s => fderiv ℝ f (s, x) ((0:ℝ), (1:ℝ)) := funext hdeq
    rw [hfun]
    exact hs
  
  have hs6 : ∀ f : ℝ × ℝ → ℝ, ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) f →
      ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞)
        (fun p : ℝ × ℝ => deriv (fun y => f (p.1, y)) p.2) := by
    intro f hf
    obtain ⟨hd, hL⟩ := contDiff_infty_iff_fderiv.1 hf
    have heq : (fun p : ℝ × ℝ => deriv (fun y => f (p.1, y)) p.2) =
        fun p => fderiv ℝ f p ((0:ℝ), (1:ℝ)) := by
      funext p
      exact (hpx f hd p.1 p.2).deriv
    rw [heq]
    exact hL.clm_apply contDiff_const
  
  have hmean_shift : ∀ (b : ℝ) (f : ℝ → ℝ), Function.Periodic f 1 →
      (∫ y in (0:ℝ)..1, f (y + b)) = ∫ y in (0:ℝ)..1, f y := by
    intro b f hf
    rw [intervalIntegral.integral_comp_add_right f b, zero_add, add_comm 1 b]
    simpa using hf.intervalIntegral_add_eq b 0
  have hcov : ∀ (b : ℝ) (f : ℝ → ℝ), Function.Periodic f 1 → ∀ x,
      wfieldT κ (fun y => f (y + b)) x = wfieldT κ f (x + b) := by
    intro b f hf x
    have hm := hmean_shift b f hf
    have hl : ∀ s, (∫ y in (x - s)..x, f (y + b)) = ∫ y in (x + b - s)..(x + b), f y := by
      intro s
      rw [intervalIntegral.integral_comp_add_right f b, show x - s + b = x + b - s by ring]
    have hr : ∀ s, (∫ y in x..(x + s), f (y + b)) = ∫ y in (x + b)..(x + b + s), f y := by
      intro s
      rw [intervalIntegral.integral_comp_add_right f b, show x + s + b = x + b + s by ring]
    simp only [wfieldT, rgreenT, rgreenRT, hm, hl, hr]
  
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = 4 * κ ^ 2 := ⟨_, rfl⟩
  obtain ⟨u, hu⟩ : ∃ u : ℝ → ℝ → ℝ, ∀ t y, u t y = V t (y + a * t) :=
    ⟨fun t y => V t (y + a * t), fun _ _ => rfl⟩
  have hUs : ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) (fun p : ℝ × ℝ => u p.1 p.2) := by
    have e : (fun p : ℝ × ℝ => u p.1 p.2) = fun p => V p.1 (p.2 + a * p.1) :=
      funext fun p => hu p.1 p.2
    rw [e]
    exact hV.comp (contDiff_fst.prodMk (contDiff_snd.add (contDiff_const.mul contDiff_fst)))
  have hut : ∀ t, ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) (u t) := fun t =>
    hUs.comp (contDiff_const.prodMk contDiff_id)
  have hup : ∀ t, Function.Periodic (u t) 1 := by
    intro t y
    rw [hu, hu, show y + 1 + a * t = (y + a * t) + 1 by ring]
    exact hVp t _
  have hdup : ∀ t, Function.Periodic (deriv (u t)) 1 := by
    intro t y
    have h1 : (fun z => u t (z + 1)) = u t := funext fun z => hup t z
    rw [← deriv_comp_add_const, h1]
  have hu1 : ∀ t, Differentiable ℝ (u t) := fun t => (contDiff_infty_iff_deriv.1 (hut t)).1
  have hdus : ∀ t, ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) (deriv (u t)) :=
    fun t => (contDiff_infty_iff_deriv.1 (hut t)).2
  have hu2 : ∀ t, Differentiable ℝ (deriv (u t)) :=
    fun t => (contDiff_infty_iff_deriv.1 (hdus t)).1
  have hmean : ∀ t, (∫ y in (0:ℝ)..1, u t y) < κ := by
    intro t
    have e : (∫ y in (0:ℝ)..1, u t y) = ∫ y in (0:ℝ)..1, V t (y + a * t) := by
      simp_rw [hu]
    rw [e, hmean_shift (a * t) (V t) (hVp t)]
    linarith [hVm t]
  
  have hUt : ∀ t x, HasDerivAt (fun s => u s x) (a * deriv (u t) x + wfieldT κ (u t) x) t := by
    intro t x
    have h4 : HasDerivAt (fun s => V s (x + a * s))
        (wfieldT κ (V t) (x + a * t) + a * deriv (V t) (x + a * t)) t :=
      hs4 (fun p => V p.1 p.2) (fun p => wfieldT κ (V p.1) p.2) hV (fun t y => hVd t y) a t x
    have hfun : (fun s => u s x) = fun s => V s (x + a * s) := funext fun s => hu s x
    have hut_eq : u t = fun y => V t (y + a * t) := funext fun y => hu t y
    have e1 : wfieldT κ (u t) x = wfieldT κ (V t) (x + a * t) := by
      rw [hut_eq]
      exact hcov (a * t) (V t) (hVp t) x
    have e2 : deriv (u t) x = deriv (V t) (x + a * t) := by
      rw [hut_eq]
      exact deriv_comp_add_const _ _ _
    rw [hfun, e1, e2]
    exact h4.congr_deriv (by ring)
  
  have hcs : ∀ t, (fun x => deriv (u t) x - 2 * κ * u t x + u t x ^ 2) ∈ CinfT := by
    intro t
    refine ⟨((hdus t).sub (contDiff_const.mul (hut t))).add ((hut t).pow 2), ?_⟩
    intro y
    simp only [hdup t y, hup t y]
  obtain ⟨c, hc⟩ : ∃ c : ℝ → CinfT, ∀ t x,
      (c t : ℝ → ℝ) x = deriv (u t) x - 2 * κ * u t x + u t x ^ 2 :=
    ⟨fun t => ⟨_, hcs t⟩, fun _ _ => rfl⟩
  have hcf : ∀ t, (c t : ℝ → ℝ) = fun x => deriv (u t) x - 2 * κ * u t x + u t x ^ 2 :=
    fun t => funext (hc t)
  refine ⟨c, ⟨?_, ?_⟩, ?_⟩
  · 
    have hfun : (fun p : ℝ × ℝ => (c p.1 : ℝ → ℝ) p.2) =
        fun p => deriv (u p.1) p.2 - 2 * κ * u p.1 p.2 + u p.1 p.2 ^ 2 :=
      funext fun p => hc p.1 p.2
    rw [hfun]
    have h6 : ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) (fun p : ℝ × ℝ => deriv (u p.1) p.2) :=
      hs6 (fun p => u p.1 p.2) hUs
    exact (h6.sub (contDiff_const.mul hUs)).add (hUs.pow 2)
  · intro t x
    obtain ⟨hg, hh, -, -, -⟩ := rgreenT_ode_T κ (u t) (hut t).continuous (hup t) (hmean t)
    have hW : HasDerivAt (wfieldT κ (u t))
        (8 * κ ^ 5 * ((2 * (u t x - κ) * rgreenT κ (u t) x + 1) -
          (2 * (κ - u t x) * rgreenRT κ (u t) x - 1))) x :=
      ((hg x).sub (hh x)).const_mul (8 * κ ^ 5)
    have hA : HasDerivAt (fun y => a * deriv (u t) y + wfieldT κ (u t) y)
        (a * deriv (deriv (u t)) x + 8 * κ ^ 5 * ((2 * (u t x - κ) * rgreenT κ (u t) x + 1) -
          (2 * (κ - u t x) * rgreenRT κ (u t) x - 1))) x :=
      ((hu2 t x).hasDerivAt.const_mul a).add hW
    have h5 : HasDerivAt (fun s => deriv (u s) x)
        (deriv (fun y => a * deriv (u t) y + wfieldT κ (u t) y) x) t :=
      hs5 (fun p => u p.1 p.2) (fun p => a * deriv (u p.1) p.2 + wfieldT κ (u p.1) p.2) hUs
        (fun t x => hUt t x) t x
    rw [hA.deriv] at h5
    have hd : HasDerivAt (fun y => deriv (u t) y - 2 * κ * u t y + u t y ^ 2)
        (deriv (deriv (u t)) x - 2 * κ * deriv (u t) x + 2 * u t x * deriv (u t) x) x := by
      have h3 := ((hu2 t x).hasDerivAt.sub ((hu1 t x).hasDerivAt.const_mul (2 * κ))).add
        ((hu1 t x).hasDerivAt.pow 2)
      refine h3.congr_deriv ?_
      norm_num
    have hRHS : hkRHST κ (c t : ℝ → ℝ) x =
        16 * κ ^ 5 * (2 * (u t x - κ) * rgreenT κ (u t) x + 1) +
          4 * κ ^ 2 * (deriv (deriv (u t)) x - 2 * κ * deriv (u t) x +
            2 * u t x * deriv (u t) x) := by
      unfold hkRHST
      rw [hcf t, greenT_eq_rgreenT κ hκ (u t) (hut t) (hup t) (hmean t), (hg x).deriv, hd.deriv]
    have hfun : (fun s => (c s : ℝ → ℝ) x) =
        fun s => deriv (u s) x - 2 * κ * u s x + u s x ^ 2 := funext fun s => hc s x
    rw [hfun, hRHS]
    refine ((h5.sub ((hUt t x).const_mul (2 * κ))).add ((hUt t x).pow 2)).congr_deriv ?_
    simp only [wfieldT, ha]
    norm_num
    ring
  · intro x
    have hu0 : u 0 = V 0 := by
      funext y
      rw [hu]
      simp
    rw [hc, hu0]

theorem hk_flow_T_exists : ∀ R ≥ (0 : ℝ), ∃ κ₀ ≥ (1 : ℝ), ∀ κ ≥ κ₀, ∀ q : CinfT,
    ‖ιT q‖ ≤ R → ∃ c : ℝ → CinfT, IsHkSolutionT κ c ∧ c 0 = q :=
by
  intro R hR
  have hκ₀1 : (1 : ℝ) ≤ 1024 * R ^ 2 + 1 := by nlinarith [sq_nonneg R]
  refine ⟨max (1024 * R ^ 2 + 1) (9 / 4 * R + 2), le_trans hκ₀1 (le_max_left _ _), ?_⟩
  intro κ hκ q hq
  have hκa : 1024 * R ^ 2 + 1 ≤ κ := le_trans (le_max_left _ _) hκ
  have hκb : 9 / 4 * R + 2 ≤ κ := le_trans (le_max_right _ _) hκ
  have hk1 : (1 : ℝ) ≤ κ := le_trans hκ₀1 hκa
  have hqs : ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) (q : ℝ → ℝ) := q.2.1
  have hqp : Function.Periodic (q : ℝ → ℝ) 1 := q.2.2
  
  obtain ⟨v, hvp, hv⟩ := (periodic_resolvent_T κ hk1 (q : ℝ → ℝ) hqs.continuous hqp).1
  
  have hpars := periodic_resolvent_parseval_T κ hk1 q v hvp hv
  obtain ⟨_, hwc, _⟩ := weight_compare_T ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) κ hk1
  have hnorm : ‖((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ≤ R := hq
  have hv2 : (∫ x in (0:ℝ)..1, v x ^ 2) ≤ R ^ 2 := by
    rw [hpars]
    exact le_trans hwc (pow_le_pow_left₀ (norm_nonneg _) hnorm 2)
  
  have hvk : (∫ x in (0:ℝ)..1, v x ^ 2) ≤ κ / 1024 := by linarith
  obtain ⟨w₀, hw₀p, hw₀d, _, hw₀e⟩ :=
    periodic_riccati_exists_T κ hk1 (q : ℝ → ℝ) v hqs.continuous hqp hvp hv hvk
  
  have hderiv : deriv w₀ = fun x => (q : ℝ → ℝ) x + 2 * κ * w₀ x - w₀ x ^ 2 :=
    funext fun x => (hw₀d x).deriv
  have hdiff : Differentiable ℝ w₀ := fun x => (hw₀d x).differentiableAt
  have hsmooth : ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) w₀ := by
    rw [contDiff_infty]
    intro n
    induction n with
    | zero => exact contDiff_zero.2 hdiff.continuous
    | succ n ih =>
      rw [show ((n + 1 : ℕ) : WithTop ℕ∞) = (n : WithTop ℕ∞) + 1 by norm_cast,
        contDiff_succ_iff_deriv]
      refine ⟨hdiff, by simp, ?_⟩
      rw [hderiv]
      have hqn : ContDiff ℝ (n : WithTop ℕ∞) (q : ℝ → ℝ) := hqs.of_le (by exact_mod_cast le_top)
      exact (hqn.add (contDiff_const.mul ih)).sub (ih.pow 2)
  
  set ρ : ℝ := 9 / 8 * R + 1 with hρdef
  have hρ : 0 ≤ ρ := by positivity
  have h2ρ : 2 * ρ ≤ κ := by rw [hρdef]; linarith
  have hρsq : ρ ^ 2 = 81 / 64 * R ^ 2 + 9 / 4 * R + 1 := by rw [hρdef]; ring
  have hw0R : (∫ x in (0:ℝ)..1, w₀ x ^ 2) ≤ 81 / 64 * R ^ 2 := by linarith
  have hw0ρ : (∫ x in (0:ℝ)..1, w₀ x ^ 2) < ρ ^ 2 := by rw [hρsq]; linarith
  
  obtain ⟨V, hV0, hVc, hVp, hVe, hVd⟩ :=
    wflowT_exists κ hk1 ρ hρ h2ρ w₀ hsmooth.continuous hw₀p hw0ρ
  
  have hVmean : ∀ t, (∫ x in (0:ℝ)..1, V t x) ≤ κ / 2 := by
    intro t
    have hct : Continuous (V t) := hVc.comp (by fun_prop : Continuous fun x : ℝ => (t, x))
    have hcs := cauchy_schwarz_unit_interval (V t) (fun _ => 1) hct continuous_const
    have e1 : (∫ x in (0:ℝ)..1, V t x * (fun _ : ℝ => (1 : ℝ)) x) = ∫ x in (0:ℝ)..1, V t x := by
      simp
    have e2 : (∫ x in (0:ℝ)..1, (fun _ : ℝ => (1 : ℝ)) x ^ 2) = 1 := by simp
    rw [e1, e2, mul_one, hVe t] at hcs
    have hsq : (∫ x in (0:ℝ)..1, V t x) ^ 2 ≤ (9 / 8 * R) ^ 2 := by nlinarith
    have habs := abs_le_of_sq_le_sq' hsq (by positivity)
    linarith [habs.2]
  
  have hV0eq : V 0 = w₀ := funext hV0
  have hV0s : ContDiff ℝ (((⊤ : ℕ∞)) : WithTop ℕ∞) (V 0) := by rw [hV0eq]; exact hsmooth
  have hVs := wflowT_smooth κ hk1 V hV0s hVc hVp hVmean hVd
  
  obtain ⟨c, hc, hc0⟩ := hk_solution_of_wflowT κ hk1 V hVs hVp hVmean hVd
  
  refine ⟨c, hc, ?_⟩
  apply Subtype.ext
  funext x
  rw [hc0 x, hV0eq, hderiv]
  ring

theorem riccati_pair_T : ∀ κ : ℝ, 1 ≤ κ → ∀ q : CinfT, WT κ ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ≤ κ / 1024 → ∃ wp wm : ℝ → ℝ, Function.Periodic wp 1 ∧ Function.Periodic wm 1 ∧ (∀ x, HasDerivAt wp ((q : ℝ → ℝ) x + 2 * κ * wp x - wp x ^ 2) x) ∧ (∀ x, HasDerivAt wm ((q : ℝ → ℝ) x - 2 * κ * wm x - wm x ^ 2) x) ∧ (∫ x in (0:ℝ)..1, wp x ^ 2) ≤ κ / 64 ∧ (∫ x in (0:ℝ)..1, wm x ^ 2) ≤ κ / 64 ∧ ∀ x, |wm x - wp x| ≤ κ / 2 :=
by
  intro κ hκ q hW
  have hκ0 : (0:ℝ) < κ := by linarith
  have hκne : κ ≠ 0 := hκ0.ne'
  set Q : ℝ → ℝ := (q : ℝ → ℝ) with hQdef
  have hQc : Continuous Q := q.2.1.continuous
  have hQp : Function.Periodic Q 1 := q.2.2
  
  have hcont : ∀ (f F : ℝ → ℝ), (∀ x, HasDerivAt f (F x) x) → Continuous f :=
    fun f F h => continuous_iff_continuousAt.2 fun x => (h x).continuousAt
  have hreflD : ∀ (f F : ℝ → ℝ), (∀ y, HasDerivAt f (F y) y) → ∀ x,
      HasDerivAt (fun y => -f (-y)) (F (-x)) x := by
    intro f F hf x
    have h1 := ((hf (-x)).comp x (hasDerivAt_neg x)).neg
    refine h1.congr_deriv ?_
    ring
  have hreflP : ∀ f : ℝ → ℝ, Function.Periodic f 1 → Function.Periodic (fun y => -f (-y)) 1 := by
    intro f hf x
    have h1 := hf (-(x + 1))
    rw [show -(x + 1) + 1 = -x by ring] at h1
    show -f (-(x + 1)) = -f (-x)
    rw [h1]
  have hR : ∀ g : ℝ → ℝ, Function.Periodic g 1 →
      (∫ x in (0:ℝ)..1, g (-x)) = ∫ x in (0:ℝ)..1, g x := by
    intro g hg
    rw [intervalIntegral.integral_comp_neg]
    have h1 := hg.intervalIntegral_add_eq (-1) 0
    norm_num at h1
    simpa using h1
  have hRsq : ∀ f : ℝ → ℝ, Function.Periodic f 1 →
      (∫ x in (0:ℝ)..1, (-f (-x)) ^ 2) = ∫ x in (0:ℝ)..1, f x ^ 2 := by
    intro f hf
    have h2 : (∫ x in (0:ℝ)..1, f (-x) ^ 2) = ∫ x in (0:ℝ)..1, f x ^ 2 :=
      hR (fun y => f y ^ 2) (fun x => by show f (x + 1) ^ 2 = f x ^ 2; rw [hf x])
    simp only [neg_sq]
    exact h2
  have hdiff : ∀ (P v w : ℝ → ℝ), Function.Periodic v 1 →
      (∀ x, HasDerivAt v (2 * κ * v x + P x) x) → Function.Periodic w 1 →
      (∀ x, HasDerivAt w (P x + 2 * κ * w x - w x ^ 2) x) →
      ∀ x, |w x - v x| ≤ 2 * ∫ y in (0:ℝ)..1, w y ^ 2 := by
    intro P v w hvP hvD hwP hwD x
    have hwc := hcont w _ hwD
    have hfc : Continuous (fun y => -(w y ^ 2)) := (hwc.pow 2).neg
    have hfp : Function.Periodic (fun y => -(w y ^ 2)) 1 := fun y => by
      show -(w (y + 1) ^ 2) = -(w y ^ 2)
      rw [hwP y]
    have hyP : Function.Periodic (fun y => w y - v y) 1 := fun y => by
      show w (y + 1) - v (y + 1) = w y - v y
      rw [hwP y, hvP y]
    have hyD : ∀ y, HasDerivAt (fun y => w y - v y) (2 * κ * (w y - v y) + -(w y ^ 2)) y := by
      intro y
      refine ((hwD y).sub (hvD y)).congr_deriv ?_
      ring
    have h : |w x - v x| ≤ 2 * ∫ y in (0:ℝ)..1, |-(w y ^ 2)| :=
      ((periodic_resolvent_T κ hκ _ hfc hfp).2 _ hyP hyD).2.1 x
    have he : (∫ y in (0:ℝ)..1, |-(w y ^ 2)|) = ∫ y in (0:ℝ)..1, w y ^ 2 := by
      refine intervalIntegral.integral_congr (fun y _ => ?_)
      simp only [abs_neg, abs_of_nonneg (sq_nonneg (w y))]
    rw [he] at h
    exact h
  
  obtain ⟨vp, hvpP, hvpD⟩ := (periodic_resolvent_T κ hκ Q hQc hQp).1
  have hvp2 : (∫ x in (0:ℝ)..1, vp x ^ 2) ≤ κ / 1024 := by
    have h := periodic_resolvent_parseval_T κ hκ q vp hvpP hvpD
    rw [h]
    exact hW
  
  obtain ⟨Qr, hQr⟩ : ∃ Qr : ℝ → ℝ, Qr = fun x => Q (-x) := ⟨_, rfl⟩
  have hQrx : ∀ x, Qr x = Q (-x) := fun x => by rw [hQr]
  have hQrc : Continuous Qr := by rw [hQr]; exact hQc.comp continuous_neg
  have hQrp : Function.Periodic Qr 1 := by
    intro x
    rw [hQrx, hQrx]
    have h1 := hQp (-(x + 1))
    rw [show -(x + 1) + 1 = -x by ring] at h1
    exact h1.symm
  obtain ⟨vr, hvrP, hvrD⟩ := (periodic_resolvent_T κ hκ Qr hQrc hQrp).1
  obtain ⟨vm, hvm⟩ : ∃ vm : ℝ → ℝ, vm = fun y => -vr (-y) := ⟨_, rfl⟩
  have hvmx : ∀ x, vm x = -vr (-x) := fun x => by rw [hvm]
  have hvmP : Function.Periodic vm 1 := by rw [hvm]; exact hreflP vr hvrP
  have hvmD : ∀ x, HasDerivAt vm (Q x - 2 * κ * vm x) x := by
    intro x
    rw [hvm]
    refine (hreflD vr _ hvrD x).congr_deriv ?_
    simp only [hQrx, neg_neg]
    ring
  have hvpc := hcont vp _ hvpD
  have hvmc := hcont vm _ hvmD
  
  have hiso : (∫ x in (0:ℝ)..1, vm x ^ 2) = ∫ x in (0:ℝ)..1, vp x ^ 2 := by
    have hF : ∀ x ∈ Set.uIcc (0:ℝ) 1, HasDerivAt
        (fun y => -(1 / (4 * κ)) * ((vm y - vp y) * (vm y - vp y))) (vm x ^ 2 - vp x ^ 2) x := by
      intro x _
      have h1 := (((hvmD x).sub (hvpD x)).mul ((hvmD x).sub (hvpD x))).const_mul (-(1 / (4 * κ)))
      refine h1.congr_deriv ?_
      simp only [Pi.sub_apply]
      field_simp
      ring
    have hint : IntervalIntegrable (fun x => vm x ^ 2 - vp x ^ 2) MeasureTheory.volume 0 1 :=
      ((hvmc.pow 2).sub (hvpc.pow 2)).intervalIntegrable 0 1
    have h2 := intervalIntegral.integral_eq_sub_of_hasDerivAt hF hint
    rw [intervalIntegral.integral_sub ((hvmc.pow 2).intervalIntegrable 0 1)
      ((hvpc.pow 2).intervalIntegrable 0 1)] at h2
    have h3 : vm 1 = vm 0 := by simpa using hvmP 0
    have h4 : vp 1 = vp 0 := by simpa using hvpP 0
    rw [h3, h4, sub_self] at h2
    linarith
  have hvm2 : (∫ x in (0:ℝ)..1, vm x ^ 2) ≤ κ / 1024 := by rw [hiso]; exact hvp2
  have hvr2 : (∫ x in (0:ℝ)..1, vr x ^ 2) ≤ κ / 1024 := by
    have h1 : (∫ x in (0:ℝ)..1, vm x ^ 2) = ∫ x in (0:ℝ)..1, vr x ^ 2 := by
      simp only [hvmx]
      exact hRsq vr hvrP
    linarith
  
  obtain ⟨wp, hwpP, hwpD, -, hwp2'⟩ :=
    periodic_riccati_exists_T κ hκ Q vp hQc hQp hvpP hvpD hvp2
  obtain ⟨wr, hwrP, hwrD, -, hwr2'⟩ :=
    periodic_riccati_exists_T κ hκ Qr vr hQrc hQrp hvrP hvrD hvr2
  obtain ⟨wm, hwm⟩ : ∃ wm : ℝ → ℝ, wm = fun y => -wr (-y) := ⟨_, rfl⟩
  have hwmx : ∀ x, wm x = -wr (-x) := fun x => by rw [hwm]
  have hwmP : Function.Periodic wm 1 := by rw [hwm]; exact hreflP wr hwrP
  have hwmD : ∀ x, HasDerivAt wm (Q x - 2 * κ * wm x - wm x ^ 2) x := by
    intro x
    rw [hwm]
    refine (hreflD wr _ hwrD x).congr_deriv ?_
    simp only [hQrx, neg_neg]
    ring
  have hwp2 : (∫ x in (0:ℝ)..1, wp x ^ 2) ≤ κ / 64 := by linarith
  have hwmr : (∫ x in (0:ℝ)..1, wm x ^ 2) = ∫ x in (0:ℝ)..1, wr x ^ 2 := by
    simp only [hwmx]
    exact hRsq wr hwrP
  have hwm2 : (∫ x in (0:ℝ)..1, wm x ^ 2) ≤ κ / 64 := by rw [hwmr]; linarith
  
  have hdp : ∀ x, |wp x - vp x| ≤ κ / 32 := by
    intro x
    have h := hdiff Q vp wp hvpP hvpD hwpP hwpD x
    linarith
  have hdm : ∀ x, |wm x - vm x| ≤ κ / 32 := by
    intro x
    have h := hdiff Qr vr wr hvrP hvrD hwrP hwrD (-x)
    rw [hwmx, hvmx, show -wr (-x) - -vr (-x) = -(wr (-x) - vr (-x)) by ring, abs_neg]
    linarith
  
  have hsob : ∀ x, |vm x - vp x| ≤ κ / 4 := by
    intro x
    have hhc : Continuous (fun t => κ * (vm t - vp t) ^ 2 + 4 * κ * (vm t + vp t) ^ 2) :=
      (continuous_const.mul ((hvmc.sub hvpc).pow 2)).add
        (continuous_const.mul ((hvmc.add hvpc).pow 2))
    have hhp : Function.Periodic
        (fun t => κ * (vm t - vp t) ^ 2 + 4 * κ * (vm t + vp t) ^ 2) 1 := fun t => by
      simp only [hvmP t, hvpP t]
    have hh0 : ∀ t, 0 ≤ κ * (vm t - vp t) ^ 2 + 4 * κ * (vm t + vp t) ^ 2 := fun t => by
      positivity
    have hDc : Continuous (fun t => -4 * κ * ((vm t - vp t) * (vm t + vp t))) :=
      continuous_const.mul ((hvmc.sub hvpc).mul (hvmc.add hvpc))
    have hu2c : Continuous (fun t => (vm t - vp t) ^ 2) := (hvmc.sub hvpc).pow 2
    have hu2p : Function.Periodic (fun t => (vm t - vp t) ^ 2) 1 := fun t => by
      simp only [hvmP t, hvpP t]
    have hIh : (∫ t in (x - 1)..x, κ * (vm t - vp t) ^ 2 + 4 * κ * (vm t + vp t) ^ 2) =
        ∫ t in (0:ℝ)..1, κ * (vm t - vp t) ^ 2 + 4 * κ * (vm t + vp t) ^ 2 := by
      have h1 := hhp.intervalIntegral_add_eq (x - 1) 0
      rw [show x - 1 + 1 = x by ring, zero_add] at h1
      exact h1
    have hIu : (∫ t in (x - 1)..x, (vm t - vp t) ^ 2) = ∫ t in (0:ℝ)..1, (vm t - vp t) ^ 2 := by
      have h1 := hu2p.intervalIntegral_add_eq (x - 1) 0
      rw [show x - 1 + 1 = x by ring, zero_add] at h1
      exact h1
    set I := ∫ t in (0:ℝ)..1, κ * (vm t - vp t) ^ 2 + 4 * κ * (vm t + vp t) ^ 2 with hI
    have key : ∀ y ∈ Set.Icc (x - 1) x, (vm x - vp x) ^ 2 ≤ (vm y - vp y) ^ 2 + I := by
      intro y hy
      have hF : ∀ t ∈ Set.uIcc y x, HasDerivAt (fun s => (vm s - vp s) * (vm s - vp s))
          (-4 * κ * ((vm t - vp t) * (vm t + vp t))) t := by
        intro t _
        refine (((hvmD t).sub (hvpD t)).mul ((hvmD t).sub (hvpD t))).congr_deriv ?_
        simp only [Pi.sub_apply]
        ring
      have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hF (hDc.intervalIntegrable y x)
      have hmon := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) hy.2
        (hDc.intervalIntegrable y x)
        (hhc.intervalIntegrable y x) (fun t _ => by
          nlinarith [mul_nonneg hκ0.le (sq_nonneg ((vm t - vp t) + 2 * (vm t + vp t)))])
      have hadd := intervalIntegral.integral_add_adjacent_intervals (μ := MeasureTheory.volume)
        (hhc.intervalIntegrable (x - 1) y) (hhc.intervalIntegrable y x)
      have hnn := intervalIntegral.integral_nonneg (μ := MeasureTheory.volume) hy.1
        (fun t _ => hh0 t)
      rw [hIh] at hadd
      nlinarith
    have hmono := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume)
      (by linarith : x - 1 ≤ x)
      (f := fun _ => (vm x - vp x) ^ 2) (g := fun y => (vm y - vp y) ^ 2 + I)
      (continuous_const.intervalIntegrable _ _)
      ((hu2c.add continuous_const).intervalIntegrable _ _) key
    rw [intervalIntegral.integral_const, intervalIntegral.integral_add
      (hu2c.intervalIntegrable _ _) (continuous_const.intervalIntegrable _ _),
      intervalIntegral.integral_const, hIu] at hmono
    simp only [show x - (x - 1) = (1:ℝ) by ring, one_smul] at hmono
    have hA := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) zero_le_one
      (f := fun y => (vm y - vp y) ^ 2 + (κ * (vm y - vp y) ^ 2 + 4 * κ * (vm y + vp y) ^ 2))
      (g := fun y => 12 * κ * (vm y ^ 2 + vp y ^ 2))
      ((hu2c.add hhc).intervalIntegrable _ _)
      ((continuous_const.mul ((hvmc.pow 2).add (hvpc.pow 2))).intervalIntegrable _ _)
      (fun y _ => by
        nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ 3 * κ - 1) (sq_nonneg (vm y - vp y)),
          mul_nonneg hκ0.le (sq_nonneg (vm y)), mul_nonneg hκ0.le (sq_nonneg (vp y))])
    rw [intervalIntegral.integral_add (hu2c.intervalIntegrable _ _) (hhc.intervalIntegrable _ _),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_add
      ((hvmc.pow 2).intervalIntegrable _ _) ((hvpc.pow 2).intervalIntegrable _ _)] at hA
    have hB : 12 * κ * ((∫ x in (0:ℝ)..1, vm x ^ 2) + ∫ x in (0:ℝ)..1, vp x ^ 2) ≤
        12 * κ * (κ / 1024 + κ / 1024) :=
      mul_le_mul_of_nonneg_left (by linarith) (by positivity)
    have hsq : (vm x - vp x) ^ 2 ≤ (κ / 4) ^ 2 := by nlinarith
    exact abs_le_of_sq_le_sq hsq (by positivity)
  refine ⟨wp, wm, hwpP, hwmP, hwpD, hwmD, hwp2, hwm2, fun x => ?_⟩
  have e1 := abs_le.1 (hsob x)
  have e2 := abs_le.1 (hdm x)
  have e3 := abs_le.1 (hdp x)
  rw [abs_le]
  constructor <;> linarith

theorem riccati_L2_lipschitz_plus_T : ∀ κ : ℝ, 1 ≤ κ → ∀ q p : CinfT, ∀ w₁ w₂ : ℝ → ℝ, Function.Periodic w₁ 1 → Function.Periodic w₂ 1 → (∀ x, HasDerivAt w₁ ((q : ℝ → ℝ) x + 2 * κ * w₁ x - w₁ x ^ 2) x) → (∀ x, HasDerivAt w₂ ((p : ℝ → ℝ) x + 2 * κ * w₂ x - w₂ x ^ 2) x) → (∫ x in (0:ℝ)..1, w₁ x ^ 2) ≤ κ / 64 → (∫ x in (0:ℝ)..1, w₂ x ^ 2) ≤ κ / 64 → (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2) ≤ 2 * ‖ιT q - ιT p‖ ^ 2 :=
by
  intro κ hκ q p w₁ w₂ hw₁P hw₂P hw₁ hw₂ h₁ h₂
  have hκ0 : 0 < κ := by linarith
  have cw₁ : Continuous w₁ := continuous_iff_continuousAt.2 fun x => (hw₁ x).continuousAt
  have cw₂ : Continuous w₂ := continuous_iff_continuousAt.2 fun x => (hw₂ x).continuousAt
  
  obtain ⟨r, hrx⟩ : ∃ r : CinfT, ∀ x, (r : ℝ → ℝ) x = (q : ℝ → ℝ) x - (p : ℝ → ℝ) x :=
    ⟨⟨fun x => (q : ℝ → ℝ) x - (p : ℝ → ℝ) x, q.2.1.sub p.2.1,
      fun x => by simp only [q.2.2 x, p.2.2 x]⟩, fun x => rfl⟩
  have hr : ιT r = ιT q - ιT p := by
    apply Subtype.ext
    show toHm1T r = toHm1T q - toHm1T p
    rw [toHm1T_basic.1 q p r 1 (-1) (fun x => by rw [hrx x]; ring), one_smul, neg_one_smul,
      ← sub_eq_add_neg]
  
  obtain ⟨⟨v, hvP, hvD⟩, -⟩ := periodic_resolvent_T κ hκ (r : ℝ → ℝ) r.2.1.continuous r.2.2
  have cv : Continuous v := continuous_iff_continuousAt.2 fun x => (hvD x).continuousAt
  
  have hV : (∫ x in (0:ℝ)..1, v x ^ 2) ≤ ‖ιT q - ιT p‖ ^ 2 := by
    rw [periodic_resolvent_parseval_T κ hκ r v hvP hvD, ← hr]
    exact (weight_compare_T ((ιT r : Hm1T) : lp (fun _ : ℤ => ℂ) 2) κ hκ).2.1
  have hV0 : 0 ≤ ∫ x in (0:ℝ)..1, v x ^ 2 :=
    intervalIntegral.integral_nonneg zero_le_one (fun x _ => sq_nonneg _)
  have hD0 : 0 ≤ ∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2 :=
    intervalIntegral.integral_nonneg zero_le_one (fun x _ => sq_nonneg _)
  
  have hS : (∫ x in (0:ℝ)..1, (w₁ x + w₂ x) ^ 2) ≤ κ / 16 := by
    have i1 : IntervalIntegrable (fun x => 2 * w₁ x ^ 2) MeasureTheory.volume 0 1 :=
      (continuous_const.mul (cw₁.pow 2)).intervalIntegrable 0 1
    have i2 : IntervalIntegrable (fun x => 2 * w₂ x ^ 2) MeasureTheory.volume 0 1 :=
      (continuous_const.mul (cw₂.pow 2)).intervalIntegrable 0 1
    have hmono : (∫ x in (0:ℝ)..1, (w₁ x + w₂ x) ^ 2) ≤
        ∫ x in (0:ℝ)..1, (2 * w₁ x ^ 2 + 2 * w₂ x ^ 2) :=
      intervalIntegral.integral_mono_on zero_le_one
        (((cw₁.add cw₂).pow 2).intervalIntegrable 0 1) (i1.add i2)
        (fun x _ => by nlinarith [sq_nonneg (w₁ x - w₂ x)])
    rw [intervalIntegral.integral_add i1 i2, intervalIntegral.integral_const_mul,
      intervalIntegral.integral_const_mul] at hmono
    linarith
  
  have he : ∀ x, HasDerivAt (fun y => w₁ y - w₂ y - v y)
      (2 * κ * (w₁ x - w₂ x - v x) + (fun y => -((w₁ y + w₂ y) * (w₁ y - w₂ y))) x) x := by
    intro x
    refine (((hw₁ x).sub (hw₂ x)).sub (hvD x)).congr_deriv ?_
    rw [hrx x]
    ring
  have cf : Continuous (fun y => -((w₁ y + w₂ y) * (w₁ y - w₂ y))) :=
    ((cw₁.add cw₂).mul (cw₁.sub cw₂)).neg
  have hfP : Function.Periodic (fun y => -((w₁ y + w₂ y) * (w₁ y - w₂ y))) 1 :=
    fun x => by simp only [hw₁P x, hw₂P x]
  have heP : Function.Periodic (fun y => w₁ y - w₂ y - v y) 1 :=
    fun x => by simp only [hw₁P x, hw₂P x, hvP x]
  have hE2 : (∫ x in (0:ℝ)..1, (w₁ x - w₂ x - v x) ^ 2) ≤
      (∫ x in (0:ℝ)..1, |(w₁ x + w₂ x) * (w₁ x - w₂ x)|) ^ 2 / κ := by
    have := ((periodic_resolvent_T κ hκ _ cf hfP).2 _ heP he).2.2.2
    simpa only [abs_neg] using this
  
  have hCS1 : (∫ x in (0:ℝ)..1, |(w₁ x + w₂ x) * (w₁ x - w₂ x)|) ^ 2 ≤
      (∫ x in (0:ℝ)..1, (w₁ x + w₂ x) ^ 2) * (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2) := by
    have := cauchy_schwarz_unit_interval (fun x => |w₁ x + w₂ x|) (fun x => |w₁ x - w₂ x|)
      (cw₁.add cw₂).abs (cw₁.sub cw₂).abs
    simpa only [abs_mul, sq_abs] using this
  have hE : (∫ x in (0:ℝ)..1, (w₁ x - w₂ x - v x) ^ 2) ≤
      (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2) / 16 := by
    have h1 : (∫ x in (0:ℝ)..1, |(w₁ x + w₂ x) * (w₁ x - w₂ x)|) ^ 2 ≤
        κ / 16 * (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2) :=
      le_trans hCS1 (mul_le_mul_of_nonneg_right hS hD0)
    rw [le_div_iff₀ hκ0] at hE2
    have h3 : (∫ x in (0:ℝ)..1, (w₁ x - w₂ x - v x) ^ 2) * κ ≤
        (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2) / 16 * κ := by linarith
    exact le_of_mul_le_mul_right h3 hκ0
  
  have hsplit : (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2) =
      (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) * v x) +
        ∫ x in (0:ℝ)..1, (w₁ x - w₂ x) * (w₁ x - w₂ x - v x) := by
    rw [← intervalIntegral.integral_add (((cw₁.sub cw₂).mul cv).intervalIntegrable 0 1)
      (((cw₁.sub cw₂).mul ((cw₁.sub cw₂).sub cv)).intervalIntegrable 0 1)]
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    show (w₁ x - w₂ x) ^ 2 = (w₁ x - w₂ x) * v x + (w₁ x - w₂ x) * (w₁ x - w₂ x - v x)
    ring
  
  have hX : (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) * v x) ^ 2 ≤
      (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2) * (∫ x in (0:ℝ)..1, v x ^ 2) :=
    cauchy_schwarz_unit_interval (fun x => w₁ x - w₂ x) v (cw₁.sub cw₂) cv
  have hY : (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) * (w₁ x - w₂ x - v x)) ^ 2 ≤
      (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2) * (∫ x in (0:ℝ)..1, (w₁ x - w₂ x - v x) ^ 2) :=
    cauchy_schwarz_unit_interval (fun x => w₁ x - w₂ x) (fun x => w₁ x - w₂ x - v x)
      (cw₁.sub cw₂) ((cw₁.sub cw₂).sub cv)
  
  have hDV : (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2) ≤ 16 / 9 * ∫ x in (0:ℝ)..1, v x ^ 2 := by
    set D := ∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2 with hDdef
    set V := ∫ x in (0:ℝ)..1, v x ^ 2 with hVdef
    set X := ∫ x in (0:ℝ)..1, (w₁ x - w₂ x) * v x with hXdef
    set Y := ∫ x in (0:ℝ)..1, (w₁ x - w₂ x) * (w₁ x - w₂ x - v x) with hYdef
    set E := ∫ x in (0:ℝ)..1, (w₁ x - w₂ x - v x) ^ 2 with hEdef
    have hY2 : Y ^ 2 ≤ (D / 4) ^ 2 := by
      have := mul_le_mul_of_nonneg_left hE hD0
      nlinarith
    have hYle : Y ≤ D / 4 := (abs_le_of_sq_le_sq' hY2 (by linarith)).2
    have hX3 : 3 * D / 4 ≤ X := by linarith
    have hX2 : (3 * D / 4) ^ 2 ≤ X ^ 2 := pow_le_pow_left₀ (by linarith) hX3 2
    rcases hD0.eq_or_lt with h | h
    · rw [← h]; linarith
    · have h4 : D * (9 / 16 * D) ≤ D * V := by nlinarith
      have h5 := le_of_mul_le_mul_left h4 h
      linarith
  have hN0 : 0 ≤ ‖ιT q - ιT p‖ ^ 2 := by positivity
  linarith

theorem riccati_L2_lipschitz_minus_T : ∀ κ : ℝ, 1 ≤ κ → ∀ q p : CinfT, ∀ w₁ w₂ : ℝ → ℝ, Function.Periodic w₁ 1 → Function.Periodic w₂ 1 → (∀ x, HasDerivAt w₁ ((q : ℝ → ℝ) x - 2 * κ * w₁ x - w₁ x ^ 2) x) → (∀ x, HasDerivAt w₂ ((p : ℝ → ℝ) x - 2 * κ * w₂ x - w₂ x ^ 2) x) → (∫ x in (0:ℝ)..1, w₁ x ^ 2) ≤ κ / 64 → (∫ x in (0:ℝ)..1, w₂ x ^ 2) ≤ κ / 64 → (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2) ≤ 2 * ‖ιT q - ιT p‖ ^ 2 :=
by
  intro κ hκ q p w₁ w₂ hw₁P hw₂P hw₁D hw₂D hI₁ hI₂
  have hκ0 : (0:ℝ) < κ := by linarith
  have hκne : κ ≠ 0 := hκ0.ne'
  obtain ⟨hlin, -⟩ := toHm1T_basic
  
  have hcont : ∀ (f F : ℝ → ℝ), (∀ x, HasDerivAt f (F x) x) → Continuous f :=
    fun f F h => continuous_iff_continuousAt.2 fun x => (h x).continuousAt
  have hreflD : ∀ (f F : ℝ → ℝ), (∀ y, HasDerivAt f (F y) y) → ∀ x,
      HasDerivAt (fun y => -f (-y)) (F (-x)) x := by
    intro f F hf x
    have h1 := ((hf (-x)).comp x (hasDerivAt_neg x)).neg
    refine h1.congr_deriv ?_
    ring
  have hreflP : ∀ f : ℝ → ℝ, Function.Periodic f 1 →
      Function.Periodic (fun y => -f (-y)) 1 := by
    intro f hf x
    have h1 := hf (-(x + 1))
    rw [show -(x + 1) + 1 = -x by ring] at h1
    show -f (-(x + 1)) = -f (-x)
    rw [h1]
  have hR : ∀ g : ℝ → ℝ, Function.Periodic g 1 →
      (∫ x in (0:ℝ)..1, g (-x)) = ∫ x in (0:ℝ)..1, g x := by
    intro g hg
    rw [intervalIntegral.integral_comp_neg]
    have h1 := hg.intervalIntegral_add_eq (-1) 0
    norm_num at h1
    simpa using h1
  have hRsq : ∀ f : ℝ → ℝ, Function.Periodic f 1 →
      (∫ x in (0:ℝ)..1, (-f (-x)) ^ 2) = ∫ x in (0:ℝ)..1, f x ^ 2 := by
    intro f hf
    have h2 : (∫ x in (0:ℝ)..1, f (-x) ^ 2) = ∫ x in (0:ℝ)..1, f x ^ 2 :=
      hR (fun y => f y ^ 2) (fun x => by show f (x + 1) ^ 2 = f x ^ 2; rw [hf x])
    simp only [neg_sq]
    exact h2
  
  let rC : CinfT := ⟨fun x => (q : ℝ → ℝ) x - (p : ℝ → ℝ) x, q.2.1.sub p.2.1,
    fun x => by simp only [q.2.2 x, p.2.2 x]⟩
  have hRx : ∀ x, (rC : ℝ → ℝ) x = (q : ℝ → ℝ) x - (p : ℝ → ℝ) x := fun x => rfl
  have hRc : Continuous (rC : ℝ → ℝ) := rC.2.1.continuous
  have hRp : Function.Periodic (rC : ℝ → ℝ) 1 := rC.2.2
  have hdist : ιT rC = ιT q - ιT p := by
    apply Subtype.ext
    show toHm1T rC = toHm1T q - toHm1T p
    rw [hlin q p rC 1 (-1) (fun x => by
      show (q : ℝ → ℝ) x - (p : ℝ → ℝ) x = 1 * (q : ℝ → ℝ) x + -1 * (p : ℝ → ℝ) x
      ring), one_smul, neg_one_smul, ← sub_eq_add_neg]
  
  obtain ⟨vp, hvpP, hvpD⟩ := (periodic_resolvent_T κ hκ (rC : ℝ → ℝ) hRc hRp).1
  have hvp2 : (∫ x in (0:ℝ)..1, vp x ^ 2) ≤ ‖ιT q - ιT p‖ ^ 2 := by
    rw [periodic_resolvent_parseval_T κ hκ rC vp hvpP hvpD, ← hdist]
    have h := (weight_compare_T ((ιT rC : Hm1T) : lp (fun _ : ℤ => ℂ) 2) κ hκ).2.1
    rw [Submodule.coe_norm]
    exact h
  
  obtain ⟨Rr, hRr⟩ : ∃ Rr : ℝ → ℝ, Rr = fun x => (rC : ℝ → ℝ) (-x) := ⟨_, rfl⟩
  have hRrx : ∀ x, Rr x = (rC : ℝ → ℝ) (-x) := fun x => by rw [hRr]
  have hRrc : Continuous Rr := by rw [hRr]; exact hRc.comp continuous_neg
  have hRrp : Function.Periodic Rr 1 := by
    intro x
    rw [hRrx, hRrx]
    have h1 := hRp (-(x + 1))
    rw [show -(x + 1) + 1 = -x by ring] at h1
    exact h1.symm
  obtain ⟨vr, hvrP, hvrD⟩ := (periodic_resolvent_T κ hκ Rr hRrc hRrp).1
  obtain ⟨vm, hvm⟩ : ∃ vm : ℝ → ℝ, vm = fun y => -vr (-y) := ⟨_, rfl⟩
  have hvmP : Function.Periodic vm 1 := by rw [hvm]; exact hreflP vr hvrP
  have hvmD : ∀ x, HasDerivAt vm ((rC : ℝ → ℝ) x - 2 * κ * vm x) x := by
    intro x
    rw [hvm]
    refine (hreflD vr _ hvrD x).congr_deriv ?_
    simp only [hRrx, neg_neg]
    ring
  have hvpc := hcont vp _ hvpD
  have hvmc := hcont vm _ hvmD
  
  have hiso : (∫ x in (0:ℝ)..1, vm x ^ 2) = ∫ x in (0:ℝ)..1, vp x ^ 2 := by
    have hF : ∀ x ∈ Set.uIcc (0:ℝ) 1, HasDerivAt
        (fun y => -(1 / (4 * κ)) * ((vm y - vp y) * (vm y - vp y))) (vm x ^ 2 - vp x ^ 2) x := by
      intro x _
      have h1 := (((hvmD x).sub (hvpD x)).mul ((hvmD x).sub (hvpD x))).const_mul (-(1 / (4 * κ)))
      refine h1.congr_deriv ?_
      simp only [Pi.sub_apply]
      field_simp
      ring
    have hint : IntervalIntegrable (fun x => vm x ^ 2 - vp x ^ 2) MeasureTheory.volume 0 1 :=
      ((hvmc.pow 2).sub (hvpc.pow 2)).intervalIntegrable 0 1
    have h2 := intervalIntegral.integral_eq_sub_of_hasDerivAt hF hint
    rw [intervalIntegral.integral_sub ((hvmc.pow 2).intervalIntegrable 0 1)
      ((hvpc.pow 2).intervalIntegrable 0 1)] at h2
    have h3 : vm 1 = vm 0 := by simpa using hvmP 0
    have h4 : vp 1 = vp 0 := by simpa using hvpP 0
    rw [h3, h4, sub_self] at h2
    linarith
  have hV : (∫ x in (0:ℝ)..1, vm x ^ 2) ≤ ‖ιT q - ιT p‖ ^ 2 := by rw [hiso]; exact hvp2
  
  have hw₁c := hcont w₁ _ hw₁D
  have hw₂c := hcont w₂ _ hw₂D
  obtain ⟨y, hy⟩ : ∃ y : ℝ → ℝ, y = fun x => w₁ x - w₂ x - vm x := ⟨_, rfl⟩
  have hyx : ∀ x, y x = w₁ x - w₂ x - vm x := fun x => by rw [hy]
  obtain ⟨g, hg⟩ : ∃ g : ℝ → ℝ, g = fun x => -((w₁ x + w₂ x) * (w₁ x - w₂ x)) := ⟨_, rfl⟩
  have hgx : ∀ x, g x = -((w₁ x + w₂ x) * (w₁ x - w₂ x)) := fun x => by rw [hg]
  have hyc : Continuous y := by rw [hy]; exact (hw₁c.sub hw₂c).sub hvmc
  have hyP : Function.Periodic y 1 := fun x => by rw [hyx, hyx, hw₁P x, hw₂P x, hvmP x]
  have hyD : ∀ x, HasDerivAt y (g x - 2 * κ * y x) x := by
    intro x
    have h := ((hw₁D x).sub (hw₂D x)).sub (hvmD x)
    rw [hy]
    refine h.congr_deriv ?_
    simp only [hgx, hRx]
    ring
  have hgc : Continuous g := by rw [hg]; exact ((hw₁c.add hw₂c).mul (hw₁c.sub hw₂c)).neg
  have hgP : Function.Periodic g 1 := fun x => by rw [hgx, hgx, hw₁P x, hw₂P x]
  have hgrc : Continuous (fun x => g (-x)) := hgc.comp continuous_neg
  have hgrP : Function.Periodic (fun x => g (-x)) 1 := by
    intro x
    show g (-(x + 1)) = g (-x)
    have h1 := hgP (-(x + 1))
    rw [show -(x + 1) + 1 = -x by ring] at h1
    exact h1.symm
  have hyrD : ∀ x, HasDerivAt (fun z => -y (-z)) (2 * κ * -y (-x) + g (-x)) x := by
    intro x
    refine (hreflD y _ hyD x).congr_deriv ?_
    show g (-x) - 2 * κ * y (-x) = _
    ring
  have hYr := ((periodic_resolvent_T κ hκ (fun x => g (-x)) hgrc hgrP).2
    (fun z => -y (-z)) (hreflP y hyP) hyrD).2.2.2
  have e2 : (∫ x in (0:ℝ)..1, |g (-x)|) = ∫ x in (0:ℝ)..1, |g x| :=
    hR (fun z => |g z|) (fun x => by show |g (x + 1)| = |g x|; rw [hgP x])
  have hG : (∫ x in (0:ℝ)..1, |g x|) =
      ∫ x in (0:ℝ)..1, |(w₁ x + w₂ x) * (w₁ x - w₂ x)| := by
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    simp only [hgx, abs_neg]
  have hY : (∫ x in (0:ℝ)..1, y x ^ 2) ≤
      (∫ x in (0:ℝ)..1, |(w₁ x + w₂ x) * (w₁ x - w₂ x)|) ^ 2 / κ := by
    calc (∫ x in (0:ℝ)..1, y x ^ 2) = ∫ x in (0:ℝ)..1, (-y (-x)) ^ 2 := (hRsq y hyP).symm
      _ ≤ (∫ x in (0:ℝ)..1, |g (-x)|) ^ 2 / κ := hYr
      _ = (∫ x in (0:ℝ)..1, |(w₁ x + w₂ x) * (w₁ x - w₂ x)|) ^ 2 / κ := by rw [e2, hG]
  
  have hA : (∫ x in (0:ℝ)..1, (w₁ x + w₂ x) ^ 2) ≤ κ / 16 := by
    have hm := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) zero_le_one
      (f := fun x => (w₁ x + w₂ x) ^ 2) (g := fun x => 2 * w₁ x ^ 2 + 2 * w₂ x ^ 2)
      (((hw₁c.add hw₂c).pow 2).intervalIntegrable 0 1)
      (((continuous_const.mul (hw₁c.pow 2)).add (continuous_const.mul (hw₂c.pow 2))).intervalIntegrable 0 1)
      (fun x _ => by nlinarith [sq_nonneg (w₁ x - w₂ x)])
    rw [intervalIntegral.integral_add ((continuous_const.mul (hw₁c.pow 2)).intervalIntegrable 0 1)
      ((continuous_const.mul (hw₂c.pow 2)).intervalIntegrable 0 1),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul] at hm
    linarith
  
  have hCS : (∫ x in (0:ℝ)..1, |(w₁ x + w₂ x) * (w₁ x - w₂ x)|) ^ 2 ≤
      (∫ x in (0:ℝ)..1, (w₁ x + w₂ x) ^ 2) * (∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2) := by
    have h := cauchy_schwarz_unit_interval (fun x => |w₁ x + w₂ x|) (fun x => |w₁ x - w₂ x|)
      (hw₁c.add hw₂c).abs (hw₁c.sub hw₂c).abs
    have e3 : (∫ x in (0:ℝ)..1, |(w₁ x + w₂ x) * (w₁ x - w₂ x)|) =
        ∫ x in (0:ℝ)..1, |w₁ x + w₂ x| * |w₁ x - w₂ x| := by
      refine intervalIntegral.integral_congr (fun x _ => ?_)
      simp only [abs_mul]
    have e4 : (∫ x in (0:ℝ)..1, |w₁ x + w₂ x| ^ 2) = ∫ x in (0:ℝ)..1, (w₁ x + w₂ x) ^ 2 := by
      refine intervalIntegral.integral_congr (fun x _ => ?_)
      simp only [sq_abs]
    have e5 : (∫ x in (0:ℝ)..1, |w₁ x - w₂ x| ^ 2) = ∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2 := by
      refine intervalIntegral.integral_congr (fun x _ => ?_)
      simp only [sq_abs]
    calc (∫ x in (0:ℝ)..1, |(w₁ x + w₂ x) * (w₁ x - w₂ x)|) ^ 2
        = (∫ x in (0:ℝ)..1, |w₁ x + w₂ x| * |w₁ x - w₂ x|) ^ 2 := by rw [e3]
      _ ≤ (∫ x in (0:ℝ)..1, |w₁ x + w₂ x| ^ 2) * (∫ x in (0:ℝ)..1, |w₁ x - w₂ x| ^ 2) := h
      _ = _ := by rw [e4, e5]
  
  have hD := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) zero_le_one
    (f := fun x => (w₁ x - w₂ x) ^ 2) (g := fun x => 4 * y x ^ 2 + 4 / 3 * vm x ^ 2)
    (((hw₁c.sub hw₂c).pow 2).intervalIntegrable 0 1)
    (((continuous_const.mul (hyc.pow 2)).add (continuous_const.mul (hvmc.pow 2))).intervalIntegrable 0 1)
    (fun x _ => by
      simp only [hyx]
      nlinarith [sq_nonneg (3 * (w₁ x - w₂ x - vm x) - vm x)])
  rw [intervalIntegral.integral_add ((continuous_const.mul (hyc.pow 2)).intervalIntegrable 0 1)
    ((continuous_const.mul (hvmc.pow 2)).intervalIntegrable 0 1),
    intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul] at hD
  
  have hB0 : 0 ≤ ∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2 :=
    intervalIntegral.integral_nonneg zero_le_one (fun x _ => sq_nonneg _)
  set B := ∫ x in (0:ℝ)..1, (w₁ x - w₂ x) ^ 2 with hBdef
  set A := ∫ x in (0:ℝ)..1, (w₁ x + w₂ x) ^ 2 with hAdef
  set Gv := ∫ x in (0:ℝ)..1, |(w₁ x + w₂ x) * (w₁ x - w₂ x)| with hGvdef
  set Y := ∫ x in (0:ℝ)..1, y x ^ 2 with hYdef
  set V := ∫ x in (0:ℝ)..1, vm x ^ 2 with hVdef
  have hYk : Y * κ ≤ Gv ^ 2 := (le_div_iff₀ hκ0).1 hY
  have hAB : A * B ≤ κ / 16 * B := mul_le_mul_of_nonneg_right hA hB0
  have hκY : κ * Y ≤ κ * (B / 16) := by nlinarith
  have hYB : Y ≤ B / 16 := le_of_mul_le_mul_left hκY hκ0
  have hN : 0 ≤ ‖ιT q - ιT p‖ ^ 2 := by positivity
  nlinarith

theorem green_T_small_lipschitz : ∀ κ : ℝ, 1 ≤ κ → ∀ q p : CinfT, WT κ ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ≤ κ / 1024 → WT κ ((ιT p : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ≤ κ / 1024 → IsGreenT κ (q : ℝ → ℝ) (greenT κ (q : ℝ → ℝ)) ∧ (∫ x in (0:ℝ)..1, (greenT κ (q : ℝ → ℝ) x - greenT κ (p : ℝ → ℝ) x) ^ 2) ≤ 2 * ‖ιT q - ιT p‖ ^ 2 :=
by
  intro κ hκ q p hq hp
  obtain ⟨wp, wm, hwpP, hwmP, hwpD, hwmD, hwp2, hwm2, hwd⟩ := riccati_pair_T κ hκ q hq
  obtain ⟨up, um, hupP, humP, hupD, humD, hup2, hum2, hud⟩ := riccati_pair_T κ hκ p hp
  have hA : ∀ x, 3 / 2 ≤ 2 * κ + wm x - wp x := by
    intro x
    have h := (abs_le.1 (hwd x)).1
    linarith
  have hB : ∀ x, 3 / 2 ≤ 2 * κ + um x - up x := by
    intro x
    have h := (abs_le.1 (hud x)).1
    linarith
  obtain ⟨hGq, hgq⟩ := greenT_eq_of_riccati_pair_T κ q wp wm hwpP hwmP hwpD hwmD
    (fun x => by linarith [hA x])
  obtain ⟨hGp, hgp⟩ := greenT_eq_of_riccati_pair_T κ p up um hupP humP hupD humD
    (fun x => by linarith [hB x])
  refine ⟨hGq, ?_⟩
  have h3 := riccati_L2_lipschitz_plus_T κ hκ q p wp up hwpP hupP hwpD hupD hwp2 hup2
  have h4 := riccati_L2_lipschitz_minus_T κ hκ q p wm um hwmP humP hwmD humD hwm2 hum2
  have cwp : Continuous wp := continuous_iff_continuousAt.2 fun x => (hwpD x).continuousAt
  have cwm : Continuous wm := continuous_iff_continuousAt.2 fun x => (hwmD x).continuousAt
  have cup : Continuous up := continuous_iff_continuousAt.2 fun x => (hupD x).continuousAt
  have cum : Continuous um := continuous_iff_continuousAt.2 fun x => (humD x).continuousAt
  have hpt : ∀ x, (greenT κ (q : ℝ → ℝ) x - greenT κ (p : ℝ → ℝ) x) ^ 2 ≤
      32 / 81 * ((wp x - up x) ^ 2 + (wm x - um x) ^ 2) := by
    intro x
    rw [hgq x, hgp x]
    have ha := hA x
    have hb := hB x
    set a := 2 * κ + wm x - wp x with ha_def
    set b := 2 * κ + um x - up x with hb_def
    have ha0 : 0 < a := by linarith
    have hb0 : 0 < b := by linarith
    have hdiff : 1 / a - 1 / b = (b - a) / (a * b) := by
      field_simp
    have hab : 9 / 4 ≤ a * b := by nlinarith
    have hP : 81 / 16 ≤ (a * b) ^ 2 := by nlinarith
    have hX : (b - a) ^ 2 ≤ 2 * ((wp x - up x) ^ 2 + (wm x - um x) ^ 2) := by
      have e : b - a = (um x - wm x) - (up x - wp x) := by
        rw [ha_def, hb_def]; ring
      rw [e]
      nlinarith [sq_nonneg ((um x - wm x) + (up x - wp x))]
    have hY : 0 ≤ (wp x - up x) ^ 2 + (wm x - um x) ^ 2 := by positivity
    rw [hdiff, div_pow, div_le_iff₀ (by positivity)]
    nlinarith [mul_le_mul_of_nonneg_left hP hY]
  have hLint : IntervalIntegrable
      (fun x => (greenT κ (q : ℝ → ℝ) x - greenT κ (p : ℝ → ℝ) x) ^ 2) MeasureTheory.volume 0 1 :=
    ((hGq.1.continuous.sub hGp.1.continuous).pow 2).intervalIntegrable 0 1
  have i1 : IntervalIntegrable (fun x => (wp x - up x) ^ 2) MeasureTheory.volume 0 1 :=
    ((cwp.sub cup).pow 2).intervalIntegrable 0 1
  have i2 : IntervalIntegrable (fun x => (wm x - um x) ^ 2) MeasureTheory.volume 0 1 :=
    ((cwm.sub cum).pow 2).intervalIntegrable 0 1
  have hRint : IntervalIntegrable
      (fun x => 32 / 81 * ((wp x - up x) ^ 2 + (wm x - um x) ^ 2)) MeasureTheory.volume 0 1 :=
    (continuous_const.mul (((cwp.sub cup).pow 2).add ((cwm.sub cum).pow 2))).intervalIntegrable 0 1
  have hmono := intervalIntegral.integral_mono_on zero_le_one hLint hRint (fun x _ => hpt x)
  rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_add i1 i2] at hmono
  have hD : 0 ≤ ‖ιT q - ιT p‖ ^ 2 := by positivity
  nlinarith

theorem hm1T_transport_gronwall : ∀ (d e : ℝ → CinfT) (a L : ℝ), 0 ≤ L → ContDiff ℝ 2 (fun p : ℝ × ℝ => (d p.1 : ℝ → ℝ) p.2) → (∀ t x : ℝ, HasDerivAt (fun s : ℝ => (d s : ℝ → ℝ) x) (deriv (e t : ℝ → ℝ) x + a * deriv (d t : ℝ → ℝ) x) t) → (∀ t : ℝ, (∫ x in (0:ℝ)..1, (e t : ℝ → ℝ) x ^ 2) ≤ L ^ 2 * ‖ιT (d t)‖ ^ 2) → ∀ t : ℝ, ‖ιT (d t)‖ ≤ Real.exp (2 * L * |t|) * ‖ιT (d 0)‖ :=
by
  
  have transport_gronwall_scalar : ∀ (E E' : ℝ → ℝ) (K : ℝ), 0 ≤ K → (∀ t : ℝ, HasDerivAt E (E' t) t) → (∀ t : ℝ, |E' t| ≤ K * E t) → ∀ t : ℝ, E t ≤ Real.exp (K * |t|) * E 0 := by
    intro E E' K hK hE hb t
    rcases le_total 0 t with ht | ht
    · have hF : ∀ τ, HasDerivAt (fun τ => Real.exp (-(K * τ)) * E τ)
          (Real.exp (-(K * τ)) * (E' τ - K * E τ)) τ := by
        intro τ
        have h1 : HasDerivAt (fun τ => Real.exp (-(K * τ))) (Real.exp (-(K * τ)) * (-(K * 1))) τ :=
          ((hasDerivAt_id' τ).const_mul K).neg.exp
        exact (h1.mul (hE τ)).congr_deriv (by ring)
      have hanti : Antitone (fun τ => Real.exp (-(K * τ)) * E τ) := by
        apply antitone_of_deriv_nonpos
        · exact fun τ => (hF τ).differentiableAt
        · intro τ
          rw [(hF τ).deriv]
          apply mul_nonpos_of_nonneg_of_nonpos (Real.exp_pos _).le
          have h1 := le_abs_self (E' τ)
          have h2 := hb τ
          linarith
      have h := hanti ht
      simp only [mul_zero, neg_zero, Real.exp_zero, one_mul] at h
      rw [abs_of_nonneg ht]
      have hexp : Real.exp (K * t) * Real.exp (-(K * t)) = 1 := by
        rw [← Real.exp_add]; simp
      calc E t = Real.exp (K * t) * (Real.exp (-(K * t)) * E t) := by
            rw [← mul_assoc, hexp, one_mul]
        _ ≤ Real.exp (K * t) * E 0 := mul_le_mul_of_nonneg_left h (Real.exp_pos _).le
    · have hF : ∀ τ, HasDerivAt (fun τ => Real.exp (K * τ) * E τ)
          (Real.exp (K * τ) * (K * E τ + E' τ)) τ := by
        intro τ
        have h1 : HasDerivAt (fun τ => Real.exp (K * τ)) (Real.exp (K * τ) * (K * 1)) τ :=
          ((hasDerivAt_id' τ).const_mul K).exp
        exact (h1.mul (hE τ)).congr_deriv (by ring)
      have hmono : Monotone (fun τ => Real.exp (K * τ) * E τ) := by
        apply monotone_of_deriv_nonneg
        · exact fun τ => (hF τ).differentiableAt
        · intro τ
          rw [(hF τ).deriv]
          apply mul_nonneg (Real.exp_pos _).le
          have h1 := neg_abs_le (E' τ)
          have h2 := hb τ
          linarith
      have h := hmono ht
      simp only [mul_zero, Real.exp_zero, one_mul] at h
      rw [abs_of_nonpos ht]
      have hexp : Real.exp (K * -t) * Real.exp (K * t) = 1 := by
        rw [← Real.exp_add]; simp
      calc E t = Real.exp (K * -t) * (Real.exp (K * t) * E t) := by
            rw [← mul_assoc, hexp, one_mul]
        _ ≤ Real.exp (K * -t) * E 0 := mul_le_mul_of_nonneg_left h (Real.exp_pos _).le
  
  have resolvent_one_facts_T : ∀ (f R : ℝ → ℝ), Continuous f → Function.Periodic f 1 → (∀ x : ℝ, R x = -(1 - Real.exp (-2))⁻¹ * ∫ s in (0:ℝ)..1, Real.exp (-2 * s) * f (x + s)) → Function.Periodic R 1 ∧ (∀ x : ℝ, HasDerivAt R (2 * R x + f x) x) ∧ (∫ x in (0:ℝ)..1, R x ^ 2) ≤ (∫ x in (0:ℝ)..1, f x ^ 2) / 4 := by
    intro f R hf hper hR
    obtain ⟨⟨v, hvper, hvd⟩, huniq⟩ := periodic_resolvent_T 1 le_rfl f hf hper
    obtain ⟨hform, -, hL2v, -⟩ := huniq v hvper hvd
    have hvR : ∀ x, v x = R x := by
      intro x
      rw [hform x, hR x]
      have hsub : (∫ y in x..(x + 1), Real.exp (-(2 * 1) * (y - x)) * f y) =
          ∫ s in (0:ℝ)..1, Real.exp (-2 * s) * f (x + s) := by
        have h1 := intervalIntegral.integral_comp_add_left
          (fun y => Real.exp (-(2 * 1) * (y - x)) * f y) (a := (0:ℝ)) (b := 1) x
        simp only [add_zero] at h1
        rw [← h1]
        refine intervalIntegral.integral_congr (fun s _ => ?_)
        try simp only
        rw [show -(2 * (1:ℝ)) * (x + s - x) = -2 * s by ring]
      rw [hsub]
      norm_num
    have hvR' : v = R := funext hvR
    subst hvR'
    refine ⟨hvper, fun x => ?_, ?_⟩
    · have := hvd x
      rwa [mul_one] at this
    · calc (∫ x in (0:ℝ)..1, v x ^ 2) ≤ (∫ x in (0:ℝ)..1, f x ^ 2) / (4 * 1 ^ 2) := hL2v
        _ = (∫ x in (0:ℝ)..1, f x ^ 2) / 4 := by norm_num
  
  have hm1T_norm_sq_resolvent_one : ∀ (q : CinfT) (v : ℝ → ℝ), Function.Periodic v 1 → (∀ x : ℝ, HasDerivAt v (2 * v x + (q : ℝ → ℝ) x) x) → ‖ιT q‖ ^ 2 = ∫ x in (0:ℝ)..1, v x ^ 2 := by
    intro q v hper hd
    rw [periodic_resolvent_parseval_T 1 le_rfl q v hper (fun x => by rw [mul_one]; exact hd x)]
    have hw : ∀ n : ℤ, (4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * (1:ℝ) ^ 2) = 1 := by
      intro n
      rw [div_eq_one_iff_eq (by positivity)]
      ring
    simp only [hw, one_mul]
    have h := lp.norm_rpow_eq_tsum (p := 2) (by norm_num) ((ιT q : Hm1T) : lp (fun _ : ℤ => ℂ) 2)
    simp only [ENNReal.toReal_ofNat, Real.rpow_two] at h
    exact h
  
  have resolvent_one_deriv_ibp : ∀ (f : ℝ → ℝ), ContDiff ℝ 1 f → Function.Periodic f 1 → ∀ x : ℝ, -(1 - Real.exp (-2))⁻¹ * (∫ s in (0:ℝ)..1, Real.exp (-2 * s) * deriv f (x + s)) = f x + 2 * (-(1 - Real.exp (-2))⁻¹ * ∫ s in (0:ℝ)..1, Real.exp (-2 * s) * f (x + s)) := by
    intro f hf hper x
    have hfd : Differentiable ℝ f := hf.differentiable one_ne_zero
    have hfc : Continuous (deriv f) := hf.continuous_deriv le_rfl
    have hu : ∀ s ∈ Set.uIcc (0:ℝ) 1, HasDerivAt (fun s => Real.exp (-2 * s))
        (Real.exp (-2 * s) * (-2)) s := by
      intro s _
      exact (((hasDerivAt_id' s).const_mul (-2)).exp).congr_deriv (by ring)
    have hv : ∀ s ∈ Set.uIcc (0:ℝ) 1, HasDerivAt (fun s => f (x + s)) (deriv f (x + s)) s := by
      intro s _
      exact ((hfd (x + s)).hasDerivAt).comp_const_add x s
    have i1 : IntervalIntegrable (fun s => Real.exp (-2 * s) * (-2)) volume 0 1 :=
      ((Real.continuous_exp.comp (continuous_const.mul continuous_id)).mul
        continuous_const).intervalIntegrable _ _
    have i2 : IntervalIntegrable (fun s => deriv f (x + s)) volume 0 1 :=
      (hfc.comp (continuous_const.add continuous_id)).intervalIntegrable _ _
    have hint := intervalIntegral.integral_mul_deriv_eq_deriv_mul hu hv i1 i2
    have hI : (∫ s in (0:ℝ)..1, Real.exp (-2 * s) * (-2) * f (x + s)) =
        -2 * ∫ s in (0:ℝ)..1, Real.exp (-2 * s) * f (x + s) := by
      rw [← intervalIntegral.integral_const_mul]
      refine intervalIntegral.integral_congr (fun s _ => ?_)
      try simp only
      ring
    rw [hint, hI, hper x, add_zero, mul_zero, Real.exp_zero, mul_one]
    have hlt : Real.exp (-2) < 1 := by
      calc Real.exp (-2) < Real.exp 0 := Real.exp_lt_exp.2 (by norm_num)
        _ = 1 := Real.exp_zero
    have hc : 1 - Real.exp (-2) ≠ 0 := by linarith
    field_simp
    ring
  
  have time_partial_continuous_of_contDiff : ∀ (D G : ℝ → ℝ → ℝ), ContDiff ℝ 1 (fun p : ℝ × ℝ => D p.1 p.2) → (∀ t x : ℝ, HasDerivAt (fun s : ℝ => D s x) (G t x) t) → Continuous (fun p : ℝ × ℝ => G p.1 p.2) := by
    intro D G hP hDG
    have hdiff : Differentiable ℝ (fun p : ℝ × ℝ => D p.1 p.2) := hP.differentiable one_ne_zero
    have heq : (fun p : ℝ × ℝ => G p.1 p.2) =
        fun p => fderiv ℝ (fun p : ℝ × ℝ => D p.1 p.2) p ((1 : ℝ), (0 : ℝ)) := by
      funext p
      have hc : HasDerivAt (fun s : ℝ => ((s, p.2) : ℝ × ℝ)) (((1 : ℝ), (0 : ℝ)) : ℝ × ℝ) p.1 :=
        (hasDerivAt_id' p.1).prodMk (hasDerivAt_const p.1 p.2)
      have h2 := (hdiff (p.1, p.2)).hasFDerivAt.comp_hasDerivAt p.1 hc
      exact (hDG p.1 p.2).unique h2
    rw [heq]
    exact (hP.continuous_fderiv one_ne_zero).clm_apply continuous_const
  
  have resolvent_energy_hasDerivAt : ∀ (D G : ℝ → ℝ → ℝ), Continuous (fun p : ℝ × ℝ => D p.1 p.2) → Continuous (fun p : ℝ × ℝ => G p.1 p.2) → (∀ t x : ℝ, HasDerivAt (fun s : ℝ => D s x) (G t x) t) → ∀ t : ℝ, HasDerivAt (fun τ : ℝ => ∫ x in (0:ℝ)..1, (-(1 - Real.exp (-2))⁻¹ * ∫ s in (0:ℝ)..1, Real.exp (-2 * s) * D τ (x + s)) ^ 2) (∫ x in (0:ℝ)..1, 2 * (-(1 - Real.exp (-2))⁻¹ * ∫ s in (0:ℝ)..1, Real.exp (-2 * s) * D t (x + s)) * (-(1 - Real.exp (-2))⁻¹ * ∫ s in (0:ℝ)..1, Real.exp (-2 * s) * G t (x + s))) t := by
    intro D G hD hG hDG t
    have hgen : ∀ (H H' : ℝ → ℝ → ℝ), Continuous (fun p : ℝ × ℝ => H p.1 p.2) →
        Continuous (fun p : ℝ × ℝ => H' p.1 p.2) →
        (∀ τ s : ℝ, HasDerivAt (fun σ : ℝ => H σ s) (H' τ s) τ) → ∀ t₀ : ℝ,
        HasDerivAt (fun τ : ℝ => ∫ s in (0:ℝ)..1, H τ s) (∫ s in (0:ℝ)..1, H' t₀ s) t₀ := by
      intro H H' hH hH' hd t₀
      have hK : IsCompact (Metric.closedBall t₀ 1 ×ˢ Set.uIcc (0:ℝ) 1) :=
        (isCompact_closedBall t₀ 1).prod isCompact_uIcc
      obtain ⟨M, hM⟩ := hK.exists_bound_of_continuousOn hH'.continuousOn
      have hcs : ∀ τ, Continuous (H τ) :=
        fun τ => hH.comp (continuous_const.prodMk continuous_id)
      have hcs' : ∀ τ, Continuous (H' τ) :=
        fun τ => hH'.comp (continuous_const.prodMk continuous_id)
      have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
        (μ := volume) (a := 0) (b := 1) (F := H) (F' := H') (x₀ := t₀) (bound := fun _ => M)
        (Metric.ball_mem_nhds t₀ zero_lt_one)
        (Filter.Eventually.of_forall fun τ => (hcs τ).aestronglyMeasurable)
        ((hcs t₀).intervalIntegrable _ _)
        ((hcs' t₀).aestronglyMeasurable)
        (Filter.Eventually.of_forall fun s hs τ hτ =>
          hM (τ, s) ⟨Metric.ball_subset_closedBall hτ, Set.uIoc_subset_uIcc hs⟩)
        intervalIntegrable_const
        (Filter.Eventually.of_forall fun s _ τ _ => hd τ s)
      exact key.2
    obtain ⟨V, hV⟩ : ∃ V : ℝ → ℝ → ℝ, V = fun τ x => -(1 - Real.exp (-2))⁻¹ *
        ∫ s in (0:ℝ)..1, Real.exp (-2 * s) * D τ (x + s) := ⟨_, rfl⟩
    obtain ⟨W, hW⟩ : ∃ W : ℝ → ℝ → ℝ, W = fun τ x => -(1 - Real.exp (-2))⁻¹ *
        ∫ s in (0:ℝ)..1, Real.exp (-2 * s) * G τ (x + s) := ⟨_, rfl⟩
    have hexp : Continuous fun s : ℝ => Real.exp (-2 * s) :=
      Real.continuous_exp.comp (continuous_const.mul continuous_id)
    have hjoint : ∀ (P : ℝ → ℝ → ℝ), Continuous (fun p : ℝ × ℝ => P p.1 p.2) →
        Continuous (fun p : ℝ × ℝ => -(1 - Real.exp (-2))⁻¹ *
          ∫ s in (0:ℝ)..1, Real.exp (-2 * s) * P p.1 (p.2 + s)) := by
      intro P hP
      apply continuous_const.mul
      apply intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      have h1 : Continuous fun q : (ℝ × ℝ) × ℝ => P q.1.1 (q.1.2 + q.2) :=
        hP.comp ((continuous_fst.comp continuous_fst).prodMk
          ((continuous_snd.comp continuous_fst).add continuous_snd))
      exact (hexp.comp continuous_snd).mul h1
    have hVc : Continuous (fun p : ℝ × ℝ => V p.1 p.2) := by
      rw [hV]; exact hjoint D hD
    have hWc : Continuous (fun p : ℝ × ℝ => W p.1 p.2) := by
      rw [hW]; exact hjoint G hG
    have hVd : ∀ τ x : ℝ, HasDerivAt (fun σ : ℝ => V σ x) (W τ x) τ := by
      intro τ x
      have hc1 : ∀ (P : ℝ → ℝ → ℝ), Continuous (fun p : ℝ × ℝ => P p.1 p.2) →
          Continuous (fun p : ℝ × ℝ => Real.exp (-2 * p.2) * P p.1 (x + p.2)) := by
        intro P hP
        exact (hexp.comp continuous_snd).mul
          (hP.comp (continuous_fst.prodMk (continuous_const.add continuous_snd)))
      have h := hgen (fun σ s => Real.exp (-2 * s) * D σ (x + s))
        (fun σ s => Real.exp (-2 * s) * G σ (x + s)) (hc1 D hD) (hc1 G hG)
        (fun σ s => (hDG σ (x + s)).const_mul (Real.exp (-2 * s))) τ
      rw [hV, hW]
      exact h.const_mul (-(1 - Real.exp (-2))⁻¹)
    have h := hgen (fun σ x => V σ x ^ 2) (fun σ x => 2 * V σ x * W σ x) (hVc.pow 2)
      ((continuous_const.mul hVc).mul hWc)
      (fun σ x => ((hVd σ x).pow 2).congr_deriv (by ring)) t
    rw [hV, hW] at h
    exact h
  
  have resolvent_energy_rate_bound : ∀ (v f r g : ℝ → ℝ) (a L : ℝ), 0 ≤ L → Continuous v → Continuous f → Continuous r → Continuous g → Function.Periodic v 1 → (∀ x : ℝ, HasDerivAt v (2 * v x + g x) x) → (∫ x in (0:ℝ)..1, r x ^ 2) ≤ (∫ x in (0:ℝ)..1, f x ^ 2) / 4 → (∫ x in (0:ℝ)..1, f x ^ 2) ≤ L ^ 2 * ∫ x in (0:ℝ)..1, v x ^ 2 → |∫ x in (0:ℝ)..1, 2 * v x * (f x + 2 * r x + a * (2 * v x + g x))| ≤ 4 * L * ∫ x in (0:ℝ)..1, v x ^ 2 := by
    intro v f r g a L hL hv hf hr hg hper hvd hrf hfv
    have i1 : IntervalIntegrable (fun x => 2 * (v x * f x)) volume 0 1 :=
      (continuous_const.mul (hv.mul hf)).intervalIntegrable _ _
    have i2 : IntervalIntegrable (fun x => 4 * (v x * r x)) volume 0 1 :=
      (continuous_const.mul (hv.mul hr)).intervalIntegrable _ _
    have i3 : IntervalIntegrable (fun x => a * (2 * v x * (2 * v x + g x))) volume 0 1 :=
      (continuous_const.mul ((continuous_const.mul hv).mul
        ((continuous_const.mul hv).add hg))).intervalIntegrable _ _
    have hsplit : (∫ x in (0:ℝ)..1, 2 * v x * (f x + 2 * r x + a * (2 * v x + g x))) =
        2 * (∫ x in (0:ℝ)..1, v x * f x) + 4 * (∫ x in (0:ℝ)..1, v x * r x) +
          a * ∫ x in (0:ℝ)..1, 2 * v x * (2 * v x + g x) := by
      have e : ∀ x ∈ Set.uIcc (0:ℝ) 1, 2 * v x * (f x + 2 * r x + a * (2 * v x + g x)) =
          (2 * (v x * f x) + 4 * (v x * r x)) + a * (2 * v x * (2 * v x + g x)) := by
        intro x _; ring
      rw [intervalIntegral.integral_congr e, intervalIntegral.integral_add (i1.add i2) i3,
        intervalIntegral.integral_add i1 i2, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
    have hZ : (∫ x in (0:ℝ)..1, 2 * v x * (2 * v x + g x)) = 0 := by
      have hd : ∀ x ∈ Set.uIcc (0:ℝ) 1, HasDerivAt (fun y => v y * v y)
          (2 * v x * (2 * v x + g x)) x := by
        intro x _
        exact ((hvd x).mul (hvd x)).congr_deriv (by ring)
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hd
        (((continuous_const.mul hv).mul ((continuous_const.mul hv).add hg)).intervalIntegrable _ _)]
      have h1 := hper 0
      rw [zero_add] at h1
      rw [h1, sub_self]
    rw [hsplit, hZ, mul_zero, add_zero]
    set A := ∫ x in (0:ℝ)..1, v x ^ 2 with hA
    set B := ∫ x in (0:ℝ)..1, f x ^ 2 with hB
    set R := ∫ x in (0:ℝ)..1, r x ^ 2 with hR
    set X := ∫ x in (0:ℝ)..1, v x * f x with hX
    set Y := ∫ x in (0:ℝ)..1, v x * r x with hY
    have hA0 : 0 ≤ A := intervalIntegral.integral_nonneg (by norm_num) (fun x _ => sq_nonneg _)
    have hR0 : 0 ≤ R := intervalIntegral.integral_nonneg (by norm_num) (fun x _ => sq_nonneg _)
    have cX : X ^ 2 ≤ A * B := cauchy_schwarz_unit_interval v f hv hf
    have cY : Y ^ 2 ≤ A * R := cauchy_schwarz_unit_interval v r hv hr
    have hLA : 0 ≤ L * A := mul_nonneg hL hA0
    have hX2 : X ^ 2 ≤ (L * A) ^ 2 := by
      calc X ^ 2 ≤ A * B := cX
        _ ≤ A * (L ^ 2 * A) := mul_le_mul_of_nonneg_left hfv hA0
        _ = (L * A) ^ 2 := by ring
    have hY2 : Y ^ 2 ≤ (L * A / 2) ^ 2 := by
      calc Y ^ 2 ≤ A * R := cY
        _ ≤ A * (L ^ 2 * A / 4) := mul_le_mul_of_nonneg_left (by linarith) hA0
        _ = (L * A / 2) ^ 2 := by ring
    have hXa : |X| ≤ L * A := abs_le_of_sq_le_sq' hX2 hLA |> fun h => abs_le.2 h
    have hYa : |Y| ≤ L * A / 2 := abs_le_of_sq_le_sq' hY2 (by linarith) |> fun h => abs_le.2 h
    calc |2 * X + 4 * Y| ≤ |2 * X| + |4 * Y| := abs_add_le _ _
      _ = 2 * |X| + 4 * |Y| := by rw [abs_mul, abs_mul]; norm_num
      _ ≤ 4 * L * A := by linarith
  intro d e a L hL hd2 hderiv hL2 t
  
  have hk1 : ∀ q : CinfT, ContDiff ℝ 1 (q : ℝ → ℝ) :=
    fun q => q.2.1.of_le (WithTop.coe_le_coe.2 le_top)
  have hkc : ∀ q : CinfT, Continuous (q : ℝ → ℝ) := fun q => q.2.1.continuous
  have hkp : ∀ q : CinfT, Function.Periodic (q : ℝ → ℝ) 1 := fun q => q.2.2
  have hkd : ∀ q : CinfT, Continuous (deriv (q : ℝ → ℝ)) :=
    fun q => (hk1 q).continuous_deriv le_rfl
  have hD1 : ContDiff ℝ 1 (fun p : ℝ × ℝ => (d p.1 : ℝ → ℝ) p.2) := hd2.of_le (by norm_num)
  
  have hGc : Continuous (fun p : ℝ × ℝ =>
      (fun τ y => deriv (e τ : ℝ → ℝ) y + a * deriv (d τ : ℝ → ℝ) y) p.1 p.2) :=
    time_partial_continuous_of_contDiff (fun τ y => (d τ : ℝ → ℝ) y)
      (fun τ y => deriv (e τ : ℝ → ℝ) y + a * deriv (d τ : ℝ → ℝ) y) hD1 hderiv
  
  have hE := resolvent_energy_hasDerivAt (fun τ y => (d τ : ℝ → ℝ) y)
      (fun τ y => deriv (e τ : ℝ → ℝ) y + a * deriv (d τ : ℝ → ℝ) y) hd2.continuous hGc hderiv
  obtain ⟨V, hV⟩ : ∃ V : ℝ → ℝ → ℝ, V = fun τ x => -(1 - Real.exp (-2))⁻¹ *
      ∫ s in (0:ℝ)..1, Real.exp (-2 * s) * (d τ : ℝ → ℝ) (x + s) := ⟨_, rfl⟩
  obtain ⟨W, hW⟩ : ∃ W : ℝ → ℝ → ℝ, W = fun τ x => -(1 - Real.exp (-2))⁻¹ *
      ∫ s in (0:ℝ)..1, Real.exp (-2 * s) *
        (deriv (e τ : ℝ → ℝ) (x + s) + a * deriv (d τ : ℝ → ℝ) (x + s)) := ⟨_, rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : ℝ → ℝ → ℝ, Q = fun τ x => -(1 - Real.exp (-2))⁻¹ *
      ∫ s in (0:ℝ)..1, Real.exp (-2 * s) * (e τ : ℝ → ℝ) (x + s) := ⟨_, rfl⟩
  have hE' : ∀ τ, HasDerivAt (fun σ => ∫ x in (0:ℝ)..1, V σ x ^ 2)
      (∫ x in (0:ℝ)..1, 2 * V τ x * W τ x) τ := by
    intro τ
    rw [hV, hW]
    exact hE τ
  
  have hVf : ∀ τ, Function.Periodic (V τ) 1 ∧
      (∀ x, HasDerivAt (V τ) (2 * V τ x + (d τ : ℝ → ℝ) x) x) ∧
      (∫ x in (0:ℝ)..1, V τ x ^ 2) ≤ (∫ x in (0:ℝ)..1, (d τ : ℝ → ℝ) x ^ 2) / 4 :=
    fun τ => resolvent_one_facts_T (d τ) (V τ) (hkc _) (hkp _) (fun x => by rw [hV])
  have hQf : ∀ τ, Function.Periodic (Q τ) 1 ∧
      (∀ x, HasDerivAt (Q τ) (2 * Q τ x + (e τ : ℝ → ℝ) x) x) ∧
      (∫ x in (0:ℝ)..1, Q τ x ^ 2) ≤ (∫ x in (0:ℝ)..1, (e τ : ℝ → ℝ) x ^ 2) / 4 :=
    fun τ => resolvent_one_facts_T (e τ) (Q τ) (hkc _) (hkp _) (fun x => by rw [hQ])
  have hnorm : ∀ τ, ‖ιT (d τ)‖ ^ 2 = ∫ x in (0:ℝ)..1, V τ x ^ 2 :=
    fun τ => hm1T_norm_sq_resolvent_one (d τ) (V τ) (hVf τ).1 (hVf τ).2.1
  
  have hWid : ∀ τ x, W τ x = (e τ : ℝ → ℝ) x + 2 * Q τ x +
      a * (2 * V τ x + (d τ : ℝ → ℝ) x) := by
    intro τ x
    have i1 := resolvent_one_deriv_ibp (e τ) (hk1 _) (hkp _) x
    have i2 := resolvent_one_deriv_ibp (d τ) (hk1 _) (hkp _) x
    have c1 : Continuous fun s : ℝ => Real.exp (-2 * s) * deriv (e τ : ℝ → ℝ) (x + s) :=
      (Real.continuous_exp.comp (continuous_const.mul continuous_id)).mul
        ((hkd _).comp (continuous_const.add continuous_id))
    have c2 : Continuous fun s : ℝ => Real.exp (-2 * s) * deriv (d τ : ℝ → ℝ) (x + s) :=
      (Real.continuous_exp.comp (continuous_const.mul continuous_id)).mul
        ((hkd _).comp (continuous_const.add continuous_id))
    have hsplit : (∫ s in (0:ℝ)..1, Real.exp (-2 * s) *
        (deriv (e τ : ℝ → ℝ) (x + s) + a * deriv (d τ : ℝ → ℝ) (x + s))) =
        (∫ s in (0:ℝ)..1, Real.exp (-2 * s) * deriv (e τ : ℝ → ℝ) (x + s)) +
          a * ∫ s in (0:ℝ)..1, Real.exp (-2 * s) * deriv (d τ : ℝ → ℝ) (x + s) := by
      rw [← intervalIntegral.integral_const_mul,
        ← intervalIntegral.integral_add (c1.intervalIntegrable _ _)
          ((c2.intervalIntegrable _ _).const_mul a)]
      refine intervalIntegral.integral_congr (fun s _ => ?_)
      try simp only
      ring
    rw [hW, hQ, hV]
    try simp only
    rw [hsplit]
    linear_combination i1 + a * i2
  have hEder : ∀ τ, HasDerivAt (fun σ => ‖ιT (d σ)‖ ^ 2)
      (∫ x in (0:ℝ)..1, 2 * V τ x * W τ x) τ := by
    intro τ
    have hfun : (fun σ => ‖ιT (d σ)‖ ^ 2) = fun σ => ∫ x in (0:ℝ)..1, V σ x ^ 2 :=
      funext hnorm
    rw [hfun]
    exact hE' τ
  
  have hrate : ∀ τ, |∫ x in (0:ℝ)..1, 2 * V τ x * W τ x| ≤ 4 * L * ‖ιT (d τ)‖ ^ 2 := by
    intro τ
    have hVc : Continuous (V τ) :=
      continuous_iff_continuousAt.2 fun x => ((hVf τ).2.1 x).continuousAt
    have hQc : Continuous (Q τ) :=
      continuous_iff_continuousAt.2 fun x => ((hQf τ).2.1 x).continuousAt
    have hint : (∫ x in (0:ℝ)..1, 2 * V τ x * W τ x) = ∫ x in (0:ℝ)..1, 2 * V τ x *
        ((e τ : ℝ → ℝ) x + 2 * Q τ x + a * (2 * V τ x + (d τ : ℝ → ℝ) x)) := by
      refine intervalIntegral.integral_congr (fun x _ => ?_)
      simp only [hWid]
    have hfe : (∫ x in (0:ℝ)..1, (e τ : ℝ → ℝ) x ^ 2) ≤ L ^ 2 * ∫ x in (0:ℝ)..1, V τ x ^ 2 := by
      rw [← hnorm τ]
      exact hL2 τ
    rw [hint, hnorm τ]
    exact resolvent_energy_rate_bound (V τ) (e τ) (Q τ) (d τ) a L hL hVc (hkc _) hQc (hkc _)
      (hVf τ).1 (hVf τ).2.1 (hQf τ).2.2 hfe
  
  have hgr := transport_gronwall_scalar (fun σ => ‖ιT (d σ)‖ ^ 2)
    (fun τ => ∫ x in (0:ℝ)..1, 2 * V τ x * W τ x) (4 * L) (by linarith) hEder hrate t
  beta_reduce at hgr
  
  have hexp : Real.exp (4 * L * |t|) = Real.exp (2 * L * |t|) ^ 2 := by
    rw [sq, ← Real.exp_add]
    ring_nf
  rw [hexp, ← mul_pow] at hgr
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).1 hgr

theorem hk_solution_T_lipschitz : ∀ R ≥ (0 : ℝ), ∃ κ₀ ≥ (1 : ℝ), ∀ κ ≥ κ₀, ∃ Λ ≥ (0 : ℝ),
    ∀ c₁ c₂ : ℝ → CinfT, IsHkSolutionT κ c₁ → IsHkSolutionT κ c₂ → ‖ιT (c₁ 0)‖ ≤ R →
      ‖ιT (c₂ 0)‖ ≤ R → ∀ t : ℝ,
        dist (ιT (c₁ t)) (ιT (c₂ t)) ≤ Real.exp (Λ * |t|) * dist (ιT (c₁ 0)) (ιT (c₂ 0)) :=
by
  classical
  intro R hR
  obtain ⟨C, hC, κ₁, hκ₁, hctl⟩ := hk_solution_T_control R hR
  obtain ⟨hlin, -⟩ := toHm1T_basic
  refine ⟨max κ₁ (1024 * C * R ^ 2), le_trans hκ₁ (le_max_left _ _), ?_⟩
  intro κ hκ
  have hκ1 : κ₁ ≤ κ := le_trans (le_max_left _ _) hκ
  have hκR : 1024 * C * R ^ 2 ≤ κ := le_trans (le_max_right _ _) hκ
  have hk1 : 1 ≤ κ := le_trans hκ₁ hκ1
  have hk0 : 0 ≤ κ := by linarith
  refine ⟨2 * (23 * κ ^ 5), by positivity, ?_⟩
  intro c₁ c₂ h₁ h₂ hR₁ hR₂ t
  
  have hreg : ∀ c : ℝ → CinfT, IsHkSolutionT κ c → ‖ιT (c 0)‖ ≤ R → ∀ s : ℝ,
      WT κ ((ιT (c s) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ≤ κ / 1024 := by
    intro c hc hc0 s
    have h1 := (hctl κ hκ1 c hc hc0 s).2 κ hκ1
    have h2 := (weight_compare_T ((ιT (c 0) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) κ hk1).2.1
    have h3 : ‖((ιT (c 0) : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ^ 2 ≤ R ^ 2 := by
      rw [← Submodule.coe_norm]
      exact pow_le_pow_left₀ (norm_nonneg _) hc0 2
    have h4 : WT κ ((ιT (c 0) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) ≤ R ^ 2 := le_trans h2 h3
    have hC0 : (0 : ℝ) ≤ C := by linarith
    calc WT κ ((ιT (c s) : Hm1T) : lp (fun _ : ℤ => ℂ) 2)
        ≤ C * WT κ ((ιT (c 0) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) := h1
      _ ≤ C * R ^ 2 := mul_le_mul_of_nonneg_left h4 hC0
      _ ≤ κ / 1024 := by linarith
  
  have hG : ∀ s : ℝ, IsGreenT κ (c₁ s : ℝ → ℝ) (greenT κ (c₁ s : ℝ → ℝ)) ∧
      IsGreenT κ (c₂ s : ℝ → ℝ) (greenT κ (c₂ s : ℝ → ℝ)) ∧
      (∫ x in (0:ℝ)..1, (greenT κ (c₁ s : ℝ → ℝ) x - greenT κ (c₂ s : ℝ → ℝ) x) ^ 2) ≤
        2 * ‖ιT (c₁ s) - ιT (c₂ s)‖ ^ 2 := by
    intro s
    have A := green_T_small_lipschitz κ hk1 (c₁ s) (c₂ s) (hreg c₁ h₁ hR₁ s) (hreg c₂ h₂ hR₂ s)
    have B := green_T_small_lipschitz κ hk1 (c₂ s) (c₁ s) (hreg c₂ h₂ hR₂ s) (hreg c₁ h₁ hR₁ s)
    exact ⟨A.1, B.1, A.2⟩
  
  let d : ℝ → CinfT := fun s => ⟨fun x => (c₁ s : ℝ → ℝ) x - (c₂ s : ℝ → ℝ) x,
    (c₁ s).2.1.sub (c₂ s).2.1, fun x => by simp only [(c₁ s).2.2 x, (c₂ s).2.2 x]⟩
  let e : ℝ → CinfT := fun s => ⟨fun x => 16 * κ ^ 5 *
      (greenT κ (c₁ s : ℝ → ℝ) x - greenT κ (c₂ s : ℝ → ℝ) x),
    contDiff_const.mul ((hG s).1.1.sub (hG s).2.1.1),
    fun x => by simp only [(hG s).1.2.1 x, (hG s).2.1.2.1 x]⟩
  
  have hderiv : ∀ s x : ℝ, HasDerivAt (fun σ : ℝ => (d σ : ℝ → ℝ) x)
      (deriv (e s : ℝ → ℝ) x + 4 * κ ^ 2 * deriv (d s : ℝ → ℝ) x) s := by
    intro s x
    have H := (h₁.2 s x).sub (h₂.2 s x)
    have hg1 : DifferentiableAt ℝ (greenT κ (c₁ s : ℝ → ℝ)) x :=
      ((hG s).1.1.differentiable (by simp)).differentiableAt
    have hg2 : DifferentiableAt ℝ (greenT κ (c₂ s : ℝ → ℝ)) x :=
      ((hG s).2.1.1.differentiable (by simp)).differentiableAt
    have hc1 : DifferentiableAt ℝ (c₁ s : ℝ → ℝ) x :=
      ((c₁ s).2.1.differentiable (by simp)).differentiableAt
    have hc2 : DifferentiableAt ℝ (c₂ s : ℝ → ℝ) x :=
      ((c₂ s).2.1.differentiable (by simp)).differentiableAt
    have he : deriv (e s : ℝ → ℝ) x = 16 * κ ^ 5 *
        (deriv (greenT κ (c₁ s : ℝ → ℝ)) x - deriv (greenT κ (c₂ s : ℝ → ℝ)) x) := by
      show deriv (fun y => 16 * κ ^ 5 *
        (greenT κ (c₁ s : ℝ → ℝ) y - greenT κ (c₂ s : ℝ → ℝ) y)) x = _
      exact ((hg1.hasDerivAt.sub hg2.hasDerivAt).const_mul (16 * κ ^ 5)).deriv
    have hdd : deriv (d s : ℝ → ℝ) x = deriv (c₁ s : ℝ → ℝ) x - deriv (c₂ s : ℝ → ℝ) x := by
      show deriv (fun y => (c₁ s : ℝ → ℝ) y - (c₂ s : ℝ → ℝ) y) x = _
      exact deriv_sub hc1 hc2
    have Heq : hkRHST κ (c₁ s : ℝ → ℝ) x - hkRHST κ (c₂ s : ℝ → ℝ) x =
        deriv (e s : ℝ → ℝ) x + 4 * κ ^ 2 * deriv (d s : ℝ → ℝ) x := by
      rw [he, hdd]
      unfold hkRHST
      ring
    exact H.congr_deriv Heq
  
  have hdist : ∀ s : ℝ, ιT (d s) = ιT (c₁ s) - ιT (c₂ s) := by
    intro s
    apply Subtype.ext
    show toHm1T (d s) = toHm1T (c₁ s) - toHm1T (c₂ s)
    rw [hlin (c₁ s) (c₂ s) (d s) 1 (-1) (fun x => by
      show (c₁ s : ℝ → ℝ) x - (c₂ s : ℝ → ℝ) x =
        1 * (c₁ s : ℝ → ℝ) x + -1 * (c₂ s : ℝ → ℝ) x
      ring), one_smul, neg_one_smul, ← sub_eq_add_neg]
  have hL2 : ∀ s : ℝ, (∫ x in (0:ℝ)..1, (e s : ℝ → ℝ) x ^ 2) ≤
      (23 * κ ^ 5) ^ 2 * ‖ιT (d s)‖ ^ 2 := by
    intro s
    have h1 : (∫ x in (0:ℝ)..1, (e s : ℝ → ℝ) x ^ 2) = (16 * κ ^ 5) ^ 2 *
        ∫ x in (0:ℝ)..1, (greenT κ (c₁ s : ℝ → ℝ) x - greenT κ (c₂ s : ℝ → ℝ) x) ^ 2 := by
      rw [← intervalIntegral.integral_const_mul]
      refine intervalIntegral.integral_congr (fun x _ => ?_)
      show (16 * κ ^ 5 * (greenT κ (c₁ s : ℝ → ℝ) x - greenT κ (c₂ s : ℝ → ℝ) x)) ^ 2 =
        (16 * κ ^ 5) ^ 2 * (greenT κ (c₁ s : ℝ → ℝ) x - greenT κ (c₂ s : ℝ → ℝ) x) ^ 2
      ring
    rw [h1, hdist s]
    have h2 := (hG s).2.2
    have hI : 0 ≤ ‖ιT (c₁ s) - ιT (c₂ s)‖ ^ 2 := by positivity
    have hk10 : 0 ≤ (κ ^ 5) ^ 2 := by positivity
    have hprod := mul_nonneg hk10 hI
    calc (16 * κ ^ 5) ^ 2 *
          ∫ x in (0:ℝ)..1, (greenT κ (c₁ s : ℝ → ℝ) x - greenT κ (c₂ s : ℝ → ℝ) x) ^ 2
        ≤ (16 * κ ^ 5) ^ 2 * (2 * ‖ιT (c₁ s) - ιT (c₂ s)‖ ^ 2) :=
          mul_le_mul_of_nonneg_left h2 (by positivity)
      _ ≤ (23 * κ ^ 5) ^ 2 * ‖ιT (c₁ s) - ιT (c₂ s)‖ ^ 2 := by nlinarith
  
  have hd2 : ContDiff ℝ 2 (fun p : ℝ × ℝ => (d p.1 : ℝ → ℝ) p.2) :=
    (h₁.1.sub h₂.1).of_le (WithTop.coe_le_coe.2 le_top)
  
  have key := hm1T_transport_gronwall d e (4 * κ ^ 2) (23 * κ ^ 5) (by positivity) hd2
    hderiv hL2 t
  rw [dist_eq_norm, dist_eq_norm, ← hdist t, ← hdist 0]
  exact key

theorem riccati_variation_bound_plus_T : ∀ κ : ℝ, 1 ≤ κ → ∀ q p E : CinfT, ∀ (h : ℝ) (w u Z : ℝ → ℝ), Function.Periodic w 1 → Function.Periodic u 1 → Function.Periodic Z 1 → (∀ x, HasDerivAt w ((q : ℝ → ℝ) x + 2 * κ * w x - w x ^ 2) x) → (∀ x, HasDerivAt u ((p : ℝ → ℝ) x + 2 * κ * u x - u x ^ 2) x) → (∀ x, HasDerivAt Z ((2 * κ - 2 * w x) * Z x + kdvRHS (q : ℝ → ℝ) x) x) → (∫ x in (0:ℝ)..1, w x ^ 2) ≤ κ / 64 → (∫ x in (0:ℝ)..1, u x ^ 2) ≤ κ / 64 → (∀ x : ℝ, (E : ℝ → ℝ) x = (p : ℝ → ℝ) x - (q : ℝ → ℝ) x - h * kdvRHS (q : ℝ → ℝ) x) → (∫ x in (0:ℝ)..1, (u x - w x - h * Z x) ^ 2) ≤ 3 * ‖ιT E‖ ^ 2 + 24 * (‖ιT p - ιT q‖ ^ 2) ^ 2 / κ :=
by
  intro κ hκ q p E h w u Z hwP huP hZP hw hu hZ hw2 hu2 hE
  have hκ0 : 0 < κ := by linarith
  have cw : Continuous w := continuous_iff_continuousAt.2 fun x => (hw x).continuousAt
  have cu : Continuous u := continuous_iff_continuousAt.2 fun x => (hu x).continuousAt
  
  obtain ⟨⟨v, hvP, hvD⟩, -⟩ := periodic_resolvent_T κ hκ (E : ℝ → ℝ) E.2.1.continuous E.2.2
  have cv : Continuous v := continuous_iff_continuousAt.2 fun x => (hvD x).continuousAt
  have hV : (∫ x in (0:ℝ)..1, v x ^ 2) ≤ ‖ιT E‖ ^ 2 := by
    rw [periodic_resolvent_parseval_T κ hκ E v hvP hvD]
    exact (weight_compare_T ((ιT E : Hm1T) : lp (fun _ : ℤ => ℂ) 2) κ hκ).2.1
  
  have core : ∀ (y F : ℝ → ℝ), Function.Periodic y 1 → Function.Periodic F 1 → Continuous F →
      (∀ x, HasDerivAt y (2 * κ * y x - 2 * w x * y x + ((E : ℝ → ℝ) x + F x)) x) →
      (∫ x in (0:ℝ)..1, y x ^ 2) ≤
        8 / 3 * ‖ιT E‖ ^ 2 + 16 / 3 * (∫ x in (0:ℝ)..1, |F x|) ^ 2 / κ := by
    intro y F hyP hFP cF hy
    have cy : Continuous y := continuous_iff_continuousAt.2 fun x => (hy x).continuousAt
    have cG : Continuous (fun x => -(2 * w x * y x) + F x) :=
      ((continuous_const.mul cw).mul cy).neg.add cF
    have hGP : Function.Periodic (fun x => -(2 * w x * y x) + F x) 1 :=
      fun x => by simp only [hwP x, hyP x, hFP x]
    have hzP : Function.Periodic (fun x => y x - v x) 1 :=
      fun x => by simp only [hyP x, hvP x]
    have hz : ∀ x, HasDerivAt (fun x => y x - v x)
        (2 * κ * (y x - v x) + (fun x => -(2 * w x * y x) + F x) x) x := by
      intro x
      refine ((hy x).sub (hvD x)).congr_deriv ?_
      ring
    have hZi : (∫ x in (0:ℝ)..1, (y x - v x) ^ 2) ≤
        (∫ x in (0:ℝ)..1, |-(2 * w x * y x) + F x|) ^ 2 / κ :=
      ((periodic_resolvent_T κ hκ _ cG hGP).2 _ hzP hz).2.2.2
    
    have hBle : (∫ x in (0:ℝ)..1, |-(2 * w x * y x) + F x|) ≤
        2 * (∫ x in (0:ℝ)..1, |w x| * |y x|) + ∫ x in (0:ℝ)..1, |F x| := by
      have i1 : IntervalIntegrable (fun x => 2 * (|w x| * |y x|)) MeasureTheory.volume 0 1 :=
        (continuous_const.mul (cw.abs.mul cy.abs)).intervalIntegrable 0 1
      have i2 : IntervalIntegrable (fun x => |F x|) MeasureTheory.volume 0 1 :=
        cF.abs.intervalIntegrable 0 1
      have hmono : (∫ x in (0:ℝ)..1, |-(2 * w x * y x) + F x|) ≤
          ∫ x in (0:ℝ)..1, (2 * (|w x| * |y x|) + |F x|) := by
        refine intervalIntegral.integral_mono_on zero_le_one (cG.abs.intervalIntegrable 0 1)
          (i1.add i2) (fun x _ => ?_)
        have h1 := abs_add_le (-(2 * w x * y x)) (F x)
        have h2 : |-(2 * w x * y x)| = 2 * (|w x| * |y x|) := by
          rw [abs_neg, abs_mul, abs_mul, abs_two, mul_assoc]
        linarith
      rw [intervalIntegral.integral_add i1 i2, intervalIntegral.integral_const_mul] at hmono
      exact hmono
    have hP0 : 0 ≤ ∫ x in (0:ℝ)..1, |w x| * |y x| :=
      intervalIntegral.integral_nonneg zero_le_one
        (fun x _ => mul_nonneg (abs_nonneg _) (abs_nonneg _))
    have hQ0 : 0 ≤ ∫ x in (0:ℝ)..1, |F x| :=
      intervalIntegral.integral_nonneg zero_le_one (fun x _ => abs_nonneg _)
    have hB0 : 0 ≤ ∫ x in (0:ℝ)..1, |-(2 * w x * y x) + F x| :=
      intervalIntegral.integral_nonneg zero_le_one (fun x _ => abs_nonneg _)
    have hY0 : 0 ≤ ∫ x in (0:ℝ)..1, y x ^ 2 :=
      intervalIntegral.integral_nonneg zero_le_one (fun x _ => sq_nonneg _)
    
    have hCS : (∫ x in (0:ℝ)..1, |w x| * |y x|) ^ 2 ≤
        (∫ x in (0:ℝ)..1, w x ^ 2) * (∫ x in (0:ℝ)..1, y x ^ 2) := by
      have := cauchy_schwarz_unit_interval (fun x => |w x|) (fun x => |y x|) cw.abs cy.abs
      simpa only [sq_abs] using this
    have hP2 : (∫ x in (0:ℝ)..1, |w x| * |y x|) ^ 2 ≤ κ / 64 * (∫ x in (0:ℝ)..1, y x ^ 2) :=
      le_trans hCS (mul_le_mul_of_nonneg_right hw2 hY0)
    
    have hYsplit : (∫ x in (0:ℝ)..1, y x ^ 2) ≤
        2 * (∫ x in (0:ℝ)..1, v x ^ 2) + 2 * (∫ x in (0:ℝ)..1, (y x - v x) ^ 2) := by
      have i1 : IntervalIntegrable (fun x => 2 * v x ^ 2) MeasureTheory.volume 0 1 :=
        (continuous_const.mul (cv.pow 2)).intervalIntegrable 0 1
      have i2 : IntervalIntegrable (fun x => 2 * (y x - v x) ^ 2) MeasureTheory.volume 0 1 :=
        (continuous_const.mul ((cy.sub cv).pow 2)).intervalIntegrable 0 1
      have hmono : (∫ x in (0:ℝ)..1, y x ^ 2) ≤
          ∫ x in (0:ℝ)..1, (2 * v x ^ 2 + 2 * (y x - v x) ^ 2) :=
        intervalIntegral.integral_mono_on zero_le_one ((cy.pow 2).intervalIntegrable 0 1)
          (i1.add i2) (fun x _ => by nlinarith [sq_nonneg (2 * v x - y x)])
      rw [intervalIntegral.integral_add i1 i2, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul] at hmono
      exact hmono
    
    set Y := ∫ x in (0:ℝ)..1, y x ^ 2 with hYdef
    set V := ∫ x in (0:ℝ)..1, v x ^ 2 with hVdef
    set Zi := ∫ x in (0:ℝ)..1, (y x - v x) ^ 2 with hZidef
    set P := ∫ x in (0:ℝ)..1, |w x| * |y x| with hPdef
    set Q := ∫ x in (0:ℝ)..1, |F x| with hQdef
    set B := ∫ x in (0:ℝ)..1, |-(2 * w x * y x) + F x| with hBdef
    set a := ‖ιT E‖ with hadef
    rw [le_div_iff₀ hκ0] at hZi
    have hB2 : B ^ 2 ≤ (2 * P + Q) ^ 2 := pow_le_pow_left₀ hB0 hBle 2
    have hB3 : B ^ 2 ≤ κ / 8 * Y + 2 * Q ^ 2 := by
      nlinarith [sq_nonneg (2 * P - Q)]
    have hκY : κ * Y ≤ 2 * κ * a ^ 2 + κ / 4 * Y + 4 * Q ^ 2 := by
      have e1 : κ * Y ≤ κ * (2 * V + 2 * Zi) := mul_le_mul_of_nonneg_left hYsplit hκ0.le
      have e2 : κ * V ≤ κ * a ^ 2 := mul_le_mul_of_nonneg_left hV hκ0.le
      nlinarith
    have hfin : Y - 8 / 3 * a ^ 2 ≤ 16 / 3 * Q ^ 2 / κ := by
      rw [le_div_iff₀ hκ0]
      nlinarith
    linarith
  
  have hyD : ∀ x, HasDerivAt (fun x => u x - w x - h * Z x)
      (2 * κ * (u x - w x - h * Z x) - 2 * w x * (u x - w x - h * Z x) +
        ((E : ℝ → ℝ) x + (fun x => -(u x - w x) ^ 2) x)) x := by
    intro x
    refine (((hu x).sub (hw x)).sub ((hZ x).const_mul h)).congr_deriv ?_
    rw [hE x]
    ring
  have hyP : Function.Periodic (fun x => u x - w x - h * Z x) 1 :=
    fun x => by simp only [huP x, hwP x, hZP x]
  have hFP : Function.Periodic (fun x => -(u x - w x) ^ 2) 1 :=
    fun x => by simp only [huP x, hwP x]
  have cF : Continuous (fun x => -(u x - w x) ^ 2) := ((cu.sub cw).pow 2).neg
  have hcore := core (fun x => u x - w x - h * Z x) (fun x => -(u x - w x) ^ 2) hyP hFP cF hyD
  
  have hFabs : (∫ x in (0:ℝ)..1, |(fun x => -(u x - w x) ^ 2) x|) =
      ∫ x in (0:ℝ)..1, (u x - w x) ^ 2 :=
    intervalIntegral.integral_congr (fun x _ => by simp only [abs_neg, abs_sq])
  rw [hFabs] at hcore
  
  have hlip := riccati_L2_lipschitz_plus_T κ hκ p q u w huP hwP hu hw hu2 hw2
  have hQ0 : 0 ≤ ∫ x in (0:ℝ)..1, (u x - w x) ^ 2 :=
    intervalIntegral.integral_nonneg zero_le_one (fun x _ => sq_nonneg _)
  
  set Qf := ∫ x in (0:ℝ)..1, (u x - w x) ^ 2 with hQfdef
  set d := ‖ιT p - ιT q‖ ^ 2 with hddef
  set a := ‖ιT E‖ with hadef
  have hQ2 : Qf ^ 2 ≤ (2 * d) ^ 2 := pow_le_pow_left₀ hQ0 hlip 2
  have hdiv : 16 / 3 * Qf ^ 2 / κ ≤ 24 * d ^ 2 / κ := by
    rw [div_le_div_iff_of_pos_right hκ0]
    have hd2 : 0 ≤ d ^ 2 := sq_nonneg _
    nlinarith
  have ha2 : 0 ≤ a ^ 2 := sq_nonneg _
  have hgoal : (∫ x in (0:ℝ)..1, ((fun x => u x - w x - h * Z x) x) ^ 2) ≤
      3 * a ^ 2 + 24 * d ^ 2 / κ := by linarith
  simpa only using hgoal

theorem riccati_variation_bound_minus_T : ∀ κ : ℝ, 1 ≤ κ → ∀ q p E : CinfT, ∀ (h : ℝ) (w u Z : ℝ → ℝ), Function.Periodic w 1 → Function.Periodic u 1 → Function.Periodic Z 1 → (∀ x, HasDerivAt w ((q : ℝ → ℝ) x - 2 * κ * w x - w x ^ 2) x) → (∀ x, HasDerivAt u ((p : ℝ → ℝ) x - 2 * κ * u x - u x ^ 2) x) → (∀ x, HasDerivAt Z ((-2 * κ - 2 * w x) * Z x + kdvRHS (q : ℝ → ℝ) x) x) → (∫ x in (0:ℝ)..1, w x ^ 2) ≤ κ / 64 → (∫ x in (0:ℝ)..1, u x ^ 2) ≤ κ / 64 → (∀ x : ℝ, (E : ℝ → ℝ) x = (p : ℝ → ℝ) x - (q : ℝ → ℝ) x - h * kdvRHS (q : ℝ → ℝ) x) → (∫ x in (0:ℝ)..1, (u x - w x - h * Z x) ^ 2) ≤ 3 * ‖ιT E‖ ^ 2 + 24 * (‖ιT p - ιT q‖ ^ 2) ^ 2 / κ :=
by
  intro κ hκ q p E h w u Z hwP huP hZP hwD huD hZD hw2 hu2 hE
  have hκ0 : (0:ℝ) < κ := by linarith
  have hκne : κ ≠ 0 := hκ0.ne'
  
  have hcont : ∀ (f F : ℝ → ℝ), (∀ x, HasDerivAt f (F x) x) → Continuous f :=
    fun f F h => continuous_iff_continuousAt.2 fun x => (h x).continuousAt
  have hreflD : ∀ (f F : ℝ → ℝ), (∀ y, HasDerivAt f (F y) y) → ∀ x,
      HasDerivAt (fun y => -f (-y)) (F (-x)) x := by
    intro f F hf x
    have h1 := ((hf (-x)).comp x (hasDerivAt_neg x)).neg
    refine h1.congr_deriv ?_
    ring
  have hreflP : ∀ f : ℝ → ℝ, Function.Periodic f 1 →
      Function.Periodic (fun y => -f (-y)) 1 := by
    intro f hf x
    have h1 := hf (-(x + 1))
    rw [show -(x + 1) + 1 = -x by ring] at h1
    show -f (-(x + 1)) = -f (-x)
    rw [h1]
  have hR : ∀ g : ℝ → ℝ, Function.Periodic g 1 →
      (∫ x in (0:ℝ)..1, g (-x)) = ∫ x in (0:ℝ)..1, g x := by
    intro g hg
    rw [intervalIntegral.integral_comp_neg]
    have h1 := hg.intervalIntegral_add_eq (-1) 0
    norm_num at h1
    simpa using h1
  have hRsq : ∀ f : ℝ → ℝ, Function.Periodic f 1 →
      (∫ x in (0:ℝ)..1, (-f (-x)) ^ 2) = ∫ x in (0:ℝ)..1, f x ^ 2 := by
    intro f hf
    have h2 : (∫ x in (0:ℝ)..1, f (-x) ^ 2) = ∫ x in (0:ℝ)..1, f x ^ 2 :=
      hR (fun y => f y ^ 2) (fun x => by show f (x + 1) ^ 2 = f x ^ 2; rw [hf x])
    simp only [neg_sq]
    exact h2
  have hwc := hcont w _ hwD
  have huc := hcont u _ huD
  have hZc := hcont Z _ hZD
  have hEc : Continuous (E : ℝ → ℝ) := E.2.1.continuous
  have hEP : Function.Periodic (E : ℝ → ℝ) 1 := E.2.2
  
  obtain ⟨y, hy⟩ : ∃ y : ℝ → ℝ, y = fun x => u x - w x - h * Z x := ⟨_, rfl⟩
  have hyx : ∀ x, y x = u x - w x - h * Z x := fun x => by rw [hy]
  obtain ⟨G, hG⟩ : ∃ G : ℝ → ℝ, G = fun x => -2 * w x * y x - (u x - w x) ^ 2 := ⟨_, rfl⟩
  have hGx : ∀ x, G x = -2 * w x * y x - (u x - w x) ^ 2 := fun x => by rw [hG]
  have hyc : Continuous y := by rw [hy]; exact (huc.sub hwc).sub (continuous_const.mul hZc)
  have hyP : Function.Periodic y 1 := fun x => by rw [hyx, hyx, huP x, hwP x, hZP x]
  have hyD : ∀ x, HasDerivAt y ((E : ℝ → ℝ) x - 2 * κ * y x + G x) x := by
    intro x
    have h1 := ((huD x).sub (hwD x)).sub ((hZD x).const_mul h)
    rw [hy]
    refine h1.congr_deriv ?_
    simp only [hGx, hE x, hyx]
    ring
  have hGc : Continuous G := by
    rw [hG]; exact ((continuous_const.mul hwc).mul hyc).sub ((huc.sub hwc).pow 2)
  have hGP : Function.Periodic G 1 := fun x => by rw [hGx, hGx, hwP x, hyP x, huP x]
  
  obtain ⟨vp, hvpP, hvpD⟩ := (periodic_resolvent_T κ hκ (E : ℝ → ℝ) hEc hEP).1
  have hvp2 : (∫ x in (0:ℝ)..1, vp x ^ 2) ≤ ‖ιT E‖ ^ 2 := by
    rw [periodic_resolvent_parseval_T κ hκ E vp hvpP hvpD]
    have h := (weight_compare_T ((ιT E : Hm1T) : lp (fun _ : ℤ => ℂ) 2) κ hκ).2.1
    rw [Submodule.coe_norm]
    exact h
  
  obtain ⟨Er, hEr⟩ : ∃ Er : ℝ → ℝ, Er = fun x => (E : ℝ → ℝ) (-x) := ⟨_, rfl⟩
  have hErx : ∀ x, Er x = (E : ℝ → ℝ) (-x) := fun x => by rw [hEr]
  have hErc : Continuous Er := by rw [hEr]; exact hEc.comp continuous_neg
  have hErP : Function.Periodic Er 1 := by
    intro x
    rw [hErx, hErx]
    have h1 := hEP (-(x + 1))
    rw [show -(x + 1) + 1 = -x by ring] at h1
    exact h1.symm
  obtain ⟨vr, hvrP, hvrD⟩ := (periodic_resolvent_T κ hκ Er hErc hErP).1
  obtain ⟨vm, hvm⟩ : ∃ vm : ℝ → ℝ, vm = fun y => -vr (-y) := ⟨_, rfl⟩
  have hvmP : Function.Periodic vm 1 := by rw [hvm]; exact hreflP vr hvrP
  have hvmD : ∀ x, HasDerivAt vm ((E : ℝ → ℝ) x - 2 * κ * vm x) x := by
    intro x
    rw [hvm]
    refine (hreflD vr _ hvrD x).congr_deriv ?_
    simp only [hErx, neg_neg]
    ring
  have hvpc := hcont vp _ hvpD
  have hvmc := hcont vm _ hvmD
  have hiso : (∫ x in (0:ℝ)..1, vm x ^ 2) = ∫ x in (0:ℝ)..1, vp x ^ 2 := by
    have hF : ∀ x ∈ Set.uIcc (0:ℝ) 1, HasDerivAt
        (fun y => -(1 / (4 * κ)) * ((vm y - vp y) * (vm y - vp y))) (vm x ^ 2 - vp x ^ 2) x := by
      intro x _
      have h1 := (((hvmD x).sub (hvpD x)).mul ((hvmD x).sub (hvpD x))).const_mul (-(1 / (4 * κ)))
      refine h1.congr_deriv ?_
      simp only [Pi.sub_apply]
      field_simp
      ring
    have hint : IntervalIntegrable (fun x => vm x ^ 2 - vp x ^ 2) MeasureTheory.volume 0 1 :=
      ((hvmc.pow 2).sub (hvpc.pow 2)).intervalIntegrable 0 1
    have h2 := intervalIntegral.integral_eq_sub_of_hasDerivAt hF hint
    rw [intervalIntegral.integral_sub ((hvmc.pow 2).intervalIntegrable 0 1)
      ((hvpc.pow 2).intervalIntegrable 0 1)] at h2
    have h3 : vm 1 = vm 0 := by simpa using hvmP 0
    have h4 : vp 1 = vp 0 := by simpa using hvpP 0
    rw [h3, h4, sub_self] at h2
    linarith
  have hV : (∫ x in (0:ℝ)..1, vm x ^ 2) ≤ ‖ιT E‖ ^ 2 := by rw [hiso]; exact hvp2
  
  obtain ⟨z, hz⟩ : ∃ z : ℝ → ℝ, z = fun x => y x - vm x := ⟨_, rfl⟩
  have hzx : ∀ x, z x = y x - vm x := fun x => by rw [hz]
  have hzc : Continuous z := by rw [hz]; exact hyc.sub hvmc
  have hzP : Function.Periodic z 1 := fun x => by rw [hzx, hzx, hyP x, hvmP x]
  have hzD : ∀ x, HasDerivAt z (G x - 2 * κ * z x) x := by
    intro x
    have h1 := (hyD x).sub (hvmD x)
    rw [hz]
    refine h1.congr_deriv ?_
    simp only [hzx]
    ring
  have hGrc : Continuous (fun x => G (-x)) := hGc.comp continuous_neg
  have hGrP : Function.Periodic (fun x => G (-x)) 1 := by
    intro x
    show G (-(x + 1)) = G (-x)
    have h1 := hGP (-(x + 1))
    rw [show -(x + 1) + 1 = -x by ring] at h1
    exact h1.symm
  have hzrD : ∀ x, HasDerivAt (fun t => -z (-t)) (2 * κ * -z (-x) + G (-x)) x := by
    intro x
    refine (hreflD z _ hzD x).congr_deriv ?_
    show G (-x) - 2 * κ * z (-x) = _
    ring
  have hZr := ((periodic_resolvent_T κ hκ (fun x => G (-x)) hGrc hGrP).2
    (fun t => -z (-t)) (hreflP z hzP) hzrD).2.2.2
  have e2 : (∫ x in (0:ℝ)..1, |G (-x)|) = ∫ x in (0:ℝ)..1, |G x| :=
    hR (fun t => |G t|) (fun x => by show |G (x + 1)| = |G x|; rw [hGP x])
  have hZb : (∫ x in (0:ℝ)..1, z x ^ 2) ≤ (∫ x in (0:ℝ)..1, |G x|) ^ 2 / κ := by
    calc (∫ x in (0:ℝ)..1, z x ^ 2) = ∫ x in (0:ℝ)..1, (-z (-x)) ^ 2 := (hRsq z hzP).symm
      _ ≤ (∫ x in (0:ℝ)..1, |G (-x)|) ^ 2 / κ := hZr
      _ = (∫ x in (0:ℝ)..1, |G x|) ^ 2 / κ := by rw [e2]
  
  have hGi := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) zero_le_one
    (f := fun x => |G x|) (g := fun x => 2 * (|w x| * |y x|) + (u x - w x) ^ 2)
    (hGc.abs.intervalIntegrable 0 1)
    (((continuous_const.mul (hwc.abs.mul hyc.abs)).add ((huc.sub hwc).pow 2)).intervalIntegrable 0 1)
    (fun x _ => by
      have h1 := neg_abs_le (w x * y x)
      have h2 := le_abs_self (w x * y x)
      rw [abs_mul] at h1 h2
      have h3 := sq_nonneg (u x - w x)
      show |G x| ≤ 2 * (|w x| * |y x|) + (u x - w x) ^ 2
      rw [hGx, abs_le]
      constructor <;> nlinarith)
  rw [intervalIntegral.integral_add ((continuous_const.mul (hwc.abs.mul hyc.abs)).intervalIntegrable 0 1)
    (((huc.sub hwc).pow 2).intervalIntegrable 0 1),
    intervalIntegral.integral_const_mul] at hGi
  
  have hCS : (∫ x in (0:ℝ)..1, |w x| * |y x|) ^ 2 ≤
      (∫ x in (0:ℝ)..1, w x ^ 2) * (∫ x in (0:ℝ)..1, y x ^ 2) := by
    have h := cauchy_schwarz_unit_interval (fun x => |w x|) (fun x => |y x|) hwc.abs hyc.abs
    have e4 : (∫ x in (0:ℝ)..1, |w x| ^ 2) = ∫ x in (0:ℝ)..1, w x ^ 2 := by
      refine intervalIntegral.integral_congr (fun x _ => ?_)
      simp only [sq_abs]
    have e5 : (∫ x in (0:ℝ)..1, |y x| ^ 2) = ∫ x in (0:ℝ)..1, y x ^ 2 := by
      refine intervalIntegral.integral_congr (fun x _ => ?_)
      simp only [sq_abs]
    calc (∫ x in (0:ℝ)..1, |w x| * |y x|) ^ 2
        ≤ (∫ x in (0:ℝ)..1, |w x| ^ 2) * (∫ x in (0:ℝ)..1, |y x| ^ 2) := h
      _ = _ := by rw [e4, e5]
  
  have hYle := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) zero_le_one
    (f := fun x => y x ^ 2) (g := fun x => 2 * vm x ^ 2 + 2 * z x ^ 2)
    ((hyc.pow 2).intervalIntegrable 0 1)
    (((continuous_const.mul (hvmc.pow 2)).add (continuous_const.mul (hzc.pow 2))).intervalIntegrable 0 1)
    (fun x _ => by
      show y x ^ 2 ≤ 2 * vm x ^ 2 + 2 * z x ^ 2
      rw [hzx]
      nlinarith [sq_nonneg (2 * vm x - y x)])
  rw [intervalIntegral.integral_add ((continuous_const.mul (hvmc.pow 2)).intervalIntegrable 0 1)
    ((continuous_const.mul (hzc.pow 2)).intervalIntegrable 0 1),
    intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul] at hYle
  
  have hQ := riccati_L2_lipschitz_minus_T κ hκ p q u w huP hwP huD hwD hu2 hw2
  
  have hgoal : (∫ x in (0:ℝ)..1, (u x - w x - h * Z x) ^ 2) = ∫ x in (0:ℝ)..1, y x ^ 2 := by
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    simp only [hyx]
  rw [hgoal]
  
  have hY0 : 0 ≤ ∫ x in (0:ℝ)..1, y x ^ 2 :=
    intervalIntegral.integral_nonneg zero_le_one (fun x _ => sq_nonneg _)
  have hGi0 : 0 ≤ ∫ x in (0:ℝ)..1, |G x| :=
    intervalIntegral.integral_nonneg zero_le_one (fun x _ => abs_nonneg _)
  have hP0 : 0 ≤ ∫ x in (0:ℝ)..1, |w x| * |y x| :=
    intervalIntegral.integral_nonneg zero_le_one
      (fun x _ => mul_nonneg (abs_nonneg _) (abs_nonneg _))
  have hQ0 : 0 ≤ ∫ x in (0:ℝ)..1, (u x - w x) ^ 2 :=
    intervalIntegral.integral_nonneg zero_le_one (fun x _ => sq_nonneg _)
  
  set Y := ∫ x in (0:ℝ)..1, y x ^ 2 with hYdef
  set Gi := ∫ x in (0:ℝ)..1, |G x| with hGidef
  set P := ∫ x in (0:ℝ)..1, |w x| * |y x| with hPdef
  set Q := ∫ x in (0:ℝ)..1, (u x - w x) ^ 2 with hQdef
  set V := ∫ x in (0:ℝ)..1, vm x ^ 2 with hVdef
  set Zi := ∫ x in (0:ℝ)..1, z x ^ 2 with hZidef
  set W := ∫ x in (0:ℝ)..1, w x ^ 2 with hWdef
  set a2 := ‖ιT E‖ ^ 2 with ha2def
  set d := ‖ιT p - ιT q‖ ^ 2 with hddef
  have ha0 : 0 ≤ a2 := by positivity
  have hd0 : 0 ≤ d := by positivity
  have hZik : Zi * κ ≤ Gi ^ 2 := (le_div_iff₀ hκ0).1 hZb
  have hGi2 : Gi ^ 2 ≤ (2 * P + Q) ^ 2 := pow_le_pow_left₀ hGi0 hGi 2
  have h8 : (2 * P + Q) ^ 2 ≤ 8 * P ^ 2 + 2 * Q ^ 2 := by nlinarith [sq_nonneg (2 * P - Q)]
  have hP2 : P ^ 2 ≤ κ / 64 * Y := le_trans hCS (mul_le_mul_of_nonneg_right hw2 hY0)
  have hQ2 : Q ^ 2 ≤ (2 * d) ^ 2 := pow_le_pow_left₀ hQ0 hQ 2
  have hκZi : κ * Zi ≤ κ * Y / 8 + 8 * d ^ 2 := by linarith
  have hκY : κ * Y ≤ κ * (2 * V + 2 * Zi) := mul_le_mul_of_nonneg_left hYle hκ0.le
  have hκV : κ * V ≤ κ * a2 := mul_le_mul_of_nonneg_left hV hκ0.le
  have hκa : 0 ≤ κ * a2 := mul_nonneg hκ0.le ha0
  have hd2 : 0 ≤ d ^ 2 := sq_nonneg d
  have hfin : κ * Y ≤ 3 * κ * a2 + 24 * d ^ 2 := by linarith
  have hdiv : Y - 3 * a2 ≤ 24 * d ^ 2 / κ := by
    rw [le_div_iff₀ hκ0]
    linarith
  linarith

theorem riccati_pair_diff_sup_T : ∀ κ : ℝ, 1 ≤ κ → ∀ q p : CinfT, ∀ wp wm up um : ℝ → ℝ, Function.Periodic wp 1 → Function.Periodic wm 1 → Function.Periodic up 1 → Function.Periodic um 1 → (∀ x, HasDerivAt wp ((q : ℝ → ℝ) x + 2 * κ * wp x - wp x ^ 2) x) → (∀ x, HasDerivAt wm ((q : ℝ → ℝ) x - 2 * κ * wm x - wm x ^ 2) x) → (∀ x, HasDerivAt up ((p : ℝ → ℝ) x + 2 * κ * up x - up x ^ 2) x) → (∀ x, HasDerivAt um ((p : ℝ → ℝ) x - 2 * κ * um x - um x ^ 2) x) → (∫ x in (0:ℝ)..1, wp x ^ 2) ≤ κ / 64 → (∫ x in (0:ℝ)..1, wm x ^ 2) ≤ κ / 64 → (∫ x in (0:ℝ)..1, up x ^ 2) ≤ κ / 64 → (∫ x in (0:ℝ)..1, um x ^ 2) ≤ κ / 64 → ∀ x, ((um x - wm x) - (up x - wp x)) ^ 2 ≤ 64 * κ * ‖ιT p - ιT q‖ ^ 2 :=
by
  intro κ hκ q p wp wm up um hwpP hwmP hupP humP hwp hwm hup hum hwp2 hwm2 hup2 hum2
  have cont_of : ∀ (f f' : ℝ → ℝ), (∀ x, HasDerivAt f (f' x) x) → Continuous f :=
    fun f f' hf => continuous_iff_continuousAt.2 fun x => (hf x).continuousAt
  have hwpc : Continuous wp := cont_of _ _ hwp
  have hwmc : Continuous wm := cont_of _ _ hwm
  have hupc : Continuous up := cont_of _ _ hup
  have humc : Continuous um := cont_of _ _ hum
  
  have sob : ∀ (D D' : ℝ → ℝ), Function.Periodic D 1 → Continuous D' →
      (∀ x, HasDerivAt D (D' x) x) → ∀ x, D x ^ 2 ≤
        (∫ y in (0:ℝ)..1, D y ^ 2) + ∫ y in (0:ℝ)..1, 2 * |D y| * |D' y| := by
    intro D D' hP hD'c hD x
    have hDc : Continuous D := cont_of _ _ hD
    have hgc : Continuous (fun y => 2 * D y * D' y) := (continuous_const.mul hDc).mul hD'c
    have hgd : ∀ y, HasDerivAt (fun y => D y ^ 2) (2 * D y * D' y) y := by
      intro y
      have h := (hD y).pow 2
      refine h.congr_deriv ?_
      simp only [Nat.cast_ofNat]
      ring
    obtain ⟨x₁, hx₁, hDx⟩ := hP.exists_mem_Ico₀ one_pos x
    have hagi : IntervalIntegrable (fun y => |2 * D y * D' y|) MeasureTheory.volume 0 1 :=
      hgc.abs.intervalIntegrable 0 1
    have hmono : ∀ a b : ℝ, 0 ≤ a → a ≤ b → b ≤ 1 →
        (∫ y in a..b, |2 * D y * D' y|) ≤ ∫ y in (0:ℝ)..1, |2 * D y * D' y| := by
      intro a b ha hab hb
      exact intervalIntegral.integral_mono_interval ha hab hb
        (Filter.Eventually.of_forall fun t => abs_nonneg _) hagi
    have hpt : ∀ y ∈ Set.Icc (0:ℝ) 1,
        D x₁ ^ 2 ≤ D y ^ 2 + ∫ y in (0:ℝ)..1, |2 * D y * D' y| := by
      intro y hy
      have hftc : (∫ t in y..x₁, 2 * D t * D' t) = D x₁ ^ 2 - D y ^ 2 :=
        intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hgd t)
          (hgc.intervalIntegrable _ _)
      have hb : |∫ t in y..x₁, 2 * D t * D' t| ≤ ∫ y in (0:ℝ)..1, |2 * D y * D' y| := by
        rcases le_total y x₁ with h | h
        · calc _ ≤ ∫ t in y..x₁, |2 * D t * D' t| :=
                intervalIntegral.abs_integral_le_integral_abs h
            _ ≤ _ := hmono y x₁ hy.1 h hx₁.2.le
        · rw [intervalIntegral.integral_symm, abs_neg]
          calc _ ≤ ∫ t in x₁..y, |2 * D t * D' t| :=
                intervalIntegral.abs_integral_le_integral_abs h
            _ ≤ _ := hmono x₁ y hx₁.1 h hy.2
      have := le_abs_self (∫ t in y..x₁, 2 * D t * D' t)
      linarith
    have hint : (∫ _ in (0:ℝ)..1, D x₁ ^ 2) ≤
        ∫ y in (0:ℝ)..1, (D y ^ 2 + ∫ y in (0:ℝ)..1, |2 * D y * D' y|) :=
      intervalIntegral.integral_mono_on zero_le_one intervalIntegrable_const
        (((hDc.pow 2).add continuous_const).intervalIntegrable _ _) hpt
    rw [intervalIntegral.integral_const,
      intervalIntegral.integral_add ((hDc.pow 2).intervalIntegrable _ _) intervalIntegrable_const,
      intervalIntegral.integral_const] at hint
    simp only [sub_zero, one_smul] at hint
    have hK : (∫ y in (0:ℝ)..1, |2 * D y * D' y|) = ∫ y in (0:ℝ)..1, 2 * |D y| * |D' y| := by
      congr 1
      funext y
      rw [abs_mul, abs_mul, abs_two]
    rw [hDx, ← hK]
    linarith
  
  have hmax : ∀ (D : ℝ → ℝ), Continuous D → Function.Periodic D 1 →
      ∃ x₀ : ℝ, ∀ x, |D x| ≤ |D x₀| := by
    intro D hD hP
    obtain ⟨x₀, -, hx₀⟩ := isCompact_Icc.exists_isMaxOn
      (Set.nonempty_Icc.2 (zero_le_one' ℝ)) hD.abs.continuousOn
    refine ⟨x₀, fun x => ?_⟩
    obtain ⟨y, hy, hxy⟩ := hP.exists_mem_Ico₀ one_pos x
    rw [hxy]
    exact isMaxOn_iff.1 hx₀ y (Set.Ico_subset_Icc_self hy)
  
