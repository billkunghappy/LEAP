theorem good_unknown_tightness : ∃ δ > (0 : ℝ), ∃ C ≥ (0 : ℝ), ∀ K ≥ (1 : ℝ), ∀ q u : 𝓢(ℝ, ℝ), ‖ι q‖ ≤ δ →
