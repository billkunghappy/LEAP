      simp only [mul_zero, Real.exp_zero, one_mul, sub_zero] at h
      rw [abs_of_nonneg h0]
      have e : Real.exp ((2 * K + 1) * τ) * Real.exp (-(2 * K + 1) * τ) = 1 := by
        rw [← Real.exp_add]; ring_nf; exact Real.exp_zero
      have hp := Real.exp_pos ((2 * K + 1) * τ)
