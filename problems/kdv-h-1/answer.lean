    rw [hκ₀c, mul_zero] at hA
    have hb1 := (Hm1_weight_basic ((ι (v 0) : Lp ℂ 2 (volume : Measure ℝ)))).1
    have hb3 := ((Hm1_weight_basic ((ι (u 0) : Lp ℂ 2 (volume : Measure ℝ)))).2 κ₀ hκ₀1).2.1
    have h4 := mul_le_mul_of_nonneg_left hb3 hc0.le
    have h5 := mul_le_mul_of_nonneg_left hu0sq hc0.le
    have hsq : ‖(ι (v 0) : Lp ℂ 2 (volume : Measure ℝ))‖ ^ 2 ≤ δ ^ 2 := by linarith
    rw [hnorm]
