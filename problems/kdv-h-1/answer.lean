theorem riccati_sol_rapid_decay (κ : ℝ) (hκ : 0 < κ) (q : 𝓢(ℝ, ℝ)) (w : ℝ → ℝ)
    (hc : Continuous w) (hb : ∃ C : ℝ, ∀ x : ℝ, |w x| ≤ C)
    (htop : Filter.Tendsto w Filter.atTop (nhds 0))
    (hbot : Filter.Tendsto w Filter.atBot (nhds 0))
    (hd : ∀ x : ℝ, HasDerivAt w (q x + 2 * κ * w x - w x ^ 2) x) :
    ∀ k : ℕ, ∃ C : ℝ, ∀ x : ℝ, |x| ^ k * |w x| ≤ C :=
by
  
  have linear_ode_right_tail_bound : ∀ (κ R Cg M : ℝ) (k : ℕ) (_hκ : 0 < κ) (_hR : 0 < R)
      (w a g : ℝ → ℝ)
      (_hd : ∀ x : ℝ, R ≤ x → HasDerivAt w (a x * w x + g x) x)
      (_ha : ∀ x : ℝ, R ≤ x → κ ≤ a x)
      (_hM : ∀ x : ℝ, R ≤ x → w x ≤ M)
      (_hg : ∀ x : ℝ, R ≤ x → x ^ k * |g x| ≤ Cg),
      ∀ x : ℝ, R ≤ x → x ^ k * w x ≤ Cg / κ := by
    intro κ R Cg M k hκ hR w a g hd ha hM hg
    have hCg : 0 ≤ Cg :=
      le_trans (mul_nonneg (pow_nonneg hR.le k) (abs_nonneg _)) (hg R le_rfl)
    obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = Cg / κ := ⟨_, rfl⟩
    have hB0 : 0 ≤ B := by rw [hBdef]; exact div_nonneg hCg hκ.le
    have hκB : κ * B = Cg := by rw [hBdef]; field_simp
    obtain ⟨φ, hφdef⟩ : ∃ φ : ℝ → ℝ, φ = fun y => B * (y ^ k)⁻¹ := ⟨_, rfl⟩
    obtain ⟨φ', hφ'def⟩ : ∃ φ' : ℝ → ℝ,
        φ' = fun y => B * (-((k : ℝ) * y ^ (k - 1)) / (y ^ k) ^ 2) := ⟨_, rfl⟩
    have hφd : ∀ y : ℝ, 0 < y → HasDerivAt φ (φ' y) y := by
      intro y hy
      rw [hφdef, hφ'def]
      exact ((hasDerivAt_pow k y).inv (pow_ne_zero k hy.ne')).const_mul B
    have hφ'nonpos : ∀ y : ℝ, 0 < y → φ' y ≤ 0 := by
      intro y hy
      rw [hφ'def]
      have h0 : 0 ≤ (k : ℝ) * y ^ (k - 1) / (y ^ k) ^ 2 :=
        div_nonneg (mul_nonneg (Nat.cast_nonneg k) (pow_nonneg hy.le _)) (sq_nonneg _)
      have e : B * (-((k : ℝ) * y ^ (k - 1)) / (y ^ k) ^ 2) =
          -(B * ((k : ℝ) * y ^ (k - 1) / (y ^ k) ^ 2)) := by ring
      simp only
      rw [e]
      exact neg_nonpos.2 (mul_nonneg hB0 h0)
    have hφnonneg : ∀ y : ℝ, 0 < y → 0 ≤ φ y := by
      intro y hy
      rw [hφdef]
      exact mul_nonneg hB0 (inv_nonneg.2 (pow_nonneg hy.le k))
    have hgφ : ∀ y : ℝ, R ≤ y → 0 ≤ g y + κ * φ y := by
      intro y hy
      have hy0 : 0 < y := lt_of_lt_of_le hR hy
      have hpk : 0 < y ^ k := pow_pos hy0 k
      have h1 := hg y hy
      have h2 : |g y| ≤ Cg * (y ^ k)⁻¹ := by
        calc |g y| = (y ^ k)⁻¹ * (y ^ k * |g y|) := by
              rw [← mul_assoc, inv_mul_cancel₀ hpk.ne', one_mul]
          _ ≤ (y ^ k)⁻¹ * Cg := mul_le_mul_of_nonneg_left h1 (inv_nonneg.2 hpk.le)
          _ = Cg * (y ^ k)⁻¹ := mul_comm _ _
      have h3 : κ * φ y = Cg * (y ^ k)⁻¹ := by
        rw [hφdef]; simp only; rw [← mul_assoc, hκB]
      have h4 := neg_abs_le (g y)
      linarith
    intro x₀ hx₀
    by_contra hcon
    push_neg at hcon
    have hx0 : 0 < x₀ := lt_of_lt_of_le hR hx₀
    have hpk0 : 0 < x₀ ^ k := pow_pos hx0 k
    have hlt : φ x₀ < w x₀ := by
      have e : φ x₀ = B * (x₀ ^ k)⁻¹ := by rw [hφdef]
      rw [e]
      calc B * (x₀ ^ k)⁻¹ < (x₀ ^ k * w x₀) * (x₀ ^ k)⁻¹ :=
            mul_lt_mul_of_pos_right (by rw [hBdef]; exact hcon) (inv_pos.2 hpk0)
        _ = w x₀ := by rw [mul_comm, ← mul_assoc, inv_mul_cancel₀ hpk0.ne', one_mul]
    obtain ⟨c, hcdef⟩ : ∃ c : ℝ, c = w x₀ - φ x₀ := ⟨_, rfl⟩
    have hc0 : 0 < c := by rw [hcdef]; linarith
    have hMpos : 0 < M + 1 := by
      have := hM x₀ hx₀
      have := hφnonneg x₀ hx0
      linarith
    have hκc : 0 < κ * c := mul_pos hκ hc0
    obtain ⟨L, hLdef⟩ : ∃ L : ℝ, L = 2 * (M + 1) / (κ * c) := ⟨_, rfl⟩
    have hL0 : 0 < L := by rw [hLdef]; exact div_pos (by linarith) hκc
    have hLe : κ * c / 2 * L = M + 1 := by rw [hLdef]; field_simp
    have hu : ∀ y : ℝ, R ≤ y →
        HasDerivAt (fun y => w y - φ y) (a y * w y + g y - φ' y) y :=
      fun y hy => (hd y hy).sub (hφd y (lt_of_lt_of_le hR hy))
    have hcmp := image_le_of_deriv_right_lt_deriv_boundary'
      (f := fun y => c + κ * c / 2 * (y - x₀)) (f' := fun _ => κ * c / 2 * 1)
      (a := x₀) (b := x₀ + L)
      (B := fun y => w y - φ y) (B' := fun y => a y * w y + g y - φ' y)
      (by fun_prop)
      (fun y _ => HasDerivAt.hasDerivWithinAt
        ((((hasDerivAt_id' y).sub_const x₀).const_mul (κ * c / 2)).const_add c))
      (by simp [hcdef])
      (fun y hy => (hu y (le_trans hx₀ hy.1)).continuousAt.continuousWithinAt)
      (fun y hy => (hu y (le_trans hx₀ hy.1)).hasDerivWithinAt)
      (by
        intro y hy hfy
        simp only at hfy
        have hyR : R ≤ y := le_trans hx₀ hy.1
        have hy0 : 0 < y := lt_of_lt_of_le hR hyR
        have hfc : c ≤ c + κ * c / 2 * (y - x₀) := by
          have : 0 ≤ κ * c / 2 * (y - x₀) :=
            mul_nonneg (by linarith) (by linarith [hy.1])
          linarith
        have huc : c ≤ w y - φ y := by linarith
        have hay := ha y hyR
        have h1 : κ * c ≤ a y * (w y - φ y) := mul_le_mul hay huc hc0.le (le_trans hκ.le hay)
        have h2 := hφ'nonpos y hy0
        have h3 := hgφ y hyR
        have h4 : κ * φ y ≤ a y * φ y := mul_le_mul_of_nonneg_right hay (hφnonneg y hy0)
        have h5 : a y * w y = a y * (w y - φ y) + a y * φ y := by ring
        show κ * c / 2 * 1 < a y * w y + g y - φ' y
        linarith)
    have hfin := hcmp (x := x₀ + L) ⟨by linarith, le_rfl⟩
    simp only at hfin
    have hwM := hM (x₀ + L) (by linarith)
    have hφ0 := hφnonneg (x₀ + L) (by linarith)
    have e : κ * c / 2 * (x₀ + L - x₀) = M + 1 := by rw [add_sub_cancel_left]; exact hLe
    rw [e] at hfin
    linarith
  
  have linear_ode_left_tail_bound : ∀ (κ R Cg : ℝ) (k : ℕ) (_hκ : 0 < κ) (_hR : 0 < R)
      (_hkR : 2 * (k : ℝ) ≤ κ * R) (w a g : ℝ → ℝ)
      (_hd : ∀ x : ℝ, x ≤ -R → HasDerivAt w (a x * w x + g x) x)
      (_ha : ∀ x : ℝ, x ≤ -R → κ ≤ a x)
      (_hg : ∀ x : ℝ, x ≤ -R → |x| ^ k * |g x| ≤ Cg),
      ∀ x : ℝ, x ≤ -R → |x| ^ k * w x ≤ 2 * Cg / κ + 1 + R ^ k * |w (-R)| := by
    intro κ R Cg k hκ hR hkR w a g hd ha hg
    have hCg : 0 ≤ Cg :=
      le_trans (mul_nonneg (pow_nonneg (abs_nonneg _) k) (abs_nonneg _)) (hg (-R) le_rfl)
    obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = 2 * Cg / κ + 1 + R ^ k * |w (-R)| := ⟨_, rfl⟩
    have hRkw : 0 ≤ R ^ k * |w (-R)| := mul_nonneg (pow_nonneg hR.le k) (abs_nonneg _)
    have hB1 : R ^ k * |w (-R)| + 1 ≤ B := by
      rw [hBdef]
      have : 0 ≤ 2 * Cg / κ := div_nonneg (by linarith) hκ.le
      linarith
    have hB0 : 0 < B := by linarith
    have hκB : κ * B = 2 * Cg + κ * (1 + R ^ k * |w (-R)|) := by
      rw [hBdef]; field_simp; ring
    have hW : ∀ t : ℝ, R ≤ t →
        HasDerivAt (fun t => w (-t)) (-(a (-t) * w (-t) + g (-t))) t := by
      intro t ht
      have h1 := (hd (-t) (by linarith)).comp t (hasDerivAt_neg t)
      convert h1 using 1
      ring
    obtain ⟨Ψ, hΨdef⟩ : ∃ Ψ : ℝ → ℝ, Ψ = fun t => B * (t ^ k)⁻¹ := ⟨_, rfl⟩
    obtain ⟨Ψ', hΨ'def⟩ : ∃ Ψ' : ℝ → ℝ,
        Ψ' = fun t => B * (-((k : ℝ) * t ^ (k - 1)) / (t ^ k) ^ 2) := ⟨_, rfl⟩
    have hΨd : ∀ t : ℝ, 0 < t → HasDerivAt Ψ (Ψ' t) t := by
      intro t ht
      rw [hΨdef, hΨ'def]
      exact ((hasDerivAt_pow k t).inv (pow_ne_zero k ht.ne')).const_mul B
    have hΨ'lb : ∀ t : ℝ, R ≤ t → -(κ / 2) * Ψ t ≤ Ψ' t := by
      intro t ht
      have ht0 : 0 < t := lt_of_lt_of_le hR ht
      have hpk : 0 < t ^ k := pow_pos ht0 k
      have key : (k : ℝ) * t ^ (k - 1) ≤ κ / 2 * t ^ k := by
        rcases Nat.eq_zero_or_pos k with hk | hk
        · subst hk
          simp only [Nat.cast_zero, zero_mul, pow_zero, mul_one]
          linarith
        · obtain ⟨n, rfl⟩ : ∃ n, k = n + 1 := ⟨k - 1, by omega⟩
          simp only [Nat.add_sub_cancel, pow_succ]
          push_cast at hkR ⊢
          have hκt := mul_le_mul_of_nonneg_left ht hκ.le
          have hn : 2 * ((n : ℝ) + 1) ≤ κ * t := by linarith
          have hpn : 0 ≤ t ^ n := pow_nonneg ht0.le n
          have := mul_le_mul_of_nonneg_left hn hpn
          nlinarith
      have hinv : (t ^ k)⁻¹ = t ^ k * ((t ^ k) ^ 2)⁻¹ := by
        rw [pow_two, mul_inv, ← mul_assoc, mul_inv_cancel₀ hpk.ne', one_mul]
      rw [hΨdef, hΨ'def]
      simp only
      have e1 : B * (-((k : ℝ) * t ^ (k - 1)) / (t ^ k) ^ 2) =
          -(B * ((k : ℝ) * t ^ (k - 1)) * ((t ^ k) ^ 2)⁻¹) := by ring
      have e2 : -(κ / 2) * (B * (t ^ k)⁻¹) =
          -(B * (κ / 2 * t ^ k) * ((t ^ k) ^ 2)⁻¹) := by
        rw [hinv]; ring
      rw [e1, e2, neg_le_neg_iff]
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left key hB0.le)
        (inv_nonneg.2 (sq_nonneg _))
    have hΨpos : ∀ t : ℝ, 0 < t → 0 < Ψ t := by
      intro t ht
      rw [hΨdef]
      exact mul_pos hB0 (inv_pos.2 (pow_pos ht k))
    have hinit : w (-R) ≤ Ψ R := by
      have hpk : 0 < R ^ k := pow_pos hR k
      have e : Ψ R = B * (R ^ k)⁻¹ := by rw [hΨdef]
      rw [e]
      calc w (-R) ≤ |w (-R)| := le_abs_self _
        _ = (R ^ k * |w (-R)|) * (R ^ k)⁻¹ := by
            rw [mul_comm (R ^ k), mul_assoc, mul_inv_cancel₀ hpk.ne', mul_one]
        _ ≤ B * (R ^ k)⁻¹ := mul_le_mul_of_nonneg_right (by linarith) (inv_nonneg.2 hpk.le)
    have hcmp : ∀ t : ℝ, R ≤ t → w (-t) ≤ Ψ t := by
      intro t ht
      have hc := image_le_of_deriv_right_lt_deriv_boundary'
        (f := fun t => w (-t)) (f' := fun t => -(a (-t) * w (-t) + g (-t)))
        (a := R) (b := t + 1) (B := Ψ) (B' := Ψ')
        (fun s hs => (hW s hs.1).continuousAt.continuousWithinAt)
        (fun s hs => (hW s hs.1).hasDerivWithinAt)
        hinit
        (fun s hs => (hΨd s (lt_of_lt_of_le hR hs.1)).continuousAt.continuousWithinAt)
        (fun s hs => (hΨd s (lt_of_lt_of_le hR hs.1)).hasDerivWithinAt)
        (by
          intro s hs hfs
          simp only at hfs
          have hs0 : 0 < s := lt_of_lt_of_le hR hs.1
          have hpk : 0 < s ^ k := pow_pos hs0 k
          have has := ha (-s) (by linarith [hs.1])
          have hgs := hg (-s) (by linarith [hs.1])
          rw [abs_neg, abs_of_pos hs0] at hgs
          have h2 : |g (-s)| ≤ Cg * (s ^ k)⁻¹ := by
            calc |g (-s)| = (s ^ k)⁻¹ * (s ^ k * |g (-s)|) := by
                  rw [← mul_assoc, inv_mul_cancel₀ hpk.ne', one_mul]
              _ ≤ (s ^ k)⁻¹ * Cg := mul_le_mul_of_nonneg_left hgs (inv_nonneg.2 hpk.le)
              _ = Cg * (s ^ k)⁻¹ := mul_comm _ _
          have hΨs : Ψ s = B * (s ^ k)⁻¹ := by rw [hΨdef]
          have hlb := hΨ'lb s hs.1
          have hΨp := hΨpos s hs0
          have h3 : κ * Ψ s ≤ a (-s) * Ψ s := mul_le_mul_of_nonneg_right has hΨp.le
          have h4 := neg_abs_le (g (-s))
          have hinvpos : 0 < (s ^ k)⁻¹ := inv_pos.2 hpk
          have h5 : Cg * (s ^ k)⁻¹ < κ / 2 * Ψ s := by
            rw [hΨs]
            have hh : κ / 2 * B = Cg + κ / 2 * (1 + R ^ k * |w (-R)|) := by linarith [hκB]
            rw [← mul_assoc, hh]
            apply mul_lt_mul_of_pos_right _ hinvpos
            have : 0 < κ / 2 * (1 + R ^ k * |w (-R)|) :=
              mul_pos (by linarith) (by linarith)
            linarith
          show -(a (-s) * w (-s) + g (-s)) < Ψ' s
          rw [hfs]
          linarith)
      exact hc ⟨ht, by linarith⟩
    intro x hx
    have h := hcmp (-x) (by linarith)
    rw [neg_neg] at h
    have hx0 : 0 < -x := by linarith
    rw [abs_of_neg (by linarith : x < 0)]
    have hpk : 0 < (-x) ^ k := pow_pos hx0 k
    have e : Ψ (-x) = B * ((-x) ^ k)⁻¹ := by rw [hΨdef]
    rw [e] at h
    calc (-x) ^ k * w x ≤ (-x) ^ k * (B * ((-x) ^ k)⁻¹) := mul_le_mul_of_nonneg_left h hpk.le
      _ = B := by rw [mul_comm B, ← mul_assoc, mul_inv_cancel₀ hpk.ne', one_mul]
      _ = _ := hBdef
  
  intro k
  obtain ⟨M, hM⟩ := hb
  obtain ⟨Cq, hCqdef⟩ : ∃ Cq : ℝ, Cq = SchwartzMap.seminorm ℝ k 0 q := ⟨_, rfl⟩
  have hqd : ∀ x : ℝ, |x| ^ k * |q x| ≤ Cq := by
    intro x
    have := SchwartzMap.norm_pow_mul_le_seminorm ℝ q k x
    rw [hCqdef]
    simpa only [Real.norm_eq_abs] using this
  have hCq0 : 0 ≤ Cq := le_trans (by positivity) (hqd 0)
  have hM0 : 0 ≤ M := le_trans (abs_nonneg _) (hM 0)
  obtain ⟨R₁, hR₁⟩ := Filter.eventually_atTop.1 (htop.eventually_le_const hκ)
  obtain ⟨R₂, hR₂⟩ := Filter.eventually_atBot.1 (hbot.eventually_le_const hκ)
  obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = max (max 1 R₁) (max (-R₂) (2 * (k : ℝ) / κ)) := ⟨_, rfl⟩
  have hR1 : 1 ≤ R := by rw [hRdef]; exact le_trans (le_max_left _ _) (le_max_left _ _)
  have hRR₁ : R₁ ≤ R := by rw [hRdef]; exact le_trans (le_max_right _ _) (le_max_left _ _)
  have hRR₂ : -R₂ ≤ R := by rw [hRdef]; exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hRk : 2 * (k : ℝ) / κ ≤ R := by
    rw [hRdef]; exact le_trans (le_max_right _ _) (le_max_right _ _)
  have hR0 : 0 < R := by linarith
  have hkR : 2 * (k : ℝ) ≤ κ * R := by
    rw [div_le_iff₀ hκ] at hRk; linarith
  obtain ⟨a, hadef⟩ : ∃ a : ℝ → ℝ, a = fun x => 2 * κ - w x := ⟨_, rfl⟩
  have haR : ∀ x : ℝ, R ≤ x → κ ≤ a x := by
    intro x hx
    have := hR₁ x (le_trans hRR₁ hx)
    rw [hadef]; linarith
  have haL : ∀ x : ℝ, x ≤ -R → κ ≤ a x := by
    intro x hx
    have := hR₂ x (by linarith)
    rw [hadef]; linarith
  have hd1 : ∀ x : ℝ, HasDerivAt w (a x * w x + q x) x := by
    intro x
    convert hd x using 1
    rw [hadef]; ring
  have hd2 : ∀ x : ℝ, HasDerivAt (fun y => -w y) (a x * (-w x) + (-q x)) x := by
    intro x
    convert (hd x).neg using 1
    rw [hadef]; ring
  have hgR : ∀ x : ℝ, R ≤ x → x ^ k * |q x| ≤ Cq := by
    intro x hx
    have := hqd x
    rwa [abs_of_pos (by linarith : (0 : ℝ) < x)] at this
  have hgR' : ∀ x : ℝ, R ≤ x → x ^ k * |(fun y => -q y) x| ≤ Cq := by
    intro x hx
    simp only [abs_neg]
    exact hgR x hx
  have hgL' : ∀ x : ℝ, x ≤ -R → |x| ^ k * |(fun y => -q y) x| ≤ Cq := by
    intro x _
    simp only [abs_neg]
    exact hqd x
  have P1 : ∀ x : ℝ, R ≤ x → x ^ k * w x ≤ Cq / κ :=
    linear_ode_right_tail_bound κ R Cq M k hκ hR0 w a q (fun x _ => hd1 x) haR
      (fun x _ => le_trans (le_abs_self _) (hM x)) hgR
  have P2 : ∀ x : ℝ, R ≤ x → x ^ k * (-w x) ≤ Cq / κ :=
    linear_ode_right_tail_bound κ R Cq M k hκ hR0 (fun y => -w y) a (fun y => -q y)
      (fun x _ => hd2 x) haR (fun x _ => le_trans (neg_le_abs _) (hM x)) hgR'
  have P3 : ∀ x : ℝ, x ≤ -R → |x| ^ k * w x ≤ 2 * Cq / κ + 1 + R ^ k * |w (-R)| :=
    linear_ode_left_tail_bound κ R Cq k hκ hR0 hkR w a q (fun x _ => hd1 x) haL
      (fun x _ => hqd x)
  have P4 : ∀ x : ℝ, x ≤ -R → |x| ^ k * (-w x) ≤ 2 * Cq / κ + 1 + R ^ k * |-w (-R)| :=
    linear_ode_left_tail_bound κ R Cq k hκ hR0 hkR (fun y => -w y) a (fun y => -q y)
      (fun x _ => hd2 x) haL hgL'
  rw [abs_neg] at P4
  have hCk : 0 ≤ Cq / κ := div_nonneg hCq0 hκ.le
  have hRkM : 0 ≤ R ^ k * M := mul_nonneg (pow_nonneg hR0.le k) hM0
  have hRkw : 0 ≤ R ^ k * |w (-R)| := mul_nonneg (pow_nonneg hR0.le k) (abs_nonneg _)
  have hCk2 : 0 ≤ 2 * Cq / κ := div_nonneg (by linarith) hκ.le
  refine ⟨Cq / κ + (2 * Cq / κ + 1 + R ^ k * |w (-R)|) + R ^ k * M, fun x => ?_⟩
  by_cases hxR : R ≤ x
  · rw [abs_of_pos (by linarith : (0 : ℝ) < x)]
    rcases abs_cases (w x) with ⟨h, _⟩ | ⟨h, _⟩
    · rw [h]; have := P1 x hxR; linarith
    · rw [h]; have := P2 x hxR; linarith
  · by_cases hxL : x ≤ -R
    · rcases abs_cases (w x) with ⟨h, _⟩ | ⟨h, _⟩
      · rw [h]; have := P3 x hxL; linarith
      · rw [h]; have := P4 x hxL; linarith
    · push_neg at hxR hxL
      have hax : |x| ≤ R := abs_le.2 ⟨by linarith, by linarith⟩
      have h1 : |x| ^ k ≤ R ^ k := pow_le_pow_left₀ (abs_nonneg x) hax k
      have h2 : |x| ^ k * |w x| ≤ R ^ k * M :=
        mul_le_mul h1 (hM x) (abs_nonneg _) (pow_nonneg hR0.le k)
      linarith

theorem schwartz_of_riccati_decay (κ : ℝ) (q : 𝓢(ℝ, ℝ)) (w : ℝ → ℝ)
    (hd : ∀ x : ℝ, HasDerivAt w (q x + 2 * κ * w x - w x ^ 2) x)
    (hdec : ∀ k : ℕ, ∃ C : ℝ, ∀ x : ℝ, |x| ^ k * |w x| ≤ C) :
    ∃ W : 𝓢(ℝ, ℝ), ∀ x : ℝ, W x = w x :=
by
  have hdiff : Differentiable ℝ w := fun x => (hd x).differentiableAt
  have hD : deriv w = fun x => q x + 2 * κ * w x - w x ^ 2 := funext fun x => (hd x).deriv
  have hq : ∀ n : ℕ, ContDiff ℝ n (q : ℝ → ℝ) := fun n => contDiff_infty.1 (q.smooth ⊤) n
  
  have hsm : ∀ n : ℕ, ContDiff ℝ n w := by
    intro n
    induction n with
    | zero => exact contDiff_zero.2 hdiff.continuous
    | succ n ih =>
      rw [Nat.cast_succ, contDiff_succ_iff_deriv]
      refine ⟨hdiff, fun h => absurd h (by simp), ?_⟩
      rw [hD]
      exact ((hq n).add (contDiff_const.mul ih)).sub (ih.pow 2)
  
  have hrec : ∀ (n : ℕ) (x : ℝ), |iteratedDeriv (n + 1) w x| ≤
      |iteratedDeriv n (q : ℝ → ℝ) x| + 2 * |κ| * |iteratedDeriv n w x|
        + ∑ i ∈ Finset.range (n + 1),
            (n.choose i : ℝ) * |iteratedDeriv i w x| * |iteratedDeriv (n - i) w x| := by
    intro n x
    have hD' : deriv w = ((q : ℝ → ℝ) + fun y => 2 * κ * w y) - (w * w) := by
      rw [hD]; funext y; simp only [Pi.add_apply, Pi.sub_apply, Pi.mul_apply]; ring
    have cq : ContDiffAt ℝ n (q : ℝ → ℝ) x := (hq n).contDiffAt
    have cw : ContDiffAt ℝ n w x := (hsm n).contDiffAt
    have c2 : ContDiffAt ℝ n (fun y => 2 * κ * w y) x := (contDiff_const.mul (hsm n)).contDiffAt
    have cs : ContDiffAt ℝ n ((q : ℝ → ℝ) + fun y => 2 * κ * w y) x := cq.add c2
    have cm : ContDiffAt ℝ n (w * w) x := ((hsm n).mul (hsm n)).contDiffAt
    rw [iteratedDeriv_succ', hD', iteratedDeriv_sub cs cm, iteratedDeriv_add cq c2,
      iteratedDeriv_const_mul cw, iteratedDeriv_mul cw cw]
    have hS : |∑ i ∈ Finset.range (n + 1),
        (n.choose i : ℝ) * iteratedDeriv i w x * iteratedDeriv (n - i) w x| ≤
        ∑ i ∈ Finset.range (n + 1),
          (n.choose i : ℝ) * |iteratedDeriv i w x| * |iteratedDeriv (n - i) w x| := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans (le_of_eq (Finset.sum_congr rfl fun i _ => ?_))
      rw [abs_mul, abs_mul, Nat.abs_cast]
    have hB : |2 * κ * iteratedDeriv n w x| = 2 * |κ| * |iteratedDeriv n w x| := by
      rw [abs_mul, abs_mul, abs_two]
    have a1 := le_abs_self (iteratedDeriv n (q : ℝ → ℝ) x)
    have a2 := neg_abs_le (iteratedDeriv n (q : ℝ → ℝ) x)
    have b1 := le_abs_self (2 * κ * iteratedDeriv n w x)
    have b2 := neg_abs_le (2 * κ * iteratedDeriv n w x)
    have s1 := le_abs_self (∑ i ∈ Finset.range (n + 1),
        (n.choose i : ℝ) * iteratedDeriv i w x * iteratedDeriv (n - i) w x)
    have s2 := neg_abs_le (∑ i ∈ Finset.range (n + 1),
        (n.choose i : ℝ) * iteratedDeriv i w x * iteratedDeriv (n - i) w x)
    rw [abs_le]
    constructor <;> linarith
  
  have hb : ∀ n k : ℕ, ∃ C : ℝ, ∀ x : ℝ, |x| ^ k * |iteratedDeriv n (q : ℝ → ℝ) x| ≤ C := by
    intro n k
    obtain ⟨C, -, hC⟩ := q.decay k n
    refine ⟨C, fun x => ?_⟩
    have := hC x
    rwa [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, Real.norm_eq_abs] at this
  
  have hQ : ∀ m k : ℕ, ∃ D : ℝ, 0 ≤ D ∧
      ∀ j ≤ m, ∀ x : ℝ, |x| ^ k * |iteratedDeriv j w x| ≤ D := by
    intro m
    induction m with
    | zero =>
      intro k
      obtain ⟨C, hC⟩ := hdec k
      refine ⟨max C 0, le_max_right _ _, fun j hj x => ?_⟩
      have hj0 : j = 0 := Nat.le_zero.1 hj
      subst hj0
      simp only [iteratedDeriv_zero]
      exact (hC x).trans (le_max_left _ _)
    | succ m ih =>
      intro k
      obtain ⟨Dk, hDk0, hDk⟩ := ih k
      obtain ⟨D0, hD00, hD0⟩ := ih 0
      obtain ⟨Cb, hCb⟩ := hb m k
      refine ⟨max Dk (Cb + 2 * |κ| * Dk
          + ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * Dk * D0),
        le_trans hDk0 (le_max_left _ _), fun j hj x => ?_⟩
      rcases Nat.lt_or_ge j (m + 1) with hjm | hjm
      · exact (hDk j (Nat.le_of_lt_succ hjm) x).trans (le_max_left _ _)
      · have hj' : j = m + 1 := le_antisymm hj hjm
        subst hj'
        refine le_trans ?_ (le_max_right _ _)
        have hxk : 0 ≤ |x| ^ k := pow_nonneg (abs_nonneg x) k
        have h1 := mul_le_mul_of_nonneg_left (hrec m x) hxk
        have h2 := hCb x
        have h3 : |x| ^ k * |iteratedDeriv m w x| ≤ Dk := hDk m le_rfl x
        have h4 : |x| ^ k * ∑ i ∈ Finset.range (m + 1),
            (m.choose i : ℝ) * |iteratedDeriv i w x| * |iteratedDeriv (m - i) w x| ≤
            ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * Dk * D0 := by
          rw [Finset.mul_sum]
          refine Finset.sum_le_sum fun i hi => ?_
          have hi' : i ≤ m := Nat.le_of_lt_succ (Finset.mem_range.1 hi)
          have e1 := hDk i hi' x
          have e2 : |iteratedDeriv (m - i) w x| ≤ D0 := by
            have := hD0 (m - i) (Nat.sub_le m i) x
            simpa using this
          have e3 : |x| ^ k * |iteratedDeriv i w x| * |iteratedDeriv (m - i) w x| ≤ Dk * D0 :=
            mul_le_mul e1 e2 (abs_nonneg _) hDk0
          have e4 := mul_le_mul_of_nonneg_left e3 (Nat.cast_nonneg (m.choose i) : (0 : ℝ) ≤ m.choose i)
          calc |x| ^ k * ((m.choose i : ℝ) * |iteratedDeriv i w x| * |iteratedDeriv (m - i) w x|)
              = (m.choose i : ℝ) * (|x| ^ k * |iteratedDeriv i w x| * |iteratedDeriv (m - i) w x|) := by
                ring
            _ ≤ (m.choose i : ℝ) * (Dk * D0) := e4
            _ = (m.choose i : ℝ) * Dk * D0 := by ring
        have h5 : |x| ^ k * (2 * |κ| * |iteratedDeriv m w x|) ≤ 2 * |κ| * Dk := by
          calc |x| ^ k * (2 * |κ| * |iteratedDeriv m w x|)
              = 2 * |κ| * (|x| ^ k * |iteratedDeriv m w x|) := by ring
            _ ≤ 2 * |κ| * Dk := mul_le_mul_of_nonneg_left h3 (by positivity)
        rw [mul_add, mul_add] at h1
        linarith
  
  refine ⟨⟨w, contDiff_infty.2 hsm, fun k n => ?_⟩, fun x => rfl⟩
  obtain ⟨D, -, hDn⟩ := hQ n k
  refine ⟨D, fun x => ?_⟩
  rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, Real.norm_eq_abs]
  exact hDn n le_rfl x

theorem rgreen_hasDerivAt (κ : ℝ) (hκ : 0 < κ) (w : 𝓢(ℝ, ℝ)) :
    ∀ x : ℝ, HasDerivAt (rgreen κ w) (2 * (w x - κ) * rgreen κ w x + 1) x :=
by
  intro x
  obtain ⟨W, hW⟩ : ∃ W : ℝ → ℝ, ∀ t, W t = ∫ y in (0 : ℝ)..t, w y := ⟨_, fun _ => rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : ℝ → ℝ, ∀ y, F y = Real.exp (2 * κ * y - 2 * W y) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : ℝ → ℝ, ∀ t, E t = Real.exp (-2 * κ * t + 2 * W t) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨J, hJ⟩ : ∃ J : ℝ → ℝ, ∀ t, J t = ∫ y in Set.Iic t, F y := ⟨_, fun _ => rfl⟩
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = ∫ y, ‖w y‖ := ⟨_, rfl⟩
  have hii : ∀ a b : ℝ, IntervalIntegrable (fun y => w y) volume a b :=
    fun a b => w.continuous.intervalIntegrable a b
  have hWf : W = fun t => ∫ y in (0 : ℝ)..t, w y := funext hW
  have hWd : ∀ t, HasDerivAt W (w t) t := by
    intro t
    rw [hWf]
    exact (w.continuous.integral_hasStrictDerivAt 0 t).hasDerivAt
  have hWc : Continuous W := by
    rw [hWf]
    exact intervalIntegral.continuous_primitive hii 0
  have hFf : F = fun y => Real.exp (2 * κ * y - 2 * W y) := funext hF
  have hFc : Continuous F := by
    rw [hFf]
    exact Real.continuous_exp.comp
      ((continuous_const.mul continuous_id).sub (continuous_const.mul hWc))
  
  have hWb : ∀ y, |W y| ≤ A := by
    intro y
    rw [hW, ← Real.norm_eq_abs, hA]
    refine (intervalIntegral.norm_integral_le_integral_norm_uIoc).trans ?_
    exact setIntegral_le_integral ((w.integrable (μ := volume)).norm)
      (ae_of_all _ fun _ => norm_nonneg _)
  
  have hFint : ∀ c : ℝ, IntegrableOn F (Set.Iic c) := by
    intro c
    refine Integrable.mono'
      ((integrableOn_exp_mul_Iic (by positivity : (0 : ℝ) < 2 * κ) c).const_mul
        (Real.exp (2 * A)))
      hFc.aestronglyMeasurable (ae_of_all _ fun y => ?_)
    rw [hF, Real.norm_eq_abs, Real.abs_exp, ← Real.exp_add]
    apply Real.exp_le_exp.2
    have := (abs_le.1 (hWb y)).1
    linarith
  
  have hJd : HasDerivAt J (F x) x := by
    have hJf : J = fun t => J 0 + ∫ y in (0 : ℝ)..t, F y := by
      funext t
      have := intervalIntegral.integral_Iic_sub_Iic (hFint 0) (hFint t)
      rw [hJ t, hJ 0]
      linarith
    rw [hJf]
    exact ((hFc.integral_hasStrictDerivAt 0 x).hasDerivAt).const_add _
  
  have hEd : HasDerivAt E (E x * (-2 * κ + 2 * w x)) x := by
    have hEf : E = fun t => Real.exp (-2 * κ * t + 2 * W t) := funext hE
    have h0 : HasDerivAt (fun t => -2 * κ * t + 2 * W t) (-2 * κ + 2 * w x) x :=
      (((hasDerivAt_id' x).const_mul (-2 * κ)).add ((hWd x).const_mul 2)).congr_deriv
        (by ring)
    rw [hEf]
    exact h0.exp
  have hEF : E x * F x = 1 := by
    rw [hE, hF, ← Real.exp_add,
      show (-2 * κ * x + 2 * W x) + (2 * κ * x - 2 * W x) = 0 by ring, Real.exp_zero]
  
  have hclosed : ∀ t, rgreen κ w t = E t * J t := by
    intro t
    have h1 : ∀ s : ℝ, Real.exp (-2 * κ * s + 2 * ∫ y in (t - s)..t, w y) =
        E t * F (t - s) := by
      intro s
      rw [← intervalIntegral.integral_interval_sub_left (hii 0 t) (hii 0 (t - s)), ← hW, ← hW,
        hE, hF, ← Real.exp_add]
      congr 1
      ring
    have h2 : rgreen κ w t = ∫ s in Set.Ioi (0 : ℝ), E t * F (t - s) := by
      unfold rgreen
      congr 1
      funext s
      exact h1 s
    have h3 : (∫ s in Set.Ioi (0 : ℝ), F (t - s)) = ∫ u in Set.Iic (0 : ℝ), F (t + u) := by
      have := integral_comp_neg_Ioi (0 : ℝ) (fun u => F (t + u))
      simp only [neg_zero] at this
      rw [← this]
      congr 1
    have h4 : (∫ u in Set.Iic (0 : ℝ), F (t + u)) = ∫ y in Set.Iic t, F y := by
      rw [← integral_indicator measurableSet_Iic, ← integral_indicator measurableSet_Iic]
      rw [← integral_add_right_eq_self (fun y => (Set.Iic t).indicator F y) t]
      congr 1
      funext u
      simp only [Set.indicator_apply, Set.mem_Iic]
      by_cases hu : u ≤ 0
      · rw [if_pos hu, if_pos (by linarith), add_comm]
      · rw [if_neg hu, if_neg (by linarith)]
    rw [h2, integral_const_mul, hJ, h3, h4]
  have hfun : rgreen κ w = fun t => E t * J t := funext hclosed
  rw [hclosed x, hfun]
  exact (hEd.mul hJd).congr_deriv (by rw [hEF]; ring)

theorem rgreen_offset_decay (κ : ℝ) (hκ : 0 < κ) (w : 𝓢(ℝ, ℝ)) :
    ∀ k : ℕ, ∃ C : ℝ, ∀ x : ℝ, |x| ^ k * |rgreen κ w x - 1 / (2 * κ)| ≤ C :=
by
  intro k
  
  have hexp1 : ∀ t : ℝ, |Real.exp t - 1| ≤ |t| * Real.exp |t| := by
    intro t
    rcases le_or_gt 0 t with ht | ht
    · rw [abs_of_nonneg ht]
      have h1 := Real.add_one_le_exp t
      have h2 := Real.add_one_le_exp (-t)
      have h3 : Real.exp t * Real.exp (-t) = 1 := by rw [← Real.exp_add]; simp
      have hp := Real.exp_pos t
      rw [abs_of_nonneg (by linarith)]
      nlinarith [mul_le_mul_of_nonneg_left h2 hp.le]
    · rw [abs_of_neg ht]
      have h1 := Real.add_one_le_exp t
      have h5 : 1 ≤ Real.exp (-t) := Real.one_le_exp (by linarith)
      have h4 : Real.exp t ≤ 1 := Real.exp_le_one_iff.2 ht.le
      rw [abs_of_nonpos (by linarith)]
      nlinarith [mul_le_mul_of_nonneg_left h5 (neg_nonneg.2 ht.le)]
  
  obtain ⟨P, hP0, hpoly⟩ : ∃ P : ℝ, 0 ≤ P ∧
      ∀ s : ℝ, 0 ≤ s → (1 + s) ^ (k + 1) ≤ P * Real.exp (κ * s) := by
    refine ⟨((k + 1).factorial : ℝ) * Real.exp κ / κ ^ (k + 1), by positivity, fun s hs => ?_⟩
    have hu : 0 ≤ κ * (1 + s) := by positivity
    have h := Real.pow_div_factorial_le_exp (κ * (1 + s)) hu (k + 1)
    rw [mul_pow, show κ * (1 + s) = κ + κ * s by ring, Real.exp_add] at h
    have hf : (0 : ℝ) < ((k + 1).factorial : ℝ) := by exact_mod_cast Nat.factorial_pos _
    have hk : 0 < κ ^ (k + 1) := pow_pos hκ _
    rw [div_le_iff₀ hf] at h
    rw [div_mul_eq_mul_div, le_div_iff₀ hk]
    nlinarith
  
  obtain ⟨M, hM⟩ : ∃ M : ℝ, ∀ y : ℝ, (1 + |y|) ^ k * |w y| ≤ M := by
    refine ⟨2 ^ k * ((Finset.Iic (k, 0)).sup fun m => SchwartzMap.seminorm ℝ m.1 m.2) w,
      fun y => ?_⟩
    have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (k, 0)) (le_refl k) (le_refl 0) w y
    rwa [norm_iteratedFDeriv_zero, Real.norm_eq_abs, Real.norm_eq_abs] at h
  have hM0 : 0 ≤ M := le_trans (by positivity) (hM 0)
  have hpe : ∀ x s : ℝ, 0 ≤ s →
      (1 + |x|) ^ k * |∫ y in (x - s)..x, w y| ≤ M * (1 + s) ^ (k + 1) := by
    intro x s hs
    have hb : ∀ y ∈ Set.uIoc (x - s) x, ‖(1 + |x|) ^ k * w y‖ ≤ M * (1 + s) ^ k := by
      intro y hy
      rw [Set.uIoc_of_le (by linarith)] at hy
      obtain ⟨hy1, hy2⟩ := hy
      have hxy : |x| ≤ |y| + s := by
        have := abs_sub_abs_le_abs_sub x y
        rw [abs_of_nonneg (show 0 ≤ x - y by linarith)] at this
        linarith
      have h1 : 1 + |x| ≤ (1 + |y|) * (1 + s) := by nlinarith [abs_nonneg y]
      have h2 : (1 + |x|) ^ k ≤ (1 + |y|) ^ k * (1 + s) ^ k := by
        rw [← mul_pow]; exact pow_le_pow_left₀ (by positivity) h1 k
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ (1 + |x|) ^ k)]
      calc (1 + |x|) ^ k * |w y| ≤ (1 + |y|) ^ k * (1 + s) ^ k * |w y| :=
            mul_le_mul_of_nonneg_right h2 (abs_nonneg _)
        _ = (1 + s) ^ k * ((1 + |y|) ^ k * |w y|) := by ring
        _ ≤ (1 + s) ^ k * M := mul_le_mul_of_nonneg_left (hM y) (by positivity)
        _ = M * (1 + s) ^ k := by ring
    have h := intervalIntegral.norm_integral_le_of_norm_le_const hb
    rw [intervalIntegral.integral_const_mul, Real.norm_eq_abs, abs_mul,
      abs_of_nonneg (by positivity : (0 : ℝ) ≤ (1 + |x|) ^ k),
      show x - (x - s) = s by ring, abs_of_nonneg hs] at h
    have hMs : 0 ≤ M * (1 + s) ^ k := mul_nonneg hM0 (by positivity)
    calc _ ≤ M * (1 + s) ^ k * s := h
      _ ≤ M * (1 + s) ^ k * (1 + s) := mul_le_mul_of_nonneg_left (by linarith) hMs
      _ = M * (1 + s) ^ (k + 1) := by ring
  
  have hwi : Integrable (fun y => |w y|) := (w.integrable).abs
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = ∫ y, |w y| := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by rw [hA]; exact integral_nonneg fun _ => abs_nonneg _
  have hI : ∀ x s : ℝ, 0 ≤ s → |∫ y in (x - s)..x, w y| ≤ A := by
    intro x s hs
    have hab : x - s ≤ x := by linarith
    rw [hA]
    calc |∫ y in (x - s)..x, w y| ≤ ∫ y in (x - s)..x, |w y| :=
          intervalIntegral.abs_integral_le_integral_abs hab
      _ = ∫ y in Set.Ioc (x - s) x, |w y| := intervalIntegral.integral_of_le hab
      _ ≤ ∫ y, |w y| :=
          setIntegral_le_integral hwi (Filter.Eventually.of_forall fun y => abs_nonneg _)
  
  have h2κ : 0 < 2 * κ := by linarith
  have hexpint : IntegrableOn (fun s : ℝ => Real.exp (-2 * κ * s)) (Set.Ioi 0) := by
    refine (exp_neg_integrableOn_Ioi 0 h2κ).congr_fun (fun s _ => ?_) measurableSet_Ioi
    show Real.exp (-(2 * κ) * s) = Real.exp (-2 * κ * s)
    congr 1
    ring
  have hexpint1 : IntegrableOn (fun s : ℝ => Real.exp (-κ * s)) (Set.Ioi 0) :=
    exp_neg_integrableOn_Ioi 0 hκ
  have hexpval : ∫ s in Set.Ioi (0 : ℝ), Real.exp (-2 * κ * s) = 1 / (2 * κ) := by
    rw [integral_exp_mul_Ioi (by linarith : -2 * κ < 0) 0, mul_zero, Real.exp_zero,
      show (-2 * κ) = -(2 * κ) by ring, neg_div_neg_eq]
  have hexpval1 : ∫ s in Set.Ioi (0 : ℝ), Real.exp (-κ * s) = 1 / κ := by
    rw [integral_exp_mul_Ioi (by linarith : -κ < 0) 0, mul_zero, Real.exp_zero, neg_div_neg_eq]
  have hii : ∀ a b : ℝ, IntervalIntegrable (fun y => w y) volume a b :=
    fun a b => w.continuous.intervalIntegrable a b
  have hWc : Continuous fun b => ∫ y in (0 : ℝ)..b, w y :=
    intervalIntegral.continuous_primitive hii 0
  
  refine ⟨2 * Real.exp (2 * A) * M * P / κ, fun x => ?_⟩
  have hIeq : ∀ s : ℝ, (∫ y in (x - s)..x, w y) =
      (∫ y in (0 : ℝ)..x, w y) - ∫ y in (0 : ℝ)..(x - s), w y :=
    fun s => (intervalIntegral.integral_interval_sub_left (hii 0 x) (hii 0 (x - s))).symm
  have hcont : Continuous fun s : ℝ => Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y) := by
    have hfe : (fun s : ℝ => Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y)) =
        fun s => Real.exp (-2 * κ * s +
          2 * ((∫ y in (0 : ℝ)..x, w y) - ∫ y in (0 : ℝ)..(x - s), w y)) := by
      funext s; rw [hIeq s]
    rw [hfe]
    have hc2 : Continuous fun s : ℝ => ∫ y in (0 : ℝ)..(x - s), w y :=
      hWc.comp (continuous_const.sub continuous_id)
    exact Real.continuous_exp.comp ((continuous_const.mul continuous_id).add
      (continuous_const.mul (continuous_const.sub hc2)))
  have hint : IntegrableOn
      (fun s : ℝ => Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y)) (Set.Ioi 0) := by
    refine Integrable.mono' (Integrable.const_mul hexpint (Real.exp (2 * A)))
      hcont.aestronglyMeasurable ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with s hs
    show ‖Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y)‖ ≤
      Real.exp (2 * A) * Real.exp (-2 * κ * s)
    rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), ← Real.exp_add]
    apply Real.exp_le_exp.2
    have := (abs_le.1 (hI x s (le_of_lt hs))).2
    linarith
  obtain ⟨c, hcdef⟩ : ∃ c : ℝ, c = (1 + |x|) ^ k := ⟨_, rfl⟩
  have hc0 : 0 ≤ c := by rw [hcdef]; positivity
  have hb : ∀ s ∈ Set.Ioi (0 : ℝ),
      ‖c * (Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y) - Real.exp (-2 * κ * s))‖ ≤
        2 * Real.exp (2 * A) * M * P * Real.exp (-κ * s) := by
    intro s hs
    have hs0 : 0 ≤ s := le_of_lt hs
    obtain ⟨I, hIdef⟩ : ∃ I : ℝ, I = ∫ y in (x - s)..x, w y := ⟨_, rfl⟩
    rw [← hIdef]
    have hIA : |I| ≤ A := by rw [hIdef]; exact hI x s hs0
    have hcI : c * |I| ≤ M * (1 + s) ^ (k + 1) := by rw [hIdef, hcdef]; exact hpe x s hs0
    have hE : 0 < Real.exp (-2 * κ * s) := Real.exp_pos _
    have hsplit : Real.exp (-2 * κ * s + 2 * I) - Real.exp (-2 * κ * s) =
        Real.exp (-2 * κ * s) * (Real.exp (2 * I) - 1) := by rw [Real.exp_add]; ring
    have h3 := hexp1 (2 * I)
    rw [abs_mul, abs_two] at h3
    have h4 : Real.exp (2 * |I|) ≤ Real.exp (2 * A) := Real.exp_le_exp.2 (by linarith)
    have h5 : |Real.exp (2 * I) - 1| ≤ 2 * |I| * Real.exp (2 * A) :=
      le_trans h3 (mul_le_mul_of_nonneg_left h4 (by positivity))
    have h6 : c * |I| ≤ M * P * Real.exp (κ * s) := by
      refine le_trans hcI ?_
      rw [mul_assoc]
      exact mul_le_mul_of_nonneg_left (hpoly s hs0) hM0
    have h7 : Real.exp (-2 * κ * s) * Real.exp (κ * s) = Real.exp (-κ * s) := by
      rw [← Real.exp_add]; congr 1; ring
    rw [hsplit, Real.norm_eq_abs, abs_mul, abs_mul, abs_of_nonneg hc0, abs_of_pos hE]
    calc c * (Real.exp (-2 * κ * s) * |Real.exp (2 * I) - 1|)
        ≤ c * (Real.exp (-2 * κ * s) * (2 * |I| * Real.exp (2 * A))) := by gcongr
      _ = 2 * Real.exp (2 * A) * Real.exp (-2 * κ * s) * (c * |I|) := by ring
      _ ≤ 2 * Real.exp (2 * A) * Real.exp (-2 * κ * s) * (M * P * Real.exp (κ * s)) := by
          gcongr
      _ = 2 * Real.exp (2 * A) * M * P * (Real.exp (-2 * κ * s) * Real.exp (κ * s)) := by ring
      _ = 2 * Real.exp (2 * A) * M * P * Real.exp (-κ * s) := by rw [h7]
  have hdiff : (∫ s in Set.Ioi (0 : ℝ),
      c * (Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y) - Real.exp (-2 * κ * s))) =
        c * (rgreen κ w x - 1 / (2 * κ)) := by
    rw [integral_const_mul, integral_sub hint hexpint, hexpval]
    rfl
  have hnorm := norm_integral_le_of_norm_le
    (hexpint1.const_mul (2 * Real.exp (2 * A) * M * P))
    (by
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with s hs
      exact hb s hs)
  rw [hdiff, integral_const_mul, hexpval1, Real.norm_eq_abs, abs_mul, abs_of_nonneg hc0] at hnorm
  have hxk : |x| ^ k ≤ c := by
    rw [hcdef]; exact pow_le_pow_left₀ (abs_nonneg x) (by linarith) k
  calc |x| ^ k * |rgreen κ w x - 1 / (2 * κ)| ≤ c * |rgreen κ w x - 1 / (2 * κ)| :=
        mul_le_mul_of_nonneg_right hxk (abs_nonneg _)
    _ ≤ 2 * Real.exp (2 * A) * M * P * (1 / κ) := hnorm
    _ = 2 * Real.exp (2 * A) * M * P / κ := by ring

theorem schwartz_of_linear_ode (c : ℝ) (a b : 𝓢(ℝ, ℝ)) (g : ℝ → ℝ)
    (hg : ∀ x : ℝ, HasDerivAt g ((c + a x) * g x + b x) x)
    (hdec : ∀ k : ℕ, ∃ C : ℝ, ∀ x : ℝ, |x| ^ k * |g x| ≤ C) :
    ∃ γ : 𝓢(ℝ, ℝ), ∀ x : ℝ, γ x = g x :=
by
  have hdiff : Differentiable ℝ g := fun x => (hg x).differentiableAt
  have hD : deriv g = fun x => (c + a x) * g x + b x := funext fun x => (hg x).deriv
  have ha : ∀ n : ℕ, ContDiff ℝ n (a : ℝ → ℝ) := fun n => contDiff_infty.1 (a.smooth ⊤) n
  have hb : ∀ n : ℕ, ContDiff ℝ n (b : ℝ → ℝ) := fun n => contDiff_infty.1 (b.smooth ⊤) n
  
  have hsm : ∀ n : ℕ, ContDiff ℝ n g := by
    intro n
    induction n with
    | zero => exact contDiff_zero.2 hdiff.continuous
    | succ n ih =>
      rw [Nat.cast_succ, contDiff_succ_iff_deriv]
      refine ⟨hdiff, fun h => absurd h (by simp), ?_⟩
      rw [hD]
      exact ((contDiff_const.add (ha n)).mul ih).add (hb n)
  
  have hrec : ∀ (n : ℕ) (x : ℝ), |iteratedDeriv (n + 1) g x| ≤
      |c| * |iteratedDeriv n g x|
        + ∑ i ∈ Finset.range (n + 1),
            (n.choose i : ℝ) * |iteratedDeriv i (a : ℝ → ℝ) x| * |iteratedDeriv (n - i) g x|
        + |iteratedDeriv n (b : ℝ → ℝ) x| := by
    intro n x
    have hD' : deriv g = ((fun y => c * g y) + ((a : ℝ → ℝ) * g)) + (b : ℝ → ℝ) := by
      rw [hD]; funext y; simp only [Pi.add_apply, Pi.mul_apply]; ring
    have cg : ContDiffAt ℝ n g x := (hsm n).contDiffAt
    have ca : ContDiffAt ℝ n (a : ℝ → ℝ) x := (ha n).contDiffAt
    have cb : ContDiffAt ℝ n (b : ℝ → ℝ) x := (hb n).contDiffAt
    have c1 : ContDiffAt ℝ n (fun y => c * g y) x := (contDiff_const.mul (hsm n)).contDiffAt
    have cm : ContDiffAt ℝ n ((a : ℝ → ℝ) * g) x := ((ha n).mul (hsm n)).contDiffAt
    have cs : ContDiffAt ℝ n ((fun y => c * g y) + ((a : ℝ → ℝ) * g)) x := c1.add cm
    rw [iteratedDeriv_succ', hD', iteratedDeriv_add cs cb, iteratedDeriv_add c1 cm,
      iteratedDeriv_const_mul cg, iteratedDeriv_mul ca cg]
    have hS : |∑ i ∈ Finset.range (n + 1),
        (n.choose i : ℝ) * iteratedDeriv i (a : ℝ → ℝ) x * iteratedDeriv (n - i) g x| ≤
        ∑ i ∈ Finset.range (n + 1),
          (n.choose i : ℝ) * |iteratedDeriv i (a : ℝ → ℝ) x| * |iteratedDeriv (n - i) g x| := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans (le_of_eq (Finset.sum_congr rfl fun i _ => ?_))
      rw [abs_mul, abs_mul, Nat.abs_cast]
    have hB : |c * iteratedDeriv n g x| = |c| * |iteratedDeriv n g x| := abs_mul _ _
    have a1 := le_abs_self (iteratedDeriv n (b : ℝ → ℝ) x)
    have a2 := neg_abs_le (iteratedDeriv n (b : ℝ → ℝ) x)
    have b1 := le_abs_self (c * iteratedDeriv n g x)
    have b2 := neg_abs_le (c * iteratedDeriv n g x)
    have s1 := le_abs_self (∑ i ∈ Finset.range (n + 1),
        (n.choose i : ℝ) * iteratedDeriv i (a : ℝ → ℝ) x * iteratedDeriv (n - i) g x)
    have s2 := neg_abs_le (∑ i ∈ Finset.range (n + 1),
        (n.choose i : ℝ) * iteratedDeriv i (a : ℝ → ℝ) x * iteratedDeriv (n - i) g x)
    rw [abs_le]
    constructor <;> linarith
  
  have hA : ∀ i : ℕ, ∃ A : ℝ, 0 ≤ A ∧ ∀ x : ℝ, |iteratedDeriv i (a : ℝ → ℝ) x| ≤ A := by
    intro i
    obtain ⟨C, hC⟩ := a.decay 0 i
    refine ⟨max C 0, le_max_right _ _, fun x => ?_⟩
    have := hC.2 x
    simp only [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, pow_zero,
      one_mul] at this
    exact this.trans (le_max_left _ _)
  choose Aa hAa0 hAa using hA
  have hbd : ∀ n k : ℕ, ∃ C : ℝ, ∀ x : ℝ, |x| ^ k * |iteratedDeriv n (b : ℝ → ℝ) x| ≤ C := by
    intro n k
    obtain ⟨C, hC⟩ := b.decay k n
    refine ⟨C, fun x => ?_⟩
    have := hC.2 x
    rwa [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, Real.norm_eq_abs] at this
  
  have hQ : ∀ m k : ℕ, ∃ D : ℝ, 0 ≤ D ∧
      ∀ j ≤ m, ∀ x : ℝ, |x| ^ k * |iteratedDeriv j g x| ≤ D := by
    intro m
    induction m with
    | zero =>
      intro k
      obtain ⟨C, hC⟩ := hdec k
      refine ⟨max C 0, le_max_right _ _, fun j hj x => ?_⟩
      have hj0 : j = 0 := Nat.le_zero.1 hj
      subst hj0
      simp only [iteratedDeriv_zero]
      exact (hC x).trans (le_max_left _ _)
    | succ m ih =>
      intro k
      obtain ⟨Dk, hDk0, hDk⟩ := ih k
      obtain ⟨Cb, hCb⟩ := hbd m k
      refine ⟨max Dk (|c| * Dk + ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * Aa i * Dk + Cb),
        le_trans hDk0 (le_max_left _ _), fun j hj x => ?_⟩
      rcases Nat.lt_or_ge j (m + 1) with hjm | hjm
      · exact (hDk j (Nat.le_of_lt_succ hjm) x).trans (le_max_left _ _)
      · have hj' : j = m + 1 := le_antisymm hj hjm
        subst hj'
        refine le_trans ?_ (le_max_right _ _)
        have hxk : 0 ≤ |x| ^ k := pow_nonneg (abs_nonneg x) k
        have h1 := mul_le_mul_of_nonneg_left (hrec m x) hxk
        have h2 := hCb x
        have h3 : |x| ^ k * |iteratedDeriv m g x| ≤ Dk := hDk m le_rfl x
        have h4 : |x| ^ k * ∑ i ∈ Finset.range (m + 1),
            (m.choose i : ℝ) * |iteratedDeriv i (a : ℝ → ℝ) x| * |iteratedDeriv (m - i) g x| ≤
            ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * Aa i * Dk := by
          rw [Finset.mul_sum]
          refine Finset.sum_le_sum fun i _ => ?_
          have e1 := hAa i x
          have e2 : |x| ^ k * |iteratedDeriv (m - i) g x| ≤ Dk := hDk (m - i) (Nat.sub_le m i) x
          have e3 : |iteratedDeriv i (a : ℝ → ℝ) x| * (|x| ^ k * |iteratedDeriv (m - i) g x|) ≤
              Aa i * Dk :=
            mul_le_mul e1 e2 (mul_nonneg hxk (abs_nonneg _)) (hAa0 i)
          have e4 := mul_le_mul_of_nonneg_left e3
            (Nat.cast_nonneg (m.choose i) : (0 : ℝ) ≤ m.choose i)
          calc |x| ^ k * ((m.choose i : ℝ) * |iteratedDeriv i (a : ℝ → ℝ) x|
                * |iteratedDeriv (m - i) g x|)
              = (m.choose i : ℝ) * (|iteratedDeriv i (a : ℝ → ℝ) x|
                * (|x| ^ k * |iteratedDeriv (m - i) g x|)) := by ring
            _ ≤ (m.choose i : ℝ) * (Aa i * Dk) := e4
            _ = (m.choose i : ℝ) * Aa i * Dk := by ring
        have h5 : |x| ^ k * (|c| * |iteratedDeriv m g x|) ≤ |c| * Dk := by
          calc |x| ^ k * (|c| * |iteratedDeriv m g x|)
              = |c| * (|x| ^ k * |iteratedDeriv m g x|) := by ring
            _ ≤ |c| * Dk := mul_le_mul_of_nonneg_left h3 (abs_nonneg c)
        rw [mul_add, mul_add] at h1
        linarith
  
  refine ⟨⟨g, contDiff_infty.2 hsm, fun k n => ?_⟩, fun x => rfl⟩
  obtain ⟨D, -, hDn⟩ := hQ n k
  refine ⟨D, fun x => ?_⟩
  rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, Real.norm_eq_abs]
  exact hDn n le_rfl x

theorem rgreen_schwartz_package (κ : ℝ) (hκ : 0 < κ) (w : 𝓢(ℝ, ℝ)) :
    (∀ x : ℝ, HasDerivAt (rgreen κ w) (2 * (w x - κ) * rgreen κ w x + 1) x) ∧
    (∀ x : ℝ, HasDerivAt (rgreenR κ w) (2 * (κ - w x) * rgreenR κ w x - 1) x) ∧
    (∃ γ : 𝓢(ℝ, ℝ), ∀ x : ℝ, γ x = rgreen κ w x - 1 / (2 * κ)) ∧
    (∃ γ : 𝓢(ℝ, ℝ), ∀ x : ℝ, γ x = rgreenR κ w x - 1 / (2 * κ)) ∧
    (∃ m : ℝ, 0 < m ∧ ∀ x : ℝ, m ≤ rgreen κ w x) :=
by
  classical
  
  have hneg : ∀ v : 𝓢(ℝ, ℝ), ∃ v' : 𝓢(ℝ, ℝ), ∀ y : ℝ, v' y = v (-y) := by
    intro v
    refine ⟨SchwartzMap.compCLMOfContinuousLinearEquiv ℝ (ContinuousLinearEquiv.neg ℝ) v,
      fun y => ?_⟩
    rw [SchwartzMap.compCLMOfContinuousLinearEquiv_apply]
    rfl
  obtain ⟨w', hw'⟩ := hneg w
  
  have hrefl : ∀ x : ℝ, rgreenR κ w x = rgreen κ w' (-x) := by
    intro x
    unfold rgreen rgreenR
    congr 1
    funext s
    have hI : (∫ y in (-x - s)..(-x), w' y) = ∫ y in x..(x + s), w y := by
      simp only [hw']
      rw [intervalIntegral.integral_comp_neg (fun y => w y)]
      have e1 : -(-x - s) = x + s := by ring
      rw [neg_neg, e1]
    rw [hI]
  
  have hoff : ∀ v : 𝓢(ℝ, ℝ), ∃ γ : 𝓢(ℝ, ℝ), ∀ x : ℝ, γ x = rgreen κ v x - 1 / (2 * κ) := by
    intro v
    have hd : ∀ x : ℝ, HasDerivAt (fun x => rgreen κ v x - 1 / (2 * κ))
        ((-2 * κ + ((2 : ℝ) • v) x) * (rgreen κ v x - 1 / (2 * κ)) + ((1 / κ) • v) x) x := by
      intro x
      have h := (rgreen_hasDerivAt κ hκ v x).sub_const (1 / (2 * κ))
      refine h.congr_deriv ?_
      simp only [SchwartzMap.smul_apply, smul_eq_mul]
      field_simp
      ring
    exact schwartz_of_linear_ode (-2 * κ) ((2 : ℝ) • v) ((1 / κ) • v)
      (fun x => rgreen κ v x - 1 / (2 * κ)) hd (rgreen_offset_decay κ hκ v)
  
  have hD2 : ∀ x : ℝ, HasDerivAt (rgreenR κ w) (2 * (κ - w x) * rgreenR κ w x - 1) x := by
    intro x
    have h := (rgreen_hasDerivAt κ hκ w' (-x)).comp x (hasDerivAt_neg x)
    have e : (2 * (w' (-x) - κ) * rgreen κ w' (-x) + 1) * (-1) =
        2 * (κ - w x) * rgreenR κ w x - 1 := by
      rw [hw', neg_neg, hrefl]; ring
    have hfun : rgreenR κ w = fun x => rgreen κ w' (-x) := funext hrefl
    rw [← e, hfun]
    exact h
  
  have hO2 : ∃ γ : 𝓢(ℝ, ℝ), ∀ x : ℝ, γ x = rgreenR κ w x - 1 / (2 * κ) := by
    obtain ⟨γ', hγ'⟩ := hoff w'
    obtain ⟨γ, hγ⟩ := hneg γ'
    exact ⟨γ, fun x => by rw [hγ, hγ', hrefl]⟩
  
  have hlow : ∃ m : ℝ, 0 < m ∧ ∀ x : ℝ, m ≤ rgreen κ w x := by
    have hwi : Integrable (fun y => |w y|) := (w.integrable).abs
    obtain ⟨A, hA⟩ : ∃ A : ℝ, A = ∫ y, |w y| := ⟨_, rfl⟩
    have hT2 : ∀ a b : ℝ, a ≤ b → |∫ y in a..b, w y| ≤ A := by
      intro a b hab
      rw [hA]
      calc |∫ y in a..b, w y| ≤ ∫ y in a..b, |w y| :=
            intervalIntegral.abs_integral_le_integral_abs hab
        _ = ∫ y in Set.Ioc a b, |w y| := intervalIntegral.integral_of_le hab
        _ ≤ ∫ y, |w y| :=
            setIntegral_le_integral hwi (Filter.Eventually.of_forall fun y => abs_nonneg _)
    have hii : ∀ a b : ℝ, IntervalIntegrable (fun y => w y) volume a b :=
      fun a b => w.continuous.intervalIntegrable a b
    have hWc : Continuous fun b => ∫ y in (0 : ℝ)..b, w y :=
      intervalIntegral.continuous_primitive hii 0
    have h2κ : 0 < 2 * κ := by linarith
    have hexpint : IntegrableOn (fun s : ℝ => Real.exp (-2 * κ * s)) (Set.Ioi 0) := by
      refine (exp_neg_integrableOn_Ioi 0 h2κ).congr_fun (fun s _ => ?_) measurableSet_Ioi
      show Real.exp (-(2 * κ) * s) = Real.exp (-2 * κ * s)
      congr 1
      ring
    have hexpval : ∫ s in Set.Ioi (0 : ℝ), Real.exp (-2 * κ * s) = 1 / (2 * κ) := by
      rw [integral_exp_mul_Ioi (by linarith : -2 * κ < 0) 0, mul_zero, Real.exp_zero,
        show (-2 * κ) = -(2 * κ) by ring, neg_div_neg_eq]
    refine ⟨Real.exp (-2 * A) / (2 * κ), by positivity, fun x => ?_⟩
    have hIeq : ∀ s : ℝ, (∫ y in (x - s)..x, w y) =
        (∫ y in (0 : ℝ)..x, w y) - ∫ y in (0 : ℝ)..(x - s), w y :=
      fun s => (intervalIntegral.integral_interval_sub_left (hii 0 x) (hii 0 (x - s))).symm
    have hcont : Continuous fun s : ℝ => Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y) := by
      have hfe : (fun s : ℝ => Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y)) =
          fun s => Real.exp (-2 * κ * s +
            2 * ((∫ y in (0 : ℝ)..x, w y) - ∫ y in (0 : ℝ)..(x - s), w y)) := by
        funext s; rw [hIeq s]
      rw [hfe]
      have hc2 : Continuous fun s : ℝ => ∫ y in (0 : ℝ)..(x - s), w y :=
        hWc.comp (continuous_const.sub continuous_id)
      exact Real.continuous_exp.comp ((continuous_const.mul continuous_id).add
        (continuous_const.mul (continuous_const.sub hc2)))
    have hbd : ∀ s ∈ Set.Ioi (0 : ℝ), |∫ y in (x - s)..x, w y| ≤ A := by
      intro s hs
      have hs' : 0 < s := hs
      exact hT2 _ _ (by linarith)
    have hint : IntegrableOn
        (fun s : ℝ => Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y)) (Set.Ioi 0) := by
      refine Integrable.mono' (Integrable.const_mul hexpint (Real.exp (2 * A)))
        hcont.aestronglyMeasurable ?_
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with s hs
      show ‖Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y)‖ ≤
        Real.exp (2 * A) * Real.exp (-2 * κ * s)
      rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), ← Real.exp_add]
      apply Real.exp_le_exp.2
      have := (abs_le.1 (hbd s hs)).2
      linarith
    have hmono := setIntegral_mono_on (Integrable.const_mul hexpint (Real.exp (-2 * A))) hint
      measurableSet_Ioi (fun s hs => by
        show Real.exp (-2 * A) * Real.exp (-2 * κ * s) ≤
          Real.exp (-2 * κ * s + 2 * ∫ y in (x - s)..x, w y)
        rw [← Real.exp_add]
        apply Real.exp_le_exp.2
        have := (abs_le.1 (hbd s hs)).1
        linarith)
    rw [integral_const_mul, hexpval] at hmono
    unfold rgreen
    calc Real.exp (-2 * A) / (2 * κ) = Real.exp (-2 * A) * (1 / (2 * κ)) := by ring
      _ ≤ _ := hmono
  exact ⟨rgreen_hasDerivAt κ hκ w, hD2, hoff w, hO2, hlow⟩

theorem greenODE_of_riccati_first_order (κ : ℝ) (hκ : 0 < κ) (w γ q : 𝓢(ℝ, ℝ))
    (hγ : ∀ x : ℝ, HasDerivAt (γ : ℝ → ℝ) (2 * (w x - κ) * (1 / (2 * κ) + γ x) + 1) x)
    (hq : ∀ x : ℝ, q x = deriv (w : ℝ → ℝ) x - 2 * κ * w x + w x ^ 2) :
    GreenODE κ q γ :=
by
  unfold GreenODE
  intro x
  have hg1 : ∀ y, HasDerivAt (fun y => 1 / (2 * κ) + γ y)
      (2 * (w y - κ) * (1 / (2 * κ) + γ y) + 1) y :=
    fun y => (hγ y).const_add (1 / (2 * κ))
  have hdg : deriv (fun y => 1 / (2 * κ) + γ y) =
      fun y => 2 * (w y - κ) * (1 / (2 * κ) + γ y) + 1 :=
    funext fun y => (hg1 y).deriv
  have hdu : deriv (w : ℝ → ℝ) = (SchwartzMap.derivCLM ℝ ℝ w : ℝ → ℝ) :=
    funext fun y => by rw [SchwartzMap.derivCLM_apply]
  have hw1 : ∀ y, HasDerivAt (w : ℝ → ℝ) (deriv (w : ℝ → ℝ) y) y :=
    fun y => w.differentiableAt.hasDerivAt
  have hw2 : ∀ y, HasDerivAt (deriv (w : ℝ → ℝ)) (deriv (deriv (w : ℝ → ℝ)) y) y := by
    intro y
    have hdiff : DifferentiableAt ℝ (deriv (w : ℝ → ℝ)) y := by
      rw [hdu]
      exact (SchwartzMap.derivCLM ℝ ℝ w).differentiableAt
    exact hdiff.hasDerivAt
  have hg2 : ∀ y, HasDerivAt (fun y => 2 * (w y - κ) * (1 / (2 * κ) + γ y) + 1)
      (2 * deriv (w : ℝ → ℝ) y * (1 / (2 * κ) + γ y)
        + 2 * (w y - κ) * (2 * (w y - κ) * (1 / (2 * κ) + γ y) + 1)) y := by
    intro y
    have h := ((((hw1 y).sub_const κ).const_mul 2).mul (hg1 y)).add_const 1
    exact h.congr_deriv (by ring)
  have hdg2 : deriv (fun y => 2 * (w y - κ) * (1 / (2 * κ) + γ y) + 1) =
      fun y => 2 * deriv (w : ℝ → ℝ) y * (1 / (2 * κ) + γ y)
        + 2 * (w y - κ) * (2 * (w y - κ) * (1 / (2 * κ) + γ y) + 1) :=
    funext fun y => (hg2 y).deriv
  have hg3 : HasDerivAt (fun y => 2 * deriv (w : ℝ → ℝ) y * (1 / (2 * κ) + γ y)
        + 2 * (w y - κ) * (2 * (w y - κ) * (1 / (2 * κ) + γ y) + 1)) _ x :=
    (((hw2 x).const_mul 2).mul (hg1 x)).add ((((hw1 x).sub_const κ).const_mul 2).mul (hg2 x))
  have hqf : (q : ℝ → ℝ) = fun y => deriv (w : ℝ → ℝ) y - 2 * κ * w y + w y ^ 2 := funext hq
  have hq1 : HasDerivAt (q : ℝ → ℝ)
      (deriv (deriv (w : ℝ → ℝ)) x - 2 * κ * deriv (w : ℝ → ℝ) x
        + 2 * w x * deriv (w : ℝ → ℝ) x) x := by
    rw [hqf]
    have h := ((hw2 x).sub ((hw1 x).const_mul (2 * κ))).add ((hw1 x).pow 2)
    refine h.congr_deriv ?_
    norm_num
  have hqg : HasDerivAt (fun y => q y * (1 / (2 * κ) + γ y)) _ x := hq1.mul (hg1 x)
  rw [iteratedDeriv_succ, iteratedDeriv_succ, iteratedDeriv_one, hdg, hdg2, hg3.deriv,
    hqg.deriv, hq x]
  ring

theorem green_unique_of_pos (κ : ℝ) (hκ : 0 < κ) (q γ₀ γ : 𝓢(ℝ, ℝ))
    (h₀ : GreenODE κ q γ₀) (h : GreenODE κ q γ)
    (hpos : ∃ m : ℝ, 0 < m ∧ ∀ x : ℝ, m ≤ 1 / (2 * κ) + γ₀ x) :
    γ = γ₀ :=
by
  obtain ⟨m, hm, hmG⟩ := hpos
  have hκ0 : κ ≠ 0 := hκ.ne'
  have hL : (1 / (2 * κ) : ℝ) ≠ 0 := by positivity
  
  have hderiv : ∀ f : 𝓢(ℝ, ℝ), ∀ x : ℝ,
      HasDerivAt (f : ℝ → ℝ) (SchwartzMap.derivCLM ℝ ℝ f x) x := by
    intro f x
    rw [SchwartzMap.derivCLM_apply]
    exact f.differentiableAt.hasDerivAt
  have hderivfun : ∀ f : 𝓢(ℝ, ℝ),
      deriv (f : ℝ → ℝ) = (SchwartzMap.derivCLM ℝ ℝ f : ℝ → ℝ) := by
    intro f; funext x; rw [SchwartzMap.derivCLM_apply]
  have hlim : ∀ f : 𝓢(ℝ, ℝ), Filter.Tendsto (f : ℝ → ℝ) Filter.atTop (nhds 0) ∧
      Filter.Tendsto (f : ℝ → ℝ) Filter.atBot (nhds 0) := by
    intro f
    have h := ZeroAtInftyContinuousMapClass.zero_at_infty f
    exact ⟨h.mono_left atTop_le_cocompact, h.mono_left atBot_le_cocompact⟩
  
  have hexp : ∀ g : 𝓢(ℝ, ℝ), GreenODE κ q g → ∀ x : ℝ,
      SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ g)) x =
        2 * SchwartzMap.derivCLM ℝ ℝ q x * (1 / (2 * κ) + g x)
          + 4 * (q x + κ ^ 2) * SchwartzMap.derivCLM ℝ ℝ g x := by
    intro g hg x
    have h1 : deriv (fun y => 1 / (2 * κ) + g y) = (SchwartzMap.derivCLM ℝ ℝ g : ℝ → ℝ) := by
      funext y; rw [deriv_const_add, SchwartzMap.derivCLM_apply]
    have h3 : iteratedDeriv 3 (fun y => 1 / (2 * κ) + g y) x =
        SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ g)) x := by
      rw [iteratedDeriv_succ, iteratedDeriv_succ, iteratedDeriv_one, h1, hderivfun, hderivfun]
    have hm' : deriv (fun y => q y * (1 / (2 * κ) + g y)) x =
        SchwartzMap.derivCLM ℝ ℝ q x * (1 / (2 * κ) + g x)
          + q x * SchwartzMap.derivCLM ℝ ℝ g x :=
      ((hderiv q x).mul ((hderiv g x).const_add (1 / (2 * κ)))).deriv
    have := hg x
    rw [h3, hm', h1] at this
    linarith
  
  have const_lim : ∀ (Φ : ℝ → ℝ) (L : ℝ), (∀ x, HasDerivAt Φ 0 x) →
      Filter.Tendsto Φ Filter.atTop (nhds L) → ∀ x, Φ x = L := by
    intro Φ L hΦ hl x
    have hc := is_const_of_deriv_eq_zero (fun y => (hΦ y).differentiableAt)
      (fun y => (hΦ y).deriv)
    exact tendsto_nhds_unique (tendsto_const_nhds.congr (fun y => hc x y)) hl
  
  have hIconst : ∀ (G G1 G2 G3 p p1 : ℝ → ℝ),
      (∀ x, HasDerivAt G (G1 x) x) → (∀ x, HasDerivAt G1 (G2 x) x) →
      (∀ x, HasDerivAt G2 (G3 x) x) → (∀ x, HasDerivAt p (p1 x) x) →
      (∀ x, G3 x = 2 * p1 x * G x + 4 * (p x + κ ^ 2) * G1 x) →
      Filter.Tendsto G Filter.atTop (nhds (1 / (2 * κ))) →
      Filter.Tendsto G1 Filter.atTop (nhds 0) →
      Filter.Tendsto G2 Filter.atTop (nhds 0) → Filter.Tendsto p Filter.atTop (nhds 0) →
      ∀ x, 2 * G x * G2 x - G1 x * G1 x - 4 * (p x + κ ^ 2) * (G x * G x) = -1 := by
    intro G G1 G2 G3 p p1 hG hG1 hG2 hp hode hGt hG1t hG2t hpt
    refine const_lim
      (fun x => 2 * G x * G2 x - G1 x * G1 x - 4 * (p x + κ ^ 2) * (G x * G x)) (-1) ?_ ?_
    · intro x
      have := ((((hG x).const_mul 2).mul (hG2 x)).sub ((hG1 x).mul (hG1 x))).sub
        ((((hp x).add_const (κ ^ 2)).const_mul 4).mul ((hG x).mul (hG x)))
      refine this.congr_deriv ?_
      simp only [Pi.mul_apply]
      linear_combination (2 * G x) * hode x
    · have := (((hGt.const_mul 2).mul hG2t).sub (hG1t.mul hG1t)).sub
        (((hpt.add_const (κ ^ 2)).const_mul 4).mul (hGt.mul hGt))
      have e : 2 * (1 / (2 * κ)) * 0 - 0 * 0 - 4 * (0 + κ ^ 2) * (1 / (2 * κ) * (1 / (2 * κ)))
          = (-1 : ℝ) := by
        field_simp
        ring
      rw [e] at this
      exact this
  
  have hBzero : ∀ (G G1 G2 G3 D D1 D2 D3 p p1 : ℝ → ℝ),
      (∀ x, HasDerivAt G (G1 x) x) → (∀ x, HasDerivAt G1 (G2 x) x) →
      (∀ x, HasDerivAt G2 (G3 x) x) →
      (∀ x, HasDerivAt D (D1 x) x) → (∀ x, HasDerivAt D1 (D2 x) x) →
      (∀ x, HasDerivAt D2 (D3 x) x) → (∀ x, HasDerivAt p (p1 x) x) →
      (∀ x, G3 x = 2 * p1 x * G x + 4 * (p x + κ ^ 2) * G1 x) →
      (∀ x, D3 x = 2 * p1 x * D x + 4 * (p x + κ ^ 2) * D1 x) →
      Filter.Tendsto G Filter.atTop (nhds (1 / (2 * κ))) →
      Filter.Tendsto G1 Filter.atTop (nhds 0) →
      Filter.Tendsto G2 Filter.atTop (nhds 0) → Filter.Tendsto p Filter.atTop (nhds 0) →
      Filter.Tendsto D Filter.atTop (nhds 0) → Filter.Tendsto D1 Filter.atTop (nhds 0) →
      Filter.Tendsto D2 Filter.atTop (nhds 0) →
      ∀ x, G x * D2 x + G2 x * D x - G1 x * D1 x - 4 * (p x + κ ^ 2) * G x * D x = 0 := by
    intro G G1 G2 G3 D D1 D2 D3 p p1 hG hG1 hG2 hD hD1 hD2 hp hodeg hoded hGt hG1t hG2t hpt
      hDt hD1t hD2t
    refine const_lim
      (fun x => G x * D2 x + G2 x * D x - G1 x * D1 x - 4 * (p x + κ ^ 2) * G x * D x) 0 ?_ ?_
    · intro x
      have := ((((hG x).mul (hD2 x)).add ((hG2 x).mul (hD x))).sub ((hG1 x).mul (hD1 x))).sub
        (((((hp x).add_const (κ ^ 2)).const_mul 4).mul (hG x)).mul (hD x))
      refine this.congr_deriv ?_
      simp only [Pi.mul_apply]
      linear_combination (G x) * hoded x + (D x) * hodeg x
    · have := (((hGt.mul hD2t).add (hG2t.mul hDt)).sub (hG1t.mul hD1t)).sub
        ((((hpt.add_const (κ ^ 2)).const_mul 4).mul hGt).mul hDt)
      simpa using this
  
  have energy : ∀ (G G1 G2 D D1 D2 P : ℝ → ℝ),
      (∀ x, HasDerivAt G (G1 x) x) → (∀ x, HasDerivAt G1 (G2 x) x) →
      (∀ x, HasDerivAt D (D1 x) x) → (∀ x, HasDerivAt D1 (D2 x) x) →
      (∀ x, 0 < G x) →
      Filter.Tendsto G Filter.atTop (nhds (1 / (2 * κ))) →
      Filter.Tendsto G Filter.atBot (nhds (1 / (2 * κ))) →
      Filter.Tendsto G1 Filter.atTop (nhds 0) → Filter.Tendsto G1 Filter.atBot (nhds 0) →
      Filter.Tendsto D Filter.atTop (nhds 0) → Filter.Tendsto D Filter.atBot (nhds 0) →
      Filter.Tendsto D1 Filter.atTop (nhds 0) → Filter.Tendsto D1 Filter.atBot (nhds 0) →
      (∀ x, 2 * G x * G2 x - G1 x * G1 x - P x * (G x * G x) = -1) →
      (∀ x, G x * D2 x + G2 x * D x - G1 x * D1 x - P x * G x * D x = 0) →
      ∀ x, D x = 0 := by
    intro G G1 G2 D D1 D2 P hG hG1 hD hD1 hpos hGt hGb hG1t hG1b hDt hDb hD1t hD1b hI hB
    have hNd : ∀ x, HasDerivAt (fun y => D y * D1 y * G y - D y * D y * G1 y)
        ((D1 x * D1 x + D x * D2 x) * G x + D x * D1 x * G1 x
          - ((D1 x * D x + D x * D1 x) * G1 x + D x * D x * G2 x)) x := by
      intro x
      exact (((hD x).mul (hD1 x)).mul (hG x)).sub (((hD x).mul (hD x)).mul (hG1 x))
    have hEd : ∀ x, HasDerivAt (fun y => (D y * D1 y * G y - D y * D y * G1 y) / (G y * G y))
        (G x * ((D1 x * G x - D x * G1 x) ^ 2 + D x ^ 2) / (G x * G x) ^ 2) x := by
      intro x
      have hGx := hpos x
      have hne : G x * G x ≠ 0 := by positivity
      refine ((hNd x).div ((hG x).mul (hG x)) hne).congr_deriv ?_
      congr 1
      simp only [Pi.mul_apply]
      linear_combination (G x * D x * G x) * hB x - (G x * D x ^ 2) * hI x
    have hmono : Monotone (fun y => (D y * D1 y * G y - D y * D y * G1 y) / (G y * G y)) := by
      apply monotone_of_deriv_nonneg (fun x => (hEd x).differentiableAt)
      intro x
      rw [(hEd x).deriv]
      exact div_nonneg (mul_nonneg (hpos x).le (by positivity)) (by positivity)
    have hEt : Filter.Tendsto (fun y => (D y * D1 y * G y - D y * D y * G1 y) / (G y * G y))
        Filter.atTop (nhds 0) := by
      have := (((hDt.mul hD1t).mul hGt).sub ((hDt.mul hDt).mul hG1t)).div (hGt.mul hGt)
        (mul_ne_zero hL hL)
      simpa using this
    have hEb : Filter.Tendsto (fun y => (D y * D1 y * G y - D y * D y * G1 y) / (G y * G y))
        Filter.atBot (nhds 0) := by
      have := (((hDb.mul hD1b).mul hGb).sub ((hDb.mul hDb).mul hG1b)).div (hGb.mul hGb)
        (mul_ne_zero hL hL)
      simpa using this
    have hfun : (fun y => (D y * D1 y * G y - D y * D y * G1 y) / (G y * G y)) =
        fun _ => (0 : ℝ) :=
      funext fun x => le_antisymm (hmono.ge_of_tendsto hEt x) (hmono.le_of_tendsto hEb x)
    intro x
    have h1 := hEd x
    rw [hfun] at h1
    have h2 := h1.unique (hasDerivAt_const x (0 : ℝ))
    have hGx := hpos x
    have hne : (G x * G x) ^ 2 ≠ 0 := by positivity
    rw [div_eq_zero_iff] at h2
    rcases h2 with h2 | h2
    · have h3 : (D1 x * G x - D x * G1 x) ^ 2 + D x ^ 2 = 0 := by
        rcases mul_eq_zero.1 h2 with h | h
        · exact absurd h hGx.ne'
        · exact h
      have h4 : D x ^ 2 = 0 := by
        nlinarith [sq_nonneg (D1 x * G x - D x * G1 x), sq_nonneg (D x)]
      exact pow_eq_zero_iff (two_ne_zero) |>.1 h4
    · exact absurd h2 hne
  
  have hγ₀d : ∀ x, HasDerivAt (fun y => 1 / (2 * κ) + γ₀ y)
      (SchwartzMap.derivCLM ℝ ℝ γ₀ x) x :=
    fun x => (hderiv γ₀ x).const_add _
  have hGt : Filter.Tendsto (fun y => 1 / (2 * κ) + γ₀ y) Filter.atTop
      (nhds (1 / (2 * κ))) := by
    have := (hlim γ₀).1.const_add (1 / (2 * κ))
    rwa [add_zero] at this
  have hGb : Filter.Tendsto (fun y => 1 / (2 * κ) + γ₀ y) Filter.atBot
      (nhds (1 / (2 * κ))) := by
    have := (hlim γ₀).2.const_add (1 / (2 * κ))
    rwa [add_zero] at this
  have hsubt : ∀ f g : 𝓢(ℝ, ℝ), Filter.Tendsto (fun y => f y - g y) Filter.atTop (nhds 0) := by
    intro f g
    have := (hlim f).1.sub (hlim g).1
    rwa [sub_zero] at this
  have hsubb : ∀ f g : 𝓢(ℝ, ℝ), Filter.Tendsto (fun y => f y - g y) Filter.atBot (nhds 0) := by
    intro f g
    have := (hlim f).2.sub (hlim g).2
    rwa [sub_zero] at this
  have hodeg := hexp γ₀ h₀
  have hoded : ∀ x,
      SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ)) x
        - SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ₀)) x =
      2 * SchwartzMap.derivCLM ℝ ℝ q x * (γ x - γ₀ x)
        + 4 * (q x + κ ^ 2) * (SchwartzMap.derivCLM ℝ ℝ γ x - SchwartzMap.derivCLM ℝ ℝ γ₀ x) := by
    intro x
    rw [hexp γ h x, hexp γ₀ h₀ x]
    ring
  have hI0 := hIconst (fun y => 1 / (2 * κ) + γ₀ y) (SchwartzMap.derivCLM ℝ ℝ γ₀)
    (SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ₀))
    (SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ₀)))
    q (SchwartzMap.derivCLM ℝ ℝ q) hγ₀d (hderiv _) (hderiv _) (hderiv _) hodeg hGt
    (hlim _).1 (hlim _).1 (hlim _).1
  have hB0 := hBzero (fun y => 1 / (2 * κ) + γ₀ y) (SchwartzMap.derivCLM ℝ ℝ γ₀)
    (SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ₀))
    (SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ₀)))
    (fun y => γ y - γ₀ y)
    (fun y => SchwartzMap.derivCLM ℝ ℝ γ y - SchwartzMap.derivCLM ℝ ℝ γ₀ y)
    (fun y => SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ) y
      - SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ₀) y)
    (fun y => SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ)) y
      - SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ₀)) y)
    q (SchwartzMap.derivCLM ℝ ℝ q)
    hγ₀d (hderiv _) (hderiv _)
    (fun x => (hderiv γ x).sub (hderiv γ₀ x)) (fun x => (hderiv _ x).sub (hderiv _ x))
    (fun x => (hderiv _ x).sub (hderiv _ x)) (hderiv _) hodeg hoded hGt (hlim _).1 (hlim _).1
    (hlim _).1 (hsubt _ _) (hsubt _ _) (hsubt _ _)
  have hD0 := energy (fun y => 1 / (2 * κ) + γ₀ y) (SchwartzMap.derivCLM ℝ ℝ γ₀)
    (SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ₀))
    (fun y => γ y - γ₀ y)
    (fun y => SchwartzMap.derivCLM ℝ ℝ γ y - SchwartzMap.derivCLM ℝ ℝ γ₀ y)
    (fun y => SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ) y
      - SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ₀) y)
    (fun y => 4 * (q y + κ ^ 2))
    hγ₀d (hderiv _) (fun x => (hderiv γ x).sub (hderiv γ₀ x))
    (fun x => (hderiv _ x).sub (hderiv _ x))
    (fun x => by have := hmG x; linarith) hGt hGb (hlim _).1 (hlim _).2
    (hsubt _ _) (hsubb _ _) (hsubt _ _) (hsubb _ _)
    hI0 hB0
  ext x
  exact sub_eq_zero.1 (hD0 x)

theorem lipschitz_ode_global {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (f : E → E) (K : NNReal) (hf : LipschitzWith K f) (x₀ : E) :
    ∃ γ : ℝ → E, γ 0 = x₀ ∧ ∀ t : ℝ, HasDerivAt γ (f (γ t)) t :=
by
  
  have hconcat : ∀ (a b c : ℝ), a ≤ b → b ≤ c → ∀ (γ₁ γ₂ : ℝ → E),
      (∀ t ∈ Set.Icc a b, HasDerivWithinAt γ₁ (f (γ₁ t)) (Set.Icc a b) t) →
      (∀ t ∈ Set.Icc b c, HasDerivWithinAt γ₂ (f (γ₂ t)) (Set.Icc b c) t) →
      γ₁ b = γ₂ b →
      ∃ g : ℝ → E, (∀ t, t ≤ b → g t = γ₁ t) ∧ (∀ t, b ≤ t → g t = γ₂ t) ∧
        ∀ t ∈ Set.Icc a c, HasDerivWithinAt g (f (g t)) (Set.Icc a c) t := by
    intro a b c hab hbc γ₁ γ₂ h₁ h₂ hb
    obtain ⟨g, hg⟩ : ∃ g : ℝ → E, g = fun t => if t ≤ b then γ₁ t else γ₂ t := ⟨_, rfl⟩
    have e1 : ∀ t, t ≤ b → g t = γ₁ t := by
      intro t ht
      rw [hg]
      exact if_pos ht
    have e2 : ∀ t, b ≤ t → g t = γ₂ t := by
      intro t ht
      rw [hg]
      rcases eq_or_lt_of_le ht with h | h
      · show (if t ≤ b then γ₁ t else γ₂ t) = γ₂ t
        rw [if_pos (le_of_eq h.symm), ← h, hb]
      · exact if_neg (not_le.2 h)
    have D₁ : ∀ t ∈ Set.Icc a b, HasDerivWithinAt g (f (g t)) (Set.Icc a b) t := by
      intro t ht
      rw [e1 t ht.2]
      exact (h₁ t ht).congr (fun s hs => e1 s hs.2) (e1 t ht.2)
    have D₂ : ∀ t ∈ Set.Icc b c, HasDerivWithinAt g (f (g t)) (Set.Icc b c) t := by
      intro t ht
      rw [e2 t ht.1]
      exact (h₂ t ht).congr (fun s hs => e2 s hs.1) (e2 t ht.1)
    refine ⟨g, e1, e2, ?_⟩
    intro t ht
    rcases lt_trichotomy t b with h | h | h
    · have hmem : Set.Icc a b ∈ nhdsWithin t (Set.Icc a c) := by
        apply Filter.mem_of_superset (inter_mem_nhdsWithin (Set.Icc a c) (Iio_mem_nhds h))
        rintro s ⟨hs1, hs2⟩
        exact ⟨hs1.1, le_of_lt hs2⟩
      exact (D₁ t ⟨ht.1, h.le⟩).mono_of_mem_nhdsWithin hmem
    · rw [h, ← Set.Icc_union_Icc_eq_Icc hab hbc]
      exact (D₁ b ⟨hab, le_rfl⟩).union (D₂ b ⟨le_rfl, hbc⟩)
    · have hmem : Set.Icc b c ∈ nhdsWithin t (Set.Icc a c) := by
        apply Filter.mem_of_superset (inter_mem_nhdsWithin (Set.Icc a c) (Ioi_mem_nhds h))
        rintro s ⟨hs1, hs2⟩
        exact ⟨le_of_lt hs2, hs1.2⟩
      exact (D₂ t ⟨h.le, ht.2⟩).mono_of_mem_nhdsWithin hmem
  
  have hK0 : (0 : ℝ) ≤ K := K.2
  obtain ⟨ε, hεdef⟩ : ∃ ε : ℝ, ε = 1 / (2 * ((K : ℝ) + 1)) := ⟨_, rfl⟩
  have hε : 0 < ε := by rw [hεdef]; positivity
  have hKε : (K : ℝ) * ε ≤ 1 / 2 := by
    rw [hεdef, mul_one_div, div_le_iff₀ (by positivity)]
    linarith
  
  have hloc : ∀ (τ : ℝ) (y : E), ∃ α : ℝ → E, α τ = y ∧
      ∀ t ∈ Set.Icc (τ - ε) (τ + ε),
        HasDerivWithinAt α (f (α t)) (Set.Icc (τ - ε) (τ + ε)) t := by
    intro τ y
    have hτ : τ ∈ Set.Icc (τ - ε) (τ + ε) := ⟨by linarith, by linarith⟩
    have hF : 0 ≤ ‖f y‖ := norm_nonneg _
    let a : NNReal := ⟨2 * ε * ‖f y‖ + 1, by positivity⟩
    let L : NNReal := ⟨‖f y‖ + K * (2 * ε * ‖f y‖ + 1), by positivity⟩
    have hP : IsPicardLindelof (fun _ => f) (⟨τ, hτ⟩ : Set.Icc (τ - ε) (τ + ε)) y a 0 L K := by
      apply IsPicardLindelof.of_time_independent
      · intro x hx
        rw [Metric.mem_closedBall, dist_eq_norm] at hx
        show ‖f x‖ ≤ ‖f y‖ + K * (2 * ε * ‖f y‖ + 1)
        have h1 := hf.norm_sub_le x y
        have h2 := norm_sub_norm_le (f x) (f y)
        have h3 : (K : ℝ) * ‖x - y‖ ≤ K * (2 * ε * ‖f y‖ + 1) :=
          mul_le_mul_of_nonneg_left hx hK0
        linarith
      · exact hf.lipschitzOnWith
      · show (‖f y‖ + K * (2 * ε * ‖f y‖ + 1)) * max ((τ + ε) - τ) (τ - (τ - ε)) ≤
          (2 * ε * ‖f y‖ + 1) - ((0 : NNReal) : ℝ)
        have hm : max ((τ + ε) - τ) (τ - (τ - ε)) = ε := by
          rw [show (τ + ε) - τ = ε by ring, show τ - (τ - ε) = ε by ring, max_self]
        rw [hm, NNReal.coe_zero, sub_zero]
        nlinarith [mul_nonneg (mul_nonneg hε.le hF) (by linarith : (0 : ℝ) ≤ 1 - 2 * (K * ε))]
    obtain ⟨α, hα0, hα⟩ := hP.exists_eq_forall_mem_Icc_hasDerivWithinAt₀
    exact ⟨α, hα0, hα⟩
  
  have nested : ∀ n : ℕ, ∃ γ : ℝ → E, γ 0 = x₀ ∧
      ∀ t ∈ Set.Icc (-(((n : ℝ) + 1) * ε)) (((n : ℝ) + 1) * ε),
        HasDerivWithinAt γ (f (γ t)) (Set.Icc (-(((n : ℝ) + 1) * ε)) (((n : ℝ) + 1) * ε)) t := by
    intro n
    induction n with
    | zero =>
      obtain ⟨α, hα0, hα⟩ := hloc 0 x₀
      refine ⟨α, hα0, ?_⟩
      simp only [zero_sub, zero_add] at hα
      simp only [Nat.cast_zero, zero_add, one_mul]
      exact hα
    | succ n ih =>
      obtain ⟨γ, hγ0, hγ⟩ := ih
      obtain ⟨T, hT⟩ : ∃ T : ℝ, T = ((n : ℝ) + 1) * ε := ⟨_, rfl⟩
      rw [← hT] at hγ
      have hTpos : 0 < T := by rw [hT]; positivity
      have hT1 : (((n + 1 : ℕ) : ℝ) + 1) * ε = T + ε := by rw [hT]; push_cast; ring
      rw [hT1]
      obtain ⟨αm, hαm0, hαm⟩ := hloc (-T) (γ (-T))
      have hαm' : ∀ t ∈ Set.Icc (-T - ε) (-T),
          HasDerivWithinAt αm (f (αm t)) (Set.Icc (-T - ε) (-T)) t := by
        intro t ht
        have hsub : Set.Icc (-T - ε) (-T) ⊆ Set.Icc (-T - ε) (-T + ε) :=
          Set.Icc_subset_Icc le_rfl (by linarith)
        exact (hαm t (hsub ht)).mono hsub
      obtain ⟨g₁, hg₁l, hg₁r, hg₁⟩ :=
        hconcat (-T - ε) (-T) T (by linarith) (by linarith) αm γ hαm' hγ hαm0
      obtain ⟨αp, hαp0, hαp⟩ := hloc T (g₁ T)
      have hαp' : ∀ t ∈ Set.Icc T (T + ε),
          HasDerivWithinAt αp (f (αp t)) (Set.Icc T (T + ε)) t := by
        intro t ht
        have hsub : Set.Icc T (T + ε) ⊆ Set.Icc (T - ε) (T + ε) :=
          Set.Icc_subset_Icc (by linarith) le_rfl
        exact (hαp t (hsub ht)).mono hsub
      obtain ⟨g₂, hg₂l, hg₂r, hg₂⟩ :=
        hconcat (-T - ε) T (T + ε) (by linarith) (by linarith) g₁ αp hg₁ hαp' hαp0.symm
      refine ⟨g₂, ?_, ?_⟩
      · rw [hg₂l 0 hTpos.le, hg₁r 0 (by linarith), hγ0]
      · have e : -(T + ε) = -T - ε := by ring
        rw [e]
        exact hg₂
  
  choose Γ hΓ0 hΓ using nested
  have hTp : ∀ n : ℕ, 0 < ((n : ℝ) + 1) * ε := fun n => by positivity
  have hA : ∀ n : ℕ, ∀ t : ℝ, |t| < ((n : ℝ) + 1) * ε → HasDerivAt (Γ n) (f (Γ n t)) t := by
    intro n t ht
    obtain ⟨h1, h2⟩ := abs_lt.1 ht
    exact (hΓ n t ⟨h1.le, h2.le⟩).hasDerivAt (Icc_mem_nhds h1 h2)
  have hB : ∀ m n : ℕ, ∀ s : ℝ, |s| ≤ ((m : ℝ) + 1) * ε → |s| ≤ ((n : ℝ) + 1) * ε →
      Γ m s = Γ n s := by
    intro m n s hm hn
    obtain ⟨R, hR⟩ : ∃ R : ℝ, R = min (((m : ℝ) + 1) * ε) (((n : ℝ) + 1) * ε) := ⟨_, rfl⟩
    have hRpos : 0 < R := by rw [hR]; exact lt_min (hTp m) (hTp n)
    have hRm : R ≤ ((m : ℝ) + 1) * ε := by rw [hR]; exact min_le_left _ _
    have hRn : R ≤ ((n : ℝ) + 1) * ε := by rw [hR]; exact min_le_right _ _
    have hs : s ∈ Set.Icc (-R) R := by
      rw [hR]
      exact abs_le.1 (le_min hm hn)
    have key := ODE_solution_unique_of_mem_Icc (v := fun _ => f) (s := fun _ => Set.univ) (K := K)
      (fun _ _ => hf.lipschitzOnWith) (show (0 : ℝ) ∈ Set.Ioo (-R) R from ⟨by linarith, hRpos⟩)
      ((HasDerivWithinAt.continuousOn (f' := fun t => f (Γ m t)) (hΓ m)).mono
        (Set.Icc_subset_Icc (by linarith) hRm))
      (fun t ht => hA m t (by rw [abs_lt]; constructor <;> linarith [ht.1, ht.2]))
      (fun _ _ => Set.mem_univ _)
      ((HasDerivWithinAt.continuousOn (f' := fun t => f (Γ n t)) (hΓ n)).mono
        (Set.Icc_subset_Icc (by linarith) hRn))
      (fun t ht => hA n t (by rw [abs_lt]; constructor <;> linarith [ht.1, ht.2]))
      (fun _ _ => Set.mem_univ _)
      (by rw [hΓ0, hΓ0])
    exact key hs
  have hC : ∀ t : ℝ, |t| < (((⌈|t| / ε⌉₊ : ℕ) : ℝ) + 1) * ε := by
    intro t
    have h1 : |t| / ε ≤ ((⌈|t| / ε⌉₊ : ℕ) : ℝ) := Nat.le_ceil _
    rw [div_le_iff₀ hε] at h1
    nlinarith
  refine ⟨fun t => Γ ⌈|t| / ε⌉₊ t, hΓ0 _, ?_⟩
  intro t
  obtain ⟨n, hn⟩ : ∃ n : ℕ, n = ⌈|t| / ε⌉₊ := ⟨_, rfl⟩
  have ht : |t| < ((n : ℝ) + 1) * ε := by rw [hn]; exact hC t
  have hev : (fun s => Γ ⌈|s| / ε⌉₊ s) =ᶠ[nhds t] Γ n := by
    have hU : Set.Ioo (-(((n : ℝ) + 1) * ε)) (((n : ℝ) + 1) * ε) ∈ nhds t := by
      obtain ⟨h1, h2⟩ := abs_lt.1 ht
      exact Ioo_mem_nhds h1 h2
    filter_upwards [hU] with s hs
    have hs' : |s| < ((n : ℝ) + 1) * ε := abs_lt.2 hs
    exact hB _ n s (hC s).le hs'.le
  have hd := (hA n t ht).congr_of_eventuallyEq hev
  show HasDerivAt (fun s => Γ ⌈|s| / ε⌉₊ s) (f (Γ ⌈|t| / ε⌉₊ t)) t
  rw [← hn]
  exact hd

theorem wfieldC_weighted_lipschitz (κ ρ : ℝ) (hκ : 1 ≤ κ) (hρ : 0 ≤ ρ) :
    ∃ L : ℝ, 0 ≤ L ∧ ∀ (w₁ w₂ : ℝ → ℝ), Continuous w₁ → Continuous w₂ → ∀ D : ℝ,
      (∀ y : ℝ, (1 + y ^ 2) * |w₁ y - w₂ y| ≤ D) →
      ∀ x : ℝ, (1 + x ^ 2) * |wfieldC κ ρ w₁ x - wfieldC κ ρ w₂ x| ≤ L * D :=
by
  have hκ0 : 0 ≤ κ := by linarith
  
  have mvt : ∀ p q M : ℝ, p ≤ M → q ≤ M → |Real.exp p - Real.exp q| ≤ Real.exp M * |p - q| := by
    have key : ∀ p q M : ℝ, q ≤ p → p ≤ M →
        |Real.exp p - Real.exp q| ≤ Real.exp M * |p - q| := by
      intro p q M hqp hpM
      have h1 := Real.add_one_le_exp (q - p)
      have h2 : Real.exp q = Real.exp p * Real.exp (q - p) := by
        rw [← Real.exp_add]; congr 1; ring
      have h3 : Real.exp q ≤ Real.exp p := Real.exp_le_exp.mpr hqp
      have h4 := Real.exp_le_exp.mpr hpM
      have hep := Real.exp_pos p
      rw [abs_of_nonneg (sub_nonneg.mpr h3), abs_of_nonneg (sub_nonneg.mpr hqp)]
      have h5 : Real.exp p - Real.exp q ≤ Real.exp p * (p - q) := by
        rw [h2]; nlinarith [mul_le_mul_of_nonneg_left h1 hep.le]
      calc Real.exp p - Real.exp q ≤ Real.exp p * (p - q) := h5
        _ ≤ Real.exp M * (p - q) := mul_le_mul_of_nonneg_right h4 (sub_nonneg.mpr hqp)
    intro p q M hp hq
    rcases le_total q p with h | h
    · exact key p q M h hp
    · rw [abs_sub_comm, abs_sub_comm p]; exact key q p M h hq
  have s1 : ∀ s a b : ℝ, 0 ≤ s →
      Real.exp (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) a) ≤ Real.exp (ρ ^ 2) * Real.exp (-s) ∧
      |Real.exp (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) a)
        - Real.exp (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) b)|
        ≤ 2 * Real.exp (ρ ^ 2) * Real.exp (-s) * |a - b| := by
    intro s a b hs
    have hβ0 : 0 ≤ ρ * Real.sqrt s := mul_nonneg hρ (Real.sqrt_nonneg s)
    have hsq := Real.sq_sqrt hs
    have amgm : 2 * (ρ * Real.sqrt s) ≤ s + ρ ^ 2 := by
      nlinarith [sq_nonneg (Real.sqrt s - ρ)]
    have W1 : ∀ c, wclamp (ρ * Real.sqrt s) c ≤ ρ * Real.sqrt s :=
      fun c => max_le (by linarith) (min_le_right _ _)
    have W2 : |wclamp (ρ * Real.sqrt s) a - wclamp (ρ * Real.sqrt s) b| ≤ |a - b| := by
      unfold wclamp
      rw [max_comm (-(ρ * Real.sqrt s)), max_comm (-(ρ * Real.sqrt s))]
      refine (abs_max_sub_max_le_abs _ _ _).trans ?_
      have := abs_min_sub_min_le_max a (ρ * Real.sqrt s) b (ρ * Real.sqrt s)
      rw [sub_self, abs_zero, max_eq_left (abs_nonneg _)] at this
      exact this
    have hks : s ≤ κ * s := le_mul_of_one_le_left hs hκ
    have hp : ∀ c, -2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) c ≤ ρ ^ 2 + -s :=
      fun c => by linarith [W1 c]
    have hE : ∀ c, Real.exp (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) c) ≤
        Real.exp (ρ ^ 2) * Real.exp (-s) := fun c => by
      rw [← Real.exp_add]; exact Real.exp_le_exp.mpr (hp c)
    refine ⟨hE a, ?_⟩
    have h := mvt _ _ _ (hp a) (hp b)
    rw [Real.exp_add (ρ ^ 2) (-s)] at h
    have hpq : |(-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) a) -
        (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) b)| =
        2 * |wclamp (ρ * Real.sqrt s) a - wclamp (ρ * Real.sqrt s) b| := by
      rw [show (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) a) -
          (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) b) =
          2 * (wclamp (ρ * Real.sqrt s) a - wclamp (ρ * Real.sqrt s) b) by ring, abs_mul, abs_two]
    rw [hpq] at h
    have hpos : 0 ≤ Real.exp (ρ ^ 2) * Real.exp (-s) := by positivity
    calc _ ≤ _ := h
      _ ≤ Real.exp (ρ ^ 2) * Real.exp (-s) * (2 * |a - b|) :=
          mul_le_mul_of_nonneg_left (by linarith) hpos
      _ = 2 * Real.exp (ρ ^ 2) * Real.exp (-s) * |a - b| := by ring
  
  have s2 : ∀ (w₁ w₂ : ℝ → ℝ), Continuous w₁ → Continuous w₂ → ∀ D : ℝ,
      (∀ y : ℝ, (1 + y ^ 2) * |w₁ y - w₂ y| ≤ D) → ∀ x s : ℝ, 0 ≤ s →
      |(∫ y in (x - s)..x, w₁ y) - ∫ y in (x - s)..x, w₂ y| ≤ 2 * D / (1 + x ^ 2) * (s + s ^ 3) ∧
      |(∫ y in x..(x + s), w₁ y) - ∫ y in x..(x + s), w₂ y| ≤
        2 * D / (1 + x ^ 2) * (s + s ^ 3) := by
    intro w₁ w₂ h₁ h₂ D hD x s hs
    have hx : 0 < 1 + x ^ 2 := by positivity
    have pw : ∀ y, |x - y| ≤ s → ‖w₁ y - w₂ y‖ ≤ 2 * D * (1 + s ^ 2) / (1 + x ^ 2) := by
      intro y hy
      rw [Real.norm_eq_abs, le_div_iff₀ hx]
      have hd2 : (x - y) ^ 2 ≤ s ^ 2 := by
        rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hy 2
      have hy2 : (0 : ℝ) ≤ 2 * (1 + y ^ 2) := by positivity
      have peetre : 1 + x ^ 2 ≤ 2 * (1 + y ^ 2) * (1 + s ^ 2) := by
        nlinarith [sq_nonneg (y - (x - y)), sq_nonneg (y * (x - y)),
          mul_le_mul_of_nonneg_left hd2 hy2]
      have ha := abs_nonneg (w₁ y - w₂ y)
      have hs2 : (0 : ℝ) ≤ 2 * (1 + s ^ 2) := by positivity
      nlinarith [mul_le_mul_of_nonneg_right peetre ha, mul_le_mul_of_nonneg_left (hD y) hs2]
    have hC : ∀ a b : ℝ, (∀ y ∈ Set.uIoc a b, |x - y| ≤ s) → |b - a| = s →
        |(∫ y in a..b, w₁ y) - ∫ y in a..b, w₂ y| ≤ 2 * D / (1 + x ^ 2) * (s + s ^ 3) := by
      intro a b hab hba
      have e : (∫ y in a..b, w₁ y) - ∫ y in a..b, w₂ y = ∫ y in a..b, (w₁ y - w₂ y) :=
        (intervalIntegral.integral_sub (h₁.intervalIntegrable _ _)
          (h₂.intervalIntegrable _ _)).symm
      rw [e]
      have := intervalIntegral.norm_integral_le_of_norm_le_const (fun y hy => pw y (hab y hy))
      rw [Real.norm_eq_abs, hba] at this
      calc _ ≤ _ := this
        _ = 2 * D / (1 + x ^ 2) * (s + s ^ 3) := by ring
    constructor
    · refine hC _ _ (fun y hy => ?_) (by rw [sub_sub_cancel, abs_of_nonneg hs])
      rcases Set.mem_uIoc.1 hy with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> rw [abs_le] <;> constructor <;> linarith
    · refine hC _ _ (fun y hy => ?_) (by rw [add_sub_cancel_left, abs_of_nonneg hs])
      rcases Set.mem_uIoc.1 hy with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> rw [abs_le] <;> constructor <;> linarith
  
  have s3 : IntegrableOn (fun s : ℝ => (s + s ^ 3) * Real.exp (-s)) (Set.Ioi 0) := by
    have h2 := Real.GammaIntegral_convergent (by norm_num : (0:ℝ) < 2)
    have h4 := Real.GammaIntegral_convergent (by norm_num : (0:ℝ) < 4)
    have e2 : (fun x : ℝ => Real.exp (-x) * x ^ ((2:ℝ) - 1)) = fun x => Real.exp (-x) * x := by
      funext x; norm_num
    have e4 : (fun x : ℝ => Real.exp (-x) * x ^ ((4:ℝ) - 1)) =
        fun x => Real.exp (-x) * x ^ 3 := by
      funext x; rw [show (4:ℝ) - 1 = ((3:ℕ):ℝ) by norm_num, Real.rpow_natCast]
    rw [e2] at h2
    rw [e4] at h4
    have h24 : IntegrableOn (fun x : ℝ => Real.exp (-x) * x + Real.exp (-x) * x ^ 3)
        (Set.Ioi 0) := h2.add h4
    refine h24.congr_fun (fun x _ => ?_) measurableSet_Ioi
    ring
  
  have s4 : ∀ (F₁ F₂ g : ℝ → ℝ) (C K : ℝ), Continuous F₁ → Continuous F₂ →
      IntegrableOn g (Set.Ioi 0) →
      (∀ s : ℝ, 0 < s → |F₁ s| ≤ C * Real.exp (-s)) →
      (∀ s : ℝ, 0 < s → |F₂ s| ≤ C * Real.exp (-s)) →
      (∀ s : ℝ, 0 < s → |F₁ s - F₂ s| ≤ K * g s) →
      |(∫ s in Set.Ioi 0, F₁ s) - ∫ s in Set.Ioi 0, F₂ s| ≤ K * ∫ s in Set.Ioi 0, g s := by
    intro F₁ F₂ g C K hF₁ hF₂ hg hb₁ hb₂ hd
    have hexp : IntegrableOn (fun s : ℝ => C * Real.exp (-s)) (Set.Ioi 0) :=
      (integrableOn_exp_neg_Ioi 0).const_mul C
    have hi : ∀ F : ℝ → ℝ, Continuous F → (∀ s : ℝ, 0 < s → |F s| ≤ C * Real.exp (-s)) →
        IntegrableOn F (Set.Ioi 0) := by
      intro F hF hb
      exact Integrable.mono' hexp hF.aestronglyMeasurable
        (ae_restrict_of_forall_mem measurableSet_Ioi fun s hs => by
          rw [Real.norm_eq_abs]; exact hb s hs)
    rw [← integral_sub (hi F₁ hF₁ hb₁) (hi F₂ hF₂ hb₂), ← integral_const_mul,
      ← Real.norm_eq_abs]
    refine norm_integral_le_of_norm_le (hg.const_mul K)
      (ae_restrict_of_forall_mem measurableSet_Ioi fun s hs => ?_)
    rw [Real.norm_eq_abs]; exact hd s hs
  
  have s5 : ∀ (w : ℝ → ℝ), Continuous w → ∀ x : ℝ,
      Continuous (fun s : ℝ =>
        Real.exp (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) (∫ y in (x - s)..x, w y))) ∧
      Continuous (fun s : ℝ =>
        Real.exp (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) (∫ y in x..(x + s), w y))) := by
    intro w hw x
    have hP : Continuous (fun u => ∫ y in (0:ℝ)..u, w y) :=
      intervalIntegral.continuous_primitive (fun a b => hw.intervalIntegrable a b) 0
    have hA : Continuous (fun s : ℝ => ∫ y in (x - s)..x, w y) := by
      have : (fun s : ℝ => ∫ y in (x - s)..x, w y) =
          fun s => (∫ y in (0:ℝ)..x, w y) - ∫ y in (0:ℝ)..(x - s), w y := by
        funext s
        exact (intervalIntegral.integral_interval_sub_left (hw.intervalIntegrable _ _)
          (hw.intervalIntegrable _ _)).symm
      rw [this]
      exact continuous_const.sub (hP.comp (continuous_const.sub continuous_id))
    have hB : Continuous (fun s : ℝ => ∫ y in x..(x + s), w y) := by
      have : (fun s : ℝ => ∫ y in x..(x + s), w y) =
          fun s => (∫ y in (0:ℝ)..(x + s), w y) - ∫ y in (0:ℝ)..x, w y := by
        funext s
        exact (intervalIntegral.integral_interval_sub_left (hw.intervalIntegrable _ _)
          (hw.intervalIntegrable _ _)).symm
      rw [this]
      exact (hP.comp (continuous_const.add continuous_id)).sub continuous_const
    have hsq : Continuous (fun s : ℝ => ρ * Real.sqrt s) :=
      continuous_const.mul Real.continuous_sqrt
    unfold wclamp
    exact ⟨Real.continuous_exp.comp ((continuous_const.mul continuous_id).add
        (continuous_const.mul (hsq.neg.max (hA.min hsq)))),
      Real.continuous_exp.comp ((continuous_const.mul continuous_id).add
        (continuous_const.mul (hsq.neg.max (hB.min hsq))))⟩
  
  have hI0 : 0 ≤ ∫ s in Set.Ioi (0:ℝ), (s + s ^ 3) * Real.exp (-s) :=
    setIntegral_nonneg measurableSet_Ioi (fun s hs => by
      have h : (0:ℝ) < s := hs
      exact mul_nonneg (add_nonneg h.le (pow_nonneg h.le 3)) (Real.exp_pos _).le)
  have hk5 : (0:ℝ) ≤ 8 * κ ^ 5 := mul_nonneg (by norm_num) (pow_nonneg hκ0 5)
  refine ⟨64 * κ ^ 5 * Real.exp (ρ ^ 2) * ∫ s in Set.Ioi (0:ℝ), (s + s ^ 3) * Real.exp (-s),
    mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) (pow_nonneg hκ0 5))
      (Real.exp_pos _).le) hI0, ?_⟩
  intro w₁ w₂ h₁ h₂ D hD x
  have hx : 0 < 1 + x ^ 2 := by positivity
  obtain ⟨c₁, c₁'⟩ := s5 w₁ h₁ x
  obtain ⟨c₂, c₂'⟩ := s5 w₂ h₂ x
  have hG : |rgreenC κ ρ w₁ x - rgreenC κ ρ w₂ x| ≤
      (2 * Real.exp (ρ ^ 2) * (2 * D / (1 + x ^ 2))) *
        ∫ s in Set.Ioi (0:ℝ), (s + s ^ 3) * Real.exp (-s) := by
    unfold rgreenC
    refine s4 _ _ (fun s => (s + s ^ 3) * Real.exp (-s)) (Real.exp (ρ ^ 2)) _ c₁ c₂ s3
      ?_ ?_ ?_
    · intro s hs
      rw [abs_of_pos (Real.exp_pos _)]
      exact (s1 s _ 0 hs.le).1
    · intro s hs
      rw [abs_of_pos (Real.exp_pos _)]
      exact (s1 s _ 0 hs.le).1
    · intro s hs
      have e1 := (s1 s (∫ y in (x - s)..x, w₁ y) (∫ y in (x - s)..x, w₂ y) hs.le).2
      have e2 := (s2 w₁ w₂ h₁ h₂ D hD x s hs.le).1
      have hpos : 0 ≤ 2 * Real.exp (ρ ^ 2) * Real.exp (-s) := by positivity
      calc _ ≤ _ := e1
        _ ≤ 2 * Real.exp (ρ ^ 2) * Real.exp (-s) * (2 * D / (1 + x ^ 2) * (s + s ^ 3)) :=
            mul_le_mul_of_nonneg_left e2 hpos
        _ = (2 * Real.exp (ρ ^ 2) * (2 * D / (1 + x ^ 2))) * ((s + s ^ 3) * Real.exp (-s)) := by
            ring
  have hR : |rgreenRC κ ρ w₁ x - rgreenRC κ ρ w₂ x| ≤
      (2 * Real.exp (ρ ^ 2) * (2 * D / (1 + x ^ 2))) *
        ∫ s in Set.Ioi (0:ℝ), (s + s ^ 3) * Real.exp (-s) := by
    unfold rgreenRC
    refine s4 _ _ (fun s => (s + s ^ 3) * Real.exp (-s)) (Real.exp (ρ ^ 2)) _ c₁' c₂' s3
      ?_ ?_ ?_
    · intro s hs
      rw [abs_of_pos (Real.exp_pos _)]
      exact (s1 s _ 0 hs.le).1
    · intro s hs
      rw [abs_of_pos (Real.exp_pos _)]
      exact (s1 s _ 0 hs.le).1
    · intro s hs
      have e1 := (s1 s (∫ y in x..(x + s), w₁ y) (∫ y in x..(x + s), w₂ y) hs.le).2
      have e2 := (s2 w₁ w₂ h₁ h₂ D hD x s hs.le).2
      have hpos : 0 ≤ 2 * Real.exp (ρ ^ 2) * Real.exp (-s) := by positivity
      calc _ ≤ _ := e1
        _ ≤ 2 * Real.exp (ρ ^ 2) * Real.exp (-s) * (2 * D / (1 + x ^ 2) * (s + s ^ 3)) :=
            mul_le_mul_of_nonneg_left e2 hpos
        _ = (2 * Real.exp (ρ ^ 2) * (2 * D / (1 + x ^ 2))) * ((s + s ^ 3) * Real.exp (-s)) := by
            ring
  have hw : wfieldC κ ρ w₁ x - wfieldC κ ρ w₂ x = 8 * κ ^ 5 *
      ((rgreenC κ ρ w₁ x - rgreenC κ ρ w₂ x) - (rgreenRC κ ρ w₁ x - rgreenRC κ ρ w₂ x)) := by
    unfold wfieldC; ring
  rw [hw, abs_mul, abs_of_nonneg hk5]
  have htri := abs_sub (rgreenC κ ρ w₁ x - rgreenC κ ρ w₂ x)
    (rgreenRC κ ρ w₁ x - rgreenRC κ ρ w₂ x)
  calc (1 + x ^ 2) * (8 * κ ^ 5 * |rgreenC κ ρ w₁ x - rgreenC κ ρ w₂ x -
        (rgreenRC κ ρ w₁ x - rgreenRC κ ρ w₂ x)|)
      ≤ (1 + x ^ 2) * (8 * κ ^ 5 * (2 * ((2 * Real.exp (ρ ^ 2) * (2 * D / (1 + x ^ 2))) *
        ∫ s in Set.Ioi (0:ℝ), (s + s ^ 3) * Real.exp (-s)))) := by
        gcongr
        linarith
    _ = 64 * κ ^ 5 * Real.exp (ρ ^ 2) * (∫ s in Set.Ioi (0:ℝ), (s + s ^ 3) * Real.exp (-s)) *
        D := by
        field_simp
        ring

theorem wfieldC_continuous_zero (κ ρ : ℝ) (hκ : 1 ≤ κ) (hρ : 0 ≤ ρ) :
    (∀ w : ℝ → ℝ, Continuous w → Continuous (wfieldC κ ρ w)) ∧
    (∀ x : ℝ, wfieldC κ ρ (fun _ => (0 : ℝ)) x = 0) :=
by
  have hbound : ∀ s a : ℝ, 0 ≤ s →
      Real.exp (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) a) ≤
        Real.exp (ρ ^ 2) * Real.exp (-s) := by
    intro s a hs
    have hb : 0 ≤ ρ * Real.sqrt s := mul_nonneg hρ (Real.sqrt_nonneg s)
    have h1 : wclamp (ρ * Real.sqrt s) a ≤ ρ * Real.sqrt s := by
      unfold wclamp
      exact max_le (by linarith) (min_le_right _ _)
    have h2 : 2 * ρ * Real.sqrt s ≤ ρ ^ 2 + Real.sqrt s ^ 2 := two_mul_le_add_sq ρ (Real.sqrt s)
    rw [Real.sq_sqrt hs] at h2
    have h3 : -2 * κ * s ≤ -2 * s := by nlinarith [mul_nonneg (sub_nonneg.2 hκ) hs]
    rw [← Real.exp_add]
    exact Real.exp_le_exp.2 (by linarith)
  have hcontI : ∀ F : ℝ → ℝ → ℝ, Continuous (fun p : ℝ × ℝ => F p.1 p.2) →
      (∀ x s : ℝ, 0 < s → |F x s| ≤ Real.exp (ρ ^ 2) * Real.exp (-s)) →
      Continuous (fun x : ℝ => ∫ s in Set.Ioi (0 : ℝ), F x s) := by
    intro F hF hb
    refine continuous_of_dominated (bound := fun s => Real.exp (ρ ^ 2) * Real.exp (-s))
      (fun x => (hF.comp (continuous_const.prodMk continuous_id)).aestronglyMeasurable)
      (fun x => ?_) (Integrable.const_mul (integrableOn_exp_neg_Ioi 0) _)
      (ae_of_all _ fun s => hF.comp (continuous_id.prodMk continuous_const))
    refine ae_restrict_of_forall_mem measurableSet_Ioi fun s hs => ?_
    rw [Real.norm_eq_abs]
    exact hb x s hs
  have hwcl : Continuous (fun q : ℝ × ℝ => wclamp q.1 q.2) := by
    unfold wclamp
    exact continuous_fst.neg.max (continuous_snd.min continuous_fst)
  refine ⟨fun w hw => ?_, fun x => ?_⟩
  · obtain ⟨P, hPdef⟩ : ∃ P : ℝ → ℝ, P = fun u => ∫ y in (0 : ℝ)..u, w y := ⟨_, rfl⟩
    have hP : Continuous P := by
      rw [hPdef]
      exact intervalIntegral.continuous_primitive (fun a b => hw.intervalIntegrable a b) 0
    have hrepL : ∀ x s : ℝ, (∫ y in (x - s)..x, w y) = P x - P (x - s) := by
      intro x s
      rw [hPdef]
      exact (intervalIntegral.integral_interval_sub_left (hw.intervalIntegrable 0 x)
        (hw.intervalIntegrable 0 (x - s))).symm
    have hrepR : ∀ x s : ℝ, (∫ y in x..(x + s), w y) = P (x + s) - P x := by
      intro x s
      rw [hPdef]
      exact (intervalIntegral.integral_interval_sub_left (hw.intervalIntegrable 0 (x + s))
        (hw.intervalIntegrable 0 x)).symm
    have hL : rgreenC κ ρ w = fun x => ∫ s in Set.Ioi (0 : ℝ),
        Real.exp (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) (P x - P (x - s))) := by
      funext x
      unfold rgreenC
      simp only [hrepL]
    have hR : rgreenRC κ ρ w = fun x => ∫ s in Set.Ioi (0 : ℝ),
        Real.exp (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) (P (x + s) - P x)) := by
      funext x
      unfold rgreenRC
      simp only [hrepR]
    have hsq : Continuous (fun p : ℝ × ℝ => ρ * Real.sqrt p.2) :=
      continuous_const.mul (Real.continuous_sqrt.comp continuous_snd)
    have hcL : Continuous (rgreenC κ ρ w) := by
      rw [hL]
      refine hcontI (fun x s => Real.exp (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s)
        (P x - P (x - s)))) ?_ ?_
      · have hin : Continuous (fun p : ℝ × ℝ => wclamp (ρ * Real.sqrt p.2) (P p.1 - P (p.1 - p.2))) :=
          hwcl.comp (hsq.prodMk ((hP.comp continuous_fst).sub
            (hP.comp (continuous_fst.sub continuous_snd))))
        exact Real.continuous_exp.comp ((continuous_const.mul continuous_snd).add
          (continuous_const.mul hin))
      · intro x s hs
        rw [abs_of_pos (Real.exp_pos _)]
        exact hbound s _ hs.le
    have hcR : Continuous (rgreenRC κ ρ w) := by
      rw [hR]
      refine hcontI (fun x s => Real.exp (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s)
        (P (x + s) - P x))) ?_ ?_
      · have hin : Continuous (fun p : ℝ × ℝ => wclamp (ρ * Real.sqrt p.2) (P (p.1 + p.2) - P p.1)) :=
          hwcl.comp (hsq.prodMk ((hP.comp (continuous_fst.add continuous_snd)).sub
            (hP.comp continuous_fst)))
        exact Real.continuous_exp.comp ((continuous_const.mul continuous_snd).add
          (continuous_const.mul hin))
      · intro x s hs
        rw [abs_of_pos (Real.exp_pos _)]
        exact hbound s _ hs.le
    have hfun : wfieldC κ ρ w = fun x => 8 * κ ^ 5 * (rgreenC κ ρ w x - rgreenRC κ ρ w x) := rfl
    rw [hfun]
    exact continuous_const.mul (hcL.sub hcR)
  · simp [wfieldC, rgreenC, rgreenRC]

theorem wfieldC_eq_wfield (κ ρ : ℝ) (hρ : 0 ≤ ρ) (w : ℝ → ℝ) (hw : Continuous w)
    (hw2 : Integrable (fun x => w x ^ 2) (volume : Measure ℝ))
    (hE : ∫ x : ℝ, w x ^ 2 ≤ ρ ^ 2) :
    ∀ x : ℝ, wfieldC κ ρ w x = wfield κ w x :=
by
  
  have hCS : ∀ a b : ℝ, a ≤ b →
      (∫ y in a..b, w y) ^ 2 ≤ (b - a) * ∫ y in a..b, w y ^ 2 := by
    intro a b hab
    have hg : 0 ≤ ∫ y in a..b, ((b - a) * w y - ∫ z in a..b, w z) ^ 2 :=
      intervalIntegral.integral_nonneg hab (fun u _ => sq_nonneg _)
    have hexp : (∫ y in a..b, ((b - a) * w y - ∫ z in a..b, w z) ^ 2) =
        (b - a) ^ 2 * (∫ y in a..b, w y ^ 2)
          - (2 * (b - a) * ∫ z in a..b, w z) * (∫ y in a..b, w y)
          + (b - a) * (∫ z in a..b, w z) ^ 2 := by
      have e : (fun y => ((b - a) * w y - ∫ z in a..b, w z) ^ 2) =
          fun y => ((b - a) ^ 2 * w y ^ 2 - (2 * (b - a) * ∫ z in a..b, w z) * w y)
            + (∫ z in a..b, w z) ^ 2 := by
        funext y; ring
      rw [e, intervalIntegral.integral_add, intervalIntegral.integral_sub,
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const, smul_eq_mul]
      all_goals exact Continuous.intervalIntegrable (by fun_prop) _ _
    rw [hexp] at hg
    rcases eq_or_lt_of_le hab with h | h
    · subst h
      simp
    · have hL : 0 < b - a := by linarith
      by_contra hcon
      push_neg at hcon
      nlinarith [mul_lt_mul_of_pos_left hcon hL]
  
  have hwin : ∀ a b : ℝ, a ≤ b → (∫ y in a..b, w y ^ 2) ≤ ρ ^ 2 := by
    intro a b hab
    rw [intervalIntegral.integral_of_le hab]
    exact (setIntegral_le_integral hw2
      (Filter.Eventually.of_forall fun y => sq_nonneg (w y))).trans hE
  
  have hbd : ∀ a b : ℝ, a ≤ b → |∫ y in a..b, w y| ≤ ρ * Real.sqrt (b - a) := by
    intro a b hab
    have h1 := hCS a b hab
    have h2 := hwin a b hab
    have hs : 0 ≤ b - a := by linarith
    have h3 : (∫ y in a..b, w y) ^ 2 ≤ (ρ * Real.sqrt (b - a)) ^ 2 := by
      rw [mul_pow, Real.sq_sqrt hs]
      nlinarith [mul_le_mul_of_nonneg_left h2 hs]
    exact abs_le.2 (abs_le_of_sq_le_sq' h3 (mul_nonneg hρ (Real.sqrt_nonneg _)))
  
  have key : ∀ F : ℝ → ℝ, (∀ s : ℝ, 0 < s → |F s| ≤ ρ * Real.sqrt s) →
      (∫ s in Set.Ioi (0 : ℝ),
          Real.exp (-2 * κ * s + 2 * wclamp (ρ * Real.sqrt s) (F s))) =
        ∫ s in Set.Ioi (0 : ℝ), Real.exp (-2 * κ * s + 2 * F s) := by
    intro F hF
    refine setIntegral_congr_fun measurableSet_Ioi (fun s hs => ?_)
    have h := abs_le.1 (hF s hs)
    simp only [wclamp, min_eq_left h.2, max_eq_right h.1]
  intro x
  have e1 : rgreenC κ ρ w x = rgreen κ w x := by
    unfold rgreenC rgreen
    exact key (fun s => ∫ y in (x - s)..x, w y) (fun s hs => by
      have h := hbd (x - s) x (by linarith)
      rwa [sub_sub_cancel] at h)
  have e2 : rgreenRC κ ρ w x = rgreenR κ w x := by
    unfold rgreenRC rgreenR
    exact key (fun s => ∫ y in x..(x + s), w y) (fun s hs => by
      have h := hbd x (x + s) (by linarith)
      rwa [add_sub_cancel_left] at h)
  unfold wfieldC wfield
  rw [e1, e2]

theorem wfield_energy_orthogonal (κ : ℝ) (hκ : 0 < κ) (w : ℝ → ℝ) (hw : Continuous w)
    (hm : ∃ m : ℝ, ∀ x : ℝ, (1 + x ^ 2) * |w x| ≤ m) :
    ∫ x : ℝ, w x * wfield κ w x = 0 :=
by
  obtain ⟨m, hm⟩ := hm
  
  have hwi : Integrable w (volume : Measure ℝ) := by
    refine Integrable.mono' (integrable_inv_one_add_sq.const_mul m) hw.aestronglyMeasurable
      (ae_of_all _ fun x => ?_)
    have hp : (0 : ℝ) < 1 + x ^ 2 := by positivity
    rw [Real.norm_eq_abs, ← div_eq_mul_inv, le_div_iff₀ hp]
    linarith [hm x, mul_comm (|w x|) (1 + x ^ 2)]
  
  obtain ⟨P, hPdef⟩ : ∃ P : ℝ → ℝ, P = fun u => ∫ y in (0 : ℝ)..u, w y := ⟨_, rfl⟩
  have hPd : ∀ u : ℝ, HasDerivAt P (w u) u := by
    intro u; rw [hPdef]; exact (hw.integral_hasStrictDerivAt 0 u).hasDerivAt
  have hPc : Continuous P := continuous_iff_continuousAt.2 fun u => (hPd u).continuousAt
  have hwin : ∀ a b : ℝ, ∫ y in a..b, w y = P b - P a := by
    intro a b
    rw [hPdef]
    exact (intervalIntegral.integral_interval_sub_left (hw.intervalIntegrable 0 b)
      (hw.intervalIntegrable 0 a)).symm
  
  obtain ⟨A₀, hA₀⟩ : ∃ A₀ : ℝ, A₀ = ∫ y, |w y| := ⟨_, rfl⟩
  have hbd : ∀ a b : ℝ, |∫ y in a..b, w y| ≤ A₀ := by
    have key : ∀ a b : ℝ, a ≤ b → |∫ y in a..b, w y| ≤ A₀ := by
      intro a b hab
      refine (intervalIntegral.abs_integral_le_integral_abs hab).trans ?_
      rw [intervalIntegral.integral_of_le hab, hA₀]
      exact setIntegral_le_integral hwi.abs (ae_of_all _ fun y => abs_nonneg (w y))
    intro a b
    rcases le_total a b with hab | hab
    · exact key a b hab
    · rw [intervalIntegral.integral_symm, abs_neg]; exact key b a hab
  
  have htop : ∀ s : ℝ, Filter.Tendsto (fun x : ℝ => ∫ y in (x - s)..x, w y)
      Filter.atTop (nhds 0) := by
    intro s
    have h1 : Filter.Tendsto P Filter.atTop (nhds (∫ y in Set.Ioi (0 : ℝ), w y)) := by
      rw [hPdef]
      exact intervalIntegral_tendsto_integral_Ioi 0 hwi.integrableOn Filter.tendsto_id
    have hs : Filter.Tendsto (fun x : ℝ => x - s) Filter.atTop Filter.atTop := by
      simpa [sub_eq_add_neg] using
        Filter.tendsto_atTop_add_const_right Filter.atTop (-s) Filter.tendsto_id
    have h2 := h1.sub (h1.comp hs)
    rw [sub_self] at h2
    refine h2.congr (fun x => ?_)
    simp only [Function.comp_apply]
    rw [hwin]
  have hbot : ∀ s : ℝ, Filter.Tendsto (fun x : ℝ => ∫ y in (x - s)..x, w y)
      Filter.atBot (nhds 0) := by
    intro s
    have h1 : Filter.Tendsto (fun x : ℝ => ∫ y in x..(0 : ℝ), w y) Filter.atBot
        (nhds (∫ y in Set.Iic (0 : ℝ), w y)) :=
      intervalIntegral_tendsto_integral_Iic 0 hwi.integrableOn Filter.tendsto_id
    have hs : Filter.Tendsto (fun x : ℝ => x - s) Filter.atBot Filter.atBot := by
      simpa [sub_eq_add_neg] using
        Filter.tendsto_atBot_add_const_right Filter.atBot (-s) Filter.tendsto_id
    have h2 := (h1.comp hs).sub h1
    rw [sub_self] at h2
    refine h2.congr (fun x => ?_)
    simp only [Function.comp_apply]
    rw [hwin, hwin, hwin]
    ring
  
  have hfub : ∀ (E : ℝ → ℝ → ℝ), Continuous (fun p : ℝ × ℝ => E p.1 p.2) → ∀ M : ℝ,
      (∀ x s : ℝ, |E x s| ≤ M) →
      Integrable (fun x : ℝ => w x * ∫ s in Set.Ioi (0 : ℝ), Real.exp (-2 * κ * s + E x s))
        (volume : Measure ℝ) ∧
      ∫ x : ℝ, w x * ∫ s in Set.Ioi (0 : ℝ), Real.exp (-2 * κ * s + E x s) =
        ∫ s in Set.Ioi (0 : ℝ), ∫ x : ℝ, w x * Real.exp (-2 * κ * s + E x s) := by
    intro E hE M hM
    have hF : Integrable (Function.uncurry fun x s => w x * Real.exp (-2 * κ * s + E x s))
        ((volume : Measure ℝ).prod (volume.restrict (Set.Ioi (0 : ℝ)))) := by
      have hc : Continuous (Function.uncurry fun x s => w x * Real.exp (-2 * κ * s + E x s)) := by
        show Continuous (fun p : ℝ × ℝ => w p.1 * Real.exp (-2 * κ * p.2 + E p.1 p.2))
        exact (hw.comp continuous_fst).mul
          (Real.continuous_exp.comp ((continuous_const.mul continuous_snd).add hE))
      have hG : Integrable (fun p : ℝ × ℝ => |w p.1| * (Real.exp M * Real.exp (-(2 * κ) * p.2)))
          ((volume : Measure ℝ).prod (volume.restrict (Set.Ioi (0 : ℝ)))) :=
        Integrable.mul_prod hwi.abs
          ((exp_neg_integrableOn_Ioi 0 (by linarith : (0 : ℝ) < 2 * κ)).const_mul (Real.exp M))
      refine hG.mono' hc.aestronglyMeasurable (ae_of_all _ fun p => ?_)
      show ‖w p.1 * Real.exp (-2 * κ * p.2 + E p.1 p.2)‖ ≤
        |w p.1| * (Real.exp M * Real.exp (-(2 * κ) * p.2))
      rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _),
        ← Real.exp_add]
      refine mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 ?_) (abs_nonneg _)
      have := (le_abs_self (E p.1 p.2)).trans (hM p.1 p.2)
      linarith
    have hswap := MeasureTheory.integral_integral_swap hF
    have hI := hF.integral_prod_left
    have hpull : ∀ x : ℝ, ∫ s in Set.Ioi (0 : ℝ), w x * Real.exp (-2 * κ * s + E x s) =
        w x * ∫ s in Set.Ioi (0 : ℝ), Real.exp (-2 * κ * s + E x s) :=
      fun x => integral_const_mul _ _
    simp only [Function.uncurry_apply_pair, hpull] at hswap hI
    exact ⟨hI, hswap⟩
  
  have hslice : ∀ c s : ℝ, ∫ x : ℝ, w x * Real.exp (c + 2 * ∫ y in (x - s)..x, w y) =
      ∫ x : ℝ, w x * Real.exp (c + 2 * ∫ y in x..(x + s), w y) := by
    intro c s
    obtain ⟨A, hAdef⟩ : ∃ A : ℝ → ℝ, A = fun x => ∫ y in (x - s)..x, w y := ⟨_, rfl⟩
    have htr : ∫ x : ℝ, w x * Real.exp (c + 2 * ∫ y in x..(x + s), w y) =
        ∫ x : ℝ, w (x - s) * Real.exp (c + 2 * A x) := by
      have := integral_sub_right_eq_self (μ := (volume : Measure ℝ))
        (fun x => w x * Real.exp (c + 2 * ∫ y in x..(x + s), w y)) s
      simp only [sub_add_cancel] at this
      rw [← this, hAdef]
    suffices key : ∫ x : ℝ, w x * Real.exp (c + 2 * A x) =
        ∫ x : ℝ, w (x - s) * Real.exp (c + 2 * A x) by
      rw [htr, ← key, hAdef]
    have hAd : ∀ x : ℝ, HasDerivAt A (w x - w (x - s)) x := by
      intro x
      have e : A = fun x => P x - P (x - s) := by
        rw [hAdef]; funext x; exact hwin _ _
      rw [e]
      exact (hPd x).sub ((hPd (x - s)).comp_sub_const x s)
    have hAc : Continuous A := continuous_iff_continuousAt.2 fun x => (hAd x).continuousAt
    have hAb : ∀ x : ℝ, A x ≤ A₀ := fun x => by
      rw [hAdef]; exact (le_abs_self _).trans (hbd _ _)
    have hK : ∀ x : ℝ, ‖Real.exp (c + 2 * A x)‖ ≤ Real.exp (c + 2 * A₀) := fun x => by
      rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      exact Real.exp_le_exp.2 (by linarith [hAb x])
    have hec : Continuous (fun x => Real.exp (c + 2 * A x)) :=
      Real.continuous_exp.comp (continuous_const.add (continuous_const.mul hAc))
    have hg₁ : Integrable (fun x => w x * Real.exp (c + 2 * A x)) (volume : Measure ℝ) := by
      refine (hwi.abs.const_mul (Real.exp (c + 2 * A₀))).mono' (hw.mul hec).aestronglyMeasurable
        (ae_of_all _ fun x => ?_)
      have h1 := hK x
      have h2 := abs_nonneg (w x)
      rw [norm_mul, Real.norm_eq_abs]
      nlinarith
    have hg₂ : Integrable (fun x => w (x - s) * Real.exp (c + 2 * A x)) (volume : Measure ℝ) := by
      refine ((hwi.comp_sub_right s).abs.const_mul (Real.exp (c + 2 * A₀))).mono'
        ((hw.comp (continuous_id.sub continuous_const)).mul hec).aestronglyMeasurable
        (ae_of_all _ fun x => ?_)
      have h1 := hK x
      have h2 := abs_nonneg (w (x - s))
      rw [norm_mul, Real.norm_eq_abs]
      nlinarith
    have hhd : ∀ x : ℝ, HasDerivAt (fun x => Real.exp (c + 2 * A x))
        (2 * (w x * Real.exp (c + 2 * A x)) - 2 * (w (x - s) * Real.exp (c + 2 * A x))) x := by
      intro x
      have := (((hAd x).const_mul 2).const_add c).exp
      convert this using 1
      ring
    have hlim : ∀ l : Filter ℝ, Filter.Tendsto A l (nhds 0) →
        Filter.Tendsto (fun x => Real.exp (c + 2 * A x)) l (nhds (Real.exp c)) := by
      intro l hl
      have := (hl.const_mul 2).const_add c
      rw [mul_zero, add_zero] at this
      exact (Real.continuous_exp.tendsto c).comp this
    have hAtop : Filter.Tendsto A Filter.atTop (nhds 0) := by rw [hAdef]; exact htop s
    have hAbot : Filter.Tendsto A Filter.atBot (nhds 0) := by rw [hAdef]; exact hbot s
    have hint : Integrable (fun x => 2 * (w x * Real.exp (c + 2 * A x)) -
        2 * (w (x - s) * Real.exp (c + 2 * A x))) (volume : Measure ℝ) :=
      (hg₁.const_mul 2).sub (hg₂.const_mul 2)
    have hftc := integral_of_hasDerivAt_of_tendsto hhd hint (hlim _ hAbot) (hlim _ hAtop)
    have e1 : ∫ x, (2 * (w x * Real.exp (c + 2 * A x)) -
        2 * (w (x - s) * Real.exp (c + 2 * A x))) =
        (2 * ∫ x, w x * Real.exp (c + 2 * A x)) -
          2 * ∫ x, w (x - s) * Real.exp (c + 2 * A x) := by
      rw [integral_sub (hg₁.const_mul 2) (hg₂.const_mul 2), integral_const_mul,
        integral_const_mul]
    rw [e1, sub_self] at hftc
    linarith
  
  have hcA : Continuous (fun p : ℝ × ℝ => 2 * ∫ y in (p.1 - p.2)..p.1, w y) := by
    have e : (fun p : ℝ × ℝ => 2 * ∫ y in (p.1 - p.2)..p.1, w y) =
        fun p => 2 * (P p.1 - P (p.1 - p.2)) := by
      funext p; rw [hwin]
    rw [e]
    exact continuous_const.mul
      ((hPc.comp continuous_fst).sub (hPc.comp (continuous_fst.sub continuous_snd)))
  have hcB : Continuous (fun p : ℝ × ℝ => 2 * ∫ y in p.1..(p.1 + p.2), w y) := by
    have e : (fun p : ℝ × ℝ => 2 * ∫ y in p.1..(p.1 + p.2), w y) =
        fun p => 2 * (P (p.1 + p.2) - P p.1) := by
      funext p; rw [hwin]
    rw [e]
    exact continuous_const.mul
      ((hPc.comp (continuous_fst.add continuous_snd)).sub (hPc.comp continuous_fst))
  have hM₁ : ∀ x s : ℝ, |2 * ∫ y in (x - s)..x, w y| ≤ 2 * A₀ := by
    intro x s
    rw [abs_mul, abs_two]
    linarith [hbd (x - s) x]
  have hM₂ : ∀ x s : ℝ, |2 * ∫ y in x..(x + s), w y| ≤ 2 * A₀ := by
    intro x s
    rw [abs_mul, abs_two]
    linarith [hbd x (x + s)]
  obtain ⟨hI₁, hF₁⟩ := hfub (fun x s => 2 * ∫ y in (x - s)..x, w y) hcA (2 * A₀) hM₁
  obtain ⟨hI₂, hF₂⟩ := hfub (fun x s => 2 * ∫ y in x..(x + s), w y) hcB (2 * A₀) hM₂
  have hI₁' : Integrable (fun x => w x * rgreen κ w x) (volume : Measure ℝ) := hI₁
  have hI₂' : Integrable (fun x => w x * rgreenR κ w x) (volume : Measure ℝ) := hI₂
  have heq : ∫ x, w x * rgreen κ w x = ∫ x, w x * rgreenR κ w x := by
    refine hF₁.trans (Eq.trans ?_ hF₂.symm)
    congr 1
    funext s
    exact hslice _ _
  have hfield : (fun x => w x * wfield κ w x) =
      fun x => 8 * κ ^ 5 * (w x * rgreen κ w x) - 8 * κ ^ 5 * (w x * rgreenR κ w x) := by
    funext x; simp only [wfield]; ring
  rw [hfield, integral_sub (hI₁'.const_mul _) (hI₂'.const_mul _), integral_const_mul,
    integral_const_mul, heq, sub_self]

theorem deriv_zero_below_bootstrap (g D : ℝ → ℝ) (c : ℝ)
    (hg : ∀ t : ℝ, HasDerivAt g (D t) t) (h0 : g 0 < c)
    (hD : ∀ t : ℝ, g t ≤ c → D t = 0) : ∀ t : ℝ, g t = g 0 :=
by
  have hcont : Continuous g := continuous_iff_continuousAt.2 fun t => (hg t).continuousAt
  have hclosed : IsClosed {t : ℝ | g t = g 0} := isClosed_eq hcont continuous_const
  have hopen : IsOpen {t : ℝ | g t = g 0} := by
    rw [Metric.isOpen_iff]
    intro t ht
    have ht' : g t = g 0 := ht
    have hlt : g t < c := by rw [ht']; exact h0
    have hev : ∀ᶠ s in nhds t, g s < c :=
      (hcont.continuousAt (x := t)).eventually (gt_mem_nhds hlt)
    obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff_ball.1 hev
    refine ⟨ε, hε, fun s hs => ?_⟩
    have key := (convex_ball t ε).norm_image_sub_le_of_norm_hasDerivWithin_le
      (f := g) (f' := D) (C := 0)
      (fun x _ => (hg x).hasDerivWithinAt)
      (fun x hx => by rw [hD x (hball x hx).le, norm_zero])
      (Metric.mem_ball_self hε) hs
    rw [zero_mul] at key
    have h2 : ‖g s - g t‖ = 0 := le_antisymm key (norm_nonneg _)
    rw [norm_eq_zero, sub_eq_zero] at h2
    show g s = g 0
    rw [h2, ht']
  have hclopen : IsClopen {t : ℝ | g t = g 0} := ⟨hclosed, hopen⟩
  have huniv : {t : ℝ | g t = g 0} = Set.univ := hclopen.eq_univ ⟨0, rfl⟩
  intro t
  have hmem : t ∈ {t : ℝ | g t = g 0} := by rw [huniv]; exact Set.mem_univ t
  exact hmem

theorem bcf_weighted_energy_hasDerivAt (γ : ℝ → BoundedContinuousFunction ℝ ℝ)
    (γ' : BoundedContinuousFunction ℝ ℝ) (t : ℝ) (hγ : HasDerivAt γ γ' t) :
    HasDerivAt (fun τ : ℝ => ∫ x : ℝ, (γ τ x / (1 + x ^ 2)) ^ 2)
      (2 * ∫ x : ℝ, (γ t x / (1 + x ^ 2)) * (γ' x / (1 + x ^ 2))) t :=
by
  have hP : ∀ (f g : BoundedContinuousFunction ℝ ℝ) (x : ℝ),
      ‖(f x / (1 + x ^ 2)) * (g x / (1 + x ^ 2))‖ ≤ ‖f‖ * ‖g‖ * (1 + x ^ 2)⁻¹ := by
    intro f g x
    have hp : (0 : ℝ) < 1 + x ^ 2 := by positivity
    have hp1 : (1 : ℝ) ≤ 1 + x ^ 2 := by nlinarith [sq_nonneg x]
    have hf := f.norm_coe_le_norm x
    have hg := g.norm_coe_le_norm x
    rw [Real.norm_eq_abs] at hf hg ⊢
    rw [abs_mul, abs_div, abs_div, abs_of_pos hp, div_eq_mul_inv, div_eq_mul_inv]
    have hinv : (1 + x ^ 2)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hp1
    have hinv0 : 0 ≤ (1 + x ^ 2)⁻¹ := inv_nonneg.2 hp.le
    have h1 : |f x| * |g x| ≤ ‖f‖ * ‖g‖ := mul_le_mul hf hg (abs_nonneg _) (norm_nonneg _)
    calc |f x| * (1 + x ^ 2)⁻¹ * (|g x| * (1 + x ^ 2)⁻¹)
        = (|f x| * |g x|) * ((1 + x ^ 2)⁻¹ * (1 + x ^ 2)⁻¹) := by ring
      _ ≤ (‖f‖ * ‖g‖) * ((1 + x ^ 2)⁻¹ * 1) :=
          mul_le_mul h1 (mul_le_mul_of_nonneg_left hinv hinv0) (by positivity) (by positivity)
      _ = ‖f‖ * ‖g‖ * (1 + x ^ 2)⁻¹ := by ring
  have hcont : ∀ f g : BoundedContinuousFunction ℝ ℝ,
      Continuous (fun x : ℝ => (f x / (1 + x ^ 2)) * (g x / (1 + x ^ 2))) := by
    intro f g
    have hp : ∀ x : ℝ, (1 + x ^ 2) ≠ 0 := fun x => by positivity
    exact (f.continuous.div (by fun_prop) hp).mul (g.continuous.div (by fun_prop) hp)
  have hint : ∀ f g : BoundedContinuousFunction ℝ ℝ,
      Integrable (fun x : ℝ => (f x / (1 + x ^ 2)) * (g x / (1 + x ^ 2))) volume :=
    fun f g => Integrable.mono' (integrable_inv_one_add_sq.const_mul (‖f‖ * ‖g‖))
      (hcont f g).aestronglyMeasurable (ae_of_all _ (hP f g))
  have hbd : ∀ f g : BoundedContinuousFunction ℝ ℝ,
      ‖∫ x : ℝ, (f x / (1 + x ^ 2)) * (g x / (1 + x ^ 2))‖ ≤ Real.pi * ‖f‖ * ‖g‖ := by
    intro f g
    have h := norm_integral_le_of_norm_le (integrable_inv_one_add_sq.const_mul (‖f‖ * ‖g‖))
      (ae_of_all _ (hP f g))
    rw [integral_const_mul, integral_univ_inv_one_add_sq] at h
    linarith
  let L : BoundedContinuousFunction ℝ ℝ →ₗ[ℝ] BoundedContinuousFunction ℝ ℝ →ₗ[ℝ] ℝ :=
    LinearMap.mk₂ ℝ (fun f g => ∫ x : ℝ, (f x / (1 + x ^ 2)) * (g x / (1 + x ^ 2)))
      (fun f₁ f₂ g => by
        simp only [BoundedContinuousFunction.add_apply]
        rw [← integral_add (hint f₁ g) (hint f₂ g)]
        congr 1; funext x; ring)
      (fun c f g => by
        simp only [BoundedContinuousFunction.smul_apply, smul_eq_mul]
        rw [← integral_const_mul]
        congr 1; funext x; ring)
      (fun f g₁ g₂ => by
        simp only [BoundedContinuousFunction.add_apply]
        rw [← integral_add (hint f g₁) (hint f g₂)]
        congr 1; funext x; ring)
      (fun c f g => by
        simp only [BoundedContinuousFunction.smul_apply, smul_eq_mul]
        rw [← integral_const_mul]
        congr 1; funext x; ring)
  let B := L.mkContinuous₂ Real.pi (fun f g => hbd f g)
  have hB : ∀ f g : BoundedContinuousFunction ℝ ℝ,
      B f g = ∫ x : ℝ, (f x / (1 + x ^ 2)) * (g x / (1 + x ^ 2)) := fun f g => rfl
  have h := ContinuousLinearMap.hasDerivAt_of_bilinear (B := B) hγ hγ
  have hfun : (fun τ : ℝ => B (γ τ) (γ τ)) = fun τ : ℝ => ∫ x : ℝ, (γ τ x / (1 + x ^ 2)) ^ 2 := by
    funext τ
    rw [hB]
    congr 1; funext x; ring
  have hder : B (γ t) γ' + B γ' (γ t) =
      2 * ∫ x : ℝ, (γ t x / (1 + x ^ 2)) * (γ' x / (1 + x ^ 2)) := by
    rw [hB, hB]
    have e : (∫ x : ℝ, (γ' x / (1 + x ^ 2)) * (γ t x / (1 + x ^ 2))) =
        ∫ x : ℝ, (γ t x / (1 + x ^ 2)) * (γ' x / (1 + x ^ 2)) := by
      congr 1; funext x; ring
    rw [e]; ring
  rw [hfun] at h
  exact h.congr_deriv hder

theorem wflow_integral_exists (κ : ℝ) (hκ : 1 ≤ κ) (v₀ : 𝓢(ℝ, ℝ)) :
    ∃ v : ℝ → ℝ → ℝ, (∀ x : ℝ, v 0 x = v₀ x) ∧ (∀ t : ℝ, Continuous (v t)) ∧
      (∀ T : ℝ, ∃ M : ℝ, ∀ t : ℝ, |t| ≤ T → ∀ x : ℝ, (1 + x ^ 2) * |v t x| ≤ M) ∧
      (∀ T : ℝ, ∃ K : ℝ, ∀ s t : ℝ, |s| ≤ T → |t| ≤ T → ∀ x : ℝ,
        (1 + x ^ 2) * |v s x - v t x| ≤ K * |s - t|) ∧
      (∀ t x : ℝ, v t x = v₀ x + ∫ s in (0 : ℝ)..t, wfield κ (v s) x) :=
by
  classical
  
  obtain ⟨C₀, -, hC₀⟩ := v₀.decay 0 0
  obtain ⟨C₂, -, hC₂⟩ := v₀.decay 2 0
  have hv0b : ∀ x : ℝ, |v₀ x| ≤ C₀ := by
    intro x
    have h := hC₀ x
    rw [pow_zero, one_mul, norm_iteratedFDeriv_zero, Real.norm_eq_abs] at h
    exact h
  have hv2b : ∀ x : ℝ, x ^ 2 * |v₀ x| ≤ C₂ := by
    intro x
    have h := hC₂ x
    rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs, Real.norm_eq_abs, sq_abs] at h
    exact h
  have hf₀b : ∀ x : ℝ, ‖(1 + x ^ 2) * v₀ x‖ ≤ C₀ + C₂ := by
    intro x
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 1 + x ^ 2)]
    have e : (1 + x ^ 2) * |v₀ x| = |v₀ x| + x ^ 2 * |v₀ x| := by ring
    rw [e]
    linarith [hv0b x, hv2b x]
  have hpoly : Continuous fun x : ℝ => 1 + x ^ 2 := continuous_const.add (continuous_pow 2)
  let f₀ : BoundedContinuousFunction ℝ ℝ :=
    BoundedContinuousFunction.ofNormedAddCommGroup (fun x => (1 + x ^ 2) * v₀ x)
      (hpoly.mul v₀.continuous) (C₀ + C₂) hf₀b
  have hf₀ : ∀ x : ℝ, f₀ x = (1 + x ^ 2) * v₀ x := fun x => rfl
  
  obtain ⟨I₀, hI₀⟩ : ∃ I₀ : ℝ, I₀ = ∫ x : ℝ, v₀ x ^ 2 := ⟨_, rfl⟩
  have hI₀0 : 0 ≤ I₀ := by rw [hI₀]; exact integral_nonneg fun x => sq_nonneg _
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ℝ, ρ = Real.sqrt I₀ + 1 := ⟨_, rfl⟩
  have hρ : 0 ≤ ρ := by rw [hρdef]; positivity
  have hIρ : I₀ < ρ ^ 2 := by
    have hs := Real.sq_sqrt hI₀0
    have hs0 := Real.sqrt_nonneg I₀
    rw [hρdef]
    nlinarith
  
  obtain ⟨L, hL0, hLip⟩ := wfieldC_weighted_lipschitz κ ρ hκ hρ
  obtain ⟨hcont, hzero⟩ := wfieldC_continuous_zero κ ρ hκ hρ
  
  have hwf : ∀ f : BoundedContinuousFunction ℝ ℝ, Continuous (fun y : ℝ => f y / (1 + y ^ 2)) :=
    fun f => f.continuous.div hpoly (fun y => by positivity)
  have hwfb : ∀ (f : BoundedContinuousFunction ℝ ℝ) (y : ℝ),
      (1 + y ^ 2) * |f y / (1 + y ^ 2)| = |f y| := by
    intro f y
    have hp : (0 : ℝ) < 1 + y ^ 2 := by positivity
    rw [abs_div, abs_of_pos hp, mul_div_cancel₀ _ hp.ne']
  have hnc : ∀ (f : BoundedContinuousFunction ℝ ℝ) (y : ℝ), |f y| ≤ ‖f‖ := by
    intro f y
    have h := f.norm_coe_le_norm y
    rwa [Real.norm_eq_abs] at h
  have hΦb : ∀ (f : BoundedContinuousFunction ℝ ℝ) (x : ℝ),
      ‖(1 + x ^ 2) * wfieldC κ ρ (fun y => f y / (1 + y ^ 2)) x‖ ≤ L * ‖f‖ := by
    intro f x
    have h := hLip (fun y => f y / (1 + y ^ 2)) (fun _ => (0 : ℝ)) (hwf f) continuous_const ‖f‖
      (fun y => by
        rw [sub_zero, hwfb]
        exact hnc f y) x
    rw [hzero x, sub_zero] at h
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 1 + x ^ 2)]
    exact h
  let Φ : BoundedContinuousFunction ℝ ℝ → BoundedContinuousFunction ℝ ℝ := fun f =>
    BoundedContinuousFunction.ofNormedAddCommGroup
      (fun x => (1 + x ^ 2) * wfieldC κ ρ (fun y => f y / (1 + y ^ 2)) x)
      (hpoly.mul (hcont _ (hwf f))) (L * ‖f‖) (hΦb f)
  have hΦ : ∀ (f : BoundedContinuousFunction ℝ ℝ) (x : ℝ),
      Φ f x = (1 + x ^ 2) * wfieldC κ ρ (fun y => f y / (1 + y ^ 2)) x := fun f x => rfl
  have hΦL : LipschitzWith ⟨L, hL0⟩ Φ := by
    refine LipschitzWith.of_dist_le_mul fun f g => ?_
    rw [NNReal.coe_mk]
    refine (BoundedContinuousFunction.dist_le (mul_nonneg hL0 dist_nonneg)).2 fun x => ?_
    rw [hΦ, hΦ, Real.dist_eq, ← mul_sub, abs_mul,
      abs_of_pos (by positivity : (0 : ℝ) < 1 + x ^ 2)]
    refine hLip _ _ (hwf f) (hwf g) (dist f g) (fun y => ?_) x
    have hp : (0 : ℝ) < 1 + y ^ 2 := by positivity
    rw [← sub_div, abs_div, abs_of_pos hp, mul_div_cancel₀ _ hp.ne', ← Real.dist_eq]
    exact BoundedContinuousFunction.dist_coe_le_dist y
  
  obtain ⟨γ, hγ0, hγ⟩ := lipschitz_ode_global Φ ⟨L, hL0⟩ hΦL f₀
  have hγc : Continuous γ := continuous_iff_continuousAt.2 fun t => (hγ t).continuousAt
  have hΦγc : Continuous fun τ => Φ (γ τ) := hΦL.continuous.comp hγc
  
  have hvc : ∀ t : ℝ, Continuous (fun x : ℝ => γ t x / (1 + x ^ 2)) := fun t => hwf (γ t)
  have hvb : ∀ (t x : ℝ), (1 + x ^ 2) * |γ t x / (1 + x ^ 2)| ≤ ‖γ t‖ := by
    intro t x
    rw [hwfb]
    exact hnc (γ t) x
  have hvi : ∀ t : ℝ, Integrable (fun x : ℝ => (γ t x / (1 + x ^ 2)) ^ 2) volume := by
    intro t
    refine Integrable.mono' (integrable_inv_one_add_sq.const_mul (‖γ t‖ ^ 2))
      ((hvc t).pow 2).aestronglyMeasurable (ae_of_all _ fun x => ?_)
    have hp : (0 : ℝ) < 1 + x ^ 2 := by positivity
    have h2 : |γ t x| ^ 2 ≤ ‖γ t‖ ^ 2 := pow_le_pow_left₀ (abs_nonneg _) (hnc (γ t) x) 2
    rw [Real.norm_eq_abs, abs_pow, abs_div, abs_of_pos hp, div_pow,
      div_le_iff₀ (by positivity)]
    have h3 : ‖γ t‖ ^ 2 * (1 + x ^ 2)⁻¹ * (1 + x ^ 2) ^ 2 =
        ‖γ t‖ ^ 2 * ((1 + x ^ 2)⁻¹ * (1 + x ^ 2)) * (1 + x ^ 2) := by ring
    rw [h3, inv_mul_cancel₀ hp.ne', mul_one]
    nlinarith [mul_nonneg (sq_nonneg ‖γ t‖) (sq_nonneg x)]
  have hgd : ∀ t : ℝ, HasDerivAt (fun τ : ℝ => ∫ x : ℝ, (γ τ x / (1 + x ^ 2)) ^ 2)
      (2 * ∫ x : ℝ, (γ t x / (1 + x ^ 2)) * wfieldC κ ρ (fun y => γ t y / (1 + y ^ 2)) x) t := by
    intro t
    have h := bcf_weighted_energy_hasDerivAt γ (Φ (γ t)) t (hγ t)
    have he : (fun x : ℝ => (γ t x / (1 + x ^ 2)) * (Φ (γ t) x / (1 + x ^ 2))) =
        fun x => (γ t x / (1 + x ^ 2)) * wfieldC κ ρ (fun y => γ t y / (1 + y ^ 2)) x := by
      funext x
      rw [hΦ, mul_div_cancel_left₀ _ (by positivity : (1 : ℝ) + x ^ 2 ≠ 0)]
    rw [he] at h
    exact h
  have hDz : ∀ t : ℝ, (∫ x : ℝ, (γ t x / (1 + x ^ 2)) ^ 2) ≤ ρ ^ 2 →
      2 * ∫ x : ℝ, (γ t x / (1 + x ^ 2)) * wfieldC κ ρ (fun y => γ t y / (1 + y ^ 2)) x = 0 := by
    intro t ht
    have heq := wfieldC_eq_wfield κ ρ hρ (fun y => γ t y / (1 + y ^ 2)) (hvc t) (hvi t) ht
    have horth : ∫ x : ℝ, γ t x / (1 + x ^ 2) * wfield κ (fun y => γ t y / (1 + y ^ 2)) x = 0 :=
      wfield_energy_orthogonal κ (by linarith) (fun y => γ t y / (1 + y ^ 2)) (hvc t)
        ⟨‖γ t‖, hvb t⟩
    have hfun : (fun x : ℝ => γ t x / (1 + x ^ 2) * wfieldC κ ρ (fun y => γ t y / (1 + y ^ 2)) x) =
        fun x => γ t x / (1 + x ^ 2) * wfield κ (fun y => γ t y / (1 + y ^ 2)) x := by
      funext x
      rw [heq x]
    rw [hfun, horth, mul_zero]
  have hg0 : (∫ x : ℝ, (γ 0 x / (1 + x ^ 2)) ^ 2) = I₀ := by
    rw [hγ0, hI₀]
    congr 1
    funext x
    rw [hf₀, mul_div_cancel_left₀ _ (by positivity : (1 : ℝ) + x ^ 2 ≠ 0)]
  have hconst := deriv_zero_below_bootstrap (fun τ => ∫ x : ℝ, (γ τ x / (1 + x ^ 2)) ^ 2)
    (fun t => 2 * ∫ x : ℝ, (γ t x / (1 + x ^ 2)) * wfieldC κ ρ (fun y => γ t y / (1 + y ^ 2)) x)
    (ρ ^ 2) hgd (by show (∫ x : ℝ, (γ 0 x / (1 + x ^ 2)) ^ 2) < ρ ^ 2; rw [hg0]; exact hIρ) hDz
  have hact : ∀ (t x : ℝ), wfieldC κ ρ (fun y => γ t y / (1 + y ^ 2)) x =
      wfield κ (fun y => γ t y / (1 + y ^ 2)) x := by
    intro t
    refine wfieldC_eq_wfield κ ρ hρ _ (hvc t) (hvi t) ?_
    have h : (∫ x : ℝ, (γ t x / (1 + x ^ 2)) ^ 2) = ∫ x : ℝ, (γ 0 x / (1 + x ^ 2)) ^ 2 :=
      hconst t
    show (∫ x : ℝ, (γ t x / (1 + x ^ 2)) ^ 2) ≤ ρ ^ 2
    rw [h, hg0]
    exact hIρ.le
  
  refine ⟨fun t x => γ t x / (1 + x ^ 2), ?_, ?_, ?_, ?_, ?_⟩
  · intro x
    show γ 0 x / (1 + x ^ 2) = v₀ x
    rw [hγ0, hf₀, mul_div_cancel_left₀ _ (by positivity : (1 : ℝ) + x ^ 2 ≠ 0)]
  · exact hvc
  · intro T
    obtain ⟨M, hM⟩ :=
      (isCompact_Icc (a := -T) (b := T)).exists_bound_of_continuousOn hγc.continuousOn
    refine ⟨M, fun t ht x => ?_⟩
    have htI : t ∈ Set.Icc (-T) T := abs_le.1 ht
    exact (hvb t x).trans (hM t htI)
  · intro T
    obtain ⟨K, hK⟩ :=
      (isCompact_Icc (a := -T) (b := T)).exists_bound_of_continuousOn hΦγc.continuousOn
    refine ⟨K, fun s t hs ht x => ?_⟩
    have hsI : s ∈ Set.Icc (-T) T := abs_le.1 hs
    have htI : t ∈ Set.Icc (-T) T := abs_le.1 ht
    have hsub : Set.uIcc t s ⊆ Set.Icc (-T) T := Set.uIcc_subset_Icc htI hsI
    have hftc : ∫ τ in t..s, Φ (γ τ) = γ s - γ t :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt (fun τ _ => hγ τ)
        (hΦγc.intervalIntegrable t s)
    have hnorm : ‖γ s - γ t‖ ≤ K * |s - t| := by
      rw [← hftc]
      exact intervalIntegral.norm_integral_le_of_norm_le_const
        fun τ hτ => hK τ (hsub (Set.uIoc_subset_uIcc hτ))
    have hpt : |γ s x - γ t x| ≤ ‖γ s - γ t‖ := by
      have h := (γ s - γ t).norm_coe_le_norm x
      rwa [BoundedContinuousFunction.coe_sub, Pi.sub_apply, Real.norm_eq_abs] at h
    have hp : (0 : ℝ) < 1 + x ^ 2 := by positivity
    show (1 + x ^ 2) * |γ s x / (1 + x ^ 2) - γ t x / (1 + x ^ 2)| ≤ K * |s - t|
    rw [← sub_div, abs_div, abs_of_pos hp, mul_div_cancel₀ _ hp.ne']
    exact hpt.trans hnorm
  · intro t x
    have hp : (0 : ℝ) < 1 + x ^ 2 := by positivity
    have hder : ∀ τ : ℝ, HasDerivAt (fun σ => γ σ x) (Φ (γ τ) x) τ := by
      intro τ
      have h := (BoundedContinuousFunction.evalCLM ℝ x).hasFDerivAt.comp_hasDerivAt τ (hγ τ)
      simpa [Function.comp_def, BoundedContinuousFunction.evalCLM_apply] using h
    have hic : Continuous fun τ => Φ (γ τ) x := by
      have h := (BoundedContinuousFunction.evalCLM ℝ x).continuous.comp hΦγc
      simpa [Function.comp_def, BoundedContinuousFunction.evalCLM_apply] using h
    have hftc : ∫ τ in (0 : ℝ)..t, Φ (γ τ) x = γ t x - γ 0 x :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt (fun τ _ => hder τ)
        (hic.intervalIntegrable 0 t)
    have hint : ∫ τ in (0 : ℝ)..t, Φ (γ τ) x =
        (1 + x ^ 2) * ∫ τ in (0 : ℝ)..t, wfield κ (fun y => γ τ y / (1 + y ^ 2)) x := by
      rw [← intervalIntegral.integral_const_mul]
      refine intervalIntegral.integral_congr fun τ _ => ?_
      show Φ (γ τ) x = (1 + x ^ 2) * wfield κ (fun y => γ τ y / (1 + y ^ 2)) x
      rw [hΦ, hact]
    rw [hint, hγ0, hf₀] at hftc
    show γ t x / (1 + x ^ 2) =
      v₀ x + ∫ s in (0 : ℝ)..t, wfield κ (fun y => γ s y / (1 + y ^ 2)) x
    rw [div_eq_iff hp.ne']
    linear_combination -hftc

theorem rgreen_weighted_lipschitz (κ : ℝ) (hκ : 0 < κ) (M : ℝ) (k : ℕ) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (f g ω : ℝ → ℝ) (β : ℝ), Continuous f → Continuous g →
      (∀ x : ℝ, (1 + x ^ 2) * |f x| ≤ M) → (∀ x : ℝ, (1 + x ^ 2) * |g x| ≤ M) →
      (∀ x : ℝ, 0 ≤ ω x) → (∀ x y : ℝ, ω x ≤ 2 ^ k * (1 + (x - y) ^ 2) ^ k * ω y) →
      (∀ y : ℝ, ω y * |f y - g y| ≤ β) →
      ∀ x : ℝ, ω x * |rgreen κ f x - rgreen κ g x| ≤ A * β ∧
        ω x * |rgreenR κ f x - rgreenR κ g x| ≤ A * β :=
by
  
  have s1 : ∀ (f : ℝ → ℝ), (∀ y : ℝ, (1 + y ^ 2) * |f y| ≤ M) → ∀ a b : ℝ, a ≤ b →
      |∫ y in a..b, f y| ≤ Real.pi * M := by
    intro f hM a b hab
    have hM0 : 0 ≤ M := le_trans (mul_nonneg (by positivity) (abs_nonneg _)) (hM 0)
    have hpt : ∀ y : ℝ, ‖f y‖ ≤ M * (1 / (1 + y ^ 2)) := by
      intro y
      have hp : 0 < 1 + y ^ 2 := by positivity
      rw [Real.norm_eq_abs, mul_one_div, le_div_iff₀ hp, mul_comm]
      exact hM y
    have h1 := intervalIntegral.norm_integral_le_of_norm_le (μ := volume) hab
      (Filter.Eventually.of_forall (fun y _ => hpt y))
      ((intervalIntegral.intervalIntegrable_one_div_one_add_sq (a := a) (b := b)).const_mul M)
    rw [intervalIntegral.integral_const_mul, integral_one_div_one_add_sq, Real.norm_eq_abs] at h1
    have h2 := Real.arctan_lt_pi_div_two b
    have h3 := Real.neg_pi_div_two_lt_arctan a
    have h4 : M * (Real.arctan b - Real.arctan a) ≤ M * Real.pi :=
      mul_le_mul_of_nonneg_left (by linarith) hM0
    linarith
  
  have s2 : ∀ (f : ℝ → ℝ), Continuous f → ∀ x : ℝ,
      Continuous (fun s : ℝ => ∫ y in (x - s)..x, f y) ∧
        Continuous (fun s : ℝ => ∫ y in x..(x + s), f y) := by
    intro f hf x
    have hII : ∀ a b : ℝ, IntervalIntegrable f volume a b := fun a b => hf.intervalIntegrable a b
    have hP : Continuous (fun z => ∫ y in (0:ℝ)..z, f y) :=
      intervalIntegral.continuous_primitive hII 0
    constructor
    · have e : (fun s : ℝ => ∫ y in (x - s)..x, f y) =
          fun s => (∫ y in (0:ℝ)..x, f y) - ∫ y in (0:ℝ)..(x - s), f y := by
        funext s
        rw [intervalIntegral.integral_interval_sub_left (hII 0 x) (hII 0 (x - s))]
      rw [e]
      exact continuous_const.sub (hP.comp (continuous_const.sub continuous_id))
    · have e : (fun s : ℝ => ∫ y in x..(x + s), f y) =
          fun s => (∫ y in (0:ℝ)..(x + s), f y) - ∫ y in (0:ℝ)..x, f y := by
        funext s
        rw [intervalIntegral.integral_interval_sub_left (hII 0 (x + s)) (hII 0 x)]
      rw [e]
      exact (hP.comp (continuous_const.add continuous_id)).sub continuous_const
  
  have s3 : ∀ (f g ω : ℝ → ℝ) (β x s : ℝ), Continuous f → Continuous g → (∀ x : ℝ, 0 ≤ ω x) →
      (∀ x y : ℝ, ω x ≤ 2 ^ k * (1 + (x - y) ^ 2) ^ k * ω y) →
      (∀ y : ℝ, ω y * |f y - g y| ≤ β) → 0 ≤ s →
      ω x * |(∫ y in (x - s)..x, f y) - ∫ y in (x - s)..x, g y| ≤
          2 ^ k * β * (s * (1 + s ^ 2) ^ k) ∧
        ω x * |(∫ y in x..(x + s), f y) - ∫ y in x..(x + s), g y| ≤
          2 ^ k * β * (s * (1 + s ^ 2) ^ k) := by
    intro f g ω β x s hf hg hω hωp hβ hs
    have hβ0 : 0 ≤ β := le_trans (mul_nonneg (hω 0) (abs_nonneg _)) (hβ 0)
    have key : ∀ y : ℝ, (x - y) ^ 2 ≤ s ^ 2 →
        ‖ω x * (f y - g y)‖ ≤ 2 ^ k * (1 + s ^ 2) ^ k * β := by
      intro y hy
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hω x)]
      have hA : 0 ≤ (2 : ℝ) ^ k * (1 + (x - y) ^ 2) ^ k := by positivity
      have hpow : (1 + (x - y) ^ 2) ^ k ≤ (1 + s ^ 2) ^ k :=
        pow_le_pow_left₀ (by positivity) (by linarith) k
      calc ω x * |f y - g y| ≤ (2 ^ k * (1 + (x - y) ^ 2) ^ k * ω y) * |f y - g y| :=
            mul_le_mul_of_nonneg_right (hωp x y) (abs_nonneg _)
        _ = 2 ^ k * (1 + (x - y) ^ 2) ^ k * (ω y * |f y - g y|) := by ring
        _ ≤ 2 ^ k * (1 + (x - y) ^ 2) ^ k * β := mul_le_mul_of_nonneg_left (hβ y) hA
        _ ≤ 2 ^ k * (1 + s ^ 2) ^ k * β := by
            apply mul_le_mul_of_nonneg_right _ hβ0
            exact mul_le_mul_of_nonneg_left hpow (by positivity)
    have conv : ∀ a b : ℝ,
        ω x * |(∫ y in a..b, f y) - ∫ y in a..b, g y| = ‖∫ y in a..b, ω x * (f y - g y)‖ := by
      intro a b
      rw [intervalIntegral.integral_const_mul,
        intervalIntegral.integral_sub (hf.intervalIntegrable _ _) (hg.intervalIntegrable _ _),
        Real.norm_eq_abs, abs_mul, abs_of_nonneg (hω x)]
    constructor
    · rw [conv]
      have h := intervalIntegral.norm_integral_le_of_norm_le_const
        (a := x - s) (b := x) (C := 2 ^ k * (1 + s ^ 2) ^ k * β)
        (f := fun y => ω x * (f y - g y)) (fun y hy => by
          rw [Set.uIoc_of_le (by linarith)] at hy
          obtain ⟨h1, h2⟩ := hy
          exact key y (by nlinarith))
      rw [show x - (x - s) = s by ring, abs_of_nonneg hs] at h
      calc _ ≤ 2 ^ k * (1 + s ^ 2) ^ k * β * s := h
        _ = _ := by ring
    · rw [conv]
      have h := intervalIntegral.norm_integral_le_of_norm_le_const
        (a := x) (b := x + s) (C := 2 ^ k * (1 + s ^ 2) ^ k * β)
        (f := fun y => ω x * (f y - g y)) (fun y hy => by
          rw [Set.uIoc_of_le (by linarith)] at hy
          obtain ⟨h1, h2⟩ := hy
          exact key y (by nlinarith))
      rw [show x + s - x = s by ring, abs_of_nonneg hs] at h
      calc _ ≤ 2 ^ k * (1 + s ^ 2) ^ k * β * s := h
        _ = _ := by ring
  
  have s4 : MeasureTheory.IntegrableOn
      (fun s : ℝ => Real.exp (-2 * κ * s) * (s * (1 + s ^ 2) ^ k)) (Set.Ioi 0) := by
    obtain ⟨n, hn⟩ : ∃ n : ℕ, n = 2 * k + 1 := ⟨_, rfl⟩
    obtain ⟨K, hK⟩ : ∃ K : ℝ, K = (n.factorial : ℝ) / κ ^ n * Real.exp κ := ⟨_, rfl⟩
    have hψ : IntegrableOn (fun s : ℝ => K * Real.exp ((-κ) * s)) (Set.Ioi 0) :=
      (integrableOn_exp_mul_Ioi (neg_neg_of_pos hκ) 0).const_mul K
    refine Integrable.mono' hψ (by fun_prop : Continuous
      (fun s : ℝ => Real.exp (-2 * κ * s) * (s * (1 + s ^ 2) ^ k))).aestronglyMeasurable ?_
    refine ae_restrict_of_forall_mem measurableSet_Ioi (fun s hs => ?_)
    have hs0 : 0 < s := hs
    have hnn : 0 ≤ Real.exp (-2 * κ * s) * (s * (1 + s ^ 2) ^ k) := by positivity
    rw [Real.norm_eq_abs, abs_of_nonneg hnn]
    have hb1 : s * (1 + s ^ 2) ^ k ≤ (1 + s) ^ n := by
      have e : (1 + s) ^ n = (1 + s) * ((1 + s) ^ 2) ^ k := by
        rw [hn, ← pow_mul, pow_succ]; ring
      rw [e]
      apply mul_le_mul (by linarith) (pow_le_pow_left₀ (by positivity) (by nlinarith) k)
        (by positivity) (by linarith)
    have hκn : 0 < κ ^ n := pow_pos hκ n
    have hfac : (0 : ℝ) < n.factorial := Nat.cast_pos.2 (Nat.factorial_pos n)
    have hb2 : (1 + s) ^ n ≤ (n.factorial : ℝ) / κ ^ n * Real.exp (κ + κ * s) := by
      have h := Real.pow_div_factorial_le_exp (κ * (1 + s)) (by positivity) n
      rw [mul_pow, div_le_iff₀ hfac] at h
      rw [div_mul_eq_mul_div, le_div_iff₀ hκn]
      have e : κ * (1 + s) = κ + κ * s := by ring
      rw [e] at h
      nlinarith
    have he : Real.exp (-2 * κ * s) * Real.exp (κ + κ * s) =
        Real.exp κ * Real.exp ((-κ) * s) := by
      rw [← Real.exp_add, ← Real.exp_add]; ring_nf
    have hE := Real.exp_pos (-2 * κ * s)
    calc Real.exp (-2 * κ * s) * (s * (1 + s ^ 2) ^ k)
        ≤ Real.exp (-2 * κ * s) * ((n.factorial : ℝ) / κ ^ n * Real.exp (κ + κ * s)) :=
          mul_le_mul_of_nonneg_left (hb1.trans hb2) hE.le
      _ = (n.factorial : ℝ) / κ ^ n * (Real.exp (-2 * κ * s) * Real.exp (κ + κ * s)) := by ring
      _ = K * Real.exp ((-κ) * s) := by rw [he, hK]; ring
  
  have s5 : ∀ (L D c : ℝ) (a b : ℝ → ℝ), Continuous a → Continuous b →
      (∀ s : ℝ, 0 < s → |a s| ≤ L) → (∀ s : ℝ, 0 < s → |b s| ≤ L) → 0 ≤ c →
      (∀ s : ℝ, 0 < s → c * |a s - b s| ≤ D * (s * (1 + s ^ 2) ^ k)) →
      c * |(∫ s in Set.Ioi (0 : ℝ), Real.exp (-2 * κ * s + 2 * a s)) -
          ∫ s in Set.Ioi (0 : ℝ), Real.exp (-2 * κ * s + 2 * b s)| ≤
        2 * Real.exp (2 * L) * D *
          ∫ s in Set.Ioi (0 : ℝ), Real.exp (-2 * κ * s) * (s * (1 + s ^ 2) ^ k) := by
    intro L D c a b ha hb haL hbL hc hab
    have E : ∀ u v : ℝ, u ≤ v → |Real.exp u - Real.exp v| ≤ Real.exp v * |u - v| := by
      intro u v huv
      have h1 : Real.exp u ≤ Real.exp v := Real.exp_le_exp.2 huv
      rw [abs_of_nonpos (by linarith), abs_of_nonpos (by linarith)]
      have h2 := Real.add_one_le_exp (u - v)
      have h3 : Real.exp v * Real.exp (u - v) = Real.exp u := by
        rw [← Real.exp_add]; ring_nf
      have hv := Real.exp_pos v
      nlinarith
    have E' : ∀ u v w : ℝ, u ≤ w → v ≤ w →
        |Real.exp u - Real.exp v| ≤ Real.exp w * |u - v| := by
      intro u v w hu hv
      rcases le_total u v with h | h
      · exact (E u v h).trans (mul_le_mul_of_nonneg_right (Real.exp_le_exp.2 hv) (abs_nonneg _))
      · rw [abs_sub_comm, abs_sub_comm u v]
        exact (E v u h).trans (mul_le_mul_of_nonneg_right (Real.exp_le_exp.2 hu) (abs_nonneg _))
    have hdom : IntegrableOn (fun s : ℝ => Real.exp (2 * L) * Real.exp ((-2 * κ) * s))
        (Set.Ioi 0) :=
      (integrableOn_exp_mul_Ioi (by linarith : -2 * κ < 0) 0).const_mul _
    have intF : ∀ a : ℝ → ℝ, Continuous a → (∀ s : ℝ, 0 < s → |a s| ≤ L) →
        IntegrableOn (fun s => Real.exp (-2 * κ * s + 2 * a s)) (Set.Ioi 0) := by
      intro a ha haL
      refine Integrable.mono' hdom (by fun_prop : Continuous
        (fun s => Real.exp (-2 * κ * s + 2 * a s))).aestronglyMeasurable ?_
      refine ae_restrict_of_forall_mem measurableSet_Ioi (fun s hs => ?_)
      rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), ← Real.exp_add]
      apply Real.exp_le_exp.2
      have := (le_abs_self (a s)).trans (haL s hs)
      linarith
    have hF := intF a ha haL
    have hG := intF b hb hbL
    rw [← integral_sub hF hG]
    have h3 : c * |∫ s in Set.Ioi (0:ℝ), (Real.exp (-2 * κ * s + 2 * a s) -
        Real.exp (-2 * κ * s + 2 * b s))| =
        ‖∫ s in Set.Ioi (0:ℝ), c * (Real.exp (-2 * κ * s + 2 * a s) -
        Real.exp (-2 * κ * s + 2 * b s))‖ := by
      rw [integral_const_mul, Real.norm_eq_abs, abs_mul, abs_of_nonneg hc]
    rw [h3, ← integral_const_mul]
    refine norm_integral_le_of_norm_le (s4.const_mul _) ?_
    refine ae_restrict_of_forall_mem measurableSet_Ioi (fun s hs => ?_)
    have hs0 : 0 < s := hs
    have ha1 := (le_abs_self (a s)).trans (haL s hs)
    have hb1 := (le_abs_self (b s)).trans (hbL s hs)
    have hE := E' (-2 * κ * s + 2 * a s) (-2 * κ * s + 2 * b s) (-2 * κ * s + 2 * L)
      (by linarith) (by linarith)
    have hd : (-2 * κ * s + 2 * a s) - (-2 * κ * s + 2 * b s) = 2 * (a s - b s) := by ring
    rw [hd, abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 2),
      Real.exp_add (-2 * κ * s) (2 * L)] at hE
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hc]
    have hP : 0 ≤ 2 * Real.exp (2 * L) * Real.exp (-2 * κ * s) := by positivity
    calc c * |Real.exp (-2 * κ * s + 2 * a s) - Real.exp (-2 * κ * s + 2 * b s)|
        ≤ c * (Real.exp (-2 * κ * s) * Real.exp (2 * L) * (2 * |a s - b s|)) :=
          mul_le_mul_of_nonneg_left hE hc
      _ = 2 * Real.exp (2 * L) * Real.exp (-2 * κ * s) * (c * |a s - b s|) := by ring
      _ ≤ 2 * Real.exp (2 * L) * Real.exp (-2 * κ * s) * (D * (s * (1 + s ^ 2) ^ k)) :=
          mul_le_mul_of_nonneg_left (hab s hs) hP
      _ = 2 * Real.exp (2 * L) * D * (Real.exp (-2 * κ * s) * (s * (1 + s ^ 2) ^ k)) := by ring
  
  obtain ⟨L, hL⟩ : ∃ L : ℝ, L = Real.pi * |M| := ⟨_, rfl⟩
  obtain ⟨I, hI⟩ : ∃ I : ℝ,
      I = ∫ s in Set.Ioi (0 : ℝ), Real.exp (-2 * κ * s) * (s * (1 + s ^ 2) ^ k) := ⟨_, rfl⟩
  have hI0 : 0 ≤ I := by
    rw [hI]
    exact setIntegral_nonneg measurableSet_Ioi (fun s hs =>
      mul_nonneg (Real.exp_pos _).le (mul_nonneg (le_of_lt hs) (by positivity)))
  refine ⟨2 * Real.exp (2 * L) * 2 ^ k * I, by positivity, ?_⟩
  intro f g ω β hf hg hfM hgM hω hωp hβ x
  have hM0 : 0 ≤ M := le_trans (mul_nonneg (by positivity) (abs_nonneg _)) (hfM 0)
  have hML : Real.pi * M ≤ L := by rw [hL, abs_of_nonneg hM0]
  have e : 2 * Real.exp (2 * L) * (2 ^ k * β) * I = 2 * Real.exp (2 * L) * 2 ^ k * I * β := by
    ring
  constructor
  · have h := s5 L (2 ^ k * β) (ω x) (fun s => ∫ y in (x - s)..x, f y)
      (fun s => ∫ y in (x - s)..x, g y) (s2 f hf x).1 (s2 g hg x).1
      (fun s hs => (s1 f hfM (x - s) x (by linarith)).trans hML)
      (fun s hs => (s1 g hgM (x - s) x (by linarith)).trans hML) (hω x)
      (fun s hs => (s3 f g ω β x s hf hg hω hωp hβ hs.le).1)
    rw [← hI, e] at h
    exact h
  · have h := s5 L (2 ^ k * β) (ω x) (fun s => ∫ y in x..(x + s), f y)
      (fun s => ∫ y in x..(x + s), g y) (s2 f hf x).2 (s2 g hg x).2
      (fun s hs => (s1 f hfM x (x + s) (by linarith)).trans hML)
      (fun s hs => (s1 g hgM x (x + s) (by linarith)).trans hML) (hω x)
      (fun s hs => (s3 f g ω β x s hf hg hω hωp hβ hs.le).2)
    rw [← hI, e] at h
    exact h

theorem rgreen_hasDerivAt_of_decay (κ : ℝ) (hκ : 0 < κ) (f : ℝ → ℝ) (M : ℝ)
    (hf : Continuous f) (hM : ∀ x : ℝ, (1 + x ^ 2) * |f x| ≤ M) :
    (∀ x : ℝ, HasDerivAt (rgreen κ f) (2 * (f x - κ) * rgreen κ f x + 1) x) ∧
    (∀ x : ℝ, HasDerivAt (rgreenR κ f) (2 * (κ - f x) * rgreenR κ f x - 1) x) ∧
    (∀ x : ℝ, rgreen κ (fun _ => (0 : ℝ)) x = 1 / (2 * κ)) ∧
    (∀ x : ℝ, rgreenR κ (fun _ => (0 : ℝ)) x = 1 / (2 * κ)) :=
by
  
  have hint : ∀ g : ℝ → ℝ, Continuous g → (∀ x : ℝ, (1 + x ^ 2) * |g x| ≤ M) →
      Integrable g (volume : Measure ℝ) := by
    intro g hg hgM
    refine Integrable.mono' (integrable_inv_one_add_sq.const_mul M) hg.aestronglyMeasurable
      (ae_of_all _ fun x => ?_)
    rw [Real.norm_eq_abs, ← div_eq_mul_inv, le_div_iff₀ (by positivity)]
    linarith [hgM x, mul_comm (1 + x ^ 2) |g x|]
  
  have P1 : ∀ w : ℝ → ℝ, Continuous w → Integrable w (volume : Measure ℝ) →
      ∀ x : ℝ, HasDerivAt (rgreen κ w) (2 * (w x - κ) * rgreen κ w x + 1) x := by
    intro w hwc hwi x
    obtain ⟨W, hW⟩ : ∃ W : ℝ → ℝ, ∀ t, W t = ∫ y in (0 : ℝ)..t, w y := ⟨_, fun _ => rfl⟩
    obtain ⟨F, hF⟩ : ∃ F : ℝ → ℝ, ∀ y, F y = Real.exp (2 * κ * y - 2 * W y) :=
      ⟨_, fun _ => rfl⟩
    obtain ⟨E, hE⟩ : ∃ E : ℝ → ℝ, ∀ t, E t = Real.exp (-2 * κ * t + 2 * W t) :=
      ⟨_, fun _ => rfl⟩
    obtain ⟨J, hJ⟩ : ∃ J : ℝ → ℝ, ∀ t, J t = ∫ y in Set.Iic t, F y := ⟨_, fun _ => rfl⟩
    obtain ⟨A, hA⟩ : ∃ A : ℝ, A = ∫ y, ‖w y‖ := ⟨_, rfl⟩
    have hii : ∀ a b : ℝ, IntervalIntegrable (fun y => w y) volume a b :=
      fun a b => hwc.intervalIntegrable a b
    have hWf : W = fun t => ∫ y in (0 : ℝ)..t, w y := funext hW
    have hWd : ∀ t, HasDerivAt W (w t) t := by
      intro t
      rw [hWf]
      exact (hwc.integral_hasStrictDerivAt 0 t).hasDerivAt
    have hWc : Continuous W := by
      rw [hWf]
      exact intervalIntegral.continuous_primitive hii 0
    have hFf : F = fun y => Real.exp (2 * κ * y - 2 * W y) := funext hF
    have hFc : Continuous F := by
      rw [hFf]
      exact Real.continuous_exp.comp
        ((continuous_const.mul continuous_id).sub (continuous_const.mul hWc))
    have hWb : ∀ y, |W y| ≤ A := by
      intro y
      rw [hW, ← Real.norm_eq_abs, hA]
      refine (intervalIntegral.norm_integral_le_integral_norm_uIoc).trans ?_
      exact setIntegral_le_integral hwi.norm (ae_of_all _ fun _ => norm_nonneg _)
    have hFint : ∀ c : ℝ, IntegrableOn F (Set.Iic c) := by
      intro c
      refine Integrable.mono'
        ((integrableOn_exp_mul_Iic (by positivity : (0 : ℝ) < 2 * κ) c).const_mul
          (Real.exp (2 * A)))
        hFc.aestronglyMeasurable (ae_of_all _ fun y => ?_)
      rw [hF, Real.norm_eq_abs, Real.abs_exp, ← Real.exp_add]
      apply Real.exp_le_exp.2
      have := (abs_le.1 (hWb y)).1
      linarith
    have hJd : HasDerivAt J (F x) x := by
      have hJf : J = fun t => J 0 + ∫ y in (0 : ℝ)..t, F y := by
        funext t
        have := intervalIntegral.integral_Iic_sub_Iic (hFint 0) (hFint t)
        rw [hJ t, hJ 0]
        linarith
      rw [hJf]
      exact ((hFc.integral_hasStrictDerivAt 0 x).hasDerivAt).const_add _
    have hEd : HasDerivAt E (E x * (-2 * κ + 2 * w x)) x := by
      have hEf : E = fun t => Real.exp (-2 * κ * t + 2 * W t) := funext hE
      have h0 : HasDerivAt (fun t => -2 * κ * t + 2 * W t) (-2 * κ + 2 * w x) x :=
        (((hasDerivAt_id' x).const_mul (-2 * κ)).add ((hWd x).const_mul 2)).congr_deriv
          (by ring)
      rw [hEf]
      exact h0.exp
    have hEF : E x * F x = 1 := by
      rw [hE, hF, ← Real.exp_add,
        show (-2 * κ * x + 2 * W x) + (2 * κ * x - 2 * W x) = 0 by ring, Real.exp_zero]
    have hclosed : ∀ t, rgreen κ w t = E t * J t := by
      intro t
      have h1 : ∀ s : ℝ, Real.exp (-2 * κ * s + 2 * ∫ y in (t - s)..t, w y) =
          E t * F (t - s) := by
        intro s
        rw [← intervalIntegral.integral_interval_sub_left (hii 0 t) (hii 0 (t - s)), ← hW, ← hW,
          hE, hF, ← Real.exp_add]
        congr 1
        ring
      have h2 : rgreen κ w t = ∫ s in Set.Ioi (0 : ℝ), E t * F (t - s) := by
        unfold rgreen
        congr 1
        funext s
        exact h1 s
      have h3 : (∫ s in Set.Ioi (0 : ℝ), F (t - s)) = ∫ u in Set.Iic (0 : ℝ), F (t + u) := by
        have := integral_comp_neg_Ioi (0 : ℝ) (fun u => F (t + u))
        simp only [neg_zero] at this
        rw [← this]
        congr 1
      have h4 : (∫ u in Set.Iic (0 : ℝ), F (t + u)) = ∫ y in Set.Iic t, F y := by
        rw [← integral_indicator measurableSet_Iic, ← integral_indicator measurableSet_Iic]
        rw [← integral_add_right_eq_self (fun y => (Set.Iic t).indicator F y) t]
        congr 1
        funext u
        simp only [Set.indicator_apply, Set.mem_Iic]
        by_cases hu : u ≤ 0
        · rw [if_pos hu, if_pos (by linarith), add_comm]
        · rw [if_neg hu, if_neg (by linarith)]
      rw [h2, integral_const_mul, hJ, h3, h4]
    have hfun : rgreen κ w = fun t => E t * J t := funext hclosed
    rw [hclosed x, hfun]
    exact (hEd.mul hJd).congr_deriv (by rw [hEF]; ring)
  
  have refl : ∀ (g : ℝ → ℝ) (x : ℝ), rgreenR κ g x = rgreen κ (fun y => g (-y)) (-x) := by
    intro g x
    unfold rgreenR rgreen
    congr 1
    funext s
    have e := intervalIntegral.integral_comp_neg (a := -x - s) (b := -x) g
    rw [neg_neg, show -(-x - s) = x + s by ring] at e
    rw [e]
  
  have Z : ∀ x : ℝ, rgreen κ (fun _ => (0 : ℝ)) x = 1 / (2 * κ) := by
    intro x
    unfold rgreen
    simp only [intervalIntegral.integral_zero, mul_zero, add_zero]
    rw [integral_exp_mul_Ioi (by linarith : -2 * κ < 0) 0, mul_zero, Real.exp_zero]
    field_simp
  
  refine ⟨fun x => P1 f hf (hint f hf hM) x, ?_, Z, ?_⟩
  · intro x
    have hg : Continuous (fun y => f (-y)) := hf.comp continuous_neg
    have hgM : ∀ y : ℝ, (1 + y ^ 2) * |f (-y)| ≤ M := fun y => by
      have := hM (-y)
      rwa [neg_sq] at this
    have H := (P1 _ hg (hint _ hg hgM) (-x)).comp x (hasDerivAt_neg' x)
    have hfun : rgreenR κ f = (rgreen κ (fun y => f (-y))) ∘ (fun x => -x) :=
      funext fun x => refl f x
    have H2 : HasDerivAt (rgreenR κ f)
        ((2 * (f (-(-x)) - κ) * rgreen κ (fun y => f (-y)) (-x) + 1) * (-1)) x := by
      rw [hfun]
      exact H
    refine H2.congr_deriv ?_
    rw [refl f x, neg_neg]
    ring
  · intro x
    rw [refl]
    exact Z (-x)

theorem regN_algebra : (∀ φ : ℝ → ℝ → ℝ, RegN 0 φ ↔ ((∀ t : ℝ, Continuous (φ t)) ∧ TimeGood φ)) ∧
    (∀ (n : ℕ) (φ : ℝ → ℝ → ℝ), RegN (n + 1) φ ↔
      (TimeGood φ ∧ (∀ t x : ℝ, DifferentiableAt ℝ (φ t) x) ∧
        RegN n (fun t x => deriv (φ t) x))) ∧
    (∀ (n : ℕ) (φ : ℝ → ℝ → ℝ), RegN (n + 1) φ → RegN n φ) ∧
    (∀ (n : ℕ) (a b : ℝ) (φ ψ : ℝ → ℝ → ℝ), RegN n φ → RegN n ψ →
      RegN n (fun t x => a * φ t x + b * ψ t x)) ∧
    (∀ (n : ℕ) (φ ψ : ℝ → ℝ → ℝ), RegN n φ → RegN n ψ → RegN n (fun t x => φ t x * ψ t x)) :=
by
  
  have TL : ∀ (a b : ℝ) (φ ψ : ℝ → ℝ → ℝ), TimeGood φ → TimeGood ψ →
      TimeGood (fun t x => a * φ t x + b * ψ t x) := by
    intro a b φ ψ hφ hψ T k
    obtain ⟨A, hA⟩ := hφ T k
    obtain ⟨B, hB⟩ := hψ T k
    refine ⟨|a| * |A| + |b| * |B|, fun s t hs ht x => ⟨?_, ?_⟩⟩
    · have hw : 0 ≤ (1 + x ^ 2) ^ k := by positivity
      have hA1 : (1 + x ^ 2) ^ k * |φ t x| ≤ |A| := (hA s t hs ht x).1.trans (le_abs_self A)
      have hB1 : (1 + x ^ 2) ^ k * |ψ t x| ≤ |B| := (hB s t hs ht x).1.trans (le_abs_self B)
      have e : |a * φ t x + b * ψ t x| ≤ |a| * |φ t x| + |b| * |ψ t x| := by
        calc |a * φ t x + b * ψ t x| ≤ |a * φ t x| + |b * ψ t x| := abs_add_le _ _
          _ = |a| * |φ t x| + |b| * |ψ t x| := by rw [abs_mul, abs_mul]
      calc (1 + x ^ 2) ^ k * |a * φ t x + b * ψ t x|
          ≤ (1 + x ^ 2) ^ k * (|a| * |φ t x| + |b| * |ψ t x|) :=
            mul_le_mul_of_nonneg_left e hw
        _ = |a| * ((1 + x ^ 2) ^ k * |φ t x|) + |b| * ((1 + x ^ 2) ^ k * |ψ t x|) := by ring
        _ ≤ |a| * |A| + |b| * |B| :=
            add_le_add (mul_le_mul_of_nonneg_left hA1 (abs_nonneg a))
              (mul_le_mul_of_nonneg_left hB1 (abs_nonneg b))
    · have hw : 0 ≤ (1 + x ^ 2) ^ k := by positivity
      have hA2 : (1 + x ^ 2) ^ k * |φ s x - φ t x| ≤ |A| * |s - t| :=
        (hA s t hs ht x).2.trans (mul_le_mul_of_nonneg_right (le_abs_self A) (abs_nonneg _))
      have hB2 : (1 + x ^ 2) ^ k * |ψ s x - ψ t x| ≤ |B| * |s - t| :=
        (hB s t hs ht x).2.trans (mul_le_mul_of_nonneg_right (le_abs_self B) (abs_nonneg _))
      have e : |a * φ s x + b * ψ s x - (a * φ t x + b * ψ t x)| ≤
          |a| * |φ s x - φ t x| + |b| * |ψ s x - ψ t x| := by
        calc |a * φ s x + b * ψ s x - (a * φ t x + b * ψ t x)|
            = |a * (φ s x - φ t x) + b * (ψ s x - ψ t x)| := by congr 1; ring
          _ ≤ |a * (φ s x - φ t x)| + |b * (ψ s x - ψ t x)| := abs_add_le _ _
          _ = |a| * |φ s x - φ t x| + |b| * |ψ s x - ψ t x| := by rw [abs_mul, abs_mul]
      calc (1 + x ^ 2) ^ k * |a * φ s x + b * ψ s x - (a * φ t x + b * ψ t x)|
          ≤ (1 + x ^ 2) ^ k * (|a| * |φ s x - φ t x| + |b| * |ψ s x - ψ t x|) :=
            mul_le_mul_of_nonneg_left e hw
        _ = |a| * ((1 + x ^ 2) ^ k * |φ s x - φ t x|) +
              |b| * ((1 + x ^ 2) ^ k * |ψ s x - ψ t x|) := by ring
        _ ≤ |a| * (|A| * |s - t|) + |b| * (|B| * |s - t|) :=
            add_le_add (mul_le_mul_of_nonneg_left hA2 (abs_nonneg a))
              (mul_le_mul_of_nonneg_left hB2 (abs_nonneg b))
        _ = (|a| * |A| + |b| * |B|) * |s - t| := by ring
  
  have TM : ∀ (φ ψ : ℝ → ℝ → ℝ), TimeGood φ → TimeGood ψ →
      TimeGood (fun t x => φ t x * ψ t x) := by
    intro φ ψ hφ hψ T k
    obtain ⟨Ak, hAk⟩ := hφ T k
    obtain ⟨A0, hA0⟩ := hφ T 0
    obtain ⟨Bk, hBk⟩ := hψ T k
    obtain ⟨B0, hB0⟩ := hψ T 0
    refine ⟨|Ak| * |B0| + |A0| * |Bk|, fun s t hs ht x => ⟨?_, ?_⟩⟩
    · have h1 : (1 + x ^ 2) ^ k * |φ t x| ≤ |Ak| := (hAk s t hs ht x).1.trans (le_abs_self _)
      have h2 : |ψ t x| ≤ |B0| := by
        have := (hB0 t t ht ht x).1
        rw [pow_zero, one_mul] at this
        exact this.trans (le_abs_self _)
      have h3 : 0 ≤ |A0| * |Bk| := by positivity
      calc (1 + x ^ 2) ^ k * |φ t x * ψ t x| = ((1 + x ^ 2) ^ k * |φ t x|) * |ψ t x| := by
            rw [abs_mul]; ring
        _ ≤ |Ak| * |B0| := mul_le_mul h1 h2 (abs_nonneg _) (abs_nonneg _)
        _ ≤ |Ak| * |B0| + |A0| * |Bk| := le_add_of_nonneg_right h3
    · have hw : 0 ≤ (1 + x ^ 2) ^ k := by positivity
      have h1 : (1 + x ^ 2) ^ k * |φ s x - φ t x| ≤ |Ak| * |s - t| :=
        (hAk s t hs ht x).2.trans (mul_le_mul_of_nonneg_right (le_abs_self _) (abs_nonneg _))
      have h2 : |ψ s x| ≤ |B0| := by
        have := (hB0 s s hs hs x).1
        rw [pow_zero, one_mul] at this
        exact this.trans (le_abs_self _)
      have h3 : |φ t x| ≤ |A0| := by
        have := (hA0 t t ht ht x).1
        rw [pow_zero, one_mul] at this
        exact this.trans (le_abs_self _)
      have h4 : (1 + x ^ 2) ^ k * |ψ s x - ψ t x| ≤ |Bk| * |s - t| :=
        (hBk s t hs ht x).2.trans (mul_le_mul_of_nonneg_right (le_abs_self _) (abs_nonneg _))
      have e : |φ s x * ψ s x - φ t x * ψ t x| ≤
          |φ s x - φ t x| * |ψ s x| + |φ t x| * |ψ s x - ψ t x| := by
        calc |φ s x * ψ s x - φ t x * ψ t x|
            = |(φ s x - φ t x) * ψ s x + φ t x * (ψ s x - ψ t x)| := by congr 1; ring
          _ ≤ |(φ s x - φ t x) * ψ s x| + |φ t x * (ψ s x - ψ t x)| := abs_add_le _ _
          _ = |φ s x - φ t x| * |ψ s x| + |φ t x| * |ψ s x - ψ t x| := by
              rw [abs_mul, abs_mul]
      calc (1 + x ^ 2) ^ k * |φ s x * ψ s x - φ t x * ψ t x|
          ≤ (1 + x ^ 2) ^ k * (|φ s x - φ t x| * |ψ s x| + |φ t x| * |ψ s x - ψ t x|) :=
            mul_le_mul_of_nonneg_left e hw
        _ = ((1 + x ^ 2) ^ k * |φ s x - φ t x|) * |ψ s x| +
              |φ t x| * ((1 + x ^ 2) ^ k * |ψ s x - ψ t x|) := by ring
        _ ≤ (|Ak| * |s - t|) * |B0| + |A0| * (|Bk| * |s - t|) :=
            add_le_add
              (mul_le_mul h1 h2 (abs_nonneg _) (by positivity))
              (mul_le_mul h3 h4 (by positivity) (abs_nonneg _))
        _ = (|Ak| * |B0| + |A0| * |Bk|) * |s - t| := by ring
  
  have hc0 : ∀ f : ℝ → ℝ, ContDiff ℝ ((0 : ℕ) : WithTop ℕ∞) f ↔ Continuous f := by
    intro f
    rw [Nat.cast_zero]
    exact contDiff_zero
  have hcs : ∀ (n : ℕ) (f : ℝ → ℝ), ContDiff ℝ ((n + 1 : ℕ) : WithTop ℕ∞) f ↔
      (Differentiable ℝ f ∧ ContDiff ℝ (n : WithTop ℕ∞) (deriv f)) := by
    intro n f
    rw [Nat.cast_succ, contDiff_succ_iff_deriv]
    constructor
    · rintro ⟨h1, -, h3⟩
      exact ⟨h1, h3⟩
    · rintro ⟨h1, h3⟩
      exact ⟨h1, fun h => absurd h (WithTop.natCast_ne_top n), h3⟩
  
  have A0 : ∀ φ : ℝ → ℝ → ℝ, RegN 0 φ ↔ ((∀ t : ℝ, Continuous (φ t)) ∧ TimeGood φ) := by
    intro φ
    constructor
    · rintro ⟨hcd, htg⟩
      refine ⟨fun t => (hc0 _).1 (hcd t), ?_⟩
      simpa only [iteratedDeriv_zero] using htg 0 le_rfl
    · rintro ⟨hc, htg⟩
      refine ⟨fun t => (hc0 _).2 (hc t), fun j hj => ?_⟩
      obtain rfl : j = 0 := Nat.le_zero.1 hj
      simpa only [iteratedDeriv_zero] using htg
  
  have A1 : ∀ (n : ℕ) (φ : ℝ → ℝ → ℝ), RegN (n + 1) φ ↔
      (TimeGood φ ∧ (∀ t x : ℝ, DifferentiableAt ℝ (φ t) x) ∧
        RegN n (fun t x => deriv (φ t) x)) := by
    intro n φ
    constructor
    · rintro ⟨hcd, htg⟩
      refine ⟨?_, fun t x => ((hcs n _).1 (hcd t)).1 x,
        fun t => ((hcs n _).1 (hcd t)).2, fun j hj => ?_⟩
      · simpa only [iteratedDeriv_zero] using htg 0 (Nat.zero_le _)
      · have := htg (j + 1) (by omega)
        simpa only [iteratedDeriv_succ'] using this
    · rintro ⟨htg, hd, hcd', htg'⟩
      refine ⟨fun t => (hcs n _).2 ⟨fun x => hd t x, hcd' t⟩, fun j hj => ?_⟩
      rcases j with _ | i
      · simpa only [iteratedDeriv_zero] using htg
      · have := htg' i (by omega)
        simpa only [iteratedDeriv_succ'] using this
  
  have A2 : ∀ (n : ℕ) (φ : ℝ → ℝ → ℝ), RegN (n + 1) φ → RegN n φ := by
    rintro n φ ⟨hcd, htg⟩
    refine ⟨fun t => (hcd t).of_le ?_, fun j hj => htg j (by omega)⟩
    exact_mod_cast Nat.le_succ n
  
  have A3 : ∀ (n : ℕ) (a b : ℝ) (φ ψ : ℝ → ℝ → ℝ), RegN n φ → RegN n ψ →
      RegN n (fun t x => a * φ t x + b * ψ t x) := by
    intro n
    induction n with
    | zero =>
      intro a b φ ψ hφ hψ
      obtain ⟨cφ, tφ⟩ := (A0 φ).1 hφ
      obtain ⟨cψ, tψ⟩ := (A0 ψ).1 hψ
      exact (A0 _).2 ⟨fun t => (continuous_const.mul (cφ t)).add (continuous_const.mul (cψ t)),
        TL a b φ ψ tφ tψ⟩
    | succ n ih =>
      intro a b φ ψ hφ hψ
      obtain ⟨tφ, dφ, rφ⟩ := (A1 n φ).1 hφ
      obtain ⟨tψ, dψ, rψ⟩ := (A1 n ψ).1 hψ
      have hder : (fun t x => deriv (fun x => a * φ t x + b * ψ t x) x) =
          fun t x => a * deriv (φ t) x + b * deriv (ψ t) x := by
        funext t x
        exact (((dφ t x).hasDerivAt.const_mul a).add ((dψ t x).hasDerivAt.const_mul b)).deriv
      refine (A1 n _).2 ⟨TL a b φ ψ tφ tψ,
        fun t x => ((dφ t x).const_mul a).add ((dψ t x).const_mul b), ?_⟩
      show RegN n (fun t x => deriv (fun x => a * φ t x + b * ψ t x) x)
      rw [hder]
      exact ih a b _ _ rφ rψ
  
  have A4 : ∀ (n : ℕ) (φ ψ : ℝ → ℝ → ℝ), RegN n φ → RegN n ψ →
      RegN n (fun t x => φ t x * ψ t x) := by
    intro n
    induction n with
    | zero =>
      intro φ ψ hφ hψ
      obtain ⟨cφ, tφ⟩ := (A0 φ).1 hφ
      obtain ⟨cψ, tψ⟩ := (A0 ψ).1 hψ
      exact (A0 _).2 ⟨fun t => (cφ t).mul (cψ t), TM φ ψ tφ tψ⟩
    | succ n ih =>
      intro φ ψ hφ hψ
      obtain ⟨tφ, dφ, rφ⟩ := (A1 n φ).1 hφ
      obtain ⟨tψ, dψ, rψ⟩ := (A1 n ψ).1 hψ
      have hφn := A2 n φ hφ
      have hψn := A2 n ψ hψ
      have hder : (fun t x => deriv (fun x => φ t x * ψ t x) x) =
          fun t x => 1 * (deriv (φ t) x * ψ t x) + 1 * (φ t x * deriv (ψ t) x) := by
        funext t x
        have h := ((dφ t x).hasDerivAt.mul (dψ t x).hasDerivAt).deriv
        rw [show (fun x => φ t x * ψ t x) = φ t * ψ t from rfl, h]
        ring
      refine (A1 n _).2 ⟨TM φ ψ tφ tψ, fun t x => (dφ t x).mul (dψ t x), ?_⟩
      show RegN n (fun t x => deriv (fun x => φ t x * ψ t x) x)
      rw [hder]
      exact A3 n 1 1 _ _ (ih _ _ rφ hψn) (ih _ _ hφn rψ)
  exact ⟨A0, A1, A2, A3, A4⟩

theorem regN_time_integral (m : ℕ) (g : 𝓢(ℝ, ℝ)) (F u : ℝ → ℝ → ℝ) (hF : RegN m F)
    (hu : ∀ t x : ℝ, u t x = g x + ∫ s in (0 : ℝ)..t, F s x) :
    RegN m u ∧ ∀ j : ℕ, j ≤ m → ∀ t x : ℝ,
      iteratedDeriv j (u t) x = iteratedDeriv j (g : ℝ → ℝ) x + ∫ s in (0 : ℝ)..t, iteratedDeriv j (F s) x :=
by
  classical
  
  have C1 : ∀ φ : ℝ → ℝ → ℝ, TimeGood φ →
      (∀ x : ℝ, Continuous fun s : ℝ => φ s x) ∧
        ∀ T : ℝ, ∃ C : ℝ, ∀ s : ℝ, |s| ≤ T → ∀ x : ℝ, |φ s x| ≤ C := by
    intro φ hφ
    refine ⟨fun x => ?_, fun T => ?_⟩
    · rw [continuous_iff_continuousAt]
      intro s₀
      obtain ⟨C, hC⟩ := hφ (|s₀| + 1) 0
      rw [Metric.continuousAt_iff]
      intro ε hε
      have hC1 : 0 < |C| + 1 := by positivity
      refine ⟨min 1 (ε / (|C| + 1)), lt_min one_pos (div_pos hε hC1), fun s hs => ?_⟩
      rw [Real.dist_eq] at hs ⊢
      have hs1 : |s - s₀| < 1 := lt_of_lt_of_le hs (min_le_left _ _)
      have hs2 : |s - s₀| < ε / (|C| + 1) := lt_of_lt_of_le hs (min_le_right _ _)
      have hsT : |s| ≤ |s₀| + 1 := by
        have := abs_sub_abs_le_abs_sub s s₀
        linarith
      have h := (hC s s₀ hsT (by linarith [abs_nonneg s₀]) x).2
      rw [pow_zero, one_mul] at h
      have h3 : (|C| + 1) * |s - s₀| < (|C| + 1) * (ε / (|C| + 1)) :=
        mul_lt_mul_of_pos_left hs2 hC1
      have h4 : (|C| + 1) * (ε / (|C| + 1)) = ε := by field_simp
      have h5 : C * |s - s₀| ≤ |C| * |s - s₀| :=
        mul_le_mul_of_nonneg_right (le_abs_self C) (abs_nonneg _)
      nlinarith [abs_nonneg (s - s₀)]
    · obtain ⟨C, hC⟩ := hφ T 0
      refine ⟨C, fun s hs x => ?_⟩
      have h := (hC s s hs hs x).1
      rwa [pow_zero, one_mul] at h
  
  have SFT : ∀ a b σ T : ℝ, |a| ≤ T → |b| ≤ T → σ ∈ Set.uIoc a b → |σ| ≤ T := by
    intro a b σ T ha hb hσ
    rw [Set.mem_uIoc] at hσ
    rw [abs_le]
    rcases hσ with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · constructor
      · linarith [neg_abs_le a]
      · linarith [le_abs_self b]
    · constructor
      · linarith [neg_abs_le b]
      · linarith [le_abs_self a]
  
  have C2 : ∀ (h : ℝ → ℝ) (φ : ℝ → ℝ → ℝ),
      (∀ k : ℕ, ∃ C : ℝ, ∀ x : ℝ, (1 + x ^ 2) ^ k * |h x| ≤ C) →
      (∀ x : ℝ, Continuous fun s : ℝ => φ s x) → TimeGood φ →
      TimeGood (fun t x => h x + ∫ s in (0 : ℝ)..t, φ s x) := by
    intro h φ hh hc hφ T k
    rcases lt_or_ge T 0 with hT | hT
    · refine ⟨0, fun s t hs ht x => ?_⟩
      exact absurd (lt_of_le_of_lt ((abs_nonneg t).trans ht) hT) (lt_irrefl 0)
    obtain ⟨Ch, hCh⟩ := hh k
    obtain ⟨Cφ, hCφ⟩ := hφ T k
    have hT0 : |(0 : ℝ)| ≤ T := by rw [abs_zero]; exact hT
    have hCh0 : 0 ≤ Ch := le_trans (by positivity) (hCh 0)
    have hCφ0 : 0 ≤ Cφ := le_trans (by positivity) (hCφ 0 0 hT0 hT0 0).1
    refine ⟨Ch + (T + 1) * Cφ, fun s t hs ht x => ?_⟩
    have hw : 0 ≤ (1 + x ^ 2) ^ k := by positivity
    have hpt : ∀ a b : ℝ, |a| ≤ T → |b| ≤ T →
        (1 + x ^ 2) ^ k * |∫ σ in a..b, φ σ x| ≤ Cφ * |b - a| := by
      intro a b ha hb
      have e : (1 + x ^ 2) ^ k * |∫ σ in a..b, φ σ x| =
          ‖∫ σ in a..b, (1 + x ^ 2) ^ k * φ σ x‖ := by
        rw [intervalIntegral.integral_const_mul, Real.norm_eq_abs, abs_mul, abs_of_nonneg hw]
      rw [e]
      refine intervalIntegral.norm_integral_le_of_norm_le_const (fun σ hσ => ?_)
      have hσT := SFT a b σ T ha hb hσ
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hw]
      exact (hCφ σ σ hσT hσT x).1
    beta_reduce
    constructor
    · have h1 := hpt 0 t hT0 ht
      have h2 := hCh x
      calc (1 + x ^ 2) ^ k * |h x + ∫ σ in (0 : ℝ)..t, φ σ x|
          ≤ (1 + x ^ 2) ^ k * (|h x| + |∫ σ in (0 : ℝ)..t, φ σ x|) :=
            mul_le_mul_of_nonneg_left (abs_add_le _ _) hw
        _ = (1 + x ^ 2) ^ k * |h x| + (1 + x ^ 2) ^ k * |∫ σ in (0 : ℝ)..t, φ σ x| := by ring
        _ ≤ Ch + Cφ * |t - 0| := add_le_add h2 h1
        _ ≤ Ch + (T + 1) * Cφ := by
            rw [sub_zero]
            nlinarith [mul_le_mul_of_nonneg_left ht hCφ0]
    · have e : h x + (∫ σ in (0 : ℝ)..s, φ σ x) - (h x + ∫ σ in (0 : ℝ)..t, φ σ x) =
          ∫ σ in t..s, φ σ x := by
        rw [add_sub_add_left_eq_sub, intervalIntegral.integral_interval_sub_left
          ((hc x).intervalIntegrable 0 s) ((hc x).intervalIntegrable 0 t)]
      rw [e]
      have h1 := hpt t s ht hs
      calc _ ≤ Cφ * |s - t| := h1
        _ ≤ (Ch + (T + 1) * Cφ) * |s - t| :=
            mul_le_mul_of_nonneg_right (by nlinarith) (abs_nonneg _)
  
  have C3 : ∀ (φ ψ : ℝ → ℝ → ℝ), (∀ y : ℝ, Continuous fun s : ℝ => φ s y) →
      (∀ y : ℝ, Continuous fun s : ℝ => ψ s y) →
      (∀ T : ℝ, ∃ C : ℝ, ∀ s : ℝ, |s| ≤ T → ∀ y : ℝ, |ψ s y| ≤ C) →
      (∀ s y : ℝ, HasDerivAt (φ s) (ψ s y) y) → ∀ t x : ℝ,
      HasDerivAt (fun y => ∫ s in (0 : ℝ)..t, φ s y) (∫ s in (0 : ℝ)..t, ψ s x) x := by
    intro φ ψ hφc hψc hψb hd t x
    obtain ⟨C, hC⟩ := hψb |t|
    have hT0 : |(0 : ℝ)| ≤ |t| := by rw [abs_zero]; exact abs_nonneg t
    exact (intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (F := fun y s => φ s y) (F' := fun y s => ψ s y) (bound := fun _ => C)
      Filter.univ_mem
      (Filter.Eventually.of_forall fun y => (hφc y).aestronglyMeasurable)
      ((hφc x).intervalIntegrable 0 t)
      ((hψc x).aestronglyMeasurable)
      (MeasureTheory.ae_of_all _ fun σ hσ y _ => by
        rw [Real.norm_eq_abs]; exact hC σ (SFT 0 t σ |t| hT0 le_rfl hσ) y)
      intervalIntegrable_const
      (MeasureTheory.ae_of_all _ fun σ _ y _ => hd σ y)).2
  
  have C4 : ∀ φ : ℝ → ℝ → ℝ, (∀ y : ℝ, Continuous fun s : ℝ => φ s y) →
      (∀ s : ℝ, Continuous (φ s)) →
      (∀ T : ℝ, ∃ C : ℝ, ∀ s : ℝ, |s| ≤ T → ∀ y : ℝ, |φ s y| ≤ C) → ∀ t : ℝ,
      Continuous fun x => ∫ s in (0 : ℝ)..t, φ s x := by
    intro φ hcs hcx hb t
    obtain ⟨C, hC⟩ := hb |t|
    have hT0 : |(0 : ℝ)| ≤ |t| := by rw [abs_zero]; exact abs_nonneg t
    exact intervalIntegral.continuous_of_dominated_interval (F := fun x s => φ s x)
      (bound := fun _ => C)
      (fun x => (hcs x).aestronglyMeasurable)
      (fun x => MeasureTheory.ae_of_all _ fun σ hσ => by
        rw [Real.norm_eq_abs]; exact hC σ (SFT 0 t σ |t| hT0 le_rfl hσ) x)
      intervalIntegrable_const
      (MeasureTheory.ae_of_all _ fun σ _ => hcx σ)
  
  have C5 : ∀ j : ℕ,
      (∀ x : ℝ, HasDerivAt (iteratedDeriv j (g : ℝ → ℝ))
        (iteratedDeriv (j + 1) (g : ℝ → ℝ) x) x) ∧
        ∀ k : ℕ, ∃ C : ℝ, ∀ x : ℝ, (1 + x ^ 2) ^ k * |iteratedDeriv j (g : ℝ → ℝ) x| ≤ C := by
    intro j
    refine ⟨fun x => ?_, fun k => ?_⟩
    · rw [iteratedDeriv_succ]
      have hD : Differentiable ℝ (iteratedDeriv j (g : ℝ → ℝ)) :=
        (g.smooth ((j + 1 : ℕ) : ℕ∞)).differentiable_iteratedDeriv j
          (by exact_mod_cast Nat.lt_succ_self j)
      exact (hD x).hasDerivAt
    · refine ⟨2 ^ (2 * k) * ((Finset.Iic (2 * k, j)).sup
        fun m => SchwartzMap.seminorm ℝ m.1 m.2) g, fun x => ?_⟩
      have h1 := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (2 * k, j))
        (k := 2 * k) (n := j) le_rfl le_rfl g x
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs] at h1
      have h2 : (1 + x ^ 2) ^ k ≤ (1 + ‖x‖) ^ (2 * k) := by
        rw [pow_mul]
        apply pow_le_pow_left₀ (by positivity)
        rw [Real.norm_eq_abs]
        nlinarith [abs_nonneg x, sq_abs x]
      calc (1 + x ^ 2) ^ k * |iteratedDeriv j (g : ℝ → ℝ) x|
          ≤ (1 + ‖x‖) ^ (2 * k) * |iteratedDeriv j (g : ℝ → ℝ) x| :=
            mul_le_mul_of_nonneg_right h2 (abs_nonneg _)
        _ ≤ _ := h1
  
  obtain ⟨hFc, hFt⟩ := hF
  have Φc : ∀ j, j ≤ m → ∀ y : ℝ, Continuous fun s => iteratedDeriv j (F s) y :=
    fun j hj => (C1 _ (hFt j hj)).1
  have Φb : ∀ j, j ≤ m → ∀ T : ℝ, ∃ C : ℝ, ∀ s : ℝ, |s| ≤ T → ∀ y : ℝ,
      |iteratedDeriv j (F s) y| ≤ C :=
    fun j hj => (C1 _ (hFt j hj)).2
  have Φx : ∀ j, j ≤ m → ∀ s, Continuous (iteratedDeriv j (F s)) :=
    fun j hj s => (hFc s).continuous_iteratedDeriv j (by exact_mod_cast hj)
  have hdF : ∀ j, j < m → ∀ s y : ℝ,
      HasDerivAt (iteratedDeriv j (F s)) (iteratedDeriv (j + 1) (F s) y) y := by
    intro j hj s y
    rw [iteratedDeriv_succ]
    exact ((hFc s).differentiable_iteratedDeriv j (by exact_mod_cast hj) y).hasDerivAt
  have D : ∀ j, j < m → ∀ t x : ℝ, HasDerivAt
      (fun y => iteratedDeriv j (g : ℝ → ℝ) y + ∫ s in (0 : ℝ)..t, iteratedDeriv j (F s) y)
      (iteratedDeriv (j + 1) (g : ℝ → ℝ) x + ∫ s in (0 : ℝ)..t, iteratedDeriv (j + 1) (F s) x)
      x := by
    intro j hj t x
    exact ((C5 j).1 x).add (C3 (fun s y => iteratedDeriv j (F s) y)
      (fun s y => iteratedDeriv (j + 1) (F s) y)
      (Φc j hj.le) (Φc (j + 1) hj) (Φb (j + 1) hj) (hdF j hj) t x)
  have P : ∀ j, j ≤ m → ∀ t, iteratedDeriv j (u t) =
      fun x => iteratedDeriv j (g : ℝ → ℝ) x + ∫ s in (0 : ℝ)..t, iteratedDeriv j (F s) x := by
    intro j
    induction j with
    | zero =>
      intro _ t
      funext x
      simp only [iteratedDeriv_zero]
      exact hu t x
    | succ j ih =>
      intro hj t
      have hj' : j < m := by omega
      rw [show iteratedDeriv (j + 1) (u t) = deriv (iteratedDeriv j (u t)) from
        iteratedDeriv_succ, ih hj'.le t]
      funext x
      exact (D j hj' t x).deriv
  have S4 : ∀ t, ContDiff ℝ m (u t) := by
    intro t
    refine (contDiff_iff_iteratedDeriv (n := (m : ℕ∞))).2 ⟨fun j hj => ?_, fun j hj => ?_⟩
    · have hj' : j ≤ m := by exact_mod_cast hj
      rw [P j hj' t]
      exact (continuous_iff_continuousAt.2 fun x => ((C5 j).1 x).continuousAt).add
        (C4 (fun s y => iteratedDeriv j (F s) y) (Φc j hj') (Φx j hj') (Φb j hj') t)
    · have hj' : j < m := by exact_mod_cast hj
      rw [P j hj'.le t]
      exact fun x => (D j hj' t x).differentiableAt
  have S5 : ∀ j, j ≤ m → TimeGood (fun t x => iteratedDeriv j (u t) x) := by
    intro j hj
    have e : (fun t x => iteratedDeriv j (u t) x) =
        fun t x => iteratedDeriv j (g : ℝ → ℝ) x + ∫ s in (0 : ℝ)..t, iteratedDeriv j (F s) x :=
      funext fun t => funext fun x => congrFun (P j hj t) x
    rw [e]
    exact C2 (iteratedDeriv j (g : ℝ → ℝ)) (fun s x => iteratedDeriv j (F s) x) (C5 j).2
      (Φc j hj) (hFt j hj)
  exact ⟨⟨S4, S5⟩, fun j hj t x => congrFun (P j hj t) x⟩

theorem family_weight_propagation (v₀ : ℝ → ℝ) (v F : ℝ → ℝ → ℝ)
    (hi : ∀ t x : ℝ, v t x = v₀ x + ∫ s in (0 : ℝ)..t, F s x)
    (hFc : ∀ x : ℝ, Continuous fun s : ℝ => F s x)
    (hbd : ∀ T : ℝ, ∃ M : ℝ, ∀ t : ℝ, |t| ≤ T → ∀ x : ℝ, |v t x| ≤ M)
    (hF : ∀ (T : ℝ) (k : ℕ), ∃ A : ℝ, 0 ≤ A ∧ ∀ (Λ β s : ℝ), 0 ≤ Λ → |s| ≤ T →
      (∀ y : ℝ, min ((1 + y ^ 2) ^ k) Λ * |v s y| ≤ β) →
      ∀ x : ℝ, min ((1 + x ^ 2) ^ k) Λ * |F s x| ≤ A * β)
    (h0 : ∀ k : ℕ, ∃ C : ℝ, ∀ x : ℝ, (1 + x ^ 2) ^ k * |v₀ x| ≤ C) :
    TimeGood v :=
by
  
  have step : ∀ (w G : ℝ → ℝ → ℝ) (ω β : ℝ → ℝ) (a A t : ℝ),
      (∀ t x : ℝ, w t x = v₀ x + ∫ s in (0 : ℝ)..t, G s x) →
      (∀ x : ℝ, Continuous fun s : ℝ => G s x) →
      Continuous β → 0 ≤ t → (∀ x : ℝ, 0 ≤ ω x) →
      (∀ x : ℝ, ω x * |v₀ x| ≤ a) →
      (∀ s : ℝ, 0 ≤ s → s ≤ t → ∀ x : ℝ, ω x * |G s x| ≤ A * β s) →
      ∀ x : ℝ, ω x * |w t x| ≤ a + ∫ s in (0 : ℝ)..t, A * β s := by
    intro w G ω β a A t hiw hGc hβ ht hω h0' hFβ x
    have e : ω x * |∫ s in (0 : ℝ)..t, G s x| = |∫ s in (0 : ℝ)..t, ω x * G s x| := by
      rw [intervalIntegral.integral_const_mul, abs_mul, abs_of_nonneg (hω x)]
    have hI : ω x * |∫ s in (0 : ℝ)..t, G s x| ≤ ∫ s in (0 : ℝ)..t, A * β s := by
      rw [e]
      refine (intervalIntegral.abs_integral_le_integral_abs ht).trans ?_
      refine intervalIntegral.integral_mono_on ht ?_ ?_ ?_
      · exact ((continuous_const.mul (hGc x)).abs).intervalIntegrable 0 t
      · exact (continuous_const.mul hβ).intervalIntegrable 0 t
      · intro s hs
        rw [abs_mul, abs_of_nonneg (hω x)]
        exact hFβ s hs.1 hs.2 x
    rw [hiw t x]
    calc ω x * |v₀ x + ∫ s in (0 : ℝ)..t, G s x|
        ≤ ω x * (|v₀ x| + |∫ s in (0 : ℝ)..t, G s x|) :=
          mul_le_mul_of_nonneg_left (abs_add_le _ _) (hω x)
      _ = ω x * |v₀ x| + ω x * |∫ s in (0 : ℝ)..t, G s x| := by ring
      _ ≤ _ := add_le_add (h0' x) hI
  
  have gron : ∀ (u : ℝ → ℝ → ℝ) (a A B T : ℝ), 0 ≤ a →
      (∀ t : ℝ, 0 ≤ t → t ≤ T → ∀ x : ℝ, u t x ≤ B) →
      (∀ (β : ℝ → ℝ) (t : ℝ), Continuous β → 0 ≤ t → t ≤ T →
        (∀ s : ℝ, 0 ≤ s → s ≤ t → ∀ y : ℝ, u s y ≤ β s) →
        ∀ x : ℝ, u t x ≤ a + ∫ s in (0 : ℝ)..t, A * β s) →
      ∀ t : ℝ, 0 ≤ t → t ≤ T → ∀ x : ℝ, u t x ≤ a * Real.exp (A * t) := by
    intro u a A B T ha hB hstep
    have iden : ∀ (t : ℝ) (m : ℕ), a + ∫ s in (0 : ℝ)..t,
        A * (a * Real.exp (A * s) + B * (A * s) ^ m / (m.factorial : ℝ)) =
          a * Real.exp (A * t) + B * (A * t) ^ (m + 1) / ((m + 1).factorial : ℝ) := by
      intro t m
      have hd : ∀ s : ℝ, HasDerivAt
          (fun s => a * Real.exp (A * s) + B * (A * s) ^ (m + 1) / ((m + 1).factorial : ℝ))
          (A * (a * Real.exp (A * s) + B * (A * s) ^ m / (m.factorial : ℝ))) s := by
        intro s
        have h1 : HasDerivAt (fun s : ℝ => A * s) A s := by
          simpa using (hasDerivAt_id s).const_mul A
        have h2 := ((h1.exp).const_mul a).add
          (((h1.pow (m + 1)).const_mul B).div_const ((m + 1).factorial : ℝ))
        convert h2 using 1
        simp only [Nat.add_sub_cancel]
        rw [Nat.factorial_succ]
        have hf : (m.factorial : ℝ) ≠ 0 := by positivity
        push_cast
        field_simp
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun s _ => hd s)
        (by apply Continuous.intervalIntegrable; fun_prop)]
      have hz : (0 : ℝ) ^ (m + 1) = 0 := zero_pow (Nat.succ_ne_zero m)
      simp only [mul_zero, Real.exp_zero, hz, zero_div, add_zero, mul_one]
      ring
    have P : ∀ m : ℕ, ∀ t : ℝ, 0 ≤ t → t ≤ T → ∀ x : ℝ,
        u t x ≤ a * Real.exp (A * t) + B * (A * t) ^ m / (m.factorial : ℝ) := by
      intro m
      induction m with
      | zero =>
        intro t ht0 htT x
        have h1 := hB t ht0 htT x
        have h2 : 0 ≤ a * Real.exp (A * t) := mul_nonneg ha (Real.exp_pos _).le
        simp only [pow_zero, Nat.factorial_zero, Nat.cast_one, div_one, mul_one]
        linarith
      | succ m ih =>
        intro t ht0 htT x
        rw [← iden t m]
        exact hstep _ t (by fun_prop) ht0 htT (fun s hs0 hst y => ih s hs0 (hst.trans htT) y) x
    intro t ht0 htT x
    have hlim : Filter.Tendsto
        (fun m : ℕ => a * Real.exp (A * t) + B * ((A * t) ^ m / (m.factorial : ℝ)))
        Filter.atTop (nhds (a * Real.exp (A * t) + B * 0)) :=
      ((FloorSemiring.tendsto_pow_div_factorial_atTop (A * t)).const_mul B).const_add _
    rw [mul_zero, add_zero] at hlim
    exact ge_of_tendsto' hlim (fun m => by rw [← mul_div_assoc]; exact P m t ht0 htT x)
  
  have fwd : ∀ (w G : ℝ → ℝ → ℝ), (∀ t x : ℝ, w t x = v₀ x + ∫ s in (0 : ℝ)..t, G s x) →
      (∀ x : ℝ, Continuous fun s : ℝ => G s x) →
      (∀ T : ℝ, ∃ M : ℝ, ∀ t : ℝ, |t| ≤ T → ∀ x : ℝ, |w t x| ≤ M) →
      (∀ (T : ℝ) (k : ℕ), ∃ A : ℝ, 0 ≤ A ∧ ∀ (Λ β s : ℝ), 0 ≤ Λ → |s| ≤ T →
        (∀ y : ℝ, min ((1 + y ^ 2) ^ k) Λ * |w s y| ≤ β) →
        ∀ x : ℝ, min ((1 + x ^ 2) ^ k) Λ * |G s x| ≤ A * β) →
      ∀ (T : ℝ) (k : ℕ), ∃ C : ℝ, ∀ t : ℝ, 0 ≤ t → t ≤ T → ∀ x : ℝ,
        (1 + x ^ 2) ^ k * |w t x| ≤ C := by
    intro w G hiw hGc hbw hFw T k
    rcases lt_or_ge T 0 with hT | hT
    · exact ⟨0, fun t ht0 htT x => absurd (ht0.trans htT) (not_le.2 hT)⟩
    obtain ⟨M, hM⟩ := hbw T
    obtain ⟨A, hA0, hA⟩ := hFw T k
    obtain ⟨a, ha⟩ := h0 k
    have ha0 : 0 ≤ a := le_trans (by positivity) (ha 0)
    refine ⟨a * Real.exp (A * T), fun t ht0 htT x => ?_⟩
    have hΛ : (0 : ℝ) ≤ (1 + x ^ 2) ^ k := by positivity
    have hω : ∀ y : ℝ, 0 ≤ min ((1 + y ^ 2) ^ k) ((1 + x ^ 2) ^ k) :=
      fun y => le_min (by positivity) hΛ
    have key := gron (fun τ y => min ((1 + y ^ 2) ^ k) ((1 + x ^ 2) ^ k) * |w τ y|) a A
      ((1 + x ^ 2) ^ k * M) T ha0
      (fun τ hτ0 hτT y => by
        calc min ((1 + y ^ 2) ^ k) ((1 + x ^ 2) ^ k) * |w τ y| ≤ (1 + x ^ 2) ^ k * |w τ y| :=
              mul_le_mul_of_nonneg_right (min_le_right _ _) (abs_nonneg _)
          _ ≤ (1 + x ^ 2) ^ k * M :=
              mul_le_mul_of_nonneg_left (hM τ (by rw [abs_of_nonneg hτ0]; exact hτT) y) hΛ)
      (fun β τ hβ hτ0 hτT hβ' x' =>
        step w G (fun y => min ((1 + y ^ 2) ^ k) ((1 + x ^ 2) ^ k)) β a A τ hiw hGc hβ hτ0 hω
          (fun y => (mul_le_mul_of_nonneg_right (min_le_left _ _) (abs_nonneg _)).trans (ha y))
          (fun s hs0 hsτ x'' => hA ((1 + x ^ 2) ^ k) (β s) s hΛ
            (by rw [abs_of_nonneg hs0]; linarith) (fun y => hβ' s hs0 hsτ y) x'') x')
      t ht0 htT x
    simp only [min_self] at key
    calc (1 + x ^ 2) ^ k * |w t x| ≤ a * Real.exp (A * t) := key
      _ ≤ a * Real.exp (A * T) :=
          mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 (mul_le_mul_of_nonneg_left htT hA0)) ha0
  
  have hir : ∀ t x : ℝ, v (-t) x = v₀ x + ∫ s in (0 : ℝ)..t, -F (-s) x := by
    intro t x
    have hc := intervalIntegral.integral_comp_neg (a := 0) (b := t) (fun s => F s x)
    simp only at hc
    rw [hi (-t) x, intervalIntegral.integral_neg, hc, neg_zero,
      intervalIntegral.integral_symm]
  intro T k
  obtain ⟨Cp, hCp⟩ := fwd v F hi hFc hbd hF T k
  obtain ⟨Cm, hCm⟩ := fwd (fun t x => v (-t) x) (fun s x => -F (-s) x) hir
    (fun x => ((hFc x).comp continuous_neg).neg)
    (fun T' => by
      obtain ⟨M, hM⟩ := hbd T'
      exact ⟨M, fun t ht x => hM (-t) (by rwa [abs_neg]) x⟩)
    (fun T' k' => by
      obtain ⟨A, hA0, hA⟩ := hF T' k'
      refine ⟨A, hA0, fun Λ β s hΛ hs hyp x => ?_⟩
      show min ((1 + x ^ 2) ^ k') Λ * |-F (-s) x| ≤ A * β
      rw [abs_neg]
      exact hA Λ β (-s) hΛ (by rwa [abs_neg]) hyp x)
    T k
  have hCb : ∀ t : ℝ, |t| ≤ T → ∀ x : ℝ, (1 + x ^ 2) ^ k * |v t x| ≤ max Cp Cm := by
    intro t ht x
    rcases le_or_gt 0 t with h | h
    · exact (hCp t h ((le_abs_self t).trans ht) x).trans (le_max_left _ _)
    · have h1 := hCm (-t) (by linarith) (by rw [abs_of_neg h] at ht; exact ht) x
      simp only [neg_neg] at h1
      exact h1.trans (le_max_right _ _)
  obtain ⟨A, hA0, hA⟩ := hF T k
  have hFb : ∀ σ : ℝ, |σ| ≤ T → ∀ x : ℝ, (1 + x ^ 2) ^ k * |F σ x| ≤ A * max Cp Cm := by
    intro σ hσ x
    have h1 := hA ((1 + x ^ 2) ^ k) (max Cp Cm) σ (by positivity) hσ
      (fun y => (mul_le_mul_of_nonneg_right (min_le_left _ _) (abs_nonneg _)).trans
        (hCb σ hσ y)) x
    rwa [min_self] at h1
  have lip : ∀ s t : ℝ, |s| ≤ T → |t| ≤ T → ∀ x : ℝ,
      (1 + x ^ 2) ^ k * |v s x - v t x| ≤ A * max Cp Cm * |s - t| := by
    intro s t hs ht x
    have e : v s x - v t x = ∫ σ in t..s, F σ x := by
      rw [hi s x, hi t x, add_sub_add_left_eq_sub]
      exact intervalIntegral.integral_interval_sub_left ((hFc x).intervalIntegrable _ _)
        ((hFc x).intervalIntegrable _ _)
    have hw : (0 : ℝ) ≤ (1 + x ^ 2) ^ k := by positivity
    have e2 : (1 + x ^ 2) ^ k * |∫ σ in t..s, F σ x| =
        ‖∫ σ in t..s, (1 + x ^ 2) ^ k * F σ x‖ := by
      rw [intervalIntegral.integral_const_mul, Real.norm_eq_abs, abs_mul, abs_of_nonneg hw]
    rw [e, e2]
    refine intervalIntegral.norm_integral_le_of_norm_le_const (fun σ hσ => ?_)
    have hσ' := Set.uIoc_subset_uIcc hσ
    rw [Set.mem_uIcc] at hσ'
    have hσT : |σ| ≤ T := by
      rw [abs_le] at hs ht ⊢
      rcases hσ' with h | h <;> constructor <;> linarith [h.1, h.2]
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hw]
    exact hFb σ hσT x
  refine ⟨max (max Cp Cm) (A * max Cp Cm), fun s t hs ht x =>
    ⟨(hCb t ht x).trans (le_max_left _ _),
      (lip s t hs ht x).trans (mul_le_mul_of_nonneg_right (le_max_right _ _) (abs_nonneg _))⟩⟩

theorem schwartz_curve_of_regN (g : 𝓢(ℝ, ℝ)) (u F : ℝ → ℝ → ℝ)
    (hu : ∀ n : ℕ, RegN n u) (hF : ∀ n : ℕ, RegN n F)
    (hform : ∀ (n : ℕ) (t x : ℝ), iteratedDeriv n (u t) x =
      iteratedDeriv n (g : ℝ → ℝ) x + ∫ s in (0 : ℝ)..t, iteratedDeriv n (F s) x) :
    ∃ V : ℝ → 𝓢(ℝ, ℝ), (∀ t x : ℝ, V t x = u t x) ∧
      ∀ t : ℝ, ∃ W : 𝓢(ℝ, ℝ), HasDerivAt V W t ∧ ∀ x : ℝ, W x = F t x :=
by
  classical
  
  have hwt : ∀ (x : ℝ) (k : ℕ), |x| ^ k ≤ (1 + x ^ 2) ^ k := fun x k =>
    pow_le_pow_left₀ (abs_nonneg x)
      (by nlinarith [sq_abs x, sq_nonneg (|x| - 1), abs_nonneg x]) k
  
  have hslice : ∀ φ : ℝ → ℝ → ℝ, (∀ n : ℕ, RegN n φ) → ∀ t : ℝ,
      ∃ V : 𝓢(ℝ, ℝ), ∀ x : ℝ, V x = φ t x := by
    intro φ hφ t
    refine ⟨SchwartzMap.mk (φ t) (contDiff_infty.2 fun n => (hφ n).1 t) ?_, fun x => rfl⟩
    intro k n
    obtain ⟨C, hC⟩ := (hφ n).2 n le_rfl |t| k
    refine ⟨C, fun x => ?_⟩
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, Real.norm_eq_abs]
    have h := (hC t t le_rfl le_rfl x).1
    simp only at h
    exact le_trans (mul_le_mul_of_nonneg_right (hwt x k) (abs_nonneg _)) h
  choose V hV using hslice u hu
  choose W hW using hslice F hF
  
  have s5b : ∀ (c : ℝ → 𝓢(ℝ, ℝ)) (c' : 𝓢(ℝ, ℝ)) (t : ℝ), (∀ k n : ℕ,
      Filter.Tendsto (fun s : ℝ =>
        SchwartzMap.seminorm ℝ k n ((s - t)⁻¹ • (c s - c t - (s - t) • c'))) (nhds t) (nhds 0)) →
      HasDerivAt c c' t := by
    intro c c' t hc
    have G : Filter.Tendsto (fun s : ℝ => (s - t)⁻¹ • (c s - c t - (s - t) • c'))
        (nhds t) (nhds 0) := by
      rw [(schwartz_withSeminorms ℝ ℝ ℝ).tendsto_nhds _ 0]
      rintro ⟨k, n⟩ ε hε
      filter_upwards [(hc k n).eventually (gt_mem_nhds hε)] with s hs
      rw [sub_zero]
      exact hs
    have h2 : (fun s : ℝ => c s - c t - (s - t) • c') =o[ℝ; nhds t] (fun s => s - t) := by
      rw [Asymptotics.isLittleOTVS_iff_tendsto_inv_smul]
      · exact G
      · refine Filter.Eventually.of_forall (fun s hs => ?_)
        have hst : s = t := sub_eq_zero.mp hs
        subst hst
        simp
    rw [hasDerivAt_iff_hasFDerivAt]
    exact (hasFDerivAtFilter_iff_isLittleOTVS _ _ _ _).2
      (by simpa only [ContinuousLinearMap.toSpanSingleton_apply] using h2)
  have crit : ∀ (c : ℝ → 𝓢(ℝ, ℝ)) (c' : 𝓢(ℝ, ℝ)) (t : ℝ),
      (∀ k n : ℕ, ∃ C : ℝ, ∀ s : ℝ, |s - t| ≤ 1 →
        SchwartzMap.seminorm ℝ k n ((s - t)⁻¹ • (c s - c t - (s - t) • c')) ≤ C * |s - t|) →
      HasDerivAt c c' t := by
    intro c c' t h
    apply s5b c c' t
    intro k n
    obtain ⟨C, hC⟩ := h k n
    have hlim : Filter.Tendsto (fun s : ℝ => C * |s - t|) (nhds t) (nhds 0) := by
      have hc : Continuous fun s : ℝ => C * |s - t| := by fun_prop
      simpa using hc.tendsto t
    have hev : ∀ᶠ s in nhds t, |s - t| ≤ 1 := by
      have hc : Continuous fun s : ℝ => |s - t| := by fun_prop
      have h0 : Filter.Tendsto (fun s : ℝ => |s - t|) (nhds t) (nhds 0) := by
        simpa using hc.tendsto t
      exact h0.eventually (eventually_le_nhds one_pos)
    refine squeeze_zero' (Filter.Eventually.of_forall fun s => apply_nonneg _ _) ?_ hlim
    filter_upwards [hev] with s hs
    exact hC s hs
  
  have alg : ∀ (d a w B C : ℝ), 0 ≤ C → a ≤ w → w * |B| ≤ C * |d| * |d| →
      a * |d⁻¹ * B| ≤ C * |d| := by
    intro d a w B C hC haw h
    rcases eq_or_ne d 0 with h0 | h0
    · subst h0; simp
    · have hd : 0 < |d| := abs_pos.2 h0
      have hd' : |d| ≠ 0 := hd.ne'
      rw [abs_mul, abs_inv]
      have h1 : a * |B| ≤ C * |d| * |d| :=
        le_trans (mul_le_mul_of_nonneg_right haw (abs_nonneg _)) h
      calc a * (|d|⁻¹ * |B|) = |d|⁻¹ * (a * |B|) := by ring
        _ ≤ |d|⁻¹ * (C * |d| * |d|) := mul_le_mul_of_nonneg_left h1 (by positivity)
        _ = C * |d| := by field_simp
  
  refine ⟨V, hV, fun t => ⟨W t, ?_, hW t⟩⟩
  apply crit V (W t) t
  intro k n
  have hφ : TimeGood (fun σ x => iteratedDeriv n (F σ) x) := (hF n).2 n le_rfl
  obtain ⟨C₁, hC₁⟩ := hφ (|t| + 1) k
  
  have hcont : ∀ x : ℝ, Continuous fun σ : ℝ => iteratedDeriv n (F σ) x := by
    intro x
    rw [continuous_iff_continuousAt]
    intro s₀
    obtain ⟨C₀, hC₀⟩ := hφ (|s₀| + 1) 0
    rw [Metric.continuousAt_iff]
    intro ε hε
    have hK1 : 0 < |C₀| + 1 := by positivity
    refine ⟨min 1 (ε / (|C₀| + 1)), lt_min one_pos (div_pos hε hK1), fun s hs => ?_⟩
    rw [Real.dist_eq] at hs ⊢
    have hs2 : |s - s₀| < ε / (|C₀| + 1) := lt_of_lt_of_le hs (min_le_right _ _)
    have hs1 : |s - s₀| < 1 := lt_of_lt_of_le hs (min_le_left _ _)
    have hsT : |s| ≤ |s₀| + 1 := by
      have := abs_sub_abs_le_abs_sub s s₀
      linarith
    have h := (hC₀ s s₀ hsT (by linarith [abs_nonneg s₀]) x).2
    simp only [pow_zero, one_mul] at h
    have h3 : (|C₀| + 1) * |s - s₀| < (|C₀| + 1) * (ε / (|C₀| + 1)) :=
      mul_lt_mul_of_pos_left hs2 hK1
    have h4 : (|C₀| + 1) * (ε / (|C₀| + 1)) = ε := by field_simp
    have h5 : C₀ * |s - s₀| ≤ (|C₀| + 1) * |s - s₀| :=
      mul_le_mul_of_nonneg_right (by linarith [le_abs_self C₀]) (abs_nonneg _)
    linarith
  refine ⟨max C₁ 0, fun s hs => ?_⟩
  have hC0 : 0 ≤ max C₁ 0 := le_max_right _ _
  
  have hinc : ∀ x : ℝ, (1 + x ^ 2) ^ k *
      |∫ σ in t..s, (iteratedDeriv n (F σ) x - iteratedDeriv n (F t) x)| ≤
        max C₁ 0 * |s - t| * |s - t| := by
    intro x
    have hw0 : (0 : ℝ) ≤ (1 + x ^ 2) ^ k := by positivity
    have hb : ∀ σ ∈ Set.uIoc t s,
        ‖(1 + x ^ 2) ^ k * (iteratedDeriv n (F σ) x - iteratedDeriv n (F t) x)‖ ≤
          max C₁ 0 * |s - t| := by
      intro σ hσ
      have hσt : |σ - t| ≤ |s - t| := by
        rcases Set.mem_uIoc.1 hσ with ⟨h1, h2⟩ | ⟨h1, h2⟩
        · rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ σ - t),
            abs_of_nonneg (by linarith : (0 : ℝ) ≤ s - t)]
          linarith
        · rw [abs_of_nonpos (by linarith : σ - t ≤ 0), abs_of_nonpos (by linarith : s - t ≤ 0)]
          linarith
      have hσT : |σ| ≤ |t| + 1 := by
        have := abs_sub_abs_le_abs_sub σ t
        linarith
      have h := (hC₁ σ t hσT (by linarith [abs_nonneg t]) x).2
      simp only at h
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hw0]
      calc (1 + x ^ 2) ^ k * |iteratedDeriv n (F σ) x - iteratedDeriv n (F t) x|
          ≤ C₁ * |σ - t| := h
        _ ≤ max C₁ 0 * |σ - t| := mul_le_mul_of_nonneg_right (le_max_left _ _) (abs_nonneg _)
        _ ≤ max C₁ 0 * |s - t| := mul_le_mul_of_nonneg_left hσt hC0
    have hI := intervalIntegral.norm_integral_le_of_norm_le_const hb
    rw [intervalIntegral.integral_const_mul, Real.norm_eq_abs, abs_mul, abs_of_nonneg hw0] at hI
    exact hI
  have hcs := (hu n).1 s
  have hct := (hu n).1 t
  have hcF := (hF n).1 t
  have hEfun : (⇑((s - t)⁻¹ • (V s - V t - (s - t) • W t)) : ℝ → ℝ) =
      fun z => (s - t)⁻¹ * (u s z - u t z - (s - t) * F t z) := by
    funext z
    simp only [SchwartzMap.smul_apply, SchwartzMap.sub_apply, smul_eq_mul, hV, hW]
  refine SchwartzMap.seminorm_le_bound ℝ k n _ (mul_nonneg hC0 (abs_nonneg _)) (fun x => ?_)
  rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, Real.norm_eq_abs, hEfun]
  have hd1 : iteratedDeriv n (fun z => (s - t)⁻¹ * (u s z - u t z - (s - t) * F t z)) x =
      (s - t)⁻¹ * (iteratedDeriv n (u s) x - iteratedDeriv n (u t) x
        - (s - t) * iteratedDeriv n (F t) x) := by
    rw [iteratedDeriv_const_mul ((hcs.sub hct).sub (contDiff_const.mul hcF)).contDiffAt,
      iteratedDeriv_fun_sub (hcs.sub hct).contDiffAt (contDiff_const.mul hcF).contDiffAt,
      iteratedDeriv_fun_sub hcs.contDiffAt hct.contDiffAt,
      iteratedDeriv_const_mul hcF.contDiffAt]
  have hB : iteratedDeriv n (u s) x - iteratedDeriv n (u t) x
      - (s - t) * iteratedDeriv n (F t) x =
        ∫ σ in t..s, (iteratedDeriv n (F σ) x - iteratedDeriv n (F t) x) := by
    have hi : ∀ a b : ℝ,
        IntervalIntegrable (fun σ => iteratedDeriv n (F σ) x) MeasureTheory.volume a b :=
      fun a b => (hcont x).intervalIntegrable a b
    rw [hform n s x, hform n t x,
      intervalIntegral.integral_sub (hi t s) (continuous_const.intervalIntegrable t s),
      intervalIntegral.integral_const, smul_eq_mul,
      ← intervalIntegral.integral_interval_sub_left (hi 0 s) (hi 0 t)]
    ring
  rw [hd1, hB]
  exact alg (s - t) (|x| ^ k) ((1 + x ^ 2) ^ k) _ (max C₁ 0) hC0 (hwt x k) (hinc x)

theorem wflow_schwartz_regular (κ : ℝ) (hκ : 1 ≤ κ) (v₀ : 𝓢(ℝ, ℝ)) (v : ℝ → ℝ → ℝ)
    (h0 : ∀ x : ℝ, v 0 x = v₀ x) (hc : ∀ t : ℝ, Continuous (v t))
    (hb : ∀ T : ℝ, ∃ M : ℝ, ∀ t : ℝ, |t| ≤ T → ∀ x : ℝ, (1 + x ^ 2) * |v t x| ≤ M)
    (hl : ∀ T : ℝ, ∃ K : ℝ, ∀ s t : ℝ, |s| ≤ T → |t| ≤ T → ∀ x : ℝ,
      (1 + x ^ 2) * |v s x - v t x| ≤ K * |s - t|)
    (hi : ∀ t x : ℝ, v t x = v₀ x + ∫ s in (0 : ℝ)..t, wfield κ (v s) x) :
    ∃ V : ℝ → 𝓢(ℝ, ℝ), (∀ t x : ℝ, V t x = v t x) ∧
      ∀ t : ℝ, ∃ W : 𝓢(ℝ, ℝ), HasDerivAt V W t ∧ ∀ x : ℝ, W x = wfield κ (V t) x :=
by
  classical
  have hκ0 : 0 < κ := by linarith
  have hκne : κ ≠ 0 := hκ0.ne'
  have hk5 : (0 : ℝ) < 8 * κ ^ 5 := by positivity
  
  have P1 : ∀ x y : ℝ, 1 + x ^ 2 ≤ 2 * (1 + (x - y) ^ 2) * (1 + y ^ 2) := by
    intro x y
    nlinarith [sq_nonneg (x - 2 * y), sq_nonneg ((x - y) * y)]
  have Pk : ∀ (k : ℕ) (x y : ℝ),
      (1 + x ^ 2) ^ k ≤ 2 ^ k * (1 + (x - y) ^ 2) ^ k * (1 + y ^ 2) ^ k := by
    intro k x y
    rw [← mul_pow, ← mul_pow]
    exact pow_le_pow_left₀ (by positivity) (P1 x y) k
  have Ptr : ∀ (k : ℕ) (Λ : ℝ), 0 ≤ Λ → ∀ x y : ℝ,
      min ((1 + x ^ 2) ^ k) Λ ≤ 2 ^ k * (1 + (x - y) ^ 2) ^ k * min ((1 + y ^ 2) ^ k) Λ := by
    intro k Λ hΛ x y
    have hB : 1 ≤ 2 ^ k * (1 + (x - y) ^ 2) ^ k :=
      one_le_mul_of_one_le_of_one_le (one_le_pow₀ (by norm_num))
        (one_le_pow₀ (by nlinarith [sq_nonneg (x - y)]))
    rcases le_total ((1 + y ^ 2) ^ k) Λ with h | h
    · rw [min_eq_left h]
      exact (min_le_left _ _).trans (Pk k x y)
    · rw [min_eq_right h]
      exact (min_le_right _ _).trans (le_mul_of_one_le_left hΛ hB)
  have SW : ∀ k : ℕ, ∃ C : ℝ, ∀ x : ℝ, (1 + x ^ 2) ^ k * |v₀ x| ≤ C := by
    intro k
    refine ⟨2 ^ (2 * k) * ((Finset.Iic (2 * k, 0)).sup
      fun m => SchwartzMap.seminorm ℝ m.1 m.2) v₀, fun x => ?_⟩
    have h1 := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (2 * k, 0))
      (k := 2 * k) (n := 0) le_rfl le_rfl v₀ x
    rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at h1
    have h2 : (1 + x ^ 2) ^ k ≤ (1 + ‖x‖) ^ (2 * k) := by
      rw [pow_mul]
      apply pow_le_pow_left₀ (by positivity)
      rw [Real.norm_eq_abs]
      nlinarith [abs_nonneg x, sq_abs x]
    calc (1 + x ^ 2) ^ k * |v₀ x| ≤ (1 + ‖x‖) ^ (2 * k) * |v₀ x| :=
          mul_le_mul_of_nonneg_right h2 (abs_nonneg _)
      _ ≤ _ := h1
  have tri : ∀ X Y : ℝ, |X - Y| ≤ |X| + |Y| := fun X Y =>
    abs_le.2 ⟨by linarith [neg_abs_le X, le_abs_self Y], by linarith [le_abs_self X, neg_abs_le Y]⟩
  have comb : ∀ (w X Y a : ℝ), 0 ≤ w → w * |X| ≤ a → w * |Y| ≤ a →
      w * |8 * κ ^ 5 * (X - Y)| ≤ 16 * κ ^ 5 * a := by
    intro w X Y a hw hX hY
    rw [abs_mul, abs_of_pos hk5]
    have h3 : w * |X - Y| ≤ w * |X| + w * |Y| := by
      rw [← mul_add]; exact mul_le_mul_of_nonneg_left (tri X Y) hw
    calc w * (8 * κ ^ 5 * |X - Y|) = 8 * κ ^ 5 * (w * |X - Y|) := by ring
      _ ≤ 8 * κ ^ 5 * (a + a) := mul_le_mul_of_nonneg_left (by linarith) hk5.le
      _ = 16 * κ ^ 5 * a := by ring
  
  choose M hM using hb
  choose K hK using hl
  have hρ : ∀ x : ℝ, 1 ≤ 1 + x ^ 2 := fun x => by nlinarith [sq_nonneg x]
  have hvb : ∀ T t : ℝ, |t| ≤ T → ∀ x : ℝ, |v t x| ≤ M T := by
    intro T t ht x
    have h1 := hM T t ht x
    have h2 : |v t x| ≤ (1 + x ^ 2) * |v t x| := le_mul_of_one_le_left (abs_nonneg _) (hρ x)
    linarith
  have hM0 : ∀ T t : ℝ, |t| ≤ T → 0 ≤ M T := fun T t ht => (abs_nonneg _).trans (hvb T t ht 0)
  have hvl : ∀ T s t : ℝ, |s| ≤ T → |t| ≤ T → ∀ x : ℝ, |v s x - v t x| ≤ K T * |s - t| := by
    intro T s t hs ht x
    have h1 := hK T s t hs ht x
    have h2 : |v s x - v t x| ≤ (1 + x ^ 2) * |v s x - v t x| :=
      le_mul_of_one_le_left (abs_nonneg _) (hρ x)
    linarith
  obtain ⟨-, -, Gz, GzR⟩ := rgreen_hasDerivAt_of_decay κ hκ0 (fun _ => (0 : ℝ)) 0
    continuous_const (fun x => by simp)
  
  have hFlip : ∀ T : ℝ, ∃ K' : ℝ, 0 ≤ K' ∧ ∀ s t : ℝ, |s| ≤ T → |t| ≤ T → ∀ x : ℝ,
      |wfield κ (v s) x - wfield κ (v t) x| ≤ K' * |s - t| := by
    intro T
    obtain ⟨A, hA0, hA⟩ := rgreen_weighted_lipschitz κ hκ0 (M T) 0
    refine ⟨16 * κ ^ 5 * (A * |K T|), by positivity, fun s t hs ht x => ?_⟩
    have h := hA (v s) (v t) (fun _ => 1) (|K T| * |s - t|) (hc s) (hc t) (hM T s hs) (hM T t ht)
      (fun _ => zero_le_one) (fun x y => by simp)
      (fun y => by
        have h1 := hvl T s t hs ht y
        have h2 : K T * |s - t| ≤ |K T| * |s - t| :=
          mul_le_mul_of_nonneg_right (le_abs_self _) (abs_nonneg _)
        simp only [one_mul]; linarith) x
    obtain ⟨h1, h2⟩ := h
    have e : wfield κ (v s) x - wfield κ (v t) x = 8 * κ ^ 5 *
        ((rgreen κ (v s) x - rgreen κ (v t) x) - (rgreenR κ (v s) x - rgreenR κ (v t) x)) := by
      unfold wfield; ring
    rw [e]
    have := comb 1 _ _ _ zero_le_one h1 h2
    rw [one_mul] at this
    calc _ ≤ 16 * κ ^ 5 * (A * (|K T| * |s - t|)) := this
      _ = 16 * κ ^ 5 * (A * |K T|) * |s - t| := by ring
  have hFc : ∀ x : ℝ, Continuous fun s : ℝ => wfield κ (v s) x := by
    intro x
    rw [continuous_iff_continuousAt]
    intro s₀
    obtain ⟨K', hK'0, hK'⟩ := hFlip (|s₀| + 1)
    rw [Metric.continuousAt_iff]
    intro ε hε
    have hK1 : 0 < K' + 1 := by linarith
    refine ⟨min 1 (ε / (K' + 1)), lt_min one_pos (div_pos hε hK1), fun s hs => ?_⟩
    rw [Real.dist_eq] at hs ⊢
    have hs1 : |s - s₀| < 1 := lt_of_lt_of_le hs (min_le_left _ _)
    have hs2 : |s - s₀| < ε / (K' + 1) := lt_of_lt_of_le hs (min_le_right _ _)
    have hsT : |s| ≤ |s₀| + 1 := by
      have := abs_sub_abs_le_abs_sub s s₀
      linarith
    have h := hK' s s₀ hsT (by linarith [abs_nonneg s₀]) x
    have h3 : (K' + 1) * |s - s₀| < (K' + 1) * (ε / (K' + 1)) := mul_lt_mul_of_pos_left hs2 hK1
    have h4 : (K' + 1) * (ε / (K' + 1)) = ε := by field_simp
    nlinarith [abs_nonneg (s - s₀)]
  
  have hTG : TimeGood v := by
    refine family_weight_propagation (⇑v₀) v (fun s x => wfield κ (v s) x) hi hFc
      (fun T => ⟨M T, hvb T⟩) ?_ SW
    intro T k
    obtain ⟨A₁, hA₁0, hA₁⟩ := rgreen_weighted_lipschitz κ hκ0 (M T) k
    refine ⟨16 * κ ^ 5 * A₁, by positivity, fun Λ β s hΛ hs hβ x => ?_⟩
    have hω : ∀ y : ℝ, 0 ≤ min ((1 + y ^ 2) ^ k) Λ := fun y => le_min (by positivity) hΛ
    have h := hA₁ (v s) (fun _ => 0) (fun y => min ((1 + y ^ 2) ^ k) Λ) β (hc s) continuous_const
      (hM T s hs) (fun y => by simpa using hM0 T s hs) hω
      (fun x y => Ptr k Λ hΛ x y) (fun y => by simp only [sub_zero]; exact hβ y) x
    rw [Gz, GzR] at h
    obtain ⟨h1, h2⟩ := h
    have e : wfield κ (v s) x = 8 * κ ^ 5 *
        ((rgreen κ (v s) x - 1 / (2 * κ)) - (rgreenR κ (v s) x - 1 / (2 * κ))) := by
      unfold wfield; ring
    show min ((1 + x ^ 2) ^ k) Λ * |wfield κ (v s) x| ≤ 16 * κ ^ 5 * A₁ * β
    rw [e, mul_assoc (16 * κ ^ 5)]
    exact comb _ _ _ _ (hω x) h1 h2
  
  have TGof : ∀ G : (ℝ → ℝ) → ℝ → ℝ,
      (∀ x : ℝ, G (fun _ => (0 : ℝ)) x = 1 / (2 * κ)) →
      (∀ (T : ℝ) (k : ℕ), ∃ A : ℝ, 0 ≤ A ∧ ∀ (f g ω : ℝ → ℝ) (β : ℝ), Continuous f →
        Continuous g → (∀ x : ℝ, (1 + x ^ 2) * |f x| ≤ M T) →
        (∀ x : ℝ, (1 + x ^ 2) * |g x| ≤ M T) → (∀ x : ℝ, 0 ≤ ω x) →
        (∀ x y : ℝ, ω x ≤ 2 ^ k * (1 + (x - y) ^ 2) ^ k * ω y) →
        (∀ y : ℝ, ω y * |f y - g y| ≤ β) → ∀ x : ℝ, ω x * |G f x - G g x| ≤ A * β) →
      TimeGood (fun t x => G (v t) x - 1 / (2 * κ)) := by
    intro G hG0 hGL T k
    obtain ⟨A, hA0, hA⟩ := hGL T k
    obtain ⟨C, hC⟩ := hTG T k
    refine ⟨A * C, fun s t hs ht x => ⟨?_, ?_⟩⟩
    · have h := hA (v t) (fun _ => 0) (fun y => (1 + y ^ 2) ^ k) C (hc t) continuous_const
        (hM T t ht) (fun y => by simpa using hM0 T t ht) (fun y => by positivity)
        (fun x y => Pk k x y) (fun y => by simp only [sub_zero]; exact (hC t t ht ht y).1) x
      rw [hG0] at h
      exact h
    · have h := hA (v s) (v t) (fun y => (1 + y ^ 2) ^ k) (C * |s - t|) (hc s) (hc t)
        (hM T s hs) (hM T t ht) (fun y => by positivity) (fun x y => Pk k x y)
        (fun y => (hC s t hs ht y).2) x
      have e : G (v s) x - 1 / (2 * κ) - (G (v t) x - 1 / (2 * κ)) = G (v s) x - G (v t) x := by
        ring
      show (1 + x ^ 2) ^ k * |G (v s) x - 1 / (2 * κ) - (G (v t) x - 1 / (2 * κ))| ≤
        A * C * |s - t|
      rw [e, mul_assoc]
      exact h
  have hTGH : TimeGood (fun t x => rgreen κ (v t) x - 1 / (2 * κ)) :=
    TGof (rgreen κ) Gz (fun T k => by
      obtain ⟨A, hA0, hA⟩ := rgreen_weighted_lipschitz κ hκ0 (M T) k
      exact ⟨A, hA0, fun f g ω β hf hg hfM hgM hω hωp hβ x =>
        (hA f g ω β hf hg hfM hgM hω hωp hβ x).1⟩)
  have hTGH' : TimeGood (fun t x => rgreenR κ (v t) x - 1 / (2 * κ)) :=
    TGof (rgreenR κ) GzR (fun T k => by
      obtain ⟨A, hA0, hA⟩ := rgreen_weighted_lipschitz κ hκ0 (M T) k
      exact ⟨A, hA0, fun f g ω β hf hg hfM hgM hω hωp hβ x =>
        (hA f g ω β hf hg hfM hgM hω hωp hβ x).2⟩)
  have hode : ∀ t x : ℝ, HasDerivAt (fun x => rgreen κ (v t) x - 1 / (2 * κ))
      ((2 * v t x + -2 * κ) * (rgreen κ (v t) x - 1 / (2 * κ)) + 1 / κ * v t x) x ∧
      HasDerivAt (fun x => rgreenR κ (v t) x - 1 / (2 * κ))
      ((-2 * v t x + 2 * κ) * (rgreenR κ (v t) x - 1 / (2 * κ)) + -1 / κ * v t x) x := by
    intro t x
    obtain ⟨hG, hGR, -, -⟩ :=
      rgreen_hasDerivAt_of_decay κ hκ0 (v t) (M |t|) (hc t) (hM |t| t le_rfl)
    constructor
    · refine ((hG x).sub_const (1 / (2 * κ))).congr_deriv ?_
      field_simp
      ring
    · refine ((hGR x).sub_const (1 / (2 * κ))).congr_deriv ?_
      field_simp
      ring
  have regN_linear_ode_bootstrap : ∀ (a b c : ℝ) (n : ℕ) (φ Y : ℝ → ℝ → ℝ),
      RegN n φ → TimeGood Y →
      (∀ t x : ℝ, HasDerivAt (Y t) ((a * φ t x + b) * Y t x + c * φ t x) x) →
      RegN (n + 1) Y := by
    intro a b c n φ Y hφ hY hd
    obtain ⟨A0, A1, A2, A3, A4⟩ := regN_algebra
    have hdiff : ∀ t x : ℝ, DifferentiableAt ℝ (Y t) x := fun t x => (hd t x).differentiableAt
    have key : ∀ m : ℕ, RegN m φ → RegN m Y → RegN m (fun t x => deriv (Y t) x) := by
      intro m hφm hYm
      have h2 := A3 m 1 c _ _ (A3 m a b _ _ (A4 m φ Y hφm hYm) hYm) hφm
      convert h2 using 1
      funext t x
      show deriv (Y t) x = 1 * (a * (φ t x * Y t x) + b * Y t x) + c * φ t x
      rw [(hd t x).deriv]
      ring
    induction n with
    | zero =>
      have hY0 : RegN 0 Y := (A0 Y).2 ⟨fun t => continuous_iff_continuousAt.2
        fun x => (hdiff t x).continuousAt, hY⟩
      exact (A1 0 Y).2 ⟨hY, hdiff, key 0 hφ hY0⟩
    | succ n ih =>
      have hYn : RegN (n + 1) Y := ih (A2 n φ hφ)
      exact (A1 (n + 1) Y).2 ⟨hY, hdiff, key (n + 1) hφ hYn⟩
  have hstep : ∀ n : ℕ, RegN n v → RegN (n + 1) (fun s x => wfield κ (v s) x) := by
    intro n hn
    have hH := regN_linear_ode_bootstrap 2 (-2 * κ) (1 / κ) n v
      (fun t x => rgreen κ (v t) x - 1 / (2 * κ)) hn hTGH (fun t x => (hode t x).1)
    have hH' := regN_linear_ode_bootstrap (-2) (2 * κ) (-1 / κ) n v
      (fun t x => rgreenR κ (v t) x - 1 / (2 * κ)) hn hTGH' (fun t x => (hode t x).2)
    have hlin := regN_algebra.2.2.2.1 (n + 1) (8 * κ ^ 5) (-(8 * κ ^ 5)) _ _ hH hH'
    convert hlin using 1
    funext t x
    show wfield κ (v t) x = 8 * κ ^ 5 * (rgreen κ (v t) x - 1 / (2 * κ)) +
      -(8 * κ ^ 5) * (rgreenR κ (v t) x - 1 / (2 * κ))
    unfold wfield
    ring
  
  have hv : ∀ n : ℕ, RegN n v := by
    intro n
    induction n with
    | zero => exact (regN_algebra.1 v).2 ⟨hc, hTG⟩
    | succ n ih =>
      exact (regN_time_integral (n + 1) v₀ (fun s x => wfield κ (v s) x) v (hstep n ih) hi).1
  have hFall : ∀ n : ℕ, RegN n (fun s x => wfield κ (v s) x) :=
    fun n => regN_algebra.2.2.1 n _ (hstep n (hv n))
  have hform : ∀ (n : ℕ) (t x : ℝ), iteratedDeriv n (v t) x =
      iteratedDeriv n (v₀ : ℝ → ℝ) x +
        ∫ s in (0 : ℝ)..t, iteratedDeriv n ((fun s x => wfield κ (v s) x) s) x :=
    fun n => (regN_time_integral n v₀ _ v (hFall n) hi).2 n le_rfl
  
  obtain ⟨V, hV, hW⟩ := schwartz_curve_of_regN v₀ v (fun s x => wfield κ (v s) x) hv hFall hform
  refine ⟨V, hV, fun t => ?_⟩
  obtain ⟨W, hWd, hWx⟩ := hW t
  have hVt : (V t : ℝ → ℝ) = v t := funext (hV t)
  exact ⟨W, hWd, fun x => by rw [hWx x, hVt]⟩

theorem schwartz_translate_curve (μ : ℝ) (v V : ℝ → 𝓢(ℝ, ℝ))
    (hv : ∀ t : ℝ, HasDerivAt v (V t) t) :
    ∃ w : ℝ → 𝓢(ℝ, ℝ), (∀ t x : ℝ, w t x = v t (x + μ * t)) ∧
      ∀ t : ℝ, ∃ W : 𝓢(ℝ, ℝ), HasDerivAt w W t ∧
        ∀ x : ℝ, W x = μ * deriv (v t : ℝ → ℝ) (x + μ * t) + V t (x + μ * t) :=
by
  classical
  
  have hsm : ∀ (f : 𝓢(ℝ, ℝ)) (m : ℕ), ContDiff ℝ m (f : ℝ → ℝ) := fun f m =>
    (f.smooth ⊤).of_le (by exact_mod_cast le_top)
  
  have F2 : ∀ (f : 𝓢(ℝ, ℝ)) (k m : ℕ) (x : ℝ),
      |x| ^ k * |iteratedDeriv m (f : ℝ → ℝ) x| ≤ SchwartzMap.seminorm ℝ k m f := by
    intro f k m x
    have h := SchwartzMap.le_seminorm ℝ k m f x
    rwa [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, Real.norm_eq_abs] at h
  
  have F3 : ∀ (g : 𝓢(ℝ, ℝ)) (k n : ℕ) (M : ℝ), 0 ≤ M →
      (∀ x : ℝ, |x| ^ k * |iteratedDeriv n (g : ℝ → ℝ) x| ≤ M) →
        SchwartzMap.seminorm ℝ k n g ≤ M := by
    intro g k n M hM h
    refine SchwartzMap.seminorm_le_bound ℝ k n g hM (fun x => ?_)
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, Real.norm_eq_abs]
    exact h x
  
  have hE : ∀ (a b : ℝ) (k : ℕ), 0 ≤ a → 0 ≤ b → (a + b) ^ k ≤ 2 ^ k * (a ^ k + b ^ k) := by
    intro a b k ha hb
    have h2 : (0 : ℝ) ≤ 2 ^ k := by positivity
    rcases le_total a b with hab | hab
    · calc (a + b) ^ k ≤ (2 * b) ^ k := pow_le_pow_left₀ (by linarith) (by linarith) k
        _ = 2 ^ k * b ^ k := mul_pow 2 b k
        _ ≤ 2 ^ k * (a ^ k + b ^ k) :=
          mul_le_mul_of_nonneg_left (by linarith [pow_nonneg ha k]) h2
    · calc (a + b) ^ k ≤ (2 * a) ^ k := pow_le_pow_left₀ (by linarith) (by linarith) k
        _ = 2 ^ k * a ^ k := mul_pow 2 a k
        _ ≤ 2 ^ k * (a ^ k + b ^ k) :=
          mul_le_mul_of_nonneg_left (by linarith [pow_nonneg hb k]) h2
  
  have hW : ∀ (x y c N P P₀ : ℝ) (k : ℕ), 0 ≤ c → 0 ≤ N → |x| ≤ |y| + c →
      |y| ^ k * N ≤ P → N ≤ P₀ → |x| ^ k * N ≤ 2 ^ k * (P + c ^ k * P₀) := by
    intro x y c N P P₀ k hc hN hxy hP hP₀
    have h1 : |x| ^ k ≤ 2 ^ k * (|y| ^ k + c ^ k) :=
      (pow_le_pow_left₀ (abs_nonneg x) hxy k).trans (hE _ _ k (abs_nonneg y) hc)
    have h2 : c ^ k * N ≤ c ^ k * P₀ := mul_le_mul_of_nonneg_left hP₀ (pow_nonneg hc k)
    calc |x| ^ k * N ≤ 2 ^ k * (|y| ^ k + c ^ k) * N := mul_le_mul_of_nonneg_right h1 hN
      _ = 2 ^ k * (|y| ^ k * N + c ^ k * N) := by ring
      _ ≤ 2 ^ k * (P + c ^ k * P₀) :=
          mul_le_mul_of_nonneg_left (add_le_add hP h2) (by positivity)
  
  have hP : ∀ (f : 𝓢(ℝ, ℝ)) (a x : ℝ) (k n : ℕ),
      |x| ^ k * |iteratedDeriv n (fun z => f (z + a)) x| ≤
        2 ^ k * (SchwartzMap.seminorm ℝ k n f + |a| ^ k * SchwartzMap.seminorm ℝ 0 n f) := by
    intro f a x k n
    rw [iteratedDeriv_comp_add_const]
    refine hW x (x + a) |a| _ _ _ k (abs_nonneg a) (abs_nonneg _) ?_ (F2 f k n (x + a)) ?_
    · exact abs_le.2 ⟨by linarith [neg_abs_le (x + a), le_abs_self a],
        by linarith [le_abs_self (x + a), neg_abs_le a]⟩
    · simpa only [pow_zero, one_mul] using F2 f 0 n (x + a)
  
  have hτex : ∀ (f : 𝓢(ℝ, ℝ)) (a : ℝ), ∃ g : 𝓢(ℝ, ℝ), ∀ x : ℝ, g x = f (x + a) := by
    intro f a
    refine ⟨SchwartzMap.mk (fun x => f (x + a))
      ((f.smooth ⊤).comp (contDiff_id.add contDiff_const)) ?_, fun x => rfl⟩
    intro k n
    refine ⟨2 ^ k * (SchwartzMap.seminorm ℝ k n f + |a| ^ k * SchwartzMap.seminorm ℝ 0 n f),
      fun x => ?_⟩
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, Real.norm_eq_abs]
    exact hP f a x k n
  choose τ hτ using hτex
  
  have hτb : ∀ (f : 𝓢(ℝ, ℝ)) (a : ℝ) (k n : ℕ), SchwartzMap.seminorm ℝ k n (τ f a) ≤
      2 ^ k * (SchwartzMap.seminorm ℝ k n f + |a| ^ k * SchwartzMap.seminorm ℝ 0 n f) := by
    intro f a k n
    have hfun : (τ f a : ℝ → ℝ) = fun z => f (z + a) := funext (hτ f a)
    refine F3 _ k n _ (mul_nonneg (by positivity) (add_nonneg (apply_nonneg _ _)
      (mul_nonneg (by positivity) (apply_nonneg _ _)))) (fun x => ?_)
    rw [hfun]
    exact hP f a x k n
  
  have hφd : ∀ (f : 𝓢(ℝ, ℝ)) (m : ℕ) (y : ℝ),
      HasDerivAt (iteratedDeriv m (f : ℝ → ℝ)) (iteratedDeriv (m + 1) (f : ℝ → ℝ) y) y := by
    intro f m y
    rw [iteratedDeriv_succ]
    exact (((hsm f (m + 1)).differentiable_iteratedDeriv m
      (by exact_mod_cast Nat.lt_succ_self m)) y).hasDerivAt
  
  have hTaylor : ∀ (f f' g : 𝓢(ℝ, ℝ)) (b h : ℝ), (∀ x : ℝ, f' x = deriv (f : ℝ → ℝ) x) →
      |h| ≤ 1 → (∀ x : ℝ, g x = f (x + b + h) - f (x + b) - h * f' (x + b)) → ∀ k n : ℕ,
      SchwartzMap.seminorm ℝ k n g ≤ h ^ 2 * (2 ^ k * (SchwartzMap.seminorm ℝ k (n + 2) f
            + (|b| + 1) ^ k * SchwartzMap.seminorm ℝ 0 (n + 2) f)) := by
    intro f f' g b h hf' hh hg k n
    obtain ⟨K, hK⟩ : ∃ K : ℝ, K = 2 ^ k * (SchwartzMap.seminorm ℝ k (n + 2) f
        + (|b| + 1) ^ k * SchwartzMap.seminorm ℝ 0 (n + 2) f) := ⟨_, rfl⟩
    rw [← hK]
    have hK0 : 0 ≤ K := by
      rw [hK]
      exact mul_nonneg (by positivity) (add_nonneg (apply_nonneg _ _)
        (mul_nonneg (by positivity) (apply_nonneg _ _)))
    have hgf : (g : ℝ → ℝ) = fun z => f (z + (b + h)) - f (z + b) - h * f' (z + b) := by
      funext z
      rw [hg z, add_assoc]
    have hf'φ : iteratedDeriv n (f' : ℝ → ℝ) = iteratedDeriv (n + 1) (f : ℝ → ℝ) := by
      rw [iteratedDeriv_succ']
      congr 1
      funext z
      exact hf' z
    have hgd : ∀ x : ℝ, iteratedDeriv n (g : ℝ → ℝ) x =
        iteratedDeriv n (f : ℝ → ℝ) (x + (b + h)) - iteratedDeriv n (f : ℝ → ℝ) (x + b)
          - h * iteratedDeriv (n + 1) (f : ℝ → ℝ) (x + b) := by
      intro x
      have c1 : ContDiff ℝ n (fun z => f (z + (b + h))) :=
        (hsm f n).comp (contDiff_id.add contDiff_const)
      have c2 : ContDiff ℝ n (fun z => f (z + b)) :=
        (hsm f n).comp (contDiff_id.add contDiff_const)
      have c3 : ContDiff ℝ n (fun z => f' (z + b)) :=
        (hsm f' n).comp (contDiff_id.add contDiff_const)
      rw [hgf, iteratedDeriv_fun_sub (c1.sub c2).contDiffAt (contDiff_const.mul c3).contDiffAt,
        iteratedDeriv_fun_sub c1.contDiffAt c2.contDiffAt, iteratedDeriv_const_mul c3.contDiffAt]
      simp only [iteratedDeriv_comp_add_const, hf'φ]
    refine F3 g k n _ (mul_nonneg (sq_nonneg h) hK0) (fun x => ?_)
    rw [hgd x, ← add_assoc]
    have hxk : 0 ≤ |x| ^ k := pow_nonneg (abs_nonneg x) k
    have hc : ∀ θ : ℝ, |θ| ≤ 1 →
        |x| ^ k * |iteratedDeriv (n + 2) (f : ℝ → ℝ) (x + b + θ)| ≤ K := by
      intro θ hθ
      obtain ⟨hθ1, hθ2⟩ := abs_le.1 hθ
      rw [hK]
      refine hW x (x + b + θ) (|b| + 1) _ _ _ k (by positivity) (abs_nonneg _) ?_
        (F2 f k (n + 2) _) ?_
      · exact abs_le.2 ⟨by linarith [neg_abs_le (x + b + θ), le_abs_self b],
          by linarith [le_abs_self (x + b + θ), neg_abs_le b]⟩
      · simpa only [pow_zero, one_mul] using F2 f 0 (n + 2) (x + b + θ)
    have hd1 : ∀ σ : ℝ, HasDerivAt
        (fun σ => |x| ^ k * iteratedDeriv (n + 1) (f : ℝ → ℝ) (x + b + σ))
        (|x| ^ k * iteratedDeriv (n + 2) (f : ℝ → ℝ) (x + b + σ)) σ := by
      intro σ
      exact ((hφd f (n + 1) (x + b + σ)).comp_const_add (x + b) σ).const_mul (|x| ^ k)
    have hmvt1 : ∀ θ : ℝ, |θ| ≤ 1 → |x| ^ k * |iteratedDeriv (n + 1) (f : ℝ → ℝ) (x + b + θ)
        - iteratedDeriv (n + 1) (f : ℝ → ℝ) (x + b)| ≤ K * |θ| := by
      intro θ hθ
      have h0 : (0 : ℝ) ∈ Set.Icc (-1 : ℝ) 1 := ⟨by norm_num, by norm_num⟩
      have := Convex.norm_image_sub_le_of_norm_deriv_le
        (f := fun σ => |x| ^ k * iteratedDeriv (n + 1) (f : ℝ → ℝ) (x + b + σ))
        (s := Set.Icc (-1 : ℝ) 1) (C := K)
        (fun σ _ => (hd1 σ).differentiableAt)
        (fun σ hσ => by
          rw [(hd1 σ).deriv, Real.norm_eq_abs, abs_mul, abs_of_nonneg hxk]
          exact hc σ (abs_le.2 hσ))
        (convex_Icc _ _) h0 (abs_le.1 hθ)
      simp only [add_zero, sub_zero, Real.norm_eq_abs] at this
      rw [← mul_sub, abs_mul, abs_of_nonneg hxk] at this
      exact this
    have hd2 : ∀ σ : ℝ, HasDerivAt
        (fun σ => |x| ^ k * (iteratedDeriv n (f : ℝ → ℝ) (x + b + σ)
          - iteratedDeriv n (f : ℝ → ℝ) (x + b) - σ * iteratedDeriv (n + 1) (f : ℝ → ℝ) (x + b)))
        (|x| ^ k * (iteratedDeriv (n + 1) (f : ℝ → ℝ) (x + b + σ)
          - iteratedDeriv (n + 1) (f : ℝ → ℝ) (x + b))) σ := by
      intro σ
      have h1 := ((((hφd f n (x + b + σ)).comp_const_add (x + b) σ).sub_const
        (iteratedDeriv n (f : ℝ → ℝ) (x + b))).sub
        ((hasDerivAt_id' σ).mul_const (iteratedDeriv (n + 1) (f : ℝ → ℝ) (x + b)))).const_mul
        (|x| ^ k)
      refine h1.congr_deriv ?_
      ring
    have hmvt2 := Convex.norm_image_sub_le_of_norm_deriv_le
      (f := fun σ => |x| ^ k * (iteratedDeriv n (f : ℝ → ℝ) (x + b + σ)
          - iteratedDeriv n (f : ℝ → ℝ) (x + b) - σ * iteratedDeriv (n + 1) (f : ℝ → ℝ) (x + b)))
      (s := Set.Icc (-|h|) |h|) (C := K * |h|)
      (fun σ _ => (hd2 σ).differentiableAt)
      (fun σ hσ => by
        have hσ' : |σ| ≤ |h| := abs_le.2 hσ
        rw [(hd2 σ).deriv, Real.norm_eq_abs, abs_mul, abs_of_nonneg hxk]
        calc |x| ^ k * |iteratedDeriv (n + 1) (f : ℝ → ℝ) (x + b + σ)
              - iteratedDeriv (n + 1) (f : ℝ → ℝ) (x + b)| ≤ K * |σ| := hmvt1 σ (hσ'.trans hh)
          _ ≤ K * |h| := mul_le_mul_of_nonneg_left hσ' hK0)
      (convex_Icc _ _)
      (⟨by linarith [abs_nonneg h], abs_nonneg h⟩ : (0 : ℝ) ∈ Set.Icc (-|h|) |h|)
      (⟨neg_abs_le h, le_abs_self h⟩ : h ∈ Set.Icc (-|h|) |h|)
    simp only [add_zero, sub_zero, zero_mul, sub_self, mul_zero, Real.norm_eq_abs] at hmvt2
    rw [abs_mul, abs_of_nonneg hxk] at hmvt2
    calc _ ≤ K * |h| * |h| := hmvt2
      _ = h ^ 2 * K := by rw [mul_assoc, abs_mul_abs_self]; ring
  
  have s5a : ∀ (c : ℝ → 𝓢(ℝ, ℝ)) (c' : 𝓢(ℝ, ℝ)) (t : ℝ), HasDerivAt c c' t → ∀ k n : ℕ,
      Filter.Tendsto (fun s : ℝ =>
        SchwartzMap.seminorm ℝ k n ((s - t)⁻¹ • (c s - c t - (s - t) • c'))) (nhds t) (nhds 0) := by
    intro c c' t hc k n
    rw [hasDerivAt_iff_hasFDerivAt] at hc
    have h1 := HasFDerivAtFilter.isLittleOTVS hc
    simp only [ContinuousLinearMap.toSpanSingleton_apply] at h1
    have G := h1.tendsto_inv_smul
    rw [(schwartz_withSeminorms ℝ ℝ ℝ).tendsto_nhds _ 0] at G
    rw [Metric.tendsto_nhds]
    intro ε hε
    filter_upwards [G (k, n) ε hε] with s hs
    rw [sub_zero] at hs
    rw [Real.dist_eq, sub_zero, abs_of_nonneg (apply_nonneg _ _)]
    exact hs
  
  have s5b : ∀ (c : ℝ → 𝓢(ℝ, ℝ)) (c' : 𝓢(ℝ, ℝ)) (t : ℝ), (∀ k n : ℕ,
      Filter.Tendsto (fun s : ℝ =>
        SchwartzMap.seminorm ℝ k n ((s - t)⁻¹ • (c s - c t - (s - t) • c'))) (nhds t) (nhds 0)) →
      HasDerivAt c c' t := by
    intro c c' t hc
    have G : Filter.Tendsto (fun s : ℝ => (s - t)⁻¹ • (c s - c t - (s - t) • c'))
        (nhds t) (nhds 0) := by
      rw [(schwartz_withSeminorms ℝ ℝ ℝ).tendsto_nhds _ 0]
      rintro ⟨k, n⟩ ε hε
      filter_upwards [(hc k n).eventually (gt_mem_nhds hε)] with s hs
      rw [sub_zero]
      exact hs
    have h2 : (fun s : ℝ => c s - c t - (s - t) • c') =o[ℝ; nhds t] (fun s => s - t) := by
      rw [Asymptotics.isLittleOTVS_iff_tendsto_inv_smul]
      · exact G
      · refine Filter.Eventually.of_forall (fun s hs => ?_)
        have hst : s = t := sub_eq_zero.mp hs
        subst hst
        simp
    rw [hasDerivAt_iff_hasFDerivAt]
    exact (hasFDerivAtFilter_iff_isLittleOTVS _ _ _ _).2
      (by simpa only [ContinuousLinearMap.toSpanSingleton_apply] using h2)
  
  have hkey : ∀ d K : ℝ, |d⁻¹| * ((μ * d) ^ 2 * K) = μ ^ 2 * |d| * K := by
    intro d K
    rcases eq_or_ne d 0 with h0 | h0
    · simp [h0]
    · have hd : 0 < |d| := abs_pos.2 h0
      rw [abs_inv, mul_pow, ← sq_abs d]
      field_simp
  
  refine ⟨fun s => τ (v s) (μ * s), fun s x => hτ _ _ _, fun t => ?_⟩
  obtain ⟨D, hD⟩ : ∃ D : 𝓢(ℝ, ℝ), ∀ x : ℝ, D x = deriv (v t : ℝ → ℝ) x :=
    ⟨SchwartzMap.derivCLM ℝ ℝ (v t), fun x => SchwartzMap.derivCLM_apply ℝ (v t) x⟩
  obtain ⟨D₂, hD₂⟩ : ∃ D₂ : 𝓢(ℝ, ℝ), ∀ x : ℝ, D₂ x = deriv (V t : ℝ → ℝ) x :=
    ⟨SchwartzMap.derivCLM ℝ ℝ (V t), fun x => SchwartzMap.derivCLM_apply ℝ (V t) x⟩
  refine ⟨τ (V t) (μ * t) + μ • τ D (μ * t), ?_, fun x => ?_⟩
  swap
  · simp only [SchwartzMap.add_apply, SchwartzMap.smul_apply, smul_eq_mul, hτ, hD]
    ring
  refine s5b _ _ t (fun k n => ?_)
  show Filter.Tendsto (fun s : ℝ => SchwartzMap.seminorm ℝ k n ((s - t)⁻¹ •
    (τ (v s) (μ * s) - τ (v t) (μ * t) - (s - t) • (τ (V t) (μ * t) + μ • τ D (μ * t)))))
    (nhds t) (nhds 0)
  have hEk := s5a v (V t) t (hv t) k n
  have hE0 := s5a v (V t) t (hv t) 0 n
  obtain ⟨K₁, hK₁⟩ : ∃ K₁ : ℝ, K₁ = 2 ^ k * (SchwartzMap.seminorm ℝ k (n + 2) (v t)
      + (|μ * t| + 1) ^ k * SchwartzMap.seminorm ℝ 0 (n + 2) (v t)) := ⟨_, rfl⟩
  obtain ⟨K₂, hK₂⟩ : ∃ K₂ : ℝ, K₂ = 2 ^ k * (SchwartzMap.seminorm ℝ k (n + 2) (V t)
      + (|μ * t| + 1) ^ k * SchwartzMap.seminorm ℝ 0 (n + 2) (V t)) := ⟨_, rfl⟩
  obtain ⟨M, hM⟩ : ∃ M : ℝ, M = SchwartzMap.seminorm ℝ k n (τ D₂ (μ * t)) := ⟨_, rfl⟩
  
  have hid : ∀ s : ℝ, (s - t)⁻¹ •
      (τ (v s) (μ * s) - τ (v t) (μ * t) - (s - t) • (τ (V t) (μ * t) + μ • τ D (μ * t))) =
      τ ((s - t)⁻¹ • (v s - v t - (s - t) • V t)) (μ * s)
        + ((τ (V t) (μ * s) - τ (V t) (μ * t) - (μ * (s - t)) • τ D₂ (μ * t))
          + (μ * (s - t)) • τ D₂ (μ * t))
        + (s - t)⁻¹ • (τ (v t) (μ * s) - τ (v t) (μ * t) - (μ * (s - t)) • τ D (μ * t)) := by
    intro s
    ext x
    simp only [SchwartzMap.add_apply, SchwartzMap.sub_apply, SchwartzMap.smul_apply,
      smul_eq_mul, hτ]
    rcases eq_or_ne (s - t) 0 with h0 | h0
    · have hst : s = t := sub_eq_zero.mp h0
      subst hst
      simp
    · field_simp
      ring
  
  have hA : ∀ s : ℝ,
      SchwartzMap.seminorm ℝ k n (τ ((s - t)⁻¹ • (v s - v t - (s - t) • V t)) (μ * s)) ≤
        2 ^ k * (SchwartzMap.seminorm ℝ k n ((s - t)⁻¹ • (v s - v t - (s - t) • V t))
          + |μ * s| ^ k * SchwartzMap.seminorm ℝ 0 n ((s - t)⁻¹ • (v s - v t - (s - t) • V t))) :=
    fun s => hτb _ _ k n
  
  have hC : ∀ s : ℝ, |μ * (s - t)| ≤ 1 → SchwartzMap.seminorm ℝ k n ((s - t)⁻¹ •
      (τ (v t) (μ * s) - τ (v t) (μ * t) - (μ * (s - t)) • τ D (μ * t))) ≤
        μ ^ 2 * |s - t| * K₁ := by
    intro s hs
    have hT := hTaylor (v t) D
      (τ (v t) (μ * s) - τ (v t) (μ * t) - (μ * (s - t)) • τ D (μ * t)) (μ * t) (μ * (s - t))
      hD hs (fun x => by
        simp only [SchwartzMap.sub_apply, SchwartzMap.smul_apply, smul_eq_mul, hτ]
        rw [show x + μ * t + μ * (s - t) = x + μ * s by ring]) k n
    rw [← hK₁] at hT
    rw [map_smul_eq_mul, Real.norm_eq_abs]
    calc _ ≤ |(s - t)⁻¹| * ((μ * (s - t)) ^ 2 * K₁) :=
          mul_le_mul_of_nonneg_left hT (abs_nonneg _)
      _ = μ ^ 2 * |s - t| * K₁ := hkey (s - t) K₁
  
  have hB : ∀ s : ℝ, |μ * (s - t)| ≤ 1 → SchwartzMap.seminorm ℝ k n
      ((τ (V t) (μ * s) - τ (V t) (μ * t) - (μ * (s - t)) • τ D₂ (μ * t))
        + (μ * (s - t)) • τ D₂ (μ * t)) ≤ (μ * (s - t)) ^ 2 * K₂ + |μ * (s - t)| * M := by
    intro s hs
    have hT := hTaylor (V t) D₂
      (τ (V t) (μ * s) - τ (V t) (μ * t) - (μ * (s - t)) • τ D₂ (μ * t)) (μ * t) (μ * (s - t))
      hD₂ hs (fun x => by
        simp only [SchwartzMap.sub_apply, SchwartzMap.smul_apply, smul_eq_mul, hτ]
        rw [show x + μ * t + μ * (s - t) = x + μ * s by ring]) k n
    rw [← hK₂] at hT
    refine (map_add_le_add _ _ _).trans (add_le_add hT ?_)
    rw [map_smul_eq_mul, Real.norm_eq_abs, hM]
  
  have hev : ∀ᶠ s in nhds t, |μ * (s - t)| ≤ 1 := by
    have h1 : Filter.Tendsto (fun s : ℝ => |μ * (s - t)|) (nhds t) (nhds 0) := by
      have := (by fun_prop : Continuous fun s : ℝ => |μ * (s - t)|).tendsto t
      simpa using this
    exact h1.eventually (eventually_le_nhds one_pos)
  have hlimA : Filter.Tendsto (fun s : ℝ => 2 ^ k *
      (SchwartzMap.seminorm ℝ k n ((s - t)⁻¹ • (v s - v t - (s - t) • V t))
        + |μ * s| ^ k * SchwartzMap.seminorm ℝ 0 n ((s - t)⁻¹ • (v s - v t - (s - t) • V t))))
      (nhds t) (nhds 0) := by
    have hc : Filter.Tendsto (fun s : ℝ => |μ * s| ^ k) (nhds t) (nhds (|μ * t| ^ k)) :=
      (by fun_prop : Continuous fun s : ℝ => |μ * s| ^ k).tendsto t
    have := (hEk.add (hc.mul hE0)).const_mul (2 ^ k)
    rw [mul_zero, add_zero, mul_zero] at this
    exact this
  have hlimBC : Filter.Tendsto (fun s : ℝ =>
      (μ * (s - t)) ^ 2 * K₂ + |μ * (s - t)| * M + μ ^ 2 * |s - t| * K₁) (nhds t) (nhds 0) := by
    have := (by fun_prop : Continuous fun s : ℝ =>
      (μ * (s - t)) ^ 2 * K₂ + |μ * (s - t)| * M + μ ^ 2 * |s - t| * K₁).tendsto t
    simpa using this
  have hlim := hlimA.add hlimBC
  rw [zero_add] at hlim
  have key3 : ∀ a b c : 𝓢(ℝ, ℝ), SchwartzMap.seminorm ℝ k n (a + b + c) ≤
      SchwartzMap.seminorm ℝ k n a + SchwartzMap.seminorm ℝ k n b
        + SchwartzMap.seminorm ℝ k n c := fun a b c =>
    (map_add_le_add _ _ _).trans (add_le_add (map_add_le_add _ _ _) le_rfl)
  refine squeeze_zero' (Filter.Eventually.of_forall fun s => apply_nonneg _ _) ?_ hlim
  filter_upwards [hev] with s hs
  rw [hid s]
  refine (key3 _ _ _).trans ?_
  have h1 := hA s
  have h2 := hB s hs
  have h3 := hC s hs
  linarith

theorem schwartz_Q_curve (a : ℝ) (w W : ℝ → 𝓢(ℝ, ℝ))
    (hw : ∀ t : ℝ, HasDerivAt w (W t) t) :
    ∃ c : ℝ → 𝓢(ℝ, ℝ), (∀ t x : ℝ, c t x = deriv (w t : ℝ → ℝ) x - a * w t x + w t x ^ 2) ∧
      ∀ t : ℝ, ∃ C : 𝓢(ℝ, ℝ), HasDerivAt c C t ∧
        ∀ x : ℝ, C x = deriv (W t : ℝ → ℝ) x - a * W t x + 2 * w t x * W t x :=
by
  classical
  
  have mulex : ∀ f g : 𝓢(ℝ, ℝ), ∃ h : 𝓢(ℝ, ℝ), ∀ x, h x = f x * g x := by
    intro f g
    refine ⟨SchwartzMap.bilinLeftCLM (ContinuousLinearMap.mul ℝ ℝ) g.hasTemperateGrowth f,
      fun x => ?_⟩
    rw [SchwartzMap.bilinLeftCLM_apply]
    simp
  
  have slope : ∀ (u : ℝ → 𝓢(ℝ, ℝ)) (v : 𝓢(ℝ, ℝ)) (t : ℝ), HasDerivAt u v t ↔
      Filter.Tendsto (fun s : ℝ => (s - t)⁻¹ • (u s - u t)) (nhdsWithin t {t}ᶜ) (nhds v) := by
    intro u v t
    rw [hasDerivAt_iff_hasFDerivAt]
    show HasFDerivAtFilter u _ t (nhds t) ↔ _
    rw [hasFDerivAtFilter_iff_isLittleOTVS]
    simp only [ContinuousLinearMap.toSpanSingleton_apply]
    rw [Asymptotics.isLittleOTVS_iff_tendsto_inv_smul (Filter.Eventually.of_forall fun s hs => by
      have hst : s = t := sub_eq_zero.1 hs
      subst hst
      simp)]
    constructor
    · intro h
      have h2 := h.mono_left (nhdsWithin_le_nhds (s := {t}ᶜ))
      rw [← tendsto_sub_nhds_zero_iff]
      refine h2.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with s hs
      have hs' : s - t ≠ 0 := sub_ne_zero.2 hs
      rw [smul_sub, smul_smul, inv_mul_cancel₀ hs', one_smul]
    · intro h
      rw [← nhdsNE_sup_pure t]
      refine Filter.Tendsto.sup ?_ ?_
      · have h2 := tendsto_sub_nhds_zero_iff.2 h
        refine h2.congr' ?_
        filter_upwards [self_mem_nhdsWithin] with s hs
        have hs' : s - t ≠ 0 := sub_ne_zero.2 hs
        rw [smul_sub ((s - t)⁻¹) (u s - u t) ((s - t) • v), smul_smul, inv_mul_cancel₀ hs',
          one_smul]
      · rw [Filter.tendsto_pure_left]
        intro S hS
        simpa using mem_of_mem_nhds hS
  
  have leib : ∀ (f g h : 𝓢(ℝ, ℝ)), (∀ x, h x = f x * g x) → ∀ k n : ℕ,
      SchwartzMap.seminorm ℝ k n h ≤ ∑ i ∈ Finset.range (n + 1),
        (n.choose i : ℝ) * SchwartzMap.seminorm ℝ k i f * SchwartzMap.seminorm ℝ 0 (n - i) g := by
    intro f g h hh k n
    refine SchwartzMap.seminorm_le_bound ℝ k n h
      (Finset.sum_nonneg fun i _ => mul_nonneg (mul_nonneg (Nat.cast_nonneg _)
        (apply_nonneg _ _)) (apply_nonneg _ _)) fun x => ?_
    have hfun : (h : ℝ → ℝ) = fun y => f y * g y := funext hh
    rw [hfun]
    have hle := norm_iteratedFDeriv_mul_le (f.smooth ⊤) (g.smooth ⊤) x (n := n)
      (by exact_mod_cast le_top)
    calc ‖x‖ ^ k * ‖iteratedFDeriv ℝ n (fun y => f y * g y) x‖
        ≤ ‖x‖ ^ k * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
            ‖iteratedFDeriv ℝ i f x‖ * ‖iteratedFDeriv ℝ (n - i) g x‖ :=
          mul_le_mul_of_nonneg_left hle (by positivity)
      _ = ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
            (‖x‖ ^ k * ‖iteratedFDeriv ℝ i f x‖) *
            (‖x‖ ^ 0 * ‖iteratedFDeriv ℝ (n - i) g x‖) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          ring
      _ ≤ _ := by
          refine Finset.sum_le_sum fun i _ => ?_
          refine mul_le_mul (mul_le_mul_of_nonneg_left (SchwartzMap.le_seminorm ℝ k i f x)
            (Nat.cast_nonneg _)) (SchwartzMap.le_seminorm ℝ 0 (n - i) g x) (by positivity)
            (mul_nonneg (Nat.cast_nonneg _) (apply_nonneg _ _))
  
  have multend : ∀ (l : Filter ℝ) (f g p : ℝ → 𝓢(ℝ, ℝ)) (f₀ g₀ p₀ : 𝓢(ℝ, ℝ)),
      Filter.Tendsto f l (nhds f₀) → Filter.Tendsto g l (nhds g₀) →
      (∀ i x, p i x = f i x * g i x) → (∀ x, p₀ x = f₀ x * g₀ x) →
      Filter.Tendsto p l (nhds p₀) := by
    intro l f g p f₀ g₀ p₀ hf hg hp hp₀
    have semt : ∀ (F : ℝ → 𝓢(ℝ, ℝ)) (F₀ : 𝓢(ℝ, ℝ)), Filter.Tendsto F l (nhds F₀) →
        ∀ k n : ℕ, Filter.Tendsto (fun s => SchwartzMap.seminorm ℝ k n (F s - F₀)) l (nhds 0) := by
      intro F F₀ hF k n
      have h1 := ((schwartz_withSeminorms ℝ ℝ ℝ).continuous_seminorm (k, n)).tendsto 0
      rw [map_zero] at h1
      have h2 := h1.comp (tendsto_sub_nhds_zero_iff.2 hF)
      simpa only [Function.comp_def, SchwartzMap.schwartzSeminormFamily_apply] using h2
    rw [(schwartz_withSeminorms ℝ ℝ ℝ).tendsto_nhds p p₀]
    rintro ⟨k, n⟩ ε hε
    simp only [SchwartzMap.schwartzSeminormFamily_apply]
    choose h₁ hh₁ using fun s => mulex (f s - f₀) (g s)
    choose h₂ hh₂ using fun s => mulex f₀ (g s - g₀)
    have hdec : ∀ s, p s - p₀ = h₁ s + h₂ s := by
      intro s
      ext x
      simp only [SchwartzMap.sub_apply, SchwartzMap.add_apply, hp, hp₀, hh₁, hh₂]
      ring
    have hb : ∀ s, SchwartzMap.seminorm ℝ k n (p s - p₀) ≤
        (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * SchwartzMap.seminorm ℝ k i (f s - f₀) *
          (SchwartzMap.seminorm ℝ 0 (n - i) (g s - g₀) + SchwartzMap.seminorm ℝ 0 (n - i) g₀)) +
        ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * SchwartzMap.seminorm ℝ k i f₀ *
          SchwartzMap.seminorm ℝ 0 (n - i) (g s - g₀) := by
      intro s
      rw [hdec s]
      refine (map_add_le_add _ _ _).trans (add_le_add ?_ (leib _ _ _ (hh₂ s) k n))
      refine (leib _ _ _ (hh₁ s) k n).trans (Finset.sum_le_sum fun i _ => ?_)
      refine mul_le_mul_of_nonneg_left ?_ (mul_nonneg (Nat.cast_nonneg _) (apply_nonneg _ _))
      calc SchwartzMap.seminorm ℝ 0 (n - i) (g s)
          = SchwartzMap.seminorm ℝ 0 (n - i) ((g s - g₀) + g₀) := by rw [sub_add_cancel]
        _ ≤ _ := map_add_le_add _ _ _
    have hV : Filter.Tendsto (fun s =>
        (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * SchwartzMap.seminorm ℝ k i (f s - f₀) *
          (SchwartzMap.seminorm ℝ 0 (n - i) (g s - g₀) + SchwartzMap.seminorm ℝ 0 (n - i) g₀)) +
        ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * SchwartzMap.seminorm ℝ k i f₀ *
          SchwartzMap.seminorm ℝ 0 (n - i) (g s - g₀)) l (nhds 0) := by
      have h1 : ∀ i ∈ Finset.range (n + 1), Filter.Tendsto (fun s =>
          (n.choose i : ℝ) * SchwartzMap.seminorm ℝ k i (f s - f₀) *
            (SchwartzMap.seminorm ℝ 0 (n - i) (g s - g₀) + SchwartzMap.seminorm ℝ 0 (n - i) g₀)) l
          (nhds ((n.choose i : ℝ) * 0 * (0 + SchwartzMap.seminorm ℝ 0 (n - i) g₀))) :=
        fun i _ => (tendsto_const_nhds.mul (semt f f₀ hf k i)).mul
          ((semt g g₀ hg 0 (n - i)).add tendsto_const_nhds)
      have h2 : ∀ i ∈ Finset.range (n + 1), Filter.Tendsto (fun s =>
          (n.choose i : ℝ) * SchwartzMap.seminorm ℝ k i f₀ *
            SchwartzMap.seminorm ℝ 0 (n - i) (g s - g₀)) l
          (nhds ((n.choose i : ℝ) * SchwartzMap.seminorm ℝ k i f₀ * 0)) :=
        fun i _ => tendsto_const_nhds.mul (semt g g₀ hg 0 (n - i))
      have h3 := (tendsto_finset_sum _ h1).add (tendsto_finset_sum _ h2)
      simpa using h3
    have hT := tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hV
      (fun s => apply_nonneg _ _) hb
    exact Filter.Tendsto.eventually_lt_const hε hT
  
  choose sq hsq using fun t => mulex (w t) (w t)
  refine ⟨fun t => SchwartzMap.derivCLM ℝ ℝ (w t) - a • w t + sq t, fun t x => ?_, fun t => ?_⟩
  · simp only [SchwartzMap.add_apply, SchwartzMap.sub_apply, SchwartzMap.smul_apply, smul_eq_mul,
      SchwartzMap.derivCLM_apply, hsq]
    ring
  
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ → 𝓢(ℝ, ℝ), D = fun s => (s - t)⁻¹ • (w s - w t) := ⟨_, rfl⟩
  have hD : Filter.Tendsto D (nhdsWithin t {t}ᶜ) (nhds (W t)) := by
    rw [hDdef]; exact (slope w (W t) t).1 (hw t)
  have hsub : Filter.Tendsto (fun s : ℝ => s - t) (nhdsWithin t {t}ᶜ) (nhds 0) := by
    have h1 : Filter.Tendsto (fun s : ℝ => s - t) (nhds t) (nhds (t - t)) :=
      (continuous_id.sub continuous_const).tendsto t
    rw [sub_self] at h1
    exact h1.mono_left nhdsWithin_le_nhds
  have hcont : Filter.Tendsto w (nhdsWithin t {t}ᶜ) (nhds (w t)) := by
    have h1 : Filter.Tendsto (fun s => w t + (s - t) • D s) (nhdsWithin t {t}ᶜ)
        (nhds (w t + (0 : ℝ) • W t)) := tendsto_const_nhds.add (hsub.smul hD)
    rw [zero_smul, add_zero] at h1
    refine h1.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with s hs
    have hs' : s - t ≠ 0 := sub_ne_zero.2 hs
    rw [hDdef]
    simp only [smul_smul, mul_inv_cancel₀ hs', one_smul, add_sub_cancel]
  
  have hS : Filter.Tendsto (fun s => w s + w t) (nhdsWithin t {t}ᶜ) (nhds (w t + w t)) :=
    hcont.add tendsto_const_nhds
  choose Pq hPq using fun s => mulex (D s) (w s + w t)
  obtain ⟨P0, hP0⟩ := mulex (W t) (w t + w t)
  have hP := multend _ D (fun s => w s + w t) Pq (W t) (w t + w t) P0 hD hS hPq hP0
  have hL : Filter.Tendsto (fun s => SchwartzMap.derivCLM ℝ ℝ (D s)) (nhdsWithin t {t}ᶜ)
      (nhds (SchwartzMap.derivCLM ℝ ℝ (W t))) :=
    ((SchwartzMap.derivCLM ℝ ℝ).continuous.tendsto (W t)).comp hD
  have hsum := (hL.sub (hD.const_smul a)).add hP
  refine ⟨SchwartzMap.derivCLM ℝ ℝ (W t) - a • W t + P0, (slope _ _ t).2 ?_, fun x => ?_⟩
  · 
    refine hsum.congr (fun s => ?_)
    ext x
    simp only [SchwartzMap.add_apply, SchwartzMap.sub_apply, SchwartzMap.smul_apply, smul_eq_mul,
      hPq]
    rw [hDdef]
    simp only [map_smul, map_sub, SchwartzMap.add_apply, SchwartzMap.sub_apply,
      SchwartzMap.smul_apply, smul_eq_mul, SchwartzMap.derivCLM_apply, hsq]
    ring
  · simp only [SchwartzMap.add_apply, SchwartzMap.sub_apply, SchwartzMap.smul_apply, smul_eq_mul,
      SchwartzMap.derivCLM_apply, hP0]
    ring

theorem hk_flow_exists : ∃ δ > (0 : ℝ), ∀ κ ≥ (1 : ℝ), ∀ q : 𝓢(ℝ, ℝ), ‖ι q‖ ≤ δ →
    IsHkSolution κ (fun t => hkFlow κ t q) :=
by
  classical
  refine ⟨1 / 8, by norm_num, ?_⟩
  intro κ hκ q hq
  have hκ0 : 0 < κ := by linarith
  
  have hq' : ‖toHm1 q‖ ≤ 1 / 8 := hq
  have hq2 : ‖toHm1 q‖ ^ 2 ≤ 1 / 64 := by
    calc ‖toHm1 q‖ ^ 2 ≤ (1 / 8) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hq' 2
      _ = 1 / 64 := by norm_num
  obtain ⟨-, hWle, -⟩ := (Hm1_weight_basic (toHm1 q)).2 κ hκ
  obtain ⟨hmem, hKeq⟩ := riccatiK_sq_integral κ hκ0 q
  have hsmall : ∫ x : ℝ, riccatiK κ q x ^ 2 ≤ 1 / 64 := by rw [hKeq]; linarith
  obtain ⟨w, hw⟩ := (riccati_fixed_point κ hκ q hmem hsmall).1
  
  obtain ⟨hwc, hwb, hwt, hwbot, hwd⟩ := riccati_sol_regularity κ hκ0 q w hw
  have hdec := riccati_sol_rapid_decay κ hκ0 q w hwc hwb hwt hwbot hwd
  obtain ⟨W₀, hW₀⟩ := schwartz_of_riccati_decay κ q w hwd hdec
  have hW₀f : (W₀ : ℝ → ℝ) = w := funext hW₀
  have hqW : ∀ x : ℝ, q x = deriv (W₀ : ℝ → ℝ) x - 2 * κ * W₀ x + W₀ x ^ 2 := by
    intro x
    rw [hW₀f, (hwd x).deriv]
    ring
  
  obtain ⟨v, h0, hc, hb, hl, hi⟩ := wflow_integral_exists κ hκ W₀
  obtain ⟨V, hV, hVd⟩ := wflow_schwartz_regular κ hκ W₀ v h0 hc hb hl hi
  choose Vd hVd1 hVd2 using hVd
  obtain ⟨u, huV, hud⟩ := schwartz_translate_curve (4 * κ ^ 2) V Vd hVd1
  choose Ud hUd1 hUd2 using hud
  
  have hcovG : ∀ (f : ℝ → ℝ) (a x : ℝ),
      rgreen κ (fun y => f (y + a)) x = rgreen κ f (x + a) := by
    intro f a x
    unfold rgreen
    congr 1
    funext s
    rw [intervalIntegral.integral_comp_add_right (fun y => f y) a,
      show x - s + a = x + a - s by ring]
  have hcovR : ∀ (f : ℝ → ℝ) (a x : ℝ),
      rgreenR κ (fun y => f (y + a)) x = rgreenR κ f (x + a) := by
    intro f a x
    unfold rgreenR
    congr 1
    funext s
    rw [intervalIntegral.integral_comp_add_right (fun y => f y) a,
      show x + s + a = x + a + s by ring]
  have hcovW : ∀ (f : ℝ → ℝ) (a x : ℝ),
      wfield κ (fun y => f (y + a)) x = wfield κ f (x + a) := by
    intro f a x
    unfold wfield
    rw [hcovG, hcovR]
  have hUd : ∀ t x : ℝ, Ud t x = 4 * κ ^ 2 * deriv (u t : ℝ → ℝ) x + wfield κ (u t) x := by
    intro t x
    have hut : (u t : ℝ → ℝ) = fun y => V t (y + 4 * κ ^ 2 * t) := funext (huV t)
    rw [hUd2 t x, hVd2 t, hut, deriv_comp_add_const, hcovW]
  obtain ⟨c, hcw, hcd⟩ := schwartz_Q_curve (2 * κ) u Ud hUd1
  choose Cd hCd1 hCd2 using hcd
  have hu0 : (u 0 : ℝ → ℝ) = W₀ := by
    funext y
    rw [huV 0 y, mul_zero, add_zero, hV 0 y, h0 y]
  have hc0 : c 0 = q := by
    ext x
    rw [hcw 0 x, hu0, hqW x]
  
  have hcIs : IsHkSolution κ c := by
    intro t
    obtain ⟨hG, hGR, ⟨γ, hγ⟩, -, ⟨m, hm, hmG⟩⟩ := rgreen_schwartz_package κ hκ0 (u t)
    have hγf : (γ : ℝ → ℝ) = fun y => rgreen κ (u t) y - 1 / (2 * κ) := funext hγ
    have hγd : ∀ x : ℝ,
        HasDerivAt (γ : ℝ → ℝ) (2 * (u t x - κ) * (1 / (2 * κ) + γ x) + 1) x := by
      intro x
      have e : 1 / (2 * κ) + γ x = rgreen κ (u t) x := by rw [hγ x]; ring
      rw [e, hγf]
      exact (hG x).sub_const (1 / (2 * κ))
    have hct : ∀ x : ℝ, c t x = deriv (u t : ℝ → ℝ) x - 2 * κ * u t x + u t x ^ 2 := hcw t
    have hγG := greenODE_of_riccati_first_order κ hκ0 (u t) γ (c t) hγd hct
    have hex : ∃ γ' : 𝓢(ℝ, ℝ), GreenODE κ (c t) γ' := ⟨γ, hγG⟩
    have hgo : GreenODE κ (c t) (greenOffset κ (c t)) := by
      unfold greenOffset
      rw [dif_pos hex]
      exact Classical.choose_spec hex
    have hid : greenOffset κ (c t) = γ :=
      green_unique_of_pos κ hκ0 (c t) γ (greenOffset κ (c t)) hγG hgo
        ⟨m, hm, fun x => by rw [hγ x]; linarith [hmG x]⟩
    refine ⟨Cd t, hCd1 t, fun x => ?_⟩
    
    have hdu : deriv (u t : ℝ → ℝ) = (SchwartzMap.derivCLM ℝ ℝ (u t) : ℝ → ℝ) :=
      funext fun y => by rw [SchwartzMap.derivCLM_apply]
    have hd1 : HasDerivAt (deriv (u t : ℝ → ℝ)) (deriv (deriv (u t : ℝ → ℝ)) x) x := by
      have hdiff : DifferentiableAt ℝ (deriv (u t : ℝ → ℝ)) x := by
        rw [hdu]
        exact (SchwartzMap.derivCLM ℝ ℝ (u t)).differentiableAt
      exact hdiff.hasDerivAt
    have hu1 : HasDerivAt (u t : ℝ → ℝ) (deriv (u t : ℝ → ℝ) x) x :=
      (u t).differentiableAt.hasDerivAt
    
    have hcf : (c t : ℝ → ℝ) =
        fun y => deriv (u t : ℝ → ℝ) y - 2 * κ * u t y + u t y ^ 2 := funext (hcw t)
    have hc1 : HasDerivAt (c t : ℝ → ℝ)
        (deriv (deriv (u t : ℝ → ℝ)) x - 2 * κ * deriv (u t : ℝ → ℝ) x
          + 2 * u t x * deriv (u t : ℝ → ℝ) x) x := by
      rw [hcf]
      have h := (hd1.sub (hu1.const_mul (2 * κ))).add (hu1.pow 2)
      refine h.congr_deriv ?_
      norm_num
    
    have hUf : (Ud t : ℝ → ℝ) = fun y => 4 * κ ^ 2 * deriv (u t : ℝ → ℝ) y
        + 8 * κ ^ 5 * (rgreen κ (u t) y - rgreenR κ (u t) y) := by
      funext y
      rw [hUd t y]
      rfl
    have hUdd : HasDerivAt (Ud t : ℝ → ℝ)
        (4 * κ ^ 2 * deriv (deriv (u t : ℝ → ℝ)) x
          + 8 * κ ^ 5 * ((2 * (u t x - κ) * rgreen κ (u t) x + 1)
            - (2 * (κ - u t x) * rgreenR κ (u t) x - 1))) x := by
      rw [hUf]
      exact (hd1.const_mul _).add (((hG x).sub (hGR x)).const_mul _)
    rw [hCd2 t x]
    unfold hkRHS
    rw [hid, (hγd x).deriv, hc1.deriv, hUdd.deriv, hUd t x, hγ x]
    unfold wfield
    ring
  
  have hexc : ∃ c : ℝ → 𝓢(ℝ, ℝ), IsHkSolution κ c ∧ c 0 = q := ⟨c, hcIs, hc0⟩
  have hfl : (fun t => hkFlow κ t q) = Classical.choose hexc := by
    funext t
    unfold hkFlow
    rw [dif_pos hexc]
  rw [hfl]
  exact (Classical.choose_spec hexc).1

theorem schwartz_sq_pairing_bound (κ : ℝ) (hκ : 1 ≤ κ) (q h : 𝓢(ℝ, ℝ)) :
    |∫ x : ℝ, q x * h x ^ 2| ≤ ‖toHm1 q‖ *
      (2 * Real.sqrt (∫ x : ℝ, (h x * deriv (h : ℝ → ℝ) x) ^ 2)
        + 2 * κ * Real.sqrt (∫ x : ℝ, h x ^ 4)) :=
by
  have hκ0 : (0 : ℝ) < κ := by linarith
  
  have CS : ∀ (u v : ℝ → ℝ), MemLp u 2 (volume : Measure ℝ) → MemLp v 2 (volume : Measure ℝ) →
      (∫ a, u a * v a) ^ 2 ≤ (∫ a, u a ^ 2) * (∫ a, v a ^ 2) := by
    intro u v hu hv
    have hA := hu.integrable_sq
    have hB := hv.integrable_sq
    have hC : Integrable (fun a => u a * v a) volume := hu.integrable_mul hv
    have key : ∀ t : ℝ, 0 ≤ (∫ a, u a ^ 2) * (t * t) + (2 * ∫ a, u a * v a) * t +
        ∫ a, v a ^ 2 := by
      intro t
      have h0 : 0 ≤ ∫ a, (t * u a + v a) ^ 2 := integral_nonneg (fun a => sq_nonneg _)
      have heq : (fun a => (t * u a + v a) ^ 2) =
          fun a => (t * t) * u a ^ 2 + ((2 * t) * (u a * v a) + v a ^ 2) := by
        funext a; ring
      have i1 : Integrable (fun a => (t * t) * u a ^ 2) volume := hA.const_mul _
      have i2 : Integrable (fun a => (2 * t) * (u a * v a)) volume := hC.const_mul _
      have i23 : Integrable (fun a => (2 * t) * (u a * v a) + v a ^ 2) volume := i2.add hB
      rw [heq, integral_add i1 i23, integral_add i2 hB, integral_const_mul,
        integral_const_mul] at h0
      nlinarith
    have hd := discrim_le_zero key
    unfold discrim at hd
    nlinarith
  have CSabs : ∀ (u v : ℝ → ℝ), MemLp u 2 (volume : Measure ℝ) → MemLp v 2 (volume : Measure ℝ) →
      |∫ a, u a * v a| ≤ Real.sqrt (∫ a, u a ^ 2) * Real.sqrt (∫ a, v a ^ 2) := by
    intro u v hu hv
    have h1 := CS u v hu hv
    have hu0 : 0 ≤ ∫ a, u a ^ 2 := integral_nonneg fun a => sq_nonneg _
    have hv0 : 0 ≤ ∫ a, v a ^ 2 := integral_nonneg fun a => sq_nonneg _
    have hb : (Real.sqrt (∫ a, u a ^ 2) * Real.sqrt (∫ a, v a ^ 2)) ^ 2 =
        (∫ a, u a ^ 2) * (∫ a, v a ^ 2) := by
      rw [mul_pow, Real.sq_sqrt hu0, Real.sq_sqrt hv0]
    rw [← hb] at h1
    exact abs_le.2 (abs_le_of_sq_le_sq' h1 (by positivity))
  
  obtain ⟨hk2, hkeq⟩ := riccatiK_sq_integral κ hκ0 q
  have hW := ((Hm1_weight_basic (toHm1 q)).2 κ hκ).2.1
  have hk_le : ∫ x : ℝ, riccatiK κ q x ^ 2 ≤ ‖toHm1 q‖ ^ 2 := by rw [hkeq]; exact hW
  have hS : Real.sqrt (∫ x : ℝ, riccatiK κ q x ^ 2) ≤ ‖toHm1 q‖ :=
    (Real.sqrt_le_sqrt hk_le).trans_eq (Real.sqrt_sq (norm_nonneg _))
  have hkb : ∀ x : ℝ, |riccatiK κ q x| ≤ ∫ y : ℝ, |q y| := by
    intro x
    unfold riccatiK
    rw [abs_neg, ← Real.norm_eq_abs]
    have hb1 : ‖∫ y in Set.Ici x, Real.exp (2 * κ * (x - y)) * q y‖ ≤
        ∫ y in Set.Ici x, |q y| := by
      refine norm_integral_le_of_norm_le (q.integrable (μ := volume)).abs.integrableOn ?_
      refine ae_restrict_of_forall_mem measurableSet_Ici fun y hy => ?_
      have hy' : x ≤ y := hy
      have hle : Real.exp (2 * κ * (x - y)) ≤ 1 := Real.exp_le_one_iff.2 (by nlinarith)
      rw [Real.norm_eq_abs, abs_mul, abs_of_pos (Real.exp_pos _)]
      exact mul_le_of_le_one_left (abs_nonneg _) hle
    exact hb1.trans (setIntegral_le_integral (q.integrable (μ := volume)).abs
      (ae_of_all _ fun y => abs_nonneg _))
  have hd : ∀ x₀ : ℝ, HasDerivAt (riccatiK κ q) (2 * κ * riccatiK κ q x₀ + q x₀) x₀ := by
    intro x₀
    obtain ⟨g0, hg0⟩ : ∃ g0 : ℝ → ℝ, g0 = fun y => Real.exp (-2 * κ * y) * q y := ⟨_, rfl⟩
    have hcont : Continuous g0 := by
      rw [hg0]
      exact (Real.continuous_exp.comp (continuous_const.mul continuous_id)).mul q.continuous
    have hint : ∀ a : ℝ, IntegrableOn g0 (Set.Ioi a) := by
      intro a
      refine Integrable.mono'
        ((q.integrable (μ := volume)).norm.const_mul (Real.exp (-2 * κ * a))).integrableOn
        hcont.aestronglyMeasurable ?_
      refine ae_restrict_of_forall_mem measurableSet_Ioi fun y hy => ?_
      rw [hg0]
      simp only
      rw [norm_mul, Real.norm_of_nonneg (Real.exp_pos _).le]
      apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
      apply Real.exp_le_exp.2
      have : a < y := hy
      nlinarith
    obtain ⟨A, hA⟩ : ∃ A : ℝ, A = ∫ y in Set.Ioi (x₀ - 1), g0 y := ⟨_, rfl⟩
    have hrep : ∀ x ∈ Set.Ioi (x₀ - 1),
        riccatiK κ q x = -(Real.exp (2 * κ * x) * (A - ∫ y in (x₀ - 1)..x, g0 y)) := by
      intro x hx
      have hx' : x₀ - 1 < x := hx
      have hsplit : A = (∫ y in (x₀ - 1)..x, g0 y) + ∫ y in Set.Ioi x, g0 y := by
        rw [intervalIntegral.integral_of_le hx'.le, ← setIntegral_union Set.Ioc_disjoint_Ioi_same
          measurableSet_Ioi ((hint (x₀ - 1)).mono_set Set.Ioc_subset_Ioi_self) (hint x),
          Set.Ioc_union_Ioi_eq_Ioi hx'.le, hA]
      have hK : riccatiK κ q x = -(Real.exp (2 * κ * x) * ∫ y in Set.Ioi x, g0 y) := by
        unfold riccatiK
        rw [integral_Ici_eq_integral_Ioi, ← integral_const_mul]
        congr 1
        refine setIntegral_congr_fun measurableSet_Ioi fun y _ => ?_
        rw [hg0]
        simp only
        rw [← mul_assoc, ← Real.exp_add]
        congr 2
        ring
      rw [hK, hsplit]
      ring
    have hJ : HasDerivAt (fun x => ∫ y in (x₀ - 1)..x, g0 y) (g0 x₀) x₀ :=
      intervalIntegral.integral_hasDerivAt_right (hcont.intervalIntegrable _ _)
        (hcont.stronglyMeasurableAtFilter _ _) hcont.continuousAt
    have hE : HasDerivAt (fun x => Real.exp (2 * κ * x)) (Real.exp (2 * κ * x₀) * (2 * κ)) x₀ := by
      have := ((hasDerivAt_id x₀).const_mul (2 * κ)).exp
      simpa using this
    have hP : HasDerivAt (fun x => -(Real.exp (2 * κ * x) * (A - ∫ y in (x₀ - 1)..x, g0 y)))
        (-(Real.exp (2 * κ * x₀) * (2 * κ) * (A - ∫ y in (x₀ - 1)..x₀, g0 y) +
          Real.exp (2 * κ * x₀) * (0 - g0 x₀))) x₀ :=
      (hE.mul ((hasDerivAt_const x₀ A).sub hJ)).neg
    have hev : riccatiK κ q =ᶠ[nhds x₀]
        fun x => -(Real.exp (2 * κ * x) * (A - ∫ y in (x₀ - 1)..x, g0 y)) :=
      Filter.eventually_of_mem (Ioi_mem_nhds (by linarith : x₀ - 1 < x₀)) hrep
    have hval : -(Real.exp (2 * κ * x₀) * (2 * κ) * (A - ∫ y in (x₀ - 1)..x₀, g0 y) +
          Real.exp (2 * κ * x₀) * (0 - g0 x₀)) = 2 * κ * riccatiK κ q x₀ + q x₀ := by
      rw [hrep x₀ (show x₀ - 1 < x₀ by linarith), hg0]
      simp only
      have hEE : Real.exp (2 * κ * x₀) * Real.exp (-2 * κ * x₀) = 1 := by
        rw [← Real.exp_add]
        ring_nf
        exact Real.exp_zero
      linear_combination (q x₀) * hEE
    have hfin := hP.congr_of_eventuallyEq hev
    rw [hval] at hfin
    exact hfin
  have hkc : Continuous (riccatiK κ q) :=
    continuous_iff_continuousAt.2 fun x => (hd x).continuousAt
  
  obtain ⟨h', hh'⟩ : ∃ h' : 𝓢(ℝ, ℝ), ∀ y : ℝ, h' y = deriv (h : ℝ → ℝ) y :=
    ⟨SchwartzMap.derivCLM ℝ ℝ h, fun y => SchwartzMap.derivCLM_apply ℝ h y⟩
  have hfun' : deriv (h : ℝ → ℝ) = (h' : ℝ → ℝ) := funext fun y => (hh' y).symm
  simp only [hfun']
  have hφ : ∀ x : ℝ, HasDerivAt (fun y => h y ^ 2) (2 * h x * h' x) x := by
    intro x
    have := ((h.differentiableAt (x := x)).hasDerivAt).pow 2
    rw [hh']
    convert this using 1
    push_cast
    ring
  
  have hmul2 : ∀ f g : 𝓢(ℝ, ℝ), MemLp (fun x => f x * g x) 2 (volume : Measure ℝ) := by
    intro f g
    refine MemLp.of_le ((g.memLp 2 (volume : Measure ℝ)).const_mul (SchwartzMap.seminorm ℝ 0 0 f))
      (f.continuous.mul g.continuous).aestronglyMeasurable (ae_of_all _ fun x => ?_)
    have hC : 0 ≤ SchwartzMap.seminorm ℝ 0 0 f :=
      (norm_nonneg (f x)).trans (SchwartzMap.norm_le_seminorm ℝ f x)
    rw [norm_mul, norm_mul, Real.norm_of_nonneg hC]
    exact mul_le_mul_of_nonneg_right (SchwartzMap.norm_le_seminorm ℝ f x) (norm_nonneg _)
  have hA2 : MemLp (fun x => h x * h' x) 2 (volume : Measure ℝ) := hmul2 h h'
  have hB2 : MemLp (fun x => h x ^ 2) 2 (volume : Measure ℝ) := by
    simpa only [sq] using hmul2 h h
  
  have iφ : Integrable (fun x => h x ^ 2) volume := (h.memLp 2 (volume : Measure ℝ)).integrable_sq
  have iφ' : Integrable (fun x => 2 * h x * h' x) volume := by
    have h1 := (h.memLp 2 (volume : Measure ℝ)).integrable_mul (h'.memLp 2 (volume : Measure ℝ))
    refine (h1.const_mul 2).congr (ae_of_all _ fun y => ?_)
    simp only [Pi.mul_apply]
    ring
  have i1 : Integrable (fun x => riccatiK κ q x * (2 * h x * h' x)) volume :=
    iφ'.bdd_mul (c := ∫ y : ℝ, |q y|) hkc.aestronglyMeasurable
      (ae_of_all _ fun x => by rw [Real.norm_eq_abs]; exact hkb x)
  have i2 : Integrable (fun x => (2 * κ * riccatiK κ q x + q x) * h x ^ 2) volume := by
    refine iφ.bdd_mul (c := 2 * κ * (∫ y : ℝ, |q y|) + SchwartzMap.seminorm ℝ 0 0 q)
      ((continuous_const.mul hkc).add q.continuous).aestronglyMeasurable
      (ae_of_all _ fun x => ?_)
    have e1 := hkb x
    have e2 := SchwartzMap.norm_le_seminorm ℝ q x
    rw [Real.norm_eq_abs] at e2 ⊢
    have e3 : |2 * κ * riccatiK κ q x| = 2 * κ * |riccatiK κ q x| := by
      rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 * κ)]
    calc |2 * κ * riccatiK κ q x + q x| ≤ |2 * κ * riccatiK κ q x| + |q x| := abs_add_le _ _
      _ = 2 * κ * |riccatiK κ q x| + |q x| := by rw [e3]
      _ ≤ 2 * κ * (∫ y : ℝ, |q y|) + SchwartzMap.seminorm ℝ 0 0 q :=
          add_le_add (mul_le_mul_of_nonneg_left e1 (by positivity)) e2
  have i3 : Integrable (fun x => riccatiK κ q x * h x ^ 2) volume :=
    iφ.bdd_mul (c := ∫ y : ℝ, |q y|) hkc.aestronglyMeasurable
      (ae_of_all _ fun x => by rw [Real.norm_eq_abs]; exact hkb x)
  have i4 : Integrable (fun x => q x * h x ^ 2) volume :=
    iφ.bdd_mul (c := SchwartzMap.seminorm ℝ 0 0 q) q.continuous.aestronglyMeasurable
      (ae_of_all _ fun x => SchwartzMap.norm_le_seminorm ℝ q x)
  
  have hibp : ∫ x, riccatiK κ q x * (2 * h x * h' x) =
      -∫ x, (2 * κ * riccatiK κ q x + q x) * h x ^ 2 :=
    integral_mul_deriv_eq_deriv_mul_of_integrable (u := riccatiK κ q) (v := fun y => h y ^ 2)
      (u' := fun x => 2 * κ * riccatiK κ q x + q x) (v' := fun x => 2 * h x * h' x)
      hd hφ i1 i2 i3
  have eL : ∫ x, riccatiK κ q x * (2 * h x * h' x) =
      2 * ∫ x, riccatiK κ q x * (h x * h' x) := by
    rw [← integral_const_mul]
    congr 1
    funext x
    ring
  have eR : ∫ x, (2 * κ * riccatiK κ q x + q x) * h x ^ 2 =
      2 * κ * (∫ x, riccatiK κ q x * h x ^ 2) + ∫ x, q x * h x ^ 2 := by
    rw [← integral_const_mul, ← integral_add (i3.const_mul _) i4]
    congr 1
    funext x
    ring
  have hid : ∫ x, q x * h x ^ 2 = -(2 * ∫ x, riccatiK κ q x * (h x * h' x))
      - 2 * κ * ∫ x, riccatiK κ q x * h x ^ 2 := by
    linarith
  
  have hI1 : |∫ x, riccatiK κ q x * (h x * h' x)| ≤
      Real.sqrt (∫ x : ℝ, riccatiK κ q x ^ 2) * Real.sqrt (∫ x : ℝ, (h x * h' x) ^ 2) :=
    CSabs _ _ hk2 hA2
  have hI2 : |∫ x, riccatiK κ q x * h x ^ 2| ≤
      Real.sqrt (∫ x : ℝ, riccatiK κ q x ^ 2) * Real.sqrt (∫ x : ℝ, (h x ^ 2) ^ 2) :=
    CSabs _ _ hk2 hB2
  have e4 : (∫ x : ℝ, (h x ^ 2) ^ 2) = ∫ x : ℝ, h x ^ 4 := by
    congr 1
    funext x
    ring
  rw [e4] at hI2
  rw [hid]
  have hS0 : 0 ≤ Real.sqrt (∫ x : ℝ, riccatiK κ q x ^ 2) := Real.sqrt_nonneg _
  have hA0 : 0 ≤ Real.sqrt (∫ x : ℝ, (h x * h' x) ^ 2) := Real.sqrt_nonneg _
  have hB0 : 0 ≤ Real.sqrt (∫ x : ℝ, h x ^ 4) := Real.sqrt_nonneg _
  obtain ⟨a1, a2⟩ := abs_le.1 hI1
  obtain ⟨b1, b2⟩ := abs_le.1 hI2
  have c1 := mul_le_mul_of_nonneg_left b1 hκ0.le
  have c2 := mul_le_mul_of_nonneg_left b2 hκ0.le
  have key : |-(2 * ∫ x, riccatiK κ q x * (h x * h' x))
      - 2 * κ * ∫ x, riccatiK κ q x * h x ^ 2| ≤
      Real.sqrt (∫ x : ℝ, riccatiK κ q x ^ 2) *
        (2 * Real.sqrt (∫ x : ℝ, (h x * h' x) ^ 2) + 2 * κ * Real.sqrt (∫ x : ℝ, h x ^ 4)) := by
    refine abs_le.2 ⟨?_, ?_⟩
    · nlinarith
    · nlinarith
  refine key.trans (mul_le_mul_of_nonneg_right hS ?_)
  positivity

theorem toHm1_norm_comp_neg (q p : 𝓢(ℝ, ℝ)) (hp : ∀ x : ℝ, p x = q (-x)) :
    ‖toHm1 p‖ = ‖toHm1 q‖ :=
by
  have hfl : ∀ ξ : ℝ, fourierLine p ξ = fourierLine q (-ξ) := by
    intro ξ
    unfold fourierLine
    congr 1
    have := integral_neg_eq_self
      (fun x : ℝ => Complex.exp (-(((-ξ : ℝ) : ℂ) * (x : ℂ)) * I) * ((q x : ℝ) : ℂ)) volume
    rw [← this]
    congr 1
    funext x
    rw [hp x]
    push_cast
    ring_nf
  have hprof : hm1Profile p = (hm1Profile q) ∘ Neg.neg := by
    funext ξ
    simp only [hm1Profile, Function.comp, neg_sq]
    rw [hfl ξ]
  have hprof' : hm1Profile q = (hm1Profile p) ∘ Neg.neg := by
    funext ξ
    simp only [Function.comp, hprof, neg_neg]
  have hmp := Measure.measurePreserving_neg (volume : Measure ℝ)
  by_cases hq : MemLp (hm1Profile q) 2 volume
  · have hpm : MemLp (hm1Profile p) 2 volume := by
      rw [hprof]; exact hq.comp_measurePreserving hmp
    unfold toHm1
    rw [dif_pos hpm, dif_pos hq, Lp.norm_toLp, Lp.norm_toLp]
    congr 1
    rw [hprof, eLpNorm_comp_measurePreserving hq.1 hmp]
  · have hpm : ¬ MemLp (hm1Profile p) 2 volume := by
      intro h
      apply hq
      rw [hprof']; exact h.comp_measurePreserving hmp
    unfold toHm1
    rw [dif_neg hpm, dif_neg hq]

theorem green_denominator_lower_bound (κ : ℝ) (hκ : 0 < κ) (q Wp Wm : 𝓢(ℝ, ℝ))
    (hp : ∀ x : ℝ, HasDerivAt (Wp : ℝ → ℝ) (q x + 2 * κ * Wp x - Wp x ^ 2) x)
    (hm : ∀ x : ℝ, HasDerivAt (Wm : ℝ → ℝ) (q x - 2 * κ * Wm x - Wm x ^ 2) x) :
    ∃ c > (0 : ℝ), ∀ x : ℝ, c ≤ 2 * κ + Wm x - Wp x :=
by
  classical
  set s : ℝ → ℝ := fun x => Wm x + Wp x with hs_def
  set D : ℝ → ℝ := fun x => 2 * κ + Wm x - Wp x with hD_def
  set G : ℝ → ℝ := fun x => ∫ t in (0:ℝ)..x, s t with hG_def
  have hsc : Continuous s := Wm.continuous.add Wp.continuous
  have hsi : Integrable s volume :=
    (Wm.integrable (μ := volume)).add (Wp.integrable (μ := volume))
  
  have hDd : ∀ x : ℝ, HasDerivAt D (-(s x) * D x) x := by
    intro x
    have h := ((hm x).const_add (2 * κ)).sub (hp x)
    convert h using 1
    simp only [hs_def, hD_def]
    ring
  
  have hGd : ∀ x : ℝ, HasDerivAt G (s x) x := fun x =>
    (hsc.integral_hasStrictDerivAt 0 x).hasDerivAt
  have hG0 : G 0 = 0 := by simp [hG_def]
  
  have hP : ∀ x : ℝ, HasDerivAt (fun y => D y * Real.exp (G y)) 0 x := by
    intro x
    have h := (hDd x).mul (hGd x).exp
    convert h using 1
    ring
  have hPc : ∀ x : ℝ, D x * Real.exp (G x) = D 0 := by
    intro x
    have hdiff : Differentiable ℝ (fun y => D y * Real.exp (G y)) :=
      fun y => (hP y).differentiableAt
    have := is_const_of_deriv_eq_zero hdiff (fun y => (hP y).deriv) x 0
    simpa [hG0] using this
  have hrep : ∀ x : ℝ, D x = D 0 * Real.exp (-G x) := by
    intro x
    rw [← hPc x, mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, mul_one]
  
  have haux : ∀ a b : ℝ, a ≤ b → |∫ t in a..b, s t| ≤ ∫ t, |s t| := by
    intro a b hab
    calc |∫ t in a..b, s t| ≤ ∫ t in a..b, |s t| :=
          intervalIntegral.abs_integral_le_integral_abs hab
      _ = ∫ t in Set.Ioc a b, |s t| := intervalIntegral.integral_of_le hab
      _ ≤ ∫ t, |s t| :=
          setIntegral_le_integral hsi.abs (ae_of_all _ fun t => abs_nonneg _)
  have hGb : ∀ x : ℝ, |G x| ≤ ∫ t, |s t| := by
    intro x
    rcases le_or_gt 0 x with hx | hx
    · exact haux 0 x hx
    · show |∫ t in (0:ℝ)..x, s t| ≤ _
      rw [intervalIntegral.integral_symm, abs_neg]
      exact haux x 0 hx.le
  
  have hWm : Filter.Tendsto (Wm : ℝ → ℝ) Filter.atTop (nhds 0) :=
    (ZeroAtInftyContinuousMapClass.zero_at_infty Wm).mono_left atTop_le_cocompact
  have hWp : Filter.Tendsto (Wp : ℝ → ℝ) Filter.atTop (nhds 0) :=
    (ZeroAtInftyContinuousMapClass.zero_at_infty Wp).mono_left atTop_le_cocompact
  have hDlim : Filter.Tendsto D Filter.atTop (nhds (2 * κ + 0 - 0)) :=
    (tendsto_const_nhds.add hWm).sub hWp
  have hev : ∀ᶠ x in Filter.atTop, κ < D x :=
    hDlim.eventually_const_lt (by linarith)
  obtain ⟨x₀, hx₀⟩ := hev.exists
  have hD0 : 0 < D 0 := by
    by_contra hneg
    push_neg at hneg
    have h1 := hrep x₀
    have h2 := Real.exp_pos (-G x₀)
    have h3 : D 0 * Real.exp (-G x₀) ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hneg h2.le
    linarith
  
  refine ⟨D 0 * Real.exp (-(∫ t, |s t|)), mul_pos hD0 (Real.exp_pos _), fun x => ?_⟩
  have hx : -(∫ t, |s t|) ≤ -G x := by
    have := le_trans (le_abs_self (G x)) (hGb x)
    linarith
  have he := Real.exp_le_exp.2 hx
  have := mul_le_mul_of_nonneg_left he hD0.le
  show D 0 * Real.exp (-(∫ t, |s t|)) ≤ D x
  rw [hrep x]
  exact this

theorem green_offset_schwartz (κ : ℝ) (hκ : 0 < κ) (Wp Wm : 𝓢(ℝ, ℝ)) (c : ℝ) (hc : 0 < c)
    (hlow : ∀ x : ℝ, c ≤ 2 * κ + Wm x - Wp x) :
    ∃ γ : 𝓢(ℝ, ℝ), ∀ x : ℝ, γ x = 1 / (2 * κ + Wm x - Wp x) - 1 / (2 * κ) :=
by
  classical
  have hpos : ∀ x : ℝ, 0 < 2 * κ + Wm x - Wp x := fun x => lt_of_lt_of_le hc (hlow x)
  have hne : ∀ x : ℝ, 2 * κ + Wm x - Wp x ≠ 0 := fun x => (hpos x).ne'
  obtain ⟨g, hgdef⟩ : ∃ g : ℝ → ℝ, g = fun x => (2 * κ + Wm x - Wp x)⁻¹ := ⟨_, rfl⟩
  have hD : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun x => 2 * κ + Wm x - Wp x) :=
    (contDiff_const.add (Wm.smooth ⊤)).sub (Wp.smooth ⊤)
  have hg : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) g := by
    rw [hgdef]; exact hD.inv hne
  have hgb : ∀ x : ℝ, |g x| ≤ c⁻¹ := by
    intro x
    rw [hgdef]
    show |(2 * κ + Wm x - Wp x)⁻¹| ≤ c⁻¹
    rw [abs_of_pos (inv_pos.2 (hpos x))]
    exact inv_anti₀ hc (hlow x)
  obtain ⟨bS, hbS⟩ : ∃ bS : 𝓢(ℝ, ℝ), bS = SchwartzMap.derivCLM ℝ ℝ (Wp - Wm) := ⟨_, rfl⟩
  have hbSx : ∀ x : ℝ, bS x = deriv (Wp : ℝ → ℝ) x - deriv (Wm : ℝ → ℝ) x := by
    intro x
    rw [hbS, SchwartzMap.derivCLM_apply]
    have : ((Wp - Wm : 𝓢(ℝ, ℝ)) : ℝ → ℝ) = fun y => Wp y - Wm y := by funext y; simp
    rw [this]
    exact deriv_sub Wp.differentiableAt Wm.differentiableAt
  have hderiv : deriv g = fun y => bS y * (g y * g y) := by
    funext x
    have h1 : HasDerivAt (fun y => 2 * κ + Wm y - Wp y)
        (0 + deriv (Wm : ℝ → ℝ) x - deriv (Wp : ℝ → ℝ) x) x :=
      ((hasDerivAt_const x (2 * κ)).add Wm.differentiableAt.hasDerivAt).sub
        Wp.differentiableAt.hasDerivAt
    have h2 := h1.inv (hne x)
    have h3 : HasDerivAt g (-(0 + deriv (Wm : ℝ → ℝ) x - deriv (Wp : ℝ → ℝ) x) /
        (2 * κ + Wm x - Wp x) ^ 2) x := by
      rw [hgdef]; exact h2
    rw [h3.deriv, hbSx, hgdef]
    have := hne x
    field_simp
    ring
  have hbB : ∀ i : ℕ, ∃ B : ℝ, ∀ x : ℝ, |iteratedDeriv i (bS : ℝ → ℝ) x| ≤ B := by
    intro i
    obtain ⟨C, -, hC⟩ := bS.decay 0 i
    refine ⟨C, fun x => ?_⟩
    have := hC x
    rwa [pow_zero, one_mul, norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs] at this
  choose B hB using hbB
  have hB0 : ∀ i, 0 ≤ B i := fun i => (abs_nonneg _).trans (hB i 0)
  have hleib : ∀ (n : ℕ) (x : ℝ), |iteratedDeriv (n + 1) g x| ≤
      ∑ i ∈ Finset.range (n + 1), ∑ j ∈ Finset.range (n - i + 1),
        (n.choose i : ℝ) * ((n - i).choose j : ℝ) *
          (|iteratedDeriv i (bS : ℝ → ℝ) x| *
            (|iteratedDeriv j g x| * |iteratedDeriv (n - i - j) g x|)) := by
    intro n x
    rw [iteratedDeriv_succ', hderiv]
    have hbs : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (bS : ℝ → ℝ) := bS.smooth ⊤
    have hgg : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun y => g y * g y) := hg.mul hg
    have L1 := norm_iteratedFDeriv_mul_le (n := n) hbs hgg x (by exact_mod_cast le_top)
    simp only [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs] at L1
    refine L1.trans ?_
    apply Finset.sum_le_sum
    intro i _
    have L2 := (fun k : ℕ => norm_iteratedFDeriv_mul_le (n := k) hg hg x
      (by exact_mod_cast le_top)) (n - i)
    simp only [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs] at L2
    calc (n.choose i : ℝ) * |iteratedDeriv i (bS : ℝ → ℝ) x| *
          |iteratedDeriv (n - i) (fun y => g y * g y) x|
        ≤ (n.choose i : ℝ) * |iteratedDeriv i (bS : ℝ → ℝ) x| *
          ∑ j ∈ Finset.range (n - i + 1), ((n - i).choose j : ℝ) *
            |iteratedDeriv j g x| * |iteratedDeriv (n - i - j) g x| :=
          mul_le_mul_of_nonneg_left L2 (by positivity)
      _ = _ := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          ring
  have hP : ∀ n : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ m ≤ n, ∀ x : ℝ, |iteratedDeriv m g x| ≤ C := by
    intro n
    induction n with
    | zero =>
      refine ⟨c⁻¹, inv_nonneg.2 hc.le, fun m hm x => ?_⟩
      have hm0 : m = 0 := Nat.le_zero.1 hm
      subst hm0
      rw [iteratedDeriv_zero]
      exact hgb x
    | succ n ih =>
      obtain ⟨C, hC0, hC⟩ := ih
      obtain ⟨K, hK⟩ : ∃ K : ℝ, K = ∑ i ∈ Finset.range (n + 1), ∑ j ∈ Finset.range (n - i + 1),
          (n.choose i : ℝ) * ((n - i).choose j : ℝ) * (B i * (C * C)) := ⟨_, rfl⟩
      have hstep : ∀ x : ℝ, |iteratedDeriv (n + 1) g x| ≤ K := by
        intro x
        refine (hleib n x).trans ?_
        rw [hK]
        apply Finset.sum_le_sum
        intro i hi
        apply Finset.sum_le_sum
        intro j hj
        rw [Finset.mem_range] at hi hj
        have e1 := hC j (by omega) x
        have e2 := hC (n - i - j) (by omega) x
        have e3 : |iteratedDeriv j g x| * |iteratedDeriv (n - i - j) g x| ≤ C * C :=
          mul_le_mul e1 e2 (abs_nonneg _) hC0
        have e4 : |iteratedDeriv i (bS : ℝ → ℝ) x| *
            (|iteratedDeriv j g x| * |iteratedDeriv (n - i - j) g x|) ≤ B i * (C * C) :=
          mul_le_mul (hB i x) e3 (by positivity) (hB0 i)
        exact mul_le_mul_of_nonneg_left e4 (by positivity)
      refine ⟨max C K, le_max_of_le_left hC0, fun m hm x => ?_⟩
      rcases Nat.lt_or_ge m (n + 1) with h | h
      · exact (hC m (by omega) x).trans (le_max_left _ _)
      · have hm' : m = n + 1 := by omega
        subst hm'
        exact (hstep x).trans (le_max_right _ _)
  have hgt : Function.HasTemperateGrowth g := by
    refine ⟨hg, fun n => ?_⟩
    obtain ⟨C, -, hC⟩ := hP n
    refine ⟨0, C, fun x => ?_⟩
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs, pow_zero, mul_one]
    exact hC n le_rfl x
  refine ⟨SchwartzMap.bilinLeftCLM (ContinuousLinearMap.mul ℝ ℝ) hgt
    ((1 / (2 * κ)) • (Wp - Wm)), fun x => ?_⟩
  rw [SchwartzMap.bilinLeftCLM_apply]
  simp only [ContinuousLinearMap.mul_apply', SchwartzMap.smul_apply, SchwartzMap.sub_apply,
    smul_eq_mul, hgdef]
  have := hne x
  have hk : κ ≠ 0 := hκ.ne'
  field_simp
  ring

theorem green_ode_of_riccati_pair (κ : ℝ) (hκ : 0 < κ) (q Wp Wm γ : 𝓢(ℝ, ℝ))
    (hp : ∀ x : ℝ, HasDerivAt (Wp : ℝ → ℝ) (q x + 2 * κ * Wp x - Wp x ^ 2) x)
    (hm : ∀ x : ℝ, HasDerivAt (Wm : ℝ → ℝ) (q x - 2 * κ * Wm x - Wm x ^ 2) x)
    (hpos : ∀ x : ℝ, 0 < 2 * κ + Wm x - Wp x)
    (hγ : ∀ x : ℝ, γ x = 1 / (2 * κ + Wm x - Wp x) - 1 / (2 * κ)) :
    GreenODE κ q γ :=
by
  have hD : ∀ x : ℝ, HasDerivAt (fun y => 2 * κ + Wm y - Wp y)
      ((q x - 2 * κ * Wm x - Wm x ^ 2) - (q x + 2 * κ * Wp x - Wp x ^ 2)) x := by
    intro x
    exact ((hm x).const_add (2 * κ)).sub (hp x)
  have hg_eq : (fun y => 1 / (2 * κ) + γ y) = fun y => (2 * κ + Wm y - Wp y)⁻¹ := by
    funext y
    rw [hγ y]
    ring
  have hg : ∀ x : ℝ, HasDerivAt (fun y => 1 / (2 * κ) + γ y)
      ((Wp x + Wm x) * (1 / (2 * κ) + γ x)) x := by
    intro x
    have hne : 2 * κ + Wm x - Wp x ≠ 0 := (hpos x).ne'
    rw [hg_eq]
    convert (hD x).inv hne using 1
    rw [hγ x]
    field_simp
    ring
  have hdg : deriv (fun y => 1 / (2 * κ) + γ y) =
      fun y => (Wp y + Wm y) * (1 / (2 * κ) + γ y) := by
    funext y
    exact (hg y).deriv
  have hsg : ∀ x : ℝ, HasDerivAt (fun y => (Wp y + Wm y) * (1 / (2 * κ) + γ y))
      ((2 * q x + (2 * κ * (Wp x - Wm x) + 2 * (Wp x * Wm x))) * (1 / (2 * κ) + γ x)) x := by
    intro x
    convert ((hp x).add (hm x)).mul (hg x) using 1
    simp only [Pi.add_apply]
    ring
  have hddg : deriv (fun y => (Wp y + Wm y) * (1 / (2 * κ) + γ y)) =
      fun y => (2 * q y + (2 * κ * (Wp y - Wm y) + 2 * (Wp y * Wm y))) * (1 / (2 * κ) + γ y) := by
    funext y
    exact (hsg y).deriv
  have hq : ∀ x : ℝ, HasDerivAt (q : ℝ → ℝ) (deriv (q : ℝ → ℝ) x) x :=
    fun x => (q.differentiableAt (x := x)).hasDerivAt
  have h3rd : ∀ x : ℝ, HasDerivAt
      (fun y => (2 * q y + (2 * κ * (Wp y - Wm y) + 2 * (Wp y * Wm y))) * (1 / (2 * κ) + γ y))
      ((2 * deriv (q : ℝ → ℝ) x + (2 * κ * ((q x + 2 * κ * Wp x - Wp x ^ 2)
          - (q x - 2 * κ * Wm x - Wm x ^ 2)) + 2 * ((q x + 2 * κ * Wp x - Wp x ^ 2) * Wm x
          + Wp x * (q x - 2 * κ * Wm x - Wm x ^ 2)))) * (1 / (2 * κ) + γ x)
        + (2 * q x + (2 * κ * (Wp x - Wm x) + 2 * (Wp x * Wm x)))
          * ((Wp x + Wm x) * (1 / (2 * κ) + γ x))) x := by
    intro x
    exact (((hq x).const_mul 2).add ((((hp x).sub (hm x)).const_mul (2 * κ)).add
      (((hp x).mul (hm x)).const_mul 2))).mul (hg x)
  have hqg : ∀ x : ℝ, HasDerivAt (fun y => q y * (1 / (2 * κ) + γ y))
      (deriv (q : ℝ → ℝ) x * (1 / (2 * κ) + γ x) + q x * ((Wp x + Wm x) * (1 / (2 * κ) + γ x))) x :=
    fun x => (hq x).mul (hg x)
  have h3 : iteratedDeriv 3 (fun y => 1 / (2 * κ) + γ y) =
      deriv (deriv (deriv (fun y => 1 / (2 * κ) + γ y))) := by
    rw [iteratedDeriv_eq_iterate]
    rfl
  intro x
  rw [h3, hdg, hddg, (h3rd x).deriv, (hqg x).deriv]
  ring

theorem green_exists_unique : ∃ δ > (0 : ℝ), ∀ κ ≥ (1 : ℝ), ∀ q : 𝓢(ℝ, ℝ), ‖ι q‖ ≤ δ →
    ∃! γ : 𝓢(ℝ, ℝ), GreenODE κ q γ :=
by
  refine ⟨1 / 8, by norm_num, fun κ hκ q hq => ?_⟩
  have hκ0 : (0 : ℝ) < κ := by linarith
  have hq' : ‖toHm1 q‖ ≤ 1 / 8 := hq
  
  
  
  have hsmallK : ∀ r : 𝓢(ℝ, ℝ), ‖toHm1 r‖ ≤ 1 / 8 →
      MemLp (riccatiK κ r) 2 (volume : Measure ℝ) ∧ ∫ x : ℝ, riccatiK κ r x ^ 2 ≤ 1 / 64 := by
    intro r hr
    obtain ⟨hmem, heq⟩ := riccatiK_sq_integral κ hκ0 r
    refine ⟨hmem, ?_⟩
    rw [heq]
    have h1 := ((Hm1_weight_basic (toHm1 r)).2 κ hκ).2.1
    have h2 : ‖toHm1 r‖ ^ 2 ≤ (1 / 8) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hr 2
    have h3 : ((1 : ℝ) / 8) ^ 2 = 1 / 64 := by norm_num
    linarith
  
  
  
  have hschw : ∀ r : 𝓢(ℝ, ℝ), ‖toHm1 r‖ ≤ 1 / 8 → ∃ W : 𝓢(ℝ, ℝ),
      ∀ x : ℝ, HasDerivAt (W : ℝ → ℝ) (r x + 2 * κ * W x - W x ^ 2) x := by
    intro r hr
    obtain ⟨hmem, hK⟩ := hsmallK r hr
    obtain ⟨w, hw⟩ := (riccati_fixed_point κ hκ r hmem hK).1
    obtain ⟨hc, hb, htop, hbot, hd⟩ := riccati_sol_regularity κ hκ0 r w hw
    have hdec := riccati_sol_rapid_decay κ hκ0 r w hc hb htop hbot hd
    obtain ⟨W, hW⟩ := schwartz_of_riccati_decay κ r w hd hdec
    have hWw : (W : ℝ → ℝ) = w := funext hW
    refine ⟨W, fun x => ?_⟩
    rw [hWw]
    exact hd x
  
  
  
  have hneg : Function.HasTemperateGrowth (fun x : ℝ => -x) := by
    have := (-ContinuousLinearMap.id ℝ ℝ).hasTemperateGrowth
    convert this using 1
  have hup : ∃ (k : ℕ) (C : ℝ), ∀ x : ℝ, ‖x‖ ≤ C * (1 + ‖-x‖) ^ k := ⟨1, 1, fun x => by simp⟩
  obtain ⟨Rf, hR⟩ : ∃ Rf : 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ), ∀ (f : 𝓢(ℝ, ℝ)) (x : ℝ), Rf f x = f (-x) :=
    ⟨fun f => (SchwartzMap.compCLM ℝ hneg hup : 𝓢(ℝ, ℝ) →L[ℝ] 𝓢(ℝ, ℝ)) f,
      fun f x => by simp [SchwartzMap.compCLM_apply]⟩
  have hqt : ‖toHm1 (Rf q)‖ ≤ 1 / 8 := by
    rw [toHm1_norm_comp_neg q (Rf q) (hR q)]
    exact hq'
  obtain ⟨Wp, hWp⟩ := hschw q hq'
  obtain ⟨Wt, hWt⟩ := hschw (Rf q) hqt
  obtain ⟨Wm, hWm⟩ : ∃ Wm : 𝓢(ℝ, ℝ), ∀ x : ℝ, Wm x = -Wt (-x) :=
    ⟨Rf (-Wt), fun x => by rw [hR]; simp⟩
  have hWmd : ∀ x : ℝ, HasDerivAt (Wm : ℝ → ℝ) (q x - 2 * κ * Wm x - Wm x ^ 2) x := by
    intro x
    have h1 : HasDerivAt (Wt : ℝ → ℝ)
        (Rf q (0 - x) + 2 * κ * Wt (0 - x) - Wt (0 - x) ^ 2) (0 - x) := hWt (0 - x)
    have h3 := (h1.comp_const_sub 0 x).neg
    have h4 : HasDerivAt (Wm : ℝ → ℝ)
        (-(-(Rf q (0 - x) + 2 * κ * Wt (0 - x) - Wt (0 - x) ^ 2))) x :=
      h3.congr_of_eventuallyEq (Filter.Eventually.of_forall fun y => by simp [hWm])
    convert h4 using 1
    rw [hWm, hR]
    simp only [zero_sub, neg_neg]
    ring
  
  
  
  obtain ⟨c, hc, hlow⟩ := green_denominator_lower_bound κ hκ0 q Wp Wm hWp hWmd
  obtain ⟨γ, hγ⟩ := green_offset_schwartz κ hκ0 Wp Wm c hc hlow
  have hγode : GreenODE κ q γ :=
    green_ode_of_riccati_pair κ hκ0 q Wp Wm γ hWp hWmd (fun x => lt_of_lt_of_le hc (hlow x)) hγ
  
  
  
  have alg : ∀ a b u v I N : ℝ, 0 ≤ a → 0 ≤ b → 0 ≤ u → 0 ≤ v → 0 ≤ N → N ≤ 1 / 8 →
      3 * a ^ 2 + 4 * κ ^ 2 * b ^ 2 + 4 * I = 0 →
      |I| ≤ N * (2 * u + 2 * κ * v) →
      u ^ 2 ≤ 2 * b * a * a ^ 2 → v ^ 2 ≤ 2 * b * a * b ^ 2 → b = 0 := by
    intro a b u v I N ha hb hu hv hN0 hN hE hI hu2 hv2
    have hκv : 0 ≤ κ * v := mul_nonneg hκ0.le hv
    have hS : 0 ≤ 2 * u + 2 * κ * v := by linarith
    have hL : 3 * a ^ 2 + 4 * κ ^ 2 * b ^ 2 ≤ u + κ * v := by
      have h1 : |I| ≤ 1 / 8 * (2 * u + 2 * κ * v) :=
        le_trans hI (mul_le_mul_of_nonneg_right hN hS)
      have h2 := neg_abs_le I
      linarith
    have hX0 : 0 ≤ a ^ 2 + κ ^ 2 * b ^ 2 := by positivity
    have hL3 : 3 * (a ^ 2 + κ ^ 2 * b ^ 2) ≤ 3 * a ^ 2 + 4 * κ ^ 2 * b ^ 2 := by
      nlinarith [sq_nonneg (κ * b)]
    have hS2 : (u + κ * v) ^ 2 ≤ 2 * (u ^ 2 + κ ^ 2 * v ^ 2) := by
      nlinarith [sq_nonneg (u - κ * v)]
    have hab : 0 ≤ b * a := mul_nonneg hb ha
    have hM : 2 * b * a ≤ a ^ 2 + κ ^ 2 * b ^ 2 := by
      have h1 : 2 * κ * (b * a) ≤ a ^ 2 + κ ^ 2 * b ^ 2 := by
        nlinarith [sq_nonneg (a - κ * b)]
      have h2 : b * a ≤ κ * (b * a) := by nlinarith
      linarith
    have hPR : 2 * (u ^ 2 + κ ^ 2 * v ^ 2) ≤ 2 * (2 * b * a) * (a ^ 2 + κ ^ 2 * b ^ 2) := by
      have := mul_le_mul_of_nonneg_left hv2 (sq_nonneg κ)
      nlinarith
    have e1 : (3 * (a ^ 2 + κ ^ 2 * b ^ 2)) ^ 2 ≤ (3 * a ^ 2 + 4 * κ ^ 2 * b ^ 2) ^ 2 :=
      pow_le_pow_left₀ (by positivity) hL3 2
    have e2 : (3 * a ^ 2 + 4 * κ ^ 2 * b ^ 2) ^ 2 ≤ (u + κ * v) ^ 2 :=
      pow_le_pow_left₀ (by positivity) hL 2
    have e3 : 2 * (2 * b * a) * (a ^ 2 + κ ^ 2 * b ^ 2) ≤
        2 * (a ^ 2 + κ ^ 2 * b ^ 2) * (a ^ 2 + κ ^ 2 * b ^ 2) :=
      mul_le_mul_of_nonneg_right (by linarith) hX0
    have h7 : (a ^ 2 + κ ^ 2 * b ^ 2) ^ 2 ≤ 0 := by nlinarith
    have hX : a ^ 2 + κ ^ 2 * b ^ 2 = 0 :=
      (pow_eq_zero_iff two_ne_zero).1 (le_antisymm h7 (sq_nonneg _))
    have hk2 : 1 ≤ κ ^ 2 := by nlinarith
    have h8 := mul_le_mul_of_nonneg_right hk2 (sq_nonneg b)
    have hb2 : b ^ 2 = 0 := by nlinarith [sq_nonneg a, sq_nonneg b]
    exact (pow_eq_zero_iff two_ne_zero).1 hb2
  have huniq : ∀ γ₁ γ₂ : 𝓢(ℝ, ℝ), GreenODE κ q γ₁ → GreenODE κ q γ₂ → γ₁ = γ₂ := by
    intro γ₁ γ₂ h₁ h₂
    obtain ⟨h, hh⟩ : ∃ h : 𝓢(ℝ, ℝ), ∀ x : ℝ, h x = γ₁ x - γ₂ x :=
      ⟨γ₁ - γ₂, fun x => SchwartzMap.sub_apply⟩
    
    have key : ∀ γ : 𝓢(ℝ, ℝ), GreenODE κ q γ → ∀ x : ℝ, iteratedDeriv 3 (γ : ℝ → ℝ) x =
        2 * (deriv (q : ℝ → ℝ) x * (1 / (2 * κ) + γ x) + q x * deriv (γ : ℝ → ℝ) x)
          + 2 * q x * deriv (γ : ℝ → ℝ) x + 4 * κ ^ 2 * deriv (γ : ℝ → ℝ) x := by
      intro γ hγ x
      have e3 : iteratedDeriv 3 (fun y => 1 / (2 * κ) + γ y) x = iteratedDeriv 3 (γ : ℝ → ℝ) x :=
        iteratedDeriv_const_add (by norm_num) _
      have e1 : deriv (fun y => 1 / (2 * κ) + γ y) x = deriv (γ : ℝ → ℝ) x := deriv_const_add _
      have em : deriv (fun y => q y * (1 / (2 * κ) + γ y)) x =
          deriv (q : ℝ → ℝ) x * (1 / (2 * κ) + γ x) + q x * deriv (γ : ℝ → ℝ) x :=
        (((q.differentiableAt (x := x)).hasDerivAt).mul
          (((γ.differentiableAt (x := x)).hasDerivAt).const_add _)).deriv
      have := hγ x
      rw [e3, e1, em] at this
      exact this
    have hfun : (h : ℝ → ℝ) = (γ₁ : ℝ → ℝ) - (γ₂ : ℝ → ℝ) := funext fun x => by simp [hh]
    have hode : ∀ x : ℝ, iteratedDeriv 3 (h : ℝ → ℝ) x =
        2 * deriv (q : ℝ → ℝ) x * h x + 4 * q x * deriv (h : ℝ → ℝ) x
          + 4 * κ ^ 2 * deriv (h : ℝ → ℝ) x := by
      intro x
      have d3 : iteratedDeriv 3 (h : ℝ → ℝ) x =
          iteratedDeriv 3 (γ₁ : ℝ → ℝ) x - iteratedDeriv 3 (γ₂ : ℝ → ℝ) x := by
        rw [hfun]
        exact iteratedDeriv_sub (γ₁.smooth 3).contDiffAt (γ₂.smooth 3).contDiffAt
      have d1 : deriv (h : ℝ → ℝ) x = deriv (γ₁ : ℝ → ℝ) x - deriv (γ₂ : ℝ → ℝ) x := by
        rw [hfun]
        exact deriv_sub γ₁.differentiableAt γ₂.differentiableAt
      rw [d3, d1, key γ₁ h₁ x, key γ₂ h₂ x, hh x]
      ring
    
    obtain ⟨h', hh'⟩ : ∃ h' : 𝓢(ℝ, ℝ), ∀ y : ℝ, h' y = deriv (h : ℝ → ℝ) y :=
      ⟨SchwartzMap.derivCLM ℝ ℝ h, fun y => SchwartzMap.derivCLM_apply ℝ h y⟩
    obtain ⟨h'', hh''⟩ : ∃ h'' : 𝓢(ℝ, ℝ), ∀ y : ℝ, h'' y = deriv (h' : ℝ → ℝ) y :=
      ⟨SchwartzMap.derivCLM ℝ ℝ h', fun y => SchwartzMap.derivCLM_apply ℝ h' y⟩
    have hfun' : deriv (h : ℝ → ℝ) = (h' : ℝ → ℝ) := funext fun y => (hh' y).symm
    have hfun'' : iteratedDeriv 2 (h : ℝ → ℝ) = (h'' : ℝ → ℝ) := by
      rw [iteratedDeriv_succ, iteratedDeriv_one, hfun']
      exact funext fun y => (hh'' y).symm
    have hfun3 : iteratedDeriv 3 (h : ℝ → ℝ) = deriv (h'' : ℝ → ℝ) := by
      rw [iteratedDeriv_succ, hfun'']
    have ht : ∀ f : 𝓢(ℝ, ℝ), Filter.Tendsto (f : ℝ → ℝ) Filter.atTop (nhds 0) :=
      fun f => (zero_at_infty f).mono_left atTop_le_cocompact
    
    have hΦd : ∀ y : ℝ, HasDerivAt
        (fun y => -2 * h y * h'' y + h' y ^ 2 + 4 * (q y + κ ^ 2) * h y ^ 2) 0 y := by
      intro y
      have Hh := (h.differentiableAt (x := y)).hasDerivAt
      have Hh' := (h'.differentiableAt (x := y)).hasDerivAt
      have Hh'' := (h''.differentiableAt (x := y)).hasDerivAt
      have Hq := (q.differentiableAt (x := y)).hasDerivAt
      have H := (((Hh.const_mul (-2)).mul Hh'').add (Hh'.pow 2)).add
        (((Hq.add_const (κ ^ 2)).const_mul 4).mul (Hh.pow 2))
      convert H using 1
      have e3 := hode y
      rw [hfun3] at e3
      simp only [← hh', ← hh'', Pi.pow_apply] at e3 ⊢
      rw [e3]
      push_cast
      ring
    have hconst := is_const_of_deriv_eq_zero (fun y => (hΦd y).differentiableAt)
      (fun y => (hΦd y).deriv)
    have hΦlim0 := ((((ht h).const_mul (-2)).mul (ht h'')).add ((ht h').pow 2)).add
      ((((ht q).add_const (κ ^ 2)).const_mul 4).mul ((ht h).pow 2))
    have hz : (-2 * 0 * 0 + 0 ^ 2 + 4 * (0 + κ ^ 2) * 0 ^ 2 : ℝ) = 0 := by ring
    rw [hz] at hΦlim0
    have hfi : ∀ x : ℝ, -2 * h x * iteratedDeriv 2 (h : ℝ → ℝ) x + deriv (h : ℝ → ℝ) x ^ 2
        + 4 * (q x + κ ^ 2) * h x ^ 2 = 0 := by
      intro x
      rw [hfun'', hfun']
      have h1 : Filter.Tendsto
          (fun _ : ℝ => -2 * h x * h'' x + h' x ^ 2 + 4 * (q x + κ ^ 2) * h x ^ 2)
          Filter.atTop (nhds 0) :=
        hΦlim0.congr fun y => hconst y x
      exact tendsto_nhds_unique tendsto_const_nhds h1
    
    have hE : 3 * (∫ x : ℝ, deriv (h : ℝ → ℝ) x ^ 2) + 4 * κ ^ 2 * (∫ x : ℝ, h x ^ 2)
        + 4 * (∫ x : ℝ, q x * h x ^ 2) = 0 := by
      have i1 : Integrable (fun x => h x * h'' x) volume :=
        (h.memLp 2 (volume : Measure ℝ)).integrable_mul (h''.memLp 2 (volume : Measure ℝ))
      have i2 : Integrable (fun x => h' x ^ 2) volume :=
        (h'.memLp 2 (volume : Measure ℝ)).integrable_sq
      have i3 : Integrable (fun x => q x * h x ^ 2) volume :=
        (h.memLp 2 (volume : Measure ℝ)).integrable_sq.bdd_mul
          (c := SchwartzMap.seminorm ℝ 0 0 q) q.continuous.aestronglyMeasurable
          (ae_of_all _ fun x => SchwartzMap.norm_le_seminorm ℝ q x)
      have i4 : Integrable (fun x => h x ^ 2) volume :=
        (h.memLp 2 (volume : Measure ℝ)).integrable_sq
      have hibp : ∫ x, h x * h'' x = -∫ x, h' x * h' x :=
        integral_mul_deriv_eq_deriv_mul_of_integrable (u := (h : ℝ → ℝ)) (v := (h' : ℝ → ℝ))
          (u' := (h' : ℝ → ℝ)) (v' := (h'' : ℝ → ℝ))
          (fun x => by rw [hh']; exact (h.differentiableAt (x := x)).hasDerivAt)
          (fun x => by rw [hh'']; exact (h'.differentiableAt (x := x)).hasDerivAt)
          i1
          ((h'.memLp 2 (volume : Measure ℝ)).integrable_mul (h'.memLp 2 (volume : Measure ℝ)))
          ((h.memLp 2 (volume : Measure ℝ)).integrable_mul (h'.memLp 2 (volume : Measure ℝ)))
      have hsq : ∫ x, h' x * h' x = ∫ x, h' x ^ 2 := by
        congr 1
        funext x
        ring
      have h0 : ∫ x, (-2 * (h x * h'' x) + h' x ^ 2 + (4 * (q x * h x ^ 2) + 4 * κ ^ 2 * h x ^ 2))
          = 0 := by
        have hz0 : (fun x => -2 * (h x * h'' x) + h' x ^ 2
            + (4 * (q x * h x ^ 2) + 4 * κ ^ 2 * h x ^ 2)) = fun _ => (0 : ℝ) := by
          funext x
          have := hfi x
          rw [hfun'', hfun'] at this
          linear_combination this
        rw [hz0, integral_zero]
      have j1 : Integrable (fun x => -2 * (h x * h'' x) + h' x ^ 2) volume :=
        (i1.const_mul (-2)).add i2
      have j2 : Integrable (fun x => 4 * (q x * h x ^ 2) + 4 * κ ^ 2 * h x ^ 2) volume :=
        (i3.const_mul 4).add (i4.const_mul (4 * κ ^ 2))
      have s1 := integral_add j1 j2
      have s2 := integral_add (i1.const_mul (-2)) i2
      have s3 := integral_add (i3.const_mul 4) (i4.const_mul (4 * κ ^ 2))
      have s4 := integral_const_mul (μ := volume) (-2 : ℝ) (fun x => h x * h'' x)
      have s5 := integral_const_mul (μ := volume) (4 : ℝ) (fun x => q x * h x ^ 2)
      have s6 := integral_const_mul (μ := volume) (4 * κ ^ 2 : ℝ) (fun x => h x ^ 2)
      have hA' : ∫ x, h' x ^ 2 = ∫ x : ℝ, deriv (h : ℝ → ℝ) x ^ 2 := by
        simp only [hh']
      linarith [h0, s1, s2, s3, s4, s5, s6, hibp, hsq, hA']
    have hI := schwartz_sq_pairing_bound κ hκ q h
    
    have hAg : ∀ x : ℝ, h x ^ 2 ≤ 2 * Real.sqrt (∫ y : ℝ, h y ^ 2) *
        Real.sqrt (∫ y : ℝ, deriv (h : ℝ → ℝ) y ^ 2) := by
      intro x
      have hderiv : ∀ y : ℝ, HasDerivAt (fun y => h y ^ 2) (2 * h y * h' y) y := by
        intro y
        have := ((h.differentiableAt (x := y)).hasDerivAt).pow 2
        rw [hh']
        convert this using 1
        push_cast
        ring
      have hint : Integrable (fun y => 2 * h y * h' y) volume := by
        have h1 := (h.memLp 2 (volume : Measure ℝ)).integrable_mul (h'.memLp 2 (volume : Measure ℝ))
        refine (h1.const_mul 2).congr (ae_of_all _ fun y => ?_)
        simp only [Pi.mul_apply]
        ring
      have hlim : Filter.Tendsto (fun y => h y ^ 2) Filter.atTop (nhds 0) := by
        have := (ht h).pow 2
        simpa using this
      have hIoi := MeasureTheory.integral_Ioi_of_hasDerivAt_of_tendsto (a := x)
        ((h.continuous.pow 2).continuousWithinAt) (fun y _ => hderiv y) hint.integrableOn hlim
      have e1 : h x ^ 2 ≤ |∫ y in Set.Ioi x, 2 * h y * h' y| := by
        rw [hIoi, zero_sub, abs_neg]
        exact le_abs_self _
      have e2 : |∫ y in Set.Ioi x, 2 * h y * h' y| ≤ ∫ y, |2 * h y * h' y| :=
        abs_integral_le_integral_abs.trans
          (setIntegral_le_integral hint.abs (ae_of_all _ fun y => abs_nonneg _))
      have e3 : ∫ y, |2 * h y * h' y| = 2 * ∫ y, |h y| * |h' y| := by
        rw [← integral_const_mul]
        congr 1
        funext y
        rw [abs_mul, abs_mul, abs_two]
        ring
      have hH := integral_mul_le_Lp_mul_Lq_of_nonneg (μ := volume) Real.HolderConjugate.two_two
        (f := fun y => ‖h y‖) (g := fun y => ‖h' y‖)
        (ae_of_all _ fun y => norm_nonneg _) (ae_of_all _ fun y => norm_nonneg _)
        ((h.memLp (ENNReal.ofReal 2) volume).norm) ((h'.memLp (ENNReal.ofReal 2) volume).norm)
      simp only [Real.norm_eq_abs] at hH
      have e4 : ∀ f : ℝ → ℝ, (∫ y, |f y| ^ (2 : ℝ)) ^ (1 / 2 : ℝ) = Real.sqrt (∫ y, f y ^ 2) := by
        intro f
        rw [Real.sqrt_eq_rpow]
        congr 2
        funext y
        rw [Real.rpow_two, sq_abs]
      rw [e4 (h : ℝ → ℝ), e4 (h' : ℝ → ℝ)] at hH
      simp only [hh'] at hH e1 e2 e3
      linarith [hH, e1, e2, e3]
    have hint_d2 : Integrable (fun x : ℝ => deriv (h : ℝ → ℝ) x ^ 2) volume := by
      have := ((SchwartzMap.derivCLM ℝ ℝ h).memLp 2 (volume : Measure ℝ)).integrable_sq
      simpa only [SchwartzMap.derivCLM_apply] using this
    have hint_h2 : Integrable (fun x : ℝ => h x ^ 2) volume :=
      (h.memLp 2 (volume : Measure ℝ)).integrable_sq
    have hA0 : 0 ≤ ∫ x : ℝ, deriv (h : ℝ → ℝ) x ^ 2 := integral_nonneg fun x => sq_nonneg _
    have hB0 : 0 ≤ ∫ x : ℝ, h x ^ 2 := integral_nonneg fun x => sq_nonneg _
    have hP0 : 0 ≤ ∫ x : ℝ, (h x * deriv (h : ℝ → ℝ) x) ^ 2 :=
      integral_nonneg fun x => sq_nonneg _
    have hR0 : 0 ≤ ∫ x : ℝ, h x ^ 4 := integral_nonneg fun x => by positivity
    have hPM : ∫ x : ℝ, (h x * deriv (h : ℝ → ℝ) x) ^ 2 ≤
        2 * Real.sqrt (∫ x : ℝ, h x ^ 2) * Real.sqrt (∫ x : ℝ, deriv (h : ℝ → ℝ) x ^ 2) *
          ∫ x : ℝ, deriv (h : ℝ → ℝ) x ^ 2 := by
      rw [← integral_const_mul]
      refine integral_mono_of_nonneg (ae_of_all _ fun x => sq_nonneg _)
        (hint_d2.const_mul _) (ae_of_all _ fun x => ?_)
      simp only
      rw [mul_pow]
      exact mul_le_mul_of_nonneg_right (hAg x) (sq_nonneg _)
    have hRM : ∫ x : ℝ, h x ^ 4 ≤
        2 * Real.sqrt (∫ x : ℝ, h x ^ 2) * Real.sqrt (∫ x : ℝ, deriv (h : ℝ → ℝ) x ^ 2) *
          ∫ x : ℝ, h x ^ 2 := by
      rw [← integral_const_mul]
      refine integral_mono_of_nonneg (ae_of_all _ fun x => by positivity)
        (hint_h2.const_mul _) (ae_of_all _ fun x => ?_)
      simp only
      have e : h x ^ 4 = h x ^ 2 * h x ^ 2 := by ring
      rw [e]
      exact mul_le_mul_of_nonneg_right (hAg x) (sq_nonneg _)
    have hb0 : Real.sqrt (∫ x : ℝ, h x ^ 2) = 0 := by
      refine alg (Real.sqrt (∫ x : ℝ, deriv (h : ℝ → ℝ) x ^ 2)) (Real.sqrt (∫ x : ℝ, h x ^ 2))
        (Real.sqrt (∫ x : ℝ, (h x * deriv (h : ℝ → ℝ) x) ^ 2)) (Real.sqrt (∫ x : ℝ, h x ^ 4))
        (∫ x : ℝ, q x * h x ^ 2) ‖toHm1 q‖ (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
        (Real.sqrt_nonneg _) (Real.sqrt_nonneg _) (norm_nonneg _) hq' ?_ hI ?_ ?_
      · rw [Real.sq_sqrt hA0, Real.sq_sqrt hB0]
        linarith [hE]
      · rw [Real.sq_sqrt hP0, Real.sq_sqrt hA0]
        exact hPM
      · rw [Real.sq_sqrt hR0, Real.sq_sqrt hB0]
        exact hRM
    have hzero : ∀ x : ℝ, h x = 0 := by
      intro x
      have h1 := hAg x
      rw [hb0, mul_zero, zero_mul] at h1
      exact (pow_eq_zero_iff two_ne_zero).1 (le_antisymm h1 (sq_nonneg _))
    ext x
    have h1 := hh x
    rw [hzero x] at h1
    linarith
  exact ⟨γ, hγode, fun γ' hγ' => huniq γ' γ hγ' hγode⟩

theorem green_solution_deriv_lipschitz : ∃ δ > (0 : ℝ), ∀ κ ≥ (1 : ℝ), ∃ L ≥ (0 : ℝ),
    ∀ q₁ q₂ γ₁ γ₂ w : 𝓢(ℝ, ℝ), ‖ι q₁‖ ≤ δ → ‖ι q₂‖ ≤ δ →
      GreenODE κ q₁ γ₁ → GreenODE κ q₂ γ₂ →
      (∀ x : ℝ, w x = deriv (γ₁ : ℝ → ℝ) x - deriv (γ₂ : ℝ → ℝ) x) →
      ‖ι w‖ ≤ L * dist (ι q₁) (ι q₂) :=
by
  classical
  refine ⟨1 / 8, by norm_num, ?_⟩
  intro κ hκ
  refine ⟨3, by norm_num, ?_⟩
  intro q₁ q₂ γ₁ γ₂ w hq₁ hq₂ hG₁ hG₂ hw
  have hκ0 : (0 : ℝ) < κ := by linarith
  
  have hsmallK : ∀ q : 𝓢(ℝ, ℝ), ‖ι q‖ ≤ 1 / 8 →
      MemLp (riccatiK κ q) 2 (volume : Measure ℝ) ∧ ∫ x : ℝ, riccatiK κ q x ^ 2 ≤ 1 / 64 := by
    intro q hq
    obtain ⟨hm, heq⟩ := riccatiK_sq_integral κ hκ0 q
    refine ⟨hm, ?_⟩
    rw [heq]
    have h1 := ((Hm1_weight_basic (toHm1 q)).2 κ hκ).2.1
    have h2 : ‖toHm1 q‖ ≤ 1 / 8 := hq
    have h3 : ‖toHm1 q‖ ^ 2 ≤ (1 / 8) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) h2 2
    have h4 : ((1 : ℝ) / 8) ^ 2 = 1 / 64 := by norm_num
    linarith
  obtain ⟨m₁, s₁⟩ := hsmallK q₁ hq₁
  obtain ⟨m₂, s₂⟩ := hsmallK q₂ hq₂
  obtain ⟨⟨ρ₁, hρ₁⟩, -⟩ := riccati_fixed_point κ hκ q₁ m₁ s₁
  obtain ⟨⟨ρ₂, hρ₂⟩, -⟩ := riccati_fixed_point κ hκ q₂ m₂ s₂
  
  have hsq16 : Real.sqrt (1 / 16) = 1 / 4 := by
    rw [show (1 / 16 : ℝ) = (1 / 4) ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
  have hSρ : ∀ (q : 𝓢(ℝ, ℝ)) (ρ : ℝ → ℝ), IsRiccatiSol κ q ρ →
      Real.sqrt (∫ x : ℝ, ρ x ^ 2) ≤ 1 / 4 := by
    intro q ρ hρ
    rw [← hsq16]
    exact Real.sqrt_le_sqrt hρ.2.1
  have hscale : ∀ (c : ℝ) (f : ℝ → ℝ), 0 ≤ c →
      Real.sqrt (∫ x : ℝ, (c * f x) ^ 2) = c * Real.sqrt (∫ x : ℝ, f x ^ 2) := by
    intro c f hc
    have : (fun x : ℝ => (c * f x) ^ 2) = fun x : ℝ => c ^ 2 * f x ^ 2 := by
      funext x; ring
    rw [this, integral_const_mul, Real.sqrt_mul (sq_nonneg c), Real.sqrt_sq hc]
  have hkinv0 : 0 ≤ κ⁻¹ := inv_nonneg.2 hκ0.le
  have hkinv1 : κ⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hκ
  have hscaleK : ∀ f : ℝ → ℝ, Real.sqrt (∫ x : ℝ, (κ⁻¹ * f x) ^ 2) ≤
      Real.sqrt (∫ x : ℝ, f x ^ 2) := by
    intro f
    rw [hscale _ _ hkinv0]
    have := Real.sqrt_nonneg (∫ x : ℝ, f x ^ 2)
    nlinarith
  
  have hred : ∀ (q γ : 𝓢(ℝ, ℝ)), GreenODE κ q γ → ∀ x : ℝ, iteratedDeriv 3 (⇑γ) x =
      deriv (⇑q) x / κ + 2 * deriv (⇑q) x * γ x + 4 * q x * deriv (⇑γ) x +
        4 * κ ^ 2 * deriv (⇑γ) x := by
    intro q γ hγ x
    have h := hγ x
    have e1 : iteratedDeriv 3 (fun y => 1 / (2 * κ) + γ y) x = iteratedDeriv 3 (⇑γ) x := by
      rw [iteratedDeriv_const_add (by norm_num : 0 < 3)]
    have e2 : deriv (fun y => 1 / (2 * κ) + γ y) x = deriv (⇑γ) x := deriv_const_add _
    have e3 : deriv (fun y => q y * (1 / (2 * κ) + γ y)) x =
        deriv (⇑q) x * (1 / (2 * κ) + γ x) + q x * deriv (⇑γ) x := by
      have := ((q.differentiableAt (x := x)).hasDerivAt).mul
        (((γ.differentiableAt (x := x)).hasDerivAt).const_add (1 / (2 * κ)))
      exact this.deriv
    rw [e1, e2, e3] at h
    rw [h]
    field_simp
    ring
  
  have hdecay : ∀ F : 𝓢(ℝ, ℝ), Filter.Tendsto (⇑F) Filter.atTop (nhds 0) ∧
      Filter.Tendsto (⇑F) Filter.atBot (nhds 0) := by
    intro F
    have h := F.toZeroAtInfty.zero_at_infty'
    rw [cocompact_eq_atBot_atTop, Filter.tendsto_sup] at h
    exact ⟨h.2, h.1⟩
  
  have ode_zero : ∀ (m v u : ℝ → ℝ), Continuous m → (∀ x : ℝ, HasDerivAt v (u x) x) →
      (∀ x : ℝ, HasDerivAt u (m x * u x) x) → Filter.Tendsto v Filter.atTop (nhds 0) →
      Filter.Tendsto v Filter.atBot (nhds 0) → ∀ x : ℝ, v x = 0 := by
    intro m v u hm hv hu htop hbot
    obtain ⟨P, hP⟩ : ∃ P : ℝ → ℝ, ∀ x : ℝ, HasDerivAt P (m x) x :=
      ⟨fun x => ∫ t in (0 : ℝ)..x, m t, fun x => (hm.integral_hasStrictDerivAt 0 x).hasDerivAt⟩
    have hΦ : ∀ x : ℝ, HasDerivAt (fun y => u y * Real.exp (-P y)) 0 x := by
      intro x
      have := (hu x).mul ((hP x).neg.exp)
      convert this using 1
      ring
    have hconst : ∀ x : ℝ, u x * Real.exp (-P x) = u 0 * Real.exp (-P 0) := by
      intro x
      exact is_const_of_deriv_eq_zero (fun y => (hΦ y).differentiableAt)
        (fun y => (hΦ y).deriv) x 0
    obtain ⟨c, hc⟩ : ∃ c : ℝ, c = u 0 * Real.exp (-P 0) := ⟨_, rfl⟩
    have hu_eq : ∀ x : ℝ, u x = c * Real.exp (P x) := by
      intro x
      have h1 := hconst x
      have h2 : Real.exp (-P x) * Real.exp (P x) = 1 := by
        rw [← Real.exp_add]; simp
      calc u x = u x * Real.exp (-P x) * Real.exp (P x) := by rw [mul_assoc, h2, mul_one]
        _ = c * Real.exp (P x) := by rw [h1, hc]
    intro x
    rcases le_total 0 c with hc0 | hc0
    · have hmono : Monotone v := monotone_of_deriv_nonneg (fun y => (hv y).differentiableAt)
        (fun y => by rw [(hv y).deriv, hu_eq y]; exact mul_nonneg hc0 (Real.exp_pos _).le)
      have h1 := hmono.ge_of_tendsto htop x
      have h2 := hmono.le_of_tendsto hbot x
      linarith
    · have hanti : Antitone v := antitone_of_deriv_nonpos (fun y => (hv y).differentiableAt)
        (fun y => by
          rw [(hv y).deriv, hu_eq y]
          exact mul_nonpos_of_nonpos_of_nonneg hc0 (Real.exp_pos _).le)
      have h1 := hanti.le_of_tendsto htop x
      have h2 := hanti.ge_of_tendsto hbot x
      linarith
  
  have hlink : ∀ (q γ : 𝓢(ℝ, ℝ)) (ρ : ℝ → ℝ), GreenODE κ q γ → IsRiccatiSol κ q ρ →
      ∀ x : ℝ, deriv (⇑γ) x = 2 * (ρ x - κ) * γ x + ρ x / κ := by
    intro q γ ρ hγ hρ
    obtain ⟨hρc, -, hρtop, hρbot, hρd⟩ := riccati_sol_regularity κ hκ0 q ρ hρ
    have hdγ : deriv (⇑γ) = ⇑(SchwartzMap.derivCLM ℝ ℝ γ) :=
      funext fun x => (SchwartzMap.derivCLM_apply ℝ γ x).symm
    have hγ3 := hred q γ hγ
    have hdDγ : deriv (⇑(SchwartzMap.derivCLM ℝ ℝ γ)) =
        ⇑(SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ)) :=
      funext fun x => (SchwartzMap.derivCLM_apply ℝ _ x).symm
    have e2 : iteratedDeriv 2 (⇑γ) =
        ⇑(SchwartzMap.derivCLM ℝ ℝ (SchwartzMap.derivCLM ℝ ℝ γ)) := by
      rw [iteratedDeriv_succ, iteratedDeriv_one, hdγ, hdDγ]
    have e3 : iteratedDeriv 3 (⇑γ) = deriv (iteratedDeriv 2 (⇑γ)) := iteratedDeriv_succ
    
    have hf : ∀ x : ℝ,
        HasDerivAt (fun y => deriv (⇑γ) y - 2 * (ρ y - κ) * γ y - ρ y / κ)
          (iteratedDeriv 2 (⇑γ) x - 2 * (q x + 2 * κ * ρ x - ρ x ^ 2) * γ x
            - 2 * (ρ x - κ) * deriv (⇑γ) x - (q x + 2 * κ * ρ x - ρ x ^ 2) / κ) x ∧
        HasDerivAt (fun y => iteratedDeriv 2 (⇑γ) y - 2 * (q y + 2 * κ * ρ y - ρ y ^ 2) * γ y
            - 2 * (ρ y - κ) * deriv (⇑γ) y - (q y + 2 * κ * ρ y - ρ y ^ 2) / κ)
          (-2 * (ρ x - κ) * (iteratedDeriv 2 (⇑γ) x - 2 * (q x + 2 * κ * ρ x - ρ x ^ 2) * γ x
            - 2 * (ρ x - κ) * deriv (⇑γ) x - (q x + 2 * κ * ρ x - ρ x ^ 2) / κ)) x := by
      intro x
      have hγ1 : HasDerivAt (⇑γ) (deriv (⇑γ) x) x := (γ.differentiableAt (x := x)).hasDerivAt
      have hγ2 : HasDerivAt (deriv (⇑γ)) (iteratedDeriv 2 (⇑γ) x) x := by
        rw [e2, hdγ]
