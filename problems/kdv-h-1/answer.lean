    field_simp
  rw [L1, L2, L3]

theorem riccatiK_sq_integral (κ : ℝ) (hκ : 0 < κ) (q : 𝓢(ℝ, ℝ)) :
    MemLp (riccatiK κ q) 2 (volume : Measure ℝ) ∧
    ∫ x : ℝ, riccatiK κ q x ^ 2 =
      ∫ ξ : ℝ, ((4 + ξ ^ 2) / (ξ ^ 2 + 4 * κ ^ 2)) * ‖(toHm1 q : ℝ → ℂ) ξ‖ ^ 2 :=
by
  obtain ⟨hgi, hgb⟩ : Integrable (riccatiK κ q) (volume : Measure ℝ) ∧
      ∀ x : ℝ, |riccatiK κ q x| ≤ ∫ y : ℝ, |q y| := by
    obtain ⟨k, hk⟩ : ∃ k : ℝ → ℝ,
        k = (Set.Iic (0 : ℝ)).indicator (fun t => Real.exp (2 * κ * t)) := ⟨_, rfl⟩
    have hki : Integrable k (volume : Measure ℝ) := by
      rw [hk, integrable_indicator_iff measurableSet_Iic]
      exact integrableOn_exp_mul_Iic (by positivity) 0
    have hk01 : ∀ s : ℝ, 0 ≤ k s ∧ k s ≤ 1 := by
      intro s
      rw [hk]
      by_cases hs : s ∈ Set.Iic (0 : ℝ)
      · rw [Set.indicator_of_mem hs]
        refine ⟨(Real.exp_pos _).le, Real.exp_le_one_iff.2 ?_⟩
        have : s ≤ 0 := hs
        nlinarith
      · rw [Set.indicator_of_notMem hs]
        norm_num
    have hrepr : ∀ x : ℝ, riccatiK κ q x = -∫ t : ℝ, q t * k (x - t) := by
      intro x
      unfold riccatiK
      congr 1
      rw [← integral_indicator measurableSet_Ici]
      congr 1
      funext t
      rw [hk]
      by_cases ht : x ≤ t
      · rw [Set.indicator_of_mem (show t ∈ Set.Ici x from ht),
          Set.indicator_of_mem (show x - t ∈ Set.Iic (0 : ℝ) from Set.mem_Iic.2 (by linarith))]
        ring
      · rw [Set.indicator_of_notMem (show t ∉ Set.Ici x from ht),
          Set.indicator_of_notMem (show x - t ∉ Set.Iic (0 : ℝ) from
            fun h => ht (by have := Set.mem_Iic.1 h; linarith))]
        ring
    have hconv : Integrable (fun x : ℝ => ∫ t : ℝ, q t * k (x - t)) (volume : Measure ℝ) := by
      have := (q.integrable (μ := volume)).integrable_convolution
        (ContinuousLinearMap.mul ℝ ℝ) hki
      refine this.congr (ae_of_all _ fun x => ?_)
      simp [convolution_def]
    refine ⟨?_, fun x => ?_⟩
    · have he : riccatiK κ q = fun x : ℝ => -∫ t : ℝ, q t * k (x - t) := funext hrepr
      rw [he]
      exact hconv.neg
    · rw [hrepr x, abs_neg, ← Real.norm_eq_abs]
      refine norm_integral_le_of_norm_le (q.integrable (μ := volume)).abs
        (ae_of_all _ fun t => ?_)
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hk01 _).1]
      exact mul_le_of_le_one_right (abs_nonneg _) (hk01 _).2
  have hd : ∀ x₀ : ℝ, HasDerivAt (riccatiK κ q) (2 * κ * riccatiK κ q x₀ + q x₀) x₀ := by
    intro x₀
    obtain ⟨h, hh⟩ : ∃ h : ℝ → ℝ, h = fun y => Real.exp (-2 * κ * y) * q y := ⟨_, rfl⟩
    have hcont : Continuous h := by
      rw [hh]
      exact (Real.continuous_exp.comp (continuous_const.mul continuous_id)).mul q.continuous
    have hint : ∀ a : ℝ, IntegrableOn h (Set.Ioi a) := by
      intro a
      refine Integrable.mono'
        ((q.integrable (μ := volume)).norm.const_mul (Real.exp (-2 * κ * a))).integrableOn
        hcont.aestronglyMeasurable ?_
      refine ae_restrict_of_forall_mem measurableSet_Ioi fun y hy => ?_
      rw [hh]
      simp only
      rw [norm_mul, Real.norm_of_nonneg (Real.exp_pos _).le]
      apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
      apply Real.exp_le_exp.2
      have : a < y := hy
      nlinarith
    obtain ⟨A, hA⟩ : ∃ A : ℝ, A = ∫ y in Set.Ioi (x₀ - 1), h y := ⟨_, rfl⟩
    have hrep : ∀ x ∈ Set.Ioi (x₀ - 1),
        riccatiK κ q x = -(Real.exp (2 * κ * x) * (A - ∫ y in (x₀ - 1)..x, h y)) := by
      intro x hx
      have hx' : x₀ - 1 < x := hx
      have hsplit : A = (∫ y in (x₀ - 1)..x, h y) + ∫ y in Set.Ioi x, h y := by
        rw [intervalIntegral.integral_of_le hx'.le, ← setIntegral_union Set.Ioc_disjoint_Ioi_same
          measurableSet_Ioi ((hint (x₀ - 1)).mono_set Set.Ioc_subset_Ioi_self) (hint x),
          Set.Ioc_union_Ioi_eq_Ioi hx'.le, hA]
      have hK : riccatiK κ q x = -(Real.exp (2 * κ * x) * ∫ y in Set.Ioi x, h y) := by
        unfold riccatiK
        rw [integral_Ici_eq_integral_Ioi, ← integral_const_mul]
        congr 1
        refine setIntegral_congr_fun measurableSet_Ioi fun y _ => ?_
        rw [hh]
        simp only
        rw [← mul_assoc, ← Real.exp_add]
        congr 2
        ring
      rw [hK, hsplit]
      ring
    have hJ : HasDerivAt (fun x => ∫ y in (x₀ - 1)..x, h y) (h x₀) x₀ :=
      intervalIntegral.integral_hasDerivAt_right (hcont.intervalIntegrable _ _)
        (hcont.stronglyMeasurableAtFilter _ _) hcont.continuousAt
    have hE : HasDerivAt (fun x => Real.exp (2 * κ * x)) (Real.exp (2 * κ * x₀) * (2 * κ)) x₀ := by
      have := ((hasDerivAt_id x₀).const_mul (2 * κ)).exp
      simpa using this
    have hP : HasDerivAt (fun x => -(Real.exp (2 * κ * x) * (A - ∫ y in (x₀ - 1)..x, h y)))
        (-(Real.exp (2 * κ * x₀) * (2 * κ) * (A - ∫ y in (x₀ - 1)..x₀, h y) +
          Real.exp (2 * κ * x₀) * (0 - h x₀))) x₀ :=
      (hE.mul ((hasDerivAt_const x₀ A).sub hJ)).neg
    have hev : riccatiK κ q =ᶠ[nhds x₀]
        fun x => -(Real.exp (2 * κ * x) * (A - ∫ y in (x₀ - 1)..x, h y)) :=
      Filter.eventually_of_mem (Ioi_mem_nhds (by linarith : x₀ - 1 < x₀)) hrep
    have hval : -(Real.exp (2 * κ * x₀) * (2 * κ) * (A - ∫ y in (x₀ - 1)..x₀, h y) +
          Real.exp (2 * κ * x₀) * (0 - h x₀)) = 2 * κ * riccatiK κ q x₀ + q x₀ := by
      rw [hrep x₀ (show x₀ - 1 < x₀ by linarith), hh]
      simp only
      have hEE : Real.exp (2 * κ * x₀) * Real.exp (-2 * κ * x₀) = 1 := by
        rw [← Real.exp_add]
        ring_nf
        exact Real.exp_zero
      linear_combination (q x₀) * hEE
    have hfin := hP.congr_of_eventuallyEq hev
    rw [hval] at hfin
    exact hfin
  have hgc : Continuous (riccatiK κ q) :=
