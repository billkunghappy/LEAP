    simp only [Pi.add_apply]
    field_simp
    ring
  
  
  
  have riccati_response_eq (κ : ℝ) (hκ : 1 ≤ κ) (q f y : 𝓢(ℝ, ℝ)) (w z : ℝ → ℝ)
      (hw : IsRiccatiSol κ q w)
      (hy : ∀ x : ℝ, HasDerivAt (y : ℝ → ℝ) (2 * κ * y x + f x - 2 * w x * y x) x)
      (hz2 : MemLp z 2 (volume : Measure ℝ))
