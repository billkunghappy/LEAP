    have hB1 := bndx n h
    have hB2 := bnd2 n h
    have hD : 0 < (2 * π * n) ^ 2 + 4 * K ^ 2 := by nlinarith [sq_nonneg (2 * π * (n : ℝ))]
    have hw0 : 0 ≤ (4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * K ^ 2) := by positivity
    rcases le_or_gt ((2 * π * (n : ℝ)) ^ 2) (K ^ 2) with hc | hc
    · have h1 : ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 ≤
          (2 * π * n * h) ^ 2 := by
        have := pow_le_pow_left₀ hA0 hB1 2
        rwa [sq_abs] at this
      have h2 : (2 * π * n * h) ^ 2 ≤ K ^ 2 * h ^ 2 := by
        rw [mul_pow]; exact mul_le_mul_of_nonneg_right hc (sq_nonneg h)
      linarith
    · have hw : 1 / 5 ≤ (4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * K ^ 2) := by
        rw [le_div_iff₀ hD]; nlinarith
      have h1 : ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 ≤ 4 := by
        nlinarith
      nlinarith [sq_nonneg (K * h)]
  
  have s3 : ∀ h : ℝ, Continuous fun f : lp (fun _ : ℤ => ℂ) 2 => translateDiffSqT f h := by
    intro h
    have ha2 : ∀ n : ℤ, ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 ≤ 4 := by
      intro n
      nlinarith [bnd2 n h, norm_nonneg (Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1)]
    have hsum : ∀ u : lp (fun _ : ℤ => ℂ) 2,
        Summable (fun n : ℤ => ‖(Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1) * u n‖ ^ 2) := by
      intro u
      refine Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_)
        ((s1 u).summable.mul_left 4)
      rw [norm_mul, mul_pow]
      exact mul_le_mul_of_nonneg_right (ha2 n) (sq_nonneg _)
    have hmem : ∀ u : lp (fun _ : ℤ => ℂ) 2,
        Memℓp (fun n : ℤ => (Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1) * u n) 2 := by
      intro u
      apply memℓp_gen
      simpa [Real.rpow_two] using hsum u
    let M : lp (fun _ : ℤ => ℂ) 2 → lp (fun _ : ℤ => ℂ) 2 := fun u =>
      ⟨fun n : ℤ => (Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1) * u n, hmem u⟩
    have hMapp : ∀ u n, (M u) n = (Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1) * u n :=
      fun u n => rfl
    have hid : ∀ u, translateDiffSqT u h = ‖M u‖ ^ 2 := by
      intro u
      rw [← (s1 (M u)).tsum_eq]
      rfl
    have hsubM : ∀ u v, M u - M v = M (u - v) := by
      intro u v
      apply lp.ext
      funext n
      simp only [lp.coeFn_sub, Pi.sub_apply, hMapp, mul_sub]
    have hbd : ∀ u, ‖M u‖ ≤ 2 * ‖u‖ := by
      intro u
      have h1 : ‖M u‖ ^ 2 ≤ (2 * ‖u‖) ^ 2 := by
        rw [← (s1 (M u)).tsum_eq, mul_pow, ← (s1 u).tsum_eq, ← tsum_mul_left]
        refine Summable.tsum_le_tsum (fun n => ?_) (s1 (M u)).summable
          ((s1 u).summable.mul_left _)
        rw [hMapp, norm_mul, mul_pow]
        have : ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 ≤ 2 ^ 2 := by
          have := ha2 n; linarith [show (2 : ℝ) ^ 2 = 4 by norm_num]
        exact mul_le_mul_of_nonneg_right this (sq_nonneg _)
      exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).1 h1
    have hLip : LipschitzWith 2 M := by
      refine LipschitzWith.of_dist_le_mul fun u v => ?_
      rw [dist_eq_norm, dist_eq_norm, hsubM]
      push_cast
      exact hbd _
    have hfun : (fun f : lp (fun _ : ℤ => ℂ) 2 => translateDiffSqT f h) =
        fun f => ‖M f‖ ^ 2 := funext hid
    rw [hfun]
    exact (continuous_norm.comp hLip.continuous).pow 2
  
  refine ⟨fun f K hK h => ?_, s3⟩
  have hb := s1 f
  have hw01 : ∀ n : ℤ, 0 ≤ (4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * K ^ 2) ∧
      (4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * K ^ 2) ≤ 1 := by
    intro n
    have hD : 0 < (2 * π * n) ^ 2 + 4 * K ^ 2 := by nlinarith [sq_nonneg (2 * π * (n : ℝ))]
    constructor
    · positivity
    · rw [div_le_one hD]; nlinarith
  have hwb : Summable fun n : ℤ =>
      ((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * ‖f n‖ ^ 2 :=
    Summable.of_nonneg_of_le (fun n => mul_nonneg (hw01 n).1 (sq_nonneg _))
      (fun n => mul_le_of_le_one_left (sq_nonneg _) (hw01 n).2) hb.summable
  have hr : Summable fun n : ℤ => K ^ 2 * h ^ 2 * ‖f n‖ ^ 2 +
      20 * (((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * ‖f n‖ ^ 2) :=
    (hb.summable.mul_left _).add (hwb.mul_left 20)
  have hterm : ∀ n : ℤ,
      ‖(Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1) * f n‖ ^ 2 ≤
        K ^ 2 * h ^ 2 * ‖f n‖ ^ 2 +
          20 * (((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * ‖f n‖ ^ 2) := by
    intro n
    rw [norm_mul, mul_pow]
    have := mul_le_mul_of_nonneg_right (s2 n K h hK) (sq_nonneg ‖f n‖)
    linarith
  have hlhs : Summable fun n : ℤ =>
      ‖(Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1) * f n‖ ^ 2 :=
    Summable.of_nonneg_of_le (fun n => sq_nonneg _) hterm hr
  calc translateDiffSqT f h
      = ∑' n : ℤ, ‖(Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1) * f n‖ ^ 2 := rfl
    _ ≤ ∑' n : ℤ, (K ^ 2 * h ^ 2 * ‖f n‖ ^ 2 +
          20 * (((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * ‖f n‖ ^ 2)) :=
        Summable.tsum_le_tsum hterm hlhs hr
    _ = K ^ 2 * h ^ 2 * ‖f‖ ^ 2 +
          20 * ∑' n : ℤ, ((4 + (2 * π * n) ^ 2) / ((2 * π * n) ^ 2 + 4 * K ^ 2)) * ‖f n‖ ^ 2 := by
        rw [Summable.tsum_add (hb.summable.mul_left _) (hwb.mul_left 20), tsum_mul_left,
          tsum_mul_left, hb.tsum_eq]

/-! ## Main theorem, circle case -/

/-- **Killip–Vişan, Theorem 1.1 (circle case).** KdV is globally well-posed in `H⁻¹(ℝ/ℤ)`.
Assume the classical theory for smooth periodic data, which the paper takes for granted:
global existence `h_exists` and uniqueness `h_unique` of smooth solutions. Then the solution
map extends uniquely from `C^∞(ℝ/ℤ)` to a jointly continuous map
`Φ : ℝ × H⁻¹(ℝ/ℤ) → H⁻¹(ℝ/ℤ)`. Moreover, for each `q ∈ H⁻¹(ℝ/ℤ)` the orbit
`{Φ(t, q) : t ∈ ℝ}` is uniformly bounded and equicontinuous in `H⁻¹(ℝ/ℤ)`. -/
theorem kdv_well_posed_H_minus_one_torus
    (h_exists : ∀ q : CinfT, ∃ u : ℝ → CinfT, IsSmoothSolutionT u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → CinfT,
      IsSmoothSolutionT u → IsSmoothSolutionT v → u 0 = v 0 → u = v) :
    ∃ Φ : ℝ × Hm1T → Hm1T,
      Continuous Φ ∧ ExtendsSmoothFlowT Φ ∧
      (∀ Ψ : ℝ × Hm1T → Hm1T, Continuous Ψ → ExtendsSmoothFlowT Ψ → Ψ = Φ) ∧
      (∀ q : Hm1T, Bornology.IsBounded (Set.range fun t : ℝ => Φ (t, q))) ∧
      (∀ q : Hm1T, EquicontinuousHm1T (Set.range fun t : ℝ => Φ (t, q))) :=
by
  classical
  
  have H11 := kdv_orbit_control_T h_exists h_unique
  have H12 := kdv_Hm1T_uniform_cauchy h_exists h_unique
  obtain ⟨hlin, hbd⟩ := toHm1T_basic
  choose sol hsol hsol0 using h_exists
  
  have hcomb : ∀ (a b : CinfT) (c₁ c₂ : ℝ), ∃ r : CinfT,
      ∀ x, (r : ℝ → ℝ) x = c₁ * (a : ℝ → ℝ) x + c₂ * (b : ℝ → ℝ) x := by
    intro a b c₁ c₂
    refine ⟨⟨fun x => c₁ * (a : ℝ → ℝ) x + c₂ * (b : ℝ → ℝ) x, ?_, ?_⟩, fun x => rfl⟩
    · exact (contDiff_const.mul a.2.1).add (contDiff_const.mul b.2.1)
    · intro x
      simp only [a.2.2 x, b.2.2 x]
  have hcombT : ∀ (a b : CinfT) (c₁ c₂ : ℝ), ∃ r : CinfT,
      toHm1T r = c₁ • toHm1T a + c₂ • toHm1T b := by
    intro a b c₁ c₂
    obtain ⟨r, hr⟩ := hcomb a b c₁ c₂
    exact ⟨r, hlin a b r c₁ c₂ hr⟩
  let z : CinfT := ⟨fun _ => 0, contDiff_const, fun _ => rfl⟩
  let P : Submodule ℝ (lp (fun _ : ℤ => ℂ) 2) :=
    { carrier := Set.range toHm1T
      add_mem' := by
        rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
        obtain ⟨r, hr⟩ := hcombT a b 1 1
        exact ⟨r, by rw [hr, one_smul, one_smul]⟩
      zero_mem' := by
        obtain ⟨r, hr⟩ := hcombT z z 0 0
        exact ⟨r, by rw [hr, zero_smul, add_zero]⟩
      smul_mem' := by
        rintro c _ ⟨a, rfl⟩
        obtain ⟨r, hr⟩ := hcombT a a c 0
        exact ⟨r, by rw [hr, zero_smul, add_zero]⟩ }
  have hspan : Submodule.span ℝ (Set.range toHm1T) = P := Submodule.span_eq P
  haveI : CompleteSpace Hm1T := by
    show CompleteSpace (Submodule.span ℝ (Set.range toHm1T)).topologicalClosure
    infer_instance
  have hseq : ∀ x : Hm1T, ∃ a : ℕ → CinfT,
      Filter.Tendsto (fun n => ιT (a n)) Filter.atTop (nhds x) := by
    intro x
    have hmem : (x : lp (fun _ : ℤ => ℂ) 2) ∈
        (Submodule.span ℝ (Set.range toHm1T)).topologicalClosure := x.2
    rw [← SetLike.mem_coe, Submodule.topologicalClosure_coe, hspan] at hmem
    obtain ⟨b, hb, hbt⟩ := mem_closure_iff_seq_limit.1 hmem
    have hb' : ∀ n, ∃ c : CinfT, toHm1T c = b n := fun n => hb n
    choose a ha using hb'
    refine ⟨a, tendsto_subtype_rng.2 ?_⟩
    have hab : (fun n => ((ιT (a n) : Hm1T) : lp (fun _ : ℤ => ℂ) 2)) = b :=
      funext fun n => ha n
    rw [hab]
    exact hbt
  have hdense : DenseRange ιT := by
    intro x
    obtain ⟨a, ha⟩ := hseq x
    exact mem_closure_of_tendsto ha (Filter.Eventually.of_forall fun n => ⟨a n, rfl⟩)
  
  have hF_cont : ∀ a : CinfT, Continuous fun t : ℝ => ιT (sol a t) := by
    intro a
    have hU : Continuous fun p : ℝ × ℝ => (sol a p.1 : ℝ → ℝ) p.2 := (hsol a).1.continuous
    have hper : ∀ t x : ℝ, (fun p : ℝ × ℝ => (sol a p.1 : ℝ → ℝ) p.2) (t, x + 1) =
        (fun p : ℝ × ℝ => (sol a p.1 : ℝ → ℝ) p.2) (t, x) := fun t x => (sol a t).2.2 x
    rw [Metric.continuous_iff]
    intro t₀ ε hε
    obtain ⟨η, hη, hU'⟩ := periodic_uniform_continuity _ hU hper t₀ (ε / 2) (by linarith)
    refine ⟨η, hη, fun t ht => ?_⟩
    rw [Real.dist_eq] at ht
    obtain ⟨r, hr⟩ := hcomb (sol a t) (sol a t₀) 1 (-1)
    have h1 : toHm1T r = toHm1T (sol a t) - toHm1T (sol a t₀) := by
      rw [hlin _ _ r 1 (-1) hr, one_smul, neg_one_smul, sub_eq_add_neg]
    have h2 : ‖toHm1T r‖ ≤ ε / 2 := by
      refine hbd r (ε / 2) (fun x => ?_)
      have h3 := hU' t ht x
      simp only at h3
      rw [hr x]
      have e : 1 * (sol a t : ℝ → ℝ) x + -1 * (sol a t₀ : ℝ → ℝ) x =
          (sol a t : ℝ → ℝ) x - (sol a t₀ : ℝ → ℝ) x := by ring
      rw [e]
      exact h3.le
    show dist (toHm1T (sol a t)) (toHm1T (sol a t₀)) < ε
    rw [dist_eq_norm, ← h1]
    linarith
  have hF_cauchy : ∀ a : ℕ → CinfT, CauchySeq (fun n => ιT (a n)) →
      ∀ T > (0 : ℝ), ∀ ε > (0 : ℝ), ∃ N : ℕ, ∀ m ≥ N, ∀ n ≥ N, ∀ t : ℝ, |t| ≤ T →
        dist (ιT (sol (a m) t)) (ιT (sol (a n) t)) < ε := by
    intro a ha
    have ha' : CauchySeq (fun n => ιT (sol (a n) 0)) := by
      simpa only [hsol0] using ha
    exact H12 (fun n => sol (a n)) (fun n => hsol (a n)) ha'
  obtain ⟨Φ, hΦc, hΦe, hΦlim⟩ :=
    dense_extension_of_uniform_cauchy ιT hdense (fun t a => ιT (sol a t)) hF_cont hF_cauchy
  have hΦe' : ∀ (t : ℝ) (a : CinfT), Φ (t, ιT a) = ιT (sol a t) := hΦe
  have hΦlim' : ∀ (x : Hm1T) (a : ℕ → CinfT),
      Filter.Tendsto (fun n => ιT (a n)) Filter.atTop (nhds x) →
        ∀ t : ℝ, Filter.Tendsto (fun n => ιT (sol (a n) t)) Filter.atTop (nhds (Φ (t, x))) :=
    hΦlim
  have horbit : ∀ x : Hm1T, ∃ a : ℕ → CinfT,
      Filter.Tendsto (fun n => ιT (a n)) Filter.atTop (nhds x) ∧
      ∃ C ≥ (0 : ℝ), ∃ κ₀ ≥ (1 : ℝ), ∀ (n : ℕ) (t : ℝ),
        ‖ιT (sol (a n) t)‖ ≤ C ∧ ∀ κ ≥ κ₀,
          (∑' m : ℤ, ((4 + (2 * π * m) ^ 2) / ((2 * π * m) ^ 2 + 4 * κ ^ 2)) *
              ‖((ιT (sol (a n) t) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) m‖ ^ 2) ≤
            C * ∑' m : ℤ, ((4 + (2 * π * m) ^ 2) / ((2 * π * m) ^ 2 + 4 * κ ^ 2)) *
              ‖((ιT (a n) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) m‖ ^ 2 := by
    intro x
    obtain ⟨a, ha⟩ := hseq x
    obtain ⟨R, hR⟩ := isBounded_iff_forall_norm_le.1 (Metric.isBounded_range_of_tendsto _ ha)
    obtain ⟨C, hC0, κ₀, hκ₀, hctrl⟩ := H11 (max R 0) (le_max_right _ _)
    refine ⟨a, ha, C, hC0, κ₀, hκ₀, fun n t => ?_⟩
    have h0 : ‖ιT (sol (a n) 0)‖ ≤ max R 0 := by
      rw [hsol0]
      exact le_trans (hR _ ⟨n, rfl⟩) (le_max_left _ _)
    have hc := hctrl (sol (a n)) (hsol _) h0 t
    rw [hsol0] at hc
    exact hc
  refine ⟨Φ, hΦc, ?_, ?_, ?_, ?_⟩
  · intro u hu t
    have heq : sol (u 0) = u := h_unique _ _ (hsol (u 0)) hu (hsol0 (u 0))
    rw [hΦe', heq]
  · intro Ψ hΨc hΨe
    have hagree : ∀ (t : ℝ) (a : CinfT), Ψ (t, ιT a) = Φ (t, ιT a) := by
      intro t a
      have h1 := hΨe (sol a) (hsol a) t
      rw [hsol0] at h1
      rw [h1, hΦe']
    have hd : DenseRange (Prod.map id ιT : ℝ × CinfT → ℝ × Hm1T) :=
      DenseRange.prodMap denseRange_id hdense
    refine Continuous.ext_on hd hΨc hΦc ?_
    rintro _ ⟨⟨t, a⟩, rfl⟩
    exact hagree t a
  · intro x
    obtain ⟨a, ha, C, hC0, κ₀, hκ₀, hctrl⟩ := horbit x
    have hbd' : ∀ t : ℝ, ‖Φ (t, x)‖ ≤ C := by
      intro t
      refine le_of_tendsto' ((continuous_norm.tendsto _).comp (hΦlim' x a ha t)) ?_
      intro n
      exact (hctrl n t).1
    exact isBounded_iff_forall_norm_le.2 ⟨C, by rintro _ ⟨t, rfl⟩; exact hbd' t⟩
  · intro x ε hε
    obtain ⟨a, ha, C, hC0, κ₀, hκ₀, hctrl⟩ := horbit x
    have hf : Filter.Tendsto (fun n => ((ιT (a n) : Hm1T) : lp (fun _ : ℤ => ℂ) 2))
        Filter.atTop (nhds (x : lp (fun _ : ℤ => ℂ) 2)) := tendsto_subtype_rng.1 ha
    have hC1 : 0 < C + 1 := by linarith
    have hη : 0 < ε / (80 * (C + 1)) := by positivity
    obtain ⟨K₁, hK₁, hW⟩ := Hm1T_weight_uniform_decay _ _ hf (ε / (80 * (C + 1))) hη
    obtain ⟨K, hKK₁, hKκ⟩ : ∃ K : ℝ, K₁ ≤ K ∧ κ₀ ≤ K :=
      ⟨max K₁ κ₀, le_max_left _ _, le_max_right _ _⟩
    have hK1 : 1 ≤ K := le_trans hK₁ hKK₁
    have hD : 0 < K * (C + 1) := mul_pos (by linarith) hC1
    obtain ⟨δ, hδ, hδsq⟩ : ∃ δ > (0 : ℝ), δ ^ 2 * (K * (C + 1)) ^ 2 = ε / 4 := by
      refine ⟨Real.sqrt (ε / 4) / (K * (C + 1)),
        div_pos (Real.sqrt_pos.2 (by positivity)) hD, ?_⟩
      rw [div_pow, Real.sq_sqrt (by positivity), div_mul_cancel₀ _ (pow_pos hD 2).ne']
    refine ⟨δ, hδ, ?_⟩
    rintro _ ⟨t, rfl⟩ h hh
    show translateDiffSqT ((Φ (t, x) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) h < ε
    have hh2 : h ^ 2 < δ ^ 2 := by
      have := abs_lt.1 hh
      exact sq_lt_sq' this.1 this.2
    have hCη : C * (ε / (80 * (C + 1))) ≤ ε / 80 := by
      rw [mul_div_assoc', div_le_div_iff₀ (by positivity) (by norm_num)]
      nlinarith
    have hn : ∀ n : ℕ,
        translateDiffSqT ((ιT (sol (a n) t) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) h ≤ ε / 2 := by
      intro n
      have hT := translateDiffSqT_bounds.1
        ((ιT (sol (a n) t) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) K hK1 h
      have hgC : ‖((ιT (sol (a n) t) : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ≤ C :=
        (hctrl n t).1
      have hWg := (hctrl n t).2 K hKκ
      have hWf : (∑' m : ℤ, ((4 + (2 * π * m) ^ 2) / ((2 * π * m) ^ 2 + 4 * K ^ 2)) *
          ‖((ιT (a n) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) m‖ ^ 2) <
            ε / (80 * (C + 1)) := hW K hKK₁ n
      have hg2 : ‖((ιT (sol (a n) t) : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ^ 2 ≤ (C + 1) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) (by linarith) 2
      have e1 : K ^ 2 * h ^ 2 *
          ‖((ιT (sol (a n) t) : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ^ 2 ≤ ε / 4 := by
        calc K ^ 2 * h ^ 2 * ‖((ιT (sol (a n) t) : Hm1T) : lp (fun _ : ℤ => ℂ) 2)‖ ^ 2
            ≤ K ^ 2 * h ^ 2 * (C + 1) ^ 2 :=
              mul_le_mul_of_nonneg_left hg2 (by positivity)
          _ = h ^ 2 * (K * (C + 1)) ^ 2 := by ring
          _ ≤ δ ^ 2 * (K * (C + 1)) ^ 2 :=
              mul_le_mul_of_nonneg_right hh2.le (by positivity)
          _ = ε / 4 := hδsq
      have e2 := mul_le_mul_of_nonneg_left hWf.le hC0
      linarith
    have hlim : Filter.Tendsto
        (fun n => translateDiffSqT ((ιT (sol (a n) t) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) h)
        Filter.atTop
        (nhds (translateDiffSqT ((Φ (t, x) : Hm1T) : lp (fun _ : ℤ => ℂ) 2) h)) :=
      ((translateDiffSqT_bounds.2 h).tendsto _).comp (tendsto_subtype_rng.1 (hΦlim' x a ha t))
    have hle := le_of_tendsto' hlim hn
    linarith

/-! # Part C. The combined theorem: data in `H⁻¹(ℝ)` or in `H⁻¹(ℝ/ℤ)` -/

/-- The two geometries of Theorem 1.1: the line `ℝ` (phase space `H⁻¹(ℝ)`, smooth data
`𝓢(ℝ, ℝ)`) and the circle `ℝ/ℤ` (phase space `H⁻¹(ℝ/ℤ)`, smooth data `C^∞(ℝ/ℤ)`). -/
inductive KdVDomain
  /-- The line `ℝ`; initial data in `H⁻¹(ℝ)`. -/
  | line
  /-- The circle `ℝ/ℤ`; initial data in `H⁻¹(ℝ/ℤ)`. -/
  | circle

/-- **Killip–Vişan, Theorem 1.1.** KdV is globally well-posed in `H⁻¹`, where the initial data
lies **either in `H⁻¹(ℝ)` (`D = .line`) or in `H⁻¹(ℝ/ℤ)` (`D = .circle`)**.

In either case, assume the classical theory for smooth data, which the paper takes for granted:
global existence `h_exists` and uniqueness `h_unique` of smooth (Schwartz, resp. `C^∞(ℝ/ℤ)`)
solutions. Then the solution map extends uniquely from smooth data to a jointly continuous map
`Φ : ℝ × H⁻¹ → H⁻¹`, and for each `q ∈ H⁻¹` the orbit `{Φ(t, q) : t ∈ ℝ}` is uniformly bounded
and equicontinuous in `H⁻¹`. -/
theorem kdv_well_posed_H_minus_one_line_or_circle (D : KdVDomain) :
    match D with
    | .line =>
      ∀ (_h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
        (_h_unique : ∀ u v : ℝ → 𝓢(ℝ, ℝ),
          IsSchwartzSolution u → IsSchwartzSolution v → u 0 = v 0 → u = v),
        ∃ Φ : ℝ × Hm1 → Hm1,
          Continuous Φ ∧ ExtendsSchwartzFlow Φ ∧
          (∀ Ψ : ℝ × Hm1 → Hm1, Continuous Ψ → ExtendsSchwartzFlow Ψ → Ψ = Φ) ∧
          (∀ q : Hm1, Bornology.IsBounded (Set.range fun t : ℝ => Φ (t, q))) ∧
          (∀ q : Hm1, EquicontinuousHm1 (Set.range fun t : ℝ => Φ (t, q)))
    | .circle =>
      ∀ (_h_exists : ∀ q : CinfT, ∃ u : ℝ → CinfT, IsSmoothSolutionT u ∧ u 0 = q)
        (_h_unique : ∀ u v : ℝ → CinfT,
          IsSmoothSolutionT u → IsSmoothSolutionT v → u 0 = v 0 → u = v),
        ∃ Φ : ℝ × Hm1T → Hm1T,
          Continuous Φ ∧ ExtendsSmoothFlowT Φ ∧
          (∀ Ψ : ℝ × Hm1T → Hm1T, Continuous Ψ → ExtendsSmoothFlowT Ψ → Ψ = Φ) ∧
          (∀ q : Hm1T, Bornology.IsBounded (Set.range fun t : ℝ => Φ (t, q))) ∧
          (∀ q : Hm1T, EquicontinuousHm1T (Set.range fun t : ℝ => Φ (t, q))) := by
  cases D with
  | line =>
    intro h_exists h_unique
    exact kdv_well_posed_H_minus_one h_exists h_unique
  | circle =>
    intro h_exists h_unique
    exact kdv_well_posed_H_minus_one_torus h_exists h_unique

end KdV
