theorem hm1T_transport_gronwall_inhom : ∀ (d e : ℝ → CinfT) (a L β T : ℝ), 0 ≤ L → 0 ≤ β → ContDiff ℝ 2 (fun p : ℝ × ℝ => (d p.1 : ℝ → ℝ) p.2) → (∀ t x : ℝ, HasDerivAt (fun s : ℝ => (d s : ℝ → ℝ) x) (deriv (e t : ℝ → ℝ) x + a * deriv (d t : ℝ → ℝ) x) t) → (∀ t : ℝ, |t| ≤ T → (∫ x in (0:ℝ)..1, (e t : ℝ → ℝ) x ^ 2) ≤ (L * ‖ιT (d t)‖ + β) ^ 2) → ∀ t : ℝ, |t| ≤ T → ‖ιT (d t)‖ ≤ Real.exp ((2 * L + 1) * |t|) * (‖ιT (d 0)‖ + 2 * β * (1 + |t|)) :=
