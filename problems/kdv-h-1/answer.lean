    calc _ ≤ ‖Complex.exp (I * ((2 * π * n * h : ℝ) : ℂ))‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
      _ = 2 := by rw [Complex.norm_exp_I_mul_ofReal, norm_one]; norm_num
