            ‖((ι (u 0) : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 :=
by
  classical
  
  have boot_pos : ∀ (φ α : ℝ → ℝ) (θ : ℝ), Continuous φ → φ 0 < θ →
      (∀ t, φ t ≤ θ → HasDerivAt α 0 t) → (∀ t, φ t ≤ θ → α t = α 0 → φ t < θ) →
