  obtain ⟨L, hL⟩ := toHm1_clm
  refine ⟨1 / 16, by norm_num, 81 / 49, by norm_num, ?_⟩
  intro u hu h0
  
  obtain ⟨φ, hφ⟩ : ∃ φ : ℝ → ℝ, ∀ s, φ s = ‖toHm1 (u s)‖ ^ 2 := ⟨_, fun s => rfl⟩
  obtain ⟨W, hW⟩ : ∃ W : ℝ → ℝ → ℝ, ∀ κ s, W κ s =
      ∫ ξ : ℝ, ((4 + ξ ^ 2) / (ξ ^ 2 + 4 * κ ^ 2)) * ‖(toHm1 (u s) : ℝ → ℂ) ξ‖ ^ 2 :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨A, hA⟩ : ∃ A : ℝ → ℝ → ℝ, ∀ κ s, A κ s = ∫ x : ℝ, riccatiK κ (u s) x ^ 2 :=
    ⟨_, fun _ _ => rfl⟩
  
