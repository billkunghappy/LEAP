      have mE : MemLp (fun y => w₁ y - w₂ y) 2 (volume : Measure ℝ) := h₁.1.sub h₂.1
      have mQ : MemLp (fun y => q₁ y - q₂ y) 2 (volume : Measure ℝ) :=
