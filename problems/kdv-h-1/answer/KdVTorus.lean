  have h_goal2 : ∀ (m : ℕ) (n : ℤ),
      fourierCircle (fun x : ℝ => greenIterKernel κ₀ w0 (m + 2) x x) n =
        (1 / (2 * π) : ℂ) * ∫ ξ : ℝ,
          iterFreqPacketT κ₀ w0 (m + 1) n ξ / ((κ₀ ^ 2 + ξ ^ 2 : ℝ) : ℂ) := by
    intro m n
    obtain ⟨h_wp2_cont, K₂, _hK₂_nn, hK₂_bd⟩ := h_wp (m + 2)
    let G : ℝ → ℝ → ℂ := fun x ξ =>
      Complex.exp (-(((2 * π * n - ξ : ℝ) : ℂ) * (x : ℂ)) * I) *
        iterWavePacket κ₀ w0 (m + 2) x ξ / ((κ₀ ^ 2 + ξ ^ 2 : ℝ) : ℂ)
    have hG_cont : Continuous (Function.uncurry G) := by
      dsimp [Function.uncurry, G]
      refine Continuous.div ?_ ?_ ?_
      · have hc1 : Continuous (fun p : ℝ × ℝ =>
            Complex.exp (-(((2 * π * n - p.2 : ℝ) : ℂ) * (p.1 : ℂ)) * I)) := by
