          have h_c3 : Continuous (fun p : ℝ × ℝ => ((w0 p.1 * freeGreenKernel κ p.1 x : ℝ) : ℂ)) := by
            have h_eq : (fun p : ℝ × ℝ => ((w0 p.1 * freeGreenKernel κ p.1 x : ℝ) : ℂ)) =
