        exact ⟨h_c, le_trans h_b (le_max_left _ _)⟩
      · have hs_succ : |s - s₀| < δ_succ := lt_of_lt_of_le hs (min_le_right _ _)
        obtain ⟨h_c, h_b⟩ := h_succ s hs_succ s' hs' y
        exact ⟨h_c, le_trans h_b (le_max_right _ _)⟩
  
