theorem greenIterKernel_cont_periodic_and_wavePacket_diagT (κ : ℝ) (hκ : 1 ≤ κ) (w : CinfT) :
    (∀ ℓ : ℕ,
      Continuous (fun x : ℝ => greenIterKernel κ (w : ℝ → ℝ) ℓ x x) ∧
