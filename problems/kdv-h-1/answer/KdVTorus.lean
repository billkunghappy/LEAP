      (fun y => by
        dsimp [cΨ1, k2, k0]
        rw [h_per_iter k_fn hk_per 2 y, hw_per y, h_per_iter k_fn hk_per 0 y])
    obtain ⟨BΨ2, hBΨ2, hcΨ2_bd⟩ := h_per_bounded cΨ2
      (continuous_const.mul (h_smooth_iter k_fn hk_cd 1).1.continuous)
      (fun y => by dsimp [cΨ2, k1]; rw [h_per_iter k_fn hk_per 1 y])
    obtain ⟨BΨ3, hBΨ3, hcΨ3_bd⟩ := h_per_bounded cΨ3
      (continuous_const.mul (continuous_const.add (h_smooth_iter k_fn hk_cd 0).1.continuous))
      (fun y => by dsimp [cΨ3, k0]; rw [h_per_iter k_fn hk_per 0 y])
    obtain ⟨BΦ1, hBΦ1, hcΦ1_bd⟩ := h_per_bounded cΦ1
