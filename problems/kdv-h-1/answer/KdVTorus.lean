      Integrable (fun z : ℝ => G' z * w₀ z * freeGreenKernel κ z x₀) volume ∧
      Integrable (fun z : ℝ => G x₀ z * w₀ z * freeGreenDerivY κ z x₀) volume ∧
      HasDerivAt (fun y => -∫ z : ℝ, G y z * w₀ z * freeGreenKernel κ z y)
        (-(∫ z : ℝ, (G' z * w₀ z * freeGreenKernel κ z x₀ +
