    refine ⟨?_, ?_, ?_⟩
    · intro ℓ
      have h_sq : (greenIterKernel κ (w : ℝ → ℝ) ℓ x x) ^ 2 ≤ ((1 / (2 * κ)) * r ^ ℓ) ^ 2 := by
        calc (greenIterKernel κ (w : ℝ → ℝ) ℓ x x) ^ 2
