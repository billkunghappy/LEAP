      hm1NormSqT (fun x => V₂ x + U x * recipGreenFluxInnerT κ₀ κ (w : ℝ → ℝ) x) ≤
        2 * hm1NormSqT V₂ + 2 * hm1NormSqT (fun x => U x * recipGreenFluxInnerT κ₀ κ (w : ℝ → ℝ) x) :=
    h_hm1_add V₂ (fun x => U x * recipGreenFluxInnerT κ₀ κ (w : ℝ → ℝ) x)
      hV₂_cont (hU_cont.mul h_inner_cont)
  have h_flux_le_inner :
      hm1NormSqT (recipGreenFluxT κ₀ κ (w : ℝ → ℝ)) ≤
        12 * κ₀ ^ 5 * hm1NormSqT (recipGreenFluxInnerT κ₀ κ (w : ℝ → ℝ)) := by
    rw [h_flux_eq]
    linarith [hFlux_add_le, hV₂_hm1_le, hUV_hm1_le]
  have h_flux_hm1_le :
      hm1NormSqT (recipGreenFluxT κ₀ κ (w : ℝ → ℝ)) ≤
        3168 * κ₀ ^ 6 * hm1KappaSqT κ (ιT w) + 600 * κ₀ ^ 13 / κ ^ 2 := by
    calc hm1NormSqT (recipGreenFluxT κ₀ κ (w : ℝ → ℝ))
      _ ≤ 12 * κ₀ ^ 5 * hm1NormSqT (recipGreenFluxInnerT κ₀ κ (w : ℝ → ℝ)) := h_flux_le_inner
      _ ≤ 12 * κ₀ ^ 5 * (264 * κ₀ * hm1KappaSqT κ (ιT w) + 50 * κ₀ ^ 8 / κ ^ 2) :=
        mul_le_mul_of_nonneg_left h_inner_hm1_le (by positivity)
      _ = 3168 * κ₀ ^ 6 * hm1KappaSqT κ (ιT w) + 600 * κ₀ ^ 13 / κ ^ 2 := by ring
  have h_hm2_bound :
      hm2NormSqT (deriv (recipGreenFluxT κ₀ κ (w : ℝ → ℝ))) ≤
        3168 * κ₀ ^ 6 * hm1KappaSqT κ (ιT w) + 600 * κ₀ ^ 13 / κ ^ 2 :=
    le_trans h_hm2_le_hm1 h_flux_hm1_le
  set A := Real.sqrt (hm1KappaSqT κ (ιT w))
  have hA_nn : 0 ≤ A := Real.sqrt_nonneg _
  have hA_sq : A ^ 2 = hm1KappaSqT κ (ιT w) := Real.sq_sqrt h_hm1_k_nn
  set K := 1 / κ
  have hK_nn : 0 ≤ K := by positivity
  have hK_sq : K ^ 2 = 1 / κ ^ 2 := one_div_pow κ 2
  have h_rhs_nn : 0 ≤ C_flux * (A + K) := by positivity
  rw [Real.sqrt_le_left h_rhs_nn]
  have h_pow6_le14 : κ₀ ^ 6 ≤ κ₀ ^ 14 :=
    pow_le_pow_right₀ hκ₀ (by norm_num)
  have h_pow13_le14 : κ₀ ^ 13 ≤ κ₀ ^ 14 :=
    pow_le_pow_right₀ hκ₀ (by norm_num)
  have h_term1_le : 3168 * κ₀ ^ 6 * A ^ 2 ≤ 3168 * κ₀ ^ 14 * A ^ 2 := by
    have h1 : 3168 * κ₀ ^ 6 ≤ 3168 * κ₀ ^ 14 :=
      mul_le_mul_of_nonneg_left h_pow6_le14 (by norm_num)
    exact mul_le_mul_of_nonneg_right h1 (sq_nonneg A)
  have h_term2_le : 600 * κ₀ ^ 13 * K ^ 2 ≤ 600 * κ₀ ^ 14 * K ^ 2 := by
    have h1 : 600 * κ₀ ^ 13 ≤ 600 * κ₀ ^ 14 :=
      mul_le_mul_of_nonneg_left h_pow13_le14 (by norm_num)
    exact mul_le_mul_of_nonneg_right h1 (sq_nonneg K)
  have h_quad :
      3168 * κ₀ ^ 14 * A ^ 2 + 600 * κ₀ ^ 14 * K ^ 2 ≤ (C_flux * (A + K)) ^ 2 := by
    dsimp [C_flux]
    have h_diff : (60 * κ₀ ^ 7 * (A + K)) ^ 2 - (3168 * κ₀ ^ 14 * A ^ 2 + 600 * κ₀ ^ 14 * K ^ 2) =
        κ₀ ^ 14 * (432 * A ^ 2 + 7200 * (A * K) + 3000 * K ^ 2) := by ring
    have h_nn : 0 ≤ κ₀ ^ 14 * (432 * A ^ 2 + 7200 * (A * K) + 3000 * K ^ 2) := by positivity
    linarith only [h_diff, h_nn]
  have h600_K : 600 * κ₀ ^ 13 / κ ^ 2 = 600 * κ₀ ^ 13 * (1 / κ ^ 2) := by ring
  rw [← hA_sq, h600_K, ← hK_sq] at h_hm2_bound
  linarith [h_hm2_bound, h_term1_le, h_term2_le, h_quad]

theorem regularized_flow_approximationT (h_exists : ∀ q : CinfT, ∃ u : ℝ → CinfT, IsSmoothSolutionT u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → CinfT,
      IsSmoothSolutionT u → IsSmoothSolutionT v → u 0 = v 0 → u = v)
    (δ : ℝ) (hδ : 0 < δ) :
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ δ₀ ≤ δ ∧
      ∀ (κ₀ : ℝ), 1 ≤ κ₀ →
        ∃ (C_rem : ℝ) (Φ_reg : ℝ → ℝ → CinfT → CinfT),
          0 < C_rem ∧
          (∀ κ : ℝ, 2 * κ₀ ≤ κ → ∀ w₀ : CinfT, hm1KappaSqT κ₀ (ιT w₀) ≤ δ₀ ^ 2 * κ₀ → ∀ t : ℝ,
            (∀ M : ℝ, κ₀ ≤ M → hm1KappaSqT M (ιT (Φ_reg κ t w₀)) ≤ δ ^ 2 * M) ∧
            (∀ M : ℝ, κ₀ ≤ M → alphaFunctionalT M (Φ_reg κ t w₀ : ℝ → ℝ) = alphaFunctionalT M (w₀ : ℝ → ℝ))) ∧
          (∀ κ : ℝ, 2 * κ₀ ≤ κ → ∀ T' : ℝ, 0 < T' →
            ∃ L_κ : ℝ, 0 < L_κ ∧
              ∀ w₁ w₂ : CinfT, hm1KappaSqT κ₀ (ιT w₁) ≤ δ₀ ^ 2 * κ₀ → hm1KappaSqT κ₀ (ιT w₂) ≤ δ₀ ^ 2 * κ₀ →
                ∀ t : ℝ, |t| ≤ T' →
                  ‖ιT (Φ_reg κ t w₁) - ιT (Φ_reg κ t w₂)‖ ≤ L_κ * ‖ιT w₁ - ιT w₂‖) ∧
          (∀ κ : ℝ, 2 * κ₀ ≤ κ → ∀ T' : ℝ, 0 < T' →
            ∀ u : ℝ → CinfT, IsSmoothSolutionT u → hm1KappaSqT κ₀ (ιT (u 0)) ≤ δ₀ ^ 2 * κ₀ →
              ∀ t : ℝ, |t| ≤ T' →
                Real.sqrt (hm2NormSqT (fun x => recipGreenDiffT κ₀ (u t : ℝ → ℝ) x - recipGreenDiffT κ₀ (Φ_reg κ t (u 0) : ℝ → ℝ) x)) ≤
                  C_rem * T' * (Real.sqrt (hm1KappaSqT κ (ιT (u 0))) + 1 / κ)) :=
by
  obtain ⟨δ₁, c₁, c₂, K_alpha, hδ₁, _hc₁, _hc₁₂, hK_alpha,
    _h_alpha_eq, h_alpha_ratio, _h_interp⟩ := diagGreen_alpha_and_interpolationT
  obtain ⟨δ_lip, hδ_lip, h_lip⟩ := reg_flow_lipschitz_on_small_ballT
  obtain ⟨δ_evol, hδ_evol, h_evol⟩ := diff_flow_recipGreenDiff_hm2_integral_boundT
  obtain ⟨δ_flux, hδ_flux, h_flux_all⟩ := recipGreenFlux_deriv_hm2_boundT
  set δ_target := min (min δ δ₁) (min δ_lip (min δ_evol δ_flux))
  have hδ_target : 0 < δ_target := by positivity
  have hδ_target_le_δ : δ_target ≤ δ :=
    le_trans (min_le_left _ _) (min_le_left _ _)
  have hδ_target_le_δ₁ : δ_target ≤ δ₁ :=
    le_trans (min_le_left _ _) (min_le_right _ _)
  have hδ_target_le_lip : δ_target ≤ δ_lip :=
    le_trans (min_le_right _ _) (min_le_left _ _)
  have hδ_target_le_evol : δ_target ≤ δ_evol :=
    le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
  have hδ_target_le_flux : δ_target ≤ δ_flux :=
    le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
  have h_sq_δ : δ_target ^ 2 ≤ δ ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ_target) hδ_target_le_δ 2
  have h_sq_δ₁ : δ_target ^ 2 ≤ δ₁ ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ_target) hδ_target_le_δ₁ 2
  have h_sq_lip : δ_target ^ 2 ≤ δ_lip ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ_target) hδ_target_le_lip 2
  have h_sq_evol : δ_target ^ 2 ≤ δ_evol ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ_target) hδ_target_le_evol 2
  have h_sq_flux : δ_target ^ 2 ≤ δ_flux ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ_target) hδ_target_le_flux 2
  obtain ⟨δ₀_reg, hδ₀_reg_pos, hδ₀_reg_le, h_reg_ex⟩ :=
    reg_flow_global_existence_and_conservationT δ_target hδ_target
  obtain ⟨δ₀_comm, hδ₀_comm_pos, _hδ₀_comm_le, h_comm⟩ :=
    kdv_reg_commuting_diff_flowT h_exists h_unique δ_target hδ_target
  set δ₀ := min δ₀_reg δ₀_comm
  have hδ₀_pos : 0 < δ₀ := lt_min hδ₀_reg_pos hδ₀_comm_pos
  have hδ₀_le_reg : δ₀ ≤ δ₀_reg := min_le_left _ _
  have hδ₀_le_comm : δ₀ ≤ δ₀_comm := min_le_right _ _
  have hδ₀_le_δ : δ₀ ≤ δ := le_trans hδ₀_le_reg (le_trans hδ₀_reg_le hδ_target_le_δ)
  have h_sq_reg : δ₀ ^ 2 ≤ δ₀_reg ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ₀_pos) hδ₀_le_reg 2
  have h_sq_comm : δ₀ ^ 2 ≤ δ₀_comm ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ₀_pos) hδ₀_le_comm 2
  refine ⟨δ₀, hδ₀_pos, hδ₀_le_δ, ?_⟩
  intro κ₀ hκ₀
  have hκ₀_nonneg : 0 ≤ κ₀ := by linarith
  obtain ⟨C_flux, hC_flux, h_flux⟩ := h_flux_all κ₀ hκ₀
  set C_rem := C_flux * (K_alpha + 1)
  have hC_rem_pos : 0 < C_rem := by positivity
  let Φ_reg : ℝ → ℝ → CinfT → CinfT := fun κ t w₀ =>
    if h : 2 * κ₀ ≤ κ ∧ hm1KappaSqT κ₀ (ιT w₀) ≤ δ₀_reg ^ 2 * κ₀ then
      (h_reg_ex κ₀ hκ₀ κ h.1 w₀ h.2).choose t
    else w₀
  have hΦ_spec : ∀ (κ : ℝ) (hκ : 2 * κ₀ ≤ κ) (w₀ : CinfT),
      hm1KappaSqT κ₀ (ιT w₀) ≤ δ₀ ^ 2 * κ₀ →
      IsRegFlowSolutionT κ (fun t => Φ_reg κ t w₀) ∧
      Φ_reg κ 0 w₀ = w₀ ∧
      (∀ t : ℝ, ∀ M : ℝ, κ₀ ≤ M → hm1KappaSqT M (ιT (Φ_reg κ t w₀)) ≤ δ_target ^ 2 * M) ∧
      (∀ M : ℝ, κ₀ ≤ M → ∀ t : ℝ, alphaFunctionalT M (Φ_reg κ t w₀ : ℝ → ℝ) = alphaFunctionalT M (w₀ : ℝ → ℝ)) := by
    intro κ hκ w₀ hw₀
    have hw₀_reg : hm1KappaSqT κ₀ (ιT w₀) ≤ δ₀_reg ^ 2 * κ₀ :=
      le_trans hw₀ (mul_le_mul_of_nonneg_right h_sq_reg hκ₀_nonneg)
    have hΦ_eq : (fun t => Φ_reg κ t w₀) = (h_reg_ex κ₀ hκ₀ κ hκ w₀ hw₀_reg).choose := by
      ext t
      dsimp [Φ_reg]
      rw [dif_pos ⟨hκ, hw₀_reg⟩]
    have h_spec := (h_reg_ex κ₀ hκ₀ κ hκ w₀ hw₀_reg).choose_spec
    rw [← hΦ_eq] at h_spec
    exact h_spec
  refine ⟨C_rem, Φ_reg, hC_rem_pos, ?_, ?_, ?_⟩
  · intro κ hκ w₀ hw₀ t
    obtain ⟨_h_sol, _h_init, h_ball, h_alpha⟩ := hΦ_spec κ hκ w₀ hw₀
    refine ⟨?_, fun M hM => h_alpha M hM t⟩
    intro M hM
    have hM_nonneg : 0 ≤ M := le_trans hκ₀_nonneg hM
    exact le_trans (h_ball t M hM) (mul_le_mul_of_nonneg_right h_sq_δ hM_nonneg)
  · intro κ hκ T' hT'
    obtain ⟨L_κ, hL_κ, h_lip_κ⟩ := h_lip κ₀ hκ₀ κ hκ T' hT'
    refine ⟨L_κ, hL_κ, ?_⟩
    intro w₁ w₂ hw₁ hw₂ t ht
    obtain ⟨h_sol₁, h_init₁, h_ball₁, _⟩ := hΦ_spec κ hκ w₁ hw₁
    obtain ⟨h_sol₂, h_init₂, h_ball₂, _⟩ := hΦ_spec κ hκ w₂ hw₂
    have h_bound := h_lip_κ (fun s => Φ_reg κ s w₁) (fun s => Φ_reg κ s w₂)
      h_sol₁ h_sol₂
      (fun s => le_trans (h_ball₁ s κ₀ le_rfl) (mul_le_mul_of_nonneg_right h_sq_lip hκ₀_nonneg))
      (fun s => le_trans (h_ball₂ s κ₀ le_rfl) (mul_le_mul_of_nonneg_right h_sq_lip hκ₀_nonneg))
      t ht
    simpa [h_init₁, h_init₂] using h_bound
  · intro κ hκ T' hT' u hu hu0 t ht
    obtain ⟨h_sol_w, h_init_w, h_ball_w, _h_alpha_w⟩ := hΦ_spec κ hκ (u 0) hu0
    have hκ_ge_κ₀ : κ₀ ≤ κ := by linarith
    have hκ_ge1 : 1 ≤ κ := le_trans hκ₀ hκ_ge_κ₀
    have hκ_pos : 0 < κ := by linarith
    have hκ_nonneg : 0 ≤ κ := le_of_lt hκ_pos
    have hu0_comm : hm1KappaSqT κ₀ (ιT (u 0)) ≤ δ₀_comm ^ 2 * κ₀ :=
      le_trans hu0 (mul_le_mul_of_nonneg_right h_sq_comm hκ₀_nonneg)
    have hu0_δ₁ : hm1KappaSqT κ (ιT (u 0)) ≤ δ₁ ^ 2 * κ := by
      have h0 := h_ball_w 0 κ hκ_ge_κ₀
      rw [h_init_w] at h0
      exact le_trans h0 (mul_le_mul_of_nonneg_right h_sq_δ₁ hκ_nonneg)
    obtain ⟨z, hz_sol, hz0, hzt, hz_ball, hz_alpha⟩ :=
      h_comm κ₀ hκ₀ κ hκ u (fun s => Φ_reg κ s (u 0)) hu h_sol_w h_init_w hu0_comm t
    set M_flux := C_rem * (Real.sqrt (hm1KappaSqT κ (ιT (u 0))) + 1 / κ)
    have hM_flux_nonneg : 0 ≤ M_flux := by positivity
    have h_flux_bound : ∀ s : ℝ,
        Real.sqrt (hm2NormSqT (deriv (recipGreenFluxT κ₀ κ (z s : ℝ → ℝ)))) ≤ M_flux := by
      intro s
      have hzs_flux : hm1KappaSqT κ₀ (ιT (z s)) ≤ δ_flux ^ 2 * κ₀ :=
        le_trans (hz_ball s κ₀ le_rfl) (mul_le_mul_of_nonneg_right h_sq_flux hκ₀_nonneg)
      have hzs_δ₁ : hm1KappaSqT κ (ιT (z s)) ≤ δ₁ ^ 2 * κ :=
        le_trans (hz_ball s κ hκ_ge_κ₀) (mul_le_mul_of_nonneg_right h_sq_δ₁ hκ_nonneg)
      have h1 := h_flux κ hκ (z s) hzs_flux
      have h2 := h_alpha_ratio κ hκ_ge1 (z s) (u 0) hzs_δ₁ hu0_δ₁ (hz_alpha s)
      have h_sqrt_nonneg : 0 ≤ Real.sqrt (hm1KappaSqT κ (ιT (u 0))) := Real.sqrt_nonneg _
      have h_inv_nonneg : 0 ≤ 1 / κ := by positivity
      calc Real.sqrt (hm2NormSqT (deriv (recipGreenFluxT κ₀ κ (z s : ℝ → ℝ))))
        _ ≤ C_flux * (Real.sqrt (hm1KappaSqT κ (ιT (z s))) + 1 / κ) := h1
        _ ≤ C_flux * (K_alpha * Real.sqrt (hm1KappaSqT κ (ιT (u 0))) + 1 / κ) := by
          apply mul_le_mul_of_nonneg_left _ (le_of_lt hC_flux)
          linarith
        _ ≤ C_flux * (K_alpha + 1) * (Real.sqrt (hm1KappaSqT κ (ιT (u 0))) + 1 / κ) := by
          rw [mul_assoc]
          apply mul_le_mul_of_nonneg_left _ (le_of_lt hC_flux)
          have h_prod_nonneg : 0 ≤ K_alpha * (1 / κ) := by positivity
          linarith
    have h_evol_bound := h_evol κ₀ hκ₀ κ hκ z hz_sol
      (fun s => le_trans (hz_ball s κ₀ le_rfl) (mul_le_mul_of_nonneg_right h_sq_evol hκ₀_nonneg))
      t M_flux hM_flux_nonneg h_flux_bound
    rw [hzt, hz0] at h_evol_bound
    calc Real.sqrt (hm2NormSqT (fun x => recipGreenDiffT κ₀ (u t : ℝ → ℝ) x - recipGreenDiffT κ₀ (Φ_reg κ t (u 0) : ℝ → ℝ) x))
      _ ≤ |t| * M_flux := h_evol_bound
      _ ≤ T' * M_flux := mul_le_mul_of_nonneg_right ht hM_flux_nonneg
      _ = C_rem * T' * (Real.sqrt (hm1KappaSqT κ (ιT (u 0))) + 1 / κ) := by
        dsimp [M_flux]
        ring

theorem smooth_flow_conservation_and_cauchyT (h_exists : ∀ q : CinfT, ∃ u : ℝ → CinfT, IsSmoothSolutionT u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → CinfT,
      IsSmoothSolutionT u → IsSmoothSolutionT v → u 0 = v 0 → u = v) :
    (∀ q : Hm1T, ∃ κ₀ ≥ (1 : ℝ), ∃ C > (0 : ℝ), ∀ u : ℝ → CinfT,
      IsSmoothSolutionT u → ‖ιT (u 0) - q‖ < 1 →
      ∀ (t : ℝ) (κ : ℝ), κ₀ ≤ κ →
        (∑' n : ℤ, (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) *
          ‖(ιT (u t) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2) ≤
          C * ∑' n : ℤ, (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) *
            ‖(ιT (u 0) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2) ∧
    (∀ (q : Hm1T) (T : ℝ), 0 < T → ∀ ε > 0, ∃ η > 0,
      ∀ u v : ℝ → CinfT, IsSmoothSolutionT u → IsSmoothSolutionT v →
      ‖ιT (u 0) - q‖ < η → ‖ιT (v 0) - q‖ < η →
      ∀ t : ℝ, |t| ≤ T → ‖ιT (u t) - ιT (v t)‖ < ε) :=
by
  obtain ⟨h_hm1_le, h_tail⟩ := hm1KappaSq_tail_controlT
  obtain ⟨δ₁, c₁, c₂, K_alpha, hδ₁, hc₁, hc₁₂, hK_alpha,
    h_alpha_eq, h_alpha_ratio, h_interp_all⟩ := diagGreen_alpha_and_interpolationT
  have hc₂ : 0 < c₂ := lt_of_lt_of_le hc₁ hc₁₂
  obtain ⟨δ₀_kdv, hδ₀_kdv_pos, hδ₀_kdv_le, h_kdv⟩ :=
    kdv_alpha_conservation_small_dataT h_exists h_unique δ₁ hδ₁
  obtain ⟨δ₀_reg, hδ₀_reg_pos, hδ₀_reg_le, h_reg_all⟩ :=
    regularized_flow_approximationT h_exists h_unique δ₁ hδ₁
  set δ₀ := min δ₀_kdv δ₀_reg
  have hδ₀ : 0 < δ₀ := lt_min hδ₀_kdv_pos hδ₀_reg_pos
  have hδ₀_ne : δ₀ ≠ 0 := ne_of_gt hδ₀
  have h_init_small : ∀ (q : Hm1T) (w : CinfT),
      ‖ιT w - q‖ < 1 →
      hm1KappaSqT (max 1 (((‖q‖ + 1) / δ₀) ^ 2)) (ιT w) ≤
        δ₀_kdv ^ 2 * max 1 (((‖q‖ + 1) / δ₀) ^ 2) ∧
      hm1KappaSqT (max 1 (((‖q‖ + 1) / δ₀) ^ 2)) (ιT w) ≤
        δ₀_reg ^ 2 * max 1 (((‖q‖ + 1) / δ₀) ^ 2) := by
    intro q w hw
    set R := ‖q‖ + 1
    set κ₀ := max 1 ((R / δ₀) ^ 2)
    have hκ₀ : 1 ≤ κ₀ := le_max_left _ _
    have hκ₀_nonneg : 0 ≤ κ₀ := by linarith
    have hw_norm : ‖ιT w‖ ≤ R := by
      have h_tri : ‖ιT w‖ ≤ ‖q‖ + ‖ιT w - q‖ := norm_le_norm_add_norm_sub' (ιT w) q
      linarith
    have hw_sq : ‖ιT w‖ ^ 2 ≤ R ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) hw_norm 2
    have h_hm1_R : hm1KappaSqT κ₀ (ιT w) ≤ R ^ 2 :=
      le_trans (h_hm1_le κ₀ hκ₀ (ιT w)).2 hw_sq
    have h_R_eq : R ^ 2 = δ₀ ^ 2 * (R / δ₀) ^ 2 := by
      field_simp
    have h_R_κ₀ : R ^ 2 ≤ δ₀ ^ 2 * κ₀ := by
      rw [h_R_eq]
      exact mul_le_mul_of_nonneg_left (le_max_right 1 ((R / δ₀) ^ 2)) (sq_nonneg δ₀)
    have h_hm1_δ₀ : hm1KappaSqT κ₀ (ιT w) ≤ δ₀ ^ 2 * κ₀ :=
      le_trans h_hm1_R h_R_κ₀
    have h_kdv_sq : δ₀ ^ 2 ≤ δ₀_kdv ^ 2 :=
      pow_le_pow_left₀ (le_of_lt hδ₀) (min_le_left _ _) 2
    have h_reg_sq : δ₀ ^ 2 ≤ δ₀_reg ^ 2 :=
      pow_le_pow_left₀ (le_of_lt hδ₀) (min_le_right _ _) 2
    exact ⟨le_trans h_hm1_δ₀ (mul_le_mul_of_nonneg_right h_kdv_sq hκ₀_nonneg),
      le_trans h_hm1_δ₀ (mul_le_mul_of_nonneg_right h_reg_sq hκ₀_nonneg)⟩
  refine ⟨?_, ?_⟩
  · intro q
    set κ₀ := max 1 (((‖q‖ + 1) / δ₀) ^ 2)
    have hκ₀ : 1 ≤ κ₀ := le_max_left _ _
    refine ⟨κ₀, hκ₀, c₂ / c₁, div_pos hc₂ hc₁, ?_⟩
    intro u hu hu0 t κ hκ
    change hm1KappaSqT κ (ιT (u t)) ≤ (c₂ / c₁) * hm1KappaSqT κ (ιT (u 0))
    have hκ_ge1 : 1 ≤ κ := le_trans hκ₀ hκ
    have hu0_kdv : hm1KappaSqT κ₀ (ιT (u 0)) ≤ δ₀_kdv ^ 2 * κ₀ :=
      (h_init_small q (u 0) hu0).1
    have h_u_cons := h_kdv κ₀ hκ₀ u hu hu0_kdv
    have hut_δ₁ : hm1KappaSqT κ (ιT (u t)) ≤ δ₁ ^ 2 * κ := h_u_cons.1 t κ hκ
    have hu0_δ₁ : hm1KappaSqT κ (ιT (u 0)) ≤ δ₁ ^ 2 * κ := h_u_cons.1 0 κ hκ
    have h_cons_eq : alphaFunctionalT κ (u t : ℝ → ℝ) = alphaFunctionalT κ (u 0 : ℝ → ℝ) :=
      h_u_cons.2 κ hκ t
    have h_low := (h_alpha_eq κ hκ_ge1 (u t) hut_δ₁).1
    have h_high := (h_alpha_eq κ hκ_ge1 (u 0) hu0_δ₁).2
    have h_c1_c2 : c₁ * hm1KappaSqT κ (ιT (u t)) ≤ c₂ * hm1KappaSqT κ (ιT (u 0)) := by
      have h_eq : κ * alphaFunctionalT κ (u t : ℝ → ℝ) = κ * alphaFunctionalT κ (u 0 : ℝ → ℝ) := by
        rw [h_cons_eq]
      linarith
    rw [div_mul_eq_mul_div, le_div_iff₀' hc₁]
    exact h_c1_c2
  · intro q T hT ε hε
    set κ₀ := max 1 (((‖q‖ + 1) / δ₀) ^ 2)
    have hκ₀ : 1 ≤ κ₀ := le_max_left _ _
    have hκ₀_pos : 0 < κ₀ := by linarith
    obtain ⟨C_int, hC_int, h_interp⟩ := h_interp_all κ₀ hκ₀
    obtain ⟨C_rem, Φ_reg, hC_rem, h_reg_inv, h_reg_lip, h_reg_rem⟩ := h_reg_all κ₀ hκ₀
    set θ_M := ε / (12 * C_int * K_alpha)
    have hθ_M : 0 < θ_M := by positivity
    obtain ⟨M₀, hM₀_ge2, η_M, hη_M, h_tail_M⟩ := h_tail q θ_M hθ_M
    set M := max κ₀ M₀
    have hM_ge_κ₀ : κ₀ ≤ M := le_max_left _ _
    have hM_ge_M₀ : M₀ ≤ M := le_max_right _ _
    have hM_ge1 : 1 ≤ M := le_trans hκ₀ hM_ge_κ₀
    set F_M := C_int * (M ^ 2 + 4) ^ 2 * C_rem * T
    have hF_M : 0 < F_M := by positivity
    set θ_κ := ε / (12 * F_M)
    have hθ_κ : 0 < θ_κ := by positivity
    obtain ⟨κ₁, hκ₁_ge2, η_κ, hη_κ, h_tail_κ⟩ := h_tail q θ_κ hθ_κ
    set κ := max (2 * κ₀) (max κ₁ (1 / θ_κ + 2))
    have hκ_ge_2κ₀ : 2 * κ₀ ≤ κ := le_max_left _ _
    have hκ_ge_κ₁ : κ₁ ≤ κ := le_trans (le_max_left _ _) (le_max_right _ _)
    have hκ_ge2 : 2 ≤ κ := le_trans hκ₁_ge2 hκ_ge_κ₁
    have hκ_ge1 : 1 ≤ κ := by linarith
    have hκ_gt_inv : 1 / θ_κ < κ := by
      have : 1 / θ_κ + 2 ≤ κ := le_trans (le_max_right _ _) (le_max_right _ _)
      linarith
    have hκ_pos : 0 < κ := by linarith
    have h_inv_κ : 1 / κ < θ_κ := by
      rw [div_lt_iff₀ hκ_pos]
      have : (1 / θ_κ) * θ_κ < κ * θ_κ := mul_lt_mul_of_pos_right hκ_gt_inv hθ_κ
      rw [one_div_mul_cancel (ne_of_gt hθ_κ)] at this
      linarith
    obtain ⟨L_κ, hL_κ, h_lip_κ⟩ := h_reg_lip κ hκ_ge_2κ₀ T hT
    set η := min (min 1 (min η_M η_κ)) (ε / (6 * L_κ))
    have hη : 0 < η := by positivity
    have hη_le1 : η ≤ 1 := le_trans (min_le_left _ _) (min_le_left _ _)
    have hη_le_M : η ≤ η_M :=
      le_trans (min_le_left _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    have hη_le_κ : η ≤ η_κ :=
      le_trans (min_le_left _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
    have hη_le_lip : η ≤ ε / (6 * L_κ) := min_le_right _ _
    refine ⟨η, hη, ?_⟩
    intro u v hu hv hu0 hv0 t ht
    have h_single : ∀ w : ℝ → CinfT, IsSmoothSolutionT w → ‖ιT (w 0) - q‖ < η →
        ‖ιT (w t) - ιT (Φ_reg κ t (w 0))‖ < ε / 3 ∧
        hm1KappaSqT κ₀ (ιT (w 0)) ≤ δ₀_reg ^ 2 * κ₀ := by
      intro w hw hw0
      have hw0_lt1 : ‖ιT (w 0) - q‖ < 1 := lt_of_lt_of_le hw0 hη_le1
      have hw0_kdv : hm1KappaSqT κ₀ (ιT (w 0)) ≤ δ₀_kdv ^ 2 * κ₀ :=
        (h_init_small q (w 0) hw0_lt1).1
      have hw0_reg : hm1KappaSqT κ₀ (ιT (w 0)) ≤ δ₀_reg ^ 2 * κ₀ :=
        (h_init_small q (w 0) hw0_lt1).2
      have h_kdv_w := h_kdv κ₀ hκ₀ w hw hw0_kdv
      have hwt_κ₀ : hm1KappaSqT κ₀ (ιT (w t)) ≤ δ₁ ^ 2 * κ₀ :=
        h_kdv_w.1 t κ₀ le_rfl
      have hwt_M : hm1KappaSqT M (ιT (w t)) ≤ δ₁ ^ 2 * M :=
        h_kdv_w.1 t M hM_ge_κ₀
      have hw0_M : hm1KappaSqT M (ιT (w 0)) ≤ δ₁ ^ 2 * M :=
        h_kdv_w.1 0 M hM_ge_κ₀
      have hwt_alpha : alphaFunctionalT M (w t : ℝ → ℝ) = alphaFunctionalT M (w 0 : ℝ → ℝ) :=
        h_kdv_w.2 M hM_ge_κ₀ t
      have h_reg_w := h_reg_inv κ hκ_ge_2κ₀ (w 0) hw0_reg t
      have hreg_κ₀ : hm1KappaSqT κ₀ (ιT (Φ_reg κ t (w 0))) ≤ δ₁ ^ 2 * κ₀ :=
        h_reg_w.1 κ₀ le_rfl
      have hreg_M : hm1KappaSqT M (ιT (Φ_reg κ t (w 0))) ≤ δ₁ ^ 2 * M :=
        h_reg_w.1 M hM_ge_κ₀
      have hreg_alpha : alphaFunctionalT M (Φ_reg κ t (w 0) : ℝ → ℝ) = alphaFunctionalT M (w 0 : ℝ → ℝ) :=
        h_reg_w.2 M hM_ge_κ₀
      have h_M_w0 : Real.sqrt (hm1KappaSqT M (ιT (w 0))) < θ_M :=
        h_tail_M M hM_ge_M₀ (w 0) (lt_of_lt_of_le hw0 hη_le_M)
      have h_M_wt : Real.sqrt (hm1KappaSqT M (ιT (w t))) < K_alpha * θ_M := by
        calc Real.sqrt (hm1KappaSqT M (ιT (w t)))
          _ ≤ K_alpha * Real.sqrt (hm1KappaSqT M (ιT (w 0))) :=
            h_alpha_ratio M hM_ge1 (w t) (w 0) hwt_M hw0_M hwt_alpha
          _ < K_alpha * θ_M := mul_lt_mul_of_pos_left h_M_w0 hK_alpha
      have h_M_reg : Real.sqrt (hm1KappaSqT M (ιT (Φ_reg κ t (w 0)))) < K_alpha * θ_M := by
        calc Real.sqrt (hm1KappaSqT M (ιT (Φ_reg κ t (w 0))))
          _ ≤ K_alpha * Real.sqrt (hm1KappaSqT M (ιT (w 0))) :=
            h_alpha_ratio M hM_ge1 (Φ_reg κ t (w 0)) (w 0) hreg_M hw0_M hreg_alpha
          _ < K_alpha * θ_M := mul_lt_mul_of_pos_left h_M_w0 hK_alpha
      have h_κ_w0 : Real.sqrt (hm1KappaSqT κ (ιT (w 0))) < θ_κ :=
        h_tail_κ κ hκ_ge_κ₁ (w 0) (lt_of_lt_of_le hw0 hη_le_κ)
      have h_rem_bound :
          Real.sqrt (hm2NormSqT (fun x => recipGreenDiffT κ₀ (w t : ℝ → ℝ) x - recipGreenDiffT κ₀ (Φ_reg κ t (w 0) : ℝ → ℝ) x)) <
            C_rem * T * (2 * θ_κ) := by
        calc Real.sqrt (hm2NormSqT (fun x => recipGreenDiffT κ₀ (w t : ℝ → ℝ) x - recipGreenDiffT κ₀ (Φ_reg κ t (w 0) : ℝ → ℝ) x))
          _ ≤ C_rem * T * (Real.sqrt (hm1KappaSqT κ (ιT (w 0))) + 1 / κ) :=
            h_reg_rem κ hκ_ge_2κ₀ T hT w hw hw0_reg t ht
          _ < C_rem * T * (2 * θ_κ) := by
            apply mul_lt_mul_of_pos_left _ (by positivity)
            linarith
      have h_interp_bound := h_interp M hM_ge_κ₀ (w t) (Φ_reg κ t (w 0)) hwt_κ₀ hreg_κ₀
      have h_term1 :
          C_int * (M ^ 2 + 4) ^ 2 *
            Real.sqrt (hm2NormSqT (fun x => recipGreenDiffT κ₀ (w t : ℝ → ℝ) x - recipGreenDiffT κ₀ (Φ_reg κ t (w 0) : ℝ → ℝ) x)) <
            ε / 6 := by
        have h_eq : C_int * (M ^ 2 + 4) ^ 2 * (C_rem * T * (2 * θ_κ)) = ε / 6 := by
          dsimp [θ_κ, F_M]
          have : F_M ≠ 0 := ne_of_gt hF_M
          field_simp
          ring
        calc C_int * (M ^ 2 + 4) ^ 2 *
              Real.sqrt (hm2NormSqT (fun x => recipGreenDiffT κ₀ (w t : ℝ → ℝ) x - recipGreenDiffT κ₀ (Φ_reg κ t (w 0) : ℝ → ℝ) x))
          _ < C_int * (M ^ 2 + 4) ^ 2 * (C_rem * T * (2 * θ_κ)) :=
            mul_lt_mul_of_pos_left h_rem_bound (by positivity)
          _ = ε / 6 := h_eq
      have h_term2 :
          C_int * (Real.sqrt (hm1KappaSqT M (ιT (w t))) + Real.sqrt (hm1KappaSqT M (ιT (Φ_reg κ t (w 0))))) <
            ε / 6 := by
        have h_eq : C_int * (2 * (K_alpha * θ_M)) = ε / 6 := by
          dsimp [θ_M]
          have : C_int ≠ 0 := ne_of_gt hC_int
          have : K_alpha ≠ 0 := ne_of_gt hK_alpha
          field_simp
          ring
        calc C_int * (Real.sqrt (hm1KappaSqT M (ιT (w t))) + Real.sqrt (hm1KappaSqT M (ιT (Φ_reg κ t (w 0)))))
          _ < C_int * (2 * (K_alpha * θ_M)) := by
            apply mul_lt_mul_of_pos_left _ hC_int
            linarith
          _ = ε / 6 := h_eq
      exact ⟨by linarith, hw0_reg⟩
    obtain ⟨hu_approx, hu0_reg⟩ := h_single u hu hu0
    obtain ⟨hv_approx, hv0_reg⟩ := h_single v hv hv0
    have h_mid : ‖ιT (Φ_reg κ t (u 0)) - ιT (Φ_reg κ t (v 0))‖ < ε / 3 := by
      have h_u0_v0 : ‖ιT (u 0) - ιT (v 0)‖ < 2 * η := by
        have h_tri : ‖ιT (u 0) - ιT (v 0)‖ ≤ ‖ιT (u 0) - q‖ + ‖q - ιT (v 0)‖ :=
          norm_sub_le_norm_sub_add_norm_sub (ιT (u 0)) q (ιT (v 0))
        rw [norm_sub_rev q (ιT (v 0))] at h_tri
        linarith
      have h_lip_bound := h_lip_κ (u 0) (v 0) hu0_reg hv0_reg t ht
      have h_2η : L_κ * (2 * η) ≤ ε / 3 := by
        have h1 : L_κ * (2 * η) ≤ L_κ * (2 * (ε / (6 * L_κ))) :=
          mul_le_mul_of_nonneg_left (by linarith) (le_of_lt hL_κ)
        have h2 : L_κ * (2 * (ε / (6 * L_κ))) = ε / 3 := by
          have : L_κ ≠ 0 := ne_of_gt hL_κ
          field_simp
          ring
        linarith
      calc ‖ιT (Φ_reg κ t (u 0)) - ιT (Φ_reg κ t (v 0))‖
        _ ≤ L_κ * ‖ιT (u 0) - ιT (v 0)‖ := h_lip_bound
        _ < L_κ * (2 * η) := mul_lt_mul_of_pos_left h_u0_v0 hL_κ
        _ ≤ ε / 3 := h_2η
    have h_tri1 : ‖ιT (u t) - ιT (v t)‖ ≤
        ‖ιT (u t) - ιT (Φ_reg κ t (u 0))‖ +
        ‖ιT (Φ_reg κ t (u 0)) - ιT (v t)‖ :=
      norm_sub_le_norm_sub_add_norm_sub _ _ _
    have h_tri2 : ‖ιT (Φ_reg κ t (u 0)) - ιT (v t)‖ ≤
        ‖ιT (Φ_reg κ t (u 0)) - ιT (Φ_reg κ t (v 0))‖ +
        ‖ιT (Φ_reg κ t (v 0)) - ιT (v t)‖ :=
      norm_sub_le_norm_sub_add_norm_sub _ _ _
    rw [norm_sub_rev (ιT (Φ_reg κ t (v 0))) (ιT (v t))] at h_tri2
    linarith

theorem smooth_flow_continuous_extensionT (h_exists : ∀ q : CinfT, ∃ u : ℝ → CinfT, IsSmoothSolutionT u ∧ u 0 = q)
    (h_dense : DenseRange ιT)
    (h_cont_t : ∀ u : ℝ → CinfT, IsSmoothSolutionT u → Continuous (fun t => ιT (u t)))
    (h_cauchy : ∀ (q : Hm1T) (T : ℝ), 0 < T → ∀ ε > 0, ∃ η > 0,
      ∀ u v : ℝ → CinfT, IsSmoothSolutionT u → IsSmoothSolutionT v →
      ‖ιT (u 0) - q‖ < η → ‖ιT (v 0) - q‖ < η →
      ∀ t : ℝ, |t| ≤ T → ‖ιT (u t) - ιT (v t)‖ < ε) :
    ∃ Φ : ℝ × Hm1T → Hm1T, Continuous Φ ∧ ExtendsSmoothFlowT Φ :=
by
  haveI : CompleteSpace Hm1T := by
    delta Hm1T
    infer_instance
  have h_approx_sol : ∀ (q : Hm1T) (δ : ℝ), 0 < δ →
      ∃ u : ℝ → CinfT, IsSmoothSolutionT u ∧ ‖ιT (u 0) - q‖ < δ := by
    intro q δ hδ
    obtain ⟨q₀, hq₀⟩ := DenseRange.exists_dist_lt h_dense q hδ
    rw [dist_comm, dist_eq_norm] at hq₀
    obtain ⟨u, hu_sol, hu0⟩ := h_exists q₀
    refine ⟨u, hu_sol, ?_⟩
    rwa [hu0]
  have h_seq_ex : ∀ (q : Hm1T) (n : ℕ),
      ∃ u : ℝ → CinfT, IsSmoothSolutionT u ∧ ‖ιT (u 0) - q‖ < 1 / ((n : ℝ) + 1) :=
    fun q n => h_approx_sol q (1 / ((n : ℝ) + 1)) (by positivity)
  choose u_seq hu_sol hu_init using h_seq_ex
  have h_cauchy_seq : ∀ p : ℝ × Hm1T, CauchySeq (fun n : ℕ => ιT (u_seq p.2 n p.1)) := by
    rintro ⟨t, q⟩
    rw [Metric.cauchySeq_iff]
    intro ε hε
    have hT : 0 < |t| + 1 := by positivity
    obtain ⟨η, hη, h_c⟩ := h_cauchy q (|t| + 1) hT ε hε
    obtain ⟨N, hN⟩ := exists_nat_gt (1 / η)
    refine ⟨N, fun m hm n hn => ?_⟩
    rw [dist_eq_norm]
    have hm_lt : 1 / ((m : ℝ) + 1) < η := by
      rw [one_div]
      apply inv_lt_of_inv_lt₀ hη
      rw [← one_div]
      have hmN : (N : ℝ) ≤ (m : ℝ) := Nat.cast_le.mpr hm
      linarith
    have hn_lt : 1 / ((n : ℝ) + 1) < η := by
      rw [one_div]
      apply inv_lt_of_inv_lt₀ hη
      rw [← one_div]
      have hnN : (N : ℝ) ≤ (n : ℝ) := Nat.cast_le.mpr hn
      linarith
    apply h_c (u_seq q m) (u_seq q n) (hu_sol q m) (hu_sol q n)
    · exact lt_trans (hu_init q m) hm_lt
    · exact lt_trans (hu_init q n) hn_lt
    · linarith
  have h_lim_ex : ∀ p : ℝ × Hm1T,
      ∃ y : Hm1T, Filter.Tendsto (fun n : ℕ => ιT (u_seq p.2 n p.1)) Filter.atTop (nhds y) :=
    fun p => cauchySeq_tendsto_of_complete (h_cauchy_seq p)
  choose Φ hΦ_lim using h_lim_ex
  have hΦ_approx : ∀ (q₀ : Hm1T) (T : ℝ), 0 < T → ∀ ε > 0, ∃ η > 0,
      ∀ (q : Hm1T) (u : ℝ → CinfT), IsSmoothSolutionT u →
      ‖q - q₀‖ < η → ‖ιT (u 0) - q₀‖ < η →
      ∀ t : ℝ, |t| ≤ T → ‖Φ (t, q) - ιT (u t)‖ < ε := by
    intro q₀ T hT ε hε
    obtain ⟨η, hη, h_c⟩ := h_cauchy q₀ T hT (ε / 2) (half_pos hε)
    refine ⟨η, hη, fun q u hu hq hu0 t ht => ?_⟩
    have h_diff_pos : 0 < η - ‖q - q₀‖ := sub_pos.mpr hq
    obtain ⟨N, hN⟩ := exists_nat_gt (1 / (η - ‖q - q₀‖))
    have h_ev : ∀ᶠ n : ℕ in Filter.atTop, ‖ιT (u_seq q n t) - ιT (u t)‖ ≤ ε / 2 := by
      rw [Filter.eventually_atTop]
      refine ⟨N, fun n hn => le_of_lt ?_⟩
      have hn_lt : 1 / ((n : ℝ) + 1) < η - ‖q - q₀‖ := by
        rw [one_div]
        apply inv_lt_of_inv_lt₀ h_diff_pos
        rw [← one_div]
        have hnN : (N : ℝ) ≤ (n : ℝ) := Nat.cast_le.mpr hn
        linarith
      have h_un0 : ‖ιT (u_seq q n 0) - q₀‖ < η := by
        have h_tri := norm_sub_le_norm_sub_add_norm_sub (ιT (u_seq q n 0)) q q₀
        have h_init := hu_init q n
        linarith
      exact h_c (u_seq q n) u (hu_sol q n) hu h_un0 hu0 t ht
    have h_tendsto_norm : Filter.Tendsto (fun n : ℕ => ‖ιT (u_seq q n t) - ιT (u t)‖) Filter.atTop (nhds ‖Φ (t, q) - ιT (u t)‖) :=
      ((hΦ_lim (t, q)).sub_const (ιT (u t))).norm
    have h_le : ‖Φ (t, q) - ιT (u t)‖ ≤ ε / 2 := le_of_tendsto h_tendsto_norm h_ev
    linarith
  refine ⟨Φ, ?_, ?_⟩
  · rw [Metric.continuous_iff]
    rintro ⟨t₀, q₀⟩ ε hε
    have hT : 0 < |t₀| + 1 := by positivity
    have hε3 : 0 < ε / 3 := by linarith
    obtain ⟨η, hη, h_app⟩ := hΦ_approx q₀ (|t₀| + 1) hT (ε / 3) hε3
    obtain ⟨u_star, hu_star_sol, hu_star_0⟩ := h_approx_sol q₀ η hη
    have h_phi_t0 : ‖Φ (t₀, q₀) - ιT (u_star t₀)‖ < ε / 3 := by
      apply h_app q₀ u_star hu_star_sol
      · simpa using hη
      · exact hu_star_0
      · linarith
    have h_cont_ustar : ContinuousAt (fun t => ιT (u_star t)) t₀ :=
      (h_cont_t u_star hu_star_sol).continuousAt
    obtain ⟨δ_t, hδ_t, h_ustar_close⟩ := Metric.continuousAt_iff.mp h_cont_ustar (ε / 3) hε3
    refine ⟨min (min δ_t 1) η, lt_min (lt_min hδ_t one_pos) hη, ?_⟩
    rintro ⟨t, q⟩ h_dist
    rw [Prod.dist_eq] at h_dist
    have ht_dist : dist t t₀ < min (min δ_t 1) η := lt_of_le_of_lt (le_max_left _ _) h_dist
    have hq_dist : dist q q₀ < min (min δ_t 1) η := lt_of_le_of_lt (le_max_right _ _) h_dist
    have ht_δt : dist t t₀ < δ_t := lt_of_lt_of_le ht_dist (le_trans (min_le_left _ _) (min_le_left _ _))
    have ht_1 : dist t t₀ < 1 := lt_of_lt_of_le ht_dist (le_trans (min_le_left _ _) (min_le_right _ _))
    have hq_η : ‖q - q₀‖ < η := by
      rw [← dist_eq_norm]
      exact lt_of_lt_of_le hq_dist (min_le_right _ _)
    have ht_le_T : |t| ≤ |t₀| + 1 := by
      rw [Real.dist_eq] at ht_1
      exact abs_le.mpr ⟨by linarith [abs_lt.mp ht_1, neg_abs_le t₀], by linarith [abs_lt.mp ht_1, le_abs_self t₀]⟩
    have h_phi_t : dist (Φ (t, q)) (ιT (u_star t)) < ε / 3 := by
      rw [dist_eq_norm]
      exact h_app q u_star hu_star_sol hq_η hu_star_0 t ht_le_T
    have h_mid : dist (ιT (u_star t)) (ιT (u_star t₀)) < ε / 3 := h_ustar_close ht_δt
    have h_phi_0 : dist (ιT (u_star t₀)) (Φ (t₀, q₀)) < ε / 3 := by
      rwa [dist_comm, dist_eq_norm]
    have h_tri4 := dist_triangle4 (Φ (t, q)) (ιT (u_star t)) (ιT (u_star t₀)) (Φ (t₀, q₀))
    linarith
  · intro u hu t
    apply eq_of_forall_dist_le
    intro ε hε
    have hT : 0 < |t| + 1 := by positivity
    obtain ⟨η, hη, h_app⟩ := hΦ_approx (ιT (u 0)) (|t| + 1) hT ε hε
    rw [dist_eq_norm]
    apply le_of_lt
    apply h_app (ιT (u 0)) u hu
    · simpa using hη
    · simpa using hη
    · linarith

theorem smooth_orbit_bounded_of_conservationT (h_cons : ∀ q : Hm1T, ∃ κ₀ ≥ (1 : ℝ), ∃ C > (0 : ℝ), ∀ u : ℝ → CinfT,
      IsSmoothSolutionT u → ‖ιT (u 0) - q‖ < 1 →
      ∀ (t : ℝ) (κ : ℝ), κ₀ ≤ κ →
        (∑' n : ℤ, (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) *
          ‖(ιT (u t) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2) ≤
          C * ∑' n : ℤ, (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) *
            ‖(ιT (u 0) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2)
    (q : Hm1T) :
    ∃ η > 0, ∃ M : ℝ, ∀ u : ℝ → CinfT,
      IsSmoothSolutionT u → ‖ιT (u 0) - q‖ < η → ∀ t : ℝ, ‖ιT (u t)‖ ≤ M :=
by
  obtain ⟨κ₀, hκ₀, C, hC, h_bound⟩ := h_cons q
  refine ⟨1, one_pos, 1 + κ₀ ^ 2 * C * (‖q‖ + 1) ^ 2, ?_⟩
  intro u hu hu0 t
  have h_summable : ∀ f : lp (fun _ : ℤ => ℂ) 2, Summable (fun n : ℤ => ‖f n‖ ^ 2) := by
    intro f
    simpa [ENNReal.toReal_ofNat, Real.rpow_two] using
      (memℓp_gen_iff (p := 2) (by norm_num : (0 : ℝ) < (2 : ENNReal).toReal)).mp (lp.memℓp f)
  have h_norm_sq : ∀ f : lp (fun _ : ℤ => ℂ) 2, ‖f‖ ^ 2 = ∑' n : ℤ, ‖f n‖ ^ 2 := by
    intro f
    simpa [ENNReal.toReal_ofNat, Real.rpow_two] using
      (lp.norm_rpow_eq_tsum (p := 2) (by norm_num : (0 : ℝ) < (2 : ENNReal).toReal) f)
  have hκ2 : 1 ≤ κ₀ ^ 2 := by nlinarith
  have h_k2_pos : 0 < κ₀ ^ 2 := by positivity
  have h_w_nonneg : ∀ n : ℤ, 0 ≤ (4 + (2 * π * n) ^ 2) / (4 * κ₀ ^ 2 + (2 * π * n) ^ 2) := by
    intro n
    positivity
  have h_w_le_one : ∀ n : ℤ, (4 + (2 * π * n) ^ 2) / (4 * κ₀ ^ 2 + (2 * π * n) ^ 2) ≤ 1 := by
    intro n
    have h_den : 0 < 4 * κ₀ ^ 2 + (2 * π * n) ^ 2 := by positivity
    exact div_le_one_of_le₀ (by nlinarith) (le_of_lt h_den)
  have h_inv_le_w : ∀ n : ℤ, (κ₀ ^ 2)⁻¹ ≤ (4 + (2 * π * n) ^ 2) / (4 * κ₀ ^ 2 + (2 * π * n) ^ 2) := by
    intro n
    have h_den : 0 < 4 * κ₀ ^ 2 + (2 * π * n) ^ 2 := by positivity
    rw [inv_eq_one_div, div_le_div_iff₀ h_k2_pos h_den]
    nlinarith [sq_nonneg (2 * π * (n : ℝ)), hκ2]
  have h_sum_w : ∀ f : lp (fun _ : ℤ => ℂ) 2,
      Summable (fun n : ℤ => (4 + (2 * π * n) ^ 2) / (4 * κ₀ ^ 2 + (2 * π * n) ^ 2) * ‖f n‖ ^ 2) := by
    intro f
    refine Summable.of_nonneg_of_le ?_ ?_ (h_summable f)
    · intro n
      exact mul_nonneg (h_w_nonneg n) (sq_nonneg _)
    · intro n
      calc (4 + (2 * π * n) ^ 2) / (4 * κ₀ ^ 2 + (2 * π * n) ^ 2) * ‖f n‖ ^ 2
        _ ≤ 1 * ‖f n‖ ^ 2 := mul_le_mul_of_nonneg_right (h_w_le_one n) (sq_nonneg _)
        _ = ‖f n‖ ^ 2 := one_mul _
  have h_upper : ∀ f : lp (fun _ : ℤ => ℂ) 2,
      (∑' n : ℤ, (4 + (2 * π * n) ^ 2) / (4 * κ₀ ^ 2 + (2 * π * n) ^ 2) * ‖f n‖ ^ 2) ≤ ‖f‖ ^ 2 := by
    intro f
    rw [h_norm_sq f]
    refine Summable.tsum_le_tsum ?_ (h_sum_w f) (h_summable f)
    intro n
    calc (4 + (2 * π * n) ^ 2) / (4 * κ₀ ^ 2 + (2 * π * n) ^ 2) * ‖f n‖ ^ 2
      _ ≤ 1 * ‖f n‖ ^ 2 := mul_le_mul_of_nonneg_right (h_w_le_one n) (sq_nonneg _)
      _ = ‖f n‖ ^ 2 := one_mul _
  have h_lower : ∀ f : lp (fun _ : ℤ => ℂ) 2,
      (κ₀ ^ 2)⁻¹ * ‖f‖ ^ 2 ≤ ∑' n : ℤ, (4 + (2 * π * n) ^ 2) / (4 * κ₀ ^ 2 + (2 * π * n) ^ 2) * ‖f n‖ ^ 2 := by
    intro f
    rw [h_norm_sq f, ← tsum_mul_left]
    refine Summable.tsum_le_tsum ?_ ((h_summable f).mul_left (κ₀ ^ 2)⁻¹) (h_sum_w f)
    intro n
    exact mul_le_mul_of_nonneg_right (h_inv_le_w n) (sq_nonneg _)
  have h_u0_norm : ‖(ιT (u 0) : lp (fun _ : ℤ => ℂ) 2)‖ ≤ ‖q‖ + 1 := by
    have h_tri : ‖ιT (u 0)‖ ≤ ‖q‖ + ‖ιT (u 0) - q‖ := norm_le_norm_add_norm_sub' (ιT (u 0)) q
    have h_coe : ‖(ιT (u 0) : lp (fun _ : ℤ => ℂ) 2)‖ = ‖ιT (u 0)‖ := rfl
    linarith
  have h_u0_sq : ‖(ιT (u 0) : lp (fun _ : ℤ => ℂ) 2)‖ ^ 2 ≤ (‖q‖ + 1) ^ 2 := by
    nlinarith [norm_nonneg (ιT (u 0) : lp (fun _ : ℤ => ℂ) 2), norm_nonneg q, h_u0_norm]
  have h_cons_t := h_bound u hu hu0 t κ₀ le_rfl
  have h_ut_low := h_lower (ιT (u t) : lp (fun _ : ℤ => ℂ) 2)
  have h_u0_up := h_upper (ιT (u 0) : lp (fun _ : ℤ => ℂ) 2)
  have h_chain : (κ₀ ^ 2)⁻¹ * ‖(ιT (u t) : lp (fun _ : ℤ => ℂ) 2)‖ ^ 2 ≤ C * (‖q‖ + 1) ^ 2 := by
    nlinarith [h_ut_low, h_cons_t, h_u0_up, h_u0_sq, hC]
  have h_ut_sq : ‖ιT (u t)‖ ^ 2 ≤ κ₀ ^ 2 * C * (‖q‖ + 1) ^ 2 := by
    have h_coe : ‖(ιT (u t) : lp (fun _ : ℤ => ℂ) 2)‖ = ‖ιT (u t)‖ := rfl
    rw [h_coe] at h_chain
    have h_mul := mul_le_mul_of_nonneg_left h_chain (le_of_lt h_k2_pos)
    have h_cancel : κ₀ ^ 2 * ((κ₀ ^ 2)⁻¹ * ‖ιT (u t)‖ ^ 2) = ‖ιT (u t)‖ ^ 2 := by
      rw [← mul_assoc, mul_inv_cancel₀ (ne_of_gt h_k2_pos), one_mul]
    linarith
  nlinarith [sq_nonneg (‖ιT (u t)‖ - 1 / 2), h_ut_sq]

theorem smooth_orbit_equicontinuous_of_conservationT (h_cons : ∀ q : Hm1T, ∃ κ₀ ≥ (1 : ℝ), ∃ C > (0 : ℝ), ∀ u : ℝ → CinfT,
      IsSmoothSolutionT u → ‖ιT (u 0) - q‖ < 1 →
      ∀ (t : ℝ) (κ : ℝ), κ₀ ≤ κ →
        (∑' n : ℤ, (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) *
          ‖(ιT (u t) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2) ≤
          C * ∑' n : ℤ, (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) *
            ‖(ιT (u 0) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2)
    (q : Hm1T) (ε : ℝ) (hε : 0 < ε) :
    ∃ η > 0, ∃ δ > 0, ∀ u : ℝ → CinfT,
      IsSmoothSolutionT u → ‖ιT (u 0) - q‖ < η →
      ∀ t h : ℝ, |h| < δ →
        translateDiffSqT (ιT (u t) : lp (fun _ : ℤ => ℂ) 2) h < ε / 2 :=
by
  have h_summable : ∀ f : lp (fun _ : ℤ => ℂ) 2, Summable (fun n : ℤ => ‖f n‖ ^ 2) := by
    intro f
    simpa [ENNReal.toReal_ofNat, Real.rpow_two] using
      (memℓp_gen_iff (p := 2) (by norm_num : (0 : ℝ) < (2 : ENNReal).toReal)).mp (lp.memℓp f)
  have h_norm_sq : ∀ f : lp (fun _ : ℤ => ℂ) 2, ‖f‖ ^ 2 = ∑' n : ℤ, ‖f n‖ ^ 2 := by
    intro f
    simpa [ENNReal.toReal_ofNat, Real.rpow_two] using
      (lp.norm_rpow_eq_tsum (p := 2) (by norm_num : (0 : ℝ) < (2 : ENNReal).toReal) f)
  have h_w_nonneg : ∀ (κ : ℝ), 1 ≤ κ → ∀ n : ℤ,
      0 ≤ (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) := by
    intro κ hκ n
    have hκ_pos : 0 < κ := by linarith
    positivity
  have h_w_le_one : ∀ (κ : ℝ), 1 ≤ κ → ∀ n : ℤ,
      (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) ≤ 1 := by
    intro κ hκ n
    have hκ_pos : 0 < κ := by linarith
    have h_den : 0 < 4 * κ ^ 2 + (2 * π * n) ^ 2 := by positivity
    exact div_le_one_of_le₀ (by nlinarith) (le_of_lt h_den)
  have h_sum_w : ∀ (f : lp (fun _ : ℤ => ℂ) 2) (κ : ℝ), 1 ≤ κ →
      Summable (fun n : ℤ => (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) * ‖f n‖ ^ 2) := by
    intro f κ hκ
    refine Summable.of_nonneg_of_le ?_ ?_ (h_summable f)
    · intro n
      exact mul_nonneg (h_w_nonneg κ hκ n) (sq_nonneg _)
    · intro n
      exact mul_le_of_le_one_left (sq_nonneg _) (h_w_le_one κ hκ n)
  have s1 : ∀ (f : lp (fun _ : ℤ => ℂ) 2) (κ : ℝ), 1 ≤ κ → ∀ (h : ℝ), |h| < κ⁻¹ →
      translateDiffSqT f h ≤
        8 * ∑' n : ℤ, (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) * ‖f n‖ ^ 2 := by
    intro f κ hκ h hh
    have hκ_pos : 0 < κ := by linarith
    have h_abs_lt : |h| * κ < 1 := by
      rw [inv_eq_one_div, lt_div_iff₀ hκ_pos] at hh
      exact hh
    have h_abs_nonneg : 0 ≤ |h| * κ := mul_nonneg (abs_nonneg h) (le_of_lt hκ_pos)
    have h_κh : κ ^ 2 * h ^ 2 ≤ 1 := by
      have h_sq : (|h| * κ) ^ 2 ≤ 1 ^ 2 := by nlinarith
      have h_abs_sq : h ^ 2 = |h| ^ 2 := (sq_abs h).symm
      nlinarith
    have h_sin : ∀ ξ : ℝ, ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 = 4 * Real.sin (ξ * h / 2) ^ 2 := by
      intro ξ
      have h_exp : (ξ : ℂ) * (h : ℂ) * I = Complex.I * ((ξ * h : ℝ) : ℂ) := by
        push_cast
        ring
      rw [h_exp, Complex.norm_exp_I_mul_ofReal_sub_one (ξ * h), Real.norm_eq_abs]
      calc
        |2 * Real.sin (ξ * h / 2)| ^ 2 = (2 * Real.sin (ξ * h / 2)) ^ 2 := sq_abs _
        _ = 4 * Real.sin (ξ * h / 2) ^ 2 := by ring
    have h_low : ∀ ξ : ℝ, ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 ≤ ξ ^ 2 * h ^ 2 := by
      intro ξ
      have h1 : |Real.sin (ξ * h / 2)| ≤ |ξ * h / 2| := Real.abs_sin_le_abs
      have h2 : Real.sin (ξ * h / 2) ^ 2 ≤ (ξ * h / 2) ^ 2 := by
        rw [← sq_abs (Real.sin (ξ * h / 2)), ← sq_abs (ξ * h / 2)]
        exact pow_le_pow_left₀ (abs_nonneg _) h1 2
      rw [h_sin ξ]
      linarith
    have h_high : ∀ ξ : ℝ, ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 ≤ 4 := by
      intro ξ
      have h1 : |Real.sin (ξ * h / 2)| ≤ 1 := Real.abs_sin_le_one (ξ * h / 2)
      have h2 : Real.sin (ξ * h / 2) ^ 2 ≤ 1 ^ 2 := by
        rw [← sq_abs (Real.sin (ξ * h / 2))]
        exact pow_le_pow_left₀ (abs_nonneg _) h1 2
      rw [h_sin ξ]
      linarith
    have h_pw : ∀ n : ℤ,
        ‖(Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1) * f n‖ ^ 2 ≤
          8 * ((4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) * ‖f n‖ ^ 2) := by
      intro n
      set ξ : ℝ := 2 * π * n
      set M := ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1‖ ^ 2
      have hM_low : M ≤ ξ ^ 2 * h ^ 2 := h_low ξ
      have hM_high : M ≤ 4 := h_high ξ
      have h_denom_pos : 0 < 4 * κ ^ 2 + ξ ^ 2 := by positivity
      have h_clear : M * (4 * κ ^ 2 + ξ ^ 2) ≤ 8 * (4 + ξ ^ 2) := by
        have h_4k2 : 0 ≤ 4 * κ ^ 2 := by positivity
        have h_xi2 : 0 ≤ ξ ^ 2 := sq_nonneg ξ
        have h_part1 : 4 * κ ^ 2 * M ≤ 4 * (κ ^ 2 * h ^ 2) * ξ ^ 2 := by nlinarith
        have h_part2 : 4 * (κ ^ 2 * h ^ 2) * ξ ^ 2 ≤ 4 * ξ ^ 2 := by nlinarith
        have h_part3 : ξ ^ 2 * M ≤ 4 * ξ ^ 2 := by nlinarith
        linarith
      have h_mult : M ≤ 8 * (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) :=
        (le_div_iff₀ h_denom_pos).mpr h_clear
      have h_eq : 8 * (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖f n‖ ^ 2 =
          8 * ((4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖f n‖ ^ 2) := by ring
      rw [norm_mul, mul_pow, ← h_eq]
      exact mul_le_mul_of_nonneg_right h_mult (sq_nonneg ‖f n‖)
    have h_sum_lhs : Summable (fun n : ℤ => ‖(Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1) * f n‖ ^ 2) :=
      Summable.of_nonneg_of_le (fun _ => sq_nonneg _) h_pw ((h_sum_w f κ hκ).mul_left 8)
    unfold translateDiffSqT
    rw [← tsum_mul_left]
    exact Summable.tsum_le_tsum h_pw h_sum_lhs ((h_sum_w f κ hκ).mul_left 8)
  have s2 : ∀ (f g : lp (fun _ : ℤ => ℂ) 2) (κ : ℝ), 1 ≤ κ →
      (∑' n : ℤ, (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) * ‖f n‖ ^ 2) ≤
        2 * (∑' n : ℤ, (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) * ‖g n‖ ^ 2) +
          2 * ‖f - g‖ ^ 2 := by
    intro f g κ hκ
    have h_pw : ∀ n : ℤ,
        (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) * ‖f n‖ ^ 2 ≤
          2 * ((4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) * ‖g n‖ ^ 2) +
            2 * ‖(f - g) n‖ ^ 2 := by
      intro n
      have h_tri : ‖f n‖ ≤ ‖(f - g) n‖ + ‖g n‖ := by
        have h_eq : f n = (f n - g n) + g n := (sub_add_cancel _ _).symm
        have h_add := norm_add_le (f n - g n) (g n)
        rw [← h_eq] at h_add
        exact h_add
      have h_f_nonneg : 0 ≤ ‖f n‖ := norm_nonneg _
      have h_g_nonneg : 0 ≤ ‖g n‖ := norm_nonneg _
      have h_fg_nonneg : 0 ≤ ‖(f - g) n‖ := norm_nonneg _
      have h_sq_diff : 0 ≤ (‖g n‖ - ‖(f - g) n‖) ^ 2 := sq_nonneg _
      have h_sq_bound : ‖f n‖ ^ 2 ≤ 2 * ‖g n‖ ^ 2 + 2 * ‖(f - g) n‖ ^ 2 := by nlinarith
      have hw0 := h_w_nonneg κ hκ n
      have hw1 := h_w_le_one κ hκ n
      have h_fg_sq_nonneg : 0 ≤ ‖(f - g) n‖ ^ 2 := sq_nonneg _
      nlinarith
    have h_sum_g2 : Summable (fun n : ℤ => 2 * ((4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) * ‖g n‖ ^ 2)) :=
      (h_sum_w g κ hκ).mul_left 2
    have h_sum_fg2 : Summable (fun n : ℤ => 2 * ‖(f - g) n‖ ^ 2) :=
      (h_summable (f - g)).mul_left 2
    have h_tsum_le := Summable.tsum_le_tsum h_pw (h_sum_w f κ hκ) (h_sum_g2.add h_sum_fg2)
    rw [Summable.tsum_add h_sum_g2 h_sum_fg2, tsum_mul_left, tsum_mul_left, ← h_norm_sq (f - g)] at h_tsum_le
    exact h_tsum_le
  have s3 : ∀ (g : lp (fun _ : ℤ => ℂ) 2) (κ₀ ε₁ : ℝ), 0 < ε₁ →
      ∃ κ : ℝ, max 1 κ₀ ≤ κ ∧
        (∑' n : ℤ, (4 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) * ‖g n‖ ^ 2) < ε₁ := by
    intro g κ₀ ε₁ hε₁
    let M : ℝ := max 1 κ₀
    have hM₁ : 1 ≤ M := le_max_left 1 κ₀
    let F : ℕ → ℤ → ℝ := fun m n =>
      (4 + (2 * π * n) ^ 2) / (4 * (M + (m : ℝ)) ^ 2 + (2 * π * n) ^ 2) * ‖g n‖ ^ 2
    let B : ℤ → ℝ := fun n => ‖g n‖ ^ 2
    have hF_lim : ∀ n : ℤ, Filter.Tendsto (fun m : ℕ => F m n) Filter.atTop (nhds (0 : ℝ)) := by
      intro n
      dsimp [F]
      have h1 : Filter.Tendsto (fun m : ℕ => M + (m : ℝ)) Filter.atTop Filter.atTop :=
        Filter.tendsto_atTop_add_const_left _ M tendsto_natCast_atTop_atTop
      have h2 : Filter.Tendsto (fun m : ℕ => (M + (m : ℝ)) ^ 2) Filter.atTop Filter.atTop := by
        simpa only [sq] using Filter.Tendsto.atTop_mul_atTop₀ h1 h1
      have h3 : Filter.Tendsto (fun m : ℕ => 4 * (M + (m : ℝ)) ^ 2 + (2 * π * n) ^ 2) Filter.atTop Filter.atTop :=
        Filter.Tendsto.atTop_add (Filter.Tendsto.const_mul_atTop (by norm_num) h2) tendsto_const_nhds
      have h4 : Filter.Tendsto
          (fun m : ℕ => ((4 + (2 * π * n) ^ 2) * ‖g n‖ ^ 2) / (4 * (M + (m : ℝ)) ^ 2 + (2 * π * n) ^ 2))
          Filter.atTop (nhds 0) :=
        Filter.Tendsto.div_atTop tendsto_const_nhds h3
      simpa only [div_mul_eq_mul_div] using h4
    have hF_bound : ∀ᶠ m : ℕ in Filter.atTop, ∀ n : ℤ, ‖F m n‖ ≤ B n := by
      refine Filter.Eventually.of_forall (fun m n => ?_)
      have hm : 1 ≤ M + (m : ℝ) := by linarith [Nat.cast_nonneg (α := ℝ) m]
      rw [Real.norm_of_nonneg (mul_nonneg (h_w_nonneg (M + (m : ℝ)) hm n) (sq_nonneg _))]
      exact mul_le_of_le_one_left (sq_nonneg _) (h_w_le_one (M + (m : ℝ)) hm n)
    have h_tendsto : Filter.Tendsto (fun m : ℕ => ∑' n : ℤ, F m n) Filter.atTop (nhds (∑' _ : ℤ, (0 : ℝ))) :=
      tendsto_tsum_of_dominated_convergence (h_summable g) hF_lim hF_bound
    rw [tsum_zero] at h_tendsto
    have h_ev : ∀ᶠ m : ℕ in Filter.atTop, (∑' n : ℤ, F m n) < ε₁ :=
      h_tendsto.eventually (gt_mem_nhds hε₁)
    obtain ⟨N, hN⟩ := h_ev.exists
    refine ⟨M + (N : ℝ), ?_, hN⟩
    have hN_nonneg : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
    dsimp [M]
    linarith
  obtain ⟨κ₀, _hκ₀, C, hC, h_cons_q⟩ := h_cons q
  have hε₁ : 0 < ε / (64 * C) := by positivity
  obtain ⟨κ, hκ_max, h_q⟩ := s3 (q : lp (fun _ : ℤ => ℂ) 2) κ₀ (ε / (64 * C)) hε₁
  have hκ₁ : 1 ≤ κ := (max_le_iff.mp hκ_max).1
  have hκ₀_le : κ₀ ≤ κ := (max_le_iff.mp hκ_max).2
  have hκ_pos : 0 < κ := by linarith
  refine ⟨min 1 (ε / (64 * C)), lt_min one_pos hε₁, κ⁻¹, inv_pos.mpr hκ_pos, ?_⟩
  intro u hu hu0 t h hh
  have hu0_lt1 : ‖ιT (u 0) - q‖ < 1 := (lt_min_iff.mp hu0).1
  have hu0_lt_eps : ‖ιT (u 0) - q‖ < ε / (64 * C) := (lt_min_iff.mp hu0).2
  have hu0_nonneg : 0 ≤ ‖ιT (u 0) - q‖ := norm_nonneg _
  have hu0_sq : ‖ιT (u 0) - q‖ ^ 2 ≤ ‖ιT (u 0) - q‖ := by nlinarith
  have h_coe_norm :
      ‖(ιT (u 0) : lp (fun _ : ℤ => ℂ) 2) - (q : lp (fun _ : ℤ => ℂ) 2)‖ =
        ‖ιT (u 0) - q‖ := rfl
  have h1 := s1 (ιT (u t) : lp (fun _ : ℤ => ℂ) 2) κ hκ₁ h hh
  have h2 := h_cons_q u hu hu0_lt1 t κ hκ₀_le
  have h3 := s2 (ιT (u 0) : lp (fun _ : ℤ => ℂ) 2) (q : lp (fun _ : ℤ => ℂ) 2) κ hκ₁
  rw [h_coe_norm] at h3
  have h_prod : 64 * C * (ε / (64 * C)) = ε := by
    field_simp
  nlinarith

theorem continuous_translateDiffSqT (h : ℝ) :
    Continuous (fun f : lp (fun _ : ℤ => ℂ) 2 => translateDiffSqT f h) :=
by
  haveI : Fact (1 ≤ (2 : ENNReal)) := ⟨by norm_num⟩
  have hp_pos : (0 : ℝ) < (2 : ENNReal).toReal := by norm_num
  have h_rpow : ∀ x : ℝ, x ^ (2 : ENNReal).toReal = x ^ 2 := fun x => by
    rw [ENNReal.toReal_ofNat, Real.rpow_two]
  let m : ℤ → ℂ := fun n => Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1
  have hm_bound : ∀ n : ℤ, ‖m n‖ ≤ 2 := by
    intro n
    dsimp [m]
    have h_tri : ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I) - 1‖ ≤
        ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I)‖ + ‖(1 : ℂ)‖ :=
      norm_sub_le _ _
    have h_exp : ‖Complex.exp (((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I)‖ = 1 := by
      have h_arg : ((2 * π * n : ℝ) : ℂ) * (h : ℂ) * I = ((2 * π * n * h : ℝ) : ℂ) * I := by
        push_cast; ring
      rw [h_arg, Complex.norm_exp_ofReal_mul_I]
    rw [h_exp, norm_one] at h_tri
    linarith
  have hm_sq : ∀ (n : ℤ) (z : ℂ), ‖m n * z‖ ^ 2 ≤ 4 * ‖z‖ ^ 2 := by
    intro n z
    rw [norm_mul, mul_pow]
    have hm2 : ‖m n‖ ^ 2 ≤ 4 := by
      nlinarith [hm_bound n, norm_nonneg (m n)]
    exact mul_le_mul_of_nonneg_right hm2 (sq_nonneg _)
  have h_sum_lp : ∀ g : lp (fun _ : ℤ => ℂ) 2, Summable (fun n : ℤ => ‖g n‖ ^ 2) := by
    intro g
    have hg := (memℓp_gen_iff hp_pos).mp g.2
    simp_rw [h_rpow] at hg
    exact hg
  have h_mem : ∀ f : lp (fun _ : ℤ => ℂ) 2, Memℓp (fun n : ℤ => m n * f n) 2 := by
    intro f
    rw [memℓp_gen_iff hp_pos]
    simp_rw [h_rpow]
    exact Summable.of_nonneg_of_le (fun n => sq_nonneg _) (fun n => hm_sq n (f n))
      ((h_sum_lp f).mul_left 4)
  let T_h : lp (fun _ : ℤ => ℂ) 2 → lp (fun _ : ℤ => ℂ) 2 :=
    fun f => ⟨fun n => m n * f n, h_mem f⟩
  have h_norm_sq : ∀ g : lp (fun _ : ℤ => ℂ) 2, ‖g‖ ^ 2 = ∑' n : ℤ, ‖g n‖ ^ 2 := by
    intro g
    have hg := lp.norm_rpow_eq_tsum hp_pos g
    simp_rw [h_rpow] at hg
    exact hg
  have h_eq : ∀ f : lp (fun _ : ℤ => ℂ) 2, translateDiffSqT f h = ‖T_h f‖ ^ 2 := by
    intro f
    rw [h_norm_sq (T_h f)]
    rfl
  have h_lip : LipschitzWith 2 T_h := by
    refine LipschitzWith.of_dist_le_mul fun f g => ?_
    rw [dist_eq_norm, dist_eq_norm]
    have h_sub_pt : ∀ n : ℤ, ‖(T_h f - T_h g) n‖ ^ 2 ≤ 4 * ‖(f - g) n‖ ^ 2 := by
      intro n
      have h1 : (T_h f - T_h g) n = m n * (f - g) n := by
        change (T_h f) n - (T_h g) n = m n * (f n - g n)
        dsimp [T_h]
        ring
      rw [h1]
      exact hm_sq n ((f - g) n)
    have h_tsum_le : (∑' n : ℤ, ‖(T_h f - T_h g) n‖ ^ 2) ≤ ∑' n : ℤ, 4 * ‖(f - g) n‖ ^ 2 :=
      Summable.tsum_le_tsum h_sub_pt (h_sum_lp (T_h f - T_h g)) ((h_sum_lp (f - g)).mul_left 4)
    rw [tsum_mul_left, ← h_norm_sq (f - g)] at h_tsum_le
    apply lp.norm_le_of_tsum_le hp_pos (by positivity)
    simp_rw [h_rpow]
    calc
      (∑' i : ℤ, ‖(T_h f - T_h g) i‖ ^ 2) ≤ 4 * ‖f - g‖ ^ 2 := h_tsum_le
      _ = ((2 : NNReal) * ‖f - g‖) ^ 2 := by push_cast; ring
  have h_fun_eq : (fun f : lp (fun _ : ℤ => ℂ) 2 => translateDiffSqT f h) =
      (fun f => ‖T_h f‖ ^ 2) := funext h_eq
  rw [h_fun_eq]
  exact (continuous_pow 2).comp (continuous_norm.comp h_lip.continuous)

theorem kdv_well_posed_H_minus_one_torus
    (h_exists : ∀ q : CinfT, ∃ u : ℝ → CinfT, IsSmoothSolutionT u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → CinfT,
      IsSmoothSolutionT u → IsSmoothSolutionT v → u 0 = v 0 → u = v) :
    ∃ Φ : ℝ × Hm1T → Hm1T,
      Continuous Φ ∧ ExtendsSmoothFlowT Φ ∧
      (∀ Ψ : ℝ × Hm1T → Hm1T, Continuous Ψ → ExtendsSmoothFlowT Ψ → Ψ = Φ) ∧
      (∀ q : Hm1T, Bornology.IsBounded (Set.range fun t : ℝ => Φ (t, q))) ∧
      (∀ q : Hm1T, EquicontinuousHm1T (Set.range fun t : ℝ => Φ (t, q))) :=
by
  obtain ⟨h_cons, h_cauchy⟩ := smooth_flow_conservation_and_cauchyT h_exists h_unique
  obtain ⟨Φ, hΦ_cont, hΦ_ext⟩ :=
    smooth_flow_continuous_extensionT h_exists denseRange_iotaT
      smooth_solution_continuous_hm1T h_cauchy
  refine ⟨Φ, hΦ_cont, hΦ_ext, ?_, ?_, ?_⟩
  · intro Ψ hΨ_cont hΨ_ext
    have h_prod_dense : DenseRange (Prod.map (id : ℝ → ℝ) ιT) :=
      DenseRange.prodMap denseRange_id denseRange_iotaT
    apply DenseRange.equalizer h_prod_dense hΨ_cont hΦ_cont
    funext ⟨t, q₀⟩
    obtain ⟨u, hu_sol, hu0⟩ := h_exists q₀
    simp only [Function.comp_apply, Prod.map_apply, id_eq]
    rw [← hu0, hΨ_ext u hu_sol t, hΦ_ext u hu_sol t]
  · intro q
    obtain ⟨η, hη, M, hM⟩ := smooth_orbit_bounded_of_conservationT h_cons q
    rw [isBounded_iff_forall_norm_le]
    refine ⟨M + 1, ?_⟩
    rintro _ ⟨t, rfl⟩
    have h_cont_p : Continuous (fun p : Hm1T => Φ (t, p)) :=
      hΦ_cont.comp (continuous_const.prodMk continuous_id)
    obtain ⟨η₁, hη₁, h_close⟩ :=
      Metric.continuousAt_iff.mp h_cont_p.continuousAt 1 one_pos
    obtain ⟨q₀, hq₀⟩ := DenseRange.exists_dist_lt denseRange_iotaT q (lt_min hη hη₁)
    rw [dist_comm, dist_eq_norm] at hq₀
    obtain ⟨u, hu_sol, hu0⟩ := h_exists q₀
    have hu_bound : ‖ιT (u t)‖ ≤ M := by
      apply hM u hu_sol
      rw [hu0]
      exact (lt_min_iff.mp hq₀).1
    have h_phi_close : ‖Φ (t, ιT q₀) - Φ (t, q)‖ < 1 := by
      rw [← dist_eq_norm]
      apply h_close
      rw [dist_eq_norm]
      exact (lt_min_iff.mp hq₀).2
    have h_phi_eq : Φ (t, ιT q₀) = ιT (u t) := by
      rw [← hu0]
      exact hΦ_ext u hu_sol t
    rw [h_phi_eq] at h_phi_close
    have h_tri : ‖Φ (t, q)‖ ≤ ‖ιT (u t)‖ + ‖Φ (t, q) - ιT (u t)‖ :=
      norm_le_norm_add_norm_sub' (Φ (t, q)) (ιT (u t))
    rw [norm_sub_rev] at h_tri
    linarith
  · intro q ε hε
    obtain ⟨η, hη, δ, hδ, h_equi⟩ := smooth_orbit_equicontinuous_of_conservationT h_cons q ε hε
    refine ⟨δ, hδ, ?_⟩
    rintro _ ⟨t, rfl⟩ h hh
    have h_cont_td : Continuous (fun r : Hm1T => translateDiffSqT (r : lp (fun _ : ℤ => ℂ) 2) h) :=
      (continuous_translateDiffSqT h).comp continuous_subtype_val
    have h_cont_p : Continuous (fun r : Hm1T => translateDiffSqT (Φ (t, r) : lp (fun _ : ℤ => ℂ) 2) h) :=
      h_cont_td.comp (hΦ_cont.comp (continuous_const.prodMk continuous_id))
    obtain ⟨η₁, hη₁, h_close⟩ :=
      Metric.continuousAt_iff.mp h_cont_p.continuousAt (ε / 2) (half_pos hε)
    obtain ⟨q₀, hq₀⟩ := DenseRange.exists_dist_lt denseRange_iotaT q (lt_min hη hη₁)
    rw [dist_comm, dist_eq_norm] at hq₀
    obtain ⟨u, hu_sol, hu0⟩ := h_exists q₀
    have hu_equi : translateDiffSqT (ιT (u t) : lp (fun _ : ℤ => ℂ) 2) h < ε / 2 := by
      apply h_equi u hu_sol _ t h hh
      rw [hu0]
      exact (lt_min_iff.mp hq₀).1
    have h_td_close :
        dist (translateDiffSqT (Φ (t, ιT q₀) : lp (fun _ : ℤ => ℂ) 2) h)
             (translateDiffSqT (Φ (t, q) : lp (fun _ : ℤ => ℂ) 2) h) < ε / 2 := by
      apply h_close
      rw [dist_eq_norm]
      exact (lt_min_iff.mp hq₀).2
    have h_phi_eq : Φ (t, ιT q₀) = ιT (u t) := by
      rw [← hu0]
      exact hΦ_ext u hu_sol t
    rw [h_phi_eq, Real.dist_eq] at h_td_close
    linarith [abs_lt.mp h_td_close]
