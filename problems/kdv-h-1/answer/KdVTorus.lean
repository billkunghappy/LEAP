    obtain ⟨BΨ1, hBΨ1, hcΨ1_bd⟩ := h_per_bounded cΨ1
      ((h_smooth_iter k_fn hk_cd 2).1.continuous.neg.add
        ((continuous_const.mul (continuous_const.add hw_cd.continuous)).mul
