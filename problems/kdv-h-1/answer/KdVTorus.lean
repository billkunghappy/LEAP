    have h_int_kdv : Integrable (fun y : ℝ => greenKernel κ₀ w0 x y * kdvRHS w0 y * greenKernel κ₀ w0 y x) volume :=
      h_sandwich_int (kdvRHS w0) hkdv_cont hkdv_per
    have h_int_reg : Integrable (fun y : ℝ => greenKernel κ₀ w0 x y * regFlowRHS κ w0 y * greenKernel κ₀ w0 y x) volume :=
