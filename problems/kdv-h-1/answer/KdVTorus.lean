          volume 0 1 := by
      intro f hf n
      have hc : Continuous (fun x : ℝ => Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * (f x : ℂ)) := by
        fun_prop
      exact hc.intervalIntegrable 0 1
    have h_fc_sub : ∀ (f₁ f₂ : ℝ → ℝ), Continuous f₁ → Continuous f₂ → ∀ n : ℤ,
        fourierCircle (fun x => f₁ x - f₂ x) n = fourierCircle f₁ n - fourierCircle f₂ n := by
      intro f₁ f₂ hf₁ hf₂ n
      unfold fourierCircle
      have h_eq : (fun x : ℝ => Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * ((f₁ x - f₂ x : ℝ) : ℂ)) =
          (fun x : ℝ => Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * (f₁ x : ℂ) -
            Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * (f₂ x : ℂ)) := by
        ext x; push_cast; ring
      rw [h_eq, intervalIntegral.integral_sub (h_fc_int f₁ hf₁ n) (h_fc_int f₂ hf₂ n)]
    have h_fc_smul : ∀ (c : ℝ) (f : ℝ → ℝ), Continuous f → ∀ n : ℤ,
        fourierCircle (fun x => c * f x) n = (c : ℂ) * fourierCircle f n := by
      intro c f _hf n
      unfold fourierCircle
      have h_eq : (fun x : ℝ => Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * ((c * f x : ℝ) : ℂ)) =
          (fun x : ℝ => (c : ℂ) * (Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * (f x : ℂ))) := by
        ext x; push_cast; ring
      rw [h_eq, intervalIntegral.integral_const_mul]
    let w_hm2 : ℤ → ℝ := fun n => 1 / (4 + (2 * π * n) ^ 2) ^ 2
    have hw_hm2_nn : ∀ n : ℤ, 0 ≤ w_hm2 n := fun n => by dsimp [w_hm2]; positivity
    have hw_hm2_sum : Summable w_hm2 := by
      refine Summable.of_nonneg_of_le hw_hm2_nn (fun n => ?_) h_w1_sum
      dsimp [w_hm2]
