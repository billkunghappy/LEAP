      intro s hs
      by_contra! hs_gt
      have h_mem : δ' ^ 2 * κ ∈ Set.uIcc (f 0) (f s) :=
        Set.mem_uIcc.mpr (Or.inl ⟨by linarith, le_of_lt hs_gt⟩)
