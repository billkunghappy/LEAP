        ext x
        dsimp [F]
        rw [h_phase]
        ring
      rw [h_int_eq, h_fn, intervalIntegral.integral_mul_const]
      ring
    change (∫ x in (0 : ℝ)..1, f x) = _
    rw [h_lhs, ← h_int_hasSum.tsum_eq, tsum_congr h_term, tsum_neg]
  
  have h_goal3 : ∀ (n : ℤ) (ξ : ℝ),
      iterFreqPacketT κ₀ w0 0 n ξ =
        -fourierCircle w0 n / ((κ₀ ^ 2 + (2 * π * n - ξ) ^ 2 : ℝ) : ℂ) := by
    intro n ξ
    dsimp [iterFreqPacketT]
    rw [h_int_step 0 n ξ]
    have h_orth : ∀ j : ℤ,
        (∫ x in (0 : ℝ)..1,
          Complex.exp (-(((2 * π * ((n - j : ℤ) : ℝ) - (ξ - 2 * π * j) : ℝ) : ℂ) * (x : ℂ)) * I) *
            iterWavePacket κ₀ w0 0 x (ξ - 2 * π * j)) =
          if j = n then 1 else 0 := by
      intro j
      let c_j : ℂ := ((j - n : ℤ) : ℂ) * (2 * (π : ℂ) * I)
      have h_integrand : (fun x : ℝ =>
          Complex.exp (-(((2 * π * ((n - j : ℤ) : ℝ) - (ξ - 2 * π * j) : ℝ) : ℂ) * (x : ℂ)) * I) *
            iterWavePacket κ₀ w0 0 x (ξ - 2 * π * j)) =
          (fun x : ℝ => Complex.exp (c_j * (x : ℂ))) := by
        ext x
        dsimp [iterWavePacket, c_j]
        rw [← Complex.exp_add]
        congr 1; push_cast; ring
      rw [h_integrand]
      split_ifs with hj
      · subst hj
        have hc0 : c_j = 0 := by dsimp [c_j]; simp
        simp [hc0]
      · have hj_sub : j - n ≠ 0 := sub_ne_zero.mpr hj
        have h_pi_ne : (π : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
        have hc_ne : c_j ≠ 0 := by
          dsimp [c_j]
          exact mul_ne_zero (Int.cast_ne_zero.mpr hj_sub)
            (mul_ne_zero (mul_ne_zero two_ne_zero h_pi_ne) Complex.I_ne_zero)
        rw [integral_exp_mul_complex hc_ne]
        simp only [Complex.ofReal_one, Complex.ofReal_zero, mul_one, mul_zero, Complex.exp_zero]
        dsimp [c_j]
        rw [Complex.exp_int_mul_two_pi_mul_I (j - n), sub_self, zero_div]
    rw [tsum_eq_single n]
    · rw [h_orth n, if_pos rfl, one_mul,
          show (ξ - 2 * π * (n : ℝ)) ^ 2 = (2 * π * (n : ℝ) - ξ) ^ 2 by ring,
          neg_div]
    · intro j hj
      rw [h_orth j, if_neg hj, zero_mul, zero_div]
  
  have h_goal4 : ∀ (k : ℕ) (n : ℤ) (ξ : ℝ),
      iterFreqPacketT κ₀ w0 (k + 1) n ξ =
        -∑' j : ℤ,
          iterFreqPacketT κ₀ w0 k (n - j) (ξ - 2 * π * j) *
            fourierCircle w0 j / ((κ₀ ^ 2 + (ξ - 2 * π * j) ^ 2 : ℝ) : ℂ) := by
    intro k n ξ
    exact h_int_step (k + 1) n ξ
  exact ⟨h_goal1, h_goal2, h_goal3, h_goal4⟩

theorem greenIterKernel_higher_h1Kappa_and_diff_leT (κ₀ : ℝ) (hκ₀ : 1 ≤ κ₀)
    (h_fc : (∀ w : CinfT,
        Summable (fun n : ℤ => ‖fourierCircle (w : ℝ → ℝ) n‖) ∧
        Summable (fun n : ℤ => ‖fourierCircle (w : ℝ → ℝ) n‖ ^ 2 / (4 * κ₀ ^ 2 + (2 * π * n) ^ 2)) ∧
        hm1KappaSqT κ₀ (ιT w) =
          ∑' n : ℤ, ‖fourierCircle (w : ℝ → ℝ) n‖ ^ 2 / (4 * κ₀ ^ 2 + (2 * π * n) ^ 2)) ∧
      (∀ u₁ u₂ : CinfT,
        Summable (fun n : ℤ =>
          ‖fourierCircle (u₁ : ℝ → ℝ) n - fourierCircle (u₂ : ℝ → ℝ) n‖ ^ 2 /
            (4 * κ₀ ^ 2 + (2 * π * n) ^ 2)) ∧
        hm1KappaSqT κ₀ (ιT u₁ - ιT u₂) =
          ∑' n : ℤ,
            ‖fourierCircle (u₁ : ℝ → ℝ) n - fourierCircle (u₂ : ℝ → ℝ) n‖ ^ 2 /
              (4 * κ₀ ^ 2 + (2 * π * n) ^ 2)))
    (h_freq : ∀ w : CinfT,
      (∀ k : ℕ,
        (∀ n : ℤ, Continuous (fun ξ : ℝ => iterFreqPacketT κ₀ (w : ℝ → ℝ) k n ξ)) ∧
        ∃ M : ℝ, 0 ≤ M ∧ ∀ (n : ℤ) (ξ : ℝ), ‖iterFreqPacketT κ₀ (w : ℝ → ℝ) k n ξ‖ ≤ M) ∧
      (∀ (m : ℕ) (n : ℤ),
        fourierCircle (fun x : ℝ => greenIterKernel κ₀ (w : ℝ → ℝ) (m + 2) x x) n =
          (1 / (2 * π) : ℂ) * ∫ ξ : ℝ,
            iterFreqPacketT κ₀ (w : ℝ → ℝ) (m + 1) n ξ / ((κ₀ ^ 2 + ξ ^ 2 : ℝ) : ℂ)) ∧
      (∀ (n : ℤ) (ξ : ℝ),
        iterFreqPacketT κ₀ (w : ℝ → ℝ) 0 n ξ =
          -fourierCircle (w : ℝ → ℝ) n / ((κ₀ ^ 2 + (2 * π * n - ξ) ^ 2 : ℝ) : ℂ)) ∧
      (∀ (k : ℕ) (n : ℤ) (ξ : ℝ),
        iterFreqPacketT κ₀ (w : ℝ → ℝ) (k + 1) n ξ =
          -∑' j : ℤ,
            iterFreqPacketT κ₀ (w : ℝ → ℝ) k (n - j) (ξ - 2 * π * j) *
              fourierCircle (w : ℝ → ℝ) j / ((κ₀ ^ 2 + (ξ - 2 * π * j) ^ 2 : ℝ) : ℂ)))
    (h_bf : (∀ ξ : ℝ,
        Summable (fun m : ℤ => 1 / (κ₀ ^ 2 + (ξ - 2 * π * m) ^ 2)) ∧
        (∑' m : ℤ, 1 / (κ₀ ^ 2 + (ξ - 2 * π * m) ^ 2)) ≤ 41 / κ₀) ∧
      (∀ (η : ℝ) (c : ℤ → ℝ),
        (∀ n : ℤ, 0 ≤ c n) → Summable c →
        Summable (fun m : ℤ =>
          (1 / (κ₀ ^ 2 + (η + 2 * π * m) ^ 2)) *
            (∑' n : ℤ, c n / (κ₀ ^ 2 + (η + 2 * π * (m - n)) ^ 2))) ∧
        (∑' m : ℤ,
          (1 / (κ₀ ^ 2 + (η + 2 * π * m) ^ 2)) *
            (∑' n : ℤ, c n / (κ₀ ^ 2 + (η + 2 * π * (m - n)) ^ 2))) ≤
          (169 / κ₀) * ∑' n : ℤ, c n / (4 * κ₀ ^ 2 + (2 * π * n) ^ 2)))
    (w₁ w₂ : CinfT)
    (hw₁ : hm1KappaSqT κ₀ (ιT w₁) ≤ (1 / (256 * 13)) ^ 2 * κ₀)
    (hw₂ : hm1KappaSqT κ₀ (ιT w₂) ≤ (1 / (256 * 13)) ^ 2 * κ₀)
    (m : ℕ) :
    Summable (fun n : ℤ =>
      (4 * κ₀ ^ 2 + (2 * π * n) ^ 2) *
        ‖fourierCircle (fun x => κ₀ * greenIterKernel κ₀ (w₁ : ℝ → ℝ) (m + 2) x x) n‖ ^ 2) ∧
    h1KappaNormSqT κ₀ (fun x => κ₀ * greenIterKernel κ₀ (w₁ : ℝ → ℝ) (m + 2) x x) ≤
      4 * (1 / 256 : ℝ) ^ (2 * (m + 1)) * hm1KappaSqT κ₀ (ιT w₁) ∧
    Summable (fun n : ℤ =>
      (4 * κ₀ ^ 2 + (2 * π * n) ^ 2) *
        ‖fourierCircle (fun x =>
          κ₀ * greenIterKernel κ₀ (w₁ : ℝ → ℝ) (m + 2) x x -
          κ₀ * greenIterKernel κ₀ (w₂ : ℝ → ℝ) (m + 2) x x) n‖ ^ 2) ∧
    h1KappaNormSqT κ₀ (fun x =>
      κ₀ * greenIterKernel κ₀ (w₁ : ℝ → ℝ) (m + 2) x x -
      κ₀ * greenIterKernel κ₀ (w₂ : ℝ → ℝ) (m + 2) x x) ≤
      4 * (4 * (1 / 256 : ℝ) ^ 2) ^ (m + 1) * hm1KappaSqT κ₀ (ιT w₁ - ιT w₂) :=
by
  have hκ₀_pos : 0 < κ₀ := by linarith
  have hκ₀_nn : 0 ≤ κ₀ := by linarith
  have h_denom_pos : ∀ η : ℝ, 0 < κ₀ ^ 2 + η ^ 2 := fun η => by positivity
  have h_denom_ge1 : ∀ η : ℝ, 1 ≤ κ₀ ^ 2 + η ^ 2 := fun η => by
    nlinarith [sq_nonneg η, sq_nonneg (κ₀ - 1)]
  obtain ⟨h_inv_int, h_inv_val⟩ := (KdV.freeGreenKernel_fourier_integral_eq κ₀ hκ₀).1
  
  have h_conv : ∀ ζ : ℝ,
      Integrable (fun ξ : ℝ => 1 / (2 * π * (κ₀ ^ 2 + (ζ - ξ) ^ 2) * (κ₀ ^ 2 + ξ ^ 2))) volume ∧
      (∫ ξ : ℝ, 1 / (2 * π * (κ₀ ^ 2 + (ζ - ξ) ^ 2) * (κ₀ ^ 2 + ξ ^ 2))) ≤
        2 / (κ₀ * (4 * κ₀ ^ 2 + ζ ^ 2)) := by
    intro ζ
    set W : ℝ := 4 * κ₀ ^ 2 + ζ ^ 2
    have hW_pos : 0 < W := by dsimp [W]; positivity
    let g1 : ℝ → ℝ := fun ξ => (1 / (2 * π)) * (1 / (κ₀ ^ 2 + (ζ - ξ) ^ 2))
