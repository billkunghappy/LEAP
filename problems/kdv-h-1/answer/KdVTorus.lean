  obtain ⟨h_fg_bd, h_fg_int1, h_fg_int2, h_fg_ft⟩ := h_fg_all
  have h_fg : (∀ x y : ℝ, 0 ≤ freeGreenKernel κ x y ∧ |freeGreenKernel κ x y| ≤ 1 / (2 * κ)) ∧
      (∀ y : ℝ, Integrable (fun z : ℝ => freeGreenKernel κ y z) volume ∧
