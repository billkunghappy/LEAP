      rw [← integrableOn_univ, ← Set.Iic_union_Ioi (a := (0 : ℝ))]
      exact hf_R_Iic.union (hf_R_Ici.mono_set Set.Ioi_subset_Ici_self)
    have h_fg_int_right : ∀ y : ℝ, Integrable (fun z : ℝ => freeGreenKernel κ y z) volume := by
      intro y
      have h_eq : (fun z : ℝ => freeGreenKernel κ y z) = (fun z : ℝ => (1 / (2 * κ)) * f_R (z - y)) := by
        ext z
        dsimp [freeGreenKernel, f_R]
