      have h_v_le : |iteratedDeriv d (v₁ : ℝ → ℝ) y| ≤ M_v := h_iter_le v₁ d y
      have h_mul_v : |(s' - s₀) * iteratedDeriv d (v₁ : ℝ → ℝ) y| ≤ M_v * |s' - s₀| := by
        rw [abs_mul, mul_comm]
        exact mul_le_mul_of_nonneg_right h_v_le (abs_nonneg _)
      have h_tri1 := abs_sub_le
        (iteratedDeriv d (f s' : ℝ → ℝ) y - iteratedDeriv d (f s₀ : ℝ → ℝ) y)
        ((s' - s₀) * iteratedDeriv d (v₁ : ℝ → ℝ) y) 0
      rw [sub_zero, sub_zero] at h_tri1
      have h_diff_le : |iteratedDeriv d (f s' : ℝ → ℝ) y - iteratedDeriv d (f s₀ : ℝ → ℝ) y| ≤
          (1 + M_v) * |s' - s₀| := by linarith
      have h_close : |iteratedDeriv d (f s' : ℝ → ℝ) y - iteratedDeriv d (f s₀ : ℝ → ℝ) y| ≤ r := by
