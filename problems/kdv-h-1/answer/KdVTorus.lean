    fun ℓ x => (h_all_x x).1 ℓ,
    fun x => (h_all_x x).2.1,
    fun m x => (h_all_x x).2.2 m⟩

theorem alphaFunctionalT_cubic_remainder_bound (h_two : ∀ (κ : ℝ), 1 ≤ κ → ∀ (w : CinfT),
      (∫ x in (0 : ℝ)..1, greenIterKernel κ (w : ℝ → ℝ) 2 x x) ≤
        (1 / κ ^ 3) * hm1KappaSqT κ (ιT w))
    (h_dom : ∀ (κ : ℝ), 1 ≤ κ → ∀ (w : CinfT),
      let r := 13 * Real.sqrt ((1 / κ) * hm1KappaSqT κ (ιT w))
      (∀ ℓ : ℕ, Continuous (fun x : ℝ => greenIterKernel κ (w : ℝ → ℝ) ℓ x x) ∧
        Function.Periodic (fun x : ℝ => greenIterKernel κ (w : ℝ → ℝ) ℓ x x) 1) ∧
      (∀ ℓ : ℕ, ∀ x : ℝ, |greenIterKernel κ (w : ℝ → ℝ) ℓ x x| ≤ (1 / (2 * κ)) * r ^ ℓ) ∧
      (∀ x : ℝ, (greenIterKernel κ (w : ℝ → ℝ) 1 x x) ^ 2 ≤
        (1 / (2 * κ)) * greenIterKernel κ (w : ℝ → ℝ) 2 x x) ∧
      (∀ m : ℕ, ∀ x : ℝ, |greenIterKernel κ (w : ℝ → ℝ) (m + 2) x x| ≤
        r ^ m * greenIterKernel κ (w : ℝ → ℝ) 2 x x))
    (κ : ℝ) (hκ : 1 ≤ κ) (w : CinfT)
    (hw : hm1KappaSqT κ (ιT w) ≤ (1 / (256 * 13)) ^ 2 * κ) :
    |κ * alphaFunctionalT κ (w : ℝ → ℝ) - κ * alphaQuadFunctionalT κ (w : ℝ → ℝ)| ≤
      (1 / 8) * hm1KappaSqT κ (ιT w) :=
by
  have hκ_pos : 0 < κ := by linarith
  have hκ_ne : κ ≠ 0 := ne_of_gt hκ_pos
  have h_hm1_nn : 0 ≤ hm1KappaSqT κ (ιT w) := by
    dsimp [hm1KappaSqT]
    exact tsum_nonneg (fun n => by positivity)
  set r := 13 * Real.sqrt ((1 / κ) * hm1KappaSqT κ (ιT w))
  have hr_nn : 0 ≤ r := by positivity
  have hr_le_delta : r ≤ 1 / 256 := by
    have h_r_sq_le : (1 / κ) * hm1KappaSqT κ (ιT w) ≤ (1 / (256 * 13) : ℝ) ^ 2 := by
      calc (1 / κ) * hm1KappaSqT κ (ιT w)
        _ ≤ (1 / κ) * ((1 / (256 * 13)) ^ 2 * κ) :=
          mul_le_mul_of_nonneg_left hw (by positivity)
        _ = (1 / (256 * 13) : ℝ) ^ 2 := by
          field_simp
    have h_sqrt_le : Real.sqrt ((1 / κ) * hm1KappaSqT κ (ιT w)) ≤ 1 / (256 * 13) :=
