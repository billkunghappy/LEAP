    rw [h_diff_int_eq, h_kdv_val, h_reg_val, h_flux_deriv, hg₀_eq x]
    have hm0_ne : 1 / (2 * κ₀) + m0 x ≠ 0 := by
      rw [← hg₀_eq x]
