          deriv (diagGreen κ (q₂ : ℝ → ℝ)) x) ∈ CinfT := h_sub_cinfT _ _ h_ddg1 h_ddg2
      have h_eq_sub := h_iota_sub
        ⟨deriv (diagGreen κ (q₁ : ℝ → ℝ)), h_ddg1⟩
        ⟨deriv (diagGreen κ (q₂ : ℝ → ℝ)), h_ddg2⟩
        h_sub_ddg
      have h_congr_deriv : ιT ⟨fun x : ℝ => deriv (diagGreen κ (q₁ : ℝ → ℝ)) x -
          deriv (diagGreen κ (q₂ : ℝ → ℝ)) x, h_sub_ddg⟩ =
          ιT ⟨deriv (g_diff : ℝ → ℝ), h_deriv_gdiff⟩ := by
        refine h_iota_congr _ _ _ _ (fun x => ?_)
        have hd1 : DifferentiableAt ℝ (diagGreen κ (q₁ : ℝ → ℝ)) x :=
          h_dg1.1.differentiable (by simp) x
        have hd2 : DifferentiableAt ℝ (diagGreen κ (q₂ : ℝ → ℝ)) x :=
          h_dg2.1.differentiable (by simp) x
        exact (deriv_sub hd1 hd2).symm
      rw [← h_eq_sub, h_congr_deriv]
      exact h_deriv_hm1 g_diff h_deriv_gdiff (26 * ‖ιT q₁ - ιT q₂‖) (by positivity) hg_diff_bound
    have h_smul1 := h_iota_smul (16 * κ ^ 5) ⟨deriv (diagGreen κ (q₁ : ℝ → ℝ)), h_ddg1⟩ (hF_cinf q₁ hq₁)
    have h_smul2 := h_iota_smul (16 * κ ^ 5) ⟨deriv (diagGreen κ (q₂ : ℝ → ℝ)), h_ddg2⟩ (hF_cinf q₂ hq₂)
    rw [h_smul1, h_smul2, ← smul_sub, norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity)]
    calc (16 * κ ^ 5) * ‖ιT ⟨deriv (diagGreen κ (q₁ : ℝ → ℝ)), h_ddg1⟩ -
          ιT ⟨deriv (diagGreen κ (q₂ : ℝ → ℝ)), h_ddg2⟩‖
      _ ≤ (16 * κ ^ 5) * (26 * ‖ιT q₁ - ιT q₂‖) :=
        mul_le_mul_of_nonneg_left h_ddg_diff_bound (by positivity)
      _ = 416 * κ ^ 5 * ‖ιT q₁ - ιT q₂‖ := by ring
  refine ⟨hV_mem, hV_small, hV_large, ?_, ?_⟩
  · intro q hq
    by_cases hq_ball : rFn q ≤ 2 * δ'
    · rw [hV_eq_smul q hq_ball hq, norm_smul, Real.norm_eq_abs,
          abs_of_nonneg (hχ_range (rFn q)).1]
      calc regCutoff δ' (rFn q) *
            ‖ιT ⟨fun x : ℝ => 16 * κ ^ 5 * deriv (diagGreen κ (q : ℝ → ℝ)) x, hF_cinf q hq_ball⟩‖
        _ ≤ 1 * (832 * κ ^ 5 * δ') :=
          mul_le_mul (hχ_range (rFn q)).2 (hF_2δ' q hq_ball) (norm_nonneg _) zero_le_one
        _ = 832 * κ ^ 5 * δ' := one_mul _
    · rw [hV_eq_zero_of_ge q (le_of_not_ge hq_ball) hq, norm_zero]
      positivity
  · have h_mixed : ∀ (q₁ q₂ : CinfT) (hq₁ : regTruncatedVecFnT δ' κ q₁ ∈ CinfT)
        (hq₂ : regTruncatedVecFnT δ' κ q₂ ∈ CinfT),
        rFn q₁ ≤ 2 * δ' → 2 * δ' ≤ rFn q₂ →
        ‖ιT ⟨regTruncatedVecFnT δ' κ q₁, hq₁⟩ - ιT ⟨regTruncatedVecFnT δ' κ q₂, hq₂⟩‖ ≤
          1248 * κ ^ 5 * ‖ιT q₁ - ιT q₂‖ := by
      intro q₁ q₂ hq₁ hq₂ h1 h2
      rw [hV_eq_zero_of_ge q₂ h2 hq₂, sub_zero, hV_eq_smul q₁ h1 hq₁,
          norm_smul, Real.norm_eq_abs, abs_of_nonneg (hχ_range (rFn q₁)).1]
      have hχ_2δ' : regCutoff δ' (2 * δ') = 0 := hχ_vanish (2 * δ') le_rfl
      have hχ1_bound : regCutoff δ' (rFn q₁) ≤ (1 / δ') * ‖ιT q₁ - ιT q₂‖ := by
        have h_lip_2δ' := hχ_lip (rFn q₁) (2 * δ')
        rw [hχ_2δ', sub_zero, abs_of_nonneg (hχ_range (rFn q₁)).1] at h_lip_2δ'
        have h_diff_le : |rFn q₁ - 2 * δ'| ≤ ‖ιT q₁ - ιT q₂‖ := by
          have h_sub_nonpos : rFn q₁ - 2 * δ' ≤ 0 := by linarith
          rw [abs_of_nonpos h_sub_nonpos]
          have h_le1 : -(rFn q₁ - 2 * δ') ≤ rFn q₂ - rFn q₁ := by linarith
          have h_le2 : rFn q₂ - rFn q₁ ≤ |rFn q₁ - rFn q₂| := by
            rw [abs_sub_comm]
            exact le_abs_self _
          have h_le3 := hrFn_lip q₁ q₂
          linarith
        exact le_trans h_lip_2δ' (mul_le_mul_of_nonneg_left h_diff_le (by positivity))
      calc regCutoff δ' (rFn q₁) *
            ‖ιT ⟨fun x : ℝ => 16 * κ ^ 5 * deriv (diagGreen κ (q₁ : ℝ → ℝ)) x, hF_cinf q₁ h1⟩‖
        _ ≤ ((1 / δ') * ‖ιT q₁ - ιT q₂‖) * (832 * κ ^ 5 * δ') :=
          mul_le_mul hχ1_bound (hF_2δ' q₁ h1) (norm_nonneg _) (by positivity)
        _ = 832 * κ ^ 5 * ‖ιT q₁ - ιT q₂‖ := by
          field_simp [hδ'_ne]
        _ ≤ 1248 * κ ^ 5 * ‖ιT q₁ - ιT q₂‖ := by
          have : 0 ≤ κ ^ 5 * ‖ιT q₁ - ιT q₂‖ := by positivity
          linarith
    intro q₁ q₂ hq₁ hq₂
    by_cases h1 : rFn q₁ ≤ 2 * δ'
    · by_cases h2 : rFn q₂ ≤ 2 * δ'
      · rw [hV_eq_smul q₁ h1 hq₁, hV_eq_smul q₂ h2 hq₂]
        set χ₁ := regCutoff δ' (rFn q₁)
        set χ₂ := regCutoff δ' (rFn q₂)
        set F₁ := ιT ⟨fun x : ℝ => 16 * κ ^ 5 * deriv (diagGreen κ (q₁ : ℝ → ℝ)) x, hF_cinf q₁ h1⟩
        set F₂ := ιT ⟨fun x : ℝ => 16 * κ ^ 5 * deriv (diagGreen κ (q₂ : ℝ → ℝ)) x, hF_cinf q₂ h2⟩
        have h_decomp : χ₁ • F₁ - χ₂ • F₂ = (χ₁ - χ₂) • F₁ + χ₂ • (F₁ - F₂) := by
          rw [sub_smul, smul_sub, sub_add_sub_cancel]
        rw [h_decomp]
        have h_tri := norm_add_le ((χ₁ - χ₂) • F₁) (χ₂ • (F₁ - F₂))
        rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
            abs_of_nonneg (hχ_range (rFn q₂)).1] at h_tri
        have h_χ_diff : |χ₁ - χ₂| ≤ (1 / δ') * ‖ιT q₁ - ιT q₂‖ :=
          le_trans (hχ_lip (rFn q₁) (rFn q₂))
            (mul_le_mul_of_nonneg_left (hrFn_lip q₁ q₂) (by positivity))
        have h_term1 : |χ₁ - χ₂| * ‖F₁‖ ≤ 832 * κ ^ 5 * ‖ιT q₁ - ιT q₂‖ := by
          calc |χ₁ - χ₂| * ‖F₁‖
            _ ≤ ((1 / δ') * ‖ιT q₁ - ιT q₂‖) * (832 * κ ^ 5 * δ') :=
              mul_le_mul h_χ_diff (hF_2δ' q₁ h1) (norm_nonneg _) (by positivity)
            _ = 832 * κ ^ 5 * ‖ιT q₁ - ιT q₂‖ := by
              field_simp [hδ'_ne]
        have h_term2 : χ₂ * ‖F₁ - F₂‖ ≤ 416 * κ ^ 5 * ‖ιT q₁ - ιT q₂‖ := by
          calc χ₂ * ‖F₁ - F₂‖
            _ ≤ 1 * (416 * κ ^ 5 * ‖ιT q₁ - ιT q₂‖) :=
              mul_le_mul (hχ_range (rFn q₂)).2 (hF_lip q₁ q₂ h1 h2) (norm_nonneg _) zero_le_one
            _ = 416 * κ ^ 5 * ‖ιT q₁ - ιT q₂‖ := one_mul _
        linarith
      · exact h_mixed q₁ q₂ hq₁ hq₂ h1 (le_of_not_ge h2)
    · by_cases h2 : rFn q₂ ≤ 2 * δ'
      · rw [norm_sub_rev, norm_sub_rev (ιT q₁) (ιT q₂)]
        exact h_mixed q₂ q₁ hq₂ hq₁ h2 (le_of_not_ge h1)
      · rw [hV_eq_zero_of_ge q₁ (le_of_not_ge h1) hq₁,
            hV_eq_zero_of_ge q₂ (le_of_not_ge h2) hq₂, sub_self, norm_zero]
        positivity

theorem regTruncatedVecT_cinfSeminorm_linear_growth (δ' : ℝ) (hδ'_pos : 0 < δ') (hδ'_le : δ' ≤ 1 / 52)
    (κ : ℝ) (hκ : 2 ≤ κ)
    (h_vanish : ∀ q : CinfT, (2 * δ') ^ 2 * κ ≤ hm1KappaSqT κ (ιT q) →
      ∀ x : ℝ, regTruncatedVecFnT δ' κ q x = 0)
    (n : ℕ) (M : ℕ → ℝ) :
    ∃ (A B : ℝ), 0 ≤ A ∧ 0 ≤ B ∧
      ∀ q : CinfT,
        (∀ m < n, cinfSeminormT m (q : ℝ → ℝ) ≤ M m) →
        cinfSeminormT n (regTruncatedVecFnT δ' κ q) ≤
          A * cinfSeminormT n (q : ℝ → ℝ) + B :=
by
  have hκ1 : 1 ≤ κ := by linarith
  have hκ_pos : 0 < κ := by linarith
  have hκ_ne : κ ≠ 0 := ne_of_gt hκ_pos
  
  have h_semi_nn : ∀ (m : ℕ) (f : ℝ → ℝ), 0 ≤ cinfSeminormT m f := by
    intro m f
    unfold cinfSeminormT
    refine Real.sSup_nonneg ?_
    rintro y ⟨x, _, rfl⟩
    exact abs_nonneg _
  have h_semi_zero : ∀ (m : ℕ), cinfSeminormT m (fun _ : ℝ => 0) = 0 := by
    intro m
    refine le_antisymm ?_ (h_semi_nn m _)
    unfold cinfSeminormT
    refine csSup_le ⟨|iteratedDeriv m (fun _ : ℝ => 0) 0|, ⟨0, ⟨le_rfl, zero_le_one⟩, rfl⟩⟩ ?_
    rintro y ⟨x, _, rfl⟩
    simp [iteratedDeriv_const]
  have h_semi_le : ∀ (m : ℕ) (f : ℝ → ℝ) (B : ℝ),
      0 ≤ B → (∀ x ∈ Set.Icc (0 : ℝ) 1, |iteratedDeriv m f x| ≤ B) →
      cinfSeminormT m f ≤ B := by
    intro m f B _ hB
    unfold cinfSeminormT
    refine csSup_le ⟨|iteratedDeriv m f 0|, ⟨0, ⟨le_rfl, zero_le_one⟩, rfl⟩⟩ ?_
    rintro y ⟨x, hx, rfl⟩
    exact hB x hx
  have h_iter_const_mul : ∀ (k : ℕ) (c : ℝ) (h : ℝ → ℝ) (x : ℝ),
      iteratedDeriv k (fun y : ℝ => c * h y) x = c * iteratedDeriv k h x := by
    intro k
    induction k with
    | zero =>
      intro c h x
      simp [iteratedDeriv_zero]
    | succ k ih =>
      intro c h x
      rw [iteratedDeriv_succ', iteratedDeriv_succ']
      have h_deriv_eq : deriv (fun y : ℝ => c * h y) = fun y : ℝ => c * deriv h y :=
        funext (fun y => deriv_const_mul_field c)
      rw [h_deriv_eq]
      exact ih c (deriv h) x
  have h_iter_add : ∀ (f : ℝ → ℝ) (m k : ℕ),
      iteratedDeriv m (iteratedDeriv k f) = iteratedDeriv (m + k) f := by
    intro f m
    induction m with
    | zero =>
      intro k
      rw [iteratedDeriv_zero, Nat.zero_add]
    | succ m ih =>
      intro k
      rw [iteratedDeriv_succ, ih k, ← iteratedDeriv_succ, Nat.add_right_comm m 1 k]
  have hW_smooth : ∀ (q : CinfT) (k : ℕ), ContDiff ℝ (⊤ : ℕ∞) (iteratedDeriv k (q : ℝ → ℝ)) := by
    intro q k
    refine contDiff_of_differentiable_iteratedDeriv (fun m _ => ?_)
    rw [h_iter_add (q : ℝ → ℝ) m k]
    exact q.2.1.differentiable_iteratedDeriv (m + k)
      (WithTop.coe_lt_coe.mpr (WithTop.coe_lt_top (m + k)))
  have hW_per : ∀ (q : CinfT) (k : ℕ), Function.Periodic (iteratedDeriv k (q : ℝ → ℝ)) 1 := by
    intro q k x
    have h_shift : (fun z : ℝ => (q : ℝ → ℝ) (z + 1)) = (q : ℝ → ℝ) := funext q.2.2
    calc iteratedDeriv k (q : ℝ → ℝ) (x + 1)
      _ = iteratedDeriv k (fun z : ℝ => (q : ℝ → ℝ) (z + 1)) x :=
        (congrFun (iteratedDeriv_comp_add_const k (q : ℝ → ℝ) 1) x).symm
      _ = iteratedDeriv k (q : ℝ → ℝ) x := by rw [h_shift]
  have h_iter_le : ∀ (q : CinfT) (k : ℕ) (x : ℝ),
      |iteratedDeriv k (q : ℝ → ℝ) x| ≤ cinfSeminormT k (q : ℝ → ℝ) := by
    intro q k x
    let y : ℝ := Int.fract x
    have hy_mem : y ∈ Set.Icc (0 : ℝ) 1 := ⟨Int.fract_nonneg x, le_of_lt (Int.fract_lt_one x)⟩
    have hx_eq : y + (⌊x⌋ : ℝ) * 1 = x := by
      dsimp [y]
      linarith [Int.self_sub_floor x]
    have h_per_x : iteratedDeriv k (q : ℝ → ℝ) x = iteratedDeriv k (q : ℝ → ℝ) y := by
      calc iteratedDeriv k (q : ℝ → ℝ) x
        _ = iteratedDeriv k (q : ℝ → ℝ) (y + (⌊x⌋ : ℝ) * 1) := by rw [hx_eq]
        _ = iteratedDeriv k (q : ℝ → ℝ) y := (hW_per q k).int_mul ⌊x⌋ y
    rw [h_per_x]
    unfold cinfSeminormT
    have h_cont : Continuous (fun z : ℝ => |iteratedDeriv k (q : ℝ → ℝ) z|) :=
      continuous_abs.comp ((hW_smooth q k).continuous)
    have h_bdd : BddAbove (Set.image (fun z : ℝ => |iteratedDeriv k (q : ℝ → ℝ) z|) (Set.Icc 0 1)) :=
      isCompact_Icc.bddAbove_image h_cont.continuousOn
    exact le_csSup h_bdd ⟨y, hy_mem, rfl⟩
  
  have h_fc_deriv : ∀ (f : CinfT) (k : ℤ),
      ‖fourierCircle (deriv (f : ℝ → ℝ)) k‖ ^ 2 =
        (2 * π * (k : ℝ)) ^ 2 * ‖fourierCircle (f : ℝ → ℝ) k‖ ^ 2 := by
    intro f k
    let f₀ : ℝ → ℝ := (f : ℝ → ℝ)
    let f₁ : ℝ → ℝ := deriv f₀
    have hf₀_smooth : ContDiff ℝ (⊤ : ℕ∞) f₀ := f.2.1
    have hf₀_per : Function.Periodic f₀ 1 := f.2.2
    have hf₀_cont : Continuous f₀ := hf₀_smooth.continuous
    have hf₀_diff : Differentiable ℝ f₀ := hf₀_smooth.differentiable (by decide)
    have hf₁_cont : Continuous f₁ := hf₀_smooth.continuous_deriv (by decide)
    let c : ℂ := -(((2 * π * (k : ℝ) : ℝ) : ℂ) * I)
    let E : ℝ → ℂ := fun x => Complex.exp (-(((2 * π * k : ℝ) : ℂ) * (x : ℂ)) * I)
    have hE_cont : Continuous E := by
      dsimp [E]
      fun_prop
    let Φ : ℝ → ℂ := fun x => E x * (f₀ x : ℂ)
    let term1 : ℝ → ℂ := fun x => c * (E x * (f₀ x : ℂ))
    let term2 : ℝ → ℂ := fun x => E x * (f₁ x : ℂ)
    have hΦ_deriv : ∀ x ∈ Set.uIcc (0 : ℝ) 1, HasDerivAt Φ (term1 x + term2 x) x := by
      intro x _
      have hd_lin : HasDerivAt (fun y : ℝ => -(((2 * π * k : ℝ) : ℂ) * (y : ℂ)) * I) c x := by
        have h1 : HasDerivAt (fun y : ℝ => (y : ℂ)) 1 x := (hasDerivAt_id x).ofReal_comp
        have h2 := (h1.const_mul (((2 * π * k : ℝ) : ℂ))).neg.mul_const I
        convert h2 using 1
        dsimp [c]
        ring
      have hd_E : HasDerivAt E (E x * c) x := hd_lin.cexp
      have hd_f : HasDerivAt (fun y : ℝ => (f₀ y : ℂ)) (f₁ x : ℂ) x :=
        (hf₀_diff x).hasDerivAt.ofReal_comp
      have hd_prod := hd_E.mul hd_f
      convert hd_prod using 1
      dsimp [term1, term2]
      ring
    have h_int1 : IntervalIntegrable term1 volume 0 1 :=
      (continuous_const.mul (hE_cont.mul (Complex.continuous_ofReal.comp hf₀_cont))).intervalIntegrable 0 1
    have h_int2 : IntervalIntegrable term2 volume 0 1 :=
      (hE_cont.mul (Complex.continuous_ofReal.comp hf₁_cont)).intervalIntegrable 0 1
    have h_ftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hΦ_deriv (h_int1.add h_int2)
    have hΦ_eq : Φ 1 = Φ 0 := by
      dsimp [Φ]
      have hf_01 : f₀ 1 = f₀ 0 := by
        have h0 := hf₀_per 0
        simpa using h0
      have hE_1 : E 1 = 1 := by
        dsimp [E]
        have h_arg : -(((2 * π * k : ℝ) : ℂ) * 1) * I = ((-k : ℤ) : ℂ) * (2 * (π : ℂ) * I) := by
          push_cast
          ring
        rw [h_arg]
        exact Complex.exp_int_mul_two_pi_mul_I (-k)
      have hE_0 : E 0 = 1 := by
        dsimp [E]
        simp
      rw [hE_1, hE_0, hf_01]
    rw [hΦ_eq, sub_self, intervalIntegral.integral_add h_int1 h_int2] at h_ftc
    have h_t1 : (∫ x in (0 : ℝ)..1, term1 x) = c * fourierCircle f₀ k := by
      dsimp [term1, fourierCircle, E]
      exact intervalIntegral.integral_const_mul c _
    have h_t2 : (∫ x in (0 : ℝ)..1, term2 x) = fourierCircle f₁ k := rfl
    rw [h_t1, h_t2] at h_ftc
    have h_fc_eq : fourierCircle f₁ k = -c * fourierCircle f₀ k := by
      rw [neg_mul]
      exact eq_neg_of_add_eq_zero_right h_ftc
    rw [h_fc_eq, norm_mul, mul_pow]
    congr 1
    dsimp [c]
    rw [neg_neg, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs, sq_abs]
  have h_deriv_hm1 : ∀ (q : CinfT) (i : ℕ),
      13 * Real.sqrt ((1 / κ) * hm1KappaSqT κ
        (ιT ⟨iteratedDeriv (i + 1) (q : ℝ → ℝ), hW_smooth q (i + 1), hW_per q (i + 1)⟩)) ≤
        13 * cinfSeminormT i (q : ℝ → ℝ) := by
    intro q i
    let W_i : CinfT := ⟨iteratedDeriv i (q : ℝ → ℝ), hW_smooth q i, hW_per q i⟩
    let W_succ : CinfT := ⟨iteratedDeriv (i + 1) (q : ℝ → ℝ), hW_smooth q (i + 1), hW_per q (i + 1)⟩
    have hW_succ_eq : (W_succ : ℝ → ℝ) = deriv (W_i : ℝ → ℝ) := iteratedDeriv_succ
    obtain ⟨h_sum_Wi, _, h_auto_Wi⟩ := hm1KappaSqT_and_autocorrelation_fourierCircle κ hκ1 W_i
    obtain ⟨_, h_hm1_Wsucc, _⟩ := hm1KappaSqT_and_autocorrelation_fourierCircle κ hκ1 W_succ
    have h_pw_le : ∀ k : ℤ,
        ‖fourierCircle (W_succ : ℝ → ℝ) k‖ ^ 2 / (4 * κ ^ 2 + (2 * π * k) ^ 2) ≤
          ‖fourierCircle (W_i : ℝ → ℝ) k‖ ^ 2 := by
      intro k
      rw [hW_succ_eq, h_fc_deriv W_i k]
      rw [div_le_iff₀ (by positivity)]
      nlinarith [sq_nonneg κ, sq_nonneg ‖fourierCircle (W_i : ℝ → ℝ) k‖]
    have h_sum_lhs : Summable (fun k : ℤ =>
        ‖fourierCircle (W_succ : ℝ → ℝ) k‖ ^ 2 / (4 * κ ^ 2 + (2 * π * k) ^ 2)) :=
      Summable.of_nonneg_of_le (fun _ => by positivity) h_pw_le h_sum_Wi
    have h_hm1_le_tsum : hm1KappaSqT κ (ιT W_succ) ≤ ∑' k : ℤ, ‖fourierCircle (W_i : ℝ → ℝ) k‖ ^ 2 := by
      rw [h_hm1_Wsucc]
      exact h_sum_lhs.tsum_le_tsum h_pw_le h_sum_Wi
    have h_hm1_nn : 0 ≤ hm1KappaSqT κ (ιT W_succ) := by
      rw [h_hm1_Wsucc]
      exact tsum_nonneg (fun _ => by positivity)
    have h_tsum_eq_int : (∑' k : ℤ, ‖fourierCircle (W_i : ℝ → ℝ) k‖ ^ 2) =
        ∫ x in (0 : ℝ)..1, (W_i : ℝ → ℝ) x * (W_i : ℝ → ℝ) x := by
      have h0 := (h_auto_Wi 0).symm
      simpa [mul_zero, Real.cos_zero, mul_one, add_zero] using h0
    let S_i : ℝ := cinfSeminormT i (q : ℝ → ℝ)
    have hS_i_nn : 0 ≤ S_i := h_semi_nn i (q : ℝ → ℝ)
    have h_int_le : (∫ x in (0 : ℝ)..1, (W_i : ℝ → ℝ) x * (W_i : ℝ → ℝ) x) ≤ S_i ^ 2 := by
