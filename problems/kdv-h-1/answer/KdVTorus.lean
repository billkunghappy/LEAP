    refine (h_inv_int.const_mul (B ^ 2)).mono' h_cont.aestronglyMeasurable
      (Filter.Eventually.of_forall fun ξ => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (div_nonneg (sq_nonneg _) (le_of_lt (h_denom_pos ξ)))]
    have hA_le : A_Δ k n ξ ≤ B := h_sqrt_le _ _ B (norm_nonneg _) (hB_le n ξ)
    have h_sq : A_Δ k n ξ ^ 2 ≤ B ^ 2 :=
      pow_le_pow_left₀ (mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _)) hA_le 2
    calc A_Δ k n ξ ^ 2 / (κ₀ ^ 2 + ξ ^ 2)
      _ ≤ B ^ 2 / (κ₀ ^ 2 + ξ ^ 2) := div_le_div_of_nonneg_right h_sq (le_of_lt (h_denom_pos ξ))
      _ = B ^ 2 * (1 / (κ₀ ^ 2 + ξ ^ 2)) := by ring
  have h_hm1_nn : ∀ w : CinfT, 0 ≤ hm1KappaSqT κ₀ (ιT w) := by
    intro w
    rw [(h_fc.1 w).2.2]
    exact tsum_nonneg (fun n => by positivity)
  have h_hm1_diff_nn : 0 ≤ hm1KappaSqT κ₀ (ιT w₁ - ιT w₂) := by
    rw [(h_fc.2 w₁ w₂).2]
    exact tsum_nonneg (fun n => by positivity)
  
  have hE_ind : ∀ (w : CinfT) (k : ℕ),
      Summable (E_w w k) ∧
      (∑' n : ℤ, E_w w k n) ≤
        ((169 / κ₀) * hm1KappaSqT κ₀ (ιT w)) ^ k * ((2 / κ₀) * hm1KappaSqT κ₀ (ιT w)) := by
    intro w k
    set R_w : ℝ := (169 / κ₀) * hm1KappaSqT κ₀ (ιT w)
    have hRw_nn : 0 ≤ R_w := mul_nonneg (by positivity) (h_hm1_nn w)
    induction k with
    | zero =>
      have h_pw0 : ∀ n : ℤ,
          E_w w 0 n ≤ (2 / κ₀) * (‖fourierCircle (w : ℝ → ℝ) n‖ ^ 2 / (4 * κ₀ ^ 2 + (2 * π * n) ^ 2)) := by
        intro n
        dsimp [E_w, A_w]
        have h_fn : (fun ξ : ℝ =>
            (Real.sqrt (κ₀ ^ 2 + (2 * π * n - ξ) ^ 2) *
              ‖iterFreqPacketT κ₀ (w : ℝ → ℝ) 0 n ξ‖) ^ 2 / (κ₀ ^ 2 + ξ ^ 2)) =
            (fun ξ : ℝ =>
              (κ₀ ^ 2 + (2 * π * n - ξ) ^ 2) *
                ‖-fourierCircle (w : ℝ → ℝ) n / ((κ₀ ^ 2 + (2 * π * n - ξ) ^ 2 : ℝ) : ℂ)‖ ^ 2 /
                (κ₀ ^ 2 + ξ ^ 2)) := by
          ext ξ
          rw [h_sq_sqrt_mul, (h_freq w).2.2.1 n ξ]
        rw [h_fn]
        exact h_base_mode n (fourierCircle (w : ℝ → ℝ) n)
      have h_dom0 : Summable (fun n : ℤ =>
          (2 / κ₀) * (‖fourierCircle (w : ℝ → ℝ) n‖ ^ 2 / (4 * κ₀ ^ 2 + (2 * π * n) ^ 2))) :=
        ((h_fc.1 w).2.1).mul_left (2 / κ₀)
      have hE0_sum : Summable (E_w w 0) :=
        Summable.of_nonneg_of_le (hEw_nn w 0) h_pw0 h_dom0
      refine ⟨hE0_sum, ?_⟩
      rw [pow_zero, one_mul, (h_fc.1 w).2.2, ← tsum_mul_left]
      exact hE0_sum.tsum_le_tsum h_pw0 h_dom0
    | succ k ih =>
      obtain ⟨hEk_sum, hEk_le⟩ := ih
      obtain ⟨hAw_cont, ⟨B_k, hB_k, hBk_le⟩, h_step_pw⟩ := h_pkt_single w k
      have hAw_bd : ∀ (n : ℤ) (ξ : ℝ), A_w w k n ξ ≤ B_k :=
        fun n ξ => h_sqrt_le _ _ B_k (norm_nonneg _) (hBk_le n ξ)
      obtain ⟨hS_int, hS_sum, hS_tsum_le⟩ :=
        h_s5 (A_w w k) B_k hAw_cont hB_k
          (fun n ξ => mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _)) hAw_bd hEk_sum
          (fun j => ‖fourierCircle (w : ℝ → ℝ) j‖) (fun _ => norm_nonneg _) (h_fc.1 w).1
      have h_pw_k : ∀ n : ℤ,
          E_w w (k + 1) n ≤
            (1 / (2 * π)) * ∫ ξ : ℝ,
              (∑' j : ℤ, A_w w k (n - j) (ξ - 2 * π * j) *
                ‖fourierCircle (w : ℝ → ℝ) j‖ / (κ₀ ^ 2 + (ξ - 2 * π * j) ^ 2)) ^ 2 /
                (κ₀ ^ 2 + ξ ^ 2) := by
        intro n
        dsimp [E_w]
        refine mul_le_mul_of_nonneg_left (integral_mono (hAw_int w (k + 1) n) (hS_int n) (fun ξ => ?_))
          (by positivity)
        refine div_le_div_of_nonneg_right ?_ (le_of_lt (h_denom_pos ξ))
        exact pow_le_pow_left₀ (mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _)) (h_step_pw n ξ) 2
      have hEk1_sum : Summable (E_w w (k + 1)) :=
        Summable.of_nonneg_of_le (hEw_nn w (k + 1)) h_pw_k hS_sum
      refine ⟨hEk1_sum, ?_⟩
      have h_Kd_eq : (169 / κ₀) * (∑' i : ℤ, ‖fourierCircle (w : ℝ → ℝ) i‖ ^ 2 / (4 * κ₀ ^ 2 + (2 * π * i) ^ 2)) =
          R_w := by
        dsimp [R_w]; rw [(h_fc.1 w).2.2]
      calc (∑' n : ℤ, E_w w (k + 1) n)
        _ ≤ ∑' n : ℤ, (1 / (2 * π)) * ∫ ξ : ℝ,
              (∑' j : ℤ, A_w w k (n - j) (ξ - 2 * π * j) *
                ‖fourierCircle (w : ℝ → ℝ) j‖ / (κ₀ ^ 2 + (ξ - 2 * π * j) ^ 2)) ^ 2 /
                (κ₀ ^ 2 + ξ ^ 2) :=
          hEk1_sum.tsum_le_tsum h_pw_k hS_sum
        _ ≤ R_w * ∑' m : ℤ, E_w w k m := by
          rw [← h_Kd_eq]; exact hS_tsum_le
        _ ≤ R_w * (R_w ^ k * ((2 / κ₀) * hm1KappaSqT κ₀ (ιT w))) :=
          mul_le_mul_of_nonneg_left hEk_le hRw_nn
        _ = R_w ^ (k + 1) * ((2 / κ₀) * hm1KappaSqT κ₀ (ιT w)) := by
          rw [pow_succ']; ring
  
  set ρ : ℝ := (1 / 256 : ℝ) ^ 2
  have hρ_nn : 0 ≤ ρ := by positivity
  have hRw1_le_ρ : (169 / κ₀) * hm1KappaSqT κ₀ (ιT w₁) ≤ ρ := by
    have h1 := mul_le_mul_of_nonneg_left hw₁ (by positivity : (0 : ℝ) ≤ 169 / κ₀)
    have h2 : (169 / κ₀) * ((1 / (256 * 13)) ^ 2 * κ₀) = ρ := by
      dsimp [ρ]; have : κ₀ ≠ 0 := ne_of_gt hκ₀_pos; field_simp; norm_num
    linarith
  have hRw2_le_ρ : (169 / κ₀) * hm1KappaSqT κ₀ (ιT w₂) ≤ ρ := by
    have h1 := mul_le_mul_of_nonneg_left hw₂ (by positivity : (0 : ℝ) ≤ 169 / κ₀)
    have h2 : (169 / κ₀) * ((1 / (256 * 13)) ^ 2 * κ₀) = ρ := by
      dsimp [ρ]; have : κ₀ ≠ 0 := ne_of_gt hκ₀_pos; field_simp; norm_num
    linarith
  set H_Δ : ℝ := hm1KappaSqT κ₀ (ιT w₁ - ιT w₂)
  have hD_ind : ∀ k : ℕ,
      Summable (D k) ∧
      (∑' n : ℤ, D k n) ≤ (4 * ρ) ^ k * ((2 / κ₀) * H_Δ) := by
    intro k
    induction k with
    | zero =>
      have h_pw0 : ∀ n : ℤ,
          D 0 n ≤ (2 / κ₀) * (‖fourierCircle (w₁ : ℝ → ℝ) n - fourierCircle (w₂ : ℝ → ℝ) n‖ ^ 2 /
            (4 * κ₀ ^ 2 + (2 * π * n) ^ 2)) := by
        intro n
        dsimp [D, A_Δ]
        have h_fn : (fun ξ : ℝ =>
            (Real.sqrt (κ₀ ^ 2 + (2 * π * n - ξ) ^ 2) *
              ‖iterFreqPacketT κ₀ (w₁ : ℝ → ℝ) 0 n ξ -
                iterFreqPacketT κ₀ (w₂ : ℝ → ℝ) 0 n ξ‖) ^ 2 / (κ₀ ^ 2 + ξ ^ 2)) =
            (fun ξ : ℝ =>
              (κ₀ ^ 2 + (2 * π * n - ξ) ^ 2) *
                ‖-(fourierCircle (w₁ : ℝ → ℝ) n - fourierCircle (w₂ : ℝ → ℝ) n) /
                  ((κ₀ ^ 2 + (2 * π * n - ξ) ^ 2 : ℝ) : ℂ)‖ ^ 2 / (κ₀ ^ 2 + ξ ^ 2)) := by
          ext ξ
          rw [h_sq_sqrt_mul, (h_freq w₁).2.2.1 n ξ, (h_freq w₂).2.2.1 n ξ]
          congr 2
          congr 1
          ring
        rw [h_fn]
        exact h_base_mode n (fourierCircle (w₁ : ℝ → ℝ) n - fourierCircle (w₂ : ℝ → ℝ) n)
      have h_dom0 : Summable (fun n : ℤ =>
          (2 / κ₀) * (‖fourierCircle (w₁ : ℝ → ℝ) n - fourierCircle (w₂ : ℝ → ℝ) n‖ ^ 2 /
            (4 * κ₀ ^ 2 + (2 * π * n) ^ 2))) :=
        ((h_fc.2 w₁ w₂).1).mul_left (2 / κ₀)
      have hD0_sum : Summable (D 0) :=
        Summable.of_nonneg_of_le (hD_nn 0) h_pw0 h_dom0
      refine ⟨hD0_sum, ?_⟩
      rw [pow_zero, one_mul]
      dsimp [H_Δ]
      rw [(h_fc.2 w₁ w₂).2, ← tsum_mul_left]
      exact hD0_sum.tsum_le_tsum h_pw0 h_dom0
    | succ k ih =>
      obtain ⟨hDk_sum, hDk_le⟩ := ih
      obtain ⟨hEw2_sum, hEw2_le⟩ := hE_ind w₂ k
      obtain ⟨hAΔ_cont, ⟨B_Δ, hB_Δ, hBΔ_le⟩, hΔ_step_pw⟩ := h_pkt_diff k
      obtain ⟨hAw2_cont, ⟨B_2, hB_2, hB2_le⟩, _⟩ := h_pkt_single w₂ k
      have hAΔ_bd : ∀ (n : ℤ) (ξ : ℝ), A_Δ k n ξ ≤ B_Δ :=
        fun n ξ => h_sqrt_le _ _ B_Δ (norm_nonneg _) (hBΔ_le n ξ)
      have hAw2_bd : ∀ (n : ℤ) (ξ : ℝ), A_w w₂ k n ξ ≤ B_2 :=
        fun n ξ => h_sqrt_le _ _ B_2 (norm_nonneg _) (hB2_le n ξ)
      let d_Δ : ℤ → ℝ := fun j => ‖fourierCircle (w₁ : ℝ → ℝ) j - fourierCircle (w₂ : ℝ → ℝ) j‖
      have hdΔ_nn : ∀ j : ℤ, 0 ≤ d_Δ j := fun _ => norm_nonneg _
      have hdΔ_sum : Summable d_Δ :=
        Summable.of_nonneg_of_le hdΔ_nn (fun j => norm_sub_le _ _)
          ((h_fc.1 w₁).1.add (h_fc.1 w₂).1)
      obtain ⟨hS1_int, hS1_sum, hS1_tsum_le⟩ :=
        h_s5 (A_Δ k) B_Δ hAΔ_cont hB_Δ
          (fun n ξ => mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _)) hAΔ_bd hDk_sum
          (fun j => ‖fourierCircle (w₁ : ℝ → ℝ) j‖) (fun _ => norm_nonneg _) (h_fc.1 w₁).1
      obtain ⟨hS2_int, hS2_sum, hS2_tsum_le⟩ :=
        h_s5 (A_w w₂ k) B_2 hAw2_cont hB_2
          (fun n ξ => mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _)) hAw2_bd hEw2_sum
          d_Δ hdΔ_nn hdΔ_sum
      let I₁ : ℤ → ℝ := fun n =>
        (1 / (2 * π)) * ∫ ξ : ℝ,
          (∑' j : ℤ, A_Δ k (n - j) (ξ - 2 * π * j) *
            ‖fourierCircle (w₁ : ℝ → ℝ) j‖ / (κ₀ ^ 2 + (ξ - 2 * π * j) ^ 2)) ^ 2 /
            (κ₀ ^ 2 + ξ ^ 2)
      let I₂ : ℤ → ℝ := fun n =>
        (1 / (2 * π)) * ∫ ξ : ℝ,
          (∑' j : ℤ, A_w w₂ k (n - j) (ξ - 2 * π * j) * d_Δ j /
            (κ₀ ^ 2 + (ξ - 2 * π * j) ^ 2)) ^ 2 /
            (κ₀ ^ 2 + ξ ^ 2)
      have h_pw_D : ∀ n : ℤ, D (k + 1) n ≤ 2 * I₁ n + 2 * I₂ n := by
        intro n
        dsimp [D, I₁, I₂]
        let f₁ : ℝ → ℝ := fun ξ =>
          (∑' j : ℤ, A_Δ k (n - j) (ξ - 2 * π * j) *
            ‖fourierCircle (w₁ : ℝ → ℝ) j‖ / (κ₀ ^ 2 + (ξ - 2 * π * j) ^ 2)) ^ 2 /
            (κ₀ ^ 2 + ξ ^ 2)
        let f₂ : ℝ → ℝ := fun ξ =>
          (∑' j : ℤ, A_w w₂ k (n - j) (ξ - 2 * π * j) * d_Δ j /
            (κ₀ ^ 2 + (ξ - 2 * π * j) ^ 2)) ^ 2 /
            (κ₀ ^ 2 + ξ ^ 2)
        have h_int_pw : ∀ ξ : ℝ, A_Δ (k + 1) n ξ ^ 2 / (κ₀ ^ 2 + ξ ^ 2) ≤ 2 * f₁ ξ + 2 * f₂ ξ := by
          intro ξ
          set s₁ : ℝ := ∑' j : ℤ, A_Δ k (n - j) (ξ - 2 * π * j) *
            ‖fourierCircle (w₁ : ℝ → ℝ) j‖ / (κ₀ ^ 2 + (ξ - 2 * π * j) ^ 2)
          set s₂ : ℝ := ∑' j : ℤ, A_w w₂ k (n - j) (ξ - 2 * π * j) * d_Δ j /
            (κ₀ ^ 2 + (ξ - 2 * π * j) ^ 2)
          have h_step := hΔ_step_pw n ξ
          change A_Δ (k + 1) n ξ ≤ s₁ + s₂ at h_step
          have h_sq1 : A_Δ (k + 1) n ξ ^ 2 ≤ (s₁ + s₂) ^ 2 :=
            pow_le_pow_left₀ (mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _)) h_step 2
          have h_sq2 : (s₁ + s₂) ^ 2 ≤ 2 * s₁ ^ 2 + 2 * s₂ ^ 2 := by
            nlinarith [sq_nonneg (s₁ - s₂)]
          have h_num : A_Δ (k + 1) n ξ ^ 2 ≤ 2 * s₁ ^ 2 + 2 * s₂ ^ 2 := le_trans h_sq1 h_sq2
          calc A_Δ (k + 1) n ξ ^ 2 / (κ₀ ^ 2 + ξ ^ 2)
            _ ≤ (2 * s₁ ^ 2 + 2 * s₂ ^ 2) / (κ₀ ^ 2 + ξ ^ 2) :=
              div_le_div_of_nonneg_right h_num (le_of_lt (h_denom_pos ξ))
            _ = 2 * f₁ ξ + 2 * f₂ ξ := by dsimp [f₁, f₂]; ring
        have h_rhs_int : Integrable (fun ξ : ℝ => 2 * f₁ ξ + 2 * f₂ ξ) volume :=
          ((hS1_int n).const_mul 2).add ((hS2_int n).const_mul 2)
        have h_int_le := integral_mono (hAΔ_int (k + 1) n) h_rhs_int h_int_pw
        rw [integral_add ((hS1_int n).const_mul 2) ((hS2_int n).const_mul 2),
            integral_const_mul, integral_const_mul] at h_int_le
        calc (1 / (2 * π)) * (∫ ξ : ℝ, A_Δ (k + 1) n ξ ^ 2 / (κ₀ ^ 2 + ξ ^ 2))
          _ ≤ (1 / (2 * π)) * (2 * (∫ ξ : ℝ, f₁ ξ) + 2 * (∫ ξ : ℝ, f₂ ξ)) :=
            mul_le_mul_of_nonneg_left h_int_le (by positivity)
          _ = 2 * ((1 / (2 * π)) * ∫ ξ : ℝ, f₁ ξ) + 2 * ((1 / (2 * π)) * ∫ ξ : ℝ, f₂ ξ) := by ring
      have hI1_sum : Summable I₁ := hS1_sum
      have hI2_sum : Summable I₂ := hS2_sum
      have h_dom_D : Summable (fun n : ℤ => 2 * I₁ n + 2 * I₂ n) :=
        (hI1_sum.mul_left 2).add (hI2_sum.mul_left 2)
      have hDk1_sum : Summable (D (k + 1)) :=
        Summable.of_nonneg_of_le (hD_nn (k + 1)) h_pw_D h_dom_D
      refine ⟨hDk1_sum, ?_⟩
      have h_I1_bound : (∑' n : ℤ, I₁ n) ≤ ρ * ((4 * ρ) ^ k * ((2 / κ₀) * H_Δ)) := by
        have h_Kd1 : (169 / κ₀) * (∑' i : ℤ, ‖fourierCircle (w₁ : ℝ → ℝ) i‖ ^ 2 / (4 * κ₀ ^ 2 + (2 * π * i) ^ 2)) =
            (169 / κ₀) * hm1KappaSqT κ₀ (ιT w₁) := by
          rw [(h_fc.1 w₁).2.2]
        calc (∑' n : ℤ, I₁ n)
          _ ≤ ((169 / κ₀) * hm1KappaSqT κ₀ (ιT w₁)) * ∑' m : ℤ, D k m := by
            rw [← h_Kd1]; exact hS1_tsum_le
          _ ≤ ρ * ((4 * ρ) ^ k * ((2 / κ₀) * H_Δ)) :=
            mul_le_mul hRw1_le_ρ hDk_le (tsum_nonneg (hD_nn k)) hρ_nn
      have h_I2_bound : (∑' n : ℤ, I₂ n) ≤ ρ ^ (k + 1) * ((2 / κ₀) * H_Δ) := by
        have h_Kd2 : (169 / κ₀) * (∑' i : ℤ, d_Δ i ^ 2 / (4 * κ₀ ^ 2 + (2 * π * i) ^ 2)) =
            (169 / κ₀) * H_Δ := by
          dsimp [H_Δ, d_Δ]; rw [(h_fc.2 w₁ w₂).2]
        set R_w2 : ℝ := (169 / κ₀) * hm1KappaSqT κ₀ (ιT w₂)
        have hRw2_nn : 0 ≤ R_w2 := mul_nonneg (by positivity) (h_hm1_nn w₂)
        have h_pow_le : R_w2 ^ (k + 1) ≤ ρ ^ (k + 1) :=
          pow_le_pow_left₀ hRw2_nn hRw2_le_ρ (k + 1)
        calc (∑' n : ℤ, I₂ n)
          _ ≤ ((169 / κ₀) * H_Δ) * ∑' m : ℤ, E_w w₂ k m := by
            rw [← h_Kd2]; exact hS2_tsum_le
          _ ≤ ((169 / κ₀) * H_Δ) * (R_w2 ^ k * ((2 / κ₀) * hm1KappaSqT κ₀ (ιT w₂))) :=
            mul_le_mul_of_nonneg_left hEw2_le (mul_nonneg (by positivity) h_hm1_diff_nn)
          _ = R_w2 ^ (k + 1) * ((2 / κ₀) * H_Δ) := by
            dsimp [R_w2]; rw [pow_succ']; ring
