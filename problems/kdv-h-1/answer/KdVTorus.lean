      ∀ η : ℝ,
        (∫ z : ℝ,
          Complex.exp (-((η : ℂ) * (z : ℂ)) * I) *
            (greenIterKernel κ (w : ℝ → ℝ) ℓ x z : ℂ)) =
          iterWavePacket κ (w : ℝ → ℝ) ℓ x η / ((κ ^ 2 + η ^ 2 : ℝ) : ℂ)) ∧
    (∀ x : ℝ,
      (∀ ℓ : ℕ,
