    ⟨fun x => diagGreen κ (w : ℝ → ℝ) x - 1 / (2 * κ),
     hdg_smooth.sub contDiff_const,
     fun x => by dsimp; rw [hdg_per x]⟩
  refine ⟨g_tilde, ?_, ?_⟩
  · intro x
    dsimp [g_tilde]
    ring
  · intro M_n _hM_n hw_n x
    have hw_low_semi : ∀ m < n, cinfSeminormT m (w : ℝ → ℝ) ≤ R :=
      fun m hm => h_semi_le m (w : ℝ → ℝ) R (hw_low m hm)
    have hw_n_semi : cinfSeminormT n (w : ℝ → ℝ) ≤ M_n :=
      h_semi_le n (w : ℝ → ℝ) M_n hw_n
    have h_reg_semi : cinfSeminormT n (regTruncatedVecFnT δ_diag κ w) ≤ A * M_n + B := by
      calc cinfSeminormT n (regTruncatedVecFnT δ_diag κ w)
        _ ≤ A * cinfSeminormT n (w : ℝ → ℝ) + B := h_lin w hw_low_semi
        _ ≤ A * M_n + B := by
          have : A * cinfSeminormT n (w : ℝ → ℝ) ≤ A * M_n :=
            mul_le_mul_of_nonneg_left hw_n_semi hA_nn
          linarith
    have h_pt_reg : |iteratedDeriv n (regTruncatedVecFnT δ_diag κ w) x| ≤ A * M_n + B :=
      le_trans (h_iter_le ⟨regTruncatedVecFnT δ_diag κ w, h_mem w⟩ n x) h_reg_semi
    have h_dg_eq : diagGreen κ (w : ℝ → ℝ) = fun y => 1 / (2 * κ) + (g_tilde : ℝ → ℝ) y := by
      funext y
      dsimp [g_tilde]
      ring
    have h_deriv_dg : deriv (diagGreen κ (w : ℝ → ℝ)) = deriv (g_tilde : ℝ → ℝ) := by
      funext y
      have hd_g : HasDerivAt (g_tilde : ℝ → ℝ) (deriv (g_tilde : ℝ → ℝ) y) y :=
        (g_tilde.2.1.differentiable (by decide) y).hasDerivAt
      have hd_sum : HasDerivAt (fun z => 1 / (2 * κ) + (g_tilde : ℝ → ℝ) z)
          (0 + deriv (g_tilde : ℝ → ℝ) y) y :=
        (hasDerivAt_const y (1 / (2 * κ))).add hd_g
      rw [h_dg_eq, hd_sum.deriv, zero_add]
    have h_reg_fn : regTruncatedVecFnT δ_diag κ w =
        fun y => (16 * κ ^ 5) * deriv (g_tilde : ℝ → ℝ) y := by
      funext y
      rw [h_agree w hw y, h_deriv_dg]
    have h_iter_eq : iteratedDeriv n (regTruncatedVecFnT δ_diag κ w) x =
        (16 * κ ^ 5) * iteratedDeriv (n + 1) (g_tilde : ℝ → ℝ) x := by
      rw [h_reg_fn, h_iter_const_mul n (16 * κ ^ 5) (deriv (g_tilde : ℝ → ℝ)) x,
          ← iteratedDeriv_succ']
    have h_abs_eq : |iteratedDeriv n (regTruncatedVecFnT δ_diag κ w) x| =
        (16 * κ ^ 5) * |iteratedDeriv (n + 1) (g_tilde : ℝ → ℝ) x| := by
      rw [h_iter_eq, abs_mul, abs_of_pos h16κ5_pos]
    rw [h_abs_eq] at h_pt_reg
    have h_div : |iteratedDeriv (n + 1) (g_tilde : ℝ → ℝ) x| ≤ (A * M_n + B) / (16 * κ ^ 5) :=
      (le_div_iff₀' h16κ5_pos).mpr h_pt_reg
    have h_rhs : (A * M_n + B) / (16 * κ ^ 5) = C₁ * M_n + C₂ := by
      dsimp [C₁, C₂]
      ring
    linarith

theorem cinfT_iotaT_hasDerivAt_and_deriv_orthogonalityT : (∀ (q₁ q₂ : CinfT)
       (h_add : (fun x : ℝ => (q₁ : ℝ → ℝ) x + (q₂ : ℝ → ℝ) x) ∈ CinfT),
      ιT ⟨fun x : ℝ => (q₁ : ℝ → ℝ) x + (q₂ : ℝ → ℝ) x, h_add⟩ = ιT q₁ + ιT q₂) ∧
    (∀ (g : CinfT) (B : ℝ),
      0 ≤ B → (∀ x : ℝ, |(g : ℝ → ℝ) x| ≤ B) → ‖ιT g‖ ≤ B) ∧
    (∀ (w : ℝ → CinfT) (v : CinfT) (t : ℝ),
      HasCinfDerivAtT w v t → HasDerivAt (fun s => ιT (w s)) (ιT v) t) ∧
    (∀ (f : CinfT) (h_deriv : deriv (f : ℝ → ℝ) ∈ CinfT),
      inner ℝ (ιT f) (ιT ⟨deriv (f : ℝ → ℝ), h_deriv⟩) = 0) :=
by
  haveI : Fact (1 ≤ (2 : ENNReal)) := ⟨by norm_num⟩
  have hp_pos : (0 : ℝ) < (2 : ENNReal).toReal := by norm_num
  have h_rpow : ∀ x : ℝ, x ^ (2 : ENNReal).toReal = x ^ 2 := fun x => by
    rw [ENNReal.toReal_ofNat, Real.rpow_two]
  have h_summable_lp : ∀ u : lp (fun _ : ℤ => ℂ) 2, Summable (fun n : ℤ => ‖u n‖ ^ 2) := by
    intro u
    have hu := (memℓp_gen_iff hp_pos).mp u.2
    simp_rw [h_rpow] at hu
    exact hu
  have h_fc_eq : ∀ (g : ℝ → ℝ) (n : ℤ),
      fourierCoeffOn zero_lt_one (fun x : ℝ => (g x : ℂ)) n = fourierCircle g n := by
    intro g n
    rw [fourierCoeffOn_eq_integral (fun x : ℝ => (g x : ℂ)) n zero_lt_one]
    have h_sub : (1 : ℝ) / (1 - 0) = 1 := by norm_num
    rw [h_sub, one_smul, fourierCircle]
    congr 1 with x
    rw [fourier_coe_apply, smul_eq_mul]
    congr 1
    congr 1
    push_cast
    ring
  have h_parseval : ∀ (g : ℝ → ℝ), Continuous g →
      Summable (fun n : ℤ => ‖fourierCircle g n‖ ^ 2) ∧
      (∑' n : ℤ, ‖fourierCircle g n‖ ^ 2) = ∫ x in (0 : ℝ)..1, (g x) ^ 2 := by
    intro g hg
    let g_C : ℝ → ℂ := fun x => (g x : ℂ)
    have hg_C : Continuous g_C := Complex.continuous_ofReal.comp hg
    have h_meas : AEStronglyMeasurable g_C (volume.restrict (Set.Ioc (0 : ℝ) 1)) :=
      hg_C.aestronglyMeasurable
    have h_int_sq : Integrable (fun x => ‖g_C x‖ ^ 2) (volume.restrict (Set.Ioc (0 : ℝ) 1)) :=
      (intervalIntegrable_iff_integrableOn_Ioc_of_le zero_le_one).mp
        ((hg_C.norm.pow 2).intervalIntegrable 0 1)
    have h_memLp : MemLp g_C 2 (volume.restrict (Set.Ioc (0 : ℝ) 1)) :=
      (MeasureTheory.memLp_two_iff_integrable_sq_norm h_meas).mpr h_int_sq
    have hs := (hasSum_sq_fourierCoeffOn zero_lt_one h_memLp).summable
    have h_tsum := tsum_sq_fourierCoeffOn zero_lt_one h_memLp
    simp only [g_C, h_fc_eq g] at hs h_tsum
    refine ⟨hs, ?_⟩
    rw [h_tsum]
    have h_inv : ((1 : ℝ) - 0)⁻¹ = 1 := by norm_num
    rw [h_inv, one_smul]
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    rw [Complex.norm_real, Real.norm_eq_abs, sq_abs]
  have h_prof_sq : ∀ (f : ℝ → ℝ) (n : ℤ),
      ‖hm1ProfileT f n‖ ^ 2 =
        (4 + (2 * π * (n : ℝ)) ^ 2)⁻¹ * ‖fourierCircle f n‖ ^ 2 := by
    intro f n
    have h_w_norm : ‖((Real.sqrt (4 + (2 * π * n) ^ 2))⁻¹ : ℂ)‖ =
        (Real.sqrt (4 + (2 * π * n) ^ 2))⁻¹ := by
      rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    dsimp [hm1ProfileT]
    rw [norm_mul, h_w_norm, mul_pow, inv_pow, Real.sq_sqrt (by positivity)]
  have h_mem : ∀ q : CinfT, Memℓp (hm1ProfileT (q : ℝ → ℝ)) 2 := by
    intro q
    rw [memℓp_gen_iff hp_pos]
    simp_rw [h_rpow]
    refine Summable.of_nonneg_of_le (fun _ => sq_nonneg _) (fun n => ?_)
      (h_parseval (q : ℝ → ℝ) q.2.1.continuous).1
    rw [h_prof_sq (q : ℝ → ℝ) n]
    have h_inv_le : (4 + (2 * π * (n : ℝ)) ^ 2)⁻¹ ≤ 1 :=
      inv_le_one_of_one_le₀ (by nlinarith [sq_nonneg (2 * π * (n : ℝ))])
    exact mul_le_of_le_one_left (sq_nonneg _) h_inv_le
  have h_toHm1T_apply : ∀ (q : CinfT) (n : ℤ),
      (toHm1T q : ℤ → ℂ) n = hm1ProfileT (q : ℝ → ℝ) n := by
    intro q n
    dsimp [toHm1T]
    rw [dif_pos (h_mem q)]
  have h_int_fourier : ∀ (q : CinfT) (n : ℤ),
      IntervalIntegrable
        (fun x : ℝ => Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * ((q : ℝ → ℝ) x : ℂ))
        volume 0 1 := by
    intro q n
    have hq_cont : Continuous (q : ℝ → ℝ) := q.2.1.continuous
    have h_cont : Continuous
        (fun x : ℝ => Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * ((q : ℝ → ℝ) x : ℂ)) := by
      fun_prop
    exact h_cont.intervalIntegrable 0 1
  have h_iota_add : ∀ (q₁ q₂ : CinfT)
      (h_add : (fun x : ℝ => (q₁ : ℝ → ℝ) x + (q₂ : ℝ → ℝ) x) ∈ CinfT),
      ιT ⟨fun x : ℝ => (q₁ : ℝ → ℝ) x + (q₂ : ℝ → ℝ) x, h_add⟩ = ιT q₁ + ιT q₂ := by
    intro q₁ q₂ h_add
    let q_add : CinfT := ⟨fun x : ℝ => (q₁ : ℝ → ℝ) x + (q₂ : ℝ → ℝ) x, h_add⟩
    apply Subtype.ext
    apply lp.ext
    ext n
    change (toHm1T q_add : ℤ → ℂ) n = ((toHm1T q₁ + toHm1T q₂ : lp (fun _ : ℤ => ℂ) 2) : ℤ → ℂ) n
    rw [lp.coeFn_add, Pi.add_apply, h_toHm1T_apply q_add n, h_toHm1T_apply q₁ n, h_toHm1T_apply q₂ n]
    dsimp [hm1ProfileT, fourierCircle, q_add]
    rw [← mul_add, ← intervalIntegral.integral_add (h_int_fourier q₁ n) (h_int_fourier q₂ n)]
    congr 1
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    push_cast
    ring
  have h_iota_sub : ∀ (q₁ q₂ : CinfT)
      (h_sub : (fun x : ℝ => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x) ∈ CinfT),
      ιT ⟨fun x : ℝ => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x, h_sub⟩ = ιT q₁ - ιT q₂ := by
    intro q₁ q₂ h_sub
    let q_sub : CinfT := ⟨fun x : ℝ => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x, h_sub⟩
    apply Subtype.ext
    apply lp.ext
    ext n
    change (toHm1T q_sub : ℤ → ℂ) n = ((toHm1T q₁ - toHm1T q₂ : lp (fun _ : ℤ => ℂ) 2) : ℤ → ℂ) n
    rw [lp.coeFn_sub, Pi.sub_apply, h_toHm1T_apply q_sub n, h_toHm1T_apply q₁ n, h_toHm1T_apply q₂ n]
    dsimp [hm1ProfileT, fourierCircle, q_sub]
    rw [← mul_sub, ← intervalIntegral.integral_sub (h_int_fourier q₁ n) (h_int_fourier q₂ n)]
    congr 1
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    push_cast
    ring
  have h_iota_smul : ∀ (c : ℝ) (q : CinfT)
      (h_smul : (fun x : ℝ => c * (q : ℝ → ℝ) x) ∈ CinfT),
      ιT ⟨fun x : ℝ => c * (q : ℝ → ℝ) x, h_smul⟩ = c • ιT q := by
    intro c q h_smul
    let q_smul : CinfT := ⟨fun x : ℝ => c * (q : ℝ → ℝ) x, h_smul⟩
    apply Subtype.ext
    apply lp.ext
    ext n
    change (toHm1T q_smul : ℤ → ℂ) n = ((c • toHm1T q : lp (fun _ : ℤ => ℂ) 2) : ℤ → ℂ) n
    rw [lp.coeFn_smul, Pi.smul_apply, Complex.real_smul, h_toHm1T_apply q_smul n, h_toHm1T_apply q n]
    dsimp [hm1ProfileT, fourierCircle, q_smul]
    have h_fn : (fun x : ℝ =>
        Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * ((c * (q : ℝ → ℝ) x : ℝ) : ℂ)) =
        (fun x : ℝ => (c : ℂ) *
          (Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * ((q : ℝ → ℝ) x : ℂ))) := by
      ext x
      push_cast
      ring
    rw [h_fn, intervalIntegral.integral_const_mul]
    ring
  have h_iota_linf : ∀ (g : CinfT) (B : ℝ),
      0 ≤ B → (∀ x : ℝ, |(g : ℝ → ℝ) x| ≤ B) → ‖ιT g‖ ≤ B := by
    intro g B hB hg_bd
    let g₀ : ℝ → ℝ := (g : ℝ → ℝ)
    have hg₀_cont : Continuous g₀ := g.2.1.continuous
    have h_prof_le : ∀ n : ℤ,
        ‖((ιT g : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2 ≤ ‖fourierCircle g₀ n‖ ^ 2 := by
      intro n
      change ‖(toHm1T g : ℤ → ℂ) n‖ ^ 2 ≤ ‖fourierCircle g₀ n‖ ^ 2
      rw [h_toHm1T_apply g n, h_prof_sq g₀ n]
      have h_inv_le : (4 + (2 * π * (n : ℝ)) ^ 2)⁻¹ ≤ 1 :=
        inv_le_one_of_one_le₀ (by nlinarith [sq_nonneg (2 * π * (n : ℝ))])
      exact mul_le_of_le_one_left (sq_nonneg _) h_inv_le
    obtain ⟨h_sum_g0, h_tsum_g0⟩ := h_parseval g₀ hg₀_cont
    have h_tsum_le :
        (∑' n : ℤ, ‖((ιT g : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2) ≤ B ^ 2 := by
      calc (∑' n : ℤ, ‖((ιT g : Hm1T) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2)
        _ ≤ ∑' n : ℤ, ‖fourierCircle g₀ n‖ ^ 2 :=
          Summable.tsum_le_tsum h_prof_le
            (h_summable_lp ((ιT g : Hm1T) : lp (fun _ : ℤ => ℂ) 2)) h_sum_g0
        _ = ∫ x in (0 : ℝ)..1, (g₀ x) ^ 2 := h_tsum_g0
        _ ≤ ∫ _ in (0 : ℝ)..1, B ^ 2 := by
          refine intervalIntegral.integral_mono_on zero_le_one
            ((hg₀_cont.pow 2).intervalIntegrable 0 1)
            (continuous_const.intervalIntegrable 0 1) (fun x _ => ?_)
          rw [← sq_abs (g₀ x)]
          exact pow_le_pow_left₀ (abs_nonneg _) (hg_bd x) 2
        _ = B ^ 2 := by simp
    apply lp.norm_le_of_tsum_le hp_pos hB
    simp_rw [h_rpow]
    exact h_tsum_le
  have h_iota_deriv : ∀ (w : ℝ → CinfT) (v : CinfT) (t : ℝ),
      HasCinfDerivAtT w v t → HasDerivAt (fun s => ιT (w s)) (ιT v) t := by
    intro w v t hw
    rw [hasDerivAt_iff_tendsto, Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨η, hη, h_bd⟩ := hw 0 (ε / 2) (half_pos hε)
    rw [Metric.eventually_nhds_iff]
    refine ⟨η, hη, fun s hs => ?_⟩
    rw [Real.dist_eq] at hs
    have h_sub_mem : (fun x : ℝ => (w s : ℝ → ℝ) x - (w t : ℝ → ℝ) x) ∈ CinfT :=
      ⟨(w s).2.1.sub (w t).2.1, fun x => by dsimp; rw [(w s).2.2 x, (w t).2.2 x]⟩
    let diff_w : CinfT := ⟨fun x : ℝ => (w s : ℝ → ℝ) x - (w t : ℝ → ℝ) x, h_sub_mem⟩
    have h_smul_mem : (fun x : ℝ => (s - t) * (v : ℝ → ℝ) x) ∈ CinfT :=
      ⟨contDiff_const.mul v.2.1, fun x => by dsimp; rw [v.2.2 x]⟩
    let smul_v : CinfT := ⟨fun x : ℝ => (s - t) * (v : ℝ → ℝ) x, h_smul_mem⟩
    have h_rem_mem : (fun x : ℝ => (diff_w : ℝ → ℝ) x - (smul_v : ℝ → ℝ) x) ∈ CinfT :=
      ⟨diff_w.2.1.sub smul_v.2.1, fun x => by dsimp; rw [diff_w.2.2 x, smul_v.2.2 x]⟩
    let rem_w : CinfT := ⟨fun x : ℝ => (diff_w : ℝ → ℝ) x - (smul_v : ℝ → ℝ) x, h_rem_mem⟩
    have h_iota_rem : ιT rem_w = ιT (w s) - ιT (w t) - (s - t) • ιT v := by
      rw [h_iota_sub diff_w smul_v h_rem_mem, h_iota_sub (w s) (w t) h_sub_mem,
        h_iota_smul (s - t) v h_smul_mem]
    have h_rem_pt : ∀ x : ℝ, |(rem_w : ℝ → ℝ) x| ≤ (ε / 2) * |s - t| := by
      intro x
      have hx := h_bd s hs x
      simp only [iteratedDeriv_zero] at hx
      exact hx
    have h_norm_rem : ‖ιT (w s) - ιT (w t) - (s - t) • ιT v‖ ≤ (ε / 2) * |s - t| := by
      rw [← h_iota_rem]
      exact h_iota_linf rem_w ((ε / 2) * |s - t|) (by positivity) h_rem_pt
    rw [Real.dist_eq, sub_zero, Real.norm_eq_abs,
      abs_of_nonneg (mul_nonneg (inv_nonneg.mpr (abs_nonneg _)) (norm_nonneg _))]
    by_cases h_eq : s = t
    · subst h_eq
      simp [hε]
    · have h_abs_pos : 0 < |s - t| := abs_pos.mpr (sub_ne_zero.mpr h_eq)
      calc |s - t|⁻¹ * ‖ιT (w s) - ιT (w t) - (s - t) • ιT v‖
        _ ≤ |s - t|⁻¹ * ((ε / 2) * |s - t|) :=
          mul_le_mul_of_nonneg_left h_norm_rem (inv_nonneg.mpr (abs_nonneg _))
        _ = ε / 2 := by
          have : |s - t| ≠ 0 := ne_of_gt h_abs_pos
          field_simp
        _ < ε := half_lt_self hε
  have h_ortho : ∀ (f : CinfT) (h_deriv : deriv (f : ℝ → ℝ) ∈ CinfT),
      inner ℝ (ιT f) (ιT ⟨deriv (f : ℝ → ℝ), h_deriv⟩) = 0 := by
    intro f h_deriv
    let f₀ : ℝ → ℝ := (f : ℝ → ℝ)
    let f₁ : ℝ → ℝ := deriv f₀
    let q₁ : CinfT := ⟨f₁, h_deriv⟩
    have hf₀_per : Function.Periodic f₀ 1 := f.2.2
    have hf₀_diff : Differentiable ℝ f₀ := f.2.1.differentiable (by decide)
    have hf₁_cont : Continuous f₁ := h_deriv.1.continuous
    have hf₀_per01 : f₀ 1 = f₀ 0 := by
      have h0 := hf₀_per 0
      simpa using h0
    have h_deriv_c : ∀ x ∈ Set.uIcc (0 : ℝ) 1,
        HasDerivAt (fun y : ℝ => (f₀ y : ℂ)) (f₁ x : ℂ) x :=
      fun x _ => (hf₀_diff.differentiableAt.hasDerivAt).ofReal_comp
    have h_int_c : IntervalIntegrable (fun x : ℝ => (f₁ x : ℂ)) volume 0 1 :=
      (Complex.continuous_ofReal.comp hf₁_cont).intervalIntegrable 0 1
    have h_fc_deriv : ∀ n : ℤ,
        fourierCircle f₁ n = (((2 * π * (n : ℝ) : ℝ) : ℂ) * I) * fourierCircle f₀ n := by
      intro n
      by_cases hn : n = 0
      · subst hn
        have h_fc_zero : fourierCircle f₁ 0 = 0 := by
          dsimp [fourierCircle]
          have h_integrand : (fun x : ℝ =>
              Complex.exp (-(((2 * π * (0 : ℤ) : ℝ) : ℂ) * (x : ℂ)) * I) * (f₁ x : ℂ)) =
              (fun x : ℝ => (f₁ x : ℂ)) := by
            ext x
            simp
          rw [h_integrand, intervalIntegral.integral_eq_sub_of_hasDerivAt h_deriv_c h_int_c,
            hf₀_per01, sub_self]
        rw [h_fc_zero]
        simp
      · have h_eq := fourierCoeffOn_of_hasDerivAt zero_lt_one hn h_deriv_c h_int_c
        rw [h_fc_eq f₀ n, h_fc_eq f₁ n] at h_eq
        rw [hf₀_per01, sub_self, mul_zero, zero_sub, Complex.ofReal_one, Complex.ofReal_zero,
          sub_zero, one_mul] at h_eq
        have hpi_c : (π : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
        have hn_c : (n : ℂ) ≠ 0 := Int.cast_ne_zero.mpr hn
        rw [h_eq]
        push_cast
        field_simp
    have h_prof_deriv : ∀ n : ℤ,
        hm1ProfileT f₁ n = (((2 * π * (n : ℝ) : ℝ) : ℂ) * I) * hm1ProfileT f₀ n := by
      intro n
      dsimp [hm1ProfileT]
      rw [h_fc_deriv n]
      ring
    have h_inner_mode : ∀ (c : ℝ) (z : ℂ), inner ℝ z (((c : ℂ) * I) * z) = 0 := by
      intro c z
      rw [Complex.inner]
      simp [mul_re, mul_im]
      ring
    change inner ℝ (toHm1T f) (toHm1T q₁) = 0
    rw [lp.inner_eq_tsum]
    have h_term_zero : (fun n : ℤ => inner ℝ ((toHm1T f : ℤ → ℂ) n) ((toHm1T q₁ : ℤ → ℂ) n)) =
        (fun _ : ℤ => (0 : ℝ)) := by
      ext n
      rw [h_toHm1T_apply f n, h_toHm1T_apply q₁ n]
      change inner ℝ (hm1ProfileT f₀ n) (hm1ProfileT f₁ n) = 0
      rw [h_prof_deriv n]
      exact h_inner_mode (2 * π * (n : ℝ)) (hm1ProfileT f₀ n)
    rw [h_term_zero, tsum_zero]
  exact ⟨h_iota_add, h_iota_linf, h_iota_deriv, h_ortho⟩

theorem kdvRHS_cinfT_hm1_hasDerivAt_and_uniform_boundT (h_iota_sub : ∀ (q₁ q₂ : CinfT)
       (h_sub : (fun x : ℝ => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x) ∈ CinfT),
      ιT ⟨fun x : ℝ => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x, h_sub⟩ = ιT q₁ - ιT q₂)
    (h_iota_smul : ∀ (c : ℝ) (q : CinfT)
       (h_smul : (fun x : ℝ => c * (q : ℝ → ℝ) x) ∈ CinfT),
      ιT ⟨fun x : ℝ => c * (q : ℝ → ℝ) x, h_smul⟩ = c • ιT q)
    (h_iota_linf : ∀ (g : CinfT) (B : ℝ),
      0 ≤ B → (∀ x : ℝ, |(g : ℝ → ℝ) x| ≤ B) → ‖ιT g‖ ≤ B)
    (w : ℝ → CinfT) (K : ℝ → CinfT)
    (hw_diff : ∀ t : ℝ, ∃ v : CinfT, HasCinfDerivAtT w v t)
    (hK : ∀ t x : ℝ, (K t : ℝ → ℝ) x = kdvRHS (w t : ℝ → ℝ) x) :
    (∀ τ : ℝ, ∃ M_K : ℝ, 0 ≤ M_K ∧
      ∀ τ' ∈ Set.uIcc 0 τ, (∀ y : ℝ, |(K τ' : ℝ → ℝ) y| ≤ M_K) ∧ ‖ιT (K τ')‖ ≤ M_K) ∧
    (∀ (t : ℝ) (v K' : CinfT),
      HasCinfDerivAtT w v t →
      (∀ x : ℝ, (K' : ℝ → ℝ) x =
        -iteratedDeriv 3 (v : ℝ → ℝ) x +
          6 * deriv (fun z => (w t : ℝ → ℝ) z * (v : ℝ → ℝ) z) x) →
      HasDerivAt (fun s => ιT (K s)) (ιT K') t) :=
by
  have h_deriv_cinfT : ∀ f : ℝ → ℝ, f ∈ CinfT → deriv f ∈ CinfT := by
    intro f hf
    refine ⟨by simpa using hf.1.iterate_deriv 1, fun x => ?_⟩
    have h_shift : (fun y : ℝ => f (y + 1)) = f := funext hf.2
    have h_comp := deriv_comp_add_const f 1 x
    rw [h_shift] at h_comp
    exact h_comp.symm
  have h_smul_cinfT : ∀ (c : ℝ) (f : ℝ → ℝ), f ∈ CinfT → (fun x : ℝ => c * f x) ∈ CinfT := by
    intro c f hf
    refine ⟨contDiff_const.mul hf.1, fun x => ?_⟩
    dsimp
    rw [hf.2 x]
  have h_add_cinfT : ∀ (f g : ℝ → ℝ), f ∈ CinfT → g ∈ CinfT → (fun x : ℝ => f x + g x) ∈ CinfT := by
    intro f g hf hg
    refine ⟨hf.1.add hg.1, fun x => ?_⟩
    dsimp
    rw [hf.2 x, hg.2 x]
  have h_sub_cinfT : ∀ (f g : ℝ → ℝ), f ∈ CinfT → g ∈ CinfT → (fun x : ℝ => f x - g x) ∈ CinfT := by
    intro f g hf hg
    refine ⟨hf.1.sub hg.1, fun x => ?_⟩
    dsimp
    rw [hf.2 x, hg.2 x]
  have h_mul_cinfT : ∀ (f g : ℝ → ℝ), f ∈ CinfT → g ∈ CinfT → (fun x : ℝ => f x * g x) ∈ CinfT := by
    intro f g hf hg
    refine ⟨hf.1.mul hg.1, fun x => ?_⟩
    dsimp
    rw [hf.2 x, hg.2 x]
  have h_iter_cinfT : ∀ (n : ℕ) (f : ℝ → ℝ), f ∈ CinfT → iteratedDeriv n f ∈ CinfT := by
    intro n
    induction n with
    | zero =>
      intro f hf
      simpa [iteratedDeriv_zero] using hf
    | succ n ih =>
      intro f hf
      rw [iteratedDeriv_succ]
      exact h_deriv_cinfT _ (ih f hf)
  have h_K'_cinfT : ∀ (q v : CinfT),
      (fun x : ℝ => -iteratedDeriv 3 (v : ℝ → ℝ) x +
        6 * deriv (fun z => (q : ℝ → ℝ) z * (v : ℝ → ℝ) z) x) ∈ CinfT := by
    intro q v
    have h1 : iteratedDeriv 3 (v : ℝ → ℝ) ∈ CinfT := h_iter_cinfT 3 _ v.2
    have h2 : (fun x : ℝ => (-1 : ℝ) * iteratedDeriv 3 (v : ℝ → ℝ) x) ∈ CinfT :=
      h_smul_cinfT (-1) _ h1
    have h3 : (fun z : ℝ => (q : ℝ → ℝ) z * (v : ℝ → ℝ) z) ∈ CinfT :=
      h_mul_cinfT _ _ q.2 v.2
    have h4 : deriv (fun z : ℝ => (q : ℝ → ℝ) z * (v : ℝ → ℝ) z) ∈ CinfT :=
      h_deriv_cinfT _ h3
    have h5 : (fun x : ℝ => 6 * deriv (fun z : ℝ => (q : ℝ → ℝ) z * (v : ℝ → ℝ) z) x) ∈ CinfT :=
      h_smul_cinfT 6 _ h4
    have h6 := h_add_cinfT _ _ h2 h5
    have h_eq : (fun x : ℝ => -iteratedDeriv 3 (v : ℝ → ℝ) x +
        6 * deriv (fun z : ℝ => (q : ℝ → ℝ) z * (v : ℝ → ℝ) z) x) =
        (fun x : ℝ => (-1 : ℝ) * iteratedDeriv 3 (v : ℝ → ℝ) x +
        6 * deriv (fun z : ℝ => (q : ℝ → ℝ) z * (v : ℝ → ℝ) z) x) := by
      ext x
      ring
    rw [h_eq]
    exact h6
  have h_lincomb_cinfT : ∀ (q₁ q₂ q₃ : CinfT) (c : ℝ),
      ∃ δ : CinfT,
        (∀ x : ℝ, (δ : ℝ → ℝ) x = (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x - c * (q₃ : ℝ → ℝ) x) ∧
        ιT δ = ιT q₁ - ιT q₂ - c • ιT q₃ := by
    intro q₁ q₂ q₃ c
    have h12 : (fun x : ℝ => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x) ∈ CinfT :=
      h_sub_cinfT _ _ q₁.2 q₂.2
    let q₁₂ : CinfT := ⟨fun x : ℝ => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x, h12⟩
    have hc3 : (fun x : ℝ => c * (q₃ : ℝ → ℝ) x) ∈ CinfT :=
      h_smul_cinfT c _ q₃.2
    let cq₃ : CinfT := ⟨fun x : ℝ => c * (q₃ : ℝ → ℝ) x, hc3⟩
    have h_all : (fun x : ℝ => (q₁₂ : ℝ → ℝ) x - (cq₃ : ℝ → ℝ) x) ∈ CinfT :=
      h_sub_cinfT _ _ q₁₂.2 cq₃.2
    refine ⟨⟨fun x : ℝ => (q₁₂ : ℝ → ℝ) x - (cq₃ : ℝ → ℝ) x, h_all⟩, fun _ => rfl, ?_⟩
    rw [h_iota_sub q₁₂ cq₃ h_all, h_iota_sub q₁ q₂ h12, h_iota_smul c q₃ hc3]
  have h_cdAt : ∀ (q : CinfT) (n : ℕ) (x : ℝ), ContDiffAt ℝ n (q : ℝ → ℝ) x :=
    fun q n x => (q.2.1.of_le (WithTop.coe_le_coe.mpr le_top)).contDiffAt
  have h_iter_sub : ∀ (q₁ q₂ : CinfT) (n : ℕ) (x : ℝ),
      iteratedDeriv n (fun z : ℝ => (q₁ : ℝ → ℝ) z - (q₂ : ℝ → ℝ) z) x =
        iteratedDeriv n (q₁ : ℝ → ℝ) x - iteratedDeriv n (q₂ : ℝ → ℝ) x :=
    fun q₁ q₂ n x => iteratedDeriv_sub (h_cdAt q₁ n x) (h_cdAt q₂ n x)
  have h_cinfT_bound : ∀ q : CinfT, ∃ B : ℝ, 0 ≤ B ∧ ∀ x : ℝ, |(q : ℝ → ℝ) x| ≤ B := by
    intro q
    obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn q.2.1.continuous.continuousOn
    refine ⟨max C 0, le_max_right C 0, fun x => ?_⟩
    let x₀ : ℝ := Int.fract x
    have hx₀_mem : x₀ ∈ Set.Icc (0 : ℝ) 1 :=
      ⟨Int.fract_nonneg x, le_of_lt (Int.fract_lt_one x)⟩
    have h_per : (q : ℝ → ℝ) x = (q : ℝ → ℝ) x₀ := by
      have hp : (q : ℝ → ℝ) (x - (⌊x⌋ : ℝ) * 1) = (q : ℝ → ℝ) x :=
        q.2.2.sub_int_mul_eq (⌊x⌋)
      rw [mul_one] at hp
      exact hp.symm
    rw [h_per]
    have h_le_C : |(q : ℝ → ℝ) x₀| ≤ C := by
      simpa [Real.norm_eq_abs] using hC x₀ hx₀_mem
    exact le_trans h_le_C (le_max_left C 0)
  have h_prod_deriv : ∀ (q v : CinfT) (x : ℝ),
      deriv (fun z => (q : ℝ → ℝ) z * (v : ℝ → ℝ) z) x =
        deriv (q : ℝ → ℝ) x * (v : ℝ → ℝ) x + (q : ℝ → ℝ) x * deriv (v : ℝ → ℝ) x := by
    intro q v x
    have hq : HasDerivAt (q : ℝ → ℝ) (deriv (q : ℝ → ℝ) x) x :=
      (q.2.1.differentiable (by decide)).differentiableAt.hasDerivAt
    have hv : HasDerivAt (v : ℝ → ℝ) (deriv (v : ℝ → ℝ) x) x :=
      (v.2.1.differentiable (by decide)).differentiableAt.hasDerivAt
    exact (hq.mul hv).deriv
  have h_K_taylor : ∀ (t : ℝ) (v K' : CinfT),
      HasCinfDerivAtT w v t →
      (∀ x : ℝ, (K' : ℝ → ℝ) x =
        -iteratedDeriv 3 (v : ℝ → ℝ) x +
          6 * deriv (fun z => (w t : ℝ → ℝ) z * (v : ℝ → ℝ) z) x) →
      ∀ ε : ℝ, 0 < ε → ∃ η : ℝ, 0 < η ∧
        ∀ s : ℝ, |s - t| < η → ∀ x : ℝ,
          |(K s : ℝ → ℝ) x - (K t : ℝ → ℝ) x - (s - t) * (K' : ℝ → ℝ) x| ≤ ε * |s - t| := by
    intro t v K' hw hK' ε hε
    let d_wt : CinfT := ⟨deriv (w t : ℝ → ℝ), h_deriv_cinfT _ (w t).2⟩
    let d_v : CinfT := ⟨deriv (v : ℝ → ℝ), h_deriv_cinfT _ v.2⟩
    obtain ⟨B₁, _, hB₁⟩ := h_cinfT_bound (w t)
    obtain ⟨B₂, _, hB₂⟩ := h_cinfT_bound d_wt
    obtain ⟨B₃, _, hB₃⟩ := h_cinfT_bound v
    obtain ⟨B₄, _, hB₄⟩ := h_cinfT_bound d_v
    let B₀ : ℝ := max 1 (max B₁ (max B₂ (max B₃ B₄)))
    have hB₀_ge_1 : 1 ≤ B₀ := le_max_left _ _
    have hB₀_nn : 0 ≤ B₀ := by linarith
    have hB₀_ge_B₁ : B₁ ≤ B₀ := le_trans (le_max_left _ _) (le_max_right _ _)
    have hB₀_ge_B₂ : B₂ ≤ B₀ :=
      le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _))
    have hB₀_ge_B₃ : B₃ ≤ B₀ :=
      le_trans (le_max_left _ _)
        (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _)))
    have hB₀_ge_B₄ : B₄ ≤ B₀ :=
      le_trans (le_max_right _ _)
        (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _)))
    have h_wt_bd : ∀ x : ℝ, |(w t : ℝ → ℝ) x| ≤ B₀ :=
      fun x => le_trans (hB₁ x) hB₀_ge_B₁
    have h_dwt_bd : ∀ x : ℝ, |deriv (w t : ℝ → ℝ) x| ≤ B₀ :=
      fun x => le_trans (hB₂ x) hB₀_ge_B₂
    have h_v_bd : ∀ x : ℝ, |(v : ℝ → ℝ) x| ≤ B₀ :=
      fun x => le_trans (hB₃ x) hB₀_ge_B₃
    have h_dv_bd : ∀ x : ℝ, |deriv (v : ℝ → ℝ) x| ≤ B₀ :=
      fun x => le_trans (hB₄ x) hB₀_ge_B₄
    have hB₀_le_sq : B₀ ≤ B₀ ^ 2 := by
      calc B₀ = B₀ * 1 := (mul_one B₀).symm
        _ ≤ B₀ * B₀ := mul_le_mul_of_nonneg_left hB₀_ge_1 hB₀_nn
        _ = B₀ ^ 2 := (sq B₀).symm
    have h_den_pos : 0 < 1 + 36 * B₀ ^ 2 := by positivity
    let ε₁ : ℝ := min 1 (ε / (1 + 36 * B₀ ^ 2))
    have hε₁_pos : 0 < ε₁ := lt_min one_pos (div_pos hε h_den_pos)
    have hε₁_le_1 : ε₁ ≤ 1 := min_le_left _ _
    have hε₁_le_div : ε₁ ≤ ε / (1 + 36 * B₀ ^ 2) := min_le_right _ _
    have hε₁_le_B₀ : ε₁ ≤ B₀ := le_trans hε₁_le_1 hB₀_ge_1
    obtain ⟨η₀, hη₀_pos, hη₀⟩ := hw 0 ε₁ hε₁_pos
    obtain ⟨η₁, hη₁_pos, hη₁⟩ := hw 1 ε₁ hε₁_pos
    obtain ⟨η₃, hη₃_pos, hη₃⟩ := hw 3 ε₁ hε₁_pos
    let η : ℝ := min η₀ (min η₁ (min η₃ ε₁))
    have hη_pos : 0 < η :=
      lt_min hη₀_pos (lt_min hη₁_pos (lt_min hη₃_pos hε₁_pos))
    refine ⟨η, hη_pos, ?_⟩
    intro s hs x
    have hs₀ : |s - t| < η₀ := lt_of_lt_of_le hs (min_le_left _ _)
    have hs₁ : |s - t| < η₁ :=
      lt_of_lt_of_le hs (le_trans (min_le_right _ _) (min_le_left _ _))
    have hs₃ : |s - t| < η₃ :=
      lt_of_lt_of_le hs (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _)))
    have hs_ε₁ : |s - t| ≤ ε₁ :=
      le_of_lt (lt_of_lt_of_le hs (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))))
    let δ₀ : ℝ := iteratedDeriv 0 (fun y => (w s : ℝ → ℝ) y - (w t : ℝ → ℝ) y) x -
      (s - t) * iteratedDeriv 0 (v : ℝ → ℝ) x
    let δ₁ : ℝ := iteratedDeriv 1 (fun y => (w s : ℝ → ℝ) y - (w t : ℝ → ℝ) y) x -
      (s - t) * iteratedDeriv 1 (v : ℝ → ℝ) x
    let δ₃ : ℝ := iteratedDeriv 3 (fun y => (w s : ℝ → ℝ) y - (w t : ℝ → ℝ) y) x -
      (s - t) * iteratedDeriv 3 (v : ℝ → ℝ) x
    have hδ₀_bd : |δ₀| ≤ ε₁ * |s - t| := hη₀ s hs₀ x
    have hδ₁_bd : |δ₁| ≤ ε₁ * |s - t| := hη₁ s hs₁ x
    have hδ₃_bd : |δ₃| ≤ ε₁ * |s - t| := hη₃ s hs₃ x
    have hδ₀_eq : δ₀ = (w s : ℝ → ℝ) x - (w t : ℝ → ℝ) x - (s - t) * (v : ℝ → ℝ) x := by
      dsimp [δ₀]
      rw [iteratedDeriv_zero, iteratedDeriv_zero]
    have hδ₁_eq : δ₁ = deriv (w s : ℝ → ℝ) x - deriv (w t : ℝ → ℝ) x - (s - t) * deriv (v : ℝ → ℝ) x := by
      dsimp [δ₁]
      rw [h_iter_sub (w s) (w t) 1 x, iteratedDeriv_one, iteratedDeriv_one, iteratedDeriv_one]
    have hδ₃_eq : δ₃ = iteratedDeriv 3 (w s : ℝ → ℝ) x - iteratedDeriv 3 (w t : ℝ → ℝ) x -
        (s - t) * iteratedDeriv 3 (v : ℝ → ℝ) x := by
      dsimp [δ₃]
      rw [h_iter_sub (w s) (w t) 3 x]
    have h_pt_id :
        (K s : ℝ → ℝ) x - (K t : ℝ → ℝ) x - (s - t) * (K' : ℝ → ℝ) x =
          -δ₃ + 6 * (δ₀ * deriv (w t : ℝ → ℝ) x +
            (w t : ℝ → ℝ) x * δ₁ +
            ((w s : ℝ → ℝ) x - (w t : ℝ → ℝ) x) *
              (deriv (w s : ℝ → ℝ) x - deriv (w t : ℝ → ℝ) x)) := by
      rw [hK s x, hK t x, hK' x, h_prod_deriv (w t) v x, hδ₀_eq, hδ₁_eq, hδ₃_eq]
      dsimp [kdvRHS]
      ring
    have h_diff0_bd : |(w s : ℝ → ℝ) x - (w t : ℝ → ℝ) x| ≤ 2 * B₀ * |s - t| := by
      have h_id : (w s : ℝ → ℝ) x - (w t : ℝ → ℝ) x = δ₀ + (s - t) * (v : ℝ → ℝ) x := by
        rw [hδ₀_eq]; ring
      rw [h_id]
      have h_tri := abs_add_le δ₀ ((s - t) * (v : ℝ → ℝ) x)
      rw [abs_mul] at h_tri
      have h_v_st : |s - t| * |(v : ℝ → ℝ) x| ≤ B₀ * |s - t| := by
        calc |s - t| * |(v : ℝ → ℝ) x|
          _ ≤ |s - t| * B₀ := mul_le_mul_of_nonneg_left (h_v_bd x) (abs_nonneg _)
          _ = B₀ * |s - t| := mul_comm _ _
      have h_δ₀_st : |δ₀| ≤ B₀ * |s - t| :=
        le_trans hδ₀_bd (mul_le_mul_of_nonneg_right hε₁_le_B₀ (abs_nonneg _))
      linarith
    have h_diff1_bd : |deriv (w s : ℝ → ℝ) x - deriv (w t : ℝ → ℝ) x| ≤ 2 * B₀ * ε₁ := by
      have h_id : deriv (w s : ℝ → ℝ) x - deriv (w t : ℝ → ℝ) x = δ₁ + (s - t) * deriv (v : ℝ → ℝ) x := by
        rw [hδ₁_eq]; ring
      rw [h_id]
      have h_tri := abs_add_le δ₁ ((s - t) * deriv (v : ℝ → ℝ) x)
      rw [abs_mul] at h_tri
      have h_dv_st : |s - t| * |deriv (v : ℝ → ℝ) x| ≤ B₀ * |s - t| := by
        calc |s - t| * |deriv (v : ℝ → ℝ) x|
          _ ≤ |s - t| * B₀ := mul_le_mul_of_nonneg_left (h_dv_bd x) (abs_nonneg _)
          _ = B₀ * |s - t| := mul_comm _ _
      have h_δ₁_st : |δ₁| ≤ B₀ * |s - t| :=
        le_trans hδ₁_bd (mul_le_mul_of_nonneg_right hε₁_le_B₀ (abs_nonneg _))
      have h_step : |δ₁ + (s - t) * deriv (v : ℝ → ℝ) x| ≤ 2 * B₀ * |s - t| := by linarith
      exact le_trans h_step (mul_le_mul_of_nonneg_left hs_ε₁ (by positivity))
    have h_term1 : |δ₀ * deriv (w t : ℝ → ℝ) x| ≤ B₀ ^ 2 * ε₁ * |s - t| := by
      rw [abs_mul]
      calc |δ₀| * |deriv (w t : ℝ → ℝ) x|
        _ ≤ (ε₁ * |s - t|) * B₀ :=
          mul_le_mul hδ₀_bd (h_dwt_bd x) (abs_nonneg _) (by positivity)
        _ = B₀ * (ε₁ * |s - t|) := by ring
        _ ≤ B₀ ^ 2 * (ε₁ * |s - t|) :=
          mul_le_mul_of_nonneg_right hB₀_le_sq (by positivity)
        _ = B₀ ^ 2 * ε₁ * |s - t| := by ring
    have h_term2 : |(w t : ℝ → ℝ) x * δ₁| ≤ B₀ ^ 2 * ε₁ * |s - t| := by
      rw [abs_mul]
      calc |(w t : ℝ → ℝ) x| * |δ₁|
        _ ≤ B₀ * (ε₁ * |s - t|) :=
          mul_le_mul (h_wt_bd x) hδ₁_bd (abs_nonneg _) hB₀_nn
        _ ≤ B₀ ^ 2 * (ε₁ * |s - t|) :=
          mul_le_mul_of_nonneg_right hB₀_le_sq (by positivity)
        _ = B₀ ^ 2 * ε₁ * |s - t| := by ring
    have h_term3 :
        |((w s : ℝ → ℝ) x - (w t : ℝ → ℝ) x) *
          (deriv (w s : ℝ → ℝ) x - deriv (w t : ℝ → ℝ) x)| ≤
          4 * B₀ ^ 2 * ε₁ * |s - t| := by
      rw [abs_mul]
      calc |(w s : ℝ → ℝ) x - (w t : ℝ → ℝ) x| *
            |deriv (w s : ℝ → ℝ) x - deriv (w t : ℝ → ℝ) x|
