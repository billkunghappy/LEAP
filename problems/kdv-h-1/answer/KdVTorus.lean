        ⟨fun x : ℝ => (U s' : ℝ → ℝ) x - (U s : ℝ → ℝ) x, h_sub_mem (U s') (U s)⟩
      let smul_D : CinfT :=
        ⟨fun x : ℝ => (s' - s) * (D s : ℝ → ℝ) x, h_smul_mem (s' - s) (D s)⟩
      let rem_U : CinfT :=
        ⟨fun x : ℝ => (diff_U : ℝ → ℝ) x - (smul_D : ℝ → ℝ) x, h_sub_mem diff_U smul_D⟩
      have h_rem_iota : ιT rem_U = ιT (U s') - ιT (U s) - (s' - s) • ιT (D s) := by
        dsimp [rem_U]
        rw [h_iota_sub diff_U smul_D (h_sub_mem diff_U smul_D)]
        dsimp [diff_U, smul_D]
        rw [h_iota_sub (U s') (U s) (h_sub_mem (U s') (U s)),
            h_iota_smul (s' - s) (D s) (h_smul_mem (s' - s) (D s))]
      have h_rem_norm : ‖γ s' - γ s - (s' - s) • γ' s‖ = ‖ιT rem_U‖ := by
        change ‖(ιT (U s') : lp (fun _ : ℤ => ℂ) 2) - (ιT (U s) : lp (fun _ : ℤ => ℂ) 2) -
            (s' - s) • (ιT (D s) : lp (fun _ : ℤ => ℂ) 2)‖ = ‖ιT rem_U‖
        rw [← Submodule.coe_sub, ← Submodule.coe_smul, ← Submodule.coe_sub,
            Submodule.norm_coe, h_rem_iota]
      have h_rem_le : ‖ιT rem_U‖ ≤ (ε / 2) * |s' - s| := by
        refine le_trans (h_iota_le_sem0 rem_U) ?_
        refine h_sem_le 0 (rem_U : ℝ → ℝ) ((ε / 2) * |s' - s|) (by positivity) (fun x => ?_)
        have hd_x := h_d s' hs' x
        simpa [rem_U, diff_U, smul_D, iteratedDeriv_zero] using hd_x
      rw [h_rem_norm]
      by_cases h_eq : s' = s
      · subst h_eq
        simp [hε]
      · have h_pos : 0 < |s' - s| := abs_pos.mpr (sub_ne_zero.mpr h_eq)
        calc |s' - s|⁻¹ * ‖ιT rem_U‖
          _ ≤ |s' - s|⁻¹ * ((ε / 2) * |s' - s|) :=
            mul_le_mul_of_nonneg_left h_rem_le (by positivity)
          _ = ε / 2 := by
            have : |s' - s| ≠ 0 := ne_of_gt h_pos
            field_simp
          _ < ε := half_lt_self hε
    have h_ftc : ∫ τ in (0 : ℝ)..t, γ' τ = γ t - γ 0 :=
      intervalIntegral.integral_eq_sub_of_hasDeriv_right
        hγ_cont.continuousOn
        (fun x _ => (hγ_deriv x).hasDerivWithinAt)
        (hγ'_cont.intervalIntegrable 0 t)
    rw [hγ0, sub_zero] at h_ftc
    have h_norm_γ : ∀ s : ℝ, ‖γ s‖ = ‖ιT (W₁ s) - ιT (W₂ s)‖ := by
      intro s
      change ‖(ιT (U s) : lp (fun _ : ℤ => ℂ) 2)‖ = ‖ιT (W₁ s) - ιT (W₂ s)‖
      rw [Submodule.norm_coe, h_iota_sub (W₁ s) (W₂ s) (h_sub_mem (W₁ s) (W₂ s))]
    have h_norm_γ' : ∀ τ : ℝ, ‖γ' τ‖ = ‖ιT (G₁ τ) - ιT (G₂ τ)‖ := by
      intro τ
      change ‖(ιT (D τ) : lp (fun _ : ℤ => ℂ) 2)‖ = ‖ιT (G₁ τ) - ιT (G₂ τ)‖
      rw [Submodule.norm_coe, h_iota_sub (G₁ τ) (G₂ τ) (h_sub_mem (G₁ τ) (G₂ τ))]
    rw [← h_norm_γ t, ← h_ftc]
    have h_int_eq : (∫ τ in (0 : ℝ)..t, ‖ιT (G₁ τ) - ιT (G₂ τ)‖) =
        ∫ τ in (0 : ℝ)..t, ‖γ' τ‖ := by
      refine intervalIntegral.integral_congr (fun τ _ => ?_)
      exact (h_norm_γ' τ).symm
    rw [h_int_eq]
    exact intervalIntegral.norm_integral_le_abs_integral_norm

theorem cinfT_picard_iterates_exists_and_geometric_diff_bound (h_iota_sub : ∀ (q₁ q₂ : CinfT)
       (h_sub : (fun x : ℝ => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x) ∈ CinfT),
      ιT ⟨fun x : ℝ => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x, h_sub⟩ = ιT q₁ - ιT q₂)
    (h_interp : (∀ (n : ℕ) (f : ℝ → ℝ), 0 ≤ cinfSeminormT n f) ∧
      (∀ (n : ℕ) (f : ℝ → ℝ) (B : ℝ),
        0 ≤ B → (∀ x : ℝ, |iteratedDeriv n f x| ≤ B) → cinfSeminormT n f ≤ B) ∧
      (∀ (g : CinfT) (n : ℕ) (x : ℝ),
        |iteratedDeriv n (g : ℝ → ℝ) x| ≤ cinfSeminormT n (g : ℝ → ℝ)) ∧
      (∀ (g : CinfT), ‖ιT g‖ ≤ cinfSeminormT 0 (g : ℝ → ℝ)) ∧
      (∀ (B : ℕ → ℝ) (n : ℕ) (ε : ℝ), 0 < ε →
        ∃ η : ℝ, 0 < η ∧
          ∀ (g : CinfT),
            (∀ m : ℕ, cinfSeminormT m (g : ℝ → ℝ) ≤ B m) →
            ‖ιT g‖ < η →
            cinfSeminormT n (g : ℝ → ℝ) < ε) ∧
      (∀ (B : ℕ → ℝ) (C₀ L : ℝ), 0 ≤ C₀ → 0 ≤ L →
        ∀ (n : ℕ), ∃ C : ℝ, 0 ≤ C ∧
          ∀ (m : ℕ) (g : CinfT),
            (∀ j : ℕ, cinfSeminormT j (g : ℝ → ℝ) ≤ B j) →
            ‖ιT g‖ ≤ C₀ * L ^ m / (Nat.factorial m : ℝ) →
            cinfSeminormT n (g : ℝ → ℝ) ≤ C * (1 / 2 : ℝ) ^ m))
    (h_int_op : (∀ (w₀ : CinfT) (G : ℝ → CinfT),
        (∀ (n : ℕ) (t ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
          ∀ s : ℝ, |s - t| < η →
            cinfSeminormT n (fun x => (G s : ℝ → ℝ) x - (G t : ℝ → ℝ) x) < ε) →
        ∃ W : ℝ → CinfT,
          (∀ (n : ℕ) (t ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
            ∀ s : ℝ, |s - t| < η →
              cinfSeminormT n (fun x => (W s : ℝ → ℝ) x - (W t : ℝ → ℝ) x) < ε) ∧
          (∀ (t : ℝ) (n : ℕ) (x : ℝ),
            iteratedDeriv n (W t : ℝ → ℝ) x =
              iteratedDeriv n (w₀ : ℝ → ℝ) x + ∫ τ in (0 : ℝ)..t, iteratedDeriv n (G τ : ℝ → ℝ) x) ∧
          (∀ (n : ℕ) (t : ℝ),
            cinfSeminormT n (W t : ℝ → ℝ) ≤
              cinfSeminormT n (w₀ : ℝ → ℝ) +
                |∫ τ in (0 : ℝ)..t, cinfSeminormT n (G τ : ℝ → ℝ)|)) ∧
      (∀ (w₀ : CinfT) (G₁ G₂ W₁ W₂ : ℝ → CinfT),
        (∀ (n : ℕ) (t ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
          ∀ s : ℝ, |s - t| < η →
            cinfSeminormT n (fun x => (G₁ s : ℝ → ℝ) x - (G₁ t : ℝ → ℝ) x) < ε) →
        (∀ (n : ℕ) (t ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
          ∀ s : ℝ, |s - t| < η →
            cinfSeminormT n (fun x => (G₂ s : ℝ → ℝ) x - (G₂ t : ℝ → ℝ) x) < ε) →
        (∀ (t : ℝ) (n : ℕ) (x : ℝ),
          iteratedDeriv n (W₁ t : ℝ → ℝ) x =
            iteratedDeriv n (w₀ : ℝ → ℝ) x + ∫ τ in (0 : ℝ)..t, iteratedDeriv n (G₁ τ : ℝ → ℝ) x) →
        (∀ (t : ℝ) (n : ℕ) (x : ℝ),
          iteratedDeriv n (W₂ t : ℝ → ℝ) x =
            iteratedDeriv n (w₀ : ℝ → ℝ) x + ∫ τ in (0 : ℝ)..t, iteratedDeriv n (G₂ τ : ℝ → ℝ) x) →
        ∀ (t : ℝ),
          ‖ιT (W₁ t) - ιT (W₂ t)‖ ≤ |∫ τ in (0 : ℝ)..t, ‖ιT (G₁ τ) - ιT (G₂ τ)‖|))
    (V : CinfT → CinfT) (M₀ L_lip : ℝ) (hM₀ : 0 ≤ M₀) (hL_lip : 0 ≤ L_lip)
    (hV_bdd : ∀ q : CinfT, ‖ιT (V q)‖ ≤ M₀)
    (hV_lip : ∀ q₁ q₂ : CinfT, ‖ιT (V q₁) - ιT (V q₂)‖ ≤ L_lip * ‖ιT q₁ - ιT q₂‖)
    (hV_tier : ∀ (n : ℕ) (M : ℕ → ℝ),
      ∃ (A B : ℝ), 0 ≤ A ∧ 0 ≤ B ∧
        ∀ q : CinfT,
          (∀ m < n, cinfSeminormT m (q : ℝ → ℝ) ≤ M m) →
          cinfSeminormT n (V q : ℝ → ℝ) ≤ A * cinfSeminormT n (q : ℝ → ℝ) + B)
    (w₀ : CinfT) :
    (∀ (u : ℝ → CinfT),
      (∀ (n : ℕ) (t ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
        ∀ s : ℝ, |s - t| < η →
          cinfSeminormT n (fun x => (u s : ℝ → ℝ) x - (u t : ℝ → ℝ) x) < ε) →
      (∀ (n : ℕ) (t ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
        ∀ s : ℝ, |s - t| < η →
          cinfSeminormT n (fun x => (V (u s) : ℝ → ℝ) x - (V (u t) : ℝ → ℝ) x) < ε)) ∧
    (∀ (w_seq : ℕ → ℝ → CinfT) (w_tilde : ℝ → CinfT),
      (∀ N : ℕ, ∀ (n : ℕ) (t ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
        ∀ s : ℝ, |s - t| < η →
          cinfSeminormT n (fun x => (w_seq N s : ℝ → ℝ) x - (w_seq N t : ℝ → ℝ) x) < ε) →
      (∀ (n : ℕ) (t ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
        ∀ s : ℝ, |s - t| < η →
          cinfSeminormT n (fun x => (w_tilde s : ℝ → ℝ) x - (w_tilde t : ℝ → ℝ) x) < ε) →
      (∀ (T : ℝ), 0 ≤ T → ∀ (n : ℕ),
        ∃ C : ℝ, 0 ≤ C ∧
          ∀ (N : ℕ) (t : ℝ), |t| ≤ T →
            cinfSeminormT n (fun x => (w_seq N t : ℝ → ℝ) x - (w_tilde t : ℝ → ℝ) x) ≤ C * (1 / 2 : ℝ) ^ N) →
      ∀ (t : ℝ) (n : ℕ) (x : ℝ),
        Filter.Tendsto
          (fun N : ℕ => ∫ τ in (0 : ℝ)..t, iteratedDeriv n (V (w_seq N τ) : ℝ → ℝ) x)
          Filter.atTop
          (nhds (∫ τ in (0 : ℝ)..t, iteratedDeriv n (V (w_tilde τ) : ℝ → ℝ) x))) ∧
    (∃ w_seq : ℕ → ℝ → CinfT,
      (∀ t : ℝ, w_seq 0 t = w₀) ∧
      (∀ m : ℕ, ∀ (n : ℕ) (t ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
        ∀ s : ℝ, |s - t| < η →
          cinfSeminormT n (fun x => (w_seq m s : ℝ → ℝ) x - (w_seq m t : ℝ → ℝ) x) < ε) ∧
      (∀ (m : ℕ) (t : ℝ) (n : ℕ) (x : ℝ),
        iteratedDeriv n (w_seq (m + 1) t : ℝ → ℝ) x =
          iteratedDeriv n (w₀ : ℝ → ℝ) x + ∫ τ in (0 : ℝ)..t, iteratedDeriv n (V (w_seq m τ) : ℝ → ℝ) x) ∧
      (∀ (T : ℝ), 0 ≤ T → ∀ (n : ℕ),
        ∃ C : ℝ, 0 ≤ C ∧
          ∀ (m : ℕ) (t : ℝ), |t| ≤ T →
            cinfSeminormT n (fun x => (w_seq (m + 1) t : ℝ → ℝ) x - (w_seq m t : ℝ → ℝ) x) ≤ C * (1 / 2 : ℝ) ^ m)) :=
by
  rcases h_interp with ⟨h_sem_nonneg, h_sem_le, h_pt_le, h_hm1_le, h_eps_eta, h_fact_geom⟩
  rcases h_int_op with ⟨h_int_ex, h_int_diff⟩
  obtain ⟨h_int_mono, h_int_gron⟩ := oriented_intervalIntegral_monomial_and_gronwall_bounds
  have h_zero_mem : (fun _ : ℝ => (0 : ℝ)) ∈ CinfT := ⟨contDiff_const, fun _ => rfl⟩
  let q_zero : CinfT := ⟨fun _ : ℝ => 0, h_zero_mem⟩
  have h_sub_mem : ∀ q₁ q₂ : CinfT, (fun x : ℝ => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x) ∈ CinfT := by
    intro q₁ q₂
    refine ⟨q₁.2.1.sub q₂.2.1, fun x => ?_⟩
    dsimp
    rw [q₁.2.2 x, q₂.2.2 x]
  let q_sub : CinfT → CinfT → CinfT := fun q₁ q₂ =>
    ⟨fun x => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x, h_sub_mem q₁ q₂⟩
  have h_add_mem : ∀ q₁ q₂ : CinfT, (fun x : ℝ => (q₁ : ℝ → ℝ) x + (q₂ : ℝ → ℝ) x) ∈ CinfT := by
    intro q₁ q₂
    refine ⟨q₁.2.1.add q₂.2.1, fun x => ?_⟩
    dsimp
    rw [q₁.2.2 x, q₂.2.2 x]
  have h_cdAt : ∀ (q : CinfT) (n : ℕ) (x : ℝ), ContDiffAt ℝ n (q : ℝ → ℝ) x := by
    intro q n x
    exact (q.2.1.of_le (WithTop.coe_le_coe.mpr le_top)).contDiffAt
  have h_iter_sub : ∀ (q₁ q₂ : CinfT) (n : ℕ) (x : ℝ),
      iteratedDeriv n (fun y => (q₁ : ℝ → ℝ) y - (q₂ : ℝ → ℝ) y) x =
        iteratedDeriv n (q₁ : ℝ → ℝ) x - iteratedDeriv n (q₂ : ℝ → ℝ) x := by
    intro q₁ q₂ n x
    exact iteratedDeriv_sub (h_cdAt q₁ n x) (h_cdAt q₂ n x)
  have h_iter_add : ∀ (q₁ q₂ : CinfT) (n : ℕ) (x : ℝ),
      iteratedDeriv n (fun y => (q₁ : ℝ → ℝ) y + (q₂ : ℝ → ℝ) y) x =
        iteratedDeriv n (q₁ : ℝ → ℝ) x + iteratedDeriv n (q₂ : ℝ → ℝ) x := by
    intro q₁ q₂ n x
    exact iteratedDeriv_add (h_cdAt q₁ n x) (h_cdAt q₂ n x)
  have h_iter_zero : ∀ (n : ℕ) (x : ℝ), iteratedDeriv n (fun _ : ℝ => (0 : ℝ)) x = 0 := by
    intro n x
    simp [iteratedDeriv_const]
  have h_sem_zero_le : ∀ n : ℕ, cinfSeminormT n (fun _ : ℝ => (0 : ℝ)) ≤ 0 := by
    intro n
    refine h_sem_le n (fun _ => 0) 0 le_rfl (fun x => ?_)
    rw [h_iter_zero n x, abs_zero]
  have h_sem_self_sub : ∀ (q : CinfT) (n : ℕ),
      cinfSeminormT n (fun x => (q : ℝ → ℝ) x - (q : ℝ → ℝ) x) ≤ 0 := by
    intro q n
    have h_eq : (fun x => (q : ℝ → ℝ) x - (q : ℝ → ℝ) x) = (fun _ : ℝ => (0 : ℝ)) := by
      ext x
      exact sub_self _
    rw [h_eq]
    exact h_sem_zero_le n
  have h_sem_sub : ∀ (n : ℕ) (q₁ q₂ : CinfT),
      cinfSeminormT n (fun x => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x) ≤
        cinfSeminormT n (q₁ : ℝ → ℝ) + cinfSeminormT n (q₂ : ℝ → ℝ) := by
    intro n q₁ q₂
    refine h_sem_le n _ (cinfSeminormT n (q₁ : ℝ → ℝ) + cinfSeminormT n (q₂ : ℝ → ℝ))
      (add_nonneg (h_sem_nonneg n _) (h_sem_nonneg n _)) (fun x => ?_)
    rw [h_iter_sub q₁ q₂ n x]
    calc |iteratedDeriv n (q₁ : ℝ → ℝ) x - iteratedDeriv n (q₂ : ℝ → ℝ) x|
      _ ≤ |iteratedDeriv n (q₁ : ℝ → ℝ) x| + |iteratedDeriv n (q₂ : ℝ → ℝ) x| :=
        abs_sub _ _
      _ ≤ cinfSeminormT n (q₁ : ℝ → ℝ) + cinfSeminormT n (q₂ : ℝ → ℝ) :=
        add_le_add (h_pt_le q₁ n x) (h_pt_le q₂ n x)
  have h_sem_add : ∀ (n : ℕ) (q₁ q₂ : CinfT),
      cinfSeminormT n (fun x => (q₁ : ℝ → ℝ) x + (q₂ : ℝ → ℝ) x) ≤
        cinfSeminormT n (q₁ : ℝ → ℝ) + cinfSeminormT n (q₂ : ℝ → ℝ) := by
    intro n q₁ q₂
    refine h_sem_le n _ (cinfSeminormT n (q₁ : ℝ → ℝ) + cinfSeminormT n (q₂ : ℝ → ℝ))
      (add_nonneg (h_sem_nonneg n _) (h_sem_nonneg n _)) (fun x => ?_)
    rw [h_iter_add q₁ q₂ n x]
    calc |iteratedDeriv n (q₁ : ℝ → ℝ) x + iteratedDeriv n (q₂ : ℝ → ℝ) x|
      _ ≤ |iteratedDeriv n (q₁ : ℝ → ℝ) x| + |iteratedDeriv n (q₂ : ℝ → ℝ) x| :=
        abs_add_le _ _
      _ ≤ cinfSeminormT n (q₁ : ℝ → ℝ) + cinfSeminormT n (q₂ : ℝ → ℝ) :=
        add_le_add (h_pt_le q₁ n x) (h_pt_le q₂ n x)
  have h_sem_sub_comm : ∀ (n : ℕ) (q₁ q₂ : CinfT),
      cinfSeminormT n (fun x => (q₂ : ℝ → ℝ) x - (q₁ : ℝ → ℝ) x) ≤
        cinfSeminormT n (fun x => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x) := by
    intro n q₁ q₂
    refine h_sem_le n _ (cinfSeminormT n (fun x => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x))
      (h_sem_nonneg n _) (fun x => ?_)
    rw [h_iter_sub q₂ q₁ n x, abs_sub_comm, ← h_iter_sub q₁ q₂ n x]
    exact h_pt_le (q_sub q₁ q₂) n x
  have h_sem_abs_sub : ∀ (n : ℕ) (q₁ q₂ : CinfT),
      |cinfSeminormT n (q₁ : ℝ → ℝ) - cinfSeminormT n (q₂ : ℝ → ℝ)| ≤
        cinfSeminormT n (fun x => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x) := by
    intro n q₁ q₂
    have h_dir : ∀ a b : CinfT,
        cinfSeminormT n (a : ℝ → ℝ) - cinfSeminormT n (b : ℝ → ℝ) ≤
          cinfSeminormT n (fun x => (a : ℝ → ℝ) x - (b : ℝ → ℝ) x) := by
      intro a b
      have h_eq : (a : ℝ → ℝ) = fun x => ((a : ℝ → ℝ) x - (b : ℝ → ℝ) x) + (b : ℝ → ℝ) x := by
        ext x
        ring
      have h_add := h_sem_add n (q_sub a b) b
      dsimp [q_sub] at h_add
      rw [← h_eq] at h_add
      linarith
    exact abs_sub_le_iff.mpr ⟨h_dir q₁ q₂, le_trans (h_dir q₂ q₁) (h_sem_sub_comm n q₁ q₂)⟩
  let IsCinfCont : (ℝ → CinfT) → Prop := fun u =>
    ∀ (n : ℕ) (t ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
      ∀ s : ℝ, |s - t| < η →
        cinfSeminormT n (fun x => (u s : ℝ → ℝ) x - (u t : ℝ → ℝ) x) < ε
  have h_cont_sem : ∀ (u : ℝ → CinfT), IsCinfCont u →
      ∀ n : ℕ, Continuous (fun t : ℝ => cinfSeminormT n (u t : ℝ → ℝ)) := by
    intro u hu n
    rw [Metric.continuous_iff]
    intro t ε hε
    obtain ⟨η, hη, h_lt⟩ := hu n t ε hε
    refine ⟨η, hη, fun s hs => ?_⟩
    rw [Real.dist_eq] at hs ⊢
    exact lt_of_le_of_lt (h_sem_abs_sub n (u s) (u t)) (h_lt s hs)
  have h_cont_eval : ∀ (u : ℝ → CinfT), IsCinfCont u →
      ∀ (n : ℕ) (x : ℝ), Continuous (fun t : ℝ => iteratedDeriv n (u t : ℝ → ℝ) x) := by
    intro u hu n x
    rw [Metric.continuous_iff]
    intro t ε hε
    obtain ⟨η, hη, h_lt⟩ := hu n t ε hε
    refine ⟨η, hη, fun s hs => ?_⟩
    rw [Real.dist_eq] at hs ⊢
    rw [← h_iter_sub (u s) (u t) n x]
    exact lt_of_le_of_lt (h_pt_le (q_sub (u s) (u t)) n x) (h_lt s hs)
