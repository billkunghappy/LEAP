  have h_dom1 : ∀ (Λ : ℝ), 1 ≤ Λ → ∀ (g : CinfT) (x : ℝ),
      |greenIterKernel Λ (g : ℝ → ℝ) 1 x x| ≤ (13 / (2 * Λ)) * ‖ιT g‖ := by
    intro Λ hΛ g x
    have hΛ_pos : 0 < Λ := by linarith
    have h_pt := (greenIterKernel_diag_pointwise_and_dominationT Λ hΛ g).2.1 1 x
    rw [pow_one] at h_pt
    have h_hm1_one : hm1KappaSqT 1 (ιT g) = ‖ιT g‖ ^ 2 := by
