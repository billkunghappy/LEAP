    dsimp [fourierCircle]
    rw [h_x_eq, intervalIntegral.integral_const_mul,
        MeasureTheory.intervalIntegral_integral_swap hG_int]
    congr 1; congr 1 with ξ
    dsimp [G, iterFreqPacketT]
    exact intervalIntegral.integral_div _ _
  
  have h_int_step : ∀ (ℓ : ℕ) (n : ℤ) (ξ : ℝ),
      (∫ x in (0 : ℝ)..1,
        Complex.exp (-(((2 * π * n - ξ : ℝ) : ℂ) * (x : ℂ)) * I) *
          iterWavePacket κ₀ w0 (ℓ + 1) x ξ) =
        -∑' j : ℤ,
          (∫ x in (0 : ℝ)..1,
            Complex.exp (-(((2 * π * ((n - j : ℤ) : ℝ) - (ξ - 2 * π * j) : ℝ) : ℂ) * (x : ℂ)) * I) *
              iterWavePacket κ₀ w0 ℓ x (ξ - 2 * π * j)) *
            fourierCircle w0 j / ((κ₀ ^ 2 + (ξ - 2 * π * j) ^ 2 : ℝ) : ℂ) := by
    intro ℓ n ξ
    obtain ⟨h_wp_cont, K_ℓ, _hK_ℓ_nn, hK_ℓ_bd⟩ := h_wp ℓ
    let F : ℤ → ℝ → ℂ := fun j x =>
