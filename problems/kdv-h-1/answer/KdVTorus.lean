        rw [hasDerivAt_iff_isLittleO, Asymptotics.isLittleO_iff]
        intro ε hε
        rw [Metric.eventually_nhds_iff]
        obtain ⟨η₁, hη₁_pos, hη₁⟩ := hv_deriv d (ε / 2) (half_pos hε)
        have h_cont_v : ContinuousAt (fun σ' : ℝ => iteratedDeriv d (v : ℝ → ℝ) (x + c * σ')) σ :=
          ((hW_smooth v d).continuous.comp (continuous_const.add (continuous_const.mul continuous_id))).continuousAt
        obtain ⟨η₂, hη₂_pos, hη₂⟩ := Metric.continuousAt_iff.mp h_cont_v (ε / 2) (half_pos hε)
        refine ⟨min η₁ η₂, lt_min hη₁_pos hη₂_pos, fun σ' hσ' => ?_⟩
        rw [Real.dist_eq] at hσ'
        have hσ'₁ : |(t₀ + σ') - (t₀ + σ)| < η₁ := by
          have h_eq : (t₀ + σ') - (t₀ + σ) = σ' - σ := by ring
          rw [h_eq]
          exact lt_of_lt_of_le hσ' (min_le_left _ _)
        have hσ'₂ : dist σ' σ < η₂ := by
          rw [Real.dist_eq]
          exact lt_of_lt_of_le hσ' (min_le_right _ _)
        have hδ_σ : δ σ = 0 := by
          dsimp [δ]
          rw [h_iter_sub (w (t₀ + σ)) (w (t₀ + σ)) d (x + c * σ), sub_self]
        have h1 := hη₁ (t₀ + σ') hσ'₁ (x + c * σ')
        have h_sub_eq : (t₀ + σ') - (t₀ + σ) = σ' - σ := by ring
        rw [h_sub_eq] at h1
        have h2 := le_of_lt (hη₂ hσ'₂)
        rw [Real.dist_eq] at h2
        have h_mul2 : |σ' - σ| * |iteratedDeriv d (v : ℝ → ℝ) (x + c * σ') -
            iteratedDeriv d (v : ℝ → ℝ) (x + c * σ)| ≤ (ε / 2) * |σ' - σ| := by
          calc |σ' - σ| * |iteratedDeriv d (v : ℝ → ℝ) (x + c * σ') -
                iteratedDeriv d (v : ℝ → ℝ) (x + c * σ)|
            _ ≤ |σ' - σ| * (ε / 2) := mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
            _ = (ε / 2) * |σ' - σ| := mul_comm _ _
        change |δ σ' - δ σ - (σ' - σ) * iteratedDeriv d (v : ℝ → ℝ) (x + c * σ)| ≤ ε * |σ' - σ|
        rw [hδ_σ, sub_zero]
        have h_split : δ σ' - (σ' - σ) * iteratedDeriv d (v : ℝ → ℝ) (x + c * σ) =
            (δ σ' - (σ' - σ) * iteratedDeriv d (v : ℝ → ℝ) (x + c * σ')) +
              (σ' - σ) * (iteratedDeriv d (v : ℝ → ℝ) (x + c * σ') -
                iteratedDeriv d (v : ℝ → ℝ) (x + c * σ)) := by ring
        rw [h_split]
        have h_tri := abs_add_le
          (δ σ' - (σ' - σ) * iteratedDeriv d (v : ℝ → ℝ) (x + c * σ'))
          ((σ' - σ) * (iteratedDeriv d (v : ℝ → ℝ) (x + c * σ') -
            iteratedDeriv d (v : ℝ → ℝ) (x + c * σ)))
        rw [abs_mul] at h_tri
        linarith
      have h_add := hδ.add hψ
      have h_fn_eq : δ + ψ = fun σ' : ℝ => iteratedDeriv d (w (t₀ + σ') : ℝ → ℝ) (x + c * σ') := by
        ext σ'
        change δ σ' + ψ σ' = _
        dsimp [δ, ψ]
        rw [h_iter_sub (w (t₀ + σ')) (w (t₀ + σ)) d (x + c * σ'), sub_add_cancel]
      rwa [h_fn_eq] at h_add
    have h_v_iter : ∀ (d : ℕ) (t y : ℝ) (v g_tilde : CinfT),
        (∀ z : ℝ, (v : ℝ → ℝ) z = regFlowRHS κ (w t : ℝ → ℝ) z) →
        (∀ z : ℝ, diagGreen κ (w t : ℝ → ℝ) z = 1 / (2 * κ) + (g_tilde : ℝ → ℝ) z) →
        iteratedDeriv d (v : ℝ → ℝ) y =
          16 * κ ^ 5 * iteratedDeriv (d + 1) (g_tilde : ℝ → ℝ) y +
            4 * κ ^ 2 * iteratedDeriv (d + 1) (w t : ℝ → ℝ) y := by
      intro d t y v g_tilde hv_eq hg
