  have h_ct : ∀ w : CinfT,
      hm1KappaSqT κ (ιT w) ≤ (3 / 208 : ℝ) ^ 2 * κ →
      (∀ ℓ : ℕ, Continuous (fun p : ℝ × ℝ => greenIterKernel κ (w : ℝ → ℝ) ℓ p.1 p.2)) ∧
      (∀ (ℓ : ℕ) (x y : ℝ),
        |greenIterKernel κ (w : ℝ → ℝ) ℓ x y| ≤ (1 / κ) * (1 / 4) ^ ℓ * Real.exp (-(κ / 2) * |x - y|)) := by
    intro w hw_208
    obtain ⟨h_fc1, h_fc2, h_fc3⟩ := cinfT_fourierCircle_summable_and_hasSum w
