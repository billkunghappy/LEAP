            ((∫ ξ : ℝ, ‖iterWavePacket κ w0 1 x ξ‖ ^ 2 / (κ ^ 2 + ξ ^ 2) : ℝ) : ℂ) := by
        have h_congr :
            (∫ ξ : ℝ, iterWavePacket κ w0 1 x ξ * star (iterWavePacket κ w0 1 x ξ) / ((κ ^ 2 + ξ ^ 2 : ℝ) : ℂ)) =
