            ∫ ξ : ℝ,
              ‖iterWavePacket κ (w : ℝ → ℝ) ℓ x ξ‖ *
                ‖iterWavePacket κ (w : ℝ → ℝ) 1 x ξ‖ / (κ ^ 2 + ξ ^ 2))) :=
by
  have h_fg_all :
      (∀ x y : ℝ, 0 ≤ freeGreenKernel κ x y ∧ |freeGreenKernel κ x y| ≤ 1 / (2 * κ)) ∧
      (∀ y : ℝ, Integrable (fun z : ℝ => freeGreenKernel κ y z) volume ∧
        (∫ z : ℝ, freeGreenKernel κ y z) = 1 / κ ^ 2) ∧
      (∀ y : ℝ, Integrable (fun z : ℝ => freeGreenKernel κ z y) volume) ∧
      (∀ y η : ℝ,
        (∫ z : ℝ,
          Complex.exp (-((η : ℂ) * (z : ℂ)) * I) *
            (freeGreenKernel κ y z : ℂ)) =
          Complex.exp (-((η : ℂ) * (y : ℂ)) * I) / ((κ ^ 2 + η ^ 2 : ℝ) : ℂ)) := by
    have hκ_pos : 0 < κ := by linarith
    have h_fg_bd : ∀ x y : ℝ, 0 ≤ freeGreenKernel κ x y ∧ |freeGreenKernel κ x y| ≤ 1 / (2 * κ) := by
      intro x y
      refine ⟨by unfold freeGreenKernel; positivity, ?_⟩
      dsimp [freeGreenKernel]
      rw [abs_mul, abs_of_pos (by positivity : 0 < 1 / (2 * κ)), abs_of_pos (Real.exp_pos _)]
      have h_exp_le : Real.exp (-κ * |x - y|) ≤ 1 :=
        Real.exp_le_one_iff.mpr (by nlinarith [abs_nonneg (x - y)])
      exact mul_le_of_le_one_right (by positivity) h_exp_le
    let f_R : ℝ → ℝ := fun v => Real.exp (-κ * |v|)
    have hf_R_Ici : IntegrableOn f_R (Set.Ici 0) volume := by
      have h_ioi := (exp_neg_integrableOn_Ioi (-1 : ℝ) hκ_pos).mono_set
        (Set.Ici_subset_Ioi.mpr (by norm_num : (-1 : ℝ) < 0))
      refine h_ioi.congr_fun ?_ measurableSet_Ici
      intro v hv
      dsimp [f_R]
      have hv_nn : 0 ≤ v := hv
      rw [abs_of_nonneg hv_nn]
