  refine ⟨δ₀, hδ₀_pos, hδ₀_le_δ, ?_⟩
  intro κ₀ hκ₀ u hu hu0
  have h_local_cons : ∀ (κ : ℝ), κ₀ ≤ κ → ∀ (t : ℝ),
