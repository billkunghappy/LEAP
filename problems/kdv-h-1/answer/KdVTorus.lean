          have h1 : HasDerivAt (fun x' : ℝ => -κ₀ * (a - x')) (-κ₀ * (0 - 1)) x :=
            ((hasDerivAt_const x a).sub (hasDerivAt_id x)).const_mul (-κ₀)
          refine (h1.exp.const_mul (1 / 2)).congr_deriv ?_
          field_simp [hκ₀_ne]
          ring
        refine (h0.add h_tail_d2').congr_deriv ?_
        rw [← (h_eq_LR a x).1 hxa]; dsimp [greenKernelLeft]; ring
      · have h0 : HasDerivAt (fun x' : ℝ => -(1 / 2) * Real.exp (-κ₀ * (x' - a)))
            (κ₀ ^ 2 * ((1 / (2 * κ₀)) * Real.exp (-κ₀ * (x - a)))) x := by
          have h1 : HasDerivAt (fun x' : ℝ => -κ₀ * (x' - a)) (-κ₀ * 1) x :=
            ((hasDerivAt_id x).sub_const a).const_mul (-κ₀)
          refine (h1.exp.const_mul (-(1 / 2))).congr_deriv ?_
          field_simp [hκ₀_ne]
        refine (h0.add h_tail_d2').congr_deriv ?_
        rw [← (h_eq_LR a x).2 hax]; dsimp [greenKernelRight]; ring
    have h_tail_G : ∀ a x : ℝ,
        |∑' m : ℕ, greenIterKernel κ₀ w₀ (m + 1) a x| ≤ (1 / 3) * Real.exp (-(κ₀ / 2) * |a - x|) := by
      intro a x
      calc |∑' m : ℕ, greenIterKernel κ₀ w₀ (m + 1) a x|
        _ = ‖∑' m : ℕ, greenIterKernel κ₀ w₀ (m + 1) a x‖ := (Real.norm_eq_abs _).symm
        _ ≤ ∑' m : ℕ, ‖greenIterKernel κ₀ w₀ (m + 1) a x‖ :=
          norm_tsum_le_tsum_norm (h_sum_G1_norm a x)
        _ ≤ ∑' m : ℕ, ((1 / 4 : ℝ) * (1 / 4 : ℝ) ^ m) * Real.exp (-(κ₀ / 2) * |a - x|) := by
          refine Summable.tsum_le_tsum (fun m => ?_) (h_sum_G1_norm a x)
            ((h_geom_sum.mul_left (1 / 4 : ℝ)).mul_right (Real.exp (-(κ₀ / 2) * |a - x|)))
          rw [Real.norm_eq_abs]
          calc |greenIterKernel κ₀ w₀ (m + 1) a x|
            _ ≤ (1 / 4 : ℝ) ^ (m + 1) * Real.exp (-(κ₀ / 2) * |a - x|) :=
              (h_iter_ball s).2.2 (m + 1) a x
            _ = ((1 / 4 : ℝ) * (1 / 4 : ℝ) ^ m) * Real.exp (-(κ₀ / 2) * |a - x|) := by ring
        _ = ((1 / 4 : ℝ) * ∑' m : ℕ, (1 / 4 : ℝ) ^ m) * Real.exp (-(κ₀ / 2) * |a - x|) := by
          rw [tsum_mul_right, tsum_mul_left]
        _ = (1 / 3) * Real.exp (-(κ₀ / 2) * |a - x|) := by rw [h_geom_tsum]; ring
    have h_tail_dG : ∀ a x : ℝ,
        |∑' m : ℕ, greenIterDerivY κ₀ w₀ (m + 1) a x| ≤
          ((4 / 3) * B_d) * Real.exp (-(κ₀ / 2) * |a - x|) := by
      intro a x
      calc |∑' m : ℕ, greenIterDerivY κ₀ w₀ (m + 1) a x|
        _ = ‖∑' m : ℕ, greenIterDerivY κ₀ w₀ (m + 1) a x‖ := (Real.norm_eq_abs _).symm
        _ ≤ ∑' m : ℕ, ‖greenIterDerivY κ₀ w₀ (m + 1) a x‖ :=
          norm_tsum_le_tsum_norm (h_sum_dG1_norm a x)
        _ ≤ ∑' m : ℕ, (B_d * (1 / 4 : ℝ) ^ m) * Real.exp (-(κ₀ / 2) * |a - x|) := by
          refine Summable.tsum_le_tsum (fun m => ?_) (h_sum_dG1_norm a x)
            ((h_geom_sum.mul_left B_d).mul_right (Real.exp (-(κ₀ / 2) * |a - x|)))
          rw [Real.norm_eq_abs]; exact h_dG_bd m a x
        _ = (B_d * ∑' m : ℕ, (1 / 4 : ℝ) ^ m) * Real.exp (-(κ₀ / 2) * |a - x|) := by
          rw [tsum_mul_right, tsum_mul_left]
        _ = ((4 / 3) * B_d) * Real.exp (-(κ₀ / 2) * |a - x|) := by rw [h_geom_tsum]; ring
    have h_tend_LR : ∀ a : ℝ,
        Filter.Tendsto (greenKernelLeft κ₀ w₀ a) Filter.atBot (nhds 0) ∧
        Filter.Tendsto (greenDerivLeft κ₀ w₀ a) Filter.atBot (nhds 0) ∧
        Filter.Tendsto (greenKernelRight κ₀ w₀ a) Filter.atTop (nhds 0) ∧
        Filter.Tendsto (greenDerivRight κ₀ w₀ a) Filter.atTop (nhds 0) := by
      intro a
      have h_tsum_GL : Filter.Tendsto (fun x : ℝ => ∑' m : ℕ, greenIterKernel κ₀ w₀ (m + 1) a x)
          Filter.atBot (nhds 0) :=
        squeeze_zero_norm (a := fun x => (1 / 3) * Real.exp (-(κ₀ / 2) * |a - x|))
          (fun x => by rw [Real.norm_eq_abs]; exact h_tail_G a x)
          (by
            have h0 := (h_exp_abs_bot a).const_mul (1 / 3)
            rwa [mul_zero] at h0)
      have h_tsum_dGL : Filter.Tendsto (fun x : ℝ => ∑' m : ℕ, greenIterDerivY κ₀ w₀ (m + 1) a x)
          Filter.atBot (nhds 0) :=
        squeeze_zero_norm (a := fun x => ((4 / 3) * B_d) * Real.exp (-(κ₀ / 2) * |a - x|))
          (fun x => by rw [Real.norm_eq_abs]; exact h_tail_dG a x)
          (by
            have h0 := (h_exp_abs_bot a).const_mul ((4 / 3) * B_d)
            rwa [mul_zero] at h0)
      have h_tsum_GR : Filter.Tendsto (fun x : ℝ => ∑' m : ℕ, greenIterKernel κ₀ w₀ (m + 1) a x)
          Filter.atTop (nhds 0) :=
        squeeze_zero_norm (a := fun x => (1 / 3) * Real.exp (-(κ₀ / 2) * |a - x|))
          (fun x => by rw [Real.norm_eq_abs]; exact h_tail_G a x)
          (by
            have h0 := (h_exp_abs_top a).const_mul (1 / 3)
            rwa [mul_zero] at h0)
      have h_tsum_dGR : Filter.Tendsto (fun x : ℝ => ∑' m : ℕ, greenIterDerivY κ₀ w₀ (m + 1) a x)
          Filter.atTop (nhds 0) :=
        squeeze_zero_norm (a := fun x => ((4 / 3) * B_d) * Real.exp (-(κ₀ / 2) * |a - x|))
          (fun x => by rw [Real.norm_eq_abs]; exact h_tail_dG a x)
          (by
            have h0 := (h_exp_abs_top a).const_mul ((4 / 3) * B_d)
            rwa [mul_zero] at h0)
      refine ⟨?_, ?_, ?_, ?_⟩
      · change Filter.Tendsto
            (fun x : ℝ => (1 / (2 * κ₀)) * Real.exp (-κ₀ * (a - x)) + ∑' m : ℕ, greenIterKernel κ₀ w₀ (m + 1) a x)
            Filter.atBot (nhds 0)
        have h0 := (h_exp_left κ₀ hκ₀_pos a).const_mul (1 / (2 * κ₀))
        rw [mul_zero] at h0
        have h_add := h0.add h_tsum_GL
        rwa [add_zero] at h_add
      · change Filter.Tendsto
            (fun x : ℝ => (1 / 2) * Real.exp (-κ₀ * (a - x)) + ∑' m : ℕ, greenIterDerivY κ₀ w₀ (m + 1) a x)
            Filter.atBot (nhds 0)
        have h0 := (h_exp_left κ₀ hκ₀_pos a).const_mul (1 / 2)
        rw [mul_zero] at h0
        have h_add := h0.add h_tsum_dGL
        rwa [add_zero] at h_add
      · change Filter.Tendsto
            (fun x : ℝ => (1 / (2 * κ₀)) * Real.exp (-κ₀ * (x - a)) + ∑' m : ℕ, greenIterKernel κ₀ w₀ (m + 1) a x)
            Filter.atTop (nhds 0)
        have h0 := (h_exp_right κ₀ hκ₀_pos a).const_mul (1 / (2 * κ₀))
        rw [mul_zero] at h0
        have h_add := h0.add h_tsum_GR
        rwa [add_zero] at h_add
      · change Filter.Tendsto
            (fun x : ℝ => -(1 / 2) * Real.exp (-κ₀ * (x - a)) + ∑' m : ℕ, greenIterDerivY κ₀ w₀ (m + 1) a x)
            Filter.atTop (nhds 0)
        have h0 := (h_exp_right κ₀ hκ₀_pos a).const_mul (-(1 / 2))
        rw [mul_zero] at h0
        have h_add := h0.add h_tsum_dGR
        rwa [add_zero] at h_add
    have hzs_ode₀ : hm1KappaSqT κ₀ (ιT w) ≤ δ_ode ^ 2 * κ₀ :=
      le_trans (hz_ball s) (mul_le_mul_of_nonneg_right h_sq_ode hκ₀_nn)
    have hzs_odeκ : hm1KappaSqT κ (ιT w) ≤ δ_ode ^ 2 * κ :=
      le_trans (h_hm1_mono κ₀ κ hκ₀ hκ_ge_κ₀ (ιT w)).2
        (le_trans hzs_ode₀ (mul_le_mul_of_nonneg_left hκ_ge_κ₀ (sq_nonneg δ_ode)))
    obtain ⟨hg₀_smooth, _, _, _⟩ := h_ode κ₀ hκ₀ w hzs_ode₀
    obtain ⟨hgκ_smooth, hgκ_per, hgκ_ode, _⟩ := h_ode κ hκ_ge1 w hzs_odeκ
    obtain ⟨hF_cont, h_flux_eq⟩ := h_flux_ident κ₀ κ hκ₀ hκ w
      h_G_symm (h_sub_lin s s).2.2.1 h_diag h_eq_LR h_jump_LR h_d1_LR h_d2_LR h_tend_LR
      hg₀_smooth hgκ_smooth hgκ_per hgκ_ode
    obtain ⟨hΨ_cont, h_lin⟩ := h_unif_lin κ₀ κ hκ₀ z hz h_sub_lin s
    refine ⟨hΨ_cont, hF_cont, fun ε hε => ?_⟩
    obtain ⟨η, hη, h_lin_ε⟩ := h_lin ε hε
    refine ⟨η, hη, fun τ hτ x => ?_⟩
    have h_step := h_lin_ε τ hτ x
    rwa [h_flux_eq x] at h_step
  exact h_hm2_bound
    (fun s x => recipGreenDiffT κ₀ (z s : ℝ → ℝ) x)
    (fun s x => deriv (recipGreenFluxT κ₀ κ (z s : ℝ → ℝ)) x)
    (fun s => (h_flux_and_deriv s).1)
    (fun s => (h_flux_and_deriv s).2.1)
    (fun s => (h_flux_and_deriv s).2.2)
    t M_flux hM_flux h_flux

theorem hm2NormSqT_deriv_le_hm1NormSqT_of_contDiff_periodic (J : ℝ → ℝ)
    (hJ_smooth : ContDiff ℝ (⊤ : ℕ∞) J) (hJ_per : Function.Periodic J 1) :
    hm2NormSqT (deriv J) ≤ hm1NormSqT J :=
by
  have hJ_cont : Continuous J := hJ_smooth.continuous
  have hJ_diff : Differentiable ℝ J := hJ_smooth.differentiable (by decide)
  have hdJ_cont : Continuous (deriv J) := hJ_smooth.continuous_deriv (by decide)
  have hJ_per01 : J 1 = J 0 := by simpa using hJ_per 0
  have h_alg0 : ∀ (a b : ℂ), b * a = a * b := fun a b => mul_comm b a
  have h_alg1 : ∀ (a b c d : ℂ), (a * b) * c + b * d = a * (b * c) + b * d :=
    fun _ _ _ _ => by ring
  have h_alg2 : ∀ (z I1 I2 : ℂ), -z * I1 + I2 = 0 → I2 = z * I1 :=
    fun _ _ _ h => by linear_combination h
  have h_fc_deriv : ∀ n : ℤ,
      fourierCircle (deriv J) n = (((2 * π * (n : ℝ) : ℝ) : ℂ) * I) * fourierCircle J n := by
    intro n
    set ξ : ℝ := 2 * π * (n : ℝ)
    let Φ : ℝ → ℂ := fun x => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (J x : ℂ)
    let f1 : ℝ → ℂ := fun x =>
      -((ξ : ℂ) * I) * (Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (J x : ℂ))
    let f2 : ℝ → ℂ := fun x =>
      Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((deriv J x : ℝ) : ℂ)
    have hΦ_d : ∀ x ∈ Set.uIcc (0 : ℝ) 1, HasDerivAt Φ (f1 x + f2 x) x := by
      intro x _
      dsimp [Φ, f1, f2]
      have h1 : HasDerivAt (fun y : ℝ => (y : ℂ)) 1 x := by
        simpa using (hasDerivAt_id x).ofReal_comp
      have h2 : HasDerivAt (fun y : ℝ => -((ξ : ℂ) * (y : ℂ)) * I) (-((ξ : ℂ) * I)) x := by
        have h_eq : (fun y : ℝ => -((ξ : ℂ) * (y : ℂ)) * I) = (fun y : ℝ => -((ξ : ℂ) * I) * (y : ℂ)) := by
          ext y; ring
        rw [h_eq]
        simpa using h1.const_mul (-((ξ : ℂ) * I))
      have h_exp_d : HasDerivAt (fun y : ℝ => Complex.exp (-((ξ : ℂ) * (y : ℂ)) * I))
          (-((ξ : ℂ) * I) * Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I)) x :=
        h2.cexp.congr_deriv (h_alg0 _ _)
      have hJ_d : HasDerivAt (fun y : ℝ => (J y : ℂ)) ((deriv J x : ℝ) : ℂ) x :=
        (hJ_diff.differentiableAt.hasDerivAt).ofReal_comp
      exact (h_exp_d.mul hJ_d).congr_deriv (h_alg1 _ _ _ _)
    have hf1_int : IntervalIntegrable f1 volume 0 1 := by
      have h_cont : Continuous f1 := by dsimp [f1]; fun_prop
      exact h_cont.intervalIntegrable 0 1
    have hf2_int : IntervalIntegrable f2 volume 0 1 := by
      have h_cont : Continuous f2 := by dsimp [f2]; fun_prop
      exact h_cont.intervalIntegrable 0 1
    have h_ftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hΦ_d (hf1_int.add hf2_int)
    have hΦ_bdry : Φ 1 - Φ 0 = 0 := by
      dsimp [Φ, ξ]
      have h_exp1 : -(((2 * π * (n : ℝ) : ℝ) : ℂ) * (1 : ℂ)) * I =
          ((-n : ℤ) : ℂ) * (2 * (π : ℂ) * I) := by
        push_cast; ring
      have h_exp0 : -(((2 * π * (n : ℝ) : ℝ) : ℂ) * (0 : ℂ)) * I = 0 := by
        push_cast; ring
      rw [h_exp1, Complex.exp_int_mul_two_pi_mul_I (-n), h_exp0, Complex.exp_zero,
        one_mul, one_mul, hJ_per01, sub_self]
    rw [hΦ_bdry, intervalIntegral.integral_add hf1_int hf2_int] at h_ftc
    have hf1_eq : (∫ x in (0 : ℝ)..1, f1 x) = -(((ξ : ℂ) * I)) * fourierCircle J n := by
      dsimp [f1, fourierCircle, ξ]
      rw [intervalIntegral.integral_const_mul]
    have hf2_eq : (∫ x in (0 : ℝ)..1, f2 x) = fourierCircle (deriv J) n := rfl
    rw [hf1_eq, hf2_eq] at h_ftc
    exact h_alg2 (((ξ : ℂ) * I)) (fourierCircle J n) (fourierCircle (deriv J) n) h_ftc
  have h_pw : ∀ n : ℤ,
      ‖fourierCircle (deriv J) n‖ ^ 2 / (4 + (2 * π * n) ^ 2) ^ 2 ≤
        ‖fourierCircle J n‖ ^ 2 / (4 + (2 * π * n) ^ 2) := by
    intro n
    set ξ : ℝ := 2 * π * (n : ℝ)
    have h_norm_sq : ‖fourierCircle (deriv J) n‖ ^ 2 = ξ ^ 2 * ‖fourierCircle J n‖ ^ 2 := by
      rw [h_fc_deriv n, norm_mul, norm_mul, Complex.norm_real, Complex.norm_I, mul_one,
        Real.norm_eq_abs, mul_pow, sq_abs]
    change ‖fourierCircle (deriv J) n‖ ^ 2 / (4 + ξ ^ 2) ^ 2 ≤
      ‖fourierCircle J n‖ ^ 2 / (4 + ξ ^ 2)
    rw [h_norm_sq]
    have h_num : ξ ^ 2 * ‖fourierCircle J n‖ ^ 2 ≤ (4 + ξ ^ 2) * ‖fourierCircle J n‖ ^ 2 := by
      refine mul_le_mul_of_nonneg_right ?_ (sq_nonneg _)
      linarith
    calc (ξ ^ 2 * ‖fourierCircle J n‖ ^ 2) / (4 + ξ ^ 2) ^ 2
      _ ≤ ((4 + ξ ^ 2) * ‖fourierCircle J n‖ ^ 2) / (4 + ξ ^ 2) ^ 2 :=
        div_le_div_of_nonneg_right h_num (by positivity)
      _ = ‖fourierCircle J n‖ ^ 2 / (4 + ξ ^ 2) := by
        have h_ne : 4 + ξ ^ 2 ≠ 0 := by positivity
        field_simp
  have h_sum_weight : Summable (fun n : ℤ => 1 / (4 + (2 * π * (n : ℝ)) ^ 2)) := by
    let g : ℤ → ℝ := fun n => 1 / (n : ℝ) ^ 2 + if n = 0 then (1 / 4 : ℝ) else 0
    have hg_sum : Summable g :=
      (Real.summable_one_div_int_pow.mpr (by norm_num : 1 < 2)).add
        (hasSum_ite_eq (0 : ℤ) (1 / 4 : ℝ)).summable
    refine Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_) hg_sum
    dsimp [g]
    by_cases hn : n = 0
    · subst hn; norm_num
    · rw [if_neg hn, add_zero]
      have hn_abs : (1 : ℝ) ≤ |(n : ℝ)| := by exact_mod_cast Int.one_le_abs hn
      have hn_sq : (1 : ℝ) ≤ (n : ℝ) ^ 2 := by nlinarith [hn_abs, sq_abs (n : ℝ)]
      have hn_pos : (0 : ℝ) < (n : ℝ) ^ 2 := by linarith
      have hpi : (2 : ℝ) ≤ π := Real.two_le_pi
      have h_pi_sq : (1 : ℝ) ≤ (2 * π) ^ 2 := by nlinarith
      have h_denom : (n : ℝ) ^ 2 ≤ 4 + (2 * π * (n : ℝ)) ^ 2 := by
        calc (n : ℝ) ^ 2 = 1 * (n : ℝ) ^ 2 := (one_mul _).symm
          _ ≤ (2 * π) ^ 2 * (n : ℝ) ^ 2 := by gcongr
          _ ≤ 4 + (2 * π * (n : ℝ)) ^ 2 := by
            linarith [show (2 * π) ^ 2 * (n : ℝ) ^ 2 = (2 * π * (n : ℝ)) ^ 2 by ring]
      exact one_div_le_one_div_of_le hn_pos h_denom
  have h_hm1_sum : Summable (fun n : ℤ => ‖fourierCircle J n‖ ^ 2 / (4 + (2 * π * n) ^ 2)) := by
    let C : ℝ := ∫ x in (0 : ℝ)..1, ‖J x‖
    refine Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_)
      (h_sum_weight.mul_left (C ^ 2))
    have h_fc_bound : ‖fourierCircle J n‖ ≤ C := by
      dsimp [fourierCircle, C]
      refine intervalIntegral.norm_integral_le_of_norm_le (by norm_num : (0 : ℝ) ≤ 1)
        ?h_bound (hJ_cont.norm.intervalIntegrable 0 1)
      filter_upwards with x _
      have h_exp : -(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I = ((-(2 * π * n * x) : ℝ) : ℂ) * I := by
        push_cast; ring
      rw [norm_mul, h_exp, Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real]
      exact le_rfl
    have h_sq : ‖fourierCircle J n‖ ^ 2 ≤ C ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) h_fc_bound 2
    have h_div := div_le_div_of_nonneg_right h_sq (by positivity : (0 : ℝ) ≤ 4 + (2 * π * n) ^ 2)
    have h_ring : C ^ 2 / (4 + (2 * π * n) ^ 2) = C ^ 2 * (1 / (4 + (2 * π * n) ^ 2)) := by ring
    linarith only [h_div, h_ring]
  have h_hm2_sum :
      Summable (fun n : ℤ => ‖fourierCircle (deriv J) n‖ ^ 2 / (4 + (2 * π * n) ^ 2) ^ 2) :=
    Summable.of_nonneg_of_le (fun n => by positivity) h_pw h_hm1_sum
  exact h_hm2_sum.tsum_le_tsum h_pw h_hm1_sum

theorem h1_hm1_mul_hm1NormSqT_le (u v : ℝ → ℝ)
    (hu_cont : Continuous u) (hu_per : Function.Periodic u 1)
    (hv_cont : Continuous v)
    (hu_h1 : Summable (fun n : ℤ => (4 + (2 * π * n) ^ 2) * ‖fourierCircle u n‖ ^ 2)) :
    hm1NormSqT (fun x => u x * v x) ≤ 2 * h1NormSqT u * hm1NormSqT v :=
by
  let W : ℤ → ℝ := fun k => 4 + (2 * π * (k : ℝ)) ^ 2
  let h0 : ℤ → ℝ := fun k => 1 / W k
  have hW_pos : ∀ k : ℤ, 0 < W k := fun k => by dsimp [W]; positivity
  have hW_nn : ∀ k : ℤ, 0 ≤ W k := fun k => le_of_lt (hW_pos k)
  have hh0_nn : ∀ k : ℤ, 0 ≤ h0 k := fun k => by dsimp [h0]; have := hW_pos k; positivity
  have h_zeta_shift : HasSum (fun n : ℕ => 1 / ((n + 1 : ℕ) : ℝ) ^ 2) (π ^ 2 / 6) := by
    have h1 := (hasSum_nat_add_iff' 1).mpr hasSum_zeta_two
    have h_range : (∑ i ∈ Finset.range 1, 1 / (i : ℝ) ^ 2) = 0 := by simp
    rw [h_range, sub_zero] at h1
    exact h1
  have h_zeta_sum : Summable (fun n : ℕ => 1 / ((n + 1 : ℕ) : ℝ) ^ 2) := h_zeta_shift.summable
  have h_zeta_tsum : (∑' n : ℕ, 1 / ((n + 1 : ℕ) : ℝ) ^ 2) = π ^ 2 / 6 := h_zeta_shift.tsum_eq
  have hh0_pos_le : ∀ n : ℕ,
      h0 ((n : ℤ) + 1) ≤ (1 / 36 : ℝ) * (1 / ((n + 1 : ℕ) : ℝ) ^ 2) := by
    intro n
    dsimp [h0, W]
    have h_cast : (((n : ℤ) + 1 : ℤ) : ℝ) = ((n + 1 : ℕ) : ℝ) := by push_cast; ring
    rw [h_cast]
    have hpi : (3 : ℝ) < π := Real.pi_gt_three
    have h_pi_sq : (36 : ℝ) ≤ (2 * π) ^ 2 := by nlinarith
    have h_denom : 36 * ((n + 1 : ℕ) : ℝ) ^ 2 ≤ 4 + (2 * π * ((n + 1 : ℕ) : ℝ)) ^ 2 := by
      calc 36 * ((n + 1 : ℕ) : ℝ) ^ 2
        _ ≤ (2 * π) ^ 2 * ((n + 1 : ℕ) : ℝ) ^ 2 := by gcongr
        _ = (2 * π * ((n + 1 : ℕ) : ℝ)) ^ 2 := by ring
