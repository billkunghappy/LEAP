  refine ⟨h_sum_l1, h_hasSum, ?_⟩
  intro κ hκ
  have hκ_pos : 0 < κ := by linarith
  refine ⟨?_, ?_⟩
  · refine Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_) h_sum_w0
    exact div_le_self (sq_nonneg _) (by nlinarith [sq_nonneg κ, sq_nonneg (2 * π * (n : ℝ))])
