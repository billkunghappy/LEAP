      cinfSeminormT m f ≤ B := by
    intro m f B hB
    unfold cinfSeminormT
    refine csSup_le ⟨|iteratedDeriv m f 0|, ⟨0, ⟨le_rfl, zero_le_one⟩, rfl⟩⟩ ?_
    rintro y ⟨x, hx, rfl⟩
    exact hB x hx
  have h_iter_add_nat : ∀ (f : ℝ → ℝ) (m k : ℕ),
      iteratedDeriv m (iteratedDeriv k f) = iteratedDeriv (m + k) f := by
    intro f m
    induction m with
    | zero =>
      intro k
      rw [iteratedDeriv_zero, Nat.zero_add]
    | succ m ih =>
      intro k
      rw [iteratedDeriv_succ, ih k, ← iteratedDeriv_succ, Nat.add_right_comm m 1 k]
  have hW_smooth : ∀ (q : CinfT) (k : ℕ), ContDiff ℝ (⊤ : ℕ∞) (iteratedDeriv k (q : ℝ → ℝ)) := by
    intro q k
    refine contDiff_of_differentiable_iteratedDeriv (fun m _ => ?_)
    rw [h_iter_add_nat (q : ℝ → ℝ) m k]
    exact q.2.1.differentiable_iteratedDeriv (m + k)
      (WithTop.coe_lt_coe.mpr (WithTop.coe_lt_top (m + k)))
  have hW_per : ∀ (q : CinfT) (k : ℕ), Function.Periodic (iteratedDeriv k (q : ℝ → ℝ)) 1 := by
    intro q k x
    have h_shift : (fun z : ℝ => (q : ℝ → ℝ) (z + 1)) = (q : ℝ → ℝ) := funext q.2.2
    calc iteratedDeriv k (q : ℝ → ℝ) (x + 1)
      _ = iteratedDeriv k (fun z : ℝ => (q : ℝ → ℝ) (z + 1)) x :=
        (congrFun (iteratedDeriv_comp_add_const k (q : ℝ → ℝ) 1) x).symm
      _ = iteratedDeriv k (q : ℝ → ℝ) x := by rw [h_shift]
  have h_iter_le : ∀ (q : CinfT) (k : ℕ) (x : ℝ),
      |iteratedDeriv k (q : ℝ → ℝ) x| ≤ cinfSeminormT k (q : ℝ → ℝ) := by
    intro q k x
    let y : ℝ := Int.fract x
    have hy_mem : y ∈ Set.Icc (0 : ℝ) 1 := ⟨Int.fract_nonneg x, le_of_lt (Int.fract_lt_one x)⟩
    have hx_eq : y + (⌊x⌋ : ℝ) * 1 = x := by
      dsimp [y]
      linarith [Int.self_sub_floor x]
    have h_per_x : iteratedDeriv k (q : ℝ → ℝ) x = iteratedDeriv k (q : ℝ → ℝ) y := by
      calc iteratedDeriv k (q : ℝ → ℝ) x
        _ = iteratedDeriv k (q : ℝ → ℝ) (y + (⌊x⌋ : ℝ) * 1) := by rw [hx_eq]
        _ = iteratedDeriv k (q : ℝ → ℝ) y := (hW_per q k).int_mul ⌊x⌋ y
    rw [h_per_x]
    unfold cinfSeminormT
    have h_cont : Continuous (fun z : ℝ => |iteratedDeriv k (q : ℝ → ℝ) z|) :=
      continuous_abs.comp ((hW_smooth q k).continuous)
    have h_bdd : BddAbove (Set.image (fun z : ℝ => |iteratedDeriv k (q : ℝ → ℝ) z|) (Set.Icc 0 1)) :=
      isCompact_Icc.bddAbove_image h_cont.continuousOn
    exact le_csSup h_bdd ⟨y, hy_mem, rfl⟩
  have h_cdAt : ∀ (q : CinfT) (n : ℕ) (x : ℝ), ContDiffAt ℝ n (q : ℝ → ℝ) x :=
    fun q n x => (q.2.1.of_le (WithTop.coe_le_coe.mpr le_top)).contDiffAt
  have h_iter_sub : ∀ (q₁ q₂ : CinfT) (n : ℕ) (x : ℝ),
      iteratedDeriv n (fun z : ℝ => (q₁ : ℝ → ℝ) z - (q₂ : ℝ → ℝ) z) x =
        iteratedDeriv n (q₁ : ℝ → ℝ) x - iteratedDeriv n (q₂ : ℝ → ℝ) x :=
    fun q₁ q₂ n x => iteratedDeriv_sub (h_cdAt q₁ n x) (h_cdAt q₂ n x)
  have h_uIcc_abs : ∀ (a τ : ℝ), τ ∈ Set.uIcc 0 a → |τ| ≤ |a| := by
    intro a τ hτ
    rcases Set.mem_uIcc.mp hτ with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · rw [abs_of_nonneg h1, abs_of_nonneg (le_trans h1 h2)]
      exact h2
    · rw [abs_of_nonpos h2, abs_of_nonpos (le_trans h1 h2)]
      exact neg_le_neg h1
  have h_uIcc_sub_abs : ∀ (a b c : ℝ), c ∈ Set.uIcc a b → |c - a| ≤ |b - a| := by
    intro a b c hc
    rcases Set.mem_uIcc.mp hc with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · rw [abs_of_nonneg (sub_nonneg.mpr h1), abs_of_nonneg (sub_nonneg.mpr (le_trans h1 h2))]
      linarith
    · rw [abs_of_nonpos (sub_nonpos.mpr h2), abs_of_nonpos (sub_nonpos.mpr (le_trans h1 h2))]
      linarith
  
  have reg_flow_moving_frame_and_pointwise_hasDerivAtT :
      ∀ (w : ℝ → CinfT), IsRegFlowSolutionT κ w →
