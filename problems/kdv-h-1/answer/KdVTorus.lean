  let E_w : CinfT → ℕ → ℤ → ℝ := fun w k n =>
    (1 / (2 * π)) * ∫ ξ : ℝ, A_w w k n ξ ^ 2 / (κ₀ ^ 2 + ξ ^ 2)
  let A_Δ : ℕ → ℤ → ℝ → ℝ := fun k n ξ =>
    Real.sqrt (κ₀ ^ 2 + (2 * π * n - ξ) ^ 2) *
      ‖iterFreqPacketT κ₀ (w₁ : ℝ → ℝ) k n ξ - iterFreqPacketT κ₀ (w₂ : ℝ → ℝ) k n ξ‖
  let D : ℕ → ℤ → ℝ := fun k n =>
    (1 / (2 * π)) * ∫ ξ : ℝ, A_Δ k n ξ ^ 2 / (κ₀ ^ 2 + ξ ^ 2)
  have hEw_nn : ∀ (w : CinfT) (k : ℕ) (n : ℤ), 0 ≤ E_w w k n := fun w k n =>
    mul_nonneg (by positivity)
      (integral_nonneg (fun ξ => div_nonneg (sq_nonneg _) (le_of_lt (h_denom_pos ξ))))
  have hD_nn : ∀ (k : ℕ) (n : ℤ), 0 ≤ D k n := fun k n =>
    mul_nonneg (by positivity)
      (integral_nonneg (fun ξ => div_nonneg (sq_nonneg _) (le_of_lt (h_denom_pos ξ))))
  have hAw_int : ∀ (w : CinfT) (k : ℕ) (n : ℤ),
      Integrable (fun ξ : ℝ => A_w w k n ξ ^ 2 / (κ₀ ^ 2 + ξ ^ 2)) volume := by
    intro w k n
    obtain ⟨h_cont_w, ⟨B, hB, hB_le⟩, _⟩ := h_pkt_single w k
    have h_cont : Continuous (fun ξ : ℝ => A_w w k n ξ ^ 2 / (κ₀ ^ 2 + ξ ^ 2)) :=
      ((h_cont_w n).pow 2).div (continuous_const.add (continuous_pow 2))
        (fun ξ => ne_of_gt (h_denom_pos ξ))
    refine (h_inv_int.const_mul (B ^ 2)).mono' h_cont.aestronglyMeasurable
      (Filter.Eventually.of_forall fun ξ => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (div_nonneg (sq_nonneg _) (le_of_lt (h_denom_pos ξ)))]
    have hA_le : A_w w k n ξ ≤ B := h_sqrt_le _ _ B (norm_nonneg _) (hB_le n ξ)
    have h_sq : A_w w k n ξ ^ 2 ≤ B ^ 2 :=
      pow_le_pow_left₀ (mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _)) hA_le 2
    calc A_w w k n ξ ^ 2 / (κ₀ ^ 2 + ξ ^ 2)
      _ ≤ B ^ 2 / (κ₀ ^ 2 + ξ ^ 2) := div_le_div_of_nonneg_right h_sq (le_of_lt (h_denom_pos ξ))
      _ = B ^ 2 * (1 / (κ₀ ^ 2 + ξ ^ 2)) := by ring
  have hAΔ_int : ∀ (k : ℕ) (n : ℤ),
      Integrable (fun ξ : ℝ => A_Δ k n ξ ^ 2 / (κ₀ ^ 2 + ξ ^ 2)) volume := by
    intro k n
    obtain ⟨h_cont_Δ, ⟨B, hB, hB_le⟩, _⟩ := h_pkt_diff k
    have h_cont : Continuous (fun ξ : ℝ => A_Δ k n ξ ^ 2 / (κ₀ ^ 2 + ξ ^ 2)) :=
      ((h_cont_Δ n).pow 2).div (continuous_const.add (continuous_pow 2))
