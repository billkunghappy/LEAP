        _ ≤ ‖iterWavePacket κ₀ w0 ℓ x (ξ - 2 * π * j)‖ * ‖fourierCircle w0 j‖ / 1 :=
          div_le_div_of_nonneg_left (by positivity) zero_lt_one (h_denom_ge1 _)
        _ = ‖iterWavePacket κ₀ w0 ℓ x (ξ - 2 * π * j)‖ * ‖fourierCircle w0 j‖ := div_one _
        _ ≤ K_ℓ * ‖fourierCircle w0 j‖ := h_num
    have hbound_sum : ∀ᵐ x : ℝ ∂μ_I, Summable (fun j : ℤ => bound j x) :=
      Filter.Eventually.of_forall fun _ => h_fc.1.mul_left K_ℓ
    have hbound_int : Integrable (fun x : ℝ => ∑' j : ℤ, bound j x) μ_I :=
      h_const_int (∑' j : ℤ, K_ℓ * ‖fourierCircle w0 j‖)
    have hF_hasSum : ∀ᵐ x : ℝ ∂μ_I, HasSum (fun j : ℤ => F j x) (f x) :=
      Filter.Eventually.of_forall fun x => (h_wp_step ℓ x ξ).mul_left _
    have h_int_hasSum :=
      hasSum_integral_of_dominated_convergence bound hF_meas hF_bound hbound_sum hbound_int hF_hasSum
    have h_lhs : (∫ x in (0 : ℝ)..1, f x) = ∫ x : ℝ, f x ∂μ_I :=
      intervalIntegral.integral_of_le zero_le_one
    have h_term : ∀ j : ℤ, (∫ x : ℝ, F j x ∂μ_I) =
        -((∫ x in (0 : ℝ)..1,
            Complex.exp (-(((2 * π * ((n - j : ℤ) : ℝ) - (ξ - 2 * π * j) : ℝ) : ℂ) * (x : ℂ)) * I) *
              iterWavePacket κ₀ w0 ℓ x (ξ - 2 * π * j)) *
            fourierCircle w0 j / ((κ₀ ^ 2 + (ξ - 2 * π * j) ^ 2 : ℝ) : ℂ)) := by
      intro j
      have h_int_eq : (∫ x : ℝ, F j x ∂μ_I) = ∫ x in (0 : ℝ)..1, F j x :=
        (intervalIntegral.integral_of_le zero_le_one).symm
      have h_phase : 2 * π * (n : ℝ) - ξ =
