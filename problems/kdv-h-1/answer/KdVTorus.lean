      tsum_nonneg (fun n => hβ_nn n ξ)
    have hV_le : ∀ ξ : ℝ, V ξ ≤ ∑' n : ℤ, c n := fun ξ =>
      (hβ_sum ξ).tsum_le_tsum (fun n => hβ_le_val n ξ) hc_sum
    have hα_cont : ∀ m : ℤ, Continuous (α m) := fun m =>
      ((hA_cont.comp (continuous_id.sub continuous_const)).pow 2).div
        (continuous_const.add ((continuous_id.sub continuous_const).pow 2))
        (fun ξ => ne_of_gt (h_denom_pos _))
    have hα_nn : ∀ (m : ℤ) (ξ : ℝ), 0 ≤ α m ξ := fun m ξ =>
      div_nonneg (sq_nonneg _) (le_of_lt (h_denom_pos _))
    have hα_le : ∀ (m : ℤ) (ξ : ℝ), α m ξ ≤ M_A ^ 2 * (1 / (κ ^ 2 + (ξ - 2 * π * m) ^ 2)) := by
      intro m ξ
      dsimp [α]
      have h_sq : A (ξ - 2 * π * m) ^ 2 ≤ M_A ^ 2 :=
        pow_le_pow_left₀ (hA_nn _) (hA_bound _) 2
      calc A (ξ - 2 * π * m) ^ 2 / (κ ^ 2 + (ξ - 2 * π * m) ^ 2)
        _ ≤ M_A ^ 2 / (κ ^ 2 + (ξ - 2 * π * m) ^ 2) :=
          div_le_div_of_nonneg_right h_sq (le_of_lt (h_denom_pos _))
        _ = M_A ^ 2 * (1 / (κ ^ 2 + (ξ - 2 * π * m) ^ 2)) := by ring
    have hα_sum : ∀ ξ : ℝ, Summable (fun m : ℤ => α m ξ) := fun ξ =>
      Summable.of_nonneg_of_le (fun m => hα_nn m ξ) (fun m => hα_le m ξ)
        ((h_bf.1 ξ).1.mul_left (M_A ^ 2))
    have hU_nn : ∀ ξ : ℝ, 0 ≤ U ξ := fun ξ => tsum_nonneg (fun m => hα_nn m ξ)
    have hU_le : ∀ ξ : ℝ, U ξ ≤ M_A ^ 2 * (41 / κ) := by
      intro ξ
