        _ ≤ ∑' m : ℤ, M_A ^ 2 * (1 / (κ ^ 2 + (ξ - 2 * π * m) ^ 2)) :=
          (hα_sum ξ).tsum_le_tsum (fun m => hα_le m ξ) ((h_bf.1 ξ).1.mul_left (M_A ^ 2))
        _ = M_A ^ 2 * ∑' m : ℤ, 1 / (κ ^ 2 + (ξ - 2 * π * m) ^ 2) := tsum_mul_left
        _ ≤ M_A ^ 2 * (41 / κ) := mul_le_mul_of_nonneg_left (h_bf.1 ξ).2 (sq_nonneg _)
    have hU_meas : Measurable U := by
      let α_nn : ℤ → ℝ → NNReal := fun m ξ => ⟨α m ξ, hα_nn m ξ⟩
      have hα_nn_meas : ∀ m : ℤ, Measurable (α_nn m) := fun m =>
        ((hα_cont m).subtype_mk (fun ξ => hα_nn m ξ)).measurable
      have h_eq : U = fun ξ : ℝ => ((∑' m : ℤ, α_nn m ξ : NNReal) : ℝ) := by
        ext ξ
        rw [NNReal.coe_tsum]
        rfl
      rw [h_eq]
      exact NNReal.continuous_coe.measurable.comp (Measurable.nnreal_tsum hα_nn_meas)
    have h_UV_int : Integrable (fun ξ : ℝ => U ξ * (V ξ / (κ ^ 2 + ξ ^ 2))) volume := by
      have h_meas : Measurable (fun ξ : ℝ => U ξ * (V ξ / (κ ^ 2 + ξ ^ 2))) :=
        hU_meas.mul (hV_cont.measurable.div (continuous_const.add (continuous_pow 2)).measurable)
      set C_UV := (M_A ^ 2 * (41 / κ)) * (∑' n : ℤ, c n)
      refine (h_inv_int.const_mul C_UV).mono' h_meas.aestronglyMeasurable
        (Filter.Eventually.of_forall fun ξ => ?_)
      have h_nn : 0 ≤ U ξ * (V ξ / (κ ^ 2 + ξ ^ 2)) :=
        mul_nonneg (hU_nn ξ) (div_nonneg (hV_nn ξ) (le_of_lt (h_denom_pos ξ)))
      rw [Real.norm_eq_abs, abs_of_nonneg h_nn]
      have h_prod : U ξ * V ξ ≤ C_UV :=
        mul_le_mul (hU_le ξ) (hV_le ξ) (hV_nn ξ) (by positivity)
      calc U ξ * (V ξ / (κ ^ 2 + ξ ^ 2))
        _ = (U ξ * V ξ) / (κ ^ 2 + ξ ^ 2) := by ring
        _ ≤ C_UV / (κ ^ 2 + ξ ^ 2) :=
          div_le_div_of_nonneg_right h_prod (le_of_lt (h_denom_pos ξ))
        _ = C_UV * (1 / (κ ^ 2 + ξ ^ 2)) := by ring
    let g : ℤ → ℝ → ℝ := fun m ξ => α m ξ * (V ξ / (κ ^ 2 + ξ ^ 2))
    have hg_cont : ∀ m : ℤ, Continuous (g m) := fun m =>
      (hα_cont m).mul (hV_cont.div (continuous_const.add (continuous_pow 2)) (fun ξ => ne_of_gt (h_denom_pos ξ)))
    have hg_nn : ∀ (m : ℤ) (ξ : ℝ), 0 ≤ g m ξ := fun m ξ =>
      mul_nonneg (hα_nn m ξ) (div_nonneg (hV_nn ξ) (le_of_lt (h_denom_pos ξ)))
    have hg_hasSum : ∀ ξ : ℝ, HasSum (fun m : ℤ => g m ξ) (U ξ * (V ξ / (κ ^ 2 + ξ ^ 2))) := fun ξ =>
      (hα_sum ξ).hasSum.mul_right (V ξ / (κ ^ 2 + ξ ^ 2))
    have hg_int_hasSum : HasSum (fun m : ℤ => ∫ ξ : ℝ, g m ξ) (∫ ξ : ℝ, U ξ * (V ξ / (κ ^ 2 + ξ ^ 2))) := by
      refine hasSum_integral_of_dominated_convergence g
        (fun m => (hg_cont m).aestronglyMeasurable)
        (fun m => Filter.Eventually.of_forall fun ξ => by
          rw [Real.norm_eq_abs, abs_of_nonneg (hg_nn m ξ)])
        (Filter.Eventually.of_forall fun ξ => (hg_hasSum ξ).summable)
        ?_
        (Filter.Eventually.of_forall hg_hasSum)
      have h_eq : (fun ξ : ℝ => ∑' m : ℤ, g m ξ) = (fun ξ : ℝ => U ξ * (V ξ / (κ ^ 2 + ξ ^ 2))) := by
        ext ξ; exact (hg_hasSum ξ).tsum_eq
      rw [h_eq]
      exact h_UV_int
    let h : ℤ → ℝ → ℝ := fun m η =>
      (A η ^ 2 / (κ ^ 2 + η ^ 2)) *
        ((1 / (κ ^ 2 + (η + 2 * π * m) ^ 2)) *
          (∑' n : ℤ, c n / (κ ^ 2 + (η + 2 * π * (m - n)) ^ 2)))
    have hg_shift : ∀ (m : ℤ) (η : ℝ), g m (η + 2 * π * m) = h m η := by
      intro m η
      dsimp [g, h, α, V, β]
      have h1 : (η + 2 * π * m) - 2 * π * m = η := by ring
      have h2 : ∀ n : ℤ, (η + 2 * π * m) - 2 * π * n = η + 2 * π * (m - n) := by
        intro n; ring
      rw [h1]
      simp_rw [h2]
      ring
    have h_int_g_eq_h : ∀ m : ℤ, (∫ ξ : ℝ, g m ξ) = ∫ η : ℝ, h m η := by
      intro m
      rw [← MeasureTheory.integral_add_right_eq_self (g m) (2 * π * m)]
      exact integral_congr_ae (Filter.Eventually.of_forall (hg_shift m))
    have hh_cont : ∀ m : ℤ, Continuous (h m) := by
      intro m
      have h_eq : h m = fun η : ℝ => g m (η + 2 * π * m) := by
        ext η; exact (hg_shift m η).symm
      rw [h_eq]
      exact (hg_cont m).comp (continuous_id.add continuous_const)
    have hh_nn : ∀ (m : ℤ) (η : ℝ), 0 ≤ h m η := by
      intro m η
      rw [← hg_shift m η]
      exact hg_nn m (η + 2 * π * m)
    have hh_sum : ∀ η : ℝ, Summable (fun m : ℤ => h m η) := fun η =>
      (h_bf.2 η c hc_nn hc_sum).1.mul_left (A η ^ 2 / (κ ^ 2 + η ^ 2))
    set K_c := (169 / κ) * ∑' n : ℤ, c n / (4 * κ ^ 2 + (2 * π * n) ^ 2)
    have hh_tsum_le : ∀ η : ℝ, (∑' m : ℤ, h m η) ≤ K_c * (A η ^ 2 / (κ ^ 2 + η ^ 2)) := by
      intro η
      dsimp [h]
      rw [tsum_mul_left, mul_comm K_c]
      exact mul_le_mul_of_nonneg_left (h_bf.2 η c hc_nn hc_sum).2
        (div_nonneg (sq_nonneg _) (le_of_lt (h_denom_pos η)))
    have hA_sq_int : Integrable (fun η : ℝ => A η ^ 2 / (κ ^ 2 + η ^ 2)) volume := by
      have h_cont : Continuous (fun η : ℝ => A η ^ 2 / (κ ^ 2 + η ^ 2)) :=
        (hA_cont.pow 2).div (continuous_const.add (continuous_pow 2)) (fun η => ne_of_gt (h_denom_pos η))
      refine (h_inv_int.const_mul (M_A ^ 2)).mono' h_cont.aestronglyMeasurable
        (Filter.Eventually.of_forall fun η => ?_)
      rw [Real.norm_eq_abs, abs_of_nonneg (div_nonneg (sq_nonneg _) (le_of_lt (h_denom_pos η)))]
      have h_sq : A η ^ 2 ≤ M_A ^ 2 := pow_le_pow_left₀ (hA_nn η) (hA_bound η) 2
      calc A η ^ 2 / (κ ^ 2 + η ^ 2)
        _ ≤ M_A ^ 2 / (κ ^ 2 + η ^ 2) := div_le_div_of_nonneg_right h_sq (le_of_lt (h_denom_pos η))
        _ = M_A ^ 2 * (1 / (κ ^ 2 + η ^ 2)) := by ring
    have hh_tsum_int : Integrable (fun η : ℝ => ∑' m : ℤ, h m η) volume := by
      let h_nn_fn : ℤ → ℝ → NNReal := fun m η => ⟨h m η, hh_nn m η⟩
      have hh_nn_meas : ∀ m : ℤ, Measurable (h_nn_fn m) := fun m =>
        ((hh_cont m).subtype_mk (fun η => hh_nn m η)).measurable
      have h_meas : Measurable (fun η : ℝ => ∑' m : ℤ, h m η) := by
        have h_eq : (fun η : ℝ => ∑' m : ℤ, h m η) =
            (fun η : ℝ => ((∑' m : ℤ, h_nn_fn m η : NNReal) : ℝ)) := by
          ext η
          rw [NNReal.coe_tsum]
          rfl
        rw [h_eq]
        exact NNReal.continuous_coe.measurable.comp (Measurable.nnreal_tsum hh_nn_meas)
      refine (hA_sq_int.const_mul K_c).mono' h_meas.aestronglyMeasurable
        (Filter.Eventually.of_forall fun η => ?_)
      rw [Real.norm_eq_abs, abs_of_nonneg (tsum_nonneg (fun m => hh_nn m η))]
      exact hh_tsum_le η
    have hh_int_hasSum : HasSum (fun m : ℤ => ∫ η : ℝ, h m η) (∫ η : ℝ, ∑' m : ℤ, h m η) :=
      hasSum_integral_of_dominated_convergence h
        (fun m => (hh_cont m).aestronglyMeasurable)
        (fun m => Filter.Eventually.of_forall fun η => by
          rw [Real.norm_eq_abs, abs_of_nonneg (hh_nn m η)])
        (Filter.Eventually.of_forall hh_sum)
        hh_tsum_int
        (Filter.Eventually.of_forall fun η => (hh_sum η).hasSum)
    have h_UV_eq_h_tsum :
        (∫ ξ : ℝ, U ξ * (V ξ / (κ ^ 2 + ξ ^ 2))) = ∫ η : ℝ, ∑' m : ℤ, h m η := by
      have hg_int_hasSum' : HasSum (fun m : ℤ => ∫ η : ℝ, h m η) (∫ ξ : ℝ, U ξ * (V ξ / (κ ^ 2 + ξ ^ 2))) := by
        simpa only [h_int_g_eq_h] using hg_int_hasSum
      exact hg_int_hasSum'.unique hh_int_hasSum
    refine ⟨fun ξ => ⟨hα_sum ξ, hβ_sum ξ⟩, h_UV_int, ?_⟩
    change (∫ ξ : ℝ, U ξ * (V ξ / (κ ^ 2 + ξ ^ 2))) ≤ K_c * (∫ η : ℝ, A η ^ 2 / (κ ^ 2 + η ^ 2))
    rw [h_UV_eq_h_tsum, ← integral_const_mul]
    exact integral_mono hh_tsum_int (hA_sq_int.const_mul K_c) hh_tsum_le
  
  obtain ⟨h_sum_UV1, h_int_UV1, h_bound_UV1⟩ :=
    h_op A₁ (M₁_ℓ + M₂_ℓ) c₁ hA₁_cont (add_nonneg hM₁_ℓ_nn hM₂_ℓ_nn) hA₁_nn hA₁_bound hc₁_nn hc₁_sum
  obtain ⟨h_sum_UV2, h_int_UV2, h_bound_UV2⟩ :=
    h_op A₂ M₂_ℓ c₂ hA₂_cont hM₂_ℓ_nn hA₂_nn hA₂_bound hc₂_nn hc₂_sum
  let F₁ : ℝ → ℝ := fun ξ =>
    (∑' m : ℤ, A₁ (ξ - 2 * π * m) ^ 2 / (κ ^ 2 + (ξ - 2 * π * m) ^ 2)) *
      ((∑' n : ℤ, c₁ n / (κ ^ 2 + (ξ - 2 * π * n) ^ 2)) / (κ ^ 2 + ξ ^ 2))
  let F₂ : ℝ → ℝ := fun ξ =>
    (∑' m : ℤ, A₂ (ξ - 2 * π * m) ^ 2 / (κ ^ 2 + (ξ - 2 * π * m) ^ 2)) *
      ((∑' n : ℤ, c₂ n / (κ ^ 2 + (ξ - 2 * π * n) ^ 2)) / (κ ^ 2 + ξ ^ 2))
  let A_succ : ℝ → ℝ := fun ξ =>
    ‖iterWavePacket κ (q₁ : ℝ → ℝ) (ℓ + 1) x ξ - iterWavePacket κ (q₂ : ℝ → ℝ) (ℓ + 1) x ξ‖
  have hA_succ_int : Integrable (fun ξ : ℝ => A_succ ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) volume := by
    have h_cont : Continuous (fun ξ : ℝ => A_succ ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) :=
      (((h_pkt1_succ.1.sub h_pkt2_succ.1).norm).pow 2).div
        (continuous_const.add (continuous_pow 2)) (fun ξ => ne_of_gt (h_denom_pos ξ))
    refine (h_inv_int.const_mul ((M₁_succ + M₂_succ) ^ 2)).mono' h_cont.aestronglyMeasurable
      (Filter.Eventually.of_forall fun ξ => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (div_nonneg (sq_nonneg _) (le_of_lt (h_denom_pos ξ)))]
    have h_bd : A_succ ξ ≤ M₁_succ + M₂_succ :=
      le_trans (norm_sub_le _ _) (add_le_add (hM₁_succ ξ) (hM₂_succ ξ))
    have h_sq : A_succ ξ ^ 2 ≤ (M₁_succ + M₂_succ) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) h_bd 2
    calc A_succ ξ ^ 2 / (κ ^ 2 + ξ ^ 2)
      _ ≤ (M₁_succ + M₂_succ) ^ 2 / (κ ^ 2 + ξ ^ 2) :=
        div_le_div_of_nonneg_right h_sq (le_of_lt (h_denom_pos ξ))
      _ = (M₁_succ + M₂_succ) ^ 2 * (1 / (κ ^ 2 + ξ ^ 2)) := by ring
  have h_pw_le : ∀ ξ : ℝ, A_succ ξ ^ 2 / (κ ^ 2 + ξ ^ 2) ≤ 2 * F₁ ξ + 2 * F₂ ξ := by
    intro ξ
    set S₁ := ∑' n : ℤ, A₁ (ξ - 2 * π * n) * b₁ n / (κ ^ 2 + (ξ - 2 * π * n) ^ 2)
    set S₂ := ∑' n : ℤ, A₂ (ξ - 2 * π * n) * b₂ n / (κ ^ 2 + (ξ - 2 * π * n) ^ 2)
    set U₁ := ∑' m : ℤ, A₁ (ξ - 2 * π * m) ^ 2 / (κ ^ 2 + (ξ - 2 * π * m) ^ 2)
    set V₁ := ∑' n : ℤ, c₁ n / (κ ^ 2 + (ξ - 2 * π * n) ^ 2)
    set U₂ := ∑' m : ℤ, A₂ (ξ - 2 * π * m) ^ 2 / (κ ^ 2 + (ξ - 2 * π * m) ^ 2)
    set V₂ := ∑' n : ℤ, c₂ n / (κ ^ 2 + (ξ - 2 * π * n) ^ 2)
    have h_cs1 : S₁ ^ 2 ≤ U₁ * V₁ :=
      h_cs (fun n => A₁ (ξ - 2 * π * n)) b₁ (fun n => κ ^ 2 + (ξ - 2 * π * n) ^ 2)
        (fun _ => hA₁_nn _) hb₁_nn (fun _ => h_denom_pos _) (h_sum_UV1 ξ).1 (h_sum_UV1 ξ).2
    have h_cs2 : S₂ ^ 2 ≤ U₂ * V₂ :=
      h_cs (fun n => A₂ (ξ - 2 * π * n)) b₂ (fun n => κ ^ 2 + (ξ - 2 * π * n) ^ 2)
        (fun _ => hA₂_nn _) hb₂_nn (fun _ => h_denom_pos _) (h_sum_UV2 ξ).1 (h_sum_UV2 ξ).2
    have h_sq_step : A_succ ξ ^ 2 ≤ (S₁ + S₂) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) (h_s2 ξ) 2
    have h_two_sq : (S₁ + S₂) ^ 2 ≤ 2 * S₁ ^ 2 + 2 * S₂ ^ 2 := by
      nlinarith [sq_nonneg (S₁ - S₂)]
    have h_num_le : A_succ ξ ^ 2 ≤ 2 * (U₁ * V₁) + 2 * (U₂ * V₂) := by
      linarith
    calc A_succ ξ ^ 2 / (κ ^ 2 + ξ ^ 2)
      _ ≤ (2 * (U₁ * V₁) + 2 * (U₂ * V₂)) / (κ ^ 2 + ξ ^ 2) :=
        div_le_div_of_nonneg_right h_num_le (le_of_lt (h_denom_pos ξ))
      _ = 2 * F₁ ξ + 2 * F₂ ξ := by
        dsimp [F₁, F₂]
        ring
  set K₁ := (169 / κ) * ∑' n : ℤ, c₁ n / (4 * κ ^ 2 + (2 * π * n) ^ 2)
  set K₂ := (169 / κ) * ∑' n : ℤ, c₂ n / (4 * κ ^ 2 + (2 * π * n) ^ 2)
  have h_int_le :
      (∫ ξ : ℝ, A_succ ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) ≤
        2 * (K₁ * (∫ η : ℝ, A₁ η ^ 2 / (κ ^ 2 + η ^ 2))) +
        2 * (K₂ * (∫ η : ℝ, A₂ η ^ 2 / (κ ^ 2 + η ^ 2))) := by
    have h_mono :
        (∫ ξ : ℝ, A_succ ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) ≤
