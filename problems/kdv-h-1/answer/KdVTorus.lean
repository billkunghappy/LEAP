          (∀ M : ℝ, κ₀ ≤ M → ∀ t : ℝ, alphaFunctionalT M (w t : ℝ → ℝ) = alphaFunctionalT M (w 0 : ℝ → ℝ)) :=
by
  obtain ⟨δ₁, c₁, c₂, _K_alpha, hδ₁, hc₁, hc₁₂, _hK_alpha, h_quad, _h_ratio, _h_interp⟩ :=
