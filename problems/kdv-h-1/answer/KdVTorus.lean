      have hs_ball : hm1KappaSqT κ (ιT (u s)) ≤ δ' ^ 2 * κ := h_ball s hs
      have hs_pt : hm1KappaSqT κ (ιT (u s)) ≤ δ_pt ^ 2 * κ :=
