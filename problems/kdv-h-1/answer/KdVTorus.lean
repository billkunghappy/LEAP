        (htΨ.const_mul (-(4 * κ ^ 5 / (κ ^ 2 - κ₀ ^ 2)))).add (htΦ.const_mul (4 * κ ^ 2))
    let f_reg : ℝ → ℝ := fun y => greenKernel κ₀ w0 x y * regFlowRHS κ w0 y * greenKernel κ₀ w0 y x
    have hRL_deriv : ∀ y ∈ Set.Iic x, HasDerivAt (R_κ G_L D_L) (f_reg y) y := by
