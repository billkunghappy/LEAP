        have h_sum_eq : ∑ i ∈ Finset.range (n + 1), C_term i * η₀ =
            (∑ i ∈ Finset.range (n + 1), C_term i) * η₀ := (Finset.sum_mul _ _ _).symm
        rw [h_sum_eq] at h_sum_bound
        have h_C_def : C * η₀ = η₀ + 6 * ((∑ i ∈ Finset.range (n + 1), C_term i) * η₀) := by
          dsimp [C]
          ring
        linarith
      exact le_trans h_total hCη₀_le
    let ψ : ℝ → ℝ := fun s' => iteratedDeriv n (u s' : ℝ → ℝ) x - (s' - s₀) * iteratedDeriv n (v₁ : ℝ → ℝ) x
    let ψ' : ℝ → ℝ := fun s' => iteratedDeriv n ((hu s').choose : ℝ → ℝ) x - iteratedDeriv n (v₁ : ℝ → ℝ) x
    have h_hasDeriv : ∀ s' ∈ Set.uIcc s₀ s, HasDerivWithinAt ψ (ψ' s') (Set.uIcc s₀ s) s' := by
      intro s' _
