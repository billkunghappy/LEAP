theorem laplace_cosine_kernel_integrals (κ : ℝ) (hκ : 1 ≤ κ) (b : ℝ) :
    (Integrable (fun s : ℝ => Real.exp (-2 * κ * |s|) * Real.cos (b * s)) volume ∧
     (∫ s : ℝ, Real.exp (-2 * κ * |s|) * Real.cos (b * s)) =
       4 * κ / (4 * κ ^ 2 + b ^ 2)) ∧
    (Integrable (fun s : ℝ => (|s| + 1 / κ) * Real.exp (-2 * κ * |s|) * Real.cos (b * s)) volume ∧
     (∫ s : ℝ, (|s| + 1 / κ) * Real.exp (-2 * κ * |s|) * Real.cos (b * s)) =
       2 * (12 * κ ^ 2 + b ^ 2) / (4 * κ ^ 2 + b ^ 2) ^ 2 ∧
     2 * (12 * κ ^ 2 + b ^ 2) / (4 * κ ^ 2 + b ^ 2) ^ 2 ≤ 8 / (4 * κ ^ 2 + b ^ 2)) :=
by
  have hκ_pos : 0 < κ := by linarith
  have laplace_cos_integral_Ioi :
      ∫ v in Set.Ioi 0, Real.exp (-(2 * κ) * v) * Real.cos (b * v) =
        2 * κ / (4 * κ ^ 2 + b ^ 2) := by
    have h_den : 0 < 4 * κ ^ 2 + b ^ 2 := by positivity
    let F : ℝ → ℝ := fun v =>
      Real.exp (-(2 * κ) * v) * (-2 * κ * Real.cos (b * v) + b * Real.sin (b * v)) / (4 * κ ^ 2 + b ^ 2)
    have hF_cont : ContinuousWithinAt F (Set.Ici 0) 0 := by
      dsimp [F]
      fun_prop
    have hF_deriv : ∀ v ∈ Set.Ioi (0 : ℝ), HasDerivAt F (Real.exp (-(2 * κ) * v) * Real.cos (b * v)) v := by
      intro v _
      dsimp [F]
      have hd_exp : HasDerivAt (fun x : ℝ => Real.exp (-(2 * κ) * x)) (Real.exp (-(2 * κ) * v) * (-(2 * κ))) v := by
        have h1 : HasDerivAt (fun x : ℝ => -(2 * κ) * x) (-(2 * κ)) v := by
          simpa using (hasDerivAt_id v).const_mul (-(2 * κ))
        exact h1.exp
      have hd_lin : HasDerivAt (fun x : ℝ => b * x) b v := by
        simpa using (hasDerivAt_id v).const_mul b
      have hd_cos : HasDerivAt (fun x : ℝ => Real.cos (b * x)) (-Real.sin (b * v) * b) v := hd_lin.cos
      have hd_sin : HasDerivAt (fun x : ℝ => Real.sin (b * x)) (Real.cos (b * v) * b) v := hd_lin.sin
      have hd_trig : HasDerivAt (fun x : ℝ => -2 * κ * Real.cos (b * x) + b * Real.sin (b * x))
          (-2 * κ * (-Real.sin (b * v) * b) + b * (Real.cos (b * v) * b)) v :=
        (hd_cos.const_mul (-2 * κ)).add (hd_sin.const_mul b)
      have hd_prod := (hd_exp.mul hd_trig).div_const (4 * κ ^ 2 + b ^ 2)
      convert hd_prod using 1
      field_simp
      ring
    have hf_int : IntegrableOn (fun v : ℝ => Real.exp (-(2 * κ) * v) * Real.cos (b * v)) (Set.Ioi 0) volume := by
      have h_cont : Continuous (fun v : ℝ => Real.exp (-(2 * κ) * v) * Real.cos (b * v)) := by fun_prop
      refine (exp_neg_integrableOn_Ioi 0 (by positivity : 0 < 2 * κ)).mono' h_cont.aestronglyMeasurable.restrict ?_
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with v _
      rw [norm_mul, Real.norm_of_nonneg (Real.exp_pos _).le, Real.norm_eq_abs]
      calc Real.exp (-(2 * κ) * v) * |Real.cos (b * v)|
        _ ≤ Real.exp (-(2 * κ) * v) * 1 :=
          mul_le_mul_of_nonneg_left (Real.abs_cos_le_one _) (Real.exp_pos _).le
        _ = Real.exp (-(2 * κ) * v) := mul_one _
    have hF_lim : Filter.Tendsto F Filter.atTop (nhds 0) := by
      let C : ℝ := (2 * κ + |b|) / (4 * κ ^ 2 + b ^ 2)
      apply squeeze_zero_norm (a := fun v => Real.exp (-(2 * κ) * v) * C)
      · intro v
        dsimp [F, C]
        rw [abs_div, abs_mul, abs_of_pos (Real.exp_pos _),
            abs_of_pos h_den, mul_div_assoc]
        gcongr
        calc |-2 * κ * Real.cos (b * v) + b * Real.sin (b * v)|
          _ ≤ |-2 * κ * Real.cos (b * v)| + |b * Real.sin (b * v)| := abs_add_le _ _
          _ = 2 * κ * |Real.cos (b * v)| + |b| * |Real.sin (b * v)| := by
              rw [abs_mul, abs_mul, abs_neg, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2),
                  abs_of_pos hκ_pos]
          _ ≤ 2 * κ * 1 + |b| * 1 := by
              gcongr
              · exact Real.abs_cos_le_one _
              · exact Real.abs_sin_le_one _
          _ = 2 * κ + |b| := by ring
      · rw [show (0 : ℝ) = 0 * C by ring]
        apply Filter.Tendsto.mul_const
        apply Real.tendsto_exp_atBot.comp
        have h_neg : Filter.Tendsto (fun x : ℝ => (2 * κ) * x) Filter.atTop Filter.atTop :=
          Filter.Tendsto.const_mul_atTop (by positivity) Filter.tendsto_id
        have h_eq : (fun x : ℝ => -(2 * κ) * x) = (fun x : ℝ => -((2 * κ) * x)) := by ext x; ring
        change Filter.Tendsto (fun x : ℝ => -(2 * κ) * x) Filter.atTop Filter.atBot
        rw [h_eq]
        exact Filter.tendsto_neg_atTop_atBot.comp h_neg
    have h_res := integral_Ioi_of_hasDerivAt_of_tendsto hF_cont hF_deriv hf_int hF_lim
    rw [h_res]
    dsimp [F]
    rw [mul_zero, mul_zero, Real.exp_zero, Real.cos_zero, Real.sin_zero]
    ring
  have laplace_linear_cos_integral_Ioi :
      ∫ v in Set.Ioi 0, (v + 1 / κ) * Real.exp (-(2 * κ) * v) * Real.cos (b * v) =
        (12 * κ ^ 2 + b ^ 2) / (4 * κ ^ 2 + b ^ 2) ^ 2 := by
    let D : ℝ := 4 * κ ^ 2 + b ^ 2
    have hD_pos : 0 < D := by dsimp [D]; positivity
    have hD_ne : D ≠ 0 := ne_of_gt hD_pos
    let P : ℝ → ℝ := fun v =>
      (κ * v + 1) * D * (-2 * κ * Real.cos (b * v) + b * Real.sin (b * v)) -
      κ * ((4 * κ ^ 2 - b ^ 2) * Real.cos (b * v) - 4 * κ * b * Real.sin (b * v))
    let F : ℝ → ℝ := fun v => Real.exp (-(2 * κ) * v) * P v / (κ * D ^ 2)
    have hF_cont : ContinuousWithinAt F (Set.Ici 0) 0 := by
      dsimp [F, P, D]
      fun_prop
    have hF_deriv : ∀ v ∈ Set.Ioi (0 : ℝ), HasDerivAt F ((v + 1 / κ) * Real.exp (-(2 * κ) * v) * Real.cos (b * v)) v := by
      intro v _
      dsimp [F]
      have hd_exp : HasDerivAt (fun x : ℝ => Real.exp (-(2 * κ) * x)) (Real.exp (-(2 * κ) * v) * (-(2 * κ))) v := by
        have h1 : HasDerivAt (fun x : ℝ => -(2 * κ) * x) (-(2 * κ)) v := by
          simpa using (hasDerivAt_id v).const_mul (-(2 * κ))
        exact h1.exp
      have hd_lin : HasDerivAt (fun x : ℝ => b * x) b v := by
        simpa using (hasDerivAt_id v).const_mul b
      have hd_cos : HasDerivAt (fun x : ℝ => Real.cos (b * x)) (-Real.sin (b * v) * b) v := hd_lin.cos
      have hd_sin : HasDerivAt (fun x : ℝ => Real.sin (b * x)) (Real.cos (b * v) * b) v := hd_lin.sin
      have hd_kv1 : HasDerivAt (fun x : ℝ => (κ * x + 1) * D) (κ * 1 * D) v := by
        have h1 : HasDerivAt (fun x : ℝ => κ * x + 1) (κ * 1) v :=
          ((hasDerivAt_id v).const_mul κ).add_const 1
        exact h1.mul_const D
      have hd_trig1 : HasDerivAt (fun x : ℝ => -2 * κ * Real.cos (b * x) + b * Real.sin (b * x))
          (-2 * κ * (-Real.sin (b * v) * b) + b * (Real.cos (b * v) * b)) v :=
        (hd_cos.const_mul (-2 * κ)).add (hd_sin.const_mul b)
      have hd_trig2 : HasDerivAt (fun x : ℝ => κ * ((4 * κ ^ 2 - b ^ 2) * Real.cos (b * x) - 4 * κ * b * Real.sin (b * x)))
          (κ * ((4 * κ ^ 2 - b ^ 2) * (-Real.sin (b * v) * b) - 4 * κ * b * (Real.cos (b * v) * b))) v :=
        ((hd_cos.const_mul (4 * κ ^ 2 - b ^ 2)).sub (hd_sin.const_mul (4 * κ * b))).const_mul κ
      have hd_P : HasDerivAt P
          (κ * 1 * D * (-2 * κ * Real.cos (b * v) + b * Real.sin (b * v)) +
           (κ * v + 1) * D * (-2 * κ * (-Real.sin (b * v) * b) + b * (Real.cos (b * v) * b)) -
           κ * ((4 * κ ^ 2 - b ^ 2) * (-Real.sin (b * v) * b) - 4 * κ * b * (Real.cos (b * v) * b))) v :=
        (hd_kv1.mul hd_trig1).sub hd_trig2
      have hd_prod := (hd_exp.mul hd_P).div_const (κ * D ^ 2)
      convert hd_prod using 1
      dsimp [P, D]
      field_simp
      ring
    have h_lin_exp_le : ∀ v : ℝ, 0 ≤ v → (v + 1 / κ) * Real.exp (-(2 * κ) * v) ≤ (1 / κ) * Real.exp (-κ * v) := by
      intro v hv
      have h1 : κ * v + 1 ≤ Real.exp (κ * v) := by
        linarith [Real.add_one_le_exp (κ * v)]
      have h2 : v + 1 / κ = (κ * v + 1) / κ := by field_simp
      rw [h2, div_mul_eq_mul_div, one_div_mul_eq_div]
      gcongr
      calc (κ * v + 1) * Real.exp (-(2 * κ) * v)
        _ ≤ Real.exp (κ * v) * Real.exp (-(2 * κ) * v) :=
            mul_le_mul_of_nonneg_right h1 (Real.exp_pos _).le
        _ = Real.exp (-κ * v) := by
            rw [← Real.exp_add]
            congr 1
            ring
    have hf_int : IntegrableOn (fun v : ℝ => (v + 1 / κ) * Real.exp (-(2 * κ) * v) * Real.cos (b * v)) (Set.Ioi 0) volume := by
      have h_cont : Continuous (fun v : ℝ => (v + 1 / κ) * Real.exp (-(2 * κ) * v) * Real.cos (b * v)) := by fun_prop
      refine ((exp_neg_integrableOn_Ioi 0 hκ_pos).const_mul (1 / κ)).mono' h_cont.aestronglyMeasurable.restrict ?_
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with v hv
      have hv_nn : 0 ≤ v := le_of_lt hv
      have hv_pos : 0 ≤ (v + 1 / κ) * Real.exp (-(2 * κ) * v) := by positivity
      rw [norm_mul, Real.norm_of_nonneg hv_pos, Real.norm_eq_abs]
      calc (v + 1 / κ) * Real.exp (-(2 * κ) * v) * |Real.cos (b * v)|
        _ ≤ (v + 1 / κ) * Real.exp (-(2 * κ) * v) * 1 :=
            mul_le_mul_of_nonneg_left (Real.abs_cos_le_one _) hv_pos
        _ = (v + 1 / κ) * Real.exp (-(2 * κ) * v) := mul_one _
        _ ≤ (1 / κ) * Real.exp (-κ * v) := h_lin_exp_le v hv_nn
    have hF_lim : Filter.Tendsto F Filter.atTop (nhds 0) := by
      let C_P : ℝ := D * (2 * κ + |b|) + κ * (D + 4 * κ * |b|)
      let C_F : ℝ := C_P / (κ * D ^ 2)
      apply squeeze_zero_norm' (a := fun v => Real.exp (-κ * v) * C_F)
      · filter_upwards [Filter.eventually_ge_atTop (0 : ℝ)] with v hv
        dsimp [F, C_F]
        rw [abs_div, abs_mul, abs_of_pos (Real.exp_pos _),
            abs_of_pos (by positivity : 0 < κ * D ^ 2), ← mul_div_assoc]
        have h_P_bound : |P v| ≤ Real.exp (κ * v) * C_P := by
          dsimp [P, C_P]
          have h_kv_nn : 0 ≤ κ * v + 1 := by positivity
          have h_kv_exp : κ * v + 1 ≤ Real.exp (κ * v) := by linarith [Real.add_one_le_exp (κ * v)]
          have h_exp_ge_one : 1 ≤ Real.exp (κ * v) := Real.one_le_exp (by positivity)
          have h_trig1 : |-2 * κ * Real.cos (b * v) + b * Real.sin (b * v)| ≤ 2 * κ + |b| := by
            calc |-2 * κ * Real.cos (b * v) + b * Real.sin (b * v)|
              _ ≤ |-2 * κ * Real.cos (b * v)| + |b * Real.sin (b * v)| := abs_add_le _ _
              _ = 2 * κ * |Real.cos (b * v)| + |b| * |Real.sin (b * v)| := by
                  rw [abs_mul, abs_mul, abs_neg, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2), abs_of_pos hκ_pos]
              _ ≤ 2 * κ * 1 + |b| * 1 := by
                  gcongr
                  · exact Real.abs_cos_le_one _
                  · exact Real.abs_sin_le_one _
              _ = 2 * κ + |b| := by ring
          have h_4k2_b2 : |4 * κ ^ 2 - b ^ 2| ≤ D := by
            dsimp [D]
            rw [abs_le]
            constructor <;> nlinarith [sq_nonneg κ, sq_nonneg b]
          have h_trig2 : |(4 * κ ^ 2 - b ^ 2) * Real.cos (b * v) - 4 * κ * b * Real.sin (b * v)| ≤ D + 4 * κ * |b| := by
            calc |(4 * κ ^ 2 - b ^ 2) * Real.cos (b * v) - 4 * κ * b * Real.sin (b * v)|
              _ ≤ |(4 * κ ^ 2 - b ^ 2) * Real.cos (b * v)| + |4 * κ * b * Real.sin (b * v)| := abs_sub _ _
              _ = |4 * κ ^ 2 - b ^ 2| * |Real.cos (b * v)| + 4 * κ * |b| * |Real.sin (b * v)| := by
                  rw [abs_mul, abs_mul, abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 4), abs_of_pos hκ_pos]
              _ ≤ D * 1 + 4 * κ * |b| * 1 := by
                  gcongr
                  · exact Real.abs_cos_le_one _
                  · exact Real.abs_sin_le_one _
              _ = D + 4 * κ * |b| := by ring
          calc |(κ * v + 1) * D * (-2 * κ * Real.cos (b * v) + b * Real.sin (b * v)) -
                κ * ((4 * κ ^ 2 - b ^ 2) * Real.cos (b * v) - 4 * κ * b * Real.sin (b * v))|
            _ ≤ |(κ * v + 1) * D * (-2 * κ * Real.cos (b * v) + b * Real.sin (b * v))| +
                |κ * ((4 * κ ^ 2 - b ^ 2) * Real.cos (b * v) - 4 * κ * b * Real.sin (b * v))| := abs_sub _ _
            _ = (κ * v + 1) * D * |-2 * κ * Real.cos (b * v) + b * Real.sin (b * v)| +
                κ * |(4 * κ ^ 2 - b ^ 2) * Real.cos (b * v) - 4 * κ * b * Real.sin (b * v)| := by
                rw [abs_mul, abs_mul, abs_of_nonneg h_kv_nn, abs_of_pos hD_pos, abs_mul, abs_of_pos hκ_pos]
            _ ≤ Real.exp (κ * v) * D * (2 * κ + |b|) + (Real.exp (κ * v) * κ) * (D + 4 * κ * |b|) := by
                gcongr
                exact le_mul_of_one_le_left (by positivity) h_exp_ge_one
            _ = Real.exp (κ * v) * (D * (2 * κ + |b|) + κ * (D + 4 * κ * |b|)) := by ring
        have h_num : Real.exp (-(2 * κ) * v) * |P v| ≤ Real.exp (-κ * v) * C_P :=
          calc Real.exp (-(2 * κ) * v) * |P v|
            _ ≤ Real.exp (-(2 * κ) * v) * (Real.exp (κ * v) * C_P) :=
                mul_le_mul_of_nonneg_left h_P_bound (Real.exp_pos _).le
            _ = (Real.exp (-(2 * κ) * v) * Real.exp (κ * v)) * C_P := by ring
            _ = Real.exp (-κ * v) * C_P := by
                rw [← Real.exp_add]
                congr 2
                ring
        exact div_le_div_of_nonneg_right h_num (by positivity)
      · rw [show (0 : ℝ) = 0 * C_F by ring]
        apply Filter.Tendsto.mul_const
        apply Real.tendsto_exp_atBot.comp
        have h_neg : Filter.Tendsto (fun x : ℝ => κ * x) Filter.atTop Filter.atTop :=
          Filter.Tendsto.const_mul_atTop hκ_pos Filter.tendsto_id
        have h_eq : (fun x : ℝ => -κ * x) = (fun x : ℝ => -(κ * x)) := by ext x; ring
        change Filter.Tendsto (fun x : ℝ => -κ * x) Filter.atTop Filter.atBot
        rw [h_eq]
        exact Filter.tendsto_neg_atTop_atBot.comp h_neg
    have h_res := integral_Ioi_of_hasDerivAt_of_tendsto hF_cont hF_deriv hf_int hF_lim
    rw [h_res]
    dsimp [F, P, D]
    simp only [mul_zero, zero_add, Real.exp_zero, Real.cos_zero, Real.sin_zero]
    field_simp
    ring
  refine ⟨?_, ?_⟩
  · let f_R : ℝ → ℝ := fun v => Real.exp (-2 * κ * |v|)
    have hf_R_Ici : IntegrableOn f_R (Set.Ici 0) volume := by
      have h_ioi := (exp_neg_integrableOn_Ioi (-1 : ℝ) (by positivity : 0 < 2 * κ)).mono_set
        (Set.Ici_subset_Ioi.mpr (by norm_num : (-1 : ℝ) < 0))
      refine h_ioi.congr_fun ?_ measurableSet_Ici
      intro v hv
      dsimp [f_R]
      have hv_nn : 0 ≤ v := hv
      rw [abs_of_nonneg hv_nn]
      have : -(2 * κ) * v = -2 * κ * v := by ring
      rw [this]
    have hf_R_Iic : IntegrableOn f_R (Set.Iic 0) volume := by
      have h_neg := hf_R_Ici.comp_neg
      rw [Set.neg_Ici, neg_zero] at h_neg
      refine h_neg.congr_fun ?_ measurableSet_Iic
      intro v _
      dsimp [f_R]
      rw [abs_neg]
    have hf_R_int : Integrable f_R volume := by
      rw [← integrableOn_univ, ← Set.Iic_union_Ioi (a := (0 : ℝ))]
      exact hf_R_Iic.union (hf_R_Ici.mono_set Set.Ioi_subset_Ici_self)
    let g_cos : ℝ → ℝ := fun v => f_R v * Real.cos (b * v)
    have hg_cos_int : Integrable g_cos volume := by
      have h_cont : Continuous g_cos := by dsimp [g_cos, f_R]; fun_prop
      refine hf_R_int.mono' h_cont.aestronglyMeasurable ?_
      filter_upwards with v
      dsimp [g_cos]
      rw [abs_mul, abs_of_pos (by dsimp [f_R]; positivity)]
      calc f_R v * |Real.cos (b * v)| ≤ f_R v * 1 :=
        mul_le_mul_of_nonneg_left (Real.abs_cos_le_one _) (by dsimp [f_R]; positivity)
      _ = f_R v := mul_one _
    have h_cos_val : ∫ v : ℝ, g_cos v = 4 * κ / (4 * κ ^ 2 + b ^ 2) := by
      have h_even : ∀ v : ℝ, g_cos (-v) = g_cos v := by
        intro v
        dsimp [g_cos, f_R]
        rw [abs_neg, mul_neg, Real.cos_neg]
      have h_split0 : ∫ v : ℝ, g_cos v = (∫ v in Set.Iic 0, g_cos v) + (∫ v in Set.Ioi 0, g_cos v) :=
        (intervalIntegral.integral_Iic_add_Ioi hg_cos_int.integrableOn hg_cos_int.integrableOn).symm
      have h_iic_eq_ioi : (∫ v in Set.Iic 0, g_cos v) = ∫ v in Set.Ioi 0, g_cos v := by
        have h_neg := integral_comp_neg_Iic (0 : ℝ) g_cos
        rw [neg_zero] at h_neg
        rw [← h_neg]
        congr 1 with v
        exact (h_even v).symm
      have h_ioi_eq : (∫ v in Set.Ioi 0, g_cos v) =
          ∫ v in Set.Ioi 0, Real.exp (-(2 * κ) * v) * Real.cos (b * v) := by
        refine setIntegral_congr_fun measurableSet_Ioi ?_
        intro v hv
        dsimp [g_cos, f_R]
        have hv_pos : 0 < v := hv
        rw [abs_of_pos hv_pos]
        have : -2 * κ * v = -(2 * κ) * v := by ring
        rw [this]
      rw [h_split0, h_iic_eq_ioi, h_ioi_eq, laplace_cos_integral_Ioi]
      ring
    exact ⟨hg_cos_int, h_cos_val⟩
  · let f_R : ℝ → ℝ := fun v => (|v| + 1 / κ) * Real.exp (-2 * κ * |v|)
    have hf_R_le : ∀ v : ℝ, f_R v ≤ (1 / κ) * Real.exp (-κ * |v|) := by
      intro v
      dsimp [f_R]
      have h1 : κ * |v| + 1 ≤ Real.exp (κ * |v|) := by
        linarith [Real.add_one_le_exp (κ * |v|)]
      have h2 : |v| + 1 / κ = (κ * |v| + 1) / κ := by field_simp
      rw [h2, div_mul_eq_mul_div, one_div_mul_eq_div]
      gcongr
      calc (κ * |v| + 1) * Real.exp (-2 * κ * |v|)
        _ ≤ Real.exp (κ * |v|) * Real.exp (-2 * κ * |v|) :=
            mul_le_mul_of_nonneg_right h1 (Real.exp_pos _).le
        _ = Real.exp (-κ * |v|) := by
            rw [← Real.exp_add]
            congr 1
            ring
    have h_exp_Ici : IntegrableOn (fun v : ℝ => Real.exp (-κ * |v|)) (Set.Ici 0) volume := by
      have h_ioi := (exp_neg_integrableOn_Ioi (-1 : ℝ) hκ_pos).mono_set
        (Set.Ici_subset_Ioi.mpr (by norm_num : (-1 : ℝ) < 0))
      refine h_ioi.congr_fun ?_ measurableSet_Ici
      intro v hv
      dsimp
      have hv_nn : 0 ≤ v := hv
      rw [abs_of_nonneg hv_nn]
    have h_exp_Iic : IntegrableOn (fun v : ℝ => Real.exp (-κ * |v|)) (Set.Iic 0) volume := by
      have h_neg := h_exp_Ici.comp_neg
      rw [Set.neg_Ici, neg_zero] at h_neg
      refine h_neg.congr_fun ?_ measurableSet_Iic
      intro v _
      dsimp
      rw [abs_neg]
    have h_exp_int : Integrable (fun v : ℝ => Real.exp (-κ * |v|)) volume := by
      rw [← integrableOn_univ, ← Set.Iic_union_Ioi (a := (0 : ℝ))]
      exact h_exp_Iic.union (h_exp_Ici.mono_set Set.Ioi_subset_Ici_self)
    have hf_R_cont : Continuous f_R := by dsimp [f_R]; fun_prop
    have hf_R_int : Integrable f_R volume := by
      refine (h_exp_int.const_mul (1 / κ)).mono' hf_R_cont.aestronglyMeasurable ?_
      filter_upwards with v
      rw [Real.norm_of_nonneg (by dsimp [f_R]; positivity)]
      exact hf_R_le v
    let g_cos : ℝ → ℝ := fun v => f_R v * Real.cos (b * v)
    have hg_cos_int : Integrable g_cos volume := by
      have h_cont : Continuous g_cos := by dsimp [g_cos, f_R]; fun_prop
      refine hf_R_int.mono' h_cont.aestronglyMeasurable ?_
      filter_upwards with v
      dsimp [g_cos]
      rw [abs_mul, abs_of_pos (by dsimp [f_R]; positivity)]
      calc f_R v * |Real.cos (b * v)| ≤ f_R v * 1 :=
        mul_le_mul_of_nonneg_left (Real.abs_cos_le_one _) (by dsimp [f_R]; positivity)
      _ = f_R v := mul_one _
    have h_cos_val : ∫ v : ℝ, g_cos v = 2 * (12 * κ ^ 2 + b ^ 2) / (4 * κ ^ 2 + b ^ 2) ^ 2 := by
      have h_even : ∀ v : ℝ, g_cos (-v) = g_cos v := by
        intro v
        dsimp [g_cos, f_R]
        rw [abs_neg, mul_neg, Real.cos_neg]
      have h_split0 : ∫ v : ℝ, g_cos v = (∫ v in Set.Iic 0, g_cos v) + (∫ v in Set.Ioi 0, g_cos v) :=
        (intervalIntegral.integral_Iic_add_Ioi hg_cos_int.integrableOn hg_cos_int.integrableOn).symm
      have h_iic_eq_ioi : (∫ v in Set.Iic 0, g_cos v) = ∫ v in Set.Ioi 0, g_cos v := by
        have h_neg := integral_comp_neg_Iic (0 : ℝ) g_cos
        rw [neg_zero] at h_neg
        rw [← h_neg]
        congr 1 with v
        exact (h_even v).symm
      have h_ioi_eq : (∫ v in Set.Ioi 0, g_cos v) =
          ∫ v in Set.Ioi 0, (v + 1 / κ) * Real.exp (-(2 * κ) * v) * Real.cos (b * v) := by
        refine setIntegral_congr_fun measurableSet_Ioi ?_
        intro v hv
        dsimp [g_cos, f_R]
        have hv_pos : 0 < v := hv
        rw [abs_of_pos hv_pos]
        have : -2 * κ * v = -(2 * κ) * v := by ring
        rw [this]
      rw [h_split0, h_iic_eq_ioi, h_ioi_eq, laplace_linear_cos_integral_Ioi]
      ring
    have h_bound : 2 * (12 * κ ^ 2 + b ^ 2) / (4 * κ ^ 2 + b ^ 2) ^ 2 ≤ 8 / (4 * κ ^ 2 + b ^ 2) := by
      have h_num : 2 * (12 * κ ^ 2 + b ^ 2) ≤ 8 * (4 * κ ^ 2 + b ^ 2) := by
        nlinarith [sq_nonneg κ, sq_nonneg b]
      calc 2 * (12 * κ ^ 2 + b ^ 2) / (4 * κ ^ 2 + b ^ 2) ^ 2
        _ ≤ 8 * (4 * κ ^ 2 + b ^ 2) / (4 * κ ^ 2 + b ^ 2) ^ 2 := by gcongr
        _ = 8 / (4 * κ ^ 2 + b ^ 2) := by
            have : 4 * κ ^ 2 + b ^ 2 ≠ 0 := by positivity
            field_simp
    exact ⟨hg_cos_int, h_cos_val, h_bound⟩

theorem alphaQuadFunctionalT_and_greenIterTwo_integral (κ : ℝ) (hκ : 1 ≤ κ) (w : CinfT) :
    κ * alphaQuadFunctionalT κ (w : ℝ → ℝ) = (1 / 2) * hm1KappaSqT κ (ιT w) ∧
    (∫ x in (0 : ℝ)..1, greenIterKernel κ (w : ℝ → ℝ) 2 x x) ≤
      (1 / κ ^ 3) * hm1KappaSqT κ (ιT w) :=
by
  have hκ_pos : 0 < κ := by linarith
  have hκ_ne : κ ≠ 0 := ne_of_gt hκ_pos
  obtain ⟨h_sum_fc, h_hm1_eq, h_autocorr⟩ :=
    hm1KappaSqT_and_autocorrelation_fourierCircle κ hκ w
  obtain ⟨h_quad_int, h_g2_int⟩ :=
    alphaQuadDensity_and_greenIterTwo_autocorrelation_integral κ hκ w
      (exp_three_point_kernel_integrals κ hκ)
  set a : ℤ → ℝ := fun n => ‖fourierCircle (w : ℝ → ℝ) n‖ ^ 2
  have ha_nn : ∀ n : ℤ, 0 ≤ a n := fun n => by positivity
  have h_sum_a : Summable a := h_sum_fc
  have h_lap0 := laplace_cosine_kernel_integrals κ hκ 0
  have h_dom1_int : Integrable (fun s : ℝ => Real.exp (-2 * κ * |s|)) volume := by
    simpa [zero_mul, Real.cos_zero, mul_one] using h_lap0.1.1
  have h_dom2_int : Integrable (fun s : ℝ => (|s| + 1 / κ) * Real.exp (-2 * κ * |s|)) volume := by
    simpa [zero_mul, Real.cos_zero, mul_one] using h_lap0.2.1
  set I₁ : ℝ := ∫ s : ℝ, Real.exp (-2 * κ * |s|)
  set I₂ : ℝ := ∫ s : ℝ, (|s| + 1 / κ) * Real.exp (-2 * κ * |s|)
  refine ⟨?_, ?_⟩
  · let F₁ : ℤ → ℝ → ℝ := fun n s =>
      a n * (Real.exp (-2 * κ * |s|) * Real.cos (2 * π * n * s))
    have hF₁_int : ∀ n : ℤ, Integrable (F₁ n) volume := fun n =>
      (laplace_cosine_kernel_integrals κ hκ (2 * π * n)).1.1.const_mul (a n)
    have hF₁_val : ∀ n : ℤ,
        (∫ s : ℝ, F₁ n s) = (4 * κ) * (a n / (4 * κ ^ 2 + (2 * π * n) ^ 2)) := by
      intro n
      dsimp [F₁]
      rw [integral_const_mul, (laplace_cosine_kernel_integrals κ hκ (2 * π * n)).1.2]
      ring
    have hF₁_norm_sum : Summable (fun n : ℤ => ∫ s : ℝ, ‖F₁ n s‖) := by
      refine Summable.of_nonneg_of_le
        (fun n => integral_nonneg (fun s => norm_nonneg _)) (fun n => ?_)
        (h_sum_a.mul_right I₁)
      have h_le : ∀ s : ℝ, ‖F₁ n s‖ ≤ a n * Real.exp (-2 * κ * |s|) := by
        intro s
        dsimp [F₁]
        rw [abs_mul, abs_mul, abs_of_nonneg (ha_nn n),
            abs_of_pos (Real.exp_pos _)]
        exact mul_le_mul_of_nonneg_left
          (mul_le_of_le_one_right (Real.exp_pos _).le (Real.abs_cos_le_one _)) (ha_nn n)
      calc (∫ s : ℝ, ‖F₁ n s‖)
        _ ≤ ∫ s : ℝ, a n * Real.exp (-2 * κ * |s|) :=
          integral_mono (hF₁_int n).norm (h_dom1_int.const_mul (a n)) h_le
        _ = a n * I₁ := by
          dsimp [I₁]
          exact integral_const_mul (a n) _
    have h_tsum_F₁ : ∀ s : ℝ,
        Real.exp (-2 * κ * |s|) * (∫ x in (0 : ℝ)..1, (w : ℝ → ℝ) (x + s) * (w : ℝ → ℝ) x) =
          ∑' n : ℤ, F₁ n s := by
      intro s
      rw [h_autocorr s, ← tsum_mul_left]
      congr 1 with n
      dsimp [F₁, a]
      ring
    rw [h_quad_int, funext h_tsum_F₁,
        ← integral_tsum_of_summable_integral_norm hF₁_int hF₁_norm_sum]
    have h_fn1 : (fun n : ℤ => ∫ s : ℝ, F₁ n s) =
        (fun n : ℤ => (4 * κ) * (a n / (4 * κ ^ 2 + (2 * π * n) ^ 2))) :=
      funext hF₁_val
    rw [h_fn1, tsum_mul_left, ← h_hm1_eq]
    field_simp
    ring
  · let F₂ : ℤ → ℝ → ℝ := fun n s =>
      a n * (((|s| + 1 / κ) * Real.exp (-2 * κ * |s|)) * Real.cos (2 * π * n * s))
    have hF₂_int : ∀ n : ℤ, Integrable (F₂ n) volume := fun n =>
      (laplace_cosine_kernel_integrals κ hκ (2 * π * n)).2.1.const_mul (a n)
    have hF₂_le : ∀ n : ℤ,
        (∫ s : ℝ, F₂ n s) ≤ 8 * (a n / (4 * κ ^ 2 + (2 * π * n) ^ 2)) := by
      intro n
      dsimp [F₂]
      rw [integral_const_mul, (laplace_cosine_kernel_integrals κ hκ (2 * π * n)).2.2.1]
      have h_b := (laplace_cosine_kernel_integrals κ hκ (2 * π * n)).2.2.2
      have h1 : a n * (2 * (12 * κ ^ 2 + (2 * π * n) ^ 2) / (4 * κ ^ 2 + (2 * π * n) ^ 2) ^ 2) ≤
          a n * (8 / (4 * κ ^ 2 + (2 * π * n) ^ 2)) :=
        mul_le_mul_of_nonneg_left h_b (ha_nn n)
      linarith [(by ring : a n * (8 / (4 * κ ^ 2 + (2 * π * n) ^ 2)) =
        8 * (a n / (4 * κ ^ 2 + (2 * π * n) ^ 2)))]
    have hF₂_norm_sum : Summable (fun n : ℤ => ∫ s : ℝ, ‖F₂ n s‖) := by
      refine Summable.of_nonneg_of_le
        (fun n => integral_nonneg (fun s => norm_nonneg _)) (fun n => ?_)
        (h_sum_a.mul_right I₂)
      have h_le : ∀ s : ℝ, ‖F₂ n s‖ ≤ a n * ((|s| + 1 / κ) * Real.exp (-2 * κ * |s|)) := by
        intro s
        dsimp [F₂]
        have hs_nn : 0 ≤ (|s| + 1 / κ) * Real.exp (-2 * κ * |s|) := by positivity
        rw [abs_mul, abs_mul, abs_of_nonneg (ha_nn n),
            abs_of_nonneg hs_nn]
        exact mul_le_mul_of_nonneg_left
          (mul_le_of_le_one_right hs_nn (Real.abs_cos_le_one _)) (ha_nn n)
      calc (∫ s : ℝ, ‖F₂ n s‖)
        _ ≤ ∫ s : ℝ, a n * ((|s| + 1 / κ) * Real.exp (-2 * κ * |s|)) :=
          integral_mono (hF₂_int n).norm (h_dom2_int.const_mul (a n)) h_le
        _ = a n * I₂ := by
          dsimp [I₂]
          exact integral_const_mul (a n) _
    have hF₂_val_sum : Summable (fun n : ℤ => ∫ s : ℝ, F₂ n s) := by
      refine hF₂_norm_sum.of_norm_bounded ?_
      intro n
      exact norm_integral_le_integral_norm (F₂ n)
    have h_rhs_sum : Summable (fun n : ℤ => 8 * (a n / (4 * κ ^ 2 + (2 * π * n) ^ 2))) := by
      refine (Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_) h_sum_a).mul_left 8
      have h_den : 1 ≤ 4 * κ ^ 2 + (2 * π * n) ^ 2 := by nlinarith [sq_nonneg (2 * π * (n : ℝ))]
      exact div_le_self (ha_nn n) h_den
    have h_tsum_F₂ : ∀ s : ℝ,
        ((|s| + 1 / κ) * Real.exp (-2 * κ * |s|)) *
          (∫ x in (0 : ℝ)..1, (w : ℝ → ℝ) (x + s) * (w : ℝ → ℝ) x) =
          ∑' n : ℤ, F₂ n s := by
      intro s
      rw [h_autocorr s, ← tsum_mul_left]
      congr 1 with n
      dsimp [F₂, a]
      ring
    rw [h_g2_int, funext h_tsum_F₂,
        ← integral_tsum_of_summable_integral_norm hF₂_int hF₂_norm_sum]
    have h_tsum_le : (∑' n : ℤ, ∫ s : ℝ, F₂ n s) ≤
        ∑' n : ℤ, 8 * (a n / (4 * κ ^ 2 + (2 * π * n) ^ 2)) :=
      hF₂_val_sum.tsum_le_tsum hF₂_le h_rhs_sum
    have h_mult_le :
        (1 / (8 * κ ^ 3)) * (∑' n : ℤ, ∫ s : ℝ, F₂ n s) ≤
        (1 / (8 * κ ^ 3)) * (∑' n : ℤ, 8 * (a n / (4 * κ ^ 2 + (2 * π * n) ^ 2))) :=
      mul_le_mul_of_nonneg_left h_tsum_le (by positivity)
    have h_rhs_eq :
        (1 / (8 * κ ^ 3)) * (∑' n : ℤ, 8 * (a n / (4 * κ ^ 2 + (2 * π * n) ^ 2))) =
        (1 / κ ^ 3) * hm1KappaSqT κ (ιT w) := by
      rw [tsum_mul_left, ← h_hm1_eq]
      field_simp
    linarith

theorem cinfT_fourierCircle_summable_and_hasSum (w : CinfT) :
    Summable (fun n : ℤ => ‖fourierCircle (w : ℝ → ℝ) n‖) ∧
    (∀ z : ℝ,
      HasSum (fun n : ℤ =>
        fourierCircle (w : ℝ → ℝ) n *
          Complex.exp (((2 * π * n : ℝ) : ℂ) * (z : ℂ) * I))
        ((w : ℝ → ℝ) z : ℂ)) ∧
    (∀ κ : ℝ, 1 ≤ κ →
      Summable (fun n : ℤ => ‖fourierCircle (w : ℝ → ℝ) n‖ ^ 2 / (4 * κ ^ 2 + (2 * π * n) ^ 2)) ∧
      hm1KappaSqT κ (ιT w) =
        ∑' n : ℤ, ‖fourierCircle (w : ℝ → ℝ) n‖ ^ 2 / (4 * κ ^ 2 + (2 * π * n) ^ 2)) :=
by
  have h_fc_eq : ∀ (g : ℝ → ℝ) (n : ℤ),
      fourierCoeffOn zero_lt_one (fun x : ℝ => (g x : ℂ)) n = fourierCircle g n := by
    intro g n
    rw [fourierCoeffOn_eq_integral (fun x : ℝ => (g x : ℂ)) n zero_lt_one]
    have h_sub : (1 : ℝ) / (1 - 0) = 1 := by norm_num
    rw [h_sub, one_smul, fourierCircle]
    congr 1 with x
    rw [fourier_coe_apply, smul_eq_mul]
    congr 1
    congr 1
    push_cast
    ring
  have h_parseval : ∀ (g : ℝ → ℝ), Continuous g →
      Summable (fun n : ℤ => ‖fourierCircle g n‖ ^ 2) := by
    intro g hg
    let g_C : ℝ → ℂ := fun x => (g x : ℂ)
    have hg_C : Continuous g_C := Complex.continuous_ofReal.comp hg
    have h_meas : AEStronglyMeasurable g_C (volume.restrict (Set.Ioc (0 : ℝ) 1)) :=
      hg_C.aestronglyMeasurable
    have h_int_sq : Integrable (fun x => ‖g_C x‖ ^ 2) (volume.restrict (Set.Ioc (0 : ℝ) 1)) :=
      (intervalIntegrable_iff_integrableOn_Ioc_of_le zero_le_one).mp
        ((hg_C.norm.pow 2).intervalIntegrable 0 1)
    have h_memLp : MemLp g_C 2 (volume.restrict (Set.Ioc (0 : ℝ) 1)) :=
      (MeasureTheory.memLp_two_iff_integrable_sq_norm h_meas).mpr h_int_sq
    have hs := (hasSum_sq_fourierCoeffOn zero_lt_one h_memLp).summable
    simpa [g_C, h_fc_eq g] using hs
  let w₀ : ℝ → ℝ := (w : ℝ → ℝ)
  let w₁ : ℝ → ℝ := deriv w₀
  have hw₀_cont : Continuous w₀ := w.2.1.continuous
  have hw₀_per : Function.Periodic w₀ 1 := w.2.2
  have hw₀_diff : Differentiable ℝ w₀ := w.2.1.differentiable (by decide)
  have hw₁_cont : Continuous w₁ := w.2.1.continuous_deriv (by decide)
  have h_ibp : ∀ n : ℤ, n ≠ 0 →
      fourierCircle w₀ n = fourierCircle w₁ n / (2 * (π : ℂ) * I * (n : ℂ)) := by
    intro n hn
    have h_deriv : ∀ x ∈ Set.uIcc (0 : ℝ) 1,
        HasDerivAt (fun y : ℝ => (w₀ y : ℂ)) (w₁ x : ℂ) x :=
      fun x _ => (hw₀_diff.differentiableAt.hasDerivAt).ofReal_comp
    have h_int : IntervalIntegrable (fun x : ℝ => (w₁ x : ℂ)) volume 0 1 :=
      (Complex.continuous_ofReal.comp hw₁_cont).intervalIntegrable 0 1
    have h_eq := fourierCoeffOn_of_hasDerivAt zero_lt_one hn h_deriv h_int
    rw [h_fc_eq w₀ n, h_fc_eq w₁ n] at h_eq
    have h_per01 : w₀ 1 = w₀ 0 := by
      have h0 := hw₀_per 0
      simpa using h0
    rw [h_per01, sub_self, mul_zero, zero_sub, Complex.ofReal_one, Complex.ofReal_zero,
      sub_zero, one_mul] at h_eq
    rw [h_eq]
    have h_denom_ne : (2 : ℂ) * (π : ℂ) * I * (n : ℂ) ≠ 0 := by
      refine mul_ne_zero (mul_ne_zero (mul_ne_zero two_ne_zero ?_) Complex.I_ne_zero) ?_
      · exact Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
      · exact Int.cast_ne_zero.mpr hn
    have h_neg_denom_ne : (-2 : ℂ) * (π : ℂ) * I * (n : ℂ) ≠ 0 := by
      have : (-2 : ℂ) * (π : ℂ) * I * (n : ℂ) = -((2 : ℂ) * (π : ℂ) * I * (n : ℂ)) := by ring
      rw [this]
      exact neg_ne_zero.mpr h_denom_ne
    field_simp
  have h_ibp_norm : ∀ n : ℤ, n ≠ 0 →
      ‖fourierCircle w₀ n‖ = ‖fourierCircle w₁ n‖ / (2 * π * |(n : ℝ)|) := by
    intro n hn
    rw [h_ibp n hn, norm_div]
    congr 1
    have h_cast : (2 : ℂ) * (π : ℂ) * I * (n : ℂ) = (((2 * π * (n : ℝ) : ℝ) : ℂ) * I) := by
      push_cast
      ring
    rw [h_cast, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs,
      abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 * π)]
  have h_sum_w1 : Summable (fun n : ℤ => ‖fourierCircle w₁ n‖ ^ 2) := h_parseval w₁ hw₁_cont
  have h_sum_inv_sq : Summable (fun n : ℤ => 1 / (n : ℝ) ^ 2) :=
    Real.summable_one_div_int_pow.mpr (by norm_num)
  have h_sum_ite : Summable (fun n : ℤ => if n = 0 then ‖fourierCircle w₀ 0‖ else 0) :=
    (hasSum_ite_eq (0 : ℤ) ‖fourierCircle w₀ 0‖).summable
  have h_sum_l1 : Summable (fun n : ℤ => ‖fourierCircle w₀ n‖) := by
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun n => ?_)
      ((h_sum_w1.add h_sum_inv_sq).add h_sum_ite)
    by_cases hn : n = 0
    · subst hn
      simp only [ite_true]
      have : 0 ≤ ‖fourierCircle w₁ 0‖ ^ 2 + 1 / ((0 : ℤ) : ℝ) ^ 2 := by positivity
      linarith
    · simp only [if_neg hn, add_zero]
      rw [h_ibp_norm n hn]
      have hn_real : (n : ℝ) ≠ 0 := Int.cast_ne_zero.mpr hn
      have hn_abs_pos : 0 < |(n : ℝ)| := abs_pos.mpr hn_real
      have h_le_two : ‖fourierCircle w₁ n‖ / (2 * π * |(n : ℝ)|) ≤
          ‖fourierCircle w₁ n‖ / (2 * |(n : ℝ)|) := by
        refine div_le_div_of_nonneg_left (norm_nonneg _) (by positivity) ?_
        nlinarith [Real.pi_gt_three]
      set a : ℝ := ‖fourierCircle w₁ n‖
      set b : ℝ := 1 / |(n : ℝ)|
      have hb_sq : b ^ 2 = 1 / (n : ℝ) ^ 2 := by
        dsimp [b]
        rw [div_pow, one_pow, sq_abs]
      have h_ab : a / (2 * |(n : ℝ)|) = (1 / 2) * (a * b) := by
        dsimp [b]
        ring
      nlinarith [sq_nonneg (a - b), sq_nonneg a, sq_nonneg b]
  have h_hasSum : ∀ z : ℝ,
      HasSum (fun n : ℤ =>
        fourierCircle w₀ n *
          Complex.exp (((2 * π * n : ℝ) : ℂ) * (z : ℂ) * I))
        (w₀ z : ℂ) := by
    haveI : Fact (0 < (1 : ℝ)) := ⟨zero_lt_one⟩
    let f_C : ℝ → ℂ := fun x => (w₀ x : ℂ)
    have hf_per : Function.Periodic f_C 1 := fun x => congrArg Complex.ofReal (hw₀_per x)
    have hf_cont : Continuous f_C := Complex.continuous_ofReal.comp hw₀_cont
    have h_lift_cont : Continuous hf_per.lift := by
      rw [(QuotientAddGroup.isQuotientMap_mk (AddSubgroup.zmultiples (1 : ℝ))).continuous_iff]
      have h_comp : hf_per.lift ∘ QuotientAddGroup.mk = f_C := funext hf_per.lift_coe
      rw [h_comp]
      exact hf_cont
    let F : C(AddCircle (1 : ℝ), ℂ) := ⟨hf_per.lift, h_lift_cont⟩
    have h_F_apply : ∀ x : ℝ, F (x : AddCircle (1 : ℝ)) = (w₀ x : ℂ) :=
      fun x => hf_per.lift_coe x
    have h_F_coeff : ∀ n : ℤ, fourierCoeff F n = fourierCircle w₀ n := by
      intro n
      rw [fourierCoeff_eq_intervalIntegral F n 0]
      simp only [div_one, zero_add, one_smul]
      rw [fourierCircle]
      congr 1 with x
      rw [h_F_apply x, fourier_coe_apply, smul_eq_mul]
      congr 1
      congr 1
      push_cast
      ring
    have h_sum_F : Summable (fourierCoeff F) := by
      apply Summable.of_norm
      simpa [h_F_coeff] using h_sum_l1
    intro z
    have hz := has_pointwise_sum_fourier_series_of_summable h_sum_F (z : AddCircle (1 : ℝ))
    have h_term : (fun i : ℤ => fourierCoeff (⇑F) i • (fourier i) (z : AddCircle (1 : ℝ))) =
        (fun n : ℤ => fourierCircle w₀ n *
          Complex.exp (((2 * π * n : ℝ) : ℂ) * (z : ℂ) * I)) := by
      ext n
      rw [h_F_coeff n, fourier_coe_apply, smul_eq_mul]
      congr 1
      congr 1
      push_cast
      ring
    rw [h_F_apply z, h_term] at hz
    exact hz
  have h_sum_w0 : Summable (fun n : ℤ => ‖fourierCircle w₀ n‖ ^ 2) := h_parseval w₀ hw₀_cont
  have h_prof_sq : ∀ n : ℤ,
      ‖hm1ProfileT w₀ n‖ ^ 2 =
        (4 + (2 * π * (n : ℝ)) ^ 2)⁻¹ * ‖fourierCircle w₀ n‖ ^ 2 := by
    intro n
    have h_w_norm : ‖((Real.sqrt (4 + (2 * π * n) ^ 2))⁻¹ : ℂ)‖ =
        (Real.sqrt (4 + (2 * π * n) ^ 2))⁻¹ := by
      rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    dsimp [hm1ProfileT]
    rw [norm_mul, h_w_norm, mul_pow, inv_pow, Real.sq_sqrt (by positivity)]
  have h_mem : Memℓp (hm1ProfileT w₀) 2 := by
    rw [memℓp_gen_iff (by norm_num : (0 : ℝ) < (2 : ENNReal).toReal)]
    refine Summable.of_nonneg_of_le (fun n => by positivity) (fun n => ?_) h_sum_w0
    have h_toReal : (2 : ENNReal).toReal = 2 := by norm_num
    rw [h_toReal, Real.rpow_two, h_prof_sq n]
    have h_inv_le : (4 + (2 * π * (n : ℝ)) ^ 2)⁻¹ ≤ 1 :=
