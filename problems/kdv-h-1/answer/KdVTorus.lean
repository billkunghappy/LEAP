      exact le_trans hf0_le_δ₀ (mul_le_mul_of_nonneg_right h_sq hκ_nonneg)
    have hf_step : ∀ (t : ℝ), (∀ s ∈ Set.uIcc 0 t, f s ≤ δ' ^ 2 * κ) →
