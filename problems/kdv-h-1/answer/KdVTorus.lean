theorem cinfT_hm1_c0_and_iterated_deriv_interpolation (h_sem_basic : (∀ (n : ℕ) (f : ℝ → ℝ), 0 ≤ cinfSeminormT n f) ∧
      (∀ (n : ℕ) (f : ℝ → ℝ) (B : ℝ),
        0 ≤ B → (∀ x : ℝ, |iteratedDeriv n f x| ≤ B) → cinfSeminormT n f ≤ B) ∧
      (∀ (g : CinfT) (n : ℕ) (x : ℝ),
