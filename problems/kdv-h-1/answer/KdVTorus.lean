      have hd_c2 : HasDerivAt cK2 (2 * w2 y) y := hw1.const_mul 2
      have hd_c3 : HasDerivAt cK3 (2 * w1 y) y := (hw0.sub_const (2 * κ₀ ^ 2)).const_mul 2
      have hG2 : HasDerivAt (fun y' => (G y') ^ 2) (2 * G y ^ 1 * DG y) y := hG.pow 2
      have hDG2 : HasDerivAt (fun y' => (DG y') ^ 2) (2 * DG y ^ 1 * ((κ₀ ^ 2 + w0 y) * G y)) y := hDG.pow 2
      refine ((((hd_c1.mul hG2).add ((hd_c2.mul hG).mul hDG)).sub (hd_c3.mul hDG2))).congr_deriv ?_
      dsimp [cK1, cK2, cK3]
      rw [congr_fun hkdv_eq y]
      ring
    obtain ⟨BK1, hBK1, hcK1_bd⟩ := h_per_bounded cK1
      ((((h_smooth_iter w0 hw_cd 2).1.continuous.neg.add (continuous_const.mul (hw_cd.continuous.pow 2))).sub
        (continuous_const.mul hw_cd.continuous)).sub continuous_const)
      (fun y => by
        dsimp [cK1, w2]
        rw [h_per_iter w0 hw_per 2 y, hw_per y])
    obtain ⟨BK2, hBK2, hcK2_bd⟩ := h_per_bounded cK2
      (continuous_const.mul (h_smooth_iter w0 hw_cd 1).1.continuous)
      (fun y => by dsimp [cK2, w1]; rw [h_per_iter w0 hw_per 1 y])
    obtain ⟨BK3, hBK3, hcK3_bd⟩ := h_per_bounded cK3
      (continuous_const.mul (hw_cd.continuous.sub continuous_const))
      (fun y => by dsimp [cK3]; rw [hw_per y])
    let G_L : ℝ → ℝ := greenKernelLeft κ₀ w0 x
    let D_L : ℝ → ℝ := greenDerivLeft κ₀ w0 x
    let G_R : ℝ → ℝ := greenKernelRight κ₀ w0 x
    let D_R : ℝ → ℝ := greenDerivRight κ₀ w0 x
    have hGLx : G_L x = 1 / (2 * κ₀) + m0 x := by
      dsimp [G_L]; rw [(h_eq_LR x x).1 le_rfl]; exact hg₀_eq x
    have hGRx : G_R x = 1 / (2 * κ₀) + m0 x := by
      dsimp [G_R]; rw [(h_eq_LR x x).2 le_rfl]; exact hg₀_eq x
    have hDLx : D_L x = (m1 x + 1) / 2 := by
      dsimp [D_L]; rw [(h_jump_LR x).1, h_dgd_eq x]
    have hDRx : D_R x = (m1 x - 1) / 2 := by
      dsimp [D_R]; rw [(h_jump_LR x).2, h_dgd_eq x]
    let f_kdv : ℝ → ℝ := fun y => greenKernel κ₀ w0 x y * kdvRHS w0 y * greenKernel κ₀ w0 y x
    have hKL_deriv : ∀ y ∈ Set.Iic x, HasDerivAt (K G_L D_L) (f_kdv y) y := by
      intro y hy
      refine (hK_deriv G_L D_L y (h_d1_LR x y).1 ((h_d2_LR x y).1 hy)).congr_deriv ?_
      dsimp [f_kdv, G_L]
      rw [(h_eq_LR x y).1 hy, h_G_symm y x]
    have hKR_deriv : ∀ y ∈ Set.Ici x, HasDerivAt (K G_R D_R) (f_kdv y) y := by
      intro y hy
      refine (hK_deriv G_R D_R y (h_d1_LR x y).2 ((h_d2_LR x y).2 hy)).congr_deriv ?_
      dsimp [f_kdv, G_R]
      rw [(h_eq_LR x y).2 hy, h_G_symm y x]
    have h_kdv_L : ∫ y in Set.Iic x, f_kdv y = K G_L D_L x - 0 :=
      MeasureTheory.integral_Iic_of_hasDerivAt_of_tendsto
        (hKL_deriv x Set.right_mem_Iic).continuousAt.continuousWithinAt
        (fun y hy => hKL_deriv y (Set.Iio_subset_Iic_self hy))
        h_int_kdv.integrableOn
        (h_quad_tendsto cK1 cK2 cK3 G_L D_L BK1 BK2 BK3 Filter.atBot
          hBK1 hBK2 hBK3 hcK1_bd hcK2_bd hcK3_bd (h_tend_LR x).1 (h_tend_LR x).2.1)
    have h_kdv_R : ∫ y in Set.Ioi x, f_kdv y = 0 - K G_R D_R x :=
      MeasureTheory.integral_Ioi_of_hasDerivAt_of_tendsto
        (hKR_deriv x Set.left_mem_Ici).continuousAt.continuousWithinAt
        (fun y hy => hKR_deriv y (Set.Ioi_subset_Ici_self hy))
        h_int_kdv.integrableOn
        (h_quad_tendsto cK1 cK2 cK3 G_R D_R BK1 BK2 BK3 Filter.atTop
