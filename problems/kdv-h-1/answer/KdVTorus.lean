        intro h0
        have h_low := h_denom η
        change (3 / 4) * (κ ^ 2 + η ^ 2) ≤ ‖D‖ at h_low
        rw [h0, norm_zero] at h_low
        have : 0 < (3 / 4) * (κ ^ 2 + η ^ 2) := by positivity
        linarith
      have hκ_c_ne : (κ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hκ_pos)
      rw [h_shift, integral_const_mul, h_split, h_iic_eq, h_ioi_eq]
