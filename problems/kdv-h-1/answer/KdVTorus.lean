        (fun s' => V s' τ₀) v₁ s₀ hv₁_deriv (n + 4) (η₀ / 2) (half_pos hη₀_pos)
    obtain ⟨σ₀, M, hσ₀_pos, hM_nn, h_lip⟩ :=
      reg_flow_short_time_cinfT_seminorm_lipschitzT (n + 3) R₀ hR₀_nn
    have hM1_pos : 0 < M + 1 := by linarith
    let η₁ : ℝ := min δ₁ (min σ₀ ((η₀ / 2) / (M + 1)))
    have hη₁_pos : 0 < η₁ := lt_min hδ₁_pos (lt_min hσ₀_pos (div_pos (half_pos hη₀_pos) hM1_pos))
    let η : ℝ := min η₁ η₂
    have hη_pos : 0 < η := lt_min hη₁_pos hη₂_pos
    refine ⟨η, hη_pos, ?_⟩
    intro s hs x
    have hs_η₁ : |s - s₀| < η₁ := lt_of_lt_of_le hs (min_le_left _ _)
    have hs_η₂ : |s - s₀| < η₂ := lt_of_lt_of_le hs (min_le_right _ _)
    have hs_δ₁ : |s - s₀| < δ₁ := lt_of_lt_of_le hs_η₁ (min_le_left _ _)
    have hs_σ₀ : |s - s₀| ≤ σ₀ :=
      le_of_lt (lt_of_lt_of_le hs_η₁ (le_trans (min_le_right _ _) (min_le_left _ _)))
    have hs_M : |s - s₀| ≤ (η₀ / 2) / (M + 1) :=
      le_of_lt (lt_of_lt_of_le hs_η₁ (le_trans (min_le_right _ _) (min_le_right _ _)))
    have h_tau_diff : (t - s) - τ₀ = -(s - s₀) := by
      dsimp [τ₀]
      ring
    have h_tau_abs : |(t - s) - τ₀| = |s - s₀| := by
      rw [h_tau_diff, abs_neg]
    have h_tau_σ₀ : |(t - s) - τ₀| ≤ σ₀ := by
      rw [h_tau_abs]
      exact hs_σ₀
    have h_uIcc_close : ∀ s' ∈ Set.uIcc s₀ s, ∀ d ≤ n + 3, ∀ y : ℝ,
        |iteratedDeriv d (V s' (t - s) : ℝ → ℝ) y - iteratedDeriv d (V s₀ τ₀ : ℝ → ℝ) y| ≤ η₀ := by
      intro s' hs' d hd y
      have hd4 : d ≤ n + 4 := le_trans hd (Nat.le_succ (n + 3))
      have h_vert : |iteratedDeriv d (V s' τ₀ : ℝ → ℝ) y - iteratedDeriv d (V s₀ τ₀ : ℝ → ℝ) y| ≤ η₀ / 2 :=
        (h_close_bdd s hs_δ₁ s' hs' d hd4 y).1
      have h_init : ∀ d' ≤ (n + 3) + 1, ∀ y' : ℝ, |iteratedDeriv d' (V s' τ₀ : ℝ → ℝ) y'| ≤ R₀ :=
        fun d' hd' y' => (h_close_bdd s hs_δ₁ s' hs' d' hd' y').2
      obtain ⟨hw_cont, hw_mov, hw_fix⟩ :=
        reg_flow_moving_frame_and_pointwise_hasDerivAtT (fun τ => V s' τ) (hV_reg s')
      have h_horiz_lip :=
        h_lip (fun τ => V s' τ) hw_cont hw_mov hw_fix (fun τ => hV_diag s' τ) τ₀ h_init
          (t - s) h_tau_σ₀ d hd y
      have h_horiz : |iteratedDeriv d (V s' (t - s) : ℝ → ℝ) y - iteratedDeriv d (V s' τ₀ : ℝ → ℝ) y| ≤ η₀ / 2 := by
        rw [h_tau_abs] at h_horiz_lip
        calc |iteratedDeriv d (V s' (t - s) : ℝ → ℝ) y - iteratedDeriv d (V s' τ₀ : ℝ → ℝ) y|
          _ ≤ M * |s - s₀| := h_horiz_lip
          _ ≤ (M + 1) * |s - s₀| := mul_le_mul_of_nonneg_right (by linarith) (abs_nonneg _)
          _ ≤ (M + 1) * ((η₀ / 2) / (M + 1)) := mul_le_mul_of_nonneg_left hs_M (le_of_lt hM1_pos)
          _ = η₀ / 2 := mul_div_cancel₀ (η₀ / 2) (ne_of_gt hM1_pos)
      have h_tri := abs_sub_le
        (iteratedDeriv d (V s' (t - s) : ℝ → ℝ) y)
        (iteratedDeriv d (V s' τ₀ : ℝ → ℝ) y)
        (iteratedDeriv d (V s₀ τ₀ : ℝ → ℝ) y)
      linarith
    have hQ₁ := h_kdv_quot (fun s' => V s' (t - s)) (fun s' => hV_kdv (t - s) s') s₀ s h_uIcc_close x
    have h_tau_η₂ : |(t - s) - τ₀| < η₂ := by
      rw [h_tau_abs]
      exact hs_η₂
    have hQ₂ := hη₂ (t - s) h_tau_η₂ x
    rw [h_tau_diff, abs_neg] at hQ₂
    have h_v_iter : iteratedDeriv n (v : ℝ → ℝ) x =
        iteratedDeriv n (v₁ : ℝ → ℝ) x - iteratedDeriv n (v₂ : ℝ → ℝ) x :=
      h_iter_sub v₁ v₂ n x
    have h_diag_sub :
        iteratedDeriv n (fun y => (V s (t - s) : ℝ → ℝ) y - (V s₀ τ₀ : ℝ → ℝ) y) x =
          iteratedDeriv n (fun y => (V s (t - s) : ℝ → ℝ) y - (V s₀ (t - s) : ℝ → ℝ) y) x +
            iteratedDeriv n (fun y => (V s₀ (t - s) : ℝ → ℝ) y - (V s₀ τ₀ : ℝ → ℝ) y) x := by
      rw [h_iter_sub (V s (t - s)) (V s₀ τ₀) n x,
          h_iter_sub (V s (t - s)) (V s₀ (t - s)) n x,
          h_iter_sub (V s₀ (t - s)) (V s₀ τ₀) n x]
      ring
    change |iteratedDeriv n (fun y => (V s (t - s) : ℝ → ℝ) y - (V s₀ τ₀ : ℝ → ℝ) y) x -
      (s - s₀) * iteratedDeriv n (v : ℝ → ℝ) x| ≤ ε * |s - s₀|
    rw [h_diag_sub, h_v_iter]
    let E₁ := iteratedDeriv n (fun y => (V s (t - s) : ℝ → ℝ) y - (V s₀ (t - s) : ℝ → ℝ) y) x -
      (s - s₀) * iteratedDeriv n (v₁ : ℝ → ℝ) x
    let E₂ := iteratedDeriv n (fun y => (V s₀ (t - s) : ℝ → ℝ) y - (V s₀ τ₀ : ℝ → ℝ) y) x -
      -(s - s₀) * iteratedDeriv n (v₂ : ℝ → ℝ) x
    have h_split :
        iteratedDeriv n (fun y => (V s (t - s) : ℝ → ℝ) y - (V s₀ (t - s) : ℝ → ℝ) y) x +
          iteratedDeriv n (fun y => (V s₀ (t - s) : ℝ → ℝ) y - (V s₀ τ₀ : ℝ → ℝ) y) x -
          (s - s₀) * (iteratedDeriv n (v₁ : ℝ → ℝ) x - iteratedDeriv n (v₂ : ℝ → ℝ) x) =
        E₁ + E₂ := by
      dsimp [E₁, E₂]
      ring
    rw [h_split]
    have h_tri := abs_add_le E₁ E₂
    linarith
  · intro x
    change (v₁ : ℝ → ℝ) x - (v₂ : ℝ → ℝ) x = diffFlowRHS κ (V s₀ τ₀ : ℝ → ℝ) x
    rw [hv₁_eq x, hv₂_eq x]
    rfl

theorem kdv_reg_commuting_diff_flowT (h_exists : ∀ q : CinfT, ∃ u : ℝ → CinfT, IsSmoothSolutionT u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → CinfT,
      IsSmoothSolutionT u → IsSmoothSolutionT v → u 0 = v 0 → u = v)
    (δ' : ℝ) (hδ' : 0 < δ') :
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ δ₀ ≤ δ' ∧
      ∀ (κ₀ : ℝ), 1 ≤ κ₀ → ∀ κ : ℝ, 2 * κ₀ ≤ κ →
        ∀ u w : ℝ → CinfT,
          IsSmoothSolutionT u → IsRegFlowSolutionT κ w → w 0 = u 0 →
          hm1KappaSqT κ₀ (ιT (u 0)) ≤ δ₀ ^ 2 * κ₀ →
          ∀ t : ℝ,
            ∃ z : ℝ → CinfT,
              IsDiffFlowSolutionT κ z ∧
              z 0 = w t ∧ z t = u t ∧
              (∀ s : ℝ, ∀ M : ℝ, κ₀ ≤ M → hm1KappaSqT M (ιT (z s)) ≤ δ' ^ 2 * M) ∧
              (∀ s : ℝ, alphaFunctionalT κ (z s : ℝ → ℝ) = alphaFunctionalT κ (u 0 : ℝ → ℝ)) :=
by
  obtain ⟨δ_brack, hδ_brack, h_brack⟩ := kdvRHS_diagGreen_and_regFlowRHS_commutatorT
  obtain ⟨δ_diag, hδ_diag, h_static⟩ := diagGreen_sub_const_cinfT_seminorm_stepT
  obtain ⟨δ_hm1, hδ_hm1_pos, _hδ_hm1_le_brack, h_taylor⟩ :=
    reg_flow_kdv_taylor_remainder_hm1_sq_boundT δ_brack hδ_brack
  set δ_target : ℝ := min δ' (min δ_diag δ_hm1)
  have hδ_target : 0 < δ_target := by positivity
  have hδ_target_le_δ' : δ_target ≤ δ' := min_le_left _ _
  have hδ_target_le_diag : δ_target ≤ δ_diag := le_trans (min_le_right _ _) (min_le_left _ _)
  have hδ_target_le_hm1 : δ_target ≤ δ_hm1 := le_trans (min_le_right _ _) (min_le_right _ _)
  have h_sq_δ' : δ_target ^ 2 ≤ δ' ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ_target) hδ_target_le_δ' 2
  have h_sq_diag : δ_target ^ 2 ≤ δ_diag ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ_target) hδ_target_le_diag 2
  have h_sq_hm1 : δ_target ^ 2 ≤ δ_hm1 ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ_target) hδ_target_le_hm1 2
  obtain ⟨δ₀_reg_ex, hδ₀_reg_ex_pos, _hδ₀_reg_ex_le, h_reg_ex⟩ :=
    reg_flow_global_existence_and_conservationT δ_target hδ_target
  obtain ⟨δ₀_reg_ap, hδ₀_reg_ap_pos, hδ₀_reg_ap_le, h_reg_ap⟩ :=
    reg_flow_apriori_trapping_and_conservationT δ_target hδ_target
  obtain ⟨δ₀_kdv, hδ₀_kdv_pos, _hδ₀_kdv_le, h_kdv⟩ :=
    kdv_alpha_conservation_small_dataT h_exists h_unique δ₀_reg_ex hδ₀_reg_ex_pos
  set δ₀ : ℝ := min δ₀_kdv δ₀_reg_ap
  have hδ₀_pos : 0 < δ₀ := lt_min hδ₀_kdv_pos hδ₀_reg_ap_pos
  have hδ₀_le_kdv : δ₀ ≤ δ₀_kdv := min_le_left _ _
  have hδ₀_le_ap : δ₀ ≤ δ₀_reg_ap := min_le_right _ _
  have hδ₀_le_δ' : δ₀ ≤ δ' :=
    le_trans hδ₀_le_ap (le_trans hδ₀_reg_ap_le hδ_target_le_δ')
  have h_sq_kdv : δ₀ ^ 2 ≤ δ₀_kdv ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ₀_pos) hδ₀_le_kdv 2
  have h_sq_ap : δ₀ ^ 2 ≤ δ₀_reg_ap ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ₀_pos) hδ₀_le_ap 2
  refine ⟨δ₀, hδ₀_pos, hδ₀_le_δ', ?_⟩
  intro κ₀ hκ₀ κ hκ u w hu hw hw0 hu0 t
  have hκ₀_nn : 0 ≤ κ₀ := by linarith
  have hκ_ge2 : 2 ≤ κ := by linarith
  have hκ_ge_κ₀ : κ₀ ≤ κ := by linarith
  have hκ_nn : 0 ≤ κ := by linarith
  have hu0_kdv : hm1KappaSqT κ₀ (ιT (u 0)) ≤ δ₀_kdv ^ 2 * κ₀ :=
    le_trans hu0 (mul_le_mul_of_nonneg_right h_sq_kdv hκ₀_nn)
  have hw0_ap : hm1KappaSqT κ₀ (ιT (w 0)) ≤ δ₀_reg_ap ^ 2 * κ₀ := by
    rw [hw0]
    exact le_trans hu0 (mul_le_mul_of_nonneg_right h_sq_ap hκ₀_nn)
  obtain ⟨hu_ball, hu_alpha⟩ := h_kdv κ₀ hκ₀ u hu hu0_kdv
  obtain ⟨hw_ball, hw_alpha⟩ := h_reg_ap κ₀ hκ₀ κ hκ w hw hw0_ap
  have hu_ball_κ₀ : ∀ s : ℝ, hm1KappaSqT κ₀ (ιT (u s)) ≤ δ₀_reg_ex ^ 2 * κ₀ :=
    fun s => hu_ball s κ₀ le_rfl
  let V : ℝ → ℝ → CinfT := fun s τ =>
    if s = 0 then w τ
    else (h_reg_ex κ₀ hκ₀ κ hκ (u s) (hu_ball_κ₀ s)).choose τ
  have hV_reg : ∀ s : ℝ, IsRegFlowSolutionT κ (fun τ => V s τ) := by
    intro s
    dsimp [V]
    split_ifs with hs
    · exact hw
    · exact (h_reg_ex κ₀ hκ₀ κ hκ (u s) (hu_ball_κ₀ s)).choose_spec.1
  have hV_init_eq : (fun s => V s 0) = u := by
    ext s x
    dsimp [V]
    split_ifs with hs
    · subst hs
      rw [hw0]
    · rw [(h_reg_ex κ₀ hκ₀ κ hκ (u s) (hu_ball_κ₀ s)).choose_spec.2.1]
  have hV_kdv0 : IsSmoothSolutionT (fun s => V s 0) := by
    rw [hV_init_eq]
    exact hu
  have hV_ball : ∀ s τ : ℝ, ∀ M : ℝ, κ₀ ≤ M →
      hm1KappaSqT M (ιT (V s τ)) ≤ δ_target ^ 2 * M := by
    intro s τ M hM
    dsimp [V]
    split_ifs with hs
    · exact hw_ball τ M hM
    · exact (h_reg_ex κ₀ hκ₀ κ hκ (u s) (hu_ball_κ₀ s)).choose_spec.2.2.1 τ M hM
  have hV_alpha : ∀ s τ : ℝ,
      alphaFunctionalT κ (V s τ : ℝ → ℝ) = alphaFunctionalT κ (u 0 : ℝ → ℝ) := by
    intro s τ
    dsimp [V]
    split_ifs with hs
    · rw [hw_alpha κ hκ_ge_κ₀ τ, hw0]
    · rw [(h_reg_ex κ₀ hκ₀ κ hκ (u s) (hu_ball_κ₀ s)).choose_spec.2.2.2 κ hκ_ge_κ₀ τ,
          hu_alpha κ hκ_ge_κ₀ s]
  have hV_diag : ∀ s τ : ℝ, hm1KappaSqT κ (ιT (V s τ)) ≤ δ_diag ^ 2 * κ :=
    fun s τ => le_trans (hV_ball s τ κ hκ_ge_κ₀) (mul_le_mul_of_nonneg_right h_sq_diag hκ_nn)
  have hV_hm1 : ∀ s τ : ℝ, hm1KappaSqT κ (ιT (V s τ)) ≤ δ_hm1 ^ 2 * κ :=
    fun s τ => le_trans (hV_ball s τ κ hκ_ge_κ₀) (mul_le_mul_of_nonneg_right h_sq_hm1 hκ_nn)
  have h_cube := h_taylor κ hκ_ge2 (h_brack κ hκ_ge2) V hV_reg hV_kdv0 hV_hm1
  have hV_kdv := reg_flow_preserves_kdv_of_taylor_and_seminorm_stepT
    δ_diag κ hκ_ge2 (h_static κ hκ_ge2) V hV_reg hV_kdv0 hV_diag h_cube
  let z : ℝ → CinfT := fun s => V s (t - s)
  refine ⟨z, ?_, ?_, ?_, ?_, ?_⟩
  · exact bivariate_cinfT_flows_to_diffFlowT
      δ_diag κ hκ_ge2 (h_static κ hκ_ge2) V hV_kdv hV_reg hV_diag t
  · dsimp [z, V]
    rw [if_pos rfl, sub_zero]
  · change V t (t - t) = u t
    rw [sub_self]
    exact congr_fun hV_init_eq t
  · intro s M hM
    have hM_nn : 0 ≤ M := le_trans hκ₀_nn hM
    exact le_trans (hV_ball s (t - s) M hM) (mul_le_mul_of_nonneg_right h_sq_δ' hM_nn)
  · intro s
    exact hV_alpha s (t - s)

theorem diff_flow_recipGreenDiff_hm2_integral_boundT : ∃ δ_evol : ℝ, 0 < δ_evol ∧
      ∀ (κ₀ : ℝ), 1 ≤ κ₀ → ∀ κ : ℝ, 2 * κ₀ ≤ κ →
        ∀ z : ℝ → CinfT,
          IsDiffFlowSolutionT κ z →
          (∀ s : ℝ, hm1KappaSqT κ₀ (ιT (z s)) ≤ δ_evol ^ 2 * κ₀) →
          ∀ t : ℝ, ∀ M_flux : ℝ, 0 ≤ M_flux →
            (∀ s : ℝ, Real.sqrt (hm2NormSqT (deriv (recipGreenFluxT κ₀ κ (z s : ℝ → ℝ)))) ≤ M_flux) →
            Real.sqrt (hm2NormSqT (fun x => recipGreenDiffT κ₀ (z t : ℝ → ℝ) x - recipGreenDiffT κ₀ (z 0 : ℝ → ℝ) x)) ≤
              |t| * M_flux :=
by
  
  have h_w1_sum : Summable (fun m : ℤ => 1 / (1 ^ 2 + (0 - 2 * π * m) ^ 2)) :=
    ((blochFloquet_kernel_tsum_boundT 1 le_rfl).1 0).1
  have h_hm2_bound : ∀ (Ψ F : ℝ → ℝ → ℝ),
      (∀ s : ℝ, Continuous (Ψ s)) →
      (∀ s : ℝ, Continuous (F s)) →
      (∀ (s : ℝ) (ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
        ∀ τ : ℝ, |τ - s| < η → ∀ x : ℝ,
          |Ψ τ x - Ψ s x - (τ - s) * (-F s x)| ≤ ε * |τ - s|) →
      ∀ (t M_flux : ℝ), 0 ≤ M_flux →
        (∀ s : ℝ, Real.sqrt (hm2NormSqT (F s)) ≤ M_flux) →
        Real.sqrt (hm2NormSqT (fun x => Ψ t x - Ψ 0 x)) ≤ |t| * M_flux := by
    intro Ψ F hΨ_cont hF_cont h_unif_deriv t M_flux hM_flux h_flux
    have h_exp_norm : ∀ (n : ℤ) (x : ℝ),
        ‖Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I)‖ = 1 := by
      intro n x
      have h_eq : -(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I =
          ((-(2 * π * n * x) : ℝ) : ℂ) * I := by push_cast; ring
      rw [h_eq, Complex.norm_exp_ofReal_mul_I]
    have h_fc_bound_of_le : ∀ (f : ℝ → ℝ) (B : ℝ),
        0 ≤ B → (∀ x : ℝ, |f x| ≤ B) → ∀ n : ℤ, ‖fourierCircle f n‖ ≤ B := by
      intro f B _hB hf n
      unfold fourierCircle
      have h_le := intervalIntegral.norm_integral_le_of_norm_le_const (a := (0 : ℝ)) (b := 1) (C := B)
        (f := fun x : ℝ => Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * (f x : ℂ))
        (fun x _ => by
          rw [norm_mul, h_exp_norm n x, one_mul, Complex.norm_real, Real.norm_eq_abs]
          exact hf x)
      simpa using h_le
    have h_cont_bound_01 : ∀ (f : ℝ → ℝ), Continuous f →
        ∃ B : ℝ, 0 ≤ B ∧ ∀ n : ℤ, ‖fourierCircle f n‖ ≤ B := by
      intro f hf
      obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn
        (s := Set.Icc (0 : ℝ) 1) hf.continuousOn
      refine ⟨max C 0, le_max_right C 0, fun n => ?_⟩
      unfold fourierCircle
      have h_le := intervalIntegral.norm_integral_le_of_norm_le_const (a := (0 : ℝ)) (b := 1) (C := max C 0)
        (f := fun x : ℝ => Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * (f x : ℂ))
        (fun x hx => by
          rw [Set.uIoc_of_le zero_le_one] at hx
          have hx_icc : x ∈ Set.Icc (0 : ℝ) 1 := Set.Ioc_subset_Icc_self hx
          rw [norm_mul, h_exp_norm n x, one_mul, Complex.norm_real]
          exact le_trans (hC x hx_icc) (le_max_left C 0))
      simpa using h_le
    have h_fc_int : ∀ (f : ℝ → ℝ), Continuous f → ∀ n : ℤ,
