              (∀ d ≤ N + 1, ∀ y : ℝ, |iteratedDeriv d (w τ₀ : ℝ → ℝ) y| ≤ R₀) →
              ∀ τ : ℝ, |τ - τ₀| ≤ σ₀ →
                ∀ d ≤ N, ∀ x : ℝ,
                  |iteratedDeriv d (w τ : ℝ → ℝ) x - iteratedDeriv d (w τ₀ : ℝ → ℝ) x| ≤ M * |τ - τ₀| := by
    have h_single_step : ∀ (D : ℕ) (σ₁ R₁ : ℝ),
        0 < σ₁ → 0 ≤ R₁ →
        ∃ σ₂ B₂ : ℝ, 0 < σ₂ ∧ σ₂ ≤ σ₁ ∧ R₁ ≤ B₂ ∧
          ∀ w : ℝ → CinfT,
            (∀ d : ℕ, Continuous (fun τ : ℝ => cinfSeminormT d (w τ : ℝ → ℝ))) →
            (∀ (d : ℕ) (τ₀ σ x : ℝ) (g_tilde : CinfT),
              (∀ y : ℝ, diagGreen κ (w (τ₀ + σ) : ℝ → ℝ) y = 1 / (2 * κ) + (g_tilde : ℝ → ℝ) y) →
              HasDerivAt (fun σ' : ℝ => iteratedDeriv d (w (τ₀ + σ') : ℝ → ℝ) (x - 4 * κ ^ 2 * σ'))
                (16 * κ ^ 5 * iteratedDeriv (d + 1) (g_tilde : ℝ → ℝ) (x - 4 * κ ^ 2 * σ)) σ) →
            (∀ τ : ℝ, hm1KappaSqT κ (ιT (w τ)) ≤ δ_diag ^ 2 * κ) →
            ∀ τ₀ : ℝ,
              (∀ y : ℝ, |iteratedDeriv D (w τ₀ : ℝ → ℝ) y| ≤ R₁) →
              (∀ τ : ℝ, |τ - τ₀| ≤ σ₁ → ∀ d < D, ∀ y : ℝ, |iteratedDeriv d (w τ : ℝ → ℝ) y| ≤ R₁) →
              ∀ τ : ℝ, |τ - τ₀| ≤ σ₂ →
                ∀ y : ℝ, |iteratedDeriv D (w τ : ℝ → ℝ) y| ≤ B₂ := by
      intro D σ₁ R₁ hσ₁_pos hR₁
      obtain ⟨C₁, C₂, hC₁_nn, hC₂_nn, h_g⟩ := h_static D R₁ hR₁
      have h_denom_pos : 0 < 32 * κ ^ 5 * (C₁ + 1) := by positivity
      let σ₂ : ℝ := min σ₁ (1 / (32 * κ ^ 5 * (C₁ + 1)))
      have hσ₂_pos : 0 < σ₂ := lt_min hσ₁_pos (div_pos one_pos h_denom_pos)
      have hσ₂_le_σ₁ : σ₂ ≤ σ₁ := min_le_left _ _
      have hσ₂_le_inv : σ₂ ≤ 1 / (32 * κ ^ 5 * (C₁ + 1)) := min_le_right _ _
      have h_half : σ₂ * (16 * κ ^ 5) * C₁ ≤ 1 / 2 := by
        have h1 : σ₂ * (32 * κ ^ 5 * (C₁ + 1)) ≤ 1 :=
          (le_div_iff₀ h_denom_pos).mp hσ₂_le_inv
        have h2 : 0 ≤ σ₂ * κ ^ 5 := by positivity
        linarith
      let A₁ : ℝ := R₁ + σ₂ * (16 * κ ^ 5) * C₂
      let B₂ : ℝ := max R₁ (2 * A₁)
      refine ⟨σ₂, B₂, hσ₂_pos, hσ₂_le_σ₁, le_max_left _ _, ?_⟩
      intro w hw_cont hw_mov hw_ball τ₀ hw_init hw_low
      let f_max : ℝ → ℝ := fun σ => cinfSeminormT D (w (τ₀ + σ) : ℝ → ℝ)
      have hf_cont : Continuous f_max := (hw_cont D).comp (continuous_const.add continuous_id)
      have hI_nonempty : (Set.Icc (-σ₂) σ₂).Nonempty := Set.nonempty_Icc.mpr (by linarith)
      obtain ⟨σ_star, hσ_star_mem, hσ_star_max⟩ :=
        isCompact_Icc.exists_isMaxOn hI_nonempty hf_cont.continuousOn
      let M_star : ℝ := f_max σ_star
      have hM_star_nn : 0 ≤ M_star := h_semi_nn D (w (τ₀ + σ_star) : ℝ → ℝ)
      have h_le_M_star : ∀ σ' ∈ Set.Icc (-σ₂) σ₂, f_max σ' ≤ M_star :=
        fun σ' hσ' => isMaxOn_iff.mp hσ_star_max σ' hσ'
      have h_pt_Icc : ∀ σ ∈ Set.Icc (-σ₂) σ₂, ∀ z : ℝ,
          |iteratedDeriv D (w (τ₀ + σ) : ℝ → ℝ) z| ≤ A₁ + (1 / 2) * M_star := by
        intro σ hσ z
        have hσ_abs : |σ| ≤ σ₂ := abs_le.mpr ⟨hσ.1, hσ.2⟩
        let x : ℝ := z + 4 * κ ^ 2 * σ
        let Φ : ℝ → ℝ := fun σ' => iteratedDeriv D (w (τ₀ + σ') : ℝ → ℝ) (x - 4 * κ ^ 2 * σ')
        let L_bound : ℝ := 16 * κ ^ 5 * (C₁ * M_star + C₂)
        have hL_nn : 0 ≤ L_bound := by positivity
        have h_step_σ' : ∀ σ' ∈ Set.uIcc 0 σ,
            ∃ d_val : ℝ, HasDerivAt Φ d_val σ' ∧ ‖d_val‖ ≤ L_bound := by
          intro σ' hσ'
          have hσ'_le_σ : |σ'| ≤ |σ| := h_uIcc_abs σ σ' hσ'
          have hσ'_le_σ₂ : |σ'| ≤ σ₂ := le_trans hσ'_le_σ hσ_abs
          have hσ'_le_σ₁ : |σ'| ≤ σ₁ := le_trans hσ'_le_σ₂ hσ₂_le_σ₁
          have hσ'_mem : σ' ∈ Set.Icc (-σ₂) σ₂ := abs_le.mp hσ'_le_σ₂
          have h_w_M_star : ∀ y : ℝ, |iteratedDeriv D (w (τ₀ + σ') : ℝ → ℝ) y| ≤ M_star :=
            fun y => le_trans (h_iter_le (w (τ₀ + σ')) D y) (h_le_M_star σ' hσ'_mem)
          have h_diff_σ₁ : |(τ₀ + σ') - τ₀| ≤ σ₁ := by
            simpa [add_sub_cancel_left] using hσ'_le_σ₁
          obtain ⟨g_tilde, hg_eq, hg_bound⟩ :=
            h_g (w (τ₀ + σ')) (hw_ball (τ₀ + σ')) (hw_low (τ₀ + σ') h_diff_σ₁)
          let d_val : ℝ := 16 * κ ^ 5 * iteratedDeriv (D + 1) (g_tilde : ℝ → ℝ) (x - 4 * κ ^ 2 * σ')
          refine ⟨d_val, hw_mov D τ₀ σ' x g_tilde hg_eq, ?_⟩
          change |16 * κ ^ 5 * iteratedDeriv (D + 1) (g_tilde : ℝ → ℝ) (x - 4 * κ ^ 2 * σ')| ≤ L_bound
          rw [abs_mul, abs_of_nonneg (by positivity)]
          exact mul_le_mul_of_nonneg_left
            (hg_bound M_star hM_star_nn h_w_M_star (x - 4 * κ ^ 2 * σ')) (by positivity)
        have h_hasDeriv : ∀ σ' ∈ Set.uIcc 0 σ, HasDerivWithinAt Φ (deriv Φ σ') (Set.uIcc 0 σ) σ' := by
          intro σ' hσ'
          obtain ⟨d_val, hd, _⟩ := h_step_σ' σ' hσ'
          rw [hd.deriv]
          exact hd.hasDerivWithinAt
        have h_deriv_le : ∀ σ' ∈ Set.uIcc 0 σ, ‖deriv Φ σ'‖ ≤ L_bound := by
          intro σ' hσ'
          obtain ⟨d_val, hd, hb⟩ := h_step_σ' σ' hσ'
          rw [hd.deriv]
          exact hb
        have h_mvt := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
          h_hasDeriv h_deriv_le (convex_uIcc 0 σ) Set.left_mem_uIcc Set.right_mem_uIcc
        have h_Φ0 : ‖Φ 0‖ ≤ R₁ := by
          change |iteratedDeriv D (w (τ₀ + 0) : ℝ → ℝ) (x - 4 * κ ^ 2 * 0)| ≤ R₁
          rw [add_zero, mul_zero, sub_zero]
          exact hw_init x
        have h_Φσ_eq : ‖Φ σ‖ = |iteratedDeriv D (w (τ₀ + σ) : ℝ → ℝ) z| := by
          change |iteratedDeriv D (w (τ₀ + σ) : ℝ → ℝ) ((z + 4 * κ ^ 2 * σ) - 4 * κ ^ 2 * σ)| = _
          rw [add_sub_cancel_right]
        have h_tri : ‖Φ σ‖ ≤ ‖Φ 0‖ + ‖Φ σ - Φ 0‖ := norm_le_norm_add_norm_sub' (Φ σ) (Φ 0)
        have h_mvt_σ₂ : L_bound * ‖σ - 0‖ ≤ σ₂ * L_bound := by
          rw [sub_zero, Real.norm_eq_abs, mul_comm]
          exact mul_le_mul_of_nonneg_right hσ_abs hL_nn
        have h_alg : R₁ + σ₂ * L_bound = A₁ + (σ₂ * (16 * κ ^ 5) * C₁) * M_star := by
          dsimp [A₁, L_bound]
          ring
        have h_half_M : (σ₂ * (16 * κ ^ 5) * C₁) * M_star ≤ (1 / 2) * M_star :=
          mul_le_mul_of_nonneg_right h_half hM_star_nn
        linarith
      have hM_star_le : M_star ≤ A₁ + (1 / 2) * M_star :=
        h_semi_le D (w (τ₀ + σ_star) : ℝ → ℝ) _ (fun z _ => h_pt_Icc σ_star hσ_star_mem z)
      have hM_star_bound : M_star ≤ 2 * A₁ := by linarith
      intro τ hτ y
      have h_mem : τ - τ₀ ∈ Set.Icc (-σ₂) σ₂ := abs_le.mp hτ
      have h_pt := h_pt_Icc (τ - τ₀) h_mem y
      have h_eq : τ₀ + (τ - τ₀) = τ := add_sub_cancel τ₀ τ
      rw [h_eq] at h_pt
      have h_le_2A₁ : |iteratedDeriv D (w τ : ℝ → ℝ) y| ≤ 2 * A₁ := by linarith
      exact le_trans h_le_2A₁ (le_max_right R₁ (2 * A₁))
    have h_ind : ∀ (D : ℕ) (R₀ : ℝ), 0 ≤ R₀ →
        ∃ σ₀ B : ℝ, 0 < σ₀ ∧ R₀ ≤ B ∧
          ∀ w : ℝ → CinfT,
            (∀ d : ℕ, Continuous (fun τ : ℝ => cinfSeminormT d (w τ : ℝ → ℝ))) →
            (∀ (d : ℕ) (τ₀ σ x : ℝ) (g_tilde : CinfT),
              (∀ y : ℝ, diagGreen κ (w (τ₀ + σ) : ℝ → ℝ) y = 1 / (2 * κ) + (g_tilde : ℝ → ℝ) y) →
              HasDerivAt (fun σ' : ℝ => iteratedDeriv d (w (τ₀ + σ') : ℝ → ℝ) (x - 4 * κ ^ 2 * σ'))
                (16 * κ ^ 5 * iteratedDeriv (d + 1) (g_tilde : ℝ → ℝ) (x - 4 * κ ^ 2 * σ)) σ) →
            (∀ τ : ℝ, hm1KappaSqT κ (ιT (w τ)) ≤ δ_diag ^ 2 * κ) →
            ∀ τ₀ : ℝ,
              (∀ d ≤ D, ∀ y : ℝ, |iteratedDeriv d (w τ₀ : ℝ → ℝ) y| ≤ R₀) →
              ∀ τ : ℝ, |τ - τ₀| ≤ σ₀ →
                ∀ d ≤ D, ∀ y : ℝ, |iteratedDeriv d (w τ : ℝ → ℝ) y| ≤ B := by
      intro D
      induction D with
      | zero =>
        intro R₀ hR₀
        obtain ⟨σ₂, B₂, hσ₂_pos, _hσ₂_le1, hR₀_le, h_step⟩ :=
          h_single_step 0 1 R₀ one_pos hR₀
        refine ⟨σ₂, B₂, hσ₂_pos, hR₀_le, ?_⟩
        intro w hw_cont hw_mov hw_ball τ₀ hw_init τ hτ d hd y
        have hd0 : d = 0 := Nat.le_zero.mp hd
        subst hd0
        refine h_step w hw_cont hw_mov hw_ball τ₀ (hw_init 0 le_rfl)
          (fun _ _ d' hd' => (Nat.not_lt_zero d' hd').elim) τ hτ y
      | succ D ihD =>
        intro R₀ hR₀
        obtain ⟨σ₁, R₁, hσ₁_pos, hR₀_le_R₁, h_ihD⟩ := ihD R₀ hR₀
        have hR₁_nn : 0 ≤ R₁ := le_trans hR₀ hR₀_le_R₁
        obtain ⟨σ₂, B₂, hσ₂_pos, hσ₂_le_σ₁, hR₁_le_B₂, h_step⟩ :=
          h_single_step (D + 1) σ₁ R₁ hσ₁_pos hR₁_nn
        refine ⟨σ₂, B₂, hσ₂_pos, le_trans hR₀_le_R₁ hR₁_le_B₂, ?_⟩
        intro w hw_cont hw_mov hw_ball τ₀ hw_init τ hτ d hd y
        have h_low : ∀ τ' : ℝ, |τ' - τ₀| ≤ σ₁ → ∀ d' ≤ D, ∀ z : ℝ,
            |iteratedDeriv d' (w τ' : ℝ → ℝ) z| ≤ R₁ := by
          intro τ' hτ' d' hd' z
          exact h_ihD w hw_cont hw_mov hw_ball τ₀
            (fun d'' hd'' => hw_init d'' (le_trans hd'' (Nat.le_succ D)))
            τ' hτ' d' hd' z
        rcases Nat.of_le_succ hd with hd_le_D | rfl
        · exact le_trans (h_low τ (le_trans hτ hσ₂_le_σ₁) d hd_le_D y) hR₁_le_B₂
        · refine h_step w hw_cont hw_mov hw_ball τ₀
            (fun z => le_trans (hw_init (D + 1) le_rfl z) hR₀_le_R₁)
            (fun τ' hτ' d' hd' z => h_low τ' hτ' d' (Nat.lt_succ_iff.mp hd') z) τ hτ y
    intro N R₀ hR₀
    obtain ⟨σ₀, B, hσ₀_pos, hR₀_le_B, h_bound⟩ := h_ind (N + 1) R₀ hR₀
    have hB_nn : 0 ≤ B := le_trans hR₀ hR₀_le_B
    let C₁ : ℕ → ℝ := fun d => (h_static d B hB_nn).choose
    let C₂ : ℕ → ℝ := fun d => (h_static d B hB_nn).choose_spec.choose
    have hC_spec : ∀ d : ℕ, 0 ≤ C₁ d ∧ 0 ≤ C₂ d ∧
        ∀ w : CinfT, hm1KappaSqT κ (ιT w) ≤ δ_diag ^ 2 * κ →
          (∀ d' < d, ∀ y : ℝ, |iteratedDeriv d' (w : ℝ → ℝ) y| ≤ B) →
          ∃ g_tilde : CinfT,
            (∀ x : ℝ, diagGreen κ (w : ℝ → ℝ) x = 1 / (2 * κ) + (g_tilde : ℝ → ℝ) x) ∧
            (∀ M_n : ℝ, 0 ≤ M_n →
              (∀ y : ℝ, |iteratedDeriv d (w : ℝ → ℝ) y| ≤ M_n) →
              ∀ x : ℝ, |iteratedDeriv (d + 1) (g_tilde : ℝ → ℝ) x| ≤ C₁ d * M_n + C₂ d) :=
      fun d => (h_static d B hB_nn).choose_spec.choose_spec
    let M_d : ℕ → ℝ := fun d => 16 * κ ^ 5 * (C₁ d * B + C₂ d) + 4 * κ ^ 2 * B
    have hM_d_nn : ∀ d : ℕ, 0 ≤ M_d d := by
      intro d
      have := (hC_spec d).1
      have := (hC_spec d).2.1
      positivity
    let M : ℝ := ∑ d ∈ Finset.range (N + 1), M_d d
    have hM_nn : 0 ≤ M := Finset.sum_nonneg (fun d _ => hM_d_nn d)
    refine ⟨σ₀, M, hσ₀_pos, hM_nn, ?_⟩
    intro w hw_cont hw_mov hw_fix hw_ball τ₀ hw_init τ hτ d hd x
    have h_w_bound : ∀ τ' : ℝ, |τ' - τ₀| ≤ σ₀ →
        ∀ d' ≤ N + 1, ∀ y : ℝ, |iteratedDeriv d' (w τ' : ℝ → ℝ) y| ≤ B :=
      h_bound w hw_cont hw_mov hw_ball τ₀ hw_init
    have h_Md_le_M : M_d d ≤ M :=
      Finset.single_le_sum (fun j _ => hM_d_nn j) (Finset.mem_range.mpr (Nat.lt_succ_of_le hd))
    let ψ : ℝ → ℝ := fun τ' => iteratedDeriv d (w τ' : ℝ → ℝ) x
    have h_step_τ' : ∀ τ' ∈ Set.uIcc τ₀ τ,
        ∃ d_val : ℝ, HasDerivAt ψ d_val τ' ∧ ‖d_val‖ ≤ M := by
      intro τ' hτ'
      have hτ'_σ₀ : |τ' - τ₀| ≤ σ₀ := le_trans (h_uIcc_sub_abs τ₀ τ τ' hτ') hτ
      have h_low_d : ∀ d' < d, ∀ y : ℝ, |iteratedDeriv d' (w τ' : ℝ → ℝ) y| ≤ B :=
        fun d' hd' y => h_w_bound τ' hτ'_σ₀ d' (le_trans (le_of_lt hd') (le_trans hd (Nat.le_succ N))) y
      obtain ⟨g_tilde, hg_eq, hg_bound⟩ := (hC_spec d).2.2 (w τ') (hw_ball τ') h_low_d
      have h_w_d : ∀ y : ℝ, |iteratedDeriv d (w τ' : ℝ → ℝ) y| ≤ B :=
        h_w_bound τ' hτ'_σ₀ d (le_trans hd (Nat.le_succ N))
      have h_w_d1 : |iteratedDeriv (d + 1) (w τ' : ℝ → ℝ) x| ≤ B :=
        h_w_bound τ' hτ'_σ₀ (d + 1) (Nat.add_le_add_right hd 1) x
      have hg_x : |iteratedDeriv (d + 1) (g_tilde : ℝ → ℝ) x| ≤ C₁ d * B + C₂ d :=
        hg_bound B hB_nn h_w_d x
      let d_val : ℝ := 16 * κ ^ 5 * iteratedDeriv (d + 1) (g_tilde : ℝ → ℝ) x +
        4 * κ ^ 2 * iteratedDeriv (d + 1) (w τ' : ℝ → ℝ) x
      refine ⟨d_val, hw_fix d τ' x g_tilde hg_eq, ?_⟩
      have h_tri : |d_val| ≤
          |16 * κ ^ 5 * iteratedDeriv (d + 1) (g_tilde : ℝ → ℝ) x| +
          |4 * κ ^ 2 * iteratedDeriv (d + 1) (w τ' : ℝ → ℝ) x| :=
        abs_add_le _ _
      have h_abs1 : |16 * κ ^ 5 * iteratedDeriv (d + 1) (g_tilde : ℝ → ℝ) x| =
          16 * κ ^ 5 * |iteratedDeriv (d + 1) (g_tilde : ℝ → ℝ) x| := by
        rw [abs_mul, abs_of_nonneg (by positivity)]
      have h_abs2 : |4 * κ ^ 2 * iteratedDeriv (d + 1) (w τ' : ℝ → ℝ) x| =
          4 * κ ^ 2 * |iteratedDeriv (d + 1) (w τ' : ℝ → ℝ) x| := by
        rw [abs_mul, abs_of_nonneg (by positivity)]
      rw [h_abs1, h_abs2] at h_tri
      have h_t1 : 16 * κ ^ 5 * |iteratedDeriv (d + 1) (g_tilde : ℝ → ℝ) x| ≤
          16 * κ ^ 5 * (C₁ d * B + C₂ d) :=
        mul_le_mul_of_nonneg_left hg_x (by positivity)
      have h_t2 : 4 * κ ^ 2 * |iteratedDeriv (d + 1) (w τ' : ℝ → ℝ) x| ≤ 4 * κ ^ 2 * B :=
        mul_le_mul_of_nonneg_left h_w_d1 (by positivity)
      have h_le_Md : |d_val| ≤ M_d d := by
        dsimp [M_d]
        linarith
      rw [Real.norm_eq_abs]
      exact le_trans h_le_Md h_Md_le_M
    have h_hasDeriv : ∀ τ' ∈ Set.uIcc τ₀ τ, HasDerivWithinAt ψ (deriv ψ τ') (Set.uIcc τ₀ τ) τ' := by
      intro τ' hτ'
      obtain ⟨d_val, hd_val, _⟩ := h_step_τ' τ' hτ'
      rw [hd_val.deriv]
      exact hd_val.hasDerivWithinAt
    have h_deriv_le : ∀ τ' ∈ Set.uIcc τ₀ τ, ‖deriv ψ τ'‖ ≤ M := by
      intro τ' hτ'
      obtain ⟨d_val, hd_val, hb⟩ := h_step_τ' τ' hτ'
      rw [hd_val.deriv]
      exact hb
    have h_mvt := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
      h_hasDeriv h_deriv_le (convex_uIcc τ₀ τ) Set.left_mem_uIcc Set.right_mem_uIcc
    simpa [ψ, Real.norm_eq_abs] using h_mvt
  
  have kdv_flow_difference_quotient_bound_of_closeT :
      ∀ (q₀ v₁ : CinfT),
        (∀ x : ℝ, (v₁ : ℝ → ℝ) x = kdvRHS (q₀ : ℝ → ℝ) x) →
        ∀ (n : ℕ) (ε : ℝ), 0 < ε →
          ∃ η₀ : ℝ, 0 < η₀ ∧
            ∀ (u : ℝ → CinfT),
              (∀ s' : ℝ, ∃ v : CinfT,
                HasCinfDerivAtT u v s' ∧
                ∀ x : ℝ, (v : ℝ → ℝ) x = kdvRHS (u s' : ℝ → ℝ) x) →
              ∀ (s₀ s : ℝ),
                (∀ s' ∈ Set.uIcc s₀ s, ∀ d ≤ n + 3, ∀ y : ℝ,
                  |iteratedDeriv d (u s' : ℝ → ℝ) y - iteratedDeriv d (q₀ : ℝ → ℝ) y| ≤ η₀) →
                ∀ x : ℝ,
                  |iteratedDeriv n (fun y => (u s : ℝ → ℝ) y - (u s₀ : ℝ → ℝ) y) x -
                    (s - s₀) * iteratedDeriv n (v₁ : ℝ → ℝ) x| ≤ ε * |s - s₀| := by
    intro q₀ v₁ hv₁_eq n ε hε
    have h_pt_deriv : ∀ (u : ℝ → CinfT) (v : CinfT) (s' : ℝ),
        HasCinfDerivAtT u v s' →
        ∀ (x : ℝ), HasDerivAt (fun τ => iteratedDeriv n (u τ : ℝ → ℝ) x) (iteratedDeriv n (v : ℝ → ℝ) x) s' := by
      intro u v s' hv_deriv x
      rw [hasDerivAt_iff_isLittleO, Asymptotics.isLittleO_iff]
      intro c hc
      rw [Metric.eventually_nhds_iff]
      obtain ⟨η, hη_pos, hη⟩ := hv_deriv n c hc
      refine ⟨η, hη_pos, fun τ hτ => ?_⟩
      rw [Real.dist_eq] at hτ
      have h1 := hη τ hτ x
      rw [h_iter_sub (u τ) (u s') n x] at h1
      simpa [Real.norm_eq_abs] using h1
    have h_kdv_diff_leibniz : ∀ (q v : CinfT),
        (∀ y : ℝ, (v : ℝ → ℝ) y = kdvRHS (q : ℝ → ℝ) y) →
        ∀ (x : ℝ),
          iteratedDeriv n (fun y => (v : ℝ → ℝ) y - (v₁ : ℝ → ℝ) y) x =
            -iteratedDeriv (n + 3) (fun y => (q : ℝ → ℝ) y - (q₀ : ℝ → ℝ) y) x +
              6 * ∑ i ∈ Finset.range (n + 1), (Nat.choose n i : ℝ) *
                (iteratedDeriv i (fun y => (q : ℝ → ℝ) y - (q₀ : ℝ → ℝ) y) x *
                  iteratedDeriv ((n - i) + 1) (q : ℝ → ℝ) x +
                  iteratedDeriv i (q₀ : ℝ → ℝ) x *
                    iteratedDeriv ((n - i) + 1) (fun y => (q : ℝ → ℝ) y - (q₀ : ℝ → ℝ) y) x) := by
      intro q v hv x
