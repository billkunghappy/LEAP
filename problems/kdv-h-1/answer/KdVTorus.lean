        ⟨((h_G_all ℓ).2.2 x).1, ((h_G_all ℓ).2.2 x).2, (h_pkt_all ℓ x).2.2⟩
        ⟨(h_pkt_all ℓ x).1, (h_pkt_all ℓ x).2.1⟩
        ⟨(h_pkt_all (ℓ + 1) x).1, (h_pkt_all (ℓ + 1) x).2.1⟩
        h_bf
    have hE_pow : ∀ ℓ : ℕ, E ℓ ≤ (1 / (2 * κ)) * (r ^ ℓ) ^ 2 := by
      intro ℓ
