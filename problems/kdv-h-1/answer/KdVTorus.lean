    exact tendsto_nhds_unique h_lhs h_rhs
  obtain ⟨hw_tilde0, hw_tilde_deriv⟩ :=
    h_int_deriv w₀ w_tilde (fun τ => V (w_tilde τ)) (hV_cont w_tilde hw_tilde_cont) h_w_tilde_int
  obtain ⟨w, hw_eq, hw_hm1, hw_deriv⟩ :=
    cinfT_moving_frame_translate_hasCinfDerivAtT h_interp.2.2.1 w_tilde c
  refine ⟨w, ?_, ?_⟩
  · apply Subtype.ext
    funext x
    have h0 := hw_eq 0 x
    rw [mul_zero, add_zero, hw_tilde0] at h0
    exact h0
  · intro s
    obtain ⟨v, hv_deriv, hv_eq⟩ := hw_deriv s (V (w_tilde s)) (hw_tilde_deriv s)
    exact ⟨w_tilde s, v, hw_eq s, hw_hm1 s, hv_deriv, hv_eq⟩

theorem reg_flow_global_existence_and_conservationT (δ : ℝ) (hδ : 0 < δ) :
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ δ₀ ≤ δ ∧
      ∀ (κ₀ : ℝ), 1 ≤ κ₀ → ∀ κ : ℝ, 2 * κ₀ ≤ κ →
        ∀ w₀ : CinfT, hm1KappaSqT κ₀ (ιT w₀) ≤ δ₀ ^ 2 * κ₀ →
          ∃ w : ℝ → CinfT, IsRegFlowSolutionT κ w ∧ w 0 = w₀ ∧
