        mul_le_mul_of_nonneg_left hf0_le_δ₀ (le_of_lt hc₂)
      have h_alg_κ : c₂ * (δ₀ ^ 2 * κ) ≤ c₁ * ((δ' / 2) ^ 2 * κ) := by
        calc c₂ * (δ₀ ^ 2 * κ) = (c₂ * δ₀ ^ 2) * κ := by ring
          _ ≤ (c₁ * (δ' / 2) ^ 2) * κ := mul_le_mul_of_nonneg_right h_alg hκ_nonneg
          _ = c₁ * ((δ' / 2) ^ 2 * κ) := by ring
      have h_c1_le : c₁ * f t ≤ c₁ * ((δ' / 2) ^ 2 * κ) := by linarith
      exact le_of_mul_le_mul_left h_c1_le hc₁
