        rw [h_kdv_diff_leibniz q v hv_eq x]
        refine le_trans (abs_add_le _ _) ?_
        rw [abs_neg, abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 6)]
        gcongr
        refine le_trans (Finset.abs_sum_le_sum_abs _ _) ?_
        refine Finset.sum_le_sum fun i _ => ?_
        rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
        gcongr
        refine le_trans (abs_add_le _ _) ?_
        rw [abs_mul, abs_mul]
      have h_t1 : |iteratedDeriv (n + 3) Δ_fn x| ≤ η₀ := h_Δ_bound (n + 3) le_rfl
      have h_sum_bound : ∑ i ∈ Finset.range (n + 1), (Nat.choose n i : ℝ) *
            (|iteratedDeriv i Δ_fn x| * |iteratedDeriv ((n - i) + 1) (q : ℝ → ℝ) x| +
              |iteratedDeriv i (q₀ : ℝ → ℝ) x| * |iteratedDeriv ((n - i) + 1) Δ_fn x|) ≤
          ∑ i ∈ Finset.range (n + 1), C_term i * η₀ := by
        refine Finset.sum_le_sum fun i hi => ?_
        have hi_lt : i < n + 1 := Finset.mem_range.mp hi
        have hi_le : i ≤ n + 3 := by omega
        have hni_le : (n - i) + 1 ≤ n + 3 := by omega
        have h_Δ_i : |iteratedDeriv i Δ_fn x| ≤ η₀ := h_Δ_bound i hi_le
        have h_Δ_ni : |iteratedDeriv ((n - i) + 1) Δ_fn x| ≤ η₀ := h_Δ_bound ((n - i) + 1) hni_le
        have h_q₀_i : |iteratedDeriv i (q₀ : ℝ → ℝ) x| ≤ cinfSeminormT i (q₀ : ℝ → ℝ) :=
