        rw [← Set.compl_Iic]
        exact (MeasureTheory.integral_add_compl measurableSet_Iic h_int_kdv).symm
      rw [h_sp, h_kdv_L, h_kdv_R]
      dsimp [K, cK1, cK2, cK3]
      rw [hGLx, hGRx, hDLx, hDRx]
      ring
    let cΨ1 : ℝ → ℝ := fun y => -k2 y + 2 * (κ₀ ^ 2 + w0 y) * (1 / (2 * κ) + k0 y)
    let cΨ2 : ℝ → ℝ := fun y => 2 * k1 y
    let cΨ3 : ℝ → ℝ := fun y => 2 * (1 / (2 * κ) + k0 y)
    let Ψ_κ : (ℝ → ℝ) → (ℝ → ℝ) → ℝ → ℝ := fun G DG y =>
      cΨ1 y * (G y) ^ 2 + cΨ2 y * G y * DG y - cΨ3 y * (DG y) ^ 2
    let cΦ1 : ℝ → ℝ := fun y => κ₀ ^ 2 + w0 y
    let Φ_drift : (ℝ → ℝ) → (ℝ → ℝ) → ℝ → ℝ := fun G DG y =>
      cΦ1 y * (G y) ^ 2 + (0 : ℝ) * G y * DG y - (1 : ℝ) * (DG y) ^ 2
    let R_κ : (ℝ → ℝ) → (ℝ → ℝ) → ℝ → ℝ := fun G DG y =>
