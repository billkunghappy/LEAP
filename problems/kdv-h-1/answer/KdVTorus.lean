        calc (greenIterKernel κ w0 (m + 1) x y : ℂ)
          _ = -((1 / (2 * π) : ℂ) * ∫ z : ℝ, ∫ ξ : ℝ, H z ξ) := by
            rw [h_step1, h_step2_eq]
