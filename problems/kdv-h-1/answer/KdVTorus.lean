      intro t h_ball
      have h_δ₁_sq : δ' ^ 2 * κ ≤ δ₁ ^ 2 * κ :=
        mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (le_of_lt hδ') hδ'_le_δ₁ 2) hκ_nonneg
      have hu0_δ₁ : hm1KappaSqT κ (ιT (u 0)) ≤ δ₁ ^ 2 * κ :=
        le_trans (h_ball 0 Set.left_mem_uIcc) h_δ₁_sq
      have hut_δ₁ : hm1KappaSqT κ (ιT (u t)) ≤ δ₁ ^ 2 * κ :=
        le_trans (h_ball t Set.right_mem_uIcc) h_δ₁_sq
      have h_cons_κ : alphaFunctionalT κ (u t : ℝ → ℝ) = alphaFunctionalT κ (u 0 : ℝ → ℝ) :=
        h_local_cons κ hκ t h_ball
      have h_ut_lower : c₁ * f t ≤ κ * alphaFunctionalT κ (u t : ℝ → ℝ) :=
