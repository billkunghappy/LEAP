    exact h_final_alg (w0 x) (w1 x) (m0 x) (m1 x) (k0 x) (k1 x) hm0_ne
  
  have h_unif_lin : ∀ (κ₀ κ : ℝ), 1 ≤ κ₀ → ∀ (z : ℝ → CinfT), IsDiffFlowSolutionT κ z →
