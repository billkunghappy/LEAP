    have h_mod : ∀ ℓ : ℕ,
        |greenIterKernel κ w0 ℓ x x| ≤
          (1 / (2 * π)) * ∫ ξ : ℝ, ‖iterWavePacket κ w0 ℓ x ξ‖ / (κ ^ 2 + ξ ^ 2) := by
      intro ℓ
      have h_eq := congr_arg norm (h_iter_eq ℓ x)
