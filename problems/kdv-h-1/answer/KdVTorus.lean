        exact hc1.mul ((hc2.neg.mul continuous_const).div_const _)
      exact hc.aestronglyMeasurable
    have hF_bound : ∀ j : ℤ, ∀ᵐ x : ℝ ∂μ_I, ‖F j x‖ ≤ bound j x := by
      intro j
      refine Filter.Eventually.of_forall fun x => ?_
      dsimp [F, bound]
      rw [norm_mul, norm_div, norm_mul, norm_neg,
          show -(((2 * π * n - ξ : ℝ) : ℂ) * (x : ℂ)) * I = (((-((2 * π * n - ξ) * x) : ℝ) : ℂ) * I) by push_cast; ring,
          Complex.norm_exp_ofReal_mul_I, one_mul,
          Complex.norm_of_nonneg (le_of_lt (h_denom_pos (ξ - 2 * π * j)))]
      have h_num : ‖iterWavePacket κ₀ w0 ℓ x (ξ - 2 * π * j)‖ * ‖fourierCircle w0 j‖ ≤
          K_ℓ * ‖fourierCircle w0 j‖ :=
        mul_le_mul_of_nonneg_right (hK_ℓ_bd x (ξ - 2 * π * j)) (norm_nonneg _)
      calc ‖iterWavePacket κ₀ w0 ℓ x (ξ - 2 * π * j)‖ * ‖fourierCircle w0 j‖ /
