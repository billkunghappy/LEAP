  have hasCinfDerivAtT_uIcc_close_and_uniform_boundT :
      ∀ (f : ℝ → CinfT) (v₁ : CinfT) (s₀ : ℝ),
        HasCinfDerivAtT f v₁ s₀ →
        ∀ (K : ℕ) (r : ℝ), 0 < r →
          ∃ δ₁ R₀ : ℝ, 0 < δ₁ ∧ 0 ≤ R₀ ∧
            ∀ s : ℝ, |s - s₀| < δ₁ →
