            have hc : Continuous (fun z : ℝ => K_μ ℓ x z * w0 z) :=
              (h_cont_ℓ.comp (continuous_const.prodMk continuous_id)).mul hw_cont
            refine ((h_int_ℓ x).norm.const_mul Bw).mono' hc.aestronglyMeasurable ?_
            filter_upwards with z
            rw [Real.norm_eq_abs, abs_mul, Real.norm_eq_abs, mul_comm Bw]
