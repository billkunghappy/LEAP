    have hR_deriv : ∀ (G DG : ℝ → ℝ) (y : ℝ),
        HasDerivAt G (DG y) y →
        HasDerivAt DG ((κ₀ ^ 2 + w0 y) * G y) y →
        HasDerivAt (R_κ G DG) (G y * regFlowRHS κ w0 y * G y) y := by
      intro G DG y hG hDG
      have hk0 := hk0_d y
      have hk1 := hk1_d y
      have hk2 := hk2_d y
      have hw0 := hw0_d y
      have hG2 : HasDerivAt (fun y' => (G y') ^ 2) (2 * G y ^ 1 * DG y) y := hG.pow 2
      have hDG2 : HasDerivAt (fun y' => (DG y') ^ 2) (2 * DG y ^ 1 * ((κ₀ ^ 2 + w0 y) * G y)) y := hDG.pow 2
      have h_Ψ : HasDerivAt (Ψ_κ G DG) (-4 * (κ ^ 2 - κ₀ ^ 2) * k1 y * (G y) ^ 2) y := by
