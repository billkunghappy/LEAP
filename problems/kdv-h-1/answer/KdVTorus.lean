        (hRR_deriv x Set.left_mem_Ici).continuousAt.continuousWithinAt
        (fun y hy => hRR_deriv y (Set.Ioi_subset_Ici_self hy))
        h_int_reg.integrableOn
        (hR_tendsto G_R D_R Filter.atTop (h_tend_LR x).2.2.1 (h_tend_LR x).2.2.2)
