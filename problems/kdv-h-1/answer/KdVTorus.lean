        linarith
      rw [hIAB_zero, hIB_zero]
      norm_num
    · have hIB_pos : 0 < I_B := lt_of_le_of_ne hIB_nn (Ne.symm hIB_zero)
      have hq := h_quad (I_AB / I_B)
      have hq_mul := mul_nonneg (le_of_lt hIB_pos) hq
      have h_id : I_B * (I_A - 2 * (I_AB / I_B) * I_AB + (I_AB / I_B) ^ 2 * I_B) =
          I_A * I_B - I_AB ^ 2 := by
        field_simp [hIB_zero]
        ring
      linarith
  have h_all_x : ∀ x : ℝ,
      (∀ ℓ : ℕ, |greenIterKernel κ (w : ℝ → ℝ) ℓ x x| ≤ (1 / (2 * κ)) * r ^ ℓ) ∧
      ((greenIterKernel κ (w : ℝ → ℝ) 1 x x) ^ 2 ≤
        (1 / (2 * κ)) * greenIterKernel κ (w : ℝ → ℝ) 2 x x) ∧
      (∀ m : ℕ, |greenIterKernel κ (w : ℝ → ℝ) (m + 2) x x| ≤
        r ^ m * greenIterKernel κ (w : ℝ → ℝ) 2 x x) := by
    intro x
    let A : ℕ → ℝ → ℝ := fun ℓ ξ => ‖iterWavePacket κ (w : ℝ → ℝ) ℓ x ξ‖
    let E : ℕ → ℝ := fun ℓ => (1 / (2 * π)) * ∫ ξ : ℝ, A ℓ ξ ^ 2 / (κ ^ 2 + ξ ^ 2)
    have hA_cont : ∀ ℓ : ℕ, Continuous (A ℓ) := fun ℓ => (h_pkt_all ℓ x).1.norm
    have hA_bound : ∀ ℓ : ℕ, ∃ M : ℝ, 0 ≤ M ∧ ∀ ξ : ℝ, |A ℓ ξ| ≤ M := by
      intro ℓ
      obtain ⟨M, hM, hM_le⟩ := (h_pkt_all ℓ x).2.1
      refine ⟨M, hM, fun ξ => ?_⟩
      dsimp [A]
      rw [abs_of_nonneg (norm_nonneg _)]
      exact hM_le ξ
    have hE_nn : ∀ ℓ : ℕ, 0 ≤ E ℓ := by
      intro ℓ
      dsimp [E]
      exact mul_nonneg (by positivity)
        (integral_nonneg (fun ξ => div_nonneg (sq_nonneg _) (le_of_lt (h_denom_pos ξ))))
    have hE0 : E 0 = 1 / (2 * κ) := by
      dsimp [E, A, iterWavePacket]
      have h_norm0 : ∀ ξ : ℝ, ‖Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I)‖ ^ 2 = 1 := by
        intro ξ
        rw [show -((ξ : ℂ) * (x : ℂ)) * I = (((-(ξ * x) : ℝ) : ℂ) * I) by push_cast; ring,
