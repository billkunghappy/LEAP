            push_cast; ring
          rw [h_mul, h_iter_eq ℓ z, mul_assoc, ← integral_mul_const]
          congr 1
          refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
          dsimp only [G]
