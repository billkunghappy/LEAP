    let cK1 : ℝ → ℝ := fun y => -w2 y + 2 * (w0 y) ^ 2 - 2 * κ₀ ^ 2 * w0 y - 4 * κ₀ ^ 4
    let cK2 : ℝ → ℝ := fun y => 2 * w1 y
    let cK3 : ℝ → ℝ := fun y => 2 * (w0 y - 2 * κ₀ ^ 2)
    let K : (ℝ → ℝ) → (ℝ → ℝ) → ℝ → ℝ := fun G DG y =>
      cK1 y * (G y) ^ 2 + cK2 y * G y * DG y - cK3 y * (DG y) ^ 2
    have hK_deriv : ∀ (G DG : ℝ → ℝ) (y : ℝ),
        HasDerivAt G (DG y) y →
        HasDerivAt DG ((κ₀ ^ 2 + w0 y) * G y) y →
        HasDerivAt (K G DG) (G y * kdvRHS w0 y * G y) y := by
      intro G DG y hG hDG
      have hw0 := hw0_d y
      have hw1 := hw1_d y
      have hw2 := hw2_d y
      have hd_c1 : HasDerivAt cK1 (-w3 y + 2 * (2 * w0 y ^ 1 * w1 y) - 2 * κ₀ ^ 2 * w1 y) y :=
