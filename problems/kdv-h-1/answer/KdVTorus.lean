theorem blochFloquet_kernel_tsum_boundT (κ : ℝ) (hκ : 1 ≤ κ) :
    (∀ ξ : ℝ,
      Summable (fun m : ℤ => 1 / (κ ^ 2 + (ξ - 2 * π * m) ^ 2)) ∧
      (∑' m : ℤ, 1 / (κ ^ 2 + (ξ - 2 * π * m) ^ 2)) ≤ 41 / κ) ∧
    (∀ (η : ℝ) (c : ℤ → ℝ),
      (∀ n : ℤ, 0 ≤ c n) → Summable c →
      Summable (fun m : ℤ =>
        (1 / (κ ^ 2 + (η + 2 * π * m) ^ 2)) *
          (∑' n : ℤ, c n / (κ ^ 2 + (η + 2 * π * (m - n)) ^ 2))) ∧
      (∑' m : ℤ,
        (1 / (κ ^ 2 + (η + 2 * π * m) ^ 2)) *
          (∑' n : ℤ, c n / (κ ^ 2 + (η + 2 * π * (m - n)) ^ 2))) ≤
        (169 / κ) * ∑' n : ℤ, c n / (4 * κ ^ 2 + (2 * π * n) ^ 2)) :=
by
  have hκ_pos : 0 < κ := by linarith
  have hκ_ne : κ ≠ 0 := ne_of_gt hκ_pos
  have hpi_pos : 0 < π := Real.pi_pos
  have hpi_ne : π ≠ 0 := ne_of_gt hpi_pos
  have hpi_lt : π < 3.15 := Real.pi_lt_d2
  have h_denom_pos : ∀ u : ℝ, 0 < κ ^ 2 + u ^ 2 := fun u => by positivity
  have h_single_add : ∀ η : ℝ,
      Summable (fun m : ℤ => 1 / (κ ^ 2 + (η + 2 * π * m) ^ 2)) ∧
      (∑' m : ℤ, 1 / (κ ^ 2 + (η + 2 * π * m) ^ 2)) ≤ (4 * π ^ 2 + 1) / κ := by
    intro η
    let F : ℝ → ℝ := fun t => (1 / (2 * π * κ)) * Real.arctan ((η + 2 * π * t) / κ)
    let F' : ℝ → ℝ := fun t => 1 / (κ ^ 2 + (η + 2 * π * t) ^ 2)
    have hF_deriv : ∀ t : ℝ, HasDerivAt F (F' t) t := by
      intro t
      have h_lin : HasDerivAt (fun x : ℝ => (η + 2 * π * x) / κ) (2 * π / κ) t := by
        have h1 : HasDerivAt (fun x : ℝ => η + 2 * π * x) (0 + 2 * π * 1) t :=
          (hasDerivAt_const t η).add ((hasDerivAt_id t).const_mul (2 * π))
        have h2 := h1.div_const κ
        convert h2 using 1
        ring
      have h_arc := (h_lin.arctan).const_mul (1 / (2 * π * κ))
      convert h_arc using 1
      dsimp [F']
      have h_pos : κ ^ 2 + (η + 2 * π * t) ^ 2 ≠ 0 := ne_of_gt (h_denom_pos _)
      field_simp
    have h_mvt : ∀ m : ℤ,
        0 ≤ F ((m : ℝ) + 1) - F (m : ℝ) ∧
        1 / (κ ^ 2 + (η + 2 * π * m) ^ 2) ≤
          (8 * π ^ 2 + 2) * (F ((m : ℝ) + 1) - F (m : ℝ)) := by
      intro m
      have h_lt : (m : ℝ) < (m : ℝ) + 1 := lt_add_one (m : ℝ)
      have hF_cont : ContinuousOn F (Set.Icc (m : ℝ) ((m : ℝ) + 1)) :=
        fun x _ => (hF_deriv x).continuousAt.continuousWithinAt
      have hF_oo : ∀ x ∈ Set.Ioo (m : ℝ) ((m : ℝ) + 1), HasDerivAt F (F' x) x :=
        fun x _ => hF_deriv x
      obtain ⟨c, hc, hc_eq⟩ := exists_hasDerivAt_eq_slope F F' h_lt hF_cont hF_oo
      have h_sub_one : ((m : ℝ) + 1) - (m : ℝ) = 1 := by ring
      rw [h_sub_one, div_one] at hc_eq
      have hFc_pos : 0 < F' c := by
        dsimp [F']
        exact one_div_pos.mpr (h_denom_pos _)
      have h_diff_nn : 0 ≤ F ((m : ℝ) + 1) - F (m : ℝ) := by linarith
      refine ⟨h_diff_nn, ?_⟩
      rw [← hc_eq]
      dsimp [F']
      set u : ℝ := η + 2 * π * (m : ℝ)
      set δ : ℝ := c - (m : ℝ)
      have hδ_pos : 0 < δ := sub_pos.mpr hc.1
      have hδ_lt : δ < 1 := by
        have := hc.2
        dsimp [δ]
        linarith
      have hδ_sq : δ ^ 2 ≤ 1 := by nlinarith
      have hκ_sq : 1 ≤ κ ^ 2 := by nlinarith
      have h_c_eq : η + 2 * π * c = u + 2 * π * δ := by
        dsimp [u, δ]
        ring
      have h_quad : κ ^ 2 + (η + 2 * π * c) ^ 2 ≤ (8 * π ^ 2 + 2) * (κ ^ 2 + u ^ 2) := by
        rw [h_c_eq]
        have h_id : (8 * π ^ 2 + 2) * (κ ^ 2 + u ^ 2) - (κ ^ 2 + (u + 2 * π * δ) ^ 2) =
            κ ^ 2 + 8 * π ^ 2 * (κ ^ 2 - δ ^ 2) + (u - 2 * π * δ) ^ 2 + 8 * π ^ 2 * u ^ 2 := by
          ring
        have h_nn1 : 0 ≤ 8 * π ^ 2 * (κ ^ 2 - δ ^ 2) :=
          mul_nonneg (by positivity) (by linarith)
        have h_nn2 : 0 ≤ (u - 2 * π * δ) ^ 2 := sq_nonneg _
        have h_nn3 : 0 ≤ 8 * π ^ 2 * u ^ 2 := by positivity
        linarith
      have h_eq_rhs : (8 * π ^ 2 + 2) * (1 / (κ ^ 2 + (η + 2 * π * c) ^ 2)) =
          (8 * π ^ 2 + 2) / (κ ^ 2 + (η + 2 * π * c) ^ 2) := mul_one_div _ _
      rw [h_eq_rhs, div_le_div_iff₀ (h_denom_pos u) (h_denom_pos (η + 2 * π * c))]
      linarith
    have hF_sub_le : ∀ a b : ℝ, F b - F a ≤ 1 / (2 * κ) := by
      intro a b
      have hb := Real.arctan_lt_pi_div_two ((η + 2 * π * b) / κ)
      have ha := Real.neg_pi_div_two_lt_arctan ((η + 2 * π * a) / κ)
      have h_arc_diff : Real.arctan ((η + 2 * π * b) / κ) - Real.arctan ((η + 2 * π * a) / κ) ≤ π := by
        linarith
      have h_mul : (1 / (2 * π * κ)) *
          (Real.arctan ((η + 2 * π * b) / κ) - Real.arctan ((η + 2 * π * a) / κ)) ≤
          (1 / (2 * π * κ)) * π :=
        mul_le_mul_of_nonneg_left h_arc_diff (by positivity)
      calc F b - F a
        _ = (1 / (2 * π * κ)) *
              (Real.arctan ((η + 2 * π * b) / κ) - Real.arctan ((η + 2 * π * a) / κ)) := by
            dsimp [F]; ring
        _ ≤ (1 / (2 * π * κ)) * π := h_mul
        _ = 1 / (2 * κ) := by
            field_simp
    have h_sum_le : ∀ s : Finset ℤ,
        (∑ m ∈ s, 1 / (κ ^ 2 + (η + 2 * π * m) ^ 2)) ≤ (4 * π ^ 2 + 1) / κ := by
      intro s
      let N : ℕ := s.sup (fun m : ℤ => m.natAbs)
      let emb : ℕ ↪ ℤ := ⟨fun k : ℕ => -(N : ℤ) + (k : ℤ), fun k₁ k₂ h => by
        dsimp at h
        omega⟩
      have hs_sub : s ⊆ (Finset.range (2 * N + 1)).map emb := by
        intro m hm
        have hm_abs : m.natAbs ≤ N := Finset.le_sup (f := fun m : ℤ => m.natAbs) hm
        rw [Finset.mem_map]
        refine ⟨(m + (N : ℤ)).toNat, ?_, ?_⟩
        · rw [Finset.mem_range]
          omega
        · dsimp [emb]
          omega
      have h_sub_sum :
          (∑ m ∈ s, (F ((m : ℝ) + 1) - F (m : ℝ))) ≤
            ∑ m ∈ (Finset.range (2 * N + 1)).map emb, (F ((m : ℝ) + 1) - F (m : ℝ)) :=
        Finset.sum_le_sum_of_subset_of_nonneg hs_sub (fun m _ _ => (h_mvt m).1)
      let g : ℕ → ℝ := fun k => F (-(N : ℝ) + (k : ℝ))
      have h_map_sum :
          (∑ m ∈ (Finset.range (2 * N + 1)).map emb, (F ((m : ℝ) + 1) - F (m : ℝ))) =
            ∑ k ∈ Finset.range (2 * N + 1), (g (k + 1) - g k) := by
        rw [Finset.sum_map]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        dsimp [emb, g]
        congr 1 <;> (congr 1; push_cast; ring)
      have h_tele : (∑ k ∈ Finset.range (2 * N + 1), (g (k + 1) - g k)) = g (2 * N + 1) - g 0 :=
        Finset.sum_range_sub g (2 * N + 1)
      have h_F_sum_le : (∑ m ∈ s, (F ((m : ℝ) + 1) - F (m : ℝ))) ≤ 1 / (2 * κ) := by
        calc (∑ m ∈ s, (F ((m : ℝ) + 1) - F (m : ℝ)))
          _ ≤ ∑ m ∈ (Finset.range (2 * N + 1)).map emb, (F ((m : ℝ) + 1) - F (m : ℝ)) := h_sub_sum
          _ = ∑ k ∈ Finset.range (2 * N + 1), (g (k + 1) - g k) := h_map_sum
          _ = g (2 * N + 1) - g 0 := h_tele
          _ ≤ 1 / (2 * κ) := hF_sub_le _ _
      calc (∑ m ∈ s, 1 / (κ ^ 2 + (η + 2 * π * m) ^ 2))
        _ ≤ ∑ m ∈ s, (8 * π ^ 2 + 2) * (F ((m : ℝ) + 1) - F (m : ℝ)) :=
            Finset.sum_le_sum (fun m _ => (h_mvt m).2)
