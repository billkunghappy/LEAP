  refine ⟨?_, ?_⟩
  · intro t κ hκ
    have hκ_ge1 : 1 ≤ κ := le_trans hκ₀ hκ
    have hκ_nonneg : 0 ≤ κ := by linarith
    have h_sq : δ' ^ 2 ≤ δ ^ 2 := pow_le_pow_left₀ (le_of_lt hδ') hδ'_le_δ 2
    exact le_trans (h_trapped κ hκ t) (mul_le_mul_of_nonneg_right h_sq hκ_nonneg)
