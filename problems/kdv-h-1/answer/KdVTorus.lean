          (4 / 3) ^ 2 * ((1 / (2 * κ)) * E ℓ) := by
      calc (Real.exp (-μ * (y - x)) * greenIterKernel κ (w : ℝ → ℝ) ℓ x y) ^ 2
        _ = |Real.exp (-μ * (y - x)) * greenIterKernel κ (w : ℝ → ℝ) ℓ x y| ^ 2 := (sq_abs _).symm
        _ ≤ ((4 / 3) * ((1 / (2 * π)) * ∫ ξ : ℝ, A ℓ ξ / (κ ^ 2 + ξ ^ 2))) ^ 2 :=
