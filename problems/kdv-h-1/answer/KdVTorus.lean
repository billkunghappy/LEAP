      field_simp
      ring
    have h_fg_int1 : ∀ y : ℝ, Integrable (fun z : ℝ => freeGreenKernel κ y z) volume ∧
        (∫ z : ℝ, freeGreenKernel κ y z) = 1 / κ ^ 2 := by
