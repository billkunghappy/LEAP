      have h_u0_upper : κ * alphaFunctionalT κ (u 0 : ℝ → ℝ) ≤ c₂ * f 0 :=
        (h_quad κ hκ_ge1 (u 0) hu0_δ₁).2
      have h_eq : κ * alphaFunctionalT κ (u t : ℝ → ℝ) = κ * alphaFunctionalT κ (u 0 : ℝ → ℝ) := by
        rw [h_cons_κ]
