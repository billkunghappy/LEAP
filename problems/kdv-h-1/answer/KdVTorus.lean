        refine (((hd1.mul hG2).add hd2).sub hd3).congr_deriv ?_
        dsimp [cΨ1, cΨ2, cΨ3]
        rw [hgκ_ode' y]
        exact h_ode_ring (w0 y) (w1 y) (k0 y) (k1 y) (k2 y) (G y) (DG y)
      have h_Φ : HasDerivAt (Φ_drift G DG) (w1 y * (G y) ^ 2) y := by
        have hd1 : HasDerivAt (fun y' => cΦ1 y' * (G y') ^ 2)
