  have h_int_eq_Ψ :
      (fun z : ℝ => -∫ y : ℝ, greenKernel κ (q : ℝ → ℝ) z y * (v : ℝ → ℝ) y * greenKernel κ (q : ℝ → ℝ) y z) =
