      have hs'_lt : |s' - s₀| < δ_d := lt_of_le_of_lt hs'_le hs
      have hs'_η : |s' - s₀| < η_d := lt_of_lt_of_le hs'_lt (min_le_left _ _)
      have hs'_r : |s' - s₀| ≤ r / (1 + M_v) := le_of_lt (lt_of_lt_of_le hs'_lt (min_le_right _ _))
