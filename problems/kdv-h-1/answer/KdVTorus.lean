              linarith [mul_nonneg hB hT]
            have h2 : 1 ≤ Real.exp (A * |t|) := Real.one_le_exp (by positivity)
            calc cinfSeminormT j (w₀ : ℝ → ℝ)
              _ ≤ C₀ * 1 := by linarith
              _ ≤ C₀ * Real.exp (A * |t|) := mul_le_mul_of_nonneg_left h2 hC₀
          | succ m ih_m =>
            intro t ht
            have h_gron_step := h_int_gron (fun τ => cinfSeminormT j (V (w_seq m τ) : ℝ → ℝ))
              A B C₀ t hA hB hC₀ (fun τ hτ => by
                have hτ_le_t : |τ| ≤ |t| := h_uIcc_abs t τ hτ
                have hτ_le_T : |τ| ≤ T := le_trans hτ_le_t ht
                refine ⟨h_sem_nonneg j _, ?_⟩
                calc cinfSeminormT j (V (w_seq m τ) : ℝ → ℝ)
                  _ ≤ A * cinfSeminormT j (w_seq m τ : ℝ → ℝ) + B :=
                    hAB (w_seq m τ) (fun i hi => hM_prev i hi m τ hτ_le_T)
                  _ ≤ A * (C₀ * Real.exp (A * |τ|)) + B := by
                    linarith [mul_le_mul_of_nonneg_left (ih_m τ hτ_le_T) hA])
            have h_step := hw_seq_tier m j t
            have h_Bt : B * |t| ≤ B * T := mul_le_mul_of_nonneg_left ht hB
            have h_alg : cinfSeminormT j (w₀ : ℝ → ℝ) + (C₀ * (Real.exp (A * |t|) - 1) + B * |t|) ≤
                C₀ * Real.exp (A * |t|) := by
              dsimp [C₀]
              linarith
            linarith
        refine ⟨C₀ * Real.exp (A * T), fun m t ht => ?_⟩
        calc cinfSeminormT j (w_seq m t : ℝ → ℝ)
          _ ≤ C₀ * Real.exp (A * |t|) := h_gron_m m t ht
          _ ≤ C₀ * Real.exp (A * T) :=
            mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left ht hA)) hC₀
    let B_T : ℕ → ℝ := fun j => 2 * (h_tier_bdd j).choose
    have hB_T : ∀ (m : ℕ) (t : ℝ), |t| ≤ T → ∀ (j : ℕ),
        cinfSeminormT j (q_sub (w_seq (m + 1) t) (w_seq m t) : ℝ → ℝ) ≤ B_T j := by
      intro m t ht j
      have h_m1 : cinfSeminormT j (w_seq (m + 1) t : ℝ → ℝ) ≤ (h_tier_bdd j).choose :=
        (h_tier_bdd j).choose_spec (m + 1) t ht
      have h_m0 : cinfSeminormT j (w_seq m t : ℝ → ℝ) ≤ (h_tier_bdd j).choose :=
        (h_tier_bdd j).choose_spec m t ht
      have h_tri := h_sem_sub j (w_seq (m + 1) t) (w_seq m t)
      dsimp [B_T, q_sub]
      linarith
    obtain ⟨C, hC_nonneg, hC_geom⟩ :=
      h_fact_geom B_T (M₀ * T) (L_lip * T) (by positivity) (by positivity) n
    exact ⟨C, hC_nonneg, fun m t ht =>
      hC_geom m (q_sub (w_seq (m + 1) t) (w_seq m t)) (hB_T m t ht) (h_hm1_shift m t ht)⟩

theorem cinfT_telescoping_series_limit_curve (h_sem_basic : (∀ (n : ℕ) (f : ℝ → ℝ), 0 ≤ cinfSeminormT n f) ∧
      (∀ (n : ℕ) (f : ℝ → ℝ) (B : ℝ),
        0 ≤ B → (∀ x : ℝ, |iteratedDeriv n f x| ≤ B) → cinfSeminormT n f ≤ B) ∧
      (∀ (g : CinfT) (n : ℕ) (x : ℝ),
        |iteratedDeriv n (g : ℝ → ℝ) x| ≤ cinfSeminormT n (g : ℝ → ℝ)))
    (w₀ : CinfT) (w_seq : ℕ → ℝ → CinfT)
    (hw_seq0 : ∀ t : ℝ, w_seq 0 t = w₀)
    (hw_seq_cont : ∀ m : ℕ, ∀ (n : ℕ) (t ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
      ∀ s : ℝ, |s - t| < η →
        cinfSeminormT n (fun x => (w_seq m s : ℝ → ℝ) x - (w_seq m t : ℝ → ℝ) x) < ε)
    (hw_geom : ∀ (T : ℝ), 0 ≤ T → ∀ (n : ℕ),
      ∃ C : ℝ, 0 ≤ C ∧
        ∀ (m : ℕ) (t : ℝ), |t| ≤ T →
          cinfSeminormT n (fun x => (w_seq (m + 1) t : ℝ → ℝ) x - (w_seq m t : ℝ → ℝ) x) ≤ C * (1 / 2 : ℝ) ^ m) :
    ∃ w_tilde : ℝ → CinfT,
      (∀ (n : ℕ) (t ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
        ∀ s : ℝ, |s - t| < η →
          cinfSeminormT n (fun x => (w_tilde s : ℝ → ℝ) x - (w_tilde t : ℝ → ℝ) x) < ε) ∧
      (∀ (T : ℝ), 0 ≤ T → ∀ (n : ℕ),
        ∃ C : ℝ, 0 ≤ C ∧
          ∀ (N : ℕ) (t : ℝ), |t| ≤ T →
            cinfSeminormT n (fun x => (w_seq N t : ℝ → ℝ) x - (w_tilde t : ℝ → ℝ) x) ≤ C * (1 / 2 : ℝ) ^ N) ∧
      (∀ (t : ℝ) (n : ℕ) (x : ℝ),
        Filter.Tendsto (fun N : ℕ => iteratedDeriv n (w_seq N t : ℝ → ℝ) x)
          Filter.atTop (nhds (iteratedDeriv n (w_tilde t : ℝ → ℝ) x))) :=
by
  obtain ⟨h_sem_nonneg, h_sem_le, h_pt_le⟩ := h_sem_basic
  let subCinfT : CinfT → CinfT → CinfT := fun q₁ q₂ =>
    ⟨fun x : ℝ => (q₁ : ℝ → ℝ) x - (q₂ : ℝ → ℝ) x,
      ⟨q₁.2.1.sub q₂.2.1, fun x => by dsimp; rw [q₁.2.2 x, q₂.2.2 x]⟩⟩
  let addCinfT : CinfT → CinfT → CinfT := fun q₁ q₂ =>
    ⟨fun x : ℝ => (q₁ : ℝ → ℝ) x + (q₂ : ℝ → ℝ) x,
      ⟨q₁.2.1.add q₂.2.1, fun x => by dsimp; rw [q₁.2.2 x, q₂.2.2 x]⟩⟩
  have h_iter_sub : ∀ (q₁ q₂ : CinfT) (n : ℕ) (x : ℝ),
      iteratedDeriv n (fun y => (q₁ : ℝ → ℝ) y - (q₂ : ℝ → ℝ) y) x =
        iteratedDeriv n (q₁ : ℝ → ℝ) x - iteratedDeriv n (q₂ : ℝ → ℝ) x :=
    fun q₁ q₂ n x => iteratedDeriv_sub (q₁.2.1.contDiffAt.of_le (WithTop.coe_le_coe.mpr le_top))
      (q₂.2.1.contDiffAt.of_le (WithTop.coe_le_coe.mpr le_top))
  have h_iter_add : ∀ (q₁ q₂ : CinfT) (n : ℕ) (x : ℝ),
      iteratedDeriv n (fun y => (q₁ : ℝ → ℝ) y + (q₂ : ℝ → ℝ) y) x =
        iteratedDeriv n (q₁ : ℝ → ℝ) x + iteratedDeriv n (q₂ : ℝ → ℝ) x :=
    fun q₁ q₂ n x => iteratedDeriv_add (q₁.2.1.contDiffAt.of_le (WithTop.coe_le_coe.mpr le_top))
      (q₂.2.1.contDiffAt.of_le (WithTop.coe_le_coe.mpr le_top))
  have h_s1 : ∀ (d : ℕ → CinfT),
      (∀ (n : ℕ), Summable (fun m : ℕ => cinfSeminormT n (d m : ℝ → ℝ))) →
      ∃ D : CinfT,
        ∀ (n : ℕ) (x : ℝ),
          Summable (fun m : ℕ => ‖iteratedDeriv n (d m : ℝ → ℝ) x‖) ∧
          iteratedDeriv n (D : ℝ → ℝ) x = ∑' m : ℕ, iteratedDeriv n (d m : ℝ → ℝ) x := by
    intro d h_sum
    let f : ℕ → ℝ → ℝ := fun m x => (d m : ℝ → ℝ) x
    have hf_smooth : ∀ m : ℕ, ContDiff ℝ (↑(⊤ : ℕ∞)) (f m) :=
      fun m => (d m).2.1
    let v : ℕ → ℕ → ℝ := fun n m => cinfSeminormT n (d m : ℝ → ℝ)
    have hv_sum : ∀ n : ℕ, (n : ℕ∞) ≤ (⊤ : ℕ∞) → Summable (v n) :=
      fun n _ => h_sum n
    have hv_bound : ∀ (n m : ℕ) (x : ℝ), (n : ℕ∞) ≤ (⊤ : ℕ∞) →
        ‖iteratedFDeriv ℝ n (f m) x‖ ≤ v n m := by
      intro n m x _
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs]
      exact h_pt_le (d m) n x
    let D_fun : ℝ → ℝ := fun x => ∑' m : ℕ, f m x
    have h_smooth : ContDiff ℝ (⊤ : ℕ∞) D_fun :=
      contDiff_tsum hf_smooth hv_sum hv_bound
    have h_per : Function.Periodic D_fun 1 :=
      fun x => tsum_congr (fun m => (d m).2.2 x)
    let D : CinfT := ⟨D_fun, ⟨h_smooth, h_per⟩⟩
    refine ⟨D, ?_⟩
    intro n x
    have h_norm_sum : Summable (fun m : ℕ => ‖iteratedDeriv n (d m : ℝ → ℝ) x‖) := by
      refine Summable.of_nonneg_of_le (fun m => norm_nonneg _) (fun m => ?_) (hv_sum n le_top)
      rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
      exact hv_bound n m x le_top
    have h_fderiv_sum : Summable (fun m : ℕ => iteratedFDeriv ℝ n (f m) x) :=
      Summable.of_norm_bounded (hv_sum n le_top) (fun m => hv_bound n m x le_top)
    refine ⟨h_norm_sum, ?_⟩
    change iteratedDeriv n D_fun x = ∑' m : ℕ, iteratedDeriv n (f m) x
    rw [iteratedDeriv_eq_iteratedFDeriv]
    have h_fd := iteratedFDeriv_tsum_apply hf_smooth hv_sum hv_bound (le_top : (n : ℕ∞) ≤ ⊤) x
    change iteratedFDeriv ℝ n D_fun x = ∑' m : ℕ, iteratedFDeriv ℝ n (f m) x at h_fd
    rw [h_fd, ContinuousMultilinearMap.tsum_eval h_fderiv_sum (fun _ => 1)]
    simp_rw [← iteratedDeriv_eq_iteratedFDeriv]
  have h_s2 : ∀ (w_infty : CinfT) (u : ℕ → CinfT),
      u 0 = w₀ →
      (∀ (n : ℕ) (x : ℝ),
        Summable (fun m : ℕ => ‖iteratedDeriv n (fun y => (u (m + 1) : ℝ → ℝ) y - (u m : ℝ → ℝ) y) x‖) ∧
        iteratedDeriv n (w_infty : ℝ → ℝ) x =
          iteratedDeriv n (w₀ : ℝ → ℝ) x +
            ∑' m : ℕ, iteratedDeriv n (fun y => (u (m + 1) : ℝ → ℝ) y - (u m : ℝ → ℝ) y) x) →
      (∀ (n : ℕ) (x : ℝ),
        Filter.Tendsto (fun N : ℕ => iteratedDeriv n (u N : ℝ → ℝ) x)
          Filter.atTop (nhds (iteratedDeriv n (w_infty : ℝ → ℝ) x))) ∧
      (∀ (n : ℕ) (C : ℝ), 0 ≤ C →
        (∀ m : ℕ, cinfSeminormT n (fun y => (u (m + 1) : ℝ → ℝ) y - (u m : ℝ → ℝ) y) ≤ C * (1 / 2 : ℝ) ^ m) →
        ∀ N : ℕ, cinfSeminormT n (fun y => (u N : ℝ → ℝ) y - (w_infty : ℝ → ℝ) y) ≤ (2 * C) * (1 / 2 : ℝ) ^ N) := by
    intro w_infty u hu0 h_tsum
    have h_tele : ∀ (n : ℕ) (x : ℝ) (N : ℕ),
        (∑ m ∈ Finset.range N, iteratedDeriv n (fun y => (u (m + 1) : ℝ → ℝ) y - (u m : ℝ → ℝ) y) x) =
          iteratedDeriv n (u N : ℝ → ℝ) x - iteratedDeriv n (w₀ : ℝ → ℝ) x := by
      intro n x N
      have h_congr :
          (∑ m ∈ Finset.range N, iteratedDeriv n (fun y => (u (m + 1) : ℝ → ℝ) y - (u m : ℝ → ℝ) y) x) =
          (∑ m ∈ Finset.range N, (iteratedDeriv n (u (m + 1) : ℝ → ℝ) x - iteratedDeriv n (u m : ℝ → ℝ) x)) :=
        Finset.sum_congr rfl (fun m _ => h_iter_sub (u (m + 1)) (u m) n x)
      rw [h_congr, Finset.sum_range_sub (fun m => iteratedDeriv n (u m : ℝ → ℝ) x) N, hu0]
    refine ⟨?_, ?_⟩
    · intro n x
      let δ : ℕ → ℝ := fun m => iteratedDeriv n (fun y => (u (m + 1) : ℝ → ℝ) y - (u m : ℝ → ℝ) y) x
      have hδ_sum : Summable δ := (h_tsum n x).1.of_norm
      have h_tendsto_sum :
          Filter.Tendsto (fun N : ℕ => ∑ m ∈ Finset.range N, δ m)
            Filter.atTop (nhds (∑' m : ℕ, δ m)) :=
        hδ_sum.hasSum.tendsto_sum_nat
      have h_add : Filter.Tendsto (fun N : ℕ => iteratedDeriv n (w₀ : ℝ → ℝ) x + ∑ m ∈ Finset.range N, δ m)
          Filter.atTop (nhds (iteratedDeriv n (w₀ : ℝ → ℝ) x + ∑' m : ℕ, δ m)) :=
        tendsto_const_nhds.add h_tendsto_sum
      rw [← (h_tsum n x).2] at h_add
      refine h_add.congr (fun N => ?_)
      have ht := h_tele n x N
      dsimp [δ]
      linarith
    · intro n C hC h_step N
      refine h_sem_le n (fun y => (u N : ℝ → ℝ) y - (w_infty : ℝ → ℝ) y) ((2 * C) * (1 / 2 : ℝ) ^ N)
        (by positivity) (fun x => ?_)
      let δ : ℕ → ℝ := fun m => iteratedDeriv n (fun y => (u (m + 1) : ℝ → ℝ) y - (u m : ℝ → ℝ) y) x
      have hδ_sum : Summable δ := (h_tsum n x).1.of_norm
      have h_split : (∑ m ∈ Finset.range N, δ m) + (∑' m : ℕ, δ (m + N)) = ∑' m : ℕ, δ m :=
        Summable.sum_add_tsum_nat_add N hδ_sum
      have h_diff_eq : iteratedDeriv n (fun y => (u N : ℝ → ℝ) y - (w_infty : ℝ → ℝ) y) x =
          -(∑' m : ℕ, δ (m + N)) := by
        rw [h_iter_sub (u N) w_infty n x, (h_tsum n x).2]
        have ht := h_tele n x N
        change (∑ m ∈ Finset.range N, δ m) = iteratedDeriv n (u N : ℝ → ℝ) x - iteratedDeriv n (w₀ : ℝ → ℝ) x at ht
        change (∑ m ∈ Finset.range N, δ m) + (∑' m : ℕ, δ (m + N)) =
          ∑' m : ℕ, iteratedDeriv n (fun y => (u (m + 1) : ℝ → ℝ) y - (u m : ℝ → ℝ) y) x at h_split
        linarith
      rw [h_diff_eq, ← Real.norm_eq_abs, norm_neg]
      have h_tail_norm : Summable (fun m : ℕ => ‖δ (m + N)‖) :=
        (summable_nat_add_iff N).mpr (h_tsum n x).1
      have h_tsum_norm : ‖∑' m : ℕ, δ (m + N)‖ ≤ ∑' m : ℕ, ‖δ (m + N)‖ :=
        norm_tsum_le_tsum_norm h_tail_norm
      have h_geom_sum : Summable (fun m : ℕ => (C * (1 / 2 : ℝ) ^ N) * (1 / 2 : ℝ) ^ m) :=
        summable_geometric_two.mul_left (C * (1 / 2 : ℝ) ^ N)
      have h_term_le : ∀ m : ℕ,
          ‖δ (m + N)‖ ≤ (C * (1 / 2 : ℝ) ^ N) * (1 / 2 : ℝ) ^ m := by
        intro m
        rw [Real.norm_eq_abs]
        calc |δ (m + N)|
          _ ≤ cinfSeminormT n (fun y => (u (m + N + 1) : ℝ → ℝ) y - (u (m + N) : ℝ → ℝ) y) :=
            h_pt_le (subCinfT (u (m + N + 1)) (u (m + N))) n x
          _ ≤ C * (1 / 2 : ℝ) ^ (m + N) := h_step (m + N)
          _ = (C * (1 / 2 : ℝ) ^ N) * (1 / 2 : ℝ) ^ m := by
            rw [pow_add]
            ring
      calc ‖∑' m : ℕ, δ (m + N)‖
        _ ≤ ∑' m : ℕ, ‖δ (m + N)‖ := h_tsum_norm
        _ ≤ ∑' m : ℕ, (C * (1 / 2 : ℝ) ^ N) * (1 / 2 : ℝ) ^ m :=
          Summable.tsum_le_tsum h_term_le h_tail_norm h_geom_sum
        _ = (C * (1 / 2 : ℝ) ^ N) * ∑' m : ℕ, (1 / 2 : ℝ) ^ m := tsum_mul_left
        _ = (2 * C) * (1 / 2 : ℝ) ^ N := by
          rw [tsum_geometric_two]
          ring
  let d : ℝ → ℕ → CinfT := fun t m => subCinfT (w_seq (m + 1) t) (w_seq m t)
  have h_d_sum : ∀ (t : ℝ) (n : ℕ),
      Summable (fun m : ℕ => cinfSeminormT n (d t m : ℝ → ℝ)) := by
    intro t n
    obtain ⟨C, _hC, h_step⟩ := hw_geom |t| (abs_nonneg t) n
    exact Summable.of_nonneg_of_le (fun m => h_sem_nonneg n _)
      (fun m => h_step m t le_rfl)
      (summable_geometric_two.mul_left C)
  let D : ℝ → CinfT := fun t => Classical.choose (h_s1 (d t) (h_d_sum t))
  let w_tilde : ℝ → CinfT := fun t => addCinfT w₀ (D t)
  have hw_tilde_tsum : ∀ (t : ℝ) (n : ℕ) (x : ℝ),
      Summable (fun m : ℕ => ‖iteratedDeriv n (fun y => (w_seq (m + 1) t : ℝ → ℝ) y - (w_seq m t : ℝ → ℝ) y) x‖) ∧
      iteratedDeriv n (w_tilde t : ℝ → ℝ) x =
        iteratedDeriv n (w₀ : ℝ → ℝ) x +
          ∑' m : ℕ, iteratedDeriv n (fun y => (w_seq (m + 1) t : ℝ → ℝ) y - (w_seq m t : ℝ → ℝ) y) x := by
    intro t n x
    have hD_spec := Classical.choose_spec (h_s1 (d t) (h_d_sum t)) n x
    refine ⟨hD_spec.1, ?_⟩
    have h_add : iteratedDeriv n (w_tilde t : ℝ → ℝ) x =
        iteratedDeriv n (w₀ : ℝ → ℝ) x + iteratedDeriv n (D t : ℝ → ℝ) x :=
      h_iter_add w₀ (D t) n x
    rw [h_add, hD_spec.2]
  have hw_unif : ∀ (T : ℝ), 0 ≤ T → ∀ (n : ℕ),
      ∃ C : ℝ, 0 ≤ C ∧
        ∀ (N : ℕ) (t : ℝ), |t| ≤ T →
          cinfSeminormT n (fun x => (w_seq N t : ℝ → ℝ) x - (w_tilde t : ℝ → ℝ) x) ≤ C * (1 / 2 : ℝ) ^ N := by
    intro T hT n
    obtain ⟨C, hC, h_step⟩ := hw_geom T hT n
    refine ⟨2 * C, by positivity, ?_⟩
    intro N t ht
    exact (h_s2 (w_tilde t) (fun m => w_seq m t) (hw_seq0 t) (hw_tilde_tsum t)).2
      n C hC (fun m => h_step m t ht) N
  have hw_pt : ∀ (t : ℝ) (n : ℕ) (x : ℝ),
      Filter.Tendsto (fun N : ℕ => iteratedDeriv n (w_seq N t : ℝ → ℝ) x)
        Filter.atTop (nhds (iteratedDeriv n (w_tilde t : ℝ → ℝ) x)) :=
    fun t n x => (h_s2 (w_tilde t) (fun m => w_seq m t) (hw_seq0 t) (hw_tilde_tsum t)).1 n x
  have hw_cont : ∀ (n : ℕ) (t ε : ℝ), 0 < ε → ∃ η : ℝ, 0 < η ∧
      ∀ s : ℝ, |s - t| < η →
        cinfSeminormT n (fun x => (w_tilde s : ℝ → ℝ) x - (w_tilde t : ℝ → ℝ) x) < ε := by
    intro n t ε hε
    set T : ℝ := |t| + 1
    have hT : 0 ≤ T := by positivity
    obtain ⟨C, _hC_nonneg, hC_bound⟩ := hw_unif T hT n
    have h_pow_tendsto : Filter.Tendsto (fun N : ℕ => C * (1 / 2 : ℝ) ^ N) Filter.atTop (nhds 0) := by
      simpa [mul_zero] using
        Filter.Tendsto.const_mul C
          (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (1 / 2 : ℝ) < 1))
    have h_ev_lt : ∀ᶠ N : ℕ in Filter.atTop, C * (1 / 2 : ℝ) ^ N < ε / 4 :=
      h_pow_tendsto.eventually (gt_mem_nhds (by linarith))
    obtain ⟨N, hN_lt⟩ := h_ev_lt.exists
    obtain ⟨η_N, hη_N, h_cont_N⟩ := hw_seq_cont N n t (ε / 4) (by linarith)
    refine ⟨min η_N 1, lt_min hη_N one_pos, ?_⟩
    intro s hs
    have hs_η : |s - t| < η_N := lt_of_lt_of_le hs (min_le_left _ _)
    have hs_1 : |s - t| < 1 := lt_of_lt_of_le hs (min_le_right _ _)
    have hs_T : |s| ≤ T := by
      have h_tri : |s| ≤ |s - t| + |t| := by
        simpa using abs_add_le (s - t) t
      dsimp [T]
      linarith
    have ht_T : |t| ≤ T := by
      dsimp [T]
      linarith
    have h1 : cinfSeminormT n (fun x => (w_seq N s : ℝ → ℝ) x - (w_tilde s : ℝ → ℝ) x) < ε / 4 :=
      lt_of_le_of_lt (hC_bound N s hs_T) hN_lt
    have h2 : cinfSeminormT n (fun x => (w_seq N s : ℝ → ℝ) x - (w_seq N t : ℝ → ℝ) x) < ε / 4 :=
      h_cont_N s hs_η
    have h3 : cinfSeminormT n (fun x => (w_seq N t : ℝ → ℝ) x - (w_tilde t : ℝ → ℝ) x) < ε / 4 :=
      lt_of_le_of_lt (hC_bound N t ht_T) hN_lt
    have h_le : cinfSeminormT n (fun x => (w_tilde s : ℝ → ℝ) x - (w_tilde t : ℝ → ℝ) x) ≤ 3 * ε / 4 := by
      refine h_sem_le n (fun x => (w_tilde s : ℝ → ℝ) x - (w_tilde t : ℝ → ℝ) x) (3 * ε / 4) (by linarith) (fun x => ?_)
      have h_id_eq : iteratedDeriv n (fun y => (w_tilde s : ℝ → ℝ) y - (w_tilde t : ℝ → ℝ) y) x =
          -iteratedDeriv n (fun y => (w_seq N s : ℝ → ℝ) y - (w_tilde s : ℝ → ℝ) y) x +
          iteratedDeriv n (fun y => (w_seq N s : ℝ → ℝ) y - (w_seq N t : ℝ → ℝ) y) x +
          iteratedDeriv n (fun y => (w_seq N t : ℝ → ℝ) y - (w_tilde t : ℝ → ℝ) y) x := by
        rw [h_iter_sub (w_tilde s) (w_tilde t) n x,
          h_iter_sub (w_seq N s) (w_tilde s) n x,
          h_iter_sub (w_seq N s) (w_seq N t) n x,
          h_iter_sub (w_seq N t) (w_tilde t) n x]
        ring
      have h_pt1 : |iteratedDeriv n (fun y => (w_seq N s : ℝ → ℝ) y - (w_tilde s : ℝ → ℝ) y) x| ≤
          cinfSeminormT n (fun y => (w_seq N s : ℝ → ℝ) y - (w_tilde s : ℝ → ℝ) y) :=
        h_pt_le (subCinfT (w_seq N s) (w_tilde s)) n x
      have h_pt2 : |iteratedDeriv n (fun y => (w_seq N s : ℝ → ℝ) y - (w_seq N t : ℝ → ℝ) y) x| ≤
          cinfSeminormT n (fun y => (w_seq N s : ℝ → ℝ) y - (w_seq N t : ℝ → ℝ) y) :=
        h_pt_le (subCinfT (w_seq N s) (w_seq N t)) n x
      have h_pt3 : |iteratedDeriv n (fun y => (w_seq N t : ℝ → ℝ) y - (w_tilde t : ℝ → ℝ) y) x| ≤
          cinfSeminormT n (fun y => (w_seq N t : ℝ → ℝ) y - (w_tilde t : ℝ → ℝ) y) :=
        h_pt_le (subCinfT (w_seq N t) (w_tilde t)) n x
      have h_tri1 := abs_add_le
        (-iteratedDeriv n (fun y => (w_seq N s : ℝ → ℝ) y - (w_tilde s : ℝ → ℝ) y) x +
          iteratedDeriv n (fun y => (w_seq N s : ℝ → ℝ) y - (w_seq N t : ℝ → ℝ) y) x)
        (iteratedDeriv n (fun y => (w_seq N t : ℝ → ℝ) y - (w_tilde t : ℝ → ℝ) y) x)
      have h_tri2 := abs_add_le
        (-iteratedDeriv n (fun y => (w_seq N s : ℝ → ℝ) y - (w_tilde s : ℝ → ℝ) y) x)
        (iteratedDeriv n (fun y => (w_seq N s : ℝ → ℝ) y - (w_seq N t : ℝ → ℝ) y) x)
      rw [abs_neg] at h_tri2
      rw [h_id_eq]
      linarith
    linarith
  exact ⟨w_tilde, hw_cont, hw_unif, hw_pt⟩

theorem cinfT_moving_frame_translate_hasCinfDerivAtT (h_sem_bound : ∀ (g : CinfT) (n : ℕ) (x : ℝ),
      |iteratedDeriv n (g : ℝ → ℝ) x| ≤ cinfSeminormT n (g : ℝ → ℝ))
    (w_tilde : ℝ → CinfT) (c : ℝ) :
    ∃ w : ℝ → CinfT,
      (∀ (t x : ℝ), (w t : ℝ → ℝ) x = (w_tilde t : ℝ → ℝ) (x + c * t)) ∧
      (∀ (s M : ℝ), 1 ≤ M → hm1KappaSqT M (ιT (w s)) = hm1KappaSqT M (ιT (w_tilde s))) ∧
      (∀ (s : ℝ) (v_tilde : CinfT),
        HasCinfDerivAtT w_tilde v_tilde s →
        ∃ v : CinfT,
          HasCinfDerivAtT w v s ∧
          ∀ x : ℝ, (v : ℝ → ℝ) x = (v_tilde : ℝ → ℝ) (x + c * s) + c * deriv (w s : ℝ → ℝ) x) :=
by
  have h_trans_mem : ∀ (q : CinfT) (a : ℝ), (fun x : ℝ => (q : ℝ → ℝ) (x + a)) ∈ CinfT := by
    intro q a
    refine ⟨q.2.1.comp (contDiff_id.add contDiff_const), fun x => ?_⟩
    change (q : ℝ → ℝ) (x + 1 + a) = (q : ℝ → ℝ) (x + a)
    rw [add_right_comm x 1 a]
    exact q.2.2 (x + a)
  have h_deriv_mem : ∀ (q : CinfT), deriv (q : ℝ → ℝ) ∈ CinfT := by
    intro q
    refine ⟨q.2.1.deriv', fun x => ?_⟩
    have h_per : (fun y : ℝ => (q : ℝ → ℝ) (y + 1)) = (q : ℝ → ℝ) := funext q.2.2
    rw [← deriv_comp_add_const (q : ℝ → ℝ) 1 x, h_per]
  have h_add_mem : ∀ (q₁ q₂ : CinfT), (fun x : ℝ => (q₁ : ℝ → ℝ) x + (q₂ : ℝ → ℝ) x) ∈ CinfT :=
    fun q₁ q₂ => ⟨q₁.2.1.add q₂.2.1, q₁.2.2.add q₂.2.2⟩
  have h_smul_mem : ∀ (a : ℝ) (q : CinfT), (fun x : ℝ => a * (q : ℝ → ℝ) x) ∈ CinfT :=
    fun a q => ⟨contDiff_const.mul q.2.1, fun x => by dsimp; rw [q.2.2 x]⟩
  let w : ℝ → CinfT := fun t =>
    ⟨fun x => (w_tilde t : ℝ → ℝ) (x + c * t), h_trans_mem (w_tilde t) (c * t)⟩
  have h_shift_fc : ∀ (q : CinfT) (a : ℝ) (n : ℤ),
      fourierCircle (fun x : ℝ => (q : ℝ → ℝ) (x + a)) n =
        Complex.exp (((2 * π * n * a : ℝ) : ℂ) * I) * fourierCircle (q : ℝ → ℝ) n := by
    intro q a n
    let Φ_n : ℝ → ℂ := fun x =>
      Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * ((q : ℝ → ℝ) x : ℂ)
    have hΦ_per : Function.Periodic Φ_n 1 := by
      intro x
      dsimp [Φ_n]
      have h_arg : -(((2 * π * n : ℝ) : ℂ) * ((x + 1 : ℝ) : ℂ)) * I =
          (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) + ((-n : ℤ) : ℂ) * (2 * (π : ℂ) * I) := by
        push_cast
        ring
      rw [h_arg, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I (-n), mul_one, q.2.2 x]
    have h_integrand : (fun x : ℝ =>
        Complex.exp (-(((2 * π * n : ℝ) : ℂ) * (x : ℂ)) * I) * ((q : ℝ → ℝ) (x + a) : ℂ)) =
        (fun x : ℝ => Complex.exp (((2 * π * n * a : ℝ) : ℂ) * I) * Φ_n (x + a)) := by
      ext x
      dsimp [Φ_n]
      rw [← mul_assoc, ← Complex.exp_add]
      congr 2
      push_cast
      ring
    unfold fourierCircle
    rw [h_integrand, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_comp_add_right Φ_n a, zero_add, add_comm (1 : ℝ) a,
        hΦ_per.intervalIntegral_add_eq a 0, zero_add]
  have h_prof_norm : ∀ (q : CinfT) (a : ℝ) (n : ℤ),
      ‖hm1ProfileT (fun x : ℝ => (q : ℝ → ℝ) (x + a)) n‖ = ‖hm1ProfileT (q : ℝ → ℝ) n‖ := by
    intro q a n
    unfold hm1ProfileT
    rw [h_shift_fc q a n, norm_mul, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul, norm_mul]
  have h_toHm1T_norm : ∀ (q : CinfT) (a : ℝ) (n : ℤ),
      ‖(toHm1T ⟨fun x : ℝ => (q : ℝ → ℝ) (x + a), h_trans_mem q a⟩ : lp (fun _ : ℤ => ℂ) 2) n‖ =
        ‖(toHm1T q : lp (fun _ : ℤ => ℂ) 2) n‖ := by
    intro q a n
    let q_trans : CinfT := ⟨fun x : ℝ => (q : ℝ → ℝ) (x + a), h_trans_mem q a⟩
    have h_p_pos : (0 : ℝ) < (2 : ENNReal).toReal := by norm_num
    have h_mem_iff : Memℓp (hm1ProfileT (q_trans : ℝ → ℝ)) 2 ↔ Memℓp (hm1ProfileT (q : ℝ → ℝ)) 2 := by
      rw [memℓp_gen_iff h_p_pos, memℓp_gen_iff h_p_pos]
      have h_eq_fn : (fun m : ℤ => ‖hm1ProfileT (q_trans : ℝ → ℝ) m‖ ^ (2 : ENNReal).toReal) =
          (fun m : ℤ => ‖hm1ProfileT (q : ℝ → ℝ) m‖ ^ (2 : ENNReal).toReal) := by
        ext m
        change ‖hm1ProfileT (fun x : ℝ => (q : ℝ → ℝ) (x + a)) m‖ ^ (2 : ENNReal).toReal = _
        rw [h_prof_norm q a m]
      rw [h_eq_fn]
    by_cases h_mem : Memℓp (hm1ProfileT (q : ℝ → ℝ)) 2
    · have h_mem_trans : Memℓp (hm1ProfileT (q_trans : ℝ → ℝ)) 2 := h_mem_iff.mpr h_mem
      change ‖(toHm1T q_trans : lp (fun _ : ℤ => ℂ) 2) n‖ = ‖(toHm1T q : lp (fun _ : ℤ => ℂ) 2) n‖
      unfold toHm1T
      rw [dif_pos h_mem_trans, dif_pos h_mem]
      exact h_prof_norm q a n
    · have h_nmem_trans : ¬ Memℓp (hm1ProfileT (q_trans : ℝ → ℝ)) 2 :=
        fun h => h_mem (h_mem_iff.mp h)
      change ‖(toHm1T q_trans : lp (fun _ : ℤ => ℂ) 2) n‖ = ‖(toHm1T q : lp (fun _ : ℤ => ℂ) 2) n‖
      unfold toHm1T
      rw [dif_neg h_nmem_trans, dif_neg h_mem]
  have h_iter_trans : ∀ (n : ℕ) (f : ℝ → ℝ) (a x : ℝ),
      iteratedDeriv n (fun z : ℝ => f (z + a)) x = iteratedDeriv n f (x + a) :=
    fun n f a x => congr_fun (iteratedDeriv_comp_add_const n f a) x
  have h_iter_deriv : ∀ (n : ℕ) (f : ℝ → ℝ) (x : ℝ),
      iteratedDeriv n (deriv f) x = iteratedDeriv (n + 1) f x :=
    fun n f x => congr_fun (@iteratedDeriv_succ' ℝ _ ℝ _ _ n f).symm x
  have h_cdAt : ∀ (q : CinfT) (n : ℕ) (x : ℝ), ContDiffAt ℝ n (q : ℝ → ℝ) x :=
    fun q n x => (q.2.1.of_le (WithTop.coe_le_coe.mpr le_top)).contDiffAt
  have h_iter_add : ∀ (q₁ q₂ : CinfT) (n : ℕ) (x : ℝ),
      iteratedDeriv n (fun z : ℝ => (q₁ : ℝ → ℝ) z + (q₂ : ℝ → ℝ) z) x =
        iteratedDeriv n (q₁ : ℝ → ℝ) x + iteratedDeriv n (q₂ : ℝ → ℝ) x :=
    fun q₁ q₂ n x => iteratedDeriv_add (h_cdAt q₁ n x) (h_cdAt q₂ n x)
  have h_iter_sub : ∀ (q₁ q₂ : CinfT) (n : ℕ) (x : ℝ),
      iteratedDeriv n (fun z : ℝ => (q₁ : ℝ → ℝ) z - (q₂ : ℝ → ℝ) z) x =
        iteratedDeriv n (q₁ : ℝ → ℝ) x - iteratedDeriv n (q₂ : ℝ → ℝ) x :=
    fun q₁ q₂ n x => iteratedDeriv_sub (h_cdAt q₁ n x) (h_cdAt q₂ n x)
  have h_iter_smul : ∀ (a : ℝ) (q : CinfT) (n : ℕ) (x : ℝ),
      iteratedDeriv n (fun z : ℝ => a * (q : ℝ → ℝ) z) x =
        a * iteratedDeriv n (q : ℝ → ℝ) x :=
    fun a q n x => iteratedDeriv_const_mul (h_cdAt q n x) a
  have h_sem_nn : ∀ (q : CinfT) (m : ℕ), 0 ≤ cinfSeminormT m (q : ℝ → ℝ) :=
    fun q m => le_trans (abs_nonneg _) (h_sem_bound q m 0)
  have h_uIcc_abs : ∀ (a τ : ℝ), τ ∈ Set.uIcc 0 a → |τ| ≤ |a| := by
    intro a τ hτ
    rcases Set.mem_uIcc.mp hτ with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · rw [abs_of_nonneg h1, abs_of_nonneg (le_trans h1 h2)]
      exact h2
    · rw [abs_of_nonpos h2, abs_of_nonpos (le_trans h1 h2)]
      exact neg_le_neg h1
  have h_deriv_iter : ∀ (q : CinfT) (m : ℕ) (y τ : ℝ),
      HasDerivAt (fun t : ℝ => iteratedDeriv m (q : ℝ → ℝ) (y + t))
        (iteratedDeriv (m + 1) (q : ℝ → ℝ) (y + τ)) τ := by
    intro q m y τ
    have h_cd : ContDiff ℝ ((m + 1 : ℕ) : WithTop ℕ∞) (q : ℝ → ℝ) :=
      q.2.1.of_le (WithTop.coe_le_coe.mpr le_top)
    have h_diff : DifferentiableAt ℝ (iteratedDeriv m (q : ℝ → ℝ)) (y + τ) :=
      (h_cd.differentiable_iteratedDeriv m (by norm_cast; omega)).differentiableAt
    have hd := h_diff.hasDerivAt
    rw [← iteratedDeriv_succ] at hd
    have h_add : HasDerivAt (fun t : ℝ => y + t) 1 τ := by
      simpa using (hasDerivAt_id τ).const_add y
    simpa using hd.comp τ h_add
  have h_mvt_sub : ∀ (q : CinfT) (m : ℕ) (y a : ℝ),
      |iteratedDeriv m (q : ℝ → ℝ) (y + a) - iteratedDeriv m (q : ℝ → ℝ) y| ≤
        cinfSeminormT (m + 1) (q : ℝ → ℝ) * |a| := by
    intro q m y a
    let ψ : ℝ → ℝ := fun τ => iteratedDeriv m (q : ℝ → ℝ) (y + τ)
    let ψ' : ℝ → ℝ := fun τ => iteratedDeriv (m + 1) (q : ℝ → ℝ) (y + τ)
    have h_hasDeriv : ∀ τ ∈ Set.uIcc 0 a, HasDerivWithinAt ψ (ψ' τ) (Set.uIcc 0 a) τ :=
      fun τ _ => (h_deriv_iter q m y τ).hasDerivWithinAt
    have h_bound : ∀ τ ∈ Set.uIcc 0 a, ‖ψ' τ‖ ≤ cinfSeminormT (m + 1) (q : ℝ → ℝ) := by
      intro τ _
      change |iteratedDeriv (m + 1) (q : ℝ → ℝ) (y + τ)| ≤ cinfSeminormT (m + 1) (q : ℝ → ℝ)
      exact h_sem_bound q (m + 1) (y + τ)
    have h_mvt := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
      h_hasDeriv h_bound (convex_uIcc 0 a) Set.left_mem_uIcc Set.right_mem_uIcc
    have h_lhs : ‖ψ a - ψ 0‖ = |iteratedDeriv m (q : ℝ → ℝ) (y + a) - iteratedDeriv m (q : ℝ → ℝ) y| := by
      change |iteratedDeriv m (q : ℝ → ℝ) (y + a) - iteratedDeriv m (q : ℝ → ℝ) (y + 0)| = _
      rw [add_zero]
    have h_rhs : cinfSeminormT (m + 1) (q : ℝ → ℝ) * ‖a - 0‖ =
        cinfSeminormT (m + 1) (q : ℝ → ℝ) * |a| := by
      rw [sub_zero, Real.norm_eq_abs]
    linarith
  have h_mvt_taylor : ∀ (q : CinfT) (n : ℕ) (y a : ℝ),
      |iteratedDeriv n (q : ℝ → ℝ) (y + a) - iteratedDeriv n (q : ℝ → ℝ) y -
        a * iteratedDeriv (n + 1) (q : ℝ → ℝ) y| ≤
        cinfSeminormT (n + 2) (q : ℝ → ℝ) * |a| ^ 2 := by
    intro q n y a
    let Φ : ℝ → ℝ := fun τ =>
      iteratedDeriv n (q : ℝ → ℝ) (y + τ) - iteratedDeriv n (q : ℝ → ℝ) y -
        τ * iteratedDeriv (n + 1) (q : ℝ → ℝ) y
    let Φ' : ℝ → ℝ := fun τ =>
      iteratedDeriv (n + 1) (q : ℝ → ℝ) (y + τ) - iteratedDeriv (n + 1) (q : ℝ → ℝ) y
    have h_hasDeriv : ∀ τ ∈ Set.uIcc 0 a, HasDerivWithinAt Φ (Φ' τ) (Set.uIcc 0 a) τ := by
      intro τ _
      have hd1 := (h_deriv_iter q n y τ).sub (hasDerivAt_const τ (iteratedDeriv n (q : ℝ → ℝ) y))
      have hd2 : HasDerivAt (fun t : ℝ => t * iteratedDeriv (n + 1) (q : ℝ → ℝ) y)
          (iteratedDeriv (n + 1) (q : ℝ → ℝ) y) τ := by
        simpa using (hasDerivAt_id τ).mul_const (iteratedDeriv (n + 1) (q : ℝ → ℝ) y)
      have hd3 := hd1.sub hd2
      rw [sub_zero] at hd3
      exact hd3.hasDerivWithinAt
    have h_bound : ∀ τ ∈ Set.uIcc 0 a, ‖Φ' τ‖ ≤ cinfSeminormT (n + 2) (q : ℝ → ℝ) * |a| := by
      intro τ hτ
      have h_step : ‖Φ' τ‖ ≤ cinfSeminormT (n + 2) (q : ℝ → ℝ) * |τ| := by
        change |iteratedDeriv (n + 1) (q : ℝ → ℝ) (y + τ) - iteratedDeriv (n + 1) (q : ℝ → ℝ) y| ≤ _
        exact h_mvt_sub q (n + 1) y τ
      exact le_trans h_step (mul_le_mul_of_nonneg_left (h_uIcc_abs a τ hτ) (h_sem_nn q (n + 2)))
    have h_mvt := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
      h_hasDeriv h_bound (convex_uIcc 0 a) Set.left_mem_uIcc Set.right_mem_uIcc
    have h_lhs : ‖Φ a - Φ 0‖ =
        |iteratedDeriv n (q : ℝ → ℝ) (y + a) - iteratedDeriv n (q : ℝ → ℝ) y -
          a * iteratedDeriv (n + 1) (q : ℝ → ℝ) y| := by
      have h0 : Φ 0 = 0 := by
        dsimp [Φ]
        rw [add_zero, sub_self, zero_mul, sub_zero]
      rw [h0, sub_zero, Real.norm_eq_abs]
    have h_rhs : (cinfSeminormT (n + 2) (q : ℝ → ℝ) * |a|) * ‖a - 0‖ =
        cinfSeminormT (n + 2) (q : ℝ → ℝ) * |a| ^ 2 := by
      rw [sub_zero, Real.norm_eq_abs]
      ring
    linarith
  refine ⟨w, fun t x => rfl, ?_, ?_⟩
  · intro s M _hM
    unfold hm1KappaSqT ιT
    refine tsum_congr (fun n => ?_)
    change ((4 + (2 * π * n) ^ 2) / (4 * M ^ 2 + (2 * π * n) ^ 2)) *
        ‖(toHm1T (w s) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2 =
      ((4 + (2 * π * n) ^ 2) / (4 * M ^ 2 + (2 * π * n) ^ 2)) *
        ‖(toHm1T (w_tilde s) : lp (fun _ : ℤ => ℂ) 2) n‖ ^ 2
    rw [h_toHm1T_norm (w_tilde s) (c * s) n]
  · intro s v_tilde hw
    let v₁ : CinfT := ⟨fun x => (v_tilde : ℝ → ℝ) (x + c * s), h_trans_mem v_tilde (c * s)⟩
    let d_ws : CinfT := ⟨deriv (w s : ℝ → ℝ), h_deriv_mem (w s)⟩
    let v₂ : CinfT := ⟨fun x => c * (d_ws : ℝ → ℝ) x, h_smul_mem c d_ws⟩
    let v : CinfT := ⟨fun x => (v₁ : ℝ → ℝ) x + (v₂ : ℝ → ℝ) x, h_add_mem v₁ v₂⟩
    refine ⟨v, ?_, fun _ => rfl⟩
    intro n ε hε
    obtain ⟨η₁, hη₁_pos, hη₁⟩ := hw n (ε / 3) (by positivity)
    let M₁ := cinfSeminormT (n + 1) (v_tilde : ℝ → ℝ)
    let M₂ := cinfSeminormT (n + 2) (w_tilde s : ℝ → ℝ)
    have hM₁_nn : 0 ≤ M₁ := h_sem_nn v_tilde (n + 1)
    have hM₂_nn : 0 ≤ M₂ := h_sem_nn (w_tilde s) (n + 2)
    have h_den₁_pos : 0 < M₁ * |c| + 1 := by positivity
    have h_den₂_pos : 0 < M₂ * c ^ 2 + 1 := by positivity
    let η₂ := ε / (3 * (M₁ * |c| + 1))
    let η₃ := ε / (3 * (M₂ * c ^ 2 + 1))
    have hη₂_pos : 0 < η₂ := by positivity
    have hη₃_pos : 0 < η₃ := by positivity
    let η := min η₁ (min η₂ η₃)
    refine ⟨η, lt_min hη₁_pos (lt_min hη₂_pos hη₃_pos), ?_⟩
    intro t ht x
    have ht₁ : |t - s| < η₁ := lt_of_lt_of_le ht (min_le_left _ _)
    have ht₂ : |t - s| < η₂ := lt_of_lt_of_le ht (le_trans (min_le_right _ _) (min_le_left _ _))
    have ht₃ : |t - s| < η₃ := lt_of_lt_of_le ht (le_trans (min_le_right _ _) (min_le_right _ _))
    let y := x + c * s
    let a := c * (t - s)
    have h_xct : x + c * t = y + a := by
      dsimp [y, a]
      ring
    have h_iter_v : iteratedDeriv n (v : ℝ → ℝ) x =
        iteratedDeriv n (v_tilde : ℝ → ℝ) y +
          c * iteratedDeriv (n + 1) (w_tilde s : ℝ → ℝ) y := by
      have hv_add := h_iter_add v₁ v₂ n x
      have hv₁_eq : iteratedDeriv n (v₁ : ℝ → ℝ) x = iteratedDeriv n (v_tilde : ℝ → ℝ) y :=
        h_iter_trans n (v_tilde : ℝ → ℝ) (c * s) x
      have hv₂_eq : iteratedDeriv n (v₂ : ℝ → ℝ) x =
          c * iteratedDeriv (n + 1) (w_tilde s : ℝ → ℝ) y := by
        rw [h_iter_smul c d_ws n x]
        change c * iteratedDeriv n (deriv (w s : ℝ → ℝ)) x = _
        rw [h_iter_deriv n (w s : ℝ → ℝ) x]
        change c * iteratedDeriv (n + 1) (fun z : ℝ => (w_tilde s : ℝ → ℝ) (z + c * s)) x = _
        rw [h_iter_trans (n + 1) (w_tilde s : ℝ → ℝ) (c * s) x]
      rw [hv_add, hv₁_eq, hv₂_eq]
    have h_iter_w_diff :
        iteratedDeriv n (fun z : ℝ => (w t : ℝ → ℝ) z - (w s : ℝ → ℝ) z) x =
          iteratedDeriv n (w_tilde t : ℝ → ℝ) (y + a) -
            iteratedDeriv n (w_tilde s : ℝ → ℝ) y := by
      rw [h_iter_sub (w t) (w s) n x]
      change iteratedDeriv n (fun z : ℝ => (w_tilde t : ℝ → ℝ) (z + c * t)) x -
        iteratedDeriv n (fun z : ℝ => (w_tilde s : ℝ → ℝ) (z + c * s)) x = _
      rw [h_iter_trans n (w_tilde t : ℝ → ℝ) (c * t) x,
          h_iter_trans n (w_tilde s : ℝ → ℝ) (c * s) x, h_xct]
    have h_iter_wt_diff :
        iteratedDeriv n (fun z : ℝ => (w_tilde t : ℝ → ℝ) z - (w_tilde s : ℝ → ℝ) z) (y + a) =
          iteratedDeriv n (w_tilde t : ℝ → ℝ) (y + a) -
            iteratedDeriv n (w_tilde s : ℝ → ℝ) (y + a) :=
      h_iter_sub (w_tilde t) (w_tilde s) n (y + a)
    let R₁ := iteratedDeriv n (fun z : ℝ => (w_tilde t : ℝ → ℝ) z - (w_tilde s : ℝ → ℝ) z) (y + a) -
      (t - s) * iteratedDeriv n (v_tilde : ℝ → ℝ) (y + a)
    let R₂ := (t - s) * (iteratedDeriv n (v_tilde : ℝ → ℝ) (y + a) - iteratedDeriv n (v_tilde : ℝ → ℝ) y)
    let R₃ := iteratedDeriv n (w_tilde s : ℝ → ℝ) (y + a) - iteratedDeriv n (w_tilde s : ℝ → ℝ) y -
      a * iteratedDeriv (n + 1) (w_tilde s : ℝ → ℝ) y
    have h_3term_id :
        iteratedDeriv n (fun z : ℝ => (w t : ℝ → ℝ) z - (w s : ℝ → ℝ) z) x -
          (t - s) * iteratedDeriv n (v : ℝ → ℝ) x = R₁ + R₂ + R₃ := by
      dsimp [R₁, R₂, R₃, a]
      rw [h_iter_w_diff, h_iter_wt_diff, h_iter_v]
      ring
    have hR₁_bd : |R₁| ≤ (ε / 3) * |t - s| := hη₁ t ht₁ (y + a)
    have hR₂_bd : |R₂| ≤ (ε / 3) * |t - s| := by
      dsimp [R₂]
      rw [abs_mul]
      have h_sub := h_mvt_sub v_tilde n y a
      have ha_abs : |a| = |c| * |t - s| := abs_mul c (t - s)
      rw [ha_abs] at h_sub
      have h_step1 : |t - s| * |iteratedDeriv n (v_tilde : ℝ → ℝ) (y + a) - iteratedDeriv n (v_tilde : ℝ → ℝ) y| ≤
          ((M₁ * |c|) * |t - s|) * |t - s| := by
        calc |t - s| * |iteratedDeriv n (v_tilde : ℝ → ℝ) (y + a) - iteratedDeriv n (v_tilde : ℝ → ℝ) y|
          _ ≤ |t - s| * (M₁ * (|c| * |t - s|)) := mul_le_mul_of_nonneg_left h_sub (abs_nonneg (t - s))
          _ = ((M₁ * |c|) * |t - s|) * |t - s| := by ring
      have h_step2 : (M₁ * |c|) * |t - s| ≤ ε / 3 := by
        calc (M₁ * |c|) * |t - s|
          _ ≤ (M₁ * |c| + 1) * |t - s| :=
            mul_le_mul_of_nonneg_right (by linarith) (abs_nonneg (t - s))
          _ ≤ (M₁ * |c| + 1) * η₂ :=
            mul_le_mul_of_nonneg_left (le_of_lt ht₂) (le_of_lt h_den₁_pos)
          _ = ε / 3 := by
            dsimp [η₂]
            have : M₁ * |c| + 1 ≠ 0 := ne_of_gt h_den₁_pos
            field_simp
      exact le_trans h_step1 (mul_le_mul_of_nonneg_right h_step2 (abs_nonneg (t - s)))
    have hR₃_bd : |R₃| ≤ (ε / 3) * |t - s| := by
      have h_tay := h_mvt_taylor (w_tilde s) n y a
      have ha_sq : |a| ^ 2 = c ^ 2 * |t - s| ^ 2 := by
        dsimp [a]
        rw [abs_mul, mul_pow, sq_abs]
      rw [ha_sq] at h_tay
      have h_step1 : |R₃| ≤ ((M₂ * c ^ 2) * |t - s|) * |t - s| := by
        calc |R₃| ≤ M₂ * (c ^ 2 * |t - s| ^ 2) := h_tay
          _ = ((M₂ * c ^ 2) * |t - s|) * |t - s| := by ring
      have h_step2 : (M₂ * c ^ 2) * |t - s| ≤ ε / 3 := by
        calc (M₂ * c ^ 2) * |t - s|
          _ ≤ (M₂ * c ^ 2 + 1) * |t - s| :=
            mul_le_mul_of_nonneg_right (by linarith) (abs_nonneg (t - s))
          _ ≤ (M₂ * c ^ 2 + 1) * η₃ :=
            mul_le_mul_of_nonneg_left (le_of_lt ht₃) (le_of_lt h_den₂_pos)
          _ = ε / 3 := by
            dsimp [η₃]
            have : M₂ * c ^ 2 + 1 ≠ 0 := ne_of_gt h_den₂_pos
            field_simp
      exact le_trans h_step1 (mul_le_mul_of_nonneg_right h_step2 (abs_nonneg (t - s)))
    rw [h_3term_id]
    have h_tri1 := abs_add_le (R₁ + R₂) R₃
    have h_tri2 := abs_add_le R₁ R₂
    linarith

theorem cinf_picard_moving_frame_global_curveT (h_dom1 : ∀ (Λ : ℝ), 1 ≤ Λ → ∀ (g : CinfT) (x : ℝ),
      |greenIterKernel Λ (g : ℝ → ℝ) 1 x x| ≤ (13 / (2 * Λ)) * ‖ιT g‖)
    (V : CinfT → CinfT) (M₀ L_lip : ℝ) (hM₀ : 0 ≤ M₀) (hL_lip : 0 ≤ L_lip)
    (hV_bdd : ∀ q : CinfT, ‖ιT (V q)‖ ≤ M₀)
    (hV_lip : ∀ q₁ q₂ : CinfT, ‖ιT (V q₁) - ιT (V q₂)‖ ≤ L_lip * ‖ιT q₁ - ιT q₂‖)
    (hV_tier : ∀ (n : ℕ) (M : ℕ → ℝ),
      ∃ (A B : ℝ), 0 ≤ A ∧ 0 ≤ B ∧
        ∀ q : CinfT,
          (∀ m < n, cinfSeminormT m (q : ℝ → ℝ) ≤ M m) →
          cinfSeminormT n (V q : ℝ → ℝ) ≤ A * cinfSeminormT n (q : ℝ → ℝ) + B)
    (c : ℝ) (w₀ : CinfT) :
    ∃ w : ℝ → CinfT,
      w 0 = w₀ ∧
      ∀ s : ℝ, ∃ (q_tilde : CinfT) (v : CinfT),
        (∀ x : ℝ, (w s : ℝ → ℝ) x = (q_tilde : ℝ → ℝ) (x + c * s)) ∧
        (∀ M : ℝ, 1 ≤ M → hm1KappaSqT M (ιT (w s)) = hm1KappaSqT M (ιT q_tilde)) ∧
        HasCinfDerivAtT w v s ∧
        (∀ x : ℝ, (v : ℝ → ℝ) x = (V q_tilde : ℝ → ℝ) (x + c * s) + c * deriv (w s : ℝ → ℝ) x) :=
by
  have h_iota := cinfT_iotaT_deriv_and_hm1KappaSqT_lipschitz
  have h_interp := cinfT_hm1_interpolation_and_factorial_decay h_dom1
  obtain ⟨h_int_ex, h_int_deriv, h_int_diff⟩ :=
    cinfT_time_integral_curve_exists_and_bounds ⟨h_iota.1, h_iota.2.1⟩
      ⟨h_interp.1, h_interp.2.1, h_interp.2.2.1, h_interp.2.2.2.1⟩
  obtain ⟨hV_cont, hV_tendsto, ⟨w_seq, hw_seq0, hw_seq_cont, hw_seq_int, hw_seq_geom⟩⟩ :=
    cinfT_picard_iterates_exists_and_geometric_diff_bound h_iota.1 h_interp
      ⟨h_int_ex, h_int_diff⟩ V M₀ L_lip hM₀ hL_lip hV_bdd hV_lip hV_tier w₀
  obtain ⟨w_tilde, hw_tilde_cont, hw_tilde_unif, hw_tilde_pt⟩ :=
    cinfT_telescoping_series_limit_curve ⟨h_interp.1, h_interp.2.1, h_interp.2.2.1⟩
      w₀ w_seq hw_seq0 hw_seq_cont hw_seq_geom
  have h_w_tilde_int : ∀ (t : ℝ) (n : ℕ) (x : ℝ),
      iteratedDeriv n (w_tilde t : ℝ → ℝ) x =
        iteratedDeriv n (w₀ : ℝ → ℝ) x + ∫ τ in (0 : ℝ)..t, iteratedDeriv n (V (w_tilde τ) : ℝ → ℝ) x := by
    intro t n x
    have h_lhs : Filter.Tendsto (fun N : ℕ => iteratedDeriv n (w_seq (N + 1) t : ℝ → ℝ) x)
        Filter.atTop (nhds (iteratedDeriv n (w_tilde t : ℝ → ℝ) x)) :=
      (Filter.tendsto_add_atTop_iff_nat 1).mpr (hw_tilde_pt t n x)
    have h_rhs : Filter.Tendsto (fun N : ℕ => iteratedDeriv n (w_seq (N + 1) t : ℝ → ℝ) x)
        Filter.atTop (nhds (iteratedDeriv n (w₀ : ℝ → ℝ) x +
          ∫ τ in (0 : ℝ)..t, iteratedDeriv n (V (w_tilde τ) : ℝ → ℝ) x)) := by
      have h_eq : (fun N : ℕ => iteratedDeriv n (w_seq (N + 1) t : ℝ → ℝ) x) =
          (fun N : ℕ => iteratedDeriv n (w₀ : ℝ → ℝ) x +
            ∫ τ in (0 : ℝ)..t, iteratedDeriv n (V (w_seq N τ) : ℝ → ℝ) x) :=
        funext (fun N => hw_seq_int N t n x)
      rw [h_eq]
