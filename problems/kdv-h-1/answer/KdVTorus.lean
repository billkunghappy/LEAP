theorem greenKernel_weyl_identityT (κ : ℝ) (hκ : 1 ≤ κ) (w : CinfT)
    (h_diag_bd : ∀ ℓ : ℕ, ∀ x : ℝ,
      |greenIterKernel κ (w : ℝ → ℝ) ℓ x x| ≤ (1 / (2 * κ)) * (1 / 4 : ℝ) ^ ℓ)
