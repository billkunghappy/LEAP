        intro d hd
        change |iteratedDeriv d (fun y => (u s' : ℝ → ℝ) y - (q₀ : ℝ → ℝ) y) x| ≤ η₀
        rw [h_iter_sub (u s') q₀ d x]
        exact h_uIcc s' hs' d hd x
      have h_abs1 : |iteratedDeriv n (fun y => (v : ℝ → ℝ) y - (v₁ : ℝ → ℝ) y) x| ≤
