    change (∫ ξ : ℝ, F₁ ξ) ≤ K₁ * (∫ η : ℝ, A₁ η ^ 2 / (κ ^ 2 + η ^ 2)) at h_bound_UV1
    change (∫ ξ : ℝ, F₂ ξ) ≤ K₂ * (∫ η : ℝ, A₂ η ^ 2 / (κ ^ 2 + η ^ 2)) at h_bound_UV2
    linarith [h_mono, h_add, h_bound_UV1, h_bound_UV2]
  intro r₁ r_diff
  have h_hm1_1_nn : 0 ≤ (1 / κ) * hm1KappaSqT κ (ιT q₁) := by
    rw [h_fc1.2.2.2]
    exact mul_nonneg (by positivity) (tsum_nonneg (fun n => div_nonneg (hc₁_nn n) (by positivity)))
  have h_hm1_diff_nn : 0 ≤ (1 / κ) * hm1KappaSqT κ (ιT q₁ - ιT q₂) := by
    rw [h_fc_diff.2]
    exact mul_nonneg (by positivity) (tsum_nonneg (fun n => div_nonneg (hc₂_nn n) (by positivity)))
  have hr₁_sq : r₁ ^ 2 = K₁ := by
    dsimp [r₁, K₁, c₁, b₁]
    rw [mul_pow, Real.sq_sqrt h_hm1_1_nn, h_fc1.2.2.2]
    ring
  have hr_diff_sq : r_diff ^ 2 = K₂ := by
    dsimp [r_diff, K₂, c₂, b₂]
    rw [mul_pow, Real.sq_sqrt h_hm1_diff_nn, h_fc_diff.2]
    ring
  rw [hr₁_sq, hr_diff_sq]
  calc (1 / (2 * π)) * (∫ ξ : ℝ, A_succ ξ ^ 2 / (κ ^ 2 + ξ ^ 2))
    _ ≤ (1 / (2 * π)) *
          (2 * (K₁ * (∫ η : ℝ, A₁ η ^ 2 / (κ ^ 2 + η ^ 2))) +
           2 * (K₂ * (∫ η : ℝ, A₂ η ^ 2 / (κ ^ 2 + η ^ 2)))) :=
      mul_le_mul_of_nonneg_left h_int_le (by positivity)
    _ = 2 * K₁ * ((1 / (2 * π)) * (∫ ξ : ℝ, A₁ ξ ^ 2 / (κ ^ 2 + ξ ^ 2))) +
        2 * K₂ * ((1 / (2 * π)) * (∫ ξ : ℝ, A₂ ξ ^ 2 / (κ ^ 2 + ξ ^ 2))) := by ring

theorem diagGreen_pointwise_and_diff_boundT (κ : ℝ) (hκ : 1 ≤ κ) (q₁ q₂ : CinfT)
    (hq₁ : hm1KappaSqT κ (ιT q₁) ≤ (1 / 52) ^ 2 * κ)
    (hq₂ : hm1KappaSqT κ (ιT q₂) ≤ (1 / 52) ^ 2 * κ)
    (h_G_pkt : ∀ w : CinfT, ∀ ℓ : ℕ, ∀ x : ℝ,
      (Continuous (fun z : ℝ => greenIterKernel κ (w : ℝ → ℝ) ℓ x z) ∧
        Integrable (fun z : ℝ => greenIterKernel κ (w : ℝ → ℝ) ℓ x z) volume) ∧
      Continuous (fun ξ : ℝ => iterWavePacket κ (w : ℝ → ℝ) ℓ x ξ) ∧
      (∃ M : ℝ, 0 ≤ M ∧ ∀ ξ : ℝ, ‖iterWavePacket κ (w : ℝ → ℝ) ℓ x ξ‖ ≤ M))
    (h_dom1 : ∀ ℓ : ℕ, ∀ x : ℝ,
      |greenIterKernel κ (q₁ : ℝ → ℝ) ℓ x x| ≤
        (1 / (2 * κ)) * (13 * Real.sqrt ((1 / κ) * hm1KappaSqT κ (ιT q₁))) ^ ℓ)
    (h_step2 : ∀ (x : ℝ) (ℓ : ℕ),
      (1 / (2 * π)) * (∫ ξ : ℝ, ‖iterWavePacket κ (q₂ : ℝ → ℝ) (ℓ + 1) x ξ‖ ^ 2 / (κ ^ 2 + ξ ^ 2)) ≤
        (13 * Real.sqrt ((1 / κ) * hm1KappaSqT κ (ιT q₂))) ^ 2 *
          ((1 / (2 * π)) * (∫ ξ : ℝ, ‖iterWavePacket κ (q₂ : ℝ → ℝ) ℓ x ξ‖ ^ 2 / (κ ^ 2 + ξ ^ 2))))
    (h_diff_step : ∀ (x : ℝ) (ℓ : ℕ),
