        (∀ x : ℝ, 1 / (6 * κ₀) ≤ diagGreen κ₀ (z s : ℝ → ℝ) x) ∧
        (∀ (v : ℝ → ℝ) (B_v B_Δ B_lin h : ℝ),
          Continuous v → 0 ≤ B_v → 0 ≤ B_Δ → 0 ≤ B_lin →
          (∀ y : ℝ, |v y| ≤ B_v) →
          (∀ y : ℝ, |(z τ : ℝ → ℝ) y - (z s : ℝ → ℝ) y| ≤ B_Δ) →
          (∀ y : ℝ, |(z τ : ℝ → ℝ) y - (z s : ℝ → ℝ) y - h * v y| ≤ B_lin) →
          ∀ x : ℝ,
            |diagGreen κ₀ (z τ : ℝ → ℝ) x - diagGreen κ₀ (z s : ℝ → ℝ) x -
              h * (-∫ y : ℝ, greenKernel κ₀ (z s : ℝ → ℝ) x y * v y * greenKernel κ₀ (z s : ℝ → ℝ) y x)| ≤
              16 * B_lin + 64 * B_Δ ^ 2)) →
      ∀ s : ℝ,
        Continuous (recipGreenDiffT κ₀ (z s : ℝ → ℝ)) ∧
        ∀ ε : ℝ, 0 < ε → ∃ η : ℝ, 0 < η ∧
