    have hf0_le_δ₀ : f 0 ≤ δ₀ ^ 2 * κ := by
      calc f 0 = hm1KappaSqT κ (ιT (u 0)) := rfl
        _ ≤ hm1KappaSqT κ₀ (ιT (u 0)) := (h_mono κ₀ κ hκ₀ hκ (ιT (u 0))).2
        _ ≤ δ₀ ^ 2 * κ₀ := hu0
        _ ≤ δ₀ ^ 2 * κ := mul_le_mul_of_nonneg_left hκ (sq_nonneg δ₀)
    have hf0_le_half : f 0 ≤ (δ' / 2) ^ 2 * κ := by
