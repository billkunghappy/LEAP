          (h_fg_cont.comp (continuous_id.prodMk continuous_const)).aestronglyMeasurable
      refine h_dom.mono' h_meas ?_
      filter_upwards with z
      rw [Real.norm_eq_abs, abs_mul, abs_mul]
      have h12 : |G' z| * |w₀ z| ≤ L * B_w := mul_le_mul (hG'_bd z) (hw_bd z) (abs_nonneg _) hL
