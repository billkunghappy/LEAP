by
  have hκ_pos : 0 < κ := by linarith
  have h_denom_pos : ∀ ξ : ℝ, 0 < κ ^ 2 + ξ ^ 2 := fun ξ => by positivity
  have h_inv_int : Integrable (fun ξ : ℝ => 1 / (κ ^ 2 + ξ ^ 2)) volume := by
    have h_cont : Continuous (fun ξ : ℝ => 1 / (κ ^ 2 + ξ ^ 2)) :=
      continuous_const.div (continuous_const.add (continuous_pow 2))
        (fun ξ => ne_of_gt (h_denom_pos ξ))
    refine integrable_inv_one_add_sq.mono' h_cont.aestronglyMeasurable
      (Filter.Eventually.of_forall fun ξ => ?_)
    rw [Real.norm_of_nonneg (by positivity), one_div]
    exact inv_anti₀ (by positivity) (by nlinarith)
  have h_fg_cont : Continuous (fun z : ℝ => freeGreenKernel κ z x) := by
    dsimp [freeGreenKernel]
    exact continuous_const.mul (Real.continuous_exp.comp (continuous_const.mul (continuous_id.sub continuous_const).abs))
  have h_fg_bound : ∀ z : ℝ, |freeGreenKernel κ z x| ≤ 1 / (2 * κ) := by
