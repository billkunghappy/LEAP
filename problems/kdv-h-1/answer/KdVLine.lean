      have h_xc_abs : |x - c| ≤ 1 := by
        rw [abs_of_nonneg (by linarith [hc.2])]
        linarith [hc.1]
      have h_g2_abs : |iteratedDeriv 2 f x| ≤
          |iteratedDeriv 1 f x| + |iteratedDeriv 1 f (x - 1)| + |iteratedDeriv 3 f d| := by
        have h_tri1 : |iteratedDeriv 2 f x| ≤
            |iteratedDeriv 1 f x - iteratedDeriv 1 f (x - 1)| + |(x - c) * iteratedDeriv 3 f d| := by
          rw [hg2_eq]
          exact abs_add_le _ _
        have h_tri2 : |iteratedDeriv 1 f x - iteratedDeriv 1 f (x - 1)| ≤
            |iteratedDeriv 1 f x| + |iteratedDeriv 1 f (x - 1)| := abs_sub _ _
        have h_mul_le : |(x - c) * iteratedDeriv 3 f d| ≤ |iteratedDeriv 3 f d| := by
          rw [abs_mul]
          calc |x - c| * |iteratedDeriv 3 f d|
            _ ≤ 1 * |iteratedDeriv 3 f d| := mul_le_mul_of_nonneg_right h_xc_abs (abs_nonneg _)
            _ = |iteratedDeriv 3 f d| := one_mul _
