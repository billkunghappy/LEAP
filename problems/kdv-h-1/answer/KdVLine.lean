      intro m
      induction m with
      | zero =>
        intro g
        ext y
        rw [iteratedDeriv_zero, Function.iterate_zero_apply]
      | succ m ih =>
        intro g
        ext y
        rw [iteratedDeriv_succ, ih g, ← SchwartzMap.derivCLM_apply ℝ _ y,
          ← Function.iterate_succ_apply' (SchwartzMap.derivCLM ℝ ℝ) m g]
    have h_deriv : ∀ (m : ℕ) (y : ℝ),
        HasDerivAt (iteratedDeriv m f) (iteratedDeriv (m + 1) f y) y := by
      intro m y
      rw [iteratedDeriv_succ]
      have h_sm : ContDiff ℝ (⊤ : ℕ∞) (iteratedDeriv m f) := by
        rw [h_iter_eq m f]
        exact ((SchwartzMap.derivCLM ℝ ℝ)^[m] f).smooth'
      exact (h_sm.contDiffAt.differentiableAt (by norm_num)).hasDerivAt
    have h_cont : ∀ (m : ℕ) (s : Set ℝ), ContinuousOn (iteratedDeriv m f) s :=
      fun m s y _ => (h_deriv m y).continuousAt.continuousWithinAt
    have h_rhs_nn : 0 ≤ 2 * SchwartzMap.seminorm ℝ k 1 f + SchwartzMap.seminorm ℝ k 3 f := by
      have h1 : 0 ≤ SchwartzMap.seminorm ℝ k 1 f := apply_nonneg _ _
      have h3 : 0 ≤ SchwartzMap.seminorm ℝ k 3 f := apply_nonneg _ _
