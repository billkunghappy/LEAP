      have hG_le : ∀ x y : ℝ, |greenKernel M w x y| ≤ 1 := by
        intro x y
        calc |greenKernel M w x y|
          _ = ‖∑' ℓ : ℕ, greenIterKernel M w ℓ x y‖ := by rw [Real.norm_eq_abs]; rfl
          _ ≤ ∑' ℓ : ℕ, ‖greenIterKernel M w ℓ x y‖ := norm_tsum_le_tsum_norm (h_iter_sum_norm x y)
          _ ≤ ∑' ℓ : ℕ, u_geom ℓ :=
            Summable.tsum_le_tsum (fun ℓ => by rw [Real.norm_eq_abs]; exact h_pt ℓ x y)
              (h_iter_sum_norm x y) hu_sum
          _ = 2 / (3 * M) := hu_tsum
          _ ≤ 1 := by rw [div_le_iff₀ (by positivity)]; linarith
      have h_peel_eq : ∀ a b : ℝ,
          greenKernel M w a b - freeGreenKernel M a b = ∑' m : ℕ, greenIterKernel M w (m + 1) a b := by
        intro a b
        have h0 := (h_iter_sum a b).tsum_eq_zero_add
        change greenKernel M w a b = freeGreenKernel M a b + ∑' m : ℕ, greenIterKernel M w (m + 1) a b at h0
        linarith
      have h_fg_diag : ∀ x : ℝ, freeGreenKernel M x x = 1 / (2 * M) := by
        intro x; dsimp [freeGreenKernel]; rw [sub_self, abs_zero, mul_zero, Real.exp_zero, mul_one]
      have hg_bounds : ∀ x : ℝ, 1 / (4 * M) ≤ diagGreen M w x ∧ |diagGreen M w x - 1 / (2 * M)| ≤ 1 / (6 * M) := by
        intro x
        have h_tail_sum : Summable (fun m : ℕ => ((1 / (2 * M)) * (1 / 4)) * (1 / 4 : ℝ) ^ m) :=
          h_geom_sum.mul_left _
        have h_sum_m : Summable (fun m : ℕ => greenIterKernel M w (m + 1) x x) :=
          (summable_nat_add_iff 1).mpr (h_iter_sum x x)
        have h_tail_bound : |diagGreen M w x - 1 / (2 * M)| ≤ 1 / (6 * M) := by
          have h_sub_eq : diagGreen M w x - 1 / (2 * M) = ∑' m : ℕ, greenIterKernel M w (m + 1) x x := by
            rw [← h_fg_diag x]; exact h_peel_eq x x
          calc |diagGreen M w x - 1 / (2 * M)|
            _ = ‖∑' m : ℕ, greenIterKernel M w (m + 1) x x‖ := by rw [h_sub_eq, Real.norm_eq_abs]
            _ ≤ ∑' m : ℕ, ‖greenIterKernel M w (m + 1) x x‖ := norm_tsum_le_tsum_norm h_sum_m.norm
            _ ≤ ∑' m : ℕ, ((1 / (2 * M)) * (1 / 4)) * (1 / 4 : ℝ) ^ m := by
              refine Summable.tsum_le_tsum (fun m => ?_) h_sum_m.norm h_tail_sum
              rw [Real.norm_eq_abs]
              calc |greenIterKernel M w (m + 1) x x|
                _ ≤ (1 / (2 * M)) * (1 / 4 : ℝ) ^ (m + 1) := h_pt (m + 1) x x
                _ = ((1 / (2 * M)) * (1 / 4)) * (1 / 4 : ℝ) ^ m := by ring
            _ = ((1 / (2 * M)) * (1 / 4)) * ∑' m : ℕ, (1 / 4 : ℝ) ^ m := tsum_mul_left
            _ = ((1 / (2 * M)) * (1 / 4)) * (4 / 3) := by rw [h_geom_tsum]
            _ = 1 / (6 * M) := by ring
        have h_low := (abs_le.mp h_tail_bound).1
        have h_diff : 1 / (2 * M) - 1 / (6 * M) - 1 / (4 * M) = 1 / (12 * M) := by
          field_simp [hM_ne]; ring
        have : 0 ≤ 1 / (12 * M) := by positivity
        exact ⟨by linarith, h_tail_bound⟩
      have h_peel_step : ∀ (m : ℕ) (y x : ℝ),
          |greenIterKernel M w (m + 1) y x| ≤
            ((2 * π * B / M ^ 2) * (1 + x ^ 2)⁻¹) * (1 / 4 : ℝ) ^ m := by
        intro m y x
        dsimp [greenIterKernel]
        rw [abs_neg]
        let F : ℝ → ℝ := fun z => greenIterKernel M w m y z * w z * freeGreenKernel M z x
        set C_mx : ℝ := (2 * B / M ^ 2) * (1 + x ^ 2)⁻¹ * (1 / 4 : ℝ) ^ m
        have hF_cont : Continuous F := by
          dsimp [F]
          have h1 : Continuous (fun z : ℝ => greenIterKernel M w m y z) :=
            (h_iter_cont m).comp (continuous_const.prodMk continuous_id)
          have h2 : Continuous (fun z : ℝ => freeGreenKernel M z x) :=
            h_fg_cont.comp (continuous_id.prodMk continuous_const)
          exact (h1.mul w.continuous).mul h2
        have hF_pw : ∀ z : ℝ, ‖F z‖ ≤ C_mx * (1 + z ^ 2)⁻¹ := by
          intro z
          dsimp [F]
          rw [abs_mul, abs_mul]
          have h1 := h_pt m y z
          have h2 := hw_dec z
          have h3 : |freeGreenKernel M z x| = (1 / (2 * M)) * Real.exp (-M * |z - x|) :=
            abs_of_nonneg (h_fg_pos z x)
          have h_prod12 : |greenIterKernel M w m y z| * |w z| ≤
              ((1 / (2 * M)) * (1 / 4 : ℝ) ^ m) * (B * ((1 + z ^ 2)⁻¹) ^ 2) :=
            mul_le_mul h1 h2 (abs_nonneg _) (by positivity)
          calc |greenIterKernel M w m y z| * |w z| * |freeGreenKernel M z x|
            _ = (|greenIterKernel M w m y z| * |w z|) * ((1 / (2 * M)) * Real.exp (-M * |z - x|)) := by
              rw [h3]
            _ ≤ (((1 / (2 * M)) * (1 / 4 : ℝ) ^ m) * (B * ((1 + z ^ 2)⁻¹) ^ 2)) *
                ((1 / (2 * M)) * Real.exp (-M * |z - x|)) :=
              mul_le_mul_of_nonneg_right h_prod12 (by positivity)
            _ = ((B / (4 * M ^ 2)) * (1 / 4 : ℝ) ^ m) * (((1 + z ^ 2)⁻¹) ^ 2 * Real.exp (-M * |z - x|)) := by
