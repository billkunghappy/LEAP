          (iteratedDeriv n (u s) x - iteratedDeriv n (u s₀) x -
            (ContinuousLinearMap.toSpanSingleton ℝ (iteratedDeriv n v x)) (s - s₀))) =
          (fun s : ℝ => iteratedDeriv n (Δ s) x) := by
        ext s
        dsimp [Δ]
        rw [h_iter_smul, h_iter_sub, h_iter_sub, h_iter_smul]
