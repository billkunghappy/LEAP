  let R_κ : (ℝ → ℝ) → (ℝ → ℝ) → ℝ → ℝ := fun G D_G y =>
    -(4 * κ ^ 5 / (κ ^ 2 - 1)) * Ψ_κ G D_G y + 4 * κ ^ 2 * Φ_drift G D_G y
  have hR_deriv : ∀ (G D_G : ℝ → ℝ) (y : ℝ),
