    have h_ts_cont : Continuous (fun s : ℝ => t - s) := continuous_const.sub continuous_id
    have h_comp_lim : Filter.Tendsto (fun s : ℝ => Δ_w (t - s)) (nhds s₀) (nhds 0) :=
