    rw [h_lhs, MeasureTheory.integral_integral_swap hG_int, neg_mul_eq_mul_neg, ← integral_neg]
    congr 1
    refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
    dsimp only [G]
    rw [integral_const_mul, ← mul_neg, h_conj1 ξ, div_mul_eq_mul_div]
  have h_step_eq : ∀ ℓ : ℕ, ∀ ξ : ℝ,
      iterWavePacket κ w (ℓ + 1) x ξ =
        -((Real.sqrt (2 * π))⁻¹ : ℂ) *
          ∫ η : ℝ,
            iterWavePacket κ w ℓ x η * fourierLine w (ξ - η) / ((κ ^ 2 + η ^ 2 : ℝ) : ℂ) := by
    intro ℓ ξ
    obtain ⟨h_cont_ℓ, M_ℓ, hM_ℓ_nn, hM_ℓ⟩ := h_pkt ℓ
    let J : ℝ → ℝ → ℂ := fun z η =>
      (iterWavePacket κ w ℓ x η / ((κ ^ 2 + η ^ 2 : ℝ) : ℂ)) *
