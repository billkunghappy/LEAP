theorem greenIterDerivY_diag_hasDerivAt : ∀ (κ : ℝ), 1 ≤ κ → ∀ (w : 𝓢(ℝ, ℝ)) (ℓ : ℕ) (x : ℝ),
      HasDerivAt (fun y => 2 * greenIterDerivY κ w (ℓ + 1) y y)
        (2 * κ ^ 2 * greenIterKernel κ w (ℓ + 1) x x +
          2 * w x * greenIterKernel κ w ℓ x x +
          2 * greenIterMixedDiag κ w ℓ x) x :=
by
  intro κ hκ w ℓ x
  cases ℓ with
  | zero =>
    exact greenIterDerivY_one_diag_hasDerivAt κ hκ w x
  | succ m =>
    obtain ⟨h_symm, h_off_d1, h_off_d2, h_off_bd⟩ :=
      greenIterKernel_offDiag_hasDerivAt_and_symm κ hκ w
    have hd_second : HasDerivAt (fun y => greenIterDerivY κ w (m + 2) x y)
        (κ ^ 2 * greenIterKernel κ w (m + 2) x x + w x * greenIterKernel κ w (m + 1) x x) x :=
      h_off_d2 (m + 1) x x
    have hd_first : HasDerivAt (fun y => greenIterDerivY κ w (m + 2) y x)
        (greenIterMixedDiag κ w (m + 1) x) x :=
      greenIterDerivY_succ_firstSlot_hasDerivAt κ hκ w m x
        (h_symm (m + 1)) (h_off_d1 m) (h_off_bd m)
    have hd_cross : HasDerivAt (fun y => greenIterDerivY κ w (m + 2) y y -
        greenIterDerivY κ w (m + 2) x y - greenIterDerivY κ w (m + 2) y x) 0 x :=
      greenIterDerivY_succ_cross_diff_hasDerivAt_zero κ hκ w m x
        (h_symm (m + 1)) (h_off_d1 m) (h_off_bd m)
    have hd_comb := ((hd_second.add hd_first).add hd_cross).const_mul 2
    convert hd_comb using 1
    · ext y
      simp only [Pi.add_apply]
      ring
    · ring

theorem greenIterMixedDiag_hasDerivAt : ∀ (κ : ℝ), 1 ≤ κ → ∀ (w : 𝓢(ℝ, ℝ)) (ℓ : ℕ) (x : ℝ),
