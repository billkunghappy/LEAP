        div_le_div_of_nonneg_left (by positivity) h_fact_pos h_fact_le
  have h_tier_bdd : ∀ (K : ℕ), 2 ≤ K → ∀ (j : ℕ),
      ∃ M_j : ℝ, ∀ (m : ℕ) (t : ℝ), |t| ≤ T → schwartzTierNorm K j (w_seq m t) ≤ M_j := by
    intro K hK j
    induction j using Nat.strong_induction_on with
    | h j ih =>
      let M_prev : ℕ → ℝ := fun i => if h : i < j then (ih i h).choose else 0
      have hM_prev : ∀ i < j, ∀ (m : ℕ) (t : ℝ), |t| ≤ T →
          schwartzTierNorm K i (w_seq m t) ≤ M_prev i := by
        intro i hi m t ht
        dsimp [M_prev]
        rw [dif_pos hi]
        exact (ih i hi).choose_spec m t ht
      obtain ⟨A, B, hA, hB, hAB⟩ := hV_tier K j hK M_prev
      let C₀ : ℝ := schwartzTierNorm K j w₀ + B * T
      have hC₀ : 0 ≤ C₀ := add_nonneg (h_tier_nonneg K j w₀) (mul_nonneg hB hT)
      have h_gron_m : ∀ (m : ℕ) (t : ℝ), |t| ≤ T →
          schwartzTierNorm K j (w_seq m t) ≤ C₀ * Real.exp (A * |t|) := by
        intro m
        induction m with
        | zero =>
          intro t _
          rw [hw_seq0 t]
          have h1 : schwartzTierNorm K j w₀ ≤ C₀ := by
            dsimp [C₀]
            linarith [mul_nonneg hB hT]
          have h2 : 1 ≤ Real.exp (A * |t|) := Real.one_le_exp (by positivity)
          calc schwartzTierNorm K j w₀
            _ ≤ C₀ * 1 := by linarith
            _ ≤ C₀ * Real.exp (A * |t|) := mul_le_mul_of_nonneg_left h2 hC₀
        | succ m ih_m =>
          intro t ht
          have h_gron_step := h_int_gron (fun τ => schwartzTierNorm K j (V (w_seq m τ)))
            A B C₀ t hA hB hC₀ (fun τ hτ => by
              have hτ_le_t : |τ| ≤ |t| := h_uIcc_abs t τ hτ
              have hτ_le_T : |τ| ≤ T := le_trans hτ_le_t ht
              refine ⟨h_tier_nonneg K j (V (w_seq m τ)), ?_⟩
              calc schwartzTierNorm K j (V (w_seq m τ))
                _ ≤ A * schwartzTierNorm K j (w_seq m τ) + B :=
                  hAB (w_seq m τ) (fun i hi => hM_prev i hi m τ hτ_le_T)
                _ ≤ A * (C₀ * Real.exp (A * |τ|)) + B := by
                  linarith [mul_le_mul_of_nonneg_left (ih_m τ hτ_le_T) hA])
          have h_step := hw_seq_tier m K j t
          have h_Bt : B * |t| ≤ B * T := mul_le_mul_of_nonneg_left ht hB
          have h_alg : schwartzTierNorm K j w₀ + (C₀ * (Real.exp (A * |t|) - 1) + B * |t|) ≤
              C₀ * Real.exp (A * |t|) := by
            dsimp [C₀]
            linarith
          linarith
      refine ⟨C₀ * Real.exp (A * T), fun m t ht => ?_⟩
      calc schwartzTierNorm K j (w_seq m t)
        _ ≤ C₀ * Real.exp (A * |t|) := h_gron_m m t ht
        _ ≤ C₀ * Real.exp (A * T) :=
          mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left ht hA)) hC₀
  let B_T : ℕ → ℕ → ℝ := fun p j =>
    2 * (h_tier_bdd (max p 2) (le_max_right p 2) j).choose
  have hB_T : ∀ (m : ℕ) (t : ℝ), |t| ≤ T → ∀ (p j : ℕ),
      SchwartzMap.seminorm ℝ p j (w_seq (m + 1) t - w_seq m t) ≤ B_T p j := by
    intro m t ht p j
    let K_p := max p 2
    have h_p_mem : p ∈ Finset.range (K_p + 1) :=
      Finset.mem_range.mpr (Nat.lt_succ_of_le (le_max_left p 2))
    have h_le_tier : ∀ q : 𝓢(ℝ, ℝ), SchwartzMap.seminorm ℝ p j q ≤ schwartzTierNorm K_p j q := by
      intro q
      exact Finset.single_le_sum (fun i _ => apply_nonneg (SchwartzMap.seminorm ℝ i j) q) h_p_mem
    have h_m1 : SchwartzMap.seminorm ℝ p j (w_seq (m + 1) t) ≤
        (h_tier_bdd K_p (le_max_right p 2) j).choose :=
      le_trans (h_le_tier _) ((h_tier_bdd K_p (le_max_right p 2) j).choose_spec (m + 1) t ht)
    have h_m0 : SchwartzMap.seminorm ℝ p j (w_seq m t) ≤
        (h_tier_bdd K_p (le_max_right p 2) j).choose :=
      le_trans (h_le_tier _) ((h_tier_bdd K_p (le_max_right p 2) j).choose_spec m t ht)
    have h_tri : SchwartzMap.seminorm ℝ p j (w_seq (m + 1) t - w_seq m t) ≤
        SchwartzMap.seminorm ℝ p j (w_seq (m + 1) t) + SchwartzMap.seminorm ℝ p j (w_seq m t) :=
      map_sub_le_add (SchwartzMap.seminorm ℝ p j) (w_seq (m + 1) t) (w_seq m t)
    dsimp [B_T]
    linarith
  obtain ⟨C, hC_nonneg, hC_geom⟩ :=
    h_fact_geom B_T (M₀ * T) (L_lip * T) (by positivity) (by positivity) k n
  exact ⟨C, hC_nonneg, fun m t ht =>
    hC_geom m (w_seq (m + 1) t - w_seq m t) (hB_T m t ht) (h_hm1_shift m t ht)⟩

theorem schwartz_telescoping_series_limit_curve : ∀ (w₀ : 𝓢(ℝ, ℝ)) (w_seq : ℕ → ℝ → 𝓢(ℝ, ℝ)),
      (∀ t : ℝ, w_seq 0 t = w₀) →
      (∀ m : ℕ, Continuous (w_seq m)) →
      (∀ (T : ℝ), 0 ≤ T → ∀ (k n : ℕ),
        ∃ C : ℝ, 0 ≤ C ∧
          ∀ (m : ℕ) (t : ℝ), |t| ≤ T →
            SchwartzMap.seminorm ℝ k n (w_seq (m + 1) t - w_seq m t) ≤ C * (1 / 2 : ℝ) ^ m) →
      ∃ w_tilde : ℝ → 𝓢(ℝ, ℝ),
        Continuous w_tilde ∧
        (∀ (T : ℝ), 0 ≤ T → ∀ (k n : ℕ),
          ∃ C : ℝ, 0 ≤ C ∧
            ∀ (N : ℕ) (t : ℝ), |t| ≤ T →
              SchwartzMap.seminorm ℝ k n (w_seq N t - w_tilde t) ≤ C * (1 / 2 : ℝ) ^ N) ∧
        (∀ (t : ℝ) (n : ℕ) (x : ℝ),
          Filter.Tendsto (fun N : ℕ => iteratedDeriv n (w_seq N t) x)
            Filter.atTop (nhds (iteratedDeriv n (w_tilde t) x))) :=
by
  have h_s1 : ∀ (d : ℕ → 𝓢(ℝ, ℝ)),
      (∀ (k n : ℕ), Summable (fun m : ℕ => SchwartzMap.seminorm ℝ k n (d m))) →
      ∃ D : 𝓢(ℝ, ℝ),
        ∀ (n : ℕ) (x : ℝ),
          Summable (fun m : ℕ => ‖iteratedDeriv n (d m) x‖) ∧
          iteratedDeriv n D x = ∑' m : ℕ, iteratedDeriv n (d m) x := by
    intro d h_sum
    let f : ℕ → ℝ → ℝ := fun m x => d m x
    have hf_smooth : ∀ m : ℕ, ContDiff ℝ (↑(⊤ : ℕ∞)) (f m) :=
      fun m => (d m).smooth'
    let v : ℕ → ℕ → ℝ := fun n m => SchwartzMap.seminorm ℝ 0 n (d m)
    have hv_sum : ∀ n : ℕ, (n : ℕ∞) ≤ (⊤ : ℕ∞) → Summable (v n) :=
      fun n _ => h_sum 0 n
    have hv_bound : ∀ (n m : ℕ) (x : ℝ), (n : ℕ∞) ≤ (⊤ : ℕ∞) →
        ‖iteratedFDeriv ℝ n (f m) x‖ ≤ v n m := by
      intro n m x _
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
      simpa [f, v, pow_zero, one_mul] using SchwartzMap.le_seminorm' ℝ 0 n (d m) x
    let D_fun : ℝ → ℝ := fun x => ∑' m : ℕ, f m x
    have h_smooth : ContDiff ℝ (↑(⊤ : ℕ∞)) D_fun :=
      contDiff_tsum hf_smooth hv_sum hv_bound
    have h_decay : ∀ (k n : ℕ), ∃ C : ℝ, ∀ x : ℝ,
        ‖x‖ ^ k * ‖iteratedFDeriv ℝ n D_fun x‖ ≤ C := by
      intro k n
      refine ⟨∑' m : ℕ, SchwartzMap.seminorm ℝ k n (d m), ?_⟩
      intro x
      have h_fderiv_eq :
          iteratedFDeriv ℝ n D_fun x = ∑' m : ℕ, iteratedFDeriv ℝ n (f m) x :=
        iteratedFDeriv_tsum_apply hf_smooth hv_sum hv_bound (le_top : (n : ℕ∞) ≤ ⊤) x
      rw [h_fderiv_eq]
      have h_norm_sum : Summable (fun m : ℕ => ‖iteratedFDeriv ℝ n (f m) x‖) :=
        Summable.of_nonneg_of_le (fun m => norm_nonneg _)
          (fun m => hv_bound n m x le_top) (hv_sum n le_top)
      have h_tsum_norm :
          ‖∑' m : ℕ, iteratedFDeriv ℝ n (f m) x‖ ≤ ∑' m : ℕ, ‖iteratedFDeriv ℝ n (f m) x‖ :=
        norm_tsum_le_tsum_norm h_norm_sum
      have h_mul_sum :
          Summable (fun m : ℕ => ‖x‖ ^ k * ‖iteratedFDeriv ℝ n (f m) x‖) :=
        h_norm_sum.mul_left (‖x‖ ^ k)
      have h_term_le : ∀ m : ℕ,
          ‖x‖ ^ k * ‖iteratedFDeriv ℝ n (f m) x‖ ≤ SchwartzMap.seminorm ℝ k n (d m) := by
        intro m
        rw [Real.norm_eq_abs, norm_iteratedFDeriv_eq_norm_iteratedDeriv]
        exact SchwartzMap.le_seminorm' ℝ k n (d m) x
      calc ‖x‖ ^ k * ‖∑' m : ℕ, iteratedFDeriv ℝ n (f m) x‖
        _ ≤ ‖x‖ ^ k * ∑' m : ℕ, ‖iteratedFDeriv ℝ n (f m) x‖ :=
          mul_le_mul_of_nonneg_left h_tsum_norm (by positivity)
        _ = ∑' m : ℕ, ‖x‖ ^ k * ‖iteratedFDeriv ℝ n (f m) x‖ :=
          (tsum_mul_left).symm
        _ ≤ ∑' m : ℕ, SchwartzMap.seminorm ℝ k n (d m) :=
          Summable.tsum_le_tsum h_term_le h_mul_sum (h_sum k n)
    let D : 𝓢(ℝ, ℝ) := SchwartzMap.mk D_fun h_smooth h_decay
    refine ⟨D, ?_⟩
    intro n x
    have h_norm_sum : Summable (fun m : ℕ => ‖iteratedDeriv n (d m) x‖) := by
      refine Summable.of_nonneg_of_le (fun m => norm_nonneg _) (fun m => ?_) (hv_sum n le_top)
      rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
      exact hv_bound n m x le_top
    have h_fderiv_sum : Summable (fun m : ℕ => iteratedFDeriv ℝ n (f m) x) :=
      Summable.of_norm_bounded (hv_sum n le_top) (fun m => hv_bound n m x le_top)
    refine ⟨h_norm_sum, ?_⟩
    change iteratedDeriv n D_fun x = ∑' m : ℕ, iteratedDeriv n (f m) x
    rw [iteratedDeriv_eq_iteratedFDeriv]
    have h_fd := iteratedFDeriv_tsum_apply hf_smooth hv_sum hv_bound (le_top : (n : ℕ∞) ≤ ⊤) x
    change iteratedFDeriv ℝ n D_fun x = ∑' m : ℕ, iteratedFDeriv ℝ n (f m) x at h_fd
    rw [h_fd, ContinuousMultilinearMap.tsum_eval h_fderiv_sum (fun _ => 1)]
    simp_rw [← iteratedDeriv_eq_iteratedFDeriv]
  have h_s2 : ∀ (w₀ w_infty : 𝓢(ℝ, ℝ)) (u : ℕ → 𝓢(ℝ, ℝ)),
      u 0 = w₀ →
      (∀ (n : ℕ) (x : ℝ),
        Summable (fun m : ℕ => ‖iteratedDeriv n (u (m + 1) - u m : 𝓢(ℝ, ℝ)) x‖) ∧
        iteratedDeriv n w_infty x =
          iteratedDeriv n w₀ x + ∑' m : ℕ, iteratedDeriv n (u (m + 1) - u m : 𝓢(ℝ, ℝ)) x) →
      (∀ (n : ℕ) (x : ℝ),
        Filter.Tendsto (fun N : ℕ => iteratedDeriv n (u N) x)
          Filter.atTop (nhds (iteratedDeriv n w_infty x))) ∧
      (∀ (k n : ℕ) (C : ℝ), 0 ≤ C →
        (∀ m : ℕ, SchwartzMap.seminorm ℝ k n (u (m + 1) - u m) ≤ C * (1 / 2 : ℝ) ^ m) →
        ∀ N : ℕ, SchwartzMap.seminorm ℝ k n (u N - w_infty) ≤ (2 * C) * (1 / 2 : ℝ) ^ N) := by
    intro w₀ w_infty u hu0 h_tsum
    have h_iter_sub : ∀ (f g : 𝓢(ℝ, ℝ)) (n : ℕ) (x : ℝ),
        iteratedDeriv n (f - g : 𝓢(ℝ, ℝ)) x = iteratedDeriv n f x - iteratedDeriv n g x :=
      fun f g n x => iteratedDeriv_sub ((f.smooth n).contDiffAt) ((g.smooth n).contDiffAt)
    have h_tele : ∀ (n : ℕ) (x : ℝ) (N : ℕ),
        (∑ m ∈ Finset.range N, iteratedDeriv n (u (m + 1) - u m : 𝓢(ℝ, ℝ)) x) =
          iteratedDeriv n (u N) x - iteratedDeriv n w₀ x := by
      intro n x N
      have h_congr :
          (∑ m ∈ Finset.range N, iteratedDeriv n (u (m + 1) - u m : 𝓢(ℝ, ℝ)) x) =
          (∑ m ∈ Finset.range N, (iteratedDeriv n (u (m + 1)) x - iteratedDeriv n (u m) x)) :=
        Finset.sum_congr rfl (fun m _ => h_iter_sub (u (m + 1)) (u m) n x)
      rw [h_congr, Finset.sum_range_sub (fun m => iteratedDeriv n (u m) x) N, hu0]
    refine ⟨?_, ?_⟩
    · intro n x
      let δ : ℕ → ℝ := fun m => iteratedDeriv n (u (m + 1) - u m : 𝓢(ℝ, ℝ)) x
      have hδ_sum : Summable δ := (h_tsum n x).1.of_norm
      have h_tendsto_sum :
          Filter.Tendsto (fun N : ℕ => ∑ m ∈ Finset.range N, δ m)
            Filter.atTop (nhds (∑' m : ℕ, δ m)) :=
        hδ_sum.hasSum.tendsto_sum_nat
      have h_add : Filter.Tendsto (fun N : ℕ => iteratedDeriv n w₀ x + ∑ m ∈ Finset.range N, δ m)
          Filter.atTop (nhds (iteratedDeriv n w₀ x + ∑' m : ℕ, δ m)) :=
        tendsto_const_nhds.add h_tendsto_sum
      rw [← (h_tsum n x).2] at h_add
      refine h_add.congr (fun N => ?_)
      have ht := h_tele n x N
      dsimp [δ]
      linarith
    · intro k n C hC h_step N
      refine SchwartzMap.seminorm_le_bound' ℝ k n (u N - w_infty) (by positivity) (fun x => ?_)
      let δ : ℕ → ℝ := fun m => iteratedDeriv n (u (m + 1) - u m : 𝓢(ℝ, ℝ)) x
      have hδ_sum : Summable δ := (h_tsum n x).1.of_norm
      have h_split : (∑ m ∈ Finset.range N, δ m) + (∑' m : ℕ, δ (m + N)) = ∑' m : ℕ, δ m :=
        Summable.sum_add_tsum_nat_add N hδ_sum
      have h_diff_eq : iteratedDeriv n (u N - w_infty : 𝓢(ℝ, ℝ)) x = -(∑' m : ℕ, δ (m + N)) := by
        rw [h_iter_sub, (h_tsum n x).2]
        have ht := h_tele n x N
        change (∑ m ∈ Finset.range N, δ m) = iteratedDeriv n (u N) x - iteratedDeriv n w₀ x at ht
        change (∑ m ∈ Finset.range N, δ m) + (∑' m : ℕ, δ (m + N)) =
          ∑' m : ℕ, iteratedDeriv n (u (m + 1) - u m : 𝓢(ℝ, ℝ)) x at h_split
        linarith
      rw [h_diff_eq, norm_neg]
      have h_tail_norm : Summable (fun m : ℕ => ‖δ (m + N)‖) :=
        (summable_nat_add_iff N).mpr (h_tsum n x).1
      have h_tsum_norm : ‖∑' m : ℕ, δ (m + N)‖ ≤ ∑' m : ℕ, ‖δ (m + N)‖ :=
        norm_tsum_le_tsum_norm h_tail_norm
      have h_mul_sum : Summable (fun m : ℕ => |x| ^ k * ‖δ (m + N)‖) :=
        h_tail_norm.mul_left (|x| ^ k)
      have h_geom_sum : Summable (fun m : ℕ => (C * (1 / 2 : ℝ) ^ N) * (1 / 2 : ℝ) ^ m) :=
        summable_geometric_two.mul_left (C * (1 / 2 : ℝ) ^ N)
      have h_term_le : ∀ m : ℕ,
          |x| ^ k * ‖δ (m + N)‖ ≤ (C * (1 / 2 : ℝ) ^ N) * (1 / 2 : ℝ) ^ m := by
        intro m
        calc |x| ^ k * ‖δ (m + N)‖
          _ ≤ SchwartzMap.seminorm ℝ k n (u (m + N + 1) - u (m + N)) :=
            SchwartzMap.le_seminorm' ℝ k n (u (m + N + 1) - u (m + N)) x
          _ ≤ C * (1 / 2 : ℝ) ^ (m + N) := h_step (m + N)
          _ = (C * (1 / 2 : ℝ) ^ N) * (1 / 2 : ℝ) ^ m := by
            rw [pow_add]
            ring
      calc |x| ^ k * ‖∑' m : ℕ, δ (m + N)‖
        _ ≤ |x| ^ k * ∑' m : ℕ, ‖δ (m + N)‖ :=
          mul_le_mul_of_nonneg_left h_tsum_norm (by positivity)
        _ = ∑' m : ℕ, |x| ^ k * ‖δ (m + N)‖ := (tsum_mul_left).symm
        _ ≤ ∑' m : ℕ, (C * (1 / 2 : ℝ) ^ N) * (1 / 2 : ℝ) ^ m :=
          Summable.tsum_le_tsum h_term_le h_mul_sum h_geom_sum
        _ = (C * (1 / 2 : ℝ) ^ N) * ∑' m : ℕ, (1 / 2 : ℝ) ^ m := tsum_mul_left
        _ = (2 * C) * (1 / 2 : ℝ) ^ N := by
          rw [tsum_geometric_two]
          ring
  have h_s3 : ∀ (w_seq : ℕ → ℝ → 𝓢(ℝ, ℝ)) (w_tilde : ℝ → 𝓢(ℝ, ℝ)),
      (∀ N : ℕ, Continuous (w_seq N)) →
      (∀ (T : ℝ), 0 ≤ T → ∀ (k n : ℕ),
        ∃ C : ℝ, 0 ≤ C ∧
          ∀ (N : ℕ) (t : ℝ), |t| ≤ T →
            SchwartzMap.seminorm ℝ k n (w_seq N t - w_tilde t) ≤ C * (1 / 2 : ℝ) ^ N) →
      Continuous w_tilde := by
    intro w_seq w_tilde hw_cont h_unif
    rw [continuous_iff_continuousAt]
    intro t₀
    rw [ContinuousAt, (schwartz_withSeminorms ℝ ℝ ℝ).tendsto_nhds w_tilde (w_tilde t₀)]
    rintro ⟨k, n⟩ ε hε
    rw [SchwartzMap.schwartzSeminormFamily_apply ℝ ℝ ℝ k n]
    let p : Seminorm ℝ 𝓢(ℝ, ℝ) := SchwartzMap.seminorm ℝ k n
    change ∀ᶠ t : ℝ in nhds t₀, p (w_tilde t - w_tilde t₀) < ε
    set T : ℝ := |t₀| + 1
    have hT : 0 ≤ T := by positivity
    obtain ⟨C, _hC_nonneg, hC_bound⟩ := h_unif T hT k n
    have h_pow_tendsto : Filter.Tendsto (fun N : ℕ => C * (1 / 2 : ℝ) ^ N) Filter.atTop (nhds 0) := by
      simpa [mul_zero] using
        Filter.Tendsto.const_mul C
          (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (1 / 2 : ℝ) < 1))
    have h_ev_lt : ∀ᶠ N : ℕ in Filter.atTop, C * (1 / 2 : ℝ) ^ N < ε / 3 :=
      h_pow_tendsto.eventually (gt_mem_nhds (by linarith))
    obtain ⟨N, hN_lt⟩ := h_ev_lt.exists
    have h_cont_N : Filter.Tendsto (w_seq N) (nhds t₀) (nhds (w_seq N t₀)) :=
      (hw_cont N).continuousAt
    rw [(schwartz_withSeminorms ℝ ℝ ℝ).tendsto_nhds (w_seq N) (w_seq N t₀)] at h_cont_N
    have h_ev_N := h_cont_N (k, n) (ε / 3) (by linarith)
    rw [SchwartzMap.schwartzSeminormFamily_apply ℝ ℝ ℝ k n] at h_ev_N
    change ∀ᶠ t : ℝ in nhds t₀, p (w_seq N t - w_seq N t₀) < ε / 3 at h_ev_N
    filter_upwards [h_ev_N, Metric.ball_mem_nhds t₀ one_pos] with t ht_mid ht_ball
    rw [Metric.mem_ball, Real.dist_eq] at ht_ball
    have ht_T : |t| ≤ T := by
      have h_tri : |t| ≤ |t - t₀| + |t₀| := by
        simpa using abs_add_le (t - t₀) t₀
      dsimp [T]
      linarith
    have ht₀_T : |t₀| ≤ T := by
      dsimp [T]
      linarith
    have h1 : p (w_tilde t - w_seq N t) < ε / 3 := by
      have h_neg : w_tilde t - w_seq N t = -(w_seq N t - w_tilde t) := by abel
      rw [h_neg, map_neg_eq_map]
      exact lt_of_le_of_lt (hC_bound N t ht_T) hN_lt
    have h3 : p (w_seq N t₀ - w_tilde t₀) < ε / 3 :=
      lt_of_le_of_lt (hC_bound N t₀ ht₀_T) hN_lt
    have h_decomp : w_tilde t - w_tilde t₀ =
        (w_tilde t - w_seq N t) + ((w_seq N t - w_seq N t₀) + (w_seq N t₀ - w_tilde t₀)) := by
      abel
    have h_tri1 : p (w_tilde t - w_tilde t₀) ≤
        p (w_tilde t - w_seq N t) + p ((w_seq N t - w_seq N t₀) + (w_seq N t₀ - w_tilde t₀)) := by
      rw [h_decomp]
      exact map_add_le_add p _ _
    have h_tri2 : p ((w_seq N t - w_seq N t₀) + (w_seq N t₀ - w_tilde t₀)) ≤
        p (w_seq N t - w_seq N t₀) + p (w_seq N t₀ - w_tilde t₀) :=
      map_add_le_add p _ _
    linarith
  intro w₀ w_seq hw_seq0 hw_seq_cont hw_geom
  let d : ℝ → ℕ → 𝓢(ℝ, ℝ) := fun t m => w_seq (m + 1) t - w_seq m t
  have h_d_sum : ∀ (t : ℝ) (k n : ℕ),
      Summable (fun m : ℕ => SchwartzMap.seminorm ℝ k n (d t m)) := by
    intro t k n
    obtain ⟨C, _hC, h_step⟩ := hw_geom |t| (abs_nonneg t) k n
    exact Summable.of_nonneg_of_le (fun m => apply_nonneg _ _)
      (fun m => h_step m t le_rfl)
      (summable_geometric_two.mul_left C)
  let D : ℝ → 𝓢(ℝ, ℝ) := fun t => Classical.choose (h_s1 (d t) (h_d_sum t))
  let w_tilde : ℝ → 𝓢(ℝ, ℝ) := fun t => w₀ + D t
  have hw_tilde_tsum : ∀ (t : ℝ) (n : ℕ) (x : ℝ),
      Summable (fun m : ℕ => ‖iteratedDeriv n (w_seq (m + 1) t - w_seq m t : 𝓢(ℝ, ℝ)) x‖) ∧
      iteratedDeriv n (w_tilde t) x =
        iteratedDeriv n w₀ x + ∑' m : ℕ, iteratedDeriv n (w_seq (m + 1) t - w_seq m t : 𝓢(ℝ, ℝ)) x := by
    intro t n x
    have hD_spec := Classical.choose_spec (h_s1 (d t) (h_d_sum t)) n x
    refine ⟨hD_spec.1, ?_⟩
    have h_add : iteratedDeriv n (w_tilde t) x = iteratedDeriv n w₀ x + iteratedDeriv n (D t) x :=
      iteratedDeriv_add ((w₀.smooth n).contDiffAt) (((D t).smooth n).contDiffAt)
    rw [h_add, hD_spec.2]
  have hw_unif : ∀ (T : ℝ), 0 ≤ T → ∀ (k n : ℕ),
      ∃ C : ℝ, 0 ≤ C ∧
        ∀ (N : ℕ) (t : ℝ), |t| ≤ T →
          SchwartzMap.seminorm ℝ k n (w_seq N t - w_tilde t) ≤ C * (1 / 2 : ℝ) ^ N := by
    intro T hT k n
    obtain ⟨C, hC, h_step⟩ := hw_geom T hT k n
    refine ⟨2 * C, by positivity, ?_⟩
    intro N t ht
    exact (h_s2 w₀ (w_tilde t) (fun m => w_seq m t) (hw_seq0 t) (hw_tilde_tsum t)).2
      k n C hC (fun m => h_step m t ht) N
  have hw_pt : ∀ (t : ℝ) (n : ℕ) (x : ℝ),
      Filter.Tendsto (fun N : ℕ => iteratedDeriv n (w_seq N t) x)
        Filter.atTop (nhds (iteratedDeriv n (w_tilde t) x)) :=
    fun t n x => (h_s2 w₀ (w_tilde t) (fun m => w_seq m t) (hw_seq0 t) (hw_tilde_tsum t)).1 n x
  have hw_cont : Continuous w_tilde :=
    h_s3 w_seq w_tilde hw_seq_cont hw_unif
  exact ⟨w_tilde, hw_cont, hw_unif, hw_pt⟩

theorem schwartz_picard_iteration_global_integral_curve : ((∀ (g : 𝓢(ℝ, ℝ)),
        ‖ι g‖ ≤ 4 * (SchwartzMap.seminorm ℝ 0 0 g + SchwartzMap.seminorm ℝ 2 0 g)) ∧
      (∀ (B : ℕ → ℕ → ℝ) (k n : ℕ) (ε : ℝ), 0 < ε →
        ∃ η : ℝ, 0 < η ∧
          ∀ (g : 𝓢(ℝ, ℝ)),
            (∀ p m : ℕ, SchwartzMap.seminorm ℝ p m g ≤ B p m) →
            ‖ι g‖ < η →
            SchwartzMap.seminorm ℝ k n g < ε) ∧
      (∀ (B : ℕ → ℕ → ℝ) (C₀ L : ℝ), 0 ≤ C₀ → 0 ≤ L →
        ∀ (k n : ℕ), ∃ C : ℝ, 0 ≤ C ∧
          ∀ (m : ℕ) (g : 𝓢(ℝ, ℝ)),
            (∀ p j : ℕ, SchwartzMap.seminorm ℝ p j g ≤ B p j) →
            ‖ι g‖ ≤ C₀ * L ^ m / (Nat.factorial m : ℝ) →
            SchwartzMap.seminorm ℝ k n g ≤ C * (1 / 2 : ℝ) ^ m)) →
    ((∀ (w₀ : 𝓢(ℝ, ℝ)) (G : ℝ → 𝓢(ℝ, ℝ)),
        Continuous G →
        ∃ W : ℝ → 𝓢(ℝ, ℝ),
          Continuous W ∧
          (∀ (t : ℝ) (n : ℕ) (x : ℝ),
            iteratedDeriv n (W t) x =
              iteratedDeriv n w₀ x + ∫ τ in (0 : ℝ)..t, iteratedDeriv n (G τ) x) ∧
          (∀ (K n : ℕ) (t : ℝ),
            schwartzTierNorm K n (W t) ≤
              schwartzTierNorm K n w₀ +
                |∫ τ in (0 : ℝ)..t, schwartzTierNorm K n (G τ)|)) ∧
      (∀ (w₀ : 𝓢(ℝ, ℝ)) (G₁ G₂ W₁ W₂ : ℝ → 𝓢(ℝ, ℝ)),
        Continuous G₁ → Continuous G₂ →
        (∀ (t : ℝ) (n : ℕ) (x : ℝ),
          iteratedDeriv n (W₁ t) x =
            iteratedDeriv n w₀ x + ∫ τ in (0 : ℝ)..t, iteratedDeriv n (G₁ τ) x) →
        (∀ (t : ℝ) (n : ℕ) (x : ℝ),
          iteratedDeriv n (W₂ t) x =
            iteratedDeriv n w₀ x + ∫ τ in (0 : ℝ)..t, iteratedDeriv n (G₂ τ) x) →
        ∀ (t : ℝ),
          ‖ι (W₁ t - W₂ t)‖ ≤ |∫ τ in (0 : ℝ)..t, ‖ι (G₁ τ - G₂ τ)‖|)) →
    ∀ (V : 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ)) (M₀ L_lip : ℝ),
      0 ≤ M₀ → 0 ≤ L_lip →
      (∀ q : 𝓢(ℝ, ℝ), ‖ι (V q)‖ ≤ M₀) →
      (∀ q₁ q₂ : 𝓢(ℝ, ℝ), ‖ι (V q₁) - ι (V q₂)‖ ≤ L_lip * ‖ι (q₁ - q₂)‖) →
      (∀ (K n : ℕ), 2 ≤ K →
        ∀ (M : ℕ → ℝ),
          ∃ (A B : ℝ), 0 ≤ A ∧ 0 ≤ B ∧
            ∀ (q : 𝓢(ℝ, ℝ)),
              (∀ m < n, schwartzTierNorm K m q ≤ M m) →
              schwartzTierNorm K n (V q) ≤ A * schwartzTierNorm K n q + B) →
      ∀ (w₀ : 𝓢(ℝ, ℝ)),
        ∃ w_tilde : ℝ → 𝓢(ℝ, ℝ),
          Continuous (fun t : ℝ => V (w_tilde t)) ∧
          ∀ (t : ℝ) (n : ℕ) (x : ℝ),
            iteratedDeriv n (w_tilde t) x =
              iteratedDeriv n w₀ x +
                ∫ τ in (0 : ℝ)..t, iteratedDeriv n (V (w_tilde τ)) x :=
by
  rintro ⟨h_hm1_le, h_eps_eta, h_fact_geom⟩ h_int_op V M₀ L_lip hM₀ hL_lip hV_bdd hV_lip hV_tier w₀
  obtain ⟨h_int_mono, h_int_gron⟩ := oriented_intervalIntegral_monomial_and_gronwall_bounds
  obtain ⟨h_iota_sub, hV_props⟩ := iota_sub_and_vecField_continuity_and_integral_tendsto
  obtain ⟨hV_cont_curve, hV_int_tendsto⟩ :=
    hV_props V L_lip hL_lip h_hm1_le h_eps_eta hV_lip hV_tier
  obtain ⟨w_seq, hw_seq0, hw_seq_cont, hw_seq_int, hw_seq_geom⟩ :=
    schwartz_picard_iterates_exists_and_geometric_diff_bound
      h_iota_sub h_int_mono h_int_gron h_fact_geom h_int_op
      V M₀ L_lip hM₀ hL_lip hV_cont_curve hV_bdd hV_lip hV_tier w₀
  obtain ⟨w_tilde, hw_tilde_cont, hw_tilde_unif, hw_tilde_pt⟩ :=
    schwartz_telescoping_series_limit_curve w₀ w_seq hw_seq0 hw_seq_cont hw_seq_geom
  refine ⟨w_tilde, hV_cont_curve w_tilde hw_tilde_cont, ?_⟩
  intro t n x
  have h_lhs : Filter.Tendsto (fun N : ℕ => iteratedDeriv n (w_seq (N + 1) t) x)
      Filter.atTop (nhds (iteratedDeriv n (w_tilde t) x)) :=
    (Filter.tendsto_add_atTop_iff_nat 1).mpr (hw_tilde_pt t n x)
  have h_eq : (fun N : ℕ => iteratedDeriv n (w_seq (N + 1) t) x) =
      (fun N : ℕ => iteratedDeriv n w₀ x + ∫ τ in (0 : ℝ)..t, iteratedDeriv n (V (w_seq N τ)) x) :=
    funext (fun N => hw_seq_int N t n x)
  have h_rhs : Filter.Tendsto (fun N : ℕ => iteratedDeriv n (w_seq (N + 1) t) x)
      Filter.atTop
      (nhds (iteratedDeriv n w₀ x + ∫ τ in (0 : ℝ)..t, iteratedDeriv n (V (w_tilde τ)) x)) := by
    rw [h_eq]
    exact tendsto_const_nhds.add
      (hV_int_tendsto w_seq w_tilde hw_seq_cont hw_tilde_cont hw_tilde_unif t n x)
  exact tendsto_nhds_unique h_lhs h_rhs

theorem regTruncatedVec_global_integral_curve_exists : ∀ (δ' : ℝ), 0 < δ' → δ' ≤ 1 / 512 →
    ∀ (κ : ℝ), 2 ≤ κ →
      (∀ (q : 𝓢(ℝ, ℝ)), 2 * δ' ≤ ‖ι q‖ → regTruncatedVec δ' κ q = 0) →
      (∀ (q : 𝓢(ℝ, ℝ)), ‖ι (regTruncatedVec δ' κ q)‖ ≤ 96 * κ ^ 5 * δ') →
      (∀ (q₁ q₂ : 𝓢(ℝ, ℝ)),
        ‖ι (regTruncatedVec δ' κ q₁) - ι (regTruncatedVec δ' κ q₂)‖ ≤
          144 * κ ^ 5 * ‖ι (q₁ - q₂)‖) →
      ∀ (w₀ : 𝓢(ℝ, ℝ)), ‖ι w₀‖ ≤ δ' →
        ∃ w_tilde : ℝ → 𝓢(ℝ, ℝ),
          Continuous (fun t : ℝ => regTruncatedVec δ' κ (w_tilde t)) ∧
          ∀ (t : ℝ) (n : ℕ) (x : ℝ),
            iteratedDeriv n (w_tilde t) x =
              iteratedDeriv n w₀ x +
                ∫ τ in (0 : ℝ)..t, iteratedDeriv n (regTruncatedVec δ' κ (w_tilde τ)) x :=
by
  intro δ' hδ'_pos hδ'_le κ hκ h_vanish h_bdd h_lip w₀ _hw₀
  have h_s1 := schwartz_hm1_interpolation_and_factorial_decay
  have h_s2 := greenIterKernel_diag_iteratedDeriv_succ_tier_bound
  have h_s3 := regTruncatedVec_tier_linear_growth h_s1.1 h_s2 δ' hδ'_pos hδ'_le κ hκ h_vanish
  have h_s4 := schwartz_time_integral_curve_exists_and_bounds
  exact schwartz_picard_iteration_global_integral_curve h_s1 h_s4
    (regTruncatedVec δ' κ) (96 * κ ^ 5 * δ') (144 * κ ^ 5)
    (by positivity) (by positivity) h_bdd h_lip h_s3 w₀

theorem reg_moving_frame_truncated_global_existence : ∃ δ_loc : ℝ, 0 < δ_loc ∧
      ∀ (δ' : ℝ), 0 < δ' → δ' ≤ δ_loc →
        ∀ (κ : ℝ), 2 ≤ κ → ∀ (w₀ : 𝓢(ℝ, ℝ)),
          ∃ w_tilde : ℝ → 𝓢(ℝ, ℝ),
            w_tilde 0 = w₀ ∧
            (∀ s : ℝ, ∃ v_tilde : 𝓢(ℝ, ℝ),
              HasDerivAt w_tilde v_tilde s ∧
              (‖ι (w_tilde s)‖ ≤ δ' →
                ∀ x : ℝ, v_tilde x = 16 * κ ^ 5 * deriv (diagGreen κ (w_tilde s)) x)) :=
by
  have h_s1 : ∀ (w₀ : 𝓢(ℝ, ℝ)) (w G : ℝ → 𝓢(ℝ, ℝ)),
      Continuous G →
      (∀ (t : ℝ) (n : ℕ) (x : ℝ),
        iteratedDeriv n (w t) x =
          iteratedDeriv n w₀ x + ∫ τ in (0 : ℝ)..t, iteratedDeriv n (G τ) x) →
      w 0 = w₀ ∧ ∀ s : ℝ, HasDerivAt w (G s) s := by
    intro w₀ w G hG h_int
    have h_iter_sub : ∀ (f g : 𝓢(ℝ, ℝ)) (n : ℕ) (x : ℝ),
        iteratedDeriv n (f - g : 𝓢(ℝ, ℝ)) x = iteratedDeriv n f x - iteratedDeriv n g x := by
      intro f g n x
      exact iteratedDeriv_sub ((f.smooth n).contDiffAt) ((g.smooth n).contDiffAt)
    have h_iter_smul : ∀ (c : ℝ) (f : 𝓢(ℝ, ℝ)) (n : ℕ) (x : ℝ),
        iteratedDeriv n (c • f : 𝓢(ℝ, ℝ)) x = c * iteratedDeriv n f x := by
      intro c f n x
      simpa [smul_eq_mul] using iteratedDeriv_const_smul ((f.smooth n).contDiffAt) c
    have h_semi_cont : ∀ (k n : ℕ), Continuous (fun f : 𝓢(ℝ, ℝ) => SchwartzMap.seminorm ℝ k n f) := by
      intro k n
      change Continuous (SchwartzMap.seminorm ℝ k n : Seminorm ℝ 𝓢(ℝ, ℝ))
      rw [← SchwartzMap.schwartzSeminormFamily_apply ℝ ℝ ℝ k n]
      exact (schwartz_withSeminorms ℝ ℝ ℝ).continuous_seminorm (k, n)
    have h_eval_cont : ∀ (n : ℕ) (x : ℝ), Continuous (fun f : 𝓢(ℝ, ℝ) => iteratedDeriv n f x) := by
      intro n x
      rw [continuous_iff_continuousAt]
      intro f
      rw [ContinuousAt, tendsto_iff_dist_tendsto_zero]
      have h_zero : Filter.Tendsto (fun g : 𝓢(ℝ, ℝ) => SchwartzMap.seminorm ℝ 0 n (g - f)) (nhds f) (nhds 0) := by
        have h_c : Continuous (fun g : 𝓢(ℝ, ℝ) => SchwartzMap.seminorm ℝ 0 n (g - f)) :=
          (h_semi_cont 0 n).comp (continuous_id.sub continuous_const)
        simpa [sub_self, map_zero] using (h_c.continuousAt (x := f)).tendsto
      refine squeeze_zero (fun g => dist_nonneg) (fun g => ?_) h_zero
      rw [Real.dist_eq, ← Real.norm_eq_abs, ← h_iter_sub g f n x]
      simpa [pow_zero, one_mul] using SchwartzMap.le_seminorm' ℝ 0 n (g - f) x
    refine ⟨?_, ?_⟩
    · ext x
      have h0 := h_int 0 0 x
      simp only [iteratedDeriv_zero, intervalIntegral.integral_same, add_zero] at h0
      exact h0
    · intro s
      rw [hasDerivAt_iff_hasFDerivAt]
      apply HasFDerivAtFilter.of_isLittleOTVS
      have h_ev : ∀ᶠ s' : ℝ in nhds s,
          s' - s = 0 →
          w s' - w s - (ContinuousLinearMap.toSpanSingleton ℝ (G s)) (s' - s) = 0 := by
        refine Filter.Eventually.of_forall (fun s' hs' => ?_)
        have h_eq : s' = s := sub_eq_zero.mp hs'
        subst h_eq
        simp
      rw [Asymptotics.isLittleOTVS_iff_tendsto_inv_smul h_ev]
      let R : ℝ → 𝓢(ℝ, ℝ) := fun s' =>
        (s' - s)⁻¹ • (w s' - w s - (ContinuousLinearMap.toSpanSingleton ℝ (G s)) (s' - s))
      change Filter.Tendsto R (nhds s) (nhds 0)
      rw [(schwartz_withSeminorms ℝ ℝ ℝ).tendsto_nhds R 0]
      rintro ⟨k, n⟩ ε hε
      rw [SchwartzMap.schwartzSeminormFamily_apply ℝ ℝ ℝ k n]
      have h_p_cont : Continuous (fun τ : ℝ => SchwartzMap.seminorm ℝ k n (G τ - G s)) :=
        (h_semi_cont k n).comp (hG.sub continuous_const)
      have h_p_zero : SchwartzMap.seminorm ℝ k n (G s - G s) = 0 := by
        rw [sub_self, map_zero]
      obtain ⟨η, hη, h_close⟩ :=
        Metric.continuousAt_iff.mp (h_p_cont.continuousAt (x := s)) (ε / 2) (half_pos hε)
      filter_upwards [Metric.ball_mem_nhds s hη] with s' hs'_ball
      rw [sub_zero]
      by_cases hs' : s' = s
      · subst hs'
        simp [R, hε]
      · have h_le_half : SchwartzMap.seminorm ℝ k n (R s') ≤ ε / 2 := by
          refine SchwartzMap.seminorm_le_bound' ℝ k n (R s') (by positivity) (fun x => ?_)
          have h_int_0_s : IntervalIntegrable (fun τ : ℝ => iteratedDeriv n (G τ) x) volume 0 s :=
            ((h_eval_cont n x).comp hG).intervalIntegrable 0 s
          have h_int_s_s' : IntervalIntegrable (fun τ : ℝ => iteratedDeriv n (G τ) x) volume s s' :=
            ((h_eval_cont n x).comp hG).intervalIntegrable s s'
          have h_int_const : IntervalIntegrable (fun _ : ℝ => iteratedDeriv n (G s) x) volume s s' :=
            intervalIntegrable_const
          have h_adj : (∫ τ in (0 : ℝ)..s', iteratedDeriv n (G τ) x) -
              (∫ τ in (0 : ℝ)..s, iteratedDeriv n (G τ) x) =
              ∫ τ in s..s', iteratedDeriv n (G τ) x := by
            rw [← intervalIntegral.integral_add_adjacent_intervals h_int_0_s h_int_s_s']
            ring
          have h_diff_x : iteratedDeriv n (w s' - w s - (s' - s) • G s : 𝓢(ℝ, ℝ)) x =
              ∫ τ in s..s', iteratedDeriv n (G τ - G s : 𝓢(ℝ, ℝ)) x := by
            rw [h_iter_sub, h_iter_sub, h_iter_smul, h_int s' n x, h_int s n x]
            have h1 : (iteratedDeriv n w₀ x + ∫ τ in (0 : ℝ)..s', iteratedDeriv n (G τ) x) -
                (iteratedDeriv n w₀ x + ∫ τ in (0 : ℝ)..s, iteratedDeriv n (G τ) x) -
                (s' - s) * iteratedDeriv n (G s) x =
                (∫ τ in s..s', iteratedDeriv n (G τ) x) - (s' - s) * iteratedDeriv n (G s) x := by
              linarith [h_adj]
            rw [h1]
            have h_c : (s' - s) * iteratedDeriv n (G s) x = ∫ _ in s..s', iteratedDeriv n (G s) x := by
              simp [intervalIntegral.integral_const, smul_eq_mul]
            rw [h_c, ← intervalIntegral.integral_sub h_int_s_s' h_int_const]
            refine intervalIntegral.integral_congr (fun τ _ => ?_)
            exact (h_iter_sub (G τ) (G s) n x).symm
          have h_R_x : iteratedDeriv n (R s') x =
              (s' - s)⁻¹ * ∫ τ in s..s', iteratedDeriv n (G τ - G s : 𝓢(ℝ, ℝ)) x := by
            dsimp [R]
            rw [h_iter_smul, h_diff_x]
          rw [h_R_x, Real.norm_eq_abs, abs_mul, abs_inv]
          have h_pull : |x| ^ k * (|s' - s|⁻¹ * |∫ τ in s..s', iteratedDeriv n (G τ - G s : 𝓢(ℝ, ℝ)) x|) =
              |s' - s|⁻¹ * ‖∫ τ in s..s', |x| ^ k * iteratedDeriv n (G τ - G s : 𝓢(ℝ, ℝ)) x‖ := by
            rw [Real.norm_eq_abs, intervalIntegral.integral_const_mul, abs_mul,
                abs_of_nonneg (pow_nonneg (abs_nonneg x) k)]
            ring
          rw [h_pull]
          have h_int_bound : ‖∫ τ in s..s', |x| ^ k * iteratedDeriv n (G τ - G s : 𝓢(ℝ, ℝ)) x‖ ≤
              (ε / 2) * |s' - s| := by
            refine intervalIntegral.norm_integral_le_of_norm_le_const (fun τ hτ => ?_)
            have hτ_uIcc : τ ∈ Set.uIcc s s' := Set.uIoc_subset_uIcc hτ
            have hτ_dist : dist τ s < η := by
              rw [Metric.mem_ball, Real.dist_eq] at hs'_ball
              rw [Real.dist_eq]
              rcases Set.mem_uIcc.mp hτ_uIcc with ⟨h1, h2⟩ | ⟨h1, h2⟩
              · have : |τ - s| ≤ |s' - s| := by
                  rw [abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]
                  linarith
                exact lt_of_le_of_lt this hs'_ball
              · have : |τ - s| ≤ |s' - s| := by
                  rw [abs_of_nonpos (by linarith), abs_of_nonpos (by linarith)]
                  linarith
                exact lt_of_le_of_lt this hs'_ball
            have h_p_lt : SchwartzMap.seminorm ℝ k n (G τ - G s) ≤ ε / 2 := by
              have hc := h_close hτ_dist
              rw [h_p_zero, Real.dist_eq, sub_zero, abs_of_nonneg (apply_nonneg _ _)] at hc
              exact le_of_lt hc
            rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (pow_nonneg (abs_nonneg x) k),
                ← Real.norm_eq_abs (iteratedDeriv n _ x)]
            exact le_trans (SchwartzMap.le_seminorm' ℝ k n (G τ - G s) x) h_p_lt
          have h_pos : 0 < |s' - s| := abs_pos.mpr (sub_ne_zero.mpr hs')
          calc |s' - s|⁻¹ * ‖∫ τ in s..s', |x| ^ k * iteratedDeriv n (G τ - G s : 𝓢(ℝ, ℝ)) x‖
            _ ≤ |s' - s|⁻¹ * ((ε / 2) * |s' - s|) :=
              mul_le_mul_of_nonneg_left h_int_bound (by positivity)
            _ = ε / 2 := by
              have : |s' - s| ≠ 0 := ne_of_gt h_pos
              field_simp
        linarith
  have h_s2 : ∀ (δ_reg : ℝ),
      (∀ (κ : ℝ), 1 ≤ κ → ∀ (q : 𝓢(ℝ, ℝ)), ‖ι q‖ ≤ δ_reg →
        ∃ g_tilde : 𝓢(ℝ, ℝ), ∀ x : ℝ, diagGreen κ q x = 1 / (2 * κ) + g_tilde x) →
      ∀ (δ' : ℝ), 0 < δ' → 2 * δ' ≤ δ_reg →
        ∀ (κ : ℝ), 2 ≤ κ → ∀ (q : 𝓢(ℝ, ℝ)),
          (‖ι q‖ ≤ δ' →
            ∀ x : ℝ, regTruncatedVec δ' κ q x = 16 * κ ^ 5 * deriv (diagGreen κ q) x) ∧
          (2 * δ' ≤ ‖ι q‖ → regTruncatedVec δ' κ q = 0) := by
    intro δ_reg h_reg δ' hδ'_pos h2δ'_reg κ hκ q
    refine ⟨?_, ?_⟩
    · intro hq x
      have h_div : ‖ι q‖ / δ' ≤ 1 := (div_le_one hδ'_pos).mpr hq
      have h_cut : regCutoff δ' ‖ι q‖ = 1 := by
        unfold regCutoff
        rw [min_eq_left (by linarith), max_eq_right zero_le_one]
      have hq_reg : ‖ι q‖ ≤ δ_reg := by linarith
      have hκ1 : 1 ≤ κ := by linarith
      have h_ex : ∃ g_tilde : 𝓢(ℝ, ℝ), ∀ y : ℝ, diagGreen κ q y = 1 / (2 * κ) + g_tilde y :=
        h_reg κ hκ1 q hq_reg
      unfold regTruncatedVec regMovingFrameVec
      rw [h_cut, one_smul, dif_pos h_ex]
      set g_tilde := Classical.choose h_ex
      have hg_spec : ∀ y : ℝ, diagGreen κ q y = 1 / (2 * κ) + g_tilde y :=
        Classical.choose_spec h_ex
      have h_dg_eq : diagGreen κ q = fun y : ℝ => 1 / (2 * κ) + g_tilde y :=
        funext hg_spec
      rw [SchwartzMap.smul_apply, SchwartzMap.derivCLM_apply, h_dg_eq]
      have hd : HasDerivAt (fun y : ℝ => 1 / (2 * κ) + g_tilde y) (deriv g_tilde x) x := by
        simpa using (g_tilde.differentiableAt.hasDerivAt).const_add (1 / (2 * κ))
      rw [hd.deriv, smul_eq_mul]
    · intro hq
      have h_div : 2 ≤ ‖ι q‖ / δ' := (le_div_iff₀ hδ'_pos).mpr hq
      have h_cut : regCutoff δ' ‖ι q‖ = 0 := by
        unfold regCutoff
        rw [min_eq_right (by linarith), max_eq_left (by linarith)]
      unfold regTruncatedVec
      rw [h_cut, zero_smul]
  obtain ⟨δ_reg, hδ_reg, h_reg⟩ := diagGreen_sub_const_mem_schwartz
  set δ_loc : ℝ := min (δ_reg / 2) (1 / 512)
  have hδ_loc : 0 < δ_loc := by positivity
  refine ⟨δ_loc, hδ_loc, ?_⟩
  intro δ' hδ'_pos hδ'_le κ hκ w₀
  have hδ'_half : δ' ≤ δ_reg / 2 := le_trans hδ'_le (min_le_left _ _)
  have hδ'_512 : δ' ≤ 1 / 512 := le_trans hδ'_le (min_le_right _ _)
  have h2δ'_reg : 2 * δ' ≤ δ_reg := by linarith
  have h2δ'_min : 2 * δ' ≤ min δ_reg (1 / 256) := le_min h2δ'_reg (by linarith)
  by_cases hw₀ : ‖ι w₀‖ ≤ δ'
  · have h_cut_eval := h_s2 δ_reg h_reg δ' hδ'_pos h2δ'_reg κ hκ
    obtain ⟨h_bdd, h_lip⟩ :=
      regTruncatedVec_global_hm1_lipschitz δ_reg hδ_reg h_reg δ' hδ'_pos h2δ'_min κ hκ
    obtain ⟨w_tilde, hG_cont, h_int⟩ :=
      regTruncatedVec_global_integral_curve_exists δ' hδ'_pos hδ'_512 κ hκ
        (fun q => (h_cut_eval q).2) h_bdd h_lip w₀ hw₀
    obtain ⟨hw_tilde0, hw_tilde_deriv⟩ :=
      h_s1 w₀ w_tilde (fun t => regTruncatedVec δ' κ (w_tilde t)) hG_cont h_int
    exact ⟨w_tilde, hw_tilde0, fun s =>
      ⟨regTruncatedVec δ' κ (w_tilde s), hw_tilde_deriv s, (h_cut_eval (w_tilde s)).1⟩⟩
  · have h_const_deriv : ∀ s : ℝ, HasDerivAt (fun _ : ℝ => w₀) 0 s :=
      (h_s1 w₀ (fun _ => w₀) (fun _ => 0) continuous_const (fun t n x => by
        have h_z : iteratedDeriv n (0 : 𝓢(ℝ, ℝ)) x = 0 := by
          simpa using iteratedDeriv_const_smul (((0 : 𝓢(ℝ, ℝ)).smooth n).contDiffAt) (0 : ℝ)
        dsimp only []
        rw [h_z, intervalIntegral.integral_zero, add_zero])).2
    exact ⟨fun _ : ℝ => w₀, rfl, fun s =>
      ⟨0, h_const_deriv s, fun hs => False.elim (hw₀ hs)⟩⟩

theorem reg_flow_conditional_global_existence : ∃ δ_loc : ℝ, 0 < δ_loc ∧
      ∀ (δ' : ℝ), 0 < δ' → δ' ≤ δ_loc →
        ∀ (κ : ℝ), 2 ≤ κ → ∀ (w₀ : 𝓢(ℝ, ℝ)), ‖ι w₀‖ ≤ δ' / 2 →
          (∀ (w : ℝ → 𝓢(ℝ, ℝ)) (t : ℝ),
            w 0 = w₀ →
            (∀ s ∈ Set.uIcc 0 t,
              (∃ v : 𝓢(ℝ, ℝ), HasDerivAt w v s ∧ ∀ x : ℝ, v x = regFlowRHS κ (w s) x) ∧
              ‖ι (w s)‖ ≤ δ') →
            ‖ι (w t)‖ ≤ δ' / 2) →
          ∃ w : ℝ → 𝓢(ℝ, ℝ), IsRegFlowSolution κ w ∧ w 0 = w₀ ∧ ∀ t : ℝ, ‖ι (w t)‖ ≤ δ' :=
by
  have h_trans_apply : ∀ (a : ℝ) (f : 𝓢(ℝ, ℝ)) (x : ℝ), regTranslate a f x = f (x + a) :=
    fun _ _ _ => rfl
  have h_trans_zero : ∀ f : 𝓢(ℝ, ℝ), regTranslate 0 f = f := by
    intro f
    ext x
    change f (x + 0) = f x
    rw [add_zero]
  have h_hm1Profile_trans : ∀ (a : ℝ) (f : 𝓢(ℝ, ℝ)) (ξ : ℝ),
      hm1Profile (regTranslate a f) ξ =
        Complex.exp (((ξ : ℂ) * (a : ℂ)) * I) * hm1Profile f ξ := by
    intro a f ξ
    have h_fl : fourierLine (regTranslate a f) ξ =
        Complex.exp (((ξ : ℂ) * (a : ℂ)) * I) * fourierLine f ξ := by
      dsimp [fourierLine]
      rw [← mul_left_comm ((Real.sqrt (2 * π))⁻¹ : ℂ)]
      congr 1
      rw [← MeasureTheory.integral_const_mul]
      have h_int_eq :
          (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((regTranslate a f x : ℝ) : ℂ)) =
          (fun x : ℝ => Complex.exp (((ξ : ℂ) * (a : ℂ)) * I) *
            (Complex.exp (-((ξ : ℂ) * ((x + a : ℝ) : ℂ)) * I) * (f (x + a) : ℂ))) := by
        ext x
        rw [h_trans_apply, ← mul_assoc, ← Complex.exp_add]
        congr 1
        push_cast
        ring
      rw [h_int_eq]
      exact MeasureTheory.integral_add_right_eq_self
        (fun y : ℝ => Complex.exp (((ξ : ℂ) * (a : ℂ)) * I) *
          (Complex.exp (-((ξ : ℂ) * (y : ℂ)) * I) * (f y : ℂ))) a
    dsimp [hm1Profile]
    rw [h_fl, mul_left_comm]
  have h_trans_norm : ∀ (a : ℝ) (f : 𝓢(ℝ, ℝ)), ‖ι (regTranslate a f)‖ = ‖ι f‖ := by
    intro a f
    change ‖toHm1 (regTranslate a f)‖ = ‖toHm1 f‖
    have h_norm_pt : ∀ ξ : ℝ, ‖hm1Profile (regTranslate a f) ξ‖ = ‖hm1Profile f ξ‖ := by
      intro ξ
      rw [h_hm1Profile_trans, norm_mul]
      have h_exp : ((ξ : ℂ) * (a : ℂ)) * I = ((ξ * a : ℝ) : ℂ) * I := by push_cast; ring
      rw [h_exp, Complex.norm_exp_ofReal_mul_I, one_mul]
    have h_elpn : eLpNorm (hm1Profile (regTranslate a f)) 2 volume =
        eLpNorm (hm1Profile f) 2 volume :=
      eLpNorm_congr_norm_ae (Filter.Eventually.of_forall h_norm_pt)
    have h_aesm_iff : AEStronglyMeasurable (hm1Profile (regTranslate a f)) volume ↔
        AEStronglyMeasurable (hm1Profile f) volume := by
      have h_cont_pos : Continuous (fun ξ : ℝ => Complex.exp (((ξ : ℂ) * (a : ℂ)) * I)) := by
        fun_prop
      have h_cont_neg : Continuous (fun ξ : ℝ => Complex.exp (-(((ξ : ℂ) * (a : ℂ)) * I))) := by
        fun_prop
      constructor
      · intro h
        have h_eq : hm1Profile f = fun ξ : ℝ =>
            Complex.exp (-(((ξ : ℂ) * (a : ℂ)) * I)) * hm1Profile (regTranslate a f) ξ := by
          ext ξ
          rw [h_hm1Profile_trans, ← mul_assoc, ← Complex.exp_add, neg_add_cancel,
              Complex.exp_zero, one_mul]
        rw [h_eq]
        exact h_cont_neg.aestronglyMeasurable.mul h
      · intro h
        have h_eq : hm1Profile (regTranslate a f) = fun ξ : ℝ =>
            Complex.exp (((ξ : ℂ) * (a : ℂ)) * I) * hm1Profile f ξ := by
          ext ξ
          exact h_hm1Profile_trans a f ξ
        rw [h_eq]
        exact h_cont_pos.aestronglyMeasurable.mul h
    have h_mem_iff : MemLp (hm1Profile (regTranslate a f)) 2 volume ↔
        MemLp (hm1Profile f) 2 volume :=
      ⟨fun ⟨h1, h2⟩ => ⟨h_aesm_iff.mp h1, h_elpn ▸ h2⟩,
       fun ⟨h1, h2⟩ => ⟨h_aesm_iff.mpr h1, h_elpn.symm ▸ h2⟩⟩
    dsimp [toHm1]
    by_cases h : MemLp (hm1Profile f) 2 volume
    · have h' : MemLp (hm1Profile (regTranslate a f)) 2 volume := h_mem_iff.mpr h
      rw [dif_pos h', dif_pos h, Lp.norm_toLp, Lp.norm_toLp, h_elpn]
    · have h' : ¬ MemLp (hm1Profile (regTranslate a f)) 2 volume := fun hc => h (h_mem_iff.mp hc)
      rw [dif_neg h', dif_neg h]
  have h_iter_trans : ∀ (κ a : ℝ) (f : 𝓢(ℝ, ℝ)) (ℓ : ℕ) (x y : ℝ),
      greenIterKernel κ (regTranslate a f) ℓ x y =
        greenIterKernel κ f ℓ (x + a) (y + a) := by
    intro κ a f ℓ
    induction ℓ with
    | zero =>
      intro x y
      dsimp [greenIterKernel, freeGreenKernel]
      rw [add_sub_add_right_eq_sub]
    | succ ℓ ih =>
      intro x y
      dsimp [greenIterKernel]
      congr 1
      have h_eq :
          (fun z : ℝ => greenIterKernel κ (regTranslate a f) ℓ x z * regTranslate a f z * freeGreenKernel κ z y) =
          (fun z : ℝ => greenIterKernel κ f ℓ (x + a) (z + a) * f (z + a) * freeGreenKernel κ (z + a) (y + a)) := by
        ext z
        rw [ih x z, h_trans_apply]
        dsimp [freeGreenKernel]
        rw [add_sub_add_right_eq_sub]
      rw [h_eq]
      exact MeasureTheory.integral_add_right_eq_self
        (fun z' : ℝ => greenIterKernel κ f ℓ (x + a) z' * f z' * freeGreenKernel κ z' (y + a)) a
  have h_trans_dg : ∀ (κ a : ℝ) (f : 𝓢(ℝ, ℝ)) (x : ℝ),
      deriv (diagGreen κ (regTranslate a f)) x = deriv (diagGreen κ f) (x + a) := by
    intro κ a f x
    have h_dg : diagGreen κ (regTranslate a f) = fun y => diagGreen κ f (y + a) := by
      ext y
      dsimp [diagGreen, greenKernel]
      exact tsum_congr (fun ℓ => h_iter_trans κ a f ℓ y y)
    rw [h_dg, deriv_comp_add_const]
  have h_bootstrap : ∀ (f : ℝ → ℝ) (δ' : ℝ), 0 < δ' → Continuous f → f 0 ≤ δ' / 2 →
      (∀ t : ℝ, (∀ s ∈ Set.uIcc 0 t, f s ≤ δ') → f t ≤ δ' / 2) →
      ∀ t : ℝ, f t ≤ δ' := by
    intro f δ' hδ' hf_cont hf0 h_halve
    have h_abs_uIcc : ∀ a b : ℝ, a ∈ Set.uIcc 0 b → |a| ≤ |b| ∧ (|a| = |b| → a = b) := by
      intro a b hab
      rcases Set.mem_uIcc.mp hab with ⟨ha0, hab'⟩ | ⟨hba', ha0⟩
      · rw [abs_of_nonneg ha0, abs_of_nonneg (le_trans ha0 hab')]
        exact ⟨hab', id⟩
      · rw [abs_of_nonpos ha0, abs_of_nonpos (le_trans hba' ha0)]
        exact ⟨neg_le_neg hba', neg_inj.mp⟩
    intro τ
    by_contra! h_gt
    let S : Set ℝ := Set.uIcc 0 τ ∩ {s : ℝ | δ' ≤ f s}
    have hS_compact : IsCompact S :=
      isCompact_uIcc.inter_right (isClosed_Ici.preimage hf_cont)
    have hS_nonempty : S.Nonempty := ⟨τ, Set.right_mem_uIcc, le_of_lt h_gt⟩
    obtain ⟨s₀, ⟨hs₀_uIcc, hs₀_ge⟩, hs₀_min⟩ :=
      hS_compact.exists_isMinOn hS_nonempty continuous_abs.continuousOn
    change δ' ≤ f s₀ at hs₀_ge
    have h_le_s₀ : ∀ s ∈ Set.uIcc 0 s₀, f s ≤ δ' := by
      intro s hs
      by_contra! hs_gt
      have h_mem_img : δ' ∈ Set.uIcc (f 0) (f s) :=
        Set.mem_uIcc.mpr (Or.inl ⟨by linarith, le_of_lt hs_gt⟩)
      obtain ⟨s₁, hs₁_uIcc, hs₁_eq⟩ :=
        intermediate_value_uIcc (hf_cont.continuousOn) h_mem_img
      have hs_sub : Set.uIcc 0 s ⊆ Set.uIcc 0 s₀ :=
        Set.uIcc_subset_uIcc Set.left_mem_uIcc hs
      have hs₀_sub : Set.uIcc 0 s₀ ⊆ Set.uIcc 0 τ :=
        Set.uIcc_subset_uIcc Set.left_mem_uIcc hs₀_uIcc
      have hs₁_S : s₁ ∈ S := ⟨hs₀_sub (hs_sub hs₁_uIcc), le_of_eq hs₁_eq.symm⟩
      have h_min_s₁ : |s₀| ≤ |s₁| := hs₀_min hs₁_S
      have h1 := h_abs_uIcc s₁ s hs₁_uIcc
      have h2 := h_abs_uIcc s s₀ hs
      have h_eq_abs : |s₁| = |s| := le_antisymm h1.1 (le_trans h2.1 h_min_s₁)
      have h_eq_s : s₁ = s := h1.2 h_eq_abs
      subst h_eq_s
      linarith
    have hs₀_halve : f s₀ ≤ δ' / 2 := h_halve s₀ h_le_s₀
    linarith
  obtain ⟨h_chain, h_cont_norm⟩ := regTranslate_moving_frame_hasDerivAt_and_continuous
  obtain ⟨δ_loc, hδ_loc, h_trunc⟩ := reg_moving_frame_truncated_global_existence
  refine ⟨δ_loc, hδ_loc, ?_⟩
  intro δ' hδ'_pos hδ'_le κ hκ w₀ hw₀ h_trap
  obtain ⟨w_tilde, hw_tilde0, hw_tilde_deriv⟩ := h_trunc δ' hδ'_pos hδ'_le κ hκ w₀
  let w : ℝ → 𝓢(ℝ, ℝ) := fun t => regTranslate (4 * κ ^ 2 * t) (w_tilde t)
  have hw0 : w 0 = w₀ := by
    dsimp [w]
    rw [mul_zero, hw_tilde0, h_trans_zero]
  have hw_norm_eq : ∀ t : ℝ, ‖ι (w t)‖ = ‖ι (w_tilde t)‖ :=
    fun t => h_trans_norm (4 * κ ^ 2 * t) (w_tilde t)
  have hw_local_sol : ∀ s : ℝ, ‖ι (w s)‖ ≤ δ' →
      ∃ v : 𝓢(ℝ, ℝ), HasDerivAt w v s ∧ ∀ x : ℝ, v x = regFlowRHS κ (w s) x := by
    intro s hs
    have hs_tilde : ‖ι (w_tilde s)‖ ≤ δ' := by rwa [← hw_norm_eq s]
    obtain ⟨v_tilde, hv_tilde_deriv, hv_tilde_eq⟩ := hw_tilde_deriv s
    obtain ⟨v, hv_deriv, hv_eq⟩ :=
      h_chain w_tilde v_tilde (4 * κ ^ 2) s hv_tilde_deriv
    refine ⟨v, hv_deriv, fun x => ?_⟩
    rw [hv_eq x, hv_tilde_eq hs_tilde (x + 4 * κ ^ 2 * s),
        ← h_trans_dg κ (4 * κ ^ 2 * s) (w_tilde s) x]
    rfl
  have hw_cont_norm : Continuous (fun t : ℝ => ‖ι (w t)‖) := by
    have h_eq : (fun t : ℝ => ‖ι (w t)‖) = (fun t : ℝ => ‖ι (w_tilde t)‖) :=
      funext hw_norm_eq
    rw [h_eq]
    exact h_cont_norm w_tilde (fun s => ⟨(hw_tilde_deriv s).choose, (hw_tilde_deriv s).choose_spec.1⟩)
  have hw0_norm : ‖ι (w 0)‖ ≤ δ' / 2 := by
    rw [hw0]
    exact hw₀
  have hw_ball : ∀ t : ℝ, ‖ι (w t)‖ ≤ δ' := by
    apply h_bootstrap (fun t => ‖ι (w t)‖) δ' hδ'_pos hw_cont_norm hw0_norm
    intro t h_ivl
    exact h_trap w t hw0 (fun s hs => ⟨hw_local_sol s (h_ivl s hs), h_ivl s hs⟩)
  have hw_sol : IsRegFlowSolution κ w := fun t => hw_local_sol t (hw_ball t)
  exact ⟨w, hw_sol, hw0, hw_ball⟩

theorem reg_flow_global_existence_and_conservation (δ : ℝ) (hδ : 0 < δ) :
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ δ₀ ≤ δ ∧
      ∀ κ : ℝ, 2 ≤ κ → ∀ w₀ : 𝓢(ℝ, ℝ), ‖ι w₀‖ ≤ δ₀ →
        ∃ w : ℝ → 𝓢(ℝ, ℝ), IsRegFlowSolution κ w ∧ w 0 = w₀ ∧
          (∀ t : ℝ, ‖ι (w t)‖ ≤ δ) ∧
          (∀ M : ℝ, 1 ≤ M → ∀ t : ℝ, alphaFunctional M (w t) = alphaFunctional M w₀) :=
by
  obtain ⟨δ₁, c₁, c₂, hδ₁, hc₁, hc₁₂, h_quad⟩ := alphaFunctional_one_quadratic_bounds
  obtain ⟨δ₂, hδ₂, h_deriv⟩ := alphaFunctional_hasDerivAt_regFlow
  obtain ⟨δ₃, hδ₃, h_ortho⟩ := regFlowRHS_orthogonality_diagGreen
  obtain ⟨δ_loc, hδ_loc, h_ode⟩ := reg_flow_conditional_global_existence
  have hc₂ : 0 < c₂ := lt_of_lt_of_le hc₁ hc₁₂
  set δ' : ℝ := min (min δ δ_loc) (min δ₁ (min δ₂ δ₃))
  have hδ' : 0 < δ' := by positivity
  have hδ'_le_δ : δ' ≤ δ := le_trans (min_le_left _ _) (min_le_left _ _)
  have hδ'_le_loc : δ' ≤ δ_loc := le_trans (min_le_left _ _) (min_le_right _ _)
  have hδ'_le_δ₁ : δ' ≤ δ₁ := le_trans (min_le_right _ _) (min_le_left _ _)
  have hδ'_le_δ₂ : δ' ≤ δ₂ :=
    le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
  have hδ'_le_δ₃ : δ' ≤ δ₃ :=
    le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
  set δ₀ : ℝ := (c₁ / (2 * c₂)) * δ'
  have hδ₀_pos : 0 < δ₀ := by positivity
  have hδ₀_le_half : δ₀ ≤ δ' / 2 := by
    have h_div_le : c₁ / (2 * c₂) ≤ 1 / 2 := by
      rw [div_le_div_iff₀ (by positivity) (by positivity)]
      linarith
    calc δ₀ = (c₁ / (2 * c₂)) * δ' := rfl
      _ ≤ (1 / 2) * δ' := mul_le_mul_of_nonneg_right h_div_le (le_of_lt hδ')
      _ = δ' / 2 := by ring
  have hδ₀_le_δ : δ₀ ≤ δ := by linarith
  refine ⟨δ₀, hδ₀_pos, hδ₀_le_δ, ?_⟩
  intro κ hκ w₀ hw₀
  have h_local_cons : ∀ (w : ℝ → 𝓢(ℝ, ℝ)) (t : ℝ),
      (∀ s ∈ Set.uIcc 0 t,
        (∃ v : 𝓢(ℝ, ℝ), HasDerivAt w v s ∧ ∀ x : ℝ, v x = regFlowRHS κ (w s) x) ∧
        ‖ι (w s)‖ ≤ δ') →
      ∀ (M : ℝ), 1 ≤ M → alphaFunctional M (w t) = alphaFunctional M (w 0) := by
    intro w t h_ivl M hM
    let g : ℝ → ℝ := fun τ => alphaFunctional M (w τ)
    have hg_deriv : ∀ s ∈ Set.uIcc 0 t, HasDerivAt g 0 s := by
      intro s hs
      obtain ⟨⟨v, hv_deriv, hv_eq⟩, hs_norm⟩ := h_ivl s hs
      have hs_δ₂ : ‖ι (w s)‖ ≤ δ₂ := le_trans hs_norm hδ'_le_δ₂
      have hs_δ₃ : ‖ι (w s)‖ ≤ δ₃ := le_trans hs_norm hδ'_le_δ₃
      have hd := h_deriv κ hκ M hM w v s hv_deriv hv_eq hs_δ₂
      rw [h_ortho κ hκ M hM (w s) hs_δ₃] at hd
      exact hd
    have h_mvt : ∀ (a b : ℝ), a < b → Set.Icc a b ⊆ Set.uIcc 0 t → g b = g a := by
      intro a b hab h_sub
      have h_cont_ab : ContinuousOn g (Set.Icc a b) :=
        fun x hx => (hg_deriv x (h_sub hx)).continuousAt.continuousWithinAt
      have h_deriv_ab : ∀ x ∈ Set.Ioo a b, HasDerivAt g 0 x :=
        fun x hx => hg_deriv x (h_sub (Set.Ioo_subset_Icc_self hx))
      obtain ⟨c, _, hc_slope⟩ :=
        exists_hasDerivAt_eq_slope g (fun _ => 0) hab h_cont_ab h_deriv_ab
      have h_ne : b - a ≠ 0 := ne_of_gt (sub_pos.mpr hab)
      have h_sub_zero : g b - g a = 0 := (div_eq_zero_iff.mp hc_slope.symm).resolve_right h_ne
      exact sub_eq_zero.mp h_sub_zero
    rcases lt_trichotomy 0 t with ht_pos | rfl | ht_neg
    · exact h_mvt 0 t ht_pos Set.Icc_subset_uIcc
    · rfl
    · exact (h_mvt t 0 ht_neg Set.Icc_subset_uIcc').symm
  have hw₀_half : ‖ι w₀‖ ≤ δ' / 2 := le_trans hw₀ hδ₀_le_half
  have h_trap : ∀ (w : ℝ → 𝓢(ℝ, ℝ)) (t : ℝ),
      w 0 = w₀ →
      (∀ s ∈ Set.uIcc 0 t,
        (∃ v : 𝓢(ℝ, ℝ), HasDerivAt w v s ∧ ∀ x : ℝ, v x = regFlowRHS κ (w s) x) ∧
        ‖ι (w s)‖ ≤ δ') →
      ‖ι (w t)‖ ≤ δ' / 2 := by
    intro w t hw0 h_ivl
    have hw0_δ₁ : ‖ι w₀‖ ≤ δ₁ := by linarith
    have hwt_δ₁ : ‖ι (w t)‖ ≤ δ₁ := le_trans (h_ivl t Set.right_mem_uIcc).2 hδ'_le_δ₁
    have h_cons_1 : alphaFunctional 1 (w t) = alphaFunctional 1 w₀ := by
      rw [← hw0]
      exact h_local_cons w t h_ivl 1 le_rfl
    have h_wt_lower : c₁ * ‖ι (w t)‖ ^ 2 ≤ alphaFunctional 1 (w t) :=
      (h_quad (w t) hwt_δ₁).1
    have h_w0_upper : alphaFunctional 1 w₀ ≤ c₂ * ‖ι w₀‖ ^ 2 :=
      (h_quad w₀ hw0_δ₁).2
    have h_w0_sq : ‖ι w₀‖ ^ 2 ≤ δ₀ ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) hw₀ 2
    have h_c2_le : c₂ * ‖ι w₀‖ ^ 2 ≤ c₂ * δ₀ ^ 2 :=
      mul_le_mul_of_nonneg_left h_w0_sq (le_of_lt hc₂)
