      ext x; push_cast; ring
    rw [h_eq, integral_add (h_fl_int f hf ξ) (h_fl_int g hg ξ), mul_add]
  have h_fl_smul : ∀ (c : ℝ) (f : ℝ → ℝ) (ξ : ℝ),
      fourierLine (fun x => c * f x) ξ = (c : ℂ) * fourierLine f ξ := by
    intro c f ξ
    dsimp [fourierLine]
    have h_eq : (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((c * f x : ℝ) : ℂ)) =
        (fun x : ℝ => (c : ℂ) * (Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (f x : ℂ))) := by
      ext x; push_cast; ring
    rw [h_eq, integral_const_mul, mul_left_comm]
  have h_smul : ∀ (c : ℝ) (f : ℝ → ℝ),
      Integrable (fun ξ : ℝ => (4 + ξ ^ 2) * ‖fourierLine f ξ‖ ^ 2) →
      Integrable (fun ξ : ℝ => (4 + ξ ^ 2) * ‖fourierLine (fun x => c * f x) ξ‖ ^ 2) ∧
      h1NormSq (fun x => c * f x) = c ^ 2 * h1NormSq f := by
    intro c f hf_h1
    have h_eq : (fun ξ : ℝ => (4 + ξ ^ 2) * ‖fourierLine (fun x => c * f x) ξ‖ ^ 2) =
