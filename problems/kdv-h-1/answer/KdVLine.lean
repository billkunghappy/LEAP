            -(1 / 2) * Real.exp (-2 * y) * (f y * Real.exp (2 * y)) +
            (1 / 2 * (Real.exp (2 * y) * 2) * (∫ z in Set.Ioi y, f z * Real.exp (-2 * z)) +
              1 / 2 * Real.exp (2 * y) * -(f y * Real.exp (-2 * y))) := by ring
    have h_exp_int_bound : ∀ (w : 𝓢(ℝ, ℝ)) (y : ℝ),
