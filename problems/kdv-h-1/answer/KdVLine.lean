  exact h_final_alg κ (w0 x) (w1 x) (m0 x) (m1 x) (k0 x) (k1 x) hκ_ne hκ2_ne hm0_ne

theorem recipGreenDiff_sub_and_linearization_peetre_bound (h_bound : ∀ (w : 𝓢(ℝ, ℝ)), ‖ι w‖ ≤ 1 / 4 → ∀ (ℓ : ℕ) (x y : ℝ),
      |greenIterKernel 1 w ℓ x y| ≤ (1 / 2) * (1 / 4) ^ ℓ)
    (h_tele : ∀ (w₁ w₂ : 𝓢(ℝ, ℝ)) (m : ℕ) (x y : ℝ),
      greenIterKernel 1 w₁ (m + 1) x y - greenIterKernel 1 w₂ (m + 1) x y =
        -∫ z : ℝ, (∑ p ∈ Finset.antidiagonal m,
          greenIterKernel 1 w₁ p.1 x z * greenIterKernel 1 w₂ p.2 z y) * (w₁ z - w₂ z))
