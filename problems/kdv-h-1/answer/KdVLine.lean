        have h_sub : x + 1 - x = 1 := by ring
        rw [h_sub, div_one] at hc_eq
        exact hc_eq
      obtain ⟨d, hd, hd_eq⟩ := exists_hasDerivAt_eq_slope (iteratedDeriv 2 f) (iteratedDeriv 3 f)
        hc.1 (h_cont 2 _) (fun y _ => h_deriv 2 y)
      have h_cx_ne : c - x ≠ 0 := ne_of_gt (sub_pos.mpr hc.1)
