            field_simp [hg_ne, hM_ne]
          rw [h_alg, abs_mul, abs_of_pos (div_pos hM_pos (hg_pos x))]
          have h_quot_le : M / diagGreen M w x ≤ 4 * M ^ 2 := by
            have h1 : M / diagGreen M w x ≤ M / (1 / (4 * M)) :=
