      have h1_le : (∫ ξ : ℝ, (2 * D ℓ) * ∫ η : ℝ, ‖fourierLine w₁ (ξ - η)‖ ^ 2 / (2 * π * (1 + ξ ^ 2) * (1 + η ^ 2))) ≤
