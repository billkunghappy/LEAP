            have h2 : M / (1 / (4 * M)) = 4 * M ^ 2 := by field_simp [hM_ne]
            linarith
          have h_diag_peel : |diagGreen M w x - 1 / (2 * M)| ≤ (4 * π * B / M ^ 2) * (1 + x ^ 2)⁻¹ := by
            rw [← h_fg_diag x]
            exact h_peel_sum x x
          calc (M / diagGreen M w x) * |diagGreen M w x - 1 / (2 * M)|
            _ ≤ (4 * M ^ 2) * ((4 * π * B / M ^ 2) * (1 + x ^ 2)⁻¹) :=
              mul_le_mul h_quot_le h_diag_peel (abs_nonneg _) (by positivity)
            _ = (16 * π * B) * (1 + x ^ 2)⁻¹ := by field_simp [hM_ne]; ring
        have hf₁_int : Integrable f₁ volume :=
          (integrable_inv_one_add_sq.const_mul (16 * π * B)).mono'
            hf₁_cont.aestronglyMeasurable (Filter.Eventually.of_forall hf₁_dom)
        let F2 : ℝ → ℝ → ℝ := fun x y => (1 / 2) * (Real.exp (-2 * M * |x - y|) * w y)
        have hF2_cont : Continuous (Function.uncurry F2) := by
          have : Function.uncurry F2 = fun p : ℝ × ℝ => (1 / 2) * (Real.exp (-2 * M * |p.1 - p.2|) * w p.2) := rfl
          rw [this]; have := w.continuous; fun_prop
        have hF2_pw : ∀ p : ℝ × ℝ, ‖Function.uncurry F2 p‖ ≤ ((4 * B) * (1 + p.1 ^ 2)⁻¹) * (1 + p.2 ^ 2)⁻¹ := by
          intro ⟨x, y⟩
          change |(1 / 2) * (Real.exp (-2 * M * |x - y|) * w y)| ≤ ((4 * B) * (1 + x ^ 2)⁻¹) * (1 + y ^ 2)⁻¹
          rw [abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2), abs_of_pos (Real.exp_pos _)]
          have h_exp_le : Real.exp (-2 * M * |x - y|) ≤ Real.exp (-M * |y - x|) := by
            rw [abs_sub_comm x y]
            exact Real.exp_le_exp.mpr (by nlinarith [abs_nonneg (y - x)])
          have h_prod : Real.exp (-2 * M * |x - y|) * |w y| ≤
              Real.exp (-M * |y - x|) * (B * ((1 + y ^ 2)⁻¹) ^ 2) :=
            mul_le_mul h_exp_le (hw_dec y) (abs_nonneg _) (Real.exp_nonneg _)
          calc (1 / 2) * (Real.exp (-2 * M * |x - y|) * |w y|)
            _ ≤ (1 / 2) * (Real.exp (-M * |y - x|) * (B * ((1 + y ^ 2)⁻¹) ^ 2)) :=
              mul_le_mul_of_nonneg_left h_prod (by norm_num)
            _ = ((1 / 2) * B) * (((1 + y ^ 2)⁻¹) ^ 2 * Real.exp (-M * |y - x|)) := by ring
            _ ≤ ((1 / 2) * B) * (8 * (1 + x ^ 2)⁻¹ * (1 + y ^ 2)⁻¹) :=
              mul_le_mul_of_nonneg_left (h_peetre x y) (by positivity)
            _ = ((4 * B) * (1 + x ^ 2)⁻¹) * (1 + y ^ 2)⁻¹ := by ring
        have h_dom2 : Integrable (fun p : ℝ × ℝ => ((4 * B) * (1 + p.1 ^ 2)⁻¹) * (1 + p.2 ^ 2)⁻¹) (volume.prod volume) :=
          (integrable_inv_one_add_sq.const_mul (4 * B)).mul_prod integrable_inv_one_add_sq
        have hF2_int : Integrable (Function.uncurry F2) (volume.prod volume) :=
          h_dom2.mono' hF2_cont.aestronglyMeasurable (Filter.Eventually.of_forall hF2_pw)
        have h_pull2_eq : (fun x : ℝ => (1 / 2) * ∫ y : ℝ, Real.exp (-2 * M * |x - y|) * w y) =
            (fun x : ℝ => ∫ y : ℝ, F2 x y) := by
          ext x; dsimp [F2]; rw [← integral_const_mul]
        have hf₂_int : Integrable (fun x : ℝ => (1 / 2) * ∫ y : ℝ, Real.exp (-2 * M * |x - y|) * w y) volume := by
          rw [h_pull2_eq]; exact hF2_int.integral_prod_left
        exact hf₁_int.add hf₂_int
      exact ⟨h_iter_cont, hG_cont, hg_cont, h_iter_sum_norm, hG_le, hg_bounds, hG_peel, h_rho_int⟩
    set B₁ : ℝ := B₂ + B_Δ
    have hB₁ : 0 ≤ B₁ := add_nonneg hB₂ hB_Δ
    have hw₁_decay : ∀ y : ℝ, |w₁ y| ≤ B₁ * ((1 + y ^ 2)⁻¹) ^ 2 := by
      intro y
      have h_tri : |w₁ y| ≤ |w₂ y| + |w₁ y - w₂ y| := by
        have : w₁ y = w₂ y + (w₁ y - w₂ y) := by ring
        calc |w₁ y| = |w₂ y + (w₁ y - w₂ y)| := congr_arg abs this
          _ ≤ |w₂ y| + |w₁ y - w₂ y| := abs_add_le _ _
      calc |w₁ y|
        _ ≤ B₂ * ((1 + y ^ 2)⁻¹) ^ 2 + B_Δ * ((1 + y ^ 2)⁻¹) ^ 2 :=
