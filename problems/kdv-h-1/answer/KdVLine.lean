    by_cases h_eq : s = s₀
    · subst h_eq
      simp [le_of_lt hε]
    · refine SchwartzMap.seminorm_le_bound' ℝ k n _ (le_of_lt hε) (fun x => ?_)
      have h_ne : s - s₀ ≠ 0 := sub_ne_zero.mpr h_eq
      have h_abs_pos : 0 < |s - s₀| := abs_pos.mpr h_ne
      let ψ : ℝ → ℝ := fun s' => |x| ^ k * (iteratedDeriv n (u s') x - (s' - s₀) * iteratedDeriv n v₁ x)
      let ψ' : ℝ → ℝ := fun s' => |x| ^ k * (iteratedDeriv n ((hu s').choose) x - iteratedDeriv n v₁ x)
      have h_hasDeriv : ∀ s' ∈ Set.uIcc s₀ s, HasDerivWithinAt ψ (ψ' s') (Set.uIcc s₀ s) s' := by
        intro s' _
        have hd1 : HasDerivAt (fun τ => iteratedDeriv n (u τ) x) (iteratedDeriv n ((hu s').choose) x) s' :=
          h_pt_deriv u ((hu s').choose) s' (hu s').choose_spec.1 n x
        have hd2 : HasDerivAt (fun τ => (τ - s₀) * iteratedDeriv n v₁ x) (iteratedDeriv n v₁ x) s' := by
          simpa using ((hasDerivAt_id s').sub_const s₀).mul_const (iteratedDeriv n v₁ x)
        exact ((hd1.sub hd2).const_mul (|x| ^ k)).hasDerivWithinAt
      have h_bound : ∀ s' ∈ Set.uIcc s₀ s, ‖ψ' s'‖ ≤ ε := by
