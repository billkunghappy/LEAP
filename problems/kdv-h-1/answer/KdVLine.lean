        intro s
        have h1 := SchwartzMap.le_seminorm' ℝ 0 n (Δ s) x
        simpa [pow_zero, one_mul, Real.norm_eq_abs] using h1
      have h_neg_lim : Filter.Tendsto (fun s => -SchwartzMap.seminorm ℝ 0 n (Δ s)) (nhds s₀) (nhds 0) := by
        simpa using h_sem_lim.neg
      exact tendsto_of_tendsto_of_tendsto_of_le_of_le' h_neg_lim h_sem_lim
        (Filter.Eventually.of_forall fun s => (abs_le.mp (h_abs_le s)).1)
        (Filter.Eventually.of_forall fun s => (abs_le.mp (h_abs_le s)).2)
    · refine Filter.Eventually.of_forall (fun s hs => ?_)
      rw [sub_eq_zero.mp hs]
      simp
  have h_rev_quot : ∀ (w : ℝ → 𝓢(ℝ, ℝ)) (v₂ : 𝓢(ℝ, ℝ)) (t s₀ : ℝ),
      HasDerivAt w v₂ (t - s₀) →
      Filter.Tendsto (fun s : ℝ => (s - s₀)⁻¹ • (w (t - s) - w (t - s₀) + (s - s₀) • v₂))
