        have h_exp : Complex.exp (-((ξ : ℂ) * (z : ℂ)) * I) * Complex.exp (((η : ℂ) * (z : ℂ)) * I) =
            Complex.exp (-(((ξ - η : ℝ) : ℂ) * (z : ℂ)) * I) := by
          rw [← Complex.exp_add]
          congr 1
          push_cast
          ring
        calc Complex.exp (-((ξ : ℂ) * (z : ℂ)) * I) *
              (iterWavePacket κ w ℓ x η * Complex.exp (((η : ℂ) * (z : ℂ)) * I) / ((κ ^ 2 + η ^ 2 : ℝ) : ℂ) * (w z : ℂ))
          _ = (iterWavePacket κ w ℓ x η / ((κ ^ 2 + η ^ 2 : ℝ) : ℂ)) *
              ((Complex.exp (-((ξ : ℂ) * (z : ℂ)) * I) * Complex.exp (((η : ℂ) * (z : ℂ)) * I)) * (w z : ℂ)) := by ring
          _ = (iterWavePacket κ w ℓ x η / ((κ ^ 2 + η ^ 2 : ℝ) : ℂ)) *
              (Complex.exp (-(((ξ - η : ℝ) : ℂ) * (z : ℂ)) * I) * (w z : ℂ)) := by rw [h_exp]
      have h_int_eq : (∫ z : ℝ, Complex.exp (-((ξ : ℂ) * (z : ℂ)) * I) * ((greenIterKernel κ w ℓ x z * w z : ℝ) : ℂ)) =
          ∫ z : ℝ, (1 / (2 * π) : ℂ) * ∫ η : ℝ, J z η :=
        integral_congr_ae (Filter.Eventually.of_forall h_z)
      rw [h_int_eq, integral_const_mul]
    have hJ_int : Integrable (Function.uncurry J) (volume.prod volume) := by
      let h1 : ℝ → ℝ := fun z => ‖w z‖
      let h2 : ℝ → ℝ := fun η => M_ℓ * (1 / (κ ^ 2 + η ^ 2))
      have hh1_int : Integrable h1 volume := w.integrable.norm
      have hh2_int : Integrable h2 volume := h_inv_int.const_mul M_ℓ
      have hJ_cont : Continuous (Function.uncurry J) := by
        have h_c1 : Continuous (fun p : ℝ × ℝ => iterWavePacket κ w ℓ x p.2 / ((κ ^ 2 + p.2 ^ 2 : ℝ) : ℂ)) :=
          (h_cont_ℓ.comp continuous_snd).div
            (Complex.continuous_ofReal.comp (continuous_const.add (continuous_snd.pow 2)))
            (fun p => Complex.ofReal_ne_zero.mpr (ne_of_gt (h_denom_pos p.2)))
        have h_c2 : Continuous (fun p : ℝ × ℝ => Complex.exp (-(((ξ - p.2 : ℝ) : ℂ) * (p.1 : ℂ)) * I)) :=
          Complex.continuous_exp.comp
            ((((Complex.continuous_ofReal.comp (continuous_const.sub continuous_snd)).mul
              (Complex.continuous_ofReal.comp continuous_fst)).neg).mul continuous_const)
        have h_c3 : Continuous (fun p : ℝ × ℝ => (w p.1 : ℂ)) :=
          Complex.continuous_ofReal.comp (w.continuous.comp continuous_fst)
        exact h_c1.mul (h_c2.mul h_c3)
      refine (hh1_int.mul_prod hh2_int).mono' hJ_cont.aestronglyMeasurable
        (Filter.Eventually.of_forall fun p => ?_)
      dsimp only [Function.uncurry, J, h1, h2]
      rw [norm_mul, norm_div, norm_mul,
          show -(((ξ - p.2 : ℝ) : ℂ) * (p.1 : ℂ)) * I = (((-((ξ - p.2) * p.1) : ℝ) : ℂ) * I) by push_cast; ring,
          Complex.norm_exp_ofReal_mul_I, one_mul,
          Complex.norm_of_nonneg (le_of_lt (h_denom_pos p.2)),
          Complex.norm_real]
      have h_le : ‖iterWavePacket κ w ℓ x p.2‖ / (κ ^ 2 + p.2 ^ 2) ≤ M_ℓ * (1 / (κ ^ 2 + p.2 ^ 2)) := by
        rw [div_eq_mul_one_div]
        exact mul_le_mul_of_nonneg_right (hM_ℓ p.2) (by positivity)
      calc (‖iterWavePacket κ w ℓ x p.2‖ / (κ ^ 2 + p.2 ^ 2)) * ‖w p.1‖
        _ = ‖w p.1‖ * (‖iterWavePacket κ w ℓ x p.2‖ / (κ ^ 2 + p.2 ^ 2)) := by ring
        _ ≤ ‖w p.1‖ * (M_ℓ * (1 / (κ ^ 2 + p.2 ^ 2))) :=
          mul_le_mul_of_nonneg_left h_le (norm_nonneg _)
    rw [h_lhs, MeasureTheory.integral_integral_swap hJ_int]
    have h_2pi : (1 / (2 * π) : ℂ) = ((Real.sqrt (2 * π))⁻¹ : ℂ) * ((Real.sqrt (2 * π))⁻¹ : ℂ) := by
      have h_re : (1 / (2 * π) : ℝ) = (Real.sqrt (2 * π))⁻¹ * (Real.sqrt (2 * π))⁻¹ := by
        rw [one_div, ← mul_inv, Real.mul_self_sqrt (by positivity)]
      exact_mod_cast h_re
    rw [h_2pi, mul_assoc, ← integral_const_mul, neg_mul]
    congr 2
    refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
    dsimp only [J, fourierLine]
    rw [integral_const_mul]
    ring
  refine ⟨?_, ?_, ?_⟩
  · have h_id1 := h_diag_inner 1
    have h_eq_int :
        (∫ ξ : ℝ, iterWavePacket κ w 1 x ξ * star (iterWavePacket κ w 1 x ξ) / ((κ ^ 2 + ξ ^ 2 : ℝ) : ℂ)) =
          ((∫ ξ : ℝ, ‖iterWavePacket κ w 1 x ξ‖ ^ 2 / (κ ^ 2 + ξ ^ 2) : ℝ) : ℂ) := by
      have h_congr :
          (∫ ξ : ℝ, iterWavePacket κ w 1 x ξ * star (iterWavePacket κ w 1 x ξ) / ((κ ^ 2 + ξ ^ 2 : ℝ) : ℂ)) =
            ∫ ξ : ℝ, ((‖iterWavePacket κ w 1 x ξ‖ ^ 2 / (κ ^ 2 + ξ ^ 2) : ℝ) : ℂ) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
        dsimp only
        rw [← starRingEnd_apply, Complex.mul_conj', ← Complex.ofReal_pow, ← Complex.ofReal_div]
      rw [h_congr]
      exact integral_ofReal
    rw [h_eq_int, show (1 / (2 * π) : ℂ) = ((1 / (2 * π) : ℝ) : ℂ) by push_cast; rfl,
        ← Complex.ofReal_mul] at h_id1
    exact Complex.ofReal_injective h_id1
  · intro ℓ
    have h_id := congrArg norm (h_diag_inner ℓ)
    rw [Complex.norm_real, Real.norm_eq_abs, norm_mul,
        show (1 / (2 * π) : ℂ) = ((1 / (2 * π) : ℝ) : ℂ) by push_cast; rfl,
        Complex.norm_of_nonneg (by positivity : (0 : ℝ) ≤ 1 / (2 * π))] at h_id
    rw [h_id]
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    calc ‖∫ ξ : ℝ, iterWavePacket κ w ℓ x ξ * star (iterWavePacket κ w 1 x ξ) / ((κ ^ 2 + ξ ^ 2 : ℝ) : ℂ)‖
      _ ≤ ∫ ξ : ℝ, ‖iterWavePacket κ w ℓ x ξ * star (iterWavePacket κ w 1 x ξ) / ((κ ^ 2 + ξ ^ 2 : ℝ) : ℂ)‖ :=
        norm_integral_le_integral_norm _
      _ = ∫ ξ : ℝ, ‖iterWavePacket κ w ℓ x ξ‖ * ‖iterWavePacket κ w 1 x ξ‖ / (κ ^ 2 + ξ ^ 2) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
        dsimp only
        rw [norm_div, norm_mul, norm_star,
            Complex.norm_of_nonneg (le_of_lt (h_denom_pos ξ))]
  · intro ℓ ξ
    have h_id := congrArg norm (h_step_eq ℓ ξ)
    rw [norm_mul, norm_neg, norm_inv,
        Complex.norm_of_nonneg (by positivity : (0 : ℝ) ≤ Real.sqrt (2 * π))] at h_id
    rw [h_id]
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    calc ‖∫ η : ℝ, iterWavePacket κ w ℓ x η * fourierLine w (ξ - η) / ((κ ^ 2 + η ^ 2 : ℝ) : ℂ)‖
      _ ≤ ∫ η : ℝ, ‖iterWavePacket κ w ℓ x η * fourierLine w (ξ - η) / ((κ ^ 2 + η ^ 2 : ℝ) : ℂ)‖ :=
        norm_integral_le_integral_norm _
      _ = ∫ η : ℝ, ‖iterWavePacket κ w ℓ x η‖ * ‖fourierLine w (ξ - η)‖ / (κ ^ 2 + η ^ 2) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
        dsimp only
        rw [norm_div, norm_mul,
            Complex.norm_of_nonneg (le_of_lt (h_denom_pos η))]

theorem greenIterKernel_diag_pointwise_and_domination (κ : ℝ) (hκ : 1 ≤ κ) (w : 𝓢(ℝ, ℝ))
    (r : ℝ) (hr : 0 ≤ r)
    (h_int : Integrable (fun p : ℝ × ℝ =>
      ‖fourierLine w (p.1 - p.2)‖ ^ 2 / (2 * π * (κ ^ 2 + p.1 ^ 2) * (κ ^ 2 + p.2 ^ 2))))
    (h_hs : (∫ ξ : ℝ, ∫ η : ℝ,
      ‖fourierLine w (ξ - η)‖ ^ 2 / (2 * π * (κ ^ 2 + ξ ^ 2) * (κ ^ 2 + η ^ 2))) ≤ r ^ 2) :
    (∀ ℓ : ℕ, ∀ x : ℝ, |greenIterKernel κ w ℓ x x| ≤ (1 / (2 * κ)) * r ^ ℓ) ∧
    (∀ x : ℝ, (greenIterKernel κ w 1 x x) ^ 2 ≤ (1 / (2 * κ)) * greenIterKernel κ w 2 x x) ∧
    (∀ m : ℕ, ∀ x : ℝ, |greenIterKernel κ w (m + 2) x x| ≤ r ^ m * greenIterKernel κ w 2 x x) :=
by
  obtain ⟨⟨h_inv_int, h_inv_eq⟩, h_fg⟩ := freeGreenKernel_fourier_integral_eq κ hκ
  obtain ⟨h_pkt, h_iter_eq, h_diag_mod⟩ :=
    iterWavePacket_continuous_and_greenIterKernel_eq κ hκ w h_fg
  have hκ_pos : 0 < κ := by linarith
  have h_2pi_pos : (0 : ℝ) < 2 * π := by positivity
  have h_denom_pos : ∀ ξ : ℝ, 0 < κ ^ 2 + ξ ^ 2 := fun ξ => by positivity
  have h_prod_int : ∀ (A B : ℝ → ℝ) (M_A M_B : ℝ),
      Continuous A → Continuous B → 0 ≤ M_A → 0 ≤ M_B →
      (∀ ξ : ℝ, |A ξ| ≤ M_A) → (∀ ξ : ℝ, |B ξ| ≤ M_B) →
      Integrable (fun ξ : ℝ => A ξ * B ξ / (κ ^ 2 + ξ ^ 2)) := by
    intro A B M_A M_B hA_cont hB_cont hMA _hMB hA_le hB_le
    have h_cont : Continuous (fun ξ : ℝ => A ξ * B ξ / (κ ^ 2 + ξ ^ 2)) :=
      (hA_cont.mul hB_cont).div (continuous_const.add (continuous_pow 2))
        (fun ξ => ne_of_gt (h_denom_pos ξ))
    refine (h_inv_int.const_mul (M_A * M_B)).mono' h_cont.aestronglyMeasurable
      (Filter.Eventually.of_forall fun ξ => ?_)
    rw [Real.norm_eq_abs, abs_div, abs_mul, abs_of_pos (h_denom_pos ξ)]
    have h_ab : |A ξ| * |B ξ| ≤ M_A * M_B :=
      mul_le_mul (hA_le ξ) (hB_le ξ) (abs_nonneg _) hMA
    calc |A ξ| * |B ξ| / (κ ^ 2 + ξ ^ 2)
      _ ≤ (M_A * M_B) / (κ ^ 2 + ξ ^ 2) :=
        div_le_div_of_nonneg_right h_ab (le_of_lt (h_denom_pos ξ))
      _ = (M_A * M_B) * (1 / (κ ^ 2 + ξ ^ 2)) := by ring
  have h_sq_int : ∀ (A : ℝ → ℝ) (M_A : ℝ),
      Continuous A → 0 ≤ M_A → (∀ ξ : ℝ, |A ξ| ≤ M_A) →
      Integrable (fun ξ : ℝ => A ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) := by
    intro A M_A hA_cont hMA hA_le
    have h_eq : (fun ξ : ℝ => A ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) =
        (fun ξ : ℝ => A ξ * A ξ / (κ ^ 2 + ξ ^ 2)) := by
      ext ξ; ring
    rw [h_eq]
    exact h_prod_int A A M_A M_A hA_cont hA_cont hMA hMA hA_le hA_le
  have h_wcs : ∀ (A B : ℝ → ℝ) (M_A M_B : ℝ),
      Continuous A → Continuous B → 0 ≤ M_A → 0 ≤ M_B →
      (∀ ξ : ℝ, |A ξ| ≤ M_A) → (∀ ξ : ℝ, |B ξ| ≤ M_B) →
      (∫ ξ : ℝ, A ξ * B ξ / (κ ^ 2 + ξ ^ 2)) ^ 2 ≤
        (∫ ξ : ℝ, A ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) * (∫ ξ : ℝ, B ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) := by
    intro A B M_A M_B hA_cont hB_cont hMA hMB hA_le hB_le
    have hIA_int := h_sq_int A M_A hA_cont hMA hA_le
    have hIB_int := h_sq_int B M_B hB_cont hMB hB_le
    have hIAB_int := h_prod_int A B M_A M_B hA_cont hB_cont hMA hMB hA_le hB_le
    set I_A := ∫ ξ : ℝ, A ξ ^ 2 / (κ ^ 2 + ξ ^ 2)
    set I_B := ∫ ξ : ℝ, B ξ ^ 2 / (κ ^ 2 + ξ ^ 2)
    set I_AB := ∫ ξ : ℝ, A ξ * B ξ / (κ ^ 2 + ξ ^ 2)
    have hIB_nn : 0 ≤ I_B :=
      integral_nonneg (fun ξ => div_nonneg (sq_nonneg _) (le_of_lt (h_denom_pos ξ)))
    have h_quad : ∀ t : ℝ, 0 ≤ I_A - 2 * t * I_AB + t ^ 2 * I_B := by
      intro t
      have h_nn : 0 ≤ ∫ ξ : ℝ, (A ξ - t * B ξ) ^ 2 / (κ ^ 2 + ξ ^ 2) :=
        integral_nonneg (fun ξ => div_nonneg (sq_nonneg _) (le_of_lt (h_denom_pos ξ)))
      have h_eq_int : (∫ ξ : ℝ, (A ξ - t * B ξ) ^ 2 / (κ ^ 2 + ξ ^ 2)) =
          I_A - 2 * t * I_AB + t ^ 2 * I_B := by
        calc (∫ ξ : ℝ, (A ξ - t * B ξ) ^ 2 / (κ ^ 2 + ξ ^ 2))
          _ = ∫ ξ : ℝ, ((A ξ ^ 2 / (κ ^ 2 + ξ ^ 2) - (2 * t) * (A ξ * B ξ / (κ ^ 2 + ξ ^ 2))) +
                t ^ 2 * (B ξ ^ 2 / (κ ^ 2 + ξ ^ 2))) := by
            congr 1; ext ξ; ring
          _ = (∫ ξ : ℝ, (A ξ ^ 2 / (κ ^ 2 + ξ ^ 2) - (2 * t) * (A ξ * B ξ / (κ ^ 2 + ξ ^ 2)))) +
              (∫ ξ : ℝ, t ^ 2 * (B ξ ^ 2 / (κ ^ 2 + ξ ^ 2))) :=
            integral_add (hIA_int.sub (hIAB_int.const_mul (2 * t))) (hIB_int.const_mul (t ^ 2))
          _ = (∫ ξ : ℝ, A ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) -
              (∫ ξ : ℝ, (2 * t) * (A ξ * B ξ / (κ ^ 2 + ξ ^ 2))) +
              (∫ ξ : ℝ, t ^ 2 * (B ξ ^ 2 / (κ ^ 2 + ξ ^ 2))) := by
            rw [integral_sub hIA_int (hIAB_int.const_mul (2 * t))]
          _ = I_A - 2 * t * I_AB + t ^ 2 * I_B := by
            rw [integral_const_mul, integral_const_mul]
      linarith
    by_cases hIB_zero : I_B = 0
    · have hIAB_zero : I_AB = 0 := by
        by_contra h_ne
        have hq := h_quad ((I_A + 1) / (2 * I_AB))
        rw [hIB_zero, mul_zero, add_zero] at hq
        have h_cancel : 2 * ((I_A + 1) / (2 * I_AB)) * I_AB = I_A + 1 := by
          field_simp [h_ne]
        linarith
      rw [hIAB_zero, hIB_zero]
      norm_num
    · have hIB_pos : 0 < I_B := lt_of_le_of_ne hIB_nn (Ne.symm hIB_zero)
      have hq := h_quad (I_AB / I_B)
      have hq_mul := mul_nonneg (le_of_lt hIB_pos) hq
      have h_id : I_B * (I_A - 2 * (I_AB / I_B) * I_AB + (I_AB / I_B) ^ 2 * I_B) =
          I_A * I_B - I_AB ^ 2 := by
        field_simp [hIB_zero]
        ring
      linarith
  have h_fl_cont_bound : Continuous (fourierLine w) ∧
      ∃ C_w : ℝ, 0 ≤ C_w ∧ ∀ ζ : ℝ, ‖fourierLine w ζ‖ ≤ C_w := by
    let K : ℝ → ℝ → ℂ := fun ζ z => Complex.exp (-((ζ : ℂ) * (z : ℂ)) * I) * (w z : ℂ)
    let bound : ℝ → ℝ := fun z => ‖w z‖
    have hw_int : Integrable bound volume := w.integrable.norm
    have hK_meas : ∀ ζ : ℝ, AEStronglyMeasurable (K ζ) volume := by
      intro ζ
      have hc : Continuous (K ζ) := by
        dsimp [K]
        exact (Complex.continuous_exp.comp
          (((continuous_const.mul Complex.continuous_ofReal).neg).mul continuous_const)).mul
          (Complex.continuous_ofReal.comp w.continuous)
      exact hc.aestronglyMeasurable
    have hK_dom : ∀ ζ : ℝ, ∀ᵐ z : ℝ ∂volume, ‖K ζ z‖ ≤ bound z := by
      intro ζ
      filter_upwards with z
      dsimp [K, bound]
      rw [norm_mul, show -((ζ : ℂ) * (z : ℂ)) * I = (((-(ζ * z) : ℝ) : ℂ) * I) by push_cast; ring,
          Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real]
      exact le_rfl
    have hK_cont : ∀ᵐ z : ℝ ∂volume, Continuous (fun ζ : ℝ => K ζ z) := by
      filter_upwards with z
      dsimp [K]
      exact (Complex.continuous_exp.comp
        (((Complex.continuous_ofReal.mul continuous_const).neg).mul continuous_const)).mul
        continuous_const
    have h_int_cont : Continuous (fun ζ : ℝ => ∫ z : ℝ, K ζ z) :=
      continuous_of_dominated hK_meas hK_dom hw_int hK_cont
    refine ⟨continuous_const.mul h_int_cont,
      ‖((Real.sqrt (2 * π))⁻¹ : ℂ)‖ * ∫ z : ℝ, bound z,
      mul_nonneg (norm_nonneg _) (integral_nonneg (fun z => norm_nonneg _)), ?_⟩
    intro ζ
    dsimp [fourierLine]
    rw [norm_mul]
    refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
    calc ‖∫ z : ℝ, K ζ z‖
      _ ≤ ∫ z : ℝ, ‖K ζ z‖ := norm_integral_le_integral_norm (K ζ)
      _ ≤ ∫ z : ℝ, bound z :=
        integral_mono_ae ((hw_int.mono' (hK_meas ζ) (hK_dom ζ)).norm) hw_int (hK_dom ζ)
  obtain ⟨h_fl_cont, C_w, hC_w, h_fl_le⟩ := h_fl_cont_bound
  have h_all_x : ∀ x : ℝ,
      (∀ ℓ : ℕ, |greenIterKernel κ w ℓ x x| ≤ (1 / (2 * κ)) * r ^ ℓ) ∧
      ((greenIterKernel κ w 1 x x) ^ 2 ≤ (1 / (2 * κ)) * greenIterKernel κ w 2 x x) ∧
      (∀ m : ℕ, |greenIterKernel κ w (m + 2) x x| ≤ r ^ m * greenIterKernel κ w 2 x x) := by
    intro x
    obtain ⟨h_h2_eq, h_shift_le, h_step_le⟩ :=
      iterWavePacket_diag_shift_and_step_le κ hκ w x (fun ℓ => h_pkt ℓ x) (fun ℓ y => h_iter_eq ℓ x y)
    let A : ℕ → ℝ → ℝ := fun ℓ ξ => ‖iterWavePacket κ w ℓ x ξ‖
    let E : ℕ → ℝ := fun ℓ => (1 / (2 * π)) * ∫ ξ : ℝ, A ℓ ξ ^ 2 / (κ ^ 2 + ξ ^ 2)
    have hA_cont : ∀ ℓ : ℕ, Continuous (A ℓ) := fun ℓ => (h_pkt ℓ x).1.norm
    have hA_bound : ∀ ℓ : ℕ, ∃ M : ℝ, 0 ≤ M ∧ ∀ ξ : ℝ, |A ℓ ξ| ≤ M := by
      intro ℓ
      obtain ⟨M, hM, hM_le⟩ := (h_pkt ℓ x).2
      refine ⟨M, hM, fun ξ => ?_⟩
      dsimp [A]
      rw [abs_of_nonneg (norm_nonneg _)]
      exact hM_le ξ
    have hE_nn : ∀ ℓ : ℕ, 0 ≤ E ℓ := by
      intro ℓ
      dsimp [E]
      exact mul_nonneg (by positivity)
        (integral_nonneg (fun ξ => div_nonneg (sq_nonneg _) (le_of_lt (h_denom_pos ξ))))
    have hE0 : E 0 = 1 / (2 * κ) := by
      dsimp [E, A, iterWavePacket]
      have h_norm0 : ∀ ξ : ℝ, ‖Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I)‖ ^ 2 = 1 := by
        intro ξ
        rw [show -((ξ : ℂ) * (x : ℂ)) * I = (((-(ξ * x) : ℝ) : ℂ) * I) by push_cast; ring,
            Complex.norm_exp_ofReal_mul_I, one_pow]
      simp_rw [h_norm0]
      exact h_inv_eq
    have hE1 : E 1 = greenIterKernel κ w 2 x x := h_h2_eq.symm
    have hE_step : ∀ ℓ : ℕ, E (ℓ + 1) ≤ r ^ 2 * E ℓ := by
      intro ℓ
      obtain ⟨M_ℓ, hM_ℓ, hA_ℓ⟩ := hA_bound ℓ
      obtain ⟨M_ℓ1, hM_ℓ1, hA_ℓ1⟩ := hA_bound (ℓ + 1)
      have h_pw_ξ : ∀ ξ : ℝ,
          (1 / (2 * π)) * (A (ℓ + 1) ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) ≤
            E ℓ * ∫ η : ℝ, ‖fourierLine w (ξ - η)‖ ^ 2 / (2 * π * (κ ^ 2 + ξ ^ 2) * (κ ^ 2 + η ^ 2)) := by
        intro ξ
        let B_ξ : ℝ → ℝ := fun η => ‖fourierLine w (ξ - η)‖
        have hB_cont : Continuous B_ξ := (h_fl_cont.comp (continuous_const.sub continuous_id)).norm
        have hB_le : ∀ η : ℝ, |B_ξ η| ≤ C_w := by
          intro η
          dsimp [B_ξ]
          rw [abs_of_nonneg (norm_nonneg _)]
          exact h_fl_le (ξ - η)
        have h_sq_ξ : A (ℓ + 1) ξ ^ 2 ≤
            E ℓ * ∫ η : ℝ, B_ξ η ^ 2 / (κ ^ 2 + η ^ 2) := by
          calc A (ℓ + 1) ξ ^ 2
            _ ≤ ((Real.sqrt (2 * π))⁻¹ * ∫ η : ℝ, A ℓ η * B_ξ η / (κ ^ 2 + η ^ 2)) ^ 2 :=
              pow_le_pow_left₀ (norm_nonneg _) (h_step_le ℓ ξ) 2
            _ = (1 / (2 * π)) * (∫ η : ℝ, A ℓ η * B_ξ η / (κ ^ 2 + η ^ 2)) ^ 2 := by
              rw [mul_pow, inv_pow, Real.sq_sqrt (le_of_lt h_2pi_pos), one_div]
            _ ≤ (1 / (2 * π)) *
                ((∫ η : ℝ, A ℓ η ^ 2 / (κ ^ 2 + η ^ 2)) * (∫ η : ℝ, B_ξ η ^ 2 / (κ ^ 2 + η ^ 2))) :=
              mul_le_mul_of_nonneg_left
                (h_wcs (A ℓ) B_ξ M_ℓ C_w (hA_cont ℓ) hB_cont hM_ℓ hC_w hA_ℓ hB_le) (by positivity)
            _ = E ℓ * ∫ η : ℝ, B_ξ η ^ 2 / (κ ^ 2 + η ^ 2) := by
              dsimp [E]; ring
        have h_inner_eq :
            (1 / (2 * π * (κ ^ 2 + ξ ^ 2))) * (∫ η : ℝ, B_ξ η ^ 2 / (κ ^ 2 + η ^ 2)) =
              ∫ η : ℝ, ‖fourierLine w (ξ - η)‖ ^ 2 / (2 * π * (κ ^ 2 + ξ ^ 2) * (κ ^ 2 + η ^ 2)) := by
          rw [← integral_const_mul]
          congr 1
          ext η
          dsimp [B_ξ]
          have h1 : (2 * π : ℝ) ≠ 0 := ne_of_gt h_2pi_pos
          have h2 : κ ^ 2 + ξ ^ 2 ≠ 0 := ne_of_gt (h_denom_pos ξ)
          have h3 : κ ^ 2 + η ^ 2 ≠ 0 := ne_of_gt (h_denom_pos η)
          field_simp
        have h_lhs_eq :
            (1 / (2 * π)) * (A (ℓ + 1) ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) =
              (1 / (2 * π * (κ ^ 2 + ξ ^ 2))) * A (ℓ + 1) ξ ^ 2 := by
          have h1 : (2 * π : ℝ) ≠ 0 := ne_of_gt h_2pi_pos
          have h2 : κ ^ 2 + ξ ^ 2 ≠ 0 := ne_of_gt (h_denom_pos ξ)
          field_simp
        calc (1 / (2 * π)) * (A (ℓ + 1) ξ ^ 2 / (κ ^ 2 + ξ ^ 2))
          _ = (1 / (2 * π * (κ ^ 2 + ξ ^ 2))) * A (ℓ + 1) ξ ^ 2 := h_lhs_eq
          _ ≤ (1 / (2 * π * (κ ^ 2 + ξ ^ 2))) * (E ℓ * ∫ η : ℝ, B_ξ η ^ 2 / (κ ^ 2 + η ^ 2)) :=
            mul_le_mul_of_nonneg_left h_sq_ξ (by positivity)
          _ = E ℓ * ((1 / (2 * π * (κ ^ 2 + ξ ^ 2))) * ∫ η : ℝ, B_ξ η ^ 2 / (κ ^ 2 + η ^ 2)) := by ring
          _ = E ℓ * ∫ η : ℝ, ‖fourierLine w (ξ - η)‖ ^ 2 / (2 * π * (κ ^ 2 + ξ ^ 2) * (κ ^ 2 + η ^ 2)) := by
            rw [h_inner_eq]
      have h_lhs_int : Integrable (fun ξ : ℝ => (1 / (2 * π)) * (A (ℓ + 1) ξ ^ 2 / (κ ^ 2 + ξ ^ 2))) :=
        (h_sq_int (A (ℓ + 1)) M_ℓ1 (hA_cont (ℓ + 1)) hM_ℓ1 hA_ℓ1).const_mul (1 / (2 * π))
      have h_rhs_int : Integrable (fun ξ : ℝ =>
          E ℓ * ∫ η : ℝ, ‖fourierLine w (ξ - η)‖ ^ 2 / (2 * π * (κ ^ 2 + ξ ^ 2) * (κ ^ 2 + η ^ 2))) :=
        (h_int.integral_prod_left).const_mul (E ℓ)
      calc E (ℓ + 1)
        _ = ∫ ξ : ℝ, (1 / (2 * π)) * (A (ℓ + 1) ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) := by
          dsimp [E]
          rw [integral_const_mul]
        _ ≤ ∫ ξ : ℝ, E ℓ * ∫ η : ℝ, ‖fourierLine w (ξ - η)‖ ^ 2 / (2 * π * (κ ^ 2 + ξ ^ 2) * (κ ^ 2 + η ^ 2)) :=
          integral_mono h_lhs_int h_rhs_int h_pw_ξ
        _ = E ℓ * ∫ ξ : ℝ, ∫ η : ℝ, ‖fourierLine w (ξ - η)‖ ^ 2 / (2 * π * (κ ^ 2 + ξ ^ 2) * (κ ^ 2 + η ^ 2)) :=
          integral_const_mul _ _
        _ ≤ E ℓ * r ^ 2 := mul_le_mul_of_nonneg_left h_hs (hE_nn ℓ)
        _ = r ^ 2 * E ℓ := by ring
    have hE_pow : ∀ ℓ : ℕ, E ℓ ≤ (1 / (2 * κ)) * (r ^ ℓ) ^ 2 := by
      intro ℓ
      induction ℓ with
      | zero =>
        rw [hE0, pow_zero, one_pow, mul_one]
      | succ ℓ ih =>
        calc E (ℓ + 1)
          _ ≤ r ^ 2 * E ℓ := hE_step ℓ
          _ ≤ r ^ 2 * ((1 / (2 * κ)) * (r ^ ℓ) ^ 2) :=
            mul_le_mul_of_nonneg_left ih (sq_nonneg r)
          _ = (1 / (2 * κ)) * (r ^ (ℓ + 1)) ^ 2 := by ring
    have hE_shift_pow : ∀ m : ℕ, E (m + 1) ≤ (r ^ m) ^ 2 * E 1 := by
      intro m
      induction m with
      | zero =>
        rw [pow_zero, one_pow, one_mul]
      | succ m ih =>
        calc E (m + 2)
          _ ≤ r ^ 2 * E (m + 1) := hE_step (m + 1)
          _ ≤ r ^ 2 * ((r ^ m) ^ 2 * E 1) :=
            mul_le_mul_of_nonneg_left ih (sq_nonneg r)
          _ = (r ^ (m + 1)) ^ 2 * E 1 := by ring
    have h_diag_sq : ∀ ℓ : ℕ, (greenIterKernel κ w ℓ x x) ^ 2 ≤ (1 / (2 * κ)) * E ℓ := by
      intro ℓ
      obtain ⟨M_ℓ, hM_ℓ, hA_ℓ⟩ := hA_bound ℓ
      have h_mod := h_diag_mod ℓ x
      have h_eq1 : (fun ξ : ℝ => A ℓ ξ / (κ ^ 2 + ξ ^ 2)) =
          (fun ξ : ℝ => A ℓ ξ * 1 / (κ ^ 2 + ξ ^ 2)) := by
        ext ξ; ring
      have h_eq_one : (fun ξ : ℝ => (1 : ℝ) ^ 2 / (κ ^ 2 + ξ ^ 2)) =
          (fun ξ : ℝ => 1 / (κ ^ 2 + ξ ^ 2)) := by
        ext ξ; ring
      have h_cs := h_wcs (A ℓ) (fun _ => 1) M_ℓ 1 (hA_cont ℓ) continuous_const hM_ℓ zero_le_one
        hA_ℓ (fun _ => by norm_num)
      rw [← h_eq1, h_eq_one] at h_cs
      calc (greenIterKernel κ w ℓ x x) ^ 2
        _ = |greenIterKernel κ w ℓ x x| ^ 2 := (sq_abs _).symm
        _ ≤ ((1 / (2 * π)) * ∫ ξ : ℝ, A ℓ ξ / (κ ^ 2 + ξ ^ 2)) ^ 2 :=
          pow_le_pow_left₀ (abs_nonneg _) h_mod 2
        _ = (1 / (2 * π)) ^ 2 * (∫ ξ : ℝ, A ℓ ξ / (κ ^ 2 + ξ ^ 2)) ^ 2 := by ring
        _ ≤ (1 / (2 * π)) ^ 2 *
            ((∫ ξ : ℝ, A ℓ ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) * (∫ ξ : ℝ, 1 / (κ ^ 2 + ξ ^ 2))) :=
          mul_le_mul_of_nonneg_left h_cs (by positivity)
        _ = ((1 / (2 * π)) * ∫ ξ : ℝ, 1 / (κ ^ 2 + ξ ^ 2)) * E ℓ := by
          dsimp [E]; ring
        _ = (1 / (2 * κ)) * E ℓ := by rw [h_inv_eq]
    refine ⟨?_, ?_, ?_⟩
    · intro ℓ
      have h_sq : (greenIterKernel κ w ℓ x x) ^ 2 ≤ ((1 / (2 * κ)) * r ^ ℓ) ^ 2 := by
        calc (greenIterKernel κ w ℓ x x) ^ 2
          _ ≤ (1 / (2 * κ)) * E ℓ := h_diag_sq ℓ
          _ ≤ (1 / (2 * κ)) * ((1 / (2 * κ)) * (r ^ ℓ) ^ 2) :=
            mul_le_mul_of_nonneg_left (hE_pow ℓ) (by positivity)
          _ = ((1 / (2 * κ)) * r ^ ℓ) ^ 2 := by ring
      exact abs_le.mpr (abs_le_of_sq_le_sq' h_sq (by positivity))
    · calc (greenIterKernel κ w 1 x x) ^ 2
        _ ≤ (1 / (2 * κ)) * E 1 := h_diag_sq 1
        _ = (1 / (2 * κ)) * greenIterKernel κ w 2 x x := by rw [hE1]
    · intro m
      obtain ⟨M_m1, hM_m1, hA_m1⟩ := hA_bound (m + 1)
      obtain ⟨M_1, hM_1, hA_1⟩ := hA_bound 1
      have h_cs := h_wcs (A (m + 1)) (A 1) M_m1 M_1 (hA_cont (m + 1)) (hA_cont 1)
        hM_m1 hM_1 hA_m1 hA_1
      have h_sq : (greenIterKernel κ w (m + 2) x x) ^ 2 ≤ (r ^ m * greenIterKernel κ w 2 x x) ^ 2 := by
        calc (greenIterKernel κ w (m + 2) x x) ^ 2
          _ = |greenIterKernel κ w (m + 2) x x| ^ 2 := (sq_abs _).symm
          _ ≤ ((1 / (2 * π)) * ∫ ξ : ℝ, A (m + 1) ξ * A 1 ξ / (κ ^ 2 + ξ ^ 2)) ^ 2 :=
            pow_le_pow_left₀ (abs_nonneg _) (h_shift_le (m + 1)) 2
          _ = (1 / (2 * π)) ^ 2 * (∫ ξ : ℝ, A (m + 1) ξ * A 1 ξ / (κ ^ 2 + ξ ^ 2)) ^ 2 := by ring
          _ ≤ (1 / (2 * π)) ^ 2 *
              ((∫ ξ : ℝ, A (m + 1) ξ ^ 2 / (κ ^ 2 + ξ ^ 2)) *
                (∫ ξ : ℝ, A 1 ξ ^ 2 / (κ ^ 2 + ξ ^ 2))) :=
            mul_le_mul_of_nonneg_left h_cs (by positivity)
          _ = E (m + 1) * E 1 := by
            dsimp [E]; ring
          _ ≤ ((r ^ m) ^ 2 * E 1) * E 1 :=
            mul_le_mul_of_nonneg_right (hE_shift_pow m) (hE_nn 1)
          _ = (r ^ m * E 1) ^ 2 := by ring
          _ = (r ^ m * greenIterKernel κ w 2 x x) ^ 2 := by rw [hE1]
      have h_rhs_nn : 0 ≤ r ^ m * greenIterKernel κ w 2 x x := by
        rw [← hE1]
        exact mul_nonneg (pow_nonneg hr m) (hE_nn 1)
      exact abs_le.mpr (abs_le_of_sq_le_sq' h_sq h_rhs_nn)
  exact ⟨fun ℓ x => (h_all_x x).1 ℓ, fun x => (h_all_x x).2.1, fun m x => (h_all_x x).2.2 m⟩

theorem greenIterKernel_two_spatial_integral_le (κ : ℝ) (hκ : 1 ≤ κ) (w : 𝓢(ℝ, ℝ)) :
    Integrable (fun x : ℝ => greenIterKernel κ w 2 x x) ∧
    (∫ x : ℝ, greenIterKernel κ w 2 x x) ≤ (1 / κ ^ 3) * hm1KappaSq κ (ι w) :=
by
  have hκ_pos : 0 < κ := by linarith
  have hκ_ne : κ ≠ 0 := ne_of_gt hκ_pos
  have hw_cont : Continuous (w : ℝ → ℝ) := w.continuous
  have hw_int : Integrable (w : ℝ → ℝ) volume := w.integrable
  have integral_exp_neg_mul_Ioi : ∀ (a b : ℝ), 0 < b →
      ∫ x in Set.Ioi a, Real.exp (-b * x) = Real.exp (-b * a) / b := by
    intro a b hb
    let f : ℝ → ℝ := fun x => -(Real.exp (-b * x) / b)
    have hf_cont : ContinuousWithinAt f (Set.Ici a) a := by
      dsimp [f]
      fun_prop
    have hf_deriv : ∀ x ∈ Set.Ioi a, HasDerivAt f (Real.exp (-b * x)) x := by
      intro x _
      dsimp [f]
      have h1 : HasDerivAt (fun x : ℝ => -b * x) (-b) x := by
        simpa using (hasDerivAt_id x).const_mul (-b)
      have h2 : HasDerivAt (fun x : ℝ => Real.exp (-b * x)) (Real.exp (-b * x) * (-b)) x :=
        h1.exp
      have h3 : HasDerivAt (fun x : ℝ => -(Real.exp (-b * x) / b)) (-(Real.exp (-b * x) * (-b) / b)) x :=
        (h2.div_const b).neg
      convert h3 using 1
      have : b ≠ 0 := ne_of_gt hb
      field_simp
    have hf_int : IntegrableOn (fun x => Real.exp (-b * x)) (Set.Ioi a) volume :=
      exp_neg_integrableOn_Ioi a hb
    have hf_lim : Filter.Tendsto f Filter.atTop (nhds 0) := by
      dsimp [f]
      rw [show (0 : ℝ) = -(0 / b) by ring]
      apply Filter.Tendsto.neg
      apply Filter.Tendsto.div_const
      apply Real.tendsto_exp_atBot.comp
      have h_neg : Filter.Tendsto (fun x : ℝ => b * x) Filter.atTop Filter.atTop :=
        Filter.Tendsto.const_mul_atTop hb Filter.tendsto_id
      have h_eq : (fun x : ℝ => -b * x) = (fun x : ℝ => -(b * x)) := by ext x; ring
      change Filter.Tendsto (fun x : ℝ => -b * x) Filter.atTop Filter.atBot
      rw [h_eq]
      exact Filter.tendsto_neg_atTop_atBot.comp h_neg
    have h_res := integral_Ioi_of_hasDerivAt_of_tendsto hf_cont hf_deriv hf_int hf_lim
    rw [h_res]
    dsimp [f]
    ring
  have abs_add_abs_eq_two_mul_max : ∀ (x y z : ℝ),
      |x - y| + |x - z| = 2 * max |x - (y + z) / 2| (|y - z| / 2) := by
    intro x y z
    have h1 : ∀ a b : ℝ, |a - b| + |a + b| = 2 * max |a| |b| := by
      intro a b
      rcases le_total 0 a with ha | ha <;> rcases le_total 0 b with hb | hb
      · rw [abs_of_nonneg ha, abs_of_nonneg hb]
        rcases le_total a b with hab | hba
        · rw [max_eq_right hab, abs_of_nonpos (by linarith), abs_of_nonneg (by linarith)]; ring
        · rw [max_eq_left hba, abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]; ring
      · rw [abs_of_nonneg ha, abs_of_nonpos hb]
        rcases le_total a (-b) with hab | hba
        · rw [max_eq_right hab, abs_of_nonneg (by linarith), abs_of_nonpos (by linarith)]; ring
        · rw [max_eq_left hba, abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]; ring
      · rw [abs_of_nonpos ha, abs_of_nonneg hb]
        rcases le_total (-a) b with hab | hba
        · rw [max_eq_right hab, abs_of_nonpos (by linarith), abs_of_nonneg (by linarith)]; ring
        · rw [max_eq_left hba, abs_of_nonpos (by linarith), abs_of_nonpos (by linarith)]; ring
      · rw [abs_of_nonpos ha, abs_of_nonpos hb]
        rcases le_total (-a) (-b) with hab | hba
        · rw [max_eq_right hab, abs_of_nonneg (by linarith), abs_of_nonpos (by linarith)]; ring
        · rw [max_eq_left hba, abs_of_nonpos (by linarith), abs_of_nonpos (by linarith)]; ring
    have hx1 : x - y = (x - (y + z) / 2) - (y - z) / 2 := by ring
    have hx2 : x - z = (x - (y + z) / 2) + (y - z) / 2 := by ring
    have hr : |(y - z) / 2| = |y - z| / 2 := by
      rw [abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    rw [hx1, hx2, h1, hr]
  have s1 : ∀ (y z : ℝ),
      Integrable (fun x : ℝ => Real.exp (-κ * (|x - y| + |y - z| + |z - x|))) ∧
      (∫ x : ℝ, Real.exp (-κ * (|x - y| + |y - z| + |z - x|))) =
        (|y - z| + 1 / κ) * Real.exp (-2 * κ * |y - z|) := by
    intro y z
    let m : ℝ := (y + z) / 2
    let r : ℝ := |y - z| / 2
    have hr_nn : 0 ≤ r := by positivity
    let g : ℝ → ℝ := fun u => Real.exp (-2 * κ * r - 2 * κ * max |u| r)
    have h_eq_shift :
        (fun x : ℝ => Real.exp (-κ * (|x - y| + |y - z| + |z - x|))) =
        (fun x : ℝ => g (x - m)) := by
      ext x
      have h_abs : |x - y| + |x - z| = 2 * max |x - m| r := abs_add_abs_eq_two_mul_max x y z
      have h_zx : |z - x| = |x - z| := abs_sub_comm z x
      have h_yz : |y - z| = 2 * r := by dsimp [r]; ring
      have h_sum1 : |x - y| + |y - z| + |z - x| = 2 * r + 2 * max |x - m| r := by
        linarith [h_abs, h_zx, h_yz]
      dsimp [g]
      rw [h_sum1]
      have he1 : -κ * (2 * r + 2 * max |x - m| r) = -2 * κ * r - 2 * κ * max |x - m| r := by ring
      rw [he1]
    have hg_even : ∀ u : ℝ, g (-u) = g u := by
      intro u
      dsimp [g]
      rw [abs_neg]
    have hg_nn : ∀ u : ℝ, 0 ≤ g u := fun u => by dsimp [g]; positivity
    have hg_le : ∀ u : ℝ, g u ≤ Real.exp (-2 * κ * |u|) := by
      intro u
      dsimp [g]
      apply Real.exp_le_exp.mpr
      have : |u| ≤ max |u| r := le_max_left |u| r
      nlinarith
    have h_int_dom_Ici : IntegrableOn (fun u : ℝ => Real.exp (-2 * κ * |u|)) (Set.Ici 0) volume := by
      have h_ioi := (exp_neg_integrableOn_Ioi (-1 : ℝ) (by positivity : 0 < 2 * κ)).mono_set
        (Set.Ici_subset_Ioi.mpr (by norm_num : (-1 : ℝ) < 0))
      refine h_ioi.congr_fun ?_ measurableSet_Ici
      intro u hu
      dsimp
      have hu_nn : 0 ≤ u := hu
      rw [abs_of_nonneg hu_nn]
      have : -(2 * κ) * u = -2 * κ * u := by ring
      rw [this]
    have h_int_dom_Iic : IntegrableOn (fun u : ℝ => Real.exp (-2 * κ * |u|)) (Set.Iic 0) volume := by
      have h_neg := h_int_dom_Ici.comp_neg
      rw [Set.neg_Ici, neg_zero] at h_neg
      refine h_neg.congr_fun ?_ measurableSet_Iic
      intro u _
      dsimp
      rw [abs_neg]
    have h_int_dom : Integrable (fun u : ℝ => Real.exp (-2 * κ * |u|)) volume := by
      rw [← integrableOn_univ, ← Set.Iic_union_Ioi (a := (0 : ℝ))]
      exact h_int_dom_Iic.union (h_int_dom_Ici.mono_set Set.Ioi_subset_Ici_self)
    have hg_cont : Continuous g := by dsimp [g]; fun_prop
    have hg_int : Integrable g volume := by
      refine h_int_dom.mono' hg_cont.aestronglyMeasurable ?_
      filter_upwards with u
      rw [Real.norm_of_nonneg (hg_nn u)]
      exact hg_le u
    have h_int_lhs : Integrable (fun x : ℝ => Real.exp (-κ * (|x - y| + |y - z| + |z - x|))) volume := by
      rw [h_eq_shift]
      exact hg_int.comp_sub_right m
    refine ⟨h_int_lhs, ?_⟩
    rw [h_eq_shift, integral_sub_right_eq_self g m]
    have h_split0 : ∫ u : ℝ, g u = (∫ u in Set.Iic 0, g u) + (∫ u in Set.Ioi 0, g u) :=
      (intervalIntegral.integral_Iic_add_Ioi hg_int.integrableOn hg_int.integrableOn).symm
    have h_iic_eq_ioi : (∫ u in Set.Iic 0, g u) = ∫ u in Set.Ioi 0, g u := by
      have h_neg := integral_comp_neg_Iic (0 : ℝ) g
      rw [neg_zero] at h_neg
      rw [← h_neg]
      congr 1 with u
      exact (hg_even u).symm
    have h_split_r : (∫ u in Set.Ioi 0, g u) = (∫ u in Set.Ioc 0 r, g u) + (∫ u in Set.Ioi r, g u) := by
      rw [← Set.Ioc_union_Ioi_eq_Ioi hr_nn]
      exact setIntegral_union Set.Ioc_disjoint_Ioi_same measurableSet_Ioi hg_int.integrableOn hg_int.integrableOn
    have h_ioc_val : (∫ u in Set.Ioc 0 r, g u) = r * Real.exp (-4 * κ * r) := by
      have h_congr : (∫ u in Set.Ioc 0 r, g u) = ∫ u in Set.Ioc 0 r, Real.exp (-4 * κ * r) := by
        refine setIntegral_congr_fun measurableSet_Ioc ?_
        intro u hu
        dsimp [g]
        have hu_pos : 0 ≤ u := le_of_lt hu.1
        have hu_le : |u| ≤ r := by rw [abs_of_nonneg hu_pos]; exact hu.2
        rw [max_eq_right hu_le]
        have : -2 * κ * r - 2 * κ * r = -4 * κ * r := by ring
        rw [this]
      rw [h_congr, setIntegral_const, smul_eq_mul, Measure.real_def, Real.volume_Ioc, sub_zero,
          ENNReal.toReal_ofReal hr_nn]
    have h_ioi_r : (∫ u in Set.Ioi r, g u) =
        ∫ u in Set.Ioi r, Real.exp (-2 * κ * r) * Real.exp (-(2 * κ) * u) := by
      refine setIntegral_congr_fun measurableSet_Ioi ?_
      intro u hu
      dsimp [g]
      have hu_r : r < u := hu
      have hu_nn : 0 ≤ u := by linarith
      have h_max : max |u| r = u := by
        rw [abs_of_nonneg hu_nn]
        exact max_eq_left (le_of_lt hu_r)
      rw [h_max]
      have he1 : -2 * κ * r - 2 * κ * u = -2 * κ * r + -(2 * κ) * u := by ring
      rw [he1, Real.exp_add]
    rw [h_split0, h_iic_eq_ioi, h_split_r, h_ioc_val, h_ioi_r,
        integral_const_mul, integral_exp_neg_mul_Ioi r (2 * κ) (by positivity)]
    have h_exp_prod : Real.exp (-2 * κ * r) * (Real.exp (-(2 * κ) * r) / (2 * κ)) =
        Real.exp (-4 * κ * r) / (2 * κ) := by
      rw [← mul_div_assoc, ← Real.exp_add]
      have he3 : -2 * κ * r + -(2 * κ) * r = -4 * κ * r := by ring
      rw [he3]
    have h_4r : -4 * κ * r = -2 * κ * |y - z| := by
      dsimp [r]
      ring
    have h_2r : 2 * r = |y - z| := by
      dsimp [r]
      ring
    rw [h_exp_prod, h_4r]
    calc (r * Real.exp (-2 * κ * |y - z|) + Real.exp (-2 * κ * |y - z|) / (2 * κ)) +
          (r * Real.exp (-2 * κ * |y - z|) + Real.exp (-2 * κ * |y - z|) / (2 * κ))
      _ = (2 * r + 1 / κ) * Real.exp (-2 * κ * |y - z|) := by
          field_simp
          ring
      _ = (|y - z| + 1 / κ) * Real.exp (-2 * κ * |y - z|) := by rw [h_2r]
  have s2 : Integrable (fun x : ℝ => greenIterKernel κ w 2 x x) ∧
      (∫ x : ℝ, greenIterKernel κ w 2 x x) =
        (1 / (8 * κ ^ 3)) * ∫ y : ℝ, ∫ z : ℝ, ((|y - z| + 1 / κ) * Real.exp (-2 * κ * |y - z|)) * w y * w z := by
    let K : ℝ → ℝ → ℝ → ℝ := fun x y z =>
      Real.exp (-κ * (|x - y| + |y - z| + |z - x|))
    have hK_nn : ∀ x y z : ℝ, 0 ≤ K x y z := fun x y z => by dsimp [K]; positivity
    have h_g2_diag : ∀ x : ℝ, greenIterKernel κ w 2 x x =
        (1 / (8 * κ ^ 3)) * ∫ y : ℝ, ∫ z : ℝ, K x y z * (w y * w z) := by
      intro x
      have h_inner : ∀ y : ℝ, -(greenIterKernel κ w 1 x y * w y * freeGreenKernel κ y x) =
          (1 / (8 * κ ^ 3)) * ∫ z : ℝ, K x y z * (w y * w z) := by
        intro y
        dsimp [greenIterKernel]
        rw [neg_mul, neg_mul, neg_neg, ← integral_mul_const, ← integral_mul_const, ← integral_const_mul]
        congr 1 with z
        dsimp [freeGreenKernel, K]
        rw [abs_sub_comm x z, abs_sub_comm z y, abs_sub_comm y x]
        have h_exp : Real.exp (-κ * |z - x|) * Real.exp (-κ * |y - z|) * Real.exp (-κ * |x - y|) =
            Real.exp (-κ * (|x - y| + |y - z| + |z - x|)) := by
          rw [← Real.exp_add, ← Real.exp_add]
          congr 1
          ring
        calc 1 / (2 * κ) * Real.exp (-κ * |z - x|) * w z * (1 / (2 * κ) * Real.exp (-κ * |y - z|)) *
              w y * (1 / (2 * κ) * Real.exp (-κ * |x - y|))
          _ = (1 / (8 * κ ^ 3)) * (Real.exp (-κ * |z - x|) * Real.exp (-κ * |y - z|) * Real.exp (-κ * |x - y|)) * (w y * w z) := by ring
          _ = (1 / (8 * κ ^ 3)) * (Real.exp (-κ * (|x - y| + |y - z| + |z - x|)) * (w y * w z)) := by rw [h_exp]; ring
      change -∫ y : ℝ, greenIterKernel κ w 1 x y * w y * freeGreenKernel κ y x = _
      rw [← integral_neg]
      simp_rw [h_inner]
      rw [integral_const_mul]
    let F_zx : ℝ → ℝ × ℝ → ℝ := fun y p => K p.2 y p.1 * (w y * w p.1)
    have h_norm_int_x : ∀ y z : ℝ,
