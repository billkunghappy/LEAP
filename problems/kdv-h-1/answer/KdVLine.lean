                ((∫ η : ℝ, iterWavePacket κ w ℓ x η * Complex.exp (((η : ℂ) * (z : ℂ)) * I) / ((κ ^ 2 + η ^ 2 : ℝ) : ℂ)) * (w z : ℂ))) by ring,
