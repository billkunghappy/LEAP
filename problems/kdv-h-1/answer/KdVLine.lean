theorem regularized_flow_approximation (h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → IsSchwartzSolution v → u 0 = v 0 → u = v)
    (δ : ℝ) (hδ : 0 < δ) :
    ∃ (δ₀ C_rem : ℝ) (Φ_reg : ℝ → ℝ → 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ)),
      0 < δ₀ ∧ δ₀ ≤ δ ∧ 0 < C_rem ∧
      (∀ κ : ℝ, 2 ≤ κ → ∀ w₀ : 𝓢(ℝ, ℝ), ‖ι w₀‖ ≤ δ₀ → ∀ t : ℝ,
        ‖ι (Φ_reg κ t w₀)‖ ≤ δ ∧
        (∀ M : ℝ, 1 ≤ M → alphaFunctional M (Φ_reg κ t w₀) = alphaFunctional M w₀)) ∧
      (∀ κ : ℝ, 2 ≤ κ → ∀ T' : ℝ, 0 < T' →
        ∃ L_κ : ℝ, 0 < L_κ ∧
          ∀ w₁ w₂ : 𝓢(ℝ, ℝ), ‖ι w₁‖ ≤ δ₀ → ‖ι w₂‖ ≤ δ₀ →
            ∀ t : ℝ, |t| ≤ T' →
              ‖ι (Φ_reg κ t w₁) - ι (Φ_reg κ t w₂)‖ ≤ L_κ * ‖ι w₁ - ι w₂‖) ∧
      (∀ κ : ℝ, 2 ≤ κ → ∀ T' : ℝ, 0 < T' →
        ∀ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u → ‖ι (u 0)‖ ≤ δ₀ →
          ∀ t : ℝ, |t| ≤ T' →
            Real.sqrt (hm2NormSq (fun x => recipGreenDiff (u t) x - recipGreenDiff (Φ_reg κ t (u 0)) x)) ≤
              C_rem * T' * (Real.sqrt (hm1KappaSq κ (ι (u 0))) + 1 / κ)) :=
by
  obtain ⟨δ₁, c₁, c₂, K_alpha, C_int, hδ₁, _hc₁, _hc₁₂, hK_alpha, _hC_int,
    _h_alpha_eq, h_alpha_ratio, _h_interp⟩ := diagGreen_alpha_and_interpolation
  obtain ⟨δ_lip, hδ_lip, h_lip⟩ := reg_flow_lipschitz_on_small_ball
  obtain ⟨δ_evol, hδ_evol, h_evol⟩ := diff_flow_recipGreenDiff_hm2_integral_bound
  obtain ⟨δ_flux, C_flux, hδ_flux, hC_flux, h_flux⟩ := recipGreenFlux_deriv_hm2_bound
  set δ_target := min (min δ δ₁) (min δ_lip (min δ_evol δ_flux))
  have hδ_target : 0 < δ_target := by positivity
  have hδ_target_le_δ : δ_target ≤ δ :=
    le_trans (min_le_left _ _) (min_le_left _ _)
  have hδ_target_le_δ₁ : δ_target ≤ δ₁ :=
    le_trans (min_le_left _ _) (min_le_right _ _)
  have hδ_target_le_lip : δ_target ≤ δ_lip :=
    le_trans (min_le_right _ _) (min_le_left _ _)
  have hδ_target_le_evol : δ_target ≤ δ_evol :=
    le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
  have hδ_target_le_flux : δ_target ≤ δ_flux :=
    le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
  obtain ⟨δ₀_reg, hδ₀_reg_pos, hδ₀_reg_le, h_reg_ex⟩ :=
    reg_flow_global_existence_and_conservation δ_target hδ_target
  obtain ⟨δ₀_comm, hδ₀_comm_pos, _hδ₀_comm_le, h_comm⟩ :=
    kdv_reg_commuting_diff_flow h_exists h_unique δ_target hδ_target
  set δ₀ := min δ₀_reg δ₀_comm
  have hδ₀_pos : 0 < δ₀ := lt_min hδ₀_reg_pos hδ₀_comm_pos
  have hδ₀_le_reg : δ₀ ≤ δ₀_reg := min_le_left _ _
  have hδ₀_le_comm : δ₀ ≤ δ₀_comm := min_le_right _ _
  have hδ₀_le_δ : δ₀ ≤ δ := le_trans hδ₀_le_reg (le_trans hδ₀_reg_le hδ_target_le_δ)
  set C_rem := C_flux * (K_alpha + 1)
  have hC_rem_pos : 0 < C_rem := by positivity
  let Φ_reg : ℝ → ℝ → 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ) := fun κ t w₀ =>
    if h : 2 ≤ κ ∧ ‖ι w₀‖ ≤ δ₀_reg then (h_reg_ex κ h.1 w₀ h.2).choose t else w₀
  have hΦ_spec : ∀ (κ : ℝ) (hκ : 2 ≤ κ) (w₀ : 𝓢(ℝ, ℝ)), ‖ι w₀‖ ≤ δ₀ →
      IsRegFlowSolution κ (fun t => Φ_reg κ t w₀) ∧
      Φ_reg κ 0 w₀ = w₀ ∧
      (∀ t : ℝ, ‖ι (Φ_reg κ t w₀)‖ ≤ δ_target) ∧
      (∀ M : ℝ, 1 ≤ M → ∀ t : ℝ, alphaFunctional M (Φ_reg κ t w₀) = alphaFunctional M w₀) := by
    intro κ hκ w₀ hw₀
    have hw₀_reg : ‖ι w₀‖ ≤ δ₀_reg := le_trans hw₀ hδ₀_le_reg
    have hΦ_eq : (fun t => Φ_reg κ t w₀) = (h_reg_ex κ hκ w₀ hw₀_reg).choose := by
      ext t
      dsimp [Φ_reg]
      rw [dif_pos ⟨hκ, hw₀_reg⟩]
    have h_spec := (h_reg_ex κ hκ w₀ hw₀_reg).choose_spec
    rw [← hΦ_eq] at h_spec
    exact h_spec
  refine ⟨δ₀, C_rem, Φ_reg, hδ₀_pos, hδ₀_le_δ, hC_rem_pos, ?_, ?_, ?_⟩
  · intro κ hκ w₀ hw₀ t
    obtain ⟨_h_sol, _h_init, h_ball, h_alpha⟩ := hΦ_spec κ hκ w₀ hw₀
    refine ⟨le_trans (h_ball t) hδ_target_le_δ, fun M hM => h_alpha M hM t⟩
  · intro κ hκ T' hT'
    obtain ⟨L_κ, hL_κ, h_lip_κ⟩ := h_lip κ hκ T' hT'
    refine ⟨L_κ, hL_κ, ?_⟩
    intro w₁ w₂ hw₁ hw₂ t ht
    obtain ⟨h_sol₁, h_init₁, h_ball₁, _⟩ := hΦ_spec κ hκ w₁ hw₁
    obtain ⟨h_sol₂, h_init₂, h_ball₂, _⟩ := hΦ_spec κ hκ w₂ hw₂
    have h_bound := h_lip_κ (fun s => Φ_reg κ s w₁) (fun s => Φ_reg κ s w₂)
      h_sol₁ h_sol₂
      (fun s => le_trans (h_ball₁ s) hδ_target_le_lip)
      (fun s => le_trans (h_ball₂ s) hδ_target_le_lip)
      t ht
    simpa [h_init₁, h_init₂] using h_bound
  · intro κ hκ T' hT' u hu hu0 t ht
    obtain ⟨h_sol_w, h_init_w, _h_ball_w, _h_alpha_w⟩ := hΦ_spec κ hκ (u 0) hu0
    have hu0_comm : ‖ι (u 0)‖ ≤ δ₀_comm := le_trans hu0 hδ₀_le_comm
    have hu0_δ₁ : ‖ι (u 0)‖ ≤ δ₁ :=
      le_trans hu0 (le_trans hδ₀_le_reg (le_trans hδ₀_reg_le hδ_target_le_δ₁))
    obtain ⟨z, hz_sol, hz0, hzt, hz_ball, hz_alpha⟩ :=
      h_comm κ hκ u (fun s => Φ_reg κ s (u 0)) hu h_sol_w h_init_w hu0_comm t
    have hκ_pos : 0 < κ := by linarith
    have hκ_ge1 : 1 ≤ κ := by linarith
    set M_flux := C_rem * (Real.sqrt (hm1KappaSq κ (ι (u 0))) + 1 / κ)
    have hM_flux_nonneg : 0 ≤ M_flux := by positivity
    have h_flux_bound : ∀ s : ℝ,
        Real.sqrt (hm2NormSq (deriv (recipGreenFlux κ (z s)))) ≤ M_flux := by
      intro s
      have hzs_flux : ‖ι (z s)‖ ≤ δ_flux := le_trans (hz_ball s) hδ_target_le_flux
      have hzs_δ₁ : ‖ι (z s)‖ ≤ δ₁ := le_trans (hz_ball s) hδ_target_le_δ₁
      have h1 := h_flux κ hκ (z s) hzs_flux
      have h2 := h_alpha_ratio κ hκ_ge1 (z s) (u 0) hzs_δ₁ hu0_δ₁ (hz_alpha s)
      have h_sqrt_nonneg : 0 ≤ Real.sqrt (hm1KappaSq κ (ι (u 0))) := Real.sqrt_nonneg _
      have h_inv_nonneg : 0 ≤ 1 / κ := by positivity
      calc Real.sqrt (hm2NormSq (deriv (recipGreenFlux κ (z s))))
        _ ≤ C_flux * (Real.sqrt (hm1KappaSq κ (ι (z s))) + 1 / κ) := h1
        _ ≤ C_flux * (K_alpha * Real.sqrt (hm1KappaSq κ (ι (u 0))) + 1 / κ) := by
          apply mul_le_mul_of_nonneg_left _ (le_of_lt hC_flux)
          linarith
        _ ≤ C_flux * (K_alpha + 1) * (Real.sqrt (hm1KappaSq κ (ι (u 0))) + 1 / κ) := by
          rw [mul_assoc]
          apply mul_le_mul_of_nonneg_left _ (le_of_lt hC_flux)
          have h_prod_nonneg : 0 ≤ K_alpha * (1 / κ) := by positivity
          linarith
    have h_evol_bound := h_evol κ hκ z hz_sol
      (fun s => le_trans (hz_ball s) hδ_target_le_evol)
      t M_flux hM_flux_nonneg h_flux_bound
    rw [hzt, hz0] at h_evol_bound
    calc Real.sqrt (hm2NormSq (fun x => recipGreenDiff (u t) x - recipGreenDiff (Φ_reg κ t (u 0)) x))
      _ ≤ |t| * M_flux := h_evol_bound
      _ ≤ T' * M_flux := mul_le_mul_of_nonneg_right ht hM_flux_nonneg
      _ = C_rem * T' * (Real.sqrt (hm1KappaSq κ (ι (u 0))) + 1 / κ) := by
        dsimp [M_flux]
        ring

theorem schwartz_flow_uniform_cauchy_on_compact (h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → IsSchwartzSolution v → u 0 = v 0 → u = v)
    (q : Hm1) (T : ℝ) (hT : 0 < T) (ε : ℝ) (hε : 0 < ε) :
    ∃ η > 0, ∀ u v : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → IsSchwartzSolution v →
      ‖ι (u 0) - q‖ < η → ‖ι (v 0) - q‖ < η →
      ∀ t : ℝ, |t| ≤ T → ‖ι (u t) - ι (v t)‖ < ε :=
by
  obtain ⟨δ₁, c₁, c₂, K_alpha, C_int, hδ₁, hc₁, hc₁₂, hK_alpha, hC_int,
    _h_alpha_eq, h_alpha_ratio, h_interp⟩ := diagGreen_alpha_and_interpolation
  obtain ⟨δ₀_kdv, hδ₀_kdv_pos, hδ₀_kdv_le, h_kdv⟩ :=
    kdv_alpha_conservation_small_data h_exists h_unique δ₁ hδ₁
  obtain ⟨δ₀_reg, C_rem, Φ_reg, hδ₀_reg_pos, _hδ₀_reg_le, hC_rem,
    h_reg_inv, h_reg_lip, h_reg_rem⟩ :=
    regularized_flow_approximation h_exists h_unique δ₁ hδ₁
  set δ₀ := min δ₀_kdv δ₀_reg
  have hδ₀ : 0 < δ₀ := lt_min hδ₀_kdv_pos hδ₀_reg_pos
  obtain ⟨lam, S, hlam_pos, _hlam_le, _hS_eval, hS_sol, hS_ball,
    hS_nonexp, hS_inv, hS_kappa⟩ := kdv_scaling_symmetry q δ₀ hδ₀
  set T' := lam⁻¹ ^ 3 * T
  have hT' : 0 < T' := by positivity
  set ε' := lam ^ 2 * ε
  have hε' : 0 < ε' := by positivity
  set θ_M := ε' / (12 * C_int * K_alpha)
  have hθ_M : 0 < θ_M := by positivity
  obtain ⟨M, hM_ge2, η_M, hη_M, h_tail_M⟩ := hm1KappaSq_tail_control q θ_M hθ_M
  have hM_ge1 : 1 ≤ M := by linarith
  set F_M := C_int * (M ^ 2 + 4) ^ 2 * C_rem * T'
  have hF_M : 0 < F_M := by positivity
  set θ_κ := ε' / (12 * F_M)
  have hθ_κ : 0 < θ_κ := by positivity
  obtain ⟨κ₀, hκ₀_ge2, η_κ, hη_κ, h_tail_κ⟩ := hm1KappaSq_tail_control q θ_κ hθ_κ
  set κ := max κ₀ (1 / θ_κ + 2)
  have hκ_ge_κ₀ : κ₀ ≤ κ := le_max_left _ _
  have hκ_ge2 : 2 ≤ κ := le_trans hκ₀_ge2 hκ_ge_κ₀
  have hκ_ge1 : 1 ≤ κ := by linarith
  have hκ_gt_inv : 1 / θ_κ < κ := by
    have : 1 / θ_κ + 2 ≤ κ := le_max_right _ _
    linarith
  have hκ_pos : 0 < κ := by linarith
  have h_inv_κ : 1 / κ < θ_κ := by
    rw [div_lt_iff₀ hκ_pos]
    have : (1 / θ_κ) * θ_κ < κ * θ_κ := mul_lt_mul_of_pos_right hκ_gt_inv hθ_κ
    rw [one_div_mul_cancel (ne_of_gt hθ_κ)] at this
    linarith
  obtain ⟨L_κ, hL_κ, h_lip_κ⟩ := h_reg_lip κ hκ_ge2 T' hT'
  set η := min (min 1 (min η_M η_κ)) (ε' / (6 * L_κ))
  have hη : 0 < η := by positivity
  have hη_le1 : η ≤ 1 := le_trans (min_le_left _ _) (min_le_left _ _)
  have hη_le_M : η ≤ η_M :=
    le_trans (min_le_left _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
  have hη_le_κ : η ≤ η_κ :=
    le_trans (min_le_left _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
  have hη_le_lip : η ≤ ε' / (6 * L_κ) := min_le_right _ _
  refine ⟨η, hη, ?_⟩
  intro u v hu hv hu0 hv0 t ht
  set τ := lam⁻¹ ^ 3 * t
  have hlam_ne : lam ≠ 0 := ne_of_gt hlam_pos
  have h_lam_τ : lam ^ 3 * τ = t := by
    dsimp [τ]
    field_simp
  have hτ : |τ| ≤ T' := by
    dsimp [τ, T']
    rw [abs_mul, abs_of_pos (by positivity)]
    exact mul_le_mul_of_nonneg_left ht (by positivity)
  have h_single : ∀ w : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution w → ‖ι (w 0) - q‖ < η →
      ‖ι (S (w t)) - ι (Φ_reg κ τ (S (w 0)))‖ < ε' / 3 ∧ ‖ι (S (w 0))‖ ≤ δ₀_reg := by
    intro w hw hw0
    set w' : ℝ → 𝓢(ℝ, ℝ) := fun s => S (w (lam ^ 3 * s))
    have hw'_sol : IsSchwartzSolution w' := hS_sol w hw
    have hw'0_eq : w' 0 = S (w 0) := by
      dsimp [w']
      rw [mul_zero]
    have hw'τ_eq : w' τ = S (w t) := by
      dsimp [w']
      rw [h_lam_τ]
    have hw0_lt1 : ‖ι (w 0) - q‖ < 1 := lt_of_lt_of_le hw0 hη_le1
    have hw'0_ball : ‖ι (w' 0)‖ ≤ δ₀ := by
      rw [hw'0_eq]
      exact hS_ball (w 0) hw0_lt1
    have hw'0_kdv : ‖ι (w' 0)‖ ≤ δ₀_kdv := le_trans hw'0_ball (min_le_left _ _)
    have hw'0_reg : ‖ι (w' 0)‖ ≤ δ₀_reg := le_trans hw'0_ball (min_le_right _ _)
    have hw'0_δ₁ : ‖ι (w' 0)‖ ≤ δ₁ := le_trans hw'0_kdv hδ₀_kdv_le
    have h_kdv_w' := h_kdv w' hw'_sol hw'0_kdv
    have hw'τ_δ₁ : ‖ι (w' τ)‖ ≤ δ₁ := h_kdv_w'.1 τ
    have hw'τ_alpha : alphaFunctional M (w' τ) = alphaFunctional M (w' 0) :=
      h_kdv_w'.2 M hM_ge1 τ
    have h_reg_w' := h_reg_inv κ hκ_ge2 (w' 0) hw'0_reg τ
    have hreg_δ₁ : ‖ι (Φ_reg κ τ (w' 0))‖ ≤ δ₁ := h_reg_w'.1
    have hreg_alpha : alphaFunctional M (Φ_reg κ τ (w' 0)) = alphaFunctional M (w' 0) :=
      h_reg_w'.2 M hM_ge1
    have h_M_w0 : Real.sqrt (hm1KappaSq M (ι (w' 0))) < θ_M := by
      rw [hw'0_eq]
      exact lt_of_le_of_lt (hS_kappa M hM_ge1 (w 0))
        (h_tail_M M le_rfl (w 0) (lt_of_lt_of_le hw0 hη_le_M))
    have h_M_w'τ : Real.sqrt (hm1KappaSq M (ι (w' τ))) < K_alpha * θ_M := by
      calc Real.sqrt (hm1KappaSq M (ι (w' τ)))
        _ ≤ K_alpha * Real.sqrt (hm1KappaSq M (ι (w' 0))) :=
          h_alpha_ratio M hM_ge1 (w' τ) (w' 0) hw'τ_δ₁ hw'0_δ₁ hw'τ_alpha
        _ < K_alpha * θ_M := mul_lt_mul_of_pos_left h_M_w0 hK_alpha
    have h_M_reg : Real.sqrt (hm1KappaSq M (ι (Φ_reg κ τ (w' 0)))) < K_alpha * θ_M := by
      calc Real.sqrt (hm1KappaSq M (ι (Φ_reg κ τ (w' 0))))
        _ ≤ K_alpha * Real.sqrt (hm1KappaSq M (ι (w' 0))) :=
          h_alpha_ratio M hM_ge1 (Φ_reg κ τ (w' 0)) (w' 0) hreg_δ₁ hw'0_δ₁ hreg_alpha
        _ < K_alpha * θ_M := mul_lt_mul_of_pos_left h_M_w0 hK_alpha
    have h_κ_w0 : Real.sqrt (hm1KappaSq κ (ι (w' 0))) < θ_κ := by
      rw [hw'0_eq]
      exact lt_of_le_of_lt (hS_kappa κ hκ_ge1 (w 0))
        (h_tail_κ κ hκ_ge_κ₀ (w 0) (lt_of_lt_of_le hw0 hη_le_κ))
    have h_rem_bound :
        Real.sqrt (hm2NormSq (fun x => recipGreenDiff (w' τ) x - recipGreenDiff (Φ_reg κ τ (w' 0)) x)) <
          C_rem * T' * (2 * θ_κ) := by
      calc Real.sqrt (hm2NormSq (fun x => recipGreenDiff (w' τ) x - recipGreenDiff (Φ_reg κ τ (w' 0)) x))
        _ ≤ C_rem * T' * (Real.sqrt (hm1KappaSq κ (ι (w' 0))) + 1 / κ) :=
          h_reg_rem κ hκ_ge2 T' hT' w' hw'_sol hw'0_reg τ hτ
        _ < C_rem * T' * (2 * θ_κ) := by
          apply mul_lt_mul_of_pos_left _ (by positivity)
          linarith
    have h_interp_bound := h_interp M hM_ge1 (w' τ) (Φ_reg κ τ (w' 0)) hw'τ_δ₁ hreg_δ₁
    have h_term1 :
        C_int * (M ^ 2 + 4) ^ 2 *
          Real.sqrt (hm2NormSq (fun x => recipGreenDiff (w' τ) x - recipGreenDiff (Φ_reg κ τ (w' 0)) x)) <
          ε' / 6 := by
      have h_eq : C_int * (M ^ 2 + 4) ^ 2 * (C_rem * T' * (2 * θ_κ)) = ε' / 6 := by
        dsimp [θ_κ, F_M]
        have : F_M ≠ 0 := ne_of_gt hF_M
        field_simp
        ring
      calc C_int * (M ^ 2 + 4) ^ 2 *
            Real.sqrt (hm2NormSq (fun x => recipGreenDiff (w' τ) x - recipGreenDiff (Φ_reg κ τ (w' 0)) x))
        _ < C_int * (M ^ 2 + 4) ^ 2 * (C_rem * T' * (2 * θ_κ)) :=
          mul_lt_mul_of_pos_left h_rem_bound (by positivity)
        _ = ε' / 6 := h_eq
    have h_term2 :
        C_int * (Real.sqrt (hm1KappaSq M (ι (w' τ))) + Real.sqrt (hm1KappaSq M (ι (Φ_reg κ τ (w' 0))))) <
          ε' / 6 := by
      have h_eq : C_int * (2 * (K_alpha * θ_M)) = ε' / 6 := by
        dsimp [θ_M]
        have : C_int ≠ 0 := ne_of_gt hC_int
        have : K_alpha ≠ 0 := ne_of_gt hK_alpha
        field_simp
        ring
      calc C_int * (Real.sqrt (hm1KappaSq M (ι (w' τ))) + Real.sqrt (hm1KappaSq M (ι (Φ_reg κ τ (w' 0)))))
        _ < C_int * (2 * (K_alpha * θ_M)) := by
          apply mul_lt_mul_of_pos_left _ hC_int
          linarith
        _ = ε' / 6 := h_eq
    refine ⟨?_, ?_⟩
    · rw [← hw'τ_eq, ← hw'0_eq]
      linarith
    · rw [← hw'0_eq]
      exact hw'0_reg
  obtain ⟨hu_approx, hu'0_reg⟩ := h_single u hu hu0
  obtain ⟨hv_approx, hv'0_reg⟩ := h_single v hv hv0
  have h_mid : ‖ι (Φ_reg κ τ (S (u 0))) - ι (Φ_reg κ τ (S (v 0)))‖ < ε' / 3 := by
    have h_u0_v0 : ‖ι (u 0) - ι (v 0)‖ < 2 * η := by
      have h_tri : ‖ι (u 0) - ι (v 0)‖ ≤ ‖ι (u 0) - q‖ + ‖q - ι (v 0)‖ :=
        norm_sub_le_norm_sub_add_norm_sub (ι (u 0)) q (ι (v 0))
      rw [norm_sub_rev q (ι (v 0))] at h_tri
      linarith
    have h_S_u0_v0 : ‖ι (S (u 0)) - ι (S (v 0))‖ < 2 * η :=
      lt_of_le_of_lt (hS_nonexp (u 0) (v 0)) h_u0_v0
    have h_lip_bound := h_lip_κ (S (u 0)) (S (v 0)) hu'0_reg hv'0_reg τ hτ
    have h_2η : L_κ * (2 * η) ≤ ε' / 3 := by
      have h1 : L_κ * (2 * η) ≤ L_κ * (2 * (ε' / (6 * L_κ))) :=
        mul_le_mul_of_nonneg_left (by linarith) (le_of_lt hL_κ)
      have h2 : L_κ * (2 * (ε' / (6 * L_κ))) = ε' / 3 := by
        have : L_κ ≠ 0 := ne_of_gt hL_κ
        field_simp
        ring
      linarith
    calc ‖ι (Φ_reg κ τ (S (u 0))) - ι (Φ_reg κ τ (S (v 0)))‖
      _ ≤ L_κ * ‖ι (S (u 0)) - ι (S (v 0))‖ := h_lip_bound
      _ < L_κ * (2 * η) := mul_lt_mul_of_pos_left h_S_u0_v0 hL_κ
      _ ≤ ε' / 3 := h_2η
  have h_S_diff : ‖ι (S (u t)) - ι (S (v t))‖ < ε' := by
    have h_tri1 : ‖ι (S (u t)) - ι (S (v t))‖ ≤
        ‖ι (S (u t)) - ι (Φ_reg κ τ (S (u 0)))‖ +
        ‖ι (Φ_reg κ τ (S (u 0))) - ι (S (v t))‖ :=
      norm_sub_le_norm_sub_add_norm_sub _ _ _
    have h_tri2 : ‖ι (Φ_reg κ τ (S (u 0))) - ι (S (v t))‖ ≤
        ‖ι (Φ_reg κ τ (S (u 0))) - ι (Φ_reg κ τ (S (v 0)))‖ +
        ‖ι (Φ_reg κ τ (S (v 0))) - ι (S (v t))‖ :=
      norm_sub_le_norm_sub_add_norm_sub _ _ _
    rw [norm_sub_rev (ι (Φ_reg κ τ (S (v 0)))) (ι (S (v t)))] at h_tri2
    linarith
  calc ‖ι (u t) - ι (v t)‖
    _ ≤ lam⁻¹ ^ 2 * ‖ι (S (u t)) - ι (S (v t))‖ := hS_inv (u t) (v t)
    _ < lam⁻¹ ^ 2 * ε' := mul_lt_mul_of_pos_left h_S_diff (by positivity)
    _ = ε := by
      dsimp [ε']
      field_simp

theorem schwartz_flow_continuous_extension (h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
    (h_dense : DenseRange ι)
    (h_cont_t : ∀ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u → Continuous (fun t => ι (u t)))
    (h_cauchy : ∀ (q : Hm1) (T : ℝ), 0 < T → ∀ ε > 0, ∃ η > 0,
      ∀ u v : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u → IsSchwartzSolution v →
      ‖ι (u 0) - q‖ < η → ‖ι (v 0) - q‖ < η →
      ∀ t : ℝ, |t| ≤ T → ‖ι (u t) - ι (v t)‖ < ε) :
    ∃ Φ : ℝ × Hm1 → Hm1, Continuous Φ ∧ ExtendsSchwartzFlow Φ :=
by
  haveI : CompleteSpace Hm1 := by
    delta Hm1
    infer_instance
  have h_approx_sol : ∀ (q : Hm1) (δ : ℝ), 0 < δ →
      ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ ‖ι (u 0) - q‖ < δ := by
    intro q δ hδ
    obtain ⟨q₀, hq₀⟩ := DenseRange.exists_dist_lt h_dense q hδ
    rw [dist_comm, dist_eq_norm] at hq₀
    obtain ⟨u, hu_sol, hu0⟩ := h_exists q₀
    refine ⟨u, hu_sol, ?_⟩
    rwa [hu0]
  have h_seq_ex : ∀ (q : Hm1) (n : ℕ),
      ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ ‖ι (u 0) - q‖ < 1 / ((n : ℝ) + 1) :=
    fun q n => h_approx_sol q (1 / ((n : ℝ) + 1)) (by positivity)
  choose u_seq hu_sol hu_init using h_seq_ex
  have h_cauchy_seq : ∀ p : ℝ × Hm1, CauchySeq (fun n : ℕ => ι (u_seq p.2 n p.1)) := by
    rintro ⟨t, q⟩
    rw [Metric.cauchySeq_iff]
    intro ε hε
    have hT : 0 < |t| + 1 := by positivity
    obtain ⟨η, hη, h_c⟩ := h_cauchy q (|t| + 1) hT ε hε
    obtain ⟨N, hN⟩ := exists_nat_gt (1 / η)
    refine ⟨N, fun m hm n hn => ?_⟩
    rw [dist_eq_norm]
    have hm_lt : 1 / ((m : ℝ) + 1) < η := by
      rw [one_div]
      apply inv_lt_of_inv_lt₀ hη
      rw [← one_div]
      have hmN : (N : ℝ) ≤ (m : ℝ) := Nat.cast_le.mpr hm
      linarith
    have hn_lt : 1 / ((n : ℝ) + 1) < η := by
      rw [one_div]
      apply inv_lt_of_inv_lt₀ hη
      rw [← one_div]
      have hnN : (N : ℝ) ≤ (n : ℝ) := Nat.cast_le.mpr hn
      linarith
    apply h_c (u_seq q m) (u_seq q n) (hu_sol q m) (hu_sol q n)
    · exact lt_trans (hu_init q m) hm_lt
    · exact lt_trans (hu_init q n) hn_lt
    · linarith
  have h_lim_ex : ∀ p : ℝ × Hm1,
      ∃ y : Hm1, Filter.Tendsto (fun n : ℕ => ι (u_seq p.2 n p.1)) Filter.atTop (nhds y) :=
    fun p => cauchySeq_tendsto_of_complete (h_cauchy_seq p)
  choose Φ hΦ_lim using h_lim_ex
  have hΦ_approx : ∀ (q₀ : Hm1) (T : ℝ), 0 < T → ∀ ε > 0, ∃ η > 0,
      ∀ (q : Hm1) (u : ℝ → 𝓢(ℝ, ℝ)), IsSchwartzSolution u →
      ‖q - q₀‖ < η → ‖ι (u 0) - q₀‖ < η →
      ∀ t : ℝ, |t| ≤ T → ‖Φ (t, q) - ι (u t)‖ < ε := by
    intro q₀ T hT ε hε
    obtain ⟨η, hη, h_c⟩ := h_cauchy q₀ T hT (ε / 2) (half_pos hε)
    refine ⟨η, hη, fun q u hu hq hu0 t ht => ?_⟩
    have h_diff_pos : 0 < η - ‖q - q₀‖ := sub_pos.mpr hq
    obtain ⟨N, hN⟩ := exists_nat_gt (1 / (η - ‖q - q₀‖))
    have h_ev : ∀ᶠ n : ℕ in Filter.atTop, ‖ι (u_seq q n t) - ι (u t)‖ ≤ ε / 2 := by
      rw [Filter.eventually_atTop]
      refine ⟨N, fun n hn => le_of_lt ?_⟩
      have hn_lt : 1 / ((n : ℝ) + 1) < η - ‖q - q₀‖ := by
        rw [one_div]
        apply inv_lt_of_inv_lt₀ h_diff_pos
        rw [← one_div]
        have hnN : (N : ℝ) ≤ (n : ℝ) := Nat.cast_le.mpr hn
        linarith
      have h_un0 : ‖ι (u_seq q n 0) - q₀‖ < η := by
        have h_tri := norm_sub_le_norm_sub_add_norm_sub (ι (u_seq q n 0)) q q₀
        have h_init := hu_init q n
        linarith
      exact h_c (u_seq q n) u (hu_sol q n) hu h_un0 hu0 t ht
    have h_tendsto_norm : Filter.Tendsto (fun n : ℕ => ‖ι (u_seq q n t) - ι (u t)‖) Filter.atTop (nhds ‖Φ (t, q) - ι (u t)‖) :=
      ((hΦ_lim (t, q)).sub_const (ι (u t))).norm
    have h_le : ‖Φ (t, q) - ι (u t)‖ ≤ ε / 2 := le_of_tendsto h_tendsto_norm h_ev
    linarith
  refine ⟨Φ, ?_, ?_⟩
  · rw [Metric.continuous_iff]
    rintro ⟨t₀, q₀⟩ ε hε
    have hT : 0 < |t₀| + 1 := by positivity
    have hε3 : 0 < ε / 3 := by linarith
    obtain ⟨η, hη, h_app⟩ := hΦ_approx q₀ (|t₀| + 1) hT (ε / 3) hε3
    obtain ⟨u_star, hu_star_sol, hu_star_0⟩ := h_approx_sol q₀ η hη
    have h_phi_t0 : ‖Φ (t₀, q₀) - ι (u_star t₀)‖ < ε / 3 := by
      apply h_app q₀ u_star hu_star_sol
      · simpa using hη
      · exact hu_star_0
      · linarith
    have h_cont_ustar : ContinuousAt (fun t => ι (u_star t)) t₀ :=
      (h_cont_t u_star hu_star_sol).continuousAt
    obtain ⟨δ_t, hδ_t, h_ustar_close⟩ := Metric.continuousAt_iff.mp h_cont_ustar (ε / 3) hε3
    refine ⟨min (min δ_t 1) η, lt_min (lt_min hδ_t one_pos) hη, ?_⟩
    rintro ⟨t, q⟩ h_dist
    rw [Prod.dist_eq] at h_dist
    have ht_dist : dist t t₀ < min (min δ_t 1) η := lt_of_le_of_lt (le_max_left _ _) h_dist
    have hq_dist : dist q q₀ < min (min δ_t 1) η := lt_of_le_of_lt (le_max_right _ _) h_dist
    have ht_δt : dist t t₀ < δ_t := lt_of_lt_of_le ht_dist (le_trans (min_le_left _ _) (min_le_left _ _))
    have ht_1 : dist t t₀ < 1 := lt_of_lt_of_le ht_dist (le_trans (min_le_left _ _) (min_le_right _ _))
    have hq_η : ‖q - q₀‖ < η := by
      rw [← dist_eq_norm]
      exact lt_of_lt_of_le hq_dist (min_le_right _ _)
    have ht_le_T : |t| ≤ |t₀| + 1 := by
      rw [Real.dist_eq] at ht_1
      exact abs_le.mpr ⟨by linarith [abs_lt.mp ht_1, neg_abs_le t₀], by linarith [abs_lt.mp ht_1, le_abs_self t₀]⟩
    have h_phi_t : dist (Φ (t, q)) (ι (u_star t)) < ε / 3 := by
      rw [dist_eq_norm]
      exact h_app q u_star hu_star_sol hq_η hu_star_0 t ht_le_T
    have h_mid : dist (ι (u_star t)) (ι (u_star t₀)) < ε / 3 := h_ustar_close ht_δt
    have h_phi_0 : dist (ι (u_star t₀)) (Φ (t₀, q₀)) < ε / 3 := by
      rwa [dist_comm, dist_eq_norm]
    have h_tri4 := dist_triangle4 (Φ (t, q)) (ι (u_star t)) (ι (u_star t₀)) (Φ (t₀, q₀))
    linarith
  · intro u hu t
    apply eq_of_forall_dist_le
    intro ε hε
    have hT : 0 < |t| + 1 := by positivity
    obtain ⟨η, hη, h_app⟩ := hΦ_approx (ι (u 0)) (|t| + 1) hT ε hε
    rw [dist_eq_norm]
    apply le_of_lt
    apply h_app (ι (u 0)) u hu
    · simpa using hη
    · simpa using hη
    · linarith

theorem kdv_scaling_hm1_bounds (u : ℝ → 𝓢(ℝ, ℝ)) (hu : IsSchwartzSolution u) (μ : ℝ) (hμ_pos : 0 < μ) (hμ_le : μ ≤ 1) :
    ∃ u_μ : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u_μ ∧
      ‖ι (u_μ 0)‖ ≤ μ * ‖ι (u 0)‖ ∧
      ∀ t : ℝ, μ ^ 3 * ‖ι (u t)‖ ≤ ‖ι (u_μ (t / μ ^ 6))‖ :=
by
  have s1 : ∀ (lam : ℝ), 0 < lam →
      ∃ S : 𝓢(ℝ, ℝ) →L[ℝ] 𝓢(ℝ, ℝ),
        (∀ w : 𝓢(ℝ, ℝ), ∀ x : ℝ, S w x = lam ^ 2 * w (lam * x)) ∧
        (∀ w : 𝓢(ℝ, ℝ), ∀ x : ℝ, kdvRHS (S w) x = lam ^ 5 * kdvRHS w (lam * x)) := by
    intro lam hlam
    let g_lam : ℝ →L[ℝ] ℝ := lam • ContinuousLinearMap.id ℝ ℝ
    have h_temp : Function.HasTemperateGrowth g_lam := g_lam.hasTemperateGrowth
    let K : NNReal := Real.toNNReal lam⁻¹
    have h_anti : AntilipschitzWith K g_lam := by
      rw [antilipschitzWith_iff_le_mul_dist]
      intro x y
      have hK : (K : ℝ) = lam⁻¹ := Real.coe_toNNReal _ (by positivity)
      rw [hK, Real.dist_eq, Real.dist_eq]
      have h_glam : ∀ z : ℝ, g_lam z = lam * z := fun z => by dsimp [g_lam]
      rw [h_glam x, h_glam y, ← mul_sub, abs_mul, abs_of_pos hlam, ← mul_assoc,
          inv_mul_cancel₀ (ne_of_gt hlam), one_mul]
    let S : 𝓢(ℝ, ℝ) →L[ℝ] 𝓢(ℝ, ℝ) :=
      (lam ^ 2) • SchwartzMap.compCLMOfAntilipschitz ℝ h_temp h_anti
    have hS_eval : ∀ w : 𝓢(ℝ, ℝ), ∀ x : ℝ, S w x = lam ^ 2 * w (lam * x) := by
      intro w x
      dsimp [S, g_lam]
    refine ⟨S, hS_eval, ?_⟩
    intro w x
    have hS_fn : (S w : ℝ → ℝ) = fun z => lam ^ 2 * w (lam * z) := by
      ext z
      exact hS_eval w z
    have h_iter : ∀ n : ℕ, iteratedDeriv n (S w) x = lam ^ 2 * (lam ^ n * iteratedDeriv n w (lam * x)) := by
      intro n
      have hw_n : ContDiff ℝ (↑n) (w : ℝ → ℝ) := w.smooth n
      have h_comp_n : ContDiff ℝ (↑n) (fun z : ℝ => w (lam * z)) :=
        hw_n.comp (contDiff_const.mul contDiff_id)
      rw [hS_fn, iteratedDeriv_const_mul h_comp_n.contDiffAt (lam ^ 2),
          iteratedDeriv_comp_const_mul hw_n lam]
    have h_d1 : deriv (S w) x = lam ^ 3 * deriv w (lam * x) := by
      rw [← iteratedDeriv_one, h_iter 1, iteratedDeriv_one]
      ring
    have h_d3 : iteratedDeriv 3 (S w) x = lam ^ 5 * iteratedDeriv 3 w (lam * x) := by
      rw [h_iter 3]
      ring
    dsimp [kdvRHS]
    rw [h_d3, h_d1, hS_eval w x]
    ring
  have s2 : ∀ (lam : ℝ), 0 < lam → ∀ (S : 𝓢(ℝ, ℝ) →L[ℝ] 𝓢(ℝ, ℝ)),
      (∀ w : 𝓢(ℝ, ℝ), ∀ x : ℝ, S w x = lam ^ 2 * w (lam * x)) →
      (∀ w : 𝓢(ℝ, ℝ), ∀ x : ℝ, kdvRHS (S w) x = lam ^ 5 * kdvRHS w (lam * x)) →
      ∀ (u : ℝ → 𝓢(ℝ, ℝ)), IsSchwartzSolution u →
      IsSchwartzSolution (fun t => S (u (lam ^ 3 * t))) := by
    intro lam hlam S hS_eval hS_rhs u hu t
    set c : ℝ := lam ^ 3
    have hc_pos : 0 < c := by positivity
    have hc_ne : c ≠ 0 := ne_of_gt hc_pos
    obtain ⟨v, hv_deriv, hv_rhs⟩ := hu (c * t)
    refine ⟨c • S v, ?_, ?_⟩
    · show HasFDerivAtFilter (fun t' => S (u (c * t')))
        (ContinuousLinearMap.toSpanSingleton ℝ (c • S v)) t (nhds t)
      rw [hasFDerivAtFilter_iff_isLittleOTVS]
      rw [Asymptotics.isLittleOTVS_iff_tendsto_inv_smul]
      · have h_lim : Filter.Tendsto
            (fun s : ℝ => (s - c * t)⁻¹ • (u s - u (c * t) - (ContinuousLinearMap.toSpanSingleton ℝ v) (s - c * t)))
            (nhds (c * t)) (nhds 0) :=
          hv_deriv.isLittleOTVS.tendsto_inv_smul
        have h_ct : Filter.Tendsto (fun t' : ℝ => c * t') (nhds t) (nhds (c * t)) :=
          (continuous_const.mul continuous_id).tendsto t
        let L : 𝓢(ℝ, ℝ) →L[ℝ] 𝓢(ℝ, ℝ) := c • S
        have h_L : Filter.Tendsto L (nhds 0) (nhds 0) := by
          simpa using L.continuous.tendsto 0
        have h_comp := h_L.comp (h_lim.comp h_ct)
        have h_eq :
            (fun x : ℝ => (x - t)⁻¹ • (S (u (c * x)) - S (u (c * t)) - (ContinuousLinearMap.toSpanSingleton ℝ (c • S v)) (x - t))) =
            (L ∘ (fun s : ℝ => (s - c * t)⁻¹ • (u s - u (c * t) - (ContinuousLinearMap.toSpanSingleton ℝ v) (s - c * t))) ∘ (fun t' : ℝ => c * t')) := by
          ext x : 1
          dsimp [L, Function.comp]
          have h_sc1 : c * (c * x - c * t)⁻¹ = (x - t)⁻¹ := by
            have : c * x - c * t = c * (x - t) := by ring
            rw [this, mul_inv, ← mul_assoc, mul_inv_cancel₀ hc_ne, one_mul]
          have h_sc2 : c * x - c * t = (x - t) * c := by ring
          rw [map_smul, map_sub, map_sub, map_smul, smul_smul, smul_smul, h_sc1, h_sc2]
        rw [h_eq]
        exact h_comp
      · filter_upwards with x hx
        have hxt : x = t := sub_eq_zero.mp hx
        subst hxt
        simp
    · intro x
      rw [SchwartzMap.smul_apply, smul_eq_mul, hS_eval v x, hv_rhs (lam * x), hS_rhs (u (c * t)) x]
      dsimp [c]
      ring
  have h_norm_sq_eq : ∀ w : 𝓢(ℝ, ℝ), ‖ι w‖ ^ 2 = ∫ ξ : ℝ, ‖fourierLine w ξ‖ ^ 2 / (4 + ξ ^ 2) := by
    have norm_fourier_integrand : ∀ (q : ℝ → ℝ) (ξ x : ℝ),
        ‖Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)‖ = ‖q x‖ := by
      intro q ξ x
      have h_exp : -((ξ : ℂ) * (x : ℂ)) * I = ((-(ξ * x) : ℝ) : ℂ) * I := by push_cast; ring
      rw [norm_mul, h_exp, Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real]
    have h_mem : ∀ q : 𝓢(ℝ, ℝ), MemLp (hm1Profile q) 2 (volume : Measure ℝ) := by
      intro q
      have h_cont2 : Continuous (fun p : ℝ × ℝ =>
          Complex.exp (-((p.1 : ℂ) * (p.2 : ℂ)) * I) * (q p.2 : ℂ)) := by
        have := q.continuous
        fun_prop
      have h_meas_int : AEStronglyMeasurable
          (fun ξ : ℝ => ∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)) volume :=
        h_cont2.aestronglyMeasurable.integral_prod_right'
      have h_meas_fl : AEStronglyMeasurable (fourierLine q) volume :=
        aestronglyMeasurable_const.mul h_meas_int
      have h_cont_w : Continuous (fun ξ : ℝ => ((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ)) :=
        Continuous.inv₀ (by fun_prop) (fun ξ => Complex.ofReal_ne_zero.mpr (by positivity))
      have h_meas : AEStronglyMeasurable (hm1Profile q) volume :=
        h_cont_w.aestronglyMeasurable.mul h_meas_fl
      rw [memLp_two_iff_integrable_sq_norm h_meas]
      let C : ℝ := ‖((Real.sqrt (2 * π))⁻¹ : ℂ)‖ * ∫ x : ℝ, ‖q x‖
      refine (integrable_inv_one_add_sq.const_mul (C ^ 2)).mono'
        (h_meas.norm.pow 2) ?_
      filter_upwards with ξ
      have h_fl_bound : ‖fourierLine q ξ‖ ≤ C := by
        dsimp [fourierLine, C]
        rw [norm_mul]
        gcongr
        calc
          ‖∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)‖
            ≤ ∫ x : ℝ, ‖Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)‖ :=
              norm_integral_le_integral_norm _
          _ = ∫ x : ℝ, ‖q x‖ := by
              congr 1 with x
              exact norm_fourier_integrand q ξ x
      have h_w_norm : ‖((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ)‖ = (Real.sqrt (4 + ξ ^ 2))⁻¹ := by
        rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _)]
      have h_sq : ‖hm1Profile q ξ‖ ^ 2 = (4 + ξ ^ 2)⁻¹ * ‖fourierLine q ξ‖ ^ 2 := by
        dsimp [hm1Profile]
        rw [norm_mul, h_w_norm, mul_pow, inv_pow, Real.sq_sqrt (by positivity)]
      rw [Real.norm_of_nonneg (sq_nonneg _), h_sq]
      have h_inv_le : (4 + ξ ^ 2)⁻¹ ≤ (1 + ξ ^ 2)⁻¹ := by
        apply inv_anti₀ (by positivity)
        linarith
      have h_sq_le : ‖fourierLine q ξ‖ ^ 2 ≤ C ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) h_fl_bound 2
      calc
        (4 + ξ ^ 2)⁻¹ * ‖fourierLine q ξ‖ ^ 2 ≤ (1 + ξ ^ 2)⁻¹ * C ^ 2 := by gcongr
        _ = C ^ 2 * (1 + ξ ^ 2)⁻¹ := mul_comm _ _
    have h_toHm1 : ∀ q : 𝓢(ℝ, ℝ), toHm1 q = (h_mem q).toLp (hm1Profile q) := by
      intro q
      dsimp [toHm1]
      rw [dif_pos (h_mem q)]
    intro w
    change ‖toHm1 w‖ ^ 2 = ∫ ξ : ℝ, ‖fourierLine w ξ‖ ^ 2 / (4 + ξ ^ 2)
    rw [← real_inner_self_eq_norm_sq, MeasureTheory.L2.inner_def]
    apply integral_congr_ae
    filter_upwards [(h_mem w).coeFn_toLp] with ξ hξ
    rw [h_toHm1 w, hξ, real_inner_self_eq_norm_sq]
    have h_w_norm : ‖((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ)‖ = (Real.sqrt (4 + ξ ^ 2))⁻¹ := by
      rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    have h_sq : ‖hm1Profile w ξ‖ ^ 2 = (4 + ξ ^ 2)⁻¹ * ‖fourierLine w ξ‖ ^ 2 := by
      dsimp [hm1Profile]
      rw [norm_mul, h_w_norm, mul_pow, inv_pow, Real.sq_sqrt (by positivity)]
    rw [h_sq, div_eq_inv_mul]
  have s3 : ∀ (lam : ℝ), 0 < lam → lam ≤ 1 →
      ∀ (S : 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ)),
      (∀ w : 𝓢(ℝ, ℝ), ∀ x : ℝ, S w x = lam ^ 2 * w (lam * x)) →
      ∀ (w : 𝓢(ℝ, ℝ)),
      lam ^ 3 * ‖ι w‖ ^ 2 ≤ ‖ι (S w)‖ ^ 2 ∧
      ‖ι (S w)‖ ^ 2 ≤ lam * ‖ι w‖ ^ 2 := by
    intro lam hlam hlam_le S hS_eval w
    rw [h_norm_sq_eq w, h_norm_sq_eq (S w)]
    have hlam_ne : lam ≠ 0 := ne_of_gt hlam
    have h_fl_scale : ∀ ξ : ℝ, fourierLine (S w) ξ = (lam : ℂ) * fourierLine w (lam⁻¹ * ξ) := by
      intro ξ
      dsimp [fourierLine]
      have h_int_eq :
          (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((S w x : ℝ) : ℂ)) =
          (fun x : ℝ => (lam ^ 2 : ℂ) * (Complex.exp (-(((lam⁻¹ * ξ : ℝ) : ℂ) * ((lam * x : ℝ) : ℂ)) * I) * (w (lam * x) : ℂ))) := by
        ext x
        rw [hS_eval w x]
        have h_mul : -((ξ : ℂ) * (x : ℂ)) * I = -(((lam⁻¹ * ξ : ℝ) : ℂ) * ((lam * x : ℝ) : ℂ)) * I := by
          push_cast
          have h_lam_c : (lam : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hlam_ne
          field_simp
        rw [h_mul]
        push_cast
        ring
      rw [h_int_eq, integral_const_mul]
      let g : ℝ → ℂ := fun y => Complex.exp (-(((lam⁻¹ * ξ : ℝ) : ℂ) * (y : ℂ)) * I) * (w y : ℂ)
      have h_cov : (∫ x : ℝ, g (lam * x)) = |lam⁻¹| • ∫ y : ℝ, g y :=
        Measure.integral_comp_mul_left g lam
      change ((Real.sqrt (2 * π))⁻¹ : ℂ) * ((lam ^ 2 : ℂ) * ∫ x : ℝ, g (lam * x)) =
        (lam : ℂ) * (((Real.sqrt (2 * π))⁻¹ : ℂ) * ∫ y : ℝ, g y)
      rw [h_cov, abs_of_pos (inv_pos.mpr hlam), Complex.real_smul]
      push_cast
      have h_lam_c : (lam : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hlam_ne
      field_simp
    have h_norm_fl_scale : ∀ ξ : ℝ, ‖fourierLine (S w) ξ‖ ^ 2 = lam ^ 2 * ‖fourierLine w (lam⁻¹ * ξ)‖ ^ 2 := by
      intro ξ
      rw [h_fl_scale ξ, norm_mul, Complex.norm_real, Real.norm_of_nonneg (le_of_lt hlam), mul_pow]
    have h_freq_cov :
        (∫ ξ : ℝ, ‖fourierLine (S w) ξ‖ ^ 2 / (4 + ξ ^ 2)) =
        (∫ ζ : ℝ, (lam ^ 3 * ‖fourierLine w ζ‖ ^ 2) / (4 + lam ^ 2 * ζ ^ 2)) := by
      let G : ℝ → ℝ := fun ζ => (lam ^ 2 * ‖fourierLine w ζ‖ ^ 2) / (4 + lam ^ 2 * ζ ^ 2)
      have h_lhs_eq :
          (fun ξ : ℝ => ‖fourierLine (S w) ξ‖ ^ 2 / (4 + ξ ^ 2)) =
          (fun ξ : ℝ => G (lam⁻¹ * ξ)) := by
        ext ξ
        dsimp [G]
        rw [h_norm_fl_scale ξ]
        have : lam ^ 2 * (lam⁻¹ * ξ) ^ 2 = ξ ^ 2 := by
          calc lam ^ 2 * (lam⁻¹ * ξ) ^ 2 = (lam * lam⁻¹) ^ 2 * ξ ^ 2 := by ring
          _ = 1 ^ 2 * ξ ^ 2 := by rw [mul_inv_cancel₀ hlam_ne]
          _ = ξ ^ 2 := by ring
        rw [this]
      rw [h_lhs_eq, Measure.integral_comp_mul_left G lam⁻¹, inv_inv, abs_of_pos hlam, smul_eq_mul,
          ← integral_const_mul]
      congr 1 with ζ
      dsimp [G]
      ring
    rw [h_freq_cov]
    have norm_fourier_integrand : ∀ (ξ x : ℝ),
        ‖Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (w x : ℂ)‖ = ‖w x‖ := by
      intro ξ x
      have h_exp : -((ξ : ℂ) * (x : ℂ)) * I = ((-(ξ * x) : ℝ) : ℂ) * I := by push_cast; ring
      rw [norm_mul, h_exp, Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real]
    have h_cont2 : Continuous (fun p : ℝ × ℝ =>
        Complex.exp (-((p.1 : ℂ) * (p.2 : ℂ)) * I) * (w p.2 : ℂ)) := by
      have := w.continuous
      fun_prop
    have h_meas_int : AEStronglyMeasurable
        (fun ξ : ℝ => ∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (w x : ℂ)) volume :=
      h_cont2.aestronglyMeasurable.integral_prod_right'
    have h_meas_fl : AEStronglyMeasurable (fourierLine w) volume :=
      aestronglyMeasurable_const.mul h_meas_int
    let C : ℝ := ‖((Real.sqrt (2 * π))⁻¹ : ℂ)‖ * ∫ x : ℝ, ‖w x‖
    have h_fl_sq_bound : ∀ ζ : ℝ, ‖fourierLine w ζ‖ ^ 2 ≤ C ^ 2 := by
      intro ζ
      have h_fl_bound : ‖fourierLine w ζ‖ ≤ C := by
        dsimp [fourierLine, C]
        rw [norm_mul]
        gcongr
        calc
          ‖∫ x : ℝ, Complex.exp (-((ζ : ℂ) * (x : ℂ)) * I) * (w x : ℂ)‖
            ≤ ∫ x : ℝ, ‖Complex.exp (-((ζ : ℂ) * (x : ℂ)) * I) * (w x : ℂ)‖ :=
              norm_integral_le_integral_norm _
          _ = ∫ x : ℝ, ‖w x‖ := by
              congr 1 with x
              exact norm_fourier_integrand ζ x
      exact pow_le_pow_left₀ (norm_nonneg _) h_fl_bound 2
    have h_int_base : Integrable (fun ζ : ℝ => ‖fourierLine w ζ‖ ^ 2 / (4 + ζ ^ 2)) volume := by
      have h_meas_num : AEStronglyMeasurable (fun ζ : ℝ => ‖fourierLine w ζ‖ ^ 2) volume :=
        h_meas_fl.norm.pow 2
      have h_cont_den : Continuous (fun ζ : ℝ => (4 + ζ ^ 2)⁻¹) :=
        Continuous.inv₀ (by fun_prop) (fun ζ => by positivity)
      have h_meas : AEStronglyMeasurable (fun ζ : ℝ => ‖fourierLine w ζ‖ ^ 2 / (4 + ζ ^ 2)) volume := by
        simpa [div_eq_mul_inv] using h_meas_num.mul h_cont_den.aestronglyMeasurable
      refine (integrable_inv_one_add_sq.const_mul (C ^ 2)).mono' h_meas ?_
      filter_upwards with ζ
      have h_nonneg : 0 ≤ ‖fourierLine w ζ‖ ^ 2 / (4 + ζ ^ 2) := by positivity
      rw [Real.norm_of_nonneg h_nonneg, div_eq_mul_inv]
      have h_den : 1 + ζ ^ 2 ≤ 4 + ζ ^ 2 := by linarith
      have h_inv : (4 + ζ ^ 2)⁻¹ ≤ (1 + ζ ^ 2)⁻¹ := inv_anti₀ (by positivity) h_den
      have := h_fl_sq_bound ζ
      gcongr
    have h_upper_pw : ∀ ζ : ℝ,
        (lam ^ 3 * ‖fourierLine w ζ‖ ^ 2) / (4 + lam ^ 2 * ζ ^ 2) ≤
        lam * (‖fourierLine w ζ‖ ^ 2 / (4 + ζ ^ 2)) := by
      intro ζ
      have h_lam_sq_le : lam ^ 2 ≤ 1 := by nlinarith
      have h_den_le : lam ^ 2 * (4 + ζ ^ 2) ≤ 4 + lam ^ 2 * ζ ^ 2 := by nlinarith
      calc
        (lam ^ 3 * ‖fourierLine w ζ‖ ^ 2) / (4 + lam ^ 2 * ζ ^ 2)
          ≤ (lam ^ 3 * ‖fourierLine w ζ‖ ^ 2) / (lam ^ 2 * (4 + ζ ^ 2)) := by
            gcongr
        _ = lam * (‖fourierLine w ζ‖ ^ 2 / (4 + ζ ^ 2)) := by
            have : 4 + ζ ^ 2 ≠ 0 := by positivity
            field_simp
    have h_int_scaled : Integrable (fun ζ : ℝ => (lam ^ 3 * ‖fourierLine w ζ‖ ^ 2) / (4 + lam ^ 2 * ζ ^ 2)) volume := by
      have h_meas_num : AEStronglyMeasurable (fun ζ : ℝ => lam ^ 3 * ‖fourierLine w ζ‖ ^ 2) volume :=
        aestronglyMeasurable_const.mul (h_meas_fl.norm.pow 2)
      have h_cont_den : Continuous (fun ζ : ℝ => (4 + lam ^ 2 * ζ ^ 2)⁻¹) :=
        Continuous.inv₀ (by fun_prop) (fun ζ => by positivity)
      have h_meas : AEStronglyMeasurable (fun ζ : ℝ => (lam ^ 3 * ‖fourierLine w ζ‖ ^ 2) / (4 + lam ^ 2 * ζ ^ 2)) volume := by
        simpa [div_eq_mul_inv] using h_meas_num.mul h_cont_den.aestronglyMeasurable
      refine (h_int_base.const_mul lam).mono' h_meas ?_
      filter_upwards with ζ
      have h_nonneg : 0 ≤ (lam ^ 3 * ‖fourierLine w ζ‖ ^ 2) / (4 + lam ^ 2 * ζ ^ 2) := by positivity
      rw [Real.norm_of_nonneg h_nonneg]
      exact h_upper_pw ζ
    have h_lower_pw : ∀ ζ : ℝ,
        lam ^ 3 * (‖fourierLine w ζ‖ ^ 2 / (4 + ζ ^ 2)) ≤
        (lam ^ 3 * ‖fourierLine w ζ‖ ^ 2) / (4 + lam ^ 2 * ζ ^ 2) := by
      intro ζ
      have h_lam_sq_le : lam ^ 2 ≤ 1 := by nlinarith
      have h_den_le : 4 + lam ^ 2 * ζ ^ 2 ≤ 4 + ζ ^ 2 := by nlinarith
      rw [← mul_div_assoc]
      gcongr
    refine ⟨?_, ?_⟩
    · rw [← integral_const_mul]
      exact integral_mono (h_int_base.const_mul (lam ^ 3)) h_int_scaled h_lower_pw
    · rw [← integral_const_mul]
      exact integral_mono h_int_scaled (h_int_base.const_mul lam) h_upper_pw
  let lam : ℝ := μ ^ 2
  have hlam_def : lam = μ ^ 2 := rfl
  have hlam_pos : 0 < lam := by positivity
  have hlam_le : lam ≤ 1 := by nlinarith
  obtain ⟨S_clm, hS_eval, hS_rhs⟩ := s1 lam hlam_pos
  let u_μ : ℝ → 𝓢(ℝ, ℝ) := fun τ => S_clm (u (lam ^ 3 * τ))
  refine ⟨u_μ, s2 lam hlam_pos S_clm hS_eval hS_rhs u hu, ?_, ?_⟩
  · have hu_μ0 : u_μ 0 = S_clm (u 0) := by
      dsimp [u_μ]
      rw [mul_zero]
    rw [hu_μ0]
    obtain ⟨_, h_high⟩ := s3 lam hlam_pos hlam_le (⇑S_clm) hS_eval (u 0)
    have h_sq : ‖ι (S_clm (u 0))‖ ^ 2 ≤ (μ * ‖ι (u 0)‖) ^ 2 := by
      calc ‖ι (S_clm (u 0))‖ ^ 2
        _ ≤ lam * ‖ι (u 0)‖ ^ 2 := h_high
        _ = (μ * ‖ι (u 0)‖) ^ 2 := by rw [hlam_def]; ring
    have h_sqrt := Real.sqrt_le_sqrt h_sq
    rwa [Real.sqrt_sq (norm_nonneg _), Real.sqrt_sq (by positivity)] at h_sqrt
  · intro t
    have h_time : lam ^ 3 * (t / μ ^ 6) = t := by
      rw [hlam_def]
      have hμ_ne : μ ≠ 0 := ne_of_gt hμ_pos
      field_simp
    have hu_μt : u_μ (t / μ ^ 6) = S_clm (u t) := by
      dsimp [u_μ]
      rw [h_time]
    rw [hu_μt]
    obtain ⟨h_low, _⟩ := s3 lam hlam_pos hlam_le (⇑S_clm) hS_eval (u t)
    have h_sq : (μ ^ 3 * ‖ι (u t)‖) ^ 2 ≤ ‖ι (S_clm (u t))‖ ^ 2 := by
      calc (μ ^ 3 * ‖ι (u t)‖) ^ 2
        _ = lam ^ 3 * ‖ι (u t)‖ ^ 2 := by rw [hlam_def]; ring
        _ ≤ ‖ι (S_clm (u t))‖ ^ 2 := h_low
    have h_sqrt := Real.sqrt_le_sqrt h_sq
    rwa [Real.sqrt_sq (by positivity), Real.sqrt_sq (norm_nonneg _)] at h_sqrt

theorem schwartz_small_data_apriori_step : ∃ δ > 0, ∃ δ₀ > 0, δ₀ ≤ δ / 2 ∧
      ∀ w : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution w → ‖ι (w 0)‖ ≤ δ₀ →
        ∀ t : ℝ, (∀ s ∈ Set.uIcc 0 t, ‖ι (w s)‖ ≤ δ) → ‖ι (w t)‖ ≤ δ / 2 :=
by
  obtain ⟨δ₁, c₁, c₂, hδ₁, hc₁, hc₁₂, h_quad⟩ := alphaFunctional_one_quadratic_bounds
  obtain ⟨δ₂, hδ₂, h_deriv⟩ := alphaFunctional_hasDerivAt_kdv
  obtain ⟨δ₃, hδ₃, h_ortho⟩ := kdvRHS_orthogonality_diagGreen
  have hc₂ : 0 < c₂ := lt_of_lt_of_le hc₁ hc₁₂
  let δ : ℝ := min δ₁ (min δ₂ δ₃)
  have hδ : 0 < δ := lt_min hδ₁ (lt_min hδ₂ hδ₃)
  have hδ_le₁ : δ ≤ δ₁ := min_le_left _ _
  have hδ_le₂ : δ ≤ δ₂ := le_trans (min_le_right _ _) (min_le_left _ _)
  have hδ_le₃ : δ ≤ δ₃ := le_trans (min_le_right _ _) (min_le_right _ _)
  let δ₀ : ℝ := (c₁ / (2 * c₂)) * δ
  have hδ₀ : 0 < δ₀ := by positivity
  have hδ₀_le : δ₀ ≤ δ / 2 := by
    have h1 : c₁ * δ ≤ c₂ * δ := mul_le_mul_of_nonneg_right hc₁₂ (le_of_lt hδ)
    have h2 : δ₀ = (c₁ * δ) / (2 * c₂) := by ring
    have h3 : δ / 2 = (c₂ * δ) / (2 * c₂) := by
      field_simp [ne_of_gt hc₂]
    rw [h2, h3]
    exact div_le_div_of_nonneg_right h1 (by positivity)
  refine ⟨δ, hδ, δ₀, hδ₀, hδ₀_le, ?_⟩
  intro w hw hw0 t h_ball
  let G : ℝ → ℝ := fun τ => alphaFunctional 1 (w τ)
  have hG_deriv : ∀ s ∈ Set.uIcc 0 t, HasDerivAt G 0 s := by
    intro s hs
    have hs_le : ‖ι (w s)‖ ≤ δ := h_ball s hs
    have hd := h_deriv w hw 1 le_rfl s (le_trans hs_le hδ_le₂)
    have ho := h_ortho 1 le_rfl (w s) (le_trans hs_le hδ_le₃)
    rw [ho] at hd
    exact hd
  have hG_const_Icc : ∀ {a b : ℝ}, a < b → Set.Icc a b ⊆ Set.uIcc 0 t → G b = G a := by
    intro a b hab h_sub
    have h_cont : ContinuousOn G (Set.Icc a b) :=
      fun x hx => (hG_deriv x (h_sub hx)).continuousAt.continuousWithinAt
    have h_der : ∀ x ∈ Set.Ioo a b, HasDerivAt G 0 x :=
      fun x hx => hG_deriv x (h_sub (Set.Ioo_subset_Icc_self hx))
    obtain ⟨c, _, hc⟩ := exists_hasDerivAt_eq_slope G (fun _ => 0) hab h_cont h_der
    have hba : b - a ≠ 0 := ne_of_gt (sub_pos.mpr hab)
    have h_sub_zero : G b - G a = 0 := (div_eq_zero_iff.mp hc.symm).resolve_right hba
    linarith
  have hG_eq : G t = G 0 := by
    rcases lt_trichotomy 0 t with hlt | rfl | hgt
    · exact hG_const_Icc hlt Set.Icc_subset_uIcc
    · rfl
    · exact (hG_const_Icc hgt Set.Icc_subset_uIcc').symm
  have hw0_δ₁ : ‖ι (w 0)‖ ≤ δ₁ := le_trans (h_ball 0 Set.left_mem_uIcc) hδ_le₁
  have hwt_δ₁ : ‖ι (w t)‖ ≤ δ₁ := le_trans (h_ball t Set.right_mem_uIcc) hδ_le₁
  have h_wt_low : c₁ * ‖ι (w t)‖ ^ 2 ≤ G t := (h_quad (w t) hwt_δ₁).1
  have h_w0_high : G 0 ≤ c₂ * ‖ι (w 0)‖ ^ 2 := (h_quad (w 0) hw0_δ₁).2
  have hw0_sq : ‖ι (w 0)‖ ^ 2 ≤ δ₀ ^ 2 :=
    sq_le_sq.mpr (by rw [abs_of_nonneg (norm_nonneg _), abs_of_pos hδ₀]; exact hw0)
  have h_c2_w0 : c₂ * ‖ι (w 0)‖ ^ 2 ≤ c₂ * δ₀ ^ 2 :=
    mul_le_mul_of_nonneg_left hw0_sq (le_of_lt hc₂)
  have h_alg : c₁ * (δ / 2) ^ 2 - c₂ * δ₀ ^ 2 = c₁ * (c₂ - c₁) * δ ^ 2 / (4 * c₂) := by
    dsimp [δ₀]
    field_simp [ne_of_gt hc₂]
    ring
  have h_alg_nonneg : 0 ≤ c₁ * (δ / 2) ^ 2 - c₂ * δ₀ ^ 2 := by
    rw [h_alg]
    have h_sub_nonneg : 0 ≤ c₂ - c₁ := sub_nonneg.mpr hc₁₂
    positivity
  have h_c1_sq : c₁ * ‖ι (w t)‖ ^ 2 ≤ c₁ * (δ / 2) ^ 2 := by linarith
  have h_wt_sq : ‖ι (w t)‖ ^ 2 ≤ (δ / 2) ^ 2 :=
    le_of_mul_le_mul_left h_c1_sq hc₁
  exact (abs_le_of_sq_le_sq' h_wt_sq (by positivity)).2

theorem schwartz_orbit_bounded (h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → IsSchwartzSolution v → u 0 = v 0 → u = v)
    (q : Hm1) :
    ∃ η > 0, ∃ M : ℝ, ∀ u : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → ‖ι (u 0) - q‖ < η → ∀ t : ℝ, ‖ι (u t)‖ ≤ M :=
by
  have h_abs_uIcc : ∀ {a b : ℝ}, a ∈ Set.uIcc 0 b → |a| ≤ |b| ∧ (|a| = |b| → a = b) := by
    intro a b h
    rw [Set.mem_uIcc] at h
    rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · have hb : 0 ≤ b := le_trans h1 h2
      rw [abs_of_nonneg h1, abs_of_nonneg hb]
      exact ⟨h2, id⟩
    · have hb : b ≤ 0 := le_trans h1 h2
      rw [abs_of_nonpos h2, abs_of_nonpos hb]
      exact ⟨by linarith, fun h_eq => by linarith⟩
  obtain ⟨δ, hδ, δ₀, hδ₀, hδ₀_le, h_apriori⟩ := schwartz_small_data_apriori_step
  let R : ℝ := ‖q‖ + 1
  have hR_pos : 0 < R := by
    have hq : 0 ≤ ‖q‖ := norm_nonneg q
    linarith
  let μ : ℝ := min 1 (δ₀ / R)
  have hμ_pos : 0 < μ := lt_min one_pos (div_pos hδ₀ hR_pos)
  have hμ_le : μ ≤ 1 := min_le_left 1 (δ₀ / R)
  have hμ_le_div : μ ≤ δ₀ / R := min_le_right 1 (δ₀ / R)
  refine ⟨1, one_pos, δ / μ ^ 3, ?_⟩
  intro u hu hu0 t
  have hu0_bound : ‖ι (u 0)‖ ≤ R := by
    have h_tri : ‖ι (u 0)‖ ≤ ‖q‖ + ‖ι (u 0) - q‖ := norm_le_norm_add_norm_sub' (ι (u 0)) q
    linarith
  obtain ⟨u_μ, hu_μ, h_init, h_unscale⟩ := kdv_scaling_hm1_bounds u hu μ hμ_pos hμ_le
  have hu_μ0_le_δ₀ : ‖ι (u_μ 0)‖ ≤ δ₀ := by
    have h1 : μ * ‖ι (u 0)‖ ≤ μ * R := mul_le_mul_of_nonneg_left hu0_bound (le_of_lt hμ_pos)
    have h2 : μ * R ≤ δ₀ := (le_div_iff₀ hR_pos).mp hμ_le_div
    linarith
  have hu_μ0_le_half : ‖ι (u_μ 0)‖ ≤ δ / 2 := le_trans hu_μ0_le_δ₀ hδ₀_le
  let f : ℝ → ℝ := fun τ => ‖ι (u_μ τ)‖
  have hf_cont : Continuous f := (schwartz_solution_continuous_hm1 u_μ hu_μ).norm
  have hf_step : ∀ τ : ℝ, (∀ s ∈ Set.uIcc 0 τ, f s ≤ δ) → f τ ≤ δ / 2 :=
    fun τ hτ => h_apriori u_μ hu_μ hu_μ0_le_δ₀ τ hτ
  have hf_all : ∀ τ : ℝ, f τ ≤ δ := by
    intro τ
    by_contra! h_gt
    let S : Set ℝ := Set.uIcc 0 τ ∩ {s : ℝ | δ ≤ f s}
    have hS_compact : IsCompact S :=
      isCompact_uIcc.inter_right (isClosed_Ici.preimage hf_cont)
    have hS_nonempty : S.Nonempty := ⟨τ, Set.right_mem_uIcc, le_of_lt h_gt⟩
    obtain ⟨s₀, ⟨hs₀_uIcc, hs₀_ge⟩, hs₀_min⟩ :=
      hS_compact.exists_isMinOn hS_nonempty continuous_abs.continuousOn
    change δ ≤ f s₀ at hs₀_ge
    have h_le_s₀ : ∀ s ∈ Set.uIcc 0 s₀, f s ≤ δ := by
      intro s hs
      by_contra! hs_gt
      have hδ_mem : δ ∈ Set.uIcc (f 0) (f s) :=
        Set.mem_uIcc.mpr (Or.inl ⟨by linarith [hu_μ0_le_half], le_of_lt hs_gt⟩)
      obtain ⟨s₁, hs₁_mem, hs₁_eq⟩ :=
        intermediate_value_uIcc hf_cont.continuousOn hδ_mem
      have hs_sub : Set.uIcc 0 s ⊆ Set.uIcc 0 s₀ := Set.uIcc_subset_uIcc_left hs
      have hs₀_sub : Set.uIcc 0 s₀ ⊆ Set.uIcc 0 τ := Set.uIcc_subset_uIcc_left hs₀_uIcc
      have hs₁_in_S : s₁ ∈ S := ⟨hs₀_sub (hs_sub hs₁_mem), le_of_eq hs₁_eq.symm⟩
      have h_min_s₁ : |s₀| ≤ |s₁| := hs₀_min hs₁_in_S
      have h_abs1 := h_abs_uIcc hs₁_mem
      have h_abs2 := h_abs_uIcc hs
      have h_eq1 : s₁ = s := h_abs1.2 (by linarith [h_abs1.1, h_abs2.1])
      subst h_eq1
      linarith
    have hs₀_half : f s₀ ≤ δ / 2 := hf_step s₀ h_le_s₀
    linarith
  have h_tau : ‖ι (u_μ (t / μ ^ 6))‖ ≤ δ := hf_all (t / μ ^ 6)
  have h_unscale_t : μ ^ 3 * ‖ι (u t)‖ ≤ δ := le_trans (h_unscale t) h_tau
  exact (le_div_iff₀' (pow_pos hμ_pos 3)).mpr h_unscale_t

theorem translateDiffSq_le_weighted_integral : ∀ (f : Lp ℂ 2 (volume : Measure ℝ)) (κ : ℝ), 1 ≤ κ → ∀ (h : ℝ), |h| < κ⁻¹ →
      translateDiffSq f h ≤
        8 * ∫ ξ : ℝ, (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(f : ℝ → ℂ) ξ‖ ^ 2 :=
by
  intro f κ hκ h hh
  have hκ_pos : 0 < κ := by linarith
  have h_abs_lt : |h| * κ < 1 := by
    rw [inv_eq_one_div, lt_div_iff₀ hκ_pos] at hh
    exact hh
  have h_abs_nonneg : 0 ≤ |h| * κ := mul_nonneg (abs_nonneg h) (le_of_lt hκ_pos)
  have h_κh : κ ^ 2 * h ^ 2 ≤ 1 := by
    have h_sq : (|h| * κ) ^ 2 ≤ 1 ^ 2 := by nlinarith
    have h_abs_sq : h ^ 2 = |h| ^ 2 := (sq_abs h).symm
    nlinarith
  have h_sin : ∀ ξ : ℝ, ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 = 4 * Real.sin (ξ * h / 2) ^ 2 := by
    intro ξ
    have h_exp : (ξ : ℂ) * (h : ℂ) * I = Complex.I * ((ξ * h : ℝ) : ℂ) := by
      push_cast
      ring
    rw [h_exp, Complex.norm_exp_I_mul_ofReal_sub_one (ξ * h), Real.norm_eq_abs]
    calc
      |2 * Real.sin (ξ * h / 2)| ^ 2 = (2 * Real.sin (ξ * h / 2)) ^ 2 := sq_abs _
      _ = 4 * Real.sin (ξ * h / 2) ^ 2 := by ring
  have h_low : ∀ ξ : ℝ, ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 ≤ ξ ^ 2 * h ^ 2 := by
    intro ξ
    have h1 : |Real.sin (ξ * h / 2)| ≤ |ξ * h / 2| := Real.abs_sin_le_abs
    have h2 : Real.sin (ξ * h / 2) ^ 2 ≤ (ξ * h / 2) ^ 2 := by
      rw [← sq_abs (Real.sin (ξ * h / 2)), ← sq_abs (ξ * h / 2)]
      exact pow_le_pow_left₀ (abs_nonneg _) h1 2
    rw [h_sin ξ]
    linarith
  have h_high : ∀ ξ : ℝ, ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1‖ ^ 2 ≤ 4 := by
    intro ξ
    have h1 : |Real.sin (ξ * h / 2)| ≤ 1 := Real.abs_sin_le_one (ξ * h / 2)
    have h2 : Real.sin (ξ * h / 2) ^ 2 ≤ 1 ^ 2 := by
      rw [← sq_abs (Real.sin (ξ * h / 2))]
      exact pow_le_pow_left₀ (abs_nonneg _) h1 2
    rw [h_sin ξ]
    linarith
  have h_pw : ∀ ξ : ℝ, ‖(Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1) * (f : ℝ → ℂ) ξ‖ ^ 2 ≤
      8 * ((4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(f : ℝ → ℂ) ξ‖ ^ 2) := by
    intro ξ
    set M := ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1‖ ^ 2
    have hM_low : M ≤ ξ ^ 2 * h ^ 2 := h_low ξ
    have hM_high : M ≤ 4 := h_high ξ
    have h_denom_pos : 0 < 4 * κ ^ 2 + ξ ^ 2 := by positivity
    have h_clear : M * (4 * κ ^ 2 + ξ ^ 2) ≤ 8 * (4 + ξ ^ 2) := by
      have h_4k2 : 0 ≤ 4 * κ ^ 2 := by positivity
      have h_xi2 : 0 ≤ ξ ^ 2 := sq_nonneg ξ
      have h_part1 : 4 * κ ^ 2 * M ≤ 4 * (κ ^ 2 * h ^ 2) * ξ ^ 2 := by nlinarith
      have h_part2 : 4 * (κ ^ 2 * h ^ 2) * ξ ^ 2 ≤ 4 * ξ ^ 2 := by nlinarith
      have h_part3 : ξ ^ 2 * M ≤ 4 * ξ ^ 2 := by nlinarith
      linarith
    have h_mult : M ≤ 8 * (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) :=
      (le_div_iff₀ h_denom_pos).mpr h_clear
    have h_eq : 8 * (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(f : ℝ → ℂ) ξ‖ ^ 2 =
        8 * ((4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(f : ℝ → ℂ) ξ‖ ^ 2) := by ring
    rw [norm_mul, mul_pow, ← h_eq]
    exact mul_le_mul_of_nonneg_right h_mult (sq_nonneg ‖(f : ℝ → ℂ) ξ‖)
  have h_int_norm : Integrable (fun ξ : ℝ => ‖(f : ℝ → ℂ) ξ‖ ^ 2) volume :=
    (MeasureTheory.Lp.memLp f).integrable_norm_pow (by decide : 2 ≠ 0)
  have h_cont_w : Continuous (fun ξ : ℝ => (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2)) := by
    apply Continuous.div
    · exact continuous_const.add (continuous_pow 2)
    · exact continuous_const.add (continuous_pow 2)
    · intro ξ
      positivity
  have h_int_W : Integrable (fun ξ : ℝ => (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(f : ℝ → ℂ) ξ‖ ^ 2) volume := by
    refine h_int_norm.mono' ?_ ?_
    · exact h_cont_w.aestronglyMeasurable.mul h_int_norm.aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun ξ => ?_)
      have h_denom_pos : 0 < 4 * κ ^ 2 + ξ ^ 2 := by positivity
      have h_num_nonneg : 0 ≤ 4 + ξ ^ 2 := by positivity
      have h_w_nonneg : 0 ≤ (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) := div_nonneg h_num_nonneg (le_of_lt h_denom_pos)
      have h_w_le_one : (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) ≤ 1 := by
        rw [div_le_one h_denom_pos]
        nlinarith
      have h_prod_nonneg : 0 ≤ (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(f : ℝ → ℂ) ξ‖ ^ 2 :=
        mul_nonneg h_w_nonneg (sq_nonneg _)
      rw [Real.norm_of_nonneg h_prod_nonneg]
      nlinarith [sq_nonneg ‖(f : ℝ → ℂ) ξ‖]
  have h_int_8W : Integrable (fun ξ : ℝ => 8 * ((4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(f : ℝ → ℂ) ξ‖ ^ 2)) volume :=
    h_int_W.const_mul 8
  unfold translateDiffSq
  rw [← MeasureTheory.integral_const_mul]
  exact MeasureTheory.integral_mono_of_nonneg
    (Filter.Eventually.of_forall (fun ξ => sq_nonneg _))
    h_int_8W
    (Filter.Eventually.of_forall h_pw)

theorem schwartz_weighted_integral_conservation_bound : ∀ (h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
      (h_unique : ∀ u v : ℝ → 𝓢(ℝ, ℝ),
        IsSchwartzSolution u → IsSchwartzSolution v → u 0 = v 0 → u = v)
      (q : Hm1),
      ∃ κ₀ ≥ (1 : ℝ), ∃ C > (0 : ℝ), ∀ u : ℝ → 𝓢(ℝ, ℝ),
        IsSchwartzSolution u → ‖ι (u 0) - q‖ < 1 →
        ∀ (t : ℝ) (κ : ℝ), κ₀ ≤ κ →
          (∫ ξ : ℝ, (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖((ι (u t) : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2) ≤
            C * ∫ ξ : ℝ, (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖((ι (u 0) : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 :=
by
  have norm_fourier_integrand : ∀ (q : ℝ → ℝ) (ξ x : ℝ),
      ‖Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)‖ = ‖q x‖ := by
    intro q ξ x
    have h_exp : -((ξ : ℂ) * (x : ℂ)) * I = ((-(ξ * x) : ℝ) : ℂ) * I := by push_cast; ring
    rw [norm_mul, h_exp, Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real]
  have h_mem : ∀ q : 𝓢(ℝ, ℝ), MemLp (hm1Profile q) 2 (volume : Measure ℝ) := by
    intro q
    have h_cont2 : Continuous (fun p : ℝ × ℝ =>
        Complex.exp (-((p.1 : ℂ) * (p.2 : ℂ)) * I) * (q p.2 : ℂ)) := by
      have := q.continuous
      fun_prop
    have h_meas_int : AEStronglyMeasurable
        (fun ξ : ℝ => ∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)) volume :=
      h_cont2.aestronglyMeasurable.integral_prod_right'
    have h_meas_fl : AEStronglyMeasurable (fourierLine q) volume :=
      aestronglyMeasurable_const.mul h_meas_int
    have h_cont_w : Continuous (fun ξ : ℝ => ((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ)) :=
      Continuous.inv₀ (by fun_prop) (fun ξ => Complex.ofReal_ne_zero.mpr (by positivity))
    have h_meas : AEStronglyMeasurable (hm1Profile q) volume :=
      h_cont_w.aestronglyMeasurable.mul h_meas_fl
    rw [memLp_two_iff_integrable_sq_norm h_meas]
    let C : ℝ := ‖((Real.sqrt (2 * π))⁻¹ : ℂ)‖ * ∫ x : ℝ, ‖q x‖
    refine (integrable_inv_one_add_sq.const_mul (C ^ 2)).mono'
      (h_meas.norm.pow 2) ?_
    filter_upwards with ξ
    have h_fl_bound : ‖fourierLine q ξ‖ ≤ C := by
      dsimp [fourierLine, C]
      rw [norm_mul]
      gcongr
      calc
        ‖∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)‖
          ≤ ∫ x : ℝ, ‖Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)‖ :=
            norm_integral_le_integral_norm _
        _ = ∫ x : ℝ, ‖q x‖ := by
            congr 1 with x
            exact norm_fourier_integrand q ξ x
    have h_w_norm : ‖((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ)‖ = (Real.sqrt (4 + ξ ^ 2))⁻¹ := by
      rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    have h_sq : ‖hm1Profile q ξ‖ ^ 2 = (4 + ξ ^ 2)⁻¹ * ‖fourierLine q ξ‖ ^ 2 := by
      dsimp [hm1Profile]
      rw [norm_mul, h_w_norm, mul_pow, inv_pow, Real.sq_sqrt (by positivity)]
    rw [Real.norm_of_nonneg (sq_nonneg _), h_sq]
    have h_inv_le : (4 + ξ ^ 2)⁻¹ ≤ (1 + ξ ^ 2)⁻¹ := by
      apply inv_anti₀ (by positivity)
      linarith
    have h_sq_le : ‖fourierLine q ξ‖ ^ 2 ≤ C ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) h_fl_bound 2
    calc
      (4 + ξ ^ 2)⁻¹ * ‖fourierLine q ξ‖ ^ 2 ≤ (1 + ξ ^ 2)⁻¹ * C ^ 2 := by gcongr
      _ = C ^ 2 * (1 + ξ ^ 2)⁻¹ := mul_comm _ _
  have h_toHm1 : ∀ q : 𝓢(ℝ, ℝ), toHm1 q = (h_mem q).toLp (hm1Profile q) := by
    intro q
    dsimp [toHm1]
    rw [dif_pos (h_mem q)]
  have s4 : ∀ (μ : ℝ) (w : 𝓢(ℝ, ℝ)),
      hm1KappaSq μ (ι w) = ∫ ξ : ℝ, ‖fourierLine w ξ‖ ^ 2 / (4 * μ ^ 2 + ξ ^ 2) := by
    intro μ w
    dsimp [hm1KappaSq, ι]
    apply integral_congr_ae
    filter_upwards [(h_mem w).coeFn_toLp] with ξ hξ
    rw [h_toHm1 w, hξ]
    have h_w_norm : ‖((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ)‖ = (Real.sqrt (4 + ξ ^ 2))⁻¹ := by
      rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    have h_sq : ‖hm1Profile w ξ‖ ^ 2 = (4 + ξ ^ 2)⁻¹ * ‖fourierLine w ξ‖ ^ 2 := by
      dsimp [hm1Profile]
      rw [norm_mul, h_w_norm, mul_pow, inv_pow, Real.sq_sqrt (by positivity)]
    rw [h_sq]
    have : 4 + ξ ^ 2 ≠ 0 := by positivity
    field_simp
  have s5 : ∀ (lam : ℝ), 0 < lam →
      ∀ (S : 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ)),
      (∀ w : 𝓢(ℝ, ℝ), ∀ x : ℝ, S w x = lam ^ 2 * w (lam * x)) →
      ∀ (κ : ℝ) (w : 𝓢(ℝ, ℝ)),
      (∫ ξ : ℝ, ‖fourierLine (S w) ξ‖ ^ 2 / (4 * (lam * κ) ^ 2 + ξ ^ 2)) =
        lam * ∫ ξ : ℝ, ‖fourierLine w ξ‖ ^ 2 / (4 * κ ^ 2 + ξ ^ 2) := by
    intro lam hlam S hS_eval κ w
    have hlam_ne : lam ≠ 0 := ne_of_gt hlam
    have h_fl_scale : ∀ ξ : ℝ, fourierLine (S w) ξ = (lam : ℂ) * fourierLine w (lam⁻¹ * ξ) := by
      intro ξ
      dsimp [fourierLine]
      have h_int_eq :
          (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((S w x : ℝ) : ℂ)) =
          (fun x : ℝ => (lam ^ 2 : ℂ) * (Complex.exp (-(((lam⁻¹ * ξ : ℝ) : ℂ) * ((lam * x : ℝ) : ℂ)) * I) * (w (lam * x) : ℂ))) := by
        ext x
        rw [hS_eval w x]
        have h_mul : -((ξ : ℂ) * (x : ℂ)) * I = -(((lam⁻¹ * ξ : ℝ) : ℂ) * ((lam * x : ℝ) : ℂ)) * I := by
          push_cast
          have h_lam_c : (lam : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hlam_ne
          field_simp
        rw [h_mul]
        push_cast
        ring
      rw [h_int_eq, integral_const_mul]
      let g : ℝ → ℂ := fun y => Complex.exp (-(((lam⁻¹ * ξ : ℝ) : ℂ) * (y : ℂ)) * I) * (w y : ℂ)
      have h_cov : (∫ x : ℝ, g (lam * x)) = |lam⁻¹| • ∫ y : ℝ, g y :=
        Measure.integral_comp_mul_left g lam
      change ((Real.sqrt (2 * π))⁻¹ : ℂ) * ((lam ^ 2 : ℂ) * ∫ x : ℝ, g (lam * x)) =
        (lam : ℂ) * (((Real.sqrt (2 * π))⁻¹ : ℂ) * ∫ y : ℝ, g y)
      rw [h_cov, abs_of_pos (inv_pos.mpr hlam), Complex.real_smul]
      push_cast
      have h_lam_c : (lam : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hlam_ne
      field_simp
    have h_norm_fl_scale : ∀ ξ : ℝ, ‖fourierLine (S w) ξ‖ ^ 2 = lam ^ 2 * ‖fourierLine w (lam⁻¹ * ξ)‖ ^ 2 := by
      intro ξ
      rw [h_fl_scale ξ, norm_mul, Complex.norm_real, Real.norm_of_nonneg (le_of_lt hlam), mul_pow]
    let G : ℝ → ℝ := fun ζ => ‖fourierLine w ζ‖ ^ 2 / (4 * κ ^ 2 + ζ ^ 2)
    have h_lhs_eq :
        (fun ξ : ℝ => ‖fourierLine (S w) ξ‖ ^ 2 / (4 * (lam * κ) ^ 2 + ξ ^ 2)) =
        (fun ξ : ℝ => G (lam⁻¹ * ξ)) := by
      ext ξ
      dsimp [G]
      rw [h_norm_fl_scale ξ]
      have h_den : 4 * (lam * κ) ^ 2 + ξ ^ 2 = lam ^ 2 * (4 * κ ^ 2 + (lam⁻¹ * ξ) ^ 2) := by
        have h_xi : lam ^ 2 * (lam⁻¹ * ξ) ^ 2 = ξ ^ 2 := by
          calc lam ^ 2 * (lam⁻¹ * ξ) ^ 2 = (lam * lam⁻¹) ^ 2 * ξ ^ 2 := by ring
          _ = 1 ^ 2 * ξ ^ 2 := by rw [mul_inv_cancel₀ hlam_ne]
          _ = ξ ^ 2 := by ring
        linarith [show 4 * (lam * κ) ^ 2 = lam ^ 2 * (4 * κ ^ 2) by ring]
      rw [h_den, mul_div_mul_left _ _ (pow_ne_zero 2 hlam_ne)]
    rw [h_lhs_eq, Measure.integral_comp_mul_left G lam⁻¹, inv_inv, abs_of_pos hlam, smul_eq_mul]
  intro h_exists h_unique q
  obtain ⟨δ₁, c₁, c₂, _K_alpha, _C_int, hδ₁, hc₁, hc₁₂, _hK_alpha, _hC_int,
    h_quad, _h_alpha_ratio, _h_interp⟩ := diagGreen_alpha_and_interpolation
  have hc₂ : 0 < c₂ := lt_of_lt_of_le hc₁ hc₁₂
  obtain ⟨δ₀, hδ₀, _hδ₀_le, h_cons⟩ :=
    kdv_alpha_conservation_small_data h_exists h_unique δ₁ hδ₁
  obtain ⟨lam, S, hlam_pos, hlam_le, hS_eval, hS_sol, hS_init,
    _hS_nonexp, _hS_inv, _hS_kappa⟩ := kdv_scaling_symmetry q δ₀ hδ₀
  have hlam_ne : lam ≠ 0 := ne_of_gt hlam_pos
  have hκ₀ : 1 ≤ lam⁻¹ := by
    have h_mul := mul_le_mul_of_nonneg_right hlam_le (le_of_lt (inv_pos.mpr hlam_pos))
    rwa [mul_inv_cancel₀ hlam_ne, one_mul] at h_mul
  refine ⟨lam⁻¹, hκ₀, c₂ / c₁, div_pos hc₂ hc₁, ?_⟩
  intro u hu hu0 t κ hκ
  change hm1KappaSq κ (ι (u t)) ≤ (c₂ / c₁) * hm1KappaSq κ (ι (u 0))
  set w : ℝ → 𝓢(ℝ, ℝ) := fun τ => S (u (lam ^ 3 * τ))
  have hw_sol : IsSchwartzSolution w := hS_sol u hu
  have hw0_eq : w 0 = S (u 0) := by
    dsimp [w]
    rw [mul_zero]
  have hw0_bound : ‖ι (w 0)‖ ≤ δ₀ := by
    rw [hw0_eq]
    exact hS_init (u 0) hu0
  have hκ' : 1 ≤ lam * κ := by
    have h_mul := mul_le_mul_of_nonneg_left hκ (le_of_lt hlam_pos)
    rwa [mul_inv_cancel₀ hlam_ne] at h_mul
  set τ : ℝ := (lam ^ 3)⁻¹ * t
  have hwτ_eq : w τ = S (u t) := by
    dsimp [w, τ]
    rw [mul_inv_cancel_left₀ (pow_ne_zero 3 hlam_ne)]
  have h_w_cons := h_cons w hw_sol hw0_bound
  have hwτ_δ₁ : ‖ι (w τ)‖ ≤ δ₁ := h_w_cons.1 τ
  have hw0_δ₁ : ‖ι (w 0)‖ ≤ δ₁ := h_w_cons.1 0
  have h_alpha_eq : alphaFunctional (lam * κ) (w τ) = alphaFunctional (lam * κ) (w 0) :=
    h_w_cons.2 (lam * κ) hκ' τ
  have h_low := (h_quad (lam * κ) hκ' (w τ) hwτ_δ₁).1
  have h_high := (h_quad (lam * κ) hκ' (w 0) hw0_δ₁).2
  have h_c1_c2 : c₁ * hm1KappaSq (lam * κ) (ι (w τ)) ≤ c₂ * hm1KappaSq (lam * κ) (ι (w 0)) := by
    have : (lam * κ) * alphaFunctional (lam * κ) (w τ) =
        (lam * κ) * alphaFunctional (lam * κ) (w 0) := by rw [h_alpha_eq]
    linarith
  have h_w_bound : hm1KappaSq (lam * κ) (ι (w τ)) ≤ (c₂ / c₁) * hm1KappaSq (lam * κ) (ι (w 0)) := by
    rw [div_mul_eq_mul_div, le_div_iff₀' hc₁]
    exact h_c1_c2
  rw [hwτ_eq, hw0_eq] at h_w_bound
  have h_scale_eq : ∀ v : 𝓢(ℝ, ℝ),
      hm1KappaSq (lam * κ) (ι (S v)) = lam * hm1KappaSq κ (ι v) := by
    intro v
    rw [s4 (lam * κ) (S v), s5 lam hlam_pos S hS_eval κ v, ← s4 κ v]
  rw [h_scale_eq (u t), h_scale_eq (u 0)] at h_w_bound
  exact le_of_mul_le_mul_left (by linarith) hlam_pos

theorem weighted_integral_perturbation_bound : ∀ (f g : Lp ℂ 2 (volume : Measure ℝ)) (κ : ℝ), 1 ≤ κ →
      (∫ ξ : ℝ, (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(f : ℝ → ℂ) ξ‖ ^ 2) ≤
        2 * (∫ ξ : ℝ, (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(g : ℝ → ℂ) ξ‖ ^ 2) +
          2 * ‖f - g‖ ^ 2 :=
by
  intro f g κ hκ
  have h_cont_w : Continuous (fun ξ : ℝ => (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2)) := by
    apply Continuous.div
    · exact continuous_const.add (continuous_pow 2)
    · exact continuous_const.add (continuous_pow 2)
    · intro ξ
      positivity
  have h_w_nonneg : ∀ ξ : ℝ, 0 ≤ (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) := by
    intro ξ
    positivity
  have h_w_le_one : ∀ ξ : ℝ, (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) ≤ 1 := by
    intro ξ
    have h_denom_pos : 0 < 4 * κ ^ 2 + ξ ^ 2 := by positivity
    rw [div_le_one h_denom_pos]
    nlinarith
  have h_int_sq : ∀ h : Lp ℂ 2 (volume : Measure ℝ),
      Integrable (fun ξ : ℝ => ‖(h : ℝ → ℂ) ξ‖ ^ 2) volume :=
    fun h => (MeasureTheory.Lp.memLp h).integrable_norm_pow (by decide : 2 ≠ 0)
  have h_int_W : ∀ h : Lp ℂ 2 (volume : Measure ℝ),
      Integrable (fun ξ : ℝ => (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(h : ℝ → ℂ) ξ‖ ^ 2) volume := by
    intro h
    refine (h_int_sq h).mono' ?_ ?_
    · exact h_cont_w.aestronglyMeasurable.mul (h_int_sq h).aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun ξ => ?_)
      have h_prod_nonneg : 0 ≤ (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(h : ℝ → ℂ) ξ‖ ^ 2 :=
        mul_nonneg (h_w_nonneg ξ) (sq_nonneg _)
      rw [Real.norm_of_nonneg h_prod_nonneg]
      nlinarith [h_w_le_one ξ, sq_nonneg ‖(h : ℝ → ℂ) ξ‖]
  have h_norm_sq : ‖f - g‖ ^ 2 = ∫ ξ : ℝ, ‖((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 := by
    have h1 : ‖f - g‖ ^ 2 = @inner ℝ (Lp ℂ 2 (volume : Measure ℝ)) _ (f - g) (f - g) :=
      (real_inner_self_eq_norm_sq (f - g)).symm
    have h2 : @inner ℝ (Lp ℂ 2 (volume : Measure ℝ)) _ (f - g) (f - g) =
        ∫ ξ : ℝ, @inner ℝ ℂ _ (((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ)
          (((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ) :=
      MeasureTheory.L2.inner_def (f - g) (f - g)
    rw [h1, h2]
    congr 1
    ext ξ
    exact real_inner_self_eq_norm_sq (((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ)
  have h_ae : ∀ᵐ ξ : ℝ ∂volume,
      (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(f : ℝ → ℂ) ξ‖ ^ 2 ≤
        2 * ((4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(g : ℝ → ℂ) ξ‖ ^ 2) +
          2 * ‖((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 := by
    filter_upwards [MeasureTheory.Lp.coeFn_sub f g] with ξ hξ
    have h_tri : ‖(f : ℝ → ℂ) ξ‖ ≤
        ‖((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ + ‖(g : ℝ → ℂ) ξ‖ := by
      have h_eq : (f : ℝ → ℂ) ξ = ((f : ℝ → ℂ) ξ - (g : ℝ → ℂ) ξ) + (g : ℝ → ℂ) ξ :=
        (sub_add_cancel _ _).symm
      have h_add := norm_add_le ((f : ℝ → ℂ) ξ - (g : ℝ → ℂ) ξ) ((g : ℝ → ℂ) ξ)
      rw [← h_eq] at h_add
      have hξ_apply : ((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ =
          (f : ℝ → ℂ) ξ - (g : ℝ → ℂ) ξ := hξ
      rw [hξ_apply]
      exact h_add
    have h_f_nonneg : 0 ≤ ‖(f : ℝ → ℂ) ξ‖ := norm_nonneg _
    have h_g_nonneg : 0 ≤ ‖(g : ℝ → ℂ) ξ‖ := norm_nonneg _
    have h_fg_nonneg : 0 ≤ ‖((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ := norm_nonneg _
    have h_sq_diff : 0 ≤ (‖(g : ℝ → ℂ) ξ‖ -
        ‖((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖) ^ 2 := sq_nonneg _
    have h_sq_bound : ‖(f : ℝ → ℂ) ξ‖ ^ 2 ≤
        2 * ‖(g : ℝ → ℂ) ξ‖ ^ 2 + 2 * ‖((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 := by
      nlinarith
    have hw0 := h_w_nonneg ξ
    have hw1 := h_w_le_one ξ
    have h_fg_sq_nonneg : 0 ≤ ‖((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2 := sq_nonneg _
    nlinarith
  have h_int_rhs : Integrable (fun ξ : ℝ =>
      2 * ((4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(g : ℝ → ℂ) ξ‖ ^ 2) +
        2 * ‖((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2) volume :=
    ((h_int_W g).const_mul 2).add ((h_int_sq (f - g)).const_mul 2)
  have h_int_mono := MeasureTheory.integral_mono_ae (h_int_W f) h_int_rhs h_ae
  rw [MeasureTheory.integral_add ((h_int_W g).const_mul 2) ((h_int_sq (f - g)).const_mul 2),
      MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul, ← h_norm_sq] at h_int_mono
  exact h_int_mono

theorem exists_weighted_integral_lt : ∀ (g : Lp ℂ 2 (volume : Measure ℝ)) (κ₀ ε₁ : ℝ), 0 < ε₁ →
      ∃ κ : ℝ, max 1 κ₀ ≤ κ ∧
        (∫ ξ : ℝ, (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) * ‖(g : ℝ → ℂ) ξ‖ ^ 2) < ε₁ :=
by
  intro g κ₀ ε₁ hε₁
  have h_m_nonneg : ∀ (κ : ℝ), 1 ≤ κ → ∀ (ξ : ℝ), 0 ≤ (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) := by
    intro κ hκ ξ
    have h_pos : 0 < 4 * κ ^ 2 + ξ ^ 2 := by nlinarith
    exact div_nonneg (by positivity) (le_of_lt h_pos)
  have h_m_le_one : ∀ (κ : ℝ), 1 ≤ κ → ∀ (ξ : ℝ), (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) ≤ 1 := by
    intro κ hκ ξ
    have h_pos : 0 < 4 * κ ^ 2 + ξ ^ 2 := by nlinarith
    exact div_le_one_of_le₀ (by nlinarith) (le_of_lt h_pos)
  have hB_int : Integrable (fun ξ : ℝ => ‖(g : ℝ → ℂ) ξ‖ ^ 2) volume :=
    (Lp.memLp g).integrable_norm_pow (by norm_num)
  let M : ℝ := max 1 κ₀
  have hM₁ : 1 ≤ M := le_max_left 1 κ₀
  let F : ℕ → ℝ → ℝ := fun n ξ =>
    (4 + ξ ^ 2) / (4 * (M + (n : ℝ)) ^ 2 + ξ ^ 2) * ‖(g : ℝ → ℂ) ξ‖ ^ 2
  let B : ℝ → ℝ := fun ξ => ‖(g : ℝ → ℂ) ξ‖ ^ 2
  have hF_meas : ∀ n : ℕ, AEStronglyMeasurable (F n) volume := by
    intro n
    have hn : 1 ≤ M + (n : ℝ) := by linarith [Nat.cast_nonneg (α := ℝ) n]
    have h_cont : Continuous (fun ξ : ℝ => (4 + ξ ^ 2) / (4 * (M + (n : ℝ)) ^ 2 + ξ ^ 2)) := by
      refine Continuous.div (continuous_const.add (continuous_pow 2))
        (continuous_const.add (continuous_pow 2)) ?_
      intro ξ
      have : 0 < 4 * (M + (n : ℝ)) ^ 2 + ξ ^ 2 := by nlinarith
      exact ne_of_gt this
    exact h_cont.aestronglyMeasurable.mul hB_int.aestronglyMeasurable
  have hF_bound : ∀ n : ℕ, ∀ᵐ ξ : ℝ ∂volume, ‖F n ξ‖ ≤ B ξ := by
    intro n
    have hn : 1 ≤ M + (n : ℝ) := by linarith [Nat.cast_nonneg (α := ℝ) n]
    filter_upwards with ξ
    rw [Real.norm_of_nonneg (mul_nonneg (h_m_nonneg (M + (n : ℝ)) hn ξ) (sq_nonneg _))]
    exact mul_le_of_le_one_left (sq_nonneg _) (h_m_le_one (M + (n : ℝ)) hn ξ)
  have hF_lim : ∀ᵐ ξ : ℝ ∂volume, Filter.Tendsto (fun n : ℕ => F n ξ) Filter.atTop (nhds (0 : ℝ)) := by
    filter_upwards with ξ
    dsimp [F]
    have h1 : Filter.Tendsto (fun n : ℕ => M + (n : ℝ)) Filter.atTop Filter.atTop :=
      Filter.tendsto_atTop_add_const_left _ M tendsto_natCast_atTop_atTop
    have h2 : Filter.Tendsto (fun n : ℕ => (M + (n : ℝ)) ^ 2) Filter.atTop Filter.atTop := by
      simpa only [sq] using Filter.Tendsto.atTop_mul_atTop₀ h1 h1
    have h3 : Filter.Tendsto (fun n : ℕ => 4 * (M + (n : ℝ)) ^ 2 + ξ ^ 2) Filter.atTop Filter.atTop :=
      Filter.Tendsto.atTop_add (Filter.Tendsto.const_mul_atTop (by norm_num) h2) tendsto_const_nhds
    have h4 : Filter.Tendsto
        (fun n : ℕ => ((4 + ξ ^ 2) * ‖(g : ℝ → ℂ) ξ‖ ^ 2) / (4 * (M + (n : ℝ)) ^ 2 + ξ ^ 2))
        Filter.atTop (nhds 0) :=
      Filter.Tendsto.div_atTop tendsto_const_nhds h3
    simpa only [div_mul_eq_mul_div] using h4
  have h_tendsto := MeasureTheory.tendsto_integral_of_dominated_convergence B hF_meas hB_int hF_bound hF_lim
  rw [MeasureTheory.integral_zero] at h_tendsto
  have h_ev : ∀ᶠ n : ℕ in Filter.atTop, (∫ ξ : ℝ, F n ξ) < ε₁ :=
    h_tendsto.eventually (gt_mem_nhds hε₁)
  obtain ⟨N, hN⟩ := h_ev.exists
  refine ⟨M + (N : ℝ), ?_, hN⟩
  have hN_nonneg : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
  dsimp [M]
  linarith

theorem schwartz_orbit_equicontinuous (h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → IsSchwartzSolution v → u 0 = v 0 → u = v)
    (q : Hm1) (ε : ℝ) (hε : 0 < ε) :
    ∃ η > 0, ∃ δ > 0, ∀ u : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → ‖ι (u 0) - q‖ < η →
      ∀ t h : ℝ, |h| < δ →
        translateDiffSq (ι (u t) : Lp ℂ 2 (volume : Measure ℝ)) h < ε / 2 :=
by
  obtain ⟨κ₀, _hκ₀, C, hC, h_cons⟩ :=
    schwartz_weighted_integral_conservation_bound h_exists h_unique q
  have hε₁ : 0 < ε / (64 * C) := by positivity
  obtain ⟨κ, hκ_max, h_q⟩ :=
    exists_weighted_integral_lt (q : Lp ℂ 2 (volume : Measure ℝ)) κ₀ (ε / (64 * C)) hε₁
  have hκ₁ : 1 ≤ κ := (max_le_iff.mp hκ_max).1
  have hκ₀_le : κ₀ ≤ κ := (max_le_iff.mp hκ_max).2
  have hκ_pos : 0 < κ := by linarith
  refine ⟨min 1 (ε / (64 * C)), lt_min one_pos hε₁, κ⁻¹, inv_pos.mpr hκ_pos, ?_⟩
  intro u hu hu0 t h hh
  have hu0_lt1 : ‖ι (u 0) - q‖ < 1 := (lt_min_iff.mp hu0).1
  have hu0_lt_eps : ‖ι (u 0) - q‖ < ε / (64 * C) := (lt_min_iff.mp hu0).2
  have hu0_nonneg : 0 ≤ ‖ι (u 0) - q‖ := norm_nonneg _
  have hu0_sq : ‖ι (u 0) - q‖ ^ 2 ≤ ‖ι (u 0) - q‖ := by nlinarith
  have h_coe_norm :
      ‖(ι (u 0) : Lp ℂ 2 (volume : Measure ℝ)) - (q : Lp ℂ 2 (volume : Measure ℝ))‖ =
        ‖ι (u 0) - q‖ := rfl
  have h1 := translateDiffSq_le_weighted_integral (ι (u t) : Lp ℂ 2 (volume : Measure ℝ)) κ hκ₁ h hh
  have h2 := h_cons u hu hu0_lt1 t κ hκ₀_le
  have h3 := weighted_integral_perturbation_bound
    (ι (u 0) : Lp ℂ 2 (volume : Measure ℝ)) (q : Lp ℂ 2 (volume : Measure ℝ)) κ hκ₁
  rw [h_coe_norm] at h3
  have h_prod : 64 * C * (ε / (64 * C)) = ε := by
    field_simp
  nlinarith

theorem continuous_translateDiffSq (h : ℝ) :
    Continuous (fun f : Lp ℂ 2 (volume : Measure ℝ) => translateDiffSq f h) :=
by
  let m : ℝ → ℂ := fun ξ => Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1
  have hm_cont : Continuous m := by
    refine Continuous.sub ?_ continuous_const
    exact Complex.continuous_exp.comp ((Complex.continuous_ofReal.mul continuous_const).mul continuous_const)
  have hm_meas : AEStronglyMeasurable m volume := hm_cont.aestronglyMeasurable
  have hm_bound : ∀ ξ : ℝ, ‖m ξ‖ ≤ 2 := by
    intro ξ
    dsimp [m]
    have h_tri : ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1‖ ≤ ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I)‖ + ‖(1 : ℂ)‖ :=
      norm_sub_le _ _
    have h_exp : ‖Complex.exp ((ξ : ℂ) * (h : ℂ) * I)‖ = 1 := by
      have h_eq_arg : (ξ : ℂ) * (h : ℂ) * I = ((ξ * h : ℝ) : ℂ) * I := by push_cast; ring
      rw [h_eq_arg, Complex.norm_exp_ofReal_mul_I]
    rw [h_exp, norm_one] at h_tri
    linarith
  have hm_nnnorm : ∀ ξ : ℝ, ‖m ξ‖₊ ≤ (2 : NNReal) := by
    intro ξ
    exact hm_bound ξ
  have h_mem : ∀ f : Lp ℂ 2 (volume : Measure ℝ),
      MemLp (fun ξ : ℝ => m ξ * (f : ℝ → ℂ) ξ) 2 volume := by
    intro f
    have hg : MemLp (fun ξ : ℝ => 2 * ‖(f : ℝ → ℂ) ξ‖) 2 volume :=
      ((Lp.memLp f).norm).const_mul 2
    refine MemLp.mono' hg (hm_meas.mul (Lp.aestronglyMeasurable f)) ?_
    filter_upwards with ξ
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hm_bound ξ) (norm_nonneg _)
  let T_h : Lp ℂ 2 (volume : Measure ℝ) → Lp ℂ 2 (volume : Measure ℝ) :=
    fun f => (h_mem f).toLp (fun ξ : ℝ => m ξ * (f : ℝ → ℂ) ξ)
  have h_norm_sq : ∀ g : Lp ℂ 2 (volume : Measure ℝ),
      ‖g‖ ^ 2 = ∫ ξ : ℝ, ‖(g : ℝ → ℂ) ξ‖ ^ 2 := by
    intro g
    have h1 : ‖g‖ ^ 2 = @inner ℝ (Lp ℂ 2 (volume : Measure ℝ)) _ g g :=
      (real_inner_self_eq_norm_sq g).symm
    have h2 : @inner ℝ (Lp ℂ 2 (volume : Measure ℝ)) _ g g =
        ∫ ξ : ℝ, @inner ℝ ℂ _ ((g : ℝ → ℂ) ξ) ((g : ℝ → ℂ) ξ) :=
      MeasureTheory.L2.inner_def g g
    rw [h1, h2]
    congr 1
    ext ξ
    exact real_inner_self_eq_norm_sq ((g : ℝ → ℂ) ξ)
  have h_eq : ∀ f : Lp ℂ 2 (volume : Measure ℝ), translateDiffSq f h = ‖T_h f‖ ^ 2 := by
    intro f
    rw [h_norm_sq (T_h f)]
    dsimp [translateDiffSq, T_h, m]
    refine (integral_congr_ae ?_).symm
    filter_upwards [(h_mem f).coeFn_toLp] with ξ hξ
    rw [hξ]
  have h_lip : LipschitzWith 2 T_h := by
    refine LipschitzWith.of_dist_le_mul fun f g => ?_
    rw [dist_eq_norm, dist_eq_norm]
    dsimp [T_h]
    rw [← MemLp.toLp_sub (h_mem f) (h_mem g), Lp.norm_toLp, Lp.norm_def (f - g)]
    have h_ae : ∀ᵐ ξ : ℝ ∂volume,
        ‖m ξ * (f : ℝ → ℂ) ξ - m ξ * (g : ℝ → ℂ) ξ‖₊ ≤
          (2 : NNReal) * ‖((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖₊ := by
      filter_upwards [Lp.coeFn_sub f g] with ξ hξ
      rw [← mul_sub, nnnorm_mul]
      have hξ' : (f : ℝ → ℂ) ξ - (g : ℝ → ℂ) ξ = ((f - g : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ :=
        hξ.symm
      rw [hξ']
      exact mul_le_mul_of_nonneg_right (hm_nnnorm ξ) (zero_le _)
    have h_elp := eLpNorm_le_nnreal_smul_eLpNorm_of_ae_le_mul h_ae 2
    have h_ne_top : ((2 : NNReal) • eLpNorm (f - g) 2 volume) ≠ ⊤ := by
      rw [ENNReal.smul_def]
      exact ENNReal.mul_ne_top ENNReal.coe_ne_top (Lp.eLpNorm_ne_top (f - g))
    have h_toReal := ENNReal.toReal_mono h_ne_top h_elp
    rw [ENNReal.toReal_smul] at h_toReal
    exact h_toReal
  have h_fun_eq : (fun f : Lp ℂ 2 (volume : Measure ℝ) => translateDiffSq f h) =
      (fun f => ‖T_h f‖ ^ 2) := funext h_eq
  rw [h_fun_eq]
  exact (continuous_pow 2).comp (continuous_norm.comp h_lip.continuous)

theorem kdv_well_posed_H_minus_one
    (h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → IsSchwartzSolution v → u 0 = v 0 → u = v) :
    ∃ Φ : ℝ × Hm1 → Hm1,
      Continuous Φ ∧ ExtendsSchwartzFlow Φ ∧
      (∀ Ψ : ℝ × Hm1 → Hm1, Continuous Ψ → ExtendsSchwartzFlow Ψ → Ψ = Φ) ∧
      (∀ q : Hm1, Bornology.IsBounded (Set.range fun t : ℝ => Φ (t, q))) ∧
      (∀ q : Hm1, EquicontinuousHm1 (Set.range fun t : ℝ => Φ (t, q))) :=
by
  obtain ⟨Φ, hΦ_cont, hΦ_ext⟩ :=
    schwartz_flow_continuous_extension h_exists denseRange_iota
      schwartz_solution_continuous_hm1
      (schwartz_flow_uniform_cauchy_on_compact h_exists h_unique)
  refine ⟨Φ, hΦ_cont, hΦ_ext, ?_, ?_, ?_⟩
  · intro Ψ hΨ_cont hΨ_ext
    have h_prod_dense : DenseRange (Prod.map (id : ℝ → ℝ) ι) :=
      DenseRange.prodMap denseRange_id denseRange_iota
    apply DenseRange.equalizer h_prod_dense hΨ_cont hΦ_cont
    funext ⟨t, q₀⟩
    obtain ⟨u, hu_sol, hu0⟩ := h_exists q₀
    simp only [Function.comp_apply, Prod.map_apply, id_eq]
    rw [← hu0, hΨ_ext u hu_sol t, hΦ_ext u hu_sol t]
  · intro q
    obtain ⟨η, hη, M, hM⟩ := schwartz_orbit_bounded h_exists h_unique q
    rw [isBounded_iff_forall_norm_le]
    refine ⟨M + 1, ?_⟩
    rintro _ ⟨t, rfl⟩
    have h_cont_p : Continuous (fun p : Hm1 => Φ (t, p)) :=
      hΦ_cont.comp (continuous_const.prodMk continuous_id)
    obtain ⟨η₁, hη₁, h_close⟩ :=
      Metric.continuousAt_iff.mp h_cont_p.continuousAt 1 one_pos
    obtain ⟨q₀, hq₀⟩ := DenseRange.exists_dist_lt denseRange_iota q (lt_min hη hη₁)
    rw [dist_comm, dist_eq_norm] at hq₀
    obtain ⟨u, hu_sol, hu0⟩ := h_exists q₀
    have hu_bound : ‖ι (u t)‖ ≤ M := by
      apply hM u hu_sol
      rw [hu0]
      exact (lt_min_iff.mp hq₀).1
    have h_phi_close : ‖Φ (t, ι q₀) - Φ (t, q)‖ < 1 := by
      rw [← dist_eq_norm]
      apply h_close
      rw [dist_eq_norm]
      exact (lt_min_iff.mp hq₀).2
    have h_phi_eq : Φ (t, ι q₀) = ι (u t) := by
      rw [← hu0]
      exact hΦ_ext u hu_sol t
    rw [h_phi_eq] at h_phi_close
    have h_tri : ‖Φ (t, q)‖ ≤ ‖ι (u t)‖ + ‖Φ (t, q) - ι (u t)‖ :=
      norm_le_norm_add_norm_sub' (Φ (t, q)) (ι (u t))
    rw [norm_sub_rev] at h_tri
    linarith
  · intro q ε hε
    obtain ⟨η, hη, δ, hδ, h_equi⟩ := schwartz_orbit_equicontinuous h_exists h_unique q ε hε
    refine ⟨δ, hδ, ?_⟩
    rintro _ ⟨t, rfl⟩ h hh
    have h_cont_td : Continuous (fun r : Hm1 => translateDiffSq (r : Lp ℂ 2 (volume : Measure ℝ)) h) :=
      (continuous_translateDiffSq h).comp continuous_subtype_val
    have h_cont_p : Continuous (fun r : Hm1 => translateDiffSq (Φ (t, r) : Lp ℂ 2 (volume : Measure ℝ)) h) :=
      h_cont_td.comp (hΦ_cont.comp (continuous_const.prodMk continuous_id))
    obtain ⟨η₁, hη₁, h_close⟩ :=
      Metric.continuousAt_iff.mp h_cont_p.continuousAt (ε / 2) (half_pos hε)
    obtain ⟨q₀, hq₀⟩ := DenseRange.exists_dist_lt denseRange_iota q (lt_min hη hη₁)
    rw [dist_comm, dist_eq_norm] at hq₀
    obtain ⟨u, hu_sol, hu0⟩ := h_exists q₀
    have hu_equi : translateDiffSq (ι (u t) : Lp ℂ 2 (volume : Measure ℝ)) h < ε / 2 := by
      apply h_equi u hu_sol _ t h hh
      rw [hu0]
      exact (lt_min_iff.mp hq₀).1
    have h_td_close :
        dist (translateDiffSq (Φ (t, ι q₀) : Lp ℂ 2 (volume : Measure ℝ)) h)
             (translateDiffSq (Φ (t, q) : Lp ℂ 2 (volume : Measure ℝ)) h) < ε / 2 := by
      apply h_close
      rw [dist_eq_norm]
      exact (lt_min_iff.mp hq₀).2
    have h_phi_eq : Φ (t, ι q₀) = ι (u t) := by
      rw [← hu0]
      exact hΦ_ext u hu_sol t
    rw [h_phi_eq, Real.dist_eq] at h_td_close
    linarith [abs_lt.mp h_td_close]
