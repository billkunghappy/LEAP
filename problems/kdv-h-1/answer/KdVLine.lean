          (hgR_deriv y).continuousAt.continuousWithinAt
          (fun z _ => hgR_deriv z)
          ((hgR_int f' y).sub ((hgR_int f y).const_mul 2))
          hgR_atTop
      rw [MeasureTheory.integral_sub (hgR_int f' y) ((hgR_int f y).const_mul 2),
          MeasureTheory.integral_const_mul, zero_sub] at h_int_R
      have h_L_id : (∫ z in Set.Iic y, gL f' z) = gL f y - 2 * IL y := by
        dsimp [IL]
        linarith
      have h_R_id : (∫ z in Set.Ioi y, gR f' z) = 2 * IR y - gR f y := by
        dsimp [IR]
        linarith
      have h_e1 : Real.exp (-2 * y) * Real.exp (2 * y) = 1 := by
        rw [← Real.exp_add]
        have : -2 * y + 2 * y = 0 := by ring
        rw [this, Real.exp_zero]
      have h_e2 : Real.exp (2 * y) * Real.exp (-2 * y) = 1 := by
        rw [mul_comm, h_e1]
      rw [h_exp_split f' y, h_L_id, h_R_id]
      dsimp [J, gL, gR]
      calc -(1 / 2) * Real.exp (-2 * y) * IL y + 1 / 2 * Real.exp (2 * y) * IR y
        _ = 1 / 4 * (Real.exp (-2 * y) * (f y * Real.exp (2 * y) - 2 * IL y) +
              Real.exp (2 * y) * (2 * IR y - f y * Real.exp (-2 * y))) -
            1 / 4 * f y * (Real.exp (-2 * y) * Real.exp (2 * y)) +
            1 / 4 * f y * (Real.exp (2 * y) * Real.exp (-2 * y)) := by ring
        _ = 1 / 4 * (Real.exp (-2 * y) * (f y * Real.exp (2 * y) - 2 * IL y) +
              Real.exp (2 * y) * (2 * IR y - f y * Real.exp (-2 * y))) := by
            rw [h_e1, h_e2]
            ring
    have hJ_deriv : ∀ y : ℝ,
        HasDerivAt J ((∫ z : ℝ, Real.exp (-2 * |y - z|) * f z) - f y) y := by
      intro y
      have hd_IL : HasDerivAt IL (gL f y) y := (h_ftc (gL f) y (hgL_cont f)).1 (hgL_int f)
      have hd_IR : HasDerivAt IR (-gR f y) y := (h_ftc (gR f) y (hgR_cont f)).2 (hgR_int f)
      have hd_expL : HasDerivAt (fun x : ℝ => -(1 / 2) * Real.exp (-2 * x))
          (-(1 / 2) * (Real.exp (-2 * y) * (-2))) y := by
        have hd1 : HasDerivAt (fun x : ℝ => -2 * x) (-2) y := by
          simpa using (hasDerivAt_id y).const_mul (-2)
        exact (Real.hasDerivAt_exp (-2 * y) |>.comp y hd1).const_mul (-(1 / 2))
      have hd_expR : HasDerivAt (fun x : ℝ => (1 / 2) * Real.exp (2 * x))
          ((1 / 2) * (Real.exp (2 * y) * 2)) y := by
        have hd1 : HasDerivAt (fun x : ℝ => 2 * x) 2 y := by
          simpa using (hasDerivAt_id y).const_mul 2
        exact (Real.hasDerivAt_exp (2 * y) |>.comp y hd1).const_mul (1 / 2)
      have hd_comb := (hd_expL.mul hd_IL).add (hd_expR.mul hd_IR)
      convert hd_comb using 1
      rw [h_exp_split f y]
      dsimp [IL, IR, gL, gR]
      have h_e1 : Real.exp (-2 * y) * Real.exp (2 * y) = 1 := by
        rw [← Real.exp_add]
        have : -2 * y + 2 * y = 0 := by ring
        rw [this, Real.exp_zero]
      have h_e2 : Real.exp (2 * y) * Real.exp (-2 * y) = 1 := by
        rw [mul_comm, h_e1]
      calc Real.exp (-2 * y) * (∫ z in Set.Iic y, f z * Real.exp (2 * z)) +
            Real.exp (2 * y) * (∫ z in Set.Ioi y, f z * Real.exp (-2 * z)) - f y
        _ = Real.exp (-2 * y) * (∫ z in Set.Iic y, f z * Real.exp (2 * z)) +
            Real.exp (2 * y) * (∫ z in Set.Ioi y, f z * Real.exp (-2 * z)) -
            (1 / 2) * f y * (Real.exp (-2 * y) * Real.exp (2 * y)) -
            (1 / 2) * f y * (Real.exp (2 * y) * Real.exp (-2 * y)) := by
          rw [h_e1, h_e2]
          ring
