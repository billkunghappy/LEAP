    have h_lhs : iterWavePacket κ w (ℓ + 1) x ξ =
        -((1 / (2 * π) : ℂ) * ∫ z : ℝ, ∫ η : ℝ, J z η) := by
      dsimp [iterWavePacket]
      congr 1
      have h_z : ∀ z : ℝ,
          Complex.exp (-((ξ : ℂ) * (z : ℂ)) * I) * ((greenIterKernel κ w ℓ x z * w z : ℝ) : ℂ) =
            (1 / (2 * π) : ℂ) * ∫ η : ℝ, J z η := by
        intro z
        rw [Complex.ofReal_mul, h_iter_eq ℓ z,
            show Complex.exp (-((ξ : ℂ) * (z : ℂ)) * I) *
              (((1 / (2 * π) : ℂ) * ∫ η : ℝ, iterWavePacket κ w ℓ x η * Complex.exp (((η : ℂ) * (z : ℂ)) * I) / ((κ ^ 2 + η ^ 2 : ℝ) : ℂ)) * (w z : ℂ)) =
