        exact h_c1.mul (h_c2.mul h_c3)
      refine (hg1_int.mul_prod hg2_int).mono' hG_cont.aestronglyMeasurable
        (Filter.Eventually.of_forall fun p => ?_)
      dsimp only [Function.uncurry, G, g1, g2]
      rw [norm_mul, norm_div, norm_mul,
          show ((p.2 : ℂ) * (p.1 : ℂ)) * I = (((p.2 * p.1 : ℝ) : ℂ) * I) by push_cast; ring,
          Complex.norm_exp_ofReal_mul_I, one_mul,
          Complex.norm_of_nonneg (le_of_lt (h_denom_pos p.2)),
          Complex.norm_real, Real.norm_eq_abs, abs_mul, ← Real.norm_eq_abs (w p.1)]
      have h1 : ‖iterWavePacket κ w ℓ x p.2‖ / (κ ^ 2 + p.2 ^ 2) ≤ M_ℓ * (1 / (κ ^ 2 + p.2 ^ 2)) := by
        rw [div_eq_mul_one_div]
        exact mul_le_mul_of_nonneg_right (hM_ℓ p.2) (by positivity)
      have h2 : ‖w p.1‖ * |freeGreenKernel κ p.1 x| ≤ (1 / (2 * κ)) * ‖w p.1‖ := by
        rw [mul_comm (1 / (2 * κ)) ‖w p.1‖]
        exact mul_le_mul_of_nonneg_left (h_fg_bound p.1) (norm_nonneg _)
      calc (‖iterWavePacket κ w ℓ x p.2‖ / (κ ^ 2 + p.2 ^ 2)) * (‖w p.1‖ * |freeGreenKernel κ p.1 x|)
        _ = (‖w p.1‖ * |freeGreenKernel κ p.1 x|) * (‖iterWavePacket κ w ℓ x p.2‖ / (κ ^ 2 + p.2 ^ 2)) := by ring
        _ ≤ ((1 / (2 * κ)) * ‖w p.1‖) * (M_ℓ * (1 / (κ ^ 2 + p.2 ^ 2))) :=
