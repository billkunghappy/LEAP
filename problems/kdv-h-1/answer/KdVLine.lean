      have h2 : R ^ k * ε' = ε / 2 := by
        dsimp [ε']
        have : R ^ k ≠ 0 := ne_of_gt (by positivity)
        field_simp
      linarith
    have h_term2 : (1 / R) * SchwartzMap.seminorm ℝ (k + 1) n g ≤ ε / 2 := by
      have h1 : (1 / R) * SchwartzMap.seminorm ℝ (k + 1) n g ≤ (1 / R) * B' (k + 1) n :=
        mul_le_mul_of_nonneg_left hg_k1n (by positivity)
      have h2 : (1 / R) * B' (k + 1) n ≤ ε / 2 := by
        rw [one_div_mul_eq_div, div_le_div_iff₀ hR_pos (by positivity)]
        have h3 := (div_le_iff₀ hε).mp hR_ge_div
        linarith
      exact le_trans h1 h2
