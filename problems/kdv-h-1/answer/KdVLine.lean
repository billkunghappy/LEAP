    apply MeasureTheory.integral_Iic_of_hasDerivAt_of_tendsto
    · exact (hF_L_deriv x Set.self_mem_Iic).continuousAt.continuousWithinAt
    · exact fun y hy => hF_L_deriv y (Set.Iio_subset_Iic_self hy)
    · exact h_int_f.integrableOn
    · exact hF_L_tend
  have h_int_R : ∫ y in Set.Ioi x, f y = 0 - F_R x := by
    apply MeasureTheory.integral_Ioi_of_hasDerivAt_of_tendsto
    · exact (hF_R_deriv x Set.self_mem_Ici).continuousAt.continuousWithinAt
    · exact fun y hy => hF_R_deriv y (Set.Ioi_subset_Ici_self hy)
    · exact h_int_f.integrableOn
    · exact hF_R_tend
  have h_split : (∫ y : ℝ, f y) = (∫ y in Set.Iic x, f y) + (∫ y in Set.Ioi x, f y) := by
    rw [← Set.compl_Iic]
    exact (MeasureTheory.integral_add_compl measurableSet_Iic h_int_f).symm
  change (∫ y : ℝ, f y) =
    2 * deriv w x * diagGreen 1 w x - 2 * (w x - 2) * deriv (diagGreen 1 w) x
  rw [h_split, h_int_L, h_int_R]
  dsimp [F_L, F_R, K]
  have h_gx_L : greenKernelLeft 1 w x x = diagGreen 1 w x := (h_eq_LR x x).1 le_rfl
  have h_gx_R : greenKernelRight 1 w x x = diagGreen 1 w x := (h_eq_LR x x).2 le_rfl
  have h_dgx_L : greenDerivLeft 1 w x x = (diagGreenDeriv 1 w x + 1) / 2 := (h_jump_LR x).1
  have h_dgx_R : greenDerivRight 1 w x x = (diagGreenDeriv 1 w x - 1) / 2 := (h_jump_LR x).2
  have h_w1_x : w1 x = deriv w x := hD_apply w x
  have h_dgd_eq : diagGreenDeriv 1 w x = deriv (diagGreen 1 w) x := ((h_diag x).2).deriv.symm
  rw [h_gx_L, h_gx_R, h_dgx_L, h_dgx_R, h_w1_x, h_dgd_eq]
  ring

theorem regFlowRHS_greenKernel_and_recipGreenFlux_deriv : ∃ δ₃ : ℝ, 0 < δ₃ ∧
      ∀ κ : ℝ, 2 ≤ κ →
        ∀ w : 𝓢(ℝ, ℝ), ‖ι w‖ ≤ δ₃ →
        ∀ x : ℝ,
          ((-1 / (2 * (diagGreen 1 w x) ^ 2)) *
            ((2 * deriv w x * diagGreen 1 w x - 2 * (w x - 2) * deriv (diagGreen 1 w) x) -
              ∫ y : ℝ, greenKernel 1 w x y * regFlowRHS κ w y * greenKernel 1 w y x) =
            -deriv (recipGreenFlux κ w) x) ∧
          Integrable (fun y => greenKernel 1 w x y * kdvRHS w y * greenKernel 1 w y x) ∧
          Integrable (fun y => greenKernel 1 w x y * regFlowRHS κ w y * greenKernel 1 w y x) :=
by
  have h_ode_ring : ∀ (κ w0y w1y k0y k1y k2y Gy DGy : ℝ),
      (-(2 * w1y * (1 / (2 * κ) + k0y) + 4 * w0y * k1y + 4 * κ ^ 2 * k1y) +
          (2 * w1y * (1 / (2 * κ) + k0y) + 2 * (1 + w0y) * k1y)) * Gy ^ 2 +
        (-k2y + 2 * (1 + w0y) * (1 / (2 * κ) + k0y)) * (2 * Gy ^ 1 * DGy) +
        (((2 * k2y) * Gy + 2 * k1y * DGy) * DGy +
          2 * k1y * Gy * ((1 ^ 2 + w0y) * Gy)) -
        ((2 * k1y) * DGy ^ 2 +
          2 * (1 / (2 * κ) + k0y) * (2 * DGy ^ 1 * ((1 ^ 2 + w0y) * Gy))) =
      -4 * (κ ^ 2 - 1) * k1y * Gy ^ 2 := by
    intros
    ring
  have h_R_ring : ∀ (κ w1y k1y Gy : ℝ), κ ^ 2 - 1 ≠ 0 →
      -(4 * κ ^ 5 / (κ ^ 2 - 1)) * (-4 * (κ ^ 2 - 1) * k1y * Gy ^ 2) +
        4 * κ ^ 2 * (w1y * Gy ^ 2) =
      Gy * (16 * κ ^ 5 * k1y + 4 * κ ^ 2 * w1y) * Gy := by
    intro κ w1y k1y Gy hκ2_ne
    field_simp
    ring
  have h_jump_ring : ∀ (κ w0x m0x m1x k0x k1x k2x : ℝ),
      ((-(4 * κ ^ 5 / (κ ^ 2 - 1)) *
          ((-k2x + 2 * (1 + w0x) * (1 / (2 * κ) + k0x)) * (1 / 2 + m0x) ^ 2 +
            2 * k1x * (1 / 2 + m0x) * ((m1x + 1) / 2) -
            2 * (1 / (2 * κ) + k0x) * ((m1x + 1) / 2) ^ 2) +
        4 * κ ^ 2 * ((1 + w0x) * (1 / 2 + m0x) ^ 2 - ((m1x + 1) / 2) ^ 2)) - 0) +
      (0 - (-(4 * κ ^ 5 / (κ ^ 2 - 1)) *
          ((-k2x + 2 * (1 + w0x) * (1 / (2 * κ) + k0x)) * (1 / 2 + m0x) ^ 2 +
            2 * k1x * (1 / 2 + m0x) * ((m1x - 1) / 2) -
            2 * (1 / (2 * κ) + k0x) * ((m1x - 1) / 2) ^ 2) +
        4 * κ ^ 2 * ((1 + w0x) * (1 / 2 + m0x) ^ 2 - ((m1x - 1) / 2) ^ 2))) =
      -(8 * κ ^ 5 / (κ ^ 2 - 1)) * (k1x * (1 / 2 + m0x) - (1 / (2 * κ) + k0x) * m1x) -
        4 * κ ^ 2 * m1x := by
    intros
    ring
  have h_final_alg : ∀ (κ w0x w1x m0x m1x k0x k1x : ℝ),
      κ ≠ 0 → κ ^ 2 - 1 ≠ 0 → 1 / 2 + m0x ≠ 0 →
      (-1 / (2 * (1 / 2 + m0x) ^ 2)) *
        ((2 * w1x * (1 / 2 + m0x) - 2 * (w0x - 2) * m1x) -
          (-(8 * κ ^ 5 / (κ ^ 2 - 1)) * (k1x * (1 / 2 + m0x) - (1 / (2 * κ) + k0x) * m1x) -
            4 * κ ^ 2 * m1x)) =
      -((-m1x / (1 / 2 + m0x) ^ 2) *
          (w0x + (4 * κ ^ 5 / (κ ^ 2 - 1)) * k0x - (4 / (κ ^ 2 - 1)) * m0x) +
        (1 / 2 + m0x)⁻¹ *
          (w1x + (4 * κ ^ 5 / (κ ^ 2 - 1)) * k1x - (4 / (κ ^ 2 - 1)) * m1x)) := by
    intro κ w0x w1x m0x m1x k0x k1x hκ_ne hκ2_ne hg1_ne
    field_simp
    ring
  obtain ⟨δ_reg, hδ_reg, h_reg⟩ := diagGreen_sub_const_mem_schwartz
  obtain ⟨δ_ode, hδ_ode, h_ode⟩ := diagGreen_third_order_ode
  set δ₃ := min (min δ_reg δ_ode) (1 / 4 : ℝ)
  have hδ₃ : 0 < δ₃ := by positivity
  refine ⟨δ₃, hδ₃, ?_⟩
  intro κ hκ w hw x
  have h1_le : (1 : ℝ) ≤ 1 := le_rfl
  have hκ1 : 1 ≤ κ := by linarith
  have hκ_pos : 0 < κ := by linarith
  have hκ_ne : κ ≠ 0 := ne_of_gt hκ_pos
  have hκ2_ne : κ ^ 2 - 1 ≠ 0 := by nlinarith
  have hw_reg : ‖ι w‖ ≤ δ_reg := le_trans hw (le_trans (min_le_left _ _) (min_le_left _ _))
  have hw_ode : ‖ι w‖ ≤ δ_ode := le_trans hw (le_trans (min_le_left _ _) (min_le_right _ _))
  have hw_quarter : ‖ι w‖ ≤ 1 / 4 := le_trans hw (min_le_right _ _)
  obtain ⟨g_tilde_1, hg1_eq⟩ := h_reg 1 h1_le w hw_reg
  obtain ⟨g_tilde_κ, hgκ_eq⟩ := h_reg κ hκ1 w hw_reg
  have h_diag_d := greenIterKernel_diag_hasDerivAt 1 h1_le w
  obtain ⟨h_symm, h_off_d1, h_off_d2, h_off_bd⟩ :=
    greenIterKernel_offDiag_hasDerivAt_and_symm 1 h1_le w
  obtain ⟨h_G_symm, h_diag, h_eq_LR, h_jump_LR, h_d1_LR, h_d2_LR⟩ :=
    greenKernel_halfLine_ode_and_jump 1 h1_le w hw_quarter h_diag_d h_symm h_off_d1 h_off_d2 h_off_bd
  obtain ⟨h_tend_L, h_tend_R, _, _⟩ :=
    greenKernel_halfLine_tendsto_and_integrable 1 h1_le w hw_quarter
  let D : 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ) := fun f => SchwartzMap.derivCLM ℝ ℝ f
  have hD_apply : ∀ (f : 𝓢(ℝ, ℝ)) (y : ℝ), D f y = deriv f y :=
    fun f y => SchwartzMap.derivCLM_apply ℝ f y
  have hD2_apply : ∀ (f : 𝓢(ℝ, ℝ)) (y : ℝ), D (D f) y = iteratedDeriv 2 f y := by
    intro f y
    rw [hD_apply]
    have h : (D f : ℝ → ℝ) = iteratedDeriv 1 f := by
      ext z
      rw [hD_apply, iteratedDeriv_one]
    rw [h, ← iteratedDeriv_succ]
  have hD3_apply : ∀ (f : 𝓢(ℝ, ℝ)) (y : ℝ), D (D (D f)) y = iteratedDeriv 3 f y := by
    intro f y
    rw [hD_apply]
    have h : (D (D f) : ℝ → ℝ) = iteratedDeriv 2 f := funext (hD2_apply f)
    rw [h, ← iteratedDeriv_succ]
  have h_hasDerivAt : ∀ (f : 𝓢(ℝ, ℝ)) (y : ℝ), HasDerivAt f (D f y) y := by
    intro f y
    rw [hD_apply]
    exact (f.smooth'.contDiffAt.differentiableAt (by norm_num)).hasDerivAt
  have h_mul_int : ∀ (f g : 𝓢(ℝ, ℝ)), Integrable (fun y => f y * g y) volume := by
    intro f g
    have hg : Integrable g volume := g.integrable
    have hf_cont : Continuous f := f.continuous
