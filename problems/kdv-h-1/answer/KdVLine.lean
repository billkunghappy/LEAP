        h_cont3.aestronglyMeasurable.integral_prod_right'
      let C_w : ℝ := ∫ z : ℝ, ‖w z‖
      have h_dom : Integrable (fun p : ℝ × ℝ => (6 * (1 + p.1 ^ 2)⁻¹) * (‖w p.2‖ * C_w)) (volume.prod volume) :=
        (integrable_inv_one_add_sq.const_mul 6).mul_prod (hw_int.norm.mul_const C_w)
      refine h_dom.mono' h_meas ?_
      filter_upwards with p
      dsimp [Function.uncurry, C_w]
      calc ‖∫ z : ℝ, H p.1 p.2 z‖
        _ ≤ ∫ z : ℝ, ‖H p.1 p.2 z‖ := norm_integral_le_integral_norm _
        _ ≤ ∫ z : ℝ, (6 * (1 + p.1 ^ 2)⁻¹) * (‖w p.2‖ * ‖w z‖) := by
            refine integral_mono (h_int_z_for p.1 p.2).norm
              ((hw_int.norm.const_mul ‖w p.2‖).const_mul (6 * (1 + p.1 ^ 2)⁻¹)) ?_
            intro z
            exact h_H_bound p.1 p.2 z
        _ = (6 * (1 + p.1 ^ 2)⁻¹) * (‖w p.2‖ * ∫ z : ℝ, ‖w z‖) := by
            rw [integral_const_mul, integral_const_mul]
    have h_lhs_eq :
        (∫ ξ : ℝ, M ξ * ‖fourierLine w ξ‖ ^ 2) =
        ∫ y : ℝ, ∫ z : ℝ, ((|y - z| + 1 / κ) * Real.exp (-2 * κ * |y - z|)) * w y * w z := by
      have h_swap_all :
          (∫ ξ : ℝ, M ξ * ‖fourierLine w ξ‖ ^ 2) =
          (2 * Real.pi)⁻¹ * ∫ y : ℝ, ∫ z : ℝ, ∫ ξ : ℝ, H ξ y z := by
        have h1 : (fun ξ : ℝ => M ξ * ‖fourierLine w ξ‖ ^ 2) =
            (fun ξ : ℝ => (2 * Real.pi)⁻¹ * ∫ y : ℝ, ∫ z : ℝ, H ξ y z) :=
          funext h_fl_sq
        rw [h1, integral_const_mul, integral_integral_swap h_int_ξy]
        congr 1
        congr 1 with y
        exact integral_integral_swap (h_int_ξz y)
      rw [h_swap_all]
      have h_inner_eval : ∀ y z : ℝ,
          ∫ ξ : ℝ, H ξ y z = (2 * Real.pi) * (((|y - z| + 1 / κ) * Real.exp (-2 * κ * |y - z|)) * w y * w z) := by
        intro y z
        dsimp [H, M]
        rw [integral_mul_const, (s3 (y - z)).2]
        ring
      have h_double_eq :
          (∫ y : ℝ, ∫ z : ℝ, ∫ ξ : ℝ, H ξ y z) =
          (2 * Real.pi) * ∫ y : ℝ, ∫ z : ℝ, ((|y - z| + 1 / κ) * Real.exp (-2 * κ * |y - z|)) * w y * w z := by
        have h2 : (fun y : ℝ => ∫ z : ℝ, ∫ ξ : ℝ, H ξ y z) =
            (fun y : ℝ => (2 * Real.pi) * ∫ z : ℝ, ((|y - z| + 1 / κ) * Real.exp (-2 * κ * |y - z|)) * w y * w z) := by
          ext y
          rw [← integral_const_mul]
          congr 1 with z
          exact h_inner_eval y z
        rw [h2, integral_const_mul]
      rw [h_double_eq]
      have h_2pi_ne : 2 * Real.pi ≠ 0 := by positivity
      exact inv_mul_cancel_left₀ h_2pi_ne _
    have h_int_M_fl : Integrable (fun ξ : ℝ => M ξ * ‖fourierLine w ξ‖ ^ 2) volume := by
      have h1 : (fun ξ : ℝ => M ξ * ‖fourierLine w ξ‖ ^ 2) =
          (fun ξ : ℝ => (2 * Real.pi)⁻¹ * ∫ y : ℝ, ∫ z : ℝ, H ξ y z) :=
        funext h_fl_sq
      rw [h1]
      exact h_int_ξy.integral_prod_left.const_mul (2 * Real.pi)⁻¹
    have h_int_rhs_fl : Integrable (fun ξ : ℝ => ‖fourierLine w ξ‖ ^ 2 / (4 * κ ^ 2 + ξ ^ 2)) volume := by
      have h_cont_den : Continuous (fun ξ : ℝ => (4 * κ ^ 2 + ξ ^ 2)⁻¹) :=
        Continuous.inv₀ (by fun_prop) (fun ξ => by positivity)
      have h_meas_rhs : AEStronglyMeasurable (fun ξ : ℝ => ‖fourierLine w ξ‖ ^ 2 / (4 * κ ^ 2 + ξ ^ 2)) volume :=
        (h_meas_fl.norm.pow 2).mul h_cont_den.aestronglyMeasurable
      refine (integrable_inv_one_add_sq.const_mul (C_fl ^ 2)).mono' h_meas_rhs ?_
      filter_upwards with ξ
      rw [Real.norm_of_nonneg (by positivity), div_eq_mul_inv]
      have h_sq_le : ‖fourierLine w ξ‖ ^ 2 ≤ C_fl ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) (h_fl_bound ξ) 2
      have h_inv_le : (4 * κ ^ 2 + ξ ^ 2)⁻¹ ≤ (1 + ξ ^ 2)⁻¹ :=
        inv_anti₀ (by positivity) (by nlinarith)
      exact mul_le_mul h_sq_le h_inv_le (by positivity) (by positivity)
    have h_mono : (∫ ξ : ℝ, M ξ * ‖fourierLine w ξ‖ ^ 2) ≤
        ∫ ξ : ℝ, 8 * (‖fourierLine w ξ‖ ^ 2 / (4 * κ ^ 2 + ξ ^ 2)) := by
      refine integral_mono h_int_M_fl (h_int_rhs_fl.const_mul 8) ?_
      intro ξ
      calc M ξ * ‖fourierLine w ξ‖ ^ 2
        _ ≤ (8 / (4 * κ ^ 2 + ξ ^ 2)) * ‖fourierLine w ξ‖ ^ 2 :=
            mul_le_mul_of_nonneg_right (hM_le_eight ξ) (sq_nonneg _)
        _ = 8 * (‖fourierLine w ξ‖ ^ 2 / (4 * κ ^ 2 + ξ ^ 2)) := by ring
    rw [← h_lhs_eq]
    calc (1 / (8 * κ ^ 3)) * ∫ ξ : ℝ, M ξ * ‖fourierLine w ξ‖ ^ 2
      _ ≤ (1 / (8 * κ ^ 3)) * ∫ ξ : ℝ, 8 * (‖fourierLine w ξ‖ ^ 2 / (4 * κ ^ 2 + ξ ^ 2)) :=
          mul_le_mul_of_nonneg_left h_mono (by positivity)
      _ = (1 / (8 * κ ^ 3)) * (8 * ∫ ξ : ℝ, ‖fourierLine w ξ‖ ^ 2 / (4 * κ ^ 2 + ξ ^ 2)) := by
          rw [integral_const_mul]
      _ = (1 / κ ^ 3) * ∫ ξ : ℝ, ‖fourierLine w ξ‖ ^ 2 / (4 * κ ^ 2 + ξ ^ 2) := by
          field_simp
  have s5 : hm1KappaSq κ (ι w) = ∫ ξ : ℝ, ‖fourierLine w ξ‖ ^ 2 / (4 * κ ^ 2 + ξ ^ 2) := by
    have h_mem : MemLp (hm1Profile w) 2 (volume : Measure ℝ) := by
      have h_cont_w : Continuous (fun ξ : ℝ => ((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ)) :=
        Continuous.inv₀ (by fun_prop) (fun ξ => Complex.ofReal_ne_zero.mpr (by positivity))
      have h_meas : AEStronglyMeasurable (hm1Profile w) volume :=
        h_cont_w.aestronglyMeasurable.mul h_meas_fl
      rw [memLp_two_iff_integrable_sq_norm h_meas]
      refine (integrable_inv_one_add_sq.const_mul (C_fl ^ 2)).mono'
        (h_meas.norm.pow 2) ?_
      filter_upwards with ξ
      have h_w_norm : ‖((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ)‖ = (Real.sqrt (4 + ξ ^ 2))⁻¹ := by
        rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _)]
      have h_sq : ‖hm1Profile w ξ‖ ^ 2 = (4 + ξ ^ 2)⁻¹ * ‖fourierLine w ξ‖ ^ 2 := by
        dsimp [hm1Profile]
        rw [norm_mul, h_w_norm, mul_pow, inv_pow, Real.sq_sqrt (by positivity)]
      rw [Real.norm_of_nonneg (sq_nonneg _), h_sq]
      have h_inv_le : (4 + ξ ^ 2)⁻¹ ≤ (1 + ξ ^ 2)⁻¹ := by
        apply inv_anti₀ (by positivity)
        linarith
      have h_sq_le : ‖fourierLine w ξ‖ ^ 2 ≤ C_fl ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) (h_fl_bound ξ) 2
      calc
        (4 + ξ ^ 2)⁻¹ * ‖fourierLine w ξ‖ ^ 2 ≤ (1 + ξ ^ 2)⁻¹ * C_fl ^ 2 := by gcongr
        _ = C_fl ^ 2 * (1 + ξ ^ 2)⁻¹ := mul_comm _ _
    have h_toHm1 : toHm1 w = h_mem.toLp (hm1Profile w) := by
      dsimp [toHm1]
      rw [dif_pos h_mem]
    dsimp [hm1KappaSq, ι]
    apply integral_congr_ae
    filter_upwards [h_mem.coeFn_toLp] with ξ hξ
    rw [h_toHm1, hξ]
    have h_w_norm : ‖((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ)‖ = (Real.sqrt (4 + ξ ^ 2))⁻¹ := by
      rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    have h_sq : ‖hm1Profile w ξ‖ ^ 2 = (4 + ξ ^ 2)⁻¹ * ‖fourierLine w ξ‖ ^ 2 := by
      dsimp [hm1Profile]
      rw [norm_mul, h_w_norm, mul_pow, inv_pow, Real.sq_sqrt (by positivity)]
    rw [h_sq]
    have : 4 + ξ ^ 2 ≠ 0 := by positivity
    field_simp
  refine ⟨s2.1, ?_⟩
  rw [s2.2, s5]
  exact s4

theorem alphaFunctional_cubic_remainder_bound : ∃ δ_alpha : ℝ, 0 < δ_alpha ∧
      ∀ κ : ℝ, 1 ≤ κ → ∀ w : 𝓢(ℝ, ℝ), ‖ι w‖ ≤ δ_alpha →
        |κ * alphaFunctional κ w - κ * alphaQuadFunctional κ w| ≤
          (1 / 8) * hm1KappaSq κ (ι w) :=
by
  refine ⟨1 / 256, by norm_num, ?_⟩
  intro κ hκ w hw
  have hκ_pos : 0 < κ := by linarith
  have hκ_ne : κ ≠ 0 := ne_of_gt hκ_pos
  have h_fg_cont : Continuous (fun p : ℝ × ℝ => freeGreenKernel κ p.1 p.2) := by
    dsimp [freeGreenKernel]
    fun_prop
  have h_fg_bound : ∀ x y : ℝ, |freeGreenKernel κ x y| ≤ 1 / (2 * κ) := by
    intro x y
    dsimp [freeGreenKernel]
    rw [abs_mul, abs_of_pos (by positivity : 0 < 1 / (2 * κ)), abs_of_pos (Real.exp_pos _)]
    have h_exp_le : Real.exp (-κ * |x - y|) ≤ 1 :=
      Real.exp_le_one_iff.mpr (by nlinarith [abs_nonneg (x - y)])
    exact mul_le_of_le_one_right (by positivity) h_exp_le
  have h_iter_cont_bound : ∀ ℓ : ℕ,
      Continuous (fun p : ℝ × ℝ => greenIterKernel κ w ℓ p.1 p.2) ∧
      ∃ M : ℝ, 0 ≤ M ∧ ∀ x y : ℝ, |greenIterKernel κ w ℓ x y| ≤ M := by
    intro ℓ
    induction ℓ with
    | zero =>
      exact ⟨h_fg_cont, 1 / (2 * κ), by positivity, h_fg_bound⟩
    | succ ℓ ih =>
      obtain ⟨h_cont_ℓ, M, hM_nn, hM_bound⟩ := ih
      let F : ℝ × ℝ → ℝ → ℝ := fun p z => greenIterKernel κ w ℓ p.1 z * w z * freeGreenKernel κ z p.2
      let bound : ℝ → ℝ := fun z => M * (1 / (2 * κ)) * ‖w z‖
      have h_w_int : Integrable (w : ℝ → ℝ) volume := w.integrable
      have h_bound_int : Integrable bound volume :=
        h_w_int.norm.const_mul (M * (1 / (2 * κ)))
      have hF_meas : ∀ p : ℝ × ℝ, AEStronglyMeasurable (F p) volume := by
        intro p
        have h_c1 : Continuous (fun z : ℝ => greenIterKernel κ w ℓ p.1 z) :=
          h_cont_ℓ.comp (continuous_const.prodMk continuous_id)
        have h_c2 : Continuous (fun z : ℝ => freeGreenKernel κ z p.2) :=
          h_fg_cont.comp (continuous_id.prodMk continuous_const)
        exact ((h_c1.mul w.continuous).mul h_c2).aestronglyMeasurable
      have hF_dom : ∀ p : ℝ × ℝ, ∀ᵐ z : ℝ ∂volume, ‖F p z‖ ≤ bound z := by
        intro p
        filter_upwards with z
        dsimp [F, bound]
        rw [abs_mul, abs_mul]
        have h1 := hM_bound p.1 z
        have h2 := h_fg_bound z p.2
        calc |greenIterKernel κ w ℓ p.1 z| * |w z| * |freeGreenKernel κ z p.2|
          _ = (|greenIterKernel κ w ℓ p.1 z| * |freeGreenKernel κ z p.2|) * |w z| := by ring
          _ ≤ (M * (1 / (2 * κ))) * |w z| :=
            mul_le_mul_of_nonneg_right (mul_le_mul h1 h2 (abs_nonneg _) hM_nn) (abs_nonneg _)
      have hF_cont : ∀ᵐ z : ℝ ∂volume, Continuous (fun p : ℝ × ℝ => F p z) := by
        filter_upwards with z
        dsimp [F]
        have h_c1 : Continuous (fun p : ℝ × ℝ => greenIterKernel κ w ℓ p.1 z) :=
          h_cont_ℓ.comp (continuous_fst.prodMk continuous_const)
        have h_c2 : Continuous (fun p : ℝ × ℝ => freeGreenKernel κ z p.2) :=
          h_fg_cont.comp (continuous_const.prodMk continuous_snd)
        exact (h_c1.mul continuous_const).mul h_c2
      have h_int_cont : Continuous (fun p : ℝ × ℝ => ∫ z : ℝ, F p z) :=
        continuous_of_dominated hF_meas hF_dom h_bound_int hF_cont
      refine ⟨h_int_cont.neg, ∫ z : ℝ, bound z, integral_nonneg (fun z => by dsimp [bound]; positivity), ?_⟩
      intro x y
      dsimp [greenIterKernel]
      rw [abs_neg]
      have hF_int : Integrable (F (x, y)) volume :=
        h_bound_int.mono' (hF_meas (x, y)) (hF_dom (x, y))
      calc |∫ z : ℝ, F (x, y) z|
        _ ≤ ∫ z : ℝ, ‖F (x, y) z‖ := by
          simpa [Real.norm_eq_abs] using norm_integral_le_integral_norm (F (x, y))
        _ ≤ ∫ z : ℝ, bound z := integral_mono_ae hF_int.norm h_bound_int (hF_dom (x, y))
  have h_cont : ∀ ℓ : ℕ, Continuous (fun x : ℝ => greenIterKernel κ w ℓ x x) :=
    fun ℓ => (h_iter_cont_bound ℓ).1.comp (continuous_id.prodMk continuous_id)
  have h_hm1_nn : 0 ≤ hm1KappaSq κ (ι w) := by
    dsimp [hm1KappaSq]
    exact integral_nonneg (fun ξ => by positivity)
  have h_hm1_le : hm1KappaSq κ (ι w) ≤ ‖ι w‖ ^ 2 := by
    let f : Lp ℂ 2 (volume : Measure ℝ) := (ι w : Lp ℂ 2 (volume : Measure ℝ))
    have h_base : Integrable (fun ξ : ℝ => ‖(f : ℝ → ℂ) ξ‖ ^ 2) volume :=
      (Lp.memLp f).integrable_norm_pow (by norm_num)
    have h_m_nonneg : ∀ ξ : ℝ, 0 ≤ (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) :=
      fun ξ => div_nonneg (by positivity) (by positivity)
    have h_m_le_one : ∀ ξ : ℝ, (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2) ≤ 1 := by
      intro ξ
      exact div_le_one_of_le₀ (by nlinarith) (by positivity)
    have h_cont_m : Continuous (fun ξ : ℝ => (4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2)) :=
      Continuous.div (continuous_const.add (continuous_pow 2))
        (continuous_const.add (continuous_pow 2)) (fun ξ => ne_of_gt (by positivity))
    have h_int_w : Integrable (fun ξ : ℝ => ((4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2)) * ‖(f : ℝ → ℂ) ξ‖ ^ 2) volume := by
      refine h_base.mono' (h_cont_m.aestronglyMeasurable.mul h_base.aestronglyMeasurable) ?_
      filter_upwards with ξ
      rw [Real.norm_of_nonneg (mul_nonneg (h_m_nonneg ξ) (sq_nonneg _))]
      exact mul_le_of_le_one_left (sq_nonneg _) (h_m_le_one ξ)
    have h_norm_sq : ‖ι w‖ ^ 2 = ∫ ξ : ℝ, ‖(f : ℝ → ℂ) ξ‖ ^ 2 := by
      change ‖f‖ ^ 2 = ∫ ξ : ℝ, ‖(f : ℝ → ℂ) ξ‖ ^ 2
      rw [← real_inner_self_eq_norm_sq f, MeasureTheory.L2.inner_def f f]
      congr 1
      ext ξ
      exact real_inner_self_eq_norm_sq ((f : ℝ → ℂ) ξ)
    rw [h_norm_sq]
    exact integral_mono h_int_w h_base (fun ξ => mul_le_of_le_one_left (sq_nonneg _) (h_m_le_one ξ))
  obtain ⟨h_hs_int, h_hs_eq⟩ := hilbertSchmidt_fourier_integral_eq_hm1KappaSq κ hκ w
  set r := Real.sqrt ((1 / κ) * hm1KappaSq κ (ι w))
  have hr_nn : 0 ≤ r := Real.sqrt_nonneg _
  have hr_sq : r ^ 2 = (1 / κ) * hm1KappaSq κ (ι w) :=
    Real.sq_sqrt (mul_nonneg (by positivity) h_hm1_nn)
  have hr_le_delta : r ≤ 1 / 256 := by
    have h_inv_le : 1 / κ ≤ 1 := div_le_one_of_le₀ hκ (le_of_lt hκ_pos)
    have h_norm_sq_le : ‖ι w‖ ^ 2 ≤ (1 / 256 : ℝ) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) hw 2
    have h_r_sq_le : (1 / κ) * hm1KappaSq κ (ι w) ≤ (1 / 256 : ℝ) ^ 2 := by
      calc (1 / κ) * hm1KappaSq κ (ι w)
        _ ≤ 1 * hm1KappaSq κ (ι w) := mul_le_mul_of_nonneg_right h_inv_le h_hm1_nn
        _ ≤ ‖ι w‖ ^ 2 := by linarith
        _ ≤ (1 / 256 : ℝ) ^ 2 := h_norm_sq_le
    exact (Real.sqrt_le_iff.mpr ⟨by norm_num, h_r_sq_le⟩)
  have hr_quarter : r ≤ 1 / 4 := by linarith
  have hr_half : r ≤ 1 / 2 := by linarith
  have hr_lt1 : r < 1 := by linarith
  have h_geom : Summable (fun n : ℕ => r ^ n) := summable_geometric_of_lt_one hr_nn hr_lt1
  have h_geom_le : (∑' n : ℕ, r ^ n) ≤ 2 := by
    rw [tsum_geometric_of_lt_one hr_nn hr_lt1, inv_le_comm₀ (by linarith) (by norm_num)]
    linarith
  obtain ⟨h_pt, h_h1_sq, h_dom⟩ :=
    greenIterKernel_diag_pointwise_and_domination κ hκ w r hr_nn h_hs_int
      (le_of_eq (h_hs_eq.trans hr_sq.symm))
  obtain ⟨h_h2_int, h_h2_le⟩ := greenIterKernel_two_spatial_integral_le κ hκ w
  have h_h2_nn : ∀ x : ℝ, 0 ≤ greenIterKernel κ w 2 x x := by
    intro x
    have h0 := h_dom 0 x
    rw [pow_zero, one_mul] at h0
    exact le_trans (abs_nonneg _) h0
  have h_g_cont : Continuous (diagGreen κ w) := by
    dsimp [diagGreen, greenKernel]
    refine continuous_tsum h_cont (h_geom.mul_left (1 / (2 * κ))) ?_
    intro n x
    simpa [Real.norm_eq_abs] using h_pt n x
  have h_peel1 : ∀ x : ℝ, diagGreen κ w x - 1 / (2 * κ) = ∑' m : ℕ, greenIterKernel κ w (m + 1) x x := by
    intro x
    let f : ℕ → ℝ := fun ℓ => greenIterKernel κ w ℓ x x
    have hf0 : f 0 = 1 / (2 * κ) := by
      dsimp [f, greenIterKernel, freeGreenKernel]
      rw [sub_self, abs_zero, mul_zero, Real.exp_zero, mul_one]
    have h_sum0 : Summable f :=
      Summable.of_norm_bounded (h_geom.mul_left (1 / (2 * κ))) (fun ℓ => by simpa [f, Real.norm_eq_abs] using h_pt ℓ x)
    have h_eq0 : diagGreen κ w x = f 0 + ∑' m, f (m + 1) := h_sum0.tsum_eq_zero_add
    linarith
  have h_peel2 : ∀ x : ℝ, diagGreen κ w x - 1 / (2 * κ) - greenIterKernel κ w 1 x x =
      ∑' m : ℕ, greenIterKernel κ w (m + 2) x x := by
    intro x
    let f : ℕ → ℝ := fun ℓ => greenIterKernel κ w ℓ x x
    have h_sum0 : Summable f :=
      Summable.of_norm_bounded (h_geom.mul_left (1 / (2 * κ))) (fun ℓ => by simpa [f, Real.norm_eq_abs] using h_pt ℓ x)
    have h_sum1 : Summable (fun m => f (m + 1)) := (summable_nat_add_iff 1).mpr h_sum0
    have h_eq1 : (∑' m, f (m + 1)) = f 1 + ∑' m, f (m + 2) := h_sum1.tsum_eq_zero_add
    linarith [h_peel1 x]
  have h_peel3 : ∀ x : ℝ, diagGreen κ w x - 1 / (2 * κ) - greenIterKernel κ w 1 x x - greenIterKernel κ w 2 x x =
      ∑' m : ℕ, greenIterKernel κ w (m + 3) x x := by
    intro x
    let f : ℕ → ℝ := fun ℓ => greenIterKernel κ w ℓ x x
    have h_sum0 : Summable f :=
      Summable.of_norm_bounded (h_geom.mul_left (1 / (2 * κ))) (fun ℓ => by simpa [f, Real.norm_eq_abs] using h_pt ℓ x)
    have h_sum2 : Summable (fun m => f (m + 2)) := (summable_nat_add_iff 2).mpr h_sum0
    have h_eq2 : (∑' m, f (m + 2)) = f 2 + ∑' m, f (m + 3) := h_sum2.tsum_eq_zero_add
    linarith [h_peel2 x]
  have h_g_pt : ∀ x : ℝ, |diagGreen κ w x - 1 / (2 * κ)| ≤ (1 / κ) * r := by
    intro x
    rw [h_peel1 x]
    have h_dom_s : Summable (fun m : ℕ => ((1 / (2 * κ)) * r) * r ^ m) := h_geom.mul_left ((1 / (2 * κ)) * r)
    have h_le : ∀ m : ℕ, ‖greenIterKernel κ w (m + 1) x x‖ ≤ ((1 / (2 * κ)) * r) * r ^ m := by
      intro m
      rw [Real.norm_eq_abs, show ((1 / (2 * κ)) * r) * r ^ m = (1 / (2 * κ)) * r ^ (m + 1) by ring]
      exact h_pt (m + 1) x
    have h_sum_norm : Summable (fun m : ℕ => ‖greenIterKernel κ w (m + 1) x x‖) :=
      Summable.of_nonneg_of_le (fun _ => norm_nonneg _) h_le h_dom_s
    calc |∑' m : ℕ, greenIterKernel κ w (m + 1) x x|
      _ ≤ ∑' m : ℕ, ‖greenIterKernel κ w (m + 1) x x‖ := by
        simpa [Real.norm_eq_abs] using norm_tsum_le_tsum_norm h_sum_norm
      _ ≤ ∑' m : ℕ, (((1 / (2 * κ)) * r) * r ^ m) := Summable.tsum_le_tsum h_le h_sum_norm h_dom_s
      _ = ((1 / (2 * κ)) * r) * ∑' m : ℕ, r ^ m := tsum_mul_left
      _ ≤ ((1 / (2 * κ)) * r) * 2 := mul_le_mul_of_nonneg_left h_geom_le (by positivity)
      _ = (1 / κ) * r := by ring
  have h_r2_r : ∀ x : ℝ, |diagGreen κ w x - 1 / (2 * κ) - greenIterKernel κ w 1 x x| ≤ (1 / κ) * r ^ 2 := by
    intro x
    rw [h_peel2 x]
    have h_dom_s : Summable (fun m : ℕ => ((1 / (2 * κ)) * r ^ 2) * r ^ m) := h_geom.mul_left ((1 / (2 * κ)) * r ^ 2)
    have h_le : ∀ m : ℕ, ‖greenIterKernel κ w (m + 2) x x‖ ≤ ((1 / (2 * κ)) * r ^ 2) * r ^ m := by
      intro m
      rw [Real.norm_eq_abs, show ((1 / (2 * κ)) * r ^ 2) * r ^ m = (1 / (2 * κ)) * r ^ (m + 2) by ring]
      exact h_pt (m + 2) x
    have h_sum_norm : Summable (fun m : ℕ => ‖greenIterKernel κ w (m + 2) x x‖) :=
      Summable.of_nonneg_of_le (fun _ => norm_nonneg _) h_le h_dom_s
    calc |∑' m : ℕ, greenIterKernel κ w (m + 2) x x|
      _ ≤ ∑' m : ℕ, ‖greenIterKernel κ w (m + 2) x x‖ := by
        simpa [Real.norm_eq_abs] using norm_tsum_le_tsum_norm h_sum_norm
      _ ≤ ∑' m : ℕ, (((1 / (2 * κ)) * r ^ 2) * r ^ m) := Summable.tsum_le_tsum h_le h_sum_norm h_dom_s
      _ = ((1 / (2 * κ)) * r ^ 2) * ∑' m : ℕ, r ^ m := tsum_mul_left
      _ ≤ ((1 / (2 * κ)) * r ^ 2) * 2 := mul_le_mul_of_nonneg_left h_geom_le (by positivity)
      _ = (1 / κ) * r ^ 2 := by ring
  have h_r2_h2 : ∀ x : ℝ, |diagGreen κ w x - 1 / (2 * κ) - greenIterKernel κ w 1 x x| ≤ 2 * greenIterKernel κ w 2 x x := by
    intro x
    rw [h_peel2 x]
    have h2_x := h_h2_nn x
    have h_dom_s : Summable (fun m : ℕ => greenIterKernel κ w 2 x x * r ^ m) := h_geom.mul_left (greenIterKernel κ w 2 x x)
    have h_le : ∀ m : ℕ, ‖greenIterKernel κ w (m + 2) x x‖ ≤ greenIterKernel κ w 2 x x * r ^ m := by
      intro m
      rw [Real.norm_eq_abs, mul_comm (greenIterKernel κ w 2 x x) (r ^ m)]
      exact h_dom m x
    have h_sum_norm : Summable (fun m : ℕ => ‖greenIterKernel κ w (m + 2) x x‖) :=
      Summable.of_nonneg_of_le (fun _ => norm_nonneg _) h_le h_dom_s
    calc |∑' m : ℕ, greenIterKernel κ w (m + 2) x x|
      _ ≤ ∑' m : ℕ, ‖greenIterKernel κ w (m + 2) x x‖ := by
        simpa [Real.norm_eq_abs] using norm_tsum_le_tsum_norm h_sum_norm
      _ ≤ ∑' m : ℕ, (greenIterKernel κ w 2 x x * r ^ m) := Summable.tsum_le_tsum h_le h_sum_norm h_dom_s
      _ = greenIterKernel κ w 2 x x * ∑' m : ℕ, r ^ m := tsum_mul_left
      _ ≤ greenIterKernel κ w 2 x x * 2 := mul_le_mul_of_nonneg_left h_geom_le h2_x
      _ = 2 * greenIterKernel κ w 2 x x := by ring
  have h_r3_h2 : ∀ x : ℝ, |diagGreen κ w x - 1 / (2 * κ) - greenIterKernel κ w 1 x x - greenIterKernel κ w 2 x x| ≤
      2 * r * greenIterKernel κ w 2 x x := by
    intro x
    rw [h_peel3 x]
    have h2_x := h_h2_nn x
    have h_dom_s : Summable (fun m : ℕ => (r * greenIterKernel κ w 2 x x) * r ^ m) :=
      h_geom.mul_left (r * greenIterKernel κ w 2 x x)
    have h_le : ∀ m : ℕ, ‖greenIterKernel κ w (m + 3) x x‖ ≤ (r * greenIterKernel κ w 2 x x) * r ^ m := by
      intro m
      rw [Real.norm_eq_abs, show (r * greenIterKernel κ w 2 x x) * r ^ m = r ^ (m + 1) * greenIterKernel κ w 2 x x by ring]
      exact h_dom (m + 1) x
    have h_sum_norm : Summable (fun m : ℕ => ‖greenIterKernel κ w (m + 3) x x‖) :=
      Summable.of_nonneg_of_le (fun _ => norm_nonneg _) h_le h_dom_s
    calc |∑' m : ℕ, greenIterKernel κ w (m + 3) x x|
      _ ≤ ∑' m : ℕ, ‖greenIterKernel κ w (m + 3) x x‖ := by
        simpa [Real.norm_eq_abs] using norm_tsum_le_tsum_norm h_sum_norm
      _ ≤ ∑' m : ℕ, ((r * greenIterKernel κ w 2 x x) * r ^ m) := Summable.tsum_le_tsum h_le h_sum_norm h_dom_s
      _ = (r * greenIterKernel κ w 2 x x) * ∑' m : ℕ, r ^ m := tsum_mul_left
      _ ≤ (r * greenIterKernel κ w 2 x x) * 2 := mul_le_mul_of_nonneg_left h_geom_le (mul_nonneg hr_nn h2_x)
      _ = 2 * r * greenIterKernel κ w 2 x x := by ring
  let g : ℝ → ℝ := fun x => diagGreen κ w x
  let h₁ : ℝ → ℝ := fun x => greenIterKernel κ w 1 x x
  let h₂ : ℝ → ℝ := fun x => greenIterKernel κ w 2 x x
  let gtilde : ℝ → ℝ := fun x => diagGreen κ w x - 1 / (2 * κ)
  let r₂ : ℝ → ℝ := fun x => diagGreen κ w x - 1 / (2 * κ) - greenIterKernel κ w 1 x x
  let r₃ : ℝ → ℝ := fun x => diagGreen κ w x - 1 / (2 * κ) - greenIterKernel κ w 1 x x - greenIterKernel κ w 2 x x
  let Q₂ : ℝ → ℝ := fun x => alphaQuadDensity κ w x
  have h_rho_eq : ∀ x : ℝ, rhoDensity κ w x = κ - 1 / (2 * g x) - 2 * κ ^ 2 * h₁ x := by
    intro x
    have h_ker_eq : (fun y : ℝ => freeGreenKernel κ x y * w y * freeGreenKernel κ y x) =
        (fun y : ℝ => (1 / (4 * κ ^ 2)) * (Real.exp (-2 * κ * |x - y|) * w y)) := by
      ext y
      dsimp [freeGreenKernel]
      rw [abs_sub_comm y x]
      have h_exp : Real.exp (-κ * |x - y|) * Real.exp (-κ * |x - y|) = Real.exp (-2 * κ * |x - y|) := by
        rw [← Real.exp_add]
        ring_nf
      calc 1 / (2 * κ) * Real.exp (-κ * |x - y|) * w y * (1 / (2 * κ) * Real.exp (-κ * |x - y|))
        _ = (1 / (4 * κ ^ 2)) * (Real.exp (-κ * |x - y|) * Real.exp (-κ * |x - y|)) * w y := by ring
        _ = (1 / (4 * κ ^ 2)) * (Real.exp (-2 * κ * |x - y|) * w y) := by rw [h_exp]; ring
    have h_h1_eq : h₁ x = -(1 / (4 * κ ^ 2)) * ∫ y : ℝ, Real.exp (-2 * κ * |x - y|) * w y := by
      dsimp [h₁, greenIterKernel]
      rw [h_ker_eq, integral_const_mul]
      ring
    have h_int_eq : (1 / 2) * (∫ y : ℝ, Real.exp (-2 * κ * |x - y|) * w y) = -2 * κ ^ 2 * h₁ x := by
      rw [h_h1_eq]
      field_simp
      ring
    dsimp [rhoDensity, g]
    linarith [h_int_eq]
  have hg_ge : ∀ x : ℝ, 1 / (4 * κ) ≤ g x := by
    intro x
    have h_abs := (abs_le.mp (h_g_pt x)).1
    change -((1 / κ) * r) ≤ g x - 1 / (2 * κ) at h_abs
    have h_r_div : (1 / κ) * r ≤ 1 / (4 * κ) := by
      calc (1 / κ) * r
        _ ≤ (1 / κ) * (1 / 4) := mul_le_mul_of_nonneg_left hr_quarter (by positivity)
        _ = 1 / (4 * κ) := by ring
    have h_frac : 1 / (2 * κ) - 1 / (4 * κ) = 1 / (4 * κ) := by ring
    linarith
  have hg_pos : ∀ x : ℝ, 0 < g x := by
    intro x
    exact lt_of_lt_of_le (by positivity) (hg_ge x)
  have h_alg : ∀ x : ℝ, rhoDensity κ w x - Q₂ x =
      2 * κ ^ 2 * r₃ x + (4 * κ ^ 3 * h₁ x ^ 2 * gtilde x - 4 * κ ^ 2 * h₁ x * r₂ x - 2 * κ ^ 2 * r₂ x ^ 2) * (g x)⁻¹ := by
    intro x
    have hg_ne : diagGreen κ w x ≠ 0 := ne_of_gt (hg_pos x)
    rw [h_rho_eq x]
    dsimp [Q₂, alphaQuadDensity, r₃, r₂, gtilde, g, h₁, h₂]
    field_simp
    ring
  have h_pt_dom : ∀ x : ℝ, |rhoDensity κ w x - Q₂ x| ≤ (32 * κ ^ 2 * r) * h₂ x := by
    intro x
    rw [h_alg x]
    have h2_x := h_h2_nn x
    have hgx_pos := hg_pos x
    have hgx_ge := hg_ge x
    have hg_inv_le : (g x)⁻¹ ≤ 4 * κ := by
      rw [inv_le_comm₀ hgx_pos (by positivity)]
      simpa [one_div, mul_inv_rev] using hgx_ge
    have hg_inv_abs : |(g x)⁻¹| = (g x)⁻¹ := abs_of_pos (inv_pos.mpr hgx_pos)
    have h_t0 : |2 * κ ^ 2 * r₃ x| ≤ 4 * κ ^ 2 * r * h₂ x := by
      rw [abs_mul, abs_of_pos (by positivity : 0 < 2 * κ ^ 2)]
      have := mul_le_mul_of_nonneg_left (h_r3_h2 x) (by positivity : 0 ≤ 2 * κ ^ 2)
      linarith
    have h_t1 : |4 * κ ^ 3 * h₁ x ^ 2 * gtilde x| ≤ 2 * κ * r * h₂ x := by
      rw [abs_mul, abs_of_nonneg (by positivity : 0 ≤ 4 * κ ^ 3 * h₁ x ^ 2)]
      have h_step1 : 4 * κ ^ 3 * h₁ x ^ 2 * |gtilde x| ≤ 4 * κ ^ 3 * ((1 / (2 * κ)) * h₂ x) * ((1 / κ) * r) :=
        mul_le_mul (mul_le_mul_of_nonneg_left (h_h1_sq x) (by positivity)) (h_g_pt x) (abs_nonneg _) (by positivity)
      have h_eq : 4 * κ ^ 3 * ((1 / (2 * κ)) * h₂ x) * ((1 / κ) * r) = 2 * κ * r * h₂ x := by
        field_simp
        ring
      linarith
    have h_t2 : |4 * κ ^ 2 * h₁ x * r₂ x| ≤ 4 * κ * r * h₂ x := by
      rw [abs_mul, abs_mul, abs_of_pos (by positivity : 0 < 4 * κ ^ 2)]
      have h_h1_x : |h₁ x| ≤ (1 / (2 * κ)) * r := by
        simpa [h₁] using h_pt 1 x
      have h_step1 : |h₁ x| * |r₂ x| ≤ ((1 / (2 * κ)) * r) * (2 * h₂ x) :=
        mul_le_mul h_h1_x (h_r2_h2 x) (abs_nonneg _) (by positivity)
      have h_step2 := mul_le_mul_of_nonneg_left h_step1 (by positivity : 0 ≤ 4 * κ ^ 2)
      have h_eq : 4 * κ ^ 2 * (((1 / (2 * κ)) * r) * (2 * h₂ x)) = 4 * κ * r * h₂ x := by
        field_simp
      linarith
    have h_t3 : |2 * κ ^ 2 * r₂ x ^ 2| ≤ κ * r * h₂ x := by
      rw [show 2 * κ ^ 2 * r₂ x ^ 2 = (2 * κ ^ 2) * (r₂ x * r₂ x) by ring,
          abs_mul, abs_of_pos (by positivity : 0 < 2 * κ ^ 2), abs_mul]
      have h_step1 : |r₂ x| * |r₂ x| ≤ ((1 / κ) * r ^ 2) * (2 * h₂ x) :=
        mul_le_mul (h_r2_r x) (h_r2_h2 x) (abs_nonneg _) (by positivity)
      have h_step2 := mul_le_mul_of_nonneg_left h_step1 (by positivity : 0 ≤ 2 * κ ^ 2)
      have h_eq : 2 * κ ^ 2 * (((1 / κ) * r ^ 2) * (2 * h₂ x)) = 4 * r * (κ * r * h₂ x) := by
        field_simp
        ring
      have h_step3 : 4 * r * (κ * r * h₂ x) ≤ 4 * (1 / 4) * (κ * r * h₂ x) :=
        mul_le_mul_of_nonneg_right (by linarith) (by positivity)
      linarith
    have h_num : |4 * κ ^ 3 * h₁ x ^ 2 * gtilde x - 4 * κ ^ 2 * h₁ x * r₂ x - 2 * κ ^ 2 * r₂ x ^ 2| ≤
        7 * κ * r * h₂ x := by
      have h_tri1 := abs_sub (4 * κ ^ 3 * h₁ x ^ 2 * gtilde x - 4 * κ ^ 2 * h₁ x * r₂ x) (2 * κ ^ 2 * r₂ x ^ 2)
      have h_tri2 := abs_sub (4 * κ ^ 3 * h₁ x ^ 2 * gtilde x) (4 * κ ^ 2 * h₁ x * r₂ x)
      linarith
    have h_frac : |(4 * κ ^ 3 * h₁ x ^ 2 * gtilde x - 4 * κ ^ 2 * h₁ x * r₂ x - 2 * κ ^ 2 * r₂ x ^ 2) * (g x)⁻¹| ≤
        28 * κ ^ 2 * r * h₂ x := by
      rw [abs_mul, hg_inv_abs]
      calc |4 * κ ^ 3 * h₁ x ^ 2 * gtilde x - 4 * κ ^ 2 * h₁ x * r₂ x - 2 * κ ^ 2 * r₂ x ^ 2| * (g x)⁻¹
        _ ≤ (7 * κ * r * h₂ x) * (4 * κ) :=
          mul_le_mul h_num hg_inv_le (inv_nonneg.mpr (le_of_lt hgx_pos)) (by positivity)
        _ = 28 * κ ^ 2 * r * h₂ x := by ring
    have h_tri_main := abs_add_le (2 * κ ^ 2 * r₃ x)
      ((4 * κ ^ 3 * h₁ x ^ 2 * gtilde x - 4 * κ ^ 2 * h₁ x * r₂ x - 2 * κ ^ 2 * r₂ x ^ 2) * (g x)⁻¹)
    linarith
  have hQ2_cont : Continuous Q₂ := by
    dsimp [Q₂, alphaQuadDensity]
    exact (continuous_const.mul (h_cont 2)).sub (continuous_const.mul ((h_cont 1).pow 2))
  have hQ2_int : Integrable Q₂ := by
    refine (h_h2_int.const_mul (4 * κ ^ 2)).mono' hQ2_cont.aestronglyMeasurable (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs]
    dsimp [Q₂, alphaQuadDensity, h₂]
    have h2_x := h_h2_nn x
    have h_tri := abs_sub (2 * κ ^ 2 * greenIterKernel κ w 2 x x) (4 * κ ^ 3 * (greenIterKernel κ w 1 x x) ^ 2)
    rw [abs_of_nonneg (by positivity : 0 ≤ 2 * κ ^ 2 * greenIterKernel κ w 2 x x),
        abs_of_nonneg (by positivity : 0 ≤ 4 * κ ^ 3 * (greenIterKernel κ w 1 x x) ^ 2)] at h_tri
    have h_sq_le := mul_le_mul_of_nonneg_left (h_h1_sq x) (by positivity : 0 ≤ 4 * κ ^ 3)
    have h_eq : 4 * κ ^ 3 * (1 / (2 * κ) * greenIterKernel κ w 2 x x) = 2 * κ ^ 2 * greenIterKernel κ w 2 x x := by
      field_simp
      ring
    linarith
  have h_rho_cont : Continuous (rhoDensity κ w) := by
    rw [funext h_rho_eq]
    have h_2g_cont : Continuous (fun x => 2 * g x) := continuous_const.mul h_g_cont
    have h_div_cont : Continuous (fun x => 1 / (2 * g x)) :=
      continuous_const.div h_2g_cont (fun x => ne_of_gt (by positivity [hg_pos x]))
    exact (continuous_const.sub h_div_cont).sub (continuous_const.mul (h_cont 1))
  have h_diff_int : Integrable (fun x : ℝ => rhoDensity κ w x - Q₂ x) := by
    refine (h_h2_int.const_mul (32 * κ ^ 2 * r)).mono'
      (h_rho_cont.sub hQ2_cont).aestronglyMeasurable (Filter.Eventually.of_forall fun x => ?_)
    simpa [Real.norm_eq_abs] using h_pt_dom x
  have h_rho_int : Integrable (rhoDensity κ w) := by
    have : rhoDensity κ w = fun x => (rhoDensity κ w x - Q₂ x) + Q₂ x := by ext x; ring
    rw [this]
    exact h_diff_int.add hQ2_int
  have h_int_diff : |alphaFunctional κ w - alphaQuadFunctional κ w| ≤
      (32 * κ ^ 2 * r) * ((1 / κ ^ 3) * hm1KappaSq κ (ι w)) := by
    calc |alphaFunctional κ w - alphaQuadFunctional κ w|
      _ = |∫ x : ℝ, (rhoDensity κ w x - Q₂ x)| := by
        dsimp [alphaFunctional, alphaQuadFunctional, Q₂]
        rw [← integral_sub h_rho_int hQ2_int]
      _ ≤ ∫ x : ℝ, |rhoDensity κ w x - Q₂ x| := by
        simpa [Real.norm_eq_abs] using norm_integral_le_integral_norm (fun x => rhoDensity κ w x - Q₂ x)
      _ ≤ ∫ x : ℝ, (32 * κ ^ 2 * r) * h₂ x :=
        integral_mono h_diff_int.abs (h_h2_int.const_mul (32 * κ ^ 2 * r)) h_pt_dom
      _ = (32 * κ ^ 2 * r) * ∫ x : ℝ, h₂ x := integral_const_mul _ _
      _ ≤ (32 * κ ^ 2 * r) * ((1 / κ ^ 3) * hm1KappaSq κ (ι w)) :=
        mul_le_mul_of_nonneg_left h_h2_le (by positivity)
  have h_scaled : |κ * alphaFunctional κ w - κ * alphaQuadFunctional κ w| ≤
      32 * r * hm1KappaSq κ (ι w) := by
    rw [← mul_sub, abs_mul, abs_of_pos hκ_pos]
    calc κ * |alphaFunctional κ w - alphaQuadFunctional κ w|
      _ ≤ κ * ((32 * κ ^ 2 * r) * ((1 / κ ^ 3) * hm1KappaSq κ (ι w))) :=
        mul_le_mul_of_nonneg_left h_int_diff (le_of_lt hκ_pos)
      _ = 32 * r * hm1KappaSq κ (ι w) := by
        field_simp
  calc |κ * alphaFunctional κ w - κ * alphaQuadFunctional κ w|
    _ ≤ 32 * r * hm1KappaSq κ (ι w) := h_scaled
    _ ≤ 32 * (1 / 256) * hm1KappaSq κ (ι w) :=
      mul_le_mul_of_nonneg_right (by linarith) h_hm1_nn
    _ = (1 / 8) * hm1KappaSq κ (ι w) := by ring

theorem greenIterKernel_one_first_h1_isometry : ∀ w₁ w₂ : 𝓢(ℝ, ℝ),
    Continuous (fun x : ℝ => greenIterKernel 1 w₁ 1 x x) ∧
    Integrable (fun x : ℝ => greenIterKernel 1 w₁ 1 x x) ∧
    Integrable (fun ξ : ℝ => (4 + ξ ^ 2) * ‖fourierLine (fun x => greenIterKernel 1 w₁ 1 x x) ξ‖ ^ 2) ∧
    h1NormSq (fun x : ℝ => greenIterKernel 1 w₁ 1 x x) = ‖ι w₁‖ ^ 2 ∧
    Continuous (fun x : ℝ => greenIterKernel 1 w₁ 1 x x - greenIterKernel 1 w₂ 1 x x) ∧
    Integrable (fun x : ℝ => greenIterKernel 1 w₁ 1 x x - greenIterKernel 1 w₂ 1 x x) ∧
    Integrable (fun ξ : ℝ => (4 + ξ ^ 2) * ‖fourierLine (fun x => greenIterKernel 1 w₁ 1 x x - greenIterKernel 1 w₂ 1 x x) ξ‖ ^ 2) ∧
    h1NormSq (fun x : ℝ => greenIterKernel 1 w₁ 1 x x - greenIterKernel 1 w₂ 1 x x) = ‖ι w₁ - ι w₂‖ ^ 2 :=
by
  have h_exp_le_one : ∀ u : ℝ, Real.exp (-2 * |u|) ≤ 1 := by
    intro u
    rw [Real.exp_le_one_iff]
    linarith [abs_nonneg u]
  have h_exp_abs_int : Integrable (fun u : ℝ => Real.exp (-2 * |u|)) volume := by
    have h_Ici : IntegrableOn (fun u : ℝ => Real.exp (-2 * |u|)) (Set.Ici 0) volume := by
      have h_ioi := (exp_neg_integrableOn_Ioi (-1 : ℝ) (by norm_num : (0 : ℝ) < 2)).mono_set
        (Set.Ici_subset_Ioi.mpr (by norm_num : (-1 : ℝ) < 0))
      refine h_ioi.congr_fun ?_ measurableSet_Ici
      intro u hu
      dsimp
      have hu_nn : 0 ≤ u := hu
      rw [abs_of_nonneg hu_nn]
    have h_Iic : IntegrableOn (fun u : ℝ => Real.exp (-2 * |u|)) (Set.Iic 0) volume := by
      have h_neg := h_Ici.comp_neg
      rw [Set.neg_Ici, neg_zero] at h_neg
      refine h_neg.congr_fun ?_ measurableSet_Iic
      intro u _
      dsimp
      rw [abs_neg]
    rw [← integrableOn_univ, ← Set.Iic_union_Ioi (a := (0 : ℝ))]
    exact h_Iic.union (h_Ici.mono_set Set.Ioi_subset_Ici_self)
  have laplace_cos_integral_Ioi : ∀ (b : ℝ),
      ∫ v in Set.Ioi 0, Real.exp (-2 * v) * Real.cos (b * v) = 2 / (4 + b ^ 2) := by
    intro b
    have h_den : 0 < 4 + b ^ 2 := by positivity
    let F : ℝ → ℝ := fun v =>
      Real.exp (-2 * v) * (-2 * Real.cos (b * v) + b * Real.sin (b * v)) / (4 + b ^ 2)
    have hF_cont : ContinuousWithinAt F (Set.Ici 0) 0 := by
      dsimp [F]
      fun_prop
    have hF_deriv : ∀ v ∈ Set.Ioi (0 : ℝ), HasDerivAt F (Real.exp (-2 * v) * Real.cos (b * v)) v := by
      intro v _
      dsimp [F]
      have hd_exp : HasDerivAt (fun x : ℝ => Real.exp (-2 * x)) (Real.exp (-2 * v) * (-2)) v := by
        have h1 : HasDerivAt (fun x : ℝ => -2 * x) (-2) v := by
          simpa using (hasDerivAt_id v).const_mul (-2)
        exact h1.exp
      have hd_lin : HasDerivAt (fun x : ℝ => b * x) b v := by
        simpa using (hasDerivAt_id v).const_mul b
      have hd_cos : HasDerivAt (fun x : ℝ => Real.cos (b * x)) (-Real.sin (b * v) * b) v := hd_lin.cos
      have hd_sin : HasDerivAt (fun x : ℝ => Real.sin (b * x)) (Real.cos (b * v) * b) v := hd_lin.sin
      have hd_trig : HasDerivAt (fun x : ℝ => -2 * Real.cos (b * x) + b * Real.sin (b * x))
          (-2 * (-Real.sin (b * v) * b) + b * (Real.cos (b * v) * b)) v :=
        (hd_cos.const_mul (-2)).add (hd_sin.const_mul b)
      have hd_prod := (hd_exp.mul hd_trig).div_const (4 + b ^ 2)
      convert hd_prod using 1
      field_simp
      ring
    have hf_int : IntegrableOn (fun v : ℝ => Real.exp (-2 * v) * Real.cos (b * v)) (Set.Ioi 0) volume := by
      have h_cont : Continuous (fun v : ℝ => Real.exp (-2 * v) * Real.cos (b * v)) := by fun_prop
      refine (exp_neg_integrableOn_Ioi 0 (by norm_num : (0 : ℝ) < 2)).mono' h_cont.aestronglyMeasurable.restrict ?_
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with v _
      rw [norm_mul, Real.norm_of_nonneg (Real.exp_pos _).le, Real.norm_eq_abs]
      calc Real.exp (-2 * v) * |Real.cos (b * v)|
        _ ≤ Real.exp (-2 * v) * 1 :=
