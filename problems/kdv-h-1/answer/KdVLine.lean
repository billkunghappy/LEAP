        h_dom_int.mono' (hF_meas x) (Filter.Eventually.of_forall hF_pw)
      have h_int_le : |∫ y : ℝ, F x y| ≤ C_x * π := by
        calc |∫ y : ℝ, F x y|
          _ ≤ ∫ y : ℝ, ‖F x y‖ := by simpa [Real.norm_eq_abs] using norm_integral_le_integral_norm (F x)
          _ ≤ ∫ y : ℝ, C_x * (1 + y ^ 2)⁻¹ := integral_mono hFx_int.norm h_dom_int hF_pw
          _ = C_x * ∫ y : ℝ, (1 + y ^ 2)⁻¹ := integral_const_mul C_x _
          _ = C_x * π := by rw [integral_univ_inv_one_add_sq]
      calc |(1 / 2) * ∫ y : ℝ, F x y|
        _ = (1 / 2) * |∫ y : ℝ, F x y| := by rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
        _ ≤ (1 / 2) * (C_x * π) := mul_le_mul_of_nonneg_left h_int_le (by norm_num)
        _ = (4 * π * M) * (1 + x ^ 2)⁻¹ := by dsimp [C_x]; ring
    obtain ⟨hw_conv_cont, hw_conv_bound⟩ := h_exp_conv w hw_decay
    obtain ⟨hv_conv_cont, hv_conv_bound⟩ := h_exp_conv v hv_decay
    have hg_pos : ∀ x : ℝ, 0 < diagGreen κ w x :=
      fun x => lt_of_lt_of_le (by positivity) (hg_ge x)
    have h2g_ne : ∀ x : ℝ, 2 * diagGreen κ w x ≠ 0 :=
      fun x => ne_of_gt (mul_pos two_pos (hg_pos x))
    have h2gsq_ne : ∀ x : ℝ, 2 * (diagGreen κ w x) ^ 2 ≠ 0 :=
      fun x => ne_of_gt (mul_pos two_pos (sq_pos_of_pos (hg_pos x)))
    have h_rho_cont : Continuous (rhoDensity κ w) := by
      change Continuous (fun x : ℝ =>
        (κ - 1 / (2 * diagGreen κ w x)) + (1 / 2) * ∫ y : ℝ, Real.exp (-2 * κ * |x - y|) * w y)
      refine (continuous_const.sub ?_).add hw_conv_cont
      exact continuous_const.div (continuous_const.mul hg_cont) h2g_ne
    have h_rho_bound : ∀ x : ℝ, |rhoDensity κ w x| ≤ (20 * π * M) * (1 + x ^ 2)⁻¹ := by
      intro x
      set g : ℝ := diagGreen κ w x
      have hg_low : 1 / (4 * κ) ≤ g := hg_ge x
      have hg_p : 0 < g := hg_pos x
      have hg_n : g ≠ 0 := ne_of_gt hg_p
      have h_inv_2g : 1 / (2 * g) ≤ 2 * κ := by
        have h1 : 1 / (2 * g) ≤ 1 / (2 * (1 / (4 * κ))) :=
          one_div_le_one_div_of_le (by positivity) (mul_le_mul_of_nonneg_left hg_low zero_le_two)
        have h2 : 1 / (2 * (1 / (4 * κ))) = 2 * κ := by field_simp [hκ_ne]; ring
        linarith
      have h_first : |κ - 1 / (2 * g)| ≤ (16 * π * M) * (1 + x ^ 2)⁻¹ := by
        have h_id : κ - 1 / (2 * g) = (2 * κ) * (g - 1 / (2 * κ)) * (1 / (2 * g)) := by
          field_simp [hκ_ne, hg_n]
        have h_abs : |κ - 1 / (2 * g)| = (2 * κ) * |g - 1 / (2 * κ)| * (1 / (2 * g)) := by
          rw [h_id, abs_mul, abs_mul, abs_of_pos (by positivity : 0 < 2 * κ),
              abs_of_pos (by positivity : 0 < 1 / (2 * g))]
        have h_prod : |g - 1 / (2 * κ)| * (1 / (2 * g)) ≤
            ((4 * π * M / κ ^ 2) * (1 + x ^ 2)⁻¹) * (2 * κ) :=
          mul_le_mul (hg_diff x) h_inv_2g (by positivity) (by positivity)
        calc |κ - 1 / (2 * g)|
          _ = (2 * κ) * (|g - 1 / (2 * κ)| * (1 / (2 * g))) := by rw [h_abs]; ring
          _ ≤ (2 * κ) * (((4 * π * M / κ ^ 2) * (1 + x ^ 2)⁻¹) * (2 * κ)) :=
            mul_le_mul_of_nonneg_left h_prod (by positivity)
          _ = (16 * π * M) * (1 + x ^ 2)⁻¹ := by field_simp [hκ_ne]; ring
      have h_tri : |rhoDensity κ w x| ≤
          |κ - 1 / (2 * g)| + |(1 / 2) * ∫ y : ℝ, Real.exp (-2 * κ * |x - y|) * w y| :=
        abs_add_le _ _
      linarith [hw_conv_bound x]
    let F_G : ℝ → ℝ → ℝ := fun x y => greenKernel κ w x y * v y * greenKernel κ w y x
    let bound_G : ℝ → ℝ := fun y => (1 / κ ^ 2) * ‖v y‖
    have h_boundG_int : Integrable bound_G volume := v.integrable.norm.const_mul _
    have hFG_meas : ∀ x : ℝ, AEStronglyMeasurable (F_G x) volume := by
      intro x
      have h1 : Continuous (fun y : ℝ => greenKernel κ w x y) :=
        hG_cont.comp (continuous_const.prodMk continuous_id)
      have h2 : Continuous (fun y : ℝ => greenKernel κ w y x) :=
        hG_cont.comp (continuous_id.prodMk continuous_const)
      exact ((h1.mul v.continuous).mul h2).aestronglyMeasurable
    have hFG_dom : ∀ x : ℝ, ∀ᵐ y : ℝ ∂volume, ‖F_G x y‖ ≤ bound_G y := by
      intro x
      filter_upwards with y
      dsimp [F_G, bound_G]
      rw [abs_mul, abs_mul]
      have h1 := hG_le x y
      have h2 := hG_le y x
      calc |greenKernel κ w x y| * |v y| * |greenKernel κ w y x|
        _ = (|greenKernel κ w x y| * |greenKernel κ w y x|) * |v y| := by ring
        _ ≤ (1 / κ * (1 / κ)) * |v y| :=
          mul_le_mul_of_nonneg_right (mul_le_mul h1 h2 (abs_nonneg _) (by positivity)) (abs_nonneg _)
        _ = (1 / κ ^ 2) * |v y| := by ring
    have hFG_cont : ∀ᵐ y : ℝ ∂volume, Continuous (fun x : ℝ => F_G x y) := by
      filter_upwards with y
      dsimp [F_G]
      have h1 : Continuous (fun x : ℝ => greenKernel κ w x y) :=
        hG_cont.comp (continuous_id.prodMk continuous_const)
      have h2 : Continuous (fun x : ℝ => greenKernel κ w y x) :=
        hG_cont.comp (continuous_const.prodMk continuous_id)
      exact (h1.mul continuous_const).mul h2
    have hIG_cont : Continuous (fun x : ℝ => ∫ y : ℝ, F_G x y) :=
      continuous_of_dominated hFG_meas hFG_dom h_boundG_int hFG_cont
    have h_deriv_cont : Continuous (rhoDerivDensity κ w v) := by
      change Continuous (fun x : ℝ =>
        -(∫ y : ℝ, F_G x y) / (2 * (diagGreen κ w x) ^ 2) +
          (1 / 2) * ∫ y : ℝ, Real.exp (-2 * κ * |x - y|) * v y)
      refine (hIG_cont.neg.div (continuous_const.mul (hg_cont.pow 2)) h2gsq_ne).add hv_conv_cont
    have h_deriv_bound : ∀ x : ℝ,
        |rhoDerivDensity κ w v x| ≤ (36 * π * M + 32 * π ^ 2 * M ^ 2) * (1 + x ^ 2)⁻¹ := by
      intro x
      set D_x : ℝ := (4 * M / κ ^ 2 + 4 * π * M ^ 2 / κ ^ 3) * (1 + x ^ 2)⁻¹
      have hFG_pw : ∀ y : ℝ, ‖F_G x y‖ ≤ D_x * (1 + y ^ 2)⁻¹ := by
        intro y
        dsimp [F_G]
        rw [abs_mul, abs_mul]
        have h1 := hG_le x y
        have h2 := hv_decay y
        have h3 := hG_peel x y
        have h_prod12 : |greenKernel κ w x y| * |v y| ≤ (1 / κ) * (M * ((1 + y ^ 2)⁻¹) ^ 2) :=
          mul_le_mul h1 h2 (abs_nonneg _) (by positivity)
        have h_inv_sq_le : ((1 + y ^ 2)⁻¹) ^ 2 ≤ (1 + y ^ 2)⁻¹ := by
          have h_le1 : (1 + y ^ 2)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by nlinarith [sq_nonneg y])
          calc ((1 + y ^ 2)⁻¹) ^ 2
            _ = (1 + y ^ 2)⁻¹ * (1 + y ^ 2)⁻¹ := sq _
            _ ≤ 1 * (1 + y ^ 2)⁻¹ := mul_le_mul_of_nonneg_right h_le1 (by positivity)
            _ = (1 + y ^ 2)⁻¹ := one_mul _
        have h_term1 : (M / (2 * κ ^ 2)) * (((1 + y ^ 2)⁻¹) ^ 2 * Real.exp (-κ * |y - x|)) ≤
            (4 * M / κ ^ 2) * (1 + x ^ 2)⁻¹ * (1 + y ^ 2)⁻¹ := by
          calc (M / (2 * κ ^ 2)) * (((1 + y ^ 2)⁻¹) ^ 2 * Real.exp (-κ * |y - x|))
            _ ≤ (M / (2 * κ ^ 2)) * (8 * (1 + x ^ 2)⁻¹ * (1 + y ^ 2)⁻¹) :=
              mul_le_mul_of_nonneg_left (h_peetre x y) (by positivity)
            _ = (4 * M / κ ^ 2) * (1 + x ^ 2)⁻¹ * (1 + y ^ 2)⁻¹ := by ring
        have h_term2 : ((4 * π * M ^ 2 / κ ^ 3) * (1 + x ^ 2)⁻¹) * (((1 + y ^ 2)⁻¹) ^ 2) ≤
            (4 * π * M ^ 2 / κ ^ 3) * (1 + x ^ 2)⁻¹ * (1 + y ^ 2)⁻¹ :=
          mul_le_mul_of_nonneg_left h_inv_sq_le (by positivity)
        calc |greenKernel κ w x y| * |v y| * |greenKernel κ w y x|
          _ ≤ ((1 / κ) * (M * ((1 + y ^ 2)⁻¹) ^ 2)) *
              ((1 / (2 * κ)) * Real.exp (-κ * |y - x|) + (4 * π * M / κ ^ 2) * (1 + x ^ 2)⁻¹) :=
            mul_le_mul h_prod12 h3 (abs_nonneg _) (by positivity)
          _ = (M / (2 * κ ^ 2)) * (((1 + y ^ 2)⁻¹) ^ 2 * Real.exp (-κ * |y - x|)) +
              ((4 * π * M ^ 2 / κ ^ 3) * (1 + x ^ 2)⁻¹) * (((1 + y ^ 2)⁻¹) ^ 2) := by ring
          _ ≤ (4 * M / κ ^ 2) * (1 + x ^ 2)⁻¹ * (1 + y ^ 2)⁻¹ +
              (4 * π * M ^ 2 / κ ^ 3) * (1 + x ^ 2)⁻¹ * (1 + y ^ 2)⁻¹ := add_le_add h_term1 h_term2
          _ = D_x * (1 + y ^ 2)⁻¹ := by dsimp [D_x]; ring
      have h_dom_int : Integrable (fun y : ℝ => D_x * (1 + y ^ 2)⁻¹) volume :=
        integrable_inv_one_add_sq.const_mul D_x
      have hFGx_int : Integrable (F_G x) volume :=
        h_dom_int.mono' (hFG_meas x) (Filter.Eventually.of_forall hFG_pw)
      have hIG_le : |∫ y : ℝ, F_G x y| ≤ D_x * π := by
        calc |∫ y : ℝ, F_G x y|
          _ ≤ ∫ y : ℝ, ‖F_G x y‖ := by simpa [Real.norm_eq_abs] using norm_integral_le_integral_norm (F_G x)
          _ ≤ ∫ y : ℝ, D_x * (1 + y ^ 2)⁻¹ := integral_mono hFGx_int.norm h_dom_int hFG_pw
          _ = D_x * ∫ y : ℝ, (1 + y ^ 2)⁻¹ := integral_const_mul D_x _
          _ = D_x * π := by rw [integral_univ_inv_one_add_sq]
      set g : ℝ := diagGreen κ w x
      have hg_low : 1 / (4 * κ) ≤ g := hg_ge x
      have h_2gsq_low : 1 / (8 * κ ^ 2) ≤ 2 * g ^ 2 := by
        have h_sq : (1 / (4 * κ)) ^ 2 ≤ g ^ 2 :=
          pow_le_pow_left₀ (by positivity) hg_low 2
        have h_id : 2 * (1 / (4 * κ)) ^ 2 = 1 / (8 * κ ^ 2) := by field_simp [hκ_ne]; ring
        linarith
      have h_inv_2gsq : (2 * g ^ 2)⁻¹ ≤ 8 * κ ^ 2 := by
        rw [← one_div]
        have h1 : 1 / (2 * g ^ 2) ≤ 1 / (1 / (8 * κ ^ 2)) :=
          one_div_le_one_div_of_le (by positivity) h_2gsq_low
        have h2 : 1 / (1 / (8 * κ ^ 2)) = 8 * κ ^ 2 := by field_simp [hκ_ne]
        linarith
      have h_inv_κ_le : 1 / κ ≤ 1 := div_le_one_of_le₀ hκ (le_of_lt hκ_pos)
      have h_first : |-(∫ y : ℝ, F_G x y) / (2 * g ^ 2)| ≤
          (32 * π * M + 32 * π ^ 2 * M ^ 2) * (1 + x ^ 2)⁻¹ := by
        rw [abs_div, abs_neg, abs_of_pos (mul_pos two_pos (sq_pos_of_pos (hg_pos x))), div_eq_mul_inv]
        have h_prod : |∫ y : ℝ, F_G x y| * (2 * g ^ 2)⁻¹ ≤ (D_x * π) * (8 * κ ^ 2) :=
          mul_le_mul hIG_le h_inv_2gsq (by positivity) (by positivity)
        have h_alg : (D_x * π) * (8 * κ ^ 2) =
            (32 * π * M + 32 * π ^ 2 * M ^ 2 * (1 / κ)) * (1 + x ^ 2)⁻¹ := by
          dsimp [D_x]; field_simp [hκ_ne]; ring
        have h_le_one : 32 * π ^ 2 * M ^ 2 * (1 / κ) ≤ 32 * π ^ 2 * M ^ 2 :=
          mul_le_of_le_one_right (by positivity) h_inv_κ_le
        have h_coef_le : (32 * π * M + 32 * π ^ 2 * M ^ 2 * (1 / κ)) * (1 + x ^ 2)⁻¹ ≤
            (32 * π * M + 32 * π ^ 2 * M ^ 2) * (1 + x ^ 2)⁻¹ :=
          mul_le_mul_of_nonneg_right (by linarith) (by positivity)
        linarith
      have h_tri : |rhoDerivDensity κ w v x| ≤
          |-(∫ y : ℝ, F_G x y) / (2 * g ^ 2)| +
          |(1 / 2) * ∫ y : ℝ, Real.exp (-2 * κ * |x - y|) * v y| :=
        abs_add_le _ _
      linarith [hv_conv_bound x]
    exact ⟨h_rho_cont, h_rho_bound, h_deriv_cont, h_deriv_bound⟩
  let bound : ℝ → ℝ := fun x => (36 * π * M + 32 * π ^ 2 * M ^ 2) * (1 + x ^ 2)⁻¹
  have h_tau : ∀ τ ∈ V,
      Continuous (fun x : ℝ => rhoDensity κ (u τ) x) ∧
      (∀ x : ℝ, |rhoDensity κ (u τ) x| ≤ (20 * π * M) * (1 + x ^ 2)⁻¹) ∧
      Continuous (fun x : ℝ => rhoDerivDensity κ (u τ) (kdvRHS (u τ)) x) ∧
      (∀ x : ℝ, |rhoDerivDensity κ (u τ) (kdvRHS (u τ)) x| ≤ bound x) := by
    intro τ hτ
    obtain ⟨v_τ, _, hv_τ_eq⟩ := hu τ
    have hv_fun : (v_τ : ℝ → ℝ) = kdvRHS (u τ) := funext hv_τ_eq
    have hv_decay : ∀ y : ℝ, |v_τ y| ≤ M * ((1 + y ^ 2)⁻¹) ^ 2 := by
      intro y
      rw [hv_τ_eq y]
      exact hV_kdv τ hτ y
    have h_pt_τ : ∀ (ℓ : ℕ) (a b : ℝ),
        |greenIterKernel κ (u τ) ℓ a b| ≤ (1 / (2 * κ)) * (1 / 4) ^ ℓ := by
      intro ℓ a b
      calc |greenIterKernel κ (u τ) ℓ a b|
        _ ≤ (1 / (2 * κ)) * ‖ι (u τ)‖ ^ ℓ := greenIterKernel_offDiag_pointwise_bound κ hκ (u τ) ℓ a b
        _ ≤ (1 / (2 * κ)) * (1 / 4) ^ ℓ :=
          mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) (hV_ball τ hτ) ℓ) (by positivity)
    obtain ⟨hG_cont, hg_cont, hG_le, hg_ge, hg_diff, hG_peel⟩ :=
      h_peel_lemma (u τ) h_pt_τ (hV_u τ hτ)
    obtain ⟨h_rho_cont, h_rho_bound, h_deriv_cont, h_deriv_bound⟩ :=
      h_dom_lemma (u τ) v_τ hG_cont hg_cont hG_le hg_ge hg_diff hG_peel (hV_u τ hτ) hv_decay
    rw [hv_fun] at h_deriv_cont h_deriv_bound
    exact ⟨h_rho_cont, h_rho_bound, h_deriv_cont, h_deriv_bound⟩
  obtain ⟨hs_rho_cont, hs_rho_bound, hs_deriv_cont, _⟩ := h_tau s hs_in_V
  refine ⟨V, bound, hV_nhds, ?_, ?_, ?_, ?_, ?_⟩
  · intro τ hτ
    exact (h_tau τ hτ).1.aestronglyMeasurable
  · refine (integrable_inv_one_add_sq.const_mul (20 * π * M)).mono'
      hs_rho_cont.aestronglyMeasurable (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs]
    exact hs_rho_bound x
  · exact hs_deriv_cont.aestronglyMeasurable
  · intro x τ hτ
    rw [Real.norm_eq_abs]
    exact (h_tau τ hτ).2.2.2 x
  · exact integrable_inv_one_add_sq.const_mul (36 * π * M + 32 * π ^ 2 * M ^ 2)

theorem greenIterKernel_diag_hasDerivAt : ∀ (κ : ℝ), 1 ≤ κ → ∀ (w : 𝓢(ℝ, ℝ)) (ℓ : ℕ) (x : ℝ),
      HasDerivAt (fun y => greenIterKernel κ w (ℓ + 1) y y)
        (2 * greenIterDerivY κ w (ℓ + 1) x x) x :=
by
  intro κ hκ w ℓ x
  have hκ_pos : 0 < κ := by linarith
  have hκ_ne : κ ≠ 0 := ne_of_gt hκ_pos
  have h_fg :
      (∀ x y : ℝ, freeGreenKernel κ x y = freeGreenKernel κ y x) ∧
      Continuous (fun p : ℝ × ℝ => freeGreenKernel κ p.1 p.2) ∧
      (∀ z : ℝ, Measurable (fun y : ℝ => freeGreenDerivY κ z y)) ∧
      (∀ x : ℝ, Measurable (fun z : ℝ => freeGreenDerivY κ z x)) ∧
      (∀ z y : ℝ, |freeGreenKernel κ z y| ≤ 1 / (2 * κ)) ∧
      (∀ z y : ℝ, |freeGreenDerivY κ z y| ≤ 1 / 2) ∧
      (∀ z y₁ y₂ : ℝ, |freeGreenKernel κ z y₁ - freeGreenKernel κ z y₂| ≤ (1 / 2) * |y₁ - y₂|) ∧
      (∀ z x : ℝ, z ≠ x → HasDerivAt (fun y => freeGreenKernel κ z y) (freeGreenDerivY κ z x) x) := by
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro x y
      dsimp [freeGreenKernel]
      rw [abs_sub_comm]
    · dsimp [freeGreenKernel]
      fun_prop
    · intro z
      unfold freeGreenDerivY
      refine Measurable.ite (measurableSet_lt measurable_const measurable_id) ?_ ?_
      · exact (by fun_prop : Continuous (fun y : ℝ => -(1 / 2) * Real.exp (-κ * (y - z)))).measurable
      · refine Measurable.ite (measurableSet_lt measurable_id measurable_const) ?_ measurable_const
        exact (by fun_prop : Continuous (fun y : ℝ => (1 / 2) * Real.exp (-κ * (z - y)))).measurable
    · intro x
      unfold freeGreenDerivY
      refine Measurable.ite (measurableSet_lt measurable_id measurable_const) ?_ ?_
      · exact (by fun_prop : Continuous (fun z : ℝ => -(1 / 2) * Real.exp (-κ * (x - z)))).measurable
      · refine Measurable.ite (measurableSet_lt measurable_const measurable_id) ?_ measurable_const
        exact (by fun_prop : Continuous (fun z : ℝ => (1 / 2) * Real.exp (-κ * (z - x)))).measurable
    · intro z y
      dsimp [freeGreenKernel]
      have h_nonpos : -κ * |z - y| ≤ 0 := by
        have : 0 ≤ κ * |z - y| := mul_nonneg (le_of_lt hκ_pos) (abs_nonneg _)
        linarith
      have h_exp_le : Real.exp (-κ * |z - y|) ≤ 1 := Real.exp_le_one_iff.mpr h_nonpos
      have h_pos : 0 ≤ (1 / (2 * κ)) * Real.exp (-κ * |z - y|) := by positivity
      rw [abs_of_nonneg h_pos]
      calc (1 / (2 * κ)) * Real.exp (-κ * |z - y|)
        _ ≤ (1 / (2 * κ)) * 1 := mul_le_mul_of_nonneg_left h_exp_le (by positivity)
        _ = 1 / (2 * κ) := mul_one _
    · intro z y
      dsimp [freeGreenDerivY]
      split_ifs with h1 h2
      · have h_nonpos : -κ * (y - z) ≤ 0 := by nlinarith
        have h_exp_le : Real.exp (-κ * (y - z)) ≤ 1 := Real.exp_le_one_iff.mpr h_nonpos
        rw [abs_mul, abs_neg, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2),
          abs_of_pos (Real.exp_pos _)]
        linarith
      · have h_nonpos : -κ * (z - y) ≤ 0 := by nlinarith
        have h_exp_le : Real.exp (-κ * (z - y)) ≤ 1 := Real.exp_le_one_iff.mpr h_nonpos
        rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2),
          abs_of_pos (Real.exp_pos _)]
        linarith
      · norm_num
    · intro z y₁ y₂
      have h_exp_lip : ∀ u v : ℝ, u ≤ 0 → v ≤ 0 → |Real.exp u - Real.exp v| ≤ |u - v| := by
        intro u v hu hv
        have h_mvt := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
          (f := Real.exp) (f' := Real.exp) (s := Set.Iic (0 : ℝ)) (C := 1)
          (fun t _ => (Real.hasDerivAt_exp t).hasDerivWithinAt)
          (fun t ht => by
            rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos t), Real.exp_le_one_iff]
            exact ht)
          (convex_Iic 0) hv hu
        simpa only [Real.norm_eq_abs, one_mul] using h_mvt
      have hu : -κ * |z - y₁| ≤ 0 := by
        have : 0 ≤ κ * |z - y₁| := mul_nonneg (le_of_lt hκ_pos) (abs_nonneg _)
        linarith
      have hv : -κ * |z - y₂| ≤ 0 := by
        have : 0 ≤ κ * |z - y₂| := mul_nonneg (le_of_lt hκ_pos) (abs_nonneg _)
        linarith
      have h_diff : freeGreenKernel κ z y₁ - freeGreenKernel κ z y₂ =
          (1 / (2 * κ)) * (Real.exp (-κ * |z - y₁|) - Real.exp (-κ * |z - y₂|)) := by
        dsimp [freeGreenKernel]
        ring
      rw [h_diff, abs_mul, abs_of_pos (by positivity : 0 < 1 / (2 * κ))]
      have h1 := h_exp_lip (-κ * |z - y₁|) (-κ * |z - y₂|) hu hv
      have h2 : |(-κ * |z - y₁|) - (-κ * |z - y₂|)| = κ * |(|z - y₁| - |z - y₂|)| := by
        rw [show (-κ * |z - y₁|) - (-κ * |z - y₂|) = -κ * (|z - y₁| - |z - y₂|) by ring,
          abs_mul, abs_neg, abs_of_pos hκ_pos]
      have h3 : |(|z - y₁| - |z - y₂|)| ≤ |y₁ - y₂| := by
        calc |(|z - y₁| - |z - y₂|)|
          _ ≤ |(z - y₁) - (z - y₂)| := abs_abs_sub_abs_le_abs_sub (z - y₁) (z - y₂)
          _ = |y₁ - y₂| := by
            rw [show (z - y₁) - (z - y₂) = -(y₁ - y₂) by ring, abs_neg]
      calc (1 / (2 * κ)) * |Real.exp (-κ * |z - y₁|) - Real.exp (-κ * |z - y₂|)|
