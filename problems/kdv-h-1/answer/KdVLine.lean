        (((h_hasDerivAt k1 x).const_mul (16 * κ ^ 5)).add
          ((h_hasDerivAt q1 x).const_mul (4 * κ ^ 2)))).deriv
    rw [h_deriv_int, h_deriv_kdv, h_reg_iter3, h_deriv_q_reg]
    exact h_comm_ring κ (q0 x) (q1 x) (q2 x) (q4 x) (k1 x) (k2 x) (k4 x)

theorem diagGreen_sub_const_schwartz_seminorm_step : ∃ δ_diag : ℝ, 0 < δ_diag ∧
      ∀ (κ : ℝ), 2 ≤ κ →
        ∀ (k n : ℕ) (R : ℝ), 0 ≤ R →
          ∃ C₁ C₂ : ℝ, 0 ≤ C₁ ∧ 0 ≤ C₂ ∧
            ∀ w : 𝓢(ℝ, ℝ), ‖ι w‖ ≤ δ_diag →
              (∀ p ≤ k, ∀ d < n, SchwartzMap.seminorm ℝ p d w ≤ R) →
              (∀ p < k, SchwartzMap.seminorm ℝ p n w ≤ R) →
              ∃ g_tilde : 𝓢(ℝ, ℝ),
                (∀ x : ℝ, diagGreen κ w x = 1 / (2 * κ) + g_tilde x) ∧
                SchwartzMap.seminorm ℝ k (n + 1) g_tilde ≤ C₁ * SchwartzMap.seminorm ℝ k n w + C₂ :=
by
  let diagGreenBaseConst : ℕ → ℝ := fun k =>
    2 * π * ∑ p ∈ Finset.range (k + 1),
      (Nat.choose k p : ℝ) * ((Nat.factorial (k - p) : ℝ) + (Nat.factorial (k - p + 2) : ℝ))
  have h_s4 : ∀ (f : 𝓢(ℝ, ℝ)) (k : ℕ),
