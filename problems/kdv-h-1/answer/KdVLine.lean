        linarith [hc.2]
      have h_g2_abs : |iteratedDeriv 2 f x| ≤
          |iteratedDeriv 1 f (x + 1)| + |iteratedDeriv 1 f x| + |iteratedDeriv 3 f d| := by
        have h_tri1 : |iteratedDeriv 2 f x| ≤
