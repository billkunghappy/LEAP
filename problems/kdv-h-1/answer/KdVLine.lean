      rw [h_iter_smul, h_iter_sub, h_iter_sub, h_iter_smul, Real.norm_eq_abs, abs_mul, abs_inv]
      have h_rearr : |x| ^ k * (|s - s₀|⁻¹ * |iteratedDeriv n (u s) x - iteratedDeriv n (u s₀) x - (s - s₀) * iteratedDeriv n v₁ x|) =
          |s - s₀|⁻¹ * (|x| ^ k * |iteratedDeriv n (u s) x - iteratedDeriv n (u s₀) x - (s - s₀) * iteratedDeriv n v₁ x|) := by
        ring
      rw [h_rearr]
