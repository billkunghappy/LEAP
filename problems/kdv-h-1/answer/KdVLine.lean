  · refine Filter.Eventually.of_forall (fun s hs => ?_)
    rw [sub_eq_zero.mp hs]
    simp

theorem bivariate_schwartz_flows_to_diffFlow : ∃ δ_diag : ℝ, 0 < δ_diag ∧
      ∀ κ : ℝ, 2 ≤ κ → ∀ U : ℝ → ℝ → 𝓢(ℝ, ℝ),
        (∀ τ : ℝ, IsSchwartzSolution (fun s => U s τ)) →
        (∀ s : ℝ, IsRegFlowSolution κ (fun τ => U s τ)) →
        (∀ s τ : ℝ, ‖ι (U s τ)‖ ≤ δ_diag) →
        ∀ t : ℝ, IsDiffFlowSolution κ (fun s => U s (t - s)) :=
by
  obtain ⟨δ_diag, hδ_diag, h_static⟩ := diagGreen_sub_const_schwartz_seminorm_step
  refine ⟨δ_diag, hδ_diag, ?_⟩
  intro κ hκ U hU_kdv hU_reg hU_ball t s₀
  obtain ⟨v₁, hv₁_deriv, hv₁_eq⟩ := hU_kdv (t - s₀) s₀
  obtain ⟨v₂, hv₂_deriv, hv₂_eq⟩ := hU_reg s₀ (t - s₀)
  refine ⟨v₁ - v₂, ?_, ?_⟩
  · apply bivariate_schwartz_diag_hasDerivAt_of_kdv_and_short_time_lip U t s₀ v₁ v₂ hU_kdv
      ⟨hv₁_deriv, hv₁_eq⟩ hv₂_deriv
    intro k n R₀ hR₀
    obtain ⟨σ₀, M, hσ₀, hM, h_w_lip⟩ :=
      reg_flow_short_time_schwartz_seminorm_lipschitz δ_diag κ hκ (h_static κ hκ) k n R₀ hR₀
    refine ⟨σ₀, M, hσ₀, hM, ?_⟩
    intro s' hs'_init τ hτ
    exact h_w_lip (fun τ' => U s' τ') (hU_reg s') (fun τ' => hU_ball s' τ') (t - s₀) hs'_init τ hτ
  · intro x
    change v₁ x - v₂ x = diffFlowRHS κ (U s₀ (t - s₀)) x
    rw [hv₁_eq x, hv₂_eq x]
    rfl

theorem kdv_reg_commuting_diff_flow (h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → IsSchwartzSolution v → u 0 = v 0 → u = v)
    (δ' : ℝ) (hδ' : 0 < δ') :
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ δ₀ ≤ δ' ∧
      ∀ κ : ℝ, 2 ≤ κ →
        ∀ u w : ℝ → 𝓢(ℝ, ℝ),
          IsSchwartzSolution u → IsRegFlowSolution κ w → w 0 = u 0 → ‖ι (u 0)‖ ≤ δ₀ →
          ∀ t : ℝ,
            ∃ z : ℝ → 𝓢(ℝ, ℝ),
              IsDiffFlowSolution κ z ∧
              z 0 = w t ∧ z t = u t ∧
              (∀ s : ℝ, ‖ι (z s)‖ ≤ δ') ∧
              (∀ s : ℝ, alphaFunctional κ (z s) = alphaFunctional κ (u 0)) :=
by
  obtain ⟨δ_comm, hδ_comm, h_surf⟩ := commuting_kdv_reg_flow_surface h_exists h_unique
  obtain ⟨δ_diag, hδ_diag, h_diag⟩ := bivariate_schwartz_flows_to_diffFlow
  set δ_target : ℝ := min δ' (min δ_comm δ_diag)
  have hδ_target : 0 < δ_target := by positivity
  have hδ_target_le_δ' : δ_target ≤ δ' := min_le_left _ _
  have hδ_target_le_comm : δ_target ≤ δ_comm :=
    le_trans (min_le_right _ _) (min_le_left _ _)
  have hδ_target_le_diag : δ_target ≤ δ_diag :=
    le_trans (min_le_right _ _) (min_le_right _ _)
  obtain ⟨δ_kdv, hδ_kdv_pos, hδ_kdv_le, h_kdv⟩ :=
    kdv_alpha_conservation_small_data h_exists h_unique δ_target hδ_target
  obtain ⟨δ₀, hδ₀_pos, hδ₀_le, h_reg⟩ :=
    reg_flow_apriori_trapping_and_conservation δ_kdv hδ_kdv_pos
  have hδ₀_le_δ' : δ₀ ≤ δ' := le_trans hδ₀_le (le_trans hδ_kdv_le hδ_target_le_δ')
  refine ⟨δ₀, hδ₀_pos, hδ₀_le_δ', ?_⟩
  intro κ hκ u w hu hw hw0 hu0 t
  have hκ_ge1 : 1 ≤ κ := by linarith
  have hw0_ball : ‖ι (w 0)‖ ≤ δ₀ := by rwa [hw0]
  obtain ⟨hw_ball, hw_alpha⟩ := h_reg κ hκ w hw hw0_ball
  let U : ℝ → ℝ → 𝓢(ℝ, ℝ) := fun s τ => (h_exists (w τ)).choose s
  have hU_kdv : ∀ τ : ℝ, IsSchwartzSolution (fun s => U s τ) :=
    fun τ => ((h_exists (w τ)).choose_spec).1
  have hU_init : ∀ τ : ℝ, U 0 τ = w τ :=
    fun τ => ((h_exists (w τ)).choose_spec).2
  have hU_zero_eq : (fun s => U s 0) = u :=
    h_unique (fun s => U s 0) u (hU_kdv 0) hu ((hU_init 0).trans hw0)
  have hU_zero : ∀ s : ℝ, U s 0 = u s :=
    fun s => congr_fun hU_zero_eq s
  have hU0_eq_w : (fun τ => U 0 τ) = w := funext hU_init
  have hU_reg0 : IsRegFlowSolution κ (fun τ => U 0 τ) := by rwa [hU0_eq_w]
  have hU_ball : ∀ s τ : ℝ, ‖ι (U s τ)‖ ≤ δ_target := by
    intro s τ
    have h_init_ball : ‖ι (U 0 τ)‖ ≤ δ_kdv := by
      rw [hU_init τ]
      exact hw_ball τ
    exact (h_kdv (fun s' => U s' τ) (hU_kdv τ) h_init_ball).1 s
  have hU_alpha : ∀ s τ : ℝ, alphaFunctional κ (U s τ) = alphaFunctional κ (U 0 τ) := by
    intro s τ
    have h_init_ball : ‖ι (U 0 τ)‖ ≤ δ_kdv := by
      rw [hU_init τ]
      exact hw_ball τ
    exact (h_kdv (fun s' => U s' τ) (hU_kdv τ) h_init_ball).2 κ hκ_ge1 s
  have hU_reg : ∀ s : ℝ, IsRegFlowSolution κ (fun τ => U s τ) :=
    h_surf κ hκ U hU_kdv hU_reg0 (fun s τ => le_trans (hU_ball s τ) hδ_target_le_comm)
  let z : ℝ → 𝓢(ℝ, ℝ) := fun s => U s (t - s)
  refine ⟨z, ?_, ?_, ?_, ?_, ?_⟩
  · exact h_diag κ hκ U hU_kdv hU_reg (fun s τ => le_trans (hU_ball s τ) hδ_target_le_diag) t
  · dsimp [z]
    rw [sub_zero, hU_init t]
  · dsimp [z]
    rw [sub_self, hU_zero t]
  · intro s
    exact le_trans (hU_ball s (t - s)) hδ_target_le_δ'
  · intro s
    dsimp [z]
    rw [hU_alpha s (t - s), hU_init (t - s), hw_alpha κ hκ_ge1 (t - s), hw0]

theorem diff_flow_recipGreenDiff_hasDerivAt : ∃ δ₁ : ℝ, 0 < δ₁ ∧
      ∀ κ : ℝ, 2 ≤ κ →
        ∀ z : ℝ → 𝓢(ℝ, ℝ),
          IsDiffFlowSolution κ z →
          ∀ s : ℝ, ‖ι (z s)‖ ≤ δ₁ →
          ∀ x : ℝ,
            HasDerivAt (fun τ => recipGreenDiff (z τ) x)
              ((-1 / (2 * (diagGreen 1 (z s) x) ^ 2)) *
                ∫ y : ℝ, greenKernel 1 (z s) x y * diffFlowRHS κ (z s) y * greenKernel 1 (z s) y x) s :=
by
  refine ⟨1 / 8, by norm_num, ?_⟩
  intro κ _hκ z hz s hs x
  have h1_le : (1 : ℝ) ≤ 1 := le_rfl
  have h_fg_cont : Continuous (fun p : ℝ × ℝ => freeGreenKernel 1 p.1 p.2) := by
    dsimp [freeGreenKernel]
    fun_prop
  have h_fg_bound : ∀ a b : ℝ, |freeGreenKernel 1 a b| ≤ 1 / (2 * (1 : ℝ)) := by
    intro a b
    dsimp [freeGreenKernel]
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 1 / (2 * 1)), abs_of_pos (Real.exp_pos _)]
    have h_exp_le : Real.exp (-1 * |a - b|) ≤ 1 :=
      Real.exp_le_one_iff.mpr (by linarith [abs_nonneg (a - b)])
    exact mul_le_of_le_one_right (by positivity) h_exp_le
  have h_iter_cont_bound : ∀ (w : 𝓢(ℝ, ℝ)) (ℓ : ℕ),
      Continuous (fun p : ℝ × ℝ => greenIterKernel 1 w ℓ p.1 p.2) ∧
      ∃ M : ℝ, 0 ≤ M ∧ ∀ a b : ℝ, |greenIterKernel 1 w ℓ a b| ≤ M := by
    intro w ℓ
    induction ℓ with
    | zero =>
      exact ⟨h_fg_cont, 1 / (2 * 1), by positivity, h_fg_bound⟩
    | succ ℓ ih =>
      obtain ⟨h_cont_ℓ, M, hM_nn, hM_bound⟩ := ih
      let F : ℝ × ℝ → ℝ → ℝ := fun p u => greenIterKernel 1 w ℓ p.1 u * w u * freeGreenKernel 1 u p.2
      let bound : ℝ → ℝ := fun u => M * (1 / (2 * 1)) * ‖w u‖
      have h_w_int : Integrable (w : ℝ → ℝ) volume := w.integrable
      have h_bound_int : Integrable bound volume :=
        h_w_int.norm.const_mul (M * (1 / (2 * 1)))
      have hF_meas : ∀ p : ℝ × ℝ, AEStronglyMeasurable (F p) volume := by
        intro p
        have h_c1 : Continuous (fun u : ℝ => greenIterKernel 1 w ℓ p.1 u) :=
          h_cont_ℓ.comp (continuous_const.prodMk continuous_id)
        have h_c2 : Continuous (fun u : ℝ => freeGreenKernel 1 u p.2) :=
          h_fg_cont.comp (continuous_id.prodMk continuous_const)
        exact ((h_c1.mul w.continuous).mul h_c2).aestronglyMeasurable
      have hF_dom : ∀ p : ℝ × ℝ, ∀ᵐ u : ℝ ∂volume, ‖F p u‖ ≤ bound u := by
        intro p
        filter_upwards with u
        dsimp [F, bound]
        rw [abs_mul, abs_mul]
        have h1 := hM_bound p.1 u
        have h2 := h_fg_bound u p.2
        calc |greenIterKernel 1 w ℓ p.1 u| * |w u| * |freeGreenKernel 1 u p.2|
          _ = (|greenIterKernel 1 w ℓ p.1 u| * |freeGreenKernel 1 u p.2|) * |w u| := by ring
          _ ≤ (M * (1 / (2 * 1))) * |w u| :=
            mul_le_mul_of_nonneg_right (mul_le_mul h1 h2 (abs_nonneg _) hM_nn) (abs_nonneg _)
      have hF_cont : ∀ᵐ u : ℝ ∂volume, Continuous (fun p : ℝ × ℝ => F p u) := by
        filter_upwards with u
        dsimp [F]
        have h_c1 : Continuous (fun p : ℝ × ℝ => greenIterKernel 1 w ℓ p.1 u) :=
          h_cont_ℓ.comp (continuous_fst.prodMk continuous_const)
        have h_c2 : Continuous (fun p : ℝ × ℝ => freeGreenKernel 1 u p.2) :=
          h_fg_cont.comp (continuous_const.prodMk continuous_snd)
        exact (h_c1.mul continuous_const).mul h_c2
      have h_int_cont : Continuous (fun p : ℝ × ℝ => ∫ u : ℝ, F p u) :=
        continuous_of_dominated hF_meas hF_dom h_bound_int hF_cont
      refine ⟨h_int_cont.neg, ∫ u : ℝ, bound u, integral_nonneg (fun u => by dsimp [bound]; positivity), ?_⟩
      intro a b
      dsimp [greenIterKernel]
      rw [abs_neg]
      have hF_int : Integrable (F (a, b)) volume :=
        h_bound_int.mono' (hF_meas (a, b)) (hF_dom (a, b))
      calc |∫ u : ℝ, F (a, b) u|
        _ ≤ ∫ u : ℝ, ‖F (a, b) u‖ := by
          simpa [Real.norm_eq_abs] using norm_integral_le_integral_norm (F (a, b))
        _ ≤ ∫ u : ℝ, bound u := integral_mono_ae hF_int.norm h_bound_int (hF_dom (a, b))
  have h_cont : ∀ (w : 𝓢(ℝ, ℝ)) (ℓ : ℕ), Continuous (fun p : ℝ × ℝ => greenIterKernel 1 w ℓ p.1 p.2) :=
    fun w ℓ => (h_iter_cont_bound w ℓ).1
  have h_bound : ∀ (w : 𝓢(ℝ, ℝ)), ‖ι w‖ ≤ 1 / 4 → ∀ (ℓ : ℕ) (a b : ℝ),
      |greenIterKernel 1 w ℓ a b| ≤ (1 / (2 * 1)) * (1 / 4) ^ ℓ := by
    intro w hw ℓ a b
    calc |greenIterKernel 1 w ℓ a b|
      _ ≤ (1 / (2 * 1)) * ‖ι w‖ ^ ℓ := greenIterKernel_offDiag_pointwise_bound 1 h1_le w ℓ a b
      _ ≤ (1 / (2 * 1)) * (1 / 4) ^ ℓ :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) hw ℓ) (by positivity)
  have h_tele := greenIterKernel_sub_eq_sum_antidiagonal 1 h1_le
  have h_hm1_le_L1_sq : ∀ w₁ w₂ : 𝓢(ℝ, ℝ),
      ‖ι w₁ - ι w₂‖ ^ 2 ≤ (∫ y : ℝ, |w₁ y - w₂ y|) ^ 2 := by
    intro w₁ w₂
    let q : 𝓢(ℝ, ℝ) := w₁ - w₂
    have h_iter1_sub : (fun a : ℝ => greenIterKernel 1 w₁ 1 a a - greenIterKernel 1 w₂ 1 a a) =
        (fun a : ℝ => greenIterKernel 1 q 1 a a) := by
      ext a
      rw [h_tele w₁ w₂ 0 a a, Finset.Nat.antidiagonal_zero]
      dsimp [greenIterKernel, q]
      congr 1
      refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
      simp only [Finset.sum_singleton]
      dsimp [greenIterKernel]
      ring
    have h_norm_sub_eq : ‖ι w₁ - ι w₂‖ ^ 2 = ‖ι q‖ ^ 2 := by
      rw [← (greenIterKernel_one_first_h1_isometry w₁ w₂).2.2.2.2.2.2.2,
          h_iter1_sub,
          (greenIterKernel_one_first_h1_isometry q 0).2.2.2.1]
    have hq_abs_int : Integrable (fun u : ℝ => |q u|) volume := by
      simpa [Real.norm_eq_abs] using q.integrable.norm
    set I_q : ℝ := ∫ u : ℝ, |q u|
    have hIq_nn : 0 ≤ I_q := integral_nonneg (fun u => abs_nonneg _)
    have h_inner_le : ∀ y : ℝ,
        |∫ u : ℝ, Real.exp (-2 * |y - u|) * q y * q u| ≤ |q y| * I_q := by
      intro y
      let F_y : ℝ → ℝ := fun u => Real.exp (-2 * |y - u|) * q y * q u
      have hFy_cont : Continuous F_y := by
        dsimp [F_y]
        have := q.continuous
        fun_prop
      have hFy_dom : ∀ u : ℝ, ‖F_y u‖ ≤ |q y| * |q u| := by
        intro u
        dsimp [F_y]
        rw [abs_mul, abs_mul, abs_of_pos (Real.exp_pos _)]
        have h_exp : Real.exp (-2 * |y - u|) ≤ 1 :=
          Real.exp_le_one_iff.mpr (by linarith [abs_nonneg (y - u)])
        calc Real.exp (-2 * |y - u|) * |q y| * |q u|
          _ ≤ 1 * |q y| * |q u| := by
            apply mul_le_mul_of_nonneg_right
            · exact mul_le_mul_of_nonneg_right h_exp (abs_nonneg _)
            · exact abs_nonneg _
          _ = |q y| * |q u| := by ring
      have hFy_int : Integrable F_y volume :=
        (hq_abs_int.const_mul |q y|).mono' hFy_cont.aestronglyMeasurable (Filter.Eventually.of_forall hFy_dom)
      calc |∫ u : ℝ, F_y u|
        _ ≤ ∫ u : ℝ, ‖F_y u‖ := by
          simpa [Real.norm_eq_abs] using norm_integral_le_integral_norm F_y
        _ ≤ ∫ u : ℝ, |q y| * |q u| := integral_mono hFy_int.norm (hq_abs_int.const_mul |q y|) hFy_dom
        _ = |q y| * I_q := integral_const_mul |q y| _
    have h_double_le : (∫ y : ℝ, ∫ u : ℝ, Real.exp (-2 * |y - u|) * q y * q u) ≤ I_q ^ 2 := by
      calc ∫ y : ℝ, ∫ u : ℝ, Real.exp (-2 * |y - u|) * q y * q u
        _ ≤ |∫ y : ℝ, ∫ u : ℝ, Real.exp (-2 * |y - u|) * q y * q u| := le_abs_self _
        _ ≤ ∫ y : ℝ, ‖∫ u : ℝ, Real.exp (-2 * |y - u|) * q y * q u‖ := by
          simpa [Real.norm_eq_abs] using
            norm_integral_le_integral_norm (fun y : ℝ => ∫ u : ℝ, Real.exp (-2 * |y - u|) * q y * q u)
        _ ≤ ∫ y : ℝ, |q y| * I_q := by
          have h_outer_cont : Continuous (fun y : ℝ => ∫ u : ℝ, Real.exp (-2 * |y - u|) * q y * q u) := by
            let K : ℝ → ℝ → ℝ := fun y u => Real.exp (-2 * |y - u|) * q u
            have hK_meas : ∀ y : ℝ, AEStronglyMeasurable (K y) volume := by
              intro y
              have hc : Continuous (K y) := by
                dsimp [K]
                have := q.continuous
                fun_prop
              exact hc.aestronglyMeasurable
            have hK_dom : ∀ y : ℝ, ∀ᵐ u : ℝ ∂volume, ‖K y u‖ ≤ |q u| := by
              intro y
              filter_upwards with u
              dsimp [K]
              rw [abs_mul, abs_of_pos (Real.exp_pos _)]
              have h_exp : Real.exp (-2 * |y - u|) ≤ 1 :=
                Real.exp_le_one_iff.mpr (by linarith [abs_nonneg (y - u)])
              exact mul_le_of_le_one_left (abs_nonneg _) h_exp
            have hK_cont : ∀ᵐ u : ℝ ∂volume, Continuous (fun y : ℝ => K y u) := by
              filter_upwards with u
              dsimp [K]
              fun_prop
            have h_int_K_cont : Continuous (fun y : ℝ => ∫ u : ℝ, K y u) :=
              continuous_of_dominated hK_meas hK_dom hq_abs_int hK_cont
            have h_eq : (fun y : ℝ => ∫ u : ℝ, Real.exp (-2 * |y - u|) * q y * q u) =
                (fun y : ℝ => q y * ∫ u : ℝ, K y u) := by
              ext y
              dsimp [K]
              rw [← integral_const_mul]
              congr 1
              ext u
              ring
            rw [h_eq]
            exact q.continuous.mul h_int_K_cont
          have h_outer_int : Integrable (fun y : ℝ => ‖∫ u : ℝ, Real.exp (-2 * |y - u|) * q y * q u‖) volume := by
            refine (hq_abs_int.mul_const I_q).mono' h_outer_cont.norm.aestronglyMeasurable
              (Filter.Eventually.of_forall fun y => ?_)
            rw [Real.norm_of_nonneg (norm_nonneg _), Real.norm_eq_abs]
            exact h_inner_le y
          refine integral_mono h_outer_int (hq_abs_int.mul_const I_q) (fun y => ?_)
          rw [Real.norm_eq_abs]
          exact h_inner_le y
        _ = I_q * I_q := integral_mul_const I_q _
        _ = I_q ^ 2 := by ring
    have h_exp_id := exp_two_abs_double_integral_eq_hm1_norm_sq q
    have h_Iq_eq : I_q = ∫ y : ℝ, |w₁ y - w₂ y| := rfl
    rw [h_norm_sub_eq, ← h_Iq_eq]
    nlinarith [h_double_le, h_exp_id]
  obtain ⟨v, hv_deriv, hv_eq⟩ := hz s
  obtain ⟨h_l1_lin, h_l1_sq⟩ := schwartz_hasDerivAt_l1_tendsto z v s hv_deriv
  have h_norm_sub_tendsto : Filter.Tendsto (fun τ : ℝ => ‖τ - s‖) (nhds s) (nhds 0) := by
    have h_c : Continuous (fun τ : ℝ => ‖τ - s‖) :=
      (continuous_id.sub continuous_const).norm
    simpa using h_c.tendsto s
  have h_hm1_sq_tendsto : Filter.Tendsto (fun τ : ℝ => ‖ι (z τ) - ι (z s)‖ ^ 2) (nhds s) (nhds 0) := by
    have h_prod_tendsto : Filter.Tendsto
        (fun τ : ℝ => ‖τ - s‖ * (‖τ - s‖⁻¹ * (∫ y : ℝ, |z τ y - z s y|) ^ 2))
