      _ = B_x * ∑' m : ℕ, (1 / 4 : ℝ) ^ m := tsum_mul_left
      _ = B_x * (4 / 3) := by rw [h_geom_tsum]
      _ ≤ B_x * 2 := mul_le_mul_of_nonneg_left (by norm_num) hB_nn
      _ = (4 * π * M_w / κ) * (1 + x ^ 2)⁻¹ := by dsimp [B_x]; ring
  have h_inv_top : Filter.Tendsto (fun x : ℝ => (1 + x ^ 2)⁻¹) Filter.atTop (nhds 0) := by
    have h_sq : Filter.Tendsto (fun x : ℝ => x ^ 2) Filter.atTop Filter.atTop := by
      have h_mul := (Filter.tendsto_id (α := ℝ)).atTop_mul_atTop₀ Filter.tendsto_id
      simpa only [sq, id_eq] using h_mul
    have h_add : Filter.Tendsto (fun x : ℝ => 1 + x ^ 2) Filter.atTop Filter.atTop :=
      Filter.tendsto_atTop_add_const_left Filter.atTop 1 h_sq
    exact tendsto_inv_atTop_zero.comp h_add
  have h_inv_bot : Filter.Tendsto (fun x : ℝ => (1 + x ^ 2)⁻¹) Filter.atBot (nhds 0) := by
    have h_comp := h_inv_top.comp Filter.tendsto_neg_atBot_atTop
    simpa only [Function.comp_def, neg_sq] using h_comp
  have h_exp_left : ∀ a : ℝ,
      Filter.Tendsto (fun x : ℝ => Real.exp (-κ * (a - x))) Filter.atBot (nhds 0) := by
    intro a
    have h1 : Filter.Tendsto (fun x : ℝ => a - x) Filter.atBot Filter.atTop := by
      have h_eq : (fun x : ℝ => a - x) = (fun x : ℝ => a + -x) := by ext x; ring
      rw [h_eq]
      exact Filter.tendsto_atTop_add_const_left Filter.atBot a Filter.tendsto_neg_atBot_atTop
    have h2 : Filter.Tendsto (fun x : ℝ => κ * (a - x)) Filter.atBot Filter.atTop :=
      Filter.Tendsto.const_mul_atTop hκ_pos h1
    have h3 : Filter.Tendsto (fun x : ℝ => -κ * (a - x)) Filter.atBot Filter.atBot := by
      have h_eq : (fun x : ℝ => -κ * (a - x)) = (fun x : ℝ => -(κ * (a - x))) := by ext x; ring
      rw [h_eq]
      exact Filter.tendsto_neg_atTop_atBot.comp h2
    exact Real.tendsto_exp_atBot.comp h3
  have h_exp_right : ∀ a : ℝ,
      Filter.Tendsto (fun x : ℝ => Real.exp (-κ * (x - a))) Filter.atTop (nhds 0) := by
    intro a
    have h1 : Filter.Tendsto (fun x : ℝ => x - a) Filter.atTop Filter.atTop := by
      have h_eq : (fun x : ℝ => x - a) = (fun x : ℝ => x + -a) := by ext x; ring
      rw [h_eq]
      exact Filter.tendsto_atTop_add_const_right Filter.atTop (-a) Filter.tendsto_id
    have h2 : Filter.Tendsto (fun x : ℝ => κ * (x - a)) Filter.atTop Filter.atTop :=
      Filter.Tendsto.const_mul_atTop hκ_pos h1
    have h3 : Filter.Tendsto (fun x : ℝ => -κ * (x - a)) Filter.atTop Filter.atBot := by
      have h_eq : (fun x : ℝ => -κ * (x - a)) = (fun x : ℝ => -(κ * (x - a))) := by ext x; ring
      rw [h_eq]
      exact Filter.tendsto_neg_atTop_atBot.comp h2
    exact Real.tendsto_exp_atBot.comp h3
  have h_tend_L : ∀ a : ℝ,
      Filter.Tendsto (greenKernelLeft κ w a) Filter.atBot (nhds 0) ∧
      Filter.Tendsto (greenDerivLeft κ w a) Filter.atBot (nhds 0) := by
    intro a
    have h_tsum_G : Filter.Tendsto (fun x : ℝ => ∑' m : ℕ, greenIterKernel κ w (m + 1) a x)
        Filter.atBot (nhds 0) :=
      squeeze_zero_norm (a := fun x => (4 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹)
        (fun x => by rw [Real.norm_eq_abs]; exact h_tail_G a x)
        (by simpa using h_inv_bot.const_mul (4 * π * M_w / κ ^ 2))
    have h_tsum_dG : Filter.Tendsto (fun x : ℝ => ∑' m : ℕ, greenIterDerivY κ w (m + 1) a x)
        Filter.atBot (nhds 0) :=
      squeeze_zero_norm (a := fun x => (4 * π * M_w / κ) * (1 + x ^ 2)⁻¹)
        (fun x => by rw [Real.norm_eq_abs]; exact h_tail_dG a x)
        (by simpa using h_inv_bot.const_mul (4 * π * M_w / κ))
    refine ⟨?_, ?_⟩
    · change Filter.Tendsto
          (fun x : ℝ => (1 / (2 * κ)) * Real.exp (-κ * (a - x)) + ∑' m : ℕ, greenIterKernel κ w (m + 1) a x)
          Filter.atBot (nhds 0)
      have h0 : Filter.Tendsto (fun x : ℝ => (1 / (2 * κ)) * Real.exp (-κ * (a - x)))
          Filter.atBot (nhds ((1 / (2 * κ)) * 0)) :=
        (h_exp_left a).const_mul (1 / (2 * κ))
      rw [mul_zero] at h0
      have h_add := h0.add h_tsum_G
      rwa [add_zero] at h_add
    · change Filter.Tendsto
          (fun x : ℝ => (1 / 2) * Real.exp (-κ * (a - x)) + ∑' m : ℕ, greenIterDerivY κ w (m + 1) a x)
          Filter.atBot (nhds 0)
      have h0 : Filter.Tendsto (fun x : ℝ => (1 / 2) * Real.exp (-κ * (a - x)))
          Filter.atBot (nhds ((1 / 2) * 0)) :=
        (h_exp_left a).const_mul (1 / 2)
      rw [mul_zero] at h0
      have h_add := h0.add h_tsum_dG
      rwa [add_zero] at h_add
  have h_tend_R : ∀ a : ℝ,
      Filter.Tendsto (greenKernelRight κ w a) Filter.atTop (nhds 0) ∧
      Filter.Tendsto (greenDerivRight κ w a) Filter.atTop (nhds 0) := by
    intro a
    have h_tsum_G : Filter.Tendsto (fun x : ℝ => ∑' m : ℕ, greenIterKernel κ w (m + 1) a x)
        Filter.atTop (nhds 0) :=
      squeeze_zero_norm (a := fun x => (4 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹)
        (fun x => by rw [Real.norm_eq_abs]; exact h_tail_G a x)
        (by simpa using h_inv_top.const_mul (4 * π * M_w / κ ^ 2))
    have h_tsum_dG : Filter.Tendsto (fun x : ℝ => ∑' m : ℕ, greenIterDerivY κ w (m + 1) a x)
        Filter.atTop (nhds 0) :=
      squeeze_zero_norm (a := fun x => (4 * π * M_w / κ) * (1 + x ^ 2)⁻¹)
        (fun x => by rw [Real.norm_eq_abs]; exact h_tail_dG a x)
        (by simpa using h_inv_top.const_mul (4 * π * M_w / κ))
    refine ⟨?_, ?_⟩
    · change Filter.Tendsto
          (fun x : ℝ => (1 / (2 * κ)) * Real.exp (-κ * (x - a)) + ∑' m : ℕ, greenIterKernel κ w (m + 1) a x)
          Filter.atTop (nhds 0)
      have h0 : Filter.Tendsto (fun x : ℝ => (1 / (2 * κ)) * Real.exp (-κ * (x - a)))
          Filter.atTop (nhds ((1 / (2 * κ)) * 0)) :=
        (h_exp_right a).const_mul (1 / (2 * κ))
      rw [mul_zero] at h0
      have h_add := h0.add h_tsum_G
      rwa [add_zero] at h_add
    · change Filter.Tendsto
          (fun x : ℝ => -(1 / 2) * Real.exp (-κ * (x - a)) + ∑' m : ℕ, greenIterDerivY κ w (m + 1) a x)
          Filter.atTop (nhds 0)
      have h0 : Filter.Tendsto (fun x : ℝ => -(1 / 2) * Real.exp (-κ * (x - a)))
          Filter.atTop (nhds (-(1 / 2) * 0)) :=
        (h_exp_right a).const_mul (-(1 / 2))
      rw [mul_zero] at h0
      have h_add := h0.add h_tsum_dG
      rwa [add_zero] at h_add
  have hg_pos : ∀ x : ℝ, 0 < diagGreen κ w x :=
    fun x => lt_of_lt_of_le (by positivity) (hg_ge x)
  have h_inv_2g : ∀ x : ℝ, (2 * diagGreen κ w x)⁻¹ ≤ 2 * κ := by
    intro x
    have h1 : (2 * κ)⁻¹ ≤ 2 * diagGreen κ w x := by
      calc (2 * κ)⁻¹ = 2 * (1 / (4 * κ)) := by field_simp [hκ_ne]; ring
        _ ≤ 2 * diagGreen κ w x := mul_le_mul_of_nonneg_left (hg_ge x) zero_le_two
    have h2 : (2 * diagGreen κ w x)⁻¹ ≤ ((2 * κ)⁻¹)⁻¹ :=
      inv_anti₀ (by positivity) h1
    rwa [inv_inv] at h2
  have h_tend_F : ∀ y : ℝ,
      Filter.Tendsto (fun x => (greenKernelLeft κ w y x) ^ 2 / (2 * diagGreen κ w x))
        Filter.atBot (nhds 0) ∧
      Filter.Tendsto (fun x => -((greenKernelRight κ w y x) ^ 2 / (2 * diagGreen κ w x)))
        Filter.atTop (nhds 0) := by
    intro y
    refine ⟨?_, ?_⟩
    · refine squeeze_zero_norm (a := fun x => 2 * κ * (greenKernelLeft κ w y x) ^ 2) (fun x => ?_) ?_
      · rw [Real.norm_eq_abs, abs_div, abs_of_nonneg (sq_nonneg _),
          abs_of_pos (mul_pos two_pos (hg_pos x)), div_eq_mul_inv]
        calc (greenKernelLeft κ w y x) ^ 2 * (2 * diagGreen κ w x)⁻¹
          _ ≤ (greenKernelLeft κ w y x) ^ 2 * (2 * κ) :=
            mul_le_mul_of_nonneg_left (h_inv_2g x) (sq_nonneg _)
          _ = 2 * κ * (greenKernelLeft κ w y x) ^ 2 := by ring
      · simpa using ((h_tend_L y).1.pow 2).const_mul (2 * κ)
    · refine squeeze_zero_norm (a := fun x => 2 * κ * (greenKernelRight κ w y x) ^ 2) (fun x => ?_) ?_
      · rw [Real.norm_eq_abs, abs_neg, abs_div, abs_of_nonneg (sq_nonneg _),
          abs_of_pos (mul_pos two_pos (hg_pos x)), div_eq_mul_inv]
        calc (greenKernelRight κ w y x) ^ 2 * (2 * diagGreen κ w x)⁻¹
          _ ≤ (greenKernelRight κ w y x) ^ 2 * (2 * κ) :=
            mul_le_mul_of_nonneg_left (h_inv_2g x) (sq_nonneg _)
          _ = 2 * κ * (greenKernelRight κ w y x) ^ 2 := by ring
      · simpa using ((h_tend_R y).1.pow 2).const_mul (2 * κ)
  have h2gsq_ne : ∀ x : ℝ, 2 * (diagGreen κ w x) ^ 2 ≠ 0 :=
    fun x => ne_of_gt (mul_pos two_pos (sq_pos_of_pos (hg_pos x)))
  have h_int : ∀ y : ℝ,
      Integrable (fun x : ℝ => (greenKernel κ w x y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2))
        volume := by
    intro y
    let f_y : ℝ → ℝ := fun x =>
      (greenKernel κ w x y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2)
    have hf_cont : Continuous f_y := by
      dsimp [f_y]
      have hG1 : Continuous (fun x : ℝ => greenKernel κ w x y) :=
        hG_cont.comp (continuous_id.prodMk continuous_const)
      have hG2 : Continuous (fun x : ℝ => greenKernel κ w y x) :=
        hG_cont.comp (continuous_const.prodMk continuous_id)
      have hg2 : Continuous (fun x : ℝ => 2 * (diagGreen κ w x) ^ 2) :=
        continuous_const.mul (hg_cont.pow 2)
      exact (hG1.mul hG2).div hg2 h2gsq_ne
    set C_y : ℝ := 32 * (1 + y ^ 2) + 32 * π * M_w / κ
    have hf_pw : ∀ x : ℝ, ‖f_y x‖ ≤ C_y * (1 + x ^ 2)⁻¹ := by
      intro x
      dsimp [f_y]
      rw [abs_div, abs_mul, abs_of_pos (mul_pos two_pos (sq_pos_of_pos (hg_pos x)))]
      have h_denom : 1 / (2 * (diagGreen κ w x) ^ 2) ≤ 8 * κ ^ 2 := by
        have h_sq : (1 / (4 * κ)) ^ 2 ≤ (diagGreen κ w x) ^ 2 :=
          pow_le_pow_left₀ (by positivity) (hg_ge x) 2
        have h1 : 1 / (2 * (diagGreen κ w x) ^ 2) ≤ 1 / (2 * (1 / (4 * κ)) ^ 2) :=
          one_div_le_one_div_of_le (by positivity) (mul_le_mul_of_nonneg_left h_sq zero_le_two)
        have h2 : 1 / (2 * (1 / (4 * κ)) ^ 2) = 8 * κ ^ 2 := by field_simp [hκ_ne]; ring
        linarith
      have h_Gyx : |greenKernel κ w y x| ≤
          (4 * (1 + y ^ 2) / κ + 4 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹ := by
        have h_fg : (1 / (2 * κ)) * Real.exp (-κ * |y - x|) ≤
            (4 * (1 + y ^ 2) / κ) * (1 + x ^ 2)⁻¹ := by
          calc (1 / (2 * κ)) * Real.exp (-κ * |y - x|)
            _ ≤ (1 / (2 * κ)) * (8 * (1 + y ^ 2) * (1 + x ^ 2)⁻¹) :=
              mul_le_mul_of_nonneg_left (h_exp_peetre x y) (by positivity)
            _ = (4 * (1 + y ^ 2) / κ) * (1 + x ^ 2)⁻¹ := by ring
        calc |greenKernel κ w y x|
          _ ≤ (1 / (2 * κ)) * Real.exp (-κ * |y - x|) + (4 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹ :=
            hG_peel x y
          _ ≤ (4 * (1 + y ^ 2) / κ) * (1 + x ^ 2)⁻¹ + (4 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹ :=
            by linarith [h_fg]
          _ = (4 * (1 + y ^ 2) / κ + 4 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹ := by ring
      have h_G_prod : |greenKernel κ w x y| * |greenKernel κ w y x| ≤
          (1 / κ) * ((4 * (1 + y ^ 2) / κ + 4 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹) :=
        mul_le_mul (hG_le x y) h_Gyx (abs_nonneg _) (by positivity)
      calc (|greenKernel κ w x y| * |greenKernel κ w y x|) / (2 * (diagGreen κ w x) ^ 2)
        _ = (|greenKernel κ w x y| * |greenKernel κ w y x|) * (1 / (2 * (diagGreen κ w x) ^ 2)) := by ring
        _ ≤ ((1 / κ) * ((4 * (1 + y ^ 2) / κ + 4 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹)) * (8 * κ ^ 2) :=
          mul_le_mul h_G_prod h_denom (by positivity) (by positivity)
        _ = C_y * (1 + x ^ 2)⁻¹ := by
          dsimp [C_y]
          field_simp [hκ_ne]
          ring
    exact (integrable_inv_one_add_sq.const_mul C_y).mono' hf_cont.aestronglyMeasurable
      (Filter.Eventually.of_forall hf_pw)
  exact ⟨h_tend_L, h_tend_R, h_tend_F, h_int⟩

theorem greenKernel_sq_div_diagGreen_sq_integral : ∃ δ_weyl : ℝ, 0 < δ_weyl ∧
      ∀ (κ : ℝ), 1 ≤ κ → ∀ (w : 𝓢(ℝ, ℝ)), ‖ι w‖ ≤ δ_weyl →
      ∀ (y : ℝ),
        ∫ x : ℝ, (greenKernel κ w x y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2) =
          diagGreen κ w y :=
by
  refine ⟨1 / 4, by norm_num, ?_⟩
  intro κ hκ w hw y
  have hκ_pos : 0 < κ := by linarith
  have h_diag_d := greenIterKernel_diag_hasDerivAt κ hκ w
  obtain ⟨h_symm, h_off_d1, h_off_d2, h_off_bd⟩ :=
    greenIterKernel_offDiag_hasDerivAt_and_symm κ hκ w
  obtain ⟨h_G_symm, h_diag, h_eq_LR, h_jump_LR, h_d1_LR, h_d2_LR⟩ :=
    greenKernel_halfLine_ode_and_jump κ hκ w hw h_diag_d h_symm h_off_d1 h_off_d2 h_off_bd
  obtain ⟨h_tend_L, h_tend_R, h_tend_F, h_int⟩ :=
    greenKernel_halfLine_tendsto_and_integrable κ hκ w hw
  have h_diag_pos : ∀ x : ℝ, 0 < diagGreen κ w x := by
    intro x
    have h_low : 0 < 1 / (4 * κ) := by positivity
    exact lt_of_lt_of_le h_low (h_diag x).1
  have h_wronsk_L : ∀ x : ℝ, x ≤ y →
      2 * diagGreen κ w x * greenDerivLeft κ w y x -
        diagGreenDeriv κ w x * greenKernelLeft κ w y x =
        greenKernelLeft κ w y x := by
    intro x hx
    let W_L : ℝ → ℝ := fun ξ =>
      greenKernelLeft κ w x ξ * greenDerivLeft κ w y ξ -
        greenDerivLeft κ w x ξ * greenKernelLeft κ w y ξ
    have hW_L_deriv : ∀ ξ ∈ Set.Iic x, HasDerivAt W_L 0 ξ := by
      intro ξ hξ
      have hξ_x : ξ ≤ x := hξ
      have hξ_y : ξ ≤ y := le_trans hξ_x hx
      have hd1_x := (h_d1_LR x ξ).1
      have hd2_x := (h_d2_LR x ξ).1 hξ_x
      have hd1_y := (h_d1_LR y ξ).1
      have hd2_y := (h_d2_LR y ξ).1 hξ_y
      refine ((hd1_x.mul hd2_y).sub (hd2_x.mul hd1_y)).congr_deriv ?_
      ring
    have hW_L_cont : ContinuousWithinAt W_L (Set.Iic x) x :=
      (hW_L_deriv x Set.right_mem_Iic).continuousAt.continuousWithinAt
    have hW_L_io : ∀ ξ ∈ Set.Iio x, HasDerivAt W_L 0 ξ :=
      fun ξ hξ => hW_L_deriv ξ (Set.Iio_subset_Iic_self hξ)
    have hW_L_tend : Filter.Tendsto W_L Filter.atBot (nhds 0) := by
      have ht := ((h_tend_L x).1.mul (h_tend_L y).2).sub ((h_tend_L x).2.mul (h_tend_L y).1)
      simpa using ht
    have h_int_W_L := MeasureTheory.integral_Iic_of_hasDerivAt_of_tendsto
      hW_L_cont hW_L_io MeasureTheory.integrableOn_zero hW_L_tend
    rw [MeasureTheory.integral_zero, sub_zero] at h_int_W_L
    have hW_L_zero : W_L x = 0 := h_int_W_L.symm
    dsimp [W_L] at hW_L_zero
    have h_gx : greenKernelLeft κ w x x = diagGreen κ w x :=
      (h_eq_LR x x).1 le_rfl
    have h_dgx : greenDerivLeft κ w x x = (diagGreenDeriv κ w x + 1) / 2 :=
      (h_jump_LR x).1
    rw [h_gx, h_dgx] at hW_L_zero
    linarith
  have h_wronsk_R : ∀ x : ℝ, y ≤ x →
      2 * diagGreen κ w x * greenDerivRight κ w y x -
        diagGreenDeriv κ w x * greenKernelRight κ w y x =
        -greenKernelRight κ w y x := by
    intro x hx
    let W_R : ℝ → ℝ := fun ξ =>
      greenKernelRight κ w x ξ * greenDerivRight κ w y ξ -
        greenDerivRight κ w x ξ * greenKernelRight κ w y ξ
    have hW_R_deriv : ∀ ξ ∈ Set.Ici x, HasDerivAt W_R 0 ξ := by
      intro ξ hξ
      have hξ_x : x ≤ ξ := hξ
      have hξ_y : y ≤ ξ := le_trans hx hξ_x
      have hd1_x := (h_d1_LR x ξ).2
      have hd2_x := (h_d2_LR x ξ).2 hξ_x
      have hd1_y := (h_d1_LR y ξ).2
      have hd2_y := (h_d2_LR y ξ).2 hξ_y
      refine ((hd1_x.mul hd2_y).sub (hd2_x.mul hd1_y)).congr_deriv ?_
      ring
    have hW_R_cont : ContinuousWithinAt W_R (Set.Ici x) x :=
      (hW_R_deriv x Set.left_mem_Ici).continuousAt.continuousWithinAt
    have hW_R_oi : ∀ ξ ∈ Set.Ioi x, HasDerivAt W_R 0 ξ :=
      fun ξ hξ => hW_R_deriv ξ (Set.Ioi_subset_Ici_self hξ)
    have hW_R_tend : Filter.Tendsto W_R Filter.atTop (nhds 0) := by
      have ht := ((h_tend_R x).1.mul (h_tend_R y).2).sub ((h_tend_R x).2.mul (h_tend_R y).1)
      simpa using ht
    have h_int_W_R := MeasureTheory.integral_Ioi_of_hasDerivAt_of_tendsto
      hW_R_cont hW_R_oi MeasureTheory.integrableOn_zero hW_R_tend
    rw [MeasureTheory.integral_zero, zero_sub] at h_int_W_R
    have hW_R_zero : W_R x = 0 := by linarith
    dsimp [W_R] at hW_R_zero
    have h_gx : greenKernelRight κ w x x = diagGreen κ w x :=
      (h_eq_LR x x).2 le_rfl
    have h_dgx : greenDerivRight κ w x x = (diagGreenDeriv κ w x - 1) / 2 :=
      (h_jump_LR x).2
    rw [h_gx, h_dgx] at hW_R_zero
    linarith
  let f : ℝ → ℝ := fun x =>
    (greenKernel κ w x y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2)
  let F_L : ℝ → ℝ := fun x => (greenKernelLeft κ w y x) ^ 2 / (2 * diagGreen κ w x)
  let F_R : ℝ → ℝ := fun x => -((greenKernelRight κ w y x) ^ 2 / (2 * diagGreen κ w x))
  have hF_L_deriv : ∀ x ∈ Set.Iic y, HasDerivAt F_L (f x) x := by
    intro x hx
    have h2g_ne : 2 * diagGreen κ w x ≠ 0 := ne_of_gt (by linarith [h_diag_pos x])
    have hd_num : HasDerivAt (fun x' => (greenKernelLeft κ w y x') ^ 2)
        (2 * greenKernelLeft κ w y x ^ 1 * greenDerivLeft κ w y x) x :=
      ((h_d1_LR y x).1).pow 2
    have hd_den : HasDerivAt (fun x' => 2 * diagGreen κ w x')
        (2 * diagGreenDeriv κ w x) x :=
      ((h_diag x).2).const_mul 2
    refine (hd_num.div hd_den h2g_ne).congr_deriv ?_
    have hw_L := h_wronsk_L x hx
    have h_eq_y : greenKernelLeft κ w y x = greenKernel κ w y x := (h_eq_LR y x).1 hx
    have h_sym_xy : greenKernel κ w x y = greenKernel κ w y x := h_G_symm x y
    have h_num_eq :
        (2 * greenKernelLeft κ w y x ^ 1 * greenDerivLeft κ w y x * (2 * diagGreen κ w x) -
          greenKernelLeft κ w y x ^ 2 * (2 * diagGreenDeriv κ w x)) =
        2 * (greenKernelLeft κ w y x) ^ 2 := by
      calc (2 * greenKernelLeft κ w y x ^ 1 * greenDerivLeft κ w y x * (2 * diagGreen κ w x) -
            greenKernelLeft κ w y x ^ 2 * (2 * diagGreenDeriv κ w x))
        _ = 2 * greenKernelLeft κ w y x *
              (2 * diagGreen κ w x * greenDerivLeft κ w y x -
                diagGreenDeriv κ w x * greenKernelLeft κ w y x) := by ring
        _ = 2 * greenKernelLeft κ w y x * greenKernelLeft κ w y x := by rw [hw_L]
        _ = 2 * (greenKernelLeft κ w y x) ^ 2 := by ring
    dsimp [f]
    rw [h_num_eq, h_eq_y, h_sym_xy]
    ring
  have hF_R_deriv : ∀ x ∈ Set.Ici y, HasDerivAt F_R (f x) x := by
    intro x hx
    have h2g_ne : 2 * diagGreen κ w x ≠ 0 := ne_of_gt (by linarith [h_diag_pos x])
    have hd_num : HasDerivAt (fun x' => (greenKernelRight κ w y x') ^ 2)
        (2 * greenKernelRight κ w y x ^ 1 * greenDerivRight κ w y x) x :=
      ((h_d1_LR y x).2).pow 2
    have hd_den : HasDerivAt (fun x' => 2 * diagGreen κ w x')
        (2 * diagGreenDeriv κ w x) x :=
      ((h_diag x).2).const_mul 2
    refine ((hd_num.div hd_den h2g_ne).neg).congr_deriv ?_
    have hw_R := h_wronsk_R x hx
    have h_eq_y : greenKernelRight κ w y x = greenKernel κ w y x := (h_eq_LR y x).2 hx
    have h_sym_xy : greenKernel κ w x y = greenKernel κ w y x := h_G_symm x y
    have h_num_eq :
        -((2 * greenKernelRight κ w y x ^ 1 * greenDerivRight κ w y x * (2 * diagGreen κ w x) -
          greenKernelRight κ w y x ^ 2 * (2 * diagGreenDeriv κ w x)) / (2 * diagGreen κ w x) ^ 2) =
        2 * (greenKernelRight κ w y x) ^ 2 / (2 * diagGreen κ w x) ^ 2 := by
      have h_top :
          (2 * greenKernelRight κ w y x ^ 1 * greenDerivRight κ w y x * (2 * diagGreen κ w x) -
            greenKernelRight κ w y x ^ 2 * (2 * diagGreenDeriv κ w x)) =
          -2 * (greenKernelRight κ w y x) ^ 2 := by
        calc (2 * greenKernelRight κ w y x ^ 1 * greenDerivRight κ w y x * (2 * diagGreen κ w x) -
              greenKernelRight κ w y x ^ 2 * (2 * diagGreenDeriv κ w x))
          _ = 2 * greenKernelRight κ w y x *
                (2 * diagGreen κ w x * greenDerivRight κ w y x -
                  diagGreenDeriv κ w x * greenKernelRight κ w y x) := by ring
          _ = 2 * greenKernelRight κ w y x * (-greenKernelRight κ w y x) := by rw [hw_R]
          _ = -2 * (greenKernelRight κ w y x) ^ 2 := by ring
      rw [h_top]
      ring
    dsimp [f]
    rw [h_num_eq, h_eq_y, h_sym_xy]
    ring
  have h_int_L : ∫ x in Set.Iic y, f x = F_L y - 0 := by
    apply MeasureTheory.integral_Iic_of_hasDerivAt_of_tendsto
    · exact (hF_L_deriv y Set.right_mem_Iic).continuousAt.continuousWithinAt
    · exact fun x hx => hF_L_deriv x (Set.Iio_subset_Iic_self hx)
    · exact (h_int y).integrableOn
    · exact (h_tend_F y).1
  have h_int_R : ∫ x in Set.Ioi y, f x = 0 - F_R y := by
    apply MeasureTheory.integral_Ioi_of_hasDerivAt_of_tendsto
    · exact (hF_R_deriv y Set.left_mem_Ici).continuousAt.continuousWithinAt
    · exact fun x hx => hF_R_deriv x (Set.Ioi_subset_Ici_self hx)
    · exact (h_int y).integrableOn
    · exact (h_tend_F y).2
  have h_split : (∫ x : ℝ, f x) = (∫ x in Set.Iic y, f x) + (∫ x in Set.Ioi y, f x) := by
    rw [← Set.compl_Iic]
    exact (MeasureTheory.integral_add_compl measurableSet_Iic (h_int y)).symm
  change (∫ x : ℝ, f x) = diagGreen κ w y
  rw [h_split, h_int_L, h_int_R]
  dsimp [F_L, F_R]
  have h_gy_L : greenKernelLeft κ w y y = diagGreen κ w y := (h_eq_LR y y).1 le_rfl
  have h_gy_R : greenKernelRight κ w y y = diagGreen κ w y := (h_eq_LR y y).2 le_rfl
  have h_gy_ne : diagGreen κ w y ≠ 0 := ne_of_gt (h_diag_pos y)
  rw [h_gy_L, h_gy_R]
  field_simp
  ring

theorem integral_rhoDerivDensity_eq_of_weyl_identity : ∃ δ_fub : ℝ, 0 < δ_fub ∧
      ∀ (κ : ℝ), 1 ≤ κ → ∀ (w v : 𝓢(ℝ, ℝ)), ‖ι w‖ ≤ δ_fub →
        (∀ y : ℝ, ∫ x : ℝ, (greenKernel κ w x y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2) =
          diagGreen κ w y) →
        ∫ x : ℝ, rhoDerivDensity κ w v x =
          ∫ x : ℝ, (1 / (2 * κ) - diagGreen κ w x) * v x :=
by
  refine ⟨1 / 4, by norm_num, ?_⟩
  intro κ hκ w v hw h_weyl
  have hκ_pos : 0 < κ := by linarith
  have hκ_ne : κ ≠ 0 := ne_of_gt hκ_pos
  have h_schwartz_bound : ∀ (f : 𝓢(ℝ, ℝ)),
      ∃ M : ℝ, 0 ≤ M ∧ ∀ y : ℝ, |f y| ≤ M * ((1 + y ^ 2)⁻¹) ^ 2 := by
    intro f
    let M : ℝ := 2 * ((SchwartzMap.seminorm ℝ 0 0) f + (SchwartzMap.seminorm ℝ 4 0) f)
    have hM_nn : 0 ≤ M := by
      dsimp [M]
      have h0 : 0 ≤ (SchwartzMap.seminorm ℝ 0 0) f := apply_nonneg _ _
      have h4 : 0 ≤ (SchwartzMap.seminorm ℝ 4 0) f := apply_nonneg _ _
      linarith
    refine ⟨M, hM_nn, fun y => ?_⟩
    set D : ℝ := |f y|
    have hD_nn : 0 ≤ D := abs_nonneg _
    have h0 := SchwartzMap.le_seminorm' ℝ 0 0 f y
    rw [pow_zero, one_mul, iteratedDeriv_zero, Real.norm_eq_abs] at h0
    have h4 := SchwartzMap.le_seminorm' ℝ 4 0 f y
    have hy4 : |y| ^ 4 = y ^ 4 := by
      calc |y| ^ 4 = (|y| ^ 2) ^ 2 := by ring
        _ = (y ^ 2) ^ 2 := by rw [sq_abs]
        _ = y ^ 4 := by ring
    rw [hy4, iteratedDeriv_zero, Real.norm_eq_abs] at h4
    have h_poly : (1 + y ^ 2) ^ 2 ≤ 2 * (1 + y ^ 4) := by
      nlinarith [sq_nonneg (1 - y ^ 2)]
    have h_mul : (1 + y ^ 2) ^ 2 * D ≤ M := by
      calc (1 + y ^ 2) ^ 2 * D
        _ ≤ (2 * (1 + y ^ 4)) * D := mul_le_mul_of_nonneg_right h_poly hD_nn
        _ = 2 * (D + y ^ 4 * D) := by ring
        _ ≤ 2 * ((SchwartzMap.seminorm ℝ 0 0) f + (SchwartzMap.seminorm ℝ 4 0) f) := by
          linarith [h0, h4]
        _ = M := rfl
    have h_ne : 1 + y ^ 2 ≠ 0 := ne_of_gt (by positivity)
    calc D = ((1 + y ^ 2) ^ 2 * D) * ((1 + y ^ 2)⁻¹) ^ 2 := by
          field_simp [h_ne]
      _ ≤ M * ((1 + y ^ 2)⁻¹) ^ 2 :=
          mul_le_mul_of_nonneg_right h_mul (by positivity)
  obtain ⟨M_w, hMw, hw_decay⟩ := h_schwartz_bound w
  obtain ⟨M_v, hMv, hv_decay⟩ := h_schwartz_bound v
  have h_pt : ∀ (ℓ : ℕ) (a b : ℝ), |greenIterKernel κ w ℓ a b| ≤ (1 / (2 * κ)) * (1 / 4) ^ ℓ := by
    intro ℓ a b
    exact le_trans (greenIterKernel_offDiag_pointwise_bound κ hκ w ℓ a b)
      (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) hw ℓ) (by positivity))
  have h_peetre : ∀ x y : ℝ,
      ((1 + y ^ 2)⁻¹) ^ 2 * Real.exp (-κ * |y - x|) ≤ 8 * (1 + x ^ 2)⁻¹ * (1 + y ^ 2)⁻¹ := by
    intro x y
    set t : ℝ := |y - x|
    have ht_nn : 0 ≤ t := abs_nonneg _
    have ht_sq : t ^ 2 = (y - x) ^ 2 := sq_abs (y - x)
    have h_exp_half : 1 + t / 2 ≤ Real.exp (t / 2) := by
      linarith [Real.add_one_le_exp (t / 2)]
    have h_exp_sq : (1 + t / 2) ^ 2 ≤ Real.exp (κ * t) := by
      have h1 : (1 + t / 2) ^ 2 ≤ Real.exp (t / 2) ^ 2 :=
        pow_le_pow_left₀ (by positivity) h_exp_half 2
      have h2 : Real.exp (t / 2) ^ 2 = Real.exp t := by
        rw [sq, ← Real.exp_add, add_halves]
      have h3 : Real.exp t ≤ Real.exp (κ * t) :=
        Real.exp_le_exp.mpr (le_mul_of_one_le_left ht_nn hκ)
      linarith
    have h_t_sq : 1 + t ^ 2 ≤ 4 * Real.exp (κ * t) := by
      have h_alg : 1 + t ^ 2 ≤ 4 * (1 + t / 2) ^ 2 := by nlinarith
      linarith
    have h_x_sq : 1 + x ^ 2 ≤ 2 * (1 + y ^ 2) * (1 + t ^ 2) := by
      nlinarith [sq_nonneg (2 * y - x), sq_nonneg (y - x), sq_nonneg (y * (y - x)), ht_sq]
    have h_x_exp : 1 + x ^ 2 ≤ 8 * (1 + y ^ 2) * Real.exp (κ * t) := by
      calc 1 + x ^ 2
        _ ≤ 2 * (1 + y ^ 2) * (1 + t ^ 2) := h_x_sq
        _ ≤ 2 * (1 + y ^ 2) * (4 * Real.exp (κ * t)) :=
          mul_le_mul_of_nonneg_left h_t_sq (by positivity)
        _ = 8 * (1 + y ^ 2) * Real.exp (κ * t) := by ring
    have h_prod_exp : (1 + x ^ 2) * Real.exp (-κ * t) ≤ 8 * (1 + y ^ 2) := by
      have h_cancel : Real.exp (κ * t) * Real.exp (-κ * t) = 1 := by
        rw [← Real.exp_add, show κ * t + -κ * t = 0 by ring, Real.exp_zero]
      calc (1 + x ^ 2) * Real.exp (-κ * t)
        _ ≤ (8 * (1 + y ^ 2) * Real.exp (κ * t)) * Real.exp (-κ * t) :=
          mul_le_mul_of_nonneg_right h_x_exp (Real.exp_nonneg _)
        _ = 8 * (1 + y ^ 2) * (Real.exp (κ * t) * Real.exp (-κ * t)) := by ring
        _ = 8 * (1 + y ^ 2) := by rw [h_cancel, mul_one]
    have hx_ne : 1 + x ^ 2 ≠ 0 := ne_of_gt (by positivity)
    have hy_ne : 1 + y ^ 2 ≠ 0 := ne_of_gt (by positivity)
    calc ((1 + y ^ 2)⁻¹) ^ 2 * Real.exp (-κ * t)
      _ = ((1 + x ^ 2) * Real.exp (-κ * t)) * ((1 + x ^ 2)⁻¹ * ((1 + y ^ 2)⁻¹) ^ 2) := by
        field_simp [hx_ne, hy_ne]
      _ ≤ (8 * (1 + y ^ 2)) * ((1 + x ^ 2)⁻¹ * ((1 + y ^ 2)⁻¹) ^ 2) :=
        mul_le_mul_of_nonneg_right h_prod_exp (by positivity)
      _ = 8 * (1 + x ^ 2)⁻¹ * (1 + y ^ 2)⁻¹ := by
        field_simp [hx_ne, hy_ne]
  have h_fg_cont : Continuous (fun p : ℝ × ℝ => freeGreenKernel κ p.1 p.2) := by
    dsimp [freeGreenKernel]; fun_prop
  have h_fg_pos : ∀ a b : ℝ, 0 ≤ freeGreenKernel κ a b := by
    intro a b; dsimp [freeGreenKernel]; positivity
  have h_fg_bound : ∀ a b : ℝ, |freeGreenKernel κ a b| ≤ 1 / (2 * κ) := by
    intro a b
    dsimp [freeGreenKernel]
    rw [abs_mul, abs_of_pos (by positivity : 0 < 1 / (2 * κ)), abs_of_pos (Real.exp_pos _)]
    exact mul_le_of_le_one_right (by positivity)
      (Real.exp_le_one_iff.mpr (by nlinarith [abs_nonneg (a - b)]))
  have h_iter_cont : ∀ ℓ : ℕ, Continuous (fun p : ℝ × ℝ => greenIterKernel κ w ℓ p.1 p.2) := by
    intro ℓ
    induction ℓ with
    | zero => exact h_fg_cont
    | succ ℓ ih =>
      let F : ℝ × ℝ → ℝ → ℝ := fun p z => greenIterKernel κ w ℓ p.1 z * w z * freeGreenKernel κ z p.2
      let bound : ℝ → ℝ := fun z => ((1 / (2 * κ)) * (1 / 4) ^ ℓ * (1 / (2 * κ))) * ‖w z‖
      have h_bound_int : Integrable bound volume := w.integrable.norm.const_mul _
      have hF_meas : ∀ p : ℝ × ℝ, AEStronglyMeasurable (F p) volume := by
        intro p
        have h_c1 : Continuous (fun z : ℝ => greenIterKernel κ w ℓ p.1 z) :=
          ih.comp (continuous_const.prodMk continuous_id)
        have h_c2 : Continuous (fun z : ℝ => freeGreenKernel κ z p.2) :=
          h_fg_cont.comp (continuous_id.prodMk continuous_const)
        exact ((h_c1.mul w.continuous).mul h_c2).aestronglyMeasurable
      have hF_dom : ∀ p : ℝ × ℝ, ∀ᵐ z : ℝ ∂volume, ‖F p z‖ ≤ bound z := by
        intro p
        filter_upwards with z
        dsimp [F, bound]
        rw [abs_mul, abs_mul]
        have h1 := h_pt ℓ p.1 z
        have h2 := h_fg_bound z p.2
        calc |greenIterKernel κ w ℓ p.1 z| * |w z| * |freeGreenKernel κ z p.2|
          _ = (|greenIterKernel κ w ℓ p.1 z| * |freeGreenKernel κ z p.2|) * |w z| := by ring
          _ ≤ ((1 / (2 * κ)) * (1 / 4) ^ ℓ * (1 / (2 * κ))) * |w z| :=
            mul_le_mul_of_nonneg_right (mul_le_mul h1 h2 (abs_nonneg _) (by positivity)) (abs_nonneg _)
      have hF_cont : ∀ᵐ z : ℝ ∂volume, Continuous (fun p : ℝ × ℝ => F p z) := by
        filter_upwards with z
        dsimp [F]
        have h_c1 : Continuous (fun p : ℝ × ℝ => greenIterKernel κ w ℓ p.1 z) :=
          ih.comp (continuous_fst.prodMk continuous_const)
        have h_c2 : Continuous (fun p : ℝ × ℝ => freeGreenKernel κ z p.2) :=
          h_fg_cont.comp (continuous_const.prodMk continuous_snd)
        exact (h_c1.mul continuous_const).mul h_c2
      exact (continuous_of_dominated hF_meas hF_dom h_bound_int hF_cont).neg
  have h_geom_sum : Summable (fun ℓ : ℕ => (1 / 4 : ℝ) ^ ℓ) :=
    summable_geometric_of_lt_one (by norm_num) (by norm_num)
  have h_geom_tsum : (∑' ℓ : ℕ, (1 / 4 : ℝ) ^ ℓ) = 4 / 3 := by
    rw [tsum_geometric_of_lt_one (by norm_num) (by norm_num)]
    norm_num
  let u_geom : ℕ → ℝ := fun ℓ => (1 / (2 * κ)) * (1 / 4 : ℝ) ^ ℓ
  have hu_sum : Summable u_geom := h_geom_sum.mul_left (1 / (2 * κ))
  have hu_tsum : (∑' ℓ : ℕ, u_geom ℓ) = 2 / (3 * κ) := by
    calc ∑' ℓ : ℕ, u_geom ℓ
      _ = (1 / (2 * κ)) * ∑' ℓ : ℕ, (1 / 4 : ℝ) ^ ℓ := tsum_mul_left
      _ = (1 / (2 * κ)) * (4 / 3) := by rw [h_geom_tsum]
      _ = 2 / (3 * κ) := by ring
  have hG_cont : Continuous (fun p : ℝ × ℝ => greenKernel κ w p.1 p.2) :=
    continuous_tsum h_iter_cont hu_sum (fun ℓ p => by rw [Real.norm_eq_abs]; exact h_pt ℓ p.1 p.2)
  have hg_cont : Continuous (diagGreen κ w) :=
    hG_cont.comp (continuous_id.prodMk continuous_id)
  have h_iter_sum : ∀ a b : ℝ, Summable (fun ℓ : ℕ => greenIterKernel κ w ℓ a b) :=
    fun a b => Summable.of_norm_bounded hu_sum (fun ℓ => by rw [Real.norm_eq_abs]; exact h_pt ℓ a b)
  have hG_le : ∀ x y : ℝ, |greenKernel κ w x y| ≤ 1 / κ := by
    intro x y
    calc |greenKernel κ w x y|
      _ = ‖∑' ℓ : ℕ, greenIterKernel κ w ℓ x y‖ := by rw [Real.norm_eq_abs]; rfl
      _ ≤ ∑' ℓ : ℕ, ‖greenIterKernel κ w ℓ x y‖ :=
        norm_tsum_le_tsum_norm (h_iter_sum x y).norm
      _ ≤ ∑' ℓ : ℕ, u_geom ℓ :=
        Summable.tsum_le_tsum (fun ℓ => by rw [Real.norm_eq_abs]; exact h_pt ℓ x y)
          (h_iter_sum x y).norm hu_sum
      _ = 2 / (3 * κ) := hu_tsum
      _ ≤ 1 / κ := by
        have h_diff : 1 / κ - 2 / (3 * κ) = 1 / (3 * κ) := by field_simp [hκ_ne]; ring
        have : 0 ≤ 1 / (3 * κ) := by positivity
        linarith
  have h_peel_eq : ∀ a b : ℝ,
      greenKernel κ w a b - freeGreenKernel κ a b = ∑' m : ℕ, greenIterKernel κ w (m + 1) a b := by
    intro a b
    have h0 := (h_iter_sum a b).tsum_eq_zero_add
    change greenKernel κ w a b = freeGreenKernel κ a b + ∑' m : ℕ, greenIterKernel κ w (m + 1) a b at h0
    linarith
  have h_fg_diag : ∀ x : ℝ, freeGreenKernel κ x x = 1 / (2 * κ) := by
    intro x
    dsimp [freeGreenKernel]
    rw [sub_self, abs_zero, mul_zero, Real.exp_zero, mul_one]
  have hg_ge : ∀ x : ℝ, 1 / (4 * κ) ≤ diagGreen κ w x := by
    intro x
    have h_tail_sum : Summable (fun m : ℕ => u_geom (m + 1)) := by
      change Summable (fun m : ℕ => (1 / (2 * κ)) * (1 / 4 : ℝ) ^ (m + 1))
      have h_eq : (fun m : ℕ => (1 / (2 * κ)) * (1 / 4 : ℝ) ^ (m + 1)) =
          (fun m : ℕ => ((1 / (2 * κ)) * (1 / 4)) * (1 / 4 : ℝ) ^ m) := by
        ext m; ring
      rw [h_eq]
      exact h_geom_sum.mul_left _
    have h_tail_bound : |diagGreen κ w x - 1 / (2 * κ)| ≤ 1 / (6 * κ) := by
      have h_sub_eq : diagGreen κ w x - 1 / (2 * κ) = ∑' m : ℕ, greenIterKernel κ w (m + 1) x x := by
        rw [← h_fg_diag x]
        exact h_peel_eq x x
      have h_sum_m : Summable (fun m : ℕ => greenIterKernel κ w (m + 1) x x) :=
        Summable.of_norm_bounded h_tail_sum (fun m => by rw [Real.norm_eq_abs]; exact h_pt (m + 1) x x)
      calc |diagGreen κ w x - 1 / (2 * κ)|
        _ = ‖∑' m : ℕ, greenIterKernel κ w (m + 1) x x‖ := by rw [h_sub_eq, Real.norm_eq_abs]
        _ ≤ ∑' m : ℕ, ‖greenIterKernel κ w (m + 1) x x‖ := norm_tsum_le_tsum_norm h_sum_m.norm
        _ ≤ ∑' m : ℕ, ((1 / (2 * κ)) * (1 / 4)) * (1 / 4 : ℝ) ^ m := by
          refine Summable.tsum_le_tsum (fun m => ?_) h_sum_m.norm (h_geom_sum.mul_left _)
          rw [Real.norm_eq_abs]
          calc |greenIterKernel κ w (m + 1) x x|
            _ ≤ (1 / (2 * κ)) * (1 / 4 : ℝ) ^ (m + 1) := h_pt (m + 1) x x
            _ = ((1 / (2 * κ)) * (1 / 4)) * (1 / 4 : ℝ) ^ m := by ring
        _ = ((1 / (2 * κ)) * (1 / 4)) * ∑' m : ℕ, (1 / 4 : ℝ) ^ m := tsum_mul_left
        _ = ((1 / (2 * κ)) * (1 / 4)) * (4 / 3) := by rw [h_geom_tsum]
        _ = 1 / (6 * κ) := by ring
    have h_low := (abs_le.mp h_tail_bound).1
    have h_diff : 1 / (2 * κ) - 1 / (6 * κ) - 1 / (4 * κ) = 1 / (12 * κ) := by
      field_simp [hκ_ne]; ring
    have : 0 ≤ 1 / (12 * κ) := by positivity
    linarith
  have h_peel_step : ∀ (m : ℕ) (y x : ℝ),
      |greenIterKernel κ w (m + 1) y x| ≤
        ((2 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹) * (1 / 4 : ℝ) ^ m := by
    intro m y x
    dsimp [greenIterKernel]
    rw [abs_neg]
    let F : ℝ → ℝ := fun z => greenIterKernel κ w m y z * w z * freeGreenKernel κ z x
    set C_mx : ℝ := (2 * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹ * (1 / 4 : ℝ) ^ m
    have hF_cont : Continuous F := by
      dsimp [F]
      have h1 : Continuous (fun z : ℝ => greenIterKernel κ w m y z) :=
        (h_iter_cont m).comp (continuous_const.prodMk continuous_id)
      have h2 : Continuous (fun z : ℝ => freeGreenKernel κ z x) :=
        h_fg_cont.comp (continuous_id.prodMk continuous_const)
      exact (h1.mul w.continuous).mul h2
    have hF_pw : ∀ z : ℝ, ‖F z‖ ≤ C_mx * (1 + z ^ 2)⁻¹ := by
      intro z
      dsimp [F]
      rw [abs_mul, abs_mul]
      have h1 := h_pt m y z
      have h2 := hw_decay z
      have h3 : |freeGreenKernel κ z x| = (1 / (2 * κ)) * Real.exp (-κ * |z - x|) := by
        dsimp [freeGreenKernel]
        rw [abs_mul, abs_of_pos (by positivity : 0 < 1 / (2 * κ)), abs_of_pos (Real.exp_pos _)]
      have h_prod12 : |greenIterKernel κ w m y z| * |w z| ≤
          ((1 / (2 * κ)) * (1 / 4 : ℝ) ^ m) * (M_w * ((1 + z ^ 2)⁻¹) ^ 2) :=
        mul_le_mul h1 h2 (abs_nonneg _) (by positivity)
      calc |greenIterKernel κ w m y z| * |w z| * |freeGreenKernel κ z x|
        _ = (|greenIterKernel κ w m y z| * |w z|) * ((1 / (2 * κ)) * Real.exp (-κ * |z - x|)) := by
          rw [h3]
        _ ≤ (((1 / (2 * κ)) * (1 / 4 : ℝ) ^ m) * (M_w * ((1 + z ^ 2)⁻¹) ^ 2)) *
            ((1 / (2 * κ)) * Real.exp (-κ * |z - x|)) :=
          mul_le_mul_of_nonneg_right h_prod12 (by positivity)
        _ = ((M_w / (4 * κ ^ 2)) * (1 / 4 : ℝ) ^ m) * (((1 + z ^ 2)⁻¹) ^ 2 * Real.exp (-κ * |z - x|)) := by
          ring
        _ ≤ ((M_w / (4 * κ ^ 2)) * (1 / 4 : ℝ) ^ m) * (8 * (1 + x ^ 2)⁻¹ * (1 + z ^ 2)⁻¹) :=
          mul_le_mul_of_nonneg_left (h_peetre x z) (by positivity)
        _ = C_mx * (1 + z ^ 2)⁻¹ := by dsimp [C_mx]; ring
    have h_dom_int : Integrable (fun z : ℝ => C_mx * (1 + z ^ 2)⁻¹) volume :=
      integrable_inv_one_add_sq.const_mul C_mx
    have hF_int : Integrable F volume :=
      h_dom_int.mono' hF_cont.aestronglyMeasurable (Filter.Eventually.of_forall hF_pw)
    calc |∫ z : ℝ, F z|
      _ ≤ ∫ z : ℝ, ‖F z‖ := by simpa [Real.norm_eq_abs] using norm_integral_le_integral_norm F
      _ ≤ ∫ z : ℝ, C_mx * (1 + z ^ 2)⁻¹ := integral_mono hF_int.norm h_dom_int hF_pw
      _ = C_mx * ∫ z : ℝ, (1 + z ^ 2)⁻¹ := integral_const_mul C_mx _
      _ = C_mx * π := by rw [integral_univ_inv_one_add_sq]
      _ = ((2 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹) * (1 / 4 : ℝ) ^ m := by dsimp [C_mx]; ring
  have hG_peel : ∀ x y : ℝ,
      |greenKernel κ w y x| ≤ (1 / (2 * κ)) * Real.exp (-κ * |y - x|) + (4 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹ := by
    intro x y
    set B_x : ℝ := (2 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹
    have hB_nn : 0 ≤ B_x := by dsimp [B_x]; positivity
    have h_sum_m : Summable (fun m : ℕ => greenIterKernel κ w (m + 1) y x) :=
      Summable.of_norm_bounded (h_geom_sum.mul_left B_x)
        (fun m => by rw [Real.norm_eq_abs]; exact h_peel_step m y x)
    have h_peel_sum : |greenKernel κ w y x - freeGreenKernel κ y x| ≤ (4 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹ := by
      calc |greenKernel κ w y x - freeGreenKernel κ y x|
        _ = ‖∑' m : ℕ, greenIterKernel κ w (m + 1) y x‖ := by rw [h_peel_eq y x, Real.norm_eq_abs]
        _ ≤ ∑' m : ℕ, ‖greenIterKernel κ w (m + 1) y x‖ := norm_tsum_le_tsum_norm h_sum_m.norm
        _ ≤ ∑' m : ℕ, B_x * (1 / 4 : ℝ) ^ m :=
          Summable.tsum_le_tsum (fun m => by rw [Real.norm_eq_abs]; exact h_peel_step m y x)
            h_sum_m.norm (h_geom_sum.mul_left B_x)
        _ = B_x * ∑' m : ℕ, (1 / 4 : ℝ) ^ m := tsum_mul_left
        _ = B_x * (4 / 3) := by rw [h_geom_tsum]
        _ ≤ B_x * 2 := mul_le_mul_of_nonneg_left (by norm_num) hB_nn
        _ = (4 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹ := by dsimp [B_x]; ring
    have h_tri : |greenKernel κ w y x| ≤
        |freeGreenKernel κ y x| + |greenKernel κ w y x - freeGreenKernel κ y x| := by
      have h_id : greenKernel κ w y x =
          freeGreenKernel κ y x + (greenKernel κ w y x - freeGreenKernel κ y x) := by ring
      calc |greenKernel κ w y x|
        _ = |freeGreenKernel κ y x + (greenKernel κ w y x - freeGreenKernel κ y x)| :=
          congr_arg abs h_id
        _ ≤ |freeGreenKernel κ y x| + |greenKernel κ w y x - freeGreenKernel κ y x| :=
          abs_add_le _ _
    have h_fg_eq : |freeGreenKernel κ y x| = (1 / (2 * κ)) * Real.exp (-κ * |y - x|) :=
      abs_of_nonneg (h_fg_pos y x)
    linarith [h_peel_sum]
  have h_exp_two_kappa_int : ∀ y : ℝ, ∫ x : ℝ, Real.exp (-2 * κ * |x - y|) = 1 / κ := by
    intro y
    set b : ℝ := 2 * κ
    have hb_pos : 0 < b := by positivity
    have hb_ne : b ≠ 0 := ne_of_gt hb_pos
    let F : ℝ → ℝ := fun u => -Real.exp (-b * u) / b
    have hF_cont : ContinuousWithinAt F (Set.Ici 0) 0 := by
      dsimp [F]; fun_prop
    have hF_deriv : ∀ u ∈ Set.Ioi (0 : ℝ), HasDerivAt F (Real.exp (-b * u)) u := by
      intro u _
      have h1 : HasDerivAt (fun u : ℝ => -b * u) (-b) u := by
        simpa using (hasDerivAt_id u).const_mul (-b)
      have h2 : HasDerivAt (fun u : ℝ => Real.exp (-b * u)) (Real.exp (-b * u) * (-b)) u :=
        h1.exp
      have h3 : HasDerivAt F (-(Real.exp (-b * u) * (-b)) / b) u :=
        (h2.neg).div_const b
      refine h3.congr_deriv ?_
      field_simp [hb_ne]
    have h_int_Ioi_b : IntegrableOn (fun u : ℝ => Real.exp (-b * u)) (Set.Ioi 0) volume :=
      exp_neg_integrableOn_Ioi 0 hb_pos
    have hF_tendsto : Filter.Tendsto F Filter.atTop (nhds 0) := by
      have h1 : Filter.Tendsto (fun u : ℝ => b * u) Filter.atTop Filter.atTop :=
        Filter.Tendsto.const_mul_atTop hb_pos Filter.tendsto_id
      have h2 : Filter.Tendsto (fun u : ℝ => -b * u) Filter.atTop Filter.atBot := by
        have h_eq : (fun u : ℝ => -b * u) = (fun u : ℝ => -(b * u)) := by ext u; ring
        rw [h_eq]
        exact Filter.tendsto_neg_atTop_atBot.comp h1
      have h3 : Filter.Tendsto (fun u : ℝ => Real.exp (-b * u)) Filter.atTop (nhds 0) :=
        Real.tendsto_exp_atBot.comp h2
      have h4 : Filter.Tendsto F Filter.atTop (nhds (-0 / b)) :=
        (h3.neg).div_const b
      simpa using h4
    have h_Ioi_val : (∫ u in Set.Ioi (0 : ℝ), Real.exp (-b * u)) = 1 / (2 * κ) := by
      rw [integral_Ioi_of_hasDerivAt_of_tendsto hF_cont hF_deriv h_int_Ioi_b hF_tendsto]
      dsimp [F, b]
      rw [mul_zero, Real.exp_zero]
      ring
    let g0 : ℝ → ℝ := fun u => Real.exp (-b * |u|)
    have hg0_eq_Ioi : Set.EqOn g0 (fun u : ℝ => Real.exp (-b * u)) (Set.Ioi 0) := by
      intro u hu
      dsimp [g0]
      rw [abs_of_pos hu]
    have hg0_int_Ioi : IntegrableOn g0 (Set.Ioi 0) volume :=
      h_int_Ioi_b.congr_fun hg0_eq_Ioi.symm measurableSet_Ioi
    have h_Ioi_g0 : (∫ u in Set.Ioi (0 : ℝ), g0 u) = 1 / (2 * κ) := by
      rw [setIntegral_congr_fun measurableSet_Ioi hg0_eq_Ioi]
      exact h_Ioi_val
    have hg0_int_Ici : IntegrableOn g0 (Set.Ici 0) volume := by
      rwa [integrableOn_Ici_iff_integrableOn_Ioi]
    have hg0_even : ∀ u : ℝ, g0 (-u) = g0 u := by
      intro u; dsimp [g0]; rw [abs_neg]
    have hg0_int_Iic : IntegrableOn g0 (Set.Iic 0) volume := by
      have h_comp := hg0_int_Ici.comp_neg
      simpa [hg0_even] using h_comp
    have h_Iic_g0 : (∫ u in Set.Iic (0 : ℝ), g0 u) = 1 / (2 * κ) := by
      have h_neg := integral_comp_neg_Iic (0 : ℝ) g0
      simp only [neg_zero, hg0_even] at h_neg
      rw [h_neg, h_Ioi_g0]
    have h_univ_g0 : (∫ u : ℝ, g0 u) = 1 / κ := by
      rw [← intervalIntegral.integral_Iic_add_Ioi hg0_int_Iic hg0_int_Ioi, h_Iic_g0, h_Ioi_g0]
      field_simp [hκ_ne]
      ring
    have h_shift : (∫ x : ℝ, g0 (x - y)) = ∫ u : ℝ, g0 u :=
      integral_sub_right_eq_self g0 y
    have h_fun_eq : (fun x : ℝ => Real.exp (-2 * κ * |x - y|)) = (fun x : ℝ => g0 (x - y)) := by
      ext x; dsimp [g0, b]; ring_nf
    rw [h_fun_eq, h_shift, h_univ_g0]
  let F2 : ℝ → ℝ → ℝ := fun x y => (1 / 2) * (Real.exp (-2 * κ * |x - y|) * v y)
  have hF2_cont : Continuous (Function.uncurry F2) := by
    have : Function.uncurry F2 = fun p : ℝ × ℝ => (1 / 2) * (Real.exp (-2 * κ * |p.1 - p.2|) * v p.2) := rfl
    rw [this]
    have := v.continuous
    fun_prop
  have hF2_pw : ∀ p : ℝ × ℝ, ‖Function.uncurry F2 p‖ ≤ ((4 * M_v) * (1 + p.1 ^ 2)⁻¹) * (1 + p.2 ^ 2)⁻¹ := by
    intro ⟨x, y⟩
    change |(1 / 2) * (Real.exp (-2 * κ * |x - y|) * v y)| ≤ ((4 * M_v) * (1 + x ^ 2)⁻¹) * (1 + y ^ 2)⁻¹
    rw [abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2), abs_of_pos (Real.exp_pos _)]
    have h_exp_le : Real.exp (-2 * κ * |x - y|) ≤ Real.exp (-κ * |y - x|) := by
      rw [abs_sub_comm x y]
      exact Real.exp_le_exp.mpr (by nlinarith [abs_nonneg (y - x)])
    have h_prod : Real.exp (-2 * κ * |x - y|) * |v y| ≤
        Real.exp (-κ * |y - x|) * (M_v * ((1 + y ^ 2)⁻¹) ^ 2) :=
      mul_le_mul h_exp_le (hv_decay y) (abs_nonneg _) (Real.exp_nonneg _)
    calc (1 / 2) * (Real.exp (-2 * κ * |x - y|) * |v y|)
      _ ≤ (1 / 2) * (Real.exp (-κ * |y - x|) * (M_v * ((1 + y ^ 2)⁻¹) ^ 2)) :=
        mul_le_mul_of_nonneg_left h_prod (by norm_num)
      _ = ((1 / 2) * M_v) * (((1 + y ^ 2)⁻¹) ^ 2 * Real.exp (-κ * |y - x|)) := by ring
      _ ≤ ((1 / 2) * M_v) * (8 * (1 + x ^ 2)⁻¹ * (1 + y ^ 2)⁻¹) :=
        mul_le_mul_of_nonneg_left (h_peetre x y) (by positivity)
      _ = ((4 * M_v) * (1 + x ^ 2)⁻¹) * (1 + y ^ 2)⁻¹ := by ring
  have h_dom2 : Integrable (fun p : ℝ × ℝ => ((4 * M_v) * (1 + p.1 ^ 2)⁻¹) * (1 + p.2 ^ 2)⁻¹) (volume.prod volume) :=
    (integrable_inv_one_add_sq.const_mul (4 * M_v)).mul_prod integrable_inv_one_add_sq
  have hF2_int : Integrable (Function.uncurry F2) (volume.prod volume) :=
    h_dom2.mono' hF2_cont.aestronglyMeasurable (Filter.Eventually.of_forall hF2_pw)
  have h_pull2_eq : (fun x : ℝ => (1 / 2) * ∫ y : ℝ, Real.exp (-2 * κ * |x - y|) * v y) =
      (fun x : ℝ => ∫ y : ℝ, F2 x y) := by
    ext x
    dsimp [F2]
    rw [← integral_const_mul]
  have hT2_int : Integrable (fun x : ℝ => (1 / 2) * ∫ y : ℝ, Real.exp (-2 * κ * |x - y|) * v y) volume := by
    rw [h_pull2_eq]
    exact hF2_int.integral_prod_left
  have hT2_eq : (∫ x : ℝ, (1 / 2) * ∫ y : ℝ, Real.exp (-2 * κ * |x - y|) * v y) =
      ∫ x : ℝ, (1 / (2 * κ)) * v x := by
    rw [h_pull2_eq, integral_integral_swap hF2_int]
    refine integral_congr_ae (Filter.Eventually.of_forall (fun y => ?_))
    have h_inner : (fun x : ℝ => F2 x y) = (fun x : ℝ => ((1 / 2) * v y) * Real.exp (-2 * κ * |x - y|)) := by
      ext x; dsimp [F2]; ring
    dsimp only
    rw [h_inner, integral_const_mul, h_exp_two_kappa_int y]
    ring
  have hg_pos : ∀ x : ℝ, 0 < diagGreen κ w x :=
    fun x => lt_of_lt_of_le (by positivity) (hg_ge x)
  have h2gsq_ne : ∀ x : ℝ, 2 * (diagGreen κ w x) ^ 2 ≠ 0 :=
    fun x => ne_of_gt (mul_pos two_pos (sq_pos_of_pos (hg_pos x)))
  let F1 : ℝ → ℝ → ℝ := fun x y =>
    ((greenKernel κ w x y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2)) * v y
  have hF1_cont : Continuous (Function.uncurry F1) := by
    have : Function.uncurry F1 = fun p : ℝ × ℝ =>
      ((greenKernel κ w p.1 p.2 * greenKernel κ w p.2 p.1) / (2 * (diagGreen κ w p.1) ^ 2)) * v p.2 := rfl
    rw [this]
    have hG_swap : Continuous (fun p : ℝ × ℝ => greenKernel κ w p.2 p.1) :=
      hG_cont.comp (continuous_snd.prodMk continuous_fst)
    have hg_p1 : Continuous (fun p : ℝ × ℝ => 2 * (diagGreen κ w p.1) ^ 2) :=
      continuous_const.mul ((hg_cont.comp continuous_fst).pow 2)
    have hv_p2 : Continuous (fun p : ℝ × ℝ => v p.2) := v.continuous.comp continuous_snd
    exact (((hG_cont.mul hG_swap).div hg_p1 (fun p => h2gsq_ne p.1)).mul hv_p2)
  set C_wv : ℝ := 32 * M_v + 32 * π * M_w * M_v
  have hF1_pw : ∀ p : ℝ × ℝ, ‖Function.uncurry F1 p‖ ≤ (C_wv * (1 + p.1 ^ 2)⁻¹) * (1 + p.2 ^ 2)⁻¹ := by
    intro ⟨x, y⟩
    change |((greenKernel κ w x y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2)) * v y| ≤
      (C_wv * (1 + x ^ 2)⁻¹) * (1 + y ^ 2)⁻¹
    rw [abs_mul, abs_div, abs_mul, abs_of_pos (mul_pos two_pos (sq_pos_of_pos (hg_pos x)))]
    have h_denom : 1 / (2 * (diagGreen κ w x) ^ 2) ≤ 8 * κ ^ 2 := by
      have h_sq : (1 / (4 * κ)) ^ 2 ≤ (diagGreen κ w x) ^ 2 :=
        pow_le_pow_left₀ (by positivity) (hg_ge x) 2
      have h1 : 1 / (2 * (diagGreen κ w x) ^ 2) ≤ 1 / (2 * (1 / (4 * κ)) ^ 2) :=
        one_div_le_one_div_of_le (by positivity) (mul_le_mul_of_nonneg_left h_sq zero_le_two)
      have h2 : 1 / (2 * (1 / (4 * κ)) ^ 2) = 8 * κ ^ 2 := by field_simp [hκ_ne]; ring
      linarith
    have h_G_prod : |greenKernel κ w x y| * |greenKernel κ w y x| ≤
        (1 / κ) * ((1 / (2 * κ)) * Real.exp (-κ * |y - x|) + (4 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹) :=
      mul_le_mul (hG_le x y) (hG_peel x y) (abs_nonneg _) (by positivity)
    have h_quot : (|greenKernel κ w x y| * |greenKernel κ w y x|) / (2 * (diagGreen κ w x) ^ 2) ≤
        4 * Real.exp (-κ * |y - x|) + 32 * π * M_w * (1 + x ^ 2)⁻¹ := by
      calc (|greenKernel κ w x y| * |greenKernel κ w y x|) / (2 * (diagGreen κ w x) ^ 2)
        _ = (|greenKernel κ w x y| * |greenKernel κ w y x|) * (1 / (2 * (diagGreen κ w x) ^ 2)) := by ring
        _ ≤ ((1 / κ) * ((1 / (2 * κ)) * Real.exp (-κ * |y - x|) + (4 * π * M_w / κ ^ 2) * (1 + x ^ 2)⁻¹)) *
            (8 * κ ^ 2) :=
          mul_le_mul h_G_prod h_denom (by positivity) (by positivity)
        _ = 4 * Real.exp (-κ * |y - x|) + (32 * π * M_w / κ) * (1 + x ^ 2)⁻¹ := by
          field_simp [hκ_ne]; ring
        _ ≤ 4 * Real.exp (-κ * |y - x|) + 32 * π * M_w * (1 + x ^ 2)⁻¹ := by
          have h_div_le : 32 * π * M_w / κ ≤ 32 * π * M_w :=
            div_le_self (by positivity) hκ
          have h_term : (32 * π * M_w / κ) * (1 + x ^ 2)⁻¹ ≤ 32 * π * M_w * (1 + x ^ 2)⁻¹ :=
            mul_le_mul_of_nonneg_right h_div_le (by positivity)
          linarith
    have h_inv_sq_le : ((1 + y ^ 2)⁻¹) ^ 2 ≤ (1 + y ^ 2)⁻¹ := by
      have h_inv_le_one : (1 + y ^ 2)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by nlinarith [sq_nonneg y])
      calc ((1 + y ^ 2)⁻¹) ^ 2 = (1 + y ^ 2)⁻¹ * (1 + y ^ 2)⁻¹ := sq _
        _ ≤ 1 * (1 + y ^ 2)⁻¹ := mul_le_mul_of_nonneg_right h_inv_le_one (by positivity)
        _ = (1 + y ^ 2)⁻¹ := one_mul _
    calc ((|greenKernel κ w x y| * |greenKernel κ w y x|) / (2 * (diagGreen κ w x) ^ 2)) * |v y|
      _ ≤ (4 * Real.exp (-κ * |y - x|) + 32 * π * M_w * (1 + x ^ 2)⁻¹) * (M_v * ((1 + y ^ 2)⁻¹) ^ 2) :=
        mul_le_mul h_quot (hv_decay y) (abs_nonneg _) (by positivity)
      _ = (4 * M_v) * (((1 + y ^ 2)⁻¹) ^ 2 * Real.exp (-κ * |y - x|)) +
          (32 * π * M_w * M_v * (1 + x ^ 2)⁻¹) * ((1 + y ^ 2)⁻¹) ^ 2 := by ring
      _ ≤ (4 * M_v) * (8 * (1 + x ^ 2)⁻¹ * (1 + y ^ 2)⁻¹) +
          (32 * π * M_w * M_v * (1 + x ^ 2)⁻¹) * (1 + y ^ 2)⁻¹ :=
        add_le_add (mul_le_mul_of_nonneg_left (h_peetre x y) (by positivity))
          (mul_le_mul_of_nonneg_left h_inv_sq_le (by positivity))
      _ = (C_wv * (1 + x ^ 2)⁻¹) * (1 + y ^ 2)⁻¹ := by dsimp [C_wv]; ring
  have h_dom1 : Integrable (fun p : ℝ × ℝ => (C_wv * (1 + p.1 ^ 2)⁻¹) * (1 + p.2 ^ 2)⁻¹) (volume.prod volume) :=
    (integrable_inv_one_add_sq.const_mul C_wv).mul_prod integrable_inv_one_add_sq
  have hF1_int : Integrable (Function.uncurry F1) (volume.prod volume) :=
    h_dom1.mono' hF1_cont.aestronglyMeasurable (Filter.Eventually.of_forall hF1_pw)
  have h_pull1_eq : (fun x : ℝ => -(∫ y : ℝ, greenKernel κ w x y * v y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2)) =
      (fun x : ℝ => -∫ y : ℝ, F1 x y) := by
    ext x
    have h_inner_eq : (fun y : ℝ => (greenKernel κ w x y * v y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2)) =
        (fun y : ℝ => F1 x y) := by
      ext y; dsimp [F1]; ring
    rw [neg_div, ← integral_div, h_inner_eq]
  have hT1_int : Integrable (fun x : ℝ =>
      -(∫ y : ℝ, greenKernel κ w x y * v y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2)) volume := by
    rw [h_pull1_eq]
    exact hF1_int.integral_prod_left.neg
  have hgv_int : Integrable (fun x : ℝ => diagGreen κ w x * v x) volume := by
    refine (v.integrable.norm.const_mul (1 / κ)).mono' (hg_cont.mul v.continuous).aestronglyMeasurable ?_
    filter_upwards with x
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_mul_of_nonneg_right (hG_le x x) (abs_nonneg _)
  have hT1_eq : (∫ x : ℝ, -(∫ y : ℝ, greenKernel κ w x y * v y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2)) =
      -∫ x : ℝ, diagGreen κ w x * v x := by
    rw [h_pull1_eq, integral_neg, integral_integral_swap hF1_int]
    congr 1
    refine integral_congr_ae (Filter.Eventually.of_forall (fun y => ?_))
    dsimp [F1]
    rw [integral_mul_const, h_weyl y]
  have h_kv_int : Integrable (fun x : ℝ => (1 / (2 * κ)) * v x) volume :=
    v.integrable.const_mul (1 / (2 * κ))
  have h_rho_eq : (fun x : ℝ => rhoDerivDensity κ w v x) =
      (fun x : ℝ => (-(∫ y : ℝ, greenKernel κ w x y * v y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2)) +
        ((1 / 2) * ∫ y : ℝ, Real.exp (-2 * κ * |x - y|) * v y)) := rfl
  have h_rhs_eq : (fun x : ℝ => (1 / (2 * κ)) * v x - diagGreen κ w x * v x) =
      (fun x : ℝ => (1 / (2 * κ) - diagGreen κ w x) * v x) := by
    ext x; ring
  calc ∫ x : ℝ, rhoDerivDensity κ w v x
    _ = (∫ x : ℝ, -(∫ y : ℝ, greenKernel κ w x y * v y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2)) +
        (∫ x : ℝ, (1 / 2) * ∫ y : ℝ, Real.exp (-2 * κ * |x - y|) * v y) := by
      rw [h_rho_eq, integral_add hT1_int hT2_int]
    _ = -(∫ x : ℝ, diagGreen κ w x * v x) + (∫ x : ℝ, (1 / (2 * κ)) * v x) := by
      rw [hT1_eq, hT2_eq]
    _ = (∫ x : ℝ, (1 / (2 * κ)) * v x) - (∫ x : ℝ, diagGreen κ w x * v x) := by ring
    _ = ∫ x : ℝ, ((1 / (2 * κ)) * v x - diagGreen κ w x * v x) :=
      (integral_sub h_kv_int hgv_int).symm
    _ = ∫ x : ℝ, (1 / (2 * κ) - diagGreen κ w x) * v x := by rw [h_rhs_eq]

theorem alphaFunctional_hasDerivAt_kdv : ∃ δ₂ : ℝ, 0 < δ₂ ∧
      ∀ (u : ℝ → 𝓢(ℝ, ℝ)), IsSchwartzSolution u →
      ∀ (κ : ℝ), 1 ≤ κ → ∀ (s : ℝ), ‖ι (u s)‖ ≤ δ₂ →
        HasDerivAt (fun τ => alphaFunctional κ (u τ))
          (∫ x : ℝ, (1 / (2 * κ) - diagGreen κ (u s) x) * kdvRHS (u s) x) s :=
by
  obtain ⟨δ_pt, hδ_pt, h_pt⟩ := diagGreen_hasDerivAt_kdv
  obtain ⟨δ_dom, hδ_dom, h_dom⟩ := rhoDensity_dominated_loc_kdv
  obtain ⟨δ_weyl, hδ_weyl, h_weyl⟩ := greenKernel_sq_div_diagGreen_sq_integral
  obtain ⟨δ_fub, hδ_fub, h_fub⟩ := integral_rhoDerivDensity_eq_of_weyl_identity
  set δ₂ : ℝ := min (δ_pt / 2) (min δ_dom (min δ_weyl δ_fub))
  have hδ₂ : 0 < δ₂ := by positivity
  refine ⟨δ₂, hδ₂, ?_⟩
  intro u hu κ hκ s hs
  have hs_pt_half : ‖ι (u s)‖ ≤ δ_pt / 2 := le_trans hs (min_le_left _ _)
  have hs_dom : ‖ι (u s)‖ ≤ δ_dom :=
    le_trans hs (le_trans (min_le_right _ _) (min_le_left _ _))
  have hs_weyl : ‖ι (u s)‖ ≤ δ_weyl :=
    le_trans hs (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _)))
  have hs_fub : ‖ι (u s)‖ ≤ δ_fub :=
    le_trans hs (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _)))
  have h_rho_deriv : ∀ τ : ℝ, ‖ι (u τ)‖ ≤ δ_pt → ∀ x : ℝ,
      HasDerivAt (fun τ' => rhoDensity κ (u τ') x)
        (rhoDerivDensity κ (u τ) (kdvRHS (u τ)) x) τ := by
    intro τ hτ_pt x
    obtain ⟨hg_ne, hg_deriv⟩ := h_pt u hu κ hκ τ hτ_pt x
    have hconv_deriv := exp_conv_hasDerivAt_kdv u hu κ hκ τ x
    have h2g_ne : 2 * diagGreen κ (u τ) x ≠ 0 := mul_ne_zero two_ne_zero hg_ne
    have h2g_deriv : HasDerivAt (fun τ' => 2 * diagGreen κ (u τ') x)
        (2 * (-∫ y : ℝ, greenKernel κ (u τ) x y * kdvRHS (u τ) y * greenKernel κ (u τ) y x)) τ :=
      hg_deriv.const_mul 2
    have h_inv_deriv : HasDerivAt (fun τ' => (2 * diagGreen κ (u τ') x)⁻¹)
        (-(2 * (-∫ y : ℝ, greenKernel κ (u τ) x y * kdvRHS (u τ) y * greenKernel κ (u τ) y x)) /
          (2 * diagGreen κ (u τ) x) ^ 2) τ :=
      h2g_deriv.inv h2g_ne
    have h_sub_deriv : HasDerivAt (fun τ' => κ - 1 / (2 * diagGreen κ (u τ') x))
        (-(-(2 * (-∫ y : ℝ, greenKernel κ (u τ) x y * kdvRHS (u τ) y * greenKernel κ (u τ) y x)) /
          (2 * diagGreen κ (u τ) x) ^ 2)) τ := by
      simpa only [one_div] using h_inv_deriv.const_sub κ
    have h_sum_deriv := h_sub_deriv.add hconv_deriv
    refine h_sum_deriv.congr_deriv ?_
    dsimp [rhoDerivDensity]
    ring
  have h_cont_norm : Continuous (fun τ : ℝ => ‖ι (u τ)‖) :=
    (schwartz_solution_continuous_hm1 u hu).norm
  have hV₁_open : IsOpen {τ : ℝ | ‖ι (u τ)‖ < δ_pt} :=
    isOpen_lt h_cont_norm continuous_const
  have hs_in_V₁ : s ∈ {τ : ℝ | ‖ι (u τ)‖ < δ_pt} := by
    change ‖ι (u s)‖ < δ_pt
    linarith
  have hV₁_nhds : {τ : ℝ | ‖ι (u τ)‖ < δ_pt} ∈ nhds s :=
    hV₁_open.mem_nhds hs_in_V₁
  obtain ⟨V₂, bound, hV₂_nhds, h_meas_F, h_int_Fs, h_meas_F's, h_bound, h_int_bound⟩ :=
    h_dom u hu κ hκ s hs_dom
  set V : Set ℝ := {τ : ℝ | ‖ι (u τ)‖ < δ_pt} ∩ V₂
  have hV_nhds : V ∈ nhds s := Filter.inter_mem hV₁_nhds hV₂_nhds
  have hF_meas : ∀ᶠ τ in nhds s, AEStronglyMeasurable (fun x : ℝ => rhoDensity κ (u τ) x) volume :=
    Filter.mem_of_superset hV₂_nhds h_meas_F
  have h_bound_ae : ∀ᵐ x : ℝ ∂volume, ∀ τ ∈ V,
      ‖rhoDerivDensity κ (u τ) (kdvRHS (u τ)) x‖ ≤ bound x :=
    Filter.Eventually.of_forall (fun x τ hτ => h_bound x τ hτ.2)
  have h_deriv_ae : ∀ᵐ x : ℝ ∂volume, ∀ τ ∈ V,
      HasDerivAt (fun τ' => rhoDensity κ (u τ') x)
        (rhoDerivDensity κ (u τ) (kdvRHS (u τ)) x) τ :=
    Filter.Eventually.of_forall (fun x τ hτ => h_rho_deriv τ (le_of_lt hτ.1) x)
  have h_int_deriv := (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    hV_nhds hF_meas h_int_Fs h_meas_F's h_bound_ae h_int_bound h_deriv_ae).2
  obtain ⟨v, _, hv_eq⟩ := hu s
  have hv_fun : (v : ℝ → ℝ) = kdvRHS (u s) := funext hv_eq
  have h_int_eq : ∫ x : ℝ, rhoDerivDensity κ (u s) (kdvRHS (u s)) x =
      ∫ x : ℝ, (1 / (2 * κ) - diagGreen κ (u s) x) * kdvRHS (u s) x := by
    rw [← hv_fun]
    exact h_fub κ hκ (u s) v hs_fub (h_weyl κ hκ (u s) hs_weyl)
  exact h_int_deriv.congr_deriv h_int_eq

theorem shiftedGreenIter_smooth_and_leibniz_recurrence : ∀ (κ : ℝ), 1 ≤ κ → ∀ (w : 𝓢(ℝ, ℝ)),
    (∀ m : ℕ, ∀ u : ℝ, ContDiff ℝ (⊤ : ℕ∞) (fun x => shiftedGreenIter κ w m x u)) ∧
    (∀ x u : ℝ, shiftedGreenIterDeriv κ w 0 0 x u = freeGreenKernel κ 0 u) ∧
    (∀ n : ℕ, ∀ x u : ℝ, shiftedGreenIterDeriv κ w 0 (n + 1) x u = 0) ∧
    (∀ m n : ℕ, ∀ x u : ℝ,
      shiftedGreenIterDeriv κ w (m + 1) n x u =
        ∑ j ∈ Finset.range (n + 1), (Nat.choose n j : ℝ) *
          (-∫ v : ℝ, shiftedGreenIterDeriv κ w m j x v *
            ((SchwartzMap.derivCLM ℝ ℝ)^[n - j] w) (x + v) * freeGreenKernel κ v u)) :=
by
  intro κ hκ w
  have hκ_pos : 0 < κ := by linarith
  have h_fg_nonneg : ∀ v u : ℝ, 0 ≤ freeGreenKernel κ v u := by
    intro v u
    unfold freeGreenKernel
    positivity
  have h_fg_cont : ∀ u : ℝ, Continuous (fun v : ℝ => freeGreenKernel κ v u) := by
    intro u
    unfold freeGreenKernel
    fun_prop
  let f0 : ℝ → ℝ := fun v => Real.exp (-κ * |v|)
  have hf0_Ici : IntegrableOn f0 (Set.Ici 0) volume := by
    have h1 : IntegrableOn (fun v : ℝ => Real.exp (-κ * v)) (Set.Ioi (-1 : ℝ)) volume :=
      exp_neg_integrableOn_Ioi (-1 : ℝ) hκ_pos
    have h2 : IntegrableOn (fun v : ℝ => Real.exp (-κ * v)) (Set.Ici (0 : ℝ)) volume :=
      h1.mono_set (Set.Ici_subset_Ioi.mpr (by norm_num))
    refine h2.congr_fun (fun v hv => ?_) measurableSet_Ici
    dsimp [f0]
    rw [abs_of_nonneg hv]
  have hf0_Iic : IntegrableOn f0 (Set.Iic 0) volume := by
    have h1 : IntegrableOn (fun v : ℝ => f0 (-v)) (Set.Iic 0) volume := by
      have := hf0_Ici.comp_neg
      rwa [Set.neg_Ici, neg_zero] at this
    refine h1.congr_fun (fun v _ => ?_) measurableSet_Iic
    dsimp [f0]
    rw [abs_neg]
  have hf0_int : Integrable f0 volume := by
    rw [← integrableOn_univ, ← Set.Iic_union_Ioi (a := (0 : ℝ))]
    exact hf0_Iic.union (hf0_Ici.mono_set Set.Ioi_subset_Ici_self)
  have h_fg_int : ∀ u : ℝ, Integrable (fun v : ℝ => freeGreenKernel κ v u) volume := by
    intro u
    have h_eq : (fun v : ℝ => freeGreenKernel κ v u) = (fun v : ℝ => (1 / (2 * κ)) * f0 (v - u)) := by
      ext v; rfl
    rw [h_eq]
    exact (hf0_int.comp_sub_right u).const_mul (1 / (2 * κ))
  have h_shift0 : ∀ x u : ℝ, shiftedGreenIter κ w 0 x u = freeGreenKernel κ 0 u := by
    intro x u
    simp only [shiftedGreenIter, greenIterKernel, freeGreenKernel]
    have h_sub : x - (x + u) = 0 - u := by ring
    rw [h_sub]
  have h_base0 : ∀ x u : ℝ, shiftedGreenIterDeriv κ w 0 0 x u = freeGreenKernel κ 0 u := by
    intro x u
    unfold shiftedGreenIterDeriv
    rw [iteratedDeriv_zero]
    exact h_shift0 x u
  have h_base_succ : ∀ n : ℕ, ∀ x u : ℝ, shiftedGreenIterDeriv κ w 0 (n + 1) x u = 0 := by
    intro n x u
    unfold shiftedGreenIterDeriv
    have h_fn : (fun x' : ℝ => greenIterKernel κ w 0 x' (x' + u)) = (fun _ : ℝ => freeGreenKernel κ 0 u) :=
      funext fun x' => h_shift0 x' u
    rw [h_fn, iteratedDeriv_const, if_neg (Nat.succ_ne_zero n)]
  have h_shift_succ : ∀ m : ℕ, ∀ x u : ℝ, shiftedGreenIter κ w (m + 1) x u =
      -∫ v : ℝ, shiftedGreenIter κ w m x v * w (x + v) * freeGreenKernel κ v u := by
    intro m x u
    simp only [shiftedGreenIter, greenIterKernel]
    rw [← MeasureTheory.integral_add_left_eq_self
      (fun z : ℝ => greenIterKernel κ w m x z * w z * freeGreenKernel κ z (x + u)) x]
    congr 1
    refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
    dsimp
    congr 1
    simp only [freeGreenKernel]
    have h_sub : x + v - (x + u) = v - u := by ring
    rw [h_sub]
  have s2_step : ∀ (F : ℝ → ℝ → ℝ),
      (∀ v : ℝ, ContDiff ℝ (⊤ : ℕ∞) (fun x => F x v)) →
      (∀ n : ℕ, ∀ x : ℝ, Continuous (fun v => iteratedDeriv n (fun x' => F x' v) x)) →
      (∀ n : ℕ, ∃ M : ℝ, 0 ≤ M ∧ ∀ x v : ℝ, |iteratedDeriv n (fun x' => F x' v) x| ≤ M) →
      (∀ u : ℝ, ContDiff ℝ (⊤ : ℕ∞) (fun x => -∫ v : ℝ, F x v * freeGreenKernel κ v u)) ∧
      (∀ n : ℕ, ∀ x u : ℝ,
        iteratedDeriv n (fun x' => -∫ v : ℝ, F x' v * freeGreenKernel κ v u) x =
          -∫ v : ℝ, iteratedDeriv n (fun x' => F x' v) x * freeGreenKernel κ v u) ∧
      (∀ n : ℕ, ∀ x : ℝ,
        Continuous (fun u => iteratedDeriv n (fun x' => -∫ v : ℝ, F x' v * freeGreenKernel κ v u) x)) ∧
      (∀ n : ℕ, ∃ B : ℝ, 0 ≤ B ∧ ∀ x u : ℝ,
        |iteratedDeriv n (fun x' => -∫ v : ℝ, F x' v * freeGreenKernel κ v u) x| ≤ B) := by
    intro F hF_smooth hF_cont hF_bound
    let I : ℕ → ℝ → ℝ → ℝ := fun n x u =>
      -∫ v : ℝ, iteratedDeriv n (fun x' => F x' v) x * freeGreenKernel κ v u
    have h_hasDerivAt : ∀ (n : ℕ) (x₀ u : ℝ),
        HasDerivAt (fun x => I n x u) (I (n + 1) x₀ u) x₀ := by
      intro n x₀ u
      obtain ⟨M_n, hMn_nn, hMn⟩ := hF_bound n
      obtain ⟨M_succ, hMsucc_nn, hMsucc⟩ := hF_bound (n + 1)
      let Φ : ℝ → ℝ → ℝ := fun x v => iteratedDeriv n (fun x' => F x' v) x * freeGreenKernel κ v u
      let Φ' : ℝ → ℝ → ℝ := fun x v => iteratedDeriv (n + 1) (fun x' => F x' v) x * freeGreenKernel κ v u
      let bound : ℝ → ℝ := fun v => M_succ * freeGreenKernel κ v u
      have h_meas : ∀ᶠ x in nhds x₀, AEStronglyMeasurable (Φ x) volume :=
        Filter.Eventually.of_forall fun x => ((hF_cont n x).mul (h_fg_cont u)).aestronglyMeasurable
      have h_int_x0 : Integrable (Φ x₀) volume := by
        refine ((h_fg_int u).const_mul M_n).mono'
          (((hF_cont n x₀).mul (h_fg_cont u)).aestronglyMeasurable)
          (Filter.Eventually.of_forall fun v => ?_)
        dsimp [Φ]
        rw [abs_mul, abs_of_nonneg (h_fg_nonneg v u)]
        exact mul_le_mul_of_nonneg_right (hMn x₀ v) (h_fg_nonneg v u)
      have h_meas' : AEStronglyMeasurable (Φ' x₀) volume :=
        ((hF_cont (n + 1) x₀).mul (h_fg_cont u)).aestronglyMeasurable
      have h_bound_ae : ∀ᵐ v ∂volume, ∀ x ∈ (Set.univ : Set ℝ), ‖Φ' x v‖ ≤ bound v := by
        refine Filter.Eventually.of_forall fun v x _ => ?_
        dsimp [Φ', bound]
        rw [abs_mul, abs_of_nonneg (h_fg_nonneg v u)]
        exact mul_le_mul_of_nonneg_right (hMsucc x v) (h_fg_nonneg v u)
      have h_bound_int : Integrable bound volume := (h_fg_int u).const_mul M_succ
      have h_diff : ∀ᵐ v ∂volume, ∀ x ∈ (Set.univ : Set ℝ), HasDerivAt (fun x' => Φ x' v) (Φ' x v) x := by
        refine Filter.Eventually.of_forall fun v x _ => ?_
        have hd_diff : Differentiable ℝ (iteratedDeriv n (fun x' => F x' v)) :=
          (hF_smooth v).differentiable_iteratedDeriv n (WithTop.coe_lt_coe.mpr (WithTop.coe_lt_top n))
        have hd : HasDerivAt (iteratedDeriv n (fun x' => F x' v))
            (iteratedDeriv (n + 1) (fun x' => F x' v) x) x := by
          rw [iteratedDeriv_succ]
          exact (hd_diff x).hasDerivAt
        exact hd.mul_const (freeGreenKernel κ v u)
      have h_main := hasDerivAt_integral_of_dominated_loc_of_deriv_le
        (s := Set.univ) Filter.univ_mem h_meas h_int_x0 h_meas' h_bound_ae h_bound_int h_diff
      exact h_main.2.neg
    have hI0 : ∀ x u : ℝ, I 0 x u = -∫ v : ℝ, F x v * freeGreenKernel κ v u := by
      intro x u
      dsimp [I]
      simp only [iteratedDeriv_zero]
    have h_iter_eq : ∀ (n : ℕ) (u : ℝ),
        iteratedDeriv n (fun x' => -∫ v : ℝ, F x' v * freeGreenKernel κ v u) = fun x => I n x u := by
      intro n u
      induction n with
      | zero =>
        ext x
        rw [iteratedDeriv_zero, hI0 x u]
      | succ n ih =>
        ext x
        rw [iteratedDeriv_succ, ih]
        exact (h_hasDerivAt n x u).deriv
    have h_smooth_G : ∀ u : ℝ, ContDiff ℝ (⊤ : ℕ∞) (fun x => -∫ v : ℝ, F x v * freeGreenKernel κ v u) := by
      intro u
      refine contDiff_of_differentiable_iteratedDeriv fun n _ => ?_
      rw [h_iter_eq n u]
      intro x
      exact (h_hasDerivAt n x u).differentiableAt
    have h_deriv_G : ∀ (n : ℕ) (x u : ℝ),
        iteratedDeriv n (fun x' => -∫ v : ℝ, F x' v * freeGreenKernel κ v u) x = I n x u := by
      intro n x u
      exact congrFun (h_iter_eq n u) x
    have hI_shift : ∀ (n : ℕ) (x u : ℝ),
        I n x u = -∫ y : ℝ, iteratedDeriv n (fun x' => F x' (u + y)) x * freeGreenKernel κ y 0 := by
      intro n x u
      dsimp [I]
      rw [← MeasureTheory.integral_add_left_eq_self
        (fun v : ℝ => iteratedDeriv n (fun x' => F x' v) x * freeGreenKernel κ v u) u]
      congr 1
      refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
      dsimp
      congr 1
      simp only [freeGreenKernel]
      have h_sub : u + y - u = y - 0 := by ring
      rw [h_sub]
    have h_cont_G : ∀ (n : ℕ) (x : ℝ),
        Continuous (fun u => iteratedDeriv n (fun x' => -∫ v : ℝ, F x' v * freeGreenKernel κ v u) x) := by
      intro n x
      obtain ⟨M_n, hMn_nn, hMn⟩ := hF_bound n
      have h_eq : (fun u => iteratedDeriv n (fun x' => -∫ v : ℝ, F x' v * freeGreenKernel κ v u) x) =
          (fun u => -∫ y : ℝ, iteratedDeriv n (fun x' => F x' (u + y)) x * freeGreenKernel κ y 0) := by
        ext u
        rw [h_deriv_G n x u, hI_shift n x u]
      rw [h_eq]
      refine Continuous.neg ?_
      refine MeasureTheory.continuous_of_dominated
        (bound := fun y => M_n * freeGreenKernel κ y 0) ?_ ?_ ?_ ?_
      · intro u
        exact (((hF_cont n x).comp (continuous_const.add continuous_id)).mul (h_fg_cont 0)).aestronglyMeasurable
      · intro u
        refine Filter.Eventually.of_forall fun y => ?_
        dsimp
        rw [abs_mul, abs_of_nonneg (h_fg_nonneg y 0)]
        exact mul_le_mul_of_nonneg_right (hMn x (u + y)) (h_fg_nonneg y 0)
      · exact (h_fg_int 0).const_mul M_n
      · refine Filter.Eventually.of_forall fun y => ?_
        exact ((hF_cont n x).comp (continuous_id.add continuous_const)).mul continuous_const
    have h_bound_G : ∀ (n : ℕ), ∃ B : ℝ, 0 ≤ B ∧ ∀ x u : ℝ,
        |iteratedDeriv n (fun x' => -∫ v : ℝ, F x' v * freeGreenKernel κ v u) x| ≤ B := by
      intro n
      obtain ⟨M_n, hMn_nn, hMn⟩ := hF_bound n
      let B : ℝ := ∫ y : ℝ, M_n * freeGreenKernel κ y 0
      have hB_nn : 0 ≤ B := by
        refine MeasureTheory.integral_nonneg fun y => ?_
        exact mul_nonneg hMn_nn (h_fg_nonneg y 0)
      refine ⟨B, hB_nn, fun x u => ?_⟩
      rw [h_deriv_G n x u, hI_shift n x u, abs_neg, ← Real.norm_eq_abs]
      refine le_trans (MeasureTheory.norm_integral_le_integral_norm _) ?_
      have h_int_lhs : Integrable (fun y : ℝ => ‖iteratedDeriv n (fun x' => F x' (u + y)) x * freeGreenKernel κ y 0‖) volume := by
        refine ((h_fg_int 0).const_mul M_n).mono'
          ((((hF_cont n x).comp (continuous_const.add continuous_id)).mul (h_fg_cont 0)).norm.aestronglyMeasurable)
          (Filter.Eventually.of_forall fun y => ?_)
        dsimp
        rw [abs_abs, abs_mul, abs_of_nonneg (h_fg_nonneg y 0)]
        exact mul_le_mul_of_nonneg_right (hMn x (u + y)) (h_fg_nonneg y 0)
      refine MeasureTheory.integral_mono_ae h_int_lhs ((h_fg_int 0).const_mul M_n)
        (Filter.Eventually.of_forall fun y => ?_)
      dsimp
      rw [abs_mul, abs_of_nonneg (h_fg_nonneg y 0)]
      exact mul_le_mul_of_nonneg_right (hMn x (u + y)) (h_fg_nonneg y 0)
    exact ⟨h_smooth_G, h_deriv_G, h_cont_G, h_bound_G⟩
  let D : 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ) := fun f => SchwartzMap.derivCLM ℝ ℝ f
  have h_w_iter : ∀ (k : ℕ) (x v : ℝ),
      iteratedDeriv k (fun x' : ℝ => w (x' + v)) x = (D^[k] w) (x + v) := by
    intro k
    induction k with
    | zero =>
      intro x v
      rw [iteratedDeriv_zero, Function.iterate_zero_apply]
    | succ k ih =>
      intro x v
      rw [iteratedDeriv_succ]
      have h_fn : iteratedDeriv k (fun x' : ℝ => w (x' + v)) = fun x' : ℝ => (D^[k] w) (x' + v) :=
        funext fun x' => ih x' v
      rw [h_fn]
      have h_comp : deriv (fun x' : ℝ => (D^[k] w) (x' + v)) x = deriv (D^[k] w) (x + v) :=
        deriv_comp_add_const (D^[k] w) v x
      rw [h_comp, ← SchwartzMap.derivCLM_apply ℝ (D^[k] w) (x + v)]
      change D (D^[k] w) (x + v) = (D^[k + 1] w) (x + v)
      rw [← Function.iterate_succ_apply' D k w]
  have hW_bound : ∀ k : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ y : ℝ, |(D^[k] w) y| ≤ C := by
    intro k
    obtain ⟨C, hC⟩ := (D^[k] w).toBoundedContinuousFunction.isBounded_range.exists_norm_le
    refine ⟨max C 0, le_max_right C 0, fun y => ?_⟩
    have hy := hC ((D^[k] w) y) ⟨y, rfl⟩
    rw [Real.norm_eq_abs] at hy
    exact le_trans hy (le_max_left C 0)
  let C_seq : ℕ → ℝ := fun k => Classical.choose (hW_bound k)
  have hC_seq_nn : ∀ k : ℕ, 0 ≤ C_seq k := fun k => (Classical.choose_spec (hW_bound k)).1
  have hC_seq : ∀ (k : ℕ) (y : ℝ), |(D^[k] w) y| ≤ C_seq k :=
    fun k => (Classical.choose_spec (hW_bound k)).2
  have s3_step : ∀ (g : ℝ → ℝ → ℝ),
      (∀ v : ℝ, ContDiff ℝ (⊤ : ℕ∞) (fun x => g x v)) →
      (∀ n : ℕ, ∀ x : ℝ, Continuous (fun v => iteratedDeriv n (fun x' => g x' v) x)) →
      (∀ n : ℕ, ∃ M : ℝ, 0 ≤ M ∧ ∀ x v : ℝ, |iteratedDeriv n (fun x' => g x' v) x| ≤ M) →
      (∀ v : ℝ, ContDiff ℝ (⊤ : ℕ∞) (fun x => g x v * w (x + v))) ∧
      (∀ n : ℕ, ∀ x : ℝ, Continuous (fun v => iteratedDeriv n (fun x' => g x' v * w (x' + v)) x)) ∧
      (∀ n : ℕ, ∃ M' : ℝ, 0 ≤ M' ∧ ∀ x v : ℝ, |iteratedDeriv n (fun x' => g x' v * w (x' + v)) x| ≤ M') ∧
      (∀ n : ℕ, ∀ x u : ℝ,
        -∫ v : ℝ, iteratedDeriv n (fun x' => g x' v * w (x' + v)) x * freeGreenKernel κ v u =
          ∑ j ∈ Finset.range (n + 1), (Nat.choose n j : ℝ) *
            (-∫ v : ℝ, iteratedDeriv j (fun x' => g x' v) x *
              ((SchwartzMap.derivCLM ℝ ℝ)^[n - j] w) (x + v) * freeGreenKernel κ v u)) := by
    intro g hg_smooth hg_cont hg_bound
    have h_smooth_prod : ∀ v : ℝ, ContDiff ℝ (⊤ : ℕ∞) (fun x => g x v * w (x + v)) := by
      intro v
      have hw_sm : ContDiff ℝ (⊤ : ℕ∞) (fun x : ℝ => w (x + v)) :=
        w.smooth'.comp (contDiff_id.add contDiff_const)
      exact (hg_smooth v).mul hw_sm
    have h_leibniz : ∀ (n : ℕ) (x v : ℝ),
        iteratedDeriv n (fun x' => g x' v * w (x' + v)) x =
          ∑ j ∈ Finset.range (n + 1), (Nat.choose n j : ℝ) *
            iteratedDeriv j (fun x' => g x' v) x * (D^[n - j] w) (x + v) := by
      intro n x v
      have hg_cd : ContDiffAt ℝ (n : ℕ∞) (fun x' : ℝ => g x' v) x :=
        (hg_smooth v).contDiffAt.of_le (WithTop.coe_le_coe.mpr le_top)
      have hw_cd : ContDiffAt ℝ (n : ℕ∞) (fun x' : ℝ => w (x' + v)) x :=
        (w.smooth'.comp (contDiff_id.add contDiff_const)).contDiffAt.of_le (WithTop.coe_le_coe.mpr le_top)
      have h_mul := iteratedDeriv_mul hg_cd hw_cd
      change iteratedDeriv n ((fun x' => g x' v) * (fun x' => w (x' + v))) x = _
      rw [h_mul]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [h_w_iter (n - j) x v]
    have h_cont_prod : ∀ (n : ℕ) (x : ℝ),
        Continuous (fun v => iteratedDeriv n (fun x' => g x' v * w (x' + v)) x) := by
      intro n x
      have h_eq : (fun v => iteratedDeriv n (fun x' => g x' v * w (x' + v)) x) =
          fun v => ∑ j ∈ Finset.range (n + 1), (Nat.choose n j : ℝ) *
            iteratedDeriv j (fun x' => g x' v) x * (D^[n - j] w) (x + v) :=
        funext fun v => h_leibniz n x v
      rw [h_eq]
      refine continuous_finset_sum _ fun j _ => ?_
      have hw_cont : Continuous (fun v : ℝ => (D^[n - j] w) (x + v)) :=
        (D^[n - j] w).continuous.comp (continuous_const.add continuous_id)
      exact (continuous_const.mul (hg_cont j x)).mul hw_cont
    let M_seq : ℕ → ℝ := fun j => Classical.choose (hg_bound j)
    have hM_seq_nn : ∀ j : ℕ, 0 ≤ M_seq j := fun j => (Classical.choose_spec (hg_bound j)).1
    have hM_seq : ∀ (j : ℕ) (x v : ℝ), |iteratedDeriv j (fun x' => g x' v) x| ≤ M_seq j :=
      fun j => (Classical.choose_spec (hg_bound j)).2
    have h_bound_prod : ∀ n : ℕ, ∃ M' : ℝ, 0 ≤ M' ∧ ∀ x v : ℝ,
        |iteratedDeriv n (fun x' => g x' v * w (x' + v)) x| ≤ M' := by
      intro n
      let M' : ℝ := ∑ j ∈ Finset.range (n + 1), (Nat.choose n j : ℝ) * M_seq j * C_seq (n - j)
      have hM'_nn : 0 ≤ M' := by
        refine Finset.sum_nonneg fun j _ => ?_
        have h1 : 0 ≤ (Nat.choose n j : ℝ) := Nat.cast_nonneg _
        exact mul_nonneg (mul_nonneg h1 (hM_seq_nn j)) (hC_seq_nn (n - j))
      refine ⟨M', hM'_nn, fun x v => ?_⟩
      rw [h_leibniz n x v]
      refine le_trans (Finset.abs_sum_le_sum_abs _ _) ?_
      refine Finset.sum_le_sum fun j _ => ?_
      rw [abs_mul, abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
      have h1 : (Nat.choose n j : ℝ) * |iteratedDeriv j (fun x' => g x' v) x| ≤
          (Nat.choose n j : ℝ) * M_seq j :=
        mul_le_mul_of_nonneg_left (hM_seq j x v) (Nat.cast_nonneg _)
      exact mul_le_mul h1 (hC_seq (n - j) (x + v)) (abs_nonneg _)
        (mul_nonneg (Nat.cast_nonneg _) (hM_seq_nn j))
    have h_int_sum : ∀ (n : ℕ) (x u : ℝ),
        -∫ v : ℝ, iteratedDeriv n (fun x' => g x' v * w (x' + v)) x * freeGreenKernel κ v u =
          ∑ j ∈ Finset.range (n + 1), (Nat.choose n j : ℝ) *
            (-∫ v : ℝ, iteratedDeriv j (fun x' => g x' v) x *
              (D^[n - j] w) (x + v) * freeGreenKernel κ v u) := by
      intro n x u
      let h_term : ℕ → ℝ → ℝ := fun j v =>
        iteratedDeriv j (fun x' => g x' v) x * (D^[n - j] w) (x + v) * freeGreenKernel κ v u
      have h_term_int : ∀ j ∈ Finset.range (n + 1),
          Integrable (fun v : ℝ => (Nat.choose n j : ℝ) * h_term j v) volume := by
        intro j _
        refine Integrable.const_mul ?_ (Nat.choose n j : ℝ)
        have hw_cont : Continuous (fun v : ℝ => (D^[n - j] w) (x + v)) :=
          (D^[n - j] w).continuous.comp (continuous_const.add continuous_id)
        refine ((h_fg_int u).const_mul (M_seq j * C_seq (n - j))).mono'
          (((hg_cont j x).mul hw_cont).mul (h_fg_cont u)).aestronglyMeasurable
          (Filter.Eventually.of_forall fun v => ?_)
        dsimp [h_term]
        rw [abs_mul, abs_mul, abs_of_nonneg (h_fg_nonneg v u)]
        have h_prod : |iteratedDeriv j (fun x' => g x' v) x| * |(D^[n - j] w) (x + v)| ≤
            M_seq j * C_seq (n - j) :=
          mul_le_mul (hM_seq j x v) (hC_seq (n - j) (x + v)) (abs_nonneg _) (hM_seq_nn j)
        exact mul_le_mul_of_nonneg_right h_prod (h_fg_nonneg v u)
      have h_eq : (fun v : ℝ => iteratedDeriv n (fun x' => g x' v * w (x' + v)) x * freeGreenKernel κ v u) =
          fun v : ℝ => ∑ j ∈ Finset.range (n + 1), (Nat.choose n j : ℝ) * h_term j v := by
        ext v
        rw [h_leibniz n x v, Finset.sum_mul]
        refine Finset.sum_congr rfl fun j _ => ?_
        dsimp [h_term]
        ring
      rw [h_eq, MeasureTheory.integral_finset_sum _ h_term_int, ← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [MeasureTheory.integral_const_mul, mul_neg]
    exact ⟨h_smooth_prod, h_cont_prod, h_bound_prod, h_int_sum⟩
  have h_inv : ∀ m : ℕ,
      (∀ u : ℝ, ContDiff ℝ (⊤ : ℕ∞) (fun x => shiftedGreenIter κ w m x u)) ∧
      (∀ n : ℕ, ∀ x : ℝ, Continuous (fun u => iteratedDeriv n (fun x' => shiftedGreenIter κ w m x' u) x)) ∧
      (∀ n : ℕ, ∃ M : ℝ, 0 ≤ M ∧ ∀ x u : ℝ, |iteratedDeriv n (fun x' => shiftedGreenIter κ w m x' u) x| ≤ M) := by
    intro m
    induction m with
    | zero =>
      refine ⟨?_, ?_, ?_⟩
      · intro u
        have h_fn : (fun x : ℝ => shiftedGreenIter κ w 0 x u) = fun _ : ℝ => freeGreenKernel κ 0 u :=
          funext fun x => h_shift0 x u
        rw [h_fn]
        exact contDiff_const
      · intro n x
        rcases n with _ | n
        · have h_fn : (fun u : ℝ => iteratedDeriv 0 (fun x' => shiftedGreenIter κ w 0 x' u) x) =
              fun u : ℝ => freeGreenKernel κ 0 u :=
            funext fun u => h_base0 x u
          rw [h_fn]
          unfold freeGreenKernel
          fun_prop
        · have h_fn : (fun u : ℝ => iteratedDeriv (n + 1) (fun x' => shiftedGreenIter κ w 0 x' u) x) =
              fun _ : ℝ => 0 :=
            funext fun u => h_base_succ n x u
          rw [h_fn]
          exact continuous_const
      · intro n
        rcases n with _ | n
        · refine ⟨1 / (2 * κ), by positivity, fun x u => ?_⟩
          change |shiftedGreenIterDeriv κ w 0 0 x u| ≤ 1 / (2 * κ)
          rw [h_base0 x u]
          unfold freeGreenKernel
          rw [abs_of_nonneg (by positivity)]
          have h_exp : Real.exp (-κ * |0 - u|) ≤ 1 := by
            rw [Real.exp_le_one_iff]
            exact mul_nonpos_of_nonpos_of_nonneg (by linarith) (abs_nonneg _)
          calc (1 / (2 * κ)) * Real.exp (-κ * |0 - u|)
            _ ≤ (1 / (2 * κ)) * 1 := mul_le_mul_of_nonneg_left h_exp (by positivity)
            _ = 1 / (2 * κ) := mul_one _
        · refine ⟨0, le_rfl, fun x u => ?_⟩
          change |shiftedGreenIterDeriv κ w 0 (n + 1) x u| ≤ 0
          rw [h_base_succ n x u, abs_zero]
    | succ m ih =>
      obtain ⟨h_sm_m, h_cont_m, h_bd_m⟩ := ih
      obtain ⟨hF_sm, hF_cont, hF_bd, _⟩ :=
        s3_step (shiftedGreenIter κ w m) h_sm_m h_cont_m h_bd_m
      obtain ⟨hG_sm, _, hG_cont, hG_bd⟩ :=
        s2_step (fun x v => shiftedGreenIter κ w m x v * w (x + v)) hF_sm hF_cont hF_bd
      have h_eq_fn : ∀ u : ℝ, (fun x : ℝ => shiftedGreenIter κ w (m + 1) x u) =
          fun x : ℝ => -∫ v : ℝ, (shiftedGreenIter κ w m x v * w (x + v)) * freeGreenKernel κ v u :=
        fun u => funext fun x => h_shift_succ m x u
      refine ⟨?_, ?_, ?_⟩
      · intro u
        rw [h_eq_fn u]
        exact hG_sm u
      · intro n x
        have h_eq_u : (fun u : ℝ => iteratedDeriv n (fun x' => shiftedGreenIter κ w (m + 1) x' u) x) =
            fun u : ℝ => iteratedDeriv n (fun x' => -∫ v : ℝ, (shiftedGreenIter κ w m x' v * w (x' + v)) * freeGreenKernel κ v u) x := by
          ext u
          rw [h_eq_fn u]
        rw [h_eq_u]
        exact hG_cont n x
      · intro n
        obtain ⟨B, hB_nn, hB⟩ := hG_bd n
        refine ⟨B, hB_nn, fun x u => ?_⟩
        rw [h_eq_fn u]
        exact hB x u
  refine ⟨fun m u => (h_inv m).1 u, h_base0, h_base_succ, ?_⟩
  intro m n x u
  obtain ⟨h_sm_m, h_cont_m, h_bd_m⟩ := h_inv m
  obtain ⟨hF_sm, hF_cont, hF_bd, h_int_sum⟩ :=
    s3_step (shiftedGreenIter κ w m) h_sm_m h_cont_m h_bd_m
  obtain ⟨_, hG_deriv, _, _⟩ :=
    s2_step (fun x v => shiftedGreenIter κ w m x v * w (x + v)) hF_sm hF_cont hF_bd
  have h_eq_fn : (fun x' : ℝ => greenIterKernel κ w (m + 1) x' (x' + u)) =
      fun x' : ℝ => -∫ v : ℝ, (shiftedGreenIter κ w m x' v * w (x' + v)) * freeGreenKernel κ v u :=
    funext fun x' => h_shift_succ m x' u
  change iteratedDeriv n (fun x' : ℝ => greenIterKernel κ w (m + 1) x' (x' + u)) x = _
  rw [h_eq_fn, hG_deriv n x u, h_int_sum n x u]
  rfl

theorem freeGreenKernel_h1Kappa_step_bounds : ∀ (κ : ℝ), 1 ≤ κ →
    (IsGoodGreenProfile κ (freeGreenKernel κ 0) ∧
      Real.sqrt (h1KappaNormSq κ (freeGreenKernel κ 0)) ≤ 1) ∧
    (IsGoodGreenProfile κ (fun _ : ℝ => 0) ∧
      Real.sqrt (h1KappaNormSq κ (fun _ : ℝ => 0)) = 0) ∧
    (∀ f : ℝ → ℝ, IsGoodGreenProfile κ f → ∀ u : ℝ, |f u| ≤ Real.sqrt (h1KappaNormSq κ f)) ∧
    (∀ (W : 𝓢(ℝ, ℝ)) (x : ℝ) (f : ℝ → ℝ), IsGoodGreenProfile κ f →
      IsGoodGreenProfile κ (fun u => -∫ v : ℝ, f v * W (x + v) * freeGreenKernel κ v u) ∧
      Real.sqrt (h1KappaNormSq κ (fun u => -∫ v : ℝ, f v * W (x + v) * freeGreenKernel κ v u)) ≤
        ‖ι W‖ * Real.sqrt (h1KappaNormSq κ f)) ∧
    (∀ (n : ℕ) (c : ℕ → ℝ) (F : ℕ → ℝ → ℝ),
      (∀ j ∈ Finset.range (n + 1), 0 ≤ c j ∧ IsGoodGreenProfile κ (F j)) →
      IsGoodGreenProfile κ (fun u => ∑ j ∈ Finset.range (n + 1), c j * F j u) ∧
      Real.sqrt (h1KappaNormSq κ (fun u => ∑ j ∈ Finset.range (n + 1), c j * F j u)) ≤
        ∑ j ∈ Finset.range (n + 1), c j * Real.sqrt (h1KappaNormSq κ (F j))) :=
by
  intro κ hκ
  have hκ_pos : 0 < κ := by linarith
  have h_κ_ne : κ ≠ 0 := ne_of_gt hκ_pos
  have h_pi_pos : 0 < Real.pi := Real.pi_pos
  have h_2pi_pos : 0 < 2 * Real.pi := by positivity
  have h_denom_pos : ∀ ξ : ℝ, 0 < κ ^ 2 + ξ ^ 2 := fun ξ => by positivity
  obtain ⟨⟨h_inv_int, h_inv_eq⟩, _⟩ := freeGreenKernel_fourier_integral_eq κ hκ
  have h_fl_cont_bound : ∀ (f : ℝ → ℝ), Continuous f → Integrable f volume →
      Continuous (fourierLine f) ∧ ∃ C_f : ℝ, 0 ≤ C_f ∧ ∀ ζ : ℝ, ‖fourierLine f ζ‖ ≤ C_f := by
    intro f hf_cont hf_int
    let K : ℝ → ℝ → ℂ := fun ζ z => Complex.exp (-((ζ : ℂ) * (z : ℂ)) * I) * (f z : ℂ)
    let bound : ℝ → ℝ := fun z => ‖f z‖
    have hw_int : Integrable bound volume := hf_int.norm
    have hK_meas : ∀ ζ : ℝ, AEStronglyMeasurable (K ζ) volume := by
      intro ζ
      have hc : Continuous (K ζ) := by
        dsimp [K]
        exact (Complex.continuous_exp.comp
          (((continuous_const.mul Complex.continuous_ofReal).neg).mul continuous_const)).mul
          (Complex.continuous_ofReal.comp hf_cont)
      exact hc.aestronglyMeasurable
    have hK_dom : ∀ ζ : ℝ, ∀ᵐ z : ℝ ∂volume, ‖K ζ z‖ ≤ bound z := by
      intro ζ
      filter_upwards with z
      dsimp [K, bound]
      rw [norm_mul, show -((ζ : ℂ) * (z : ℂ)) * I = (((-(ζ * z) : ℝ) : ℂ) * I) by push_cast; ring,
          Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real, Real.norm_eq_abs]
    have hK_cont : ∀ᵐ z : ℝ ∂volume, Continuous (fun ζ : ℝ => K ζ z) := by
      filter_upwards with z
      dsimp [K]
      exact (Complex.continuous_exp.comp
        (((Complex.continuous_ofReal.mul continuous_const).neg).mul continuous_const)).mul
        continuous_const
    have h_int_cont : Continuous (fun ζ : ℝ => ∫ z : ℝ, K ζ z) :=
      continuous_of_dominated hK_meas hK_dom hw_int hK_cont
    refine ⟨continuous_const.mul h_int_cont,
      ‖((Real.sqrt (2 * π))⁻¹ : ℂ)‖ * ∫ z : ℝ, bound z,
      mul_nonneg (norm_nonneg _) (integral_nonneg (fun z => norm_nonneg _)), ?_⟩
    intro ζ
    dsimp [fourierLine]
    rw [norm_mul]
    refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
    calc ‖∫ z : ℝ, K ζ z‖
      _ ≤ ∫ z : ℝ, ‖K ζ z‖ := norm_integral_le_integral_norm (K ζ)
      _ ≤ ∫ z : ℝ, bound z :=
        integral_mono_ae ((hw_int.mono' (hK_meas ζ) (hK_dom ζ)).norm) hw_int (hK_dom ζ)
  have laplace_cos_integral_Ioi : ∀ c : ℝ,
      ∫ v in Set.Ioi 0, Real.exp (-κ * v) * Real.cos (c * v) =
        κ / (κ ^ 2 + c ^ 2) := by
    intro c
    have h_den : 0 < κ ^ 2 + c ^ 2 := by positivity
    let F : ℝ → ℝ := fun v =>
      Real.exp (-κ * v) * (-κ * Real.cos (c * v) + c * Real.sin (c * v)) / (κ ^ 2 + c ^ 2)
    have hF_cont : ContinuousWithinAt F (Set.Ici 0) 0 := by
      dsimp [F]
      fun_prop
    have hF_deriv : ∀ v ∈ Set.Ioi (0 : ℝ), HasDerivAt F (Real.exp (-κ * v) * Real.cos (c * v)) v := by
      intro v _
