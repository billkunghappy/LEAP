    intro u v s₀ h_deriv
    rw [ContinuousAt]
    have h_inv_smul := h_deriv.isLittleOTVS.tendsto_inv_smul
    have h_sub_tendsto : Filter.Tendsto (fun s : ℝ => s - s₀) (nhds s₀) (nhds 0) := by
      simpa [sub_self] using (continuousAt_id.sub (continuousAt_const : ContinuousAt (fun _ : ℝ => s₀) s₀)).tendsto
    have h_smul_zero : Filter.Tendsto
        (fun s : ℝ => (s - s₀) • ((s - s₀)⁻¹ • (u s - u s₀ - (ContinuousLinearMap.toSpanSingleton ℝ v) (s - s₀))))
