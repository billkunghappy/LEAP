        have h_pow : (2 : ℝ) ^ (m + 1) = 2 * (2 : ℝ) ^ m := by ring
        push_cast; linarith
    have h4M_le : 1 / (4 * M ^ 2) ≤ 1 := by
      rw [div_le_iff₀ (by positivity)]; nlinarith
    have hΔ_int : Integrable (fun z : ℝ => |w₁ z - w₂ z|) volume := by
      simpa [Real.norm_eq_abs] using (w₁ - w₂).integrable.norm
    have h_res : ∀ a b : ℝ, greenKernel M w₁ a b - greenKernel M w₂ a b =
        -∫ z : ℝ, greenKernel M w₁ a z * greenKernel M w₂ z b * (w₁ z - w₂ z) := by
      intro a b
      have h1_sum : Summable (fun ℓ : ℕ => greenIterKernel M w₁ ℓ a b) := (hG₁_sum_norm a b).of_norm
      have h2_sum : Summable (fun ℓ : ℕ => greenIterKernel M w₂ ℓ a b) := (hG₂_sum_norm a b).of_norm
      have h1_shift : Summable (fun m : ℕ => greenIterKernel M w₁ (m + 1) a b) :=
        (summable_nat_add_iff 1).mpr h1_sum
      have h2_shift : Summable (fun m : ℕ => greenIterKernel M w₂ (m + 1) a b) :=
        (summable_nat_add_iff 1).mpr h2_sum
      let S : ℕ → ℝ → ℝ := fun m z =>
        ∑ p ∈ Finset.antidiagonal m, greenIterKernel M w₁ p.1 a z * greenIterKernel M w₂ p.2 z b
      let F : ℕ → ℝ → ℝ := fun m z => S m z * (w₁ z - w₂ z)
      have h_peel_sub : greenKernel M w₁ a b - greenKernel M w₂ a b =
          -∑' m : ℕ, ∫ z : ℝ, F m z := by
        dsimp [greenKernel]
        rw [h1_sum.tsum_eq_zero_add, h2_sum.tsum_eq_zero_add]
        have h0 : greenIterKernel M w₁ 0 a b = greenIterKernel M w₂ 0 a b := rfl
        rw [h0, add_sub_add_left_eq_sub, ← h1_shift.tsum_sub h2_shift]
        have h_congr : (fun m : ℕ => greenIterKernel M w₁ (m + 1) a b - greenIterKernel M w₂ (m + 1) a b) =
            (fun m : ℕ => -∫ z : ℝ, F m z) := by
          funext m; exact h_tele w₁ w₂ m a b
        rw [h_congr, tsum_neg]
      have hS_bound : ∀ (m : ℕ) (z : ℝ), |S m z| ≤ (1 / 2 : ℝ) ^ m := by
        intro m z
        dsimp [S]
        have h_term : ∀ p ∈ Finset.antidiagonal m,
            |greenIterKernel M w₁ p.1 a z * greenIterKernel M w₂ p.2 z b| ≤ (1 / 4 : ℝ) ^ m := by
          intro p hp
          have hp_eq : p.1 + p.2 = m := Finset.mem_antidiagonal.mp hp
          rw [abs_mul]
          have hb1 := h_bound w₁ hw₁ p.1 a z
          have hb2 := h_bound w₂ hw₂ p.2 z b
          calc |greenIterKernel M w₁ p.1 a z| * |greenIterKernel M w₂ p.2 z b|
            _ ≤ ((1 / (2 * M)) * (1 / 4 : ℝ) ^ p.1) * ((1 / (2 * M)) * (1 / 4 : ℝ) ^ p.2) :=
              mul_le_mul hb1 hb2 (abs_nonneg _) (by positivity)
            _ = (1 / (4 * M ^ 2)) * ((1 / 4 : ℝ) ^ p.1 * (1 / 4 : ℝ) ^ p.2) := by ring
            _ = (1 / (4 * M ^ 2)) * (1 / 4 : ℝ) ^ (p.1 + p.2) := by rw [← pow_add]
            _ = (1 / (4 * M ^ 2)) * (1 / 4 : ℝ) ^ m := by rw [hp_eq]
            _ ≤ 1 * (1 / 4 : ℝ) ^ m := mul_le_mul_of_nonneg_right h4M_le (by positivity)
            _ = (1 / 4 : ℝ) ^ m := one_mul _
        calc |∑ p ∈ Finset.antidiagonal m, greenIterKernel M w₁ p.1 a z * greenIterKernel M w₂ p.2 z b|
          _ ≤ ∑ p ∈ Finset.antidiagonal m, |greenIterKernel M w₁ p.1 a z * greenIterKernel M w₂ p.2 z b| :=
            Finset.abs_sum_le_sum_abs _ _
          _ ≤ (Finset.antidiagonal m).card • (1 / 4 : ℝ) ^ m :=
            Finset.sum_le_card_nsmul _ _ _ h_term
