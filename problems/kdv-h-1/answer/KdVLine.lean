      10 * (Real.sqrt (hm1KappaSq M (ι w₁)) + Real.sqrt (hm1KappaSq M (ι w₂)))) ]

theorem greenIterKernel_one_quadratic_spatial_integral (w : 𝓢(ℝ, ℝ)) :
    Integrable (fun x : ℝ => 2 * greenIterKernel 1 w 2 x x - 4 * (greenIterKernel 1 w 1 x x) ^ 2) ∧
    (∫ x : ℝ, (2 * greenIterKernel 1 w 2 x x - 4 * (greenIterKernel 1 w 1 x x) ^ 2)) =
      (1 / 8) * ∫ y : ℝ, ∫ z : ℝ, Real.exp (-2 * |y - z|) * w y * w z :=
by
  have hw_int : Integrable w := w.integrable
  have hw_norm_int : Integrable (fun z : ℝ => |w z|) := hw_int.abs
  have hw_cont : Continuous w := w.continuous
  have h_s3 : ∀ (K : ℝ → ℝ → ℝ → ℝ),
