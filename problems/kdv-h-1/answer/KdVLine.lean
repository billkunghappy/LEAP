    have hR_ge1 : 1 ≤ R := le_max_left _ _
    have hR_ge_div : 2 * B' (k + 1) n / ε ≤ R := le_max_right _ _
    have hR_pos : 0 < R := lt_of_lt_of_le one_pos hR_ge1
    let ε' : ℝ := ε / (2 * R ^ k)
    have hε'_pos : 0 < ε' := by positivity
    obtain ⟨η, hη_pos, hη_0n⟩ := h_zero_n n ε' hε'_pos
    refine ⟨η, hη_pos, ?_⟩
    intro g hg_B hg_η
    have hg_0n : SchwartzMap.seminorm ℝ 0 n g < ε' := hη_0n g hg_B hg_η
    have hg_k1n : SchwartzMap.seminorm ℝ (k + 1) n g ≤ B' (k + 1) n :=
      le_trans (hg_B (k + 1) n) (hB_le_B' (k + 1) n)
