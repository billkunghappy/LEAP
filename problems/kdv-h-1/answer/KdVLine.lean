            rw [norm_mul, norm_star, norm_mul, norm_star]
      have h_int_1 : Integrable (fun ξ : ℝ => A_Δ (m + 1) ξ * A w₁ 1 ξ / (1 + ξ ^ 2)) :=
        h_prod_int (A_Δ (m + 1)) (A w₁ 1) M_Δm M_A11
          (hAΔ_cont (m + 1)) (hA_cont w₁ 1) hM_Δm hM_A11 hA_Δm hA_11
      have h_int_2 : Integrable (fun ξ : ℝ => A w₂ (m + 1) ξ * A w_Δ 1 ξ / (1 + ξ ^ 2)) :=
        h_prod_int (A w₂ (m + 1)) (A w_Δ 1) M_A2m M_AΔ1
          (hA_cont w₂ (m + 1)) (hA_cont w_Δ 1) hM_A2m hM_AΔ1 hA_2m hA_Δ1
      have h_norm_Δh : |Δh| = ‖(Δh : ℂ)‖ := by
        rw [Complex.norm_real, Real.norm_eq_abs]
      have h_norm_2pi : ‖(1 / (2 * π) : ℂ)‖ = 1 / (2 * π) := by
        have h_cast : (1 / (2 * π) : ℂ) = ((1 / (2 * π) : ℝ) : ℂ) := by push_cast; rfl
        rw [h_cast, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
      rw [h_norm_Δh, h_cpx_Δh, norm_mul, h_norm_2pi]
      calc (1 / (2 * π)) * ‖∫ ξ : ℝ, (P₁ ξ / ((1 + ξ ^ 2 : ℝ) : ℂ) - P₂ ξ / ((1 + ξ ^ 2 : ℝ) : ℂ))‖
        _ ≤ (1 / (2 * π)) * ∫ ξ : ℝ, ‖P₁ ξ / ((1 + ξ ^ 2 : ℝ) : ℂ) - P₂ ξ / ((1 + ξ ^ 2 : ℝ) : ℂ)‖ :=
          mul_le_mul_of_nonneg_left (norm_integral_le_integral_norm _) (by positivity)
        _ ≤ (1 / (2 * π)) * ∫ ξ : ℝ,
              (A_Δ (m + 1) ξ * A w₁ 1 ξ / (1 + ξ ^ 2) +
                A w₂ (m + 1) ξ * A w_Δ 1 ξ / (1 + ξ ^ 2)) :=
          mul_le_mul_of_nonneg_left
            (integral_mono (hP₁_int.sub hP₂_int).norm (h_int_1.add h_int_2) h_pw_ξ) (by positivity)
