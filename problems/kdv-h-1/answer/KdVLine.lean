          congr 1; ext η; dsimp [B_Δ]
          have h1 : (2 * π : ℝ) ≠ 0 := ne_of_gt h_2pi_pos
          have h2 : 1 + ξ ^ 2 ≠ 0 := ne_of_gt (h_denom_pos ξ)
