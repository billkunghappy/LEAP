                Complex.exp (((ξ : ℂ) * (x : ℂ)) * I) / ((κ ^ 2 + ξ ^ 2 : ℝ) : ℂ)‖ := h_eq
      _ ≤ (1 / (2 * π)) *
            ∫ ξ : ℝ,
