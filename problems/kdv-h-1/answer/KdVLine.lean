      simpa using h_sub_tendsto.smul h_inv_smul
    have h_rem_eq : (fun s : ℝ => (s - s₀) • ((s - s₀)⁻¹ • (u s - u s₀ - (ContinuousLinearMap.toSpanSingleton ℝ v) (s - s₀)))) =
