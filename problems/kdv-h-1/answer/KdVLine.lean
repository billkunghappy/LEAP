              field_simp
    have hd_comb := (hd_p1.add hd_p2).add hd_rem
    have h_fun_eq : (fun y => (-∫ z : ℝ, J y x z) + (-∫ z : ℝ, J x y z) + Φ y) =
        fun y => greenIterMixedDiag κ w (m + 1) y := by
      ext y
      dsimp [Φ]
      ring
    change HasDerivAt (fun y => (-∫ z : ℝ, J y x z) + (-∫ z : ℝ, J x y z) + Φ y) _ x at hd_comb
    rw [h_fun_eq] at hd_comb
    refine hd_comb.congr_deriv ?_
    rw [(h_diag_deriv (m + 1)).deriv, (h_diag_deriv m).deriv]
    ring

theorem diagGreen_sub_const_deriv_and_iteratedDeriv_three_tsum : ∃ δ_ode : ℝ, 0 < δ_ode ∧
      ∀ (κ : ℝ), 1 ≤ κ → ∀ (w : 𝓢(ℝ, ℝ)), ‖ι w‖ ≤ δ_ode →
        ∀ x : ℝ,
          Summable (fun ℓ : ℕ => greenIterKernel κ w ℓ x x) ∧
          Summable (fun ℓ : ℕ => deriv (fun y => greenIterKernel κ w ℓ y y) x) ∧
          Summable (fun ℓ : ℕ => deriv (fun y => greenIterKernel κ w (ℓ + 1) y y) x) ∧
          deriv (fun y => diagGreen κ w y - 1 / (2 * κ)) x =
            ∑' ℓ : ℕ, deriv (fun y => greenIterKernel κ w ℓ y y) x ∧
          deriv (fun y => diagGreen κ w y - 1 / (2 * κ)) x =
            ∑' ℓ : ℕ, deriv (fun y => greenIterKernel κ w (ℓ + 1) y y) x ∧
          iteratedDeriv 3 (fun y => diagGreen κ w y - 1 / (2 * κ)) x =
            ∑' ℓ : ℕ, iteratedDeriv 3 (fun y => greenIterKernel κ w (ℓ + 1) y y) x :=
by
  refine ⟨1 / 2, by norm_num, ?_⟩
  intro κ hκ w hw x
  obtain ⟨h_contDiff, h_base0, h_base_succ, h_rec⟩ :=
    shiftedGreenIter_smooth_and_leibniz_recurrence κ hκ w
  obtain ⟨h_good0, h_good_zero, h_sob, h_step, h_comb⟩ :=
    freeGreenKernel_h1Kappa_step_bounds κ hκ
  have h_sup :=
    shiftedGreenIterDeriv_summable_sup_bound κ hκ w hw
      h_base0 h_base_succ h_rec h_good0 h_good_zero h_sob h_step h_comb
  have h_weighted :=
    diagGreen_iterates_weighted_deriv_summable κ hκ w h_rec h_sup
  let h : ℕ → ℝ → ℝ := fun ℓ y => greenIterKernel κ w ℓ y y
  let f : ℕ → ℝ → ℝ := fun m y => greenIterKernel κ w (m + 1) y y
  have hf_eq : ∀ m : ℕ, f m = fun y => shiftedGreenIter κ w (m + 1) y 0 := by
    intro m
    ext y
    simp [f, shiftedGreenIter]
  have hf_smooth : ∀ m : ℕ, ContDiff ℝ (↑(⊤ : ℕ∞)) (f m) := by
    intro m
    rw [hf_eq m]
    exact h_contDiff (m + 1) 0
  let v : ℕ → ℕ → ℝ := fun n => Classical.choose (h_weighted 0 n)
  have hv_sum : ∀ n : ℕ, (n : ℕ∞) ≤ (⊤ : ℕ∞) → Summable (v n) := by
    intro n _
    exact (Classical.choose_spec (h_weighted 0 n)).1
  have hv_bound : ∀ (n m : ℕ) (y : ℝ), (n : ℕ∞) ≤ (⊤ : ℕ∞) →
      ‖iteratedFDeriv ℝ n (f m) y‖ ≤ v n m := by
    intro n m y _
    have h_bd := (Classical.choose_spec (h_weighted 0 n)).2 m y
    simpa [f] using h_bd
  have hh0_eq : h 0 = fun _ => 1 / (2 * κ) := by
    ext y
    simp [h, greenIterKernel, freeGreenKernel]
  have hh0_deriv : deriv (h 0) x = 0 := by
    rw [hh0_eq]
    exact deriv_const x (1 / (2 * κ))
  have h_sum_shift : ∀ y : ℝ, Summable (fun m : ℕ => f m y) := by
    intro y
    refine Summable.of_norm_bounded (hv_sum 0 le_top) ?_
    intro m
    have h0 := hv_bound 0 m y le_top
    rw [norm_iteratedFDeriv_zero] at h0
    exact h0
  have h_sum_all : ∀ y : ℝ, Summable (fun ℓ : ℕ => h ℓ y) :=
    fun y => (summable_nat_add_iff 1).mp (h_sum_shift y)
  let g_tilde_fun : ℝ → ℝ := fun y => ∑' m : ℕ, f m y
  have h_sub_eq : (fun y => diagGreen κ w y - 1 / (2 * κ)) = g_tilde_fun := by
    ext y
    have h_split : diagGreen κ w y = h 0 y + g_tilde_fun y :=
      (h_sum_all y).tsum_eq_zero_add
    have h0_y : h 0 y = 1 / (2 * κ) := congr_fun hh0_eq y
    linarith
  have h_fderiv_sum : ∀ n : ℕ, Summable (fun m : ℕ => iteratedFDeriv ℝ n (f m) x) := by
    intro n
    exact Summable.of_norm_bounded (hv_sum n le_top) (fun m => hv_bound n m x le_top)
  have h_iterDeriv_sum : ∀ n : ℕ, Summable (fun m : ℕ => iteratedDeriv n (f m) x) := by
    intro n
    refine Summable.of_norm_bounded (hv_sum n le_top) ?_
    intro m
    rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
    exact hv_bound n m x le_top
  have h_iterDeriv_tsum : ∀ n : ℕ,
      iteratedDeriv n g_tilde_fun x = ∑' m : ℕ, iteratedDeriv n (f m) x := by
    intro n
    rw [iteratedDeriv_eq_iteratedFDeriv]
    have h_fd := iteratedFDeriv_tsum_apply hf_smooth hv_sum hv_bound (le_top : (n : ℕ∞) ≤ ⊤) x
    change iteratedFDeriv ℝ n g_tilde_fun x = ∑' m : ℕ, iteratedFDeriv ℝ n (f m) x at h_fd
    rw [h_fd, ContinuousMultilinearMap.tsum_eval (h_fderiv_sum n) (fun _ => 1)]
    simp_rw [← iteratedDeriv_eq_iteratedFDeriv]
  have h_sum_d1_shift : Summable (fun ℓ : ℕ => deriv (f ℓ) x) := by
    have hs := h_iterDeriv_sum 1
    simpa [iteratedDeriv_one] using hs
  have h_sum_d1_all : Summable (fun ℓ : ℕ => deriv (h ℓ) x) :=
    (summable_nat_add_iff 1).mp h_sum_d1_shift
  have h_d1_shift_eq :
      deriv (fun y => diagGreen κ w y - 1 / (2 * κ)) x = ∑' ℓ : ℕ, deriv (f ℓ) x := by
    rw [h_sub_eq, ← iteratedDeriv_one, h_iterDeriv_tsum 1]
    simp_rw [iteratedDeriv_one]
  have h_d1_all_eq :
      deriv (fun y => diagGreen κ w y - 1 / (2 * κ)) x = ∑' ℓ : ℕ, deriv (h ℓ) x := by
    rw [h_d1_shift_eq, h_sum_d1_all.tsum_eq_zero_add, hh0_deriv, zero_add]
  have h_d3_shift_eq :
      iteratedDeriv 3 (fun y => diagGreen κ w y - 1 / (2 * κ)) x =
        ∑' ℓ : ℕ, iteratedDeriv 3 (f ℓ) x := by
    rw [h_sub_eq, h_iterDeriv_tsum 3]
  exact ⟨h_sum_all x, h_sum_d1_all, h_sum_d1_shift, h_d1_all_eq, h_d1_shift_eq, h_d3_shift_eq⟩

theorem diagGreen_third_order_ode : ∃ δ_ode : ℝ, 0 < δ_ode ∧
      ∀ (κ : ℝ), 1 ≤ κ → ∀ (w : 𝓢(ℝ, ℝ)), ‖ι w‖ ≤ δ_ode →
        ∀ x : ℝ, iteratedDeriv 3 (fun y => diagGreen κ w y - 1 / (2 * κ)) x =
          2 * deriv w x * diagGreen κ w x +
          4 * w x * deriv (fun y => diagGreen κ w y - 1 / (2 * κ)) x +
          4 * κ ^ 2 * deriv (fun y => diagGreen κ w y - 1 / (2 * κ)) x :=
by
  obtain ⟨δ_ode, hδ_ode, h_tsum⟩ := diagGreen_sub_const_deriv_and_iteratedDeriv_three_tsum
  refine ⟨δ_ode, hδ_ode, ?_⟩
  intro κ hκ w hw x
  let h : ℕ → ℝ → ℝ := fun ℓ y => greenIterKernel κ w ℓ y y
  have hh0_eq : h 0 = fun _ => 1 / (2 * κ) := by
    ext y
    dsimp [h, greenIterKernel, freeGreenKernel]
    rw [sub_self, abs_zero, mul_zero, Real.exp_zero, mul_one]
  have hh_deriv_at : ∀ (ℓ : ℕ) (y : ℝ), HasDerivAt (h ℓ) (deriv (h ℓ) y) y := by
    intro ℓ y
    cases ℓ with
    | zero =>
      have hd0 : HasDerivAt (h 0) 0 y := by
        rw [hh0_eq]
        exact hasDerivAt_const y (1 / (2 * κ))
      rw [hd0.deriv]
      exact hd0
    | succ m =>
      have hdm : HasDerivAt (h (m + 1)) (2 * greenIterDerivY κ w (m + 1) y y) y :=
        greenIterKernel_diag_hasDerivAt κ hκ w m y
      rw [hdm.deriv]
      exact hdm
  have hh_deriv_eq : ∀ (ℓ : ℕ),
      deriv (h (ℓ + 1)) = fun y => 2 * greenIterDerivY κ w (ℓ + 1) y y := by
    intro ℓ
    ext y
    exact (greenIterKernel_diag_hasDerivAt κ hκ w ℓ y).deriv
  have hh_deriv2_eq : ∀ (ℓ : ℕ),
      iteratedDeriv 2 (h (ℓ + 1)) =
        fun y => 2 * κ ^ 2 * h (ℓ + 1) y + 2 * w y * h ℓ y + 2 * greenIterMixedDiag κ w ℓ y := by
    intro ℓ
    ext y
    have hd2 : HasDerivAt (deriv (h (ℓ + 1)))
        (2 * κ ^ 2 * h (ℓ + 1) y + 2 * w y * h ℓ y + 2 * greenIterMixedDiag κ w ℓ y) y := by
      rw [hh_deriv_eq ℓ]
      exact greenIterDerivY_diag_hasDerivAt κ hκ w ℓ y
    rw [show (2 : ℕ) = 1 + 1 from rfl, iteratedDeriv_succ, iteratedDeriv_one]
    exact hd2.deriv
  have hw_deriv : HasDerivAt w (deriv w x) x :=
    (w.smooth'.contDiffAt.differentiableAt (by norm_num)).hasDerivAt
  have h_ode_iter : ∀ ℓ : ℕ,
      iteratedDeriv 3 (h (ℓ + 1)) x =
        2 * deriv w x * h ℓ x +
        4 * w x * deriv (h ℓ) x +
        4 * κ ^ 2 * deriv (h (ℓ + 1)) x := by
    intro ℓ
    have hd_term1 : HasDerivAt (fun y => 2 * κ ^ 2 * h (ℓ + 1) y)
        (2 * κ ^ 2 * deriv (h (ℓ + 1)) x) x :=
      (hh_deriv_at (ℓ + 1) x).const_mul (2 * κ ^ 2)
    have hd_term2 : HasDerivAt (fun y => 2 * w y * h ℓ y)
        (2 * (deriv w x * h ℓ x + w x * deriv (h ℓ) x)) x := by
      have hd_prod : HasDerivAt (fun y => w y * h ℓ y)
          (deriv w x * h ℓ x + w x * deriv (h ℓ) x) x :=
        hw_deriv.mul (hh_deriv_at ℓ x)
      simpa [mul_assoc] using hd_prod.const_mul 2
    have hd_term3 : HasDerivAt (fun y => 2 * greenIterMixedDiag κ w ℓ y)
        (2 * (κ ^ 2 * deriv (h (ℓ + 1)) x + w x * deriv (h ℓ) x)) x :=
      (greenIterMixedDiag_hasDerivAt κ hκ w ℓ x).const_mul 2
    have hd3 : HasDerivAt (iteratedDeriv 2 (h (ℓ + 1)))
        (2 * κ ^ 2 * deriv (h (ℓ + 1)) x +
          2 * (deriv w x * h ℓ x + w x * deriv (h ℓ) x) +
          2 * (κ ^ 2 * deriv (h (ℓ + 1)) x + w x * deriv (h ℓ) x)) x := by
      rw [hh_deriv2_eq ℓ]
      exact (hd_term1.add hd_term2).add hd_term3
    have h_it3 : iteratedDeriv 3 (h (ℓ + 1)) x = deriv (iteratedDeriv 2 (h (ℓ + 1))) x := by
      rw [iteratedDeriv_succ]
    rw [h_it3, hd3.deriv]
    ring
  obtain ⟨h_sum0, h_sum1, h_sum2, h_d1_eq0, h_d1_eq1, h_d3_eq⟩ := h_tsum κ hκ w hw x
  change iteratedDeriv 3 (fun y => diagGreen κ w y - 1 / (2 * κ)) x = ∑' ℓ : ℕ, iteratedDeriv 3 (h (ℓ + 1)) x at h_d3_eq
  change deriv (fun y => diagGreen κ w y - 1 / (2 * κ)) x = ∑' ℓ : ℕ, deriv (h ℓ) x at h_d1_eq0
  change deriv (fun y => diagGreen κ w y - 1 / (2 * κ)) x = ∑' ℓ : ℕ, deriv (h (ℓ + 1)) x at h_d1_eq1
  rw [h_d3_eq]
  simp_rw [h_ode_iter]
  have hs0 : Summable (fun ℓ : ℕ => 2 * deriv w x * h ℓ x) := h_sum0.mul_left (2 * deriv w x)
  have hs1 : Summable (fun ℓ : ℕ => 4 * w x * deriv (h ℓ) x) := h_sum1.mul_left (4 * w x)
  have hs2 : Summable (fun ℓ : ℕ => 4 * κ ^ 2 * deriv (h (ℓ + 1)) x) := h_sum2.mul_left (4 * κ ^ 2)
  rw [(hs0.add hs1).tsum_add hs2, hs0.tsum_add hs1]
  rw [tsum_mul_left, tsum_mul_left, tsum_mul_left]
  rw [← h_d1_eq0, ← h_d1_eq1]
  rfl

theorem kdvRHS_orthogonality_diagGreen : ∃ δ₃ : ℝ, 0 < δ₃ ∧
      ∀ (κ : ℝ), 1 ≤ κ → ∀ (w : 𝓢(ℝ, ℝ)), ‖ι w‖ ≤ δ₃ →
        ∫ x : ℝ, (1 / (2 * κ) - diagGreen κ w x) * kdvRHS w x = 0 :=
by
  obtain ⟨δ_reg, hδ_reg, h_reg⟩ := diagGreen_sub_const_mem_schwartz
  obtain ⟨δ_ode, hδ_ode, h_ode⟩ := diagGreen_third_order_ode
  refine ⟨min δ_reg δ_ode, lt_min hδ_reg hδ_ode, ?_⟩
  intro κ hκ w hw
  have hw_reg : ‖ι w‖ ≤ δ_reg := le_trans hw (min_le_left _ _)
  have hw_ode : ‖ι w‖ ≤ δ_ode := le_trans hw (min_le_right _ _)
  obtain ⟨g_tilde, hg_eq⟩ := h_reg κ hκ w hw_reg
  have h_sub_eq : (fun y => diagGreen κ w y - 1 / (2 * κ)) = (g_tilde : ℝ → ℝ) := by
    ext y
    rw [hg_eq y]
    ring
  have hg_ode : ∀ x : ℝ, iteratedDeriv 3 g_tilde x =
      2 * deriv w x * (1 / (2 * κ) + g_tilde x) +
      4 * w x * deriv g_tilde x +
      4 * κ ^ 2 * deriv g_tilde x := by
    intro x
    have hx := h_ode κ hκ w hw_ode x
    rw [h_sub_eq, hg_eq x] at hx
    exact hx
  have h_integrand : (fun x : ℝ => (1 / (2 * κ) - diagGreen κ w x) * kdvRHS w x) =
      (fun x : ℝ => -(g_tilde x) * kdvRHS w x) := by
    ext x
    rw [hg_eq x]
    ring
  rw [h_integrand]
  let D : 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ) := fun f => SchwartzMap.derivCLM ℝ ℝ f
  have hD_apply : ∀ (f : 𝓢(ℝ, ℝ)) (x : ℝ), D f x = deriv f x :=
    fun f x => SchwartzMap.derivCLM_apply ℝ f x
  have hD2_apply : ∀ (f : 𝓢(ℝ, ℝ)) (x : ℝ), D (D f) x = iteratedDeriv 2 f x := by
    intro f x
    rw [hD_apply]
    have h : (D f : ℝ → ℝ) = iteratedDeriv 1 f := by
      ext y
      rw [hD_apply, iteratedDeriv_one]
    rw [h, ← iteratedDeriv_succ]
  have hD3_apply : ∀ (f : 𝓢(ℝ, ℝ)) (x : ℝ), D (D (D f)) x = iteratedDeriv 3 f x := by
    intro f x
    rw [hD_apply]
    have h : (D (D f) : ℝ → ℝ) = iteratedDeriv 2 f := funext (hD2_apply f)
    rw [h, ← iteratedDeriv_succ]
  have h_hasDerivAt : ∀ (f : 𝓢(ℝ, ℝ)) (x : ℝ), HasDerivAt f (D f x) x := by
    intro f x
    rw [hD_apply]
    exact (f.smooth'.contDiffAt.differentiableAt (by norm_num)).hasDerivAt
  have h_mul_int : ∀ (f g : 𝓢(ℝ, ℝ)), Integrable (fun x => f x * g x) volume := by
    intro f g
    have hg : Integrable g volume := g.integrable
    have hf_cont : Continuous f := f.continuous
    obtain ⟨C, hC⟩ := f.toBoundedContinuousFunction.isBounded_range.exists_norm_le
    exact hg.bdd_mul hf_cont.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => hC (f x) ⟨x, rfl⟩)
  have h_mul3_int : ∀ (f g h : 𝓢(ℝ, ℝ)), Integrable (fun x => f x * g x * h x) volume := by
    intro f g h
    have hgh : Integrable (fun x => g x * h x) volume := h_mul_int g h
    have hf_cont : Continuous f := f.continuous
    obtain ⟨C, hC⟩ := f.toBoundedContinuousFunction.isBounded_range.exists_norm_le
    have := hgh.bdd_mul hf_cont.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => hC (f x) ⟨x, rfl⟩)
    simpa [mul_assoc] using this
  let w0 : 𝓢(ℝ, ℝ) := w
  let w1 : 𝓢(ℝ, ℝ) := D w0
  let w2 : 𝓢(ℝ, ℝ) := D w1
  let w3 : 𝓢(ℝ, ℝ) := D w2
  let g0 : 𝓢(ℝ, ℝ) := g_tilde
  let g1 : 𝓢(ℝ, ℝ) := D g0
  let g2 : 𝓢(ℝ, ℝ) := D g1
  let g3 : 𝓢(ℝ, ℝ) := D g2
  let Ψ : ℝ → ℝ := fun x =>
    (g0 x * w2 x - g1 x * w1 x + g2 x * w0 x) -
    (4 * (w0 x * w0 x * g0 x) + (1 / (2 * κ)) * (w0 x * w0 x)) -
    2 * κ ^ 2 * (g2 x - 2 * (w0 x * g0 x) - (1 / κ) * w0 x - 4 * κ ^ 2 * g0 x)
  have hΨ_deriv : ∀ x : ℝ, HasDerivAt Ψ (-(g_tilde x) * kdvRHS w x) x := by
    intro x
    have hw0 := h_hasDerivAt w0 x
    have hw1 := h_hasDerivAt w1 x
    have hw2 := h_hasDerivAt w2 x
    have hg0 := h_hasDerivAt g0 x
    have hg1 := h_hasDerivAt g1 x
    have hg2 := h_hasDerivAt g2 x
    have hd : HasDerivAt Ψ
        (((g1 x * w2 x + g0 x * w3 x) - (g2 x * w1 x + g1 x * w2 x) + (g3 x * w0 x + g2 x * w1 x)) -
        (4 * ((w1 x * w0 x + w0 x * w1 x) * g0 x + (w0 x * w0 x) * g1 x) +
          (1 / (2 * κ)) * (w1 x * w0 x + w0 x * w1 x)) -
        2 * κ ^ 2 * (g3 x - 2 * (w1 x * g0 x + w0 x * g1 x) - (1 / κ) * w1 x - 4 * κ ^ 2 * g1 x)) x :=
      (((hg0.mul hw2).sub (hg1.mul hw1)).add (hg2.mul hw0)).sub
        (((hw0.mul hw0).mul hg0).const_mul 4 |>.add ((hw0.mul hw0).const_mul (1 / (2 * κ)))) |>.sub
        (((hg2.sub ((hw0.mul hg0).const_mul 2)).sub (hw0.const_mul (1 / κ))).sub
          (hg0.const_mul (4 * κ ^ 2)) |>.const_mul (2 * κ ^ 2))
    convert hd using 1
    dsimp only [kdvRHS, w0, w1, w2, w3, g0, g1, g2, g3]
    rw [hD3_apply w x, hD_apply w x, hD3_apply g_tilde x, hD_apply g_tilde x, hg_ode x]
    have hκ_ne : κ ≠ 0 := by linarith
    field_simp
    ring
  have hΨ_tendsto : ∀ l : Filter ℝ, l ≤ Filter.cocompact ℝ → Filter.Tendsto Ψ l (nhds 0) := by
    intro l hl
    have hz : ∀ f : 𝓢(ℝ, ℝ), Filter.Tendsto f l (nhds 0) := fun f =>
      (ZeroAtInftyContinuousMapClass.zero_at_infty f).mono_left hl
    have h2 : ∀ f g : 𝓢(ℝ, ℝ), Filter.Tendsto (fun x => f x * g x) l (nhds 0) := fun f g => by
      simpa using (hz f).mul (hz g)
    have h3 : ∀ f g h : 𝓢(ℝ, ℝ), Filter.Tendsto (fun x => f x * g x * h x) l (nhds 0) := fun f g h => by
      simpa using (h2 f g).mul (hz h)
    have ht1 : Filter.Tendsto (fun x => g0 x * w2 x - g1 x * w1 x + g2 x * w0 x) l (nhds 0) := by
      simpa using ((h2 g0 w2).sub (h2 g1 w1)).add (h2 g2 w0)
    have ht2 : Filter.Tendsto (fun x => 4 * (w0 x * w0 x * g0 x) + (1 / (2 * κ)) * (w0 x * w0 x)) l (nhds 0) := by
      simpa using ((h3 w0 w0 g0).const_mul 4).add ((h2 w0 w0).const_mul (1 / (2 * κ)))
    have ht3 : Filter.Tendsto (fun x => 2 * κ ^ 2 * (g2 x - 2 * (w0 x * g0 x) - (1 / κ) * w0 x - 4 * κ ^ 2 * g0 x)) l (nhds 0) := by
      simpa using (((hz g2).sub ((h2 w0 g0).const_mul 2)).sub ((hz w0).const_mul (1 / κ)) |>.sub
        ((hz g0).const_mul (4 * κ ^ 2))).const_mul (2 * κ ^ 2)
    simpa [Ψ] using (ht1.sub ht2).sub ht3
  have h_int : Integrable (fun x => -(g_tilde x) * kdvRHS w x) volume := by
    have h_eq : (fun x => -(g_tilde x) * kdvRHS w x) =
        fun x => g0 x * w3 x - 6 * (g0 x * w0 x * w1 x) := by
      ext x
      dsimp only [kdvRHS, w0, w1, w2, w3, g0]
      rw [hD3_apply w x, hD_apply w x]
      ring
    rw [h_eq]
    exact (h_mul_int g0 w3).sub ((h_mul3_int g0 w0 w1).const_mul 6)
  have h_ftc := MeasureTheory.integral_of_hasDerivAt_of_tendsto hΨ_deriv h_int
    (hΨ_tendsto Filter.atBot atBot_le_cocompact)
    (hΨ_tendsto Filter.atTop atTop_le_cocompact)
  linarith

theorem kdv_alpha_conservation_small_data (h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → IsSchwartzSolution v → u 0 = v 0 → u = v)
    (δ : ℝ) (hδ : 0 < δ) :
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ δ₀ ≤ δ ∧
      ∀ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u → ‖ι (u 0)‖ ≤ δ₀ →
        (∀ t : ℝ, ‖ι (u t)‖ ≤ δ) ∧
        (∀ κ : ℝ, 1 ≤ κ → ∀ t : ℝ, alphaFunctional κ (u t) = alphaFunctional κ (u 0)) :=
by
  obtain ⟨δ₁, c₁, c₂, hδ₁, hc₁, hc₁₂, h_quad⟩ := alphaFunctional_one_quadratic_bounds
  obtain ⟨δ₂, hδ₂, h_deriv⟩ := alphaFunctional_hasDerivAt_kdv
  obtain ⟨δ₃, hδ₃, h_ortho⟩ := kdvRHS_orthogonality_diagGreen
  have hc₂ : 0 < c₂ := lt_of_lt_of_le hc₁ hc₁₂
  set δ' : ℝ := min δ (min δ₁ (min δ₂ δ₃))
  have hδ' : 0 < δ' := by positivity
  have hδ'_le_δ : δ' ≤ δ := min_le_left _ _
  have hδ'_le_δ₁ : δ' ≤ δ₁ := le_trans (min_le_right _ _) (min_le_left _ _)
  have hδ'_le_δ₂ : δ' ≤ δ₂ :=
    le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
  have hδ'_le_δ₃ : δ' ≤ δ₃ :=
    le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
  set δ₀ : ℝ := (c₁ / (2 * c₂)) * δ'
  have hδ₀_pos : 0 < δ₀ := by positivity
  have hδ₀_le_half : δ₀ ≤ δ' / 2 := by
    have h_div_le : c₁ / (2 * c₂) ≤ 1 / 2 := by
      rw [div_le_div_iff₀ (by positivity) (by positivity)]
      linarith
    calc δ₀ = (c₁ / (2 * c₂)) * δ' := rfl
      _ ≤ (1 / 2) * δ' := mul_le_mul_of_nonneg_right h_div_le (le_of_lt hδ')
      _ = δ' / 2 := by ring
  have hδ₀_le_δ : δ₀ ≤ δ := by linarith
  refine ⟨δ₀, hδ₀_pos, hδ₀_le_δ, ?_⟩
  intro u hu hu0
  have h_local_cons : ∀ (t : ℝ), (∀ s ∈ Set.uIcc 0 t, ‖ι (u s)‖ ≤ δ') →
      ∀ (κ : ℝ), 1 ≤ κ → alphaFunctional κ (u t) = alphaFunctional κ (u 0) := by
    intro t h_ball κ hκ
    let g : ℝ → ℝ := fun τ => alphaFunctional κ (u τ)
    have hg_deriv : ∀ s ∈ Set.uIcc 0 t, HasDerivAt g 0 s := by
      intro s hs
      have hs_δ₂ : ‖ι (u s)‖ ≤ δ₂ := le_trans (h_ball s hs) hδ'_le_δ₂
      have hs_δ₃ : ‖ι (u s)‖ ≤ δ₃ := le_trans (h_ball s hs) hδ'_le_δ₃
      have hd := h_deriv u hu κ hκ s hs_δ₂
      rw [h_ortho κ hκ (u s) hs_δ₃] at hd
      exact hd
    have h_mvt : ∀ (a b : ℝ), a < b → Set.Icc a b ⊆ Set.uIcc 0 t → g b = g a := by
      intro a b hab h_sub
      have h_cont_ab : ContinuousOn g (Set.Icc a b) :=
        fun x hx => (hg_deriv x (h_sub hx)).continuousAt.continuousWithinAt
      have h_deriv_ab : ∀ x ∈ Set.Ioo a b, HasDerivAt g 0 x :=
        fun x hx => hg_deriv x (h_sub (Set.Ioo_subset_Icc_self hx))
      obtain ⟨c, _, hc_slope⟩ :=
        exists_hasDerivAt_eq_slope g (fun _ => 0) hab h_cont_ab h_deriv_ab
      have h_ne : b - a ≠ 0 := ne_of_gt (sub_pos.mpr hab)
      have h_sub_zero : g b - g a = 0 := (div_eq_zero_iff.mp hc_slope.symm).resolve_right h_ne
      exact sub_eq_zero.mp h_sub_zero
    rcases lt_trichotomy 0 t with ht_pos | rfl | ht_neg
    · exact h_mvt 0 t ht_pos Set.Icc_subset_uIcc
    · rfl
    · exact (h_mvt t 0 ht_neg Set.Icc_subset_uIcc').symm
  have hf_step : ∀ (t : ℝ), (∀ s ∈ Set.uIcc 0 t, ‖ι (u s)‖ ≤ δ') → ‖ι (u t)‖ ≤ δ' / 2 := by
    intro t h_ball
    have hu0_δ₁ : ‖ι (u 0)‖ ≤ δ₁ := le_trans (h_ball 0 Set.left_mem_uIcc) hδ'_le_δ₁
    have hut_δ₁ : ‖ι (u t)‖ ≤ δ₁ := le_trans (h_ball t Set.right_mem_uIcc) hδ'_le_δ₁
    have h_cons_1 : alphaFunctional 1 (u t) = alphaFunctional 1 (u 0) :=
      h_local_cons t h_ball 1 le_rfl
    have h_ut_lower : c₁ * ‖ι (u t)‖ ^ 2 ≤ alphaFunctional 1 (u t) :=
      (h_quad (u t) hut_δ₁).1
    have h_u0_upper : alphaFunctional 1 (u 0) ≤ c₂ * ‖ι (u 0)‖ ^ 2 :=
      (h_quad (u 0) hu0_δ₁).2
    have h_u0_sq : ‖ι (u 0)‖ ^ 2 ≤ δ₀ ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) hu0 2
    have h_c2_le : c₂ * ‖ι (u 0)‖ ^ 2 ≤ c₂ * δ₀ ^ 2 :=
      mul_le_mul_of_nonneg_left h_u0_sq (le_of_lt hc₂)
    have h_alg : c₂ * δ₀ ^ 2 ≤ c₁ * (δ' / 2) ^ 2 := by
      have h_diff : c₁ * (δ' / 2) ^ 2 - c₂ * δ₀ ^ 2 =
          c₁ * (c₂ - c₁) * δ' ^ 2 / (4 * c₂) := by
        dsimp [δ₀]
        have : c₂ ≠ 0 := ne_of_gt hc₂
        field_simp
        ring
      have h_nonneg : 0 ≤ c₁ * (c₂ - c₁) * δ' ^ 2 / (4 * c₂) := by
        have : 0 ≤ c₂ - c₁ := sub_nonneg.mpr hc₁₂
        positivity
      linarith
    have h_c1_sq : c₁ * ‖ι (u t)‖ ^ 2 ≤ c₁ * (δ' / 2) ^ 2 := by linarith
    have h_sq_le : ‖ι (u t)‖ ^ 2 ≤ (δ' / 2) ^ 2 :=
      le_of_mul_le_mul_left h_c1_sq hc₁
    exact (abs_le_of_sq_le_sq' h_sq_le (by positivity)).2
  have h_abs_uIcc : ∀ {a b : ℝ}, a ∈ Set.uIcc 0 b → |a| ≤ |b| ∧ (|a| = |b| → a = b) := by
    intro a b h
    rw [Set.mem_uIcc] at h
    rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · have hb : 0 ≤ b := le_trans h1 h2
      rw [abs_of_nonneg h1, abs_of_nonneg hb]
      exact ⟨h2, id⟩
    · have hb : b ≤ 0 := le_trans h1 h2
      rw [abs_of_nonpos h2, abs_of_nonpos hb]
      exact ⟨by linarith, fun h_eq => by linarith⟩
  let f : ℝ → ℝ := fun τ => ‖ι (u τ)‖
  have hf_cont : Continuous f := (schwartz_solution_continuous_hm1 u hu).norm
  have hf_all : ∀ τ : ℝ, f τ ≤ δ' := by
    intro τ
    by_contra! h_gt
    let S : Set ℝ := Set.uIcc 0 τ ∩ {s : ℝ | δ' ≤ f s}
    have hS_compact : IsCompact S :=
      isCompact_uIcc.inter_right (isClosed_Ici.preimage hf_cont)
    have hS_nonempty : S.Nonempty := ⟨τ, Set.right_mem_uIcc, le_of_lt h_gt⟩
    obtain ⟨s₀, ⟨hs₀_uIcc, hs₀_ge⟩, hs₀_min⟩ :=
      hS_compact.exists_isMinOn hS_nonempty continuous_abs.continuousOn
    change δ' ≤ f s₀ at hs₀_ge
    have h_le_s₀ : ∀ s ∈ Set.uIcc 0 s₀, f s ≤ δ' := by
      intro s hs
      by_contra! hs_gt
      have hδ'_mem : δ' ∈ Set.uIcc (f 0) (f s) :=
        Set.mem_uIcc.mpr (Or.inl ⟨by linarith [show f 0 ≤ δ₀ from hu0, hδ₀_le_half], le_of_lt hs_gt⟩)
      obtain ⟨s₁, hs₁_mem, hs₁_eq⟩ :=
        intermediate_value_uIcc hf_cont.continuousOn hδ'_mem
      have hs_sub : Set.uIcc 0 s ⊆ Set.uIcc 0 s₀ := Set.uIcc_subset_uIcc_left hs
      have hs₀_sub : Set.uIcc 0 s₀ ⊆ Set.uIcc 0 τ := Set.uIcc_subset_uIcc_left hs₀_uIcc
      have hs₁_in_S : s₁ ∈ S := ⟨hs₀_sub (hs_sub hs₁_mem), le_of_eq hs₁_eq.symm⟩
      have h_min_s₁ : |s₀| ≤ |s₁| := hs₀_min hs₁_in_S
      have h_abs1 := h_abs_uIcc hs₁_mem
      have h_abs2 := h_abs_uIcc hs
      have h_eq1 : s₁ = s := h_abs1.2 (by linarith [h_abs1.1, h_abs2.1])
      subst h_eq1
      linarith
    have hs₀_half : f s₀ ≤ δ' / 2 := hf_step s₀ h_le_s₀
    linarith
  refine ⟨fun t => le_trans (hf_all t) hδ'_le_δ, fun κ hκ t => ?_⟩
  exact h_local_cons t (fun s _ => hf_all s) κ hκ

theorem alphaFunctional_hasDerivAt_regFlow : ∃ δ₂ : ℝ, 0 < δ₂ ∧
      ∀ (κ : ℝ), 2 ≤ κ → ∀ (M : ℝ), 1 ≤ M →
        ∀ (w : ℝ → 𝓢(ℝ, ℝ)) (v : 𝓢(ℝ, ℝ)) (s : ℝ),
          HasDerivAt w v s →
          (∀ x : ℝ, v x = regFlowRHS κ (w s) x) →
          ‖ι (w s)‖ ≤ δ₂ →
          HasDerivAt (fun τ => alphaFunctional M (w τ))
            (∫ x : ℝ, (1 / (2 * M) - diagGreen M (w s) x) * regFlowRHS κ (w s) x) s :=
by
  have schwartz_hasDerivAt_quad_seminorm_and_hm1_tendsto :
      ∀ (w : ℝ → 𝓢(ℝ, ℝ)) (v : 𝓢(ℝ, ℝ)) (s : ℝ),
        HasDerivAt w v s →
        (∀ (f : 𝓢(ℝ, ℝ)) (y : ℝ),
          |f y| ≤ (2 * ((SchwartzMap.seminorm ℝ 0 0 + SchwartzMap.seminorm ℝ 4 0 : Seminorm ℝ 𝓢(ℝ, ℝ)) f)) * ((1 + y ^ 2)⁻¹) ^ 2) ∧
        Filter.Tendsto (fun τ : ℝ => ‖ι (w τ)‖) (nhds s) (nhds ‖ι (w s)‖) ∧
        Filter.Tendsto (fun τ : ℝ => ‖τ - s‖⁻¹ * ∫ y : ℝ, |w τ y - w s y - (τ - s) * v y|) (nhds s) (nhds 0) ∧
        Filter.Tendsto (fun τ : ℝ => ‖τ - s‖⁻¹ * (2 * ((SchwartzMap.seminorm ℝ 0 0 + SchwartzMap.seminorm ℝ 4 0 : Seminorm ℝ 𝓢(ℝ, ℝ)) (w τ - w s))) ^ 2) (nhds s) (nhds 0) := by
    intro w v s h_deriv
    let p : Seminorm ℝ 𝓢(ℝ, ℝ) := SchwartzMap.seminorm ℝ 0 0 + SchwartzMap.seminorm ℝ 4 0
    have hp_decay : ∀ (f : 𝓢(ℝ, ℝ)) (y : ℝ), |f y| ≤ (2 * p f) * ((1 + y ^ 2)⁻¹) ^ 2 := by
      intro f y
      set D : ℝ := |f y|
      have hD_nn : 0 ≤ D := abs_nonneg _
      have h0 := SchwartzMap.le_seminorm' ℝ 0 0 f y
      rw [pow_zero, one_mul, iteratedDeriv_zero, Real.norm_eq_abs] at h0
      have h4 := SchwartzMap.le_seminorm' ℝ 4 0 f y
      have hy4 : |y| ^ 4 = y ^ 4 := by
        calc |y| ^ 4 = (|y| ^ 2) ^ 2 := by ring
          _ = (y ^ 2) ^ 2 := by rw [sq_abs]
          _ = y ^ 4 := by ring
      rw [hy4, iteratedDeriv_zero, Real.norm_eq_abs] at h4
      have h_poly : (1 + y ^ 2) ^ 2 ≤ 2 * (1 + y ^ 4) := by
        nlinarith [sq_nonneg (1 - y ^ 2)]
      have h_mul : (1 + y ^ 2) ^ 2 * D ≤ 2 * p f := by
        change (1 + y ^ 2) ^ 2 * D ≤ 2 * ((SchwartzMap.seminorm ℝ 0 0) f + (SchwartzMap.seminorm ℝ 4 0) f)
        calc (1 + y ^ 2) ^ 2 * D
          _ ≤ (2 * (1 + y ^ 4)) * D := mul_le_mul_of_nonneg_right h_poly hD_nn
          _ = 2 * (D + y ^ 4 * D) := by ring
          _ ≤ 2 * ((SchwartzMap.seminorm ℝ 0 0) f + (SchwartzMap.seminorm ℝ 4 0) f) := by
            linarith [h0, h4]
      have h_ne : 1 + y ^ 2 ≠ 0 := ne_of_gt (by positivity)
      calc D = ((1 + y ^ 2) ^ 2 * D) * ((1 + y ^ 2)⁻¹) ^ 2 := by
            field_simp [h_ne]
        _ ≤ (2 * p f) * ((1 + y ^ 2)⁻¹) ^ 2 :=
            mul_le_mul_of_nonneg_right h_mul (by positivity)
    let L := SchwartzMap.toLpCLM ℝ ℝ 1 (volume : Measure ℝ)
    have h_L1 : ∀ q : 𝓢(ℝ, ℝ), (∫ y : ℝ, |q y|) = ‖L q‖ := by
      intro q
      simp_rw [← Real.norm_eq_abs]
      rw [integral_norm_eq_lintegral_enorm q.continuous.aestronglyMeasurable,
          ← eLpNorm_one_eq_lintegral_enorm,
          eLpNorm_congr_ae (q.coeFn_toLp 1 volume).symm,
          ← Lp.norm_def,
          SchwartzMap.toLpCLM_apply]
    have h_rem_L1 : ∀ τ : ℝ,
        (∫ y : ℝ, |w τ y - w s y - (τ - s) * v y|) = ‖L (w τ - w s - (τ - s) • v)‖ :=
      fun τ => h_L1 (w τ - w s - (τ - s) • v)
    have h_diff_L1 : ∀ τ : ℝ,
        (∫ y : ℝ, |w τ y - w s y|) = ‖L (w τ - w s)‖ :=
      fun τ => h_L1 (w τ - w s)
    have h_inv_smul : Filter.Tendsto
        (fun τ : ℝ => (τ - s)⁻¹ • (w τ - w s - (ContinuousLinearMap.toSpanSingleton ℝ v) (τ - s)))
        (nhds s) (nhds 0) :=
      h_deriv.isLittleOTVS.tendsto_inv_smul
    have h_norm_cont : Continuous (fun q : 𝓢(ℝ, ℝ) => ‖L q‖) :=
      continuous_norm.comp L.continuous
    have h_norm_tendsto : Filter.Tendsto
        (fun τ : ℝ => ‖L ((τ - s)⁻¹ • (w τ - w s - (ContinuousLinearMap.toSpanSingleton ℝ v) (τ - s)))‖)
        (nhds s) (nhds 0) := by
      simpa using (h_norm_cont.tendsto 0).comp h_inv_smul
    have h_lin : Filter.Tendsto
        (fun τ : ℝ => ‖τ - s‖⁻¹ * ∫ y : ℝ, |w τ y - w s y - (τ - s) * v y|)
        (nhds s) (nhds 0) := by
      refine h_norm_tendsto.congr (fun τ => ?_)
      dsimp only [Function.comp_apply]
      rw [ContinuousLinearMap.toSpanSingleton_apply, map_smul, norm_smul, norm_inv, h_rem_L1 τ]
    let Q₁ : ℝ → ℝ := fun τ => ‖τ - s‖⁻¹ * ∫ y : ℝ, |w τ y - w s y - (τ - s) * v y|
    have hL_diff_bound : ∀ τ : ℝ, ‖L (w τ - w s)‖ ≤ ‖τ - s‖ * (Q₁ τ + ‖L v‖) := by
      intro τ
      have h_alg : w τ - w s = (w τ - w s - (τ - s) • v) + (τ - s) • v := by
        rw [sub_add_cancel]
      have h_tri : ‖L (w τ - w s)‖ ≤ ‖L (w τ - w s - (τ - s) • v)‖ + ‖τ - s‖ * ‖L v‖ := by
        calc ‖L (w τ - w s)‖
          _ = ‖L ((w τ - w s - (τ - s) • v) + (τ - s) • v)‖ := by rw [← h_alg]
          _ = ‖L (w τ - w s - (τ - s) • v) + (τ - s) • L v‖ := by rw [map_add, map_smul]
          _ ≤ ‖L (w τ - w s - (τ - s) • v)‖ + ‖(τ - s) • L v‖ := norm_add_le _ _
          _ = ‖L (w τ - w s - (τ - s) • v)‖ + ‖τ - s‖ * ‖L v‖ := by rw [norm_smul]
      have h_rem_eq : ‖L (w τ - w s - (τ - s) • v)‖ = ‖τ - s‖ * Q₁ τ := by
        dsimp [Q₁]
        rw [h_rem_L1 τ]
        by_cases hτ : τ = s
        · subst hτ; simp
        · have h_ne : ‖τ - s‖ ≠ 0 := norm_ne_zero_iff.mpr (sub_ne_zero.mpr hτ)
          exact (mul_inv_cancel_left₀ h_ne _).symm
      linarith
    have hp_cont : Continuous (fun q : 𝓢(ℝ, ℝ) => p q) := by
      have h0 : Continuous (SchwartzMap.seminorm ℝ 0 0 : 𝓢(ℝ, ℝ) → ℝ) :=
        (schwartz_withSeminorms ℝ ℝ ℝ).continuous_seminorm ⟨0, 0⟩
      have h4 : Continuous (SchwartzMap.seminorm ℝ 4 0 : 𝓢(ℝ, ℝ) → ℝ) :=
        (schwartz_withSeminorms ℝ ℝ ℝ).continuous_seminorm ⟨4, 0⟩
      exact h0.add h4
    have h2p_cont : Continuous (fun q : 𝓢(ℝ, ℝ) => 2 * p q) :=
      continuous_const.mul hp_cont
    have h2p_tendsto : Filter.Tendsto
        (fun τ : ℝ => 2 * p ((τ - s)⁻¹ • (w τ - w s - (ContinuousLinearMap.toSpanSingleton ℝ v) (τ - s))))
        (nhds s) (nhds 0) := by
      have h0 : 2 * p 0 = 0 := by rw [map_zero, mul_zero]
      simpa [h0] using (h2p_cont.tendsto 0).comp h_inv_smul
    let Q_p : ℝ → ℝ := fun τ => ‖τ - s‖⁻¹ * (2 * p (w τ - w s - (τ - s) • v))
    have hQp_tendsto : Filter.Tendsto Q_p (nhds s) (nhds 0) := by
      refine h2p_tendsto.congr (fun τ => ?_)
      dsimp only [Function.comp_apply, Q_p]
      rw [ContinuousLinearMap.toSpanSingleton_apply, map_smul_eq_mul, norm_inv]
      ring
    have h2p_diff_bound : ∀ τ : ℝ, 2 * p (w τ - w s) ≤ ‖τ - s‖ * (Q_p τ + 2 * p v) := by
      intro τ
      have h_alg : w τ - w s = (w τ - w s - (τ - s) • v) + (τ - s) • v := by
        rw [sub_add_cancel]
      have h_tri : p (w τ - w s) ≤ p (w τ - w s - (τ - s) • v) + ‖τ - s‖ * p v := by
        calc p (w τ - w s)
          _ = p ((w τ - w s - (τ - s) • v) + (τ - s) • v) := by rw [← h_alg]
          _ ≤ p (w τ - w s - (τ - s) • v) + p ((τ - s) • v) := map_add_le_add p _ _
          _ = p (w τ - w s - (τ - s) • v) + ‖τ - s‖ * p v := by rw [map_smul_eq_mul]
      have h_rem_eq : 2 * p (w τ - w s - (τ - s) • v) = ‖τ - s‖ * Q_p τ := by
        dsimp [Q_p]
        by_cases hτ : τ = s
        · subst hτ; simp
        · have h_ne : ‖τ - s‖ ≠ 0 := norm_ne_zero_iff.mpr (sub_ne_zero.mpr hτ)
          exact (mul_inv_cancel_left₀ h_ne _).symm
      linarith
    have h_quad_bound : ∀ τ : ℝ,
        ‖τ - s‖⁻¹ * (2 * p (w τ - w s)) ^ 2 ≤ ‖τ - s‖ * (Q_p τ + 2 * p v) ^ 2 := by
      intro τ
      have h_nn : 0 ≤ 2 * p (w τ - w s) := mul_nonneg zero_le_two (apply_nonneg p _)
      have h_sq : (2 * p (w τ - w s)) ^ 2 ≤ (‖τ - s‖ * (Q_p τ + 2 * p v)) ^ 2 :=
        pow_le_pow_left₀ h_nn (h2p_diff_bound τ) 2
      have h_mul : ‖τ - s‖⁻¹ * (2 * p (w τ - w s)) ^ 2 ≤ ‖τ - s‖⁻¹ * (‖τ - s‖ * (Q_p τ + 2 * p v)) ^ 2 :=
        mul_le_mul_of_nonneg_left h_sq (inv_nonneg.mpr (norm_nonneg _))
      have h_inv_sq : ‖τ - s‖⁻¹ * ‖τ - s‖ ^ 2 = ‖τ - s‖ := by
        rcases eq_or_ne ‖τ - s‖ 0 with h0 | hne
        · rw [h0]; ring
        · field_simp
      calc ‖τ - s‖⁻¹ * (2 * p (w τ - w s)) ^ 2
        _ ≤ ‖τ - s‖⁻¹ * (‖τ - s‖ * (Q_p τ + 2 * p v)) ^ 2 := h_mul
        _ = (‖τ - s‖⁻¹ * ‖τ - s‖ ^ 2) * (Q_p τ + 2 * p v) ^ 2 := by ring
        _ = ‖τ - s‖ * (Q_p τ + 2 * p v) ^ 2 := by rw [h_inv_sq]
    have h_norm_sub_tendsto : Filter.Tendsto (fun τ : ℝ => ‖τ - s‖) (nhds s) (nhds 0) := by
      have h_cont : Continuous (fun τ : ℝ => ‖τ - s‖) :=
        (continuous_id.sub continuous_const).norm
      simpa using h_cont.tendsto s
    have h_quad : Filter.Tendsto
        (fun τ : ℝ => ‖τ - s‖⁻¹ * (2 * p (w τ - w s)) ^ 2) (nhds s) (nhds 0) := by
      have h_factor : Filter.Tendsto
          (fun τ : ℝ => (Q_p τ + 2 * p v) ^ 2) (nhds s) (nhds ((0 + 2 * p v) ^ 2)) :=
        (hQp_tendsto.add tendsto_const_nhds).pow 2
      have h_upper : Filter.Tendsto
          (fun τ : ℝ => ‖τ - s‖ * (Q_p τ + 2 * p v) ^ 2) (nhds s) (nhds 0) := by
        simpa using h_norm_sub_tendsto.mul h_factor
      exact tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds h_upper
        (Filter.Eventually.of_forall fun τ => by positivity)
        (Filter.Eventually.of_forall h_quad_bound)
    have h_hm1_le_L1 : ∀ q₁ q₂ : 𝓢(ℝ, ℝ), ‖ι q₁ - ι q₂‖ ≤ ‖L (q₁ - q₂)‖ := by
      have norm_fourier_integrand : ∀ (q : ℝ → ℝ) (ξ x : ℝ),
          ‖Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)‖ = ‖q x‖ := by
        intro q ξ x
        have h_exp : -((ξ : ℂ) * (x : ℂ)) * I = ((-(ξ * x) : ℝ) : ℂ) * I := by push_cast; ring
