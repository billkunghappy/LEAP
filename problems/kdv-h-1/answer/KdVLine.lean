    have h_psi1_nn : 0 ≤ h1NormSq Ψ₁ := integral_nonneg (fun ξ => by positivity)
    have h_psi2_nn : 0 ≤ h1NormSq Ψ₂ := integral_nonneg (fun ξ => by positivity)
    have h_prod_le : h1NormSq (fun x => Ψ₁ x * Ψ₂ x) ≤ (1 / 1024) * (1 / 1024) := by
