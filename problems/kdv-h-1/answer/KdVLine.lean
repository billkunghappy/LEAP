        rw [dist_eq_norm, dist_eq_norm, ← h_sub q q₀, ← map_sub L q q₀]
        exact h_norm_le (q - q₀)
      exact lt_of_le_of_lt h_dist_le hq
    have h_cont_iota : Continuous ι := h_cont_toHm1.subtype_mk _
    exact (h_cont_iota.comp h_cont_u).norm

theorem regTruncatedVec_global_hm1_lipschitz : ∀ (δ_reg : ℝ), 0 < δ_reg →
    (∀ (κ : ℝ), 1 ≤ κ → ∀ (q : 𝓢(ℝ, ℝ)), ‖ι q‖ ≤ δ_reg →
      ∃ g_tilde : 𝓢(ℝ, ℝ), ∀ x : ℝ, diagGreen κ q x = 1 / (2 * κ) + g_tilde x) →
    ∀ (δ' : ℝ), 0 < δ' → 2 * δ' ≤ min δ_reg (1 / 256) →
      ∀ (κ : ℝ), 2 ≤ κ →
        (∀ (q : 𝓢(ℝ, ℝ)), ‖ι (regTruncatedVec δ' κ q)‖ ≤ 96 * κ ^ 5 * δ') ∧
        (∀ (q₁ q₂ : 𝓢(ℝ, ℝ)),
          ‖ι (regTruncatedVec δ' κ q₁) - ι (regTruncatedVec δ' κ q₂)‖ ≤
