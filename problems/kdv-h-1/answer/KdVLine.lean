  have h_c3 : ∀ ℓ : ℕ, ∀ x : ℝ,
      |greenIterKernel κ w ℓ x x| ≤
        (1 / (2 * π)) * ∫ ξ : ℝ, ‖iterWavePacket κ w ℓ x ξ‖ / (κ ^ 2 + ξ ^ 2) := by
