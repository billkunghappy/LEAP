            dsimp only [A_Δ, A]; rw [norm_mul, norm_mul]
      have h_int_g1 : Integrable (fun η : ℝ => A_Δ ℓ η * ‖fourierLine w₁ (ξ - η)‖ / (1 + η ^ 2)) := by
