      SchwartzMap.seminorm ℝ k n (r s) ≤ K * |s - s₀| * (Real.sqrt^[n + 3] |s - s₀|) := by
    intro k n
    obtain ⟨K_n, hK_n_nn, hK_n⟩ := h_unweighted n
    let m : ℕ := 2 ^ (n + 3) + 1
    obtain ⟨M, hM_nn, hM⟩ := h_r_sem (k + k * m) n
    refine ⟨K_n + M, by positivity, ?_⟩
    intro s hs
    by_cases h_eq : s = s₀
    · subst h_eq
      rw [hr₀, sub_self, abs_zero, h_sqrt_zero]
      simp
    · let h : ℝ := |s - s₀|
      have hh_pos : 0 < h := abs_pos.mpr (sub_ne_zero.mpr h_eq)
      have hh_nn : 0 ≤ h := le_of_lt hh_pos
      have hh_η : h ≤ η := le_trans hs (min_le_left _ _)
      let σ : ℝ := Real.sqrt^[n + 3] h
      have hσ_pos : 0 < σ := h_sqrt_pos (n + 3) h hh_pos
      have hσ_sq : σ ^ 2 = Real.sqrt^[n + 2] h := h_sqrt_sq (n + 2) h hh_nn
      have hσ_m : ((σ⁻¹) ^ m)⁻¹ = h * σ := by
        rw [inv_pow, inv_inv]
        dsimp [m]
        rw [pow_succ, h_sqrt_pow (n + 3) h hh_nn]
      have h_w := h_s2_2 k n m (r s) σ⁻¹ (inv_pos.mpr hσ_pos)
      have h_t1 : σ⁻¹ * SchwartzMap.seminorm ℝ 0 n (r s) ≤ K_n * h * σ := by
        calc σ⁻¹ * SchwartzMap.seminorm ℝ 0 n (r s)
          _ ≤ σ⁻¹ * (K_n * h * (Real.sqrt^[n + 2] h)) :=
            mul_le_mul_of_nonneg_left (hK_n s hs) (by positivity)
          _ = σ⁻¹ * (K_n * h * σ ^ 2) := by rw [← hσ_sq]
          _ = K_n * h * σ := by
            have : σ ≠ 0 := ne_of_gt hσ_pos
            field_simp
      have h_t2 : ((σ⁻¹) ^ m)⁻¹ * SchwartzMap.seminorm ℝ (k + k * m) n (r s) ≤ M * h * σ := by
        calc ((σ⁻¹) ^ m)⁻¹ * SchwartzMap.seminorm ℝ (k + k * m) n (r s)
          _ ≤ ((σ⁻¹) ^ m)⁻¹ * M :=
            mul_le_mul_of_nonneg_left (hM s hh_η) (by positivity)
          _ = (h * σ) * M := by rw [hσ_m]
          _ = M * h * σ := by ring
      change SchwartzMap.seminorm ℝ k n (r s) ≤ (K_n + M) * h * σ
      linarith
  let Q : ℝ → 𝓢(ℝ, ℝ) := fun s => (s - s₀)⁻¹ • r s
  have hQ_tendsto : Filter.Tendsto Q (nhds s₀) (nhds 0) := by
    rw [(schwartz_withSeminorms ℝ ℝ ℝ).tendsto_nhds]
    rintro ⟨k, n⟩ ε hε
    rw [SchwartzMap.schwartzSeminormFamily_apply]
    obtain ⟨K, hK_nn, hK⟩ := h_s3 k n
    have h_min_pos : 0 < min η 1 := lt_min hη one_pos
    have h_Icc_mem : Set.Icc (s₀ - min η 1) (s₀ + min η 1) ∈ nhds s₀ :=
      Icc_mem_nhds (by linarith) (by linarith)
    have h_upper_cont : Continuous (fun s : ℝ => K * (Real.sqrt^[n + 3] |s - s₀|)) :=
      continuous_const.mul ((h_sqrt_cont (n + 3)).comp (continuous_abs.comp (continuous_id.sub continuous_const)))
    have h_upper_zero : K * (Real.sqrt^[n + 3] |s₀ - s₀|) = 0 := by
      rw [sub_self, abs_zero, h_sqrt_zero, mul_zero]
    have h_upper_tendsto : Filter.Tendsto (fun s : ℝ => K * (Real.sqrt^[n + 3] |s - s₀|)) (nhds s₀) (nhds 0) := by
      rw [← h_upper_zero]
      exact h_upper_cont.continuousAt
    have h_ev_lt : ∀ᶠ s in nhds s₀, K * (Real.sqrt^[n + 3] |s - s₀|) < ε :=
      h_upper_tendsto.eventually (gt_mem_nhds hε)
    filter_upwards [h_Icc_mem, h_ev_lt] with s hs_mem hs_lt
    have hs_abs : |s - s₀| ≤ min η 1 :=
      abs_sub_le_iff.mpr ⟨by linarith [hs_mem.2], by linarith [hs_mem.1]⟩
    have h_sem_Q : SchwartzMap.seminorm ℝ k n (Q s - 0) ≤
        K * (Real.sqrt^[n + 3] |s - s₀|) := by
      rw [sub_zero]
      change SchwartzMap.seminorm ℝ k n ((s - s₀)⁻¹ • r s) ≤ K * (Real.sqrt^[n + 3] |s - s₀|)
      rw [map_smul_eq_mul, Real.norm_eq_abs, abs_inv]
      by_cases h_eq : s = s₀
      · subst h_eq
        rw [sub_self, abs_zero, inv_zero, zero_mul]
        exact mul_nonneg hK_nn (h_sqrt_nn (n + 3) 0 le_rfl)
      · have hh_pos : 0 < |s - s₀| := abs_pos.mpr (sub_ne_zero.mpr h_eq)
        calc |s - s₀|⁻¹ * SchwartzMap.seminorm ℝ k n (r s)
          _ ≤ |s - s₀|⁻¹ * (K * |s - s₀| * (Real.sqrt^[n + 3] |s - s₀|)) :=
            mul_le_mul_of_nonneg_left (hK s hs_abs) (by positivity)
          _ = K * (Real.sqrt^[n + 3] |s - s₀|) := by
            have : |s - s₀| ≠ 0 := ne_of_gt hh_pos
            field_simp
    exact lt_of_le_of_lt h_sem_Q hs_lt
  rw [hasDerivAt_iff_hasFDerivAt, HasFDerivAt, hasFDerivAtFilter_iff_isLittleOTVS]
  rw [Asymptotics.isLittleOTVS_iff_tendsto_inv_smul]
  · exact hQ_tendsto
  · refine Filter.Eventually.of_forall (fun s hs => ?_)
    rw [sub_eq_zero.mp hs]
    simp

theorem reg_flow_preserves_kdv_of_commutator (δ_brack : ℝ) (hδ_brack : 0 < δ_brack) :
    ∃ δ_prop : ℝ, 0 < δ_prop ∧ δ_prop ≤ δ_brack ∧
      ∀ κ : ℝ, 2 ≤ κ →
        (∀ q : 𝓢(ℝ, ℝ), ‖ι q‖ ≤ δ_brack → ∀ x : ℝ,
          (-∫ y : ℝ, greenKernel κ q x y * kdvRHS q y * greenKernel κ q y x =
            -iteratedDeriv 3 (diagGreen κ q) x + 6 * q x * deriv (diagGreen κ q) x) ∧
          (16 * κ ^ 5 * deriv (fun z => -∫ y : ℝ, greenKernel κ q z y * kdvRHS q y * greenKernel κ q y z) x +
              4 * κ ^ 2 * deriv (kdvRHS q) x =
            -iteratedDeriv 3 (regFlowRHS κ q) x + 6 * deriv (fun z => q z * regFlowRHS κ q z) x)) →
        ∀ V : ℝ → ℝ → 𝓢(ℝ, ℝ),
          (∀ s : ℝ, IsRegFlowSolution κ (fun τ => V s τ)) →
          IsSchwartzSolution (fun s => V s 0) →
          (∀ s τ : ℝ, ‖ι (V s τ)‖ ≤ δ_prop) →
          ∀ τ : ℝ, IsSchwartzSolution (fun s => V s τ) :=
by
  obtain ⟨δ_diag, hδ_diag, h_static⟩ := diagGreen_sub_const_schwartz_seminorm_step
  obtain ⟨δ_hm1, hδ_hm1_pos, hδ_hm1_le_brack, h_hm1⟩ :=
    reg_flow_kdv_taylor_remainder_hm1_sq_bound δ_brack hδ_brack
  set δ_prop : ℝ := min δ_diag δ_hm1
  have hδ_prop_pos : 0 < δ_prop := lt_min hδ_diag hδ_hm1_pos
  have hδ_prop_le_diag : δ_prop ≤ δ_diag := min_le_left _ _
  have hδ_prop_le_hm1 : δ_prop ≤ δ_hm1 := min_le_right _ _
  have hδ_prop_le_brack : δ_prop ≤ δ_brack := le_trans hδ_prop_le_hm1 hδ_hm1_le_brack
  refine ⟨δ_prop, hδ_prop_pos, hδ_prop_le_brack, ?_⟩
  intro κ hκ h_brack V hV_reg hV_kdv0 hV_ball τ s₀
  let D : 𝓢(ℝ, ℝ) →L[ℝ] 𝓢(ℝ, ℝ) := SchwartzMap.derivCLM ℝ ℝ
  let q₀ : 𝓢(ℝ, ℝ) := V s₀ τ
  let v₀ : 𝓢(ℝ, ℝ) :=
    -(D (D (D q₀))) + (6 : ℝ) • SchwartzMap.smulLeftCLM ℝ q₀ (D q₀)
  have hv₀_eq : ∀ x : ℝ, v₀ x = kdvRHS (V s₀ τ) x := by
    intro x
    change -(D (D (D q₀)) x) + 6 * (SchwartzMap.smulLeftCLM ℝ q₀ (D q₀) x) =
      -iteratedDeriv 3 q₀ x + 6 * q₀ x * deriv q₀ x
    have hD3 : D (D (D q₀)) x = iteratedDeriv 3 q₀ x := by
      have h1 : (D (D (D q₀)) : ℝ → ℝ) = deriv (deriv (deriv q₀)) := rfl
      rw [h1, iteratedDeriv_succ, iteratedDeriv_succ, iteratedDeriv_succ, iteratedDeriv_zero]
    have h_mul : SchwartzMap.smulLeftCLM ℝ q₀ (D q₀) x = q₀ x * deriv q₀ x := by
      have h_smul := SchwartzMap.smulLeftCLM_apply_apply q₀.hasTemperateGrowth (D q₀) x
      simpa [smul_eq_mul] using h_smul
    rw [hD3, h_mul]
    ring
  refine ⟨v₀, ?_, hv₀_eq⟩
  obtain ⟨C, η₁, hC_nn, hη₁_pos, h_cube⟩ :=
    h_hm1 κ hκ h_brack V hV_reg hV_kdv0
      (fun s' τ' => le_trans (hV_ball s' τ') hδ_prop_le_hm1) s₀ τ v₀ hv₀_eq
  have h_cont_V0 : Continuous (fun s : ℝ => V s 0) := by
    rw [continuous_iff_continuousAt]
    intro t
    obtain ⟨v, h_deriv, _⟩ := hV_kdv0 t
    have h_inv_smul := h_deriv.isLittleOTVS.tendsto_inv_smul
    have h_sub_tendsto : Filter.Tendsto (fun t' : ℝ => t' - t) (nhds t) (nhds 0) := by
      simpa [sub_self] using
        (continuousAt_id.sub (continuousAt_const : ContinuousAt (fun _ : ℝ => t) t)).tendsto
    have h_smul_zero : Filter.Tendsto
        (fun t' : ℝ => (t' - t) • ((t' - t)⁻¹ •
          (V t' 0 - V t 0 - (ContinuousLinearMap.toSpanSingleton ℝ v) (t' - t))))
        (nhds t) (nhds 0) := by
      simpa using h_sub_tendsto.smul h_inv_smul
    have h_rem_eq :
        (fun t' : ℝ => (t' - t) • ((t' - t)⁻¹ •
          (V t' 0 - V t 0 - (ContinuousLinearMap.toSpanSingleton ℝ v) (t' - t)))) =
        (fun t' : ℝ => V t' 0 - V t 0 - (t' - t) • v) := by
      ext t' : 1
      rw [ContinuousLinearMap.toSpanSingleton_apply]
      by_cases h_eq : t' = t
      · subst h_eq
        simp
      · have h_ne : t' - t ≠ 0 := sub_ne_zero.mpr h_eq
        rw [smul_smul, mul_inv_cancel₀ h_ne, one_smul]
    rw [h_rem_eq] at h_smul_zero
    have h_lin : Filter.Tendsto (fun t' : ℝ => V t 0 + (t' - t) • v) (nhds t) (nhds (V t 0)) := by
      simpa using
        (tendsto_const_nhds (x := V t 0)).add (h_sub_tendsto.smul (tendsto_const_nhds (x := v)))
    have h_sum := h_smul_zero.add h_lin
    have h_sum_eq :
        (fun t' : ℝ => (V t' 0 - V t 0 - (t' - t) • v) + (V t 0 + (t' - t) • v)) =
        (fun t' : ℝ => V t' 0) := by
      ext t' : 1
      abel
    simpa [h_sum_eq, zero_add] using h_sum
  apply schwartz_hasDerivAt_of_hm1_sq_cube_and_seminorm_bound (fun s => V s τ) v₀ s₀ C η₁
    hC_nn hη₁_pos h_cube
  intro k n
  let F : ℝ → ℝ := fun s =>
    ∑ p ∈ Finset.range (k + 1), ∑ d ∈ Finset.range (n + 1),
      SchwartzMap.seminorm ℝ p d (V s 0)
  have hF_cont : Continuous F := by
    apply continuous_finset_sum
    intro p _
    apply continuous_finset_sum
    intro d _
    exact ((schwartz_withSeminorms ℝ ℝ ℝ).continuous_seminorm (p, d)).comp h_cont_V0
  have hI_nonempty : (Set.Icc (s₀ - η₁) (s₀ + η₁)).Nonempty := by
    refine ⟨s₀, ?_⟩
    constructor <;> linarith
  obtain ⟨s_max, hs_max_mem, hs_max⟩ :=
    isCompact_Icc.exists_isMaxOn hI_nonempty hF_cont.continuousOn
  set R₀ : ℝ := max 0 (F s_max)
  have hR₀_nn : 0 ≤ R₀ := le_max_left 0 (F s_max)
  obtain ⟨B, hB_nn, hB_bound⟩ :=
    reg_flow_compact_time_schwartz_seminorm_bound δ_diag κ hκ (h_static κ hκ)
      k n |τ| R₀ (abs_nonneg τ) hR₀_nn
  refine ⟨B, hB_nn, ?_⟩
  intro s hs
  apply hB_bound (fun τ' => V s τ') (hV_reg s)
    (fun τ' => le_trans (hV_ball s τ') hδ_prop_le_diag)
  · intro p hp d hd
    have hs_mem : s ∈ Set.Icc (s₀ - η₁) (s₀ + η₁) := by
      rw [abs_le] at hs
      exact ⟨by linarith, by linarith⟩
    have h_le_F : SchwartzMap.seminorm ℝ p d (V s 0) ≤ F s := by
      dsimp [F]
      have hp_mem : p ∈ Finset.range (k + 1) := Finset.mem_range.mpr (Nat.lt_succ_of_le hp)
      have hd_mem : d ∈ Finset.range (n + 1) := Finset.mem_range.mpr (Nat.lt_succ_of_le hd)
      have h1 : SchwartzMap.seminorm ℝ p d (V s 0) ≤
          ∑ d' ∈ Finset.range (n + 1), SchwartzMap.seminorm ℝ p d' (V s 0) :=
        Finset.single_le_sum (fun d' _ => apply_nonneg (SchwartzMap.seminorm ℝ p d') (V s 0)) hd_mem
      have h2 : ∑ d' ∈ Finset.range (n + 1), SchwartzMap.seminorm ℝ p d' (V s 0) ≤
          ∑ p' ∈ Finset.range (k + 1), ∑ d' ∈ Finset.range (n + 1),
            SchwartzMap.seminorm ℝ p' d' (V s 0) :=
        Finset.single_le_sum
          (fun p' _ => Finset.sum_nonneg (fun d' _ => apply_nonneg (SchwartzMap.seminorm ℝ p' d') (V s 0)))
          hp_mem
      exact le_trans h1 h2
    have hF_le : F s ≤ F s_max := isMaxOn_iff.mp hs_max s hs_mem
    exact le_trans h_le_F (le_trans hF_le (le_max_right 0 (F s_max)))
  · exact le_rfl

theorem commuting_kdv_reg_flow_surface (h_exists : ∀ q : 𝓢(ℝ, ℝ), ∃ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u ∧ u 0 = q)
    (h_unique : ∀ u v : ℝ → 𝓢(ℝ, ℝ),
      IsSchwartzSolution u → IsSchwartzSolution v → u 0 = v 0 → u = v) :
    ∃ δ_comm : ℝ, 0 < δ_comm ∧
      ∀ κ : ℝ, 2 ≤ κ → ∀ U : ℝ → ℝ → 𝓢(ℝ, ℝ),
        (∀ τ : ℝ, IsSchwartzSolution (fun s => U s τ)) →
        IsRegFlowSolution κ (fun τ => U 0 τ) →
        (∀ s τ : ℝ, ‖ι (U s τ)‖ ≤ δ_comm) →
        ∀ s : ℝ, IsRegFlowSolution κ (fun τ => U s τ) :=
by
  obtain ⟨δ_uniq, hδ_uniq, h_uniq_reg⟩ := reg_flow_unique_on_small_ball
  obtain ⟨δ_brack, hδ_brack, h_brack⟩ := kdvRHS_diagGreen_and_regFlowRHS_commutator
  obtain ⟨δ_prop, hδ_prop_pos, _hδ_prop_le_brack, h_prop⟩ :=
    reg_flow_preserves_kdv_of_commutator δ_brack hδ_brack
  set δ_target : ℝ := min δ_uniq δ_prop
  have hδ_target : 0 < δ_target := lt_min hδ_uniq hδ_prop_pos
  have hδ_target_le_uniq : δ_target ≤ δ_uniq := min_le_left _ _
  have hδ_target_le_prop : δ_target ≤ δ_prop := min_le_right _ _
  obtain ⟨δ₀, hδ₀_pos, hδ₀_le_target, h_reg_ex⟩ :=
    reg_flow_global_existence_and_conservation δ_target hδ_target
  refine ⟨δ₀, hδ₀_pos, ?_⟩
  intro κ hκ U hU_kdv hU_reg0 hU_ball s
  let V : ℝ → ℝ → 𝓢(ℝ, ℝ) := fun s' τ =>
    (h_reg_ex κ hκ (U s' 0) (hU_ball s' 0)).choose τ
  have hV_reg : ∀ s' : ℝ, IsRegFlowSolution κ (fun τ => V s' τ) :=
    fun s' => (h_reg_ex κ hκ (U s' 0) (hU_ball s' 0)).choose_spec.1
  have hV_init : ∀ s' : ℝ, V s' 0 = U s' 0 :=
    fun s' => (h_reg_ex κ hκ (U s' 0) (hU_ball s' 0)).choose_spec.2.1
  have hV_ball : ∀ s' τ : ℝ, ‖ι (V s' τ)‖ ≤ δ_target :=
    fun s' τ => (h_reg_ex κ hκ (U s' 0) (hU_ball s' 0)).choose_spec.2.2.1 τ
  have hV0_eq_U0 : ∀ τ : ℝ, V 0 τ = U 0 τ := by
    apply h_uniq_reg κ hκ (fun τ => V 0 τ) (fun τ => U 0 τ) (hV_reg 0) hU_reg0
    · intro τ
      exact le_trans (hV_ball 0 τ) hδ_target_le_uniq
    · intro τ
      exact le_trans (hU_ball 0 τ) (le_trans hδ₀_le_target hδ_target_le_uniq)
    · exact hV_init 0
  have hV_init_eq : (fun s' => V s' 0) = (fun s' => U s' 0) := funext hV_init
  have hV_kdv0 : IsSchwartzSolution (fun s' => V s' 0) := by
    rw [hV_init_eq]
    exact hU_kdv 0
  have hV_kdv : ∀ τ : ℝ, IsSchwartzSolution (fun s' => V s' τ) :=
    h_prop κ hκ (h_brack κ hκ) V hV_reg hV_kdv0
      (fun s' τ => le_trans (hV_ball s' τ) hδ_target_le_prop)
  have hU_eq_V : ∀ τ : ℝ, U s τ = V s τ := by
    intro τ
    have h_eq : (fun s' => U s' τ) = (fun s' => V s' τ) :=
      h_unique (fun s' => U s' τ) (fun s' => V s' τ) (hU_kdv τ) (hV_kdv τ) (hV0_eq_U0 τ).symm
    exact congr_fun h_eq s
  have hUs_eq_Vs : (fun τ => U s τ) = (fun τ => V s τ) := funext hU_eq_V
  rw [hUs_eq_Vs]
  exact hV_reg s

theorem reg_flow_short_time_schwartz_seminorm_lipschitz : ∀ (δ_diag κ : ℝ), 2 ≤ κ →
      (∀ (k n : ℕ) (R : ℝ), 0 ≤ R →
        ∃ C₁ C₂ : ℝ, 0 ≤ C₁ ∧ 0 ≤ C₂ ∧
          ∀ w : 𝓢(ℝ, ℝ), ‖ι w‖ ≤ δ_diag →
            (∀ p ≤ k, ∀ d < n, SchwartzMap.seminorm ℝ p d w ≤ R) →
            (∀ p < k, SchwartzMap.seminorm ℝ p n w ≤ R) →
            ∃ g_tilde : 𝓢(ℝ, ℝ),
              (∀ x : ℝ, diagGreen κ w x = 1 / (2 * κ) + g_tilde x) ∧
              SchwartzMap.seminorm ℝ k (n + 1) g_tilde ≤ C₁ * SchwartzMap.seminorm ℝ k n w + C₂) →
      ∀ (k n : ℕ) (R₀ : ℝ), 0 ≤ R₀ →
        ∃ σ₀ M : ℝ, 0 < σ₀ ∧ 0 ≤ M ∧
          ∀ w : ℝ → 𝓢(ℝ, ℝ), IsRegFlowSolution κ w →
            (∀ τ : ℝ, ‖ι (w τ)‖ ≤ δ_diag) →
            ∀ τ₀ : ℝ,
              (∀ p ≤ k, ∀ d ≤ n + 1, SchwartzMap.seminorm ℝ p d (w τ₀) ≤ R₀) →
              ∀ τ : ℝ, |τ - τ₀| ≤ σ₀ →
                SchwartzMap.seminorm ℝ k n (w τ - w τ₀) ≤ M * |τ - τ₀| :=
by
  intro δ_diag κ hκ h_static
  have hκ_pos : 0 < κ := by linarith
  have h_iter_derivCLM : ∀ (n : ℕ) (f : 𝓢(ℝ, ℝ)) (x : ℝ),
      iteratedDeriv n (SchwartzMap.derivCLM ℝ ℝ f) x = iteratedDeriv (n + 1) f x := by
    intro n f
    induction n with
    | zero =>
      intro x
      rw [iteratedDeriv_zero, iteratedDeriv_one, SchwartzMap.derivCLM_apply]
    | succ n ih =>
      intro x
      rw [iteratedDeriv_succ, iteratedDeriv_succ]
      have h_eq : iteratedDeriv n (⇑(SchwartzMap.derivCLM ℝ ℝ f)) = iteratedDeriv (n + 1) (⇑f) := by
        ext y
        exact ih y
      rw [h_eq]
  have h_iter_add : ∀ (n : ℕ) (f g : 𝓢(ℝ, ℝ)) (x : ℝ),
      iteratedDeriv n (⇑(f + g)) x = iteratedDeriv n f x + iteratedDeriv n g x := by
    intro n f g x
    have h_coe : (⇑(f + g) : ℝ → ℝ) = ⇑f + ⇑g := rfl
    rw [h_coe]
    exact iteratedDeriv_add ((f.smooth n).contDiffAt) ((g.smooth n).contDiffAt)
  have h_iter_sub : ∀ (n : ℕ) (f g : 𝓢(ℝ, ℝ)) (x : ℝ),
      iteratedDeriv n (⇑(f - g)) x = iteratedDeriv n f x - iteratedDeriv n g x := by
    intro n f g x
    have h_coe : (⇑(f - g) : ℝ → ℝ) = ⇑f - ⇑g := rfl
    rw [h_coe]
    exact iteratedDeriv_sub ((f.smooth n).contDiffAt) ((g.smooth n).contDiffAt)
  have h_iter_smul : ∀ (n : ℕ) (a : ℝ) (f : 𝓢(ℝ, ℝ)) (x : ℝ),
      iteratedDeriv n (⇑(a • f)) x = a * iteratedDeriv n f x := by
    intro n a f x
    have h_coe : (⇑(a • f) : ℝ → ℝ) = a • ⇑f := rfl
    rw [h_coe, iteratedDeriv_const_smul ((f.smooth n).contDiffAt) a, smul_eq_mul]
  have h_s1 : ∀ (w : ℝ → 𝓢(ℝ, ℝ)), IsRegFlowSolution κ w →
      (∀ (p d : ℕ), Continuous (fun τ : ℝ => SchwartzMap.seminorm ℝ p d (w τ))) ∧
      (∀ (d : ℕ) (τ₀ σ x : ℝ) (g_tilde : 𝓢(ℝ, ℝ)),
        (∀ y : ℝ, diagGreen κ (w (τ₀ + σ)) y = 1 / (2 * κ) + g_tilde y) →
        HasDerivAt (fun σ' : ℝ => iteratedDeriv d (w (τ₀ + σ')) (x - 4 * κ ^ 2 * σ'))
          (16 * κ ^ 5 * iteratedDeriv (d + 1) g_tilde (x - 4 * κ ^ 2 * σ)) σ) ∧
