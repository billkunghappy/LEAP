        have hF_int : Integrable F volume :=
          h_dom_int.mono' hF_cont.aestronglyMeasurable (Filter.Eventually.of_forall hF_pw)
        calc |∫ z : ℝ, F z|
          _ ≤ ∫ z : ℝ, ‖F z‖ := by simpa [Real.norm_eq_abs] using norm_integral_le_integral_norm F
          _ ≤ ∫ z : ℝ, C_mx * (1 + z ^ 2)⁻¹ := integral_mono hF_int.norm h_dom_int hF_pw
          _ = C_mx * ∫ z : ℝ, (1 + z ^ 2)⁻¹ := integral_const_mul C_mx _
          _ = C_mx * π := by rw [integral_univ_inv_one_add_sq]
          _ = ((2 * π * B / M ^ 2) * (1 + x ^ 2)⁻¹) * (1 / 4 : ℝ) ^ m := by dsimp [C_mx]; ring
      have h_peel_sum : ∀ x y : ℝ,
          |greenKernel M w y x - freeGreenKernel M y x| ≤ (4 * π * B / M ^ 2) * (1 + x ^ 2)⁻¹ := by
        intro x y
        set B_x : ℝ := (2 * π * B / M ^ 2) * (1 + x ^ 2)⁻¹
        have hB_nn : 0 ≤ B_x := by dsimp [B_x]; positivity
        have h_sum_m : Summable (fun m : ℕ => greenIterKernel M w (m + 1) y x) :=
          (summable_nat_add_iff 1).mpr (h_iter_sum y x)
        calc |greenKernel M w y x - freeGreenKernel M y x|
          _ = ‖∑' m : ℕ, greenIterKernel M w (m + 1) y x‖ := by rw [h_peel_eq y x, Real.norm_eq_abs]
          _ ≤ ∑' m : ℕ, ‖greenIterKernel M w (m + 1) y x‖ := norm_tsum_le_tsum_norm h_sum_m.norm
          _ ≤ ∑' m : ℕ, B_x * (1 / 4 : ℝ) ^ m :=
            Summable.tsum_le_tsum (fun m => by rw [Real.norm_eq_abs]; exact h_peel_step m y x)
              h_sum_m.norm (h_geom_sum.mul_left B_x)
          _ = B_x * ∑' m : ℕ, (1 / 4 : ℝ) ^ m := tsum_mul_left
          _ = B_x * (4 / 3) := by rw [h_geom_tsum]
          _ ≤ B_x * 2 := mul_le_mul_of_nonneg_left (by norm_num) hB_nn
          _ = (4 * π * B / M ^ 2) * (1 + x ^ 2)⁻¹ := by dsimp [B_x]; ring
      have hG_peel : ∀ x y : ℝ,
          |greenKernel M w y x| ≤ (1 / (2 * M)) * Real.exp (-M * |y - x|) + (4 * π * B / M ^ 2) * (1 + x ^ 2)⁻¹ := by
        intro x y
        have h_tri : |greenKernel M w y x| ≤
            |freeGreenKernel M y x| + |greenKernel M w y x - freeGreenKernel M y x| := by
          have h_id : greenKernel M w y x =
              freeGreenKernel M y x + (greenKernel M w y x - freeGreenKernel M y x) := by ring
          calc |greenKernel M w y x|
            _ = |freeGreenKernel M y x + (greenKernel M w y x - freeGreenKernel M y x)| :=
              congr_arg abs h_id
            _ ≤ |freeGreenKernel M y x| + |greenKernel M w y x - freeGreenKernel M y x| :=
              abs_add_le _ _
        have h_fg_eq : |freeGreenKernel M y x| = (1 / (2 * M)) * Real.exp (-M * |y - x|) :=
          abs_of_nonneg (h_fg_pos y x)
        linarith [h_peel_sum x y]
      have h_rho_int : Integrable (rhoDensity M w) volume := by
        have hg_pos : ∀ x : ℝ, 0 < diagGreen M w x :=
          fun x => lt_of_lt_of_le (by positivity) (hg_bounds x).1
        have h2g_ne : ∀ x : ℝ, 2 * diagGreen M w x ≠ 0 :=
          fun x => ne_of_gt (mul_pos two_pos (hg_pos x))
        let f₁ : ℝ → ℝ := fun x => M - 1 / (2 * diagGreen M w x)
        have hf₁_cont : Continuous f₁ :=
          continuous_const.sub (continuous_const.div (continuous_const.mul hg_cont) h2g_ne)
        have hf₁_dom : ∀ x : ℝ, ‖f₁ x‖ ≤ (16 * π * B) * (1 + x ^ 2)⁻¹ := by
          intro x
          dsimp [f₁]
          have hg_ne : diagGreen M w x ≠ 0 := ne_of_gt (hg_pos x)
          have h_alg : M - 1 / (2 * diagGreen M w x) =
