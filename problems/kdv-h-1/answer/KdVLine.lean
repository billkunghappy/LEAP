    rw [abs_mul, abs_of_pos (by positivity : 0 < 1 / (2 * κ)), abs_of_pos (Real.exp_pos _)]
    have h_exp_le : Real.exp (-κ * |z - x|) ≤ 1 :=
      Real.exp_le_one_iff.mpr (by nlinarith [abs_nonneg (z - x)])
    exact mul_le_of_le_one_right (by positivity) h_exp_le
  have h_conj1 : ∀ ξ : ℝ,
      -∫ z : ℝ, Complex.exp (((ξ : ℂ) * (z : ℂ)) * I) * ((w z * freeGreenKernel κ z x : ℝ) : ℂ) =
        star (iterWavePacket κ w 1 x ξ) := by
    intro ξ
    change -∫ z : ℝ, Complex.exp (((ξ : ℂ) * (z : ℂ)) * I) * ((w z * freeGreenKernel κ z x : ℝ) : ℂ) =
      (starRingEnd ℂ) (-∫ z : ℝ, Complex.exp (-((ξ : ℂ) * (z : ℂ)) * I) *
        ((greenIterKernel κ w 0 x z * w z : ℝ) : ℂ))
    rw [map_neg, ← integral_conj]
    congr 1
    refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
    dsimp only
    have h_symm : greenIterKernel κ w 0 x z * w z = w z * freeGreenKernel κ z x := by
      dsimp [greenIterKernel, freeGreenKernel]
      rw [abs_sub_comm x z, mul_comm]
    rw [h_symm, map_mul, Complex.conj_ofReal, ← Complex.exp_conj]
    congr 2
    rw [map_mul, map_neg, map_mul, Complex.conj_ofReal, Complex.conj_ofReal, Complex.conj_I]
    ring
  have h_diag_inner : ∀ ℓ : ℕ,
      (greenIterKernel κ w (ℓ + 1) x x : ℂ) =
        (1 / (2 * π) : ℂ) *
          ∫ ξ : ℝ,
            iterWavePacket κ w ℓ x ξ * star (iterWavePacket κ w 1 x ξ) / ((κ ^ 2 + ξ ^ 2 : ℝ) : ℂ) := by
    intro ℓ
    obtain ⟨h_cont_ℓ, M_ℓ, hM_ℓ_nn, hM_ℓ⟩ := h_pkt ℓ
    let G : ℝ → ℝ → ℂ := fun z ξ =>
