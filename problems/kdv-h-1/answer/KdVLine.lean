import Mathlib
set_option maxHeartbeats 4000000

/-!
# KdV is well-posed in `H⁻¹(ℝ)` (Killip–Vişan, Theorem 1.1, line case)

Formal statement of the line case of

> **Theorem 1.1 (Global well-posedness).** The equation (KdV)
> `d/dt q = -q''' + 6 q q'` is globally well-posed for initial data in `H⁻¹(ℝ)` in the
> following sense: the solution map extends uniquely from Schwartz space to a jointly
> continuous map `Φ : ℝ × H⁻¹ → H⁻¹`. Moreover, for each initial data `q ∈ H⁻¹`, the orbit
> `{Φ(t,q) : t ∈ ℝ}` is uniformly bounded and equicontinuous in `H⁻¹`.

(See also Corollary 5.2, which is the line case as the paper proves it.)

R. Killip and M. Vişan, *KdV is well-posed in `H⁻¹`*, Ann. of Math. (2) **190** (2019),
249–305, arXiv:1802.04851. The informal source is `KdV_killip_visan_informal.md` in this
folder.

## Notion of solution (as in the paper)

* **Schwartz solutions.** The paper takes classical well-posedness in Schwartz space for
  granted (Bona–Smith, Kato, Sjöberg, Temam): "Schwartz-space initial data leads to unique
  global solutions to (KdV) that remain in Schwartz class … the solution map is … infinitely
  differentiable in both variables". Accordingly, a *Schwartz solution* here is a curve
  `u : ℝ → 𝓢(ℝ, ℝ)` that is differentiable *as a curve in Schwartz space*, i.e. for the
  Fréchet topology of `𝓢(ℝ, ℝ)`. Its derivative at every time `t` must be the Schwartz
  function `x ↦ -∂ₓ³u(t,x) + 6 u(t,x) ∂ₓu(t,x)`. Such a curve is automatically `C^∞` in time
  with values in `𝓢`, since the right-hand side is a smooth function of `u(t)` in `𝓢`.

* **`H⁻¹` solutions.** As in the paper, solutions with `H⁻¹` data are *unique limits of
  Schwartz solutions*: `Φ` is required to be continuous on `ℝ × H⁻¹` and to agree with the
  Schwartz flow, `Φ(t, u(0)) = u(t)`, for every Schwartz solution `u`.

* **Classical input is assumed, not proved (conditional statement).** The paper does not
  prove Schwartz-class well-posedness; it cites it (Bona–Smith [5], Kato [34], Sjöberg
  [63, 64], Temam [65]) and relies on it ("We shall rely on this result"). Accordingly, the
  main theorem takes as *hypotheses* global existence (`h_exists`) and uniqueness
  (`h_unique`) of Schwartz solutions, so that "the solution map on Schwartz space" is a
  well-defined map on all of `𝓢`. Both hypotheses are true classical theorems, so the
  statement is not vacuous. They are deliberately theorem hypotheses rather than `axiom`s.
  Any result proved from this file is Theorem 1.1 (line case) *conditional on* classical
  Schwartz well-posedness, exactly as in the paper.

  Note: the paper additionally uses that the Schwartz solution map is `C^∞` in time and data
  (e.g. to pass from `{H_κ, H_KdV} = 0` to commuting flows). This is *not* assumed here, so
  a proof following the paper must establish whatever it needs of that fact.

## How `H⁻¹(ℝ)` and equicontinuity are encoded

* **Unknown.** `q` is real-valued, as in the paper.

* **Fourier convention (paper §1.2).** `q̂(ξ) = (2π)^{-1/2} ∫ e^{-iξx} q(x) dx`.

* **The space.** The paper's norm is `‖q‖²_{H⁻¹(ℝ)} = ∫ |q̂(ξ)|² (4 + ξ²)⁻¹ dξ`, so
  `q ↦ (4 + ξ²)^{-1/2} q̂(ξ)` is a linear isometry from real `H⁻¹(ℝ)` into `L²(ℝ, dξ; ℂ)`.
  We realise `H⁻¹(ℝ)` as the closure of the image of `𝓢(ℝ, ℝ)` under this isometry. Since
  Schwartz functions are dense in `H⁻¹(ℝ)`, this is isometrically isomorphic to the paper's
  `H⁻¹(ℝ)`, and it is literally the completion of Schwartz space in the `H⁻¹` norm, which is
  the space to which "the solution map extends".

* **Equicontinuity (paper Definition 4.1, (4.1)).** `Q ⊆ H⁻¹` is equicontinuous if
  `q(· + h) → q` in `H⁻¹` as `h → 0`, uniformly for `q ∈ Q`. Translation by `h` multiplies
  `q̂(ξ)` by `e^{iξh}`. So, for the profile `f` of `q`,
  `‖q(· + h) - q‖²_{H⁻¹} = ∫ |e^{iξh} - 1|² |f(ξ)|² dξ`. This is literally (4.1), not the
  equivalent Fourier-tightness form (4.2).

* **Junk value.** The embedding is defined with a `dite` on `MemLp`, returning `0` otherwise.
  For Schwartz inputs the membership always holds.
-/

open MeasureTheory Complex
open scoped Real SchwartzMap Classical

noncomputable section

namespace KdV

/-! ## The KdV equation `d/dt q = -q''' + 6 q q'` -/

/-- Right-hand side of (KdV) for a profile `f : ℝ → ℝ` at the point `x`:
`-f'''(x) + 6 f(x) f'(x)`. -/
def kdvRHS (f : ℝ → ℝ) (x : ℝ) : ℝ :=
  -(iteratedDeriv 3 f x) + 6 * f x * deriv f x

/-- A global Schwartz solution of (KdV) on the line: a curve `u : ℝ → 𝓢(ℝ, ℝ)` that is
differentiable in the Schwartz-space (Fréchet) topology at every time `t`. Its derivative is
the Schwartz function `x ↦ -∂ₓ³u(t,x) + 6 u(t,x) ∂ₓu(t,x)`. -/
def IsSchwartzSolution (u : ℝ → 𝓢(ℝ, ℝ)) : Prop :=
  ∀ t : ℝ, ∃ v : 𝓢(ℝ, ℝ), HasDerivAt u v t ∧ ∀ x : ℝ, v x = kdvRHS (u t) x

/-! ## The space `H⁻¹(ℝ)` -/

/-- The Fourier transform on the line with the paper's normalisation
`q̂(ξ) = (2π)^{-1/2} ∫ e^{-iξx} q(x) dx`. -/
def fourierLine (q : ℝ → ℝ) (ξ : ℝ) : ℂ :=
  ((Real.sqrt (2 * π))⁻¹ : ℂ) * ∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)

/-- The `H⁻¹(ℝ)` profile `ξ ↦ (4 + ξ²)^{-1/2} q̂(ξ)`. Its `L²(dξ)` norm is `‖q‖_{H⁻¹(ℝ)}`. -/
def hm1Profile (q : ℝ → ℝ) (ξ : ℝ) : ℂ :=
  ((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ) * fourierLine q ξ

/-- The isometric embedding of a Schwartz function into `L²(ℝ, dξ; ℂ)` via its `H⁻¹` profile
(junk value `0` if the profile were not square integrable, which never happens). -/
def toHm1 (q : 𝓢(ℝ, ℝ)) : Lp ℂ 2 (volume : Measure ℝ) :=
  if h : MemLp (hm1Profile q) 2 volume then h.toLp _ else 0

/-- Real `H⁻¹(ℝ)`, realised (isometrically) as the closure in `L²(ℝ, dξ; ℂ)` of the `H⁻¹`
profiles of real Schwartz functions, i.e. the completion of `𝓢(ℝ, ℝ)` in the `H⁻¹` norm. -/
def Hm1 : Submodule ℝ (Lp ℂ 2 (volume : Measure ℝ)) :=
  (Submodule.span ℝ (Set.range toHm1)).topologicalClosure

/-- The embedding `𝓢(ℝ, ℝ) → H⁻¹(ℝ)`. -/
def ι (q : 𝓢(ℝ, ℝ)) : Hm1 :=
  ⟨toHm1 q, Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨q, rfl⟩)⟩

/-! ## Equicontinuity and the extension property -/

/-- `‖q(· + h) - q‖²_{H⁻¹(ℝ)}` expressed through the `H⁻¹` profile `f` of `q`:
`∫ |e^{iξh} - 1|² |f(ξ)|² dξ`. -/
def translateDiffSq (f : Lp ℂ 2 (volume : Measure ℝ)) (h : ℝ) : ℝ :=
  ∫ ξ : ℝ, ‖(Complex.exp ((ξ : ℂ) * (h : ℂ) * I) - 1) * (f : ℝ → ℂ) ξ‖ ^ 2

/-- Equicontinuity in `H⁻¹(ℝ)` (paper Definition 4.1): `q(· + h) → q` in `H⁻¹` as `h → 0`,
uniformly for `q ∈ Q`. -/
def EquicontinuousHm1 (Q : Set Hm1) : Prop :=
  ∀ ε > 0, ∃ δ > 0, ∀ q ∈ Q, ∀ h : ℝ, |h| < δ →
    translateDiffSq (q : Lp ℂ 2 (volume : Measure ℝ)) h < ε

/-- `Φ` extends the Schwartz solution map: for every Schwartz solution `u`,
`Φ(t, u(0)) = u(t)` in `H⁻¹(ℝ)` for all `t`. -/
def ExtendsSchwartzFlow (Φ : ℝ × Hm1 → Hm1) : Prop :=
  ∀ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u → ∀ t : ℝ, Φ (t, ι (u 0)) = ι (u t)

/-! ## Main theorem -/

/-- **Killip–Vişan, Theorem 1.1 (line case).** KdV is globally well-posed in `H⁻¹(ℝ)`:
assuming the classical Schwartz-class theory (global existence `h_exists` and uniqueness
`h_unique` of Schwartz solutions, which the paper takes for granted), the solution map
extends uniquely from Schwartz space to a jointly continuous map
`Φ : ℝ × H⁻¹(ℝ) → H⁻¹(ℝ)`. Moreover, for each `q ∈ H⁻¹(ℝ)` the orbit `{Φ(t, q) : t ∈ ℝ}` is
uniformly bounded and equicontinuous in `H⁻¹(ℝ)`. -/
def hm1KappaSq (κ : ℝ) (f : Hm1) : ℝ :=
  ∫ ξ : ℝ, ((4 + ξ ^ 2) / (4 * κ ^ 2 + ξ ^ 2)) * ‖((f : Lp ℂ 2 (volume : Measure ℝ)) : ℝ → ℂ) ξ‖ ^ 2

def hm2NormSq (f : ℝ → ℝ) : ℝ :=
  ∫ ξ : ℝ, ‖fourierLine f ξ‖ ^ 2 / (4 + ξ ^ 2) ^ 2

def freeGreenKernel (κ x y : ℝ) : ℝ :=
  (1 / (2 * κ)) * Real.exp (-κ * |x - y|)

def greenIterKernel (κ : ℝ) (w : ℝ → ℝ) : ℕ → ℝ → ℝ → ℝ
  | 0, x, y => freeGreenKernel κ x y
  | ℓ + 1, x, y => -∫ z : ℝ, greenIterKernel κ w ℓ x z * w z * freeGreenKernel κ z y

def greenKernel (κ : ℝ) (w : ℝ → ℝ) (x y : ℝ) : ℝ :=
  ∑' ℓ : ℕ, greenIterKernel κ w ℓ x y

def diagGreen (κ : ℝ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  greenKernel κ w x x

def recipGreenDiff (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  1 - 1 / (2 * diagGreen 1 w x)

def rhoDensity (κ : ℝ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  κ - 1 / (2 * diagGreen κ w x) + (1 / 2) * ∫ y : ℝ, Real.exp (-2 * κ * |x - y|) * w y

def alphaFunctional (κ : ℝ) (w : ℝ → ℝ) : ℝ :=
  ∫ x : ℝ, rhoDensity κ w x
def regFlowRHS (κ : ℝ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  16 * κ ^ 5 * deriv (diagGreen κ w) x + 4 * κ ^ 2 * deriv w x

def IsRegFlowSolution (κ : ℝ) (w : ℝ → 𝓢(ℝ, ℝ)) : Prop :=
  ∀ t : ℝ, ∃ v : 𝓢(ℝ, ℝ), HasDerivAt w v t ∧ ∀ x : ℝ, v x = regFlowRHS κ (w t) x

def diffFlowRHS (κ : ℝ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  kdvRHS w x - regFlowRHS κ w x

def IsDiffFlowSolution (κ : ℝ) (z : ℝ → 𝓢(ℝ, ℝ)) : Prop :=
  ∀ s : ℝ, ∃ v : 𝓢(ℝ, ℝ), HasDerivAt z v s ∧ ∀ x : ℝ, v x = diffFlowRHS κ (z s) x

def recipGreenFlux (κ : ℝ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  (1 / diagGreen 1 w x) *
    (w x + (4 * κ ^ 5 / (κ ^ 2 - 1)) * (diagGreen κ w x - 1 / (2 * κ)) -
      (4 / (κ ^ 2 - 1)) * (diagGreen 1 w x - 1 / 2))
def apFreeGreenOne (x y : ℝ) : ℝ :=
  (1 / 2) * Real.exp (-|x - y|)

def apGreenIterOne (w : ℝ → ℝ) : ℕ → ℝ → ℝ → ℝ
  | 0, x, y => apFreeGreenOne x y
  | ℓ + 1, x, y => -∫ z : ℝ, apGreenIterOne w ℓ x z * w z * apFreeGreenOne z y

def apDiagGreenOne (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  ∑' ℓ : ℕ, apGreenIterOne w ℓ x x

def apAlphaOne (w : ℝ → ℝ) : ℝ :=
  ∑' m : ℕ, (-1 / ((m : ℝ) + 2)) * ∫ x : ℝ, w x * apGreenIterOne w (m + 1) x x
def alphaQuadDensity (κ : ℝ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  2 * κ ^ 2 * greenIterKernel κ w 2 x x - 4 * κ ^ 3 * (greenIterKernel κ w 1 x x) ^ 2

def alphaQuadFunctional (κ : ℝ) (w : ℝ → ℝ) : ℝ :=
  ∫ x : ℝ, alphaQuadDensity κ w x

def h1NormSq (f : ℝ → ℝ) : ℝ :=
  ∫ ξ : ℝ, (4 + ξ ^ 2) * ‖fourierLine f ξ‖ ^ 2

def h1HighFreqSq (M : ℝ) (f : ℝ → ℝ) : ℝ :=
  ∫ ξ : ℝ, ((2 * ξ ^ 2) / (4 * M ^ 2 + ξ ^ 2)) * ((4 + ξ ^ 2) * ‖fourierLine f ξ‖ ^ 2)
def rhoDerivDensity (κ : ℝ) (w v : ℝ → ℝ) (x : ℝ) : ℝ :=
  -(∫ y : ℝ, greenKernel κ w x y * v y * greenKernel κ w y x) / (2 * (diagGreen κ w x) ^ 2) +
    (1 / 2) * ∫ y : ℝ, Real.exp (-2 * κ * |x - y|) * v y
def iterWavePacket (κ : ℝ) (w : ℝ → ℝ) : ℕ → ℝ → ℝ → ℂ
  | 0, x, ξ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I)
  | m + 1, x, ξ =>
      -∫ z : ℝ, Complex.exp (-((ξ : ℂ) * (z : ℂ)) * I) *
        ((greenIterKernel κ w m x z * w z : ℝ) : ℂ)
def iterWavePacketOne (w : ℝ → ℝ) : ℕ → ℝ → ℝ → ℂ
  | 0, x, ξ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I)
  | k + 1, x, ξ =>
      -∫ z : ℝ, Complex.exp (-((ξ : ℂ) * (z : ℂ)) * I) *
        ((greenIterKernel 1 w k x z * w z : ℝ) : ℂ)

def iterFreqPacketOne (w : ℝ → ℝ) (k : ℕ) (α ξ : ℝ) : ℂ :=
  ((Real.sqrt (2 * π))⁻¹ : ℂ) *
    ∫ x : ℝ, Complex.exp (-((α : ℂ) * (x : ℂ)) * I) * iterWavePacketOne w (k + 1) x ξ
def h1KappaNormSq (κ : ℝ) (f : ℝ → ℝ) : ℝ :=
  ∫ ξ : ℝ, (κ ^ 2 + ξ ^ 2) * ‖fourierLine f ξ‖ ^ 2

def IsGoodGreenProfile (κ : ℝ) (f : ℝ → ℝ) : Prop :=
  Continuous f ∧ Integrable f volume ∧
    Integrable (fun ξ : ℝ => (κ ^ 2 + ξ ^ 2) * ‖fourierLine f ξ‖ ^ 2) volume

def shiftedGreenIter (κ : ℝ) (w : ℝ → ℝ) (m : ℕ) (x u : ℝ) : ℝ :=
  greenIterKernel κ w m x (x + u)

def shiftedGreenIterDeriv (κ : ℝ) (w : ℝ → ℝ) (m n : ℕ) (x u : ℝ) : ℝ :=
  iteratedDeriv n (fun x' => greenIterKernel κ w m x' (x' + u)) x
def freeGreenDerivY (κ z y : ℝ) : ℝ :=
  if z < y then -(1 / 2) * Real.exp (-κ * (y - z))
  else if y < z then (1 / 2) * Real.exp (-κ * (z - y))
  else 0

def greenIterDerivY (κ : ℝ) (w : ℝ → ℝ) : ℕ → ℝ → ℝ → ℝ
  | 0, x, y => freeGreenDerivY κ x y
  | ℓ + 1, x, y => -∫ z : ℝ, greenIterKernel κ w ℓ x z * w z * freeGreenDerivY κ z y

def greenIterMixedDiag (κ : ℝ) (w : ℝ → ℝ) (ℓ : ℕ) (x : ℝ) : ℝ :=
  -∫ z : ℝ, greenIterDerivY κ w ℓ z x * w z * freeGreenDerivY κ z x
def diagGreenDeriv (κ : ℝ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  ∑' m : ℕ, 2 * greenIterDerivY κ w (m + 1) x x

def greenKernelLeft (κ : ℝ) (w : ℝ → ℝ) (a x : ℝ) : ℝ :=
  (1 / (2 * κ)) * Real.exp (-κ * (a - x)) + ∑' m : ℕ, greenIterKernel κ w (m + 1) a x

def greenDerivLeft (κ : ℝ) (w : ℝ → ℝ) (a x : ℝ) : ℝ :=
  (1 / 2) * Real.exp (-κ * (a - x)) + ∑' m : ℕ, greenIterDerivY κ w (m + 1) a x

def greenKernelRight (κ : ℝ) (w : ℝ → ℝ) (a x : ℝ) : ℝ :=
  (1 / (2 * κ)) * Real.exp (-κ * (x - a)) + ∑' m : ℕ, greenIterKernel κ w (m + 1) a x

def greenDerivRight (κ : ℝ) (w : ℝ → ℝ) (a x : ℝ) : ℝ :=
  -(1 / 2) * Real.exp (-κ * (x - a)) + ∑' m : ℕ, greenIterDerivY κ w (m + 1) a x
def shiftedGreenBoundSeq (r : ℕ → ℝ) : ℕ → ℕ → ℝ
  | 0, 0 => 1
  | 0, _ + 1 => 0
  | m + 1, n =>
      ∑ j ∈ Finset.range (n + 1),
        (Nat.choose n j : ℝ) * (r (n - j) * shiftedGreenBoundSeq r m j)
def regTranslate (a : ℝ) (f : 𝓢(ℝ, ℝ)) : 𝓢(ℝ, ℝ) :=
  SchwartzMap.compCLMOfAntilipschitz ℝ
    (Function.HasTemperateGrowth.id.add (Function.HasTemperateGrowth.const a))
    (isometry_add_right a).antilipschitz f
def hm1NormSq (f : ℝ → ℝ) : ℝ :=
  ∫ ξ : ℝ, ‖fourierLine f ξ‖ ^ 2 / (4 + ξ ^ 2)

def recipGreenFluxInner (κ : ℝ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  w x + (4 * κ ^ 5 / (κ ^ 2 - 1)) * (diagGreen κ w x - 1 / (2 * κ)) -
    (4 / (κ ^ 2 - 1)) * (diagGreen 1 w x - 1 / 2)
def regCutoff (δ' r : ℝ) : ℝ :=
  max 0 (min 1 (2 - r / δ'))

def regMovingFrameVec (κ : ℝ) (q : 𝓢(ℝ, ℝ)) : 𝓢(ℝ, ℝ) :=
  if h : ∃ g_tilde : 𝓢(ℝ, ℝ), ∀ x : ℝ, diagGreen κ q x = 1 / (2 * κ) + g_tilde x then
    (16 * κ ^ 5) • SchwartzMap.derivCLM ℝ ℝ (Classical.choose h)
  else 0

def regTruncatedVec (δ' κ : ℝ) (q : 𝓢(ℝ, ℝ)) : 𝓢(ℝ, ℝ) :=
  regCutoff δ' ‖ι q‖ • regMovingFrameVec κ q
def schwartzTierNorm (K n : ℕ) (q : 𝓢(ℝ, ℝ)) : ℝ :=
  ∑ p ∈ Finset.range (K + 1), SchwartzMap.seminorm ℝ p n q
def hm2PairIntegrand (f₁ f₂ : ℝ → ℝ) (ξ : ℝ) : ℝ :=
  ((starRingEnd ℂ (fourierLine f₁ ξ) * fourierLine f₂ ξ).re) / (4 + ξ ^ 2) ^ 2

theorem denseRange_iota : DenseRange ι :=
by
  have norm_fourier_integrand : ∀ (q : ℝ → ℝ) (ξ x : ℝ),
      ‖Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)‖ = ‖q x‖ := by
    intro q ξ x
    have h_exp : -((ξ : ℂ) * (x : ℂ)) * I = ((-(ξ * x) : ℝ) : ℂ) * I := by push_cast; ring
    rw [norm_mul, h_exp, Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real]
  have integrable_fourier_integrand : ∀ (q : 𝓢(ℝ, ℝ)) (ξ : ℝ),
      Integrable (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)) volume := by
    intro q ξ
    have h_cont : Continuous (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)) := by
      have := q.continuous
      fun_prop
    refine q.integrable.norm.mono' h_cont.aestronglyMeasurable ?_
    filter_upwards with x
    rw [norm_fourier_integrand]
  have h_mem : ∀ q : 𝓢(ℝ, ℝ), MemLp (hm1Profile q) 2 (volume : Measure ℝ) := by
    intro q
    have h_cont2 : Continuous (fun p : ℝ × ℝ =>
        Complex.exp (-((p.1 : ℂ) * (p.2 : ℂ)) * I) * (q p.2 : ℂ)) := by
      have := q.continuous
      fun_prop
    have h_meas_int : AEStronglyMeasurable
        (fun ξ : ℝ => ∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)) volume :=
      h_cont2.aestronglyMeasurable.integral_prod_right'
    have h_meas_fl : AEStronglyMeasurable (fourierLine q) volume :=
      aestronglyMeasurable_const.mul h_meas_int
    have h_cont_w : Continuous (fun ξ : ℝ => ((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ)) :=
      Continuous.inv₀ (by fun_prop) (fun ξ => Complex.ofReal_ne_zero.mpr (by positivity))
    have h_meas : AEStronglyMeasurable (hm1Profile q) volume :=
      h_cont_w.aestronglyMeasurable.mul h_meas_fl
    rw [memLp_two_iff_integrable_sq_norm h_meas]
    let C : ℝ := ‖((Real.sqrt (2 * π))⁻¹ : ℂ)‖ * ∫ x : ℝ, ‖q x‖
    refine (integrable_inv_one_add_sq.const_mul (C ^ 2)).mono'
      (h_meas.norm.pow 2) ?_
    filter_upwards with ξ
    have h_fl_bound : ‖fourierLine q ξ‖ ≤ C := by
      dsimp [fourierLine, C]
      rw [norm_mul]
      gcongr
      calc
        ‖∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)‖
          ≤ ∫ x : ℝ, ‖Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)‖ :=
            norm_integral_le_integral_norm _
        _ = ∫ x : ℝ, ‖q x‖ := by
            congr 1 with x
            exact norm_fourier_integrand q ξ x
    have h_w_norm : ‖((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ)‖ = (Real.sqrt (4 + ξ ^ 2))⁻¹ := by
      rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    have h_sq : ‖hm1Profile q ξ‖ ^ 2 = (4 + ξ ^ 2)⁻¹ * ‖fourierLine q ξ‖ ^ 2 := by
      dsimp [hm1Profile]
      rw [norm_mul, h_w_norm, mul_pow, inv_pow, Real.sq_sqrt (by positivity)]
    rw [Real.norm_of_nonneg (sq_nonneg _), h_sq]
    have h_inv_le : (4 + ξ ^ 2)⁻¹ ≤ (1 + ξ ^ 2)⁻¹ := by
      apply inv_anti₀ (by positivity)
      linarith
    have h_sq_le : ‖fourierLine q ξ‖ ^ 2 ≤ C ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) h_fl_bound 2
    calc
      (4 + ξ ^ 2)⁻¹ * ‖fourierLine q ξ‖ ^ 2 ≤ (1 + ξ ^ 2)⁻¹ * C ^ 2 := by
        gcongr
      _ = C ^ 2 * (1 + ξ ^ 2)⁻¹ := mul_comm _ _
  have hm1Profile_add : ∀ (q₁ q₂ : 𝓢(ℝ, ℝ)) (ξ : ℝ),
      hm1Profile (q₁ + q₂) ξ = hm1Profile q₁ ξ + hm1Profile q₂ ξ := by
    intro q₁ q₂ ξ
    dsimp [hm1Profile, fourierLine]
    have h_eq : (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((q₁ x + q₂ x : ℝ) : ℂ)) =
        (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q₁ x : ℂ) +
          Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q₂ x : ℂ)) := by
      ext x
      push_cast
      ring
    rw [h_eq, integral_add (integrable_fourier_integrand q₁ ξ) (integrable_fourier_integrand q₂ ξ)]
    ring
  have hm1Profile_smul : ∀ (c : ℝ) (q : 𝓢(ℝ, ℝ)) (ξ : ℝ),
      hm1Profile (c • q) ξ = c • hm1Profile q ξ := by
    intro c q ξ
    dsimp [hm1Profile, fourierLine]
    have h_eq : (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((c * q x : ℝ) : ℂ)) =
        (fun x : ℝ => c • (Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ))) := by
      ext x
      simp [Complex.real_smul]
      ring
    rw [h_eq, integral_smul]
    simp [Complex.real_smul]
    ring
  have h_toHm1 : ∀ q : 𝓢(ℝ, ℝ), toHm1 q = (h_mem q).toLp (hm1Profile q) := by
    intro q
    dsimp [toHm1]
    rw [dif_pos (h_mem q)]
  have h_add : ∀ q₁ q₂ : 𝓢(ℝ, ℝ), toHm1 (q₁ + q₂) = toHm1 q₁ + toHm1 q₂ := by
    intro q₁ q₂
    rw [h_toHm1 (q₁ + q₂), h_toHm1 q₁, h_toHm1 q₂, ← MemLp.toLp_add (h_mem q₁) (h_mem q₂)]
    apply MemLp.toLp_congr
    filter_upwards with ξ
    exact hm1Profile_add q₁ q₂ ξ
  have h_smul : ∀ (c : ℝ) (q : 𝓢(ℝ, ℝ)), toHm1 (c • q) = c • toHm1 q := by
    intro c q
    rw [h_toHm1 (c • q), h_toHm1 q, ← MemLp.toLp_const_smul c (h_mem q)]
    apply MemLp.toLp_congr
    filter_upwards with ξ
    exact hm1Profile_smul c q ξ
  let toHm1Linear : 𝓢(ℝ, ℝ) →ₗ[ℝ] Lp ℂ 2 (volume : Measure ℝ) :=
    { toFun := toHm1
      map_add' := h_add
      map_smul' := fun c q => by simp [h_smul c q] }
  have h_span : Submodule.span ℝ (Set.range toHm1) = LinearMap.range toHm1Linear := by
    have h_range : Set.range toHm1 = (LinearMap.range toHm1Linear : Set (Lp ℂ 2 (volume : Measure ℝ))) := by
      rw [LinearMap.coe_range]
      rfl
    rw [h_range, Submodule.span_eq]
  have h_clos : (Hm1 : Set (Lp ℂ 2 (volume : Measure ℝ))) = closure (Set.range toHm1) := by
    dsimp [Hm1]
    rw [h_span, LinearMap.coe_range]
    rfl
  rw [Metric.denseRange_iff]
  intro y r hr
  have hy : (y : Lp ℂ 2 (volume : Measure ℝ)) ∈ closure (Set.range toHm1) := by
    rw [← h_clos]
    exact y.2
  obtain ⟨z, ⟨q, rfl⟩, hdist⟩ := Metric.mem_closure_iff.mp hy r hr
  refine ⟨q, ?_⟩
  simpa [Subtype.dist_eq, ι] using hdist

theorem schwartz_solution_continuous_hm1 (u : ℝ → 𝓢(ℝ, ℝ)) (hu : IsSchwartzSolution u) :
    Continuous (fun t => ι (u t)) :=
by
  have h_cont_u : Continuous u := by
    rw [continuous_iff_continuousAt]
    intro t
    obtain ⟨v, h_deriv, _⟩ := hu t
    have h_littleO := h_deriv.isLittleOTVS
    have h_inv_smul := h_littleO.tendsto_inv_smul
    have h_sub_tendsto : Filter.Tendsto (fun t' : ℝ => t' - t) (nhds t) (nhds 0) := by
      simpa [sub_self] using (continuousAt_id.sub (continuousAt_const : ContinuousAt (fun _ : ℝ => t) t)).tendsto
    have h_smul_zero : Filter.Tendsto
        (fun t' : ℝ => (t' - t) • ((t' - t)⁻¹ • (u t' - u t - (ContinuousLinearMap.toSpanSingleton ℝ v) (t' - t))))
        (nhds t) (nhds 0) := by
      simpa using h_sub_tendsto.smul h_inv_smul
    have h_rem_eq : (fun t' : ℝ => (t' - t) • ((t' - t)⁻¹ • (u t' - u t - (ContinuousLinearMap.toSpanSingleton ℝ v) (t' - t)))) =
        (fun t' : ℝ => u t' - u t - (t' - t) • v) := by
      ext t' : 1
      rw [ContinuousLinearMap.toSpanSingleton_apply]
      by_cases h_eq : t' = t
      · subst h_eq
        simp
      · have h_ne : t' - t ≠ 0 := sub_ne_zero.mpr h_eq
        rw [smul_smul, mul_inv_cancel₀ h_ne, one_smul]
    rw [h_rem_eq] at h_smul_zero
    have h_lin : Filter.Tendsto (fun t' : ℝ => u t + (t' - t) • v) (nhds t) (nhds (u t)) := by
      simpa using (tendsto_const_nhds (x := u t)).add (h_sub_tendsto.smul (tendsto_const_nhds (x := v)))
    have h_sum := h_smul_zero.add h_lin
    have h_sum_eq : (fun t' : ℝ => (u t' - u t - (t' - t) • v) + (u t + (t' - t) • v)) = u := by
      ext t' : 1
      abel
    simpa [h_sum_eq, zero_add] using h_sum
  have norm_fourier_integrand : ∀ (q : ℝ → ℝ) (ξ x : ℝ),
      ‖Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)‖ = ‖q x‖ := by
    intro q ξ x
    have h_exp : -((ξ : ℂ) * (x : ℂ)) * I = ((-(ξ * x) : ℝ) : ℂ) * I := by push_cast; ring
    rw [norm_mul, h_exp, Complex.norm_exp_ofReal_mul_I, one_mul, Complex.norm_real]
  have integrable_fourier_integrand : ∀ (q : 𝓢(ℝ, ℝ)) (ξ : ℝ),
      Integrable (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)) volume := by
    intro q ξ
    have h_cont : Continuous (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)) := by
      have := q.continuous
      fun_prop
    refine q.integrable.norm.mono' h_cont.aestronglyMeasurable ?_
    filter_upwards with x
    rw [norm_fourier_integrand]
  have h_bound_pw : ∀ (q : 𝓢(ℝ, ℝ)) (ξ : ℝ),
      ‖hm1Profile q ξ‖ ^ 2 ≤ (‖((Real.sqrt (2 * π))⁻¹ : ℂ)‖ * ∫ x : ℝ, ‖q x‖) ^ 2 * (1 + ξ ^ 2)⁻¹ := by
    intro q ξ
    let C : ℝ := ‖((Real.sqrt (2 * π))⁻¹ : ℂ)‖ * ∫ x : ℝ, ‖q x‖
    have h_fl_bound : ‖fourierLine q ξ‖ ≤ C := by
      dsimp [fourierLine, C]
      rw [norm_mul]
      gcongr
      calc
        ‖∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)‖
          ≤ ∫ x : ℝ, ‖Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)‖ :=
            norm_integral_le_integral_norm _
        _ = ∫ x : ℝ, ‖q x‖ := by
            congr 1 with x
            exact norm_fourier_integrand q ξ x
    have h_w_norm : ‖((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ)‖ = (Real.sqrt (4 + ξ ^ 2))⁻¹ := by
      rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    have h_sq : ‖hm1Profile q ξ‖ ^ 2 = (4 + ξ ^ 2)⁻¹ * ‖fourierLine q ξ‖ ^ 2 := by
      dsimp [hm1Profile]
      rw [norm_mul, h_w_norm, mul_pow, inv_pow, Real.sq_sqrt (by positivity)]
    rw [h_sq]
    have h_inv_le : (4 + ξ ^ 2)⁻¹ ≤ (1 + ξ ^ 2)⁻¹ := by
      apply inv_anti₀ (by positivity)
      linarith
    have h_sq_le : ‖fourierLine q ξ‖ ^ 2 ≤ C ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) h_fl_bound 2
    calc
      (4 + ξ ^ 2)⁻¹ * ‖fourierLine q ξ‖ ^ 2 ≤ (1 + ξ ^ 2)⁻¹ * C ^ 2 := by gcongr
      _ = C ^ 2 * (1 + ξ ^ 2)⁻¹ := mul_comm _ _
  have h_mem : ∀ q : 𝓢(ℝ, ℝ), MemLp (hm1Profile q) 2 (volume : Measure ℝ) := by
    intro q
    have h_cont2 : Continuous (fun p : ℝ × ℝ =>
        Complex.exp (-((p.1 : ℂ) * (p.2 : ℂ)) * I) * (q p.2 : ℂ)) := by
      have := q.continuous
      fun_prop
    have h_meas_int : AEStronglyMeasurable
        (fun ξ : ℝ => ∫ x : ℝ, Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q x : ℂ)) volume :=
      h_cont2.aestronglyMeasurable.integral_prod_right'
    have h_meas_fl : AEStronglyMeasurable (fourierLine q) volume :=
      aestronglyMeasurable_const.mul h_meas_int
    have h_cont_w : Continuous (fun ξ : ℝ => ((Real.sqrt (4 + ξ ^ 2))⁻¹ : ℂ)) :=
      Continuous.inv₀ (by fun_prop) (fun ξ => Complex.ofReal_ne_zero.mpr (by positivity))
    have h_meas : AEStronglyMeasurable (hm1Profile q) volume :=
      h_cont_w.aestronglyMeasurable.mul h_meas_fl
    rw [memLp_two_iff_integrable_sq_norm h_meas]
    let C : ℝ := ‖((Real.sqrt (2 * π))⁻¹ : ℂ)‖ * ∫ x : ℝ, ‖q x‖
    refine (integrable_inv_one_add_sq.const_mul (C ^ 2)).mono'
      (h_meas.norm.pow 2) ?_
    filter_upwards with ξ
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    exact h_bound_pw q ξ
  have hm1Profile_sub : ∀ (q₁ q₂ : 𝓢(ℝ, ℝ)) (ξ : ℝ),
      hm1Profile (q₁ - q₂) ξ = hm1Profile q₁ ξ - hm1Profile q₂ ξ := by
    intro q₁ q₂ ξ
    dsimp [hm1Profile, fourierLine]
    have h_eq : (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * ((q₁ x - q₂ x : ℝ) : ℂ)) =
        (fun x : ℝ => Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q₁ x : ℂ) -
          Complex.exp (-((ξ : ℂ) * (x : ℂ)) * I) * (q₂ x : ℂ)) := by
      ext x
      push_cast
      ring
    rw [h_eq, integral_sub (integrable_fourier_integrand q₁ ξ) (integrable_fourier_integrand q₂ ξ)]
    ring
  have h_toHm1 : ∀ q : 𝓢(ℝ, ℝ), toHm1 q = (h_mem q).toLp (hm1Profile q) := by
    intro q
    dsimp [toHm1]
    rw [dif_pos (h_mem q)]
  have h_sub : ∀ q₁ q₂ : 𝓢(ℝ, ℝ), toHm1 (q₁ - q₂) = toHm1 q₁ - toHm1 q₂ := by
    intro q₁ q₂
    rw [h_toHm1 (q₁ - q₂), h_toHm1 q₁, h_toHm1 q₂, ← MemLp.toLp_sub (h_mem q₁) (h_mem q₂)]
    apply MemLp.toLp_congr
    filter_upwards with ξ
    exact hm1Profile_sub q₁ q₂ ξ
  have h_norm_le : ∀ q : 𝓢(ℝ, ℝ), ‖toHm1 q‖ ≤ ‖(SchwartzMap.toLpCLM ℝ ℝ 1 (volume : Measure ℝ)) q‖ := by
    intro q
    let I_q : ℝ := ∫ x : ℝ, ‖(q : ℝ → ℝ) x‖
    let C : ℝ := ‖((Real.sqrt (2 * π))⁻¹ : ℂ)‖ * I_q
    have h_norm_sq : ‖toHm1 q‖ ^ 2 = ∫ ξ : ℝ, ‖hm1Profile q ξ‖ ^ 2 := by
      rw [← real_inner_self_eq_norm_sq, MeasureTheory.L2.inner_def]
      apply integral_congr_ae
      filter_upwards [(h_mem q).coeFn_toLp] with ξ hξ
      rw [h_toHm1 q, hξ, real_inner_self_eq_norm_sq]
    have h_int_hm1 : Integrable (fun ξ : ℝ => ‖hm1Profile q ξ‖ ^ 2) volume :=
      (memLp_two_iff_integrable_sq_norm (h_mem q).1).mp (h_mem q)
    have h_int_le : ∫ ξ : ℝ, ‖hm1Profile q ξ‖ ^ 2 ≤ C ^ 2 * Real.pi := by
      calc
        ∫ ξ : ℝ, ‖hm1Profile q ξ‖ ^ 2
          ≤ ∫ ξ : ℝ, C ^ 2 * (1 + ξ ^ 2)⁻¹ :=
            integral_mono h_int_hm1 (integrable_inv_one_add_sq.const_mul (C ^ 2)) (h_bound_pw q)
        _ = C ^ 2 * ∫ ξ : ℝ, (1 + ξ ^ 2)⁻¹ := integral_const_mul (C ^ 2) _
        _ = C ^ 2 * Real.pi := by rw [integral_univ_inv_one_add_sq]
    have h_C_norm : ‖((Real.sqrt (2 * π))⁻¹ : ℂ)‖ = (Real.sqrt (2 * π))⁻¹ := by
      rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg (Real.sqrt_nonneg _)]
    have h_C_sq : C ^ 2 * Real.pi ≤ I_q ^ 2 := by
      dsimp [C]
      rw [h_C_norm, mul_pow, inv_pow, Real.sq_sqrt (by positivity)]
      have h_pi : (2 * Real.pi)⁻¹ * I_q ^ 2 * Real.pi = (1 / 2) * I_q ^ 2 := by
        have h_pi_ne : Real.pi ≠ 0 := Real.pi_ne_zero
        field_simp
      rw [h_pi]
      have : 0 ≤ I_q ^ 2 := sq_nonneg I_q
      linarith
    have h_Iq_eq : I_q = ‖(SchwartzMap.toLpCLM ℝ ℝ 1 (volume : Measure ℝ)) q‖ := by
      change ∫ x : ℝ, ‖(q : ℝ → ℝ) x‖ = ‖(SchwartzMap.toLpCLM ℝ ℝ 1 (volume : Measure ℝ)) q‖
      rw [integral_norm_eq_lintegral_enorm q.continuous.aestronglyMeasurable,
          ← eLpNorm_one_eq_lintegral_enorm,
          eLpNorm_congr_ae (q.coeFn_toLp 1 volume).symm,
          ← Lp.norm_def,
          SchwartzMap.toLpCLM_apply]
    have h_sq_le : ‖toHm1 q‖ ^ 2 ≤ ‖(SchwartzMap.toLpCLM ℝ ℝ 1 (volume : Measure ℝ)) q‖ ^ 2 := by
      rw [← h_Iq_eq]
      linarith [h_norm_sq, h_int_le, h_C_sq]
    have h_sqrt := Real.sqrt_le_sqrt h_sq_le
    rwa [Real.sqrt_sq (norm_nonneg _), Real.sqrt_sq (norm_nonneg _)] at h_sqrt
  let L := SchwartzMap.toLpCLM ℝ ℝ 1 (volume : Measure ℝ)
  have h_cont_toHm1 : Continuous toHm1 := by
    rw [continuous_iff_continuousAt]
    intro q₀
    rw [ContinuousAt, Metric.tendsto_nhds]
    intro ε hε
    have hL : ∀ᶠ q in nhds q₀, dist (L q) (L q₀) < ε :=
      Metric.tendsto_nhds.mp L.continuous.continuousAt ε hε
    refine hL.mono (fun q hq => ?_)
    have h_dist_le : dist (toHm1 q) (toHm1 q₀) ≤ dist (L q) (L q₀) := by
      rw [dist_eq_norm, dist_eq_norm, ← h_sub q q₀, ← map_sub L q q₀]
      exact h_norm_le (q - q₀)
    exact lt_of_le_of_lt h_dist_le hq
  have h_cont_iota : Continuous ι := h_cont_toHm1.subtype_mk _
  exact h_cont_iota.comp h_cont_u

theorem kdv_scaling_symmetry (q : Hm1) (δ₀ : ℝ) (hδ₀ : 0 < δ₀) :
    ∃ (lam : ℝ) (S : 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ)),
      0 < lam ∧ lam ≤ 1 ∧
      (∀ w : 𝓢(ℝ, ℝ), ∀ x : ℝ, S w x = lam ^ 2 * w (lam * x)) ∧
      (∀ u : ℝ → 𝓢(ℝ, ℝ), IsSchwartzSolution u →
        IsSchwartzSolution (fun t => S (u (lam ^ 3 * t)))) ∧
      (∀ w : 𝓢(ℝ, ℝ), ‖ι w - q‖ < 1 → ‖ι (S w)‖ ≤ δ₀) ∧
      (∀ w₁ w₂ : 𝓢(ℝ, ℝ), ‖ι (S w₁) - ι (S w₂)‖ ≤ ‖ι w₁ - ι w₂‖) ∧
      (∀ w₁ w₂ : 𝓢(ℝ, ℝ), ‖ι w₁ - ι w₂‖ ≤ lam⁻¹ ^ 2 * ‖ι (S w₁) - ι (S w₂)‖) ∧
      (∀ κ : ℝ, 1 ≤ κ → ∀ w : 𝓢(ℝ, ℝ),
        Real.sqrt (hm1KappaSq κ (ι (S w))) ≤ Real.sqrt (hm1KappaSq κ (ι w))) :=
by
  have s1 : ∀ (lam : ℝ), 0 < lam →
      ∃ S : 𝓢(ℝ, ℝ) →L[ℝ] 𝓢(ℝ, ℝ),
        (∀ w : 𝓢(ℝ, ℝ), ∀ x : ℝ, S w x = lam ^ 2 * w (lam * x)) ∧
        (∀ w : 𝓢(ℝ, ℝ), ∀ x : ℝ, kdvRHS (S w) x = lam ^ 5 * kdvRHS w (lam * x)) := by
    intro lam hlam
    let g_lam : ℝ →L[ℝ] ℝ := lam • ContinuousLinearMap.id ℝ ℝ
    have h_temp : Function.HasTemperateGrowth g_lam := g_lam.hasTemperateGrowth
    let K : NNReal := Real.toNNReal lam⁻¹
    have h_anti : AntilipschitzWith K g_lam := by
      rw [antilipschitzWith_iff_le_mul_dist]
      intro x y
      have hK : (K : ℝ) = lam⁻¹ := Real.coe_toNNReal _ (by positivity)
      rw [hK, Real.dist_eq, Real.dist_eq]
      have h_glam : ∀ z : ℝ, g_lam z = lam * z := fun z => by dsimp [g_lam]
      rw [h_glam x, h_glam y, ← mul_sub, abs_mul, abs_of_pos hlam, ← mul_assoc,
          inv_mul_cancel₀ (ne_of_gt hlam), one_mul]
    let S : 𝓢(ℝ, ℝ) →L[ℝ] 𝓢(ℝ, ℝ) :=
      (lam ^ 2) • SchwartzMap.compCLMOfAntilipschitz ℝ h_temp h_anti
    have hS_eval : ∀ w : 𝓢(ℝ, ℝ), ∀ x : ℝ, S w x = lam ^ 2 * w (lam * x) := by
      intro w x
      dsimp [S, g_lam]
    refine ⟨S, hS_eval, ?_⟩
    intro w x
    have hS_fn : (S w : ℝ → ℝ) = fun z => lam ^ 2 * w (lam * z) := by
      ext z
      exact hS_eval w z
    have h_iter : ∀ n : ℕ, iteratedDeriv n (S w) x = lam ^ 2 * (lam ^ n * iteratedDeriv n w (lam * x)) := by
      intro n
      have hw_n : ContDiff ℝ (↑n) (w : ℝ → ℝ) := w.smooth n
      have h_comp_n : ContDiff ℝ (↑n) (fun z : ℝ => w (lam * z)) :=
        hw_n.comp (contDiff_const.mul contDiff_id)
      rw [hS_fn, iteratedDeriv_const_mul h_comp_n.contDiffAt (lam ^ 2),
          iteratedDeriv_comp_const_mul hw_n lam]
    have h_d1 : deriv (S w) x = lam ^ 3 * deriv w (lam * x) := by
      rw [← iteratedDeriv_one, h_iter 1, iteratedDeriv_one]
      ring
    have h_d3 : iteratedDeriv 3 (S w) x = lam ^ 5 * iteratedDeriv 3 w (lam * x) := by
      rw [h_iter 3]
      ring
    dsimp [kdvRHS]
    rw [h_d3, h_d1, hS_eval w x]
    ring
  have s2 : ∀ (lam : ℝ), 0 < lam → ∀ (S : 𝓢(ℝ, ℝ) →L[ℝ] 𝓢(ℝ, ℝ)),
      (∀ w : 𝓢(ℝ, ℝ), ∀ x : ℝ, S w x = lam ^ 2 * w (lam * x)) →
      (∀ w : 𝓢(ℝ, ℝ), ∀ x : ℝ, kdvRHS (S w) x = lam ^ 5 * kdvRHS w (lam * x)) →
      ∀ (u : ℝ → 𝓢(ℝ, ℝ)), IsSchwartzSolution u →
      IsSchwartzSolution (fun t => S (u (lam ^ 3 * t))) := by
    intro lam hlam S hS_eval hS_rhs u hu t
    set c : ℝ := lam ^ 3
    have hc_pos : 0 < c := by positivity
    have hc_ne : c ≠ 0 := ne_of_gt hc_pos
    obtain ⟨v, hv_deriv, hv_rhs⟩ := hu (c * t)
    refine ⟨c • S v, ?_, ?_⟩
    · show HasFDerivAtFilter (fun t' => S (u (c * t')))
        (ContinuousLinearMap.toSpanSingleton ℝ (c • S v)) t (nhds t)
      rw [hasFDerivAtFilter_iff_isLittleOTVS]
      rw [Asymptotics.isLittleOTVS_iff_tendsto_inv_smul]
      · have h_lim : Filter.Tendsto
            (fun s : ℝ => (s - c * t)⁻¹ • (u s - u (c * t) - (ContinuousLinearMap.toSpanSingleton ℝ v) (s - c * t)))
            (nhds (c * t)) (nhds 0) :=
          hv_deriv.isLittleOTVS.tendsto_inv_smul
