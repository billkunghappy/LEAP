        _ = B₁ * ((1 + y ^ 2)⁻¹) ^ 2 := by dsimp [B₁]; ring
    obtain ⟨h_iter1_cont, hG₁_cont, hg₁_cont, hG₁_sum_norm, hG₁_le, hg₁_bounds, _hG₁_peel, h_rho1_int⟩ :=
      h_single w₁ B₁ hw₁ hB₁ hw₁_decay
    obtain ⟨h_iter2_cont, hG₂_cont, hg₂_cont, hG₂_sum_norm, hG₂_le, hg₂_bounds, hG₂_peel, h_rho2_int⟩ :=
      h_single w₂ B₂ hw₂ hB₂ hw₂_decay
    have hm_le_pow : ∀ m : ℕ, ((m : ℝ) + 1) ≤ (2 : ℝ) ^ m := by
      intro m
      induction m with
      | zero => norm_num
      | succ m ih =>
