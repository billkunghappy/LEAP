  have hw_seq0 : ∀ t : ℝ, w_seq 0 t = w₀ := fun _ => rfl
  have hw_seq_cont : ∀ m : ℕ, Continuous (w_seq m) := fun m => (P m).2
  have hw_seq_int : ∀ (m : ℕ) (t : ℝ) (n : ℕ) (x : ℝ),
      iteratedDeriv n (w_seq (m + 1) t) x =
        iteratedDeriv n w₀ x + ∫ τ in (0 : ℝ)..t, iteratedDeriv n (V (w_seq m τ)) x :=
    fun m => (h_int_ex w₀ (fun t => V (w_seq m t)) (hV_cont (w_seq m) (P m).2)).choose_spec.2.1
  have hw_seq_tier : ∀ (m K n : ℕ) (t : ℝ),
      schwartzTierNorm K n (w_seq (m + 1) t) ≤
        schwartzTierNorm K n w₀ +
