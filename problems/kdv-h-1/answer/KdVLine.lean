    let Δ_w : ℝ → 𝓢(ℝ, ℝ) := fun τ =>
      (τ - (t - s₀))⁻¹ • (w τ - w (t - s₀) - (ContinuousLinearMap.toSpanSingleton ℝ v₂) (τ - (t - s₀)))
    have h_Δ_lim : Filter.Tendsto Δ_w (nhds (t - s₀)) (nhds 0) :=
