            A w₂ ℓ η * ‖fourierLine w_Δ (ξ - η)‖ / (1 + η ^ 2) := by
        intro η
        rw [h_alg η, norm_div, Complex.norm_real, Real.norm_of_nonneg (le_of_lt (h_denom_pos η)), ← add_div]
        refine div_le_div_of_nonneg_right ?_ (le_of_lt (h_denom_pos η))
        calc ‖Δψ ℓ η * fourierLine w₁ (ξ - η) +
              iterWavePacketOne w₂ ℓ x η * fourierLine w_Δ (ξ - η)‖
          _ ≤ ‖Δψ ℓ η * fourierLine w₁ (ξ - η)‖ +
              ‖iterWavePacketOne w₂ ℓ x η * fourierLine w_Δ (ξ - η)‖ := norm_add_le _ _
          _ = A_Δ ℓ η * ‖fourierLine w₁ (ξ - η)‖ +
