    obtain ⟨_, _, _, _, h_dh1_cont, h_dh1_int, h_dh1_h1int, h_dh1_norm⟩ :=
      greenIterKernel_one_first_h1_isometry w₁ w₂
    obtain ⟨h_all_ℓ1, h_all_m12⟩ :=
      greenIterKernel_one_higher_diff_bounds (1 / 256) (by norm_num) w₁ w₂ hw₁ hw₂
    obtain ⟨h_all_ℓ2, _⟩ :=
      greenIterKernel_one_higher_diff_bounds (1 / 256) (by norm_num) w₂ w₂ hw₂ hw₂
    obtain ⟨_, _, _, _, _, h_dr2_cont, h_dr2_int, h_dr2_h1int, h_dr2_norm⟩ :=
      diagGreen_one_tail_diff_h1_bounds w₁ w₂ hw₁ hw₂ h_all_ℓ1 h_all_ℓ2 h_all_m12
    set ΔL : ℝ → ℝ := fun x => 2 * (greenIterKernel 1 w₁ 1 x x - greenIterKernel 1 w₂ 1 x x)
    set ΔR₁ : ℝ → ℝ := fun x => 2 * ((diagGreen 1 w₁ x - 1 / 2 - greenIterKernel 1 w₁ 1 x x) -
      (diagGreen 1 w₂ x - 1 / 2 - greenIterKernel 1 w₂ 1 x x))
    set ΔR₂ : ℝ → ℝ := fun x => (recipGreenDiff w₁ x - recipGreenDiff w₂ x) -
      2 * ((diagGreen 1 w₁ x - 1 / 2) - (diagGreen 1 w₂ x - 1 / 2))
    have h_ΔL_cont : Continuous ΔL := continuous_const.mul h_dh1_cont
    have h_ΔL_int : Integrable ΔL := h_dh1_int.const_mul 2
    obtain ⟨h_ΔL_h1int, h_ΔL_norm_eq⟩ := h_smul 2 _ h_dh1_h1int
    have h_ΔL_norm : h1NormSq ΔL = 4 * ‖ι w₁ - ι w₂‖ ^ 2 := by
      linarith [h_ΔL_norm_eq, h_dh1_norm]
    have h_ΔR₁_cont : Continuous ΔR₁ := continuous_const.mul h_dr2_cont
    have h_ΔR₁_int : Integrable ΔR₁ := h_dr2_int.const_mul 2
    obtain ⟨h_ΔR₁_h1int, h_ΔR₁_norm_eq⟩ := h_smul 2 _ h_dr2_h1int
    have h_ΔR₁_norm : h1NormSq ΔR₁ ≤ (1 / 8) * ‖ι w₁ - ι w₂‖ ^ 2 := by
      linarith [h_ΔR₁_norm_eq, h_dr2_norm]
    
    set U : ℝ → ℝ := fun x => (-1 : ℝ) * (ΔL x + ΔR₁ x)
    have h_U_cont : Continuous U := continuous_const.mul (h_ΔL_cont.add h_ΔR₁_cont)
    obtain ⟨h_LR1_int, h_LR1_h1int, h_LR1_norm_le, _⟩ :=
      h_add ΔL ΔR₁ h_ΔL_int h_ΔR₁_int h_ΔL_h1int h_ΔR₁_h1int
    have h_U_int : Integrable U := h_LR1_int.const_mul (-1)
    obtain ⟨h_U_h1int, h_U_norm_eq⟩ := h_smul (-1) (fun x => ΔL x + ΔR₁ x) h_LR1_h1int
    have h_U_norm : h1NormSq U ≤ 9 * ‖ι w₁ - ι w₂‖ ^ 2 := by
      linarith [h_U_norm_eq, h_LR1_norm_le, h_ΔL_norm, h_ΔR₁_norm, sq_nonneg ‖ι w₁ - ι w₂‖]
    
    set Ψ₁ : ℝ → ℝ := recipGreenDiff w₁
    set Ψ₂ : ℝ → ℝ := recipGreenDiff w₂
    obtain ⟨h_psi12_int, h_psi12_h1int, h_psi12_norm_le, _⟩ :=
      h_add Ψ₁ Ψ₂ h_psi1_int h_psi2_int h_psi1_h1int h_psi2_h1int
    obtain ⟨h_prod_cont, h_prod_int, h_prod_h1int, h_prod_norm_le⟩ :=
      h1NormSq_mul_submultiplicative Ψ₁ Ψ₂ h_psi1_cont h_psi2_cont
        h_psi1_int h_psi2_int h_psi1_h1int h_psi2_h1int
    obtain ⟨h_nprod_h1int, h_nprod_norm_eq⟩ := h_smul (-1) (fun x => Ψ₁ x * Ψ₂ x) h_prod_h1int
    set Q : ℝ → ℝ := fun x => (Ψ₁ x + Ψ₂ x) + (-1 : ℝ) * (Ψ₁ x * Ψ₂ x)
    have h_Q_cont : Continuous Q := (h_psi1_cont.add h_psi2_cont).add (continuous_const.mul h_prod_cont)
    obtain ⟨h_Q_int, h_Q_h1int, h_Q_norm_le, _⟩ :=
      h_add (fun x => Ψ₁ x + Ψ₂ x) (fun x => (-1 : ℝ) * (Ψ₁ x * Ψ₂ x))
        h_psi12_int (h_prod_int.const_mul (-1)) h_psi12_h1int h_nprod_h1int
    have h_psi1_le : h1NormSq Ψ₁ ≤ 1 / 1024 := by
      have h_sq : ‖ι w₁‖ ^ 2 ≤ (1 / 256 : ℝ) ^ 2 :=
