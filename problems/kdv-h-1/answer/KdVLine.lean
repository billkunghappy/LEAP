      have h_xc_ne : x - c ≠ 0 := ne_of_gt (sub_pos.mpr hc.2)
      have hd_val : iteratedDeriv 2 f x - iteratedDeriv 2 f c = iteratedDeriv 3 f d * (x - c) :=
