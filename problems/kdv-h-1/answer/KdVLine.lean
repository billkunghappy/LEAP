        have h1 : 1 / (2 * g₁ x * g₂ x) ≤ 1 / (2 * (1 / (4 * M)) * (1 / (4 * M))) :=
          one_div_le_one_div_of_le (by positivity) h_prod
        have h2 : 1 / (2 * (1 / (4 * M)) * (1 / (4 * M))) = 8 * M ^ 2 := by field_simp [hM_ne]; ring
        have h3 : 8 * M ^ 2 ≤ 8 * M ^ 3 := by nlinarith [sq_nonneg M]
        linarith
      have h_inv2 : 1 / (2 * g₁ x * (g₂ x) ^ 2) ≤ 32 * M ^ 3 := by
        have h_sq : (1 / (4 * M)) ^ 2 ≤ (g₂ x) ^ 2 :=
          pow_le_pow_left₀ (by positivity) (hg₂_bounds x).1 2
        have h_prod : 2 * (1 / (4 * M)) * (1 / (4 * M)) ^ 2 ≤ 2 * g₁ x * (g₂ x) ^ 2 := by
          have h12 : (1 / (4 * M)) * (1 / (4 * M)) ^ 2 ≤ g₁ x * (g₂ x) ^ 2 :=
            mul_le_mul (hg₁_bounds x).1 h_sq (by positivity) (le_of_lt (hg₁_pos x))
          linarith
        have h1 : 1 / (2 * g₁ x * (g₂ x) ^ 2) ≤ 1 / (2 * (1 / (4 * M)) * (1 / (4 * M)) ^ 2) :=
          one_div_le_one_div_of_le (by positivity) h_prod
        have h2 : 1 / (2 * (1 / (4 * M)) * (1 / (4 * M)) ^ 2) = 32 * M ^ 3 := by field_simp [hM_ne]; ring
        linarith
      have ht1 : |Δg x - δg x| / (2 * g₁ x * g₂ x) ≤
          (32 * π ^ 2 * M ^ 3 * (1 + π * B₂) * B_Δ ^ 2) * (1 + x ^ 2)⁻¹ := by
        calc |Δg x - δg x| / (2 * g₁ x * g₂ x)
          _ = (1 / (2 * g₁ x * g₂ x)) * |Δg x - δg x| := by ring
          _ ≤ (8 * M ^ 3) * ((4 * π ^ 2 * (1 + π * B₂) * B_Δ ^ 2) * (1 + x ^ 2)⁻¹) :=
            mul_le_mul h_inv1 (hΔg_sub_δg_bd x) (abs_nonneg _) (by positivity)
          _ = (32 * π ^ 2 * M ^ 3 * (1 + π * B₂) * B_Δ ^ 2) * (1 + x ^ 2)⁻¹ := by ring
      have hΔg_bd : |Δg x| ≤ π * B_Δ := hG_lip x x
      have h_prod_bd : |Δg x| * |δg x| ≤ (4 * π ^ 2 * (1 + π * B₂) * B_Δ ^ 2) * (1 + x ^ 2)⁻¹ := by
        calc |Δg x| * |δg x|
          _ ≤ (π * B_Δ) * ((4 * π * (1 + π * B₂) * B_Δ) * (1 + x ^ 2)⁻¹) :=
            mul_le_mul hΔg_bd (hδg_bd x) (abs_nonneg _) (by positivity)
          _ = (4 * π ^ 2 * (1 + π * B₂) * B_Δ ^ 2) * (1 + x ^ 2)⁻¹ := by ring
      have ht2 : (|Δg x| * |δg x|) / (2 * g₁ x * (g₂ x) ^ 2) ≤
          (128 * π ^ 2 * M ^ 3 * (1 + π * B₂) * B_Δ ^ 2) * (1 + x ^ 2)⁻¹ := by
        calc (|Δg x| * |δg x|) / (2 * g₁ x * (g₂ x) ^ 2)
          _ = (1 / (2 * g₁ x * (g₂ x) ^ 2)) * (|Δg x| * |δg x|) := by ring
          _ ≤ (32 * M ^ 3) * ((4 * π ^ 2 * (1 + π * B₂) * B_Δ ^ 2) * (1 + x ^ 2)⁻¹) :=
            mul_le_mul h_inv2 h_prod_bd (by positivity) (by positivity)
          _ = (128 * π ^ 2 * M ^ 3 * (1 + π * B₂) * B_Δ ^ 2) * (1 + x ^ 2)⁻¹ := by ring
      calc |(Δg x - δg x) / (2 * g₁ x * g₂ x) - (Δg x * δg x) / (2 * g₁ x * (g₂ x) ^ 2)|
        _ ≤ |Δg x - δg x| / (2 * g₁ x * g₂ x) + (|Δg x| * |δg x|) / (2 * g₁ x * (g₂ x) ^ 2) := h_tri
        _ ≤ (32 * π ^ 2 * M ^ 3 * (1 + π * B₂) * B_Δ ^ 2) * (1 + x ^ 2)⁻¹ +
            (128 * π ^ 2 * M ^ 3 * (1 + π * B₂) * B_Δ ^ 2) * (1 + x ^ 2)⁻¹ := add_le_add ht1 ht2
        _ = C_Q * (1 + x ^ 2)⁻¹ := by dsimp [C_Q]; ring
    have hQ_dom_int : Integrable (fun x : ℝ => C_Q * (1 + x ^ 2)⁻¹) volume :=
      integrable_inv_one_add_sq.const_mul C_Q
    have hQ_int : Integrable Q volume :=
      hQ_dom_int.mono' hQ_cont.aestronglyMeasurable (Filter.Eventually.of_forall hQ_pw)
    have hQ_int_le : |∫ x : ℝ, Q x| ≤ 160 * π ^ 3 * M ^ 3 * (1 + π * B₂) * B_Δ ^ 2 := by
      calc |∫ x : ℝ, Q x|
        _ ≤ ∫ x : ℝ, ‖Q x‖ := by simpa [Real.norm_eq_abs] using norm_integral_le_integral_norm Q
        _ ≤ ∫ x : ℝ, C_Q * (1 + x ^ 2)⁻¹ := integral_mono hQ_int.norm hQ_dom_int hQ_pw
        _ = C_Q * ∫ x : ℝ, (1 + x ^ 2)⁻¹ := integral_const_mul C_Q _
        _ = 160 * π ^ 3 * M ^ 3 * (1 + π * B₂) * B_Δ ^ 2 := by
          rw [integral_univ_inv_one_add_sq]; dsimp [C_Q]; ring
    have h_rho12_int : Integrable (fun x : ℝ => rhoDensity M w₁ x - rhoDensity M w₂ x) volume :=
      h_rho1_int.sub h_rho2_int
    have h_rhoDeriv_int : Integrable (rhoDerivDensity M w₂ (w₁ - w₂)) volume := by
      have h_eq : rhoDerivDensity M w₂ (w₁ - w₂) =
          fun x => (rhoDensity M w₁ x - rhoDensity M w₂ x) - Q x := by
        ext x; dsimp [Q]; ring
      rw [h_eq]
      exact h_rho12_int.sub hQ_int
    have h_quad_eq : alphaFunctional M w₁ - alphaFunctional M w₂ -
        ∫ x : ℝ, rhoDerivDensity M w₂ (w₁ - w₂) x = ∫ x : ℝ, Q x := by
      dsimp [alphaFunctional, Q]
      rw [← integral_sub h_rho1_int h_rho2_int, ← integral_sub h_rho12_int h_rhoDeriv_int]
    let φ : ℝ → ℝ := fun x => 1 / (2 * M) - diagGreen M w₂ x
    have hφ_cont : Continuous φ := continuous_const.sub hg₂_cont
    have hφ_le : ∀ x : ℝ, |φ x| ≤ 1 := by
      intro x
      dsimp [φ]
      rw [abs_sub_comm]
      have h1 := (hg₂_bounds x).2
      have h2 : 1 / (6 * M) ≤ 1 := by rw [div_le_iff₀ (by positivity)]; linarith
      exact le_trans h1 h2
    have hφ_int : ∀ r : 𝓢(ℝ, ℝ), Integrable (fun x : ℝ => φ x * r x) volume := by
      intro r
      refine r.integrable.norm.mono' (hφ_cont.mul r.continuous).aestronglyMeasurable ?_
      filter_upwards with x
      rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul]
      calc |φ x| * |r x|
        _ ≤ 1 * |r x| := mul_le_mul_of_nonneg_right (hφ_le x) (abs_nonneg _)
        _ = |r x| := one_mul _
    have h_lin_rem_int : Integrable (fun y : ℝ => |w₁ y - w₂ y - h * v y|) volume := by
      simpa [Real.norm_eq_abs] using (w₁ - w₂ - h • v).integrable.norm
    have h_lin_eq : (∫ x : ℝ, rhoDerivDensity M w₂ (w₁ - w₂) x) -
        h * (∫ x : ℝ, φ x * v x) =
        ∫ x : ℝ, φ x * (w₁ x - w₂ x - h * v x) := by
      rw [h_fub_Δ]
      change (∫ x : ℝ, φ x * (w₁ - w₂) x) - h * (∫ x : ℝ, φ x * v x) = _
      rw [← integral_const_mul, ← integral_sub (hφ_int (w₁ - w₂)) ((hφ_int v).const_mul h)]
      refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
      simp only [SchwartzMap.sub_apply]
      ring
    have h_lin_le : |(∫ x : ℝ, rhoDerivDensity M w₂ (w₁ - w₂) x) - h * (∫ x : ℝ, φ x * v x)| ≤
        ∫ y : ℝ, |w₁ y - w₂ y - h * v y| := by
      rw [h_lin_eq]
      let L_fn : ℝ → ℝ := fun x => φ x * (w₁ x - w₂ x - h * v x)
      have hL_dom : ∀ x : ℝ, ‖L_fn x‖ ≤ |w₁ x - w₂ x - h * v x| := by
        intro x
        dsimp [L_fn]
        rw [abs_mul]
        calc |φ x| * |w₁ x - w₂ x - h * v x|
          _ ≤ 1 * |w₁ x - w₂ x - h * v x| := mul_le_mul_of_nonneg_right (hφ_le x) (abs_nonneg _)
          _ = |w₁ x - w₂ x - h * v x| := one_mul _
      have hL_int : Integrable L_fn volume := by
        have h_eq : L_fn = fun x => φ x * (w₁ - w₂ - h • v) x := by
          ext x; rfl
        rw [h_eq]
        exact hφ_int (w₁ - w₂ - h • v)
      calc |∫ x : ℝ, L_fn x|
        _ ≤ ∫ x : ℝ, ‖L_fn x‖ := by simpa [Real.norm_eq_abs] using norm_integral_le_integral_norm L_fn
        _ ≤ ∫ y : ℝ, |w₁ y - w₂ y - h * v y| := integral_mono hL_int.norm h_lin_rem_int hL_dom
    have h_split : alphaFunctional M w₁ - alphaFunctional M w₂ - h * (∫ x : ℝ, φ x * v x) =
        ((∫ x : ℝ, rhoDerivDensity M w₂ (w₁ - w₂) x) - h * (∫ x : ℝ, φ x * v x)) +
        (alphaFunctional M w₁ - alphaFunctional M w₂ - ∫ x : ℝ, rhoDerivDensity M w₂ (w₁ - w₂) x) := by
      ring
    change |alphaFunctional M w₁ - alphaFunctional M w₂ - h * (∫ x : ℝ, φ x * v x)| ≤ _
    rw [h_split, h_quad_eq]
    exact le_trans (abs_add_le _ _) (add_le_add h_lin_le hQ_int_le)
  obtain ⟨δ_weyl, hδ_weyl, h_weyl⟩ := greenKernel_sq_div_diagGreen_sq_integral
  obtain ⟨δ_fub, hδ_fub, h_fub⟩ := integral_rhoDerivDensity_eq_of_weyl_identity
  set δ₂ : ℝ := min (1 / 8) (min δ_weyl δ_fub)
  have hδ₂ : 0 < δ₂ := by positivity
  refine ⟨δ₂, hδ₂, ?_⟩
  intro κ _hκ M hM w v s h_deriv hv_eq hs_norm
  have hs_eighth : ‖ι (w s)‖ ≤ 1 / 8 := le_trans hs_norm (min_le_left _ _)
  have hs_quarter : ‖ι (w s)‖ ≤ 1 / 4 := by linarith
  have hs_weyl : ‖ι (w s)‖ ≤ δ_weyl :=
    le_trans hs_norm (le_trans (min_le_right _ _) (min_le_left _ _))
  have hs_fub : ‖ι (w s)‖ ≤ δ_fub :=
    le_trans hs_norm (le_trans (min_le_right _ _) (min_le_right _ _))
  have h_bound : ∀ (q : 𝓢(ℝ, ℝ)), ‖ι q‖ ≤ 1 / 4 → ∀ (ℓ : ℕ) (x y : ℝ),
      |greenIterKernel M q ℓ x y| ≤ (1 / (2 * M)) * (1 / 4) ^ ℓ := by
    intro q hq ℓ x y
    exact le_trans (greenIterKernel_offDiag_pointwise_bound M hM q ℓ x y)
      (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) hq ℓ) (by positivity))
  have h_tele := greenIterKernel_sub_eq_sum_antidiagonal M hM
  have h_fub_Δ : ∀ τ : ℝ,
      ∫ x : ℝ, rhoDerivDensity M (w s) (w τ - w s) x =
        ∫ x : ℝ, (1 / (2 * M) - diagGreen M (w s) x) * (w τ x - w s x) :=
    fun τ => h_fub M hM (w s) (w τ - w s) hs_fub (h_weyl M hM (w s) hs_weyl)
  obtain ⟨hP_decay, h_norm_tendsto, h_lin_tendsto, h_quad_tendsto⟩ :=
    schwartz_hasDerivAt_quad_seminorm_and_hm1_tendsto w v s h_deriv
  let P₀ : 𝓢(ℝ, ℝ) → ℝ :=
    fun f => 2 * ((SchwartzMap.seminorm ℝ 0 0 + SchwartzMap.seminorm ℝ 4 0 : Seminorm ℝ 𝓢(ℝ, ℝ)) f)
  have hP₀_nn : ∀ f : 𝓢(ℝ, ℝ), 0 ≤ P₀ f :=
    fun f => mul_nonneg zero_le_two (apply_nonneg _ f)
  set B₂ : ℝ := P₀ (w s)
  have hB₂_nn : 0 ≤ B₂ := hP₀_nn (w s)
  set K_Q : ℝ := 160 * π ^ 3 * M ^ 3 * (1 + π * B₂)
  set D : ℝ := ∫ x : ℝ, (1 / (2 * M) - diagGreen M (w s) x) * v x
  have hD_eq : D = ∫ x : ℝ, (1 / (2 * M) - diagGreen M (w s) x) * regFlowRHS κ (w s) x := by
    dsimp [D]
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    dsimp only
    rw [hv_eq x]
  rw [← hD_eq, hasDerivAt_iff_tendsto]
  have hs_lt_quarter : ‖ι (w s)‖ < 1 / 4 := by linarith
  have hV_ball : ∀ᶠ τ in nhds s, ‖ι (w τ)‖ < 1 / 4 :=
    h_norm_tendsto.eventually (Iio_mem_nhds hs_lt_quarter)
  let U : ℝ → ℝ := fun τ =>
    (‖τ - s‖⁻¹ * ∫ y : ℝ, |w τ y - w s y - (τ - s) * v y|) +
      K_Q * (‖τ - s‖⁻¹ * (P₀ (w τ - w s)) ^ 2)
  have hU_tendsto : Filter.Tendsto U (nhds s) (nhds 0) := by
    have h_q : Filter.Tendsto (fun τ : ℝ => K_Q * (‖τ - s‖⁻¹ * (P₀ (w τ - w s)) ^ 2)) (nhds s) (nhds (K_Q * 0)) :=
      h_quad_tendsto.const_mul K_Q
    have h_sum := h_lin_tendsto.add h_q
    simpa [U] using h_sum
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hU_tendsto
    (Filter.Eventually.of_forall fun τ => by positivity) ?_
  filter_upwards [hV_ball] with τ hτ
  have hτ_quarter : ‖ι (w τ)‖ ≤ 1 / 4 := le_of_lt hτ
  have h_lin_bound :=
    alphaFunctional_sub_and_linearization_bound M hM h_bound h_tele (w τ) (w s) v
      hτ_quarter hs_quarter B₂ (P₀ (w τ - w s)) hB₂_nn (hP₀_nn (w τ - w s))
      (hP_decay (w s)) (hP_decay (w τ - w s)) (h_fub_Δ τ) (τ - s)
  have h_norm_eq : ‖alphaFunctional M (w τ) - alphaFunctional M (w s) - (τ - s) • D‖ =
      |alphaFunctional M (w τ) - alphaFunctional M (w s) - (τ - s) * D| := by
    rw [Real.norm_eq_abs, smul_eq_mul]
  rw [h_norm_eq]
  have h_mul := mul_le_mul_of_nonneg_left h_lin_bound (inv_nonneg.mpr (norm_nonneg (τ - s)))
  calc ‖τ - s‖⁻¹ * |alphaFunctional M (w τ) - alphaFunctional M (w s) - (τ - s) * D|
    _ ≤ ‖τ - s‖⁻¹ * ((∫ y : ℝ, |w τ y - w s y - (τ - s) * v y|) +
          160 * π ^ 3 * M ^ 3 * (1 + π * B₂) * (P₀ (w τ - w s)) ^ 2) := h_mul
    _ = U τ := by dsimp [U, K_Q]; ring

theorem regFlowRHS_orthogonality_diagGreen : ∃ δ₃ : ℝ, 0 < δ₃ ∧
      ∀ (κ : ℝ), 2 ≤ κ → ∀ (M : ℝ), 1 ≤ M →
        ∀ (w : 𝓢(ℝ, ℝ)), ‖ι w‖ ≤ δ₃ →
          ∫ x : ℝ, (1 / (2 * M) - diagGreen M w x) * regFlowRHS κ w x = 0 :=
by
  obtain ⟨δ_reg, hδ_reg, h_reg⟩ := diagGreen_sub_const_mem_schwartz
  obtain ⟨δ_ode, hδ_ode, h_ode⟩ := diagGreen_third_order_ode
  refine ⟨min δ_reg δ_ode, lt_min hδ_reg hδ_ode, ?_⟩
  intro κ hκ M hM w hw
  have hκ1 : 1 ≤ κ := by linarith
  have hw_reg : ‖ι w‖ ≤ δ_reg := le_trans hw (min_le_left _ _)
  have hw_ode : ‖ι w‖ ≤ δ_ode := le_trans hw (min_le_right _ _)
  obtain ⟨g_tilde_M, hgM_eq⟩ := h_reg M hM w hw_reg
  obtain ⟨g_tilde_κ, hgκ_eq⟩ := h_reg κ hκ1 w hw_reg
  have h_sub_M : (fun y => diagGreen M w y - 1 / (2 * M)) = (g_tilde_M : ℝ → ℝ) := by
    ext y
    rw [hgM_eq y]
    ring
  have h_sub_κ : (fun y => diagGreen κ w y - 1 / (2 * κ)) = (g_tilde_κ : ℝ → ℝ) := by
    ext y
    rw [hgκ_eq y]
    ring
  have hgM_ode : ∀ x : ℝ, iteratedDeriv 3 g_tilde_M x =
      2 * deriv w x * (1 / (2 * M) + g_tilde_M x) +
      4 * w x * deriv g_tilde_M x +
      4 * M ^ 2 * deriv g_tilde_M x := by
    intro x
    have hx := h_ode M hM w hw_ode x
    rw [h_sub_M, hgM_eq x] at hx
    exact hx
  have hgκ_ode : ∀ x : ℝ, iteratedDeriv 3 g_tilde_κ x =
      2 * deriv w x * (1 / (2 * κ) + g_tilde_κ x) +
      4 * w x * deriv g_tilde_κ x +
      4 * κ ^ 2 * deriv g_tilde_κ x := by
    intro x
    have hx := h_ode κ hκ1 w hw_ode x
    rw [h_sub_κ, hgκ_eq x] at hx
    exact hx
  let D : 𝓢(ℝ, ℝ) → 𝓢(ℝ, ℝ) := fun f => SchwartzMap.derivCLM ℝ ℝ f
  have hD_apply : ∀ (f : 𝓢(ℝ, ℝ)) (x : ℝ), D f x = deriv f x :=
    fun f x => SchwartzMap.derivCLM_apply ℝ f x
  have hD2_apply : ∀ (f : 𝓢(ℝ, ℝ)) (x : ℝ), D (D f) x = iteratedDeriv 2 f x := by
    intro f x
    rw [hD_apply]
    have h : (D f : ℝ → ℝ) = iteratedDeriv 1 f := by
      ext y
      rw [hD_apply, iteratedDeriv_one]
    rw [h, ← iteratedDeriv_succ]
  have hD3_apply : ∀ (f : 𝓢(ℝ, ℝ)) (x : ℝ), D (D (D f)) x = iteratedDeriv 3 f x := by
    intro f x
    rw [hD_apply]
    have h : (D (D f) : ℝ → ℝ) = iteratedDeriv 2 f := funext (hD2_apply f)
    rw [h, ← iteratedDeriv_succ]
  have h_hasDerivAt : ∀ (f : 𝓢(ℝ, ℝ)) (x : ℝ), HasDerivAt f (D f x) x := by
    intro f x
    rw [hD_apply]
    exact (f.smooth'.contDiffAt.differentiableAt (by norm_num)).hasDerivAt
  have h_mul_int : ∀ (f g : 𝓢(ℝ, ℝ)), Integrable (fun x => f x * g x) volume := by
    intro f g
    have hg : Integrable g volume := g.integrable
    have hf_cont : Continuous f := f.continuous
    obtain ⟨C, hC⟩ := f.toBoundedContinuousFunction.isBounded_range.exists_norm_le
    exact hg.bdd_mul hf_cont.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => hC (f x) ⟨x, rfl⟩)
  have h_deriv_κ : ∀ x : ℝ, deriv (diagGreen κ w) x = D g_tilde_κ x := by
    intro x
    have h_eq : diagGreen κ w = fun y => 1 / (2 * κ) + g_tilde_κ y := funext hgκ_eq
    rw [h_eq]
    exact ((h_hasDerivAt g_tilde_κ x).const_add (1 / (2 * κ))).deriv
  let w0 : 𝓢(ℝ, ℝ) := w
  let w1 : 𝓢(ℝ, ℝ) := D w0
  let m0 : 𝓢(ℝ, ℝ) := g_tilde_M
  let m1 : 𝓢(ℝ, ℝ) := D m0
  let m2 : 𝓢(ℝ, ℝ) := D m1
  let m3 : 𝓢(ℝ, ℝ) := D m2
  let k0 : 𝓢(ℝ, ℝ) := g_tilde_κ
  let k1 : 𝓢(ℝ, ℝ) := D k0
  let k2 : 𝓢(ℝ, ℝ) := D k1
  let k3 : 𝓢(ℝ, ℝ) := D k2
  have h_integrand : (fun x : ℝ => (1 / (2 * M) - diagGreen M w x) * regFlowRHS κ w x) =
      (fun x : ℝ => -16 * κ ^ 5 * (m0 x * k1 x) - 4 * κ ^ 2 * (m0 x * w1 x)) := by
    ext x
    dsimp only [regFlowRHS, m0, k0, k1, w0, w1]
    rw [hgM_eq x, h_deriv_κ x, hD_apply w x]
    ring
  rw [h_integrand]
  have h_drift : ∫ x : ℝ, m0 x * w1 x = 0 := by
    let Φ : ℝ → ℝ := fun x =>
      2 * (w0 x * m0 x) - (1 / 2) * m2 x + (1 / (2 * M)) * w0 x + 2 * M ^ 2 * m0 x
    have hΦ_deriv : ∀ x : ℝ, HasDerivAt Φ (m0 x * w1 x) x := by
      intro x
      have hw0 := h_hasDerivAt w0 x
      have hm0 := h_hasDerivAt m0 x
      have hm2 := h_hasDerivAt m2 x
      have hd : HasDerivAt Φ
          (2 * (w1 x * m0 x + w0 x * m1 x) - (1 / 2) * m3 x +
            (1 / (2 * M)) * w1 x + 2 * M ^ 2 * m1 x) x :=
        ((((hw0.mul hm0).const_mul 2).sub (hm2.const_mul (1 / 2))).add
          (hw0.const_mul (1 / (2 * M)))).add (hm0.const_mul (2 * M ^ 2))
      convert hd using 1
      dsimp only [w0, w1, m0, m1, m2, m3]
      rw [hD3_apply g_tilde_M x, hD_apply w x, hD_apply g_tilde_M x, hgM_ode x]
      have hM_ne : M ≠ 0 := by linarith
      field_simp
      ring
    have hΦ_tendsto : ∀ l : Filter ℝ, l ≤ Filter.cocompact ℝ → Filter.Tendsto Φ l (nhds 0) := by
      intro l hl
      have hz : ∀ f : 𝓢(ℝ, ℝ), Filter.Tendsto f l (nhds 0) := fun f =>
        (ZeroAtInftyContinuousMapClass.zero_at_infty f).mono_left hl
      have h2 : ∀ f g : 𝓢(ℝ, ℝ), Filter.Tendsto (fun x => f x * g x) l (nhds 0) := fun f g => by
        simpa only [mul_zero] using (hz f).mul (hz g)
      simpa only [Φ, mul_zero, add_zero, sub_zero] using
        ((((h2 w0 m0).const_mul 2).sub ((hz m2).const_mul (1 / 2))).add
          ((hz w0).const_mul (1 / (2 * M)))).add ((hz m0).const_mul (2 * M ^ 2))
    have h_ftc := MeasureTheory.integral_of_hasDerivAt_of_tendsto hΦ_deriv (h_mul_int m0 w1)
      (hΦ_tendsto Filter.atBot atBot_le_cocompact)
      (hΦ_tendsto Filter.atTop atTop_le_cocompact)
    linarith
  have h_bilin : ∫ x : ℝ, m0 x * k1 x = 0 := by
    by_cases hMκ : M = κ
    · have hm0_eq_k0 : ∀ x : ℝ, m0 x = k0 x := by
        intro x
        dsimp only [m0, k0]
        have h1 := hgM_eq x
        have h2 := hgκ_eq x
        subst hMκ
        linarith
      have h_eq_fn : (fun x : ℝ => m0 x * k1 x) = (fun x : ℝ => k0 x * k1 x) := by
        ext x
        rw [hm0_eq_k0 x]
      rw [h_eq_fn]
      let S : ℝ → ℝ := fun x => (1 / 2) * (k0 x * k0 x)
      have hS_deriv : ∀ x : ℝ, HasDerivAt S (k0 x * k1 x) x := by
        intro x
        have hk0 := h_hasDerivAt k0 x
        have hd : HasDerivAt S ((1 / 2) * (k1 x * k0 x + k0 x * k1 x)) x :=
          (hk0.mul hk0).const_mul (1 / 2)
        convert hd using 1
        ring
      have hS_tendsto : ∀ l : Filter ℝ, l ≤ Filter.cocompact ℝ → Filter.Tendsto S l (nhds 0) := by
        intro l hl
        have hz : Filter.Tendsto k0 l (nhds 0) :=
          (ZeroAtInftyContinuousMapClass.zero_at_infty k0).mono_left hl
        simpa only [S, mul_zero] using (hz.mul hz).const_mul (1 / 2)
      have h_ftc := MeasureTheory.integral_of_hasDerivAt_of_tendsto hS_deriv (h_mul_int k0 k1)
        (hS_tendsto Filter.atBot atBot_le_cocompact)
        (hS_tendsto Filter.atTop atTop_le_cocompact)
      linarith
    · let Ω : ℝ → ℝ := fun x =>
        ((1 / (2 * κ)) * m2 x + m2 x * k0 x - m1 x * k1 x + (1 / (2 * M)) * k2 x + m0 x * k2 x) -
        ((1 / (M * κ)) * w0 x + (2 / M) * (w0 x * k0 x) + (2 / κ) * (w0 x * m0 x) +
          4 * (w0 x * m0 x * k0 x)) -
        ((2 * M ^ 2 / κ) * m0 x + (2 * κ ^ 2 / M) * k0 x + 4 * M ^ 2 * (m0 x * k0 x))
      have hΩ_deriv : ∀ x : ℝ, HasDerivAt Ω (4 * (κ ^ 2 - M ^ 2) * (m0 x * k1 x)) x := by
        intro x
        have hw0 := h_hasDerivAt w0 x
        have hm0 := h_hasDerivAt m0 x
        have hm1 := h_hasDerivAt m1 x
        have hm2 := h_hasDerivAt m2 x
        have hk0 := h_hasDerivAt k0 x
        have hk1 := h_hasDerivAt k1 x
        have hk2 := h_hasDerivAt k2 x
        have hd1 : HasDerivAt
            (fun x => (1 / (2 * κ)) * m2 x + m2 x * k0 x - m1 x * k1 x + (1 / (2 * M)) * k2 x + m0 x * k2 x)
            ((1 / (2 * κ)) * m3 x + (m3 x * k0 x + m2 x * k1 x) - (m2 x * k1 x + m1 x * k2 x) +
              (1 / (2 * M)) * k3 x + (m1 x * k2 x + m0 x * k3 x)) x :=
          (((((hm2.const_mul (1 / (2 * κ))).add (hm2.mul hk0)).sub (hm1.mul hk1)).add
            (hk2.const_mul (1 / (2 * M)))).add (hm0.mul hk2))
        have hd2 : HasDerivAt
            (fun x => (1 / (M * κ)) * w0 x + (2 / M) * (w0 x * k0 x) + (2 / κ) * (w0 x * m0 x) +
              4 * (w0 x * m0 x * k0 x))
            ((1 / (M * κ)) * w1 x + (2 / M) * (w1 x * k0 x + w0 x * k1 x) +
              (2 / κ) * (w1 x * m0 x + w0 x * m1 x) +
              4 * ((w1 x * m0 x + w0 x * m1 x) * k0 x + (w0 x * m0 x) * k1 x)) x :=
          ((((hw0.const_mul (1 / (M * κ))).add ((hw0.mul hk0).const_mul (2 / M))).add
            ((hw0.mul hm0).const_mul (2 / κ))).add (((hw0.mul hm0).mul hk0).const_mul 4))
        have hd3 : HasDerivAt
            (fun x => (2 * M ^ 2 / κ) * m0 x + (2 * κ ^ 2 / M) * k0 x + 4 * M ^ 2 * (m0 x * k0 x))
            ((2 * M ^ 2 / κ) * m1 x + (2 * κ ^ 2 / M) * k1 x + 4 * M ^ 2 * (m1 x * k0 x + m0 x * k1 x)) x :=
          (((hm0.const_mul (2 * M ^ 2 / κ)).add (hk0.const_mul (2 * κ ^ 2 / M))).add
            ((hm0.mul hk0).const_mul (4 * M ^ 2)))
        have hd : HasDerivAt Ω _ x := (hd1.sub hd2).sub hd3
        convert hd using 1
        dsimp only [w0, w1, m0, m1, m2, m3, k0, k1, k2, k3]
        rw [hD3_apply g_tilde_M x, hD3_apply g_tilde_κ x, hD_apply w x,
            hD_apply g_tilde_M x, hD_apply g_tilde_κ x, hgM_ode x, hgκ_ode x]
        have hM_ne : M ≠ 0 := by linarith
        have hκ_ne : κ ≠ 0 := by linarith
        field_simp
        ring
      have hΩ_tendsto : ∀ l : Filter ℝ, l ≤ Filter.cocompact ℝ → Filter.Tendsto Ω l (nhds 0) := by
        intro l hl
        have hz : ∀ f : 𝓢(ℝ, ℝ), Filter.Tendsto f l (nhds 0) := fun f =>
          (ZeroAtInftyContinuousMapClass.zero_at_infty f).mono_left hl
        have h2 : ∀ f g : 𝓢(ℝ, ℝ), Filter.Tendsto (fun x => f x * g x) l (nhds 0) := fun f g => by
          simpa only [mul_zero] using (hz f).mul (hz g)
        have h3 : ∀ f g h : 𝓢(ℝ, ℝ), Filter.Tendsto (fun x => f x * g x * h x) l (nhds 0) := fun f g h => by
          simpa only [mul_zero] using (h2 f g).mul (hz h)
        have ht1 : Filter.Tendsto
            (fun x => (1 / (2 * κ)) * m2 x + m2 x * k0 x - m1 x * k1 x + (1 / (2 * M)) * k2 x + m0 x * k2 x)
            l (nhds 0) := by
          simpa only [mul_zero, add_zero, sub_zero] using
            (((((hz m2).const_mul (1 / (2 * κ))).add (h2 m2 k0)).sub (h2 m1 k1)).add
              ((hz k2).const_mul (1 / (2 * M)))).add (h2 m0 k2)
        have ht2 : Filter.Tendsto
            (fun x => (1 / (M * κ)) * w0 x + (2 / M) * (w0 x * k0 x) + (2 / κ) * (w0 x * m0 x) +
              4 * (w0 x * m0 x * k0 x))
            l (nhds 0) := by
          simpa only [mul_zero, add_zero, sub_zero] using
            ((((hz w0).const_mul (1 / (M * κ))).add ((h2 w0 k0).const_mul (2 / M))).add
              ((h2 w0 m0).const_mul (2 / κ))).add ((h3 w0 m0 k0).const_mul 4)
        have ht3 : Filter.Tendsto
            (fun x => (2 * M ^ 2 / κ) * m0 x + (2 * κ ^ 2 / M) * k0 x + 4 * M ^ 2 * (m0 x * k0 x))
            l (nhds 0) := by
          simpa only [mul_zero, add_zero, sub_zero] using
            (((hz m0).const_mul (2 * M ^ 2 / κ)).add ((hz k0).const_mul (2 * κ ^ 2 / M))).add
              ((h2 m0 k0).const_mul (4 * M ^ 2))
        simpa only [Ω, sub_zero] using (ht1.sub ht2).sub ht3
      have h_int_scaled : Integrable (fun x => 4 * (κ ^ 2 - M ^ 2) * (m0 x * k1 x)) volume :=
        (h_mul_int m0 k1).const_mul (4 * (κ ^ 2 - M ^ 2))
      have h_ftc := MeasureTheory.integral_of_hasDerivAt_of_tendsto hΩ_deriv h_int_scaled
        (hΩ_tendsto Filter.atBot atBot_le_cocompact)
        (hΩ_tendsto Filter.atTop atTop_le_cocompact)
      rw [sub_zero, MeasureTheory.integral_const_mul] at h_ftc
      have h_coeff_ne : 4 * (κ ^ 2 - M ^ 2) ≠ 0 := by
        have h_diff_ne : κ - M ≠ 0 := sub_ne_zero.mpr (Ne.symm hMκ)
        have h_sum_ne : κ + M ≠ 0 := by linarith
        have h_fac : 4 * (κ ^ 2 - M ^ 2) = 4 * (κ - M) * (κ + M) := by ring
        rw [h_fac]
        exact mul_ne_zero (mul_ne_zero (by norm_num) h_diff_ne) h_sum_ne
      exact (mul_eq_zero.mp h_ftc).resolve_left h_coeff_ne
  have h1 : Integrable (fun x => -16 * κ ^ 5 * (m0 x * k1 x)) volume :=
    (h_mul_int m0 k1).const_mul (-16 * κ ^ 5)
  have h2 : Integrable (fun x => 4 * κ ^ 2 * (m0 x * w1 x)) volume :=
    (h_mul_int m0 w1).const_mul (4 * κ ^ 2)
  rw [MeasureTheory.integral_sub h1 h2, MeasureTheory.integral_const_mul,
      MeasureTheory.integral_const_mul, h_bilin, h_drift]
  ring

theorem regTranslate_moving_frame_hasDerivAt_and_continuous : (∀ (w_tilde : ℝ → 𝓢(ℝ, ℝ)) (v_tilde : 𝓢(ℝ, ℝ)) (c s : ℝ),
      HasDerivAt w_tilde v_tilde s →
      ∃ v : 𝓢(ℝ, ℝ),
        HasDerivAt (fun t => regTranslate (c * t) (w_tilde t)) v s ∧
        ∀ x : ℝ, v x = v_tilde (x + c * s) + c * deriv (regTranslate (c * s) (w_tilde s)) x) ∧
    (∀ (u : ℝ → 𝓢(ℝ, ℝ)),
      (∀ t : ℝ, ∃ v : 𝓢(ℝ, ℝ), HasDerivAt u v t) →
      Continuous (fun t : ℝ => ‖ι (u t)‖)) :=
by
  refine ⟨?_, ?_⟩
  · have h_zero : ∀ f : 𝓢(ℝ, ℝ), regTranslate 0 f = f := by
      intro f
      ext x
      change f (x + 0) = f x
      rw [add_zero]
    have h_group : ∀ (a b : ℝ) (f : 𝓢(ℝ, ℝ)), regTranslate (a + b) f = regTranslate a (regTranslate b f) := by
      intro a b f
      ext x
      change f (x + (a + b)) = f (x + a + b)
      rw [add_assoc]
    have h_comm_deriv : ∀ (a : ℝ) (f : 𝓢(ℝ, ℝ)),
        SchwartzMap.derivCLM ℝ ℝ (regTranslate a f) = regTranslate a (SchwartzMap.derivCLM ℝ ℝ f) := by
      intro a f
      ext x
      rw [SchwartzMap.derivCLM_apply]
      change deriv (fun y : ℝ => f (y + a)) x = (SchwartzMap.derivCLM ℝ ℝ f) (x + a)
      rw [deriv_comp_add_const, SchwartzMap.derivCLM_apply]
    have h_iter_derivCLM : ∀ (n : ℕ) (f : 𝓢(ℝ, ℝ)) (x : ℝ),
        iteratedDeriv n (SchwartzMap.derivCLM ℝ ℝ f) x = iteratedDeriv (n + 1) f x := by
      intro n f
      induction n with
      | zero =>
        intro x
        rw [iteratedDeriv_zero, iteratedDeriv_one, SchwartzMap.derivCLM_apply]
      | succ n ih =>
        intro x
        rw [iteratedDeriv_succ, iteratedDeriv_succ]
        have h_eq : iteratedDeriv n (⇑(SchwartzMap.derivCLM ℝ ℝ f)) = iteratedDeriv (n + 1) (⇑f) := by
          ext y
          exact ih y
        rw [h_eq]
    have h_iter_sub : ∀ (n : ℕ) (f g : 𝓢(ℝ, ℝ)) (x : ℝ),
        iteratedDeriv n (⇑(f - g)) x = iteratedDeriv n f x - iteratedDeriv n g x := by
      intro n f g x
      have h_coe : (⇑(f - g) : ℝ → ℝ) = ⇑f - ⇑g := rfl
      rw [h_coe]
      exact iteratedDeriv_sub ((f.smooth n).contDiffAt) ((g.smooth n).contDiffAt)
    have h_iter_smul : ∀ (n : ℕ) (a : ℝ) (f : 𝓢(ℝ, ℝ)) (x : ℝ),
        iteratedDeriv n (⇑(a • f)) x = a * iteratedDeriv n f x := by
      intro n a f x
      have h_coe : (⇑(a • f) : ℝ → ℝ) = a • ⇑f := rfl
      rw [h_coe, iteratedDeriv_const_smul ((f.smooth n).contDiffAt) a, smul_eq_mul]
    have h_iter_trans : ∀ (n : ℕ) (a : ℝ) (f : 𝓢(ℝ, ℝ)) (x : ℝ),
        iteratedDeriv n (⇑(regTranslate a f)) x = iteratedDeriv n f (x + a) := by
      intro n a f x
      change iteratedDeriv n (fun y : ℝ => f (y + a)) x = iteratedDeriv n f (x + a)
      exact congr_fun (iteratedDeriv_comp_add_const n (⇑f) a) x
    have h_pt_shift : ∀ (k m : ℕ) (f : 𝓢(ℝ, ℝ)) (τ x : ℝ),
        |τ| ≤ 1 →
        |x| ^ k * ‖iteratedDeriv m f (x + τ)‖ ≤
          ∑ j ∈ Finset.range (k + 1), (Nat.choose k j : ℝ) * SchwartzMap.seminorm ℝ j m f := by
      intro k m f τ x hτ
      have hx_le : |x| ≤ |x + τ| + 1 := by
        have h1 : |x| = |(x + τ) - τ| := by ring_nf
        have h2 : |(x + τ) - τ| ≤ |x + τ| + |τ| := abs_sub (x + τ) τ
        linarith
      have h_pow : |x| ^ k ≤ (|x + τ| + 1) ^ k :=
        pow_le_pow_left₀ (abs_nonneg x) hx_le k
      have h_binom : (|x + τ| + 1) ^ k =
          ∑ j ∈ Finset.range (k + 1), (Nat.choose k j : ℝ) * |x + τ| ^ j := by
        rw [add_pow]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        ring
      rw [h_binom] at h_pow
      calc |x| ^ k * ‖iteratedDeriv m f (x + τ)‖
        _ ≤ (∑ j ∈ Finset.range (k + 1), (Nat.choose k j : ℝ) * |x + τ| ^ j) *
              ‖iteratedDeriv m f (x + τ)‖ :=
            mul_le_mul_of_nonneg_right h_pow (norm_nonneg _)
        _ = ∑ j ∈ Finset.range (k + 1),
              (Nat.choose k j : ℝ) * (|x + τ| ^ j * ‖iteratedDeriv m f (x + τ)‖) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun j _ => ?_)
            ring
        _ ≤ ∑ j ∈ Finset.range (k + 1), (Nat.choose k j : ℝ) * SchwartzMap.seminorm ℝ j m f := by
            refine Finset.sum_le_sum (fun j _ => ?_)
            exact mul_le_mul_of_nonneg_left
              (SchwartzMap.le_seminorm' ℝ j m f (x + τ)) (Nat.cast_nonneg _)
    have h_sum_nonneg : ∀ (k m : ℕ) (f : 𝓢(ℝ, ℝ)),
        0 ≤ ∑ j ∈ Finset.range (k + 1), (Nat.choose k j : ℝ) * SchwartzMap.seminorm ℝ j m f := by
      intro k m f
      refine Finset.sum_nonneg (fun j _ => ?_)
      exact mul_nonneg (Nat.cast_nonneg _) (apply_nonneg (SchwartzMap.seminorm ℝ j m) f)
    have h_uIcc_abs : ∀ (a τ : ℝ), τ ∈ Set.uIcc 0 a → |τ| ≤ |a| := by
      intro a τ hτ
      rcases Set.mem_uIcc.mp hτ with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · rw [abs_of_nonneg h1, abs_of_nonneg (le_trans h1 h2)]
        exact h2
      · rw [abs_of_nonpos h2, abs_of_nonpos (le_trans h1 h2)]
        exact neg_le_neg h1
    have h_deriv_iter : ∀ (m : ℕ) (f : 𝓢(ℝ, ℝ)) (x τ : ℝ),
        HasDerivAt (fun t : ℝ => iteratedDeriv m f (x + t)) (iteratedDeriv (m + 1) f (x + τ)) τ := by
      intro m f x τ
      have h_diff : DifferentiableAt ℝ (iteratedDeriv m f) (x + τ) :=
        ((f.smooth (m + 1)).differentiable_iteratedDeriv m (by norm_cast; omega)).differentiableAt
      have hd := h_diff.hasDerivAt
      rw [← iteratedDeriv_succ] at hd
      have h_add : HasDerivAt (fun t : ℝ => x + t) 1 τ := by
        simpa using (hasDerivAt_id τ).const_add x
      simpa using hd.comp τ h_add
    have h_pt_sub : ∀ (k m : ℕ) (f : 𝓢(ℝ, ℝ)) (a x : ℝ),
        |a| ≤ 1 →
        |x| ^ k * ‖iteratedDeriv m f (x + a) - iteratedDeriv m f x‖ ≤
          |a| * ∑ j ∈ Finset.range (k + 1), (Nat.choose k j : ℝ) * SchwartzMap.seminorm ℝ j (m + 1) f := by
      intro k m f a x ha
      let C := ∑ j ∈ Finset.range (k + 1), (Nat.choose k j : ℝ) * SchwartzMap.seminorm ℝ j (m + 1) f
      let ψ : ℝ → ℝ := fun τ => |x| ^ k * iteratedDeriv m f (x + τ)
      let ψ' : ℝ → ℝ := fun τ => |x| ^ k * iteratedDeriv (m + 1) f (x + τ)
      have h_hasDeriv : ∀ τ ∈ Set.uIcc 0 a, HasDerivWithinAt ψ (ψ' τ) (Set.uIcc 0 a) τ := by
        intro τ _
        exact ((h_deriv_iter m f x τ).const_mul (|x| ^ k)).hasDerivWithinAt
      have h_bound : ∀ τ ∈ Set.uIcc 0 a, ‖ψ' τ‖ ≤ C := by
        intro τ hτ
        have hτ_le1 : |τ| ≤ 1 := le_trans (h_uIcc_abs a τ hτ) ha
        change ‖|x| ^ k * iteratedDeriv (m + 1) f (x + τ)‖ ≤ C
        rw [norm_mul, Real.norm_of_nonneg (pow_nonneg (abs_nonneg x) k)]
        exact h_pt_shift k (m + 1) f τ x hτ_le1
      have h_mvt := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
        h_hasDeriv h_bound (convex_uIcc 0 a) Set.left_mem_uIcc Set.right_mem_uIcc
      have h_lhs : ‖ψ a - ψ 0‖ = |x| ^ k * ‖iteratedDeriv m f (x + a) - iteratedDeriv m f x‖ := by
        change ‖|x| ^ k * iteratedDeriv m f (x + a) - |x| ^ k * iteratedDeriv m f (x + 0)‖ = _
        rw [add_zero, ← mul_sub, norm_mul, Real.norm_of_nonneg (pow_nonneg (abs_nonneg x) k)]
      have h_rhs : C * ‖a - 0‖ = |a| * C := by
        rw [sub_zero, Real.norm_eq_abs, mul_comm]
      linarith
    have h_sem_trans : ∀ (k n : ℕ) (f : 𝓢(ℝ, ℝ)) (a : ℝ),
        |a| ≤ 1 →
        SchwartzMap.seminorm ℝ k n (regTranslate a f) ≤
          ∑ j ∈ Finset.range (k + 1), (Nat.choose k j : ℝ) * SchwartzMap.seminorm ℝ j n f := by
      intro k n f a ha
      refine SchwartzMap.seminorm_le_bound' ℝ k n (regTranslate a f) (h_sum_nonneg k n f) (fun x => ?_)
      rw [h_iter_trans n a f x]
      exact h_pt_shift k n f a x ha
    have h_sem_sub : ∀ (k n : ℕ) (f : 𝓢(ℝ, ℝ)) (a : ℝ),
        |a| ≤ 1 →
        SchwartzMap.seminorm ℝ k n (regTranslate a f - f) ≤
          |a| * ∑ j ∈ Finset.range (k + 1), (Nat.choose k j : ℝ) * SchwartzMap.seminorm ℝ j (n + 1) f := by
      intro k n f a ha
      have hM_nn : 0 ≤ |a| * ∑ j ∈ Finset.range (k + 1), (Nat.choose k j : ℝ) * SchwartzMap.seminorm ℝ j (n + 1) f :=
        mul_nonneg (abs_nonneg a) (h_sum_nonneg k (n + 1) f)
      refine SchwartzMap.seminorm_le_bound' ℝ k n (regTranslate a f - f) hM_nn (fun x => ?_)
      rw [h_iter_sub n (regTranslate a f) f x, h_iter_trans n a f x]
      exact h_pt_sub k n f a x ha
    have h_sem_taylor : ∀ (k n : ℕ) (f : 𝓢(ℝ, ℝ)) (a : ℝ),
        |a| ≤ 1 →
        SchwartzMap.seminorm ℝ k n (regTranslate a f - f - a • SchwartzMap.derivCLM ℝ ℝ f) ≤
          |a| ^ 2 * ∑ j ∈ Finset.range (k + 1), (Nat.choose k j : ℝ) * SchwartzMap.seminorm ℝ j (n + 2) f := by
      intro k n f a ha
      let C := ∑ j ∈ Finset.range (k + 1), (Nat.choose k j : ℝ) * SchwartzMap.seminorm ℝ j (n + 2) f
      have hC_nn : 0 ≤ C := h_sum_nonneg k (n + 2) f
      have hM_nn : 0 ≤ |a| ^ 2 * C := mul_nonneg (sq_nonneg |a|) hC_nn
      refine SchwartzMap.seminorm_le_bound' ℝ k n
        (regTranslate a f - f - a • SchwartzMap.derivCLM ℝ ℝ f) hM_nn (fun x => ?_)
      rw [h_iter_sub n (regTranslate a f - f) (a • SchwartzMap.derivCLM ℝ ℝ f) x,
          h_iter_sub n (regTranslate a f) f x,
          h_iter_trans n a f x,
          h_iter_smul n a (SchwartzMap.derivCLM ℝ ℝ f) x,
          h_iter_derivCLM n f x]
      let Φ : ℝ → ℝ := fun τ =>
        |x| ^ k * (iteratedDeriv n f (x + τ) - iteratedDeriv n f x - τ * iteratedDeriv (n + 1) f x)
      let Φ' : ℝ → ℝ := fun τ =>
        |x| ^ k * (iteratedDeriv (n + 1) f (x + τ) - iteratedDeriv (n + 1) f x)
      have h_hasDeriv : ∀ τ ∈ Set.uIcc 0 a, HasDerivWithinAt Φ (Φ' τ) (Set.uIcc 0 a) τ := by
        intro τ _
        have hd1 := (h_deriv_iter n f x τ).sub (hasDerivAt_const τ (iteratedDeriv n f x))
        have hd2 : HasDerivAt (fun t : ℝ => t * iteratedDeriv (n + 1) f x) (iteratedDeriv (n + 1) f x) τ := by
          simpa using (hasDerivAt_id τ).mul_const (iteratedDeriv (n + 1) f x)
        have hd3 := (hd1.sub hd2).const_mul (|x| ^ k)
        rw [sub_zero] at hd3
