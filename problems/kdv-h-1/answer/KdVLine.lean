    · rw [h_eq]; exact hf_h1.const_mul (c ^ 2)
    · dsimp [h1NormSq]; rw [h_eq, integral_const_mul]
  have h_add : ∀ (f g : ℝ → ℝ), Integrable f → Integrable g →
      Integrable (fun ξ : ℝ => (4 + ξ ^ 2) * ‖fourierLine f ξ‖ ^ 2) →
      Integrable (fun ξ : ℝ => (4 + ξ ^ 2) * ‖fourierLine g ξ‖ ^ 2) →
      Integrable (fun x : ℝ => f x + g x) ∧
      Integrable (fun ξ : ℝ => (4 + ξ ^ 2) * ‖fourierLine (fun x => f x + g x) ξ‖ ^ 2) ∧
      h1NormSq (fun x : ℝ => f x + g x) ≤ 2 * h1NormSq f + 2 * h1NormSq g ∧
      (1 / 2) * h1NormSq f - h1NormSq g ≤ h1NormSq (fun x : ℝ => f x + g x) := by
    intro f g hf hg hf_h1 hg_h1
    have hfg : Integrable (fun x : ℝ => f x + g x) := hf.add hg
    have h_cont : Continuous (fun ξ : ℝ => (4 + ξ ^ 2) * ‖fourierLine (fun x => f x + g x) ξ‖ ^ 2) := by
      have h_fl : Continuous (fourierLine (fun x => f x + g x)) := h_fl_cont _ hfg
      fun_prop
    have h_pw_upper : ∀ ξ : ℝ, (4 + ξ ^ 2) * ‖fourierLine (fun x => f x + g x) ξ‖ ^ 2 ≤
        2 * ((4 + ξ ^ 2) * ‖fourierLine f ξ‖ ^ 2) + 2 * ((4 + ξ ^ 2) * ‖fourierLine g ξ‖ ^ 2) := by
      intro ξ
      rw [h_fl_add f g hf hg ξ]
      have h_tri : ‖fourierLine f ξ + fourierLine g ξ‖ ≤ ‖fourierLine f ξ‖ + ‖fourierLine g ξ‖ :=
        norm_add_le _ _
      have h_sq1 : ‖fourierLine f ξ + fourierLine g ξ‖ ^ 2 ≤ (‖fourierLine f ξ‖ + ‖fourierLine g ξ‖) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) h_tri 2
      have h_sq2 : (‖fourierLine f ξ‖ + ‖fourierLine g ξ‖) ^ 2 ≤
          2 * ‖fourierLine f ξ‖ ^ 2 + 2 * ‖fourierLine g ξ‖ ^ 2 := by
        nlinarith [sq_nonneg (‖fourierLine f ξ‖ - ‖fourierLine g ξ‖)]
      nlinarith [sq_nonneg ξ]
    have h_pw_lower : ∀ ξ : ℝ,
        (1 / 2) * ((4 + ξ ^ 2) * ‖fourierLine f ξ‖ ^ 2) - (4 + ξ ^ 2) * ‖fourierLine g ξ‖ ^ 2 ≤
        (4 + ξ ^ 2) * ‖fourierLine (fun x => f x + g x) ξ‖ ^ 2 := by
      intro ξ
      rw [h_fl_add f g hf hg ξ]
      have h_tri : ‖fourierLine f ξ‖ ≤ ‖fourierLine f ξ + fourierLine g ξ‖ + ‖fourierLine g ξ‖ :=
        norm_le_add_norm_add _ _
      have h_sq1 : ‖fourierLine f ξ‖ ^ 2 ≤ (‖fourierLine f ξ + fourierLine g ξ‖ + ‖fourierLine g ξ‖) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) h_tri 2
      have h_sq2 : (‖fourierLine f ξ + fourierLine g ξ‖ + ‖fourierLine g ξ‖) ^ 2 ≤
          2 * ‖fourierLine f ξ + fourierLine g ξ‖ ^ 2 + 2 * ‖fourierLine g ξ‖ ^ 2 := by
        nlinarith [sq_nonneg (‖fourierLine f ξ + fourierLine g ξ‖ - ‖fourierLine g ξ‖)]
      nlinarith [sq_nonneg ξ]
    have h_dom_int : Integrable (fun ξ : ℝ =>
        2 * ((4 + ξ ^ 2) * ‖fourierLine f ξ‖ ^ 2) + 2 * ((4 + ξ ^ 2) * ‖fourierLine g ξ‖ ^ 2)) :=
      (hf_h1.const_mul 2).add (hg_h1.const_mul 2)
    have hfg_h1 : Integrable (fun ξ : ℝ => (4 + ξ ^ 2) * ‖fourierLine (fun x => f x + g x) ξ‖ ^ 2) := by
      refine h_dom_int.mono' h_cont.aestronglyMeasurable (Filter.Eventually.of_forall fun ξ => ?_)
      rw [Real.norm_of_nonneg (by positivity)]
      exact h_pw_upper ξ
    refine ⟨hfg, hfg_h1, ?_, ?_⟩
    · calc h1NormSq (fun x => f x + g x)
        _ ≤ ∫ ξ : ℝ, (2 * ((4 + ξ ^ 2) * ‖fourierLine f ξ‖ ^ 2) + 2 * ((4 + ξ ^ 2) * ‖fourierLine g ξ‖ ^ 2)) :=
          integral_mono hfg_h1 h_dom_int h_pw_upper
        _ = 2 * h1NormSq f + 2 * h1NormSq g := by
          rw [integral_add (hf_h1.const_mul 2) (hg_h1.const_mul 2), integral_const_mul, integral_const_mul]
          rfl
    · have h_low_int : Integrable (fun ξ : ℝ =>
          (1 / 2) * ((4 + ξ ^ 2) * ‖fourierLine f ξ‖ ^ 2) - (4 + ξ ^ 2) * ‖fourierLine g ξ‖ ^ 2) :=
        (hf_h1.const_mul (1 / 2)).sub hg_h1
      calc (1 / 2) * h1NormSq f - h1NormSq g
        _ = ∫ ξ : ℝ, ((1 / 2) * ((4 + ξ ^ 2) * ‖fourierLine f ξ‖ ^ 2) - (4 + ξ ^ 2) * ‖fourierLine g ξ‖ ^ 2) := by
          dsimp [h1NormSq]
          rw [integral_sub (hf_h1.const_mul (1 / 2)) hg_h1, integral_const_mul]
        _ ≤ h1NormSq (fun x => f x + g x) :=
          integral_mono h_low_int hfg_h1 h_pw_lower
  have h_single : ∀ (w : 𝓢(ℝ, ℝ)), ‖ι w‖ ≤ 1 / 256 →
      Continuous (fun x : ℝ => diagGreen 1 w x - 1 / 2) ∧
      (∀ x : ℝ, |diagGreen 1 w x - 1 / 2| ≤ ‖ι w‖) ∧
      Integrable (fun x : ℝ => diagGreen 1 w x - 1 / 2) ∧
      Integrable (fun ξ : ℝ => (4 + ξ ^ 2) * ‖fourierLine (fun x => diagGreen 1 w x - 1 / 2) ξ‖ ^ 2) ∧
      h1NormSq (fun x : ℝ => diagGreen 1 w x - 1 / 2) ≤ 4 * ‖ι w‖ ^ 2 ∧
      Continuous (recipGreenDiff w) ∧
      Integrable (recipGreenDiff w) ∧
      Integrable (fun ξ : ℝ => (4 + ξ ^ 2) * ‖fourierLine (recipGreenDiff w) ξ‖ ^ 2) ∧
      h1NormSq (recipGreenDiff w) ≤ 64 * ‖ι w‖ ^ 2 := by
    intro w hw
    obtain ⟨h_h1_cont, h_h1_int, h_h1_h1int, h_h1_norm, _, _, _, _⟩ :=
      greenIterKernel_one_first_h1_isometry w w
    obtain ⟨h_all_ℓ, h_all_m⟩ :=
      greenIterKernel_one_higher_diff_bounds (1 / 256) (by norm_num) w w hw hw
    obtain ⟨h_r2_cont, h_r2_bd, h_r2_int, h_r2_h1int, h_r2_norm, _, _, _, _⟩ :=
      diagGreen_one_tail_diff_h1_bounds w w hw hw h_all_ℓ h_all_ℓ h_all_m
    have h_g_eq : (fun x : ℝ => diagGreen 1 w x - 1 / 2) =
        (fun x : ℝ => greenIterKernel 1 w 1 x x + (diagGreen 1 w x - 1 / 2 - greenIterKernel 1 w 1 x x)) := by
      ext x; ring
    have h_g_cont : Continuous (fun x : ℝ => diagGreen 1 w x - 1 / 2) := by
      rw [h_g_eq]; exact h_h1_cont.add h_r2_cont
    have h_g_bd : ∀ x : ℝ, |diagGreen 1 w x - 1 / 2| ≤ ‖ι w‖ := by
      intro x
      have h_split : diagGreen 1 w x - 1 / 2 =
          greenIterKernel 1 w 1 x x + (diagGreen 1 w x - 1 / 2 - greenIterKernel 1 w 1 x x) := by ring
      have h_tri := abs_add_le (greenIterKernel 1 w 1 x x) (diagGreen 1 w x - 1 / 2 - greenIterKernel 1 w 1 x x)
      rw [← h_split] at h_tri
      have h_b1 := (h_all_ℓ 1).2 x
      rw [pow_one] at h_b1
      have h_b2 := h_r2_bd x
      linarith
    obtain ⟨h_g_int, h_g_h1int, h_g_norm_le, _⟩ :=
      h_add (fun x => greenIterKernel 1 w 1 x x)
        (fun x => diagGreen 1 w x - 1 / 2 - greenIterKernel 1 w 1 x x)
        h_h1_int h_r2_int h_h1_h1int h_r2_h1int
    rw [← h_g_eq] at h_g_int h_g_h1int h_g_norm_le
    have h_g_norm : h1NormSq (fun x : ℝ => diagGreen 1 w x - 1 / 2) ≤ 4 * ‖ι w‖ ^ 2 := by
      linarith [h_g_norm_le, h_h1_norm, h_r2_norm]
    obtain ⟨h_psi_cont, h_psi_int, h_psi_h1int, h_psi_norm⟩ :=
