        h_hasDeriv h_bound (convex_uIcc s₀ s) Set.left_mem_uIcc Set.right_mem_uIcc
      have h_lhs : ‖ψ s - ψ s₀‖ =
          |x| ^ k * |iteratedDeriv n (u s) x - iteratedDeriv n (u s₀) x - (s - s₀) * iteratedDeriv n v₁ x| := by
        change ‖|x| ^ k * (iteratedDeriv n (u s) x - (s - s₀) * iteratedDeriv n v₁ x) -
          |x| ^ k * (iteratedDeriv n (u s₀) x - (s₀ - s₀) * iteratedDeriv n v₁ x)‖ = _
        rw [sub_self, zero_mul, sub_zero, ← mul_sub, norm_mul,
            Real.norm_of_nonneg (pow_nonneg (abs_nonneg x) k), Real.norm_eq_abs]
        congr 2
        ring
