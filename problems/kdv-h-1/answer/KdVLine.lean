    exact ⟨h_g_cont, h_g_bd, h_g_int, h_g_h1int, h_g_norm,
      h_psi_cont, h_psi_int, h_psi_h1int, h_psi_norm⟩
  refine ⟨1 / 256, by norm_num, ?_, ?_⟩
  · intro w hw
    obtain ⟨_, _, _, _, _, _, h_psi_int, h_psi_h1int, _⟩ := h_single w hw
    exact ⟨h_psi_int, h_psi_h1int⟩
  · intro w₁ w₂ hw₁ hw₂
    obtain ⟨h_g1_cont, h_g1_bd, h_g1_int, h_g1_h1int, h_g1_norm,
