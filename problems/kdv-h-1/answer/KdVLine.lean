        (fun ξ : ℝ =>
          ‖iterWavePacket κ w ℓ x ξ *
            Complex.exp (((ξ : ℂ) * (x : ℂ)) * I) / ((κ ^ 2 + ξ ^ 2 : ℝ) : ℂ)‖) =
        (fun ξ : ℝ => ‖iterWavePacket κ w ℓ x ξ‖ / (κ ^ 2 + ξ ^ 2)) := by
      ext ξ
      rw [norm_div, norm_mul,
          show ((ξ : ℂ) * (x : ℂ)) * I = (((ξ * x : ℝ) : ℂ) * I) by push_cast; ring,
          Complex.norm_exp_ofReal_mul_I, mul_one,
          Complex.norm_of_nonneg (le_of_lt (h_denom_pos ξ))]
    calc |greenIterKernel κ w ℓ x x|
