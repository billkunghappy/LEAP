      linarith [h_prod_norm_le]
    have h_Q_norm : h1NormSq Q ≤ 1 / 72 := by
      linarith [h_Q_norm_le, h_psi12_norm_le, h_nprod_norm_eq, h_psi1_le, h_psi2_le, h_prod_le]
    
    have h_ΔR₂_eq : ΔR₂ = (fun x : ℝ => U x * Q x) := by
      ext x
      have h_U_simp : U x = -2 * ((diagGreen 1 w₁ x - 1 / 2) - (diagGreen 1 w₂ x - 1 / 2)) := by
