      have hb2 : |diagGreen 1 w₂ x - 1 / 2| ≤ 1 / 256 := le_trans (h_g2_bd x) hw₂
      have hg1_pos : 0 < diagGreen 1 w₁ x := by linarith [(abs_le.mp hb1).1]
      have hg2_pos : 0 < diagGreen 1 w₂ x := by linarith [(abs_le.mp hb2).1]
      have hg1_ne : diagGreen 1 w₁ x ≠ 0 := ne_of_gt hg1_pos
      have hg2_ne : diagGreen 1 w₂ x ≠ 0 := ne_of_gt hg2_pos
      field_simp
      ring
    obtain ⟨_, h_UQ_int, h_UQ_h1int, h_UQ_norm_le⟩ :=
      h1NormSq_mul_submultiplicative U Q h_U_cont h_Q_cont h_U_int h_Q_int h_U_h1int h_Q_h1int
    have h_ΔR₂_int : Integrable ΔR₂ := by rw [h_ΔR₂_eq]; exact h_UQ_int
    have h_ΔR₂_h1int : Integrable (fun ξ : ℝ => (4 + ξ ^ 2) * ‖fourierLine ΔR₂ ξ‖ ^ 2) := by
      rw [h_ΔR₂_eq]; exact h_UQ_h1int
    have h_U_nn : 0 ≤ h1NormSq U := integral_nonneg (fun ξ => by positivity)
    have h_Q_nn : 0 ≤ h1NormSq Q := integral_nonneg (fun ξ => by positivity)
    have h_ΔR₂_norm : h1NormSq ΔR₂ ≤ (1 / 8) * ‖ι w₁ - ι w₂‖ ^ 2 := by
      rw [h_ΔR₂_eq]
      have h_mul_le : h1NormSq U * h1NormSq Q ≤ (9 * ‖ι w₁ - ι w₂‖ ^ 2) * (1 / 72) :=
        mul_le_mul h_U_norm h_Q_norm h_Q_nn (by positivity)
      linarith [h_UQ_norm_le]
    
    set ΔR : ℝ → ℝ := fun x => ΔR₁ x + ΔR₂ x
    obtain ⟨h_ΔR_int, h_ΔR_h1int, h_ΔR_norm_le, _⟩ :=
      h_add ΔR₁ ΔR₂ h_ΔR₁_int h_ΔR₂_int h_ΔR₁_h1int h_ΔR₂_h1int
