theorem bBe_RSym : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 0 → k % 2 = 0 → b < y - k → b % 2 = 0 →
    y ≤ c → c < 2 * y → c % 2 = 0 →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧
      TopEndInv y (a₀ + b + c + 1) p :=
by
  intro y k b c hk hyk hy hk2 hb hb2 hc1 hc2 hc
  have adj_symm : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h | h⟩
    · exact ⟨l₁, l₂, Or.inr h⟩
    · exact ⟨l₁, l₂, Or.inl h⟩
  have adj_cast : ∀ (p : List ℕ) (u w u' w' : ℕ), u = u' → w = w' → Adj p u w → Adj p u' w' := by
    rintro p u w u' w' rfl rfl h
    exact h
  obtain ⟨t, rfl⟩ : ∃ t, b = 2 * t := ⟨b / 2, by omega⟩
  obtain ⟨s, rfl⟩ : ∃ s, c = y + 2 * s := ⟨(c - y) / 2, by omega⟩
  obtain ⟨hQ, hQs, hQ0, hQe⟩ := path_range y (by omega)
  
  obtain ⟨p₁, hp₁, hC1, hK1, hE1⟩ := bot_pairs y y s _ _ (by omega) le_rfl (by omega) hQ
    (fun i hi => adj_cast _ _ _ _ _ rfl (by omega) (hQs (y - 2 - 2 * i) (by omega)))
  have P1odd : ∀ x : ℕ, x % 2 = 1 → x + 2 ≤ y → Adj p₁ (x + 2 * s) (x + 2 * s + 1) :=
    fun x hx1 hx2 => hK1 x (hQs x hx2) (fun i hi => by omega)
  have P1even : ∀ x : ℕ, x + 2 * s + 2 ≤ y → Adj p₁ (x + 2 * s) (x + 2 * s + 1) :=
    fun x hx => hK1 x (hQs x (by omega)) (fun i hi => by omega)
  
  obtain ⟨p₂, hp₂, -, hK2, hE2⟩ := bot_pairs (y - k) (y + 2 * s) t _ p₁ (by omega) (by omega)
    (by omega) hp₁ (fun i hi => by
      by_cases hz : y - k - 2 - 2 * i < 2 * s
      · have h := hC1 ((y - k - 2 - 2 * i) / 2) (by omega)
        exact adj_cast _ _ _ _ _ (by omega) (by omega) h
      · have h := P1even (y - k - 2 - 2 * i - 2 * s) (by omega)
        exact adj_cast _ _ _ _ _ (by omega) (by omega) h)
  have P2odd : ∀ x : ℕ, x % 2 = 1 → x + 2 ≤ y →
      Adj p₂ (x + 2 * s + 2 * t) (x + 2 * s + 2 * t + 1) :=
    fun x hx1 hx2 => hK2 _ (P1odd x hx1 hx2) (fun i hi => by omega)
  
  have hTE : TopEndInv y (y + 2 * s + 2 * t) p₂ := by
    refine ⟨?_, ?_, ?_⟩
    · have h := hE2 _ (hE1 _ hQe)
      rw [show y - 1 + 2 * s + 2 * t = y + 2 * s + 2 * t - 1 by omega] at h
      exact h
    · intro j hj1 hj2
      have h := P2odd (y - 1 - 2 * j) (by omega) (by omega)
      exact adj_symm _ _ _ (adj_cast _ _ _ _ _ (by omega) (by omega) h)
    · intro _
      have h := hE2 _ (hE1 _ hQ0)
      rw [show 0 + 2 * s + 2 * t = y + 2 * s + 2 * t - y by omega] at h
      exact h
  
  obtain ⟨p, hp, hTEp, -, -⟩ :=
    grow_top_end_iter y (y + 2 * s + 2 * t) 1 _ p₂ (by omega) (by omega) hp₂ hTE
  have hV : y - 1 + 2 * t + (y + 2 * s) + 1 = y + 2 * s + 2 * t + 1 * y := by omega
  refine ⟨y - 1, by omega, p, ?_, ?_⟩
  · rw [hV]
    refine ⟨hp.1, ?_⟩
    rw [hp.2]
    unfold prescribedLengths
    rw [one_mul, Multiset.replicate_add y (2 * s) y]
    abel
  · rw [hV]
    exact hTEp

theorem base_B_even : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 0 → b < y - k → y ≤ c → c < 2 * y → ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ (TopEndInv y (a₀ + b + c + 1) p ∨ TopPairInv y (a₀ + b + c + 1) p) ∧ (IsEnd p 0 ∨ TopEndInv y (a₀ + b + c + 1) p) :=
by
  intro y k b c hk hyk hy hb hc1 hc2
  have h2y : 2 ≤ y := by omega
  have adj_symm : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h | h⟩
    · exact ⟨l₁, l₂, Or.inr h⟩
    · exact ⟨l₁, l₂, Or.inl h⟩
  have adj_cast : ∀ (p : List ℕ) (u w u' w' : ℕ), u = u' → w = w' → Adj p u w → Adj p u' w' := by
    rintro p u w u' w' rfl rfl h
    exact h
  
  have liftT : ∀ (a₀ c₀ : ℕ) (q : List ℕ), y ≤ a₀ + b + c₀ + 1 →
      IsLinearRealization (a₀ + b + c₀ + 1) (prescribedLengths y k a₀ b c₀) q →
      TopPairInv y (a₀ + b + c₀ + 1) q → IsEnd q 0 → ∀ t : ℕ,
      ∃ p : List ℕ, IsLinearRealization (a₀ + b + (c₀ + 2 * t) + 1)
          (prescribedLengths y k a₀ b (c₀ + 2 * t)) p ∧
        TopPairInv y (a₀ + b + (c₀ + 2 * t) + 1) p ∧ IsEnd p 0 := by
    intro a₀ c₀ q hv hq hTPq hEq t
    induction t with
    | zero => exact ⟨q, by simpa using hq, by simpa using hTPq, hEq⟩
    | succ t ih =>
      obtain ⟨p, hp, hTP, hE⟩ := ih
      have hslot : ∀ i : ℕ, i < 1 →
          Adj p (a₀ + b + (c₀ + 2 * t) + 1 - y + 2 * i)
            (a₀ + b + (c₀ + 2 * t) + 1 - y + 2 * i + 1) := by
        intro i hi
        have h := hTP.2 (y / 2 - 1) (by omega)
        exact adj_symm _ _ _ (adj_cast _ _ _ _ _ (by omega) (by omega) h)
      obtain ⟨p', hp', hnew, hkeep, hend⟩ :=
        top_pairs y (a₀ + b + (c₀ + 2 * t) + 1) 1 _ p h2y (by omega) (by omega) hp hslot
      have ev : a₀ + b + (c₀ + 2 * t) + 1 + 2 * 1 = a₀ + b + (c₀ + 2 * (t + 1)) + 1 := by omega
      have eL : prescribedLengths y k a₀ b (c₀ + 2 * t) + Multiset.replicate (2 * 1) y =
          prescribedLengths y k a₀ b (c₀ + 2 * (t + 1)) := by
        unfold prescribedLengths
        rw [show c₀ + 2 * (t + 1) = (c₀ + 2 * t) + 2 * 1 by omega,
          Multiset.replicate_add (c₀ + 2 * t) (2 * 1) y]
        abel
      rw [ev, eL] at hp'
      refine ⟨p', hp', ⟨hTP.1, ?_⟩, hend 0 hE⟩
      intro j hj
      rcases Nat.eq_zero_or_pos j with rfl | hjpos
      · have h := hnew 0 (by omega)
        exact adj_symm _ _ _ (adj_cast _ _ _ _ _ (by omega) (by omega) h)
      · have h := hTP.2 (j - 1) (by omega)
        have h1 : Adj p (a₀ + b + (c₀ + 2 * t) + 1 - 2 * j)
            (a₀ + b + (c₀ + 2 * t) + 1 - 2 * j + 1) :=
          adj_symm _ _ _ (adj_cast _ _ _ _ _ (by omega) (by omega) h)
        have h2 := hkeep _ h1 (fun i hi => by omega)
        exact adj_symm _ _ _ (adj_cast _ _ _ _ _ (by omega) (by omega) h2)
  have finishPair : ∀ (a₀ c₀ : ℕ) (q : List ℕ), a₀ ≤ y → c₀ ≤ c → c % 2 = c₀ % 2 →
      y ≤ a₀ + b + c₀ + 1 →
      IsLinearRealization (a₀ + b + c₀ + 1) (prescribedLengths y k a₀ b c₀) q →
      TopPairInv y (a₀ + b + c₀ + 1) q → IsEnd q 0 →
      ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ (TopEndInv y (a₀ + b + c + 1) p ∨ TopPairInv y (a₀ + b + c + 1) p) ∧ (IsEnd p 0 ∨ TopEndInv y (a₀ + b + c + 1) p) := by
    intro a₀ c₀ q ha₀ hc₀ hpar hv hq hTPq hEq
    obtain ⟨t, ht⟩ : ∃ t, c = c₀ + 2 * t := ⟨(c - c₀) / 2, by omega⟩
    obtain ⟨p, hp, hTP, hE⟩ := liftT a₀ c₀ q hv hq hTPq hEq t
    rw [← ht] at hp hTP
    exact ⟨a₀, ha₀, p, hp, Or.inr hTP, Or.inl hE⟩
  rcases Nat.mod_two_eq_zero_or_one b with hb2 | hb2 <;>
    rcases Nat.mod_two_eq_zero_or_one c with hcc | hcc <;>
    rcases Nat.mod_two_eq_zero_or_one k with hk2 | hk2
  · 
    obtain ⟨a₀, ha₀, p, hp, hTE⟩ := bBe_RSym y k b c hk hyk hy hk2 hb hb2 hc1 hc2 hcc
    exact ⟨a₀, ha₀, p, hp, Or.inl hTE, Or.inr hTE⟩
  · 
    obtain ⟨a₀, ha₀, hv, q, hq, hTP, hE⟩ := bBe_E1 y k b hk hyk hy hb hk2 hb2
    exact finishPair a₀ 0 q ha₀ (by omega) (by omega) hv hq hTP hE
