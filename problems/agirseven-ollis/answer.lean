theorem baseB_okE_EO_U : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 0 → b < y - k → c < y → b % 2 = 0 → c % 2 = 1 → 4 ≤ k → c + 2 * k ≤ y + 2 → y + 4 ≤ b + c + k → (k = 4 → b + c = y → c ≤ 5) → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ BotEndInv y p :=
by
  have adjeq : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have endeq : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x x' h rfl
    exact h
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 hk4 h6 hbig _
  obtain ⟨w, hw⟩ : ∃ w, 2 * w + 1 = y := ⟨y / 2, by omega⟩
  obtain ⟨t1, ht1⟩ : ∃ t, 2 * t = c - 1 := ⟨c / 2, by omega⟩
  obtain ⟨t2, ht2⟩ : ∃ t, 2 * t = y - k - c := ⟨(y - k - c) / 2, by omega⟩
  
  have optA : ∀ (V : ℕ) (L : Multiset ℕ) (Q : List ℕ), y ≤ V → IsLinearRealization V L Q →
      IsEnd Q k → (∀ i : ℕ, 2 * i + 2 ≤ k → Adj Q (2 * i) (2 * i + 1)) →
      (∀ j : ℕ, 1 ≤ j → 2 * j + 1 ≤ y → Adj Q (2 * j - 1) (2 * j)) →
      ∃ p : List ℕ, IsLinearRealization (V + (y - k)) (L + Multiset.replicate (c - 1) y +
        Multiset.replicate (y - k - c) (y - k) + Multiset.replicate 1 y) p ∧ BotEndInv y p := by
    intro V L Q hyV hQ hend heven hodd
    
    obtain ⟨p1, hp1, hC1, hK1, hE1⟩ := bot_pairs y V t1 L Q (by omega) hyV (by omega) hQ
      (fun i hi => adjeq _ _ _ _ _ (hodd (w - i) (by omega) (by omega)) (by omega) (by omega))
    
    obtain ⟨p2, hp2, hC2, hK2, hE2⟩ := bot_pairs (y - k) (V + 2 * t1) t2 _ p1 (by omega)
      (by omega) (by omega) hp1
      (fun i hi => by
        have h0 := hodd (t2 - i) (by omega) (by omega)
        have h1 := hK1 (y - k - c - 1 - 2 * i) (adjeq _ _ _ _ _ h0 (by omega) (by omega))
          (fun i' hi' => by omega)
        exact adjeq _ _ _ _ _ h1 (by omega) (by omega))
    
    have hEnd2 : IsEnd p2 (y - 1) := endeq _ _ _ (hE2 _ (hE1 _ hend)) (by omega)
    obtain ⟨p3, hp3, h0, hK3, -⟩ := bot_attach y (V + 2 * t1 + 2 * t2) _ p2 (by omega)
      (by omega) hp2 hEnd2
    refine ⟨p3, ?_, h0, fun j hj1 hj2 => ?_, fun he => ?_⟩
    · rw [ht1, ht2, show V + (c - 1) + (y - k - c) + 1 = V + (y - k) by omega] at hp3
      exact hp3
    · have hA : Adj p2 (2 * j - 2) (2 * j - 2 + 1) := by
        by_cases e1 : 2 * j - 2 < 2 * t2
        · exact adjeq _ _ _ _ _ (hC2 (j - 1) (by omega)) (by omega) (by omega)
        · have hB : Adj p1 (2 * j - 2 - 2 * t2) (2 * j - 2 - 2 * t2 + 1) := by
            by_cases e2 : 2 * j - 2 - 2 * t2 < 2 * t1
            · exact adjeq _ _ _ _ _ (hC1 (j - 1 - t2) (by omega)) (by omega) (by omega)
            · have hQ0 := heven (j - 1 - t2 - t1) (by omega)
              have hQ1 := hK1 _ hQ0 (fun i hi => by omega)
              exact adjeq _ _ _ _ _ hQ1 (by omega) (by omega)
          have hB1 := hK2 _ hB (fun i hi => by omega)
          exact adjeq _ _ _ _ _ hB1 (by omega) (by omega)
      exact adjeq _ _ _ _ _ (hK3 _ hA) (by omega) (by omega)
    · rw [Nat.even_iff] at he
      omega
  
  have key : ∀ A d e c' : ℕ, Multiset.replicate A 1 + Multiset.replicate d (y - k) +
      Multiset.replicate c' y + Multiset.replicate e (y - k) + Multiset.replicate 1 y =
      Multiset.replicate A 1 + Multiset.replicate (d + e) (y - k) +
        Multiset.replicate (c' + 1) y := by
    intro A d e c'
    rw [Multiset.replicate_add, Multiset.replicate_add]
    abel
  by_cases hcor : b + 1 = y - k ∧ c + 2 * k = y + 2
  · 
    obtain ⟨Q, hQ, hQe, hQev, hQodd⟩ := baseB_okE_EO_U_theta y k hy hk2 hk4 (by omega)
    obtain ⟨p, hp, hBE⟩ := optA (2 * (y - k) + 2) _ Q (by omega) hQ hQe hQev hQodd
