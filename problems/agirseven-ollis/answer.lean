      simp only [List.mem_append, hm, true_or, or_true]
    by_cases c5 : x + 1 < 2 * k
    · have hm : x ∈ (List.range u).flatMap (fun i => bS2Unit y k (k - 2 * u - 1 + 2 * i)) :=
