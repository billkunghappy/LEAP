theorem okOE_X : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → b < y - k → c < y → b % 2 = 1 → c % 2 = 0 → 2 ≤ c → c + 1 ≤ k → b ≤ c + 1 → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ q : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) q ∧ BotEndInv y q :=
by
