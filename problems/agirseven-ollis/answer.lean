    have hadjI : ∀ i, i + 1 < y + 1 + 1 → Adj ((List.range (y + 1 + 1)).map f) (f i) (f (i + 1)) := by
      intro i hi
      obtain ⟨r, hr⟩ : ∃ r, y + 1 + 1 = i + 1 + 1 + r := ⟨y - i, by omega⟩
