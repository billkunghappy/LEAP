theorem baseB_okE_EO : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 0 → b < y - k → c < y → b % 2 = 0 → c % 2 = 1 → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ BotEndInv y p :=
by
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2
  
  by_cases h1 : c = 1
  · by_cases h2 : b ≤ k
    · exact baseB_okE_EO_O2 y k b c hk hyk hy hk2 hb hc hb2 hc2 h1 h2
    · exact baseB_okE_EO_O4 y k b c hk hyk hy hk2 hb hc hb2 hc2 h1 (by omega)
  
  by_cases h3 : b + c + k ≤ y + 2 ∨ b = 0
  · exact baseB_okE_EO_O1 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) h3
  have hbig : y + 4 ≤ b + c + k := by omega
  
  by_cases hk4 : k < 4
  · by_cases h5 : c + 4 ≤ y
    · exact baseB_okE_EO_OB y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) (by omega) h5
    · exact baseB_okE_EO_X45 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) (by omega)
  
  by_cases h6 : c + 2 * k ≤ y + 2
  · by_cases h7 : k = 4 ∧ b + c = y ∧ 7 ≤ c
    · obtain ⟨rfl, h8, h9⟩ := h7
      exact baseB_okE_EO_UL4 y b c (by omega) hy hb2 hc2 (by omega) h9 h8
    · exact baseB_okE_EO_U y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) h6 hbig
        (fun h h' => by omega)
  
  by_cases h10 : c + k ≤ y
  · exact baseB_okE_EO_X807 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) h10 (by omega)
  
  by_cases i1 : c + k + 1 ≤ y + b ∧ b + k ≤ c + 1
  · exact baseB_okE_EO_X0 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) i1.2 i1.1
  by_cases i2 : c + k + 3 ≤ y + b ∧ c + 3 ≤ y
  · exact baseB_okE_EO_X271 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) i2.1 i2.2
  by_cases i3 : c + 2 = y ∧ 4 ≤ b
