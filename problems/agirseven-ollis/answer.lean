    have h2 := hS₂ _ h1 (fun i hi => by omega)
    have h3 := hS₃ _ h2
    exact adj_symm _ _ _ (adj_cast _ _ _ _ _ (by omega) (by omega) h3)

theorem bBe_FCa : ∀ (y k b : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 0 → b < y - k → k % 2 = 0 → b % 2 = 0 →
