theorem bEE_DBY : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 0 → b < y - k → c < y → b % 2 = 0 → c % 2 = 0 → y - k + 1 ≤ c → c + 3 ≤ y → y ≤ b + c + 1 → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ BotEndInv y p :=
by
  
  have bot_ones : ∀ (r v : ℕ) (L : Multiset ℕ) (p : List ℕ), 1 ≤ v →
      IsLinearRealization v L p → IsEnd p 0 →
      ∃ p' : List ℕ, IsLinearRealization (v + r) (L + Multiset.replicate r 1) p' ∧ IsEnd p' 0 ∧
