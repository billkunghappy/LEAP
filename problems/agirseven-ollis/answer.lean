      have e : Int.natAbs (((a - 1 : ℕ) : ℤ) - ((a : ℕ) : ℤ)) = 1 := by omega
      rw [e, Multiset.replicate_succ]
  have unitB : ∀ (B n : ℕ) (L : List ℕ), L.head? = some (B + 2 * n + y) →
      edgeLengths ((List.range n).flatMap (fun i => bS2Unit y k (B + 2 * i)) ++ L) =
        Multiset.replicate (2 * n) 1 + Multiset.replicate (2 * n) (y - k) +
