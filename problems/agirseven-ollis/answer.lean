  have hB2 : ∀ j : ℕ, 1 ≤ j → 2 * j + 1 ≤ y → Adj q (2 * j - 1) (2 * j) := by
    intro j hj1 hj2
    have h := hodd (2 * j - 1) (by omega) (by omega)
    have h' := hkeep (2 * j - 1) h (fun i _ => by omega)
    rw [show 2 * j - 1 + 1 = 2 * j by omega] at h'
    exact h'
  obtain ⟨hp, hA, hEnd⟩ := reflect_realization (y + 4 * r + 4 + 2 * w) _ q hq
  have e1 : y - 1 + (2 * r + 3) + (2 * r + 1 + 2 * w) + 1 = y + 4 * r + 4 + 2 * w := by omega
  refine ⟨y - 1, by omega, by omega, q.map (fun x => y + 4 * r + 4 + 2 * w - 1 - x), ?_, ?_⟩
  · have e2 : prescribedLengths y k (y - 1) (2 * r + 3) (2 * r + 1 + 2 * w) =
        prescribedLengths y k (y - 1) (2 * r + 3) (2 * r + 1) + Multiset.replicate (2 * w) y := by
      unfold prescribedLengths
      rw [Multiset.replicate_add (2 * r + 1) (2 * w) y]
      abel
    rw [e1, e2]
    exact hp
  · rw [e1]
    refine ⟨?_, ?_, ?_⟩
    · have h := hEnd 0 (by omega) (hend 0 hE)
      rw [Nat.sub_zero] at h
      exact h
    · intro j hj1 hj2
      have h := hA (2 * j - 1) (2 * j) (by omega) (by omega) (hB2 j hj1 hj2)
      rw [show y + 4 * r + 4 + 2 * w - 1 - (2 * j - 1) = y + 4 * r + 4 + 2 * w - 2 * j by omega]
        at h
      exact h
    · intro he
      rw [Nat.even_iff] at he
      omega

theorem bko11_F0 : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → b < y - k → c < y → b % 2 = 1 → c % 2 = 1 → k ≤ b → k ≤ c → b + c ≤ y → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ TopEndInv y (a₀ + b + c + 1) p :=
by
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 hkb hkc hbc
  
  obtain ⟨Q, hQ, hQlo, hQhi, hQe1, hQe2⟩ := path_III (y - k + 1) (b + c - k) (by omega) (by omega)
  
  obtain ⟨p₁, hp₁, hN₁, hK₁, hE₁⟩ := top_pairs (y - k) (y - k + 1) (b / 2) _ Q
    (by omega) (by omega) (by omega) hQ (fun i hi => hQlo _ (by omega))
  
  obtain ⟨p₂, hp₂, hN₂, hK₂, hE₂⟩ := top_pairs y (y - k + 1 + 2 * (b / 2)) (c / 2) _ p₁
    (by omega) (by omega) (by omega) hp₁
    (fun i hi => hK₁ _ (hQlo _ (by omega)) (fun i' hi' => by omega))
  
  obtain ⟨p₃, hp₃, hE₃, hK₃, -⟩ := top_attach y (y - k + 1 + 2 * (b / 2) + 2 * (c / 2)) _ p₂
    (by omega) (by omega) hp₂ (by
      rw [show y - k + 1 + 2 * (b / 2) + 2 * (c / 2) - y = b + c - k - 1 by omega]
      exact hE₂ _ (hE₁ _ hQe1))
  
  refine ⟨y - k - 1, by omega, by omega, p₃, ?_, ?_⟩
  · rw [show y - k - 1 + b + c + 1 = y - k + 1 + 2 * (b / 2) + 2 * (c / 2) + 1 by omega]
    have hM : prescribedLengths y k (y - k - 1) b c =
        Multiset.replicate (y - k + 1 - 2) 1 + Multiset.replicate 1 (y - k + 1 - 1) +
          Multiset.replicate (2 * (b / 2)) (y - k) + Multiset.replicate (2 * (c / 2)) y +
          Multiset.replicate 1 y := by
      unfold prescribedLengths
      have eb : Multiset.replicate b (y - k) =
          Multiset.replicate 1 (y - k) + Multiset.replicate (2 * (b / 2)) (y - k) := by
        rw [← Multiset.replicate_add]
        congr 1
        omega
      have ec : Multiset.replicate c y =
          Multiset.replicate (2 * (c / 2)) y + Multiset.replicate 1 y := by
        rw [← Multiset.replicate_add]
        congr 1
        omega
      rw [show y - k + 1 - 2 = y - k - 1 by omega, show y - k + 1 - 1 = y - k by omega, eb, ec]
      abel
    rw [hM]
    exact hp₃
  · refine ⟨?_, ?_, ?_⟩
    · rw [show y - k - 1 + b + c + 1 - 1 = y - k + 1 + 2 * (b / 2) + 2 * (c / 2) by omega]
      exact hE₃
    · intro jj hj1 hj2
      obtain ⟨x, hx⟩ : ∃ x, x = y - k - 1 + b + c + 1 - 1 - 2 * jj := ⟨_, rfl⟩
      have key : Adj p₃ x (x + 1) := by
        apply hK₃
        by_cases hr1 : x + 1 ≤ y - k + 1
        · apply hK₂ x
          · apply hK₁ x
            · exact hQhi x (by omega) (by omega)
            · intro i hi
              omega
          · intro i hi
            omega
        · by_cases hr2 : x + 1 ≤ y - k + 1 + 2 * (b / 2)
          · have h := hN₁ ((x - (y - k + 1)) / 2) (by omega)
            rw [show y - k + 1 + 2 * ((x - (y - k + 1)) / 2) = x by omega] at h
            apply hK₂ x h
            intro i hi
            omega
          · have h := hN₂ ((x - (y - k + 1 + 2 * (b / 2))) / 2) (by omega)
            rw [show y - k + 1 + 2 * (b / 2) + 2 * ((x - (y - k + 1 + 2 * (b / 2))) / 2) = x
              by omega] at h
            exact h
      rw [show y - k - 1 + b + c + 1 - 2 * jj = x + 1 by omega,
        show y - k - 1 + b + c + 1 - 1 - 2 * jj = x by omega]
      obtain ⟨l₁, l₂, h | h⟩ := key
      · exact ⟨l₁, l₂, Or.inr h⟩
      · exact ⟨l₁, l₂, Or.inl h⟩
    · intro he
      exact absurd (Nat.even_iff.mp he) (by omega)

theorem bko11_P1 : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → b < y - k → c < y → b % 2 = 1 → c % 2 = 1 → y ≤ k + c + 1 → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ TopEndInv y (a₀ + b + c + 1) p :=
by
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have endc : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x x' h rfl
    exact h
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 hg
  obtain ⟨S, hS⟩ : ∃ S, k = 2 * S + 1 := ⟨k / 2, by omega⟩
  obtain ⟨T, hT⟩ : ∃ T, b = 2 * T + 1 := ⟨b / 2, by omega⟩
  obtain ⟨U, hU⟩ : ∃ U, c = k + 2 * U := ⟨(c - k) / 2, by omega⟩
  have hcy : c + 2 ≤ y := by omega
  
  obtain ⟨Q0, hQ0, hQa, hQb, hE0a, hE0b⟩ := path_II y k hk (by omega)
  
  obtain ⟨Q1, hQ1, hN1, hK1, hE1⟩ := top_pairs y y S _ Q0 (by omega) le_rfl (by omega) hQ0
    (fun i hi => adjc _ _ _ _ _ (hQa (2 * i) (by omega)) (by omega) (by omega))
  
  obtain ⟨Q2, hQ2, -, hN2, hK2, hE2⟩ := top_hook y (y + 2 * S) _ Q1 (by omega) (by omega) hQ1
    (endc _ _ _ (hE1 _ hE0b) (by omega))
  have hE2' : IsEnd Q2 0 := hE2 0 (hE1 0 hE0a) (by omega)
  
  obtain ⟨Q3, hQ3, hN3, hK3, hE3⟩ := top_pairs y (y + 2 * S + 2) U _ Q2 (by omega) (by omega)
    (by omega) hQ2 (fun i hi => by
      have h0 := hQb (k + 1 + 2 * i) (by omega) (by omega)
      have h1 := hK1 _ h0 (fun i' hi' => by omega)
      have h2 := hK2 _ h1
      exact adjc _ _ _ _ _ h2 (by omega) (by omega))
  
  have hS9 : ∀ x : ℕ, x % 2 = 1 → y ≤ x → x + 1 ≤ y + c → Adj Q3 x (x + 1) := by
    intro x hx1 hx2 hx3
    by_cases hA : x + 2 ≤ y + k
    · have h1 := hN1 ((x - y) / 2) (by omega)
      have h2 := hK2 _ h1
      have h3 := hK3 _ h2 (fun i hi => by omega)
      exact adjc _ _ _ _ _ h3 (by omega) (by omega)
    by_cases hB : x = y + 2 * S
    · have h3 := hK3 _ hN2 (fun i hi => by omega)
      exact adjc _ _ _ _ _ h3 (by omega) (by omega)
    · have h3 := hN3 ((x - y - k - 1) / 2) (by omega)
      exact adjc _ _ _ _ _ h3 (by omega) (by omega)
  
  obtain ⟨Q4, hQ4, -, hK4, hE4⟩ := top_pairs (y - k) (y + 2 * S + 2 + 2 * U) T _ Q3 (by omega)
    (by omega) (by omega) hQ3 (fun i hi =>
      adjc _ _ _ _ _ (hS9 (c + k + 1 + 2 * i) (by omega) (by omega) (by omega)) (by omega)
        (by omega))
  have hE4' : IsEnd Q4 0 := hE4 0 (hE3 0 hE2')
  
  have hW : ∀ x : ℕ, x % 2 = 1 → x + 2 ≤ y → Adj Q4 x (x + 1) := by
    intro x hx1 hx2
    have h0 : Adj Q0 x (x + 1) := by
      by_cases hxk : x + 2 ≤ k
      · exact hQa x hxk
      · exact hQb x (by omega) hx2
    have h1 := hK1 _ h0 (fun i hi => by omega)
    have h2 := hK2 _ h1
    have h3 := hK3 _ h2 (fun i hi => by omega)
    exact hK4 _ h3 (fun i hi => by omega)
  
  obtain ⟨hP, hPA, hPE⟩ := reflect_realization _ _ Q4 hQ4
  refine ⟨y - 1, by omega, by omega,
    Q4.map (fun x => y + 2 * S + 2 + 2 * U + 2 * T - 1 - x), ?_, ?_⟩
  · rw [show y - 1 + b + c + 1 = y + 2 * S + 2 + 2 * U + 2 * T by omega]
    refine ⟨hP.1, ?_⟩
    rw [hP.2]
    unfold prescribedLengths
    have h1 : Multiset.replicate (y - 1) 1 =
        Multiset.replicate (y - 2) 1 + Multiset.replicate 1 1 := by
      rw [← Multiset.replicate_add]
      congr 1
      omega
    have h2 : Multiset.replicate b (y - k) =
        Multiset.replicate 1 (y - k) + Multiset.replicate (2 * T) (y - k) := by
      rw [← Multiset.replicate_add]
      congr 1
      omega
    have h3 : Multiset.replicate c y = Multiset.replicate (2 * S) y +
        Multiset.replicate 1 y + Multiset.replicate (2 * U) y := by
      rw [← Multiset.replicate_add, ← Multiset.replicate_add]
      congr 1
      omega
    rw [h1, h2, h3]
    abel
  · rw [show y - 1 + b + c + 1 = y + 2 * S + 2 + 2 * U + 2 * T by omega]
    refine ⟨?_, fun j hj1 hj2 => ?_, fun he => absurd (Nat.even_iff.mp he) (by omega)⟩
    · exact endc _ _ _ (hPE 0 (by omega) hE4') (by omega)
    · have h := hPA _ _ (by omega) (by omega) (hW (2 * j - 1) (by omega) (by omega))
      exact adjc _ _ _ _ _ h (by omega) (by omega)

theorem bko11_P2 : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → b < y - k → c < y → b % 2 = 1 → c % 2 = 1 → y ≤ b + c + 1 → k + c + 1 ≤ y → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ TopEndInv y (a₀ + b + c + 1) p :=
by
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 hP2 hkc1
  obtain ⟨t1, h1⟩ : ∃ t1, 2 * t1 = b + c + 1 - y := ⟨(b + c + 1 - y) / 2, by omega⟩
  obtain ⟨t2, h2⟩ : ∃ t2, 2 * t2 = y - c - 2 := ⟨(y - c - 2) / 2, by omega⟩
  obtain ⟨t3, h3⟩ : ∃ t3, 2 * t3 = c - 1 := ⟨(c - 1) / 2, by omega⟩
  
  obtain ⟨Q, hQ, hQlo, hQhi, -, hQ2⟩ := path_II (y - k + 2) 2 (by omega) (by omega)
  obtain ⟨hS, hSA, hSE⟩ := reflect_realization (y - k + 2) _ Q hQ
  have hSa : ∀ z, z + 2 ≤ y - k →
      Adj (Q.map (fun x => y - k + 2 - 1 - x)) z (z + 1) := by
    intro z hz
    have h := hSA (y - k - z) (y - k - z + 1) (by omega) (by omega)
      (hQhi (y - k - z) (by omega) (by omega))
    rw [show y - k + 2 - 1 - (y - k - z) = z + 1 by omega,
      show y - k + 2 - 1 - (y - k - z + 1) = z by omega] at h
    obtain ⟨l₁, l₂, h | h⟩ := h
    · exact ⟨l₁, l₂, Or.inr h⟩
    · exact ⟨l₁, l₂, Or.inl h⟩
  have hSb : Adj (Q.map (fun x => y - k + 2 - 1 - x)) (y - k) (y - k + 1) := by
    have h := hSA 0 1 (by omega) (by omega) (hQlo 0 (by omega))
    rw [show y - k + 2 - 1 - 0 = y - k + 1 by omega,
      show y - k + 2 - 1 - 1 = y - k by omega] at h
    obtain ⟨l₁, l₂, h | h⟩ := h
    · exact ⟨l₁, l₂, Or.inr h⟩
    · exact ⟨l₁, l₂, Or.inl h⟩
  have hSc : IsEnd (Q.map (fun x => y - k + 2 - 1 - x)) (y - k - 1) := by
    have h := hSE 2 (by omega) hQ2
    rw [show y - k + 2 - 1 - 2 = y - k - 1 by omega] at h
    exact h
  generalize Q.map (fun x => y - k + 2 - 1 - x) = S at hS hSa hSb hSc
  
  obtain ⟨p₁, hp₁, -, hK₁, hE₁⟩ := bot_pairs (y - k) (y - k + 2) t1 _ S
    (by omega) (by omega) (by omega) hS (fun i hi => by
      have h := hSa (y - k - 2 - 2 * i) (by omega)
      rw [show y - k - 2 - 2 * i + 1 = y - k - 1 - 2 * i by omega] at h
      exact h)
  have P1a : Adj p₁ (y - k + 2 * t1) (y - k + 2 * t1 + 1) :=
    hK₁ (y - k) hSb (fun i hi => by omega)
  have P1b : ∀ i, i < t2 → Adj p₁ (2 + 2 * i + 2 * t1) (2 + 2 * i + 2 * t1 + 1) :=
    fun i hi => hK₁ (2 + 2 * i) (hSa _ (by omega)) (fun i' hi' => by omega)
  have P1c : ∀ i, i < t3 → Adj p₁ (b - k + 1 + 2 * i) (b - k + 1 + 2 * i + 1) := by
    intro i hi
    have h := hK₁ (y - k - c + 2 * i) (hSa _ (by omega)) (fun i' hi' => by omega)
    rw [show y - k - c + 2 * i + 2 * t1 = b - k + 1 + 2 * i by omega] at h
    exact h
  have P1d : IsEnd p₁ (y - k - 1 + 2 * t1) := hE₁ _ hSc
  
  obtain ⟨p₂, hp₂, hN₂, hK₂, hE₂⟩ := top_pairs (y - k) (y - k + 2 + 2 * t1) t2 _ p₁
    (by omega) (by omega) (by omega) hp₁ (fun i hi => by
      rw [show y - k + 2 + 2 * t1 - (y - k) + 2 * i = 2 + 2 * i + 2 * t1 by omega]
      exact P1b i hi)
  
  obtain ⟨p₃, hp₃, hN₃, hK₃, hE₃⟩ := top_pairs y (y - k + 2 + 2 * t1 + 2 * t2) t3 _ p₂
    (by omega) (by omega) (by omega) hp₂ (fun i hi => by
      rw [show y - k + 2 + 2 * t1 + 2 * t2 - y + 2 * i = b - k + 1 + 2 * i by omega]
      exact hK₂ _ (P1c i hi) (fun i' hi' => by omega))
  
  obtain ⟨p₄, hp₄, hE₄, hK₄, -⟩ := top_attach y (y - k + 2 + 2 * t1 + 2 * t2 + 2 * t3) _ p₃
    (by omega) (by omega) hp₃ (by
      rw [show y - k + 2 + 2 * t1 + 2 * t2 + 2 * t3 - y = y - k - 1 + 2 * t1 by omega]
      exact hE₃ _ (hE₂ _ P1d))
  
  refine ⟨y - k, by omega, by omega, p₄, ?_, ?_⟩
  · rw [show y - k + b + c + 1 = y - k + 2 + 2 * t1 + 2 * t2 + 2 * t3 + 1 by omega]
    have hM : prescribedLengths y k (y - k) b c =
        Multiset.replicate (y - k + 2 - 2) 1 + Multiset.replicate 1 (y - k + 2 - 2) +
          Multiset.replicate (2 * t1) (y - k) + Multiset.replicate (2 * t2) (y - k) +
          Multiset.replicate (2 * t3) y + Multiset.replicate 1 y := by
      unfold prescribedLengths
      have ea : y - k + 2 - 2 = y - k := by omega
      have eb : Multiset.replicate b (y - k) = Multiset.replicate 1 (y - k) +
          Multiset.replicate (2 * t1) (y - k) + Multiset.replicate (2 * t2) (y - k) := by
        rw [← Multiset.replicate_add, ← Multiset.replicate_add]
        congr 1
        omega
      have ec : Multiset.replicate c y = Multiset.replicate (2 * t3) y +
          Multiset.replicate 1 y := by
        rw [← Multiset.replicate_add]
        congr 1
        omega
      rw [ea, eb, ec]
      abel
    rw [hM]
    exact hp₄
  · refine ⟨?_, ?_, ?_⟩
    · rw [show y - k + b + c + 1 - 1 = y - k + 2 + 2 * t1 + 2 * t2 + 2 * t3 by omega]
      exact hE₄
    · intro jj hj1 hj2
      obtain ⟨x, hx⟩ : ∃ x, x = y - k + b + c - 2 * jj := ⟨_, rfl⟩
      have key : Adj p₄ x (x + 1) := by
        apply hK₄
        by_cases hr1 : x + 2 ≤ y - k + 2 + 2 * t1
        · refine hK₃ x ?_ (fun i hi => by omega)
          refine hK₂ x ?_ (fun i hi => by omega)
          rw [show x = y - k + 2 * t1 by omega]
          exact P1a
        · by_cases hr2 : x + 2 ≤ y - k + 2 + 2 * t1 + 2 * t2
          · refine hK₃ x ?_ (fun i hi => by omega)
            have h := hN₂ ((x - (y - k + 2 + 2 * t1)) / 2) (by omega)
            rw [show y - k + 2 + 2 * t1 + 2 * ((x - (y - k + 2 + 2 * t1)) / 2) = x by omega] at h
            exact h
          · have h := hN₃ ((x - (y - k + 2 + 2 * t1 + 2 * t2)) / 2) (by omega)
            rw [show y - k + 2 + 2 * t1 + 2 * t2 +
              2 * ((x - (y - k + 2 + 2 * t1 + 2 * t2)) / 2) = x by omega] at h
            exact h
      rw [show y - k + b + c + 1 - 2 * jj = x + 1 by omega,
        show y - k + b + c + 1 - 1 - 2 * jj = x by omega]
      obtain ⟨l₁, l₂, h | h⟩ := key
      · exact ⟨l₁, l₂, Or.inr h⟩
      · exact ⟨l₁, l₂, Or.inl h⟩
    · intro he
      exact absurd (Nat.even_iff.mp he) (by omega)

theorem bko11_P35 : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → b < y - k → c < y → b % 2 = 1 → c % 2 = 1 → (k ≤ c ∨ b = 1) → b + c + k ≤ y → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ TopEndInv y (a₀ + b + c + 1) p :=
by
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 hg hbck
  
  obtain ⟨Q, hQ, hQlo, hQhi, -, hQe2⟩ := path_III (y + 1) (k + b + c - 1) (by omega) (by omega)
  
  obtain ⟨p₁, hp₁, hN₁, hK₁, hE₁⟩ := top_pairs (y - k) (y + 1) (b / 2) _ Q
    (by omega) (by omega) (by omega) hQ (fun i hi => hQlo _ (by omega))
  
  obtain ⟨p₂, hp₂, hN₂, hK₂, hE₂⟩ := top_pairs y (y + 1 + 2 * (b / 2)) (c / 2) _ p₁
    (by omega) (by omega) (by omega) hp₁
    (fun i hi => hK₁ _ (hQlo _ (by omega)) (fun i' hi' => by omega))
  
  obtain ⟨p₃, hp₃, hE₃, hK₃, -⟩ := top_attach (y - k) (y + 1 + 2 * (b / 2) + 2 * (c / 2)) _ p₂
    (by omega) (by omega) hp₂ (by
      rw [show y + 1 + 2 * (b / 2) + 2 * (c / 2) - (y - k) = k + b + c - 1 by omega]
      exact hE₂ _ (hE₁ _ hQe2))
  
  refine ⟨y - 1, by omega, by omega, p₃, ?_, ?_⟩
  · rw [show y - 1 + b + c + 1 = y + 1 + 2 * (b / 2) + 2 * (c / 2) + 1 by omega]
    have hM : prescribedLengths y k (y - 1) b c =
        Multiset.replicate (y + 1 - 2) 1 + Multiset.replicate 1 (y + 1 - 1) +
          Multiset.replicate (2 * (b / 2)) (y - k) + Multiset.replicate (2 * (c / 2)) y +
          Multiset.replicate 1 (y - k) := by
      unfold prescribedLengths
      have eb : Multiset.replicate b (y - k) =
          Multiset.replicate (2 * (b / 2)) (y - k) + Multiset.replicate 1 (y - k) := by
        rw [← Multiset.replicate_add]
        congr 1
        omega
      have ec : Multiset.replicate c y =
          Multiset.replicate 1 y + Multiset.replicate (2 * (c / 2)) y := by
        rw [← Multiset.replicate_add]
        congr 1
        omega
      rw [show y + 1 - 1 = y by omega, show y + 1 - 2 = y - 1 by omega, eb, ec]
      abel
    rw [hM]
    exact hp₃
  
  · refine ⟨?_, ?_, ?_⟩
    · rw [show y - 1 + b + c + 1 - 1 = y + 1 + 2 * (b / 2) + 2 * (c / 2) by omega]
      exact hE₃
    · intro jj hj1 hj2
      obtain ⟨x, hx⟩ : ∃ x, x = y + b + c - 1 - 2 * jj := ⟨_, rfl⟩
      have key : Adj p₃ x (x + 1) := by
        apply hK₃
        by_cases hr1 : x + 1 ≤ y
        · apply hK₂ x
          · apply hK₁ x
            · by_cases hlo : x + 2 ≤ k + b + c - 1
              · exact hQlo x hlo
              · exact hQhi x (by omega) (by omega)
            · intro i hi
              rcases hg with h | h <;> omega
          · intro i hi
            omega
        · by_cases hr2 : x + 1 ≤ y + b
          · have h := hN₁ ((x - y - 1) / 2) (by omega)
            rw [show y + 1 + 2 * ((x - y - 1) / 2) = x by omega] at h
            apply hK₂ x h
            intro i hi
            omega
          · have h := hN₂ ((x - y - 1 - 2 * (b / 2)) / 2) (by omega)
            rw [show y + 1 + 2 * (b / 2) + 2 * ((x - y - 1 - 2 * (b / 2)) / 2) = x by omega] at h
            exact h
      rw [show y - 1 + b + c + 1 - 2 * jj = x + 1 by omega,
        show y - 1 + b + c + 1 - 1 - 2 * jj = x by omega]
      obtain ⟨l₁, l₂, h | h⟩ := key
      · exact ⟨l₁, l₂, Or.inr h⟩
      · exact ⟨l₁, l₂, Or.inl h⟩
    · intro he
      exact absurd (Nat.even_iff.mp he) (by omega)

theorem bko11_P6 : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → b < y - k → c < y → b % 2 = 1 → c % 2 = 1 → y ≤ k + b + c → b + c + 1 ≤ y → k + c + 1 ≤ y → y ≤ b + 2 * c → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ TopEndInv y (a₀ + b + c + 1) p :=
by
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 hG1 hG2 hG3 hG4
  by_cases hkc : k ≤ c
  swap
  · by_cases hb' : c + 2 ≤ b
    · exact bko11_S2 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) hb' (by omega)
    · exact bko11_V y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) (by omega) (by omega)
  
  obtain ⟨tb, h1⟩ : ∃ tb, b = 2 * tb + 1 := ⟨b / 2, by omega⟩
  obtain ⟨tc, h2⟩ : ∃ tc, c = 2 * tc + 1 := ⟨c / 2, by omega⟩
  obtain ⟨j, hj⟩ : ∃ j, j = y + 1 - b - c := ⟨_, rfl⟩
  obtain ⟨n0, hn0⟩ : ∃ n0, n0 = y - k + j := ⟨_, rfl⟩
  
  obtain ⟨Q, hQ, hQa, hQb, hQ0, hQj⟩ := path_II n0 j (by omega) (by omega)
  
  obtain ⟨p₁, hp₁, hN₁, hK₁, hE₁⟩ := bot_pairs (y - k) n0 tb _ Q (by omega) (by omega)
    (by omega) hQ (by
      intro i hi
      rw [show y - k - 1 - 2 * i = y - k - 2 - 2 * i + 1 by omega]
      by_cases hx : y - k - 2 - 2 * i + 2 ≤ j
      · exact hQa _ hx
      · exact hQb _ (by omega) (by omega))
  
  obtain ⟨p₂, hp₂, hN₂, hK₂, hE₂⟩ := bot_pairs y (n0 + 2 * tb) tc _ p₁ (by omega) (by omega)
    (by omega) hp₁ (by
      intro i hi
      have h := hK₁ (y - 1 - b - 2 * i) (hQb _ (by omega) (by omega)) (fun i' hi' => by omega)
      rw [show y - 1 - 2 * i = y - 2 - 2 * i + 1 by omega]
      rw [show y - 1 - b - 2 * i + 2 * tb = y - 2 - 2 * i by omega] at h
      exact h)
  
  obtain ⟨p₃, hp₃, hE0, hK₃, -⟩ := bot_attach y (n0 + 2 * tb + 2 * tc) _ p₂ (by omega)
    (by omega) hp₂ (by
      have h := hE₂ _ (hE₁ _ hQj)
      rw [show j + 2 * tb + 2 * tc = y - 1 by omega] at h
      exact h)
  
  obtain ⟨hR, hRA, hRE⟩ := reflect_realization (n0 + 2 * tb + 2 * tc + 1) _ p₃ hp₃
  refine ⟨n0 - 2, by omega, by omega,
    p₃.map (fun x => n0 + 2 * tb + 2 * tc + 1 - 1 - x), ?_, ?_⟩
  · rw [show n0 - 2 + b + c + 1 = n0 + 2 * tb + 2 * tc + 1 by omega]
    have hM : prescribedLengths y k (n0 - 2) b c =
        Multiset.replicate (n0 - 2) 1 + Multiset.replicate 1 (n0 - j) +
          Multiset.replicate (2 * tb) (y - k) + Multiset.replicate (2 * tc) y +
          Multiset.replicate 1 y := by
      unfold prescribedLengths
      have eb : Multiset.replicate b (y - k) =
          Multiset.replicate 1 (y - k) + Multiset.replicate (2 * tb) (y - k) := by
        rw [← Multiset.replicate_add]
        congr 1
        omega
      have ec : Multiset.replicate c y =
          Multiset.replicate (2 * tc) y + Multiset.replicate 1 y := by
        rw [← Multiset.replicate_add]
        congr 1
        all_goals omega
      rw [show n0 - j = y - k by omega, eb, ec]
      abel
    rw [hM]
    exact hR
  · refine ⟨?_, ?_, ?_⟩
    · have h := hRE 0 (by omega) hE0
      rw [show n0 + 2 * tb + 2 * tc + 1 - 1 - 0 = n0 - 2 + b + c + 1 - 1 by omega] at h
      exact h
    · intro jj hj1 hj2
      have key : Adj p₃ (2 * jj - 1) (2 * jj) := by
        have hs : Adj p₂ (2 * jj - 2) (2 * jj - 2 + 1) := by
          by_cases hA : 2 * jj - 2 + 1 ≤ 2 * tc
          · have h := hN₂ (jj - 1) (by omega)
            rw [show 2 * (jj - 1) = 2 * jj - 2 by omega] at h
            exact h
          · have hs1 : Adj p₁ (2 * jj - 2 - 2 * tc) (2 * jj - 2 - 2 * tc + 1) := by
              by_cases hB : 2 * jj - 2 - 2 * tc + 1 ≤ 2 * tb
              · have h := hN₁ ((2 * jj - 2 - 2 * tc) / 2) (by omega)
                rw [show 2 * ((2 * jj - 2 - 2 * tc) / 2) = 2 * jj - 2 - 2 * tc by omega] at h
                exact h
              · have h := hK₁ (2 * jj - 2 - 2 * tc - 2 * tb) (hQa _ (by omega))
                  (fun i hi => by omega)
                rw [show 2 * jj - 2 - 2 * tc - 2 * tb + 2 * tb = 2 * jj - 2 - 2 * tc by omega] at h
                exact h
            have h := hK₂ _ hs1 (fun i hi => by omega)
            rw [show 2 * jj - 2 - 2 * tc + 2 * tc = 2 * jj - 2 by omega] at h
            exact h
        have h := hK₃ _ hs
        rw [show 2 * jj - 2 + 1 = 2 * jj - 1 by omega,
