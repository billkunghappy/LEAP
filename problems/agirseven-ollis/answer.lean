      intro i h1 h2
      rw [hfdef, if_neg (by omega), if_pos h2]
    have hfB : ∀ i, m < i → f i = y + m + 2 - i := by
      intro i h1
      rw [hfdef, if_neg (by omega), if_neg (by omega)]
    have hfi : ∀ i, i < y + 1 + 1 → f (f i) = i ∧ f i < y + 1 + 1 := by
      intro i hi
      rcases Nat.eq_zero_or_pos i with h0 | hpos
      · rw [h0, hf0, hf0]
        omega
      · by_cases hle : i ≤ m
        · rw [hfA i hpos hle, hfA (m + 1 - i) (by omega) (by omega)]
          omega
        · rw [hfB i (by omega), hfB (y + m + 2 - i) (by omega)]
          omega
    have hnodup : ((List.range (y + 1 + 1)).map f).Nodup := by
      apply List.Nodup.map_on _ List.nodup_range
      intro a ha b hb hab
      rw [List.mem_range] at ha hb
      calc a = f (f a) := (hfi a ha).1.symm
        _ = f (f b) := by rw [hab]
        _ = b := (hfi b hb).1
    have hperm : ((List.range (y + 1 + 1)).map f).Perm (List.range (y + 1 + 1)) := by
      rw [List.perm_ext_iff_of_nodup hnodup List.nodup_range]
      intro a
      simp only [List.mem_map, List.mem_range]
      constructor
      · rintro ⟨i, hi, rfl⟩
        exact (hfi i hi).2
      · intro ha
