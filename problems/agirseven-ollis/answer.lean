        Multiset.replicate (2 * r) 1 + Multiset.replicate (2 * r) (2 * μ) +
        Multiset.replicate (2 * r) (2 * μ + 2 * κ + 1) + edgeLengths (c' :: X) := by
    intro s r
    induction r with
