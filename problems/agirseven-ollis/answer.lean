        have h' := hK2 _ h (by intro i hi; omega)
        exact adjc _ _ _ _ _ h' (by omega) (by omega)
    have h4 := hK3 _ hw
    have h5 := hRA _ _ (by omega) (by omega) h4
    exact adjc _ _ _ _ _ h5 (by omega) (by omega)
  · intro he
    have := Nat.even_iff.mp he
    omega

theorem lowD0 : ∀ (y k : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 1 → ∃ p : List ℕ, IsLinearRealization ((y - 1) + (y - k + 1) + 0 + 1) (prescribedLengths y k (y - 1) (y - k + 1) 0) p ∧ BotPairInv (y - k) p ∧ TopEndInv y ((y - 1) + (y - k + 1) + 0 + 1) p :=
by
  intro y k hk hyk hy hk2
  have adj_symm : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h | h⟩
    · exact ⟨l₁, l₂, Or.inr h⟩
    · exact ⟨l₁, l₂, Or.inl h⟩
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have endc : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x x' h rfl
    exact h
  
  have s1 : ∀ (x a : ℕ) (t : List ℕ), edgeLengths (x :: a :: t) =
      Int.natAbs ((a : ℤ) - (x : ℤ)) ::ₘ edgeLengths (a :: t) := by
    intro x a t; rfl
  have s0 : ∀ x : ℕ, edgeLengths [x] = 0 := fun x => rfl
  have s2 : ∀ p : List ℕ, edgeLengths (p.map (· + 1)) = edgeLengths p := by
    intro p
    induction p with
    | nil => rfl
    | cons a t ih =>
      cases t with
      | nil => rfl
      | cons b t' =>
        have e : (a :: b :: t').map (· + 1) = (a + 1) :: (b :: t').map (· + 1) := rfl
        have e' : (b :: t').map (· + 1) = (b + 1) :: t'.map (· + 1) := rfl
        rw [e, e', s1, ← e', ih, s1]
        congr 1
        push_cast
        ring_nf
  have s3 : ∀ (l : List ℕ) (a b : ℕ), edgeLengths (l ++ [a, b]) =
      edgeLengths (l ++ [a]) + {Int.natAbs ((b : ℤ) - (a : ℤ))} := by
    intro l a b
    induction l with
    | nil =>
      rw [List.nil_append, List.nil_append, s1, s0, s0, zero_add]
      rfl
    | cons x l ih =>
      cases l with
      | nil =>
