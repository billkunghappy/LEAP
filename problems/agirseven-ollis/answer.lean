    ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + 7 + 1 ∧ ∃ q : List ℕ,
      IsLinearRealization (a₀ + b + 7 + 1) (prescribedLengths y k a₀ b 7) q ∧
