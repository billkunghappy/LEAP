          rw [← Multiset.replicate_add, ← Multiset.replicate_add, ← Multiset.replicate_add]
          congr 1
          omega
        have hc' : Multiset.replicate c y =
            Multiset.replicate (2 * U) y + Multiset.replicate (2 * s) y := by
          rw [← Multiset.replicate_add]
          congr 1
          omega
        unfold prescribedLengths
        rw [hb', hc']
        abel
      rw [hv, hL] at hp₅
      refine ⟨y - 2, by omega, by omega, p₅, hp₅, hE50, ?_, fun he => absurd he hnotEven⟩
      intro j hj1 hj2
      by_cases hjt : j - 1 < t
      · have h1 := hK5 _ (hC4 (j - 1) hjt)
        exact adjc _ _ _ _ _ h1 (by omega) (by omega)
      · have h1 := hC3 (j - 1 - t) (by omega)
        have h2 := hK4 _ h1 (by intro i' hi'; omega)
        have h3 := hK5 _ h2
        exact adjc _ _ _ _ _ h3 (by omega) (by omega)
    by_cases hreg3 : y - k + 1 ≤ c + k
    · by_cases hcm : c + 1 ≤ y - k
      · exact F3 (c / 2) (by omega) (by omega) (by omega) (by omega) (by omega)
      · exact F3 ((y - k) / 2) (by omega) (by omega) (by omega) (by omega) (by omega)
    · 
      obtain ⟨U, hU⟩ : ∃ U, 2 * U = r + c + k - (y - k) - 1 :=
        ⟨(r + c + k - (y - k) - 1) / 2, by omega⟩
      obtain ⟨T, hT⟩ : ∃ T, 2 * T = c := ⟨c / 2, by omega⟩
      obtain ⟨t, ht⟩ : ∃ t, 2 * t = y - k - 1 - k - c := ⟨(y - k - 1 - k - c) / 2, by omega⟩
      obtain ⟨Q, hQ, hQa, hQb, -, hQk⟩ := path_II y k hk (by omega)
      obtain ⟨p₁, hp₁, -, hK1, hE1⟩ := top_pairs (y - k) y U _ Q hm2 (by omega) (by omega) hQ
        (by
          intro i hi
          have h0 := hQb (k + 2 * i) (by omega) (by omega)
          exact adjc _ _ _ _ _ h0 (by omega) (by omega))
      obtain ⟨p₂, hp₂, hC2, hK2, hE2⟩ := bot_pairs y (y + 2 * U) T _ p₁ (by omega) (by omega)
        (by omega) hp₁
        (by
          intro i hi
          have h1 := hK1 (y - 2 - 2 * i) (hQb _ (by omega) (by omega)) (by intro i' hi'; omega)
          exact adjc _ _ _ _ _ h1 (by omega) (by omega))
      obtain ⟨p₃, hp₃, hC3, hK3, hE3⟩ := bot_pairs (y - k) (y + 2 * U + 2 * T) t _ p₂ hm2
        (by omega) (by omega) hp₂
        (by
          intro i hi
          have h1 := hK1 (y - k - 2 - c - 2 * i) (hQb _ (by omega) (by omega))
            (by intro i' hi'; omega)
          have h2 := hK2 _ h1 (by intro i' hi'; omega)
          exact adjc _ _ _ _ _ h2 (by omega) (by omega))
      obtain ⟨p₄, hp₄, hE40, hK4, -⟩ := bot_attach (y - k) (y + 2 * U + 2 * T + 2 * t) _ p₃
        (by omega) (by omega) hp₃
        (endc _ _ _ (hE3 _ (hE2 _ (hE1 _ hQk))) (by omega))
      have hv : y + 2 * U + 2 * T + 2 * t + 1 = y - 2 + r + c + 1 := by omega
      have hL : Multiset.replicate (y - 2) 1 + Multiset.replicate 1 (y - k) +
          Multiset.replicate (2 * U) (y - k) + Multiset.replicate (2 * T) y +
          Multiset.replicate (2 * t) (y - k) + Multiset.replicate 1 (y - k) =
          prescribedLengths y k (y - 2) r c := by
        have hb' : Multiset.replicate r (y - k) = Multiset.replicate 1 (y - k) +
            Multiset.replicate (2 * U) (y - k) + Multiset.replicate (2 * t) (y - k) +
            Multiset.replicate 1 (y - k) := by
          rw [← Multiset.replicate_add, ← Multiset.replicate_add, ← Multiset.replicate_add]
          congr 1
          omega
        unfold prescribedLengths
        rw [hb', hT]
        abel
      rw [hv, hL] at hp₄
      refine ⟨y - 2, by omega, by omega, p₄, hp₄, hE40, ?_, fun he => absurd he hnotEven⟩
      intro j hj1 hj2
      by_cases ha : j - 1 < t
      · have h1 := hK4 _ (hC3 (j - 1) ha)
        exact adjc _ _ _ _ _ h1 (by omega) (by omega)
      · by_cases hb : j - 1 < t + T
        · have h1 := hC2 (j - 1 - t) (by omega)
          have h2 := hK3 _ h1 (by intro i' hi'; omega)
          have h3 := hK4 _ h2
          exact adjc _ _ _ _ _ h3 (by omega) (by omega)
        · have h1 := hK1 (2 * (j - 1) - 2 * t - c) (hQa _ (by omega)) (by intro i' hi'; omega)
          have h2 := hK2 _ h1 (by intro i' hi'; omega)
          have h3 := hK3 _ h2 (by intro i' hi'; omega)
          have h4 := hK4 _ h3
          exact adjc _ _ _ _ _ h4 (by omega) (by omega)
  
  
  
  obtain ⟨a₀, ha₀, hle, p, hp, hB⟩ := key
  exact ⟨a₀, ha₀, dstar_lift y k a₀ r c p hk hyk hle hp (Or.inl hB)⟩

theorem baseC_O2_F1 : ∀ (y k r c : ℕ), 1 ≤ k → 2 * k < y → (y - k) % 2 = 1 → k % 2 = 0 →
    r % 2 = 0 → c % 2 = 1 → r + c + 2 ≤ y - k →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + (y - k + r) + c + 1) (prescribedLengths y k a₀ (y - k + r) c) p ∧
      BotEndInv (y - k) p :=
by
  intro y k r c hk hyk hm hk2 hr2 hc2 hrc
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have hy2 : y % 2 = 1 := by omega
  have hnotEven : ¬ Even (y - k) := by
    intro he
    have := Nat.even_iff.mp he
    omega
  obtain ⟨t₁, ht₁⟩ : ∃ t, 2 * t = r + c + 1 := ⟨(r + c + 1) / 2, by omega⟩
  obtain ⟨t₂, ht₂⟩ : ∃ t, 2 * t = c - 1 := ⟨(c - 1) / 2, by omega⟩
  obtain ⟨t₃, ht₃⟩ : ∃ t, 2 * t = y - k - c - 2 := ⟨(y - k - c - 2) / 2, by omega⟩
  obtain ⟨Q, hQ, hQa, hQb, -, hQ2⟩ := path_II (y + 2) 2 (by omega) (by omega)
  rw [show y + 2 - 2 = y by omega] at hQ
  obtain ⟨p₁, hp₁, -, hK1, hE1⟩ := top_pairs (y - k) (y + 2) t₁ _ Q (by omega) (by omega)
    (by omega) hQ
    (by
      intro i hi
      rw [show y + 2 - (y - k) + 2 * i = k + 2 + 2 * i by omega]
      exact hQb _ (by omega) (by omega))
  obtain ⟨p₂, hp₂, hC2, hK2, hE2⟩ := bot_pairs y (y + 2 + 2 * t₁) t₂ _ p₁ (by omega) (by omega)
    (by omega) hp₁
    (by
      intro i hi
      have h := hK1 (y - 2 - 2 * i) (hQb _ (by omega) (by omega)) (by intro i' hi'; omega)
      rwa [show y - 2 - 2 * i + 1 = y - 1 - 2 * i by omega] at h)
  obtain ⟨p₃, hp₃, hC3, hK3, hE3⟩ := bot_pairs (y - k) (y + 2 + 2 * t₁ + 2 * t₂) t₃ _ p₂
    (by omega) (by omega) (by omega) hp₂
    (by
      intro i hi
      have h1 := hK1 (y - k - c - 1 - 2 * i) (hQb _ (by omega) (by omega))
        (by intro i' hi'; omega)
      have h2 := hK2 (y - k - c - 1 - 2 * i) h1 (by intro i' hi'; omega)
      rw [show y - k - 2 - 2 * i = y - k - c - 1 - 2 * i + 2 * t₂ by omega,
        show y - k - 1 - 2 * i = y - k - c - 1 - 2 * i + 2 * t₂ + 1 by omega]
      exact h2)
  have hEnd : IsEnd p₃ (y - k - 1) := by
    have h := hE3 _ (hE2 _ (hE1 _ hQ2))
    rwa [show 2 + 2 * t₂ + 2 * t₃ = y - k - 1 by omega] at h
  obtain ⟨p₄, hp₄, hE40, hK4, -⟩ :=
    bot_attach (y - k) (y + 2 + 2 * t₁ + 2 * t₂ + 2 * t₃) _ p₃ (by omega) (by omega) hp₃ hEnd
  have hv : y + 2 + 2 * t₁ + 2 * t₂ + 2 * t₃ + 1 = y + (y - k + r) + c + 1 := by omega
  have hL : Multiset.replicate y 1 + Multiset.replicate 1 y + Multiset.replicate (2 * t₁) (y - k) +
      Multiset.replicate (2 * t₂) y + Multiset.replicate (2 * t₃) (y - k) +
      Multiset.replicate 1 (y - k) = prescribedLengths y k y (y - k + r) c := by
    have hb' : Multiset.replicate (y - k + r) (y - k) =
        Multiset.replicate (2 * t₁) (y - k) + Multiset.replicate (2 * t₃) (y - k) +
        Multiset.replicate 1 (y - k) := by
      rw [← Multiset.replicate_add, ← Multiset.replicate_add]
      congr 1
      omega
    have hc' : Multiset.replicate c y = Multiset.replicate 1 y + Multiset.replicate (2 * t₂) y := by
      rw [← Multiset.replicate_add]
      congr 1
      omega
    unfold prescribedLengths
    rw [hb', hc']
    abel
  rw [hv, hL] at hp₄
  refine ⟨y, le_refl y, p₄, hp₄, hE40, ?_, fun he => absurd he hnotEven⟩
  intro j hj1 hj2
  by_cases hA : j - 1 < t₃
  · have h := hK4 _ (hC3 (j - 1) hA)
    exact adjc _ _ _ _ _ h (by omega) (by omega)
  · by_cases hC : 2 * j + 1 = y - k
    · have h1 := hK1 0 (hQa 0 (by omega)) (by intro i' hi'; omega)
      have h2 := hK2 0 h1 (by intro i hi; omega)
      have h3 := hK3 _ h2 (by intro i hi; omega)
      have h4 := hK4 _ h3
      exact adjc _ _ _ _ _ h4 (by omega) (by omega)
    · obtain ⟨i, hi⟩ : ∃ i, 2 * i = 2 * j - 2 - 2 * t₃ := ⟨j - 1 - t₃, by omega⟩
      have h2 := hC2 i (by omega)
      have h3 := hK3 _ h2 (by intro i' hi'; omega)
      have h4 := hK4 _ h3
      exact adjc _ _ _ _ _ h4 (by omega) (by omega)

theorem baseC_O2_F2 : ∀ (y k r c : ℕ), 1 ≤ k → 2 * k < y → (y - k) % 2 = 1 → k % 2 = 0 →
    r % 2 = 0 → c % 2 = 1 → r + c = y - k → r + 2 ≤ k →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + (y - k + r) + c + 1) (prescribedLengths y k a₀ (y - k + r) c) p ∧
      BotEndInv (y - k) p :=
by
  intro y k r c hk hyk hm hk2 hr2 hc2 hrc hrk
  have hm3 : 3 ≤ y - k := by omega
  have ht1 : 2 * ((y - k - 1) / 2) = y - k - 1 := by omega
  have ht2 : 2 * ((c - 1) / 2) = c - 1 := by omega
  have ht3 : 2 * (r / 2) = r := by omega
  have hy2 : y % 2 = 1 := by omega
  
  obtain ⟨Q, hQ, hQL, hQH, -, hQk⟩ := path_II y k hk (by omega)
  
  obtain ⟨p₁, hp₁, -, hK1, hE1⟩ := top_pairs (y - k) y ((y - k - 1) / 2) _ Q (by omega)
    (by omega) (by omega) hQ (by
      intro i hi
      have h := hQH (k + 2 * i) (by omega) (by omega)
      rwa [show y - (y - k) = k by omega])
  have P1odd : ∀ x : ℕ, x % 2 = 1 → k + 1 ≤ x → x + 2 ≤ y → Adj p₁ x (x + 1) := by
    intro x hx1 hx2 hx3
    exact hK1 x (hQH x (by omega) hx3) (by intro i hi; omega)
  have P1low : ∀ x : ℕ, x + 2 ≤ k → Adj p₁ x (x + 1) := by
    intro x hx
    exact hK1 x (hQL x hx) (by intro i hi; omega)
  have P1end : IsEnd p₁ k := hE1 _ hQk
  
  obtain ⟨p₂, hp₂, hN2, hK2, hE2⟩ := bot_pairs y (y + 2 * ((y - k - 1) / 2)) ((c - 1) / 2) _ p₁
    (by omega) (by omega) (by omega) hp₁ (by
      intro i hi
      have h := P1odd (y - 2 - 2 * i) (by omega) (by omega) (by omega)
      rwa [show y - 2 - 2 * i + 1 = y - 1 - 2 * i by omega] at h)
  have P2end : IsEnd p₂ (k + 2 * ((c - 1) / 2)) := hE2 _ P1end
  have P2low : ∀ x' : ℕ, x' + 1 ≤ r →
      Adj p₂ (x' + 2 * ((c - 1) / 2)) (x' + 2 * ((c - 1) / 2) + 1) := by
    intro x' hx'
    exact hK2 x' (P1low x' (by omega)) (by intro i hi; omega)
  
  obtain ⟨p₃, hp₃, hN3, hK3, hE3⟩ := bot_pairs (y - k)
    (y + 2 * ((y - k - 1) / 2) + 2 * ((c - 1) / 2)) (r / 2) _ p₂
    (by omega) (by omega) (by omega) hp₂ (by
      intro i hi
      have h := P2low (r - 1 - 2 * i) (by omega)
      rwa [show r - 1 - 2 * i + 2 * ((c - 1) / 2) = y - k - 2 - 2 * i by omega,
        show y - k - 2 - 2 * i + 1 = y - k - 1 - 2 * i by omega] at h)
  have P3end : IsEnd p₃ (y - 1) := by
    have h := hE3 _ P2end
    rwa [show k + 2 * ((c - 1) / 2) + 2 * (r / 2) = y - 1 by omega] at h
  have P3mid : ∀ x₂ : ℕ, x₂ % 2 = 0 → x₂ + 3 ≤ c → Adj p₃ (x₂ + r) (x₂ + r + 1) := by
    intro x₂ hx1 hx2
    have h := hN2 (x₂ / 2) (by omega)
    rw [show 2 * (x₂ / 2) = x₂ by omega] at h
    have h2 := hK3 x₂ h (by intro i hi; omega)
    rwa [ht3] at h2
  
  obtain ⟨p₄, hp₄, hE40, hK4, -⟩ := bot_attach y
    (y + 2 * ((y - k - 1) / 2) + 2 * ((c - 1) / 2) + 2 * (r / 2)) _ p₃
    (by omega) (by omega) hp₃ P3end
  
  have hBE : BotEndInv (y - k) p₄ := by
    refine ⟨hE40, ?_, ?_⟩
    · intro j hj1 hj2
      have hslot : Adj p₃ (2 * j - 2) (2 * j - 2 + 1) := by
        by_cases hA : 2 * j ≤ r
        · have h := hN3 (j - 1) (by omega)
          rwa [show 2 * (j - 1) = 2 * j - 2 by omega] at h
        · have h := P3mid (2 * j - 2 - r) (by omega) (by omega)
          rwa [show 2 * j - 2 - r + r = 2 * j - 2 by omega] at h
      have h := hK4 _ hslot
      rwa [show 2 * j - 2 + 1 = 2 * j - 1 by omega, show 2 * j - 2 + 2 = 2 * j by omega] at h
    · intro he
      exfalso
      rw [Nat.even_iff] at he
      omega
  
  have hv : y + 2 * ((y - k - 1) / 2) + 2 * ((c - 1) / 2) + 2 * (r / 2) + 1 =
      y - 2 + (y - k + r) + c + 1 := by omega
  have hL : Multiset.replicate (y - 2) 1 + Multiset.replicate 1 (y - k) +
      Multiset.replicate (2 * ((y - k - 1) / 2)) (y - k) +
      Multiset.replicate (2 * ((c - 1) / 2)) y + Multiset.replicate (2 * (r / 2)) (y - k) +
      Multiset.replicate 1 y = prescribedLengths y k (y - 2) (y - k + r) c := by
    have hb' : Multiset.replicate (y - k + r) (y - k) = Multiset.replicate 1 (y - k) +
        Multiset.replicate (y - k - 1) (y - k) + Multiset.replicate r (y - k) := by
      rw [← Multiset.replicate_add, ← Multiset.replicate_add]
      congr 1
      omega
    have hc' : Multiset.replicate c y = Multiset.replicate (c - 1) y + Multiset.replicate 1 y := by
      rw [← Multiset.replicate_add]
      congr 1
      omega
    rw [ht1, ht2, ht3]
    unfold prescribedLengths
    rw [hb', hc']
    abel
  rw [hv, hL] at hp₄
  exact ⟨y - 2, by omega, p₄, hp₄, hBE⟩

theorem baseC_O2_H : ∀ (y k r c : ℕ), 1 ≤ k → 2 * k < y → (y - k) % 2 = 1 → k % 2 = 0 →
    r = 0 → c % 2 = 1 → y - k ≤ c → c < y →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + (y - k + r) + c + 1) (prescribedLengths y k a₀ (y - k + r) c) p ∧
      BotEndInv (y - k) p :=
by
  intro y k r c hk hyk hm hk2 hr hc2 hmc hc
  subst hr
  obtain ⟨j, hj⟩ : ∃ j, j = y - c := ⟨_, rfl⟩
  obtain ⟨n, hn⟩ : ∃ n, n = (y - k) + j := ⟨_, rfl⟩
  obtain ⟨t₁, ht1⟩ : ∃ t, 2 * t = y - k - 1 := ⟨(y - k) / 2, by omega⟩
  obtain ⟨t₂, ht2⟩ : ∃ t, 2 * t = c - 1 := ⟨c / 2, by omega⟩
  have hm2 : 2 ≤ y - k := by omega
  
  obtain ⟨Q, hQ, -, hQb, -, hQj⟩ := path_II n j (by omega) (by omega)
  rw [show n - j = y - k by omega] at hQ
  
  obtain ⟨p₁, hp₁, hN1, hK1, hE1⟩ := top_pairs (y - k) n t₁ _ Q hm2 (by omega) (by omega) hQ
    (by
      intro i hi
      exact hQb (n - (y - k) + 2 * i) (by omega) (by omega))
  
  obtain ⟨p₂, hp₂, hN2, -, hE2⟩ := bot_pairs y (n + 2 * t₁) t₂ _ p₁ (by omega) (by omega)
    (by omega) hp₁
    (by
      intro i hi
      rw [show y - 1 - 2 * i = y - 2 - 2 * i + 1 by omega]
      by_cases hx : y - 2 - 2 * i + 2 ≤ n
      · exact hK1 _ (hQb _ (by omega) hx) (by intro i' hi'; omega)
      · obtain ⟨i', hi'⟩ : ∃ i', y - 2 - 2 * i = n + 2 * i' :=
          ⟨(y - 2 - 2 * i - n) / 2, by omega⟩
        rw [hi']
        exact hN1 i' (by omega))
  have hEnd : IsEnd p₂ (y - 1) := by
    have h := hE2 _ (hE1 _ hQj)
    rwa [show j + 2 * t₂ = y - 1 by omega] at h
  
  obtain ⟨p₃, hp₃, hE30, hK3, -⟩ :=
    bot_attach y (n + 2 * t₁ + 2 * t₂) _ p₂ (by omega) (by omega) hp₂ hEnd
  
  have hBE : BotEndInv (y - k) p₃ := by
    refine ⟨hE30, ?_, ?_⟩
    · intro j' hj1 hj2
      have h := hK3 _ (hN2 (j' - 1) (by omega))
      rw [show 2 * (j' - 1) + 1 = 2 * j' - 1 by omega,
        show 2 * (j' - 1) + 2 = 2 * j' by omega] at h
      exact h
    · intro he
      obtain ⟨q, hq⟩ := he
      omega
  
  have hv : n + 2 * t₁ + 2 * t₂ + 1 = (y - k) + (y - c) - 2 + (y - k + 0) + c + 1 := by omega
  have hL : Multiset.replicate (n - 2) 1 + Multiset.replicate 1 (y - k) +
      Multiset.replicate (2 * t₁) (y - k) + Multiset.replicate (2 * t₂) y +
      Multiset.replicate 1 y = prescribedLengths y k ((y - k) + (y - c) - 2) (y - k + 0) c := by
    have hb' : Multiset.replicate (y - k + 0) (y - k) =
        Multiset.replicate 1 (y - k) + Multiset.replicate (2 * t₁) (y - k) := by
      rw [← Multiset.replicate_add]; congr 1; omega
    have hc' : Multiset.replicate c y =
        Multiset.replicate (2 * t₂) y + Multiset.replicate 1 y := by
      rw [← Multiset.replicate_add]; congr 1; omega
    have ha' : n - 2 = (y - k) + (y - c) - 2 := by omega
    unfold prescribedLengths
    rw [hb', hc', ha']
    abel
  rw [hv, hL] at hp₃
  exact ⟨(y - k) + (y - c) - 2, by omega, p₃, hp₃, hBE⟩

theorem baseC_O2_E2 : ∀ (y k r c : ℕ), 1 ≤ k → 2 * k < y → (y - k) % 2 = 1 → k % 2 = 0 →
    r % 2 = 0 → c % 2 = 1 → r + c = y - k → k ≤ r →
    ∃ a₀ : ℕ, a₀ ≤ y ∧ y - k ≤ a₀ + r + c ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + r + c + 1) (prescribedLengths y k a₀ r c) p ∧ BotEndInv (y - k) p :=
by
  have adjc : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have adjsymm : ∀ (p : List ℕ) (u w : ℕ), Adj p u w → Adj p w u := by
    rintro p u w ⟨l₁, l₂, h⟩
    exact ⟨l₁, l₂, h.symm⟩
  
  have path_III : ∀ n j : ℕ, 1 ≤ j → j + 1 ≤ n → ∃ Q : List ℕ,
      IsLinearRealization n (Multiset.replicate (n - 2) 1 + Multiset.replicate 1 (n - 1)) Q ∧
      (∀ x : ℕ, x + 2 ≤ j → Adj Q x (x + 1)) ∧
      (∀ x : ℕ, j ≤ x → x + 2 ≤ n → Adj Q x (x + 1)) ∧
      IsEnd Q (j - 1) ∧ IsEnd Q j := by
    intro n j hj hn
    obtain ⟨m, rfl⟩ : ∃ m, n = j + m := ⟨n - j, by omega⟩
    have hm : 1 ≤ m := by omega
    refine ⟨(List.range j).reverse ++ (List.map (fun y => j + y) (List.range m)).reverse,
      ⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
