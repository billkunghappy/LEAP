      have h1 := hK1 _ h0 (fun i' hi' => by omega)
      exact adj_cast _ _ _ _ _ (by omega) (by omega) h1)
  
  have hF1 : ∀ e : ℕ, e < T → Adj Q2 (2 * e) (2 * e + 1) := by
    intro e he
    by_cases h : e < B2
    · exact hN2 e h
    · have h1 := hN1 (e - B2) (by omega)
      have h2 := hK2 _ h1 (fun i hi => by omega)
      exact adj_cast _ _ _ _ _ (by omega) (by omega) h2
  have hF2 : ∀ x : ℕ, Adj Q0 x (x + 1) → (x % 2 = 0 ∨ (2 * B1 + 1 ≤ x ∧ x + 1 ≤ k + 2 * B1)) →
      Adj Q2 (x + 2 * T) (x + 2 * T + 1) := by
    intro x h0 hx
    have h1 := hK1 x h0 (fun i hi => by omega)
    have h2 := hK2 _ h1 (fun i hi => by omega)
    exact adj_cast _ _ _ _ _ (by omega) (by omega) h2
  have hF3 : IsEnd Q2 (y - 1) := by
    have h := hE2 _ (hE1 _ hEa)
    rw [show j - 1 + 2 * (M - B1) + 2 * B2 = y - 1 by omega] at h
    exact h
  
  obtain ⟨Q3, hR3, hZ3, hK3, -⟩ := bot_attach y (y + 1 + 2 * (M - B1) + 2 * B2) _ Q2
    (by omega) (by omega) hR2 hF3
  have hW : ∀ j' : ℕ, 1 ≤ j' → 2 * j' + 1 ≤ y → Adj Q3 (2 * j' - 1) (2 * j') := by
    intro j' h1 h2
    have key : Adj Q2 (2 * (j' - 1)) (2 * (j' - 1) + 1) := by
      by_cases he : j' - 1 < T
      · exact hF1 _ he
      · have h := hF2 (2 * (j' - 1) - 2 * T) (hLo0 _ (by omega)) (Or.inl (by omega))
        exact adj_cast _ _ _ _ _ (by omega) (by omega) h
    have h3 := hK3 _ key
    exact adj_cast _ _ _ _ _ (by omega) (by omega) h3
  have hP : ∀ x : ℕ, x % 2 = 1 → 2 * B1 + 1 ≤ x → x + 1 ≤ k + 2 * B1 →
      Adj Q3 (x + 2 * T + 1) (x + 2 * T + 2) := by
    intro x h1 h2 h3
    have h := hK3 _ (hF2 x (hS x (by omega) (by omega)) (Or.inr ⟨h2, h3⟩))
    exact adj_cast _ _ _ _ _ (by omega) (by omega) h
  
  obtain ⟨Q4, hR4, -, hK4, hE4⟩ := top_pairs (y - k) (y + 1 + 2 * (M - B1) + 2 * B2 + 1) B1 _ Q3
    (by omega) (by omega) (by omega) hR3 (fun i hi => by
      have h := hP (k + 1 + 2 * i) (by omega) (by omega) (by omega)
      exact adj_cast _ _ _ _ _ (by omega) (by omega) h)
  
  obtain ⟨Q5, hR5, -, hK5, hE5⟩ := top_pairs y (y + 1 + 2 * (M - B1) + 2 * B2 + 1 + 2 * B1) a2 _
    Q4 (by omega) (by omega) (by omega) hR4 (fun i hi => by
      have h := hP (1 + 2 * B1 + 2 * i) (by omega) (by omega) (by omega)
      have h4 := hK4 _ h (fun i' hi' => by omega)
      exact adj_cast _ _ _ _ _ (by omega) (by omega) h4)
  refine ⟨y - 1, by omega, by omega, Q5, ?_, ?_⟩
  · have hV : y - 1 + b + c + 1 = y + 1 + 2 * (M - B1) + 2 * B2 + 1 + 2 * B1 + 2 * a2 := by omega
    rw [hV]
    refine ⟨hR5.1, ?_⟩
    rw [hR5.2]
    unfold prescribedLengths
    have h1 : y + 1 - 2 = y - 1 := by omega
    have h2 : y + 1 - 1 = y := by omega
    have h3 : Multiset.replicate c y = Multiset.replicate (2 * (M - B1)) y +
        Multiset.replicate 1 y + Multiset.replicate (2 * a2) y + Multiset.replicate 1 y := by
      rw [← Multiset.replicate_add, ← Multiset.replicate_add, ← Multiset.replicate_add]
      congr 1
      omega
    have h4 : Multiset.replicate b (y - k) = Multiset.replicate (2 * B2) (y - k) +
        Multiset.replicate (2 * B1) (y - k) := by
      rw [← Multiset.replicate_add]
      congr 1
      omega
    rw [h1, h2, h3, h4]
    abel
  · refine ⟨hE5 0 (hE4 0 hZ3), fun j' hj1 hj2 => ?_,
      fun he => absurd (Nat.even_iff.mp he) (by omega)⟩
    have key : Adj Q3 (2 * j' - 1) (2 * j' - 1 + 1) :=
      adj_cast _ _ _ _ _ rfl (by omega) (hW j' hj1 hj2)
    have h4 := hK4 _ key (fun i hi => by omega)
    have h5 := hK5 _ h4 (fun i hi => by omega)
    exact adj_cast _ _ _ _ _ rfl (by omega) h5

theorem bEE_line : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 0 → b < y - k → c < y → b % 2 = 0 → c % 2 = 0 → b + c = y - k + 1 → 2 ≤ b → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ BotEndInv y p :=
by
  have adj_cast : ∀ (p : List ℕ) (u w u' w' : ℕ), u = u' → w = w' → Adj p u w → Adj p u' w' := by
    rintro p u w u' w' rfl rfl h
    exact h
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 hline hb2'
  obtain ⟨C, rfl⟩ : ∃ C, c = 2 * C := ⟨c / 2, by omega⟩
  obtain ⟨t, rfl⟩ : ∃ t, b = 2 * t + 2 := ⟨b / 2 - 1, by omega⟩
  
  obtain ⟨Q0, hR0, hA0, hB0, hE0, -⟩ := path_II (y + 1) (k + 1) (by omega) (by omega)
  have hQ0odd : ∀ x : ℕ, x % 2 = 1 → x + 2 ≤ y + 1 → Adj Q0 x (x + 1) := by
    intro x hx1 hx2
    by_cases h : x + 2 ≤ k + 1
    · exact hA0 x h
    · exact hB0 x (by omega) hx2
  
  obtain ⟨Q1, hR1, hN1, hK1, hE1⟩ := bot_pairs y (y + 1) C _ Q0 (by omega) (by omega)
    (by omega) hR0
    (fun i hi => adj_cast _ _ _ _ _ rfl (by omega) (hB0 (y - 2 - 2 * i) (by omega) (by omega)))
  
  obtain ⟨Q2, hR2, hN2, hK2, hE2⟩ := bot_pairs (y - k) (y + 1 + 2 * C) t _ Q1 (by omega)
    (by omega) (by omega) hR1 (fun i hi => by
      have h0 := hQ0odd (2 * t - 1 - 2 * i) (by omega) (by omega)
      have h1 := hK1 _ h0 (fun i' hi' => by omega)
      exact adj_cast _ _ _ _ _ (by omega) (by omega) h1)
  have hEnd : IsEnd Q2 (y - k - 1) := by
    have h := hE2 _ (hE1 0 hE0)
    rw [show 0 + 2 * C + 2 * t = y - k - 1 by omega] at h
    exact h
  
  obtain ⟨Q3, hR3, hE3, hK3, -⟩ := bot_attach (y - k) (y + 1 + 2 * C + 2 * t) _ Q2 (by omega)
    (by omega) hR2 hEnd
  refine ⟨y - 1, by omega, by omega, Q3, ?_, ?_⟩
  · have hV : y - 1 + (2 * t + 2) + 2 * C + 1 = y + 1 + 2 * C + 2 * t + 1 := by omega
    rw [hV]
    refine ⟨hR3.1, ?_⟩
    rw [hR3.2]
    unfold prescribedLengths
    have e1 : y + 1 - 2 = y - 1 := by omega
    have e2 : y + 1 - (k + 1) = y - k := by omega
    rw [e1, e2]
    have h2 : Multiset.replicate (2 * t + 2) (y - k) = Multiset.replicate (2 * t) (y - k) +
        Multiset.replicate 1 (y - k) + Multiset.replicate 1 (y - k) := by
      rw [← Multiset.replicate_add, ← Multiset.replicate_add]
    rw [h2]
    abel
  · refine ⟨hE3, fun j hj1 hj2 => ?_, fun he => absurd (Nat.even_iff.mp he) (by omega)⟩
    have key : Adj Q2 (2 * j - 2) (2 * j - 2 + 1) := by
      by_cases hW1 : 2 * j - 2 < 2 * t
      · exact adj_cast _ _ _ _ _ (by omega) (by omega) (hN2 (j - 1) (by omega))
      by_cases hW2 : 2 * j - 2 < 2 * t + 2 * C
      · have h1 := hN1 (j - 1 - t) (by omega)
        have h2 := hK2 _ h1 (fun i hi => by omega)
        exact adj_cast _ _ _ _ _ (by omega) (by omega) h2
      · have h0 := hA0 (2 * j - 2 - 2 * t - 2 * C) (by omega)
        have h1 := hK1 _ h0 (fun i hi => by omega)
        have h2 := hK2 _ h1 (fun i hi => by omega)
        exact adj_cast _ _ _ _ _ (by omega) (by omega) h2
    have h3 := hK3 _ key
    exact adj_cast _ _ _ _ _ (by omega) (by omega) h3

theorem bEE_band : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 0 → b < y - k → c < y → b % 2 = 0 → c % 2 = 0 → y - k ≤ c + k + 1 → c + 3 ≤ y - k → y - k + 3 ≤ b + c → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ BotEndInv y p :=
by
  have adj_cast : ∀ (p : List ℕ) (u w u' w' : ℕ), u = u' → w = w' → Adj p u w → Adj p u' w' := by
    rintro p u w u' w' rfl rfl h
    exact h
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 hH1 hH2 hH3
  obtain ⟨C, rfl⟩ : ∃ C, c = 2 * C := ⟨c / 2, by omega⟩
  obtain ⟨s, hs⟩ : ∃ s, y - k = 2 * C + 2 * s + 1 := ⟨(y - k - 1 - 2 * C) / 2, by omega⟩
  obtain ⟨t, rfl⟩ : ∃ t, b = 2 * s + 2 * t + 2 := ⟨(b - 2 * s - 2) / 2, by omega⟩
  have hs1 : 1 ≤ s := by omega
  have hsk : 2 * s ≤ k := by omega
  have htC : t + 1 ≤ C := by omega
  
  obtain ⟨Q0, hR0, hA0, hB0, hE0, -⟩ := path_II (y + 2) (k + 2) (by omega) (by omega)
  
  obtain ⟨Q1, hR1, hN1, hK1, hE1⟩ := bot_pairs y (y + 2) C _ Q0 (by omega) (by omega)
    (by omega) hR0
    (fun i hi => adj_cast _ _ _ _ _ rfl (by omega) (hB0 (y - 2 - 2 * i) (by omega) (by omega)))
  
  obtain ⟨Q2, hR2, hN2, hK2, hE2⟩ := bot_pairs (y - k) (y + 2 + 2 * C) s _ Q1 (by omega)
    (by omega) (by omega) hR1 (fun i hi => by
      have h0 := hA0 (2 * s - 1 - 2 * i) (by omega)
      have h1 := hK1 _ h0 (fun i' hi' => by omega)
      exact adj_cast _ _ _ _ _ (by omega) (by omega) h1)
  have hEnd : IsEnd Q2 (y - k - 1) := by
    have h := hE2 _ (hE1 0 hE0)
    rw [show 0 + 2 * C + 2 * s = y - k - 1 by omega] at h
    exact h
  
  obtain ⟨Q3, hR3, hE3, hK3, -⟩ := bot_attach (y - k) (y + 2 + 2 * C + 2 * s) _ Q2 (by omega)
    (by omega) hR2 hEnd
  
  obtain ⟨Q4, hR4, -, hK4, hE4⟩ := top_pairs (y - k) (y + 2 + 2 * C + 2 * s + 1) t _ Q3
    (by omega) (by omega) (by omega) hR3 (fun i hi => by
      have h0 := hB0 (k + 2 + 2 * i) (by omega) (by omega)
      have h1 := hK1 _ h0 (fun i' hi' => by omega)
      have h2 := hK2 _ h1 (fun i' hi' => by omega)
      have h3 := hK3 _ h2
      exact adj_cast _ _ _ _ _ (by omega) (by omega) h3)
  refine ⟨y, le_refl y, by omega, Q4, ?_, ?_⟩
  · have hV : y + (2 * s + 2 * t + 2) + 2 * C + 1 = y + 2 + 2 * C + 2 * s + 1 + 2 * t := by omega
    rw [hV]
    refine ⟨hR4.1, ?_⟩
    rw [hR4.2]
    unfold prescribedLengths
    have e1 : y + 2 - 2 = y := by omega
    have e2 : y + 2 - (k + 2) = y - k := by omega
    rw [e1, e2]
    have h2 : Multiset.replicate (2 * s + 2 * t + 2) (y - k) = Multiset.replicate (2 * s) (y - k) +
        Multiset.replicate (2 * t) (y - k) + Multiset.replicate 1 (y - k) +
        Multiset.replicate 1 (y - k) := by
      rw [← Multiset.replicate_add, ← Multiset.replicate_add, ← Multiset.replicate_add]
    rw [h2]
    abel
  · refine ⟨hE4 _ hE3, fun j hj1 hj2 => ?_, fun he => absurd (Nat.even_iff.mp he) (by omega)⟩
    have key : Adj Q2 (2 * j - 2) (2 * j - 2 + 1) := by
      by_cases hW1 : 2 * j - 2 < 2 * s
      · exact adj_cast _ _ _ _ _ (by omega) (by omega) (hN2 (j - 1) (by omega))
      by_cases hW2 : 2 * j - 2 < 2 * s + 2 * C
      · have h1 := hN1 (j - 1 - s) (by omega)
        have h2 := hK2 _ h1 (fun i hi => by omega)
        exact adj_cast _ _ _ _ _ (by omega) (by omega) h2
      · have h0 := hA0 (2 * j - 2 - 2 * s - 2 * C) (by omega)
        have h1 := hK1 _ h0 (fun i hi => by omega)
        have h2 := hK2 _ h1 (fun i hi => by omega)
        exact adj_cast _ _ _ _ _ (by omega) (by omega) h2
    have h3 := hK3 _ key
    have h4 := hK4 _ h3 (fun i hi => by omega)
    exact adj_cast _ _ _ _ _ (by omega) (by omega) h4

theorem bEE_EBk : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 0 → b < y - k → c < y → b % 2 = 0 → c % 2 = 0 → 2 ≤ c → c + 3 ≤ y - k → y ≤ b + c + 3 → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ BotEndInv y p :=
by
  
  have bot_ones : ∀ (r v : ℕ) (L : Multiset ℕ) (p : List ℕ), 1 ≤ v →
      IsLinearRealization v L p → IsEnd p 0 →
      ∃ p' : List ℕ, IsLinearRealization (v + r) (L + Multiset.replicate r 1) p' ∧ IsEnd p' 0 ∧
        (∀ x : ℕ, x < r → Adj p' x (x + 1)) ∧
        (∀ x : ℕ, Adj p x (x + 1) → Adj p' (x + r) (x + r + 1)) ∧
        (∀ x : ℕ, IsEnd p x → x ≠ 0 → IsEnd p' (x + r)) := by
    have eCC : ∀ (a b : ℕ) (l : List ℕ), edgeLengths (a :: b :: l) =
        Int.natAbs ((b : ℤ) - (a : ℤ)) ::ₘ edgeLengths (b :: l) := by
      intro a b l
      simp [edgeLengths]
    have eS : ∀ a : ℕ, edgeLengths [a] = 0 := by
      intro a
      simp [edgeLengths]
    have eSnoc : ∀ (a b : ℕ) (l : List ℕ), edgeLengths (l ++ [a, b]) =
        Int.natAbs ((b : ℤ) - (a : ℤ)) ::ₘ edgeLengths (l ++ [a]) := by
      intro a b l
      induction l with
      | nil => simp [eCC, eS]
      | cons c l ih =>
        cases l with
        | nil =>
          simp only [List.nil_append, List.cons_append, eCC, eS]
          exact Multiset.cons_swap _ _ _
        | cons d l =>
          simp only [List.cons_append] at ih ⊢
          rw [eCC, ih, eCC, Multiset.cons_swap]
    have eRev : ∀ l : List ℕ, edgeLengths l.reverse = edgeLengths l := by
      intro l
      induction l with
      | nil => simp
      | cons a l ih =>
        cases l with
        | nil => simp
        | cons b l =>
          have h1 : (a :: b :: l).reverse = l.reverse ++ [b, a] := by simp
          have h2 : (b :: l).reverse = l.reverse ++ [b] := by simp
          rw [h1, eSnoc, ← h2, ih, eCC]
          congr 1
          rw [← Int.natAbs_neg]
          congr 1
          ring
    have eMap : ∀ l : List ℕ, edgeLengths (l.map (· + 1)) = edgeLengths l := by
      intro l
      induction l with
      | nil => simp
      | cons a l ih =>
        cases l with
        | nil => simp [eS]
        | cons b l =>
          simp only [List.map_cons] at ih ⊢
          rw [eCC, ih, eCC]
          congr 1
          push_cast
          ring_nf
    have adjRev : ∀ (l : List ℕ) (u w : ℕ), Adj l u w → Adj l.reverse u w := by
      rintro l u w ⟨l₁, l₂, h | h⟩
      · exact ⟨l₂.reverse, l₁.reverse, Or.inr (by simp [h])⟩
      · exact ⟨l₂.reverse, l₁.reverse, Or.inl (by simp [h])⟩
    have adjShift : ∀ (l : List ℕ) (u w : ℕ), Adj l u w →
        Adj (0 :: l.map (· + 1)) (u + 1) (w + 1) := by
      rintro l u w ⟨l₁, l₂, h | h⟩
      · exact ⟨0 :: l₁.map (· + 1), l₂.map (· + 1), Or.inl (by simp [h])⟩
      · exact ⟨0 :: l₁.map (· + 1), l₂.map (· + 1), Or.inr (by simp [h])⟩
    have gLast : ∀ (l : List ℕ) (x : ℕ), l.getLast? = some x →
        (0 :: l.map (· + 1)).getLast? = some (x + 1) := by
      intro l x h
      cases l with
      | nil => simp at h
      | cons a l =>
        have e : (a + 1) :: List.map (fun x => x + 1) l = (a :: l).map (· + 1) := rfl
        rw [List.map_cons, List.getLast?_cons_cons, e, List.getLast?_map, h]
        rfl
    have H : ∀ (r v : ℕ) (L : Multiset ℕ) (p : List ℕ), IsLinearRealization v L p →
        p.head? = some 0 →
        ∃ p' : List ℕ, IsLinearRealization (v + r) (L + Multiset.replicate r 1) p' ∧
          p'.head? = some 0 ∧ (∀ x : ℕ, x < r → Adj p' x (x + 1)) ∧
          (∀ u w : ℕ, Adj p u w → Adj p' (u + r) (w + r)) ∧
          (∀ x : ℕ, p.getLast? = some x → p'.getLast? = some (x + r)) := by
      intro r v L p hp hh
      induction r with
      | zero => exact ⟨p, by simpa using hp, hh, fun x hx => by omega,
          fun u w h => by simpa using h, fun x hx => by simpa using hx⟩
      | succ r ih =>
        obtain ⟨p', ⟨hperm, hlen⟩, hh', hO, hA, hL⟩ := ih
        obtain ⟨t, rfl⟩ : ∃ t, p' = 0 :: t := by
          cases p' with
          | nil => simp at hh'
          | cons a t => simp at hh'; exact ⟨t, by rw [hh']⟩
        refine ⟨0 :: (0 :: t).map (· + 1), ⟨?_, ?_⟩, rfl, ?_, ?_, ?_⟩
        · show (0 :: (0 :: t).map (· + 1)).Perm (List.range (v + r + 1))
          rw [List.range_succ_eq_map]
          exact (List.Perm.map (· + 1) hperm).cons 0
        · have e : (0 :: (0 :: t).map (· + 1)) = 0 :: 1 :: t.map (· + 1) := rfl
          have e' : (1 :: t.map (· + 1)) = (0 :: t).map (· + 1) := rfl
          rw [e, eCC, e', eMap, hlen, Multiset.replicate_succ, Multiset.add_cons]
          rfl
        · intro x hx
          rcases x with _ | x
          · exact ⟨[], (t.map (· + 1)), Or.inl (by simp)⟩
          · exact adjShift _ _ _ (hO x (by omega))
        · intro u w h
          exact adjShift _ _ _ (hA u w h)
        · intro x hx
          have h := gLast _ _ (hL x hx)
          rw [show x + (r + 1) = x + r + 1 by omega]
          exact h
    intro r v L p hv hp h0
    rcases h0 with h0 | h0
    · obtain ⟨p', hp', hh', hO, hA, hL⟩ := H r v L p hp h0
      refine ⟨p', hp', Or.inl hh', hO, fun x hx => ?_, fun x hx hx0 => ?_⟩
      · have h := hA _ _ hx
        rw [show x + 1 + r = x + r + 1 by omega] at h
        exact h
      rcases hx with hx | hx
      · rw [h0] at hx
        simp at hx
        omega
      · exact Or.inr (hL x hx)
    · have hpr : IsLinearRealization v L p.reverse :=
        ⟨List.Perm.trans (List.reverse_perm p) hp.1, by rw [eRev]; exact hp.2⟩
      have hh : p.reverse.head? = some 0 := by rw [List.head?_reverse]; exact h0
      obtain ⟨p', hp', hh', hO, hA, hL⟩ := H r v L p.reverse hpr hh
      refine ⟨p', hp', Or.inl hh', hO, fun x hx => ?_, fun x hx hx0 => ?_⟩
      · have h := hA _ _ (adjRev _ _ _ hx)
        rw [show x + 1 + r = x + r + 1 by omega] at h
        exact h
      rcases hx with hx | hx
      · exact Or.inr (hL x (by rw [List.getLast?_reverse]; exact hx))
      · rw [h0] at hx
        simp at hx
        omega
  have adjeq : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have endeq : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x x' h rfl
    exact h
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 hc0 hc3 hbc
  obtain ⟨K, hK⟩ : ∃ K, k = 2 * K := ⟨k / 2, by omega⟩
  obtain ⟨M, hM⟩ : ∃ M, y = 2 * M + 1 + k := ⟨(y - 1 - k) / 2, by omega⟩
  obtain ⟨B, rfl⟩ : ∃ B, b = 2 * B := ⟨b / 2, by omega⟩
  obtain ⟨C, rfl⟩ : ∃ C, c = 2 * C := ⟨c / 2, by omega⟩
  obtain ⟨t, ht⟩ : ∃ t, B + C = M + t := ⟨B + C - M, by omega⟩
  obtain ⟨s, hs⟩ : ∃ s, M = C + 1 + s := ⟨M - 1 - C, by omega⟩
  
  obtain ⟨Q0, hR0, hA0, hB0, hE0, hE0'⟩ := path_II (y - k + 2) 2 (by omega) (by omega)
  
  obtain ⟨Q1, hR1, hN1, hK1, hE1⟩ := top_pairs (y - k) (y - k + 2) t _ Q0
    (by omega) (by omega) (by omega) hR0 (fun i hi =>
      adjeq _ _ _ _ _ (hB0 (2 + 2 * i) (by omega) (by omega)) (by omega) (by omega))
  
  obtain ⟨Q2, hR2, hN2, hK2, hE2⟩ := bot_pairs y (y - k + 2 + 2 * t) C _ Q1
    (by omega) (by omega) (by omega) hR1 (fun i hi => by
      by_cases hiK : K ≤ i + 1
      · have h0 := hB0 (y - 2 - 2 * i) (by omega) (by omega)
        have h1 := hK1 _ h0 (fun i' hi' => by omega)
        exact adjeq _ _ _ _ _ h1 rfl (by omega)
      · exact adjeq _ _ _ _ _ (hN1 (K - 2 - i) (by omega)) (by omega) (by omega))
  
  obtain ⟨Q3, hR3, hN3, hK3, hE3⟩ := bot_pairs (y - k) (y - k + 2 + 2 * t + 2 * C) s _ Q2
    (by omega) (by omega) (by omega) hR2 (fun i hi => by
      have h0 := hB0 (2 * s + 1 - 2 * i) (by omega) (by omega)
      have h1 := hK1 _ h0 (fun i' hi' => by omega)
      have h2 := hK2 _ h1 (fun i' hi' => by omega)
      exact adjeq _ _ _ _ _ h2 (by omega) (by omega))
  have hQ3e : IsEnd Q3 (y - k - 1) := endeq _ _ _ (hE3 _ (hE2 _ (hE1 _ hE0'))) (by omega)
  
  have heven3 : ∀ z : ℕ, z % 2 = 0 → z ≤ 2 * s + 2 * C → Adj Q3 z (z + 1) := by
    intro z hz1 hz2
    by_cases hzs : z < 2 * s
    · exact adjeq _ _ _ _ _ (hN3 (z / 2) (by omega)) (by omega) (by omega)
    · by_cases hzc : z < 2 * s + 2 * C
      · have h2 := hN2 ((z - 2 * s) / 2) (by omega)
        have h3 := hK3 _ h2 (fun i hi => by omega)
        exact adjeq _ _ _ _ _ h3 (by omega) (by omega)
      · have h0 := hA0 0 (by omega)
        have h1 := hK1 _ h0 (fun i hi => by omega)
        have h2 := hK2 _ h1 (fun i hi => by omega)
        have h3 := hK3 _ h2 (fun i hi => by omega)
        exact adjeq _ _ _ _ _ h3 (by omega) (by omega)
  
  obtain ⟨Q4, hR4, hE4a, hK4, -⟩ := bot_attach (y - k) (y - k + 2 + 2 * t + 2 * C + 2 * s) _ Q3
    (by omega) (by omega) hR3 hQ3e
  
  obtain ⟨Q5, hR5, hE5a, hO5, hK5, -⟩ := bot_ones k (y - k + 2 + 2 * t + 2 * C + 2 * s + 1) _ Q4
    (by omega) hR4 hE4a
  refine ⟨y, le_rfl, by omega, Q5, ?_, ?_⟩
  · have e : y - k + 2 + 2 * t + 2 * C + 2 * s + 1 + k = y + 2 * B + 2 * C + 1 := by omega
    rw [e] at hR5
    have hL : Multiset.replicate (y - k + 2 - 2) 1 + Multiset.replicate 1 (y - k + 2 - 2) +
        Multiset.replicate (2 * t) (y - k) + Multiset.replicate (2 * C) y +
        Multiset.replicate (2 * s) (y - k) + Multiset.replicate 1 (y - k) +
        Multiset.replicate k 1 = prescribedLengths y k y (2 * B) (2 * C) := by
      rw [show y - k + 2 - 2 = y - k by omega]
      unfold prescribedLengths
      have e1 : Multiset.replicate y 1 =
          Multiset.replicate (y - k) 1 + Multiset.replicate k 1 := by
        rw [← Multiset.replicate_add]
        congr 1
        omega
      have e2 : Multiset.replicate (2 * B) (y - k) =
          Multiset.replicate 1 (y - k) + Multiset.replicate (2 * t) (y - k) +
          Multiset.replicate (2 * s) (y - k) + Multiset.replicate 1 (y - k) := by
        simp only [← Multiset.replicate_add]
        congr 1
        omega
      rw [e1, e2]
      abel
    rw [hL] at hR5
    exact hR5
  · refine ⟨hE5a, fun j hj1 hj2 => ?_, fun he => ?_⟩
    · by_cases hj : 2 * j - 1 < k
      · exact adjeq _ _ _ _ _ (hO5 (2 * j - 1) hj) rfl (by omega)
      · have h3 := heven3 (2 * j - 2 - k) (by omega) (by omega)
        have h4 := hK4 _ h3
        have h5 := hK5 _ (adjeq _ _ _ _ _ h4 rfl (by omega))
        exact adjeq _ _ _ _ _ h5 (by omega) (by omega)
    · rw [Nat.even_iff] at he
      omega

theorem bEE_Gband : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 0 → b < y - k → c < y → b % 2 = 0 → c % 2 = 0 → c + k + 3 ≤ y - k → y - k + 3 ≤ b + c → b + c + 5 ≤ y → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ BotEndInv y p :=
by
  
  
  have bot_ones : ∀ (r v : ℕ) (L : Multiset ℕ) (p : List ℕ), 1 ≤ v →
      IsLinearRealization v L p → IsEnd p 0 →
      ∃ p' : List ℕ, IsLinearRealization (v + r) (L + Multiset.replicate r 1) p' ∧ IsEnd p' 0 ∧
        (∀ x : ℕ, x < r → Adj p' x (x + 1)) ∧
        (∀ x : ℕ, Adj p x (x + 1) → Adj p' (x + r) (x + r + 1)) ∧
        (∀ x : ℕ, IsEnd p x → x ≠ 0 → IsEnd p' (x + r)) := by
    have eCC : ∀ (a b : ℕ) (l : List ℕ), edgeLengths (a :: b :: l) =
        Int.natAbs ((b : ℤ) - (a : ℤ)) ::ₘ edgeLengths (b :: l) := by
      intro a b l
      simp [edgeLengths]
    have eS : ∀ a : ℕ, edgeLengths [a] = 0 := by
      intro a
      simp [edgeLengths]
    have eSnoc : ∀ (a b : ℕ) (l : List ℕ), edgeLengths (l ++ [a, b]) =
        Int.natAbs ((b : ℤ) - (a : ℤ)) ::ₘ edgeLengths (l ++ [a]) := by
      intro a b l
      induction l with
      | nil => simp [eCC, eS]
      | cons c l ih =>
        cases l with
        | nil =>
          simp only [List.nil_append, List.cons_append, eCC, eS]
          exact Multiset.cons_swap _ _ _
        | cons d l =>
          simp only [List.cons_append] at ih ⊢
          rw [eCC, ih, eCC, Multiset.cons_swap]
    have eRev : ∀ l : List ℕ, edgeLengths l.reverse = edgeLengths l := by
      intro l
      induction l with
      | nil => simp
      | cons a l ih =>
        cases l with
        | nil => simp
        | cons b l =>
          have h1 : (a :: b :: l).reverse = l.reverse ++ [b, a] := by simp
          have h2 : (b :: l).reverse = l.reverse ++ [b] := by simp
          rw [h1, eSnoc, ← h2, ih, eCC]
          congr 1
          rw [← Int.natAbs_neg]
          congr 1
          ring
    have eMap : ∀ l : List ℕ, edgeLengths (l.map (· + 1)) = edgeLengths l := by
      intro l
      induction l with
      | nil => simp
      | cons a l ih =>
        cases l with
        | nil => simp [eS]
        | cons b l =>
          simp only [List.map_cons] at ih ⊢
          rw [eCC, ih, eCC]
          congr 1
          push_cast
          ring_nf
    have adjRev : ∀ (l : List ℕ) (u w : ℕ), Adj l u w → Adj l.reverse u w := by
      rintro l u w ⟨l₁, l₂, h | h⟩
      · exact ⟨l₂.reverse, l₁.reverse, Or.inr (by simp [h])⟩
      · exact ⟨l₂.reverse, l₁.reverse, Or.inl (by simp [h])⟩
    have adjShift : ∀ (l : List ℕ) (u w : ℕ), Adj l u w →
        Adj (0 :: l.map (· + 1)) (u + 1) (w + 1) := by
      rintro l u w ⟨l₁, l₂, h | h⟩
      · exact ⟨0 :: l₁.map (· + 1), l₂.map (· + 1), Or.inl (by simp [h])⟩
      · exact ⟨0 :: l₁.map (· + 1), l₂.map (· + 1), Or.inr (by simp [h])⟩
    have gLast : ∀ (l : List ℕ) (x : ℕ), l.getLast? = some x →
        (0 :: l.map (· + 1)).getLast? = some (x + 1) := by
      intro l x h
      cases l with
      | nil => simp at h
      | cons a l =>
        have e : (a + 1) :: List.map (fun x => x + 1) l = (a :: l).map (· + 1) := rfl
        rw [List.map_cons, List.getLast?_cons_cons, e, List.getLast?_map, h]
        rfl
    have H : ∀ (r v : ℕ) (L : Multiset ℕ) (p : List ℕ), IsLinearRealization v L p →
        p.head? = some 0 →
        ∃ p' : List ℕ, IsLinearRealization (v + r) (L + Multiset.replicate r 1) p' ∧
          p'.head? = some 0 ∧ (∀ x : ℕ, x < r → Adj p' x (x + 1)) ∧
          (∀ u w : ℕ, Adj p u w → Adj p' (u + r) (w + r)) ∧
          (∀ x : ℕ, p.getLast? = some x → p'.getLast? = some (x + r)) := by
      intro r v L p hp hh
      induction r with
      | zero => exact ⟨p, by simpa using hp, hh, fun x hx => by omega,
          fun u w h => by simpa using h, fun x hx => by simpa using hx⟩
      | succ r ih =>
        obtain ⟨p', ⟨hperm, hlen⟩, hh', hO, hA, hL⟩ := ih
        obtain ⟨t, rfl⟩ : ∃ t, p' = 0 :: t := by
          cases p' with
          | nil => simp at hh'
          | cons a t => simp at hh'; exact ⟨t, by rw [hh']⟩
        refine ⟨0 :: (0 :: t).map (· + 1), ⟨?_, ?_⟩, rfl, ?_, ?_, ?_⟩
        · show (0 :: (0 :: t).map (· + 1)).Perm (List.range (v + r + 1))
          rw [List.range_succ_eq_map]
          exact (List.Perm.map (· + 1) hperm).cons 0
        · have e : (0 :: (0 :: t).map (· + 1)) = 0 :: 1 :: t.map (· + 1) := rfl
          have e' : (1 :: t.map (· + 1)) = (0 :: t).map (· + 1) := rfl
          rw [e, eCC, e', eMap, hlen, Multiset.replicate_succ, Multiset.add_cons]
          rfl
        · intro x hx
          rcases x with _ | x
          · exact ⟨[], (t.map (· + 1)), Or.inl (by simp)⟩
          · exact adjShift _ _ _ (hO x (by omega))
        · intro u w h
          exact adjShift _ _ _ (hA u w h)
        · intro x hx
          have h := gLast _ _ (hL x hx)
          rw [show x + (r + 1) = x + r + 1 by omega]
          exact h
    intro r v L p hv hp h0
    rcases h0 with h0 | h0
    · obtain ⟨p', hp', hh', hO, hA, hL⟩ := H r v L p hp h0
      refine ⟨p', hp', Or.inl hh', hO, fun x hx => ?_, fun x hx hx0 => ?_⟩
      · have h := hA _ _ hx
        rw [show x + 1 + r = x + r + 1 by omega] at h
        exact h
      rcases hx with hx | hx
      · rw [h0] at hx
        simp at hx
        omega
      · exact Or.inr (hL x hx)
    · have hpr : IsLinearRealization v L p.reverse :=
        ⟨List.Perm.trans (List.reverse_perm p) hp.1, by rw [eRev]; exact hp.2⟩
      have hh : p.reverse.head? = some 0 := by rw [List.head?_reverse]; exact h0
      obtain ⟨p', hp', hh', hO, hA, hL⟩ := H r v L p.reverse hpr hh
      refine ⟨p', hp', Or.inl hh', hO, fun x hx => ?_, fun x hx hx0 => ?_⟩
      · have h := hA _ _ (adjRev _ _ _ hx)
        rw [show x + 1 + r = x + r + 1 by omega] at h
        exact h
      rcases hx with hx | hx
      · exact Or.inr (hL x (by rw [List.getLast?_reverse]; exact hx))
      · rw [h0] at hx
        simp at hx
        omega
  have adjeq : ∀ (p : List ℕ) (u w u' w' : ℕ), Adj p u w → u = u' → w = w' → Adj p u' w' := by
    rintro p u w u' w' h rfl rfl
    exact h
  have endeq : ∀ (p : List ℕ) (x x' : ℕ), IsEnd p x → x = x' → IsEnd p x' := by
    rintro p x x' h rfl
    exact h
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 h1 h2 h3
  obtain ⟨K, rfl⟩ : ∃ K, k = 2 * K := ⟨k / 2, by omega⟩
  obtain ⟨B, rfl⟩ : ∃ B, b = 2 * B := ⟨b / 2, by omega⟩
  obtain ⟨C, rfl⟩ : ∃ C, c = 2 * C := ⟨c / 2, by omega⟩
  obtain ⟨M, hM⟩ : ∃ M, y = 2 * M + 1 + 2 * K := ⟨(y - 2 * K - 1) / 2, by omega⟩
  have hK : 1 ≤ K := by omega
  have hKM : K ≤ M := by omega
  have hym : y - 2 * K = 2 * M + 1 := by omega
  
  have macA : ∀ (q v : ℕ) (L : Multiset ℕ) (p : List ℕ), 2 * M + 3 ≤ v →
      2 * (q * K) ≤ 2 * M + 2 → IsLinearRealization v L p →
      (∀ i : ℕ, i < q * K → Adj p (2 * M + 1 - 2 * i) (2 * M + 1 - 2 * i + 1)) →
      ∃ p' : List ℕ, IsLinearRealization (v + 2 * (q * K))
        (L + Multiset.replicate (2 * (q * (K - 1))) (2 * M + 1) + Multiset.replicate (2 * q) y) p' ∧
        (∀ i : ℕ, i < q * K → Adj p' (2 * i) (2 * i + 1)) ∧
        (∀ x : ℕ, Adj p x (x + 1) → (∀ i : ℕ, i < q * K → x ≠ 2 * M + 1 - 2 * i) →
          Adj p' (x + 2 * (q * K)) (x + 2 * (q * K) + 1)) ∧
        (∀ x : ℕ, IsEnd p x → IsEnd p' (x + 2 * (q * K))) := by
    intro q
    induction q with
    | zero =>
      intro v L p _ _ hp _
      refine ⟨p, ?_, fun i hi => by simp at hi, fun x hx _ => by simpa using hx,
        fun x hx => by simpa using hx⟩
      simpa using hp
    | succ q ih =>
      intro v L p hv hq hp hs
      have hN : (q + 1) * K = q * K + K := by ring
      have hN' : (q + 1) * (K - 1) = q * (K - 1) + (K - 1) := by ring
      obtain ⟨p₁, hR1, hC1, hK1, hE1⟩ := ih v L p hv (by omega) hp (fun i hi => hs i (by omega))
      have hS1 : ∀ i' : ℕ, i' < K → Adj p₁ (2 * M + 1 - 2 * i') (2 * M + 1 - 2 * i' + 1) := by
        intro i' hi'
        have h := hK1 _ (hs (q * K + i') (by omega)) (fun i'' hi'' => by omega)
        exact adjeq _ _ _ _ _ h (by omega) (by omega)
      obtain ⟨p₂, hR2, hC2, hK2, hE2⟩ := bot_pairs (2 * M + 1) (v + 2 * (q * K)) (K - 1) _ p₁
        (by omega) (by omega) (by omega) hR1
        (fun i hi => adjeq _ _ _ _ _ (hS1 (i + 1) (by omega)) (by omega) (by omega))
      obtain ⟨p₃, hR3, hC3, hK3, hE3⟩ := bot_pairs y (v + 2 * (q * K) + 2 * (K - 1)) 1 _ p₂
        (by omega) (by omega) (by omega) hR2
        (fun i hi => adjeq _ _ _ _ _
          (hK2 _ (hS1 0 (by omega)) (fun i'' hi'' => by omega)) (by omega) (by omega))
      refine ⟨p₃, ?_, ?_, ?_, ?_⟩
      · have e1 : v + 2 * ((q + 1) * K) = v + 2 * (q * K) + 2 * (K - 1) + 2 * 1 := by
          rw [hN]; omega
        have e2 : L + Multiset.replicate (2 * ((q + 1) * (K - 1))) (2 * M + 1) +
            Multiset.replicate (2 * (q + 1)) y =
            L + Multiset.replicate (2 * (q * (K - 1))) (2 * M + 1) + Multiset.replicate (2 * q) y +
            Multiset.replicate (2 * (K - 1)) (2 * M + 1) + Multiset.replicate (2 * 1) y := by
          rw [hN', mul_add, Multiset.replicate_add, mul_add 2 q 1, Multiset.replicate_add]
          abel
        rw [e1, e2]
        exact hR3
      · intro i hi
        by_cases hi0 : i = 0
        · subst hi0
          exact hC3 0 (by omega)
        by_cases hiK : i < K
        · have h := hK3 _ (hC2 (i - 1) (by omega)) (fun i'' hi'' => by omega)
          exact adjeq _ _ _ _ _ h (by omega) (by omega)
        · have h1 := hK2 _ (hC1 (i - K) (by omega)) (fun i'' hi'' => by omega)
          have h := hK3 _ h1 (fun i'' hi'' => by omega)
          exact adjeq _ _ _ _ _ h (by omega) (by omega)
      · intro x hx hne
        have h1 := hK1 x hx (fun i hi => hne i (by omega))
        have h2 := hK2 _ h1 (fun i'' hi'' => by
          have := hne (q * K + 1 + i'') (by omega)
          omega)
        have h3 := hK3 _ h2 (fun i'' hi'' => by
          have := hne (q * K) (by omega)
          omega)
        exact adjeq _ _ _ _ _ h3 (by omega) (by omega)
      · intro x hx
        exact endeq _ _ _ (hE3 _ (hE2 _ (hE1 x hx))) (by omega)
  by_cases hsplit : C * K + 1 ≤ M
  · 
    obtain ⟨R, hR⟩ : ∃ R, M = C * K + 1 + R := ⟨M - (C * K + 1), by omega⟩
    obtain ⟨t, ht⟩ : ∃ t, B + C = M + t := ⟨B + C - M, by omega⟩
    have hCK : C * (K - 1) + C = C * K := by
      rw [← Nat.mul_succ]
      congr 1
      omega
    obtain ⟨Q0, hQ0, hQs1, hQs2, -, hQe2⟩ := path_II (2 * M + 1 + 2) 2 (by omega) (by omega)
    obtain ⟨P1, hR1, hC1, hK1, hE1⟩ := macA C (2 * M + 1 + 2) _ Q0 (by omega) (by omega) hQ0
      (fun i hi => hQs2 _ (by omega) (by omega))
    obtain ⟨P2, hR2, hC2, hK2, hE2⟩ := bot_pairs (2 * M + 1) (2 * M + 1 + 2 + 2 * (C * K)) R _ P1
      (by omega) (by omega) (by omega) hR1 (fun i hi => adjeq _ _ _ _ _
        (hK1 (2 * R + 1 - 2 * i) (hQs2 _ (by omega) (by omega)) (fun i'' hi'' => by omega))
        (by omega) (by omega))
    have hev2 : ∀ z : ℕ, z % 2 = 0 → z + 2 ≤ 2 * M → Adj P2 z (z + 1) := by
      intro z hz1 hz2
      by_cases hz3 : z < 2 * R
      · exact adjeq _ _ _ _ _ (hC2 (z / 2) (by omega)) (by omega) (by omega)
      by_cases hz4 : z < 2 * R + 2 * (C * K)
      · have h := hK2 _ (hC1 ((z - 2 * R) / 2) (by omega)) (fun i hi => by omega)
        exact adjeq _ _ _ _ _ h (by omega) (by omega)
      · have h0 := hK1 0 (hQs1 0 (by omega)) (fun i hi => by omega)
        have h := hK2 _ h0 (fun i hi => by omega)
        exact adjeq _ _ _ _ _ h (by omega) (by omega)
    have hend2 : IsEnd P2 (2 * M + 1 - 1) := endeq _ _ _ (hE2 _ (hE1 _ hQe2)) (by omega)
    obtain ⟨P3, hR3, hE3a, hK3, -⟩ := bot_attach (2 * M + 1) (2 * M + 1 + 2 + 2 * (C * K) + 2 * R)
      _ P2 (by omega) (by omega) hR2 hend2
    obtain ⟨P4, hR4, hE4a, hO4, hK4, -⟩ := bot_ones (2 * K)
      (2 * M + 1 + 2 + 2 * (C * K) + 2 * R + 1) _ P3 (by omega) hR3 hE3a
    obtain ⟨P5, hR5, -, hK5, hE5⟩ := top_pairs (2 * M + 1)
      (2 * M + 1 + 2 + 2 * (C * K) + 2 * R + 1 + 2 * K) t _ P4 (by omega) (by omega) (by omega) hR4
      (fun i hi => by
        have h1 := hK1 (2 + 2 * i) (hQs2 _ (by omega) (by omega)) (fun i' hi' => by omega)
        have h2 := hK2 _ h1 (fun i' hi' => by omega)
        have h3 := hK3 _ h2
        have h4 := hK4 _ (adjeq _ _ _ _ _ h3 rfl (by omega))
        exact adjeq _ _ _ _ _ h4 (by omega) (by omega))
    refine ⟨y, le_rfl, by omega, P5, ?_, ?_⟩
    · have e : 2 * M + 1 + 2 + 2 * (C * K) + 2 * R + 1 + 2 * K + 2 * t =
          y + 2 * B + 2 * C + 1 := by omega
      rw [e] at hR5
      have hL : Multiset.replicate (2 * M + 1 + 2 - 2) 1 +
          Multiset.replicate 1 (2 * M + 1 + 2 - 2) +
          Multiset.replicate (2 * (C * (K - 1))) (2 * M + 1) + Multiset.replicate (2 * C) y +
          Multiset.replicate (2 * R) (2 * M + 1) + Multiset.replicate 1 (2 * M + 1) +
          Multiset.replicate (2 * K) 1 + Multiset.replicate (2 * t) (2 * M + 1) =
          prescribedLengths y (2 * K) y (2 * B) (2 * C) := by
        unfold prescribedLengths
        rw [Nat.add_sub_cancel, hym]
        have e1 : Multiset.replicate y 1 =
            Multiset.replicate (2 * M + 1) 1 + Multiset.replicate (2 * K) 1 := by
          rw [← Multiset.replicate_add]
          congr 1 <;> omega
        have e2 : Multiset.replicate (2 * B) (2 * M + 1) = Multiset.replicate 1 (2 * M + 1) +
            Multiset.replicate (2 * (C * (K - 1))) (2 * M + 1) +
            Multiset.replicate (2 * R) (2 * M + 1) +
            Multiset.replicate 1 (2 * M + 1) + Multiset.replicate (2 * t) (2 * M + 1) := by
          simp only [← Multiset.replicate_add]
          congr 1
          omega
        rw [e1, e2]
        abel
      rw [hL] at hR5
      exact hR5
    · refine ⟨hE5 _ hE4a, fun j hj1 hj2 => ?_, fun he => ?_⟩
      · by_cases hj : 2 * j - 1 < 2 * K
