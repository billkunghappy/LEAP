  intro ℓ v L p hℓ _ hpL hend
  obtain ⟨m, rfl⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by omega⟩
  rw [Nat.add_sub_cancel] at hend
  obtain ⟨hq, hM⟩ := hpL
