            List.length_replicate]
          rw [Int.natAbs_eq_iff]
          split_ifs <;> omega
      have he : edgeLengths (List.map (fun y => j + y) (List.range m) ++ List.range j) =
          ((List.zipWith (fun (a b : ℤ) => Int.natAbs (b - a))
          ((List.map (fun y => j + y) (List.range m) ++ List.range j).map
            (fun a : ℕ => (a : ℤ)))
          ((List.map (fun y => j + y) (List.range m) ++ List.range j).tail.map
            (fun a : ℕ => (a : ℤ))) : List ℕ) : Multiset ℕ) := by
        unfold edgeLengths
