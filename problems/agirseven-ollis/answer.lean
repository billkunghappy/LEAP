    exact hp

theorem baseB_okE_EO_UL4 : ∀ (y b c : ℕ), 9 ≤ y → y % 2 = 1 → b % 2 = 0 → c % 2 = 1 → 2 ≤ b → 7 ≤ c → b + c = y → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y 4 a₀ b c) p ∧ BotEndInv y p :=
by
  have hcons : ∀ (a b : ℕ) (l : List ℕ) (d : ℕ), Int.natAbs ((b : ℤ) - (a : ℤ)) = d →
      edgeLengths (a :: b :: l) = d ::ₘ edgeLengths (b :: l) := by
    intro a b l d h
