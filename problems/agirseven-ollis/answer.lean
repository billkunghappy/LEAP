      rw [hT']
      simp only [ldvUnit, List.cons_append, List.nil_append]
      rw [econs' (4 * μ + 2 * κ + 2 * (s + r) + 4) (4 * μ + 2 * κ + 2 * (s + r) + 3) 1 _ (by omega),
        econs' (4 * μ + 2 * κ + 2 * (s + r) + 3) (2 * μ + 2 * (s + r) + 2) (2 * μ + 2 * κ + 1) _
          (by omega),
        econs' (2 * μ + 2 * (s + r) + 2) (4 * μ + 2 * (s + r) + 2) (2 * μ) _ (by omega),
        econs' (4 * μ + 2 * (s + r) + 2) (4 * μ + 2 * (s + r) + 1) 1 _ (by omega),
        econs' (4 * μ + 2 * (s + r) + 1) (2 * μ + 2 * (s + r) + 1) (2 * μ) _ (by omega),
        econs' (2 * μ + 2 * (s + r) + 1) (4 * μ + 2 * κ + 2 * s + 2 * r + 2) (2 * μ + 2 * κ + 1) _
