      edgeLengths (x :: (ul4StB d L n ++ z :: T)) =
        m ::ₘ (Multiset.replicate (2 * n) d + Multiset.replicate (2 * n) 1 + edgeLengths (z :: T)) := by
    intro d L n
    induction n with
    | zero =>
      intro x z T m _ _ hm
