    intro s r
    induction r with
    | zero => intro c' X hc; exact ⟨X, by simp [lcvUs, hc]⟩
    | succ r ih =>
      intro c' X hc
      rw [Usucc, List.append_assoc]
      refine ⟨(ldvUnit μ κ (s + r)).tail ++ (lcvUs μ κ s r ++ c' :: X), ?_⟩
      rw [show 4 * μ + 2 * κ + 2 * s + 2 * (r + 1) + 2 = 4 * μ + 2 * κ + 2 * (s + r) + 4 by ring]
      simp only [ldvUnit, List.cons_append, List.tail_cons, List.nil_append]
