      simp only [List.mem_append, hm, true_or, or_true]
    by_cases c10 : x + 2 * u + 1 < y + k
    · have hm : x ∈ (List.range (k - (2 * u + 2 * r + 2))).map
          (fun i => y + k - (2 * u + 2) - i) :=
        List.mem_map.2 ⟨y + k - (2 * u + 2) - x, List.mem_range.2 (by omega), by omega⟩
      simp only [List.mem_append, hm, true_or, or_true]
    by_cases c11 : x + 1 < y + k
    · have hm : x ∈ (List.range u).flatMap (fun i => bS2Unit y k (k - 2 * u - 1 + 2 * i)) :=
        List.mem_flatMap.2 ⟨(x - (y + k - 2 * u - 1)) / 2, List.mem_range.2 (by omega),
          by simp only [bS2Unit, List.mem_cons, List.not_mem_nil, or_false]; omega⟩
      simp only [List.mem_append, hm, true_or, or_true]
    by_cases c12 : x = y + k - 1
    · have hm : x ∈ [k - 1 + y, 2 * k - 1] := by
        simp only [List.mem_cons, List.not_mem_nil, or_false]; omega
      simp only [List.mem_append, hm, true_or, or_true]
    · have hm : x ∈ (List.range w).flatMap (fun j => bS2Rung y k j) :=
        List.mem_flatMap.2 ⟨(x - y - k) / 2, List.mem_range.2 (by omega),
          by simp only [bS2Rung, List.mem_cons, List.not_mem_nil, or_false]; omega⟩
      simp only [List.mem_append, hm, true_or, or_true]
  have lenFM : ∀ (f : ℕ → List ℕ) (c n : ℕ), (∀ i, (f i).length = c) →
