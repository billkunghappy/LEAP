theorem bOO_R : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 0 → b < y - k → c < y → b % 2 = 1 → c % 2 = 1 → b + (y - k) + 1 ≤ c → y + 4 ≤ 2 * b + c → c + 6 ≤ y → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ BotEndInv y p :=
by
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2 hcor h4 h6
  by_cases h : b + c + 1 ≤ y
  · exact bOO_RS y k b c hk hyk hy hk2 hb hc hb2 hc2 hcor h4 h6 h
  · exact bOO_RL y k b c hk hyk hy hk2 hb hc hb2 hc2 hcor h4 h6 (by omega)

theorem baseB_okE_OO : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 0 → b < y - k → c < y → b % 2 = 1 → c % 2 = 1 → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ BotEndInv y p :=
by
  intro y k b c hk hyk hy hk2 hb hc hb2 hc2
  by_cases hA : b + c + 1 ≤ y - k
  · exact bOO_Q1 y k b c hk hyk hy hk2 hb hc hb2 hc2 hA
  by_cases hB : c + 2 ≤ y - k
  · exact bOO_Q3 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) hB
  by_cases hC : c + 1 ≤ b + (y - k)
  · exact bOO_Q2 y k b c hk hyk hy hk2 hb hc hb2 hc2 (by omega) hC
  have hcor : b + (y - k) + 1 ≤ c := by omega
  by_cases hD : 2 * b + c ≤ y + 2
  · exact bOO_F y k b c hk hyk hy hk2 hb hc hb2 hc2 hcor hD
  have h4 : y + 4 ≤ 2 * b + c := by omega
  by_cases hE : c + 2 = y
  · exact bOO_col y k b c hk hyk hy hk2 hb hc hb2 hc2 hE (by omega) hcor
  by_cases hF : c + 4 = y
  · exact bOO_row4 y k b c hk hyk hy hk2 hb hc hb2 hc2 hF (by omega) hcor
  exact bOO_R y k b c hk hyk hy hk2 hb hc hb2 hc2 hcor h4 (by omega)

theorem baseB_oddR_keven : ∀ (y k b c : ℕ), 1 ≤ k → 2 * k < y → y % 2 = 1 → k % 2 = 0 → b < y - k → c < y → ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ, IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ TopEndInv y (a₀ + b + c + 1) p :=
by
  intro y k b c hk hyk hy hk2 hb hc
  have hB : ∃ a₀ : ℕ, a₀ ≤ y ∧ y ≤ a₀ + b + c + 1 ∧ ∃ p : List ℕ,
      IsLinearRealization (a₀ + b + c + 1) (prescribedLengths y k a₀ b c) p ∧ BotEndInv y p := by
    rcases Nat.mod_two_eq_zero_or_one b with hb2 | hb2 <;>
      rcases Nat.mod_two_eq_zero_or_one c with hc2 | hc2
    · exact baseB_okE_EE y k b c hk hyk hy hk2 hb hc hb2 hc2
    · exact baseB_okE_EO y k b c hk hyk hy hk2 hb hc hb2 hc2
    · exact baseB_okE_OE y k b c hk hyk hy hk2 hb hc hb2 hc2
    · exact baseB_okE_OO y k b c hk hyk hy hk2 hb hc hb2 hc2
  obtain ⟨a₀, ha₀, hv, p, hp, hBE⟩ := hB
  obtain ⟨hp', hadj, hend⟩ := reflect_realization (a₀ + b + c + 1) _ p hp
  refine ⟨a₀, ha₀, hv, _, hp', ?_, ?_, ?_⟩
